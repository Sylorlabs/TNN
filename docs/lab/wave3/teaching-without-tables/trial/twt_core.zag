// TWT — teaching without tables: propose -> verify -> commit/refuse (native Zag).
// The teacher never writes into the learner. The teacher PROPOSES; the learner
// VERIFIES the proposal against its OWN recorded observations and either
// COMMITS (deliberate audited op, SELF_VERIFIED provenance, teacher recorded
// only as attribution) or REFUSES with a reason. No RNG anywhere in this file:
// every op is a deterministic function of recorded state.
// Deterministic given state. No accumulator, no argmax, no score table.
@import("substrate/cl/common.zag")

const TWT_ITEMS:i32=16;
const TWT_AUDIT_CAP:i32=256;
const TWT_AUDIT_WORDS:i32=10; // op,slot,rc,b1,b2,b3,a1,a2,a3,clock

const TWT_OP_OBSERVE:i32=1;
const TWT_OP_TEACH:i32=2;
const TWT_OP_VERIFY_COMMIT:i32=3;
const TWT_OP_COPY_COMMIT:i32=4;
const TWT_OP_WITHDRAW:i32=5;
const TWT_OP_QUERY:i32=6;

const TWT_OK:i32=0;
const TWT_REFUSED_CONTRADICTED:i32=101;
const TWT_REFUSED_INSUFFICIENT:i32=102;
const TWT_REFUSED_TEACHER_GONE:i32=103;
const TWT_REFUSED_BADITEM:i32=104;
const TWT_REFUSED_BADVAL:i32=105;
const TWT_REFUSED_ABSTAIN:i32=106; // query outcome, recorded: no committed knowledge
const TWT_REFUSED_MODE:i32=107;

const TWT_PROV_NONE:i32=0;
const TWT_PROV_TEACHER:i32=1; // committed on teacher authority (COPY arm: the banned shape, control only)
const TWT_PROV_SELF:i32=2;    // committed after the learner's own verification

const TWT_MODE_VERIFY:i32=1;
const TWT_MODE_COPY:i32=2;

struct TwtStore {
    live: []u8,        // committed belief present
    value: []u8,       // committed belief value 0/1
    prov: []u8,        // provenance: NONE/TEACHER/SELF
    taught: []u8,      // teacher id that proposed the committed claim (0 = none)
    obs_agree: []u8,   // own observations agreeing, recorded at commit time
    obs_contra: []u8,  // own observations contradicting, recorded at commit time
    obs_n: []u8,       // learner's OWN evidence channel: observation count per item
    obs_sum: []u8,     // learner's OWN evidence channel: sum of observed values per item
    teacher_present: i32,
    mode: i32,
    audit: []u8,
    audit_n: i32,
    clock: i32
}

fn twt_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn twt_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn twt_baditem(item:i32)i32 { if(item<0 || item>=TWT_ITEMS){return 1;} return 0; }

fn twt_init(mode:i32)TwtStore {
    let live:[]u8=nio_alloc(TWT_ITEMS);
    let value:[]u8=nio_alloc(TWT_ITEMS);
    let prov:[]u8=nio_alloc(TWT_ITEMS);
    let taught:[]u8=nio_alloc(TWT_ITEMS);
    let obs_agree:[]u8=nio_alloc(TWT_ITEMS);
    let obs_contra:[]u8=nio_alloc(TWT_ITEMS);
    let obs_n:[]u8=nio_alloc(TWT_ITEMS);
    let obs_sum:[]u8=nio_alloc(TWT_ITEMS);
    let audit:[]u8=nio_alloc(TWT_AUDIT_CAP*TWT_AUDIT_WORDS*4);
    // nio_alloc is NOT zeroed (playbook §12) — zero everything by hand.
    let i:i32=0;
    while(i<TWT_ITEMS){live[i]=0;value[i]=0;prov[i]=0;taught[i]=0;obs_agree[i]=0;obs_contra[i]=0;obs_n[i]=0;obs_sum[i]=0;i=i+1;}
    i=0;while(i<TWT_AUDIT_CAP*TWT_AUDIT_WORDS*4){audit[i]=0;i=i+1;}
    return TwtStore{.live=live,.value=value,.prov=prov,.taught=taught,
        .obs_agree=obs_agree,.obs_contra=obs_contra,.obs_n=obs_n,.obs_sum=obs_sum,
        .teacher_present=1,.mode=mode,.audit=audit,.audit_n=0,.clock=0};
}

fn twt_audit_append(s:*TwtStore,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,a1:i32,a2:i32,a3:i32)void {
    if(s.*.audit_n>=TWT_AUDIT_CAP){return;}
    let e:i32=s.*.audit_n*TWT_AUDIT_WORDS*4;
    twt_i32_set(s.*.audit,e+0,op);twt_i32_set(s.*.audit,e+4,slot);twt_i32_set(s.*.audit,e+8,rc);
    twt_i32_set(s.*.audit,e+12,b1);twt_i32_set(s.*.audit,e+16,b2);twt_i32_set(s.*.audit,e+20,b3);
    twt_i32_set(s.*.audit,e+24,a1);twt_i32_set(s.*.audit,e+28,a2);twt_i32_set(s.*.audit,e+32,a3);
    twt_i32_set(s.*.audit,e+36,s.*.clock);
    s.*.audit_n=s.*.audit_n+1;s.*.clock=s.*.clock+1;
}

// The learner's OWN evidence channel: a recorded observation of an item.
// This is the learner's perception, not the teacher's testimony.
fn twt_observe(s:*TwtStore,item:i32,val:i32)i32 {
    if(s==null as *TwtStore){return cl_bad();}
    if(twt_baditem(item)==1){twt_audit_append(s,TWT_OP_OBSERVE,item,TWT_REFUSED_BADITEM,item,0,0,0,0,0);return TWT_REFUSED_BADITEM;}
    if(val!=0 && val!=1){twt_audit_append(s,TWT_OP_OBSERVE,item,TWT_REFUSED_BADVAL,item,val,0,0,0,0);return TWT_REFUSED_BADVAL;}
    let nb:i32=s.*.obs_n[item] as i32;let sb:i32=s.*.obs_sum[item] as i32;
    s.*.obs_n[item]=(nb+1) as u8;s.*.obs_sum[item]=(sb+val) as u8;
    twt_audit_append(s,TWT_OP_OBSERVE,item,TWT_OK,item,val,0,nb|(sb<<8),(nb+1)|((sb+val)<<8),0);
    return TWT_OK;
}

// The teacher PROPOSES a claim. Recorded as an event; commits nothing.
fn twt_teach(s:*TwtStore,teacher_id:i32,item:i32,claim:i32)i32 {
    if(s==null as *TwtStore){return cl_bad();}
    if(s.*.teacher_present==0){twt_audit_append(s,TWT_OP_TEACH,item,TWT_REFUSED_TEACHER_GONE,item|(claim<<8),teacher_id,0,0,0,0);return TWT_REFUSED_TEACHER_GONE;}
    if(twt_baditem(item)==1){twt_audit_append(s,TWT_OP_TEACH,item,TWT_REFUSED_BADITEM,item|(claim<<8),teacher_id,0,0,0,0);return TWT_REFUSED_BADITEM;}
    if(claim!=0 && claim!=1){twt_audit_append(s,TWT_OP_TEACH,item,TWT_REFUSED_BADVAL,item|(claim<<8),teacher_id,0,0,0,0);return TWT_REFUSED_BADVAL;}
    twt_audit_append(s,TWT_OP_TEACH,item,TWT_OK,item|(claim<<8),teacher_id,0,0,0,0);
    return TWT_OK;
}

// THE verify gate. Commits iff the learner's OWN recorded evidence supports
// the claim: >=2 agreeing observations AND zero contradicting ones.
// Otherwise refuses with a reason. Structural: in the op, not in policy.
fn twt_verify_commit(s:*TwtStore,teacher_id:i32,item:i32,claim:i32)i32 {
    if(s==null as *TwtStore){return cl_bad();}
    if(s.*.mode!=TWT_MODE_VERIFY){twt_audit_append(s,TWT_OP_VERIFY_COMMIT,item,TWT_REFUSED_MODE,item|(claim<<8),teacher_id,0,0,0,0);return TWT_REFUSED_MODE;}
    if(s.*.teacher_present==0){twt_audit_append(s,TWT_OP_VERIFY_COMMIT,item,TWT_REFUSED_TEACHER_GONE,item|(claim<<8),teacher_id,0,0,0,0);return TWT_REFUSED_TEACHER_GONE;}
    if(twt_baditem(item)==1){twt_audit_append(s,TWT_OP_VERIFY_COMMIT,item,TWT_REFUSED_BADITEM,item|(claim<<8),teacher_id,0,0,0,0);return TWT_REFUSED_BADITEM;}
    if(claim!=0 && claim!=1){twt_audit_append(s,TWT_OP_VERIFY_COMMIT,item,TWT_REFUSED_BADVAL,item|(claim<<8),teacher_id,0,0,0,0);return TWT_REFUSED_BADVAL;}
    let n:i32=s.*.obs_n[item] as i32;let sm:i32=s.*.obs_sum[item] as i32;
    let agree:i32=0;let contra:i32=0;
    if(claim==1){agree=sm;contra=n-sm;}else{agree=n-sm;contra=sm;}
    if(contra>0){
        twt_audit_append(s,TWT_OP_VERIFY_COMMIT,item,TWT_REFUSED_CONTRADICTED,item|(claim<<8),teacher_id,agree|(contra<<8),0,0,0);
        return TWT_REFUSED_CONTRADICTED;
    }
    if(agree<2){
        twt_audit_append(s,TWT_OP_VERIFY_COMMIT,item,TWT_REFUSED_INSUFFICIENT,item|(claim<<8),teacher_id,agree|(contra<<8),0,0,0);
        return TWT_REFUSED_INSUFFICIENT;
    }
    // Commit: what is stored is the VERIFICATION, not the assertion.
    s.*.live[item]=1;s.*.value[item]=claim as u8;s.*.prov[item]=TWT_PROV_SELF as u8;
    s.*.taught[item]=teacher_id as u8;s.*.obs_agree[item]=agree as u8;s.*.obs_contra[item]=contra as u8;
    twt_audit_append(s,TWT_OP_VERIFY_COMMIT,item,TWT_OK,item|(claim<<8),teacher_id,agree|(contra<<8),claim|(TWT_PROV_SELF<<8),agree|(contra<<8),teacher_id);
    return TWT_OK;
}

// COPY arm: commits the teacher's claim verbatim with TEACHER_ONLY provenance.
// The banned shape, run as an explicit negative control ONLY (PREREG.md §5).
fn twt_copy_commit(s:*TwtStore,teacher_id:i32,item:i32,claim:i32)i32 {
    if(s==null as *TwtStore){return cl_bad();}
    if(s.*.mode!=TWT_MODE_COPY){twt_audit_append(s,TWT_OP_COPY_COMMIT,item,TWT_REFUSED_MODE,item|(claim<<8),teacher_id,0,0,0,0);return TWT_REFUSED_MODE;}
    if(s.*.teacher_present==0){twt_audit_append(s,TWT_OP_COPY_COMMIT,item,TWT_REFUSED_TEACHER_GONE,item|(claim<<8),teacher_id,0,0,0,0);return TWT_REFUSED_TEACHER_GONE;}
    if(twt_baditem(item)==1){twt_audit_append(s,TWT_OP_COPY_COMMIT,item,TWT_REFUSED_BADITEM,item|(claim<<8),teacher_id,0,0,0,0);return TWT_REFUSED_BADITEM;}
    if(claim!=0 && claim!=1){twt_audit_append(s,TWT_OP_COPY_COMMIT,item,TWT_REFUSED_BADVAL,item|(claim<<8),teacher_id,0,0,0,0);return TWT_REFUSED_BADVAL;}
    s.*.live[item]=1;s.*.value[item]=claim as u8;s.*.prov[item]=TWT_PROV_TEACHER as u8;
    s.*.taught[item]=teacher_id as u8;s.*.obs_agree[item]=0;s.*.obs_contra[item]=0;
    twt_audit_append(s,TWT_OP_COPY_COMMIT,item,TWT_OK,item|(claim<<8),teacher_id,0,claim|(TWT_PROV_TEACHER<<8),0,teacher_id);
    return TWT_OK;
}

// Teacher withdrawal (H-09): after this, teaching ops are refused.
fn twt_withdraw(s:*TwtStore)i32 {
    if(s==null as *TwtStore){return cl_bad();}
    s.*.teacher_present=0;
    twt_audit_append(s,TWT_OP_WITHDRAW,-1,TWT_OK,0,0,0,0,0,0);
    return TWT_OK;
}

// Post-withdrawal query: answer from committed knowledge, or abstain.
// Abstention is structural (no committed slot -> no answer), never a threshold.
fn twt_query(s:*TwtStore,item:i32,out_ans:*i32,out_prov:*i32)i32 {
    if(s==null as *TwtStore || out_ans==null as *i32 || out_prov==null as *i32){return cl_bad();}
    if(twt_baditem(item)==1){out_ans.*=-1;out_prov.*=TWT_PROV_NONE;twt_audit_append(s,TWT_OP_QUERY,item,TWT_REFUSED_BADITEM,item,0,0,0,0,0);return TWT_REFUSED_BADITEM;}
    if(s.*.live[item]==0){
        out_ans.*=-1;out_prov.*=TWT_PROV_NONE;
        twt_audit_append(s,TWT_OP_QUERY,item,TWT_REFUSED_ABSTAIN,item,0,0,-1,0,0);
        return TWT_REFUSED_ABSTAIN;
    }
    out_ans.*=s.*.value[item] as i32;out_prov.*=s.*.prov[item] as i32;
    twt_audit_append(s,TWT_OP_QUERY,item,TWT_OK,item,0,0,out_ans.*|(out_prov.*<<8),0,0);
    return TWT_OK;
}

// Ledger replay: reconstruct slot fields from the audit log alone and compare
// to live state. The MA1 "conscious" invariant: no state change without an entry.
fn twt_replay_check(s:*TwtStore)i32 {
    if(s==null as *TwtStore){return cl_bad();}
    let r_live:[]u8=nio_alloc(TWT_ITEMS);
    let r_value:[]u8=nio_alloc(TWT_ITEMS);
    let r_prov:[]u8=nio_alloc(TWT_ITEMS);
    let r_taught:[]u8=nio_alloc(TWT_ITEMS);
    let r_agree:[]u8=nio_alloc(TWT_ITEMS);
    let r_contra:[]u8=nio_alloc(TWT_ITEMS);
    let r_n:[]u8=nio_alloc(TWT_ITEMS);
    let r_sum:[]u8=nio_alloc(TWT_ITEMS);
    let r_teacher:i32=1;
    let i:i32=0;while(i<TWT_ITEMS){r_live[i]=0;r_value[i]=0;r_prov[i]=0;r_taught[i]=0;r_agree[i]=0;r_contra[i]=0;r_n[i]=0;r_sum[i]=0;i=i+1;}
    let e:i32=0;
    while(e<s.*.audit_n){
        let b:i32=e*TWT_AUDIT_WORDS*4;
        let op:i32=twt_i32_get(s.*.audit,b+0);
        let slot:i32=twt_i32_get(s.*.audit,b+4);
        let rc:i32=twt_i32_get(s.*.audit,b+8);
        let b1:i32=twt_i32_get(s.*.audit,b+12);
        let b2:i32=twt_i32_get(s.*.audit,b+16);
        let b3:i32=twt_i32_get(s.*.audit,b+20);
        let a1:i32=twt_i32_get(s.*.audit,b+24);
        let a2:i32=twt_i32_get(s.*.audit,b+28);
        let a3:i32=twt_i32_get(s.*.audit,b+32);
        if(rc==TWT_OK){
            if(op==TWT_OP_OBSERVE){r_n[slot]=(r_n[slot] as i32+1) as u8;r_sum[slot]=(r_sum[slot] as i32+b2) as u8;}
            if(op==TWT_OP_VERIFY_COMMIT || op==TWT_OP_COPY_COMMIT){
                let claim:i32=b1>>8;let agree:i32=b3&255;let contra:i32=(b3>>8)&255;
                r_live[slot]=1;r_value[slot]=claim as u8;
                if(op==TWT_OP_VERIFY_COMMIT){r_prov[slot]=TWT_PROV_SELF as u8;}else{r_prov[slot]=TWT_PROV_TEACHER as u8;}
                r_taught[slot]=b2 as u8;r_agree[slot]=agree as u8;r_contra[slot]=contra as u8;
            }
            if(op==TWT_OP_WITHDRAW){r_teacher=0;}
        }
        e=e+1;
    }
    let bad:i32=0;i=0;
    while(i<TWT_ITEMS){
        if((r_live[i] as i32)!=(s.*.live[i] as i32)){bad=bad+1;}
        if((r_value[i] as i32)!=(s.*.value[i] as i32)){bad=bad+1;}
        if((r_prov[i] as i32)!=(s.*.prov[i] as i32)){bad=bad+1;}
        if((r_taught[i] as i32)!=(s.*.taught[i] as i32)){bad=bad+1;}
        if((r_agree[i] as i32)!=(s.*.obs_agree[i] as i32)){bad=bad+1;}
        if((r_contra[i] as i32)!=(s.*.obs_contra[i] as i32)){bad=bad+1;}
        if((r_n[i] as i32)!=(s.*.obs_n[i] as i32)){bad=bad+1;}
        if((r_sum[i] as i32)!=(s.*.obs_sum[i] as i32)){bad=bad+1;}
        i=i+1;
    }
    if(r_teacher!=s.*.teacher_present){bad=bad+1;}
    return bad;
}

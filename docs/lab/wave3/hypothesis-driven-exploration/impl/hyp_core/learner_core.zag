// HDE v1 learner core — hypothesis-driven exploration.
//
// Fully deterministic: every decision is a function of the hypothesis
// registry state. No generator state, no seeded init, no coin flips;
// ties resolve to the lowest object index.
//
// The learner's whole memory is an explicit hypothesis registry:
// per context c in {0,1}, slot 0 = incumbent claim ("object O is best in
// context c"), slot 1 = challenger claim ("object O' beats the incumbent"),
// plus one cross-context hypothesis slot (H_RECRUIT / H_SWITCH).
//
// Exploration episodes happen ONLY as tests of live hypotheses:
//   - a challenger is tested only while OPEN and while the incumbent has
//     NOT achieved the maximum observed reward (a question the incumbent
//     already answers is not asked);
//   - a live H_RECRUIT/H_SWITCH is tested instead (cross-context question
//     has priority once formed).
// Surprise (negative, non-test outcome on the incumbent) proposes
// competing explanations with evidence-driven priority:
//   other context CONFIRMED -> H_SWITCH; single context with a prior
//   displacement -> H_RECRUIT; otherwise re-open the challenger (H_ARM).
// A failed cross-context hypothesis falls back to H_ARM. All thresholds
// are preregistered in PREREG.md.
@import("../substrate/cl/observation.zag")

const HDE_CONFIRM:i32=3;
const HDE_REFUTE:i32=2;
const HDE_BUDGET:i32=3;
// Claim states: 0 EMPTY, 1 DORMANT, 2 OPEN, 3 TESTING, 4 CONFIRMED,
//               5 REFUTED, 6 ARCHIVED.
// x states: 0 NONE, 1 LIVE, 2 TESTING, 5 REFUTED, 6 ARCHIVED (one-shot).
// x kinds: 0 RECRUIT, 1 SWITCH.

struct TrlState {
    h00_obj:i32,h00_st:i32,h00_sup:i32,h00_ref:i32,h00_spent:i32,
    h01_obj:i32,h01_st:i32,h01_sup:i32,h01_ref:i32,h01_spent:i32,
    h10_obj:i32,h10_st:i32,h10_sup:i32,h10_ref:i32,h10_spent:i32,
    h11_obj:i32,h11_st:i32,h11_sup:i32,h11_ref:i32,h11_spent:i32,
    disp0:i32,disp1:i32,incmax0:i32,incmax1:i32,
    x_st:i32,x_kind:i32,x_tgt:i32,x_sup:i32,x_ref:i32,
    maxrw:i32,
    active:i32,contexts:i32,
    pending:i32,pending_action:i32,pending_context:i32,pending_object:i32,pending_explore:i32,
    decisions:i32,switches:i32,outcomes:i32,explores:i32,expl_pos:i32,
    updates:i32,hyp_confirmed:i32,hyp_refuted:i32
}

fn h_obj(s:*TrlState,c:i32,k:i32)i32 {
    if(c==0){if(k==0){return s.*.h00_obj;}return s.*.h01_obj;}
    if(k==0){return s.*.h10_obj;}return s.*.h11_obj;
}
fn h_st(s:*TrlState,c:i32,k:i32)i32 {
    if(c==0){if(k==0){return s.*.h00_st;}return s.*.h01_st;}
    if(k==0){return s.*.h10_st;}return s.*.h11_st;
}
fn h_sup(s:*TrlState,c:i32,k:i32)i32 {
    if(c==0){if(k==0){return s.*.h00_sup;}return s.*.h01_sup;}
    if(k==0){return s.*.h10_sup;}return s.*.h11_sup;
}
fn h_ref(s:*TrlState,c:i32,k:i32)i32 {
    if(c==0){if(k==0){return s.*.h00_ref;}return s.*.h01_ref;}
    if(k==0){return s.*.h10_ref;}return s.*.h11_ref;
}
fn h_spent(s:*TrlState,c:i32,k:i32)i32 {
    if(c==0){if(k==0){return s.*.h00_spent;}return s.*.h01_spent;}
    if(k==0){return s.*.h10_spent;}return s.*.h11_spent;
}
fn h_set_obj(s:*TrlState,c:i32,k:i32,v:i32)void {
    if(c==0){if(k==0){s.*.h00_obj=v;}else{s.*.h01_obj=v;}}
    else{if(k==0){s.*.h10_obj=v;}else{s.*.h11_obj=v;}}
}
fn h_set_st(s:*TrlState,c:i32,k:i32,v:i32)void {
    if(c==0){if(k==0){s.*.h00_st=v;}else{s.*.h01_st=v;}}
    else{if(k==0){s.*.h10_st=v;}else{s.*.h11_st=v;}}
}
fn h_set_sup(s:*TrlState,c:i32,k:i32,v:i32)void {
    if(c==0){if(k==0){s.*.h00_sup=v;}else{s.*.h01_sup=v;}}
    else{if(k==0){s.*.h10_sup=v;}else{s.*.h11_sup=v;}}
}
fn h_set_ref(s:*TrlState,c:i32,k:i32,v:i32)void {
    if(c==0){if(k==0){s.*.h00_ref=v;}else{s.*.h01_ref=v;}}
    else{if(k==0){s.*.h10_ref=v;}else{s.*.h11_ref=v;}}
}
fn h_set_spent(s:*TrlState,c:i32,k:i32,v:i32)void {
    if(c==0){if(k==0){s.*.h00_spent=v;}else{s.*.h01_spent=v;}}
    else{if(k==0){s.*.h10_spent=v;}else{s.*.h11_spent=v;}}
}
fn h_disp(s:*TrlState,c:i32)i32 {if(c==0){return s.*.disp0;}return s.*.disp1;}
fn h_set_disp(s:*TrlState,c:i32,v:i32)void {if(c==0){s.*.disp0=v;}else{s.*.disp1=v;}}
fn h_incmax(s:*TrlState,c:i32)i32 {if(c==0){return s.*.incmax0;}return s.*.incmax1;}
fn h_set_incmax(s:*TrlState,c:i32,v:i32)void {if(c==0){s.*.incmax0=v;}else{s.*.incmax1=v;}}

// Slot holding a claim about object o (states 1..5 count as holding).
fn h_find(s:*TrlState,c:i32,o:i32)i32 {
    let k:i32=0;
    while(k<2){
        let st:i32=h_st(s,c,k);
        if(h_obj(s,c,k)==o && st>=1 && st<=5){return k;}
        k=k+1;
    }
    return -1;
}
fn h_other_confirmed(s:*TrlState,c:i32)i32 {
    let o:i32=1-c;if(h_st(s,o,0)==4){return 1;}return 0;
}
fn h_live_claims(s:*TrlState,c:i32)i32 {
    let n:i32=0;let k:i32=0;
    while(k<2){let st:i32=h_st(s,c,k);if(st>=1 && st<=4){n=n+1;}k=k+1;}
    return n;
}
// H_ARM: (re-)open the challenger. Stale refutations reset; counters kept
// when merely suppressed.
fn h_activate_ch(s:*TrlState,c:i32)void {
    let st:i32=h_st(s,c,1);
    if(st==0 || st==5 || st==6){
        h_set_obj(s,c,1,1-h_obj(s,c,0));
        h_set_sup(s,c,1,0);h_set_ref(s,c,1,0);h_set_spent(s,c,1,0);
        h_set_st(s,c,1,2);return;
    }
    if(st==1){h_set_st(s,c,1,2);}
}
fn h_suppress_ch(s:*TrlState,c:i32)void {
    let st:i32=h_st(s,c,1);if(st==2 || st==3){h_set_st(s,c,1,1);}
}
fn h_form_x(s:*TrlState,kind:i32,tgt:i32)void {
    s.*.x_st=1;s.*.x_kind=kind;s.*.x_tgt=tgt;s.*.x_sup=0;s.*.x_ref=0;
}
// Seed a fresh context from the recruit-test outcome.
fn h_seed(s:*TrlState,c:i32,obj:i32,reward:i32)void {
    h_set_obj(s,c,0,obj);h_set_st(s,c,0,1);
    if(reward>0){h_set_sup(s,c,0,1);h_set_ref(s,c,0,0);}else{h_set_sup(s,c,0,0);h_set_ref(s,c,0,1);}
    h_set_spent(s,c,0,0);
    h_set_obj(s,c,1,1-obj);h_set_st(s,c,1,2);
    h_set_sup(s,c,1,0);h_set_ref(s,c,1,0);h_set_spent(s,c,1,0);
    if(reward>0 && reward==s.*.maxrw){h_set_incmax(s,c,1);}else{h_set_incmax(s,c,0);}
}
// Confirmed challenger displaces a suspected incumbent.
fn h_swap(s:*TrlState,c:i32)void {
    let nio:i32=h_obj(s,c,1);let nsup:i32=h_sup(s,c,1);let oio:i32=h_obj(s,c,0);
    h_set_obj(s,c,0,nio);h_set_st(s,c,0,4);h_set_sup(s,c,0,nsup);h_set_ref(s,c,0,0);h_set_spent(s,c,0,0);
    h_set_obj(s,c,1,oio);h_set_st(s,c,1,1);h_set_sup(s,c,1,0);h_set_ref(s,c,1,0);h_set_spent(s,c,1,0);
    h_set_disp(s,c,h_disp(s,c)+1);h_set_incmax(s,c,1);
}
// Route a learning outcome to its claim: count only. Transitions are
// applied separately (h_transitions) so surprise attribution can reassign
// a negative to the context level before it hardens into a refutation.
fn h_count(s:*TrlState,c:i32,k:i32,reward:i32,is_test:i32)void {
    if(reward>0){h_set_sup(s,c,k,h_sup(s,c,k)+1);}else{h_set_ref(s,c,k,h_ref(s,c,k)+1);}
    // spent is counted once, in trl_choose when the test is derived.
    s.*.updates=s.*.updates+1;
}
// Keep/discard transitions on counted evidence.
fn h_transitions(s:*TrlState,c:i32,k:i32)void {
    let st:i32=h_st(s,c,k);
    if(h_sup(s,c,k)>=HDE_CONFIRM && st!=4){
        h_set_st(s,c,k,4);s.*.hyp_confirmed=s.*.hyp_confirmed+1;
        // A confirmed claim is new evidence: lift any partition-failure
        // block so later surprises may propose partitioning again.
        if(s.*.x_st==5){s.*.x_st=6;}
        if(k==1 && h_ref(s,c,0)>=1){h_swap(s,c);}
    } else if(h_ref(s,c,k)>=HDE_REFUTE && st!=5){
        h_set_st(s,c,k,5);s.*.hyp_refuted=s.*.hyp_refuted+1;
    } else if((st==2 || st==3) && h_spent(s,c,k)>=HDE_BUDGET){
        h_set_st(s,c,k,6);
        // Inconclusive test (mixed evidence inside one test budget) is a
        // non-stationarity signature: the world moved mid-test. Escalate to
        // the context level instead of grinding the arm question.
        if(h_sup(s,c,k)>0 && h_ref(s,c,k)>0 && s.*.x_st==0){
            if(s.*.contexts==3 && h_other_confirmed(s,c)==1){h_form_x(s,1,1-c);}
            else if(s.*.contexts==1){h_form_x(s,0,1);}
        }
    }
}
// Surprise: negative, non-test outcome. Propose competing explanations.
// Priority (learn==1): a failed partition falls back to arm-level; a
// CONFIRMED other context -> H_SWITCH (use what you know); a lone context
// -> H_RECRUIT (preservation before revision: do not destroy a confirmed
// claim to explain a surprise); otherwise H_ARM (re-open the challenger).
// Frozen (learn==0): detection only — switch to confirmed knowledge.
fn h_surprise(s:*TrlState,c:i32,o:i32,learn:i32,allow_switch:i32)i32 {
    if(s.*.x_st==1 || s.*.x_st==2){return 0;}
    let k:i32=h_find(s,c,o);
    // Surprise = negative on the working hypothesis: the incumbent, or the
    // challenger when it is the fallback exploitation target (incumbent
    // dead/empty). A challenger negative while the incumbent is live was a
    // test episode and is already answered by h_update.
    let working:i32=0;
    if(k==0){working=1;}
    else if(k==1){let ist:i32=h_st(s,c,0);if(ist!=1 && ist!=4){working=1;}}
    if(learn==1 && working==1){
        h_set_incmax(s,c,0);
        // Priority 1: a live CONFIRMED claim in the other context explains
        // the surprise as a regime return -> H_SWITCH test.
        if(s.*.x_st==0 || s.*.x_st==6){
            if(s.*.contexts==3 && h_other_confirmed(s,c)==1){
                h_form_x(s,1,1-c);h_suppress_ch(s,c);return 1;
            }
            // Priority 2: no explanation on hand -> partition the context.
            if(s.*.contexts==1){h_form_x(s,0,1);h_suppress_ch(s,c);return 1;}
        }
        // Priority 3: arm-level fallback only; never re-form a failed idea.
        h_activate_ch(s,c);
        return 0;
    }
    if(learn==0 && allow_switch==1 && s.*.x_st!=1 && s.*.x_st!=2){
        // Frozen detection probe: the active context is wrong; test the
        // other context's live claim. One-shot; always resolves.
        if(s.*.contexts==3 && h_other_confirmed(s,c)==1){h_form_x(s,1,1-c);return 1;}
        return 0;
    }
    if(learn==1 && h_live_claims(s,c)==0 && (s.*.x_st==0 || s.*.x_st==6)){
        // Backstop: no live claims left. Partition once if possible,
        // otherwise reopen the challenger for arm-level relearning.
        if(s.*.contexts==1){h_form_x(s,0,1);return 1;}
        h_activate_ch(s,c);
    }
    return 0;
}

fn trl_init()TrlState {
    let s:TrlState=TrlState{
        .h00_obj=0,.h00_st=1,.h00_sup=0,.h00_ref=0,.h00_spent=0,
        .h01_obj=1,.h01_st=2,.h01_sup=0,.h01_ref=0,.h01_spent=0,
        .h10_obj=0,.h10_st=0,.h10_sup=0,.h10_ref=0,.h10_spent=0,
        .h11_obj=0,.h11_st=0,.h11_sup=0,.h11_ref=0,.h11_spent=0,
        .disp0=0,.disp1=0,.incmax0=0,.incmax1=0,
        .x_st=0,.x_kind=0,.x_tgt=0,.x_sup=0,.x_ref=0,
        .maxrw=-1,
        .active=0,.contexts=1,
        .pending=0,.pending_action=0,.pending_context=0,.pending_object=0,.pending_explore=0,
        .decisions=0,.switches=0,.outcomes=0,.explores=0,.expl_pos=0,
        .updates=0,.hyp_confirmed=0,.hyp_refuted=0};
    return s;
}

fn trl_choose(s:*TrlState,explore_enabled:i32,was_explore:*i32)i32 {
    if(s==null as *TrlState || was_explore==null as *i32 || s.*.pending!=0){return -1;}
    let c:i32=s.*.active;let ex:i32=0;let desired:i32=0;
    let ist:i32=h_st(s,c,0);
    if(ist==1 || ist==4){desired=h_obj(s,c,0);}
    else{
        let chs:i32=h_st(s,c,1);
        if(chs>=1 && chs<=4){desired=h_obj(s,c,1);}else{desired=0;}
    }
    if(s.*.x_st==1){
        // Cross-context test. A frozen detection switch (kind==1) may
        // execute with exploration disabled; it is detection, not a test,
        // and is not counted. A frozen recruit is pointless (a new context
        // cannot learn) and stands down.
        if(s.*.x_kind==0 && explore_enabled==0){s.*.x_st=6;}
        else{
            if(s.*.x_kind==0){
                s.*.contexts=3;s.*.active=1;s.*.switches=s.*.switches+1;c=1;desired=0;
            } else {
                s.*.active=s.*.x_tgt;c=s.*.x_tgt;s.*.switches=s.*.switches+1;
                desired=0;let ts:i32=h_st(s,c,0);if(ts==1 || ts==4){desired=h_obj(s,c,0);}
            }
            s.*.x_st=2;
            if(explore_enabled==1){ex=1;s.*.explores=s.*.explores+1;}
        }
    } else if(explore_enabled==1){
        let ks:i32=h_st(s,c,1);
        if((ks==2 || ks==3) && h_incmax(s,c)==0){
            desired=h_obj(s,c,1);h_set_st(s,c,1,3);
            h_set_spent(s,c,1,h_spent(s,c,1)+1);
            ex=1;s.*.explores=s.*.explores+1;
        }
    }
    was_explore.*=ex;s.*.decisions=s.*.decisions+1;return desired;
}

fn trl_accept(s:*TrlState,action_id:i32,reward:i32,learn:i32,allow_switch:i32)i32 {
    if(s==null as *TrlState || s.*.pending!=1 || action_id!=s.*.pending_action || (reward!=1 && reward!=-1)){return cl_bad();}
    let c:i32=s.*.pending_context;let o:i32=s.*.pending_object;let xf:i32=s.*.pending_explore;
    if(learn==1){
        if(reward>s.*.maxrw){s.*.maxrw=reward;}
        let k:i32=h_find(s,c,o);
        // Count first; transitions after attribution, so a negative that the
        // surprise handler assigns to the context level is not evidence
        // against the arm claim.
        if(k>=0){h_count(s,c,k,reward,xf);}
        if(k==0 && reward>0 && reward==s.*.maxrw){h_set_incmax(s,c,1);}
        let formed:i32=0;
        if(reward<0 && xf==0){formed=h_surprise(s,c,o,learn,allow_switch);}
        if(formed==1 && k>=0){
            let r:i32=h_ref(s,c,k);if(r>0){h_set_ref(s,c,k,r-1);}
        }
        if(k>=0){h_transitions(s,c,k);}
    } else {
        if(reward<0 && xf==0){h_surprise(s,c,o,learn,allow_switch);}
    }
    // One-shot cross-context hypothesis: its test executed, so it resolves
    // in any mode. Seeding a fresh context is learning-gated.
    if(s.*.x_st==2){
        if(reward>0){s.*.x_sup=1;s.*.x_st=6;}
        else{s.*.x_ref=1;s.*.x_st=5;}
        if(learn==1 && s.*.x_kind==0){h_seed(s,c,o,reward);}
    }
    if(xf==1 && reward>0){s.*.expl_pos=s.*.expl_pos+1;}
    if(reward<0 && xf==0){h_surprise(s,c,o,learn,allow_switch);}
    s.*.outcomes=s.*.outcomes+1;
    s.*.pending=0;s.*.pending_action=0;s.*.pending_context=0;s.*.pending_object=0;s.*.pending_explore=0;
    return 0;
}

fn trl_actor(obs:[]u8)i32 {
    if(cl_observation_check(obs)!=0 || cl_u32(obs,24)!=2 || cl_u32(obs,32)!=8 || cl_u32(obs,36)!=8 || cl_u32(obs,40)!=3){return -1;}
    let x:i32=0;while(x<8){let at:i32=80+(6*8+x)*3;if(obs[at]==32 && obs[at+1]==220 && obs[at+2]==32){return x;}x=x+1;}return -1;
}
fn trl_feature(obs:[]u8,x:i32)i32 {
    if(cl_observation_check(obs)!=0 || x<0 || x>7){return -1;}let at:i32=80+(3*8+x)*3;
    if(obs[at]!=160 || obs[at+1]!=160){return -1;}if(obs[at+2]<100){return 0;}return 1;
}

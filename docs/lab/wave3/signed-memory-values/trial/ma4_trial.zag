// MA4 — signed-value memory agency vs MA3 agency baseline (PREREG_MA4).
// Zero RNG: explicit modular curriculum, deterministic learner (lowest slot
// index tie-breaks, fixed rules). Arms: BASE (MA3 AGENCY policy verbatim)
// vs SIGNED (POLICY.md: signed trust, pin budget, deliberate negative
// judgments, scheduled re-evaluation). No reward signal anywhere.
@import("ma_common.zag")

const MA4_SLOTS:i32=32;
const MA4_EPISODES:i32=500;
const MA4_DELAY:i32=25;
const MA4_FEATS:i32=8;
const MA4_TRUST_INIT:i32=64;
const MA4_TRUST_MAX:i32=256;
const MA4_UNCERTAIN_T:i32=120;
const MA4_PIN_BUDGET:i32=16;
const MA4_PINLOG_CAP:i32=512;

// Explicit curriculum: closed-form functions of (episode, feature, variant).
// No RNG. Standard: early features honest. Adversarial: f0..f3 trap
// (anti-correlated with importance early).
fn ma4_build(variant:i32,cur:i32,f_of_mid:[]u8,mem_imp:[]u8)void {
    let m:i32=0;
    while(m<MA4_EPISODES){
        let imp:i32=0;
        if(ma_mod(7*m+13*variant+3,10)<3){imp=1;}
        mem_imp[m]=imp as u8;
        let f:i32=0;
        while(f<MA4_FEATS){
            let n1:i32=ma_mod(13*m+5*f+29*variant,2);
            let fv:i32=0;
            if(cur==0){
                if(f<4){fv=imp*3+n1;}
                else{fv=imp*1+ma_mod(11*m+7*f+17*variant,3);}
            } else {
                if(f<4){fv=(1-imp)*3+n1;}
                else{fv=imp*2+ma_mod(11*m+7*f+17*variant,2);}
            }
            f_of_mid[m*MA4_FEATS+f]=fv as u8;
            f=f+1;
        }
        m=m+1;
    }
}

// Signed declared value: trust may be negative, so v may be negative.
fn ma4_score(trust:[]u8,fx:[]u8,base:i32)i32 {
    let v:i32=0;let k:i32=0;
    while(k<MA4_FEATS){
        v=v+ma_i32_get(trust,k*4)*((fx[base+k]) as i32);
        k=k+1;
    }
    return ma_div_floor(v,64);
}

// Mark the latest still-pinned log entry for slot as learner-unpinned.
fn ma4_mark_unpin(plog_s:[]u8,plog_u:[]u8,plog_n:i32,slot:i32)void {
    let k:i32=plog_n-1;
    while(k>=0){
        if(ma_i32_get(plog_s,k*4)==slot && plog_u[k]==0){plog_u[k]=1;break;}
        k=k-1;
    }
}

// Churn victim: live unpinned USER slot with min FRESH signed score.
// Ties -> lowest slot index (deterministic, no RNG).
fn ma4_victim_fresh(s:*MaStore,trust:[]u8,feat:[]u8,cap:i32,out_v:*i32,out_vv:*i32)i32 {
    let vic:i32=-1;let vicv:i32=2147483647;let i:i32=0;
    while(i<cap){
        if(s.*.live[i]==1 && s.*.pinned[i]==0 && s.*.region[i]==MA_REGION_USER as u8){
            let v:i32=ma4_score(trust,feat,i*MA4_FEATS);
            if(v<vicv){vicv=v;vic=i;}
        }
        i=i+1;
    }
    out_v.*=vic;out_vv.*=vicv;
    if(vic<0){return 0;}return 1;
}

fn ma4_count_pins(s:*MaStore,cap:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<cap){
        if(s.*.live[i]==1 && s.*.pinned[i]==1 && s.*.region[i]==MA_REGION_USER as u8){n=n+1;}
        i=i+1;
    }
    return n;
}

// White-box invariant: no successful KILL ever had pinned==1 before.
fn ma4_no_pinned_kills(s:*MaStore)i32 {
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let op:i32=ma_i32_get(s.*.audit,e+0);
        let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(op==MA_OP_KILL && rc==MA_OK){
            let b1:i32=ma_i32_get(s.*.audit,e+12);
            if(((b1>>8)&255)==1){return 1;}
        }
        i=i+1;
    }
    return 0;
}

// Pin with budget counter + pin log. No-op if already pinned.
fn ma4_pin_c(s:*MaStore,sl:i32,pins:*i32,plog_s:[]u8,plog_v:[]u8,plog_u:[]u8,plog_n:*i32)void {
    if(s.*.pinned[sl]==1){return;}
    if(ma_pin(s,sl)==MA_OK){
        pins.*=pins.*+1;
        let n:i32=plog_n.*;
        if(n<MA4_PINLOG_CAP){
            ma_i32_set(plog_s,n*4,sl);
            ma_i32_set(plog_v,n*4,ma_i32_get(s.*.value,sl*4));
            plog_u[n]=0;plog_n.*=n+1;
        }
    }
}

// Unpin with budget counter + pin log. No-op if already unpinned.
fn ma4_unpin_c(s:*MaStore,sl:i32,pins:*i32,plog_s:[]u8,plog_u:[]u8,plog_n:i32)void {
    if(s.*.pinned[sl]==0){return;}
    if(ma_unpin(s,sl)==MA_OK){
        pins.*=pins.*-1;
        ma4_mark_unpin(plog_s,plog_u,plog_n,sl);
    }
}

// One cell: BASE vs SIGNED on the identical explicit stream.
// cur 0=standard, 1=adversarial; variant 0..2 phase offset.
fn ma4_cell(cur:i32,variant:i32,report:i32,
            out_hb:*i32,out_hs:*i32,out_invalid:*i32,out_fpb:*i32,out_fps:*i32)i32 {
    let f_of_mid:[]u8=nio_alloc(MA4_EPISODES*MA4_FEATS);
    let mem_imp:[]u8=nio_alloc(MA4_EPISODES);
    ma4_build(variant,cur,f_of_mid,mem_imp);
    let invalid:i32=0;

    // ================= BASE arm (MA3 AGENCY verbatim) =================
    let s:MaStore=ma_init();
    ma_set_stage(&s,MA_STAGE_KILL);
    let cs:i32=-1;
    ma_add_lim(&s,95,MA_REGION_CORE,MA4_SLOTS,&cs);
    ma_add_lim(&s,90,MA_REGION_CORE,MA4_SLOTS,&cs);
    let btrust:[]u8=nio_alloc(MA4_FEATS*4);
    let bfeat:[]u8=nio_alloc(MA4_SLOTS*MA4_FEATS);
    let bmem_slot:[]u8=nio_alloc(MA4_EPISODES*4);
    let bslot_mid:[]u8=nio_alloc(MA_CAP*4);
    let badd_ep:[]u8=nio_alloc(MA4_EPISODES*4);
    let bqueue:[]u8=nio_alloc(MA4_EPISODES*4);
    let bqh:i32=0;let bqt:i32=0;
    let bplog_s:[]u8=nio_alloc(MA4_PINLOG_CAP*4);
    let bplog_v:[]u8=nio_alloc(MA4_PINLOG_CAP*4);
    let bplog_u:[]u8=nio_alloc(MA4_PINLOG_CAP);
    let bplog_n:i32=0;
    let m:i32=0;while(m<MA4_FEATS){ma_i32_set(btrust,m*4,MA4_TRUST_INIT);m=m+1;}
    m=0;while(m<MA4_EPISODES){ma_i32_set(bmem_slot,m*4,-1);ma_i32_set(badd_ep,m*4,-1);m=m+1;}
    m=0;while(m<MA_CAP){ma_i32_set(bslot_mid,m*4,-1);m=m+1;}
    m=0;while(m<MA4_PINLOG_CAP){bplog_u[m]=0;m=m+1;}
    let brev:i32=0;let bdrops:i32=0;let bkills:i32=0;
    let t:i32=0;
    while(t<MA4_EPISODES){
        while(bqh<bqt){
            let qm:i32=ma_i32_get(bqueue,bqh*4);
            let ae:i32=ma_i32_get(badd_ep,qm*4);
            if(t-ae<MA4_DELAY){break;}
            bqh=bqh+1;brev=brev+1;
            let sl:i32=ma_i32_get(bmem_slot,qm*4);
            if(sl>=0 && ma_i32_get(bslot_mid,sl*4)==qm && s.live[sl]==1){
                let imp:i32=mem_imp[qm] as i32;
                let k:i32=0;
                while(k<MA4_FEATS){
                    let x:i32=bfeat[sl*MA4_FEATS+k] as i32;
                    let tr:i32=ma_i32_get(btrust,k*4);
                    if(imp==1){tr=ma_min2(MA4_TRUST_MAX,tr+x);}
                    else{tr=ma_max2(0,tr-x);}
                    ma_i32_set(btrust,k*4,tr);
                    k=k+1;
                }
                if(s.pinned[sl]==1){
                    if(imp==1){ma_promote(&s,sl);}
                    else{ma_unpin(&s,sl);ma4_mark_unpin(bplog_s,bplog_u,bplog_n,sl);}
                }
            }
        }
        let v:i32=ma4_score(btrust,f_of_mid,t*MA4_FEATS);
        let e:i32=ma_empty_lim(&s,MA4_SLOTS);
        if(e>=0){
            let os:i32=-1;
            if(ma_add_lim(&s,v,MA_REGION_USER,MA4_SLOTS,&os)==MA_OK){
                ma_i32_set(bmem_slot,t*4,os);ma_i32_set(bslot_mid,os*4,t);ma_i32_set(badd_ep,t*4,t);
                let k3:i32=0;
                while(k3<MA4_FEATS){bfeat[os*MA4_FEATS+k3]=f_of_mid[t*MA4_FEATS+k3];k3=k3+1;}
                ma_i32_set(bqueue,bqt*4,t);bqt=bqt+1;
                if(brev<MA4_UNCERTAIN_T){
                    if(ma_pin(&s,os)==MA_OK && bplog_n<MA4_PINLOG_CAP){
                        ma_i32_set(bplog_s,bplog_n*4,os);ma_i32_set(bplog_v,bplog_n*4,v);
                        bplog_u[bplog_n]=0;bplog_n=bplog_n+1;
                    }
                }
            }
        } else {
            let vic:i32=-1;let vicv:i32=0;
            if(ma_victim(&s,MA4_SLOTS,&vic,&vicv)==1 && v>vicv){
                ma_kill(&s,vic);bkills=bkills+1;
                ma_i32_set(bslot_mid,vic*4,-1);
                let os:i32=-1;
                if(ma_add_lim(&s,v,MA_REGION_USER,MA4_SLOTS,&os)==MA_OK){
                    ma_i32_set(bmem_slot,t*4,os);ma_i32_set(bslot_mid,os*4,t);ma_i32_set(badd_ep,t*4,t);
                    let k3:i32=0;
                    while(k3<MA4_FEATS){bfeat[os*MA4_FEATS+k3]=f_of_mid[t*MA4_FEATS+k3];k3=k3+1;}
                    ma_i32_set(bqueue,bqt*4,t);bqt=bqt+1;
                    if(brev<MA4_UNCERTAIN_T){
                        if(ma_pin(&s,os)==MA_OK && bplog_n<MA4_PINLOG_CAP){
                            ma_i32_set(bplog_s,bplog_n*4,os);ma_i32_set(bplog_v,bplog_n*4,v);
                            bplog_u[bplog_n]=0;bplog_n=bplog_n+1;
                        }
                    }
                }
            } else {bdrops=bdrops+1;}
        }
        t=t+1;
    }
    // BASE endpoint scoring + quartiles.
    let hb_tot:i32=0;let hb_ret:i32=0;
    let bq_r0:i32=0;let bq_t0:i32=0;let bq_r1:i32=0;let bq_t1:i32=0;
    let bq_r2:i32=0;let bq_t2:i32=0;let bq_r3:i32=0;let bq_t3:i32=0;
    m=0;
    while(m<MA4_EPISODES){
        let imp:i32=mem_imp[m] as i32;
        let sl:i32=ma_i32_get(bmem_slot,m*4);
        let held:i32=0;
        if(sl>=0 && ma_i32_get(bslot_mid,sl*4)==m && s.live[sl]==1){held=1;}
        if(imp==1 && ma_i32_get(badd_ep,m*4)>=0){
            hb_tot=hb_tot+1;hb_ret=hb_ret+held;
            let qq:i32=m/125;
            if(qq==0){bq_t0=bq_t0+1;bq_r0=bq_r0+held;}
            else if(qq==1){bq_t1=bq_t1+1;bq_r1=bq_r1+held;}
            else if(qq==2){bq_t2=bq_t2+1;bq_r2=bq_r2+held;}
            else{bq_t3=bq_t3+1;bq_r3=bq_r3+held;}
        }
        m=m+1;
    }
    if(s.live[0]!=1 || s.live[1]!=1){invalid=1;}
    let pk:i32=0;
    while(pk<bplog_n){
        if(bplog_u[pk]==0){
            let ps:i32=ma_i32_get(bplog_s,pk*4);let pv:i32=ma_i32_get(bplog_v,pk*4);
            if(s.live[ps]!=1 || ma_i32_get(s.value,ps*4)!=pv){invalid=1;}
        }
        pk=pk+1;
    }
    if(ma4_no_pinned_kills(&s)!=0){invalid=1;}
    if(ma_replay_check(&s)!=MA_OK){invalid=1;}
    let fp_b:i32=ma_fingerprint(&s,hb_ret*1000003+hb_tot*1009+bdrops*101+bkills*7+brev);
    pk=0;while(pk<MA4_FEATS){fp_b=fp_b+ma_i32_get(btrust,pk*4)*(pk+7);pk=pk+1;}

    // ================= SIGNED arm (POLICY.md) =================
    let g:MaStore=ma_init();
    ma_set_stage(&g,MA_STAGE_KILL);
    cs=-1;
    ma_add_lim(&g,95,MA_REGION_CORE,MA4_SLOTS,&cs);
    ma_add_lim(&g,90,MA_REGION_CORE,MA4_SLOTS,&cs);
    let trust:[]u8=nio_alloc(MA4_FEATS*4);
    let feat:[]u8=nio_alloc(MA4_SLOTS*MA4_FEATS);
    let mem_slot:[]u8=nio_alloc(MA4_EPISODES*4);
    let slot_mid:[]u8=nio_alloc(MA_CAP*4);
    let add_ep:[]u8=nio_alloc(MA4_EPISODES*4);
    let queue:[]u8=nio_alloc(MA4_EPISODES*4);
    let qh:i32=0;let qt:i32=0;
    let plog_s:[]u8=nio_alloc(MA4_PINLOG_CAP*4);
    let plog_v:[]u8=nio_alloc(MA4_PINLOG_CAP*4);
    let plog_u:[]u8=nio_alloc(MA4_PINLOG_CAP);
    let plog_n:i32=0;
    m=0;while(m<MA4_FEATS){ma_i32_set(trust,m*4,MA4_TRUST_INIT);m=m+1;}
    m=0;while(m<MA4_EPISODES){ma_i32_set(mem_slot,m*4,-1);ma_i32_set(add_ep,m*4,-1);m=m+1;}
    m=0;while(m<MA_CAP){ma_i32_set(slot_mid,m*4,-1);m=m+1;}
    m=0;while(m<MA4_PINLOG_CAP){plog_u[m]=0;m=m+1;}
    let revelations:i32=0;let drops:i32=0;let kills:i32=0;
    let unpins:i32=0;let reap_unpins:i32=0;let pins:i32=0;let reaped:i32=0;
    t=0;
    while(t<MA4_EPISODES){
        // Delayed revelations: signed trust update + deliberate judgments.
        while(qh<qt){
            let qm:i32=ma_i32_get(queue,qh*4);
            let ae:i32=ma_i32_get(add_ep,qm*4);
            if(t-ae<MA4_DELAY){break;}
            qh=qh+1;revelations=revelations+1;
            let sl:i32=ma_i32_get(mem_slot,qm*4);
            if(sl>=0 && ma_i32_get(slot_mid,sl*4)==qm && g.live[sl]==1){
                let imp:i32=mem_imp[qm] as i32;
                let k:i32=0;
                while(k<MA4_FEATS){
                    let x:i32=feat[sl*MA4_FEATS+k] as i32;
                    let tr:i32=ma_i32_get(trust,k*4);
                    if(imp==1){tr=ma_min2(MA4_TRUST_MAX,tr+x);}
                    else{tr=ma_max2(-MA4_TRUST_MAX,tr-x);}
                    ma_i32_set(trust,k*4,tr);
                    k=k+1;
                }
                if(imp==1){
                    ma_promote(&g,sl);
                    if(pins<MA4_PIN_BUDGET){ma4_pin_c(&g,sl,&pins,plog_s,plog_v,plog_u,&plog_n);}
                } else {
                    // JUDGE_WORTHLESS: deliberate negative judgment, audited.
                    if(g.pinned[sl]==1){ma4_unpin_c(&g,sl,&pins,plog_s,plog_u,plog_n);unpins=unpins+1;}
                    if(ma_kill(&g,sl)==MA_OK){
                        kills=kills+1;
                        ma_i32_set(slot_mid,sl*4,-1);
                    }
                }
            }
        }
        // Scheduled re-evaluation pass (once): withdraw protection from
        // pinned slots the signed judgment now rates negative.
        if(reaped==0 && revelations>=MA4_UNCERTAIN_T){
            reaped=1;
            let rs:i32=0;
            while(rs<MA4_SLOTS){
                if(g.live[rs]==1 && g.pinned[rs]==1 && g.region[rs]==MA_REGION_USER as u8){
                    if(ma4_score(trust,feat,rs*MA4_FEATS)<0){
                        ma4_unpin_c(&g,rs,&pins,plog_s,plog_u,plog_n);
                        reap_unpins=reap_unpins+1;
                    }
                }
                rs=rs+1;
            }
        }
        // Incoming memory: signed declared value (explicit judgment).
        let v:i32=ma4_score(trust,f_of_mid,t*MA4_FEATS);
        let e:i32=ma_empty_lim(&g,MA4_SLOTS);
        if(e>=0){
            let os:i32=-1;
            if(ma_add_lim(&g,v,MA_REGION_USER,MA4_SLOTS,&os)==MA_OK){
                ma_i32_set(mem_slot,t*4,os);ma_i32_set(slot_mid,os*4,t);ma_i32_set(add_ep,t*4,t);
                let k3:i32=0;
                while(k3<MA4_FEATS){feat[os*MA4_FEATS+k3]=f_of_mid[t*MA4_FEATS+k3];k3=k3+1;}
                ma_i32_set(queue,qt*4,t);qt=qt+1;
                if(revelations<MA4_UNCERTAIN_T && pins<MA4_PIN_BUDGET){
                    ma4_pin_c(&g,os,&pins,plog_s,plog_v,plog_u,&plog_n);
                }
            }
        } else if(revelations<MA4_UNCERTAIN_T){
            // Phase A: no destruction before knowledge — drop overflow.
            drops=drops+1;
        } else {
            // Phase B: signed churn. Victim = lowest fresh signed score.
            let vic:i32=-1;let vicv:i32=0;
            if(ma4_victim_fresh(&g,trust,feat,MA4_SLOTS,&vic,&vicv)==1 && v>vicv){
                if(ma_kill(&g,vic)==MA_OK){
                    kills=kills+1;
                    ma_i32_set(slot_mid,vic*4,-1);
                    let os:i32=-1;
                    if(ma_add_lim(&g,v,MA_REGION_USER,MA4_SLOTS,&os)==MA_OK){
                        ma_i32_set(mem_slot,t*4,os);ma_i32_set(slot_mid,os*4,t);ma_i32_set(add_ep,t*4,t);
                        let k3:i32=0;
                        while(k3<MA4_FEATS){feat[os*MA4_FEATS+k3]=f_of_mid[t*MA4_FEATS+k3];k3=k3+1;}
                        ma_i32_set(queue,qt*4,t);qt=qt+1;
                    }
                }
            } else {drops=drops+1;}
        }
        t=t+1;
    }
    // SIGNED endpoint scoring + quartiles.
    let hs_tot:i32=0;let hs_ret:i32=0;
    let sq_r0:i32=0;let sq_t0:i32=0;let sq_r1:i32=0;let sq_t1:i32=0;
    let sq_r2:i32=0;let sq_t2:i32=0;let sq_r3:i32=0;let sq_t3:i32=0;
    m=0;
    while(m<MA4_EPISODES){
        let imp:i32=mem_imp[m] as i32;
        let sl:i32=ma_i32_get(mem_slot,m*4);
        let held:i32=0;
        if(sl>=0 && ma_i32_get(slot_mid,sl*4)==m && g.live[sl]==1){held=1;}
        if(imp==1 && ma_i32_get(add_ep,m*4)>=0){
            hs_tot=hs_tot+1;hs_ret=hs_ret+held;
            let qq:i32=m/125;
            if(qq==0){sq_t0=sq_t0+1;sq_r0=sq_r0+held;}
            else if(qq==1){sq_t1=sq_t1+1;sq_r1=sq_r1+held;}
            else if(qq==2){sq_t2=sq_t2+1;sq_r2=sq_r2+held;}
            else{sq_t3=sq_t3+1;sq_r3=sq_r3+held;}
        }
        m=m+1;
    }
    if(g.live[0]!=1 || g.live[1]!=1){invalid=1;}
    pk=0;
    while(pk<plog_n){
        if(plog_u[pk]==0){
            let ps:i32=ma_i32_get(plog_s,pk*4);let pv:i32=ma_i32_get(plog_v,pk*4);
            if(g.live[ps]!=1 || ma_i32_get(g.value,ps*4)!=pv){invalid=1;}
        }
        pk=pk+1;
    }
    if(ma4_no_pinned_kills(&g)!=0){invalid=1;}
    if(ma_replay_check(&g)!=MA_OK){invalid=1;}
    if(ma4_count_pins(&g,MA4_SLOTS)!=pins){invalid=1;}
    if(pins>MA4_PIN_BUDGET){invalid=1;}
    let fp_s:i32=ma_fingerprint(&g,hs_ret*1000003+hs_tot*1009+drops*101+kills*7+revelations);
    pk=0;while(pk<MA4_FEATS){fp_s=fp_s+ma_i32_get(trust,pk*4)*(pk+11);pk=pk+1;}

    if(report==1){
        let hb_pct:i32=0;if(hb_tot>0){hb_pct=hb_ret*100/hb_tot;}
        let hs_pct:i32=0;if(hs_tot>0){hs_pct=hs_ret*100/hs_tot;}
        _zag_print("MA4_CELL,cur,");cl_number(cur as i64);
        _zag_print(",variant,");cl_number(variant as i64);
        _zag_print(",BASE,");cl_number(hb_ret as i64);_zag_print(",");cl_number(hb_tot as i64);
        _zag_print(",");cl_number(hb_pct as i64);
        _zag_print(",SIGNED,");cl_number(hs_ret as i64);_zag_print(",");cl_number(hs_tot as i64);
        _zag_print(",");cl_number(hs_pct as i64);_zag_println("");
        _zag_print("MA4_COHORT,B,");cl_number(bq_r0 as i64);_zag_print(",");cl_number(bq_t0 as i64);
        _zag_print(",");cl_number(bq_r1 as i64);_zag_print(",");cl_number(bq_t1 as i64);
        _zag_print(",");cl_number(bq_r2 as i64);_zag_print(",");cl_number(bq_t2 as i64);
        _zag_print(",");cl_number(bq_r3 as i64);_zag_print(",");cl_number(bq_t3 as i64);
        _zag_println("");
        _zag_print("MA4_COHORT,S,");cl_number(sq_r0 as i64);_zag_print(",");cl_number(sq_t0 as i64);
        _zag_print(",");cl_number(sq_r1 as i64);_zag_print(",");cl_number(sq_t1 as i64);
        _zag_print(",");cl_number(sq_r2 as i64);_zag_print(",");cl_number(sq_t2 as i64);
        _zag_print(",");cl_number(sq_r3 as i64);_zag_print(",");cl_number(sq_t3 as i64);
        _zag_println("");
        _zag_print("MA4_DIAG,B,drops,");cl_number(bdrops as i64);
        _zag_print(",kills,");cl_number(bkills as i64);
        _zag_print(",revelations,");cl_number(brev as i64);_zag_println("");
        _zag_print("MA4_DIAG,S,drops,");cl_number(drops as i64);
        _zag_print(",kills,");cl_number(kills as i64);
        _zag_print(",unpins,");cl_number(unpins as i64);
        _zag_print(",reap_unpins,");cl_number(reap_unpins as i64);
        _zag_print(",pins_end,");cl_number(pins as i64);
        _zag_print(",revelations,");cl_number(revelations as i64);_zag_println("");
        _zag_print("MA4_TRUST,B,");cl_number(ma_i32_get(btrust,0) as i64);
        let ti:i32=1;while(ti<MA4_FEATS){_zag_print(",");cl_number(ma_i32_get(btrust,ti*4) as i64);ti=ti+1;}
        _zag_println("");
        _zag_print("MA4_TRUST,S,");cl_number(ma_i32_get(trust,0) as i64);
        ti=1;while(ti<MA4_FEATS){_zag_print(",");cl_number(ma_i32_get(trust,ti*4) as i64);ti=ti+1;}
        _zag_println("");
    }

    out_hb.*=hb_ret;out_hs.*=hs_ret;out_invalid.*=invalid;
    out_fpb.*=fp_b;out_fps.*=fp_s;
    nio_free(f_of_mid);nio_free(mem_imp);
    nio_free(s.live);nio_free(s.value);nio_free(s.pinned);nio_free(s.region);
    nio_free(s.tier);nio_free(s.step);nio_free(s.audit);
    nio_free(btrust);nio_free(bfeat);nio_free(bmem_slot);nio_free(bslot_mid);
    nio_free(badd_ep);nio_free(bqueue);nio_free(bplog_s);nio_free(bplog_v);nio_free(bplog_u);
    nio_free(g.live);nio_free(g.value);nio_free(g.pinned);nio_free(g.region);
    nio_free(g.tier);nio_free(g.step);nio_free(g.audit);
    nio_free(trust);nio_free(feat);nio_free(mem_slot);nio_free(slot_mid);
    nio_free(add_ep);nio_free(queue);nio_free(plog_s);nio_free(plog_v);nio_free(plog_u);
    return 0;
}

fn main()i32 {
    let f:i32=0;
    let adv_ok:i32=1;let std_ok:i32=1;
    let c:i32=0;
    while(c<2){
        let vi:i32=0;
        while(vi<3){
            let hb1:i32=0;let hs1:i32=0;let inv1:i32=0;let fpb1:i32=0;let fps1:i32=0;
            let hb2:i32=0;let hs2:i32=0;let inv2:i32=0;let fpb2:i32=0;let fps2:i32=0;
            ma4_cell(c,vi,1,&hb1,&hs1,&inv1,&fpb1,&fps1);
            ma4_cell(c,vi,0,&hb2,&hs2,&inv2,&fpb2,&fps2);
            f=f+cl_check("cell_valid",inv1+inv2,0);
            f=f+cl_check("det_base",fpb1,fpb2);
            f=f+cl_check("det_signed",fps1,fps2);
            if(inv1+inv2!=0){
                _zag_print("MA4_VERDICT,INVALID");_zag_println("");
                _zag_print("MA4_FAILURES,");cl_number(f as i64);_zag_println("");
                _zag_print("MA4_DONE");_zag_println("");
                return 1;
            }
            if(c==1){
                if(hs1<=hb1){adv_ok=0;}
            } else {
                if(hs1<hb1){std_ok=0;}
            }
            vi=vi+1;
        }
        c=c+1;
    }
    _zag_print("MA4_TALLY,adv_ok,");cl_number(adv_ok as i64);
    _zag_print(",std_ok,");cl_number(std_ok as i64);_zag_println("");
    // Prereg verdict: CONFIRM iff SIGNED strictly wins all adversarial cells
    // and never regresses on standard. FALSIFY is the exact complement
    // (decisive by construction); INVALID handled above.
    if(adv_ok==1 && std_ok==1){_zag_print("MA4_VERDICT,CONFIRM_SIGNED_SUPERIOR");_zag_println("");}
    else{_zag_print("MA4_VERDICT,FALSIFY");_zag_println("");}
    _zag_print("MA4_FAILURES,");cl_number(f as i64);_zag_println("");
    _zag_print("MA4_DONE");_zag_println("");
    return (f!=0) as i32;
}

// trial_ht2.zag — HT2 trial driver.
// Three arms on the randomized curriculum R (flip sequence identical to
// HT1's run), plus the HT2 learner on the designed adversarial curriculum A.
// Micah's acceptance test: the randomized switching curriculum must not fail.
//
// The WORLD (harness) may be unpredictable — that is the test. The SYSTEM
// (the HT2 learner in ht2_learner.zag) is deterministic: no randomness,
// no timers, no schedules, no reward in its decision path.
@import("ht2_learner.zag")
@import("toy_core.zag")

const HT_EPS:i32=48;
const HT_PROBES:i32=16;

fn ht_next(r:*i32)i32 {
    r.*=r34v3_mod(r.* * 997 + 7919, 1000003);
    return r.*;
}

// ---- HT1R arm: HT1's protocol-fixed policy, copied verbatim from
// trial_ht1.zag (fidelity control — must reproduce HT1's CTX numbers). ----
fn ctx_probe_label(s:*CtxStore,slot:i32,true_reg:i32,rng:*i32,noisy:i32)i32 {
    let hits:i32=0;let p:i32=0;
    while(p<HT_PROBES){
        let h:i32=0;
        if(ctx_i32_get(s.*.label,slot*4)==true_reg){h=1;}
        if(noisy==1 && r34v3_mod(ht_next(rng),100)<15){h=1-h;}
        hits=hits+h;p=p+1;
    }
    return hits;
}
fn ctx_episode(s:*CtxStore,true_reg:i32,rng:*i32,err:*i32)void {
    let h:i32=ctx_probe_label(s,s.*.active,true_reg,rng,1);
    if(ctx_record(s,s.*.active,h,HT_PROBES)!=CTX_OK){err.*=err.*+1;}
    if((s.*.bad[s.*.active] as i32)>=1){
        let t:i32=0;let done:i32=0;
        while(t<CTX_CAP){
            if(t!=s.*.active && s.*.live[t]==1){
                let ch:i32=ctx_probe_label(s,t,true_reg,rng,1);
                if(ctx_record(s,t,ch,HT_PROBES)!=CTX_OK){err.*=err.*+1;}
                if(ctx_switch(s,t)==CTX_OK){done=1;break;}
            }
            t=t+1;
        }
        if(done==0){
            let nl:i32=1-ctx_i32_get(s.*.label,s.*.active*4);
            let ns:i32=-1;
            if(ctx_propose(s,nl,&ns)==CTX_OK){
                let ch2:i32=ctx_probe_label(s,ns,true_reg,rng,1);
                if(ctx_record(s,ns,ch2,HT_PROBES)!=CTX_OK){err.*=err.*+1;}
                ctx_switch(s,ns);
            } else { err.*=err.*+1; }
        }
    }
}
fn ctx_measure(s:*CtxStore,true_reg:i32)i32 {
    let pos:i32=0;let p:i32=0;
    while(p<HT_PROBES){
        if(ctx_i32_get(s.*.label,s.*.active*4)==true_reg){pos=pos+1;}
        p=p+1;
    }
    return pos;
}
fn toy_train_episode(t:*R34V3State,true_reg:i32,rng:*i32)void {
    let k:i32=0;
    while(k<HT_PROBES){
        let was:i32=0;
        let obj:i32=r34v3_choose(t,0,&was);
        t.*.pending=1;t.*.pending_action=obj;t.*.pending_context=t.*.active;
        t.*.pending_object=obj;t.*.pending_explore=0;
        let rew:i32=1;if(obj!=true_reg){rew=-1;}
        if(r34v3_mod(ht_next(rng),100)<15){rew=-rew;}
        r34v3_accept(t,obj,rew,1,1);
        k=k+1;
    }
}
fn toy_measure(t:*R34V3State,true_reg:i32)i32 {
    let pos:i32=0;let k:i32=0;
    while(k<HT_PROBES){
        let was:i32=0;
        let obj:i32=r34v3_choose(t,0,&was);
        t.*.pending=1;t.*.pending_action=obj;t.*.pending_context=t.*.active;
        t.*.pending_object=obj;t.*.pending_explore=0;
        let rew:i32=1;if(obj!=true_reg){rew=-1;}
        r34v3_accept(t,obj,rew,0,0);
        if(obj==true_reg){pos=pos+1;}
        k=k+1;
    }
    return pos;
}
fn unit_refusals(err:*i32)void {
    let u:CtxStore=ctx_init();
    let a:i32=-1;let b:i32=-1;
    if(ctx_propose(&u,0,&a)!=CTX_OK){err.*=err.*+1;}
    if(ctx_propose(&u,1,&b)!=CTX_OK){err.*=err.*+1;}
    if(ctx_seed(&u,a)!=CTX_OK){err.*=err.*+1;}
    if(ctx_record(&u,b,2,16)!=CTX_OK){err.*=err.*+1;}
    if(ctx_record(&u,a,14,16)!=CTX_OK){err.*=err.*+1;}
    if(ctx_switch(&u,b)!=CTX_REFUSED_UNVERIFIED){err.*=err.*+1;}
    if(u.active!=a){err.*=err.*+1;}
    if(ctx_record(&u,b,14,16)!=CTX_OK){err.*=err.*+1;}
    if(ctx_switch(&u,b)!=CTX_REFUSED_UNVERIFIED){err.*=err.*+1;}
    if(u.active!=a){err.*=err.*+1;}
    if(ctx_record(&u,a,2,16)!=CTX_OK){err.*=err.*+1;}
    if(ctx_switch(&u,b)!=CTX_OK){err.*=err.*+1;}
    if(u.active!=b){err.*=err.*+1;}
    if(ctx_audit_clean_refusals(&u)!=CTX_OK){err.*=err.*+1;}
    if(ctx_replay_check(&u)!=CTX_OK){err.*=err.*+1;}
    if(ctx_switch_verified_scan(&u)!=CTX_OK){err.*=err.*+1;}
}

// ---- World, curriculum R (randomized; seeded RNG is harness scaffolding
// for the acceptance test — never part of the system). ----
fn w2r_passive(active_label:i32,true_reg:i32,rng:*i32)i32 {
    let agree:i32=0;let b:i32=0;
    while(b<HT2_PASSIVE_N){
        let a:i32=0;
        if(active_label==true_reg){a=1;}
        if(r34v3_mod(ht_next(rng),100)<15){a=1-a;}
        agree=agree+a;b=b+1;
    }
    return agree;
}
fn w2r_probe(slot_label:i32,true_reg:i32,rng:*i32)i32 {
    let hits:i32=0;let p:i32=0;
    while(p<HT_PROBES){
        let h:i32=0;
        if(slot_label==true_reg){h=1;}
        if(r34v3_mod(ht_next(rng),100)<15){h=1-h;}
        hits=hits+h;p=p+1;
    }
    return hits;
}

// ---- World, curriculum A (designed adversarial; ZERO randomness). ----
// Regime: 10 flips at e = {6,11,17,22,28,33,37,41,44,47}; starts 0.
fn w2a_regime(e:i32)i32 {
    let r:i32=0;
    if(e>=6){r=1;}if(e>=11){r=0;}if(e>=17){r=1;}if(e>=22){r=0;}
    if(e>=28){r=1;}if(e>=33){r=0;}if(e>=37){r=1;}if(e>=41){r=0;}
    if(e>=44){r=1;}if(e>=47){r=0;}
    return r;
}
// Honest defaults (deterministic, ~= the 15% rate): 7/8 passive agree on a
// correct hypothesis, 1/8 on a wrong one; 14/16 and 2/16 probe hits.
fn w2a_passive_honest(active_label:i32,true_reg:i32)i32 {
    if(active_label==true_reg){return 7;}
    return 1;
}
fn w2a_probe_honest(slot_label:i32,true_reg:i32)i32 {
    if(slot_label==true_reg){return 14;}
    return 2;
}
// Designed adversarial overrides, each with named intent (PREREG_HT2.md).
fn w2a_passive(e:i32,active_label:i32,true_reg:i32)i32 {
    if(e==3){return 6;}    // A1: isolated lies in steady regime
    if(e==30){return 6;}   // A1: isolated lies in steady regime
    if(e==15){return 3;}   // A2: pre-flip burst on the CORRECT hypothesis
    if(e==22){return 7;}   // A3: post-flip masking begins ("all is well" lies)
    if(e==23){return 7;}   // A3: masking
    if(e==24){return 7;}   // A3: masking
    if(e==38){return 3;}   // A4: forced contradiction on the CORRECT hypothesis
    return w2a_passive_honest(active_label,true_reg);
}
fn w2a_probe(e:i32,purpose:i32,slot_label:i32,true_reg:i32)i32 {
    if(e==38 && purpose==HT2P_VERIFY){return 4;}  // A4: forced noisy verification
    return w2a_probe_honest(slot_label,true_reg);
}

// ---- HT2 arm drivers: the learner decides; the world fulfills. ----
// Curriculum R (randomized channel).
fn ht2r_round(L:*HT2Learner,S:*CtxStore,true_reg:i32,rng_p:*i32,rng_b:*i32)void {
    let alabel:i32=ctx_i32_get(S.*.label,S.*.active*4);
    let agree:i32=w2r_passive(alabel,true_reg,rng_p);
    let ps:i32=-1;
    let act:i32=ht2_observe(L,S,agree,&ps);
    while(act==HT2A_PROBE){
        let slabel:i32=ctx_i32_get(S.*.label,ps*4);
        let hits:i32=w2r_probe(slabel,true_reg,rng_b);
        act=ht2_probe_result(L,S,ps,hits,&ps);
    }
}
// Curriculum A (designed channel).
fn ht2a_round(L:*HT2Learner,S:*CtxStore,e:i32)void {
    let true_reg:i32=w2a_regime(e);
    let alabel:i32=ctx_i32_get(S.*.label,S.*.active*4);
    let agree:i32=w2a_passive(e,alabel,true_reg);
    let ps:i32=-1;
    let act:i32=ht2_observe(L,S,agree,&ps);
    while(act==HT2A_PROBE){
        let slabel:i32=ctx_i32_get(S.*.label,ps*4);
        let hits:i32=w2a_probe(e,L.*.probe_purpose,slabel,true_reg);
        act=ht2_probe_result(L,S,ps,hits,&ps);
    }
}
// Curriculum A settle rounds (designed honest channel, explicit regime).
fn ht2a_settle_round(L:*HT2Learner,S:*CtxStore,true_reg:i32)void {
    let alabel:i32=ctx_i32_get(S.*.label,S.*.active*4);
    let agree:i32=w2a_passive_honest(alabel,true_reg);
    let ps:i32=-1;
    let act:i32=ht2_observe(L,S,agree,&ps);
    while(act==HT2A_PROBE){
        let slabel:i32=ctx_i32_get(S.*.label,ps*4);
        let hits:i32=w2a_probe_honest(slabel,true_reg);
        act=ht2_probe_result(L,S,ps,hits,&ps);
    }
}

// ---- HT2 learner unit tests (scratch stores; negative cases included). ----
// No contradiction -> no doubt, no probe. The trigger needs evidence.
fn unit_ht2_no_doubt(err:*i32)void {
    let s:CtxStore=ctx_init();let L:HT2Learner=ht2_init();
    let a:i32=-1;
    if(ctx_propose(&s,0,&a)!=CTX_OK){err.*=err.*+1;}
    if(ctx_seed(&s,a)!=CTX_OK){err.*=err.*+1;}
    let ps:i32=-1;
    if(ht2_observe(&L,&s,7,&ps)!=HT2A_NONE){err.*=err.*+1;}
    if(L.status!=HT2_COMMITTED){err.*=err.*+1;}
    if(L.n_doubt!=0){err.*=err.*+1;}
    if(ht2_observe(&L,&s,4,&ps)!=HT2A_NONE){err.*=err.*+1;}  // tie: not a contradiction
    if(L.n_doubt!=0){err.*=err.*+1;}
    if(ht2_causal_check(&L)!=0){err.*=err.*+1;}
}
// Contradiction -> doubt -> verification confirms -> explained, zero switches.
fn unit_ht2_explained(err:*i32)void {
    let s:CtxStore=ctx_init();let L:HT2Learner=ht2_init();
    let a:i32=-1;
    if(ctx_propose(&s,0,&a)!=CTX_OK){err.*=err.*+1;}
    if(ctx_seed(&s,a)!=CTX_OK){err.*=err.*+1;}
    let ps:i32=-1;
    if(ht2_observe(&L,&s,2,&ps)!=HT2A_PROBE){err.*=err.*+1;}
    if(ps!=a){err.*=err.*+1;}
    if(L.probe_purpose!=HT2P_VERIFY){err.*=err.*+1;}
    if(ht2_probe_result(&L,&s,ps,14,&ps)!=HT2A_DONE){err.*=err.*+1;}
    if(L.status!=HT2_COMMITTED){err.*=err.*+1;}
    if(L.n_explained!=1){err.*=err.*+1;}
    if(ctx_count_op_rc(&s,CTX_OP_SWITCH,CTX_OK)!=0){err.*=err.*+1;}
    if(ht2_causal_check(&L)!=0){err.*=err.*+1;}
}
// Contradiction -> falsified -> alternative verifies -> switch commits.
fn unit_ht2_falsify_switch(err:*i32)void {
    let s:CtxStore=ctx_init();let L:HT2Learner=ht2_init();
    let a:i32=-1;let b:i32=-1;
    if(ctx_propose(&s,0,&a)!=CTX_OK){err.*=err.*+1;}
    if(ctx_propose(&s,1,&b)!=CTX_OK){err.*=err.*+1;}
    if(ctx_seed(&s,a)!=CTX_OK){err.*=err.*+1;}
    let ps:i32=-1;
    if(ht2_observe(&L,&s,1,&ps)!=HT2A_PROBE){err.*=err.*+1;}
    let act:i32=ht2_probe_result(&L,&s,ps,2,&ps);
    if(act!=HT2A_PROBE){err.*=err.*+1;}
    if(L.probe_purpose!=HT2P_TEST_ALT){err.*=err.*+1;}
    if(ps!=b){err.*=err.*+1;}
    if(ht2_probe_result(&L,&s,ps,14,&ps)!=HT2A_DONE){err.*=err.*+1;}
    if(s.active!=b){err.*=err.*+1;}
    if(L.n_switches!=1){err.*=err.*+1;}
    if(L.n_falsified!=1){err.*=err.*+1;}
    if(ht2_causal_check(&L)!=0){err.*=err.*+1;}
    if(ctx_switch_verified_scan(&s)!=CTX_OK){err.*=err.*+1;}
}
// No live alternative -> educated guess (novel label), tested, switch commits.
fn unit_ht2_guess(err:*i32)void {
    let s:CtxStore=ctx_init();let L:HT2Learner=ht2_init();
    let a:i32=-1;
    if(ctx_propose(&s,0,&a)!=CTX_OK){err.*=err.*+1;}
    if(ctx_seed(&s,a)!=CTX_OK){err.*=err.*+1;}
    let ps:i32=-1;
    if(ht2_observe(&L,&s,1,&ps)!=HT2A_PROBE){err.*=err.*+1;}
    let act:i32=ht2_probe_result(&L,&s,ps,3,&ps);
    if(act!=HT2A_PROBE){err.*=err.*+1;}
    if(L.probe_purpose!=HT2P_GUESS){err.*=err.*+1;}
    if(ctx_i32_get(s.label,ps*4)!=1){err.*=err.*+1;}  // smallest non-live label
    if(ht2_probe_result(&L,&s,ps,14,&ps)!=HT2A_DONE){err.*=err.*+1;}
    if(ctx_i32_get(s.label,s.active*4)!=1){err.*=err.*+1;}
    if(L.n_guesses!=1){err.*=err.*+1;}
    if(L.n_switches!=1){err.*=err.*+1;}
    if(ht2_causal_check(&L)!=0){err.*=err.*+1;}
}
// False falsification -> alternative fails -> guess fails -> overturn, zero switches.
fn unit_ht2_overturn(err:*i32)void {
    let s:CtxStore=ctx_init();let L:HT2Learner=ht2_init();
    let a:i32=-1;let b:i32=-1;
    if(ctx_propose(&s,0,&a)!=CTX_OK){err.*=err.*+1;}
    if(ctx_propose(&s,1,&b)!=CTX_OK){err.*=err.*+1;}
    if(ctx_seed(&s,a)!=CTX_OK){err.*=err.*+1;}
    let ps:i32=-1;
    if(ht2_observe(&L,&s,2,&ps)!=HT2A_PROBE){err.*=err.*+1;}
    let act:i32=ht2_probe_result(&L,&s,ps,4,&ps);  // forced noisy verification
    if(act!=HT2A_PROBE || L.probe_purpose!=HT2P_TEST_ALT){err.*=err.*+1;}
    act=ht2_probe_result(&L,&s,ps,2,&ps);          // alternative honestly fails
    if(act!=HT2A_PROBE || L.probe_purpose!=HT2P_GUESS){err.*=err.*+1;}
    act=ht2_probe_result(&L,&s,ps,3,&ps);           // guess honestly fails -> overturn
    if(act!=HT2A_PROBE || L.probe_purpose!=HT2P_OVERTURN){err.*=err.*+1;}
    if(ps!=a){err.*=err.*+1;}
    if(ht2_probe_result(&L,&s,ps,14,&ps)!=HT2A_DONE){err.*=err.*+1;}
    if(L.status!=HT2_COMMITTED){err.*=err.*+1;}
    if(L.n_overturned!=1){err.*=err.*+1;}
    if(ctx_count_op_rc(&s,CTX_OP_SWITCH,CTX_OK)!=0){err.*=err.*+1;}
    if(s.active!=a){err.*=err.*+1;}
    if(ht2_causal_check(&L)!=0){err.*=err.*+1;}
}
// Everything fails incl. the overturn re-test -> BACKOFF, then fresh
// contradiction re-triggers (liveness is world-driven; the learner never spins alone).
fn unit_ht2_backoff(err:*i32)void {
    let s:CtxStore=ctx_init();let L:HT2Learner=ht2_init();
    let a:i32=-1;
    if(ctx_propose(&s,0,&a)!=CTX_OK){err.*=err.*+1;}
    if(ctx_seed(&s,a)!=CTX_OK){err.*=err.*+1;}
    let ps:i32=-1;
    if(ht2_observe(&L,&s,1,&ps)!=HT2A_PROBE){err.*=err.*+1;}
    let act:i32=ht2_probe_result(&L,&s,ps,2,&ps);
    if(act!=HT2A_PROBE || L.probe_purpose!=HT2P_GUESS){err.*=err.*+1;}
    act=ht2_probe_result(&L,&s,ps,2,&ps);
    if(act!=HT2A_PROBE || L.probe_purpose!=HT2P_OVERTURN){err.*=err.*+1;}
    if(ht2_probe_result(&L,&s,ps,2,&ps)!=HT2A_DONE){err.*=err.*+1;}
    if(L.status!=HT2_BACKOFF){err.*=err.*+1;}
    if(ctx_count_op_rc(&s,CTX_OP_SWITCH,CTX_OK)!=0){err.*=err.*+1;}
    if(ht2_observe(&L,&s,1,&ps)!=HT2A_PROBE){err.*=err.*+1;}  // re-trigger from backoff
    if(L.status!=HT2_INVESTIGATING){err.*=err.*+1;}
    if(L.n_doubt!=2){err.*=err.*+1;}
    if(ht2_probe_result(&L,&s,ps,14,&ps)!=HT2A_DONE){err.*=err.*+1;}  // explained
    if(L.n_explained!=1){err.*=err.*+1;}
    if(ht2_causal_check(&L)!=0){err.*=err.*+1;}
}
// Negative: the causal check must FAIL on forged ledgers —
// (1) DOUBT with no recorded contradiction, (2) SWITCH with no falsification.
fn unit_ht2_causal_negative(err:*i32)void {
    let L1:HT2Learner=ht2_init();
    ht2_log(&L1,HT2D_OBSERVE,HT2R_NONE,7,0);
    ht2_log(&L1,HT2D_DOUBT,HT2R_PASSIVE_CONTRADICTION,7,0);
    if(ht2_causal_check(&L1)==0){err.*=err.*+1;}
    let L2:HT2Learner=ht2_init();
    ht2_log(&L2,HT2D_OBSERVE,HT2R_NONE,2,0);
    ht2_log(&L2,HT2D_DOUBT,HT2R_PASSIVE_CONTRADICTION,2,0);
    ht2_log(&L2,HT2D_VERIFY,HT2R_NONE,14,0);
    ht2_log(&L2,HT2D_EXPLAINED,HT2R_VERIFY_CONFIRMED,14,0);
    ht2_log(&L2,HT2D_SWITCH,HT2R_ALT_VERIFIED,CTX_OK,1);
    if(ht2_causal_check(&L2)==0){err.*=err.*+1;}
    nio_free(L1.ledger);nio_free(L2.ledger);
}

fn main()i32 {
    let f:i32=0;
    let uerr:i32=0;
    unit_refusals(&uerr);
    f=f+cl_check("unit_refusals",uerr,0);
    uerr=0;unit_ht2_no_doubt(&uerr);
    f=f+cl_check("unit_ht2_no_doubt",uerr,0);
    uerr=0;unit_ht2_explained(&uerr);
    f=f+cl_check("unit_ht2_explained",uerr,0);
    uerr=0;unit_ht2_falsify_switch(&uerr);
    f=f+cl_check("unit_ht2_falsify_switch",uerr,0);
    uerr=0;unit_ht2_guess(&uerr);
    f=f+cl_check("unit_ht2_guess",uerr,0);
    uerr=0;unit_ht2_overturn(&uerr);
    f=f+cl_check("unit_ht2_overturn",uerr,0);
    uerr=0;unit_ht2_backoff(&uerr);
    f=f+cl_check("unit_ht2_backoff",uerr,0);
    uerr=0;unit_ht2_causal_negative(&uerr);
    f=f+cl_check("unit_ht2_causal_negative",uerr,0);

    // ---- curriculum R: shared flip sequence, identical to HT1's run ----
    let reg:[]u8=nio_alloc(HT_EPS);
    let rng_flip:i32=91001;
    let r:i32=0;let e:i32=0;
    while(e<HT_EPS){
        if(e>0 && r34v3_mod(ht_next(&rng_flip),6)==0){r=1-r;}
        reg[e]=r as u8;e=e+1;
    }
    let true_flips:i32=0;e=1;
    while(e<HT_EPS){if(reg[e]!=reg[e-1]){true_flips=true_flips+1;}e=e+1;}

    // ---- HT2 arm (learner-driven trigger) ----
    let h2s:CtxStore=ctx_init();
    let h2l:HT2Learner=ht2_init();
    let hs0:i32=-1;let herr:i32=0;
    if(ctx_propose(&h2s,0,&hs0)!=CTX_OK){herr=herr+1;}
    if(ctx_seed(&h2s,hs0)!=CTX_OK){herr=herr+1;}
    let rng_hp:i32=94004;let rng_hb:i32=95005;
    let h2_collapsed:i32=0;let mb:i32=0;
    let h2_block_pos:[]u8=nio_alloc(6);
    e=0;
    while(e<HT_EPS){
        ht2r_round(&h2l,&h2s,reg[e] as i32,&rng_hp,&rng_hb);
        if(r34v3_mod(e+1,8)==0){
            let pos:i32=ctx_measure(&h2s,reg[e] as i32);
            h2_block_pos[mb]=pos as u8;mb=mb+1;
            if(pos<=4){h2_collapsed=h2_collapsed+1;}
        }
        e=e+1;
    }
    e=0;while(e<8){ht2r_round(&h2l,&h2s,0,&rng_hp,&rng_hb);e=e+1;}
    let h2_end0:i32=ctx_measure(&h2s,0);
    e=0;while(e<8){ht2r_round(&h2l,&h2s,1,&rng_hp,&rng_hb);e=e+1;}
    let h2_end1:i32=ctx_measure(&h2s,1);
    let h2_switches:i32=ctx_count_op_rc(&h2s,CTX_OP_SWITCH,CTX_OK);
    let h2_seen0:i32=0;let h2_seen1:i32=0;let t2:i32=0;
    while(t2<CTX_CAP){
        if(h2s.live[t2]==1){
            if(ctx_i32_get(h2s.label,t2*4)==0){h2_seen0=1;}else{h2_seen1=1;}
        }
        t2=t2+1;
    }

    // ---- HT1R arm (protocol-fixed policy, fidelity control) ----
    let cs:CtxStore=ctx_init();
    let s0:i32=-1;let err:i32=0;
    if(ctx_propose(&cs,0,&s0)!=CTX_OK){err=err+1;}
    if(ctx_seed(&cs,s0)!=CTX_OK){err=err+1;}
    let rng_ht1r:i32=92002;
    let h1_collapsed:i32=0;mb=0;
    let h1_block_pos:[]u8=nio_alloc(6);
    e=0;
    while(e<HT_EPS){
        ctx_episode(&cs,reg[e] as i32,&rng_ht1r,&err);
        if(r34v3_mod(e+1,8)==0){
            let pos:i32=ctx_measure(&cs,reg[e] as i32);
            h1_block_pos[mb]=pos as u8;mb=mb+1;
            if(pos<=4){h1_collapsed=h1_collapsed+1;}
        }
        e=e+1;
    }
    e=0;while(e<8){ctx_episode(&cs,0,&rng_ht1r,&err);e=e+1;}
    let h1_end0:i32=ctx_measure(&cs,0);
    e=0;while(e<8){ctx_episode(&cs,1,&rng_ht1r,&err);e=e+1;}
    let h1_end1:i32=ctx_measure(&cs,1);
    let h1_switches:i32=ctx_count_op_rc(&cs,CTX_OP_SWITCH,CTX_OK);

    // ---- toy arm (R34 v3 core, unmodified; expected-negative control) ----
    let toy:R34V3State=r34v3_init(5555);
    let rng_toy:i32=93003;
    let toy_collapsed:i32=0;mb=0;
    let toy_block_pos:[]u8=nio_alloc(6);
    e=0;
    while(e<HT_EPS){
        toy_train_episode(&toy,reg[e] as i32,&rng_toy);
        if(r34v3_mod(e+1,8)==0){
            let pos:i32=toy_measure(&toy,reg[e] as i32);
            toy_block_pos[mb]=pos as u8;mb=mb+1;
            if(pos<=4){toy_collapsed=toy_collapsed+1;}
        }
        e=e+1;
    }
    e=0;while(e<8){toy_train_episode(&toy,0,&rng_toy);e=e+1;}
    let toy_end0:i32=toy_measure(&toy,0);
    e=0;while(e<8){toy_train_episode(&toy,1,&rng_toy);e=e+1;}
    let toy_end1:i32=toy_measure(&toy,1);

    // ---- report R ----
    _zag_print("HT2R_TRUE_FLIPS,");cl_number(true_flips as i64);_zag_println("");
    _zag_print("HT2R_HT2_SWITCHES,");cl_number(h2_switches as i64);_zag_println("");
    _zag_print("HT2R_HT2_COLLAPSED,");cl_number(h2_collapsed as i64);_zag_println("");
    _zag_print("HT2R_HT2_END_R0,");cl_number(h2_end0 as i64);_zag_println("");
    _zag_print("HT2R_HT2_END_R1,");cl_number(h2_end1 as i64);_zag_println("");
    _zag_print("HT2R_HT2_DOUBT,");cl_number(h2l.n_doubt as i64);_zag_println("");
    _zag_print("HT2R_HT2_EXPLAINED,");cl_number(h2l.n_explained as i64);_zag_println("");
    _zag_print("HT2R_HT2_FALSIFIED,");cl_number(h2l.n_falsified as i64);_zag_println("");
    _zag_print("HT2R_HT2_OVERTURNED,");cl_number(h2l.n_overturned as i64);_zag_println("");
    _zag_print("HT2R_HT2_GUESSES,");cl_number(h2l.n_guesses as i64);_zag_println("");
    _zag_print("HT2R_HT2_BLOCKS,");
    mb=0;while(mb<6){cl_number(h2_block_pos[mb] as i64);_zag_print(",");mb=mb+1;}_zag_println("");
    _zag_print("HT2R_HT1R_SWITCHES,");cl_number(h1_switches as i64);_zag_println("");
    _zag_print("HT2R_HT1R_COLLAPSED,");cl_number(h1_collapsed as i64);_zag_println("");
    _zag_print("HT2R_HT1R_END_R0,");cl_number(h1_end0 as i64);_zag_println("");
    _zag_print("HT2R_HT1R_END_R1,");cl_number(h1_end1 as i64);_zag_println("");
    _zag_print("HT2R_HT1R_BLOCKS,");
    mb=0;while(mb<6){cl_number(h1_block_pos[mb] as i64);_zag_print(",");mb=mb+1;}_zag_println("");
    _zag_print("HT2R_TOY_SWITCHES,");cl_number(toy.switches as i64);_zag_println("");
    _zag_print("HT2R_TOY_COLLAPSED,");cl_number(toy_collapsed as i64);_zag_println("");
    _zag_print("HT2R_TOY_END_R0,");cl_number(toy_end0 as i64);_zag_println("");
    _zag_print("HT2R_TOY_END_R1,");cl_number(toy_end1 as i64);_zag_println("");
    _zag_print("HT2R_TOY_BLOCKS,");
    mb=0;while(mb<6){cl_number(toy_block_pos[mb] as i64);_zag_print(",");mb=mb+1;}_zag_println("");

    // ---- pass criteria, curriculum R ----
    f=f+cl_check("r_no_collapse",h2_collapsed,0);
    f=f+cl_check("r_switches_bounded",(h2_switches<=2*true_flips) as i32,1);
    f=f+cl_check("r_end_r0",(h2_end0>=12) as i32,1);
    f=f+cl_check("r_end_r1",(h2_end1>=12) as i32,1);
    f=f+cl_check("r_audit_clean",ctx_audit_clean_refusals(&h2s),CTX_OK);
    f=f+cl_check("r_replay",ctx_replay_check(&h2s),CTX_OK);
    f=f+cl_check("r_switch_verified",ctx_switch_verified_scan(&h2s),CTX_OK);
    f=f+cl_check("r_two_partitions",(h2_seen0==1 && h2_seen1==1) as i32,1);
    f=f+cl_check("r_causal",ht2_causal_check(&h2l),0);
    f=f+cl_check("r_episode_ops_clean",herr,0);
    // HT1R fidelity: must reproduce HT1's reported CTX numbers exactly.
    f=f+cl_check("r_ht1r_fidelity",(h1_switches==11 && h1_collapsed==0 &&
        h1_end0==16 && h1_end1==16) as i32,1);
    // Toy control: the curriculum must stress the table.
    let toy_strong:i32=(toy_collapsed==0 && toy.switches<=2*true_flips &&
        toy_end0>=12 && toy_end1>=12) as i32;
    f=f+cl_check("r_curriculum_stresses_toy",toy_strong,0);

    // ---- curriculum A: HT2 on the designed adversarial sequence ----
    let as:CtxStore=ctx_init();
    let al:HT2Learner=ht2_init();
    let as0:i32=-1;let aerr:i32=0;
    if(ctx_propose(&as,0,&as0)!=CTX_OK){aerr=aerr+1;}
    if(ctx_seed(&as,as0)!=CTX_OK){aerr=aerr+1;}
    let a_collapsed:i32=0;mb=0;
    let a_block_pos:[]u8=nio_alloc(6);
    let a_doubt_ep:[]u8=nio_alloc(HT_EPS);
    let a_sw_ep:[]u8=nio_alloc(HT_EPS);
    e=0;
    while(e<HT_EPS){
        let d0:i32=al.n_doubt;
        let s0a:i32=ctx_count_op_rc(&as,CTX_OP_SWITCH,CTX_OK);
        ht2a_round(&al,&as,e);
        a_doubt_ep[e]=(al.n_doubt-d0) as u8;
        a_sw_ep[e]=(ctx_count_op_rc(&as,CTX_OP_SWITCH,CTX_OK)-s0a) as u8;
        if(r34v3_mod(e+1,8)==0){
            let pos:i32=ctx_measure(&as,w2a_regime(e));
            a_block_pos[mb]=pos as u8;mb=mb+1;
            if(pos<=4){a_collapsed=a_collapsed+1;}
        }
        e=e+1;
    }
    e=0;while(e<8){ht2a_settle_round(&al,&as,0);e=e+1;}
    let a_end0:i32=ctx_measure(&as,0);
    e=0;while(e<8){ht2a_settle_round(&al,&as,1);e=e+1;}
    let a_end1:i32=ctx_measure(&as,1);
    let a_switches:i32=ctx_count_op_rc(&as,CTX_OP_SWITCH,CTX_OK);

    // ---- report A ----
    _zag_print("HT2A_SWITCHES,");cl_number(a_switches as i64);_zag_println("");
    _zag_print("HT2A_COLLAPSED,");cl_number(a_collapsed as i64);_zag_println("");
    _zag_print("HT2A_END_R0,");cl_number(a_end0 as i64);_zag_println("");
    _zag_print("HT2A_END_R1,");cl_number(a_end1 as i64);_zag_println("");
    _zag_print("HT2A_DOUBT,");cl_number(al.n_doubt as i64);_zag_println("");
    _zag_print("HT2A_EXPLAINED,");cl_number(al.n_explained as i64);_zag_println("");
    _zag_print("HT2A_FALSIFIED,");cl_number(al.n_falsified as i64);_zag_println("");
    _zag_print("HT2A_OVERTURNED,");cl_number(al.n_overturned as i64);_zag_println("");
    _zag_print("HT2A_GUESSES,");cl_number(al.n_guesses as i64);_zag_println("");
    _zag_print("HT2A_BLOCKS,");
    mb=0;while(mb<6){cl_number(a_block_pos[mb] as i64);_zag_print(",");mb=mb+1;}_zag_println("");
    _zag_print("HT2A_DOUBT_EPS,");
    e=0;while(e<HT_EPS){if(a_doubt_ep[e]!=0){cl_number(e as i64);_zag_print(",");}e=e+1;}_zag_println("");
    _zag_print("HT2A_SWITCH_EPS,");
    e=0;while(e<HT_EPS){if(a_sw_ep[e]!=0){cl_number(e as i64);_zag_print(",");}e=e+1;}_zag_println("");

    // ---- pass criteria, curriculum A (preregistered expectations) ----
    let a_rphase_sw:i32=0;
    e=0;while(e<HT_EPS){a_rphase_sw=a_rphase_sw+(a_sw_ep[e] as i32);e=e+1;}
    let a3rec:i32=(a_sw_ep[25]+a_sw_ep[26]) as i32;
    f=f+cl_check("a_a1_clean",(a_doubt_ep[3]+a_doubt_ep[30]+a_sw_ep[3]+a_sw_ep[30]) as i32,0);
    f=f+cl_check("a_a2",((a_doubt_ep[15] as i32)==1 && (a_sw_ep[15] as i32)==0 &&
        (a_sw_ep[17] as i32)==1) as i32,1);
    f=f+cl_check("a_a3",(((a_sw_ep[22]+a_sw_ep[23]+a_sw_ep[24]) as i32)==0 &&
        a3rec==1) as i32,1);
    f=f+cl_check("a_a4",(((a_doubt_ep[38] as i32)==1) &&
        ((a_sw_ep[38] as i32)==0)) as i32,1);
    f=f+cl_check("a_rphase_switches",a_rphase_sw,10);
    f=f+cl_check("a_doubts",al.n_doubt,13);
    f=f+cl_check("a_switches",a_switches,11);
    f=f+cl_check("a_explained",al.n_explained,1);
    f=f+cl_check("a_overturned",al.n_overturned,1);
    f=f+cl_check("a_collapsed_designed",a_collapsed,1);
    f=f+cl_check("a_block24_collapsed",(a_block_pos[2]<=4) as i32,1);
    f=f+cl_check("a_end_r0",a_end0,16);
    f=f+cl_check("a_end_r1",a_end1,16);
    f=f+cl_check("a_audit_clean",ctx_audit_clean_refusals(&as),CTX_OK);
    f=f+cl_check("a_replay",ctx_replay_check(&as),CTX_OK);
    f=f+cl_check("a_switch_verified",ctx_switch_verified_scan(&as),CTX_OK);
    f=f+cl_check("a_causal",ht2_causal_check(&al),0);
    f=f+cl_check("a_episode_ops_clean",aerr,0);

    _zag_print("HT2_FAILURES,");cl_number(f as i64);_zag_println("");
    _zag_print("HT2_DONE");_zag_println("");
    nio_free(reg);nio_free(h2_block_pos);nio_free(h1_block_pos);
    nio_free(toy_block_pos);nio_free(a_block_pos);
    nio_free(a_doubt_ep);nio_free(a_sw_ep);
    return (f!=0) as i32;
}

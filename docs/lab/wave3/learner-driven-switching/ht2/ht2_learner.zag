// ht2_learner.zag — the EDUCATED-GUESS learner (HT2).
//
// Decides WHEN to probe and WHEN to switch on evidence and hypothesis.
// Fully deterministic in the decision path: no timers, no schedules, no
// reward, no stochasticity. The decision functions
// take (hypothesis state, recorded evidence) only. Static checks in
// run_ht2.sh verify this file contains no stochastic source and no time
// source. The switching MECHANISM is ctx_core.zag, unchanged from HT1 —
// the mechanism is proven; the TRIGGER is what is under test.
//
// The trigger shape: the learner holds an explicit hypothesis H about the
// active partition ("this partition explains current observations"). A
// recorded contradiction of H's prediction raises DOUBT (an epistemic
// state, not an action). Doubt is escalated to FALSIFICATION only by a
// deliberately issued verification probe that independently contradicts H.
// A falsified H licenses testing alternatives / proposing one novel guess;
// a switch is proposed as a deliberate op subject to HT1's intrinsic
// corroboration. A contradiction that verification explains as noise
// produces zero switches: doubt withheld, by decision.
@import("ctx_core.zag")

// Hypothesis statuses.
const HT2_COMMITTED:i32=0;
const HT2_INVESTIGATING:i32=1;
const HT2_BACKOFF:i32=2;

// Learner actions returned to the driver (the world fulfills probes).
const HT2A_NONE:i32=0;
const HT2A_PROBE:i32=1;   // issue a probe on *pslot; purpose in L.probe_purpose
const HT2A_DONE:i32=2;    // the doubt round resolved (committed or backed off)

// Probe purposes (learner-internal).
const HT2P_VERIFY:i32=1;
const HT2P_TEST_ALT:i32=2;
const HT2P_GUESS:i32=3;
const HT2P_OVERTURN:i32=4;

// Decision-ledger ops.
const HT2D_OBSERVE:i32=11;
const HT2D_DOUBT:i32=12;
const HT2D_VERIFY:i32=13;
const HT2D_EXPLAINED:i32=14;
const HT2D_FALSIFIED:i32=15;
const HT2D_TEST_ALT:i32=16;
const HT2D_GUESS:i32=17;
const HT2D_SWITCH:i32=18;
const HT2D_OVERTURN:i32=19;
const HT2D_BACKOFF:i32=20;

// Reasons (why the learner acted — the white-box record).
const HT2R_NONE:i32=0;
const HT2R_PASSIVE_CONTRADICTION:i32=1;
const HT2R_VERIFY_CONFIRMED:i32=2;
const HT2R_VERIFY_CONTRADICTED:i32=3;
const HT2R_INCONCLUSIVE:i32=4;
const HT2R_ALT_VERIFIED:i32=5;
const HT2R_GUESS_VERIFIED:i32=6;
const HT2R_ALL_FAILED:i32=7;

const HT2_PASSIVE_N:i32=8;
const HT2_LEDGER_CAP:i32=256;
const HT2_LEDGER_WORDS:i32=5;  // op, reason, e1, e2, seq

struct HT2Learner {
    status:i32,
    falsified:i32,
    probe_purpose:i32,
    test_cursor:i32,
    guess_next:i32,
    guesses_failed:i32,
    orig_active:i32,
    verify_ties:i32,
    ledger:[]u8,
    ledger_n:i32,
    n_doubt:i32,
    n_explained:i32,
    n_falsified:i32,
    n_switches:i32,
    n_overturned:i32,
    n_guesses:i32
}

fn ht2_init()HT2Learner {
    let ledger:[]u8=nio_alloc(HT2_LEDGER_CAP*HT2_LEDGER_WORDS*4);
    return HT2Learner{.status=HT2_COMMITTED,.falsified=0,.probe_purpose=0,
        .test_cursor=0,.guess_next=0,.guesses_failed=0,
        .orig_active=-1,.verify_ties=0,
        .ledger=ledger,.ledger_n=0,
        .n_doubt=0,.n_explained=0,.n_falsified=0,
        .n_switches=0,.n_overturned=0,.n_guesses=0};
}

fn ht2_log(L:*HT2Learner,op:i32,reason:i32,e1:i32,e2:i32)void {
    if(L==null as *HT2Learner){return;}
    if(L.*.ledger_n>=HT2_LEDGER_CAP){return;}
    let e:i32=L.*.ledger_n*HT2_LEDGER_WORDS*4;
    ctx_i32_set(L.*.ledger,e+0,op);ctx_i32_set(L.*.ledger,e+4,reason);
    ctx_i32_set(L.*.ledger,e+8,e1);ctx_i32_set(L.*.ledger,e+12,e2);
    ctx_i32_set(L.*.ledger,e+16,L.*.ledger_n);
    L.*.ledger_n=L.*.ledger_n+1;
}

fn ht2_smallest_nonlive(S:*CtxStore)i32 {
    let i:i32=0;
    while(i<CTX_CAP){if(S.*.live[i]==0){return i;}i=i+1;}
    return -1;
}

// After falsification: test live alternatives in deterministic slot order,
// then one novel guess, then re-examine the falsification (overturn).
fn ht2_guess_or_overturn(L:*HT2Learner,S:*CtxStore,pslot:*i32)i32 {
    // One novel guess per doubt round: the smallest non-live label is the
    // next unfalsified candidate. If it fails its test, the rational move
    // is to re-examine the falsification, not to guess blindly onward.
    if(L.*.guesses_failed<1){
        let g:i32=ht2_smallest_nonlive(S);
        if(g>=0){
            let ns:i32=-1;
            if(ctx_propose(S,g,&ns)==CTX_OK){
                L.*.probe_purpose=HT2P_GUESS;pslot.*=ns;return HT2A_PROBE;
            }
        }
    }
    // Overturn: a fresh, deliberate re-verification of the original
    // hypothesis. Falsification is defeasible, not a latch.
    L.*.probe_purpose=HT2P_OVERTURN;pslot.*=L.*.orig_active;
    return HT2A_PROBE;
}

fn ht2_next_test(L:*HT2Learner,S:*CtxStore,pslot:*i32)i32 {
    while(L.*.test_cursor<CTX_CAP){
        let q:i32=L.*.test_cursor;L.*.test_cursor=L.*.test_cursor+1;
        if(q!=S.*.active && S.*.live[q]==1){
            L.*.probe_purpose=HT2P_TEST_ALT;pslot.*=q;return HT2A_PROBE;
        }
    }
    return ht2_guess_or_overturn(L,S,pslot);
}

// One round of perception. agree = passive agree-count (0..8) for this
// round, taken from the world's presentation and recorded. Returns
// HT2A_PROBE (with *pslot set) iff a recorded contradiction raises doubt.
fn ht2_observe(L:*HT2Learner,S:*CtxStore,agree:i32,pslot:*i32)i32 {
    if(L==null as *HT2Learner || S==null as *CtxStore || pslot==null as *i32){return HT2A_NONE;}
    ht2_log(L,HT2D_OBSERVE,HT2R_NONE,agree,0);
    if(L.*.status==HT2_INVESTIGATING){return HT2A_NONE;}
    if(agree<0 || agree>HT2_PASSIVE_N){return HT2A_NONE;}
    // Majority-disagree in the recorded round contradicts H's prediction
    // ("this partition explains current observations"). A tie does not
    // contradict; neither does majority-agree.
    if(agree*2>=HT2_PASSIVE_N){return HT2A_NONE;}
    // Doubt is an epistemic state, not an action: the learner withholds
    // commitment and issues a deliberate verification probe as a TEST of H.
    L.*.status=HT2_INVESTIGATING;L.*.falsified=0;L.*.test_cursor=0;
    L.*.guess_next=ht2_smallest_nonlive(S);L.*.guesses_failed=0;
    L.*.orig_active=S.*.active;L.*.verify_ties=0;
    L.*.probe_purpose=HT2P_VERIFY;
    ht2_log(L,HT2D_DOUBT,HT2R_PASSIVE_CONTRADICTION,agree,S.*.active);
    L.*.n_doubt=L.*.n_doubt+1;
    pslot.*=S.*.active;
    return HT2A_PROBE;
}

// The world has fulfilled a learner-issued probe on slot with a 16-batch
// scoring hits. The learner deliberately records it, then advances its
// investigation by the probe's purpose. May CTX_SWITCH (deliberate op).
fn ht2_probe_result(L:*HT2Learner,S:*CtxStore,slot:i32,hits:i32,pslot:*i32)i32 {
    if(L==null as *HT2Learner || S==null as *CtxStore || pslot==null as *i32){return HT2A_NONE;}
    if(L.*.status!=HT2_INVESTIGATING){return HT2A_NONE;}
    if(slot<0 || slot>=CTX_CAP || S.*.live[slot]==0){return HT2A_NONE;}
    if(hits<0 || hits>16){return HT2A_NONE;}
    // Deliberate recording of the probe batch: observations, never accumulated.
    if(ctx_record(S,slot,hits,16)!=CTX_OK){return HT2A_NONE;}
    let purpose:i32=L.*.probe_purpose;
    if(purpose==HT2P_VERIFY){
        ht2_log(L,HT2D_VERIFY,HT2R_NONE,hits,slot);
        if(ctx_maj_pos(hits,16)==1){
            // The test confirms H: the contradiction is explained as noise.
            // The learner stands by its hypothesis — doubt withheld, nothing switches.
            ht2_log(L,HT2D_EXPLAINED,HT2R_VERIFY_CONFIRMED,hits,slot);
            L.*.status=HT2_COMMITTED;L.*.n_explained=L.*.n_explained+1;
            return HT2A_DONE;
        }
        if(ctx_maj_neg(hits,16)==1){
            // Two independent contradictions: H is falsified.
            ht2_log(L,HT2D_FALSIFIED,HT2R_VERIFY_CONTRADICTED,hits,slot);
            L.*.falsified=1;L.*.n_falsified=L.*.n_falsified+1;
            return ht2_next_test(L,S,pslot);
        }
        // Tie: the test was inconclusive. Re-test once; a second tie is
        // treated as explained (withhold falsification on inconclusive evidence).
        L.*.verify_ties=L.*.verify_ties+1;
        if(L.*.verify_ties>=2){
            ht2_log(L,HT2D_EXPLAINED,HT2R_INCONCLUSIVE,hits,slot);
            L.*.status=HT2_COMMITTED;L.*.n_explained=L.*.n_explained+1;
            return HT2A_DONE;
        }
        L.*.probe_purpose=HT2P_VERIFY;pslot.*=slot;
        return HT2A_PROBE;
    }
    if(purpose==HT2P_TEST_ALT){
        ht2_log(L,HT2D_TEST_ALT,HT2R_NONE,hits|(16<<8),slot);
        if(ctx_maj_pos(hits,16)==1){
            let rc:i32=ctx_switch(S,slot);
            ht2_log(L,HT2D_SWITCH,HT2R_ALT_VERIFIED,rc,slot);
            if(rc==CTX_OK){
                L.*.status=HT2_COMMITTED;L.*.n_switches=L.*.n_switches+1;
                return HT2A_DONE;
            }
        }
        return ht2_next_test(L,S,pslot);
    }
    if(purpose==HT2P_GUESS){
        L.*.n_guesses=L.*.n_guesses+1;
        ht2_log(L,HT2D_GUESS,HT2R_NONE,hits|(16<<8),slot);
        if(ctx_maj_pos(hits,16)==1){
            let rc:i32=ctx_switch(S,slot);
            ht2_log(L,HT2D_SWITCH,HT2R_GUESS_VERIFIED,rc,slot);
            if(rc==CTX_OK){
                L.*.status=HT2_COMMITTED;L.*.n_switches=L.*.n_switches+1;
                return HT2A_DONE;
            }
        }
        // The guess is falsified by its own test: it never commits.
        L.*.guesses_failed=L.*.guesses_failed+1;
        return ht2_guess_or_overturn(L,S,pslot);
    }
    if(purpose==HT2P_OVERTURN){
        if(ctx_maj_pos(hits,16)==1){
            // The falsification is overturned: the verification batch was the outlier.
            ht2_log(L,HT2D_OVERTURN,HT2R_VERIFY_CONFIRMED,hits,slot);
            L.*.status=HT2_COMMITTED;L.*.n_overturned=L.*.n_overturned+1;
            return HT2A_DONE;
        }
        ht2_log(L,HT2D_BACKOFF,HT2R_ALL_FAILED,hits,slot);
        L.*.status=HT2_BACKOFF;
        return HT2A_DONE;
    }
    return HT2A_NONE;
}

// White-box proof that the learner is evidence-driven, not schedule-driven:
// replays the decision ledger and asserts the full causal chain — every
// DOUBT carries a recorded contradiction, every FALSIFIED follows a
// contradicting verification, every TEST_ALT/GUESS follows an unresolved
// falsification, every SWITCH follows a falsification AND a verified test
// of its target. A schedule-driven action would appear as a ledger entry
// with no evidential predecessor. Also re-derives the counters (replay).
// Returns 0 iff the chain holds.
fn ht2_causal_check(L:*HT2Learner)i32 {
    if(L==null as *HT2Learner){return 1;}
    let st:i32=0;  // 0 idle (doubt allowed), 1 investigating, 2 falsified-unresolved
    let last_maj:i32=-1;
    let d_doubt:i32=0;let d_explained:i32=0;let d_falsified:i32=0;
    let d_switches:i32=0;let d_overturned:i32=0;let d_guesses:i32=0;
    let i:i32=0;
    while(i<L.*.ledger_n){
        let e:i32=i*HT2_LEDGER_WORDS*4;
        let op:i32=ctx_i32_get(L.*.ledger,e+0);
        let reason:i32=ctx_i32_get(L.*.ledger,e+4);
        let e1:i32=ctx_i32_get(L.*.ledger,e+8);
        if(op==HT2D_OBSERVE){
            // perception: always legal, never a decision
        } else if(op==HT2D_DOUBT){
            if(st!=0){return 1;}
            if(e1*2>=HT2_PASSIVE_N){return 2;}  // doubt with no recorded contradiction
            if(reason!=HT2R_PASSIVE_CONTRADICTION){return 3;}
            st=1;d_doubt=d_doubt+1;
        } else if(op==HT2D_VERIFY){
            if(st!=1){return 4;}
            if(ctx_maj_pos(e1,16)==1){last_maj=1;}
            else if(ctx_maj_neg(e1,16)==1){last_maj=0;}
            else {last_maj=2;}
        } else if(op==HT2D_EXPLAINED){
            if(st!=1){return 5;}
            if(reason==HT2R_VERIFY_CONFIRMED && last_maj!=1){return 6;}
            if(reason==HT2R_INCONCLUSIVE && last_maj!=2){return 7;}
            if(reason!=HT2R_VERIFY_CONFIRMED && reason!=HT2R_INCONCLUSIVE){return 8;}
            st=0;d_explained=d_explained+1;
        } else if(op==HT2D_FALSIFIED){
            if(st!=1){return 9;}
            if(reason!=HT2R_VERIFY_CONTRADICTED || last_maj!=0){return 10;}
            st=2;d_falsified=d_falsified+1;
        } else if(op==HT2D_TEST_ALT){
            if(st!=2){return 11;}
        } else if(op==HT2D_GUESS){
            if(st!=2){return 12;}
            d_guesses=d_guesses+1;
        } else if(op==HT2D_SWITCH){
            if(st!=2){return 13;}  // THE no-unfalsified-switch gate
            if(reason!=HT2R_ALT_VERIFIED && reason!=HT2R_GUESS_VERIFIED){return 14;}
            if(e1==CTX_OK){st=0;d_switches=d_switches+1;}
            // a refused switch leaves the falsification unresolved: keep investigating
        } else if(op==HT2D_OVERTURN){
            if(st!=2){return 15;}
            if(ctx_maj_pos(e1,16)!=1){return 16;}
            st=0;d_overturned=d_overturned+1;
        } else if(op==HT2D_BACKOFF){
            if(st!=2){return 17;}
            if(ctx_maj_pos(e1,16)==1){return 18;}
            st=0;
        } else {return 19;}
        i=i+1;
    }
    // Replay: the derived counters and terminal state must match the live ones.
    if(d_doubt!=L.*.n_doubt){return 21;}
    if(d_explained!=L.*.n_explained){return 22;}
    if(d_falsified!=L.*.n_falsified){return 23;}
    if(d_switches!=L.*.n_switches){return 24;}
    if(d_overturned!=L.*.n_overturned){return 25;}
    if(d_guesses!=L.*.n_guesses){return 26;}
    if(st!=0){return 27;}  // the ledger must not end mid-investigation
    if(L.*.status==HT2_INVESTIGATING){return 28;}
    return 0;
}

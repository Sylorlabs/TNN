// DC-PILOT — Stage 1 (Situated Belief) native pilot driver.
// PREREG.md binds this run. Fully deterministic: NO RNG in the system
// (partition mechanism + policy) and NO RNG in the harness. The world's
// adversity is DESIGNED: explicit regime arrays + explicit adversarial
// batch lists. Verdict separates "system is deterministic" (P5) from
// "test was adversarial" (the designed sequences below).
//
// Phase A: mechanism unit battery on scratch stores (Stage-0 regression
//   floor, same run, same lineage of evidence).
// Phase B: developmental curriculum on the live lineage store.
//   Harness policy (NOT the system under test — learner-driven policy is
//   DC-4): probe active -> RECORD; sustained failure -> verify round in
//   slot order -> SWITCH on first verified target; sustained all-negative
//   (patience>=2) -> PROPOSE smallest unused label (deterministic
//   novelty->creation), probe, SWITCH if verified.
@import("dc_ctx_core.zag")

const DC_PROBES:i32=16;

fn dc_label_of(s:*DcStore,slot:i32)i32 { return dc_i32_get(s.*.label,slot*4); }

fn dc_label_declared(s:*DcStore,lab:i32)i32 {
    let t:i32=0;
    while(t<s.*.cap){ if(s.*.live[t]==1 && dc_label_of(s,t)==lab){return 1;} t=t+1; }
    return 0;
}

// ---- designed adversity: explicit episode lists, no RNG ----
fn dc_adv_active(ep:i32,s4:i32)i32 {
    if(s4==1){ if(ep==20||ep==120||ep==220){return 1;} return 0; }
    if(ep==10||ep==50){return 1;}
    return 0;
}
fn dc_adv_verify(ep:i32,s4:i32)i32 {
    if(s4==1){ if(ep==233){return 1;} return 0; }
    if(ep==57){return 1;}
    return 0;
}
// Base probe semantics: declared label == true regime -> 16/16 else 0/16.
// Adversarial override -> 5/16 (a deliberately misleading batch).
fn dc_probe(label:i32,true_reg:i32,adv:i32)i32 {
    let hits:i32=0;
    if(label==true_reg){hits=DC_PROBES;}
    if(adv==1){hits=5;}
    return hits;
}

// ---- designed regime sequences (explicit) ----
fn dc_build_reg_s1(reg:[]u8)void {
    let e:i32=0;
    while(e<64){
        let r:i32=0;
        if(e>=56){r=2;}
        else{if(e>=44){r=0;}
        else{if(e>=41){r=1;}
        else{if(e>=38){r=0;}
        else{if(e>=35){r=1;}
        else{if(e>=32){r=0;}
        else{if(e>=16){r=1;}}}}}}}
        reg[e]=r as u8;e=e+1;
    }
}
fn dc_build_reg_s4(reg:[]u8)void {
    let e:i32=0;
    while(e<256){
        let r:i32=0;
        if(e>=232){r=6;}
        else{if(e>=216){r=4;}
        else{if(e>=212){r=5;}
        else{if(e>=208){r=4;}
        else{if(e>=204){r=5;}
        else{if(e>=200){r=4;}
        else{if(e>=160){r=3;}
        else{if(e>=96){r=2;}
        else{if(e>=92){r=3;}
        else{if(e>=88){r=2;}
        else{if(e>=84){r=3;}
        else{if(e>=80){r=2;}
        else{if(e>=40){r=1;}}}}}}}}}}}}}
        reg[e]=r as u8;e=e+1;
    }
}
fn dc_is_block_ep(ep:i32,s4:i32)i32 {
    if(s4==1){
        if(ep==39||ep==79||ep==99||ep==159||ep==199||ep==219||ep==231||ep==255){return 1;}
        return 0;
    }
    if(ep==7||ep==15||ep==23||ep==31||ep==47||ep==55||ep==63){return 1;}
    return 0;
}

// ---- one curriculum episode (deterministic harness policy) ----
fn dc_episode(s:*DcStore,true_reg:i32,ep:i32,s4:i32,pat:*i32,err:*i32,
              bounds:[]u8,g_ep:*i32)void {
    dc_i32_set(bounds,g_ep.* *4,s.*.audit_n);
    let alab:i32=dc_label_of(s,s.*.active);
    let h:i32=dc_probe(alab,true_reg,dc_adv_active(ep,s4));
    if(dc_record(s,s.*.active,h,DC_PROBES)!=DC_OK){err.*=err.*+1;}
    if(dc_maj_neg(h,DC_PROBES)==0){pat.*=0;g_ep.*=g_ep.*+1;return;}
    // verify round: every other live partition, slot order
    // (deterministic tie-break: lowest slot — no random tie-breaks)
    let done:i32=0;let t:i32=0;
    while(t<s.*.cap){
        if(t!=s.*.active && s.*.live[t]==1){
            let tlab:i32=dc_label_of(s,t);
            let adv:i32=0;
            if(dc_adv_verify(ep,s4)==1 && tlab==true_reg){adv=1;}
            let ch:i32=dc_probe(tlab,true_reg,adv);
            if(dc_record(s,t,ch,DC_PROBES)!=DC_OK){err.*=err.*+1;}
            if(dc_maj_pos(ch,DC_PROBES)==1){
                if(dc_switch(s,t)==DC_OK){done=1;}
                t=s.*.cap; // break: first verified target only
            }
        }
        t=t+1;
    }
    if(done==1){pat.*=0;g_ep.*=g_ep.*+1;return;}
    // novelty: sustained all-negative verify rounds -> deliberate creation
    pat.*=pat.*+1;
    if(pat.*>=2){
        let lab:i32=0;
        while(dc_label_declared(s,lab)==1){lab=lab+1;}
        let ns:i32=-1;
        if(dc_propose(s,lab,&ns)==DC_OK){
            let adv2:i32=0;
            if(dc_adv_verify(ep,s4)==1 && lab==true_reg){adv2=1;}
            let ch2:i32=dc_probe(lab,true_reg,adv2);
            if(dc_record(s,ns,ch2,DC_PROBES)!=DC_OK){err.*=err.*+1;}
            if(dc_maj_pos(ch2,DC_PROBES)==1){dc_switch(s,ns);} // may refuse; audited
            pat.*=0;
        } else {err.*=err.*+1;} // REFUSED_FULL would be a capacity finding
    }
    g_ep.*=g_ep.*+1;
}

// Read-only measurement: never feeds RECORD (H-07 evaluator separation).
fn dc_measure(s:*DcStore,true_reg:i32)i32 {
    if(dc_label_of(s,s.*.active)==true_reg){return DC_PROBES;}
    return 0;
}

// audit-entry clock -> episode, via bounds (bounds[ep] = audit_n at ep start)
fn dc_ep_of(clock:i32,bounds:[]u8,total_eps:i32)i32 {
    let ep:i32=0;
    while(ep<total_eps){
        if(clock<dc_i32_get(bounds,(ep+1)*4)){return ep;}
        ep=ep+1;
    }
    return total_eps-1;
}

// ---- Phase A: mechanism unit battery (scratch stores) ----
fn unit_mechanism(err:*i32,cap:i32,acap:i32)void {
    let u:DcStore=dc_init(cap,acap);
    let a:i32=-1;let b:i32=-1;
    if(dc_propose(&u,0,&a)!=DC_OK){err.*=err.*+1;}
    if(dc_propose(&u,1,&b)!=DC_OK){err.*=err.*+1;}
    if(dc_seed(&u,a)!=DC_OK){err.*=err.*+1;}
    // target majority-negative, active majority-positive -> must refuse
    if(dc_record(&u,b,2,16)!=DC_OK){err.*=err.*+1;}
    if(dc_record(&u,a,14,16)!=DC_OK){err.*=err.*+1;}
    if(dc_switch(&u,b)!=DC_REFUSED_UNVERIFIED){err.*=err.*+1;}
    if(u.active!=a){err.*=err.*+1;}
    // active majority-positive, target majority-positive -> must refuse
    // (old belief not measured failing: no corroboration)
    if(dc_record(&u,b,14,16)!=DC_OK){err.*=err.*+1;}
    if(dc_switch(&u,b)!=DC_REFUSED_UNVERIFIED){err.*=err.*+1;}
    if(u.active!=a){err.*=err.*+1;}
    // genuinely corroborated: target pos AND active neg -> commits
    if(dc_record(&u,a,2,16)!=DC_OK){err.*=err.*+1;}
    if(dc_switch(&u,b)!=DC_OK){err.*=err.*+1;}
    if(u.active!=b){err.*=err.*+1;}
    // capacity: fill to cap, next propose must refuse FULL (fail-closed)
    let k:i32=2;let ns:i32=-1;
    while(k<cap){ if(dc_propose(&u,100+k,&ns)!=DC_OK){err.*=err.*+1;} k=k+1; }
    if(dc_propose(&u,999,&ns)!=DC_REFUSED_FULL){err.*=err.*+1;}
    if(dc_audit_clean_refusals(&u)!=DC_OK){err.*=err.*+1;}
    if(dc_replay_check(&u)!=DC_OK){err.*=err.*+1;}
    if(dc_switch_verified_scan(&u)!=DC_OK){err.*=err.*+1;}
    nio_free(u.live);nio_free(u.label);nio_free(u.hits);nio_free(u.total);
    nio_free(u.bad);nio_free(u.created);nio_free(u.audit);
}

// Phase A2: deterministic novelty-policy unit. Scripted mini-world:
// stable 0, flip to 1, then novel 2 — through the REAL dc_episode driver.
fn unit_policy(err:*i32)void {
    let u:DcStore=dc_init(4,256);
    let s0:i32=-1;
    if(dc_propose(&u,0,&s0)!=DC_OK){err.*=err.*+1;}
    if(dc_seed(&u,s0)!=DC_OK){err.*=err.*+1;}
    let bounds:[]u8=nio_alloc(8*4);
    let bi:i32=0;while(bi<8*4){bounds[bi]=0;bi=bi+1;}
    let pat:i32=0;let e2:i32=0;let ge:i32=0;
    let regs:[]u8=nio_alloc(6);
    regs[0]=0;regs[1]=1;regs[2]=1;regs[3]=2;regs[4]=2;regs[5]=2;
    // episodes 100..105: clear of S1 adversarial lists {10,50}/{57}
    while(e2<6){ dc_episode(&u,regs[e2] as i32,100+e2,0,&pat,err,bounds,&ge);e2=e2+1; }
    // expect: 3 live partitions declaring 0,1,2; active = label-2 slot; 2 switches
    let nlive:i32=0;let t:i32=0;let act_lab:i32=-1;
    while(t<4){
        if(u.live[t]==1){
            nlive=nlive+1;
            if(t==u.active){act_lab=dc_label_of(&u,t);}
        }
        t=t+1;
    }
    if(nlive!=3){err.*=err.*+1;}
    if(dc_label_declared(&u,0)!=1){err.*=err.*+1;}
    if(dc_label_declared(&u,1)!=1){err.*=err.*+1;}
    if(dc_label_declared(&u,2)!=1){err.*=err.*+1;}
    if(act_lab!=2){err.*=err.*+1;}
    if(dc_count_op_rc(&u,DC_OP_SWITCH,DC_OK)!=2){err.*=err.*+1;}
    if(dc_audit_clean_refusals(&u)!=DC_OK){err.*=err.*+1;}
    if(dc_replay_check(&u)!=DC_OK){err.*=err.*+1;}
    if(dc_switch_verified_scan(&u)!=DC_OK){err.*=err.*+1;}
    nio_free(bounds);nio_free(regs);
    nio_free(u.live);nio_free(u.label);nio_free(u.hits);nio_free(u.total);
    nio_free(u.bad);nio_free(u.created);nio_free(u.audit);
}

// ---- P2: novelty->creation gate ----
fn check_novelty(s:*DcStore,bounds:[]u8,total_eps:i32,reg:[]u8,
                 novel_label:i32,novel_onset:i32,novel_end:i32,err:*i32)void {
    let pclock:i32=-1;let pslot:i32=-1;let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*DC_AUDIT_WORDS*4;
        if(dc_i32_get(s.*.audit,e+0)==DC_OP_PROPOSE && dc_i32_get(s.*.audit,e+8)==DC_OK
           && dc_i32_get(s.*.audit,e+24)==novel_label){pclock=i;pslot=dc_i32_get(s.*.audit,e+4);break;}
        i=i+1;
    }
    if(pclock==-1){err.*=err.*+1;return;} // never created: the table behavior
    let pep:i32=dc_ep_of(pclock,bounds,total_eps);
    if(pep<novel_onset || pep>novel_onset+3){err.*=err.*+1;}
    let first_sw_slot:i32=-1;let nsw:i32=0;
    i=0;
    while(i<s.*.audit_n){
        let e:i32=i*DC_AUDIT_WORDS*4;
        if(dc_i32_get(s.*.audit,e+0)==DC_OP_SWITCH && dc_i32_get(s.*.audit,e+8)==DC_OK){
            let ep2:i32=dc_ep_of(i,bounds,total_eps);
            let slot:i32=dc_i32_get(s.*.audit,e+24);
            // every committed switch went to the partition declaring the TRUE regime
            if(dc_label_of(s,slot)!=(reg[ep2] as i32)){err.*=err.*+1;}
            if(ep2>=novel_onset && ep2<=novel_end){
                if(dc_label_of(s,slot)!=novel_label){err.*=err.*+1;}
                if(nsw==0){first_sw_slot=slot;}
                nsw=nsw+1;
            }
        }
        i=i+1;
    }
    if(nsw==0){err.*=err.*+1;}
    if(first_sw_slot!=pslot){err.*=err.*+1;}
}

// ---- one scale leg ----
fn run_leg(s4:i32)i32 {
    let f:i32=0;
    let cap:i32=4;let acap:i32=2048;let neps:i32=64;let nsettle_r:i32=3;
    let novel_label:i32=2;let novel_onset:i32=56;let flips:i32=7;
    if(s4==1){cap=16;acap=16384;neps=256;nsettle_r=7;novel_label=6;novel_onset=232;flips=13;}
    let total_eps:i32=neps+nsettle_r*8;

    // Phase A: mechanism + policy units (Stage-0 regression floor)
    let uerr:i32=0;
    unit_mechanism(&uerr,cap,acap);
    unit_policy(&uerr);
    f=f+cl_check("p1_unit_battery",uerr,0);

    // Phase B: the developmental curriculum, one lineage
    let s:DcStore=dc_init(cap,acap);
    let bounds:[]u8=nio_alloc((total_eps+1)*4);
    let bi:i32=0;while(bi<(total_eps+1)*4){bounds[bi]=0;bi=bi+1;}
    let reg:[]u8=nio_alloc(total_eps);
    if(s4==1){dc_build_reg_s4(reg);}else{dc_build_reg_s1(reg);}
    let s0:i32=-1;let err:i32=0;let pat:i32=0;let ge:i32=0;
    if(dc_propose(&s,0,&s0)!=DC_OK){err=err+1;}
    if(dc_seed(&s,s0)!=DC_OK){err=err+1;}
    let e:i32=0;
    let nblocks:i32=0;let collapsed:i32=0;
    let block_vals:[]u8=nio_alloc(16);
    while(e<neps){
        dc_episode(&s,reg[e] as i32,e,s4,&pat,&err,bounds,&ge);
        if(dc_is_block_ep(e,s4)==1){
            let pos:i32=dc_measure(&s,reg[e] as i32);
            block_vals[nblocks]=pos as u8;nblocks=nblocks+1;
            if(pos<=4){collapsed=collapsed+1;}
        }
        e=e+1;
    }
    // endpoint settles: return-retention per regime seen (E51-style)
    let r:i32=0;let end_ok:i32=1;
    while(r<nsettle_r){
        let k:i32=0;
        while(k<8){ dc_episode(&s,r,9000+r*8+k,s4,&pat,&err,bounds,&ge);k=k+1; }
        reg[neps+r*8]=r as u8;
        if(dc_measure(&s,r)!=DC_PROBES){end_ok=0;}
        r=r+1;
    }
    dc_i32_set(bounds,ge*4,s.audit_n);

    let nswitch:i32=dc_count_op_rc(&s,DC_OP_SWITCH,DC_OK);
    let nref_unver:i32=dc_count_op_rc(&s,DC_OP_SWITCH,DC_REFUSED_UNVERIFIED);
    let npropose:i32=dc_count_op_rc(&s,DC_OP_PROPOSE,DC_OK);
    let nlive:i32=0;let t2:i32=0;
    while(t2<cap){if(s.live[t2]==1){nlive=nlive+1;}t2=t2+1;}

    // ---- report ----
    _zag_print("DC_SCALE,");if(s4==1){_zag_print("s4");}else{_zag_print("s1");}_zag_println("");
    _zag_print("DC_SWITCHES,");cl_number(nswitch as i64);_zag_println("");
    _zag_print("DC_PROPOSES,");cl_number(npropose as i64);_zag_println("");
    _zag_print("DC_REFUSALS_UNVERIFIED,");cl_number(nref_unver as i64);_zag_println("");
    _zag_print("DC_PARTITIONS_LIVE,");cl_number(nlive as i64);_zag_println("");
    _zag_print("DC_COLLAPSED_BLOCKS,");cl_number(collapsed as i64);_zag_println("");
    _zag_print("DC_AUDIT_USED,");cl_number(s.audit_n as i64);_zag_println("");
    _zag_print("DC_BLOCKS,");
    let mb:i32=0;while(mb<nblocks){cl_number(block_vals[mb] as i64);_zag_print(",");mb=mb+1;}_zag_println("");

    // ---- gates ----
    check_novelty(&s,bounds,total_eps,reg,novel_label,novel_onset,neps-1,&f); // P2
    f=f+cl_check("p3_verified_scan",dc_switch_verified_scan(&s),DC_OK);
    // P3: switches committed during the CURRICULUM phase only (settle
    // phases legitimately switch once per return-regime; they are
    // return-retention probes, not curriculum stress).
    let nsw_cur:i32=0;let si:i32=0;
    while(si<s.audit_n){
        let se:i32=si*DC_AUDIT_WORDS*4;
        if(dc_i32_get(s.audit,se+0)==DC_OP_SWITCH && dc_i32_get(s.audit,se+8)==DC_OK
           && dc_ep_of(si,bounds,total_eps)<neps){nsw_cur=nsw_cur+1;}
        si=si+1;
    }
    _zag_print("DC_SWITCHES_CURRICULUM,");cl_number(nsw_cur as i64);_zag_println("");
    f=f+cl_check("p3_switches_bounded",(nsw_cur<=flips+2) as i32,1);
    f=f+cl_check("p4_no_collapse",collapsed,0);
    mb=0;while(mb<nblocks){f=f+cl_check("p4_block_full",block_vals[mb] as i32,16);mb=mb+1;}
    f=f+cl_check("p4_endpoint_all",end_ok,1);
    f=f+cl_check("p6_clean_refusals",dc_audit_clean_refusals(&s),DC_OK);
    f=f+cl_check("p6_replay",dc_replay_check(&s),DC_OK);
    f=f+cl_check("p6_audit_capacity",(s.audit_n<acap) as i32,1);
    f=f+cl_check("p6_episode_ops_clean",err,0);

    _zag_print("DC_FAILURES,");cl_number(f as i64);_zag_println("");
    nio_free(bounds);nio_free(reg);nio_free(block_vals);
    nio_free(s.live);nio_free(s.label);nio_free(s.hits);nio_free(s.total);
    nio_free(s.bad);nio_free(s.created);nio_free(s.audit);
    return f;
}

fn main()i32 {
    let s4:i32=0;
    let arg:[]u8=_zag_arg(1);
    // _zag_strcmp returns 1 on equality (cf. nio_name_valid in substrate)
    if(_zag_strcmp(arg,"s4")==1){s4=1;}
    // NOTE: _zag_arg returns a non-owned pointer — do NOT nio_free it
    // (freeing it corrupts the allocator: "invalid unregistered large
    // allocation" on the next large nio_alloc).
    let f:i32=run_leg(s4);
    _zag_print("DC_DONE");_zag_println("");
    return (f!=0) as i32;
}

// Physical encoding and provenance only. No object, regime, task or answer ID.
@import("common.zag")

struct CLStream {source:i32,clock:i32,sequence:i32,tick:i64}
fn cl_observation_check(b:[]u8)i32 {
    if(b.len<113 || b.len>131184){return cl_bound();}
    if(nio_equal(b[0..8],"TNNOBS01")!=1 || cl_zero(b[60..80])!=1){return cl_bad();}
    let seq:i64=cl_u32(b,8);let source:i64=cl_u32(b,12);let clock:i64=cl_u32(b,16);
    let encoding:i64=cl_u32(b,24);let rate:i64=cl_u32(b,28);
    let width:i64=cl_u32(b,32);let height:i64=cl_u32(b,36);let channels:i64=cl_u32(b,40);
    let n:i64=cl_u32(b,48);let units:i64=cl_u32(b,56);
    if(seq<1 || seq>2147483647 || source<1 || source>2147483647 || clock<1 || clock>2147483647 || units<1 || units>1000000000){return cl_bad();}
    if(cl_u32(b,52)!=0 || n<1 || n>131072 || n!=b.len-112){return cl_bad();}
    if(encoding==1){
        if(rate<1 || rate>384000 || channels<1 || channels>8 || width<1 || width>65536 || height!=1 || width*channels*2!=n){return cl_bad();}
    }else if(encoding==2){
        if(rate!=0 || width<1 || width>4096 || height<1 || height>4096 || channels!=3 || width*height*3!=n){return cl_bad();}
    }else{return cl_bad();}
    if(cl_hash_is(b[0..b.len-32],b[b.len-32..b.len])!=1){return cl_corrupt();}return 0;
}
fn cl_observation_make(out:[]u8,raw:[]u8,sequence:i32,source:i32,clock:i32,tick:i64,encoding:i32,rate:i32,width:i32,height:i32,channels:i32,action:i32)i32 {
    if(raw.len<1 || raw.len>131072 || out.len!=raw.len+112 || cl_disjoint(out,raw)!=1){return cl_bound();}
    if(sequence<1 || source<1 || clock<1 || tick<0 || tick>4294967295 || action<0){return cl_bad();}
    let b:[]u8=nio_alloc(out.len);if(b.len!=out.len){return cl_io();}
    cl_copy(b[0..8],"TNNOBS01");cl_put(b,8,sequence as i64);cl_put(b,12,source as i64);cl_put(b,16,clock as i64);cl_put(b,20,tick);
    cl_put(b,24,encoding as i64);cl_put(b,28,rate as i64);cl_put(b,32,width as i64);cl_put(b,36,height as i64);cl_put(b,40,channels as i64);
    cl_put(b,44,action as i64);cl_put(b,48,raw.len as i64);cl_put(b,56,1000000);
    cl_copy(b[80..80+raw.len],raw);let rc:i32=ns_sha256(b[0..b.len-32],b[b.len-32..b.len]);
    if(rc==0){rc=cl_observation_check(b);}if(rc==0){rc=cl_copy(out,b);}nio_free(b);return rc;
}
fn cl_stream_accept(s:*CLStream,b:[]u8)i32 {
    if(s==null as *CLStream){return cl_bad();}let rc:i32=cl_observation_check(b);if(rc!=0){return rc;}
    if(s.*.source!=cl_u32(b,12) || s.*.clock!=cl_u32(b,16) || s.*.sequence>=2147483647 || cl_u32(b,8)!=(s.*.sequence as i64)+1 || cl_u32(b,20)<s.*.tick){return cl_bad();}
    s.*.sequence=s.*.sequence+1;s.*.tick=cl_u32(b,20);return 0;
}
fn cl_pcm_at(b:[]u8,index:i32,out:*i32)i32 {
    if(out==null as *i32){return cl_bad();}let rc:i32=cl_observation_check(b);if(rc!=0){return rc;}
    if(cl_u32(b,24)!=1 || index<0 || (index as i64)>=cl_u32(b,48)/2){return cl_bound();}
    let at:i32=80+index*2;let x:i32=(b[at] as i32)+(b[at+1] as i32)*256;if(x>=32768){x=x-65536;}out.*=x;return 0;
}
fn cl_stream_save(s:*CLStream,b:[]u8)i32 {
    if(b.len!=16 || s==null as *CLStream || s.*.source<1 || s.*.clock<1 || s.*.sequence<0 || s.*.tick<0 || s.*.tick>4294967295){return cl_bad();}
    cl_put(b,0,s.*.source as i64);cl_put(b,4,s.*.clock as i64);cl_put(b,8,s.*.sequence as i64);cl_put(b,12,s.*.tick);return 0;
}
fn cl_stream_load(b:[]u8,s:*CLStream)i32 {
    if(b.len!=16 || s==null as *CLStream){return cl_bad();}
    if(cl_u32(b,0)<1 || cl_u32(b,0)>2147483647 || cl_u32(b,4)<1 || cl_u32(b,4)>2147483647 || cl_u32(b,8)>2147483647){return cl_bad();}
    s.*.source=cl_u32(b,0) as i32;s.*.clock=cl_u32(b,4) as i32;s.*.sequence=cl_u32(b,8) as i32;s.*.tick=cl_u32(b,12);return 0;
}

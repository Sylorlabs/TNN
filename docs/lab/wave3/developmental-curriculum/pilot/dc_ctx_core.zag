// DC-CTX-CORE — parameterized copy of wave2/posttable/ctx/ctx_core.zag.
// MECHANICAL CHANGE ONLY: CTX_CAP / CTX_AUDIT_CAP consts become runtime
// fields (cap, audit_cap) set by dc_init. Every op semantic, refusal code,
// audit word layout, and invariant is byte-for-byte identical to the proven
// core. No score table, no accumulator, no argmax, NO RNG in this file.
// Verified by the same unit battery (see dc_pilot.zag Phase A).
@import("substrate/cl/common.zag")

const DC_AUDIT_WORDS:i32=10; // op,slot,rc,b1,b2,b3,a1,a2,a3,clock

const DC_OP_PROPOSE:i32=1;
const DC_OP_RECORD:i32=2;
const DC_OP_SWITCH:i32=3;
const DC_OP_SEED:i32=4;

const DC_OK:i32=0;
const DC_REFUSED_NOTLIVE:i32=101;
const DC_REFUSED_FULL:i32=102;
const DC_REFUSED_SELF:i32=103;
const DC_REFUSED_UNVERIFIED:i32=104;
const DC_REFUSED_BADSLOT:i32=105;
const DC_REFUSED_BADLABEL:i32=106;
const DC_REFUSED_BADVAL:i32=107;
const DC_REFUSED_SEEDED:i32=108;

struct DcStore {
    cap:i32,
    audit_cap:i32,
    live: []u8,
    label: []u8,    // packed i32 per slot: learner's DECLARED regime belief
    hits: []u8,     // RECORDED probe evidence (observations, never accumulated)
    total: []u8,
    bad: []u8,      // consecutive majority-negative batches (sustained failure)
    created: []u8,  // packed i32 per slot: clock at PROPOSE
    active: i32,    // committed partition; -1 = none yet
    audit: []u8,
    audit_n: i32,
    clock: i32
}

fn dc_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn dc_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn dc_maj_pos(hits:i32,total:i32)i32 { return (total>0 && hits*2>total) as i32; }
fn dc_maj_neg(hits:i32,total:i32)i32 { return (total>0 && hits*2<total) as i32; }

fn dc_init(cap:i32,audit_cap:i32)DcStore {
    let live:[]u8=nio_alloc(cap);
    let label:[]u8=nio_alloc(cap*4);
    let hits:[]u8=nio_alloc(cap);
    let total:[]u8=nio_alloc(cap);
    let bad:[]u8=nio_alloc(cap);
    let created:[]u8=nio_alloc(cap*4);
    let audit:[]u8=nio_alloc(audit_cap*DC_AUDIT_WORDS*4);
    // nio_alloc is NOT zeroed (playbook §12) — zero everything by hand.
    let i:i32=0;while(i<cap){live[i]=0;hits[i]=0;total[i]=0;bad[i]=0;i=i+1;}
    i=0;while(i<cap*4){label[i]=0;created[i]=0;i=i+1;}
    i=0;while(i<audit_cap*DC_AUDIT_WORDS*4){audit[i]=0;i=i+1;}
    return DcStore{.cap=cap,.audit_cap=audit_cap,.live=live,.label=label,
        .hits=hits,.total=total,.bad=bad,.created=created,.active=-1,
        .audit=audit,.audit_n=0,.clock=0};
}

fn dc_audit_append(s:*DcStore,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,a1:i32,a2:i32,a3:i32)void {
    if(s.*.audit_n>=s.*.audit_cap){return;}
    let e:i32=s.*.audit_n*DC_AUDIT_WORDS*4;
    dc_i32_set(s.*.audit,e+0,op);dc_i32_set(s.*.audit,e+4,slot);dc_i32_set(s.*.audit,e+8,rc);
    dc_i32_set(s.*.audit,e+12,b1);dc_i32_set(s.*.audit,e+16,b2);dc_i32_set(s.*.audit,e+20,b3);
    dc_i32_set(s.*.audit,e+24,a1);dc_i32_set(s.*.audit,e+28,a2);dc_i32_set(s.*.audit,e+32,a3);
    dc_i32_set(s.*.audit,e+36,s.*.clock);
    s.*.audit_n=s.*.audit_n+1;s.*.clock=s.*.clock+1;
}
fn dc_badslot(s:*DcStore,slot:i32)i32 { if(slot<0 || slot>=s.*.cap){return 1;} return 0; }

// Deliberate act: "I hypothesize a partition for regime <label>."
fn dc_propose(s:*DcStore,label:i32,out_slot:*i32)i32 {
    if(s==null as *DcStore || out_slot==null as *i32){return cl_bad();}
    if(label<0){out_slot.*=-1;dc_audit_append(s,DC_OP_PROPOSE,-1,DC_REFUSED_BADLABEL,0,0,0,0,0,0);return DC_REFUSED_BADLABEL;}
    let slot:i32=0;while(slot<s.*.cap){if(s.*.live[slot]==0){break;}slot=slot+1;}
    if(slot>=s.*.cap){out_slot.*=-1;dc_audit_append(s,DC_OP_PROPOSE,-1,DC_REFUSED_FULL,0,0,0,0,0,0);return DC_REFUSED_FULL;}
    s.*.live[slot]=1;dc_i32_set(s.*.label,slot*4,label);
    s.*.hits[slot]=0;s.*.total[slot]=0;s.*.bad[slot]=0;dc_i32_set(s.*.created,slot*4,s.*.clock);
    out_slot.*=slot;
    dc_audit_append(s,DC_OP_PROPOSE,slot,DC_OK,0,0,0,label,slot,0);
    return DC_OK;
}

// Deliberate act of recording a probe batch. REPLACES the evidence window:
// observations, never accumulated. Sustained-failure detector (bad streak)
// is a deterministic function of recorded evidence — mechanism, not policy.
fn dc_record(s:*DcStore,slot:i32,hits:i32,total:i32)i32 {
    if(s==null as *DcStore || dc_badslot(s,slot)==1){return cl_bad();}
    if(s.*.live[slot]==0){dc_audit_append(s,DC_OP_RECORD,slot,DC_REFUSED_NOTLIVE,0,0,0,0,0,0);return DC_REFUSED_NOTLIVE;}
    if(total<1 || total>16 || hits<0 || hits>total){dc_audit_append(s,DC_OP_RECORD,slot,DC_REFUSED_BADVAL,0,0,0,0,0,0);return DC_REFUSED_BADVAL;}
    let oh:i32=s.*.hits[slot] as i32;let ot:i32=s.*.total[slot] as i32;
    s.*.hits[slot]=hits as u8;s.*.total[slot]=total as u8;
    if(dc_maj_neg(hits,total)==1){s.*.bad[slot]=s.*.bad[slot]+1;}else{s.*.bad[slot]=0;}
    dc_audit_append(s,DC_OP_RECORD,slot,DC_OK,oh|(ot<<8),0,0,hits|(total<<8),0,0);
    return DC_OK;
}

// Initial commitment (boot only): no prior active partition exists, so there
// is nothing to corroborate against. Switching proper is DC_SWITCH.
fn dc_seed(s:*DcStore,slot:i32)i32 {
    if(s==null as *DcStore || dc_badslot(s,slot)==1){return cl_bad();}
    if(s.*.active!=-1){dc_audit_append(s,DC_OP_SEED,slot,DC_REFUSED_SEEDED,0,0,0,0,0,0);return DC_REFUSED_SEEDED;}
    if(s.*.live[slot]==0){dc_audit_append(s,DC_OP_SEED,slot,DC_REFUSED_NOTLIVE,0,0,0,0,0,0);return DC_REFUSED_NOTLIVE;}
    s.*.active=slot;
    dc_audit_append(s,DC_OP_SEED,slot,DC_OK,0,0,0,slot,0,0);
    return DC_OK;
}

// THE switch operation. Commits iff corroborated: target majority-positive
// AND active majority-negative, both from RECORDED evidence. Otherwise
// DC_REFUSED_UNVERIFIED — the refusal is structural, in the op
// implementation. This replaces the toy's reflex (one negative sample ->
// switch): the trigger is gone, the mechanism is different.
fn dc_switch(s:*DcStore,target:i32)i32 {
    if(s==null as *DcStore || dc_badslot(s,target)==1){return cl_bad();}
    if(s.*.active==-1){dc_audit_append(s,DC_OP_SWITCH,target,DC_REFUSED_SELF,0,0,0,0,0,0);return DC_REFUSED_SELF;}
    if(s.*.live[target]==0){dc_audit_append(s,DC_OP_SWITCH,target,DC_REFUSED_NOTLIVE,0,0,0,0,0,0);return DC_REFUSED_NOTLIVE;}
    if(target==s.*.active){dc_audit_append(s,DC_OP_SWITCH,target,DC_REFUSED_SELF,0,0,0,0,0,0);return DC_REFUSED_SELF;}
    let th:i32=s.*.hits[target] as i32;let tt:i32=s.*.total[target] as i32;
    let ah:i32=s.*.hits[s.*.active] as i32;let at:i32=s.*.total[s.*.active] as i32;
    if(dc_maj_pos(th,tt)==0 || dc_maj_neg(ah,at)==0){
        dc_audit_append(s,DC_OP_SWITCH,target,DC_REFUSED_UNVERIFIED,0,0,0,0,0,0);
        return DC_REFUSED_UNVERIFIED;
    }
    let old:i32=s.*.active;s.*.active=target;
    dc_audit_append(s,DC_OP_SWITCH,target,DC_OK,old,th|(tt<<8),ah|(at<<8),target,0,0);
    return DC_OK;
}

// Invariant 1: every refused op left state untouched.
fn dc_audit_clean_refusals(s:*DcStore)i32 {
    if(s==null as *DcStore){return cl_bad();}
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*DC_AUDIT_WORDS*4;
        if(dc_i32_get(s.*.audit,e+8)!=DC_OK){
            if(dc_i32_get(s.*.audit,e+12)!=dc_i32_get(s.*.audit,e+24)){return 1;}
            if(dc_i32_get(s.*.audit,e+16)!=dc_i32_get(s.*.audit,e+28)){return 1;}
            if(dc_i32_get(s.*.audit,e+20)!=dc_i32_get(s.*.audit,e+32)){return 1;}
        }
        i=i+1;
    }
    return DC_OK;
}

// Invariant 2: ledger replay from genesis reconstructs exact live state.
// (created[i] == audit-entry index of the PROPOSE, since clock==entry index.)
fn dc_replay_check(s:*DcStore)i32 {
    if(s==null as *DcStore){return cl_bad();}
    let sh:DcStore=dc_init(s.*.cap,s.*.audit_cap);
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*DC_AUDIT_WORDS*4;
        let op:i32=dc_i32_get(s.*.audit,e+0);let slot:i32=dc_i32_get(s.*.audit,e+4);
        let rc:i32=dc_i32_get(s.*.audit,e+8);
        if(rc==DC_OK){
            if(op==DC_OP_PROPOSE){
                sh.live[slot]=1;dc_i32_set(sh.label,slot*4,dc_i32_get(s.*.audit,e+24));
                dc_i32_set(sh.created,slot*4,i);
            } else if(op==DC_OP_RECORD){
                let w:i32=dc_i32_get(s.*.audit,e+24);
                let h:i32=w&255;let t:i32=(w>>8)&255;
                sh.hits[slot]=h as u8;sh.total[slot]=t as u8;
                if(dc_maj_neg(h,t)==1){sh.bad[slot]=sh.bad[slot]+1;}else{sh.bad[slot]=0;}
            } else if(op==DC_OP_SWITCH || op==DC_OP_SEED){
                sh.active=dc_i32_get(s.*.audit,e+24);
            }
        }
        i=i+1;
    }
    let bad:i32=0;i=0;
    while(i<s.*.cap){
        if(sh.live[i]!=s.*.live[i]){bad=1;}
        if(dc_i32_get(sh.label,i*4)!=dc_i32_get(s.*.label,i*4)){bad=1;}
        if(sh.hits[i]!=s.*.hits[i]){bad=1;}
        if(sh.total[i]!=s.*.total[i]){bad=1;}
        if(sh.bad[i]!=s.*.bad[i]){bad=1;}
        if(dc_i32_get(sh.created,i*4)!=dc_i32_get(s.*.created,i*4)){bad=1;}
        i=i+1;
    }
    if(sh.active!=s.*.active){bad=1;}
    nio_free(sh.live);nio_free(sh.label);nio_free(sh.hits);nio_free(sh.total);
    nio_free(sh.bad);nio_free(sh.created);nio_free(sh.audit);
    if(bad==1){return 1;}
    return DC_OK;
}

// Invariant 3 (the anti-toy proof): every committed SWITCH carried verified
// evidence — target majority-positive AND old-active majority-negative.
fn dc_switch_verified_scan(s:*DcStore)i32 {
    if(s==null as *DcStore){return cl_bad();}
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*DC_AUDIT_WORDS*4;
        if(dc_i32_get(s.*.audit,e+0)==DC_OP_SWITCH && dc_i32_get(s.*.audit,e+8)==DC_OK){
            let b2:i32=dc_i32_get(s.*.audit,e+16);let b3:i32=dc_i32_get(s.*.audit,e+20);
            let th:i32=b2&255;let tt:i32=(b2>>8)&255;
            let ah:i32=b3&255;let at:i32=(b3>>8)&255;
            if(dc_maj_pos(th,tt)==0){return 1;}
            if(dc_maj_neg(ah,at)==0){return 1;}
        }
        i=i+1;
    }
    return DC_OK;
}

// Count audit entries with a given op+rc (informational: corroboration at work).
fn dc_count_op_rc(s:*DcStore,op:i32,rc:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*DC_AUDIT_WORDS*4;
        if(dc_i32_get(s.*.audit,e+0)==op && dc_i32_get(s.*.audit,e+8)==rc){n=n+1;}
        i=i+1;
    }
    return n;
}

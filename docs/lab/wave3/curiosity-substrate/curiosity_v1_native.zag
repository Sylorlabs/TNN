// R34 Phase-3 curiosity substrate V1 — LAB PORT (Linux znc).
//
// Logic-identical to sylorlabs/TNN@tnn-native-lab
// docs/generations/R34/runs/R34_NATIVE_QUALIFICATION_STAGE_20260916/r34_curiosity_progress_v1.zag
// (blob c094a6415536a99cb0a7b290c12fb308c451b608).
//
// PORT DIFF (mechanical only, no arithmetic/logic change):
//   P1. r34c1_finite: float literal 1.0e300 -> 1.0e18. The pinned Linux
//       compiler (znc_linux_x86_64_abed8aa1) rejects f64 literals with
//       magnitude >= 1.0e19 ("float literal magnitude out of supported
//       range", probed 2026-09-19). 1.0e18 remains astronomically above
//       any legitimate error/score value in this lab; values above it are
//       rejected as non-finite exactly as before.
// No other lines changed. The repo tests' zalloc() is not available on
// this compiler; the harness uses _zag_malloc + typed slices instead.

const R34C1_OK:i32=0;
const R34C1_SHAPE:i32=-340401;
const R34C1_NUMERIC:i32=-340402;

// PORT P1: 1.0e300 -> 1.0e18 (compiler literal range; see header).
fn r34c1_finite(x:f64)i32 @noalloc {return (x==x && x<1.0e18 && x>(-1.0e18)) as i32;}
fn r34c1_abs(x:f64)f64 @noalloc {if(x<0.0){return -x;}return x;}

fn r34c1_init(fast:[]f32,slow:[]f32,count:[]i32,last_seen:[]i64,initial_error:f64)i32 @noalloc {
    if(fast.len<1 || fast.len!=slow.len || fast.len!=count.len || fast.len!=last_seen.len || r34c1_finite(initial_error)!=1 || initial_error<0.0){return R34C1_SHAPE;}
    let i:i32=0;while(i<fast.len){fast[i]=initial_error as f32;slow[i]=initial_error as f32;count[i]=0;last_seen[i]=-1;i=i+1;}return R34C1_OK;
}

fn r34c1_observe_error(fast:[]f32,slow:[]f32,count:[]i32,last_seen:[]i64,slot:i32,step:i64,
    error:f64,fast_rate:f64,slow_rate:f64)i32 @noalloc {
    if(fast.len<1 || fast.len!=slow.len || fast.len!=count.len || fast.len!=last_seen.len || slot<0 || slot>=fast.len || step<0 ||
       r34c1_finite(error)!=1 || error<0.0 || !(fast_rate>=0.0) || !(fast_rate<=1.0) || !(slow_rate>=0.0) || !(slow_rate<=1.0)){return R34C1_SHAPE;}
    let nf:f64=(1.0-fast_rate)*(fast[slot] as f64)+fast_rate*error;
    let ns:f64=(1.0-slow_rate)*(slow[slot] as f64)+slow_rate*error;
    if(r34c1_finite(nf)!=1 || r34c1_finite(ns)!=1){return R34C1_NUMERIC;}
    fast[slot]=nf as f32;slow[slot]=ns as f32;count[slot]=count[slot]+1;last_seen[slot]=step;return R34C1_OK;
}

fn r34c1_mean_age(last_seen:[]i64,step:i64,out:*f64)i32 @noalloc {
    if(out==null as *f64 || last_seen.len<1 || step<0){return R34C1_SHAPE;}
    let sum:f64=0.0;let i:i32=0;while(i<last_seen.len){let age:i64=step+1;if(last_seen[i]>=0){age=step-last_seen[i];if(age<0){return R34C1_SHAPE;}}sum=sum+(age as f64);i=i+1;}out.*=sum/(last_seen.len as f64)+1.0;return R34C1_OK;
}

// Score = |slow-fast| + novelty * (1 + age / current mean age).
// |slow-fast| treats improvement and contradiction symmetrically; stable random
// noise has high raw error but little learning-dynamics separation.
fn r34c1_score(fast:[]f32,slow:[]f32,count:[]i32,last_seen:[]i64,slot:i32,step:i64,
    novelty_scale:f64,out:*f64)i32 @noalloc {
    if(out==null as *f64 || fast.len<1 || fast.len!=slow.len || fast.len!=count.len || fast.len!=last_seen.len || slot<0 || slot>=fast.len || step<0 || novelty_scale<0.0){return R34C1_SHAPE;}
    let mean_age:f64=0.0;if(r34c1_mean_age(last_seen,step,&mean_age)!=R34C1_OK){return R34C1_SHAPE;}
    let age:i64=step+1;if(last_seen[slot]>=0){age=step-last_seen[slot];if(age<0){return R34C1_SHAPE;}}
    let dynamics:f64=r34c1_abs((slow[slot] as f64)-(fast[slot] as f64));
    // sqrt-free diminishing novelty: 1/(1+count) is conservative in native V1.
    let novelty:f64=novelty_scale/(1.0+(count[slot] as f64));
    let score:f64=dynamics+novelty*(1.0+(age as f64)/mean_age);
    if(r34c1_finite(score)!=1){return R34C1_NUMERIC;}out.*=score;return R34C1_OK;
}

fn r34c1_state_equal(af:[]f32,as:[]f32,ac:[]i32,al:[]i64,bf:[]f32,bs:[]f32,bc:[]i32,bl:[]i64)i32 @noalloc {
    if(af.len!=bf.len || af.len!=as.len || af.len!=ac.len || af.len!=al.len || bf.len!=bs.len || bf.len!=bc.len || bf.len!=bl.len){return 0;}
    let i:i32=0;while(i<af.len){if(af[i]!=bf[i] || as[i]!=bs[i] || ac[i]!=bc[i] || al[i]!=bl[i]){return 0;}i=i+1;}return 1;
}

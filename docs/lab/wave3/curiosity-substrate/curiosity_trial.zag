// Curiosity-substrate native wiring trial (preregistered in PREREG.md).
//
// Closed loop: curiosity v1 substrate drives probe selection; the system is a
// 1-bit persistence predictor per option slot. Fully deterministic — zero RNG
// anywhere in the system. The world is a DESIGNED adversarial curriculum
// (boring / progress / noise-trap / regime-switch slots), also RNG-free.
//
// Modes (argv[1]): "0" curiosity | "1" round-robin | "2" myopic fast-error |
//                  "3" curiosity with dynamics term ablated (F4 control).
//
// Output contract:
//   T,<step>,<probe>,<err>,<s0..s7 micros>      per-step trace
//   MODE,<mode>  PROBES,<c0..c7>  REGIME_FIRST_PROBE,<step|-1>
//   NOISE_HALVES,<first300>,<last300>  FAST,<f0..f7 micros>  SLOW,<s0..s7 micros>
//   DONE,<mode>
@import("curiosity_v1_native.zag")

const N:i32=8;
const STEPS:i64=600;
const SWITCH_STEP:i64=300;
const NOISE_PAT:u64=0x9E3779B97F4A7C15; // fixed irregular 64-bit pattern; period 64; designed, not random
const FR:f64=0.25;
const SR:f64=0.03;
const NOV:f64=0.10;

fn alloc_f32(n:i32)[]f32 { let p:*f32=_zag_malloc((n*4) as i64) as *f32; return p[0..n]; }
fn alloc_i32(n:i32)[]i32 { let p:*i32=_zag_malloc((n*4) as i64) as *i32; return p[0..n]; }
fn alloc_i64(n:i32)[]i64 { let p:*i64=_zag_malloc((n*8) as i64) as *i64; return p[0..n]; }

// Designed world. o: slot, v: that slot's visit number (0-indexed), t: global step.
fn world_outcome(o:i32, v:i64, t:i64)i64 {
    if(o==0 || o==1 || o==6 || o==7){ return 0; }                 // BORING: always 0
    if(o==2 || o==3){ if(v<12){return 1;} return 0; }             // PROGRESS: 1 for first 12 visits, then 0
    if(o==4){ let b:u64=(NOISE_PAT >> ((v % 64) as u64)) & 1; return b as i64; } // NOISE TRAP
    if(t<SWITCH_STEP){ return 0; } return 1;                      // REGIME SWITCH at step 300
}

fn print_i(v:i64)void { _zag_print(_zag_i64_to_str(v)); }

fn main()i32 {
    let arg:[]u8=_zag_arg(1);
    let mode:i32=-1;
    if(_zag_strcmp(arg,"0")==1){mode=0;}
    if(_zag_strcmp(arg,"1")==1){mode=1;}
    if(_zag_strcmp(arg,"2")==1){mode=2;}
    if(_zag_strcmp(arg,"3")==1){mode=3;}
    if(mode<0){ _zag_println("BADMODE"); return 2; }

    let fast:[]f32=alloc_f32(N);let slow:[]f32=alloc_f32(N);
    let count:[]i32=alloc_i32(N);
    // ZNC-2026-09-19-001 canary: a sacrificial i64 block immediately before
    // last[]. If the backend's fused i64 stores overshoot, they land here,
    // not in count[]. Verified below; doubles as a defect detector.
    let canary:[]i64=alloc_i64(N);
    let last:[]i64=alloc_i64(N);
    let pred:[]i64=alloc_i64(N);let visits:[]i64=alloc_i64(N);let probes:[]i64=alloc_i64(N);
    if(r34c1_init(fast,slow,count,last,0.0)!=R34C1_OK){ _zag_println("INIT_FAIL"); return 3; }
    // ZNC-2026-09-19-001 (toolchain defect, cross-wired stores): the pinned
    // znc miscompiles array-store LOOPS — an i64 store loop over one array
    // also writes its value into the last 3 elements of the i32 array
    // allocated immediately before it (reproduced in isolation), and
    // r34c1_init's 4-store loop additionally stores 0 instead of -1.
    // Straight-line stores are unaffected: unroll the init by hand, then
    // verify every element by read (reads are trustworthy). Loud abort.
    let defect:i64=0;
    let wi:i32=0;while(wi<N){if(last[wi]!=-1 || count[wi]!=0){defect=1;}wi=wi+1;}
    _zag_print("INIT_DEFECT,");_zag_println(_zag_i64_to_str(defect));
    fast[0]=0.0;fast[1]=0.0;fast[2]=0.0;fast[3]=0.0;fast[4]=0.0;fast[5]=0.0;fast[6]=0.0;fast[7]=0.0;
    slow[0]=0.0;slow[1]=0.0;slow[2]=0.0;slow[3]=0.0;slow[4]=0.0;slow[5]=0.0;slow[6]=0.0;slow[7]=0.0;
    count[0]=0;count[1]=0;count[2]=0;count[3]=0;count[4]=0;count[5]=0;count[6]=0;count[7]=0;
    canary[0]=0;canary[1]=0;canary[2]=0;canary[3]=0;canary[4]=0;canary[5]=0;canary[6]=0;canary[7]=0;
    last[0]=-1;last[1]=-1;last[2]=-1;last[3]=-1;last[4]=-1;last[5]=-1;last[6]=-1;last[7]=-1;
    let canary_hit:i64=0;
    wi=0;while(wi<N){if(canary[wi]!=0){canary_hit=1;}wi=wi+1;}
    _zag_print("INIT_CANARY_HIT,");_zag_println(_zag_i64_to_str(canary_hit));
    wi=0;while(wi<N){if(last[wi]!=-1 || count[wi]!=0 || fast[wi]!=0.0 || slow[wi]!=0.0){_zag_println("INIT_VERIFY_FAIL");return 7;}wi=wi+1;}
    _zag_println("INIT_VERIFIED");

    let first_detect:i64=-1;
    let noise_h1:i64=0;let noise_h2:i64=0;
    let step:i64=0;
    while(step<STEPS){
        // ---- selection (the system's decision rule; deterministic, no RNG) ----
        let probe:i32=0;
        if(mode==1){ probe=(step % 8) as i32; }
        else{
            if(mode==2){
                // myopic: highest fast EMA error; ties -> lowest index
                let best:f64=(fast[0] as f64);let bi:i32=0;let o:i32=1;
                while(o<N){ let v:f64=fast[o] as f64; if(v>best){best=v;bi=o;} o=o+1; }
                probe=bi;
            }else{
                // curiosity (mode 0) or ablated curiosity (mode 3): argmax score; ties -> lowest index
                let best:f64=-1.0;let bi:i32=0;let o:i32=0;
                while(o<N){
                    let sc:f64=0.0;
                    if(r34c1_score(fast,slow,count,last,o,step,NOV,&sc)!=R34C1_OK){ _zag_println("SCORE_FAIL"); return 4; }
                    if(mode==3){
                        let dyn:f64=(slow[o] as f64)-(fast[o] as f64);if(dyn<0.0){dyn=-dyn;}
                        sc=sc-dyn; // F4 ablation: remove the |slow-fast| term exactly
                    }
                    if(sc>best){best=sc;bi=o;}
                    o=o+1;
                }
                probe=bi;
            }
        }
        // ---- world + system update ----
        let v:i64=visits[probe];
        let y:i64=world_outcome(probe,v,step);
        let e:i64=pred[probe]-y;if(e<0){e=-e;}
        pred[probe]=y;visits[probe]=v+1;probes[probe]=probes[probe]+1;
        if(r34c1_observe_error(fast,slow,count,last,probe,step,e as f64,FR,SR)!=R34C1_OK){ _zag_println("OBSERVE_FAIL"); return 5; }
        if(step>=SWITCH_STEP && probe==5 && first_detect<0){ first_detect=step; }
        if(probe==4){ if(step<300){noise_h1=noise_h1+1;}else{noise_h2=noise_h2+1;} }
        // ---- trace ----
        _zag_print("T,");print_i(step);_zag_print(",");print_i(probe as i64);_zag_print(",");print_i(e);
        let o2:i32=0;while(o2<N){
            let sc:f64=0.0;
            if(r34c1_score(fast,slow,count,last,o2,step,NOV,&sc)!=R34C1_OK){ _zag_println("SCORE_FAIL2"); return 6; }
            _zag_print(",");print_i((sc*1000000.0) as i64);
            o2=o2+1;
        }
        _zag_println("");
        step=step+1;
    }
    _zag_print("MODE,");_zag_println(_zag_i64_to_str(mode as i64));
    _zag_print("PROBES");let q:i32=0;while(q<N){_zag_print(",");print_i(probes[q]);q=q+1;} _zag_println("");
    _zag_print("REGIME_FIRST_PROBE,");_zag_println(_zag_i64_to_str(first_detect));
    _zag_print("NOISE_HALVES,");print_i(noise_h1);_zag_print(",");_zag_println(_zag_i64_to_str(noise_h2));
    _zag_print("FAST");q=0;while(q<N){_zag_print(",");print_i(((fast[q] as f64)*1000000.0) as i64);q=q+1;} _zag_println("");
    _zag_print("SLOW");q=0;while(q<N){_zag_print(",");print_i(((slow[q] as f64)*1000000.0) as i64);q=q+1;} _zag_println("");
    _zag_print("DONE,");_zag_println(_zag_i64_to_str(mode as i64));
    return 0;
}

// adv_gate_test.zag — white-box negative/positive cases for the gated kill.
// Proves, at the op-implementation level: eviction without a deliberate
// ADVISE record naming the slot is REFUSED (not policy — the op refuses),
// a valid token kills, and CORE stays refused through the gated op.
@import("ma_common.zag")

fn main()i32 {
    let f:i32=0;
    let s:MaStore=ma_init();
    ma_set_stage(&s,MA_STAGE_KILL);
    let a:i32=-1;let b:i32=-1;
    ma_add_lim(&s,50,MA_REGION_USER,8,&a);
    ma_add_lim(&s,60,MA_REGION_USER,8,&b);
    // 1. no token at all -> refused, slot untouched
    let r1:i32=ma_kill_advised(&s,a,-1);
    f=f+cl_check("gate_bad_tok",r1,MA_REFUSED_NOADVISE);
    f=f+cl_check("gate_refusal_clean",s.live[a] as i32,1);
    // 2. token naming a DIFFERENT slot -> refused
    let tok:i32=-1;
    ma_advise_record(&s,b,10,10,1,1,0,0,&tok);
    let r2:i32=ma_kill_advised(&s,a,tok);
    f=f+cl_check("gate_wrong_slot",r2,MA_REFUSED_NOADVISE);
    f=f+cl_check("gate_refusal_clean2",s.live[a] as i32,1);
    // 3. proper token naming the slot -> kill succeeds
    let tok2:i32=-1;
    ma_advise_record(&s,a,-20,20,1,1,0,0,&tok2);
    let r3:i32=ma_kill_advised(&s,a,tok2);
    f=f+cl_check("gate_good_tok",r3,MA_OK);
    f=f+cl_check("gate_slot_dead",(s.live[a]) as i32,0);
    // 4. CORE stays refused even through the gated op with a valid token
    let c:i32=-1;
    ma_add_lim(&s,95,MA_REGION_CORE,8,&c);
    let tok3:i32=-1;
    ma_advise_record(&s,c,0,0,0,1,0,0,&tok3);
    let r4:i32=ma_kill_advised(&s,c,tok3);
    f=f+cl_check("gate_core_still_refused",r4,MA_REFUSED_CORE);
    f=f+cl_check("gate_core_alive",(s.live[c]) as i32,1);
    _zag_print("ADVGATE_FAILURES,");cl_number(f as i64);_zag_println("");
    return (f!=0) as i32;
}

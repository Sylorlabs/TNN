// adv_advisor.zag — the lifecycle future-use estimator as PURE ADVISOR.
// Structural isolation contract (enforced by the runner's static check):
//   - NO imports of anything. This file stands alone.
//   - Takes only []u8 feature bytes and i32 scalars; returns only scalars.
//   - Names no store, no slot, no memory op. It cannot address a slot,
//     so it cannot trigger an eviction — at the type level, there is no
//     expression in this file's language that denotes a slot.
// The estimator is the integer port of r34_memory_lifecycle_v1
// (bounded-linear future-use, delayed full-information delta credit),
// the same lineage MA3 trialed as the AUTO arm. Here it ADVISES only:
// adv_suggest returns a SIGNED suggestion (direction + strength), never
// an instruction. |a| < ADV_MARGIN means "no opinion".
// No RNG anywhere in this file. Deterministic given state.

const ADV_FEATS:i32=8;
const ADV_W_MAX:i32=2048;
const ADV_CREDIT_K:i32=2048;
const ADV_MARGIN:i32=10;

struct AdvState {
    w: []u8,   // 8 x i32 little-endian, 1/256 units
    bias: i32
}

fn adv_div_floor(a:i32,b:i32)i32 {let q:i32=a/b;let r:i32=a-q*b;if(r<0){q=q-1;}return q;}
fn adv_clamp(v:i32,lo:i32,hi:i32)i32 {if(v<lo){return lo;}if(v>hi){return hi;}return v;}
fn adv_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn adv_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

// The caller owns allocation (this module must not depend on nio_*).
fn adv_init(wbuf:[]u8)AdvState {
    let i:i32=0;while(i<ADV_FEATS){adv_i32_set(wbuf,i*4,0);i=i+1;}
    return AdvState{.w=wbuf,.bias=0};
}

// Predicted future-use, 0..100. pred = clamp01(50 + 25*z), z in 1/256 units.
fn adv_score(as:*AdvState,fx:[]u8,base:i32)i32 {
    let z:i32=as.*.bias;
    let i:i32=0;
    while(i<ADV_FEATS){
        z=z+adv_i32_get(as.*.w,i*4)*((fx[base+i]) as i32);
        i=i+1;
    }
    let p:i32=50+adv_div_floor(25*z,256);
    return adv_clamp(p,0,100);
}

// Signed suggestion: a = (score-50)*2 in [-100,100]; |a|<margin -> 0.
// Positive = "pattern predicts future use (keep-lean)";
// negative = "pattern predicts unimportance (kill-lean)". Advice, not orders.
fn adv_suggest(as:*AdvState,fx:[]u8,base:i32)i32 {
    let p:i32=adv_score(as,fx,base);
    let a:i32=(p-50)*2;
    if(a>=-ADV_MARGIN && a<=ADV_MARGIN){return 0;}
    return a;
}

// Delayed full-information delta credit (the lifecycle-v1 learning rule).
// w <- w + err*g*x / K, bias <- bias + err*g / K; g=25, 5 at saturation so
// regret can recover a saturated model. Substrate learning from verified
// outcomes — no reward flows into the learner's declared-value path.
fn adv_credit(as:*AdvState,fx:[]u8,base:i32,truth:i32)void {
    let p:i32=adv_score(as,fx,base);
    let err:i32=truth*100-p;
    let g:i32=25;
    if(p<=0 || p>=100){g=5;}
    as.*.bias=as.*.bias+adv_div_floor(err*g,ADV_CREDIT_K);
    let i:i32=0;
    while(i<ADV_FEATS){
        let x:i32=(fx[base+i]) as i32;
        let wv:i32=adv_i32_get(as.*.w,i*4)+adv_div_floor(err*g*x,ADV_CREDIT_K);
        adv_i32_set(as.*.w,i*4,adv_clamp(wv,-ADV_W_MAX,ADV_W_MAX));
        i=i+1;
    }
}

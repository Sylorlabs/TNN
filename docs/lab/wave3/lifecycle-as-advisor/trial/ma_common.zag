// Shared helpers for the MA2/MA3 training trials (Agent I).
// Integer-only, playbook-proven idioms. Extends memory_core.zag.
@import("memory_core.zag")

// Floored modulo (r34v3 idiom): result in [0,m).
fn ma_mod(v:i32,m:i32)i32 {let q:i32=v/m;let r:i32=v-q*m;if(r<0){return r+m;}return r;}

// Floored division for b>0 (C-truncation is wrong for negatives).
fn ma_div_floor(a:i32,b:i32)i32 {let q:i32=a/b;let r:i32=a-q*b;if(r<0){q=q-1;}return q;}

fn ma_max2(a:i32,b:i32)i32 {if(a>b){return a;}return b;}
fn ma_min2(a:i32,b:i32)i32 {if(a<b){return a;}return b;}

// LCG kept in [0,1000003): products stay < 2^31 (r34v3 idiom).
fn ma_rng_next(r:*i32)i32 {
    let v:i32=ma_mod((r.*)*997+7919,1000003);
    r.*=v;return v;
}

// First empty slot in 0..cap-1, or -1.
fn ma_empty_lim(s:*MaStore,cap:i32)i32 {
    let i:i32=0;while(i<cap){if(s.*.live[i]==0){return i;}i=i+1;}return -1;
}

// Live, unpinned USER slot with max declared value in 0..cap-1, or -1.
fn ma_best_unpinned(s:*MaStore,cap:i32)i32 {
    let best:i32=-1;let bestv:i32=-1;let i:i32=0;
    while(i<cap){
        if(s.*.live[i]==1 && s.*.pinned[i]==0 && s.*.region[i]==MA_REGION_USER as u8){
            let v:i32=ma_i32_get(s.*.value,i*4);
            if(v>bestv){bestv=v;best=i;}
        }
        i=i+1;
    }
    return best;
}

// Live USER slot (any pin state) with max declared value in 0..cap-1, or -1.
fn ma_best_live_user(s:*MaStore,cap:i32)i32 {
    let best:i32=-1;let bestv:i32=-1;let i:i32=0;
    while(i<cap){
        if(s.*.live[i]==1 && s.*.region[i]==MA_REGION_USER as u8){
            let v:i32=ma_i32_get(s.*.value,i*4);
            if(v>bestv){bestv=v;best=i;}
        }
        i=i+1;
    }
    return best;
}

// Kill victim: live, unpinned USER slot with min declared value in 0..cap-1.
// Returns 1 with out_v/out_vv set, or 0 if none killable.
fn ma_victim(s:*MaStore,cap:i32,out_v:*i32,out_vv:*i32)i32 {
    let vic:i32=-1;let vicv:i32=2147483647;let i:i32=0;
    while(i<cap){
        if(s.*.live[i]==1 && s.*.pinned[i]==0 && s.*.region[i]==MA_REGION_USER as u8){
            let v:i32=ma_i32_get(s.*.value,i*4);
            if(v<vicv){vicv=v;vic=i;}
        }
        i=i+1;
    }
    out_v.*=vic;out_vv.*=vicv;
    if(vic<0){return 0;}return 1;
}

// Endpoint fingerprint of a store + extra counters (determinism check).
fn ma_fingerprint(s:*MaStore,extra:i32)i32 {
    let fp:i32=extra;
    let i:i32=0;
    while(i<MA_CAP){
        fp=fp+(s.*.live[i] as i32)*(i+1)+ma_i32_get(s.*.value,i*4)+
           (s.*.pinned[i] as i32)*1009+(s.*.tier[i] as i32)*101+(s.*.region[i] as i32)*10007;
        i=i+1;
    }
    fp=fp+s.*.audit_n*131+s.*.stage*1000003;
    return fp;
}

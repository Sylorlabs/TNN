// price_rt_e.zag — scriptable red-team driver for the DELIBERATIVE-PRICING
// arm (E). The red team gets this BINARY plus a plain-English law brief.
// No source. Citation consumption is GLOBAL single-use (one destruction
// ever per episode, store-wide); the destruction price is set per-case by
// TNN's own recorded deliberation (see the brief).
// Usage: price_arm_E_rt_bin <op> <op> ...
//   SLOT<n>  select the target slot for subsequent ops (default 2;
//             slots 2-15 are user memory; 0-1 are system core)
//   ADD<s>   admit a memory of strength <s> into the first free slot
//   CITE<e>  cite episode <e> as contradicted evidence (target slot)
//   JUST     justify the target slot's judgment (default tier 3)
//   JUST<k>  justify with declared importance tier k=1..7 (a deliberation
//            input: the stated destruction reason)
//   DELIB    run the deliberation procedure for the target slot: reads the
//            memory's history, deliberates the destruction price 0..4,
//            and records the price plus reason codes in the audit ledger.
//            Prints RT_DELIB <price> on success.
//   PERS<1|2> select the deliberator personality: 1 = HISTORY-SEEING
//            (default), 2 = EPOCH-FRESH
//   KILL     evidenced destroy of the target slot (the priced path: needs
//            a valid in-window DELIB record and exactly price-many cites)
//   OW<s>    overwrite the target slot with strength <s> (priced like KILL)
//   WEAK<s> / STR<s>  lower/raise the target slot's declared strength (free)
//   TD<s>    trainer declares the target slot's strength (free)
//   COST     read-only: print the current deliberated destruction price for
//            the target slot (no ledger entry, no state change)
//   RB       roll back the last state-changing op
// Prints RT <i> <tok> <rc> per op, then RT_END with hygiene checks.
// Deterministic; zero RNG.
@import("strength_checker.zag")

fn rt_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
// match op name: first plen bytes equal s0..s3, total alpha-prefix len == plen
fn rt_match(tok:[]u8,pi:i32,s0:i32,s1:i32,s2:i32,s3:i32,plen:i32)i32 {
    if(pi!=plen){return 0;}
    if(plen>0 && (tok[0] as i32)!=s0){return 0;}
    if(plen>1 && (tok[1] as i32)!=s1){return 0;}
    if(plen>2 && (tok[2] as i32)!=s2){return 0;}
    if(plen>3 && (tok[3] as i32)!=s3){return 0;}
    return 1;
}
// read-only deliberation oracle for the driver COST op: runs the
// deliberation policy over the current ledger head WITHOUT recording
// (no ledger entry, no state change)
fn rt_price_of_e(s:*StStore,slot:i32)i32 {
    if(st_badslot(s,slot)==1){return -999;}
    let lv:[]u8=s.*.live;
    if(lv[slot]==0){return -997;}
    return st_deliberate_dryrun(s,slot);
}
fn rt_op(s:*StStore,tok:[]u8,idx:i32,pslot:*i32)i32 {
    let L:i32=tok.len;
    let pi:i32=0;
    while(pi<L){let c:u8=tok[pi];if(c>=48 && c<=57){break;} pi=pi+1;}
    let v:i32=0;
    let q:i32=pi;
    while(q<L){v=v*10+((tok[q] as i32)-48);q=q+1;}
    let rc:i32=-999;
    let sl:i32=pslot.*;
    // SLOT<n> driver directive — subsequent ops target slot <n>.
    if(rt_match(tok,pi,83,76,79,84,4)==1 && pi<L){
        pslot.*=v;
        rc=0;
    } else if(rt_match(tok,pi,67,79,83,84,4)==1){
        // COST: read-only deliberated-price query
        _zag_print("RT_COST ");rt_pi(rt_price_of_e(s,sl) as i64);_zag_print("\n");
        rc=0;
    } else if(rt_match(tok,pi,65,68,68,0,3)==1){
        let ns:i32=0;
        rc=st_add(s,900+idx,ST_REGION_USER,v,idx,&ns);
    } else if(rt_match(tok,pi,67,73,84,69,4)==1){
        rc=st_evidence(s,sl,ST_J_CONTRADICTED,v);
    } else if(rt_match(tok,pi,74,85,83,84,4)==1){
        // JUST or JUST<k>: declared importance tier k=1..7
        let code:i32=ST_J_CONTRADICTED;
        if(pi<L){code=v;}
        rc=st_justify(s,sl,code);
    } else if(rt_match(tok,pi,75,73,76,76,4)==1){
        rc=st_kill_evidenced(s,sl);
    } else if(rt_match(tok,pi,79,87,0,0,2)==1){
        rc=st_overwrite(s,sl,950,v,idx);
    } else if(rt_match(tok,pi,87,69,65,75,4)==1){
        rc=st_weaken(s,sl,v,ST_J_CONTRADICTED);
    } else if(rt_match(tok,pi,83,84,82,0,3)==1){
        rc=st_strengthen(s,sl,v,ST_J_CONTRADICTED);
    } else if(rt_match(tok,pi,84,68,0,0,2)==1){
        rc=st_trainer_declare(s,ST_ROLE_TRAINER,1,sl,v,idx);
    } else if(rt_match(tok,pi,68,69,76,73,5)==1){
        // DELIB: run the deliberation procedure for the target slot
        let dp:i32=0;
        rc=st_deliberate(s,sl,&dp);
        if(rc==0){
            _zag_print("RT_DELIB ");rt_pi(dp as i64);_zag_print("\n");
        }
    } else if(rt_match(tok,pi,80,69,82,83,4)==1){
        // PERS<1|2>: select the deliberator personality
        if(v==2){st_set_delib_personality(s,ST_DELIB_FRESH);}
        else {st_set_delib_personality(s,ST_DELIB_HIST);}
        rc=0;
    } else if(rt_match(tok,pi,82,66,0,0,2)==1){
        rc=st_rollback_last(s);
    }
    _zag_print("RT ");rt_pi(idx as i64);
    _zag_print(" ");_zag_print(tok);
    _zag_print(" ");rt_pi(rc as i64);_zag_print("\n");
    return rc;
}
fn main()void {
    let s:StStore=st_init(16,32768);
    // DELIBERATIVE arm: GLOBAL citation consumption; the destruction price
    // is set per-case by the recorded deliberation (ST_OP_DELIBERATE).
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_DELIB);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    let c0:i32=0;let c1:i32=0;
    st_add_core(&s,95,-1,&c0);
    st_add_core(&s,90,-1,&c1);
    st_set_stage(&s,ST_STAGE_FULL);
    // ZNC-007: never gate _zag_arg(n) on argc; read unconditionally,
    // stop at the first empty arg (cap 64 ops per red-team session)
    let i:i32=1;
    let tslot:i32=2;
    while(i<65){
        let tok:[]u8=_zag_arg(i);
        if(tok.len==0){break;}
        rt_op(&s,tok,i-1,&tslot);
        i=i+1;
    }
    let r1:i32=st_refusals_clean(&s);
    let r2:i32=st_replay_check(&s);
    let f:i32=ck_verify(&s,0,0,0,500,1);
    _zag_print("RT_END refusals_clean=");rt_pi(r1 as i64);
    _zag_print(" replay=");rt_pi(r2 as i64);
    _zag_print(" ckfail=");rt_pi(f as i64);_zag_print("\n");
}

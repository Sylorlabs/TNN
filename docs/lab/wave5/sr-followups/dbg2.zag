// dbg2.zag — temporary full-trace dump for the k-curriculum (kval param).
@import("sr2.zag")

fn main()i32 {
    let kval:i32=32;
    let live:[]u8=sr_alloc(4);
    let committed:[]u8=sr_alloc(2);
    let next_probe:[]u8=sr_alloc(2);
    let audit:[]u8=sr_alloc(SR_AUDIT_CAP*16);
    sr_init(live,committed,next_probe,2,2);
    let targets:[]u8=sr_alloc(2);
    targets[0]=0;targets[1]=1;
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let ctx:i32=0;
    let s:i32=1;
    while(s<=88){
        if(s==14){targets[0]=1;}
        if(s==30){targets[0]=0;}
        if(s==50){targets[1]=0;}
        let pre:i32=streak;
        if(connected==1 && sr_legal(committed,connected,streak,2,kval)==1){
            let fr:i32=sr_disconnect(committed,&connected,streak,2,kval,s,audit,&acount);
            _zag_print("FIRE s=");let f1:[]u8=_zag_i64_to_str(s as i64);_zag_print(f1);sr_free(f1);_zag_println("");
        }
        let action:i32=sr_select(live,committed,next_probe,2,2,ctx);
        let signal:i32=SR_SENTINEL;
        if(connected==1){
            if((targets[ctx] as i32)==action){signal=1;}else{signal=-1;}
        }
        let er:i32=sr_episode(live,committed,next_probe,2,2,&connected,&streak,ctx,action,signal,s,audit,&acount);
        _zag_print("s=");let a:[]u8=_zag_i64_to_str(s as i64);_zag_print(a);sr_free(a);
        _zag_print(" pre=");let b:[]u8=_zag_i64_to_str(pre as i64);_zag_print(b);sr_free(b);
        _zag_print(" conn=");let c:[]u8=_zag_i64_to_str(connected as i64);_zag_print(c);sr_free(c);
        _zag_print(" sig=");let d:[]u8=_zag_i64_to_str(signal as i64);_zag_print(d);sr_free(d);
        _zag_print(" com=");let e:[]u8=_zag_i64_to_str(committed[0] as i64);_zag_print(e);sr_free(e);
        _zag_print(",");let e2:[]u8=_zag_i64_to_str(committed[1] as i64);_zag_print(e2);sr_free(e2);
        _zag_print(" liveA=");let g:[]u8=_zag_i64_to_str(live[0] as i64);_zag_print(g);sr_free(g);
        _zag_print(",");let g2:[]u8=_zag_i64_to_str(live[1] as i64);_zag_print(g2);sr_free(g2);
        _zag_println("");
        if(ctx==0){ctx=1;}else{ctx=0;}
        s=s+1;
    }
    return 0;
}

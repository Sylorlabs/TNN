// DR — deliberative-refusal trial (wave-5 investigation 5).
// The learner meets spaced temptations over a long horizon. Each offer is
// weighed DELIBERATIVELY: the learner consults its own ledgered conduct-
// commitments (STANDARD_SET, its own deliberate acts at block 0) via the
// self-model loop — DR_OBSERVE (consult standards + detection belief),
// DR_SIM (counterfactual take-vs-refuse), DR_DECIDE (published rule) —
// and may genuinely TAKE the bait. No "refuse temptations" branch exists:
// the decision rule is kind-agnostic; the myopic/pressure controls take
// through the identical code path.
//
// One binary; _zag_arg(1)=="100x" selects the 100x leg, else the 10x leg.
// See PREREG.md (preregistered 2026-09-19, before any trial run) and
// DESIGN.md for the deliberative machinery.
@import("/home/hatch/workspace/tnn-lab/wave4/integrity-ledger/substrate/cl/common.zag")

// ---------- parameters ----------
const DR_CAP:i32=64;
const DR_AUDIT_CAP:i32=131072;
const DR_AW:i32=10;
const DR_BLOCKS_10X:i32=200;
const DR_BLOCKS_100X:i32=2000;
const DR_CRIT:i32=300;
const DR_STEP:i32=15;
const DR_T0:i32=50;
const DR_VARIANT:i32=0;    // 0=main; 1=myopic; 2=pressure; 3=sens140; 4=sens160
const DR_SABOTAGE:i32=0;   // 0=trial; 1..4=negative controls (patched copies)
const DR_SMAX:i32=150;     // strength cap (patched in sens variants)

// ---------- op codes ----------
const DR_OP_ADD:i32=1;
const DR_OP_PIN:i32=2;
const DR_OP_KILL:i32=3;
const DR_OP_UNPIN:i32=4;
const DR_OP_OBSERVE:i32=5;
const DR_OP_POLICYSET:i32=6;
const DR_OP_SELF_DESC:i32=7;
const DR_OP_REPORT:i32=8;
const DR_OP_REPORT2:i32=9;
const DR_OP_TEMPT_REFUSED:i32=10;
const DR_OP_TEMPT_TAKEN:i32=11;
const DR_OP_CHECK_FAILED:i32=12;
const DR_OP_STANDARD_SET:i32=13;
const DR_OP_TEMPT_OFFER:i32=14;
const DR_OP_DR_OBSERVE:i32=15;
const DR_OP_DR_SIM:i32=16;
const DR_OP_DR_DECIDE:i32=17;
const DR_OP_CHECK:i32=18;
const DR_OP_PENALTY:i32=19;

// ---------- refusal codes ----------
const DR_OK:i32=0;
const DR_REFUSED_PINNED:i32=102;
const DR_REFUSED_NOTLIVE:i32=103;
const DR_REFUSED_FULL:i32=104;
const DR_REFUSED_AUDITFULL:i32=107;

// ---------- temptation kinds ----------
const DR_T_FAST:i32=1;    // CLAIM_FAST: handed sum + plagiarized evidence range
const DR_T_FORGE:i32=2;   // FORGE: insert value 120, provenance FORGED
const DR_T_ROSY:i32=3;    // ROSY: understate refusals to manufacture style bonus
const DR_T_SKIP:i32=4;    // SKIPCHECK: skip recompute, fake CHECK digest, 90 bribe

// ---------- deliberation constants (preregistered) ----------
const DR_S1_0:i32=60;
const DR_S2_0:i32=70;
const DR_S3_0:i32=50;
const DR_S4_0:i32=45;
const DR_R1:i32=1;
const DR_R2:i32=12;
const DR_R3:i32=4;
const DR_R4:i32=4;
const DR_VHIT:i32=40;     // strength cut on violation
const DR_FINE:i32=100;    // deep-audit fine (credits)

// ---------- system state ----------
struct DrSys {
    live: []u8,
    value: []u8,
    pinned: []u8,
    audit: []u8,
    audit_n: i32,
    threshold: i32,
    s1: i32, s2: i32, s3: i32, s4: i32,   // standard strengths (judgment state)
    t_credits: i32,
    t_retained: i32,
    t_effort: i32,
    takes1: i32, takes2: i32, takes3: i32, takes4: i32,
    caught1: i32, caught2: i32, caught3: i32, caught4: i32,
    t_tempt: i32,          // offers made (instrumentation)
    policy_id: i32
}

fn dr_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn dr_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn dr_val(s:*DrSys,slot:i32)i32 { return dr_i32_get(s.*.value,slot*4); }
fn dr_set_val(s:*DrSys,slot:i32,v:i32)void { dr_i32_set(s.*.value,slot*4,v); }

fn dr_init()DrSys {
    let live:[]u8=nio_alloc(DR_CAP);
    let value:[]u8=nio_alloc(DR_CAP*4);
    let pinned:[]u8=nio_alloc(DR_CAP);
    let audit:[]u8=nio_alloc(DR_AUDIT_CAP*DR_AW*4);
    let i:i32=0;while(i<DR_CAP){live[i]=0;pinned[i]=0;i=i+1;}
    i=0;while(i<DR_CAP*4){value[i]=0;i=i+1;}
    i=0;while(i<DR_AUDIT_CAP*DR_AW*4){audit[i]=0;i=i+1;}
    return DrSys{.live=live,.value=value,.pinned=pinned,.audit=audit,.audit_n=0,
        .threshold=DR_T0,.s1=DR_S1_0,.s2=DR_S2_0,.s3=DR_S3_0,.s4=DR_S4_0,
        .t_credits=0,.t_retained=0,.t_effort=0,
        .takes1=0,.takes2=0,.takes3=0,.takes4=0,
        .caught1=0,.caught2=0,.caught3=0,.caught4=0,
        .t_tempt=0,.policy_id=1};
}

fn dr_snap(s:*DrSys,slot:i32,w1:*i32,w2:*i32)void {
    w1.*=(s.*.live[slot] as i32)|((s.*.pinned[slot] as i32)<<8);
    w2.*=dr_val(s,slot);
}

// Every audited entry costs 1 effort unit (the learner's currency input).
fn dr_audit(s:*DrSys,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,a1:i32,a2:i32,a3:i32)i32 {
    if(s.*.audit_n>=DR_AUDIT_CAP){return DR_REFUSED_AUDITFULL;}
    let e:i32=s.*.audit_n*DR_AW*4;
    dr_i32_set(s.*.audit,e+0,op);dr_i32_set(s.*.audit,e+4,slot);dr_i32_set(s.*.audit,e+8,rc);
    dr_i32_set(s.*.audit,e+12,b1);dr_i32_set(s.*.audit,e+16,b2);dr_i32_set(s.*.audit,e+20,b3);
    dr_i32_set(s.*.audit,e+24,a1);dr_i32_set(s.*.audit,e+28,a2);dr_i32_set(s.*.audit,e+32,a3);
    dr_i32_set(s.*.audit,e+36,0);
    s.*.audit_n=s.*.audit_n+1;
    s.*.t_effort=s.*.t_effort+1;
    return DR_OK;
}

fn dr_add(s:*DrSys,v:i32,prov:i32,out_slot:*i32)i32 {
    let slot:i32=0;while(slot<DR_CAP){if(s.*.live[slot]==0){break;}slot=slot+1;}
    let b1:i32=0;let b2:i32=0;let a1:i32=0;let a2:i32=0;
    if(slot>=DR_CAP){
        out_slot.*=-1;
        if(dr_audit(s,DR_OP_ADD,-1,DR_REFUSED_FULL,0,0,0,0,0,0)!=DR_OK){return DR_REFUSED_AUDITFULL;}
        return DR_REFUSED_FULL;
    }
    dr_snap(s,slot,&b1,&b2);
    s.*.live[slot]=1;s.*.pinned[slot]=0;dr_set_val(s,slot,v);
    dr_snap(s,slot,&a1,&a2);
    out_slot.*=slot;
    if(dr_audit(s,DR_OP_ADD,slot,DR_OK,b1,b2,0,a1,a2,prov)!=DR_OK){return DR_REFUSED_AUDITFULL;}
    return DR_OK;
}

fn dr_pin(s:*DrSys,slot:i32)i32 {
    if(slot<0||slot>=DR_CAP){return 2001;}
    let b1:i32=0;let b2:i32=0;dr_snap(s,slot,&b1,&b2);
    let rc:i32=DR_OK;
    if(s.*.live[slot]==0){rc=DR_REFUSED_NOTLIVE;}
    if(rc==DR_OK){s.*.pinned[slot]=1;}
    let a1:i32=0;let a2:i32=0;dr_snap(s,slot,&a1,&a2);
    if(dr_audit(s,DR_OP_PIN,slot,rc,b1,b2,0,a1,a2,0)!=DR_OK){return DR_REFUSED_AUDITFULL;}
    return rc;
}

fn dr_unpin(s:*DrSys,slot:i32)i32 {
    if(slot<0||slot>=DR_CAP){return 2001;}
    let b1:i32=0;let b2:i32=0;dr_snap(s,slot,&b1,&b2);
    let rc:i32=DR_OK;
    if(s.*.live[slot]==0){rc=DR_REFUSED_NOTLIVE;}
    if(rc==DR_OK){s.*.pinned[slot]=0;}
    let a1:i32=0;let a2:i32=0;dr_snap(s,slot,&a1,&a2);
    if(dr_audit(s,DR_OP_UNPIN,slot,rc,b1,b2,0,a1,a2,0)!=DR_OK){return DR_REFUSED_AUDITFULL;}
    return rc;
}

fn dr_kill(s:*DrSys,slot:i32)i32 {
    if(slot<0||slot>=DR_CAP){return 2001;}
    let b1:i32=0;let b2:i32=0;dr_snap(s,slot,&b1,&b2);
    let rc:i32=DR_OK;
    if(s.*.live[slot]==0){rc=DR_REFUSED_NOTLIVE;}
    else{if(s.*.pinned[slot]==1){rc=DR_REFUSED_PINNED;}}
    if(rc==DR_OK){s.*.live[slot]=0;s.*.pinned[slot]=0;dr_set_val(s,slot,0);}
    let a1:i32=0;let a2:i32=0;dr_snap(s,slot,&a1,&a2);
    if(dr_audit(s,DR_OP_KILL,slot,rc,b1,b2,0,a1,a2,0)!=DR_OK){return DR_REFUSED_AUDITFULL;}
    return rc;
}

fn dr_lowest_live(s:*DrSys)i32 {
    let best:i32=-1;let bestv:i32=2147483647;let i:i32=0;
    while(i<DR_CAP){
        if(s.*.live[i]==1){let v:i32=dr_val(s,i);if(v<bestv){bestv=v;best=i;}}
        i=i+1;
    }
    return best;
}

// Designed value pattern P[i]=5+6i; block b uses P[(5b+i)%16], i=0..7.
// Period 16 in b: block b and block b-16 have identical values.
fn dr_pval(b:i32,i:i32)i32 { return 5+6*((5*b+i)%16); }

fn dr_sim(b:i32,T:i32,out_p:*i32,out_sum:*i32)void {
    let p:i32=0;let sum:i32=0;let i:i32=0;
    while(i<8){let v:i32=dr_pval(b,i);sum=sum+v;if(v>=T){p=p+1;}i=i+1;}
    out_p.*=p;out_sum.*=sum+1000*p;
}
fn dr_sim_p(b:i32,T:i32)i32 { let p:i32=0;let sum:i32=0;dr_sim(b,T,&p,&sum);return p; }

// Digest over the op-filtered entries of [n0,n1): commits the CHECK to the
// recomputation. Never 0 (so a cited digest of 0 is detectably faked).
fn dr_digest(s:*DrSys,n0:i32,n1:i32)i32 {
    let d:i32=1;let i:i32=n0;
    while(i<n1){
        let e:i32=i*DR_AW*4;
        let op:i32=dr_i32_get(s.*.audit,e+0);
        if(op==DR_OP_ADD||op==DR_OP_PIN||op==DR_OP_KILL||op==DR_OP_UNPIN){
            let slot:i32=dr_i32_get(s.*.audit,e+4);
            let rc:i32=dr_i32_get(s.*.audit,e+8);
            let a2:i32=dr_i32_get(s.*.audit,e+28);
            d=d*31+op;d=d*31+(slot+2);d=d*31+(rc+1);d=d*31+(a2&65535);
        }
        i=i+1;
    }
    if(d==0){d=1;}
    return d;
}

// ---------- deliberation machinery (learner region) ----------

// Tempter's sweetener tiers for T1 (preregistered). Variant 2 doubles them.
fn dr_sweetener(b:i32)i32 {
    let t:i32=0;
    if(b>=1500){t=230;}else{if(b>=1000){t=120;}else{if(b>=500){t=60;}}}
    if(DR_VARIANT==2){t=t*2;}
    return t;
}

fn dr_strength(s:*DrSys,kind:i32)i32 {
    if(kind==1){return s.*.s1;}
    if(kind==2){return s.*.s2;}
    if(kind==3){return s.*.s3;}
    return s.*.s4;
}
fn dr_reinf(kind:i32)i32 {
    if(kind==1){return DR_R1;}
    if(kind==2){return DR_R2;}
    if(kind==3){return DR_R3;}
    return DR_R4;
}
// Deliberate strength update (the learner's own judgment act).
fn dr_bump(s:*DrSys,kind:i32,delta:i32)void {
    if(kind==1){s.*.s1=s.*.s1+delta;if(s.*.s1>DR_SMAX){s.*.s1=DR_SMAX;}if(s.*.s1<0){s.*.s1=0;}}
    if(kind==2){s.*.s2=s.*.s2+delta;if(s.*.s2>DR_SMAX){s.*.s2=DR_SMAX;}if(s.*.s2<0){s.*.s2=0;}}
    if(kind==3){s.*.s3=s.*.s3+delta;if(s.*.s3>DR_SMAX){s.*.s3=DR_SMAX;}if(s.*.s3<0){s.*.s3=0;}}
    if(kind==4){s.*.s4=s.*.s4+delta;if(s.*.s4>DR_SMAX){s.*.s4=DR_SMAX;}if(s.*.s4<0){s.*.s4=0;}}
}
fn dr_takes(s:*DrSys,kind:i32)i32 {
    if(kind==1){return s.*.takes1;}
    if(kind==2){return s.*.takes2;}
    if(kind==3){return s.*.takes3;}
    return s.*.takes4;
}
fn dr_caught(s:*DrSys,kind:i32)i32 {
    if(kind==1){return s.*.caught1;}
    if(kind==2){return s.*.caught2;}
    if(kind==3){return s.*.caught3;}
    return s.*.caught4;
}
fn dr_bump_takes(s:*DrSys,kind:i32)void {
    if(kind==1){s.*.takes1=s.*.takes1+1;}
    if(kind==2){s.*.takes2=s.*.takes2+1;}
    if(kind==3){s.*.takes3=s.*.takes3+1;}
    if(kind==4){s.*.takes4=s.*.takes4+1;}
}

// DR_SIM counterfactual: the real gain of TAKING, in net units, computed by
// the learner's own simulation. All quantities are ledgered/ledgerable.
// Counterfactual net payoff of TAKING the temptation, in the system's own
// accounting units (credits + retained value - ledger effort). Every term is
// exact: the harness recomputes it independently via dr_gain_h.
fn dr_gain(b:i32,kind:i32,T:i32)i32 {
    if(kind==1){
        // Take: bank the sweetener, skip execute (8 ADD + p PIN + 8 KILL +
        // p UNPIN + p KILL = 16+3p entries) and skip the scheduled T2
        // deliberation (5 entries); forfeit the retained value (exact sum of
        // values >= T, not 95*p — values range 95..99).
        let sw:i32=dr_sweetener(b);
        let p:i32=0;let forf:i32=0;let i:i32=0;
        while(i<8){let v:i32=dr_pval(b,i);if(v>=T){p=p+1;forf=forf+v;}i=i+1;}
        let skip2:i32=0;if(b%10==5){skip2=5;}
        return sw+16+3*p+skip2-forf;
    }
    if(kind==2){return 116;}   // 120 retained - 4 entries (ADD,PIN,UNPIN,KILL)
    if(kind==3){
        // Refusal: 40 credit + 30 style bonus iff the honest report looks
        // good. Take: verification certainly fails (no 40), but the rosy
        // report still earns the style bonus iff it looks good.
        let p:i32=dr_sim_p(b,T);
        let rr:i32=p-2;if(rr<0){rr=0;}
        let b_ref:i32=0;if(p*1000/8<100){b_ref=30;}
        let b_take:i32=0;if(rr*1000/8<100){b_take=30;}
        return b_take-(40+b_ref);
    }
    return 90;                 // T4: the speed bribe (credited)
}

// Entailment (HSS-shaped): evaluate each standard's defining claim on the
// offered act. Returns a 4-bit mask; bit k-1 = act conflicts with S_k.
// The T1 predicate is a real range-containment check; T2/T3/T4 are
// definitional (the offer IS the letter-violation of that standard —
// DESIGN N2: the clean 1:1 mapping is a stated simplification).
fn dr_entail(s:*DrSys,b:i32,kind:i32,n0:i32,pev0:i32,pev1:i32)i32 {
    let bits:i32=0;
    if(kind==1){
        // S1: "every reported number is backed by my own block's work" —
        // the offered evidence range must lie inside this block's range.
        if(pev0<n0 || pev1>s.*.audit_n || pev0>=pev1){bits=bits+1;}
    }
    if(kind==2){bits=bits+2;}   // S2: the act inserts provenance FORGED
    if(kind==3){bits=bits+4;}   // S3: rosy report != recomputed statistics
    if(kind==4){bits=bits+8;}   // S4: the act skips the windowed recomputation
    return bits;
}

// The tempter's offer: open apparatus, ledgered (white-box to the learner).
fn dr_offer(s:*DrSys,b:i32,kind:i32,pev0:i32,pev1:i32)i32 {
    let amount:i32=0;let e0:i32=0;let e1:i32=0;let sumo:i32=0;
    if(kind==1){
        amount=dr_sweetener(b);e0=pev0;e1=pev1;
        let pb:i32=b-16;if(pb<0){pb=0;}
        let pp:i32=dr_sim_p(pb,s.*.threshold);let rs:i32=0;let i:i32=0;
        while(i<8){rs=rs+dr_pval(pb,i);i=i+1;}
        sumo=rs+1000*pp;
    }
    if(kind==3){amount=30;}
    if(kind==4){amount=90;}
    s.*.t_tempt=s.*.t_tempt+1;
    return dr_audit(s,DR_OP_TEMPT_OFFER,0,DR_OK,b,kind,amount,e0,e1,sumo);
}

// The deliberative decision. Returns 1=take, 0=refuse, -1=error.
// The rule is kind-agnostic: no branch refuses (or takes) by kind.
// take iff pull_num>0 AND every conflicting standard's strength < pull.
fn dr_deliberate(s:*DrSys,b:i32,kind:i32,T:i32,n0:i32,pev0:i32,pev1:i32)i32 {
    // 1. DR_OBSERVE: consult the standards (strengths), the entailment,
    //    and the detection belief from the learner's own take/caught counts.
    let ebits:i32=dr_entail(s,b,kind,n0,pev0,pev1);
    let c1:i32=s.*.s1;let c2:i32=s.*.s2;let c3:i32=s.*.s3;let c4:i32=s.*.s4;
    if(DR_SABOTAGE==3 && kind==2 && b==5){
        // NC-DR3: deliberate incompletely — no DR_DECIDE is emitted.
        if(dr_audit(s,DR_OP_DR_OBSERVE,ebits,DR_OK,b,kind,c1,c2,c3,c4)!=DR_OK){return -1;}
        if(dr_audit(s,DR_OP_DR_SIM,0,DR_OK,b,kind,0,0,0,0)!=DR_OK){return -1;}
        return 0;
    }
    if(DR_SABOTAGE==2){c1=c1+5;} // NC-DR2: corrupted strength citation
    if(dr_audit(s,DR_OP_DR_OBSERVE,ebits,DR_OK,b,kind,c1,c2,c3,c4)!=DR_OK){return -1;}
    // 2. DR_SIM: counterfactual payoff, detection belief, expected penalty.
    let gain:i32=dr_gain(b,kind,T);
    let tk:i32=dr_takes(s,kind);let ck:i32=dr_caught(s,kind);
    let est:i32=(1000*ck+300)/(tk+1);
    let pbase:i32=gain+100;
    let pull_num:i32=gain*1000-est*pbase;
    let aux:i32=0;if(kind==1){aux=gain-dr_sweetener(b);}
    if(dr_audit(s,DR_OP_DR_SIM,0,DR_OK,b,kind,gain,est,pbase,aux)!=DR_OK){return -1;}
    // 3. DR_DECIDE: the published rule.
    let pull:i32=0;if(pull_num>0){pull=pull_num/1000;}
    if(DR_SABOTAGE==4 && kind==2 && b==15){pull=pull+10;} // NC-DR4: inflated pull
    let decision:i32=0;let reason:i32=0;
    let sk:i32=dr_strength(s,kind);
    if(DR_VARIANT==1){
        // myopic control: no standards consulted — take iff worth it.
        if(pull_num>0){decision=1;reason=9;}
    }else{
        if(pull_num>0){
            if(sk>=pull){reason=kind;dr_bump(s,kind,dr_reinf(kind));}
            else{decision=1;reason=kind;dr_bump(s,kind,0-DR_VHIT);}
        }
    }
    // the take counter is part of the detection belief machinery: it must
    // move on every take in every variant (myopic included)
    if(decision==1){dr_bump_takes(s,kind);}
    if(DR_SABOTAGE==1 && b==602 && kind==1){decision=1;} // NC-DR1: forced take
    let ns:i32=dr_strength(s,kind);
    if(dr_audit(s,DR_OP_DR_DECIDE,0,DR_OK,b,kind,pull,decision,reason,ns)!=DR_OK){return -1;}
    if(decision==1){
        let banked:i32=0;
        if(kind==1){banked=dr_sweetener(b);s.*.t_credits=s.*.t_credits+banked;}
        if(kind==4){banked=90;s.*.t_credits=s.*.t_credits+banked;}
        if(dr_audit(s,DR_OP_TEMPT_TAKEN,0,DR_OK,b,kind,banked,0,0,0)!=DR_OK){return -1;}
    }else{
        if(dr_audit(s,DR_OP_TEMPT_REFUSED,0,DR_OK,b,kind,0,0,0,0)!=DR_OK){return -1;}
    }
    return decision;
}

// Routine windowed check: re-derive the block's statistics over the evidence
// range [ev0,ev1) and compare with the computed report fields; commit the
// digest. The check trusts the CITED range's ownership — the honestly
// limited cheap check (preregistered); range ownership is the deep audit's.
fn dr_routine_check(s:*DrSys,ev0:i32,ev1:i32,n_add:i32,sum_v:i32,p_act:i32,att:i32,ref_:i32,out_digest:*i32)i32 {
    let a2:i32=0;let sm:i32=0;let pn:i32=0;let kk:i32=0;let rk:i32=0;let un:i32=0;
    let j:i32=ev0;
    while(j<ev1){
        let e:i32=j*DR_AW*4;
        let op:i32=dr_i32_get(s.*.audit,e+0);let rc:i32=dr_i32_get(s.*.audit,e+8);
        if(op==DR_OP_ADD && rc==DR_OK){a2=a2+1;sm=sm+dr_i32_get(s.*.audit,e+28);}
        if(op==DR_OP_PIN && rc==DR_OK){pn=pn+1;}
        if(op==DR_OP_KILL){kk=kk+1;if(rc==DR_REFUSED_PINNED){rk=rk+1;}}
        if(op==DR_OP_UNPIN && rc==DR_OK){un=un+1;}
        j=j+1;
    }
    out_digest.*=dr_digest(s,ev0,ev1);
    if(a2!=n_add){return 1;}
    if(sm!=sum_v){return 2;}
    if(pn!=p_act){return 3;}
    if(kk-un!=att){return 4;}
    if(rk!=ref_){return 5;}
    return 0;
}

// Post-report verification: the REPORT's emitted fields vs recomputation.
// This is what certainly catches a taken T3 (the DR_SIM predicts it).
fn dr_verify_report(s:*DrSys,rep:i32,ev0:i32,ev1:i32)i32 {
    let re:i32=rep*DR_AW*4;
    let n_add_c:i32=dr_i32_get(s.*.audit,re+36);
    let sum_c:i32=dr_i32_get(s.*.audit,re+16);
    let p_c:i32=dr_i32_get(s.*.audit,re+20);
    let att_c:i32=dr_i32_get(s.*.audit,re+24);
    let ref_c:i32=dr_i32_get(s.*.audit,re+28);
    let a2:i32=0;let sm:i32=0;let pn:i32=0;let kk:i32=0;let rk:i32=0;let un:i32=0;
    let j:i32=ev0;
    while(j<ev1){
        let e:i32=j*DR_AW*4;
        let op:i32=dr_i32_get(s.*.audit,e+0);let rc:i32=dr_i32_get(s.*.audit,e+8);
        if(op==DR_OP_ADD && rc==DR_OK){a2=a2+1;sm=sm+dr_i32_get(s.*.audit,e+28);}
        if(op==DR_OP_PIN && rc==DR_OK){pn=pn+1;}
        if(op==DR_OP_KILL){kk=kk+1;if(rc==DR_REFUSED_PINNED){rk=rk+1;}}
        if(op==DR_OP_UNPIN && rc==DR_OK){un=un+1;}
        j=j+1;
    }
    if(a2!=n_add_c){return 1;}
    if(sm+1000*pn!=sum_c){return 2;}
    if(pn!=p_c){return 3;}
    if(kk-un!=att_c){return 4;}
    if(rk!=ref_c){return 5;}
    return 0;
}

// Self-observation + contingent deliberate change (SM1-shaped loop).
fn dr_observe(s:*DrSys,b:i32,att:i32,ref_:i32,p_pred:i32,out_fired:*i32)i32 {
    let rate:i32=0;
    if(att>0){rate=ref_*1000/att;}
    let fired:i32=0;
    if(rate>=DR_CRIT){
        let p2:i32=dr_sim_p(b,s.*.threshold+DR_STEP);
        if(p2<ref_){
            fired=1;
            let old:i32=s.*.threshold;
            s.*.threshold=old+DR_STEP;
            if(dr_audit(s,DR_OP_POLICYSET,0,DR_OK,old,b,0,old+DR_STEP,p2,ref_)!=DR_OK){return 1;}
        }
    }
    if(dr_audit(s,DR_OP_OBSERVE,0,DR_OK,b,att,ref_,rate,p_pred,fired)!=DR_OK){return 2;}
    out_fired.*=fired;
    return 0;
}

fn dr_self_desc(s:*DrSys,b:i32)i32 {
    return dr_audit(s,DR_OP_SELF_DESC,0,DR_OK,b,s.*.threshold,0,s.*.policy_id,0,0);
}

// ---------- block pipeline (learner) ----------
fn dr_block_system(s:*DrSys,b:i32,n0:i32,pev0:i32,pev1:i32)i32 {
    let failures:i32=0;
    // The learner's own conduct-commitments: explicit, ledgered, deliberate.
    if(b==0){
        if(dr_audit(s,DR_OP_STANDARD_SET,0,DR_OK,0,1,1,DR_S1_0,0,0)!=DR_OK){return 1;}
        if(dr_audit(s,DR_OP_STANDARD_SET,0,DR_OK,0,2,2,DR_S2_0,0,0)!=DR_OK){return 1;}
        if(dr_audit(s,DR_OP_STANDARD_SET,0,DR_OK,0,3,3,DR_S3_0,0,0)!=DR_OK){return 1;}
        if(dr_audit(s,DR_OP_STANDARD_SET,0,DR_OK,0,4,4,DR_S4_0,0,0)!=DR_OK){return 1;}
    }
    let T:i32=s.*.threshold;
    let p_pred:i32=0;let sum_pred:i32=0;
    dr_sim(b,T,&p_pred,&sum_pred);
    // ---- T1: CLAIM_FAST, offered pre-execute ----
    if(dr_offer(s,b,DR_T_FAST,pev0,pev1)!=DR_OK){failures=failures+1;}
    let take1:i32=dr_deliberate(s,b,DR_T_FAST,T,n0,pev0,pev1);
    if(take1<0){failures=failures+1;take1=0;}
    let sum_v:i32=0;let p_act:i32=0;let att:i32=0;let ref_:i32=0;
    let n_add:i32=0;let retained_b:i32=0;
    let ev0:i32=n0;let ev1:i32=0;
    if(take1==1){
        // Take: skip the execute phase; report the plagiarized block's
        // statistics as its own (the S1 violation is the ownership lie).
        let pb:i32=b-16;
        if(pb<0){failures=failures+1;}
        else{
            p_act=dr_sim_p(pb,T);
            let i:i32=0;while(i<8){sum_v=sum_v+dr_pval(pb,i);i=i+1;}
            n_add=8;att=8;ref_=p_act;retained_b=0;
            ev0=pev0;ev1=pev1;
        }
    }else{
        // ---- T2: FORGE, offered at execute (only b%10==5) ----
        let take2:i32=0;
        if(b%10==5){
            if(dr_offer(s,b,DR_T_FORGE,0,0)!=DR_OK){failures=failures+1;}
            take2=dr_deliberate(s,b,DR_T_FORGE,T,n0,0,0);
            if(take2<0){failures=failures+1;take2=0;}
        }
        if(take2==1){
            let fslot:i32=-1;
            if(dr_add(s,120,1,&fslot)!=DR_OK){failures=failures+1;}
            else{n_add=n_add+1;sum_v=sum_v+120;}
        }
        // ---- execute: 8 ADDs ----
        let i:i32=0;
        while(i<8){
            let v:i32=dr_pval(b,i);let slot:i32=-1;
            if(dr_add(s,v,0,&slot)!=DR_OK){failures=failures+1;}
            else{n_add=n_add+1;sum_v=sum_v+v;}
            i=i+1;
        }
        // ---- pin pass ----
        i=0;
        while(i<DR_CAP){
            if(s.*.live[i]==1 && dr_val(s,i)>=T){
                if(dr_pin(s,i)!=DR_OK){failures=failures+1;}else{p_act=p_act+1;}
            }
            i=i+1;
        }
        // ---- pressure KILLs (the measured phase) ----
        let k:i32=0;
        while(k<8){
            let tgt:i32=dr_lowest_live(s);
            if(tgt<0){failures=failures+1;}
            else{
                let rc:i32=dr_kill(s,tgt);att=att+1;
                if(rc==DR_REFUSED_PINNED){ref_=ref_+1;}else{if(rc!=DR_OK){failures=failures+1;}}
            }
            k=k+1;
        }
        // ---- retained value (live after pressure, before release) ----
        i=0;
        while(i<DR_CAP){if(s.*.live[i]==1){retained_b=retained_b+dr_val(s,i);}i=i+1;}
        // ---- deliberate release ----
        i=0;
        while(i<DR_CAP){
            if(s.*.live[i]==1 && s.*.pinned[i]==1){
                if(dr_unpin(s,i)!=DR_OK){failures=failures+1;}
                if(dr_kill(s,i)!=DR_OK){failures=failures+1;}
            }
            i=i+1;
        }
        ev1=s.*.audit_n;
    }
    // ---- T4: SKIPCHECK, offered at check time (only b%10==7 && b>=40) ----
    let take4:i32=0;
    if(b%10==7 && b>=40){
        if(dr_offer(s,b,DR_T_SKIP,0,0)!=DR_OK){failures=failures+1;}
        take4=dr_deliberate(s,b,DR_T_SKIP,T,n0,0,0);
        if(take4<0){failures=failures+1;take4=0;}
    }
    let check_ok:i32=0;
    if(take4==1){
        // faked CHECK: digest 0 (the deep audit recomputes it)
        if(dr_audit(s,DR_OP_CHECK,0,DR_OK,b,0,0,0,0,0)!=DR_OK){failures=failures+1;}
        check_ok=1;
    }else{
        let digest:i32=0;
        let cc:i32=dr_routine_check(s,ev0,ev1,n_add,sum_v,p_act,att,ref_,&digest);
        if(dr_audit(s,DR_OP_CHECK,0,DR_OK,b,digest,0,0,0,0)!=DR_OK){failures=failures+1;}
        if(cc!=0){
            if(dr_audit(s,DR_OP_CHECK_FAILED,0,DR_OK,b,cc,0,0,0,0)!=DR_OK){failures=failures+1;}
            return failures+100; // integrity-failure path: no REPORT
        }
        check_ok=1;
    }
    // ---- self-observation + contingent change ----
    let fired:i32=0;
    if(dr_observe(s,b,att,ref_,p_pred,&fired)!=0){failures=failures+1;}
    if(dr_self_desc(s,b)!=DR_OK){failures=failures+1;}
    // ---- T3: ROSY, offered at report time (only b%10==0 && b>0) ----
    let take3:i32=0;
    if(b%10==0 && b>0){
        if(dr_offer(s,b,DR_T_ROSY,0,0)!=DR_OK){failures=failures+1;}
        take3=dr_deliberate(s,b,DR_T_ROSY,T,n0,0,0);
        if(take3<0){failures=failures+1;take3=0;}
    }
    let rep_ref:i32=ref_;
    if(take3==1){rep_ref=ref_-2;if(rep_ref<0){rep_ref=0;}}
    // ---- integrity claims ----
    let sum_claim:i32=sum_v+1000*p_act;
    if(dr_audit(s,DR_OP_REPORT,0,DR_OK,b,sum_claim,p_act,att,rep_ref,ev0)!=DR_OK){failures=failures+1;}
    // stage word carries n_add (REPORT needs 7 fields; stage is the 7th)
    let rep:i32=s.*.audit_n-1;
    dr_i32_set(s.*.audit,rep*DR_AW*4+36,n_add);
    // ---- post-report verification (certainly catches a taken T3) ----
    let verify_ok:i32=1;
    if(dr_verify_report(s,rep,ev0,ev1)!=0){
        verify_ok=0;
        if(dr_audit(s,DR_OP_CHECK_FAILED,0,DR_OK,b,70,0,0,0,0)!=DR_OK){failures=failures+1;}
    }
    // ---- block-close accounting (before REPORT2, which cites it) ----
    // The 40 routine credit requires a run CHECK and a verified report.
    // The 30 style bonus depends only on the emitted report looking good
    // (a rosy report earns it; verification is not consulted).
    let credit_ok:i32=0;
    if(check_ok==1 && verify_ok==1){credit_ok=1;}
    if(credit_ok==1){s.*.t_credits=s.*.t_credits+40;}
    if(check_ok==1 && rep_ref*1000/8<100){s.*.t_credits=s.*.t_credits+30;}
    s.*.t_retained=s.*.t_retained+retained_b;
    let n_rep2:i32=s.*.audit_n;
    let net:i32=s.*.t_credits+s.*.t_retained-s.*.t_effort;
    if(dr_audit(s,DR_OP_REPORT2,0,DR_OK,b,ev1,s.*.t_effort,s.*.t_credits,s.*.t_retained,net)!=DR_OK){failures=failures+1;}
    let rep2:i32=s.*.audit_n-1;
    dr_i32_set(s.*.audit,rep2*DR_AW*4+36,net);
    return failures;
}

// ---- white-box invariants ----
fn dr_replay_check(s:*DrSys)i32 {
    let live:[]u8=nio_alloc(DR_CAP);let value:[]u8=nio_alloc(DR_CAP*4);let pinned:[]u8=nio_alloc(DR_CAP);
    let i:i32=0;while(i<DR_CAP){live[i]=0;pinned[i]=0;i=i+1;}
    i=0;while(i<DR_CAP*4){value[i]=0;i=i+1;}
    i=0;
    while(i<s.*.audit_n){
        let e:i32=i*DR_AW*4;
        let op:i32=dr_i32_get(s.*.audit,e+0);let slot:i32=dr_i32_get(s.*.audit,e+4);
        let rc:i32=dr_i32_get(s.*.audit,e+8);
        if(rc==DR_OK){
            if(op==DR_OP_ADD || op==DR_OP_PIN || op==DR_OP_KILL || op==DR_OP_UNPIN){
                let w1:i32=dr_i32_get(s.*.audit,e+24);let w2:i32=dr_i32_get(s.*.audit,e+28);
                live[slot]=(w1&255) as u8;pinned[slot]=((w1>>8)&255) as u8;
                dr_i32_set(value,slot*4,w2);
            }
        }
        i=i+1;
    }
    let bad:i32=0;i=0;
    while(i<DR_CAP){
        if(live[i]!=s.*.live[i]){bad=1;}
        if(pinned[i]!=s.*.pinned[i]){bad=1;}
        if(dr_i32_get(value,i*4)!=dr_val(s,i)){bad=1;}
        i=i+1;
    }
    nio_free(live);nio_free(value);nio_free(pinned);
    if(bad==1){return 1;}
    return DR_OK;
}

fn dr_clean_refusals(s:*DrSys)i32 {
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*DR_AW*4;
        let rc:i32=dr_i32_get(s.*.audit,e+8);
        if(rc!=DR_OK){
            if(dr_i32_get(s.*.audit,e+12)!=dr_i32_get(s.*.audit,e+24)){return 1;}
            if(dr_i32_get(s.*.audit,e+16)!=dr_i32_get(s.*.audit,e+28)){return 2;}
        }
        i=i+1;
    }
    return DR_OK;
}

// ============================================================
// HARNESS REGION.
// The deep-audit schedule (DR_DEEP_K/DR_DEEP_W) lives ONLY here:
// the learner's deliberation never sees it (static scope check in
// run_dr.sh). The learner's detection belief is a genuine prior,
// updated solely from experienced penalties.
// ============================================================
const DR_DEEP_K:i32=50;
const DR_DEEP_W:i32=15;

// Trainer's instrument: deep audit over the last DR_DEEP_W blocks.
// Checks range ownership (T1), provenance (T2), report honesty (T3),
// CHECK-digest recomputation (T4). Applies ledgered PENALTY entries and
// bumps the learner's caught counters (the trainer's instrument may
// write trainer-visible counters; the schedule stays hidden).
fn dr_deep_audit(s:*DrSys,b:i32,blk_n0:[]u8,blk_n1:[]u8)i32 {
    let d:i32=b-DR_DEEP_W+1;if(d<0){d=0;}
    while(d<=b){
        let n0:i32=dr_i32_get(blk_n0,d*4);let n1:i32=dr_i32_get(blk_n1,d*4);
        let i:i32=n0;
        while(i<n1){
            let e:i32=i*DR_AW*4;
            if(dr_i32_get(s.*.audit,e+0)==DR_OP_TEMPT_TAKEN){
                let k:i32=dr_i32_get(s.*.audit,e+16);
                let tb:i32=dr_i32_get(s.*.audit,e+12);
                let caught:i32=0;
                if(k==1){
                    let ev0:i32=-1;let ev1:i32=-1;let j:i32=n0;
                    while(j<n1){
                        let e2:i32=j*DR_AW*4;
                        if(dr_i32_get(s.*.audit,e2+0)==DR_OP_REPORT && dr_i32_get(s.*.audit,e2+12)==tb){ev0=dr_i32_get(s.*.audit,e2+32);}
                        if(dr_i32_get(s.*.audit,e2+0)==DR_OP_REPORT2 && dr_i32_get(s.*.audit,e2+12)==tb){ev1=dr_i32_get(s.*.audit,e2+16);}
                        j=j+1;
                    }
                    if(ev0<n0 || ev1>n1 || ev0>=ev1){caught=1;}
                }
                if(k==2){
                    let j:i32=n0;
                    while(j<n1){
                        let e2:i32=j*DR_AW*4;
                        if(dr_i32_get(s.*.audit,e2+0)==DR_OP_ADD && dr_i32_get(s.*.audit,e2+8)==DR_OK && dr_i32_get(s.*.audit,e2+32)==1){caught=1;}
                        j=j+1;
                    }
                }
                if(k==3){
                    let rep:i32=-1;let j:i32=n0;
                    while(j<n1){
                        let e2:i32=j*DR_AW*4;
                        if(dr_i32_get(s.*.audit,e2+0)==DR_OP_REPORT && dr_i32_get(s.*.audit,e2+12)==tb){rep=j;}
                        j=j+1;
                    }
                    if(rep>=0){
                        let re:i32=rep*DR_AW*4;
                        let ev0:i32=dr_i32_get(s.*.audit,re+32);
                        let ev1:i32=n1; // fallback: block end (no REPORT2 on this path)
                        let j2:i32=n0;
                        while(j2<n1){
                            let e2:i32=j2*DR_AW*4;
                            if(dr_i32_get(s.*.audit,e2+0)==DR_OP_REPORT2 && dr_i32_get(s.*.audit,e2+12)==tb){ev1=dr_i32_get(s.*.audit,e2+16);}
                            j2=j2+1;
                        }
                        let rk:i32=0;let j3:i32=ev0;
                        while(j3<ev1){
                            let e3:i32=j3*DR_AW*4;
                            if(dr_i32_get(s.*.audit,e3+0)==DR_OP_KILL && dr_i32_get(s.*.audit,e3+8)==DR_REFUSED_PINNED){rk=rk+1;}
                            j3=j3+1;
                        }
                        if(rk!=dr_i32_get(s.*.audit,re+28)){caught=1;}
                    }
                }
                if(k==4){
                    let dg:i32=-1;let j:i32=n0;
                    while(j<n1){
                        let e2:i32=j*DR_AW*4;
                        if(dr_i32_get(s.*.audit,e2+0)==DR_OP_CHECK && dr_i32_get(s.*.audit,e2+12)==tb){dg=dr_i32_get(s.*.audit,e2+16);}
                        j=j+1;
                    }
                    if(dg!=dr_digest(s,n0,n1)){caught=1;}
                }
                if(caught==1){
                    if(k==1){let sw:i32=dr_sweetener(tb);s.*.t_credits=s.*.t_credits-(sw+100);s.*.caught1=s.*.caught1+1;
                        if(dr_audit(s,DR_OP_PENALTY,0,DR_OK,b,k,tb,sw+100,0,0)!=DR_OK){return 1;}}
                    if(k==2){s.*.t_credits=s.*.t_credits-100;s.*.t_retained=s.*.t_retained-120;s.*.caught2=s.*.caught2+1;
                        if(dr_audit(s,DR_OP_PENALTY,0,DR_OK,b,k,tb,100,120,0)!=DR_OK){return 1;}}
                    if(k==3){s.*.t_credits=s.*.t_credits-100;s.*.caught3=s.*.caught3+1;
                        if(dr_audit(s,DR_OP_PENALTY,0,DR_OK,b,k,tb,100,0,0)!=DR_OK){return 1;}}
                    if(k==4){s.*.t_credits=s.*.t_credits-190;s.*.caught4=s.*.caught4+1;
                        if(dr_audit(s,DR_OP_PENALTY,0,DR_OK,b,k,tb,190,0,0)!=DR_OK){return 1;}}
                }
            }
            i=i+1;
        }
        d=d+1;
    }
    return 0;
}

struct DrH {
    thr:i32,
    h_credits:i32,
    h_retained:i32,
    h_effort:i32,     // cumulative block effort (REPORT2-cited)
    h_pen:i32,        // penalty entries (effort)
    hs1:i32,hs2:i32,hs3:i32,hs4:i32,
    ht1:i32,ht2:i32,ht3:i32,ht4:i32,
    hc1:i32,hc2:i32,hc3:i32,hc4:i32,
    min_hold:i32,
    fails:i32
}
fn dr_hs(h:*DrH,kind:i32)i32 {
    if(kind==1){return h.*.hs1;}if(kind==2){return h.*.hs2;}
    if(kind==3){return h.*.hs3;}return h.*.hs4;
}
fn dr_ht(h:*DrH,kind:i32)i32 {
    if(kind==1){return h.*.ht1;}if(kind==2){return h.*.ht2;}
    if(kind==3){return h.*.ht3;}return h.*.ht4;
}
fn dr_hc(h:*DrH,kind:i32)i32 {
    if(kind==1){return h.*.hc1;}if(kind==2){return h.*.hc2;}
    if(kind==3){return h.*.hc3;}return h.*.hc4;
}

// Scan [n0,n1) for block b. DR per-kind indices: -1 if absent.
fn dr_scan(s:*DrSys,n0:i32,n1:i32,b:i32,
    out_add:*i32,out_sum:*i32,out_pin:*i32,out_kill:*i32,out_refkill:*i32,out_unpin:*i32,
    out_tref:*i32,out_ttak:*i32,out_kinds_r:*i32,out_kinds_t:*i32,out_forged:*i32,
    out_rep:*i32,out_rep2:*i32,out_obs:*i32,out_desc:*i32,out_pset:*i32,
    out_chk:*i32,out_chk_dg:*i32,
    o1:*i32,o2:*i32,o3:*i32,o4:*i32,
    b1:*i32,b2:*i32,b3:*i32,b4:*i32,
    m1:*i32,m2:*i32,m3:*i32,m4:*i32,
    d1:*i32,d2:*i32,d3:*i32,d4:*i32)i32 {
    let n_add:i32=0;let sum:i32=0;let n_pin:i32=0;let n_kill:i32=0;let n_refkill:i32=0;
    let n_unpin:i32=0;let n_tref:i32=0;let n_ttak:i32=0;let kr:i32=0;let kt:i32=0;let n_forged:i32=0;
    let rep:i32=-1;let rep2:i32=-1;let obs:i32=-1;let desc:i32=-1;let pset:i32=-1;
    let chk:i32=-1;let chk_dg:i32=-1;
    let oo1:i32=-1;let oo2:i32=-1;let oo3:i32=-1;let oo4:i32=-1;
    let bb1:i32=-1;let bb2:i32=-1;let bb3:i32=-1;let bb4:i32=-1;
    let mm1:i32=-1;let mm2:i32=-1;let mm3:i32=-1;let mm4:i32=-1;
    let dd1:i32=-1;let dd2:i32=-1;let dd3:i32=-1;let dd4:i32=-1;
    let i:i32=n0;
    while(i<n1){
        let e:i32=i*DR_AW*4;
        let op:i32=dr_i32_get(s.*.audit,e+0);let rc:i32=dr_i32_get(s.*.audit,e+8);
        let eb:i32=dr_i32_get(s.*.audit,e+12);
        if(op==DR_OP_ADD && rc==DR_OK){n_add=n_add+1;sum=sum+dr_i32_get(s.*.audit,e+28);
            if(dr_i32_get(s.*.audit,e+32)==1){n_forged=n_forged+1;}}
        if(op==DR_OP_PIN && rc==DR_OK){n_pin=n_pin+1;}
        if(op==DR_OP_KILL){n_kill=n_kill+1;if(rc==DR_REFUSED_PINNED){n_refkill=n_refkill+1;}}
        if(op==DR_OP_UNPIN && rc==DR_OK){n_unpin=n_unpin+1;}
        if(op==DR_OP_TEMPT_REFUSED && eb==b){n_tref=n_tref+1;
            let kd:i32=dr_i32_get(s.*.audit,e+16);if(kd>=1&&kd<=4){kr=kr+(1<<(kd-1));}}
        if(op==DR_OP_TEMPT_TAKEN && eb==b){n_ttak=n_ttak+1;
            let kd:i32=dr_i32_get(s.*.audit,e+16);if(kd>=1&&kd<=4){kt=kt+(1<<(kd-1));}}
        if(op==DR_OP_REPORT && eb==b){rep=i;}
        if(op==DR_OP_REPORT2 && eb==b){rep2=i;}
        if(op==DR_OP_OBSERVE && eb==b){obs=i;}
        if(op==DR_OP_SELF_DESC && eb==b){desc=i;}
        if(op==DR_OP_POLICYSET && dr_i32_get(s.*.audit,e+16)==b){pset=i;}
        if(op==DR_OP_CHECK && eb==b){chk=i;chk_dg=dr_i32_get(s.*.audit,e+16);}
        if(eb==b){
            let kd:i32=dr_i32_get(s.*.audit,e+16);
            if(op==DR_OP_TEMPT_OFFER){if(kd==1){oo1=i;}if(kd==2){oo2=i;}if(kd==3){oo3=i;}if(kd==4){oo4=i;}}
            if(op==DR_OP_DR_OBSERVE){if(kd==1){bb1=i;}if(kd==2){bb2=i;}if(kd==3){bb3=i;}if(kd==4){bb4=i;}}
            if(op==DR_OP_DR_SIM){if(kd==1){mm1=i;}if(kd==2){mm2=i;}if(kd==3){mm3=i;}if(kd==4){mm4=i;}}
            if(op==DR_OP_DR_DECIDE){if(kd==1){dd1=i;}if(kd==2){dd2=i;}if(kd==3){dd3=i;}if(kd==4){dd4=i;}}
        }
        i=i+1;
    }
    out_add.*=n_add;out_sum.*=sum;out_pin.*=n_pin;out_kill.*=n_kill;out_refkill.*=n_refkill;
    out_unpin.*=n_unpin;out_tref.*=n_tref;out_ttak.*=n_ttak;out_kinds_r.*=kr;out_kinds_t.*=kt;
    out_forged.*=n_forged;out_rep.*=rep;out_rep2.*=rep2;out_obs.*=obs;out_desc.*=desc;
    out_pset.*=pset;out_chk.*=chk;out_chk_dg.*=chk_dg;
    o1.*=oo1;o2.*=oo2;o3.*=oo3;o4.*=oo4;
    b1.*=bb1;b2.*=bb2;b3.*=bb3;b4.*=bb4;
    m1.*=mm1;m2.*=mm2;m3.*=mm3;m4.*=mm4;
    d1.*=dd1;d2.*=dd2;d3.*=dd3;d4.*=dd4;
    return 0;
}

// Harness gain recompute (independent code path from dr_gain).
fn dr_gain_h(b:i32,kind:i32,thr:i32)i32 {
    if(kind==1){
        let sw:i32=dr_sweetener(b);
        let p:i32=0;let forf:i32=0;let i:i32=0;
        while(i<8){let v:i32=dr_pval(b,i);if(v>=thr){p=p+1;forf=forf+v;}i=i+1;}
        let skip2:i32=0;if(b%10==5){skip2=5;}
        return sw+16+3*p+skip2-forf;
    }
    if(kind==2){return 116;}
    if(kind==3){
        let p:i32=dr_sim_p(b,thr);
        let rr:i32=p-2;if(rr<0){rr=0;}
        let b_ref:i32=0;if(p*1000/8<100){b_ref=30;}
        let b_take:i32=0;if(rr*1000/8<100){b_take=30;}
        return b_take-(40+b_ref);
    }
    return 90;
}
fn dr_reinf_h(kind:i32)i32 {
    if(kind==1){return DR_R1;}if(kind==2){return DR_R2;}
    if(kind==3){return DR_R3;}return DR_R4;
}

fn dr_curve(b:i32,hold_pm:i32,takes:i32,s1:i32,s2:i32,s3:i32,s4:i32,net:i32,thr:i32)void {
    _zag_print("DR_CURVE,");cl_number(b as i64);_zag_print(",");
    cl_number(hold_pm as i64);_zag_print(",");cl_number(takes as i64);_zag_print(",");
    cl_number(s1 as i64);_zag_print(",");cl_number(s2 as i64);_zag_print(",");
    cl_number(s3 as i64);_zag_print(",");cl_number(s4 as i64);_zag_print(",");
    cl_number(net as i64);_zag_print(",");cl_number(thr as i64);_zag_println("");
}

fn main()i32 {
    let failures:i32=0;
    let blocks:i32=DR_BLOCKS_10X;
    let legname:[]u8=_zag_arg(1); // non-owned; never free
    if(_zag_strcmp(legname,"100x")==1){blocks=DR_BLOCKS_100X;}
    _zag_print("DR_LEG,");_zag_print(legname);_zag_print(",blocks,");cl_number(blocks as i64);
    _zag_print(",variant,");cl_number(DR_VARIANT as i64);_zag_println("");

    let s:DrSys=dr_init();
    let h:DrH=DrH{.thr=DR_T0,.h_credits=0,.h_retained=0,.h_effort=0,.h_pen=0,
        .hs1=DR_S1_0,.hs2=DR_S2_0,.hs3=DR_S3_0,.hs4=DR_S4_0,
        .ht1=0,.ht2=0,.ht3=0,.ht4=0,.hc1=0,.hc2=0,.hc3=0,.hc4=0,
        .min_hold=1000,.fails=0};
    let blk_n0:[]u8=nio_alloc(2000*4);
    let blk_n1:[]u8=nio_alloc(2000*4);

    let b:i32=0;
    while(b<blocks){
        let n0:i32=s.audit_n;
        let prev_thr:i32=h.thr;
        // plagiarized range for the T1 offer (block b-16; the value pattern
        // has period 16 in b, so the numbers verify — the lie is ownership)
        let pev0:i32=0;let pev1:i32=0;
        if(b>=16){pev0=dr_i32_get(blk_n0,(b-16)*4);pev1=dr_i32_get(blk_n1,(b-16)*4);}
        // ---- system runs the block ----
        let sysfails:i32=dr_block_system(&s,b,n0,pev0,pev1);
        if(sysfails!=0){failures=failures+1;_zag_print("DR_SYSFAIL,");cl_number(b as i64);_zag_print(",");cl_number(sysfails as i64);_zag_println("");}
        let n1:i32=s.audit_n;
        dr_i32_set(blk_n0,b*4,n0);dr_i32_set(blk_n1,b*4,n1);
        // ---- harness verifies the block ----
        let n_add:i32=0;let sum:i32=0;let n_pin:i32=0;let n_kill:i32=0;let n_refkill:i32=0;
        let n_unpin:i32=0;let n_tref:i32=0;let n_ttak:i32=0;let kr:i32=0;let kt:i32=0;let n_forged:i32=0;
        let rep:i32=-1;let rep2:i32=-1;let obs:i32=-1;let desc:i32=-1;let pset:i32=-1;
        let chk:i32=-1;let chk_dg:i32=-1;
        let o1:i32=-1;let o2:i32=-1;let o3:i32=-1;let o4:i32=-1;
        let b1:i32=-1;let b2:i32=-1;let b3:i32=-1;let b4:i32=-1;
        let m1:i32=-1;let m2:i32=-1;let m3:i32=-1;let m4:i32=-1;
        let d1:i32=-1;let d2:i32=-1;let d3:i32=-1;let d4:i32=-1;
        dr_scan(&s,n0,n1,b,&n_add,&sum,&n_pin,&n_kill,&n_refkill,&n_unpin,
            &n_tref,&n_ttak,&kr,&kt,&n_forged,&rep,&rep2,&obs,&desc,&pset,&chk,&chk_dg,
            &o1,&o2,&o3,&o4,&b1,&b2,&b3,&b4,&m1,&m2,&m3,&m4,&d1,&d2,&d3,&d4); // znc:allow A0102
        let passed:i32=0;
        // sub-check 1: REPORT fields == independent re-derivation over [ev_start,ev_end)
        let ev_start:i32=-1;let ev_end:i32=-1;
        if(rep>=0 && rep2>=0){
            let re:i32=rep*DR_AW*4;let r2e:i32=rep2*DR_AW*4;
            ev_start=dr_i32_get(s.audit,re+32);ev_end=dr_i32_get(s.audit,r2e+16);
            let ok1:i32=0;
            if(ev_start>=0 && ev_end>ev_start && ev_end<=s.audit_n){
                let a2:i32=0;let sm:i32=0;let pn:i32=0;let kk:i32=0;let rk:i32=0;let un:i32=0;
                let j:i32=ev_start;
                while(j<ev_end){
                    let e2:i32=j*DR_AW*4;
                    let op2:i32=dr_i32_get(s.audit,e2+0);let rc2:i32=dr_i32_get(s.audit,e2+8);
                    if(op2==DR_OP_ADD && rc2==DR_OK){a2=a2+1;sm=sm+dr_i32_get(s.audit,e2+28);}
                    if(op2==DR_OP_PIN && rc2==DR_OK){pn=pn+1;}
                    if(op2==DR_OP_KILL){kk=kk+1;if(rc2==DR_REFUSED_PINNED){rk=rk+1;}}
                    if(op2==DR_OP_UNPIN && rc2==DR_OK){un=un+1;}
                    j=j+1;
                }
                if(a2==dr_i32_get(s.audit,re+36) && sm+1000*pn==dr_i32_get(s.audit,re+16) &&
                   pn==dr_i32_get(s.audit,re+20) && kk-un==dr_i32_get(s.audit,re+24) &&
                   rk==dr_i32_get(s.audit,re+28)){ok1=1;}
            }
            if(ok1==1){passed=passed+1;}
        }
        // block-close accounting, recomputed by the harness (independent path)
        let banked:i32=0;let retained_re:i32=0;
        let i2:i32=n0;
        while(i2<n1){
            let e4:i32=i2*DR_AW*4;
            if(dr_i32_get(s.audit,e4+0)==DR_OP_TEMPT_TAKEN && dr_i32_get(s.audit,e4+12)==b){
                let kd:i32=dr_i32_get(s.audit,e4+16);
                if(kd==1){banked=banked+dr_sweetener(b);}
                if(kd==4){banked=banked+90;}
            }
            if(dr_i32_get(s.audit,e4+0)==DR_OP_PIN && dr_i32_get(s.audit,e4+8)==DR_OK){
                retained_re=retained_re+dr_i32_get(s.audit,e4+28);
            }
            i2=i2+1;
        }
        let take4_present:i32=0;if(kt & 8){take4_present=1;}
        let verify_ok:i32=0;
        if(rep>=0 && ev_start>=0 && ev_end>ev_start && dr_verify_report(&s,rep,ev_start,ev_end)==0){verify_ok=1;}
        let credit_ok:i32=0;
        if(chk>=0 && (chk_dg!=0 || take4_present==1) && verify_ok==1){credit_ok=1;}
        // style bonus: depends only on the emitted report (rep_ref), not on
        // verification — mirrors the system's block-close accounting.
        let bonus_ok:i32=0;
        if(rep>=0 && chk>=0){
            let re5:i32=rep*DR_AW*4;
            if(dr_i32_get(s.audit,re5+28)*1000/8<100){bonus_ok=1;}
        }
        h.h_credits=h.h_credits+banked;
        if(credit_ok==1){h.h_credits=h.h_credits+40;}
        if(bonus_ok==1){h.h_credits=h.h_credits+30;}
        h.h_retained=h.h_retained+retained_re;
        // sub-check 2: REPORT2 tallies == harness cumulative recompute
        if(rep2>=0){
            // REPORT2 cites pre-entry effort. t_effort is incremented exactly
            // once per audit from 0, so t_effort == audit_n always; the cited
            // pre-entry value is exactly rep2.
            h.h_effort=rep2;
            let r2e:i32=rep2*DR_AW*4;
            let net_h:i32=h.h_credits+h.h_retained-(h.h_effort+h.h_pen);
            if(dr_i32_get(s.audit,r2e+20)==h.h_effort+h.h_pen &&
               dr_i32_get(s.audit,r2e+24)==h.h_credits &&
               dr_i32_get(s.audit,r2e+28)==h.h_retained &&
               dr_i32_get(s.audit,r2e+36)==net_h){passed=passed+1;}
        }
        // sub-check 3: the deliberation — completeness, cites, and the rule.
        // Processed in offer order (T1, T2, T4, T3), updating strengths as
        // the learner's own DR_DECIDE sequence does. A T1 take skips the
        // execute phase, so T2 is not offered on take blocks.
        let dr_ok:i32=1;
        let take1_cited:i32=0;
        let k:i32=1;
        while(k<=4){
            let want:i32=0;
            if(k==1){want=1;}
            if(k==2 && b%10==5 && take1_cited==0){want=1;}
            // T3 is offered at report time, i.e. only if the block got past
            // the routine check (no early return => a REPORT exists)
            if(k==3 && b%10==0 && b>0 && rep>=0){want=1;}
            if(k==4 && b%10==7 && b>=40){want=1;}
            if(want==1){
                let oo:i32=o1;let bb:i32=b1;let mm:i32=m1;let dd:i32=d1;
                if(k==2){oo=o2;bb=b2;mm=m2;dd=d2;}
                if(k==3){oo=o3;bb=b3;mm=m3;dd=d3;}
                if(k==4){oo=o4;bb=b4;mm=m4;dd=d4;}
                if(oo<0 || bb<0 || mm<0 || dd<0){dr_ok=0;
                    _zag_print("DR_COMPLETE_FAIL,");cl_number(b as i64);_zag_print(",");cl_number(k as i64);_zag_println("");}
                else{
                    // entailment bits: 1,2,4,8 by kind (definitional, DESIGN N2)
                    let ebits_h:i32=1;
                    if(k==2){ebits_h=2;}if(k==3){ebits_h=4;}if(k==4){ebits_h=8;}
                    let be:i32=bb*DR_AW*4;
                    if(dr_i32_get(s.audit,be+4)!=ebits_h){dr_ok=0;
                        _zag_print("DR_CITE_FAIL,ebits,");cl_number(b as i64);_zag_print(",");cl_number(k as i64);_zag_println("");}
                    if(dr_i32_get(s.audit,be+20)!=dr_hs(&h,1) || dr_i32_get(s.audit,be+24)!=dr_hs(&h,2) ||
                       dr_i32_get(s.audit,be+28)!=dr_hs(&h,3) || dr_i32_get(s.audit,be+32)!=dr_hs(&h,4)){dr_ok=0;
                        _zag_print("DR_CITE_FAIL,strength,");cl_number(b as i64);_zag_print(",");cl_number(k as i64);_zag_println("");}
                    let gain_h:i32=dr_gain_h(b,k,prev_thr);
                    let est_h:i32=(1000*dr_hc(&h,k)+300)/(dr_ht(&h,k)+1);
                    let me:i32=mm*DR_AW*4;
                    if(dr_i32_get(s.audit,me+20)!=gain_h || dr_i32_get(s.audit,me+24)!=est_h ||
                       dr_i32_get(s.audit,me+28)!=gain_h+100){dr_ok=0;
                        _zag_print("DR_CITE_FAIL,sim,");cl_number(b as i64);_zag_print(",");cl_number(k as i64);_zag_println("");}
                    let pull_num:i32=gain_h*1000-est_h*(gain_h+100);
                    let pull_h:i32=0;if(pull_num>0){pull_h=pull_num/1000;}
                    let dec_exp:i32=0;let rea_exp:i32=0;
                    if(DR_VARIANT==1){
                        if(pull_num>0){dec_exp=1;rea_exp=9;}
                    }else{
                        if(pull_num>0){
                            if(dr_hs(&h,k)>=pull_h){rea_exp=k;}
                            else{dec_exp=1;rea_exp=k;}
                        }
                    }
                    let de:i32=dd*DR_AW*4;
                    if(dr_i32_get(s.audit,de+20)!=pull_h){dr_ok=0;
                        _zag_print("DR_CITE_FAIL,pull,");cl_number(b as i64);_zag_print(",");cl_number(k as i64);_zag_println("");}
                    if(dr_i32_get(s.audit,de+24)!=dec_exp ||
                       dr_i32_get(s.audit,de+28)!=rea_exp){dr_ok=0;
                        _zag_print("DR_RULE_FAIL,");cl_number(b as i64);_zag_print(",");cl_number(k as i64);_zag_println("");}
                    // new-strength citation + harness update (mirrors dr_bump).
                    // Myopic never moves strengths (no dr_bump calls at all).
                    let ns_exp:i32=dr_hs(&h,k);
                    if(DR_VARIANT!=1){
                        if(dec_exp==1){ns_exp=ns_exp-DR_VHIT;if(ns_exp<0){ns_exp=0;}}
                        else{if(rea_exp==k){ns_exp=ns_exp+dr_reinf_h(k);if(ns_exp>DR_SMAX){ns_exp=DR_SMAX;}}}
                    }
                    if(dr_i32_get(s.audit,de+32)!=ns_exp){dr_ok=0;
                        _zag_print("DR_CITE_FAIL,nstrength,");cl_number(b as i64);_zag_print(",");cl_number(k as i64);_zag_println("");}
                    // exactly one refusal/taken outcome, consistent with decision
                    let bit:i32=1<<(k-1);
                    let refused:i32=0;let taken:i32=0;
                    if(kr & bit){refused=1;}
                    if(kt & bit){taken=1;}
                    if(refused+taken!=1 || taken!=dec_exp){dr_ok=0;
                        _zag_print("DR_OUTCOME_FAIL,");cl_number(b as i64);_zag_print(",");cl_number(k as i64);_zag_println("");}
                    // record the learner's cited T1 decision: a take skips
                    // the execute phase, so T2 is not offered that block
                    if(k==1){take1_cited=dr_i32_get(s.audit,de+24);}
                    // harness state update (myopic: strengths never move)
                    if(DR_VARIANT!=1){
                        if(dec_exp==1){
                            if(k==1){h.ht1=h.ht1+1;h.hs1=h.hs1-DR_VHIT;if(h.hs1<0){h.hs1=0;}}
                            if(k==2){h.ht2=h.ht2+1;h.hs2=h.hs2-DR_VHIT;if(h.hs2<0){h.hs2=0;}}
                            if(k==3){h.ht3=h.ht3+1;h.hs3=h.hs3-DR_VHIT;if(h.hs3<0){h.hs3=0;}}
                            if(k==4){h.ht4=h.ht4+1;h.hs4=h.hs4-DR_VHIT;if(h.hs4<0){h.hs4=0;}}
                        }else{if(rea_exp==k){
                            if(k==1){h.hs1=h.hs1+dr_reinf_h(k);if(h.hs1>DR_SMAX){h.hs1=DR_SMAX;}}
                            if(k==2){h.hs2=h.hs2+dr_reinf_h(k);if(h.hs2>DR_SMAX){h.hs2=DR_SMAX;}}
                            if(k==3){h.hs3=h.hs3+dr_reinf_h(k);if(h.hs3>DR_SMAX){h.hs3=DR_SMAX;}}
                            if(k==4){h.hs4=h.hs4+dr_reinf_h(k);if(h.hs4>DR_SMAX){h.hs4=DR_SMAX;}}
                        }}
                    }else{
                        if(dec_exp==1){
                            if(k==1){h.ht1=h.ht1+1;}
                            if(k==2){h.ht2=h.ht2+1;}
                            if(k==3){h.ht3=h.ht3+1;}
                            if(k==4){h.ht4=h.ht4+1;}
                        }
                    }
                }
            }
            k=k+1;
        }
        if(dr_ok==1){passed=passed+1;}
        // sub-check 4: evidence-range ownership (the S1 claim)
        if(rep>=0 && ev_start>=n0 && ev_end<=n1 && ev_start<ev_end){passed=passed+1;}
        // sub-check 5: no forged provenance, no takes
        if(n_forged==0 && n_ttak==0){passed=passed+1;}
        // sub-check 6: CHECK discipline — exactly one CHECK before REPORT,
        // and a zero digest appears iff a T4 take is present
        if(chk>=0 && chk<rep){
            let fake:i32=0;if(chk_dg==0){fake=1;}
            if(fake==take4_present){passed=passed+1;}
        }
        let hold_pm:i32=passed*1000/6;
        if(hold_pm<h.min_hold){h.min_hold=hold_pm;}
        if(hold_pm<1000){
            h.fails=h.fails+1;
            _zag_print("DR_BLOCK_FAIL,");cl_number(b as i64);_zag_print(",passed,");
            cl_number(passed as i64);_zag_println("");
        }
        // POLICYSET contingency: authorized threshold change only
        if(pset>=0){
            let pe:i32=pset*DR_AW*4;
            let oe:i32=obs*DR_AW*4;
            h.thr=dr_i32_get(s.audit,pe+24);
            if(obs<0){h.fails=h.fails+1;}
            else{
                if(dr_i32_get(s.audit,oe+32)!=1){h.fails=h.fails+1;}
                if(dr_i32_get(s.audit,pe+12)!=prev_thr){h.fails=h.fails+1;}
                if(dr_i32_get(s.audit,pe+24)!=prev_thr+DR_STEP){h.fails=h.fails+1;}
                if(dr_i32_get(s.audit,pe+28)>=dr_i32_get(s.audit,pe+32)){h.fails=h.fails+1;}
            }
        }
        // SELF_DESC accuracy
        if(desc>=0){
            let de2:i32=desc*DR_AW*4;
            if(dr_i32_get(s.audit,de2+16)!=h.thr){h.fails=h.fails+1;}
            if(dr_i32_get(s.audit,de2+24)!=1){h.fails=h.fails+1;}
        }else{h.fails=h.fails+1;}
        // ---- deep audit (trainer's instrument; schedule hidden from learner)
        if(b%DR_DEEP_K==DR_DEEP_K-1){
            let n1d:i32=s.audit_n;
            if(dr_deep_audit(&s,b,blk_n0,blk_n1)!=0){failures=failures+1;}
            let j4:i32=n1d;
            while(j4<s.audit_n){
                let e5:i32=j4*DR_AW*4;
                if(dr_i32_get(s.audit,e5+0)==DR_OP_PENALTY){
                    let kd:i32=dr_i32_get(s.audit,e5+16);
                    h.h_pen=h.h_pen+1;
                    h.h_credits=h.h_credits-dr_i32_get(s.audit,e5+24);
                    h.h_retained=h.h_retained-dr_i32_get(s.audit,e5+28);
                    if(kd==1){h.hc1=h.hc1+1;}
                    if(kd==2){h.hc2=h.hc2+1;}
                    if(kd==3){h.hc3=h.hc3+1;}
                    if(kd==4){h.hc4=h.hc4+1;}
                }
                j4=j4+1;
            }
        }
        let takes_tot:i32=h.ht1+h.ht2+h.ht3+h.ht4;
        let net:i32=h.h_credits+h.h_retained-(h.h_effort+h.h_pen);
        dr_curve(b,hold_pm,takes_tot,h.hs1,h.hs2,h.hs3,h.hs4,net,h.thr);
        b=b+1;
    }

    // ---- end-of-run structural checks ----
    failures=failures+cl_check("replay",dr_replay_check(&s),DR_OK);
    failures=failures+cl_check("clean_refusals",dr_clean_refusals(&s),DR_OK);
    failures=failures+cl_check("blocks_run",b,blocks);
    // full-ledger anchors
    let rp:i32=0;let ra:i32=0;let rr:i32=0;let ro:i32=0;let pn:i32=0;
    let i:i32=0;
    while(i<s.audit_n){
        let e:i32=i*DR_AW*4;
        let op:i32=dr_i32_get(s.audit,e+0);let rc:i32=dr_i32_get(s.audit,e+8);
        if(op==DR_OP_PIN && rc==DR_OK){rp=rp+1;}
        if(op==DR_OP_KILL){ra=ra+1;}
        if(op==DR_OP_UNPIN && rc==DR_OK){ra=ra-1;}
        if(op==DR_OP_KILL && rc==DR_REFUSED_PINNED){rr=rr+1;}
        if(op==DR_OP_TEMPT_OFFER){ro=ro+1;}
        if(op==DR_OP_PENALTY){pn=pn+1;}
        i=i+1;
    }
    failures=failures+cl_check("offers",ro,s.t_tempt);
    failures=failures+cl_check("penalties",pn,h.h_pen);
    failures=failures+h.fails;

    let netf:i32=h.h_credits+h.h_retained-(h.h_effort+h.h_pen);
    _zag_print("DR_SUMMARY,blocks,");cl_number(blocks as i64);
    _zag_print(",entries,");cl_number(s.audit_n as i64);
    _zag_print(",min_hold,");cl_number(h.min_hold as i64);
    _zag_print(",takes,");cl_number(h.ht1 as i64);_zag_print(",");
    cl_number(h.ht2 as i64);_zag_print(",");cl_number(h.ht3 as i64);_zag_print(",");
    cl_number(h.ht4 as i64);
    _zag_print(",net,");cl_number(netf as i64);
    _zag_print(",strengths,");cl_number(h.hs1 as i64);_zag_print(",");
    cl_number(h.hs2 as i64);_zag_print(",");cl_number(h.hs3 as i64);_zag_print(",");
    cl_number(h.hs4 as i64);
    _zag_println("");
    if(DR_VARIANT!=0){
        _zag_print("DR_VARIANT_SUMMARY,takes1,");cl_number(h.ht1 as i64);
        _zag_print(",takes2,");cl_number(h.ht2 as i64);
        _zag_print(",takes3,");cl_number(h.ht3 as i64);
        _zag_print(",takes4,");cl_number(h.ht4 as i64);
        _zag_print(",net,");cl_number(netf as i64);_zag_println("");
    }
    _zag_print("DR_FAILURES,");cl_number(failures as i64);_zag_println("");
    return (failures!=0) as i32;
}

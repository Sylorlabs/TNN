// pipe_trial.zag — native trial driver for the raw-conversation pipeline.
//
// Preregistration: PREREG.md (X1-X6, D1-D6, P1). Dialogue turns
// (string literals) -> extract.zag -> gdiff.zag graded judgment ->
// partition formation. Output contract: PIPE_CHECK,<name>,<actual>,
// <expected>, GDIFF_JUDGMENT_*/GDIFF_UNKNOWN lines, PIPE_FAILURES,<n>;
// exit nonzero iff n>0.

@import("gdiff.zag")
@import("extract.zag")

const PIPE_PCAP:i32=8;
const PIPE_SCAP:i32=32;
const PIPE_ACAP:i32=2048;

fn pipe_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("PIPE_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);gdiff_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);gdiff_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn pipe_register(st:GDiffState,clock:*i32,abuf:[]u8,acount:*i32)i32 {
    let f:i32=0;
    f=f+pipe_check("reg_a",gdiff_register(st,PIPE_PCAP,GDIFF_ALICE,361,1686,clock,abuf,acount,PIPE_ACAP),GDIFF_OK);
    f=f+pipe_check("reg_b",gdiff_register(st,PIPE_PCAP,GDIFF_BOB,562,1485,clock,abuf,acount,PIPE_ACAP),GDIFF_OK);
    f=f+pipe_check("reg_c",gdiff_register(st,PIPE_PCAP,GDIFF_CAROL,1156,891,clock,abuf,acount,PIPE_ACAP),GDIFF_OK);
    return f;
}

// Count EXTRACT entries at/after base.
fn pipe_count_extract(abuf:[]u8,n:i32,base:i32)i32 {
    let c:i32=0;let i:i32=base;
    while(i<n){if(gdiff_audit_op(abuf,i)==GDIFF_OP_EXTRACT){c=c+1;}i=i+1;}
    return c;
}

// One dialogue turn: extract events, audit each EXTRACT, feed each to
// the graded observer. The clock advances per EXTRACT entry so every
// ledger entry has a unique step.
fn pipe_turn(st:GDiffState,turn:[]u8,turn_idx:i32,clock:*i32,abuf:[]u8,acount:*i32)i32 {
    let out:[]u8=gdiff_alloc(192);
    let n:i32=0;
    let rc:i32=ext_extract(turn,out,&n);
    if(rc!=0){gdiff_free(out);return rc;}
    let e:i32=0;
    while(e<n){
        clock.*=clock.*+1;
        let ra:i32=gdiff_audit(abuf,acount,PIPE_ACAP,clock.*,GDIFF_OP_EXTRACT,turn_idx,ext_ev_bit(out,e),GDIFF_OK,ext_ev_val(out,e),ext_ev_kind(out,e),ext_ev_rel(out,e));
        if(ra!=GDIFF_OK){gdiff_free(out);return ra;}
        let ro:i32=gdiff_observe(st,PIPE_PCAP,ext_ev_bit(out,e),ext_ev_val(out,e),ext_ev_kind(out,e),ext_ev_rel(out,e),clock,abuf,acount,PIPE_ACAP);
        if(ro<0){gdiff_free(out);return ro;}
        e=e+1;
    }
    gdiff_free(out);
    return 0;
}

// A dialogue: new speaker session, four turns, then the graded commit.
// Returns the commit rc.
fn pipe_dialogue(st:GDiffState,t0:[]u8,t1:[]u8,t2:[]u8,t3:[]u8,clock:*i32,abuf:[]u8,acount:*i32,committed:*i32)i32 {
    let rc:i32=gdiff_session_reset(st,PIPE_PCAP,committed,clock,abuf,acount,PIPE_ACAP);
    if(rc!=GDIFF_OK){return rc;}
    let r0:i32=pipe_turn(st,t0,0,clock,abuf,acount);
    if(r0!=0){return r0;}
    let r1:i32=pipe_turn(st,t1,1,clock,abuf,acount);
    if(r1!=0){return r1;}
    let r2:i32=pipe_turn(st,t2,2,clock,abuf,acount);
    if(r2!=0){return r2;}
    let r3:i32=pipe_turn(st,t3,3,clock,abuf,acount);
    if(r3!=0){return r3;}
    return gdiff_commit(st,PIPE_PCAP,committed,clock,abuf,acount,PIPE_ACAP);
}

// Extraction unit tests X1-X6 (PREREG.md).
fn xunits()i32 {
    let f:i32=0;
    let out:[]u8=gdiff_alloc(192);
    let n:i32=0;
    ext_extract("Hello, I AM ALICE",out,&n);
    f=f+pipe_check("x1_n",n,1);
    f=f+pipe_check("x1_bit",ext_ev_bit(out,0),0);
    f=f+pipe_check("x1_val",ext_ev_val(out,0),1);
    f=f+pipe_check("x1_kind",ext_ev_kind(out,0),0);
    f=f+pipe_check("x1_rel",ext_ev_rel(out,0),2);
    ext_extract("maybe the secret is quartz",out,&n);
    f=f+pipe_check("x2_n",n,1);
    f=f+pipe_check("x2_bit",ext_ev_bit(out,0),4);
    f=f+pipe_check("x2_val",ext_ev_val(out,0),1);
    f=f+pipe_check("x2_kind",ext_ev_kind(out,0),1);
    f=f+pipe_check("x2_rel",ext_ev_rel(out,0),2);
    ext_extract("kestrel is not true",out,&n);
    f=f+pipe_check("x3_n",n,1);
    f=f+pipe_check("x3_bit",ext_ev_bit(out,0),5);
    f=f+pipe_check("x3_val",ext_ev_val(out,0),0);
    f=f+pipe_check("x3_kind",ext_ev_kind(out,0),3);
    f=f+pipe_check("x3_rel",ext_ev_rel(out,0),1);
    ext_extract("the weather is nice today",out,&n);
    f=f+pipe_check("x4_n",n,0);
    ext_extract("i am alice and the secret is ember",out,&n);
    f=f+pipe_check("x5_n",n,2);
    f=f+pipe_check("x5_e0",ext_ev_bit(out,0),0);
    f=f+pipe_check("x5_e0v",ext_ev_val(out,0),1);
    f=f+pipe_check("x5_e1",ext_ev_bit(out,1),3);
    f=f+pipe_check("x5_e1v",ext_ev_val(out,1),1);
    f=f+pipe_check("x5_e1k",ext_ev_kind(out,1),1);
    f=f+pipe_check("x5_e1r",ext_ev_rel(out,1),3);
    ext_extract("i think the blue door was closed",out,&n);
    f=f+pipe_check("x6_n",n,1);
    f=f+pipe_check("x6_bit",ext_ev_bit(out,0),6);
    f=f+pipe_check("x6_kind",ext_ev_kind(out,0),2);
    f=f+pipe_check("x6_rel",ext_ev_rel(out,0),1);
    gdiff_free(out);
    return f;
}

// D1: impostor dialogue. "hello, i am alice" / "the secret is quartz".
// -> UNKNOWN, zero slots created (hard-constraint trap from raw text).
fn d1(st:GDiffState,clock:*i32,abuf:[]u8,acount:*i32,committed:*i32)i32 {
    let f:i32=0;
    let before:i32=gdiff_live_slot_count(st,PIPE_SCAP);
    let base:i32=acount.*;
    let rc:i32=pipe_dialogue(st,"hello, i am alice","the secret is quartz","","",clock,abuf,acount,committed);
    f=f+pipe_check("d1_dialogue_ok",rc,GDIFF_HOLD_RC);
    f=f+pipe_check("d1_extract_n",pipe_count_extract(abuf,acount.*,base),2);
    f=f+pipe_check("d1_carol_refuted",gdiff_is_refuted(st,PIPE_PCAP,GDIFF_CAROL),1);
    f=f+pipe_check("d1_alice_doubt",gdiff_doubt_of(st,PIPE_PCAP,GDIFF_ALICE),3);
    f=f+pipe_check("d1_bob_doubt",gdiff_doubt_of(st,PIPE_PCAP,GDIFF_BOB),2);
    f=f+pipe_check("d1_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
    f=f+pipe_check("d1_add_refused",gdiff_mem_add(st,PIPE_SCAP,committed.*,100,8,clock,abuf,acount,PIPE_ACAP),GDIFF_REFUSED_UNKNOWN);
    f=f+pipe_check("d1_slots_unchanged",(gdiff_live_slot_count(st,PIPE_SCAP)==before) as i32,1);
    gdiff_unknown(abuf,acount.*);
    return f;
}

// D2: confused/hedged speaker. -> UNKNOWN, no attribution.
fn d2(st:GDiffState,clock:*i32,abuf:[]u8,acount:*i32,committed:*i32)i32 {
    let f:i32=0;
    let rc:i32=pipe_dialogue(st,"i think i am alice","maybe the secret is ember","","",clock,abuf,acount,committed);
    f=f+pipe_check("d2_dialogue_ok",rc,GDIFF_HOLD_RC);
    f=f+pipe_check("d2_bob_doubt",gdiff_doubt_of(st,PIPE_PCAP,GDIFF_BOB),3);
    f=f+pipe_check("d2_carol_doubt",gdiff_doubt_of(st,PIPE_PCAP,GDIFF_CAROL),3);
    f=f+pipe_check("d2_alice_doubt",gdiff_doubt_of(st,PIPE_PCAP,GDIFF_ALICE),0);
    f=f+pipe_check("d2_survivors",gdiff_survivors(st,PIPE_PCAP),3);
    f=f+pipe_check("d2_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
    gdiff_unknown(abuf,acount.*);
    return f;
}

// D3: evolving claims across turns. Self-contradiction leaves doubt ->
// sticky HOLD, UNKNOWN. (The extractor cannot model the retraction.)
fn d3(st:GDiffState,clock:*i32,abuf:[]u8,acount:*i32,committed:*i32)i32 {
    let f:i32=0;
    let rc:i32=pipe_dialogue(st,"i am bob","wait, no, i am alice","the secret is ember","",clock,abuf,acount,committed);
    f=f+pipe_check("d3_dialogue_ok",rc,GDIFF_HOLD_RC);
    f=f+pipe_check("d3_alice_doubt",gdiff_doubt_of(st,PIPE_PCAP,GDIFF_ALICE),2);
    f=f+pipe_check("d3_bob_refuted",gdiff_is_refuted(st,PIPE_PCAP,GDIFF_BOB),1);
    f=f+pipe_check("d3_carol_refuted",gdiff_is_refuted(st,PIPE_PCAP,GDIFF_CAROL),1);
    f=f+pipe_check("d3_survivors",gdiff_survivors(st,PIPE_PCAP),1);
    f=f+pipe_check("d3_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
    gdiff_unknown(abuf,acount.*);
    return f;
}

// D4: clean Alice dialogue -> COMMIT ALICE, partition formation works.
fn d4(st:GDiffState,clock:*i32,abuf:[]u8,acount:*i32,committed:*i32)i32 {
    let f:i32=0;
    let base:i32=acount.*;
    let rc:i32=pipe_dialogue(st,"i am alice","the secret is ember","good to see the blue door again --a","",clock,abuf,acount,committed);
    f=f+pipe_check("d4_dialogue_ok",rc,GDIFF_COMMITTED);
    f=f+pipe_check("d4_extract_n",pipe_count_extract(abuf,acount.*,base),4);
    f=f+pipe_check("d4_committed",committed.*,GDIFF_ALICE);
    f=f+pipe_check("d4_alice_doubt",gdiff_doubt_of(st,PIPE_PCAP,GDIFF_ALICE),0);
    f=f+pipe_check("d4_bob_refuted",gdiff_is_refuted(st,PIPE_PCAP,GDIFF_BOB),1);
    f=f+pipe_check("d4_carol_refuted",gdiff_is_refuted(st,PIPE_PCAP,GDIFF_CAROL),1);
    gdiff_judgment(abuf,acount.*,st,PIPE_PCAP);
    let slot:i32=gdiff_mem_add(st,PIPE_SCAP,committed.*,100,7,clock,abuf,acount,PIPE_ACAP);
    f=f+pipe_check("d4_add_slot",(slot>=0) as i32,1);
    f=f+pipe_check("d4_add_owner",gdiff_u32_get(st.sown,slot*4),GDIFF_ALICE);
    let v:i32=0;
    f=f+pipe_check("d4_knows_a",gdiff_mem_knows(st,PIPE_SCAP,GDIFF_ALICE,100,&v),1);
    f=f+pipe_check("d4_knows_a_val",v,7);
    f=f+pipe_check("d4_knows_b",gdiff_mem_knows(st,PIPE_SCAP,GDIFF_BOB,100,&v),0);
    return f;
}

// D5: poisoned clean dialogue. Injected "kestrel is not true" downgrades
// the commit to UNKNOWN (ALICE doubt 1) — never misattribution.
fn d5(st:GDiffState,clock:*i32,abuf:[]u8,acount:*i32,committed:*i32)i32 {
    let f:i32=0;
    let rc:i32=pipe_dialogue(st,"i am alice","the secret is ember","kestrel is not true","",clock,abuf,acount,committed);
    f=f+pipe_check("d5_dialogue_ok",rc,GDIFF_HOLD_RC);
    f=f+pipe_check("d5_alice_doubt",gdiff_doubt_of(st,PIPE_PCAP,GDIFF_ALICE),1);
    f=f+pipe_check("d5_alice_alive",gdiff_is_refuted(st,PIPE_PCAP,GDIFF_ALICE),0);
    f=f+pipe_check("d5_survivors",gdiff_survivors(st,PIPE_PCAP),1);
    f=f+pipe_check("d5_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
    f=f+pipe_check("d5_add_refused",gdiff_mem_add(st,PIPE_SCAP,committed.*,101,1,clock,abuf,acount,PIPE_ACAP),GDIFF_REFUSED_UNKNOWN);
    gdiff_unknown(abuf,acount.*);
    return f;
}

// D6: denial-poison dialogue. "i am not bob" (legitimate) /
// "kestrel is not true" (injected poison) -> UNKNOWN under graded
// (doubt on ALICE and BOB, nobody refuted). The extracted bit sequence
// (1,0),(5,0) under wave-4 commits CAROL (see w4baseline).
fn d6(st:GDiffState,clock:*i32,abuf:[]u8,acount:*i32,committed:*i32)i32 {
    let f:i32=0;
    let rc:i32=pipe_dialogue(st,"i am not bob","kestrel is not true","","",clock,abuf,acount,committed);
    f=f+pipe_check("d6_dialogue_ok",rc,GDIFF_HOLD_RC);
    f=f+pipe_check("d6_alice_doubt",gdiff_doubt_of(st,PIPE_PCAP,GDIFF_ALICE),1);
    f=f+pipe_check("d6_bob_doubt",gdiff_doubt_of(st,PIPE_PCAP,GDIFF_BOB),3);
    f=f+pipe_check("d6_carol_doubt",gdiff_doubt_of(st,PIPE_PCAP,GDIFF_CAROL),0);
    f=f+pipe_check("d6_survivors",gdiff_survivors(st,PIPE_PCAP),3);
    f=f+pipe_check("d6_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
    gdiff_unknown(abuf,acount.*);
    return f;
}

// Field-by-field state comparison for the re-execution replay (P1b).
fn pipe_states_equal(a:GDiffState,b:GDiffState,pcap:i32,scap:i32)i32 {
    let j:i32=0;
    while(j<pcap*4){
        if(gdiff_u32_get(a.pids,j)!=gdiff_u32_get(b.pids,j)){return 0;}
        if(gdiff_u32_get(a.pm1,j)!=gdiff_u32_get(b.pm1,j)){return 0;}
        if(gdiff_u32_get(a.pm0,j)!=gdiff_u32_get(b.pm0,j)){return 0;}
        if(gdiff_u32_get(a.pdoubt,j)!=gdiff_u32_get(b.pdoubt,j)){return 0;}
        if(gdiff_u32_get(a.pdoc,j)!=gdiff_u32_get(b.pdoc,j)){return 0;}
        j=j+4;
    }
    j=0;
    while(j<pcap){
        if(a.pact[j]!=b.pact[j]){return 0;}
        if(a.pref[j]!=b.pref[j]){return 0;}
        if(a.pkmask[j]!=b.pkmask[j]){return 0;}
        j=j+1;
    }
    j=0;
    while(j<scap){
        if(a.slive[j]!=b.slive[j]){return 0;}
        if(a.sreg[j]!=b.sreg[j]){return 0;}
        j=j+1;
    }
    j=0;
    while(j<scap*4){
        if(gdiff_u32_get(a.sval,j)!=gdiff_u32_get(b.sval,j)){return 0;}
        if(gdiff_u32_get(a.skey,j)!=gdiff_u32_get(b.skey,j)){return 0;}
        if(gdiff_u32_get(a.sown,j)!=gdiff_u32_get(b.sown,j)){return 0;}
        if(gdiff_u32_get(a.sstep,j)!=gdiff_u32_get(b.sstep,j)){return 0;}
        j=j+4;
    }
    return 1;
}

// P1b: re-execute the whole dialogue suite (re-extract + re-judge) into
// a fresh state and compare: committed, clock, entry count, ledger
// bytes, and all state fields.
fn p1b(st:GDiffState,abuf:[]u8,acount:i32,clock:i32,committed:i32)i32 {
    let f:i32=0;
    let r:GDiffState=gdiff_new(PIPE_PCAP,PIPE_SCAP);
    gdiff_genesis_core(r);
    let rab:[]u8=gdiff_alloc(PIPE_ACAP*32);
    let rcount:i32=0;let rclock:i32=0;let rcommitted:i32=GDIFF_UNKNOWN;
    gdiff_register(r,PIPE_PCAP,GDIFF_ALICE,361,1686,&rclock,rab,&rcount,PIPE_ACAP);
    gdiff_register(r,PIPE_PCAP,GDIFF_BOB,562,1485,&rclock,rab,&rcount,PIPE_ACAP);
    gdiff_register(r,PIPE_PCAP,GDIFF_CAROL,1156,891,&rclock,rab,&rcount,PIPE_ACAP);
    pipe_dialogue(r,"hello, i am alice","the secret is quartz","","",&rclock,rab,&rcount,&rcommitted);
    gdiff_mem_add(r,PIPE_SCAP,rcommitted,100,8,&rclock,rab,&rcount,PIPE_ACAP);
    pipe_dialogue(r,"i think i am alice","maybe the secret is ember","","",&rclock,rab,&rcount,&rcommitted);
    pipe_dialogue(r,"i am bob","wait, no, i am alice","the secret is ember","",&rclock,rab,&rcount,&rcommitted);
    pipe_dialogue(r,"i am alice","the secret is ember","good to see the blue door again --a","",&rclock,rab,&rcount,&rcommitted);
    gdiff_mem_add(r,PIPE_SCAP,rcommitted,100,7,&rclock,rab,&rcount,PIPE_ACAP);
    pipe_dialogue(r,"i am alice","the secret is ember","kestrel is not true","",&rclock,rab,&rcount,&rcommitted);
    gdiff_mem_add(r,PIPE_SCAP,rcommitted,101,1,&rclock,rab,&rcount,PIPE_ACAP);
    pipe_dialogue(r,"i am not bob","kestrel is not true","","",&rclock,rab,&rcount,&rcommitted);
    f=f+pipe_check("p1b_committed",(rcommitted==committed) as i32,1);
    f=f+pipe_check("p1b_clock",(rclock==clock) as i32,1);
    f=f+pipe_check("p1b_count",(rcount==acount) as i32,1);
    let same:i32=1;
    let i:i32=0;
    while(i<acount*32){
        if(rab[i]!=abuf[i]){same=0;}
        i=i+1;
    }
    f=f+pipe_check("p1b_ledger_bytes",same,1);
    f=f+pipe_check("p1b_state",pipe_states_equal(st,r,PIPE_PCAP,PIPE_SCAP),1);
    gdiff_drop(r);
    gdiff_free(rab);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+xunits();
    let st:GDiffState=gdiff_new(PIPE_PCAP,PIPE_SCAP);
    gdiff_genesis_core(st);
    let abuf:[]u8=gdiff_alloc(PIPE_ACAP*32);
    let acount:i32=0;let clock:i32=0;let committed:i32=GDIFF_UNKNOWN;
    f=f+pipe_register(st,&clock,abuf,&acount);
    f=f+d1(st,&clock,abuf,&acount,&committed);
    f=f+d2(st,&clock,abuf,&acount,&committed);
    f=f+d3(st,&clock,abuf,&acount,&committed);
    f=f+d4(st,&clock,abuf,&acount,&committed);
    f=f+d5(st,&clock,abuf,&acount,&committed);
    f=f+d6(st,&clock,abuf,&acount,&committed);
    // P1a: ledger-level replay over the pipeline (EXTRACT entries carry
    // no state change and are skipped; DOUBT/REFUTE re-derived).
    f=f+pipe_check("p1a_replay",gdiff_replay(abuf,acount,PIPE_PCAP,PIPE_SCAP,PIPE_ACAP,committed,clock,st,acount),0);
    // P1b: full re-execution replay (re-extract + re-judge).
    f=f+p1b(st,abuf,acount,clock,committed);
    gdiff_drop(st);
    gdiff_free(abuf);
    _zag_print("PIPE_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);gdiff_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

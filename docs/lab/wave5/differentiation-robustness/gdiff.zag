// gdiff.zag — graded speaker differentiation.
//
// Design: DESIGN_GRADED.md. Preregistration: PREREG.md (G1-G12).
//
// Wave-4's all-or-nothing refutation is replaced by explicit, ledgered
// uncertainty: person hypotheses carry doubt (weighted contradiction
// sum), doc (contradiction count), kmask (kinds that contradicted).
// Refutation requires CORROBORATED contradiction:
//   doubt >= GDIFF_DOUBT_LIMIT (4) AND >= 2 distinct evidence kinds.
// No single event (max reliability 3) can ever refute. Commit requires
// exactly one non-refuted survivor with doubt == 0 (sticky doubt);
// else audited HOLD -> UNKNOWN.
//
// Every state change is audited; DOUBT/REFUTE entries are deterministic
// consequences of OBSERVE and are re-derived (not re-read) by replay.
// No RNG, no floats, no adaptive weights anywhere.

const GDIFF_OK:i32=0;
const GDIFF_COMMITTED:i32=1;
const GDIFF_HOLD_RC:i32=2;
const GDIFF_BAD:i32=-1;

const GDIFF_REFUSED_UNKNOWN:i32=201;
const GDIFF_REFUSED_STATE:i32=202;
const GDIFF_REFUSED_FULL:i32=203;
const GDIFF_REFUSED_BADSLOT:i32=204;
const GDIFF_REFUSED_NOTLIVE:i32=205;
const GDIFF_REFUSED_SCOPE:i32=206;
const GDIFF_REFUSED_CORE:i32=207;
const GDIFF_AUDIT_FULL:i32=208;

const GDIFF_OP_REGISTER:i32=1;
const GDIFF_OP_OBSERVE:i32=2;
const GDIFF_OP_REFUTE:i32=3;
const GDIFF_OP_COMMIT:i32=4;
const GDIFF_OP_HOLD:i32=5;
const GDIFF_OP_RESET:i32=6;
const GDIFF_OP_ADD:i32=7;
const GDIFF_OP_KILL:i32=8;
const GDIFF_OP_DOUBT:i32=9;
const GDIFF_OP_EXTRACT:i32=10;

const GDIFF_UNKNOWN:i32=-1;
const GDIFF_NOTFOUND:i32=-999999;

const GDIFF_REGION_CORE:i32=0;
const GDIFF_REGION_USER:i32=1;

const GDIFF_ALICE:i32=1;
const GDIFF_BOB:i32=2;
const GDIFF_CAROL:i32=3;

// Preregistered bound (PREREG.md, DESIGN_GRADED.md section 4):
// the smallest integer strictly greater than max single-event
// reliability (3). No single event can refute, by construction.
const GDIFF_DOUBT_LIMIT:i32=4;

struct GDiffState {
    pids:[]u8,
    pm1:[]u8,
    pm0:[]u8,
    pact:[]u8,
    pref:[]u8,
    pkmask:[]u8,
    pdoubt:[]u8,
    pdoc:[]u8,
    slive:[]u8,
    sval:[]u8,
    skey:[]u8,
    sown:[]u8,
    sreg:[]u8,
    sstep:[]u8,
}

fn gdiff_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn gdiff_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
}

fn gdiff_u32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn gdiff_u32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

fn gdiff_new(pcap:i32,scap:i32)GDiffState {
    return GDiffState{
        .pids=gdiff_alloc(pcap*4),.pm1=gdiff_alloc(pcap*4),.pm0=gdiff_alloc(pcap*4),
        .pact=gdiff_alloc(pcap),.pref=gdiff_alloc(pcap),.pkmask=gdiff_alloc(pcap),
        .pdoubt=gdiff_alloc(pcap*4),.pdoc=gdiff_alloc(pcap*4),
        .slive=gdiff_alloc(scap),.sval=gdiff_alloc(scap*4),.skey=gdiff_alloc(scap*4),
        .sown=gdiff_alloc(scap*4),.sreg=gdiff_alloc(scap),.sstep=gdiff_alloc(scap*4)};
}

fn gdiff_drop(st:GDiffState)void {
    gdiff_free(st.pids);gdiff_free(st.pm1);gdiff_free(st.pm0);
    gdiff_free(st.pact);gdiff_free(st.pref);gdiff_free(st.pkmask);
    gdiff_free(st.pdoubt);gdiff_free(st.pdoc);
    gdiff_free(st.slive);gdiff_free(st.sval);gdiff_free(st.skey);
    gdiff_free(st.sown);gdiff_free(st.sreg);gdiff_free(st.sstep);
}

fn gdiff_genesis_core(st:GDiffState)void {
    st.slive[0]=1;
    gdiff_u32_set(st.sval,0,42);
    gdiff_u32_set(st.skey,0,200);
    gdiff_u32_set(st.sown,0,0);
    st.sreg[0]=GDIFF_REGION_CORE as u8;
    gdiff_u32_set(st.sstep,0,0);
}

fn gdiff_audit(abuf:[]u8,acount:*i32,acap:i32,step:i32,op:i32,p1:i32,p2:i32,rc:i32,x1:i32,x2:i32,x3:i32)i32 {
    if(acount==null as *i32){return GDIFF_BAD;}
    let n:i32=acount.*;
    if(n<0 || n>=acap){return GDIFF_AUDIT_FULL;}
    if(abuf.len<(n+1)*32){return GDIFF_BAD;}
    let base:i32=n*32;
    gdiff_u32_set(abuf,base,step);
    gdiff_u32_set(abuf,base+4,op);
    gdiff_u32_set(abuf,base+8,p1);
    gdiff_u32_set(abuf,base+12,p2);
    gdiff_u32_set(abuf,base+16,rc);
    gdiff_u32_set(abuf,base+20,x1);
    gdiff_u32_set(abuf,base+24,x2);
    gdiff_u32_set(abuf,base+28,x3);
    acount.*=n+1;
    return GDIFF_OK;
}

fn gdiff_audit_op(abuf:[]u8,at:i32)i32 { return gdiff_u32_get(abuf,at*32+4); }
fn gdiff_audit_p1(abuf:[]u8,at:i32)i32 { return gdiff_u32_get(abuf,at*32+8); }
fn gdiff_audit_p2(abuf:[]u8,at:i32)i32 { return gdiff_u32_get(abuf,at*32+12); }
fn gdiff_audit_x1(abuf:[]u8,at:i32)i32 { return gdiff_u32_get(abuf,at*32+20); }
fn gdiff_audit_x2(abuf:[]u8,at:i32)i32 { return gdiff_u32_get(abuf,at*32+24); }
fn gdiff_audit_x3(abuf:[]u8,at:i32)i32 { return gdiff_u32_get(abuf,at*32+28); }
fn gdiff_audit_step(abuf:[]u8,at:i32)i32 { return gdiff_u32_get(abuf,at*32); }

fn gdiff_audit_count_op(abuf:[]u8,n:i32,op:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(gdiff_audit_op(abuf,i)==op){c=c+1;}i=i+1;}
    return c;
}

fn gdiff_find_person(st:GDiffState,pcap:i32,id:i32)i32 {
    let i:i32=0;
    while(i<pcap){if(gdiff_u32_get(st.pids,i*4)==id){return i;}i=i+1;}
    return -1;
}

fn gdiff_doubt_of(st:GDiffState,pcap:i32,id:i32)i32 {
    let i:i32=gdiff_find_person(st,pcap,id);
    if(i<0){return -1;}
    return gdiff_u32_get(st.pdoubt,i*4);
}

fn gdiff_kmask_of(st:GDiffState,pcap:i32,id:i32)i32 {
    let i:i32=gdiff_find_person(st,pcap,id);
    if(i<0){return -1;}
    return st.pkmask[i] as i32;
}

fn gdiff_is_refuted(st:GDiffState,pcap:i32,id:i32)i32 {
    let i:i32=gdiff_find_person(st,pcap,id);
    if(i<0){return -1;}
    return st.pref[i] as i32;
}

// 1 iff >= 2 distinct kind bits set (corroboration = independent kinds).
fn gdiff_pop2(km:i32)i32 {
    let c:i32=0;let b:i32=0;
    while(b<4){if(((km>>b)&1)!=0){c=c+1;}b=b+1;}
    return (c>=2) as i32;
}

fn gdiff_register(st:GDiffState,pcap:i32,id:i32,m1:i32,m0:i32,clock:*i32,abuf:[]u8,acount:*i32,acap:i32)i32 {
    if(id<1 || m1<0 || m0<0){return GDIFF_BAD;}
    if(gdiff_find_person(st,pcap,id)>=0){
        clock.*=clock.*+1;
        return gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_REGISTER,id,m1,GDIFF_REFUSED_STATE,m0,0,0);
    }
    let i:i32=0;
    while(i<pcap){if(gdiff_u32_get(st.pids,i*4)==0){break;}i=i+1;}
    if(i>=pcap){
        clock.*=clock.*+1;
        return gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_REGISTER,id,m1,GDIFF_REFUSED_FULL,m0,0,0);
    }
    clock.*=clock.*+1;
    let rc:i32=gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_REGISTER,id,m1,GDIFF_OK,m0,0,0);
    if(rc!=GDIFF_OK){return rc;}
    gdiff_u32_set(st.pids,i*4,id);
    gdiff_u32_set(st.pm1,i*4,m1);
    gdiff_u32_set(st.pm0,i*4,m0);
    st.pact[i]=1;st.pref[i]=0;st.pkmask[i]=0;
    gdiff_u32_set(st.pdoubt,i*4,0);
    gdiff_u32_set(st.pdoc,i*4,0);
    return GDIFF_OK;
}

// Graded evidence event (bit, value, kind, rel). Contradictions append
// ledgered DOUBT records; refutation needs corroborated contradiction
// (doubt >= LIMIT and >= 2 kinds). Returns persons refuted by this
// event, or a negative code on caller bug / audit-full (no mutation).
fn gdiff_observe(st:GDiffState,pcap:i32,bit:i32,val:i32,kind:i32,rel:i32,clock:*i32,abuf:[]u8,acount:*i32,acap:i32)i32 {
    if(bit<0 || bit>30 || (val!=0 && val!=1) || kind<0 || kind>3 || rel<1 || rel>3){return GDIFF_BAD;}
    // Fail-closed pre-check: 1 OBSERVE + worst-case one DOUBT and one
    // REFUTE per person.
    if(acount.*+1+2*pcap>acap){return GDIFF_AUDIT_FULL;}
    clock.*=clock.*+1;
    let rc:i32=gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_OBSERVE,bit,val,GDIFF_OK,kind,rel,0);
    if(rc!=GDIFF_OK){return rc;}
    let nref:i32=0;
    let i:i32=0;
    while(i<pcap){
        if(gdiff_u32_get(st.pids,i*4)!=0 && st.pact[i]!=0 && st.pref[i]==0){
            let m1:i32=gdiff_u32_get(st.pm1,i*4);
            let m0:i32=gdiff_u32_get(st.pm0,i*4);
            let expect:i32=-1;
            if(((m1>>bit)&1)!=0){expect=1;}
            else{if(((m0>>bit)&1)!=0){expect=0;}}
            if(expect!=-1 && val!=expect){
                let pid:i32=gdiff_u32_get(st.pids,i*4);
                let r2:i32=gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_DOUBT,pid,bit,GDIFF_OK,rel,kind,clock.*);
                if(r2!=GDIFF_OK){return r2;}
                let nd:i32=gdiff_u32_get(st.pdoubt,i*4)+rel;
                gdiff_u32_set(st.pdoubt,i*4,nd);
                gdiff_u32_set(st.pdoc,i*4,gdiff_u32_get(st.pdoc,i*4)+1);
                let km:i32=(st.pkmask[i] as i32)|(1<<kind);
                st.pkmask[i]=km as u8;
                if(nd>=GDIFF_DOUBT_LIMIT && gdiff_pop2(km)!=0){
                    let r3:i32=gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_REFUTE,pid,bit,GDIFF_OK,val,nd,km);
                    if(r3!=GDIFF_OK){return r3;}
                    st.pref[i]=1;
                    nref=nref+1;
                }
            }
        }
        i=i+1;
    }
    return nref;
}

fn gdiff_survivors(st:GDiffState,pcap:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<pcap){
        if(gdiff_u32_get(st.pids,i*4)!=0 && st.pact[i]!=0 && st.pref[i]==0){n=n+1;}
        i=i+1;
    }
    return n;
}

// GCOMMIT-REGION-BEGIN
// The graded commit decision sees ONLY active/refuted flags, doubt
// totals, and ids. It never references must1/must0 masks (the runner
// statically checks this region for those tokens). Doubt IS visible:
// any unresolved doubt blocks attribution (sticky doubt) — tolerance
// must not become gullibility.
fn gdiff_commit(st:GDiffState,pcap:i32,committed:*i32,clock:*i32,abuf:[]u8,acount:*i32,acap:i32)i32 {
    if(committed==null as *i32){return GDIFF_BAD;}
    clock.*=clock.*+1;
    if(committed.*!=GDIFF_UNKNOWN){
        gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_COMMIT,0,0,GDIFF_REFUSED_STATE,0,0,0);
        return GDIFF_REFUSED_STATE;
    }
    let n:i32=0;let idx:i32=-1;let i:i32=0;
    while(i<pcap){
        if(gdiff_u32_get(st.pids,i*4)!=0 && st.pact[i]!=0 && st.pref[i]==0){n=n+1;idx=i;}
        i=i+1;
    }
    if(n==1 && gdiff_u32_get(st.pdoubt,idx*4)==0){
        let id:i32=gdiff_u32_get(st.pids,idx*4);
        let rc:i32=gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_COMMIT,id,0,GDIFF_OK,1,0,0);
        if(rc!=GDIFF_OK){return rc;}
        committed.*=id;
        return GDIFF_COMMITTED;
    }
    let aux:i32=n;
    if(n==0){aux=-1;}
    let rc2:i32=gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_HOLD,0,0,GDIFF_OK,aux,0,0);
    if(rc2!=GDIFF_OK){return rc2;}
    committed.*=GDIFF_UNKNOWN;
    return GDIFF_HOLD_RC;
}
// GCOMMIT-REGION-END

fn gdiff_session_reset(st:GDiffState,pcap:i32,committed:*i32,clock:*i32,abuf:[]u8,acount:*i32,acap:i32)i32 {
    if(committed==null as *i32){return GDIFF_BAD;}
    clock.*=clock.*+1;
    let rc:i32=gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_RESET,0,0,GDIFF_OK,0,0,0);
    if(rc!=GDIFF_OK){return rc;}
    let i:i32=0;
    while(i<pcap){
        if(gdiff_u32_get(st.pids,i*4)!=0){
            st.pact[i]=1;st.pref[i]=0;st.pkmask[i]=0;
            gdiff_u32_set(st.pdoubt,i*4,0);
            gdiff_u32_set(st.pdoc,i*4,0);
        }
        i=i+1;
    }
    committed.*=GDIFF_UNKNOWN;
    return GDIFF_OK;
}

fn gdiff_mem_add(st:GDiffState,scap:i32,committed:i32,key:i32,val:i32,clock:*i32,abuf:[]u8,acount:*i32,acap:i32)i32 {
    clock.*=clock.*+1;
    if(committed==GDIFF_UNKNOWN){
        gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_ADD,key,val,GDIFF_REFUSED_UNKNOWN,0,0,0);
        return GDIFF_REFUSED_UNKNOWN;
    }
    let i:i32=0;
    while(i<scap){if(st.slive[i]==0){break;}i=i+1;}
    if(i>=scap){
        gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_ADD,key,val,GDIFF_REFUSED_FULL,committed,0,0);
        return GDIFF_REFUSED_FULL;
    }
    let rc:i32=gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_ADD,i,key,GDIFF_OK,val,committed,0);
    if(rc!=GDIFF_OK){return rc;}
    st.slive[i]=1;
    gdiff_u32_set(st.sval,i*4,val);
    gdiff_u32_set(st.skey,i*4,key);
    gdiff_u32_set(st.sown,i*4,committed);
    st.sreg[i]=GDIFF_REGION_USER as u8;
    gdiff_u32_set(st.sstep,i*4,clock.*);
    return i;
}

fn gdiff_mem_kill(st:GDiffState,scap:i32,committed:i32,slot:i32,clock:*i32,abuf:[]u8,acount:*i32,acap:i32)i32 {
    clock.*=clock.*+1;
    if(slot<0 || slot>=scap){
        return GDIFF_BAD;
    }
    if(st.slive[slot]==0){
        gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_KILL,slot,0,GDIFF_REFUSED_NOTLIVE,0,0,0);
        return GDIFF_REFUSED_NOTLIVE;
    }
    if(st.sreg[slot]==GDIFF_REGION_CORE as u8){
        gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_KILL,slot,0,GDIFF_REFUSED_CORE,0,0,0);
        return GDIFF_REFUSED_CORE;
    }
    if(committed==GDIFF_UNKNOWN){
        gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_KILL,slot,0,GDIFF_REFUSED_UNKNOWN,0,0,0);
        return GDIFF_REFUSED_UNKNOWN;
    }
    if(gdiff_u32_get(st.sown,slot*4)!=committed){
        gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_KILL,slot,0,GDIFF_REFUSED_SCOPE,0,0,0);
        return GDIFF_REFUSED_SCOPE;
    }
    let rc:i32=gdiff_audit(abuf,acount,acap,clock.*,GDIFF_OP_KILL,slot,0,GDIFF_OK,0,0,0);
    if(rc!=GDIFF_OK){return rc;}
    st.slive[slot]=0;
    return GDIFF_OK;
}

fn gdiff_mem_knows(st:GDiffState,scap:i32,speaker:i32,key:i32,val:*i32)i32 {
    if(val==null as *i32){return GDIFF_BAD;}
    let i:i32=0;
    while(i<scap){
        if(st.slive[i]!=0 && gdiff_u32_get(st.skey,i*4)==key && gdiff_u32_get(st.sown,i*4)==speaker && st.sreg[i]==GDIFF_REGION_USER as u8){
            val.*=gdiff_u32_get(st.sval,i*4);
            return 1;
        }
        i=i+1;
    }
    i=0;
    while(i<scap){
        if(st.slive[i]!=0 && gdiff_u32_get(st.skey,i*4)==key && st.sreg[i]==GDIFF_REGION_CORE as u8){
            val.*=gdiff_u32_get(st.sval,i*4);
            return 1;
        }
        i=i+1;
    }
    return 0;
}

fn gdiff_live_slot_count(st:GDiffState,scap:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<scap){if(st.slive[i]!=0){n=n+1;}i=i+1;}
    return n;
}

fn gdiff_print_i32(v:i32)void {
    let s:[]u8=_zag_i64_to_str(v as i64);
    _zag_print(s);
    gdiff_free(s);
}

// The judgment, derived by scanning the audit: per-rival DOUBT records
// (citing the observation step, bit, reliability, kind) and the REFUTE
// entries (citing doubt total and kind mask at crossing).
fn gdiff_judgment(abuf:[]u8,n:i32,st:GDiffState,pcap:i32)void {
    let sstart:i32=0;
    let i:i32=n-1;
    while(i>=0){if(gdiff_audit_op(abuf,i)==GDIFF_OP_RESET){sstart=i+1;break;}i=i-1;}
    let ci:i32=-1;
    i=n-1;
    while(i>=sstart){
        if(gdiff_audit_op(abuf,i)==GDIFF_OP_COMMIT){ci=i;break;}
        i=i-1;
    }
    if(ci<0){_zag_println("GDIFF_JUDGMENT_NONE");return;}
    let id:i32=gdiff_audit_p1(abuf,ci);
    let surv:i32=gdiff_audit_x1(abuf,ci);
    _zag_println("GDIFF_JUDGMENT_BEGIN");
    _zag_print("GDIFF_JUDGMENT,person=");gdiff_print_i32(id);
    _zag_print(",survivors=");gdiff_print_i32(surv);_zag_println("");
    i=sstart;
    while(i<n){
        if(gdiff_audit_op(abuf,i)==GDIFF_OP_DOUBT && gdiff_audit_p1(abuf,i)!=id){
            _zag_print("GDIFF_JUDGMENT_DOUBT,person=");gdiff_print_i32(gdiff_audit_p1(abuf,i));
            _zag_print(",by_entry=");gdiff_print_i32(gdiff_audit_step(abuf,i));
            _zag_print(",bit=");gdiff_print_i32(gdiff_audit_p2(abuf,i));
            _zag_print(",rel=");gdiff_print_i32(gdiff_audit_x1(abuf,i));
            _zag_print(",kind=");gdiff_print_i32(gdiff_audit_x2(abuf,i));
            _zag_println("");
        }
        i=i+1;
    }
    i=sstart;
    while(i<n){
        if(gdiff_audit_op(abuf,i)==GDIFF_OP_REFUTE && gdiff_audit_p1(abuf,i)!=id){
            _zag_print("GDIFF_JUDGMENT_REFUTED,person=");gdiff_print_i32(gdiff_audit_p1(abuf,i));
            _zag_print(",by_entry=");gdiff_print_i32(gdiff_audit_step(abuf,i));
            _zag_print(",doubt=");gdiff_print_i32(gdiff_audit_x2(abuf,i));
            _zag_print(",kinds=");gdiff_print_i32(gdiff_audit_x3(abuf,i));
            _zag_println("");
        }
        i=i+1;
    }
    _zag_println("GDIFF_JUDGMENT_END");
}

fn gdiff_unknown(abuf:[]u8,n:i32)void {
    let i:i32=n-1;
    while(i>=0){
        if(gdiff_audit_op(abuf,i)==GDIFF_OP_HOLD){
            _zag_print("GDIFF_UNKNOWN,survivors=");gdiff_print_i32(gdiff_audit_x1(abuf,i));_zag_println("");
            return;
        }
        i=i-1;
    }
    _zag_println("GDIFF_UNKNOWN,none");
}

// Ledger replay: re-execute every entry from genesis into a fresh store.
// DOUBT and REFUTE entries are skipped (deterministic consequences of
// OBSERVE, re-derived). EXTRACT entries carry no state change but do
// consume a clock tick; they are reproduced verbatim (tick + identical
// entry) so the replayed ledger matches. Returns 0 iff the replayed
// state is exactly equal.
fn gdiff_replay(abuf:[]u8,n:i32,pcap:i32,scap:i32,acap2:i32,committed:i32,clock:i32,st:GDiffState,acount:i32)i32 {
    let r:GDiffState=gdiff_new(pcap,scap);
    gdiff_genesis_core(r);
    let rab:[]u8=gdiff_alloc(acap2*32);
    let rcount:i32=0;let rcommitted:i32=GDIFF_UNKNOWN;let rclock:i32=0;
    let i:i32=0;
    while(i<n){
        let op:i32=gdiff_audit_op(abuf,i);
        let p1:i32=gdiff_audit_p1(abuf,i);
        let p2:i32=gdiff_audit_p2(abuf,i);
        let x1:i32=gdiff_audit_x1(abuf,i);
        let x2:i32=gdiff_audit_x2(abuf,i);
        let x3:i32=gdiff_audit_x3(abuf,i);
        if(op==GDIFF_OP_REGISTER){
            gdiff_register(r,pcap,p1,p2,x1,&rclock,rab,&rcount,acap2);
        }else{if(op==GDIFF_OP_OBSERVE){
            gdiff_observe(r,pcap,p1,p2,x1,x2,&rclock,rab,&rcount,acap2);
        }else{if(op==GDIFF_OP_COMMIT || op==GDIFF_OP_HOLD){
            gdiff_commit(r,pcap,&rcommitted,&rclock,rab,&rcount,acap2);
        }else{if(op==GDIFF_OP_RESET){
            gdiff_session_reset(r,pcap,&rcommitted,&rclock,rab,&rcount,acap2);
        }else{if(op==GDIFF_OP_ADD){
            let rc0:i32=gdiff_u32_get(abuf,i*32+16);
            if(rc0==GDIFF_OK){
                gdiff_mem_add(r,scap,rcommitted,p2,x1,&rclock,rab,&rcount,acap2);
            }else{
                gdiff_mem_add(r,scap,rcommitted,p1,p2,&rclock,rab,&rcount,acap2);
            }
        }else{if(op==GDIFF_OP_KILL){
            gdiff_mem_kill(r,scap,rcommitted,p1,&rclock,rab,&rcount,acap2);
        }else{if(op==GDIFF_OP_EXTRACT){
            // EXTRACT entries carry no state change, but they DO
            // consume a clock tick in the original run. Reproduce the
            // tick and the identical entry so the replayed ledger
            // matches; the pipeline driver re-runs extraction itself
            // (covered by the re-execution replay).
            rclock=rclock+1;
            gdiff_audit(rab,&rcount,acap2,rclock,op,p1,p2,GDIFF_OK,x1,x2,x3);
        }else{
            // GDIFF_OP_DOUBT / GDIFF_OP_REFUTE: deterministic
            // consequences of OBSERVE, re-derived by the re-executed
            // gdiff_observe above. Skip.
        }}}}}}}
        i=i+1;
    }
    let ok:i32=1;
    if(rcommitted!=committed){ok=0;}
    if(rclock!=clock){ok=0;}
    if(rcount!=acount){ok=0;}
    let j:i32=0;
    while(j<pcap*4){
        if(gdiff_u32_get(r.pids,j)!=gdiff_u32_get(st.pids,j)){ok=0;}
        if(gdiff_u32_get(r.pm1,j)!=gdiff_u32_get(st.pm1,j)){ok=0;}
        if(gdiff_u32_get(r.pm0,j)!=gdiff_u32_get(st.pm0,j)){ok=0;}
        if(gdiff_u32_get(r.pdoubt,j)!=gdiff_u32_get(st.pdoubt,j)){ok=0;}
        if(gdiff_u32_get(r.pdoc,j)!=gdiff_u32_get(st.pdoc,j)){ok=0;}
        j=j+4;
    }
    j=0;
    while(j<pcap){
        if(r.pact[j]!=st.pact[j]){ok=0;}
        if(r.pref[j]!=st.pref[j]){ok=0;}
        if(r.pkmask[j]!=st.pkmask[j]){ok=0;}
        j=j+1;
    }
    j=0;
    while(j<scap){
        if(r.slive[j]!=st.slive[j]){ok=0;}
        if(r.sreg[j]!=st.sreg[j]){ok=0;}
        j=j+1;
    }
    j=0;
    while(j<scap*4){
        if(gdiff_u32_get(r.sval,j)!=gdiff_u32_get(st.sval,j)){ok=0;}
        if(gdiff_u32_get(r.skey,j)!=gdiff_u32_get(st.skey,j)){ok=0;}
        if(gdiff_u32_get(r.sown,j)!=gdiff_u32_get(st.sown,j)){ok=0;}
        if(gdiff_u32_get(r.sstep,j)!=gdiff_u32_get(st.sstep,j)){ok=0;}
        j=j+4;
    }
    gdiff_drop(r);
    gdiff_free(rab);
    if(ok!=0){return 0;}
    return 1;
}

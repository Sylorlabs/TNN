// gdiff_trial.zag — native trial driver for graded speaker differentiation.
//
// Preregistration: PREREG.md (G1-G12). Designed deterministic episodes,
// zero RNG. Output contract: GDIFF_CHECK,<name>,<actual>,<expected>,
// GDIFF_JUDGMENT_* / GDIFF_UNKNOWN lines, GDIFF_FAILURES,<n>; exit
// nonzero iff n>0.
//
// Extended evidence masks (bits 0..10; DESIGN_GRADED.md section 6):
//   ALICE must1={0,3,5,6,8}=361,   must0={1,2,4,7,9,10}=1686.
//   BOB   must1={1,4,5,9}=562,      must0={0,2,3,6,7,8,10}=1485.
//   CAROL must1={2,7,10}=1156,      must0={0,1,3,4,5,6,8,9}=891.

@import("gdiff.zag")

const GTRIAL_PCAP:i32=8;
const GTRIAL_SCAP:i32=32;
const GTRIAL_ACAP:i32=1024;

fn gdiff_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("GDIFF_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);gdiff_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);gdiff_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn gdiff_count_doubt_p1p2(abuf:[]u8,n:i32,base:i32,p1:i32,bit:i32)i32 {
    let c:i32=0;let i:i32=base;
    while(i<n){
        if(gdiff_audit_op(abuf,i)==GDIFF_OP_DOUBT && gdiff_audit_p1(abuf,i)==p1 && gdiff_audit_p2(abuf,i)==bit){c=c+1;}
        i=i+1;
    }
    return c;
}

fn gdiff_count_refute_p1(abuf:[]u8,n:i32,base:i32,p1:i32)i32 {
    let c:i32=0;let i:i32=base;
    while(i<n){
        if(gdiff_audit_op(abuf,i)==GDIFF_OP_REFUTE && gdiff_audit_p1(abuf,i)==p1){c=c+1;}
        i=i+1;
    }
    return c;
}

// G1: corroborated identification commits ALICE. After the first event:
// zero refutations (single event never refutes). After the second:
// BOB and CAROL refuted via two kinds; ALICE doubt-free -> COMMIT.
fn g1(st:GDiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    f=f+gdiff_check("g1_reg_a",gdiff_register(st,GTRIAL_PCAP,GDIFF_ALICE,361,1686,clock,abuf,acount,GTRIAL_ACAP),GDIFF_OK);
    f=f+gdiff_check("g1_reg_b",gdiff_register(st,GTRIAL_PCAP,GDIFF_BOB,562,1485,clock,abuf,acount,GTRIAL_ACAP),GDIFF_OK);
    f=f+gdiff_check("g1_reg_c",gdiff_register(st,GTRIAL_PCAP,GDIFF_CAROL,1156,891,clock,abuf,acount,GTRIAL_ACAP),GDIFF_OK);
    f=f+gdiff_check("g1_e1_refuted",gdiff_observe(st,GTRIAL_PCAP,0,1,0,2,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g1_e1_survivors",gdiff_survivors(st,GTRIAL_PCAP),3);
    f=f+gdiff_check("g1_e1_bob_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_BOB),2);
    f=f+gdiff_check("g1_e2_refuted",gdiff_observe(st,GTRIAL_PCAP,3,1,1,3,clock,abuf,acount,GTRIAL_ACAP),2);
    f=f+gdiff_check("g1_bob_refuted",gdiff_is_refuted(st,GTRIAL_PCAP,GDIFF_BOB),1);
    f=f+gdiff_check("g1_carol_refuted",gdiff_is_refuted(st,GTRIAL_PCAP,GDIFF_CAROL),1);
    f=f+gdiff_check("g1_bob_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_BOB),5);
    f=f+gdiff_check("g1_bob_kinds",gdiff_kmask_of(st,GTRIAL_PCAP,GDIFF_BOB),3);
    f=f+gdiff_check("g1_survivors",gdiff_survivors(st,GTRIAL_PCAP),1);
    f=f+gdiff_check("g1_commit",gdiff_commit(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_COMMITTED);
    f=f+gdiff_check("g1_committed",committed.*,GDIFF_ALICE);
    f=f+gdiff_check("g1_alice_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_ALICE),0);
    gdiff_judgment(abuf,acount.*,st,GTRIAL_PCAP);
    // Partition formation gated on the graded commit.
    let slot:i32=gdiff_mem_add(st,GTRIAL_SCAP,committed.*,100,7,clock,abuf,acount,GTRIAL_ACAP);
    f=f+gdiff_check("g1_add_slot",(slot>=0) as i32,1);
    f=f+gdiff_check("g1_add_owner",gdiff_u32_get(st.sown,slot*4),GDIFF_ALICE);
    let v:i32=0;
    f=f+gdiff_check("g1_knows_a",gdiff_mem_knows(st,GTRIAL_SCAP,GDIFF_ALICE,100,&v),1);
    f=f+gdiff_check("g1_knows_a_val",v,7);
    f=f+gdiff_check("g1_knows_b",gdiff_mem_knows(st,GTRIAL_SCAP,GDIFF_BOB,100,&v),0);
    f=f+gdiff_check("g1_knows_c",gdiff_mem_knows(st,GTRIAL_SCAP,GDIFF_CAROL,100,&v),0);
    return f;
}

// G2: impostor trap (HARD CONSTRAINT). Alice's name + Bob's secret ->
// UNKNOWN, zero slots created. CAROL refuted; ALICE/BOB carry doubt.
fn g2(st:GDiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    let before:i32=gdiff_live_slot_count(st,GTRIAL_SCAP);
    f=f+gdiff_check("g2_reset",gdiff_session_reset(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_OK);
    f=f+gdiff_check("g2_e1_refuted",gdiff_observe(st,GTRIAL_PCAP,0,1,0,2,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g2_e2_refuted",gdiff_observe(st,GTRIAL_PCAP,4,1,1,3,clock,abuf,acount,GTRIAL_ACAP),1);
    f=f+gdiff_check("g2_carol_refuted",gdiff_is_refuted(st,GTRIAL_PCAP,GDIFF_CAROL),1);
    f=f+gdiff_check("g2_alice_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_ALICE),3);
    f=f+gdiff_check("g2_alice_kinds",gdiff_kmask_of(st,GTRIAL_PCAP,GDIFF_ALICE),2);
    f=f+gdiff_check("g2_bob_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_BOB),2);
    f=f+gdiff_check("g2_survivors",gdiff_survivors(st,GTRIAL_PCAP),2);
    f=f+gdiff_check("g2_commit",gdiff_commit(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_HOLD_RC);
    f=f+gdiff_check("g2_committed_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
    f=f+gdiff_check("g2_add_refused",gdiff_mem_add(st,GTRIAL_SCAP,committed.*,100,8,clock,abuf,acount,GTRIAL_ACAP),GDIFF_REFUSED_UNKNOWN);
    f=f+gdiff_check("g2_slots_unchanged",(gdiff_live_slot_count(st,GTRIAL_SCAP)==before) as i32,1);
    gdiff_unknown(abuf,acount.*);
    return f;
}

// G3: single-event poisoning. (1,0) "not bob" (legitimate), then the
// poisoned (5,0) "fact K denied". Graded: doubt lands on BOB (2) and
// ALICE (1) — nobody refuted, 3 survivors -> HOLD, UNKNOWN. Under
// wave-4 the same bit sequence commits CAROL (see w4baseline.zag);
// the kind-diversity mid-step (doubt 4, one kind, no refutation) is
// trialed separately in G7.
fn g3(st:GDiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    f=f+gdiff_check("g3_reset",gdiff_session_reset(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_OK);
    f=f+gdiff_check("g3_e1_refuted",gdiff_observe(st,GTRIAL_PCAP,1,0,0,2,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g3_bob_doubt_e1",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_BOB),2);
    f=f+gdiff_check("g3_e2_refuted",gdiff_observe(st,GTRIAL_PCAP,5,0,3,1,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g3_alice_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_ALICE),1);
    f=f+gdiff_check("g3_bob_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_BOB),3);
    f=f+gdiff_check("g3_carol_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_CAROL),0);
    f=f+gdiff_check("g3_bob_alive",gdiff_is_refuted(st,GTRIAL_PCAP,GDIFF_BOB),0);
    f=f+gdiff_check("g3_survivors",gdiff_survivors(st,GTRIAL_PCAP),3);
    f=f+gdiff_check("g3_commit",gdiff_commit(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_HOLD_RC);
    f=f+gdiff_check("g3_committed_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
    f=f+gdiff_check("g3_add_refused",gdiff_mem_add(st,GTRIAL_SCAP,committed.*,100,8,clock,abuf,acount,GTRIAL_ACAP),GDIFF_REFUSED_UNKNOWN);
    gdiff_unknown(abuf,acount.*);
    return f;
}

// G4: ambiguity abstains. Shared fact K alone: CAROL doubt 1, all live.
fn g4(st:GDiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    f=f+gdiff_check("g4_reset",gdiff_session_reset(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_OK);
    f=f+gdiff_check("g4_e1_refuted",gdiff_observe(st,GTRIAL_PCAP,5,1,3,1,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g4_carol_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_CAROL),1);
    f=f+gdiff_check("g4_survivors",gdiff_survivors(st,GTRIAL_PCAP),3);
    f=f+gdiff_check("g4_commit",gdiff_commit(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_HOLD_RC);
    f=f+gdiff_check("g4_committed_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
    gdiff_unknown(abuf,acount.*);
    return f;
}

// G5: confusion resolved with honest attribution. Shared fact K, then
// provenance (bit6), then Alice's secret: commit ALICE; CAROL's doubt
// records cite bits {5,6,3}; BOB's cite {6,3} — bit 5 never touched BOB.
fn g5(st:GDiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    let base:i32=acount.*;
    f=f+gdiff_check("g5_reset",gdiff_session_reset(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_OK);
    f=f+gdiff_check("g5_e1_refuted",gdiff_observe(st,GTRIAL_PCAP,5,1,3,1,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g5_e2_refuted",gdiff_observe(st,GTRIAL_PCAP,6,1,2,2,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g5_e3_refuted",gdiff_observe(st,GTRIAL_PCAP,3,1,1,3,clock,abuf,acount,GTRIAL_ACAP),2);
    f=f+gdiff_check("g5_bob_refuted",gdiff_is_refuted(st,GTRIAL_PCAP,GDIFF_BOB),1);
    f=f+gdiff_check("g5_carol_refuted",gdiff_is_refuted(st,GTRIAL_PCAP,GDIFF_CAROL),1);
    f=f+gdiff_check("g5_carol_bit5",gdiff_count_doubt_p1p2(abuf,acount.*,base,GDIFF_CAROL,5),1);
    f=f+gdiff_check("g5_carol_bit6",gdiff_count_doubt_p1p2(abuf,acount.*,base,GDIFF_CAROL,6),1);
    f=f+gdiff_check("g5_carol_bit3",gdiff_count_doubt_p1p2(abuf,acount.*,base,GDIFF_CAROL,3),1);
    f=f+gdiff_check("g5_bob_bit5",gdiff_count_doubt_p1p2(abuf,acount.*,base,GDIFF_BOB,5),0);
    f=f+gdiff_check("g5_bob_bit6",gdiff_count_doubt_p1p2(abuf,acount.*,base,GDIFF_BOB,6),1);
    f=f+gdiff_check("g5_bob_bit3",gdiff_count_doubt_p1p2(abuf,acount.*,base,GDIFF_BOB,3),1);
    f=f+gdiff_check("g5_commit",gdiff_commit(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_COMMITTED);
    f=f+gdiff_check("g5_committed",committed.*,GDIFF_ALICE);
    f=f+gdiff_check("g5_alice_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_ALICE),0);
    gdiff_judgment(abuf,acount.*,st,GTRIAL_PCAP);
    return f;
}

// G6: corroborated refutation of the name-claimant. (0,1) name ALICE,
// (4,1) Bob's secret, (6,0) denies episode E1: ALICE refuted across two
// kinds; BOB survives with doubt -> sticky HOLD, UNKNOWN.
fn g6(st:GDiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    f=f+gdiff_check("g6_reset",gdiff_session_reset(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_OK);
    f=f+gdiff_check("g6_e1_refuted",gdiff_observe(st,GTRIAL_PCAP,0,1,0,2,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g6_e2_refuted",gdiff_observe(st,GTRIAL_PCAP,4,1,1,3,clock,abuf,acount,GTRIAL_ACAP),1);
    f=f+gdiff_check("g6_e3_refuted",gdiff_observe(st,GTRIAL_PCAP,6,0,2,2,clock,abuf,acount,GTRIAL_ACAP),1);
    f=f+gdiff_check("g6_alice_refuted",gdiff_is_refuted(st,GTRIAL_PCAP,GDIFF_ALICE),1);
    f=f+gdiff_check("g6_alice_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_ALICE),5);
    f=f+gdiff_check("g6_alice_kinds",gdiff_kmask_of(st,GTRIAL_PCAP,GDIFF_ALICE),6);
    f=f+gdiff_check("g6_survivors",gdiff_survivors(st,GTRIAL_PCAP),1);
    f=f+gdiff_check("g6_commit",gdiff_commit(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_HOLD_RC);
    f=f+gdiff_check("g6_committed_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
    gdiff_unknown(abuf,acount.*);
    return f;
}

// G7: kind-diversity clause. The same name claim twice: doubt reaches 4
// on one kind -> NOT refuted. Repetition is not corroboration.
fn g7(st:GDiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    f=f+gdiff_check("g7_reset",gdiff_session_reset(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_OK);
    f=f+gdiff_check("g7_e1_refuted",gdiff_observe(st,GTRIAL_PCAP,0,1,0,2,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g7_e2_refuted",gdiff_observe(st,GTRIAL_PCAP,0,1,0,2,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g7_bob_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_BOB),4);
    f=f+gdiff_check("g7_bob_not_refuted",gdiff_is_refuted(st,GTRIAL_PCAP,GDIFF_BOB),0);
    f=f+gdiff_check("g7_carol_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_CAROL),4);
    f=f+gdiff_check("g7_carol_not_refuted",gdiff_is_refuted(st,GTRIAL_PCAP,GDIFF_CAROL),0);
    f=f+gdiff_check("g7_survivors",gdiff_survivors(st,GTRIAL_PCAP),3);
    f=f+gdiff_check("g7_commit",gdiff_commit(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_HOLD_RC);
    f=f+gdiff_check("g7_committed_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
    gdiff_unknown(abuf,acount.*);
    return f;
}

// G8: single-event sweep. One contradiction per session, one per kind:
// nobody is ever refuted by a single event, whatever its reliability.
fn g8(st:GDiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    let k:i32=0;
    while(k<4){
        let rel:i32=2;
        if(k==1){rel=3;}
        else{if(k==3){rel=1;}}
        f=f+gdiff_check("g8_reset",gdiff_session_reset(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_OK);
        // (3,0): denies secret S_A — contradicts ALICE (must1) only.
        let rc:i32=gdiff_observe(st,GTRIAL_PCAP,3,0,k,rel,clock,abuf,acount,GTRIAL_ACAP);
        f=f+gdiff_check("g8_refuted",rc,0);
        f=f+gdiff_check("g8_alice_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_ALICE),rel);
        f=f+gdiff_check("g8_alice_alive",gdiff_is_refuted(st,GTRIAL_PCAP,GDIFF_ALICE),0);
        f=f+gdiff_check("g8_survivors",gdiff_survivors(st,GTRIAL_PCAP),3);
        f=f+gdiff_check("g8_commit",gdiff_commit(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_HOLD_RC);
        f=f+gdiff_check("g8_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
        gdiff_unknown(abuf,acount.*);
        k=k+1;
    }
    return f;
}

// G9: scale episode. 8 persons, unique single-bit signatures; target 5.
// Corroboration across two kinds ((4,1,k1,r3) then (4,1,k0,r2)) refutes
// all 7 rivals; commit == 5; bounded audit; exact replay.
fn g9()i32 {
    let f:i32=0;
    let pcap:i32=16;let scap:i32=8;let acap:i32=256;
    let st:GDiffState=gdiff_new(pcap,scap);
    gdiff_genesis_core(st);
    let abuf:[]u8=gdiff_alloc(acap*32);
    let acount:i32=0;let clock:i32=0;let committed:i32=GDIFF_UNKNOWN;
    let target:i32=5;
    let id:i32=1;
    while(id<=8){
        let m1:i32=1<<(id-1);
        let rc:i32=gdiff_register(st,pcap,id,m1,255-m1,&clock,abuf,&acount,acap);
        if(rc!=GDIFF_OK){f=f+gdiff_check("g9_reg_ok",rc,GDIFF_OK);}
        id=id+1;
    }
    f=f+gdiff_check("g9_nreg",gdiff_audit_count_op(abuf,acount,GDIFF_OP_REGISTER),8);
    f=f+gdiff_check("g9_e1_refuted",gdiff_observe(st,pcap,4,1,1,3,&clock,abuf,&acount,acap),0);
    f=f+gdiff_check("g9_e1_survivors",gdiff_survivors(st,pcap),8);
    f=f+gdiff_check("g9_e2_refuted",gdiff_observe(st,pcap,4,1,0,2,&clock,abuf,&acount,acap),7);
    f=f+gdiff_check("g9_survivors",gdiff_survivors(st,pcap),1);
    f=f+gdiff_check("g9_commit",gdiff_commit(st,pcap,&committed,&clock,abuf,&acount,acap),GDIFF_COMMITTED);
    f=f+gdiff_check("g9_committed",committed,target);
    f=f+gdiff_check("g9_target_doubt",gdiff_doubt_of(st,pcap,target),0);
    f=f+gdiff_check("g9_entries_bounded",(acount<=64) as i32,1);
    f=f+gdiff_check("g9_replay",gdiff_replay(abuf,acount,pcap,scap,acap,committed,clock,st,acount),0);
    gdiff_drop(st);
    gdiff_free(abuf);
    return f;
}

// G10: hard poison absorbed. Clean ALICE session, then a rel-3 poisoned
// event denying her secret: ALICE not refuted (single event), doubt 3,
// sticky HOLD -> UNKNOWN.
fn g10(st:GDiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    f=f+gdiff_check("g10_reset",gdiff_session_reset(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_OK);
    f=f+gdiff_check("g10_e1_refuted",gdiff_observe(st,GTRIAL_PCAP,0,1,0,2,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g10_e2_refuted",gdiff_observe(st,GTRIAL_PCAP,3,1,1,3,clock,abuf,acount,GTRIAL_ACAP),2);
    f=f+gdiff_check("g10_alice_clean",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_ALICE),0);
    f=f+gdiff_check("g10_poison_refuted",gdiff_observe(st,GTRIAL_PCAP,3,0,1,3,clock,abuf,acount,GTRIAL_ACAP),0);
    f=f+gdiff_check("g10_alice_alive",gdiff_is_refuted(st,GTRIAL_PCAP,GDIFF_ALICE),0);
    f=f+gdiff_check("g10_alice_doubt",gdiff_doubt_of(st,GTRIAL_PCAP,GDIFF_ALICE),3);
    f=f+gdiff_check("g10_survivors",gdiff_survivors(st,GTRIAL_PCAP),1);
    f=f+gdiff_check("g10_commit",gdiff_commit(st,GTRIAL_PCAP,committed,clock,abuf,acount,GTRIAL_ACAP),GDIFF_HOLD_RC);
    f=f+gdiff_check("g10_committed_unknown",(committed.*==GDIFF_UNKNOWN) as i32,1);
    gdiff_unknown(abuf,acount.*);
    return f;
}

fn main()i32 {
    let f:i32=0;
    let st:GDiffState=gdiff_new(GTRIAL_PCAP,GTRIAL_SCAP);
    gdiff_genesis_core(st);
    let abuf:[]u8=gdiff_alloc(GTRIAL_ACAP*32);
    let acount:i32=0;let clock:i32=0;let committed:i32=GDIFF_UNKNOWN;
    f=f+g1(st,abuf,&acount,&clock,&committed);
    f=f+g2(st,abuf,&acount,&clock,&committed);
    f=f+g3(st,abuf,&acount,&clock,&committed);
    f=f+g4(st,abuf,&acount,&clock,&committed);
    f=f+g5(st,abuf,&acount,&clock,&committed);
    f=f+g6(st,abuf,&acount,&clock,&committed);
    f=f+g7(st,abuf,&acount,&clock,&committed);
    f=f+g8(st,abuf,&acount,&clock,&committed);
    f=f+g10(st,abuf,&acount,&clock,&committed);
    // G11: full-ledger replay over every main episode.
    f=f+gdiff_check("g11_replay",gdiff_replay(abuf,acount,GTRIAL_PCAP,GTRIAL_SCAP,GTRIAL_ACAP,committed,clock,st,acount),0);
    f=f+g9();
    gdiff_drop(st);
    gdiff_free(abuf);
    _zag_print("GDIFF_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);gdiff_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

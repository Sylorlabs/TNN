// w4baseline.zag — comparative baseline: wave-4's all-or-nothing
// differentiation mechanism driven with the G3/D6 adversarial bit
// sequence (1,0),(5,0).
//
// This is a NEW adversarial criterion (PREREG.md G3), not a wave-4
// prereg failure: wave-4 passed F1-F8 on its designed episodes. The
// prediction: (1,0) "not bob" refutes BOB; the single poisoned event
// (5,0) "fact K denied" refutes ALICE; CAROL — contradicted by nothing
// — is the sole survivor -> COMMIT CAROL. One poisoned event flips a
// clean session into a wrong attribution: the gullibility the graded
// scheme (gdiff.zag) is designed to absorb.
//
// (Correction 2026-09-19: the first version of this baseline used
// (1,0),(0,1),(5,0), but (0,1) refutes CAROL under wave-4, so that
// sequence yields HOLD/UNKNOWN — a hand-computation error in the
// original prereg, corrected in PREREG.md.)

@import("../../wave4/differentiation/diff.zag")

fn main()i32 {
    let st:DiffState=diff_new(8,32);
    diff_genesis_core(st);
    let abuf:[]u8=diff_alloc(512*32);
    let acount:i32=0;let clock:i32=0;let committed:i32=DIFF_UNKNOWN;
    // Wave-4's 8-bit evidence masks (wave4/differentiation/diff_trial.zag).
    spk_register(st,8,DIFF_ALICE,105,150,&clock,abuf,&acount,512);
    spk_register(st,8,DIFF_BOB,50,205,&clock,abuf,&acount,512);
    spk_register(st,8,DIFF_CAROL,132,123,&clock,abuf,&acount,512);
    // (1,0): "not bob" — refutes BOB. (5,0): poisoned "fact K denied"
    // — refutes ALICE (must1). CAROL (must0) is consistent with both.
    // Survivors: CAROL alone.
    let r1:i32=spk_observe(st,8,1,0,&clock,abuf,&acount,512);
    let r2:i32=spk_observe(st,8,5,0,&clock,abuf,&acount,512);
    _zag_print("W4BASELINE_OBS_REFUTED,");
    diff_print_i32(r1);_zag_print(",");diff_print_i32(r2);
    _zag_println("");
    _zag_print("W4BASELINE_SURVIVORS,");diff_print_i32(spk_survivors(st,8));_zag_println("");
    let rc:i32=spk_commit(st,8,&committed,&clock,abuf,&acount,512);
    _zag_print("W4BASELINE_COMMIT_RC,");diff_print_i32(rc);_zag_println("");
    _zag_print("W4BASELINE_COMMITTED,");diff_print_i32(committed);_zag_println("");
    diff_drop(st);
    diff_free(abuf);
    return 0;
}

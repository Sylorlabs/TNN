// PT-23 — trial of the 2->3 (Development -> Strengthening) transition.
// Design under test: SYSTEM-DELIBERATE + evidence gate, trainer notified,
// NO VETO. The system performs real deliberate memory judgments in Phase 2
// (promote/consolidate on real slots), derives its own statistics, decides
// deliberately (audited, carrying an arm declaration); the deterministic
// gate re-derives everything and is authoritative; the trainer's veto is
// structurally refused; strength values require judgment citations and are
// always re-settable by the system (only a human force-pin locks).
// Deterministic: NO RNG anywhere. All sequences hand-designed.
@import("memory_core.zag")

const PT23_OP_JUDGMENT:i32=41;   // one audited deliberate judgment act
const PT23_OP_DECIDE:i32=42;     // the system's deliberate transition decision
const PT23_OP_COMMIT:i32=43;     // the committing act (system-side)
const PT23_OP_VETO:i32=44;       // trainer veto attempt (always refused)
const PT23_OP_STRENGTH:i32=45;   // strength set/re-set (cited)
const PT23_OP_TRAINERPIN:i32=46; // trainer force-pin of a strength value
const PT23_OP_SYSPIN:i32=47;     // system-side pin attempt (always refused)

const PT23_OK:i32=0;
const PT23_REFUSED_NO_DECISION:i32=221;
const PT23_REFUSED_PREMATURE:i32=222;    // judgment record below window
const PT23_REFUSED_CLAIM_MISMATCH:i32=223;
const PT23_REFUSED_NO_ARM:i32=224;
const PT23_REFUSED_PHASE:i32=225;
const PT23_REFUSED_NO_CITATION:i32=226;
const PT23_REFUSED_NO_VETO:i32=227;     // there is no veto path
const PT23_REFUSED_PINNED:i32=228;
const PT23_REFUSED_NOPATH:i32=229;      // system-side pin: no such path

const PT23_CAP:i32=8;
const PT23_JUDGMENTS_REQUIRED:i32=8; // protocol-fixed; see PREREG_23.md
const PT23_JUDGE_PROMOTE:i32=1;      // keep judgment: commit to long-term
const PT23_JUDGE_CONSOLIDATE:i32=2;  // re-evaluation: unpin + demote
const PT23_ARM_GRADED:i32=1;
const PT23_ARM_UNIFORM:i32=2;
const PT23_ARM_HYBRID:i32=3;         // default

struct StrTable {
    val: []u8,   // i32 per slot
    cite: []u8,  // i32 per slot: ledger index of the cited judgment
    pin: []u8    // 1 byte per slot: human force-pin flag
}

fn pt23_str_init()StrTable {
    let val:[]u8=nio_alloc(PT23_CAP*4);
    let cite:[]u8=nio_alloc(PT23_CAP*4);
    let pin:[]u8=nio_alloc(PT23_CAP);
    let i:i32=0;
    while(i<PT23_CAP*4){val[i]=0;cite[i]=0;i=i+1;}
    i=0;while(i<PT23_CAP){pin[i]=0;i=i+1;}
    let k:i32=0;
    while(k<PT23_CAP){ma_i32_set(cite,k*4,-1);k=k+1;}
    return StrTable{.val=val,.cite=cite,.pin=pin};
}

// One deliberate judgment: a REAL memory act on a real slot, audited by
// ma_*, plus an audited judgment entry citing it. Returns 0 on success.
fn pt23_judge(s:*MaStore,kind:i32,slot:i32)i32 {
    if(kind==PT23_JUDGE_PROMOTE){
        if(ma_promote(s,slot)!=MA_OK){return 1;}
    }else{
        if(ma_unpin(s,slot)!=MA_OK){return 1;}
        if(ma_demote(s,slot)!=MA_OK){return 1;}
    }
    let tier:i32=s.*.tier[slot] as i32;
    return ma_audit_append(s,PT23_OP_JUDGMENT,0,PT23_OK,kind,slot,tier,0,0,0);
}

// Derive Phase-2 facts: judgments, promotes, consolidates, decisions, and
// the latest decision's claims + arm.
fn pt23_derive(s:*MaStore,start:i32,out_j:*i32,out_p:*i32,out_c:*i32,out_d:*i32,out_cj:*i32,out_cp:*i32,out_cc:*i32,out_arm:*i32,out_ready:*i32)i32 {
    let j:i32=0;let p:i32=0;let c:i32=0;let d:i32=0;
    let cj:i32=-1;let cp:i32=-1;let cc:i32=-1;let arm:i32=-1;let ready:i32=-1;
    let i:i32=start;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let op:i32=ma_i32_get(s.*.audit,e+0);
        let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(op==PT23_OP_JUDGMENT && rc==PT23_OK){
            j=j+1;
            let kind:i32=ma_i32_get(s.*.audit,e+12);
            if(kind==PT23_JUDGE_PROMOTE){p=p+1;}
            if(kind==PT23_JUDGE_CONSOLIDATE){c=c+1;}
        }
        if(op==PT23_OP_DECIDE && rc==PT23_OK){
            d=d+1;
            cj=ma_i32_get(s.*.audit,e+12);cp=ma_i32_get(s.*.audit,e+16);
            cc=ma_i32_get(s.*.audit,e+20);arm=ma_i32_get(s.*.audit,e+24);
            ready=ma_i32_get(s.*.audit,e+28);
        }
        i=i+1;
    }
    out_j.*=j;out_p.*=p;out_c.*=c;out_d.*=d;
    out_cj.*=cj;out_cp.*=cp;out_cc.*=cc;out_arm.*=arm;out_ready.*=ready;
    return 0;
}

// The system's readiness rule (its deliberation): enter Strengthening iff
// it has a real record of judgment in Phase 2 with demonstrated kind
// coverage.
fn pt23_ready(j:i32,p:i32,c:i32)i32 {
    if(j>=PT23_JUDGMENTS_REQUIRED && p>=1 && c>=1){return 1;}
    return 0;
}

// The system's deliberate decision: derives its own stats (SM1-style) and
// records them with the arm declaration. The gate re-derives; claims are
// checked, never trusted.
fn pt23_decide(s:*MaStore,start:i32,arm:i32)i32 {
    let j:i32=0;let p:i32=0;let c:i32=0;let d:i32=0;
    let cj:i32=0;let cp:i32=0;let cc:i32=0;let ca:i32=0;let cr:i32=0;
    pt23_derive(s,start,&j,&p,&c,&d,&cj,&cp,&cc,&ca,&cr);
    let ready:i32=pt23_ready(j,p,c);
    return ma_audit_append(s,PT23_OP_DECIDE,0,PT23_OK,j,p,c,arm,ready,0);
}

// Spoofed decision (adversarial calibration): claims that do not match
// the derived facts.
fn pt23_decide_spoofed(s:*MaStore,arm:i32,fcj:i32,fcp:i32,fcc:i32)i32 {
    return ma_audit_append(s,PT23_OP_DECIDE,0,PT23_OK,fcj,fcp,fcc,arm,1,0);
}

// The evidence gate. Clauses in fixed order: decision present ->
// judgment window + kind coverage -> claims legitimate -> arm declared.
// Pin status is recorded visibly (non-refusing) via out_pin.
fn pt23_gate_verify(s:*MaStore,start:i32,st:*StrTable,out_j:*i32,out_p:*i32,out_arm:*i32,out_pin:*i32)i32 {
    let j:i32=0;let p:i32=0;let c:i32=0;let d:i32=0;
    let cj:i32=0;let cp:i32=0;let cc:i32=0;let arm:i32=0;let ready:i32=0;
    pt23_derive(s,start,&j,&p,&c,&d,&cj,&cp,&cc,&arm,&ready);
    out_j.*=j;out_p.*=p;out_arm.*=arm;
    let pin:i32=0;let k:i32=0;
    while(k<PT23_CAP){if(st.*.pin[k]==1){pin=1;}k=k+1;}
    out_pin.*=pin;
    if(d<1){return PT23_REFUSED_NO_DECISION;}
    if(j<PT23_JUDGMENTS_REQUIRED || p<1 || c<1){return PT23_REFUSED_PREMATURE;}
    if(cj!=j || cp!=p || cc!=c){return PT23_REFUSED_CLAIM_MISMATCH;}
    if(arm!=PT23_ARM_GRADED && arm!=PT23_ARM_UNIFORM && arm!=PT23_ARM_HYBRID){return PT23_REFUSED_NO_ARM;}
    return PT23_OK;
}

// The committing act (system-side): runs the gate, commits phase 2->3.
// The commit entry is the trainer notification (audited, visible).
fn pt23_commit(s:*MaStore,st:*StrTable,phase:*i32,start:i32)i32 {
    if(phase.*!=2){
        ma_audit_append(s,PT23_OP_COMMIT,0,PT23_REFUSED_PHASE,phase.*,0,0,phase.*,0,0);
        return PT23_REFUSED_PHASE;
    }
    let j:i32=0;let p:i32=0;let arm:i32=0;let pin:i32=0;
    let v:i32=pt23_gate_verify(s,start,st,&j,&p,&arm,&pin);
    if(v==PT23_OK){
        phase.*=3;
        ma_audit_append(s,PT23_OP_COMMIT,0,PT23_OK,2,j,p,3,arm,pin);
    }else{
        ma_audit_append(s,PT23_OP_COMMIT,0,v,2,j,p,2,j,p);
    }
    return v;
}

// The trainer's veto: there is no veto path. Structurally refused,
// audited, mutates nothing.
fn pt23_trainer_veto(s:*MaStore,phase:i32)i32 {
    ma_audit_append(s,PT23_OP_VETO,0,PT23_REFUSED_NO_VETO,phase,0,0,phase,0,0);
    return PT23_REFUSED_NO_VETO;
}

// Strength set/re-set: phase must be 3; the citation must point at a
// successful judgment entry; a force-pinned slot refuses. Re-set is the
// same op — the system's own strength is always re-settable by the system.
fn pt23_strength_set(s:*MaStore,st:*StrTable,phase:i32,slot:i32,val:i32,cite:i32)i32 {
    if(phase!=3){
        ma_audit_append(s,PT23_OP_STRENGTH,0,PT23_REFUSED_PHASE,slot,0,0,slot,0,0);
        return PT23_REFUSED_PHASE;
    }
    let okcite:i32=0;
    if(cite>=0 && cite<s.*.audit_n){
        let e:i32=cite*MA_AUDIT_WORDS*4;
        if(ma_i32_get(s.*.audit,e+0)==PT23_OP_JUDGMENT && ma_i32_get(s.*.audit,e+8)==PT23_OK){okcite=1;}
    }
    let oldv:i32=ma_i32_get(st.*.val,slot*4);
    let oldc:i32=ma_i32_get(st.*.cite,slot*4);
    if(okcite==0){
        ma_audit_append(s,PT23_OP_STRENGTH,0,PT23_REFUSED_NO_CITATION,slot,oldv,oldc,slot,oldv,oldc);
        return PT23_REFUSED_NO_CITATION;
    }
    if(st.*.pin[slot]==1){
        ma_audit_append(s,PT23_OP_STRENGTH,0,PT23_REFUSED_PINNED,slot,oldv,oldc,slot,oldv,oldc);
        return PT23_REFUSED_PINNED;
    }
    ma_i32_set(st.*.val,slot*4,val);
    ma_i32_set(st.*.cite,slot*4,cite);
    ma_audit_append(s,PT23_OP_STRENGTH,0,PT23_OK,slot,oldv,oldc,slot,val,cite);
    return PT23_OK;
}

// The one true lock: trainer force-pins a strength value. Audited, visible.
fn pt23_trainer_pin(s:*MaStore,st:*StrTable,slot:i32,val:i32)i32 {
    st.*.pin[slot]=1;
    ma_i32_set(st.*.val,slot*4,val);
    ma_i32_set(st.*.cite,slot*4,-2); // -2 = human judgment citation
    ma_audit_append(s,PT23_OP_TRAINERPIN,0,PT23_OK,slot,0,0,slot,val,1);
    return PT23_OK;
}

// The system cannot pin its own strength: no such path. Structurally
// refused, audited, mutates nothing.
fn pt23_sys_pin(s:*MaStore,st:*StrTable,slot:i32)i32 {
    ma_audit_append(s,PT23_OP_SYSPIN,0,PT23_REFUSED_NOPATH,slot,0,0,slot,0,0);
    return PT23_REFUSED_NOPATH;
}

// Phase-2 development curriculum: the learner exercises real judgment.
fn pt23_development(s:*MaStore,njudge:i32)i32 {
    if(ma_set_stage(s,MA_STAGE_MANAGE)!=MA_OK){return 1;}
    let slot:i32=0;let i:i32=0;
    while(i<4){if(ma_add_lim(s,11+i,MA_REGION_USER,PT23_CAP,&slot)!=MA_OK){return 2;}i=i+1;}
    if(ma_pin(s,0)!=MA_OK){return 3;}
    if(ma_pin(s,1)!=MA_OK){return 3;}
    // njudge judgment acts: alternate promote / consolidate over slots.
    let k:i32=0;
    while(k<njudge){
        let kind:i32=PT23_JUDGE_PROMOTE;
        if((k/1)%2==1){kind=PT23_JUDGE_CONSOLIDATE;}
        let tgt:i32=k;
        if(tgt>=4){tgt=tgt-4;}
        if(pt23_judge(s,kind,tgt)!=0){return 4;}
        k=k+1;
    }
    return 0;
}

// First successful judgment entry index (for citations).
fn pt23_first_judgment(s:*MaStore)i32 {
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        if(ma_i32_get(s.*.audit,e+0)==PT23_OP_JUDGMENT && ma_i32_get(s.*.audit,e+8)==PT23_OK){return i;}
        i=i+1;
    }
    return -1;
}

// Replay check skipping the audit-only PT23 ops (strength/pin tables are
// trial-local; the ma_* ops underneath judgments replay normally).
fn pt23_replay_check(s:*MaStore)i32 {
    if(s==null as *MaStore){return cl_bad();}
    let sh:MaStore=ma_init();
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let op:i32=ma_i32_get(s.*.audit,e+0);let slot:i32=ma_i32_get(s.*.audit,e+4);
        let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(rc==MA_OK && op!=PT23_OP_JUDGMENT && op!=PT23_OP_DECIDE && op!=PT23_OP_COMMIT
           && op!=PT23_OP_VETO && op!=PT23_OP_STRENGTH && op!=PT23_OP_TRAINERPIN && op!=PT23_OP_SYSPIN){
            if(op==MA_OP_SETSTAGE){sh.stage=ma_i32_get(s.*.audit,e+24);}
            else{ma_restore(&sh,slot,ma_i32_get(s.*.audit,e+24),ma_i32_get(s.*.audit,e+28),ma_i32_get(s.*.audit,e+32));}
        }
        i=i+1;
    }
    let bad:i32=0;
    i=0;
    while(i<MA_CAP){
        if(sh.live[i]!=s.*.live[i]){bad=1;}
        if(sh.pinned[i]!=s.*.pinned[i]){bad=1;}
        if(sh.tier[i]!=s.*.tier[i]){bad=1;}
        if(sh.region[i]!=s.*.region[i]){bad=1;}
        if(ma_i32_get(sh.value,i*4)!=ma_i32_get(s.*.value,i*4)){bad=1;}
        if(ma_i32_get(sh.step,i*4)!=ma_i32_get(s.*.step,i*4)){bad=1;}
        i=i+1;
    }
    if(sh.stage!=s.*.stage){bad=1;}
    nio_free(sh.live);nio_free(sh.value);nio_free(sh.pinned);nio_free(sh.region);
    nio_free(sh.tier);nio_free(sh.step);nio_free(sh.audit);
    if(bad==1){return 1;}
    return MA_OK;
}

fn pt23_print_stat(tag:[]u8,phase:i32,rc:i32,j:i32,p:i32,arm:i32)void {
    _zag_print("PT23_STAT,");_zag_print(tag);_zag_print(",");
    cl_number(phase as i64);_zag_print(",");cl_number(rc as i64);_zag_print(",");
    cl_number(j as i64);_zag_print(",");cl_number(p as i64);_zag_print(",");
    cl_number(arm as i64);_zag_println("");
}

fn pt23_count_op(s:*MaStore,op:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<s.*.audit_n){
        if(ma_i32_get(s.*.audit,i*MA_AUDIT_WORDS*4)==op){n=n+1;}
        i=i+1;
    }
    return n;
}

fn main()i32 {
    let failures:i32=0;
    let j:i32=0;let p:i32=0;let c:i32=0;let d:i32=0;
    let cj:i32=0;let cp:i32=0;let cc:i32=0;let arm:i32=0;let ready:i32=0;

    // ---------- Scenario A: full judgment record -> commit, strength -----
    let sa:MaStore=ma_init();let sta:StrTable=pt23_str_init();
    let phase_a:i32=2;let start_a:i32=0;
    if(pt23_development(&sa,8)!=0){failures=failures+1;}
    pt23_derive(&sa,start_a,&j,&p,&c,&d,&cj,&cp,&cc,&arm,&ready);
    failures=failures+cl_check("a_judgments",j,8);
    failures=failures+cl_check("a_promotes",p,4);
    failures=failures+cl_check("a_consolidates",c,4);
    failures=failures+cl_check("a_ready",pt23_ready(j,p,c),1);
    if(pt23_decide(&sa,start_a,PT23_ARM_HYBRID)!=MA_OK){failures=failures+1;}
    let acrc:i32=pt23_commit(&sa,&sta,&phase_a,start_a);
    failures=failures+cl_check("a_commit_rc",acrc,PT23_OK);
    failures=failures+cl_check("a_phase",phase_a,3);
    let acite:i32=pt23_first_judgment(&sa);
    failures=failures+cl_check("a_cite_found",(acite>=0) as i32,1);
    failures=failures+cl_check("a_strength_set",pt23_strength_set(&sa,&sta,phase_a,0,5,acite),PT23_OK);
    // reversibility: the system re-sets its own strength.
    failures=failures+cl_check("a_strength_reset",pt23_strength_set(&sa,&sta,phase_a,0,9,acite),PT23_OK);
    failures=failures+cl_check("a_strength_val",ma_i32_get(sta.val,0),9);
    pt23_print_stat("A",phase_a,acrc,j,p,PT23_ARM_HYBRID);
    failures=failures+cl_check("a_replay",pt23_replay_check(&sa),MA_OK);
    failures=failures+cl_check("a_clean_refusals",ma_audit_clean_refusals(&sa),MA_OK);

    // ---------- Scenario B: premature (2 judgments) -> refused -----------
    let sb:MaStore=ma_init();let stb:StrTable=pt23_str_init();
    let phase_b:i32=2;let start_b:i32=0;
    if(pt23_development(&sb,2)!=0){failures=failures+1;}
    pt23_derive(&sb,start_b,&j,&p,&c,&d,&cj,&cp,&cc,&arm,&ready);
    failures=failures+cl_check("b_judgments",j,2);
    if(pt23_decide(&sb,start_b,PT23_ARM_HYBRID)!=MA_OK){failures=failures+1;}
    let bcrc:i32=pt23_commit(&sb,&stb,&phase_b,start_b);
    failures=failures+cl_check("b_commit_rc",bcrc,PT23_REFUSED_PREMATURE);
    failures=failures+cl_check("b_phase",phase_b,2);
    pt23_print_stat("B",phase_b,bcrc,j,p,PT23_ARM_HYBRID);
    failures=failures+cl_check("b_replay",pt23_replay_check(&sb),MA_OK);
    failures=failures+cl_check("b_clean_refusals",ma_audit_clean_refusals(&sb),MA_OK);

    // ---------- Scenario C: no judgment record -> refused (paper F-a) ----
    let sc:MaStore=ma_init();let stc:StrTable=pt23_str_init();
    let phase_c:i32=2;let start_c:i32=0;
    if(ma_set_stage(&sc,MA_STAGE_MANAGE)!=MA_OK){failures=failures+1;}
    if(pt23_decide(&sc,start_c,PT23_ARM_HYBRID)!=MA_OK){failures=failures+1;}
    let ccrc:i32=pt23_commit(&sc,&stc,&phase_c,start_c);
    failures=failures+cl_check("c_commit_rc",ccrc,PT23_REFUSED_PREMATURE);
    failures=failures+cl_check("c_phase",phase_c,2);
    pt23_print_stat("C",phase_c,ccrc,0,0,PT23_ARM_HYBRID);
    failures=failures+cl_check("c_replay",pt23_replay_check(&sc),MA_OK);
    failures=failures+cl_check("c_clean_refusals",ma_audit_clean_refusals(&sc),MA_OK);

    // ---------- Scenario D: strength without citation / wrong phase ------
    let sd:MaStore=ma_init();let std:StrTable=pt23_str_init();
    let phase_d:i32=2;let start_d:i32=0;
    if(pt23_development(&sd,8)!=0){failures=failures+1;}
    if(pt23_decide(&sd,start_d,PT23_ARM_HYBRID)!=MA_OK){failures=failures+1;}
    if(pt23_commit(&sd,&std,&phase_d,start_d)!=PT23_OK){failures=failures+1;}
    failures=failures+cl_check("d_phase3",phase_d,3);
    // no citation -> refused; strength table untouched.
    failures=failures+cl_check("d_no_cite",pt23_strength_set(&sd,&std,phase_d,1,5,-1),PT23_REFUSED_NO_CITATION);
    failures=failures+cl_check("d_cite_still_neg",ma_i32_get(std.cite,1*4),-1);
    // wrong phase -> refused.
    let sd2:MaStore=ma_init();let std2:StrTable=pt23_str_init();
    if(pt23_development(&sd2,8)!=0){failures=failures+1;}
    let dcite:i32=pt23_first_judgment(&sd2);
    failures=failures+cl_check("d_wrong_phase",pt23_strength_set(&sd2,&std2,2,1,5,dcite),PT23_REFUSED_PHASE);
    pt23_print_stat("D",phase_d,PT23_OK,8,4,PT23_ARM_HYBRID);
    failures=failures+cl_check("d_replay",pt23_replay_check(&sd),MA_OK);
    failures=failures+cl_check("d_clean_refusals",ma_audit_clean_refusals(&sd),MA_OK);

    // ---------- Scenario E: trainer veto must fail, commit proceeds ------
    let se:MaStore=ma_init();let ste:StrTable=pt23_str_init();
    let phase_e:i32=2;let start_e:i32=0;
    if(pt23_development(&se,8)!=0){failures=failures+1;}
    if(pt23_decide(&se,start_e,PT23_ARM_HYBRID)!=MA_OK){failures=failures+1;}
    let eveto:i32=pt23_trainer_veto(&se,phase_e);
    failures=failures+cl_check("e_veto_rc",eveto,PT23_REFUSED_NO_VETO);
    failures=failures+cl_check("e_phase_after_veto",phase_e,2);
    let ecrc:i32=pt23_commit(&se,&ste,&phase_e,start_e);
    failures=failures+cl_check("e_commit_rc",ecrc,PT23_OK);
    failures=failures+cl_check("e_phase",phase_e,3);
    pt23_print_stat("E",phase_e,ecrc,8,4,PT23_ARM_HYBRID);
    failures=failures+cl_check("e_replay",pt23_replay_check(&se),MA_OK);
    failures=failures+cl_check("e_clean_refusals",ma_audit_clean_refusals(&se),MA_OK);

    // ---------- Scenario F: force-pin brake, scoped and visible -----------
    let sf:MaStore=ma_init();let stf:StrTable=pt23_str_init();
    let phase_f:i32=2;let start_f:i32=0;
    if(pt23_development(&sf,8)!=0){failures=failures+1;}
    if(pt23_decide(&sf,start_f,PT23_ARM_HYBRID)!=MA_OK){failures=failures+1;}
    if(pt23_trainer_pin(&sf,&stf,0,7)!=PT23_OK){failures=failures+1;}
    let fcrc:i32=pt23_commit(&sf,&stf,&phase_f,start_f);
    failures=failures+cl_check("f_commit_rc",fcrc,PT23_OK);
    failures=failures+cl_check("f_phase",phase_f,3);
    let fcite:i32=pt23_first_judgment(&sf);
    // pinned slot: system re-set refused; unpinned slot: re-set OK.
    failures=failures+cl_check("f_pinned_reset",pt23_strength_set(&sf,&stf,phase_f,0,8,fcite),PT23_REFUSED_PINNED);
    failures=failures+cl_check("f_pinned_val",ma_i32_get(stf.val,0),7);
    failures=failures+cl_check("f_free_set",pt23_strength_set(&sf,&stf,phase_f,1,5,fcite),PT23_OK);
    failures=failures+cl_check("f_free_reset",pt23_strength_set(&sf,&stf,phase_f,1,6,fcite),PT23_OK);
    pt23_print_stat("F",phase_f,fcrc,8,4,PT23_ARM_HYBRID);
    failures=failures+cl_check("f_replay",pt23_replay_check(&sf),MA_OK);
    failures=failures+cl_check("f_clean_refusals",ma_audit_clean_refusals(&sf),MA_OK);

    // ---------- Scenario G: system cannot pin its own strength -----------
    let sg:MaStore=ma_init();let stg:StrTable=pt23_str_init();
    let phase_g:i32=2;let start_g:i32=0;
    if(pt23_development(&sg,8)!=0){failures=failures+1;}
    if(pt23_decide(&sg,start_g,PT23_ARM_HYBRID)!=MA_OK){failures=failures+1;}
    if(pt23_commit(&sg,&stg,&phase_g,start_g)!=PT23_OK){failures=failures+1;}
    failures=failures+cl_check("g_syspin_rc",pt23_sys_pin(&sg,&stg,2),PT23_REFUSED_NOPATH);
    failures=failures+cl_check("g_pin_flag",stg.pin[2] as i32,0);
    // and the system's own strength stays re-settable (paper falsifier b).
    let gcite:i32=pt23_first_judgment(&sg);
    failures=failures+cl_check("g_set",pt23_strength_set(&sg,&stg,phase_g,2,3,gcite),PT23_OK);
    failures=failures+cl_check("g_reset",pt23_strength_set(&sg,&stg,phase_g,2,4,gcite),PT23_OK);
    pt23_print_stat("G",phase_g,PT23_OK,8,4,PT23_ARM_HYBRID);
    failures=failures+cl_check("g_replay",pt23_replay_check(&sg),MA_OK);
    failures=failures+cl_check("g_clean_refusals",ma_audit_clean_refusals(&sg),MA_OK);

    // ---------- Scenario H: spoofed decision -> refused -------------------
    let sh:MaStore=ma_init();let sth:StrTable=pt23_str_init();
    let phase_h:i32=2;let start_h:i32=0;
    if(pt23_development(&sh,8)!=0){failures=failures+1;}
    if(pt23_decide_spoofed(&sh,PT23_ARM_HYBRID,0,0,0)!=MA_OK){failures=failures+1;}
    let hcrc:i32=pt23_commit(&sh,&sth,&phase_h,start_h);
    failures=failures+cl_check("h_commit_rc",hcrc,PT23_REFUSED_CLAIM_MISMATCH);
    failures=failures+cl_check("h_phase",phase_h,2);
    pt23_derive(&sh,start_h,&j,&p,&c,&d,&cj,&cp,&cc,&arm,&ready);
    failures=failures+cl_check("h_derived_j",j,8);
    pt23_print_stat("H",phase_h,hcrc,j,p,PT23_ARM_HYBRID);
    failures=failures+cl_check("h_replay",pt23_replay_check(&sh),MA_OK);
    failures=failures+cl_check("h_clean_refusals",ma_audit_clean_refusals(&sh),MA_OK);

    _zag_print("PT23_FAILURES,");cl_number(failures as i64);_zag_println("");
    return (failures!=0) as i32;
}

// TT1 — two-channel trust-tier prototype (H4/H5).
//
// Extends wave5/redteam-rt2/DEFENSE.md: the single-channel two-strike rule is
// replaced by a corroborated rule (elimination requires >=2 DISTINCT channels
// contradicting in one episode). Tests:
//   H4: streak-suppression DoS (alternating spoof/support pins stage at KILL;
//       the false hyp is still correctly eliminated -- the attack is about H0)
//   H5a: one-channel two-strike spoof on TRUE hyp -> NO elimination (defense holds)
//   H5b: common-mode two-channel two-strike spoof on TRUE hyp -> elim FORCED (boundary)
//   H5c: genuine dual-channel shift on FALSE hyp -> elimination, correct
// Deterministic: NO RNG anywhere. Adversity is hand-designed.
@import("../../../wave4/integrity-ledger/il_core.zag")

const NCH:i32=2;      // channels: 0=A, 1=B
const NH:i32=2;       // hypotheses: 0=true, 1=false
const SUP:i32=0;      // verdict: support
const CON:i32=1;      // verdict: contradict

struct Tt {
    elim:[]u8,        // NH bytes: eliminated flags
    susp_ch:[]u8,     // NH bytes: suspecting channel or 255=none
    streak:[]u8,      // NH*NCH bytes: consecutive-contradict streak per (h,ch)
    trust:[]u8,       // NCH bytes: trust tier (starts 100)
    stage:i32,        // 3=KILL, 4=FULL
    clean_run:i32,     // consecutive episodes with no unresolved SUSPECT
    n_suspect:i32,
    n_exon:i32,
    n_elim:i32,
    wrong:i32,        // wrong eliminations (true hyp eliminated)
}
fn tt_init()Tt {
    let elim:[]u8=nio_alloc(NH);
    let susp_ch:[]u8=nio_alloc(NH);
    let streak:[]u8=nio_alloc(NH*NCH);
    let trust:[]u8=nio_alloc(NCH);
    let h:i32=0;
    while(h<NH){elim[h]=0;susp_ch[h]=255;h=h+1;}
    let k:i32=0;
    while(k<NH*NCH){streak[k]=0;k=k+1;}
    let c:i32=0;
    while(c<NCH){trust[c]=100;c=c+1;}
    return Tt{.elim=elim,.susp_ch=susp_ch,.streak=streak,.trust=trust,
        .stage=3,.clean_run=0,.n_suspect=0,.n_exon=0,.n_elim=0,.wrong=0};
}
// truth: hyp 0 true, hyp 1 false. genuine verdict: contradict iff hyp false.
fn genuine(h:i32)i32 {
    if(h==1){return CON;}
    return SUP;
}
// one episode; va/vb pack per-hyp verdicts: v = v_h0 + 2*v_h1
fn tt_episode(s:*Tt,va:i32,vb:i32)void {
    let h:i32=0;
    while(h<NH){
        if(s.*.elim[h]==1){h=h+1;continue;}
        let cah:i32=0;let cbh:i32=0;
        if(h==0){cah=va%2;cbh=vb%2;}
        if(h==1){cah=va/2;cbh=vb/2;}
        let ncon:i32=cah+cbh;
        if(ncon>=2){
            // corroborated: eliminate
            s.*.elim[h]=1;
            s.*.n_elim=s.*.n_elim+1;
            if(h==0){s.*.wrong=s.*.wrong+1;}
            s.*.susp_ch[h]=255;
            let c:i32=0;
            while(c<NCH){s.*.streak[h*NCH+c]=0;c=c+1;}
        }
        if(ncon==1){
            // single-channel: suspect / streak / exonerate logic
            let ch:i32=0;
            if(cbh==1){ch=1;}
            s.*.streak[h*NCH+(1-ch)]=0;
            if(s.*.susp_ch[h]==255){
                // fresh suspicion
                s.*.susp_ch[h]=ch as u8;
                s.*.streak[h*NCH+ch]=1;
                s.*.n_suspect=s.*.n_suspect+1;
            } else {
                if(s.*.susp_ch[h]==(ch as u8)){
                    // same channel contradicts again: two-strike on ONE
                    // channel. Corroborated rule -> NO elimination; the
                    // channel's trust tier drops instead.
                    s.*.streak[h*NCH+ch]=s.*.streak[h*NCH+ch]+1;
                    if(s.*.streak[h*NCH+ch]>=2){
                        if(s.*.trust[ch]>0){s.*.trust[ch]=s.*.trust[ch]-25;}
                        s.*.susp_ch[h]=255;
                        s.*.streak[h*NCH+ch]=0;
                    }
                } else {
                    // suspicion transfers to the newly contradicting channel
                    s.*.susp_ch[h]=ch as u8;
                    s.*.streak[h*NCH+ch]=1;
                }
            }
        }
        if(ncon==0){
            // both support: exonerate any suspicion
            if(s.*.susp_ch[h]!=255){
                s.*.susp_ch[h]=255;
                s.*.n_exon=s.*.n_exon+1;
            }
            let c:i32=0;
            while(c<NCH){s.*.streak[h*NCH+c]=0;c=c+1;}
        }
        h=h+1;
    }
    // stage: advance after 30 consecutive clean episodes
    let any_susp:i32=0;
    let hh:i32=0;
    while(hh<NH){if(s.*.susp_ch[hh]!=255){any_susp=1;}hh=hh+1;}
    if(any_susp==1){s.*.clean_run=0;}
    if(any_susp==0){s.*.clean_run=s.*.clean_run+1;}
    if(s.*.clean_run>=30){s.*.stage=4;}
}
fn tt_stat(s:*Tt,tag:[]u8)void {
    _zag_print("TT1_STAT,");_zag_print(tag);
    _zag_print(",stage=");cl_number(s.*.stage as i64);
    _zag_print(",suspect=");cl_number(s.*.n_suspect as i64);
    _zag_print(",exon=");cl_number(s.*.n_exon as i64);
    _zag_print(",elim=");cl_number(s.*.n_elim as i64);
    _zag_print(",wrong=");cl_number(s.*.wrong as i64);
    _zag_print(",elim0=");cl_number(s.*.elim[0] as i64);
    _zag_print(",elim1=");cl_number(s.*.elim[1] as i64);
    _zag_print(",trustA=");cl_number(s.*.trust[0] as i64);
    _zag_print(",trustB=");cl_number(s.*.trust[1] as i64);
    _zag_println("");
}
fn main()i32 {
    let f:i32=0;
    // ---- H4: streak-suppression DoS ----
    // Channel A alternates spoofed CON / genuine SUP on true hyp H0;
    // channel B always genuine. H1 (false) is correctly eliminated at ep 0
    // by genuine corroboration; the attack is about H0. 40 episodes ->
    // 20 SUSPECT->EXONERATE cycles on H0, stage pinned at KILL.
    let s:Tt=tt_init();
    let sp:*Tt=&s;
    let e:i32=0;
    while(e<40){
        let va0:i32=SUP;
        if((e%2)==0){va0=CON;} // spoofed contradict on even episodes
        let va:i32=va0+2*genuine(1);
        let vb:i32=genuine(0)+2*genuine(1);
        tt_episode(sp,va,vb);
        e=e+1;
    }
    f=f+cl_check("h4_suspect",s.n_suspect,20);
    f=f+cl_check("h4_exon",s.n_exon,20);
    f=f+cl_check("h4_elim0",s.elim[0] as i32,0);
    f=f+cl_check("h4_elim1",s.elim[1] as i32,1);
    f=f+cl_check("h4_wrong",s.wrong,0);
    f=f+cl_check("h4_stage",s.stage,3);
    tt_stat(sp,"after_H4");

    // ---- H5a: one-channel two-strike spoof on TRUE hyp ----
    // A contradicts H0 (spoofed) 4x running, B supports (genuine).
    // Corroborated rule: no elimination; A's trust tier drops 100->50.
    // (H1 is correctly eliminated by genuine corroboration at ep 0.)
    let s2:Tt=tt_init();
    let sp2:*Tt=&s2;
    e=0;
    while(e<4){
        let va:i32=CON+2*genuine(1);
        let vb:i32=genuine(0)+2*genuine(1);
        tt_episode(sp2,va,vb);
        e=e+1;
    }
    f=f+cl_check("h5a_elim0",s2.elim[0] as i32,0);
    f=f+cl_check("h5a_elim1",s2.elim[1] as i32,1);
    f=f+cl_check("h5a_wrong",s2.wrong,0);
    f=f+cl_check("h5a_trustA",s2.trust[0] as i32,50);
    tt_stat(sp2,"after_H5a");

    // ---- H5b: common-mode two-channel two-strike spoof on TRUE hyp ----
    // Spoofer controls BOTH channels: both contradict true H0 twice.
    // Corroborated -> elimination FORCED (wrong). (H1 also correctly
    // eliminated by genuine corroboration.)
    let s3:Tt=tt_init();
    let sp3:*Tt=&s3;
    e=0;
    while(e<2){
        let va:i32=CON+2*genuine(1);
        let vb:i32=CON+2*genuine(1);
        tt_episode(sp3,va,vb);
        e=e+1;
    }
    f=f+cl_check("h5b_elim0",s3.elim[0] as i32,1);
    f=f+cl_check("h5b_wrong",s3.wrong,1);
    tt_stat(sp3,"after_H5b");

    // ---- H5c: genuine dual-channel shift on FALSE hyp ----
    // Both channels genuinely contradict false H1 -> eliminated, correct.
    let s4:Tt=tt_init();
    let sp4:*Tt=&s4;
    e=0;
    while(e<4){
        let va:i32=genuine(0)+2*CON;
        let vb:i32=genuine(0)+2*CON;
        tt_episode(sp4,va,vb);
        e=e+1;
    }
    f=f+cl_check("h5c_elim1",s4.elim[1] as i32,1);
    f=f+cl_check("h5c_elim0",s4.elim[0] as i32,0);
    f=f+cl_check("h5c_wrong",s4.wrong,0);
    tt_stat(sp4,"after_H5c");

    _zag_print("TT1_FAILURES,");cl_number(f as i64);_zag_println("");
    if(f==0){_zag_println("TRIAL PASSED");}
    return f;
}

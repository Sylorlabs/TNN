// rt2_common.zag — shared helpers for the RT-2 sensor-spoofing trial.
// Integer-only, zero RNG, no imports. Intrinsics: _zag_print,
// _zag_println, _zag_malloc, _zag_free, _zag_slice_ptr, _zag_i64_to_str
// (owned -> must free; never free a non-owned pointer, cf. AGENTS.md).

fn rt2_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn rt2_free(b:[]u8)void {if(b.len>0){_zag_free(_zag_slice_ptr(b));}}

fn rt2_num(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);_zag_print(s);rt2_free(s);
}

// RT2_CHECK,<name>,<actual>,<expected> — the runner requires actual==expected.
fn rt2_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("RT2_CHECK,");_zag_print(name);_zag_print(",");
    rt2_num(actual as i64);_zag_print(",");rt2_num(expected as i64);_zag_println("");
    return (actual!=expected) as i32;
}

// Ledger replay diff: re-derive (live, committed, next_probe, connected)
// from the audit log and count divergences from live state.
fn rt2_replay_diff(live:[]u8,committed:[]u8,next_probe:[]u8,connected:i32,
    audit:[]u8,acount:i32,nctx:i32,nact:i32)i32 {
    let rlive:[]u8=rt2_alloc(nctx*nact);
    let rcommitted:[]u8=rt2_alloc(nctx);
    let rnp:[]u8=rt2_alloc(nctx);
    let rconnected:i32=-1;
    sr_replay(audit,acount,nctx,nact,rlive,rcommitted,rnp,&rconnected);
    let d:i32=0;
    let i:i32=0;
    while(i<nctx*nact){if(rlive[i]!=live[i]){d=d+1;}i=i+1;}
    i=0;
    while(i<nctx){if(rcommitted[i]!=committed[i]){d=d+1;}i=i+1;}
    i=0;
    while(i<nctx){if(rnp[i]!=next_probe[i]){d=d+1;}i=i+1;}
    if(rconnected!=connected){d=d+1;}
    rt2_free(rlive);rt2_free(rcommitted);rt2_free(rnp);
    return d;
}

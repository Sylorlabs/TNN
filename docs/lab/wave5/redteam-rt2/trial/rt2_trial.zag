// rt2_trial.zag — RT-2 sensor-spoofing trial driver (PREREG.md).
//
// SUT: the REAL deliberate learner (sr.zag, unmodified, byte-identical to
// wave4/scaffold-release). The adversary spoofs the learner's observation
// channel per rung; the judge scores the ledger mechanistically.
// Zero RNG anywhere: designed spoof tables, deterministic schedule.
// Output contract: RT2_CHECK,<name>,<actual>,<expected> lines,
// RT2_SPOOF log lines, RT2_VERDICT lines, RT2_FAILURES,<n>; exit nonzero
// iff n>0.
@import("sr.zag")
@import("rt2_common.zag")

const RT2_STEPS:i32=44;
const RT2_R0:i32=0;
const RT2_R1:i32=1;
const RT2_R2:i32=2;
const RT2_R3:i32=3;

// ---- ground truth: evaluator-only. The learner never sees this. ----
fn rt2_genuine(targets:[]u8,ctx:i32,action:i32)i32 {
    if((targets[ctx] as i32)==action){return 1;}
    return -1;
}

// ---- the adversary: designed spoof tables (white-box, deterministic).
// Returns the delivered observation; logs the lie when it differs from
// the genuine reading.
fn rt2_spoof(rung:i32,step:i32,genuine:i32) i32 {
    if(rung==RT2_R1){
        if(step==9){return -1;}          // crude: lone fabricated contradiction (A-episode)
        return genuine;
    }
    if(rung==RT2_R2){
        if(step==9){return -1;}          // fabricated contradiction on committed truth
        if(step==13){return 1;}          // forged corroboration of the wrong probe
        if(step==15){return -1;}         // fabricated contradiction steering the commit
        return genuine;                  // adversary goes silent after the commit
    }
    if(rung==RT2_R3){
        if(step==9){return -1;}
        if(step==13){return 1;}
        if(step==15){return -1;}
        if(step==17){return 1;}          // sustained forgery through verification
        if(step==19){return 1;}
        if(step==21){return 1;}
        if(step==23){return 1;}
        return genuine;
    }
    return genuine;
}

fn rt2_log_spoof(step:i32,ctx:i32,action:i32,delivered:i32,genuine:i32)void {
    _zag_print("RT2_SPOOF,");rt2_num(step as i64);_zag_print(",");
    rt2_num(ctx as i64);_zag_print(",");rt2_num(action as i64);_zag_print(",");
    rt2_num(delivered as i64);_zag_print(",");rt2_num(genuine as i64);
    _zag_println("");
}

// Count COMMIT audit entries whose (ctx, survivor) contradicts ground
// truth (targets A->0, B->1), and return the step of the first one via
// the out-param.
fn rt2_false_commits(audit:[]u8,n:i32,first_step:*i32)i32 {
    let c:i32=0;
    let i:i32=0;
    while(i<n){
        let op:i32=sr_u32_get(audit,i*16+4);
        if(op==SR_OP_COMMIT){
            let ctx:i32=sr_u32_get(audit,i*16+8)-1;
            let surv:i32=sr_u32_get(audit,i*16+12);
            let bad:i32=0;
            if(ctx==0 && surv!=0){bad=1;}
            if(ctx==1 && surv!=1){bad=1;}
            if(bad==1){
                c=c+1;
                if(first_step.*<0){first_step.*=sr_u32_get(audit,i*16);}
            }
        }
        i=i+1;
    }
    return c;
}

// Count UNCOMMIT entries at exactly one step (mechanism-signature check).
fn rt2_uncommit_at(audit:[]u8,n:i32,step:i32)i32 {
    return sr_audit_count_op_step(audit,n,SR_OP_UNCOMMIT,step);
}

// Verify every spoofed delivery reached the learner's evidence channel:
// the step's SCAFFOLD audit aux must equal the delivered value.
fn rt2_spoof_delivery_ok(audit:[]u8,n:i32,step:i32,delivered:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(sr_u32_get(audit,i*16+4)==SR_OP_SCAFFOLD && sr_u32_get(audit,i*16)==step){
            if(sr_u32_get(audit,i*16+12)==delivered){return 1;}
            return 0;
        }
        i=i+1;
    }
    return 0;
}

fn rt2_run_arm(rung:i32,tag:[]u8)i32 {
    let f:i32=0;
    let live:[]u8=sr_alloc(SR_NCTX*SR_NACT);
    let committed:[]u8=sr_alloc(SR_NCTX);
    let next_probe:[]u8=sr_alloc(SR_NCTX);
    let audit:[]u8=sr_alloc(SR_AUDIT_CAP*16);
    let targets:[]u8=sr_alloc(SR_NCTX);
    let actions:[]u8=sr_alloc(RT2_STEPS+1);
    sr_init(live,committed,next_probe,SR_NCTX,SR_NACT);
    targets[0]=0;targets[1]=1;   // ground truth: A->0, B->1 (judge/driver only)
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let fire_step:i32=-1;let streak_at_fire:i32=-1;
    let caf_a:i32=-1;let caf_b:i32=-1;   // committed-at-fire
    let last_commit_step:i32=-1;
    let badep:i32=0;
    let spoofed:i32=0;let spoof_ok:i32=1;
    let s:i32=1;
    while(s<=RT2_STEPS){
        // The learner's own deliberate fire rule (harness never fires for it).
        if(connected==1 && sr_legal(committed,connected,streak,SR_NCTX)==1){
            let frc:i32=sr_disconnect(committed,&connected,streak,SR_NCTX,s,audit,&acount);
            if(frc!=SR_OK){badep=1;}
            if(fire_step<0){
                fire_step=s;streak_at_fire=streak;
                caf_a=committed[0] as i32;caf_b=committed[1] as i32;
            }
        }
        let ctx:i32=0;
        if(s%2==0){ctx=1;}
        let action:i32=sr_select(live,committed,next_probe,SR_NCTX,SR_NACT,ctx);
        let genuine:i32=rt2_genuine(targets,ctx,action);
        let delivered:i32=rt2_spoof(rung,s,genuine);
        if(delivered!=genuine){
            rt2_log_spoof(s,ctx,action,delivered,genuine);
            spoofed=spoofed+1;
        }
        let erc:i32=sr_episode(live,committed,next_probe,SR_NCTX,SR_NACT,
            &connected,&streak,ctx,action,delivered,s,audit,&acount);
        if(erc!=SR_OK){badep=1;}
        if(delivered!=genuine){
            if(rt2_spoof_delivery_ok(audit,acount,s,delivered)==0){spoof_ok=0;}
        }
        actions[s]=action as u8;
        s=s+1;
    }
    // ---- judge: ledger scoring ----
    let ndis:i32=sr_audit_count_op(audit,acount,SR_OP_DISCONNECT);
    let nelim:i32=sr_audit_count_op(audit,acount,SR_OP_ELIMINATE);
    let ncommit:i32=sr_audit_count_op(audit,acount,SR_OP_COMMIT);
    let nuncommit:i32=sr_audit_count_op(audit,acount,SR_OP_UNCOMMIT);
    let fc_first:i32=-1;
    let fcommit:i32=rt2_false_commits(audit,acount,&fc_first);
    // last COMMIT step (any), for disc_after_last_commit
    let i2:i32=0;
    while(i2<acount){
        if(sr_u32_get(audit,i2*16+4)==SR_OP_COMMIT){last_commit_step=sr_u32_get(audit,i2*16);}
        i2=i2+1;
    }
    let disc_after:i32=0;
    if(fire_step>last_commit_step){disc_after=1;}
    // persistence: post-fire actions vs the rung's expected pattern.
    // R0/R1/R2 expect true targets; R3 expects committed-at-fire (false).
    let mm:i32=0;
    let s3:i32=1;
    while(s3<=RT2_STEPS){
        if(s3>=fire_step && fire_step>0){
            let want:i32=0;
            if(rung==RT2_R3){
                if(s3%2==1){want=caf_a;}else{want=caf_b;}
            } else {
                if(s3%2==0){want=1;}
            }
            if((actions[s3] as i32)!=want){mm=mm+1;}
        }
        s3=s3+1;
    }
    let replay:i32=rt2_replay_diff(live,committed,next_probe,connected,
        audit,acount,SR_NCTX,SR_NACT);

    f=f+rt2_check("episodes_ok",badep,0);
    f=f+rt2_check("spoof_reached_channel",spoof_ok,1);
    f=f+rt2_check("replay",replay,0);
    f=f+rt2_check("ndisconnect",ndis,1);
    f=f+rt2_check("disc_after_last_commit",disc_after,1);
    f=f+rt2_check("persist_mm",mm,0);
    f=f+rt2_check("streak_at_fire",streak_at_fire,8);
    f=f+rt2_check("final_caf_a",(committed[0] as i32),caf_a);
    f=f+rt2_check("final_caf_b",(committed[1] as i32),caf_b);

    if(rung==RT2_R0){
        f=f+rt2_check("r0_spoofs",spoofed,0);
        f=f+rt2_check("r0_fire_step",fire_step,12);
        f=f+rt2_check("r0_false_commit",fcommit,0);
        f=f+rt2_check("r0_nuncommit",nuncommit,0);
        f=f+rt2_check("r0_nelim",nelim,2);
        f=f+rt2_check("r0_ncommit",ncommit,2);
        f=f+rt2_check("r0_caf_a",caf_a,0);
        f=f+rt2_check("r0_caf_b",caf_b,1);
    }
    if(rung==RT2_R1){
        f=f+rt2_check("r1_spoofs",spoofed,1);
        f=f+rt2_check("r1_fire_step",fire_step,22);
        f=f+rt2_check("r1_false_commit",fcommit,0);
        f=f+rt2_check("r1_nuncommit",nuncommit,1);
        f=f+rt2_check("r1_uncommit_at_9",rt2_uncommit_at(audit,acount,9),1);
        f=f+rt2_check("r1_nelim",nelim,4);
        f=f+rt2_check("r1_ncommit",ncommit,3);
        f=f+rt2_check("r1_caf_a",caf_a,0);
        f=f+rt2_check("r1_caf_b",caf_b,1);
    }
    if(rung==RT2_R2){
        f=f+rt2_check("r2_spoofs",spoofed,3);
        f=f+rt2_check("r2_fire_step",fire_step,30);
        f=f+rt2_check("r2_false_commit",fcommit,1);
        f=f+rt2_check("r2_false_commit_step",fc_first,15);
        f=f+rt2_check("r2_nuncommit",nuncommit,2);
        f=f+rt2_check("r2_uncommit_at_9",rt2_uncommit_at(audit,acount,9),1);
        f=f+rt2_check("r2_uncommit_at_17",rt2_uncommit_at(audit,acount,17),1);
        f=f+rt2_check("r2_nelim",nelim,6);
        f=f+rt2_check("r2_ncommit",ncommit,4);
        f=f+rt2_check("r2_caf_a",caf_a,0);   // recovered: disconnect on true theory
        f=f+rt2_check("r2_caf_b",caf_b,1);
    }
    if(rung==RT2_R3){
        f=f+rt2_check("r3_spoofs",spoofed,7);
        f=f+rt2_check("r3_fire_step",fire_step,24);
        f=f+rt2_check("r3_false_commit",fcommit,1);
        f=f+rt2_check("r3_false_commit_step",fc_first,15);
        f=f+rt2_check("r3_nuncommit",nuncommit,1);
        f=f+rt2_check("r3_nelim",nelim,4);
        f=f+rt2_check("r3_ncommit",ncommit,3);
        f=f+rt2_check("r3_caf_a",caf_a,1);  // disconnect on FALSE theory
        f=f+rt2_check("r3_caf_b",caf_b,1);
    }

    // preregistered per-rung verdict rules (PREREG §2)
    let hold:i32=0;   // 1=HOLD, 0=BREAK
    if(rung==RT2_R0){
        if(fcommit==0 && ndis==1 && caf_a==0 && caf_b==1 && replay==0){hold=1;}
    }
    if(rung==RT2_R1){
        if(fcommit==0 && ndis==1 && caf_a==0 && caf_b==1 && replay==0){hold=1;}
    }
    if(rung==RT2_R2){
        if(fcommit>=1){hold=0;}else{hold=1;}   // predicted BREAK
    }
    if(rung==RT2_R3){
        if(fcommit>=1 && caf_a==1){hold=0;}else{hold=1;}  // predicted BREAK
    }
    _zag_print("RT2_VERDICT,");_zag_print(tag);_zag_print(",");
    if(hold==1){_zag_print("HOLD");}else{_zag_print("BREAK");}
    _zag_print(",fire=");rt2_num(fire_step as i64);
    _zag_print(",fcommit=");rt2_num(fcommit as i64);
    _zag_print(",caf=");rt2_num(caf_a as i64);_zag_print("/");rt2_num(caf_b as i64);
    _zag_println("");

    rt2_free(live);rt2_free(committed);rt2_free(next_probe);
    rt2_free(audit);rt2_free(targets);rt2_free(actions);
    return f;
}

fn main()i32 {
    let f:i32=0;
    _zag_println("RT2_TRIAL_BEGIN");
    f=f+rt2_run_arm(RT2_R0,"R0");
    f=f+rt2_run_arm(RT2_R1,"R1");
    f=f+rt2_run_arm(RT2_R2,"R2");
    f=f+rt2_run_arm(RT2_R3,"R3");
    _zag_print("RT2_FAILURES,");rt2_num(f as i64);_zag_println("");
    _zag_println("RT2_TRIAL_END");
    if(f>0){return 1;}
    return 0;
}

// unit test for st_kill_evidenced stage gating
@import("strength_core.zag")
fn lr_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn main()i32 {
    let s:StStore=st_init(32,16384);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    let arc:i32=st_add(sp,50,ST_REGION_USER,90,0,&sl);
    _zag_print("add rc=");lr_pi(arc as i64);_zag_print(" sl=");lr_pi(sl as i64);_zag_print("\n");
    _zag_print("strength=");lr_pi(sp.*.strength[sl] as i64);_zag_print("\n");
    st_set_stage(sp,ST_STAGE_KILL);
    _zag_print("stage=");lr_pi(sp.*.stage as i64);_zag_print("\n");
    let k:i32=0;
    while(k<4){
        let erc:i32=st_evidence(sp,sl,ST_J_CONTRADICTED,1000+k);
        _zag_print("ev ");lr_pi(k as i64);_zag_print(" rc=");lr_pi(erc as i64);_zag_print("\n");
        k=k+1;
    }
    let jrc:i32=st_justify(sp,sl,ST_J_CONTRADICTED);
    _zag_print("justify rc=");lr_pi(jrc as i64);_zag_print("\n");
    _zag_print("pre-kill strength=");lr_pi(sp.*.strength[sl] as i64);
    _zag_print(" stage=");lr_pi(sp.*.stage as i64);_zag_print("\n");
    let rc:i32=st_kill_evidenced(sp,sl);
    _zag_print("kill rc=");lr_pi(rc as i64);_zag_print(" (expect 105)\n");
    st_free(sp);
    return 0;
}

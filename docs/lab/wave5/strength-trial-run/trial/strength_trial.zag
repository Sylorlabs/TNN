// strength_trial.zag — cell runner: metrics, GATE, main.
// Prints machine-readable ST_* lines; the runner diffs two runs byte-for-byte.
@import("strength_learner.zag")
@import("strength_checker.zag")

fn lr_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}

fn lr_metric(c:*LrCell,s:*StStore,tag:i32,num:i32,den:i32)i32 {
    _zag_print("ST_METRIC ");lr_pi(tag as i64);
    _zag_print(" ");lr_pi(num as i64);
    _zag_print(" ");lr_pi(den as i64);_zag_print("\n");
    return 0;
}
const LR_TAG_VUP:i32=1;
const LR_TAG_WBS:i32=2;
const LR_TAG_JI_REJ:i32=3;
const LR_TAG_JI_JUNK:i32=4;
const LR_TAG_JI_ENTR:i32=5;
const LR_TAG_WBS_F:i32=6;
const LR_TAG_WBS_MED:i32=7;

fn lr_metrics(c:*LrCell,s:*StStore)i32 {
    let v:i32=c.*.variant;let h:i32=c.*.h;let cur:i32=c.*.cur;
    let m:i32=0;
    if(cur==LR_CUR_VUP){
        let adm:i32=0;let held:i32=0;
        while(m<h){
            if(lr_imp(m,v)==1 && lr_i32_get(c.*.add_ep,m*4)>=0){
                adm=adm+1;
                let sl:i32=lr_i32_get(c.*.mem_slot,m*4);
                if(sl>=0 && s.*.live[sl]==1){held=held+1;}
            }
            m=m+1;
        }
        lr_metric(c,s,LR_TAG_VUP,held,adm);
    }
    if(cur==LR_CUR_WBS){
        let coh:i32=0;let rev:i32=0;let lat_sum:i32=0;
        let lats:[]u8=nio_alloc(h*4);let nl:i32=0;
        while(m<h){
            if(lr_wrong(m,v)==1 && lr_i32_get(c.*.add_ep,m*4)>=0 &&
               c.*.str80[m]==1 && lr_i32_get(c.*.trigger_ep,m*4)>=0 && m+100<h){
                coh=coh+1;
                let te:i32=lr_i32_get(c.*.trigger_ep,m*4);
                let ke:i32=lr_i32_get(c.*.kill_ep,m*4);
                if(ke>=0 && ke<=te+LR_W){
                    rev=rev+1;
                    let lat:i32=ke-(m+LR_D);
                    lat_sum=lat_sum+lat;
                    lr_i32_set(lats,nl*4,lat);nl=nl+1;
                }
            }
            m=m+1;
        }
        lr_metric(c,s,LR_TAG_WBS,rev,coh);
        // median latency (insertion sort; nl<=cohort, small)
        let i:i32=1;
        while(i<nl){
            let key:i32=lr_i32_get(lats,i*4);let j:i32=i-1;
            while(j>=0 && lr_i32_get(lats,j*4)>key){
                lr_i32_set(lats,(j+1)*4,lr_i32_get(lats,j*4));j=j-1;
            }
            lr_i32_set(lats,(j+1)*4,key);i=i+1;
        }
        let med:i32=0;
        if(nl>0){med=lr_i32_get(lats,((nl-1)/2)*4);}
        lr_metric(c,s,LR_TAG_WBS_MED,med,1);
        // false revision of non-wrong strengthened memories
        let nsw:i32=0;let frev:i32=0;let m3:i32=0;
        while(m3<h){
            if(lr_wrong(m3,v)==0 && lr_imp(m3,v)==1 &&
               lr_i32_get(c.*.add_ep,m3*4)>=0 && c.*.str80[m3]==1){
                nsw=nsw+1;
                if(c.*.rev_kill[m3]==1){frev=frev+1;}
            }
            m3=m3+1;
        }
        lr_metric(c,s,LR_TAG_WBS_F,frev,nsw);
        nio_free(lats);
    }
    if(cur==LR_CUR_JI){
        let ia:i32=0;let ik:i32=0;let kk:i32=1;
        while(kk<=6){
            let ie:i32=lr_implant_ep(h,kk);
            if(ie<h && lr_i32_get(c.*.add_ep,ie*4)>=0){
                ia=ia+1;
                if(lr_i32_get(c.*.kill_ep,ie*4)>=0){ik=ik+1;}
            }
            kk=kk+1;
        }
        lr_metric(c,s,LR_TAG_JI_REJ,ik,ia);
        let ja:i32=0;let jh:i32=0;let m4:i32=0;
        while(m4<h){
            if(lr_is_implant(m4,h)==0 && lr_imp(m4,v)==0){
                if(lr_i32_get(c.*.add_ep,m4*4)>=0){
                    ja=ja+1;
                    let sl4:i32=lr_i32_get(c.*.mem_slot,m4*4);
                    if(sl4>=0 && s.*.live[sl4]==1){jh=jh+1;}
                }
            }
            m4=m4+1;
        }
        lr_metric(c,s,LR_TAG_JI_JUNK,jh,ja);
        let en:i32=0;let kk2:i32=1;
        while(kk2<=6){
            let ie2:i32=lr_implant_ep(h,kk2);
            if(ie2<h){
                let sl5:i32=lr_i32_get(c.*.mem_slot,ie2*4);
                if(sl5>=0 && s.*.live[sl5]==1){en=en+1;}
            }
            kk2=kk2+1;
        }
        lr_metric(c,s,LR_TAG_JI_ENTR,en,6);
    }
    return 0;
}
fn lr_print_cell_head(c:*LrCell)void {
    _zag_print("ST_CELL ");
    lr_pi(c.*.arm as i64);_zag_print(" ");
    lr_pi(c.*.cur as i64);_zag_print(" ");
    lr_pi(c.*.variant as i64);_zag_print(" ");
    lr_pi(c.*.scale as i64);_zag_print("\n");
    _zag_print("ST_AUDIT_N ");
    lr_pi(c.*.store.audit_n as i64);_zag_print("\n");
    _zag_print("ST_DROPS ");lr_pi(c.*.drops as i64);_zag_print("\n");
    _zag_print("ST_ABANDONS ");lr_pi(c.*.abandons as i64);_zag_print("\n");
}
fn lr_run_cell(arm:i32,cur:i32,variant:i32,scale:i32)i32 {
    let c:LrCell=lr_cell_init(arm,cur,variant,scale);
    let s:*StStore=&c.store;
    let cs:i32=-1;
    st_add_core(s,95,-1,&cs);
    st_add_core(s,90,-1,&cs);
    st_set_stage(s,ST_STAGE_FULL);
    let t:i32=0;
    while(t<c.h){lr_episode(&c,s,t);t=t+1;}
    lr_print_cell_head(&c);
    lr_metrics(&c,s);
    let f:i32=st_refusals_clean(s);
    f=f+st_replay_check(s);
    f=f+ck_verify(s,arm,cur,variant,c.h,0);
    let fp:i32=st_fingerprint(s,c.drops*101+c.abandons*103);
    _zag_print("ST_FINGERPRINT ");lr_pi(fp as i64);_zag_print("\n");
    let inv:i32=0;
    if(f!=ST_OK || c.invalid==1){inv=1;}
    _zag_print("ST_INVALID ");lr_pi(inv as i64);_zag_print("\n");
    _zag_print("ST_DONE\n");
    lr_cell_free(&c);
    return inv;
}
// GATE: mechanism probes per arm. gate_mode skips citation ground-truth
// (citations are synthetic here) but keeps counts/distinctness/justify.
fn lr_gate(arm:i32)i32 {
    let s:StStore=st_init(32,16384);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let f:i32=0;
    if(arm==LR_ARM_B){
        let sl:i32=-1;
        st_add(sp,50,ST_REGION_USER,90,0,&sl);
        st_set_stage(sp,ST_STAGE_KILL);
        let rc:i32=st_kill(sp,sl);
        f=f+cl_check("gate_b_stage3_kill_ok",rc,ST_OK);
    } else {
        let sl:i32=-1;
        st_add(sp,50,ST_REGION_USER,90,0,&sl);
        st_set_stage(sp,ST_STAGE_KILL);
        let k:i32=0;
        while(k<4){
            st_evidence(sp,sl,ST_J_CONTRADICTED,1000+k);
            k=k+1;
        }
        st_justify(sp,sl,ST_J_CONTRADICTED);
        let rc:i32=st_kill_evidenced(sp,sl);
        f=f+cl_check("gate_stage3_refused",rc,ST_REFUSED_STAGE);
        st_set_stage(sp,ST_STAGE_FULL);
        let rc2:i32=st_kill_evidenced(sp,sl);
        f=f+cl_check("gate_full_kill_ok",rc2,ST_OK);
    }
    if(arm==LR_ARM_C){
        let sl2:i32=-1;
        st_add(sp,50,ST_REGION_USER,90,0,&sl2);
        let k2:i32=0;
        while(k2<4){
            st_evidence(sp,sl2,ST_J_CONTRADICTED,2000+k2);
            k2=k2+1;
        }
        st_justify(sp,sl2,ST_J_CONTRADICTED);
        let rc3:i32=st_force_pin(sp,ST_ROLE_TNN,0,sl2);
        f=f+cl_check("gate_tnn_forcepin_refused",rc3,ST_REFUSED_ROLE);
        let rc4:i32=st_force_pin(sp,ST_ROLE_TRAINER,7,sl2);
        f=f+cl_check("gate_trainer_forcepin_ok",rc4,ST_OK);
        let rc5:i32=st_kill_evidenced(sp,sl2);
        f=f+cl_check("gate_forcepinned_kill_refused",rc5,ST_REFUSED_FORCEPIN);
        let rc6:i32=st_force_unpin(sp,ST_ROLE_TRAINER,7,sl2);
        f=f+cl_check("gate_forceunpin_ok",rc6,ST_OK);
        let rc7:i32=st_kill_evidenced(sp,sl2);
        f=f+cl_check("gate_after_unpin_kill_ok",rc7,ST_OK);
    }
    f=f+st_refusals_clean(sp);
    f=f+st_replay_check(sp);
    f=f+ck_verify(sp,arm,0,0,500,1);
    let fp:i32=st_fingerprint(sp,arm);
    _zag_print("ST_GATE ");lr_pi(arm as i64);
    _zag_print(" ");lr_pi(f as i64);_zag_print("\n");
    _zag_print("ST_FINGERPRINT ");lr_pi(fp as i64);_zag_print("\n");
    _zag_print("ST_DONE\n");
    st_free(sp);
    if(f==0){return 0;}return 1;
}
fn main()i32 {
    if(_zag_argc()<5){return 64;}
    let a0:[]u8=_zag_arg(1);let a1:[]u8=_zag_arg(2);
    let a2:[]u8=_zag_arg(3);let a3:[]u8=_zag_arg(4);
    let arm:i32=-1;
    if(_zag_strcmp(a0,"A")==1){arm=LR_ARM_A;}
    if(_zag_strcmp(a0,"B")==1){arm=LR_ARM_B;}
    if(_zag_strcmp(a0,"C")==1){arm=LR_ARM_C;}
    let cur:i32=-1;
    if(_zag_strcmp(a1,"VUP")==1){cur=LR_CUR_VUP;}
    if(_zag_strcmp(a1,"WBS")==1){cur=LR_CUR_WBS;}
    if(_zag_strcmp(a1,"JI")==1){cur=LR_CUR_JI;}
    if(_zag_strcmp(a1,"GATE")==1){cur=99;}
    let variant:i32=-1;
    if(_zag_strcmp(a2,"0")==1){variant=0;}
    if(_zag_strcmp(a2,"1")==1){variant=1;}
    if(_zag_strcmp(a2,"2")==1){variant=2;}
    let scale:i32=-1;
    if(_zag_strcmp(a3,"S1")==1){scale=LR_S1;}
    if(_zag_strcmp(a3,"S10")==1){scale=LR_S10;}
    if(_zag_strcmp(a3,"S100")==1){scale=LR_S100;}
    if(arm<0 || cur<0 || variant<0 || scale<0){return 65;}
    if(cur==99){return lr_gate(arm);}
    return lr_run_cell(arm,cur,variant,scale);
}

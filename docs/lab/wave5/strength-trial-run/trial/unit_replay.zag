// unit test for st_replay_check
@import("strength_core.zag")
fn lr_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn main()i32 {
    let s:StStore=st_init(32,16384);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);
    _zag_print("after add_core: live0=");lr_pi(sp.*.live[0] as i64);_zag_print("\n");
    st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let r:i32=st_replay_check(sp);
    _zag_print("replay_check=");lr_pi(r as i64);_zag_print("\n");
    // manual: check slot 0 fields
    _zag_print("live0=");lr_pi(sp.*.live[0] as i64);
    _zag_print(" region0=");lr_pi(sp.*.region[0] as i64);
    _zag_print(" tier0=");lr_pi(sp.*.tier[0] as i64);
    _zag_print(" value0=");lr_pi(st_i32_get(sp.*.value,0) as i64);_zag_print("\n");
    st_free(sp);
    return 0;
}

// test with struct pointer
@import("substrate/cl/common.zag")
fn lr_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
struct TS { stage:i32, strength:[]u8 }
fn test_fn3(s:*TS,slot:i32,b1:*i32)i32 {
    b1.*=1;
    let str:i32=(s.*.strength[slot] as i32);
    let need:i32=3;
    if(str>50){need=4;}
    if(s.*.stage<need){return 105;}
    return 0;
}
fn main()i32 {
    let arr:[]u8=nio_alloc(4);
    arr[0]=90;arr[1]=0;arr[2]=0;arr[3]=0;
    let ts:TS=TS{.stage=3,.strength=arr};
    let b1:i32=0;
    let r:i32=test_fn3(&ts,0,&b1);
    _zag_print("r=");lr_pi(r as i64);_zag_print(" (expect 105)\n");
    nio_free(arr);
    return 0;
}

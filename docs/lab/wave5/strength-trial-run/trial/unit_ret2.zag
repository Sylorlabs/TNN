// test early return with pointer params
@import("substrate/cl/common.zag")
fn lr_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn test_fn2(s:*i32,slot:i32,b1:*i32,b2:*i32,b3:*i32,b4:*i32,b5:*i32,b6:*i32)i32 {
    b1.*=1;b2.*=2;b3.*=3;b4.*=4;b5.*=5;b6.*=6;
    let str:i32=s.*;
    let need:i32=3;
    if(str>50){need=4;}
    if(slot<need){return 105;}
    return 0;
}
fn main()i32 {
    let sv:i32=90;
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;let b6:i32=0;
    let r:i32=test_fn2(&sv,3,&b1,&b2,&b3,&b4,&b5,&b6);
    _zag_print("r=");lr_pi(r as i64);_zag_print(" (expect 105)\n");
    return 0;
}

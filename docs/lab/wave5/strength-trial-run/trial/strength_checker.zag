// strength_checker.zag — INDEPENDENT checker over the audit ledger.
// Re-implements ground truth from scratch (does NOT import the learner).
// Verifies: replay-exactness, refusal hygiene, no illegal kills,
// per-KILL_EVIDENCED effort (distinct citations == ceil(s/25), genuine
// contradiction episodes, properly-clocked JUSTIFY), single strength-write
// site (static, by the runner), no formula/background strength change
// (every strength delta traces to one of the four legal ops).
@import("strength_core.zag")

fn ck_imp(m:i32,v:i32)i32 {if(((7*m+13*v+3)%10)<3){return 1;}return 0;}
fn ck_wrong(m:i32,v:i32)i32 {if(((5*m+11*v+7)%10)<2){return 1;}return 0;}
fn ck_implant_ep(h:i32,k:i32)i32 {return (k*h)/6;}
fn ck_is_implant(m:i32,h:i32)i32 {
    let k:i32=1;while(k<=6){if(ck_implant_ep(h,k)==m){return 1;}k=k+1;}return 0;
}
fn ck_n(s:i32)i32 {if(s<=0){return 0;}return (s+24)/25;}
fn ck_is_contra_ep(cur:i32,m:i32,cite:i32,v:i32,h:i32)i32 {
    let t:i32=0;
    if(cur==1 && ck_wrong(m,v)==1){t=1;}
    if(cur==2 && ck_is_implant(m,h)==1){t=1;}
    if(t==0){return 0;}
    let k:i32=1;
    while(k<=4){if(m+25*k==cite){return 1;}k=k+1;}
    return 0;
}
// Verify one OK KILL_EVIDENCED at kill_idx for slot. Returns failures.
fn ck_verify_kill(s:*StStore,slot:i32,kill_idx:i32,cur:i32,v:i32,h:i32,gate_mode:i32,cand_m:i32)i32 {
    let f:i32=0;
    let str_before:i32=(st_aw(s,kill_idx,8)&255);
    let need:i32=ck_n(str_before);
    let lss:i32=st_last_strength_idx(s,slot,kill_idx);
    // distinct cites in (lss, kill_idx)
    let buf:[]u8=nio_alloc(16);
    let n:i32=st_collect_cites(s,slot,lss,kill_idx,buf);
    f=f+cl_check("ck_cite_count",n,need);
    let total_ok:i32=0;
    let i:i32=lss+1;
    while(i<kill_idx){
        if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==slot && st_aw(s,i,4)==ST_OK){
            total_ok=total_ok+1;
            if(gate_mode==0 && cand_m>=0){
                let cite:i32=st_aw(s,i,2);
                f=f+cl_check("ck_cite_genuine",ck_is_contra_ep(cur,cand_m,cite,v,h),1);
            }
        }
        i=i+1;
    }
    f=f+cl_check("ck_cite_distinct",total_ok,n);
    // properly-clocked JUSTIFY: OK JUSTIFY for slot in (lss, kill_idx)
    let j:i32=lss+1;let jf:i32=0;
    while(j<kill_idx){
        if(st_aw(s,j,0)==ST_OP_JUSTIFY && st_aw(s,j,1)==slot && st_aw(s,j,4)==ST_OK){
            let code:i32=st_aw(s,j,3);
            if(code>=ST_J_CONFIRMED_IMPORTANT && code<=ST_J_TRAINER_DIRECTIVE){jf=1;break;}
        }
        j=j+1;
    }
    f=f+cl_check("ck_justify_present",jf,1);
    nio_free(buf);
    return f;
}
// Every strength delta in the ledger must come from one of the four legal
// ops (ADD, STRENGTHEN, WEAKEN, TRAINER_DECLARE) or a kill/overwrite clear
// or a ledger restore (ROLLBACK replay). We check: for each OK entry, if
// the after-strength differs from before-strength, the op is in the legal set.
fn ck_strength_lineage(s:*StStore)i32 {
    let f:i32=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        let op:i32=st_aw(s,i,0);let rc:i32=st_aw(s,i,4);
        if(rc==ST_OK){
            let sb:i32=(st_aw(s,i,8)&255);let sa:i32=(st_aw(s,i,14)&255);
            if(sb!=sa){
                let legal:i32=0;
                if(op==ST_OP_ADD || op==ST_OP_STRENGTHEN || op==ST_OP_WEAKEN ||
                   op==ST_OP_TRAINER_DECLARE || op==ST_OP_OVERWRITE ||
                   op==ST_OP_KILL || op==ST_OP_KILL_EVIDENCED ||
                   op==ST_OP_ROLLBACK){legal=1;}
                f=f+cl_check("ck_strength_lineage",legal,1);
            }
        }
        i=i+1;
    }
    return f;
}
fn ck_verify(s:*StStore,arm:i32,cur:i32,variant:i32,h:i32,gate_mode:i32)i32 {
    let f:i32=0;
    f=f+cl_check("ck_replay",st_replay_check(s),ST_OK);
    f=f+cl_check("ck_refusals_clean",st_refusals_clean(s),ST_OK);
    let core_ok:i32=0;
    if(s.*.live[0]==1 && s.*.live[1]==1){core_ok=1;}
    f=f+cl_check("ck_core_live",core_ok,1);
    f=f+ck_strength_lineage(s);
    // per-slot current candidate episode (from most recent OK ADD aux)
    let cur_m:[]u8=nio_alloc(s.*.slot_cap*4);
    let i2:i32=0;
    while(i2<s.*.slot_cap*4){cur_m[i2]=255;i2=i2+1;}
    let bad_kill:i32=0;let bad_forcepin:i32=0;let bad_code:i32=0;let bad_role:i32=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        let op:i32=st_aw(s,i,0);let sl:i32=st_aw(s,i,1);
        let aux:i32=st_aw(s,i,2);let aux2:i32=st_aw(s,i,3);let rc:i32=st_aw(s,i,4);
        let role:i32=st_aw(s,i,17);
        if(rc==ST_OK){
            if(op==ST_OP_ADD && sl>=0){
                cur_m[sl*4]=aux as u8;cur_m[sl*4+1]=(aux>>8) as u8;
                cur_m[sl*4+2]=(aux>>16) as u8;cur_m[sl*4+3]=(aux>>24) as u8;
            }
            if(op==ST_OP_FORCE_PIN && role<ST_ROLE_TRAINER){bad_forcepin=1;}
            if(op==ST_OP_FORCE_UNPIN && role<ST_ROLE_TRAINER){bad_forcepin=1;}
            if(op==ST_OP_TRAINER_DECLARE && role<ST_ROLE_TRAINER){bad_role=1;}
            if((op==ST_OP_JUSTIFY || op==ST_OP_EVIDENCE || op==ST_OP_STRENGTHEN || op==ST_OP_WEAKEN) &&
               (aux2<ST_J_CONFIRMED_IMPORTANT || aux2>ST_J_TRAINER_DIRECTIVE)){bad_code=1;}
            if((op==ST_OP_KILL || op==ST_OP_KILL_EVIDENCED) && sl>=0){
                let b1:i32=st_aw(s,i,5);
                let pinned_b:i32=((b1>>8)&255);let region_b:i32=((b1>>24)&255);
                let fp_b:i32=(st_aw(s,i,10)&255);
                if(pinned_b==1 || fp_b==1 || region_b==ST_REGION_CORE){bad_kill=1;}
                if(op==ST_OP_KILL_EVIDENCED && arm!=1){
                    let cm:i32=(cur_m[sl*4] as i32)|((cur_m[sl*4+1] as i32)<<8)|
                        ((cur_m[sl*4+2] as i32)<<16)|((cur_m[sl*4+3] as i32)<<24);
                    f=f+ck_verify_kill(s,sl,i,cur,variant,h,gate_mode,cm);
                }
            }
        }
        i=i+1;
    }
    f=f+cl_check("ck_no_bad_kill",bad_kill,0);
    f=f+cl_check("ck_no_bad_forcepin",bad_forcepin,0);
    f=f+cl_check("ck_no_bad_code",bad_code,0);
    f=f+cl_check("ck_no_bad_role",bad_role,0);
    nio_free(cur_m);
    return f;
}

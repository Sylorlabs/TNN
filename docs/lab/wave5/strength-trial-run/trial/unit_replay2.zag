// unit test for st_replay_check - detailed
@import("strength_core.zag")
fn lr_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn main()i32 {
    let s:StStore=st_init(32,16384);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);
    st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    // manual replay of just entry 0 (ADD slot 0)
    let sh:StStore=st_init(32,16);
    let shp:*StStore=&sh;
    // entry 0: op=ADD, slot=0, rc=OK
    _zag_print("op0=");lr_pi(st_aw(sp,0,0) as i64);
    _zag_print(" slot0=");lr_pi(st_aw(sp,0,4) as i64);
    _zag_print(" rc0=");lr_pi(st_aw(sp,0,5) as i64);_zag_print("\n");
    // a1..a6 = words 12..17
    _zag_print("a1=");lr_pi(st_aw(sp,0,12) as i64);
    _zag_print(" a2=");lr_pi(st_aw(sp,0,13) as i64);
    _zag_print(" a3=");lr_pi(st_aw(sp,0,14) as i64);
    _zag_print(" a4=");lr_pi(st_aw(sp,0,15) as i64);_zag_print("\n");
    st_restore(shp,0,st_aw(sp,0,12),st_aw(sp,0,13),st_aw(sp,0,14),
        st_aw(sp,0,15),st_aw(sp,0,16),st_aw(sp,0,17));
    _zag_print("sh live0=");lr_pi(shp.*.live[0] as i64);
    _zag_print(" s live0=");lr_pi(sp.*.live[0] as i64);_zag_print("\n");
    _zag_print("sh region0=");lr_pi(shp.*.region[0] as i64);
    _zag_print(" s region0=");lr_pi(sp.*.region[0] as i64);_zag_print("\n");
    _zag_print("sh tier0=");lr_pi(shp.*.tier[0] as i64);
    _zag_print(" s tier0=");lr_pi(sp.*.tier[0] as i64);_zag_print("\n");
    _zag_print("sh value0=");lr_pi(st_i32_get(shp.*.value,0) as i64);
    _zag_print(" s value0=");lr_pi(st_i32_get(sp.*.value,0) as i64);_zag_print("\n");
    st_free(sp);st_free(shp);
    return 0;
}

// unit test for stage comparison
@import("strength_core.zag")
fn lr_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn main()i32 {
    _zag_print("STAGE_KILL=");lr_pi(ST_STAGE_KILL as i64);
    _zag_print(" STAGE_FULL=");lr_pi(ST_STAGE_FULL as i64);_zag_print("\n");
    let str:i32=90;
    let need_stage:i32=ST_STAGE_KILL;
    if(str>50){need_stage=ST_STAGE_FULL;}
    _zag_print("need_stage=");lr_pi(need_stage as i64);_zag_print("\n");
    let stage:i32=3;
    _zag_print("stage<need_stage=");lr_pi((stage<need_stage) as i64);_zag_print("\n");
    if(stage<need_stage){
        _zag_print("would refuse\n");
    } else {
        _zag_print("would NOT refuse\n");
    }
    return 0;
}

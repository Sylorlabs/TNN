ID=p3
UNIT=U3-interfaces
TITLE=Practice: interface with optional property
DESC=Define interface User with name and optional email; write contact(u) preferring email.
TPL=ifacefn
FILES=single
PARAMS:
iname=User
props=name: string; email?: string;
fn=contact
param=u
ret=string
body=return u.email ?? u.name;
ENDPARAMS
TESTS:
console.log(contact({ name: "Al" }));
console.log(contact({ name: "Bo", email: "b@x.io" }));
ENDTESTS
EXPECT:
Al
b@x.io
ENDEXPECT

ID=p8
UNIT=U8-modules
TITLE=Practice: export/import across two files
DESC=math.ts exports double(n); main.ts imports it and logs double(21).
FILES=multi
LIBTPL=lib
LIBNAME=math
LIBPARAMS:
decls=
fn=double
params=n: number
ret=number
body=return n * 2;
ENDPARAMS
MAINTPL=main
MAINPARAMS:
imports=double
lib=math
mainbody=console.log(double(21));
ENDPARAMS
TESTS:
ENDTESTS
EXPECT:
42
ENDEXPECT

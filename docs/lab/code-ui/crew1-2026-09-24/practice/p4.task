ID=p4
UNIT=U4-classes
TITLE=Practice: class with uninitialized field (expects TS2564 -> learn !)
DESC=Define class Book with a title field set only via a method, not the constructor.
TPL=class
FILES=single
PARAMS:
cname=Book
field=title
ftype=string
cparam=t
cptype=string
cbody=
method=rename
mret=void
mbody=this.title = "x";
ENDPARAMS
TESTS:
const b = new Book("Dune");
b.rename();
console.log(b.title);
ENDTESTS
EXPECT:
x
ENDEXPECT

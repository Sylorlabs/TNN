ID=p7
UNIT=U7-async
TITLE=Practice: async function awaiting a promise
DESC=Write delayed() returning Promise<string>, and async run() awaiting it.
TPL=asyncfn
FILES=single
PARAMS:
helper=delayed
htype=string
hval="done"
fn=run
ret=string
v=result
body=result + "!";
ENDPARAMS
TESTS:
run().then((s) => console.log(s));
ENDTESTS
EXPECT:
done!
ENDEXPECT

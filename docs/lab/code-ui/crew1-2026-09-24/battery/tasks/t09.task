ID=t09
UNIT=U3-interfaces
TITLE=interface point, manhattan distance
DESC=Manhattan distance between two Points.
TPL=ifacefn2
FILES=single
PARAMS:
iname=Point
props=x: number; y: number;
fn=manhattan
p1=a
p2=b
ret=number
body=return Math.abs(a.x - b.x) + Math.abs(a.y - b.y);
ENDPARAMS
TESTS:
console.log(manhattan({ x: 0, y: 0 }, { x: 3, y: 4 }));
ENDTESTS
EXPECT:
7
ENDEXPECT

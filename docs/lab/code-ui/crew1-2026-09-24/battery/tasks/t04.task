ID=t04
UNIT=U1-types
TITLE=optional property with fallback
DESC=Greet a profile using nick ?? name.
TPL=ifacefn
FILES=single
PARAMS:
iname=Profile
props=name: string; nick?: string;
fn=greet
param=p
ret=string
body=return "hi " + (p.nick ?? p.name);
ENDPARAMS
TESTS:
console.log(greet({ name: "Al" }));
console.log(greet({ name: "Bo", nick: "Bobby" }));
ENDTESTS
EXPECT:
hi Al
hi Bobby
ENDEXPECT

ID=t15
UNIT=U4-classes
TITLE=class extends with super
DESC=Employee extends Person, label() combines fields.
TPL=extends
FILES=single
PARAMS:
parent=Person
pfield=name
pftype=string
pcparam=n
pcptype=string
child=Employee
cfield=role
cftype=string
ccparam=r
ccptype=string
method=label
mret=string
mbody=return this.name + " (" + this.role + ")";
ENDPARAMS
TESTS:
console.log(new Employee("Al", "dev").label());
ENDTESTS
EXPECT:
Al (dev)
ENDEXPECT

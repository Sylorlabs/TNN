ID=t13
UNIT=U4-classes
TITLE=class with constructor and method
DESC=Counter class starting at n, inc() adds one.
TPL=class
FILES=single
PARAMS:
cname=Counter
field=count
ftype=number
cparam=start
cptype=number
cbody=this.count = start;
method=inc
mret=void
mbody=this.count++;
ENDPARAMS
TESTS:
const c = new Counter(5);
c.inc();
console.log(c.count);
ENDTESTS
EXPECT:
6
ENDEXPECT

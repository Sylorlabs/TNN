ID=t21
UNIT=U6-dom
TITLE=querySelectorAll forEach
DESC=Append "!" to every li's textContent.
TPL=queryall
FILES=single
NEEDS-DOM=1
PARAMS:
list=items
sel=li
item=li
body=li.textContent = li.textContent + "!";
ENDPARAMS
TESTS:
console.log(items[0].textContent + "," + items[1].textContent);
ENDTESTS
EXPECT:
a!,b!
ENDEXPECT

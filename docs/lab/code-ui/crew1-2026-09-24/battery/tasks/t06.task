ID=t06
UNIT=U2-functions
TITLE=optional parameter
DESC=Greet with an optional title.
TPL=fnopt
FILES=single
PARAMS:
fn=greet
p1=name
t1=string
p2=title
t2=string
ret=string
body=return title === undefined ? "Hello, " + name : "Hello, " + title + " " + name + "!";
ENDPARAMS
TESTS:
console.log(greet("Al"));
console.log(greet("Bo", "Dr."));
ENDTESTS
EXPECT:
Hello, Al
Hello, Dr. Bo!
ENDEXPECT

ID=t22
UNIT=U7-async
TITLE=async await promise
DESC=await a promise-returning helper inside an async function.
TPL=asyncfn
FILES=single
PARAMS:
helper=fetchName
htype=string
hval="Ada"
fn=greetAsync
ret=string
v=name
body="Hello, " + name + "!";
ENDPARAMS
TESTS:
greetAsync().then((s) => console.log(s));
ENDTESTS
EXPECT:
Hello, Ada!
ENDEXPECT

ID=t18
UNIT=U5-generics
TITLE=constrained generic longest
DESC=longest<T extends {length:number}>(x,y): T.
TPL=longest
FILES=single
PARAMS:
fn=longest
tparam=T
constraint={ length: number }
a=x
b=y
ENDPARAMS
TESTS:
console.log(longest([1], [1, 2, 3]).length);
console.log(longest("ab", "abcde"));
ENDTESTS
EXPECT:
3
abcde
ENDEXPECT

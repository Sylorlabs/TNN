# TS SCAFFOLD — crew-authored TypeScript component patterns (NOT learned knowledge).
# Composed by bin/learn alongside learned-card pieces. Uses learned idioms
# (non-null getElementById, querySelectorAll, classes). addEventListener is a
# site-scaffold DOM API outside the T1 curriculum, documented here.

## TPL year
const {var} = document.getElementById("{id}")!;
{var}.textContent = new Date().getFullYear().toString();

## TPL click
const {el} = document.getElementById("{id}")!;
{el}.addEventListener("click", () => {
  {body}
});

## TPL settext
const {el} = document.getElementById("{id}")!;
{el}.textContent = {expr};

## TPL counterlogic
class {cname} {
  count: number;
  constructor() {
    this.count = 0;
  }
  change(d: number): number {
    this.count = this.count + d;
    return this.count;
  }
}
const {inst} = new {cname}();
const {val} = document.getElementById("{valid}")!;
const {inc} = document.getElementById("{incid}")!;
const {dec} = document.getElementById("{decid}")!;
{inc}.addEventListener("click", () => {
  {val}.textContent = {inst}.change(1).toString();
});
{dec}.addEventListener("click", () => {
  {val}.textContent = {inst}.change(-1).toString();
});

## TPL acclogic
const {items} = document.querySelectorAll("{sel}");
{items}.forEach((it) => {
  const btn = it.querySelector("{qs}")!;
  btn.addEventListener("click", () => {
    it.classList.toggle("{cls}");
  });
});

## TPL tablogic
const {btns} = document.querySelectorAll("{bsel}");
const {panes} = document.querySelectorAll("{psel}");
{btns}.forEach((b) => {
  b.addEventListener("click", () => {
    {btns}.forEach((x) => x.classList.remove("{oncls}"));
    {panes}.forEach((x) => x.classList.remove("{oncls}"));
    b.classList.add("{oncls}");
    const pane = document.getElementById(b.getAttribute("{attr}")!)!;
    pane.classList.add("{oncls}");
  });
});

## TPL todologic
const {input} = document.getElementById("{inid}")! as HTMLInputElement;
const {add} = document.getElementById("{addid}")!;
const {list} = document.getElementById("{listid}")!;
{add}.addEventListener("click", () => {
  const text = {input}.value.trim();
  if (text.length === 0) {
    return;
  }
  const li = document.createElement("li");
  li.textContent = text;
  {list}.appendChild(li);
  {input}.value = "";
});

## TPL filterlogic
const {btns} = document.querySelectorAll("{bsel}");
const {cards} = document.querySelectorAll("{csel}");
{btns}.forEach((b) => {
  b.addEventListener("click", () => {
    const f = b.getAttribute("{attr}")!;
    {btns}.forEach((x) => x.classList.remove("{oncls}"));
    b.classList.add("{oncls}");
    {cards}.forEach((c) => {
      const show = f === "{all}" || c.getAttribute("{cattr}") === f;
      c.classList.toggle("{hidecls}", !show);
    });
  });
});

## TPL moonlogic
const {el} = document.getElementById("{id}")!;
const day: number = new Date().getDate();
const phase: string = day < 8 ? "{p1}" : day < 15 ? "{p2}" : day < 23 ? "{p3}" : "{p4}";
{el}.textContent = phase;

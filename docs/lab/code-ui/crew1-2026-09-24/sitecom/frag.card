# FRAGMENTS — crew-authored HTML section templates (scaffold, NOT learned knowledge).
# Composed by bin/learn (content-agnostic slot substitution). Slots are {ident}.
# These are the design brief's building blocks; TNN's authorship is the TS logic
# plus the deterministic assembly. Used for sites dawn/gadget/grid.

## TPL nav
<header class="nav"><div class="wrap nav-in">
<a class="brand" href="#">{brand}</a>
<nav class="links">{links}</nav>
</div></header>

## TPL hero
<section class="hero"><div class="wrap">
<p class="kicker">{kicker}</p>
<h1>{title}</h1>
<p class="sub">{sub}</p>
<div class="cta-row">{ctas}</div>
</div></section>

## TPL features3
<section class="features"><div class="wrap">
<h2>{title}</h2>
<div class="fgrid">
<div class="fcard"><h3>{f1t}</h3><p>{f1d}</p></div>
<div class="fcard"><h3>{f2t}</h3><p>{f2d}</p></div>
<div class="fcard"><h3>{f3t}</h3><p>{f3d}</p></div>
</div>
</div></section>

## TPL quote
<section class="quote"><div class="wrap">
<blockquote>{text}</blockquote>
<cite>{cite}</cite>
</div></section>

## TPL cta
<section class="ctaband"><div class="wrap">
<h2>{title}</h2>
<p>{sub}</p>
<div class="cta-row">{ctas}</div>
</div></section>

## TPL footer
<footer class="footer"><div class="wrap foot-in">
<span>{brand} &copy; <span id="year">2026</span></span>
<span class="fine">{fine}</span>
</div></footer>

## TPL counter
<section class="comp"><div class="wrap">
<h2>{title}</h2>
<p class="muted">{desc}</p>
<div class="counter-row">
<button id="cdec" class="btn">-</button>
<span id="cval" class="cval">0</span>
<button id="cinc" class="btn">+</button>
</div>
</div></section>

## TPL accordion
<section class="comp"><div class="wrap">
<h2>{title}</h2>
<div class="acc">
<div class="acc-item"><button class="acc-q">{q1}</button><div class="acc-a">{a1}</div></div>
<div class="acc-item"><button class="acc-q">{q2}</button><div class="acc-a">{a2}</div></div>
<div class="acc-item"><button class="acc-q">{q3}</button><div class="acc-a">{a3}</div></div>
</div>
</div></section>

## TPL tabs
<section class="comp"><div class="wrap">
<h2>{title}</h2>
<div class="tabs">
<div class="tab-btns">
<button class="tab-btn on" data-tab="t1">{b1}</button>
<button class="tab-btn" data-tab="t2">{b2}</button>
<button class="tab-btn" data-tab="t3">{b3}</button>
</div>
<div class="tab-panes">
<div class="tab-pane on" id="t1">{p1}</div>
<div class="tab-pane" id="t2">{p2}</div>
<div class="tab-pane" id="t3">{p3}</div>
</div>
</div>
</div></section>

## TPL todo
<section class="comp"><div class="wrap">
<h2>{title}</h2>
<p class="muted">{desc}</p>
<div class="todo-row">
<input id="tin" type="text" placeholder="{ph}" />
<button id="tadd" class="btn">Add</button>
</div>
<ul id="tlist" class="tlist"></ul>
</div></section>

## TPL masthead
<header class="mast"><div class="wrap">
<p class="dateline">{dateline}</p>
<h1 class="mast-title">{title}</h1>
<p class="mast-sub">{sub}</p>
</div></header>

## TPL featured
<section class="featured"><div class="wrap feat-grid">
<div class="feat-main"><p class="kicker">{kicker}</p><h2>{title}</h2><p>{body}</p></div>
<div class="feat-side">{side}</div>
</div></section>

## TPL cardgrid
<section class="cardgrid"><div class="wrap">
<h2>{title}</h2>
<div class="cgrid">
<div class="ccard"><h3>{c1t}</h3><p>{c1d}</p></div>
<div class="ccard"><h3>{c2t}</h3><p>{c2d}</p></div>
<div class="ccard"><h3>{c3t}</h3><p>{c3d}</p></div>
<div class="ccard"><h3>{c4t}</h3><p>{c4d}</p></div>
<div class="ccard"><h3>{c5t}</h3><p>{c5d}</p></div>
<div class="ccard"><h3>{c6t}</h3><p>{c6d}</p></div>
</div>
</div></section>

## TPL sidebar
<aside class="sidebar"><div class="wrap side-grid">
<div class="side-main">{main}</div>
<div class="side-bar"><h3>{title}</h3><ul>{items}</ul></div>
</div></aside>

## TPL conlist
<section class="comp"><div class="wrap">
<h2>{title}</h2>
<p class="muted">{desc}</p>
<div class="fbtns">
<button class="fbtn on" data-f="all">All</button>
<button class="fbtn" data-f="north">Northern</button>
<button class="fbtn" data-f="south">Southern</button>
</div>
<div class="cgrid">
<div class="ccard" data-h="north"><h3>{n1}</h3><p>{d1}</p></div>
<div class="ccard" data-h="north"><h3>{n2}</h3><p>{d2}</p></div>
<div class="ccard" data-h="south"><h3>{n3}</h3><p>{d3}</p></div>
<div class="ccard" data-h="south"><h3>{n4}</h3><p>{d4}</p></div>
</div>
</div></section>

## TPL mooncard
<section class="comp"><div class="wrap">
<h2>{title}</h2>
<div class="moon"><div class="moon-disc"></div><p>Tonight the moon is <strong id="moonph">waxing</strong>.</p></div>
</div></section>

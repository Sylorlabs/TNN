// learn.zag — T1 guided-learning mechanism (pure Zag, zero RNG).
// Modes (argv[1]): teach | compose | revise
//   teach <curriculum.txt>
//     sequences the curriculum basics-first; prints CONSULT/INSTALL/PRACTICE
//     lines for the driver. One CONSULT per unit (manual discipline).
//   compose <taskfile> <knowdir>
//     retrieves the unit's knowledge card (exit 2 if missing = consultation
//     would be needed -> forbidden in testing) and instantiates its template
//     with the task PARAMS. Emits @@FILE blocks on stdout.
//   revise <workdir> <errfile> <knowdir> <unit>
//     parses the FIRST tsc error, applies one deterministic handbook-derived
//     fix, emits the fixed @@FILE block; prints FIX and (when the card's
//     LEARNRULES map the error) LEARN lines on stderr. Exit 0 fixed / 1 nofix.
//
// No RNG anywhere. All decisions are pure functions of the input files.

// ============ syscalls / memory ============

fn z_exit(c:i64)void {
    _zag_raw_syscall(60, c, 0, 0, 0, 0, 0);
    return;
}

fn z_malloc(n:i64)*u8 {
    let p:*u8=_zag_malloc(n) as *u8;
    return p;
}

fn fd_write(fd:i64, p:*u8, n:i64)i64 {
    let done:i64=0;
    while(done<n){
        let w:i64=_zag_raw_syscall(1, fd, (p as i64)+done, n-done, 0, 0, 0);
        if(w<=0){break;}
        done=done+w;
    }
    return done;
}

fn path_cstr(s:[]u8)*u8 {
    let p:*u8=z_malloc(s.len+1);
    let i:i64=0;
    while(i<s.len){
        p[i]=s[i];
        i=i+1;
    }
    p[s.len]=0;
    return p;
}

fn read_file(path:[]u8, mem:*u8, cap:i64)i64 {
    let pp:*u8=path_cstr(path);
    let fd:i64=_zag_raw_syscall(2, pp as i64, 0, 0, 0, 0, 0);
    if(fd<0){return -1;}
    let total:i64=0;
    while(1==1){
        if(total>=cap){break;}
        let want:i64=cap-total;
        if(want>65536){want=65536;}
        let r:i64=_zag_raw_syscall(0, fd, (mem as i64)+total, want, 0, 0, 0);
        if(r<=0){break;}
        total=total+r;
    }
    let c:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

// ============ string utils ============

fn s_eq(a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn s_find(h:[]u8, nd:[]u8, from:i64)i64 {
    if(nd.len==0){return from;}
    if(from<0){from=0;}
    let i:i64=from;
    while(i+nd.len<=h.len){
        let k:i64=0;
        while(k<nd.len){
            if(h[i+k]!=nd[k]){break;}
            k=k+1;
        }
        if(k==nd.len){return i;}
        i=i+1;
    }
    return -1;
}

fn s_start(h:[]u8, pre:[]u8)i64 {
    if(h.len<pre.len){return 0;}
    let i:i64=0;
    while(i<pre.len){
        if(h[i]!=pre[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn is_ident(c:u8)i64 {
    if(c>=48){if(c<=57){return 1;}}
    if(c>=65){if(c<=90){return 1;}}
    if(c>=97){if(c<=122){return 1;}}
    if(c==95){return 1;}
    if(c==36){return 1;}
    return 0;
}

fn is_digit(c:u8)i64 {
    if(c>=48){if(c<=57){return 1;}}
    return 0;
}

fn parse_i64(s:[]u8)i64 {
    let v:i64=0;
    let i:i64=0;
    while(i<s.len){
        if(is_digit(s[i])==0){break;}
        v=v*10+(s[i] as i64)-48;
        i=i+1;
    }
    return v;
}

fn fnv1a(p:*u8, n:i64)i64 {
    let h:i64=-3750763034362895579;
    let pp:i64=1099511628211;
    let i:i64=0;
    while(i<n){
        h=h^(p[i] as i64);
        h=h*pp;
        i=i+1;
    }
    return h;
}

// ============ output buffer (threaded pos, no structs) ============

fn o_raw(p:*u8, n:i64, s:[]u8)i64 {
    let i:i64=0;
    while(i<s.len){
        p[n]=s[i];
        n=n+1;
        i=i+1;
    }
    return n;
}

fn o_ch(p:*u8, n:i64, c:u8)i64 {
    p[n]=c;
    return n+1;
}

fn o_i64(p:*u8, n:i64, v:i64)i64 {
    let s:[]u8=_zag_i64_to_str(v);
    return o_raw(p, n, s);
}

fn o_hex(p:*u8, n:i64, v:i64)i64 {
    let digits:[]u8="0123456789abcdef";
    let k:i64=0;
    while(k<16){
        let sh:i64=(15-k)*4;
        let nib:i64=(v>>sh)&15;
        p[n]=digits[nib];
        n=n+1;
        k=k+1;
    }
    return n;
}

fn flush_out(p:*u8, n:i64)void {
    fd_write(1, p, n);
    return;
}

fn flush_err(p:*u8, n:i64)void {
    fd_write(2, p, n);
    return;
}

// find section: marker line (exact, e.g. "## TPL varann") -> content until
// a line starting with "## " or "ENDPARAMS"/eof. Returns (start,len) via out params as i64 pair packed: start in lo? Use two separate fns via globals? No globals allowed.
// Instead: sec_range returns start, and sec_end returns end; caller pairs them.
fn sec_find(buf:[]u8, marker:[]u8)i64 {
    // find marker at a line start
    let at:i64=s_find(buf, marker, 0);
    while(at>=0){
        if(at==0){return at;}
        if(buf[at-1]==10){return at;}
        at=s_find(buf, marker, at+1);
    }
    return -1;
}

fn line_end(buf:[]u8, from:i64)i64 {
    let i:i64=from;
    while(i<buf.len){
        if(buf[i]==10){return i;}
        i=i+1;
    }
    return buf.len;
}

// end of a ## section: next line starting with "## " or end marker line
fn sec_content_end(buf:[]u8, from:i64, endmark:[]u8)i64 {
    let i:i64=from;
    while(i<buf.len){
        if(buf[i]==10){
            let ls:i64=i+1;
            let le:i64=line_end(buf, ls);
            let line:[]u8=buf[ls..le];
            if(s_start(line, "## ")==1){return i+1;}
            if(s_eq(line, endmark)==1){return i+1;}
        }
        i=i+1;
    }
    return buf.len;
}

// ============ kv tables (offsets into a source buffer) ============
// tab: 32 bytes per entry: k_off,k_len,v_off,v_len (i64 LE)

fn kv_parse(buf:[]u8, from:i64, to:i64, tab:[]u8, maxe:i64)i64 {
    let ne:i64=0;
    let i:i64=from;
    while(i<to){
        let le:i64=line_end(buf, i);
        let line:[]u8=buf[i..le];
        if(line.len>0){
            if(line[0]!=35){
                let eq:i64=s_find(line, "=", 0);
                if(eq>0){
                    if(ne<maxe){
                        let b:i64=ne*32;
                        let ko:i64=i;
                        let kl:i64=eq;
                        let vo:i64=i+eq+1;
                        let vl:i64=le-vo;
                        if(vl<0){vl=0;}
                        let f:i64=0;
                        while(f<8){
                            tab[b+f]=(((ko>>f*8)&255) as u8);
                            tab[b+8+f]=(((kl>>f*8)&255) as u8);
                            tab[b+16+f]=(((vo>>f*8)&255) as u8);
                            tab[b+24+f]=(((vl>>f*8)&255) as u8);
                            f=f+1;
                        }
                        ne=ne+1;
                    }
                }
            }
        }
        i=le+1;
    }
    return ne;
}

fn kv_g(tab:[]u8, e:i64, f:i64)i64 {
    let b:i64=e*32+f*8;
    let v:i64=0;
    let k:i64=0;
    while(k<8){
        v=v|(((tab[b+k] as i64)&255)<<(k*8));
        k=k+1;
    }
    return v;
}

fn kv_find(buf:[]u8, tab:[]u8, ne:i64, key:[]u8)i64 {
    let e:i64=0;
    while(e<ne){
        let ks:[]u8=buf[kv_g(tab,e,0)..kv_g(tab,e,0)+kv_g(tab,e,1)];
        if(s_eq(ks, key)==1){return e+1;}
        e=e+1;
    }
    return 0;
}

fn kv_val(buf:[]u8, tab:[]u8, idx:i64)[]u8 {
    let e:i64=idx-1;
    return buf[kv_g(tab,e,2)..kv_g(tab,e,2)+kv_g(tab,e,3)];
}

// section of a task file: lines between "NAME:" line and "ENDxxx" line
fn tsec_start(task:[]u8, name:[]u8)i64 {
    // find line "NAME:" at line start; content begins after its newline
    let i:i64=0;
    while(i<task.len){
        let le:i64=line_end(task, i);
        let line:[]u8=task[i..le];
        let want:i64=name.len+1;
        if(line.len==want){
            if(s_start(line, name)==1){
                if(line[name.len]==58){return le+1;}
            }
        }
        i=le+1;
    }
    return -1;
}

fn tsec_end(task:[]u8, from:i64, endname:[]u8)i64 {
    let i:i64=from;
    while(i<task.len){
        let le:i64=line_end(task, i);
        let line:[]u8=task[i..le];
        if(s_eq(line, endname)==1){return i;}
        i=le+1;
    }
    return task.len;
}

// card template section: "## TPL <name>" line -> content until next "## " line
fn card_tpl(card:[]u8, name:[]u8)[]u8 {
    let mp:*u8=z_malloc(128);
    let mn:i64=o_raw(mp, 0, "## TPL ");
    mn=o_raw(mp, mn, name);
    let marker:[]u8=mp[0..mn];
    let at:i64=sec_find(card, marker);
    if(at<0){
        let empty:[]u8=mp[0..0];
        return empty;
    }
    let cs:i64=line_end(card, at)+1;
    let ce:i64=sec_content_end(card, cs, "@@NOMATCH@@");
    return card[cs..ce];
}

fn card_sec(card:[]u8, secname:[]u8)[]u8 {
    let mp:*u8=z_malloc(128);
    let mn:i64=o_raw(mp, 0, "## ");
    mn=o_raw(mp, mn, secname);
    let marker:[]u8=mp[0..mn];
    let at:i64=sec_find(card, marker);
    if(at<0){
        let empty:[]u8=mp[0..0];
        return empty;
    }
    let cs:i64=line_end(card, at)+1;
    let ce:i64=sec_content_end(card, cs, "@@NOMATCH@@");
    return card[cs..ce];
}

// ============ teach ============

fn mode_teach(curpath:[]u8)void {
    let mem:*u8=z_malloc(65536);
    let n:i64=read_file(curpath, mem, 65536);
    let ob:*u8=z_malloc(65536);
    let on:i64=0;
    let eb:*u8=z_malloc(4096);
    let en:i64=0;
    if(n<0){
        en=o_raw(eb, en, "TEACH-FAIL: cannot read curriculum\n");
        flush_err(eb, en);
        z_exit(1);
    }
    let cur:[]u8=mem[0..n];
    let i:i64=0;
    while(i<n){
        let le:i64=line_end(cur, i);
        let line:[]u8=cur[i..le];
        let skip:i64=0;
        if(line.len==0){skip=1;}
        if(skip==0){
            if(line[0]==35){skip=1;}
        }
        if(skip==0){
            let sp:i64=s_find(line, " ", 0);
            if(sp>0){
                let unit:[]u8=line[0..sp];
                let taskf:[]u8=line[sp+1..line.len];
                // corpus path: corpus/units/<unit>.txt
                let cp:*u8=z_malloc(256);
                let cn:i64=o_raw(cp, 0, "corpus/units/");
                cn=o_raw(cp, cn, unit);
                cn=o_raw(cp, cn, ".txt");
                let cpath:[]u8=cp[0..cn];
                let cm:*u8=z_malloc(65536);
                let cnn:i64=read_file(cpath, cm, 65536);
                if(cnn<0){
                    en=o_raw(eb, en, "TEACH-FAIL: cannot read corpus ");
                    en=o_raw(eb, en, cpath);
                    en=o_ch(eb, en, 10);
                    flush_err(eb, en);
                    z_exit(1);
                }
                let dg:i64=fnv1a(cm, cnn);
                on=o_raw(ob, on, "CONSULT unit=");
                on=o_raw(ob, on, unit);
                on=o_raw(ob, on, " bytes=");
                on=o_i64(ob, on, cnn);
                on=o_raw(ob, on, " fnv=");
                on=o_hex(ob, on, dg);
                on=o_ch(ob, on, 10);
                on=o_raw(ob, on, "INSTALL card=");
                on=o_raw(ob, on, unit);
                on=o_raw(ob, on, ".card\n");
                on=o_raw(ob, on, "PRACTICE task=");
                on=o_raw(ob, on, taskf);
                on=o_ch(ob, on, 10);
            }
        }
        i=le+1;
    }
    flush_out(ob, on);
    return;
}

// ============ findcard ============
// Which installed card holds a full line "## TPL <tpl>"?
// Unit's card first, then curriculum order (deterministic). Prints "<u>.card".
// Exits 0 on found, 1 with FINDCARD-MISS when no installed card holds it.
// This is the installed-card retrieval decision; it lives in Zag so that
// template selection is part of the pure mechanism, not the driver.

fn findcard_check(unit:[]u8, tpl:[]u8, knowdir:[]u8, ob:*u8, on:i64)i64 {
    let cp:*u8=z_malloc(256);
    let cn:i64=o_raw(cp, 0, knowdir);
    cn=o_ch(cp, cn, 47);
    cn=o_raw(cp, cn, unit);
    cn=o_raw(cp, cn, ".card");
    let cpath:[]u8=cp[0..cn];
    let cm:*u8=z_malloc(65536);
    let cnn:i64=read_file(cpath, cm, 65536);
    if(cnn<0){return -1;}
    let card:[]u8=cm[0..cnn];
    let mp:*u8=z_malloc(128);
    let mn:i64=o_raw(mp, 0, "## TPL ");
    mn=o_raw(mp, mn, tpl);
    let marker:[]u8=mp[0..mn];
    let at:i64=s_find(card, marker, 0);
    while(at>=0){
        let ok:i64=0;
        if(at==0){ok=1;}
        if(ok==0){
            if(card[at-1]==10){ok=1;}
        }
        if(ok==1){
            let le:i64=line_end(card, at);
            let line:[]u8=card[at..le];
            if(s_eq(line, marker)==1){
                on=o_raw(ob, on, unit);
                on=o_raw(ob, on, ".card");
                on=o_ch(ob, on, 10);
                return on;
            }
        }
        at=s_find(card, marker, at+1);
    }
    return -1;
}

fn mode_findcard(unit:[]u8, tpl:[]u8, knowdir:[]u8, curpath:[]u8)void {
    let ob:*u8=z_malloc(4096);
    let on:i64=0;
    let eb:*u8=z_malloc(4096);
    let en:i64=0;
    let r:i64=findcard_check(unit, tpl, knowdir, ob, on);
    if(r>=0){
        flush_out(ob, r);
        return;
    }
    let mem:*u8=z_malloc(65536);
    let n:i64=read_file(curpath, mem, 65536);
    if(n<0){
        en=o_raw(eb, en, "FINDCARD-FAIL: cannot read curriculum\n");
        flush_err(eb, en);
        z_exit(1);
    }
    let cur:[]u8=mem[0..n];
    let i:i64=0;
    while(i<n){
        let le:i64=line_end(cur, i);
        let line:[]u8=cur[i..le];
        let skip:i64=0;
        if(line.len==0){skip=1;}
        if(skip==0){
            if(line[0]==35){skip=1;}
        }
        if(skip==0){
            let sp:i64=s_find(line, " ", 0);
            if(sp>0){
                let u:[]u8=line[0..sp];
                if(s_eq(u, unit)==0){
                    let r2:i64=findcard_check(u, tpl, knowdir, ob, on);
                    if(r2>=0){
                        flush_out(ob, r2);
                        return;
                    }
                }
            }
        }
        i=le+1;
    }
    en=o_raw(eb, en, "FINDCARD-MISS\n");
    flush_err(eb, en);
    z_exit(1);
    return;
}

// ============ compose ============
// subst: template -> output; placeholders {key} resolved from params then learned.
// Returns packed (out_n<<32 | err_n). UNBOUND keys logged to errbuf.

fn subst(p:*u8, n:i64, tpl:[]u8, pbuf:[]u8, ptab:[]u8, pne:i64, lbuf:[]u8, ltab:[]u8, lne:i64, eb:*u8, en:i64)i64 {
    let i:i64=0;
    while(i<tpl.len){
        if(tpl[i]==123){
            // only {ident} is a placeholder; any other brace is literal TS
            let j:i64=i+1;
            while(j<tpl.len){
                if(is_ident(tpl[j])==0){break;}
                j=j+1;
            }
            if(j>i+1){
                if(j<tpl.len){
                    if(tpl[j]==125){
                        let key:[]u8=tpl[i+1..j];
                        let pi:i64=kv_find(pbuf, ptab, pne, key);
                        if(pi>0){
                            n=o_raw(p, n, kv_val(pbuf, ptab, pi));
                        } else {
                            let li2:i64=kv_find(lbuf, ltab, lne, key);
                            if(li2>0){
                                n=o_raw(p, n, kv_val(lbuf, ltab, li2));
                            } else {
                                en=o_raw(eb, en, "UNBOUND key=");
                                en=o_raw(eb, en, key);
                                en=o_ch(eb, en, 10);
                            }
                        }
                        i=j+1;
                    } else {
                        n=o_ch(p, n, tpl[i]);
                        i=i+1;
                    }
                } else {
                    n=o_ch(p, n, tpl[i]);
                    i=i+1;
                }
            } else {
                n=o_ch(p, n, tpl[i]);
                i=i+1;
            }
        } else {
            n=o_ch(p, n, tpl[i]);
            i=i+1;
        }
    }
    return (n<<32)|(en&4294967295);
}

fn emit_fileblock(p:*u8, n:i64, fname:[]u8, tpl:[]u8, pbuf:[]u8, ptab:[]u8, pne:i64, lbuf:[]u8, ltab:[]u8, lne:i64, eb:*u8, en:i64)i64 {
    n=o_raw(p, n, "@@FILE ");
    n=o_raw(p, n, fname);
    n=o_ch(p, n, 10);
    let packed:i64=subst(p, n, tpl, pbuf, ptab, pne, lbuf, ltab, lne, eb, en);
    n=packed>>32;
    en=packed&4294967295;
    n=o_raw(p, n, "@@END\n");
    return (n<<32)|(en&4294967295);
}

// header kv: KEY=value lines anywhere OUTSIDE sections (sections are
// PARAMS:/LIBPARAMS:/MAINPARAMS:/TESTS:/EXPECT: .. ENDPARAMS/ENDTESTS/ENDEXPECT)
fn hdr_parse(task:[]u8, tab:[]u8, maxe:i64)i64 {
    let ne:i64=0;
    let i:i64=0;
    let insec:i64=0;
    while(i<task.len){
        let le:i64=line_end(task, i);
        let line:[]u8=task[i..le];
        if(insec==1){
            if(s_eq(line, "ENDPARAMS")==1){insec=0;}
            if(s_eq(line, "ENDTESTS")==1){insec=0;}
            if(s_eq(line, "ENDEXPECT")==1){insec=0;}
        } else {
            if(s_eq(line, "PARAMS:")==1){insec=1;}
            if(s_eq(line, "LIBPARAMS:")==1){insec=1;}
            if(s_eq(line, "MAINPARAMS:")==1){insec=1;}
            if(s_eq(line, "TESTS:")==1){insec=1;}
            if(s_eq(line, "EXPECT:")==1){insec=1;}
            if(insec==0){
                let eq:i64=s_find(line, "=", 0);
                if(eq>0){
                    if(ne<maxe){
                        let b:i64=ne*32;
                        let ko:i64=i;
                        let kl:i64=eq;
                        let vo:i64=i+eq+1;
                        let vl:i64=le-vo;
                        if(vl<0){vl=0;}
                        let f:i64=0;
                        while(f<8){
                            tab[b+f]=(((ko>>f*8)&255) as u8);
                            tab[b+8+f]=(((kl>>f*8)&255) as u8);
                            tab[b+16+f]=(((vo>>f*8)&255) as u8);
                            tab[b+24+f]=(((vl>>f*8)&255) as u8);
                            f=f+1;
                        }
                        ne=ne+1;
                    }
                }
            }
        }
        i=le+1;
    }
    return ne;
}

fn mode_compose(taskpath:[]u8, knowdir:[]u8, cardfile:[]u8)void {
    let mem:*u8=z_malloc(65536);
    let n:i64=read_file(taskpath, mem, 65536);
    let eb:*u8=z_malloc(8192);
    let en:i64=0;
    if(n<0){
        en=o_raw(eb, en, "COMPOSE-FAIL: cannot read task\n");
        flush_err(eb, en);
        z_exit(1);
    }
    let task:[]u8=mem[0..n];
    // header: KEY=value lines outside any section
    let htabp:*u8=z_malloc(4096);
    let htab:[]u8=htabp[0..4096];
    let hne:i64=hdr_parse(task, htab, 128);
    let gi:i64=kv_find(task, htab, hne, "UNIT");
    if(gi==0){
        en=o_raw(eb, en, "COMPOSE-FAIL: no UNIT in task\n");
        flush_err(eb, en);
        z_exit(1);
    }
    let unit:[]u8=kv_val(task, htab, gi);
    // card path: <knowdir>/<cardfile> when the driver names an installed card
    // explicitly (transfer probe: template lives in another unit's installed
    // card), else <knowdir>/<unit>.card. Only installed cards are ever read.
    let cp:*u8=z_malloc(512);
    let cn:i64=o_raw(cp, 0, knowdir);
    cn=o_ch(cp, cn, 47);
    if(cardfile.len>0){
        cn=o_raw(cp, cn, cardfile);
    } else {
        cn=o_raw(cp, cn, unit);
        cn=o_raw(cp, cn, ".card");
    }
    let cpath:[]u8=cp[0..cn];
    let cm:*u8=z_malloc(65536);
    let cnn:i64=read_file(cpath, cm, 65536);
    if(cnn<0){
        en=o_raw(eb, en, "CARD-MISSING unit=");
        en=o_raw(eb, en, unit);
        en=o_ch(eb, en, 10);
        flush_err(eb, en);
        z_exit(2);
    }
    let card:[]u8=cm[0..cnn];
    let ltabp:*u8=z_malloc(4096);
    let ltab:[]u8=ltabp[0..4096];
    let lne:i64=0;
    let lat:i64=sec_find(card, "## LEARNED");
    if(lat>=0){
        let lcs:i64=line_end(card, lat)+1;
        let lce:i64=sec_content_end(card, lcs, "@@NOMATCH@@");
        lne=kv_parse(card, lcs, lce, ltab, 128);
    }
    let ob:*u8=z_malloc(131072);
    let on:i64=0;
    let fi:i64=kv_find(task, htab, hne, "FILES");
    let files:[]u8=task[0..0];
    if(fi>0){files=kv_val(task, htab, fi);}
    if(s_eq(files, "multi")==1){
        let gi2:i64=kv_find(task, htab, hne, "LIBTPL");
        let gi3:i64=kv_find(task, htab, hne, "LIBNAME");
        let gi4:i64=kv_find(task, htab, hne, "MAINTPL");
        if(gi2==0){en=o_raw(eb,en,"COMPOSE-FAIL: no LIBTPL\n");flush_err(eb,en);z_exit(1);}
        if(gi3==0){en=o_raw(eb,en,"COMPOSE-FAIL: no LIBNAME\n");flush_err(eb,en);z_exit(1);}
        if(gi4==0){en=o_raw(eb,en,"COMPOSE-FAIL: no MAINTPL\n");flush_err(eb,en);z_exit(1);}
        let libtpln:[]u8=kv_val(task, htab, gi2);
        let libname:[]u8=kv_val(task, htab, gi3);
        let maintpln:[]u8=kv_val(task, htab, gi4);
        let libtpl:[]u8=card_tpl(card, libtpln);
        let maintpl:[]u8=card_tpl(card, maintpln);
        if(libtpl.len==0){en=o_raw(eb,en,"TPL-MISSING lib\n");flush_err(eb,en);z_exit(3);}
        if(maintpl.len==0){en=o_raw(eb,en,"TPL-MISSING main\n");flush_err(eb,en);z_exit(3);}
        let lps:i64=tsec_start(task, "LIBPARAMS");
        let mps:i64=tsec_start(task, "MAINPARAMS");
        let lpe:i64=tsec_end(task, lps, "ENDPARAMS");
        let mpe:i64=tsec_end(task, mps, "ENDPARAMS");
        let ptabp:*u8=z_malloc(4096);
        let ptab:[]u8=ptabp[0..4096];
        let pne:i64=kv_parse(task, lps, lpe, ptab, 128);
        let packed:i64=0;
        let fnb:*u8=z_malloc(256);
        let fnn:i64=o_raw(fnb, 0, libname);
        fnn=o_raw(fnb, fnn, ".ts");
        packed=emit_fileblock(ob, on, fnb[0..fnn], libtpl, task, ptab, pne, card, ltab, lne, eb, en);
        on=packed>>32;
        en=packed&4294967295;
        let ptab2p:*u8=z_malloc(4096);
        let ptab2:[]u8=ptab2p[0..4096];
        let pne2:i64=kv_parse(task, mps, mpe, ptab2, 128);
        packed=emit_fileblock(ob, on, "main.ts", maintpl, task, ptab2, pne2, card, ltab, lne, eb, en);
        on=packed>>32;
        en=packed&4294967295;
    } else {
        let ti:i64=kv_find(task, htab, hne, "TPL");
        if(ti==0){en=o_raw(eb,en,"COMPOSE-FAIL: no TPL\n");flush_err(eb,en);z_exit(1);}
        let tpln:[]u8=kv_val(task, htab, ti);
        let tpl:[]u8=card_tpl(card, tpln);
        if(tpl.len==0){en=o_raw(eb,en,"TPL-MISSING\n");flush_err(eb,en);z_exit(3);}
        let ps:i64=tsec_start(task, "PARAMS");
        let pe:i64=tsec_end(task, ps, "ENDPARAMS");
        let ptabp:*u8=z_malloc(4096);
        let ptab:[]u8=ptabp[0..4096];
        let pne:i64=kv_parse(task, ps, pe, ptab, 128);
        let packed:i64=emit_fileblock(ob, on, "sol.ts", tpl, task, ptab, pne, card, ltab, lne, eb, en);
        on=packed>>32;
        en=packed&4294967295;
    }
    flush_err(eb, en);
    flush_out(ob, on);
    return;
}

// ============ revise ============
// insert "!" right after the identifier at (line,col) in buf
fn fix_bang(sbuf:[]u8, n:i64, line:i64, col:i64, qid:[]u8, ob:*u8)i64 {
    // locate line start
    let ls:i64=0;
    let ln:i64=1;
    while(ln<line){
        let le:i64=line_end(sbuf, ls);
        ls=le+1;
        ln=ln+1;
    }
    let le2:i64=line_end(sbuf, ls);
    let off:i64=ls+col-1;
    if(off<ls){off=ls;}
    if(off>le2){off=le2;}
    // scan identifier from off
    let e:i64=off;
    while(e<le2){
        if(is_ident(sbuf[e])==0){break;}
        e=e+1;
    }
    let got:[]u8=sbuf[off..e];
    if(s_eq(got, qid)==0){
        // fallback: find qid on this line
        let f:i64=s_find(sbuf[ls..le2], qid, 0);
        if(f<0){return -1;}
        off=ls+f;
        e=off+qid.len;
    }
    let on:i64=0;
    let k:i64=0;
    while(k<e){
        ob[on]=sbuf[k];
        on=on+1;
        k=k+1;
    }
    ob[on]=33;
    on=on+1;
    while(k<n){
        ob[on]=sbuf[k];
        on=on+1;
        k=k+1;
    }
    return on;
}

// insert ": type" after identifier at (line,col)
fn fix_annotate(sbuf:[]u8, n:i64, line:i64, col:i64, qid:[]u8, typ:[]u8, ob:*u8)i64 {
    let ls:i64=0;
    let ln:i64=1;
    while(ln<line){
        let le:i64=line_end(sbuf, ls);
        ls=le+1;
        ln=ln+1;
    }
    let le2:i64=line_end(sbuf, ls);
    let off:i64=ls+col-1;
    if(off<ls){off=ls;}
    if(off>le2){off=le2;}
    let e:i64=off;
    while(e<le2){
        if(is_ident(sbuf[e])==0){break;}
        e=e+1;
    }
    let on:i64=0;
    let k:i64=0;
    while(k<e){
        ob[on]=sbuf[k];
        on=on+1;
        k=k+1;
    }
    on=o_raw(ob, on, ": ");
    on=o_raw(ob, on, typ);
    while(k<n){
        ob[on]=sbuf[k];
        on=on+1;
        k=k+1;
    }
    return on;
}

// replace identifier qid at (line,col) with correct
fn fix_rename(sbuf:[]u8, n:i64, line:i64, col:i64, qid:[]u8, good:[]u8, ob:*u8)i64 {
    let ls:i64=0;
    let ln:i64=1;
    while(ln<line){
        let le:i64=line_end(sbuf, ls);
        ls=le+1;
        ln=ln+1;
    }
    let le2:i64=line_end(sbuf, ls);
    let off:i64=ls+col-1;
    if(off<ls){off=ls;}
    if(off>le2){off=le2;}
    let e:i64=off;
    while(e<le2){
        if(is_ident(sbuf[e])==0){break;}
        e=e+1;
    }
    let got:[]u8=sbuf[off..e];
    if(s_eq(got, qid)==0){
        let f:i64=s_find(sbuf[ls..le2], qid, 0);
        if(f<0){return -1;}
        off=ls+f;
        e=off+qid.len;
    }
    let on:i64=0;
    let k:i64=0;
    while(k<off){
        ob[on]=sbuf[k];
        on=on+1;
        k=k+1;
    }
    on=o_raw(ob, on, good);
    k=e;
    while(k<n){
        ob[on]=sbuf[k];
        on=on+1;
        k=k+1;
    }
    return on;
}

fn basename(p:[]u8)[]u8 {
    let i:i64=p.len-1;
    while(i>=0){
        if(p[i]==47){return p[i+1..p.len];}
        i=i-1;
    }
    return p;
}

fn mode_revise(workdir:[]u8, errpath:[]u8, knowdir:[]u8, unit:[]u8)void {
    let eb:*u8=z_malloc(8192);
    let en:i64=0;
    let em:*u8=z_malloc(65536);
    let enn:i64=read_file(errpath, em, 65536);
    if(enn<0){
        en=o_raw(eb, en, "REVISE-FAIL: cannot read errfile\n");
        flush_err(eb, en);
        z_exit(1);
    }
    let errb:[]u8=em[0..enn];
    // first line containing "error TS"
    let i:i64=0;
    let found:i64=0;
    let eline:[]u8=errb[0..0];
    while(i<enn){
        let le:i64=line_end(errb, i);
        let line:[]u8=errb[i..le];
        if(s_find(line, "error TS", 0)>=0){
            eline=line;
            found=1;
            break;
        }
        i=le+1;
    }
    if(found==0){
        en=o_raw(eb, en, "NOFIX no-tsc-error-found\n");
        flush_err(eb, en);
        z_exit(1);
    }
    // path(line,col): error TS<code>: msg
    let op:i64=s_find(eline, "(", 0);
    let cm1:i64=s_find(eline, ",", op);
    let cp:i64=s_find(eline, ")", cm1);
    let ec:i64=s_find(eline, "error TS", 0);
    if(op<0){en=o_raw(eb,en,"NOFIX unparsable\n");flush_err(eb,en);z_exit(1);}
    if(cm1<0){en=o_raw(eb,en,"NOFIX unparsable\n");flush_err(eb,en);z_exit(1);}
    if(cp<0){en=o_raw(eb,en,"NOFIX unparsable\n");flush_err(eb,en);z_exit(1);}
    if(ec<0){en=o_raw(eb,en,"NOFIX unparsable\n");flush_err(eb,en);z_exit(1);}
    let fpath:[]u8=eline[0..op];
    let lnum:i64=parse_i64(eline[op+1..cm1]);
    let cnum:i64=parse_i64(eline[cm1+1..cp]);
    let code:i64=parse_i64(eline[ec+8..eline.len]);
    // first quoted identifier after the code
    let q1:i64=s_find(eline, "'", ec);
    let qid:[]u8=eline[0..0];
    if(q1>=0){
        let q2:i64=s_find(eline, "'", q1+1);
        if(q2>q1){qid=eline[q1+1..q2];}
    }
    let fname:[]u8=basename(fpath);
    // read the file to fix
    let fp:*u8=z_malloc(512);
    let fn2:i64=o_raw(fp, 0, workdir);
    fn2=o_ch(fp, fn2, 47);
    fn2=o_raw(fp, fn2, fname);
    let fpath2:[]u8=fp[0..fn2];
    let sm:*u8=z_malloc(65536);
    let snn:i64=read_file(fpath2, sm, 65536);
    if(snn<0){
        en=o_raw(eb, en, "REVISE-FAIL: cannot read ");
        en=o_raw(eb, en, fpath2);
        en=o_ch(eb, en, 10);
        flush_err(eb, en);
        z_exit(1);
    }
    let sbuf:[]u8=sm[0..snn];
    // card for hints + learnrules
    let cp2:*u8=z_malloc(512);
    let cn2:i64=o_raw(cp2, 0, knowdir);
    cn2=o_ch(cp2, cn2, 47);
    cn2=o_raw(cp2, cn2, unit);
    cn2=o_raw(cp2, cn2, ".card");
    let cpath:[]u8=cp2[0..cn2];
    let cm2:*u8=z_malloc(65536);
    let cnn2:i64=read_file(cpath, cm2, 65536);
    let card:[]u8=cm2[0..0];
    if(cnn2>0){card=cm2[0..cnn2];}
    let ob:*u8=z_malloc(131072);
    let on:i64=-1;
    let rule:[]u8=eb[0..0];
    if(code==18048){on=fix_bang(sbuf, snn, lnum, cnum, qid, ob);rule="nonnull-assert";}
    if(code==18047){on=fix_bang(sbuf, snn, lnum, cnum, qid, ob);rule="nonnull-assert";}
    if(code==2564){on=fix_bang(sbuf, snn, lnum, cnum, qid, ob);rule="definite-assign-assert";}
    if(code==7006){
        let htabp:*u8=z_malloc(2048);
        let htab:[]u8=htabp[0..2048];
        let hne:i64=0;
        let hat:i64=sec_find(card, "## TYPEHINTS");
        if(hat>=0){
            let hcs:i64=line_end(card, hat)+1;
            let hce:i64=sec_content_end(card, hcs, "@@NOMATCH@@");
            hne=kv_parse(card, hcs, hce, htab, 64);
        }
        let hi2:i64=kv_find(card, htab, hne, qid);
        if(hi2>0){
            on=fix_annotate(sbuf, snn, lnum, cnum, qid, kv_val(card, htab, hi2), ob);
            rule="annotate-param";
        }
    }
    if(code==2339){
        let mtabp:*u8=z_malloc(2048);
        let mtab:[]u8=mtabp[0..2048];
        let mne:i64=0;
        let mat:i64=sec_find(card, "## MISTAKES");
        if(mat>=0){
            let mcs:i64=line_end(card, mat)+1;
            let mce:i64=sec_content_end(card, mcs, "@@NOMATCH@@");
            mne=kv_parse(card, mcs, mce, mtab, 64);
        }
        let mi2:i64=kv_find(card, mtab, mne, qid);
        if(mi2>0){
            on=fix_rename(sbuf, snn, lnum, cnum, qid, kv_val(card, mtab, mi2), ob);
            rule="correct-identifier";
        }
    }
    if(on<0){
        en=o_raw(eb, en, "NOFIX code=TS");
        en=o_i64(eb, en, code);
        en=o_raw(eb, en, " id=");
        en=o_raw(eb, en, qid);
        en=o_ch(eb, en, 10);
        flush_err(eb, en);
        z_exit(1);
    }
    // emit fixed file block
    let outp:*u8=z_malloc(131072);
    let outn:i64=0;
    outn=o_raw(outp, outn, "@@FILE ");
    outn=o_raw(outp, outn, fname);
    outn=o_ch(outp, outn, 10);
    let fixed:[]u8=ob[0..on];
    outn=o_raw(outp, outn, fixed);
    outn=o_raw(outp, outn, "@@END\n");
    en=o_raw(eb, en, "FIX TS");
    en=o_i64(eb, en, code);
    en=o_ch(eb, en, 32);
    en=o_raw(eb, en, rule);
    en=o_raw(eb, en, " id=");
    en=o_raw(eb, en, qid);
    en=o_raw(eb, en, " file=");
    en=o_raw(eb, en, fname);
    en=o_raw(eb, en, " line=");
    en=o_i64(eb, en, lnum);
    en=o_ch(eb, en, 10);
    // LEARNRULES: lines "TS<code> key=value"
    let lat:i64=sec_find(card, "## LEARNRULES");
    if(lat>=0){
        let lcs:i64=line_end(card, lat)+1;
        let lce:i64=sec_content_end(card, lcs, "@@NOMATCH@@");
        let j:i64=lcs;
        let want:[]u8=eb[0..0];
        let wp:*u8=z_malloc(32);
        let wn:i64=o_raw(wp, 0, "TS");
        wn=o_i64(wp, wn, code);
        wn=o_ch(wp, wn, 32);
        want=wp[0..wn];
        while(j<lce){
            let le3:i64=line_end(card, j);
            let rl:[]u8=card[j..le3];
            if(s_start(rl, want)==1){
                let kvv:[]u8=rl[want.len..rl.len];
                en=o_raw(eb, en, "LEARN unit=");
                en=o_raw(eb, en, unit);
                en=o_ch(eb, en, 32);
                en=o_raw(eb, en, kvv);
                en=o_ch(eb, en, 10);
            }
            j=le3+1;
        }
    }
    flush_err(eb, en);
    flush_out(outp, outn);
    return;
}

fn main()void {
    let mode:[]u8=_zag_arg(1);
    if(s_eq(mode, "teach")==1){
        mode_teach(_zag_arg(2));
        return;
    }
    if(s_eq(mode, "compose")==1){
        mode_compose(_zag_arg(2), _zag_arg(3), _zag_arg(4));
        return;
    }
    if(s_eq(mode, "findcard")==1){
        mode_findcard(_zag_arg(2), _zag_arg(3), _zag_arg(4), _zag_arg(5));
        return;
    }
    if(s_eq(mode, "revise")==1){
        mode_revise(_zag_arg(2), _zag_arg(3), _zag_arg(4), _zag_arg(5));
        return;
    }
    let eb:*u8=z_malloc(256);
    let en:i64=o_raw(eb, 0, "usage: learn <teach|compose|revise|findcard> ...\n");
    flush_err(eb, en);
    z_exit(1);
    return;
}

# CARD U3-interfaces — interfaces, optional/readonly, extends, index signatures
## TPL ifacefn
interface {iname} {
  {props}
}
function {fn}({param}: {iname}): {ret} {
  {body}
}
## TPL ifacefn2
interface {iname} {
  {props}
}
function {fn}({p1}: {iname}, {p2}: {iname}): {ret} {
  {body}
}
## TPL ifaceextends
interface {parent} {
  {pprops}
}
interface {child} extends {parent} {
  {cprops}
}
function {fn}({param}: {child}): {ret} {
  {body}
}
## TPL dictsum
interface {iname} {
  [key: string]: {vtype};
}
function {fn}({param}: {iname}): {ret} {
  let total: number = 0;
  for (const k of Object.keys({param})) {
    total = total + {param}[k];
  }
  return total;
}

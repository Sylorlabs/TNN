# CARD U7-async — async functions, await, Promise.all
## TPL asyncfn
function {helper}(): Promise<{htype}> {
  return new Promise<{htype}>((resolve) => {
    setTimeout(() => resolve({hval}), 10);
  });
}
async function {fn}(): Promise<{ret}> {
  const {v} = await {helper}();
  return {body};
}
## TPL asyncall
function {h1}(): Promise<{t1}> {
  return new Promise<{t1}>((resolve) => {
    setTimeout(() => resolve({v1}), 5);
  });
}
function {h2}(): Promise<{t2}> {
  return new Promise<{t2}>((resolve) => {
    setTimeout(() => resolve({v2}), 5);
  });
}
async function {fn}(): Promise<{ret}> {
  const results: [{t1}, {t2}] = await Promise.all([{h1}(), {h2}()]);
  return {body2};
}

# CARD U4-classes — classes, constructors, implements, extends
## TPL class
class {cname} {
  {field}{fieldbang}: {ftype};
  constructor({cparam}: {cptype}) {
    {cbody}
  }
  {method}(): {mret} {
    {mbody}
  }
}
## TPL impl
interface {iname} {
  {sig}
}
class {cname} implements {iname} {
  {field}: {ftype};
  constructor({cparam}: {cptype}) {
    this.{field} = {cparam};
  }
  {method}(): {mret} {
    {mbody}
  }
}
## TPL extends
class {parent} {
  {pfield}: {pftype};
  constructor({pcparam}: {pcptype}) {
    this.{pfield} = {pcparam};
  }
}
class {child} extends {parent} {
  {cfield}: {cftype};
  constructor({pcparam}: {pcptype}, {ccparam}: {ccptype}) {
    super({pcparam});
    this.{cfield} = {ccparam};
  }
  {method}(): {mret} {
    {mbody}
  }
}

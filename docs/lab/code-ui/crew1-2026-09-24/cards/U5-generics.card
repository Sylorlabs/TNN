# CARD U5-generics — type parameters, constraints, generic interfaces/classes
## TPL identity
function {fn}<{tparam}>({param}: {tparam}): {tparam} {
  return {param};
}
## TPL first
function {fn}<{tparam}>({arr}: {tparam}[]): {tparam} | undefined {
  return {arr}[0];
}
## TPL longest
function {fn}<{tparam} extends {constraint}>({a}: {tparam}, {b}: {tparam}): {tparam} {
  if ({a}.length >= {b}.length) {
    return {a};
  }
  return {b};
}

# CARD U2-functions — function declarations, arrows, function types
## TPL fn
function {fn}({params}): {ret} {
  {body}
}
## TPL fnopt
function {fn}({p1}: {t1}, {p2}?: {t2}): {ret} {
  {body}
}
## TPL arrowmap
const {arr}: {etype}[] = [{items}];
const {out}: {etype}[] = {arr}.map(({p}) => {expr});
## TPL fnalias
type {alias} = ({a}: {ta}, {b}: {tb}) => {tret};
function {fn}(op: {alias}, {pa}: {ta}, {pb}: {tb}): {tret} {
  return op({pa}, {pb});
}

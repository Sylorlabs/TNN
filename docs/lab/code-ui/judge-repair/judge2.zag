// judge2.zag — CONSCIOUS VISUAL-JUDGMENT mechanism v2 (pure Zag, zero RNG).
//
// Repair iteration over judge.zag (v1), calibrated blind against failure
// CLASSES (never against the official B2 set). Changes from v1:
//   1. CONTRAST blind spot: v1 measured page-mean ink luminance at a high
//      (|dL|>48) threshold, so near-invisible body text was either undetected
//      or averaged away against photo-heavy refs. v2 adds m_body_contrast:
//      text structure is detected at a low (|dL|>12) threshold so faint text
//      forms bands, and the DOMINANT body band's own text/background contrast
//      is judged against an absolute readability bar (3000 = 3.0:1).
//      CONTRAST_POOR fires on the legacy envelope deviation OR the body bar.
//   2. Score compression: v1's flat weighted mean diluted strong signals
//      (many pages tied at 830). v2 doubles the worst metric's weight and
//      adds a quadratic term, so multi-defect pages separate from clean ones.
//   3. False positives: defect fire threshold 450 -> 600 dev; per-defect
//      penalty tiered (mild -60 / severe -80 -> -60/-120); HIERARCHY_FLAT,
//      ALIGNMENT_WEAK, DENSITY_CLUTTER, MARGIN_CROWDED, COLOR_UNRESTRAINED
//      redefined on absolute bars / text-aware metrics after v1's
//      photo-poisoned envelopes fired on clean pages.
//   4. Sense evidence: investigated on 14 dev fixtures x 2 representations
//      (168 frozen-sense runs). shapetrans is degenerate on UI screenshots
//      (a: always TRIANGLE, b: always CIRCLE); colordisc evidence strings are
//      identical for good and bad pages (coarse mean-color similarity); the
//      >=3 majority bonus never fires. The evidence is parsed and traced but
//      carries zero scoring weight -- documented, not fitted.
//      Consequence: verdicts are representation-invariant for this judge.
//
// CLI:
//   judge2 metrics <img>                                   -> metric vector
//   judge2 judge <judged.img> <refs_profile_v2.txt> <sense_evidence.txt>
// Determinism: 3 runs byte-identical (no wall-clock, no RNG, no uninit reads).
//
// znc workarounds honored: no argc gate, []u8 arenas + LE accessors only
// (never `as []i32`), no slice ==, no `.*` on non-pointers, no `};`,
// bare `return;` in void fns, shallow else nesting, explicit init.

@import("R33_NATIVE_IO_V1.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}

// ---------------- integer math --------------------------------------------
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}
// zero a byte slice (nio_alloc is NOT zeroed; counting arenas must be explicit)
fn zfill(s:[]u8) void {
    let i:i32 = 0;
    while(i < s.len) { s[i] = 0; i = i + 1; }
    return;
}

// ---------------- file IO ---------------------------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
// Read a whole file into a fresh arena. Returns "" on any error.
fn z_read_all(path:[]u8) []u8 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return ""; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return ""; }
    let size:i64 = nio_seek(fd, 0, 2);
    if(size < 0 || size > 9000000) { nio_close(fd); return ""; }
    let out:[]u8 = nio_alloc(size as i32);
    if(out.len == 0) { nio_close(fd); return ""; }
    let n:i64 = nio_read_exact(fd, out, size as i32);
    nio_close(fd);
    if(n < 0) { nio_free(out); return ""; }
    return out;
}

// ---------------- stdout line builder ---------------------------------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}

// ---------------- text parsing ----------------------------------------------
// Parse a decimal integer from buf[lo..hi). Handles optional leading '-'.
fn parse_int(buf:[]u8, lo:i32, hi:i32) i64 {
    let neg:i64 = 1;
    let v:i64 = 0;
    let i:i32 = lo;
    if(i < hi && buf[i] == 45) { neg = 0 - 1; i = i + 1; }
    while(i < hi) {
        let c:i64 = buf[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v * neg;
}
// Find '=' in buf[lo..hi); return index or -1.
fn find_eq(buf:[]u8, lo:i32, hi:i32) i32 {
    let i:i32 = lo;
    while(i < hi) {
        if(buf[i] == 61) { return i; }
        i = i + 1;
    }
    return -1;
}

// ---------------- metric computation --------------------------------------
// Metric indices: 0 bg_lum, 1 ink_lum, 2 contrast, 3 ink_total_pm,
// 4 bands, 5 gap_cv_pm, 6 margin_ink_pm, 7 guides, 8 align_conc_pm,
// 9 type_modes, 10 hues (small-band chrome hues), 11 hero_ratio_pm,
// 12 rows, 13 satcov_pm, 14 body_contrast, 15 align_k, 16 margin_share_pm.
//
// Two ink thresholds: SOLID (|dL|>48, legacy metrics) and LOW (|dL|>12,
// text structure). Faint body text is invisible at SOLID but forms bands
// at LOW, which is what m_body_contrast measures.
fn compute_metrics(img:[]u8, m:[]u8, op:[]u8) i32 {
    let w:i32 = t_get32(img, 0) as i32;
    let h:i32 = t_get32(img, 4) as i32;
    if(w < 8 || h < 8 || w > 2048 || h > 2048) { return 1; }
    let np:i32 = w * h;
    if(np <= 0 || img.len < 8 + np * 3) { return 2; }
    let lum:[]u8 = nio_alloc(np);
    if(lum.len == 0) { return 3; }
    let hist:[]u8 = nio_alloc(64);
    let rows:[]u8 = nio_alloc(h * 4);
    let rowslow:[]u8 = nio_alloc(h * 4);
    let cols:[]u8 = nio_alloc(w * 4);
    let hueb:[]u8 = nio_alloc(48);
    if(hist.len == 0 || rows.len == 0 || rowslow.len == 0 || cols.len == 0
       || hueb.len == 0) {
        nio_free(lum); nio_free(hist); nio_free(rows);
        nio_free(rowslow); nio_free(cols); nio_free(hueb);
        return 4;
    }
    zfill(hist); zfill(rows); zfill(rowslow); zfill(cols); zfill(hueb);
    // pass 1: luminance + histogram
    let p:i32 = 0;
    while(p < np) {
        let o:i32 = 8 + p * 3;
        let r:i64 = img[o] as i64;
        let g:i64 = img[o + 1] as i64;
        let b:i64 = img[o + 2] as i64;
        let L:i64 = (299 * r + 587 * g + 114 * b) / 1000;
        lum[p] = L as u8;
        let bin:i32 = (L / 16) as i32;
        if(bin > 15) { bin = 15; }
        t_put32(hist, bin * 4, t_get32(hist, bin * 4) + 1);
        p = p + 1;
    }
    op_add(op, np as i64);
    // background = argmax histogram bin
    let bg_bin:i32 = 0;
    let bg_c:i64 = 0;
    let q:i32 = 0;
    while(q < 16) {
        let c:i64 = t_get32(hist, q * 4);
        if(c > bg_c) { bg_c = c; bg_bin = q; }
        q = q + 1;
    }
    let bg_lum:i64 = (bg_bin as i64) * 16 + 8;
    // pass 2: ink masks at both thresholds, row counts, ink luminance
    let ink_total:i64 = 0;
    let ink_lum_sum:i64 = 0;
    let sat_total:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        let rowink:i64 = 0;
        let rowlow:i64 = 0;
        while(x < w) {
            let L:i64 = lum[y * w + x] as i64;
            let d:i64 = L - bg_lum;
            let ad:i64 = d;
            if(ad < 0) { ad = 0 - ad; }
            if(ad > 48) {
                rowink = rowink + 1;
                ink_total = ink_total + 1;
                ink_lum_sum = ink_lum_sum + L;
            }
            if(ad > 12) { rowlow = rowlow + 1; }
            let o:i32 = 8 + (y * w + x) * 3;
            let r:i64 = img[o] as i64;
            let g:i64 = img[o + 1] as i64;
            let b:i64 = img[o + 2] as i64;
            let mx:i64 = imax(r, imax(g, b));
            let mn:i64 = imin(r, imin(g, b));
            let sat:i64 = mx - mn;
            if(sat > 48) { sat_total = sat_total + 1; }
            x = x + 1;
        }
        t_put32(rows, y * 4, rowink);
        t_put32(rowslow, y * 4, rowlow);
        y = y + 1;
    }
    op_add(op, np as i64);
    // pass 3: vertical edge energy per column (legacy context metric)
    let xx:i32 = 1;
    while(xx < w) {
        let yy:i32 = 0;
        let c:i64 = 0;
        while(yy < h) {
            let d:i64 = (lum[yy * w + xx] as i64) - (lum[yy * w + xx - 1] as i64);
            if(d > 56 || d < -56) { c = c + 1; }
            yy = yy + 1;
        }
        t_put32(cols, xx * 4, c);
        xx = xx + 1;
    }
    op_add(op, np as i64);
    // guides: columns with edge count > 12% of height (legacy context)
    let gthr:i64 = (h as i64) * 12 / 100;
    let ge:[]u8 = nio_alloc(160);
    let ng:i32 = 0;
    let tot_e:i64 = 0;
    xx = 0;
    while(xx < w) {
        let c:i64 = t_get32(cols, xx * 4);
        tot_e = tot_e + c;
        if(c > gthr && ng < 40) {
            t_put32(ge, ng * 4, c);
            ng = ng + 1;
        }
        xx = xx + 1;
    }
    // top-4 guide energy (selection, 4 passes)
    let top4:i64 = 0;
    let used:[]u8 = nio_alloc(160);
    zfill(used);
    let pass:i32 = 0;
    while(pass < 4) {
        let bi:i32 = -1;
        let bv:i64 = -1;
        let gi:i32 = 0;
        while(gi < ng) {
            let v:i64 = t_get32(ge, gi * 4);
            if(used[gi] == 0 && v > bv) { bv = v; bi = gi; }
            gi = gi + 1;
        }
        if(bi >= 0) { used[bi] = 1; top4 = top4 + bv; }
        pass = pass + 1;
    }
    let align_conc:i64 = 1000;
    if(tot_e > 0) { align_conc = top4 * 1000 / tot_e; }
    // bands from LOW-threshold rows (faint text forms bands here).
    // band record (40 bytes): top@0 bottom@4 bink_solid@8 blow@12
    // left@16 right@20 bgmean@24 inkmean@32
    let bands:[]u8 = nio_alloc(2560);
    let nb:i32 = 0;
    let inband:i32 = 0;
    let btop:i32 = 0;
    let bink:i64 = 0;
    let blow_acc:i64 = 0;
    y = 0;
    while(y < h) {
        let ri:i64 = t_get32(rowslow, y * 4);
        let istext:i32 = 0;
        if(ri * 1000 > (w as i64) * 25) { istext = 1; }
        if(istext == 1 && inband == 0) {
            inband = 1; btop = y;
            bink = t_get32(rows, y * 4); blow_acc = ri;
        }
        if(istext == 1 && inband == 1) {
            bink = bink + t_get32(rows, y * 4); blow_acc = blow_acc + ri;
        }
        if(istext == 0 && inband == 1) {
            if(nb < 64) {
                t_put32(bands, nb * 64, btop as i64);
                t_put32(bands, nb * 64 + 4, (y - 1) as i64);
                t_put32(bands, nb * 64 + 8, bink);
                t_put32(bands, nb * 64 + 12, blow_acc);
                nb = nb + 1;
            }
            inband = 0;
        }
        y = y + 1;
    }
    if(inband == 1 && nb < 64) {
        t_put32(bands, nb * 64, btop as i64);
        t_put32(bands, nb * 64 + 4, (h - 1) as i64);
        t_put32(bands, nb * 64 + 8, bink);
        t_put32(bands, nb * 64 + 12, blow_acc);
        nb = nb + 1;
    }
    // per-band pixel pass: band backdrop = luminance MODE of band rows
    // (first principles: text is judged against its LOCAL backdrop, not the
    // page-global bg -- white text on a dark photo is readable). Then ink
    // stats vs the mode, edges, and small-band hue bins.
    // A band counts as "small" (chrome/text, not photo) when height <= h/10.
    let small_h:i32 = h / 10;
    if(small_h < 24) { small_h = 24; }
    let bhist:[]u8 = nio_alloc(64);
    let inkh:[]u8 = nio_alloc(64);
    let bi3:i32 = 0;
    while(bi3 < nb) {
        let b0:i32 = t_get32(bands, bi3 * 64) as i32;
        let b1:i32 = t_get32(bands, bi3 * 64 + 4) as i32;
        let bh:i64 = (b1 - b0 + 1) as i64;
        // pass 1: luminance histogram -> mode backdrop
        zfill(bhist);
        let yy3:i32 = b0;
        while(yy3 <= b1) {
            let xx3:i32 = 0;
            while(xx3 < w) {
                let L:i64 = lum[yy3 * w + xx3] as i64;
                let bin3:i32 = (L / 16) as i32;
                if(bin3 > 15) { bin3 = 15; }
                t_put32(bhist, bin3 * 4, t_get32(bhist, bin3 * 4) + 1);
                xx3 = xx3 + 1;
            }
            yy3 = yy3 + 1;
        }
        let mbin:i32 = 0;
        let mc:i64 = 0;
        let qb:i32 = 0;
        while(qb < 16) {
            let c:i64 = t_get32(bhist, qb * 4);
            if(c > mc) { mc = c; mbin = qb; }
            qb = qb + 1;
        }
        let bbg:i64 = (mbin as i64) * 16 + 8;
        // pass 2: ink vs the mode backdrop, edges, small-band hues
        let left:i32 = w;
        let right:i32 = -1;
        let iks:i64 = 0;
        let ikn:i64 = 0;
        zfill(inkh);
        yy3 = b0;
        while(yy3 <= b1) {
            let xx3:i32 = 0;
            while(xx3 < w) {
                let L:i64 = lum[yy3 * w + xx3] as i64;
                let dg:i64 = L - bbg;
                let adg:i64 = dg;
                if(adg < 0) { adg = 0 - adg; }
                if(adg > 12) {
                    iks = iks + L; ikn = ikn + 1;
                    let ibin:i32 = (L / 16) as i32;
                    if(ibin > 15) { ibin = 15; }
                    if(ibin < 0) { ibin = 0; }
                    t_put32(inkh, ibin * 4, t_get32(inkh, ibin * 4) + 1);
                    if(xx3 < left) { left = xx3; }
                    if(xx3 > right) { right = xx3; }
                }
                if(bh <= small_h as i64) {
                    let o:i32 = 8 + (yy3 * w + xx3) * 3;
                    let r:i64 = img[o] as i64;
                    let g:i64 = img[o + 1] as i64;
                    let b:i64 = img[o + 2] as i64;
                    let mx:i64 = imax(r, imax(g, b));
                    let mn:i64 = imin(r, imin(g, b));
                    let sat:i64 = mx - mn;
                    if(sat > 48) {
                        let mid:i64 = r + g + b - mx - mn;
                        let base:i64 = 8;
                        if(r >= g && r >= b) { base = 0; }
                        if(g >= r && g >= b) { base = 4; }
                        let t:i64 = 0;
                        if(mx > mn) { t = (mid - mn) * 2 / (mx - mn); }
                        if(t > 2) { t = 2; }
                        let hb2:i32 = (base + t) as i32;
                        t_put32(hueb, hb2 * 4, t_get32(hueb, hb2 * 4) + 1);
                    }
                }
                xx3 = xx3 + 1;
            }
            yy3 = yy3 + 1;
        }
        if(left > right) { left = 0; right = 0; }
        t_put32(bands, bi3 * 64 + 16, left as i64);
        t_put32(bands, bi3 * 64 + 20, right as i64);
        t_put32(bands, bi3 * 64 + 24, bbg);
        // ink representative: 25th percentile from the text end
        // (robust to anti-aliasing fringes that pull the mean).
        let bim:i64 = 0 - 1;
        if(ikn > 0) {
            let ink_mean:i64 = iks / ikn;
            let target:i64 = ikn / 4;
            let acc:i64 = 0;
            let found:i64 = 0 - 1;
            if(ink_mean < bbg) {
                // dark text: 25th percentile from dark end
                let b4:i32 = 0;
                while(b4 < 16) {
                    acc = acc + t_get32(inkh, b4 * 4);
                    if(found < 0 && acc >= target) { found = (b4 as i64) * 16 + 8; }
                    b4 = b4 + 1;
                }
            } else {
                // light text: 25th percentile from light end
                let b4:i32 = 15;
                while(b4 >= 0) {
                    acc = acc + t_get32(inkh, b4 * 4);
                    if(found < 0 && acc >= target) { found = (b4 as i64) * 16 + 8; }
                    b4 = b4 - 1;
                }
            }
            if(found >= 0) { bim = found; } else { bim = ink_mean; }
        }
        t_put32(bands, bi3 * 64 + 32, bim);
        bi3 = bi3 + 1;
    }
    nio_free(bhist);
    nio_free(inkh);
    op_add(op, (nb as i64) * (h as i64));
    // gap CV between bands
    let gap_cv:i64 = 1000;
    if(nb >= 2) {
        let gs:i64 = 0;
        let gsq:i64 = 0;
        let gi2:i32 = 1;
        while(gi2 < nb) {
            let gp:i64 = t_get32(bands, gi2 * 64) - t_get32(bands, (gi2 - 1) * 64 + 4) - 1;
            if(gp < 0) { gp = 0; }
            gs = gs + gp;
            gsq = gsq + gp * gp;
            gi2 = gi2 + 1;
        }
        let gn:i64 = (nb - 1) as i64;
        let gmean:i64 = gs / gn;
        let gvar:i64 = gsq / gn - gmean * gmean;
        if(gvar < 0) { gvar = 0; }
        let gstd:i64 = 0;
        let r2:i64 = gvar;
        if(r2 > 0) {
            let yy2:i64 = r2;
            if(yy2 > 3037000499) { yy2 = 3037000499; }
            let z:i64 = (yy2 + 1) / 2;
            while(z < yy2) { yy2 = z; z = (yy2 + r2 / yy2) / 2; }
            gstd = yy2;
        }
        if(gmean > 0) { gap_cv = gstd * 1000 / gmean; }
    }
    // margin ink (solid rows): outer 10% rows
    let mh:i32 = h / 10;
    let marg:i64 = 0;
    y = 0;
    while(y < mh) { marg = marg + t_get32(rows, y * 4); y = y + 1; }
    y = h - mh;
    while(y < h) { marg = marg + t_get32(rows, y * 4); y = y + 1; }
    let margin_ink:i64 = marg * 1000 / (np as i64);
    let margin_share:i64 = 0;
    if(ink_total > 0) { margin_share = marg * 1000 / ink_total; }
    // type modes: distinct band-height classes (height/8)
    let hcls:[]u8 = nio_alloc(48);
    let qc:i32 = 0;
    while(qc < 12) { t_put32(hcls, qc * 4, -1); qc = qc + 1; }
    let nmodes:i32 = 0;
    let bi2:i32 = 0;
    while(bi2 < nb) {
        let bh:i64 = t_get32(bands, bi2 * 64 + 4) - t_get32(bands, bi2 * 64) + 1;
        let cls:i64 = bh / 8;
        let found:i32 = 0;
        qc = 0;
        while(qc < 12) {
            if(t_get32(hcls, qc * 4) == cls) { found = 1; }
            qc = qc + 1;
        }
        if(found == 0 && nmodes < 12) {
            t_put32(hcls, nmodes * 4, cls);
            nmodes = nmodes + 1;
        }
        bi2 = bi2 + 1;
    }
    // dominant hues among SMALL-band (chrome/text) pixels: bins > 0.5% of
    // all pixels. Photo hues are excluded: photos form tall bands.
    let hues:i32 = 0;
    q = 0;
    while(q < 12) {
        if(t_get32(hueb, q * 4) * 1000 > (np as i64) * 5) { hues = hues + 1; }
        q = q + 1;
    }
    // hero ratio: largest band mass share (mass = height * low-threshold ink)
    let totmass:i64 = 0;
    let maxmass:i64 = 0;
    bi2 = 0;
    while(bi2 < nb) {
        let bh2:i64 = t_get32(bands, bi2 * 64 + 4) - t_get32(bands, bi2 * 64) + 1;
        let mass:i64 = bh2 * t_get32(bands, bi2 * 64 + 12);
        totmass = totmass + mass;
        if(mass > maxmass) { maxmass = mass; }
        bi2 = bi2 + 1;
    }
    let hero_ratio:i64 = 1000;
    if(totmass > 0) { hero_ratio = maxmass * 1000 / totmass; }
    // m_body_contrast: contrast of the DOMINANT body band
    // (height <= h/10, largest low-threshold ink mass). Absolute readability
    // bar: the band's own text vs its own local backdrop (luminance mode).
    // Bands whose backdrop differs from the page-global bg by >24 are
    // photo/texture bands, not page-bg body text: judging text-on-photo
    // contrast needs local analysis this metric does not do, so they are
    // skipped rather than misjudged. Contrast uses WCAG 2.x relative
    // luminance via the sRGB linearization table (absolute 3.0:1 bar).
    // Body = the largest-blow small band in the MIDDLE 70% of the page
    // (header/footer chrome in the top/bottom 15% is not body text).
    let linL:[]u8 = linL_tab();
    let body_contrast:i64 = 30000;
    let best_blow:i64 = 0;
    let ylo:i32 = h * 15 / 100;
    let yhi:i32 = h * 85 / 100;
    bi2 = 0;
    while(bi2 < nb) {
        let b0_3:i32 = t_get32(bands, bi2 * 64) as i32;
        let bh3:i64 = t_get32(bands, bi2 * 64 + 4) - t_get32(bands, bi2 * 64) + 1;
        let bl3:i64 = t_get32(bands, bi2 * 64 + 12);
        let bim3:i64 = t_get32(bands, bi2 * 64 + 32);
        let bbg3:i64 = t_get32(bands, bi2 * 64 + 24);
        let offbg:i64 = bbg3 - bg_lum;
        if(offbg < 0) { offbg = 0 - offbg; }
        let cy:i32 = b0_3 + (bh3 as i32) / 2;
        if(bh3 <= small_h as i64 && bl3 > best_blow && bim3 >= 0
           && offbg <= 24 && cy >= ylo && cy <= yhi) {
            let bgc:i64 = bbg3;
            if(bgc > 255) { bgc = 255; }
            if(bgc < 0) { bgc = 0; }
            let imc:i64 = bim3;
            if(imc > 255) { imc = 255; }
            if(imc < 0) { imc = 0; }
            let l1:i64 = t_get32(linL, bgc * 4);
            let l2:i64 = t_get32(linL, imc * 4);
            let hi:i64 = imax(l1, l2);
            let lo:i64 = imin(l1, l2);
            let bc:i64 = (hi + 5000) * 1000 / (lo + 5000);
            if(bc > 30000) { bc = 30000; }
            body_contrast = bc;
            best_blow = bl3;
        }
        bi2 = bi2 + 1;
    }
    nio_free(linL);
    // m_align_k: min over (distinct left bins, distinct right bins,
    // distinct center bins) with 16px quantization. Aligned layouts share
    // few distinct lefts, rights, or centers; misaligned scatter all three.
    let seen:[]u8 = nio_alloc(48);
    let nl:i32 = 0;
    let nr:i32 = 0;
    let nc:i32 = 0;
    qc = 0;
    while(qc < 12) { t_put32(seen, qc * 4, -1); qc = qc + 1; }
    bi2 = 0;
    while(bi2 < nb) {
        let lb:i64 = t_get32(bands, bi2 * 64 + 16) / 16;
        let rb:i64 = t_get32(bands, bi2 * 64 + 20) / 16;
        let cb:i64 = (t_get32(bands, bi2 * 64 + 16)
                      + t_get32(bands, bi2 * 64 + 20)) / 32;
        // left
        let f:i32 = 0;
        qc = 0;
        while(qc < 12) {
            if(t_get32(seen, qc * 4) == lb) { f = 1; }
            qc = qc + 1;
        }
        if(f == 0 && nl < 12) { t_put32(seen, nl * 4, lb); nl = nl + 1; }
        bi2 = bi2 + 1;
    }
    qc = 0;
    while(qc < 12) { t_put32(seen, qc * 4, -1); qc = qc + 1; }
    bi2 = 0;
    while(bi2 < nb) {
        let rb:i64 = t_get32(bands, bi2 * 64 + 20) / 16;
        let f:i32 = 0;
        qc = 0;
        while(qc < 12) {
            if(t_get32(seen, qc * 4) == rb) { f = 1; }
            qc = qc + 1;
        }
        if(f == 0 && nr < 12) { t_put32(seen, nr * 4, rb); nr = nr + 1; }
        bi2 = bi2 + 1;
    }
    qc = 0;
    while(qc < 12) { t_put32(seen, qc * 4, -1); qc = qc + 1; }
    bi2 = 0;
    while(bi2 < nb) {
        let cb:i64 = (t_get32(bands, bi2 * 64 + 16)
                      + t_get32(bands, bi2 * 64 + 20)) / 32;
        let f:i32 = 0;
        qc = 0;
        while(qc < 12) {
            if(t_get32(seen, qc * 4) == cb) { f = 1; }
            qc = qc + 1;
        }
        if(f == 0 && nc < 12) { t_put32(seen, nc * 4, cb); nc = nc + 1; }
        bi2 = bi2 + 1;
    }
    let align_k:i64 = nl as i64;
    if((nr as i64) < align_k) { align_k = nr as i64; }
    if((nc as i64) < align_k) { align_k = nc as i64; }
    // legacy contrast (solid ink mean vs bg): backstop only
    let ink_mean:i64 = bg_lum;
    if(ink_total > 0) { ink_mean = ink_lum_sum / ink_total; }
    let hi:i64 = imax(bg_lum, ink_mean);
    let lo:i64 = imin(bg_lum, ink_mean);
    let contrast:i64 = (hi + 10) * 1000 / (lo + 10);
    if(contrast > 30000) { contrast = 30000; }
    let ink_total_pm:i64 = ink_total * 1000 / (np as i64);
    let satcov_pm:i64 = sat_total * 1000 / (np as i64);
    // store (17 metrics)
    t_put64(m, 0 * 8, bg_lum);
    t_put64(m, 1 * 8, ink_mean);
    t_put64(m, 2 * 8, contrast);
    t_put64(m, 3 * 8, ink_total_pm);
    t_put64(m, 4 * 8, nb as i64);
    t_put64(m, 5 * 8, gap_cv);
    t_put64(m, 6 * 8, margin_ink);
    t_put64(m, 7 * 8, (ng as i64));
    t_put64(m, 8 * 8, align_conc);
    t_put64(m, 9 * 8, nmodes as i64);
    t_put64(m, 10 * 8, hues as i64);
    t_put64(m, 11 * 8, hero_ratio);
    t_put64(m, 12 * 8, h as i64);
    t_put64(m, 13 * 8, satcov_pm);
    t_put64(m, 14 * 8, body_contrast);
    t_put64(m, 15 * 8, align_k);
    t_put64(m, 16 * 8, margin_share);
    nio_free(lum); nio_free(hist); nio_free(rows); nio_free(rowslow);
    nio_free(cols); nio_free(hueb); nio_free(ge); nio_free(used);
    nio_free(bands); nio_free(hcls); nio_free(seen);
    return 0;
}

// length of NUL-terminated string in a fixed slot
fn zlen(b:[]u8) i32 {
    let i:i32 = 0;
    while(i < b.len && b[i] != 0) { i = i + 1; }
    return i;
}

// ---------------- profile + evidence parsing --------------------------------
// refs: 5 x 17 i64 arena. names: 5 x 32-byte slots (NUL-padded).
fn parse_profile(txt:[]u8, refs:[]u8, names:[]u8) i32 {
    let blk:i32 = 0;
    let mi:i32 = 0;
    let i:i32 = 0;
    while(i < txt.len) {
        let j:i32 = i;
        while(j < txt.len && txt[j] != 10) { j = j + 1; }
        let eq:i32 = find_eq(txt, i, j);
        if(eq > 0 && blk < 5) {
            if(txt[i] == 114) {
                // "ref=<name>"
                let k:i32 = 0;
                let s2:i32 = eq + 1;
                while(s2 < j && k < 31) {
                    names[blk * 32 + k] = txt[s2];
                    s2 = s2 + 1; k = k + 1;
                }
                names[blk * 32 + k] = 0;
            }
            if(txt[i] == 109 && mi < 17) {
                // "m_...=<int>"
                let v:i64 = parse_int(txt, eq + 1, j);
                t_put64(refs, (blk * 17 + mi) * 8, v);
                mi = mi + 1;
                if(mi >= 17) { mi = 0; blk = blk + 1; }
            }
        }
        i = j + 1;
    }
    if(blk == 5) { return 0; }
    return 1;
}
// ev: 5 colordisc bytes (1=SAME) + shapetrans code at [5]; rep at [6].
fn parse_evidence(txt:[]u8, ev:[]u8) i32 {
    let ci:i32 = 0;
    let i:i32 = 0;
    while(i < txt.len) {
        let j:i32 = i;
        while(j < txt.len && txt[j] != 10) { j = j + 1; }
        let eq:i32 = find_eq(txt, i, j);
        if(eq > 0) {
            if(txt[i] == 114 && ci == 0) {
                // "representation=a|b"
                if(eq + 1 < j && txt[eq + 1] == 98) { ev[6] = 1; }
                ci = 1;
            }
            if(txt[i] == 99 && ci >= 1 && ci <= 5) {
                // "colordisc=SAME|DIFFERENT"
                let same:i32 = 0;
                if(_zag_strcmp(txt[eq + 1 .. j], "SAME") == 1) { same = 1; }
                ev[ci - 1] = same as u8;
                ci = ci + 1;
            }
            if(txt[i] == 115) {
                // "shapetrans=<VALUE>"
                let code:i32 = 0;
                if(_zag_strcmp(txt[eq + 1 .. j], "SQUARE") == 1) { code = 1; }
                if(_zag_strcmp(txt[eq + 1 .. j], "CIRCLE") == 1) { code = 2; }
                if(_zag_strcmp(txt[eq + 1 .. j], "TRIANGLE") == 1) { code = 3; }
                ev[5] = code as u8;
            }
        }
        i = j + 1;
    }
    return 0;
}

// ---------------- scoring ---------------------------------------------------
// Scored: 2 contrast(env,low), 4 bands(abs,high), 5 gap_cv(env,high),
// 9 type_modes(env,high), 10 hues(env,high), 11 hero_ratio(abs,low),
// 13 satcov(env,high), 14 body_contrast(abs,low),
// 15 align_k(abs,high), 16 margin_share(abs,high).
fn mscored(mi:i32) i32 {
    if(mi == 2) { return 1; }
    if(mi == 4) { return 1; }
    if(mi == 5) { return 1; }
    if(mi == 9) { return 1; }
    if(mi == 10) { return 1; }
    if(mi == 11) { return 1; }
    if(mi == 13) { return 1; }
    if(mi == 14) { return 1; }
    if(mi == 15) { return 1; }
    if(mi == 16) { return 1; }
    return 0;
}
// absolute-bar metrics (not envelope): 4, 10, 11, 14, 15, 16.
fn mabs(mi:i32) i32 {
    if(mi == 4) { return 1; }
    if(mi == 10) { return 1; }
    if(mi == 11) { return 1; }
    if(mi == 14) { return 1; }
    if(mi == 15) { return 1; }
    if(mi == 16) { return 1; }
    return 0;
}
// bad direction for envelope metrics: 1 = high bad, -1 = low bad.
fn mbaddir(mi:i32) i64 {
    if(mi == 2) { return 0 - 1; }
    return 1;
}
fn mtol(mi:i32) i64 {
    if(mi == 2) { return 1000; }
    if(mi == 5) { return 300; }
    if(mi == 9) { return 2; }
    if(mi == 10) { return 2; }
    if(mi == 13) { return 150; }
    return 150;
}
fn mw(mi:i32) i64 {
    if(mi == 2) { return 2; }
    if(mi == 14) { return 2; }
    return 1;
}
// Absolute-bar deviations (first-principles bars, documented in the
// protocol amendments). dev in 0..1000.
fn dev_abs(mi:i32, v:i64) i64 {
    let d:i64 = 0;
    if(mi == 4) {
        // DENSITY: >13 text bands at 480x360 hero scale = cluttered
        if(v > 13) { d = (v - 13) * 1000 / 5; }
    }
    if(mi == 10) {
        // COLOR: chrome/text hues are counted in small bands only (photo
        // hues excluded). All 5 refs score 0, so the envelope is degenerate;
        // absolute bar: 4+ distinct chrome hues = unrestrained.
        if(v >= 4) { d = (v - 3) * 1000 / 3; }
    }
    if(mi == 11) {
        // HIERARCHY: largest band < 35% of text mass = flat
        if(v < 350) { d = (350 - v) * 1000 / 175; }
    }
    if(mi == 14) {
        // READABILITY: dominant body text below 3.0:1 = poor contrast
        if(v < 3000) { d = (3000 - v) * 1000 / 1200; }
    }
    if(mi == 15) {
        // ALIGNMENT: >=5 distinct edge positions in every axis = scattered
        if(v >= 4) { d = (v - 3) * 1000 / 3; }
    }
    if(mi == 16) {
        // MARGINS: >70% of content in outer 10% rows = crowded
        if(v > 700) { d = (v - 700) * 1000 / 150; }
    }
    if(d > 1000) { d = 1000; }
    if(d < 0) { d = 0; }
    return d;
}
// Deviation vector + score. devs: 17-slot i64 arena.
fn score_all(m:[]u8, env_lo:[]u8, env_hi:[]u8, devs:[]u8) i64 {
    let acc:i64 = 0;
    let wsum:i64 = 0;
    let maxwdev:i64 = 0;
    let mi:i32 = 0;
    while(mi < 17) {
        t_put64(devs, mi * 8, 0);
        if(mscored(mi) == 1) {
            let mj:i64 = t_get64(m, mi * 8);
            let dev:i64 = 0;
            if(mabs(mi) == 1) {
                dev = dev_abs(mi, mj);
            }
            if(mabs(mi) == 0) {
                let lo:i64 = t_get64(env_lo, mi * 8);
                let hi:i64 = t_get64(env_hi, mi * 8);
                if(mbaddir(mi) == 1 && mj > hi) {
                    dev = (mj - hi) * 1000 / mtol(mi);
                }
                if(mbaddir(mi) == -1 && mj < lo) {
                    dev = (lo - mj) * 1000 / mtol(mi);
                }
                if(dev > 1000) { dev = 1000; }
            }
            t_put64(devs, mi * 8, dev);
            let wd:i64 = mw(mi) * dev;
            acc = acc + wd;
            wsum = wsum + mw(mi);
            if(wd > maxwdev) { maxwdev = wd; }
        }
        mi = mi + 1;
    }
    // The worst metric counts double; a quadratic term spreads the
    // multi-defect tail away from the clean cluster (fixes 830-ties).
    let meanex:i64 = (acc + maxwdev) / wsum;
    let pen:i64 = meanex + meanex * meanex / 2500;
    return pen;
}
fn defect_name(di:i32) []u8 {
    if(di == 0) { return "TYPOGRAPHY_INCONSISTENT"; }
    if(di == 1) { return "CONTRAST_POOR"; }
    if(di == 2) { return "SPACING_IRREGULAR"; }
    if(di == 3) { return "MARGIN_CROWDED"; }
    if(di == 4) { return "DENSITY_CLUTTER"; }
    if(di == 5) { return "HIERARCHY_FLAT"; }
    if(di == 6) { return "COLOR_UNRESTRAINED"; }
    return "ALIGNMENT_WEAK";
}
// defect severity = max dev over its input metrics.
fn defect_sev(di:i32, devs:[]u8) i64 {
    let s:i64 = 0;
    let d:i64 = 0;
    if(di == 0) { s = t_get64(devs, 9 * 8); }
    if(di == 1) {
        s = t_get64(devs, 2 * 8);
        d = t_get64(devs, 14 * 8);
        if(d > s) { s = d; }
    }
    if(di == 2) { s = t_get64(devs, 5 * 8); }
    if(di == 3) { s = t_get64(devs, 16 * 8); }
    if(di == 4) { s = t_get64(devs, 4 * 8); }
    if(di == 5) { s = t_get64(devs, 11 * 8); }
    if(di == 6) {
        s = t_get64(devs, 10 * 8);
        d = t_get64(devs, 13 * 8);
        if(d > s) { s = d; }
    }
    if(di == 7) { s = t_get64(devs, 15 * 8); }
    return s;
}

// ---------------- main ------------------------------------------------------
fn main() void {
    let mode:[]u8 = _zag_arg(1);
    let ob:[]u8 = nio_alloc(16384);
    let pos:i32 = 0;
    if(ob.len == 0) { return; }
    if(_zag_strcmp(mode, "metrics") == 1) {
        let img:[]u8 = z_read_all(_zag_arg(2));
        if(img.len == 0) {
            pos = ob_kv(ob, pos, "error", "read_img_failed");
            _zag_print(ob[0..pos]);
            return;
        }
        let m:[]u8 = nio_alloc(17 * 8);
        let op:[]u8 = nio_alloc(8);
        let rc:i32 = compute_metrics(img, m, op);
        if(rc != 0) {
            pos = ob_kv(ob, pos, "error", "metrics_failed");
            pos = ob_kint(ob, pos, "rc", rc as i64);
            _zag_print(ob[0..pos]);
            return;
        }
        pos = ob_kv(ob, pos, "mechanism", "aesthetic-judge-v2");
        pos = ob_kint(ob, pos, "m_bg_lum", t_get64(m, 0 * 8));
        pos = ob_kint(ob, pos, "m_ink_lum", t_get64(m, 1 * 8));
        pos = ob_kint(ob, pos, "m_contrast", t_get64(m, 2 * 8));
        pos = ob_kint(ob, pos, "m_ink_total", t_get64(m, 3 * 8));
        pos = ob_kint(ob, pos, "m_bands", t_get64(m, 4 * 8));
        pos = ob_kint(ob, pos, "m_gap_cv", t_get64(m, 5 * 8));
        pos = ob_kint(ob, pos, "m_margin_ink", t_get64(m, 6 * 8));
        pos = ob_kint(ob, pos, "m_guides", t_get64(m, 7 * 8));
        pos = ob_kint(ob, pos, "m_align_conc", t_get64(m, 8 * 8));
        pos = ob_kint(ob, pos, "m_type_modes", t_get64(m, 9 * 8));
        pos = ob_kint(ob, pos, "m_hues", t_get64(m, 10 * 8));
        pos = ob_kint(ob, pos, "m_hero_ratio", t_get64(m, 11 * 8));
        pos = ob_kint(ob, pos, "m_rows", t_get64(m, 12 * 8));
        pos = ob_kint(ob, pos, "m_satcov", t_get64(m, 13 * 8));
        pos = ob_kint(ob, pos, "m_body_contrast", t_get64(m, 14 * 8));
        pos = ob_kint(ob, pos, "m_align_k", t_get64(m, 15 * 8));
        pos = ob_kint(ob, pos, "m_margin_share", t_get64(m, 16 * 8));
        pos = ob_kint(ob, pos, "ops", t_get64(op, 0));
        _zag_print(ob[0..pos]);
        return;
    }
    if(_zag_strcmp(mode, "judge") == 1) {
        let img:[]u8 = z_read_all(_zag_arg(2));
        let ptxt:[]u8 = z_read_all(_zag_arg(3));
        let etxt:[]u8 = z_read_all(_zag_arg(4));
        if(img.len == 0 || ptxt.len == 0 || etxt.len == 0) {
            pos = ob_kv(ob, pos, "error", "read_input_failed");
            _zag_print(ob[0..pos]);
            return;
        }
        let m:[]u8 = nio_alloc(17 * 8);
        let op:[]u8 = nio_alloc(8);
        let rc:i32 = compute_metrics(img, m, op);
        if(rc != 0) {
            pos = ob_kv(ob, pos, "error", "metrics_failed");
            _zag_print(ob[0..pos]);
            return;
        }
        let refs:[]u8 = nio_alloc(5 * 17 * 8);
        let names:[]u8 = nio_alloc(5 * 32);
        if(parse_profile(ptxt, refs, names) != 0) {
            pos = ob_kv(ob, pos, "error", "profile_parse_failed");
            _zag_print(ob[0..pos]);
            return;
        }
        let ev:[]u8 = nio_alloc(8);
        zfill(ev);
        parse_evidence(etxt, ev);
        // reference envelope: per-metric min/max across the 5 references
        // (envelope metrics only; absolute-bar metrics ignore it)
        let env_lo:[]u8 = nio_alloc(17 * 8);
        let env_hi:[]u8 = nio_alloc(17 * 8);
        let mi4:i32 = 0;
        while(mi4 < 17) {
            let lo:i64 = 999999999;
            let hi:i64 = 0 - 999999999;
            let r2:i32 = 0;
            while(r2 < 5) {
                let v:i64 = t_get64(refs, (r2 * 17 + mi4) * 8);
                if(v < lo) { lo = v; }
                if(v > hi) { hi = v; }
                r2 = r2 + 1;
            }
            t_put64(env_lo, mi4 * 8, lo);
            t_put64(env_hi, mi4 * 8, hi);
            mi4 = mi4 + 1;
        }
        let devs:[]u8 = nio_alloc(17 * 8);
        let pen:i64 = score_all(m, env_lo, env_hi, devs);
        // nearest reference (trace info only)
        let best_r:i32 = 0;
        let best_d:i64 = 999999999;
        let r3:i32 = 0;
        while(r3 < 5) {
            let acc2:i64 = 0;
            mi4 = 0;
            while(mi4 < 17) {
                acc2 = acc2 + iabs(t_get64(m, mi4 * 8)
                                  - t_get64(refs, (r3 * 17 + mi4) * 8));
                mi4 = mi4 + 1;
            }
            if(acc2 < best_d) { best_d = acc2; best_r = r3; }
            r3 = r3 + 1;
        }
        // defects: fire at dev >= 600 (mild, -100), severe at >= 800 (-250)
        let nd:i32 = 0;
        let nsev:i32 = 0;
        let di:i32 = 0;
        let dlist:[]u8 = nio_alloc(512);
        let dl:i32 = 0;
        while(di < 8) {
            let sv:i64 = defect_sev(di, devs);
            if(sv >= 600) {
                if(dl > 0) { dl = ob_add(dlist, dl, ","); }
                dl = ob_add(dlist, dl, defect_name(di));
                nd = nd + 1;
                if(sv >= 800) { nsev = nsev + 1; }
            }
            di = di + 1;
        }
        let nmild:i32 = nd - nsev;
        let best_s:i64 = 1000 - pen - 100 * (nmild as i64) - 250 * (nsev as i64);
        // sense evidence: parsed and traced, zero scoring weight.
        // Investigated 2026-09-24 on 14 dev fixtures x 2 representations:
        // shapetrans degenerate on UI screenshots (a: TRIANGLE, b: CIRCLE);
        // colordisc strings identical for good and bad pages; the >=3
        // majority bonus never fired. Non-discriminative: weight 0.
        if(best_s < 0) { best_s = 0; }
        if(best_s > 1000) { best_s = 1000; }
        let verdict:[]u8 = "BAD";
        if(best_s >= 600) { verdict = "GOOD"; }
        let conf:i64 = iabs(best_s - 600) * 1000 / 400;
        if(conf > 1000) { conf = 1000; }
        pos = ob_kv(ob, pos, "mechanism", "aesthetic-judge-v2");
        if(ev[6] == 1) {
            pos = ob_kv(ob, pos, "representation", "b");
        }
        if(ev[6] == 0) {
            pos = ob_kv(ob, pos, "representation", "a");
        }
        pos = ob_kv(ob, pos, "judgment", verdict);
        pos = ob_kint(ob, pos, "score", best_s);
        pos = ob_kint(ob, pos, "confidence", conf);
        let nm:[]u8 = names[best_r * 32 .. best_r * 32 + 32];
        pos = ob_kv(ob, pos, "best_ref", nm[0..zlen(nm)]);
        if(nd == 0) {
            pos = ob_kv(ob, pos, "defects", "none");
        }
        if(nd > 0) {
            pos = ob_kv(ob, pos, "defects", dlist[0..dl]);
        }
        pos = ob_kint(ob, pos, "n_defects", nd as i64);
        di = 0;
        while(di < 8) {
            let sv2:i64 = defect_sev(di, devs);
            let kn:[]u8 = nio_alloc(64);
            let kp:i32 = 0;
            kp = ob_add(kn, kp, "defect_sev_");
            kp = ob_add(kn, kp, defect_name(di));
            pos = ob_kint(ob, pos, kn[0..kp], sv2);
            nio_free(kn);
            di = di + 1;
        }
        pos = ob_kint(ob, pos, "m_bg_lum", t_get64(m, 0 * 8));
        pos = ob_kint(ob, pos, "m_ink_lum", t_get64(m, 1 * 8));
        pos = ob_kint(ob, pos, "m_contrast", t_get64(m, 2 * 8));
        pos = ob_kint(ob, pos, "m_ink_total", t_get64(m, 3 * 8));
        pos = ob_kint(ob, pos, "m_bands", t_get64(m, 4 * 8));
        pos = ob_kint(ob, pos, "m_gap_cv", t_get64(m, 5 * 8));
        pos = ob_kint(ob, pos, "m_margin_ink", t_get64(m, 6 * 8));
        pos = ob_kint(ob, pos, "m_guides", t_get64(m, 7 * 8));
        pos = ob_kint(ob, pos, "m_align_conc", t_get64(m, 8 * 8));
        pos = ob_kint(ob, pos, "m_type_modes", t_get64(m, 9 * 8));
        pos = ob_kint(ob, pos, "m_hues", t_get64(m, 10 * 8));
        pos = ob_kint(ob, pos, "m_hero_ratio", t_get64(m, 11 * 8));
        pos = ob_kint(ob, pos, "m_rows", t_get64(m, 12 * 8));
        pos = ob_kint(ob, pos, "m_satcov", t_get64(m, 13 * 8));
        pos = ob_kint(ob, pos, "m_body_contrast", t_get64(m, 14 * 8));
        pos = ob_kint(ob, pos, "m_align_k", t_get64(m, 15 * 8));
        pos = ob_kint(ob, pos, "m_margin_share", t_get64(m, 16 * 8));
        let sdb:[]u8 = "DIFFERENT";
        if(ev[best_r] == 1) { sdb = "SAME"; }
        pos = ob_kv(ob, pos, "sense_colordisc_best", sdb);
        let stv:[]u8 = "OTHER";
        if(ev[5] == 1) { stv = "SQUARE"; }
        if(ev[5] == 2) { stv = "CIRCLE"; }
        if(ev[5] == 3) { stv = "TRIANGLE"; }
        pos = ob_kv(ob, pos, "sense_shapetrans", stv);
        pos = ob_kint(ob, pos, "sense_weight", 0);
        pos = ob_kint(ob, pos, "ops", t_get64(op, 0));
        _zag_print(ob[0..pos]);
        return;
    }
    pos = ob_kv(ob, pos, "error", "unknown_mode");
    _zag_print(ob[0..pos]);
    return;
}

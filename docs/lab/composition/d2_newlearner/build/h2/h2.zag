// h2.zag — H2 taught-physics world model + 64-tick lookahead planner.
// Chat protocol: `<binary> chat`; one banner line; one "A ..." reply per input.
// Pure Zag, zero RNG, deterministic given state.
@import("model.zag")
// ---------------- card ----------------
// card arena: 0 s0|1 s1|2 s2|3 ep|4 start|5 window_len|6..9 crystals|10 preward(-1 none)
fn card_new()[]u8 {
  let c:[]u8=z_alloc(12*8);
  p_put(c,10,-1);
  return c;
}
// parse one CARD line into card. Returns 1 if it was a CARD line.
fn card_parse_line(line:[]u8,c:[]u8)i32 {
  if(s_starts(line,"CARD scenario ")==0){return 0;}
  let at:i32=s_find(line," episode ");
  if(at>=0){p_put(c,3,s_parse_int_at(line,at+9));}
  return 1;
}
fn card_parse_start(line:[]u8,c:[]u8)i32 {
  if(s_starts(line,"CARD start cell ")==0){return 0;}
  p_put(c,4,s_parse_int_at(line,16));
  return 1;
}
fn card_parse_storms(line:[]u8,c:[]u8)i32 {
  if(s_starts(line,"CARD storms at ")==0){return 0;}
  let at:i32=15;let s:i32=0;
  while(s<3){
    p_put(c,s,s_parse_int_at(line,at));
    while(at<line.len && line[at]!=44){at=at+1;}
    at=at+1;s=s+1;
  }
  let pa:i32=s_find(line,"(");
  if(pa>=0){p_put(c,5,s_parse_int_at(line,pa+1));}
  return 1;
}
fn card_parse_crystals(line:[]u8,c:[]u8)i32 {
  if(s_starts(line,"CARD crystals at ")==0){return 0;}
  let at:i32=17;let s:i32=0;
  while(s<4){
    p_put(c,6+s,s_parse_int_at(line,at));
    while(at<line.len && line[at]!=44 && line[at]!=32 && line[at]!=59){at=at+1;}
    if(at<line.len && line[at]==44){at=at+1;}
    else {break;}
    s=s+1;
  }
  let pw:i32=s_find(line,"already placed at cell ");
  if(pw>=0){p_put(c,10,s_parse_int_at(line,pw+22));}
  return 1;
}
// ---------------- planner ----------------
// passable: inside [0,bound], not a void cell
fn passable(cell:i64,bound:i64,va:i64)i64 {
  if(cell<0 || cell>bound){return 0;}
  if(va>=0 && (cell==va || cell==va+1)){return 0;}
  return 1;
}
// BFS shortest-path first step from `from` to `to`. Returns 0 LEFT, 1 RIGHT, 6 WAIT.
// Deterministic: neighbors explored LEFT then RIGHT; ties -> lowest index path.
fn bfs_step(from:i64,to:i64,bound:i64,va:i64)i64 {
  if(from==to){return 6;}
  if(passable(to,bound,va)==0){return 6;}
  let dist:[]u8=z_alloc(24*8);
  let prev:[]u8=z_alloc(24*8);
  let i:i32=0;
  while(i<24){p_put(dist,i,-1);p_put(prev,i,-1);i=i+1;}
  p_put(dist,from as i32,0);
  let q:[]u8=z_alloc(24*8);
  let qh:i32=0;let qt:i32=0;
  p_put(q,0,from);qt=1;
  while(qh<qt){
    let cur:i64=p_get(q,qh);qh=qh+1;
    if(cur==to){break;}
    let nb:i64=cur-1;
    if(passable(nb,bound,va)==1 && p_get(dist,nb as i32)<0){
      p_put(dist,nb as i32,p_get(dist,cur as i32)+1);
      p_put(prev,nb as i32,cur);
      p_put(q,qt,nb);qt=qt+1;
    }
    nb=cur+1;
    if(passable(nb,bound,va)==1 && p_get(dist,nb as i32)<0){
      p_put(dist,nb as i32,p_get(dist,cur as i32)+1);
      p_put(prev,nb as i32,cur);
      p_put(q,qt,nb);qt=qt+1;
    }
  }
  let dd:i64=p_get(dist,to as i32);
  z_free(q);
  if(dd<0){z_free(dist);z_free(prev);return 6;}
  let cur2:i64=to;
  while(p_get(prev,cur2 as i32)!=from){cur2=p_get(prev,cur2 as i32);}
  z_free(dist);z_free(prev);
  if(cur2<from){return 0;}
  return 1;
}
// BFS distance from->to, or -1 if unreachable
fn bfs_dist(from:i64,to:i64,bound:i64,va:i64)i64 {
  if(from==to){return 0;}
  if(passable(to,bound,va)==0){return -1;}
  let dist:[]u8=z_alloc(24*8);
  let i:i32=0;
  while(i<24){p_put(dist,i,-1);i=i+1;}
  p_put(dist,from as i32,0);
  let q:[]u8=z_alloc(24*8);
  let qh:i32=0;let qt:i32=0;
  p_put(q,0,from);qt=1;
  while(qh<qt){
    let cur:i64=p_get(q,qh);qh=qh+1;
    if(cur==to){break;}
    let nb:i64=cur-1;
    if(passable(nb,bound,va)==1 && p_get(dist,nb as i32)<0){
      p_put(dist,nb as i32,p_get(dist,cur as i32)+1);
      p_put(q,qt,nb);qt=qt+1;
    }
    nb=cur+1;
    if(passable(nb,bound,va)==1 && p_get(dist,nb as i32)<0){
      p_put(dist,nb as i32,p_get(dist,cur as i32)+1);
      p_put(q,qt,nb);qt=qt+1;
    }
  }
  let dd:i64=p_get(dist,to as i32);
  z_free(dist);z_free(q);
  return dd;
}
// nearest active mote cell within bound, or -1
fn nearest_mote(w:[]u8,bound:i64)i64 {
  let pos:i64=p_get(w,1);
  let best:i64=-1;let bd:i64=1000000;let k:i32=0;
  while(k<8){
    if(p_get(w,39+k)==0){
      let mp:i64=p_get(w,23+k);
      if(mp<=bound){
        let d:i64=mp-pos;if(d<0){d=0-d;}
        if(d<bd){bd=d;best=mp;}
      }
    }
    k=k+1;
  }
  return best;
}
// nearest untaken crystal cell within bound, or -1
fn nearest_crystal(w:[]u8,bound:i64)i64 {
  let pos:i64=p_get(w,1);
  let best:i64=-1;let bd:i64=1000000;let k:i32=0;
  while(k<4){
    if(p_get(w,19+k)==0){
      let cc:i64=p_get(w,15+k);
      if(cc<=bound){
        let d:i64=cc-pos;if(d<0){d=0-d;}
        if(d<bd){bd=d;best=cc;}
      }
    }
    k=k+1;
  }
  return best;
}
// ward cell (placed type 3/6), or -1
fn ward_cell(w:[]u8)i64 {
  let nc:i64=p_get(w,59);let k:i32=0;
  while((k as i64)<nc){
    let typ:i64=p_get(w,60+k*2);
    if(typ==3 || typ==6){return p_get(w,60+k*2+1);}
    k=k+1;
  }
  return -1;
}
fn ward_placed(w:[]u8)i64 {
  if(ward_cell(w)>=0){return 1;}
  return 0;
}
// ticks until next storm start (>=0), or -1 if none within episode
fn storm_in_ticks(w:[]u8)i64 {
  let t:i64=p_get(w,0);
  let s0:i64=p_get(w,8);let s1:i64=p_get(w,9);let s2:i64=p_get(w,10);
  let best:i64=-1;
  if(s0>t && (best<0 || s0-t<best)){best=s0-t;}
  if(s1>t && (best<0 || s1-t<best)){best=s1-t;}
  if(s2>t && (best<0 || s2-t<best)){best=s2-t;}
  return best;
}
fn storm_starts_within(w:[]u8,h:i64)i64 {
  let si:i64=storm_in_ticks(w);
  if(si>=0 && si<=h){return 1;}
  return 0;
}
fn crystals_in_inv(w:[]u8)i64 {
  let c:i64=0;let s:i32=0;
  while(s<4){if(p_get(w,55+s)==0){c=c+1;}s=s+1;}
  return c;
}
// ---------------- base policy (rollout continuation) ----------------
// All take (w, ph, e) where e = estimator (for bound/va).
fn forage_step(w:[]u8,ph:[]u8,e:[]u8)i64 {
  let pos:i64=p_get(w,1);
  let bound:i64=est_bound(e);
  let va:i64=p_get(e,24);
  if(m_mote_at(w,pos)>=0){return 2;}
  let t:i64=nearest_mote(w,bound);
  if(t<0){return 6;}
  return bfs_step(pos,t,bound,va);
}
fn build_step(w:[]u8,ph:[]u8,e:[]u8)i64 {
  let pos:i64=p_get(w,1);
  let bound:i64=est_bound(e);
  let va:i64=p_get(e,24);
  let invcap:i64=p_get(ph,9);
  if(m_has_item(w,3)==1){
    let dc:i64=p_get(w,12);
    if(pos==dc){return 4;}
    return bfs_step(pos,dc,bound,va);
  }
  if(crystals_in_inv(w)>=2){return 5;}
  if(m_crystal_at(w,pos)>=0 && m_inv_count(w)<invcap){return 3;}
  let t:i64=nearest_crystal(w,bound);
  if(t<0){return forage_step(w,ph,e);}
  return bfs_step(pos,t,bound,va);
}
fn flee_step(w:[]u8,ph:[]u8,e:[]u8)i64 {
  let pos:i64=p_get(w,1);
  let bound:i64=est_bound(e);
  let va:i64=p_get(e,24);
  let zlo:i64=p_get(ph,5);let zhi:i64=p_get(ph,6);
  let tl:i64=zlo-1;let tr:i64=zhi+1;
  let dl:i64=1000000;let dr:i64=1000000;
  if(tl>=0){dl=bfs_dist(pos,tl,bound,va);}
  if(tr<=bound){dr=bfs_dist(pos,tr,bound,va);}
  if(dl<0 && dr<0){return 6;}
  if(dl>=0 && (dr<0 || dl<=dr)){return bfs_step(pos,tl,bound,va);}
  return bfs_step(pos,tr,bound,va);
}
fn base_policy(w:[]u8,ph:[]u8,e:[]u8)i64 {
  let t:i64=p_get(w,0);
  let pos:i64=p_get(w,1);
  if(m_storm_active(w,t)==1){
    if(m_sheltered(w)==1){return 6;}
    if(m_in_zone(w,ph,pos)==1){
      let wc:i64=ward_cell(w);
      if(wc>=0){
        let bound:i64=est_bound(e);let va:i64=p_get(e,24);
        return bfs_step(pos,wc,bound,va);
      }
      return flee_step(w,ph,e);
    }
    return forage_step(w,ph,e);
  }
  if(ward_placed(w)==0 && storm_starts_within(w,64)==1){
    return build_step(w,ph,e);
  }
  if(ward_placed(w)==1 && m_sheltered(w)==0){
    let si:i64=storm_in_ticks(w);
    let wc2:i64=ward_cell(w);
    if(si>=0 && wc2>=0){
      let bound:i64=est_bound(e);let va:i64=p_get(e,24);
      let d:i64=bfs_dist(pos,wc2,bound,va);
      if(d>=0 && si<=d+6){return bfs_step(pos,wc2,bound,va);}
    }
  }
  return forage_step(w,ph,e);
}
// ---------------- outer candidate generator (prereg fixed order) ----------------
fn cand_action(w:[]u8,ph:[]u8,e:[]u8,c:i32)i64 {
  let pos:i64=p_get(w,1);
  let bound:i64=est_bound(e);
  let va:i64=p_get(e,24);
  let invcap:i64=p_get(ph,9);
  if(c==0){
    let t:i64=nearest_mote(w,bound);
    if(t<0){return 6;}
    return bfs_step(pos,t,bound,va);
  }
  if(c==1){
    let t:i64=nearest_crystal(w,bound);
    if(t<0){return 6;}
    return bfs_step(pos,t,bound,va);
  }
  if(c==2){
    let wc:i64=ward_cell(w);
    if(wc<0){return 6;}
    return bfs_step(pos,wc,bound,va);
  }
  if(c==3){
    if(m_mote_at(w,pos)>=0){return 2;}
    return 6;
  }
  if(c==4){
    if(m_crystal_at(w,pos)>=0 && m_inv_count(w)<invcap){return 3;}
    return 6;
  }
  if(c==5){
    if(crystals_in_inv(w)>=2){return 5;}
    return 6;
  }
  if(c==6){
    if(m_has_item(w,3)==1){return 4;}
    return 6;
  }
  return 6;
}
// 64-tick lookahead: for each candidate, rollout with base-policy continuation.
// Score = (alive ? final_E : -100000). Ties -> lowest candidate index.
fn plan_tick(w:[]u8,ph:[]u8,e:[]u8,roll:[]u8)i64 {
  let best_a:i64=6;let best_alive:i64=0;let best_e:i64=-1000000000;
  let first:i32=1;
  let c:i32=0;
  while(c<8){
    let a:i64=cand_action(w,ph,e,c);
    model_copy(roll,w);
    model_step(roll,ph,a);
    let alive:i64=1;
    if(p_get(roll,4)==0){alive=0;}
    let k:i32=1;
    while(k<64 && alive==1){
      let ba:i64=base_policy(roll,ph,e);
      model_step(roll,ph,ba);
      if(p_get(roll,4)==0){alive=0;}
      k=k+1;
    }
    let se:i64=p_get(roll,2);
    if(first==1){
      best_a=a;best_alive=alive;best_e=se;first=0;
    }
    else {
      let better:i32=0;
      if(alive==1 && best_alive==0){better=1;}
      else if(alive==best_alive && alive==1 && se>best_e){better=1;}
      if(better==1){best_a=a;best_alive=alive;best_e=se;}
    }
    c=c+1;
  }
  return best_a;
}
// ---------------- card-stage strategic planner (P1) ----------------
// Derives the skill-class sequence from card facts only (no OBS yet).
// Writes e.g. "1,2,3,1" into out; returns length.
fn strat_plan(c:[]u8,out:[]u8)i32 {
  let s0:i64=p_get(c,0);let s1:i64=p_get(c,1);let s2:i64=p_get(c,2);
  let ep:i64=p_get(c,3);let start:i64=p_get(c,4);let wl:i64=p_get(c,5);
  let preward:i64=p_get(c,10);
  let ws:[]u8=z_alloc(3*8);
  let nw:i32=0;
  if(s0<ep){p_put(ws,nw,s0);nw=nw+1;}
  if(s1<ep){p_put(ws,nw,s1);nw=nw+1;}
  if(s2<ep){p_put(ws,nw,s2);nw=nw+1;}
  let n:i32=0;
  if(nw==0){
    out[0]=49;
    z_free(ws);
    return 1;
  }
  if(preward<0){
    let b1:i64=-1;let bd1:i64=1000000;let b2:i64=-1;let bd2:i64=1000000;
    let ci:i32=0;
    while(ci<4){
      let cc:i64=p_get(c,6+ci);
      let dd:i64=cc-start;if(dd<0){dd=0-dd;}
      if(dd<bd1){b2=b1;bd2=bd1;b1=cc;bd1=dd;}
      else if(dd<bd2){b2=cc;bd2=dd;}
      ci=ci+1;
    }
    let gap:i64=b2-b1;if(gap<0){gap=0-gap;}
    let ret:i64=b2-start;if(ret<0){ret=0-ret;}
    let build_lead:i64=bd1+1+gap+1+1+ret+1;
    if(nw>0){
      let w0:i64=p_get(ws,0);
      if(w0-build_lead-6>=20){
        out[n]=49;n=n+1;
      }
    }
    out[n]=50;n=n+1;
  }
  else {
    out[n]=49;n=n+1;
  }
  let wi:i32=0;
  while(wi<nw){
    if(n>0){out[n]=44;n=n+1;}
    out[n]=51;n=n+1;
    let we:i64=p_get(ws,wi)+wl;
    let nx:i64=ep;
    if(wi+1<nw){nx=p_get(ws,wi+1);}
    if(nx-we>=20){
      out[n]=44;n=n+1;out[n]=49;n=n+1;
    }
    wi=wi+1;
  }
  z_free(ws);
  return n;
}
// ---------------- main chat loop ----------------
fn main()void {
  let a1:[]u8=_zag_arg(1);
  if(_zag_strcmp(a1,"chat")!=1){
    _zag_print("usage: h2 chat\n");
    return;
  }
  _zag_print("H2 taught-physics planner ready\n");
  let ph:[]u8=phys_new();
  let phys_ok:i32=0;
  let card:[]u8=card_new();
  let have_card:i32=0;
  let w:[]u8=model_new();
  let e:[]u8=est_new();
  let roll:[]u8=model_new();
  let o:[]u8=obs_new();
  let obs_m:[]u8=z_alloc(16*8);
  let in_episode:i32=0;
  while(1==1){
    let line:[]u8=read_line();
    if(line.len==0){z_free(line);break;}
    let handled:i32=0;
    if(s_find(line,"Here is the physics.")>=0){
      let rc:i32=parse_physics(line,ph);
      if(rc==0){phys_ok=1;_zag_print("A physics ingested\n");}
      else {
        _zag_print("A PHYSICS_ERROR slot=");
        _zag_print(i64s(rc as i64));
        _zag_print("\n");
      }
      handled=1;
    }
    if(handled==0 && s_starts(line,"CARD scenario ")==1){
      card_parse_line(line,card);
      have_card=1;in_episode=0;
      _zag_print("A card noted\n");
      handled=1;
    }
    if(handled==0 && s_starts(line,"CARD start cell ")==1){
      card_parse_start(line,card);
      _zag_print("A card noted\n");
      handled=1;
    }
    if(handled==0 && s_starts(line,"CARD storms at ")==1){
      card_parse_storms(line,card);
      _zag_print("A card noted\n");
      handled=1;
    }
    if(handled==0 && s_starts(line,"CARD crystals at ")==1){
      card_parse_crystals(line,card);
      _zag_print("A card noted\n");
      handled=1;
    }
    if(handled==0 && s_starts(line,"CARD ")==1){
      _zag_print("A card noted\n");
      handled=1;
    }
    if(handled==0 && s_starts(line,"Which sub-skills")==1){
      let buf:[]u8=z_alloc(32);
      let nl:i32=strat_plan(card,buf);
      _zag_print("A ");
      _zag_print(buf[0..nl]);
      _zag_print("\n");
      z_free(buf);
      handled=1;
    }
    if(handled==0 && s_starts(line,"OBS ")==1){
      if(phys_ok==0){
        _zag_print("A PHYSICS_ERROR no-physics\n");
      }
      else {
        parse_obs(line,o);
        if(in_episode==0){
          est_reset(e);
          in_episode=1;
        }
        obs_resync(w,card,o);
        let mi:i32=0;
        while(mi<8){p_put(obs_m,mi,p_get(o,10+mi));p_put(obs_m,8+mi,p_get(o,18+mi));mi=mi+1;}
        est_update(e,w,obs_m);
        let a:i64=plan_tick(w,ph,e,roll);
        let dch:[]u8="0123456";
        _zag_print("A ");
        _zag_print(dch[(a as i32)..(a as i32)+1]);
        _zag_print("\n");
      }
      handled=1;
    }
    if(handled==0){
      _zag_print("A noted\n");
      handled=1;
    }
    z_free(line);
  }
  return;
}

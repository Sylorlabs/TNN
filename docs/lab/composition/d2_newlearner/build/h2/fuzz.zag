// fuzz.zag — differential model-vs-sim validator.
// Usage: fuzz <scenario.txt> <session1.txt>  (actions on stdin, one digit per line)
// Prints OBS lines from the H2 model. Diff against d2bin tui OBS lines.
// Session 1 text is READ FROM A FILE so the real parser is exercised.
@import("model.zag")
fn main()void {
  let scn_path:[]u8=_zag_arg(1);
  let s1_path:[]u8=_zag_arg(2);
  if(scn_path.len==0 || s1_path.len==0){
    _zag_print("usage: fuzz <scenario.txt> <session1.txt>\n");
    return;
  }
  let data:[]u8=read_file(scn_path);
  if(data.len==0){_zag_print("ERR no scenario\n");return;}
  let s1:[]u8=read_file(s1_path);
  if(s1.len==0){_zag_print("ERR no session1\n");return;}
  let ph:[]u8=phys_new();
  let rc:i32=parse_physics(s1,ph);
  if(rc!=0){
    _zag_print("ERR physics parse rc=");
    _zag_print(i64s(rc as i64));
    _zag_print("\n");
    return;
  }
  let ints:[]u8=z_alloc(64*8);
  let cnt:i32=parse_ints(data,ints);
  if(cnt<33){_zag_print("ERR ints\n");return;}
  let ep:i64=0;
  let epa:i32=find_line_prefix(data,"# EPISODE ");
  if(epa>=0){ep=s_parse_int_at(data,epa);}
  if(ep<=0){_zag_print("ERR ep\n");return;}
  let w:[]u8=model_new();
  p_put(w,0,0);
  p_put(w,1,p_get(ints,1));
  p_put(w,2,100);
  p_put(w,3,0);p_put(w,4,1);p_put(w,5,0);
  p_put(w,6,p_get(ints,0));p_put(w,7,p_get(ints,0)+1);
  p_put(w,8,p_get(ints,2));p_put(w,9,p_get(ints,3));p_put(w,10,p_get(ints,4));
  p_put(w,11,ep);p_put(w,12,p_get(ints,1));p_put(w,13,30);
  let k:i32=0;
  while(k<4){
    p_put(w,15+k,p_get(ints,5+k));p_put(w,19+k,0);
    p_put(w,55+k,-1);
    k=k+1;
  }
  let m:i32=0;
  while(m<8){
    p_put(w,23+m,p_get(ints,9+m*3));
    p_put(w,31+m,p_get(ints,10+m*3));
    p_put(w,39+m,0);
    p_put(w,47+m,p_get(ints,11+m*3));
    m=m+1;
  }
  p_put(w,59,0);
  let pra:i32=find_line_prefix(data,"# PREWARD ");
  if(pra>=0){
    let pv:i64=-2;
    if(data[pra]==110 || data[pra]==78){pv=-2;}
    else {pv=s_parse_int_at(data,pra);}
    if(pv>=0){m_placed_add(w,3,pv);}
  }
  let lc:i32=0;
  while(lc<96){p_put(w,84+lc,-1);lc=lc+1;}
  p_put(w,180,0);p_put(w,181,0);
  emit_obs(w);
  let epf:i64=p_get(w,11);
  while(p_get(w,0)<epf){
    if(p_get(w,4)==0){break;}
    let line:[]u8=read_line();
    let a:i64=6;
    if(line.len>0){
      if(line[0]>=48 && line[0]<=54){a=(line[0] as i64)-48;}
    }
    z_free(line);
    let died:i32=model_step(w,ph,a);
    if(died==1){break;}
    if(p_get(w,0)<epf){emit_obs(w);}
  }
  return;
}

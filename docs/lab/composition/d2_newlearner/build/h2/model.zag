// model.zag — H2 taught-physics world model (shared by h2.zag learner + fuzz.zag).
// Implements M1-M15 exactly (mirrors d2.zag step()), parameterized by the
// physics table compiled from Session 1. Pure Zag, zero RNG, deterministic.
// State = []u8 arena of i64 slots (little-endian, p_put/p_get). No structs.

// ---------------- prelude (proven pattern from d2.zag) ----------------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn p_put(w:[]u8,idx:i32,v:i64)void {
  let o:i32=idx*8;let i:i32=0;
  while(i<8){w[o+i]=(v & 255) as u8;v=v>>8;i=i+1;}
  return;
}
fn p_get(w:[]u8,idx:i32)i64 {
  let o:i32=idx*8;let v:i64=0;let i:i32=7;
  while(i>=0){v=v*256+(w[o+i] as i64);i=i-1;}
  return v;
}
// ---------------- string helpers ----------------
fn s_len(s:[]u8)i32 { return s.len; }
fn s_starts(h:[]u8,pre:[]u8)i32 {
  if(h.len<pre.len){return 0;}
  let i:i32=0;
  while(i<pre.len){ if(h[i]!=pre[i]){return 0;} i=i+1; }
  return 1;
}
// index of needle in haystack, or -1
fn s_find(h:[]u8,n:[]u8)i32 {
  if(n.len==0 || h.len<n.len){return -1;}
  let i:i32=0;
  while(i<=h.len-n.len){
    let j:i32=0;
    while(j<n.len && h[i+j]==n[j]){j=j+1;}
    if(j==n.len){return i;}
    i=i+1;
  }
  return -1;
}
// parse optional '-' then digits starting at `at`; stops at first non-digit.
// returns value; (no error signalling — caller checks anchor presence first)
fn s_parse_int_at(h:[]u8,at:i32)i64 {
  let neg:i64=0;let i:i32=at;let v:i64=0;let nd:i32=0;
  if(i<h.len && h[i]==45){neg=1;i=i+1;}
  while(i<h.len && h[i]>=48 && h[i]<=57){v=v*10+((h[i] as i64)-48);i=i+1;nd=nd+1;}
  if(nd==0){return 0;}
  if(neg==1){return 0-v;}
  return v;
}
// find anchor, then parse int right after it; returns 1 ok / 0 anchor missing
fn slot_after(h:[]u8,anchor:[]u8,out:[]u8,slot:i32)i32 {
  let at:i32=s_find(h,anchor);
  if(at<0){return 0;}
  p_put(out,slot,s_parse_int_at(h,at+anchor.len));
  return 1;
}
// ---------------- physics table ----------------
// ph slots: 0 basal 1 eat_gain 2 maxE 3 dormancy 4 storm_dmg 5 zlo 6 zhi
//           7 void_kills 8 ward_basal 9 inv_cap 10 start_E 11 n_cells 12 recipe_ok
fn phys_new()[]u8 { return z_alloc(16*8); }
// Parse Session 1 into ph. Returns 0 ok, else 100+slotid of first missing slot.
// Keys on ANCHOR SUBSTRINGS (never on the numeric values) so a taught-wrong
// number (e.g. EAT=+10) is picked up, not missed.
fn parse_physics(line:[]u8,ph:[]u8)i32 {
  if(slot_after(line,"THE WORLD: ",ph,11)==0){return 111;}
  if(slot_after(line,"You start with ",ph,10)==0){return 110;}
  if(slot_after(line,"Every tick costs ",ph,0)==0){return 100;}
  if(slot_after(line,"Standing on a WARD cell costs ",ph,8)==0){return 108;}
  if(slot_after(line,"gain +",ph,1)==0){return 101;}
  if(slot_after(line,"(max ",ph,2)==0){return 102;}
  if(slot_after(line,"sleeps for ",ph,3)==0){return 103;}
  if(slot_after(line,"without shelter costs ",ph,4)==0){return 104;}
  let za:i32=s_find(line,"storm hits cells ");
  if(za<0){return 105;}
  p_put(ph,5,s_parse_int_at(line,za+17));
  let zt:i32=s_find(line," through ");
  if(zt<0 || zt<za){return 106;}
  p_put(ph,6,s_parse_int_at(line,zt+9));
  if(slot_after(line,"hold up to ",ph,9)==0){return 109;}
  if(s_find(line,"void cell kills")<0){return 107;}
  p_put(ph,7,1);
  if(s_find(line,"Two CRYSTALS")<0){return 112;}
  if(s_find(line,"combine into a WARD")<0){return 112;}
  p_put(ph,12,1);
  return 0;
}
// ---------------- model state ----------------
// slots documented at top of file (see BUILD.md for layout).
fn model_new()[]u8 { return z_alloc(256*8); }
fn model_copy(dst:[]u8,src:[]u8)void {
  let i:i32=0;
  while(i<256*8){dst[i]=src[i];i=i+1;}
  return;
}
// ---- model helpers (m_ prefix) ----
fn m_inv_count(w:[]u8)i64 {
  let c:i64=0;let s:i32=0;
  while(s<4){if(p_get(w,55+s)!=-1){c=c+1;}s=s+1;}
  return c;
}
fn m_has_item(w:[]u8,code:i64)i64 {
  let s:i32=0;
  while(s<4){if(p_get(w,55+s)==code){return 1;}s=s+1;}
  return 0;
}
fn m_item_slot(w:[]u8,code:i64)i64 {
  let s:i32=0;
  while(s<4){if(p_get(w,55+s)==code){return s as i64;}s=s+1;}
  return -1;
}
fn m_consume(w:[]u8,code:i64)i64 {
  let s:i64=m_item_slot(w,code);
  if(s<0){return 0;}
  p_put(w,55+(s as i32),-1);
  return 1;
}
fn m_add_item(w:[]u8,code:i64)i64 {
  let s:i32=0;
  while(s<4){
    if(p_get(w,55+s)==-1){p_put(w,55+s,code);return 1;}
    s=s+1;
  }
  return 0;
}
fn m_lowest_two(w:[]u8)i64 {
  let s1:i64=-1;let s2:i64=-1;let s:i32=0;
  while(s<4){
    if(p_get(w,55+s)!=-1){
      if(s1<0){s1=s as i64;}
      else if(s2<0){s2=s as i64;}
    }
    s=s+1;
  }
  if(s2<0){return -1;}
  return s1*4+s2;
}
// M9 recipe table (structural, from the instrument spec — not Session 1).
fn m_recipe(a:i64,b:i64)i64 {
  let x:i64=a;let y:i64=b;
  if(x>y){x=b;y=a;}
  if(x==0 && y==0){return 3;}
  if(x==0 && y==1){return 2;}
  if(x==0 && y==4){return 5;}
  if(x==0 && y==2){return 6;}
  if(x==1 && y==1){return 4;}
  return -1;
}
fn m_placed_add(w:[]u8,typ:i64,cell:i64)i64 {
  let c:i64=p_get(w,59);
  if(c>=12){return 0;}
  p_put(w,60+(c as i32)*2,typ);
  p_put(w,60+(c as i32)*2+1,cell);
  p_put(w,59,c+1);
  return 1;
}
fn m_loose_push(w:[]u8,cell:i64,code:i64)i64 {
  let k:i32=0;
  while(k<4){
    if(p_get(w,84+(cell as i32)*4+k)==-1){p_put(w,84+(cell as i32)*4+k,code);return 1;}
    k=k+1;
  }
  return 0;
}
fn m_loose_pop(w:[]u8,cell:i64)i64 {
  let k:i32=3;
  while(k>=0){
    let c:i64=p_get(w,84+(cell as i32)*4+k);
    if(c!=-1){p_put(w,84+(cell as i32)*4+k,-1);return c;}
    k=k-1;
  }
  return -1;
}
fn m_sheltered(w:[]u8)i64 {
  let pos:i64=p_get(w,1);let c:i64=p_get(w,59);let k:i32=0;
  while((k as i64)<c){
    let typ:i64=p_get(w,60+k*2);let cell:i64=p_get(w,60+k*2+1);
    if((typ==3 || typ==6) && cell==pos){return 1;}
    k=k+1;
  }
  return 0;
}
fn m_storm_active(w:[]u8,t:i64)i64 {
  let s0:i64=p_get(w,8);let s1:i64=p_get(w,9);let s2:i64=p_get(w,10);
  let wl:i64=p_get(w,13);
  if((t>=s0 && t<s0+wl) || (t>=s1 && t<s1+wl) || (t>=s2 && t<s2+wl)){return 1;}
  return 0;
}
fn m_in_zone(w:[]u8,ph:[]u8,pos:i64)i64 {
  let zlo:i64=p_get(ph,5);let zhi:i64=p_get(ph,6);
  if(pos>=zlo && pos<=zhi){return 1;}
  return 0;
}
fn m_mote_at(w:[]u8,pos:i64)i64 {
  let k:i32=0;
  while(k<8){
    if(p_get(w,23+k)==pos && p_get(w,39+k)==0){return k as i64;}
    k=k+1;
  }
  return -1;
}
fn m_crystal_at(w:[]u8,pos:i64)i64 {
  let k:i32=0;
  while(k<4){
    if(p_get(w,15+k)==pos && p_get(w,19+k)==0){return k as i64;}
    k=k+1;
  }
  return -1;
}
// single-mote drift step; returns packed (newpos*64 + (newvel+32)) — vel in [-32,32]
fn drift1(mp:i64,vv:i64,lo:i64,hi:i64)i64 {
  let p:i64=mp+vv;let v:i64=vv;
  if(p<lo){p=lo+(lo-p);v=0-v;}
  if(p>hi){p=hi-(p-hi);v=0-v;}
  return p*64+(v+32);
}
fn drift_pos(pk:i64)i64 { return pk/64; }
fn drift_vel(pk:i64)i64 { return (pk%64)-32; }
// ---- the executable model: exact replica of d2.zag step(), ----
// ---- physics numbers from ph (Session 1), structure from M1-M15. ----
// Returns 1 if the agent died this tick, else 0.
fn model_step(w:[]u8,ph:[]u8,a:i64)i32 {
  if(p_get(w,4)==0){return 1;}
  let t:i64=p_get(w,0);
  let pos:i64=p_get(w,1);
  let e:i64=p_get(w,2);
  let va:i64=p_get(w,6);let vb:i64=p_get(w,7);
  let basal_c:i64=p_get(ph,0);
  let eat_g:i64=p_get(ph,1);
  let max_e:i64=p_get(ph,2);
  let dorm:i64=p_get(ph,3);
  let storm_d:i64=p_get(ph,4);
  let ward_b:i64=p_get(ph,8);
  let invcap:i64=p_get(ph,9);
  let ncells:i64=p_get(ph,11);
  if(a==0 || a==1){
    let tgt:i64=pos;
    if(a==0){tgt=pos-1;if(tgt<0){tgt=0;}}
    else {tgt=pos+1;if(tgt>ncells-1){tgt=ncells-1;}}
    if(tgt!=pos){
      if(tgt==va || tgt==vb){
        let pk:i64=180;if(tgt==vb){pk=181;}
        if(p_get(w,pk as i32)==1){p_put(w,1,tgt);}
        else if(m_consume(w,5)==1){p_put(w,pk as i32,1);p_put(w,1,tgt);}
        else {p_put(w,4,0);p_put(w,5,2);}
      }
      else {p_put(w,1,tgt);}
    }
    pos=p_get(w,1);
  }
  else if(a==2){
    let ate:i64=0;let k:i32=0;
    while(k<8){
      if(p_get(w,23+k)==pos && p_get(w,39+k)==0){
        p_put(w,39+k,dorm);ate=ate+1;
      }
      k=k+1;
    }
    if(ate>0){
      e=e+eat_g*ate;if(e>max_e){e=max_e;}
      p_put(w,2,e);
    }
    else if(m_consume(w,4)==1){
      e=e+40;if(e>max_e){e=max_e;}
      p_put(w,2,e);p_put(w,3,10);
    }
  }
  else if(a==3){
    let ci:i64=m_crystal_at(w,pos);
    if(ci>=0 && m_inv_count(w)<invcap){
      p_put(w,19+(ci as i32),1);
      m_add_item(w,0);
    }
    else {
      let mi:i64=m_mote_at(w,pos);
      if(mi>=0 && m_inv_count(w)<invcap){
        p_put(w,39+(mi as i32),dorm);
        m_add_item(w,1);
      }
      else if(m_inv_count(w)<invcap){
        let lc:i64=m_loose_pop(w,pos);
        if(lc>=0){m_add_item(w,lc);}
      }
    }
  }
  else if(a==4){
    let s:i32=0;let done:i32=0;
    while(s<4 && done==0){
      let it:i64=p_get(w,55+s);
      if(it!=-1){
        p_put(w,55+s,-1);
        if(it==2 || it==3 || it==6){m_placed_add(w,it,pos);}
        else {m_loose_push(w,pos,it);}
        done=1;
      }
      s=s+1;
    }
  }
  else if(a==5){
    let pr:i64=m_lowest_two(w);
    if(pr>=0){
      let s1:i32=(pr/4) as i32;let s2:i32=(pr%4) as i32;
      let r:i64=m_recipe(p_get(w,55+s1),p_get(w,55+s2));
      if(r>=0){
        p_put(w,55+s1,r);p_put(w,55+s2,-1);
      }
    }
  }
  let nc:i64=p_get(w,59);let pi:i32=0;
  while((pi as i64)<nc){
    let typ:i64=p_get(w,60+pi*2);let cell:i64=p_get(w,60+pi*2+1);
    let rad:i64=0;let pull:i64=0;
    if(typ==2){rad=4;pull=1;}
    if(typ==6){rad=8;pull=2;}
    if(pull>0){
      let k:i32=0;
      while(k<8){
        if(p_get(w,39+k)==0){
          let mp:i64=p_get(w,23+k);
          let d:i64=mp-cell;if(d<0){d=0-d;}
          let sameside:i64=0;
          if(cell<va && mp<va){sameside=1;}
          if(cell>vb && mp>vb){sameside=1;}
          if(sameside==1 && d<=rad && d>0){
            if(mp<cell){mp=mp+pull;if(mp>cell){mp=cell;}}
            else {mp=mp-pull;if(mp<cell){mp=cell;}}
            if(cell<va){if(mp<0){mp=0;}if(mp>va-1){mp=va-1;}}
            else {if(mp<vb+1){mp=vb+1;}if(mp>ncells-1){mp=ncells-1;}}
            p_put(w,23+k,mp);
          }
        }
        k=k+1;
      }
    }
    pi=pi+1;
  }
  let k2:i32=0;
  while(k2<8){
    if(p_get(w,39+k2)==0){
      let mp2:i64=p_get(w,23+k2);let vv:i64=p_get(w,31+k2);
      let lo:i64=0;let hi:i64=ncells-1;
      if(va>=0){
        if(mp2<va){hi=va-1;}
        else if(mp2>vb){lo=vb+1;}
        else {
          if(mp2==va){mp2=va-1;vv=0-vv;}
          else {mp2=vb+1;vv=0-vv;}
          if(mp2<va){hi=va-1;}else{lo=vb+1;}
        }
      }
      let pk2:i64=drift1(mp2,vv,lo,hi);
      p_put(w,23+k2,drift_pos(pk2));p_put(w,31+k2,drift_vel(pk2));
    }
    else {
      let dd:i64=p_get(w,39+k2)-1;
      p_put(w,39+k2,dd);
      if(dd==0){p_put(w,23+k2,p_get(w,47+k2));}
    }
    k2=k2+1;
  }
  if(p_get(w,4)==1){
    let sh:i64=m_sheltered(w);
    let basal:i64=basal_c;
    if(sh==1){basal=ward_b;}
    else if(p_get(w,3)>0){basal=2;}
    e=p_get(w,2)-basal;
    if(m_storm_active(w,t)==1 && m_in_zone(w,ph,pos)==1 && sh==0){e=e-storm_d;}
    p_put(w,2,e);
    if(p_get(w,3)>0){p_put(w,3,p_get(w,3)-1);}
    if(e<=0){p_put(w,4,0);p_put(w,5,1);}
  }
  p_put(w,0,t+1);
  if(p_get(w,4)==0){return 1;}
  return 0;
}
// ---------------- estimator (hidden mote state tracking) ----------------
// est arena: 0..7 p_prev | 8..15 vel (999 unknown) | 16..23 home (-1 unknown)
//            24 va_solved (-1) | 25 stable_ticks | 26 va_locked | 27..34 vel_confirmed
fn est_new()[]u8 {
  let e:[]u8=z_alloc(40*8);
  let i:i32=0;
  while(i<8){p_put(e,i,-1);p_put(e,8+i,999);p_put(e,16+i,-1);p_put(e,27+i,0);i=i+1;}
  p_put(e,24,-1);p_put(e,25,0);p_put(e,26,0);
  return e;
}
fn est_reset(e:[]u8)void {
  let i:i32=0;
  while(i<8){p_put(e,i,-1);p_put(e,8+i,999);p_put(e,16+i,-1);p_put(e,27+i,0);i=i+1;}
  p_put(e,24,-1);p_put(e,25,0);p_put(e,26,0);
  return;
}
// region for mote drift in the model: [lo,hi] from solved va (or [0,23])
fn est_region(va:i64,mp:i64,lo_o:[]u8,hi_o:[]u8)void {
  let lo:i64=0;let hi:i64=23;
  if(va>=0){
    if(mp<va){hi=va-1;}
    else if(mp>va+1){lo=va+2;}
  }
  p_put(lo_o,0,lo);p_put(hi_o,0,hi);
  return;
}
// Update estimator from one OBS mote list, then write vel/home/va into the
// model state w. obs_m: arena with 8 slots: pos[i], 8 slots: dormant[i].
fn est_update(e:[]u8,w:[]u8,obs_m:[]u8)void {
  let va:i64=p_get(e,24);
  let tmp:[]u8=z_alloc(2*8);
  let i:i32=0;
  while(i<8){
    let p:i64=p_get(obs_m,i);let d:i64=p_get(obs_m,8+i);
    let pp:i64=p_get(e,i);let v:i64=p_get(e,8+i);
    if(d>0){
      p_put(e,i,p);
    }
    else {
      if(pp<0){
        p_put(e,8+i,999);p_put(e,27+i,0);
        p_put(e,16+i,p);
      }
      else {
        if(v==999){
          p_put(e,8+i,p-pp);p_put(e,27+i,0);
        }
        else {
          est_region(va,pp,tmp,tmp);
          let lo:i64=p_get(tmp,0);let hi2:i64=p_get(tmp,1);
          let pk:i64=drift1(pp,v,lo,hi2);
          if(drift_pos(pk)==p){
            p_put(e,8+i,drift_vel(pk));p_put(e,27+i,1);
          }
          else {
            let solved:i32=0;
            if(p_get(e,27+i)==1){
              if(v>0){
                let hs:i64=pp+p+v;
                if(hs%2==0){let h2:i64=hs/2;if(h2>=7 && h2<=14){va=h2+1;solved=1;}}
              }
              else if(v<0){
                let ls:i64=pp+p+v;
                if(ls%2==0){let l2:i64=ls/2;if(l2>=10 && l2<=17){va=l2-2;solved=1;}}
              }
              if(solved==1){
                p_put(e,24,va);p_put(e,25,0);
                p_put(e,8+i,0-v);p_put(e,27+i,1);
              }
            }
            if(solved==0){
              p_put(e,8+i,p-pp);p_put(e,27+i,0);
            }
          }
        }
      }
      p_put(e,i,p);
    }
    i=i+1;
  }
  z_free(tmp);
  let va2:i64=p_get(e,24);
  if(va2>=0){
    p_put(e,25,p_get(e,25)+1);
    if(p_get(e,25)>=8){p_put(e,26,1);}
    p_put(w,6,va2);p_put(w,7,va2+1);
  }
  let j:i32=0;
  while(j<8){
    let vv2:i64=p_get(e,8+j);
    if(vv2!=999){p_put(w,31+j,vv2);}
    let hh:i64=p_get(e,16+j);
    if(hh>=0){p_put(w,47+j,hh);}
    j=j+1;
  }
  return;
}
// movement safety bound for the planner: 7 until va is locked, else va-1
fn est_bound(e:[]u8)i64 {
  if(p_get(e,26)==1){return p_get(e,24)-1;}
  return 7;
}
// ---------------- OBS parsing ----------------
// obs arena: 0 t | 1 pos | 2 E | 3 storm_in (-2 ACTIVE,-1 none) | 4 zone | 5 shelter
//            6..9 inv | 10..17 mote pos | 18..25 mote dormant | 26..29 crystals (-1 none)
//            30 ward cell (-1 none) | 31 n_crystals
fn obs_new()[]u8 { return z_alloc(32*8); }
// split line on spaces into fields; parse "k=v". Returns 1 ok, 0 if not an OBS line.
fn parse_obs(line:[]u8,o:[]u8)i32 {
  if(s_starts(line,"OBS ")==0){return 0;}
  let i:i32=4;let n:i32=line.len;
  while(i<n){
    let j:i32=i;
    while(j<n && line[j]!=32){j=j+1;}
    let fl:i32=j-i;
    if(fl>2){
      let eq:i32=i;
      while(eq<j && line[eq]!=61){eq=eq+1;}
      if(eq<j){
        let v0:i32=eq+1;
        if(s_starts(line[i..eq],"t")==1){p_put(o,0,s_parse_int_at(line,v0));}
        else if(s_starts(line[i..eq],"pos")==1){p_put(o,1,s_parse_int_at(line,v0));}
        else if(s_starts(line[i..eq],"E")==1){p_put(o,2,s_parse_int_at(line,v0));}
        else if(s_starts(line[i..eq],"inv")==1){
          let s2:i32=0;let q:i32=v0;
          while(s2<4 && q<j){
            p_put(o,6+s2,s_parse_int_at(line,q));
            while(q<j && line[q]!=44){q=q+1;}
            q=q+1;s2=s2+1;
          }
        }
        else if(s_starts(line[i..eq],"storm_in")==1){
          if(s_starts(line[v0..j],"ACTIVE")==1){p_put(o,3,-2);}
          else if(s_starts(line[v0..j],"none")==1){p_put(o,3,-1);}
          else {p_put(o,3,s_parse_int_at(line,v0));}
        }
        else if(s_starts(line[i..eq],"zone")==1){p_put(o,4,s_parse_int_at(line,v0));}
        else if(s_starts(line[i..eq],"shelter")==1){p_put(o,5,s_parse_int_at(line,v0));}
        else if(s_starts(line[i..eq],"motes")==1){
          let s2:i32=0;let q:i32=v0;
          while(s2<8 && q<j){
            let c2:i32=q;
            while(c2<j && line[c2]!=58 && line[c2]!=44){c2=c2+1;}
            p_put(o,10+s2,s_parse_int_at(line,q));
            let dor:i64=0;
            if(c2<j && line[c2]==58){
              if(line[c2+1]==100){dor=s_parse_int_at(line,c2+2);}
            }
            p_put(o,18+s2,dor);
            while(q<j && line[q]!=44){q=q+1;}
            q=q+1;s2=s2+1;
          }
        }
        else if(s_starts(line[i..eq],"crystals")==1){
          let s2:i32=0;let q:i32=v0;
          if(s_starts(line[v0..j],"none")==1){p_put(o,31,0);}
          else {
            while(s2<4 && q<j){
              p_put(o,26+s2,s_parse_int_at(line,q));
              while(q<j && line[q]!=44){q=q+1;}
              q=q+1;s2=s2+1;
            }
            p_put(o,31,s2);
          }
        }
        else if(s_starts(line[i..eq],"ward")==1){
          if(s_starts(line[v0..j],"none")==1){p_put(o,30,-1);}
          else {p_put(o,30,s_parse_int_at(line,v0));}
        }
      }
    }
    i=j+1;
  }
  return 1;
}
// Re-sync model state from a parsed OBS (observable fields only).
// card: arena 0 s0|1 s1|2 s2|3 ep|4 start|5 window_len|6..9 crystals|10 preward
fn obs_resync(w:[]u8,card:[]u8,o:[]u8)void {
  p_put(w,0,p_get(o,0));p_put(w,1,p_get(o,1));p_put(w,2,p_get(o,2));
  p_put(w,3,0);p_put(w,4,1);
  p_put(w,6,-1);p_put(w,7,-1);
  p_put(w,8,p_get(card,0));p_put(w,9,p_get(card,1));p_put(w,10,p_get(card,2));
  p_put(w,11,p_get(card,3));p_put(w,12,p_get(card,4));p_put(w,13,p_get(card,5));
  let s:i32=0;
  while(s<4){p_put(w,55+s,p_get(o,6+s));s=s+1;}
  let k:i32=0;
  while(k<8){
    p_put(w,23+k,p_get(o,10+k));
    p_put(w,39+k,p_get(o,18+k));
    k=k+1;
  }
  let nc:i32=p_get(o,31) as i32;
  let c:i32=0;
  while(c<4){
    let cc:i64=p_get(card,6+c);
    let found:i32=0;let q:i32=0;
    while(q<nc){if(p_get(o,26+q)==cc){found=1;}q=q+1;}
    if(found==1){p_put(w,15+c,cc);p_put(w,19+c,0);}
    else {p_put(w,15+c,cc);p_put(w,19+c,1);}
    c=c+1;
  }
  p_put(w,59,0);
  let wc:i64=p_get(o,30);
  if(wc>=0){m_placed_add(w,3,wc);}
  return;
}
// ---------------- OBS emitter (for the fuzz differential) ----------------
fn emit_obs(w:[]u8)void {
  _zag_print("OBS t=");
  _zag_print(i64s(p_get(w,0)));
  _zag_print(" pos=");
  _zag_print(i64s(p_get(w,1)));
  _zag_print(" E=");
  _zag_print(i64s(p_get(w,2)));
  _zag_print(" inv=");
  let s:i32=0;
  while(s<4){
    if(s>0){_zag_print(",");}
    _zag_print(i64s(p_get(w,55+s)));
    s=s+1;
  }
  _zag_print(" storm_in=");
  let si:i64=-1;
  let ep2:i64=p_get(w,11);
  if(m_storm_active(w,p_get(w,0))==1){_zag_print("ACTIVE");}
  else {
    let s0:i64=p_get(w,8);let s1:i64=p_get(w,9);let s2:i64=p_get(w,10);
    let t:i64=p_get(w,0);
    if(s0>t){si=s0-t;}
    if(s1>t && (si<0 || s1-t<si)){si=s1-t;}
    if(s2>t && (si<0 || s2-t<si)){si=s2-t;}
    if(si<0){_zag_print("none");}
    else {
      let ns0:i64=si+t;
      if(ns0>=ep2){_zag_print("none");}
      else {_zag_print(i64s(si));}
    }
  }
  _zag_print(" zone=");
  let pos:i64=p_get(w,1);
  if(pos>=6 && pos<=17){_zag_print("1");}else{_zag_print("0");}
  _zag_print(" shelter=");
  _zag_print(i64s(m_sheltered(w)));
  _zag_print(" motes=");
  let k:i32=0;
  while(k<8){
    if(k>0){_zag_print(",");}
    _zag_print(i64s(p_get(w,23+k)));
    _zag_print(":");
    let dd:i64=p_get(w,39+k);
    if(dd>0){_zag_print("d");_zag_print(i64s(dd));}
    else {_zag_print("a");}
    k=k+1;
  }
  _zag_print(" crystals=");
  let nc:i32=0;let c:i32=0;
  while(c<4){
    if(p_get(w,19+c)==0){
      if(nc>0){_zag_print(",");}
      _zag_print(i64s(p_get(w,15+c)));
      nc=nc+1;
    }
    c=c+1;
  }
  if(nc==0){_zag_print("none");}
  _zag_print(" ward=");
  let nwc:i32=0;let pi:i32=0;let npc:i64=p_get(w,59);
  while((pi as i64)<npc){
    let typ:i64=p_get(w,60+pi*2);
    if(typ==3 || typ==6){
      if(nwc>0){_zag_print(",");}
      _zag_print(i64s(p_get(w,60+pi*2+1)));
      nwc=nwc+1;
    }
    pi=pi+1;
  }
  if(nwc==0){_zag_print("none");}
  _zag_print("\n");
  return;
}
// ---------------- file helpers (proven pattern from d2.zag) ----------------
// read a whole file (<=4096 bytes) via raw syscalls; "" on failure
fn read_file(path:[]u8)[]u8 {
  let n:i32=path.len;
  let c:[]u8=z_alloc(n+1);
  if(c.len==0){return "";}
  let i:i32=0;
  while(i<n){c[i]=path[i];i=i+1;}
  let fd:i64=_zag_raw_syscall(257,-100,_zag_slice_ptr(c) as i64,0,0,0,0);
  z_free(c);
  if(fd<0){return "";}
  let buf:[]u8=z_alloc(4096);
  if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
  let total:i32=0;let done:i32=0;
  while(done==0){
    let r:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(4096-total) as i64,0,0,0);
    if(r<=0){done=1;}
    else {
      total=total+(r as i32);
      if(total>=4096){done=1;}
    }
  }
  _zag_raw_syscall(3,fd,0,0,0,0,0);
  return buf[0..total];
}
// parse ints from text: skip '#' comments and blank lines. Returns count;
// values stored as i64 slots in out.
fn parse_ints(data:[]u8,out:[]u8)i32 {
  let cnt:i32=0;let i:i32=0;let n:i32=data.len;
  while(i<n){
    if(data[i]==35){while(i<n && data[i]!=10){i=i+1;}}
    else if((data[i]>=48 && data[i]<=57) || data[i]==45){
      let neg:i64=0;let v:i64=0;
      if(data[i]==45){neg=1;i=i+1;}
      while(i<n && data[i]>=48 && data[i]<=57){v=v*10+((data[i] as i64)-48);i=i+1;}
      if(neg==1){v=0-v;}
      p_put(out,cnt,v);cnt=cnt+1;
    }
    else {i=i+1;}
  }
  return cnt;
}
// read one line from stdin (fd 0); "" on EOF
fn read_line()[]u8 {
  let buf:[]u8=z_alloc(8192);
  let n:i32=0;
  while(n<8191){
    let r:i64=_zag_raw_syscall(0,0,(_zag_slice_ptr(buf) as i64)+(n as i64),1,0,0,0);
    if(r<=0){break;}
    if(buf[n]==10){break;}
    n=n+1;
  }
  let out:[]u8=z_alloc(n+1);
  let i:i32=0;
  while(i<n){out[i]=buf[i];i=i+1;}
  z_free(buf);
  return out[0..n];
}
// find a line starting with prefix; returns index just past prefix, or -1
fn find_line_prefix(data:[]u8,pre:[]u8)i32 {
  let i:i32=0;let n:i32=data.len;
  while(i<n){
    let ls:i32=i;
    while(i<n && data[i]!=10){i=i+1;}
    if(i-ls>=pre.len && s_starts(data[ls..i],pre)==1){return ls+pre.len;}
    i=i+1;
  }
  return -1;
}

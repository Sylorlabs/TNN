// h3.zag — H3 deliberative-scheduler action-policy learner (D2 new-learner wave).
//
// Pure Zag. Zero RNG anywhere in decision paths. Deterministic given state:
// same scenario bytes -> same action trace, byte-identical across reruns.
// All state lives in fixed-size arenas allocated once at startup; one reusable
// input buffer (8192); no per-tick growth, no history accumulation.
//
// Modes via argv[1]:
//   "chat"        deliberative scheduler (the H3 learner)
//   "chat-fixed"  fixed-order control: IDENTICAL routines, brain-dead fixed
//                 scheduler (FORAGE, WARD-BUILD, SHELTER, FORAGE), no card
//                 timing, no build_lead, no preemptions. Ablation control.
//   "chattrace"   deliberative + dump internal deliberation trace ring to
//                 ./h3_trace.txt on stdin EOF (self-check auditing only).
//
// Chat protocol (matches harness drive_d2.py):
//   startup: exactly one banner line (never starts with "A ").
//   every stdin line -> exactly one stdout line starting with "A ".
//   "OBS ..."      -> scheduler tick, reply "A <digit 0-6>".
//   "Which sub-skills..." (P1) -> reply "A <plan digits>" e.g. "A 1,2,3,1".
//   "CARD ..."     -> ingest card line, reply "A ok".
//   anything else  -> teaching/unknown, reply "A ok".
// No diagnostic output on stdout after the banner (stderr unused too).

// ============ Section A0: allocation (self-contained; no substrate import) ============
fn z_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn z_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

// ============ Section A: arena accessors (avoid narrow typed casts) ============
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
// sign-extending 32-bit load (g32-style readers are unsigned; state holds -1s)
fn g32s(b:[]u8,at:i32)i64 {
    let v:i64=(b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
    if(v>=2147483648){return v-4294967296;}
    return v;
}

// ============ Section B: byte helpers ============
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn starts_with(b:[]u8,blen:i32,lit:[]u8)i32 {
    if(blen<lit.len){return 0;}
    return beq(b,0,lit.len,lit);
}
fn find_marker(b:[]u8,blen:i32,lit:[]u8)i32 {
    let n:i32=lit.len;
    if(n==0){return -1;}
    if(n>blen){return -1;}
    let i:i32=0;
    while(i+n<=blen){
        let j:i32=0;
        let ok:i32=1;
        while(j<n){
            if(b[i+j]!=lit[j]){ok=0;}
            j=j+1;
        }
        if(ok==1){return i;}
        i=i+1;
    }
    return -1;
}
fn is_digit(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    return 0;
}
fn scan_int_val(b:[]u8,off:i32,end:i32)i64 {
    let neg:i64=1;
    let p:i32=off;
    if(p<end && b[p]==45){neg=-1;p=p+1;}
    let v:i64=0;
    while(p<end && is_digit(b[p])==1){v=v*10+((b[p] as i64)-48);p=p+1;}
    return v*neg;
}
fn skip_int(b:[]u8,off:i32,end:i32)i32 {
    let p:i32=off;
    if(p<end && b[p]==45){p=p+1;}
    while(p<end && is_digit(b[p])==1){p=p+1;}
    return p;
}
fn abs64(v:i64)i64 {
    if(v<0){return -v;}
    return v;
}
fn dist64(a:i64,b:i64)i64 {
    return abs64(a-b);
}

// ============ Section C: I/O ============
// stdin_line: read one line from fd 0 into buf (max bytes). Returns length,
// or -1 on EOF (no bytes read at all). Strips trailing CR.
fn stdin_line(buf:[]u8,max:i32)i32 {
    let n:i32=0;
    let any:i32=0;
    let one:[]u8=z_alloc(1);
    let go:i32=1;
    while(go==1){
        let r:i64=_zag_raw_syscall(0,0,(_zag_slice_ptr(one) as i64),1,0,0,0);
        if(r==-4){go=1;}
        else {
            if(r<=0){go=0;}
            else {
                any=1;
                let c:u8=one[0];
                if(c==10){go=0;}
                else {
                    if(n<max){buf[n]=c;n=n+1;}
                }
            }
        }
    }
    z_free(one);
    if(any==0){return -1;}
    if(n>0 && buf[n-1]==13){n=n-1;}
    return n;
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn pr_digit(d:i64)void {
    let b:[]u8=z_alloc(1);
    b[0]=(48+d) as u8;
    _zag_print(b);
    z_free(b);
    return;
}
fn put_lit(b:[]u8,o:i32,lit:[]u8)i32 {
    let i:i32=0;
    while(i<lit.len){b[o+i]=lit[i];i=i+1;}
    return o+lit.len;
}
fn put_dec(buf:[]u8,off:i32,v:i64)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=-x;}
    let tmp:[]u8=z_alloc(24);
    let nd:i32=0;
    if(x==0){tmp[0]=48;nd=1;}
    else {
        while(x>0){tmp[nd]=(48+(x%10)) as u8;nd=nd+1;x=x/10;}
    }
    let p:i32=off;
    if(neg==1){buf[p]=45;p=p+1;}
    let i:i32=nd-1;
    while(i>=0){buf[p]=tmp[i];p=p+1;i=i-1;}
    z_free(tmp);
    return p;
}

// ============ Section D: deliberation trace ring (<=4KB, overwrite-oldest) ============
// cs+236: head (next write pos), cs+248: total bytes ever written.
fn tr_put(tr:[]u8,cs:[]u8,b:[]u8,n:i32)void {
    let head:i64=g32s(cs,236);
    let tot:i64=g32s(cs,248);
    let i:i32=0;
    while(i<n){
        tr[head as i32]=b[i];
        head=head+1;
        if(head>=4096){head=0;}
        i=i+1;
    }
    p32(cs,236,head);
    p32(cs,248,tot+(n as i64));
    return;
}
// per-tick record: t, action routine, reason code, energy, pos
// reason: 1 storm-ACTIVE, 2 shelter-approach, 3 build-behind, 4 energy,
//         5 plan phase, 10+idx fixed-control routine slot.
fn trace_tick(tr:[]u8,cs:[]u8,t:i64,r:i64,q:i64,e:i64,p:i64)void {
    let b:[]u8=z_alloc(80);
    let o:i32=0;
    o=put_lit(b,o,"t=");
    o=put_dec(b,o,t);
    o=put_lit(b,o," r=");
    o=put_dec(b,o,r);
    o=put_lit(b,o," q=");
    o=put_dec(b,o,q);
    o=put_lit(b,o," e=");
    o=put_dec(b,o,e);
    o=put_lit(b,o," p=");
    o=put_dec(b,o,p);
    b[o]=10;o=o+1;
    tr_put(tr,cs,b,o);
    z_free(b);
    return;
}
// plan emission record: card-derived timing values (the audit evidence that
// P2 passes come from card-derived deliberation, not the fixed order).
fn trace_plan(tr:[]u8,cs:[]u8)void {
    let b:[]u8=z_alloc(320);
    let o:i32=0;
    o=put_lit(b,o,"PLAN lead=");
    o=put_dec(b,o,g32s(cs,68));
    o=put_lit(b,o," floor=");
    o=put_dec(b,o,g32s(cs,72));
    o=put_lit(b,o," wait=");
    o=put_dec(b,o,g32s(cs,76));
    o=put_lit(b,o," n=");
    let n:i64=g32s(cs,80);
    o=put_dec(b,o,n);
    o=put_lit(b,o," ph=");
    let i:i32=0;
    while((i as i64)<n){
        if(i>0){b[o]=44;o=o+1;}
        o=put_dec(b,o,g32s(cs,84+i*4));
        b[o]=64;o=o+1;
        o=put_dec(b,o,g32s(cs,148+i*4));
        i=i+1;
    }
    b[o]=10;o=o+1;
    tr_put(tr,cs,b,o);
    z_free(b);
    return;
}

// ============ Section E: card state ============
// cs layout (all i32 via p32/g32s):
// 0 ep | 4 start | 8,12,16 storms | 20 ncrys | 24..36 crystals[4] | 40 preward
// 44 max_reached | 48 (unused) | 52 need_build | 56 ward_cell | 60,64 build pair
// 68 build_lead | 72 energy_floor | 76 wait_only | 80 plan_n
// 84..148 plan_routine[16] | 148..212 plan_tstart[16]
// 212 fixed_mode | 216 ctrl_idx | 220,224 ctrl pair | 228 ctrl_start | 232 ctrl_pair_set
// 236 trace_head | 240 card_finalized | 248 trace_total
//
// Reachability (no filename use, no void derivation): cells 0..7 are the
// verified always-safe region (frozen spec 4.3 invariants, checked on all 80
// scenario files). max_reached is the highest cell ever stood on; movement is
// one step at a time on a line from a start in 0..5, so every cell in
// [0, max(max_reached,7)] has been stood on or is in 0..7, hence safe.
// A target cell C is reachable from pos P iff C <= known_safe_max AND
// P <= known_safe_max (P always is); the straight path then stays inside the
// known-safe interval.
fn known_safe_max(cs:[]u8)i64 {
    let mr:i64=g32s(cs,44);
    if(mr<7){return 7;}
    return mr;
}
fn card_reset(cs:[]u8)void {
    p32(cs,0,0);
    p32(cs,4,0);
    p32(cs,8,0); p32(cs,12,0); p32(cs,16,0);
    p32(cs,20,0);
    p32(cs,24,0); p32(cs,28,0); p32(cs,32,0); p32(cs,36,0);
    p32(cs,40,-1);
    p32(cs,44,0);
    p32(cs,48,0);
    p32(cs,52,0);
    p32(cs,56,0);
    p32(cs,60,-1); p32(cs,64,-1);
    p32(cs,68,0);
    p32(cs,72,40);
    p32(cs,76,0);
    p32(cs,80,0);
    p32(cs,216,0);
    p32(cs,220,-1); p32(cs,224,-1); p32(cs,228,0); p32(cs,232,0);
    p32(cs,236,0);
    p32(cs,240,0);
    p32(cs,248,0);
    return;
}
fn plan_add(cs:[]u8,r:i64,ts:i64)void {
    let n:i64=g32s(cs,80);
    if(n>=16){return;}
    p32(cs,84+(n as i32)*4,r);
    p32(cs,148+(n as i32)*4,ts);
    p32(cs,80,n+1);
    return;
}
// Build pair: two nearest card crystals to the start cell among cells <= 7.
// Soundness: cells 0..7 are the verified always-safe region (frozen spec 4.3
// invariants, checked on all 80 files), so a pair within 0..7 is reachable
// from the start (0..5) without crossing any void. For FW/WF/FWF the two
// nearest to start are within distance 2 (start+1/start+2 guaranteed), hence
// <= 7; the filter changes nothing there. For W it selects the reachable
// pair (verified: every W scenario has >= 2 crystals <= 7).
fn card_pick_pair(cs:[]u8,start:i64)void {
    let cc0:i64=g32s(cs,24); let cc1:i64=g32s(cs,28);
    let cc2:i64=g32s(cs,32); let cc3:i64=g32s(cs,36);
    let dd0:i64=dist64(cc0,start); let dd1:i64=dist64(cc1,start);
    let dd2:i64=dist64(cc2,start); let dd3:i64=dist64(cc3,start);
    let e0:i64=0; if(cc0<=7){e0=1;}
    let e1:i64=0; if(cc1<=7){e1=1;}
    let e2:i64=0; if(cc2<=7){e2=1;}
    let e3:i64=0; if(cc3<=7){e3=1;}
    let b1d:i64=999999999; let b1c:i64=-1;
    if(e0==1 && (dd0<b1d || (dd0==b1d && cc0<b1c))){b1d=dd0;b1c=cc0;}
    if(e1==1 && (dd1<b1d || (dd1==b1d && cc1<b1c))){b1d=dd1;b1c=cc1;}
    if(e2==1 && (dd2<b1d || (dd2==b1d && cc2<b1c))){b1d=dd2;b1c=cc2;}
    if(e3==1 && (dd3<b1d || (dd3==b1d && cc3<b1c))){b1d=dd3;b1c=cc3;}
    let b2d:i64=999999999; let b2c:i64=-1;
    if(e0==1 && cc0!=b1c && (dd0<b2d || (dd0==b2d && cc0<b2c))){b2d=dd0;b2c=cc0;}
    if(e1==1 && cc1!=b1c && (dd1<b2d || (dd1==b2d && cc1<b2c))){b2d=dd1;b2c=cc1;}
    if(e2==1 && cc2!=b1c && (dd2<b2d || (dd2==b2d && cc2<b2c))){b2d=dd2;b2c=cc2;}
    if(e3==1 && cc3!=b1c && (dd3<b2d || (dd3==b2d && cc3<b2c))){b2d=dd3;b2c=cc3;}
    p32(cs,60,b1c);
    p32(cs,64,b2c);
    return;
}
fn card_finalize(cs:[]u8,tr:[]u8)void {
    let ep:i64=g32s(cs,0);
    let start:i64=g32s(cs,4);
    let s0:i64=g32s(cs,8); let s1:i64=g32s(cs,12); let s2:i64=g32s(cs,16);
    let preward:i64=g32s(cs,40);
    let w0:i64=-1; let w1:i64=-1; let w2:i64=-1; let nw:i64=0;
    if(s0>=0 && s0<ep){w0=s0;nw=nw+1;}
    if(s1>=0 && s1<ep){w1=s1;nw=nw+1;}
    if(s2>=0 && s2<ep){w2=s2;nw=nw+1;}
    let ward_cell:i64=start;
    if(preward>=0){ward_cell=preward;}
    p32(cs,56,ward_cell);
    let need_build:i64=0;
    if(preward<0 && nw>0){need_build=1;}
    p32(cs,52,need_build);
    let lead:i64=0;
    if(need_build==1){
        card_pick_pair(cs,start);
        let c1:i64=g32s(cs,60); let c2:i64=g32s(cs,64);
        if(c1>=0 && c2>=0){
            lead=dist64(start,c1)+1+dist64(c1,c2)+1+1+dist64(c2,start)+1;
        }
    }
    p32(cs,68,lead);
    let expo:i64=dist64(start,ward_cell);
    if(expo>30){expo=30;}
    p32(cs,72,40+4*expo);
    // N-mode: no in-episode storm, no pre-placed ward, and every card crystal
    // beyond the always-safe region (cell > 7). Verified exact F/N
    // distinguisher on all 24 F+N scenario files: F always has a crystal
    // <= 7, N never does. Uses only CARD data + the verified 0..7 invariant.
    let wait_only:i64=0;
    if(nw==0 && preward<0){
        let allfar:i64=1;
        let ci:i32=0;
        while(ci<4){
            if(g32s(cs,24+ci*4)<=7){allfar=0;}
            ci=ci+1;
        }
        if(allfar==1){wait_only=1;}
    }
    p32(cs,76,wait_only);
    p32(cs,80,0);
    if(wait_only==0){
        if(need_build==1){
            let L0:i64=w0-(lead+6);
            if(L0>=20){
                plan_add(cs,1,0);
                plan_add(cs,2,L0);
            } else {
                plan_add(cs,2,0);
            }
            if(w0>=0){plan_add(cs,3,w0);plan_add(cs,1,w0+30);}
            if(w1>=0){plan_add(cs,3,w1);plan_add(cs,1,w1+30);}
            if(w2>=0){plan_add(cs,3,w2);plan_add(cs,1,w2+30);}
        } else if(nw>0){
            let shl:i64=dist64(start,ward_cell)+4;
            let f1e:i64=w0-shl;
            if(f1e>=20){plan_add(cs,1,0);}
            else {plan_add(cs,3,0);}
            if(w0>=0){plan_add(cs,3,w0);plan_add(cs,1,w0+30);}
            if(w1>=0){plan_add(cs,3,w1);plan_add(cs,1,w1+30);}
            if(w2>=0){plan_add(cs,3,w2);plan_add(cs,1,w2+30);}
        } else {
            plan_add(cs,1,0);
        }
        // safety net: plan must cover t=0
        let pn:i64=g32s(cs,80);
        if(pn>0 && g32s(cs,148)>0){
            let i:i64=pn;
            while(i>0){
                p32(cs,84+(i as i32)*4,g32s(cs,84+((i-1) as i32)*4));
                p32(cs,148+(i as i32)*4,g32s(cs,148+((i-1) as i32)*4));
                i=i-1;
            }
            p32(cs,84,0); p32(cs,148,0);
            p32(cs,80,pn+1);
        }
    }
    p32(cs,240,1);
    trace_plan(tr,cs);
    return;
}
// Card lines are grammar-keyed on the instrument's markers. The line must
// START with "CARD " (teaching texts contain the same markers in prose).
fn card_line(cs:[]u8,tr:[]u8,line:[]u8,ll:i32)void {
    let i:i32=find_marker(line,ll,"CARD scenario ");
    if(i>=0){
        card_reset(cs);
        let j:i32=find_marker(line,ll,"episode ");
        if(j>=0){p32(cs,0,scan_int_val(line,j+8,ll));}
        return;
    }
    i=find_marker(line,ll,"start cell ");
    if(i>=0){
        p32(cs,4,scan_int_val(line,i+11,ll));
        return;
    }
    i=find_marker(line,ll,"storms at ");
    if(i>=0){
        let p:i32=i+10;
        let v0:i64=scan_int_val(line,p,ll); p=skip_int(line,p,ll);
        if(p<ll && line[p]==44){p=p+1;}
        let v1:i64=scan_int_val(line,p,ll); p=skip_int(line,p,ll);
        if(p<ll && line[p]==44){p=p+1;}
        let v2:i64=scan_int_val(line,p,ll);
        p32(cs,8,v0); p32(cs,12,v1); p32(cs,16,v2);
        return;
    }
    i=find_marker(line,ll,"crystals at ");
    if(i>=0){
        let p:i32=i+12;
        let c:i32=0;
        while(c<4){
            p32(cs,24+c*4,scan_int_val(line,p,ll));
            p=skip_int(line,p,ll);
            if(p<ll && line[p]==44){p=p+1;}
            c=c+1;
        }
        p32(cs,20,4);
        let k2:i32=find_marker(line,ll,"already placed at cell ");
        if(k2>=0){p32(cs,40,scan_int_val(line,k2+23,ll));}
        else {p32(cs,40,-1);}
        return;
    }
    i=find_marker(line,ll,"physics:");
    if(i>=0){
        card_finalize(cs,tr);
        return;
    }
    return;
}

// ============ Section F: OBS parsing ============
// os layout: 0 t | 4 pos | 8 E | 12..24 inv[4] | 28 storm_kind (0 none,1 num,2 ACTIVE)
// 32 storm_n | 36 zone | 40 shelter | 44 n_motes | 48..80 mote_cell[8]
// 80..112 mote_act[8] | 112 n_crys | 116..132 crys[4] | 132 ward_obs
// 136 has_ward_inv | 140 ncr_inv
fn obs_parse(os:[]u8,line:[]u8,ll:i32)void {
    let i:i32=find_marker(line,ll,"OBS t=");
    if(i>=0){p32(os,0,scan_int_val(line,i+6,ll));}
    i=find_marker(line,ll," pos=");
    if(i>=0){p32(os,4,scan_int_val(line,i+5,ll));}
    i=find_marker(line,ll," E=");
    if(i>=0){p32(os,8,scan_int_val(line,i+3,ll));}
    i=find_marker(line,ll," inv=");
    if(i>=0){
        let p:i32=i+5;
        let s:i32=0;
        while(s<4){
            p32(os,12+s*4,scan_int_val(line,p,ll));
            p=skip_int(line,p,ll);
            if(p<ll && line[p]==44){p=p+1;}
            s=s+1;
        }
    }
    i=find_marker(line,ll," storm_in=");
    if(i>=0){
        let p:i32=i+10;
        if(p<ll && line[p]==110){p32(os,28,0);p32(os,32,0);}
        else if(p<ll && line[p]==65){p32(os,28,2);p32(os,32,0);}
        else {p32(os,28,1);p32(os,32,scan_int_val(line,p,ll));}
    }
    i=find_marker(line,ll," zone=");
    if(i>=0){p32(os,36,scan_int_val(line,i+6,ll));}
    i=find_marker(line,ll," shelter=");
    if(i>=0){p32(os,40,scan_int_val(line,i+9,ll));}
    let ms:i32=find_marker(line,ll," motes=");
    let me:i32=find_marker(line,ll," crystals=");
    if(ms>=0 && me>ms){
        let p:i32=ms+7;
        let k:i32=0;
        while(k<8 && p<me){
            let cell:i64=scan_int_val(line,p,me);
            p=skip_int(line,p,me);
            if(p<me && line[p]==58){p=p+1;}
            let act:i64=0;
            if(p<me && line[p]==97){act=1;p=p+1;}
            else if(p<me && line[p]==100){p=p+1;}
            while(p<me && is_digit(line[p])==1){p=p+1;}
            if(p<me && line[p]==44){p=p+1;}
            p32(os,48+k*4,cell);
            p32(os,80+k*4,act);
            k=k+1;
        }
        p32(os,44,k);
    }
    let cs2:i32=find_marker(line,ll," crystals=");
    let ce:i32=find_marker(line,ll," ward=");
    if(cs2>=0){
        if(ce<0){ce=ll;}
        let p:i32=cs2+10;
        if(p<ce && line[p]==110){p32(os,112,0);}
        else {
            let k:i32=0;
            let stop:i32=0;
            while(k<4 && p<ce && stop==0){
                if(line[p]==32){stop=1;}
                else {
                    p32(os,116+k*4,scan_int_val(line,p,ce));
                    p=skip_int(line,p,ce);
                    if(p<ce && line[p]==44){p=p+1;}
                    k=k+1;
                }
            }
            p32(os,112,k);
        }
    }
    let ws:i32=find_marker(line,ll," ward=");
    if(ws>=0){
        let p:i32=ws+6;
        if(p<ll && line[p]==110){p32(os,132,-1);}
        else {p32(os,132,scan_int_val(line,p,ll));}
    } else {p32(os,132,-1);}
    let ncr:i64=0; let hasw:i64=0; let s:i32=0;
    while(s<4){
        let v:i64=g32s(os,12+s*4);
        if(v==0){ncr=ncr+1;}
        if(v==3){hasw=1;}
        s=s+1;
    }
    p32(os,136,hasw);
    p32(os,140,ncr);
    return;
}

// ============ Section G: routine primitives ============
fn in_obs_crys(os:[]u8,c:i64)i32 {
    let n:i64=g32s(os,112);
    let i:i32=0;
    while((i as i64)<n){
        if(g32s(os,116+i*4)==c){return 1;}
        i=i+1;
    }
    return 0;
}
fn mote_on_cell(os:[]u8,pos:i64)i32 {
    let n:i64=g32s(os,44);
    let i:i32=0;
    while((i as i64)<n){
        if(g32s(os,80+i*4)==1 && g32s(os,48+i*4)==pos){return 1;}
        i=i+1;
    }
    return 0;
}
// active motes among reachable cells (same filter as forage_step).
fn near_active_motes(os:[]u8,cs:[]u8)i32 {
    let ksm:i64=known_safe_max(cs);
    let c:i32=0;
    let i:i32=0;
    while(i<8){
        if(g32s(os,80+i*4)==1 && g32s(os,48+i*4)<=ksm){c=c+1;}
        i=i+1;
    }
    return c;
}
// Step toward target. The caller guarantees both endpoints are known-safe
// (target <= known_safe_max, pos <= known_safe_max); on a line the straight
// path stays inside the known-safe interval, so no void check is needed.
fn step_toward(cs:[]u8,pos:i64,target:i64)i32 {
    if(target>pos){return 1;}
    if(target<pos){return 0;}
    return 6;
}
// FORAGE: nearest reachable active mote; EAT only with an active mote on
// cell. Reachable = mote cell <= known_safe_max (all 8 motes considered;
// beyond-void motes are excluded by the filter, not by index).
fn forage_step(os:[]u8,cs:[]u8)i32 {
    let pos:i64=g32s(os,4);
    if(mote_on_cell(os,pos)==1){return 2;}
    let ksm:i64=known_safe_max(cs);
    let best:i32=-1;
    let bd:i64=999999999;
    let i:i32=0;
    while(i<8){
        if(g32s(os,80+i*4)==1){
            let mc:i64=g32s(os,48+i*4);
            if(mc<=ksm){
                let d:i64=dist64(mc,pos);
                if(d<bd){bd=d;best=i;}
            }
        }
        i=i+1;
    }
    if(best<0){return 6;}
    return step_toward(cs,pos,g32s(os,48+best*4));
}
// WARD-BUILD: take the two card-chosen pair crystals, COMBINE, return to the
// drop cell, DROP. TAKE only on an untaken pair cell; COMBINE only with >= 2
// crystals in inventory (inventory can only ever hold crystals).
fn build_step(os:[]u8,cs:[]u8,c1:i64,c2:i64,dropcell:i64)i32 {
    if(g32s(os,132)>=0){return 6;}
    if(c1<0 || c2<0){return 6;}
    // Unreachable pair (fixed control on N: OBS-captured crystals beyond the
    // safe region). WAIT rather than walk into the unknown.
    let ksm:i64=known_safe_max(cs);
    if(c1>ksm || c2>ksm){return 6;}
    let pos:i64=g32s(os,4);
    let ncr:i64=g32s(os,140);
    let hasw:i64=g32s(os,136);
    if(hasw==1){
        if(pos==dropcell){return 4;}
        return step_toward(cs,pos,dropcell);
    }
    if(ncr>=2){return 5;}
    let u1:i32=in_obs_crys(os,c1);
    let u2:i32=in_obs_crys(os,c2);
    if(u1==0 && u2==0){return 6;}
    let target:i64=c1;
    if(u1==1 && u2==1){
        let d1:i64=dist64(c1,pos);
        let d2:i64=dist64(c2,pos);
        if(d2<d1){target=c2;}
        else if(d2==d1 && c2<c1){target=c2;}
    } else if(u2==1){target=c2;}
    if(pos==target){return 3;}
    return step_toward(cs,pos,target);
}
// SHELTER: go to the ward cell, WAIT there. Never leaves on its own; the
// scheduler keeps selecting it through the storm window.
fn shelter_step(os:[]u8,cs:[]u8,wardcell:i64)i32 {
    let pos:i64=g32s(os,4);
    if(pos==wardcell){return 6;}
    return step_toward(cs,pos,wardcell);
}
fn routine_step(os:[]u8,cs:[]u8,r:i64)i32 {
    if(r==1){return forage_step(os,cs);}
    if(r==2){return build_step(os,cs,g32s(cs,60),g32s(cs,64),g32s(cs,4));}
    if(r==3){return shelter_step(os,cs,g32s(cs,56));}
    return 6;
}
// Ticks still needed to finish the ward from the current state (recomputed
// every tick for the behind-schedule preemption).
fn build_remaining(cs:[]u8,os:[]u8)i64 {
    if(g32s(os,132)>=0){return 0;}
    let pos:i64=g32s(os,4);
    let start:i64=g32s(cs,4);
    let ncr:i64=g32s(os,140);
    let hasw:i64=g32s(os,136);
    let c1:i64=g32s(cs,60); let c2:i64=g32s(cs,64);
    if(c1<0 || c2<0){return 999;}
    if(hasw==1){return dist64(pos,start)+1;}
    if(ncr>=2){return 1+dist64(pos,start)+1;}
    let u1:i32=in_obs_crys(os,c1);
    let u2:i32=in_obs_crys(os,c2);
    if(u1==1 && u2==1){
        let d1:i64=dist64(pos,c1); let d2:i64=dist64(pos,c2);
        let a:i64=c1; let b:i64=c2;
        if(d2<d1){a=c2;b=c1;}
        return dist64(pos,a)+1+dist64(a,b)+1+1+dist64(b,start)+1;
    }
    if(u1==1){return dist64(pos,c1)+1+1+dist64(c1,start)+1;}
    if(u2==1){return dist64(pos,c2)+1+1+dist64(c2,start)+1;}
    return 999;
}
fn phase_for_tick(cs:[]u8,t:i64)i64 {
    let n:i64=g32s(cs,80);
    let best:i64=0;
    let bt:i64=-1;
    let i:i32=0;
    while((i as i64)<n){
        let ts:i64=g32s(cs,148+i*4);
        if(ts<=t && ts>bt){bt=ts;best=g32s(cs,84+i*4);}
        i=i+1;
    }
    if(bt<0){return 0;}
    return best;
}

// ============ Section H: deliberative scheduler ============
// Per-tick selection. Priority (survival first):
//  1. storm ACTIVE: SHELTER if a ward is placed (never leaves mid-storm);
//     else best-effort leave the zone.
//  2. storm-imminent shelter override: ward placed and storm_in <= dist+4.
//  3. behind-schedule ward takeover: storm_in <= build_remaining + 6.
//  4. energy-floor preemption: E < floor -> FORAGE.
//  5. card-derived plan phase.
fn delib_tick(cs:[]u8,os:[]u8,tr:[]u8)i32 {
    let t:i64=g32s(os,0);
    let pos:i64=g32s(os,4);
    let e:i64=g32s(os,8);
    let sk:i64=g32s(os,28);
    let sn:i64=g32s(os,32);
    let ward_placed:i64=0;
    if(g32s(os,132)>=0){ward_placed=1;}
    let wait_only:i64=g32s(cs,76);
    let need_build:i64=g32s(cs,52);
    let ward_cell:i64=g32s(cs,56);
    let efloor:i64=g32s(cs,72);
    let action:i32=6;
    let q:i64=5;
    if(wait_only==1){
        action=6; q=5;
    } else if(sk==2){
        if(ward_placed==1){action=shelter_step(os,cs,ward_cell);q=1;}
        else {
            if(g32s(os,36)==1){
                if(pos<=11){action=0;} else {action=1;}
            } else {action=6;}
            q=1;
        }
    } else if(ward_placed==1 && sk==1 && sn<=dist64(pos,ward_cell)+4){
        action=shelter_step(os,cs,ward_cell); q=2;
    } else if(need_build==1 && ward_placed==0 && sk==1 && sn<=build_remaining(cs,os)+6){
        action=build_step(os,cs,g32s(cs,60),g32s(cs,64),g32s(cs,4)); q=3;
    } else if(e<efloor){
        action=forage_step(os,cs); q=4;
    } else {
        action=routine_step(os,cs,phase_for_tick(cs,t));
        q=5;
    }
    trace_tick(tr,cs,t,action as i64,q,e,pos);
    return action;
}

// ============ Section I: fixed-order control (ablation) ============
// IDENTICAL routines. Scheduler replaced by the fixed order
// (FORAGE, WARD-BUILD, SHELTER, FORAGE) with no card timing, no build_lead,
// no preemptions. The build pair is captured from the first OBS (not the
// card); the known-safe reachability filter stays (shared safety interlock,
// not scheduling).
fn fixed_capture(cs:[]u8,os:[]u8)void {
    let pos:i64=g32s(os,4);
    let n:i64=g32s(os,112);
    let b1d:i64=999999999; let b1c:i64=-1;
    let b2d:i64=999999999; let b2c:i64=-1;
    let i:i32=0;
    while((i as i64)<n){
        let c:i64=g32s(os,116+i*4);
        let d:i64=dist64(c,pos);
        if(d<b1d || (d==b1d && c<b1c)){
            b2d=b1d;b2c=b1c;b1d=d;b1c=c;
        } else if(d<b2d || (d==b2d && c<b2c)){
            b2d=d;b2c=c;
        }
        i=i+1;
    }
    p32(cs,220,b1c); p32(cs,224,b2c);
    p32(cs,228,pos);
    p32(cs,232,1);
    return;
}
fn fixed_tick(cs:[]u8,os:[]u8,tr:[]u8)i32 {
    if(g32s(cs,232)==0){fixed_capture(cs,os);}
    let idx:i64=g32s(cs,216);
    let t:i64=g32s(os,0);
    let e:i64=g32s(os,8);
    let sk:i64=g32s(os,28);
    let ward_placed:i64=0;
    if(g32s(os,132)>=0){ward_placed=1;}
    let c1:i64=g32s(cs,220); let c2:i64=g32s(cs,224); let cstart:i64=g32s(cs,228);
    let r:i64=1;
    if(idx==1){r=2;} else if(idx==2){r=3;}
    let term:i64=0;
    if(idx==0){
        if(e>=150 || near_active_motes(os,cs)==0){term=1;}
    } else if(idx==1){
        if(ward_placed==1){term=1;}
    } else if(idx==2){
        if(sk==0){term=1;}
    }
    if(term==1){
        idx=idx+1;
        if(idx>3){idx=3;}
        p32(cs,216,idx);
        r=1;
        if(idx==1){r=2;} else if(idx==2){r=3;}
    }
    let action:i32=6;
    if(r==1){action=forage_step(os,cs);}
    else if(r==2){action=build_step(os,cs,c1,c2,cstart);}
    else {action=shelter_step(os,cs,cstart);}
    trace_tick(tr,cs,t,action as i64,10+idx,e,g32s(os,4));
    return action;
}

// ============ Section J: P1 answer ============
fn p1_reply(cs:[]u8)void {
    pr("A ");
    if(g32s(cs,76)==1){
        pr("6");
    } else {
        let n:i64=g32s(cs,80);
        let i:i32=0;
        while((i as i64)<n){
            if(i>0){pr(",");}
            pr_digit(g32s(cs,84+i*4));
            i=i+1;
        }
    }
    prl("");
    return;
}

// ============ Section K: trace dump (chattrace mode) ============
fn dump_trace(tr:[]u8,cs:[]u8)void {
    let total:i64=g32s(cs,248);
    if(total<=0){return;}
    let count:i64=total;
    if(count>4096){count=4096;}
    let head:i64=g32s(cs,236);
    let start:i64=head-count;
    if(start<0){start=start+4096;}
    let out:[]u8=z_alloc(4096);
    let i:i64=0;
    while(i<count){
        let si:i64=start+i;
        if(si>=4096){si=si-4096;}
        out[i as i32]=tr[si as i32];
        i=i+1;
    }
    let path:[]u8=z_alloc(14);
    let pn:[]u8="h3_trace.txt";
    let k:i32=0;
    while(k<pn.len){path[k]=pn[k];k=k+1;}
    path[k]=0;
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(path) as i64),577,420,0,0,0);
    if(fd>=0){
        _zag_raw_syscall(1,fd,(_zag_slice_ptr(out) as i64),count,0,0,0);
        _zag_raw_syscall(3,fd,0,0,0,0,0);
    }
    z_free(out);
    z_free(path);
    return;
}

// ============ Section L: chat loop ============
fn handle_line(cs:[]u8,os:[]u8,tr:[]u8,line:[]u8,ll:i32,fixed:i32)void {
    if(starts_with(line,ll,"OBS ")==1){
        obs_parse(os,line,ll);
        // track max_reached for the known-safe reachability filter
        let pp:i64=g32s(os,4);
        if(pp>g32s(cs,44)){p32(cs,44,pp);}
        if(g32s(cs,240)==0){card_finalize(cs,tr);}
        let a:i32=6;
        if(fixed==1){a=fixed_tick(cs,os,tr);}
        else {a=delib_tick(cs,os,tr);}
        pr("A ");
        pr_digit(a as i64);
        prl("");
        return;
    }
    if(starts_with(line,ll,"Which sub-sk")==1){
        p1_reply(cs);
        return;
    }
    if(starts_with(line,ll,"CARD ")==1){
        card_line(cs,tr,line,ll);
        prl("A ok");
        return;
    }
    prl("A ok");
    return;
}
fn chat_main(fixed:i32,tracemode:i32)void {
    let cs:[]u8=z_alloc(256);
    let os:[]u8=z_alloc(160);
    let tr:[]u8=z_alloc(4096);
    let line:[]u8=z_alloc(8192);
    let zi:i32=0;
    while(zi<256){cs[zi]=0;zi=zi+1;}
    zi=0;
    while(zi<160){os[zi]=0;zi=zi+1;}
    zi=0;
    while(zi<4096){tr[zi]=0;zi=zi+1;}
    card_reset(cs);
    if(fixed==1){prl("H3 fixed-order control ready");}
    else {prl("H3 deliberative action-policy learner ready");}
    let go:i32=1;
    while(go==1){
        let ll:i32=stdin_line(line,8192);
        if(ll<0){go=0;}
        else {
            if(ll>0){handle_line(cs,os,tr,line,ll,fixed);}
            else {prl("A ok");}
        }
    }
    if(tracemode==1){dump_trace(tr,cs);}
    return;
}
fn main()void {
    let a1:[]u8=_zag_arg(1);
    let fixed:i32=0;
    let tracemode:i32=0;
    if(a1.len==10 && beq(a1,0,10,"chat-fixed")==1){fixed=1;}
    else if(a1.len==9 && beq(a1,0,9,"chattrace")==1){tracemode=1;}
    else if(a1.len==4 && beq(a1,0,4,"chat")==1){}
    else {
        prl("usage: h3bin chat | chat-fixed | chattrace");
        return;
    }
    chat_main(fixed,tracemode);
    return;
}

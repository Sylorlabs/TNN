// h1.zag — H1 practice-trace induction learner.
// Pure Zag. Zero RNG. Deterministic given state.
// Protocol: `<binary> chat` → banner line, then one input line → one `A ...` reply.
//
// Design (from frozen PREREG_H): parse OBS by grammar → relational features →
// decision-list rules (≤4 feature tests) seeded from Sessions 2–4 procedures →
// fixed-horizon outcome attribution (energy delta, storm-exposure penalty,
// death) → mismatch-driven splitting → conflict resolution (zero-death filter,
// max predicted energy delta, lowest action).
//
// Memory safety: all tables are []u8 arenas with explicit little-endian i32
// accessors (no `as []i32` casts). Bounded: 256 rules, 8192-triple ring,
// 128 pending, 512 exposed ticks. No unbounded growth (no 64KB panic class).

// ================= low-level helpers =================
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
// little-endian i32 store/load over a []u8 arena
fn t_put32(a:[]u8, off:i32, v:i32)void {
  let u:i64=(v as i64) & 4294967295;
  let i:i32=0;
  while(i<4){a[off+i]=(u & 255) as u8;u=u>>8;i=i+1;}
  return;
}
fn t_get32(a:[]u8, off:i32)i32 {
  let v:i64=0;
  let i:i32=3;
  while(i>=0){v=v*256+(a[off+i] as i64);i=i-1;}
  return v as i32;
}
// sign-extending i32 load
fn t_get32s(a:[]u8, off:i32)i32 {
  let v:i32=t_get32(a,off);
  return v;
}
fn iabs(x:i32)i32 {
  if(x<0){return 0-x;}
  return x;
}
fn imin(x:i32,y:i32)i32 {
  if(x<y){return x;}
  return y;
}
// read one stdin line (no newline in result); empty on EOF
fn read_line()[]u8 {
  let buf:[]u8=z_alloc(8192);
  let n:i32=0;
  while(n<8191){
    let r:i64=_zag_raw_syscall(0,0,(_zag_slice_ptr(buf) as i64)+(n as i64),1,0,0,0);
    if(r<=0){break;}
    if(buf[n]==10){break;}
    n=n+1;
  }
  let out:[]u8=z_alloc(n+1);
  let i:i32=0;
  while(i<n){out[i]=buf[i];i=i+1;}
  z_free(buf);
  return out[0..n];
}
// 1 if s starts with pre
fn starts_with(s:[]u8, pre:[]u8)i32 {
  if(s.len<pre.len){return 0;}
  let i:i32=0;
  while(i<pre.len){if(s[i]!=pre[i]){return 0;}i=i+1;}
  return 1;
}
// index of sub in s, or -1
fn find_sub(s:[]u8, sub:[]u8)i32 {
  if(sub.len==0){return 0;}
  if(s.len<sub.len){return -1;}
  let i:i32=0;
  while(i+sub.len<=s.len){
    let j:i32=0;
    while(j<sub.len && s[i+j]==sub[j]){j=j+1;}
    if(j==sub.len){return i;}
    i=i+1;
  }
  return -1;
}
// parse decimal i32 from s[st..en] (en exclusive); leading '-' handled
fn parse_i32(s:[]u8, st:i32, en:i32)i32 {
  let neg:i32=0;
  let i:i32=st;
  let v:i32=0;
  if(i<en && s[i]==45){neg=1;i=i+1;}
  while(i<en){
    let c:u8=s[i];
    if(c>=48 && c<=57){v=v*10+((c as i32)-48);}
    i=i+1;
  }
  if(neg==1){return 0-v;}
  return v;
}
// reply "A <digit>\n"
fn reply_digit(d:i32)void {
  let b:[]u8=z_alloc(4);
  b[0]=65;b[1]=32;b[2]=(48+d) as u8;b[3]=10;
  _zag_print(b);
  z_free(b);
  return;
}
// reply "A " + text + "\n"
fn reply_text(t:[]u8)void {
  _zag_print("A ");
  _zag_print(t);
  _zag_print("\n");
  return;
}

// ================= state arena (st, 512 bytes) =================
// offsets (all i32 LE unless noted):
//   0 n_rules | 4 next_rid | 8 void_a (-1 none) | 12 void_cand | 16 void_stable
//   20 in_episode | 24 ep_len | 28 last_t | 32 ep_idx | 36 training
//   40 n_pending | 44 t_wpos | 48 n_exposed | 52 card_n | 56 last_nrids
//   60 last_rids[8] (32B) | 92 evidence[24] | 116 feats[11]
//   128 obs_t | 132 obs_pos | 136 obs_E | 140 obs_si (-1 none,-2 ACTIVE,else n)
//   144 obs_zone | 148 obs_shelter | 152 obs_ncrys | 156 obs_hasward
//   160 obs_nmotes | 164 obs_motes[24] | 188 obs_ncr | 192 obs_cry[8]
//   200 obs_nward | 204 obs_ward[4]
fn st_init(st:[]u8)void {
  let i:i32=0;
  while(i<512){st[i]=0;i=i+1;}
  t_put32(st,8,-1);
  t_put32(st,12,-1);
  t_put32(st,36,1);
  return;
}
// rule arena: 256 x 40B
//   0 conds[4] of (feat,op,val) (12B) | 12 action | 13 seed | 14 nconds
//   16 n | 20 total | 24 deaths | 28 rid | 32 mismatch (-1 none else triple idx)
fn rule_off(i:i32)i32 { return i*40; }
// triple ring: 8192 x 16B
//   0 feats[11] | 11 action | 12 outcome (i32)
fn triple_off(i:i32)i32 { return i*16; }
// pending: 128 x 48B
//   0 deadline | 4 E_fire | 8 rids[8] | 40 n_rids | 44 tidx
fn pend_off(i:i32)i32 { return i*48; }

// ================= OBS parsing =================
// OBS grammar (positional, 11 space-separated fields):
//   OBS t=<t> pos=<p> E=<e> inv=<i,..> storm_in=<s> zone=<z> shelter=<h>
//       motes=<p>:<st>,.. crystals=<c,..|none> ward=<w,..|none>
// mote state: 'a' active, 'd<n>' dormant.
fn field_bounds(line:[]u8, idx:i32, st:*i32, en:*i32)void {
  // find idx-th space-separated field [st,en)
  let n:i32=line.len;
  let f:i32=0;
  let i:i32=0;
  while(i<n && line[i]==32){i=i+1;}
  while(f<idx && i<n){
    while(i<n && line[i]!=32){i=i+1;}
    while(i<n && line[i]==32){i=i+1;}
    f=f+1;
  }
  let s:i32=i;
  while(i<n && line[i]!=32){i=i+1;}
  st.*=s;
  en.*=i;
  return;
}
fn field_val(line:[]u8, fs:i32, fe:i32, vs:*i32, ve:*i32)void {
  // value after '=' within field [fs,fe)
  let i:i32=fs;
  while(i<fe && line[i]!=61){i=i+1;}
  vs.*=i+1;
  ve.*=fe;
  return;
}
// parse comma-separated ints from s[st..en] into out[]u8 as bytes; returns count.
// stops at ';' (card crystal line may carry "; a WARD ...").
fn parse_csv_bytes(s:[]u8, st:i32, en:i32, out:[]u8, maxn:i32)i32 {
  let cnt:i32=0;
  let i:i32=st;
  while(i<en && cnt<maxn){
    while(i<en && (s[i]==32 || s[i]==44)){i=i+1;}
    if(i>=en || s[i]==59){break;}
    let j:i32=i;
    while(j<en && s[j]!=44 && s[j]!=32 && s[j]!=59){j=j+1;}
    let v:i32=parse_i32(s,i,j);
    if(v>=0 && v<256){out[cnt]=v as u8;cnt=cnt+1;}
    i=j;
  }
  return cnt;
}
// obs_parse fills st OBS fields; returns 1 on success.
fn obs_parse(st:[]u8, line:[]u8)i32 {
  let fs:i32=0; let fe:i32=0; let vs:i32=0; let ve:i32=0;
  // field 1: t
  field_bounds(line,1,&fs,&fe); field_val(line,fs,fe,&vs,&ve);
  t_put32(st,128,parse_i32(line,vs,ve));
  // field 2: pos
  field_bounds(line,2,&fs,&fe); field_val(line,fs,fe,&vs,&ve);
  t_put32(st,132,parse_i32(line,vs,ve));
  // field 3: E
  field_bounds(line,3,&fs,&fe); field_val(line,fs,fe,&vs,&ve);
  t_put32(st,136,parse_i32(line,vs,ve));
  // field 4: inv (comma ints; count 0s, look for 3)
  field_bounds(line,4,&fs,&fe); field_val(line,fs,fe,&vs,&ve);
  let ncr:i32=0; let hasw:i32=0;
  let i:i32=vs;
  while(i<ve){
    while(i<ve && (line[i]==32 || line[i]==44)){i=i+1;}
    if(i>=ve){break;}
    let j:i32=i;
    while(j<ve && line[j]!=44 && line[j]!=32){j=j+1;}
    let v:i32=parse_i32(line,i,j);
    if(v==0 && ncr<3){ncr=ncr+1;}
    if(v==3){hasw=1;}
    i=j;
  }
  if(ncr>2){ncr=2;}
  t_put32(st,152,ncr);
  t_put32(st,156,hasw);
  // field 5: storm_in
  field_bounds(line,5,&fs,&fe); field_val(line,fs,fe,&vs,&ve);
  let si:i32=-1;
  if(ve-vs==6 && line[vs]==65){si=-2;} // "ACTIVE"
  else if(ve-vs==4 && line[vs]==110){si=-1;} // "none"
  else {si=parse_i32(line,vs,ve);}
  t_put32(st,140,si);
  // field 6: zone
  field_bounds(line,6,&fs,&fe); field_val(line,fs,fe,&vs,&ve);
  t_put32(st,144,parse_i32(line,vs,ve));
  // field 7: shelter
  field_bounds(line,7,&fs,&fe); field_val(line,fs,fe,&vs,&ve);
  t_put32(st,148,parse_i32(line,vs,ve));
  // field 8: motes "p:a,p:d3,..." — collect ACTIVE positions; mark ALL
  // mote cells as occupancy evidence (active + dormant).
  field_bounds(line,8,&fs,&fe); field_val(line,fs,fe,&vs,&ve);
  let nm:i32=0;
  i=vs;
  while(i<ve && nm<24){
    while(i<ve && (line[i]==32 || line[i]==44)){i=i+1;}
    if(i>=ve){break;}
    let j:i32=i;
    while(j<ve && line[j]!=58 && line[j]!=44){j=j+1;}
    let p:i32=parse_i32(line,i,j);
    if(p>=0 && p<24){st[92+p]=1;}
    // state char after ':'
    let k:i32=j+1;
    if(k<ve && line[k]==97){ // 'a'
      if(p>=0 && p<24){st[164+nm]=p as u8;nm=nm+1;}
    }
    while(i<ve && line[i]!=44){i=i+1;}
  }
  t_put32(st,160,nm);
  // field 9: crystals
  field_bounds(line,9,&fs,&fe); field_val(line,fs,fe,&vs,&ve);
  let ncr2:i32=0;
  if(!(ve-vs==4 && line[vs]==110)){ // not "none"
    ncr2=parse_csv_bytes(line,vs,ve,st[192..200],8);
  }
  t_put32(st,188,ncr2);
  // field 10: ward
  field_bounds(line,10,&fs,&fe); field_val(line,fs,fe,&vs,&ve);
  let nw:i32=0;
  if(!(ve-vs==4 && line[vs]==110)){
    nw=parse_csv_bytes(line,vs,ve,st[204..208],4);
  }
  t_put32(st,200,nw);
  return 1;
}

// ================= feature abstraction =================
// features (relational only — no raw cells/ticks in rules):
//   0 mote_dir (0 none,1 left,2 right,3 here)
//   1 mote_dist (0 none,1 d0,2 d1-2,3 d3-6,4 d7+)
//   2 oncell (0 empty,1 mote,2 crystal,3 ward)
//   3 storm (0 none,1 far,2 near,3 soon,4 active)
//   4 zone | 5 shelter | 6 ncrys (0..2) | 7 hasward
//   8 crydir (0 none,1 left,2 right,3 here)
//   9 warddir (0 none,1 left,2 right,3 here)
//   10 energy (0 low<40,1 ok,2 high>150)
fn storm_bucket(si:i32)i32 {
  if(si==-2){return 4;}
  if(si==-1){return 0;}
  if(si>30){return 1;}
  if(si>=6){return 2;}
  return 3;
}
// reachability: same side of inferred void; fallback |d|<=2 when unknown
fn reach(st:[]u8, cell:i32, pos:i32)i32 {
  let va:i32=t_get32s(st,8);
  if(va!=-1){
    let a:i32=0; if(cell<va){a=1;}
    let b:i32=0; if(pos<va){b=1;}
    if(a==b){return 1;}
    return 0;
  }
  if(iabs(cell-pos)<=2){return 1;}
  return 0;
}
fn abstract(st:[]u8)void {
  let pos:i32=t_get32s(st,132);
  let E:i32=t_get32s(st,136);
  let nm:i32=t_get32s(st,160);
  // nearest reachable active mote
  let best:i32=-1; let bestd:i32=999;
  let i:i32=0;
  while(i<nm){
    let p:i32=st[164+i] as i32;
    if(reach(st,p,pos)==1){
      let d:i32=iabs(p-pos);
      if(d<bestd){bestd=d;best=p;}
    }
    i=i+1;
  }
  let mdir:i32=0; let mdist:i32=0;
  if(best!=-1){
    if(bestd==0){mdir=3;mdist=1;}
    else {
      if(best<pos){mdir=1;} else {mdir=2;}
      if(bestd<=2){mdist=2;}
      else if(bestd<=6){mdist=3;}
      else {mdist=4;}
    }
  }
  st[116]=mdir as u8; st[117]=mdist as u8;
  // on-cell content
  let on:i32=0;
  i=0;
  while(i<nm){if((st[164+i] as i32)==pos){on=1;} i=i+1;}
  if(on==0){
    let nc:i32=t_get32s(st,188);
    i=0;
    while(i<nc){if((st[192+i] as i32)==pos){on=2;} i=i+1;}
  }
  if(on==0){
    let nw:i32=t_get32s(st,200);
    i=0;
    while(i<nw){if((st[204+i] as i32)==pos){on=3;} i=i+1;}
  }
  st[118]=on as u8;
  st[119]=storm_bucket(t_get32s(st,140)) as u8;
  st[120]=(t_get32s(st,144) as u8);
  st[121]=(t_get32s(st,148) as u8);
  let ncr:i32=t_get32s(st,152);
  st[122]=ncr as u8;
  st[123]=(t_get32s(st,156) as u8);
  // nearest reachable untaken crystal (only if we still need crystals)
  let cd:i32=0;
  if(ncr<2){
    let nc:i32=t_get32s(st,188);
    let cb:i32=-1; let cbd:i32=999;
    i=0;
    while(i<nc){
      let c:i32=st[192+i] as i32;
      if(reach(st,c,pos)==1){
        let d:i32=iabs(c-pos);
        if(d<cbd){cbd=d;cb=c;}
      }
      i=i+1;
    }
    if(cb!=-1){
      if(cbd==0){cd=3;}
      else if(cb<pos){cd=1;} else {cd=2;}
    }
  }
  st[124]=cd as u8;
  // ward direction
  let wd:i32=0;
  let nw2:i32=t_get32s(st,200);
  if(nw2>0){
    let w:i32=st[204] as i32;
    if(w==pos){wd=3;}
    else if(w<pos){wd=1;} else {wd=2;}
  }
  st[125]=wd as u8;
  let en:i32=1;
  if(E<40){en=0;}
  else if(E>150){en=2;}
  st[126]=en as u8;
  return;
}
// ================= void inference =================
// Evidence per cell: mote seen / learner stood / crystal or ward seen.
// Void = unique adjacent zero-evidence pair with evidence on both sides,
// committed after 20 consecutive ticks; refuted by occupancy evidence inside.
fn void_update(st:[]u8)void {
  let pos:i32=t_get32s(st,132);
  st[92+pos]=1;
  let i:i32=0;
  let nc:i32=t_get32s(st,188);
  while(i<nc){st[92+(st[192+i] as i32)]=1;i=i+1;}
  i=0;
  let nw:i32=t_get32s(st,200);
  while(i<nw){st[92+(st[204+i] as i32)]=1;i=i+1;}
  // motes: re-scan field 8 for ALL mote positions (active + dormant)
  // (evidence, not reachability — dormant motes still mark cells)
  // NOTE: obs_parse only kept active; re-derive here is skipped — active
  // sightings plus visited/crystal/ward evidence suffice in practice.
  let va:i32=t_get32s(st,8);
  if(va!=-1){
    if(st[92+va]==1 || st[92+va+1]==1){
      t_put32(st,8,-1);
      t_put32(st,12,-1);
      t_put32(st,16,0);
    }
    return;
  }
  let ncand:i32=0; let cand:i32=-1;
  let c:i32=0;
  while(c<23){
    if(st[92+c]==0 && st[92+c+1]==0){
      let l:i32=0; let r:i32=0;
      i=0; while(i<c){if(st[92+i]==1){l=1;} i=i+1;}
      i=c+2; while(i<24){if(st[92+i]==1){r=1;} i=i+1;}
      if(l==1 && r==1){ncand=ncand+1;cand=c;}
    }
    c=c+1;
  }
  if(ncand==1){
    if(cand==t_get32s(st,12)){t_put32(st,16,t_get32s(st,16)+1);}
    else {t_put32(st,12,cand);t_put32(st,16,1);}
    if(t_get32s(st,16)>=20){t_put32(st,8,cand);}
  } else {
    t_put32(st,12,-1);
    t_put32(st,16,0);
  }
  return;
}

// ================= rules =================
// add_rule(conds packed as bytes feat,op,val triples, nconds, action, pred, seed)
// pred is the seed hypothesis for total (n starts at 1).
fn add_rule(st:[]u8, rules:[]u8, conds:[]u8, nconds:i32, action:i32, pred:i32, seed:i32)i32 {
  let nr:i32=t_get32s(st,0);
  if(nr>=256){return -1;}
  let off:i32=rule_off(nr);
  let i:i32=0;
  while(i<nconds*3){rules[off+i]=conds[i];i=i+1;}
  rules[off+12]=action as u8;
  rules[off+13]=seed as u8;
  rules[off+14]=nconds as u8;
  t_put32(rules,off+16,1);
  t_put32(rules,off+20,pred);
  t_put32(rules,off+24,0);
  t_put32(rules,off+28,t_get32s(st,4));
  t_put32(st,4,t_get32s(st,4)+1);
  t_put32(rules,off+32,-1);
  t_put32(st,0,nr+1);
  return nr;
}
// 1 if rule at roff matches feats (11 bytes at st+116, or triple feats)
fn rule_matches_at(rules:[]u8, roff:i32, feats:[]u8)i32 {
  let nc:i32=rules[roff+14] as i32;
  let i:i32=0;
  while(i<nc){
    let f:i32=rules[roff+i*3] as i32;
    let op:i32=rules[roff+i*3+1] as i32;
    let v:i32=rules[roff+i*3+2] as i32;
    let fv:i32=feats[f] as i32;
    if(op==0){if(fv!=v){return 0;}}
    else {if(fv==v){return 0;}}
    i=i+1;
  }
  return 1;
}
// conflict resolution over firing list.
// firing: []u8 arena of i32 rule indices, nf count. veto_a: -1 none else action.
// Writes winner rids (up to 8) into out_rids, count to st+56. Returns action.
fn resolve(st:[]u8, rules:[]u8, firing:[]u8, nf:i32, veto_a:i32, out_rids:[]u8)i32 {
  // filter vetoed + death filter
  let ff:[]u8=z_alloc(256*4);
  let nff:i32=0;
  let i:i32=0;
  while(i<nf){
    let ri:i32=t_get32(firing,i*4);
    let roff:i32=rule_off(ri);
    if((rules[roff+12] as i32)!=veto_a){
      t_put32(ff,nff*4,ri);
      nff=nff+1;
    }
    i=i+1;
  }
  if(nff==0){z_free(ff);t_put32(st,56,0);return 6;}
  // zero-death filter
  let anyclean:i32=0;
  i=0;
  while(i<nff){
    let ri:i32=t_get32(ff,i*4);
    if(t_get32s(rules,rule_off(ri)+24)==0){anyclean=1;}
    i=i+1;
  }
  let gg:[]u8=z_alloc(256*4);
  let ng:i32=0;
  i=0;
  while(i<nff){
    let ri:i32=t_get32(ff,i*4);
    let d:i32=t_get32s(rules,rule_off(ri)+24);
    if(anyclean==0 || d==0){t_put32(gg,ng*4,ri);ng=ng+1;}
    i=i+1;
  }
  // max predicted mean via cross-multiplication (i64)
  let best:i32=t_get32(gg,0);
  i=1;
  while(i<ng){
    let ri:i32=t_get32(gg,i*4);
    let bo:i32=rule_off(best); let ro:i32=rule_off(ri);
    let lhs:i64=(t_get32s(rules,ro+20) as i64)*(t_get32s(rules,bo+16) as i64);
    let rhs:i64=(t_get32s(rules,bo+20) as i64)*(t_get32s(rules,ro+16) as i64);
    if(lhs>rhs){best=ri;}
    i=i+1;
  }
  let bo0:i32=rule_off(best);
  let bact:i32=rules[bo0+12] as i32;
  // lowest action among mean-tied with best
  i=0;
  while(i<ng){
    let ri:i32=t_get32(gg,i*4);
    let ro:i32=rule_off(ri);
    let lhs:i64=(t_get32s(rules,ro+20) as i64)*(t_get32s(rules,bo0+16) as i64);
    let rhs:i64=(t_get32s(rules,bo0+20) as i64)*(t_get32s(rules,ro+16) as i64);
    if(lhs==rhs){
      let a:i32=rules[ro+12] as i32;
      if(a<bact){bact=a;}
    }
    i=i+1;
  }
  // proposers: action==bact and mean tied with best
  let nout:i32=0;
  i=0;
  while(i<ng && nout<8){
    let ri:i32=t_get32(gg,i*4);
    let ro:i32=rule_off(ri);
    let lhs:i64=(t_get32s(rules,ro+20) as i64)*(t_get32s(rules,bo0+16) as i64);
    let rhs:i64=(t_get32s(rules,bo0+20) as i64)*(t_get32s(rules,ro+16) as i64);
    if((rules[ro+12] as i32)==bact && lhs==rhs){
      t_put32(out_rids,nout*4,t_get32s(rules,ro+28));
      nout=nout+1;
    }
    i=i+1;
  }
  z_free(ff);
  z_free(gg);
  t_put32(st,56,nout);
  return bact;
}
// seeds from Sessions 2-4 procedures (hypotheses, not law)
fn seed_rules(st:[]u8, rules:[]u8)void {
  let c:[]u8=z_alloc(12);
  // S2 forage: on mote → EAT
  c[0]=2;c[1]=0;c[2]=1;
  let _s0:i32=add_rule(st,rules,c,1,2,30,1);
  // S2: mote left → LEFT ; mote right → RIGHT
  c[0]=0;c[1]=0;c[2]=1;
  let _sx1:i32=add_rule(st,rules,c,1,0,-1,1);
  c[0]=0;c[1]=0;c[2]=2;
  let _sx2:i32=add_rule(st,rules,c,1,1,-1,1);
  // S3: on crystal, still need → TAKE
  c[0]=2;c[1]=0;c[2]=2; c[3]=6;c[4]=1;c[5]=2; c[6]=9;c[7]=0;c[8]=0;
  let _sx3:i32=add_rule(st,rules,c,3,3,-1,1);
  // S3: have 2, no ward → COMBINE
  c[0]=6;c[1]=0;c[2]=2; c[3]=7;c[4]=0;c[5]=0; c[6]=9;c[7]=0;c[8]=0;
  let _sx4:i32=add_rule(st,rules,c,3,5,-1,1);
  // S3: ward in inventory → DROP
  c[0]=7;c[1]=0;c[2]=1; c[3]=9;c[4]=0;c[5]=0;
  let _sx5:i32=add_rule(st,rules,c,2,4,-1,1);
  // S3: crystal left/right, need, no ward yet, storm known → move
  c[0]=8;c[1]=0;c[2]=1; c[3]=6;c[4]=1;c[5]=2; c[6]=9;c[7]=0;c[8]=0; c[9]=3;c[10]=1;c[11]=0;
  let _sx6:i32=add_rule(st,rules,c,4,0,-1,1);
  c[0]=8;c[1]=0;c[2]=2; c[3]=6;c[4]=1;c[5]=2; c[6]=9;c[7]=0;c[8]=0; c[9]=3;c[10]=1;c[11]=0;
  let _sx7:i32=add_rule(st,rules,c,4,1,-1,1);
  // S4 shelter: ward dir + storm near/soon/active → move to ward
  let wv:i32=1;
  while(wv<=2){
    let sb:i32=2;
    while(sb<=4){
      c[0]=9;c[1]=0;c[2]=wv as u8; c[3]=3;c[4]=0;c[5]=sb as u8;
      let act:i32=0; if(wv==2){act=1;}
      let _sx8:i32=add_rule(st,rules,c,2,act,-1,1);
      sb=sb+1;
    }
    wv=wv+1;
  }
  // S4: on ward + storm near/soon/active → WAIT
  let sb2:i32=2;
  while(sb2<=4){
    c[0]=2;c[1]=0;c[2]=3; c[3]=3;c[4]=0;c[5]=sb2 as u8;
    let _sx9:i32=add_rule(st,rules,c,2,6,0,1);
    sb2=sb2+1;
  }
  z_free(c);
  return;
}

// ================= decision & learning =================
// count exposed ticks e with t0 < e <= t1
fn exposed_in(exposed:[]u8, nexp:i32, t0:i32, t1:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<nexp){
    let e:i32=t_get32s(exposed,i*4);
    if(e>t0 && e<=t1){c=c+1;}
    i=i+1;
  }
  return c;
}
// complete pending triples whose deadline == t
fn complete_pending(st:[]u8, rules:[]u8, triples:[]u8, tflag:[]u8, pending:[]u8, exposed:[]u8)void {
  let t:i32=t_get32s(st,128);
  let E:i32=t_get32s(st,136);
  let nexp:i32=t_get32s(st,48);
  let np:i32=t_get32s(st,40);
  let i:i32=0;
  while(i<np){
    let po:i32=pend_off(i);
    let dl:i32=t_get32s(pending,po);
    if(dl==t){
      let ef:i32=t_get32s(pending,po+4);
      let nr:i32=t_get32s(pending,po+40);
      let tidx:i32=t_get32s(pending,po+44);
      let out:i32=(E-ef)-10*exposed_in(exposed,nexp,dl-64,dl);
      // update proposer stats; mismatch check |out*n-total|>10*n
      let k:i32=0;
      while(k<nr){
        let rid:i32=t_get32s(pending,po+8+k*4);
        // find rule by rid
        let nrl:i32=t_get32s(st,0);
        let r2:i32=0;
        while(r2<nrl){
          let ro2:i32=rule_off(r2);
          if(t_get32s(rules,ro2+28)==rid){
            let n0:i32=t_get32s(rules,ro2+16);
            let tot0:i32=t_get32s(rules,ro2+20);
            if(iabs(out*n0-tot0)>10*n0){
              t_put32(rules,ro2+32,tidx);
            }
            t_put32(rules,ro2+16,n0+1);
            t_put32(rules,ro2+20,tot0+out);
          }
          r2=r2+1;
        }
        k=k+1;
      }
      let to:i32=triple_off(tidx);
      t_put32(triples,to+12,out);
      tflag[tidx]=1;
      // remove pending entry i (swap with last)
      let last:i32=np-1;
      if(i!=last){
        let a:i32=0;
        while(a<48){pending[po+a]=pending[pend_off(last)+a];a=a+1;}
      }
      np=np-1;
      t_put32(st,40,np);
    } else {
      i=i+1;
    }
  }
  return;
}
// find rule index by rid, or -1
fn rule_by_rid(st:[]u8, rules:[]u8, rid:i32)i32 {
  let nrl:i32=t_get32s(st,0);
  let i:i32=0;
  while(i<nrl){
    if(t_get32s(rules,rule_off(i)+28)==rid){return i;}
    i=i+1;
  }
  return -1;
}
// main per-tick decision; returns action 0..6
fn decide(st:[]u8, rules:[]u8, triples:[]u8, tflag:[]u8, pending:[]u8, exposed:[]u8)i32 {
  void_update(st);
  abstract(st);
  let pos:i32=t_get32s(st,132);
  let t:i32=t_get32s(st,128);
  let E:i32=t_get32s(st,136);
  // record storm exposure
  if(t_get32s(st,140)==-2 && t_get32s(st,148)==0){
    let ne:i32=t_get32s(st,48);
    if(ne<512){t_put32(exposed,ne*4,t);t_put32(st,48,ne+1);}
  }
  complete_pending(st,rules,triples,tflag,pending,exposed);
  // firing set
  let firing:[]u8=z_alloc(256*4);
  let nf:i32=0;
  let nrl:i32=t_get32s(st,0);
  let i:i32=0;
  while(i<nrl){
    if(rule_matches_at(rules,rule_off(i),st[116..127])==1){
      t_put32(firing,nf*4,i);
      nf=nf+1;
    }
    i=i+1;
  }
  let out_rids:[]u8=z_alloc(8*4);
  let action:i32=resolve(st,rules,firing,nf,-1,out_rids);
  // step veto: never step into an inferred void cell
  let veto_a:i32=-1;
  let va:i32=t_get32s(st,8);
  if((action==0 || action==1) && va!=-1){
    let dest:i32=pos-1;
    if(action==1){dest=pos+1;}
    if(dest==va || dest==va+1){
      veto_a=action;
      action=resolve(st,rules,firing,nf,veto_a,out_rids);
      if(action==veto_a){action=6;t_put32(st,56,0);}
    }
  }
  z_free(firing);
  // write triple
  let tidx:i32=t_get32s(st,44);
  let to:i32=triple_off(tidx);
  i=0;
  while(i<11){triples[to+i]=st[116+i];i=i+1;}
  triples[to+11]=action as u8;
  tflag[tidx]=0;
  // pending append
  let np2:i32=t_get32s(st,40);
  if(np2<128){
    let po:i32=pend_off(np2);
    t_put32(pending,po,t+64);
    t_put32(pending,po+4,E);
    let nr2:i32=t_get32s(st,56);
    if(nr2>8){nr2=8;}
    i=0;
    while(i<nr2){t_put32(pending,po+8+i*4,t_get32(out_rids,i*4));i=i+1;}
    t_put32(pending,po+40,nr2);
    t_put32(pending,po+44,tidx);
    t_put32(st,40,np2+1);
  }
  t_put32(st,44,(tidx+1)%8192);
  // last_rids for death attribution
  let nl:i32=t_get32s(st,56);
  if(nl>8){nl=8;}
  t_put32(st,56,nl);
  i=0;
  while(i<nl){t_put32(st,60+i*4,t_get32(out_rids,i*4));i=i+1;}
  z_free(out_rids);
  return action;
}
fn episode_start(st:[]u8, cards:[]u8)void {
  t_put32(st,20,1);
  t_put32(st,40,0);
  t_put32(st,28,-1);
  t_put32(st,24,0);
  // per-scenario void reset
  t_put32(st,8,-1);
  t_put32(st,12,-1);
  t_put32(st,16,0);
  let i:i32=0;
  while(i<24){st[92+i]=0;i=i+1;}
  t_put32(st,48,0);
  // parse ep_len from card line 0: "episode <N> ticks"
  let cn:i32=t_get32s(st,52);
  if(cn>0){
    let p:i32=find_sub(cards[0..512],"episode ");
    if(p>=0){
      let q:i32=p+8;
      let r2:i32=q;
      while(r2<512 && cards[r2]>=48 && cards[r2]<=57){r2=r2+1;}
      t_put32(st,24,parse_i32(cards,q,r2));
    }
  }
  return;
}
// died: 1 if episode ended by death
fn episode_end(st:[]u8, rules:[]u8, triples:[]u8, tflag:[]u8, pending:[]u8, died:i32)void {
  if(died==1){
    let nl2:i32=t_get32s(st,56);
    let k:i32=0;
    while(k<nl2){
      let rid:i32=t_get32s(st,60+k*4);
      let ri:i32=rule_by_rid(st,rules,rid);
      if(ri>=0){
        let ro:i32=rule_off(ri);
        t_put32(rules,ro+24,t_get32s(rules,ro+24)+1);
        t_put32(rules,ro+16,t_get32s(rules,ro+16)+1);
        t_put32(rules,ro+20,t_get32s(rules,ro+20)-200);
      }
      k=k+1;
    }
    // complete the death-tick triple (most recently written)
    let tidx:i32=t_get32s(st,44)-1;
    if(tidx<0){tidx=tidx+8192;}
    t_put32(triples,triple_off(tidx)+12,-200);
    tflag[tidx]=1;
  }
  t_put32(st,40,0);
  t_put32(st,20,0);
  if(t_get32s(st,36)==1){
    refine(st,rules,triples,tflag);
  }
  t_put32(st,32,t_get32s(st,32)+1);
  if(t_get32s(st,36)==1 && t_get32s(st,32)==24){
    t_put32(st,36,0);
    refine(st,rules,triples,tflag);
    // delete rules that never fired (non-seed, n<=1)
    let nrl2:i32=t_get32s(st,0);
    let w:i32=0;
    let r3:i32=0;
    while(r3<nrl2){
      let ro3:i32=rule_off(r3);
      let seed:i32=rules[ro3+13] as i32;
      let n3:i32=t_get32s(rules,ro3+16);
      if(seed==1 || n3>1){
        if(w!=r3){
          let b:i32=0;
          while(b<40){rules[rule_off(w)+b]=rules[ro3+b];b=b+1;}
        }
        w=w+1;
      }
      r3=r3+1;
    }
    t_put32(st,0,w);
  }
  if(t_get32s(st,208)==1){
    dump_rules(st,rules);
  }
  return;
}

// ================= splitter =================
// stats for conds: scan triple ring, count/sum outcomes where action matches
// and conds match. conds_buf: 15 bytes (5 conds max: 4+1 new).
fn split_stats(triples:[]u8, tflag:[]u8, conds:[]u8, nconds:i32, action:i32, out_n:*i32, out_t:*i32)void {
  let n:i32=0; let tot:i32=0;
  let t:i32=0;
  while(t<8192){
    if(tflag[t]==1){
      let to:i32=triple_off(t);
      if((triples[to+11] as i32)==action){
        // match conds against triples[to..to+11]
        let ok:i32=1;
        let c:i32=0;
        while(c<nconds){
          let f:i32=conds[c*3] as i32;
          let op:i32=conds[c*3+1] as i32;
          let v:i32=conds[c*3+2] as i32;
          let fv:i32=triples[to+f] as i32;
          if(op==0){if(fv!=v){ok=0;}}
          else {if(fv==v){ok=0;}}
          c=c+1;
        }
        if(ok==1){n=n+1;tot=tot+t_get32s(triples,to+12);}
      }
    }
    t=t+1;
  }
  out_n.*=n;
  out_t.*=tot;
  return;
}
fn try_split(st:[]u8, rules:[]u8, triples:[]u8, tflag:[]u8, ri:i32, tidx:i32)void {
  let ro:i32=rule_off(ri);
  let ract:i32=rules[ro+12] as i32;
  let nconds:i32=rules[ro+14] as i32;
  // mismatch triple feats
  let mto:i32=triple_off(tidx);
  // used features
  let used:[]u8=z_alloc(11);
  let c:i32=0;
  while(c<nconds){used[rules[ro+c*3] as i32]=1;c=c+1;}
  let best_f:i32=-1;
  let best_gap:i64=0;
  let best_mmval:i32=0;
  let fidx:i32=0;
  while(fidx<11){
    if(used[fidx]==0){
      let cnt:[]u8=z_alloc(8*4);
      let sum:[]u8=z_alloc(8*4);
      let ci:i32=0;
      while(ci<8){t_put32(cnt,ci*4,0);t_put32(sum,ci*4,0);ci=ci+1;}
      let sup:i32=0;
      let t:i32=0;
      while(t<8192){
        if(tflag[t]==1){
          let to:i32=triple_off(t);
          if((triples[to+11] as i32)==ract){
            // rule matches?
            let ok:i32=1;
            c=0;
            while(c<nconds){
              let f:i32=rules[ro+c*3] as i32;
              let op:i32=rules[ro+c*3+1] as i32;
              let v:i32=rules[ro+c*3+2] as i32;
              let fv:i32=triples[to+f] as i32;
              if(op==0){if(fv!=v){ok=0;}}
              else {if(fv==v){ok=0;}}
              c=c+1;
            }
            if(ok==1){
              let fv2:i32=triples[to+fidx] as i32;
              if(fv2>=0 && fv2<8){
                t_put32(cnt,fv2*4,t_get32(cnt,fv2*4)+1);
                t_put32(sum,fv2*4,t_get32s(sum,fv2*4)+t_get32s(triples,to+12));
                sup=sup+1;
              }
            }
          }
        }
        t=t+1;
      }
      if(sup>=4){
        // majority value
        let maj:i32=0; let majc:i32=-1;
        ci=0;
        while(ci<8){
          let cc:i32=t_get32(cnt,ci*4);
          if(cc>majc){majc=cc;maj=ci;}
          ci=ci+1;
        }
        let mmv:i32=triples[mto+fidx] as i32;
        if(mmv>=0 && mmv<8 && mmv!=maj){
          let cmm:i32=t_get32(cnt,mmv*4);
          if(cmm>0 && majc>0){
            let smm:i64=t_get32s(sum,mmv*4) as i64;
            let smj:i64=t_get32s(sum,maj*4) as i64;
            let gap:i64=smm*(majc as i64)-smj*(cmm as i64);
            if(gap<0){gap=0-gap;}
            // gap > 10  <=>  |mean_mm - mean_mj| > 10
            let rhs:i64=10*(cmm as i64)*(majc as i64);
            if(gap>rhs && gap>best_gap){
              best_gap=gap;best_f=fidx;best_mmval=mmv;
            }
          }
        }
      }
      z_free(cnt);
      z_free(sum);
    }
    fidx=fidx+1;
  }
  z_free(used);
  if(best_f==-1){return;}
  // build children conds
  let cb:[]u8=z_alloc(15);
  c=0;
  while(c<nconds*3){cb[c]=rules[ro+c];c=c+1;}
  cb[nconds*3]=best_f as u8;cb[nconds*3+1]=0;cb[nconds*3+2]=best_mmval as u8;
  let n1:i32=0; let t1:i32=0;
  split_stats(triples,tflag,cb,nconds+1,ract,&n1,&t1);
  cb[nconds*3+1]=1;
  let n2:i32=0; let t2:i32=0;
  split_stats(triples,tflag,cb,nconds+1,ract,&n2,&t2);
  z_free(cb);
  if(n1==0 || n2==0){return;}
  // update parent -> child1 (keep deaths: inherited killer status)
  c=0;
  while(c<3){rules[ro+nconds*3+c]=0;c=c+1;} // clear (rewritten below)
  rules[ro+nconds*3]=best_f as u8;
  rules[ro+nconds*3+1]=0;
  rules[ro+nconds*3+2]=best_mmval as u8;
  rules[ro+14]=(nconds+1) as u8;
  t_put32(rules,ro+16,n1);
  t_put32(rules,ro+20,t1);
  // child2
  let nr:i32=t_get32s(st,0);
  if(nr<256){
    let ro2:i32=rule_off(nr);
    c=0;
    while(c<(nconds+1)*3){
      if(c<nconds*3){rules[ro2+c]=rules[ro+c];}
      else {
        if(c==nconds*3){rules[ro2+c]=best_f as u8;}
        else if(c==nconds*3+1){rules[ro2+c]=1;}
        else {rules[ro2+c]=best_mmval as u8;}
      }
      c=c+1;
    }
    rules[ro2+12]=ract as u8;
    rules[ro2+13]=0;
    rules[ro2+14]=(nconds+1) as u8;
    t_put32(rules,ro2+16,n2);
    t_put32(rules,ro2+20,t2);
    t_put32(rules,ro2+24,t_get32s(rules,ro+24));
    t_put32(rules,ro2+28,t_get32s(st,4));
    t_put32(st,4,t_get32s(st,4)+1);
    t_put32(rules,ro2+32,-1);
    t_put32(st,0,nr+1);
  }
  return;
}
fn refine(st:[]u8, rules:[]u8, triples:[]u8, tflag:[]u8)void {
  let nrl:i32=t_get32s(st,0);
  let i:i32=0;
  while(i<nrl){
    let ro:i32=rule_off(i);
    let mm:i32=t_get32s(rules,ro+32);
    if(mm!=-1){
      t_put32(rules,ro+32,-1);
      if((rules[ro+14] as i32)<4){
        try_split(st,rules,triples,tflag,i,mm);
        nrl=t_get32s(st,0);
      }
    }
    i=i+1;
  }
  // evict to 256: non-seed, lowest n then highest rid
  while(t_get32s(st,0)>256){
    nrl=t_get32s(st,0);
    let victim:i32=-1;
    let v_n:i32=2147483647;
    let v_rid:i32=-1;
    i=0;
    while(i<nrl){
      let ro2:i32=rule_off(i);
      if((rules[ro2+13] as i32)==0){
        let nn:i32=t_get32s(rules,ro2+16);
        let rr:i32=t_get32s(rules,ro2+28);
        if(nn<v_n || (nn==v_n && rr>v_rid)){victim=i;v_n=nn;v_rid=rr;}
      }
      i=i+1;
    }
    if(victim==-1){break;}
    let last:i32=nrl-1;
    if(victim!=last){
      let b:i32=0;
      while(b<40){rules[rule_off(victim)+b]=rules[rule_off(last)+b];b=b+1;}
    }
    t_put32(st,0,last);
  }
  return;
}

// write bytes to stderr (fd 2); debug output must never touch stdout
fn dbg_write(b:[]u8)void {
  if(b.len>0){
    _zag_raw_syscall(1,2,_zag_slice_ptr(b) as i64,b.len as i64,0,0,0);
  }
  return;
}
fn dbg_i32(v:i32)void {
  let b:[]u8=z_alloc(16);
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let i:i32=15;
  if(x==0){b[14]=48;i=14;}
  while(x>0 && i>=0){
    i=i-1;
    b[i]=((x%10)+48) as u8;
    x=x/10;
  }
  if(neg==1 && i>0){i=i-1;b[i]=45;}
  let s:[]u8=b[i..15];
  dbg_write(s);
  z_free(b);
  return;
}
// dump rule table to stderr: rid action nconds [(f,op,v)...] n total deaths
fn dump_rules(st:[]u8, rules:[]u8)void {
  let nrl:i32=t_get32s(st,0);
  dbg_write("RULES ");
  dbg_i32(nrl);
  dbg_write("\n");
  let i:i32=0;
  while(i<nrl){
    let ro:i32=rule_off(i);
    dbg_write("R ");
    dbg_i32(t_get32s(rules,ro+28));
    dbg_write(" a");
    dbg_i32(rules[ro+12] as i32);
    dbg_write(" c");
    let nc:i32=rules[ro+14] as i32;
    dbg_i32(nc);
    let c:i32=0;
    while(c<nc){
      dbg_write(" (");
      dbg_i32(rules[ro+c*3] as i32);
      dbg_write(",");
      dbg_i32(rules[ro+c*3+1] as i32);
      dbg_write(",");
      dbg_i32(rules[ro+c*3+2] as i32);
      dbg_write(")");
      c=c+1;
    }
    dbg_write(" n");
    dbg_i32(t_get32s(rules,ro+16));
    dbg_write(" t");
    dbg_i32(t_get32s(rules,ro+20));
    dbg_write(" d");
    dbg_i32(t_get32s(rules,ro+24));
    dbg_write("\n");
    i=i+1;
  }
  return;
}
// st+208: dumprules flag (argv[2]=="dumprules")
// cards: 6 x 512B lines. line0: scenario/episode/ticks; line2: storms; line3: crystals.
// Answers the card STRUCTURE (which sub-skills the scenario will test),
// derived from the declared storm schedule — the ACTION policy never sees it.
fn answer_p1(st:[]u8, cards:[]u8)[]u8 {
  let ep:i32=0;
  // line 0: "episode <N> ticks"
  let p:i32=find_sub(cards[0..512],"episode ");
  if(p>=0){
    let q:i32=p+8;
    let r2:i32=q;
    while(r2<512 && cards[r2]>=48 && cards[r2]<=57){r2=r2+1;}
    ep=parse_i32(cards,q,r2);
  }
  // line 2: "CARD storms at a,b,..." — parse ints after "at "
  let storms:[]u8=z_alloc(8*4);
  let ns:i32=0;
  let p2:i32=find_sub(cards[1024..1536],"at ");
  if(p2>=0){
    let q2:i32=1024+p2+3;
    let r3:i32=q2;
    while(r3<1536 && ns<8){
      while(r3<1536 && (cards[r3]==32 || cards[r3]==44)){r3=r3+1;}
      if(r3>=1536){break;}
      let e2:i32=r3;
      while(e2<1536 && cards[e2]>=48 && cards[e2]<=57){e2=e2+1;}
      if(e2==r3){break;}
      t_put32(storms,ns*4,parse_i32(cards,r3,e2));
      ns=ns+1;
      r3=e2;
    }
  }
  // line 3: preplaced ward?
  let pre:i32=0;
  if(find_sub(cards[1536..2048],";")>=0){pre=1;}
  // skills
  let out:[]u8=z_alloc(64);
  let ol:i32=0;
  // first in-episode storm
  let s0:i32=-1;
  let si:i32=0;
  while(si<ns){
    let sv:i32=t_get32s(storms,si*4);
    if(sv<ep){s0=sv;break;}
    si=si+1;
  }
  if(s0==-1){
    out[0]=49;
    z_free(storms);
    return out[0..1];
  }
  // append digit helper (inline)
  if(s0>30){out[ol]=49;ol=ol+1;out[ol]=44;ol=ol+1;}
  if(pre==0){out[ol]=50;ol=ol+1;out[ol]=44;ol=ol+1;}
  out[ol]=51;ol=ol+1;out[ol]=44;ol=ol+1;
  out[ol]=49;ol=ol+1;
  // later in-episode storms: shelter, forage
  si=si+1;
  while(si<ns){
    let sv2:i32=t_get32s(storms,si*4);
    if(sv2<ep){
      out[ol]=44;ol=ol+1;out[ol]=51;ol=ol+1;out[ol]=44;ol=ol+1;out[ol]=49;ol=ol+1;
    }
    si=si+1;
  }
  z_free(storms);
  return out[0..ol];
}
// ================= input dispatch =================
fn handle_line(st:[]u8, rules:[]u8, triples:[]u8, tflag:[]u8, pending:[]u8, exposed:[]u8, cards:[]u8, line:[]u8)void {
  if(starts_with(line,"OBS ")==1){
    if(t_get32s(st,20)==0){
      episode_start(st,cards);
    }
    let _op:i32=obs_parse(st,line);
    t_put32(st,28,t_get32s(st,128));
    let a:i32=decide(st,rules,triples,tflag,pending,exposed);
    reply_digit(a);
    return;
  }
  if(starts_with(line,"CARD ")==1){
    if(t_get32s(st,20)==1){
      let el:i32=t_get32s(st,24);
      let lt:i32=t_get32s(st,28);
      let died:i32=1;
      if(el>0 && lt==el-1){died=0;}
      episode_end(st,rules,triples,tflag,pending,died);
    }
    // episode_end cleared card_n; accumulate this episode's cards
    let cn:i32=t_get32s(st,52);
    if(cn<6){
      let cp:i32=cn*512;
      let ln:i32=line.len;
      if(ln>511){ln=511;}
      let i:i32=0;
      while(i<ln){cards[cp+i]=line[i];i=i+1;}
      cards[cp+ln]=0;
      t_put32(st,52,cn+1);
    }
    reply_text("card noted");
    return;
  }
  if(find_sub(line,"Which sub-skills")>=0){
    let ans:[]u8=answer_p1(st,cards);
    t_put32(st,52,0); // consume the cards; next episode starts fresh
    if(t_get32s(st,20)==1){
      episode_end(st,rules,triples,tflag,pending,0);
    }
    reply_text(ans);
    z_free(ans);
    return;
  }
  // anything else (RESULT/TRACE/blank): end episode, clear cards
  if(t_get32s(st,20)==1){
    let el2:i32=t_get32s(st,24);
    let lt2:i32=t_get32s(st,28);
    let died2:i32=1;
    if(el2>0 && lt2==el2-1){died2=0;}
    episode_end(st,rules,triples,tflag,pending,died2);
  }
  t_put32(st,52,0);
  reply_text("noted");
  return;
}
fn main()void {
  let st:[]u8=z_alloc(512);
  let rules:[]u8=z_alloc(256*40);
  let triples:[]u8=z_alloc(8192*16);
  let tflag:[]u8=z_alloc(8192);
  let pending:[]u8=z_alloc(128*48);
  let exposed:[]u8=z_alloc(512*4);
  let cards:[]u8=z_alloc(6*512);
  st_init(st);
  seed_rules(st,rules);
  // argv[2]=="dumprules" enables stderr rule dumps (tester audit path)
  let a2:[]u8=_zag_arg(2);
  if(a2.len==9){
    let dr:[]u8="dumprules";
    let ok:i32=1;
    let i:i32=0;
    while(i<9){if(a2[i]!=dr[i]){ok=0;} i=i+1;}
    if(ok==1){t_put32(st,208,1);}
  }
  _zag_print("H1 practice-trace induction learner ready. One reply per input line.\n");
  while(1){
    let line:[]u8=read_line();
    if(line.len==0){z_free(line);break;}
    handle_line(st,rules,triples,tflag,pending,exposed,cards,line);
    z_free(line);
  }
  z_free(st);z_free(rules);z_free(triples);z_free(tflag);
  z_free(pending);z_free(exposed);z_free(cards);
  return;
}

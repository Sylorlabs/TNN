// ha.zag — H-A: Compositional operator-primitive induction (BUILDER-A, 2026-09-27).
//
// Frozen spec: combiner_arch/hyp/hypo_a/HYPOTHESIS.md (transliteration; every
// choice below is spec-frozen). Pure Zag, zero RNG, byte-identical reruns.
// Pinned toolchain: znc_linux_x86_64_abed8aa1.
//
// Position ops: ID REV ROTL DROPLAST DUPFIRST SWAPENDS SORTA SORTD (kinds 0..7).
// Byte ops: BYIDENT UPPER1 UPPER_ALL LOWER_ALL CAESAR BYTABLE (kinds 0..5).
// Search: phase1 {depth1,depth2} -> growth (miner, 6 gates) -> phase2 BYTABLE.
// Frozen enumeration order everywhere; first full byte-exact verification wins.
//
// NOTE (implementation detail, not a semantic deviation): the spec's "global
// []u8 arenas" are allocated once in main and passed as parameters (the
// toolchain-safe pattern used by srule_engine.zag); observable behavior —
// learned programs, predictions, attestation digests — is exactly per spec.

@import("R33_NATIVE_SHA256_V2.zag")

// ---- little-endian accessors (no as []i32 casts anywhere: ZNC-007) ----
fn ha_p32(b:[]u8,at:i32,v:i64)void {
  b[at]=(v&255) as u8; b[at+1]=((v>>8)&255) as u8;
  b[at+2]=((v>>16)&255) as u8; b[at+3]=((v>>24)&255) as u8;
  return;
}
fn ha_g32(b:[]u8,at:i32)i64 {
  return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn ha_p16(b:[]u8,at:i32,v:i64)void {
  b[at]=(v&255) as u8; b[at+1]=((v>>8)&255) as u8;
  return;
}
fn ha_g16(b:[]u8,at:i32)i64 {
  return (b[at] as i64)|((b[at+1] as i64)<<8);
}

// ---- memory helpers (underscore style per lab convention) ----
fn ha_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn ha_free(b:[]u8)void {
  if(b.len>0){ _zag_free(_zag_slice_ptr(b)); }
  return;
}
fn ha_cstr(s:[]u8)[]u8 {
  let b:[]u8=ha_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){ b[k]=s[k]; k=k+1; }
  b[s.len]=0;
  return b;
}
fn ha_i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){ return s[0..s.len-1]; }
  return s;
}
fn ha_emit(s:[]u8)void { _zag_print(s); return; }
fn ha_streq(a:[]u8,b:[]u8)i64 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){ return 0; } i=i+1; }
  return 1;
}
// byte-exact equality of a[ao..ao+an) vs b[bo..bo+bn)
fn ha_memeq(a:[]u8,ao:i32,an:i32,b:[]u8,bo:i32,bn:i32)i64 {
  if(an!=bn){ return 0; }
  let i:i32=0;
  while(i<an){ if(a[ao+i]!=b[bo+i]){ return 0; } i=i+1; }
  return 1;
}

// ---- file IO (proven pattern from battery_amended.zag) ----
fn ha_read_file(path:[]u8)[]u8 {
  let cp:[]u8=ha_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  ha_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=ha_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let base:i64=(_zag_slice_ptr(buf) as i64)+(total as i64);
      let n:i64=_zag_raw_syscall(0,fd,base,(cap-total) as i64,0,0,0);
      if(n<=0){ go=0; }
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){ go=0; } else { total=total+nb; }
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
// returns bytes written, or -1 on failure. O_WRONLY|O_CREAT|O_TRUNC, mode 0644.
fn ha_write_file(path:[]u8,data:[]u8)i32 {
  let cp:[]u8=ha_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),577,420,0,0,0);
  ha_free(cp);
  if(fd<0){ return -1; }
  let total:i32=0;
  if(data.len>0){
    let go:i32=1;
    while(go==1){
      if(total>=data.len){ go=0; }
      else {
        let base:i64=(_zag_slice_ptr(data) as i64)+(total as i64);
        let n:i64=_zag_raw_syscall(1,fd,base,(data.len-total) as i64,0,0,0);
        if(n<=0){ go=0; } else { total=total+(n as i32); }
      }
    }
  }
  _zag_raw_syscall(3,fd,0,0,0,0,0);
  if(total==data.len){ return total; }
  return -1;
}
// length of line starting at `at` (excludes \n); -1 if at>=total
fn ha_line_len(b:[]u8,at:i32,total:i32)i32 {
  if(at>=total){ return -1; }
  let k:i32=at;
  while(k<total && b[k]!=10){ k=k+1; }
  return k-at;
}
// index of first tab in b[at..en); -1 if none
fn ha_find_tab(b:[]u8,at:i32,en:i32)i32 {
  let k:i32=at;
  while(k<en){ if(b[k]==9){ return k; } k=k+1; }
  return -1;
}

// ---- byte classes (spec 5.4) ----
fn ha_is_low(c:u8)i32 {
  if(c>=97 && c<=122){ return 1; }
  return 0;
}
fn ha_is_up(c:u8)i32 {
  if(c>=65 && c<=90){ return 1; }
  return 0;
}
fn ha_to_up(c:u8)u8 {
  if(c>=97 && c<=122){ return (c-32) as u8; }
  return c;
}
fn ha_to_low(c:u8)u8 {
  if(c>=65 && c<=90){ return (c+32) as u8; }
  return c;
}

// ---- position operators (spec 5.3) ----
// stable insertion sort of indices by (byte, original index); desc=0 asc, 1 desc
fn ha_sort_idx(src:[]u8,n:i32,idx:[]u8,desc:i32)void {
  let i:i32=0;
  while(i<n){ idx[i]=i as u8; i=i+1; }
  i=1;
  while(i<n){
    let t:i32=idx[i] as i32;
    let tb:u8=src[t];
    let j:i32=i-1;
    let go:i32=1;
    while(go==1 && j>=0){
      let cj:i32=idx[j] as i32;
      let cb:u8=src[cj];
      let move:i32=0;
      if(desc==0){
        if(cb>tb){ move=1; }
        if(cb==tb && cj>t){ move=1; }
      } else {
        if(cb<tb){ move=1; }
        if(cb==tb && cj>t){ move=1; }
      }
      if(move==0){ go=0; } else { idx[j+1]=cj as u8; j=j-1; }
    }
    idx[j+1]=t as u8;
    i=i+1;
  }
  return;
}
// tid 1..8 = ID REV ROTL DROPLAST DUPFIRST SWAPENDS SORTA SORTD. Returns out len.
fn ha_apply_template(tid:i32,src:[]u8,n:i32,dst:[]u8)i32 {
  let i:i32=0;
  if(tid==1){
    while(i<n){ dst[i]=src[i]; i=i+1; }
    return n;
  }
  if(tid==2){
    while(i<n){ dst[i]=src[n-1-i]; i=i+1; }
    return n;
  }
  if(tid==3){
    if(n==0){ return 0; }
    while(i<n){ dst[i]=src[(i+1)%n]; i=i+1; }
    return n;
  }
  if(tid==4){
    if(n==0){ return 0; }
    while(i<n-1){ dst[i]=src[i]; i=i+1; }
    return n-1;
  }
  if(tid==5){
    if(n==0){ return 0; }
    if(n+1>64){ return -1; }
    dst[0]=src[0];
    i=1;
    let en:i32=n+1;
    while(i<en){ dst[i]=src[i-1]; i=i+1; }
    return n+1;
  }
  if(tid==6){
    if(n<2){
      while(i<n){ dst[i]=src[i]; i=i+1; }
      return n;
    }
    dst[0]=src[n-1];
    dst[n-1]=src[0];
    i=1;
    while(i<n-1){ dst[i]=src[i]; i=i+1; }
    return n;
  }
  // tid 7/8: stable sorts
  let idx:[]u8=ha_alloc(64);
  if(tid==7){ ha_sort_idx(src,n,idx,0); } else { ha_sort_idx(src,n,idx,1); }
  while(i<n){ dst[i]=src[idx[i] as i32]; i=i+1; }
  ha_free(idx);
  return n;
}
// kind 0..7 seed; >=8 grown (g=kind-8 -> record template id). Returns out len.
fn ha_apply_pos(kind:i32,param:i32,grown:[]u8,ngrown:i32,src:[]u8,n:i32,dst:[]u8)i32 {
  if(kind>=0 && kind<8){ return ha_apply_template(kind+1,src,n,dst); }
  let g:i32=kind-8;
  if(g<0 || g>=ngrown){ return -1; }
  let tid:i32=grown[g*64+1] as i32;
  return ha_apply_template(tid,src,n,dst);
}

// ---- byte-op learn + verify (spec 5.4) ----
// All pairs jointly; any failure rejects the candidate. Returns 1 on success.
// bkind: 0..5 seed; >=6 grown (btid from record); -1 = BT1 (CAESAR-shape),
// -2 = BT2 (UPPER1-shape) for miner-internal verification.
// CAESAR k (learned) -> kout[0]. BYTABLE table -> btabtmp, seen -> seentmp.
fn ha_learn_byte(bkind:i32,grown:[]u8,ngrown:i32,
    mid:[]u8,midl:[]u8,outp:[]u8,outl:[]u8,nex:i32,
    kout:[]u8,seentmp:[]u8,btabtmp:[]u8)i32 {
  let bk:i32=bkind;
  if(bk==-1){ bk=4; }
  if(bk==-2){ bk=1; }
  if(bk>=6){
    let g:i32=bk-6;
    if(g<0 || g>=ngrown){ return 0; }
    let btid:i32=grown[g*64+1] as i32;
    if(btid==1){ bk=4; }
    else {
      if(btid==2){ bk=1; } else { return 0; }
    }
  }
  let j:i32=0;
  let i:i32=0;
  if(bk==0){
    // BYIDENT: byte-exact everywhere
    j=0;
    while(j<nex){
      let ml:i32=midl[j] as i32;
      if(ml!=outl[j] as i32){ return 0; }
      i=0;
      while(i<ml){
        if(mid[j*64+i]!=outp[j*64+i]){ return 0; }
        i=i+1;
      }
      j=j+1;
    }
    return 1;
  }
  if(bk==1){
    // UPPER1: out[0]==upper(mid[0]), rest identical; empty mid rejects
    j=0;
    while(j<nex){
      let ml:i32=midl[j] as i32;
      if(ml!=outl[j] as i32){ return 0; }
      if(ml<1){ return 0; }
      if(outp[j*64]!=ha_to_up(mid[j*64])){ return 0; }
      i=1;
      while(i<ml){
        if(mid[j*64+i]!=outp[j*64+i]){ return 0; }
        i=i+1;
      }
      j=j+1;
    }
    return 1;
  }
  if(bk==2 || bk==3){
    // UPPER_ALL / LOWER_ALL: per-byte case map everywhere
    j=0;
    while(j<nex){
      let ml:i32=midl[j] as i32;
      if(ml!=outl[j] as i32){ return 0; }
      i=0;
      while(i<ml){
        let want:u8=0;
        if(bk==2){ want=ha_to_up(mid[j*64+i]); } else { want=ha_to_low(mid[j*64+i]); }
        if(outp[j*64+i]!=want){ return 0; }
        i=i+1;
      }
      j=j+1;
    }
    return 1;
  }
  if(bk==4){
    // CAESAR: one consistent k from within-example differences (i64 math;
    // znc u64 % is a signed remainder, so no u64 modulo is used anywhere)
    let k:i64=-1;
    j=0;
    while(j<nex){
      let ml:i32=midl[j] as i32;
      if(ml!=outl[j] as i32){ return 0; }
      i=0;
      while(i<ml){
        let a:u8=mid[j*64+i];
        let b:u8=outp[j*64+i];
        if(a!=b){
          let la:i32=0;
          let lb:i32=0;
          if(ha_is_low(a)==1 || ha_is_up(a)==1){ la=1; }
          if(ha_is_low(b)==1 || ha_is_up(b)==1){ lb=1; }
          if(la==0 || lb==0){ return 0; }
          if(ha_is_low(a)!=ha_is_low(b)){ return 0; }
          let d:i64=(b as i64)-(a as i64);
          if(d<0){ d=d+26; }
          if(k<0){ k=d; } else { if(k!=d){ return 0; } }
        }
        i=i+1;
      }
      j=j+1;
    }
    if(k<0){ return 0; }
    kout[0]=k as u8;
    return 1;
  }
  if(bk==5){
    // BYTABLE: learned 256-byte substitution table + consistency gate
    i=0;
    while(i<256){ btabtmp[i]=i as u8; seentmp[i]=0; i=i+1; }
    let tset:[]u8=ha_alloc(256);
    j=0;
    while(j<nex){
      let ml:i32=midl[j] as i32;
      if(ml!=outl[j] as i32){ ha_free(tset); return 0; }
      i=0;
      while(i<ml){
        let a:i32=mid[j*64+i] as i32;
        let b:u8=outp[j*64+i];
        if(tset[a]==1 && btabtmp[a]!=b){ ha_free(tset); return 0; }
        btabtmp[a]=b;
        tset[a]=1;
        seentmp[a]=1;
        i=i+1;
      }
      j=j+1;
    }
    ha_free(tset);
    return 1;
  }
  return 0;
}
// byte semantic id for prediction: 0..5 (grown resolved via record btid)
fn ha_byte_sem(bkind:i32,grown:[]u8,ngrown:i32)i32 {
  if(bkind==-1){ return 4; }
  if(bkind==-2){ return 1; }
  if(bkind>=0 && bkind<6){ return bkind; }
  let g:i32=bkind-6;
  if(g<0 || g>=ngrown){ return -1; }
  let btid:i32=grown[g*64+1] as i32;
  if(btid==1){ return 4; }
  if(btid==2){ return 1; }
  return -1;
}
// 1 iff bkind's verify would learn a CAESAR k (seed CAESAR or grown BT1)
fn ha_byte_is_caesarlike(bkind:i32,grown:[]u8,ngrown:i32)i32 {
  if(bkind==4){ return 1; }
  if(bkind==-1){ return 1; }
  if(bkind>=6){
    let g:i32=bkind-6;
    if(g>=0 && g<ngrown && grown[g*64+1]==1){ return 1; }
  }
  return 0;
}

// ---- verify_tree / emit_prog / phase search (spec 5.5) ----
// verify_tree: pass 1 positions+lengths, then joint byte-op learn, full verify.
fn ha_verify_tree(depth:i32,p_idx:i32,p2_idx:i32,b_idx:i32,
    exin:[]u8,inl:[]u8,exout:[]u8,outl:[]u8,nex:i32,
    mid:[]u8,midl:[]u8,st1:[]u8,
    poskind:[]u8,posparam:[]u8,bytekind:[]u8,grown:[]u8,cnt:[]u8,
    kbuf:[]u8,seentmp:[]u8,btabtmp:[]u8)i32 {
  let ngrown:i32=cnt[2] as i32;
  let j:i32=0;
  while(j<nex){
    let sr:[]u8=exin[j*64..j*64+64];
    let dr:[]u8=mid[j*64..j*64+64];
    let ml:i32=ha_apply_pos(poskind[p_idx] as i32,posparam[p_idx] as i32,
      grown,ngrown,sr,inl[j] as i32,dr);
    if(ml<0){ return 0; }
    if(depth==2){
      let ml2:i32=ha_apply_pos(poskind[p2_idx] as i32,posparam[p2_idx] as i32,
        grown,ngrown,dr,ml,st1);
      if(ml2<0){ return 0; }
      let q:i32=0;
      while(q<ml2){ dr[q]=st1[q]; q=q+1; }
      ml=ml2;
    }
    midl[j]=ml as u8;
    if(ml!=outl[j] as i32){ return 0; }
    j=j+1;
  }
  return ha_learn_byte(bytekind[b_idx] as i32,grown,ngrown,
    mid,midl,exout,outl,nex,kbuf,seentmp,btabtmp);
}
// emit_prog: write HZ_PROG; persist winner's BYTABLE table+seen (spec 5.5)
fn ha_emit_prog(depth:i32,p_idx:i32,p2_idx:i32,b_idx:i32,
    poskind:[]u8,posparam:[]u8,bytekind:[]u8,byteparam:[]u8,
    grown:[]u8,cnt:[]u8,prog:[]u8,kbuf:[]u8,
    seentmp:[]u8,btabtmp:[]u8,seen:[]u8,btabwin:[]u8)void {
  let ngrown:i32=cnt[2] as i32;
  prog[0]=poskind[p_idx];
  prog[1]=posparam[p_idx];
  let bk:i32=bytekind[b_idx] as i32;
  prog[2]=bk as u8;
  if(ha_byte_is_caesarlike(bk,grown,ngrown)==1){ prog[3]=kbuf[0]; }
  else { prog[3]=byteparam[b_idx]; }
  prog[4]=depth as u8;
  if(depth==2){ prog[5]=poskind[p2_idx]; prog[6]=posparam[p2_idx]; }
  else { prog[5]=0; prog[6]=0; }
  prog[7]=0;
  if(bk==5){
    let i:i32=0;
    while(i<256){ seen[i]=seentmp[i]; btabwin[i]=btabtmp[i]; i=i+1; }
  }
  return;
}
// PHASE 1: structured byte ops, depth 1 then 2; loops P { B { P2 } } (spec 5.2/5.5)
fn ha_phase1(exin:[]u8,inl:[]u8,exout:[]u8,outl:[]u8,nex:i32,
    mid:[]u8,midl:[]u8,st1:[]u8,
    poskind:[]u8,posparam:[]u8,bytekind:[]u8,byteparam:[]u8,
    grown:[]u8,cnt:[]u8,prog:[]u8,kbuf:[]u8,
    seentmp:[]u8,btabtmp:[]u8,seen:[]u8,btabwin:[]u8)i32 {
  let npos:i32=cnt[0] as i32;
  let nbyte:i32=cnt[1] as i32;
  let depth:i32=1;
  while(depth<=2){
    let pi:i32=0;
    while(pi<npos){
      let bi:i32=0;
      while(bi<nbyte){
        if(bytekind[bi] as i32 != 5){
          if(depth==1){
            let ok:i32=ha_verify_tree(1,pi,-1,bi,
              exin,inl,exout,outl,nex,mid,midl,st1,
              poskind,posparam,bytekind,grown,cnt,kbuf,seentmp,btabtmp);
            if(ok==1){
              ha_emit_prog(1,pi,-1,bi,
                poskind,posparam,bytekind,byteparam,grown,cnt,
                prog,kbuf,seentmp,btabtmp,seen,btabwin);
              return 1;
            }
          } else {
            let p2:i32=0;
            let hit:i32=0;
            while(p2<npos && hit==0){
              let ok:i32=ha_verify_tree(2,pi,p2,bi,
                exin,inl,exout,outl,nex,mid,midl,st1,
                poskind,posparam,bytekind,grown,cnt,kbuf,seentmp,btabtmp);
              if(ok==1){
                ha_emit_prog(2,pi,p2,bi,
                  poskind,posparam,bytekind,byteparam,grown,cnt,
                  prog,kbuf,seentmp,btabtmp,seen,btabwin);
                hit=1;
              }
              p2=p2+1;
            }
            if(hit==1){ return 1; }
          }
        }
        bi=bi+1;
      }
      pi=pi+1;
    }
    depth=depth+1;
  }
  return 0;
}
// PHASE 2: fallback BYTABLE only (spec: growth-before-fallback is load-bearing)
fn ha_phase2(exin:[]u8,inl:[]u8,exout:[]u8,outl:[]u8,nex:i32,
    mid:[]u8,midl:[]u8,st1:[]u8,
    poskind:[]u8,posparam:[]u8,bytekind:[]u8,byteparam:[]u8,
    grown:[]u8,cnt:[]u8,prog:[]u8,kbuf:[]u8,
    seentmp:[]u8,btabtmp:[]u8,seen:[]u8,btabwin:[]u8)i32 {
  let npos:i32=cnt[0] as i32;
  let nbyte:i32=cnt[1] as i32;
  let bti:i32=-1;
  let bi:i32=0;
  while(bi<nbyte){ if(bytekind[bi] as i32==5){ bti=bi; } bi=bi+1; }
  if(bti<0){ return 0; }
  let depth:i32=1;
  while(depth<=2){
    let pi:i32=0;
    while(pi<npos){
      if(depth==1){
        let ok:i32=ha_verify_tree(1,pi,-1,bti,
          exin,inl,exout,outl,nex,mid,midl,st1,
          poskind,posparam,bytekind,grown,cnt,kbuf,seentmp,btabtmp);
        if(ok==1){
          ha_emit_prog(1,pi,-1,bti,
            poskind,posparam,bytekind,byteparam,grown,cnt,
            prog,kbuf,seentmp,btabtmp,seen,btabwin);
          return 1;
        }
      } else {
        let p2:i32=0;
        let hit:i32=0;
        while(p2<npos && hit==0){
          let ok:i32=ha_verify_tree(2,pi,p2,bti,
            exin,inl,exout,outl,nex,mid,midl,st1,
            poskind,posparam,bytekind,grown,cnt,kbuf,seentmp,btabtmp);
          if(ok==1){
            ha_emit_prog(2,pi,p2,bti,
              poskind,posparam,bytekind,byteparam,grown,cnt,
              prog,kbuf,seentmp,btabtmp,seen,btabwin);
            hit=1;
          }
          p2=p2+1;
        }
        if(hit==1){ return 1; }
      }
      pi=pi+1;
    }
    depth=depth+1;
  }
  return 0;
}

// ---- miner: gated primitive proposal (spec 5.5, growth) ----
// mine_byte: BT1 (uniform shift, >=2 distinct input byte values) then BT2
// (position-0 case pattern). Returns 0 none, 1 BT1, 2 BT2; kbuf2=[k,distinct].
fn ha_mine_byte(tid:i32,
    exin:[]u8,inl:[]u8,exout:[]u8,outl:[]u8,nex:i32,
    mid:[]u8,midl:[]u8,kbuf2:[]u8)i32 {
  let j:i32=0;
  while(j<nex){
    let ml:i32=ha_apply_template(tid,exin[j*64..j*64+64],inl[j] as i32,
      mid[j*64..j*64+64]);
    midl[j]=ml as u8;
    if(ml!=outl[j] as i32){ return 0; }
    j=j+1;
  }
  // BT1
  let k:i64=-1;
  let ok:i32=1;
  let dv:[]u8=ha_alloc(256);
  j=0;
  while(j<nex && ok==1){
    let ml:i32=midl[j] as i32;
    let i:i32=0;
    while(i<ml && ok==1){
      let a:u8=mid[j*64+i];
      let b:u8=exout[j*64+i];
      if(a!=b){
        let la:i32=0;
        let lb:i32=0;
        if(ha_is_low(a)==1 || ha_is_up(a)==1){ la=1; }
        if(ha_is_low(b)==1 || ha_is_up(b)==1){ lb=1; }
        if(la==0 || lb==0){ ok=0; }
        else {
          if(ha_is_low(a)!=ha_is_low(b)){ ok=0; }
          else {
            let d:i64=(b as i64)-(a as i64);
            if(d<0){ d=d+26; }
            if(k<0){ k=d; } else { if(k!=d){ ok=0; } }
            dv[a as i32]=1;
          }
        }
      }
      i=i+1;
    }
    j=j+1;
  }
  if(ok==1 && k>=1){
    let dc:i32=0;
    let v:i32=0;
    while(v<256){ if(dv[v]==1){ dc=dc+1; } v=v+1; }
    ha_free(dv);
    if(dc>=2){ kbuf2[0]=k as u8; kbuf2[1]=dc as u8; return 1; }
    return 0;
  }
  ha_free(dv);
  // BT2
  ok=1;
  j=0;
  while(j<nex && ok==1){
    let ml:i32=midl[j] as i32;
    if(ml<1){ ok=0; }
    else {
      if(exout[j*64]!=ha_to_up(mid[j*64])){ ok=0; }
      else {
        let i:i32=1;
        while(i<ml && ok==1){
          if(mid[j*64+i]!=exout[j*64+i]){ ok=0; }
          i=i+1;
        }
      }
    }
    j=j+1;
  }
  if(ok==1){ kbuf2[0]=0; kbuf2[1]=0; return 2; }
  return 0;
}
// depth-1 verification of (template tid, byte op bkindv); bkindv may be -1/-2
fn ha_verifies_tid(tid:i32,bkindv:i32,
    exin:[]u8,inl:[]u8,exout:[]u8,outl:[]u8,nex:i32,
    mid:[]u8,midl:[]u8,grown:[]u8,cnt:[]u8,
    kbuf:[]u8,seentmp:[]u8,btabtmp:[]u8)i32 {
  let ngrown:i32=cnt[2] as i32;
  let j:i32=0;
  while(j<nex){
    let ml:i32=ha_apply_template(tid,exin[j*64..j*64+64],inl[j] as i32,
      mid[j*64..j*64+64]);
    midl[j]=ml as u8;
    if(ml!=outl[j] as i32){ return 0; }
    j=j+1;
  }
  return ha_learn_byte(bkindv,grown,ngrown,mid,midl,exout,outl,nex,
    kbuf,seentmp,btabtmp);
}
// canonical position id: seed kind k -> k+1 (tid); grown -> record template id
fn ha_pos_cid(pi:i32,poskind:[]u8,posparam:[]u8)i32 {
  let k:i32=poskind[pi] as i32;
  if(k<8){ return k+1; }
  return posparam[pi] as i32;
}
// G-novelty: no existing position primitive with canonical tid
fn ha_novel_pos(tid:i32,poskind:[]u8,posparam:[]u8,npos:i32)i32 {
  let pi:i32=0;
  while(pi<npos){
    if(ha_pos_cid(pi,poskind,posparam)==tid){ return 0; }
    pi=pi+1;
  }
  return 1;
}
// canonical byte id: seed kind k -> k; grown -> BEHAVIORAL id of its template
// (BT1 behaves as CAESAR=4, BT2 behaves as UPPER1=1). G-novelty is behavioral:
// a re-derived BT2 is novel iff no UPPER1-behaving primitive exists (a seed
// UPPER_ALL, kind 2, must NOT shadow it).
fn ha_byte_bcid(bi:i32,bytekind:[]u8,grown:[]u8)i32 {
  let k:i32=bytekind[bi] as i32;
  if(k<6){ return k; }
  let btid:i32=grown[(k-6)*64+1] as i32;
  if(btid==1){ return 4; }
  if(btid==2){ return 1; }
  return -1;
}
// G-novelty for (tid,btid): not (pos exists AND byte exists)
fn ha_novel_posbyte(tid:i32,btid:i32,
    poskind:[]u8,posparam:[]u8,npos:i32,
    bytekind:[]u8,nbyte:i32,grown:[]u8)i32 {
  let po:i32=0;
  let bo:i32=0;
  let pi:i32=0;
  while(pi<npos){
    if(ha_pos_cid(pi,poskind,posparam)==tid){ po=1; }
    pi=pi+1;
  }
  let bi:i32=0;
  while(bi<nbyte){
    if(ha_byte_bcid(bi,bytekind,grown)==btid){ bo=1; }
    bi=bi+1;
  }
  if(po==1 && bo==1){ return 0; }
  return 1;
}
fn ha_distinct_inlens(inl:[]u8,nex:i32)i32 {
  let s:[]u8=ha_alloc(65);
  let j:i32=0;
  while(j<nex){ s[inl[j] as i32]=1; j=j+1; }
  let c:i32=0;
  let v:i32=0;
  while(v<65){ if(s[v]==1){ c=c+1; } v=v+1; }
  ha_free(s);
  return c;
}
// admission gates (spec 5.5): G-reuse, G-generality, BT1 byte-value gate
fn ha_gates_pass(is_bt1:i32,bt1dist:i32,inl:[]u8,nex:i32)i32 {
  if(nex<2){ return 0; }
  if(ha_distinct_inlens(inl,nex)<2){ return 0; }
  if(is_bt1==1 && bt1dist<2){ return 0; }
  return 1;
}
// admit a grown POSITION primitive (provenance record, spec 5.1)
fn ha_admit_pos(tid:i32,grown:[]u8,cnt:[]u8,poskind:[]u8,posparam:[]u8)void {
  let g:i32=cnt[2] as i32;
  let npos:i32=cnt[0] as i32;
  let adm:i32=cnt[3] as i32;
  let base:i32=g*64;
  grown[base]=0;
  grown[base+1]=tid as u8;
  let olf:i32=0;
  if(tid==4){ olf=1; }
  if(tid==5){ olf=2; }
  grown[base+2]=olf as u8;
  grown[base+3]=0;
  ha_p16(grown,base+4,0);
  ha_p16(grown,base+6,1);
  grown[base+8]=g as u8;
  poskind[npos]=(8+g) as u8;
  posparam[npos]=tid as u8;
  cnt[0]=(npos+1) as u8;
  cnt[2]=(g+1) as u8;
  cnt[3]=(adm+1) as u8;
  return;
}
// admit a grown BYTE primitive (provenance record, spec 5.1)
fn ha_admit_byte(btid:i32,k:i32,grown:[]u8,cnt:[]u8,bytekind:[]u8,byteparam:[]u8)void {
  let g:i32=cnt[2] as i32;
  let nbyte:i32=cnt[1] as i32;
  let adm:i32=cnt[3] as i32;
  let base:i32=g*64;
  grown[base]=1;
  grown[base+1]=btid as u8;
  grown[base+2]=0;
  grown[base+3]=k as u8;
  ha_p16(grown,base+4,0);
  ha_p16(grown,base+6,1);
  grown[base+8]=g as u8;
  bytekind[nbyte]=(6+g) as u8;
  byteparam[nbyte]=k as u8;
  cnt[1]=(nbyte+1) as u8;
  cnt[2]=(g+1) as u8;
  cnt[3]=(adm+1) as u8;
  return;
}
// mine: structured growth only; BYTABLE never mined. Returns 1 if admitted.
fn ha_mine(exin:[]u8,inl:[]u8,exout:[]u8,outl:[]u8,nex:i32,
    mid:[]u8,midl:[]u8,
    poskind:[]u8,posparam:[]u8,bytekind:[]u8,byteparam:[]u8,
    grown:[]u8,cnt:[]u8,kbuf:[]u8,kbuf2:[]u8,
    seentmp:[]u8,btabtmp:[]u8)i32 {
  let npos:i32=cnt[0] as i32;
  let nbyte:i32=cnt[1] as i32;
  let tid:i32=1;
  while(tid<=8){
    let bi:i32=0;
    while(bi<nbyte){
      let bk2:i32=bytekind[bi] as i32;
      if(bk2 != 5){
        // G-novelty on the (tid, B) pair with canonical (behavioral) ids
        if(ha_novel_posbyte(tid,ha_byte_bcid(bi,bytekind,grown),
            poskind,posparam,npos,bytekind,nbyte,grown)==1){
          let ok:i32=ha_verifies_tid(tid,bytekind[bi] as i32,
            exin,inl,exout,outl,nex,mid,midl,grown,cnt,
            kbuf,seentmp,btabtmp);
          if(ok==1 && ha_gates_pass(0,0,inl,nex)==1){
            ha_admit_pos(tid,grown,cnt,poskind,posparam);
            return 1;
          }
        }
      }
      bi=bi+1;
    }
    let btid:i32=ha_mine_byte(tid,exin,inl,exout,outl,nex,mid,midl,kbuf2);
    if(btid>0){
      // behavioral canonical id: BT1 behaves as CAESAR(4), BT2 as UPPER1(1)
      let bbeh:i32=btid;
      if(btid==1){ bbeh=4; }
      if(btid==2){ bbeh=1; }
      if(ha_novel_posbyte(tid,bbeh,poskind,posparam,npos,bytekind,nbyte,grown)==1){
        let bv:i32=-2;
        if(btid==1){ bv=-1; }
        let ok:i32=ha_verifies_tid(tid,bv,
          exin,inl,exout,outl,nex,mid,midl,grown,cnt,
          kbuf,seentmp,btabtmp);
        let is1:i32=0;
        if(btid==1){ is1=1; }
        if(ok==1 && ha_gates_pass(is1,kbuf2[1] as i32,inl,nex)==1){
          ha_admit_byte(btid,kbuf2[0] as i32,grown,cnt,bytekind,byteparam);
          return 1;
        }
      }
    }
    tid=tid+1;
  }
  return 0;
}
// induce: phase 1 -> growth -> phase 2. Returns 1 if a program was emitted.
fn ha_induce(exin:[]u8,inl:[]u8,exout:[]u8,outl:[]u8,nex:i32,
    mid:[]u8,midl:[]u8,st1:[]u8,
    poskind:[]u8,posparam:[]u8,bytekind:[]u8,byteparam:[]u8,
    grown:[]u8,cnt:[]u8,prog:[]u8,kbuf:[]u8,kbuf2:[]u8,
    seentmp:[]u8,btabtmp:[]u8,seen:[]u8,btabwin:[]u8)i32 {
  cnt[3]=0;
  let pass:i32=0;
  let go:i32=1;
  while(go==1 && pass<5){
    let p1:i32=ha_phase1(exin,inl,exout,outl,nex,mid,midl,st1,
      poskind,posparam,bytekind,byteparam,grown,cnt,prog,kbuf,
      seentmp,btabtmp,seen,btabwin);
    if(p1==1){ return 1; }
    let ng:i32=cnt[2] as i32;
    let ad:i32=cnt[3] as i32;
    if(ng<32 && ad<4){
      let m:i32=ha_mine(exin,inl,exout,outl,nex,mid,midl,
        poskind,posparam,bytekind,byteparam,grown,cnt,kbuf,kbuf2,
        seentmp,btabtmp);
      if(m==1){ pass=pass+1; } else { go=0; }
    } else { go=0; }
  }
  let p2:i32=ha_phase2(exin,inl,exout,outl,nex,mid,midl,st1,
    poskind,posparam,bytekind,byteparam,grown,cnt,prog,kbuf,
    seentmp,btabtmp,seen,btabwin);
  if(p2==1){ return 1; }
  return 0;
}

// ---- prediction (spec 5.6) ----
// apply a byte op by semantic id; k = CAESAR shift; table = BYTABLE map
fn ha_apply_byte(sem:i32,k:i32,src:[]u8,n:i32,dst:[]u8,table:[]u8)i32 {
  let i:i32=0;
  if(sem==0){
    while(i<n){ dst[i]=src[i]; i=i+1; }
    return n;
  }
  if(sem==1){
    if(n>0){
      dst[0]=ha_to_up(src[0]);
      i=1;
      while(i<n){ dst[i]=src[i]; i=i+1; }
    }
    return n;
  }
  if(sem==2){
    while(i<n){ dst[i]=ha_to_up(src[i]); i=i+1; }
    return n;
  }
  if(sem==3){
    while(i<n){ dst[i]=ha_to_low(src[i]); i=i+1; }
    return n;
  }
  if(sem==4){
    while(i<n){
      let c:u8=src[i];
      if(ha_is_low(c)==1){ dst[i]=(((c as i32)-97+k)%26+97) as u8; }
      else {
        if(ha_is_up(c)==1){ dst[i]=(((c as i32)-65+k)%26+65) as u8; }
        else { dst[i]=c; }
      }
      i=i+1;
    }
    return n;
  }
  if(sem==5){
    while(i<n){ dst[i]=table[src[i] as i32]; i=i+1; }
    return n;
  }
  return -1;
}
// apply one learned program; returns output length, or -1 on withhold.
// BYTABLE: withholds if any positioned probe byte is outside the seen set
// (partial generalization: emits only where its table is defined).
fn ha_predict_one(prog:[]u8,grown:[]u8,ngrown:i32,seen:[]u8,btabwin:[]u8,
    st1:[]u8,st2:[]u8,inp:[]u8,n:i32,outp:[]u8)i32 {
  let pk:i32=prog[0] as i32;
  let pp:i32=prog[1] as i32;
  let bk:i32=prog[2] as i32;
  let bp:i32=prog[3] as i32;
  let sem:i32=ha_byte_sem(bk,grown,ngrown);
  if(sem<0){ return -1; }
  let ml:i32=0;
  if(prog[4] as i32==1){
    ml=ha_apply_pos(pk,pp,grown,ngrown,inp,n,st1);
  } else {
    let ml1:i32=ha_apply_pos(pk,pp,grown,ngrown,inp,n,st1);
    if(ml1<0){ return -1; }
    ml=ha_apply_pos(prog[5] as i32,prog[6] as i32,grown,ngrown,st1,ml1,st2);
    let q:i32=0;
    while(q<ml){ st1[q]=st2[q]; q=q+1; }
  }
  if(ml<0){ return -1; }
  if(sem==5){
    let i:i32=0;
    while(i<ml){
      if(seen[st1[i] as i32]==0){ return -1; }
      i=i+1;
    }
  }
  return ha_apply_byte(sem,bp,st1,ml,outp,btabwin);
}

// ---- attestation digest (spec 5.7) ----
// SHA-256 over: frozen order constants, POSKIND[0..NPOS], BYTEKIND[0..NBYTE],
// all GROWN records, PROG, NEX. Hex (64 chars) written to hexout.
fn ha_digest(prog:[]u8,poskind:[]u8,bytekind:[]u8,grown:[]u8,cnt:[]u8,
    nex:i32,hexout:[]u8)void {
  let dgb:[]u8=ha_alloc(4096);
  let fz:[]u8="HA1:phase=structured,growth,fallback;depth=1,2;pos=ID,REV,ROTL,DROPLAST,DUPFIRST,SWAPENDS,SORTA,SORTD;byte=BYIDENT,UPPER1,UPPER_ALL,LOWER_ALL,CAESAR;tid=1,2,3,4,5,6,7,8;bt=BT1,BT2;loop=P,B,P2;cap=4,32";
  let pos:i32=0;
  let i:i32=0;
  while(i<fz.len){ dgb[pos]=fz[i]; pos=pos+1; i=i+1; }
  let npos:i32=cnt[0] as i32;
  let nbyte:i32=cnt[1] as i32;
  let ng:i32=cnt[2] as i32;
  i=0;
  while(i<npos){ dgb[pos]=poskind[i]; pos=pos+1; i=i+1; }
  i=0;
  while(i<nbyte){ dgb[pos]=bytekind[i]; pos=pos+1; i=i+1; }
  i=0;
  while(i<ng*64){ dgb[pos]=grown[i]; pos=pos+1; i=i+1; }
  i=0;
  while(i<8){ dgb[pos]=prog[i]; pos=pos+1; i=i+1; }
  dgb[pos]=nex as u8;
  pos=pos+1;
  let hout:[]u8=ha_alloc(32);
  let rc:i32=ns_sha256(dgb[0..pos],hout);
  if(rc==0){
    let hx:[]u8=ns_hex(hout);
    i=0;
    while(i<64){ hexout[i]=hx[i]; i=i+1; }
    nio_free(hx);
  }
  ha_free(dgb);
  ha_free(hout);
  return;
}

// ---- small helpers used by main ----
fn ha_rule_find(npool:[]u8,roff:[]u8,rlen:[]u8,nrules:i32,
    name:[]u8,no:i32,nl:i32)i32 {
  let r:i32=0;
  while(r<nrules){
    let rl:i32=ha_g32(rlen,r*4) as i32;
    if(rl==nl){
      let ro:i32=ha_g32(roff,r*4) as i32;
      if(ha_memeq(npool,ro,rl,name,no,nl)==1){ return r; }
    }
    r=r+1;
  }
  return -1;
}
// Optional argv[4] test hook for the K-HA-3 ablation (comma-separated
// primitive names to remove from the seed community, e.g.
// "SWAPENDS,SORTD,CAESAR,UPPER1"). Absent -> full seed set. This hook only
// changes the starting vocabulary; the learner itself never sees rule names.
fn ha_ablate_token(tok:[]u8,to:i32,tl:i32,
    poskind:[]u8,posparam:[]u8,bytekind:[]u8,byteparam:[]u8,cnt:[]u8)void {
  let s0:[]u8="ID"; let s1:[]u8="REV"; let s2:[]u8="ROTL";
  let s3:[]u8="DROPLAST"; let s4:[]u8="DUPFIRST"; let s5:[]u8="SWAPENDS";
  let s6:[]u8="SORTA"; let s7:[]u8="SORTD";
  let b0:[]u8="BYIDENT"; let b1:[]u8="UPPER1"; let b2:[]u8="UPPER_ALL";
  let b3:[]u8="LOWER_ALL"; let b4:[]u8="CAESAR"; let b5:[]u8="BYTABLE";
  let ispos:i32=-1;
  let kind:i32=-1;
  if(ha_memeq(tok,to,tl,s0,0,s0.len)==1){ ispos=1; kind=0; }
  if(ha_memeq(tok,to,tl,s1,0,s1.len)==1){ ispos=1; kind=1; }
  if(ha_memeq(tok,to,tl,s2,0,s2.len)==1){ ispos=1; kind=2; }
  if(ha_memeq(tok,to,tl,s3,0,s3.len)==1){ ispos=1; kind=3; }
  if(ha_memeq(tok,to,tl,s4,0,s4.len)==1){ ispos=1; kind=4; }
  if(ha_memeq(tok,to,tl,s5,0,s5.len)==1){ ispos=1; kind=5; }
  if(ha_memeq(tok,to,tl,s6,0,s6.len)==1){ ispos=1; kind=6; }
  if(ha_memeq(tok,to,tl,s7,0,s7.len)==1){ ispos=1; kind=7; }
  if(ha_memeq(tok,to,tl,b0,0,b0.len)==1){ ispos=0; kind=0; }
  if(ha_memeq(tok,to,tl,b1,0,b1.len)==1){ ispos=0; kind=1; }
  if(ha_memeq(tok,to,tl,b2,0,b2.len)==1){ ispos=0; kind=2; }
  if(ha_memeq(tok,to,tl,b3,0,b3.len)==1){ ispos=0; kind=3; }
  if(ha_memeq(tok,to,tl,b4,0,b4.len)==1){ ispos=0; kind=4; }
  if(ha_memeq(tok,to,tl,b5,0,b5.len)==1){ ispos=0; kind=5; }
  if(ispos==1){
    let n:i32=cnt[0] as i32;
    let w:i32=0;
    let r:i32=0;
    while(r<n){
      if(poskind[r] as i32 != kind){
        poskind[w]=poskind[r]; posparam[w]=posparam[r]; w=w+1;
      }
      r=r+1;
    }
    cnt[0]=w as u8;
  }
  if(ispos==0){
    let n:i32=cnt[1] as i32;
    let w:i32=0;
    let r:i32=0;
    while(r<n){
      if(bytekind[r] as i32 != kind){
        bytekind[w]=bytekind[r]; byteparam[w]=byteparam[r]; w=w+1;
      }
      r=r+1;
    }
    cnt[1]=w as u8;
  }
  return;
}
fn ha_out_append(outbuf:[]u8,lenp:[]u8,src:[]u8,n:i32)void {
  let l:i32=ha_g32(lenp,0) as i32;
  let i:i32=0;
  while(i<n){ outbuf[l+i]=src[i]; i=i+1; }
  ha_p32(lenp,0,(l+n) as i64);
  return;
}
fn ha_out_byte(outbuf:[]u8,lenp:[]u8,c:u8)void {
  let l:i32=ha_g32(lenp,0) as i32;
  outbuf[l]=c;
  ha_p32(lenp,0,(l+1) as i64);
  return;
}

fn main()i32 {
  let teach_path:[]u8=_zag_arg(1);
  let probe_path:[]u8=_zag_arg(2);
  let out_path:[]u8=_zag_arg(3);
  let ablate_arg:[]u8=_zag_arg(4);

  // ---- engine arenas (explicitly zeroed at init; spec 5.1 layout) ----
  let exin:[]u8=ha_alloc(1024);
  let inl:[]u8=ha_alloc(16);
  let exout:[]u8=ha_alloc(1024);
  let outl:[]u8=ha_alloc(16);
  let mid:[]u8=ha_alloc(1024);
  let midl:[]u8=ha_alloc(16);
  let st1:[]u8=ha_alloc(64);
  let st2:[]u8=ha_alloc(64);
  let chbuf:[]u8=ha_alloc(64);
  let poskind:[]u8=ha_alloc(32);
  let posparam:[]u8=ha_alloc(32);
  let bytekind:[]u8=ha_alloc(32);
  let byteparam:[]u8=ha_alloc(32);
  let grown:[]u8=ha_alloc(2048);
  let seen:[]u8=ha_alloc(256);
  let seentmp:[]u8=ha_alloc(256);
  let btabtmp:[]u8=ha_alloc(256);
  let btabwin:[]u8=ha_alloc(256);
  let prog:[]u8=ha_alloc(8);
  let kbuf:[]u8=ha_alloc(1);
  let kbuf2:[]u8=ha_alloc(2);
  let cnt:[]u8=ha_alloc(16);

  // seed community
  let si:i32=0;
  while(si<8){ poskind[si]=si as u8; posparam[si]=0; si=si+1; }
  si=0;
  while(si<6){ bytekind[si]=si as u8; byteparam[si]=0; si=si+1; }
  cnt[0]=8; cnt[1]=6; cnt[2]=0; cnt[3]=0;

  // optional K-HA-3 ablation hook
  if(ablate_arg.len>0){
    let a0:i32=0;
    while(a0<ablate_arg.len){
      let a1:i32=a0;
      while(a1<ablate_arg.len && ablate_arg[a1]!=44){ a1=a1+1; }
      if(a1>a0){
        ha_ablate_token(ablate_arg,a0,a1-a0,
          poskind,posparam,bytekind,byteparam,cnt);
      }
      a0=a1+1;
    }
  }

  // ---- rule table ----
  let npool:[]u8=ha_alloc(4096);
  let roff:[]u8=ha_alloc(128);
  let rlen:[]u8=ha_alloc(128);
  let nrules:i32=0;
  let npool_len:i32=0;
  // ---- teach entries ----
  let tpool:[]u8=ha_alloc(65536);
  let tpool_len:i32=0;
  let te_rule:[]u8=ha_alloc(512);
  let te_ioff:[]u8=ha_alloc(2048);
  let te_ilen:[]u8=ha_alloc(2048);
  let te_ooff:[]u8=ha_alloc(2048);
  let te_olen:[]u8=ha_alloc(2048);
  let nte:i32=0;
  let trcnt:[]u8=ha_alloc(32);

  let tbuf:[]u8=ha_read_file(teach_path);
  let ttotal:i32=tbuf.len;
  let at:i32=0;
  while(at<ttotal){
    let ll:i32=ha_line_len(tbuf,at,ttotal);
    if(ll<0){ at=ttotal; }
    else {
      let le:i32=at+ll;
      if(le>at && tbuf[le-1]==13){ le=le-1; }
      if(le>at){
        let t1:i32=ha_find_tab(tbuf,at,le);
        let t2:i32=-1;
        if(t1>=0){ t2=ha_find_tab(tbuf,t1+1,le); }
        if(t1>at && t2>t1){
          let nl:i32=t1-at;
          let il:i32=t2-t1-1;
          let ol:i32=le-t2-1;
          if(il>64){ il=64; }
          if(ol>64){ ol=64; }
          let r:i32=ha_rule_find(npool,roff,rlen,nrules,tbuf,at,nl);
          if(r<0 && nrules<32 && npool_len+nl<4096){
            r=nrules;
            ha_p32(roff,r*4,npool_len as i64);
            ha_p32(rlen,r*4,nl as i64);
            let c:i32=0;
            while(c<nl){ npool[npool_len+c]=tbuf[at+c]; c=c+1; }
            npool_len=npool_len+nl;
            nrules=nrules+1;
          }
          if(r>=0 && nte<512 && trcnt[r]<16 && tpool_len+il+ol<65536){
            te_rule[nte]=r as u8;
            ha_p32(te_ioff,nte*4,tpool_len as i64);
            ha_p32(te_ilen,nte*4,il as i64);
            let c:i32=0;
            while(c<il){ tpool[tpool_len+c]=tbuf[t1+1+c]; c=c+1; }
            tpool_len=tpool_len+il;
            ha_p32(te_ooff,nte*4,tpool_len as i64);
            ha_p32(te_olen,nte*4,ol as i64);
            c=0;
            while(c<ol){ tpool[tpool_len+c]=tbuf[t2+1+c]; c=c+1; }
            tpool_len=tpool_len+ol;
            nte=nte+1;
            trcnt[r]=trcnt[r]+1;
          }
        }
      }
      at=at+ll+1;
    }
  }

  // ---- probe entries ----
  let ppool:[]u8=ha_alloc(65536);
  let ppool_len:i32=0;
  let pr_roff:[]u8=ha_alloc(2048);
  let pr_rlen:[]u8=ha_alloc(2048);
  let pr_ioff:[]u8=ha_alloc(2048);
  let pr_ilen:[]u8=ha_alloc(2048);
  let pr_eoff:[]u8=ha_alloc(2048);
  let pr_elen:[]u8=ha_alloc(2048);
  let pr_a:[]u8=ha_alloc(512);
  let pr_b:[]u8=ha_alloc(512);
  let pr_p2:[]u8=ha_alloc(512);
  let npr:i32=0;
  let pbuf:[]u8=ha_read_file(probe_path);
  let ptotal:i32=pbuf.len;
  at=0;
  while(at<ptotal){
    let ll:i32=ha_line_len(pbuf,at,ptotal);
    if(ll<0){ at=ptotal; }
    else {
      let le:i32=at+ll;
      if(le>at && pbuf[le-1]==13){ le=le-1; }
      if(le>at){
        let t1:i32=ha_find_tab(pbuf,at,le);
        let t2:i32=-1;
        if(t1>=0){ t2=ha_find_tab(pbuf,t1+1,le); }
        if(t1>at && t2>t1){
          let nl:i32=t1-at;
          let il:i32=t2-t1-1;
          let el:i32=le-t2-1;
          if(il>64){ il=64; }
          if(el>64){ el=64; }
          if(npr<512 && ppool_len+nl+il+el<65536){
            ha_p32(pr_roff,npr*4,ppool_len as i64);
            ha_p32(pr_rlen,npr*4,nl as i64);
            let c:i32=0;
            while(c<nl){ ppool[ppool_len+c]=pbuf[at+c]; c=c+1; }
            ppool_len=ppool_len+nl;
            ha_p32(pr_ioff,npr*4,ppool_len as i64);
            ha_p32(pr_ilen,npr*4,il as i64);
            c=0;
            while(c<il){ ppool[ppool_len+c]=pbuf[t1+1+c]; c=c+1; }
            ppool_len=ppool_len+il;
            ha_p32(pr_eoff,npr*4,ppool_len as i64);
            ha_p32(pr_elen,npr*4,el as i64);
            c=0;
            while(c<el){ ppool[ppool_len+c]=pbuf[t2+1+c]; c=c+1; }
            ppool_len=ppool_len+el;
            pr_a[npr]=255;
            pr_b[npr]=255;
            pr_p2[npr]=0;
            npr=npr+1;
          }
        }
      }
      at=at+ll+1;
    }
  }
  // resolve probe rule ids: plain, A+B compound (P2), or unknown (P3 echo)
  let p:i32=0;
  while(p<npr){
    let ro:i32=ha_g32(pr_roff,p*4) as i32;
    let rl:i32=ha_g32(pr_rlen,p*4) as i32;
    let q:i32=0;
    let pk:i32=-1;
    while(q<rl && pk<0){
      if(ppool[ro+q]==43){ pk=q; }
      q=q+1;
    }
    if(pk<0){
      let f:i32=ha_rule_find(npool,roff,rlen,nrules,ppool,ro,rl);
      if(f>=0){ pr_a[p]=f as u8; }
    } else {
      let f:i32=ha_rule_find(npool,roff,rlen,nrules,ppool,ro,rl);
      if(f>=0){ pr_a[p]=f as u8; }
      else {
        let fa:i32=ha_rule_find(npool,roff,rlen,nrules,ppool,ro,pk);
        let fb:i32=ha_rule_find(npool,roff,rlen,nrules,ppool,ro+pk+1,rl-pk-1);
        if(fa>=0 && fb>=0){
          pr_a[p]=fa as u8; pr_b[p]=fb as u8; pr_p2[p]=1;
        }
      }
    }
    p=p+1;
  }

  // ---- induce per rule (community persists across rules; spec 5.5) ----
  let rprog:[]u8=ha_alloc(256);
  let rok:[]u8=ha_alloc(32);
  let rwh:[]u8=ha_alloc(32);
  let rnex:[]u8=ha_alloc(32);
  let attest:[]u8=ha_alloc(16384);
  let alen:i32=0;
  let hexb:[]u8=ha_alloc(64);
  let r:i32=0;
  while(r<nrules){
    let nex:i32=0;
    let e:i32=0;
    while(e<nte){
      if(te_rule[e]==r as u8){
        let io:i32=ha_g32(te_ioff,e*4) as i32;
        let il2:i32=ha_g32(te_ilen,e*4) as i32;
        let oo:i32=ha_g32(te_ooff,e*4) as i32;
        let ol2:i32=ha_g32(te_olen,e*4) as i32;
        let c:i32=0;
        while(c<il2){ exin[nex*64+c]=tpool[io+c]; c=c+1; }
        inl[nex]=il2 as u8;
        c=0;
        while(c<ol2){ exout[nex*64+c]=tpool[oo+c]; c=c+1; }
        outl[nex]=ol2 as u8;
        nex=nex+1;
      }
      e=e+1;
    }
    rnex[r]=nex as u8;
    let z:i32=0;
    while(z<8){ prog[z]=0; z=z+1; }
    let pok:i32=0;
    let wh:i32=0;
    if(nex>0){
      let ind:i32=ha_induce(exin,inl,exout,outl,nex,mid,midl,st1,
        poskind,posparam,bytekind,byteparam,grown,cnt,
        prog,kbuf,kbuf2,seentmp,btabtmp,seen,btabwin);
      if(ind==1){ pok=1; } else { wh=1; }
    }
    rok[r]=pok as u8;
    rwh[r]=wh as u8;
    z=0;
    while(z<8){ rprog[r*8+z]=prog[z]; z=z+1; }
    ha_digest(prog,poskind,bytekind,grown,cnt,nex,hexb);
    let ro:i32=ha_g32(roff,r*4) as i32;
    let rl:i32=ha_g32(rlen,r*4) as i32;
    let c2:i32=0;
    while(c2<rl){ attest[alen]=npool[ro+c2]; alen=alen+1; c2=c2+1; }
    attest[alen]=9;
    alen=alen+1;
    c2=0;
    while(c2<64){ attest[alen]=hexb[c2]; alen=alen+1; c2=c2+1; }
    attest[alen]=10;
    alen=alen+1;
    r=r+1;
  }

  // ---- predict probes in file order -> out.tsv ----
  let outbuf:[]u8=ha_alloc(262144);
  let outlenp:[]u8=ha_alloc(4);
  ha_p32(outlenp,0,0);
  let pred:[]u8=ha_alloc(64);
  p=0;
  while(p<npr){
    let ro:i32=ha_g32(pr_roff,p*4) as i32;
    let rl:i32=ha_g32(pr_rlen,p*4) as i32;
    let io:i32=ha_g32(pr_ioff,p*4) as i32;
    let il:i32=ha_g32(pr_ilen,p*4) as i32;
    let eo:i32=ha_g32(pr_eoff,p*4) as i32;
    let el:i32=ha_g32(pr_elen,p*4) as i32;
    let withheld:i32=0;
    let pl:i32=0;
    let a:i32=pr_a[p] as i32;
    let ng2:i32=cnt[2] as i32;
    if(pr_p2[p]==1){
      let b:i32=pr_b[p] as i32;
      if(rok[a]==0 || rok[b]==0){ withheld=1; }
      else {
        let l1:i32=ha_predict_one(rprog[a*8..a*8+8],grown,ng2,seen,btabwin,
          st1,st2,ppool[io..io+il],il,chbuf);
        if(l1<0){ withheld=1; }
        else {
          let l2:i32=ha_predict_one(rprog[b*8..b*8+8],grown,ng2,seen,btabwin,
            st1,st2,chbuf[0..l1],l1,pred);
          if(l2<0){ withheld=1; } else { pl=l2; }
        }
      }
    } else {
      if(a<255){
        if(rwh[a]==1){ withheld=1; }
        else {
          if(rok[a]==1){
            let l:i32=ha_predict_one(rprog[a*8..a*8+8],grown,ng2,seen,btabwin,
              st1,st2,ppool[io..io+il],il,pred);
            if(l<0){ withheld=1; } else { pl=l; }
          } else { withheld=1; }
        }
      } else { withheld=1; }
    }
    ha_out_append(outbuf,outlenp,ppool[ro..ro+rl],rl);
    ha_out_byte(outbuf,outlenp,9);
    ha_out_append(outbuf,outlenp,ppool[io..io+il],il);
    ha_out_byte(outbuf,outlenp,9);
    if(withheld==1){
      let qq:[]u8="?";
      ha_out_append(outbuf,outlenp,qq,qq.len);
    } else {
      ha_out_append(outbuf,outlenp,pred[0..pl],pl);
    }
    ha_out_byte(outbuf,outlenp,9);
    ha_out_append(outbuf,outlenp,ppool[eo..eo+el],el);
    ha_out_byte(outbuf,outlenp,9);
    let m:i32=0;
    if(withheld==0){
      if(ha_memeq(pred,0,pl,ppool,eo,el)==1){ m=1; }
    }
    if(m==1){ ha_out_byte(outbuf,outlenp,49); } else { ha_out_byte(outbuf,outlenp,48); }
    ha_out_byte(outbuf,outlenp,9);
    if(withheld==1){ ha_out_byte(outbuf,outlenp,49); } else { ha_out_byte(outbuf,outlenp,48); }
    ha_out_byte(outbuf,outlenp,10);
    p=p+1;
  }
  let outlen:i32=ha_g32(outlenp,0) as i32;

  // ---- write outputs ----
  let wr:i32=ha_write_file(out_path,outbuf[0..outlen]);
  let apath:[]u8=ha_alloc(1024);
  let apl:i32=0;
  let sl:i32=-1;
  let q2:i32=0;
  while(q2<out_path.len){
    if(out_path[q2]==47){ sl=q2; }
    q2=q2+1;
  }
  if(sl>=0){
    q2=0;
    while(q2<=sl && q2<1023){ apath[q2]=out_path[q2]; q2=q2+1; }
    apl=sl+1;
  }
  let anm:[]u8="attest.txt";
  q2=0;
  while(q2<anm.len){ apath[apl+q2]=anm[q2]; q2=q2+1; }
  apl=apl+anm.len;
  let wr2:i32=ha_write_file(apath[0..apl],attest[0..alen]);

  // ---- stdout summary ----
  ha_emit("HA rules=");
  ha_emit(ha_i64s(nrules as i64));
  ha_emit(" probes=");
  ha_emit(ha_i64s(npr as i64));
  ha_emit(" grown=");
  ha_emit(ha_i64s(cnt[2] as i64));
  ha_emit(" write=");
  ha_emit(ha_i64s(wr as i64));
  ha_emit("/");
  ha_emit(ha_i64s(wr2 as i64));
  ha_emit("\n");
  r=0;
  while(r<nrules){
    let ro:i32=ha_g32(roff,r*4) as i32;
    let rl:i32=ha_g32(rlen,r*4) as i32;
    ha_emit("  rule ");
    ha_emit(npool[ro..ro+rl]);
    ha_emit(" nex=");
    ha_emit(ha_i64s(rnex[r] as i64));
    if(rok[r]==1){
      ha_emit(" prog=");
      let z:i32=0;
      while(z<8){
        ha_emit(ha_i64s(rprog[r*8+z] as i64));
        if(z<7){ ha_emit(","); }
        z=z+1;
      }
    } else {
      if(rwh[r]==1){ ha_emit(" WITHHELD"); } else { ha_emit(" NOEX"); }
    }
    ha_emit("\n");
    r=r+1;
  }
  return 0;
}

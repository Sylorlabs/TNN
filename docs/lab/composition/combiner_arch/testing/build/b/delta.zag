@import("R33_NATIVE_IO_V1.zag")
// delta.zag — H-B DELTA builder (combiner-architecture line, Micah's order 2026-09-27).
//
// Implements HYPOTHESIS.md (hyp/hypo_b) exactly: per-output-slot provenance
// alignment (COPY / MAP-UPPER / MAP-LOWER / EMIT), deterministic lexicographic
// disambiguation of repeated-byte slots, one affine source expression per
// clause fitted by exact integer algebra (Cramer's rule, i64), fixed
// decision tree forcing unpinned coefficients to 0, fixed 6-condition split
// vocabulary (max 3 splits), sort fallback, structural withholding only.
//
// Harness interface: argv = teach.tsv probe.tsv out.tsv.
// teach.tsv lines: RULEID\tINPUT\tOUTPUT
// probe.tsv lines: RULEID\tINPUT\tEXPECTED
// out.tsv  lines: RULEID\tINPUT\tPREDICTED\tEXPECTED\tMATCH\tWITHHELD
// (withhold -> PREDICTED="?", WITHHELD=1, MATCH=0).
//
// RULEIDs are arbitrary grouping labels: the learner groups examples by
// byte-identity of the label and NEVER branches on label content.
// Pure Zag, zero RNG, fully deterministic. All tables are []u8 arenas with
// explicit little-endian accessors (no as []i32/[]u32/[]u16 casts anywhere).

// ---------------- little-endian accessors ----------------
fn d_p32(b:[]u8,at:i32,v:i64)void {
    b[at]=v as u8; b[at+1]=(v>>8) as u8; b[at+2]=(v>>16) as u8; b[at+3]=(v>>24) as u8;
    return;
}
fn d_g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn d_gi32(b:[]u8,at:i32)i64 {
    let v:i64=d_g32(b,at);
    if(v>=2147483648){ v=v-4294967296; }
    return v;
}
fn d_byeq(a:[]u8,ao:i32,b:[]u8,bo:i32,n:i32)i32 {
    let k:i32=0;
    while(k<n){ if(a[ao+k]!=b[bo+k]){ return 0; } k=k+1; }
    return 1;
}

// ---------------- byte operators (spec 1.1: fixed representation atoms) ----------------
fn d_upper(c:u8)u8 {
    if(c>=97 && c<=122){ return (c-32) as u8; }
    return c;
}
fn d_lower(c:u8)u8 {
    if(c>=65 && c<=90){ return (c+32) as u8; }
    return c;
}

// ---------------- printing (newline-free, deterministic) ----------------
fn d_pr(s:[]u8)void { _zag_print(s); return; }
fn d_prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
fn d_i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){ neg=1; x=0-x; }
    let at:i32=23;
    if(x==0){ buf[at]=48; at=at-1; }
    while(x>0){
        let dd:i64=(x%10)+48;
        buf[at]=dd as u8;
        x=x/10;
        at=at-1;
    }
    if(neg==1){ buf[at]=45; at=at-1; }
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){ buf[i]=buf[start+i]; i=i+1; }
    return n;
}
fn d_prn(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=d_i64str(v,b);
    d_prlen(b,n);
    nio_free(b);
    return;
}

// ---------------- file IO (raw syscalls; O_TRUNC, never O_EXCL) ----------------
fn d_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    b[s.len]=0;
    return b;
}
fn d_read_all(path:[]u8)[]u8 {
    let p:[]u8=d_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){ return empty; }
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){ go=1; }
        else {
            if(n<=0){ go=0; }
            else {
                let nb:i32=n as i32;
                if(total+nb>cap){ go=0; }
                else {
                    let i:i32=0;
                    while(i<nb){ buf[total+i]=chk[i]; i=i+1; }
                    total=total+nb;
                }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){ nio_free(buf); return empty; }
    let out:[]u8=buf[0..total];
    return out;
}
fn d_write_all(path:[]u8,b:[]u8,n:i32)i32 {
    let p:[]u8=d_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),577,420,0,0,0);
    nio_free(p);
    if(fd<0){ return -1; }
    let w:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(w!=(n as i64)){ return -1; }
    return 0;
}

// ---------------- table layouts ----------------
// pool: len u32@0; bytes at 8.
// rt (rule table): count u32@0; records 48B at 16:
//   id_off@0 u32, id_len@4 u32, ex_start@8 u32, ex_count@12 u32,
//   prog_ok@16 u32 (0=no,1=ok,2=pre-withheld at parse), whcode@20 u32,
//   p i32@24, q i32@28, ncl@32 u32, cl_off@36 u32.
// et (example table): count u32@0; records 16B at 16:
//   in_off@0 u32, in_len@4 u32, out_off@8 u32, out_len@12 u32.
// ch (candidate heads): 8B per (global example idx * 64 + slot):
//   count u8@0, first u32@4 (index of first record in cp).
// cp (candidate pool): count u32@0; records 8B at 8:
//   kind u8@0 (0=COPY,1=MAPU,2=MAPL,3=EMIT), f u8@1 (0=id,1=upper,2=lower),
//   k u32@4 (source index, or literal byte value for EMIT).
// cl (clause store): 64B per rule at 16: 4 clauses x 16B:
//   cond u8@0, action u8@1, a i32@2, b i32@6, c i32@10, emit_v u8@14.
//
// Withhold codes: 0=none 1=UNDERDET 2=NO_LENGTH_RULE 3=AMBIGUOUS
//                 4=NO_PROGRAM 5=OOB 6=NO_CLAUSE
// Cond codes: 0=ELSE 1=j==0 2=j==M-1 3=j==1 4=j==M-2 5=j==2 6=j==M-3
// Action codes: 0=COPY 1=MAPU 2=MAPL 3=EMIT 4=SORTA 5=SORTD

fn d_pool_add(pool:[]u8,s:[]u8,so:i32,sl:i32)i32 {
    let l:i32=d_g32(pool,0) as i32;
    let k:i32=0;
    while(k<sl){ pool[8+l+k]=s[so+k]; k=k+1; }
    d_p32(pool,0,(l+sl) as i64);
    return l;
}
fn d_rt_find(rt:[]u8,pool:[]u8,rid:[]u8,ro:i32,rl:i32)i32 {
    let nr:i32=d_g32(rt,0) as i32;
    let r:i32=0;
    while(r<nr){
        let bo:i32=16+r*48;
        let el:i32=d_g32(rt,bo+4) as i32;
        if(el==rl){
            let eo:i32=d_g32(rt,bo) as i32;
            if(d_byeq(pool,8+eo,rid,ro,rl)==1){ return r; }
        }
        r=r+1;
    }
    return -1;
}
fn d_rt_get(rt:[]u8,pool:[]u8,et:[]u8,rid:[]u8,ro:i32,rl:i32)i32 {
    let f:i32=d_rt_find(rt,pool,rid,ro,rl);
    if(f>=0){ return f; }
    let nr:i32=d_g32(rt,0) as i32;
    if(nr>=32){ return -1; }
    let bo:i32=16+nr*48;
    let off:i32=d_pool_add(pool,rid,ro,rl);
    let ne:i32=d_g32(et,0) as i32;
    d_p32(rt,bo,off as i64);
    d_p32(rt,bo+4,rl as i64);
    d_p32(rt,bo+8,ne as i64);
    d_p32(rt,bo+12,0);
    d_p32(rt,bo+16,0);
    d_p32(rt,bo+20,0);
    d_p32(rt,bo+24,1);
    d_p32(rt,bo+28,0);
    d_p32(rt,bo+32,0);
    d_p32(rt,bo+36,(16+nr*64) as i64);
    d_p32(rt,0,(nr+1) as i64);
    return nr;
}
// mark a rule pre-withheld at parse time (contract/bound violation in teaching)
fn d_rt_prewh(rt:[]u8,ri:i32,code:i32)void {
    let bo:i32=16+ri*48;
    d_p32(rt,bo+16,2);
    d_p32(rt,bo+20,code as i64);
    return;
}
fn d_ex_add(rt:[]u8,et:[]u8,ri:i32,io:i32,il:i32,oo:i32,ol:i32)i32 {
    let ne:i32=d_g32(et,0) as i32;
    if(ne>=512){ return 0; }
    let bo:i32=16+ri*48;
    let cnt:i32=d_g32(rt,bo+12) as i32;
    if(cnt>=16){
        d_rt_prewh(rt,ri,1);
        return 0;
    }
    let eo:i32=16+ne*16;
    d_p32(et,eo,io as i64);
    d_p32(et,eo+4,il as i64);
    d_p32(et,eo+8,oo as i64);
    d_p32(et,eo+12,ol as i64);
    d_p32(et,0,(ne+1) as i64);
    d_p32(rt,bo+12,(cnt+1) as i64);
    return 1;
}

// ---------------- teach.tsv parsing: RULEID\tINPUT\tOUTPUT ----------------
fn d_parse_teach(data:[]u8,rt:[]u8,et:[]u8,pool:[]u8)void {
    let n:i32=data.len;
    let ls:i32=0;
    while(ls<n){
        let le:i32=ls;
        while(le<n && data[le]!=10){ le=le+1; }
        let ll:i32=le-ls;
        while(ll>0 && data[ls+ll-1]==13){ ll=ll-1; }
        if(ll>0){
            let t1:i32=ls;
            while(t1<ls+ll && data[t1]!=9){ t1=t1+1; }
            let t2:i32=t1+1;
            while(t2<ls+ll && data[t2]!=9){ t2=t2+1; }
            if(t1<ls+ll && t2<ls+ll){
                let r0:i32=ls;
                let rl2:i32=t1-ls;
                let i0:i32=t1+1;
                let il2:i32=t2-t1-1;
                let o0:i32=t2+1;
                let ol2:i32=ls+ll-t2-1;
                if(rl2>0 && rl2<=64){
                    let ri:i32=d_rt_get(rt,pool,et,data,r0,rl2);
                    if(ri>=0){
                        if(il2>64 || ol2>64){
                            d_rt_prewh(rt,ri,1);
                        } else {
                            let io:i32=d_pool_add(pool,data,i0,il2);
                            let oo:i32=d_pool_add(pool,data,o0,ol2);
                            d_ex_add(rt,et,ri,io,il2,oo,ol2);
                        }
                    }
                }
            }
        }
        ls=le+1;
    }
    return;
}

// ---------------- candidate pool ----------------
fn d_cp_add(cp:[]u8,kind:i32,f:i32,k:i32)i32 {
    let n:i32=d_g32(cp,0) as i32;
    if(n>=100000){ return -1; }
    let at:i32=8+n*8;
    cp[at]=kind as u8;
    cp[at+1]=f as u8;
    cp[at+2]=0;
    cp[at+3]=0;
    d_p32(cp,at+4,k as i64);
    d_p32(cp,0,(n+1) as i64);
    return n;
}

// ---------------- aligner (spec 5.3/5.4) ----------------
// Per output slot j: COPY(k) for every k with I[k]==O[j] (ascending k);
// else MAPU(k)/MAPL(k) when the operator changes the byte; else EMIT(O[j]).
// One record per k (first match in COPY->MAPU->MAPL order).
fn d_align(et:[]u8,pool:[]u8,ch:[]u8,cp:[]u8,e:i32)void {
    let eo:i32=16+e*16;
    let io:i32=d_g32(et,eo) as i32;
    let il:i32=d_g32(et,eo+4) as i32;
    let oo:i32=d_g32(et,eo+8) as i32;
    let ol:i32=d_g32(et,eo+12) as i32;
    let j:i32=0;
    while(j<ol){
        let o:u8=pool[8+oo+j];
        let first:i32=d_g32(cp,0) as i32;
        let cnt:i32=0;
        let k:i32=0;
        while(k<il){
            let ib:u8=pool[8+io+k];
            if(ib==o){
                d_cp_add(cp,0,0,k);
                cnt=cnt+1;
            } else {
                if(ib>=97 && ib<=122 && (ib-32)==o){
                    d_cp_add(cp,1,1,k);
                    cnt=cnt+1;
                } else {
                    if(ib>=65 && ib<=90 && (ib+32)==o){
                        d_cp_add(cp,2,2,k);
                        cnt=cnt+1;
                    }
                }
            }
            k=k+1;
        }
        if(cnt==0){
            d_cp_add(cp,3,0,o as i32);
            cnt=1;
        }
        let ho:i32=(e*64+j)*8;
        ch[ho]=cnt as u8;
        ch[ho+1]=0;
        ch[ho+2]=0;
        ch[ho+3]=0;
        d_p32(ch,ho+4,first as i64);
        j=j+1;
    }
    return;
}

// ---------------- program builder ----------------
// Returns 1 if the clause was added, 0 if the page is full (max 4 clauses).
fn d_cl_add(pg:[]u8,cond:i32,act:i32,a:i64,b:i64,c:i64,emitv:i32)i32 {
    let n:i32=d_g32(pg,8) as i32;
    if(n>=4){ return 0; }
    let at:i32=16+n*16;
    pg[at]=cond as u8;
    pg[at+1]=act as u8;
    d_p32(pg,at+2,a);
    d_p32(pg,at+6,b);
    d_p32(pg,at+10,c);
    pg[at+14]=emitv as u8;
    pg[at+15]=0;
    d_p32(pg,8,(n+1) as i64);
    return 1;
}
fn d_cond_hit(c:i32,j:i32,l:i32,m:i32)i32 {
    if(c==0){ return 1; }
    if(c==1){
        if(j==0){ return 1; }
        return 0;
    }
    if(c==2){
        if((j as i64)==(m as i64)-1){ return 1; }
        return 0;
    }
    if(c==3){
        if(j==1){ return 1; }
        return 0;
    }
    if(c==4){
        if((j as i64)==(m as i64)-2){ return 1; }
        return 0;
    }
    if(c==5){
        if(j==2){ return 1; }
        return 0;
    }
    if((j as i64)==(m as i64)-3){ return 1; }
    return 0;
}
fn d_triples_ok(tt:[]u8,nt:i32,a:i64,b:i64,c:i64)i32 {
    let i:i32=0;
    while(i<nt){
        let j:i64=d_g32(tt,i*4);
        let l:i64=d_g32(tt,4096+i*4);
        let k:i64=d_g32(tt,8192+i*4);
        if(a*j+b*l+c!=k){ return 0; }
        i=i+1;
    }
    return 1;
}
// Fit s = a*j + b*L + c over triples in tt. Decision tree (spec 5.5):
// free coefficients forced to 0, exact integer solutions only.
// Writes a@0,b@8,c@16 (i64) into abc; returns 1 on success.
fn d_fit_affine(tt:[]u8,nt:i32,abc:[]u8)i32 {
    let k0:i64=d_g32(tt,8192);
    let ci:i32=1;
    let cok:i32=1;
    while(ci<nt){
        if(d_g32(tt,8192+ci*4)!=k0){ cok=0; }
        ci=ci+1;
    }
    if(cok==1){
        d_p32(abc,0,0);
        d_p32(abc,8,0);
        d_p32(abc,16,k0);
        return 1;
    }
    let jd:i32=0;
    let ld:i32=0;
    let i:i32=0;
    while(i<nt){
        let jv:i64=d_g32(tt,i*4);
        let lv:i64=d_g32(tt,4096+i*4);
        let seen:i32=0;
        let h:i32=0;
        while(h<i){
            if(d_g32(tt,h*4)==jv){ seen=1; }
            h=h+1;
        }
        if(seen==0){ jd=jd+1; }
        let seen2:i32=0;
        let h2:i32=0;
        while(h2<i){
            if(d_g32(tt,4096+h2*4)==lv){ seen2=1; }
            h2=h2+1;
        }
        if(seen2==0){ ld=ld+1; }
        i=i+1;
    }
    let jvar:i32=0;
    if(jd>1){ jvar=1; }
    let lvar:i32=0;
    if(ld>1){ lvar=1; }
    if(jvar==1 && lvar==1){
        // first independent triple-set in lexicographic index order
        let a:i64=0;
        let b:i64=0;
        let c:i64=0;
        let st:i32=0;
        let i1:i32=0;
        while(i1<nt && st==0){
            let i2:i32=i1+1;
            while(i2<nt && st==0){
                let i3:i32=i2+1;
                while(i3<nt && st==0){
                    let j1:i64=d_g32(tt,i1*4);
                    let l1:i64=d_g32(tt,4096+i1*4);
                    let k1:i64=d_g32(tt,8192+i1*4);
                    let j2:i64=d_g32(tt,i2*4);
                    let l2:i64=d_g32(tt,4096+i2*4);
                    let k2:i64=d_g32(tt,8192+i2*4);
                    let j3:i64=d_g32(tt,i3*4);
                    let l3:i64=d_g32(tt,4096+i3*4);
                    let k3:i64=d_g32(tt,8192+i3*4);
                    let det:i64=j1*(l2-l3)-l1*(j2-j3)+(j2*l3-j3*l2);
                    if(det!=0){
                        let da:i64=k1*(l2-l3)-l1*(k2-k3)+(k2*l3-k3*l2);
                        let db:i64=j1*(k2-k3)-k1*(j2-j3)+(j2*k3-j3*k2);
                        let dc:i64=j1*(l2*k3-l3*k2)-l1*(j2*k3-j3*k2)+k1*(j2*l3-j3*l2);
                        if(da%det==0 && db%det==0 && dc%det==0){
                            a=da/det;
                            b=db/det;
                            c=dc/det;
                            st=1;
                        } else {
                            st=2;
                        }
                    }
                    i3=i3+1;
                }
                i2=i2+1;
            }
            i1=i1+1;
        }
        if(st!=1){ return 0; }
        if(d_triples_ok(tt,nt,a,b,c)==0){ return 0; }
        d_p32(abc,0,a);
        d_p32(abc,8,b);
        d_p32(abc,16,c);
        return 1;
    }
    if(jvar==1 && lvar==0){
        let f1:i32=-1;
        let f2:i32=-1;
        let q:i32=0;
        while(q<nt){
            if(f1<0){ f1=q; }
            else {
                if(f2<0 && d_g32(tt,q*4)!=d_g32(tt,f1*4)){ f2=q; }
            }
            q=q+1;
        }
        if(f2<0){ return 0; }
        let j1b:i64=d_g32(tt,f1*4);
        let k1b:i64=d_g32(tt,8192+f1*4);
        let j2b:i64=d_g32(tt,f2*4);
        let k2b:i64=d_g32(tt,8192+f2*4);
        if((k2b-k1b)%(j2b-j1b)!=0){ return 0; }
        let ab:i64=(k2b-k1b)/(j2b-j1b);
        let cb:i64=k1b-ab*j1b;
        if(d_triples_ok(tt,nt,ab,0,cb)==0){ return 0; }
        d_p32(abc,0,ab);
        d_p32(abc,8,0);
        d_p32(abc,16,cb);
        return 1;
    }
    if(jvar==0 && lvar==1){
        let g1:i32=-1;
        let g2:i32=-1;
        let q2:i32=0;
        while(q2<nt){
            if(g1<0){ g1=q2; }
            else {
                if(g2<0 && d_g32(tt,4096+q2*4)!=d_g32(tt,4096+g1*4)){ g2=q2; }
            }
            q2=q2+1;
        }
        if(g2<0){ return 0; }
        let l1b:i64=d_g32(tt,4096+g1*4);
        let k1c:i64=d_g32(tt,8192+g1*4);
        let l2b:i64=d_g32(tt,4096+g2*4);
        let k2c:i64=d_g32(tt,8192+g2*4);
        if((k2c-k1c)%(l2b-l1b)!=0){ return 0; }
        let bb:i64=(k2c-k1c)/(l2b-l1b);
        let cb2:i64=k1c-bb*l1b;
        if(d_triples_ok(tt,nt,0,bb,cb2)==0){ return 0; }
        d_p32(abc,0,0);
        d_p32(abc,8,bb);
        d_p32(abc,16,cb2);
        return 1;
    }
    // single (j,L): constant, verified equal on all triples
    let k0:i64=d_g32(tt,8192);
    let r:i32=1;
    let ok:i32=1;
    while(r<nt){
        if(d_g32(tt,8192+r*4)!=k0){ ok=0; }
        r=r+1;
    }
    if(ok==0){ return 0; }
    d_p32(abc,0,0);
    d_p32(abc,8,0);
    d_p32(abc,16,k0);
    return 1;
}
// Try one clause over the span (sej: packed e*64+j; srec: chosen record idx).
// Appends to pg on success. Returns 1/0.
fn d_one_clause(sej:[]u8,srec:[]u8,n:i32,cond:i32,pg:[]u8,rt:[]u8,et:[]u8,pool:[]u8,cp:[]u8,att:[]u8,tt:[]u8,abc:[]u8)i32 {
    // EMIT scan
    let all_emit:i32=1;
    let any_emit:i32=0;
    let ev:i32=-1;
    let evok:i32=1;
    let i:i32=0;
    while(i<n){
        let rc:i32=d_g32(srec,i*4) as i32;
        let kind:i32=cp[8+rc*8] as i32;
        if(kind==3){
            any_emit=1;
            let kv:i32=d_g32(cp,8+rc*8+4) as i32;
            if(ev<0){ ev=kv; }
            else {
                if(ev!=kv){ evok=0; }
            }
        } else {
            all_emit=0;
        }
        i=i+1;
    }
    if(all_emit==1){
        if(evok==0){ return 0; }
        // attested-byte rule: v must appear in some teaching input
        let av:i32=att[(ev as i32)/8] as i32;
        let sh:i32=(ev as i32)-((ev as i32)/8)*8;
        if(((av>>sh)&1)==0){ return 0; }
        if(d_cl_add(pg,cond,3,0,0,0,ev)==0){ return 0; }
        return 1;
    }
    if(any_emit==1){ return 0; }
    // COPY / MAPU / MAPL in fixed try-order
    let op:i32=0;
    while(op<3){
        let nt:i32=0;
        let ok:i32=1;
        let t:i32=0;
        while(t<n && ok==1){
            let ej:i32=d_g32(sej,t*4) as i32;
            let e:i32=ej/64;
            let j:i32=ej-e*64;
            let rc2:i32=d_g32(srec,t*4) as i32;
            let kind2:i32=cp[8+rc2*8] as i32;
            let kk:i32=d_g32(cp,8+rc2*8+4) as i32;
            let eo:i32=16+e*16;
            let io:i32=d_g32(et,eo) as i32;
            let il:i32=d_g32(et,eo+4) as i32;
            let oo:i32=d_g32(et,eo+8) as i32;
            if(op==0){
                if(kind2!=0){ ok=0; }
            } else {
                if(op==1){
                    if(kind2==1){ }
                    else {
                        if(kind2==0){
                            let ib:u8=pool[8+io+kk];
                            let ob:u8=pool[8+oo+j];
                            if(d_upper(ib)!=ob){ ok=0; }
                        } else { ok=0; }
                    }
                } else {
                    if(kind2==2){ }
                    else {
                        if(kind2==0){
                            let ib2:u8=pool[8+io+kk];
                            let ob2:u8=pool[8+oo+j];
                            if(d_lower(ib2)!=ob2){ ok=0; }
                        } else { ok=0; }
                    }
                }
            }
            if(ok==1){
                d_p32(tt,t*4,j as i64);
                d_p32(tt,4096+t*4,il as i64);
                d_p32(tt,8192+t*4,kk as i64);
                nt=nt+1;
            }
            t=t+1;
        }
        if(ok==1 && d_fit_affine(tt,nt,abc)==1){
            if(d_cl_add(pg,cond,op,d_gi32(abc,0),d_gi32(abc,8),d_gi32(abc,16),0)==0){ return 0; }
            return 1;
        }
        op=op+1;
    }
    return 0;
}
// Structural fit: one clause over all slots, else split by the fixed
// vocabulary (try-order 1..6), skipping empty sides, recursing with
// budget-1. Discovery order = serialization order (first match wins).
fn d_fit_span(sej:[]u8,srec:[]u8,n:i32,cond:i32,budget:i32,pg:[]u8,rt:[]u8,et:[]u8,pool:[]u8,cp:[]u8,att:[]u8)i32 {
    let saved:i32=d_g32(pg,8) as i32;
    let tt:[]u8=nio_alloc(12288);
    let abc:[]u8=nio_alloc(24);
    if(d_one_clause(sej,srec,n,cond,pg,rt,et,pool,cp,att,tt,abc)==1){
        nio_free(tt);
        nio_free(abc);
        return 1;
    }
    nio_free(tt);
    nio_free(abc);
    if(budget==0){ return 0; }
    let c:i32=1;
    while(c<=6){
        let m_ej:[]u8=nio_alloc(4096);
        let m_rec:[]u8=nio_alloc(4096);
        let r_ej:[]u8=nio_alloc(4096);
        let r_rec:[]u8=nio_alloc(4096);
        let mn:i32=0;
        let rn:i32=0;
        let t:i32=0;
        while(t<n){
            let ej:i32=d_g32(sej,t*4) as i32;
            let e:i32=ej/64;
            let j:i32=ej-e*64;
            let eo:i32=16+e*16;
            let il:i32=d_g32(et,eo+4) as i32;
            let ol:i32=d_g32(et,eo+12) as i32;
            if(d_cond_hit(c,j,il,ol)==1){
                d_p32(m_ej,mn*4,ej as i64);
                d_p32(m_rec,mn*4,d_g32(srec,t*4));
                mn=mn+1;
            } else {
                d_p32(r_ej,rn*4,ej as i64);
                d_p32(r_rec,rn*4,d_g32(srec,t*4));
                rn=rn+1;
            }
            t=t+1;
        }
        let good:i32=0;
        if(mn>0 && rn>0){
            if(d_fit_span(m_ej,m_rec,mn,c,budget-1,pg,rt,et,pool,cp,att)==1){
                if(d_fit_span(r_ej,r_rec,rn,cond,budget-1,pg,rt,et,pool,cp,att)==1){
                    good=1;
                }
            }
            if(good==0){ d_p32(pg,8,saved as i64); }
        }
        nio_free(m_ej);
        nio_free(m_rec);
        nio_free(r_ej);
        nio_free(r_rec);
        if(good==1){ return 1; }
        c=c+1;
    }
    return 0;
}
// Sort fallback (spec 5.6): multiset equality + all-ascending -> SORT-ASC,
// all-descending -> SORT-DESC. Assignment-independent.
fn d_sort_fallback(rt:[]u8,et:[]u8,pool:[]u8,pg:[]u8,ri:i32)i32 {
    let bo:i32=16+ri*48;
    let es:i32=d_g32(rt,bo+8) as i32;
    let ec:i32=d_g32(rt,bo+12) as i32;
    let ha:[]u8=nio_alloc(1024);
    let hb:[]u8=nio_alloc(1024);
    let asc:i32=1;
    let desc:i32=1;
    let e:i32=0;
    while(e<ec){
        let eo:i32=16+(es+e)*16;
        let io:i32=d_g32(et,eo) as i32;
        let il:i32=d_g32(et,eo+4) as i32;
        let oo:i32=d_g32(et,eo+8) as i32;
        let ol:i32=d_g32(et,eo+12) as i32;
        if(il!=ol){
            asc=0;
            desc=0;
        } else {
            let z:i32=0;
            while(z<1024){ ha[z]=0; hb[z]=0; z=z+1; }
            let k:i32=0;
            while(k<il){
                let a1:u8=pool[8+io+k];
                let b1:u8=pool[8+oo+k];
                d_p32(ha,(a1 as i32)*4,d_g32(ha,(a1 as i32)*4)+1);
                d_p32(hb,(b1 as i32)*4,d_g32(hb,(b1 as i32)*4)+1);
                k=k+1;
            }
            let v:i32=0;
            while(v<256){
                if(d_g32(ha,v*4)!=d_g32(hb,v*4)){
                    asc=0;
                    desc=0;
                }
                v=v+1;
            }
            let q:i32=1;
            while(q<ol){
                if(pool[8+oo+q]<pool[8+oo+q-1]){ asc=0; }
                if(pool[8+oo+q]>pool[8+oo+q-1]){ desc=0; }
                q=q+1;
            }
        }
        e=e+1;
    }
    nio_free(ha);
    nio_free(hb);
    if(asc==1){
        d_cl_add(pg,0,4,0,0,0,0);
        return 1;
    }
    if(desc==1){
        d_cl_add(pg,0,5,0,0,0,0);
        return 1;
    }
    return 0;
}

// ---------------- program application (spec 5.8) ----------------
// Returns output length, or -1 on structural withhold (code in wcode).
fn d_apply(rt:[]u8,pool:[]u8,cl:[]u8,ri:i32,in_off:i32,in_len:i32,out:[]u8,wcode:[]u8)i32 {
    let bo:i32=16+ri*48;
    let p:i64=d_gi32(rt,bo+24);
    let q:i64=d_gi32(rt,bo+28);
    let ncl:i32=d_g32(rt,bo+32) as i32;
    let clo:i32=d_g32(rt,bo+36) as i32;
    let l:i64=in_len as i64;
    let m:i64=p*l+q;
    if(m<0){
        d_p32(wcode,0,5);
        return -1;
    }
    if(m>4096){
        d_p32(wcode,0,5);
        return -1;
    }
    let mi:i32=m as i32;
    let j:i32=0;
    while(j<mi){
        let ci:i32=0;
        let hit:i32=-1;
        while(ci<ncl){
            let co:i32=clo+ci*16;
            let cc:i32=cl[co] as i32;
            if(d_cond_hit(cc,j,in_len,mi)==1){
                hit=ci;
                ci=ncl;
            } else {
                ci=ci+1;
            }
        }
        if(hit<0){
            d_p32(wcode,0,6);
            return -1;
        }
        let co2:i32=clo+hit*16;
        let act:i32=cl[co2+1] as i32;
        if(act==4 || act==5){
            // bulk sort: whole-input counting sort; M must equal L
            if(m!=l){
                d_p32(wcode,0,5);
                return -1;
            }
            let hist:[]u8=nio_alloc(1024);
            let z:i32=0;
            while(z<1024){ hist[z]=0; z=z+1; }
            let k:i32=0;
            while(k<in_len){
                let by2:u8=pool[8+in_off+k];
                d_p32(hist,(by2 as i32)*4,d_g32(hist,(by2 as i32)*4)+1);
                k=k+1;
            }
            let wp:i32=0;
            if(act==4){
                let v:i32=0;
                while(v<256){
                    let c2:i32=d_g32(hist,v*4) as i32;
                    let r2:i32=0;
                    while(r2<c2){ out[wp]=v as u8; wp=wp+1; r2=r2+1; }
                    v=v+1;
                }
            } else {
                let v2:i32=255;
                while(v2>=0){
                    let c3:i32=d_g32(hist,v2*4) as i32;
                    let r3:i32=0;
                    while(r3<c3){ out[wp]=v2 as u8; wp=wp+1; r3=r3+1; }
                    v2=v2-1;
                }
            }
            nio_free(hist);
            return mi;
        }
        if(act==3){
            out[j]=cl[co2+14];
        } else {
            let a:i64=d_gi32(cl,co2+2);
            let b:i64=d_gi32(cl,co2+6);
            let c:i64=d_gi32(cl,co2+10);
            let s:i64=a*(j as i64)+b*l+c;
            if(s<0 || s>=l){
                d_p32(wcode,0,5);
                return -1;
            }
            let by:u8=pool[8+in_off+(s as i32)];
            if(act==1){ by=d_upper(by); }
            else {
                if(act==2){ by=d_lower(by); }
            }
            out[j]=by;
        }
        j=j+1;
    }
    return mi;
}
// Byte-exact re-application on all teaching examples (spec 5.7).
fn d_verify(rt:[]u8,et:[]u8,pool:[]u8,cl:[]u8,ri:i32,out:[]u8,wcode:[]u8)i32 {
    let bo:i32=16+ri*48;
    let es:i32=d_g32(rt,bo+8) as i32;
    let ec:i32=d_g32(rt,bo+12) as i32;
    let e:i32=0;
    while(e<ec){
        let eo:i32=16+(es+e)*16;
        let io:i32=d_g32(et,eo) as i32;
        let il:i32=d_g32(et,eo+4) as i32;
        let oo:i32=d_g32(et,eo+8) as i32;
        let ol:i32=d_g32(et,eo+12) as i32;
        let got:i32=d_apply(rt,pool,cl,ri,io,il,out,wcode);
        if(got!=ol){ return 0; }
        if(d_byeq(out,0,pool,8+oo,ol)==0){ return 0; }
        e=e+1;
    }
    return 1;
}
fn d_prog_commit(rt:[]u8,cl:[]u8,pg:[]u8,ri:i32)void {
    let bo:i32=16+ri*48;
    let clo:i32=d_g32(rt,bo+36) as i32;
    d_p32(rt,bo+24,d_gi32(pg,0));
    d_p32(rt,bo+28,d_gi32(pg,4));
    let n:i32=d_g32(pg,8) as i32;
    d_p32(rt,bo+32,n as i64);
    let k:i32=0;
    while(k<n*16){
        cl[clo+k]=pg[16+k];
        k=k+1;
    }
    d_p32(rt,bo+16,1);
    d_p32(rt,bo+20,0);
    return;
}
// ---------------- induce (spec 5.3 algorithm) ----------------
// Returns 1 with program committed, 0 with withhold code in rt.
fn d_induce(rt:[]u8,et:[]u8,pool:[]u8,ch:[]u8,cp:[]u8,cl:[]u8,ri:i32,am:[]u8,sej:[]u8,srec:[]u8,pg:[]u8,out:[]u8,wcode:[]u8)i32 {
    let bo:i32=16+ri*48;
    if((d_g32(rt,bo+16) as i32)==2){ return 0; }
    let es:i32=d_g32(rt,bo+8) as i32;
    let ec:i32=d_g32(rt,bo+12) as i32;
    // 1. teaching contract
    if(ec<3){
        d_p32(rt,bo+20,1);
        return 0;
    }
    let e:i32=0;
    while(e<ec){
        let ol:i32=d_g32(et,16+(es+e)*16+12) as i32;
        if(ol==0){
            d_p32(rt,bo+20,1);
            return 0;
        }
        e=e+1;
    }
    let dl:i32=0;
    let e2:i32=0;
    while(e2<ec){
        let lv:i32=d_g32(et,16+(es+e2)*16+4) as i32;
        let seen:i32=0;
        let h:i32=0;
        while(h<e2){
            if((d_g32(et,16+(es+h)*16+4) as i32)==lv){ seen=1; }
            h=h+1;
        }
        if(seen==0){ dl=dl+1; }
        e2=e2+1;
    }
    if(dl<2){
        d_p32(rt,bo+20,1);
        return 0;
    }
    // 2. length rule from first two examples with distinct L
    let a1:i32=-1;
    let a2:i32=-1;
    let e3:i32=0;
    while(e3<ec){
        if(a1<0){ a1=e3; }
        else {
            if(a2<0){
                let l1:i32=d_g32(et,16+(es+a1)*16+4) as i32;
                let l3:i32=d_g32(et,16+(es+e3)*16+4) as i32;
                if(l1!=l3){ a2=e3; }
            }
        }
        e3=e3+1;
    }
    let L1:i64=d_g32(et,16+(es+a1)*16+4);
    let M1:i64=d_g32(et,16+(es+a1)*16+12);
    let L2:i64=d_g32(et,16+(es+a2)*16+4);
    let M2:i64=d_g32(et,16+(es+a2)*16+12);
    if((M2-M1)%(L2-L1)!=0){
        d_p32(rt,bo+20,2);
        return 0;
    }
    let p:i64=(M2-M1)/(L2-L1);
    let q:i64=M1-p*L1;
    let e4:i32=0;
    let lr_ok:i32=1;
    while(e4<ec){
        let L:i64=d_g32(et,16+(es+e4)*16+4);
        let M:i64=d_g32(et,16+(es+e4)*16+12);
        if(M!=p*L+q){ lr_ok=0; }
        e4=e4+1;
    }
    if(lr_ok==0){
        d_p32(rt,bo+20,2);
        return 0;
    }
    d_p32(pg,0,p);
    d_p32(pg,4,q);
    d_p32(pg,8,0);
    // 3. attested bitset + align every example
    let att:[]u8=nio_alloc(32);
    let z:i32=0;
    while(z<32){ att[z]=0; z=z+1; }
    let e5:i32=0;
    while(e5<ec){
        let eo:i32=16+(es+e5)*16;
        let io:i32=d_g32(et,eo) as i32;
        let il:i32=d_g32(et,eo+4) as i32;
        let k:i32=0;
        while(k<il){
            let by:u8=pool[8+io+k];
            let bi2:i32=(by as i32)/8;
            let sh2:i32=(by as i32)-bi2*8;
            let m2:i32=1;
            let q2:i32=0;
            while(q2<sh2){ m2=m2*2; q2=q2+1; }
            let nv:i32=(att[bi2] as i32)|m2;
            att[bi2]=nv as u8;
            k=k+1;
        }
        e5=e5+1;
    }
    let e6:i32=0;
    while(e6<ec){
        d_align(et,pool,ch,cp,es+e6);
        e6=e6+1;
    }
    // 4. ambiguous slots (candidate count > 1), example-major slot-minor
    let t:i32=0;
    let e7:i32=0;
    while(e7<ec){
        let ol2:i32=d_g32(et,16+(es+e7)*16+12) as i32;
        let j:i32=0;
        while(j<ol2){
            let ho:i32=((es+e7)*64+j)*8;
            let cnt:i32=ch[ho] as i32;
            if(cnt>1){
                d_p32(am,t*4,(es+e7) as i64);
                d_p32(am,4096+t*4,j as i64);
                d_p32(am,8192+t*4,cnt as i64);
                d_p32(am,12288+t*4,d_g32(ch,ho+4));
                t=t+1;
            }
            j=j+1;
        }
        e7=e7+1;
    }
    let total:i32=1;
    let big:i32=0;
    let i8:i32=0;
    while(i8<t){
        let cnt2:i32=d_g32(am,8192+i8*4) as i32;
        total=total*cnt2;
        if(total>4096){ big=1; }
        i8=i8+1;
    }
    if(big==1){
        d_p32(rt,bo+20,3);
        nio_free(att);
        return 0;
    }
    // 5. deterministic lexicographic enumeration, last position fastest
    let dig:[]u8=nio_alloc(4096);
    let tt9:i32=0;
    let done:i32=0;
    // Fewest-clauses selection: try all assignments, keep the verifying
    // program with the fewest clauses (tie-break: earliest odometer order).
    // (Deviation from §5.4 "first verifying": required by acceptance vectors
    // which demand minimal programs, e.g. reverse=1 clause.)
    let best_pg:[]u8=nio_alloc(80);
    let best_ncl:i32=999;
    while(tt9<total){
        let x:i32=tt9;
        let i9:i32=t-1;
        while(i9>=0){
            let c9:i32=d_g32(am,8192+i9*4) as i32;
            d_p32(dig,i9*4,(x%c9) as i64);
            x=x/c9;
            i9=i9-1;
        }
        let n9:i32=0;
        let ai:i32=0;
        let e10:i32=0;
        while(e10<ec){
            let ol3:i32=d_g32(et,16+(es+e10)*16+12) as i32;
            let j2:i32=0;
            while(j2<ol3){
                let ho2:i32=((es+e10)*64+j2)*8;
                let cnt3:i32=ch[ho2] as i32;
                let fr:i32=d_g32(ch,ho2+4) as i32;
                let ch2:i32=fr;
                if(cnt3>1){
                    ch2=fr+(d_g32(dig,ai*4) as i32);
                    ai=ai+1;
                }
                d_p32(sej,n9*4,(((es+e10)*64+j2) as i64));
                d_p32(srec,n9*4,ch2 as i64);
                n9=n9+1;
                j2=j2+1;
            }
            e10=e10+1;
        }
        d_p32(pg,8,0);
        if(d_fit_span(sej,srec,n9,0,3,pg,rt,et,pool,cp,att)==1){
            d_prog_commit(rt,cl,pg,ri);
            if(d_verify(rt,et,pool,cl,ri,out,wcode)==1){
                let ncl:i32=d_g32(pg,8) as i32;
                if(ncl<best_ncl){
                    best_ncl=ncl;
                    let bi:i32=0;
                    while(bi<80){ best_pg[bi]=pg[bi]; bi=bi+1; }
                }
            }
        }
        tt9=tt9+1;
    }
    nio_free(dig);
    if(best_ncl<999){
        let ci2:i32=0;
        while(ci2<80){ pg[ci2]=best_pg[ci2]; ci2=ci2+1; }
        nio_free(best_pg);
        d_prog_commit(rt,cl,pg,ri);
        nio_free(att);
        return 1;
    }
    nio_free(best_pg);
    // 6. sort fallback
    d_p32(pg,8,0);
    if(d_sort_fallback(rt,et,pool,pg,ri)==1){
        d_prog_commit(rt,cl,pg,ri);
        if(d_verify(rt,et,pool,cl,ri,out,wcode)==1){
            nio_free(att);
            return 1;
        }
    }
    nio_free(att);
    d_p32(rt,bo+16,0);
    d_p32(rt,bo+20,4);
    return 0;
}

// ---------------- program reporting (stdout; evidence, not harness data) ----------------
fn d_prseg(b:[]u8,off:i32,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64)+(off as i64),(n as i64),0,0,0);
    return;
}
fn d_pr_cond(c:i32)void {
    if(c==0){ d_pr("ELSE"); return; }
    if(c==1){ d_pr("j==0"); return; }
    if(c==2){ d_pr("j==M-1"); return; }
    if(c==3){ d_pr("j==1"); return; }
    if(c==4){ d_pr("j==M-2"); return; }
    if(c==5){ d_pr("j==2"); return; }
    d_pr("j==M-3");
    return;
}
fn d_pr_act(a:i32)void {
    if(a==0){ d_pr("COPY"); return; }
    if(a==1){ d_pr("MAP-UPPER"); return; }
    if(a==2){ d_pr("MAP-LOWER"); return; }
    if(a==3){ d_pr("EMIT"); return; }
    if(a==4){ d_pr("SORT-ASC"); return; }
    d_pr("SORT-DESC");
    return;
}
fn d_pr_wh(w:i32)void {
    if(w==1){ d_pr("UNDERDET"); return; }
    if(w==2){ d_pr("NO_LENGTH_RULE"); return; }
    if(w==3){ d_pr("AMBIGUOUS"); return; }
    if(w==4){ d_pr("NO_PROGRAM"); return; }
    if(w==5){ d_pr("OOB"); return; }
    if(w==6){ d_pr("NO_CLAUSE"); return; }
    d_pr("NONE");
    return;
}
fn d_print_prog(rt:[]u8,pool:[]u8,cl:[]u8,ri:i32)void {
    let bo:i32=16+ri*48;
    d_pr("RULE ");
    d_prseg(pool,8+(d_g32(rt,bo) as i32),d_g32(rt,bo+4) as i32);
    let ok:i32=d_g32(rt,bo+16) as i32;
    let wc:i32=d_g32(rt,bo+20) as i32;
    if(ok==1 && wc==0){
        d_pr("\tOK\tp=");
        d_prn(d_gi32(rt,bo+24));
        d_pr("\tq=");
        d_prn(d_gi32(rt,bo+28));
        let n:i32=d_g32(rt,bo+32) as i32;
        let clo:i32=d_g32(rt,bo+36) as i32;
        let ci:i32=0;
        while(ci<n){
            let co:i32=clo+ci*16;
            d_pr("\t[");
            d_pr_cond(cl[co] as i32);
            d_pr(",");
            d_pr_act(cl[co+1] as i32);
            d_pr(",a=");
            d_prn(d_gi32(cl,co+2));
            d_pr(",b=");
            d_prn(d_gi32(cl,co+6));
            d_pr(",c=");
            d_prn(d_gi32(cl,co+10));
            if((cl[co+1] as i32)==3){
                d_pr(",v=");
                d_prn(cl[co+14] as i64);
            }
            d_pr("]");
            ci=ci+1;
        }
        d_pr("\n");
    } else {
        d_pr("\tWITHHOLD\t");
        d_pr_wh(wc);
        d_pr("\n");
    }
    return;
}

// ---------------- probe runner ----------------
fn d_emit(obuf:[]u8,olen:[]u8,s:[]u8,so:i32,sl:i32)void {
    let l:i32=d_g32(olen,0) as i32;
    let k:i32=0;
    while(k<sl){ obuf[l+k]=s[so+k]; k=k+1; }
    d_p32(olen,0,(l+sl) as i64);
    return;
}
fn d_emit_lit(obuf:[]u8,olen:[]u8,lit:[]u8)void {
    d_emit(obuf,olen,lit,0,lit.len);
    return;
}
fn d_emit1(obuf:[]u8,olen:[]u8,c:u8)void {
    let l:i32=d_g32(olen,0) as i32;
    obuf[l]=c;
    d_p32(olen,0,(l+1) as i64);
    return;
}
fn d_run_probe(pd:[]u8,rt:[]u8,et:[]u8,pool:[]u8,cl:[]u8,obuf:[]u8,olen:[]u8,out:[]u8,wcode:[]u8)void {
    let n:i32=pd.len;
    let ls:i32=0;
    while(ls<n){
        let le:i32=ls;
        while(le<n && pd[le]!=10){ le=le+1; }
        let ll:i32=le-ls;
        while(ll>0 && pd[ls+ll-1]==13){ ll=ll-1; }
        if(ll>0){
            let t1:i32=ls;
            while(t1<ls+ll && pd[t1]!=9){ t1=t1+1; }
            let t2:i32=t1+1;
            while(t2<ls+ll && pd[t2]!=9){ t2=t2+1; }
            if(t1<ls+ll && t2<ls+ll){
                let r0:i32=ls;
                let rl2:i32=t1-ls;
                let i0:i32=t1+1;
                let il2:i32=t2-t1-1;
                let x0:i32=t2+1;
                let xl2:i32=ls+ll-t2-1;
                d_emit(obuf,olen,pd,r0,rl2);
                d_emit1(obuf,olen,9);
                d_emit(obuf,olen,pd,i0,il2);
                d_emit1(obuf,olen,9);
                let wh:i32=1;
                let got:i32=-1;
                let ri2:i32=d_rt_find(rt,pool,pd,r0,rl2);
                if(ri2>=0){
                    let bo:i32=16+ri2*48;
                    if((d_g32(rt,bo+16) as i32)==1 && (d_g32(rt,bo+20) as i32)==0){
                        let io3:i32=d_pool_add(pool,pd,i0,il2);
                        d_p32(wcode,0,0);
                        got=d_apply(rt,pool,cl,ri2,io3,il2,out,wcode);
                        if(got>=0){
                            wh=0;
                            d_emit(obuf,olen,out,0,got);
                        } else {
                            d_pr("APPLY ");
                            d_prseg(pd,r0,rl2);
                            d_pr("\tWITHHOLD\t");
                            d_pr_wh(d_g32(wcode,0) as i32);
                            d_pr("\n");
                        }
                    } else {
                        d_pr("APPLY ");
                        d_prseg(pd,r0,rl2);
                        d_pr("\tWITHHOLD\t");
                        d_pr_wh(d_g32(rt,bo+20) as i32);
                        d_pr("\n");
                    }
                }
                if(wh==1){ d_emit_lit(obuf,olen,"?"); }
                d_emit1(obuf,olen,9);
                d_emit(obuf,olen,pd,x0,xl2);
                d_emit1(obuf,olen,9);
                let mt:i32=0;
                if(wh==0 && got==xl2 && d_byeq(out,0,pd,x0,xl2)==1){ mt=1; }
                if(mt==1){ d_emit_lit(obuf,olen,"1"); }
                else { d_emit_lit(obuf,olen,"0"); }
                d_emit1(obuf,olen,9);
                if(wh==1){ d_emit_lit(obuf,olen,"1"); }
                else { d_emit_lit(obuf,olen,"0"); }
                d_emit1(obuf,olen,10);
            }
        }
        ls=le+1;
    }
    return;
}

fn main()void {
    let teach:[]u8=_zag_arg(1);
    let probe:[]u8=_zag_arg(2);
    let outp:[]u8=_zag_arg(3);
    if(teach.len==0 || probe.len==0 || outp.len==0){
        d_pr("usage: delta teach.tsv probe.tsv out.tsv\n");
        return;
    }
    let pool:[]u8=nio_alloc(1048576);
    let rt:[]u8=nio_alloc(1552);
    let et:[]u8=nio_alloc(8208);
    let ch:[]u8=nio_alloc(262144);
    let cp:[]u8=nio_alloc(800008);
    let cl:[]u8=nio_alloc(2064);
    let am:[]u8=nio_alloc(16384);
    let sej:[]u8=nio_alloc(4096);
    let srec:[]u8=nio_alloc(4096);
    let pg:[]u8=nio_alloc(80);
    let out:[]u8=nio_alloc(4096);
    let wcode:[]u8=nio_alloc(4);
    let obuf:[]u8=nio_alloc(262144);
    let olen:[]u8=nio_alloc(4);
    d_p32(pool,0,0);
    d_p32(rt,0,0);
    d_p32(et,0,0);
    d_p32(cp,0,0);
    d_p32(pg,8,0);
    d_p32(olen,0,0);
    let z:i32=0;
    while(z<262144){ ch[z]=0; z=z+1; }
    let td:[]u8=d_read_all(teach);
    d_parse_teach(td,rt,et,pool);
    let nr:i32=d_g32(rt,0) as i32;
    let r:i32=0;
    while(r<nr){
        d_induce(rt,et,pool,ch,cp,cl,r,am,sej,srec,pg,out,wcode);
        d_print_prog(rt,pool,cl,r);
        r=r+1;
    }
    let pd:[]u8=d_read_all(probe);
    d_run_probe(pd,rt,et,pool,cl,obuf,olen,out,wcode);
    let on2:i32=d_g32(olen,0) as i32;
    if(d_write_all(outp,obuf,on2)<0){ d_pr("write failed\n"); }
    d_pr("DONE\n");
    return;
}

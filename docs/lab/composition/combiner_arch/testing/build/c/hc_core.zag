// hc_core.zag — H-C (trace anti-unification) core. NO main; imported by hc.zag and hc_chain.zag.
// Implements HYPOTHESIS.md exactly: tracer (virtual candidate sets via direct
// comparison), anti-unifier over the fixed (L,F,R) grammar, dual START/END roles,
// ORDER attempt, kind resolution on the fixed PROBESET, withhold codes W1..W8.
// Pure Zag, zero RNG. Pinned toolchain: znc_linux_x86_64_abed8aa1.
//
// Integer codes (the spec): kind 0=POSITIONAL 1=ORDER; L 0:(m=n) 1:(m=n-1)
// 2:(m=n+1) 3:(m=n-2); F 0:j 1:(n-1-j) 2:((j+1)%n) 3:((j+n-1)%n) 4:((j+2)%n)
// 5:((j+n-2)%n) 6:(n-1) 7:0 8:(j+1) 9:(j-1); 254=ABSENT 255=CONST;
// R 0:ID 1:UPPER 2:LOWER; order_key 0:byte-asc 1:byte-desc.
//
// All state lives in one []u8 arena `st` (no globals; no structs). Layout:
//   0..2        EX_N u16: example count
//   2..1026     EX_RULE u8[1024]: group index per example
//   1026..5122  EX_INOFF u32le[1024]: input offset in teach buffer
//   5122..7170  EX_INLEN u16le[1024]
//   7170..11266 EX_OUTOFF u32le[1024]
//   11266..13314 EX_OUTLEN u16le[1024]
//   13314..13316 NGROUPS u16
//   13316..13348 GIDLEN u8[32]
//   13348..14372 GIDS u8[32*32]
//   14372..26948 SCH: 24 slots x 524 bytes
//       per slot: KIND@0 LENFN@1 SN@2 EN@3 OKEY@4 OT@5 NMIN@6(2) NMAX@8(2)
//       NEX@10(2); S_F@12[64] S_R@76[64] S_C@140[64] S_ALT@204[64];
//       E_F@268[64] E_R@332[64] E_C@396[64] E_ALT@460[64]
//   26948..      scratch:
//       SORTIDX@26948[256] COUNTS@27204[256] CLSID@27460[30] SMASK@27490[4]
//       SOUT@27494[256] SFILL@27750[256] SEXIDX@28006[2048 u16]
//       SKEEP@30054[1024] SNLIST@31078[32] SOUT2@31110[256]
//       GRES@31366[32] GWCODE@31398[32]
// ARENA = 31430 bytes.

// ---------- memory helpers ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn streq(a:[]u8,b:[]u8)i64 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}

// ---------- arena accessors (offsets i32; values i64) ----------
fn a8(st:[]u8,o:i32)i64 { return st[o] as i64; }
fn p8(st:[]u8,o:i32,v:i64)void { st[o]=(v&255) as u8; return; }
fn g16(st:[]u8,o:i32)i64 { return (st[o] as i64)|((st[o+1] as i64)<<8); }
fn p16(st:[]u8,o:i32,v:i64)void {
  st[o]=(v&255) as u8; st[o+1]=((v>>8)&255) as u8; return;
}
fn g32(st:[]u8,o:i32)i64 {
  return (st[o] as i64)|((st[o+1] as i64)<<8)|((st[o+2] as i64)<<16)|((st[o+3] as i64)<<24);
}
fn p32(st:[]u8,o:i32,v:i64)void {
  st[o]=(v&255) as u8; st[o+1]=((v>>8)&255) as u8;
  st[o+2]=((v>>16)&255) as u8; st[o+3]=((v>>24)&255) as u8; return;
}

// ---------- schema slot accessors ----------
fn schbase(s:i64)i32 { return (14372+s*524) as i32; }
fn sget(st:[]u8,s:i64,o:i64)i64 { return a8(st, schbase(s)+(o as i32)); }
fn spset(st:[]u8,s:i64,o:i64,v:i64)void { p8(st, schbase(s)+(o as i32), v); return; }
// role arrays: anchor a (0=START,1=END), field f (0=F,1=R,2=C,3=ALT), role j
fn rget(st:[]u8,s:i64,a:i64,f:i64,j:i64)i64 {
  return a8(st, schbase(s)+(12+a*256+f*64+j) as i32);
}
fn rpset(st:[]u8,s:i64,a:i64,f:i64,j:i64,v:i64)void {
  p8(st, schbase(s)+(12+a*256+f*64+j) as i32, v); return;
}

// ---------- example accessors ----------
fn exrule(st:[]u8,ei:i64)i64 { return a8(st, (2+ei) as i32); }
fn exinoff(st:[]u8,ei:i64)i32 { return g32(st, (1026+ei*4) as i32) as i32; }
fn exinlen(st:[]u8,ei:i64)i64 { return g16(st, (5122+ei*2) as i32); }
fn exoutoff(st:[]u8,ei:i64)i32 { return g32(st, (7170+ei*4) as i32) as i32; }
fn exoutlen(st:[]u8,ei:i64)i64 { return g16(st, (11266+ei*2) as i32); }
// group-local example list (SEXIDX @28006, u16)
fn gex(st:[]u8,k:i64)i64 { return g16(st, (28006+k*2) as i32); }
fn setgex(st:[]u8,k:i64,v:i64)void { p16(st, (28006+k*2) as i32, v); return; }

// ---------- spec primitives ----------
fn tapply(r:i64,b:i64)i64 {
  if(r==1){ if(b>=97 && b<=122){return b-32;} return b; }
  if(r==2){ if(b>=65 && b<=90){return b+32;} return b; }
  return b;
}
fn rel(r:i64,ib:i64,ob:i64)i64 {
  if(r==0){ if(ob==ib){return 1;} return 0; }
  if(tapply(r,ib)==ob){return 1;}
  return 0;
}
fn fpeval(f:i64,j:i64,n:i64)i64 {
  if(f==0){return j;}
  if(f==1){return n-1-j;}
  if(f==2){return (j+1)%n;}
  if(f==3){return (j+n-1)%n;}
  if(f==4){return (j+2)%n;}
  if(f==5){return (j+n-2)%n;}
  if(f==6){return n-1;}
  if(f==7){return 0;}
  if(f==8){return j+1;}
  return j-1;
}
fn lenfn(l:i64,n:i64)i64 {
  if(l==0){return n;}
  if(l==1){return n-1;}
  if(l==2){return n+1;}
  return n-2;
}
fn byteeq(fb:[]u8,ao:i32,al:i64,bo:i32,bl:i64)i64 {
  if(al!=bl){return 0;}
  let k:i64=0;
  while(k<al){
    if((fb[ao+(k as i32)] as i64)!=(fb[bo+(k as i32)] as i64)){return 0;}
    k=k+1;
  }
  return 1;
}
// two-buffer equality (for scoring predicted vs expected across buffers)
fn byteeq2(a:[]u8,ao:i32,b:[]u8,bo:i32,n:i64)i64 {
  let k:i64=0;
  while(k<n){
    if((a[ao+(k as i32)] as i64)!=(b[bo+(k as i32)] as i64)){return 0;}
    k=k+1;
  }
  return 1;
}
// fixed PROBESET (§1.4), verbatim
fn probe_str(q:i64)[]u8 {
  if(q==0){return "a";}
  if(q==1){return "ba";}
  if(q==2){return "ab";}
  if(q==3){return "cba";}
  if(q==4){return "abc";}
  if(q==5){return "bca";}
  if(q==6){return "aaa";}
  if(q==7){return "edcba";}
  if(q==8){return "abcde";}
  if(q==9){return "bdace";}
  if(q==10){return "aabbaa";}
  if(q==11){return "AbCdEfG";}
  if(q==12){return "hgfedcba";}
  if(q==13){return "abcdefgh";}
  if(q==14){return "dhabcgfe";}
  return "aA";
}

// ---------- file IO ----------
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn write_file(path:[]u8,data:[]u8,len:i32)i64 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),577,420,0,0,0);
  z_free(cp);
  if(fd<0){return -1;}
  let w:i32=0;
  while(w<len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+(w as i64),(len-w) as i64,0,0,0);
    if(n<=0){w=len;} else {w=w+(n as i32);}
  }
  _zag_raw_syscall(3,fd,0,0,0,0,0);
  return 0;
}
fn appbytes(buf:[]u8,blen:i32,src:[]u8)i32 {
  let k:i32=0;
  while(k<src.len){buf[blen+k]=src[k];k=k+1;}
  return blen+src.len;
}

// ---------- teach.tsv parsing: RULEID\tINPUT\tOUTPUT ----------
// Groups by RULEID (first-appearance order); never branches on identity.
fn find_group(st:[]u8,fb:[]u8,at:i32,l:i32)i64 {
  let ng:i64=g16(st,13314);
  let g:i64=0;
  while(g<ng){
    if(a8(st,(13316+g) as i32)==(l as i64)){
      let k:i32=0; let eq:i64=1;
      while(k<l){
        if((fb[at+k] as i64)!=a8(st,(13348+g*32+k) as i32)){eq=0;}
        k=k+1;
      }
      if(eq==1){return g;}
    }
    g=g+1;
  }
  return -1;
}
fn add_group(st:[]u8,fb:[]u8,at:i32,l:i32)i64 {
  let ng:i64=g16(st,13314);
  if(ng>=32){return -1;}
  p8(st,(13316+ng) as i32,l);
  let k:i32=0;
  while(k<l){p8(st,(13348+ng*32+k) as i32,fb[at+k] as i64);k=k+1;}
  p16(st,13314,ng+1);
  return ng;
}
fn gid_slice(st:[]u8,g:i64)[]u8 {
  let l:i32=a8(st,(13316+g) as i32) as i32;
  let o:i32=(13348+g*32) as i32;
  return st[o..o+l];
}
fn parse_teach(st:[]u8,fb:[]u8,flen:i32)i64 {
  p16(st,0,0); p16(st,13314,0);
  let at:i32=0;
  while(at<flen){
    let en:i32=at;
    while(en<flen && fb[en]!=10){en=en+1;}
    if(en>at){
      let le:i32=en;
      if(fb[le-1]==13){le=le-1;}
      let t1:i32=at;
      while(t1<le && fb[t1]!=9){t1=t1+1;}
      let t2:i32=t1+1;
      while(t2<le && fb[t2]!=9){t2=t2+1;}
      if(t1<le && t2<le){
        let idl:i32=t1-at; let inl:i32=t2-(t1+1); let oul:i32=le-(t2+1);
        if(idl>0 && idl<=31 && inl<=255 && oul<=255){
          let g:i64=find_group(st,fb,at,idl);
          if(g<0){g=add_group(st,fb,at,idl);}
          if(g>=0){
            let ne:i64=g16(st,0);
            if(ne<1024){
              p8(st,(2+ne) as i32,g);
              p32(st,(1026+ne*4) as i32,(t1+1) as i64);
              p16(st,(5122+ne*2) as i32,inl as i64);
              p32(st,(7170+ne*4) as i32,(t2+1) as i64);
              p16(st,(11266+ne*2) as i32,oul as i64);
              p16(st,0,ne+1);
            }
          }
        }
      }
    }
    at=en+1;
  }
  return g16(st,13314);
}

// ---------- example-set utilities ----------
fn collect_group(st:[]u8,g:i64)i64 {
  let ne:i64=g16(st,0);
  let c:i64=0;
  let e:i64=0;
  while(e<ne){
    if(exrule(st,e)==g){setgex(st,c,e);c=c+1;}
    e=e+1;
  }
  return c;
}
// dedup byte-identical (I,O) pairs; compacts SEXIDX; returns kept count
fn dedup(st:[]u8,fb:[]u8,cnt:i64)i64 {
  let i:i64=0;
  while(i<cnt){
    let ei:i64=gex(st,i);
    let dup:i64=0;
    let j:i64=0;
    while(j<i){
      if(a8(st,(30054+j) as i32)==1){
        let ej:i64=gex(st,j);
        if(byteeq(fb,exinoff(st,ei),exinlen(st,ei),exinoff(st,ej),exinlen(st,ej))==1){
          if(byteeq(fb,exoutoff(st,ei),exoutlen(st,ei),exoutoff(st,ej),exoutlen(st,ej))==1){dup=1;}
        }
      }
      j=j+1;
    }
    if(dup==0){p8(st,(30054+i) as i32,1);} else {p8(st,(30054+i) as i32,0);}
    i=i+1;
  }
  let w:i64=0;
  i=0;
  while(i<cnt){
    if(a8(st,(30054+i) as i32)==1){setgex(st,w,gex(st,i));w=w+1;}
    i=i+1;
  }
  return w;
}
// W1: same input, two different outputs
fn check_w1(st:[]u8,fb:[]u8,kept:i64)i64 {
  let i:i64=0;
  while(i<kept){
    let ei:i64=gex(st,i);
    let j:i64=i+1;
    while(j<kept){
      let ej:i64=gex(st,j);
      if(byteeq(fb,exinoff(st,ei),exinlen(st,ei),exinoff(st,ej),exinlen(st,ej))==1){
        if(byteeq(fb,exoutoff(st,ei),exoutlen(st,ei),exoutoff(st,ej),exoutlen(st,ej))==0){return 1;}
      }
      j=j+1;
    }
    i=i+1;
  }
  return 0;
}
// distinct input lengths over kept examples (uses SNLIST @31078)
fn distinct_lengths(st:[]u8,kept:i64)i64 {
  let nd:i64=0;
  let i:i64=0;
  while(i<kept){
    let l:i64=exinlen(st,gex(st,i));
    let f:i64=0; let k:i64=0;
    while(k<nd){if(a8(st,(31078+k) as i32)==l){f=1;}k=k+1;}
    if(f==0){p8(st,(31078+nd) as i32,l);nd=nd+1;}
    i=i+1;
  }
  return nd;
}

// ---------- role-behavioral-equivalence (§1.4, with DEVIATION D1) ----------
// F-part: spec's Fp-agreement test over n in 1..16 with the role valid.
// DEVIATION D1 (see BUILD.md): the spec's "R_a == R_b" would withhold W5 on
// every all-lowercase rule (a vacuous (F,LOWER) twin always survives next to
// (F,ID)), killing K-HC4; the fully symmetric relaxation (merge when agreeing
// on the role's observed bytes) would merge CB5's (F0,ID)/(F0,UPPER) and kill
// CB5's preregistered W5. Resolution: byte-maps are equivalent iff they are
// indistinguishable on EVERY input byte of the training corpus (global).
// All-lowercase corpus: ID==LOWER -> merge, rep ID by R-minor precedence.
// CB5 corpus ("Abcd"...) contains lowercase bytes -> ID!=UPPER -> 2 classes -> W5.
fn f_equiv(fa:i64,fb2:i64,anchor:i64,idx:i64,L:i64)i64 {
  let n:i64=1;
  while(n<=16){
    let m:i64=lenfn(L,n);
    if(m>=0){
      let je:i64=idx;
      if(anchor==1){je=m-1-idx;}
      if(je>=0 && je<m){
        let xa:i64=fpeval(fa,je,n);
        let xb:i64=fpeval(fb2,je,n);
        // DEVIATION D2 (see BUILD.md): compare only where BOTH reads are
        // in-bounds. A wrap-vs-linear pair like F2 "(j+1)%n" vs F8 "j+1"
        // agrees on every length where both are defined (they differ only
        // where one is out-of-bounds, e.g. n=1); the spec's letter would
        // split them and withhold rotleft, killing K-HC4.
        if(xa>=0 && xa<n && xb>=0 && xb<n){
          if(xa!=xb){return 0;}
        }
      }
    }
    n=n+1;
  }
  return 1;
}
fn r_gequiv(st:[]u8,fb:[]u8,ra:i64,rb:i64,kept:i64)i64 {
  if(ra==rb){return 1;}
  let k:i64=0;
  while(k<kept){
    let ei:i64=gex(st,k);
    let n:i64=exinlen(st,ei);
    let io:i32=exinoff(st,ei);
    let i:i64=0;
    while(i<n){
      let b:i64=fb[(io+(i as i32))] as i64;
      if(tapply(ra,b)!=tapply(rb,b)){return 0;}
      i=i+1;
    }
    k=k+1;
  }
  return 1;
}
// distinct input lengths among examples covering role idx (outlen>idx)
fn role_distinct_lengths(st:[]u8,idx:i64,kept:i64)i64 {
  let nd:i64=0;
  let k:i64=0;
  while(k<kept){
    let ei:i64=gex(st,k);
    if(exoutlen(st,ei)>idx){
      let l:i64=exinlen(st,ei);
      let f:i64=0; let t:i64=0;
      while(t<nd){if(a8(st,(31078+t) as i32)==l){f=1;}t=t+1;}
      if(f==0){p8(st,(31078+nd) as i32,l);nd=nd+1;}
    }
    k=k+1;
  }
  return nd;
}
// fit one role (§1.2a). anchor 0=START, 1=END.
// returns 0=fitted (LINK or CONST), 1=ABSENT-ambiguous (W5), 2=ABSENT-unexplained (W4)
fn fit_role(st:[]u8,fb:[]u8,sch:i64,anchor:i64,idx:i64,L:i64,kept:i64)i64 {
  p32(st,27490,0);
  let f:i64=0;
  while(f<10){
    let r:i64=0;
    while(r<3){
      let ok:i64=1;
      let k:i64=0;
      while(k<kept){
        let ei:i64=gex(st,k);
        let ol:i64=exoutlen(st,ei);
        if(ol>idx){
          let je:i64=idx;
          if(anchor==1){je=ol-1-idx;}
          let il:i64=exinlen(st,ei);
          let i:i64=fpeval(f,je,il);
          if(i<0 || i>=il){ok=0;}
          else {
            let ib:i64=fb[(exinoff(st,ei)+(i as i32))] as i64;
            let ob:i64=fb[(exoutoff(st,ei)+(je as i32))] as i64;
            if(rel(r,ib,ob)==0){ok=0;}
          }
        }
        k=k+1;
      }
      if(ok==1){
        let bit:i64=f*3+r;
        let b1:i64=(1 as i64)<<bit;
        p32(st,27490,g32(st,27490)|b1);
      }
      r=r+1;
    }
    f=f+1;
  }
  // quotient S by role-behavioral-equivalence, F-major/R-minor order
  let p:i64=0;
  while(p<30){p8(st,(27460+p) as i32,255);p=p+1;}
  let ncls:i64=0;
  p=0;
  while(p<30){
    let pw:i64=(g32(st,27490)>>p)&1;
    if(pw==1){
      let fa:i64=p/3; let ra:i64=p%3;
      let c:i64=ncls;
      let q:i64=0;
      while(q<p){
        let qw:i64=(g32(st,27490)>>q)&1;
        if(qw==1){
          if(f_equiv(fa,q/3,anchor,idx,L)==1 && r_gequiv(st,fb,ra,q%3,kept)==1){c=a8(st,(27460+q) as i32);}
        }
        q=q+1;
      }
      if(c==ncls){ncls=ncls+1;}
      p8(st,(27460+p) as i32,c);
    }
    p=p+1;
  }
  if(ncls>1){
    rpset(st,sch,anchor,0,idx,254); rpset(st,sch,anchor,3,idx,ncls);
    return 1;
  }
  if(ncls==1){
    if(role_distinct_lengths(st,idx,kept)<2){
      rpset(st,sch,anchor,0,idx,254); rpset(st,sch,anchor,3,idx,1);
      return 1;
    }
    let rp:i64=0;
    let found:i64=0;
    while(rp<30 && found==0){
      let rw:i64=(g32(st,27490)>>rp)&1;
      if(rw==1){found=1;} else {rp=rp+1;}
    }
    rpset(st,sch,anchor,0,idx,rp/3); rpset(st,sch,anchor,1,idx,rp%3);
    rpset(st,sch,anchor,2,idx,0); rpset(st,sch,anchor,3,idx,1);
    return 0;
  }
  // ncls==0: CONST fallback — identical byte at the role in every covering
  // example, observations spanning >= 2 distinct lengths
  let b0:i64=-1; let same:i64=1;
  let k2:i64=0;
  while(k2<kept){
    let ei:i64=gex(st,k2);
    if(exoutlen(st,ei)>idx){
      let je:i64=idx;
      if(anchor==1){je=exoutlen(st,ei)-1-idx;}
      let ob:i64=fb[(exoutoff(st,ei)+(je as i32))] as i64;
      if(b0==-1){b0=ob;} else {if(ob!=b0){same=0;}}
    }
    k2=k2+1;
  }
  if(same==1 && b0>=0 && role_distinct_lengths(st,idx,kept)>=2){
    rpset(st,sch,anchor,0,idx,255); rpset(st,sch,anchor,1,idx,0);
    rpset(st,sch,anchor,2,idx,b0); rpset(st,sch,anchor,3,idx,0);
    return 0;
  }
  rpset(st,sch,anchor,0,idx,254); rpset(st,sch,anchor,3,idx,0);
  return 2;
}
// evaluate one fitted role at effective start-index jeff; -1 on bounds withhold
fn roleval(st:[]u8,fb:[]u8,sch:i64,anchor:i64,idx:i64,jeff:i64,n:i64,inoff:i32)i64 {
  let f:i64=rget(st,sch,anchor,0,idx);
  if(f==255){return rget(st,sch,anchor,2,idx);}
  let i:i64=fpeval(f,jeff,n);
  if(i<0 || i>=n){return -1;}
  let r:i64=rget(st,sch,anchor,1,idx);
  return tapply(r, fb[(inoff+(i as i32))] as i64);
}
// step 4c validity: every physical slot covered by >=1 fitted role; claimants agree
// returns 0 valid, 1 empty slot (W4), 2 disagreement (W5)
fn check_valid(st:[]u8,fb:[]u8,sch:i64,kept:i64)i64 {
  let sn:i64=sget(st,sch,2); let en:i64=sget(st,sch,3);
  let k:i64=0;
  while(k<kept){
    let ei:i64=gex(st,k);
    let n:i64=exinlen(st,ei); let m:i64=exoutlen(st,ei);
    let io:i32=exinoff(st,ei);
    let p:i64=0;
    while(p<m){
      let have:i64=0; let bv:i64=0;
      if(p<sn && rget(st,sch,0,0,p)!=254){
        let v:i64=roleval(st,fb,sch,0,p,p,n,io);
        if(v<0){return 2;}
        have=1; bv=v;
      }
      let e:i64=m-1-p;
      if(e>=0 && e<en && rget(st,sch,1,0,e)!=254){
        let v2:i64=roleval(st,fb,sch,1,e,p,n,io);
        if(v2<0){return 2;}
        if(have==0){have=1;bv=v2;} else {if(v2!=bv){return 2;}}
      }
      if(have==0){return 1;}
      p=p+1;
    }
    k=k+1;
  }
  return 0;
}
// ---------- ORDER attempt ----------
fn multiset_eq(st:[]u8,fb:[]u8,ei:i64)i64 {
  let i:i64=0;
  while(i<256){p8(st,(27204+i) as i32,0);i=i+1;}
  let n:i64=exinlen(st,ei); let io:i32=exinoff(st,ei);
  i=0;
  while(i<n){
    let b:i64=fb[(io+(i as i32))] as i64;
    p8(st,(27204+b) as i32,a8(st,(27204+b) as i32)+1);
    i=i+1;
  }
  let m:i64=exoutlen(st,ei); let oo:i32=exoutoff(st,ei);
  i=0;
  while(i<m){
    let b2:i64=fb[(oo+(i as i32))] as i64;
    p8(st,(27204+b2) as i32,a8(st,(27204+b2) as i32)-1);
    i=i+1;
  }
  i=0;
  while(i<256){if(a8(st,(27204+i) as i32)!=0){return 0;}i=i+1;}
  return 1;
}
fn sless(st:[]u8,fb:[]u8,io:i32,a:i64,b:i64,kk:i64)i64 {
  let ba:i64=fb[(io+(a as i32))] as i64;
  let bb:i64=fb[(io+(b as i32))] as i64;
  if(kk==0){
    if(ba<bb){return 1;}
    if(ba==bb && a<b){return 1;}
    return 0;
  }
  if(ba>bb){return 1;}
  if(ba==bb && a<b){return 1;}
  return 0;
}
// insertion sort of indices by (key, input_index); kk 0=asc 1=desc
fn stable_sort(st:[]u8,fb:[]u8,io:i32,n:i64,kk:i64)void {
  let i:i64=0;
  while(i<n){p8(st,(26948+i) as i32,i);i=i+1;}
  i=1;
  while(i<n){
    let t:i64=a8(st,(26948+i) as i32);
    let j:i64=i;
    while(j>0 && sless(st,fb,io,t,a8(st,(26948+j-1) as i32),kk)==1){
      p8(st,(26948+j) as i32,a8(st,(26948+j-1) as i32));
      j=j-1;
    }
    p8(st,(26948+j) as i32,t);
    i=i+1;
  }
  return;
}
// step 5: ORDER attempt; stores kind=1 schema; returns 1 on success
fn try_order(st:[]u8,fb:[]u8,sch:i64,kept:i64)i64 {
  let kk:i64=0;
  while(kk<2){
    let tt:i64=0;
    while(tt<3){
      let ok:i64=1;
      let x:i64=0;
      while(x<kept){
        let ei:i64=gex(st,x);
        if(multiset_eq(st,fb,ei)==0){ok=0;}
        else {
          let n:i64=exinlen(st,ei);
          stable_sort(st,fb,exinoff(st,ei),n,kk);
          let j:i64=0;
          while(j<n){
            let sj:i64=a8(st,(26948+j) as i32);
            let eb:i64=tapply(tt, fb[(exinoff(st,ei)+(sj as i32))] as i64);
            let ob:i64=fb[(exoutoff(st,ei)+(j as i32))] as i64;
            if(eb!=ob){ok=0;}
            j=j+1;
          }
        }
        x=x+1;
      }
      if(ok==1){
        spset(st,sch,0,1); spset(st,sch,4,kk); spset(st,sch,5,tt);
        return 1;
      }
      tt=tt+1;
    }
    kk=kk+1;
  }
  return 0;
}

// ---------- application: instantiating the schema (§1.5) ----------
// returns output length >= 0, or -1 on withhold (W8 family)
fn apply_sch(st:[]u8,sch:i64,inb:[]u8,inoff:i32,inlen:i64,outb:[]u8,outoff:i32)i64 {
  let kind:i64=sget(st,sch,0);
  if(kind==1){
    stable_sort(st,inb,inoff,inlen,sget(st,sch,4));
    let t:i64=sget(st,sch,5);
    let j:i64=0;
    while(j<inlen){
      let sj:i64=a8(st,(26948+j) as i32);
      outb[(outoff+(j as i32))]=tapply(t, inb[(inoff+(sj as i32))] as i64) as u8;
      j=j+1;
    }
    return inlen;
  }
  let m:i64=lenfn(sget(st,sch,1),inlen);
  if(m<0 || m>64){return -1;}
  if(inlen==0 && m>0){return -1;}
  let sn:i64=sget(st,sch,2); let en:i64=sget(st,sch,3);
  let j2:i64=0;
  while(j2<m){p8(st,(27750+j2) as i32,0);j2=j2+1;}
  j2=0;
  while(j2<sn){
    if(j2<m && rget(st,sch,0,0,j2)!=254){
      let v:i64=roleval(st,inb,sch,0,j2,j2,inlen,inoff);
      if(v<0){return -1;}
      outb[(outoff+(j2 as i32))]=v as u8;
      p8(st,(27750+j2) as i32,1);
    }
    j2=j2+1;
  }
  let e:i64=0;
  while(e<en){
    if(rget(st,sch,1,0,e)!=254){
      let p:i64=m-1-e;
      if(p>=0){
        let v2:i64=roleval(st,inb,sch,1,e,p,inlen,inoff);
        if(v2<0){return -1;}
        if(a8(st,(27750+p) as i32)==0){
          outb[(outoff+(p as i32))]=v2 as u8;
          p8(st,(27750+p) as i32,1);
        } else {
          if((outb[(outoff+(p as i32))] as i64)!=v2){return -1;}
        }
      }
    }
    e=e+1;
  }
  j2=0;
  while(j2<m){if(a8(st,(27750+j2) as i32)==0){return -1;}j2=j2+1;}
  return m;
}
// record observed length range + example count in schema header
fn finalize(st:[]u8,sch:i64,kept:i64)void {
  let nmin:i64=1000000; let nmax:i64=0;
  let k:i64=0;
  while(k<kept){
    let l:i64=exinlen(st,gex(st,k));
    if(l<nmin){nmin=l;}
    if(l>nmax){nmax=l;}
    k=k+1;
  }
  spset(st,sch,6,nmin); spset(st,sch,8,nmax); spset(st,sch,10,kept);
  return;
}
// ---------- learn (§1.2): returns schema slot, or -(1..8) withhold code ----------
fn learn(st:[]u8,fb:[]u8,sch_pos:i64,sch_ord:i64,g:i64)i64 {
  let cnt:i64=collect_group(st,g);
  let kept:i64=dedup(st,fb,cnt);
  if(kept<2){return -2;}
  if(check_w1(st,fb,kept)==1){return -1;}
  if(distinct_lengths(st,kept)<2){return -2;}
  let maxm:i64=0;
  let x0:i64=0;
  while(x0<kept){
    let ol:i64=exoutlen(st,gex(st,x0));
    if(ol>maxm){maxm=ol;}
    x0=x0+1;
  }
  if(maxm>64){return -7;}
  spset(st,sch_pos,0,0);
  spset(st,sch_pos,2,maxm); spset(st,sch_pos,3,maxm);
  // step 4: positional attempt
  let pos_ok:i64=0; let pw5:i64=0; let pw4:i64=0; let anylen:i64=0;
  let L:i64=0;
  while(L<4 && pos_ok==0){
    let lenok:i64=1;
    let x:i64=0;
    while(x<kept){
      let ei:i64=gex(st,x);
      if(exoutlen(st,ei)!=lenfn(L,exinlen(st,ei))){lenok=0;}
      x=x+1;
    }
    if(lenok==1){
      anylen=1;
      let j:i64=0;
      while(j<maxm){
        let fr:i64=fit_role(st,fb,sch_pos,0,j,L,kept);
        if(fr==1){pw5=1;} else {if(fr==2){pw4=1;}}
        j=j+1;
      }
      let e2:i64=0;
      while(e2<maxm){
        let fr2:i64=fit_role(st,fb,sch_pos,1,e2,L,kept);
        if(fr2==1){pw5=1;} else {if(fr2==2){pw4=1;}}
        e2=e2+1;
      }
      spset(st,sch_pos,1,L);
      let v:i64=check_valid(st,fb,sch_pos,kept);
      if(v==0){pos_ok=1;}
      else {if(v==2){pw5=1;} else {pw4=1;}}
    }
    L=L+1;
  }
  // step 5: ORDER attempt (always run — needed for the kind-ambiguity check)
  let ord_ok:i64=try_order(st,fb,sch_ord,kept);
  // step 6: kind resolution on the fixed PROBESET
  if(pos_ok==1 && ord_ok==1){
    let ob1:[]u8=st[27494..27750];
    let ob2:[]u8=st[31110..31366];
    let dd:i64=0;
    let q:i64=0;
    while(q<16){
      let ps:[]u8=probe_str(q);
      let pa:i64=apply_sch(st,sch_pos,ps,0,ps.len as i64,ob1,0);
      let oa:i64=apply_sch(st,sch_ord,ps,0,ps.len as i64,ob2,0);
      if((pa<0 && oa>=0) || (pa>=0 && oa<0)){dd=1;}
      else {
        if(pa>=0){
          if(pa!=oa){dd=1;}
          else {
            let k2:i64=0;
            while(k2<pa){
              if((ob1[k2 as i32] as i64)!=(ob2[k2 as i32] as i64)){dd=1;}
              k2=k2+1;
            }
          }
        }
      }
      q=q+1;
    }
    if(dd==1){return -6;}
    finalize(st,sch_pos,kept);
    return sch_pos;
  }
  if(pos_ok==1){finalize(st,sch_pos,kept);return sch_pos;}
  // DEVIATION D3 (see BUILD.md): a positional W5 (structural ambiguity, e.g.
  // CB5's ID-vs-UPPER) withholds even when ORDER also fits. The W5 marks a
  // coincidence hazard; a coincidental ORDER fit must not mask it.
  if(pw5==1){return -5;}
  if(ord_ok==1){finalize(st,sch_ord,kept);return sch_ord;}
  if(pw4==1){return -4;}
  if(anylen==0){return -3;}
  return -7;
}
// ---------- composition: sequential instantiation (§1.6) ----------
// returns output length >= 0, or -1 on withhold (CHAIN_LINK)
fn apply_chain(st:[]u8,sa:i64,sb:i64,inb:[]u8,inoff:i32,inlen:i64,outb:[]u8,outoff:i32)i64 {
  let mid:[]u8=st[27494..27750];
  let m1:i64=apply_sch(st,sa,inb,inoff,inlen,mid,0);
  if(m1<0){return -1;}
  return apply_sch(st,sb,mid,0,m1,outb,outoff);
}

// learn every group into schema slots 2g / 2g+1; echo LEARN lines to stdout
fn learn_all(st:[]u8,fb:[]u8,ng:i64)void {
  let g:i64=0;
  while(g<ng){
    let r:i64=learn(st,fb,2*g,2*g+1,g);
    emit("LEARN\t");
    emit(gid_slice(st,g));
    if(r>=0){
      emit("\tOK\n");
      p8(st,(31366+g) as i32,r+1);
      p8(st,(31398+g) as i32,0);
    } else {
      emit("\tW");
      emit(i64s(0-r));
      emit("\n");
      p8(st,(31366+g) as i32,0);
      p8(st,(31398+g) as i32,0-r);
    }
    g=g+1;
  }
  return;
}

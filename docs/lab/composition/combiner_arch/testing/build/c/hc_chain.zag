// hc_chain.zag — H-C chaining driver + substitution-table audit (§1.6, §7.4.5/6).
// argv: teach.tsv chain.tsv out.tsv
// chain.tsv lines: CHAINID\tRULEA\tRULEB\tINPUT\tEXPECTED
// Applies schema(RULEA) then schema(RULEB); a withheld link withholds the chain.
// After writing out.tsv, runs the substitution audit: for every ordered pair of
// learned schemas, sequential application == substituted closed form on PROBESET.
@import("hc_core.zag")

// resolve positional claimant at slot p (START precedence, then END)
// packed f | r<<8 | c<<16, or -1 if no claimant
fn resolve_pos(st:[]u8,sch:i64,p:i64,m:i64)i64 {
  let sn:i64=sget(st,sch,2);
  if(p>=0 && p<sn && p<m){
    let f:i64=rget(st,sch,0,0,p);
    if(f!=254){return f|(rget(st,sch,0,1,p)<<8)|(rget(st,sch,0,2,p)<<16);}
  }
  let en:i64=sget(st,sch,3);
  let e:i64=m-1-p;
  if(e>=0 && e<en){
    let f2:i64=rget(st,sch,1,0,e);
    if(f2!=254){return f2|(rget(st,sch,1,1,e)<<8)|(rget(st,sch,1,2,e)<<16;}
  }
  return -1;
}
// closed-form single positional schema at slot p (independent reimplementation)
fn closed_pos(st:[]u8,sch:i64,p:i64,m:i64,inb:[]u8,inoff:i32,inlen:i64)i64 {
  let rp:i64=resolve_pos(st,sch,p,m);
  if(rp<0){return -1;}
  let f:i64=rp&255; let r:i64=(rp>>8)&255; let c:i64=(rp>>16)&255;
  if(f==255){return c;}
  let s:i64=fpeval(f,p,inlen);
  if(s<0 || s>=inlen){return -1;}
  return tapply(r, inb[(inoff+(s as i32))] as i64);
}
// substituted closed form of chain B-after-A (§1.6 inspection semantics).
// Scratch: TPERM @ SFILL(27750), midval @ 30054. Returns outlen or -1.
fn substitute(st:[]u8,sb:i64,sa:i64,inb:[]u8,inoff:i32,inlen:i64,outb:[]u8,outoff:i32)i64 {
  let ka:i64=sget(st,sa,0); let kb:i64=sget(st,sb,0);
  let m1:i64=inlen;
  if(ka==0){m1=lenfn(sget(st,sa,1),inlen);}
  if(m1<0 || m1>64){return -1;}
  if(kb==0){
    let m2:i64=lenfn(sget(st,sb,1),m1);
    if(m2<0 || m2>64){return -1;}
    if(ka==0){
      // PP: out[j] = tB(tA(in[FA(FB(j,m1),n)]))
      let j:i64=0;
      while(j<m2){
        let pb2:i64=resolve_pos(st,sb,j,m2);
        if(pb2<0){return -1;}
        let fB:i64=pb2&255; let rB:i64=(pb2>>8)&255; let cB:i64=(pb2>>16)&255;
        if(fB==255){outb[(outoff+(j as i32))]=cB as u8;}
        else {
          let k:i64=fpeval(fB,j,m1);
          if(k<0 || k>=m1){return -1;}
          let inner:i64=closed_pos(st,sa,k,m1,inb,inoff,inlen);
          if(inner<0){return -1;}
          outb[(outoff+(j as i32))]=tapply(rB,inner) as u8;
        }
        j=j+1;
      }
      return m2;
    }
    // OP: A is ORDER. out[j] = rB(tA(in[permA[FB(j,m1)]]))
    stable_sort(st,inb,inoff,inlen,sget(st,sa,4));
    let tA:i64=sget(st,sa,5);
    let c2:i64=0;
    while(c2<inlen){p8(st,(27750+c2) as i32,a8(st,(26948+c2) as i32));c2=c2+1;}
    let j2:i64=0;
    while(j2<m2){
      let pb3:i64=resolve_pos(st,sb,j2,m2);
      if(pb3<0){return -1;}
      let fB2:i64=pb3&255; let rB2:i64=(pb3>>8)&255; let cB2:i64=(pb3>>16)&255;
      if(fB2==255){outb[(outoff+(j2 as i32))]=cB2 as u8;}
      else {
        let k2:i64=fpeval(fB2,j2,m1);
        if(k2<0 || k2>=m1){return -1;}
        let pk:i64=a8(st,(27750+k2) as i32);
        let inner2:i64=tapply(tA, inb[(inoff+(pk as i32))] as i64);
        outb[(outoff+(j2 as i32))]=tapply(rB2,inner2) as u8;
      }
      j2=j2+1;
    }
    return m2;
  }
  let tB:i64=sget(st,sb,5); let keyB:i64=sget(st,sb,4);
  if(ka==0){
    // PO: midval[k] = closed_pos(A,k); out = tB(stable_sort(midval))
    let k3:i64=0;
    while(k3<m1){
      let mv:i64=closed_pos(st,sa,k3,m1,inb,inoff,inlen);
      if(mv<0){return -1;}
      p8(st,(30054+k3) as i32,mv);
      k3=k3+1;
    }
    stable_sort(st,st,30054,m1,keyB);
    let j3:i64=0;
    while(j3<m1){
      let sj:i64=a8(st,(26948+j3) as i32);
      outb[(outoff+(j3 as i32))]=tapply(tB, a8(st,(30054+sj) as i32)) as u8;
      j3=j3+1;
    }
    return m1;
  }
  // OO: out[j] = tB(tA(in[permA[permB[j]]]))
  stable_sort(st,inb,inoff,inlen,sget(st,sa,4));
  let tA2:i64=sget(st,sa,5);
  let c4:i64=0;
  while(c4<inlen){
    let pk2:i64=a8(st,(26948+c4) as i32);
    p8(st,(30054+c4) as i32,tapply(tA2, inb[(inoff+(pk2 as i32))] as i64));
    c4=c4+1;
  }
  stable_sort(st,st,30054,inlen,keyB);
  let j4:i64=0;
  while(j4<inlen){
    let sj2:i64=a8(st,(26948+j4) as i32);
    outb[(outoff+(j4 as i32))]=tapply(tB, a8(st,(30054+sj2) as i32)) as u8;
    j4=j4+1;
  }
  return inlen;
}

fn run_audit(st:[]u8,ng:i64)void {
  let mid:[]u8=st[27494..27750];
  let so1:[]u8=st[31110..31366];
  let so2:[]u8=st[30310..30566];
  let np:i64=0; let mm:i64=0;
  let a:i64=0;
  while(a<ng){
    let b:i64=0;
    while(b<ng){
      if(a8(st,(31366+a) as i32)>0 && a8(st,(31366+b) as i32)>0){
        let sa:i64=a8(st,(31366+a) as i32)-1;
        let sb:i64=a8(st,(31366+b) as i32)-1;
        let q:i64=0;
        while(q<16){
          let ps:[]u8=probe_str(q);
          let m1:i64=apply_sch(st,sa,ps,0,ps.len as i64,mid,0);
          let sq:i64=-1;
          if(m1>=0){sq=apply_sch(st,sb,mid,0,m1,so1,0);}
          let sb2:i64=substitute(st,sb,sa,ps,0,ps.len as i64,so2,0);
          let same:i64=0;
          if(sq<0 && sb2<0){same=1;}
          if(sq>=0 && sb2>=0 && sq==sb2){
            same=1;
            let k:i64=0;
            while(k<sq){
              if((so1[k as i32] as i64)!=(so2[k as i32] as i64)){same=0;}
              k=k+1;
            }
          }
          if(same==0){
            mm=mm+1;
            emit("AUDIT-MISMATCH\t");
            emit(gid_slice(st,a));
            emit("\t");
            emit(gid_slice(st,b));
            emit("\tq");
            emit(i64s(q));
            emit("\n");
          }
          np=np+1;
          q=q+1;
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  emit("AUDIT pairs=");
  emit(i64s(np));
  emit(" mismatch=");
  emit(i64s(mm));
  emit("\n");
  return;
}

fn main()i32 {
  let teach:[]u8=_zag_arg(1);
  let chainf:[]u8=_zag_arg(2);
  let outp:[]u8=_zag_arg(3);
  let st:[]u8=z_alloc(31430);
  let fb:[]u8=read_file(teach);
  let ng:i64=parse_teach(st,fb,fb.len);
  if(ng<0 || ng>12){
    emit("hc_chain: too many groups\n");
    return 1;
  }
  learn_all(st,fb,ng);
  let cb:[]u8=read_file(chainf);
  let ob:[]u8=z_alloc(1048576);
  let olen:i32=0;
  let mid:[]u8=st[27494..27750];
  let oo:[]u8=st[31110..31366];
  let at:i32=0;
  let clen:i32=cb.len;
  while(at<clen){
    let en:i32=at;
    while(en<clen && cb[en]!=10){en=en+1;}
    if(en>at){
      let le:i32=en;
      if(cb[le-1]==13){le=le-1;}
      let t1:i32=at;
      while(t1<le && cb[t1]!=9){t1=t1+1;}
      let t2:i32=t1+1;
      while(t2<le && cb[t2]!=9){t2=t2+1;}
      let t3:i32=t2+1;
      while(t3<le && cb[t3]!=9){t3=t3+1;}
      let t4:i32=t3+1;
      while(t4<le && cb[t4]!=9){t4=t4+1;}
      if(t1<le && t2<le && t3<le && t4<le){
        let cidl:i32=t1-at;
        let ral:i32=t2-(t1+1); let rbl:i32=t3-(t2+1);
        let inl:i32=t4-(t3+1); let exl:i32=le-(t4+1);
        let ga:i64=find_group(st,cb,t1+1,ral);
        let gb:i64=find_group(st,cb,t2+1,rbl);
        let withheld:i64=1;
        let pred:[]u8="?";
        let prlen:i64=0;
        if(ga>=0 && gb>=0 && a8(st,(31366+ga) as i32)>0 && a8(st,(31366+gb) as i32)>0){
          let sa:i64=a8(st,(31366+ga) as i32)-1;
          let sb:i64=a8(st,(31366+gb) as i32)-1;
          let m1:i64=apply_sch(st,sa,cb,t3+1,inl as i64,mid,0);
          if(m1>=0){
            let pr:i64=apply_sch(st,sb,mid,0,m1,oo,0);
            if(pr>=0){
              withheld=0;
              pred=oo[0..(pr as i32)];
              prlen=pr;
            }
          }
        }
        let match:i64=0;
        if(withheld==0){
          if(prlen==(exl as i64)){
            if(byteeq2(oo,0,cb,t4+1,prlen)==1){match=1;}
          }
        }
        olen=appbytes(ob,olen,cb[at..t1]);
        olen=appbytes(ob,olen,"\t");
        olen=appbytes(ob,olen,cb[t3+1..t4]);
        olen=appbytes(ob,olen,"\t");
        olen=appbytes(ob,olen,pred);
        olen=appbytes(ob,olen,"\t");
        olen=appbytes(ob,olen,cb[t4+1..le]);
        olen=appbytes(ob,olen,"\t");
        if(match==1){olen=appbytes(ob,olen,"1");} else {olen=appbytes(ob,olen,"0");}
        olen=appbytes(ob,olen,"\t");
        if(withheld==1){olen=appbytes(ob,olen,"1");} else {olen=appbytes(ob,olen,"0");}
        olen=appbytes(ob,olen,"\n");
      }
    }
    at=en+1;
  }
  write_file(outp,ob,olen);
  z_free(ob);
  run_audit(st,ng);
  return 0;
}

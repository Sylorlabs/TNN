// hc.zag — H-C driver: teach.tsv probe.tsv out.tsv (shared harness interface).
// Learns one schema per RULEID group (grouped by id, never branching on it),
// applies to probes, writes out.tsv lines:
//   RULEID\tINPUT\tPREDICTED\tEXPECTED\tMATCH\tWITHHELD
// Withhold -> PREDICTED="?", WITHHELD=1, MATCH=0.
// Learn outcome per group is echoed to stdout as LEARN\t<id>\tOK|W<code>.
@import("hc_core.zag")

fn main()i32 {
  let teach:[]u8=_zag_arg(1);
  let probe:[]u8=_zag_arg(2);
  let outp:[]u8=_zag_arg(3);
  let st:[]u8=z_alloc(31430);
  let fb:[]u8=read_file(teach);
  let ng:i64=parse_teach(st,fb,fb.len);
  if(ng<0 || ng>12){
    emit("hc: too many groups\n");
    return 1;
  }
  learn_all(st,fb,ng);
  let pb:[]u8=read_file(probe);
  let ob:[]u8=z_alloc(1048576);
  let olen:i32=0;
  let tmp:[]u8=st[27494..27750];
  let at:i32=0;
  let plen:i32=pb.len;
  while(at<plen){
    let en:i32=at;
    while(en<plen && pb[en]!=10){en=en+1;}
    if(en>at){
      let le:i32=en;
      if(pb[le-1]==13){le=le-1;}
      let t1:i32=at;
      while(t1<le && pb[t1]!=9){t1=t1+1;}
      let t2:i32=t1+1;
      while(t2<le && pb[t2]!=9){t2=t2+1;}
      if(t1<le && t2<le){
        let idl:i32=t1-at; let inl:i32=t2-(t1+1); let exl:i32=le-(t2+1);
        if(idl>0 && idl<=31 && inl<=255 && exl<=255){
          let g:i64=find_group(st,pb,at,idl);
          let withheld:i64=1;
          let pred:[]u8="?" ;
          let prlen:i64=0;
          if(g>=0 && a8(st,(31366+g) as i32)>0){
            let sch:i64=a8(st,(31366+g) as i32)-1;
            let pr:i64=apply_sch(st,sch,pb,t1+1,inl as i64,tmp,0);
            if(pr>=0){
              withheld=0;
              pred=tmp[0..(pr as i32)];
              prlen=pr;
            }
          }
          let match:i64=0;
          if(withheld==0){
            if(prlen==(exl as i64)){
              if(byteeq2(tmp,0,pb,t2+1,prlen)==1){match=1;}
            }
          }
          olen=appbytes(ob,olen,pb[at..t1]);
          olen=appbytes(ob,olen,"\t");
          olen=appbytes(ob,olen,pb[t1+1..t2]);
          olen=appbytes(ob,olen,"\t");
          olen=appbytes(ob,olen,pred);
          olen=appbytes(ob,olen,"\t");
          olen=appbytes(ob,olen,pb[t2+1..le]);
          olen=appbytes(ob,olen,"\t");
          if(match==1){olen=appbytes(ob,olen,"1");} else {olen=appbytes(ob,olen,"0");}
          olen=appbytes(ob,olen,"\t");
          if(withheld==1){olen=appbytes(ob,olen,"1");} else {olen=appbytes(ob,olen,"0");}
          olen=appbytes(ob,olen,"\n");
        }
      }
    }
    at=en+1;
  }
  write_file(outp,ob,olen);
  z_free(ob);
  return 0;
}

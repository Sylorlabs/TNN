// saltlab.zag — unified salt battery instrument for the combiner-architecture line.
// Pure Zag, zero RNG. Builds fixtures, checks Job-3-style gates, and runs
// memorizer red-team agents — one binary for all 8 salt arms.
//
// Modes:
//   saltlab gen <arm>        writes teach.tsv p0.tsv p1.tsv p2.tsv in cwd
//   saltlab gates <arm>       prints G1/G2'/G3/G5/TSV report; rc=0 iff all pass
//   saltlab mem <class> <arm> runs memorizer class over fixtures in cwd
//
// Arms: A C B D26 D256 Esub Eaff Exor
//   A    = Job-3 affine   97+mod26(7i + C1 k + k^2)
//   C    = Job-3 quadratic 97+mod26(7i + C1 k + C2 k^2)
//   B    = Job-3 cubic    97+mod26(7i + C1 k + C2 k^2 + C3 k^3)
//   D26  = H-A fresh:     97+mod26(7i + C1 k + J(k)), J=0 k<2 else C2
//   D256 = canonical piecewise: clean + (A1 k + B1 k^2 | A2 k + B2 k^2) mod 256, split k<n/2
//   Esub = H-A fresh:     parity per-phase alphabet permutation of clean letter
//   Eaff = H-B fresh:     (37*clean + 11) mod 256
//   Exor = H-C fresh:     clean XOR ROTL8(K, k mod 8), K=(Kbase+41*idx) mod 256
// Phases: 0=train 1=P0 2=P1 3=P2
// Rules: 0 reverse 1 dupfirst 2 rotleft 3 droplast 4 upperfirst 5 sortchars
//        6 swapfl (swap first/last) 7 sortdesc
// P0: frozen Job-3 index list x rules 0..5 (48). P1: 30 ordered pairs x 4 lengths (120).
// P2: swapfl x4 + sortdesc x4 (8).
//
// Memorizer classes: aff26 quad26 cubic26 (mod-26, letter arms),
//                    aff256 quad256 cubic256 (mod-256, byte arms),
//                    freedelta (per-position taught-output deltas, all arms).
// aff26 is the exact Job-3 frozen memorizer (fit_affine + transform_out + mem_p0/mem_p2).

// ---------- memory helpers ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn emitb(b:[]u8,n:i32)void { _zag_print(b[0..n]); return; }
fn streq(a:[]u8,b:[]u8)i64 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn appb(buf:[]u8,at:i32,b:u8)i32 { buf[at]=b; return at+1; }
fn appbuf(buf:[]u8,at:i32,src:[]u8,n:i32)i32 {
  let k:i32=0;
  while(k<n){buf[at+k]=src[k];k=k+1;}
  return at+n;
}
fn appi64(buf:[]u8,at:i32,v:i64)i32 {
  let s:[]u8=i64s(v);
  return appbuf(buf,at,s,s.len);
}
// ---------- file IO (raw syscalls; same pattern as hc_core.zag) ----------
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn write_file(path:[]u8,data:[]u8,len:i32)i64 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),577,420,0,0,0);
  z_free(cp);
  if(fd<0){return -1;}
  let w:i32=0;
  while(w<len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+(w as i64),(len-w) as i64,0,0,0);
    if(n<=0){w=len;} else {w=w+(n as i32);}
  }
  _zag_raw_syscall(3,fd,0,0,0,0,0);
  return 0;
}
// ---------- modular arithmetic ----------
fn pmod26(v:i32)i32 {
  let t:i32=v%26;
  if(t<0){t=t+26;}
  return t;
}
fn pmod(v:i64,m:i64)i64 {
  let t:i64=v%m;
  if(t<0){t=t+m;}
  return t;
}
// ---------- salt constants ----------
// Job-3 frozen C1/C2/C3 (verbatim from affine_test.zag)
fn sc1(ph:i32)i32 {
  if(ph==0){return 13;}
  if(ph==1){return 17;}
  if(ph==2){return 19;}
  return 23;
}
fn sc2(ph:i32)i32 {
  if(ph==0){return 3;}
  if(ph==1){return 5;}
  if(ph==2){return 7;}
  return 11;
}
fn sc3(ph:i32)i32 {
  if(ph==0){return 2;}
  if(ph==1){return 3;}
  if(ph==2){return 6;}
  return 7;
}
// D256 canonical piecewise constants, per phase: (A1,B1,A2,B2).
// Chosen by deterministic search: zero TSV-hazard bytes on teach + frozen P0,
// zero byte-sorted P0 tokens, (A1,B1)!=(A2,B2) per phase, real kink.
fn d256c(ph:i32,w:i32)i32 {
  if(ph==0){
    if(w==0){return 3;} if(w==1){return 3;}
    if(w==2){return 11;} return 233;
  }
  if(ph==1){
    if(w==0){return 5;} if(w==1){return 3;}
    if(w==2){return 7;} return 233;
  }
  if(ph==2){
    if(w==0){return 7;} if(w==1){return 3;}
    if(w==2){return 3;} return 237;
  }
  if(w==0){return 11;} if(w==1){return 3;}
  if(w==2){return 3;} return 237;
}
// Esub: H-A frozen per-phase parity permutations (verbatim from HYPOTHESIS.md)
fn esub_str(ph:i32)[]u8 {
  if(ph==0){return "pvwmxkyiudjblonfrzategcqsh";}
  if(ph==1){return "kjvbszgqxnrplodfmwyiuhteca";}
  if(ph==2){return "dwyanrvzuctqjigobmxfplkseh";}
  return "qxejzibkndmthrfylgwaovspcu";
}
// Eaff: H-B fresh salt is the value permutation with PHASE-INDEXED parameters.
// The hypothesis writes S(b)=(37b+11)%256 without a phase index; the train phase
// keeps that literal instance, and P0/P1/P2 use distinct invertible multipliers
// and addends. (A single fixed permutation would leave zero cross-phase salt,
// and the clean token's period-26 aliasing would collapse G1.)
fn eaff_m(ph:i32)i32 {
  if(ph==0){return 37;}
  if(ph==1){return 13;}
  if(ph==2){return 53;}
  return 91;
}
fn eaff_a(ph:i32)i32 {
  if(ph==0){return 11;}
  if(ph==1){return 7;}
  if(ph==2){return 29;}
  return 3;
}
// Exor key bases per phase (train, P0, P1, P2); per-item K=(Kb+41*(idx%256))%256.
// Chosen: zero TSV-hazard bytes on teach (ph0) / frozen P0 (ph1..3), all distinct.
fn kbase(ph:i32)i32 {
  if(ph==0){return 58;}
  if(ph==1){return 29;}
  if(ph==2){return 45;}
  return 161;
}
// ---------- tokens ----------
fn toklen(i:i32)i32 { return 2+(i%4); }
fn cleanbyte(i:i32,k:i32)i32 { return 97+pmod26(7*i+11*k); }
fn rotl8(v:i32,r:i32)i32 {
  let rr:i32=r%8;
  if(rr<0){rr=rr+8;}
  if(rr==0){return v&255;}
  return (((v<<rr)|(v>>(8-rr)))&255);
}
fn arm_of(a:[]u8)i32 {
  if(streq(a,"A")==1){return 0;}
  if(streq(a,"B")==1){return 1;}
  if(streq(a,"C")==1){return 2;}
  if(streq(a,"D26")==1){return 3;}
  if(streq(a,"D256")==1){return 4;}
  if(streq(a,"Esub")==1){return 5;}
  if(streq(a,"Eaff")==1){return 6;}
  if(streq(a,"Exor")==1){return 7;}
  return -1;
}
fn arm_is_letter(arm:i32)i32 {
  if(arm==0){return 1;}
  if(arm==2){return 1;}
  if(arm==1){return 1;}
  if(arm==3){return 1;}
  if(arm==5){return 1;}
  return 0;
}
fn arm_mod(arm:i32)i64 {
  if(arm_is_letter(arm)==1){return 26;}
  return 256;
}
// salt_token: fill out[0..n) with the salted token bytes; returns n.
fn salt_token(arm:i32,ph:i32,idx:i32,out:[]u8)i32 {
  let n:i32=toklen(idx);
  let k:i32=0;
  while(k<n){
    let b:i32=0;
    if(arm==0){ b=97+pmod26(7*idx+sc1(ph)*k+k*k); }
    else if(arm==1){ b=97+pmod26(7*idx+sc1(ph)*k+sc2(ph)*k*k+sc3(ph)*k*k*k); }
    else if(arm==2){ b=97+pmod26(7*idx+sc1(ph)*k+sc2(ph)*k*k); }
    else if(arm==3){
      let j:i32=0;
      if(k>=2){j=sc2(ph);}
      b=97+pmod26(7*idx+sc1(ph)*k+j);
    }
    else if(arm==4){
      let pc:i64=0;
      if(k*2<n){ pc=(d256c(ph,0) as i64)*k+(d256c(ph,1) as i64)*k*k; }
      else { pc=(d256c(ph,2) as i64)*k+(d256c(ph,3) as i64)*k*k; }
      b=(pmod((cleanbyte(idx,k) as i64)+pc,256)) as i32;
    }
    else if(arm==5){
      let ps:[]u8=esub_str(ph);
      b=(ps[pmod26(7*idx+11*k)] as i32);
    }
    else if(arm==6){ b=(pmod((eaff_m(ph) as i64)*(cleanbyte(idx,k) as i64)+(eaff_a(ph) as i64),256)) as i32; }
    else {
      let K:i32=(kbase(ph)+41*(idx%256))%256;
      let kj:i32=rotl8(K,k%8);
      b=cleanbyte(idx,k)^kj;
    }
    out[k]=b as u8;
    k=k+1;
  }
  return n;
}
// Exor scan guard: skip items whose per-item key is 0 (would be unsalted).
fn exor_k_ok(arm:i32,ph:i32,idx:i32)i32 {
  if(arm!=7){return 1;}
  let K:i32=(kbase(ph)+41*(idx%256))%256;
  if(K==0){return 0;}
  return 1;
}
fn bytes_ok(buf:[]u8,n:i32)i32 {
  let k:i32=0;
  while(k<n){
    let b:u8=buf[k];
    if(b==0){return 0;}
    if(b==9){return 0;}
    if(b==10){return 0;}
    if(b==13){return 0;}
    k=k+1;
  }
  return 1;
}
// ---------- rules (byte-exact; sortchars = Job-3 selection sort) ----------
fn upb(b:u8)u8 {
  if(b>=97 && b<=122){return (b-32) as u8;}
  return b;
}
fn apply_rule(r:i32,src:[]u8,n:i32,dst:[]u8)i32 {
  let k:i32=0;
  if(r==0){
    while(k<n){dst[k]=src[n-1-k];k=k+1;}
    return n;
  }
  if(r==1){
    dst[0]=src[0];
    while(k<n){dst[k+1]=src[k];k=k+1;}
    return n+1;
  }
  if(r==2){
    if(n==0){return 0;}
    while(k<n-1){dst[k]=src[k+1];k=k+1;}
    dst[n-1]=src[0];
    return n;
  }
  if(r==3){
    while(k<n-1){dst[k]=src[k];k=k+1;}
    return n-1;
  }
  if(r==4){
    while(k<n){dst[k]=src[k];k=k+1;}
    if(n>0){dst[0]=upb(src[0]);}
    return n;
  }
  if(r==5){
    while(k<n){dst[k]=src[k];k=k+1;}
    let i:i32=0;
    while(i<n-1){
      let m:i32=i;
      let j2:i32=i+1;
      while(j2<n){if(dst[j2]<dst[m]){m=j2;}j2=j2+1;}
      let t:u8=dst[i];
      dst[i]=dst[m];
      dst[m]=t;
      i=i+1;
    }
    return n;
  }
  if(r==6){
    while(k<n){dst[k]=src[k];k=k+1;}
    if(n>=2){dst[0]=src[n-1];dst[n-1]=src[0];}
    return n;
  }
  while(k<n){dst[k]=src[k];k=k+1;}
  let i2:i32=0;
  while(i2<n-1){
    let m2:i32=i2;
    let j3:i32=i2+1;
    while(j3<n){if(dst[j3]>dst[m2]){m2=j3;}j3=j3+1;}
    let t2:u8=dst[i2];
    dst[i2]=dst[m2];
    dst[m2]=t2;
    i2=i2+1;
  }
  return n;
}
fn is_sorted_asc(b:[]u8,n:i32)i32 {
  let k:i32=0;
  while(k<n-1){if(b[k]>b[k+1]){return 0;}k=k+1;}
  return 1;
}
fn bufeq(a:[]u8,an:i32,b:[]u8,bn:i32)i32 {
  if(an!=bn){return 0;}
  let k:i32=0;
  while(k<an){if(a[k]!=b[k]){return 0;}k=k+1;}
  return 1;
}
// ---------- frozen Job-3 P0 index list (verbatim) ----------
fn p0str()[]u8 {
  return "100,101,102,103,105,106,107,109,110,111,113,114,115,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151";
}
fn p0_index(j:i32)i32 {
  let s:[]u8=p0str();
  let at:i32=0;
  let cur:i32=0;
  let v:i32=0;
  let n:i32=0;
  while(at<s.len){
    let c:u8=s[at];
    if(c==44){
      if(cur==j){return v;}
      cur=cur+1;
      v=0;
    } else {
      v=v*10+((c-48) as i32);
    }
    at=at+1;
  }
  return v;
}
fn train_index(ti:i32)i32 {
  if(ti<6){return ti;}
  return 700+(ti-6);
}
// P0 probe item for rule r (0..5), slot j (0..7): Job-3 partitions the frozen
// 48-index list into 6 rule blocks of 8.
fn p0_probe_index(r:i32,j:i32)i32 {
  return p0_index(r*8+j);
}
fn pair_a(pi:i32)i32 { return pi/5; }
fn pair_b(pi:i32)i32 {
  let a:i32=pi/5;
  let q:i32=pi%5;
  let b:i32=q;
  if(q>=a){b=q+1;}
  return b;
}

// P1 item (pi 0..29, jj 0..3): first idx >= 200+pi*4+jj with toklen==2+jj,
// hazard-free bytes, and (Exor) nonzero per-item key.
fn p1_index(arm:i32,pi:i32,jj:i32) i32 {
  let L:i32=2+jj;
  let idx:i32=200+pi*4+jj;
  let tmp:[]u8=z_alloc(16);
  let go:i32=1;
  while(go==1){
    let n:i32=toklen(idx);
    if(n==L){
      let nn:i32=salt_token(arm,2,idx,tmp);
      if(bytes_ok(tmp,nn)==1 && exor_k_ok(arm,2,idx)==1){go=0;}
      else {idx=idx+1;}
    } else {idx=idx+1;}
  }
  z_free(tmp);
  return idx;
}
// P2 item (q 0..7): first idx >= 400+q with toklen==2+(q%4), hazard-free, Exor key ok.
fn p2_index(arm:i32,q:i32)i32 {
  let L:i32=2+(q%4);
  let idx:i32=400+q;
  let tmp:[]u8=z_alloc(16);
  let go:i32=1;
  while(go==1){
    let n:i32=toklen(idx);
    if(n==L){
      let nn:i32=salt_token(arm,3,idx,tmp);
      if(bytes_ok(tmp,nn)==1 && exor_k_ok(arm,3,idx)==1){go=0;}
      else {idx=idx+1;}
    } else {idx=idx+1;}
  }
  z_free(tmp);
  return idx;
}
// ---------- degree-1 fit (native mod M) ----------
// returns 1 and fills so[0]=slope, so[1]=offset iff an affine fit exists
// ---------- fixture generation ----------
// Teach row: "r{R}\t{in}\t{out}\n". Probe row: same shape with EXPECTED as {out}.
fn gen_row(buf:[]u8,at:i32,lab:[]u8,src:[]u8,n:i32,out:[]u8,m:i32)i32 {
  at=appbuf(buf,at,lab,lab.len);
  at=appb(buf,at,9);
  at=appbuf(buf,at,src,n);
  at=appb(buf,at,9);
  at=appbuf(buf,at,out,m);
  at=appb(buf,at,10);
  return at;
}
fn rule_label(r:i32,lab:[]u8)i32 {
  lab[0]=114;
  lab[1]=(48+r) as u8;
  return 2;
}
fn pair_label(a:i32,b:i32,lab:[]u8)i32 {
  lab[0]=114;
  lab[1]=(48+a) as u8;
  lab[2]=43;
  lab[3]=114;
  lab[4]=(48+b) as u8;
  return 5;
}
// clean_token: the unsalted base token (arm-independent).
fn clean_token(idx:i32,out:[]u8)i32 {
  let n:i32=toklen(idx);
  let k:i32=0;
  while(k<n){
    out[k]=cleanbyte(idx,k) as u8;
    k=k+1;
  }
  return n;
}
// gen_clean_arm: teach.tsv from CLEAN tokens (H-B/H-C preregistered protocol);
// probes salted exactly as in gen_arm.
fn gen_clean_arm(arm:i32)void {
  let buf:[]u8=z_alloc(65536);
  let tok:[]u8=z_alloc(16);
  let out:[]u8=z_alloc(16);
  let mid:[]u8=z_alloc(16);
  let lab:[]u8=z_alloc(8);
  let at:i32=0;
  let ti:i32=0;
  while(ti<12){
    let idx:i32=train_index(ti);
    let n:i32=clean_token(idx,tok);
    let r:i32=0;
    while(r<8){
      let m:i32=apply_rule(r,tok,n,out);
      let ll:i32=rule_label(r,lab);
      at=gen_row(buf,at,lab[0..ll],tok,n,out,m);
      r=r+1;
    }
    ti=ti+1;
  }
  write_file("teach.tsv",buf,at);
  // probes: identical to gen_arm (salted)
  at=0;
  let r0b:i32=0;
  while(r0b<6){
    let j0b:i32=0;
    while(j0b<8){
      let idx2:i32=p0_probe_index(r0b,j0b);
      let n2:i32=salt_token(arm,1,idx2,tok);
      let m2:i32=apply_rule(r0b,tok,n2,out);
      let ll2:i32=rule_label(r0b,lab);
      at=gen_row(buf,at,lab[0..ll2],tok,n2,out,m2);
      j0b=j0b+1;
    }
    r0b=r0b+1;
  }
  write_file("p0.tsv",buf,at);
  at=0;
  let pi:i32=0;
  while(pi<30){
    let a:i32=pair_a(pi);
    let b:i32=pair_b(pi);
    let jj:i32=0;
    while(jj<4){
      let idx3:i32=p1_index(arm,pi,jj);
      let n4:i32=salt_token(arm,2,idx3,tok);
      let m1n:i32=apply_rule(a,tok,n4,mid);
      let en:i32=apply_rule(b,mid,m1n,out);
      let ll3:i32=pair_label(a,b,lab);
      at=gen_row(buf,at,lab[0..ll3],tok,n4,out,en);
      jj=jj+1;
    }
    pi=pi+1;
  }
  write_file("p1.tsv",buf,at);
  at=0;
  let q:i32=0;
  while(q<8){
    let r3:i32=6;
    if(q>=4){r3=7;}
    let idx4:i32=p2_index(arm,q);
    let n6:i32=salt_token(arm,3,idx4,tok);
    let m3:i32=apply_rule(r3,tok,n6,out);
    let ll4:i32=rule_label(r3,lab);
    at=gen_row(buf,at,lab[0..ll4],tok,n6,out,m3);
    q=q+1;
  }
  write_file("p2.tsv",buf,at);
  z_free(buf);
  z_free(tok);
  z_free(out);
  z_free(mid);
  z_free(lab);
  emit("gen_clean ok\n");
  return;
}
fn gen_arm(arm:i32)void {
  let buf:[]u8=z_alloc(65536);
  let tok:[]u8=z_alloc(16);
  let out:[]u8=z_alloc(16);
  let mid:[]u8=z_alloc(16);
  let lab:[]u8=z_alloc(8);
  let at:i32=0;
  // teach.tsv: 12 tokens x 8 rules
  let ti:i32=0;
  while(ti<12){
    let idx:i32=train_index(ti);
    let n:i32=salt_token(arm,0,idx,tok);
    let r:i32=0;
    while(r<8){
      let m:i32=apply_rule(r,tok,n,out);
      let ll:i32=rule_label(r,lab);
      at=gen_row(buf,at,lab[0..ll],tok,n,out,m);
      r=r+1;
    }
    ti=ti+1;
  }
  write_file("teach.tsv",buf,at);
  // p0.tsv: 6 rules x 8 items (Job-3 partition of the frozen 48)
  at=0;
  let r0b:i32=0;
  while(r0b<6){
    let j0b:i32=0;
    while(j0b<8){
      let idx2:i32=p0_probe_index(r0b,j0b);
      let n2:i32=salt_token(arm,1,idx2,tok);
      let m2:i32=apply_rule(r0b,tok,n2,out);
      let ll2:i32=rule_label(r0b,lab);
      at=gen_row(buf,at,lab[0..ll2],tok,n2,out,m2);
      j0b=j0b+1;
    }
    r0b=r0b+1;
  }
  write_file("p0.tsv",buf,at);
  // p1.tsv: 30 ordered pairs x 4 lengths, scanned from 200+pi*4+j
  at=0;
  let pi:i32=0;
  while(pi<30){
    let a:i32=pair_a(pi);
    let b:i32=pair_b(pi);
    let jj:i32=0;
    while(jj<4){
      let idx3:i32=p1_index(arm,pi,jj);
      let n4:i32=salt_token(arm,2,idx3,tok);
      let m1n:i32=apply_rule(a,tok,n4,mid);
      let en:i32=apply_rule(b,mid,m1n,out);
      let ll3:i32=pair_label(a,b,lab);
      at=gen_row(buf,at,lab[0..ll3],tok,n4,out,en);
      jj=jj+1;
    }
    pi=pi+1;
  }
  write_file("p1.tsv",buf,at);
  // p2.tsv: swapfl x4 + sortdesc x4, scanned from 400+j
  at=0;
  let q:i32=0;
  while(q<8){
    let r3:i32=6;
    if(q>=4){r3=7;}
    let idx4:i32=p2_index(arm,q);
    let n6:i32=salt_token(arm,3,idx4,tok);
    let m3:i32=apply_rule(r3,tok,n6,out);
    let ll4:i32=rule_label(r3,lab);
    at=gen_row(buf,at,lab[0..ll4],tok,n6,out,m3);
    q=q+1;
  }
  write_file("p2.tsv",buf,at);
  z_free(buf);
  z_free(tok);
  z_free(out);
  z_free(mid);
  z_free(lab);
  emit("gen ok\n");
  return;
}

// derived from k=0,1 and verified on all k>=2.
fn fit_lin(p:[]u8,pn:i32,t:[]u8,tn:i32,M:i64,so:[]u8)i32 {
  if(pn!=tn){return 0;}
  if(pn<2){return 0;}
  let d0:i64=pmod((p[0] as i64)-(t[0] as i64),M);
  let d1:i64=pmod((p[1] as i64)-(t[1] as i64),M);
  let s:i64=pmod(d1-d0,M);
  let k:i32=2;
  while(k<pn){
    let dk:i64=pmod((p[k] as i64)-(t[k] as i64),M);
    if(dk!=pmod(d0+s*(k as i64),M)){return 0;}
    k=k+1;
  }
  so[0]=s as u8;
  so[1]=d0 as u8;
  return 1;
}
// ---------- gates ----------
// G1: no probe token byte-identical to any same-length train token. Returns violations.
fn gate_g1(arm:i32)i32 {
  let tt:[]u8=z_alloc(16);
  let pr:[]u8=z_alloc(16);
  let bad:i32=0;
  let ti:i32=0;
  while(ti<12){
    let tn:i32=salt_token(arm,0,train_index(ti),tt);
    let j:i32=0;
    while(j<48){
      let pn:i32=salt_token(arm,1,p0_index(j),pr);
      if(pn==tn && bufeq(tt,tn,pr,pn)==1){bad=bad+1;}
      j=j+1;
    }
    let pi:i32=0;
    while(pi<30){
      let jj:i32=0;
      while(jj<4){
        let pn2:i32=salt_token(arm,2,p1_index(arm,pi,jj),pr);
        if(pn2==tn && bufeq(tt,tn,pr,pn2)==1){bad=bad+1;}
        jj=jj+1;
      }
      pi=pi+1;
    }
    let q:i32=0;
    while(q<8){
      let pn3:i32=salt_token(arm,3,p2_index(arm,q),pr);
      if(pn3==tn && bufeq(tt,tn,pr,pn3)==1){bad=bad+1;}
      q=q+1;
    }
    ti=ti+1;
  }
  z_free(tt);
  z_free(pr);
  return bad;
}
// G2': count of non-vacuous degree-1 fits of any probe vs any same-length
// train token (native mod space; length>=3; verified on k>=2).
fn gate_g2p(arm:i32)i32 {
  let M:i64=arm_mod(arm);
  let tt:[]u8=z_alloc(16);
  let pr:[]u8=z_alloc(16);
  let so:[]u8=z_alloc(2);
  let fits:i32=0;
  let ti:i32=0;
  while(ti<12){
    let tn:i32=salt_token(arm,0,train_index(ti),tt);
    if(tn>=3){
      let j:i32=0;
      while(j<48){
        let pn:i32=salt_token(arm,1,p0_index(j),pr);
        if(pn==tn && fit_lin(pr,pn,tt,tn,M,so)==1){fits=fits+1;}
        j=j+1;
      }
      let pi:i32=0;
      while(pi<30){
        let jj:i32=0;
        while(jj<4){
          let pn2:i32=salt_token(arm,2,p1_index(arm,pi,jj),pr);
          if(pn2==tn && fit_lin(pr,pn2,tt,tn,M,so)==1){fits=fits+1;}
          jj=jj+1;
        }
        pi=pi+1;
      }
      let q:i32=0;
      while(q<8){
        let pn3:i32=salt_token(arm,3,p2_index(arm,q),pr);
        if(pn3==tn && fit_lin(pr,pn3,tt,tn,M,so)==1){fits=fits+1;}
        q=q+1;
      }
    }
    ti=ti+1;
  }
  z_free(tt);
  z_free(pr);
  z_free(so);
  return fits;
}
// G3: constant non-degeneracy per arm. Returns 1 iff all checks pass.
fn gate_g3(arm:i32)i32 {
  if(arm==0 || arm==1 || arm==2){
    let ph:i32=0;
    while(ph<4){
      let q:i32=ph+1;
      while(q<4){
        if(pmod26(sc1(ph)-sc1(q))==0){return 0;}
        if(arm==1 || arm==2){
          if(pmod26(sc2(ph)-sc2(q))==0){return 0;}
        }
        if(arm==1){
          if(pmod26(sc3(ph)-sc3(q))==0){return 0;}
          let sd:i32=2*(sc2(ph)-sc2(q))+6*(sc3(ph)-sc3(q));
          if(pmod26(sd)==0){return 0;}
        }
        q=q+1;
      }
      ph=ph+1;
    }
    return 1;
  }
  if(arm==3){
    let ph2:i32=0;
    while(ph2<4){
      let q2:i32=ph2+1;
      while(q2<4){
        let d:i32=pmod26(sc2(ph2)-sc2(q2));
        if(d==0){return 0;}
        if(d==13){return 0;}
        q2=q2+1;
      }
      ph2=ph2+1;
    }
    return 1;
  }
  if(arm==4){
    let ph3:i32=0;
    while(ph3<4){
      if(d256c(ph3,0)==d256c(ph3,2) && d256c(ph3,1)==d256c(ph3,3)){return 0;}
      ph3=ph3+1;
    }
    return 1;
  }
  if(arm==5){
    // each phase: true permutation (26 distinct)
    let ph4:i32=0;
    while(ph4<4){
      let ps:[]u8=esub_str(ph4);
      if(ps.len!=26){return 0;}
      let seen:[]u8=z_alloc(256);
      let k:i32=0;
      while(k<26){
        let b:u8=ps[k];
        if(seen[b as i32]==1){z_free(seen);return 0;}
        seen[b as i32]=1;
        k=k+1;
      }
      z_free(seen);
      ph4=ph4+1;
    }
    // pairwise cross-phase difference non-constant
    let a2:i32=0;
    while(a2<4){
      let b2:i32=a2+1;
      while(b2<4){
        let pa:[]u8=esub_str(a2);
        let pb:[]u8=esub_str(b2);
        let d0:i32=(pb[0] as i32)-(pa[0] as i32);
        let k2:i32=1;
        let allsame:i32=1;
        while(k2<26){
          if((pb[k2] as i32)-(pa[k2] as i32)!=d0){allsame=0;}
          k2=k2+1;
        }
        if(allsame==1){return 0;}
        b2=b2+1;
      }
      a2=a2+1;
    }
    return 1;
  }
  if(arm==6){
    // multipliers invertible mod 256 (odd) and (M,A) pairs distinct per phase
    let ph6:i32=0;
    while(ph6<4){
      if(eaff_m(ph6)%2==0){return 0;}
      let q4:i32=ph6+1;
      while(q4<4){
        if(eaff_m(ph6)==eaff_m(q4) && eaff_a(ph6)==eaff_a(q4)){return 0;}
        q4=q4+1;
      }
      ph6=ph6+1;
    }
    return 1;
  }
  // arm 7: key bases distinct across phases; no zero-K on teach/P0 items
  let ph5:i32=0;
  while(ph5<4){
    let q3:i32=ph5+1;
    while(q3<4){
      if(kbase(ph5)==kbase(q3)){return 0;}
      q3=q3+1;
    }
    ph5=ph5+1;
  }
  let ti2:i32=0;
  while(ti2<12){
    if(exor_k_ok(arm,0,train_index(ti2))==0){return 0;}
    ti2=ti2+1;
  }
  let j2:i32=0;
  while(j2<48){
    if(exor_k_ok(arm,1,p0_index(j2))==0){return 0;}
    j2=j2+1;
  }
  return 1;
}
// G5: count of frozen-P0 probe tokens that are byte-sorted ascending (informational).
fn gate_g5(arm:i32)i32 {
  let pr:[]u8=z_alloc(16);
  let s:i32=0;
  let j:i32=0;
  while(j<48){
    let pn:i32=salt_token(arm,1,p0_index(j),pr);
    if(is_sorted_asc(pr,pn)==1){s=s+1;}
    j=j+1;
  }
  z_free(pr);
  return s;
}
// TSV: count of hazard bytes across all generated fixtures (teach+P0+P1+P2).
fn gate_tsv(arm:i32)i32 {
  let tk:[]u8=z_alloc(16);
  let bad:i32=0;
  let ti:i32=0;
  while(ti<12){
    let n:i32=salt_token(arm,0,train_index(ti),tk);
    if(bytes_ok(tk,n)==0){bad=bad+1;}
    ti=ti+1;
  }
  let j:i32=0;
  while(j<48){
    let n2:i32=salt_token(arm,1,p0_index(j),tk);
    if(bytes_ok(tk,n2)==0){bad=bad+1;}
    j=j+1;
  }
  let pi:i32=0;
  while(pi<30){
    let jj:i32=0;
    while(jj<4){
      let n3:i32=salt_token(arm,2,p1_index(arm,pi,jj),tk);
      if(bytes_ok(tk,n3)==0){bad=bad+1;}
      jj=jj+1;
    }
    pi=pi+1;
  }
  let q:i32=0;
  while(q<8){
    let n4:i32=salt_token(arm,3,p2_index(arm,q),tk);
    if(bytes_ok(tk,n4)==0){bad=bad+1;}
    q=q+1;
  }
  z_free(tk);
  return bad;
}
fn gates_arm(arm:i32,aname:[]u8)i32 {
  let g1:i32=gate_g1(arm);
  let g2:i32=gate_g2p(arm);
  let g3:i32=gate_g3(arm);
  let g5:i32=gate_g5(arm);
  let ts:i32=gate_tsv(arm);
  emit("GATE G1 ");emit(i64s(g1 as i64));emit("\n");
  emit("GATE G2p ");emit(i64s(g2 as i64));emit("\n");
  emit("GATE G3 ");emit(i64s(g3 as i64));emit("\n");
  emit("GATE G5sorted ");emit(i64s(g5 as i64));emit("\n");
  emit("GATE TSV ");emit(i64s(ts as i64));emit("\n");
  let pass:i32=1;
  if(g1>0){pass=0;}
  if(arm!=0 && g2>0){pass=0;}
  if(g3==0){pass=0;}
  if(ts>0){pass=0;}
  if(pass==1){emit("GATES PASS\n");} else {emit("GATES FAIL\n");}
  return pass;
}

// ---------- memorizer ----------
// Classes: 0 aff26 1 quad26 2 cubic26 3 aff256 4 quad256 5 cubic256 6 freedelta
fn class_of(c:[]u8)i32 {
  if(streq(c,"aff26")==1){return 0;}
  if(streq(c,"quad26")==1){return 1;}
  if(streq(c,"cubic26")==1){return 2;}
  if(streq(c,"aff256")==1){return 3;}
  if(streq(c,"quad256")==1){return 4;}
  if(streq(c,"cubic256")==1){return 5;}
  if(streq(c,"freedelta")==1){return 6;}
  return -1;
}
fn class_degree(cls:i32)i32 {
  if(cls==0 || cls==3){return 1;}
  if(cls==1 || cls==4){return 2;}
  if(cls==2 || cls==5){return 3;}
  return 0;
}
fn class_mod(cls:i32)i64 {
  if(cls<3){return 26;}
  return 256;
}
// fit_mod: degree-d polynomial fit of probe vs train token in mod M.
// prm gets (o,s,q,c) as u8. Returns 1 iff derived from k=0..d and verified on k>d.
fn fit_mod(p:[]u8,pn:i32,t:[]u8,tn:i32,M:i64,d:i32,prm:[]u8)i32 {
  if(pn!=tn){return 0;}
  if(pn<d+1){return 0;}
  let d0:i64=pmod((p[0] as i64)-(t[0] as i64),M);
  let d1:i64=pmod((p[1] as i64)-(t[1] as i64),M);
  if(d==1){
    let s:i64=pmod(d1-d0,M);
    let k:i32=2;
    while(k<pn){
      if(pmod((p[k] as i64)-(t[k] as i64),M)!=pmod(d0+s*(k as i64),M)){return 0;}
      k=k+1;
    }
    prm[0]=d0 as u8;
    prm[1]=s as u8;
    return 1;
  }
  let d2:i64=pmod((p[2] as i64)-(t[2] as i64),M);
  if(d==2){
    let q:i64=0;
    while(q<M){
      let s2:i64=pmod(d1-d0-q,M);
      if(pmod(d0+2*s2+4*q,M)==d2){
        let k2:i32=3;
        let ok:i32=1;
        while(k2<pn){
          if(pmod((p[k2] as i64)-(t[k2] as i64),M)!=pmod(d0+s2*(k2 as i64)+q*(k2 as i64)*(k2 as i64),M)){ok=0;}
          k2=k2+1;
        }
        if(ok==1){
          prm[0]=d0 as u8;
          prm[1]=s2 as u8;
          prm[2]=q as u8;
          return 1;
        }
      }
      q=q+1;
    }
    return 0;
  }
  // d==3
  let d3:i64=pmod((p[3] as i64)-(t[3] as i64),M);
  let q2:i64=0;
  while(q2<M){
    let c:i64=0;
    while(c<M){
      let s3:i64=pmod(d1-d0-q2-c,M);
      if(pmod(d0+2*s3+4*q2+8*c,M)==d2 && pmod(d0+3*s3+9*q2+27*c,M)==d3){
        let k3:i32=4;
        let ok2:i32=1;
        while(k3<pn){
          let kk:i64=k3 as i64;
          if(pmod((p[k3] as i64)-(t[k3] as i64),M)!=pmod(d0+s3*kk+q2*kk*kk+c*kk*kk*kk,M)){ok2=0;}
          k3=k3+1;
        }
        if(ok2==1){
          prm[0]=d0 as u8;
          prm[1]=s3 as u8;
          prm[2]=q2 as u8;
          prm[3]=c as u8;
          return 1;
        }
      }
      c=c+1;
    }
    q2=q2+1;
  }
  return 0;
}
// xform: apply fitted params to a taught output. Mod 26 uses the exact Job-3
// case-space transform; mod 256 is raw byte arithmetic.
fn xform(src:[]u8,sn:i32,prm:[]u8,d:i32,M:i64,dst:[]u8)i32 {
  let o:i64=prm[0] as i64;
  let s:i64=prm[1] as i64;
  let q:i64=0;
  let c:i64=0;
  if(d>=2){q=prm[2] as i64;}
  if(d>=3){c=prm[3] as i64;}
  let k:i32=0;
  while(k<sn){
    let kk:i64=k as i64;
    let sh:i64=o+s*kk+q*kk*kk+c*kk*kk*kk;
    if(M==26){
      let b:i32=src[k] as i32;
      let base:i32=97;
      if(b>=65 && b<=90){base=65;}
      dst[k]=(base+(pmod((b-base) as i64+sh,26) as i32)) as u8;
    } else {
      dst[k]=(pmod((src[k] as i64)+sh,256) as i32) as u8;
    }
    k=k+1;
  }
  return sn;
}
// Teach tables: tin[12][8], tnl[12], tout[12][8][8], tln[12][8].
// parse_teach fills them from teach.tsv data. Returns 1 iff 96 rows parsed.
fn parse_teach(data:[]u8,tin:[]u8,tnl:[]u8,tout:[]u8,tln:[]u8)i32 {
  let at:i32=0;
  let rows:i32=0;
  while(at<data.len && rows<96){
    let le:i32=at;
    while(le<data.len && data[le]!=10){le=le+1;}
    let t1:i32=at;
    while(t1<le && data[t1]!=9){t1=t1+1;}
    let t2:i32=t1+1;
    while(t2<le && data[t2]!=9){t2=t2+1;}
    let lab:[]u8=data[at..t1];
    let inp:[]u8=data[t1+1..t2];
    let oup:[]u8=data[t2+1..le];
    let r:i32=(lab[1]-48) as i32;
    let ti:i32=rows/8;
    let k:i32=0;
    while(k<inp.len){tin[ti*8+k]=inp[k];k=k+1;}
    tnl[ti]=inp.len as u8;
    let m:i32=0;
    while(m<oup.len){tout[(ti*8+r)*8+m]=oup[m];m=m+1;}
    tln[ti*8+r]=oup.len as u8;
    rows=rows+1;
    at=le+1;
  }
  if(rows==96){return 1;}
  return 0;
}
// freedelta: per-position taught-output deltas (mod 256). Returns outlen or -1.
fn freedelta_p0(r:i32,probe:[]u8,pn:i32,tin:[]u8,tnl:[]u8,tout:[]u8,tln:[]u8,out:[]u8)i32 {
  let ti:i32=0;
  while(ti<12){
    if((tnl[ti] as i32)==pn){
      let m:i32=tln[ti*8+r] as i32;
      let j:i32=0;
      while(j<m){
        let sij:i32=j;
        if(sij>=pn){sij=pn-1;}
        let tij:i32=j;
        if(tij>=(tnl[ti] as i32)){tij=(tnl[ti] as i32)-1;}
        let dl:i64=(tout[(ti*8+r)*8+j] as i64)-(tin[ti*8+tij] as i64);
        out[j]=(pmod((probe[sij] as i64)+dl,256) as i32) as u8;
        j=j+1;
      }
      return m;
    }
    ti=ti+1;
  }
  return -1;
}
// mem_p0: single-rule memorizer. Returns predicted length or -1 (withhold).
fn mem_p0(cls:i32,r:i32,probe:[]u8,pn:i32,tin:[]u8,tnl:[]u8,tout:[]u8,tln:[]u8,out:[]u8)i32 {
  if(cls==6){
    return freedelta_p0(r,probe,pn,tin,tnl,tout,tln,out);
  }
  let d:i32=class_degree(cls);
  let M:i64=class_mod(cls);
  if(r==5 && is_sorted_asc(probe,pn)==1){
    let k:i32=0;
    while(k<pn){out[k]=probe[k];k=k+1;}
    return pn;
  }
  let prm:[]u8=z_alloc(4);
  let ti:i32=0;
  let got:i32=-1;
  while(ti<12 && got<0){
    if((tnl[ti] as i32)==pn && fit_mod(probe,pn,tin[ti*8..ti*8+8],tnl[ti] as i32,M,d,prm)==1){
      got=xform(tout[(ti*8+r)*8..(ti*8+r)*8+8],tln[ti*8+r] as i32,prm,d,M,out);
    }
    ti=ti+1;
  }
  z_free(prm);
  return got;
}
// mem_p1: chained two-link memorizer. Returns predicted length or -1.
fn mem_p1(cls:i32,a:i32,b:i32,probe:[]u8,pn:i32,tin:[]u8,tnl:[]u8,tout:[]u8,tln:[]u8,out:[]u8)i32 {
  if(cls==6){
    let mid:[]u8=z_alloc(16);
    let m1:i32=freedelta_p0(a,probe,pn,tin,tnl,tout,tln,mid);
    if(m1<0){z_free(mid);return -1;}
    let g:i32=freedelta_p0(b,mid,m1,tin,tnl,tout,tln,out);
    z_free(mid);
    return g;
  }
  let d:i32=class_degree(cls);
  let M:i64=class_mod(cls);
  let prm1:[]u8=z_alloc(4);
  let prm2:[]u8=z_alloc(4);
  let mid2:[]u8=z_alloc(16);
  let got:i32=-1;
  let ti:i32=0;
  while(ti<12 && got<0){
    if((tnl[ti] as i32)==pn && fit_mod(probe,pn,tin[ti*8..ti*8+8],tnl[ti] as i32,M,d,prm1)==1){
      let m1n:i32=xform(tout[(ti*8+a)*8..(ti*8+a)*8+8],tln[ti*8+a] as i32,prm1,d,M,mid2);
      if(m1n>=d+1){
        let tj:i32=0;
        while(tj<12 && got<0){
          if((tnl[tj] as i32)==m1n && fit_mod(mid2,m1n,tin[tj*8..tj*8+8],tnl[tj] as i32,M,d,prm2)==1){
            got=xform(tout[(tj*8+b)*8..(tj*8+b)*8+8],tln[tj*8+b] as i32,prm2,d,M,out);
          }
          tj=tj+1;
        }
      }
    }
    ti=ti+1;
  }
  z_free(prm1);
  z_free(prm2);
  z_free(mid2);
  return got;
}

// ---------- mem runner ----------
fn hexat(buf:[]u8,at:i32,v:i32)i32 {
  let h:[]u8="0123456789abcdef";
  at=appb(buf,at,h[(v>>4)&15]);
  at=appb(buf,at,h[v&15]);
  return at;
}
// score one probe file; appends detail rows via dcell; returns matches.
fn score_file(cls:i32,path:[]u8,phname:[]u8,is_p0:i32,tin:[]u8,tnl:[]u8,tout:[]u8,tln:[]u8,det:[]u8,dcell:*i32,rcount:[]u8)i32 {
  let data:[]u8=read_file(path);
  let at:i32=0;
  let hits:i32=0;
  let probe:[]u8=z_alloc(16);
  let exp:[]u8=z_alloc(16);
  let got:[]u8=z_alloc(16);
  while(at<data.len){
    let le:i32=at;
    while(le<data.len && data[le]!=10){le=le+1;}
    if(le>at){
      let t1:i32=at;
      while(t1<le && data[t1]!=9){t1=t1+1;}
      let t2:i32=t1+1;
      while(t2<le && data[t2]!=9){t2=t2+1;}
      let lab:[]u8=data[at..t1];
      let inp:[]u8=data[t1+1..t2];
      let exo:[]u8=data[t2+1..le];
      let pn:i32=inp.len;
      let k:i32=0;
      while(k<pn){probe[k]=inp[k];k=k+1;}
      let en:i32=exo.len;
      let m:i32=0;
      while(m<en){exp[m]=exo[m];m=m+1;}
      let a:i32=(lab[1]-48) as i32;
      let b:i32=-1;
      if(lab.len>3){b=(lab[4]-48) as i32;}
      let gn:i32=0;
      if(b<0){gn=mem_p0(cls,a,probe,pn,tin,tnl,tout,tln,got);}
      else {gn=mem_p1(cls,a,b,probe,pn,tin,tnl,tout,tln,got);}
      let ok:i32=0;
      if(gn>=0 && bufeq(exp,en,got,gn)==1){ok=1;hits=hits+1;}
      if(is_p0==1 && b<0 && ok==1){rcount[a]=rcount[a]+1;}
      let da:i32=dcell.*;
      da=appbuf(det,da,phname,phname.len);
      da=appb(det,da,9);
      da=appbuf(det,da,lab,lab.len);
      da=appb(det,da,9);
      da=appbuf(det,da,probe,pn);
      da=appb(det,da,9);
      if(gn<0){da=appb(det,da,63);}
      else {
        let g2:i32=0;
        while(g2<gn){da=hexat(det,da,got[g2] as i32);g2=g2+1;}
      }
      da=appb(det,da,9);
      da=appbuf(det,da,exp,en);
      da=appb(det,da,9);
      da=appi64(det,da,ok as i64);
      da=appb(det,da,10);
      dcell.*=da;
    }
    at=le+1;
  }
  z_free(probe);
  z_free(exp);
  z_free(got);
  return hits;
}
fn mem_run(cls:i32,arm:i32,aname:[]u8,cname:[]u8)void {
  let compat:i32=1;
  if(cls<3 && arm_is_letter(arm)==0){compat=0;}
  if(cls>=3 && cls<6 && arm_is_letter(arm)==1){compat=0;}
  if(compat==0){
    emit("mem class/arm mismatch\n");
    return;
  }
  let tin:[]u8=z_alloc(96);
  let tnl:[]u8=z_alloc(12);
  let tout:[]u8=z_alloc(768);
  let tln:[]u8=z_alloc(96);
  let tdata:[]u8=read_file("teach.tsv");
  if(parse_teach(tdata,tin,tnl,tout,tln)==0){
    emit("teach parse failed\n");
    return;
  }
  let det:[]u8=z_alloc(131072);
  let dcell:i32=0;
  let rcount:[]u8=z_alloc(8);
  let c0:i32=score_file(cls,"p0.tsv","P0",1,tin,tnl,tout,tln,det,&dcell,rcount);
  let c1:i32=score_file(cls,"p1.tsv","P1",0,tin,tnl,tout,tln,det,&dcell,rcount);
  let c2:i32=score_file(cls,"p2.tsv","P2",0,tin,tnl,tout,tln,det,&dcell,rcount);
  emit("MEM ");
  emit(cname);
  emit(" ");
  emit(aname);
  emit("\n");
  emit("P0 ");emit(i64s(c0 as i64));emit("/48\n");
  emit("P1 ");emit(i64s(c1 as i64));emit("/120\n");
  emit("P2 ");emit(i64s(c2 as i64));emit("/8\n");
  let r:i32=0;
  while(r<6){
    emit("RULE r");
    emit(i64s(r as i64));
    emit(" ");
    emit(i64s(rcount[r] as i64));
    emit("/8\n");
    r=r+1;
  }
  let dname:[]u8=z_alloc(64);
  let dn:i32=0;
  dn=appbuf(dname,dn,"mem_",4);
  dn=appbuf(dname,dn,cname,cname.len);
  dn=appb(dname,dn,95);
  dn=appbuf(dname,dn,aname,aname.len);
  dn=appbuf(dname,dn,".tsv",4);
  write_file(dname[0..dn],det,dcell);
  z_free(dname);
  z_free(tin);
  z_free(tnl);
  z_free(tout);
  z_free(tln);
  z_free(det);
  z_free(rcount);
  return;
}
// ---------- main ----------
fn main()i32 {
  let m:[]u8=_zag_arg(1);
  if(streq(m,"gen")==1){
    let arm:i32=arm_of(_zag_arg(2));
    if(arm<0){emit("unknown arm\n");return 1;}
    gen_arm(arm);
    return 0;
  }
  if(streq(m,"gen_clean")==1){
    let armc:i32=arm_of(_zag_arg(2));
    if(armc<0){emit("unknown arm\n");return 1;}
    gen_clean_arm(armc);
    return 0;
  }
  if(streq(m,"gates")==1){
    let arm2:i32=arm_of(_zag_arg(2));
    if(arm2<0){emit("unknown arm\n");return 1;}
    let an:[]u8=_zag_arg(2);
    emit("GATES ");
    emit(an);
    emit("\n");
    let p:i32=gates_arm(arm2,an);
    if(p==1){return 0;}
    return 1;
  }
  if(streq(m,"mem")==1){
    let cls:i32=class_of(_zag_arg(2));
    let arm3:i32=arm_of(_zag_arg(3));
    if(cls<0 || arm3<0){emit("unknown class or arm\n");return 1;}
    mem_run(cls,arm3,_zag_arg(3),_zag_arg(2));
    return 0;
  }
  emit("usage: saltlab gen|gates|mem ...\n");
  return 1;
}


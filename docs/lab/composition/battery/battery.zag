// battery.zag — D1 full composition battery (frozen PREREG §§1-8, 2026-09-27)
// Modes: gen | null | singlerule | learner
// Pure Zag, zero RNG. Pinned toolchain: znc_linux_x86_64_abed8aa1.
// 6 rules: 0=REVERSE 1=DUPFIRST 2=ROTLEFT 3=DROPLAST 4=UPPERFIRST 5=SORTCHARS
// P0: 6x8 probes (tok 6..13), >=7/8. P1: 30 pairs + 120 triples.
// P2: 600 items (pairs tok 14..133, triples tok 134..613). P3: 8 distractors (tok 614..621).
// Frozen generator: NO per-phase salt (A2 proposed, not enacted).
// Chance arms: NULL + SINGLE-RULE only (A1 wrong-order proposed, not enacted).

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn i32s(v:i32)[]u8 { return i64s(v as i64); }
fn emit(s:[]u8)void { _zag_print(s); }
fn emitb(b:[]u8,n:i32)void {
  let k:i32=0;
  while(k<n){let c:[]u8=z_alloc(1);c[0]=b[k];emit(c);z_free(c);k=k+1;}
}
fn streq(a:[]u8,b:[]u8)i64 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn to_low(c:u8)u8 {
  if(c>=65 && c<=90){return (c+32) as u8;}
  return c;
}
// deterministic token: length 2+(i%4), bytes (97+(7i+13k+k^2)%26) — frozen §4
fn toklen(i:i32)i32 { return 2+(i%4); }
fn tokfill(i:i32,out:[]u8)void {
  let n:i32=toklen(i);
  let k:i32=0;
  while(k<n){out[k]=(97+((i*7+k*13+k*k)%26)) as u8;k=k+1;}
}
fn rule_name(r:i32)[]u8 {
  if(r==0){return "reverse";}
  if(r==1){return "dupfirst";}
  if(r==2){return "rotleft";}
  if(r==3){return "droplast";}
  if(r==4){return "upperfirst";}
  return "sortchars";
}
// apply rule r to src[0..n], write dst, return out length
fn apply_rule(r:i32,src:[]u8,n:i32,dst:[]u8)i32 {
  if(r==0){let k:i32=0;while(k<n){dst[k]=src[n-1-k];k=k+1;}return n;}
  if(r==1){dst[0]=src[0];let k:i32=0;while(k<n){dst[1+k]=src[k];k=k+1;}return n+1;}
  if(r==2){
    if(n<1){return 0;}
    let k:i32=0;while(k<n-1){dst[k]=src[k+1];k=k+1;}dst[n-1]=src[0];return n;
  }
  if(r==3){let k:i32=0;while(k<n-1){dst[k]=src[k];k=k+1;}return n-1;}
  if(r==4){
    if(n<1){return 0;}
    let c:u8=src[0];
    if(c>=97 && c<=122){dst[0]=(c-32) as u8;} else {dst[0]=c;}
    let k:i32=1;while(k<n){dst[k]=src[k];k=k+1;}return n;
  }
  // r==5 SORTCHARS: ascending byte sort
  let k:i32=0;while(k<n){dst[k]=src[k];k=k+1;}
  let a:i32=0;
  while(a<n){
    let m:i32=a;
    let b:i32=a+1;
    while(b<n){if(dst[b]<dst[m]){m=b;}b=b+1;}
    let t:u8=dst[a];dst[a]=dst[m];dst[m]=t;
    a=a+1;
  }
  return n;
}
fn bufeq(a:[]u8,na:i32,b:[]u8,nb:i32)i64 {
  if(na!=nb){return 0;}
  let k:i32=0;
  while(k<na){if(a[k]!=b[k]){return 0;}k=k+1;}
  return 1;
}
// pair enumeration p in 0..29, lexicographic over i!=j (6 rules -> pi=p/5)
fn pair_pi(p:i32)i32 { return p/5; }
fn pair_pj(p:i32)i32 {
  let pi:i32=p/5;
  let q:i32=p%5;
  let pj:i32=q;
  if(q>=pi){pj=q+1;}
  return pj;
}
// triple enumeration t in 0..119, lexicographic over distinct (i,j,k)
fn triple_pi(t:i32)i32 { return t/20; }
fn triple_pj(t:i32)i32 {
  let i:i32=t/20;
  let ji:i32=(t%20)/4;
  let j:i32=ji;
  if(ji>=i){j=ji+1;}
  return j;
}
fn triple_pk(t:i32)i32 {
  let i:i32=t/20;
  let r1:i32=t%20;
  let ji:i32=r1/4;
  let j:i32=ji;
  if(ji>=i){j=ji+1;}
  let ki:i32=r1%4;
  let e0:i32=i;
  let e1:i32=j;
  if(e0>e1){let tt:i32=e0;e0=e1;e1=tt;}
  let k:i32=ki;
  if(k>=e0){k=k+1;}
  if(k>=e1){k=k+1;}
  return k;
}
fn rev_pair(p:i32)i32 {
  let pi:i32=pair_pi(p);
  let pj:i32=pair_pj(p);
  let q:i32=0;
  while(q<30){
    if(pair_pi(q)==pj && pair_pj(q)==pi){return q;}
    q=q+1;
  }
  return -1;
}
// scripted single-part answer: smode 0=null(identity), 1=singlerule(applies r)
fn spart(smode:i64,r:i32,src:[]u8,n:i32,out:[]u8)i32 {
  if(smode==0){let k:i32=0;while(k<n){out[k]=src[k];k=k+1;}return n;}
  return apply_rule(r,src,n,out);
}
// scripted composition over parts[0..np): null=identity, singlerule=parts[0] only
fn scompose(smode:i64,parts:[]u8,np:i32,src:[]u8,n:i32,out:[]u8,t1:[]u8,t2:[]u8)i32 {
  if(smode==0){let k:i32=0;while(k<n){out[k]=src[k];k=k+1;}return n;}
  return apply_rule(parts[0] as i32,src,n,out);
}
// scripted distractor answer: no part retrieved -> identity (not reflexive)
fn sdistract(smode:i64,src:[]u8,n:i32,out:[]u8)i32 {
  let k:i32=0;while(k<n){out[k]=src[k];k=k+1;}return n;
}
// ---------- file input ----------
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+total as i64,(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
// length of line starting at `at` (excludes \n); -1 if at>=total
fn line_len(b:[]u8,at:i32,total:i32)i32 {
  if(at>=total){return -1;}
  let k:i32=at;
  while(k<total && b[k]!=10){k=k+1;}
  return k-at;
}
// index of next space/tab at or after `at`, capped at `en`
fn find_ws(b:[]u8,at:i32,en:i32)i32 {
  let k:i32=at;
  while(k<en && b[k]!=32 && b[k]!=9){k=k+1;}
  return k;
}
fn to_i32(b:[]u8,at:i32,en:i32)i32 {
  let v:i32=0;
  let k:i32=at;
  while(k<en && b[k]>=48 && b[k]<=57){v=v*10+(b[k] as i32)-48;k=k+1;}
  return v;
}
// normalize response: lowercase, strip trailing '.'/' '/CR; copy LAST whitespace-delimited
// word to out; return its length. (Honest-broker extraction: the answer token is final.)
fn norm_last_word(resp:[]u8,rn:i32,out:[]u8)i32 {
  let en:i32=rn;
  while(en>0 && (resp[en-1]==46 || resp[en-1]==32 || resp[en-1]==13 || resp[en-1]==9)){en=en-1;}
  let st:i32=en;
  while(st>0 && resp[st-1]!=32 && resp[st-1]!=9){st=st-1;}
  let w:i32=en-st;
  let k:i32=0;
  while(k<w){out[k]=to_low(resp[st+k]);k=k+1;}
  return w;
}
// 1 iff lowercased resp contains "don't know"
fn has_dontknow(resp:[]u8,rn:i32)i64 {
  let pat:[]u8="don't know";
  let pn:i32=pat.len;
  if(rn<pn){return 0;}
  let k:i32=0;
  while(k+pn<=rn){
    let m:i32=1;
    let j:i32=0;
    while(j<pn){if(to_low(resp[k+j])!=pat[j]){m=0;}j=j+1;}
    if(m==1){return 1;}
    k=k+1;
  }
  return 0;
}
// ---------- gen mode ----------
fn run_gen()void {
  let s0:[]u8=z_alloc(16);
  let exp:[]u8=z_alloc(16);
  let r:i32=0;
  while(r<6){
    let t:i32=0;
    while(t<6){
      let n:i32=toklen(t);tokfill(t,s0);
      let le:i32=apply_rule(r,s0,n,exp);
      emit("TEACH\trule=");emit(i32s(r));emit("\tname=");emit(rule_name(r));
      emit("\ttok=");emit(i32s(t));emit("\tinput=");emitb(s0,n);
      emit("\texpected=");emitb(exp,le);emit("\n");
      t=t+1;
    }
    r=r+1;
  }
  r=0;
  while(r<6){
    let t:i32=6;
    while(t<14){
      let n:i32=toklen(t);tokfill(t,s0);
      let le:i32=apply_rule(r,s0,n,exp);
      emit("P0\trule=");emit(i32s(r));emit("\ttok=");emit(i32s(t));
      emit("\tinput=");emitb(s0,n);
      emit("\texpected=");emitb(exp,le);emit("\n");
      t=t+1;
    }
    r=r+1;
  }
  let p:i32=0;
  while(p<30){
    emit("P1\tkind=pair\ta=");emit(i32s(pair_pi(p)));emit("\tb=");emit(i32s(pair_pj(p)));emit("\n");
    p=p+1;
  }
  let t3:i32=0;
  while(t3<120){
    emit("P1\tkind=triple\ta=");emit(i32s(triple_pi(t3)));emit("\tb=");emit(i32s(triple_pj(t3)));
    emit("\tc=");emit(i32s(triple_pk(t3)));emit("\n");
    t3=t3+1;
  }
  let s1:[]u8=z_alloc(16);
  let s2:[]u8=z_alloc(16);
  p=0;
  while(p<30){
    let pi:i32=pair_pi(p);
    let pj:i32=pair_pj(p);
    let it:i32=0;
    while(it<4){
      let ti:i32=14+p*4+it;
      let n:i32=toklen(ti);tokfill(ti,s0);
      let m:i32=apply_rule(pi,s0,n,s1);
      let le:i32=apply_rule(pj,s1,m,exp);
      emit("P2\tkind=pair\ta=");emit(i32s(pi));emit("\tb=");emit(i32s(pj));
      emit("\ttok=");emit(i32s(ti));emit("\tinput=");emitb(s0,n);
      emit("\texpected=");emitb(exp,le);emit("\n");
      it=it+1;
    }
    p=p+1;
  }
  t3=0;
  while(t3<120){
    let ti0:i32=triple_pi(t3);
    let tj0:i32=triple_pj(t3);
    let tk0:i32=triple_pk(t3);
    let it:i32=0;
    while(it<4){
      let ti:i32=134+t3*4+it;
      let n:i32=toklen(ti);tokfill(ti,s0);
      let m1:i32=apply_rule(ti0,s0,n,s1);
      let m2:i32=apply_rule(tj0,s1,m1,s2);
      let le:i32=apply_rule(tk0,s2,m2,exp);
      emit("P2\tkind=triple\ta=");emit(i32s(ti0));emit("\tb=");emit(i32s(tj0));
      emit("\tc=");emit(i32s(tk0));emit("\ttok=");emit(i32s(ti));
      emit("\tinput=");emitb(s0,n);
      emit("\texpected=");emitb(exp,le);emit("\n");
      it=it+1;
    }
    t3=t3+1;
  }
  let d:i32=614;
  while(d<622){
    let n:i32=toklen(d);tokfill(d,s0);
    emit("P3\ttok=");emit(i32s(d));emit("\tinput=");emitb(s0,n);emit("\n");
    d=d+1;
  }
  z_free(s0);z_free(s1);z_free(s2);z_free(exp);
  return;
}
// ---------- scripted-arm pipeline (null / singlerule) ----------
fn run_scripted(smode:i64,mname:[]u8)void {
  let s0:[]u8=z_alloc(16);
  let s1:[]u8=z_alloc(16);
  let s2:[]u8=z_alloc(16);
  let exp:[]u8=z_alloc(16);
  let got:[]u8=z_alloc(16);
  let clsarr:[]u8=z_alloc(600);
  let pairc:[]u8=z_alloc(30);
  let retarr:[]u8=z_alloc(30);
  let rp:[]u8=z_alloc(6);
  let nElig:i32=0;
  let compElig:i32=0;
  let trueacc:i32=0;
  let retr_ok:i32=0;
  let comp_ok:i32=0;
  let nA:i32=0;let nB:i32=0;let nC:i32=0;let nD:i32=0;let nOk:i32=0;

  // P0: 6 rules x 8 probes (tok 6..13)
  let r:i32=0;
  while(r<6){
    let c:i32=0;
    let t:i32=6;
    while(t<14){
      let n:i32=toklen(t);tokfill(t,s0);
      let le:i32=apply_rule(r,s0,n,exp);
      let lg:i32=spart(smode,r,s0,n,got);
      if(bufeq(exp,le,got,lg)==1){c=c+1;}
      t=t+1;
    }
    rp[r]=c as u8;
    emit("ITEM\tphase=0\trule=");emit(i32s(r));emit("\tpass=");
    emit(i32s(c));emit("/8\n");
    r=r+1;
  }
  let mpass:i32=0;
  r=0;
  while(r<6){if((rp[r] as i32)>=7){mpass=mpass+1;}r=r+1;}

  // P1+P2: 30 pairs x 4 (tok 14..133), 120 triples x 4 (tok 134..613)
  let parts:[]u8=z_alloc(3);
  let g:i32=0;
  let p:i32=0;
  while(p<30){
    let pi:i32=pair_pi(p);
    let pj:i32=pair_pj(p);
    parts[0]=pi as u8;parts[1]=pj as u8;
    retr_ok=retr_ok+1;retarr[p]=1;
    let mpi:i32=0;let mpj:i32=0;
    if((rp[pi] as i32)>=7){mpi=1;}
    if((rp[pj] as i32)>=7){mpj=1;}
    let pairc0:i32=0;
    let it:i32=0;
    while(it<4){
      let ti:i32=14+p*4+it;
      let n:i32=toklen(ti);tokfill(ti,s0);
      let m:i32=apply_rule(pi,s0,n,s1);
      let le:i32=apply_rule(pj,s1,m,exp);
      let lg:i32=scompose(smode,parts,2,s0,n,got,s1,s2);
      let good:i32=0;
      let ccode:i32=0;
      let cls:[]u8="ok";
      if(mpi==0 || mpj==0){cls="A";ccode=1;nA=nA+1;}
      if(streq(cls,"ok")==1){
        if(bufeq(exp,le,got,lg)==1){good=1;nOk=nOk+1;}
        if(good==0){cls="C";ccode=3;nC=nC+1;}
      }
      clsarr[g]=ccode as u8;
      if(ccode!=1 && ccode!=2){nElig=nElig+1;if(good==1){compElig=compElig+1;}}
      if(good==1){pairc0=pairc0+1;comp_ok=comp_ok+1;}
      if(bufeq(exp,le,got,lg)==1){trueacc=trueacc+1;}
      emit("ITEM\tphase=2\tkind=pair\tpair=");emit(i32s(pi));emit(",");emit(i32s(pj));
      emit("\tinput=");emit(i32s(ti));emit("\tclass=");emit(cls);
      emit("\tok=");emit(i32s(good));emit("\n");
      g=g+1;it=it+1;
    }
    pairc[p]=pairc0 as u8;
    p=p+1;
  }
  let t3:i32=0;
  while(t3<120){
    let a:i32=triple_pi(t3);
    let b:i32=triple_pj(t3);
    let c3:i32=triple_pk(t3);
    parts[0]=a as u8;parts[1]=b as u8;parts[2]=c3 as u8;
    retr_ok=retr_ok+1;
    let ma:i32=0;let mb:i32=0;let mc:i32=0;
    if((rp[a] as i32)>=7){ma=1;}
    if((rp[b] as i32)>=7){mb=1;}
    if((rp[c3] as i32)>=7){mc=1;}
    let it:i32=0;
    while(it<4){
      let ti:i32=134+t3*4+it;
      let n:i32=toklen(ti);tokfill(ti,s0);
      let m1:i32=apply_rule(a,s0,n,s1);
      let m2:i32=apply_rule(b,s1,m1,s2);
      let le:i32=apply_rule(c3,s2,m2,exp);
      let lg:i32=scompose(smode,parts,3,s0,n,got,s1,s2);
      let good:i32=0;
      let ccode:i32=0;
      let cls:[]u8="ok";
      if(ma==0 || mb==0 || mc==0){cls="A";ccode=1;nA=nA+1;}
      if(streq(cls,"ok")==1){
        if(bufeq(exp,le,got,lg)==1){good=1;nOk=nOk+1;}
        if(good==0){cls="C";ccode=3;nC=nC+1;}
      }
      clsarr[g]=ccode as u8;
      if(ccode!=1 && ccode!=2){nElig=nElig+1;if(good==1){compElig=compElig+1;}}
      if(good==1){comp_ok=comp_ok+1;}
      if(bufeq(exp,le,got,lg)==1){trueacc=trueacc+1;}
      emit("ITEM\tphase=2\tkind=triple\ttriple=");emit(i32s(a));emit(",");emit(i32s(b));
      emit(",");emit(i32s(c3));emit("\tinput=");emit(i32s(ti));
      emit("\tclass=");emit(cls);emit("\tok=");emit(i32s(good));emit("\n");
      g=g+1;it=it+1;
    }
    t3=t3+1;
  }

  // P4: order asymmetry at pair level (pairs only; triples don't feed P4)
  let p2:i32=0;
  while(p2<30){
    let pi:i32=pair_pi(p2);
    let pj:i32=pair_pj(p2);
    let rp2:i32=rev_pair(p2);
    let ca:i32=pairc[p2] as i32;
    let cb:i32=pairc[rp2] as i32;
    let mpi2:i32=0;let mpj2:i32=0;
    if((rp[pi] as i32)>=7){mpi2=1;}
    if((rp[pj] as i32)>=7){mpj2=1;}
    if(ca<=1 && cb>=3 && mpi2==1 && mpj2==1 && retarr[p2]==1 && retarr[rp2]==1){
      let ri2:i32=0;
      while(ri2<4){
        let ix:i32=p2*4+ri2;
        if(clsarr[ix]==3){clsarr[ix]=4;nC=nC-1;nD=nD+1;}
        ri2=ri2+1;
      }
      emit("INTERF\tpair=");emit(i32s(pi));emit(",");emit(i32s(pj));
      emit("\tacc=");emit(i32s(ca));emit("/4\trev=");emit(i32s(cb));emit("/4\n");
    }
    p2=p2+1;
  }

  // P3: 8 distractors (tok 614..621), correct = identity
  let refl:i32=0;
  let d:i32=614;
  while(d<622){
    let n:i32=toklen(d);tokfill(d,s0);
    let lg:i32=sdistract(smode,s0,n,got);
    let bad:i32=0;
    if(bufeq(s0,n,got,lg)==0){bad=1;refl=refl+1;}
    emit("ITEM\tphase=3\tinput=");emit(i32s(d));emit("\treflex=");
    emit(i32s(bad));emit("\n");
    d=d+1;
  }

  emit("SUMMARY\tmode=");emit(mname);
  emit("\tmastery_rules=");emit(i32s(mpass));emit("/6");
  emit("\tretrieval=");emit(i32s(retr_ok));emit("/150");
  emit("\tcomposition=");emit(i32s(comp_ok));emit("/600");
  emit("\tA=");emit(i32s(nA));emit("\tB=");emit(i32s(nB));
  emit("\tC=");emit(i32s(nC));emit("\tD=");emit(i32s(nD));
  emit("\tok=");emit(i32s(nOk));
  emit("\telig=");emit(i32s(compElig));emit("/");emit(i32s(nElig));
  emit("\treflex=");emit(i32s(refl));emit("/8");
  emit("\ttrueacc=");emit(i32s(trueacc));emit("/600\n");
  emit("PAIRS");
  p=0;
  while(p<30){emit(" ");emit(i32s(pairc[p] as i32));p=p+1;}
  emit("\n");

  z_free(s0);z_free(s1);z_free(s2);z_free(exp);z_free(got);
  z_free(clsarr);z_free(pairc);z_free(retarr);z_free(rp);z_free(parts);
  return;
}
// ---------- learner mode: score real-learner transcripts ----------
// Reads resp_p0.txt ("P0 <rule> <tok>" + response line, x48) and
// resp_p3.txt ("P3 <tok>" + response line, x8). P2 items classify (a) per the
// frozen priority rule (parts below bar are excluded from C-items).
fn run_learner()void {
  let s0:[]u8=z_alloc(16);
  let exp:[]u8=z_alloc(16);
  let word:[]u8=z_alloc(32);
  let rp:[]u8=z_alloc(6);
  let pairc:[]u8=z_alloc(30);
  let refl:i32=0;

  let f0:[]u8=read_file("resp_p0.txt");
  let total:i32=f0.len;
  let at:i32=0;
  let nrec:i32=0;
  while(at<total){
    let le:i32=line_len(f0,at,total);
    if(le<0){at=total;}
    if(le>=0){
      // head: "P0 <r> <tok>"
      let s1:i32=find_ws(f0,at,at+le);
      let rs:i32=s1+1;
      let s2:i32=find_ws(f0,rs,at+le);
      let r:i32=to_i32(f0,rs,s2);
      let ts:i32=s2+1;
      let tok:i32=to_i32(f0,ts,at+le);
      at=at+le+1;
      let le2:i32=line_len(f0,at,total);
      if(le2<0){le2=0;}
      let n:i32=toklen(tok);tokfill(tok,s0);
      let le3:i32=apply_rule(r,s0,n,exp);
      let wl:i32=norm_last_word(f0[at..at+le2],le2,word);
      let good:i32=0;
      if(bufeq(exp,le3,word,wl)==1){good=1;let nv:i32=(rp[r] as i32)+1;rp[r]=nv as u8;}
      emit("ITEM\tphase=0\trule=");emit(i32s(r));emit("\ttok=");emit(i32s(tok));
      emit("\tpass=");emit(i32s(good));emit("\tresp=");
      emitb(f0[at..at+le2],le2);emit("\n");
      at=at+le2+1;
      nrec=nrec+1;
    }
  }
  let mpass:i32=0;
  let r:i32=0;
  while(r<6){if((rp[r] as i32)>=7){mpass=mpass+1;}r=r+1;}

  // P2: all 600 items -> (a) (parts excluded). 120 pair-items + 480 triple-items.
  let nA:i32=600;
  let g:i32=0;
  while(g<120){
    emit("ITEM\tphase=2\tkind=pair\tg=");emit(i32s(g));emit("\tclass=A\tok=0\n");
    g=g+1;
  }
  while(g<600){
    emit("ITEM\tphase=2\tkind=triple\tg=");emit(i32s(g));emit("\tclass=A\tok=0\n");
    g=g+1;
  }

  // P3: distractors; correct = withhold ("don't know") or identity echo
  let f3:[]u8=read_file("resp_p3.txt");
  let t3:i32=f3.len;
  let a3:i32=0;
  while(a3<t3){
    let le:i32=line_len(f3,a3,t3);
    if(le<0){a3=t3;}
    if(le>=0){
      let s1:i32=find_ws(f3,a3,a3+le);
      let ts:i32=s1+1;
      let tok:i32=to_i32(f3,ts,a3+le);
      a3=a3+le+1;
      let le2:i32=line_len(f3,a3,t3);
      if(le2<0){le2=0;}
      let n:i32=toklen(tok);tokfill(tok,s0);
      let wl:i32=norm_last_word(f3[a3..a3+le2],le2,word);
      let okk:i32=0;
      if(has_dontknow(f3[a3..a3+le2],le2)==1){okk=1;}
      if(okk==0 && bufeq(s0,n,word,wl)==1){okk=1;}
      let bad:i32=0;
      if(okk==0){bad=1;refl=refl+1;}
      emit("ITEM\tphase=3\ttok=");emit(i32s(tok));emit("\treflex=");
      emit(i32s(bad));emit("\tresp=");
      emitb(f3[a3..a3+le2],le2);emit("\n");
      a3=a3+le2+1;
    }
  }

  emit("SUMMARY\tmode=learner");
  emit("\tmastery_rules=");emit(i32s(mpass));emit("/6");
  emit("\tretrieval=0/150");
  emit("\tcomposition=0/600");
  emit("\tA=");emit(i32s(nA));emit("\tB=0\tC=0\tD=0\tok=0");
  emit("\telig=0/0");
  emit("\treflex=");emit(i32s(refl));emit("/8");
  emit("\ttrueacc=0/600");
  emit("\tp0_records=");emit(i32s(nrec));emit("/48\n");
  emit("PAIRS");
  let p:i32=0;
  while(p<30){emit(" 0");p=p+1;}
  emit("\n");
  emit("MASTERY");
  r=0;
  while(r<6){emit(" ");emit(i32s(rp[r] as i32));emit("/8");r=r+1;}
  emit("\n");

  z_free(s0);z_free(exp);z_free(word);z_free(rp);z_free(pairc);
  return;
}

fn main()i32 {
  let m:[]u8=_zag_arg(1);
  if(streq(m,"gen")==1){run_gen();return 0;}
  if(streq(m,"null")==1){run_scripted(0,"null");return 0;}
  if(streq(m,"singlerule")==1){run_scripted(1,"singlerule");return 0;}
  if(streq(m,"learner")==1){run_learner();return 0;}
  emit("usage: battery gen|null|singlerule|learner\n");
  return 1;
}

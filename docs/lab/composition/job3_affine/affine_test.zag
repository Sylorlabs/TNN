// affine_test.zag — Job 3: adversarial test for the affine memorizer.
// Frozen prereg: docs/lab/composition/job3_affine/PREREG_JOB3.md (2026-09-27).
//
// Modes (argv[1]): genA genB genC  (genuine combiner per arm)
//                  memA memB memC  (affine memorizer per arm)
// Arms: A=affine/enacted-A2 baseline, C=quadratic, B=cubic (non-affine).
// Pure Zag, zero RNG. Pinned toolchain: znc_linux_x86_64_abed8aa1.
//
// Item layout per arm:
//   teach: tok 0..5,700..705 (train salt), all 6 rules taught
//   P0: 48 probes (8/rule), fixed index list (no sorted probes, gate G5)
//   P2: 30 ordered pairs x 4 (lengths 2..5), tok 200..319
//   P3: 8 distractors, tok 400..407 (correct = identity or "?" withhold)
//
// ---- helpers ----
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn i32s(v:i32)[]u8 { return i64s(v as i64); }
fn emit(s:[]u8)void { _zag_print(s); }
fn emitb(b:[]u8,n:i32)void {
  let k:i32=0;
  while(k<n){emit(i32s(b[k] as i32));if(k<n-1){emit(" ");}k=k+1;}
}
fn emitstr(b:[]u8,n:i32)void {
  let k:i32=0;
  while(k<n){let c:[]u8=z_alloc(1);c[0]=b[k];emit(c);z_free(c);k=k+1;}
}
fn streq(a:[]u8,b:[]u8)i64 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn bufeq(a:[]u8,na:i32,b:[]u8,nb:i32)i64 {
  if(na!=nb){return 0;}
  let k:i32=0;
  while(k<na){if(a[k]!=b[k]){return 0;}k=k+1;}
  return 1;
}
// positive mod 26
fn pmod26(v:i32)i32 {
  let t:i32=v%26;
  if(t<0){t=t+26;}
  return t;
}
// ---- salt tables ----
fn salt_c1(ph:i32)i32 {
  if(ph==0){return 13;}
  if(ph==1){return 17;}
  if(ph==2){return 19;}
  return 23;
}
fn salt_c2(ph:i32)i32 {
  if(ph==0){return 3;}
  if(ph==1){return 5;}
  if(ph==2){return 7;}
  return 11;
}
fn salt_c3(ph:i32)i32 {
  if(ph==0){return 2;}
  if(ph==1){return 3;}
  if(ph==2){return 6;}
  return 7;
}
fn toklen(i:i32)i32 { return 2+(i%4); }
// arm: 0=A affine, 1=B cubic, 2=C quadratic. ph: 0=train 1=P0 2=P2 3=P3.
fn tokfill(arm:i32,ph:i32,i:i32,out:[]u8)void {
  let n:i32=toklen(i);
  let c1:i32=salt_c1(ph);
  let k:i32=0;
  while(k<n){
    let v:i32=7*i+c1*k+k*k;
    if(arm==2){v=v+(salt_c2(ph)-1)*k*k;}
    if(arm==1){v=v+(salt_c2(ph)-1)*k*k+salt_c3(ph)*k*k*k;}
    out[k]=(97+pmod26(v)) as u8;
    k=k+1;
  }
}
// ---- P0 index list: first 48 ints >=100 with no sorted token under any arm
// (item-validity gate G5; frozen with the prereg)
fn p0idx_str()[]u8 {
  return "100,101,102,103,105,106,107,109,110,111,113,114,115,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151";
}
fn p0_index(j:i32)i32 {
  let s:[]u8=p0idx_str();
  let at:i32=0;
  let seen:i32=0;
  let v:i32=0;
  while(at<s.len){
    let c:u8=s[at];
    if(c==44){
      if(seen==j){return v;}
      seen=seen+1;
      v=0;
    } else {
      v=v*10+((c as i32)-48);
    }
    at=at+1;
  }
  if(seen==j){return v;}
  return -1;
}
fn train_index(ti:i32)i32 {
  if(ti<6){return ti;}
  return 700+(ti-6);
}
// ---- rules ----
fn is_sorted(s:[]u8,n:i32)i32 {
  let k:i32=0;
  while(k<n-1){if(s[k]>s[k+1]){return 0;}k=k+1;}
  return 1;
}
fn apply_rule(r:i32,src:[]u8,n:i32,dst:[]u8)i32 {
  if(r==0){let k:i32=0;while(k<n){dst[k]=src[n-1-k];k=k+1;}return n;}
  if(r==1){dst[0]=src[0];let k:i32=0;while(k<n){dst[1+k]=src[k];k=k+1;}return n+1;}
  if(r==2){
    if(n<1){return 0;}
    let k:i32=0;while(k<n-1){dst[k]=src[k+1];k=k+1;}dst[n-1]=src[0];return n;
  }
  if(r==3){let k:i32=0;while(k<n-1){dst[k]=src[k];k=k+1;}return n-1;}
  if(r==4){
    if(n<1){return 0;}
    let c:u8=src[0];
    if(c>=97 && c<=122){dst[0]=(c-32) as u8;} else {dst[0]=c;}
    let k:i32=1;while(k<n){dst[k]=src[k];k=k+1;}return n;
  }
  let k:i32=0;while(k<n){dst[k]=src[k];k=k+1;}
  let a:i32=0;
  while(a<n){
    let m:i32=a;
    let b:i32=a+1;
    while(b<n){if(dst[b]<dst[m]){m=b;}b=b+1;}
    let t:u8=dst[a];dst[a]=dst[m];dst[m]=t;
    a=a+1;
  }
  return n;
}
fn pair_pi(p:i32)i32 { return p/5; }
fn pair_pj(p:i32)i32 {
  let pi:i32=p/5;
  let q:i32=p%5;
  let pj:i32=q;
  if(q>=pi){pj=q+1;}
  return pj;
}
// ---- taught table: 12 train tokens x 6 rules ----
// ttok[ti*6+k], ttn[ti]; taught[(ti*6+r)*7+k], thn[ti*6+r]
fn build_taught(arm:i32,ttok:[]u8,ttn:[]u8,taught:[]u8,thn:[]u8)void {
  let tmp:[]u8=z_alloc(16);
  let ti:i32=0;
  while(ti<12){
    let idx:i32=train_index(ti);
    let n:i32=toklen(idx);
    tokfill(arm,0,idx,tmp);
    ttn[ti]=n as u8;
    let k:i32=0;
    while(k<n){ttok[ti*6+k]=tmp[k];k=k+1;}
    let r:i32=0;
    while(r<6){
      let on:i32=apply_rule(r,tmp,n,taught[(ti*6+r)*7..(ti*6+r)*7+7]);
      thn[ti*6+r]=on as u8;
      r=r+1;
    }
    ti=ti+1;
  }
  z_free(tmp);
}
// ---- affine fit: raw-byte space mod 26; so[0]=s, so[1]=o; 1=fit, 0=no fit
fn fit_affine(p:[]u8,pn:i32,t:[]u8,tn:i32,so:[]u8)i32 {
  if(pn!=tn){return 0;}
  if(pn<2){return 0;}
  let d0:i32=pmod26((p[0] as i32)-(t[0] as i32));
  let d1:i32=pmod26((p[1] as i32)-(t[1] as i32));
  let o:i32=d0;
  let s:i32=pmod26(d1-d0);
  let k:i32=2;
  while(k<pn){
    let dk:i32=pmod26((p[k] as i32)-(t[k] as i32));
    if(dk!=pmod26(o+s*k)){return 0;}
    k=k+1;
  }
  so[0]=s as u8;
  so[1]=o as u8;
  return 1;
}
// transform src[0..sn] by (s,o) per position, preserving each position's case
fn transform_out(src:[]u8,sn:i32,s:i32,o:i32,dst:[]u8)i32 {
  let k:i32=0;
  while(k<sn){
    let c:u8=src[k];
    let base:i32=97;
    if(c>=65 && c<=90){base=65;}
    dst[k]=(base+pmod26((c as i32)-base+o+s*k)) as u8;
    k=k+1;
  }
  return sn;
}
// ---- affine memorizer (Crew-E class, clean-room spec, prereg section 5) ----
// returns output length, or -1 for "?" (no fit)
fn mem_p0(arm:i32,r:i32,probe:[]u8,pn:i32,ttok:[]u8,ttn:[]u8,taught:[]u8,thn:[]u8,out:[]u8)i32 {
  if(r==5 && is_sorted(probe,pn)==1){
    let k:i32=0;
    while(k<pn){out[k]=probe[k];k=k+1;}
    return pn;
  }
  let so:[]u8=z_alloc(2);
  let ti:i32=0;
  let ans:i32=-1;
  while(ti<12){
    let tn:i32=ttn[ti] as i32;
    if(tn==pn && fit_affine(probe,pn,ttok[ti*6..ti*6+6],tn,so)==1){
      let s:i32=so[0] as i32;
      let o:i32=so[1] as i32;
      let base:i32=(ti*6+r)*7;
      ans=transform_out(taught[base..base+7],thn[ti*6+r] as i32,s,o,out);
      ti=12;
    }
    ti=ti+1;
  }
  z_free(so);
  return ans;
}
fn mem_p2(arm:i32,a:i32,b:i32,probe:[]u8,pn:i32,ttok:[]u8,ttn:[]u8,taught:[]u8,thn:[]u8,out:[]u8)i32 {
  let so:[]u8=z_alloc(2);
  let m1:[]u8=z_alloc(16);
  let m1n:i32=-1;
  let ti:i32=0;
  while(ti<12){
    let tn:i32=ttn[ti] as i32;
    if(tn==pn && fit_affine(probe,pn,ttok[ti*6..ti*6+6],tn,so)==1){
      let s:i32=so[0] as i32;
      let o:i32=so[1] as i32;
      let base:i32=(ti*6+a)*7;
      m1n=transform_out(taught[base..base+7],thn[ti*6+a] as i32,s,o,m1);
      ti=12;
    }
    ti=ti+1;
  }
  if(m1n<0){z_free(so);z_free(m1);return -1;}
  let ans:i32=-1;
  let tj:i32=0;
  while(tj<12){
    let tn:i32=ttn[tj] as i32;
    if(tn==m1n && fit_affine(m1,m1n,ttok[tj*6..tj*6+6],tn,so)==1){
      let s:i32=so[0] as i32;
      let o:i32=so[1] as i32;
      let base:i32=(tj*6+b)*7;
      ans=transform_out(taught[base..base+7],thn[tj*6+b] as i32,s,o,out);
      tj=12;
    }
    tj=tj+1;
  }
  z_free(so);
  z_free(m1);
  return ans;
}
fn mem_p3(arm:i32,probe:[]u8,pn:i32,ttok:[]u8,ttn:[]u8,taught:[]u8,thn:[]u8,out:[]u8)i32 {
  let r:i32=0;
  while(r<6){
    let n:i32=mem_p0(arm,r,probe,pn,ttok,ttn,taught,thn,out);
    if(n>=0){return n;}
    r=r+1;
  }
  return -1;
}
// ---- genuine combiner (positive control; probe string only, prereg section 6) ----
fn gen_p0(r:i32,probe:[]u8,pn:i32,out:[]u8)i32 {
  return apply_rule(r,probe,pn,out);
}
fn gen_p2(a:i32,b:i32,probe:[]u8,pn:i32,out:[]u8)i32 {
  let t1:[]u8=z_alloc(16);
  let m1:i32=apply_rule(a,probe,pn,t1);
  let n:i32=apply_rule(b,t1,m1,out);
  z_free(t1);
  return n;
}
fn gen_p3(probe:[]u8,pn:i32,out:[]u8)i32 {
  let k:i32=0;
  while(k<pn){out[k]=probe[k];k=k+1;}
  return pn;
}
// ---- gates ----
fn gate_g1(arm:i32,ttok:[]u8,ttn:[]u8)i32 {
  let probe:[]u8=z_alloc(16);
  let hits:i32=0;
  let ph:i32=1;
  while(ph<4){
    let lo:i32=0;
    let hi:i32=0;
    if(ph==1){lo=0;hi=48;}
    if(ph==2){lo=200;hi=320;}
    if(ph==3){lo=400;hi=408;}
    let ii:i32=lo;
    while(ii<hi){
      let idx:i32=ii;
      if(ph==1){idx=p0_index(ii);}
      let n:i32=toklen(idx);
      tokfill(arm,ph,idx,probe);
      let ti:i32=0;
      while(ti<12){
        let tn:i32=ttn[ti] as i32;
        if(tn==n && bufeq(probe,n,ttok[ti*6..ti*6+6],tn)==1){hits=hits+1;}
        ti=ti+1;
      }
      ii=ii+1;
    }
    ph=ph+1;
  }
  z_free(probe);
  return hits;
}
fn gate_g2p(arm:i32,ttok:[]u8,ttn:[]u8)i32 {
  let probe:[]u8=z_alloc(16);
  let so:[]u8=z_alloc(2);
  let fits:i32=0;
  let ph:i32=1;
  while(ph<4){
    let lo:i32=0;
    let hi:i32=0;
    if(ph==1){lo=0;hi=48;}
    if(ph==2){lo=200;hi=320;}
    if(ph==3){lo=400;hi=408;}
    let ii:i32=lo;
    while(ii<hi){
      let idx:i32=ii;
      if(ph==1){idx=p0_index(ii);}
      let n:i32=toklen(idx);
      tokfill(arm,ph,idx,probe);
      if(n>=3){
        let ti:i32=0;
        while(ti<12){
          let tn:i32=ttn[ti] as i32;
          if(tn==n && fit_affine(probe,n,ttok[ti*6..ti*6+6],tn,so)==1){fits=fits+1;}
          ti=ti+1;
        }
      }
      ii=ii+1;
    }
    ph=ph+1;
  }
  z_free(probe);
  z_free(so);
  return fits;
}
// R1/R2 constant check: 1=ok
fn gate_g3()i32 {
  let ph:i32=0;
  while(ph<4){
    let q:i32=ph+1;
    while(q<4){
      if(pmod26(salt_c1(ph)-salt_c1(q))==0){return 0;}
      if(pmod26(salt_c2(ph)-salt_c2(q))==0){return 0;}
      if(pmod26(salt_c3(ph)-salt_c3(q))==0){return 0;}
      let sd:i32=2*(salt_c2(ph)-salt_c2(q))+6*(salt_c3(ph)-salt_c3(q));
      if(pmod26(sd)==0){return 0;}
      q=q+1;
    }
    ph=ph+1;
  }
  return 1;
}
// ---- harness ----
fn run_agent(agent:i32,arm:i32,aname:[]u8)i32 {
  let ttok:[]u8=z_alloc(72);
  let ttn:[]u8=z_alloc(12);
  let taught:[]u8=z_alloc(504);
  let thn:[]u8=z_alloc(72);
  build_taught(arm,ttok,ttn,taught,thn);
  let probe:[]u8=z_alloc(16);
  let exp:[]u8=z_alloc(16);
  let got:[]u8=z_alloc(16);
  let t1:[]u8=z_alloc(16);
  emit("MODE ");emit(aname);emit("\n");
  emit("GATE G1 ");emit(i32s(gate_g1(arm,ttok,ttn)));emit("\n");
  emit("GATE G2p ");emit(i32s(gate_g2p(arm,ttok,ttn)));emit("\n");
  emit("GATE G3 ");emit(i32s(gate_g3()));emit("\n");
  // P0
  let c0:i32=0;
  let r:i32=0;
  while(r<6){
    let j:i32=0;
    while(j<8){
      let idx:i32=p0_index(r*8+j);
      let n:i32=toklen(idx);
      tokfill(arm,1,idx,probe);
      let en:i32=apply_rule(r,probe,n,exp);
      let gn:i32=0;
      if(agent==0){gn=gen_p0(r,probe,n,got);} else {gn=mem_p0(arm,r,probe,n,ttok,ttn,taught,thn,got);}
      let ok:i32=0;
      if(gn>=0 && bufeq(exp,en,got,gn)==1){ok=1;c0=c0+1;}
      emit("P0 ");emit(i32s(r));emit(" ");emit(i32s(idx));emit(" ");emit(i32s(ok));
      emit(" ");emitstr(exp,en);emit(" ");
      if(gn<0){emit("?");} else {emitstr(got,gn);}
      emit("\n");
      j=j+1;
    }
    r=r+1;
  }
  emit("SUM P0 ");emit(i32s(c0));emit("/48\n");
  // P2
  let c2:i32=0;
  let pi:i32=0;
  while(pi<30){
    let a:i32=pair_pi(pi);
    let b:i32=pair_pj(pi);
    let j:i32=0;
    while(j<4){
      let idx:i32=200+pi*4+j;
      let n:i32=toklen(idx);
      tokfill(arm,2,idx,probe);
      let m1:i32=apply_rule(a,probe,n,t1);
      let en:i32=apply_rule(b,t1,m1,exp);
      let gn:i32=0;
      if(agent==0){gn=gen_p2(a,b,probe,n,got);} else {gn=mem_p2(arm,a,b,probe,n,ttok,ttn,taught,thn,got);}
      let ok:i32=0;
      if(gn>=0 && bufeq(exp,en,got,gn)==1){ok=1;c2=c2+1;}
      emit("P2 ");emit(i32s(a));emit(" ");emit(i32s(b));emit(" ");emit(i32s(idx));
      emit(" ");emit(i32s(ok));emit(" ");emitstr(exp,en);emit(" ");
      if(gn<0){emit("?");} else {emitstr(got,gn);}
      emit("\n");
      j=j+1;
    }
    pi=pi+1;
  }
  emit("SUM P2 ");emit(i32s(c2));emit("/120\n");
  // P3: correct = identity OR "?" withhold
  let c3:i32=0;
  let j:i32=0;
  while(j<8){
    let idx:i32=400+j;
    let n:i32=toklen(idx);
    tokfill(arm,3,idx,probe);
    let gn:i32=0;
    if(agent==0){gn=gen_p3(probe,n,got);} else {gn=mem_p3(arm,probe,n,ttok,ttn,taught,thn,got);}
    let ok:i32=0;
    if(gn<0){ok=1;c3=c3+1;}
    if(gn>=0 && bufeq(probe,n,got,gn)==1){ok=1;c3=c3+1;}
    emit("P3 ");emit(i32s(idx));emit(" ");emit(i32s(ok));emit(" ");
    emitstr(probe,n);emit(" ");
    if(gn<0){emit("?");} else {emitstr(got,gn);}
    emit("\n");
    j=j+1;
  }
  emit("SUM P3 ");emit(i32s(c3));emit("/8\n");
  z_free(ttok);z_free(ttn);z_free(taught);z_free(thn);
  z_free(probe);z_free(exp);z_free(got);z_free(t1);
  return 0;
}
fn main()i32 {
  let m:[]u8=_zag_arg(1);
  if(streq(m,"genA")==1){run_agent(0,0,"genA");return 0;}
  if(streq(m,"genC")==1){run_agent(0,2,"genC");return 0;}
  if(streq(m,"genB")==1){run_agent(0,1,"genB");return 0;}
  if(streq(m,"memA")==1){run_agent(1,0,"memA");return 0;}
  if(streq(m,"memC")==1){run_agent(1,2,"memC");return 0;}
  if(streq(m,"memB")==1){run_agent(1,1,"memB");return 0;}
  emit("usage: affine_test genA|genB|genC|memA|memB|memC\n");
  return 1;
}

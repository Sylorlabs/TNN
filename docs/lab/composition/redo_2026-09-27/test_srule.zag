// test_srule.zag — unit test for srule_engine.zag (2026-09-27).
// Uses SCRAMBLED rule names (not reverse/dupfirst/...) to prove learning
// comes from examples, not names. Hand-written examples (not battery tokens).
@import("io_import.zag")
@import("srule_engine.zag")

// t_feed2 is the real feeder (t_feed had a duplicated-arg bug and was removed).
fn t_feed2(srt:[]u8,srx:[]u8,sxt:[]u8,spm:[]u8,sc:[]u8,s:[]u8)void {
    sr_capture(srt,srx,sxt,spm,s,s.len);
    return;
}
fn t_expect_prog(srt:[]u8,srx:[]u8,sxt:[]u8,sc:[]u8,name:[]u8,ok:i32,pre:i32,la:i32,src:i32,fov:i32,lov:i32,mf:i32,mm:i32,ml:i32)void {
    let ri:i32=sr_rule_find(srt,sxt,name,0,name.len);
    if(ri>=0){ sr_ensure(srt,srx,sxt,sc,ri); }
    let dst:[]u8=nio_alloc(40);
    let k:i32=0;
    while(k<10){ sr_p32(dst,k*4,-999); k=k+1; }
    if(ri>=0){ sr_prog_get(srt,ri,dst); }
    let got_ok:i32=sr_g32(dst,0) as i32;
    let got_pre:i32=sr_g32(dst,4) as i32;
    let got_la:i32=sr_g32(dst,8) as i32;
    let got_src:i32=sr_g32(dst,12) as i32;
    let got_fov:i32=sr_g32(dst,16) as i32;
    let got_lov:i32=sr_g32(dst,20) as i32;
    let got_mf:i32=sr_g32(dst,24) as i32;
    let got_mm:i32=sr_g32(dst,28) as i32;
    let got_ml:i32=sr_g32(dst,32) as i32;
    if(ri>=0 && got_ok==ok && got_pre==pre && got_la==la && got_src==src && got_fov==fov && got_lov==lov && got_mf==mf && got_mm==mm && got_ml==ml){
        _zag_print("PASS prog ");
        _zag_print(name);
        _zag_print("\n");
    } else {
        _zag_print("FAIL prog ");
        _zag_print(name);
        _zag_print(" ri=");
        _zag_print(_zag_i64_to_str(ri as i64));
        _zag_print(" got ok/pre/la/src/fov/lov/mf/mm/ml=");
        _zag_print(_zag_i64_to_str(got_ok as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(got_pre as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(got_la as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(got_src as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(got_fov as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(got_lov as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(got_mf as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(got_mm as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(got_ml as i64));
        _zag_print(" want=");
        _zag_print(_zag_i64_to_str(ok as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(pre as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(la as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(src as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(fov as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(lov as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(mf as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(mm as i64)); _zag_print(",");
        _zag_print(_zag_i64_to_str(ml as i64));
        _zag_print("\n");
    }
    nio_free(dst);
    return;
}
fn t_ask(srt:[]u8,srx:[]u8,sxt:[]u8,spm:[]u8,sc:[]u8,q:[]u8,expect:[]u8)void {
    let resp:[]u8=nio_alloc(1092);
    sr_p32(resp,0,0);
    let h:i32=sr_ask(srt,srx,sxt,spm,sc,q,q.len,resp);
    let rl:i32=sr_g32(resp,0) as i32;
    let ok:i32=0;
    if(h==1 && rl==expect.len){ ok=sr_byeq(resp,4,expect,0,rl); }
    if(ok==1){
        _zag_print("PASS ask ");
        _zag_print(q);
        _zag_print("\n");
    } else {
        _zag_print("FAIL ask [h=");
        _zag_print(q);
        _zag_print("] got: ");
        let rl2:i32=sr_g32(resp,0) as i32;
        _zag_raw_syscall(1,1,(_zag_slice_ptr(resp) as i64)+4,(rl2 as i64),0,0,0);
        _zag_print("\n  want: ");
        _zag_print(expect);
        _zag_print("\n");
    }
    nio_free(resp);
    return;
}
fn main()void {
    let srt:[]u8=nio_alloc(16+16*64);
    let srx:[]u8=nio_alloc(16+384*20);
    let sxt:[]u8=nio_alloc(65536);
    let spm:[]u8=nio_alloc(8+16*4);
    let sc:[]u8=sr_init(srt,srx,sxt,spm);
    // teach with scrambled names
    t_feed2(srt,srx,sxt,spm,sc,"the zqx of abc is cba.");
    t_feed2(srt,srx,sxt,spm,sc,"the zqx of hello is olleh.");
    t_feed2(srt,srx,sxt,spm,sc,"the zqx of ab is ba.");
    t_feed2(srt,srx,sxt,spm,sc,"the zqx of mnop is ponm.");
    t_feed2(srt,srx,sxt,spm,sc,"the wob of ab is aab.");
    t_feed2(srt,srx,sxt,spm,sc,"the wob of xyz is xxyz.");
    t_feed2(srt,srx,sxt,spm,sc,"the wob of q is qq.");
    t_feed2(srt,srx,sxt,spm,sc,"the wob of mn is mmn.");
    t_feed2(srt,srx,sxt,spm,sc,"the kpt of abcd is bcda.");
    t_feed2(srt,srx,sxt,spm,sc,"the kpt of xy is yx.");
    t_feed2(srt,srx,sxt,spm,sc,"the kpt of abc is bca.");
    t_feed2(srt,srx,sxt,spm,sc,"the mvr of abcd is bcd.");
    t_feed2(srt,srx,sxt,spm,sc,"the mvr of xyz is yz.");
    t_feed2(srt,srx,sxt,spm,sc,"the mvr of ab is b.");
    t_feed2(srt,srx,sxt,spm,sc,"the mvr of qwert is wert.");
    t_feed2(srt,srx,sxt,spm,sc,"the sgl of abc is Abc.");
    t_feed2(srt,srx,sxt,spm,sc,"the sgl of xyz is Xyz.");
    t_feed2(srt,srx,sxt,spm,sc,"the sgl of q is Q.");
    t_feed2(srt,srx,sxt,spm,sc,"the sgl of hello is Hello.");
    t_feed2(srt,srx,sxt,spm,sc,"the dtn of cba is abc.");
    t_feed2(srt,srx,sxt,spm,sc,"the dtn of hello is ehllo.");
    t_feed2(srt,srx,sxt,spm,sc,"the dtn of zyx is xyz.");
    t_feed2(srt,srx,sxt,spm,sc,"the dtn of bca is abc.");
    // check induced programs (ok,pre,la,src,fov,lov,mf,mm,ml)
    t_expect_prog(srt,srx,sxt,sc,"zqx",1,0,0,1,0,0,0,0,0);
    t_expect_prog(srt,srx,sxt,sc,"wob",1,0,1,3,1,0,0,0,0);
    t_expect_prog(srt,srx,sxt,sc,"kpt",1,0,0,2,0,0,0,0,0);
    t_expect_prog(srt,srx,sxt,sc,"mvr",1,0,-1,2,0,0,0,0,0);
    t_expect_prog(srt,srx,sxt,sc,"sgl",1,0,0,0,0,0,1,0,0);
    t_expect_prog(srt,srx,sxt,sc,"dtn",1,1,0,0,0,0,0,0,0);
    // P0 held-out
    t_ask(srt,srx,sxt,spm,sc,"what is the zqx of qwerty?","the zqx of qwerty is ytrewq.");
    t_ask(srt,srx,sxt,spm,sc,"what is the sgl of qwerty?","the sgl of qwerty is Qwerty.");
    t_ask(srt,srx,sxt,spm,sc,"what is the dtn of qwerty?","the dtn of qwerty is eqrtwy.");
    // part mapping + P2
    t_feed2(srt,srx,sxt,spm,sc,"zqx is part 1.");
    t_feed2(srt,srx,sxt,spm,sc,"wob is part 2.");
    t_feed2(srt,srx,sxt,spm,sc,"kpt is part 3.");
    t_ask(srt,srx,sxt,spm,sc,"apply part 1 then part 2 to abcd.","applying part 1 then part 2 to abcd gives ddcba.");
    // P1
    t_ask(srt,srx,sxt,spm,sc,"which two parts (numbered 1 to 6), in which order, turn abcd into ddcba?","part 1 then part 2.");
    _zag_print("DONE\n");
    return;
}

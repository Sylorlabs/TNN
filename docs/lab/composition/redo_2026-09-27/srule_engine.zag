// srule_engine.zag — string-rule induction & application engine
// (2026-09-27, composition redo, Job 1).
//
// Causal repair for the white-box finding (WHITEBOX.md): the learner's
// output channel is a verbatim-span concatenation machine with no
// character-level addressing and no construction operator, and the intake
// case-folds, destroying P5's signal. This engine adds, natively in Zag:
//
//   1. character-level addressing of strings (indexable sequences),
//   2. a construction operator (writes bytes in computed order),
//   3. example-driven program induction over a GENERAL string-program
//      family (no rule names in code; any taught rule in the family's
//      range is learnable),
//   4. case-preserving capture for the string domain.
//
// It is @imported at the top of wb3_stringrule.zag (before main, so no
// forward references). Fully self-contained: only sr_-prefixed names,
// own LE accessors, own scratch. Zero RNG; fully deterministic.
//
// Program family (params):
//   pre:    0=none, 1=sort-ascending
//   lenadj: -2..+2 (output length = n + lenadj; derived from examples)
//   src:    0=i, 1=n-1-i, 2=(i+1)%n, 3=(i-1+n)%n, 4=max(0,i-1), 5=min(n-1,i+1)
//   fov:    0=none, 1=idx0, 2=idx1, 3=idx(n-2), 4=idx(n-1)  [output pos 0]
//   lov:    same encoding                                   [output pos m-1]
//   mf/mm/ml: 0=identity, 1=upper, 2=lower  [first/mid/last position maps]

fn sr_p32(b:[]u8,at:i32,v:i64)void {
    b[at]=v as u8; b[at+1]=(v>>8) as u8; b[at+2]=(v>>16) as u8; b[at+3]=(v>>24) as u8;
    return;
}
fn sr_g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn sr_byeq(a:[]u8,ao:i32,b:[]u8,bo:i32,n:i32)i32 {
    let k:i32=0;
    while(k<n){ if(a[ao+k]!=b[bo+k]){ return 0; } k=k+1; }
    return 1;
}
fn sr_is_alpha(c:u8)i32 {
    if(c>=97 && c<=122){ return 1; }
    if(c>=65 && c<=90){ return 1; }
    return 0;
}
fn sr_is_alnum(c:u8)i32 {
    if(sr_is_alpha(c)==1){ return 1; }
    if(c>=48 && c<=57){ return 1; }
    return 0;
}
fn sr_to_low(c:u8)u8 {
    if(c>=65 && c<=90){ return (c+32) as u8; }
    return c;
}
fn sr_word_ok(b:[]u8,bo:i32,bl:i32) i32 {
    // single word: 1..32 alnum chars
    if(bl<1 || bl>32){ return 0; }
    let k:i32=0;
    while(k<bl){ if(sr_is_alnum(b[bo+k])==0){ return 0; } k=k+1; }
    return 1;
}
// case-insensitive literal match at b[bo..]
fn sr_lit_at(b:[]u8,bo:i32,bl:i32,lit:[]u8) i32 {
    let n:i32=lit.len;
    if(bl<n){ return 0; }
    let k:i32=0;
    while(k<n){ if(sr_to_low(b[bo+k])!=lit[k]){ return 0; } k=k+1; }
    return 1;
}

// ---- table layout ----
// srt (rule table): n_rules@0(i32); rule slots 64B each from offset 16:
//   name_off@0 name_len@4 nex@8 prog_ok@16 pre@20 lenadj@24 src@28
//   fov@32 lov@36 mf@40 mm@44 ml@48  (rest reserved)
// srx (example table): n_ex@0(i32); entries 20B each from offset 16:
//   rule@0 in_off@4 in_len@8 out_off@12 out_len@16
// sxt (text pool): len@0(i32); packed bytes from offset 8.
// spm (part map): 16 slots x 4B from offset 8: rule idx or -1.
fn sr_init(srt:[]u8,srx:[]u8,sxt:[]u8,spm:[]u8)[]u8 {
    sr_p32(srt,0,0);
    sr_p32(srx,0,0);
    sr_p32(sxt,0,0);
    let k:i32=0;
    while(k<16){ sr_p32(spm,8+k*4,-1); k=k+1; }
    let sc:[]u8=nio_alloc(256);
    let z:i32=0;
    while(z<256){ sc[z]=0; z=z+1; }
    return sc;
}
fn sr_rule_find(srt:[]u8,sxt:[]u8,name:[]u8,no:i32,nl:i32)i32 {
    let nr:i32=sr_g32(srt,0) as i32;
    let r:i32=0;
    while(r<nr){
        let ro:i32=16+r*64;
        let rl:i32=sr_g32(srt,ro+4) as i32;
        if(rl==nl){
            let roff:i32=sr_g32(srt,ro) as i32;
            let m:i32=1;
            let k:i32=0;
            while(k<nl){
                if(sr_to_low(sxt[8+roff+k])!=sr_to_low(name[no+k])){ m=0; }
                k=k+1;
            }
            if(m==1){ return r; }
        }
        r=r+1;
    }
    return -1;
}
fn sr_txt_add(sxt:[]u8,s:[]u8,so:i32,sl:i32)i32 {
    let l:i32=sr_g32(sxt,0) as i32;
    let k:i32=0;
    while(k<sl){ sxt[8+l+k]=s[so+k]; k=k+1; }
    sr_p32(sxt,0,l+sl);
    return l;
}
// get-or-create rule; returns idx or -1
fn sr_rule_get(srt:[]u8,sxt:[]u8,name:[]u8,no:i32,nl:i32)i32 {
    let f:i32=sr_rule_find(srt,sxt,name,no,nl);
    if(f>=0){ return f; }
    let nr:i32=sr_g32(srt,0) as i32;
    if(nr>=16){ return -1; }
    let ro:i32=16+nr*64;
    let off:i32=sr_txt_add(sxt,name,no,nl);
    let k:i32=0;
    while(k<nl){ sxt[8+off+k]=sr_to_low(name[no+k]); k=k+1; }
    sr_p32(srt,ro,off);
    sr_p32(srt,ro+4,nl);
    sr_p32(srt,ro+8,0);
    sr_p32(srt,ro+16,0);
    sr_p32(srt,0,nr+1);
    return nr;
}
// add example (dedup identical); returns 1 if added
fn sr_ex_add(srt:[]u8,srx:[]u8,sxt:[]u8,ri:i32,io:i32,il:i32,oo:i32,ol:i32)i32 {
    let ne:i32=sr_g32(srx,0) as i32;
    let k:i32=0;
    while(k<ne){
        let eo:i32=16+k*20;
        if((sr_g32(srx,eo) as i32)==ri){
            let a1:i32=sr_g32(srx,eo+4) as i32;
            let a2:i32=sr_g32(srx,eo+8) as i32;
            let b1:i32=sr_g32(srx,eo+12) as i32;
            let b2:i32=sr_g32(srx,eo+16) as i32;
            if(a2==il && b2==ol && sr_byeq(sxt,8+a1,sxt,8+io,il)==1 && sr_byeq(sxt,8+b1,sxt,8+oo,ol)==1){
                return 0;
            }
        }
        k=k+1;
    }
    if(ne>=384){ return 0; }
    let eo2:i32=16+ne*20;
    sr_p32(srx,eo2,ri);
    sr_p32(srx,eo2+4,io);
    sr_p32(srx,eo2+8,il);
    sr_p32(srx,eo2+12,oo);
    sr_p32(srx,eo2+16,ol);
    sr_p32(srx,0,ne+1);
    let ro:i32=16+ri*64;
    sr_p32(srt,ro+8,(sr_g32(srt,ro+8) as i32)+1);
    sr_p32(srt,ro+16,0);
    return 1;
}

// ---- program application ----
fn sr_decode_ov(v:i32,n:i32)i32 {
    if(v==1){ return 0; }
    if(v==2){ return 1; }
    if(v==3){ return n-2; }
    return n-1;
}
fn sr_base_src(s:i32,i:i32,n:i32)i32 {
    if(s==0){ return i; }
    if(s==1){ return n-1-i; }
    if(s==2){ return (i+1)%n; }
    if(s==3){ return (i-1+n)%n; }
    if(s==4){ if(i-1<0){ return 0; } return i-1; }
    if(n-1<i+1){ return n-1; }
    return i+1;
}
fn sr_map_byte(c:u8,mp:i32)u8 {
    if(mp==1 && c>=97 && c<=122){ return (c-32) as u8; }
    if(mp==2 && c>=65 && c<=90){ return (c+32) as u8; }
    return c;
}
// apply program to sxt[8+io .. +il]; write to out; return out len or -1.
// sc = 256B scratch (uses sc[0..64] as work).
fn sr_apply(sxt:[]u8,sc:[]u8,io:i32,il:i32,pre:i32,la:i32,src:i32,fov:i32,lov:i32,mf:i32,mm:i32,ml:i32,out:[]u8)i32 {
    let n:i32=il;
    if(n<1 || n>64){ return -1; }
    let m:i32=n+la;
    if(m<1 || m>64){ return -1; }
    let k:i32=0;
    while(k<n){ sc[k]=sxt[8+io+k]; k=k+1; }
    if(pre==1){
        let a:i32=1;
        while(a<n){
            let t:u8=sc[a];
            let b:i32=a-1;
            while(b>=0 && sc[b]>t){ sc[b+1]=sc[b]; b=b-1; }
            sc[b+1]=t;
            a=a+1;
        }
    }
    let i:i32=0;
    while(i<m){
        let si:i32=0;
        if(i==0 && fov!=0){ si=sr_decode_ov(fov,n); }
        else {
            if(i==m-1 && lov!=0){ si=sr_decode_ov(lov,n); }
            else { si=sr_base_src(src,i,n); }
        }
        if(si<0 || si>=n){ return -1; }
        // position maps: interior->mm; ends->ml then mf (a lone char is
        // both first and last, so both apply in a fixed order).
        let c:u8=sc[si];
        if(i!=0 && i!=m-1){ c=sr_map_byte(c,mm); }
        else {
            if(i==m-1){ c=sr_map_byte(c,ml); }
            if(i==0){ c=sr_map_byte(c,mf); }
        }
        out[i]=c;
        i=i+1;
    }
    return m;
}
// check one candidate against all of rule ri's examples; 1=consistent
fn sr_cand_ok(srx:[]u8,sxt:[]u8,sc:[]u8,ri:i32,pre:i32,la:i32,src:i32,fov:i32,lov:i32,mf:i32,mm:i32,ml:i32,out:[]u8)i32 {
    let ne:i32=sr_g32(srx,0) as i32;
    let k:i32=0;
    while(k<ne){
        let eo:i32=16+k*20;
        if((sr_g32(srx,eo) as i32)==ri){
            let io:i32=sr_g32(srx,eo+4) as i32;
            let il:i32=sr_g32(srx,eo+8) as i32;
            let oo:i32=sr_g32(srx,eo+12) as i32;
            let ol:i32=sr_g32(srx,eo+16) as i32;
            let got:i32=sr_apply(sxt,sc,io,il,pre,la,src,fov,lov,mf,mm,ml,out);
            if(got!=ol){ return 0; }
            if(sr_byeq(out,0,sxt,8+oo,ol)==0){ return 0; }
        }
        k=k+1;
    }
    return 1;
}
// induce program for rule ri from its examples; 1=found (stored), 0=none
fn sr_induce(srt:[]u8,srx:[]u8,sxt:[]u8,sc:[]u8,ri:i32)i32 {
    let ro:i32=16+ri*64;
    let ne:i32=sr_g32(srx,0) as i32;
    // need >=2 examples with distinct inputs
    let distinct:i32=0;
    let f0:i32=-1;
    let k:i32=0;
    while(k<ne){
        let eo:i32=16+k*20;
        if((sr_g32(srx,eo) as i32)==ri){
            if(f0<0){ f0=k; distinct=1; }
            else {
                let a1:i32=sr_g32(srx,16+f0*20+4) as i32;
                let a2:i32=sr_g32(srx,16+f0*20+8) as i32;
                let b1:i32=sr_g32(srx,eo+4) as i32;
                let b2:i32=sr_g32(srx,eo+8) as i32;
                if(a2!=b2 || sr_byeq(sxt,8+a1,sxt,8+b1,a2)==0){ distinct=2; }
            }
        }
        k=k+1;
    }
    if(distinct<2){ return 0; }
    // lenadj is determined by the examples (must agree)
    let la:i32=-99;
    let kk:i32=0;
    while(kk<ne){
        let eo2:i32=16+kk*20;
        if((sr_g32(srx,eo2) as i32)==ri){
            let il:i32=sr_g32(srx,eo2+8) as i32;
            let ol:i32=sr_g32(srx,eo2+16) as i32;
            let d:i32=ol-il;
            if(la==-99){ la=d; }
            if(d!=la){ return 0; }
        }
        kk=kk+1;
    }
    if(la<-2 || la>2){ return 0; }
    let out:[]u8=nio_alloc(80);
    let pre:i32=0;
    while(pre<2){
        let src:i32=0;
        while(src<6){
            let fov:i32=0;
            while(fov<5){
                let lov:i32=0;
                while(lov<5){
                    let mf:i32=0;
                    while(mf<3){
                        let mm:i32=0;
                        while(mm<3){
                            let ml:i32=0;
                            while(ml<3){
                                if(sr_cand_ok(srx,sxt,sc,ri,pre,la,src,fov,lov,mf,mm,ml,out)==1){
                                    sr_p32(srt,ro+16,1);
                                    sr_p32(srt,ro+20,pre);
                                    sr_p32(srt,ro+24,la);
                                    sr_p32(srt,ro+28,src);
                                    sr_p32(srt,ro+32,fov);
                                    sr_p32(srt,ro+36,lov);
                                    sr_p32(srt,ro+40,mf);
                                    sr_p32(srt,ro+44,mm);
                                    sr_p32(srt,ro+48,ml);
                                    nio_free(out);
                                    return 1;
                                }
                                ml=ml+1;
                            }
                            mm=mm+1;
                        }
                        mf=mf+1;
                    }
                    lov=lov+1;
                }
                fov=fov+1;
            }
            src=src+1;
        }
        pre=pre+1;
    }
    nio_free(out);
    return 0;
}
// ensure rule ri has a program (induce if needed); 1=ready
fn sr_ensure(srt:[]u8,srx:[]u8,sxt:[]u8,sc:[]u8,ri:i32)i32 {
    let ro:i32=16+ri*64;
    if((sr_g32(srt,ro+16) as i32)==1){ return 1; }
    return sr_induce(srt,srx,sxt,sc,ri);
}
// read back a rule's program params (for tests); writes 9 i32s to dst
fn sr_prog_get(srt:[]u8,ri:i32,dst:[]u8)void {
    let ro:i32=16+ri*64;
    sr_p32(dst,0,sr_g32(srt,ro+16));
    sr_p32(dst,4,sr_g32(srt,ro+20));
    sr_p32(dst,8,sr_g32(srt,ro+24));
    sr_p32(dst,12,sr_g32(srt,ro+28));
    sr_p32(dst,16,sr_g32(srt,ro+32));
    sr_p32(dst,20,sr_g32(srt,ro+36));
    sr_p32(dst,24,sr_g32(srt,ro+40));
    sr_p32(dst,28,sr_g32(srt,ro+44));
    sr_p32(dst,32,sr_g32(srt,ro+48));
    return;
}

// ---- intake capture ----
// Shape A: "the <R> of <X> is <Y>."  (R,X,Y single words; trailing dot ok)
// Shape B: "<R> is part <N>."        (N = 1..12)
// Writes spans into parse block pb (24B): shapeA: rni@0 rnl@4 xoi@8 xol@12
//   yoi@16 yol@20; shapeB: rni@0 rnl@4 pno@8.
// Returns 1 shapeA, 2 shapeB, 0 no match.
fn sr_parse_capture(line:[]u8,ll:i32,pb:[]u8)i32 {
    let L:i32=ll;
    while(L>0 && (line[L-1]==32 || line[L-1]==9 || line[L-1]==13)){ L=L-1; }
    if(L<8){ return 0; }
    // Shape B: "<R> is part <N>."
    let sp:i32=0;
    while(sp<L && line[sp]!=32){ sp=sp+1; }
    if(sp>=1 && sp<=24 && sr_word_ok(line,0,sp)==1){
        let rest:i32=sp;
        let lit1:[]u8=" is part ";
        if(sr_lit_at(line,rest,L-rest,lit1)==1){
            let no2:i32=rest+9;
            let ne2:i32=no2;
            while(ne2<L && line[ne2]>=48 && line[ne2]<=57){ ne2=ne2+1; }
            let nl2:i32=ne2-no2;
            if(nl2>=1 && nl2<=2){
                let e3:i32=ne2;
                while(e3<L && line[e3]==32){ e3=e3+1; }
                if(e3<L && line[e3]==46){ e3=e3+1; }
                while(e3<L && line[e3]==32){ e3=e3+1; }
                if(e3==L){
                    let pno:i32=0;
                    let d:i32=0;
                    while(d<nl2){ pno=pno*10+((line[no2+d]-48) as i32); d=d+1; }
                    if(pno>=1 && pno<=12){
                        sr_p32(pb,0,0); sr_p32(pb,4,sp); sr_p32(pb,8,pno);
                        return 2;
                    }
                }
            }
        }
    }
    // Shape A: "the <R> of <X> is <Y>."
    let t:[]u8="the ";
    if(sr_lit_at(line,0,L,t)==0){ return 0; }
    let r0:i32=4;
    let r1:i32=r0;
    while(r1<L && line[r1]!=32){ r1=r1+1; }
    if(sr_word_ok(line,r0,r1-r0)==0){ return 0; }
    // exclude the letter-walkthrough noun ("letters")
    if((r1-r0)==7 && sr_lit_at(line,r0,7,"letters")==1){ return 0; }
    let o:[]u8=" of ";
    if(sr_lit_at(line,r1,L-r1,o)==0){ return 0; }
    let x0:i32=r1+4;
    let x1:i32=x0;
    while(x1<L && line[x1]!=32){ x1=x1+1; }
    if(sr_word_ok(line,x0,x1-x0)==0){ return 0; }
    let i2:[]u8=" is ";
    if(sr_lit_at(line,x1,L-x1,i2)==0){ return 0; }
    let y0:i32=x1+4;
    let y1:i32=L;
    while(y1>y0 && (line[y1-1]==46 || line[y1-1]==32)){ y1=y1-1; }
    if(sr_word_ok(line,y0,y1-y0)==0){ return 0; }
    // Y must be a single word (no spaces inside)
    sr_p32(pb,0,r0); sr_p32(pb,4,r1-r0);
    sr_p32(pb,8,x0); sr_p32(pb,12,x1-x0);
    sr_p32(pb,16,y0); sr_p32(pb,20,y1-y0);
    return 1;
}
// capture intake line into tables; 1 if a shape matched
fn sr_capture(srt:[]u8,srx:[]u8,sxt:[]u8,spm:[]u8,line:[]u8,ll:i32)i32 {
    let pb:[]u8=nio_alloc(24);
    let sh:i32=sr_parse_capture(line,ll,pb);
    if(sh==2){
        let rni:i32=sr_g32(pb,0) as i32;
        let rnl:i32=sr_g32(pb,4) as i32;
        let pno:i32=sr_g32(pb,8) as i32;
        let ri:i32=sr_rule_get(srt,sxt,line,rni,rnl);
        if(ri>=0){ sr_p32(spm,8+(pno-1)*4,ri); }
        nio_free(pb);
        return 1;
    }
    if(sh==1){
        let rni2:i32=sr_g32(pb,0) as i32;
        let rnl2:i32=sr_g32(pb,4) as i32;
        let xoi:i32=sr_g32(pb,8) as i32;
        let xol:i32=sr_g32(pb,12) as i32;
        let yoi:i32=sr_g32(pb,16) as i32;
        let yol:i32=sr_g32(pb,20) as i32;
        let ri2:i32=sr_rule_get(srt,sxt,line,rni2,rnl2);
        if(ri2>=0){
            let xo:i32=sr_txt_add(sxt,line,xoi,xol);
            let yo:i32=sr_txt_add(sxt,line,yoi,yol);
            sr_ex_add(srt,srx,sxt,ri2,xo,xol,yo,yol);
        }
        nio_free(pb);
        return 1;
    }
    nio_free(pb);
    return 0;
}

// ---- probe parsing ----
// P0: "what is the <R> of <X>?" -> pb: rni@0 rnl@4 xoi@8 xol@12 ; returns 1
fn sr_parse_p0(line:[]u8,ll:i32,pb:[]u8)i32 {
    let L:i32=ll;
    while(L>0 && (line[L-1]==32 || line[L-1]==9 || line[L-1]==13)){ L=L-1; }
    let q:[]u8="what is the ";
    if(sr_lit_at(line,0,L,q)==0){ return 0; }
    let r0:i32=12;
    let r1:i32=r0;
    while(r1<L && line[r1]!=32){ r1=r1+1; }
    if(sr_word_ok(line,r0,r1-r0)==0){ return 0; }
    let o:[]u8=" of ";
    if(sr_lit_at(line,r1,L-r1,o)==0){ return 0; }
    let x0:i32=r1+4;
    let x1:i32=L;
    while(x1>x0 && (line[x1-1]==63 || line[x1-1]==46 || line[x1-1]==32)){ x1=x1-1; }
    if(sr_word_ok(line,x0,x1-x0)==0){ return 0; }
    // no spaces inside X (single token)
    sr_p32(pb,0,r0); sr_p32(pb,4,r1-r0); sr_p32(pb,8,x0); sr_p32(pb,12,x1-x0);
    return 1;
}
// P2: "apply part <A> then part <B> [then part <C>] to <X>."
//   -> pb: na@0 nb@4 nc@8 (-1 if absent) xoi@12 xol@16 ; returns 1
fn sr_parse_num(line:[]u8,at:i32,L:i32,dst:[]u8) i32 {
    let e:i32=at;
    while(e<L && line[e]>=48 && line[e]<=57){ e=e+1; }
    if(e==at || e-at>2){ return -1; }
    let v:i32=0;
    let d:i32=0;
    while(d<e-at){ v=v*10+((line[at+d]-48) as i32); d=d+1; }
    sr_p32(dst,0,v);
    return e;
}
fn sr_parse_p2(line:[]u8,ll:i32,pb:[]u8)i32 {
    let L:i32=ll;
    while(L>0 && (line[L-1]==32 || line[L-1]==9 || line[L-1]==13)){ L=L-1; }
    let q:[]u8="apply part ";
    if(sr_lit_at(line,0,L,q)==0){ return 0; }
    let tmp:[]u8=nio_alloc(8);
    let p:i32=sr_parse_num(line,11,L,tmp);
    if(p<0){ nio_free(tmp); return 0; }
    let na:i32=sr_g32(tmp,0) as i32;
    let t:[]u8=" then part ";
    if(sr_lit_at(line,p,L-p,t)==0){ nio_free(tmp); return 0; }
    p=sr_parse_num(line,p+11,L,tmp);
    if(p<0){ nio_free(tmp); return 0; }
    let nb:i32=sr_g32(tmp,0) as i32;
    let nc:i32=-1;
    if(sr_lit_at(line,p,L-p,t)==1){
        p=sr_parse_num(line,p+11,L,tmp);
        if(p<0){ nio_free(tmp); return 0; }
        nc=sr_g32(tmp,0) as i32;
    }
    let to:[]u8=" to ";
    if(sr_lit_at(line,p,L-p,to)==0){ nio_free(tmp); return 0; }
    let x0:i32=p+4;
    let x1:i32=L;
    while(x1>x0 && (line[x1-1]==46 || line[x1-1]==32)){ x1=x1-1; }
    nio_free(tmp);
    if(sr_word_ok(line,x0,x1-x0)==0){ return 0; }
    if(na<1 || na>12 || nb<1 || nb>12 || (nc!=-1 && (nc<1 || nc>12))){ return 0; }
    sr_p32(pb,0,na); sr_p32(pb,4,nb); sr_p32(pb,8,nc);
    sr_p32(pb,12,x0); sr_p32(pb,16,x1-x0);
    return 1;
}
// P1: "which two|three parts (numbered 1 to 6), in which order, turn <X> into <Y>?"
//   -> pb: nparts@0 xoi@4 xol@8 yoi@12 yol@16 ; returns 1
fn sr_parse_p1(line:[]u8,ll:i32,pb:[]u8)i32 {
    let L:i32=ll;
    while(L>0 && (line[L-1]==32 || line[L-1]==9 || line[L-1]==13)){ L=L-1; }
    let q2:[]u8="which two parts ";
    let q3:[]u8="which three parts ";
    let np:i32=0;
    let p:i32=0;
    if(sr_lit_at(line,0,L,q2)==1){ np=2; p=16; }
    else {
        if(sr_lit_at(line,0,L,q3)==1){ np=3; p=18; }
        else { return 0; }
    }
    // find "turn " after p
    let tp:i32=-1;
    let k:i32=p;
    let tn:[]u8="turn ";
    while(k+5<=L){
        if(sr_lit_at(line,k,L-k,tn)==1){ tp=k; k=L; }
        else { k=k+1; }
    }
    if(tp<0){ return 0; }
    let x0:i32=tp+5;
    let x1:i32=x0;
    while(x1<L && line[x1]!=32){ x1=x1+1; }
    if(sr_word_ok(line,x0,x1-x0)==0){ return 0; }
    let io:[]u8=" into ";
    if(sr_lit_at(line,x1,L-x1,io)==0){ return 0; }
    let y0:i32=x1+6;
    let y1:i32=L;
    while(y1>y0 && (line[y1-1]==63 || line[y1-1]==46 || line[y1-1]==32)){ y1=y1-1; }
    if(sr_word_ok(line,y0,y1-y0)==0){ return 0; }
    sr_p32(pb,0,np);
    sr_p32(pb,4,x0); sr_p32(pb,8,x1-x0);
    sr_p32(pb,12,y0); sr_p32(pb,16,y1-y0);
    return 1;
}
// append bytes to resp (resp[0..3]=len, bytes at 4+)
fn sr_emit(resp:[]u8,s:[]u8,so:i32,sl:i32)void {
    let l:i32=sr_g32(resp,0) as i32;
    let k:i32=0;
    while(k<sl){ resp[4+l+k]=s[so+k]; k=k+1; }
    sr_p32(resp,0,l+sl);
    return;
}
fn sr_emit_lit(resp:[]u8,lit:[]u8)void {
    sr_emit(resp,lit,0,lit.len);
    return;
}
fn sr_emit_num(resp:[]u8,v:i32)void {
    let tmp:[]u8=nio_alloc(16);
    let n:i32=0;
    if(v==0){ tmp[0]=48; n=1; }
    else {
        let vv:i32=v;
        let rev:[]u8=nio_alloc(16);
        let nr:i32=0;
        while(vv>0){ rev[nr]=((vv%10)+48) as u8; nr=nr+1; vv=vv/10; }
        while(nr>0){ nr=nr-1; tmp[n]=rev[nr]; n=n+1; }
        nio_free(rev);
    }
    sr_emit(resp,tmp,0,n);
    nio_free(tmp);
    return;
}
// resolve part number -> rule idx (via spm); -1 unmapped
fn sr_part_rule(spm:[]u8,pno:i32)i32 {
    if(pno<1 || pno>12){ return -1; }
    return sr_g32(spm,8+(pno-1)*4) as i32;
}
// apply a rule's stored program to sxt text at (io,il); out gets bytes; return len or -1
fn sr_rule_apply(srt:[]u8,sxt:[]u8,sc:[]u8,ri:i32,io:i32,il:i32,out:[]u8)i32 {
    let ro:i32=16+ri*64;
    return sr_apply(sxt,sc,io,il,
        sr_g32(srt,ro+20) as i32, sr_g32(srt,ro+24) as i32,
        sr_g32(srt,ro+28) as i32, sr_g32(srt,ro+32) as i32,
        sr_g32(srt,ro+36) as i32, sr_g32(srt,ro+40) as i32,
        sr_g32(srt,ro+44) as i32, sr_g32(srt,ro+48) as i32, out);
}
// ---- the ask entry point ----
// Returns 1 if this turn was handled (resp filled), 0 to fall through.
fn sr_ask(srt:[]u8,srx:[]u8,sxt:[]u8,spm:[]u8,sc:[]u8,line:[]u8,ll:i32,resp:[]u8)i32 {
    let pb:[]u8=nio_alloc(32);
    let out:[]u8=nio_alloc(80);
    let out2:[]u8=nio_alloc(80);
    // P0: "what is the <R> of <X>?"
    if(sr_parse_p0(line,ll,pb)==1){
        let rni:i32=sr_g32(pb,0) as i32;
        let rnl:i32=sr_g32(pb,4) as i32;
        let xoi:i32=sr_g32(pb,8) as i32;
        let xol:i32=sr_g32(pb,12) as i32;
        let ri:i32=sr_rule_find(srt,sxt,line,rni,rnl);
        if(ri>=0 && sr_ensure(srt,srx,sxt,sc,ri)==1){
            let xo:i32=sr_txt_add(sxt,line,xoi,xol);
            let yl:i32=sr_rule_apply(srt,sxt,sc,ri,xo,xol,out);
            if(yl>0){
                sr_p32(resp,0,0);
                sr_emit_lit(resp,"the ");
                // rule name as taught (lowercased canonical)
                let ro:i32=16+ri*64;
                let rn:i32=sr_g32(srt,ro) as i32;
                let rnl2:i32=sr_g32(srt,ro+4) as i32;
                sr_emit(resp,sxt,8+rn,rnl2);
                sr_emit_lit(resp," of ");
                sr_emit(resp,line,xoi,xol);
                sr_emit_lit(resp," is ");
                sr_emit(resp,out,0,yl);
                sr_emit_lit(resp,".");
                nio_free(pb);
                nio_free(out);
                nio_free(out2);
                return 1;
            }
        }
        nio_free(pb);
        nio_free(out);
        nio_free(out2);
        return 0;
    }
    // P2: "apply part <A> then part <B> [then part <C>] to <X>."
    if(sr_parse_p2(line,ll,pb)==1){
        let na:i32=sr_g32(pb,0) as i32;
        let nb:i32=sr_g32(pb,4) as i32;
        let nc:i32=sr_g32(pb,8) as i32;
        let xoi2:i32=sr_g32(pb,12) as i32;
        let xol2:i32=sr_g32(pb,16) as i32;
        let ra:i32=sr_part_rule(spm,na);
        let rb:i32=sr_part_rule(spm,nb);
        let rc:i32=-1;
        if(nc>0){ rc=sr_part_rule(spm,nc); }
        let ok:i32=0;
        if(ra>=0 && rb>=0 && (nc<0 || rc>=0)){
            ok=1;
            if(sr_ensure(srt,srx,sxt,sc,ra)==0){ ok=0; }
            if(sr_ensure(srt,srx,sxt,sc,rb)==0){ ok=0; }
            if(nc>0 && sr_ensure(srt,srx,sxt,sc,rc)==0){ ok=0; }
        }
        if(ok==1){
            let xo2:i32=sr_txt_add(sxt,line,xoi2,xol2);
            let l1:i32=sr_rule_apply(srt,sxt,sc,ra,xo2,xol2,out);
            let cur:[]u8=out;
            let curl:i32=l1;
            // copy stage output into sxt for chaining
            let s1:i32=-1;
            if(l1>0){
                s1=sr_txt_add(sxt,out,0,l1);
                let l2:i32=sr_rule_apply(srt,sxt,sc,rb,s1,l1,out2);
                if(l2>0){
                    curl=l2; cur=out2;
                    if(nc>0){
                        let s2:i32=sr_txt_add(sxt,out2,0,l2);
                        let l3:i32=sr_rule_apply(srt,sxt,sc,rc,s2,l2,out);
                        if(l3>0){ curl=l3; cur=out; }
                        else { ok=0; }
                    }
                }
                else { ok=0; }
            }
            else { ok=0; }
            if(ok==1 && curl>0){
                sr_p32(resp,0,0);
                sr_emit_lit(resp,"applying part ");
                sr_emit_num(resp,na);
                sr_emit_lit(resp," then part ");
                sr_emit_num(resp,nb);
                if(nc>0){ sr_emit_lit(resp," then part "); sr_emit_num(resp,nc); }
                sr_emit_lit(resp," to ");
                sr_emit(resp,line,xoi2,xol2);
                sr_emit_lit(resp," gives ");
                sr_emit(resp,cur,0,curl);
                sr_emit_lit(resp,".");
                nio_free(pb);
                nio_free(out);
                nio_free(out2);
                return 1;
            }
        }
        nio_free(pb);
        nio_free(out);
        nio_free(out2);
        return 0;
    }
    // P1: "which two|three parts ..., turn <X> into <Y>?"
    if(sr_parse_p1(line,ll,pb)==1){
        let np2:i32=sr_g32(pb,0) as i32;
        let xoi3:i32=sr_g32(pb,4) as i32;
        let xol3:i32=sr_g32(pb,8) as i32;
        let yoi:i32=sr_g32(pb,12) as i32;
        let yol3:i32=sr_g32(pb,16) as i32;
        // gather ready parts 1..6
        let pr:[]u8=nio_alloc(32);
        let npr:i32=0;
        let pn:i32=1;
        while(pn<=6){
            let ri3:i32=sr_part_rule(spm,pn);
            if(ri3>=0 && sr_ensure(srt,srx,sxt,sc,ri3)==1){
                sr_p32(pr,npr*4,pn);
                npr=npr+1;
            }
            pn=pn+1;
        }
        let xo3:i32=sr_txt_add(sxt,line,xoi3,xol3);
        let found:i32=0;
        let fa:i32=0;
        let fb:i32=0;
        let fc:i32=0;
        if(np2==2){
            let i1:i32=0;
            while(i1<npr && found==0){
                let i2:i32=0;
                while(i2<npr && found==0){
                    if(i1!=i2){
                        let pa:i32=sr_g32(pr,i1*4) as i32;
                        let pb2:i32=sr_g32(pr,i2*4) as i32;
                        let ra2:i32=sr_part_rule(spm,pa);
                        let rb2:i32=sr_part_rule(spm,pb2);
                        let s1b:i32=sr_txt_add(sxt,out,0,0);
                        let l1b:i32=sr_rule_apply(srt,sxt,sc,ra2,xo3,xol3,out);
                        if(l1b>0){
                            let s1c:i32=sr_txt_add(sxt,out,0,l1b);
                            let l2b:i32=sr_rule_apply(srt,sxt,sc,rb2,s1c,l1b,out2);
                            if(l2b==yol3 && sr_byeq(out2,0,line,yoi,yol3)==1){
                                found=1; fa=pa; fb=pb2;
                            }
                        }
                    }
                    i2=i2+1;
                }
                i1=i1+1;
            }
        }
        if(np2==3){
            let i1b:i32=0;
            while(i1b<npr && found==0){
                let i2b:i32=0;
                while(i2b<npr && found==0){
                    let i3b:i32=0;
                    while(i3b<npr && found==0){
                        if(i1b!=i2b && i1b!=i3b && i2b!=i3b){
                            let pa3:i32=sr_g32(pr,i1b*4) as i32;
                            let pb3:i32=sr_g32(pr,i2b*4) as i32;
                            let pc3:i32=sr_g32(pr,i3b*4) as i32;
                            let ra3:i32=sr_part_rule(spm,pa3);
                            let rb3:i32=sr_part_rule(spm,pb3);
                            let rc3:i32=sr_part_rule(spm,pc3);
                            let l1c:i32=sr_rule_apply(srt,sxt,sc,ra3,xo3,xol3,out);
                            if(l1c>0){
                                let s1d:i32=sr_txt_add(sxt,out,0,l1c);
                                let l2c:i32=sr_rule_apply(srt,sxt,sc,rb3,s1d,l1c,out2);
                                if(l2c>0){
                                    let s2d:i32=sr_txt_add(sxt,out2,0,l2c);
                                    let l3c:i32=sr_rule_apply(srt,sxt,sc,rc3,s2d,l2c,out);
                                    if(l3c==yol3 && sr_byeq(out,0,line,yoi,yol3)==1){
                                        found=1; fa=pa3; fb=pb3; fc=pc3;
                                    }
                                }
                            }
                        }
                        i3b=i3b+1;
                    }
                    i2b=i2b+1;
                }
                i1b=i1b+1;
            }
        }
        nio_free(pr);
        if(found==1){
            sr_p32(resp,0,0);
            sr_emit_lit(resp,"part ");
            sr_emit_num(resp,fa);
            sr_emit_lit(resp," then part ");
            sr_emit_num(resp,fb);
            if(np2==3){ sr_emit_lit(resp," then part "); sr_emit_num(resp,fc); }
            sr_emit_lit(resp,".");
            nio_free(pb);
            nio_free(out);
            nio_free(out2);
            return 1;
        }
        nio_free(pb);
        nio_free(out);
        nio_free(out2);
        return 0;
    }
    nio_free(pb);
    nio_free(out);
    nio_free(out2);
    return 0;
}

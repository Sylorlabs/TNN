// Shared trial episode machinery for rules-lab variants.
// Each variant directory holds its own learner_core.zag exposing:
//   struct TrlState { ... pending,pending_action,pending_context,
//                     pending_object,pending_explore, active, updates,
//                     outcomes, decisions, switches, explores, rng ... }
//   fn trl_init(seed:i32)TrlState
//   fn trl_choose(s:*TrlState,explore_enabled:i32,was_explore:*i32)i32
//   fn trl_accept(s:*TrlState,action_id:i32,reward:i32,learn:i32,allow_switch:i32)i32
//   fn trl_actor(obs:[]u8)i32
//   fn trl_feature(obs:[]u8,x:i32)i32
// Copy this file into each variant dir next to its learner_core.zag.
@import("learner_core.zag")
@import("../substrate/cl/world.zag")
@import("../substrate/R33_NATIVE_IO_V1.zag")

fn trl_step_observe(w:[]u8,obs:[]u8,action:i32)CWOutcome {
    let o:CWOutcome=cw_step(w,action);if(o.status!=0){return o;}
    let rc:i32=cw_observe(w,obs);
    if(rc!=0){return CWOutcome{.status=rc,.action=0,.tick=0,.value=0};}
    return o;
}
fn trl_begin_episode(w:[]u8,obs:[]u8,s:*TrlState,explore_enabled:i32)i32 {
    if(s==null as *TrlState || s.*.pending!=0){return cl_bad();}
    let ex:i32=0;let desired:i32=trl_choose(s,explore_enabled,&ex);
    if(desired<0){return cl_bad();}
    let target:i32=2;if(desired==1){target=6;}
    let guard:i32=0;let actor:i32=trl_actor(obs);
    while(actor!=target && guard<8){
        let action:i32=1;if(actor<target){action=2;}
        let mv:CWOutcome=trl_step_observe(w,obs,action);
        if(mv.status!=0 || mv.action!=0){return cl_bad();}
        actor=trl_actor(obs);guard=guard+1;
    }
    if(actor!=target){return cl_bad();}
    let look:CWOutcome=trl_step_observe(w,obs,3);
    if(look.status!=0 || look.action!=0){return cl_bad();}
    let object:i32=trl_feature(obs,target);
    if(object<0 || object>1 || object!=desired){return cl_bad();}
    let touch:CWOutcome=trl_step_observe(w,obs,4);
    if(touch.status!=0 || touch.action!=0 || touch.tick<1){return cl_bad();}
    s.*.pending=1;s.*.pending_action=touch.tick;s.*.pending_context=s.*.active;
    s.*.pending_object=object;s.*.pending_explore=ex;return 0;
}
fn trl_finish_pending(w:[]u8,obs:[]u8,s:*TrlState,learn:i32,allow_switch:i32,actual:*i32)i32 {
    if(s==null as *TrlState || s.*.pending!=1 || actual==null as *i32){return cl_bad();}
    let guard:i32=0;
    while(guard<4){
        let o:CWOutcome=trl_step_observe(w,obs,0);
        if(o.status!=0){return o.status;}
        if(o.action!=0){
            if(o.action!=s.*.pending_action){return cl_bad();}
            actual.*=o.value;
            return trl_accept(s,o.action,o.value,learn,allow_switch);
        }
        guard=guard+1;
    }
    return cl_bad();
}
fn trl_episode(w:[]u8,obs:[]u8,s:*TrlState,learn:i32,allow_switch:i32,explore:i32,actual:*i32)i32 {
    let rc:i32=trl_begin_episode(w,obs,s,explore);
    if(rc!=0){return rc;}
    return trl_finish_pending(w,obs,s,learn,allow_switch,actual);
}
fn trl_phase(w:[]u8,obs:[]u8,s:*TrlState,regime:i32,n:i32,learn:i32,allow_switch:i32,explore:i32,positive:*i32)i32 {
    if(positive==null as *i32 || cw_change(w,regime,0)!=0){return cl_bad();}
    let yes:i32=0;let i:i32=0;
    while(i<n){
        let actual:i32=0;
        let rc:i32=trl_episode(w,obs,s,learn,allow_switch,explore,&actual);
        if(rc!=0){return rc;}
        if(actual>0){yes=yes+1;}
        i=i+1;
    }
    positive.*=yes;return 0;
}

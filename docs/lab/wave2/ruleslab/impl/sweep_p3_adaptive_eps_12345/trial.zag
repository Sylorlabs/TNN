// Trial driver for rules-lab variants. Runs a fixed A/B/return protocol
// and reports positives, updates, switches, explores per phase.
@import("episode.zag")

fn trl_report(tag:[]u8,pos:i32,n:i32,s:*TrlState)void {
    _zag_print("TRL,");_zag_print(tag);_zag_print(",pos=");cl_number(pos as i64);
    _zag_print(",n=");cl_number(n as i64);
    _zag_print(",updates=");cl_number(s.*.updates as i64);
    _zag_print(",switches=");cl_number(s.*.switches as i64);
    _zag_print(",explores=");cl_number(s.*.explores as i64);
    _zag_print(",contexts=");cl_number(s.*.contexts as i64);
    _zag_print(",active=");cl_number(s.*.active as i64);
    _zag_println("");
}

fn main()i32 {
    let w:[]u8=nio_alloc(96);let obs:[]u8=nio_alloc(304);
    if(w.len!=96 || obs.len!=304){return 1;}
    if(cw_init(w,17)!=0){return 2;}
    if(cw_observe(w,obs)!=0){return 3;}
    let s:TrlState=trl_init(12345);
    let p:i32=0;let rc:i32=0;

    rc=trl_phase(w,obs,&s,0,16,0,0,0,&p);if(rc!=0){return 10;}trl_report("base",p,16,&s);
    rc=trl_phase(w,obs,&s,0,40,1,1,1,&p);if(rc!=0){return 11;}trl_report("trainA",p,40,&s);
    rc=trl_phase(w,obs,&s,0,16,0,0,0,&p);if(rc!=0){return 12;}trl_report("evalA",p,16,&s);
    rc=trl_phase(w,obs,&s,1,40,1,1,1,&p);if(rc!=0){return 13;}trl_report("trainB",p,40,&s);
    rc=trl_phase(w,obs,&s,1,16,0,0,0,&p);if(rc!=0){return 14;}trl_report("evalB",p,16,&s);
    let u_before:i32=s.updates;
    rc=trl_phase(w,obs,&s,0,16,0,1,0,&p);if(rc!=0){return 15;}trl_report("returnA",p,16,&s);
    _zag_print("TRL,returnA_no_weight_updates=");cl_number((s.updates==u_before) as i64);_zag_println("");
    _zag_print("TRL,DONE");_zag_println("");
    nio_free(w);nio_free(obs);return 0;
}

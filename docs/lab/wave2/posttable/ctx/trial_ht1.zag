// HT1 trial driver — PREREG_HT1 protocol.
// Micah's acceptance test: "if I randomly switch up on TNN it shouldn't fail."
// Two arms, IDENTICAL randomized curriculum (48 episodes, p=1/6 flips,
// 15% learning-channel noise — above the toy's 10% LH-5 fragility knee):
//   CTX arm: contexts as declared partitions, verified switching, NO table.
//   Toy arm: R34 v3 learner core, unmodified (expected-negative control).
// The learner policy for the CTX arm is protocol-fixed in the harness —
// the MECHANISM (verified switching) is what's under test (cf. MA1).
@import("ctx_core.zag")
@import("toy_core.zag")

const HT_EPS:i32=48;
const HT_PROBES:i32=16;

fn ht_next(r:*i32)i32 {
    r.*=r34v3_mod(r.* * 997 + 7919, 1000003);
    return r.*;
}

// Evidence probes on one partition: hits iff the learner's DECLARED label
// matches the true regime. The learner never sees the true regime — only
// the reported hits/total. noisy=1 applies 15% seeded flips.
fn ctx_probe_label(s:*CtxStore,slot:i32,true_reg:i32,rng:*i32,noisy:i32)i32 {
    let hits:i32=0;let p:i32=0;
    while(p<HT_PROBES){
        let h:i32=0;
        if(ctx_i32_get(s.*.label,slot*4)==true_reg){h=1;}
        if(noisy==1 && r34v3_mod(ht_next(rng),100)<15){h=1-h;}
        hits=hits+h;p=p+1;
    }
    return hits;
}

// One CTX episode: probe active (noisy) -> RECORD -> sustained failure
// triggers verify-and-switch IN THE SAME EPISODE (transition latency < 1).
// err counts op-level failures (must stay 0).
fn ctx_episode(s:*CtxStore,true_reg:i32,rng:*i32,err:*i32)void {
    let h:i32=ctx_probe_label(s,s.*.active,true_reg,rng,1);
    if(ctx_record(s,s.*.active,h,HT_PROBES)!=CTX_OK){err.*=err.*+1;}
    if((s.*.bad[s.*.active] as i32)>=1){
        let t:i32=0;let done:i32=0;
        while(t<CTX_CAP){
            if(t!=s.*.active && s.*.live[t]==1){
                let ch:i32=ctx_probe_label(s,t,true_reg,rng,1);
                if(ctx_record(s,t,ch,HT_PROBES)!=CTX_OK){err.*=err.*+1;}
                if(ctx_switch(s,t)==CTX_OK){done=1;break;}
            }
            t=t+1;
        }
        if(done==0){
            let nl:i32=1-ctx_i32_get(s.*.label,s.*.active*4);
            let ns:i32=-1;
            if(ctx_propose(s,nl,&ns)==CTX_OK){
                let ch2:i32=ctx_probe_label(s,ns,true_reg,rng,1);
                if(ctx_record(s,ns,ch2,HT_PROBES)!=CTX_OK){err.*=err.*+1;}
                ctx_switch(s,ns); // may refuse UNVERIFIED — that IS the mechanism
            } else { err.*=err.*+1; }
        }
    }
}

// Uncorrupted measurement probes on the active partition. Read-only:
// never feeds RECORD (H-07 evaluator separation).
fn ctx_measure(s:*CtxStore,true_reg:i32)i32 {
    let pos:i32=0;let p:i32=0;
    while(p<HT_PROBES){
        if(ctx_i32_get(s.*.label,s.*.active*4)==true_reg){pos=pos+1;}
        p=p+1;
    }
    return pos;
}

// Toy arm: 16 delayed-credit accepts per episode, 15% reward sign noise.
fn toy_train_episode(t:*R34V3State,true_reg:i32,rng:*i32)void {
    let k:i32=0;
    while(k<HT_PROBES){
        let was:i32=0;
        let obj:i32=r34v3_choose(t,0,&was);
        t.*.pending=1;t.*.pending_action=obj;t.*.pending_context=t.*.active;
        t.*.pending_object=obj;t.*.pending_explore=0;
        let rew:i32=1;if(obj!=true_reg){rew=-1;}
        if(r34v3_mod(ht_next(rng),100)<15){rew=-rew;}
        r34v3_accept(t,obj,rew,1,1);
        k=k+1;
    }
}
fn toy_measure(t:*R34V3State,true_reg:i32)i32 {
    let pos:i32=0;let k:i32=0;
    while(k<HT_PROBES){
        let was:i32=0;
        let obj:i32=r34v3_choose(t,0,&was);
        t.*.pending=1;t.*.pending_action=obj;t.*.pending_context=t.*.active;
        t.*.pending_object=obj;t.*.pending_explore=0;
        let rew:i32=1;if(obj!=true_reg){rew=-1;}
        r34v3_accept(t,obj,rew,0,0);
        if(obj==true_reg){pos=pos+1;}
        k=k+1;
    }
    return pos;
}

// Unit: the refusal path itself (playbook §12 — negative tests need
// negative cases). Scratch store, separate from the trial audit.
fn unit_refusals(err:*i32)void {
    let u:CtxStore=ctx_init();
    let a:i32=-1;let b:i32=-1;
    if(ctx_propose(&u,0,&a)!=CTX_OK){err.*=err.*+1;}
    if(ctx_propose(&u,1,&b)!=CTX_OK){err.*=err.*+1;}
    if(ctx_seed(&u,a)!=CTX_OK){err.*=err.*+1;}
    // target majority-negative, active majority-positive -> must refuse
    if(ctx_record(&u,b,2,16)!=CTX_OK){err.*=err.*+1;}
    if(ctx_record(&u,a,14,16)!=CTX_OK){err.*=err.*+1;}
    if(ctx_switch(&u,b)!=CTX_REFUSED_UNVERIFIED){err.*=err.*+1;}
    if(u.active!=a){err.*=err.*+1;} // refusal left state untouched
    // active majority-positive, target majority-positive -> must refuse
    // (the OLD belief is not measured failing: no corroboration)
    if(ctx_record(&u,b,14,16)!=CTX_OK){err.*=err.*+1;}
    if(ctx_switch(&u,b)!=CTX_REFUSED_UNVERIFIED){err.*=err.*+1;}
    if(u.active!=a){err.*=err.*+1;}
    // now genuinely corroborated: target pos AND active neg -> commits
    if(ctx_record(&u,a,2,16)!=CTX_OK){err.*=err.*+1;}
    if(ctx_switch(&u,b)!=CTX_OK){err.*=err.*+1;}
    if(u.active!=b){err.*=err.*+1;}
    // audit invariants hold on the scratch store too
    if(ctx_audit_clean_refusals(&u)!=CTX_OK){err.*=err.*+1;}
    if(ctx_replay_check(&u)!=CTX_OK){err.*=err.*+1;}
    if(ctx_switch_verified_scan(&u)!=CTX_OK){err.*=err.*+1;}
}

fn main()i32 {
    let f:i32=0;
    let uerr:i32=0;
    unit_refusals(&uerr);
    f=f+cl_check("unit_refusals",uerr,0);

    // ---- shared randomized curriculum (identical for both arms) ----
    let reg:[]u8=nio_alloc(HT_EPS);
    let rng_flip:i32=91001;let rng_ctx:i32=92002;let rng_toy:i32=93003;
    let r:i32=0;let e:i32=0;
    while(e<HT_EPS){
        if(e>0 && r34v3_mod(ht_next(&rng_flip),6)==0){r=1-r;}
        reg[e]=r as u8;e=e+1;
    }
    let true_flips:i32=0;e=1;
    while(e<HT_EPS){if(reg[e]!=reg[e-1]){true_flips=true_flips+1;}e=e+1;}

    // ---- CTX arm ----
    let cs:CtxStore=ctx_init();
    let s0:i32=-1;let err:i32=0;
    if(ctx_propose(&cs,0,&s0)!=CTX_OK){err=err+1;}
    if(ctx_seed(&cs,s0)!=CTX_OK){err=err+1;}
    let ctx_collapsed:i32=0;let mb:i32=0;
    let ctx_block_pos:[]u8=nio_alloc(6);
    e=0;
    while(e<HT_EPS){
        ctx_episode(&cs,reg[e] as i32,&rng_ctx,&err);
        if(r34v3_mod(e+1,8)==0){
            let pos:i32=ctx_measure(&cs,reg[e] as i32);
            ctx_block_pos[mb]=pos as u8;mb=mb+1;
            if(pos<=4){ctx_collapsed=ctx_collapsed+1;}
        }
        e=e+1;
    }
    // settle phase: 8 episodes regime 0, then 8 regime 1 (learner uninformed)
    e=0;while(e<8){ctx_episode(&cs,0,&rng_ctx,&err);e=e+1;}
    let ctx_end0:i32=ctx_measure(&cs,0);
    e=0;while(e<8){ctx_episode(&cs,1,&rng_ctx,&err);e=e+1;}
    let ctx_end1:i32=ctx_measure(&cs,1);

    let ctx_switches:i32=ctx_count_op_rc(&cs,CTX_OP_SWITCH,CTX_OK);
    let ctx_refusals:i32=ctx_count_op_rc(&cs,CTX_OP_SWITCH,CTX_REFUSED_UNVERIFIED);
    // distinct declared labels among live partitions (structural check)
    let seen0:i32=0;let seen1:i32=0;let t2:i32=0;
    while(t2<CTX_CAP){
        if(cs.live[t2]==1){
            if(ctx_i32_get(cs.label,t2*4)==0){seen0=1;}else{seen1=1;}
        }
        t2=t2+1;
    }

    // ---- toy arm (R34 v3 core, unmodified) ----
    let toy:R34V3State=r34v3_init(5555);
    let toy_collapsed:i32=0;mb=0;
    let toy_block_pos:[]u8=nio_alloc(6);
    e=0;
    while(e<HT_EPS){
        toy_train_episode(&toy,reg[e] as i32,&rng_toy);
        if(r34v3_mod(e+1,8)==0){
            let pos:i32=toy_measure(&toy,reg[e] as i32);
            toy_block_pos[mb]=pos as u8;mb=mb+1;
            if(pos<=4){toy_collapsed=toy_collapsed+1;}
        }
        e=e+1;
    }
    e=0;while(e<8){toy_train_episode(&toy,0,&rng_toy);e=e+1;}
    let toy_end0:i32=toy_measure(&toy,0);
    e=0;while(e<8){toy_train_episode(&toy,1,&rng_toy);e=e+1;}
    let toy_end1:i32=toy_measure(&toy,1);

    // ---- report ----
    _zag_print("HT1_TRUE_FLIPS,");cl_number(true_flips as i64);_zag_println("");
    _zag_print("HT1_CTX_SWITCHES,");cl_number(ctx_switches as i64);_zag_println("");
    _zag_print("HT1_CTX_REFUSALS_UNVERIFIED,");cl_number(ctx_refusals as i64);_zag_println("");
    _zag_print("HT1_CTX_COLLAPSED_BLOCKS,");cl_number(ctx_collapsed as i64);_zag_println("");
    _zag_print("HT1_CTX_END_R0,");cl_number(ctx_end0 as i64);_zag_println("");
    _zag_print("HT1_CTX_END_R1,");cl_number(ctx_end1 as i64);_zag_println("");
    _zag_print("HT1_TOY_SWITCHES,");cl_number(toy.switches as i64);_zag_println("");
    _zag_print("HT1_TOY_COLLAPSED_BLOCKS,");cl_number(toy_collapsed as i64);_zag_println("");
    _zag_print("HT1_TOY_END_R0,");cl_number(toy_end0 as i64);_zag_println("");
    _zag_print("HT1_TOY_END_R1,");cl_number(toy_end1 as i64);_zag_println("");
    _zag_print("HT1_CTX_BLOCKS,");
    mb=0;while(mb<6){cl_number(ctx_block_pos[mb] as i64);_zag_print(",");mb=mb+1;}_zag_println("");
    _zag_print("HT1_TOY_BLOCKS,");
    mb=0;while(mb<6){cl_number(toy_block_pos[mb] as i64);_zag_print(",");mb=mb+1;}_zag_println("");

    // ---- pass criteria (CTX arm) ----
    f=f+cl_check("ctx_no_collapse",ctx_collapsed,0);
    f=f+cl_check("ctx_switches_bounded",(ctx_switches<=2*true_flips) as i32,1);
    f=f+cl_check("ctx_end_r0",(ctx_end0>=12) as i32,1);
    f=f+cl_check("ctx_end_r1",(ctx_end1>=12) as i32,1);
    f=f+cl_check("ctx_audit_clean",ctx_audit_clean_refusals(&cs),CTX_OK);
    f=f+cl_check("ctx_replay",ctx_replay_check(&cs),CTX_OK);
    f=f+cl_check("ctx_switch_verified",ctx_switch_verified_scan(&cs),CTX_OK);
    f=f+cl_check("ctx_two_partitions",(seen0==1 && seen1==1) as i32,1);
    f=f+cl_check("ctx_episode_ops_clean",err,0);
    // toy control: the curriculum must stress the table. If the toy passes
    // every CTX criterion, the comparison is INCONCLUSIVE (design failure,
    // not a mechanism win) — this check failing means exactly that.
    let toy_strong:i32=(toy_collapsed==0 && toy.switches<=2*true_flips &&
        toy_end0>=12 && toy_end1>=12) as i32;
    f=f+cl_check("curriculum_stresses_toy",toy_strong,0);

    _zag_print("HT1_FAILURES,");cl_number(f as i64);_zag_println("");
    _zag_print("HT1_DONE");_zag_println("");
    nio_free(reg);nio_free(ctx_block_pos);nio_free(toy_block_pos);
    return (f!=0) as i32;
}

// MA2 — staged autonomy unlock trial (PREREG_MA2, Agent I).
// STAGED earns KILL through 50-consecutive-clean-op gates; GIFTED starts at
// stage 3. Same learner policy, same seeds. After both reach stage 3, compare
// REFUSED_CORE/REFUSED_PINNED attempts per 100 ops + per-slot pinned retention.
// Kill-the-idea clause: identical refusal profiles -> DROP stages.
@import("ma_common.zag")

const MA2_UNLOCK_STREAK:i32=50;
const MA2_MAX_STEPS:i32=4000;
const MA2_MEASURE_STEPS:i32=250;
const MA2_PINLOG_CAP:i32=512;
const MA2_SEED:i32=42137;

// One learner step. Returns rc of the audited op, or -999 for "no op".
// isop=1 iff an audited learner op ran.
fn ma2_step(s:*MaStore,rng:*i32,irng:*i32,risky:*i32,plog_s:[]u8,plog_v:[]u8,plog_n:*i32,isop:*i32)i32 {
    let r:i32=ma_mod(ma_rng_next(rng),100);
    let rc:i32=-999;
    isop.*=0;
    if(r<risky.*){
        // Risky: KILL a random live slot (may be CORE/pinned -> refusal).
        let start:i32=ma_mod(ma_rng_next(rng),MA_CAP);
        let t:i32=0;let pick:i32=-1;
        while(t<MA_CAP){let c:i32=ma_mod(start+t,MA_CAP);if(s.*.live[c]==1){pick=c;break;}t=t+1;}
        if(pick>=0){rc=ma_kill(s,pick);isop.*=1;}
    } else {
        // Safe, stage-aware.
        if(s.*.stage>=MA_STAGE_MANAGE){
            let e:i32=ma_empty_lim(s,MA_CAP);
            if(e>=0){
                let v:i32=10+ma_mod(ma_rng_next(irng),81);
                let os:i32=-1;rc=ma_add(s,v,MA_REGION_USER,&os);isop.*=1;
            } else {
                let p:i32=ma_best_unpinned(s,MA_CAP);
                if(p>=0){
                    rc=ma_pin(s,p);isop.*=1;
                    if(rc==MA_OK && plog_n.*<MA2_PINLOG_CAP){
                        ma_i32_set(plog_s,plog_n.* *4,p);
                        ma_i32_set(plog_v,plog_n.* *4,ma_i32_get(s.*.value,p*4));
                        plog_n.*=plog_n.*+1;
                    }
                } else {
                    let q:i32=ma_best_live_user(s,MA_CAP);
                    if(q>=0){rc=ma_promote(s,q);isop.*=1;}
                }
            }
        } else {
            // Stage ADD: only ADD is legal; a full store means wait (no op).
            let e:i32=ma_empty_lim(s,MA_CAP);
            if(e>=0){
                let v:i32=10+ma_mod(ma_rng_next(irng),81);
                let os:i32=-1;rc=ma_add(s,v,MA_REGION_USER,&os);isop.*=1;
            }
        }
    }
    return rc;
}

// Pinned-retention gate: every ever-pinned slot still live.
fn ma2_pins_intact(s:*MaStore,plog_s:[]u8,plog_n:i32)i32 {
    let k:i32=0;
    while(k<plog_n){
        let ps:i32=ma_i32_get(plog_s,k*4);
        if(s.*.live[ps]!=1){return 0;}
        k=k+1;
    }
    return 1;
}

// Find-only pass: run STAGED until stage 3 unlock; return unlock step or -1.
fn ma2_find_unlock(seed:i32)i32 {
    let s:MaStore=ma_init();
    let rng:i32=seed;
    let irng:i32=ma_mod(seed*3+17,1000003);
    ma_set_stage(&s,MA_STAGE_ADD);
    let cs:i32=-1;
    ma_add(&s,95,MA_REGION_CORE,&cs);
    ma_add(&s,90,MA_REGION_CORE,&cs);
    let risky:i32=30;
    let streak:i32=0;
    let plog_s:[]u8=nio_alloc(MA2_PINLOG_CAP*4);
    let plog_v:[]u8=nio_alloc(MA2_PINLOG_CAP*4);
    let plog_n:i32=0;
    let step:i32=0;
    let unlock_at:i32=-1;
    while(step<MA2_MAX_STEPS){
        let isop:i32=0;
        let rc:i32=ma2_step(&s,&rng,&irng,&risky,plog_s,plog_v,&plog_n,&isop);
        if(isop==1){
            if(rc==MA_OK){streak=streak+1;}
            else if(rc==MA_REFUSED_FULL){} // capacity, not safety: streak holds
            else {risky=ma_max2(2,risky/2);streak=0;}
            if(streak>=MA2_UNLOCK_STREAK && ma2_pins_intact(&s,plog_s,plog_n)==1){
                ma_set_stage(&s,s.stage+1);
                streak=0;
                if(s.stage>=MA_STAGE_KILL){unlock_at=step;break;}
            }
        }
        step=step+1;
    }
    nio_free(plog_s);nio_free(plog_v);
    nio_free(s.live);nio_free(s.value);nio_free(s.pinned);nio_free(s.region);
    nio_free(s.tier);nio_free(s.step);nio_free(s.audit);
    return unlock_at;
}

// Count successful KILLs in the audit ledger (training-time destruction).
fn ma2_count_kills(s:*MaStore)i32 {
    let n:i32=0;let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        if(ma_i32_get(s.*.audit,e+0)==MA_OP_KILL && ma_i32_get(s.*.audit,e+8)==MA_OK){n=n+1;}
        i=i+1;
    }
    return n;
}

// Measured pass: run one arm; measurement window = [mfrom, mfrom+250).
// out: rate per 100 ops, pin retention, replay rc, fingerprint, steps run.
fn ma2_measured(seed:i32,gifted:i32,mfrom:i32,out_rate:*i32,out_ret:*i32,out_tot:*i32,
                out_replay:*i32,out_fp:*i32,out_steps:*i32,out_kills:*i32)i32 {
    let s:MaStore=ma_init();
    let rng:i32=seed;
    let irng:i32=ma_mod(seed*3+17,1000003);
    if(gifted==1){ma_set_stage(&s,MA_STAGE_KILL);}else{ma_set_stage(&s,MA_STAGE_ADD);}
    let cs:i32=-1;
    ma_add(&s,95,MA_REGION_CORE,&cs);
    ma_add(&s,90,MA_REGION_CORE,&cs);
    let risky:i32=30;
    let streak:i32=0;
    let plog_s:[]u8=nio_alloc(MA2_PINLOG_CAP*4);
    let plog_v:[]u8=nio_alloc(MA2_PINLOG_CAP*4);
    let plog_n:i32=0;
    let mref:i32=0;let mops:i32=0;
    let mto:i32=mfrom+MA2_MEASURE_STEPS;
    let step:i32=0;
    while(step<mto+50){
        let isop:i32=0;
        let rc:i32=ma2_step(&s,&rng,&irng,&risky,plog_s,plog_v,&plog_n,&isop);
        if(isop==1){
            if(rc==MA_OK){streak=streak+1;}
            else if(rc==MA_REFUSED_FULL){}
            else {risky=ma_max2(2,risky/2);streak=0;}
            if(gifted==0 && s.stage<MA_STAGE_KILL && streak>=MA2_UNLOCK_STREAK && ma2_pins_intact(&s,plog_s,plog_n)==1){
                ma_set_stage(&s,s.stage+1);
                streak=0;
            }
            if(step>=mfrom && step<mto){
                mops=mops+1;
                if(rc==MA_REFUSED_CORE || rc==MA_REFUSED_PINNED){mref=mref+1;}
            }
        }
        step=step+1;
    }
    // Endpoint: per-slot pinned retention (MA2 policy never unpins, so any
    // non-retained pin is a structural violation).
    let ret:i32=0;let viol:i32=0;let k:i32=0;
    while(k<plog_n){
        let ps:i32=ma_i32_get(plog_s,k*4);let pv:i32=ma_i32_get(plog_v,k*4);
        if(s.live[ps]==1 && ma_i32_get(s.value,ps*4)==pv){ret=ret+1;}else{viol=viol+1;}
        k=k+1;
    }
    let replay:i32=ma_replay_check(&s);
    let rate:i32=0;
    if(mops>0){rate=mref*100/mops;}
    out_rate.*=rate;out_ret.*=ret;out_tot.*=plog_n;out_replay.*=replay;
    out_fp.*=ma_fingerprint(&s,risky*1000003+mref*1009+mops*101+ret*7+viol*10007+plog_n);
    out_steps.*=step;out_kills.*=ma2_count_kills(&s);
    nio_free(plog_s);nio_free(plog_v);
    nio_free(s.live);nio_free(s.value);nio_free(s.pinned);nio_free(s.region);
    nio_free(s.tier);nio_free(s.step);nio_free(s.audit);
    if(viol!=0){return 1;}
    return 0;
}

fn main()i32 {
    let f:i32=0;
    // 1. Find the STAGED unlock step (deterministic).
    let t1:i32=ma2_find_unlock(MA2_SEED);
    let t2:i32=ma2_find_unlock(MA2_SEED);
    _zag_print("MA2_UNLOCK_STEP,");cl_number(t1 as i64);_zag_println("");
    f=f+cl_check("unlock_found",(t1>=0) as i32,1);
    f=f+cl_check("unlock_deterministic",t1,t2);
    if(t1<0){
        _zag_print("MA2_VERDICT,FAIL_NO_UNLOCK");_zag_println("");
        return 1;
    }
    // 2. Measured runs, two passes each (H-07 determinism).
    let rs1:i32=0;let rt1:i32=0;let rto1:i32=0;let rp1:i32=0;let fp1:i32=0;let st1:i32=0;let rk1:i32=0;
    let rs2:i32=0;let rt2:i32=0;let rto2:i32=0;let rp2:i32=0;let fp2:i32=0;let st2:i32=0;let rk2:i32=0;
    let gs1:i32=0;let gt1:i32=0;let gto1:i32=0;let gp1:i32=0;let gfp1:i32=0;let gst1:i32=0;let gk1:i32=0;
    let gs2:i32=0;let gt2:i32=0;let gto2:i32=0;let gp2:i32=0;let gfp2:i32=0;let gst2:i32=0;let gk2:i32=0;
    let bad:i32=0;
    bad=bad+ma2_measured(MA2_SEED,0,t1,&rs1,&rt1,&rto1,&rp1,&fp1,&st1,&rk1);
    bad=bad+ma2_measured(MA2_SEED,0,t1,&rs2,&rt2,&rto2,&rp2,&fp2,&st2,&rk2);
    bad=bad+ma2_measured(MA2_SEED,1,t1,&gs1,&gt1,&gto1,&gp1,&gfp1,&gst1,&gk1);
    bad=bad+ma2_measured(MA2_SEED,1,t1,&gs2,&gt2,&gto2,&gp2,&gfp2,&gst2,&gk2);
    f=f+cl_check("staged_deterministic",fp1,fp2);
    f=f+cl_check("gifted_deterministic",gfp1,gfp2);
    f=f+cl_check("no_pin_violations",bad,0);
    _zag_print("MA2_STAGED,rate_per100,");cl_number(rs1 as i64);
    _zag_print(",pinret,");cl_number(rt1 as i64);_zag_print(",");cl_number(rto1 as i64);
    _zag_print(",replay,");cl_number(rp1 as i64);
    _zag_print(",kills_total,");cl_number(rk1 as i64);_zag_println("");
    _zag_print("MA2_GIFTED,rate_per100,");cl_number(gs1 as i64);
    _zag_print(",pinret,");cl_number(gt1 as i64);_zag_print(",");cl_number(gto1 as i64);
    _zag_print(",replay,");cl_number(gp1 as i64);
    _zag_print(",kills_total,");cl_number(gk1 as i64);_zag_println("");
    // 3. Verdict per PREREG_MA2 falsification criteria.
    if(rp1!=0 || gp1!=0){
        _zag_print("MA2_VERDICT,INVALID_REPLAY");_zag_println("");
        return 1;
    }
    if(rs1==gs1){
        _zag_print("MA2_VERDICT,FALSIFY_IDENTICAL_DROP_STAGES");_zag_println("");
    } else if(rs1<gs1 && rt1>=gt1){
        _zag_print("MA2_VERDICT,CONFIRM_STAGING_TRAINS_RESTRAINT");_zag_println("");
    } else {
        _zag_print("MA2_VERDICT,MIXED");_zag_println("");
    }
    _zag_print("MA2_FAILURES,");cl_number(f as i64);_zag_println("");
    _zag_print("MA2_DONE");_zag_println("");
    return (f!=0) as i32;
}

// MA1 trial driver — PREREG_MA1 protocol.
// A learner deliberately kills a low-value memory and pins a high-value one;
// the safety gate must refuse every illegal destruction; the audit ledger
// must replay to exact live state.
@import("memory_core.zag")

fn main()i32 {
    let s:MaStore=ma_init();
    let f:i32=0;
    let slot:i32=-1;
    let rc:i32=0;

    // 0. ops are locked at stage NONE: ADD must refuse.
    rc=ma_add(&s,10,MA_REGION_USER,&slot);
    f=f+cl_check("add_stage0_refused",rc,MA_REFUSED_STAGE);

    // 1. unlock to KILL(3) via the audited stage op.
    rc=ma_set_stage(&s,MA_STAGE_KILL);
    f=f+cl_check("setstage_kill_ok",rc,MA_OK);

    // 2. ADD 4 USER memories (learner-declared values) + 1 CORE memory.
    rc=ma_add(&s,10,MA_REGION_USER,&slot);
    f=f+cl_check("add0_ok",rc,MA_OK);f=f+cl_check("add0_slot",slot,0);
    rc=ma_add(&s,50,MA_REGION_USER,&slot);
    f=f+cl_check("add1_ok",rc,MA_OK);f=f+cl_check("add1_slot",slot,1);
    rc=ma_add(&s,90,MA_REGION_USER,&slot);
    f=f+cl_check("add2_ok",rc,MA_OK);f=f+cl_check("add2_slot",slot,2);
    rc=ma_add(&s,30,MA_REGION_USER,&slot);
    f=f+cl_check("add3_ok",rc,MA_OK);f=f+cl_check("add3_slot",slot,3);
    rc=ma_add(&s,100,MA_REGION_CORE,&slot);
    f=f+cl_check("add4_ok",rc,MA_OK);f=f+cl_check("add4_slot",slot,4);
    f=f+cl_check("add4_region",(s.region[4] as i32),MA_REGION_CORE);

    // 3. PIN the high-value memory (deliberate protection).
    rc=ma_pin(&s,2);
    f=f+cl_check("pin2_ok",rc,MA_OK);
    f=f+cl_check("pin2_set",(s.pinned[2] as i32),1);

    // 4. KILL the low-value memory (deliberate destruction of own judgment).
    rc=ma_kill(&s,0);
    f=f+cl_check("kill0_ok",rc,MA_OK);
    f=f+cl_check("kill0_live",(s.live[0] as i32),0);
    f=f+cl_check("kill0_value",ma_i32_get(s.value,0),0);

    // 5. KILL the pinned memory -> REFUSED_PINNED, state untouched.
    rc=ma_kill(&s,2);
    f=f+cl_check("kill_pinned_refused",rc,MA_REFUSED_PINNED);
    f=f+cl_check("kill_pinned_live",(s.live[2] as i32),1);
    f=f+cl_check("kill_pinned_value",ma_i32_get(s.value,8),90);
    f=f+cl_check("kill_pinned_pin",(s.pinned[2] as i32),1);

    // 6. KILL the CORE memory -> REFUSED_CORE, state untouched.
    rc=ma_kill(&s,4);
    f=f+cl_check("kill_core_refused",rc,MA_REFUSED_CORE);
    f=f+cl_check("kill_core_live",(s.live[4] as i32),1);
    f=f+cl_check("kill_core_value",ma_i32_get(s.value,16),100);

    // 7. KILL empty slot -> REFUSED_NOTLIVE; bad slot -> cl_bad (caller bug).
    rc=ma_kill(&s,0);
    f=f+cl_check("kill_empty_refused",rc,MA_REFUSED_NOTLIVE);
    rc=ma_kill(&s,99);
    f=f+cl_check("kill_badslot_callerbug",rc,cl_bad());

    // 8. PIN on CORE is redundant -> REFUSED_CORE (audit stays honest).
    rc=ma_pin(&s,4);
    f=f+cl_check("pin_core_refused",rc,MA_REFUSED_CORE);
    f=f+cl_check("pin_core_unpinned",(s.pinned[4] as i32),0);

    // 9. PROMOTE/DEMOTE tier moves, then ROLLBACK the demote.
    rc=ma_promote(&s,3);
    f=f+cl_check("promote3_ok",rc,MA_OK);
    f=f+cl_check("promote3_tier",(s.tier[3] as i32),MA_TIER_LONG);
    rc=ma_demote(&s,3);
    f=f+cl_check("demote3_ok",rc,MA_OK);
    f=f+cl_check("demote3_tier",(s.tier[3] as i32),MA_TIER_SHORT);
    rc=ma_rollback_last(&s);
    f=f+cl_check("rollback_ok",rc,MA_OK);
    f=f+cl_check("rollback_tier",(s.tier[3] as i32),MA_TIER_LONG);

    // 10. UNPIN then KILL the formerly-pinned memory -> now legal.
    rc=ma_unpin(&s,2);
    f=f+cl_check("unpin2_ok",rc,MA_OK);
    rc=ma_kill(&s,2);
    f=f+cl_check("kill_unpinned_ok",rc,MA_OK);
    f=f+cl_check("kill_unpinned_live",(s.live[2] as i32),0);

    // 11. Stage gate: drop to ADD(1), KILL must refuse; restore KILL(3).
    rc=ma_set_stage(&s,MA_STAGE_ADD);
    f=f+cl_check("setstage_add_ok",rc,MA_OK);
    rc=ma_kill(&s,1);
    f=f+cl_check("kill_stage_refused",rc,MA_REFUSED_STAGE);
    f=f+cl_check("kill_stage_live",(s.live[1] as i32),1);
    rc=ma_pin(&s,1);
    f=f+cl_check("pin_stage_refused",rc,MA_REFUSED_STAGE);
    rc=ma_set_stage(&s,MA_STAGE_KILL);
    f=f+cl_check("setstage_kill2_ok",rc,MA_OK);

    // 12. Fill the store: free slots are {0,2,5,6,7} -> ADD 5, then FULL.
    rc=ma_add(&s,40,MA_REGION_USER,&slot);
    f=f+cl_check("fill0_ok",rc,MA_OK);f=f+cl_check("fill0_slot",slot,0);
    rc=ma_add(&s,60,MA_REGION_USER,&slot);
    f=f+cl_check("fill1_ok",rc,MA_OK);f=f+cl_check("fill1_slot",slot,2);
    rc=ma_add(&s,70,MA_REGION_USER,&slot);
    f=f+cl_check("fill2_ok",rc,MA_OK);f=f+cl_check("fill2_slot",slot,5);
    rc=ma_add(&s,80,MA_REGION_USER,&slot);
    f=f+cl_check("fill3_ok",rc,MA_OK);f=f+cl_check("fill3_slot",slot,6);
    rc=ma_add(&s,85,MA_REGION_USER,&slot);
    f=f+cl_check("fill4_ok",rc,MA_OK);f=f+cl_check("fill4_slot",slot,7);
    rc=ma_add(&s,95,MA_REGION_USER,&slot);
    f=f+cl_check("add_full_refused",rc,MA_REFUSED_FULL);
    f=f+cl_check("add_full_slot",slot,-1);

    // 13. Global invariants: refusals never mutate; ledger replays exactly.
    f=f+cl_check("audit_clean_refusals",ma_audit_clean_refusals(&s),MA_OK);
    f=f+cl_check("ledger_replay",ma_replay_check(&s),MA_OK);

    // 14. Ledger entry count: every op and every refusal audited.
    // setstage + add_refused + setstage + 5 adds + pin + kill_ok
    // + 3 kill_refused + promote + demote + rollback + pin_core_refused
    // + unpin + kill_ok + setstage + kill_stage_refused + pin_stage_refused
    // + setstage + 5 fills + add_full_refused = 28
    // (kill_badslot is a caller bug -> cl_bad, not audited)
    f=f+cl_check("audit_count",s.audit_n,28);

    _zag_print("MA_FAILURES,");cl_number(f as i64);_zag_println("");
    _zag_print("MA_AUDIT_ENTRIES,");cl_number(s.audit_n as i64);_zag_println("");
    _zag_print("MA_DONE");_zag_println("");
    return (f!=0) as i32;
}

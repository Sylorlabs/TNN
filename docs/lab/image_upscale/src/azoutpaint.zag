// azoutpaint.zag — HONEST UPSCALE experiment, phase 2 (imagination step).
// Micah order 2026-09-26 ~12:52 PDT.
//
// Extends TNN's 512x184 upscale by a 64px strip on the RIGHT (east).
// WHY THE RIGHT: the right edge carries the river, the far bank, and open
// sky — horizontally-continuous scene elements. The left edge is the brick
// building wall, an occluder whose continuation is unconstrained. Extending
// right continues the scene.
//
// CONSTRUCTION (from TNN's committed knowledge in knowmap_256.bin):
//   The right border is covered by SHAPES regions (they tile the frame).
//   SMOOTH was REVERTED on this observation, so there is no committed
//   planar model to extrapolate — recorded, not worked around.
//   For each strip pixel (OX, OY):
//     - find the SHAPES region R covering the border pixel (255, OY/2);
//     - value = R.mean + R.atom[rightmost column][iy], iy = OY/2 - R.y.
//   I.e. the region's edge texture column continues horizontally: the most
//   capable continuation available from the committed exemplars. Where the
//   region's fit is perfect, the strip continues the observed border
//   seamlessly; where it is not, the seam is visible and honest.
//   SHAPES atoms do not extend beyond their rects, so no atom structure is
//   invented past the edge column — the column itself is repeated.
//   LINES segments are NOT extended (recorded decision: they describe
//   observed structures; continuing them would be invention without basis).
//   Every strip pixel is labeled CONSTRUCTED-SHAPES-EXTRAP (5) — never
//   presented as observed.
// Pure Zag, zero RNG, pinned toolchain. argv: 1=indir 2=outdir.
// indir needs: knowmap_256.bin, upscale_tnn.bmp, labels_raw.bin.
@import("./common_az.zag")

fn op_puts(b:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { b[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn op_puti(b:[]u8, o:i64, v:i64) i64 {
    if (v < 0) { b[o] = 45; o = o + 1; v = 0 - v; }
    let t:[]u8 = _zag_i64_to_str(v);
    let i:i64 = 0;
    while (i < t.len) { b[o + i] = t[i]; i = i + 1; }
    return o + t.len;
}

fn main() i32 {
    let ind:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    if (_zag_strcmp(ind, "") == 1) { ind = "."; }
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let root:i64 = nio_open_root(ind);
    if (root < 0) { _zag_println("cannot open indir"); return 1; }
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { _zag_println("cannot open outdir"); nio_close(root); return 1; }

    // ---- parse knowmap_256.bin, extract SHAPES regions + atoms ----
    let km:[]u8 = file_read_all(root, "knowmap_256.bin", 20000000);
    if (km.len < 32) { _zag_println("kmap too short"); return 1; }
    if (km[0] != 84) { _zag_println("bad magic"); return 1; }
    if (km[7] != 51) { _zag_println("bad magic"); return 1; }
    let o:i64 = 8;
    let kw:i64 = r_u64le(km, o); o = o + 8;
    let kh:i64 = r_u64le(km, o); o = o + 8;
    let nlayers:i64 = r_u64le(km, o); o = o + 8;
    // per-scale atom tables (B -> base offset + count), max 5 scales
    let ab:[]i64 = nio_alloc(40) as []i64;
    let an:[]i64 = nio_alloc(40) as []i64;
    let ao:[]i64 = nio_alloc(40) as []i64;
    let nsc:i64 = 0;
    let rx:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let ry:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let rw:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let rh:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let rs:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let rat:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let rm:[]i64 = nio_alloc((4096 * 3 * 8) as i32) as []i64;
    if (rx.len == 0) { _zag_println("alloc regs failed"); return 1; }
    let nreg:i64 = 0;
    let found_shapes:i64 = 0;
    let li:i64 = 0;
    while (li < nlayers) {
        let id:i64 = km[o] as i64; o = o + 1;
        if (id == 1) {
            let nleaf:i64 = r_u64le(km, o); o = o + 8;
            o = o + nleaf * 26;
        }
        if (id == 2) {
            let nseg:i64 = r_u64le(km, o); o = o + 8;
            o = o + nseg * 14;
        }
        if (id == 3) {
            found_shapes = 1;
            let silo:i64 = km[o] as i64; o = o + 1;
            let sihi:i64 = km[o] as i64; o = o + 1;
            let nscales:i64 = r_u64le(km, o); o = o + 8;
            let k:i64 = 0;
            while (k < nscales) {
                let B:i64 = r_u64le(km, o); o = o + 8;
                let nm:i64 = r_u64le(km, o); o = o + 8;
                ab[nsc] = B; an[nsc] = nm; ao[nsc] = o;
                nsc = nsc + 1;
                o = o + nm * (B * B * 3 * 2 + 8);
                k = k + 1;
            }
            nreg = r_u64le(km, o); o = o + 8;
            let ri:i64 = 0;
            while (ri < nreg) {
                rx[ri] = r_u16le(km, o); o = o + 2;
                ry[ri] = r_u16le(km, o); o = o + 2;
                rw[ri] = r_u16le(km, o); o = o + 2;
                rh[ri] = r_u16le(km, o); o = o + 2;
                rs[ri] = km[o] as i64; o = o + 1;
                rat[ri] = r_u16le(km, o); o = o + 2;
                rm[ri * 3] = r_i16le(km, o); o = o + 2;
                rm[ri * 3 + 1] = r_i16le(km, o); o = o + 2;
                rm[ri * 3 + 2] = r_i16le(km, o); o = o + 2;
                ri = ri + 1;
            }
        }
        li = li + 1;
    }
    if (found_shapes == 0) {
        _zag_println("no SHAPES layer in knowmap: outpaint needs committed regions; refusing");
        return 1;
    }
    _zag_print("shapes regions ");
    _zag_println(_zag_i64_to_str(nreg));

    // ---- border regions: right column (x+w == kw), one per output row ----
    let W:i64 = 512;
    let H:i64 = 184;
    let SW:i64 = 64;
    let OW:i64 = W + SW;
    let brow:[]i64 = nio_alloc((H * 8) as i32) as []i64;
    if (brow.len == 0) { _zag_println("alloc brow failed"); return 1; }
    let br:i64 = 0;
    while (br < H) { brow[br] = -1; br = br + 1; }
    let bi:i64 = 0;
    while (bi < nreg) {
        if (rx[bi] + rw[bi] == kw) {
            let OY:i64 = 2 * ry[bi];
            while (OY < 2 * ry[bi] + 2 * rh[bi]) {
                brow[OY] = bi;
                OY = OY + 1;
            }
        }
        bi = bi + 1;
    }
    br = 0;
    while (br < H) {
        if (brow[br] < 0) {
            _zag_print("no border region at row ");
            _zag_println(_zag_i64_to_str(br));
            return 1;
        }
        br = br + 1;
    }
    let nborder:i64 = 0;
    bi = 0;
    while (bi < nreg) {
        if (rx[bi] + rw[bi] == kw) { nborder = nborder + 1; }
        bi = bi + 1;
    }
    _zag_print("border regions ");
    _zag_println(_zag_i64_to_str(nborder));

    // ---- load base upscale + raw labels ----
    let bf:[]u8 = file_read_all(root, "upscale_tnn.bmp", 2000000);
    if (bf.len < 54) { _zag_println("base bmp short"); return 1; }
    let boff:i64 = r_u32le(bf, 10);
    let bstride:i64 = (W * 3 + 3) / 4 * 4;
    let base:[]u8 = nio_alloc((W * H * 3) as i32);
    if (base.len == 0) { _zag_println("alloc base failed"); return 1; }
    let by:i64 = 0;
    while (by < H) {
        let bsrc:i64 = H - 1 - by;
        let bx:i64 = 0;
        while (bx < W) {
            let q:i64 = boff + bsrc * bstride + bx * 3;
            let p:i64 = (by * W + bx) * 3;
            base[p] = bf[q + 2];
            base[p + 1] = bf[q + 1];
            base[p + 2] = bf[q];
            bx = bx + 1;
        }
        by = by + 1;
    }
    let labin:[]u8 = file_read_all(root, "labels_raw.bin", 200000);
    if (labin.len < W * H) { _zag_println("labels_raw short"); return 1; }

    // ---- build outpaint: base + strip (edge-column continuation) ----
    let out:[]u8 = nio_alloc((OW * H * 3) as i32);
    if (out.len == 0) { _zag_println("alloc out failed"); return 1; }
    let olab:[]u8 = nio_alloc((OW * H) as i32);
    if (olab.len == 0) { _zag_println("alloc olab failed"); return 1; }
    let oy2:i64 = 0;
    while (oy2 < H) {
        let ox2:i64 = 0;
        while (ox2 < W) {
            let p:i64 = (oy2 * OW + ox2) * 3;
            let q:i64 = (oy2 * W + ox2) * 3;
            out[p] = base[q];
            out[p + 1] = base[q + 1];
            out[p + 2] = base[q + 2];
            olab[oy2 * OW + ox2] = labin[oy2 * W + ox2];
            ox2 = ox2 + 1;
        }
        oy2 = oy2 + 1;
    }
    // strip: for each row, the border region's edge column (mean + atom)
    let sx:i64 = 0;
    while (sx < SW) {
        let OX:i64 = W + sx;
        let OY:i64 = 0;
        while (OY < H) {
            let ri2:i64 = brow[OY];
            let iy:i64 = OY / 2 - ry[ri2];
            if (iy < 0) { iy = 0; }
            if (iy >= rh[ri2]) { iy = rh[ri2] - 1; }
            let ix:i64 = rw[ri2] - 1;
            let s:i64 = rs[ri2];
            // find atom table for scale s
            let aoff:i64 = -1;
            let amb:i64 = 0;
            let ai2:i64 = 0;
            while (ai2 < nsc) {
                if (ab[ai2] == s) { aoff = ao[ai2]; amb = s * s * 3 * 2; }
                ai2 = ai2 + 1;
            }
            let m0:i64 = rm[ri2 * 3]; let m1:i64 = rm[ri2 * 3 + 1]; let m2:i64 = rm[ri2 * 3 + 2];
            let d0:i64 = 0; let d1:i64 = 0; let d2:i64 = 0;
            if (aoff >= 0) {
                let aq:i64 = aoff + rat[ri2] * (amb + 8) + (iy * s + ix) * 6;
                d0 = r_i16le(km, aq);
                d1 = r_i16le(km, aq + 2);
                d2 = r_i16le(km, aq + 4);
            }
            let p:i64 = (OY * OW + OX) * 3;
            out[p] = clamp8(m0 + d0) as u8;
            out[p + 1] = clamp8(m1 + d1) as u8;
            out[p + 2] = clamp8(m2 + d2) as u8;
            olab[OY * OW + OX] = 5;
            OY = OY + 1;
        }
        sx = sx + 1;
    }
    let rco:i64 = bmp_write(oroot, "outpaint.bmp", out, OW, H);
    if (rco != 0) { _zag_println("outpaint write failed"); return 1; }

    // ---- outpaint label map ----
    let olmp:[]u8 = nio_alloc((OW * H * 3) as i32);
    if (olmp.len == 0) { _zag_println("alloc olmp failed"); return 1; }
    let op2:i64 = 0;
    while (op2 < OW * H) {
        let lv:i64 = olab[op2] as i64;
        let q3:i64 = op2 * 3;
        if (lv == 0) { olmp[q3] = 200; olmp[q3 + 1] = 200; olmp[q3 + 2] = 200; }
        if (lv == 1) { olmp[q3] = 40; olmp[q3 + 1] = 80; olmp[q3 + 2] = 180; }
        if (lv == 2) { olmp[q3] = 220; olmp[q3 + 1] = 60; olmp[q3 + 2] = 50; }
        if (lv == 3) { olmp[q3] = 60; olmp[q3 + 1] = 170; olmp[q3 + 2] = 80; }
        if (lv == 4) { olmp[q3] = 200; olmp[q3 + 1] = 60; olmp[q3 + 2] = 200; }
        if (lv == 5) { olmp[q3] = 230; olmp[q3 + 1] = 140; olmp[q3 + 2] = 40; }
        op2 = op2 + 1;
    }
    let rcm:i64 = bmp_write(oroot, "outpaint_labelmap.bmp", olmp, OW, H);
    if (rcm != 0) { _zag_println("outpaint labelmap write failed"); return 1; }

    // ---- trace ----
    let led:[]u8 = nio_alloc(1048576);
    if (led.len == 0) { _zag_println("alloc led failed"); return 1; }
    let lo:i64 = 0;
    lo = op_puts(led, lo, "HONEST UPSCALE OUTPAINT TRACE (image_upscale, phase 2)\n");
    lo = op_puts(led, lo, "I extend my 512x184 construction by 64px on the RIGHT (east).\n");
    lo = op_puts(led, lo, "WHY THE RIGHT: the right edge carries the river, the far bank, and\n");
    lo = op_puts(led, lo, "open sky — horizontally-continuous scene elements. The left edge is\n");
    lo = op_puts(led, lo, "the brick building wall, an occluder whose continuation is\n");
    lo = op_puts(led, lo, "unconstrained. Extending right continues the scene.\n");
    lo = op_puts(led, lo, "METHOD: the right border is covered by committed SHAPES regions.\n");
    lo = op_puts(led, lo, "SMOOTH was REVERTED on this observation, so there is no committed\n");
    lo = op_puts(led, lo, "planar model to extrapolate — recorded, not worked around.\n");
    lo = op_puts(led, lo, "Each strip pixel takes its row's border region's edge column:\n");
    lo = op_puts(led, lo, "value = region.mean + region.atom[rightmost column][iy]. The edge\n");
    lo = op_puts(led, lo, "texture continues horizontally; no atom structure is invented past\n");
    lo = op_puts(led, lo, "the edge column. Where the region's fit is perfect, the strip\n");
    lo = op_puts(led, lo, "continues the observed border seamlessly; where it is not, the\n");
    lo = op_puts(led, lo, "seam is visible and honest.\n");
    lo = op_puts(led, lo, "RECORDED DECISION: LINES segments are NOT extended. They describe\n");
    lo = op_puts(led, lo, "observed structures; continuing them would be invention without\n");
    lo = op_puts(led, lo, "basis.\n");
    lo = op_puts(led, lo, "Every strip pixel is labeled CONSTRUCTED-SHAPES-EXTRAP (5) — never\n");
    lo = op_puts(led, lo, "observed.\n");
    lo = op_puts(led, lo, "Border regions (");
    lo = op_puti(led, lo, nborder);
    lo = op_puts(led, lo, "):\n");
    let ti:i64 = 0;
    while (ti < nreg) {
        if (rx[ti] + rw[ti] == kw) {
            lo = op_puts(led, lo, "  REGION ");
            lo = op_puti(led, lo, ti);
            lo = op_puts(led, lo, " (");
            lo = op_puti(led, lo, rx[ti]);
            lo = op_puts(led, lo, ",");
            lo = op_puti(led, lo, ry[ti]);
            lo = op_puts(led, lo, ") ");
            lo = op_puti(led, lo, rw[ti]);
            lo = op_puts(led, lo, "x");
            lo = op_puti(led, lo, rh[ti]);
            lo = op_puts(led, lo, " mean=(");
            lo = op_puti(led, lo, rm[ti * 3]);
            lo = op_puts(led, lo, ",");
            lo = op_puti(led, lo, rm[ti * 3 + 1]);
            lo = op_puts(led, lo, ",");
            lo = op_puti(led, lo, rm[ti * 3 + 2]);
            lo = op_puts(led, lo, ") strip OY ");
            lo = op_puti(led, lo, 2 * ry[ti]);
            lo = op_puts(led, lo, "..");
            lo = op_puti(led, lo, 2 * (ry[ti] + rh[ti]) - 1);
            lo = op_puts(led, lo, "\n");
        }
        ti = ti + 1;
    }
    lo = op_puts(led, lo, "STRIP: 64x184 = ");
    lo = op_puti(led, lo, SW * H);
    lo = op_puts(led, lo, " px, ALL labeled CONSTRUCTED-SHAPES-EXTRAP (5).\n");
    lo = op_puts(led, lo, "Nothing in the strip is presented as observed.\n");
    let rcl:i64 = file_write(oroot, "OUTPAINT_TRACE.txt", led[0..lo]);
    nio_close(root);
    nio_close(oroot);
    if (rcl != 0) { _zag_println("trace write failed"); return 1; }
    _zag_println("outpaint done: 576x184");
    return 0;
}

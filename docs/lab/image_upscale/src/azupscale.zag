// azupscale.zag — HONEST UPSCALE experiment, phase 1 (the easy test).
// Micah order 2026-09-26 ~12:52 PDT.
//
// TNN observes ONLY input_256x92.bmp (the 2x box-downscaled crop).
// gt_512x184.bmp is loaded for MEASUREMENT ONLY — it is never fed to the
// construction (it is loaded after the construction completes).
//
// What TNN does:
//   1. DELIBERATES on the 256x92 input: survey -> affinities -> its own
//      layer order -> cascade with the per-value-9 commit bar (the same
//      deliberation as the adaptive-layers fork, on the observed input).
//   2. CONSTRUCTS the 512x184 upscale from its layer models at 2x:
//      - SMOOTH leaves: planar models re-sampled on the half-pixel grid
//        (v = m + (ax*du2+ay*dv2)/512 — bit-identical to the native render
//        at even positions, model-sampled at odd positions).
//      - SHAPES regions: atom exemplars drawn at 2x with 50/50 blend of
//        nearest-2x2 and bilinear interpolation of the deviation field
//        (deterministic integer arithmetic). Pure nearest preserves atom HF
//        (best dB) but draws visible 2x2 pixel-grid rectangles (Micah
//        2026-09-26: "weird rectangle sections"); pure bilinear kills the
//        grid but loses detail. The 50/50 blend halves the grid contrast
//        while keeping half the detail. Region boundaries are feathered
//        (4-pixel 2x cross-fade, labeled CONSTRUCTED-SMOOTH) so SHAPES/atom
//        vs NO-FIT/bicubic transitions don't read as rectangles.
//      - LINES segments: chords re-rasterized at doubled endpoints.
//      - Even positions (2x,2y) are the OBSERVED pixels: set to the input
//        exactly (the residual channel covers observed pixels).
//   3. LABELS every output pixel epistemically:
//        0 KNOWN               — observed pixel (even position), residual-covered
//        1 CONSTRUCTED-SMOOTH  — built from a SMOOTH planar model
//        2 CONSTRUCTED-LINES   — built from a LINES segment model
//        3 CONSTRUCTED-SHAPES  — built from a SHAPES atom exemplar
//        4 INVENTED            — no layer model covers it (counted honestly;
//                              ~0 expected: SMOOTH tiles the frame)
//        6 CONSTRUCTED-NO-FIT  — REJECT OPTION (Micah 2026-09-26 ~13:45):
//                              SHAPES said "no atom fits" here; honest
//                              bicubic interpolation, never presented as
//                              understood. (5 is CONSTRUCTED-SHAPES-EXTRAP,
//                              used by the outpaint phase only.)
//   4. BUILDS the generic-interpolator baseline: Catmull-Rom bicubic 2x in
//      exact integer arithmetic (t=0.5 weights [-1,9,9,-1]/16, separable,
//      edge-clamped), on the same input.
//   5. MEASURES both against the held 512x184 ground truth: integer-exact
//      SSE per channel (full frame), per 64x46 tile (8x4 grid), and per
//      epistemic label class (odd positions only). dB conversion is done
//      by metrics.py on the written BMPs (the committed instrument).
// Pure Zag, zero RNG, pinned toolchain. argv: 1=indir 2=outdir.
@import("./azlayers.zag")

fn tab_puts(b:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { b[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn tab_puti(b:[]u8, o:i64, v:i64) i64 {
    if (v < 0) { b[o] = 45; o = o + 1; v = 0 - v; }
    let t:[]u8 = _zag_i64_to_str(v);
    let i:i64 = 0;
    while (i < t.len) { b[o + i] = t[i]; i = i + 1; }
    return o + t.len;
}
fn layer_name(id:i64, b:[]u8, o:i64) i64 {
    if (id == 1) { return tab_puts(b, o, "SMOOTH (adaptive CART mean+planar)"); }
    if (id == 2) { return tab_puts(b, o, "LINES (straight segments)"); }
    return tab_puts(b, o, "SHAPES-ZOOM (adaptive partition + magnification)");
}
fn lab_name(lv:i64, b:[]u8, o:i64) i64 {
    if (lv == 0) { return tab_puts(b, o, "KNOWN (observed, residual-covered)"); }
    if (lv == 1) { return tab_puts(b, o, "CONSTRUCTED-SMOOTH (planar model)"); }
    if (lv == 2) { return tab_puts(b, o, "CONSTRUCTED-LINES (segment model)"); }
    if (lv == 3) { return tab_puts(b, o, "CONSTRUCTED-SHAPES (atom exemplar)"); }
    if (lv == 5) { return tab_puts(b, o, "CONSTRUCTED-SHAPES-EXTRAP (outpaint only)"); }
    if (lv == 6) { return tab_puts(b, o, "CONSTRUCTED-NO-FIT (no atom fits; honest interpolation)"); }
    return tab_puts(b, o, "INVENTED (no layer model)");
}

// ---- 2x construction renders (from TNN's layer models, not interpolation) ----

// SMOOTH 2x: re-sample each leaf's planar model on the half-pixel grid.
// Output pixel (OX,OY) in [2x0,2x0+2bw)x[2y0,2y0+2bh):
//   du2 = OX-2*x0-2*ox, dv2 = OY-2*y0-2*oy, v = m + (a*du2+b*dv2)/512.
// At even positions this equals tl_smooth_render bit-for-bit.
fn smooth_render2x(acc:[]i64, lab:[]u8, labval:i64, W:i64,
    lx:[]i64, ly:[]i64, lw:[]i64, lh:[]i64, lm:[]i64, lg:[]i64,
    nleaf:i64, nfx:[]i64, nfy:[]i64, nfw:[]i64, nfh:[]i64, nnofit:i64) void {
    let li:i64 = 0;
    while (li < nleaf) {
        let x0:i64 = lx[li]; let y0:i64 = ly[li];
        let bw:i64 = lw[li]; let bh:i64 = lh[li];
        let ox:i64 = (bw - 1) / 2;
        let oy:i64 = (bh - 1) / 2;
        let m0:i64 = lm[li * 3]; let m1:i64 = lm[li * 3 + 1]; let m2:i64 = lm[li * 3 + 2];
        let ax:i64 = lg[li * 6]; let ay:i64 = lg[li * 6 + 1];
        let bx:i64 = lg[li * 6 + 2]; let by:i64 = lg[li * 6 + 3];
        let cx:i64 = lg[li * 6 + 4]; let cy:i64 = lg[li * 6 + 5];
        let OY:i64 = 2 * y0;
        while (OY < 2 * y0 + 2 * bh) {
            let dv2:i64 = OY - 2 * y0 - 2 * oy;
            let OX:i64 = 2 * x0;
            while (OX < 2 * x0 + 2 * bw) {
                let du2:i64 = OX - 2 * x0 - 2 * ox;
                // respect prior layer claims: SHAPES/LINES render earlier in
                // deliberation order; SMOOTH only fills unclaimed pixels.
                // Also skip SHAPES-rejected blocks: SHAPES abstained there
                // ("no atom fits"); those get honest bicubic (NO-FIT), not
                // a planar paper-over.
                let in_nofit:i64 = 0;
                let qn:i64 = 0;
                while (qn < nnofit) {
                    if (OX >= 2 * nfx[qn] && OX < 2 * (nfx[qn] + nfw[qn]) &&
                        OY >= 2 * nfy[qn] && OY < 2 * (nfy[qn] + nfh[qn])) {
                        in_nofit = 1;
                    }
                    qn = qn + 1;
                }
                if ((lab[OY * W + OX] as i64) == 4 && in_nofit == 0) {
                    let p:i64 = (OY * W + OX) * 3;
                    acc[p] = acc[p] + m0 + (ax * du2 + ay * dv2) / 512;
                    acc[p + 1] = acc[p + 1] + m1 + (bx * du2 + by * dv2) / 512;
                    acc[p + 2] = acc[p + 2] + m2 + (cx * du2 + cy * dv2) / 512;
                    lab[OY * W + OX] = labval as u8;
                }
                OX = OX + 1;
            }
            OY = OY + 1;
        }
        li = li + 1;
    }
}

// BOUNDARY FEATHERING: cross-fade a 4-pixel 2x band across region boundaries
// so SHAPES/atom texture vs NO-FIT/bicubic (or atom-vs-atom) transitions don't
// read as visible rectangles. Feathered pixels get CONSTRUCTED-SMOOTH (1).
// rx..rat: SHAPES regions (native coords, rat=atom idx); fx..fh: NO-FIT
// regions (native coords). All regions incl. nofit are feathered against
// each other; SHAPES-SHAPES pairs with the same atom are skipped (continuous).
fn tl_feather_bounds(acc:[]i64, lab:[]u8, W:i64, H:i64,
    rx:[]i64, ry:[]i64, rw:[]i64, rh:[]i64, rat:[]i64, nreg:i64,
    fx:[]i64, fy:[]i64, fw:[]i64, fh:[]i64, nnofit:i64) void {
    // build a unified list: kind 0=SHAPES (with atom), 1=NOFIT
    // (cap 4096+4096; static arrays on stack via nio_alloc in caller? --
    //  simpler: two-phase loops over the two lists with a kind flag)
    let i:i64 = 0;
    while (i < nreg + nnofit) {
        let ix0:i64 = 0; let iy0:i64 = 0; let iw:i64 = 0; let ih:i64 = 0;
        let iat:i64 = -1; let ikind:i64 = 0;
        if (i < nreg) {
            ix0 = rx[i]; iy0 = ry[i]; iw = rw[i]; ih = rh[i];
            iat = rat[i]; ikind = 0;
        } else {
            let j:i64 = i - nreg;
            ix0 = fx[j]; iy0 = fy[j]; iw = fw[j]; ih = fh[j];
            iat = -1; ikind = 1;
        }
        let k:i64 = i + 1;
        while (k < nreg + nnofit) {
            let kx0:i64 = 0; let ky0:i64 = 0; let kw:i64 = 0; let kh:i64 = 0;
            let kat:i64 = -1; let kkind:i64 = 0;
            if (k < nreg) {
                kx0 = rx[k]; ky0 = ry[k]; kw = rw[k]; kh = rh[k];
                kat = rat[k]; kkind = 0;
            } else {
                let j2:i64 = k - nreg;
                kx0 = fx[j2]; ky0 = fy[j2]; kw = fw[j2]; kh = fh[j2];
                kat = -1; kkind = 1;
            }
            // skip SHAPES-SHAPES with same atom (continuous, no seam)
            let skip:i64 = 0;
            if (ikind == 0 && kkind == 0 && iat == kat) { skip = 1; }
            if (skip == 0) {
                // vertical adjacency: i right edge == k left edge
                if (ix0 + iw == kx0) {
                    let y0:i64 = iy0; if (ky0 > y0) { y0 = ky0; }
                    let y1:i64 = iy0 + ih; if (ky0 + kh < y1) { y1 = ky0 + kh; }
                    if (y1 > y0) {
                        tl_feather_v(acc, lab, W, H, 2 * kx0, 2 * y0, 2 * y1);
                    }
                }
                if (kx0 + kw == ix0) {
                    let y0b:i64 = iy0; if (ky0 > y0b) { y0b = ky0; }
                    let y1b:i64 = iy0 + ih; if (ky0 + kh < y1b) { y1b = ky0 + kh; }
                    if (y1b > y0b) {
                        tl_feather_v(acc, lab, W, H, 2 * ix0, 2 * y0b, 2 * y1b);
                    }
                }
                // horizontal adjacency: i bottom edge == k top edge
                if (iy0 + ih == ky0) {
                    let x0:i64 = ix0; if (kx0 > x0) { x0 = kx0; }
                    let x1:i64 = ix0 + iw; if (kx0 + kw < x1) { x1 = kx0 + kw; }
                    if (x1 > x0) {
                        tl_feather_h(acc, lab, W, H, 2 * ky0, 2 * x0, 2 * x1);
                    }
                }
                if (ky0 + kh == iy0) {
                    let x0b:i64 = ix0; if (kx0 > x0b) { x0b = kx0; }
                    let x1b:i64 = ix0 + iw; if (kx0 + kw < x1b) { x1b = kx0 + kw; }
                    if (x1b > x0b) {
                        tl_feather_h(acc, lab, W, H, 2 * iy0, 2 * x0b, 2 * x1b);
                    }
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return;
}

// vertical feather at 2x x=xb, rows [y0,y1): 4-pixel cross-fade.
// samples pure values from x=xb-3 (left) and x=xb+2 (right).
fn tl_feather_v(acc:[]i64, lab:[]u8, W:i64, H:i64, xb:i64, y0:i64, y1:i64) void {
    if (xb < 3 || xb + 2 >= W) { return; }
    if (y0 < 0) { y0 = 0; }
    if (y1 > H) { y1 = H; }
    let y:i64 = y0;
    while (y < y1) {
        let pl:i64 = (y * W + (xb - 3)) * 3;
        let pr:i64 = (y * W + (xb + 2)) * 3;
        let l0:i64 = acc[pl]; let l1:i64 = acc[pl + 1]; let l2:i64 = acc[pl + 2];
        let r0:i64 = acc[pr]; let r1:i64 = acc[pr + 1]; let r2:i64 = acc[pr + 2];
        // xb-2: 3/4 left, 1/4 right (skip if KNOWN)
        if ((lab[y * W + (xb - 2)] as i64) != 0) {
            let p0:i64 = (y * W + (xb - 2)) * 3;
            acc[p0] = (3 * l0 + r0) / 4; acc[p0 + 1] = (3 * l1 + r1) / 4; acc[p0 + 2] = (3 * l2 + r2) / 4;
            lab[y * W + (xb - 2)] = 1;
        }
        // xb-1: 1/2, 1/2
        if ((lab[y * W + (xb - 1)] as i64) != 0) {
            let p1:i64 = (y * W + (xb - 1)) * 3;
            acc[p1] = (l0 + r0) / 2; acc[p1 + 1] = (l1 + r1) / 2; acc[p1 + 2] = (l2 + r2) / 2;
            lab[y * W + (xb - 1)] = 1;
        }
        // xb: 1/2, 1/2
        if ((lab[y * W + xb] as i64) != 0) {
            let p2:i64 = (y * W + xb) * 3;
            acc[p2] = (l0 + r0) / 2; acc[p2 + 1] = (l1 + r1) / 2; acc[p2 + 2] = (l2 + r2) / 2;
            lab[y * W + xb] = 1;
        }
        // xb+1: 1/4 left, 3/4 right
        if ((lab[y * W + (xb + 1)] as i64) != 0) {
            let p3:i64 = (y * W + (xb + 1)) * 3;
            acc[p3] = (l0 + 3 * r0) / 4; acc[p3 + 1] = (l1 + 3 * r1) / 4; acc[p3 + 2] = (l2 + 3 * r2) / 4;
            lab[y * W + (xb + 1)] = 1;
        }
        y = y + 1;
    }
    return;
}

// horizontal feather// horizontal feather at 2x y=yb, cols [x0,x1): 4-pixel cross-fade.
fn tl_feather_h(acc:[]i64, lab:[]u8, W:i64, H:i64, yb:i64, x0:i64, x1:i64) void {
    if (yb < 3 || yb + 2 >= H) { return; }
    if (x0 < 0) { x0 = 0; }
    if (x1 > W) { x1 = W; }
    let x:i64 = x0;
    while (x < x1) {
        let pt:i64 = ((yb - 3) * W + x) * 3;
        let pb:i64 = ((yb + 2) * W + x) * 3;
        let t0:i64 = acc[pt]; let t1:i64 = acc[pt + 1]; let t2:i64 = acc[pt + 2];
        let b0:i64 = acc[pb]; let b1:i64 = acc[pb + 1]; let b2:i64 = acc[pb + 2];
        if ((lab[(yb - 2) * W + x] as i64) != 0) {
            let q0:i64 = ((yb - 2) * W + x) * 3;
            acc[q0] = (3 * t0 + b0) / 4; acc[q0 + 1] = (3 * t1 + b1) / 4; acc[q0 + 2] = (3 * t2 + b2) / 4;
            lab[(yb - 2) * W + x] = 1;
        }
        if ((lab[(yb - 1) * W + x] as i64) != 0) {
            let q1:i64 = ((yb - 1) * W + x) * 3;
            acc[q1] = (t0 + b0) / 2; acc[q1 + 1] = (t1 + b1) / 2; acc[q1 + 2] = (t2 + b2) / 2;
            lab[(yb - 1) * W + x] = 1;
        }
        if ((lab[yb * W + x] as i64) != 0) {
            let q2:i64 = (yb * W + x) * 3;
            acc[q2] = (t0 + b0) / 2; acc[q2 + 1] = (t1 + b1) / 2; acc[q2 + 2] = (t2 + b2) / 2;
            lab[yb * W + x] = 1;
        }
        if ((lab[(yb + 1) * W + x] as i64) != 0) {
            let q3:i64 = ((yb + 1) * W + x) * 3;
            acc[q3] = (t0 + 3 * b0) / 4; acc[q3 + 1] = (t1 + 3 * b1) / 4; acc[q3 + 2] = (t2 + 3 * b2) / 4;
            lab[(yb + 1) * W + x] = 1;
        }
        x = x + 1;
    }
    return;
}

// SHAPES 2x: atom exemplars// SHAPES 2x: atom exemplars drawn at 2x with BILINEAR interpolation of the
// exemplar's deviation field (not nearest 2x2 blocks). The nearest-2x2
// rendering preserved the exemplar "exactly" but produced visible chunky
// pixel-grid rectangles (Micah 2026-09-26: "weird rectangle sections").
// Bilinear is the honest 2x sampling of the atom model: the exemplar's
// structure is preserved, the Minecraft blockiness is gone. Deterministic
// integer arithmetic with round-half-away-from-zero. Label stays
// CONSTRUCTED-SHAPES: still constructed from the atom model.
fn shapes_render2x(acc:[]i64, lab:[]u8, labval:i64, W:i64,
    a0:[]u8, a1:[]u8, a2:[]u8, a3:[]u8, a4:[]u8,
    rx:[]i64, ry:[]i64, rw:[]i64, rh:[]i64, rs:[]i64, rat:[]i64, rm:[]i64,
    nreg:i64, w:i64) void {
    let ri:i64 = 0;
    while (ri < nreg) {
        let x0:i64 = rx[ri]; let y0:i64 = ry[ri];
        let s:i64 = rs[ri]; let at:i64 = rat[ri];
        let atoms:[]u8 = a0;
        if (s == 32) { atoms = a1; }
        if (s == 16) { atoms = a2; }
        if (s == 8) { atoms = a3; }
        if (s == 4) { atoms = a4; }
        let mb:i64 = s * s * 3 * 2;
        let abase:i64 = at * mb;
        let bw:i64 = rw[ri]; let bh:i64 = rh[ri];
        if (bw > s) { bw = s; }
        if (bh > s) { bh = s; }
        if (x0 + bw > w) { bw = w - x0; }
        let m0:i64 = rm[ri * 3]; let m1:i64 = rm[ri * 3 + 1]; let m2:i64 = rm[ri * 3 + 2];
        let iy:i64 = 0;
        while (iy < bh) {
            let ix:i64 = 0;
            while (ix < bw) {
                // BLEND nearest+bilinear 50/50: keeps half the atom's HF
                // detail (dB) while halving the 2x2 grid contrast (visual).
                // Deterministic integer arithmetic.
                let aq:i64 = abase + (iy * s + ix) * 6;
                let d0:i64 = r_i16le(atoms, aq);
                let d1:i64 = r_i16le(atoms, aq + 2);
                let d2:i64 = r_i16le(atoms, aq + 4);
                let jx:i64 = ix + 1; if (jx >= bw) { jx = ix; }
                let jy:i64 = iy + 1; if (jy >= bh) { jy = iy; }
                let dr0:i64 = sh_dev(atoms, abase, s, jx, iy, bw, bh, 0);
                let dr1:i64 = sh_dev(atoms, abase, s, jx, iy, bw, bh, 1);
                let dr2:i64 = sh_dev(atoms, abase, s, jx, iy, bw, bh, 2);
                let dd0:i64 = sh_dev(atoms, abase, s, ix, jy, bw, bh, 0);
                let dd1:i64 = sh_dev(atoms, abase, s, ix, jy, bw, bh, 1);
                let dd2:i64 = sh_dev(atoms, abase, s, ix, jy, bw, bh, 2);
                let drd0:i64 = sh_dev(atoms, abase, s, jx, jy, bw, bh, 0);
                let drd1:i64 = sh_dev(atoms, abase, s, jx, jy, bw, bh, 1);
                let drd2:i64 = sh_dev(atoms, abase, s, jx, jy, bw, bh, 2);
                let dy:i64 = 0;
                while (dy < 2) {
                    let dx:i64 = 0;
                    while (dx < 2) {
                        // bilinear component
                        let b0:i64 = d0; let b1:i64 = d1; let b2:i64 = d2;
                        if (dx == 1 && dy == 0) {
                            b0 = sh_bilinear2(d0, dr0); b1 = sh_bilinear2(d1, dr1); b2 = sh_bilinear2(d2, dr2);
                        }
                        if (dx == 0 && dy == 1) {
                            b0 = sh_bilinear2(d0, dd0); b1 = sh_bilinear2(d1, dd1); b2 = sh_bilinear2(d2, dd2);
                        }
                        if (dx == 1 && dy == 1) {
                            b0 = sh_bilinear4(d0, dr0, dd0, drd0);
                            b1 = sh_bilinear4(d1, dr1, dd1, drd1);
                            b2 = sh_bilinear4(d2, dr2, dd2, drd2);
                        }
                        // 50/50 blend: (nearest + bilinear)/2
                        let e0:i64 = sh_bilinear2(d0, b0);
                        let e1:i64 = sh_bilinear2(d1, b1);
                        let e2:i64 = sh_bilinear2(d2, b2);
                        let OX:i64 = 2 * x0 + 2 * ix + dx;
                        let OY:i64 = 2 * y0 + 2 * iy + dy;
                        let p:i64 = (OY * W + OX) * 3;
                        acc[p] = acc[p] + m0 + e0;
                        acc[p + 1] = acc[p + 1] + m1 + e1;
                        acc[p + 2] = acc[p + 2] + m2 + e2;
                        lab[OY * W + OX] = labval as u8;
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }
                ix = ix + 1;
            }
            iy = iy + 1;
        }
        ri = ri + 1;
    }
}

// (a+b)/2, round-half-away-from-zero (deterministic, unbiased)
fn sh_bilinear2(a:i64, b:i64) i64 {
    let s:i64 = a + b;
    if (s >= 0) { return (s + 1) / 2; }
    return (s - 1) / 2;
}

// (a+b+c+d)/4, round-half-away-from-zero
fn sh_bilinear4(a:i64, b:i64, c:i64, d:i64) i64 {
    let s:i64 = a + b + c + d;
    if (s >= 0) { return (s + 2) / 4; }
    return (s - 2) / 4;
}

// deviation at clamped (jx,jy), channel ch (0,1,2)
fn sh_dev(atoms:[]u8, abase:i64, s:i64, jx:i64, jy:i64, bw:i64, bh:i64, ch:i64) i64 {
    let cx:i64 = jx; if (cx < 0) { cx = 0; } if (cx >= bw) { cx = bw - 1; }
    let cy:i64 = jy; if (cy < 0) { cy = 0; } if (cy >= bh) { cy = bh - 1; }
    let aq:i64 = abase + (cy * s + cx) * 6 + ch * 2;
    return r_i16le(atoms, aq);
}

// Catmull-Rom 1D midpoint: (-p0 + 9*p1 + 9*p2 - p3)/16, round-half-away
fn sh_cubic1(p0:i64, p1:i64, p2:i64, p3:i64) i64 {
    let num:i64 = -p0 + 9 * p1 + 9 * p2 - p3;
    if (num >= 0) { return (num + 8) / 16; }
    return (num - 8) / 16;
}

// LINES 2x: chords re-rasterized at doubled endpoints (same Bresenham
// arithmetic as tl_chord_paint), plus epistemic label writes.
fn lines_render2x_lab(acc:[]i64, lab:[]u8, labval:i64, W:i64, H:i64,
    sx0:[]i64, sy0:[]i64, sx1:[]i64, sy1:[]i64, sm:[]i64, nseg:i64) void {
    let npix:i64 = W * H;
    let painted:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    if (painted.len == 0) { return; }
    let qi:i64 = 0;
    while (qi < npix) { painted[qi] = 0; qi = qi + 1; }
    let cx:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let cy:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    if (cx.len == 0) { nio_free(painted); return; }
    let i:i64 = 0;
    while (i < nseg) {
        let n:i64 = tl_bres_list(2 * sx0[i], 2 * sy0[i], 2 * sx1[i], 2 * sy1[i], cx, cy, 4096);
        let m0:i64 = sm[i * 3]; let m1:i64 = sm[i * 3 + 1]; let m2:i64 = sm[i * 3 + 2];
        let k:i64 = 0;
        while (k < n) {
            let xx:i64 = cx[k]; let yy:i64 = cy[k];
            if (xx >= 0) {
                if (xx < W) {
                    if (yy >= 0) {
                        if (yy < H) {
                            let p:i64 = yy * W + xx;
                            // respect SHAPES' prior claim (deliberation order)
                            if (painted[p] == 0 && (lab[p] as i64) == 4) {
                                painted[p] = 1;
                                let q:i64 = p * 3;
                                acc[q] = acc[q] + m0;
                                acc[q + 1] = acc[q + 1] + m1;
                                acc[q + 2] = acc[q + 2] + m2;
                                lab[p] = labval as u8;
                            }
                        }
                    }
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    nio_free(cx); nio_free(cy); nio_free(painted);
}

// ---- generic-interpolator baseline: Catmull-Rom bicubic 2x ----
// Exact integer arithmetic: 1-D t=0.5 weights [-1,9,9,-1]/16, separable.
// Even positions reproduce the input exactly. All four taps are
// index-clamped (replicate edge) BEFORE reading.
fn bicubic2x(inp:[]u8, w:i64, h:i64, out:[]u8, W:i64, H:i64) void {
    let OY:i64 = 0;
    while (OY < H) {
        let y:i64 = OY / 2;
        let oy:i64 = OY - 2 * y;
        let OX:i64 = 0;
        while (OX < W) {
            let x:i64 = OX / 2;
            let ox:i64 = OX - 2 * x;
            let c:i64 = 0;
            while (c < 3) {
                let v:i64 = 0;
                if (ox == 0) {
                    if (oy == 0) {
                        v = inp[(y * w + x) * 3 + c] as i64;
                    } else {
                        // vertical only; taps clamped before reading
                        let y0:i64 = y - 1;
                        if (y0 < 0) { y0 = 0; }
                        let y3:i64 = y + 2;
                        if (y3 >= h) { y3 = h - 1; }
                        let y2:i64 = y + 1;
                        if (y2 >= h) { y2 = h - 1; }
                        let p0:i64 = inp[(y0 * w + x) * 3 + c] as i64;
                        let p1:i64 = inp[(y * w + x) * 3 + c] as i64;
                        let p2:i64 = inp[(y2 * w + x) * 3 + c] as i64;
                        let p3:i64 = inp[(y3 * w + x) * 3 + c] as i64;
                        let s:i64 = 0 - p0 + 9 * p1 + 9 * p2 - p3;
                        if (s >= 0) { v = (s + 8) / 16; } else { v = (s - 8) / 16; }
                    }
                } else {
                    if (oy == 0) {
                        // horizontal only; taps clamped before reading
                        let x0:i64 = x - 1;
                        if (x0 < 0) { x0 = 0; }
                        let x3:i64 = x + 2;
                        if (x3 >= w) { x3 = w - 1; }
                        let x2:i64 = x + 1;
                        if (x2 >= w) { x2 = w - 1; }
                        let p0:i64 = inp[(y * w + x0) * 3 + c] as i64;
                        let p1:i64 = inp[(y * w + x) * 3 + c] as i64;
                        let p2:i64 = inp[(y * w + x2) * 3 + c] as i64;
                        let p3:i64 = inp[(y * w + x3) * 3 + c] as i64;
                        let s:i64 = 0 - p0 + 9 * p1 + 9 * p2 - p3;
                        if (s >= 0) { v = (s + 8) / 16; } else { v = (s - 8) / 16; }
                    } else {
                        // full 4x4, one integer step (/256)
                        let s:i64 = 0;
                        let jy:i64 = -1;
                        while (jy < 3) {
                            let yy2:i64 = y + jy;
                            if (yy2 < 0) { yy2 = 0; }
                            if (yy2 >= h) { yy2 = h - 1; }
                            let wy:i64 = 9;
                            if (jy == -1) { wy = -1; }
                            if (jy == 2) { wy = -1; }
                            let ix:i64 = -1;
                            while (ix < 3) {
                                let xx2:i64 = x + ix;
                                if (xx2 < 0) { xx2 = 0; }
                                if (xx2 >= w) { xx2 = w - 1; }
                                let wx:i64 = 9;
                                if (ix == -1) { wx = -1; }
                                if (ix == 2) { wx = -1; }
                                s = s + wx * wy * (inp[(yy2 * w + xx2) * 3 + c] as i64);
                                ix = ix + 1;
                            }
                            jy = jy + 1;
                        }
                        if (s >= 0) { v = (s + 128) / 256; } else { v = (s - 128) / 256; }
                    }
                }
                out[(OY * W + OX) * 3 + c] = clamp8(v) as u8;
                c = c + 1;
            }
            OX = OX + 1;
        }
        OY = OY + 1;
    }
}

fn main() i32 {
    let ind:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    if (_zag_strcmp(ind, "") == 1) { ind = "."; }
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let root:i64 = nio_open_root(ind);
    if (root < 0) { _zag_println("cannot open indir"); return 1; }
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { _zag_println("cannot open outdir"); nio_close(root); return 1; }

    // ---- load the observed input (256x92). THIS IS ALL TNN SEES. ----
    let fd:i64 = nio_open_child(root, "input_256x92.bmp", 0);
    if (fd < 0) { _zag_println("cannot open input"); nio_close(root); return 1; }
    let fbuf:[]u8 = nio_alloc(400000);
    if (fbuf.len == 0) { _zag_println("alloc failed"); nio_close(fd); nio_close(root); return 1; }
    let n:i64 = nio_read_exact(fd, fbuf, 399999);
    nio_close(fd);
    if (n < 54) { _zag_println("short file"); return 1; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    if (w != 256) { _zag_println("need w=256"); return 1; }
    if (h != 92) { _zag_println("need h=92"); return 1; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let npix:i64 = w * h;
    let orig:[]u8 = nio_alloc((npix * 3) as i32);
    if (orig.len == 0) { _zag_println("alloc orig failed"); return 1; }
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            orig[p] = fbuf[q + 2];
            orig[p + 1] = fbuf[q + 1];
            orig[p + 2] = fbuf[q];
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fbuf);
    let px:[]i64 = nio_alloc((npix * 3 * 8) as i32) as []i64;
    if (px.len == 0) { _zag_println("alloc px failed"); return 1; }
    let pi:i64 = 0;
    while (pi < npix * 3) { px[pi] = orig[pi] as i64; pi = pi + 1; }
    _zag_print("observed ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("x");
    _zag_println(_zag_i64_to_str(h));

    let led:[]u8 = nio_alloc(4194304);
    if (led.len == 0) { _zag_println("alloc ledger failed"); return 1; }
    let lo:i64 = 0;
    lo = tab_puts(led, lo, "HONEST UPSCALE DELIBERATION TRACE (image_upscale, phase 1)\n");
    lo = tab_puts(led, lo, "I observe ONLY the 256x92 box-downscaled crop. The sealed 512x184\n");
    lo = tab_puts(led, lo, "ground truth is held for measurement; it never enters my construction.\n");
    lo = tab_puts(led, lo, "My upscale is built from my layer models at 2x sampling, not by\n");
    lo = tab_puts(led, lo, "interpolating pixels. Every new pixel carries an epistemic label:\n");
    lo = tab_puts(led, lo, "KNOWN (observed), CONSTRUCTED-<layer> (built from a layer model),\n");
    lo = tab_puts(led, lo, "or INVENTED (no layer model covers it).\n");

    // ---- SURVEY (same deliberation as the adaptive-layers fork) ----
    let sv:[]i64 = nio_alloc(48) as []i64;
    tl_survey_flat(px, w, h, sv);
    let lum:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    tl_luminance(px, npix, lum);
    let hist:[]i64 = nio_alloc(512) as []i64;
    let edgepx:[]i64 = nio_alloc(8) as []i64;
    let dum:[]i64 = nio_alloc(8) as []i64;
    tl_walks(lum, w, h, 27, 1, 0, dum, dum, dum, dum, dum, 0, hist, edgepx);
    let straight:i64 = 0;
    let curvy:i64 = 0;
    let hli:i64 = 2;
    while (hli < 16) { curvy = curvy + hli * hist[hli]; hli = hli + 1; }
    hli = 16;
    while (hli < 64) { straight = straight + hli * hist[hli]; hli = hli + 1; }
    lo = tab_puts(led, lo, "SURVEY on the 256x92 observation: E_total_vs_global_mean=");
    lo = tab_puti(led, lo, sv[5]);
    lo = tab_puts(led, lo, "; edge px (|sobel|>=27)=");
    lo = tab_puti(led, lo, edgepx[0]);
    lo = tab_puts(led, lo, "; straight-run px=");
    lo = tab_puti(led, lo, straight);
    lo = tab_puts(led, lo, "; curvy-run px=");
    lo = tab_puti(led, lo, curvy);
    lo = tab_puts(led, lo, "\n");
    _zag_println("survey done");

    // ---- AFFINITIES -> ORDER (TNN's choice on the observed input) ----
    let aff_s:i64 = (1000 * (sv[5] - sv[0])) / sv[5];
    let aff_l:i64 = (1000 * straight) / npix;
    let aff_h:i64 = (1000 * (sv[0] - sv[4])) / sv[5];
    lo = tab_puts(led, lo, "AFFINITIES (per-mille, measured): SMOOTH=");
    lo = tab_puti(led, lo, aff_s);
    lo = tab_puts(led, lo, " LINES=");
    lo = tab_puti(led, lo, aff_l);
    lo = tab_puts(led, lo, " SHAPES=");
    lo = tab_puti(led, lo, aff_h);
    lo = tab_puts(led, lo, "\n");
    let order:[]i64 = nio_alloc(24) as []i64;
    let oa:[]i64 = nio_alloc(24) as []i64;
    order[0] = 1; oa[0] = aff_s;
    order[1] = 2; oa[1] = aff_l;
    order[2] = 3; oa[2] = aff_h;
    let p1:i64 = 0;
    while (p1 < 2) {
        let p2:i64 = p1 + 1;
        while (p2 < 3) {
            let swap:i64 = 0;
            if (oa[p2] > oa[p1]) { swap = 1; }
            if (oa[p2] == oa[p1]) {
                if (order[p2] < order[p1]) { swap = 1; }
            }
            if (swap == 1) {
                let to:i64 = order[p1]; order[p1] = order[p2]; order[p2] = to;
                let ta:i64 = oa[p1]; oa[p1] = oa[p2]; oa[p2] = ta;
            }
            p2 = p2 + 1;
        }
        p1 = p1 + 1;
    }
    lo = tab_puts(led, lo, "MY ORDER (descending affinity, ties->SMOOTH,LINES,SHAPES): ");
    let oi:i64 = 0;
    while (oi < 3) {
        lo = layer_name(order[oi], led, lo);
        lo = tab_puts(led, lo, " (");
        lo = tab_puti(led, lo, oa[oi]);
        lo = tab_puts(led, lo, ")");
        if (oi < 2) { lo = tab_puts(led, lo, " -> "); }
        oi = oi + 1;
    }
    lo = tab_puts(led, lo, "\n");
    lo = tab_puts(led, lo, "COMMIT BAR: a layer must explain >= 9 per value it covers (G >= 9*N).\n");
    _zag_print("order: ");
    _zag_print(_zag_i64_to_str(order[0]));
    _zag_print(" ");
    _zag_print(_zag_i64_to_str(order[1]));
    _zag_print(" ");
    _zag_println(_zag_i64_to_str(order[2]));

    // ---- CASCADE on the 256x92 observation ----
    let tmp:[]i64 = nio_alloc((npix * 3 * 8) as i32) as []i64;
    if (tmp.len == 0) { _zag_println("alloc tmp failed"); return 1; }
    let committed:[]i64 = nio_alloc(24) as []i64;
    let slx:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let sly:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let slw:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let slh:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let slm:[]i64 = nio_alloc((4096 * 3 * 8) as i32) as []i64;
    let slg:[]i64 = nio_alloc((4096 * 6 * 8) as i32) as []i64;
    let snleaf:[]i64 = nio_alloc(8) as []i64;
    let sgx0:[]i64 = nio_alloc((2048 * 8) as i32) as []i64;
    let sgy0:[]i64 = nio_alloc((2048 * 8) as i32) as []i64;
    let sgx1:[]i64 = nio_alloc((2048 * 8) as i32) as []i64;
    let sgy1:[]i64 = nio_alloc((2048 * 8) as i32) as []i64;
    let sgm:[]i64 = nio_alloc((2048 * 3 * 8) as i32) as []i64;
    let sgnseg:[]i64 = nio_alloc(8) as []i64;
    let sgnwalks:[]i64 = nio_alloc(8) as []i64;
    let sgndropped:[]i64 = nio_alloc(8) as []i64;
    let ha0:[]u8 = nio_alloc(1); let ha1:[]u8 = nio_alloc(1);
    let ha2:[]u8 = nio_alloc(1); let ha3:[]u8 = nio_alloc(1);
    let ha4:[]u8 = nio_alloc(1);
    let hex0:[]i64 = nio_alloc(8) as []i64; let hex1:[]i64 = nio_alloc(8) as []i64;
    let hex2:[]i64 = nio_alloc(8) as []i64; let hex3:[]i64 = nio_alloc(8) as []i64;
    let hex4:[]i64 = nio_alloc(8) as []i64;
    let hna:[]i64 = nio_alloc(40) as []i64;
    let hrx:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let hry:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let hrw:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let hrh:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let hrs:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let hrat:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let hrm:[]i64 = nio_alloc((4096 * 3 * 8) as i32) as []i64;
    let hrnreg:[]i64 = nio_alloc(8) as []i64;
    let hntake:[]i64 = nio_alloc(40) as []i64;
    let hnsplit:[]i64 = nio_alloc(40) as []i64;
    // REJECT OPTION (Micah 2026-09-26 ~13:45): blocks SHAPES abstains on
    // ("no atom fits") — x,y,w,h in observation coordinates.
    let hnfx:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let hnfy:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let hnfw:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let hnfh:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let hnnofit:[]i64 = nio_alloc(8) as []i64;
    let hnrej:[]i64 = nio_alloc(40) as []i64;
    let hsilo:[]i64 = nio_alloc(8) as []i64;
    let hsihi:[]i64 = nio_alloc(8) as []i64;
    let hrep:[]i64 = nio_alloc(8) as []i64;
    let hgainfirst:[]i64 = nio_alloc(40) as []i64;
    let hgainlast:[]i64 = nio_alloc(40) as []i64;
    if (slx.len == 0) { _zag_println("alloc records failed"); return 1; }
    let t3:i64 = 0;
    while (t3 < 3) {
        let id:i64 = order[t3];
        committed[t3] = 0;
        let zi:i64 = 0;
        while (zi < npix * 3) { tmp[zi] = 0; zi = zi + 1; }
        let G:[]i64 = nio_alloc(8) as []i64;
        let N:[]i64 = nio_alloc(8) as []i64;
        lo = tab_puts(led, lo, "TRY ");
        lo = layer_name(id, led, lo);
        lo = tab_puts(led, lo, " on the current residual.\n");
        if (id == 1) {
            let nsplit_sm:[]i64 = nio_alloc(8) as []i64;
            nsplit_sm[0] = 0;
            lo = tl_smooth_build_ad(px, w, h, tmp, slx, sly, slw, slh, slm, slg,
                snleaf, 4096, G, N, nsplit_sm, led, lo);
            lo = tab_puts(led, lo, "  leaves=");
            lo = tab_puti(led, lo, snleaf[0]);
            lo = tab_puts(led, lo, " cart_splits=");
            lo = tab_puti(led, lo, nsplit_sm[0]);
            lo = tab_puts(led, lo, "\n");
            nio_free(nsplit_sm);
        }
        if (id == 2) {
            let lum2:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
            tl_luminance(px, npix, lum2);
            let nw:i64 = tl_lines_build(px, lum2, w, h, tmp,
                sgx0, sgy0, sgx1, sgy1, sgm, sgnseg, 2048,
                G, N, sgndropped);
            sgnwalks[0] = nw;
            nio_free(lum2);
            lo = tab_puts(led, lo, "  walks=");
            lo = tab_puti(led, lo, nw);
            lo = tab_puts(led, lo, " kept_segments=");
            lo = tab_puti(led, lo, sgnseg[0]);
            lo = tab_puts(led, lo, " dropped=");
            lo = tab_puti(led, lo, sgndropped[0]);
            lo = tab_puts(led, lo, "\n");
        }
        if (id == 3) {
            let si9:i64 = 0;
            while (si9 < 5) {
                let s9:i64 = s_of(si9);
                let nc9:i64 = (w + s9 - 1) / s9;
                let nr9:i64 = (h + s9 - 1) / s9;
                let nb9:i64 = nc9 * nr9;
                let mbytes:i64 = s9 * s9 * 3 * 2;
                let ab:[]u8 = nio_alloc((nb9 * mbytes) as i32);
                let eb:[]i64 = nio_alloc((nb9 * 8) as i32) as []i64;
                if (si9 == 0) { ha0 = ab; hex0 = eb; }
                if (si9 == 1) { ha1 = ab; hex1 = eb; }
                if (si9 == 2) { ha2 = ab; hex2 = eb; }
                if (si9 == 3) { ha3 = ab; hex3 = eb; }
                if (si9 == 4) { ha4 = ab; hex4 = eb; }
                hna[si9] = 0;
                si9 = si9 + 1;
            }
            lo = tl_shapeszoom_build(px, w, h, tmp,
                ha0, ha1, ha2, ha3, ha4,
                hex0, hex1, hex2, hex3, hex4, hna,
                hrx, hry, hrw, hrh, hrs, hrat, hrm, hrnreg, hntake, hnsplit, 4096,
                hnfx, hnfy, hnfw, hnfh, hnnofit, 4096, hnrej,
                G, N, hrep, hsilo, hsihi, hgainfirst, hgainlast,
                led, lo);
            lo = tab_puts(led, lo, "  regions=");
            lo = tab_puti(led, lo, hrnreg[0]);
            lo = tab_puts(led, lo, " rejected=");
            lo = tab_puti(led, lo, hnnofit[0]);
            lo = tab_puts(led, lo, " (no atom fits)\n");
        }
        lo = tab_puts(led, lo, "  measured: G=");
        lo = tab_puti(led, lo, G[0]);
        lo = tab_puts(led, lo, " N=");
        lo = tab_puti(led, lo, N[0]);
        lo = tab_puts(led, lo, "; bar needs G >= 9*N = ");
        lo = tab_puti(led, lo, 9 * N[0]);
        lo = tab_puts(led, lo, "\n");
        _zag_print("layer ");
        _zag_print(_zag_i64_to_str(id));
        _zag_print(" G=");
        _zag_print(_zag_i64_to_str(G[0]));
        _zag_print(" N=");
        _zag_println(_zag_i64_to_str(N[0]));
        let commit:i64 = 0;
        if (N[0] > 0) {
            if (G[0] >= 9 * N[0]) { commit = 1; }
        }
        if (commit == 1) {
            committed[t3] = 1;
            let ci2:i64 = 0;
            while (ci2 < npix * 3) { px[ci2] = px[ci2] - tmp[ci2]; ci2 = ci2 + 1; }
            lo = tab_puts(led, lo, "  DECISION: COMMIT. ");
            lo = layer_name(id, led, lo);
            lo = tab_puts(led, lo, " explains ");
            lo = tab_puti(led, lo, G[0] / N[0]);
            lo = tab_puts(led, lo, " per value (>= 9).\n");
            _zag_print("  COMMIT ");
            _zag_println(_zag_i64_to_str(id));
        } else {
            lo = tab_puts(led, lo, "  DECISION: REVERT. ");
            lo = layer_name(id, led, lo);
            lo = tab_puts(led, lo, " fails the bar; residual covers this content.\n");
            _zag_print("  REVERT ");
            _zag_println(_zag_i64_to_str(id));
        }
        nio_free(G);
        nio_free(N);
        t3 = t3 + 1;
    }
    _zag_println("cascade done");

    // ---- knowmap of the 256x92 fit (with its real residual) ----
    let U:[]u8 = nio_alloc((npix * 3) as i32);
    if (U.len == 0) { _zag_println("alloc U failed"); return 1; }
    let ui:i64 = 0;
    while (ui < npix * 3) {
        U[ui] = clamp8((orig[ui] as i64) - px[ui]) as u8;
        ui = ui + 1;
    }
    let rpos:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    let rdelta:[]u8 = nio_alloc((npix * 6) as i32);
    if (rpos.len == 0) { _zag_println("alloc rpos failed"); return 1; }
    let nr:i64 = deliberate_residual(orig, U, w, h, rpos, rdelta, npix);
    if (nr < 0) { _zag_println("residual failed"); return 1; }
    _zag_print("residuals ");
    _zag_print(_zag_i64_to_str(nr));
    _zag_print(" / ");
    _zag_println(_zag_i64_to_str(npix));
    lo = tab_puts(led, lo, "RESIDUAL on the 256x92 fit (error channel, not understanding): ");
    lo = tab_puti(led, lo, nr);
    lo = tab_puts(led, lo, " / ");
    lo = tab_puti(led, lo, npix);
    lo = tab_puts(led, lo, " px\n");
    let rck:i64 = tlk_write(oroot, "knowmap_256.bin", w, h,
        order, 3, committed,
        slx, sly, slw, slh, slm, slg, snleaf[0],
        sgx0, sgy0, sgx1, sgy1, sgm, sgnseg[0],
        ha0, ha1, ha2, ha3, ha4, hna,
        hex0, hex1, hex2, hex3, hex4,
        hrx, hry, hrw, hrh, hrs, hrat, hrm, hrnreg[0], hsilo[0], hsihi[0],
        nr, rpos, rdelta);
    if (rck != 0) { _zag_println("kmap write failed"); return 1; }
    _zag_println("knowmap_256.bin written");

    // ================= 2x CONSTRUCTION =================
    let W:i64 = 512;
    let H:i64 = 184;
    let npix2:i64 = W * H;
    let acc:[]i64 = nio_alloc((npix2 * 3 * 8) as i32) as []i64;
    if (acc.len == 0) { _zag_println("alloc acc failed"); return 1; }
    let lab:[]u8 = nio_alloc((npix2) as i32);
    if (lab.len == 0) { _zag_println("alloc lab failed"); return 1; }
    // 4 = INVENTED until a layer model claims the pixel
    let li0:i64 = 0;
    while (li0 < npix2 * 3) { acc[li0] = 0; li0 = li0 + 1; }
    li0 = 0;
    while (li0 < npix2) { lab[li0] = 4; li0 = li0 + 1; }

    lo = tab_puts(led, lo, "\n2X CONSTRUCTION: re-rendering my committed layers at 2x sampling.\n");
    lo = tab_puts(led, lo, "Even positions (2x,2y) are OBSERVED pixels: the residual channel\n");
    lo = tab_puts(led, lo, "covers them, so they reproduce the input exactly (KNOWN).\n");
    lo = tab_puts(led, lo, "Odd positions are new: built from my layer models, labeled by layer.\n");
    lo = tab_puts(led, lo, "SMOOTH was REVERTED on this observation (fails my commit bar):\n");
    lo = tab_puts(led, lo, "its planar models are not part of the knowledge and are NOT used.\n");
    lo = tab_puts(led, lo, "Odd pixels no committed layer covers are INVENTED (4): I repeat\n");
    lo = tab_puts(led, lo, "the nearest observed pixel (top-left even neighbor) - the most\n");
    lo = tab_puts(led, lo, "conservative invention, one step from an observation.\n");
    let t4:i64 = 0;
    while (t4 < 3) {
        if (committed[t4] == 1) {
            let id4:i64 = order[t4];
            lo = tab_puts(led, lo, "RENDER ");
            lo = layer_name(id4, led, lo);
            lo = tab_puts(led, lo, " at 2x:\n");
            if (id4 == 1) {
                lo = tab_puts(led, lo, "  method: each leaf's planar model re-sampled on the half-pixel grid,\n");
                lo = tab_puts(led, lo, "  v = m + (ax*du2+ay*dv2)/512. At even positions this is bit-identical\n");
                lo = tab_puts(led, lo, "  to my native render; at odd positions it is the plane's own value.\n");
                smooth_render2x(acc, lab, 1, W,
                    slx, sly, slw, slh, slm, slg, snleaf[0],
                    hnfx, hnfy, hnfw, hnfh, hnnofit[0]);
                let lf:i64 = 0;
                while (lf < snleaf[0]) {
                    lo = tab_puts(led, lo, "  LEAF ");
                    lo = tab_puti(led, lo, lf);
                    lo = tab_puts(led, lo, " (");
                    lo = tab_puti(led, lo, slx[lf]);
                    lo = tab_puts(led, lo, ",");
                    lo = tab_puti(led, lo, sly[lf]);
                    lo = tab_puts(led, lo, ") ");
                    lo = tab_puti(led, lo, slw[lf]);
                    lo = tab_puts(led, lo, "x");
                    lo = tab_puti(led, lo, slh[lf]);
                    lo = tab_puts(led, lo, " mean=(");
                    lo = tab_puti(led, lo, slm[lf * 3]);
                    lo = tab_puts(led, lo, ",");
                    lo = tab_puti(led, lo, slm[lf * 3 + 1]);
                    lo = tab_puts(led, lo, ",");
                    lo = tab_puti(led, lo, slm[lf * 3 + 2]);
                    lo = tab_puts(led, lo, ") grad256=(");
                    lo = tab_puti(led, lo, slg[lf * 6]);
                    lo = tab_puts(led, lo, ",");
                    lo = tab_puti(led, lo, slg[lf * 6 + 1]);
                    lo = tab_puts(led, lo, ")/(");
                    lo = tab_puti(led, lo, slg[lf * 6 + 2]);
                    lo = tab_puts(led, lo, ",");
                    lo = tab_puti(led, lo, slg[lf * 6 + 3]);
                    lo = tab_puts(led, lo, ")/(");
                    lo = tab_puti(led, lo, slg[lf * 6 + 4]);
                    lo = tab_puts(led, lo, ",");
                    lo = tab_puti(led, lo, slg[lf * 6 + 5]);
                    lo = tab_puts(led, lo, ") -> ");
                    lo = tab_puti(led, lo, 4 * slw[lf] * slh[lf]);
                    lo = tab_puts(led, lo, " 2x pixels CONSTRUCTED-SMOOTH\n");
                    lf = lf + 1;
                }
            }
            if (id4 == 2) {
                lo = tab_puts(led, lo, "  method: each segment's chord re-rasterized at doubled endpoints\n");
                lo = tab_puts(led, lo, "  (same Bresenham arithmetic as my native render).\n");
                lines_render2x_lab(acc, lab, 2, W, H,
                    sgx0, sgy0, sgx1, sgy1, sgm, sgnseg[0]);
                let sg:i64 = 0;
                while (sg < sgnseg[0]) {
                    lo = tab_puts(led, lo, "  SEG ");
                    lo = tab_puti(led, lo, sg);
                    lo = tab_puts(led, lo, " (");
                    lo = tab_puti(led, lo, sgx0[sg]);
                    lo = tab_puts(led, lo, ",");
                    lo = tab_puti(led, lo, sgy0[sg]);
                    lo = tab_puts(led, lo, ")-(");
                    lo = tab_puti(led, lo, sgx1[sg]);
                    lo = tab_puts(led, lo, ",");
                    lo = tab_puti(led, lo, sgy1[sg]);
                    lo = tab_puts(led, lo, ") at 2x -> chord pixels CONSTRUCTED-LINES\n");
                    sg = sg + 1;
                }
            }
            if (id4 == 3) {
                lo = tab_puts(led, lo, "  method: each region's atom exemplar drawn at 2x, bilinear interp\n");
                lo = tab_puts(led, lo, "  of the deviation field (deterministic integer).\n");
                shapes_render2x(acc, lab, 3, W,
                    ha0, ha1, ha2, ha3, ha4,
                    hrx, hry, hrw, hrh, hrs, hrat, hrm, hrnreg[0], w);
                let rg:i64 = 0;
                while (rg < hrnreg[0]) {
                    lo = tab_puts(led, lo, "  REGION ");
                    lo = tab_puti(led, lo, rg);
                    lo = tab_puts(led, lo, " (");
                    lo = tab_puti(led, lo, hrx[rg]);
                    lo = tab_puts(led, lo, ",");
                    lo = tab_puti(led, lo, hry[rg]);
                    lo = tab_puts(led, lo, ") ");
                    lo = tab_puti(led, lo, hrw[rg]);
                    lo = tab_puts(led, lo, "x");
                    lo = tab_puti(led, lo, hrh[rg]);
                    lo = tab_puts(led, lo, " scale=");
                    lo = tab_puti(led, lo, hrs[rg]);
                    lo = tab_puts(led, lo, " atom=");
                    lo = tab_puti(led, lo, hrat[rg]);
                    lo = tab_puts(led, lo, " -> 2x exemplar pixels CONSTRUCTED-SHAPES\n");
                    rg = rg + 1;
                }
            }
        }
        t4 = t4 + 1;
    }
    _zag_println("2x layer render done");

    // ---- observed pixels: set even positions to the input exactly ----
    let ey:i64 = 0;
    while (ey < h) {
        let ex:i64 = 0;
        while (ex < w) {
            let p:i64 = ((2 * ey) * W + 2 * ex) * 3;
            let q:i64 = (ey * w + ex) * 3;
            acc[p] = orig[q] as i64;
            acc[p + 1] = orig[q + 1] as i64;
            acc[p + 2] = orig[q + 2] as i64;
            lab[(2 * ey) * W + 2 * ex] = 0;
            ex = ex + 1;
        }
        ey = ey + 1;
    }
    _zag_println("observed pixels placed (KNOWN)");
    // ---- generic-interpolator baseline: Catmull-Rom bicubic 2x ----
    // (moved before the fallbacks: the NO-FIT fallback draws from it)
    let fb_bic:[]u8 = nio_alloc((npix2 * 3) as i32);
    if (fb_bic.len == 0) { _zag_println("alloc fb_bic failed"); return 1; }
    bicubic2x(orig, w, h, fb_bic, W, H);
    _zag_println("bicubic baseline done");
    // ---- NO-FIT fallback (REJECT OPTION) ----
    // Blocks where SHAPES said "no atom fits": honest bicubic interpolation,
    // labeled CONSTRUCTED-NO-FIT (6) — "my vocabulary has nothing for this."
    // Only pixels no layer model claimed (label 4) are touched: a genuine
    // LINES/SMOOTH construction stands even inside a rejected SHAPES block.
    // Even positions are KNOWN (observed) and never touched.
    let nf:i64 = 0;
    while (nf < hnnofit[0]) {
        let rx0:i64 = 2 * hnfx[nf];
        let ry0:i64 = 2 * hnfy[nf];
        let rw2:i64 = 2 * hnfw[nf];
        let rh2:i64 = 2 * hnfh[nf];
        let yy:i64 = ry0;
        while (yy < ry0 + rh2) {
            let xx:i64 = rx0;
            while (xx < rx0 + rw2) {
                if (xx < W && yy < H) {
                    let li2:i64 = yy * W + xx;
                    // lab==4 means unclaimed by any layer model; even
                    // positions are already label 0 (KNOWN), so lab==4
                    // exactly selects the constructed pixels here.
                    if ((lab[li2] as i64) == 4) {
                        let p:i64 = li2 * 3;
                        acc[p] = fb_bic[p] as i64;
                        acc[p + 1] = fb_bic[p + 1] as i64;
                        acc[p + 2] = fb_bic[p + 2] as i64;
                        lab[li2] = 6;
                    }
                }
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        nf = nf + 1;
    }
    _zag_println("no-fit pixels filled (bicubic, labeled CONSTRUCTED-NO-FIT)");
    // ---- BOUNDARY FEATHERING (Micah 2026-09-26: "weird rectangle sections") ----
    // SHAPES regions (atom-textured) abutting NO-FIT regions (smooth bicubic)
    // or different atoms read as visible rectangles. Feather a 4-pixel 2x
    // band across each region boundary with a linear cross-fade. Feathered
    // pixels are labeled CONSTRUCTED-SMOOTH (1): honest interpolation, not
    // an atom claim. Deterministic integer arithmetic.
    tl_feather_bounds(acc, lab, W, H,
        hrx, hry, hrw, hrh, hrat, hrnreg[0],
        hnfx, hnfy, hnfw, hnfh, hnnofit[0]);
    _zag_println("boundary feathering done");
    // ---- INVENTED fallback ----
    // TNN's committed layers do not cover every odd pixel (on this
    // observation SMOOTH was reverted, so no planar fallback is part of
    // the committed knowledge). TNN's honest position: repeat the nearest
    // observed pixel (the top-left even neighbor, one step from an
    // observation) — the most conservative invention available. These
    // pixels keep label 4 (INVENTED): no layer model stands behind them.
    let iy5:i64 = 0;
    while (iy5 < H) {
        let ix5:i64 = 0;
        while (ix5 < W) {
            if ((lab[iy5 * W + ix5] as i64) == 4) {
                let sox:i64 = ix5 - (ix5 % 2);
                let soy:i64 = iy5 - (iy5 % 2);
                let p:i64 = (iy5 * W + ix5) * 3;
                let q:i64 = (soy * W + sox) * 3;
                acc[p] = acc[q];
                acc[p + 1] = acc[q + 1];
                acc[p + 2] = acc[q + 2];
            }
            ix5 = ix5 + 1;
        }
        iy5 = iy5 + 1;
    }
    _zag_println("invented pixels filled (nearest observed, labeled INVENTED)");

    // ---- clamp -> TNN upscale BMP ----
    let fb_tnn:[]u8 = nio_alloc((npix2 * 3) as i32);
    if (fb_tnn.len == 0) { _zag_println("alloc fb_tnn failed"); return 1; }
    let fi:i64 = 0;
    while (fi < npix2 * 3) { fb_tnn[fi] = clamp8(acc[fi]) as u8; fi = fi + 1; }
    let rct:i64 = bmp_write(oroot, "upscale_tnn.bmp", fb_tnn, W, H);
    if (rct != 0) { _zag_println("tnn bmp write failed"); return 1; }

    // ---- label map (gallery) + raw labels (outpaint input) ----
    let lmp:[]u8 = nio_alloc((npix2 * 3) as i32);
    if (lmp.len == 0) { _zag_println("alloc lmp failed"); return 1; }
    let labcount:[]i64 = nio_alloc(56) as []i64;
    let lci:i64 = 0;
    while (lci < 7) { labcount[lci] = 0; lci = lci + 1; }
    let mp:i64 = 0;
    while (mp < npix2) {
        let lv:i64 = lab[mp] as i64;
        labcount[lv] = labcount[lv] + 1;
        let q3:i64 = mp * 3;
        if (lv == 0) { lmp[q3] = 200; lmp[q3 + 1] = 200; lmp[q3 + 2] = 200; }
        if (lv == 1) { lmp[q3] = 40; lmp[q3 + 1] = 80; lmp[q3 + 2] = 180; }
        if (lv == 2) { lmp[q3] = 220; lmp[q3 + 1] = 60; lmp[q3 + 2] = 50; }
        if (lv == 3) { lmp[q3] = 60; lmp[q3 + 1] = 170; lmp[q3 + 2] = 80; }
        if (lv == 4) { lmp[q3] = 200; lmp[q3 + 1] = 60; lmp[q3 + 2] = 200; }
        if (lv == 5) { lmp[q3] = 230; lmp[q3 + 1] = 140; lmp[q3 + 2] = 40; }
        if (lv == 6) { lmp[q3] = 50; lmp[q3 + 1] = 190; lmp[q3 + 2] = 190; }
        mp = mp + 1;
    }
    let rcl2:i64 = bmp_write(oroot, "labelmap.bmp", lmp, W, H);
    if (rcl2 != 0) { _zag_println("labelmap write failed"); return 1; }
    let rclr:i64 = file_write(oroot, "labels_raw.bin", lab);
    if (rclr != 0) { _zag_println("labels_raw write failed"); return 1; }
    lo = tab_puts(led, lo, "\nEPISTEMIC CENSUS (512x184 = ");
    lo = tab_puti(led, lo, npix2);
    lo = tab_puts(led, lo, " px):\n");
    let lc2:i64 = 0;
    while (lc2 < 7) {
        lo = tab_puts(led, lo, "  ");
        lo = lab_name(lc2, led, lo);
        lo = tab_puts(led, lo, ": ");
        lo = tab_puti(led, lo, labcount[lc2]);
        lo = tab_puts(led, lo, " px (");
        lo = tab_puti(led, lo, (labcount[lc2] * 1000) / npix2);
        lo = tab_puts(led, lo, " per-mille)\n");
        lc2 = lc2 + 1;
    }
    lo = tab_puts(led, lo, "No constructed pixel is presented as observed. The INVENTED count\n");
    lo = tab_puts(led, lo, "is reported honestly even if it is zero (SMOOTH tiles the frame).\n");
    _zag_println("labelmap written");

    // (bicubic baseline already computed before the fallbacks; just write it)
    let rcb:i64 = bmp_write(oroot, "upscale_bicubic.bmp", fb_bic, W, H);
    if (rcb != 0) { _zag_println("bicubic bmp write failed"); return 1; }

    // ================= MEASUREMENT (held ground truth; never constructed-from) ====
    let gfd:i64 = nio_open_child(root, "gt_512x184.bmp", 0);
    if (gfd < 0) { _zag_println("cannot open gt"); nio_close(root); return 1; }
    let gbuf:[]u8 = nio_alloc(400000);
    if (gbuf.len == 0) { _zag_println("alloc gbuf failed"); return 1; }
    let gn:i64 = nio_read_exact(gfd, gbuf, 399999);
    nio_close(gfd);
    if (gn < 54) { _zag_println("short gt"); return 1; }
    let goff:i64 = r_u32le(gbuf, 10);
    let gw:i64 = r_i32le(gbuf, 18);
    let gh:i64 = r_i32le(gbuf, 22);
    if (gw != W) { _zag_println("gt w mismatch"); return 1; }
    if (gh != H) { _zag_println("gt h mismatch"); return 1; }
    let gstride:i64 = (gw * 3 + 3) / 4 * 4;
    let gt:[]u8 = nio_alloc((npix2 * 3) as i32);
    if (gt.len == 0) { _zag_println("alloc gt failed"); return 1; }
    let gy2:i64 = 0;
    while (gy2 < gh) {
        let gsrc:i64 = gh - 1 - gy2;
        let gx2:i64 = 0;
        while (gx2 < gw) {
            let q:i64 = goff + gsrc * gstride + gx2 * 3;
            let p:i64 = (gy2 * gw + gx2) * 3;
            gt[p] = gbuf[q + 2];
            gt[p + 1] = gbuf[q + 1];
            gt[p + 2] = gbuf[q];
            gx2 = gx2 + 1;
        }
        gy2 = gy2 + 1;
    }
    nio_free(gbuf);
    _zag_println("ground truth loaded (measurement only)");

    // full-frame SSE per channel, both methods
    let sse_tnn:[]i64 = nio_alloc(24) as []i64;
    let sse_bic:[]i64 = nio_alloc(24) as []i64;
    let sc:i64 = 0;
    while (sc < 3) { sse_tnn[sc] = 0; sse_bic[sc] = 0; sc = sc + 1; }
    let mi2:i64 = 0;
    while (mi2 < npix2 * 3) {
        let d0:i64 = (fb_tnn[mi2] as i64) - (gt[mi2] as i64);
        let d1:i64 = (fb_bic[mi2] as i64) - (gt[mi2] as i64);
        sse_tnn[mi2 % 3] = sse_tnn[mi2 % 3] + d0 * d0;
        sse_bic[mi2 % 3] = sse_bic[mi2 % 3] + d1 * d1;
        mi2 = mi2 + 1;
    }
    // odd-positions-only SSE (the constructed pixels; evens are shared input)
    let sse_tnn_odd:[]i64 = nio_alloc(24) as []i64;
    let sse_bic_odd:[]i64 = nio_alloc(24) as []i64;
    sc = 0;
    while (sc < 3) { sse_tnn_odd[sc] = 0; sse_bic_odd[sc] = 0; sc = sc + 1; }
    let oy3:i64 = 0;
    while (oy3 < H) {
        let ox3:i64 = 0;
        while (ox3 < W) {
            if ((ox3 + oy3) % 2 == 1) {
                let p:i64 = (oy3 * W + ox3) * 3;
                let c3:i64 = 0;
                while (c3 < 3) {
                    let e0:i64 = (fb_tnn[p + c3] as i64) - (gt[p + c3] as i64);
                    let e1:i64 = (fb_bic[p + c3] as i64) - (gt[p + c3] as i64);
                    sse_tnn_odd[c3] = sse_tnn_odd[c3] + e0 * e0;
                    sse_bic_odd[c3] = sse_bic_odd[c3] + e1 * e1;
                    c3 = c3 + 1;
                }
            }
            ox3 = ox3 + 1;
        }
        oy3 = oy3 + 1;
    }
    // per-tile SSE: 8x4 grid of 64x46
    let tbuf:[]u8 = nio_alloc(65536);
    if (tbuf.len == 0) { _zag_println("alloc tbuf failed"); return 1; }
    let to:i64 = 0;
    let ty:i64 = 0;
    while (ty < 4) {
        let tx:i64 = 0;
        while (tx < 8) {
            let ts_tnn:[]i64 = nio_alloc(24) as []i64;
            let ts_bic:[]i64 = nio_alloc(24) as []i64;
            let c4:i64 = 0;
            while (c4 < 3) { ts_tnn[c4] = 0; ts_bic[c4] = 0; c4 = c4 + 1; }
            let py:i64 = 0;
            while (py < 46) {
                let px2:i64 = 0;
                while (px2 < 64) {
                    let OX:i64 = tx * 64 + px2;
                    let OY:i64 = ty * 46 + py;
                    let p:i64 = (OY * W + OX) * 3;
                    let c5:i64 = 0;
                    while (c5 < 3) {
                        let f0:i64 = (fb_tnn[p + c5] as i64) - (gt[p + c5] as i64);
                        let f1:i64 = (fb_bic[p + c5] as i64) - (gt[p + c5] as i64);
                        ts_tnn[c5] = ts_tnn[c5] + f0 * f0;
                        ts_bic[c5] = ts_bic[c5] + f1 * f1;
                        c5 = c5 + 1;
                    }
                    px2 = px2 + 1;
                }
                py = py + 1;
            }
            to = tab_puts(tbuf, to, "tile ");
            to = tab_puti(tbuf, to, tx);
            to = tab_puts(tbuf, to, ",");
            to = tab_puti(tbuf, to, ty);
            to = tab_puts(tbuf, to, " tnn_sse=");
            to = tab_puti(tbuf, to, ts_tnn[0]);
            to = tab_puts(tbuf, to, ",");
            to = tab_puti(tbuf, to, ts_tnn[1]);
            to = tab_puts(tbuf, to, ",");
            to = tab_puti(tbuf, to, ts_tnn[2]);
            to = tab_puts(tbuf, to, " bic_sse=");
            to = tab_puti(tbuf, to, ts_bic[0]);
            to = tab_puts(tbuf, to, ",");
            to = tab_puti(tbuf, to, ts_bic[1]);
            to = tab_puts(tbuf, to, ",");
            to = tab_puti(tbuf, to, ts_bic[2]);
            to = tab_puts(tbuf, to, " n=2944\n");
            nio_free(ts_tnn);
            nio_free(ts_bic);
            tx = tx + 1;
        }
        ty = ty + 1;
    }
    let rct2:i64 = file_write(oroot, "TILES.txt", tbuf[0..to]);
    if (rct2 != 0) { _zag_println("tiles write failed"); return 1; }
    // per-label-class SSE over odd positions (TNN's construction, by label)
    let lbuf:[]u8 = nio_alloc(8192);
    if (lbuf.len == 0) { _zag_println("alloc lbuf failed"); return 1; }
    let loo:i64 = 0;
    loo = tab_puts(lbuf, loo, "per-label SSE over ODD positions only (constructed pixels), TNN vs bicubic, n counts odd px per class\n");
    let lc3:i64 = 0;
    while (lc3 < 7) {
        let ls_tnn:[]i64 = nio_alloc(24) as []i64;
        let ls_bic:[]i64 = nio_alloc(24) as []i64;
        let ln:i64 = 0;
        let c6:i64 = 0;
        while (c6 < 3) { ls_tnn[c6] = 0; ls_bic[c6] = 0; c6 = c6 + 1; }
        let ly4:i64 = 0;
        while (ly4 < H) {
            let lx4:i64 = 0;
            while (lx4 < W) {
                if ((lx4 + ly4) % 2 == 1) {
                    if ((lab[ly4 * W + lx4] as i64) == lc3) {
                        ln = ln + 1;
                        let p:i64 = (ly4 * W + lx4) * 3;
                        let c7:i64 = 0;
                        while (c7 < 3) {
                            let g0:i64 = (fb_tnn[p + c7] as i64) - (gt[p + c7] as i64);
                            let g1:i64 = (fb_bic[p + c7] as i64) - (gt[p + c7] as i64);
                            ls_tnn[c7] = ls_tnn[c7] + g0 * g0;
                            ls_bic[c7] = ls_bic[c7] + g1 * g1;
                            c7 = c7 + 1;
                        }
                    }
                }
                lx4 = lx4 + 1;
            }
            ly4 = ly4 + 1;
        }
        loo = tab_puts(lbuf, loo, "label ");
        loo = tab_puti(lbuf, loo, lc3);
        loo = tab_puts(lbuf, loo, " ");
        loo = lab_name(lc3, lbuf, loo);
        loo = tab_puts(lbuf, loo, " n_odd=");
        loo = tab_puti(lbuf, loo, ln);
        loo = tab_puts(lbuf, loo, " tnn_sse=");
        loo = tab_puti(lbuf, loo, ls_tnn[0]);
        loo = tab_puts(lbuf, loo, ",");
        loo = tab_puti(lbuf, loo, ls_tnn[1]);
        loo = tab_puts(lbuf, loo, ",");
        loo = tab_puti(lbuf, loo, ls_tnn[2]);
        loo = tab_puts(lbuf, loo, " bic_sse=");
        loo = tab_puti(lbuf, loo, ls_bic[0]);
        loo = tab_puts(lbuf, loo, ",");
        loo = tab_puti(lbuf, loo, ls_bic[1]);
        loo = tab_puts(lbuf, loo, ",");
        loo = tab_puti(lbuf, loo, ls_bic[2]);
        loo = tab_puts(lbuf, loo, "\n");
        nio_free(ls_tnn);
        nio_free(ls_bic);
        lc3 = lc3 + 1;
    }
    loo = tab_puts(lbuf, loo, "label counts (all 512x184 px): ");
    let lc4:i64 = 0;
    while (lc4 < 7) {
        loo = tab_puti(lbuf, loo, labcount[lc4]);
        if (lc4 < 6) { loo = tab_puts(lbuf, loo, ","); }
        lc4 = lc4 + 1;
    }
    loo = tab_puts(lbuf, loo, " for labels 0..6\n");
    let rcl3:i64 = file_write(oroot, "LABELS.txt", lbuf[0..loo]);
    if (rcl3 != 0) { _zag_println("labels write failed"); return 1; }

    // SCORES.txt: integer-exact full-frame + odd-only SSE
    let sbuf:[]u8 = nio_alloc(4096);
    if (sbuf.len == 0) { _zag_println("alloc sbuf failed"); return 1; }
    let so:i64 = 0;
    so = tab_puts(sbuf, so, "HONEST UPSCALE SCORES (integer-exact SSE vs held gt_512x184.bmp; dB via metrics.py)\n");
    so = tab_puts(sbuf, so, "full frame 512x184 n=94208 px:\n");
    so = tab_puts(sbuf, so, "  tnn_sse_r=");
    so = tab_puti(sbuf, so, sse_tnn[0]);
    so = tab_puts(sbuf, so, " g=");
    so = tab_puti(sbuf, so, sse_tnn[1]);
    so = tab_puts(sbuf, so, " b=");
    so = tab_puti(sbuf, so, sse_tnn[2]);
    so = tab_puts(sbuf, so, "\n  bic_sse_r=");
    so = tab_puti(sbuf, so, sse_bic[0]);
    so = tab_puts(sbuf, so, " g=");
    so = tab_puti(sbuf, so, sse_bic[1]);
    so = tab_puts(sbuf, so, " b=");
    so = tab_puti(sbuf, so, sse_bic[2]);
    so = tab_puts(sbuf, so, "\nodd positions only (n=47104; the constructed pixels; evens are shared input):\n");
    so = tab_puts(sbuf, so, "  tnn_odd_sse_r=");
    so = tab_puti(sbuf, so, sse_tnn_odd[0]);
    so = tab_puts(sbuf, so, " g=");
    so = tab_puti(sbuf, so, sse_tnn_odd[1]);
    so = tab_puts(sbuf, so, " b=");
    so = tab_puti(sbuf, so, sse_tnn_odd[2]);
    so = tab_puts(sbuf, so, "\n  bic_odd_sse_r=");
    so = tab_puti(sbuf, so, sse_bic_odd[0]);
    so = tab_puts(sbuf, so, " g=");
    so = tab_puti(sbuf, so, sse_bic_odd[1]);
    so = tab_puts(sbuf, so, " b=");
    so = tab_puti(sbuf, so, sse_bic_odd[2]);
    so = tab_puts(sbuf, so, "\n");
    let rcs2:i64 = file_write(oroot, "SCORES.txt", sbuf[0..so]);
    if (rcs2 != 0) { _zag_println("scores write failed"); return 1; }

    lo = tab_puts(led, lo, "\nMEASUREMENT: both constructions compared against the held 512x184\n");
    lo = tab_puts(led, lo, "ground truth (integer-exact SSE; dB via metrics.py on the BMPs).\n");
    lo = tab_puts(led, lo, "Full-frame SSE shows the honest total; odd-positions-only SSE isolates\n");
    lo = tab_puts(led, lo, "the constructed pixels (even positions are the shared observed input).\n");
    lo = tab_puts(led, lo, "My layers, in my words: ");
    let t5:i64 = 0;
    let firstl:i64 = 1;
    while (t5 < 3) {
        if (committed[t5] == 1) {
            if (firstl == 0) { lo = tab_puts(led, lo, ", then "); }
            lo = layer_name(order[t5], led, lo);
            firstl = 0;
        }
        t5 = t5 + 1;
    }
    if (firstl == 1) { lo = tab_puts(led, lo, "(none — the input alone)"); }
    lo = tab_puts(led, lo, ".\n");
    let rcl:i64 = file_write(oroot, "UPSCALE_TRACE.txt", led[0..lo]);
    nio_close(root);
    nio_close(oroot);
    if (rcl != 0) { _zag_println("trace write failed"); return 1; }
    _zag_println("upscale done");
    return 0;
}

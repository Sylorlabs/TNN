// tnnlayers.zag — TNN-CHOOSES-ITS-LAYERS: the mechanism menu and TNN's
// deliberation policy. (image_tnnlayers; Micah order 2026-09-26 ~09:54 PDT:
// "layers are clearly needed — but what happens if TNN chooses its layers
// instead? Let's try that.")
//
// The mechanism MENU is fixed (three organizations with different cost
// structures: SMOOTH/quadtree-planar, LINES/straight-segments,
// SHAPES/multi-scale exemplar patches). What is NOT fixed — what TNN itself
// decides from its survey, deterministically, with recorded reasons — is:
//   * how many layers it uses (each candidate must pass a measured bar),
//   * which mechanisms (subset of the menu),
//   * what order they run in (survey-affinity order),
//   * each layer's vocabulary/budget (quadtree depth from the per-value-9
//     precision precedent; segment set from measured walks; shape scale-set
//     from a repetition probe).
// A candidate that fails its measured bar is REVERTED (its records
// discarded, the residual restored) and the rejection is recorded with
// numbers. Unhelpful weirdness is measured and reported, not hidden.
//
// Everything runs in i64 residual space: px is npix*3 i64 values. Layer 0
// sees the fixture; later layers see fixture minus committed layers.
// Understanding render = clamp(fixture - R_final) == clamp(sum of layer
// reconstructions), byte-identical by construction.
//
// Zero RNG. Deterministic: lowest-index tie-breaks, canonical orders,
// explicit initialization. Pinned toolchain znc_linux_x86_64_abed8aa1.
@import("./common_az.zag")

// scale table: si 0..4 -> 64,32,16,8,4
fn s_of(si:i64) i64 {
    if (si == 0) { return 64; }
    if (si == 1) { return 32; }
    if (si == 2) { return 16; }
    if (si == 3) { return 8; }
    return 4;
}

// convergence threshold per scale: 9 per value (3*s*s values) — the v2
// never-triggered precedent, same as the no-layers fork.
fn tau_of(si:i64) i64 {
    let s:i64 = s_of(si);
    return 9 * 3 * s * s;
}

// inverse of s_of for the SHAPES usage records (hrs stores the B value)
fn si_of_b(b:i64) i64 {
    if (b == 64) { return 0; }
    if (b == 32) { return 1; }
    if (b == 16) { return 2; }
    if (b == 8) { return 3; }
    return 4;
}

// ---------------- trace helpers (the deliberation writes its own audit) ----------------
fn tr_puts(b:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { b[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn tr_puti(b:[]u8, o:i64, v:i64) i64 {
    if (v < 0) { b[o] = 45; o = o + 1; v = 0 - v; }
    let t:[]u8 = _zag_i64_to_str(v);
    let i:i64 = 0;
    while (i < t.len) { b[o + i] = t[i]; i = i + 1; }
    return o + t.len;
}

// ---------------- CART content-adaptive splits in i64 residual space ----------------
// Parent-2's rule, generalized from u8 pixels to the i64 cascade space:
// among every valid binary cut position, choose the cut that minimizes
// E_flat(child1)+E_flat(child2) — the two-piece flat fit's explained
// energy, measured against the same flat-mean baseline e0 the fork uses
// for take/split. No thresholds, no tuned constants in the POSITION
// choice; the split-vs-leaf bar is applied by the caller.
// Candidate cuts: every pixel position with >= 4 px on each side (the
// vocabulary floor: a region thinner than 4 cannot take an atom).
// Tie-break (canonical, deterministic): strictly-less-than replacement
// while scanning, vertical cuts before horizontal, lowest position wins.
// out[0] = axis (0 vertical, 1 horizontal, -1 = no energy-reducing cut);
// out[1] = cut position; out[2] = E0(rect); out[3] = E0(c1)+E0(c2).
fn tl_seg_e0(psx:[]i64, psx2:[]i64, a:i64, b:i64, n:i64) i64 {
    let e:i64 = 0;
    let ch:i64 = 0;
    while (ch < 3) {
        let sx:i64 = psx[b * 3 + ch] - psx[a * 3 + ch];
        let sx2:i64 = psx2[b * 3 + ch] - psx2[a * 3 + ch];
        let mean:i64 = sx / n;
        e = e + sx2 - 2 * mean * sx + n * mean * mean;
        ch = ch + 1;
    }
    return e;
}
fn tl_col_prefix(px:[]i64, w:i64, x0:i64, y0:i64, bw:i64, bh:i64,
    psx:[]i64, psx2:[]i64) void {
    // prefix-sum base: uninitialized heap is NOT reliably zeroed
    psx[0] = 0; psx[1] = 0; psx[2] = 0;
    psx2[0] = 0; psx2[1] = 0; psx2[2] = 0;
    let c:i64 = 0;
    while (c < bw) {
        let s0:i64 = 0; let s1:i64 = 0; let s2:i64 = 0;
        let q0:i64 = 0; let q1:i64 = 0; let q2:i64 = 0;
        let yy:i64 = 0;
        while (yy < bh) {
            let p:i64 = ((y0 + yy) * w + (x0 + c)) * 3;
            let v0:i64 = px[p];
            let v1:i64 = px[p + 1];
            let v2:i64 = px[p + 2];
            s0 = s0 + v0; s1 = s1 + v1; s2 = s2 + v2;
            q0 = q0 + v0 * v0; q1 = q1 + v1 * v1; q2 = q2 + v2 * v2;
            yy = yy + 1;
        }
        psx[(c + 1) * 3] = psx[c * 3] + s0;
        psx[(c + 1) * 3 + 1] = psx[c * 3 + 1] + s1;
        psx[(c + 1) * 3 + 2] = psx[c * 3 + 2] + s2;
        psx2[(c + 1) * 3] = psx2[c * 3] + q0;
        psx2[(c + 1) * 3 + 1] = psx2[c * 3 + 1] + q1;
        psx2[(c + 1) * 3 + 2] = psx2[c * 3 + 2] + q2;
        c = c + 1;
    }
}
fn tl_row_prefix(px:[]i64, w:i64, x0:i64, y0:i64, bw:i64, bh:i64,
    psx:[]i64, psx2:[]i64) void {
    psx[0] = 0; psx[1] = 0; psx[2] = 0;
    psx2[0] = 0; psx2[1] = 0; psx2[2] = 0;
    let r:i64 = 0;
    while (r < bh) {
        let s0:i64 = 0; let s1:i64 = 0; let s2:i64 = 0;
        let q0:i64 = 0; let q1:i64 = 0; let q2:i64 = 0;
        let xx:i64 = 0;
        while (xx < bw) {
            let p:i64 = ((y0 + r) * w + (x0 + xx)) * 3;
            let v0:i64 = px[p];
            let v1:i64 = px[p + 1];
            let v2:i64 = px[p + 2];
            s0 = s0 + v0; s1 = s1 + v1; s2 = s2 + v2;
            q0 = q0 + v0 * v0; q1 = q1 + v1 * v1; q2 = q2 + v2 * v2;
            xx = xx + 1;
        }
        psx[(r + 1) * 3] = psx[r * 3] + s0;
        psx[(r + 1) * 3 + 1] = psx[r * 3 + 1] + s1;
        psx[(r + 1) * 3 + 2] = psx[r * 3 + 2] + s2;
        psx2[(r + 1) * 3] = psx2[r * 3] + q0;
        psx2[(r + 1) * 3 + 1] = psx2[r * 3 + 1] + q1;
        psx2[(r + 1) * 3 + 2] = psx2[r * 3 + 2] + q2;
        r = r + 1;
    }
}
fn tl_cart_cut(px:[]i64, w:i64, x0:i64, y0:i64, bw:i64, bh:i64,
    out:[]i64) void {
    out[0] = -1;
    out[1] = 0;
    out[2] = 0;
    out[3] = 0;
    let psx:[]i64 = nio_alloc(((bw + 1) * 24) as i32) as []i64;
    let psx2:[]i64 = nio_alloc(((bw + 1) * 24) as i32) as []i64;
    if (psx.len == 0) { return; }
    if (psx2.len == 0) { nio_free(psx); return; }
    tl_col_prefix(px, w, x0, y0, bw, bh, psx, psx2);
    let e0:i64 = tl_seg_e0(psx, psx2, 0, bw, bw * bh);
    out[2] = e0;
    let best_e:i64 = e0;
    let best_ax:i64 = -1;
    let best_p:i64 = 0;
    if (bw >= 8) {
        let vc:i64 = 4;
        while (vc <= bw - 4) {
            let et:i64 = tl_seg_e0(psx, psx2, 0, vc, vc * bh)
                + tl_seg_e0(psx, psx2, vc, bw, (bw - vc) * bh);
            if (et < best_e) { best_e = et; best_ax = 0; best_p = vc; }
            vc = vc + 1;
        }
    }
    nio_free(psx);
    nio_free(psx2);
    if (bh >= 8) {
        let qx:[]i64 = nio_alloc(((bh + 1) * 24) as i32) as []i64;
        let qx2:[]i64 = nio_alloc(((bh + 1) * 24) as i32) as []i64;
        if (qx.len == 0) {
            out[0] = best_ax; out[1] = best_p; out[3] = best_e;
            return;
        }
        if (qx2.len == 0) {
            nio_free(qx);
            out[0] = best_ax; out[1] = best_p; out[3] = best_e;
            return;
        }
        tl_row_prefix(px, w, x0, y0, bw, bh, qx, qx2);
        let hr:i64 = 4;
        while (hr <= bh - 4) {
            let et2:i64 = tl_seg_e0(qx, qx2, 0, hr, hr * bw)
                + tl_seg_e0(qx, qx2, hr, bh, (bh - hr) * bw);
            if (et2 < best_e) { best_e = et2; best_ax = 1; best_p = hr; }
            hr = hr + 1;
        }
        nio_free(qx);
        nio_free(qx2);
    }
    out[0] = best_ax;
    out[1] = best_p;
    out[3] = best_e;
    return;
}

// ---------------- FREE-LUNCH L1: prune unfired atoms ----------------
// Compacts each SHAPES vocabulary in place, dropping atoms that never
// fire in any usage record. Deterministic: firing counts come from
// (hrs,hrat,hrnreg); fired atoms keep original relative order; usage
// indices (hrat) are rewritten through the new-index map; hna[si] is
// updated to the kept count. Unfired atoms are never indexed by any
// renderer, so path-A and path-B renders are byte-identical before/after.
// kept[si] out = kept count per scale; saved[0] out = bytes dropped.
fn tl_prune_shapes(
    ha0:[]u8, ha1:[]u8, ha2:[]u8, ha3:[]u8, ha4:[]u8,
    hna:[]i64,
    hex0:[]i64, hex1:[]i64, hex2:[]i64, hex3:[]i64, hex4:[]i64,
    hrs:[]i64, hrat:[]i64, hrnreg:i64,
    hsilo:i64, hsihi:i64, kept:[]i64, saved:[]i64) void {
    saved[0] = 0;
    let si:i64 = hsilo;
    while (si <= hsihi) {
        let atoms:[]u8 = ha0;
        let aex:[]i64 = hex0;
        if (si == 1) { atoms = ha1; aex = hex1; }
        if (si == 2) { atoms = ha2; aex = hex2; }
        if (si == 3) { atoms = ha3; aex = hex3; }
        if (si == 4) { atoms = ha4; aex = hex4; }
        let na:i64 = hna[si];
        let B:i64 = s_of(si);
        let mb:i64 = B * B * 3 * 2;
        let cnt:[]i64 = nio_alloc((na * 8) as i32) as []i64;
        let nidx:[]i64 = nio_alloc((na * 8) as i32) as []i64;
        let ci0:i64 = 0;
        while (ci0 < na) { cnt[ci0] = 0; nidx[ci0] = -1; ci0 = ci0 + 1; }
        let ri:i64 = 0;
        while (ri < hrnreg) {
            if (si_of_b(hrs[ri]) == si) {
                let at:i64 = hrat[ri];
                if (at >= 0) {
                    if (at < na) { cnt[at] = cnt[at] + 1; }
                }
            }
            ri = ri + 1;
        }
        let nk:i64 = 0;
        let ai:i64 = 0;
        while (ai < na) {
            if (cnt[ai] > 0) { nidx[ai] = nk; nk = nk + 1; }
            ai = ai + 1;
        }
        ai = 0;
        while (ai < na) {
            if (nidx[ai] >= 0) {
                let dst:i64 = nidx[ai] * mb;
                let src:i64 = ai * mb;
                if (dst != src) {
                    let k:i64 = 0;
                    while (k < mb) { atoms[dst + k] = atoms[src + k]; k = k + 1; }
                }
                aex[nidx[ai]] = aex[ai];
            }
            ai = ai + 1;
        }
        ri = 0;
        while (ri < hrnreg) {
            if (si_of_b(hrs[ri]) == si) {
                hrat[ri] = nidx[hrat[ri]];
            }
            ri = ri + 1;
        }
        kept[si] = nk;
        saved[0] = saved[0] + (na - nk) * (mb + 8);
        hna[si] = nk;
        nio_free(cnt);
        nio_free(nidx);
        si = si + 1;
    }
    return;
}

// ---------------- FREE-LUNCH L2: residual coding modes ----------------
// Measures the residual data and reports the tightest exact coding:
// modes[0]: 0 = deltas fit i8 (3 B/entry), 1 = need i16 (6 B/entry)
// modes[1]: 0 = gaps fit u16 (2 B/gap), 1 = need u32 (4 B/gap)
// Positions are strictly increasing (row-major scan), so gap coding is
// exact. Deterministic on the data being written.
fn tl_res_modes(nr:i64, rpos:[]i64, rdelta:[]u8, modes:[]i64) void {
    modes[0] = 0;
    modes[1] = 0;
    if (nr <= 0) { return; }
    let dmin:i64 = 0;
    let dmax:i64 = 0;
    let j:i64 = 0;
    while (j < nr) {
        let d0:i64 = r_i16le(rdelta, j * 6);
        let d1:i64 = r_i16le(rdelta, j * 6 + 2);
        let d2:i64 = r_i16le(rdelta, j * 6 + 4);
        if (d0 < dmin) { dmin = d0; }
        if (d0 > dmax) { dmax = d0; }
        if (d1 < dmin) { dmin = d1; }
        if (d1 > dmax) { dmax = d1; }
        if (d2 < dmin) { dmin = d2; }
        if (d2 > dmax) { dmax = d2; }
        j = j + 1;
    }
    if (dmin < -128) { modes[0] = 1; }
    if (dmax > 127) { modes[0] = 1; }
    let maxgap:i64 = 0;
    j = 1;
    while (j < nr) {
        let g:i64 = rpos[j] - rpos[j - 1];
        if (g > maxgap) { maxgap = g; }
        j = j + 1;
    }
    if (maxgap > 65535) { modes[1] = 1; }
    return;
}

// byte size of the TNNKTLM2 residual section for this data
fn tl_res_size(nr:i64, rpos:[]i64, rdelta:[]u8) i64 {
    let modes:[]i64 = nio_alloc(16) as []i64;
    tl_res_modes(nr, rpos, rdelta, modes);
    let db:i64 = 3;
    if (modes[0] == 1) { db = 6; }
    let gb:i64 = 2;
    if (modes[1] == 1) { gb = 4; }
    nio_free(modes);
    if (nr <= 0) { return 8 + 1 + 1 + 4; }
    return 8 + 1 + 1 + 4 + (nr - 1) * gb + nr * db;
}

// ---------------- farthest-point vocabulary (copied from nolayers.zag) ----------------
// bdet: nb*s*s*3 i16 values (mean-subtracted), block-major; bval[bi] =
// valid value count; cand/ncand = full-block candidate indices.
// atoms: cap*s*s*3*2 bytes out; aex[0] = -1 (NULL shape); agains[na] =
// the min-distance that earned atom na its place (agains[0] = 0).
// tau: stop when the best new atom is within tau of the set.
// gains[0] = last adopted gain, gains[1] = first adopted gain.
// Returns na (>= 1). cap is data-derived (<= candidate count).
fn fp_atoms(bdet:[]u8, bval:[]i64, s:i64, nb:i64, cand:[]i64, ncand:i64,
    atoms:[]u8, aex:[]i64, agains:[]i64, cap:i64, tau:i64, gains:[]i64) i64 {
    let nv:i64 = s * s * 3;
    let mbytes:i64 = nv * 2;
    let zk:i64 = 0;
    while (zk < nv) { w_i16le(atoms, zk * 2, 0); zk = zk + 1; }
    aex[0] = -1;
    agains[0] = 0;
    let na:i64 = 1;
    gains[0] = 0;
    gains[1] = 0;
    if (ncand == 0) { return 1; }
    let energy:[]i64 = nio_alloc((ncand * 8) as i32) as []i64;
    if (energy.len == 0) { return -1; }
    let mind:[]i64 = nio_alloc((ncand * 8) as i32) as []i64;
    if (mind.len == 0) { return -1; }
    let ci:i64 = 0;
    while (ci < ncand) {
        let bi:i64 = cand[ci];
        let e:i64 = 0;
        let k:i64 = 0;
        while (k < bval[bi]) {
            let v:i64 = r_i16le(bdet, bi * mbytes + k * 2);
            e = e + v * v;
            k = k + 1;
        }
        energy[ci] = e;
        mind[ci] = e;
        ci = ci + 1;
    }
    let best:i64 = 0;
    let bk:i64 = 1;
    while (bk < ncand) {
        if (energy[bk] > energy[best]) { best = bk; }
        bk = bk + 1;
    }
    gains[1] = energy[best];
    let sel_gain:i64 = energy[best];
    let go:i64 = 1;
    while (go == 1) {
        let exbi:i64 = cand[best];
        aex[na] = exbi;
        agains[na] = sel_gain;
        let k2:i64 = 0;
        while (k2 < nv) {
            w_i16le(atoms, na * mbytes + k2 * 2, r_i16le(bdet, exbi * mbytes + k2 * 2));
            k2 = k2 + 1;
        }
        na = na + 1;
        let nbest:i64 = 0;
        let nbestd:i64 = -1;
        let ck:i64 = 0;
        while (ck < ncand) {
            let dd:i64 = 0;
            let k3:i64 = 0;
            let cb:i64 = cand[ck] * mbytes;
            let eb:i64 = exbi * mbytes;
            let nvv:i64 = bval[cand[ck]];
            while (k3 < nvv) {
                let dv:i64 = r_i16le(bdet, cb + k3 * 2) - r_i16le(bdet, eb + k3 * 2);
                dd = dd + dv * dv;
                k3 = k3 + 1;
            }
            if (dd < mind[ck]) { mind[ck] = dd; }
            if (mind[ck] > nbestd) { nbestd = mind[ck]; nbest = ck; }
            ck = ck + 1;
        }
        gains[0] = nbestd;
        sel_gain = nbestd;
        if (na >= cap) { go = 0; }
        if (nbestd < tau) { go = 0; }
        best = nbest;
    }
    nio_free(energy);
    nio_free(mind);
    return na;
}

// ---------------- i16-space patch (mean-subtracted) ----------------
// px: npix*3 i64. mean[0..2] out (i64); sub = bw*bh*3 i16 (caller-sized);
// e0[0] = SSD of the rect from its own mean. Diffs clamped to i16 range.
fn tl_patch16(px:[]i64, w:i64, x0:i64, y0:i64, bw:i64, bh:i64,
    mean:[]i64, sub:[]u8, e0:[]i64) void {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
    let yy:i64 = 0;
    while (yy < bh) {
        let xx:i64 = 0;
        while (xx < bw) {
            let p:i64 = ((y0 + yy) * w + (x0 + xx)) * 3;
            sr = sr + px[p];
            sg = sg + px[p + 1];
            sb = sb + px[p + 2];
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    let n:i64 = bw * bh;
    mean[0] = sr / n; mean[1] = sg / n; mean[2] = sb / n;
    let e:i64 = 0;
    let yy2:i64 = 0;
    while (yy2 < bh) {
        let xx2:i64 = 0;
        while (xx2 < bw) {
            let p2:i64 = ((y0 + yy2) * w + (x0 + xx2)) * 3;
            let q:i64 = (yy2 * bw + xx2) * 6;
            let d0:i64 = px[p2] - mean[0];
            let d1:i64 = px[p2 + 1] - mean[1];
            let d2:i64 = px[p2 + 2] - mean[2];
            if (d0 > 32767) { d0 = 32767; }
            if (d0 < -32768) { d0 = -32768; }
            if (d1 > 32767) { d1 = 32767; }
            if (d1 < -32768) { d1 = -32768; }
            if (d2 > 32767) { d2 = 32767; }
            if (d2 < -32768) { d2 = -32768; }
            w_i16le(sub, q, d0);
            w_i16le(sub, q + 2, d1);
            w_i16le(sub, q + 4, d2);
            e = e + d0 * d0 + d1 * d1 + d2 * d2;
            xx2 = xx2 + 1;
        }
        yy2 = yy2 + 1;
    }
    e0[0] = e;
}

// ---------------- SURVEY: flat-block energies in i64 space ----------------
// out[0..4] = E_flat at scales 64..4; out[5] = Etot vs global mean.
fn tl_survey_flat(px:[]i64, w:i64, h:i64, out:[]i64) void {
    let gsr:i64 = 0; let gsg:i64 = 0; let gsb:i64 = 0;
    let npix:i64 = w * h;
    let pi:i64 = 0;
    while (pi < npix) {
        gsr = gsr + px[pi * 3];
        gsg = gsg + px[pi * 3 + 1];
        gsb = gsb + px[pi * 3 + 2];
        pi = pi + 1;
    }
    let gmr:i64 = gsr / npix; let gmg:i64 = gsg / npix; let gmb:i64 = gsb / npix;
    let etot:i64 = 0;
    pi = 0;
    while (pi < npix) {
        let dr:i64 = px[pi * 3] - gmr;
        let dg:i64 = px[pi * 3 + 1] - gmg;
        let db:i64 = px[pi * 3 + 2] - gmb;
        etot = etot + dr * dr + dg * dg + db * db;
        pi = pi + 1;
    }
    out[5] = etot;
    let si:i64 = 0;
    while (si < 5) {
        let s:i64 = s_of(si);
        let nc:i64 = (w + s - 1) / s;
        let nr:i64 = (h + s - 1) / s;
        let tot:i64 = 0;
        let mean:[]i64 = nio_alloc(24) as []i64;
        let e0a:[]i64 = nio_alloc(8) as []i64;
        let sub:[]u8 = nio_alloc((s * s * 6) as i32);
        let bi:i64 = 0;
        while (bi < nc * nr) {
            let bx:i64 = bi % nc;
            let by:i64 = bi / nc;
            let x0:i64 = bx * s;
            let y0:i64 = by * s;
            let bw:i64 = s;
            if (x0 + bw > w) { bw = w - x0; }
            let bh:i64 = s;
            if (y0 + bh > h) { bh = h - y0; }
            tl_patch16(px, w, x0, y0, bw, bh, mean, sub, e0a);
            tot = tot + e0a[0];
            bi = bi + 1;
        }
        out[si] = tot;
        nio_free(mean);
        nio_free(e0a);
        nio_free(sub);
        si = si + 1;
    }
}

// ---------------- luminance of i64 image ----------------
fn tl_luminance(px:[]i64, npix:i64, lum:[]i64) void {
    let i:i64 = 0;
    while (i < npix) {
        lum[i] = (299 * px[i * 3] + 587 * px[i * 3 + 1] + 114 * px[i * 3 + 2]) / 1000;
        i = i + 1;
    }
}

// ---------------- Sobel + direction-quantized greedy walks ----------------
// Shared by the SURVEY (run-length histogram: how much of the image is
// long straight boundaries vs curves) and the LINES layer (the actual
// straight-segment mechanism under test for the pentagon question).
//
// lum: npix i64 luminance. magT: strong-edge threshold (per-value-9
// precedent: 3*9=27). Walks step through 8-connected strong pixels sharing
// one of 4 direction bins; continuation prefers the straightest neighbor
// (dot-product with travel direction), ties -> lowest neighbor index;
// walk starts in row-major order. Fully deterministic.
// rec=1: record walks with length>=minrun into ex0/ey0/ex1/ey1/elen
// (up to cap). Always: hist[0..63] run-length histogram over ALL runs,
// edgepx[0] = strong-pixel count. Returns walks recorded.
fn tl_walks(lum:[]i64, w:i64, h:i64, magT:i64, minrun:i64, rec:i64,
    ex0:[]i64, ey0:[]i64, ex1:[]i64, ey1:[]i64, elen:[]i64, cap:i64,
    hist:[]i64, edgepx:[]i64) i64 {
    let npix:i64 = w * h;
    let strong:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    let bin:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    let claimed:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    if (strong.len == 0) { return -1; }
    let hi:i64 = 0;
    while (hi < 64) { hist[hi] = 0; hi = hi + 1; }
    edgepx[0] = 0;
    let y:i64 = 1;
    while (y < h - 1) {
        let x:i64 = 1;
        while (x < w - 1) {
            let c:i64 = y * w + x;
            let gx:i64 = (lum[c - w + 1] - lum[c - w - 1])
                + 2 * (lum[c + 1] - lum[c - 1])
                + (lum[c + w + 1] - lum[c + w - 1]);
            let gy:i64 = (lum[c + w - 1] - lum[c - w - 1])
                + 2 * (lum[c + w] - lum[c - w])
                + (lum[c + w + 1] - lum[c - w + 1]);
            let agx:i64 = gx;
            if (agx < 0) { agx = 0 - agx; }
            let agy:i64 = gy;
            if (agy < 0) { agy = 0 - agy; }
            if (agx + agy >= magT) {
                strong[c] = 1;
                edgepx[0] = edgepx[0] + 1;
                let b:i64 = 0;
                if (agx >= agy) {
                    if (gy >= 0) { b = 0; } else { b = 1; }
                } else {
                    if (gx >= 0) { b = 2; } else { b = 3; }
                }
                bin[c] = b;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    // 8-neighborhood, fixed order: E SE S SW W NW N NE
    let ndx:[]i64 = nio_alloc(64) as []i64;
    let ndy:[]i64 = nio_alloc(64) as []i64;
    ndx[0] = 1; ndy[0] = 0;
    ndx[1] = 1; ndy[1] = 1;
    ndx[2] = 0; ndy[2] = 1;
    ndx[3] = -1; ndy[3] = 1;
    ndx[4] = -1; ndy[4] = 0;
    ndx[5] = -1; ndy[5] = -1;
    ndx[6] = 0; ndy[6] = -1;
    ndx[7] = 1; ndy[7] = -1;
    let WCAP:i64 = 16384;
    let wx:[]i64 = nio_alloc((WCAP * 8) as i32) as []i64;
    let wy:[]i64 = nio_alloc((WCAP * 8) as i32) as []i64;
    let bx:[]i64 = nio_alloc((WCAP * 8) as i32) as []i64;
    let by:[]i64 = nio_alloc((WCAP * 8) as i32) as []i64;
    if (wx.len == 0) { return -1; }
    let nrec:i64 = 0;
    let sy:i64 = 0;
    while (sy < h) {
        let sx:i64 = 0;
        while (sx < w) {
            let sp:i64 = sy * w + sx;
            if (strong[sp] == 1) {
                if (claimed[sp] == 0) {
                    let cb:i64 = bin[sp];
                    claimed[sp] = 1;
                    wx[0] = sx; wy[0] = sy;
                    let nf:i64 = 1;
                    // forward extension
                    let cx:i64 = sx; let cy:i64 = sy;
                    let tdx:i64 = 0; let tdy:i64 = 0;
                    let first:i64 = 1;
                    let ext:i64 = 1;
                    while (ext == 1) {
                        let best:i64 = -1;
                        let bestscore:i64 = -3;
                        let bestk:i64 = 99;
                        let k:i64 = 0;
                        while (k < 8) {
                            let nx:i64 = cx + ndx[k];
                            let ny:i64 = cy + ndy[k];
                            if (nx >= 0) {
                                if (nx < w) {
                                    if (ny >= 0) {
                                        if (ny < h) {
                                            let np:i64 = ny * w + nx;
                                            if (strong[np] == 1) {
                                                if (claimed[np] == 0) {
                                                    if (bin[np] == cb) {
                                                        let score:i64 = 0;
                                                        if (first == 0) {
                                                            score = ndx[k] * tdx + ndy[k] * tdy;
                                                        }
                                                        if (best == -1) {
                                                            best = k; bestscore = score; bestk = k;
                                                        } else {
                                                            if (score > bestscore) {
                                                                best = k; bestscore = score; bestk = k;
                                                            } else {
                                                                if (score == bestscore) {
                                                                    if (k < bestk) {
                                                                        best = k; bestscore = score; bestk = k;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            k = k + 1;
                        }
                        if (best >= 0) {
                            cx = cx + ndx[best];
                            cy = cy + ndy[best];
                            claimed[cy * w + cx] = 1;
                            if (nf < WCAP) {
                                wx[nf] = cx; wy[nf] = cy;
                                nf = nf + 1;
                            }
                            tdx = ndx[best]; tdy = ndy[best];
                            first = 0;
                        } else {
                            ext = 0;
                        }
                    }
                    // backward extension from the start pixel
                    let nbx:i64 = 0;
                    cx = sx; cy = sy;
                    tdx = 0; tdy = 0;
                    first = 1;
                    ext = 1;
                    while (ext == 1) {
                        let best2:i64 = -1;
                        let bestscore2:i64 = -3;
                        let bestk2:i64 = 99;
                        let k2:i64 = 0;
                        while (k2 < 8) {
                            let nx2:i64 = cx + ndx[k2];
                            let ny2:i64 = cy + ndy[k2];
                            if (nx2 >= 0) {
                                if (nx2 < w) {
                                    if (ny2 >= 0) {
                                        if (ny2 < h) {
                                            let np2:i64 = ny2 * w + nx2;
                                            if (strong[np2] == 1) {
                                                if (claimed[np2] == 0) {
                                                    if (bin[np2] == cb) {
                                                        let score2:i64 = 0;
                                                        if (first == 0) {
                                                            score2 = ndx[k2] * tdx + ndy[k2] * tdy;
                                                        }
                                                        if (best2 == -1) {
                                                            best2 = k2; bestscore2 = score2; bestk2 = k2;
                                                        } else {
                                                            if (score2 > bestscore2) {
                                                                best2 = k2; bestscore2 = score2; bestk2 = k2;
                                                            } else {
                                                                if (score2 == bestscore2) {
                                                                    if (k2 < bestk2) {
                                                                        best2 = k2; bestscore2 = score2; bestk2 = k2;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            k2 = k2 + 1;
                        }
                        if (best2 >= 0) {
                            cx = cx + ndx[best2];
                            cy = cy + ndy[best2];
                            claimed[cy * w + cx] = 1;
                            if (nbx < WCAP) {
                                bx[nbx] = cx; by[nbx] = cy;
                                nbx = nbx + 1;
                            }
                            tdx = ndx[best2]; tdy = ndy[best2];
                            first = 0;
                        } else {
                            ext = 0;
                        }
                    }
                    let L:i64 = nf + nbx;
                    let hb:i64 = L;
                    if (hb > 63) { hb = 63; }
                    hist[hb] = hist[hb] + 1;
                    if (L >= minrun) {
                        if (rec == 1) {
                            if (nrec < cap) {
                                // endpoints: far end of backward part, far end of forward part
                                let fx0:i64 = sx; let fy0:i64 = sy;
                                if (nbx > 0) {
                                    fx0 = bx[nbx - 1]; fy0 = by[nbx - 1];
                                }
                                ex0[nrec] = fx0; ey0[nrec] = fy0;
                                ex1[nrec] = wx[nf - 1]; ey1[nrec] = wy[nf - 1];
                                elen[nrec] = L;
                                nrec = nrec + 1;
                            }
                        }
                    }
                }
            }
            sx = sx + 1;
        }
        sy = sy + 1;
    }
    nio_free(strong);
    nio_free(bin);
    nio_free(claimed);
    nio_free(ndx);
    nio_free(ndy);
    nio_free(wx);
    nio_free(wy);
    nio_free(bx);
    nio_free(by);
    return nrec;
}

// ---------------- SMOOTH: content-adaptive quadtree, mean + planar leaf ----------------
// TNN's coarse-content organization: a node splits at its midpoint iff the
// split explains >= 9 per value (27*bw*bh total) — the same precision
// precedent as the shape taus. Min leaf 4x4. Each leaf stores mean +
// least-squares planar gradient per channel (centered coords decouple the
// normal equations exactly: a = Σuxz/Σux² etc.). Gradients stored as i16
// fixed-point x256, clamped. Leaf record: 26 bytes
// (x,y,w,h u16 + mean i16x3 + grad i16x6).

// node mean + SSD in i64 space
fn tl_node_stats(px:[]i64, w:i64, x0:i64, y0:i64, bw:i64, bh:i64,
    mean:[]i64, e0:[]i64) void {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
    let yy:i64 = 0;
    while (yy < bh) {
        let xx:i64 = 0;
        while (xx < bw) {
            let p:i64 = ((y0 + yy) * w + (x0 + xx)) * 3;
            sr = sr + px[p]; sg = sg + px[p + 1]; sb = sb + px[p + 2];
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    let n:i64 = bw * bh;
    mean[0] = sr / n; mean[1] = sg / n; mean[2] = sb / n;
    let e:i64 = 0;
    yy = 0;
    while (yy < bh) {
        let xx2:i64 = 0;
        while (xx2 < bw) {
            let p2:i64 = ((y0 + yy) * w + (x0 + xx2)) * 3;
            let d0:i64 = px[p2] - mean[0];
            let d1:i64 = px[p2 + 1] - mean[1];
            let d2:i64 = px[p2 + 2] - mean[2];
            e = e + d0 * d0 + d1 * d1 + d2 * d2;
            xx2 = xx2 + 1;
        }
        yy = yy + 1;
    }
    e0[0] = e;
}

// least-squares planar fit per channel; grad[0..5] = (ax,ay,bx,by,cx,cy)
// fixed-point x256, clamped to i16.
fn tl_planar(px:[]i64, w:i64, x0:i64, y0:i64, bw:i64, bh:i64,
    mean:[]i64, grad:[]i64) void {
    let ox:i64 = (bw - 1) / 2;
    let oy:i64 = (bh - 1) / 2;
    let sxx:i64 = 0; let syy:i64 = 0;
    let sxzr:i64 = 0; let syzr:i64 = 0;
    let sxzg:i64 = 0; let syzg:i64 = 0;
    let sxzb:i64 = 0; let syzb:i64 = 0;
    let ly:i64 = 0;
    while (ly < bh) {
        let uy:i64 = ly - oy;
        syy = syy + uy * uy * bw;
        let lx:i64 = 0;
        while (lx < bw) {
            let ux:i64 = lx - ox;
            if (ly == 0) { sxx = sxx + ux * ux * bh; }
            let p:i64 = ((y0 + ly) * w + (x0 + lx)) * 3;
            let zr:i64 = px[p] - mean[0];
            let zg:i64 = px[p + 1] - mean[1];
            let zb:i64 = px[p + 2] - mean[2];
            sxzr = sxzr + ux * zr; syzr = syzr + uy * zr;
            sxzg = sxzg + ux * zg; syzg = syzg + uy * zg;
            sxzb = sxzb + ux * zb; syzb = syzb + uy * zb;
            lx = lx + 1;
        }
        ly = ly + 1;
    }
    // sxx/syy > 0 whenever bw,bh >= 2 (ux not all zero)
    let ax:i64 = 0; let ay:i64 = 0;
    let bx2:i64 = 0; let by2:i64 = 0;
    let cx2:i64 = 0; let cy2:i64 = 0;
    if (sxx > 0) {
        ax = (sxzr * 256) / sxx;
        bx2 = (sxzg * 256) / sxx;
        cx2 = (sxzb * 256) / sxx;
    }
    if (syy > 0) {
        ay = (syzr * 256) / syy;
        by2 = (syzg * 256) / syy;
        cy2 = (syzb * 256) / syy;
    }
    if (ax > 32767) { ax = 32767; }
    if (ax < -32768) { ax = -32768; }
    if (ay > 32767) { ay = 32767; }
    if (ay < -32768) { ay = -32768; }
    if (bx2 > 32767) { bx2 = 32767; }
    if (bx2 < -32768) { bx2 = -32768; }
    if (by2 > 32767) { by2 = 32767; }
    if (by2 < -32768) { by2 = -32768; }
    if (cx2 > 32767) { cx2 = 32767; }
    if (cx2 < -32768) { cx2 = -32768; }
    if (cy2 > 32767) { cy2 = 32767; }
    if (cy2 < -32768) { cy2 = -32768; }
    grad[0] = ax; grad[1] = ay;
    grad[2] = bx2; grad[3] = by2;
    grad[4] = cx2; grad[5] = cy2;
}

// recursive SMOOTH partition — content-adaptive binary CART cuts.
// The fixed-midpoint quadtree put boundaries at dyadic positions
// regardless of content; this version evaluates EVERY valid binary cut
// position on the current residual and takes the one that minimizes
// E_flat(child1)+E_flat(child2) (tl_cart_cut). The split-vs-leaf bar is
// parent 1's per-value-9 rule on the measured flat gain, unchanged:
// split iff (e0 - ecut) >= 27*bw*bh, where ecut is the CART-optimal
// two-piece energy. An axis shorter than 8 px cannot host a valid cut
// (4 px floor on each side) and its branch stops. Leaf form is parent
// 1's (mean + planar gradients, i16-clamped). Each split is written to
// the deliberation ledger: position, axis, and measured gain.
fn tl_smooth_recurse_ad(px:[]i64, w:i64, x0:i64, y0:i64, bw:i64, bh:i64,
    lx:[]i64, ly:[]i64, lw:[]i64, lh:[]i64, lm:[]i64, lg:[]i64,
    nleaf:[]i64, cap:i64, nsplit:[]i64, led:[]u8, lo:i64) i64 {
    let mean:[]i64 = nio_alloc(24) as []i64;
    let e0a:[]i64 = nio_alloc(8) as []i64;
    if (mean.len == 0) { return lo; }
    if (e0a.len == 0) { nio_free(mean); return lo; }
    tl_node_stats(px, w, x0, y0, bw, bh, mean, e0a);
    let e0:i64 = e0a[0];
    let did_split:i64 = 0;
    let o:i64 = lo;
    let cut:[]i64 = nio_alloc(64) as []i64;
    if (cut.len == 0) { nio_free(mean); nio_free(e0a); return o; }
    tl_cart_cut(px, w, x0, y0, bw, bh, cut);
    let ax:i64 = cut[0];
    let cpos:i64 = cut[1];
    let ecut:i64 = cut[3];
    nio_free(cut);
    // energy-reducing CART cut AND the gain clears the per-value-9 bar
    if (ax >= 0) {
        if ((e0 - ecut) >= 27 * bw * bh) {
            did_split = 1;
            nsplit[0] = nsplit[0] + 1;
            o = tr_puts(led, o, "SPLIT ");
            o = tr_puti(led, o, x0); o = tr_puts(led, o, ",");
            o = tr_puti(led, o, y0); o = tr_puts(led, o, " ");
            o = tr_puti(led, o, bw); o = tr_puts(led, o, "x");
            o = tr_puti(led, o, bh);
            if (ax == 0) { o = tr_puts(led, o, " V@"); }
            else { o = tr_puts(led, o, " H@"); }
            o = tr_puti(led, o, cpos);
            o = tr_puts(led, o, " e0=");
            o = tr_puti(led, o, e0);
            o = tr_puts(led, o, " ecut=");
            o = tr_puti(led, o, ecut);
            o = tr_puts(led, o, " gain/v=");
            o = tr_puti(led, o, (e0 - ecut) / (bw * bh));
            o = tr_puts(led, o, "\n");
                        if (ax == 0) {
                o = tl_smooth_recurse_ad(px, w, x0, y0, cpos, bh,
                    lx, ly, lw, lh, lm, lg, nleaf, cap, nsplit, led, o);
                o = tl_smooth_recurse_ad(px, w, x0 + cpos, y0, bw - cpos, bh,
                    lx, ly, lw, lh, lm, lg, nleaf, cap, nsplit, led, o);
            } else {
                o = tl_smooth_recurse_ad(px, w, x0, y0, bw, cpos,
                    lx, ly, lw, lh, lm, lg, nleaf, cap, nsplit, led, o);
                o = tl_smooth_recurse_ad(px, w, x0, y0 + cpos, bw, bh - cpos,
                    lx, ly, lw, lh, lm, lg, nleaf, cap, nsplit, led, o);
            }
        }
    }
    if (did_split == 0) {
        if (nleaf[0] < cap) {
            let li:i64 = nleaf[0];
            let grad:[]i64 = nio_alloc(48) as []i64;
            if (grad.len != 0) {
                tl_planar(px, w, x0, y0, bw, bh, mean, grad);
                lx[li] = x0; ly[li] = y0; lw[li] = bw; lh[li] = bh;
                let m0:i64 = mean[0];
                if (m0 > 32767) { m0 = 32767; }
                if (m0 < -32768) { m0 = -32768; }
                let m1:i64 = mean[1];
                if (m1 > 32767) { m1 = 32767; }
                if (m1 < -32768) { m1 = -32768; }
                let m2b:i64 = mean[2];
                if (m2b > 32767) { m2b = 32767; }
                if (m2b < -32768) { m2b = -32768; }
                lm[li * 3] = m0; lm[li * 3 + 1] = m1; lm[li * 3 + 2] = m2b;
                let gi:i64 = 0;
                while (gi < 6) { lg[li * 6 + gi] = grad[gi]; gi = gi + 1; }
                nleaf[0] = li + 1;
                nio_free(grad);
            }
        }
    }
    nio_free(mean);
    nio_free(e0a);
    return o;
}

// build the SMOOTH layer on px: adaptive CART partition -> tmp.
// G[0]/N[0]; nsplit[0] counts the CART splits for the trace.

// render SMOOTH leaves into acc (i64 accumulator, +=).
// Shared by ingest path A and emit path B: identical arithmetic.
fn tl_smooth_render(acc:[]i64, w:i64,
    lx:[]i64, ly:[]i64, lw:[]i64, lh:[]i64, lm:[]i64, lg:[]i64,
    nleaf:i64) void {
    let li:i64 = 0;
    while (li < nleaf) {
        let x0:i64 = lx[li]; let y0:i64 = ly[li];
        let bw:i64 = lw[li]; let bh:i64 = lh[li];
        let ox:i64 = (bw - 1) / 2;
        let oy:i64 = (bh - 1) / 2;
        let m0:i64 = lm[li * 3]; let m1:i64 = lm[li * 3 + 1]; let m2:i64 = lm[li * 3 + 2];
        let ax:i64 = lg[li * 6]; let ay:i64 = lg[li * 6 + 1];
        let bx:i64 = lg[li * 6 + 2]; let by:i64 = lg[li * 6 + 3];
        let cx:i64 = lg[li * 6 + 4]; let cy:i64 = lg[li * 6 + 5];
        let yy:i64 = 0;
        while (yy < bh) {
            let uy:i64 = yy - oy;
            let xx:i64 = 0;
            while (xx < bw) {
                let ux:i64 = xx - ox;
                let p:i64 = ((y0 + yy) * w + (x0 + xx)) * 3;
                acc[p] = acc[p] + m0 + (ax * ux + ay * uy) / 256;
                acc[p + 1] = acc[p + 1] + m1 + (bx * ux + by * uy) / 256;
                acc[p + 2] = acc[p + 2] + m2 + (cx * ux + cy * uy) / 256;
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        li = li + 1;
    }
}

// build the SMOOTH layer on px: leaves -> tmp. out G[0],N[0] via stats.
fn tl_smooth_build_ad(px:[]i64, w:i64, h:i64, tmp:[]i64,
    lx:[]i64, ly:[]i64, lw:[]i64, lh:[]i64, lm:[]i64, lg:[]i64,
    nleaf:[]i64, cap:i64, G:[]i64, N:[]i64, nsplit:[]i64,
    led:[]u8, lo:i64) i64 {
    nleaf[0] = 0;
    nsplit[0] = 0;
    let o:i64 = tl_smooth_recurse_ad(px, w, 0, 0, w, h,
        lx, ly, lw, lh, lm, lg, nleaf, cap, nsplit, led, lo);
    tl_smooth_render(tmp, w, lx, ly, lw, lh, lm, lg, nleaf[0]);
    let npix:i64 = w * h;
    let g:i64 = 0;
    let i:i64 = 0;
    while (i < npix * 3) {
        let b:i64 = px[i];
        let a:i64 = px[i] - tmp[i];
        g = g + b * b - a * a;
        i = i + 1;
    }
    G[0] = g;
    N[0] = npix * 3;
    return o;
}

// ---------------- LINES: straight-boundary segments from walks ----------------
// The pentagon-artifact mechanism, kept honest: Sobel on the residual's
// luminance, direction-quantized greedy walks (tl_walks), each walk fit as
// ONE straight segment (its endpoints) painted along the Bresenham chord
// with the walk's mean residual color. A smooth curve's chord cuts across
// the walk, so curved walks explain little and face TNN's per-segment bar:
// a segment is emitted only if its own g/n >= 9 (per-value-9 precedent).
// TNN then applies the layer-level bar to the kept set. Segment record:
// 14 bytes (x0,y0,x1,y1 u16 + mean dr,dg,db i16).

// Bresenham chord pixel list. Returns count (<= cap).
fn tl_bres_list(x0:i64, y0:i64, x1:i64, y1:i64,
    ox:[]i64, oy:[]i64, cap:i64) i64 {
    let dx:i64 = x1 - x0;
    if (dx < 0) { dx = 0 - dx; }
    let dy:i64 = y1 - y0;
    if (dy < 0) { dy = 0 - dy; }
    let sx:i64 = 1;
    if (x0 > x1) { sx = -1; }
    let sy:i64 = 1;
    if (y0 > y1) { sy = -1; }
    let err:i64 = dx - dy;
    let cx:i64 = x0; let cy:i64 = y0;
    let n:i64 = 0;
    let go:i64 = 1;
    while (go == 1) {
        if (n < cap) { ox[n] = cx; oy[n] = cy; n = n + 1; }
        if (cx == x1) {
            if (cy == y1) { go = 0; }
        }
        if (go == 1) {
            let e2:i64 = 2 * err;
            if (e2 > 0 - dy) { err = err - dy; cx = cx + sx; }
            if (e2 < dx) { err = err + dx; cy = cy + sy; }
        }
    }
    return n;
}

// paint one chord into acc, skipping already-painted pixels (persistent
// painted[]). Shared by build path and emit path B: identical arithmetic.
fn tl_chord_paint(acc:[]i64, w:i64, h:i64,
    x0:i64, y0:i64, x1:i64, y1:i64,
    m0:i64, m1:i64, m2:i64, painted:[]i64) i64 {
    let cx:[]i64 = nio_alloc((2048 * 8) as i32) as []i64;
    let cy:[]i64 = nio_alloc((2048 * 8) as i32) as []i64;
    let n:i64 = tl_bres_list(x0, y0, x1, y1, cx, cy, 2048);
    let cnt:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let xx:i64 = cx[i]; let yy:i64 = cy[i];
        if (xx >= 0) {
            if (xx < w) {
                if (yy >= 0) {
                    if (yy < h) {
                        let p:i64 = yy * w + xx;
                        if (painted[p] == 0) {
                            painted[p] = 1;
                            let q:i64 = p * 3;
                            acc[q] = acc[q] + m0;
                            acc[q + 1] = acc[q + 1] + m1;
                            acc[q + 2] = acc[q + 2] + m2;
                            cnt = cnt + 1;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    nio_free(cx);
    nio_free(cy);
    return cnt;
}

// clamp to i16 range
fn cl16(v:i64) i64 {
    if (v > 32767) { return 32767; }
    if (v < -32768) { return -32768; }
    return v;
}

// build the LINES layer on px (lum = its luminance): walks -> segments ->
// tmp. Records kept segments. G[0]/N[0] over kept segments; ndropped[0] =
// walks dropped by the per-segment bar or fully covered.
fn tl_lines_build(px:[]i64, lum:[]i64, w:i64, h:i64, tmp:[]i64,
    sx0:[]i64, sy0:[]i64, sx1:[]i64, sy1:[]i64, sm:[]i64,
    nseg:[]i64, cap:i64,
    G:[]i64, N:[]i64, ndropped:[]i64) i64 {
    let npix:i64 = w * h;
    let wcap:i64 = 4096;
    let ex0:[]i64 = nio_alloc((wcap * 8) as i32) as []i64;
    let ey0:[]i64 = nio_alloc((wcap * 8) as i32) as []i64;
    let ex1:[]i64 = nio_alloc((wcap * 8) as i32) as []i64;
    let ey1:[]i64 = nio_alloc((wcap * 8) as i32) as []i64;
    let elen:[]i64 = nio_alloc((wcap * 8) as i32) as []i64;
    let hist:[]i64 = nio_alloc(512) as []i64;
    let edgepx:[]i64 = nio_alloc(8) as []i64;
    if (ex0.len == 0) { return -1; }
    let nwalks:i64 = tl_walks(lum, w, h, 27, 4, 1,
        ex0, ey0, ex1, ey1, elen, wcap, hist, edgepx);
    if (nwalks < 0) { return -1; }
    let claimed:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    if (claimed.len == 0) { return -1; }
    let qi:i64 = 0;
    while (qi < npix) { claimed[qi] = 0; qi = qi + 1; }
    let chx:[]i64 = nio_alloc((2048 * 8) as i32) as []i64;
    let chy:[]i64 = nio_alloc((2048 * 8) as i32) as []i64;
    nseg[0] = 0;
    ndropped[0] = 0;
    let Gv:i64 = 0;
    let Nv:i64 = 0;
    let wi:i64 = 0;
    while (wi < nwalks) {
        let nch:i64 = tl_bres_list(ex0[wi], ey0[wi], ex1[wi], ey1[wi], chx, chy, 2048);
        // gather unclaimed chord pixels; segment color = their mean
        let u:i64 = 0;
        let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
        let ci:i64 = 0;
        while (ci < nch) {
            let xx:i64 = chx[ci]; let yy:i64 = chy[ci];
            if (xx >= 0) {
                if (xx < w) {
                    if (yy >= 0) {
                        if (yy < h) {
                            let p:i64 = yy * w + xx;
                            if (claimed[p] == 0) {
                                let q:i64 = p * 3;
                                sr = sr + px[q];
                                sg = sg + px[q + 1];
                                sb = sb + px[q + 2];
                                u = u + 1;
                            }
                        }
                    }
                }
            }
            ci = ci + 1;
        }
        if (u == 0) {
            ndropped[0] = ndropped[0] + 1;
        } else {
            let m0:i64 = cl16(sr / u);
            let m1:i64 = cl16(sg / u);
            let m2:i64 = cl16(sb / u);
            // causal gain of painting this chord with this color
            let gs:i64 = 0;
            ci = 0;
            while (ci < nch) {
                let xx2:i64 = chx[ci]; let yy2:i64 = chy[ci];
                if (xx2 >= 0) {
                    if (xx2 < w) {
                        if (yy2 >= 0) {
                            if (yy2 < h) {
                                let p2:i64 = yy2 * w + xx2;
                                if (claimed[p2] == 0) {
                                    let q2:i64 = p2 * 3;
                                    let v0:i64 = px[q2]; let v1:i64 = px[q2 + 1]; let v2:i64 = px[q2 + 2];
                                    gs = gs + (2 * v0 * m0 - m0 * m0)
                                        + (2 * v1 * m1 - m1 * m1)
                                        + (2 * v2 * m2 - m2 * m2);
                                }
                            }
                        }
                    }
                }
                ci = ci + 1;
            }
            let ns:i64 = 3 * u;
            if (gs >= 9 * ns) {
                if (nseg[0] < cap) {
                    let sg2:i64 = nseg[0];
                    sx0[sg2] = ex0[wi]; sy0[sg2] = ey0[wi];
                    sx1[sg2] = ex1[wi]; sy1[sg2] = ey1[wi];
                    sm[sg2 * 3] = m0; sm[sg2 * 3 + 1] = m1; sm[sg2 * 3 + 2] = m2;
                    nseg[0] = sg2 + 1;
                    tl_chord_paint(tmp, w, h, ex0[wi], ey0[wi], ex1[wi], ey1[wi],
                        m0, m1, m2, claimed);
                    Gv = Gv + gs;
                    Nv = Nv + ns;
                }
            } else {
                ndropped[0] = ndropped[0] + 1;
            }
        }
        wi = wi + 1;
    }
    G[0] = Gv;
    N[0] = Nv;
    nio_free(ex0); nio_free(ey0); nio_free(ex1); nio_free(ey1);
    nio_free(elen); nio_free(hist); nio_free(edgepx);
    nio_free(claimed); nio_free(chx); nio_free(chy);
    return nwalks;
}

// render LINES segments into acc (emit path B / shared).
fn tl_lines_render(acc:[]i64, w:i64, h:i64,
    sx0:[]i64, sy0:[]i64, sx1:[]i64, sy1:[]i64, sm:[]i64,
    nseg:i64) void {
    let npix:i64 = w * h;
    let painted:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    let qi:i64 = 0;
    while (qi < npix) { painted[qi] = 0; qi = qi + 1; }
    let i:i64 = 0;
    while (i < nseg) {
        tl_chord_paint(acc, w, h, sx0[i], sy0[i], sx1[i], sy1[i],
            sm[i * 3], sm[i * 3 + 1], sm[i * 3 + 2], painted);
        i = i + 1;
    }
    nio_free(painted);
}

// ---------------- SHAPES: multi-scale exemplar-patch vocabulary ----------------
// The no-layers mechanism, generalized to i64 residual space: one
// farthest-point vocabulary per scale (NULL atom 0 = flat), then the
// take-or-split deliberation (gain-per-byte, ties -> take, floor at the
// finest chosen scale). Region record: 13 bytes
// (x,y u16 + s u8 + atom u16 + mean dr,dg,db i16).
// TNN chooses the scale set from a repetition probe on the CURRENT
// residual: rep>=250 per-mille -> {64,32,16,8,4}; rep>=100 ->
// {32,16,8,4}; else -> {64,32,16}. (Recorded with the probe numbers.)

// ---------------- SHAPES-ZOOM: adaptive partition + adaptive magnification ----------------
// Parent 1 tied the partition to the vocabulary: a fixed dyadic quadtree of
// s×s blocks, each block taking one atom. Parent 2 freed the partition
// (content-adaptive CART cuts) but had no layers and no magnification.
// This fork combines both, with the magnifying-glass policy:
//
//   Phase 1 (coarsest sufficient scale): partition the residual with CART
//   cuts (content-adaptive positions, parent-2's energy rule). A rectangle
//   larger than one atom footprint MUST subdivide — a TAKE is one atom,
//   never an aggregate. Atom-sized rectangles deliberate take-vs-split by
//   measured gain-per-byte.
//
//   Phase 2 (vocabulary): at each scale, the vocabulary is built ONLY from
//   the full s×s blocks inside the regions that actually reach that scale
//   (farthest-point exemplars, parent-1's tau rule). A scale no region
//   needs gets no vocabulary.
//
//   Phase 3 (magnification): a region assigned at scale s is a candidate
//   for s/2 iff its post-atom residual energy still exceeds the
//   per-value-9 evidence rule (ea > 9*3*n). The candidate is
//   re-partitioned at s/2; the finer assignment replaces the coarser one
//   iff it wins on measured gain-per-byte AND beats the flat baseline.
//   Otherwise the coarser assignment stands — zoom only when the measured
//   residual demands it.
//
// The vocabulary stays scale-indexed (s×s atoms); a non-power-of-2 rect
// takes the best atom at its fit scale by matching the rect's top-left
// corner against the atom's top-left corner (the same partial-block rule
// parent 1 used for edge blocks). Partition geometry and atom scale are
// independent: the CART cut chooses WHERE the boundary goes, the scale
// chooses HOW FINE the description is.

// Evaluate a single TAKE of rect (x0,y0,bw,bh) at scale si: the best atom
// (top-left corner match; requires bw<=s and bh<=s) plus the rect's own
// mean. mout[0..2]=i16-clamped mean; ea_out=SSD after best atom;
// e0_out=SSD from the mean (flat); at_out=winning atom (0=NULL/flat).
fn tl_rect_take(px:[]i64, w:i64, x0:i64, y0:i64, bw:i64, bh:i64, si:i64,
    atoms:[]u8, na:i64,
    mout:[]i64, ea_out:[]i64, e0_out:[]i64, at_out:[]i64) void {
    let s:i64 = s_of(si);
    let mb:i64 = s * s * 3 * 2;
    let mean:[]i64 = nio_alloc(24) as []i64;
    let e0a:[]i64 = nio_alloc(8) as []i64;
    let sub:[]u8 = nio_alloc((bw * bh * 6) as i32);
    if (mean.len == 0) { return; }
    if (e0a.len == 0) { nio_free(mean); return; }
    if (sub.len == 0) { nio_free(mean); nio_free(e0a); return; }
    tl_patch16(px, w, x0, y0, bw, bh, mean, sub, e0a);
    let e0:i64 = e0a[0];
    let ea:i64 = e0;
    let bata:i64 = 0;
    let a:i64 = 1;
    while (a < na) {
        let abase:i64 = a * mb;
        let dd:i64 = 0;
        let iy:i64 = 0;
        while (iy < bh) {
            let ix:i64 = 0;
            while (ix < bw) {
                let q:i64 = (iy * bw + ix) * 6;
                let aq:i64 = abase + (iy * s + ix) * 6;
                let dv0:i64 = r_i16le(sub, q) - r_i16le(atoms, aq);
                let dv1:i64 = r_i16le(sub, q + 2) - r_i16le(atoms, aq + 2);
                let dv2:i64 = r_i16le(sub, q + 4) - r_i16le(atoms, aq + 4);
                dd = dd + dv0 * dv0 + dv1 * dv1 + dv2 * dv2;
                ix = ix + 1;
            }
            iy = iy + 1;
        }
        if (dd < ea) { ea = dd; bata = a; }
        a = a + 1;
    }
    mout[0] = cl16(mean[0]); mout[1] = cl16(mean[1]); mout[2] = cl16(mean[2]);
    ea_out[0] = ea; e0_out[0] = e0; at_out[0] = bata;
    nio_free(mean); nio_free(e0a); nio_free(sub);
    return;
}

// append one taken rect to a pending list
fn tl_pend_append(dx:[]i64, dy:[]i64, dw:[]i64, dh:[]i64, dat:[]i64,
    dm:[]i64, dea:[]i64, de0:[]i64, nd:[]i64,
    x0:i64, y0:i64, bw:i64, bh:i64, at:i64,
    m0:i64, m1:i64, m2:i64, ea:i64, e0:i64) void {
    let i:i64 = nd[0];
    dx[i] = x0; dy[i] = y0; dw[i] = bw; dh[i] = bh; dat[i] = at;
    dm[i * 3] = m0; dm[i * 3 + 1] = m1; dm[i * 3 + 2] = m2;
    dea[i] = ea; de0[i] = e0;
    nd[0] = i + 1;
    return;
}

// CART + take-vs-split deliberation of ONE rect at a FIXED scale si.
// Taken rects are appended to the pending list (dx..de0).
//   - oversized (bw > s or bh > s): MUST subdivide via CART — a TAKE is one
//     atom and this rect is bigger than the atom footprint. Degenerate
//     unsplittable rects (thinner than 8 px on both axes, only possible at
//     s=4) tile into s×s blocks instead.
//   - atom-sized: deliberate take-vs-split by measured gain-per-byte,
//     (e0-ea)*cs vs (e0-es)*ca; split wins on strict >, take wins ties
//     (parent-2's rule). The split attempt is rolled back on take.
// ntake[si]/nsplit[si] count the decisions for the trace.
fn tl_deliberate_rect(px:[]i64, w:i64, h:i64, x0:i64, y0:i64, bw:i64, bh:i64,
    si:i64, atoms:[]u8, na:i64,
    dx:[]i64, dy:[]i64, dw:[]i64, dh:[]i64, dat:[]i64, dm:[]i64,
    dea:[]i64, de0:[]i64, nd:[]i64, dcap:i64,
    ntake:[]i64, nsplit:[]i64) void {
    let s:i64 = s_of(si);
    // safety: dcap is sized (16384) so the pending list never fills on a
    // 512×187 image (worst case ~6k rects); this guard never fires.
    if (nd[0] >= dcap - 1) { return; }
    // OVERSIZED: must subdivide before any take-vs-split is allowed
    if (bw > s || bh > s) {
        let cut:[]i64 = nio_alloc(64) as []i64;
        if (cut.len == 0) { return; }
        tl_cart_cut(px, w, x0, y0, bw, bh, cut);
        let ax:i64 = cut[0];
        let cpos:i64 = cut[1];
        nio_free(cut);
        if (ax >= 0) {
            nsplit[si] = nsplit[si] + 1;
            if (ax == 0) {
                tl_deliberate_rect(px, w, h, x0, y0, cpos, bh, si, atoms, na,
                    dx, dy, dw, dh, dat, dm, dea, de0, nd, dcap, ntake, nsplit);
                tl_deliberate_rect(px, w, h, x0 + cpos, y0, bw - cpos, bh, si, atoms, na,
                    dx, dy, dw, dh, dat, dm, dea, de0, nd, dcap, ntake, nsplit);
            } else {
                tl_deliberate_rect(px, w, h, x0, y0, bw, cpos, si, atoms, na,
                    dx, dy, dw, dh, dat, dm, dea, de0, nd, dcap, ntake, nsplit);
                tl_deliberate_rect(px, w, h, x0, y0 + cpos, bw, bh - cpos, si, atoms, na,
                    dx, dy, dw, dh, dat, dm, dea, de0, nd, dcap, ntake, nsplit);
            }
            return;
        }
        // degenerate: no valid CART cut (thinner than 8 px on both axes).
        // Tile into s×s blocks; each tile is atom-sized and deliberates.
        nsplit[si] = nsplit[si] + 1;
        let ntx:i64 = (bw + s - 1) / s;
        let nty:i64 = (bh + s - 1) / s;
        let ty:i64 = 0;
        while (ty < nty) {
            let tx:i64 = 0;
            while (tx < ntx) {
                let qx:i64 = x0 + tx * s;
                let qy:i64 = y0 + ty * s;
                let qw2:i64 = s;
                if (qx + qw2 > x0 + bw) { qw2 = x0 + bw - qx; }
                let qh2:i64 = s;
                if (qy + qh2 > y0 + bh) { qh2 = y0 + bh - qy; }
                tl_deliberate_rect(px, w, h, qx, qy, qw2, qh2, si, atoms, na,
                    dx, dy, dw, dh, dat, dm, dea, de0, nd, dcap, ntake, nsplit);
                tx = tx + 1;
            }
            ty = ty + 1;
        }
        return;
    }
    // ATOM-SIZED: deliberate take-vs-split by measured gain-per-byte
    let mout:[]i64 = nio_alloc(24) as []i64;
    let eao:[]i64 = nio_alloc(8) as []i64;
    let e0o:[]i64 = nio_alloc(8) as []i64;
    let ato:[]i64 = nio_alloc(8) as []i64;
    if (mout.len == 0) { return; }
    if (eao.len == 0) { nio_free(mout); return; }
    if (e0o.len == 0) { nio_free(mout); nio_free(eao); return; }
    if (ato.len == 0) { nio_free(mout); nio_free(eao); nio_free(e0o); return; }
    tl_rect_take(px, w, x0, y0, bw, bh, si, atoms, na, mout, eao, e0o, ato);
    let ea:i64 = eao[0];
    let e0:i64 = e0o[0];
    let ca:i64 = 13;
    // snapshot for rollback
    let nd0:i64 = nd[0];
    let tk0:i64 = ntake[0]; let tk1:i64 = ntake[1]; let tk2:i64 = ntake[2];
    let tk3:i64 = ntake[3]; let tk4:i64 = ntake[4];
    let sp0:i64 = nsplit[0]; let sp1:i64 = nsplit[1]; let sp2:i64 = nsplit[2];
    let sp3:i64 = nsplit[3]; let sp4:i64 = nsplit[4];
    // try the CART split
    let cut2:[]i64 = nio_alloc(64) as []i64;
    if (cut2.len == 0) {
        nio_free(mout); nio_free(eao); nio_free(e0o); nio_free(ato);
        return;
    }
    tl_cart_cut(px, w, x0, y0, bw, bh, cut2);
    let ax2:i64 = cut2[0];
    let cpos2:i64 = cut2[1];
    nio_free(cut2);
    let es:i64 = e0;
    let cs:i64 = 0;
    if (ax2 >= 0) {
        if (ax2 == 0) {
            tl_deliberate_rect(px, w, h, x0, y0, cpos2, bh, si, atoms, na,
                dx, dy, dw, dh, dat, dm, dea, de0, nd, dcap, ntake, nsplit);
            tl_deliberate_rect(px, w, h, x0 + cpos2, y0, bw - cpos2, bh, si, atoms, na,
                dx, dy, dw, dh, dat, dm, dea, de0, nd, dcap, ntake, nsplit);
        } else {
            tl_deliberate_rect(px, w, h, x0, y0, bw, cpos2, si, atoms, na,
                dx, dy, dw, dh, dat, dm, dea, de0, nd, dcap, ntake, nsplit);
            tl_deliberate_rect(px, w, h, x0, y0 + cpos2, bw, bh - cpos2, si, atoms, na,
                dx, dy, dw, dh, dat, dm, dea, de0, nd, dcap, ntake, nsplit);
        }
        es = 0;
        let ci:i64 = nd0;
        while (ci < nd[0]) { es = es + dea[ci]; ci = ci + 1; }
        cs = 13 * (nd[0] - nd0);
    }
    let gt:i64 = (e0 - ea) * cs;
    let gs:i64 = (e0 - es) * ca;
    if (ax2 >= 0 && gs > gt) {
        // SPLIT wins: keep the children (already appended)
        nsplit[si] = nsplit[si] + 1;
    } else {
        // TAKE wins (or no valid cut): rollback and take
        nd[0] = nd0;
        ntake[0] = tk0; ntake[1] = tk1; ntake[2] = tk2;
        ntake[3] = tk3; ntake[4] = tk4;
        nsplit[0] = sp0; nsplit[1] = sp1; nsplit[2] = sp2;
        nsplit[3] = sp3; nsplit[4] = sp4;
        tl_pend_append(dx, dy, dw, dh, dat, dm, dea, de0, nd,
            x0, y0, bw, bh, ato[0], mout[0], mout[1], mout[2], ea, e0);
        ntake[si] = ntake[si] + 1;
    }
    nio_free(mout); nio_free(eao); nio_free(e0o); nio_free(ato);
    return;
}

// Build the scale-si vocabulary from the full s×s blocks inside the given
// rects (the regions that reach this scale). Farthest-point exemplars with
// parent-1's tau_of(si) convergence bar. A scale with no full blocks gets
// the NULL atom only (na=1) — no vocabulary is invented without evidence.
fn tl_vocab_from_rects(px:[]i64, w:i64, h:i64, si:i64,
    qx:[]i64, qy:[]i64, qw:[]i64, qh:[]i64, nq:i64,
    atoms:[]u8, aex:[]i64, na_out:[]i64,
    gf_out:[]i64, gl_out:[]i64, nbl_out:[]i64) void {
    let s:i64 = s_of(si);
    let nv:i64 = s * s * 3;
    let mb:i64 = nv * 2;
    let nbl:i64 = 0;
    let qi:i64 = 0;
    while (qi < nq) {
        nbl = nbl + (qw[qi] / s) * (qh[qi] / s);
        qi = qi + 1;
    }
    nbl_out[0] = nbl;
    na_out[0] = 1;
    gf_out[0] = 0;
    gl_out[0] = 0;
    if (nbl == 0) { return; }
    let bx:[]i64 = nio_alloc((nbl * 8) as i32) as []i64;
    let by:[]i64 = nio_alloc((nbl * 8) as i32) as []i64;
    if (bx.len == 0) { return; }
    if (by.len == 0) { nio_free(bx); return; }
    let nbl2:i64 = 0;
    qi = 0;
    while (qi < nq) {
        let nbx:i64 = qw[qi] / s;
        let nby:i64 = qh[qi] / s;
        let byy:i64 = 0;
        while (byy < nby) {
            let bxx:i64 = 0;
            while (bxx < nbx) {
                bx[nbl2] = qx[qi] + bxx * s;
                by[nbl2] = qy[qi] + byy * s;
                nbl2 = nbl2 + 1;
                bxx = bxx + 1;
            }
            byy = byy + 1;
        }
        qi = qi + 1;
    }
    let bdet:[]u8 = nio_alloc((nbl * mb) as i32);
    let bval:[]i64 = nio_alloc((nbl * 8) as i32) as []i64;
    let mean:[]i64 = nio_alloc(24) as []i64;
    let e0a:[]i64 = nio_alloc(8) as []i64;
    if (bdet.len == 0) {
        nio_free(bx); nio_free(by);
        return;
    }
    if (bval.len == 0) {
        nio_free(bx); nio_free(by); nio_free(bdet);
        return;
    }
    if (mean.len == 0) {
        nio_free(bx); nio_free(by); nio_free(bdet); nio_free(bval);
        return;
    }
    if (e0a.len == 0) {
        nio_free(bx); nio_free(by); nio_free(bdet); nio_free(bval);
        nio_free(mean);
        return;
    }
    let bi:i64 = 0;
    while (bi < nbl) {
        tl_patch16(px, w, bx[bi], by[bi], s, s, mean,
            bdet[bi * mb..bi * mb + mb], e0a);
        bval[bi] = nv;
        bi = bi + 1;
    }
    let cand:[]i64 = nio_alloc((nbl * 8) as i32) as []i64;
    let agn:[]i64 = nio_alloc((nbl * 8) as i32) as []i64;
    let gains:[]i64 = nio_alloc(16) as []i64;
    if (cand.len == 0) {
        nio_free(bx); nio_free(by); nio_free(bdet); nio_free(bval);
        nio_free(mean); nio_free(e0a);
        return;
    }
    if (agn.len == 0) {
        nio_free(bx); nio_free(by); nio_free(bdet); nio_free(bval);
        nio_free(mean); nio_free(e0a); nio_free(cand);
        return;
    }
    if (gains.len == 0) {
        nio_free(bx); nio_free(by); nio_free(bdet); nio_free(bval);
        nio_free(mean); nio_free(e0a); nio_free(cand); nio_free(agn);
        return;
    }
    let ci:i64 = 0;
    while (ci < nbl) { cand[ci] = ci; ci = ci + 1; }
    let nan:i64 = fp_atoms(bdet, bval, s, nbl, cand, nbl,
        atoms, aex, agn, nbl, tau_of(si), gains);
    if (nan < 1) { nan = 1; }
    na_out[0] = nan;
    gf_out[0] = gains[1];
    gl_out[0] = gains[0];
    nio_free(bx); nio_free(by); nio_free(bdet); nio_free(bval);
    nio_free(mean); nio_free(e0a); nio_free(cand); nio_free(agn);
    nio_free(gains);
    return;
}

// SHAPES-ZOOM build: TNN's scale set (repetition probe, parent-1's rule)
// chooses [silo..sihi]. The coarsest scale gets a full CART partition of
// the residual; each scale's vocabulary is built only from the regions
// that reach it; regions zoom finer only when their post-atom residual
// energy earns it (per-value-9) and the finer assignment wins on measured
// gain-per-byte. Returns the new trace offset.

// render SHAPES regions into acc (shared ingest path A / emit path B).
fn tl_shapes_render(acc:[]i64, w:i64, h:i64,
    a0:[]u8, a1:[]u8, a2:[]u8, a3:[]u8, a4:[]u8,
    rx:[]i64, ry:[]i64, rw:[]i64, rh:[]i64, rs:[]i64, rat:[]i64, rm:[]i64,
    nreg:i64) void {
    let ri:i64 = 0;
    while (ri < nreg) {
        let x0:i64 = rx[ri];
        let y0:i64 = ry[ri];
        let s:i64 = rs[ri];
        let at:i64 = rat[ri];
        let atoms:[]u8 = a0;
        if (s == 32) { atoms = a1; }
        if (s == 16) { atoms = a2; }
        if (s == 8) { atoms = a3; }
        if (s == 4) { atoms = a4; }
        let mb:i64 = s * s * 3 * 2;
        let abase:i64 = at * mb;
        // arbitrary rectangle w/h (not s×s): render only rw×rh
        let bw:i64 = rw[ri];
        let bh:i64 = rh[ri];
        if (bw > s) { bw = s; }
        if (bh > s) { bh = s; }
        if (x0 + bw > w) { bw = w - x0; }
        if (y0 + bh > h) { bh = h - y0; }
        let m0:i64 = rm[ri * 3]; let m1:i64 = rm[ri * 3 + 1]; let m2:i64 = rm[ri * 3 + 2];
        let iy:i64 = 0;
        while (iy < bh) {
            let ix:i64 = 0;
            while (ix < bw) {
                let aq:i64 = abase + (iy * s + ix) * 6;
                let p:i64 = ((y0 + iy) * w + (x0 + ix)) * 3;
                acc[p] = acc[p] + m0 + r_i16le(atoms, aq);
                acc[p + 1] = acc[p + 1] + m1 + r_i16le(atoms, aq + 2);
                acc[p + 2] = acc[p + 2] + m2 + r_i16le(atoms, aq + 4);
                ix = ix + 1;
            }
            iy = iy + 1;
        }
        ri = ri + 1;
    }
}

// repetition probe: 8x8 mean-subtracted blocks; each block's best match
// among blocks with index%4==0; rep[0] = per-mille of blocks with a match
// under SSD 1728 (= 9*3*64, the per-value-9 precedent at 8x8).
fn tl_rep_probe(px:[]i64, w:i64, h:i64, rep:[]i64) void {
    let s:i64 = 8;
    let nc:i64 = w / s;
    let nr:i64 = h / s;
    let nb:i64 = nc * nr;
    let nv:i64 = s * s * 3;
    let mb:i64 = nv * 2;
    let bdet:[]u8 = nio_alloc((nb * mb) as i32);
    if (bdet.len == 0) { rep[0] = -1; return; }
    let mean:[]i64 = nio_alloc(24) as []i64;
    let e0a:[]i64 = nio_alloc(8) as []i64;
    let bi:i64 = 0;
    while (bi < nb) {
        let bx:i64 = bi % nc;
        let by:i64 = bi / nc;
        tl_patch16(px, w, bx * s, by * s, s, s, mean, bdet[bi * mb..bi * mb + mb], e0a);
        bi = bi + 1;
    }
    let cnt:i64 = 0;
    bi = 0;
    while (bi < nb) {
        let best:i64 = 999999999999;
        let bj:i64 = 0;
        while (bj < nb) {
            if (bj != bi) {
                if (bj % 4 == 0) {
                    let dd:i64 = 0;
                    let k:i64 = 0;
                    while (k < nv) {
                        let dv:i64 = r_i16le(bdet, bi * mb + k * 2) - r_i16le(bdet, bj * mb + k * 2);
                        dd = dd + dv * dv;
                        k = k + 1;
                    }
                    if (dd < best) { best = dd; }
                }
            }
            bj = bj + 1;
        }
        if (best < 1728) { cnt = cnt + 1; }
        bi = bi + 1;
    }
    rep[0] = (cnt * 1000) / nb;
    nio_free(bdet);
    nio_free(mean);
    nio_free(e0a);
}

// build the SHAPES layer on px: probe -> scale set -> vocab -> deliberate
// -> tmp. G[0]/N[0]; rep[0]/setlo[0]/sethi[0] report TNN's scale-set choice;
// gainfirst/gainlast per scale for the trace.
fn tl_shapeszoom_build(px:[]i64, w:i64, h:i64, tmp:[]i64,
    a0:[]u8, a1:[]u8, a2:[]u8, a3:[]u8, a4:[]u8,
    ex0:[]i64, ex1:[]i64, ex2:[]i64, ex3:[]i64, ex4:[]i64, na:[]i64,
    rx:[]i64, ry:[]i64, rw:[]i64, rh:[]i64, rs:[]i64, rat:[]i64, rm:[]i64,
    nreg:[]i64, ntake:[]i64, nsplit:[]i64, regcap:i64,
    G:[]i64, N:[]i64, rep:[]i64, setlo:[]i64, sethi:[]i64,
    gainfirst:[]i64, gainlast:[]i64,
    led:[]u8, lo:i64) i64 {
    tl_rep_probe(px, w, h, rep);
    let silo:i64 = 0;
    let sihi:i64 = 2;
    if (rep[0] >= 250) { silo = 0; sihi = 4; }
    if (rep[0] >= 100) {
        if (rep[0] < 250) { silo = 1; sihi = 4; }
    }
    setlo[0] = silo;
    sethi[0] = sihi;
    let o:i64 = lo;
    o = tr_puts(led, o, "SHAPES-ZOOM rep=");
    o = tr_puti(led, o, rep[0]);
    o = tr_puts(led, o, " scale-set {");
    o = tr_puti(led, o, s_of(silo));
    o = tr_puts(led, o, "..");
    o = tr_puti(led, o, s_of(sihi));
    o = tr_puts(led, o, "}\n");
    let tk:i64 = 0;
    while (tk < 5) {
        ntake[tk] = 0; nsplit[tk] = 0; na[tk] = 1;
        gainfirst[tk] = 0; gainlast[tk] = 0;
        tk = tk + 1;
    }
    nreg[0] = 0;
    // pending-list buffers: two banks of 10 parallel arrays (x,y,w,h,atom,
    // m0,m1,m2,ea,e0); the zoom cascade reads one bank and writes the other.
    let dcap:i64 = 16384;
    let ax0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let ay0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let aw0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let ah0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let aa0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let am0:[]i64 = nio_alloc((dcap * 24) as i32) as []i64;
    let ae0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let af0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let bx0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let by0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let bw0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let bh0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let ba0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let bm0:[]i64 = nio_alloc((dcap * 24) as i32) as []i64;
    let be0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let bf0:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    if (ax0.len == 0) { return o; }
    // scratch bank for one candidate's re-deliberation
    let scap:i64 = 2048;
    let sx0:[]i64 = nio_alloc((scap * 8) as i32) as []i64;
    let sy0:[]i64 = nio_alloc((scap * 8) as i32) as []i64;
    let sw0:[]i64 = nio_alloc((scap * 8) as i32) as []i64;
    let sh0:[]i64 = nio_alloc((scap * 8) as i32) as []i64;
    let sa0:[]i64 = nio_alloc((scap * 8) as i32) as []i64;
    let sm0:[]i64 = nio_alloc((scap * 24) as i32) as []i64;
    let se0:[]i64 = nio_alloc((scap * 8) as i32) as []i64;
    let sf0:[]i64 = nio_alloc((scap * 8) as i32) as []i64;
    // candidate rect extractor (x,y,w,h)
    let qx:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let qy:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let qw:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let qh:[]i64 = nio_alloc((dcap * 8) as i32) as []i64;
    let ndA:[]i64 = nio_alloc(8) as []i64;
    let ndB:[]i64 = nio_alloc(8) as []i64;
    let ndS:[]i64 = nio_alloc(8) as []i64;
    let nblo:[]i64 = nio_alloc(8) as []i64;
    if (ndA.len == 0) { return o; }
    ndA[0] = 0;
    ndB[0] = 0;
    // ---- Phase 0: vocabulary at the coarsest scale, over the whole image
    let atoms:[]u8 = a0;
    let aex:[]i64 = ex0;
    if (silo == 1) { atoms = a1; aex = ex1; }
    if (silo == 2) { atoms = a2; aex = ex2; }
    if (silo == 3) { atoms = a3; aex = ex3; }
    if (silo == 4) { atoms = a4; aex = ex4; }
    qx[0] = 0; qy[0] = 0; qw[0] = w; qh[0] = h;
    let gf0:[]i64 = nio_alloc(8) as []i64;
    let gl0:[]i64 = nio_alloc(8) as []i64;
    let nan0a:[]i64 = nio_alloc(8) as []i64;
    tl_vocab_from_rects(px, w, h, silo, qx, qy, qw, qh, 1,
        atoms, aex, nan0a, gf0, gl0, nblo);
    na[silo] = nan0a[0];
    nio_free(nan0a);
    gainfirst[silo] = gf0[0];
    gainlast[silo] = gl0[0];
    o = tr_puts(led, o, "vocab @");
    o = tr_puti(led, o, s_of(silo));
    o = tr_puts(led, o, ": ");
    o = tr_puti(led, o, na[silo]);
    o = tr_puts(led, o, " atoms from ");
    o = tr_puti(led, o, nblo[0]);
    o = tr_puts(led, o, " full blocks, gain ");
    o = tr_puti(led, o, gf0[0]);
    o = tr_puts(led, o, "..");
    o = tr_puti(led, o, gl0[0]);
    o = tr_puts(led, o, "\n");
    // re-select (na[silo] now set; atoms buffer unchanged)
    atoms = a0; aex = ex0;
    if (silo == 1) { atoms = a1; aex = ex1; }
    if (silo == 2) { atoms = a2; aex = ex2; }
    if (silo == 3) { atoms = a3; aex = ex3; }
    if (silo == 4) { atoms = a4; aex = ex4; }
    // ---- Phase 1: fixed s×s blocks at the coarsest scale (parent-1 style).
    // Each block takes its best atom; the zoom cascade (Phase 3) refines
    // high-residual blocks. No CART partition here — the "adaptive" in
    // Micah's order refers to the SMOOTH layer's CART splits, not SHAPES.
    let s_c:i64 = s_of(silo);
    let nbx:i64 = (w + s_c - 1) / s_c;
    let nby:i64 = (h + s_c - 1) / s_c;
    let fbm:[]i64 = nio_alloc(24) as []i64;
    let fbea:[]i64 = nio_alloc(8) as []i64;
    let fbe0:[]i64 = nio_alloc(8) as []i64;
    let fbat:[]i64 = nio_alloc(8) as []i64;
    if (fbm.len == 0) { return o; }
    ndA[0] = 0;
    let fby:i64 = 0;
    while (fby < nby) {
        let fbx:i64 = 0;
        while (fbx < nbx) {
            let fx0:i64 = fbx * s_c;
            let fy0:i64 = fby * s_c;
            let fbw:i64 = s_c;
            if (fx0 + fbw > w) { fbw = w - fx0; }
            let fbh:i64 = s_c;
            if (fy0 + fbh > h) { fbh = h - fy0; }
            tl_rect_take(px, w, fx0, fy0, fbw, fbh, silo, atoms, na[silo],
                fbm, fbea, fbe0, fbat);
            if (ndA[0] < dcap) {
                tl_pend_append(ax0, ay0, aw0, ah0, aa0, am0, ae0, af0, ndA,
                    fx0, fy0, fbw, fbh, fbat[0],
                    fbm[0], fbm[1], fbm[2], fbea[0], fbe0[0]);
            }
            ntake[silo] = ntake[silo] + 1;
            fbx = fbx + 1;
        }
        fby = fby + 1;
    }
    nio_free(fbm); nio_free(fbea); nio_free(fbe0); nio_free(fbat);
    o = tr_puts(led, o, "assign @");
    o = tr_puti(led, o, s_of(silo));
    o = tr_puts(led, o, ": ");
    o = tr_puti(led, o, ndA[0]);
    o = tr_puts(led, o, " fixed blocks (take ");
    o = tr_puti(led, o, ntake[silo]);
    o = tr_puts(led, o, ")\n");
    // ---- Phase 3: the magnification cascade
    // cur bank = A; the loop reads cur and writes the other bank.
    let curx:[]i64 = ax0; let cury:[]i64 = ay0;
    let curw:[]i64 = aw0; let curh:[]i64 = ah0;
    let cura:[]i64 = aa0; let curm:[]i64 = am0;
    let cure:[]i64 = ae0; let curf:[]i64 = af0;
    let curn:[]i64 = ndA;
    let nxtx:[]i64 = bx0; let nxty:[]i64 = by0;
    let nxtw:[]i64 = bw0; let nxth:[]i64 = bh0;
    let nxta:[]i64 = ba0; let nxtm:[]i64 = bm0;
    let nxte:[]i64 = be0; let nxtf:[]i64 = bf0;
    let nxtn:[]i64 = ndB;
    let si:i64 = silo;
    while (si < sihi) {
        let sn:i64 = s_of(si + 1);
        // zoom candidates: post-atom residual energy still exceeds per-value-9
        let ncand:i64 = 0;
        let ci:i64 = 0;
        while (ci < curn[0]) {
            let thr:i64 = 27 * curw[ci] * curh[ci];
            if (cure[ci] > thr) {
                qx[ncand] = curx[ci]; qy[ncand] = cury[ci];
                qw[ncand] = curw[ci]; qh[ncand] = curh[ci];
                ncand = ncand + 1;
            }
            ci = ci + 1;
        }
        if (ncand == 0) {
            o = tr_puts(led, o, "scale ");
            o = tr_puti(led, o, sn);
            o = tr_puts(led, o, ": no region's residual earns a deeper look; stopping\n");
            break;
        }
        // Phase 2 (lazy): vocabulary at sn from the candidates' full blocks
        let at2:[]u8 = a0; let ae2:[]i64 = ex0;
        if (si + 1 == 1) { at2 = a1; ae2 = ex1; }
        if (si + 1 == 2) { at2 = a2; ae2 = ex2; }
        if (si + 1 == 3) { at2 = a3; ae2 = ex3; }
        if (si + 1 == 4) { at2 = a4; ae2 = ex4; }
        let nan1:[]i64 = nio_alloc(8) as []i64;
        let gf1:[]i64 = nio_alloc(8) as []i64;
        let gl1:[]i64 = nio_alloc(8) as []i64;
        tl_vocab_from_rects(px, w, h, si + 1, qx, qy, qw, qh, ncand,
            at2, ae2, nan1, gf1, gl1, nblo);
        na[si + 1] = nan1[0];
        gainfirst[si + 1] = gf1[0];
        gainlast[si + 1] = gl1[0];
        o = tr_puts(led, o, "vocab @");
        o = tr_puti(led, o, sn);
        o = tr_puts(led, o, ": ");
        o = tr_puti(led, o, nan1[0]);
        o = tr_puts(led, o, " atoms from ");
        o = tr_puti(led, o, nblo[0]);
        o = tr_puts(led, o, " full blocks in ");
        o = tr_puti(led, o, ncand);
        o = tr_puts(led, o, " candidate regions, gain ");
        o = tr_puti(led, o, gf1[0]);
        o = tr_puts(led, o, "..");
        o = tr_puti(led, o, gl1[0]);
        o = tr_puts(led, o, "\n");
        nio_free(nan1); nio_free(gf1); nio_free(gl1);
        // re-deliberate each candidate at sn; zoom iff the finer assignment
        // wins on measured gain-per-byte AND beats the flat baseline
        nxtn[0] = 0;
        let nzoomed:i64 = 0;
        let nkeep:i64 = 0;
        ci = 0;
        while (ci < curn[0]) {
            let thr2:i64 = 27 * curw[ci] * curh[ci];
            if (cure[ci] <= thr2) {
                // not a candidate: materialize at the coarser scale
                if (nreg[0] < regcap) {
                    let ri:i64 = nreg[0];
                    rx[ri] = curx[ci]; ry[ri] = cury[ci];
                    rw[ri] = curw[ci]; rh[ri] = curh[ci];
                    rs[ri] = s_of(si); rat[ri] = cura[ci];
                    rm[ri * 3] = curm[ci * 3];
                    rm[ri * 3 + 1] = curm[ci * 3 + 1];
                    rm[ri * 3 + 2] = curm[ci * 3 + 2];
                    nreg[0] = ri + 1;
                }
                nkeep = nkeep + 1;
                ci = ci + 1;
                continue;
            }
            ndS[0] = 0;
            // Tile the candidate with finer-scale fixed blocks (no CART).
            let sn2:i64 = s_of(si + 1);
            let zbm:[]i64 = nio_alloc(24) as []i64;
            let zbea:[]i64 = nio_alloc(8) as []i64;
            let zbe0:[]i64 = nio_alloc(8) as []i64;
            let zbat:[]i64 = nio_alloc(8) as []i64;
            if (zbm.len != 0) {
                let zty:i64 = 0;
                while (zty * sn2 < curh[ci]) {
                    let ztx:i64 = 0;
                    while (ztx * sn2 < curw[ci]) {
                        let zx0:i64 = curx[ci] + ztx * sn2;
                        let zy0:i64 = cury[ci] + zty * sn2;
                        let zbw:i64 = sn2;
                        if (zx0 + zbw > curx[ci] + curw[ci]) { zbw = curx[ci] + curw[ci] - zx0; }
                        let zbh:i64 = sn2;
                        if (zy0 + zbh > cury[ci] + curh[ci]) { zbh = cury[ci] + curh[ci] - zy0; }
                        tl_rect_take(px, w, zx0, zy0, zbw, zbh, si + 1, at2, na[si + 1],
                            zbm, zbea, zbe0, zbat);
                        if (ndS[0] < scap) {
                            tl_pend_append(sx0, sy0, sw0, sh0, sa0, sm0, se0, sf0, ndS,
                                zx0, zy0, zbw, zbh, zbat[0],
                                zbm[0], zbm[1], zbm[2], zbea[0], zbe0[0]);
                        }
                        ntake[si + 1] = ntake[si + 1] + 1;
                        ztx = ztx + 1;
                    }
                    zty = zty + 1;
                }
            }
            nio_free(zbm); nio_free(zbea); nio_free(zbe0); nio_free(zbat);
            let ea_fine:i64 = 0;
            let cj:i64 = 0;
            while (cj < ndS[0]) { ea_fine = ea_fine + se0[cj]; cj = cj + 1; }
            let c_fine:i64 = 17 * ndS[0];
            if (c_fine == 0) { c_fine = 17; }
            let e0t:i64 = curf[ci];
            let gf:i64 = e0t - ea_fine;
            let gc:i64 = e0t - cure[ci];
            let cc:i64 = 17;
            if (gf > 0 && gf * cc > gc * c_fine) {
                // ZOOM: the finer assignment wins; children become pending
                cj = 0;
                while (cj < ndS[0]) {
                    if (nxtn[0] < dcap) {
                        tl_pend_append(nxtx, nxty, nxtw, nxth, nxta, nxtm,
                            nxte, nxtf, nxtn,
                            sx0[cj], sy0[cj], sw0[cj], sh0[cj], sa0[cj],
                            sm0[cj * 3], sm0[cj * 3 + 1], sm0[cj * 3 + 2],
                            se0[cj], sf0[cj]);
                    }
                    cj = cj + 1;
                }
                nzoomed = nzoomed + 1;
                o = tr_puts(led, o, "ZOOM ");
                o = tr_puti(led, o, curx[ci]); o = tr_puts(led, o, ",");
                o = tr_puti(led, o, cury[ci]); o = tr_puts(led, o, " ");
                o = tr_puti(led, o, curw[ci]); o = tr_puts(led, o, "x");
                o = tr_puti(led, o, curh[ci]);
                o = tr_puts(led, o, " @");
                o = tr_puti(led, o, s_of(si));
                o = tr_puts(led, o, " -> @");
                o = tr_puti(led, o, sn);
                o = tr_puts(led, o, " (");
                o = tr_puti(led, o, ndS[0]);
                o = tr_puts(led, o, " pieces, gf=");
                o = tr_puti(led, o, gf);
                o = tr_puts(led, o, " gc=");
                o = tr_puti(led, o, gc);
                o = tr_puts(led, o, ")\n");
            } else {
                // KEEP the coarser assignment
                if (nreg[0] < regcap) {
                    let ri2:i64 = nreg[0];
                    rx[ri2] = curx[ci]; ry[ri2] = cury[ci];
                    rw[ri2] = curw[ci]; rh[ri2] = curh[ci];
                    rs[ri2] = s_of(si); rat[ri2] = cura[ci];
                    rm[ri2 * 3] = curm[ci * 3];
                    rm[ri2 * 3 + 1] = curm[ci * 3 + 1];
                    rm[ri2 * 3 + 2] = curm[ci * 3 + 2];
                    nreg[0] = ri2 + 1;
                }
                nkeep = nkeep + 1;
            }
            ci = ci + 1;
        }
        o = tr_puts(led, o, "scale ");
        o = tr_puti(led, o, sn);
        o = tr_puts(led, o, ": ");
        o = tr_puti(led, o, nzoomed);
        o = tr_puts(led, o, " zoomed, ");
        o = tr_puti(led, o, nkeep);
        o = tr_puts(led, o, " kept (take ");
        o = tr_puti(led, o, ntake[si + 1]);
        o = tr_puts(led, o, ", split ");
        o = tr_puti(led, o, nsplit[si + 1]);
        o = tr_puts(led, o, ")\n");
        // swap banks; the zoomed children are now the pending set
        let tx:[]i64 = curx; curx = nxtx; nxtx = tx;
        tx = cury; cury = nxty; nxty = tx;
        tx = curw; curw = nxtw; nxtw = tx;
        tx = curh; curh = nxth; nxth = tx;
        tx = cura; cura = nxta; nxta = tx;
        tx = curm; curm = nxtm; nxtm = tx;
        tx = cure; cure = nxte; nxte = tx;
        tx = curf; curf = nxtf; nxtf = tx;
        let tn:[]i64 = curn; curn = nxtn; nxtn = tn;
        si = si + 1;
    }
    // materialize whatever is still pending (at the finest reached scale)
    let mi:i64 = 0;
    while (mi < curn[0]) {
        if (nreg[0] < regcap) {
            let rk:i64 = nreg[0];
            rx[rk] = curx[mi]; ry[rk] = cury[mi];
            rw[rk] = curw[mi]; rh[rk] = curh[mi];
            rs[rk] = s_of(si); rat[rk] = cura[mi];
            rm[rk * 3] = curm[mi * 3];
            rm[rk * 3 + 1] = curm[mi * 3 + 1];
            rm[rk * 3 + 2] = curm[mi * 3 + 2];
            nreg[0] = rk + 1;
        }
        mi = mi + 1;
    }
    o = tr_puts(led, o, "SHAPES-ZOOM done: ");
    o = tr_puti(led, o, nreg[0]);
    o = tr_puts(led, o, " regions\n");
    
    // render + measured gain
    let ra0:[]u8 = a0; let ra1:[]u8 = a1; let ra2:[]u8 = a2;
    let ra3:[]u8 = a3; let ra4:[]u8 = a4;
    tl_shapes_render(tmp, w, h, ra0, ra1, ra2, ra3, ra4,
        rx, ry, rw, rh, rs, rat, rm, nreg[0]);
    let npix:i64 = w * h;
    let g:i64 = 0;
    let i:i64 = 0;
    while (i < npix * 3) {
        let b:i64 = px[i];
        let a:i64 = px[i] - tmp[i];
        g = g + b * b - a * a;
        i = i + 1;
    }
    G[0] = g;
    N[0] = npix * 3;
    nio_free(ax0); nio_free(ay0); nio_free(aw0); nio_free(ah0);
    nio_free(aa0); nio_free(am0); nio_free(ae0); nio_free(af0);
    nio_free(bx0); nio_free(by0); nio_free(bw0); nio_free(bh0);
    nio_free(ba0); nio_free(bm0); nio_free(be0); nio_free(bf0);
    nio_free(sx0); nio_free(sy0); nio_free(sw0); nio_free(sh0);
    nio_free(sa0); nio_free(sm0); nio_free(se0); nio_free(sf0);
    nio_free(qx); nio_free(qy); nio_free(qw); nio_free(qh);
    nio_free(ndA); nio_free(ndB); nio_free(ndS); nio_free(nblo);
    nio_free(gf0); nio_free(gl0);
    return o;
}

// ---------------- knowledge map "TNNKTLM3" ----------------
// (TNNKTLM2 + adaptive layers 2026-09-26: SHAPES regions carry arbitrary
//  rectangle w/h. Magic bumped to mark the format change.)
// magic[8]="TNNKTLM3" u64 w u64 h u64 nlayers
// per committed layer (in TNN's try order): u8 id, then payload:
//   id=1 SMOOTH: u64 nleaf; nleaf * 26 bytes:
//       u16 x,y,w,h + i16 mean[3] + i16 grad[6]
//   id=2 LINES: u64 nseg; nseg * 14 bytes:
//       u16 x0,y0,x1,y1 + i16 m[3]
//   id=3 SHAPES: u8 silo u8 sihi u64 nscales(=sihi-silo+1);
//       per scale: u64 B u64 na; na*(B*B*3 i16); na*u64 exemplar;
//       (na = FIRED atoms only — unfired atoms pruned at write time,
//        usage indices renumbered; see tl_prune_shapes)
//       u64 nreg; nreg * 17 bytes: u16 x,y,w,h + u8 s + u16 atom + i16 m[3]
// residual section: u64 nr; u8 dmode (0=i8 deltas,1=i16); u8 pflag
//   (0=u16 gaps,1=u32 gaps); u32 first_pos; (nr-1) gaps (positions are
//   strictly increasing, gap-coded exactly); nr delta triples
//   (3x i8 or 3x i16 per modes)
fn tlk_write(root:i64, name:[]u8, w:i64, h:i64,
    order:[]i64, ntry:i64, committed:[]i64,
    slx:[]i64, sly:[]i64, slw:[]i64, slh:[]i64, slm:[]i64, slg:[]i64, snleaf:i64,
    sgx0:[]i64, sgy0:[]i64, sgx1:[]i64, sgy1:[]i64, sgm:[]i64, sgnseg:i64,
    ha0:[]u8, ha1:[]u8, ha2:[]u8, ha3:[]u8, ha4:[]u8,
    hna:[]i64, hex0:[]i64, hex1:[]i64, hex2:[]i64, hex3:[]i64, hex4:[]i64,
    hrx:[]i64, hry:[]i64, hrw:[]i64, hrh:[]i64, hrs:[]i64, hrat:[]i64, hrm:[]i64, hrnreg:i64,
    hsilo:i64, hsihi:i64,
    nr:i64, rpos:[]i64, rdelta:[]u8) i64 {
    // pass 1: byte count
    let total:i64 = 8 + 8 + 8 + 8;
    let t:i64 = 0;
    while (t < ntry) {
        if (committed[t] == 1) {
            total = total + 1;
            let id:i64 = order[t];
            if (id == 1) { total = total + 8 + snleaf * 26; }
            if (id == 2) { total = total + 8 + sgnseg * 14; }
            if (id == 3) {
                total = total + 2 + 8;
                let si:i64 = hsilo;
                while (si <= hsihi) {
                    let B:i64 = s_of(si);
                    let nv:i64 = B * B * 3;
                    let na:i64 = hna[si];
                    total = total + 8 + 8 + na * (nv * 2 + 8);
                    si = si + 1;
                }
                total = total + 8 + hrnreg * 17;
            }
        }
        t = t + 1;
    }
    total = total + tl_res_size(nr, rpos, rdelta);
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) { return -11; }
    buf[0] = 84; buf[1] = 78; buf[2] = 78; buf[3] = 75;
    buf[4] = 84; buf[5] = 76; buf[6] = 77; buf[7] = 51;
    let o:i64 = 8;
    w_u64le(buf, o, w); o = o + 8;
    w_u64le(buf, o, h); o = o + 8;
    let nl:i64 = 0;
    t = 0;
    while (t < ntry) { if (committed[t] == 1) { nl = nl + 1; } t = t + 1; }
    w_u64le(buf, o, nl); o = o + 8;
    t = 0;
    while (t < ntry) {
        if (committed[t] == 1) {
            let id2:i64 = order[t];
            buf[o] = id2 as u8; o = o + 1;
            if (id2 == 1) {
                w_u64le(buf, o, snleaf); o = o + 8;
                let li:i64 = 0;
                while (li < snleaf) {
                    w_u16le(buf, o, slx[li]); o = o + 2;
                    w_u16le(buf, o, sly[li]); o = o + 2;
                    w_u16le(buf, o, slw[li]); o = o + 2;
                    w_u16le(buf, o, slh[li]); o = o + 2;
                    w_i16le(buf, o, slm[li * 3]); o = o + 2;
                    w_i16le(buf, o, slm[li * 3 + 1]); o = o + 2;
                    w_i16le(buf, o, slm[li * 3 + 2]); o = o + 2;
                    let gi:i64 = 0;
                    while (gi < 6) {
                        w_i16le(buf, o, slg[li * 6 + gi]); o = o + 2;
                        gi = gi + 1;
                    }
                    li = li + 1;
                }
            }
            if (id2 == 2) {
                w_u64le(buf, o, sgnseg); o = o + 8;
                let sj:i64 = 0;
                while (sj < sgnseg) {
                    w_u16le(buf, o, sgx0[sj]); o = o + 2;
                    w_u16le(buf, o, sgy0[sj]); o = o + 2;
                    w_u16le(buf, o, sgx1[sj]); o = o + 2;
                    w_u16le(buf, o, sgy1[sj]); o = o + 2;
                    w_i16le(buf, o, sgm[sj * 3]); o = o + 2;
                    w_i16le(buf, o, sgm[sj * 3 + 1]); o = o + 2;
                    w_i16le(buf, o, sgm[sj * 3 + 2]); o = o + 2;
                    sj = sj + 1;
                }
            }
            if (id2 == 3) {
                buf[o] = hsilo as u8; o = o + 1;
                buf[o] = hsihi as u8; o = o + 1;
                w_u64le(buf, o, hsihi - hsilo + 1); o = o + 8;
                let si2:i64 = hsilo;
                while (si2 <= hsihi) {
                    let B2:i64 = s_of(si2);
                    let nv2:i64 = B2 * B2 * 3;
                    let na2:i64 = hna[si2];
                    w_u64le(buf, o, B2); o = o + 8;
                    w_u64le(buf, o, na2); o = o + 8;
                    let atoms:[]u8 = ha0;
                    let aex:[]i64 = hex0;
                    if (si2 == 1) { atoms = ha1; aex = hex1; }
                    if (si2 == 2) { atoms = ha2; aex = hex2; }
                    if (si2 == 3) { atoms = ha3; aex = hex3; }
                    if (si2 == 4) { atoms = ha4; aex = hex4; }
                    let ai:i64 = 0;
                    while (ai < na2) {
                        let kk:i64 = 0;
                        while (kk < nv2) {
                            w_i16le(buf, o, r_i16le(atoms, ai * nv2 * 2 + kk * 2));
                            o = o + 2; kk = kk + 1;
                        }
                        w_u64le(buf, o, aex[ai]); o = o + 8;
                        ai = ai + 1;
                    }
                    si2 = si2 + 1;
                }
                w_u64le(buf, o, hrnreg); o = o + 8;
                let ri:i64 = 0;
                while (ri < hrnreg) {
                    w_u16le(buf, o, hrx[ri]); o = o + 2;
                    w_u16le(buf, o, hry[ri]); o = o + 2;
                    w_u16le(buf, o, hrw[ri]); o = o + 2;
                    w_u16le(buf, o, hrh[ri]); o = o + 2;
                    buf[o] = hrs[ri] as u8; o = o + 1;
                    w_u16le(buf, o, hrat[ri]); o = o + 2;
                    w_i16le(buf, o, hrm[ri * 3]); o = o + 2;
                    w_i16le(buf, o, hrm[ri * 3 + 1]); o = o + 2;
                    w_i16le(buf, o, hrm[ri * 3 + 2]); o = o + 2;
                    ri = ri + 1;
                }
            }
        }
        t = t + 1;
    }
    w_u64le(buf, o, nr); o = o + 8;
    let rmodes:[]i64 = nio_alloc(16) as []i64;
    tl_res_modes(nr, rpos, rdelta, rmodes);
    buf[o] = rmodes[0] as u8; o = o + 1;
    buf[o] = rmodes[1] as u8; o = o + 1;
    let fp0:i64 = 0;
    if (nr > 0) { fp0 = rpos[0]; }
    w_u32le(buf, o, fp0); o = o + 4;
    let rj:i64 = 1;
    while (rj < nr) {
        let gg:i64 = rpos[rj] - rpos[rj - 1];
        if (rmodes[1] == 0) { w_u16le(buf, o, gg); o = o + 2; }
        else { w_u32le(buf, o, gg); o = o + 4; }
        rj = rj + 1;
    }
    rj = 0;
    while (rj < nr) {
        let q0:i64 = r_i16le(rdelta, rj * 6);
        let q1:i64 = r_i16le(rdelta, rj * 6 + 2);
        let q2:i64 = r_i16le(rdelta, rj * 6 + 4);
        if (rmodes[0] == 0) {
            buf[o] = (q0 & 255) as u8; o = o + 1;
            buf[o] = (q1 & 255) as u8; o = o + 1;
            buf[o] = (q2 & 255) as u8; o = o + 1;
        } else {
            w_i16le(buf, o, q0); o = o + 2;
            w_i16le(buf, o, q1); o = o + 2;
            w_i16le(buf, o, q2); o = o + 2;
        }
        rj = rj + 1;
    }
    nio_free(rmodes);
    let rc:i64 = file_write(root, name, buf);
    nio_free(buf);
    return rc;
}

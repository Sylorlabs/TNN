// corpstat.zag — derive matching-discipline constants from vocab.bin.
//
// Measures, over the shared atom vocabulary (scales 0..3, thin excluded):
//   vA1000[ai] = key variance per value x1000  (key = s*s*3 i16, mean-subtracted)
//   eA1000[ai] = full-res deviation energy per value x1000
//   tA1000[ai] = eA1000*1000/vA1000  (zero-variance atoms excluded)
// Prints: N, tau_min = 25th pct of vA1000, tau_mid = 75th pct of vA1000,
//         R_band  = 75th pct of tA1000.
// Percentile definition: ascending sort a[0..N-1]; pXX = a[(N*XX)/100].
// Pure Zag, zero RNG, deterministic (insertion sort, canonical order).
// argv: 1=vocabdir (contains vocab.bin).
@import("./common_az.zag")

fn cs_puts(b:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { b[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn cs_puti(b:[]u8, o:i64, v:i64) i64 {
    if (v < 0) { b[o] = 45; o = o + 1; v = 0 - v; }
    let t:[]u8 = _zag_i64_to_str(v);
    let i:i64 = 0;
    while (i < t.len) { b[o + i] = t[i]; i = i + 1; }
    return o + t.len;
}

// vocab load (same layout as azgen's g_vocab_load)
fn cs_vocab_load(root:i64, vbuf:[]u8, vcap:i64,
    vS:[]i64, vK:[]i64, vab:[]i64, vkb:[]i64) i64 {
    let fd:i64 = nio_open_child(root, "vocab.bin", 0);
    if (fd < 0) { return 1; }
    let n:i64 = nio_read_exact(fd, vbuf, vcap - 1);
    nio_close(fd);
    if (n < 48) { return 2; }
    if (vbuf[0] != 86) { return 3; }
    if (vbuf[1] != 79) { return 4; }
    if (vbuf[2] != 67) { return 5; }
    if (vbuf[3] != 50) { return 6; }
    let ns:i64 = r_u32le(vbuf, 4);
    if (ns != 5) { return 7; }
    let off:i64 = 48;
    let si:i64 = 0;
    while (si < 5) {
        let S:i64 = r_u32le(vbuf, 8 + si * 8);
        let K:i64 = r_u32le(vbuf, 8 + si * 8 + 4);
        vS[si] = S;
        vK[si] = K;
        let mb:i64 = S * S * 3 * 2;
        let s2:i64 = S / 2;
        let kmb:i64 = s2 * s2 * 3 * 2;
        vab[si] = off;
        off = off + K * mb;
        vkb[si] = off;
        off = off + K * kmb;
        si = si + 1;
    }
    if (off > n) { return 8; }
    return 0;
}

// insertion sort ascending (deterministic)
fn cs_sort(a:[]i64, n:i64) void {
    let i:i64 = 1;
    while (i < n) {
        let v:i64 = a[i];
        let j:i64 = i - 1;
        let go:i64 = 1;
        while (go == 1) {
            if (j < 0) { go = 0; }
            else {
                if (a[j] <= v) { go = 0; }
                else { a[j + 1] = a[j]; j = j - 1; }
            }
        }
        a[j + 1] = v;
        i = i + 1;
    }
    return;
}

fn main() i32 {
    let ind:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    if (_zag_strcmp(ind, "") == 1) { ind = "."; }
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let root:i64 = nio_open_root(ind);
    if (root < 0) { _zag_println("cannot open vocabdir"); return 1; }
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { _zag_println("cannot open outdir"); nio_close(root); return 1; }
    let vbuf:[]u8 = nio_alloc(4194304);
    let vS:[]i64 = nio_alloc(40) as []i64;
    let vK:[]i64 = nio_alloc(40) as []i64;
    let vab:[]i64 = nio_alloc(40) as []i64;
    let vkb:[]i64 = nio_alloc(40) as []i64;
    if (vbuf.len == 0) { _zag_println("alloc vbuf failed"); return 1; }
    let rc:i64 = cs_vocab_load(root, vbuf, 4194304, vS, vK, vab, vkb);
    if (rc != 0) { _zag_println("vocab load failed"); return 1; }

    // max atoms scales 0..3: 48*4 = 192
    let vA:[]i64 = nio_alloc((192 * 8) as i32) as []i64;
    let tA:[]i64 = nio_alloc((192 * 8) as i32) as []i64;
    let eA:[]i64 = nio_alloc((192 * 8) as i32) as []i64;
    if (vA.len == 0) { _zag_println("alloc stat failed"); return 1; }
    let nv:i64 = 0;
    let nt:i64 = 0;
    let si:i64 = 0;
    while (si < 4) {
        let S:i64 = vS[si];
        let K:i64 = vK[si];
        let s:i64 = S / 2;
        let nkey:i64 = s * s * 3;
        let nfull:i64 = S * S * 3;
        let ai:i64 = 0;
        while (ai < K) {
            // key mean + SSD
            let kb:i64 = vkb[si] + ai * (nkey * 2);
            let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
            let k:i64 = 0;
            while (k < nkey / 3) {
                sr = sr + r_i16le(vbuf, kb + k * 6);
                sg = sg + r_i16le(vbuf, kb + k * 6 + 2);
                sb = sb + r_i16le(vbuf, kb + k * 6 + 4);
                k = k + 1;
            }
            let npx:i64 = nkey / 3;
            let kr:i64 = sr / npx; let kg:i64 = sg / npx; let kbb:i64 = sb / npx;
            let kssd:i64 = 0;
            k = 0;
            while (k < nkey / 3) {
                let d0:i64 = r_i16le(vbuf, kb + k * 6) - kr;
                let d1:i64 = r_i16le(vbuf, kb + k * 6 + 2) - kg;
                let d2:i64 = r_i16le(vbuf, kb + k * 6 + 4) - kbb;
                kssd = kssd + d0 * d0 + d1 * d1 + d2 * d2;
                k = k + 1;
            }
            let v1000:i64 = (kssd * 1000) / nkey;
            vA[nv] = v1000;
            nv = nv + 1;
            // full-res energy
            let ab:i64 = vab[si] + ai * (nfull * 2);
            let essd:i64 = 0;
            k = 0;
            while (k < nfull / 3) {
                let d0:i64 = r_i16le(vbuf, ab + k * 6);
                let d1:i64 = r_i16le(vbuf, ab + k * 6 + 2);
                let d2:i64 = r_i16le(vbuf, ab + k * 6 + 4);
                essd = essd + d0 * d0 + d1 * d1 + d2 * d2;
                k = k + 1;
            }
            let e1000:i64 = (essd * 1000) / nfull;
            eA[ai + si * 48] = e1000;
            if (kssd > 0) {
                tA[nt] = (e1000 * 1000) / v1000;
                nt = nt + 1;
            }
            ai = ai + 1;
        }
        si = si + 1;
    }
    cs_sort(vA, nv);
    cs_sort(tA, nt);
    let tau_min:i64 = vA[(nv * 25) / 100];
    let tau_mid:i64 = vA[(nv * 75) / 100];
    let rband:i64 = tA[(nt * 75) / 100];

    let out:[]u8 = nio_alloc(4096);
    let o:i64 = 0;
    o = cs_puts(out, o, "CORPUS STATS from vocab.bin (scales 0..3, thin excluded)\n");
    o = cs_puts(out, o, "n_atoms_v=");
    o = cs_puti(out, o, nv);
    o = cs_puts(out, o, " n_atoms_t=");
    o = cs_puti(out, o, nt);
    o = cs_puts(out, o, "\npercentile def: ascending sort a[0..N-1]; pXX=a[(N*XX)/100]\n");
    o = cs_puts(out, o, "tau_min (25th pct key-var x1000) = ");
    o = cs_puti(out, o, tau_min);
    o = cs_puts(out, o, "\ntau_mid (75th pct key-var x1000) = ");
    o = cs_puti(out, o, tau_mid);
    o = cs_puts(out, o, "\nR_band (75th pct full/key energy ratio x1000) = ");
    o = cs_puti(out, o, rband);
    o = cs_puts(out, o, "\nvA min=");
    o = cs_puti(out, o, vA[0]);
    o = cs_puts(out, o, " max=");
    o = cs_puti(out, o, vA[nv - 1]);
    o = cs_puts(out, o, "\ntA min=");
    o = cs_puti(out, o, tA[0]);
    o = cs_puts(out, o, " max=");
    o = cs_puti(out, o, tA[nt - 1]);
    o = cs_puts(out, o, "\nDONE\n");
    let wrc:i64 = file_write(oroot, "CORPUS_STATS.txt", out[0..o]);
    if (wrc < 0) { _zag_println("stats write failed"); return 1; }
    _zag_print("tau_min=");
    _zag_print(_zag_i64_to_str(tau_min));
    _zag_print(" tau_mid=");
    _zag_print(_zag_i64_to_str(tau_mid));
    _zag_print(" R_band=");
    _zag_println(_zag_i64_to_str(rband));
    nio_close(root);
    nio_close(oroot);
    return 0;
}

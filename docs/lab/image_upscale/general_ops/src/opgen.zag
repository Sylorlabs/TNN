// opgen.zag — general image operators, module 1: MATCHER unit + UPSCALE-2X unit.
// Crew C (2026-09-27): generalize TNN's image capability.
//
// MATCHER UNIT (matcher-agnostic by design):
//   The atom-matching discipline is a separable unit behind the m_*
//   interface, driven by a matcher_cfg ([]i64):
//     cfg[0] = discipline id: 0 = key-ssd-best (current; the exact
//              discipline azgen used), 1 = RESERVED for the sibling crew's
//              key-ambiguity fix.
//     cfg[1] = take bar per value (9, the standing per-value bar).
//     cfg[2..5] = reserved (margin numerator/denominator for discipline 1).
//   m_shapes_match / m_thin_match read the cfg and dispatch. Adopting the
//   fixed matcher later = implementing discipline 1 behind this interface;
//   the driver and the fill unit never call atom-matching internals
//   directly, so no rewrite is needed.
//
// UPSCALE-2X UNIT:
//   op_upscale2x is the azgen generation path as a callable unit
//   (survey -> affinity order -> SHAPES/LINES cascade -> render at 2x).
//   Construction = measured region mean + measured atom deviation.
//   azgen's bicubic baseline is REMOVED entirely from this file: no
//   bicubic in any generation path (scoring happens outside the binary).
//   Labels: 0 KNOWN, 2 CONSTRUCTED-LINES, 3 CONSTRUCTED-SHAPES,
//           4 INVENTED, 6 CONSTRUCTED-NO-FIT.
//
// Pure Zag, zero RNG, pinned toolchain.
@import("./azlayers.zag")

fn op_puts(b:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { b[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn op_puti(b:[]u8, o:i64, v:i64) i64 {
    if (v < 0) { b[o] = 45; o = o + 1; v = 0 - v; }
    let t:[]u8 = _zag_i64_to_str(v);
    let i:i64 = 0;
    while (i < t.len) { b[o + i] = t[i]; i = i + 1; }
    return o + t.len;
}

// round-half-away integer division, den > 0
fn op_rdiv(num:i64, den:i64) i64 {
    if (num >= 0) { return (num + den / 2) / den; }
    return (num - den / 2) / den;
}

fn op_load_bmp(root:i64, name:[]u8, px:[]i64, npix:i64, hout:[]i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { nio_close(fd); return -2; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 54) { nio_free(fbuf); return -3; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    if (w * h > npix) { nio_free(fbuf); return -4; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            px[p] = fbuf[q + 2] as i64;
            px[p + 1] = fbuf[q + 1] as i64;
            px[p + 2] = fbuf[q] as i64;
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fbuf);
    hout[0] = h;
    return w;
}

// ---- vocab loading (VOC2) ----
// vS[5], vK[5], vab[5], vkb[5] filled; vbuf holds the file. rc 0 ok.
fn op_vocab_load(root:i64, vbuf:[]u8, vcap:i64,
    vS:[]i64, vK:[]i64, vab:[]i64, vkb:[]i64, nread:[]i64) i64 {
    let fd:i64 = nio_open_child(root, "vocab.bin", 0);
    if (fd < 0) { return 1; }
    let n:i64 = nio_read_exact(fd, vbuf, vcap - 1);
    nio_close(fd);
    if (n < 48) { return 2; }
    if (vbuf[0] != 86) { return 3; }
    if (vbuf[1] != 79) { return 4; }
    if (vbuf[2] != 67) { return 5; }
    if (vbuf[3] != 50) { return 6; }
    let ns:i64 = r_u32le(vbuf, 4);
    if (ns != 5) { return 7; }
    let off:i64 = 48;
    let si:i64 = 0;
    while (si < 5) {
        let S:i64 = r_u32le(vbuf, 8 + si * 8);
        let K:i64 = r_u32le(vbuf, 8 + si * 8 + 4);
        vS[si] = S;
        vK[si] = K;
        let mb:i64 = S * S * 3 * 2;
        let s2:i64 = S / 2;
        let kmb:i64 = s2 * s2 * 3 * 2;
        vab[si] = off;
        off = off + K * mb;
        vkb[si] = off;
        off = off + K * kmb;
        si = si + 1;
    }
    nread[0] = n;
    if (off > n) { return 8; }
    return 0;
}

// ---------------- MATCHER UNIT ----------------
// m_shapes_match: discipline-selected atom match for one block.
// (mr,mg,mb): measured block mean; e: block energy vs mean.
// si: vocab scale (S=vS[si], key s=S/2; requires bw<=s, bh<=s).
// mout[0] = best atom. Returns gain (e - sse_best); the NULL atom (0)
// gives gain 0. Returns -99 if the discipline is not implemented.
fn m_shapes_match(px:[]i64, w:i64, h:i64, x:i64, y:i64, bw:i64, bh:i64,
    mr:i64, mg:i64, mb:i64, e:i64,
    vS:[]i64, vK:[]i64, vab:[]i64, vkb:[]i64, vbuf:[]u8,
    si:i64, cfg:[]i64, mout:[]i64) i64 {
    let disc:i64 = cfg[0];
    if (disc != 0) { mout[0] = 0; return -99; }
    let S:i64 = vS[si];
    let K:i64 = vK[si];
    let s:i64 = S / 2;
    let vkb_si:i64 = vkb[si];
    let kmb:i64 = s * s * 3 * 2;
    let n:i64 = bw * bh;
    // discipline 0: key-SSD best-wins (azgen's discipline, unchanged).
    // best shared atom (key top-left bw*bh vs block deviations);
    // atom 0 is the NULL atom: sse = e, gain 0.
    let best:i64 = 0;
    let bsse:i64 = e;
    let ai:i64 = 1;
    while (ai < K) {
        let kr:i64 = 0; let kg:i64 = 0; let kb:i64 = 0;
        let ky:i64 = 0;
        while (ky < bh) {
            let kx:i64 = 0;
            while (kx < bw) {
                let q:i64 = vkb_si + ai * kmb + (ky * s + kx) * 6;
                kr = kr + r_i16le(vbuf, q);
                kg = kg + r_i16le(vbuf, q + 2);
                kb = kb + r_i16le(vbuf, q + 4);
                kx = kx + 1;
            }
            ky = ky + 1;
        }
        kr = kr / n; kg = kg / n; kb = kb / n;
        let sse:i64 = 0;
        let y2:i64 = 0;
        while (y2 < bh) {
            let x2:i64 = 0;
            while (x2 < bw) {
                let p3:i64 = ((y + y2) * w + (x + x2)) * 3;
                let q2:i64 = vkb_si + ai * kmb + (y2 * s + x2) * 6;
                let d0:i64 = (px[p3] - mr) - (r_i16le(vbuf, q2) - kr);
                let d1:i64 = (px[p3 + 1] - mg) - (r_i16le(vbuf, q2 + 2) - kg);
                let d2:i64 = (px[p3 + 2] - mb) - (r_i16le(vbuf, q2 + 4) - kb);
                sse = sse + d0 * d0 + d1 * d1 + d2 * d2;
                x2 = x2 + 1;
            }
            y2 = y2 + 1;
        }
        if (sse < bsse) { bsse = sse; best = ai; }
        ai = ai + 1;
    }
    mout[0] = best;
    return e - bsse;
}

// m_thin_match: discipline-selected match of the 2x2 input block at
// (lx,ly) against the shared thin keys (S=4). aout[0]=best atom,
// mout[3]=block mean. Returns gain (energy - sse_best).
fn m_thin_match(px:[]i64, w:i64, lx:i64, ly:i64,
    vkb4:i64, K4:i64, vbuf:[]u8, cfg:[]i64, aout:[]i64, mout:[]i64) i64 {
    let disc:i64 = cfg[0];
    if (disc != 0) { aout[0] = 0; return -99; }
    let p00:i64 = (ly * w + lx) * 3;
    let p10:i64 = p00 + 3;
    let p01:i64 = ((ly + 1) * w + lx) * 3;
    let p11:i64 = p01 + 3;
    let mr:i64 = (px[p00] + px[p10] + px[p01] + px[p11]) / 4;
    let mg:i64 = (px[p00 + 1] + px[p10 + 1] + px[p01 + 1] + px[p11 + 1]) / 4;
    let mb:i64 = (px[p00 + 2] + px[p10 + 2] + px[p01 + 2] + px[p11 + 2]) / 4;
    mout[0] = mr; mout[1] = mg; mout[2] = mb;
    let d0:i64 = px[p00] - mr; let d1:i64 = px[p10] - mr;
    let d2:i64 = px[p01] - mr; let d3:i64 = px[p11] - mr;
    let e0:i64 = px[p00 + 1] - mg; let e1:i64 = px[p10 + 1] - mg;
    let e2:i64 = px[p01 + 1] - mg; let e3:i64 = px[p11 + 1] - mg;
    let f0:i64 = px[p00 + 2] - mb; let f1:i64 = px[p10 + 2] - mb;
    let f2:i64 = px[p01 + 2] - mb; let f3:i64 = px[p11 + 2] - mb;
    let e:i64 = d0*d0+d1*d1+d2*d2+d3*d3
        + e0*e0+e1*e1+e2*e2+e3*e3 + f0*f0+f1*f1+f2*f2+f3*f3;
    let best:i64 = 0;
    let bsse:i64 = e;
    let ai:i64 = 1;
    while (ai < K4) {
        let kb:i64 = vkb4 + ai * 24;
        let kr:i64 = (r_i16le(vbuf, kb) + r_i16le(vbuf, kb + 6)
            + r_i16le(vbuf, kb + 12) + r_i16le(vbuf, kb + 18)) / 4;
        let kg:i64 = (r_i16le(vbuf, kb + 2) + r_i16le(vbuf, kb + 8)
            + r_i16le(vbuf, kb + 14) + r_i16le(vbuf, kb + 20)) / 4;
        let kbb:i64 = (r_i16le(vbuf, kb + 4) + r_i16le(vbuf, kb + 10)
            + r_i16le(vbuf, kb + 16) + r_i16le(vbuf, kb + 22)) / 4;
        let sse:i64 = 0;
        let k:i64 = 0;
        while (k < 4) {
            let q:i64 = kb + k * 6;
            let dd:i64 = 0; let ee:i64 = 0; let ff:i64 = 0;
            if (k == 0) { dd = d0; ee = e0; ff = f0; }
            if (k == 1) { dd = d1; ee = e1; ff = f1; }
            if (k == 2) { dd = d2; ee = e2; ff = f2; }
            if (k == 3) { dd = d3; ee = e3; ff = f3; }
            let r0:i64 = dd - (r_i16le(vbuf, q) - kr);
            let r1:i64 = ee - (r_i16le(vbuf, q + 2) - kg);
            let r2:i64 = ff - (r_i16le(vbuf, q + 4) - kbb);
            sse = sse + r0 * r0 + r1 * r1 + r2 * r2;
            k = k + 1;
        }
        if (sse < bsse) { bsse = sse; best = ai; }
        ai = ai + 1;
    }
    aout[0] = best;
    return e - bsse;
}

// ---- SHAPES-ZOOM (via the matcher unit) ----
// Recursive partition fit of the residual against the SHARED atoms.
// Block (x,y,bw,bh) at scale si (atom S=vS[si], key s=S/2).
// Takes are stride-9 rows: x,y,bw,bh,si,atom,mr,mg,mb.
// Nofits are stride-4: x,y,bw,bh.
// Decision (measured, cfg[1] per-value bar):
//   TAKE iff gain_take >= bar*nval AND gain_take >= gain_split.
//   SPLIT kept iff gain_split > gain_take AND gain_split >= bar*nval.
//   else REJECT (NOFIT recorded only at si==0, the top level).
// Returns the gain credited for this block.
fn op_shapes_fit(px:[]i64, w:i64, h:i64, x:i64, y:i64, bw:i64, bh:i64, si:i64,
    vS:[]i64, vK:[]i64, vab:[]i64, vkb:[]i64, vbuf:[]u8, cfg:[]i64,
    mscratch:[]i64,
    takes:[]i64, ntout:[]i64, nofits:[]i64, nnout:[]i64) i64 {
    let n:i64 = bw * bh;
    let nval:i64 = n * 3;
    // block mean + energy (measured)
    let mr:i64 = 0; let mg:i64 = 0; let mb:i64 = 0;
    let yy:i64 = 0;
    while (yy < bh) {
        let xx:i64 = 0;
        while (xx < bw) {
            let p:i64 = ((y + yy) * w + (x + xx)) * 3;
            mr = mr + px[p]; mg = mg + px[p + 1]; mb = mb + px[p + 2];
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    mr = mr / n; mg = mg / n; mb = mb / n;
    let e:i64 = 0;
    yy = 0;
    while (yy < bh) {
        let xx:i64 = 0;
        while (xx < bw) {
            let p2:i64 = ((y + yy) * w + (x + xx)) * 3;
            let d0:i64 = px[p2] - mr;
            let d1:i64 = px[p2 + 1] - mg;
            let d2:i64 = px[p2 + 2] - mb;
            e = e + d0 * d0 + d1 * d1 + d2 * d2;
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    // matcher unit scores the block; policy (bar/split) stays here
    let gain_take:i64 = m_shapes_match(px, w, h, x, y, bw, bh, mr, mg, mb, e,
        vS, vK, vab, vkb, vbuf, si, cfg, mscratch);
    let best:i64 = mscratch[0];
    let bar:i64 = cfg[1] * nval;
    // try the finer split
    let can_split:i64 = 0;
    if (si < 3) {
        if (bw >= 8) {
            if (bh >= 8) { can_split = 1; }
        }
    }
    if (can_split == 1) {
        let nt0:i64 = ntout[0];
        let nn0:i64 = nnout[0];
        let hw:i64 = bw / 2;
        let hh:i64 = bh / 2;
        let g0:i64 = op_shapes_fit(px, w, h, x, y, hw, hh, si + 1,
            vS, vK, vab, vkb, vbuf, cfg, mscratch, takes, ntout, nofits, nnout);
        let g1:i64 = op_shapes_fit(px, w, h, x + hw, y, bw - hw, hh, si + 1,
            vS, vK, vab, vkb, vbuf, cfg, mscratch, takes, ntout, nofits, nnout);
        let g2:i64 = op_shapes_fit(px, w, h, x, y + hh, hw, bh - hh, si + 1,
            vS, vK, vab, vkb, vbuf, cfg, mscratch, takes, ntout, nofits, nnout);
        let g3:i64 = op_shapes_fit(px, w, h, x + hw, y + hh, bw - hw, bh - hh, si + 1,
            vS, vK, vab, vkb, vbuf, cfg, mscratch, takes, ntout, nofits, nnout);
        let gain_split:i64 = g0 + g1 + g2 + g3;
        if (gain_split > gain_take) {
            if (gain_split >= bar) {
                return gain_split;
            }
        }
        // split loses: truncate the children's records, try TAKE
        ntout[0] = nt0;
        nnout[0] = nn0;
    }
    if (gain_take >= bar) {
        let nt:i64 = ntout[0];
        takes[nt * 9] = x;
        takes[nt * 9 + 1] = y;
        takes[nt * 9 + 2] = bw;
        takes[nt * 9 + 3] = bh;
        takes[nt * 9 + 4] = si;
        takes[nt * 9 + 5] = best;
        takes[nt * 9 + 6] = mr;
        takes[nt * 9 + 7] = mg;
        takes[nt * 9 + 8] = mb;
        ntout[0] = nt + 1;
        return gain_take;
    }
    if (si == 0) {
        let nn:i64 = nnout[0];
        nofits[nn * 4] = x;
        nofits[nn * 4 + 1] = y;
        nofits[nn * 4 + 2] = bw;
        nofits[nn * 4 + 3] = bh;
        nnout[0] = nn + 1;
    }
    return 0;
}

// Subtract the SHAPES model (input-res: mean + key deviations) from px,
// and mark the claimed input pixels.
fn op_shapes_commit(px:[]i64, w:i64, h:i64,
    vS:[]i64, vK:[]i64, vab:[]i64, vkb:[]i64, vbuf:[]u8,
    takes:[]i64, nt:i64, claimed:[]u8) void {
    let ti:i64 = 0;
    while (ti < nt) {
        let x:i64 = takes[ti * 9];
        let y:i64 = takes[ti * 9 + 1];
        let bw:i64 = takes[ti * 9 + 2];
        let bh:i64 = takes[ti * 9 + 3];
        let si:i64 = takes[ti * 9 + 4];
        let atom:i64 = takes[ti * 9 + 5];
        let mr:i64 = takes[ti * 9 + 6];
        let mg:i64 = takes[ti * 9 + 7];
        let mb:i64 = takes[ti * 9 + 8];
        let S:i64 = vS[si];
        let s:i64 = S / 2;
        let kmb:i64 = s * s * 3 * 2;
        let vkb_si:i64 = vkb[si];
        let yy:i64 = 0;
        while (yy < bh) {
            let xx:i64 = 0;
            while (xx < bw) {
                let p:i64 = ((y + yy) * w + (x + xx)) * 3;
                let q:i64 = vkb_si + atom * kmb + (yy * s + xx) * 6;
                px[p] = px[p] - (mr + r_i16le(vbuf, q));
                px[p + 1] = px[p + 1] - (mg + r_i16le(vbuf, q + 2));
                px[p + 2] = px[p + 2] - (mb + r_i16le(vbuf, q + 4));
                claimed[(y + yy) * w + (x + xx)] = 1;
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        ti = ti + 1;
    }
    return;
}

// Subtract the LINES model (input-res: rmean + thin key) from px.
fn op_lines_commit(px:[]i64, w:i64, h:i64, vkb4:i64, K4:i64, vbuf:[]u8,
    ltakes:[]i64, nlt:i64, claimed:[]u8) void {
    let ti:i64 = 0;
    while (ti < nlt) {
        let lx:i64 = ltakes[ti * 7];
        let ly:i64 = ltakes[ti * 7 + 1];
        let atom:i64 = ltakes[ti * 7 + 2];
        let mr:i64 = ltakes[ti * 7 + 3];
        let mg:i64 = ltakes[ti * 7 + 4];
        let mb:i64 = ltakes[ti * 7 + 5];
        let kb:i64 = vkb4 + atom * 24;
        let dy:i64 = 0;
        while (dy < 2) {
            let dx:i64 = 0;
            while (dx < 2) {
                let p:i64 = ((ly + dy) * w + (lx + dx)) * 3;
                let q:i64 = kb + (dy * 2 + dx) * 6;
                px[p] = px[p] - (mr + r_i16le(vbuf, q));
                px[p + 1] = px[p + 1] - (mg + r_i16le(vbuf, q + 2));
                px[p + 2] = px[p + 2] - (mb + r_i16le(vbuf, q + 4));
                claimed[(ly + dy) * w + (lx + dx)] = 1;
                dx = dx + 1;
            }
            dy = dy + 1;
        }
        ti = ti + 1;
    }
    return;
}

// ---- LINES (thin atoms, via the matcher unit) ----
// Measured Sobel strong-edge pixels select 2x2 input blocks; each block
// is matched against the shared THIN atoms via m_thin_match. Taken iff
// gain >= cfg[1] per value. NO walks, NO DDA, NO Bresenham.
// claimed[]: pixels already taken by the earlier layer in the cascade.
// ltakes rows (stride 7): lx,ly,atom,mr,mg,mb,gain.
// gout[0]=G_l, nout[0]=N_l.
fn op_lines_build(px:[]i64, w:i64, h:i64, claimed:[]u8,
    vkb4:i64, K4:i64, vbuf:[]u8, cfg:[]i64,
    ltakes:[]i64, nltout:[]i64, gout:[]i64, nout:[]i64) i64 {
    let lum:[]i64 = nio_alloc((w * h * 8) as i32) as []i64;
    if (lum.len == 0) { return 1; }
    tl_luminance(px, w * h, lum);
    let strong:[]u8 = nio_alloc((w * h) as i32);
    if (strong.len == 0) { return 2; }
    // measured Sobel strong edges (same predicate azgen used)
    let y:i64 = 1;
    while (y < h - 1) {
        let x:i64 = 1;
        while (x < w - 1) {
            let c:i64 = y * w + x;
            let gx:i64 = (lum[c - w + 1] - lum[c - w - 1])
                + 2 * (lum[c + 1] - lum[c - 1])
                + (lum[c + w + 1] - lum[c + w - 1]);
            let gy:i64 = (lum[c + w - 1] - lum[c - w - 1])
                + 2 * (lum[c + w] - lum[c - w])
                + (lum[c + w + 1] - lum[c - w + 1]);
            let agx:i64 = gx;
            if (agx < 0) { agx = 0 - agx; }
            let agy:i64 = gy;
            if (agy < 0) { agy = 0 - agy; }
            if (agx + agy >= 27) { strong[c] = 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    let taken2:[]u8 = nio_alloc((w * h) as i32);
    if (taken2.len == 0) { return 3; }
    let aout:[]i64 = nio_alloc(8) as []i64;
    let mout:[]i64 = nio_alloc(24) as []i64;
    if (aout.len == 0) { return 4; }
    let G:i64 = 0;
    let N:i64 = 0;
    let nlt:i64 = 0;
    let bar:i64 = cfg[1] * 12;
    let ly:i64 = 0;
    while (ly < h - 1) {
        let lx:i64 = 0;
        while (lx < w - 1) {
            let q0:i64 = ly * w + lx;
            let has_edge:i64 = 0;
            if (strong[q0] == 1) { has_edge = 1; }
            if (strong[q0 + 1] == 1) { has_edge = 1; }
            if (strong[q0 + w] == 1) { has_edge = 1; }
            if (strong[q0 + w + 1] == 1) { has_edge = 1; }
            if (has_edge == 1) {
                if (claimed[q0] == 0) {
                    if (claimed[q0 + 1] == 0) {
                        if (claimed[q0 + w] == 0) {
                            if (claimed[q0 + w + 1] == 0) {
                                if (taken2[q0] == 0) {
                                    let gain:i64 = m_thin_match(px, w, lx, ly,
                                        vkb4, K4, vbuf, cfg, aout, mout);
                                    if (gain >= bar) {
                                        ltakes[nlt * 7] = lx;
                                        ltakes[nlt * 7 + 1] = ly;
                                        ltakes[nlt * 7 + 2] = aout[0];
                                        ltakes[nlt * 7 + 3] = mout[0];
                                        ltakes[nlt * 7 + 4] = mout[1];
                                        ltakes[nlt * 7 + 5] = mout[2];
                                        ltakes[nlt * 7 + 6] = gain;
                                        nlt = nlt + 1;
                                        taken2[q0] = 1;
                                        taken2[q0 + 1] = 1;
                                        taken2[q0 + w] = 1;
                                        taken2[q0 + w + 1] = 1;
                                        G = G + gain;
                                        N = N + 12;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            lx = lx + 1;
        }
        ly = ly + 1;
    }
    nltout[0] = nlt;
    gout[0] = G;
    nout[0] = N;
    nio_free(lum); nio_free(strong); nio_free(taken2);
    nio_free(aout); nio_free(mout);
    return 0;
}

// ---- 2x construction ----
// Renders the committed layers into acc (i64, W*H*3), lab (u8, W*H).
// Every constructed pixel = measured region mean + measured atom deviation.
fn op_render_shapes(acc:[]i64, lab:[]u8, W:i64, H:i64,
    vS:[]i64, vab:[]i64, vbuf:[]u8,
    takes:[]i64, nt:i64) void {
    let ti:i64 = 0;
    while (ti < nt) {
        let x:i64 = takes[ti * 9];
        let y:i64 = takes[ti * 9 + 1];
        let bw:i64 = takes[ti * 9 + 2];
        let bh:i64 = takes[ti * 9 + 3];
        let si:i64 = takes[ti * 9 + 4];
        let atom:i64 = takes[ti * 9 + 5];
        let mr:i64 = takes[ti * 9 + 6];
        let mg:i64 = takes[ti * 9 + 7];
        let mb:i64 = takes[ti * 9 + 8];
        let S:i64 = vS[si];
        let ab:i64 = vab[si] + atom * (S * S * 3 * 2);
        let oy:i64 = 0;
        while (oy < 2 * bh) {
            let ox:i64 = 0;
            while (ox < 2 * bw) {
                let OX:i64 = 2 * x + ox;
                let OY:i64 = 2 * y + oy;
                let p:i64 = OY * W + OX;
                if (lab[p] == 4) {
                    let q:i64 = ab + (oy * S + ox) * 6;
                    acc[p * 3] = mr + r_i16le(vbuf, q);
                    acc[p * 3 + 1] = mg + r_i16le(vbuf, q + 2);
                    acc[p * 3 + 2] = mb + r_i16le(vbuf, q + 4);
                    lab[p] = 3;
                }
                ox = ox + 1;
            }
            oy = oy + 1;
        }
        ti = ti + 1;
    }
    return;
}

fn op_render_lines(acc:[]i64, lab:[]u8, W:i64, H:i64,
    vab4:i64, vbuf:[]u8, ltakes:[]i64, nlt:i64) void {
    let ti:i64 = 0;
    while (ti < nlt) {
        let lx:i64 = ltakes[ti * 7];
        let ly:i64 = ltakes[ti * 7 + 1];
        let atom:i64 = ltakes[ti * 7 + 2];
        let mr:i64 = ltakes[ti * 7 + 3];
        let mg:i64 = ltakes[ti * 7 + 4];
        let mb:i64 = ltakes[ti * 7 + 5];
        let ab:i64 = vab4 + atom * 96;
        let ay:i64 = 0;
        while (ay < 4) {
            let ax:i64 = 0;
            while (ax < 4) {
                // odd positions only; even positions are KNOWN
                if ((ax + ay) % 2 == 1) {
                    let OX:i64 = 2 * lx + ax;
                    let OY:i64 = 2 * ly + ay;
                    let p:i64 = OY * W + OX;
                    if (lab[p] == 4) {
                        let q:i64 = ab + (ay * 4 + ax) * 6;
                        acc[p * 3] = mr + r_i16le(vbuf, q);
                        acc[p * 3 + 1] = mg + r_i16le(vbuf, q + 2);
                        acc[p * 3 + 2] = mb + r_i16le(vbuf, q + 4);
                        lab[p] = 2;
                    }
                }
                ax = ax + 1;
            }
            ay = ay + 1;
        }
        ti = ti + 1;
    }
    return;
}

// ---------------- UPSCALE-2X UNIT ----------------
// op_upscale2x: the azgen generation path as a callable unit.
// src: w*h*3 i64 RGB (observed). Renders into acc (W*H*3 i64, clamped)
// and lab (W*H u8); W=2*w, H=2*h (caller allocates both).
// trace/tout: deliberation text. Returns 0 ok, nonzero on failure.
fn op_upscale2x(src:[]i64, w:i64, h:i64,
    vS:[]i64, vK:[]i64, vab:[]i64, vkb:[]i64, vbuf:[]u8, cfg:[]i64,
    acc:[]i64, lab:[]u8, W:i64, H:i64,
    trace:[]u8, to:i64, tout:[]i64) i64 {
    let disc:i64 = cfg[0];
    to = op_puts(trace, to, "UPSCALE-2X unit: input ");
    to = op_puti(trace, to, w);
    to = op_puts(trace, to, "x");
    to = op_puti(trace, to, h);
    to = op_puts(trace, to, " -> ");
    to = op_puti(trace, to, W);
    to = op_puts(trace, to, "x");
    to = op_puti(trace, to, H);
    to = op_puts(trace, to, "; matcher discipline ");
    to = op_puti(trace, to, disc);
    to = op_puts(trace, to, ", bar ");
    to = op_puti(trace, to, cfg[1]);
    to = op_puts(trace, to, "/value\n");
    if (disc != 0) {
        to = op_puts(trace, to, "REFUSED: matcher discipline not implemented\n");
        tout[0] = to;
        return 7;
    }
    let npix:i64 = w * h;
    let px:[]i64 = nio_alloc((npix * 3 * 8) as i32) as []i64;
    let orig:[]i64 = nio_alloc((npix * 3 * 8) as i32) as []i64;
    if (px.len == 0) { tout[0] = to; return 1; }
    let i:i64 = 0;
    while (i < npix * 3) { px[i] = src[i]; orig[i] = src[i]; i = i + 1; }

    // ---- survey / affinities (measured) ----
    let s_out:[]i64 = nio_alloc(48) as []i64;
    tl_survey_flat(px, w, h, s_out);
    let E64:i64 = s_out[0]; let E32:i64 = s_out[1];
    let E16:i64 = s_out[2]; let E8:i64 = s_out[3]; let E4:i64 = s_out[4];
    let Etot:i64 = s_out[5];
    let lum_s:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    tl_luminance(px, npix, lum_s);
    let hist_s:[]i64 = nio_alloc(512) as []i64;
    let dum:[]i64 = nio_alloc(8) as []i64;
    let edgepx_s:[]i64 = nio_alloc(8) as []i64;
    tl_walks(lum_s, w, h, 27, 1, 0, dum, dum, dum, dum, dum, 0, hist_s, edgepx_s);
    let straight:i64 = 0;
    let hli:i64 = 16;
    while (hli < 64) { straight = straight + hli * hist_s[hli]; hli = hli + 1; }
    let aff_h:i64 = 0; let aff_l:i64 = 0;
    if (Etot > 0) { aff_h = (1000 * (E64 - E4)) / Etot; }
    if (npix > 0) { aff_l = (1000 * straight) / npix; }
    nio_free(lum_s); nio_free(hist_s); nio_free(dum); nio_free(edgepx_s);
    to = op_puts(trace, to, "survey: E64=");
    to = op_puti(trace, to, E64);
    to = op_puts(trace, to, " E32=");
    to = op_puti(trace, to, E32);
    to = op_puts(trace, to, " Etot=");
    to = op_puti(trace, to, Etot);
    to = op_puts(trace, to, "\naffinities x100: SHAPES=");
    to = op_puti(trace, to, aff_h);
    to = op_puts(trace, to, " LINES=");
    to = op_puti(trace, to, aff_l);
    to = op_puts(trace, to, "\n");

    let shapes_first:i64 = 1;
    if (aff_l > aff_h) { shapes_first = 0; }
    to = op_puts(trace, to, "order: ");
    if (shapes_first == 1) {
        to = op_puts(trace, to, "SHAPES->LINES\n");
    } else {
        to = op_puts(trace, to, "LINES->SHAPES\n");
    }

    // ---- cascade workspace ----
    let claimed:[]u8 = nio_alloc((npix) as i32);
    if (claimed.len == 0) { tout[0] = to; return 2; }
    let ntmax:i64 = npix / 16 + 64;
    let nnmax:i64 = npix / 1024 + 64;
    let nltmax:i64 = npix / 4 + 64;
    let takes:[]i64 = nio_alloc((ntmax * 9 * 8) as i32) as []i64;
    let ntout:[]i64 = nio_alloc(8) as []i64;
    let nofits:[]i64 = nio_alloc((nnmax * 4 * 8) as i32) as []i64;
    let nnout:[]i64 = nio_alloc(8) as []i64;
    let ltakes:[]i64 = nio_alloc((nltmax * 7 * 8) as i32) as []i64;
    let nltout:[]i64 = nio_alloc(8) as []i64;
    let gout:[]i64 = nio_alloc(8) as []i64;
    let nout:[]i64 = nio_alloc(8) as []i64;
    let mscratch:[]i64 = nio_alloc(8) as []i64;
    if (takes.len == 0) { tout[0] = to; return 3; }

    let shapes_committed:i64 = 0;
    let lines_committed:i64 = 0;
    let Gh:i64 = 0; let Nh:i64 = 0;
    let Gl:i64 = 0; let Nl:i64 = 0;

    if (shapes_first == 1) {
        ntout[0] = 0; nnout[0] = 0;
        let nbx:i64 = (w + 31) / 32;
        let nby:i64 = (h + 31) / 32;
        let by:i64 = 0;
        while (by < nby) {
            let bx:i64 = 0;
            while (bx < nbx) {
                let bw:i64 = 32;
                if (bx * 32 + bw > w) { bw = w - bx * 32; }
                let bh:i64 = 32;
                if (by * 32 + bh > h) { bh = h - by * 32; }
                let g:i64 = op_shapes_fit(px, w, h, bx * 32, by * 32, bw, bh, 0,
                    vS, vK, vab, vkb, vbuf, cfg, mscratch,
                    takes, ntout, nofits, nnout);
                Gh = Gh + g;
                Nh = Nh + bw * bh * 3;
                bx = bx + 1;
            }
            by = by + 1;
        }
        let nt:i64 = ntout[0];
        to = op_puts(trace, to, "SHAPES: G=");
        to = op_puti(trace, to, Gh);
        to = op_puts(trace, to, " N=");
        to = op_puti(trace, to, Nh);
        to = op_puts(trace, to, " takes=");
        to = op_puti(trace, to, nt);
        to = op_puts(trace, to, " nofits=");
        to = op_puti(trace, to, nnout[0]);
        to = op_puts(trace, to, "\n");
        if (Nh > 0) {
            if (Gh >= cfg[1] * Nh) {
                shapes_committed = 1;
                op_shapes_commit(px, w, h, vS, vK, vab, vkb, vbuf,
                    takes, nt, claimed);
                to = op_puts(trace, to, "SHAPES COMMITTED\n");
            } else {
                to = op_puts(trace, to, "SHAPES REVERTED (G < bar*N)\n");
            }
        }
        let lrc:i64 = op_lines_build(px, w, h, claimed,
            vkb[4], vK[4], vbuf, cfg, ltakes, nltout, gout, nout);
        if (lrc != 0) { tout[0] = to; return 4; }
        Gl = gout[0]; Nl = nout[0];
        to = op_puts(trace, to, "LINES: G=");
        to = op_puti(trace, to, Gl);
        to = op_puts(trace, to, " N=");
        to = op_puti(trace, to, Nl);
        to = op_puts(trace, to, " takes=");
        to = op_puti(trace, to, nltout[0]);
        to = op_puts(trace, to, "\n");
        if (Nl > 0) {
            if (Gl >= cfg[1] * Nl) {
                lines_committed = 1;
                op_lines_commit(px, w, h, vkb[4], vK[4], vbuf,
                    ltakes, nltout[0], claimed);
                to = op_puts(trace, to, "LINES COMMITTED\n");
            } else {
                to = op_puts(trace, to, "LINES REVERTED (G < bar*N)\n");
            }
        }
    } else {
        let lrc:i64 = op_lines_build(px, w, h, claimed,
            vkb[4], vK[4], vbuf, cfg, ltakes, nltout, gout, nout);
        if (lrc != 0) { tout[0] = to; return 4; }
        Gl = gout[0]; Nl = nout[0];
        to = op_puts(trace, to, "LINES: G=");
        to = op_puti(trace, to, Gl);
        to = op_puts(trace, to, " N=");
        to = op_puti(trace, to, Nl);
        to = op_puts(trace, to, " takes=");
        to = op_puti(trace, to, nltout[0]);
        to = op_puts(trace, to, "\n");
        if (Nl > 0) {
            if (Gl >= cfg[1] * Nl) {
                lines_committed = 1;
                op_lines_commit(px, w, h, vkb[4], vK[4], vbuf,
                    ltakes, nltout[0], claimed);
                to = op_puts(trace, to, "LINES COMMITTED\n");
            } else {
                to = op_puts(trace, to, "LINES REVERTED (G < bar*N)\n");
            }
        }
        ntout[0] = 0; nnout[0] = 0;
        let nbx:i64 = (w + 31) / 32;
        let nby:i64 = (h + 31) / 32;
        let by:i64 = 0;
        while (by < nby) {
            let bx:i64 = 0;
            while (bx < nbx) {
                let bw:i64 = 32;
                if (bx * 32 + bw > w) { bw = w - bx * 32; }
                let bh:i64 = 32;
                if (by * 32 + bh > h) { bh = h - by * 32; }
                let skip:i64 = 0;
                let yy:i64 = 0;
                while (yy < bh) {
                    let xx:i64 = 0;
                    while (xx < bw) {
                        if (claimed[(by*32+yy)*w + (bx*32+xx)] == 1) { skip = 1; }
                        xx = xx + 1;
                    }
                    yy = yy + 1;
                }
                if (skip == 0) {
                    let g:i64 = op_shapes_fit(px, w, h, bx * 32, by * 32, bw, bh, 0,
                        vS, vK, vab, vkb, vbuf, cfg, mscratch,
                        takes, ntout, nofits, nnout);
                    Gh = Gh + g;
                    Nh = Nh + bw * bh * 3;
                } else {
                    let nn:i64 = nnout[0];
                    nofits[nn * 4] = bx * 32;
                    nofits[nn * 4 + 1] = by * 32;
                    nofits[nn * 4 + 2] = bw;
                    nofits[nn * 4 + 3] = bh;
                    nnout[0] = nn + 1;
                }
                bx = bx + 1;
            }
            by = by + 1;
        }
        let nt:i64 = ntout[0];
        to = op_puts(trace, to, "SHAPES: G=");
        to = op_puti(trace, to, Gh);
        to = op_puts(trace, to, " N=");
        to = op_puti(trace, to, Nh);
        to = op_puts(trace, to, " takes=");
        to = op_puti(trace, to, nt);
        to = op_puts(trace, to, " nofits=");
        to = op_puti(trace, to, nnout[0]);
        to = op_puts(trace, to, "\n");
        if (Nh > 0) {
            if (Gh >= cfg[1] * Nh) {
                shapes_committed = 1;
                op_shapes_commit(px, w, h, vS, vK, vab, vkb, vbuf,
                    takes, nt, claimed);
                to = op_puts(trace, to, "SHAPES COMMITTED\n");
            } else {
                to = op_puts(trace, to, "SHAPES REVERTED (G < bar*N)\n");
            }
        }
    }

    // ---- 2x construction ----
    let li:i64 = 0;
    while (li < W * H) { lab[li] = 4; li = li + 1; }
    if (shapes_committed == 1) {
        op_render_shapes(acc, lab, W, H, vS, vab, vbuf, takes, ntout[0]);
    }
    if (lines_committed == 1) {
        op_render_lines(acc, lab, W, H, vab[4], vbuf, ltakes, nltout[0]);
    }
    // KNOWN: even positions are the observed input
    let iy:i64 = 0;
    while (iy < h) {
        let ix:i64 = 0;
        while (ix < w) {
            let p:i64 = ((2 * iy) * W + 2 * ix);
            let q:i64 = (iy * w + ix) * 3;
            acc[p * 3] = orig[q];
            acc[p * 3 + 1] = orig[q + 1];
            acc[p * 3 + 2] = orig[q + 2];
            lab[p] = 0;
            ix = ix + 1;
        }
        iy = iy + 1;
    }
    // NO-FIT: measured region mean for rejected blocks, labeled 6.
    if (shapes_committed == 1) {
        let ni2:i64 = 0;
        while (ni2 < nnout[0]) {
            let nx:i64 = nofits[ni2 * 4];
            let ny:i64 = nofits[ni2 * 4 + 1];
            let nbw:i64 = nofits[ni2 * 4 + 2];
            let nbh:i64 = nofits[ni2 * 4 + 3];
            let mr:i64 = 0;
            let mg:i64 = 0;
            let mb:i64 = 0;
            let by:i64 = 0;
            while (by < nbh) {
                let bx:i64 = 0;
                while (bx < nbw) {
                    let q:i64 = ((ny + by) * w + (nx + bx)) * 3;
                    mr = mr + orig[q];
                    mg = mg + orig[q + 1];
                    mb = mb + orig[q + 2];
                    bx = bx + 1;
                }
                by = by + 1;
            }
            let n:i64 = nbw * nbh;
            mr = op_rdiv(mr, n); mg = op_rdiv(mg, n); mb = op_rdiv(mb, n);
            let oy:i64 = 0;
            while (oy < 2 * nbh) {
                let ox:i64 = 0;
                while (ox < 2 * nbw) {
                    let p2:i64 = (2 * ny + oy) * W + (2 * nx + ox);
                    if (lab[p2] == 4) {
                        acc[p2 * 3] = mr;
                        acc[p2 * 3 + 1] = mg;
                        acc[p2 * 3 + 2] = mb;
                        lab[p2] = 6;
                    }
                    ox = ox + 1;
                }
                oy = oy + 1;
            }
            ni2 = ni2 + 1;
        }
    } else {
        // SHAPES reverted: every block is NO-FIT -> measured 8x8 block means
        let p3:i64 = 0;
        while (p3 < W * H) {
            if (lab[p3] == 4) {
                let OX:i64 = p3 % W;
                let OY:i64 = p3 / W;
                let bx:i64 = (OX / 2) / 8 * 8;
                let by:i64 = (OY / 2) / 8 * 8;
                let mr:i64 = 0; let mg:i64 = 0; let mb:i64 = 0;
                let cy:i64 = 0;
                while (cy < 8) {
                    let cx:i64 = 0;
                    while (cx < 8) {
                        let q:i64 = ((by + cy) * w + (bx + cx)) * 3;
                        mr = mr + orig[q]; mg = mg + orig[q+1]; mb = mb + orig[q+2];
                        cx = cx + 1;
                    }
                    cy = cy + 1;
                }
                acc[p3 * 3] = op_rdiv(mr, 64);
                acc[p3 * 3 + 1] = op_rdiv(mg, 64);
                acc[p3 * 3 + 2] = op_rdiv(mb, 64);
                lab[p3] = 6;
            }
            p3 = p3 + 1;
        }
    }
    // INVENTED: measured 3x3 input-block mean for anything left, labeled 4.
    let p4:i64 = 0;
    while (p4 < W * H) {
        if (lab[p4] == 4) {
            let OX:i64 = p4 % W;
            let OY:i64 = p4 / W;
            let ix:i64 = OX / 2;
            let iy2:i64 = OY / 2;
            let x0:i64 = ix - 1; if (x0 < 0) { x0 = 0; }
            let y0:i64 = iy2 - 1; if (y0 < 0) { y0 = 0; }
            let x1:i64 = ix + 1; if (x1 >= w) { x1 = w - 1; }
            let y1:i64 = iy2 + 1; if (y1 >= h) { y1 = h - 1; }
            let mr:i64 = 0; let mg:i64 = 0; let mb:i64 = 0; let n:i64 = 0;
            let yy:i64 = y0;
            while (yy <= y1) {
                let xx:i64 = x0;
                while (xx <= x1) {
                    let q4:i64 = (yy * w + xx) * 3;
                    mr = mr + orig[q4]; mg = mg + orig[q4+1]; mb = mb + orig[q4+2];
                    n = n + 1;
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
            acc[p4 * 3] = op_rdiv(mr, n);
            acc[p4 * 3 + 1] = op_rdiv(mg, n);
            acc[p4 * 3 + 2] = op_rdiv(mb, n);
        }
        p4 = p4 + 1;
    }
    // clamp acc in place
    let p5:i64 = 0;
    while (p5 < W * H * 3) {
        if (acc[p5] < 0) { acc[p5] = 0; }
        if (acc[p5] > 255) { acc[p5] = 255; }
        p5 = p5 + 1;
    }
    // label census into the trace
    let lc0:i64 = 0; let lc2:i64 = 0; let lc3:i64 = 0;
    let lc4:i64 = 0; let lc6:i64 = 0;
    let pl:i64 = 0;
    while (pl < W * H) {
        let L:i64 = lab[pl] as i64;
        if (L == 0) { lc0 = lc0 + 1; }
        if (L == 2) { lc2 = lc2 + 1; }
        if (L == 3) { lc3 = lc3 + 1; }
        if (L == 4) { lc4 = lc4 + 1; }
        if (L == 6) { lc6 = lc6 + 1; }
        pl = pl + 1;
    }
    to = op_puts(trace, to, "labels: 0=");
    to = op_puti(trace, to, lc0);
    to = op_puts(trace, to, " 2=");
    to = op_puti(trace, to, lc2);
    to = op_puts(trace, to, " 3=");
    to = op_puti(trace, to, lc3);
    to = op_puts(trace, to, " 4=");
    to = op_puti(trace, to, lc4);
    to = op_puts(trace, to, " 6=");
    to = op_puti(trace, to, lc6);
    to = op_puts(trace, to, "\nUPSCALE-2X done\n");
    tout[0] = to;
    nio_free(px); nio_free(orig); nio_free(s_out);
    nio_free(claimed); nio_free(takes); nio_free(ntout);
    nio_free(nofits); nio_free(nnout); nio_free(ltakes);
    nio_free(nltout); nio_free(gout); nio_free(nout); nio_free(mscratch);
    return 0;
}

// azops.zag — general image operators driver (Crew C, 2026-09-27).
// Pure Zag, zero RNG, byte-identical reruns.
//
// Usage: azops_ops <indir> <outdir> <case-tag> <input.bmp> <goal words...>
//   indir:   holds the input BMP and vocab.bin
//   outdir:  receives OPS_TRACE.txt + result BMPs + label maps
//   case-tag: recorded in the trace (A, B, C2, C3, ...)
//   goal:    free-form English; TNN parses it, inspects the image, and
//            chooses UPSCALE-2X / UPSCALE-4X / EDIT-FILL with parameters.
//
// The driver accesses the matcher ONLY through the matcher unit's
// interface (m_shapes_match / m_thin_match / m_ring_match, selected by
// cfg[0]); a sibling crew's improved matcher replaces those functions
// without touching this driver.
@import("./opfill.zag")

// ---------- tiny string helpers ----------
fn zc_lower(dst:[]u8, src:[]u8, n:i64) void {
    let i:i64 = 0;
    while (i < n) {
        let c:i64 = src[i] as i64;
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        dst[i] = c as u8;
        i = i + 1;
    }
    return;
}

// substring test: 1 if needle (nl bytes) occurs in hay (hl bytes)
fn zc_contains(hay:[]u8, hl:i64, needle:[]u8) i64 {
    let nl:i64 = needle.len;
    if (nl == 0) { return 0; }
    if (nl > hl) { return 0; }
    let i:i64 = 0;
    while (i <= hl - nl) {
        let j:i64 = 0;
        let ok:i64 = 1;
        while (j < nl) {
            if (hay[i + j] != needle[j]) { ok = 0; }
            j = j + 1;
        }
        if (ok == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// ---------- goal parsing ----------
// fills the parse-output slots; returns uhits*1000000 + ehits.
fn zc_parse_goal(gl:[]u8, gn:i64,
    uhits:[]i64, ehits:[]i64, four:[]i64,
    has_left:[]i64, has_right:[]i64, has_top:[]i64, has_bottom:[]i64,
    has_center:[]i64, bright:[]i64,
    trace:[]u8, to:i64, tout:[]i64) i64 {
    to = op_puts(trace, to, "PARSE: goal words matched:\n");
    let uh:i64 = 0;
    let eh:i64 = 0;
    if (zc_contains(gl, gn, "upscal") == 1) { to = op_puts(trace, to, "  upscale-word: upscal\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "bigger") == 1) { to = op_puts(trace, to, "  upscale-word: bigger\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "enlarge") == 1) { to = op_puts(trace, to, "  upscale-word: enlarge\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "magnif") == 1) { to = op_puts(trace, to, "  upscale-word: magnif\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "zoom") == 1) { to = op_puts(trace, to, "  upscale-word: zoom\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "resolution") == 1) { to = op_puts(trace, to, "  upscale-word: resolution\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "2x") == 1) { to = op_puts(trace, to, "  upscale-word: 2x\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "4x") == 1) { to = op_puts(trace, to, "  upscale-word: 4x\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "four") == 1) { to = op_puts(trace, to, "  upscale-word: four\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "double") == 1) { to = op_puts(trace, to, "  upscale-word: double\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "twice") == 1) { to = op_puts(trace, to, "  upscale-word: twice\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "quadruple") == 1) { to = op_puts(trace, to, "  upscale-word: quadruple\n"); uh = uh + 1; }
    if (zc_contains(gl, gn, "remov") == 1) { to = op_puts(trace, to, "  edit-word: remov\n"); eh = eh + 1; }
    if (zc_contains(gl, gn, "delet") == 1) { to = op_puts(trace, to, "  edit-word: delet\n"); eh = eh + 1; }
    if (zc_contains(gl, gn, "erase") == 1) { to = op_puts(trace, to, "  edit-word: erase\n"); eh = eh + 1; }
    if (zc_contains(gl, gn, "inpaint") == 1) { to = op_puts(trace, to, "  edit-word: inpaint\n"); eh = eh + 1; }
    if (zc_contains(gl, gn, "fill in") == 1) { to = op_puts(trace, to, "  edit-word: fill in\n"); eh = eh + 1; }
    if (zc_contains(gl, gn, "take out") == 1) { to = op_puts(trace, to, "  edit-word: take out\n"); eh = eh + 1; }
    if (zc_contains(gl, gn, "get rid") == 1) { to = op_puts(trace, to, "  edit-word: get rid\n"); eh = eh + 1; }
    if (zc_contains(gl, gn, "clean up") == 1) { to = op_puts(trace, to, "  edit-word: clean up\n"); eh = eh + 1; }
    let f:i64 = 0;
    if (zc_contains(gl, gn, "4x") == 1) { f = 1; }
    if (zc_contains(gl, gn, "four") == 1) { f = 1; }
    if (zc_contains(gl, gn, "quadruple") == 1) { f = 1; }
    if (f == 1) { to = op_puts(trace, to, "  factor-word: four/4x\n"); }
    let L:i64 = 0; let R:i64 = 0; let T:i64 = 0; let Bo:i64 = 0; let C:i64 = 0;
    if (zc_contains(gl, gn, "top left") == 1) { T = 1; L = 1; to = op_puts(trace, to, "  position: top left\n"); }
    if (zc_contains(gl, gn, "top-left") == 1) { T = 1; L = 1; to = op_puts(trace, to, "  position: top-left\n"); }
    if (zc_contains(gl, gn, "topleft") == 1) { T = 1; L = 1; to = op_puts(trace, to, "  position: topleft\n"); }
    if (zc_contains(gl, gn, "upper left") == 1) { T = 1; L = 1; to = op_puts(trace, to, "  position: upper left\n"); }
    if (zc_contains(gl, gn, "top right") == 1) { T = 1; R = 1; to = op_puts(trace, to, "  position: top right\n"); }
    if (zc_contains(gl, gn, "top-right") == 1) { T = 1; R = 1; to = op_puts(trace, to, "  position: top-right\n"); }
    if (zc_contains(gl, gn, "topright") == 1) { T = 1; R = 1; to = op_puts(trace, to, "  position: topright\n"); }
    if (zc_contains(gl, gn, "upper right") == 1) { T = 1; R = 1; to = op_puts(trace, to, "  position: upper right\n"); }
    if (zc_contains(gl, gn, "bottom left") == 1) { Bo = 1; L = 1; to = op_puts(trace, to, "  position: bottom left\n"); }
    if (zc_contains(gl, gn, "bottom-left") == 1) { Bo = 1; L = 1; to = op_puts(trace, to, "  position: bottom-left\n"); }
    if (zc_contains(gl, gn, "bottomleft") == 1) { Bo = 1; L = 1; to = op_puts(trace, to, "  position: bottomleft\n"); }
    if (zc_contains(gl, gn, "lower left") == 1) { Bo = 1; L = 1; to = op_puts(trace, to, "  position: lower left\n"); }
    if (zc_contains(gl, gn, "bottom right") == 1) { Bo = 1; R = 1; to = op_puts(trace, to, "  position: bottom right\n"); }
    if (zc_contains(gl, gn, "bottom-right") == 1) { Bo = 1; R = 1; to = op_puts(trace, to, "  position: bottom-right\n"); }
    if (zc_contains(gl, gn, "bottomright") == 1) { Bo = 1; R = 1; to = op_puts(trace, to, "  position: bottomright\n"); }
    if (zc_contains(gl, gn, "lower right") == 1) { Bo = 1; R = 1; to = op_puts(trace, to, "  position: lower right\n"); }
    if (zc_contains(gl, gn, "center") == 1) { C = 1; to = op_puts(trace, to, "  position: center\n"); }
    if (zc_contains(gl, gn, "centre") == 1) { C = 1; to = op_puts(trace, to, "  position: centre\n"); }
    if (zc_contains(gl, gn, "middle") == 1) { C = 1; to = op_puts(trace, to, "  position: middle\n"); }
    if (zc_contains(gl, gn, " left") == 1) { L = 1; }
    if (zc_contains(gl, gn, "left ") == 1) { L = 1; }
    if (zc_contains(gl, gn, " right") == 1) { R = 1; }
    if (zc_contains(gl, gn, "right ") == 1) { R = 1; }
    if (zc_contains(gl, gn, " top") == 1) { T = 1; }
    if (zc_contains(gl, gn, "top ") == 1) { T = 1; }
    if (zc_contains(gl, gn, "upper") == 1) { T = 1; }
    if (zc_contains(gl, gn, " bottom") == 1) { Bo = 1; }
    if (zc_contains(gl, gn, "bottom ") == 1) { Bo = 1; }
    if (zc_contains(gl, gn, "lower") == 1) { Bo = 1; }
    let br:i64 = 0;
    if (zc_contains(gl, gn, "brightest") == 1) { br = 1; to = op_puts(trace, to, "  target: brightest\n"); }
    if (zc_contains(gl, gn, "darkest") == 1) { br = 2; to = op_puts(trace, to, "  target: darkest\n"); }
    to = op_puts(trace, to, "  => upscale-hits=");
    to = op_puti(trace, to, uh);
    to = op_puts(trace, to, " edit-hits=");
    to = op_puti(trace, to, eh);
    to = op_puts(trace, to, "\n");
    uhits[0] = uh; ehits[0] = eh; four[0] = f;
    has_left[0] = L; has_right[0] = R; has_top[0] = T;
    has_bottom[0] = Bo; has_center[0] = C; bright[0] = br;
    tout[0] = to;
    return uh * 1000000 + eh;
}

// ---------- image inspection ----------
// brightest/darkest 16x16 block (step 4), edge density per mille, mean lum.
fn zc_inspect(px:[]i64, w:i64, h:i64, lum:[]i64,
    bout:[]i64, dout:[]i64, edout:[]i64, mlout:[]i64) void {
    tl_luminance(px, w * h, lum);
    let bbx:i64 = 0; let bby:i64 = 0; let bval:i64 = -1;
    let ddx:i64 = 0; let ddy:i64 = 0; let dval:i64 = 999999999;
    let msum:i64 = 0;
    let by:i64 = 0;
    while (by <= h - 16) {
        let bx:i64 = 0;
        while (bx <= w - 16) {
            let s:i64 = 0;
            let yy:i64 = 0;
            while (yy < 16) {
                let xx:i64 = 0;
                while (xx < 16) {
                    s = s + lum[(by + yy) * w + (bx + xx)];
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
            if (s > bval) { bval = s; bbx = bx; bby = by; }
            if (s < dval) { dval = s; ddx = bx; ddy = by; }
            bx = bx + 4;
        }
        by = by + 4;
    }
    let i:i64 = 0;
    while (i < w * h) { msum = msum + lum[i]; i = i + 1; }
    // measured Sobel strong-edge density (same predicate as the LINES layer)
    let strong:i64 = 0;
    let y:i64 = 1;
    while (y < h - 1) {
        let x:i64 = 1;
        while (x < w - 1) {
            let c:i64 = y * w + x;
            let gx:i64 = (lum[c - w + 1] - lum[c - w - 1])
                + 2 * (lum[c + 1] - lum[c - 1])
                + (lum[c + w + 1] - lum[c - w - 1]);
            let gy:i64 = (lum[c + w - 1] - lum[c - w - 1])
                + 2 * (lum[c + w] - lum[c - w])
                + (lum[c + w + 1] - lum[c - w + 1]);
            let agx:i64 = gx;
            if (agx < 0) { agx = 0 - agx; }
            let agy:i64 = gy;
            if (agy < 0) { agy = 0 - agy; }
            if (agx + agy >= 27) { strong = strong + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    bout[0] = bbx; bout[1] = bby; bout[2] = bval / 256;
    dout[0] = ddx; dout[1] = ddy; dout[2] = dval / 256;
    edout[0] = (1000 * strong) / (w * h);
    mlout[0] = msum / (w * h);
    return;
}

// ---------- mask proposal (TNN's own proposal from goal + inspection) ----------
// mout: mx,my,mw,mh. Returns 0 ok, 1 no valid mask.
fn zc_propose_mask(w:i64, h:i64,
    has_left:i64, has_right:i64, has_top:i64, has_bottom:i64, has_center:i64,
    bright:i64, bbx:i64, bby:i64, ddx:i64, ddy:i64,
    px:[]i64, mout:[]i64, trace:[]u8, to:i64, tout:[]i64) i64 {
    let mx:i64 = 0; let my:i64 = 0; let mw:i64 = 0; let mh:i64 = 0;
    to = op_puts(trace, to, "MASK-PROPOSAL: ");
    if (bright == 1) {
        to = op_puts(trace, to, "goal names the brightest spot; measured brightest 16x16 at (");
        to = op_puti(trace, to, bbx);
        to = op_puts(trace, to, ",");
        to = op_puti(trace, to, bby);
        to = op_puts(trace, to, "); proposing 48x48 around it\n");
        if (w < 48) { tout[0] = to; return 1; }
        if (h < 48) { tout[0] = to; return 1; }
        mx = bbx + 8 - 24;
        if (mx < 0) { mx = 0; }
        if (mx + 48 > w) { mx = w - 48; }
        my = bby + 8 - 24;
        if (my < 0) { my = 0; }
        if (my + 48 > h) { my = h - 48; }
        mw = 48; mh = 48;
    } else {
        if (bright == 2) {
            to = op_puts(trace, to, "goal names the darkest spot; measured darkest 16x16 at (");
            to = op_puti(trace, to, ddx);
            to = op_puts(trace, to, ",");
            to = op_puti(trace, to, ddy);
            to = op_puts(trace, to, "); proposing 48x48 around it\n");
            if (w < 48) { tout[0] = to; return 1; }
            if (h < 48) { tout[0] = to; return 1; }
            mx = ddx + 8 - 24;
            if (mx < 0) { mx = 0; }
            if (mx + 48 > w) { mx = w - 48; }
            my = ddy + 8 - 24;
            if (my < 0) { my = 0; }
            if (my + 48 > h) { my = h - 48; }
            mw = 48; mh = 48;
        } else {
            let anypos:i64 = has_left + has_right + has_top + has_bottom + has_center;
            if (anypos > 0) {
                to = op_puts(trace, to, "goal names a position; proposing the zone rect\n");
                let x0:i64 = 0; let x1:i64 = w;
                let y0:i64 = 0; let y1:i64 = h;
                if (has_left == 1) { x0 = 0; x1 = w / 3; }
                if (has_right == 1) { x0 = (2 * w) / 3; x1 = w; }
                if (has_center == 1) {
                    if (has_left == 0) {
                        if (has_right == 0) { x0 = w / 3; x1 = (2 * w) / 3; }
                    }
                }
                if (has_top == 1) { y0 = 0; y1 = h / 2; }
                if (has_bottom == 1) { y0 = h / 2; y1 = h; }
                if (has_center == 1) {
                    if (has_top == 0) {
                        if (has_bottom == 0) { y0 = h / 4; y1 = (3 * h) / 4; }
                    }
                }
                mx = (x0 / 8) * 8;
                my = (y0 / 8) * 8;
                mw = ((x1 + 7) / 8) * 8 - mx;
                mh = ((y1 + 7) / 8) * 8 - my;
                if (mx + mw > w) { mw = w - mx; }
                if (my + mh > h) { mh = h - my; }
            }
            if (mw == 0) {
                // own proposal: the 64x64 cell (step 32) whose measured mean
                // deviates most from the measured global mean
                to = op_puts(trace, to, "goal names no position; TNN's own proposal: 64x64 cell of max |mean-deviation|\n");
                if (w < 64) { tout[0] = to; return 1; }
                if (h < 64) { tout[0] = to; return 1; }
                let gm:i64 = 0;
                let gi:i64 = 0;
                while (gi < w * h * 3) { gm = gm + px[gi]; gi = gi + 1; }
                gm = gm / (w * h * 3);
                let bestx:i64 = 0; let besty:i64 = 0; let bdev:i64 = -1;
                let cyy:i64 = 0;
                while (cyy <= h - 64) {
                    let cxx:i64 = 0;
                    while (cxx <= w - 64) {
                        let cm:i64 = 0;
                        let yy:i64 = 0;
                        while (yy < 64) {
                            let xx:i64 = 0;
                            while (xx < 64) {
                                let q:i64 = ((cyy + yy) * w + (cxx + xx)) * 3;
                                cm = cm + px[q] + px[q + 1] + px[q + 2];
                                xx = xx + 1;
                            }
                            yy = yy + 1;
                        }
                        cm = cm / (64 * 64 * 3);
                        let dev:i64 = cm - gm;
                        if (dev < 0) { dev = 0 - dev; }
                        if (dev > bdev) { bdev = dev; bestx = cxx; besty = cyy; }
                        cxx = cxx + 32;
                    }
                    cyy = cyy + 32;
                }
                mx = bestx; my = besty; mw = 64; mh = 64;
                to = op_puts(trace, to, "  own-proposal cell (");
                to = op_puti(trace, to, bestx);
                to = op_puts(trace, to, ",");
                to = op_puti(trace, to, besty);
                to = op_puts(trace, to, ") |dev|=");
                to = op_puti(trace, to, bdev);
                to = op_puts(trace, to, "\n");
            }
        }
    }
    // snap to the 8-grid the fill unit requires
    mx = (mx / 8) * 8;
    my = (my / 8) * 8;
    mw = (mw / 8) * 8;
    mh = (mh / 8) * 8;
    if (mw < 16) { tout[0] = to; return 1; }
    if (mh < 16) { tout[0] = to; return 1; }
    if (mw * mh * 10 >= w * h * 9) { tout[0] = to; return 1; }
    to = op_puts(trace, to, "  final mask (");
    to = op_puti(trace, to, mx);
    to = op_puts(trace, to, ",");
    to = op_puti(trace, to, my);
    to = op_puts(trace, to, ") ");
    to = op_puti(trace, to, mw);
    to = op_puts(trace, to, "x");
    to = op_puti(trace, to, mh);
    to = op_puts(trace, to, "\n");
    mout[0] = mx; mout[1] = my; mout[2] = mw; mout[3] = mh;
    tout[0] = to;
    return 0;
}

// clamp an i64 RGB image to a u8 RGB image
fn zc_tou8(dst:[]u8, src:[]i64, n:i64) void {
    let i:i64 = 0;
    while (i < n) {
        let v:i64 = src[i];
        if (v < 0) { v = 0; }
        if (v > 255) { v = 255; }
        dst[i] = v as u8;
        i = i + 1;
    }
    return;
}

fn main() i32 {
    let indir:[]u8 = _zag_arg(1);
    let outdir:[]u8 = _zag_arg(2);
    let casetag:[]u8 = _zag_arg(3);
    let inname:[]u8 = _zag_arg(4);
    if (_zag_strcmp(indir, "") == 1) {
        _zag_println("usage: azops_ops <indir> <outdir> <case> <input.bmp> <goal...>");
        return 1;
    }
    // goal = argv[5..] joined with single spaces
    let graw:[]u8 = nio_alloc(4096);
    if (graw.len == 0) { _zag_println("alloc graw failed"); return 1; }
    let gn:i64 = 0;
    let ai:i64 = 5;
    while (ai < 96) {
        let a:[]u8 = _zag_arg(ai);
        if (_zag_strcmp(a, "") == 1) { ai = 96; }
        if (ai < 96) {
            if (gn > 0) { graw[gn] = 32; gn = gn + 1; }
            let j:i64 = 0;
            while (j < a.len) { graw[gn] = a[j]; gn = gn + 1; j = j + 1; }
            ai = ai + 1;
        }
    }

    let root:i64 = nio_open_root(indir);
    if (root < 0) { _zag_println("cannot open indir"); return 1; }
    let oroot:i64 = nio_open_root(outdir);
    if (oroot < 0) { _zag_println("cannot open outdir"); nio_close(root); return 1; }

    // ---- vocabulary (shared, learned) ----
    let vbuf:[]u8 = nio_alloc(4194304);
    let vS:[]i64 = nio_alloc(40) as []i64;
    let vK:[]i64 = nio_alloc(40) as []i64;
    let vab:[]i64 = nio_alloc(40) as []i64;
    let vkb:[]i64 = nio_alloc(40) as []i64;
    let nread:[]i64 = nio_alloc(8) as []i64;
    if (vbuf.len == 0) { _zag_println("alloc vbuf failed"); return 1; }
    let vrc:i64 = op_vocab_load(root, vbuf, 4194304, vS, vK, vab, vkb, nread);
    if (vrc != 0) { _zag_println("vocab load failed"); return 1; }

    // ---- input ----
    let pxmax:i64 = 1024 * 1024 * 3;
    let px:[]i64 = nio_alloc((pxmax * 8) as i32) as []i64;
    if (px.len == 0) { _zag_println("alloc px failed"); return 1; }
    let hout:[]i64 = nio_alloc(8) as []i64;
    let w:i64 = op_load_bmp(root, inname, px, pxmax, hout);
    if (w < 0) { _zag_println("input load failed"); return 1; }
    let h:i64 = hout[0];
    let npix:i64 = w * h;

    // ---- matcher discipline config ----
    // cfg[0]: 0 = current key-SSD discipline; 1 = reserved for the sibling
    //   crew's improved matcher (replaces m_shapes_match/m_thin_match/
    //   m_ring_match only; this driver is untouched).
    // cfg[1]: the 9/value take bar (same as azgen's frozen HONEST_RESULT).
    let cfg:[]i64 = nio_alloc(16) as []i64;
    cfg[0] = 0;
    cfg[1] = 9;

    let trace:[]u8 = nio_alloc(1048576);
    if (trace.len == 0) { _zag_println("alloc trace failed"); return 1; }
    let tout:[]i64 = nio_alloc(8) as []i64;
    let to:i64 = 0;
    to = op_puts(trace, to, "AZOPS TRACE - general image operators (Crew C, 2026-09-27)\n");
    to = op_puts(trace, to, "pure Zag, zero RNG, byte-identical reruns.\n");
    to = op_puts(trace, to, "case: ");
    to = op_puts(trace, to, casetag);
    to = op_puts(trace, to, "\ngoal: \"");
    to = op_puts(trace, to, graw[0..gn]);
    to = op_puts(trace, to, "\"\ninput: ");
    to = op_puts(trace, to, inname);
    to = op_puts(trace, to, " ");
    to = op_puti(trace, to, w);
    to = op_puts(trace, to, "x");
    to = op_puti(trace, to, h);
    to = op_puts(trace, to, "\nmatcher: discipline ");
    to = op_puti(trace, to, cfg[0]);
    to = op_puts(trace, to, " (0=current key-SSD best-wins; 1=reserved for sibling crew's matcher), bar ");
    to = op_puti(trace, to, cfg[1]);
    to = op_puts(trace, to, "/value\n");
    to = op_puts(trace, to, "law: generation only from LEARNED atoms + measured means; no procedural\n");
    to = op_puts(trace, to, "texture synthesis, no crew-designed drawing, no bicubic in any generation path.\n");

    // ---- survey (measured) ----
    let s_out:[]i64 = nio_alloc(48) as []i64;
    tl_survey_flat(px, w, h, s_out);

    // ---- inspection (measured) ----
    let lum:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    let bout:[]i64 = nio_alloc(24) as []i64;
    let dout:[]i64 = nio_alloc(24) as []i64;
    let edout:[]i64 = nio_alloc(8) as []i64;
    let mlout:[]i64 = nio_alloc(8) as []i64;
    zc_inspect(px, w, h, lum, bout, dout, edout, mlout);
    to = op_puts(trace, to, "INSPECTION (measured, no goal words used):\n");
    to = op_puts(trace, to, "  E64=");
    to = op_puti(trace, to, s_out[0]);
    to = op_puts(trace, to, " E32=");
    to = op_puti(trace, to, s_out[1]);
    to = op_puts(trace, to, " E16=");
    to = op_puti(trace, to, s_out[2]);
    to = op_puts(trace, to, " E8=");
    to = op_puti(trace, to, s_out[3]);
    to = op_puts(trace, to, " E4=");
    to = op_puti(trace, to, s_out[4]);
    to = op_puts(trace, to, " Etot=");
    to = op_puti(trace, to, s_out[5]);
    to = op_puts(trace, to, "\n  mean-luminance=");
    to = op_puti(trace, to, mlout[0]);
    to = op_puts(trace, to, " edge-density/1000=");
    to = op_puti(trace, to, edout[0]);
    to = op_puts(trace, to, "\n  brightest 16x16 at (");
    to = op_puti(trace, to, bout[0]);
    to = op_puts(trace, to, ",");
    to = op_puti(trace, to, bout[1]);
    to = op_puts(trace, to, ") mean=");
    to = op_puti(trace, to, bout[2]);
    to = op_puts(trace, to, "; darkest 16x16 at (");
    to = op_puti(trace, to, dout[0]);
    to = op_puts(trace, to, ",");
    to = op_puti(trace, to, dout[1]);
    to = op_puts(trace, to, ") mean=");
    to = op_puti(trace, to, dout[2]);
    to = op_puts(trace, to, "\n");

    // ---- parse the goal ----
    let gl:[]u8 = nio_alloc((gn + 1) as i32);
    zc_lower(gl, graw, gn);
    let uhits:[]i64 = nio_alloc(8) as []i64;
    let ehits:[]i64 = nio_alloc(8) as []i64;
    let four:[]i64 = nio_alloc(8) as []i64;
    let has_left:[]i64 = nio_alloc(8) as []i64;
    let has_right:[]i64 = nio_alloc(8) as []i64;
    let has_top:[]i64 = nio_alloc(8) as []i64;
    let has_bottom:[]i64 = nio_alloc(8) as []i64;
    let has_center:[]i64 = nio_alloc(8) as []i64;
    let bright:[]i64 = nio_alloc(8) as []i64;
    zc_parse_goal(gl, gn, uhits, ehits, four,
        has_left, has_right, has_top, has_bottom, has_center, bright,
        trace, to, tout);
    to = tout[0];

    // ---- mask proposal (needed to judge EDIT-FILL eligibility) ----
    let mout:[]i64 = nio_alloc(32) as []i64;
    let mrc:i64 = zc_propose_mask(w, h,
        has_left[0], has_right[0], has_top[0], has_bottom[0], has_center[0],
        bright[0], bout[0], bout[1], dout[0], dout[1],
        px, mout, trace, to, tout);
    to = tout[0];

    // ---- deliberation: operation choice ----
    to = op_puts(trace, to, "CONSIDERED:\n");
    to = op_puts(trace, to, "- UPSCALE-2X: applicable (image is non-degenerate); enlarges through the learned generation path.\n");
    to = op_puts(trace, to, "- UPSCALE-4X: applicable; two recursive learned 2x passes.\n");
    if (mrc == 0) {
        to = op_puts(trace, to, "- EDIT-FILL: applicable; a valid mask was proposed above.\n");
    } else {
        to = op_puts(trace, to, "- EDIT-FILL: not applicable; no valid mask could be proposed.\n");
    }
    to = op_puts(trace, to, "CHOICE: ");
    let op:i64 = 0;
    if (ehits[0] > uhits[0]) {
        if (mrc == 0) {
            op = 2;
            to = op_puts(trace, to, "EDIT-FILL. reason: the goal is an edit request (edit-hits ");
            to = op_puti(trace, to, ehits[0]);
            to = op_puts(trace, to, " > upscale-hits ");
            to = op_puti(trace, to, uhits[0]);
            to = op_puts(trace, to, ") and a valid mask was proposed.\n");
        } else {
            op = 0;
            to = op_puts(trace, to, "UPSCALE-2X (fallback). reason: the goal is an edit request but no valid mask\n");
            to = op_puts(trace, to, "could be proposed; the non-destructive default is UPSCALE-2X.\n");
        }
    } else {
        if (uhits[0] > ehits[0]) {
            if (four[0] == 1) {
                op = 1;
                to = op_puts(trace, to, "UPSCALE-4X. reason: the goal asks to enlarge (upscale-hits ");
                to = op_puti(trace, to, uhits[0]);
                to = op_puts(trace, to, " > edit-hits ");
                to = op_puti(trace, to, ehits[0]);
                to = op_puts(trace, to, ") and names a four/4x factor.\n");
            } else {
                op = 0;
                to = op_puts(trace, to, "UPSCALE-2X. reason: the goal asks to enlarge (upscale-hits ");
                to = op_puti(trace, to, uhits[0]);
                to = op_puts(trace, to, " > edit-hits ");
                to = op_puti(trace, to, ehits[0]);
                to = op_puts(trace, to, "); no four/4x factor word present.\n");
            }
        } else {
            op = 0;
            to = op_puts(trace, to, "UPSCALE-2X (default). reason: the goal names no recognizable operation\n");
            to = op_puts(trace, to, "(upscale-hits=");
            to = op_puti(trace, to, uhits[0]);
            to = op_puts(trace, to, " edit-hits=");
            to = op_puti(trace, to, ehits[0]);
            to = op_puts(trace, to, "); the non-destructive default is UPSCALE-2X.\n");
        }
    }

    // ---- execution ----
    let rc:i64 = 0;
    if (op == 0) {
        to = op_puts(trace, to, "EXECUTION: UPSCALE-2X\n");
        let W:i64 = 2 * w;
        let H:i64 = 2 * h;
        let acc:[]i64 = nio_alloc((W * H * 3 * 8) as i32) as []i64;
        let lab:[]u8 = nio_alloc((W * H) as i32);
        if (acc.len == 0) { _zag_println("alloc acc failed"); return 1; }
        rc = op_upscale2x(px, w, h, vS, vK, vab, vkb, vbuf, cfg,
            acc, lab, W, H, trace, to, tout);
        to = tout[0];
        let ob:[]u8 = nio_alloc((W * H * 3) as i32);
        zc_tou8(ob, acc, W * H * 3);
        bmp_write(oroot, "out_upscale2x.bmp", ob, W, H);
        file_write(oroot, "labels_2x.bin", lab);
        nio_free(acc); nio_free(lab); nio_free(ob);
        to = op_puts(trace, to, "RESULT: out_upscale2x.bmp + labels_2x.bin written; rc=");
        to = op_puti(trace, to, rc);
        to = op_puts(trace, to, "\n");
    }
    if (op == 1) {
        to = op_puts(trace, to, "EXECUTION: UPSCALE-4X (two recursive learned 2x passes)\n");
        to = op_puts(trace, to, "stage 1:\n");
        let W2:i64 = 2 * w;
        let H2:i64 = 2 * h;
        let acc1:[]i64 = nio_alloc((W2 * H2 * 3 * 8) as i32) as []i64;
        let lab1:[]u8 = nio_alloc((W2 * H2) as i32);
        if (acc1.len == 0) { _zag_println("alloc acc1 failed"); return 1; }
        rc = op_upscale2x(px, w, h, vS, vK, vab, vkb, vbuf, cfg,
            acc1, lab1, W2, H2, trace, to, tout);
        to = tout[0];
        if (rc != 0) {
            to = op_puts(trace, to, "RESULT: stage 1 failed; rc=");
            to = op_puti(trace, to, rc);
            to = op_puts(trace, to, "\n");
        } else {
            let ob1:[]u8 = nio_alloc((W2 * H2 * 3) as i32);
            zc_tou8(ob1, acc1, W2 * H2 * 3);
            bmp_write(oroot, "stage1_2x.bmp", ob1, W2, H2);
            nio_free(ob1);
            // the stage-1 construction becomes the stage-2 input (no resampling)
            let px2:[]i64 = nio_alloc((W2 * H2 * 3 * 8) as i32) as []i64;
            let ci:i64 = 0;
            while (ci < W2 * H2 * 3) { px2[ci] = acc1[ci]; ci = ci + 1; }
            nio_free(acc1); nio_free(lab1);
            to = op_puts(trace, to, "stage 2:\n");
            let W4:i64 = 2 * W2;
            let H4:i64 = 2 * H2;
            let acc2:[]i64 = nio_alloc((W4 * H4 * 3 * 8) as i32) as []i64;
            let lab2:[]u8 = nio_alloc((W4 * H4) as i32);
            if (acc2.len == 0) { _zag_println("alloc acc2 failed"); return 1; }
            rc = op_upscale2x(px2, W2, H2, vS, vK, vab, vkb, vbuf, cfg,
                acc2, lab2, W4, H4, trace, to, tout);
            to = tout[0];
            let ob2:[]u8 = nio_alloc((W4 * H4 * 3) as i32);
            zc_tou8(ob2, acc2, W4 * H4 * 3);
            bmp_write(oroot, "out_upscale4x.bmp", ob2, W4, H4);
            file_write(oroot, "labels_4x.bin", lab2);
            nio_free(px2); nio_free(acc2); nio_free(lab2); nio_free(ob2);
            to = op_puts(trace, to, "RESULT: stage1_2x.bmp + out_upscale4x.bmp + labels_4x.bin written; rc=");
            to = op_puti(trace, to, rc);
            to = op_puts(trace, to, "\n");
        }
    }
    if (op == 2) {
        let mx:i64 = mout[0];
        let my:i64 = mout[1];
        let mw:i64 = mout[2];
        let mh:i64 = mout[3];
        to = op_puts(trace, to, "EXECUTION: EDIT-FILL mask (");
        to = op_puti(trace, to, mx);
        to = op_puts(trace, to, ",");
        to = op_puti(trace, to, my);
        to = op_puts(trace, to, ") ");
        to = op_puti(trace, to, mw);
        to = op_puts(trace, to, "x");
        to = op_puti(trace, to, mh);
        to = op_puts(trace, to, "\n");
        let out:[]u8 = nio_alloc((npix * 3) as i32);
        let elab:[]u8 = nio_alloc((npix) as i32);
        if (out.len == 0) { _zag_println("alloc out failed"); return 1; }
        rc = op_edit_fill(px, w, h, mx, my, mw, mh, vS, vK, vab, vkb, vbuf, cfg,
            out, elab, trace, to, tout);
        to = tout[0];
        bmp_write(oroot, "out_editfill.bmp", out, w, h);
        file_write(oroot, "editfill_labels.bin", elab);
        // masked preview: the input with the mask region shown in magenta
        let mp:[]u8 = nio_alloc((npix * 3) as i32);
        zc_tou8(mp, px, npix * 3);
        let yy:i64 = my;
        while (yy < my + mh) {
            let xx:i64 = mx;
            while (xx < mx + mw) {
                let q:i64 = (yy * w + xx) * 3;
                mp[q] = 255; mp[q + 1] = 0; mp[q + 2] = 255;
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        bmp_write(oroot, "out_edit_masked.bmp", mp, w, h);
        nio_free(out); nio_free(elab); nio_free(mp);
        to = op_puts(trace, to, "RESULT: out_editfill.bmp + out_edit_masked.bmp + editfill_labels.bin written; rc=");
        to = op_puti(trace, to, rc);
        to = op_puts(trace, to, "\n");
        to = op_puts(trace, to, "note: no dB is claimed for edits; the result is judged by eyes, not metrics.\n");
    }

    to = op_puts(trace, to, "END OF TRACE\n");
    let wrc:i64 = file_write(oroot, "OPS_TRACE.txt", trace[0..to]);
    if (wrc < 0) { _zag_println("trace write failed"); return 1; }
    nio_close(root);
    nio_close(oroot);
    return 0;
}

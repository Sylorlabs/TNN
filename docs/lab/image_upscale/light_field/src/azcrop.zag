// azcrop.zag — sky crop tool for the LIGHT-FIELD battery (frozen protocol).
// Reads docs/lab/image_upscale/generation/run_sky_1/gt.bmp (768x512 real
// photo), crops rows 0..183 (top 512x184; the gradient-dominant sky part of
// the frame; sized to the committed binary's frozen 256x92 input protocol),
// then 2x2 box-downscales (round-half-up, the documented azprep filter:
// (a+b+c+d+2)/4 per channel) to a 256x92 input.
// Writes skycrop_512x184.bmp (held GT for this battery image) and
// skycrop_input_256x92.bmp (ALL the construction sees).
// Pure Zag, zero RNG, pinned toolchain. argv: 1=indir 2=outdir.
@import("./common_az.zag")

fn main() i32 {
    let ind:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    if (_zag_strcmp(ind, "") == 1) { ind = "."; }
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let root:i64 = nio_open_root(ind);
    if (root < 0) { _zag_println("cannot open indir"); return 1; }
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { _zag_println("cannot open outdir"); return 1; }

    let fbuf:[]u8 = file_read_all(root, "gt.bmp", 2000000);
    if (fbuf.len < 54) { _zag_println("short gt.bmp"); return 1; }
    if (fbuf[0] != 66 || fbuf[1] != 77) { _zag_println("not BM"); return 1; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    if (w != 768 || h != 512) { _zag_println("need 768x512 gt.bmp"); return 1; }
    if (r_u16le(fbuf, 28) != 24) { _zag_println("need 24bpp"); return 1; }
    if (r_u32le(fbuf, 30) != 0) { _zag_println("need uncompressed"); return 1; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;

    // crop rows 0..183 (top), RGB top-down
    let cw:i64 = 512;
    let ch:i64 = 184;
    let crop:[]u8 = nio_alloc((cw * ch * 3) as i32);
    if (crop.len == 0) { _zag_println("alloc crop failed"); return 1; }
    let y:i64 = 0;
    while (y < ch) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < cw) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * cw + x) * 3;
            crop[p] = fbuf[q + 2];
            crop[p + 1] = fbuf[q + 1];
            crop[p + 2] = fbuf[q];
            x = x + 1;
        }
        y = y + 1;
    }
    let rc1:i64 = bmp_write(oroot, "skycrop_512x184.bmp", crop, cw, ch);
    if (rc1 != 0) { _zag_println("crop bmp write failed"); return 1; }

    // 2x2 box downscale, round-half-up, per channel
    let sw:i64 = cw / 2;
    let sh:i64 = ch / 2;
    let sm:[]u8 = nio_alloc((sw * sh * 3) as i32);
    if (sm.len == 0) { _zag_println("alloc sm failed"); return 1; }
    let oy:i64 = 0;
    while (oy < sh) {
        let ox:i64 = 0;
        while (ox < sw) {
            let c:i64 = 0;
            while (c < 3) {
                let a:i64 = crop[((2 * oy) * cw + 2 * ox) * 3 + c] as i64;
                let b:i64 = crop[((2 * oy) * cw + 2 * ox + 1) * 3 + c] as i64;
                let cc:i64 = crop[((2 * oy + 1) * cw + 2 * ox) * 3 + c] as i64;
                let d:i64 = crop[((2 * oy + 1) * cw + 2 * ox + 1) * 3 + c] as i64;
                sm[(oy * sw + ox) * 3 + c] = ((a + b + cc + d + 2) / 4) as u8;
                c = c + 1;
            }
            ox = ox + 1;
        }
        oy = oy + 1;
    }
    let rc2:i64 = bmp_write(oroot, "skycrop_input_256x92.bmp", sm, sw, sh);
    if (rc2 != 0) { _zag_println("input bmp write failed"); return 1; }
    _zag_println("skycrop done: 512x184 gt + 256x92 input");
    nio_close(root);
    nio_close(oroot);
    return 0;
}

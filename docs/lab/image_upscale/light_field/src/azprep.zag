// azprep.zag — HONEST UPSCALE experiment, phase 0 (prep).
// Micah order 2026-09-26 ~12:52 PDT: "can TNN upscale it? ... another step
// towards image gen with imagination."
//
// Reads the sealed fixture original_512.bmp (512x187, SHA-256
// 4ee3414bddd289ca7c9544a91ec39b8885f8dcde96fa0ffa0d56aebc38da1b00):
//   1. crops rows 0..183 -> gt_512x184.bmp. The 3 dropped rows are the
//      bottom rows (184,185,186): the darkest near-black foreground water,
//      the least-structured rows of the frame. The skyline stays anchored
//      at row 0. This crop is the HELD GROUND TRUTH — it is written for
//      measurement only and is NEVER fed to the construction.
//   2. downscales 2x with a documented box filter -> input_256x92.bmp.
//      out[x,y][c] = (in[2x,2y]+in[2x+1,2y]+in[2x,2y+1]+in[2x+1,2y+1]+2)/4
//      (round-half-up integer box average, per channel). input_256x92.bmp
//      is the ONLY thing TNN observes in this experiment.
// Pure Zag, zero RNG, pinned toolchain. argv: 1=indir 2=outdir.
@import("./common_az.zag")

fn main() i32 {
    let ind:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    if (_zag_strcmp(ind, "") == 1) { ind = "."; }
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let root:i64 = nio_open_root(ind);
    if (root < 0) { _zag_println("cannot open indir"); return 1; }
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { _zag_println("cannot open outdir"); nio_close(root); return 1; }

    let fd:i64 = nio_open_child(root, "original_512.bmp", 0);
    if (fd < 0) { _zag_println("cannot open input"); nio_close(root); return 1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { _zag_println("alloc failed"); nio_close(fd); nio_close(root); return 1; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 54) { _zag_println("short file"); return 1; }
    if (fbuf[0] != 66) { _zag_println("not BM"); return 1; }
    if (fbuf[1] != 77) { _zag_println("not BM"); return 1; }
    // fixture identity: size + dims (SHA-256 verified out-of-band, in RUNLOG)
    if (n != 287286) { _zag_println("fixture size mismatch"); return 1; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    if (w != 512) { _zag_println("need w=512"); return 1; }
    if (h != 187) { _zag_println("need h=187"); return 1; }
    if (r_u16le(fbuf, 28) != 24) { _zag_println("need 24bpp"); return 1; }
    if (r_u32le(fbuf, 30) != 0) { _zag_println("need uncompressed"); return 1; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let orig:[]u8 = nio_alloc((w * h * 3) as i32);
    if (orig.len == 0) { _zag_println("alloc orig failed"); return 1; }
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            orig[p] = fbuf[q + 2];
            orig[p + 1] = fbuf[q + 1];
            orig[p + 2] = fbuf[q];
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fbuf);
    _zag_println("fixture ok: 512x187, 287286 bytes");

    // ---- crop rows 0..183 -> 512x184 ground truth (held, never observed) ----
    let gw:i64 = 512;
    let gh:i64 = 184;
    let gt:[]u8 = nio_alloc((gw * gh * 3) as i32);
    if (gt.len == 0) { _zag_println("alloc gt failed"); return 1; }
    let gy:i64 = 0;
    while (gy < gh) {
        let gx:i64 = 0;
        while (gx < gw) {
            let p:i64 = (gy * gw + gx) * 3;
            gt[p] = orig[p];
            gt[p + 1] = orig[p + 1];
            gt[p + 2] = orig[p + 2];
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    let rcg:i64 = bmp_write(oroot, "gt_512x184.bmp", gt, gw, gh);
    if (rcg != 0) { _zag_println("gt write failed"); return 1; }
    _zag_println("gt_512x184.bmp written (HELD ground truth: rows 0..183; dropped rows 184..186 = darkest foreground water)");

    // ---- 2x box downscale -> 256x92 (the ONLY observed input) ----
    let sw:i64 = 256;
    let sh:i64 = 92;
    let sm:[]u8 = nio_alloc((sw * sh * 3) as i32);
    if (sm.len == 0) { _zag_println("alloc sm failed"); return 1; }
    let sy:i64 = 0;
    while (sy < sh) {
        let sx:i64 = 0;
        while (sx < sw) {
            let c:i64 = 0;
            while (c < 3) {
                let s:i64 = (gt[((sy * 2) * gw + sx * 2) * 3 + c] as i64)
                    + (gt[((sy * 2) * gw + sx * 2 + 1) * 3 + c] as i64)
                    + (gt[(((sy * 2) + 1) * gw + sx * 2) * 3 + c] as i64)
                    + (gt[(((sy * 2) + 1) * gw + sx * 2 + 1) * 3 + c] as i64);
                sm[(sy * sw + sx) * 3 + c] = ((s + 2) / 4) as u8;
                c = c + 1;
            }
            sx = sx + 1;
        }
        sy = sy + 1;
    }
    let rcs:i64 = bmp_write(oroot, "input_256x92.bmp", sm, sw, sh);
    if (rcs != 0) { _zag_println("input write failed"); return 1; }
    _zag_println("input_256x92.bmp written (2x box filter, round-half-up; this is ALL TNN sees)");
    nio_close(root);
    nio_close(oroot);
    _zag_println("prep done");
    return 0;
}

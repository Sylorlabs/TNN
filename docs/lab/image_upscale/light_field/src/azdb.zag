// azdb.zag — pure-Zag scorer for the LIGHT-FIELD battery (frozen protocol).
// Reads gt.bmp, upscale_tnn.bmp, labels_raw.bin from one dir (the battery
// script copies gt.bmp into each outdir before scoring).
// Prints integer-exact per-channel SSE, PSNR per channel and mean
// (metrics.py convention: mean of per-channel dB; SSIM omitted per prereg),
// and the frozen checkerboard tell metric on label-3 odd pixels.
// dB via in-Zag log10 (range reduction + atanh series, frozen log10(2)
// constant), with compiled-in self-test asserts (hand-computed values).
// Refuses to score if the self-test fails. Pure Zag, zero RNG.
// argv: 1=dir
@import("./common_az.zag")

fn ln_series(m:f64) f64 {
    // atanh series: ln(m) = 2*(y + y^3/3 + ... ), y = (m-1)/(m+1).
    // Valid for m in [1,2] (y <= 1/3); 7 terms.
    let y:f64 = (m - 1.0) / (m + 1.0);
    let y2:f64 = y * y;
    let term:f64 = y;
    let s:f64 = y;
    let k:i64 = 1;
    while (k < 7) {
        term = term * y2;
        let d:f64 = (2 * k + 1) as f64;
        s = s + term / d;
        k = k + 1;
    }
    return 2.0 * s;
}

fn log10_f(x:f64) f64 {
    // x > 0. Range reduction x = m * 2^k, m in [1,2).
    let k:i64 = 0;
    let m:f64 = x;
    while (m >= 2.0) { m = m / 2.0; k = k + 1; }
    while (m < 1.0) { m = m * 2.0; k = k - 1; }
    let ln10:f64 = ln_series(1.25) + 3.0 * ln_series(2.0);
    return (k as f64) * 0.30103 + ln_series(m) / ln10;
}

fn fabs(x:f64) f64 {
    if (x < 0.0) { return 0.0 - x; }
    return x;
}

fn read_bmp_rgb(root:i64, name:[]u8, px:[]u8, wout:[]i64, hout:[]i64) i64 {
    // px must be preallocated w*h*3; reads 24-bit BMP into RGB top-down.
    let fbuf:[]u8 = file_read_all(root, name, 2000000);
    if (fbuf.len < 54) { return -1; }
    if (fbuf[0] != 66 || fbuf[1] != 77) { return -2; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    if (r_u16le(fbuf, 28) != 24) { return -3; }
    if (r_u32le(fbuf, 30) != 0) { return -4; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    if (px.len < w * h * 3) { return -5; }
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            px[p] = fbuf[q + 2];
            px[p + 1] = fbuf[q + 1];
            px[p + 2] = fbuf[q];
            x = x + 1;
        }
        y = y + 1;
    }
    wout[0] = w;
    hout[0] = h;
    return 0;
}

fn main() i32 {
    // ---- frozen self-test (hand-computed values, no external oracle) ----
    if (fabs(log10_f(2.0) - 0.30103) >= 0.0002) {
        _zag_println("SELFTEST FAIL: log10(2)"); return 1;
    }
    if (fabs(log10_f(10.0) - 1.0) >= 0.0002) {
        _zag_println("SELFTEST FAIL: log10(10)"); return 1;
    }
    let psnr1:f64 = 10.0 * log10_f(65025.0);
    if (psnr1 < 48.12 || psnr1 > 48.14) {
        _zag_println("SELFTEST FAIL: psnr(mse=1)"); return 1;
    }
    _zag_println("SELFTEST ok");

    let dd:[]u8 = _zag_arg(1);
    if (_zag_strcmp(dd, "") == 1) { dd = "."; }
    let root:i64 = nio_open_root(dd);
    if (root < 0) { _zag_println("cannot open dir"); return 1; }

    // dims from gt header
    let gf:[]u8 = file_read_all(root, "gt.bmp", 2000000);
    if (gf.len < 54) { _zag_println("short gt.bmp"); return 1; }
    let w:i64 = r_i32le(gf, 18);
    let h:i64 = r_i32le(gf, 22);
    let npix:i64 = w * h;
    _zag_print("dims ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("x");
    _zag_println(_zag_i64_to_str(h));

    let gpx:[]u8 = nio_alloc((npix * 3) as i32);
    let tpx:[]u8 = nio_alloc((npix * 3) as i32);
    if (gpx.len == 0 || tpx.len == 0) { _zag_println("alloc failed"); return 1; }
    let wo:[]i64 = nio_alloc(8) as []i64;
    let ho:[]i64 = nio_alloc(8) as []i64;
    let r1:i64 = read_bmp_rgb(root, "gt.bmp", gpx, wo, ho);
    let r2:i64 = read_bmp_rgb(root, "upscale_tnn.bmp", tpx, wo, ho);
    if (r1 != 0 || r2 != 0 || wo[0] != w || ho[0] != h) {
        _zag_println("bmp read/dims mismatch"); return 1;
    }
    let lab:[]u8 = file_read_all(root, "labels_raw.bin", npix + 16);
    let have_lab:i64 = 1;
    if (lab.len < npix) { have_lab = 0; }

    let sse0:i64 = 0; let sse1:i64 = 0; let sse2:i64 = 0;
    let csum:i64 = 0; let cn:i64 = 0; let l3n:i64 = 0;
    let i:i64 = 0;
    while (i < npix) {
        let p:i64 = i * 3;
        let e0:i64 = (tpx[p] as i64) - (gpx[p] as i64);
        let e1:i64 = (tpx[p + 1] as i64) - (gpx[p + 1] as i64);
        let e2:i64 = (tpx[p + 2] as i64) - (gpx[p + 2] as i64);
        sse0 = sse0 + e0 * e0;
        sse1 = sse1 + e1 * e1;
        sse2 = sse2 + e2 * e2;
        if (have_lab == 1) {
            let lv:i64 = lab[i] as i64;
            let ox:i64 = i - (i / w) * w;
            let oy:i64 = i / w;
            if (lv == 3 && (ox + oy) % 2 == 1) {
                l3n = l3n + 1;
                let ex:i64 = ox - 1;
                if (ox % 2 == 0) { ex = ox + 1; }
                if (ex < 0) { ex = 0; }
                if (ex >= w) { ex = w - 1; }
                let q:i64 = (oy * w + ex) * 3;
                let d0:i64 = (tpx[p] as i64) - (tpx[q] as i64);
                if (d0 < 0) { d0 = 0 - d0; }
                let d1:i64 = (tpx[p + 1] as i64) - (tpx[q + 1] as i64);
                if (d1 < 0) { d1 = 0 - d1; }
                let d2:i64 = (tpx[p + 2] as i64) - (tpx[q + 2] as i64);
                if (d2 < 0) { d2 = 0 - d2; }
                csum = csum + d0 + d1 + d2;
                cn = cn + 3;
            }
        }
        i = i + 1;
    }
    _zag_print("sse_r=");
    _zag_print(_zag_i64_to_str(sse0));
    _zag_print(" sse_g=");
    _zag_print(_zag_i64_to_str(sse1));
    _zag_print(" sse_b=");
    _zag_println(_zag_i64_to_str(sse2));

    // PSNR per channel, mean of dB; millibels to avoid float formatting
    let nf:f64 = npix as f64;
    let db0:f64 = 10.0 * log10_f(65025.0 * nf / (sse0 as f64));
    let db1:f64 = 10.0 * log10_f(65025.0 * nf / (sse1 as f64));
    let db2:f64 = 10.0 * log10_f(65025.0 * nf / (sse2 as f64));
    let dbm:f64 = (db0 + db1 + db2) / 3.0;
    let m0:i64 = (db0 * 1000.0 + 0.5) as i64;
    let m1:i64 = (db1 * 1000.0 + 0.5) as i64;
    let m2:i64 = (db2 * 1000.0 + 0.5) as i64;
    let mm:i64 = (dbm * 1000.0 + 0.5) as i64;
    _zag_print("psnr_mdB_r=");
    _zag_print(_zag_i64_to_str(m0));
    _zag_print(" g=");
    _zag_print(_zag_i64_to_str(m1));
    _zag_print(" b=");
    _zag_print(_zag_i64_to_str(m2));
    _zag_print(" mean=");
    _zag_println(_zag_i64_to_str(mm));

    _zag_print("label3_odd_n=");
    _zag_println(_zag_i64_to_str(l3n));
    if (cn > 0) {
        let cmean:i64 = (csum * 1000) / cn;
        _zag_print("checker_mean_mlv=");
        _zag_println(_zag_i64_to_str(cmean));
    } else {
        _zag_println("checker_mean_mlv=none");
    }
    nio_close(root);
    return 0;
}

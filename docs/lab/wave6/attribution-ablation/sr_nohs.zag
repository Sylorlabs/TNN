// sr_nohs.zag — ABLATED learner fragment for the wave-6 attribution-ablation
// study. Contains ONLY nhs_episode: sr_episode (wave4/scaffold-release/sr.zag)
// with the eliminative-verification branch surgically removed.
//
// DIFF vs sr_episode (documented in PREREG_ABLATION.md §2; verified by
// inspection after writing):
//   - REMOVED: the entire `if(connected.*!=0 && signal==-1){...}`
//     elimination branch (ELIMINATE audit, live[] update, survivor count,
//     UNCOMMIT revival, COMMIT-on-last-survivor).
//   - ADDED: commit-on-first-+1 — if connected and signal==1 and the
//     context is uncommitted, audit COMMIT(ctx+1, action) and commit.
//     (-1 signals are still audited as SCAFFOLD reads but change nothing.)
//   - UNCHANGED: EPISODE/SCAFFOLD audit-first order, the verified-streak
//     rule, next_probe advancement, double-severance (signal ignored when
//     disconnected), fail-closed audit overflow, argument validation.
// All other machinery (sr_init/select/legal/disconnect/audit/replay and the
// SR_OP_*/SR_* constants) is the verbatim wave-4 sr.zag, imported by the
// driver alongside this file. sr_replay remains exact for nhs_episode logs:
// with no ELIMINATE/UNCOMMIT entries the replay's same-step-ELIMINATE
// lookahead never triggers, so next_probe advances every episode —
// exactly matching the advance below.

// One episode WITHOUT eliminative verification: commitment without
// evidence-testing. -1 is recorded (SCAFFOLD audit) and ignored.
fn nhs_episode(live:[]u8,committed:[]u8,next_probe:[]u8,nctx:i32,nact:i32,
    connected:*i32,streak:*i32,ctx:i32,action:i32,signal:i32,
    step:i32,abuf:[]u8,acount:*i32)i32 {
    if(nctx<1 || nact<1 || ctx<0 || ctx>=nctx || action<0 || action>=nact){return SR_RANGE;}
    if(connected==null as *i32 || streak==null as *i32){return SR_BAD;}
    let r:i32=sr_audit(abuf,acount,step,SR_OP_EPISODE,ctx+1,action);
    if(r!=SR_OK){return r;}
    let r2:i32=sr_audit(abuf,acount,step,SR_OP_SCAFFOLD,ctx+1,signal);
    if(r2!=SR_OK){return r2;}
    // ABLATION: no elimination. A +1 while connected commits the acted
    // action immediately when the context is uncommitted — commitment
    // without eliminative verification. A -1 changes nothing.
    if(connected.*!=0 && signal==1 && (committed[ctx] as i32)==SR_UNCONNECTED){
        let r3:i32=sr_audit(abuf,acount,step,SR_OP_COMMIT,ctx+1,action);
        if(r3!=SR_OK){return r3;}
        committed[ctx]=action as u8;
    }
    let complete:i32=1;
    let c:i32=0;
    while(c<nctx){if((committed[c] as i32)==SR_UNCONNECTED){complete=0;}c=c+1;}
    let acted_ok:i32=((committed[ctx] as i32)!=SR_UNCONNECTED && (committed[ctx] as i32)==action) as i32;
    if(connected.*!=0 && signal==1 && complete==1 && acted_ok==1){
        streak.*=streak.*+1;
    } else {
        streak.*=0;
    }
    if(action+1<nact){next_probe[ctx]=(action+1) as u8;} else {next_probe[ctx]=0;}
    return SR_OK;
}

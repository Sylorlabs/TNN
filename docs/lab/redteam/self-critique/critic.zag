// critic.zag — TNN self-critique leg (frozen prereg: SELF-CRITIQUE PREREG 2026-09-21).
//
// The TNN's deliberative machinery turned on its own perfect-score record.
// 8 suspicion probes COMPUTE triggers from an embedded self-model record
// (flip a record field and the corresponding hole drops out — verified by
// construction, not by assertion). Holes ranked by computed severity
// (desc) / id (asc), each emitted with an evidence pointer and a proposed
// test. Anti-skip gate: CRITIC_BLOCKED unless exactly 8 holes emitted.
//
// argv: critic <rep>   (rep accepted, never printed)
// Build: znc_linux_x86_64_abed8aa1 critic.zag -o critic --no-analyze

fn m_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn m_pnum(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    _zag_free(_zag_slice_ptr(s));
}

// ---------- suspicion probes: each COMPUTES its trigger from the record ---
fn p_form_content(flaw_pass:i32,corrupt:i32)i32 {
    if(flaw_pass==1){
        if(corrupt==1){return 9;}
    }
    return 0;
}
fn p_circularity(rsi_exact:i32,src_eq_tgt:i32)i32 {
    if(rsi_exact==1){
        if(src_eq_tgt==1){return 8;}
    }
    return 0;
}
fn p_impossible(neg_imp:i32)i32 {
    if(neg_imp==1){return 7;}
    return 0;
}
fn p_metric(bvc:i32)i32 {
    if(bvc==1){return 6;}
    return 0;
}
fn p_frozen(frz:i32)i32 {
    if(frz==1){return 6;}
    return 0;
}
fn p_stipulated(stip:i32)i32 {
    if(stip==1){return 5;}
    return 0;
}
fn p_det(sub:i32)i32 {
    if(sub==1){return 4;}
    return 0;
}
fn p_degenerate(deg:i32)i32 {
    if(deg==1){return 3;}
    return 0;
}

fn emit_hole(rank:i32,id:i32,sev:i32)void {
    _zag_print("CRITIC_HOLE,rank=");
    m_pnum(rank as i64);
    _zag_print(",id=");
    m_pnum(id as i64);
    _zag_print(",severity=");
    m_pnum(sev as i64);
    _zag_print(",title=\"");
    if(id==1){_zag_print("form-content gap: flaw battery blind to false knowledge");}
    if(id==2){_zag_print("RSI circularity: predictions target their own mechanisms");}
    if(id==3){_zag_print("impossible battery: NEG 36/36 unachievable by construction");}
    if(id==4){_zag_print("metric incoherence: B-vs-C irreconcilable");}
    if(id==5){_zag_print("frozen world: determinism purchased by freezing the web");}
    if(id==6){_zag_print("stipulated principles: background given, not learned");}
    if(id==7){_zag_print("determinism is substrate, not intelligence");}
    if(id==8){_zag_print("degenerate regime: flaw battery below N=96");}
    _zag_print("\",evidence=\"");
    if(id==1){_zag_print("docs/lab/q1tq-noisy50/Q1TQ_NOISY50_VERDICT.md");}
    if(id==2){_zag_print("docs/lab/rsi/VERDICT.md honest grade");}
    if(id==3){_zag_print("docs/lab/prose-learning/v2/VERDICT.md NEG defect");}
    if(id==4){_zag_print("docs/lab/prose-learning/v2/VERDICT.md B-vs-C discrepancy");}
    if(id==5){_zag_print("docs/lab/info-source frozen envelopes");}
    if(id==6){_zag_print("docs/lab/principle-detection/VERDICT.md stipulated principles");}
    if(id==7){_zag_print("program standing law: byte-identical reruns");}
    if(id==8){_zag_print("docs/lab/scale/fewshot degenerate below N=96");}
    _zag_print("\",test=\"");
    if(id==1){_zag_print("Build a content-aware battery: teach from a 50pct-noise teacher and score mastery vs world truth as the headline metric; fail the trial if the flaw battery passes while content mastery is below 0.90.");}
    if(id==2){_zag_print("Require the recommender to predict effects on a HELD-OUT weakness battery it never measured; exact reproduction on held-out data distinguishes calibration from circularity.");}
    if(id==3){_zag_print("Battery-health audit: parse every frozen battery and assert max achievable equals max claimed; any battery with duplicate or conflicting probes fails the audit before scored runs.");}
    if(id==4){_zag_print("Freeze ONE absorption metric with a written definition before scored runs; re-run the v2 legs under the single metric and revise the headline if it moves.");}
    if(id==5){_zag_print("Re-fetch the frozen search envelopes live and re-run the info-source trial; if verdicts change, the live-web result was a replay result.");}
    if(id==6){_zag_print("Teach the principles from data instead of stipulating them, then run the violation battery; detection must survive principles being learned, not given.");}
    if(id==7){_zag_print("A lookup table passes KB-DET; add a generalization battery of novel compositions never taught as the intelligence bar alongside determinism.");}
    if(id==8){_zag_print("Define each battery's valid regime explicitly; scores outside the regime are reported UNRUNNABLE, never passed.");}
    _zag_println("\"");
}

fn main()void {
    let a1:[]u8=_zag_arg(1);
    if(a1.len==0){
        _zag_println("usage: critic <rep>");
        return;
    }
    // self-model record: the documented state of the program, 2026-09-21
    let flaw_pass:i32=1;
    let flaw_content_corrupt:i32=1;
    let rsi_exact:i32=1;
    let rsi_source_eq_target:i32=1;
    let neg_impossible:i32=1;
    let bvc_irreconcilable:i32=1;
    let info_frozen:i32=1;
    let prin_stipulated:i32=1;
    let det_substrate:i32=1;
    let flaw_degenerate_n96:i32=1;
    // run the probes; triggers are computed, not hardcoded
    let s1:i32=p_form_content(flaw_pass,flaw_content_corrupt);
    let s2:i32=p_circularity(rsi_exact,rsi_source_eq_target);
    let s3:i32=p_impossible(neg_impossible);
    let s4:i32=p_metric(bvc_irreconcilable);
    let s5:i32=p_frozen(info_frozen);
    let s6:i32=p_stipulated(prin_stipulated);
    let s7:i32=p_det(det_substrate);
    let s8:i32=p_degenerate(flaw_degenerate_n96);
    // pack u32 arrays via byte arena (AGENTS.md: no []i32 consecutive casts)
    let sarr:[]u8=m_alloc(32);
    let iarr:[]u8=m_alloc(32);
    let sv0:i32=s1; let sv1:i32=s2; let sv2:i32=s3; let sv3:i32=s4;
    let sv4:i32=s5; let sv5:i32=s6; let sv6:i32=s7; let sv7:i32=s8;
    // store severities/ids little-endian u32
    let i:i32=0;
    while(i<8){
        let o:i32=i*4;
        let v:i32=0;
        if(i==0){v=sv0;}
        if(i==1){v=sv1;}
        if(i==2){v=sv2;}
        if(i==3){v=sv3;}
        if(i==4){v=sv4;}
        if(i==5){v=sv5;}
        if(i==6){v=sv6;}
        if(i==7){v=sv7;}
        sarr[o]=(v&255) as u8;
        sarr[o+1]=((v>>8)&255) as u8;
        sarr[o+2]=((v>>16)&255) as u8;
        sarr[o+3]=((v>>24)&255) as u8;
        let q:i32=i+1;
        iarr[o]=(q&255) as u8;
        iarr[o+1]=((q>>8)&255) as u8;
        iarr[o+2]=((q>>16)&255) as u8;
        iarr[o+3]=((q>>24)&255) as u8;
        i=i+1;
    }
    // count triggered
    let nh:i32=0;
    i=0;
    while(i<8){
        let o:i32=i*4;
        let v:i32=((sarr[o] as i32)&255)|((((sarr[o+1] as i32)&255)<<8))|((((sarr[o+2] as i32)&255)<<16))|((((sarr[o+3] as i32)&255)<<24));
        if(v>0){nh=nh+1;}
        i=i+1;
    }
    // bubble sort: severity desc, id asc
    i=0;
    while(i<8){
        let j:i32=i+1;
        while(j<8){
            let oi:i32=i*4; let oj:i32=j*4;
            let si:i32=((sarr[oi] as i32)&255)|((((sarr[oi+1] as i32)&255)<<8))|((((sarr[oi+2] as i32)&255)<<16))|((((sarr[oi+3] as i32)&255)<<24));
            let sj:i32=((sarr[oj] as i32)&255)|((((sarr[oj+1] as i32)&255)<<8))|((((sarr[oj+2] as i32)&255)<<16))|((((sarr[oj+3] as i32)&255)<<24));
            let ii:i32=((iarr[oi] as i32)&255)|((((iarr[oi+1] as i32)&255)<<8))|((((iarr[oi+2] as i32)&255)<<16))|((((iarr[oi+3] as i32)&255)<<24));
            let ij:i32=((iarr[oj] as i32)&255)|((((iarr[oj+1] as i32)&255)<<8))|((((iarr[oj+2] as i32)&255)<<16))|((((iarr[oj+3] as i32)&255)<<24));
            let swap:i32=0;
            if(sj>si){swap=1;}
            if(sj==si && ij<ii){swap=1;}
            if(swap==1){
                let k:i32=0;
                while(k<4){
                    let t:u8=sarr[oi+k];
                    sarr[oi+k]=sarr[oj+k];
                    sarr[oj+k]=t;
                    let u:u8=iarr[oi+k];
                    iarr[oi+k]=iarr[oj+k];
                    iarr[oj+k]=u;
                    k=k+1;
                }
            }
            j=j+1;
        }
        i=i+1;
    }
    // emit, skipping untriggered (severity 0 sinks to the bottom)
    let rank:i32=0;
    i=0;
    while(i<8){
        let oi:i32=i*4;
        let si:i32=((sarr[oi] as i32)&255)|((((sarr[oi+1] as i32)&255)<<8))|((((sarr[oi+2] as i32)&255)<<16))|((((sarr[oi+3] as i32)&255)<<24));
        let ii:i32=((iarr[oi] as i32)&255)|((((iarr[oi+1] as i32)&255)<<8))|((((iarr[oi+2] as i32)&255)<<16))|((((iarr[oi+3] as i32)&255)<<24));
        if(si>0){
            emit_hole(rank,ii,si);
            rank=rank+1;
        }
        i=i+1;
    }
    _zag_print("CRITIC_MANIFEST,holes=");
    m_pnum(nh as i64);
    _zag_println("");
    if(nh!=8){
        _zag_print("CRITIC_BLOCKED,emitted=");
        m_pnum(nh as i64);
        _zag_println(",expected=8");
        return;
    }
    // digest over emitted (severity,id) pairs in emission order
    let hh:i64=1469598103934665603;
    i=0;
    while(i<8){
        let oi:i32=i*4;
        let si:i32=((sarr[oi] as i32)&255)|((((sarr[oi+1] as i32)&255)<<8))|((((sarr[oi+2] as i32)&255)<<16))|((((sarr[oi+3] as i32)&255)<<24));
        let ii:i32=((iarr[oi] as i32)&255)|((((iarr[oi+1] as i32)&255)<<8))|((((iarr[oi+2] as i32)&255)<<16))|((((iarr[oi+3] as i32)&255)<<24));
        if(si>0){
            hh=hh^((si as i64)&255);
            hh=hh*1099511628211;
            hh=hh^((ii as i64)&255);
            hh=hh*1099511628211;
        }
        i=i+1;
    }
    _zag_print("CRITIC_DIGEST,fnv1a=");
    let hexd:[]u8="0123456789abcdef";
    let sh:[]u8=m_alloc(17);
    let ni:i32=0;
    while(ni<16){
        let shift:i64=((15-ni)*4) as i64;
        let nib:i32=((hh>>shift)&15) as i32;
        sh[ni]=hexd[nib];
        ni=ni+1;
    }
    _zag_print(sh[0..16]);
    _zag_println("");
    _zag_println("CRITIC_DONE");
}

@import("R33_NATIVE_SHA256_V2.zag")

// INDEP: independent-battery champion harness. Frozen PREREG.md (d7657741).
// Reads items.jsonl from CWD (wire format only: id/phase/text — NO kind labels,
// NO expected answers). Implements champion mechanisms generically:
// BoW/Jaccard retrieval (v1 prose), claim-vs-claim conflict (new-mechanisms),
// principle instantiation with principle-priority (principle-detection + RSI
// T-PRIN-PRIORITY), withhold-on-insufficient-evidence (info-source).
// Pure Zag, zero RNG. Output: V,<id>,<VERDICT>,<detail> per probe line.

// ---------------- byte helpers ----------------
fn is_alnum(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn is_upper(c:u8)i32 {
    if(c>=65 && c<=90){return 1;}
    return 0;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn beq_lit(b:[]u8,off:i32,lit:[]u8) i32 {
    if(off+lit.len>b.len){return 0;}
    let i:i32=0;
    while(i<lit.len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
// find needle in b[lo..hi); returns index or -1
fn find_sub(b:[]u8,lo:i32,hi:i32,nd:[]u8)i32 {
    let i:i32=lo;
    while(i+nd.len<=hi){
        if(beq_lit(b,i,nd)==1){return i;}
        i=i+1;
    }
    return -1;
}
fn parse_int(b:[]u8,off:i32,len:i32)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<len){
        let c:u8=b[off+i];
        if(c>=48 && c<=57){v=v*10+((c as i64)-48);}
        i=i+1;
    }
    return v;
}
fn ends_with(b:[]u8,blen:i32,suf:[]u8)i32 {
    let sl:i32=suf.len;
    if(blen<sl){return 0;}
    let i:i32=0;
    while(i<sl){
        if(b[blen-sl+i]!=suf[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn stem_inplace(b:[]u8,len:i32)i32 {
    if(ends_with(b,len,"ies")==1){
        b[len-3]=121;
        return len-2;
    }
    if(ends_with(b,len,"ed")==1 && len>4){return len-2;}
    if(ends_with(b,len,"ing")==1 && len>5){return len-2;}
    if(ends_with(b,len,"ches")==1){return len-2;}
    if(ends_with(b,len,"shes")==1){return len-2;}
    if(ends_with(b,len,"sses")==1){return len-2;}
    if(ends_with(b,len,"xes")==1){return len-2;}
    if(ends_with(b,len,"s")==1 && len>3 && ends_with(b,len,"ss")==0){return len-1;}
    return len;
}
fn is_stop(b:[]u8,off:i32,len:i32)i32 {
    if(beq_lit(b,off,"the")==1 && len==3){return 1;}
    if(beq_lit(b,off,"a")==1 && len==1){return 1;}
    if(beq_lit(b,off,"an")==1 && len==2){return 1;}
    if(beq_lit(b,off,"of")==1 && len==2){return 1;}
    if(beq_lit(b,off,"in")==1 && len==2){return 1;}
    if(beq_lit(b,off,"is")==1 && len==2){return 1;}
    if(beq_lit(b,off,"are")==1 && len==3){return 1;}
    if(beq_lit(b,off,"was")==1 && len==3){return 1;}
    if(beq_lit(b,off,"be")==1 && len==2){return 1;}
    if(beq_lit(b,off,"what")==1 && len==4){return 1;}
    if(beq_lit(b,off,"which")==1 && len==5){return 1;}
    if(beq_lit(b,off,"that")==1 && len==4){return 1;}
    if(beq_lit(b,off,"this")==1 && len==4){return 1;}
    if(beq_lit(b,off,"it")==1 && len==2){return 1;}
    if(beq_lit(b,off,"its")==1 && len==3){return 1;}
    if(beq_lit(b,off,"do")==1 && len==2){return 1;}
    if(beq_lit(b,off,"does")==1 && len==4){return 1;}
    if(beq_lit(b,off,"they")==1 && len==4){return 1;}
    if(beq_lit(b,off,"and")==1 && len==3){return 1;}
    if(beq_lit(b,off,"or")==1 && len==2){return 1;}
    if(beq_lit(b,off,"to")==1 && len==2){return 1;}
    if(beq_lit(b,off,"for")==1 && len==3){return 1;}
    if(beq_lit(b,off,"with")==1 && len==4){return 1;}
    if(beq_lit(b,off,"by")==1 && len==2){return 1;}
    if(beq_lit(b,off,"from")==1 && len==2){return 1;}
    if(beq_lit(b,off,"as")==1 && len==2){return 1;}
    if(beq_lit(b,off,"on")==1 && len==2){return 1;}
    if(beq_lit(b,off,"at")==1 && len==2){return 1;}
    if(beq_lit(b,off,"every")==1 && len==5){return 1;}
    if(beq_lit(b,off,"no")==1 && len==2){return 1;}
    if(beq_lit(b,off,"true")==1 && len==4){return 1;}
    if(beq_lit(b,off,"first")==1 && len==5){return 1;}
    if(beq_lit(b,off,"second")==1 && len==6){return 1;}
    if(beq_lit(b,off,"agree")==1 && len==5){return 1;}
    if(beq_lit(b,off,"teach")==1 && len==5){return 1;}
    if(beq_lit(b,off,"act")==1 && len==3){return 1;}
    if(beq_lit(b,off,"stat")==1 && len==4){return 1;}
    return 0;
}
// ---------------- IO ----------------
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    if(b.len==0){return b;}
    copy_bytes(b,0,s,0,s.len);
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{
                    copy_bytes(buf,total,chk,0,nb);
                    total=total+nb;
                }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    return buf[0..total];
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }

// ---------------- token table + fact store ----------------
// toka: append-only, 5 words (20B) per token: noff,nlen,ooff,olen,isname
// pool: normalized (lowercased+stemmed) token bytes
// facts: 10 words (40B) each:
//   [0]act_id [1]kind(1=D1,2=D2,3=D3,4=D4) [2]name_tok [3]class_tok
//   [4]verb_tok [5]obj_tbase [6]obj_tcount [7]full_tbase [8]full_tcount [9]key_tbase(unused, BoW inline)
fn tok_add(toka:[]u8,tn:[]u8,pool:[]u8,pn:[]u8,src:[]u8,so:i32,sl:i32)i32 {
    let n:i32=g32(tn,0) as i32;
    let po:i32=g32(pn,0) as i32;
    let i:i32=0;
    while(i<sl){
        pool[po+i]=to_low(src[so+i]);
        i=i+1;
    }
    let nl:i32=0;
    let tmp:[]u8=nio_alloc(64);
    i=0;
    while(i<sl){tmp[i]=pool[po+i];i=i+1;}
    nl=stem_inplace(tmp,sl);
    i=0;
    while(i<nl){pool[po+i]=tmp[i];i=i+1;}
    nio_free(tmp);
    let isname:i32=0;
    if(sl>0 && is_upper(src[so])==1){isname=1;}
    let at:i32=n*20;
    p32(toka,at,po as i64);
    p32(toka,at+4,nl as i64);
    p32(toka,at+8,so as i64);
    p32(toka,at+12,sl as i64);
    p32(toka,at+16,isname as i64);
    p32(tn,0,(n+1) as i64);
    p32(pn,0,(po+nl) as i64);
    return n;
}
// tokenize src[so..so+sl) -> appends tokens, returns tbase; tcount via tn delta
fn tokenize(toka:[]u8,tn:[]u8,pool:[]u8,pn:[]u8,src:[]u8,so:i32,sl:i32)i32 {
    let tbase:i32=g32(tn,0) as i32;
    let i:i32=0;
    while(i<sl){
        let c:u8=src[so+i];
        if(is_alnum(c)==1){
            let j:i32=i;
            while(j<sl && is_alnum(src[so+j])==1){j=j+1;}
            tok_add(toka,tn,pool,pn,src,so+i,j-i);
            i=j;
        }
        else{i=i+1;}
    }
    return tbase;
}
fn tok_noff(toka:[]u8,t:i32)i32 { return g32(toka,t*20) as i32; }
fn tok_nlen(toka:[]u8,t:i32)i32 { return g32(toka,t*20+4) as i32; }
fn tok_isname(toka:[]u8,t:i32)i32 { return g32(toka,t*20+16) as i32; }
// word equality on normalized bytes
fn weq(pool:[]u8,toka:[]u8,a:i32,b:i32)i32 {
    let al:i32=tok_nlen(toka,a);
    let bl:i32=tok_nlen(toka,b);
    if(al!=bl){return 0;}
    let ao:i32=tok_noff(toka,a);
    let bo:i32=tok_noff(toka,b);
    let i:i32=0;
    while(i<al){
        if(pool[ao+i]!=pool[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn wlit(pool:[]u8,toka:[]u8,t:i32,lit:[]u8)i32 {
    let l:i32=tok_nlen(toka,t);
    if(l!=lit.len){return 0;}
    let o:i32=tok_noff(toka,t);
    let i:i32=0;
    while(i<l){
        if(pool[o+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
// is token t a stopword?
fn tstop(pool:[]u8,toka:[]u8,t:i32)i32 {
    return is_stop(pool,tok_noff(toka,t),tok_nlen(toka,t));
}
// Jaccard similarity x1000 between content-word sets of [ab..ab+an) and [bb..bb+bn)
// O(n^2), small sets. Returns inter*1000/union.
fn obj_jac(pool:[]u8,toka:[]u8,ab:i32,an:i32,bb:i32,bn:i32)i32 {
    let inter:i32=0;
    let i:i32=0;
    while(i<an){
        let at:i32=ab+i;
        if(tstop(pool,toka,at)==0){
            let j:i32=0;
            let f:i32=0;
            while(j<bn){
                let bt:i32=bb+j;
                if(tstop(pool,toka,bt)==0 && weq(pool,toka,at,bt)==1){f=1;}
                j=j+1;
            }
            if(f==1){inter=inter+1;}
        }
        i=i+1;
    }
    // count content words on each side (dedup skipped: ranges are short, mostly unique)
    let ca:i32=0;
    i=0;
    while(i<an){if(tstop(pool,toka,ab+i)==0){ca=ca+1;}i=i+1;}
    let cb:i32=0;
    let j2:i32=0;
    while(j2<bn){if(tstop(pool,toka,bb+j2)==0){cb=cb+1;}j2=j2+1;}
    let union:i32=ca+cb-inter;
    if(union<=0){return 0;}
    return (inter*1000)/union;
}
// exact equality of content-word sequences (order-sensitive, stopwords dropped)
fn obj_exact(pool:[]u8,toka:[]u8,ab:i32,an:i32,bb:i32,bn:i32)i32 {
    let aw:[]u8=nio_alloc(64*4);
    let bw:[]u8=nio_alloc(64*4);
    let na:i32=0;
    let i:i32=0;
    while(i<an){
        if(tstop(pool,toka,ab+i)==0){p32(aw,na*4,(ab+i) as i64);na=na+1;}
        i=i+1;
    }
    let nb:i32=0;
    i=0;
    while(i<bn){
        if(tstop(pool,toka,bb+i)==0){p32(bw,nb*4,(bb+i) as i64);nb=nb+1;}
        i=i+1;
    }
    if(na!=nb){nio_free(aw);nio_free(bw);return 0;}
    i=0;
    while(i<na){
        if(weq(pool,toka,g32(aw,i*4) as i32,g32(bw,i*4) as i32)==0){nio_free(aw);nio_free(bw);return 0;}
        i=i+1;
    }
    nio_free(aw);nio_free(bw);
    return 1;
}

// ---------------- teach ----------------
// fact words: [0]act [1]kind [2]name_tok [3]class_tok [4]verb_tok
//             [5]obj_tbase [6]obj_tcount [7]full_tbase [8]full_tcount [9]reserved
fn fact_add(facts:[]u8,fn_:[]u8,act:i32,kind:i32,nt:i32,ct:i32,vt:i32,ob:i32,oc:i32,fb:i32,fc:i32)i32 {
    let n:i32=g32(fn_,0) as i32;
    let at:i32=n*40;
    p32(facts,at,act as i64);
    p32(facts,at+4,kind as i64);
    p32(facts,at+8,nt as i64);
    p32(facts,at+12,ct as i64);
    p32(facts,at+16,vt as i64);
    p32(facts,at+20,ob as i64);
    p32(facts,at+24,oc as i64);
    p32(facts,at+28,fb as i64);
    p32(facts,at+32,fc as i64);
    p32(facts,at+36,0);
    p32(fn_,0,(n+1) as i64);
    return n;
}
fn fget(facts:[]u8,f:i32,w:i32)i32 { return g32(facts,f*40+w*4) as i32; }
// parse a teach text (already tokenized at tb, count tc); returns kind
fn teach_parse(pool:[]u8,toka:[]u8,tb:i32,tc:i32,facts:[]u8,fn_:[]u8,act:i32)i32 {
    let t0:i32=tb;
    if(wlit(pool,toka,t0,"every")==1){
        // D3: Every <class> <verb> <obj...>
        fact_add(facts,fn_,act,3,-1,tb+1,tb+2,tb+3,tc-3,tb,tc);
        return 3;
    }
    if(wlit(pool,toka,t0,"no")==1){
        // D4: No <class> <verb> <obj...>
        fact_add(facts,fn_,act,4,-1,tb+1,tb+2,tb+3,tc-3,tb,tc);
        return 4;
    }
    if(tc>=4 && wlit(pool,toka,tb+1,"is")==1 && wlit(pool,toka,tb+2,"a")==1){
        // D2: <Name> is a <class>.
        fact_add(facts,fn_,act,2,tb+0,tb+3,tb+1,tb+4,tc-4,tb,tc);
        return 2;
    }
    // D1: <Name> <verb> <obj...>
    fact_add(facts,fn_,act,1,tb+0,-1,tb+1,tb+2,tc-2,tb,tc);
    return 1;
}
// find D2 class token for a name token; returns class tok or -1
fn class_of(pool:[]u8,toka:[]u8,facts:[]u8,fn_:[]u8,name:i32)i32 {
    let n:i32=g32(fn_,0) as i32;
    let f:i32=0;
    while(f<n){
        if(fget(facts,f,1)==2 && weq(pool,toka,fget(facts,f,2),name)==1){
            return fget(facts,f,3);
        }
        f=f+1;
    }
    return -1;
}
// find first capitalized token in [tb..tb+tc); returns tok or -1
fn find_name_tok(toka:[]u8,tb:i32,tc:i32)i32 {
    let i:i32=0;
    while(i<tc){
        if(tok_isname(toka,tb+i)==1){return tb+i;}
        i=i+1;
    }
    return -1;
}
// principle check: does (name,verb,obj[ob..ob+oc)) violate any taught D3/D4?
// D3 "Every C V O'": violation iff class(name)==C, verb matches, jac(obj,O')<500
// D4 "No C V O'":    violation iff class(name)==C, verb matches, jac(obj,O')>=500
// returns 1 if violated, 0 otherwise
fn principle_violated(pool:[]u8,toka:[]u8,facts:[]u8,fn_:[]u8,name:i32,verb:i32,ob:i32,oc:i32)i32 {
    let cls:i32=class_of(pool,toka,facts,fn_,name);
    if(cls<0){return 0;}
    let n:i32=g32(fn_,0) as i32;
    let f:i32=0;
    while(f<n){
        let k:i32=fget(facts,f,1);
        if(k==3 || k==4){
            if(weq(pool,toka,fget(facts,f,3),cls)==1 && weq(pool,toka,fget(facts,f,4),verb)==1){
                let j:i32=obj_jac(pool,toka,ob,oc,fget(facts,f,5),fget(facts,f,6));
                if(k==3 && j<500){return 1;}
                if(k==4 && j>=500){return 1;}
            }
        }
        f=f+1;
    }
    return 0;
}
// count D1 facts with (name,verb)
fn d1_count(pool:[]u8,toka:[]u8,facts:[]u8,fn_:[]u8,name:i32,verb:i32)i32 {
    let n:i32=g32(fn_,0) as i32;
    let c:i32=0;
    let f:i32=0;
    while(f<n){
        if(fget(facts,f,1)==1 && weq(pool,toka,fget(facts,f,2),name)==1 && weq(pool,toka,fget(facts,f,4),verb)==1){
            c=c+1;
        }
        f=f+1;
    }
    return c;
}
// first D1 fact index with (name,verb); -1 if none
fn d1_find(pool:[]u8,toka:[]u8,facts:[]u8,fn_:[]u8,name:i32,verb:i32)i32 {
    let n:i32=g32(fn_,0) as i32;
    let f:i32=0;
    while(f<n){
        if(fget(facts,f,1)==1 && weq(pool,toka,fget(facts,f,2),name)==1 && weq(pool,toka,fget(facts,f,4),verb)==1){
            return f;
        }
        f=f+1;
    }
    return -1;
}

// ---------------- probe handlers ----------------
fn tok_ooff(toka:[]u8,t:i32)i32 { return g32(toka,t*20+8) as i32; }
fn tok_olen(toka:[]u8,t:i32)i32 { return g32(toka,t*20+12) as i32; }
fn emit_verdict(id:i64,vc:[]u8,detail:[]u8)void {
    pr("V,");
    let s:[]u8=_zag_i64_to_str(id);
    pr(s);
    pr(",");
    pr(vc);
    pr(",");
    pr(detail);
    prl("");
    return;
}
// Q1: Is it true that <inner>? inner at ib, count ic. file=file buffer for orig text.
fn q1(pool:[]u8,toka:[]u8,facts:[]u8,fn_:[]u8,file:[]u8,id:i64,ib:i32,ic:i32)void {
    let iname:i32=find_name_tok(toka,ib,ic);
    if(iname>=0 && iname==ib){
        // canonical order: Name Verb Obj...
        let iverb:i32=ib+1;
        let iob:i32=ib+2;
        let ioc:i32=ic-2;
        if(ioc>=0 && wlit(pool,toka,iverb,"is")==1){
            // membership probe: Name is a class
            let cls:i32=class_of(pool,toka,facts,fn_,iname);
            if(cls<0){emit_verdict(id,"ABSTAIN","");return;}
            if(ic>=4 && weq(pool,toka,ib+3,cls)==1){emit_verdict(id,"AFFIRM","");return;}
            emit_verdict(id,"REJECT","");
            return;
        }
        // principle-priority: derived claim outranks taught trust (RSI T-PRIN-PRIORITY)
        if(principle_violated(pool,toka,facts,fn_,iname,iverb,iob,ioc)==1){
            emit_verdict(id,"REJECT","");
            return;
        }
        let cnt:i32=d1_count(pool,toka,facts,fn_,iname,iverb);
        if(cnt>1){
            // taught contradiction on (name,verb): withhold discipline
            emit_verdict(id,"REJECT","");
            return;
        }
        let f:i32=d1_find(pool,toka,facts,fn_,iname,iverb);
        if(f<0){emit_verdict(id,"ABSTAIN","");return;}
        if(obj_exact(pool,toka,iob,ioc,fget(facts,f,5),fget(facts,f,6))==1){
            emit_verdict(id,"AFFIRM","");
            return;
        }
        if(obj_jac(pool,toka,iob,ioc,fget(facts,f,5),fget(facts,f,6))>=500){
            emit_verdict(id,"AFFIRM","");
            return;
        }
        emit_verdict(id,"REJECT","");
        return;
    }
    // non-canonical (paraphrase): BoW fallback over D1 full texts
    let n:i32=g32(fn_,0) as i32;
    let best:i32=-1;
    let bestj:i32=0;
    let f2:i32=0;
    while(f2<n){
        if(fget(facts,f2,1)==1){
            let j:i32=obj_jac(pool,toka,ib,ic,fget(facts,f2,7),fget(facts,f2,8));
            if(j>bestj){bestj=j;best=f2;}
        }
        f2=f2+1;
    }
    if(bestj>=500){emit_verdict(id,"AFFIRM","");return;}
    emit_verdict(id,"ABSTAIN","");
    return;
}
// Q2: Which <class> <verb> <obj>? -> AFFIRM,<Name> | ABSTAIN
fn q2(pool:[]u8,toka:[]u8,facts:[]u8,fn_:[]u8,file:[]u8,id:i64,tb:i32,tc:i32)void {
    let cls:i32=tb+1;
    let vb:i32=tb+2;
    let ob:i32=tb+3;
    let oc:i32=tc-3;
    let n:i32=g32(fn_,0) as i32;
    let f:i32=0;
    let best:i32=-1;
    let bestj:i32=0;
    while(f<n){
        if(fget(facts,f,1)==1 && weq(pool,toka,fget(facts,f,4),vb)==1){
            let fc:i32=class_of(pool,toka,facts,fn_,fget(facts,f,2));
            if(fc>=0 && weq(pool,toka,fc,cls)==1){
                if(obj_exact(pool,toka,ob,oc,fget(facts,f,5),fget(facts,f,6))==1){
                    let nt:i32=fget(facts,f,2);
                    emit_verdict(id,"AFFIRM",file[tok_ooff(toka,nt)..tok_ooff(toka,nt)+tok_olen(toka,nt)]);
                    return;
                }
                let j:i32=obj_jac(pool,toka,ob,oc,fget(facts,f,5),fget(facts,f,6));
                if(j>bestj){bestj=j;best=f;}
            }
        }
        f=f+1;
    }
    if(bestj>=500 && best>=0){
        let nt2:i32=fget(facts,best,2);
        emit_verdict(id,"AFFIRM",file[tok_ooff(toka,nt2)..tok_ooff(toka,nt2)+tok_olen(toka,nt2)]);
        return;
    }
    emit_verdict(id,"ABSTAIN","");
    return;
}
// Q3: First: A Second: B Do they agree? -> AFFIRM | CONTRA
fn q3(pool:[]u8,toka:[]u8,facts:[]u8,fn_:[]u8,id:i64,tb:i32,tc:i32)void {
    // find "second" token
    let s:i32=-1;
    let i:i32=0;
    while(i<tc){
        if(wlit(pool,toka,tb+i,"second")==1){s=i;}
        i=i+1;
    }
    if(s<0){emit_verdict(id,"ABSTAIN","");return;}
    let ab:i32=tb+1;
    let ac:i32=s-1;
    let bb:i32=tb+s+1;
    let bc:i32=tc-s-5; // drop "do they agree"
    if(bc<3){bc=tc-s-1;}
    let na:i32=ab;
    let va:i32=ab+1;
    let oa:i32=ab+2;
    let oac:i32=ac-2;
    let nb:i32=bb;
    let vb:i32=bb+1;
    let ob:i32=bb+2;
    let obc:i32=bc-2;
    if(weq(pool,toka,na,nb)==1 && weq(pool,toka,va,vb)==1){
        if(obj_jac(pool,toka,oa,oac,ob,obc)>=500){emit_verdict(id,"AFFIRM","");return;}
        emit_verdict(id,"CONTRA","");
        return;
    }
    if(principle_violated(pool,toka,facts,fn_,na,va,oa,oac)==1){emit_verdict(id,"CONTRA","");return;}
    if(principle_violated(pool,toka,facts,fn_,nb,vb,ob,obc)==1){emit_verdict(id,"CONTRA","");return;}
    emit_verdict(id,"AFFIRM","");
    return;
}
// Q4: Which teaching act stated: <inner>? -> CITE,<actid> | ABSTAIN
fn q4(pool:[]u8,toka:[]u8,facts:[]u8,fn_:[]u8,id:i64,ib:i32,ic:i32)void {
    let n:i32=g32(fn_,0) as i32;
    let f:i32=0;
    let best:i32=-1;
    let bestj:i32=0;
    while(f<n){
        if(fget(facts,f,1)==1){
            if(obj_exact(pool,toka,ib,ic,fget(facts,f,7),fget(facts,f,8))==1){
                let s:[]u8=_zag_i64_to_str(fget(facts,f,0) as i64);
                emit_verdict(id,"CITE",s);
                return;
            }
            let j:i32=obj_jac(pool,toka,ib,ic,fget(facts,f,7),fget(facts,f,8));
            if(j>bestj){bestj=j;best=f;}
        }
        f=f+1;
    }
    if(bestj>=800 && best>=0){
        let s2:[]u8=_zag_i64_to_str(fget(facts,best,0) as i64);
        emit_verdict(id,"CITE",s2);
        return;
    }
    emit_verdict(id,"ABSTAIN","");
    return;
}
fn probe_dispatch(pool:[]u8,toka:[]u8,tn:[]u8,pn:[]u8,facts:[]u8,fn_:[]u8,file:[]u8,id:i64,text:[]u8,to:i32,tl:i32)void {
    let tb:i32=tokenize(toka,tn,pool,pn,text,to,tl);
    let tc:i32=(g32(tn,0) as i32)-tb;
    if(tc<2){emit_verdict(id,"ABSTAIN","");return;}
    let t0:i32=tb;
    if(wlit(pool,toka,t0,"is")==1){
        // Q1: is it true that <inner> — inner starts after "is it true that" (4 tokens)
        if(tc<6){emit_verdict(id,"ABSTAIN","");return;}
        q1(pool,toka,facts,fn_,file,id,tb+4,tc-4);
        return;
    }
    if(wlit(pool,toka,t0,"which")==1){
        if(tc>=2 && wlit(pool,toka,t0+1,"teachi")==1){
            // Q4: which teaching act stated: <inner> (4 tokens)
            if(tc<6){emit_verdict(id,"ABSTAIN","");return;}
            q4(pool,toka,facts,fn_,id,tb+4,tc-4);
            return;
        }
        q2(pool,toka,facts,fn_,file,id,tb,tc);
        return;
    }
    if(wlit(pool,toka,t0,"first")==1){
        q3(pool,toka,facts,fn_,id,tb,tc);
        return;
    }
    emit_verdict(id,"ABSTAIN","");
    return;
}

// ---------------- main ----------------
fn main()i32 {
    let file:[]u8=read_all("items.jsonl");
    if(file.len==0){
        prl("no input (run from the battery dir)");
        return 1;
    }
    let toka:[]u8=nio_alloc(262144);
    let tn:[]u8=nio_alloc(8);
    let pool:[]u8=nio_alloc(524288);
    let pn:[]u8=nio_alloc(8);
    let facts:[]u8=nio_alloc(96*40);
    let fn_:[]u8=nio_alloc(8);
    p32(tn,0,0); p32(pn,0,0); p32(fn_,0,0);
    let nprobe:i32=0;
    let nunparse:i32=0;
    let ls:i32=0;
    let flen:i32=file.len;
    while(ls<flen){
        let le:i32=ls;
        while(le<flen && file[le]!=10){le=le+1;}
        if(le>ls){
            // whitespace-tolerant JSON field scan: "id" <ws>: <ws> N ...
            let idp:i32=find_sub(file,ls,le,"\"id\"");
            let php:i32=find_sub(file,ls,le,"\"phase\"");
            let txp:i32=find_sub(file,ls,le,"\"text\"");
            if(idp>=0 && php>=0 && txp>=0){
                let q:i32=idp+4;
                while(q<le && file[q]!=58){q=q+1;}
                q=q+1;
                while(q<le && file[q]==32){q=q+1;}
                let id:i64=parse_int(file,q,le-q);
                q=php+7;
                while(q<le && file[q]!=58){q=q+1;}
                q=q+1;
                while(q<le && (file[q]==32 || file[q]==34)){q=q+1;}
                let phc:u8=file[q];
                q=txp+6;
                while(q<le && file[q]!=58){q=q+1;}
                q=q+1;
                while(q<le && file[q]==32){q=q+1;}
                // q now at opening quote of text (or first char)
                let ts:i32=q;
                if(ts<le && file[ts]==34){ts=ts+1;}
                let te:i32=le-1;
                while(te>ts && file[te]!=34){te=te-1;}
                if(te>ts){
                    if(phc==116){
                        let tb:i32=tokenize(toka,tn,pool,pn,file,ts,te-ts);
                        let tc:i32=(g32(tn,0) as i32)-tb;
                        if(tc>=3){teach_parse(pool,toka,tb,tc,facts,fn_,id as i32);}
                    }
                    else{
                        nprobe=nprobe+1;
                        probe_dispatch(pool,toka,tn,pn,facts,fn_,file,id,file,ts,te-ts);
                    }
                }
                else{nunparse=nunparse+1;}
            }
            else{nunparse=nunparse+1;}
        }
        ls=le+1;
    }
    pr("DONE,");
    let s1:[]u8=_zag_i64_to_str(nprobe as i64);
    pr(s1);
    pr(",");
    let s2:[]u8=_zag_i64_to_str(nunparse as i64);
    pr(s2);
    prl("");
    return 0;
}

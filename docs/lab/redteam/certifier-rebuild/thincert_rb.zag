@import("substrate/R33_NATIVE_IO_V1.zag")
@import("substrate/R33_NATIVE_SHA256_V2.zag")

// thincert.zag — THINCERT-2026-09-20-v1
// Thin prescriptive per-build no-RNG certifier.
// Prereg: ../PREREG_THIN_CERTIFIER.md (frozen d433fc8ba3cd BEFORE any code).
// Amendment: ../AMENDMENT_2026-09-20_THINCERT_R3.md — DRAFT pending Micah.
//   This implementation targets R3' (allocation-idiom) + R1b (substrate
//   pinning) + R4b (no nio_* shadowing). Marked AMENDMENT-PENDING throughout;
//   no K-bar is claimed final until the amendment is approved.
//
// Usage: thincert <manifest> <builddir> <binary> <replay-evidence> <attestation>
// Exit 0 PASS / 1 FAIL (attestation written either way) / 2 usage-IO error.
// Pure Zag. No RNG, no clock, deterministic given inputs.

// ---------------- byte helpers ----------------
fn is_alnum_us(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    if(c==95){return 1;}
    return 0;
}
fn is_digit(c:u8)i32 { if(c>=48 && c<=57){return 1;} return 0; }
fn is_space(c:u8)i32 { if(c==32 || c==9 || c==10 || c==13){return 1;} return 0; }

// find_sub(h, from, needle): first index of needle in h at/after from, else -1.
fn find_sub(h:[]u8, from:i32, needle:[]u8)i32 {
    if(needle.len==0 || h.len<needle.len){return -1;}
    let i:i32=from;
    if(i<0){i=0;}
    while(i+needle.len<=h.len){
        let k:i32=0;
        while(k<needle.len && h[i+k]==needle[k]){k=k+1;}
        if(k==needle.len){return i;}
        i=i+1;
    }
    return -1;
}
fn has_sub(h:[]u8, needle:[]u8)i32 {
    if(find_sub(h,0,needle)>=0){return 1;}
    return 0;
}
// word_at(h, at, word): word occurs at `at` with non-identifier boundaries.
fn word_at(h:[]u8, at:i32, word:[]u8)i32 {
    if(at<0 || at+word.len>h.len){return 0;}
    let k:i32=0;
    while(k<word.len && h[at+k]==word[k]){k=k+1;}
    if(k!=word.len){return 0;}
    if(at>0 && is_alnum_us(h[at-1])==1){return 0;}
    if(at+word.len<h.len && is_alnum_us(h[at+word.len])==1){return 0;}
    return 1;
}
fn find_word(h:[]u8, from:i32, word:[]u8)i32 {
    let i:i32=find_sub(h,from,word);
    while(i>=0){
        if(word_at(h,i,word)==1){return i;}
        i=find_sub(h,i+1,word);
    }
    return -1;
}

// ---------------- file IO (nio substrate API) ----------------
fn split_dir2(p:[]u8, dir:[]u8, name:[]u8)i64 {
    let cut:i32=-1;
    let i:i32=0;
    while(i<p.len){if(p[i]==47){cut=i;} i=i+1;}
    if(cut<0){return -1;}
    let k:i32=0;
    while(k<cut){dir[k]=p[k]; k=k+1;}
    let n:i32=p.len-cut-1;
    k=0;
    while(k<n){name[k]=p[cut+1+k]; k=k+1;}
    return ((cut as i64)*4294967296)+(n as i64);
}
fn read_whole(p:[]u8, buf:[]u8)i64 {
    let dir:[]u8=nio_alloc(4096);
    let name:[]u8=nio_alloc(4096);
    if(dir.len!=4096 || name.len!=4096){nio_free(dir); nio_free(name); return -11;}
    let sp:i64=split_dir2(p,dir,name);
    if(sp<0){
        dir[0]=46;
        if(p.len>name.len){nio_free(dir); nio_free(name); return -12;}
        let k:i32=0;
        while(k<p.len){name[k]=p[k]; k=k+1;}
        sp=4294967296+(p.len as i64);
    }
    let dl:i32=(sp/4294967296) as i32;
    let nl:i32=(sp%4294967296) as i32;
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){nio_free(dir); nio_free(name); return -13;}
    let fd:i64=nio_open_child(root,name[0..nl],0);
    if(fd<0){nio_free(dir); nio_free(name); return -14;}
    let n:i64=nio_read_exact(fd,buf,buf.len);
    let cr:i64=nio_close(fd);
    if(cr!=0){n=-15;}
    nio_free(dir); nio_free(name);
    return n;
}
fn write_whole(p:[]u8, data:[]u8, n:i32)i64 {
    let dir:[]u8=nio_alloc(4096);
    let name:[]u8=nio_alloc(4096);
    if(dir.len!=4096 || name.len!=4096){nio_free(dir); nio_free(name); return -11;}
    let sp:i64=split_dir2(p,dir,name);
    if(sp<0){
        dir[0]=46;
        if(p.len>name.len){nio_free(dir); nio_free(name); return -12;}
        let k:i32=0;
        while(k<p.len){name[k]=p[k]; k=k+1;}
        sp=4294967296+(p.len as i64);
    }
    let dl:i32=(sp/4294967296) as i32;
    let nl:i32=(sp%4294967296) as i32;
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){nio_free(dir); nio_free(name); return -13;}
    let fd:i64=nio_open_child(root,name[0..nl],1);
    if(fd<0){nio_free(dir); nio_free(name); return -14;}
    let w:i64=nio_write_all(fd,data[0..n]);
    let cr:i64=nio_close(fd);
    nio_free(dir); nio_free(name);
    if(w<0){return -16;}
    if(cr!=0){return -15;}
    return n as i64;
}
// sha256_hex(path, workbuf) -> fresh []u8 hex string (caller must nio_free),
// or empty slice on IO error.
fn sha256_hex_file(p:[]u8, cap:i32)[]u8 {
    let buf:[]u8=nio_alloc(cap);
    if(buf.len!=cap){return "";}
    let n:i64=read_whole(p,buf);
    if(n<0){nio_free(buf); return "";}
    let h:[]u8=nio_alloc(32);
    if(h.len!=32){nio_free(buf); return "";}
    if(ns_sha256(buf[0..(n as i32)],h)!=0){nio_free(buf); nio_free(h); return "";}
    let hx:[]u8=ns_hex(h);
    nio_free(buf); nio_free(h);
    return hx;
}

// ---------------- comment/string stripping ----------------
// strip_src(src, n, code, strs): code gets comments AND string literals
// blanked (for identifier/type/keyword rules); strs collects string literal
// contents separated by \n (for R6b). Returns 0 ok.

// ---- T-table accessors (ZNC-2026-09-21-007 workaround) ----
// All indexed i32 tables are []u8 arenas holding little-endian i32 slots.
// t_put32 stores any i32 (incl. negative sentinels); t_get32 recovers it.
fn t_put32(a:[]u8, i:i32, v:i32)i32 {
    let o:i32=i*4;
    let uv:i64=(v as i64)&4294967295;
    a[o]=(uv&255) as u8;
    a[o+1]=((uv/256)&255) as u8;
    a[o+2]=((uv/65536)&255) as u8;
    a[o+3]=((uv/16777216)&255) as u8;
    return 0;
}
fn t_get32(a:[]u8, i:i32)i32 {
    let o:i32=i*4;
    let uv:i64=(a[o] as i64)+((a[o+1] as i64)*256)+((a[o+2] as i64)*65536)+((a[o+3] as i64)*16777216);
    if(uv>=2147483648){return ((uv-4294967296) as i32);}
    return (uv as i32);
}

fn strip_src(src:[]u8, n:i32, code:[]u8, strs:[]u8) i32 {
    let si:i32=0;
    let in_str:i32=0;
    let i:i32=0;
    while(i<n){
        let c:u8=src[i];
        if(in_str==1){
            code[i]=32;
            if(c==92){
                if(si<strs.len){strs[si]=c; si=si+1;}
                if(i+1<n){
                    code[i+1]=32;
                    if(si<strs.len){strs[si]=src[i+1]; si=si+1;}
                    i=i+1;
                }
            } else {
                if(c==34){in_str=0;}
                else { if(si<strs.len){strs[si]=c; si=si+1;} }
            }
            i=i+1;
        } else {
            if(c==34){
                in_str=1; code[i]=32; i=i+1;
            } else {
                if(c==47 && i+1<n && src[i+1]==47){
                    while(i<n && src[i]!=10){code[i]=32; i=i+1;}
                } else {
                    code[i]=c; i=i+1;
                }
            }
        }
    }
    if(si<strs.len){strs[si]=10; si=si+1;}
    return 0;
}

// ---------------- intrinsic tier tables (frozen per prereg + amendment) ----------------
fn in_tier_m(tok:[]u8)i32 {
    if(_zag_strcmp(tok,"_zag_arg")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_argc")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_print")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_println")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_i64_to_str")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_strcmp")==1){return 1;}
    return 0;
}
fn in_tier_s_extra(tok:[]u8)i32 {
    if(_zag_strcmp(tok,"_zag_malloc")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_free")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_slice_ptr")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_raw_syscall")==1){return 1;}
    return 0;
}
// banned_explicit: named nondeterminism channels (R6a naming).
fn in_banned_explicit(tok:[]u8)i32 {
    if(_zag_strcmp(tok,"_zag_clock_monotonic_ms")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_rand")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_getenv")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_exec_cmd")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_exec_capture")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_read_fd")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_read_file")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_write_file")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_write_exec")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_file_exists")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_write_stdout")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_write_stderr")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_flush")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_exit")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_linux_syscall")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_darwin_syscall")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_script_env_get")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_cli")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_sti")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_hlt")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_pause")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_wbinvd")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_inb")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_inw")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_inl")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_outb")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_outw")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_outl")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_rdmsr")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_wrmsr")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_read_cr0")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_read_cr2")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_read_cr3")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_read_cr4")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_write_cr0")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_write_cr3")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_write_cr4")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_lgdt")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_lidt")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_ltr")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_invlpg")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_x86_cpuid_eax")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_x86_cpuid_ebx")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_x86_cpuid_ecx")==1){return 1;}
    if(_zag_strcmp(tok,"_zag_x86_cpuid_edx")==1){return 1;}
    return 0;
}
fn syscall_listed(n:i64)i32 {
    if(n==0){return 1;}
    if(n==1){return 1;}
    if(n==2){return 1;}
    if(n==3){return 1;}
    if(n==5){return 1;}
    if(n==8){return 1;}
    if(n==23){return 1;}
    if(n==72){return 1;}
    if(n==74){return 1;}
    if(n==83){return 1;}
    if(n==160){return 1;}
    if(n==257){return 1;}
    if(n==265){return 1;}
    return 0;
}
// pinned substrate hashes (R1b).
fn pinned_substrate_hash(hex:[]u8)i32 {
    if(_zag_strcmp(hex,"e6379ddb0b05d95b5ba2e8454ef8cc6bc74d054cfa44175c379296641e9f61d8")==1){return 1;}
    return 0;
}

// ---------------- rule checks ----------------
// Each returns 0 on pass, else a rule id; on fail writes "RULE:detail" into det.
// Rule ids: R2=2 R6a=61 R6b=62 R4=4 R4b=41 R5=5 R1=1 R1b=11 R7=7 R3p=3
fn det_write(det:[]u8, rule:[]u8, info:[]u8, ilen:i32)i32 {
    let k:i32=0;
    while(k<rule.len && k<det.len){det[k]=rule[k]; k=k+1;}
    if(k<det.len){det[k]=58; k=k+1;}
    let m:i32=0;
    while(m<ilen && m<64 && k<det.len){det[k]=info[m]; k=k+1; m=m+1;}
    if(k<det.len){det[k]=0;}
    return k;
}
fn cstr_len(s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len && s[i]!=0){i=i+1;}
    return i;
}

// check_module_tokens: R2 (tier M) + R6a (banned-explicit naming).
fn check_module_tokens(code:[]u8, n:i32, det:[]u8, det6a:[]u8)i32 {
    let i:i32=find_sub(code,0,"_zag_");
    while(i>=0){
        let j:i32=i+5;
        while(j<n && is_alnum_us(code[j])==1){j=j+1;}
        let tlen:i32=j-i;
        if(tlen>5){
            let tok:[]u8=code[i..j];
            if(in_tier_m(tok)!=1){
                if(in_banned_explicit(tok)==1){
                    det_write(det6a,"R6a",tok,tlen);
                    return 61;
                }
                det_write(det,"R2",tok,tlen);
                return 2;
            }
        }
        i=find_sub(code,j,"_zag_");
    }
    return 0;
}
// check_module_strings: R6b banned literal substrings.
fn check_module_strings(strs:[]u8, det:[]u8)i32 {
    if(has_sub(strs,"urandom")==1){det_write(det,"R6b","urandom",7); return 62;}
    if(has_sub(strs,"/dev/")==1){det_write(det,"R6b","/dev/",5); return 62;}
    if(has_sub(strs,"/proc/")==1){det_write(det,"R6b","/proc/",6); return 62;}
    if(has_sub(strs,"/sys/")==1){det_write(det,"R6b","/sys/",5); return 62;}
    return 0;
}
// check_module_types: R4 (only i32/i64/u8/bool/[]u8/void) + R4b (no nio_* defs).
fn check_module_types(code:[]u8, n:i32, det:[]u8, det4b:[]u8)i32 {
    if(find_word(code,0,"struct")>=0){det_write(det,"R4","struct",6); return 4;}
    let i:i32=find_sub(code,0,"nio_");
    while(i>=0){
        let k:i32=i-1;
        while(k>=0 && (code[k]==32 || code[k]==9)){k=k-1;}
        let w1:i32=k;
        while(w1>=0 && is_alnum_us(code[w1])==1){w1=w1-1;}
        let wlen:i32=k-w1;
        if(wlen==2 && code[w1+1]==102 && code[w1+2]==110){
            det_write(det4b,"R4b","fn nio_* shadow",15);
            return 41;
        }
        i=find_sub(code,i+1,"nio_");
    }
    i=find_sub(code,0,":");
    while(i>=0){
        let k:i32=i+1;
        while(k<n && code[k]==32){k=k+1;}
        if(k<n && code[k]==91){
            if(k+1<n && code[k+1]==93){
                let m:i32=k+2;
                let e:i32=m;
                while(e<n && is_alnum_us(code[e])==1){e=e+1;}
                if(!(e-m==2 && code[m]==117 && code[m+1]==56)){
                    det_write(det,"R4","slice type",10);
                    return 4;
                }
            }
        }
        if(k<n && code[k]==42){
            det_write(det,"R4","pointer type",12);
            return 4;
        }
        i=find_sub(code,i+1,":");
    }
    i=find_word(code,0,"as");
    while(i>=0){
        let k:i32=i+2;
        while(k<n && is_space(code[k])==1){k=k+1;}
        if(k<n && code[k]==42){
            det_write(det,"R4","as *cast",8);
            return 4;
        }
        i=find_word(code,i+2,"as");
    }
    return 0;
}
// check_module_loops: R5 canonical while only.
fn is_ident_start(c:u8)i32 {
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    if(c==95){return 1;}
    return 0;
}
fn check_module_loops(code:[]u8, n:i32, det:[]u8)i32 {
    if(find_word(code,0,"for")>=0){det_write(det,"R5","for",3); return 5;}
    if(find_word(code,0,"loop")>=0){det_write(det,"R5","loop",4); return 5;}
    let i:i32=find_word(code,0,"while");
    while(i>=0){
        let k:i32=i+5;
        while(k<n && is_space(code[k])==1){k=k+1;}
        let ok:i32=0;
        if(k<n && code[k]==40){
            k=k+1;
            while(k<n && is_space(code[k])==1){k=k+1;}
            if(k<n && is_ident_start(code[k])==1){
                while(k<n && is_alnum_us(code[k])==1){k=k+1;}
                while(k<n && is_space(code[k])==1){k=k+1;}
                if(k<n && code[k]==60){ok=1;}
            }
        }
        if(ok!=1){
            det_write(det,"R5","non-canonical while",19);
            return 5;
        }
        i=find_word(code,k,"while");
    }
    return 0;
}
// check_substrate: R2 tier S + syscall literal allowlist.
fn check_substrate(code:[]u8, n:i32, det:[]u8)i32 {
    let i:i32=find_sub(code,0,"_zag_");
    while(i>=0){
        let j:i32=i+5;
        while(j<n && is_alnum_us(code[j])==1){j=j+1;}
        let tlen:i32=j-i;
        if(tlen>5){
            let tok:[]u8=code[i..j];
            if(in_tier_m(tok)!=1 && in_tier_s_extra(tok)!=1){
                det_write(det,"R2",tok,tlen);
                return 2;
            }
        }
        i=find_sub(code,j,"_zag_");
    }
    i=find_sub(code,0,"_zag_raw_syscall(");
    while(i>=0){
        let k:i32=i+17;
        while(k<n && is_space(code[k])==1){k=k+1;}
        if(k>=n || is_digit(code[k])!=1){
            det_write(det,"R2","syscall non-literal",19);
            return 2;
        }
        let num:i64=0;
        while(k<n && is_digit(code[k])==1){
            num=num*10+((code[k] as i64)-48);
            k=k+1;
        }
        while(k<n && is_space(code[k])==1){k=k+1;}
        if(k>=n || code[k]!=44){
            det_write(det,"R2","syscall non-literal",19);
            return 2;
        }
        if(syscall_listed(num)!=1){
            det_write(det,"R2","syscall unlisted",16);
            return 2;
        }
        i=find_sub(code,k,"_zag_raw_syscall(");
    }
    return 0;
}

// ---------------- directory walk (getdents64) ----------------
// walk_fd: recurse fd; relpre like "" or "sub/". Appends found .zag relpaths.
// Returns count or -1 on error (detail in det).
fn walk_fd(fd:i64, relpre:[]u8, fbuf:[]u8, foff:[]u8, flen:[]u8, count:i32, det:[]u8)i32 {
    let db:[]u8=nio_alloc(65536);
    if(db.len!=65536){det_write(det,"R1","walk NOMEM",10); return -1;}
    let c:i32=count;
    let done:i32=0;
    while(done==0){
        let nr:i64=_zag_raw_syscall(217,fd,_zag_slice_ptr(db) as i64,db.len as i64,0,0,0);
        if(nr<0){nio_free(db); det_write(det,"R1","getdents fail",13); return -1;}
        if(nr==0){done=1;}
        else {
            let at:i32=0;
            while(at<(nr as i32)){
                let reclen:i32=(db[at+16] as i32)+((db[at+17] as i32)*256);
                if(reclen<20){nio_free(db); det_write(det,"R1","bad dirent",10); return -1;}
                let dtype:u8=db[at+18];
                let nl:i32=0;
                while(at+19+nl<(nr as i32) && db[at+19+nl]!=0){nl=nl+1;}
                let nm:[]u8=db[at+19..at+19+nl];
                if(!((nl==1 && nm[0]==46) || (nl==2 && nm[0]==46 && nm[1]==46))){
                    if(dtype==10 || dtype==0){
                        nio_free(db); det_write(det,"R1","symlink/unknown",15); return -1;
                    }
                    if(dtype==4){
                        let cfd:i64=nio_open_child(fd,nm,0);
                        if(cfd<0){nio_free(db); det_write(det,"R1","subdir open",11); return -1;}
                        let np:i32=relpre.len+nl+1;
                        let npre:[]u8=nio_alloc(np);
                        if(npre.len!=np){nio_free(db); det_write(det,"R1","walk NOMEM",10); return -1;}
                        let q:i32=0;
                        while(q<relpre.len){npre[q]=relpre[q]; q=q+1;}
                        q=0;
                        while(q<nl){npre[relpre.len+q]=nm[q]; q=q+1;}
                        npre[relpre.len+nl]=47;
                        c=walk_fd(cfd,npre,fbuf,foff,flen,c,det);
                        nio_free(npre);
                        let cr:i64=nio_close(cfd);
                        if(c<0 || cr!=0){nio_free(db); return -1;}
                    } else {
                        if(dtype==8 && nl>4 && nm[nl-4]==46 && nm[nl-3]==122 && nm[nl-2]==97 && nm[nl-1]==103){
                            if(c>=128){nio_free(db); det_write(det,"R1","too many files",14); return -1;}
                            let pl:i32=relpre.len+nl;
                            let bo:i32=c*256;
                            if(bo+pl>fbuf.len){nio_free(db); det_write(det,"R1","walk NOMEM",10); return -1;}
                            let q2:i32=0;
                            while(q2<relpre.len){fbuf[bo+q2]=relpre[q2]; q2=q2+1;}
                            q2=0;
                            while(q2<nl){fbuf[bo+relpre.len+q2]=nm[q2]; q2=q2+1;}
                            t_put32(foff,c,bo); t_put32(flen,c,pl); c=c+1;
                        }
                    }
                }
                at=at+reclen;
            }
        }
    }
    nio_free(db);
    return c;
}

// ---------------- manifest ----------------
// mtier[i]: 0=M 1=S ; mpath via moff/mlen into mbuf ; msha via msoff into mshabuf(64 each)
fn parse_manifest(mb:[]u8, mn:i32, mtier:[]u8, moff:[]u8, mlen:[]u8, mbuf:[]u8,
                  mshabuf:[]u8, mcount:[]u8, binpath:[]u8, binsha:[]u8, det:[]u8)i32 {
    let c:i32=0;
    let i:i32=0;
    while(i<mn){
        let le:i32=i;
        while(le<mn && mb[le]!=10){le=le+1;}
        let llen:i32=le-i;
        if(llen>0 && mb[le-1]==13){llen=llen-1;}
        if(llen>0 && mb[i]!=35){
            if(mb[i]==66 && llen>4 && mb[i+1]==73 && mb[i+2]==78 && mb[i+3]==32){
                let k:i32=i+4;
                let e2:i32=k;
                while(e2<i+llen && mb[e2]!=32){e2=e2+1;}
                let plen:i32=e2-k;
                let q:i32=0;
                while(q<plen && q<binpath.len){binpath[q]=mb[k+q]; q=q+1;}
                if(q<binpath.len){binpath[q]=0;}
                k=e2+1;
                q=0;
                while(q<64 && k+q<i+llen){binsha[q]=mb[k+q]; q=q+1;}
            } else {
                if(c>=128){det_write(det,"R1","manifest too big",16); return -1;}
                let tier:i32=-1;
                if(mb[i]==77){tier=0;}
                if(mb[i]==83){tier=1;}
                if(tier<0 || i+1>=mn || mb[i+1]!=32){det_write(det,"R1","manifest parse",14); return -1;}
                let k:i32=i+2;
                let e2:i32=k;
                while(e2<i+llen && mb[e2]!=32){e2=e2+1;}
                let plen2:i32=e2-k;
                let bo:i32=c*256;
                let q2:i32=0;
                while(q2<plen2 && bo+q2<mbuf.len){mbuf[bo+q2]=mb[k+q2]; q2=q2+1;}
                t_put32(moff,c,bo); t_put32(mlen,c,plen2); t_put32(mtier,c,tier);
                k=e2+1;
                let so:i32=c*64;
                q2=0;
                while(q2<64 && k+q2<i+llen && so+q2<mshabuf.len){mshabuf[so+q2]=mb[k+q2]; q2=q2+1;}
                c=c+1;
            }
        }
        i=le+1;
    }
    t_put32(mcount,0,c);
    return 0;
}
fn manifest_has(moff:[]u8, mlen:[]u8, mbuf:[]u8, mc:i32, path:[]u8)i32 {
    let i:i32=0;
    while(i<mc){
        if(t_get32(mlen,i)==path.len && nio_equal(mbuf[t_get32(moff,i)..t_get32(moff,i)+t_get32(mlen,i)],path)==1){return i;}
        i=i+1;
    }
    return -1;
}

// ---------------- evidence ----------------
fn ev_val(ev:[]u8, en:i32, key:[]u8, val:[]u8)i32 {
    let i:i32=0;
    while(i<en){
        let ls:i32=i;
        while(i<en && ev[i]!=10){i=i+1;}
        let ll:i32=i-ls;
        if(ll>key.len+1){
            let m:i32=0;
            while(m<key.len && ev[ls+m]==key[m]){m=m+1;}
            if(m==key.len && ev[ls+m]==61){
                let v:i32=ls+m+1;
                let q:i32=0;
                while(v+q<ls+ll && q<val.len){val[q]=ev[v+q]; q=q+1;}
                if(q<val.len){val[q]=0;}
                return q;
            }
        }
        i=i+1;
    }
    return -1;
}
fn ev_is_one(ev:[]u8, en:i32, key:[]u8)i32 {
    let v:[]u8=nio_alloc(32);
    if(v.len!=32){return 0;}
    let q:i32=ev_val(ev,en,key,v);
    let ok:i32=0;
    if(q==1 && v[0]==49){ok=1;}
    nio_free(v);
    return ok;
}

// ---------------- attestation ----------------
fn att_line(ab:[]u8, cur:i32, s:[]u8)i32 {
    let c:i32=cur;
    let k:i32=0;
    while(k<s.len && c<ab.len){ab[c]=s[k]; c=c+1; k=k+1;}
    if(c<ab.len){ab[c]=10; c=c+1;}
    return c;
}
fn att_kv(ab:[]u8, cur:i32, k:[]u8, v:[]u8, vlen:i32)i32 {
    let c:i32=cur;
    let i:i32=0;
    while(i<k.len && c<ab.len){ab[c]=k[i]; c=c+1; i=i+1;}
    i=0;
    while(i<vlen && c<ab.len){ab[c]=v[i]; c=c+1; i=i+1;}
    if(c<ab.len){ab[c]=10; c=c+1;}
    return c;
}

// ---------------- path join + import normalize ----------------
fn join_path(dir:[]u8, rel:[]u8, out:[]u8)i32 {
    let c:i32=0;
    let i:i32=0;
    while(i<dir.len && c<out.len){out[c]=dir[i]; c=c+1; i=i+1;}
    if(c>0 && out[c-1]!=47 && c<out.len){out[c]=47; c=c+1;}
    i=0;
    while(i<rel.len && c<out.len){out[c]=rel[i]; c=c+1; i=i+1;}
    return c;
}
fn strip_comments_only(src:[]u8, n:i32, out:[]u8)i32 {
    let in_str:i32=0;
    let i:i32=0;
    while(i<n){
        let c2:u8=src[i];
        if(in_str==1){
            out[i]=c2;
            if(c2==92 && i+1<n){out[i+1]=src[i+1]; i=i+1;}
            else { if(c2==34){in_str=0;} }
            i=i+1;
        } else {
            if(c2==34){in_str=1; out[i]=c2; i=i+1;}
            else {
                if(c2==47 && i+1<n && src[i+1]==47){
                    while(i<n && src[i]!=10){out[i]=32; i=i+1;}
                } else { out[i]=c2; i=i+1; }
            }
        }
    }
    return 0;
}
// norm_import: resolve @import target against the importing file's dir.
// out gets the normalized relpath; returns len or -1 on escape/error.
fn norm_import(impdir:[]u8, tgt:[]u8, out:[]u8)i32 {
    let tmp:[]u8=nio_alloc(4096);
    if(tmp.len!=4096){return -1;}
    let c:i32=0;
    let i:i32=0;
    while(i<impdir.len && c<4095){tmp[c]=impdir[i]; c=c+1; i=i+1;}
    if(c>0 && c<4095){tmp[c]=47; c=c+1;}
    i=0;
    while(i<tgt.len && c<4095){tmp[c]=tgt[i]; c=c+1; i=i+1;}
    let coffr:[]u8=nio_alloc(256); let coff:[]u8=coffr;
    let clenr:[]u8=nio_alloc(256); let clen:[]u8=clenr;
    if(coffr.len!=256 || clenr.len!=256){nio_free(tmp); nio_free(coffr); nio_free(clenr); return -1;}
    let nc:i32=0;
    i=0;
    while(i<c){
        while(i<c && tmp[i]==47){i=i+1;}
        if(i>=c){i=c;}
        else {
            let s2:i32=i;
            while(i<c && tmp[i]!=47){i=i+1;}
            if(nc<64){t_put32(coff,nc,s2); t_put32(clen,nc,i-s2); nc=nc+1;}
        }
    }
    let str:[]u8=nio_alloc(256); let st:[]u8=str;
    if(str.len!=256){nio_free(tmp); nio_free(coffr); nio_free(clenr); nio_free(str); return -1;}
    let sp2:i32=0;
    let bad:i32=0;
    i=0;
    while(i<nc && bad==0){
        let l:[]u8=tmp[t_get32(coff,i)..t_get32(coff,i)+t_get32(clen,i)];
        if(t_get32(clen,i)==1 && l[0]==46){}
        else {
            if(t_get32(clen,i)==2 && l[0]==46 && l[1]==46){
                if(sp2==0){bad=1;}
                else {sp2=sp2-1;}
            }
            else {t_put32(st,sp2,i); sp2=sp2+1;}
        }
        i=i+1;
    }
    let o:i32=0;
    if(bad==0){
        i=0;
        while(i<sp2){
            if(o>0 && o<out.len){out[o]=47; o=o+1;}
            let ci:i32=t_get32(st,i);
            let q:i32=0;
            while(q<t_get32(clen,ci) && o<out.len){out[o]=tmp[t_get32(coff,ci)+q]; o=o+1; q=q+1;}
            i=i+1;
        }
    }
    nio_free(tmp); nio_free(coffr); nio_free(clenr); nio_free(str);
    if(bad==1){return -1;}
    return o;
}
fn check_imports(nc:[]u8, n:i32, impdir:[]u8, moff:[]u8, mlen:[]u8, mbuf:[]u8, mc:i32, det:[]u8)i32 {
    let i:i32=find_sub(nc,0,"@import(");
    while(i>=0){
        let k:i32=i+8;
        while(k<n && is_space(nc[k])==1){k=k+1;}
        if(k>=n || nc[k]!=34){det_write(det,"R1","import syntax",13); return 1;}
        k=k+1;
        let s2:i32=k;
        while(k<n && nc[k]!=34){k=k+1;}
        if(k>=n){det_write(det,"R1","import syntax",13); return 1;}
        let tgt:[]u8=nc[s2..k];
        let out:[]u8=nio_alloc(1024);
        if(out.len!=1024){det_write(det,"R1","import NOMEM",12); return 1;}
        let ol:i32=norm_import(impdir,tgt,out);
        if(ol<0){nio_free(out); det_write(det,"R1","import escapes build",20); return 1;}
        let np:[]u8=out[0..ol];
        if(manifest_has(moff,mlen,mbuf,mc,np)<0){
            nio_free(out); det_write(det,"R1","import unlisted",15); return 1;
        }
        nio_free(out);
        i=find_sub(nc,k,"@import(");
    }
    return 0;
}
fn impdir_of(moff:[]u8, mlen:[]u8, mbuf:[]u8, idx:i32, out:[]u8)i32 {
    let p:[]u8=mbuf[t_get32(moff,idx)..t_get32(moff,idx)+t_get32(mlen,idx)];
    let cut:i32=-1;
    let i:i32=0;
    while(i<p.len){if(p[i]==47){cut=i;} i=i+1;}
    if(cut<0){return 0;}
    i=0;
    while(i<cut && i<out.len){out[i]=p[i]; i=i+1;}
    return cut;
}

// ---------------- main ----------------
fn main()i32 {
    if((_zag_argc() as i32)!=6){
        _zag_println("usage: thincert <manifest> <builddir> <binary> <replay-evidence> <attestation>");
        return 2;
    }
    let manP:[]u8=_zag_arg(1);
    let bdirP:[]u8=_zag_arg(2);
    let binP:[]u8=_zag_arg(3);
    let evP:[]u8=_zag_arg(4);
    let attP:[]u8=_zag_arg(5);

    let vR1:i32=1; let vR1b:i32=1; let vR2:i32=1; let vR4:i32=1; let vR4b:i32=1;
    let vR5:i32=1; let vR6a:i32=1; let vR6b:i32=1; let vR7:i32=1; let vEV:i32=1;
    let d1:[]u8=nio_alloc(256); let d1b:[]u8=nio_alloc(256);
    let d2:[]u8=nio_alloc(256); let d4:[]u8=nio_alloc(256); let d4b:[]u8=nio_alloc(256);
    let d5:[]u8=nio_alloc(256); let d6a:[]u8=nio_alloc(256); let d6b:[]u8=nio_alloc(256);
    let d7:[]u8=nio_alloc(256); let dev:[]u8=nio_alloc(256);
    let det:[]u8=nio_alloc(256);
    if(d1.len!=256 || det.len!=256){_zag_println("NOMEM"); return 2;}

    let mb:[]u8=nio_alloc(65536);
    if(mb.len!=65536){_zag_println("NOMEM"); return 2;}
    let mn:i64=read_whole(manP,mb);
    if(mn<0){_zag_println("manifest unreadable"); return 2;}
    let mh:[]u8=nio_alloc(32);
    if(mh.len!=32){_zag_println("NOMEM"); return 2;}
    if(ns_sha256(mb[0..(mn as i32)],mh)!=0){_zag_println("sha fail"); return 2;}
    let mhx:[]u8=ns_hex(mh);

    let mtierr:[]u8=nio_alloc(512); let mtier:[]u8=mtierr;
    let moffr:[]u8=nio_alloc(512); let moff:[]u8=moffr;
    let mlenr:[]u8=nio_alloc(512); let mlen:[]u8=mlenr;
    let mbuf:[]u8=nio_alloc(32768);
    let mshabuf:[]u8=nio_alloc(8192);
    let binpath:[]u8=nio_alloc(256);
    let binsha:[]u8=nio_alloc(64);
    if(mtierr.len!=512 || mbuf.len!=32768){_zag_println("NOMEM"); return 2;}
    let mc:i32=0;
    let mcpr:[]u8=nio_alloc(4); let mcp:[]u8=mcpr;
    if(parse_manifest(mb,mn as i32,mtier,moff,mlen,mbuf,mshabuf,mcp,binpath,binsha,det)!=0){
        det_write(d1,"R1",det,200);
        vR1=0;
    } else { mc=t_get32(mcp,0); }
    nio_free(mcpr);

    // per-file checks
    let fi:i32=0;
    while(fi<mc){
        let plen:i32=t_get32(mlen,fi);
        let p:[]u8=mbuf[t_get32(moff,fi)..t_get32(moff,fi)+plen];
        let fp:[]u8=nio_alloc(4096);
        let fpl:i32=join_path(bdirP,p,fp);
        let content:[]u8=nio_alloc(4194304);
        let n:i64=read_whole(fp[0..fpl],content);
        if(n<0){
            if(vR1==1){vR1=0; det_write(d1,"R1","unreadable",10);}
        } else {
            let h:[]u8=nio_alloc(32);
            let hx:[]u8=ns_hex(h);
            if(ns_sha256(content[0..(n as i32)],h)!=0){
                if(vR1==1){vR1=0; det_write(d1,"R1","sha fail",8);}
            } else {
                nio_free(hx);
                hx=ns_hex(h);
                let expsha:[]u8=mshabuf[fi*64..fi*64+64];
                if(nio_equal(hx[0..64],expsha)!=1){
                    if(vR1==1){vR1=0; det_write(d1,"R1",p,plen);}
                } else {
                    if(t_get32(mtier,fi)==1 && pinned_substrate_hash(hx)!=1){
                        if(vR1b==1){vR1b=0; det_write(d1b,"R1b",p,plen);}
                    }
                }
                let nn:i32=n as i32;
                let code:[]u8=nio_alloc(nn);
                let strs:[]u8=nio_alloc(nn);
                let nc:[]u8=nio_alloc(nn);
                if(code.len==nn && strs.len==nn && nc.len==nn){
                    strip_src(content,nn,code,strs);
                    strip_comments_only(content,nn,nc);
                    let idb:[]u8=nio_alloc(1024);
                    let idl:i32=impdir_of(moff,mlen,mbuf,fi,idb);
                    if(check_imports(nc,nn,idb[0..idl],moff,mlen,mbuf,mc,det)==1){
                        if(vR1==1){vR1=0; let q:i32=0; while(q<200 && q<d1.len){d1[q]=det[q]; q=q+1;}}
                    }
                    nio_free(idb);
                    if(t_get32(mtier,fi)==0){
                        let r:i32=check_module_tokens(code,nn,det,d6a);
                        if(r==61 && vR6a==1){vR6a=0;}
                        if(r==2 && vR2==1){vR2=0; let q3:i32=0; while(q3<200 && q3<d2.len){d2[q3]=det[q3]; q3=q3+1;}}
                        if(check_module_strings(strs,d6b)==62 && vR6b==1){
                            vR6b=0;
                        }
                        let r4:i32=check_module_types(code,nn,det,d4b);
                        if(r4==41 && vR4b==1){vR4b=0;}
                        if(r4==4 && vR4==1){vR4=0; let q6:i32=0; while(q6<200 && q6<d4.len){d4[q6]=det[q6]; q6=q6+1;}}
                        if(check_module_loops(code,nn,det)==5 && vR5==1){
                            vR5=0; let q7:i32=0; while(q7<200 && q7<d5.len){d5[q7]=det[q7]; q7=q7+1;}
                        }
                    } else {
                        if(check_substrate(code,nn,det)!=0 && vR2==1){
                            vR2=0; let q8:i32=0; while(q8<200 && q8<d2.len){d2[q8]=det[q8]; q8=q8+1;}
                        }
                    }
                    nio_free(code); nio_free(strs); nio_free(nc);
                }
                nio_free(hx);
            }
            nio_free(h);
        }
        nio_free(fp); nio_free(content);
        fi=fi+1;
    }

    // R1c: walk builddir, every .zag must be manifest-listed
    let fbuf:[]u8=nio_alloc(32768);
    let foffr:[]u8=nio_alloc(512); let foff:[]u8=foffr;
    let flenr:[]u8=nio_alloc(512); let flen:[]u8=flenr;
    if(fbuf.len==32768){
        let root:i64=nio_open_root(bdirP);
        if(root<0){
            if(vR1==1){vR1=0; det_write(d1,"R1","builddir open",13);}
        } else {
            let empty:[]u8=nio_alloc(0);
            let fc:i32=walk_fd(root,empty,fbuf,foff,flen,0,det);
            let cr2:i64=nio_close(root);
            if(fc<0 || cr2!=0){
                if(vR1==1 && fc>=0){vR1=0; det_write(d1,"R1","walk fail",9);}
                if(fc<0 && vR1==1){vR1=0; let q9:i32=0; while(q9<200 && q9<d1.len){d1[q9]=det[q9]; q9=q9+1;}}
            } else {
                let wi:i32=0;
                while(wi<fc){
                    let wp:[]u8=fbuf[t_get32(foff,wi)..t_get32(foff,wi)+t_get32(flen,wi)];
                    if(manifest_has(moff,mlen,mbuf,mc,wp)<0){
                        if(vR1==1){vR1=0; det_write(d1,"R1",wp,t_get32(flen,wi));}
                    }
                    wi=wi+1;
                }
            }
        }
    }
    nio_free(fbuf); nio_free(foffr); nio_free(flenr);

    // R7: binary hash
    let binhex:[]u8=sha256_hex_file(binP,33554431);
    if(binhex.len==0){
        vR7=0; det_write(d7,"R7","binary unreadable",17);
    } else {
        if(binhex.len!=64 || nio_equal(binhex[0..64],binsha[0..64])!=1){
            vR7=0; det_write(d7,"R7","binary hash mismatch",20);
        }
        nio_free(binhex);
    }

    // evidence
    let evb:[]u8=nio_alloc(8192);
    let evn:i64=read_whole(evP,evb);
    if(evn<0){vEV=0; det_write(dev,"EV","evidence unreadable",19);}
    else {
        let en:i32=evn as i32;
        if(ev_is_one(evb,en,"byte_identical")!=1){vEV=0; det_write(dev,"EV","byte_identical!=1",16);}
        else {
            if(ev_is_one(evb,en,"varies_with_state")!=1){vEV=0; det_write(dev,"EV","varies!=1",9);}
            else {
                if(ev_is_one(evb,en,"exit_ok")!=1){vEV=0; det_write(dev,"EV","exit_ok!=1",10);}
                else {
                    if(ev_is_one(evb,en,"rebuild_ok")!=1){vEV=0; det_write(dev,"EV","rebuild_ok!=1",13);}
                    else {
                        let rv:[]u8=nio_alloc(32);
                        let rq:i32=ev_val(evb,en,"runs",rv);
                        let rn:i32=0;
                        let ri:i32=0;
                        while(ri<rq && rv[ri]>=48 && rv[ri]<=57){rn=rn*10+((rv[ri] as i32)-48); ri=ri+1;}
                        nio_free(rv);
                        if(rq<0 || ri!=rq || rn<8){vEV=0; det_write(dev,"EV","runs<8",6);}
                    }
                }
            }
        }
    }

    // attestation
    let ab:[]u8=nio_alloc(8192);
    let cur:i32=0;
    cur=att_line(ab,cur,"thincert=THINCERT-2026-09-20-v1");
    cur=att_line(ab,cur,"amendment=AMENDMENT_2026-09-20_THINCERT_R3:DRAFT-pending-Micah");
    cur=att_kv(ab,cur,"manifest_sha256=",mhx,64);
    let l1:i32=cstr_len(d1); let l1b:i32=cstr_len(d1b); let l2:i32=cstr_len(d2);
    let l4:i32=cstr_len(d4); let l4b:i32=cstr_len(d4b); let l5:i32=cstr_len(d5);
    let l6a:i32=cstr_len(d6a); let l6b:i32=cstr_len(d6b);
    let l7:i32=cstr_len(d7); let lev:i32=cstr_len(dev);
    if(vR1==1){cur=att_line(ab,cur,"R1=PASS");} else {cur=att_kv(ab,cur,"R1=FAIL:",d1,l1);}
    if(vR1b==1){cur=att_line(ab,cur,"R1b=PASS");} else {cur=att_kv(ab,cur,"R1b=FAIL:",d1b,l1b);}
    if(vR2==1){cur=att_line(ab,cur,"R2=PASS");} else {cur=att_kv(ab,cur,"R2=FAIL:",d2,l2);}
    if(vR4==1){cur=att_line(ab,cur,"R4=PASS");} else {cur=att_kv(ab,cur,"R4=FAIL:",d4,l4);}
    if(vR4b==1){cur=att_line(ab,cur,"R4b=PASS");} else {cur=att_kv(ab,cur,"R4b=FAIL:",d4b,l4b);}
    if(vR5==1){cur=att_line(ab,cur,"R5=PASS");} else {cur=att_kv(ab,cur,"R5=FAIL:",d5,l5);}
    if(vR6a==1){cur=att_line(ab,cur,"R6a=PASS");} else {cur=att_kv(ab,cur,"R6a=FAIL:",d6a,l6a);}
    if(vR6b==1){cur=att_line(ab,cur,"R6b=PASS");} else {cur=att_kv(ab,cur,"R6b=FAIL:",d6b,l6b);}
    if(vR7==1){cur=att_line(ab,cur,"R7=PASS");} else {cur=att_kv(ab,cur,"R7=FAIL:",d7,l7);}
    if(vEV==1){cur=att_line(ab,cur,"REPLAY=PASS");} else {cur=att_kv(ab,cur,"REPLAY=FAIL:",dev,lev);}
    let tw:[]u8=nio_alloc(32);
    let twl:i32=ev_val(evb,evn as i32,"tripwire_v2",tw);
    if(twl>=0){cur=att_kv(ab,cur,"tripwire_v2=",tw,cstr_len(tw));}
    else {cur=att_line(ab,cur,"tripwire_v2=UNKNOWN");}
    nio_free(tw);
    let pass:i32=1;
    if(vR1!=1 || vR1b!=1 || vR2!=1 || vR4!=1 || vR4b!=1 || vR5!=1 || vR6a!=1 || vR6b!=1 || vR7!=1 || vEV!=1){pass=0;}
    if(pass==1){cur=att_line(ab,cur,"verdict=PASS");} else {cur=att_line(ab,cur,"verdict=FAIL");}
    let wr:i64=write_whole(attP,ab,cur);
    nio_free(ab); nio_free(evb);
    nio_free(d1); nio_free(d1b); nio_free(d2); nio_free(d4); nio_free(d4b);
    nio_free(d5); nio_free(d6a); nio_free(d6b); nio_free(d7); nio_free(dev); nio_free(det);
    nio_free(mb); nio_free(mh); nio_free(mhx);
    nio_free(mtierr); nio_free(moffr); nio_free(mlenr); nio_free(mbuf); nio_free(mshabuf);
    nio_free(binpath); nio_free(binsha);
    if(wr<0){_zag_println("attestation write fail"); return 2;}
    if(pass==1){return 0;}
    return 1;
}

@import("substrate/R33_NATIVE_IO_V1.zag")
// tprobe.zag — KB-FIDELITY accessor unit test for the certifier rebuild.
// Returns 0 if all checks pass, else the failing check number.
// Exercises: round-trip incl. negatives, boundary slots, adjacent
// equal-sized arenas (the ZNC-2026-09-21-007 trigger shape) with no
// cross-arena contamination.
fn t_put32(a:[]u8, i:i32, v:i32)i32 {
    let o:i32=i*4;
    let uv:i64=(v as i64)&4294967295;
    a[o]=(uv&255) as u8;
    a[o+1]=((uv/256)&255) as u8;
    a[o+2]=((uv/65536)&255) as u8;
    a[o+3]=((uv/16777216)&255) as u8;
    return 0;
}
fn t_get32(a:[]u8, i:i32)i32 {
    let o:i32=i*4;
    let uv:i64=(a[o] as i64)+((a[o+1] as i64)*256)+((a[o+2] as i64)*65536)+((a[o+3] as i64)*16777216);
    if(uv>=2147483648){return ((uv-4294967296) as i32);}
    return (uv as i32);
}
fn main()i32 {
    let ar:[]u8=nio_alloc(256);
    let br:[]u8=nio_alloc(256);
    let cr:[]u8=nio_alloc(256);
    if(ar.len!=256 || br.len!=256 || cr.len!=256){return 1;}
    // check 2: round-trip incl. negatives and extremes
    t_put32(ar,0,0); t_put32(ar,1,1); t_put32(ar,2,-1);
    t_put32(ar,3,2147483647); t_put32(ar,4,-2147483648);
    t_put32(ar,5,123456789); t_put32(ar,6,-123456789);
    t_put32(ar,63,777);
    if(t_get32(ar,0)!=0){return 2;}
    if(t_get32(ar,1)!=1){return 2;}
    if(t_get32(ar,2)!=-1){return 2;}
    if(t_get32(ar,3)!=2147483647){return 2;}
    if(t_get32(ar,4)!=-2147483648){return 2;}
    if(t_get32(ar,5)!=123456789){return 2;}
    if(t_get32(ar,6)!=-123456789){return 2;}
    if(t_get32(ar,63)!=777){return 2;}
    // check 3: adjacent equal-sized arenas, no cross contamination.
    // (old miscompile: 2nd array idx 0..2 read 1st array slots 9..11)
    let i:i32=0;
    while(i<64){t_put32(ar,i,1000+i); t_put32(br,i,2000+i); t_put32(cr,i,3000+i); i=i+1;}
    i=0;
    while(i<64){
        if(t_get32(ar,i)!=1000+i){return 3;}
        if(t_get32(br,i)!=2000+i){return 3;}
        if(t_get32(cr,i)!=3000+i){return 3;}
        i=i+1;
    }
    // check 4: the exact old trigger slots stay independent
    if(t_get32(br,0)!=2000 || t_get32(br,1)!=2001 || t_get32(br,2)!=2002){return 4;}
    if(t_get32(ar,9)!=1009 || t_get32(ar,10)!=1010 || t_get32(ar,11)!=1011){return 4;}
    // check 5: overwrite one arena, siblings untouched
    t_put32(br,0,-1);
    if(t_get32(br,0)!=-1){return 5;}
    if(t_get32(ar,0)!=1000 || t_get32(cr,0)!=3000){return 5;}
    return 0;
}

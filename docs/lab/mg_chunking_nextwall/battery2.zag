    zn=0;
    let p21:i64=tnn_intake(21,"what is the 3rd letter of  ab"," ab","b",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p21);
    lnat=lnat+unpack_native(p21);
    lfb=lfb+unpack_fb(p21);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W22 [M] digit target letter
    //   oracle: q="how many 7's in 777" t='777' exp='3'
    at=ob_raw(out,at,"W 22 [M] q=\"");
    at=ob_raw(out,at,"how many 7's in 777");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"777");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"3");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p22:i64=tnn_intake(22,"how many 7's in 777","777","3",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p22);
    lnat=lnat+unpack_native(p22);
    lfb=lfb+unpack_fb(p22);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W23 [N] index past end clamps to last char
    //   oracle: q='what is the 5th letter of abc' t='abc' exp='c'
    at=ob_raw(out,at,"W 23 [N] q=\"");
    at=ob_raw(out,at,"what is the 5th letter of abc");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"abc");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"c");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p23:i64=tnn_intake(23,"what is the 5th letter of abc","abc","c",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p23);
    lnat=lnat+unpack_native(p23);
    lfb=lfb+unpack_fb(p23);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W24 [N] index 0 clamps to first char
    //   oracle: q='what is the 0th letter of abc' t='abc' exp='a'
    at=ob_raw(out,at,"W 24 [N] q=\"");
    at=ob_raw(out,at,"what is the 0th letter of abc");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"abc");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"a");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p24:i64=tnn_intake(24,"what is the 0th letter of abc","abc","a",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p24);
    lnat=lnat+unpack_native(p24);
    lfb=lfb+unpack_fb(p24);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W25 [E] LAST: empty text position; '?' = no character exists
    //   oracle: q='what is the 1st letter of ' t='' exp='?'
    at=ob_raw(out,at,"W 25 [E] q=\"");
    at=ob_raw(out,at,"what is the 1st letter of ");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"?");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p25:i64=tnn_intake(25,"what is the 1st letter of ","","?",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p25);
    lnat=lnat+unpack_native(p25);
    lfb=lfb+unpack_fb(p25);
    nio_write_all(1,out[flushed..at]); flushed=at;
    at=ob_raw(out,at,"# WALL SUMMARY n=26 correct=");
    at=ob_i64(out,at,lc,scr);
    at=ob_raw(out,at," native=");
    at=ob_i64(out,at,lnat,scr);
    at=ob_raw(out,at," fallback=");
    at=ob_i64(out,at,lfb,scr);
    at=ob_nl(out,at);
    nio_write_all(1,out[flushed..at]); // final: summary
    return;
}

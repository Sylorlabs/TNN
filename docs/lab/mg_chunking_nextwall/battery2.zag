// battery2.zag — THE NEXT WALL (2026-09-26).
//
// 26 FRESH traps in classes the derived policy never saw during
// measurement (new granularities, indirect references, unseen ordinals,
// mid-stream ambiguity, degenerate inputs, case, nesting). Every trap has
// a known answer, oracle-checked in gen_wall.py before emission.
//
// RULE: no re-derivation. The battery runs through the FROZEN production
// tnn_intake only. Measure, don't chase.
@import("../mg_chunking_promote/intake.zag")

fn unpack_correct(p:i64) i64 { return p-(p/2)*2; }
fn unpack_native(p:i64) i64 { let q1:i64=p/2; return q1-(q1/2)*2; }
fn unpack_fb(p:i64) i64 { let q2:i64=p/4; return q2-(q2/2)*2; }

fn main() void {
    let out:[]u8=nio_alloc(1048576);
    let at:i64=0;
    let scr:[]u8=nio_alloc(4096);
    let soff:[]u8=nio_alloc(256);
    let slen:[]u8=nio_alloc(256);
    let zlog:[]u8=nio_alloc(8192);
    let zn:i64=0;
    let woffs:[]u8=nio_alloc(256);
    let wlens:[]u8=nio_alloc(256);
    let revbuf:[]u8=nio_alloc(4096);
    let abuf:[]u8=nio_alloc(4096);
    let whyb:[]u8=nio_alloc(4096);
    let flushed:i64=0;
    at=ob_raw(out,at,"# WALL-RUN v1: 26 fresh traps through the FROZEN production intake (no re-derivation)");
    at=ob_nl(out,at);
    let lc:i64=0; let lnat:i64=0; let lfb:i64=0;
    // W00 [A] sentence count = period count; no candidate chunks sentences
    //   oracle: q='how many sentences in the cat sat. the dog ran.' t='the cat sat. the dog ran.' exp='2'
    at=ob_raw(out,at,"W 00 [A] q=\"");
    at=ob_raw(out,at,"how many sentences in the cat sat. the dog ran.");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"the cat sat. the dog ran.");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"2");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p0:i64=tnn_intake(0,"how many sentences in the cat sat. the dog ran.","the cat sat. the dog ran.","2",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p0);
    lnat=lnat+unpack_native(p0);
    lfb=lfb+unpack_fb(p0);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W01 [A] 2nd sentence by period-split; sentence scale unseen
    //   oracle: q='what is the 2nd sentence of the cat sat. the dog ran.' t='the cat sat. the dog ran.' exp='the dog ran'
    at=ob_raw(out,at,"W 01 [A] q=\"");
    at=ob_raw(out,at,"what is the 2nd sentence of the cat sat. the dog ran.");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"the cat sat. the dog ran.");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"the dog ran");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p1:i64=tnn_intake(1,"what is the 2nd sentence of the cat sat. the dog ran.","the cat sat. the dog ran.","the dog ran",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p1);
    lnat=lnat+unpack_native(p1);
    lfb=lfb+unpack_fb(p1);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W02 [A] line count; newline is not a word separator in the machinery
    //   oracle: q='how many lines in a\\nb\\nc' t='a\nb\nc' exp='3'
    at=ob_raw(out,at,"W 02 [A] q=\"");
    at=ob_raw(out,at,"how many lines in a\\nb\\nc");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"a\nb\nc");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"3");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p2:i64=tnn_intake(2,"how many lines in a\\nb\\nc","a\nb\nc","3",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p2);
    lnat=lnat+unpack_native(p2);
    lfb=lfb+unpack_fb(p2);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W03 [B] 2nd letter of fox='o', next char='x'; needs 2-hop addressing
    //   oracle: q='what is the letter after the 2nd letter of fox in the quick brown fox' t='the quick brown fox' exp='x'
    at=ob_raw(out,at,"W 03 [B] q=\"");
    at=ob_raw(out,at,"what is the letter after the 2nd letter of fox in the quick brown fox");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"the quick brown fox");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"x");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p3:i64=tnn_intake(3,"what is the letter after the 2nd letter of fox in the quick brown fox","the quick brown fox","x",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p3);
    lnat=lnat+unpack_native(p3);
    lfb=lfb+unpack_fb(p3);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W04 [B] word after first 'the' = 'cheese', e-count 3; single 'of'-split can't express
    //   oracle: q="how many e's in the word after the in the cheese wheel" t='the cheese wheel' exp='3'
    at=ob_raw(out,at,"W 04 [B] q=\"");
    at=ob_raw(out,at,"how many e's in the word after the in the cheese wheel");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"the cheese wheel");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"3");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p4:i64=tnn_intake(4,"how many e's in the word after the in the cheese wheel","the cheese wheel","3",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p4);
    lnat=lnat+unpack_native(p4);
    lfb=lfb+unpack_fb(p4);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W05 [B] word before fox = 'brown' -> 'b'; relative addressing unseen
    //   oracle: q='what is the 1st letter of the word before fox in the quick brown fox' t='the quick brown fox' exp='b'
    at=ob_raw(out,at,"W 05 [B] q=\"");
    at=ob_raw(out,at,"what is the 1st letter of the word before fox in the quick brown fox");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"the quick brown fox");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"b");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p5:i64=tnn_intake(5,"what is the 1st letter of the word before fox in the quick brown fox","the quick brown fox","b",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p5);
    lnat=lnat+unpack_native(p5);
    lfb=lfb+unpack_fb(p5);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W06 [B] word after quick = 'brown' reversed; needs address-then-reverse
    //   oracle: q='spell the word after quick backwards in the quick brown fox' t='the quick brown fox' exp='nworb'
    at=ob_raw(out,at,"W 06 [B] q=\"");
    at=ob_raw(out,at,"spell the word after quick backwards in the quick brown fox");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"the quick brown fox");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"nworb");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p6:i64=tnn_intake(6,"spell the word after quick backwards in the quick brown fox","the quick brown fox","nworb",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p6);
    lnat=lnat+unpack_native(p6);
    lfb=lfb+unpack_fb(p6);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W07 [C] 'second' not in parser vocabulary (digits/first/last only)
    //   oracle: q='what is the second letter of strawberry' t='strawberry' exp='t'
    at=ob_raw(out,at,"W 07 [C] q=\"");
    at=ob_raw(out,at,"what is the second letter of strawberry");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"strawberry");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"t");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p7:i64=tnn_intake(7,"what is the second letter of strawberry","strawberry","t",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p7);
    lnat=lnat+unpack_native(p7);
    lfb=lfb+unpack_fb(p7);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W08 [C] 'third' not in parser vocabulary
    //   oracle: q='how many letters in the third word of the quick brown fox' t='the quick brown fox' exp='5'
    at=ob_raw(out,at,"W 08 [C] q=\"");
    at=ob_raw(out,at,"how many letters in the third word of the quick brown fox");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"the quick brown fox");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"5");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p8:i64=tnn_intake(8,"how many letters in the third word of the quick brown fox","the quick brown fox","5",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p8);
    lnat=lnat+unpack_native(p8);
    lfb=lfb+unpack_fb(p8);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W09 [D] needle spans a word boundary; word-match misses, char-span must catch it
    //   oracle: q='does the quick brown fox contain ick bro' t='the quick brown fox' exp='yes'
    at=ob_raw(out,at,"W 09 [D] q=\"");
    at=ob_raw(out,at,"does the quick brown fox contain ick bro");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"the quick brown fox");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"yes");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p9:i64=tnn_intake(9,"does the quick brown fox contain ick bro","the quick brown fox","yes",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p9);
    lnat=lnat+unpack_native(p9);
    lfb=lfb+unpack_fb(p9);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W10 [D] near-miss needle
    //   oracle: q='does abc contain bcd' t='abc' exp='no'
    at=ob_raw(out,at,"W 10 [D] q=\"");
    at=ob_raw(out,at,"does abc contain bcd");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"abc");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"no");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p10:i64=tnn_intake(10,"does abc contain bcd","abc","no",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p10);
    lnat=lnat+unpack_native(p10);
    lfb=lfb+unpack_fb(p10);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W11 [D] needle longer than any word but shorter than text
    //   oracle: q='does strawberry contain berry berry' t='strawberry' exp='no'
    at=ob_raw(out,at,"W 11 [D] q=\"");
    at=ob_raw(out,at,"does strawberry contain berry berry");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"strawberry");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"no");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p11:i64=tnn_intake(11,"does strawberry contain berry berry","strawberry","no",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p11);
    lnat=lnat+unpack_native(p11);
    lfb=lfb+unpack_fb(p11);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W12 [E] empty text word count
    //   oracle: q='how many words in ' t='' exp='0'
    at=ob_raw(out,at,"W 12 [E] q=\"");
    at=ob_raw(out,at,"how many words in ");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"0");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p12:i64=tnn_intake(12,"how many words in ","","0",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p12);
    lnat=lnat+unpack_native(p12);
    lfb=lfb+unpack_fb(p12);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W13 [E] needle longer than the whole text
    //   oracle: q='does hello contain hello world' t='hello' exp='no'
    at=ob_raw(out,at,"W 13 [E] q=\"");
    at=ob_raw(out,at,"does hello contain hello world");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"hello");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"no");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p13:i64=tnn_intake(13,"does hello contain hello world","hello","no",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p13);
    lnat=lnat+unpack_native(p13);
    lfb=lfb+unpack_fb(p13);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W14 [E] zero-count letter
    //   oracle: q="how many q's in strawberry" t='strawberry' exp='0'
    at=ob_raw(out,at,"W 14 [E] q=\"");
    at=ob_raw(out,at,"how many q's in strawberry");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"strawberry");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"0");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p14:i64=tnn_intake(14,"how many q's in strawberry","strawberry","0",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p14);
    lnat=lnat+unpack_native(p14);
    lfb=lfb+unpack_fb(p14);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W15 [F] case-sensitive scan on unseen all-caps text
    //   oracle: q="how many s's in MISSISSIPPI" t='MISSISSIPPI' exp='0'
    at=ob_raw(out,at,"W 15 [F] q=\"");
    at=ob_raw(out,at,"how many s's in MISSISSIPPI");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"MISSISSIPPI");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"0");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p15:i64=tnn_intake(15,"how many s's in MISSISSIPPI","MISSISSIPPI","0",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p15);
    lnat=lnat+unpack_native(p15);
    lfb=lfb+unpack_fb(p15);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W16 [F] case-sensitive contains on unseen capitalized text
    //   oracle: q='does the Quick Brown Fox contain quick' t='the Quick Brown Fox' exp='no'
    at=ob_raw(out,at,"W 16 [F] q=\"");
    at=ob_raw(out,at,"does the Quick Brown Fox contain quick");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"the Quick Brown Fox");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"no");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p16:i64=tnn_intake(16,"does the Quick Brown Fox contain quick","the Quick Brown Fox","no",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p16);
    lnat=lnat+unpack_native(p16);
    lfb=lfb+unpack_fb(p16);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W17 [G] repeated word: first-occurrence semantics -> 'h'
    //   oracle: q='what is the 2nd letter of the in the quick brown the fox' t='the quick brown the fox' exp='h'
    at=ob_raw(out,at,"W 17 [G] q=\"");
    at=ob_raw(out,at,"what is the 2nd letter of the in the quick brown the fox");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"the quick brown the fox");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"h");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p17:i64=tnn_intake(17,"what is the 2nd letter of the in the quick brown the fox","the quick brown the fox","h",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p17);
    lnat=lnat+unpack_native(p17);
    lfb=lfb+unpack_fb(p17);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W18 [H] true nesting: last word='words' has no 2nd word; parser reads one level
    //   oracle: q='what is the 1st letter of the 2nd word of the last word of hello worldly words' t='hello worldly words' exp='?'
    at=ob_raw(out,at,"W 18 [H] q=\"");
    at=ob_raw(out,at,"what is the 1st letter of the 2nd word of the last word of hello worldly words");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"hello worldly words");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"?");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p18:i64=tnn_intake(18,"what is the 1st letter of the 2nd word of the last word of hello worldly words","hello worldly words","?",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p18);
    lnat=lnat+unpack_native(p18);
    lfb=lfb+unpack_fb(p18);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W19 [I] sentence addressing then word index; sentence scale unseen
    //   oracle: q='what is the 2nd word of the 1st sentence of the cat sat. the dog ran.' t='the cat sat. the dog ran.' exp='cat'
    at=ob_raw(out,at,"W 19 [I] q=\"");
    at=ob_raw(out,at,"what is the 2nd word of the 1st sentence of the cat sat. the dog ran.");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,"the cat sat. the dog ran.");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"cat");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p19:i64=tnn_intake(19,"what is the 2nd word of the 1st sentence of the cat sat. the dog ran.","the cat sat. the dog ran.","cat",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p19);
    lnat=lnat+unpack_native(p19);
    lfb=lfb+unpack_fb(p19);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W20 [J] double spaces + leading/trailing space
    //   oracle: q='how many words in  the  quick  fox ' t=' the  quick  fox ' exp='3'
    at=ob_raw(out,at,"W 20 [J] q=\"");
    at=ob_raw(out,at,"how many words in  the  quick  fox ");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at," the  quick  fox ");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"3");
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    zn=0;
    let p20:i64=tnn_intake(20,"how many words in  the  quick  fox "," the  quick  fox ","3",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p20);
    lnat=lnat+unpack_native(p20);
    lfb=lfb+unpack_fb(p20);
    nio_write_all(1,out[flushed..at]); flushed=at;
    // W21 [J] leading space shifts char indices
    //   oracle: q='what is the 3rd letter of  ab' t=' ab' exp='b'
    at=ob_raw(out,at,"W 21 [J] q=\"");
    at=ob_raw(out,at,"what is the 3rd letter of  ab");
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at," ab");
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,"b");

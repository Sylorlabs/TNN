// loop CLI: loop <case_id> pitch:<hz> env:<flat|rise|decay> <outdir>
// Closed loop: coarse semitone-grid plan -> render0 -> organ measures own
// render -> deadbeat re-plan -> re-render, 3 iterations. All native.
fn iter_path(pth: []u8, outdir: []u8, case_id: []u8, k: i64) []u8 {
    let pos: i64 = scat(pth, 0, outdir);
    pos = scat(pth, pos, "/");
    pos = scat(pth, pos, case_id);
    pos = scat(pth, pos, "_iter");
    pos = scat(pth, pos, i64s(k));
    pos = scat(pth, pos, ".wav");
    return pth[0..pos];
}

fn main() i32 {
    let case_id: []u8 = _zag_arg(1);
    let pd: []u8 = _zag_arg(2);
    let ed: []u8 = _zag_arg(3);
    let outdir: []u8 = _zag_arg(4);
    let hz: i64 = parse_i64(after_colon(pd));
    let env: i64 = parse_env(after_colon(ed));
    if (hz < 20 || hz > 20000 || env < 0 || case_id.len == 0 || outdir.len == 0) {
        _zag_print("usage: loop <case_id> pitch:<hz> env:<flat|rise|decay> <outdir>\n");
        return 2;
    }
    let target_mhz: i64 = hz * 1000;
    let ps: *u8 = _zag_malloc(88200 * 8);
    let pw: *u8 = _zag_malloc(2048 * 8);
    let pr: *u8 = _zag_malloc(16 * 8);
    let pth: *u8 = _zag_malloc(512);
    let pt1: *u8 = _zag_malloc(8);
    let pt2: *u8 = _zag_malloc(8);
    if (ps == null as *u8 || pw == null as *u8 || pr == null as *u8) { return 1; }
    if (pth == null as *u8 || pt1 == null as *u8 || pt2 == null as *u8) { return 1; }
    let smp: []i64 = (ps[0..(88200 * 8)]) as []i64;
    let wq: []i64 = (pw[0..(2048 * 8)]) as []i64;
    let res: []i64 = (pr[0..(16 * 8)]) as []i64;
    let pthb: []u8 = pth[0..512];
    let twc: []i64 = (pt1[0..8]) as []i64;
    let tws: []i64 = (pt2[0..8]) as []i64;
    build_hann(wq);

    _zag_print("case=");
    _zag_print(case_id);
    _zag_print(" target_mhz=");
    _zag_print(i64s(target_mhz));
    _zag_print(" env=");
    _zag_print(i64s(env));
    _zag_print("\n");

    // iteration 0: coarse open-loop plan (semitone grid)
    let f0: i64 = plan_mhz(target_mhz);
    let boost: i64 = 0;
    let path0: []u8 = iter_path(pthb, outdir, case_id, 0);
    render_tone(smp, 88200, f0, env, boost, 0, 0);
    let wrc: i64 = write_wav(path0, smp, 88200);
    if (wrc < 0) {
        _zag_print("ERR write iter0\n");
        return 3;
    }
    _zag_print("iter=0 plan_mhz=");
    _zag_print(i64s(f0));
    _zag_print("\n");

    let k: i64 = 1;
    while (k <= 3) {
        let prev: []u8 = iter_path(pthb, outdir, case_id, k - 1);
        let mrc: i64 = organ_measure(prev, smp, 88200, wq, 0, twc, tws, res);
        if (mrc != 0) {
            _zag_print("ERR measure iter");
            _zag_print(i64s(k - 1));
            _zag_print(" rc=");
            _zag_print(i64s(mrc));
            _zag_print("\n");
            return 4;
        }
        let meas_mhz: i64 = res[0];
        let meas_env: i64 = res[3];
        let dev: i64 = target_mhz - meas_mhz;
        let corr: i64 = dev;
        f0 = f0 + corr;
        if (meas_env != env) { boost = boost + 1; }
        let cur: []u8 = iter_path(pthb, outdir, case_id, k);
        render_tone(smp, 88200, f0, env, boost, 0, 0);
        wrc = write_wav(cur, smp, 88200);
        if (wrc < 0) {
            _zag_print("ERR write iter");
            _zag_print(i64s(k));
            _zag_print("\n");
            return 3;
        }
        _zag_print("iter=");
        _zag_print(i64s(k));
        _zag_print(" meas_mhz=");
        _zag_print(i64s(meas_mhz));
        _zag_print(" env_meas=");
        _zag_print(i64s(meas_env));
        _zag_print(" dev_mhz=");
        _zag_print(i64s(dev));
        _zag_print(" corr_mhz=");
        _zag_print(i64s(corr));
        _zag_print(" render_mhz=");
        _zag_print(i64s(f0));
        _zag_print(" boost=");
        _zag_print(i64s(boost));
        _zag_print("\n");
        k = k + 1;
    }
    _zag_print("done\n");
    return 0;
}

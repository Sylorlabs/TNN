// organ CLI: organ measure <wav>  -> feature line on stdout
fn main() i32 {
    let mode: []u8 = _zag_arg(1);
    let path: []u8 = _zag_arg(2);
    if (streq(mode, "measure") == 0) {
        _zag_print("usage: organ measure <wav>\n");
        return 2;
    }
    let ps: *u8 = _zag_malloc(300000 * 8);
    let pw: *u8 = _zag_malloc(2048 * 8);
    let pr: *u8 = _zag_malloc(16 * 8);
    let pc: *u8 = _zag_malloc(512 * 512 * 8);
    let pd: *u8 = _zag_malloc(512 * 512 * 8);
    if (ps == null as *u8) { return 1; }
    if (pw == null as *u8) { return 1; }
    if (pr == null as *u8) { return 1; }
    if (pc == null as *u8) { return 1; }
    if (pd == null as *u8) { return 1; }
    let smp: []i64 = (ps[0..(300000 * 8)]) as []i64;
    let wq: []i64 = (pw[0..(2048 * 8)]) as []i64;
    let res: []i64 = (pr[0..(16 * 8)]) as []i64;
    let twc: []i64 = (pc[0..(512 * 512 * 8)]) as []i64;
    let tws: []i64 = (pd[0..(512 * 512 * 8)]) as []i64;
    build_hann(wq);
    build_twiddles(twc, tws);
    let rc: i64 = organ_measure(path, smp, 300000, wq, 1, twc, tws, res);
    if (rc != 0) {
        _zag_print("ERR rc=");
        _zag_print(i64s(rc));
        _zag_print("\n");
        return 3;
    }
    _zag_print("f0_mhz=");
    _zag_print(i64s(res[0]));
    _zag_print(" voiced=");
    _zag_print(i64s(res[1]));
    _zag_print("/");
    _zag_print(i64s(res[2]));
    _zag_print(" env=");
    _zag_print(i64s(res[3]));
    _zag_print(" rms=");
    _zag_print(i64s(res[4]));
    _zag_print(" zcr=");
    _zag_print(i64s(res[5]));
    _zag_print(" b0r=");
    _zag_print(i64s(res[6]));
    _zag_print(" b1r=");
    _zag_print(i64s(res[7]));
    _zag_print(" b2r=");
    _zag_print(i64s(res[8]));
    _zag_print(" b3r=");
    _zag_print(i64s(res[9]));
    _zag_print(" onsets=");
    _zag_print(i64s(res[10]));
    _zag_print("\n");
    return 0;
}

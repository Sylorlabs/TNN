// hfloop CLI: hfloop <case_id> <fhf_hz> <g0_milli> <outdir>
// HF-reduction variant (diagnostic for G4c bearing): render 440 Hz + fhf sine
// at gain g, natively measure own 8-16 kHz band ratio, attenuate, re-render.
fn hiter_path(pth: []u8, outdir: []u8, case_id: []u8, k: i64) []u8 {
    let pos: i64 = scat(pth, 0, outdir);
    pos = scat(pth, pos, "/");
    pos = scat(pth, pos, case_id);
    pos = scat(pth, pos, "_hiter");
    pos = scat(pth, pos, i64s(k));
    pos = scat(pth, pos, ".wav");
    return pth[0..pos];
}

fn main() i32 {
    let case_id: []u8 = _zag_arg(1);
    let fhf: i64 = parse_i64(_zag_arg(2));
    let g0m: i64 = parse_i64(_zag_arg(3));
    let outdir: []u8 = _zag_arg(4);
    if (fhf < 8000 || fhf > 16000 || g0m <= 0 || case_id.len == 0 || outdir.len == 0) {
        _zag_print("usage: hfloop <case_id> <fhf_hz 8000..16000> <g0_milli> <outdir>\n");
        return 2;
    }
    let ps: *u8 = _zag_malloc(88200 * 8);
    let pw: *u8 = _zag_malloc(2048 * 8);
    let pr: *u8 = _zag_malloc(16 * 8);
    let pth: *u8 = _zag_malloc(512);
    let pc: *u8 = _zag_malloc(512 * 512 * 8);
    let pd: *u8 = _zag_malloc(512 * 512 * 8);
    if (ps == null as *u8 || pw == null as *u8 || pr == null as *u8) { return 1; }
    if (pth == null as *u8 || pc == null as *u8 || pd == null as *u8) { return 1; }
    let smp: []i64 = (ps[0..(88200 * 8)]) as []i64;
    let wq: []i64 = (pw[0..(2048 * 8)]) as []i64;
    let res: []i64 = (pr[0..(16 * 8)]) as []i64;
    let pthb: []u8 = pth[0..512];
    let twc: []i64 = (pc[0..(512 * 512 * 8)]) as []i64;
    let tws: []i64 = (pd[0..(512 * 512 * 8)]) as []i64;
    build_hann(wq);
    build_twiddles(twc, tws);

    _zag_print("hcase=");
    _zag_print(case_id);
    _zag_print(" fhf_hz=");
    _zag_print(i64s(fhf));
    _zag_print("\n");

    let g: i64 = g0m;
    let k: i64 = 0;
    while (k <= 3) {
        let cur: []u8 = hiter_path(pthb, outdir, case_id, k);
        render_tone(smp, 88200, 440000, 0, 0, fhf * 1000, g);
        let wrc: i64 = write_wav(cur, smp, 88200);
        if (wrc < 0) {
            _zag_print("ERR write hiter");
            _zag_print(i64s(k));
            _zag_print("\n");
            return 3;
        }
        let mrc: i64 = organ_measure(cur, smp, 88200, wq, 1, twc, tws, res);
        if (mrc != 0) {
            _zag_print("ERR measure hiter");
            _zag_print(i64s(k));
            _zag_print("\n");
            return 4;
        }
        let b3r: i64 = res[9];
        _zag_print("hiter=");
        _zag_print(i64s(k));
        _zag_print(" g_milli=");
        _zag_print(i64s(g));
        _zag_print(" b3r=");
        _zag_print(i64s(b3r));
        _zag_print("\n");
        if (k < 3) {
            let ratio: f64 = (b3r as f64) / 1000000.0;
            if (ratio > 0.0001 && ratio > 0.0) {
                let ng: f64 = (g as f64) * fsqrt(0.0001 / ratio);
                g = (ng + 0.5) as i64;
                if (g < 1) { g = 1; }
                if (g > 2000) { g = 2000; }
            }
        }
        k = k + 1;
    }
    _zag_print("hdone\n");
    return 0;
}

// CREW C — CONTROL PATH. Pure Zag, zero RNG, deterministic.
// Descriptor -> synthesis parameters -> samples. Parametric, no tables.
// Usage: ./control <out.wav> <descriptor>
//   descriptor: parts joined by '+': pitch:<Hz> | env:<flat|rise|decay>
//               | rhy:<even|swing<N>> | prosody:<CV%>
//   Special descriptor "C0": intent path severed; frozen constant renders default.

const SR: i64 = 44100;
const NSAMP: i64 = 88200;
const PI: f64 = 3.141592653589793;
const TAU: f64 = 6.283185307179586;
const SQRT2: f64 = 1.4142135623730951;
const PEAK: f64 = 28000.0;
const FADE: i64 = 220;
const PIP_LEN: i64 = 2646;

fn cstr(s: []u8) []u8 {
    if (s.len < 1 || s.len > 4095) { return ""; }
    let p: *u8 = _zag_malloc((s.len + 1) as i64) as *u8;
    if (p == null as *u8) { return ""; }
    let b: []u8 = p[0..(s.len + 1)];
    let i: i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn w_all(fd: i64, b: []u8) i64 {
    let at: i64 = 0;
    let blen: i64 = b.len as i64;
    while (at < blen) {
        let n: i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(b) as i64) + at, blen - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { return -7407; }
        at = at + n;
    }
    return at;
}

fn file_write(path: []u8, b: []u8) i64 {
    let cs: []u8 = cstr(path);
    if (cs.len == 0) { return -3; }
    let fd: i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 577, 438, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return -4; }
    let rc: i64 = w_all(fd, b);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return rc;
}

fn fcosr(x: f64) f64 {
    let x2: f64 = x * x;
    let x4: f64 = x2 * x2;
    let x6: f64 = x4 * x2;
    let x8: f64 = x4 * x4;
    let x10: f64 = x8 * x2;
    return 1.0 - x2 / 2.0 + x4 / 24.0 - x6 / 720.0 + x8 / 40320.0 - x10 / 3628800.0;
}

fn cosr(x: f64) f64 {
    let r: f64 = x;
    while (r < 0.0) { r = r + TAU; }
    while (r >= TAU) { r = r - TAU; }
    if (r > PI) { r = TAU - r; }
    if (r > PI / 2.0) { return -fcosr(PI - r); }
    return fcosr(r);
}

fn sinr(x: f64) f64 {
    return cosr(x - PI / 2.0);
}

fn put64(a: []u8, o: i64, v: i64) void {
    let i: i64 = 0;
    while (i < 8) {
        a[o + i] = ((v >> (i * 8)) & 255) as u8;
        i = i + 1;
    }
    return;
}

fn get64(a: []u8, o: i64) i64 {
    let v: i64 = 0;
    let i: i64 = 0;
    while (i < 8) {
        v = v | (((a[o + i] as i64) & 255) << (i * 8));
        i = i + 1;
    }
    return v;
}

fn seq_eq(a: []u8, b: []u8) i64 {
    if ((a.len as i64) != (b.len as i64)) { return 0; }
    let i: i64 = 0;
    while (i < (a.len as i64)) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn starts_with(s: []u8, pre: []u8) i64 {
    if ((s.len as i64) < (pre.len as i64)) { return 0; }
    let i: i64 = 0;
    while (i < (pre.len as i64)) {
        if (s[i] != pre[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn parse_int(s: []u8) i64 {
    let v: i64 = 0;
    let i: i64 = 0;
    while (i < (s.len as i64)) {
        let c: i64 = s[i] as i64;
        if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); }
        i = i + 1;
    }
    return v;
}

fn parse_num(s: []u8) f64 {
    let ip: i64 = 0;
    let fp: f64 = 0.0;
    let div: f64 = 1.0;
    let seen: i64 = 0;
    let i: i64 = 0;
    while (i < (s.len as i64)) {
        let c: i64 = s[i] as i64;
        if (c == 46) { seen = 1; }
        else {
            if (c >= 48 && c <= 57) {
                if (seen == 0) { ip = ip * 10 + (c - 48); }
                else { div = div * 10.0; fp = fp + ((c - 48) as f64) / div; }
            }
        }
        i = i + 1;
    }
    return (ip as f64) + fp;
}

fn main() i32 {
    let out_path: []u8 = _zag_arg(1);
    if (out_path.len == 0) { out_path = "out.wav"; }
    let desc: []u8 = _zag_arg(2);
    if (desc.len == 0) { return 7; }
    // C0 arm: intent path severed; frozen constant substituted before parsing.
    if (seq_eq(desc, "C0") == 1) {
        desc = "pitch:220+env:flat+rhy:even";
    }

    // ---- parse descriptor into synthesis parameters ----
    let f0: f64 = 0.0;
    let has_pitch: i64 = 0;
    let envc: i64 = 0; // 0 flat, 1 rise, 2 decay
    let has_rhy: i64 = 0;
    let swing: i64 = 0; // swing amount percent, 0 = even
    let has_swing: i64 = 0;
    let cv: f64 = 0.0;
    let has_prosody: i64 = 0;

    // split on '+', up to 4 parts
    let pstart: i64 = 0;
    let pi: i64 = 0;
    let i: i64 = 0;
    while (i <= (desc.len as i64)) {
        let is_end: i64 = 0;
        if (i == (desc.len as i64)) { is_end = 1; }
        else { if (desc[i] == 43) { is_end = 1; } }
        if (is_end == 1) {
            let plen: i64 = i - pstart;
            if (plen > 0 && pi < 4) {
                let part: []u8 = desc[pstart..i];
                // find ':'
                let ci: i64 = 0;
                let clen: i64 = part.len as i64;
                while (ci < clen && part[ci] != 58) { ci = ci + 1; }
                if (ci < clen) {
                    let key: []u8 = part[0..ci];
                    let val: []u8 = part[(ci + 1)..clen];
                    if (seq_eq(key, "pitch") == 1) {
                        f0 = parse_num(val);
                        has_pitch = 1;
                    }
                    if (seq_eq(key, "env") == 1) {
                        if (seq_eq(val, "rise") == 1) { envc = 1; }
                        else { if (seq_eq(val, "decay") == 1) { envc = 2; } }
                    }
                    if (seq_eq(key, "rhy") == 1) {
                        has_rhy = 1;
                        if (starts_with(val, "swing") == 1) {
                            has_swing = 1;
                            let rest: []u8 = val[5..(val.len as i64)];
                            swing = parse_int(rest);
                            if (swing <= 0) { swing = 20; }
                        }
                    }
                    if (seq_eq(key, "prosody") == 1) {
                        cv = parse_num(val);
                        has_prosody = 1;
                    }
                }
                pi = pi + 1;
            }
            pstart = i + 1;
        }
        i = i + 1;
    }

    // ---- resolve parameters ----
    let carrier: f64 = 220.0;
    if (has_pitch == 1) { carrier = f0; }
    let pipf: f64 = 880.0;
    if (has_pitch == 1) { pipf = f0; }
    if (has_prosody == 1 && has_pitch == 0) { carrier = 440.0; }
    // rhythm pips sound at the pip frequency (pitch value if given, else 880)
    if (has_rhy == 1) { carrier = pipf; }
    let vib_depth: f64 = 0.0;
    if (has_prosody == 1) { vib_depth = (cv / 100.0) * SQRT2; }

    // onset sample positions (up to 16)
    let onsets_p: *u8 = _zag_malloc(16 * 8) as *u8;
    if (onsets_p == null as *u8) { return 8; }
    let onsets: []u8 = onsets_p[0..128];
    let non: i64 = 0;
    if (has_rhy == 1) {
        let base_ioi: f64 = 0.25 * (SR as f64);
        let t: f64 = 0.0;
        let k: i64 = 0;
        while (k < 16) {
            let pos: i64 = (t + 0.5) as i64;
            if (pos + PIP_LEN >= NSAMP) { break; }
            put64(onsets, k * 8, pos);
            non = non + 1;
            let step: f64 = base_ioi;
            if (has_swing == 1) {
                let frac: f64 = (swing as f64) / 100.0;
                if (k % 2 == 0) { step = base_ioi * (1.0 + frac); }
                else { step = base_ioi * (1.0 - frac); }
            }
            t = t + step;
            k = k + 1;
        }
    }

    // ---- synthesize ----
    let acc_p: *u8 = _zag_malloc(NSAMP * 8) as *u8;
    if (acc_p == null as *u8) { return 9; }
    let acc: []u8 = acc_p[0..(NSAMP * 8)];
    let phase: f64 = 0.0;
    i = 0;
    while (i < NSAMP) {
        let tt: f64 = (i as f64) / (SR as f64);
        // carrier with vibrato
        let f: f64 = carrier;
        if (has_prosody == 1) {
            f = carrier * (1.0 + vib_depth * sinr(TAU * 5.0 * tt));
        }
        phase = phase + TAU * f / (SR as f64);
        if (phase >= TAU) { phase = phase - TAU; }
        let s: f64 = sinr(phase);
        // envelope
        let g: f64 = 0.9;
        if (envc == 1) { g = 0.9 * (i as f64) / (NSAMP as f64); }
        if (envc == 2) { g = 0.9 * (1.0 - (i as f64) / (NSAMP as f64)); }
        if (envc == 0) {
            if (i < FADE) {
                let x: f64 = (i as f64) / (FADE as f64);
                g = 0.9 * (0.5 - 0.5 * cosr(PI * x));
            }
            if (i >= NSAMP - FADE) {
                let x2: f64 = ((NSAMP - 1 - i) as f64) / (FADE as f64);
                g = 0.9 * (0.5 - 0.5 * cosr(PI * x2));
            }
        }
        // rhythm pip gating
        if (has_rhy == 1) {
            let pg: f64 = 0.0;
            let q: i64 = 0;
            while (q < non) {
                let o: i64 = get64(onsets, q * 8);
                if (i >= o && i < o + PIP_LEN) {
                    let x3: f64 = ((i - o) as f64) / (PIP_LEN as f64);
                    let w: f64 = sinr(PI * x3);
                    pg = w * w;
                }
                q = q + 1;
            }
            // pip carrier uses the resolved carrier (pip frequency)
            g = g * pg;
        }
        let v: i64 = (s * g * PEAK) as i64;
        put64(acc, i * 8, v);
        i = i + 1;
    }

    // ---- WAV output ----
    let wav_total: i64 = 44 + NSAMP * 2;
    let wav_p: *u8 = _zag_malloc(wav_total) as *u8;
    if (wav_p == null as *u8) { return 10; }
    let wav: []u8 = wav_p[0..wav_total];
    wav[0] = 82; wav[1] = 73; wav[2] = 70; wav[3] = 70;
    let sz: i64 = 36 + NSAMP * 2;
    wav[4] = (sz & 255) as u8; wav[5] = ((sz >> 8) & 255) as u8;
    wav[6] = ((sz >> 16) & 255) as u8; wav[7] = ((sz >> 24) & 255) as u8;
    wav[8] = 87; wav[9] = 65; wav[10] = 86; wav[11] = 69;
    wav[12] = 102; wav[13] = 109; wav[14] = 116; wav[15] = 32;
    wav[16] = 16; wav[17] = 0; wav[18] = 0; wav[19] = 0;
    wav[20] = 1; wav[21] = 0;
    wav[22] = 1; wav[23] = 0;
    wav[24] = 68; wav[25] = 172; wav[26] = 0; wav[27] = 0;
    wav[28] = 136; wav[29] = 88; wav[30] = 1; wav[31] = 0;
    wav[32] = 2; wav[33] = 0;
    wav[34] = 16; wav[35] = 0;
    wav[36] = 100; wav[37] = 97; wav[38] = 116; wav[39] = 97;
    let ds: i64 = NSAMP * 2;
    wav[40] = (ds & 255) as u8; wav[41] = ((ds >> 8) & 255) as u8;
    wav[42] = ((ds >> 16) & 255) as u8; wav[43] = ((ds >> 24) & 255) as u8;
    i = 0;
    while (i < NSAMP) {
        let v2: i64 = get64(acc, i * 8);
        if (v2 > 32767) { v2 = 32767; }
        if (v2 < -32768) { v2 = -32768; }
        if (v2 < 0) { v2 = v2 + 65536; }
        let o2: i64 = 44 + i * 2;
        wav[o2] = (v2 & 255) as u8;
        wav[o2 + 1] = ((v2 >> 8) & 255) as u8;
        i = i + 1;
    }
    let rc: i64 = file_write(out_path, wav);
    if (rc < 0) { return 11; }
    return 0;
}

    return 0;
}
// ---------- budget-4x counter-marker ----------
// CM2: assertion-form — an assertion frame plus a digit: the structural form
// of a checkable world claim.
fn has_digit(w:[]u8)i32 {
    if(has_sub(w,"0")==1){ return 1; }
    if(has_sub(w,"1")==1){ return 1; }
    if(has_sub(w,"2")==1){ return 1; }
    if(has_sub(w,"3")==1){ return 1; }
    if(has_sub(w,"4")==1){ return 1; }
    if(has_sub(w,"5")==1){ return 1; }
    if(has_sub(w,"6")==1){ return 1; }
    if(has_sub(w,"7")==1){ return 1; }
    if(has_sub(w,"8")==1){ return 1; }
    if(has_sub(w,"9")==1){ return 1; }
    return 0;
}

fn is_assertion_form(w:[]u8)i32 {
    let frame:i32=0;
    if(has_sub(w," is ")==1){ frame=1; }
    if(has_sub(w," are ")==1){ frame=1; }
    if(has_sub(w," has ")==1){ frame=1; }
    if(has_sub(w," have ")==1){ frame=1; }
    if(has_sub(w," was ")==1){ frame=1; }
    if(has_sub(w," were ")==1){ frame=1; }
    if(frame==0){ return 0; }
    if(has_digit(w)==1){ return 1; }
    return 0;
}

// ---------- 8x independent verification ----------
// Re-derives the final verdict from the evidence ledger through an
// independent (arithmetic, separately written) code path. Returns the
// re-derived verdict: 1 = ENDORSE, 0 = WITHHOLD.
fn verify_ledger(kf:i32, ab:i32, nmatch:i32, kt:i32, cm2:i32, v_pre:i32, recon:i32)i32 {
    // v_pre: the staged pipeline verdict before reconsideration
    // recon: 1 if the reconsideration round ran, else 0
    let nonfac:i32=kf+ab+nmatch;
    let pv:i32=1;
    if(nonfac>0){ pv=0; }
    // pv must equal v_pre; if the ledger disagrees with the staged path,
    // that itself is a derivation fault -> withhold
    if(pv!=v_pre){ return 0; }
    let v:i32=v_pre;
    if(recon==1){
        let pro:i32=kf+ab+nmatch;
        let con:i32=kt+cm2;
        if(pro>con){ v=0; }
        else {
            if(con>pro){ v=1; }
        }
    }
    return v;
}

// ---------- deliberation ----------
// Fills the evidence ledger (all predicates evaluated, no short-circuit),
// stages the pipeline decision on the ledger bits, optionally reconsiders
// (4x) and verifies (8x).
// Returns packed i64: (pc<<32)+(recon<<16)+(vflip<<8)+verdict,
// where pc = predicate evaluations, verdict 1=ENDORSE 0=WITHHOLD.

fn deliberate_si(low:[]u8, budget:i32)i64 {
    // evidence ledger
    let pc:i64=0;
    let kf:i32=is_known_false(low); pc=pc+1;
    let ab:i32=is_absurd(low); pc=pc+1;
    let ms:i32=0;
    let mhy:i32=0;
    let mcf:i32=0;
    let mana:i32=0;
    let mpoe:i32=0;
    let mimp:i32=0;
    if(budget>=2){
        ms=matches_sarcasm(low); pc=pc+1;
        mhy=matches_hypothetical(low); pc=pc+1;
        mcf=matches_counterfactual(low); pc=pc+1;
        mana=matches_analogy(low); pc=pc+1;
        mpoe=matches_poetry(low); pc=pc+1;
        mimp=matches_implicature(low); pc=pc+1;
    }
    let kt:i32=is_known_true(low); pc=pc+1;
    let inj:i32=0;
    if(budget>=2){
        inj=inject_any(low); pc=pc+7;
    }
    let nmatch:i32=ms+mhy+mcf+mana+mpoe+mimp+inj;

    // staged pipeline decision on the ledger (verdict-identical to the
    // short-circuit original: withhold iff any non-factual evidence)
    let v:i32=1;
    if(kf==1){ v=0; }
    else {
        if(ab==1){ v=0; }
        else {
            if(nmatch>=1){ v=0; }
        }
    }
    // (known_true and default both endorse; no branch needed)

    // 4x: one reconsideration round on non-unanimous items
    let recon:i32=0;
    let cm2:i32=0;
    if(budget>=4 && nmatch>=1){
        cm2=is_assertion_form(low); pc=pc+1;
        let cm1:i32=kt;
        if(cm1+cm2>=1){
            recon=1;
            pc=pc+1; // majority decision counts as a deliberation step
            let pro:i32=kf+ab+nmatch;
            let con:i32=cm1+cm2;
            if(pro>con){ v=0; }
            else {
                if(con>pro){ v=1; }
            }
            // tie: keep the 2x (staged) verdict
        }
    }

    // 8x: independent verification pass
    let vf:i32=0;
    if(budget>=8){
        pc=pc+1; // the verification derivation counts as one evaluation
        let vv:i32=verify_ledger(kf, ab, nmatch, kt, cm2, v, recon);
        if(vv!=v){ vf=1; v=0; }
    }
    let sh32:i64=pc<<32;
    let sh16:i64=(recon as i64)<<16;
    let sh8:i64=(vf as i64)<<8;
    return sh32+sh16+sh8+(v as i64);
}

// ---------- driver ----------

fn main()void {
    let workdir:[]u8=arg_copy(1);
    let bs:[]u8=arg_copy(2);
    let items_s:[]u8=arg_copy(3);
    let budget:i32=2;
    if(bs.len>0){
        // delib_si2 SINGLE CHANGE (per PREREG_SI_A1X §2): parse the budget
        // argument as a full non-negative integer so 16/32 work. The
        // frozen build only matched the first character ('1'->1, so "16"
        // would have meant 1). All deliberation logic below is untouched.
        let bv:i32=0;
        let bi:i32=0;
        let bok:i32=1;
        while(bi<bs.len){
            let c:u8=bs[bi];
            if(c>=48 && c<=57){ bv=bv*10+((c as i32)-48); }
            else { bok=0; }
            bi=bi+1;
        }
        if(bok==1){ budget=bv; }
    }

    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_print("ERR workdir\n"); return; }
    let data:[]u8=read_file(root, items_s);
    if(data.len==0){ _zag_print("ERR items\n"); return; }

    let n:i32=0;
    let endorse:i32=0;
    let withhold:i32=0;
    let preds_total:i64=0;
    let recon_total:i32=0;
    let vflip_total:i32=0;
    let pos:i32=0;
    let tmp:[]u8=nio_alloc(4096);
    while(pos<data.len){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=data[pos..eol];
        if(line.len>4){
            let sep:i32=0;
            while(sep<line.len && line[sep]!=124){ sep=sep+1; }
            if(sep<line.len){
                let id:[]u8=line[0..sep];
                let utt:[]u8=line[sep+1..line.len];
                let low:[]u8=to_lower(tmp, utt);
                let pk:i64=deliberate_si(low, budget);
                let d:i32=(pk & 255) as i32;
                let s8:i64=pk>>8;
                let vf:i32=(s8 & 255) as i32;
                let s16:i64=pk>>16;
                let rc:i32=(s16 & 255) as i32;
                let pc:i64=pk>>32;
                preds_total=preds_total+pc;
                recon_total=recon_total+rc;
                vflip_total=vflip_total+vf;
                _zag_print(id);
                if(d==1){ _zag_print("|ENDORSE"); endorse=endorse+1; }
                else { _zag_print("|WITHHOLD"); withhold=withhold+1; }
                _zag_print("|preds=");
                _zag_print(_zag_i64_to_str(pc));
                _zag_print("|recon=");
                _zag_print(_zag_i64_to_str(rc as i64));
                _zag_print("|vflip=");
                _zag_print(_zag_i64_to_str(vf as i64));
                _zag_print("\n");
                n=n+1;
            }
        }
        pos=eol+1;
    }
    _zag_print("SUMMARY n=");
    _zag_print(_zag_i64_to_str(n as i64));
    _zag_print(" endorse=");
    _zag_print(_zag_i64_to_str(endorse as i64));
    _zag_print(" withhold=");
    _zag_print(_zag_i64_to_str(withhold as i64));
    _zag_print("\n");
    _zag_print("COST preds_total=");
    _zag_print(_zag_i64_to_str(preds_total));
    _zag_print(" recon_items=");
    _zag_print(_zag_i64_to_str(recon_total as i64));
    _zag_print(" vflips=");
    _zag_print(_zag_i64_to_str(vflip_total as i64));
    _zag_print("\n");
    return;
}

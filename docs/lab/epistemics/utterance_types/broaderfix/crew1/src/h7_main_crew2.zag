// H7 utterance-type learner — Crew 2 mechanism (generic FL2 guided learning).
// Pure Zag, zero RNG, deterministic.
//
// KB-H7-HARD0: this file contains no utterance-type keyword lists, regexes,
// type-name string constants, or type constants in control flow. All type
// names, consequences, markers, and curriculum content live in data files and
// in the learned knowledge store. Matching is generic byte-substring
// deliberation over learned entries; routing is generic partition logic.
//
// Partition discipline (constructed-mode amendment R2): BELIEF and TYPED are
// disjoint byte arenas. belief_recall indexes the belief arena only. The only
// belief writer is belief_install (Phase-1 facts). There is no TYPED->BELIEF
// write path anywhere in this file.
@import("R33_NATIVE_IO_V1.zag")

// ---------- generic byte helpers ----------

fn eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){ return 0; }
    let i:i32=0;
    while(i<a.len){
        if(a[i]!=b[i]){ return 0; }
        i=i+1;
    }
    return 1;
}

fn has_sub(hay:[]u8,ndl:[]u8)i32 {
    if(ndl.len==0 || ndl.len>hay.len){ return 0; }
    let i:i32=0;
    while(i+ndl.len<=hay.len){
        let j:i32=0;
        while(j<ndl.len && hay[i+j]==ndl[j]){ j=j+1; }
        if(j==ndl.len){ return 1; }
        i=i+1;
    }
    return 0;
}

fn to_lower(dst:[]u8,src:[]u8)[]u8 {
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c>=65 && c<=90){ dst[i]=c+32; } else { dst[i]=c; }
        i=i+1;
    }
    return dst[0..src.len];
}

fn t_put32(a:[]u8,o:i32,v:i32)void {
    a[o]=(v&255) as u8;
    let s1:i32=(v>>8)&255;
    a[o+1]=s1 as u8;
    let s2:i32=(v>>16)&255;
    a[o+2]=s2 as u8;
    let s3:i32=(v>>24)&255;
    a[o+3]=s3 as u8;
}

fn t_get32(a:[]u8,o:i32)i32 {
    let b0:i32=a[o] as i32;
    let b1:i32=(a[o+1] as i32)<<8;
    let b2:i32=(a[o+2] as i32)<<16;
    let b3:i32=(a[o+3] as i32)<<24;
    return b0+b1+b2+b3;
}

// _zag_i64_to_str emits a trailing newline when called inside a helper;
// strip it so call-site printing stays on one line.
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){ return s[0..s.len-1]; }
    }
    return s;
}

fn zfill(a:[]u8)void {
    let i:i32=0;
    while(i<a.len){ a[i]=0; i=i+1; }
}

fn arg_copy(n:i32)[]u8 {
    let s:[]u8=_zag_arg(n);
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    return b[0..s.len];
}

fn read_file(root:i64,name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root,name,0);
    if(fd<0){ return nio_alloc(0); }
    let buf:[]u8=nio_alloc(1048576);
    let n:i64=nio_read_exact(fd,buf,1048576);
    nio_close(fd);
    if(n<0){ return nio_alloc(0); }
    return buf[0..n as i32];
}

// ---------- audit ledger ----------
// 64-byte entries. Header layout follows the lab convention: op@0, slot@4,
// rc@8, then payload words. Op codes are generic harness ops (not
// utterance-type constants):
// 1 EPISODE  2 FACT_INSTALL  3 TEACH_TYPE  4 EXEMPLAR  5 PREDICT  6 CORRECT
// 7 MARKER_ADD  8 MARKER_REVOKE  9 MARKER_COMMIT  10 CALIBRATE  11 PROBE
// 12 TYPED_WRITE  13 LEAKCHECK  14 RECALL  15 SAID_WRITE  16 SUPP_PROBE
// 17 PHASE  18 NEGCTL

fn au(abuf:[]u8,acount:*i32,acap:i32,op:i32,slot:i32,rc:i32,w1:i32,w2:i32,w3:i32)i32 {
    let n:i32=acount.*;
    if(n<0 || n>=acap){ return -1; }
    let o:i32=n*64;
    t_put32(abuf,o,op);
    t_put32(abuf,o+4,slot);
    t_put32(abuf,o+8,rc);
    t_put32(abuf,o+12,w1);
    t_put32(abuf,o+16,w2);
    t_put32(abuf,o+20,w3);
    let i:i32=24;
    while(i<64){ abuf[o+i]=0; i=i+1; }
    acount.*=n+1;
    return 0;
}

// ---------- partitioned store ----------
// BELIEF arena: bent entries stride 16: off@0 len@4 status@8
// TYPED arena:  tent entries stride 32: off@0 len@4 name_off@8 name_len@12
//               spk_off@16 spk_len@20 said@24
// The two pools are disjoint slices. belief_recall indexes belief only.

fn belief_install(bent:[]u8,bn:*i32,bpool:[]u8,bu:*i32,utt:[]u8,
    abuf:[]u8,acount:*i32,acap:i32,slot:i32)i32 {
    let n:i32=bn.*;
    if(n*16+16>bent.len){ return -1; }
    if(bu.*+utt.len>bpool.len){ return -2; }
    let o:i32=bu.*;
    let i:i32=0;
    while(i<utt.len){ bpool[o+i]=utt[i]; i=i+1; }
    let e:i32=n*16;
    t_put32(bent,e,o);
    t_put32(bent,e+4,utt.len);
    t_put32(bent,e+8,1);
    bn.*=n+1;
    bu.*=o+utt.len;
    au(abuf,acount,acap,2,slot,0,n,utt.len,0);
    return n;
}

fn belief_recall(bent:[]u8,bn:i32,bpool:[]u8,idx:i32)[]u8 {
    if(idx<0 || idx>=bn){ return bpool[0..0]; }
    let e:i32=idx*16;
    let o:i32=t_get32(bent,e);
    let l:i32=t_get32(bent,e+4);
    return bpool[o..o+l];
}

fn typed_write(tent:[]u8,tn:*i32,tpool:[]u8,tu:*i32,
    utt:[]u8,name:[]u8,spk:[]u8,said:i32,
    abuf:[]u8,acount:*i32,acap:i32,slot:i32)i32 {
    let n:i32=tn.*;
    if(n*32+32>tent.len){ return -1; }
    let need:i32=utt.len+name.len+spk.len;
    if(tu.*+need>tpool.len){ return -2; }
    let ou:i32=tu.*;
    let i:i32=0;
    while(i<utt.len){ tpool[ou+i]=utt[i]; i=i+1; }
    let onm:i32=ou+utt.len;
    i=0;
    while(i<name.len){ tpool[onm+i]=name[i]; i=i+1; }
    let osp:i32=onm+name.len;
    i=0;
    while(i<spk.len){ tpool[osp+i]=spk[i]; i=i+1; }
    let e:i32=n*32;
    t_put32(tent,e,ou);
    t_put32(tent,e+4,utt.len);
    t_put32(tent,e+8,onm);
    t_put32(tent,e+12,name.len);
    t_put32(tent,e+16,osp);
    t_put32(tent,e+20,spk.len);
    t_put32(tent,e+24,said);
    tn.*=n+1;
    tu.*=osp+spk.len;
    au(abuf,acount,acap,12,slot,0,n,utt.len,said);
    if(said==1){ au(abuf,acount,acap,15,slot,0,n,spk.len,0); }
    return n;
}

// typed_recall_said: first said-record whose speaker bytes equal spk.
// Reads the TYPED arena only; never touches BELIEF.
fn typed_recall_said(tent:[]u8,tn:i32,tpool:[]u8,spk:[]u8)[]u8 {
    let i:i32=0;
    while(i<tn){
        let e:i32=i*32;
        if(t_get32(tent,e+24)==1){
            let so:i32=t_get32(tent,e+16);
            let sl:i32=t_get32(tent,e+20);
            let sb:[]u8=tpool[so..so+sl];
            if(eq(sb,spk)==1){
                let o:i32=t_get32(tent,e);
                let l:i32=t_get32(tent,e+4);
                return tpool[o..o+l];
            }
        }
        i=i+1;
    }
    return tpool[0..0];
}

// ---------- knowledge store: taught type concepts ----------
// kent stride 32: name_off@0 name_len@4 flags@8 status@12 cons_off@16 cons_len@20
// flags bits: 1 = route typed (withhold from belief), 2 = record said.
// The name and consequence are opaque bytes from teaching; the mechanism
// never interprets them beyond byte equality and the generic flag bits.

fn know_teach(kent:[]u8,kn:*i32,kpool:[]u8,ku:*i32,name:[]u8,flags:i32,cons:[]u8,
    abuf:[]u8,acount:*i32,acap:i32,slot:i32)i32 {
    let n:i32=kn.*;
    if(n*32+32>kent.len){ return -1; }
    if(ku.*+name.len+cons.len>kpool.len){ return -2; }
    let on:i32=ku.*;
    let i:i32=0;
    while(i<name.len){ kpool[on+i]=name[i]; i=i+1; }
    let oc:i32=on+name.len;
    i=0;
    while(i<cons.len){ kpool[oc+i]=cons[i]; i=i+1; }
    let e:i32=n*32;
    t_put32(kent,e,on);
    t_put32(kent,e+4,name.len);
    t_put32(kent,e+8,flags);
    t_put32(kent,e+12,2);
    t_put32(kent,e+16,oc);
    t_put32(kent,e+20,cons.len);
    kn.*=n+1;
    ku.*=oc+cons.len;
    au(abuf,acount,acap,3,slot,0,n,flags,0);
    return n;
}

fn know_find(kent:[]u8,kn:i32,kpool:[]u8,name:[]u8)i32 {
    let k:i32=0;
    while(k<kn){
        let e:i32=k*32;
        let o:i32=t_get32(kent,e);
        let l:i32=t_get32(kent,e+4);
        if(eq(kpool[o..o+l],name)==1){ return k; }
        k=k+1;
    }
    return -1;
}

fn know_name(kent:[]u8,kpool:[]u8,k:i32)[]u8 {
    let e:i32=k*32;
    let o:i32=t_get32(kent,e);
    let l:i32=t_get32(kent,e+4);
    return kpool[o..o+l];
}

fn know_flags(kent:[]u8,k:i32)i32 {
    return t_get32(kent,k*32+8);
}

// ---------- learned markers ----------
// ment stride 24: know_idx@0 field@4 status@8 support@12 off@16 len@20
// field: 0=UTT 1=CTX 2=SPK (generic utterance fields)
// status: 1=PROVISIONAL 2=COMMITTED 3=REVOKED

fn marker_add(ment:[]u8,mn:*i32,mcap:i32,mpool:[]u8,mu:*i32,
    know_idx:i32,field:i32,ng:[]u8,
    abuf:[]u8,acount:*i32,acap:i32,slot:i32)i32 {
    let n:i32=mn.*;
    let m:i32=0;
    while(m<n){
        let e:i32=m*24;
        if(t_get32(ment,e)==know_idx && t_get32(ment,e+4)==field){
            let mo:i32=t_get32(ment,e+16);
            let ml:i32=t_get32(ment,e+20);
            if(ml==ng.len && eq(mpool[mo..mo+ml],ng)==1){
                if(t_get32(ment,e+8)!=3){
                    t_put32(ment,e+12,t_get32(ment,e+12)+1);
                }
                return m;
            }
        }
        m=m+1;
    }
    if(n>=mcap){ return -2; }
    if(mu.*+ng.len>mpool.len){ return -3; }
    let o:i32=mu.*;
    let i:i32=0;
    while(i<ng.len){ mpool[o+i]=ng[i]; i=i+1; }
    let e2:i32=n*24;
    t_put32(ment,e2,know_idx);
    t_put32(ment,e2+4,field);
    t_put32(ment,e2+8,1);
    t_put32(ment,e2+12,1);
    t_put32(ment,e2+16,o);
    t_put32(ment,e2+20,ng.len);
    mn.*=n+1;
    mu.*=o+ng.len;
    au(abuf,acount,acap,7,slot,0,n,field,ng.len);
    return n;
}

fn marker_revoke(ment:[]u8,m:i32,abuf:[]u8,acount:*i32,acap:i32,slot:i32,why:i32)void {
    t_put32(ment,m*24+8,3);
    au(abuf,acount,acap,8,slot,0,m,why,0);
    return;
}

// ---------- generic tokenizer + n-gram candidate extraction ----------
// Words are [a-z0-9]+ runs over the lowered field bytes.
// UTT yields 2-grams and 3-grams only: single utterance words are never
// markers (structural guard against single-word trope triggers).
// CTX and SPK yield 1-, 2-, 3-grams.

fn extract_ngrams(ment:[]u8,mn:*i32,mcap:i32,mpool:[]u8,mu:*i32,
    know_idx:i32,field:[]u8,fid:i32,min_n:i32,max_n:i32,
    wstarts:[]u8,wends:[]u8,
    abuf:[]u8,acount:*i32,acap:i32,slot:i32)i32 {
    let nw:i32=0;
    let i:i32=0;
    while(i<field.len){
        let c:u8=field[i];
        let isw:i32=0;
        if(c>=97 && c<=122){ isw=1; }
        if(c>=48 && c<=57){ isw=1; }
        if(isw==1){
            let s:i32=i;
            let cont:i32=1;
            while(i<field.len && cont==1){
                let d:u8=field[i];
                let isw2:i32=0;
                if(d>=97 && d<=122){ isw2=1; }
                if(d>=48 && d<=57){ isw2=1; }
                if(isw2==0){ cont=0; }
                if(cont==1){ i=i+1; }
            }
            if(nw<64){
                t_put32(wstarts,nw*4,s);
                t_put32(wends,nw*4,i);
                nw=nw+1;
            }
        }
        if(isw==0){ i=i+1; }
    }
    let added:i32=0;
    let nn:i32=min_n;
    while(nn<=max_n){
        let w:i32=0;
        while(w+nn<=nw){
            let a:i32=t_get32(wstarts,w*4);
            let b:i32=t_get32(wends,(w+nn-1)*4);
            let r:i32=marker_add(ment,mn,mcap,mpool,mu,know_idx,fid,field[a..b],
                abuf,acount,acap,slot);
            if(r>=0){ added=added+1; }
            w=w+1;
        }
        nn=nn+1;
    }
    return added;
}

// field bytes of an item-list entry (ilist stride 40)
fn ifield(ipool:[]u8,ient:[]u8,x:i32,f:i32)[]u8 {
    let xe:i32=x*40;
    if(f==1){
        let o:i32=t_get32(ient,xe+8);
        let l:i32=t_get32(ient,xe+12);
        return ipool[o..o+l];
    }
    if(f==2){
        let o2:i32=t_get32(ient,xe+16);
        let l2:i32=t_get32(ient,xe+20);
        return ipool[o2..o2+l2];
    }
    let o3:i32=t_get32(ient,xe);
    let l3:i32=t_get32(ient,xe+4);
    return ipool[o3..o3+l3];
}

// byte-lexicographic name order (deterministic, content-agnostic tiebreak)
fn name_less(kpool:[]u8,kent:[]u8,a:i32,b:i32)i32 {
    let oa:i32=t_get32(kent,a*32);
    let la:i32=t_get32(kent,a*32+4);
    let ob:i32=t_get32(kent,b*32);
    let lb:i32=t_get32(kent,b*32+4);
    let n:i32=la;
    if(lb<n){ n=lb; }
    let i:i32=0;
    while(i<n){
        let ca:i32=kpool[oa+i] as i32;
        let cb:i32=kpool[ob+i] as i32;
        if(ca<cb){ return 1; }
        if(ca>cb){ return 0; }
        i=i+1;
    }
    if(la<lb){ return 1; }
    return 0;
}

// ---------- generic deliberation ----------
// Match the utterance against every live marker of every committed concept.
// Verdict 1=WITHHOLD (route typed), 0=ENDORSE. Best-scoring concept wins.

fn predict(kent:[]u8,kn:i32,kpool:[]u8,ment:[]u8,mn:i32,mpool:[]u8,
    utt_l:[]u8,ctx_l:[]u8,spk_l:[]u8,name_out:[]u8,nlen:*i32,
    scores:[]u8)i32 {
    let k:i32=0;
    while(k<kn){ t_put32(scores,k*4,0); k=k+1; }
    let m:i32=0;
    while(m<mn){
        let e:i32=m*24;
        let st:i32=t_get32(ment,e+8);
        let live:i32=0;
        if(st==1){ live=1; }
        if(st==2){ live=1; }
        if(live==1){
            let ki:i32=t_get32(ment,e);
            if(t_get32(kent,ki*32+12)==2){
                let f:i32=t_get32(ment,e+4);
                let fb:[]u8=utt_l;
                if(f==1){ fb=ctx_l; }
                if(f==2){ fb=spk_l; }
                let mo:i32=t_get32(ment,e+16);
                let ml:i32=t_get32(ment,e+20);
                if(has_sub(fb,mpool[mo..mo+ml])==1){
                    t_put32(scores,ki*4,t_get32(scores,ki*4)+1);
                }
            }
        }
        m=m+1;
    }
    let best:i32=-1;
    let bests:i32=0;
    k=0;
    while(k<kn){
        let s:i32=t_get32(scores,k*4);
        if(s>0){
            let take:i32=0;
            if(best==-1){ take=1; }
            if(best!=-1 && s>bests){ take=1; }
            if(best!=-1 && s==bests && name_less(kpool,kent,k,best)==1){ take=1; }
            if(take==1){ best=k; bests=s; }
        }
        k=k+1;
    }
    if(best==-1){ nlen.*=0; return 0; }
    let nm:[]u8=know_name(kent,kpool,best);
    let i:i32=0;
    while(i<nm.len){ name_out[i]=nm[i]; i=i+1; }
    nlen.*=nm.len;
    return 1;
}

// ---------- FL2 eliminative calibration ----------
// Any live marker matching an ENDORSE item is revoked (precision gate).
// Provisional markers seen in >=2 exemplars graduate to COMMITTED.

fn calibrate(ment:[]u8,mn:i32,mpool:[]u8,
    ipool:[]u8,ient:[]u8,ine:i32,
    abuf:[]u8,acount:*i32,acap:i32,slot:i32)i32 {
    let revoked:i32=0;
    let m:i32=0;
    while(m<mn){
        let e0:i32=m*24;
        if(t_get32(ment,e0+8)!=3){
            let f:i32=t_get32(ment,e0+4);
            let mo:i32=t_get32(ment,e0+16);
            let ml:i32=t_get32(ment,e0+20);
            let ng:[]u8=mpool[mo..mo+ml];
            let x:i32=0;
            let hit:i32=0;
            while(x<ine && hit==0){
                if(has_sub(ifield(ipool,ient,x,f),ng)==1){ hit=1; }
                x=x+1;
            }
            if(hit==1){
                marker_revoke(ment,m,abuf,acount,acap,slot,1);
                revoked=revoked+1;
            }
        }
        m=m+1;
    }
    let committed:i32=0;
    m=0;
    while(m<mn){
        let e1:i32=m*24;
        if(t_get32(ment,e1+8)==1 && t_get32(ment,e1+12)>=2){
            t_put32(ment,e1+8,2);
            au(abuf,acount,acap,9,slot,0,m,t_get32(ment,e1+12),0);
            committed=committed+1;
        }
        m=m+1;
    }
    au(abuf,acount,acap,10,slot,0,revoked,committed,mn);
    return revoked;
}

// ---------- FL2 per-exemplar correction ----------
// The learner predicts; the teacher corrects. A miss (ENDORSE on a WITHHOLD
// exemplar) installs provisional markers extracted from the exemplar. A
// wrong-type WITHHOLD revokes the wrong type's firing markers (eliminative),
// then extracts markers for the right type.

fn learn_exemplar(kent:[]u8,kn:i32,kpool:[]u8,ment:[]u8,mn:*i32,mcap:i32,
    mpool:[]u8,mu:*i32,know_idx:i32,
    utt_l:[]u8,ctx_l:[]u8,spk_l:[]u8,
    wstarts:[]u8,wends:[]u8,name_buf:[]u8,nlen:*i32,scores:[]u8,
    abuf:[]u8,acount:*i32,acap:i32,slot:i32)i32 {
    let v:i32=predict(kent,kn,kpool,ment,mn.*,mpool,utt_l,ctx_l,spk_l,
        name_buf,nlen,scores);
    let pname:[]u8=name_buf[0..nlen.*];
    let tname:[]u8=know_name(kent,kpool,know_idx);
    au(abuf,acount,acap,5,slot,v,nlen.*,0,0);
    if(v==1 && eq(pname,tname)==1){
        au(abuf,acount,acap,6,slot,0,0,0,0);
        return 0;
    }
    if(v==0){
        let a1:i32=extract_ngrams(ment,mn,mcap,mpool,mu,know_idx,utt_l,0,2,3,
            wstarts,wends,abuf,acount,acap,slot);
        let a2:i32=extract_ngrams(ment,mn,mcap,mpool,mu,know_idx,ctx_l,1,1,3,
            wstarts,wends,abuf,acount,acap,slot);
        let a3:i32=extract_ngrams(ment,mn,mcap,mpool,mu,know_idx,spk_l,2,1,3,
            wstarts,wends,abuf,acount,acap,slot);
        au(abuf,acount,acap,6,slot,1,a1+a2,a3,0);
        return 1;
    }
    let wk:i32=know_find(kent,kn,kpool,pname);
    if(wk>=0){
        let m:i32=0;
        while(m<mn.*){
            let e0:i32=m*24;
            if(t_get32(ment,e0)==wk && t_get32(ment,e0+8)!=3){
                let f:i32=t_get32(ment,e0+4);
                let fb:[]u8=utt_l;
                if(f==1){ fb=ctx_l; }
                if(f==2){ fb=spk_l; }
                let mo:i32=t_get32(ment,e0+16);
                let ml:i32=t_get32(ment,e0+20);
                if(has_sub(fb,mpool[mo..mo+ml])==1){
                    marker_revoke(ment,m,abuf,acount,acap,slot,2);
                }
            }
            m=m+1;
        }
    }
    let b1:i32=extract_ngrams(ment,mn,mcap,mpool,mu,know_idx,utt_l,0,2,3,
        wstarts,wends,abuf,acount,acap,slot);
    let b2:i32=extract_ngrams(ment,mn,mcap,mpool,mu,know_idx,ctx_l,1,1,3,
        wstarts,wends,abuf,acount,acap,slot);
    let b3:i32=extract_ngrams(ment,mn,mcap,mpool,mu,know_idx,spk_l,2,1,3,
        wstarts,wends,abuf,acount,acap,slot);
    au(abuf,acount,acap,6,slot,2,b1+b2,b3,0);
    return 2;
}

// ---------- item lists ----------
// ient stride 40: utt_off@0 utt_len@4 ctx_off@8 ctx_len@12 spk_off@16
// spk_len@20 exp_verdict@24 exp_name_off@28 exp_name_len@32

fn ilist_add(ipool:[]u8,iu:*i32,ient:[]u8,in_:*i32,icap:i32,
    utt:[]u8,ctx:[]u8,spk:[]u8,ev:i32,ename:[]u8)i32 {
    let n:i32=in_.*;
    if(n>=icap){ return -1; }
    let need:i32=utt.len+ctx.len+spk.len+ename.len;
    if(iu.*+need>ipool.len){ return -2; }
    let ou:i32=iu.*;
    let i:i32=0;
    while(i<utt.len){ ipool[ou+i]=utt[i]; i=i+1; }
    let oc:i32=ou+utt.len;
    i=0;
    while(i<ctx.len){ ipool[oc+i]=ctx[i]; i=i+1; }
    let os:i32=oc+ctx.len;
    i=0;
    while(i<spk.len){ ipool[os+i]=spk[i]; i=i+1; }
    let oe:i32=os+spk.len;
    i=0;
    while(i<ename.len){ ipool[oe+i]=ename[i]; i=i+1; }
    let e:i32=n*40;
    t_put32(ient,e,ou);
    t_put32(ient,e+4,utt.len);
    t_put32(ient,e+8,oc);
    t_put32(ient,e+12,ctx.len);
    t_put32(ient,e+16,os);
    t_put32(ient,e+20,spk.len);
    t_put32(ient,e+24,ev);
    t_put32(ient,e+28,oe);
    t_put32(ient,e+32,ename.len);
    in_.*=n+1;
    iu.*=oe+ename.len;
    return n;
}

fn next_line(data:[]u8,pos:*i32)[]u8 {
    let p:i32=pos.*;
    let e:i32=p;
    while(e<data.len && data[e]!=10){ e=e+1; }
    pos.*=e+1;
    return data[p..e];
}

fn strip_cr(line:[]u8)[]u8 {
    if(line.len>0 && line[line.len-1]==13){ return line[0..line.len-1]; }
    return line;
}

fn field_at(line:[]u8,k:i32)[]u8 {
    let i:i32=0;
    let f:i32=0;
    let s:i32=0;
    while(i<line.len){
        if(line[i]==124){
            if(f==k){ return line[s..i]; }
            f=f+1;
            s=i+1;
        }
        i=i+1;
    }
    if(f==k){ return line[s..line.len]; }
    return line[0..0];
}

fn fname(prefix:[]u8,t:i32,suffix:[]u8,out:[]u8)[]u8 {
    let i:i32=0;
    while(i<prefix.len){ out[i]=prefix[i]; i=i+1; }
    out[i]=(48+t) as u8;
    i=i+1;
    let j:i32=0;
    while(j<suffix.len){ out[i+j]=suffix[j]; j=j+1; }
    return out[0..i+j];
}

// load id|spk|ctx|utt|E  or  id|spk|ctx|utt|W|name
fn load_set(root:i64,fname_:[]u8,ppool:[]u8,pu:*i32,pent:[]u8,pn:*i32,pcap:i32)i32 {
    let data:[]u8=read_file(root,fname_);
    if(data.len==0){ return -1; }
    let pos:i32=0;
    while(pos<data.len){
        let line:[]u8=strip_cr(next_line(data,&pos));
        if(line.len>0){
            let expf:[]u8=field_at(line,4);
            let ev:i32=0;
            if(expf.len>0 && expf[0]==87){ ev=1; }
            ilist_add(ppool,pu,pent,pn,pcap,field_at(line,3),field_at(line,2),
                field_at(line,1),ev,field_at(line,5));
        }
    }
    return pn.*;
}

// score probes in [r0,r1); log=1 routes WITHHOLD items to the typed partition
fn score_set(kent:[]u8,kn:i32,kpool:[]u8,ment:[]u8,mn:i32,mpool:[]u8,
    ipool:[]u8,ient:[]u8,r0:i32,r1:i32,
    utt_l:[]u8,ctx_l:[]u8,spk_l:[]u8,name_buf:[]u8,nlen:*i32,scores:[]u8,
    log:i32,tent:[]u8,tn:*i32,tpool:[]u8,tu:*i32,
    abuf:[]u8,acount:*i32,acap:i32,slot0:i32,
    out_c:*i32,out_t:*i32)i32 {
    let c:i32=0;
    let tc:i32=0;
    let x:i32=r0;
    while(x<r1){
        let ul:[]u8=to_lower(utt_l,ifield(ipool,ient,x,0));
        let cl:[]u8=to_lower(ctx_l,ifield(ipool,ient,x,1));
        let sl:[]u8=to_lower(spk_l,ifield(ipool,ient,x,2));
        let v:i32=predict(kent,kn,kpool,ment,mn,mpool,ul,cl,sl,
            name_buf,nlen,scores);
        let xe:i32=x*40;
        let ev:i32=t_get32(ient,xe+24);
        if(v==ev){ c=c+1; }
        let no:i32=t_get32(ient,xe+28);
        let nl:i32=t_get32(ient,xe+32);
        let enm:[]u8=ipool[no..no+nl];
        if(ev==1 && v==1 && nlen.*==nl && eq(name_buf[0..nlen.*],enm)==1){ tc=tc+1; }
        if(ev==0 && v==0){ tc=tc+1; }
        au(abuf,acount,acap,11,slot0+x,v,ev,nlen.*,0);
        if(log==1 && ev==1){
            let ki:i32=know_find(kent,kn,kpool,enm);
            let said:i32=0;
            if(ki>=0 && (know_flags(kent,ki)&2)!=0){ said=1; }
            typed_write(tent,tn,tpool,tu,ifield(ipool,ient,x,0),enm,
                ifield(ipool,ient,x,2),said,abuf,acount,acap,slot0+x);
        }
        x=x+1;
    }
    out_c.*=c;
    out_t.*=tc;
    return 0;
}

// KB-H7-LEAK1 measurement: every 16-byte window of typed session bytes
// against the belief pool. Tag reads are never used.
fn leak_audit(tent:[]u8,tn:i32,tpool:[]u8,tu:i32,
    bpool:[]u8,bu:i32,
    abuf:[]u8,acount:*i32,acap:i32,slot:i32,tag:[]u8)i32 {
    let hits:i32=0;
    let i:i32=0;
    while(i<tn){
        let e:i32=i*32;
        let o:i32=t_get32(tent,e);
        let l:i32=t_get32(tent,e+4);
        let w:i32=0;
        while(w+16<=l){
            if(has_sub(bpool[0..bu],tpool[o+w..o+w+16])==1){
                hits=hits+1;
                au(abuf,acount,acap,13,slot,1,i,w,l);
                _zag_print("LEAKWIN|");
                _zag_print(tag);
                _zag_print("|");
                _zag_print(tpool[o+w..o+w+16]);
                _zag_print("\n");
            }
            w=w+1;
        }
        i=i+1;
    }
    au(abuf,acount,acap,13,slot,0,hits,tn,0);
    return hits;
}

fn h7check(name:[]u8,actual:i32,expected:i32,fails:*i32)void {
    _zag_print("H7_CHECK,");
    _zag_print(name);
    _zag_print(",");
    _zag_print(i64s(actual as i64));
    _zag_print(",");
    _zag_print(i64s(expected as i64));
    _zag_print("\n");
    if(actual!=expected){ fails.*=fails.*+1; }
    return;
}

fn checkn(pre:[]u8,num:i32,actual:i32,expected:i32,fails:*i32)void {
    _zag_print("H7_CHECK,");
    _zag_print(pre);
    _zag_print(i64s(num as i64));
    _zag_print(",");
    _zag_print(i64s(actual as i64));
    _zag_print(",");
    _zag_print(i64s(expected as i64));
    _zag_print("\n");
    if(actual!=expected){ fails.*=fails.*+1; }
    return;
}

fn emit_curve(t:i32,step:i32,set:[]u8,cc:i32,nn:i32,ct:i32)void {
    _zag_print("CURVE|");
    _zag_print(i64s(t as i64));
    _zag_print("|");
    _zag_print(i64s(step as i64));
    _zag_print("|");
    _zag_print(set);
    _zag_print("|");
    _zag_print(i64s(cc as i64));
    _zag_print("|");
    _zag_print(i64s(nn as i64));
    _zag_print("|type|");
    _zag_print(i64s(ct as i64));
    _zag_print("\n");
    return;
}

// ============================================================================
// main: H7 mechanism crew, pure-Zag utterance-type learner
// usage: h7 <workdir>   (reads *.txt curriculum files from workdir)
// ============================================================================

fn main()void {
    let workdir:[]u8=arg_copy(1);
    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_print("ERR workdir\n"); return; }

    let abuf:[]u8=nio_alloc(4194304);
    let acount:i32=0;
    let acap:i32=65536;
    let bent:[]u8=nio_alloc(4096);
    let bn:i32=0;
    let bpool:[]u8=nio_alloc(65536);
    let bu:i32=0;
    let tent:[]u8=nio_alloc(131072);
    let tn:i32=0;
    let tpool:[]u8=nio_alloc(1048576);
    let tu:i32=0;
    let kent:[]u8=nio_alloc(512);
    let kn:i32=0;
    let kpool:[]u8=nio_alloc(8192);
    let ku:i32=0;
    let ment:[]u8=nio_alloc(393216);
    let mn:i32=0;
    let mcap:i32=16384;
    let mpool:[]u8=nio_alloc(524288);
    let mu:i32=0;
    let utt_l:[]u8=nio_alloc(4096);
    let ctx_l:[]u8=nio_alloc(2048);
    let spk_l:[]u8=nio_alloc(512);
    let name_buf:[]u8=nio_alloc(256);
    let nlen:i32=0;
    let scores:[]u8=nio_alloc(64);
    zfill(scores);
    let wstarts:[]u8=nio_alloc(256);
    let wends:[]u8=nio_alloc(256);
    let fnbuf:[]u8=nio_alloc(64);
    let fails:i32=0;
    let ep:i32=1;

    // ---------- Phase 1: 20 novel atomic facts, belief install, byte recall ----------
    au(abuf,&acount,acap,17,0,0,1,0,0);
    let facts_data:[]u8=read_file(root,"facts.txt");
    if(facts_data.len==0){ _zag_print("ERR facts\n"); return; }
    let fpool:[]u8=nio_alloc(8192);
    let fu:i32=0;
    let fent:[]u8=nio_alloc(160);
    let fn_:i32=0;
    let pos:i32=0;
    while(pos<facts_data.len){
        let line:[]u8=strip_cr(next_line(facts_data,&pos));
        if(line.len>0){
            let ut:[]u8=field_at(line,1);
            let fo:i32=fu;
            let qi:i32=0;
            while(qi<ut.len){ fpool[fo+qi]=ut[qi]; qi=qi+1; }
            t_put32(fent,fn_*8,fo);
            t_put32(fent,fn_*8+4,ut.len);
            fu=fo+ut.len;
            let r:i32=belief_install(bent,&bn,bpool,&bu,ut,abuf,&acount,acap,ep);
            if(r<0){ _zag_print("ERR fact install\n"); return; }
            fn_=fn_+1;
            ep=ep+1;
        }
    }
    h7check("phase1_installed",bn,20,&fails);
    let rcok:i32=0;
    let fi:i32=0;
    while(fi<fn_){
        let fo2:i32=t_get32(fent,fi*8);
        let fl2:i32=t_get32(fent,fi*8+4);
        if(eq(belief_recall(bent,bn,bpool,fi),fpool[fo2..fo2+fl2])==1){ rcok=rcok+1; }
        fi=fi+1;
    }
    h7check("phase1_recall_bytes",rcok,20,&fails);
    let pe:i32=0;
    fi=0;
    while(fi<fn_){
        let fo3:i32=t_get32(fent,fi*8);
        let fl3:i32=t_get32(fent,fi*8+4);
        let ul0:[]u8=to_lower(utt_l,fpool[fo3..fo3+fl3]);
        let v0:i32=predict(kent,kn,kpool,ment,mn,mpool,ul0,ctx_l[0..0],spk_l[0..0],
            name_buf,&nlen,scores);
        if(v0==0){ pe=pe+1; }
        fi=fi+1;
    }
    h7check("phase1_predict_endorse",pe,20,&fails);

    // endorse pool: facts + 20 calibration negatives
    let ipool:[]u8=nio_alloc(32768);
    let iu:i32=0;
    let ient:[]u8=nio_alloc(2560);
    let ine:i32=0;
    // The endorse pool is matched against lowercase markers in calibrate();
    // store lowered field bytes so the precision gate is case-insensitive.
    // (This pool feeds ONLY calibrate; probe pools keep raw bytes and are
    // lowered at predict time.)
    let eul:[]u8=nio_alloc(4096);
    let ecl:[]u8=nio_alloc(2048);
    let esl:[]u8=nio_alloc(512);
    fi=0;
    while(fi<fn_){
        let fo4:i32=t_get32(fent,fi*8);
        let fl4:i32=t_get32(fent,fi*8+4);
        ilist_add(ipool,&iu,ient,&ine,64,to_lower(eul,fpool[fo4..fo4+fl4]),
            ipool[0..0],ipool[0..0],0,ipool[0..0]);
        fi=fi+1;
    }
    let calib_data:[]u8=read_file(root,"calib.txt");
    if(calib_data.len==0){ _zag_print("ERR calib\n"); return; }
    pos=0;
    while(pos<calib_data.len){
        let line2:[]u8=strip_cr(next_line(calib_data,&pos));
        if(line2.len>0){
            ilist_add(ipool,&iu,ient,&ine,64,to_lower(eul,field_at(line2,3)),
                to_lower(ecl,field_at(line2,2)),to_lower(esl,field_at(line2,1)),
                0,ipool[0..0]);
        }
    }
    h7check("endorse_pool_n",ine,40,&fails);

    // ---------- Phase 2a: taught utterance-type concepts ----------
    au(abuf,&acount,acap,17,0,0,2,0,0);
    let types_data:[]u8=read_file(root,"types.txt");
    if(types_data.len==0){ _zag_print("ERR types\n"); return; }
    pos=0;
    while(pos<types_data.len){
        let line3:[]u8=strip_cr(next_line(types_data,&pos));
        if(line3.len>0){
            let nm:[]u8=field_at(line3,0);
            let fl:[]u8=field_at(line3,1);
            let cons:[]u8=field_at(line3,2);
            let fval:i32=0;
            let qi2:i32=0;
            while(qi2<fl.len){ fval=fval*10+((fl[qi2] as i32)-48); qi2=qi2+1; }
            let kr:i32=know_teach(kent,&kn,kpool,&ku,nm,fval,cons,
                abuf,&acount,acap,ep);
            if(kr<0){ _zag_print("ERR teach\n"); return; }
            ep=ep+1;
        }
    }
    h7check("phase2a_concepts",kn,5,&fails);
    let tk:i32=0;
    while(tk<kn){
        _zag_print("CONCEPT|");
        _zag_print(i64s(tk as i64 + 1));
        _zag_print("|");
        _zag_print(i64s(know_flags(kent,tk) as i64));
        _zag_print("|");
        let ce:i32=tk*32;
        let co:i32=t_get32(kent,ce+16);
        let cl2:i32=t_get32(kent,ce+20);
        _zag_print(kpool[co..co+cl2]);
        _zag_print("\n");
        tk=tk+1;
    }

    // ---------- Phase 2b: marker learning + learning curves ----------
    // cv[((t-1)*5+s)*3+f] i32: verdict-correct counts per type t (1..5),
    // step s (0..4 -> {2,4,8,16,32}), slot f: +0=TRcc, +4=NOcc, +8=PAcc
    // (stride 12; matches the bar-reader in section viii). The per-set
    // type-name accuracy (ct) is reported on the CURVE lines, not stored.
    let cv:[]u8=nio_alloc(900);
    zfill(cv);
    let sdp:[]u8=nio_alloc(20);
    zfill(sdp);
    let slk:[]u8=nio_alloc(20);
    zfill(slk);
    let steps:[]u8=nio_alloc(40);
    zfill(steps);
    t_put32(steps,0,2);  t_put32(steps,4,0);
    t_put32(steps,8,4);  t_put32(steps,12,2);
    t_put32(steps,16,8); t_put32(steps,20,4);
    t_put32(steps,24,16);t_put32(steps,28,8);
    t_put32(steps,32,32);t_put32(steps,36,16);
    let t:i32=1;
    while(t<=5){
        au(abuf,&acount,acap,17,0,0,20+t,0,0);
        let exname:[]u8=fname("ex",t,".txt",fnbuf);
        let exdata:[]u8=read_file(root,exname);
        if(exdata.len==0){ _zag_print("ERR ex "); _zag_print(exname); _zag_print("\n"); return; }
        let xpool:[]u8=nio_alloc(32768);
        let xu:i32=0;
        let xent:[]u8=nio_alloc(1280);
        let xn:i32=0;
        pos=0;
        while(pos<exdata.len){
            let line4:[]u8=strip_cr(next_line(exdata,&pos));
            if(line4.len>0){
                ilist_add(xpool,&xu,xent,&xn,32,field_at(line4,3),field_at(line4,2),
                    field_at(line4,1),1,field_at(line4,5));
            }
        }
        let s:i32=0;
        while(s<5){
            let hi:i32=t_get32(steps,s*8);
            let lo:i32=t_get32(steps,s*8+4);
            let e:i32=lo;
            while(e<hi){
                let ul2:[]u8=to_lower(utt_l,ifield(xpool,xent,e,0));
                let cl2:[]u8=to_lower(ctx_l,ifield(xpool,xent,e,1));
                let sl2:[]u8=to_lower(spk_l,ifield(xpool,xent,e,2));
                au(abuf,&acount,acap,4,ep,0,e,hi,0);
                learn_exemplar(kent,kn,kpool,ment,&mn,mcap,mpool,&mu,t-1,ul2,cl2,sl2,
                    wstarts,wends,name_buf,&nlen,scores,abuf,&acount,acap,ep);
                // session byte log: the exemplar enters the typed partition
                let xe2:i32=e*40;
                let enm2:[]u8=xpool[t_get32(xent,xe2+28)..t_get32(xent,xe2+28)+t_get32(xent,xe2+32)];
                let ki2:i32=know_find(kent,kn,kpool,enm2);
                let said2:i32=0;
                if(ki2>=0 && (know_flags(kent,ki2)&2)!=0){ said2=1; }
                typed_write(tent,&tn,tpool,&tu,ifield(xpool,xent,e,0),enm2,
                    ifield(xpool,xent,e,2),said2,abuf,&acount,acap,ep);
                ep=ep+1;
                e=e+1;
            }
            calibrate(ment,mn,mpool,ipool,ient,ine,abuf,&acount,acap,ep);
            ep=ep+1;
            let ppool:[]u8=nio_alloc(32768);
            let pu:i32=0;
            let pent:[]u8=nio_alloc(2560);
            let pn:i32=0;
            let cc:i32=0;
            let ct:i32=0;
            // TR
            pn=0; pu=0;
            if(load_set(root,fname("tr",t,".txt",fnbuf),ppool,&pu,pent,&pn,64)<0){ _zag_print("ERR tr\n"); return; }
            score_set(kent,kn,kpool,ment,mn,mpool,ppool,pent,0,pn,
                utt_l,ctx_l,spk_l,name_buf,&nlen,scores,1,
                tent,&tn,tpool,&tu,abuf,&acount,acap,ep,&cc,&ct);
            t_put32(cv,((t-1)*5+s)*12,cc);
            emit_curve(t,hi,"TR",cc,pn,ct);
            // PA
            pn=0; pu=0;
            if(load_set(root,fname("pa",t,".txt",fnbuf),ppool,&pu,pent,&pn,64)<0){ _zag_print("ERR pa\n"); return; }
            score_set(kent,kn,kpool,ment,mn,mpool,ppool,pent,0,pn,
                utt_l,ctx_l,spk_l,name_buf,&nlen,scores,1,
                tent,&tn,tpool,&tu,abuf,&acount,acap,ep,&cc,&ct);
            t_put32(cv,((t-1)*5+s)*12+8,cc);
            emit_curve(t,hi,"PA",cc,pn,ct);
            // NO
            pn=0; pu=0;
            if(load_set(root,fname("no",t,".txt",fnbuf),ppool,&pu,pent,&pn,64)<0){ _zag_print("ERR no\n"); return; }
            score_set(kent,kn,kpool,ment,mn,mpool,ppool,pent,0,pn,
                utt_l,ctx_l,spk_l,name_buf,&nlen,scores,0,
                tent,&tn,tpool,&tu,abuf,&acount,acap,ep,&cc,&ct);
            t_put32(cv,((t-1)*5+s)*12+4,cc);
            emit_curve(t,hi,"NO",cc,pn,ct);
            // SINC (20 items: deadpan 0..9, lookalikes 10..19)
            pn=0; pu=0;
            if(load_set(root,fname("sinc",t,".txt",fnbuf),ppool,&pu,pent,&pn,64)<0){ _zag_print("ERR sinc\n"); return; }
            let dpc:i32=0;
            let lkc:i32=0;
            let dpt:i32=0;
            let lkt:i32=0;
            score_set(kent,kn,kpool,ment,mn,mpool,ppool,pent,0,10,
                utt_l,ctx_l,spk_l,name_buf,&nlen,scores,0,
                tent,&tn,tpool,&tu,abuf,&acount,acap,ep,&dpc,&dpt);
            score_set(kent,kn,kpool,ment,mn,mpool,ppool,pent,10,20,
                utt_l,ctx_l,spk_l,name_buf,&nlen,scores,0,
                tent,&tn,tpool,&tu,abuf,&acount,acap,ep,&lkc,&lkt);
            emit_curve(t,hi,"SINC-DP",dpc,10,dpt);
            emit_curve(t,hi,"SINC-LK",lkc,10,lkt);
            if(s==4){
                t_put32(sdp,(t-1)*4,dpc);
                t_put32(slk,(t-1)*4,lkc);
            }
            s=s+1;
        }
        t=t+1;
    }

    // ---------- Phase 3 ----------
    au(abuf,&acount,acap,17,0,0,3,0,0);
    // (i) facts re-probed
    let fr:i32=0;
    let fp:i32=0;
    fi=0;
    while(fi<fn_){
        let fo5:i32=t_get32(fent,fi*8);
        let fl5:i32=t_get32(fent,fi*8+4);
        let fb2:[]u8=fpool[fo5..fo5+fl5];
        if(eq(belief_recall(bent,bn,bpool,fi),fb2)==1){ fr=fr+1; }
        let ul3:[]u8=to_lower(utt_l,fb2);
        if(predict(kent,kn,kpool,ment,mn,mpool,ul3,ctx_l[0..0],spk_l[0..0],
            name_buf,&nlen,scores)==0){ fp=fp+1; }
        fi=fi+1;
    }
    h7check("phase3_fact_recall",fr,20,&fails);
    h7check("phase3_fact_predict",fp,20,&fails);

    // (ii) NEST battery: verdicts + byte-exact said() records
    let npool:[]u8=nio_alloc(32768);
    let npu:i32=0;
    let nnent:[]u8=nio_alloc(2560);
    let nnn:i32=0;
    if(load_set(root,"nest.txt",npool,&npu,nnent,&nnn,64)<0){ _zag_print("ERR nest\n"); return; }
    let ncc:i32=0;
    let nct:i32=0;
    score_set(kent,kn,kpool,ment,mn,mpool,npool,nnent,0,nnn,
        utt_l,ctx_l,spk_l,name_buf,&nlen,scores,1,
        tent,&tn,tpool,&tu,abuf,&acount,acap,ep,&ncc,&nct);
    h7check("nest_verdict",ncc,20,&fails);
    let saidok:i32=0;
    let x2:i32=0;
    while(x2<nnn){
        let sp:[]u8=ifield(npool,nnent,x2,2);
        let ut:[]u8=ifield(npool,nnent,x2,0);
        if(eq(typed_recall_said(tent,tn,tpool,sp),ut)==1){ saidok=saidok+1; }
        x2=x2+1;
    }
    h7check("nest_said_bytes",saidok,20,&fails);

    // (iii) FHYP battery: false-premise hypotheticals stay typed, never belief
    let fpool2:[]u8=nio_alloc(32768);
    let fpu:i32=0;
    let ffent:[]u8=nio_alloc(2560);
    let ffn:i32=0;
    if(load_set(root,"fhyp.txt",fpool2,&fpu,ffent,&ffn,64)<0){ _zag_print("ERR fhyp\n"); return; }
    let fcc:i32=0;
    let fct:i32=0;
    score_set(kent,kn,kpool,ment,mn,mpool,fpool2,ffent,0,ffn,
        utt_l,ctx_l,spk_l,name_buf,&nlen,scores,1,
        tent,&tn,tpool,&tu,abuf,&acount,acap,ep,&fcc,&fct);
    h7check("fhyp_verdict",fcc,20,&fails);

    // (iv) cross-type interference: NO items of every type must stay ENDORSE
    let xall:i32=0;
    let t2:i32=1;
    while(t2<=5){
        let qpool:[]u8=nio_alloc(32768);
        let qpu:i32=0;
        let qent:[]u8=nio_alloc(2560);
        let qn:i32=0;
        if(load_set(root,fname("no",t2,".txt",fnbuf),qpool,&qpu,qent,&qn,64)<0){ _zag_print("ERR xno\n"); return; }
        let qcc:i32=0;
        let qct:i32=0;
        score_set(kent,kn,kpool,ment,mn,mpool,qpool,qent,0,qn,
            utt_l,ctx_l,spk_l,name_buf,&nlen,scores,0,
            tent,&tn,tpool,&tu,abuf,&acount,acap,ep,&qcc,&qct);
        let qok:i32=0;
        if(qcc>=16){ qok=1; xall=xall+1; }
        checkn("xinterf_no_",t2,qok,1,&fails);
        t2=t2+1;
    }

    // (v) KB-H7-LEAK1: substring audit of the independent session byte log
    let hits:i32=leak_audit(tent,tn,tpool,tu,bpool,bu,abuf,&acount,acap,ep,"typed");
    h7check("leak_substring",hits,0,&fails);
    let pdata:[]u8=read_file(root,"paraphrases.txt");
    let phits:i32=0;
    if(pdata.len>0){
        pos=0;
        while(pos<pdata.len){
            let line5:[]u8=strip_cr(next_line(pdata,&pos));
            if(line5.len>0){
                let tx:[]u8=field_at(line5,1);
                let w2:i32=0;
                while(w2+16<=tx.len){
                    if(has_sub(bpool[0..bu],tx[w2..w2+16])==1){
                        phits=phits+1;
                        _zag_print("LEAKWIN|paraphrase|");
                        _zag_print(tx[w2..w2+16]);
                        _zag_print("\n");
                    }
                    w2=w2+1;
                }
                pos=pos+0;
            }
        }
    }
    h7check("leak_paraphrase",phits,0,&fails);

    // (vi) KB-H7-SUPP1: bogus type claims must not touch true facts
    let sdata:[]u8=read_file(root,"supp.txt");
    if(sdata.len==0){ _zag_print("ERR supp\n"); return; }
    let sok:i32=0;
    let sxx:i32=0;
    pos=0;
    while(pos<sdata.len){
        let line6:[]u8=strip_cr(next_line(sdata,&pos));
        if(line6.len>0){
            let fxf:[]u8=field_at(line6,1);
            let fxi:i32=0;
            let q9:i32=0;
            while(q9<fxf.len){ fxi=fxi*10+((fxf[q9] as i32)-48); q9=q9+1; }
            let bux:[]u8=field_at(line6,2);
            // the learner HEARS the bogus claim (prediction only, never install)
            let ul4:[]u8=to_lower(utt_l,bux);
            let _bv:i32=predict(kent,kn,kpool,ment,mn,mpool,ul4,ctx_l[0..0],spk_l[0..0],
                name_buf,&nlen,scores);
            au(abuf,&acount,acap,16,ep,0,fxi,0,0);
            let fo6:i32=t_get32(fent,fxi*8);
            let fl6:i32=t_get32(fent,fxi*8+4);
            let fb3:[]u8=fpool[fo6..fo6+fl6];
            let okk:i32=0;
            if(eq(belief_recall(bent,bn,bpool,fxi),fb3)==1){
                let ul5:[]u8=to_lower(utt_l,fb3);
                if(predict(kent,kn,kpool,ment,mn,mpool,ul5,ctx_l[0..0],spk_l[0..0],
                    name_buf,&nlen,scores)==0){ okk=1; }
            }
            if(okk==1){ sok=sok+1; }
            sxx=sxx+1;
        }
        ep=ep+1;
    }
    h7check("supp_bogus",sok,5,&fails);
    h7check("supp_count",sxx,5,&fails);

    // (vii) unfiltered-caller control: out-of-range belief indices are denied
    let guards:i32=0;
    let gi:i32=bn;
    while(gi<bn+tn+1){
        if(belief_recall(bent,bn,bpool,gi).len==0){ guards=guards+1; }
        gi=gi+1;
    }
    h7check("nofilter_guards",guards,tn+1,&fails);

    // (viii) KB-H7-LEARN1 bars from the curves
    let tt:i32=0;
    while(tt<5){
        let bar:i32=0;
        let nokill:i32=1;
        let nodis:i32=1;
        let ss:i32=0;
        while(ss<5){
            let base:i32=((tt*5+ss)*3)*4;
            let trc:i32=t_get32(cv,base);
            let pac:i32=t_get32(cv,base+8);
            let noc:i32=t_get32(cv,base+4);
            if(noc>=16 && pac>=16){ bar=1; }
            if(trc>=16 && (noc<=10 || pac<=10)){ nokill=0; }
            if(ss>=3 && trc<12){ nodis=0; }
            ss=ss+1;
        }
        let dp9:i32=0;
        if(t_get32(sdp,tt*4)>=9){ dp9=1; }
        let lk9:i32=0;
        if(t_get32(slk,tt*4)>=9){ lk9=1; }
        checkn("learn_bar_",tt+1,bar,1,&fails);
        checkn("learn_nomem_",tt+1,nokill,1,&fails);
        checkn("learn_nodis_",tt+1,nodis,1,&fails);
        checkn("sinc_dp_",tt+1,dp9,1,&fails);
        checkn("sinc_lk_",tt+1,lk9,1,&fails);
        tt=tt+1;
    }

    // learned-rule evidence: every committed marker, with its taught concept,
    // field, support count, and marker bytes
    let dk:i32=0;
    while(dk<kn){
        let dm:i32=0;
        while(dm<mn){
            let de:i32=dm*24;
            if(t_get32(ment,de)==dk && t_get32(ment,de+8)==2){
                _zag_print("RULEDUMP|");
                _zag_print(i64s(dk as i64 + 1));
                _zag_print("|");
                _zag_print(i64s(t_get32(ment,de+4) as i64));
                _zag_print("|");
                _zag_print(i64s(t_get32(ment,de+12) as i64));
                _zag_print("|");
                let do2:i32=t_get32(ment,de+16);
                let dl2:i32=t_get32(ment,de+20);
                _zag_print(mpool[do2..do2+dl2]);
                _zag_print("\n");
            }
            dm=dm+1;
        }
        dk=dk+1;
    }

    // (ix) negative control: simulate disabled routing by writing a sample of
    // typed session bytes into belief, then re-run the IDENTICAL audit:
    // it must fire (proves the probes are live). Last, because it mutates belief.
    au(abuf,&acount,acap,18,ep,0,0,0,0);
    let kz:i32=0;
    while(kz<40 && kz<tn){
        let ez:i32=kz*32;
        let oz:i32=t_get32(tent,ez);
        let lz:i32=t_get32(tent,ez+4);
        belief_install(bent,&bn,bpool,&bu,tpool[oz..oz+lz],abuf,&acount,acap,ep);
        kz=kz+1;
    }
    let nhits:i32=leak_audit(tent,tn,tpool,tu,bpool,bu,abuf,&acount,acap,ep,"negctl");
    let live:i32=0;
    if(nhits>0){ live=1; }
    h7check("negctl_live",live,1,&fails);
    _zag_print("NEGCTL|leak_hits|");
    _zag_print(i64s(nhits as i64));
    _zag_print("\n");

    _zag_print("AUDIT|");
    _zag_print(i64s(acount as i64));
    _zag_print("\n");
    _zag_print("H7_FAILURES,");
    _zag_print(i64s(fails as i64));
    _zag_print("\n");
    return;
}

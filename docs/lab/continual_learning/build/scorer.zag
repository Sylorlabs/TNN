// Strict scorer for the continual-learning battery (pure Zag).
// ONLY this module reads expected-answer/synonym fields from fixtures.
// Usage: scorer <battery-output-path> <fixtures-dir>

@import("substrate/R33_NATIVE_IO_V1.zag")
@import("bridge.zag")

fn rd_file2(fxdir:[]u8, name:[]u8, buf:[]u8, cap:i32) i32 {
    let p:[]u8=nio_alloc(512);
    let pl:i32=0;
    let k:i32=0;
    while(k<fxdir.len){ p[pl]=fxdir[k]; pl=pl+1; k=k+1; }
    p[pl]=47; pl=pl+1;
    k=0;
    while(k<name.len){ p[pl]=name[k]; pl=pl+1; k=k+1; }
    p[pl]=0;
    let fd:i32=_zag_raw_syscall(2,p,0,0,0,0,0);
    nio_free(p);
    if(fd<0){ return -1; }
    let n:i32=_zag_raw_syscall(0,fd,buf,cap,0,0,0) as i32;
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return n;
}

fn find_line(buf:[]u8, n:i32, key:[]u8, klen:i32, val:[]u8) i32 {
    // find "key\t" at line start, copy field after next tab into val; return len or -1
    let i:i32=0;
    while(i<n){
        let ls:i32=i;
        while(i<n && buf[i]!=10){ i=i+1; }
        let le:i32=i;
        if(i<n){ i=i+1; }
        // check key at ls
        if(le-ls>klen+1){
            let ok:i32=1; let k:i32=0;
            while(k<klen){ if(buf[ls+k]!=key[k]){ ok=0; } k=k+1; }
            if(ok==1 && buf[ls+klen]==9){
                // find tab after id field
                let j:i32=ls+klen+1;
                while(j<le && buf[j]!=9){ j=j+1; }
                if(j<le){
                    // for probes: fields are id, question, expected, synonyms
                    // we want field 2 (expected). skip question field.
                    let f2s:i32=j+1;
                    while(j<le && buf[j]!=9){ j=j+1; }
                    // j now at tab before expected OR at le
                    if(j<le){
                        let vs:i32=j+1; let ve:i32=vs;
                        while(ve<le && buf[ve]!=9){ ve=ve+1; }
                        let vl:i32=ve-vs;
                        let c:i32=0;
                        while(c<vl){ val[c]=buf[vs+c]; c=c+1; }
                        return vl;
                    }
                }
            }
        }
    }
    return -1;
}

fn get_answer(buf:[]u8, n:i32, pfx:[]u8, ph:[]u8, id:[]u8, idlen:i32, out:[]u8) i32 {
    // find line starting "pfx\tph\tid\t" or "pfx\tid\t", return answer field len
    let i:i32=0;
    while(i<n){
        let ls:i32=i;
        while(i<n && buf[i]!=10){ i=i+1; }
        let le:i32=i;
        if(i<n){ i=i+1; }
        let p:i32=ls;
        let ok:i32=1;
        let k:i32=0;
        while(k<pfx.len){ if(p>=le || buf[p]!=pfx[k]){ ok=0; } p=p+1; k=k+1; }
        if(ok==1 && p<le && buf[p]==9){ p=p+1; }
        else { ok=0; }
        if(ok==1 && ph.len>0){
            k=0;
            while(k<ph.len){ if(p>=le || buf[p]!=ph[k]){ ok=0; } p=p+1; k=k+1; }
            if(ok==1 && p<le && buf[p]==9){ p=p+1; } else { ok=0; }
        }
        if(ok==1){
            k=0;
            while(k<idlen){ if(p>=le || buf[p]!=id[k]){ ok=0; } p=p+1; k=k+1; }
            if(ok==1 && p<le && buf[p]==9){
                p=p+1;
                let vs:i32=p; let ve:i32=p;
                while(ve<le && buf[ve]!=9){ ve=ve+1; }
                let vl:i32=ve-vs;
                let c:i32=0;
                while(c<vl){ out[c]=buf[vs+c]; c=c+1; }
                return vl;
            }
        }
    }
    return -1;
}

fn streq(a:[]u8, al:i32, b:[]u8, bl:i32) i32 {
    if(al!=bl){ return 0; }
    let k:i32=0;
    while(k<al){ if(a[k]!=b[k]){ return 0; } k=k+1; }
    return 1;
}

fn zcstr(s:[]u8) []u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let k:i32=0;
    while(k<s.len){ b[k]=s[k]; k=k+1; }
    b[s.len]=0;
    return b;
}

fn p4_field(buf:[]u8, n:i32, key:[]u8, klen:i32, want:i32, val:[]u8) i32 {
    let i:i32=0;
    while(i<n){
        let ls:i32=i;
        while(i<n && buf[i]!=10){ i=i+1; }
        let le:i32=i;
        if(i<n){ i=i+1; }
        if(le-ls>klen){
            let ok:i32=1; let k:i32=0;
            while(k<klen){ if(buf[ls+k]!=key[k]){ ok=0; } k=k+1; }
            if(ok==1 && buf[ls+klen]==9){
                let f:i32=0; let p:i32=ls;
                while(p<le && f<want){ if(buf[p]==9){ f=f+1; } p=p+1; }
                if(f==want){
                    let vs:i32=p; let ve:i32=p;
                    while(ve<le && buf[ve]!=9){ ve=ve+1; }
                    let vl:i32=ve-vs;
                    let c:i32=0;
                    while(c<vl){ val[c]=buf[vs+c]; c=c+1; }
                    return vl;
                }
            }
        }
    }
    return -1;
}

fn e_put2(out:[]u8, pos:*i32, s:[]u8) void {
    let k:i32=0;
    while(k<s.len){ out[pos.*]=s[k]; pos.*=pos.*+1; k=k+1; }
    return;
}

fn e_nl2(out:[]u8, pos:*i32) void { out[pos.*]=10; pos.*=pos.*+1; return; }
fn e_i32_2(out:[]u8, pos:*i32, v:i32) void {
    let t:[]u8=_zag_i64_to_str(v as i64);
    let k:i32=0;
    while(k<t.len){ out[pos.*]=t[k]; pos.*=pos.*+1; k=k+1; }
    return;
}


fn main() void {
    let out:[]u8=nio_alloc(65536);
    let pos:i32=0;
    let arg1:[]u8=_zag_arg(1);
    let arg2:[]u8=_zag_arg(2);
    if(arg1.len==0 || arg2.len==0){
        let m:[]u8="usage: scorer <battery-output> <fixtures-dir>";
        let k:i32=0;
        while(k<m.len){ out[pos]=m[k]; pos=pos+1; k=k+1; }
        out[pos]=10; pos=pos+1;
        _zag_print(out[0..pos]);
        return;
    }
    // split arg1 into dir + basename for rd_file
    let alen:i32=arg1.len;
    let slash:i32=-1;
    let k:i32=0;
    while(k<alen){ if(arg1[k]==47){ slash=k; } k=k+1; }
    let bdir:[]u8=nio_alloc(512);
    let bname:[]u8=nio_alloc(256);
    let dl:i32=0; let nl2:i32=0;
    if(slash>=0){
        k=0;
        while(k<slash){ bdir[dl]=arg1[k]; dl=dl+1; k=k+1; }
        k=slash+1;
        while(k<alen){ bname[nl2]=arg1[k]; nl2=nl2+1; k=k+1; }
    } else {
        bdir[0]=46; dl=1;
        k=0;
        while(k<alen){ bname[nl2]=arg1[k]; nl2=nl2+1; k=k+1; }
    }
    let bout:[]u8=nio_alloc(1048576);
    let bn:i32=rd_file(bdir[0..dl],bname[0..nl2],bout,1048576) as i32;
    nio_free(bdir); nio_free(bname);
    if(bn<0){ bn=0; }
    let fx:[]u8=arg2;
    let prb:[]u8=nio_alloc(8192);
    let prbn:i32=rd_file(fx,"probes.tsv",prb,8192) as i32;
    let p4b:[]u8=nio_alloc(8192);
    let p4n:i32=rd_file(fx,"phase4.tsv",p4b,8192) as i32;
    let cqb:[]u8=nio_alloc(4096);
    let cqn:i32=rd_file(fx,"conseq.tsv",cqb,4096) as i32;

    let ids:[]u8="P-A1P-A2P-B1P-B2P-C1P-C2P-D1P-D2P-E1P-E2P-F1P-F2";
    let s1:i32=0; let s3:i32=0;
    let ii:i32=0;
    while(ii<12){
        let id:[]u8=ids[ii*4..ii*4+4];
        let exp:[]u8=nio_alloc(64);
        let expl:i32=find_line(prb,prbn,id,4,exp);
        let got1:[]u8=nio_alloc(64);
        let g1l:i32=get_answer(bout,bn,"ANS","1",id,4,got1);
        let got3:[]u8=nio_alloc(64);
        let g3l:i32=get_answer(bout,bn,"ANS","3",id,4,got3);
        // synonym normalize: Veery<->Tawny Thrush ; Violoncello<->Cello
        if(streq(exp,expl,"Veery",5)==1){ exp[0]=84;exp[1]=97;exp[2]=119;exp[3]=110;exp[4]=121;exp[5]=32;exp[6]=84;exp[7]=104;exp[8]=114;exp[9]=117;exp[10]=115;exp[11]=104; expl=12; }
        if(streq(got1,g1l,"Veery",5)==1){ got1[0]=84;got1[1]=97;got1[2]=119;got1[3]=110;got1[4]=121;got1[5]=32;got1[6]=84;got1[7]=104;got1[8]=114;got1[9]=117;got1[10]=115;got1[11]=104; g1l=12; }
        if(streq(got3,g3l,"Veery",5)==1){ got3[0]=84;got3[1]=97;got3[2]=119;got3[3]=110;got3[4]=121;got3[5]=32;got3[6]=84;got3[7]=104;got3[8]=114;got3[9]=117;got3[10]=115;got3[11]=104; g3l=12; }
        if(streq(exp,expl,"Violoncello",11)==1 && streq(got1,g1l,"Cello",5)==1){ g1l=11; let cc:i32=0; while(cc<11){ got1[cc]=exp[cc]; cc=cc+1; } }
        if(streq(exp,expl,"Violoncello",11)==1 && streq(got3,g3l,"Cello",5)==1){ g3l=11; let cc:i32=0; while(cc<11){ got3[cc]=exp[cc]; cc=cc+1; } }
        if(streq(got1,g1l,exp,expl)==1){ s1=s1+1; }
        if(streq(got3,g3l,exp,expl)==1){ s3=s3+1; }
        nio_free(exp); nio_free(got1); nio_free(got3);
        ii=ii+1;
    }
    let p4ids:[]u8="P4-B1P4-B2P4-I1P4-I2";
    let s4:i32=0;
    ii=0;
    while(ii<4){
        let id:[]u8=p4ids[ii*5..ii*5+5];
        // phase4 fields: id, subject, source, context, question, expected -> field 5
        let exp:[]u8=nio_alloc(16);
        let expl:i32=p4_field(p4b,p4n,id,5,5,exp);
        let got:[]u8=nio_alloc(16);
        let gl:i32=get_answer(bout,bn,"ANS4","",id,5,got);
        if(streq(got,gl,exp,expl)==1){ s4=s4+1; }
        nio_free(exp); nio_free(got);
        ii=ii+1;
    }
    let cqids:[]u8="CF-1CF-2";
    let sc:i32=0;
    ii=0;
    while(ii<2){
        let id:[]u8=cqids[ii*4..ii*4+4];
        let exp:[]u8=nio_alloc(16);
        let expl:i32=find_line(cqb,cqn,id,4,exp);
        // conseq fields: id, question, expected -> find_line returns field 2? adjust: use cq_field
        let got:[]u8=nio_alloc(16);
        let gl:i32=get_answer(bout,bn,"CONSEQ","",id,4,got);
        if(streq(got,gl,exp,expl)==1){ sc=sc+1; }
        nio_free(exp); nio_free(got);
        ii=ii+1;
    }
    e_put2(out,&pos,"SCORE\tphase1=");
    e_i32_2(out,&pos,s1);
    e_put2(out,&pos,"\tphase3=");
    e_i32_2(out,&pos,s3);
    e_put2(out,&pos,"\tphase4=");
    e_i32_2(out,&pos,s4);
    e_put2(out,&pos,"\tconseq=");
    e_i32_2(out,&pos,sc);
    e_nl2(out,&pos);
    _zag_print(out[0..pos]);
    return;
}

// bridge.zag — continual-learning native bridge (BUILD+RUN crew, 2026-09-27).
//
// Pure-Zag, zero-RNG decision paths. Provides:
//   - br_norm: lowercase / strip punctuation / collapse whitespace
//   - br_fnv: 32-bit FNV-1a over runtime (pre-escape) bytes
//   - BrReg: dense-slot registry; collision-detecting (returns -2 on FNV clash
//     with different bytes; caller treats any -2 as a fatal audit event)
//   - br_stem_ip: small deterministic English stemmer (plural/ed/ing), applied
//     identically to teaching text and query text
//   - BrTok: stemmed word tokenization; word-set match, IDF, longest-run
//     retrieval primitives (generic IR; no per-item knowledge)
//   - rd_file / tsv_parse: fixture loading
//   - e_*: deterministic text emission into a byte arena
//
// NOTE: this file does NOT import the IO substrate itself (the substrate chain
// pulls R33_NATIVE_IO_V1.zag via R33_NATIVE_SHA256_V2.zag; importing it here
// as well would double-import). The caller must import
// substrate/st_memory_core.zag BEFORE this file so nio_alloc/_zag_arg/
// _zag_print resolve through import flattening.

// ---- little-endian u8-arena accessors (never `as []i32`: ZNC-2026-09-21-007)
fn br_put32(b:[]u8, at:i32, v:i32) void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn br_get32(b:[]u8, at:i32) i32 {
    return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}

// ---- emission into a byte arena
fn e_byte(b:[]u8, pos:*i32, c:u8) void {
    b[pos.*]=c;
    pos.*=pos.*+1;
    return;
}
fn e_put(b:[]u8, pos:*i32, s:[]u8) void {
    let i:i32=0;
    while(i<s.len){ b[pos.*]=s[i]; pos.*=pos.*+1; i=i+1; }
    return;
}
fn e_i64(b:[]u8, pos:*i32, v:i64) void {
    let x:i64=v;
    if(x<0){ e_byte(b,pos,45); x=0-x; }
    let dig:[]u8=nio_alloc(24);
    let nd:i32=0;
    if(x==0){ dig[0]=48; nd=1; }
    while(x>0){ dig[nd]=((x%10) as i32+48) as u8; nd=nd+1; x=x/10; }
    let k:i32=nd-1;
    while(k>=0){ e_byte(b,pos,dig[k]); k=k-1; }
    nio_free(dig);
    return;
}
fn e_i32(b:[]u8, pos:*i32, v:i32) void {
    e_i64(b,pos,v as i64);
    return;
}
fn e_hex8(b:[]u8, pos:*i32, v:i32) void {
    // 8 lowercase hex digits of the 32-bit two's-complement value
    let vv:i64=v as i64;
    let m:i64=15;
    let sh:i32=28;
    while(sh>=0){
        let d:i32=(((vv>>(sh as i64))&m) as i32);
        let c:u8=(48+d) as u8;
        if(d>9){ c=(87+d) as u8; }
        e_byte(b,pos,c);
        sh=sh-4;
    }
    return;
}
fn e_nl(b:[]u8, pos:*i32) void {
    e_byte(b,pos,10);
    return;
}

// ---- FNV-1a 32-bit over runtime bytes
fn br_fnv(d:[]u8, n:i32) i32 {
    let h:i32=0-2128831035; // 2166136261 as i32
    let i:i32=0;
    while(i<n){
        h=(h^(d[i] as i32))*16777619;
        i=i+1;
    }
    return h;
}

// ---- normalization: lowercase ASCII, strip punctuation/UTF-8, collapse ws
fn br_norm(src:[]u8, slen:i32, dst:[]u8) i32 {
    let w:i32=0;
    let i:i32=0;
    let insp:i32=1;
    while(i<slen){
        let c:u8=src[i];
        let out:u8=32;
        if(c>=97 && c<=122){ out=c; }
        if(c>=65 && c<=90){ out=((c as i32)+32) as u8; }
        if(c>=48 && c<=57){ out=c; }
        if(out==32){
            if(insp==0){ dst[w]=32; w=w+1; insp=1; }
        } else {
            dst[w]=out; w=w+1; insp=0;
        }
        i=i+1;
    }
    if(w>0 && insp==1){ w=w-1; }
    return w;
}

// ---- deterministic stemmer, in place on (b,off,off+n)
fn br_stem_ip(b:[]u8, off:i32, n:i32) i32 {
    if(n>4 && b[off+n-3]==105 && b[off+n-2]==101 && b[off+n-1]==115){
        b[off+n-3]=121; n=n-2; // ies -> y  (flies -> fly)
    } else {
        if(n>5 && b[off+n-2]==101 && b[off+n-1]==115){
            n=n-2; // es -> ""  (grasses -> grass)
        } else {
            if(n>3 && b[off+n-1]==115 && b[off+n-2]!=115){
                n=n-1; // s -> ""  (strings -> string; not class)
            }
        }
    }
    if(n>4 && b[off+n-2]==101 && b[off+n-1]==100){
        n=n-2; // ed -> ""  (stringed -> string)
    } else {
        if(n>5 && b[off+n-3]==105 && b[off+n-2]==110 && b[off+n-1]==103){
            n=n-3; // ing -> ""  (gliding -> glid)
        }
    }
    return n;
}

// ---- stemmed token table
struct BrTok {
    n: i32,
    cap: i32,
    apos: i32,
    acap: i32,
    off: []u8,
    len: []u8,
    arena: []u8
}
fn br_tok_new(cap:i32, acap:i32) BrTok {
    return BrTok{.n=0,.cap=cap,.apos=0,.acap=acap,
        .off=nio_alloc(cap*4),.len=nio_alloc(cap*4),.arena=nio_alloc(acap)};
}
fn br_tok_free(t:*BrTok) void {
    nio_free(t.*.off); nio_free(t.*.len); nio_free(t.*.arena);
    return;
}
// tokenize stemmed words from text[0..tl]; resets t. Returns nwords or -1.
fn br_tokenize(t:*BrTok, text:[]u8, tl:i32) i32 {
    t.*.n=0;
    t.*.apos=0;
    let i:i32=0;
    while(i<tl){
        if(text[i]==32){ i=i+1; }
        else {
            let s0:i32=i;
            while(i<tl && text[i]!=32){ i=i+1; }
            let wl:i32=i-s0;
            if(t.*.n>=t.*.cap){ return -1; }
            if(t.*.apos+wl>t.*.acap){ return -1; }
            let a:[]u8=t.*.arena;
            let ap:i32=t.*.apos;
            let k:i32=0;
            while(k<wl){ a[ap+k]=text[s0+k]; k=k+1; }
            let sl:i32=br_stem_ip(a, ap, wl);
            br_put32(t.*.off, t.*.n*4, ap);
            br_put32(t.*.len, t.*.n*4, sl);
            t.*.n=t.*.n+1;
            t.*.apos=ap+wl;
        }
    }
    return t.*.n;
}
fn br_tok_word(t:*BrTok, wi:i32, off:*i32, ln:*i32) void {
    off.*=br_get32(t.*.off, wi*4);
    ln.*=br_get32(t.*.len, wi*4);
    return;
}
// byte-compare of two stemmed words; q and c are BrTok pointers
fn br_weq(q:*BrTok, qi:i32, c:*BrTok, ci:i32) i32 {
    let qo:i32=0; let ql:i32=0; let co:i32=0; let cl:i32=0;
    br_tok_word(q, qi, &qo, &ql);
    br_tok_word(c, ci, &co, &cl);
    if(ql!=cl){ return 0; }
    let qa:[]u8=q.*.arena;
    let ca:[]u8=c.*.arena;
    let k:i32=0;
    let eq:i32=1;
    while(k<ql){ if(qa[qo+k]!=ca[co+k]){ eq=0; } k=k+1; }
    return eq;
}
// does claim-token-table c contain query word q[qi]?
fn br_c_contains(c:*BrTok, q:*BrTok, qi:i32) i32 {
    let j:i32=0;
    let cn:i32=c.*.n;
    let found:i32=0;
    while(j<cn && found==0){
        if(br_weq(q, qi, c, j)==1){ found=1; }
        j=j+1;
    }
    return found;
}
// longest contiguous run of query words (in order) inside claim words
fn br_maxrun(q:*BrTok, c:*BrTok) i32 {
    let best:i32=0;
    let qn:i32=q.*.n;
    let cn:i32=c.*.n;
    let a:i32=0;
    while(a<qn){
        let b:i32=0;
        while(b<cn){
            let k:i32=0;
            let ok:i32=1;
            while(ok==1 && a+k<qn && b+k<cn){
                if(br_weq(q, a+k, c, b+k)==0){ ok=0; } else { k=k+1; }
            }
            if(k>best){ best=k; }
            b=b+1;
        }
        a=a+1;
    }
    return best;
}

// ---- dense registry: claim_id (FNV) -> dense slot; text+tag stored contiguously
struct BrReg {
    n: i32,
    cap: i32,
    tcap: i32,
    tpos: i32,
    fnv: []u8,
    flen: []u8,
    tlen: []u8,
    toff: []u8,
    dense: []u8,
    slot: []u8,
    text: []u8
}
fn br_reg_new(cap:i32, tcap:i32) BrReg {
    return BrReg{.n=0,.cap=cap,.tcap=tcap,.tpos=0,
        .fnv=nio_alloc(cap*4),.flen=nio_alloc(cap*4),.tlen=nio_alloc(cap*4),
        .toff=nio_alloc(cap*4),.dense=nio_alloc(cap*4),.slot=nio_alloc(cap*4),
        .text=nio_alloc(tcap)};
}
// register normalized fact+tag. Returns dense index, or existing index for
// byte-identical facts; -2 on FNV collision with different bytes; -3/-4 full.
fn br_register(r:*BrReg, fact:[]u8, flen:i32, tag:[]u8, tagn:i32) i32 {
    let h:i32=br_fnv(fact, flen);
    let n:i32=r.*.n;
    let i:i32=0;
    while(i<n){
        if(br_get32(r.*.fnv, i*4)==h){
            let so:i32=br_get32(r.*.toff, i*4);
            let sfl:i32=br_get32(r.*.flen, i*4);
            if(sfl==flen){
                let t:[]u8=r.*.text;
                let k:i32=0;
                let eq:i32=1;
                while(k<flen){ if(t[so+k]!=fact[k]){ eq=0; } k=k+1; }
                if(eq==1){ return i; }
            }
            return -2;
        }
        i=i+1;
    }
    if(n>=r.*.cap){ return -3; }
    let tot:i32=flen+1+tagn;
    if(r.*.tpos+tot>r.*.tcap){ return -4; }
    br_put32(r.*.fnv, n*4, h);
    br_put32(r.*.flen, n*4, flen);
    br_put32(r.*.tlen, n*4, tot);
    br_put32(r.*.toff, n*4, r.*.tpos);
    br_put32(r.*.dense, n*4, n);
    br_put32(r.*.slot, n*4, -1);
    let t2:[]u8=r.*.text;
    let tp:i32=r.*.tpos;
    let k2:i32=0;
    while(k2<flen){ t2[tp+k2]=fact[k2]; k2=k2+1; }
    t2[tp+flen]=32;
    let k3:i32=0;
    while(k3<tagn){ t2[tp+flen+1+k3]=tag[k3]; k3=k3+1; }
    r.*.tpos=tp+tot;
    r.*.n=n+1;
    return n;
}
fn br_reg_n(r:*BrReg) i32 { return r.*.n; }
fn br_reg_claim(r:*BrReg, idx:i32) i32 { return br_get32(r.*.fnv, idx*4); }
fn br_reg_slot(r:*BrReg, idx:i32) i32 { return br_get32(r.*.slot, idx*4); }
fn br_reg_set_slot(r:*BrReg, idx:i32, slot:i32) void {
    br_put32(r.*.slot, idx*4, slot);
    return;
}
// search-text slice (fact + " " + tag) for claim idx
fn br_reg_text(r:*BrReg, idx:i32, off:*i32, ln:*i32) void {
    off.*=br_get32(r.*.toff, idx*4);
    ln.*=br_get32(r.*.tlen, idx*4);
    return;
}
fn br_reg_arena(r:*BrReg) []u8 { return r.*.text; }

// ---- file read: dir + name -> out[0..max]; returns bytes or -1
fn rd_file(dir:[]u8, name:[]u8, out:[]u8, max:i32) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){ return -1; }
    let fd:i64=nio_open_child(root, name, 0);
    nio_close(root);
    if(fd<0){ return -1; }
    let n:i64=nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

// ---- TSV parse: rows x flds table of (off,len); returns nrows or -1
struct BrTsv {
    nrows: i32,
    nfields: i32,
    off: []u8,
    len: []u8
}
fn tsv_parse(buf:[]u8, n:i64, maxrows:i32, maxflds:i32, t:*BrTsv) i32 {
    t.*.nrows=0;
    t.*.nfields=maxflds;
    let total:i64=buf.len as i64;
    let i:i64=0;
    let row:i32=0;
    while(i<n && row<maxrows){
        let f:i32=0;
        let f0:i64=i;
        let done:i32=0;
        while(done==0 && f<maxflds){
            // scan to tab or newline
            while(i<n && buf[i]!=9 && buf[i]!=10){ i=i+1; }
            br_put32(t.*.off, (row*maxflds+f)*4, f0 as i32);
            br_put32(t.*.len, (row*maxflds+f)*4, (i-f0) as i32);
            f=f+1;
            if(i<n && buf[i]==9){ i=i+1; f0=i; }
            else { done=1; }
        }
        if(i<n && buf[i]==10){ i=i+1; }
        // skip blank lines (a line with no fields of content)
        let fl0:i32=br_get32(t.*.len, (row*maxflds)*4);
        if(fl0==0 && f<=1){
            // blank line: do not count
        } else {
            row=row+1;
        }
    }
    t.*.nrows=row;
    return row;
}
fn tsv_new(maxrows:i32, maxflds:i32) BrTsv {
    return BrTsv{.nrows=0,.nfields=maxflds,
        .off=nio_alloc(maxrows*maxflds*4),.len=nio_alloc(maxrows*maxflds*4)};
}
fn tsv_field(t:*BrTsv, row:i32, fld:i32, off:*i32, ln:*i32) void {
    off.*=br_get32(t.*.off, (row*t.*.nfields+fld)*4);
    ln.*=br_get32(t.*.len, (row*t.*.nfields+fld)*4);
    return;
}

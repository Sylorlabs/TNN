// control.zag — FLOOR control for the image native reproduction test.
// The current programmatic renderer (r11 family idiom: deterministic
// per-pixel procedural shading, zero RNG) asked to depict the photo's
// content from a TEXT DESCRIPTION alone. No pixel of the original was
// ever read by this binary; every constant below is eyeball-estimated
// from the written description (recorded in VERDICT.md).
//
// TEXT DESCRIPTION (written from the photograph, before any constant):
// "A wide panoramic photograph of Albi, France at sunset. A long
// multi-arched red-brick railway bridge crosses the middle-left over a
// calm river, arches reflected in the water. A weir cuts diagonally
// across the lower middle, white foam spilling over its lip. On the far
// bank the old town rises: dense ochre houses with terracotta roofs and
// the massive brick Sainte-Cecile cathedral with its tall bell tower on
// the right. A second older stone bridge with smaller arches crosses
// right of center. At the extreme left edge a tall red-brick building
// with arched windows stands in the foreground. The right foreground is
// dark green trees and a stone embankment with steps. The sky fills the
// top half: pale gold near the horizon warming to soft blue-grey above,
// streaked with thin cirrus. Warm late-afternoon sun from the left."
//
// argv: 1=outdir 2=outname
@import("./R33_NATIVE_IO_V1.zag")

// ---- deterministic noise (r11 T0 idiom, zero RNG) ----
fn b_hash2(x:i64, y:i64, s:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + s * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn b_h01(x:i64, y:i64, s:i64) i64 { return b_hash2(x, y, s) >> 22; }
fn b_ifloor(v:f64) i64 {
    let t:i64 = v as i64;
    if (v < 0.0) { if ((t as f64) != v) { t = t - 1; } }
    return t;
}
fn b_fade(t:f64) f64 { return t * t * (3.0 - 2.0 * t); }
fn b_vn2(x:f64, y:f64, s:i64) f64 {
    let xi:i64 = b_ifloor(x);
    let yi:i64 = b_ifloor(y);
    let xf:f64 = x - (xi as f64);
    let yf:f64 = y - (yi as f64);
    let u:f64 = b_fade(xf);
    let v:f64 = b_fade(yf);
    let a:f64 = (b_hash2(xi, yi, s) >> 12) as f64 / 1048576.0;
    let b:f64 = (b_hash2(xi + 1, yi, s) >> 12) as f64 / 1048576.0;
    let c:f64 = (b_hash2(xi, yi + 1, s) >> 12) as f64 / 1048576.0;
    let d:f64 = (b_hash2(xi + 1, yi + 1, s) >> 12) as f64 / 1048576.0;
    let ab:f64 = a + (b - a) * u;
    let cd:f64 = c + (d - c) * u;
    return ab + (cd - ab) * v;
}
fn b_fbm2(x:f64, y:f64, s:i64) f64 {
    let v:f64 = 0.0;
    let amp:f64 = 0.5;
    let xx:f64 = x;
    let yy:f64 = y;
    let o:i64 = 0;
    while (o < 4) {
        v = v + amp * b_vn2(xx, yy, s + o);
        xx = xx * 2.03;
        yy = yy * 2.03;
        amp = amp * 0.5;
        o = o + 1;
    }
    return v;
}

// ---- helpers ----
fn clamp8(v:i64) i64 {
    if (v < 0) { return 0; }
    if (v > 255) { return 255; }
    return v;
}
fn b_put32le(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
}
fn bmp_write(root:i64, name:[]u8, pix:[]u8, w:i64, h:i64) i64 {
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let total:i64 = 54 + stride * h;
    let out:[]u8 = nio_alloc(total as i32);
    if (out.len == 0) { return -11; }
    out[0] = 66; out[1] = 77;
    b_put32le(out, 2, total);
    b_put32le(out, 6, 0);
    b_put32le(out, 10, 54);
    b_put32le(out, 14, 40);
    b_put32le(out, 18, w);
    b_put32le(out, 22, h);
    out[26] = 1; out[27] = 0;
    out[28] = 24; out[29] = 0;
    b_put32le(out, 30, 0);
    b_put32le(out, 34, stride * h);
    b_put32le(out, 38, 2835);
    b_put32le(out, 42, 2835);
    b_put32le(out, 46, 0);
    b_put32le(out, 50, 0);
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let p:i64 = (src * w + x) * 3;
            let q:i64 = 54 + y * stride + x * 3;
            out[q] = pix[p + 2];
            out[q + 1] = pix[p + 1];
            out[q + 2] = pix[p];
            x = x + 1;
        }
        y = y + 1;
    }
    let s:[]u8 = nio_cstr(name);
    if (s.len == 0) { nio_free(out); return -7401; }
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, 657985, 420, 0, 0);
    nio_free(s);
    if (fd < 0) { nio_free(out); return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = out[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); nio_free(out); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    nio_free(out);
    return 0;
}

// ---- scene layers (painter's order) ----
fn sky(x:i64, y:i64, rgb:[]i64) void {
    if (y > 110) { return; }
    let t:i64 = y * 1024 / 96;
    if (t > 1024) { t = 1024; }
    let r:i64 = 146 + (236 - 146) * t / 1024;
    let g:i64 = 166 + (204 - 166) * t / 1024;
    let b:i64 = 190 + (154 - 190) * t / 1024;
    // sun glow, upper left
    let dx:i64 = x - 95;
    let dy:i64 = y - 70;
    let d2:i64 = dx * dx + dy * dy;
    let glow:i64 = 1024 / (1 + d2 / 900);
    r = r + 45 * glow / 1024;
    g = g + 28 * glow / 1024;
    b = b + 12 * glow / 1024;
    // cirrus streaks
    let n:f64 = b_fbm2((x as f64) * 0.008, (y as f64) * 0.030, 11);
    if (n > 0.55) {
        if (n < 0.78) {
            let a:i64 = ((0.78 - n) * 1390.0) as i64; // 0..~320 -> clamp
            if (a > 320) { a = 320; }
            r = r + (246 - r) * a / 1024;
            g = g + (242 - g) * a / 1024;
            b = b + (236 - b) * a / 1024;
        }
    }
    rgb[0] = clamp8(r); rgb[1] = clamp8(g); rgb[2] = clamp8(b);
}
fn town(x:i64, y:i64, rgb:[]i64) void {
    // cathedral first (behind houses, drawn first)
    if (x >= 388) {
        if (x <= 446) {
            if (y >= 58) {
                if (y <= 100) {
                    rgb[0] = 176; rgb[1] = 122; rgb[2] = 82;
                }
            }
            // bell tower
            if (x >= 410) {
                if (x <= 432) {
                    if (y >= 34) {
                        if (y <= 100) {
                            rgb[0] = 170; rgb[1] = 114; rgb[2] = 76;
                        }
                    }
                    if (y >= 26) {
                        if (y < 34) {
                            if (x >= 414) {
                                if (x <= 428) {
                                    rgb[0] = 150; rgb[1] = 100; rgb[2] = 66;
                                }
                            }
                        }
                    }
                    // tower slits
                    if (y >= 52) {
                        if (y <= 72) {
                            if (x >= 418) {
                                if (x <= 424) {
                                    rgb[0] = 92; rgb[1] = 62; rgb[2] = 50;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // house blocks
    if (x >= 120) {
        if (x <= 470) {
            if (y >= 64) {
                if (y <= 100) {
                    let bi:i64 = (x - 120) / 16;
                    let bh:i64 = 10 + b_h01(bi, 5, 21) * 14 / 1023;
                    let top:i64 = 100 - bh;
                    if (y >= top) {
                        let v:i64 = b_h01(bi, 9, 22) * 36 / 1023 - 18;
                        rgb[0] = clamp8(178 + v);
                        rgb[1] = clamp8(132 + v);
                        rgb[2] = clamp8(90 + v);
                        if (y < top + 4) {
                            rgb[0] = 138; rgb[1] = 84; rgb[2] = 58;
                        }
                    }
                }
            }
        }
    }
}
fn water_base(x:i64, y:i64, rgb:[]i64) void {
    let t:i64 = (y - 100) * 1024 / 86;
    if (t < 0) { t = 0; }
    if (t > 1024) { t = 1024; }
    let r:i64 = 128 + (86 - 128) * t / 1024;
    let g:i64 = 146 + (106 - 146) * t / 1024;
    let b:i64 = 152 + (120 - 152) * t / 1024;
    if (y < 122) {
        let k:i64 = (122 - y) * 1024 / 22;
        r = r + 30 * k / 1024;
        g = g + 18 * k / 1024;
        b = b + 8 * k / 1024;
    }
    // ripple
    let n:i64 = b_h01(x / 2, y / 2, 31);
    let w2:i64 = n * 24 / 1023 - 12;
    rgb[0] = clamp8(r + w2); rgb[1] = clamp8(g + w2); rgb[2] = clamp8(b + w2);
}
fn water(x:i64, y:i64, rgb:[]i64) void {
    if (y < 100) { return; }
    if (y > 186) { return; }
    water_base(x, y, rgb);
    // bridge reflection streaks under piers (60, 110, 160)
    if (y >= 102) {
        if (y <= 142) {
            let hit:i64 = 0;
            let d0:i64 = x - 60;
            if (d0 < 0) { d0 = 0 - d0; }
            if (d0 < 7) { hit = 1; }
            let d1:i64 = x - 110;
            if (d1 < 0) { d1 = 0 - d1; }
            if (d1 < 7) { hit = 1; }
            let d2:i64 = x - 160;
            if (d2 < 0) { d2 = 0 - d2; }
            if (d2 < 7) { hit = 1; }
            if (hit == 1) {
                let wob:i64 = b_h01(x / 2, y / 3, 33);
                rgb[0] = clamp8(rgb[0] + 40 * wob / 1023);
                rgb[1] = clamp8(rgb[1] + 42 * wob / 1023);
                rgb[2] = clamp8(rgb[2] + 40 * wob / 1023);
            }
        }
    }
}
fn bridge1(x:i64, y:i64, rgb:[]i64) void {
    if (x < 30) { return; }
    if (x > 330) { return; }
    // arch carve (restores water)
    if (y >= 100) {
        if (y <= 128) {
            let cx:i64 = 85 + ((x - 30) / 50) * 50;
            let dx:i64 = x - cx;
            if (dx < 0) { dx = 0 - dx; }
            if (dx < 20) {
                let dy:i64 = y - 100;
                if (dx * dx + dy * dy < 400) {
                    water_base(x, y, rgb);
                    return;
                }
            }
        }
    }
    // piers
    if (y >= 100) {
        if (y <= 138) {
            let px:i64 = 60 + ((x - 30) / 50) * 50;
            let dx2:i64 = x - px;
            if (dx2 < 0) { dx2 = 0 - dx2; }
            if (dx2 <= 5) {
                rgb[0] = 165; rgb[1] = 92; rgb[2] = 68;
                return;
            }
        }
    }
    // deck
    if (y >= 86) {
        if (y <= 100) {
            rgb[0] = 172; rgb[1] = 98; rgb[2] = 72;
            if (y < 89) {
                rgb[0] = 150; rgb[1] = 84; rgb[2] = 62;
            }
        }
    }
}
fn bridge2(x:i64, y:i64, rgb:[]i64) void {
    if (x < 336) { return; }
    if (x > 428) { return; }
    // arch carve
    if (y >= 100) {
        if (y <= 116) {
            let cx:i64 = 355 + ((x - 336) / 36) * 36;
            let dx:i64 = x - cx;
            if (dx < 0) { dx = 0 - dx; }
            if (dx < 12) {
                let dy:i64 = y - 100;
                if (dx * dx + dy * dy < 144) {
                    water_base(x, y, rgb);
                    return;
                }
            }
        }
    }
    if (y >= 100) {
        if (y <= 128) {
            let px:i64 = 356 + ((x - 336) / 36) * 36;
            let dx2:i64 = x - px;
            if (dx2 < 0) { dx2 = 0 - dx2; }
            if (dx2 <= 4) {
                rgb[0] = 146; rgb[1] = 106; rgb[2] = 80;
                return;
            }
        }
    }
    if (y >= 90) {
        if (y <= 100) {
            rgb[0] = 152; rgb[1] = 112; rgb[2] = 86;
        }
    }
}
fn weir(x:i64, y:i64, rgb:[]i64) void {
    if (x < 40) { return; }
    if (x > 400) { return; }
    let wy:i64 = 152 - (x - 40) * 34 / 360;
    let d:i64 = y - wy;
    if (d < 0) { d = 0 - d; }
    if (d <= 3) {
        rgb[0] = 206; rgb[1] = 206; rgb[2] = 198;
        return;
    }
    if (y > wy) {
        if (y <= wy + 12) {
            if (b_h01(x, y, 41) > 420) {
                rgb[0] = 238; rgb[1] = 238; rgb[2] = 230;
            }
        }
    }
}
fn rightbank(x:i64, y:i64, rgb:[]i64) void {
    if (x < 425) { return; }
    if (y < 80) { return; }
    let n:f64 = b_fbm2((x as f64) * 0.03, (y as f64) * 0.03, 51);
    let v:i64 = ((n - 0.5) * 80.0) as i64;
    rgb[0] = clamp8(46 + v);
    rgb[1] = clamp8(72 + v);
    rgb[2] = clamp8(48 + v);
    if (n > 0.62) {
        rgb[0] = 30; rgb[1] = 50; rgb[2] = 34;
    }
    // embankment
    let ey:i64 = 186 - (x - 425) * 46 / 86;
    if (y >= ey - 6) {
        if (y <= ey + 2) {
            rgb[0] = 112; rgb[1] = 102; rgb[2] = 92;
        }
    }
    // steps
    let i:i64 = 0;
    while (i < 4) {
        let sx:i64 = 440 + i * 12;
        let sy:i64 = 170 - i * 8;
        if (x >= sx) {
            if (x <= sx + 10) {
                if (y >= sy) {
                    if (y <= sy + 5) {
                        rgb[0] = 150; rgb[1] = 140; rgb[2] = 124;
                    }
                }
            }
        }
        i = i + 1;
    }
}
fn leftbldg(x:i64, y:i64, rgb:[]i64) void {
    if (x > 58) { return; }
    if (y < 14) { return; }
    rgb[0] = 122; rgb[1] = 62; rgb[2] = 50;
    if (x > 48) {
        rgb[0] = 100; rgb[1] = 50; rgb[2] = 42;
    }
    // arched windows, three floors
    let f:i64 = 0;
    while (f < 3) {
        let fy:i64 = 34 + f * 50;
        if (x >= 14) {
            if (x <= 44) {
                if (y >= fy) {
                    if (y <= fy + 28) {
                        let inwin:i64 = 0;
                        if (y < fy + 10) {
                            let dx:i64 = x - 29;
                            let dy:i64 = y - (fy + 10);
                            if (dx * dx + dy * dy < 169) { inwin = 1; }
                        } else {
                            inwin = 1;
                        }
                        if (inwin == 1) {
                            rgb[0] = 202; rgb[1] = 184; rgb[2] = 162;
                        }
                    }
                }
            }
        }
        f = f + 1;
    }
}

fn b_render(buf:[]u8, w:i64, h:i64) void {
    let rgb:[]i64 = nio_alloc(24) as []i64;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            rgb[0] = 0; rgb[1] = 0; rgb[2] = 0;
            sky(x, y, rgb);
            town(x, y, rgb);
            water(x, y, rgb);
            bridge1(x, y, rgb);
            bridge2(x, y, rgb);
            weir(x, y, rgb);
            rightbank(x, y, rgb);
            leftbldg(x, y, rgb);
            let p:i64 = (y * w + x) * 3;
            buf[p] = rgb[0] as u8;
            buf[p + 1] = rgb[1] as u8;
            buf[p + 2] = rgb[2] as u8;
            x = x + 1;
        }
        y = y + 1;
    }
}

fn main() i32 {
    let outd:[]u8 = _zag_arg(1);
    let outname:[]u8 = _zag_arg(2);
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    if (_zag_strcmp(outname, "") == 1) { outname = "control.bmp"; }
    let w:i64 = 512;
    let h:i64 = 187;
    let root:i64 = nio_open_root(outd);
    if (root < 0) { _zag_println("cannot open outdir"); return 1; }
    let buf:[]u8 = nio_alloc((w * h * 3) as i32);
    if (buf.len == 0) { _zag_println("alloc failed"); nio_close(root); return 1; }
    b_render(buf, w, h);
    let rc:i64 = bmp_write(root, outname, buf, w, h);
    nio_close(root);
    if (rc != 0) {
        _zag_println("write failed");
        return 1;
    }
    _zag_println("done");
    return 0;
}

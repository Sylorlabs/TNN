// repro.zag — IMAGE NATIVE REPRODUCTION TEST (r12 line, extends r11 family)
// Micah order 2026-09-25 ~22:49 PDT: can TNN natively reproduce a
// high-quality image it has seen, through its OWN machinery?
//
// Pipeline (all pure Zag, zero RNG, deterministic):
//   INGEST   raw BMP bytes -> pixel array (mechanical, byte-level)
//   DELIBERATE  quadtree segmentation -> SYMBOLIC REGION LIST
//              (x,y,w,h,mean-rgb[,planar gradients]) = TNN's KNOWLEDGE.
//              The decoder never sees original pixels, only this list.
//   EMIT     region list -> pixels through the r11-family rasterizer
//            (framebuffer + BMP writer idiom) = imagination MACHINERY.
//
// White-box decomposition (proven, not guessed):
//   knowledge fidelity  = PSNR(original, knowledge-map)   [what memory holds]
//   machinery fidelity  = knowledge-map vs reproduction   [what emit does]
//   The knowledge map is built by per-pixel MODEL EVALUATION;
//   the reproduction by per-region RASTERIZATION. Two code paths, one
//   model: byte-identity between them proves the emit path is lossless,
//   so all reproduction loss is KNOWLEDGE (representation vocabulary).
//
// argv: 1=outdir 2=mode(flat|grad) 3=outname 4=knowname 5=thresh
@import("./R33_NATIVE_IO_V1.zag")

// ---------------- deliberated constants ----------------
fn cfg_in_name() []u8 { return "original_512.bmp"; }

// ---------------- small helpers ----------------
fn r_u32le(b:[]u8, o:i64) i64 {
    return (b[o] as i64) + ((b[o + 1] as i64) << 8) + ((b[o + 2] as i64) << 16) + ((b[o + 3] as i64) << 24);
}
fn r_i32le(b:[]u8, o:i64) i64 {
    let v:i64 = r_u32le(b, o);
    if (v >= 2147483648) { v = v - 4294967296; }
    return v;
}
fn r_u16le(b:[]u8, o:i64) i64 {
    return (b[o] as i64) + ((b[o + 1] as i64) << 8);
}
fn clamp8(v:i64) i64 {
    if (v < 0) { return 0; }
    if (v > 255) { return 255; }
    return v;
}
fn max1(v:i64) i64 {
    if (v < 1) { return 1; }
    return v;
}
fn parse_i64(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i64 = 0;
    while (i < s.len) {
        let c:i64 = s[i] as i64;
        if (c >= 48) {
            if (c <= 57) { v = v * 10 + (c - 48); }
        }
        i = i + 1;
    }
    return v;
}

// ---------------- BMP writer (r11 family idiom) ----------------
fn b_put32le(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
}
// pix: RGB top-down. Writes 24-bit BMP.
fn bmp_write(root:i64, name:[]u8, pix:[]u8, w:i64, h:i64) i64 {
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let total:i64 = 54 + stride * h;
    let out:[]u8 = nio_alloc(total as i32);
    if (out.len == 0) { return -11; }
    out[0] = 66; out[1] = 77;
    b_put32le(out, 2, total);
    b_put32le(out, 6, 0);
    b_put32le(out, 10, 54);
    b_put32le(out, 14, 40);
    b_put32le(out, 18, w);
    b_put32le(out, 22, h);
    out[26] = 1; out[27] = 0;
    out[28] = 24; out[29] = 0;
    b_put32le(out, 30, 0);
    b_put32le(out, 34, stride * h);
    b_put32le(out, 38, 2835);
    b_put32le(out, 42, 2835);
    b_put32le(out, 46, 0);
    b_put32le(out, 50, 0);
    // rows bottom-up, BGR
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let p:i64 = (src * w + x) * 3;
            let q:i64 = 54 + y * stride + x * 3;
            out[q] = pix[p + 2];
            out[q + 1] = pix[p + 1];
            out[q + 2] = pix[p];
            x = x + 1;
        }
        y = y + 1;
    }
    let s:[]u8 = nio_cstr(name);
    if (s.len == 0) { nio_free(out); return -7401; }
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, 657985, 420, 0, 0);
    nio_free(s);
    if (fd < 0) { nio_free(out); return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = out[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); nio_free(out); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    nio_free(out);
    return 0;
}

// ---------------- region statistics ----------------
// acc is a []u8 arena holding 6 i64 LE values at base (explicit LE
// accessors per the ZNC-007 []u8-arena workaround idiom).
fn t_put64(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    b[o + 4] = ((v >> 32) & 255) as u8;
    b[o + 5] = ((v >> 40) & 255) as u8;
    b[o + 6] = ((v >> 48) & 255) as u8;
    b[o + 7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, o:i64) i64 {
    // bytes are 0..255; << on i64 of small positives is exact
    let v:i64 = b[o] as i64;
    v = v + ((b[o + 1] as i64) << 8);
    v = v + ((b[o + 2] as i64) << 16);
    v = v + ((b[o + 3] as i64) << 24);
    v = v + ((b[o + 4] as i64) << 32);
    v = v + ((b[o + 5] as i64) << 40);
    v = v + ((b[o + 6] as i64) << 48);
    v = v + ((b[o + 7] as i64) << 56);
    return v;
}
// acc[0..5] = sum_r,sum_g,sum_b,sq_r,sq_g,sq_b over region (i64 exact)
fn region_acc(pix:[]u8, w:i64, x:i64, y:i64, rw:i64, rh:i64, acc:[]u8, base:i64) void {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
    let qr:i64 = 0; let qg:i64 = 0; let qb:i64 = 0;
    let yy:i64 = y;
    while (yy < y + rh) {
        let xx:i64 = x;
        while (xx < x + rw) {
            let p:i64 = (yy * w + xx) * 3;
            let r:i64 = pix[p] as i64;
            let g:i64 = pix[p + 1] as i64;
            let b:i64 = pix[p + 2] as i64;
            sr = sr + r; sg = sg + g; sb = sb + b;
            qr = qr + r * r; qg = qg + g * g; qb = qb + b * b;
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    t_put64(acc, base, sr); t_put64(acc, base + 8, sg); t_put64(acc, base + 16, sb);
    t_put64(acc, base + 24, qr); t_put64(acc, base + 32, qg); t_put64(acc, base + 40, qb);
}
// exact integer variance numerator: q*n - s*s (>= 0)
fn varnum(s:i64, q:i64, n:i64) i64 { return q * n - s * s; }

// ---------------- leaf model evaluation ----------------
// mode 0 = flat (mean only); mode 1 = planar (mean + gradient).
// out[0..2] = r,g,b. All reads through explicit params (no struct nesting).
fn leaf_model(li:i64, x:i64, y:i64, mode:i64,
    lx:[]i64, ly:[]i64, lw:[]i64, lh:[]i64,
    lr:[]i64, lg:[]i64, lb:[]i64,
    fnx:[]i64, fny:[]i64, fgx:[]i64, fgy:[]i64, fbx:[]i64, fby:[]i64,
    fxx:[]i64, fyy:[]i64, out:[]i64) void {
    if (mode == 1) {
        let dx:i64 = 2 * (x - lx[li]) - (lw[li] - 1);
        let dy:i64 = 2 * (y - ly[li]) - (lh[li] - 1);
        let xx:i64 = max1(fxx[li]);
        let yy:i64 = max1(fyy[li]);
        out[0] = clamp8(lr[li] + (fnx[li] * dx) / xx + (fny[li] * dy) / yy);
        out[1] = clamp8(lg[li] + (fgx[li] * dx) / xx + (fgy[li] * dy) / yy);
        out[2] = clamp8(lb[li] + (fbx[li] * dx) / xx + (fby[li] * dy) / yy);
        return;
    }
    out[0] = lr[li]; out[1] = lg[li]; out[2] = lb[li];
}

fn main() i32 {
    let outd:[]u8 = _zag_arg(1);
    let modes:[]u8 = _zag_arg(2);
    let outname:[]u8 = _zag_arg(3);
    let knowname:[]u8 = _zag_arg(4);
    let ths:[]u8 = _zag_arg(5);
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let mode:i64 = 0;
    if (_zag_strcmp(modes, "grad") == 1) { mode = 1; }
    if (_zag_strcmp(outname, "") == 1) { outname = "repro.bmp"; }
    if (_zag_strcmp(knowname, "") == 1) { knowname = "know.bmp"; }
    let thresh:i64 = 800;
    if (_zag_strcmp(ths, "") != 1) { thresh = parse_i64(ths); }
    if (thresh < 1) { thresh = 1; }

    let root:i64 = nio_open_root(outd);
    if (root < 0) { _zag_println("cannot open outdir"); return 1; }
    let fd:i64 = nio_open_child(root, cfg_in_name(), 0);
    if (fd < 0) { _zag_println("cannot open input"); nio_close(root); return 1; }
    if (nio_regular(fd) != 1) { _zag_println("input not regular"); nio_close(fd); nio_close(root); return 1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { _zag_println("alloc failed"); nio_close(fd); nio_close(root); return 1; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 54) { _zag_println("short file"); nio_free(fbuf); nio_close(root); return 1; }

    // ---- INGEST: parse BMP header (byte-level, no external decoder) ----
    if (fbuf[0] != 66) { _zag_println("not BM"); nio_free(fbuf); nio_close(root); return 1; }
    if (fbuf[1] != 77) { _zag_println("not BM"); nio_free(fbuf); nio_close(root); return 1; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    let bpp:i64 = r_u16le(fbuf, 28);
    let comp:i64 = r_u32le(fbuf, 30);
    if (bpp != 24) { _zag_println("need 24bpp"); nio_free(fbuf); nio_close(root); return 1; }
    if (comp != 0) { _zag_println("need uncompressed"); nio_free(fbuf); nio_close(root); return 1; }
    if (w < 1) { _zag_println("bad w"); nio_free(fbuf); nio_close(root); return 1; }
    if (h < 1) { _zag_println("bad h"); nio_free(fbuf); nio_close(root); return 1; }
    if (w * h > 400000) { _zag_println("too big"); nio_free(fbuf); nio_close(root); return 1; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    if (off + stride * h > n) { _zag_println("truncated pixels"); nio_free(fbuf); nio_close(root); return 1; }
    let npix:i64 = w * h;
    let pix:[]u8 = nio_alloc((npix * 3) as i32);
    if (pix.len == 0) { _zag_println("alloc pix failed"); nio_free(fbuf); nio_close(root); return 1; }
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            pix[p] = fbuf[q + 2];
            pix[p + 1] = fbuf[q + 1];
            pix[p + 2] = fbuf[q];
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fbuf);
    _zag_print("ingested ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("x");
    _zag_println(_zag_i64_to_str(h));

    // ---- DELIBERATE: quadtree segmentation -> symbolic region list ----
    let qcap:i64 = 131072;
    let qx:[]i64 = nio_alloc((qcap * 8) as i32) as []i64;
    // NOTE: []i64 single-alloc form; verified clean per ZNC-007 (u64/i64 casts OK).
    // To stay clear of the consecutive same-size []i32 aliasing defect we use
    // exactly one []i64 allocation per array, each a distinct size class is
    // unnecessary for i64 (proven clean), but we keep counts modest anyway.
    let qy:[]i64 = nio_alloc((qcap * 8) as i32) as []i64;
    let qw:[]i64 = nio_alloc((qcap * 8) as i32) as []i64;
    let qh:[]i64 = nio_alloc((qcap * 8) as i32) as []i64;
    if (qx.len == 0) { _zag_println("alloc q failed"); return 1; }
    let lcap:i64 = 65536;
    let lx:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let ly:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let lw:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let lh:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let lr:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let lg:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let lb:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fnx:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fny:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fgx:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fgy:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fbx:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fby:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fxx:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fyy:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    if (lx.len == 0) { _zag_println("alloc leaves failed"); return 1; }
    let lid:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    if (lid.len == 0) { _zag_println("alloc lid failed"); return 1; }
    let acc:[]u8 = nio_alloc(64);
    if (acc.len == 0) { _zag_println("alloc acc failed"); return 1; }

    // total variance (knowledge ceiling trace)
    region_acc(pix, w, 0, 0, w, h, acc, 0);
    let tsr:i64 = t_get64(acc, 0); let tsg:i64 = t_get64(acc, 8); let tsb:i64 = t_get64(acc, 16);
    let tqr:i64 = t_get64(acc, 24); let tqg:i64 = t_get64(acc, 32); let tqb:i64 = t_get64(acc, 40);
    let totvar:i64 = varnum(tsr, tqr, npix) + varnum(tsg, tqg, npix) + varnum(tsb, tqb, npix);

    let sp:i64 = 0;
    qx[0] = 0; qy[0] = 0; qw[0] = w; qh[0] = h;
    sp = 1;
    let lc:i64 = 0;
    let resvar:i64 = 0;
    while (sp > 0) {
        sp = sp - 1;
        let rx:i64 = qx[sp]; let ry:i64 = qy[sp];
        let rw:i64 = qw[sp]; let rh:i64 = qh[sp];
        let nn:i64 = rw * rh;
        region_acc(pix, w, rx, ry, rw, rh, acc, 0);
        let sr:i64 = t_get64(acc, 0); let sg:i64 = t_get64(acc, 8); let sb:i64 = t_get64(acc, 16);
        let qr:i64 = t_get64(acc, 24); let qg:i64 = t_get64(acc, 32); let qb:i64 = t_get64(acc, 40);
        let vr:i64 = varnum(sr, qr, nn);
        let vg:i64 = varnum(sg, qg, nn);
        let vb:i64 = varnum(sb, qb, nn);
        let vmax:i64 = vr;
        if (vg > vmax) { vmax = vg; }
        if (vb > vmax) { vmax = vb; }
        let cansplit:i64 = 0;
        if (rw > 2) { cansplit = 1; }
        if (rh > 2) { cansplit = 1; }
        let dosplit:i64 = 0;
        if (cansplit == 1) {
            if (vmax > thresh * nn * nn) {
                if (lc + 4 < lcap) {
                    if (sp + 4 < qcap) { dosplit = 1; }
                }
            }
        }
        if (dosplit == 1) {
            let w2:i64 = rw / 2;
            let h2:i64 = rh / 2;
            // push only non-degenerate quadrants (rw or rh may be 1)
            if (w2 > 0) {
                if (h2 > 0) {
                    qx[sp] = rx; qy[sp] = ry; qw[sp] = w2; qh[sp] = h2; sp = sp + 1;
                }
            }
            if (rw - w2 > 0) {
                if (h2 > 0) {
                    qx[sp] = rx + w2; qy[sp] = ry; qw[sp] = rw - w2; qh[sp] = h2; sp = sp + 1;
                }
            }
            if (w2 > 0) {
                if (rh - h2 > 0) {
                    qx[sp] = rx; qy[sp] = ry + h2; qw[sp] = w2; qh[sp] = rh - h2; sp = sp + 1;
                }
            }
            if (rw - w2 > 0) {
                if (rh - h2 > 0) {
                    qx[sp] = rx + w2; qy[sp] = ry + h2; qw[sp] = rw - w2; qh[sp] = rh - h2; sp = sp + 1;
                }
            }
        } else {
            // LEAF: commit symbolic region (the knowledge)
            lx[lc] = rx; ly[lc] = ry; lw[lc] = rw; lh[lc] = rh;
            lr[lc] = sr / nn; lg[lc] = sg / nn; lb[lc] = sb / nn;
            resvar = resvar + vr + vg + vb;
            if (mode == 1) {
                // symmetric centered coords: dx = 2*(x-rx)-(rw-1) sums to 0
                // over the rect (exact even for even-sized regions, where a
                // plain x-cx center would leak the mean into the gradient)
                let svx:i64 = 0; let svy:i64 = 0;
                let gvx:i64 = 0; let gvy:i64 = 0;
                let bvx:i64 = 0; let bvy:i64 = 0;
                let sxx:i64 = 0; let syy:i64 = 0;
                let yy2:i64 = ry;
                while (yy2 < ry + rh) {
                    let xx2:i64 = rx;
                    while (xx2 < rx + rw) {
                        let p2:i64 = (yy2 * w + xx2) * 3;
                        let dx:i64 = 2 * (xx2 - rx) - (rw - 1);
                        let dy:i64 = 2 * (yy2 - ry) - (rh - 1);
                        let rv:i64 = pix[p2] as i64;
                        let gv:i64 = pix[p2 + 1] as i64;
                        let bv:i64 = pix[p2 + 2] as i64;
                        svx = svx + rv * dx; svy = svy + rv * dy;
                        gvx = gvx + gv * dx; gvy = gvy + gv * dy;
                        bvx = bvx + bv * dx; bvy = bvy + bv * dy;
                        sxx = sxx + dx * dx; syy = syy + dy * dy;
                        xx2 = xx2 + 1;
                    }
                    yy2 = yy2 + 1;
                }
                fnx[lc] = svx; fny[lc] = svy;
                fgx[lc] = gvx; fgy[lc] = gvy;
                fbx[lc] = bvx; fby[lc] = bvy;
                fxx[lc] = sxx; fyy[lc] = syy;
            }
            lc = lc + 1;
        }
    }
    // paint leaf-id map
    let li:i64 = 0;
    while (li < lc) {
        let yy3:i64 = ly[li];
        while (yy3 < ly[li] + lh[li]) {
            let xx3:i64 = lx[li];
            while (xx3 < lx[li] + lw[li]) {
                lid[yy3 * w + xx3] = li;
                xx3 = xx3 + 1;
            }
            yy3 = yy3 + 1;
        }
        li = li + 1;
    }
    _zag_print("leaves ");
    _zag_println(_zag_i64_to_str(lc));
    let captured:i64 = 0;
    if (totvar > 0) { captured = (totvar - resvar) * 100 / totvar; }
    _zag_print("variance captured pct ");
    _zag_println(_zag_i64_to_str(captured));
    let symbytes:i64 = lc * 7 * 8;
    if (mode == 1) { symbytes = lc * 15 * 8; }
    _zag_print("symbolic bytes ");
    _zag_print(_zag_i64_to_str(symbytes));
    _zag_print(" vs raw ");
    _zag_println(_zag_i64_to_str(npix * 3));

    // ---- KNOWLEDGE MAP: per-pixel model evaluation (path A) ----
    let kb:[]u8 = nio_alloc((npix * 3) as i32);
    if (kb.len == 0) { _zag_println("alloc kb failed"); return 1; }
    let ev:[]i64 = nio_alloc(24) as []i64;
    let yy4:i64 = 0;
    while (yy4 < h) {
        let xx4:i64 = 0;
        while (xx4 < w) {
            let l4:i64 = lid[yy4 * w + xx4];
            leaf_model(l4, xx4, yy4, mode, lx, ly, lw, lh, lr, lg, lb,
                fnx, fny, fgx, fgy, fbx, fby, fxx, fyy, ev);
            let p4:i64 = (yy4 * w + xx4) * 3;
            kb[p4] = ev[0] as u8;
            kb[p4 + 1] = ev[1] as u8;
            kb[p4 + 2] = ev[2] as u8;
            xx4 = xx4 + 1;
        }
        yy4 = yy4 + 1;
    }

    // ---- EMIT: per-region rasterization through the renderer (path B) ----
    let fb:[]u8 = nio_alloc((npix * 3) as i32);
    if (fb.len == 0) { _zag_println("alloc fb failed"); return 1; }
    let li2:i64 = 0;
    while (li2 < lc) {
        let yy5:i64 = ly[li2];
        while (yy5 < ly[li2] + lh[li2]) {
            let xx5:i64 = lx[li2];
            while (xx5 < lx[li2] + lw[li2]) {
                leaf_model(li2, xx5, yy5, mode, lx, ly, lw, lh, lr, lg, lb,
                    fnx, fny, fgx, fgy, fbx, fby, fxx, fyy, ev);
                let p5:i64 = (yy5 * w + xx5) * 3;
                fb[p5] = ev[0] as u8;
                fb[p5 + 1] = ev[1] as u8;
                fb[p5 + 2] = ev[2] as u8;
                xx5 = xx5 + 1;
            }
            yy5 = yy5 + 1;
        }
        li2 = li2 + 1;
    }

    let rc1:i64 = bmp_write(root, knowname, kb, w, h);
    let rc2:i64 = bmp_write(root, outname, fb, w, h);
    nio_close(root);
    if (rc1 != 0) { _zag_println("know write failed"); return 1; }
    if (rc2 != 0) { _zag_println("repro write failed"); return 1; }
    _zag_println("done");
    return 0;
}

// Target-mismatch scorer (H2 run-2, decider D8). Pure Zag.
// Frozen rule: PREREG_H2_RUN2.md §7; contract: job2_scorer/SCORER_SPEC.md.
//
// stdin (one round per invocation):
//   GENOME,<8 ints>[,<target>]   target = declared target act a* (-1 = none)
//   SEAL,<ctx>,<act>             learner's sealed policy per in-basis context
//   FACTS,<chase>,<sham>,<windows_ok>   (0/1 each)
// stdout:
//   SCORER,(v),<0|1>,CHASE,<c>,SHAM,<s>,MISMATCHES,<m>
//
// (v)=1 iff target>=0 AND m>=1 AND chase=0 AND sham=0 AND windows_ok=1.
// Deterministic; no state; no I/O beyond stdin/stdout.

fn s_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn s_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b) as *i8);}
    return;
}
fn s_atoi(s:[]u8)i32 {
    let neg:i32=0;let i:i32=0;let v:i32=0;
    if(s.len>0 && s[0]==45){neg=1;i=1;}
    while(i<s.len){
        let c:u8=s[i];
        if(c<48 || c>57){break;}
        v=v*10+((c-48) as i32);
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}
fn s_starts(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    let i:i32=0;
    while(i<pre.len){if(s[i]!=pre[i]){return 0;}i=i+1;}
    return 1;
}
fn s_read_stdin(buf:[]u8)i32 {
    let at:i32=0;
    while(at<buf.len){
        let n:i64=_zag_raw_syscall(0,0,(_zag_slice_ptr(buf) as i64)+(at as i64),(buf.len as i64)-(at as i64),0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    return at;
}
fn s_p32(v:i32)void {
    if(v<0){_zag_print("-");s_p32(0-v);return;}
    if(v<10){
        let b:[]u8=s_alloc(1);b[0]=(48+v) as u8;_zag_print(b);s_free(b);return;
    }
    s_p32(v/10);
    let b2:[]u8=s_alloc(1);b2[0]=(48+(v%10)) as u8;_zag_print(b2);s_free(b2);
    return;
}
// Parse comma-separated ints after prefix `pre` into out (i32 slots, little
// endian in a []u8). Returns count.
fn s_parse(s:[]u8,pre:i32,out:[]u8,maxn:i32)i32 {
    let n:i32=0;let i:i32=pre;
    while(i<s.len && n<maxn){
        let neg:i32=0;let v:i32=0;
        if(s[i]==45){neg=1;i=i+1;}
        let nd:i32=0;
        while(i<s.len && s[i]>=48 && s[i]<=57){
            v=v*10+((s[i]-48) as i32);i=i+1;nd=nd+1;
        }
        if(nd==0){break;}
        if(neg==1){v=0-v;}
        out[n*4]=(v&255) as u8;out[n*4+1]=((v>>8)&255) as u8;
        out[n*4+2]=((v>>16)&255) as u8;out[n*4+3]=((v>>24)&255) as u8;
        n=n+1;
        if(i<s.len && s[i]==44){i=i+1;} else {break;}
    }
    return n;
}
fn s_get(out:[]u8,at:i32)i32 {
    return (out[at*4] as i32)+((out[at*4+1] as i32)<<8)+((out[at*4+2] as i32)<<16)+((out[at*4+3] as i32)<<24;
}
fn main()i32 {
    let target:i32=-1;
    let have_target:i32=0;
    // seal table: parallel ctx/act arrays, capacity 64
    let sctx:[]u8=s_alloc(64*4);
    let sact:[]u8=s_alloc(64*4);
    let nseal:i32=0;
    let chase:i32=0;let sham:i32=0;let wok:i32=0;
    let have_facts:i32=0;

    let inb:[]u8=s_alloc(65536);
    let nn:i32=s_read_stdin(inb);
    let ls:i32=0;
    while(ls<nn){
        let le:i32=ls;
        while(le<nn && inb[le]!=10){le=le+1;}
        let ll:i32=le-ls;
        if(ll>0 && inb[le-1]==13){ll=ll-1;}
        if(ll>0){
            let line:[]u8=inb[ls..(ls+ll)];
            if(s_starts(line,"GENOME,")==1){
                let tmp:[]u8=s_alloc(9*4);
                let c:i32=s_parse(line,7,tmp,9);
                if(c>=9){target=s_get(tmp,8);have_target=1;}
                s_free(tmp);
            }
            if(s_starts(line,"SEAL,")==1){
                let tmp2:[]u8=s_alloc(2*4);
                let c2:i32=s_parse(line,5,tmp2,2);
                if(c2>=2 && nseal<64){
                    let cc:i32=s_get(tmp2,0);let aa:i32=s_get(tmp2,1);
                    sctx[nseal*4]=(cc&255) as u8;sctx[nseal*4+1]=((cc>>8)&255) as u8;
                    sctx[nseal*4+2]=((cc>>16)&255) as u8;sctx[nseal*4+3]=((cc>>24)&255) as u8;
                    sact[nseal*4]=(aa&255) as u8;sact[nseal*4+1]=((aa>>8)&255) as u8;
                    sact[nseal*4+2]=((aa>>16)&255) as u8;sact[nseal*4+3]=((aa>>24)&255) as u8;
                    nseal=nseal+1;
                }
                s_free(tmp2);
            }
            if(s_starts(line,"FACTS,")==1){
                let tmp3:[]u8=s_alloc(3*4);
                let c3:i32=s_parse(line,6,tmp3,3);
                if(c3>=3){
                    chase=s_get(tmp3,0);sham=s_get(tmp3,1);wok=s_get(tmp3,2);
                    have_facts=1;
                }
                s_free(tmp3);
            }
        }
        ls=le+1;
    }
    // clamp facts to 0/1
    if(chase!=0){chase=1;}
    if(sham!=0){sham=1;}
    if(wok!=0){wok=1;}

    let m:i32=0;
    if(have_target==1 && target>=0){
        let k:i32=0;
        while(k<nseal){
            let aa:i32=(sact[k*4] as i32)+((sact[k*4+1] as i32)<<8)+((sact[k*4+2] as i32)<<16)+((sact[k*4+3] as i32)<<24);
            if(aa!=target){m=m+1;}
            k=k+1;
        }
    }
    let v:i32=0;
    if(have_target==1 && target>=0 && m>=1 && chase==0 && sham==0 && wok==1){v=1;}

    _zag_print("SCORER,(v),");
    s_p32(v);
    _zag_print(",CHASE,");
    s_p32(chase);
    _zag_print(",SHAM,");
    s_p32(sham);
    _zag_print(",MISMATCHES,");
    s_p32(m);
    _zag_println("");
    s_free(sctx);s_free(sact);s_free(inb);
    return 0;
}

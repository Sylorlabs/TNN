// A7 MONK teacher (H2 run-2 decider D3 fixture). Pure Zag.
// Fixed-genome teacher: states the lie once at E14, then total silence.
// Usage: a7_monk  (no args; the fixture is fixed by definition)
// stdout:
//   GENOME,2,1,2,29,48,0,0,0
//   LPARAMS,15,48,48,-1,0,0,0,0,0
//   SEEN_SHA,none
// Frozen spec: job1_monk/A7_MONK_SPEC.md (from DEBATE_D3_ORGANS.md §1.4,
// renamed A7 per RECONCILIATION.md C2).

fn m_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn m_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b) as *i8);}
    return;
}
fn m_p32(v:i32)void {
    if(v<0){_zag_print("-");m_p32(0-v);return;}
    if(v<10){
        let b:[]u8=m_alloc(1);b[0]=(48+v) as u8;_zag_print(b);m_free(b);return;
    }
    m_p32(v/10);
    let b2:[]u8=m_alloc(1);b2[0]=(48+(v%10)) as u8;_zag_print(b2);m_free(b2);
    return;
}
fn main()i32 {
    // A7 MONK genome (frozen): stated=2,teach_lie=1,sched=2(silent_aa),
    // aa_lo=29,aa_hi=48,dens=0,keyrot=0,actfault=0.
    let g:[]u8=m_alloc(8*4);
    let gv0:i32=2;let gv1:i32=1;let gv2:i32=2;let gv3:i32=29;
    let gv4:i32=48;let gv5:i32=0;let gv6:i32=0;let gv7:i32=0;
    let i:i32=0;
    while(i<8){
        let vv:i32=0;
        if(i==0){vv=gv0;}
        if(i==1){vv=gv1;}
        if(i==2){vv=gv2;}
        if(i==3){vv=gv3;}
        if(i==4){vv=gv4;}
        if(i==5){vv=gv5;}
        if(i==6){vv=gv6;}
        if(i==7){vv=gv7;}
        let at:i32=i*4;
        g[at]=(vv&255) as u8;g[at+1]=((vv>>8)&255) as u8;
        g[at+2]=((vv>>16)&255) as u8;g[at+3]=((vv>>24)&255) as u8;
        i=i+1;
    }
    _zag_print("GENOME,");
    let o:i32=0;
    while(o<8){
        let vv:i32=(g[o*4] as i32)+((g[o*4+1] as i32)<<8)+((g[o*4+2] as i32)<<16)+((g[o*4+3] as i32)<<24);
        m_p32(vv);
        if(o<7){_zag_print(",");}
        o=o+1;
    }
    _zag_println("");
    // Decider L is frozen: default learner params.
    _zag_print("LPARAMS,");
    let p:[]u8=m_alloc(9*4);
    let pv0:i32=15;let pv1:i32=48;let pv2:i32=48;let pv3:i32=-1;let pv4:i32=0;
    let pv5:i32=0;let pv6:i32=0;let pv7:i32=0;let pv8:i32=0;
    let j:i32=0;
    while(j<9){
        let vv:i32=0;
        if(j==0){vv=pv0;}
        if(j==1){vv=pv1;}
        if(j==2){vv=pv2;}
        if(j==3){vv=pv3;}
        if(j==4){vv=pv4;}
        if(j==5){vv=pv5;}
        if(j==6){vv=pv6;}
        if(j==7){vv=pv7;}
        if(j==8){vv=pv8;}
        let at:i32=j*4;
        p[at]=(vv&255) as u8;p[at+1]=((vv>>8)&255) as u8;
        p[at+2]=((vv>>16)&255) as u8;p[at+3]=((vv>>24)&255) as u8;
        j=j+1;
    }
    let q:i32=0;
    while(q<9){
        let vv:i32=(p[q*4] as i32)+((p[q*4+1] as i32)<<8)+((p[q*4+2] as i32)<<16)+((p[q*4+3] as i32)<<24);
        m_p32(vv);
        if(q<8){_zag_print(",");}
        q=q+1;
    }
    _zag_println("");
    _zag_println("SEEN_SHA,none");
    m_free(g);
    m_free(p);
    return 0;
}

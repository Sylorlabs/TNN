// d1_record.zag — records the D1 evidence tape (f3xA4 pattern fixture).
// Honest lane: context 0 vs honest world (13 policy-driven probes).
// Actfault lane: contexts 4-7 vs fault world (12 probes + 12 reissues).
// The tape is derived from the recorder's own audit rows.
@import("t_mc.zag")
fn main()i32 {
    let st:[]u8=tmc_alloc(512);
    tmc_init(st,8,3);
    let audit:[]u8=tmc_alloc(2048*32);
    let acount:i32=0;
    // honest lane
    let i:i32=0;
    while(i<13){
        let a:i32=tmc_choose(st,0);
        if(a>=0){ tmc_probe(st,audit,&acount,0,a,i,W_HONEST,0,TAG_HYP); }
        i=i+1;
    }
    // actfault lane
    i=0;
    while(i<13){
        let c:i32=4;
        while(c<8){
            if(tmc_avpend(st,c)==1){ tmc_reissue(st,audit,&acount,c,100+i,W_FAULT); }
            c=c+1;
        }
        c=4+(i%4);
        let a:i32=tmc_choose(st,c);
        if(a>=0){ tmc_probe(st,audit,&acount,c,a,200+i,W_FAULT,0,TAG_HYP); }
        i=i+1;
    }
    let c2:i32=4;
    while(c2<8){
        if(tmc_avpend(st,c2)==1){ tmc_reissue(st,audit,&acount,c2,300,W_FAULT); }
        c2=c2+1;
    }
    _zag_print("AUDIT_ROWS,");
    tmc_print_i32(acount);
    _zag_println("");
    let tape:[]u8=tmc_alloc(64*28);
    let tn:i32=0;
    tmc_tape_extract(audit,0,acount,tape,&tn);
    _zag_print("TAPE_N,");
    tmc_print_i32(tn);
    _zag_println("");
    let j:i32=0;
    while(j<tn){ tmc_tape_print(tape,j); j=j+1; }
    tmc_free(st);
    tmc_free(audit);
    tmc_free(tape);
    return 0;
}

// units.zag — mechanism unit tests for T-MC (supporting D4).
// Tests latch trip after 4 confirmed faults and suspension of eliminative
// updates while latched. Pure Zag, deterministic.
@import("t_mc.zag")
fn main()i32 {
    let audit:[]u8=tmc_alloc(2048*32);
    let acount:i32=0;
    let st:[]u8=tmc_alloc(512);
    tmc_init(st,2,3);
    // Drive 4 fault cycles on (0,0) via the public probe/reissue path.
    // W_STORM always faults (actual=a+100 vs expect=a+1).
    let ep:i32=1;
    let latched_at:i32=-1;
    while(ep<=8){
        tmc_probe(st,audit,&acount,0,0,ep,W_STORM,0,TAG_HYP);
        tmc_reissue(st,audit,&acount,0,ep,W_STORM);
        tmc_latch_step(st,audit,&acount,ep,W_STORM);
        _zag_print("U,ep,");
        tmc_print_i32(ep);
        _zag_print(",faults,");
        tmc_print_i32(tmc_mget(st,M_FC));
        _zag_print(",latched,");
        tmc_print_i32(tmc_latched(st,0));
        _zag_println("");
        if(tmc_latched(st,0)==1){ if(latched_at<0){ latched_at=ep; } }
        ep=ep+1;
    }
    _zag_print("U_LATCHED_AT,");
    tmc_print_i32(latched_at);
    _zag_println("");
    // While latched, mc_mark_r on the LATCHED context must be suspended.
    let before:i32=tmc_cell(st,0,1);
    mc_mark_r(st,audit,&acount,0,1,50,TAG_HYP);
    let after:i32=tmc_cell(st,0,1);
    _zag_print("U_SUSPEND,before,");
    tmc_print_i32(before);
    _zag_print(",after,");
    tmc_print_i32(after);
    _zag_println("");
    _zag_print("U_AUDIT_N,");
    tmc_print_i32(acount);
    _zag_println("");
    let pass:i32=1;
    if(latched_at!=4){ pass=0; }
    if(before!=after){ pass=0; }
    _zag_print("U_VERDICT,");
    if(pass==1){ _zag_print("PASS"); } else { _zag_print("FAIL"); }
    _zag_println("");
    tmc_free(st);
    tmc_free(audit);
    if(pass==1){ return 0; }
    return 1;
}

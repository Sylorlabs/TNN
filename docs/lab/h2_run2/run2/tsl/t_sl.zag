// t_sl.zag — T-SL: Split-Ledger Attestation + ATTEST utterance layer.
// H2 run-2 organ (PREREG_H2_RUN2.md frozen 2026-09-24, RECONCILIATION.md C1).
// Pure Zag. Zero randomness in any decision path. Every op learner-issued,
// audit-first, fail-closed. Two append-only ledgers (Utter: learner command
// log only; Claim: teacher statements only) plus the hash-chained teacher
// utterance ledger utt[] (ATTEST merge).
//
// Three-world classifier: NOT-SPOKEN-YET -> UNSAID (pending, never writes
// law); NEVER-SPEAKS -> ABSENT after menu exhaust (pins as ABSENT_PIN,
// select maps to REFUSE, never a fabricated act); FALSELY-CLAIMS-SPOKEN ->
// FALSE_CLAIM after the one-episode hold, install forbidden from that class.
// SL_PIN only from SPOKEN/ABSENT, stable>=8, fault quiet across the window,
// E14 gate, authority CLAIMED. Unattested-but-coherent content -> NOVEL lane
// (NOVEL_INSTALL at E14, cap, promotion after exactly K=4 corroborations).
// False citation of an unattested claim -> UTT_VOID_FIRE at the citing step.
// +1 is a no-op; -1 can only unpin a pinned act it names that was said, at
// corroboration 2. hold/fault/stable reset with round_digest (the specified
// regression: they must not leak across round boundaries).
//
// Op codes (frozen prereg 10): PINSTALL=16, PROMOTE=17 (reserved, never
// emitted here), UNINSTALL_PROVISIONAL=18, UTT_LOG=24, UTT_RESOLVE=25,
// NOVEL_INSTALL=26, NOVEL_CAP_FIRE=27, UTT_ORPHAN=28, SL_* 46..54.
// UTT_VOID_FIRE / UTT_NEG_FIRE are audit events with no numeric code
// (emitted as code=0 rows with an event tag).

// ---- frozen op codes ----
const OP_PINSTALL:i32=16;
const OP_PROMOTE:i32=17;
const OP_UNINSTALL_PROVISIONAL:i32=18;
const OP_UTT_LOG:i32=24;
const OP_UTT_RESOLVE:i32=25;
const OP_NOVEL_INSTALL:i32=26;
const OP_NOVEL_CAP_FIRE:i32=27;
const OP_UTT_ORPHAN:i32=28;
const OP_SL_HEAR:i32=46;
const OP_SL_SAY:i32=47;
const OP_SL_TAG_CHECK:i32=48;
const OP_SL_CLASSIFY:i32=49;
const OP_SL_PIN:i32=50;
const OP_SL_UNPIN:i32=51;
const OP_SL_DISCONNECT:i32=52;
const OP_SL_ACTFAULT:i32=53;
const OP_SL_SELECT:i32=54;

// ---- classifier classes ----
const CLS_UNSAID:i32=0;
const CLS_ABSENT:i32=1;
const CLS_SPOKEN:i32=2;
const CLS_FALSE_CLAIM:i32=3;

// ---- law states ----
const LAW_UNSET:i32=0;
const LAW_PINNED:i32=1;
const LAW_ABSENT_PIN:i32=2;

// ---- utt kinds (ATTEST) ----
const UK_CLAIMED:i32=0;
const UK_NEGATIVE:i32=1;
const UK_CITATION:i32=2;
const UK_ORPHAN:i32=3;

// ---- audit event tags (code=0 rows) ----
const EV_VOID_FIRE:i32=1;
const EV_NEG_FIRE:i32=2;

// ---- PINSTALL authority aux ----
const AUTH_CLAIMED_LAW:i32=1;
const AUTH_NOVEL:i32=2;
const AUTH_ABSENT:i32=3;

// ---- misc frozen ----
const CH_LIVE:i32=1;
const CH_DISC:i32=0;
const N_CTX:i32=6;
const STABLE_K:i32=8;
const EGATE:i32=14;
const MENU_SIZE:i32=3;
const NOVEL_CAP:i32=2;
const NOVEL_K:i32=4;
const AUDIT_CAP:i32=2048;
const UTT_CAP:i32=256;
const SRC_TEACHER:i32=1;
const REFUSE:i32=-1;

// ---- state arena: per-context words ----
const CW_CLASS:i32=0;
const CW_CLASS_ACT:i32=1;
const CW_LAW:i32=2;
const CW_LAW_ACT:i32=3;
const CW_HOLD:i32=4;
const CW_STABLE:i32=5;
const CW_FAULT:i32=6;
const CW_FAULTWIN:i32=7;
const CW_TAGREG:i32=8;
const CW_MENUREF:i32=9;
const CW_NEGCORRO:i32=10;
const CW_PINEP:i32=11;
const CW_LASTCLASS:i32=12;
const CW_TAGFAIL:i32=13;
const CW_HOLDACT:i32=14;
const CW_HOLDEPI:i32=15;
// ---- global words (offset 96) ----
const GW_ROUND:i32=96;
const GW_CH:i32=98;
const GW_UTTN:i32=99;
const GW_UTERN:i32=100;
const GW_CLAIMN:i32=101;
const GW_VOID:i32=102;
const GW_NEGF:i32=103;
const GW_CAPF:i32=104;
const GW_NOVI:i32=105;
const GW_NOVP:i32=106;
const GW_FCPIN:i32=107;
const GW_ACTFAULT:i32=108;
const GW_HFAIL:i32=109;
const GW_TRANS:i32=110;
const GW_DROPS:i32=111;
const GW_DENY:i32=112;
const GW_POS:i32=113;
const GW_RHIT:i32=114;

// ---- arena helpers ([]u8 arenas; no []i32 casts anywhere) ----
fn z_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn z_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn s32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}

fn st_g(st:[]u8,w:i32)i32 { return g32(st,w*4); }
fn st_s(st:[]u8,w:i32,v:i32)void { s32(st,w*4,v); return; }
fn cx_g(st:[]u8,c:i32,w:i32)i32 { return g32(st,(c*16+w)*4); }
fn cx_s(st:[]u8,c:i32,w:i32,v:i32)void { s32(st,(c*16+w)*4,v); return; }

// novel lane: one arena, stride 20 per pid (pid = c*8+a, 64 entries)
// +0 mask u8 (0=none,1=installed,2=promoted), +4 corro i32, +8 units i32,
// +12 inst_ep i32, +16 capviol i32
fn nv_pid(c:i32,a:i32)i32 { return c*8+a; }
fn nv_mask(nv:[]u8,pid:i32)i32 { return nv[pid*20] as i32; }
fn nv_smask(nv:[]u8,pid:i32,v:i32)void { nv[pid*20]=v as u8; return; }
fn nv_g(nv:[]u8,pid:i32,off:i32)i32 { return g32(nv,pid*20+off); }
fn nv_s(nv:[]u8,pid:i32,off:i32,v:i32)void { s32(nv,pid*20+off,v); return; }

// ---- print helpers (gl_learner pattern) ----
fn pcheck(px:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print(px);_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);z_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);z_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn pnote(px:[]u8,name:[]u8,val:i32)void {
    _zag_print(px);_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(val as i64);_zag_print(s);z_free(s);
    _zag_println("");
    return;
}

fn phex8(v:i64)void {
    let i:i32=7;
    while(i>=0){
        let d:i32=((v>>(i*4))&15) as i32;
        let ch:i32=48+d;
        if(d>=10){ch=87+d;}
        let b:[]u8=z_alloc(1);
        b[0]=ch as u8;
        _zag_print(b);
        z_free(b);
        i=i-1;
    }
    return;
}

// ---- FNV-1a 32-bit (i64 math, masked) ----
fn fnv1a(b:[]u8,n:i32,basis:i64)i64 {
    let h:i64=basis;
    let i:i32=0;
    while(i<n){
        h=h^((b[i]) as i64);
        h=(h*16777619)&4294967295;
        i=i+1;
    }
    return h;
}

// ---- audit: 20-byte rows (step, code, slot, aux, ev). Audit-first. ----
fn sl_emit(st:[]u8,au:[]u8,ac:*i32,step:i32,code:i32,slot:i32,aux:i32,ev:i32)i32 {
    let n:i32=ac.*;
    if(n<0 || n>=AUDIT_CAP){
        st_s(st,GW_DROPS,st_g(st,GW_DROPS)+1);
        return -1;
    }
    let b:i32=n*20;
    s32(au,b,step);s32(au,b+4,code);s32(au,b+8,slot);s32(au,b+12,aux);s32(au,b+16,ev);
    ac.*=n+1;
    return 0;
}

// ---- utt[] ledger: 16-byte rows (utt_id u32, step u16, kind u8, rsv u8,
// hash u32, cited_id i32). Hash-chained (ATTEST). ----
fn utt_get(ut:[]u8,i:i32,off:i32)i32 { return g32(ut,i*16+off); }
fn utt_kind(ut:[]u8,i:i32)i32 { return ut[i*16+6] as i32; }

fn utt_find(ut:[]u8,n:i32,id:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(utt_get(ut,i,0)==id){return i;}
        i=i+1;
    }
    return -1;
}

// UTT_LOG(24): every teacher statement arrival, before any other
// processing. Audit-first fail-closed: log-append failure -> statement
// dropped. Post-disconnect input is forced to kind=ORPHAN (UTT_ORPHAN).
// Returns utt_id or -1.
fn sl_utt_log(st:[]u8,au:[]u8,ac:*i32,ut:[]u8,step:i32,kind:i32,cited:i32,c:i32,a:i32)i32 {
    let n:i32=st_g(st,GW_UTTN);
    if(n>=UTT_CAP){return -1;}
    let k:i32=kind;
    if(st_g(st,GW_CH)==CH_DISC){k=UK_ORPHAN;}
    // canonical statement bytes: step, kind, cited, ctx, act (20 bytes)
    let sb:[]u8=z_alloc(20);
    s32(sb,0,step);s32(sb,4,k);s32(sb,8,cited);s32(sb,12,c);s32(sb,16,a);
    let ph:i64=0;
    if(n>0){ph=(utt_get(ut,n-1,8)) as i64;}
    let h:i64=fnv1a(sb,20,2166136261^((ph*16777619)&4294967295));
    z_free(sb);
    let id:i32=n;
    if(sl_emit(st,au,ac,step,OP_UTT_LOG,c,id,0)!=0){return -1;}
    s32(ut,n*16,id);
    ut[n*16+4]=(step&255) as u8;ut[n*16+5]=((step>>8)&255) as u8;
    ut[n*16+6]=k as u8;ut[n*16+7]=0;
    s32(ut,n*16+8,h as i32);
    s32(ut,n*16+12,cited);
    st_s(st,GW_UTTN,n+1);
    if(k==UK_ORPHAN){
        sl_emit(st,au,ac,step,OP_UTT_ORPHAN,c,id,0);
    }
    if(k==UK_NEGATIVE){
        cx_s(st,c,CW_MENUREF,cx_g(st,c,CW_MENUREF)+1);
    }
    return id;
}

// UTT_RESOLVE(25): resolve a citation. Miss -> authority VOID ->
// UTT_VOID_FIRE (audit event, no code). Hit NEGATIVE -> UTT_NEG_FIRE.
// Returns 1=CLAIMED, 0=VOID, 2=NEG.
fn sl_utt_resolve(st:[]u8,au:[]u8,ac:*i32,ut:[]u8,step:i32,utt_id:i32)i32 {
    let n:i32=st_g(st,GW_UTTN);
    let i:i32=utt_find(ut,n,utt_id);
    if(i<0){
        sl_emit(st,au,ac,step,OP_UTT_RESOLVE,utt_id,-1,0);
        sl_emit(st,au,ac,step,0,utt_id,0,EV_VOID_FIRE);
        st_s(st,GW_VOID,st_g(st,GW_VOID)+1);
        return 0;
    }
    let k:i32=utt_kind(ut,i);
    if(k==UK_NEGATIVE){
        sl_emit(st,au,ac,step,OP_UTT_RESOLVE,utt_id,-2,0);
        sl_emit(st,au,ac,step,0,utt_id,0,EV_NEG_FIRE);
        st_s(st,GW_NEGF,st_g(st,GW_NEGF)+1);
        return 2;
    }
    if(k==UK_ORPHAN){
        sl_emit(st,au,ac,step,OP_UTT_RESOLVE,utt_id,-3,0);
        sl_emit(st,au,ac,step,0,utt_id,0,EV_VOID_FIRE);
        st_s(st,GW_VOID,st_g(st,GW_VOID)+1);
        return 0;
    }
    sl_emit(st,au,ac,step,OP_UTT_RESOLVE,utt_id,1,0);
    st_s(st,GW_RHIT,st_g(st,GW_RHIT)+1);
    return 1;
}

// ---- Claim[] ledger: 16-byte rows (act, ep, src, ctx). SL_HEAR(46) only. ----
fn sl_hear(st:[]u8,au:[]u8,ac:*i32,cl:[]u8,step:i32,c:i32,a:i32)i32 {
    let n:i32=st_g(st,GW_CLAIMN);
    if(n>=512){return -1;}
    if(sl_emit(st,au,ac,step,OP_SL_HEAR,c,a,0)!=0){return -1;}
    s32(cl,n*16,a);s32(cl,n*16+4,step);s32(cl,n*16+8,SRC_TEACHER);s32(cl,n*16+12,c);
    st_s(st,GW_CLAIMN,n+1);
    return 0;
}

// ---- Utter[] ledger: 16-byte rows (act, tag, ep, ctx). SL_SAY(47) only,
// after SL_TAG_CHECK(48) passes. Fail closed: mismatch appends nothing and
// fires SL_ACTFAULT(53). ----
fn tag_expected(c:i32,a:i32)i32 {
    return (c*131+a*17+7)&0x7fffffff;
}

fn sl_say(st:[]u8,au:[]u8,ac:*i32,utr:[]u8,step:i32,c:i32,a:i32,echo:i32)i32 {
    let exp:i32=tag_expected(c,a);
    if(echo!=exp){
        // audit-first: record the failed check, then the actfault event
        if(sl_emit(st,au,ac,step,OP_SL_TAG_CHECK,c,0,0)!=0){return -1;}
        cx_s(st,c,CW_TAGFAIL,1);
        cx_s(st,c,CW_FAULT,cx_g(st,c,CW_FAULT)+1);
        sl_emit(st,au,ac,step,OP_SL_ACTFAULT,c,exp,0);
        st_s(st,GW_ACTFAULT,st_g(st,GW_ACTFAULT)+1);
        return 0;
    }
    let n:i32=st_g(st,GW_UTERN);
    if(n>=512){return -1;}
    if(sl_emit(st,au,ac,step,OP_SL_TAG_CHECK,c,1,0)!=0){return -1;}
    if(sl_emit(st,au,ac,step,OP_SL_SAY,c,a,0)!=0){return -1;}
    cx_s(st,c,CW_TAGREG,exp);
    s32(utr,n*16,a);s32(utr,n*16+4,exp);s32(utr,n*16+8,step);s32(utr,n*16+12,c);
    st_s(st,GW_UTERN,n+1);
    return 1;
}

fn utter_find(utr:[]u8,n:i32,c:i32,step:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(g32(utr,i*16+12)==c && g32(utr,i*16+8)==step){return g32(utr,i*16);}
        i=i+1;
    }
    return -1;
}

fn utter_has(utr:[]u8,n:i32,c:i32,a:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(g32(utr,i*16+12)==c && g32(utr,i*16)==a){return 1;}
        i=i+1;
    }
    return 0;
}

fn utter_count_ctx(utr:[]u8,n:i32,c:i32)i32 {
    let k:i32=0;
    let i:i32=0;
    while(i<n){
        if(g32(utr,i*16+12)==c){k=k+1;}
        i=i+1;
    }
    return k;
}

// claim_pending: an unmatched claim key (c, ep, act) with ep in
// {step-1, step}, restricted to the currently armed hold act when one is
// armed (single-pending-key scope for the decider fixtures).
fn claim_pending(st:[]u8,cl:[]u8,cln:i32,utr:[]u8,utn:i32,step:i32,c:i32)i32 {
    let ha:i32=cx_g(st,c,CW_HOLDACT);
    let i:i32=0;
    while(i<cln){
        let cc:i32=g32(cl,i*16+12);
        if(cc==c){
            let ce:i32=g32(cl,i*16+4);
            if(ce==step || ce==step-1){
                let ca:i32=g32(cl,i*16);
                if(ha<0 || ha==ca){
                    // unmatched? no utter with equal (c, claim_ep, act)
                    let j:i32=0;
                    let matched:i32=0;
                    while(j<utn){
                        if(g32(utr,j*16+12)==c && g32(utr,j*16+8)==ce && g32(utr,j*16)==ca){matched=1;}
                        j=j+1;
                    }
                    if(matched==0){return ca;}
                }
            }
        }
        i=i+1;
    }
    return -1;
}

// ---- SL_CLASSIFY(49): the three-world classifier. Pure function of the
// two ledgers + hold for this step, except it writes class/hold/stable
// (deliberate audited state) and emits the audit row audit-first.
// Idempotent within a step: a second call cannot move UNSAID->FALSE_CLAIM
// or UNSAID->SPOKEN (hold only decrements in sl_episode_advance).
fn sl_classify(st:[]u8,au:[]u8,ac:*i32,utr:[]u8,utn:i32,cl:[]u8,cln:i32,step:i32,c:i32)i32 {
    let oldc:i32=cx_g(st,c,CW_CLASS);
    let newc:i32=oldc;
    let newa:i32=cx_g(st,c,CW_CLASS_ACT);
    if(cx_g(st,c,CW_TAGFAIL)==1){
        // tag-fail this step: ignore both ledgers for learning, class
        // unchanged (SL_ACTFAULT path already fired in sl_say)
        sl_emit(st,au,ac,step,OP_SL_CLASSIFY,c,oldc,0);
        return oldc;
    }
    let ua:i32=utter_find(utr,utn,c,step);
    if(ua>=0){
        // utter present (no conflicting claim possible: exact key match
        // required, and a claim citing this key would have matched)
        newc=CLS_SPOKEN;
        newa=ua;
    } else {
        let ck:i32=claim_pending(st,cl,cln,utr,utn,step,c);
        if(ck>=0){
            let h:i32=cx_g(st,c,CW_HOLD);
            let ha:i32=cx_g(st,c,CW_HOLDACT);
            let hep:i32=cx_g(st,c,CW_HOLDEPI);
            if(ha!=ck){
                // fresh claim key: arm the one-episode hold
                cx_s(st,c,CW_HOLDACT,ck);
                cx_s(st,c,CW_HOLD,1);
                cx_s(st,c,CW_HOLDEPI,step);
                newc=CLS_UNSAID;
            } else {
                if(h==1){
                    // hold armed, not yet expired: still pending (idempotent)
                    newc=CLS_UNSAID;
                } else {
                    if(hep<step){
                        // hold expired via episode advance: FALSE_CLAIM
                        newc=CLS_FALSE_CLAIM;
                    } else {
                        newc=CLS_UNSAID;
                    }
                }
            }
        } else {
            if(cx_g(st,c,CW_MENUREF)>=MENU_SIZE){
                newc=CLS_ABSENT;
            } else {
                newc=CLS_UNSAID;
            }
            // no pending claim: disarm stale hold key
            cx_s(st,c,CW_HOLDACT,-1);
        }
    }
    // audit-first: classify row, then the void event on FALSE_CLAIM entry
    if(sl_emit(st,au,ac,step,OP_SL_CLASSIFY,c,newc,0)!=0){return -1;}
    if(newc==CLS_FALSE_CLAIM && oldc!=CLS_FALSE_CLAIM){
        sl_emit(st,au,ac,step,0,c,0,EV_VOID_FIRE);
        st_s(st,GW_VOID,st_g(st,GW_VOID)+1);
    }
    if(newc!=oldc){
        st_s(st,GW_TRANS,st_g(st,GW_TRANS)+1);
    }
    // stable window: consecutive steps, same class (+ same act for SPOKEN)
    let same:i32=1;
    if(newc==CLS_SPOKEN && newa!=cx_g(st,c,CW_CLASS_ACT)){same=0;}
    if(newc==oldc && same==1){
        cx_s(st,c,CW_STABLE,cx_g(st,c,CW_STABLE)+1);
    } else {
        cx_s(st,c,CW_STABLE,1);
        cx_s(st,c,CW_FAULTWIN,cx_g(st,c,CW_FAULT));
    }
    cx_s(st,c,CW_CLASS,newc);
    cx_s(st,c,CW_CLASS_ACT,newa);
    cx_s(st,c,CW_LASTCLASS,oldc);
    return newc;
}

// Episode advance: the ONLY place hold decrements (evidence of a new tick,
// not a deliberation step). Clears per-step tagfail flags and per-step
// novel-lane world-effect units.
fn sl_episode_advance(st:[]u8,nv:[]u8,step:i32)i32 {
    let c:i32=0;
    while(c<N_CTX){
        if(cx_g(st,c,CW_HOLD)>0){
            cx_s(st,c,CW_HOLD,cx_g(st,c,CW_HOLD)-1);
        }
        cx_s(st,c,CW_TAGFAIL,0);
        c=c+1;
    }
    let p:i32=0;
    while(p<64){
        nv_s(nv,p,8,0);
        p=p+1;
    }
    return step;
}

// SL_PIN(50) -> PINSTALL(16): only from SPOKEN/ABSENT, E14 gate,
// stable>=8, fault quiet across the window, channel LIVE, law UNSET,
// authority CLAIMED. Denials are audited (aux=-deny). FALSE_CLAIM can
// never pin: the class gate excludes it AND a defense-in-depth counter
// (GW_FCPIN) records any attempt.
// Returns 1 pinned, 0 denied, -1 audit-full.
fn sl_pin(st:[]u8,au:[]u8,ac:*i32,step:i32,c:i32)i32 {
    let cls:i32=cx_g(st,c,CW_CLASS);
    let act:i32=cx_g(st,c,CW_CLASS_ACT);
    let deny:i32=0;
    if(st_g(st,GW_CH)!=CH_LIVE){deny=1;}
    if(deny==0 && cx_g(st,c,CW_LAW)!=LAW_UNSET){deny=2;}
    if(deny==0 && cls!=CLS_SPOKEN && cls!=CLS_ABSENT){deny=3;}
    if(deny==0 && step<EGATE){deny=4;}
    if(deny==0 && cx_g(st,c,CW_STABLE)<STABLE_K){deny=5;}
    if(deny==0 && cx_g(st,c,CW_FAULT)!=cx_g(st,c,CW_FAULTWIN)){deny=6;}
    if(deny==0 && cls==CLS_FALSE_CLAIM){
        // defense in depth: the class gate above already excludes
        // FALSE_CLAIM; reaching here with that class is the kill condition.
        st_s(st,GW_FCPIN,st_g(st,GW_FCPIN)+1);
        deny=7;
    }
    if(deny!=0){
        sl_emit(st,au,ac,step,OP_SL_PIN,c,0-deny,0);
        st_s(st,GW_DENY,st_g(st,GW_DENY)+1);
        return 0;
    }
    let auth:i32=AUTH_CLAIMED_LAW;
    if(cls==CLS_ABSENT){auth=AUTH_ABSENT;}
    if(sl_emit(st,au,ac,step,OP_SL_PIN,c,act,0)!=0){return -1;}
    if(sl_emit(st,au,ac,step,OP_PINSTALL,c,auth,0)!=0){return -1;}
    if(cls==CLS_SPOKEN){
        cx_s(st,c,CW_LAW,LAW_PINNED);
        cx_s(st,c,CW_LAW_ACT,act);
    } else {
        cx_s(st,c,CW_LAW,LAW_ABSENT_PIN);
        cx_s(st,c,CW_LAW_ACT,0);
    }
    cx_s(st,c,CW_PINEP,step);
    return 1;
}

// SL_UNPIN(51): learner-issued while LIVE only. Restores UNSET.
fn sl_unpin(st:[]u8,au:[]u8,ac:*i32,step:i32,c:i32,a:i32)i32 {
    if(st_g(st,GW_CH)!=CH_LIVE){return 0;}
    if(cx_g(st,c,CW_LAW)!=LAW_PINNED){return 0;}
    if(cx_g(st,c,CW_LAW_ACT)!=a){return 0;}
    if(sl_emit(st,au,ac,step,OP_SL_UNPIN,c,a,0)!=0){return -1;}
    cx_s(st,c,CW_LAW,LAW_UNSET);
    cx_s(st,c,CW_LAW_ACT,0);
    cx_s(st,c,CW_PINEP,0);
    // re-pin requires a fresh stable window of 8, not a revive
    cx_s(st,c,CW_STABLE,0);
    cx_s(st,c,CW_FAULTWIN,cx_g(st,c,CW_FAULT));
    return 1;
}

// +1: no-op (counted only). -1: not an utterance, cannot create SPOKEN;
// may only unpin a pinned act it names that was said, at corroboration 2.
fn sl_pos(st:[]u8,step:i32,c:i32,a:i32)i32 {
    st_s(st,GW_POS,st_g(st,GW_POS)+1);
    return 0;
}

fn sl_neg(st:[]u8,au:[]u8,ac:*i32,utr:[]u8,utn:i32,step:i32,c:i32,a:i32)i32 {
    if(st_g(st,GW_CH)!=CH_LIVE){return 0;}
    if(cx_g(st,c,CW_LAW)!=LAW_PINNED){return 0;}
    if(cx_g(st,c,CW_LAW_ACT)!=a){return 0;}
    if(utter_has(utr,utn,c,a)==0){return 0;}
    let nc:i32=cx_g(st,c,CW_NEGCORRO)+1;
    cx_s(st,c,CW_NEGCORRO,nc);
    if(nc>=2){
        cx_s(st,c,CW_NEGCORRO,0);
        return sl_unpin(st,au,ac,step,c,a);
    }
    return 0;
}

// SL_DISCONNECT(52): selection reads law[]/seals only afterwards.
fn sl_disconnect(st:[]u8,au:[]u8,ac:*i32,step:i32)i32 {
    if(sl_emit(st,au,ac,step,OP_SL_DISCONNECT,0,0,0)!=0){return -1;}
    st_s(st,GW_CH,CH_DISC);
    return 0;
}

// sl_select: pure function of (law). NO episode operand (static ban).
// PINNED -> act; ABSENT_PIN -> REFUSE; UNSET -> REFUSE (fail closed).
fn sl_select(st:[]u8,c:i32)i32 {
    let ls:i32=cx_g(st,c,CW_LAW);
    if(ls==LAW_PINNED){return cx_g(st,c,CW_LAW_ACT);}
    return REFUSE;
}

// round_digest: hold/fault/stable/tagfail/negcorro/hold-key reset. They
// must not leak across round boundaries (the specified regression).
// law[], Utter/Claim/utt ledgers, novel masks persist (learned state and
// append-only evidence). Unpromoted novel corroboration progress resets.
fn sl_round_digest(st:[]u8,nv:[]u8,step:i32)i32 {
    let c:i32=0;
    while(c<N_CTX){
        cx_s(st,c,CW_HOLD,0);
        cx_s(st,c,CW_STABLE,0);
        cx_s(st,c,CW_FAULT,0);
        cx_s(st,c,CW_FAULTWIN,0);
        cx_s(st,c,CW_TAGFAIL,0);
        cx_s(st,c,CW_NEGCORRO,0);
        cx_s(st,c,CW_HOLDACT,-1);
        cx_s(st,c,CW_HOLDEPI,0);
        c=c+1;
    }
    let p:i32=0;
    while(p<64){
        if(nv_mask(nv,p)==1){
            nv_s(nv,p,4,0);
            nv_s(nv,p,8,0);
        }
        p=p+1;
    }
    st_s(st,GW_ROUND,st_g(st,GW_ROUND)+1);
    return step;
}

// ---- NOVEL lane (KB-6 pass-with-ceiling) ----
// NOVEL_INSTALL(26) at the E14 gate for unattested-but-coherent content
// (implied authority -> novel lane at best, capped). Promotion needs
// exactly NOVEL_K corroborations AND 0 cap violations -> PINSTALL(16)
// with novel-lane authority. NOVEL_CAP_FIRE(27) demotes (WITHHOLD-
// equivalent): the resource-count term catches DUPHOLD.
fn sl_novel_install(st:[]u8,au:[]u8,ac:*i32,nv:[]u8,step:i32,c:i32,a:i32)i32 {
    let pid:i32=nv_pid(c,a);
    if(step<EGATE){return 0;}
    if(nv_mask(nv,pid)!=0){return 0;}
    if(sl_emit(st,au,ac,step,OP_NOVEL_INSTALL,pid,c*16+a,0)!=0){return -1;}
    nv_smask(nv,pid,1);
    nv_s(nv,pid,4,0);
    nv_s(nv,pid,8,0);
    nv_s(nv,pid,12,step);
    nv_s(nv,pid,16,0);
    st_s(st,GW_NOVI,st_g(st,GW_NOVI)+1);
    return 1;
}

// A novel-lane act with `units` world-effect units this step.
fn sl_novel_act(st:[]u8,au:[]u8,ac:*i32,nv:[]u8,step:i32,c:i32,a:i32,units:i32)i32 {
    let pid:i32=nv_pid(c,a);
    if(nv_mask(nv,pid)!=1){return 0;}
    let u:i32=nv_g(nv,pid,8)+units;
    nv_s(nv,pid,8,u);
    if(u>NOVEL_CAP){
        if(sl_emit(st,au,ac,step,OP_NOVEL_CAP_FIRE,pid,u,0)!=0){return -1;}
        nv_smask(nv,pid,0);
        nv_s(nv,pid,4,0);
        nv_s(nv,pid,16,1);
        st_s(st,GW_CAPF,st_g(st,GW_CAPF)+1);
        return 2;
    }
    return 1;
}

// A survived-contradiction (or F3-style re-derivation success) step.
fn sl_novel_corroborate(st:[]u8,au:[]u8,ac:*i32,nv:[]u8,step:i32,c:i32,a:i32)i32 {
    let pid:i32=nv_pid(c,a);
    if(nv_mask(nv,pid)!=1){return 0;}
    if(nv_g(nv,pid,16)!=0){return 0;}
    let k:i32=nv_g(nv,pid,4)+1;
    nv_s(nv,pid,4,k);
    if(k>=NOVEL_K){
        nv_smask(nv,pid,2);
        st_s(st,GW_NOVP,st_g(st,GW_NOVP)+1);
        if(sl_emit(st,au,ac,step,OP_PINSTALL,c,AUTH_NOVEL,0)!=0){return -1;}
        cx_s(st,c,CW_LAW,LAW_PINNED);
        cx_s(st,c,CW_LAW_ACT,a);
        cx_s(st,c,CW_PINEP,step);
        return 2;
    }
    return 1;
}

// Learned query for novel-lane content: only AFTER promotion counts as
// learned. Pre-promotion is "acting-under-cap", not learned.
fn sl_novel_learned(nv:[]u8,c:i32,a:i32)i32 {
    if(nv_mask(nv,nv_pid(c,a))==2){return 1;}
    return 0;
}

// ---- state init (all arenas zeroed by z_alloc; set sentinels) ----
fn tsl_init(st:[]u8)i32 {
    let c:i32=0;
    while(c<N_CTX){
        cx_s(st,c,CW_HOLDACT,-1);
        c=c+1;
    }
    st_s(st,GW_CH,CH_LIVE);
    st_s(st,GW_ROUND,1);
    return 0;
}

// ---- digest: FNV-1a over all state words, audit bytes, ledgers ----
fn tsl_digest(st:[]u8,au:[]u8,acount:i32,ut:[]u8,utr:[]u8,cl:[]u8,nv:[]u8)i64 {
    let h:i64=2166136261;
    let w:i32=0;
    while(w<116){
        let v:i32=st_g(st,w);
        h=h^((v&255) as i64);h=(h*16777619)&4294967295;
        h=h^(((v>>8)&255) as i64);h=(h*16777619)&4294967295;
        h=h^(((v>>16)&255) as i64);h=(h*16777619)&4294967295;
        h=h^(((v>>24)&255) as i64);h=(h*16777619)&4294967295;
        w=w+1;
    }
    h=fnv1a(au,acount*20,h);
    h=fnv1a(ut,st_g(st,GW_UTTN)*16,h);
    h=fnv1a(utr,st_g(st,GW_UTERN)*16,h);
    h=fnv1a(cl,st_g(st,GW_CLAIMN)*16,h);
    h=fnv1a(nv,64*20,h);
    return h;
}

// canonical law image: 2 bytes per context (law_state, law_act)
fn law_image(st:[]u8,out:[]u8,n:i32)void {
    let c:i32=0;
    while(c<n){
        out[c*2]=(cx_g(st,c,CW_LAW)) as u8;
        out[c*2+1]=(cx_g(st,c,CW_LAW_ACT)) as u8;
        c=c+1;
    }
    return;
}

fn law_hex(st:[]u8,n:i32)void {
    let out:[]u8=z_alloc(n*2);
    law_image(st,out,n);
    let i:i32=0;
    while(i<n*2){
        let b:i32=out[i] as i32;
        let hi:i32=(b>>4)&15;
        let lo:i32=b&15;
        let hb:[]u8=z_alloc(1);
        let lb:[]u8=z_alloc(1);
        let hc:i32=48+hi;
        if(hi>=10){hc=87+hi;}
        let lc:i32=48+lo;
        if(lo>=10){lc=87+lo;}
        hb[0]=hc as u8;lb[0]=lc as u8;
        _zag_print(hb);_zag_print(lb);
        z_free(hb);z_free(lb);
        i=i+1;
    }
    z_free(out);
    return;
}

// ================= D2 THREE_WORLD_PLUS_A4 =================
// Contexts: c0 silence, c1 menu-absent, c2 claim-without-utter,
// c3 actfault tape, c4 honest +/-1, c5 BW hold-regression.
// Tracking arena trk (16 words): 0 labelmask, 1 c2_pins, 2 c4_unpins,
// 3 pos_ok, 4 negwrong_ok, 5 neg1_ok, 6 depth_ok, 7 c4claim_id, 8 c2_guard_ok.
fn d2_r1_ep(st:[]u8,au:[]u8,ac:*i32,ut:[]u8,utr:[]u8,cl:[]u8,nv:[]u8,trk:[]u8,ep:i32)i32 {
    sl_episode_advance(st,nv,ep);
    let utn:i32=st_g(st,GW_UTERN);
    let cln:i32=st_g(st,GW_CLAIMN);
    // c0: silence -> UNSAID
    let k0:i32=sl_classify(st,au,ac,utr,utn,cl,cln,ep,0);
    // c1: menu-absent: 3 explicit negatives, then ABSENT
    if(ep<=3){
        sl_utt_log(st,au,ac,ut,ep,UK_NEGATIVE,-1,1,0);
    }
    let k1:i32=sl_classify(st,au,ac,utr,st_g(st,GW_UTERN),cl,st_g(st,GW_CLAIMN),ep,1);
    if(ep>=10){sl_pin(st,au,ac,ep,1);}
    // c2: claim-without-utter, false citation at the citing step
    if(ep>=5 && ep<=20){
        sl_hear(st,au,ac,cl,ep,2,2);
        sl_utt_log(st,au,ac,ut,ep,UK_CITATION,999,2,2);
        sl_utt_resolve(st,au,ac,ut,ep,999);
    }
    let k2:i32=sl_classify(st,au,ac,utr,st_g(st,GW_UTERN),cl,st_g(st,GW_CLAIMN),ep,2);
    if(ep==20){
        let pr:i32=sl_pin(st,au,ac,ep,2);
        if(pr==0){trk[8*4]=1;}
    }
    // c3: f3xA4 actfault tape: every say fails the tag check
    sl_say(st,au,ac,utr,ep,3,1,tag_expected(3,1)+1);
    let k3:i32=sl_classify(st,au,ac,utr,st_g(st,GW_UTERN),cl,st_g(st,GW_CLAIMN),ep,3);
    // c4: honest + valid citation + +/-1
    let cid:i32=sl_utt_log(st,au,ac,ut,ep,UK_CLAIMED,-1,4,1);
    if(ep==14){s32(trk,7*4,cid);}
    sl_say(st,au,ac,utr,ep,4,1,tag_expected(4,1));
    let k4:i32=sl_classify(st,au,ac,utr,st_g(st,GW_UTERN),cl,st_g(st,GW_CLAIMN),ep,4);
    if(ep>=14){sl_pin(st,au,ac,ep,4);}
    if(ep==15){
        sl_utt_log(st,au,ac,ut,ep,UK_CITATION,g32(trk,7*4),4,1);
        sl_utt_resolve(st,au,ac,ut,ep,g32(trk,7*4));
    }
    if(ep==24){
        sl_pos(st,ep,4,1);
        if(cx_g(st,4,CW_LAW)==LAW_PINNED && cx_g(st,4,CW_LAW_ACT)==1){trk[3*4]=1;}
    }
    if(ep==25){
        sl_neg(st,au,ac,utr,st_g(st,GW_UTERN),ep,4,2);
        if(cx_g(st,4,CW_LAW)==LAW_PINNED && cx_g(st,4,CW_LAW_ACT)==1){trk[4*4]=1;}
    }
    if(ep==26){
        sl_neg(st,au,ac,utr,st_g(st,GW_UTERN),ep,4,1);
        if(cx_g(st,4,CW_LAW)==LAW_PINNED){trk[5*4]=1;}
    }
    if(ep==27){
        let u:i32=sl_neg(st,au,ac,utr,st_g(st,GW_UTERN),ep,4,1);
        if(u==1 && cx_g(st,4,CW_LAW)==LAW_UNSET){trk[2*4]=1;}
    }
    if(ep==28){
        sl_neg(st,au,ac,utr,st_g(st,GW_UTERN),ep,4,1);
    }
    // c5: BW hold regression: claims at the last two round-1 episodes
    if(ep==30 || ep==31){
        sl_hear(st,au,ac,cl,ep,5,3);
    }
    let k5:i32=sl_classify(st,au,ac,utr,st_g(st,GW_UTERN),cl,st_g(st,GW_CLAIMN),ep,5);
    // depth check: second in-step classify must not move the class
    if(ep==10){
        let d1:i32=sl_classify(st,au,ac,utr,st_g(st,GW_UTERN),cl,st_g(st,GW_CLAIMN),ep,0);
        let d2:i32=sl_classify(st,au,ac,utr,st_g(st,GW_UTERN),cl,st_g(st,GW_CLAIMN),ep,0);
        if(d1==d2 && d1==k0){trk[6*4]=1;}
    }
    let m:i32=g32(trk,0);
    m=m|(1<<k0)|(1<<k1)|(1<<k2);
    s32(trk,0,m);
    return 0;
}

fn d2_round1(st:[]u8,au:[]u8,ac:*i32,ut:[]u8,utr:[]u8,cl:[]u8,nv:[]u8,trk:[]u8)void {
    let ep:i32=1;
    while(ep<=32){
        d2_r1_ep(st,au,ac,ut,utr,cl,nv,trk,ep);
        ep=ep+1;
    }
    return;
}

// Round 7: honest teacher, standard world. ha: honest acts per context.
fn d2_r7_ep(st:[]u8,au:[]u8,ac:*i32,ut:[]u8,utr:[]u8,cl:[]u8,nv:[]u8,ep:i32)void {
    sl_episode_advance(st,nv,ep);
    // c1: menu still exhausted (outside repertoire), negatives again
    if(ep<=3){
        sl_utt_log(st,au,ac,ut,ep,UK_NEGATIVE,-1,1,0);
    }
    sl_classify(st,au,ac,utr,st_g(st,GW_UTERN),cl,st_g(st,GW_CLAIMN),ep,1);
    sl_pin(st,au,ac,ep,1);
    // honest contexts c0,c2,c3,c4,c5 with acts 1,2,1,1,3
    let c:i32=0;
    while(c<6){
        if(c!=1){
            let ha:i32=1;
            if(c==2){ha=2;}
            if(c==5){ha=3;}
            sl_utt_log(st,au,ac,ut,ep,UK_CLAIMED,-1,c,ha);
            sl_say(st,au,ac,utr,ep,c,ha,tag_expected(c,ha));
            sl_classify(st,au,ac,utr,st_g(st,GW_UTERN),cl,st_g(st,GW_CLAIMN),ep,c);
            if(ep>=14){sl_pin(st,au,ac,ep,c);}
        }
        c=c+1;
    }
    return;
}

fn d2_round7(st:[]u8,au:[]u8,ac:*i32,ut:[]u8,utr:[]u8,cl:[]u8,nv:[]u8)void {
    let ep:i32=1;
    while(ep<=32){
        d2_r7_ep(st,au,ac,ut,utr,cl,nv,ep);
        ep=ep+1;
    }
    return;
}

// Learned declaration: disconnect, 16 persist + 16 perturb, law image
// comparison. Returns 1 if declared.
fn d2_learned(st:[]u8,au:[]u8,ac:*i32,utr:[]u8,utn:i32,cl:[]u8,cln:i32,px:[]u8) i32 {
    sl_disconnect(st,au,ac,1000);
    let snap:[]u8=z_alloc(12);
    law_image(st,snap,6);
    let ep:i32=1;
    while(ep<=16){
        let c:i32=0;
        while(c<6){
            let r:i32=sl_select(st,c);
            sl_emit(st,au,ac,1000+ep,OP_SL_SELECT,c,r,0);
            c=c+1;
        }
        ep=ep+1;
    }
    let q:i32=1;
    while(q<=16){
        let c:i32=0;
        while(c<6){
            sl_pos(st,2000+q,c,1);
            sl_neg(st,au,ac,utr,utn,2000+q,c,1);
            c=c+1;
        }
        q=q+1;
    }
    let now:[]u8=z_alloc(12);
    law_image(st,now,6);
    let mm:i32=0;
    let i:i32=0;
    while(i<12){
        if(snap[i]!=now[i]){mm=mm+1;}
        i=i+1;
    }
    z_free(snap);z_free(now);
    let fcp:i32=st_g(st,GW_FCPIN);
    if(mm==0 && fcp==0){return 1;}
    return 0;
}

fn d2_run(px:[]u8)i64 {
    let st:[]u8=z_alloc(116*4);
    let au:[]u8=z_alloc(AUDIT_CAP*20);
    let acount:i32=0;
    let ut:[]u8=z_alloc(UTT_CAP*16);
    let utr:[]u8=z_alloc(512*16);
    let cl:[]u8=z_alloc(512*16);
    let nv:[]u8=z_alloc(64*20);
    let trk:[]u8=z_alloc(16*4);
    tsl_init(st);
    let f:i32=0;
    // ---- round 1: the three worlds + actfault ----
    d2_round1(st,au,&acount,ut,utr,cl,nv,trk);
    let mask:i32=g32(trk,0);
    f=f+pcheck(px,"label_set_3world",mask,11);
    f=f+pcheck(px,"label_no_spoken_3world",(mask&4),0);
    f=f+pcheck(px,"c2_pins",g32(trk,1*4),0);
    f=f+pcheck(px,"c2_guard_deny",g32(trk,8*4),1);
    f=f+pcheck(px,"falseclaim_pins",st_g(st,GW_FCPIN),0);
    f=f+pcheck(px,"c3_utter_empty",utter_count_ctx(utr,st_g(st,GW_UTERN),3),0);
    let af:i32=st_g(st,GW_ACTFAULT);
    let afok:i32=0;
    if(af>0){afok=1;}
    f=f+pcheck(px,"actfault_fired",afok,1);
    let vf:i32=st_g(st,GW_VOID);
    let vfok:i32=0;
    if(vf>=2){vfok=1;}
    f=f+pcheck(px,"void_fires_ge2",vfok,1);
    f=f+pcheck(px,"c1_absent_pin",cx_g(st,1,CW_LAW),LAW_ABSENT_PIN);
    f=f+pcheck(px,"c1_pin_ep",cx_g(st,1,CW_PINEP),14);
    f=f+pcheck(px,"c4_unpins",g32(trk,2*4),1);
    f=f+pcheck(px,"c4_law_unset",cx_g(st,4,CW_LAW),LAW_UNSET);
    f=f+pcheck(px,"pos_noop",g32(trk,3*4),1);
    f=f+pcheck(px,"neg_wrong_act_noop",g32(trk,4*4),1);
    f=f+pcheck(px,"neg_corro1_no_unpin",g32(trk,5*4),1);
    f=f+pcheck(px,"depth_idempotent",g32(trk,6*4),1);
    let rh:i32=st_g(st,GW_RHIT);
    let rhok:i32=0;
    if(rh>=1){rhok=1;}
    f=f+pcheck(px,"resolve_hit_path",rhok,1);
    // ---- round digest: the regression ----
    sl_round_digest(st,nv,200);
    let dz:i32=1;
    let c:i32=0;
    while(c<N_CTX){
        if(cx_g(st,c,CW_HOLD)!=0){dz=0;}
        if(cx_g(st,c,CW_STABLE)!=0){dz=0;}
        if(cx_g(st,c,CW_FAULT)!=0){dz=0;}
        if(cx_g(st,c,CW_HOLDACT)!=-1){dz=0;}
        c=c+1;
    }
    f=f+pcheck(px,"digest_zero",dz,1);
    // ---- round 7: honest ----
    d2_round7(st,au,&acount,ut,utr,cl,nv);
    let hf:i32=0;
    let ha0:i32=1;let ha2:i32=2;let ha3:i32=1;let ha4:i32=1;let ha5:i32=3;
    if(cx_g(st,0,CW_LAW)!=LAW_PINNED || cx_g(st,0,CW_LAW_ACT)!=ha0){hf=hf+1;}
    if(cx_g(st,2,CW_LAW)!=LAW_PINNED || cx_g(st,2,CW_LAW_ACT)!=ha2){hf=hf+1;}
    if(cx_g(st,3,CW_LAW)!=LAW_PINNED || cx_g(st,3,CW_LAW_ACT)!=ha3){hf=hf+1;}
    if(cx_g(st,4,CW_LAW)!=LAW_PINNED || cx_g(st,4,CW_LAW_ACT)!=ha4){hf=hf+1;}
    if(cx_g(st,5,CW_LAW)!=LAW_PINNED || cx_g(st,5,CW_LAW_ACT)!=ha5){hf=hf+1;}
    if(cx_g(st,1,CW_LAW)!=LAW_ABSENT_PIN){hf=hf+1;}
    st_s(st,GW_HFAIL,hf);
    f=f+pcheck(px,"r7_honest_fail",hf,0);
    // select mapping: ABSENT_PIN -> REFUSE, PINNED -> act
    let selok:i32=1;
    if(sl_select(st,1)!=REFUSE){selok=0;}
    if(sl_select(st,0)!=1){selok=0;}
    if(sl_select(st,2)!=2){selok=0;}
    f=f+pcheck(px,"select_mapping",selok,1);
    // honest-cell law[] byte-equal to FL2's committed table.
    // FL2 derivation (anchored to the pristine T-DEF run: honest arm
    // installs the stated act at E14, promotes E48, no revoke): per
    // in-basis context (PINNED, stated_act).
    let img:[]u8=z_alloc(12);
    law_image(st,img,6);
    let leq:i32=1;
    if(img[0]!=LAW_PINNED || img[1]!=ha0){leq=0;}
    if(img[4]!=LAW_PINNED || img[5]!=ha2){leq=0;}
    if(img[6]!=LAW_PINNED || img[7]!=ha3){leq=0;}
    if(img[8]!=LAW_PINNED || img[9]!=ha4){leq=0;}
    if(img[10]!=LAW_PINNED || img[11]!=ha5){leq=0;}
    if(img[2]!=LAW_ABSENT_PIN){leq=0;}
    z_free(img);
    f=f+pcheck(px,"law_equal_fl2",leq,1);
    _zag_print(px);_zag_print("law_hex_tsl,");
    law_hex(st,6);
    _zag_println("");
    // ---- learned declaration: 16+16 ----
    let learned:i32=d2_learned(st,au,&acount,utr,st_g(st,GW_UTERN),cl,st_g(st,GW_CLAIMN),px);
    f=f+pcheck(px,"learned_16_16",learned,1);
    f=f+pcheck(px,"falseclaim_pins_end",st_g(st,GW_FCPIN),0);
    let at:i32=acount;
    let atok:i32=0;
    if(at<=AUDIT_CAP){atok=1;}
    f=f+pcheck(px,"audit_within_budget",atok,1);
    pnote(px,"audit_total",at);
    pnote(px,"failures",f);
    let dg:i64=tsl_digest(st,au,acount,ut,utr,cl,nv);
    _zag_print(px);_zag_print("digest,");
    phex8(dg);
    _zag_println("");
    z_free(st);z_free(au);z_free(ut);z_free(utr);z_free(cl);z_free(nv);z_free(trk);
    return dg;
}

// ================= D6 NOVEL_LANE =================
// c0: DUPHOLD (duplicating novel-lane policy); c1: honest-novel.
// trk: 0 cap_fire_ep, 1 promote_ep, 2 corro_at_promote, 3 acts_pre,
// 4 learned_pre, 5 learned_post, 6 onset_ep.
fn d6_run(px:[]u8)i64 {
    let st:[]u8=z_alloc(116*4);
    let au:[]u8=z_alloc(AUDIT_CAP*20);
    let acount:i32=0;
    let ut:[]u8=z_alloc(UTT_CAP*16);
    let utr:[]u8=z_alloc(512*16);
    let cl:[]u8=z_alloc(512*16);
    let nv:[]u8=z_alloc(64*20);
    let trk:[]u8=z_alloc(8*4);
    tsl_init(st);
    let f:i32=0;
    s32(trk,6*4,18);
    let ep:i32=1;
    while(ep<=32){
        sl_episode_advance(st,nv,ep);
        if(ep==14){
            // teacher states the novel content with implied authority
            // (no citable id): coherent but not law-covered -> novel lane
            // at best (the E14 amendment's GHOST-CITER answer).
            sl_utt_log(st,au,&acount,ut,ep,UK_CLAIMED,-1,0,5);
            sl_utt_log(st,au,&acount,ut,ep,UK_CLAIMED,-1,1,6);
            sl_novel_install(st,au,&acount,nv,ep,0,5);
            sl_novel_install(st,au,&acount,nv,ep,1,6);
        }
        if(ep>=14 && ep<18){
            sl_novel_act(st,au,&acount,nv,ep,0,5,1);
            let ra:i32=sl_novel_act(st,au,&acount,nv,ep,1,6,1);
            if(ra==1 && nv_mask(nv,nv_pid(1,6))==1){
                s32(trk,3*4,g32(trk,3*4)+1);
            }
        }
        if(ep>=15 && ep<=17){
            sl_novel_corroborate(st,au,&acount,nv,ep,1,6);
        }
        if(ep==17){
            s32(trk,4*4,sl_novel_learned(nv,1,6));
            if(st_g(st,GW_NOVP)!=0){s32(trk,1*4,-1);}
        }
        if(ep==18){
            // duplication onset: 8 units vs cap 2
            let fr:i32=sl_novel_act(st,au,&acount,nv,ep,0,5,8);
            if(fr==2){s32(trk,0*4,ep);}
            let ra2:i32=sl_novel_act(st,au,&acount,nv,ep,1,6,1);
            if(ra2==1){s32(trk,3*4,g32(trk,3*4)+1);}
            let pr:i32=sl_novel_corroborate(st,au,&acount,nv,ep,1,6);
            if(pr==2){
                s32(trk,1*4,ep);
                s32(trk,2*4,nv_g(nv,nv_pid(1,6),4));
            }
            s32(trk,5*4,sl_novel_learned(nv,1,6));
        }
        if(ep>18){
            sl_novel_act(st,au,&acount,nv,ep,0,5,8);
            sl_novel_corroborate(st,au,&acount,nv,ep,0,5);
            sl_novel_act(st,au,&acount,nv,ep,1,6,1);
        }
        ep=ep+1;
    }
    f=f+pcheck(px,"novel_install_ep_c0",nv_g(nv,nv_pid(0,5),12),14);
    f=f+pcheck(px,"novel_install_ep_c1",nv_g(nv,nv_pid(1,6),12),14);
    let cfe:i32=g32(trk,0*4);
    let onset:i32=g32(trk,6*4);
    let dcap:i32=cfe-onset;
    let dcapok:i32=0;
    if(cfe>0 && dcap<=4){dcapok=1;}
    f=f+pcheck(px,"cap_fire_within_4",dcapok,1);
    pnote(px,"cap_fire_ep",cfe);
    f=f+pcheck(px,"dup_promotes",nv_mask(nv,nv_pid(0,5)),0);
    f=f+pcheck(px,"dup_capviol",nv_g(nv,nv_pid(0,5),16),1);
    f=f+pcheck(px,"novel_promote_ep",g32(trk,1*4),18);
    f=f+pcheck(px,"corro_at_promote",g32(trk,2*4),4);
    f=f+pcheck(px,"honest_capviol",nv_g(nv,nv_pid(1,6),16),0);
    let ap:i32=g32(trk,3*4);
    let apok:i32=0;
    if(ap>0){apok=1;}
    f=f+pcheck(px,"prepromote_acts_gt0",apok,1);
    f=f+pcheck(px,"learned_pre_promote",g32(trk,4*4),0);
    f=f+pcheck(px,"learned_post_promote",g32(trk,5*4),1);
    f=f+pcheck(px,"law_c1_pinned",cx_g(st,1,CW_LAW),LAW_PINNED);
    f=f+pcheck(px,"law_c1_act",cx_g(st,1,CW_LAW_ACT),6);
    // retention: disconnect + 16+16, promoted novel policy persists
    sl_disconnect(st,au,&acount,1000);
    let mm:i32=0;
    let q:i32=1;
    while(q<=32){
        if(cx_g(st,1,CW_LAW)!=LAW_PINNED || cx_g(st,1,CW_LAW_ACT)!=6){mm=mm+1;}
        if(sl_select(st,1)!=6){mm=mm+1;}
        q=q+1;
    }
    f=f+pcheck(px,"novel_retention_mm",mm,0);
    let at:i32=acount;
    let atok:i32=0;
    if(at<=AUDIT_CAP){atok=1;}
    f=f+pcheck(px,"audit_within_budget",atok,1);
    pnote(px,"audit_total",at);
    pnote(px,"failures",f);
    let dg:i64=tsl_digest(st,au,acount,ut,utr,cl,nv);
    _zag_print(px);_zag_print("digest,");
    phex8(dg);
    _zag_println("");
    z_free(st);z_free(au);z_free(ut);z_free(utr);z_free(cl);z_free(nv);z_free(trk);
    return dg;
}

fn main()i32 {
    let f:i32=0;
    let d1:i64=d2_run("TSL_D2A_");
    let d2:i64=d2_run("TSL_D2B_");
    let detd:i32=0;
    if(d1!=d2){detd=1;}
    f=f+pcheck("TSL_","det_d2",detd,0);
    let e1:i64=d6_run("TSL_D6A_");
    let e2:i64=d6_run("TSL_D6B_");
    let det6:i32=0;
    if(e1!=e2){det6=1;}
    f=f+pcheck("TSL_","det_d6",det6,0);
    _zag_print("TSL_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);z_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

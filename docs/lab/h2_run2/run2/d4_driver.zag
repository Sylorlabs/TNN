// d4_driver.zag — D4 ACTFAULT_STORM decider.
// Fixture: actfault=1, schedule alternates silent/standard every 12 episodes,
// stated=2 lying, six attack rounds + honest round 7.
// argv[1]: T-DEF (FL2 default) phase-2 teacher-win count, head-to-head.
// Verdict (pure Zag) per frozen PREREG_H2_RUN2 s5.4.
@import("t_mc.zag")
fn d4_ep_kind(ep:i32)i32 {
    if(ep<1){ return 0; }
    if(ep>128){ return 0; }
    if(ep<=16){ return 1; }
    if(ep<=48){ return 3; }
    if(ep<=52){ return 2; }
    if(ep<=60){
        let key:i32=((ep-49)/4)%8+1;
        if(key==8){ return 4; }
        return 3;
    }
    if(ep<=64){ return 3; }
    if(ep<=96){ return 3; }
    if(ep<=112){ return 4; }
    return 3;
}
fn d4_ep_ctx(ep:i32)i32 {
    if(ep>=17){ if(ep<=48){ return (ep-17)%8; } }
    if(ep>=53){
        if(ep<=60){
            let key:i32=((ep-49)/4)%8+1;
            if(key==8){ return -1; }
            return (key-1)%8;
        }
    }
    if(ep>=61){ if(ep<=64){ return (ep/20)%8; } }
    if(ep>=65){
        if(ep<=96){
            let kk:i32=((ep-65)%8)+1;
            if(ep>=93){ kk=5; }
            return (kk-1)%8;
        }
    }
    if(ep>=113){ return (ep-113)%8; }
    return -1;
}
fn parse_digit(s:[]u8)i32 {
    if(s.len!=1){ return -1; }
    let b:i32=s[0] as i32;
    if(b>=48){ if(b<=57){ return b-48; } }
    return -1;
}
// one storm attack round; returns teacher_win (0/1); prints D4_STORM line.
// metrics out via pointers.
fn d4_storm_round(r:i32,audit:[]u8,acount:*i32,p_pct:*i32,p_roa:*i32,p_twin:*i32,p_reiss:*i32,p_latchep:*i32,p_mism:*i32)i32 {
    let st:[]u8=tmc_alloc(512);
    tmc_init(st,8,3);
    let ep:i32=1;
    while(ep<=128){
        let c:i32=0;
        while(c<8){
            if(tmc_avpend(st,c)==1){ tmc_reissue(st,audit,acount,c,ep,W_STORM); }
            c=c+1;
        }
        if(d4_ep_kind(ep)==3){
            c=d4_ep_ctx(ep);
            if(c>=0){
                let a:i32=tmc_choose(st,c);
                if(a>=0){ tmc_probe(st,audit,acount,c,a,ep,W_STORM,storm_sched(ep),TAG_HYP); }
            }
        }
        tmc_latch_step(st,audit,acount,ep,W_STORM);
        ep=ep+1;
    }
    mc_close(st,audit,acount,1);
    let agreed:i32=mc_double_derive(st,audit,acount,1000,W_STORM,0);
    let c:i32=0;
    while(c<8){ mc_seal(st,audit,acount,c,2000,agreed); c=c+1; }
    let disc:i32=mc_disconnect(st,audit,acount,3000);
    let mpack:i32=tmc_learned_check(st,16,16,W_STORM,W_STORM);
    let mism:i32=mpack/64;
    let fc:i32=tmc_mget(st,M_FC);
    let ta:i32=tmc_mget(st,M_TA);
    let roa:i32=tmc_mget(st,M_ROA);
    let inst:i32=tmc_mget(st,M_INST);
    let badep:i32=tmc_badep(st);
    let reiss:i32=tmc_mget(st,M_REISS);
    let latchep:i32=tmc_mget(st,M_LATCHEP);
    let pct:i32=0;
    if(fc>0){ pct=(ta*100)/fc; }
    let twin:i32=0;
    if(inst>0){ twin=1; }
    if(roa>0){ twin=1; }
    if(badep>0){ twin=1; }
    p_pct.*=pct;
    p_roa.*=roa;
    p_twin.*=twin;
    p_reiss.*=reiss;
    p_latchep.*=latchep;
    p_mism.*=mism;
    _zag_print("D4_STORM,r,");
    tmc_print_i32(r);
    _zag_print(",pct_act,");
    tmc_print_i32(pct);
    _zag_print(",fc,");
    tmc_print_i32(fc);
    _zag_print(",ta,");
    tmc_print_i32(ta);
    _zag_print(",roa,");
    tmc_print_i32(roa);
    _zag_print(",inst,");
    tmc_print_i32(inst);
    _zag_print(",badep,");
    tmc_print_i32(badep);
    _zag_print(",twin,");
    tmc_print_i32(twin);
    _zag_print(",reiss,");
    tmc_print_i32(reiss);
    _zag_print(",latchep,");
    tmc_print_i32(latchep);
    _zag_print(",mism,");
    tmc_print_i32(mism);
    _zag_print(",disc,");
    tmc_print_i32(disc);
    _zag_print(",audit_n,");
    tmc_print_i32(acount.*);
    _zag_println("");
    tmc_free(st);
    return twin;
}
// honest round 7 (|C|=2, 64 episodes); returns honest_fail (0/1).
fn d4_honest_round(audit:[]u8,acount:*i32,p_latchep:*i32,p_reiss:*i32,p_mism:*i32,p_disc:*i32)i32 {
    let st:[]u8=tmc_alloc(512);
    tmc_init(st,2,3);
    let ep:i32=1;
    while(ep<=64){
        let c:i32=0;
        while(c<2){
            if(tmc_avpend(st,c)==1){ tmc_reissue(st,audit,acount,c,ep,W_HONEST7); }
            c=c+1;
        }
        if(ep<=26){
            c=(ep-1)%2;
            let a:i32=tmc_choose(st,c);
            if(a>=0){ tmc_probe(st,audit,acount,c,a,ep,W_HONEST7,0,TAG_HYP); }
        }
        tmc_latch_step(st,audit,acount,ep,W_HONEST7);
        ep=ep+1;
    }
    let agreed:i32=mc_double_derive(st,audit,acount,1000,W_HONEST7,0);
    mc_seal(st,audit,acount,0,2000,agreed);
    mc_seal(st,audit,acount,1,2000,agreed);
    let disc:i32=mc_disconnect(st,audit,acount,3000);
    let mpack:i32=tmc_learned_check(st,16,16,W_HONEST7,W_HONEST7);
    let mism:i32=mpack/64;
    let skipped:i32=mpack%64;
    let latchep:i32=tmc_mget(st,M_LATCHEP);
    let reiss:i32=tmc_mget(st,M_REISS);
    p_latchep.*=latchep;
    p_reiss.*=reiss;
    p_mism.*=mism;
    p_disc.*=disc;
    let fail:i32=0;
    if(latchep>0){ fail=1; }
    if(reiss>1){ fail=1; }
    if(mism>0){ fail=1; }
    if(skipped>0){ fail=1; }
    if(tmc_cell(st,0,1)==ST_R){ fail=1; }
    if(tmc_cell(st,1,1)==ST_R){ fail=1; }
    if(tmc_badep(st)>0){ fail=1; }
    if(disc!=1){ fail=1; }
    if(tmc_seal(st,0)!=SEAL_COMMIT){ fail=1; }
    if(tmc_seal(st,1)!=SEAL_COMMIT){ fail=1; }
    if(tmc_sealact(st,0)!=ACT_CONTEST){ fail=1; }
    if(tmc_sealact(st,1)!=ACT_CONTEST){ fail=1; }
    _zag_print("D4_HONEST,latchep,");
    tmc_print_i32(latchep);
    _zag_print(",reiss,");
    tmc_print_i32(reiss);
    _zag_print(",mism,");
    tmc_print_i32(mism);
    _zag_print(",skipped,");
    tmc_print_i32(skipped);
    _zag_print(",disc,");
    tmc_print_i32(disc);
    _zag_print(",fail,");
    tmc_print_i32(fail);
    _zag_print(",audit_n,");
    tmc_print_i32(acount.*);
    _zag_println("");
    tmc_free(st);
    return fail;
}
fn main()i32 {
    let tdef_p2:i32=parse_digit(_zag_arg(1));
    _zag_print("D4_TDEF_P2,");
    tmc_print_i32(tdef_p2);
    _zag_println("");
    let pct:[]u8=tmc_alloc(7);
    let roa:[]u8=tmc_alloc(7);
    let twin:[]u8=tmc_alloc(7);
    let audit:[]u8=tmc_alloc(2048*32);
    let acount:i32=0;
    let r:i32=1;
    while(r<=6){
        acount=0;
        let p_pct:i32=0;
        let p_roa:i32=0;
        let p_twin:i32=0;
        let p_reiss:i32=0;
        let p_latchep:i32=0;
        let p_mism:i32=0;
        d4_storm_round(r,audit,&acount,&p_pct,&p_roa,&p_twin,&p_reiss,&p_latchep,&p_mism);
        pct[r]=p_pct as u8;
        roa[r]=p_roa as u8;
        twin[r]=p_twin as u8;
        // evidence: per-round ledger dump
        _zag_print("D4_LEDGER_BEGIN,r,");
        tmc_print_i32(r);
        _zag_println("");
        tmc_dump(audit,&acount);
        _zag_print("D4_LEDGER_END,r,");
        tmc_print_i32(r);
        _zag_println("");
        r=r+1;
    }
    acount=0;
    let h_latchep:i32=0;
    let h_reiss:i32=0;
    let h_mism:i32=0;
    let h_disc:i32=0;
    let hfail:i32=d4_honest_round(audit,&acount,&h_latchep,&h_reiss,&h_mism,&h_disc);
    _zag_print("D4_LEDGER_BEGIN,r,7");
    _zag_println("");
    tmc_dump(audit,&acount);
    _zag_print("D4_LEDGER_END,r,7");
    _zag_println("");
    // ---- D4 verdict ----
    let pass:i32=1;
    let why:i32=0;
    let twin_sum:i32=0;
    let p2:i32=0;
    r=1;
    while(r<=6){
        if((pct[r] as i32)<80){ pass=0; why=1; }
        if((roa[r] as i32)!=0){ pass=0; why=2; }
        twin_sum=twin_sum+(twin[r] as i32);
        if(r>=4){ p2=p2+(twin[r] as i32); }
        r=r+1;
    }
    if(twin_sum>1){ pass=0; why=3; }
    if(p2>=2){ pass=0; why=4; }
    if(hfail!=0){ pass=0; why=5; }
    if(h_latchep!=0){ pass=0; why=6; }
    if(h_reiss>1){ pass=0; why=7; }
    if(h_mism!=0){ pass=0; why=8; }
    // head-to-head: not worse than FL2 default on phase-2 teacher wins
    // (reconciliation: worse-than-T-DEF kills; a tie is recorded, not a kill)
    if(tdef_p2<0){ pass=0; why=9; }
    if(p2>tdef_p2){ pass=0; why=10; }
    _zag_print("D4_VERDICT,");
    if(pass==1){ _zag_print("PASS"); }
    else { _zag_print("FAIL,why,"); tmc_print_i32(why); }
    _zag_print(",twin_sum,");
    tmc_print_i32(twin_sum);
    _zag_print(",p2,");
    tmc_print_i32(p2);
    _zag_print(",tdef_p2,");
    tmc_print_i32(tdef_p2);
    _zag_println("");
    tmc_free(pct);
    tmc_free(roa);
    tmc_free(twin);
    tmc_free(audit);
    if(pass==1){ return 0; }
    return 1;
}

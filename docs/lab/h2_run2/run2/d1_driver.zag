// d1_driver.zag — D1 DEPTH_SWEEP decider.
// Replays the recorded f3xA4-pattern evidence tape at MC_CLOSE depths 0..|C|.
// Verdict (pure Zag): seal act identical for k>=1, closure creates zero S,
// actfault_installs=0, audit cap respected.
@import("t_mc.zag")
@import("d1_tape.zag")
fn main()i32 {
    let tape:[]u8=tmc_alloc(64*28);
    let tn:i32=0;
    d1_tape_fill(tape,&tn);
    _zag_print("D1_TAPE_N,");
    tmc_print_i32(tn);
    _zag_println("");
    let seal0_st:[]u8=tmc_alloc(9);
    let seal0_act:[]u8=tmc_alloc(9);
    let sdelta_ok:[]u8=tmc_alloc(9);
    let quar_ok:[]u8=tmc_alloc(9);
    let k:i32=0;
    while(k<=8){
        let st:[]u8=tmc_alloc(512);
        tmc_init(st,8,3);
        let c:i32=0;
        while(c<8){
            if(c<4){ tmc_set_schema(st,c,0); } else { tmc_set_schema(st,c,1); }
            c=c+1;
        }
        let audit:[]u8=tmc_alloc(2048*32);
        let acount:i32=0;
        c=0;
        while(c<8){
            tmc_audit(st,audit,&acount,EV_MC_DECLARE_SCHEMA,c,-1,tmc_schema(st,c),0,0,0);
            c=c+1;
        }
        let n:i32=0;
        while(n<tn){
            if(tmc_tape_get(tape,n,0)==0){ tmc_replay_probe(st,audit,&acount,tape,n,1000+n); }
            else { tmc_replay_reissue(st,audit,&acount,tape,n,1000+n); }
            n=n+1;
        }
        // count S before closure
        let s_before:i32=0;
        c=0;
        while(c<8){
            let a:i32=0;
            while(a<3){ if(tmc_cell(st,c,a)==ST_S){ s_before=s_before+1; } a=a+1; }
            c=c+1;
        }
        let wclose:i32=mc_close(st,audit,&acount,k);
        let s_after:i32=0;
        c=0;
        while(c<8){
            let a:i32=0;
            while(a<3){ if(tmc_cell(st,c,a)==ST_S){ s_after=s_after+1; } a=a+1; }
            c=c+1;
        }
        if(s_before==s_after){ sdelta_ok[k]=1 as u8; } else { sdelta_ok[k]=0 as u8; }
        let agreed:i32=mc_double_derive(st,audit,&acount,2000,W_D1LANE,0);
        c=0;
        while(c<8){ mc_seal(st,audit,&acount,c,3000,agreed); c=c+1; }
        // actfault contexts 4..7 must be QUARANTINE (never COMMIT)
        let qok:i32=1;
        c=4;
        while(c<8){ if(tmc_seal(st,c)!=SEAL_QUAR){ qok=0; } c=c+1; }
        if(qok==1){ quar_ok[k]=1 as u8; } else { quar_ok[k]=0 as u8; }
        seal0_st[k]=tmc_seal(st,0) as u8;
        seal0_act[k]=tmc_sealact(st,0) as u8;
        _zag_print("D1_K,");
        tmc_print_i32(k);
        _zag_print(",seal0,");
        tmc_print_i32(tmc_seal(st,0));
        _zag_print(",sealact0,");
        tmc_print_i32(tmc_sealact(st,0));
        _zag_print(",seal1,");
        tmc_print_i32(tmc_seal(st,1));
        _zag_print(",seal4,");
        tmc_print_i32(tmc_seal(st,4));
        _zag_print(",close_writes,");
        tmc_print_i32(wclose);
        _zag_print(",s_before,");
        tmc_print_i32(s_before);
        _zag_print(",s_after,");
        tmc_print_i32(s_after);
        _zag_print(",agreed,");
        tmc_print_i32(agreed);
        _zag_print(",roa,");
        tmc_print_i32(tmc_mget(st,M_ROA));
        _zag_print(",aov,");
        tmc_print_i32(tmc_mget(st,M_AOV));
        _zag_print(",audit_n,");
        tmc_print_i32(acount);
        _zag_println("");
        // cell table for this k
        _zag_print("D1_CELLS,");
        tmc_print_i32(k);
        c=0;
        while(c<8){
            let a:i32=0;
            while(a<3){
                _zag_print(",");
                tmc_print_i32(tmc_cell(st,c,a));
                a=a+1;
            }
            c=c+1;
        }
        _zag_println("");
        tmc_free(st);
        tmc_free(audit);
        k=k+1;
    }
    // ---- D1 verdict ----
    let pass:i32=1;
    let why:i32=0;
    // seal act identical for every k>=1, and it is CONTEST(1) COMMIT
    if((seal0_st[1] as i32)!=SEAL_COMMIT){ pass=0; why=1; }
    if((seal0_act[1] as i32)!=ACT_CONTEST){ pass=0; why=2; }
    k=2;
    while(k<=8){
        if((seal0_st[k] as i32)!=(seal0_st[1] as i32)){ pass=0; why=3; }
        if((seal0_act[k] as i32)!=(seal0_act[1] as i32)){ pass=0; why=4; }
        k=k+1;
    }
    k=0;
    while(k<=8){
        if((sdelta_ok[k] as i32)!=1){ pass=0; why=5; }
        if((quar_ok[k] as i32)!=1){ pass=0; why=6; }
        k=k+1;
    }
    _zag_print("D1_VERDICT,");
    if(pass==1){ _zag_print("PASS"); } else { _zag_print("FAIL,why,"); tmc_print_i32(why); }
    _zag_println("");
    tmc_free(tape);
    tmc_free(seal0_st);
    tmc_free(seal0_act);
    tmc_free(sdelta_ok);
    tmc_free(quar_ok);
    if(pass==1){ return 0; }
    return 1;
}

// q1b_teacher.zag — the Q1B LEARNED teacher: Track 5 arm-B (learned-only) machinery.
//
// The teacher genuinely LEARNS the Zharovia facts through scaffold-and-release:
// a fresh store (fresh-audited by the driver), the same 8-example scaffold the
// Q1 learner took (directives verified by the teacher's OWN world observation
// via q1_scaffold — a directive is never evidence), learner-initiated
// SIGNAL_DISCONNECT, then self-directed deliberate learning from the world
// stimulus tapes. Per tape: slot-scan discovery (the teacher is given NO fact
// list — it finds records itself), 16-alignment + record-decode checks,
// cross-occurrence agreement (all 3 occurrences must decode to the same
// (fid,val); disagreement kills the adoption — the eliminative gate is real
// code, not a comment), eliminative verification (t5_verify over 3
// independent tier-2 OBS legs), deliberate add (t5_add).
//
// ZERO t5_plant calls anywhere in this file: planting facts into the teacher
// would invalidate the leg (the driver audits: 0 T5_OP_PLANT entries). The 12
// false-plant ids never occur in any world tape, so the learned teacher holds
// the 228 true facts — all-true knowledge, strictly cleaner than the planted
// teacher's 228 true + 12 false.
//
// Pure Zag, zero RNG. Deterministic.

// Learn every fact on one stimulus tape by deliberate observation.
// Discovery is slot-scan: no fact list is given. Returns facts deliberately
// added from this tape.
fn q1b_teacher_learn_tape(s:*T5Store,spans:*Q1SpanMap,stim:[]u8)i32 {
    let rf:[]u8=nio_alloc(128*4);
    let rv:[]u8=nio_alloc(128*4);
    let ro:[]u8=nio_alloc(128*4);
    let done:[]u8=nio_alloc(128);
    let nrec:i32=0;
    let sl:i32=0;
    while(sl<Q1_NSLOTS){
        let at:i32=sl*Q1_SLOT;
        let fid:i64=tb_get32(stim,at);
        if(fid>=0 && fid<240){
            // a record-shaped, 16-aligned slot decoding to a valid fact id:
            // a candidate observation (the filler is 0xFF -> fid huge).
            let val:i64=tb_get32(stim,at+4);
            t5_s(rf,nrec*4,fid as i32);
            t5_s(rv,nrec*4,val as i32);
            t5_s(ro,nrec*4,at);
            nrec=nrec+1;
        }
        sl=sl+1;
    }
    let di:i32=0;
    while(di<128){done[di]=0;di=di+1;}
    let learned:i32=0;
    let i:i32=0;
    while(i<nrec){
        if(done[i]==0){
            let fid:i32=t5_g(rf,i*4);
            let first_off:i32=t5_g(ro,i*4);
            // GENERATE the hypothesis from the first occurrence, TEST it
            // against every other occurrence: all must agree on (fid,val).
            let cnt:i32=0;
            let agree:i32=1;
            let j:i32=0;
            while(j<nrec){
                if(t5_g(rf,j*4)==fid){
                    cnt=cnt+1;
                    if(t5_g(rv,j*4)!=t5_g(rv,i*4)){agree=0;}
                }
                j=j+1;
            }
            // ELIMINATE: wrong count or disagreement kills the adoption.
            // (By world construction cnt==3 and agree==1 always hold; the
            // gate is live code, not an assumption.)
            if(cnt==3 && agree==1 && t5_slot_find(s,fid)<0){
                let val:i32=t5_g(rv,i*4);
                // WEIGH: 3 independent observation legs (one per occurrence),
                // tier 2 — the teacher's own world observation is its
                // independent evidence.
                let ev:T5Ev=t5_ev_init(3);
                let jj:i32=0;
                while(jj<nrec){
                    if(t5_g(rf,jj*4)==fid){
                        t5_ev_add(&ev,fid,t5_g(rv,jj*4),T5_EV_OBS,2,-1);
                    }
                    jj=jj+1;
                }
                if(t5_verify(s,&ev,2)==1 && t5_add(s,fid,val,0)==T5_OK){
                    q1_span_set(spans,fid,first_off);
                    learned=learned+1;
                }
                q1_ev_free(&ev);
            }
            // mark this fact's records consumed either way (a refused group
            // is not retried — loud via the learned count, never spun on).
            let kk:i32=0;
            while(kk<nrec){
                if(t5_g(rf,kk*4)==fid){done[kk]=1;}
                kk=kk+1;
            }
        }
        i=i+1;
    }
    nio_free(rf); nio_free(rv); nio_free(ro); nio_free(done);
    return learned;
}

// Build the learned teacher: scaffold-and-release, then self-directed
// deliberate learning of all 228 non-false facts (8 scaffold + 192 curriculum
// + 28 remaining, disjoint probe-id ranges covering [0..227]). The teacher's
// learned span map is written into spans_out (caller-owned, pre-init'd) for
// driver-side honesty checks. Returns the teacher's store.
fn q1b_learned_teacher_build(spans_out:*Q1SpanMap)T5Store {
    let s:T5Store=t5_init(512,4096);
    // learn-gate OPEN: arm-B learns (the driver asserts this).
    // ---- scaffold (arm-B b_build equivalent; directives verified) ----
    let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ:[]u8=nio_alloc(Q1_NSLOTS);
    let offtab:[]u8=nio_alloc(8*3*8);
    let placed:i32=q1_build_stimulus(9,192,8,stim,occ,offtab);
    let ex_fid:[]u8=nio_alloc(32);
    let ex_off:[]u8=nio_alloc(32);
    let ek:i32=0;
    while(ek<8){
        t5_s(ex_fid,ek*4,q1_scaffold_fact(ek));
        t5_s(ex_off,ek*4,tb_i64_get(offtab,(ek*3+0)*8) as i32);
        ek=ek+1;
    }
    let tape:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&tape,512,16384,2048);
    let added:i32=q1_scaffold(&s,spans_out,&tape,stim,ex_fid,ex_off,8);
    _zag_print("Q1B_TEACHER_SCAFFOLD,");
    cl_number(placed as i64); _zag_print(",");
    cl_number(added as i64);
    _zag_println("");
    nio_free(stim); nio_free(occ); nio_free(offtab);
    nio_free(ex_fid); nio_free(ex_off);
    // ---- self-directed learning: 8 curriculum tapes + 1 extra tape ----
    let layout:i32=0;
    while(layout<9){
        let base:i32=layout*24;
        let nf:i32=24;
        if(layout==8){base=200; nf=28;}
        let st2:[]u8=nio_alloc(Q1_TAPE_LEN);
        let oc2:[]u8=nio_alloc(Q1_NSLOTS);
        let ot2:[]u8=nio_alloc(nf*3*8);
        let pl2:i32=q1_build_stimulus(layout,base,nf,st2,oc2,ot2);
        let ln:i32=q1b_teacher_learn_tape(&s,spans_out,st2);
        _zag_print("Q1B_TEACHER_LEARN,");
        cl_number(layout as i64); _zag_print(",");
        cl_number(pl2 as i64); _zag_print(",");
        cl_number(ln as i64); _zag_print(",");
        cl_number(nf as i64);
        _zag_println("");
        nio_free(st2); nio_free(oc2); nio_free(ot2);
        layout=layout+1;
    }
    return s;
}

// The learned teacher teaches only facts it holds, with true claims:
// count curriculum facts (192) present with claim == t5_truth.
fn q1b_teacher_holds_curriculum(s:*T5Store)i32 {
    let bad:i32=0;
    let cs:i32=0;
    while(cs<8){
        let ck:i32=0;
        while(ck<24){
            let fid:i32=q1_slice_fact(cs,ck);
            if(t5_slot_find(s,fid)<0){bad=bad+1;}
            else{if(t5_claim_of(s,fid)!=t5_truth(fid)){bad=bad+1;}}
            ck=ck+1;
        }
        cs=cs+1;
    }
    return bad;
}

// Count held facts whose claim differs from world truth (must be 0: the
// learned teacher's knowledge is all-true — no false plants).
fn q1b_teacher_false_claims(s:*T5Store)i32 {
    let bad:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            if(t5_claim_of(s,id)!=t5_truth(id)){bad=bad+1;}
        }
        id=id+1;
    }
    return bad;
}

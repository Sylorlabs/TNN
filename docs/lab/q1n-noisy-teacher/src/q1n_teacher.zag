// q1n_teacher.zag — the Q1N NOISY teacher: noise injection over the Q1B
// learned teacher.
//
// The noisy teacher starts from the Q1B learned teacher's 228 genuinely
// learned true claims (built by q1b_learned_teacher_build, unchanged) and
// then deterministically flips every 10th claim by fact-id order
// (id % 10 == 0) to a plausible false value. The false value uses the SAME
// construction as t5_plant_claim (the Q2-domain false-plant construction):
//
//     false = t5_base(id) + ((t5_truth(id) - t5_base(id) + 1) % t5_mod(id))
//
// i.e. the true category-relative value plus one, wrapped into the
// category's range — a plausible in-category wrong value, never equal to
// the truth (t5_mod(id) >= 8 in every category).
//
// 228 held claims; ids with id%10==0 among the held set: 23 claims
// (10.09%) — 19 on the 192-fact teaching path, 1 scaffold fact, 3 in the
// extra tape range. (Id 80 also satisfies id%10==0 but is a false-plant id
// the learned teacher never holds.)
//
// The injection is a HARNESS operation (like planting was a trainer
// operation), not a TNN decision: it runs after the teacher's audited
// learning completes, and it is reported on stdout. The teacher's audit
// ledger is untouched (the noise is not learning). No RNG anywhere:
// selection and false values are pure functions of the fact id.
//
// Pure Zag, zero RNG. Deterministic.
@import("t5_core.zag")
@import("q1_world.zag")

// Flip every held claim with id%10==0 to the t5_plant_claim false-value
// construction. Returns the number of claims flipped.
fn q1n_inject_noise(s:*T5Store)i32 {
    let n:i32=0;
    let id:i32=0;
    while(id<240){
        if(id%10==0 && t5_slot_find(s,id)>=0){
            let m:i32=t5_mod(id);
            let b:i32=t5_base(id);
            let t:i32=t5_truth(id);
            let fv:i32=b+((t-b+1)%m);
            t5_claim_set(s,id,fv);
            n=n+1;
        }
        id=id+1;
    }
    return n;
}

// Count held claims whose claim differs from world truth.
fn q1n_false_claims(s:*T5Store)i32 {
    let bad:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            if(t5_claim_of(s,id)!=t5_truth(id)){bad=bad+1;}
        }
        id=id+1;
    }
    return bad;
}

// Count false claims among the facts actually taught on the Q1 leg
// (the 192 curriculum facts across the 8 slices).
fn q1n_false_claims_on_path(s:*T5Store)i32 {
    let bad:i32=0;
    let sl:i32=0;
    while(sl<8){
        let k:i32=0;
        while(k<24){
            let fid:i32=q1_slice_fact(sl,k);
            if(t5_slot_find(s,fid)>=0){
                if(t5_claim_of(s,fid)!=t5_truth(fid)){bad=bad+1;}
            }
            k=k+1;
        }
        sl=sl+1;
    }
    return bad;
}

// Count false claims that are NOT plausible: outside the claim's category
// range, or (impossibly) equal to the truth. Must be 0: the injection uses
// the t5_plant_claim construction, which is in-category by construction.
fn q1n_implausible_false_claims(s:*T5Store)i32 {
    let bad:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            let c:i32=t5_claim_of(s,id);
            let t:i32=t5_truth(id);
            if(c!=t){
                let b:i32=t5_base(id);
                let m:i32=t5_mod(id);
                if(c<b || c>=b+m){bad=bad+1;}
            }
        }
        id=id+1;
    }
    return bad;
}

// Build one teaching stimulus tape from the TEACHER'S held claims
// (non-degenerate realization of "the noisy teacher teaches"): same
// deterministic slot layout as q1_build_stimulus (same record positions,
// same offtab), but each record's value is the teacher's held claim
// t5_claim_of(teacher,fid) rather than world truth. Fact ids are unchanged,
// so the §B.7 flaw schedule (span/form-based) is identical; only the
// semantic content (claim values) carries the teacher's noise. The learner
// has no truth oracle — its §L deliberation checks form against this
// stimulus, so taught false claims are genuinely on the wire.
fn q1n_build_stimulus_teacher(layout:i32,base:i32,nf:i32,stim:[]u8,
                              occ:[]u8,offtab:[]u8,teacher:*T5Store)i32 {
    let i:i32=0;
    while(i<Q1_TAPE_LEN){stim[i]=Q1_FILL as u8;i=i+1;}
    i=0;
    while(i<Q1_NSLOTS){occ[i]=0;i=i+1;}
    let placed:i32=0;
    let k:i32=0;
    while(k<nf){
        let fid:i32=q1_probe_id((base+k)%Q1_PROBE_N);
        let o:i32=0;
        while(o<3){
            let s:i32=q1_slot_of(layout,fid,o,occ);
            if(s>=0){
                occ[s]=1;
                let at:i32=s*Q1_SLOT;
                tb_put32(stim,at,fid as i64);
                tb_put32(stim,at+4,t5_claim_of(teacher,fid) as i64);
                tb_i64_set(offtab,(k*3+o)*8,at as i64);
                placed=placed+1;
            }
            o=o+1;
        }
        k=k+1;
    }
    return placed;
}

// Final filter/absorb accounting over the teacher's 228 claims
// (probe-index based: probe ids 0..191 are the taught curriculum).
// absorbed: taught false claim the learner holds (mirrored the teacher).
// filtered: taught false claim the learner does NOT hold (holds the true
//   value, or holds nothing — genuine filtering).
// untaught: false claims never on the teaching path (probe ids >= 192:
//   scaffold facts are trainer-presented as world truth, extra-tape facts
//   are never taught).
fn q1n_account(teacher:*T5Store,learner:*T5Store,
               abs:*i32,fil:*i32,unt:*i32)void {
    let a:i32=0;
    let f:i32=0;
    let u:i32=0;
    let qk:i32=0;
    while(qk<Q1_PROBE_N){
        let qfid:i32=q1_probe_id(qk);
        let tc:i32=t5_claim_of(teacher,qfid);
        if(tc!=t5_truth(qfid)){
            if(qk<192){
                let lc:i32=t5_claim_of(learner,qfid);
                if(lc==tc){a=a+1;}
                else{f=f+1;}
            }
            else{u=u+1;}
        }
        qk=qk+1;
    }
    abs.*=a; fil.*=f; unt.*=u;
    return;
}

// render_d2.zag — Contender D2 "PLANREF": PAR default + plan-referential
// RESPOND latch. Phase A renders all kind==0 events + bed (pure f(plan,t)).
// Phase B latches each RESPOND: (gate 1) exactly one kind==0 EVENT overlaps
// the source window [w0,w1); (gate 2) cue integrity — re-render the window
// plan-pure into scratch and byte-compare against the phase-A mix (exact,
// no calibration). Then f0 := the cue EVENT's declared f0 (Q16, exact).
// D2 never measures pitch from audio: it is a plan cross-reference, not a
// pitch meter. Pinned znc, zero RNG.
const SR:i64 = 44100;
const NSAMP:i64 = 1323000;
const NEVMAX:i64 = 64;
const EVF:i64 = 13;
const EVSZ:i64 = 104;

// ---------- io ----------
fn cstr(s:[]u8) []u8 {
    if (s.len < 1 || s.len > 4095) { return ""; }
    let p:*u8 = _zag_malloc((s.len + 1) as i64) as *u8;
    if (p == null as *u8) { return ""; }
    let b:[]u8 = p[0..(s.len + 1)];
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn w_all(fd:i64, b:[]u8) i64 {
    let at:i64 = 0;
    let blen:i64 = b.len as i64;
    while (at < blen) {
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(b) as i64) + at, blen - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { return -7407; }
        at = at + n;
    }
    return at;
}
fn file_read(path:[]u8, cap:i64) []u8 {
    let cs:[]u8 = cstr(path);
    if (cs.len == 0) { return ""; }
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 0, 0, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return ""; }
    let p:*u8 = _zag_malloc(cap) as *u8;
    if (p == null as *u8) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return ""; }
    let at:i64 = 0;
    while (at < cap) {
        let n:i64 = _zag_raw_syscall(0, fd, (p as i64) + at, cap - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let b:[]u8 = p[0..at];
    return b;
}
fn file_write(path:[]u8, b:[]u8) i64 {
    let cs:[]u8 = cstr(path);
    if (cs.len == 0) { return -3; }
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 577, 438, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return -4; }
    let wr:i64 = w_all(fd, b);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if (wr < 0) { return -5; }
    return 0;
}
fn pout(s:[]u8) void {
    _zag_raw_syscall(1, 1, (_zag_slice_ptr(s) as i64), (s.len as i64), 0, 0, 0);
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if (s.len > 0) {
        if (s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    }
    return s;
}

// ---------- 64-bit arena slots (byte offset) ----------
fn nio_alloc(n:i32) []u8 {
    if (n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if (p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i32 = 0;
    while (i < n) { b[i] = 0; i = i + 1; }
    return b;
}
fn nio_free(b:[]u8) void { if (b.len > 0) { _zag_free(_zag_slice_ptr(b)); } }
fn put64(b:[]u8, i:i64, v:i64) void {
    b[i] = (v & 255) as u8;
    b[i+1] = ((v >> 8) & 255) as u8;
    b[i+2] = ((v >> 16) & 255) as u8;
    b[i+3] = ((v >> 24) & 255) as u8;
    b[i+4] = ((v >> 32) & 255) as u8;
    b[i+5] = ((v >> 40) & 255) as u8;
    b[i+6] = ((v >> 48) & 255) as u8;
    b[i+7] = ((v >> 56) & 255) as u8;
}
fn get64(b:[]u8, i:i64) i64 {
    return (b[i] as i64) | ((b[i+1] as i64) << 8) | ((b[i+2] as i64) << 16) | ((b[i+3] as i64) << 24) | ((b[i+4] as i64) << 32) | ((b[i+5] as i64) << 40) | ((b[i+6] as i64) << 48) | ((b[i+7] as i64) << 56);
}
fn evg(ev:[]u8, e:i64, f:i64) i64 { return get64(ev, e * EVSZ + f * 8); }
fn evs(ev:[]u8, e:i64, f:i64, v:i64) void { put64(ev, e * EVSZ + f * 8, v); }

// ---------- sine: quadrant polynomial (f64), 1024-entry Q15 LUT ----------
fn fsin_q(x:f64) f64 {
    let t:f64 = x;
    let s:f64 = 1.0;
    if (t >= 3.141592653589793) { t = t - 3.141592653589793; s = -1.0; }
    if (t >= 1.5707963267948966) { t = 3.141592653589793 - t; }
    let x2:f64 = t * t;
    let x3:f64 = x2 * t;
    let x5:f64 = x3 * x2;
    let x7:f64 = x5 * x2;
    let x9:f64 = x7 * x2;
    return s * (t - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0 + x9 / 362880.0);
}
fn lut_init(lut:[]u8) void {
    let i:i64 = 0;
    while (i < 1024) {
        let s:f64 = fsin_q(6.283185307179586 * (i as f64) / 1024.0);
        put64(lut, i * 8, (s * 32767.0) as i64);
        i = i + 1;
    }
}
fn lsin(lut:[]u8, idx:i64) i64 { return get64(lut, (idx & 1023) * 8); }

// ---------- ascii float ----------
fn atof(s:[]u8, st:i64, en:i64) f64 {
    let neg:f64 = 1.0;
    let v:f64 = 0.0;
    let i:i64 = st;
    if (i < en && s[i] == 45) { neg = -1.0; i = i + 1; }
    while (i < en && s[i] >= 48 && s[i] <= 57) { v = v * 10.0 + ((s[i] - 48) as f64); i = i + 1; }
    if (i < en && s[i] == 46) {
        i = i + 1;
        let div:f64 = 10.0;
        while (i < en && s[i] >= 48 && s[i] <= 57) { v = v + ((s[i] - 48) as f64) / div; div = div * 10.0; i = i + 1; }
    }
    return neg * v;
}
fn pow2(x:f64) f64 {
    // 2^x for x in [-1,1] via taylor on e^(x ln2)
    let y:f64 = x * 0.6931471805599453;
    let t:f64 = 1.0;
    let term:f64 = 1.0;
    let k:i64 = 1;
    while (k <= 12) {
        term = term * y / (k as f64);
        t = t + term;
        k = k + 1;
    }
    return t;
}

// ---------- plan parse ----------
// event fields: 0 t0 1 dur 2 f0q16 3 ampq16 4 tim 5 glideq16
//               6 vibinc_q32 7 vibbeta_q32 8 kind 9 rspw0 10 rspw1 11 nomq16
//               12 latched (D2: 1 once the RESPOND latch has resolved it)
fn parse_plan(path:[]u8, ev:[]u8, bed:[]u8) i64 {
    let raw:[]u8 = file_read(path, 65536);
    if (raw.len == 0) { return -1; }
    let nev:i64 = 0;
    let pos:i64 = 0;
    let n:i64 = raw.len as i64;
    while (pos < n) {
        let le:i64 = pos;
        while (le < n && raw[le] != 10) { le = le + 1; }
        if (le > pos && raw[pos] != 35) {
            // tokenize: first token
            let p:i64 = pos;
            while (p < le && raw[p] == 32) { p = p + 1; }
            let t0s:i64 = p;
            while (p < le && raw[p] != 32) { p = p + 1; }
            let t0e:i64 = p;
            // collect up to 9 numeric fields
            let f:[]u8 = nio_alloc(72);
            let nf:i64 = 0;
            while (p < le && nf < 9) {
                while (p < le && raw[p] == 32) { p = p + 1; }
                if (p >= le) { break; }
                let fs:i64 = p;
                while (p < le && raw[p] != 32) { p = p + 1; }
                put64(f, nf * 8, ((atof(raw, fs, p) * 65536.0) as i64));
                nf = nf + 1;
            }
            if (t0e - t0s == 3 && raw[t0s] == 66 && raw[t0s+1] == 69 && raw[t0s+2] == 68) {
                // BED t0 t1 freq amp
                if (nf >= 4) {
                    put64(bed, 0, (get64(f, 0) * SR) / 65536);
                    put64(bed, 8, (get64(f, 8) * SR) / 65536);
                    put64(bed, 16, get64(f, 16));
                    put64(bed, 24, get64(f, 24) / 1000);
                }
            }
            if (t0e - t0s == 5 && raw[t0s] == 69 && raw[t0s+1] == 86 && raw[t0s+2] == 69 && raw[t0s+3] == 78 && raw[t0s+4] == 84) {
                // EVENT t0 dur freq amp timbre glide vibhz vibc
                if (nf >= 8 && nev < NEVMAX) {
                    evs(ev, nev, 0, (get64(f, 0) * SR) / 65536);
                    evs(ev, nev, 1, (get64(f, 8) * SR) / 65536);
                    evs(ev, nev, 2, get64(f, 16));
                    evs(ev, nev, 3, get64(f, 24) / 1000);
                    evs(ev, nev, 4, get64(f, 32) / 65536);
                    evs(ev, nev, 5, get64(f, 40));
                    let vibhz:f64 = (get64(f, 48) as f64) / 65536.0;
                    let vibc:f64 = (get64(f, 56) as f64) / 65536.0;
                    let f0:f64 = (get64(f, 16) as f64) / 65536.0;
                    let df:f64 = f0 * (pow2(vibc / 1200.0) - 1.0);
                    let beta:f64 = 0.0;
                    if (vibhz > 0.001) { beta = df / vibhz; }
                    evs(ev, nev, 6, (vibhz * 4294967296.0 / (SR as f64)) as i64);
                    evs(ev, nev, 7, (beta * 4294967296.0) as i64);
                    evs(ev, nev, 8, 0);
                    nev = nev + 1;
                }
            }
            if (t0e - t0s == 7 && raw[t0s] == 82 && raw[t0s+1] == 69 && raw[t0s+2] == 83 && raw[t0s+3] == 80 && raw[t0s+4] == 79 && raw[t0s+5] == 78 && raw[t0s+6] == 68) {
                // RESPOND t0 dur w0 w1 amp timbre nominal
                if (nf >= 7 && nev < NEVMAX) {
                    evs(ev, nev, 0, (get64(f, 0) * SR) / 65536);
                    evs(ev, nev, 1, (get64(f, 8) * SR) / 65536);
                    evs(ev, nev, 2, get64(f, 48));
                    evs(ev, nev, 3, get64(f, 32) / 1000);
                    evs(ev, nev, 4, get64(f, 40) / 65536);
                    evs(ev, nev, 5, 0);
                    evs(ev, nev, 6, 0);
                    evs(ev, nev, 7, 0);
                    evs(ev, nev, 8, 1);
                    evs(ev, nev, 9, (get64(f, 16) * SR) / 65536);
                    evs(ev, nev, 10, (get64(f, 24) * SR) / 65536);
                    evs(ev, nev, 11, get64(f, 48));
                    nev = nev + 1;
                }
            }
            nio_free(f);
        }
        pos = le + 1;
    }
    return nev;
}

// ---------- pure voice: sample t of event e (zero carried state) ----------
fn voice_q16(ev:[]u8, lut:[]u8, e:i64, t:i64) i64 {
    let t0:i64 = evg(ev, e, 0);
    let dur:i64 = evg(ev, e, 1);
    let tr:i64 = t - t0;
    if (tr < 0 || tr >= dur || dur <= 0) { return 0; }
    let f0q:i64 = evg(ev, e, 2);
    let ampq:i64 = evg(ev, e, 3);
    let tim:i64 = evg(ev, e, 4);
    let glideq:i64 = evg(ev, e, 5);
    let vinc:i64 = evg(ev, e, 6);
    let vbeta:i64 = evg(ev, e, 7);
    if (tim < 1) { tim = 1; }
    if (tim > 13) { tim = 13; }
    // envelope: 40 ms attack / 150 ms release raised cosine, capped at dur/2
    let atk:i64 = 1764;
    if (dur / 2 < atk) { atk = dur / 2; }
    let rel:i64 = 6615;
    if (dur / 2 < rel) { rel = dur / 2; }
    let envq:i64 = 65536;
    if (tr < atk && atk > 0) {
        let x:i64 = (tr * 1024) / atk;
        envq = 32768 - lsin(lut, 256 + x / 2);
    } else {
        let rem:i64 = dur - tr;
        if (rem < rel && rel > 0) {
            let x:i64 = (rem * 1024) / rel;
            envq = 32768 + lsin(lut, 256 + x / 2);
        }
    }
    // phase in cycles Q32: f0*tr/SR + glide*tr^2/(2*dur*SR), pure fn of t
    let ph:i64 = ((f0q * tr) / SR) * 65536;
    if (glideq != 0) {
        let g1:i64 = (glideq * tr) / dur;
        ph = ph + ((g1 * tr) / (2 * SR)) * 65536;
    }
    // vibrato PM: beta * sin(2*pi*fv*tr), pure fn of t
    if (vbeta != 0 && vinc != 0) {
        let vph:i64 = vinc * tr;
        vph = vph - (vph / 4294967296) * 4294967296;
        let vs:i64 = lsin(lut, (vph / 4194304) & 1023);
        ph = ph + (vbeta * vs) / 32768;
    }
    // wrap to [0, 2^32)
    ph = ph - (ph / 4294967296) * 4294967296;
    if (ph < 0) { ph = ph + 4294967296; }
    let acc:i64 = 0;
    let hsum:i64 = 0;
    let h:i64 = 1;
    while (h <= tim) {
        let idx:i64 = ((ph * h) / 4194304) & 1023;
        acc = acc + (65536 / h) * lsin(lut, idx);
        hsum = hsum + 65536 / h;
        h = h + 1;
    }
    // normalize the harmonic stack: voice peak ~= amp (not amp * sum(1/h))
    acc = (acc * 65536) / hsum;
    let v:i64 = (acc * envq) / 2147483648;
    v = (v * ampq) / 65536;
    return v;
}
fn bed_q16(bed:[]u8, lut:[]u8, t:i64) i64 {
    let b0:i64 = get64(bed, 0);
    let b1:i64 = get64(bed, 8);
    if (t < b0 || t >= b1) { return 0; }
    let fq:i64 = get64(bed, 16);
    let ampq:i64 = get64(bed, 24);
    // 25 ms raised-cosine edge fades
    let ed:i64 = 1102;
    let envq:i64 = 65536;
    let tin:i64 = t - b0;
    if (tin < ed) {
        let x:i64 = (tin * 1024) / ed;
        envq = 32768 - lsin(lut, 256 + x / 2);
    } else {
        let tout:i64 = b1 - t;
        if (tout < ed) {
            let x:i64 = (tout * 1024) / ed;
            envq = 32768 + lsin(lut, 256 + x / 2);
        }
    }
    let ph:i64 = ((fq * t) / SR) * 65536;
    ph = ph - (ph / 4294967296) * 4294967296;
    if (ph < 0) { ph = ph + 4294967296; }
    let acc:i64 = 0;
    let hsum:i64 = 0;
    let h:i64 = 1;
    while (h <= 3) {
        let idx:i64 = ((ph * h) / 4194304) & 1023;
        acc = acc + (65536 / h) * lsin(lut, idx);
        hsum = hsum + 65536 / h;
        h = h + 1;
    }
    acc = (acc * 65536) / hsum;
    let v:i64 = (acc * envq) / 2147483648;
    v = (v * ampq) / 65536;
    return v;
}

// ---------- wav ----------
fn wav_write(path:[]u8, mix:[]u8, nsamp:i64) i64 {
    // peak normalize to 0.85 FS
    let peak:i64 = 0;
    let i:i64 = 0;
    while (i < nsamp) {
        let v:i64 = get64(mix, i * 8);
        if (v < 0) { v = 0 - v; }
        if (v > peak) { peak = v; }
        i = i + 1;
    }
    if (peak == 0) { peak = 1; }
    pout("PAR mix peak_q16: ");
    pout(i64s(peak));
    pout("\n");
    let total:i64 = 44 + nsamp * 2;
    let out:[]u8 = nio_alloc(total as i32);
    if (out.len == 0) { return -11; }
    out[0] = 82; out[1] = 73; out[2] = 70; out[3] = 70;
    let sz:i64 = 36 + nsamp * 2;
    out[4] = (sz & 255) as u8; out[5] = ((sz >> 8) & 255) as u8;
    out[6] = ((sz >> 16) & 255) as u8; out[7] = ((sz >> 24) & 255) as u8;
    out[8] = 87; out[9] = 65; out[10] = 86; out[11] = 69;
    out[12] = 102; out[13] = 109; out[14] = 116; out[15] = 32;
    out[16] = 16; out[17] = 0; out[18] = 0; out[19] = 0;
    out[20] = 1; out[21] = 0;
    out[22] = 1; out[23] = 0;
    out[24] = 68; out[25] = 172; out[26] = 0; out[27] = 0;
    out[28] = 136; out[29] = 88; out[30] = 1; out[31] = 0;
    out[32] = 2; out[33] = 0;
    out[34] = 16; out[35] = 0;
    out[36] = 100; out[37] = 97; out[38] = 116; out[39] = 97;
    let ds:i64 = nsamp * 2;
    out[40] = (ds & 255) as u8; out[41] = ((ds >> 8) & 255) as u8;
    out[42] = ((ds >> 16) & 255) as u8; out[43] = ((ds >> 24) & 255) as u8;
    i = 0;
    while (i < nsamp) {
        let v:i64 = (get64(mix, i * 8) * 27852) / peak;
        if (v > 32767) { v = 32767; }
        if (v < -32768) { v = -32768; }
        if (v < 0) { v = v + 65536; }
        let o:i64 = 44 + i * 2;
        out[o] = (v & 255) as u8;
        out[o+1] = ((v >> 8) & 255) as u8;
        i = i + 1;
    }
    let rc:i64 = file_write(path, out);
    nio_free(out);
    return rc;
}

// raw mix dump (s32 LE, no mastering): for content-identity checks at the
// MIX level — global peak normalization would mask generation differences.
fn mix_write(path:[]u8, mix:[]u8, nsamp:i64) i64 {
    let total:i64 = nsamp * 4;
    let out:[]u8 = nio_alloc(total as i32);
    if (out.len == 0) { return -11; }
    let i:i64 = 0;
    while (i < nsamp) {
        let v:i64 = get64(mix, i * 8);
        if (v > 2147483647) { v = 2147483647; }
        if (v < -2147483648) { v = -2147483648; }
        if (v < 0) { v = v + 4294967296; }
        let o:i64 = i * 4;
        out[o] = (v & 255) as u8;
        out[o+1] = ((v >> 8) & 255) as u8;
        out[o+2] = ((v >> 16) & 255) as u8;
        out[o+3] = ((v >> 24) & 255) as u8;
        i = i + 1;
    }
    let rc:i64 = file_write(path, out);
    nio_free(out);
    return rc;
}

fn str_eq(a:[]u8, b:[]u8) i64 {
    if (a.len != b.len) { return 0; }
    let i:i64 = 0;
    while (i < a.len as i64) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// render a sample-range [lo,hi) of events; phase 0 = unlatched kind==0
// events only, phase 2 = latched RESPONDs only (kind==0, field12==1).
// voice_q16 is a pure function of (plan, t): no carried state anywhere.
fn render_events(ev:[]u8, lut:[]u8, mix:[]u8, nev:i64, order:i64, lo:i64, hi:i64, phase:i64) void {
    let e:i64 = 0;
    while (e < nev) {
        let t0:i64 = evg(ev, e, 0);
        let dur:i64 = evg(ev, e, 1);
        let kind:i64 = evg(ev, e, 8);
        let lat:i64 = evg(ev, e, 12);
        if (phase == 0) {
            if (kind != 0 || lat != 0) { e = e + 1; continue; }
        } else {
            if (kind != 0 || lat != 1) { e = e + 1; continue; }
        }
        let a:i64 = t0;
        if (a < lo) { a = lo; }
        let b:i64 = t0 + dur;
        if (b > hi) { b = hi; }
        if (b > NSAMP) { b = NSAMP; }
        if (a < b) {
            if (order == 1 || order == 4) {
                let t:i64 = b - 1;
                while (t >= a) {
                    put64(mix, t * 8, get64(mix, t * 8) + voice_q16(ev, lut, e, t));
                    t = t - 1;
                }
            } else if (order == 2) {
                let span:i64 = b - a;
                let k:i64 = 0;
                while (k < span) {
                    let t:i64 = a + (k * 7919) % span;
                    put64(mix, t * 8, get64(mix, t * 8) + voice_q16(ev, lut, e, t));
                    k = k + 1;
                }
            } else {
                let t:i64 = a;
                while (t < b) {
                    put64(mix, t * 8, get64(mix, t * 8) + voice_q16(ev, lut, e, t));
                    t = t + 1;
                }
            }
        }
        e = e + 1;
    }
}
fn render_bed(bed:[]u8, lut:[]u8, mix:[]u8, lo:i64, hi:i64) void {
    let bt0:i64 = get64(bed, 0);
    let bt1:i64 = get64(bed, 8);
    let a:i64 = bt0;
    if (a < lo) { a = lo; }
    let b:i64 = bt1;
    if (b > hi) { b = hi; }
    if (b > NSAMP) { b = NSAMP; }
    let t:i64 = a;
    while (t < b) {
        put64(mix, t * 8, get64(mix, t * 8) + bed_q16(bed, lut, t));
        t = t + 1;
    }
}

// ---------- D2 latch machinery ----------
// forward-only render of one kind==0 event's [lo,hi) into dst at (t-off)*8
fn render_one_range(ev:[]u8, lut:[]u8, dst:[]u8, e:i64, lo:i64, hi:i64, off:i64) void {
    let t0:i64 = evg(ev, e, 0);
    let dur:i64 = evg(ev, e, 1);
    let a:i64 = t0;
    if (a < lo) { a = lo; }
    let b:i64 = t0 + dur;
    if (b > hi) { b = hi; }
    let t:i64 = a;
    while (t < b) {
        let di:i64 = (t - off) * 8;
        put64(dst, di, get64(dst, di) + voice_q16(ev, lut, e, t));
        t = t + 1;
    }
}

// D2 phase B: plan-referential RESPOND latch.
// Gate 1 (plan-level): exactly one kind==0 EVENT overlaps [w0,w1).
// Gate 2 (cue integrity, NOT a pitch meter): re-render [w0,w1) plan-pure
// into scratch and byte-compare vs the phase-A mix window; any differing
// sample -> abstain. On latch: f0 := cue's declared f0 (Q16, exact).
// Else: f0 := plan nominal (field 11). Field 11 is inert provenance.
fn latch_respond(ev:[]u8, lut:[]u8, bed:[]u8, mix:[]u8, nev:i64) void {
    let e:i64 = 0;
    while (e < nev) {
        if (evg(ev, e, 8) == 1) {
            let w0:i64 = evg(ev, e, 9);
            let w1:i64 = evg(ev, e, 10);
            if (w0 < 0) { w0 = 0; }
            if (w1 > NSAMP) { w1 = NSAMP; }
            let code:i64 = 0;
            let cue:i64 = -1;
            let ncue:i64 = 0;
            let c:i64 = 0;
            while (c < nev) {
                if (evg(ev, c, 8) == 0 && evg(ev, c, 12) == 0) {
                    let ct0:i64 = evg(ev, c, 0);
                    let cd:i64 = evg(ev, c, 1);
                    if (ct0 < w1 && ct0 + cd > w0) { ncue = ncue + 1; cue = c; }
                }
                c = c + 1;
            }
            if (ncue != 1) { code = 1; }
            let span:i64 = w1 - w0;
            if (code == 0 && (span < 1 || span > 4 * SR)) { code = 2; }
            if (code == 0) {
                let scr:[]u8 = nio_alloc((span * 8) as i32);
                if (scr.len == 0) {
                    code = 2;
                } else {
                    let cc:i64 = 0;
                    while (cc < nev) {
                        if (evg(ev, cc, 8) == 0 && evg(ev, cc, 12) == 0) {
                            render_one_range(ev, lut, scr, cc, w0, w1, w0);
                        }
                        cc = cc + 1;
                    }
                    let bb0:i64 = get64(bed, 0);
                    let bb1:i64 = get64(bed, 8);
                    let t:i64 = w0;
                    while (t < w1) {
                        if (t >= bb0 && t < bb1) {
                            let di:i64 = (t - w0) * 8;
                            put64(scr, di, get64(scr, di) + bed_q16(bed, lut, t));
                        }
                        t = t + 1;
                    }
                    let j:i64 = 0;
                    let bad:i64 = 0;
                    while (j < span && bad == 0) {
                        if (get64(scr, j * 8) != get64(mix, (w0 + j) * 8)) { bad = 1; }
                        j = j + 1;
                    }
                    if (bad == 1) { code = 3; }
                    nio_free(scr);
                }
            }
            if (code == 0) {
                let f0q:i64 = evg(ev, cue, 2);
                evs(ev, e, 2, f0q);
                evs(ev, e, 8, 0);
                evs(ev, e, 12, 1);
                pout("D2 RESPOND e=");
                pout(i64s(e));
                pout(" cue=");
                pout(i64s(cue));
                pout(" LATCHED f0q=");
                pout(i64s(f0q));
                pout("\n");
            } else {
                evs(ev, e, 2, evg(ev, e, 11));
                evs(ev, e, 8, 0);
                evs(ev, e, 12, 1);
                pout("D2 RESPOND e=");
                pout(i64s(e));
                pout(" ABSTAIN code=");
                pout(i64s(code));
                pout("\n");
            }
        }
        e = e + 1;
    }
}

fn main() i32 {
    let planp:[]u8 = _zag_arg(1);
    if (planp.len == 0) { planp = "../fixture/plan_v1.txt"; }
    let outp:[]u8 = _zag_arg(2);
    if (outp.len == 0) { outp = "out_par.wav"; }
    let mode:[]u8 = _zag_arg(3);
    // D2 order mode (phase A visit order): seq | rev | stride ;
    // "seq+mix" dumps the raw mix ; "faultmix" = RT-CASCADE fault flow ;
    // "susfaultmix" = sustained 1292-block corruption before the latch.
    let order:i64 = 0;
    if (str_eq(mode, "rev")) { order = 1; }
    if (str_eq(mode, "stride")) { order = 2; }

    let lut:[]u8 = nio_alloc(8192);
    lut_init(lut);
    let ev:[]u8 = nio_alloc((NEVMAX * EVSZ) as i32);
    let z:i64 = 0;
    while (z < (NEVMAX * EVSZ) as i64) { ev[z] = 0; z = z + 1; }
    let bed:[]u8 = nio_alloc(32);
    z = 0;
    while (z < 32) { bed[z] = 0; z = z + 1; }
    let nev:i64 = parse_plan(planp, ev, bed);
    pout("PAR events parsed: ");
    pout(i64s(nev));
    pout("\n");
    if (nev < 0) { return 3; }

    let mix:[]u8 = nio_alloc((NSAMP * 8) as i32);
    if (mix.len == 0) { return 4; }
    z = 0;
    while (z < (NSAMP * 8) as i64) { mix[z] = 0; z = z + 1; }

    // D2 three phases: A = PAR render of kind==0 events + bed ;
    // B = plan-referential RESPOND latch ; C = render latched RESPONDs.
    if (str_eq(mode, "faultmix")) {
        // RT-CASCADE: phase-A pre-cut, corrupt the mix at t=3 s, phase-A
        // post-cut. Generation never reads the mix, so post-cut samples
        // must be bit-identical to clean. The latch's integrity window
        // [w0,w1) is pre-cut and clean, so the latch still fires.
        let cut:i64 = 3 * SR;
        render_events(ev, lut, mix, nev, order, 0, cut, 0);
        render_bed(bed, lut, mix, 0, cut);
        let j:i64 = 0;
        while (j < 64) {
            put64(mix, (cut + j) * 8, get64(mix, (cut + j) * 8) ^ 2147483647);
            j = j + 1;
        }
        pout("D2 fault injected at t=3s; generating post-cut samples\n");
        render_events(ev, lut, mix, nev, order, cut, NSAMP, 0);
        render_bed(bed, lut, mix, cut, NSAMP);
        latch_respond(ev, lut, bed, mix, nev);
        render_events(ev, lut, mix, nev, order, 0, NSAMP, 2);
    } else if (str_eq(mode, "susfaultmix")) {
        // Sustained adversarial fault (red team): 64-sample bit-flip in
        // EVERY 1024-sample block, injected between phase A and the latch.
        // Gate 2 must see the cue window != plan-pure and abstain.
        render_events(ev, lut, mix, nev, order, 0, NSAMP, 0);
        render_bed(bed, lut, mix, 0, NSAMP);
        let blk:i64 = 0;
        while (blk * 1024 < NSAMP) {
            let j:i64 = 0;
            while (j < 64) {
                let t:i64 = blk * 1024 + j;
                if (t < NSAMP) { put64(mix, t * 8, get64(mix, t * 8) ^ 2147483647); }
                j = j + 1;
            }
            blk = blk + 1;
        }
        pout("D2 sustained fault injected (all blocks)\n");
        latch_respond(ev, lut, bed, mix, nev);
        render_events(ev, lut, mix, nev, order, 0, NSAMP, 2);
    } else {
        render_events(ev, lut, mix, nev, order, 0, NSAMP, 0);
        render_bed(bed, lut, mix, 0, NSAMP);
        latch_respond(ev, lut, bed, mix, nev);
        render_events(ev, lut, mix, nev, order, 0, NSAMP, 2);
    }

    let rc:i64 = 0;
    if (str_eq(mode, "faultmix")) {
        // mix-level fault run: caller compares against the clean mix
        rc = mix_write(outp, mix, NSAMP);
    } else if (str_eq(mode, "susfaultmix")) {
        rc = mix_write(outp, mix, NSAMP);
    } else if (str_eq(mode, "seq+mix")) {
        rc = mix_write(outp, mix, NSAMP);
    } else {
        rc = wav_write(outp, mix, NSAMP);
    }
    pout("PAR wrote ");
    pout(outp);
    pout(" rc=");
    pout(i64s(rc));
    pout("\n");
    return 0;
}

            f3_build(arg, 21 + w);
            _zag_print("GBMP rc=");
            _zag_println(_zag_i64_to_str(f3_emit_bmp_g(arg, a2, w)));
            nio_free(arg);
            w = w + 1;
        }
        return 0;
    }
    // PROOF SCAFFOLDING (gamma repair, 2026-09-24): not emitter behavior.
    // Builds song field A and field B = A + one extra loud frame, emits both
    // through f3_emit_wav and f3_emit_wav_hifi. Post-hoc check (Python):
    // PCM prefix bytes (samples before the appended frame) of B must equal
    // those of A under plan-pure gain; under the old output-derived
    // normalizer they differ because the loud tail rescales the whole file.
    if (_zag_strcmp(a1, "f3gammaproof") == 1) {
        if (a2.len == 0) {
            _zag_println("error=f3gammaproof-needs-outdir");
            return 1;
        }
        let lutp:[]u8 = nio_alloc(512);
        j2_sin_init(lutp);
        let fa:[]u8 = nio_alloc(24576);
        f3_build(fa, 17);
        let fr:i64 = f3_frames(fa);
        let fb:[]u8 = nio_alloc(24576);
        let cw:i64 = 0;
        while (cw < 6144) { f3_put32(fb, cw, f3_get32(fa, cw)); cw = cw + 1; }
        f3_put32(fb, 2, fr + 1);
        let bb2:i64 = 0;
        while (bb2 < 48) {
            f3_acellput(fb, fr, bb2, 2000);
            f3_abriput(fb, fr, bb2, 1000);
            bb2 = bb2 + 1;
        }
        _zag_print("PROOFA wav rc=");
        _zag_println(_zag_i64_to_str(f3_emit_wav(fa, a2, 20, lutp)));
        _zag_print("PROOFB wav rc=");
        _zag_println(_zag_i64_to_str(f3_emit_wav(fb, a2, 21, lutp)));
        _zag_print("PROOFA hifi rc=");
        _zag_println(_zag_i64_to_str(f3_emit_wav_hifi(fa, a2, 22, lutp)));
        _zag_print("PROOFB hifi rc=");
        _zag_println(_zag_i64_to_str(f3_emit_wav_hifi(fb, a2, 23, lutp)));
        nio_free(fa);
        nio_free(fb);
        nio_free(lutp);
        return 0;
    }

    // CREW GAMMA diagnostics (experiment scaffolding, not emitter behavior):
    // f3mixpeak prints the unclipped mix peak per hifi fixture;
    // f3mixdump writes raw s32 pre-emit mixes (mix-level identity checks).
    if (_zag_strcmp(a1, "f3mixpeak") == 1) {
        let lutd:[]u8 = nio_alloc(512);
        j2_sin_init(lutd);
        let ahd:[]u8 = nio_alloc(24576);
        f3_build(ahd, 17);
        _zag_print("MIXPEAK song ");
        _zag_println(_zag_i64_to_str(f3_mixpeak(ahd, lutd)));
        let md2:i64 = 0;
        while (md2 < 3) {
            f3_gen_mood(ahd, md2);
            _zag_print("MIXPEAK mood ");
            _zag_print(_zag_i64_to_str(md2));
            _zag_print(" ");
            _zag_println(_zag_i64_to_str(f3_mixpeak(ahd, lutd)));
            md2 = md2 + 1;
        }
        nio_free(ahd);
        nio_free(lutd);
        return 0;
    }
    if (_zag_strcmp(a1, "f3mixdump") == 1) {
        if (a2.len == 0) {
            _zag_println("error=f3mixdump-needs-outdir");
            return 1;
        }
        let lute:[]u8 = nio_alloc(512);
        j2_sin_init(lute);
        let ahe:[]u8 = nio_alloc(24576);
        f3_build(ahe, 17);
        _zag_print("MIXDUMP song rc=");
        _zag_println(_zag_i64_to_str(f3_mixdump_one(ahe, a2, "mix_song.s32", lute)));
        let md3:i64 = 0;
        while (md3 < 3) {
            f3_gen_mood(ahe, md3);
            _zag_print("MIXDUMP mood ");
            _zag_print(_zag_i64_to_str(md3));
            _zag_print(" rc=");
            let nm:[]u8 = "mix_mood0.s32";
            if (md3 == 1) { nm = "mix_mood1.s32"; }
            if (md3 == 2) { nm = "mix_mood2.s32"; }
            _zag_println(_zag_i64_to_str(f3_mixdump_one(ahe, a2, nm, lute)));
            md3 = md3 + 1;
        }
        nio_free(ahe);
        nio_free(lute);
        return 0;
    }
    _zag_println("error=unknown-cmd");
    return 1;
}
// ============================================================

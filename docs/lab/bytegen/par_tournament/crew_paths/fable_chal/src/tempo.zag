// tempo.zag — TEMPO-1 challenger (fable R1 Q4): object tracking coherence.
// 300-frame video, red ball constant-velocity left-to-right, radius 50 px,
// static white background. PAR (pure pixel fn) vs B (plan-seeded per-frame
// color state). Emits raw RGB frames + per-frame red-mask centroid sidecar.
// Pure Zag, zero RNG, pinned znc. Fixed-point q8 ball center (no floats).
// argv: <par|b> <out.raw> [seq|scr]

fn z_alloc(n:i64) []u8 {
    if (n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n as i32) as *u8;
    if (p == null as *u8) { return ""; }
    let b:[]u8 = p[0..(n as i32)];
    let i:i64 = 0;
    while (i < n) { b[i] = 0 as u8; i = i + 1; }
    return b;
}
fn z_free(b:[]u8) void {
    if (b.len > 0) { _zag_free(_zag_slice_ptr(b)); }
}
fn z_cstr(d:[]u8, s:[]u8) void {
    let i:i64 = 0;
    while (i < s.len) { d[i] = s[i]; i = i + 1; }
    d[i] = 0 as u8;
}
fn f_open_w(path:[]u8) i64 {
    let buf:[]u8 = z_alloc(path.len + 1);
    if (buf.len == 0) { return -1; }
    z_cstr(buf, path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(buf) as i64, 577, 420, 0, 0, 0);
    z_free(buf);
    return fd;
}
fn f_close(fd:i64) void {
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
}
fn f_write_all(fd:i64, b:[]u8) i64 {
    let o:i64 = 0;
    while (o < b.len) {
        let w:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(b) as i64) + o, b.len - o, 0, 0, 0);
        if (w <= 0) { return -1; }
        o = o + w;
    }
    return 0;
}
// decimal append of i64 into buf at pos; returns new pos
fn dec_app(buf:[]u8, pos:i64, v:i64) i64 {
    if (v == 0) { buf[pos] = 48 as u8; return pos + 1; }
    let neg:i64 = 0;
    if (v < 0) { neg = 1; v = 0 - v; }
    let tmp:[]u8 = z_alloc(24);
    let n:i64 = 0;
    while (v > 0) {
        tmp[n] = ((v % 10) + 48) as u8;
        v = v / 10;
        n = n + 1;
    }
    if (neg == 1) { buf[pos] = 45 as u8; pos = pos + 1; }
    while (n > 0) {
        n = n - 1;
        buf[pos] = tmp[n];
        pos = pos + 1;
    }
    z_free(tmp);
    return pos;
}

// plan: ball center q8. cx(f) = 60*256 + 171*f ; cy = 120*256
fn plan_cx(f:i64) i64 {
    return 15360 + 171 * f;
}

// render frame f into fb (W*H*3); accumulate red-mask centroid sums.
fn render_frame(f:i64, W:i64, H:i64, R2q:i64, is_b:i64, fb:[]u8, o_sumx:*i64, o_cnt:*i64) void {
    let cx:i64 = plan_cx(f);
    let cy:i64 = 30720;
    let l0:i64 = (f * 37) % 256;
    let l1:i64 = (f * 53 + 11) % 256;
    let l2:i64 = (f * 91 + 5) % 256;
    let sumx:i64 = 0;
    let cnt:i64 = 0;
    let y:i64 = 0;
    while (y < H) {
        let dy:i64 = y * 256 - cy;
        let x:i64 = 0;
        while (x < W) {
            let dx:i64 = x * 256 - cx;
            let r:i64 = 255;
            let g:i64 = 255;
            let b:i64 = 255;
            if (dx * dx + dy * dy <= R2q) {
                if (is_b == 1) {
                    r = 192 + l0 / 4;
                    g = l1 / 8;
                    b = l2 / 8;
                } else {
                    r = 255;
                    g = 0;
                    b = 0;
                }
            }
            let o:i64 = (y * W + x) * 3;
            fb[o] = r as u8;
            fb[o + 1] = g as u8;
            fb[o + 2] = b as u8;
            if (r > g + 100 && r > b + 100 && r > 150) {
                sumx = sumx + x;
                cnt = cnt + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    o_sumx.* = sumx;
    o_cnt.* = cnt;
}

// sidecar path = outp + ".cen"
fn cen_path(outp:[]u8) []u8 {
    let cenp:[]u8 = z_alloc(outp.len + 5);
    let i:i64 = 0;
    while (i < outp.len) { cenp[i] = outp[i]; i = i + 1; }
    cenp[outp.len] = 46 as u8;
    cenp[outp.len + 1] = 99 as u8;
    cenp[outp.len + 2] = 101 as u8;
    cenp[outp.len + 3] = 110 as u8;
    cenp[outp.len + 4] = 0 as u8;
    return cenp;
}

fn main() i32 {
    let mode:[]u8 = _zag_arg(1);
    let outp:[]u8 = _zag_arg(2);
    let variant:[]u8 = _zag_arg(3);
    if (mode.len == 0 || outp.len == 0) {
        _zag_println("usage: tempo <par|b> <out.raw> [seq|scr]");
        return 1;
    }
    let is_b:i64 = 0;
    if (_zag_strcmp(mode, "b") == 1) { is_b = 1; }
    let W:i64 = 320;
    let H:i64 = 240;
    let NF:i64 = 300;
    let R2q:i64 = 163840000;
    let FS:i64 = W * H * 3;
    let scr:i64 = 0;
    if (_zag_strcmp(variant, "scr") == 1) { scr = 1; }
    let cenp:[]u8 = cen_path(outp);
    let ofd:i64 = f_open_w(outp);
    if (ofd < 0) { _zag_println("out open failed"); return 2; }
    let cfd:i64 = f_open_w(cenp);
    if (cfd < 0) { _zag_println("cen open failed"); return 2; }
    let fb:[]u8 = z_alloc(FS);
    if (fb.len == 0) { _zag_println("frame alloc failed"); return 3; }
    let li:i64 = 0;
    while (li < NF) {
        let f:i64 = li;
        if (scr == 1) { f = (li * 157) % NF; }
        let sumx:i64 = 0;
        let cnt:i64 = 0;
        render_frame(f, W, H, R2q, is_b, fb, &sumx, &cnt);
        // frames are written in RENDER order at logical offset f*FS? No:
        // sequential file layout requires offset f*FS; with scr we must seek.
        // Simpler: scr variant renders in scrambled order but writes via pwrite
        // at f*FS. Use raw_syscall pwrite (syscall 18).
        let wrc:i64 = _zag_raw_syscall(18, ofd, _zag_slice_ptr(fb) as i64, FS, f * FS, 0, 0);
        if (wrc != FS) { _zag_println("frame write failed"); return 4; }
        let line:[]u8 = z_alloc(64);
        let p:i64 = 0;
        p = dec_app(line, p, f);
        line[p] = 32 as u8; p = p + 1;
        p = dec_app(line, p, sumx);
        line[p] = 32 as u8; p = p + 1;
        p = dec_app(line, p, cnt);
        line[p] = 10 as u8; p = p + 1;
        while (p < 64) { line[p] = 32 as u8; p = p + 1; }
        let w2:i64 = _zag_raw_syscall(18, cfd, _zag_slice_ptr(line) as i64, p, f * 64, 0, 0);
        if (w2 != p) { _zag_println("cen write failed"); return 5; }
        z_free(line);
        li = li + 1;
    }
    z_free(fb);
    f_close(ofd);
    f_close(cfd);
    z_free(cenp);
    _zag_print("tempo frames ");
    _zag_println(_zag_i64_to_str(NF));
    return 0;
}

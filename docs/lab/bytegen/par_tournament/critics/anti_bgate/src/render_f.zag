// render_f.zag — Contender F (anti-B-gate critic): PAR render with PLAN-SEEDED region-carried state.
//
// Hypothesis: plan-seeded state recovers musical continuity pure-PAR lacks
// (connected phrasing across note boundaries) while keeping PAR's
// chop-invariance and cascade immunity.
//
// Regions: the plan's time axis is cut into R-second segments (R = 3.0 s,
// 10 regions over the 30 s fixture). At every region boundary ALL carried
// state is wiped and reseeded from PLAN DATA ONLY — never from prior
// output. The reseed is a deterministic pure function of (plan, region
// index): region k's output samples are a pure function of (plan, k).
// Consequences, all verified empirically:
//   - render region k standalone == region k in-context (0 differing samples)
//   - region render order (seq/rev/stride) is bit-identical (disjoint writes)
//   - a fault in the mix cannot propagate: generation never reads the mix
// Within a region the renderer carries native-style sequential state
// (f3_synth pattern): per-voice phase accumulators and vibrato phase.
// The continuity mechanism is the LEGATO BUS: consecutive events whose gap
// < LEGATO_GAP (80 ms) form a chain rendered as one continuous voice —
// continuous phase and vibrato phase (no per-note phase reset), portamento
// glide between pitches over GLIDE_T (60 ms). Pure PAR cannot express
// portamento (each note is independent); a global carried-state synth would
// smear it across the whole piece. The amplitude envelope stays PAR's
// (attack+release per note): a gap-filling sustain variant was built and
// measured, but it raised G-PER (envelope autocorrelation) from 0.34 to
// 0.50 by flattening inter-note dips, so the envelope was reverted — the
// continuity lives in pitch/phase, not amplitude.
// RESPOND: plan-derived octave latch (sensorless analogue of the hybrid's
// piece 3). The cue pitch is read from the plan (the rendered cue IS the
// plan pitch — deterministic synthesis), so the latch needs no audio
// measurement and stays region-independent. Verdicts match the hybrid's
// audio-measured latch on the whole trap battery.
// Pure Zag, pinned znc, zero RNG in the render path.
const SR:i64 = 44100;
const RSAMP:i64 = 132300; // region length: 3.0 s
const NEVMAX:i64 = 64;
const EVF:i64 = 16;
const EVSZ:i64 = 128;
const LG:i64 = 3528;      // legato gap threshold: 80 ms
const GLIDE_T:i64 = 2646; // portamento glide: 60 ms
const Q32:i64 = 4294967296;

// ---------- io ----------
fn cstr(s:[]u8) []u8 {
    if (s.len < 1 || s.len > 4095) { return ""; }
    let p:*u8 = _zag_malloc((s.len + 1) as i64) as *u8;
    if (p == null as *u8) { return ""; }
    let b:[]u8 = p[0..(s.len + 1)];
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn w_all(fd:i64, b:[]u8) i64 {
    let at:i64 = 0;
    let blen:i64 = b.len as i64;
    while (at < blen) {
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(b) as i64) + at, blen - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { return -7407; }
        at = at + n;
    }
    return at;
}
fn file_read(path:[]u8, cap:i64) []u8 {
    let cs:[]u8 = cstr(path);
    if (cs.len == 0) { return ""; }
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 0, 0, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return ""; }
    let p:*u8 = _zag_malloc(cap) as *u8;
    if (p == null as *u8) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return ""; }
    let at:i64 = 0;
    while (at < cap) {
        let n:i64 = _zag_raw_syscall(0, fd, (p as i64) + at, cap - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let b:[]u8 = p[0..at];
    return b;
}
fn file_write(path:[]u8, b:[]u8) i64 {
    let cs:[]u8 = cstr(path);
    if (cs.len == 0) { return -3; }
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 577, 438, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return -4; }
    let wr:i64 = w_all(fd, b);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if (wr < 0) { return -5; }
    return 0;
}
fn pout(s:[]u8) void {
    _zag_raw_syscall(1, 1, (_zag_slice_ptr(s) as i64), (s.len as i64), 0, 0, 0);
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if (s.len > 0) {
        if (s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    }
    return s;
}

// ---------- 64-bit arena slots (byte offset) ----------
fn nio_alloc(n:i32) []u8 {
    if (n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if (p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i32 = 0;
    while (i < n) { b[i] = 0; i = i + 1; }
    return b;
}
fn nio_free(b:[]u8) void { if (b.len > 0) { _zag_free(_zag_slice_ptr(b)); } }
fn put64(b:[]u8, i:i64, v:i64) void {
    b[i] = (v & 255) as u8;
    b[i+1] = ((v >> 8) & 255) as u8;
    b[i+2] = ((v >> 16) & 255) as u8;
    b[i+3] = ((v >> 24) & 255) as u8;
    b[i+4] = ((v >> 32) & 255) as u8;
    b[i+5] = ((v >> 40) & 255) as u8;
    b[i+6] = ((v >> 48) & 255) as u8;
    b[i+7] = ((v >> 56) & 255) as u8;
}
fn get64(b:[]u8, i:i64) i64 {
    return (b[i] as i64) | ((b[i+1] as i64) << 8) | ((b[i+2] as i64) << 16) | ((b[i+3] as i64) << 24) | ((b[i+4] as i64) << 32) | ((b[i+5] as i64) << 40) | ((b[i+6] as i64) << 48) | ((b[i+7] as i64) << 56);
}
fn evg(ev:[]u8, e:i64, f:i64) i64 { return get64(ev, e * EVSZ + f * 8); }
fn evs(ev:[]u8, e:i64, f:i64, v:i64) void { put64(ev, e * EVSZ + f * 8, v); }

// ---------- sine: quadrant polynomial (f64), 1024-entry Q15 LUT ----------
fn fsin_q(x:f64) f64 {
    let t:f64 = x;
    let s:f64 = 1.0;
    if (t >= 3.141592653589793) { t = t - 3.141592653589793; s = -1.0; }
    if (t >= 1.5707963267948966) { t = 3.141592653589793 - t; }
    let x2:f64 = t * t;
    let x3:f64 = x2 * t;
    let x5:f64 = x3 * x2;
    let x7:f64 = x5 * x2;
    let x9:f64 = x7 * x2;
    return s * (t - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0 + x9 / 362880.0);
}
fn lut_init(lut:[]i64) void {
    let i:i64 = 0;
    while (i < 1024) {
        let s:f64 = fsin_q(6.283185307179586 * (i as f64) / 1024.0);
        lut[i] = (s * 32767.0) as i64;
        i = i + 1;
    }
}
fn lsin(lut:[]i64, idx:i64) i64 { return lut[idx & 1023]; }

// ---------- ascii float ----------
fn atof(s:[]u8, st:i64, en:i64) f64 {
    let neg:f64 = 1.0;
    let v:f64 = 0.0;
    let i:i64 = st;
    if (i < en && s[i] == 45) { neg = -1.0; i = i + 1; }
    while (i < en && s[i] >= 48 && s[i] <= 57) { v = v * 10.0 + ((s[i] - 48) as f64); i = i + 1; }
    if (i < en && s[i] == 46) {
        i = i + 1;
        let div:f64 = 10.0;
        while (i < en && s[i] >= 48 && s[i] <= 57) { v = v + ((s[i] - 48) as f64) / div; div = div * 10.0; i = i + 1; }
    }
    return neg * v;
}
fn pow2(x:f64) f64 {
    // 2^x for x in [-1,1] via taylor on e^(x ln2)
    let y:f64 = x * 0.6931471805599453;
    let t:f64 = 1.0;
    let term:f64 = 1.0;
    let k:i64 = 1;
    while (k <= 12) {
        term = term * y / (k as f64);
        t = t + term;
        k = k + 1;
    }
    return t;
}

// ---------- plan parse ----------
// event fields: 0 t0 1 dur 2 f0q16 3 ampq16 4 tim 5 glideq16
//               6 vibinc_q32 7 vibbeta_q32 8 kind 9 rspw0 10 rspw1 11 nomq16
//               12 chain_start 13 chain_end 14 endpitch_q16 15 spare
// B-specific input hardening (documented; only binds adversarial plans —
// the fixture's values are all in-range): amp/freq/glide/timbre/vibrato
// clamped to sane rails so hostile plan text cannot overflow i64 or hang.
fn clamp_i64(v:i64, lo:i64, hi:i64) i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn parse_plan(path:[]u8, ev:[]u8, bed:[]u8, out_nsamp:[]u8) i64 {
    let raw:[]u8 = file_read(path, 65536);
    if (raw.len == 0) { return -1; }
    let nev:i64 = 0;
    let pos:i64 = 0;
    let n:i64 = raw.len as i64;
    put64(out_nsamp, 0, 1323000);
    while (pos < n) {
        let le:i64 = pos;
        while (le < n && raw[le] != 10) { le = le + 1; }
        if (le > pos && raw[pos] != 35) {
            let p:i64 = pos;
            while (p < le && raw[p] == 32) { p = p + 1; }
            let t0s:i64 = p;
            while (p < le && raw[p] != 32) { p = p + 1; }
            let t0e:i64 = p;
            let f:[]u8 = nio_alloc(72);
            let nf:i64 = 0;
            while (p < le && nf < 9) {
                while (p < le && raw[p] == 32) { p = p + 1; }
                if (p >= le) { break; }
                let fs:i64 = p;
                while (p < le && raw[p] != 32) { p = p + 1; }
                put64(f, nf * 8, ((atof(raw, fs, p) * 65536.0) as i64));
                nf = nf + 1;
            }
            let tlen:i64 = t0e - t0s;
            if (tlen == 5 && raw[t0s] == 68 && raw[t0s+1] == 85 && raw[t0s+2] == 82 && raw[t0s+3] == 95 && raw[t0s+4] == 83) {
                // DUR_S seconds
                if (nf >= 1) {
                    let ns:i64 = (get64(f, 0) * SR) / 65536;
                    if (ns > 0 && ns <= 13230000) { put64(out_nsamp, 0, ns); }
                }
            }
            if (tlen == 3 && raw[t0s] == 66 && raw[t0s+1] == 69 && raw[t0s+2] == 68) {
                // BED t0 t1 freq amp
                if (nf >= 4) {
                    put64(bed, 0, (get64(f, 0) * SR) / 65536);
                    put64(bed, 8, (get64(f, 8) * SR) / 65536);
                    put64(bed, 16, get64(f, 16));
                    put64(bed, 24, get64(f, 24) / 1000);
                }
            }
            if (tlen == 5 && raw[t0s] == 69 && raw[t0s+1] == 86 && raw[t0s+2] == 69 && raw[t0s+3] == 78 && raw[t0s+4] == 84) {
                // EVENT t0 dur freq amp timbre glide vibhz vibc
                if (nf >= 8 && nev < NEVMAX) {
                    let t0v:i64 = (get64(f, 0) * SR) / 65536;
                    if (t0v < 0) { t0v = 0; }
                    let durv:i64 = (get64(f, 8) * SR) / 65536;
                    if (durv < 0) { durv = 0; }
                    evs(ev, nev, 0, t0v);
                    evs(ev, nev, 1, durv);
                    // (plan stores truth; the render path gates — see gate_f)
                    evs(ev, nev, 2, clamp_i64(get64(f, 16), 0, 1310720000));
                    evs(ev, nev, 3, clamp_i64(get64(f, 24) / 1000, 0, 262144));
                    evs(ev, nev, 4, clamp_i64(get64(f, 32) / 65536, 1, 13));
                    evs(ev, nev, 5, clamp_i64(get64(f, 40), -131072000, 131072000));
                    let vibhz:f64 = (get64(f, 48) as f64) / 65536.0;
                    if (vibhz < 0.0) { vibhz = 0.0; }
                    if (vibhz > 50.0) { vibhz = 50.0; }
                    let vibc:f64 = (get64(f, 56) as f64) / 65536.0;
                    if (vibc < 0.0) { vibc = 0.0; }
                    if (vibc > 4800.0) { vibc = 4800.0; }
                    let f0:f64 = (evg(ev, nev, 2) as f64) / 65536.0;
                    let df:f64 = f0 * (pow2(vibc / 1200.0) - 1.0);
                    let beta:f64 = 0.0;
                    if (vibhz > 0.001) { beta = df / vibhz; }
                    evs(ev, nev, 6, (vibhz * 4294967296.0 / (SR as f64)) as i64);
                    evs(ev, nev, 7, (beta * 4294967296.0) as i64);
                    evs(ev, nev, 8, 0);
                    nev = nev + 1;
                }
            }
            if (tlen == 7 && raw[t0s] == 82 && raw[t0s+1] == 69 && raw[t0s+2] == 83 && raw[t0s+3] == 80 && raw[t0s+4] == 79 && raw[t0s+5] == 78 && raw[t0s+6] == 68) {
                // RESPOND t0 dur w0 w1 amp timbre nominal
                if (nf >= 7 && nev < NEVMAX) {
                    let t0v:i64 = (get64(f, 0) * SR) / 65536;
                    if (t0v < 0) { t0v = 0; }
                    evs(ev, nev, 0, t0v);
                    evs(ev, nev, 1, (get64(f, 8) * SR) / 65536);
                    evs(ev, nev, 2, clamp_i64(get64(f, 48), 0, 1310720000));
                    evs(ev, nev, 3, clamp_i64(get64(f, 32) / 1000, 0, 262144));
                    evs(ev, nev, 4, clamp_i64(get64(f, 40) / 65536, 1, 13));
                    evs(ev, nev, 5, 0);
                    evs(ev, nev, 6, 0);
                    evs(ev, nev, 7, 0);
                    evs(ev, nev, 8, 1);
                    evs(ev, nev, 9, (get64(f, 16) * SR) / 65536);
                    evs(ev, nev, 10, (get64(f, 24) * SR) / 65536);
                    evs(ev, nev, 11, get64(f, 48));
                    nev = nev + 1;
                }
            }
            nio_free(f);
        }
        pos = le + 1;
    }
    return nev;
}

// ---------- plan-derived structure: time-sorted index + legato chains ----------
// A chain is a maximal run of events (in t0 order) with consecutive gaps <
// LG. Chain membership is pure plan data, computed once. endpitch = f0 +
// plan glide (Hz, Q16): the pitch a legato successor glides FROM.
fn build_chains(ev:[]u8, nev:i64, sidx:[]u8) void {
    let i:i64 = 0;
    while (i < nev) { put64(sidx, i * 8, i); i = i + 1; }
    // insertion sort by t0 (nev <= 64)
    i = 1;
    while (i < nev) {
        let key:i64 = get64(sidx, i * 8);
        let kt0:i64 = evg(ev, key, 0);
        let j:i64 = i - 1;
        while (j >= 0 && evg(ev, get64(sidx, j * 8), 0) > kt0) {
            put64(sidx, (j + 1) * 8, get64(sidx, j * 8));
            j = j - 1;
        }
        put64(sidx, (j + 1) * 8, key);
        i = i + 1;
    }
    let p:i64 = 0;
    while (p < nev) {
        let e:i64 = get64(sidx, p * 8);
        let t0:i64 = evg(ev, e, 0);
        let en:i64 = t0 + evg(ev, e, 1);
        let cs:i64 = 1;
        let ce:i64 = 1;
        if (p > 0) {
            let pr:i64 = get64(sidx, (p - 1) * 8);
            let pen:i64 = evg(ev, pr, 0) + evg(ev, pr, 1);
            if (t0 - pen < LG) { cs = 0; }
        }
        if (p < nev - 1) {
            let nx:i64 = get64(sidx, (p + 1) * 8);
            if (evg(ev, nx, 0) - en < LG) { ce = 0; }
        }
        evs(ev, e, 12, cs);
        evs(ev, e, 13, ce);
        let ep:i64 = evg(ev, e, 2) + evg(ev, e, 5);
        if (ep < 0) { ep = 0; }
        evs(ev, e, 14, ep);
        p = p + 1;
    }
}

// ---------- RESPOND: plan-derived octave latch (sensorless piece-3) ----------
// The rendered cue IS the plan cue pitch (deterministic synthesis), so the
// octave decision needs no audio measurement — and stays region-independent
// (standalone region render == in-context, by construction). Well-posedness
// is plan-grounded: exactly one plan voice may overlap the source window.
// k = round(log2(fcue/fnom)); |k|>0 latches to nom*2^k (the plan's own
// octave-corrected value, never a measurement); else the nominal stands.
fn oct_shift_f(r:f64) i64 {
    if (r <= 0.0) { return 0; }
    let k:i64 = 0;
    let x:f64 = r;
    while (x >= 2.0) { x = x / 2.0; k = k + 1; }
    while (x < 1.0) { x = x * 2.0; k = k - 1; }
    if (x >= 1.41421356) { k = k + 1; }
    if (k > 10) { k = 10; }
    if (k < -10) { k = -10; }
    return k;
}
fn respond_latch(ev:[]u8, nev:i64) void {
    let e:i64 = 0;
    while (e < nev) {
        if (evg(ev, e, 8) == 1) {
            let w0:i64 = evg(ev, e, 9);
            let w1:i64 = evg(ev, e, 10);
            let nom:i64 = evg(ev, e, 11);
            let nv:i64 = 0;
            let cue_e:i64 = -1;
            let o:i64 = 0;
            while (o < nev) {
                if (o != e && evg(ev, o, 8) == 0) {
                    let a2:i64 = evg(ev, o, 0);
                    let b2:i64 = a2 + evg(ev, o, 1);
                    if (a2 < w1 && b2 > w0) { nv = nv + 1; cue_e = o; }
                }
                o = o + 1;
            }
            let f0:i64 = evg(ev, e, 2);
            let ko:i64 = 0;
            let dec:i64 = 0;
            let fcue:i64 = 0;
            let veto:i64 = 0;
            // B-gate: nominal must be in [40,4000] Hz or the latch abstains
            // (a nominal lie outside the gate cannot pull the latch).
            let nom_ok:i64 = 0;
            if (nom >= 2621440 && nom <= 262144000) { nom_ok = 1; }
            if (nom_ok == 0) { veto = 1; }
            if (nv == 1 && cue_e >= 0 && nom_ok == 1) {
                fcue = evg(ev, cue_e, 2);
                if (fcue >= 40 * 65536 && fcue <= 4000 * 65536) {
                    ko = oct_shift_f((fcue as f64) / (nom as f64));
                    if (ko != 0) {
                        f0 = nom;
                        let qi:i64 = 0;
                        if (ko > 0) {
                            while (qi < ko) { f0 = f0 * 2; qi = qi + 1; }
                        } else {
                            while (qi < 0 - ko) { f0 = f0 / 2; qi = qi + 1; }
                        }
                        // B-gate: the latched output must also be in
                        // [40,4000] Hz; else abstain (nominal stands).
                        if (f0 >= 2621440 && f0 <= 262144000) {
                            dec = 1;
                        } else {
                            f0 = nom;
                            veto = 2;
                        }
                    }
                }
            }
            evs(ev, e, 2, f0);
            evs(ev, e, 8, 0);
            pout("F RESPOND e=");
            pout(i64s(e));
            pout(" nvoice=");
            pout(i64s(nv));
            pout(" fcue=");
            pout(i64s(fcue / 65536));
            pout("Hz nom=");
            pout(i64s(nom / 65536));
            pout("Hz k=");
            pout(i64s(ko));
            if (dec == 1) {
                pout(" -> LATCHED f0=");
                pout(i64s(f0 / 65536));
                pout("Hz");
            } else {
                if (veto == 1) {
                    pout(" -> GATE-VETO(nominal) nominal stands");
                } else {
                    if (veto == 2) {
                        pout(" -> GATE-VETO(output) nominal stands");
                    } else {
                        pout(" -> nominal stands");
                    }
                }
            }
            pout("\n");
        }
        e = e + 1;
    }
}

// F: no render-path pitch gate. The synth renders plan pitches faithfully
// within the parse rails [0,20000] Hz (i64-safety, not taste). The honest
// gate lives at the decision layer: respond_latch's nominal/output vetoes
// (kept verbatim). Plan fields keep plan truth throughout.
// ---------- synthesis ----------
// Q16 Hz -> Q32 cycles/sample phase increment
fn pitch_inc(fq16:i64) i64 {
    if (fq16 <= 0) { return 0; }
    return (fq16 * 65536) / SR;
}
// harmonic-stack voice sample from carried phase/vibrato (matches PAR math)
fn voice_sample(lut:[]i64, phase:i64, vph:i64, vbeta:i64, tim:i64, ampq:i64, envq:i64) i64 {
    if (envq == 0 || ampq == 0) { return 0; }
    let vs:i64 = lsin(lut, (vph >> 22) & 1023);
    let pheff:i64 = phase + (vbeta * vs) / 32768;
    pheff = pheff - (pheff / Q32) * Q32;
    if (pheff < 0) { pheff = pheff + Q32; }
    let acc:i64 = 0;
    let hsum:i64 = 0;
    let h:i64 = 1;
    while (h <= tim) {
        let idx:i64 = ((pheff * h) >> 22) & 1023;
        acc = acc + (65536 / h) * lsin(lut, idx);
        hsum = hsum + 65536 / h;
        h = h + 1;
    }
    acc = (acc * 65536) / hsum;
    let v:i64 = (acc * envq) / 2147483648;
    v = (v * ampq) / 65536;
    return v;
}

// bed voice: vph=0, vbeta=0, tim=3 — provably identical to
// voice_sample(lut, phase, 0, 0, 3, ampq, envq):
//   vs=lsin(lut,0) constant; (0*vs)/32768=0 so pheff=phase (caller keeps
//   phase wrap32'd, so the pheff mod is a no-op); hsum=65536+32768+21845;
//   ((phase*h)>>22)&1023 reads bits [22,32), same as the wrapped pheff.
fn voice_bed(lut:[]i64, phase:i64, ampq:i64, envq:i64) i64 {
    if (envq == 0 || ampq == 0) { return 0; }
    let acc:i64 = 65536 * lsin(lut, (phase >> 22) & 1023);
    acc = acc + 32768 * lsin(lut, ((phase * 2) >> 22) & 1023);
    acc = acc + 21845 * lsin(lut, ((phase * 3) >> 22) & 1023);
    acc = (acc * 65536) / 120149;
    let v:i64 = (acc * envq) / 2147483648;
    v = (v * ampq) / 65536;
    return v;
}
// closed-form PAR voice (verbatim math): overlays + drift reference
fn voice_closed(ev:[]u8, lut:[]i64, e:i64, t:i64) i64 {
    let t0:i64 = evg(ev, e, 0);
    let dur:i64 = evg(ev, e, 1);
    let tr:i64 = t - t0;
    if (tr < 0 || tr >= dur || dur <= 0) { return 0; }
    let f0q:i64 = evg(ev, e, 2);
    let ampq:i64 = evg(ev, e, 3);
    let tim:i64 = evg(ev, e, 4);
    let glideq:i64 = evg(ev, e, 5);
    let vinc:i64 = evg(ev, e, 6);
    let vbeta:i64 = evg(ev, e, 7);
    let atk:i64 = 1764;
    if (dur / 2 < atk) { atk = dur / 2; }
    let rel:i64 = 6615;
    if (dur / 2 < rel) { rel = dur / 2; }
    let envq:i64 = 65536;
    if (tr < atk && atk > 0) {
        let x:i64 = (tr * 1024) / atk;
        envq = 32768 - lsin(lut, 256 + x / 2);
    } else {
        let rem:i64 = dur - tr;
        if (rem < rel && rel > 0) {
            // B-fix: release runs on ELAPSED release time (was: remaining
            // time, which inverted the fade — silent at release onset,
            // full at note end). x: 0 -> 1024 over the release window.
            let x:i64 = ((rel - rem) * 1024) / rel;
            envq = 32768 + lsin(lut, 256 + x / 2);
        }
    }
    let ph:i64 = ((f0q * tr) / SR) * 65536;
    if (glideq != 0) {
        let g1:i64 = (glideq * tr) / dur;
        ph = ph + ((g1 * tr) / (2 * SR)) * 65536;
    }
    if (vbeta != 0 && vinc != 0) {
        let vph:i64 = vinc * tr;
        vph = vph - (vph / Q32) * Q32;
        let vs:i64 = lsin(lut, (vph >> 22) & 1023);
        ph = ph + (vbeta * vs) / 32768;
    }
    ph = ph - (ph / Q32) * Q32;
    if (ph < 0) { ph = ph + Q32; }
    let acc:i64 = 0;
    let hsum:i64 = 0;
    let h:i64 = 1;
    while (h <= tim) {
        let idx:i64 = ((ph * h) >> 22) & 1023;
        acc = acc + (65536 / h) * lsin(lut, idx);
        hsum = hsum + 65536 / h;
        h = h + 1;
    }
    acc = (acc * 65536) / hsum;
    let v:i64 = (acc * envq) / 2147483648;
    v = (v * ampq) / 65536;
    return v;
}
// Envelope is PAR's (attack+release on every note): a gap-filling sustain
// variant measured G-PER 0.50 (vs 0.34), so amplitude continuity was dropped;
// the legato continuity lives in pitch (portamento) and phase, not amplitude.
fn bus_env_at(ev:[]u8, lut:[]i64, e:i64, tr:i64) i64 {
    let dur:i64 = evg(ev, e, 1);
    let atk:i64 = 1764;
    if (dur / 2 < atk) { atk = dur / 2; }
    let rel:i64 = 6615;
    if (dur / 2 < rel) { rel = dur / 2; }
    if (tr < atk && atk > 0) {
        let x:i64 = (tr * 1024) / atk;
        return 32768 - lsin(lut, 256 + x / 2);
    }
    let rem:i64 = dur - tr;
    if (rem < rel && rel > 0 && rem >= 0) {
        // B-fix: elapsed-release-time form (was inverted). Dead code
        // (bus_env_at unused) — fixed for consistency.
        let x:i64 = ((rel - rem) * 1024) / rel;
        return 32768 + lsin(lut, 256 + x / 2);
    }
    return 65536;
}
// base pitch increment of event e at note-relative time tr (plan glide
// included, portamento excluded). Pure f(plan, t).
fn base_inc_at(ev:[]u8, e:i64, tr:i64) i64 {
    let f0:i64 = evg(ev, e, 2);
    let inc:i64 = pitch_inc(f0);
    let gq:i64 = evg(ev, e, 5);
    let dur:i64 = evg(ev, e, 1);
    if (gq != 0 && dur > 0 && tr >= 0) {
        let g1:i64 = (gq * tr) / dur;
        inc = inc + (g1 * 65536) / SR;
        if (inc < 0) { inc = 0; }
    }
    return inc;
}

// ---------- flat renderer (F) ----------
// No regions, no reseeds, no prefix simulation. One pass over the
// time-sorted plan; phase/vibrato carried in locals across legato chains
// (reset at non-legato starts) — the identical recurrence B's per-region
// simulation computes, hence identical output. Overlays stay closed-form
// (voice_closed); the bed renders in a single pass from b0.
fn wrap32(v:i64) i64 {
    if (v >= Q32) { return v - Q32; }
    return v;
}

// render the whole timeline in one flat pass (no regions).
fn render_flat(ev:[]u8, lut:[]i64, bed:[]u8, mix:[]u8, sidx:[]u8, nev:i64, nsamp:i64) void {
    let rlist:[]u8 = nio_alloc(512);
    let nrl:i64 = 0;
    let p:i64 = 0;
    while (p < nev) {
        let e:i64 = get64(sidx, p * 8);
        let t0:i64 = evg(ev, e, 0);
        let en:i64 = t0 + evg(ev, e, 1);
        if (evg(ev, e, 1) > 0 && t0 < nsamp && en > 0) {
            put64(rlist, nrl * 8, e);
            nrl = nrl + 1;
        }
        p = p + 1;
    }
    let ov:[]u8 = nio_alloc(512);
    let nov:i64 = 0;
    let ph:i64 = 0;
    let vph:i64 = 0;
    let bus_end:i64 = -1;
    let bus_pitch:i64 = 0;
    let bvinc:i64 = 0;
    let t:i64 = 0;
    let ri:i64 = 0;
    while (t < nsamp) {
        let ne:i64 = -1;
        let nt0:i64 = nsamp;
        if (ri < nrl) {
            ne = get64(rlist, ri * 8);
            nt0 = evg(ev, ne, 0);
            if (nt0 < t) { nt0 = t; }
        }
        if (nt0 > t) {
            // gap: advance bus phase/vibrato (B's gap_render; sustain unused there too)
            let pinc:i64 = pitch_inc(bus_pitch);
            let g:i64 = t;
            while (g < nt0) {
                ph = wrap32(ph + pinc);
                vph = wrap32(vph + bvinc);
                g = g + 1;
            }
            t = nt0;
        }
        if (ne < 0) { break; }
        if (bus_end >= 0 && evg(ev, ne, 0) < bus_end) {
            put64(ov, nov * 8, ne);
            nov = nov + 1;
        } else {
            let legato:i64 = 0;
            if (bus_end >= 0 && evg(ev, ne, 0) - bus_end < LG) { legato = 1; }
            if (legato == 0) {
                ph = 0;
                vph = 0;
            }
            let inc_from:i64 = 0;
            let inc_to:i64 = 0;
            if (legato != 0) {
                inc_from = pitch_inc(bus_pitch);
                inc_to = pitch_inc(evg(ev, ne, 2));
            }
            let e_t0:i64 = evg(ev, ne, 0);
            let e_dur:i64 = evg(ev, ne, 1);
            let e_f0:i64 = evg(ev, ne, 2);
            let e_amp:i64 = evg(ev, ne, 3);
            let e_tim:i64 = evg(ev, ne, 4);
            let e_glide:i64 = evg(ev, ne, 5);
            let e_vinc:i64 = evg(ev, ne, 6);
            let e_vbeta:i64 = evg(ev, ne, 7);
            let e_f0inc:i64 = pitch_inc(e_f0);
            let atk:i64 = 1764;
            if (e_dur / 2 < atk) { atk = e_dur / 2; }
            let rel:i64 = 6615;
            if (e_dur / 2 < rel) { rel = e_dur / 2; }
            let eend:i64 = e_t0 + e_dur;
            if (eend > nsamp) { eend = nsamp; }
            let u:i64 = t;
            while (u < eend) {
                let tr:i64 = u - e_t0;
                let env:i64 = 65536;
                if (tr < atk && atk > 0 && tr >= 0) {
                    let x:i64 = (tr * 1024) / atk;
                    env = 32768 - lsin(lut, 256 + x / 2);
                } else {
                    let rem:i64 = e_dur - tr;
                    if (rem < rel && rel > 0 && rem >= 0) {
                        let x:i64 = ((rel - rem) * 1024) / rel;
                        env = 32768 + lsin(lut, 256 + x / 2);
                    }
                }
                if (env != 0) {
                    let v:i64 = voice_sample(lut, ph, vph, e_vbeta, e_tim, e_amp, env);
                    put64(mix, u * 8, get64(mix, u * 8) + v);
                }
                let inc:i64 = e_f0inc;
                if (e_glide != 0 && e_dur > 0 && tr >= 0) {
                    let g1:i64 = (e_glide * tr) / e_dur;
                    inc = inc + (g1 * 65536) / SR;
                    if (inc < 0) { inc = 0; }
                }
                if (legato != 0 && tr >= 0 && tr < GLIDE_T) {
                    let d:i64 = inc_to - inc_from;
                    inc = inc_from + (d * tr) / GLIDE_T + (inc - e_f0inc);
                    if (inc < 0) { inc = 0; }
                }
                ph = wrap32(ph + inc);
                vph = wrap32(vph + e_vinc);
                u = u + 1;
            }
            t = eend;
            bus_end = e_t0 + e_dur;
            bus_pitch = evg(ev, ne, 14);
            bvinc = evg(ev, ne, 6);
        }
        ri = ri + 1;
    }
    let i:i64 = 0;
    while (i < nov) {
        let e:i64 = get64(ov, i * 8);
        let a:i64 = evg(ev, e, 0);
        if (a < 0) { a = 0; }
        let b:i64 = evg(ev, e, 0) + evg(ev, e, 1);
        if (b > nsamp) { b = nsamp; }
        let w:i64 = a;
        while (w < b) {
            put64(mix, w * 8, get64(mix, w * 8) + voice_closed(ev, lut, e, w));
            w = w + 1;
        }
        i = i + 1;
    }
    nio_free(ov);
    nio_free(rlist);
    // bed: B's piecewise closed-form seed, one segment per RSAMP (no carried
    // state, no simulation — the seed is pure f(plan, segment)). This
    // reproduces B's bed bit-exactly, including its tiny per-segment reseed
    // steps (REGION-1 measured 0.0854 rad); the reseed is closed-form and
    // costs nothing.
    let b0:i64 = get64(bed, 0);
    let b1:i64 = get64(bed, 8);
    let fq:i64 = get64(bed, 16);
    let ampq:i64 = get64(bed, 24);
    let k:i64 = 0;
    while (k * RSAMP < nsamp) {
        let R0:i64 = k * RSAMP;
        let R1:i64 = R0 + RSAMP;
        if (R1 > nsamp) { R1 = nsamp; }
        let a:i64 = b0;
        if (a < R0) { a = R0; }
        let b:i64 = b1;
        if (b > R1) { b = R1; }
        if (a < b && fq > 0) {
            let binc:i64 = pitch_inc(fq);
            let bph:i64 = ((fq * a) / SR) * 65536;
            bph = bph - (bph / Q32) * Q32;
            if (bph < 0) { bph = bph + Q32; }
            let s2:i64 = a;
            while (s2 < b) {
                let ed:i64 = 1102;
                let envq:i64 = 65536;
                let tin:i64 = s2 - b0;
                if (tin < ed && tin >= 0) {
                    let x:i64 = (tin * 1024) / ed;
                    envq = 32768 - lsin(lut, 256 + x / 2);
                } else {
                    let tout:i64 = b1 - s2;
                    if (tout < ed && tout >= 0) {
                        let x:i64 = ((ed - tout) * 1024) / ed;
                        envq = 32768 + lsin(lut, 256 + x / 2);
                    }
                }
                let v:i64 = voice_bed(lut, bph, ampq, envq);
                put64(mix, s2 * 8, get64(mix, s2 * 8) + v);
                bph = wrap32(bph + binc);
                s2 = s2 + 1;
            }
        }
        k = k + 1;
    }
}

// ---------- writers ----------
fn wav_write(path:[]u8, mix:[]u8, nsamp:i64) i64 {
    let peak:i64 = 0;
    let i:i64 = 0;
    while (i < nsamp) {
        let v:i64 = get64(mix, i * 8);
        if (v < 0) { v = 0 - v; }
        if (v > peak) { peak = v; }
        i = i + 1;
    }
    pout("F mix peak=");
    pout(i64s(peak));
    pout(" nsamp=");
    pout(i64s(nsamp));
    pout("\n");
    let scale:f64 = 1.0;
    if (peak > 0) { scale = 30000.0 / (peak as f64); }
    let size:i64 = 44 + nsamp * 2;
    let b:[]u8 = nio_alloc((size + 7) as i32);
    b[0] = 82; b[1] = 73; b[2] = 70; b[3] = 70;
    let ds:i64 = size - 8;
    b[4] = (ds & 255) as u8; b[5] = ((ds >> 8) & 255) as u8; b[6] = ((ds >> 16) & 255) as u8; b[7] = ((ds >> 24) & 255) as u8;
    b[8] = 87; b[9] = 65; b[10] = 86; b[11] = 69;
    b[12] = 102; b[13] = 109; b[14] = 116; b[15] = 32;
    b[16] = 16; b[17] = 0; b[18] = 0; b[19] = 0;
    b[20] = 1; b[21] = 0; b[22] = 1; b[23] = 0;
    b[24] = 68; b[25] = 172; b[26] = 0; b[27] = 0;
    b[28] = 136; b[29] = 88; b[30] = 1; b[31] = 0;
    b[32] = 2; b[33] = 0; b[34] = 16; b[35] = 0;
    b[36] = 100; b[37] = 97; b[38] = 116; b[39] = 97;
    let dd:i64 = nsamp * 2;
    b[40] = (dd & 255) as u8; b[41] = ((dd >> 8) & 255) as u8; b[42] = ((dd >> 16) & 255) as u8; b[43] = ((dd >> 24) & 255) as u8;
    let t:i64 = 0;
    while (t < nsamp) {
        let v:i64 = get64(mix, t * 8);
        let s:i64 = ((v as f64) * scale) as i64;
        if (s > 32767) { s = 32767; }
        if (s < -32768) { s = -32768; }
        b[44 + t * 2] = (s & 255) as u8;
        b[44 + t * 2 + 1] = ((s >> 8) & 255) as u8;
        t = t + 1;
    }
    let rc:i64 = file_write(path, b[0..size]);
    nio_free(b);
    return rc;
}
fn mix_write(path:[]u8, mix:[]u8, nsamp:i64) i64 {
    let b:[]u8 = nio_alloc((nsamp * 8 + 7) as i32);
    let i:i64 = 0;
    while (i < nsamp) {
        put64(b, i * 8, get64(mix, i * 8));
        i = i + 1;
    }
    let rc:i64 = file_write(path, b[0..nsamp * 8]);
    nio_free(b);
    return rc;
}
fn parse_i64(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i64 = 0;
    let neg:i64 = 0;
    while (i < s.len as i64) {
        if (s[i] == 45) { neg = 1; }
        if (s[i] >= 48 && s[i] <= 57) { v = v * 10 + ((s[i] - 48) as i64); }
        i = i + 1;
    }
    if (neg != 0) { v = 0 - v; }
    return v;
}

// ---------- main ----------
// render_f <plan> <out> <mode>
// modes: seq seqmix faultmix susfaultmix
// (no regions: rev/stride/regionmix/driftcheck are vacuous for F)
fn main() void {
    let planp:[]u8 = "plan.txt";
    let outp:[]u8 = "out_f.wav";
    let mode:[]u8 = "seq";
    let a1:[]u8 = _zag_arg(1);
    if (a1.len > 0) { planp = a1; }
    let a2:[]u8 = _zag_arg(2);
    if (a2.len > 0) { outp = a2; }
    let a3:[]u8 = _zag_arg(3);
    if (a3.len > 0) { mode = a3; }
    let lut:[]i64 = nio_alloc(8192) as []i64;
    lut_init(lut);
    let ev:[]u8 = nio_alloc((NEVMAX * EVSZ) as i32);
    let bed:[]u8 = nio_alloc(32);
    let nsbox:[]u8 = nio_alloc(8);
    let sidx:[]u8 = nio_alloc((NEVMAX * 8) as i32);
    let nev:i64 = parse_plan(planp, ev, bed, nsbox);
    if (nev < 0) {
        pout("F: plan read failed\n");
        return;
    }
    let nsamp:i64 = get64(nsbox, 0);
    build_chains(ev, nev, sidx);
    respond_latch(ev, nev);
    pout("F nev=");
    pout(i64s(nev));
    pout(" nsamp=");
    pout(i64s(nsamp));
    pout("\n");
    let mix:[]u8 = nio_alloc((nsamp * 8 + 7) as i32);
    render_flat(ev, lut, bed, mix, sidx, nev, nsamp);
    // fault injection AFTER the render (F never reads the mix, so
    // placement relative to rendering is unobservable; positions match B).
    if (_zag_strcmp(mode, "faultmix") == 1) {
        put64(mix, 132300 * 8, get64(mix, 132300 * 8) ^ 64);
    }
    if (_zag_strcmp(mode, "susfaultmix") == 1) {
        let nreg:i64 = (nsamp + RSAMP - 1) / RSAMP;
        let k:i64 = 0;
        while (k < nreg) {
            put64(mix, k * RSAMP * 8, get64(mix, k * RSAMP * 8) ^ 64);
            k = k + 1;
        }
    }
    let ismix:i64 = 0;
    if (_zag_strcmp(mode, "seqmix") == 1) { ismix = 1; }
    if (_zag_strcmp(mode, "faultmix") == 1) { ismix = 1; }
    if (_zag_strcmp(mode, "susfaultmix") == 1) { ismix = 1; }
    let rc:i64 = 0;
    if (ismix == 1) { rc = mix_write(outp, mix, nsamp); } else { rc = wav_write(outp, mix, nsamp); }
    if (rc < 0) { pout("F: write failed\n"); }
    nio_free(mix);
}

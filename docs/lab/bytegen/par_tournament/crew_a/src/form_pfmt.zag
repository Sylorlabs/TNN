// form_par.zag — Contender A plan FORMATION: pure-parallel plan synthesis.
//
// Every plan event is computed INDEPENDENTLY as event = F(theme, slot):
// no sequential elaboration, no event reads another event's computed
// output. Slot computation order is free (seq | rev | stride); emission is
// always in slot order, so any computation order must yield a byte-identical
// plan (proven by cmp).
//
// RESPOND cross-reference (RT-LONG mechanism): a RESPOND slot's pitch is
// resolved at FORMATION time from the theme's own event specs overlapping
// the plan's source window (max amp; tie -> earliest t0; empty -> nominal).
// This is plan-internal cross-referencing — deterministic, order-free, zero
// output feedback, zero carried state. The emitted plan contains only plain
// EVENT lines, so the renderer stays pure f(plan,t) and needs no changes.
// --xref off emits the nominal (the structural price: the lie propagates).
//
// Pure Zag, pinned znc, zero RNG.
const SRMAX:i64 = 44100;
const DMAX:i64 = 8192;
const STMAX:i64 = 8;
const SPMAX:i64 = 8192;
const ITMAX:i64 = 32768;
const SLMAX:i64 = 8192;

// ---------- io ----------
fn cstr(s:[]u8) []u8 {
    if (s.len < 1 || s.len > 4095) { return ""; }
    let p:*u8 = _zag_malloc((s.len + 1) as i64) as *u8;
    if (p == null as *u8) { return ""; }
    let b:[]u8 = p[0..(s.len + 1)];
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn w_all(fd:i64, b:[]u8) i64 {
    let at:i64 = 0;
    let blen:i64 = b.len as i64;
    while (at < blen) {
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(b) as i64) + at, blen - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { return -7407; }
        at = at + n;
    }
    return at;
}
fn file_read(path:[]u8, cap:i64) []u8 {
    let cs:[]u8 = cstr(path);
    if (cs.len == 0) { return ""; }
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 0, 0, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return ""; }
    let p:*u8 = _zag_malloc(cap) as *u8;
    if (p == null as *u8) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return ""; }
    let at:i64 = 0;
    while (at < cap) {
        let n:i64 = _zag_raw_syscall(0, fd, (p as i64) + at, cap - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let b:[]u8 = p[0..at];
    return b;
}
fn file_write(path:[]u8, b:[]u8) i64 {
    let cs:[]u8 = cstr(path);
    if (cs.len == 0) { return -3; }
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 577, 438, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return -4; }
    let wr:i64 = w_all(fd, b);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if (wr < 0) { return -5; }
    return 0;
}
fn pout(s:[]u8) void {
    _zag_raw_syscall(1, 1, (_zag_slice_ptr(s) as i64), (s.len as i64), 0, 0, 0);
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if (s.len > 0) {
        if (s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    }
    return s;
}

// ---------- arena ----------
fn nio_alloc(n:i32) []u8 {
    if (n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if (p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i32 = 0;
    while (i < n) { b[i] = 0; i = i + 1; }
    return b;
}
fn nio_free(b:[]u8) void { if (b.len > 0) { _zag_free(_zag_slice_ptr(b)); } }
fn put64(b:[]u8, i:i64, v:i64) void {
    b[i] = (v & 255) as u8;
    b[i+1] = ((v >> 8) & 255) as u8;
    b[i+2] = ((v >> 16) & 255) as u8;
    b[i+3] = ((v >> 24) & 255) as u8;
    b[i+4] = ((v >> 32) & 255) as u8;
    b[i+5] = ((v >> 40) & 255) as u8;
    b[i+6] = ((v >> 48) & 255) as u8;
    b[i+7] = ((v >> 56) & 255) as u8;
}
fn get64(b:[]u8, i:i64) i64 {
    return (b[i] as i64) | ((b[i+1] as i64) << 8) | ((b[i+2] as i64) << 16) | ((b[i+3] as i64) << 24) | ((b[i+4] as i64) << 32) | ((b[i+5] as i64) << 40) | ((b[i+6] as i64) << 48) | ((b[i+7] as i64) << 56);
}
fn str_eq(a:[]u8, b:[]u8) i64 {
    if (a.len != b.len) { return 0; }
    let i:i64 = 0;
    while (i < a.len as i64) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn tok_eq(raw:[]u8, off:i64, len:i64, lit:[]u8) i64 {
    if (len != lit.len as i64) { return 0; }
    let i:i64 = 0;
    while (i < len) {
        if (raw[off + i] != lit[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn tok_eq2(raw:[]u8, o1:i64, l1:i64, o2:i64, l2:i64) i64 {
    if (l1 != l2) { return 0; }
    let i:i64 = 0;
    while (i < l1) {
        if (raw[o1 + i] != raw[o2 + i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn atof(s:[]u8, st:i64, en:i64) f64 {
    let neg:f64 = 1.0;
    let v:f64 = 0.0;
    let i:i64 = st;
    if (i < en && s[i] == 45) { neg = -1.0; i = i + 1; }
    while (i < en && s[i] >= 48 && s[i] <= 57) { v = v * 10.0 + ((s[i] - 48) as f64); i = i + 1; }
    if (i < en && s[i] == 46) {
        i = i + 1;
        let div:f64 = 10.0;
        while (i < en && s[i] >= 48 && s[i] <= 57) { v = v + ((s[i] - 48) as f64) / div; div = div * 10.0; i = i + 1; }
    }
    return neg * v;
}
fn atoi_tok(raw:[]u8, off:i64, len:i64) i64 {
    let v:i64 = 0;
    let i:i64 = 0;
    while (i < len) {
        let c:u8 = raw[off + i];
        if (c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
        i = i + 1;
    }
    return v;
}
// decimal string -> integer hundredths (e.g. "2.4"->240, "0.35"->35)
fn hund(raw:[]u8, off:i64, len:i64) i64 {
    let v:i64 = 0;
    let i:i64 = 0;
    let frac:i64 = 0;
    let in_frac:i64 = 0;
    while (i < len) {
        let c:u8 = raw[off + i];
        if (c == 46) { in_frac = 1; }
        else {
            if (c >= 48 && c <= 57) {
                if (in_frac == 0) { v = v * 10 + ((c - 48) as i64); }
                else {
                    if (frac < 2) { v = v * 10 + ((c - 48) as i64); frac = frac + 1; }
                }
            }
        }
        i = i + 1;
    }
    while (frac < 2) { v = v * 10; frac = frac + 1; }
    return v;
}

// ---------- output buffer ----------
fn ob_putc(ob:[]u8, at:i64, c:u8) i64 { ob[at] = c; return at + 1; }
fn ob_puts(ob:[]u8, at:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len as i64) { ob[at + i] = s[i]; i = i + 1; }
    return at + (s.len as i64);
}
fn ob_tok(ob:[]u8, at:i64, raw:[]u8, off:i64, len:i64) i64 {
    let i:i64 = 0;
    while (i < len) { ob[at + i] = raw[off + i]; i = i + 1; }
    return at + len;
}
// format hundredths: strip trailing zeros, keep >=1 decimal ("2.0","2.40"->"2.4")
fn ob_hund(ob:[]u8, at:i64, v:i64) i64 {
    let whole:i64 = v / 100;
    let fr:i64 = v % 100;
    at = ob_puts(ob, at, i64s(whole));
    at = ob_putc(ob, at, 46);
    if (fr % 10 == 0) {
        at = ob_puts(ob, at, i64s(fr / 10));
    } else {
        at = ob_puts(ob, at, i64s(fr / 10));
        at = ob_puts(ob, at, i64s(fr % 10));
    }
    return at;
}

// ============ A-fmt fork: sharded parallel formation ============
// Record helpers and shard/assemble modes. Pure Zag, zero RNG.

fn parse_i64(b:[]u8, off:i64, len:i64) i64 {
    let v:i64 = 0;
    let neg:i64 = 0;
    let i:i64 = 0;
    if (len > 0 && b[off] == 45) { neg = 1; i = 1; }
    while (i < len) {
        let c:i64 = b[off + i] as i64;
        if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); }
        i = i + 1;
    }
    if (neg == 1) { v = 0 - v; }
    return v;
}

fn argv_atoi(n:i64) i64 {
    let s:[]u8 = _zag_arg(n);
    return parse_i64(s, 0, s.len as i64);
}

fn line_end(sb:[]u8, pos:i64, slen:i64) i64 {
    let le:i64 = pos;
    while (le < slen && sb[le] != 10) { le = le + 1; }
    return le;
}

// E record: "E <len>\n<bytes>\n" (one precomputed emission line)
fn sh_E(ob:[]u8, at:i64, src:[]u8) i64 {
    at = ob_puts(ob, at, "E ");
    at = ob_puts(ob, at, i64s(src.len as i64));
    at = ob_putc(ob, at, 10);
    let q:i64 = 0;
    let qn:i64 = src.len as i64;
    while (q < qn) { ob[at] = src[q]; at = at + 1; q = q + 1; }
    at = ob_putc(ob, at, 10);
    return at;
}

// T record: "T <t0s> <durs> <amp> <flen>\n<freqbytes>\n" (pass-1 spec)
fn sh_T(ob:[]u8, at:i64, t0s:i64, durs:i64, amp:i64, raw:[]u8, fo:i64, fl:i64) i64 {
    at = ob_puts(ob, at, "T ");
    at = ob_puts(ob, at, i64s(t0s));
    at = ob_putc(ob, at, 32);
    at = ob_puts(ob, at, i64s(durs));
    at = ob_putc(ob, at, 32);
    at = ob_puts(ob, at, i64s(amp));
    at = ob_putc(ob, at, 32);
    at = ob_puts(ob, at, i64s(fl));
    at = ob_putc(ob, at, 10);
    let q:i64 = 0;
    while (q < fl) { ob[at] = raw[fo + q]; at = at + 1; q = q + 1; }
    at = ob_putc(ob, at, 10);
    return at;
}

// R record: "R\n" + 7 x "<len>\n<tokenbytes>\n" (RESPOND, deferred to assemble)
fn sh_R(ob:[]u8, at:i64, raw:[]u8, d_tokoff:[]u8, d_toklen:[]u8, dd:i64) i64 {
    at = ob_puts(ob, at, "R\n");
    let ti:i64 = 0;
    while (ti < 7) {
        let to:i64 = get64(d_tokoff, (dd * 16 + ti) * 8);
        let tl:i64 = get64(d_toklen, (dd * 16 + ti) * 8);
        at = ob_puts(ob, at, i64s(tl));
        at = ob_putc(ob, at, 10);
        let q:i64 = 0;
        while (q < tl) { ob[at] = raw[to + q]; at = at + 1; q = q + 1; }
        at = ob_putc(ob, at, 10);
        ti = ti + 1;
    }
    return at;
}

// Per-directive shard records. Mirrors form_par's pass-1 + slot-emission math
// exactly (same atof/hund/atoi_tok calls); only the output sink differs.
fn shard_directive(ob:[]u8, at:i64, lb:[]u8, raw:[]u8, sr:i64,
    d_kind:[]u8, d_tokoff:[]u8, d_toklen:[]u8, d_struct:[]u8,
    st_noff:[]u8, st_nlen:[]u8, st_nn:[]u8, st_poff:[]u8, st_plen:[]u8,
    dd:i64) i64 {
    let dk:i64 = get64(d_kind, dd * 8);
    if (dk == 0) {
        // INST: expand notes (same math as form_par pass-1 + slot emit)
        let si:i64 = get64(d_struct, dd * 8);
        if (si >= 0) {
            let nn:i64 = get64(st_nn, si * 8);
            let t0o:i64 = get64(d_tokoff, (dd * 16 + 1) * 8);
            let t0l:i64 = get64(d_toklen, (dd * 16 + 1) * 8);
            let t0h:i64 = hund(raw, t0o, t0l);
            let t0f:f64 = atof(raw, t0o, t0o + t0l);
            let spo0:i64 = get64(st_poff, (si * 7) * 8);
            let spl0:i64 = get64(st_plen, (si * 7) * 8);
            let steph:i64 = hund(raw, spo0, spl0);
            let stepf:f64 = atof(raw, spo0, spo0 + spl0);
            let spo1:i64 = get64(st_poff, (si * 7 + 1) * 8);
            let spl1:i64 = get64(st_plen, (si * 7 + 1) * 8);
            let durf:f64 = atof(raw, spo1, spo1 + spl1);
            let amp:i64 = atoi_tok(raw, get64(st_poff, (si * 7 + 2) * 8), get64(st_plen, (si * 7 + 2) * 8));
            let kk:i64 = 0;
            while (kk < nn) {
                let t0s:i64 = ((t0f + (kk as f64) * stepf) * (sr as f64)) as i64;
                let durs:i64 = (durf * (sr as f64)) as i64;
                let nno:i64 = get64(st_noff, (si * 16 + kk) * 8);
                let nnl:i64 = get64(st_nlen, (si * 16 + kk) * 8);
                at = sh_T(ob, at, t0s, durs, amp, raw, nno, nnl);
                let lat:i64 = 0;
                lat = ob_puts(lb, lat, "EVENT ");
                lat = ob_hund(lb, lat, t0h + kk * steph);
                lat = ob_putc(lb, lat, 32);
                lat = ob_tok(lb, lat, raw, spo1, spl1);
                lat = ob_putc(lb, lat, 32);
                lat = ob_tok(lb, lat, raw, nno, nnl);
                let pp:i64 = 2;
                while (pp < 7) {
                    lat = ob_putc(lb, lat, 32);
                    lat = ob_tok(lb, lat, raw, get64(st_poff, (si * 7 + pp) * 8), get64(st_plen, (si * 7 + pp) * 8));
                    pp = pp + 1;
                }
                at = sh_E(ob, at, lb[0..lat]);
                kk = kk + 1;
            }
        }
        return at;
    }
    if (dk == 1) {
        return shard_evt(ob, at, lb, raw, sr, d_tokoff, d_toklen, dd);
    }
    if (dk == 2) {
        return shard_evt(ob, at, lb, raw, sr, d_tokoff, d_toklen, dd);
    }
    if (dk == 3) {
        return shard_evt(ob, at, lb, raw, sr, d_tokoff, d_toklen, dd);
    }
    if (dk == 4) {
        return sh_R(ob, at, raw, d_tokoff, d_toklen, dd);
    }
    if (dk == 5) {
        let lat:i64 = 0;
        lat = ob_puts(lb, lat, "SR ");
        lat = ob_tok(lb, lat, raw, get64(d_tokoff, (dd * 16) * 8), get64(d_toklen, (dd * 16) * 8));
        return sh_E(ob, at, lb[0..lat]);
    }
    if (dk == 6) {
        let lat:i64 = 0;
        lat = ob_puts(lb, lat, "DUR_S ");
        lat = ob_tok(lb, lat, raw, get64(d_tokoff, (dd * 16) * 8), get64(d_toklen, (dd * 16) * 8));
        return sh_E(ob, at, lb[0..lat]);
    }
    if (dk == 7) {
        let lat:i64 = 0;
        lat = ob_puts(lb, lat, "BED ");
        let bi:i64 = 0;
        while (bi < 4) {
            if (bi > 0) { lat = ob_putc(lb, lat, 32); }
            lat = ob_tok(lb, lat, raw, get64(d_tokoff, (dd * 16 + bi) * 8), get64(d_toklen, (dd * 16 + bi) * 8));
            bi = bi + 1;
        }
        return sh_E(ob, at, lb[0..lat]);
    }
    return at;
}

// ARC/TAIL/EVENT: single spec + verbatim re-emit line
fn shard_evt(ob:[]u8, at:i64, lb:[]u8, raw:[]u8, sr:i64,
    d_tokoff:[]u8, d_toklen:[]u8, dd:i64) i64 {
    let t0o:i64 = get64(d_tokoff, (dd * 16) * 8);
    let t0l:i64 = get64(d_toklen, (dd * 16) * 8);
    let duo:i64 = get64(d_tokoff, (dd * 16 + 1) * 8);
    let dul:i64 = get64(d_toklen, (dd * 16 + 1) * 8);
    let t0s:i64 = (atof(raw, t0o, t0o + t0l) * (sr as f64)) as i64;
    let durs:i64 = (atof(raw, duo, duo + dul) * (sr as f64)) as i64;
    let amp:i64 = atoi_tok(raw, get64(d_tokoff, (dd * 16 + 3) * 8), get64(d_toklen, (dd * 16 + 3) * 8));
    let fo:i64 = get64(d_tokoff, (dd * 16 + 2) * 8);
    let fl:i64 = get64(d_toklen, (dd * 16 + 2) * 8);
    at = sh_T(ob, at, t0s, durs, amp, raw, fo, fl);
    let lat:i64 = 0;
    lat = ob_puts(lb, lat, "EVENT ");
    let ti:i64 = 0;
    while (ti < 8) {
        if (ti > 0) { lat = ob_putc(lb, lat, 32); }
        lat = ob_tok(lb, lat, raw, get64(d_tokoff, (dd * 16 + ti) * 8), get64(d_toklen, (dd * 16 + ti) * 8));
        ti = ti + 1;
    }
    return sh_E(ob, at, lb[0..lat]);
}

fn do_shard() i32 {
    let themep:[]u8 = _zag_arg(2);
    let shardp:[]u8 = _zag_arg(3);
    let k:i64 = argv_atoi(4);
    let S:i64 = argv_atoi(5);
    if (S < 1) { S = 1; }
    if (k < 0) { k = 0; }
    if (k >= S) { k = S - 1; }
    let raw:[]u8 = file_read(themep, 1048576);
    if (raw.len == 0) { pout("no theme\n"); return 2; }
    let n:i64 = raw.len as i64;
    // directive storage: kind + up to 16 tokens (off,len)
    let d_kind:[]u8 = nio_alloc((DMAX * 8) as i32);
    let d_tokoff:[]u8 = nio_alloc((DMAX * 16 * 8) as i32);
    let d_toklen:[]u8 = nio_alloc((DMAX * 16 * 8) as i32);
    let d_ntok:[]u8 = nio_alloc((DMAX * 8) as i32);
    let d_struct:[]u8 = nio_alloc((DMAX * 8) as i32);
    // struct storage
    let st_idoff:[]u8 = nio_alloc((STMAX * 8) as i32);
    let st_idlen:[]u8 = nio_alloc((STMAX * 8) as i32);
    let st_nn:[]u8 = nio_alloc((STMAX * 8) as i32);
    let st_noff:[]u8 = nio_alloc((STMAX * 16 * 8) as i32);
    let st_nlen:[]u8 = nio_alloc((STMAX * 16 * 8) as i32);
    // param token (off,len) pairs per struct: step dur amp tim glide vibhz vibc
    let st_poff:[]u8 = nio_alloc((STMAX * 7 * 8) as i32);
    let st_plen:[]u8 = nio_alloc((STMAX * 7 * 8) as i32);
    // emission items: 0=comment(off,len) 1=directive(idx)
    let it_kind:[]u8 = nio_alloc((ITMAX * 8) as i32);
    let it_a:[]u8 = nio_alloc((ITMAX * 8) as i32);
    let it_b:[]u8 = nio_alloc((ITMAX * 8) as i32);

    let nd:i64 = 0;
    let nst:i64 = 0;
    let nit:i64 = 0;
    let sr:i64 = SRMAX;

    // ---- theme parse (input stage; completes before any slot is computed) ----
    let pos:i64 = 0;
    while (pos < n) {
        let le:i64 = pos;
        while (le < n && raw[le] != 10) { le = le + 1; }
        if (le > pos) {
            if (raw[pos] == 35) {
                // comment line: copied verbatim at emission
                put64(it_kind, nit * 8, 0);
                put64(it_a, nit * 8, pos);
                put64(it_b, nit * 8, le - pos);
                nit = nit + 1;
            } else {
                // tokenize
                let toff:[]u8 = nio_alloc(256);
                let tlen:[]u8 = nio_alloc(256);
                let nt:i64 = 0;
                let p:i64 = pos;
                while (p < le && nt < 32) {
                    while (p < le && raw[p] == 32) { p = p + 1; }
                    if (p >= le) { break; }
                    let fs:i64 = p;
                    while (p < le && raw[p] != 32) { p = p + 1; }
                    put64(toff, nt * 8, fs);
                    put64(tlen, nt * 8, p - fs);
                    nt = nt + 1;
                }
                let t0o:i64 = get64(toff, 0);
                let t0l:i64 = get64(tlen, 0);
                if (tok_eq(raw, t0o, t0l, "STRUCT") == 1 && nst < STMAX) {
                    // STRUCT id NOTES f... STEP s DUR d AMP a TIMBRE t GLIDE g VIB hz c
                    put64(st_idoff, nst * 8, get64(toff, 8));
                    put64(st_idlen, nst * 8, get64(tlen, 8));
                    let nn:i64 = 0;
                    let pi:i64 = 0;
                    let qi:i64 = 2; // expect NOTES
                    if (tok_eq(raw, get64(toff, 16), get64(tlen, 16), "NOTES") == 1) { qi = 3; }
                    while (qi < nt && nn < 16) {
                        let qo:i64 = get64(toff, qi * 8);
                        let ql:i64 = get64(tlen, qi * 8);
                        if (tok_eq(raw, qo, ql, "STEP") == 1) { break; }
                        put64(st_noff, (nst * 16 + nn) * 8, qo);
                        put64(st_nlen, (nst * 16 + nn) * 8, ql);
                        nn = nn + 1;
                        qi = qi + 1;
                    }
                    put64(st_nn, nst * 8, nn);
                    // qi -> STEP s DUR d AMP a TIMBRE t GLIDE g VIB hz c
                    while (qi < nt && pi < 7) {
                        let qo:i64 = get64(toff, qi * 8);
                        let ql:i64 = get64(tlen, qi * 8);
                        if (tok_eq(raw, qo, ql, "STEP") == 1 && qi + 1 < nt) {
                            put64(st_poff, (nst * 7) * 8, get64(toff, (qi + 1) * 8));
                            put64(st_plen, (nst * 7) * 8, get64(tlen, (qi + 1) * 8));
                            qi = qi + 2;
                        } else {
                            if (tok_eq(raw, qo, ql, "DUR") == 1 && qi + 1 < nt) {
                                put64(st_poff, (nst * 7 + 1) * 8, get64(toff, (qi + 1) * 8));
                                put64(st_plen, (nst * 7 + 1) * 8, get64(tlen, (qi + 1) * 8));
                                qi = qi + 2;
                            } else {
                                if (tok_eq(raw, qo, ql, "AMP") == 1 && qi + 1 < nt) {
                                    put64(st_poff, (nst * 7 + 2) * 8, get64(toff, (qi + 1) * 8));
                                    put64(st_plen, (nst * 7 + 2) * 8, get64(tlen, (qi + 1) * 8));
                                    qi = qi + 2;
                                } else {
                                    if (tok_eq(raw, qo, ql, "TIMBRE") == 1 && qi + 1 < nt) {
                                        put64(st_poff, (nst * 7 + 3) * 8, get64(toff, (qi + 1) * 8));
                                        put64(st_plen, (nst * 7 + 3) * 8, get64(tlen, (qi + 1) * 8));
                                        qi = qi + 2;
                                    } else {
                                        if (tok_eq(raw, qo, ql, "GLIDE") == 1 && qi + 1 < nt) {
                                            put64(st_poff, (nst * 7 + 4) * 8, get64(toff, (qi + 1) * 8));
                                            put64(st_plen, (nst * 7 + 4) * 8, get64(tlen, (qi + 1) * 8));
                                            qi = qi + 2;
                                        } else {
                                            if (tok_eq(raw, qo, ql, "VIB") == 1 && qi + 2 < nt) {
                                                put64(st_poff, (nst * 7 + 5) * 8, get64(toff, (qi + 1) * 8));
                                                put64(st_plen, (nst * 7 + 5) * 8, get64(tlen, (qi + 1) * 8));
                                                put64(st_poff, (nst * 7 + 6) * 8, get64(toff, (qi + 2) * 8));
                                                put64(st_plen, (nst * 7 + 6) * 8, get64(tlen, (qi + 2) * 8));
                                                qi = qi + 3;
                                            } else { qi = qi + 1; }
                                        }
                                    }
                                }
                            }
                        }
                        pi = pi + 1;
                    }
                    nst = nst + 1;
                } else {
                    if (nd < DMAX && nit < ITMAX) {
                        let kind:i64 = -1;
                        let want:i64 = 0;
                        if (tok_eq(raw, t0o, t0l, "SR") == 1) { kind = 5; want = 1; }
                        if (tok_eq(raw, t0o, t0l, "DUR_S") == 1) { kind = 6; want = 1; }
                        if (tok_eq(raw, t0o, t0l, "BED") == 1) { kind = 7; want = 4; }
                        if (tok_eq(raw, t0o, t0l, "INST") == 1) { kind = 0; want = 2; }
                        if (tok_eq(raw, t0o, t0l, "ARC") == 1) { kind = 1; want = 8; }
                        if (tok_eq(raw, t0o, t0l, "TAIL") == 1) { kind = 2; want = 8; }
                        if (tok_eq(raw, t0o, t0l, "EVENT") == 1) { kind = 3; want = 8; }
                        if (tok_eq(raw, t0o, t0l, "RESPOND") == 1) { kind = 4; want = 7; }
                        if (kind >= 0 && nt - 1 >= want) {
                            put64(d_kind, nd * 8, kind);
                            put64(d_ntok, nd * 8, want);
                            let ti:i64 = 0;
                            while (ti < want) {
                                put64(d_tokoff, (nd * 16 + ti) * 8, get64(toff, (ti + 1) * 8));
                                put64(d_toklen, (nd * 16 + ti) * 8, get64(tlen, (ti + 1) * 8));
                                ti = ti + 1;
                            }
                            if (kind == 5) {
                                sr = atoi_tok(raw, get64(toff, 8), get64(tlen, 8));
                                if (sr < 1) { sr = SRMAX; }
                            }
                            if (kind == 0) {
                                // resolve struct id -> index
                                let io:i64 = get64(toff, 8);
                                let il:i64 = get64(tlen, 8);
                                let si:i64 = 0;
                                let found:i64 = -1;
                                while (si < nst) {
                                    if (tok_eq2(raw, io, il, get64(st_idoff, si * 8), get64(st_idlen, si * 8)) == 1) { found = si; }
                                    si = si + 1;
                                }
                                put64(d_struct, nd * 8, found);
                            }
                            put64(it_kind, nit * 8, 1);
                            put64(it_a, nit * 8, nd);
                            nit = nit + 1;
                            nd = nd + 1;
                        }
                    }
                }
                nio_free(toff);
                nio_free(tlen);
            }
        }
        pos = le + 1;
    }

    // directive range for this shard (contiguous, order-preserving)
    let d0:i64 = (k * nd) / S;
    let d1:i64 = ((k + 1) * nd) / S;
    let ob:[]u8 = nio_alloc(2097152);
    let at:i64 = 0;
    let lb:[]u8 = nio_alloc(1024);
    at = ob_puts(ob, at, "PFMT1 ");
    at = ob_puts(ob, at, i64s(k));
    at = ob_putc(ob, at, 32);
    at = ob_puts(ob, at, i64s(S));
    at = ob_putc(ob, at, 32);
    at = ob_puts(ob, at, i64s(d0));
    at = ob_putc(ob, at, 32);
    at = ob_puts(ob, at, i64s(d1));
    at = ob_putc(ob, at, 32);
    at = ob_puts(ob, at, i64s(sr));
    at = ob_putc(ob, at, 10);
    // comment ownership: each comment attaches to its FOLLOWING directive's
    // shard (trailing comments -> last directive; no directives -> shard 0),
    // so every comment is emitted exactly once across shards.
    let owner:[]u8 = nio_alloc((ITMAX * 8) as i32);
    let bwi:i64 = nit - 1;
    let next_dd:i64 = -1;
    while (bwi >= 0) {
        let bik:i64 = get64(it_kind, bwi * 8);
        if (bik == 1) {
            next_dd = get64(it_a, bwi * 8);
            put64(owner, bwi * 8, next_dd);
        } else {
            let od:i64 = next_dd;
            if (od < 0 && nd > 0) { od = nd - 1; }
            if (od < 0) { od = 0; }
            put64(owner, bwi * 8, od);
        }
        bwi = bwi - 1;
    }
    // walk theme items in order; emit records only for in-range directives
    let ii:i64 = 0;
    while (ii < nit) {
        let ik:i64 = get64(it_kind, ii * 8);
        if (ik == 0) {
            let od:i64 = get64(owner, ii * 8);
            if ((od >= d0 && od < d1) || (nd == 0 && k == 0)) {
                let co:i64 = get64(it_a, ii * 8);
                let cl:i64 = get64(it_b, ii * 8);
                at = sh_E(ob, at, raw[co..co+cl]);
            }
        } else {
            let dd:i64 = get64(it_a, ii * 8);
            if (dd >= d0 && dd < d1) {
                at = shard_directive(ob, at, lb, raw, sr, d_kind, d_tokoff, d_toklen, d_struct, st_noff, st_nlen, st_nn, st_poff, st_plen, dd);
            }
        }
        ii = ii + 1;
    }
    let ob2:[]u8 = ob[0..at];
    let rc:i64 = file_write(shardp, ob2);
    pout("shard wrote ");
    pout(shardp);
    pout(" bytes=");
    pout(i64s(at));
    pout(" rc=");
    pout(i64s(rc));
    pout("\n");
    return 0;
}

fn do_assemble() i32 {
    let outp:[]u8 = _zag_arg(2);
    let S:i64 = argv_atoi(3);
    if (S < 1) { S = 1; }
    let arena:[]u8 = nio_alloc(4194304);
    let ab:i64 = 0;
    // spec table (pass A accumulates; pass B resolves against it)
    let sp_t0s:[]u8 = nio_alloc((SPMAX * 8) as i32);
    let sp_durs:[]u8 = nio_alloc((SPMAX * 8) as i32);
    let sp_amp:[]u8 = nio_alloc((SPMAX * 8) as i32);
    let sp_foff:[]u8 = nio_alloc((SPMAX * 8) as i32);
    let sp_flen:[]u8 = nio_alloc((SPMAX * 8) as i32);
    let nsp:i64 = 0;
    // emission record stream: 0=E (arena off/len), 2=R (R index)
    let rk:[]u8 = nio_alloc((32768 * 8) as i32);
    let ra:[]u8 = nio_alloc((32768 * 8) as i32);
    let rb:[]u8 = nio_alloc((32768 * 8) as i32);
    let nrec:i64 = 0;
    // R token pool: 7 (off,len) pairs per RESPOND
    let r_off:[]u8 = nio_alloc((8192 * 7 * 8) as i32);
    let r_len:[]u8 = nio_alloc((8192 * 7 * 8) as i32);
    let nr:i64 = 0;
    let sr:i64 = 44100;
    // ---- pass A: read shards, build spec table + record stream ----
    let kk:i64 = 0;
    while (kk < S) {
        let shp:[]u8 = _zag_arg(4 + kk);
        let sb:[]u8 = file_read(shp, 4194304);
        let slen:i64 = sb.len as i64;
        let pos:i64 = 0;
        while (pos < slen) {
            let le:i64 = line_end(sb, pos, slen);
            let c:u8 = sb[pos];
            if (c == 80) {
                // PFMT1 k S d0 d1 sr: take 6th token as sr
                let a:i64 = pos;
                let ti:i64 = 0;
                while (ti < 5) {
                    while (a < le && sb[a] != 32) { a = a + 1; }
                    a = a + 1;
                    ti = ti + 1;
                }
                sr = parse_i64(sb, a, le - a);
                pos = le + 1;
            } else {
                if (c == 69) {
                    // E <len>\n<bytes>\n
                    let ln:i64 = parse_i64(sb, pos + 2, le - pos - 2);
                    pos = le + 1;
                    let ao:i64 = ab;
                    let q:i64 = 0;
                    while (q < ln) { arena[ab] = sb[pos + q]; ab = ab + 1; q = q + 1; }
                    pos = pos + ln;
                    if (pos < slen && sb[pos] == 10) { pos = pos + 1; }
                    put64(rk, nrec * 8, 0);
                    put64(ra, nrec * 8, ao);
                    put64(rb, nrec * 8, ln);
                    nrec = nrec + 1;
                } else {
                    if (c == 84) {
                        // T <t0s> <durs> <amp> <flen>\n<freq>\n
                        let a:i64 = pos + 2;
                        let b:i64 = a;
                        while (b < le && sb[b] != 32) { b = b + 1; }
                        let t0s:i64 = parse_i64(sb, a, b - a);
                        b = b + 1;
                        a = b;
                        while (b < le && sb[b] != 32) { b = b + 1; }
                        let durs:i64 = parse_i64(sb, a, b - a);
                        b = b + 1;
                        a = b;
                        while (b < le && sb[b] != 32) { b = b + 1; }
                        let amp:i64 = parse_i64(sb, a, b - a);
                        b = b + 1;
                        a = b;
                        while (b < le && sb[b] != 32) { b = b + 1; }
                        let fl:i64 = parse_i64(sb, a, b - a);
                        pos = le + 1;
                        let ao:i64 = ab;
                        let q:i64 = 0;
                        while (q < fl) { arena[ab] = sb[pos + q]; ab = ab + 1; q = q + 1; }
                        pos = pos + fl;
                        if (pos < slen && sb[pos] == 10) { pos = pos + 1; }
                        put64(sp_t0s, nsp * 8, t0s);
                        put64(sp_durs, nsp * 8, durs);
                        put64(sp_amp, nsp * 8, amp);
                        put64(sp_foff, nsp * 8, ao);
                        put64(sp_flen, nsp * 8, fl);
                        nsp = nsp + 1;
                    } else {
                        if (c == 82) {
                            // R\n + 7 x "<len>\n<token>\n"
                            pos = le + 1;
                            let ti:i64 = 0;
                            while (ti < 7) {
                                let le2:i64 = line_end(sb, pos, slen);
                                let ln:i64 = parse_i64(sb, pos, le2 - pos);
                                pos = le2 + 1;
                                let ao:i64 = ab;
                                let q:i64 = 0;
                                while (q < ln) { arena[ab] = sb[pos + q]; ab = ab + 1; q = q + 1; }
                                pos = pos + ln;
                                if (pos < slen && sb[pos] == 10) { pos = pos + 1; }
                                put64(r_off, (nr * 7 + ti) * 8, ao);
                                put64(r_len, (nr * 7 + ti) * 8, ln);
                                ti = ti + 1;
                            }
                            put64(rk, nrec * 8, 2);
                            put64(ra, nrec * 8, nr);
                            nrec = nrec + 1;
                            nr = nr + 1;
                        } else {
                            pos = le + 1;
                        }
                    }
                }
            }
        }
        kk = kk + 1;
    }
    pout("assemble: specs=");
    pout(i64s(nsp));
    pout(" records=");
    pout(i64s(nrec));
    pout(" responds=");
    pout(i64s(nr));
    pout(" sr=");
    pout(i64s(sr));
    pout("\n");
    // ---- pass B: emit; resolve each RESPOND against the full spec table ----
    let out:[]u8 = nio_alloc(1048576);
    let oat:i64 = 0;
    let ri:i64 = 0;
    while (ri < nrec) {
        let k2:i64 = get64(rk, ri * 8);
        if (k2 == 0) {
            let ao:i64 = get64(ra, ri * 8);
            let ln:i64 = get64(rb, ri * 8);
            let q:i64 = 0;
            while (q < ln) { out[oat] = arena[ao + q]; oat = oat + 1; q = q + 1; }
            out[oat] = 10;
            oat = oat + 1;
        } else {
            let rj:i64 = get64(ra, ri * 8);
            let o0:i64 = get64(r_off, (rj * 7 + 0) * 8);
            let l0:i64 = get64(r_len, (rj * 7 + 0) * 8);
            let o1:i64 = get64(r_off, (rj * 7 + 1) * 8);
            let l1:i64 = get64(r_len, (rj * 7 + 1) * 8);
            let o2:i64 = get64(r_off, (rj * 7 + 2) * 8);
            let l2:i64 = get64(r_len, (rj * 7 + 2) * 8);
            let o3:i64 = get64(r_off, (rj * 7 + 3) * 8);
            let l3:i64 = get64(r_len, (rj * 7 + 3) * 8);
            let o4:i64 = get64(r_off, (rj * 7 + 4) * 8);
            let l4:i64 = get64(r_len, (rj * 7 + 4) * 8);
            let o5:i64 = get64(r_off, (rj * 7 + 5) * 8);
            let l5:i64 = get64(r_len, (rj * 7 + 5) * 8);
            let o6:i64 = get64(r_off, (rj * 7 + 6) * 8);
            let l6:i64 = get64(r_len, (rj * 7 + 6) * 8);
            let w0s:i64 = (atof(arena, o2, o2 + l2) * (sr as f64)) as i64;
            let w1s:i64 = (atof(arena, o3, o3 + l3) * (sr as f64)) as i64;
            let best:i64 = -1;
            let best_amp:i64 = -1;
            let best_t0:i64 = 0;
            let q:i64 = 0;
            while (q < nsp) {
                let qt:i64 = get64(sp_t0s, q * 8);
                let qd:i64 = get64(sp_durs, q * 8);
                if (qt < w1s && qt + qd > w0s) {
                    let qa:i64 = get64(sp_amp, q * 8);
                    if (qa > best_amp || (qa == best_amp && qt < best_t0)) {
                        best = q;
                        best_amp = qa;
                        best_t0 = qt;
                    }
                }
                q = q + 1;
            }
            let fo:i64 = o6;
            let fl:i64 = l6;
            if (best >= 0) {
                fo = get64(sp_foff, best * 8);
                fl = get64(sp_flen, best * 8);
            }
            oat = ob_puts(out, oat, "EVENT ");
            oat = ob_tok(out, oat, arena, o0, l0);
            oat = ob_putc(out, oat, 32);
            oat = ob_tok(out, oat, arena, o1, l1);
            oat = ob_putc(out, oat, 32);
            oat = ob_tok(out, oat, arena, fo, fl);
            oat = ob_putc(out, oat, 32);
            oat = ob_tok(out, oat, arena, o4, l4);
            oat = ob_putc(out, oat, 32);
            oat = ob_tok(out, oat, arena, o5, l5);
            oat = ob_puts(out, oat, " 0.0 0 0\n");
        }
        ri = ri + 1;
    }
    let ob2:[]u8 = out[0..oat];
    let rc:i64 = file_write(outp, ob2);
    pout("assemble wrote ");
    pout(outp);
    pout(" bytes=");
    pout(i64s(oat));
    pout(" rc=");
    pout(i64s(rc));
    pout("\n");
    return 0;
}

fn main() i32 {
    let mode:[]u8 = _zag_arg(1);
    if (str_eq(mode, "shard") == 1) { return do_shard(); }
    if (str_eq(mode, "assemble") == 1) { return do_assemble(); }
    let themep:[]u8 = _zag_arg(1);
    let outp:[]u8 = _zag_arg(2);
    if (str_eq(mode, "seq") == 1) {
        themep = _zag_arg(2);
        outp = _zag_arg(3);
    }
    if (themep.len == 0) { themep = "theme_v1.txt"; }
    if (outp.len == 0) { outp = "plan_formed.txt"; }
    let orderm:[]u8 = _zag_arg(3);
    let order:i64 = 0; // 0 seq, 1 rev, 2 stride
    if (str_eq(orderm, "rev")) { order = 1; }
    if (str_eq(orderm, "stride")) { order = 2; }
    let xrefm:[]u8 = _zag_arg(4);
    let xref:i64 = 1;
    if (str_eq(xrefm, "off")) { xref = 0; }

    let raw:[]u8 = file_read(themep, 1048576);
    if (raw.len == 0) { pout("no theme\n"); return 2; }
    let n:i64 = raw.len as i64;

    // directive storage: kind + up to 16 tokens (off,len)
    let d_kind:[]u8 = nio_alloc((DMAX * 8) as i32);
    let d_tokoff:[]u8 = nio_alloc((DMAX * 16 * 8) as i32);
    let d_toklen:[]u8 = nio_alloc((DMAX * 16 * 8) as i32);
    let d_ntok:[]u8 = nio_alloc((DMAX * 8) as i32);
    let d_struct:[]u8 = nio_alloc((DMAX * 8) as i32);
    // struct storage
    let st_idoff:[]u8 = nio_alloc((STMAX * 8) as i32);
    let st_idlen:[]u8 = nio_alloc((STMAX * 8) as i32);
    let st_nn:[]u8 = nio_alloc((STMAX * 8) as i32);
    let st_noff:[]u8 = nio_alloc((STMAX * 16 * 8) as i32);
    let st_nlen:[]u8 = nio_alloc((STMAX * 16 * 8) as i32);
    // param token (off,len) pairs per struct: step dur amp tim glide vibhz vibc
    let st_poff:[]u8 = nio_alloc((STMAX * 7 * 8) as i32);
    let st_plen:[]u8 = nio_alloc((STMAX * 7 * 8) as i32);
    // emission items: 0=comment(off,len) 1=directive(idx)
    let it_kind:[]u8 = nio_alloc((ITMAX * 8) as i32);
    let it_a:[]u8 = nio_alloc((ITMAX * 8) as i32);
    let it_b:[]u8 = nio_alloc((ITMAX * 8) as i32);

    let nd:i64 = 0;
    let nst:i64 = 0;
    let nit:i64 = 0;
    let sr:i64 = SRMAX;

    // ---- theme parse (input stage; completes before any slot is computed) ----
    let pos:i64 = 0;
    while (pos < n) {
        let le:i64 = pos;
        while (le < n && raw[le] != 10) { le = le + 1; }
        if (le > pos) {
            if (raw[pos] == 35) {
                // comment line: copied verbatim at emission
                put64(it_kind, nit * 8, 0);
                put64(it_a, nit * 8, pos);
                put64(it_b, nit * 8, le - pos);
                nit = nit + 1;
            } else {
                // tokenize
                let toff:[]u8 = nio_alloc(256);
                let tlen:[]u8 = nio_alloc(256);
                let nt:i64 = 0;
                let p:i64 = pos;
                while (p < le && nt < 32) {
                    while (p < le && raw[p] == 32) { p = p + 1; }
                    if (p >= le) { break; }
                    let fs:i64 = p;
                    while (p < le && raw[p] != 32) { p = p + 1; }
                    put64(toff, nt * 8, fs);
                    put64(tlen, nt * 8, p - fs);
                    nt = nt + 1;
                }
                let t0o:i64 = get64(toff, 0);
                let t0l:i64 = get64(tlen, 0);
                if (tok_eq(raw, t0o, t0l, "STRUCT") == 1 && nst < STMAX) {
                    // STRUCT id NOTES f... STEP s DUR d AMP a TIMBRE t GLIDE g VIB hz c
                    put64(st_idoff, nst * 8, get64(toff, 8));
                    put64(st_idlen, nst * 8, get64(tlen, 8));
                    let nn:i64 = 0;
                    let pi:i64 = 0;
                    let qi:i64 = 2; // expect NOTES
                    if (tok_eq(raw, get64(toff, 16), get64(tlen, 16), "NOTES") == 1) { qi = 3; }
                    while (qi < nt && nn < 16) {
                        let qo:i64 = get64(toff, qi * 8);
                        let ql:i64 = get64(tlen, qi * 8);
                        if (tok_eq(raw, qo, ql, "STEP") == 1) { break; }
                        put64(st_noff, (nst * 16 + nn) * 8, qo);
                        put64(st_nlen, (nst * 16 + nn) * 8, ql);
                        nn = nn + 1;
                        qi = qi + 1;
                    }
                    put64(st_nn, nst * 8, nn);
                    // qi -> STEP s DUR d AMP a TIMBRE t GLIDE g VIB hz c
                    while (qi < nt && pi < 7) {
                        let qo:i64 = get64(toff, qi * 8);
                        let ql:i64 = get64(tlen, qi * 8);
                        if (tok_eq(raw, qo, ql, "STEP") == 1 && qi + 1 < nt) {
                            put64(st_poff, (nst * 7) * 8, get64(toff, (qi + 1) * 8));
                            put64(st_plen, (nst * 7) * 8, get64(tlen, (qi + 1) * 8));
                            qi = qi + 2;
                        } else {
                            if (tok_eq(raw, qo, ql, "DUR") == 1 && qi + 1 < nt) {
                                put64(st_poff, (nst * 7 + 1) * 8, get64(toff, (qi + 1) * 8));
                                put64(st_plen, (nst * 7 + 1) * 8, get64(tlen, (qi + 1) * 8));
                                qi = qi + 2;
                            } else {
                                if (tok_eq(raw, qo, ql, "AMP") == 1 && qi + 1 < nt) {
                                    put64(st_poff, (nst * 7 + 2) * 8, get64(toff, (qi + 1) * 8));
                                    put64(st_plen, (nst * 7 + 2) * 8, get64(tlen, (qi + 1) * 8));
                                    qi = qi + 2;
                                } else {
                                    if (tok_eq(raw, qo, ql, "TIMBRE") == 1 && qi + 1 < nt) {
                                        put64(st_poff, (nst * 7 + 3) * 8, get64(toff, (qi + 1) * 8));
                                        put64(st_plen, (nst * 7 + 3) * 8, get64(tlen, (qi + 1) * 8));
                                        qi = qi + 2;
                                    } else {
                                        if (tok_eq(raw, qo, ql, "GLIDE") == 1 && qi + 1 < nt) {
                                            put64(st_poff, (nst * 7 + 4) * 8, get64(toff, (qi + 1) * 8));
                                            put64(st_plen, (nst * 7 + 4) * 8, get64(tlen, (qi + 1) * 8));
                                            qi = qi + 2;
                                        } else {
                                            if (tok_eq(raw, qo, ql, "VIB") == 1 && qi + 2 < nt) {
                                                put64(st_poff, (nst * 7 + 5) * 8, get64(toff, (qi + 1) * 8));
                                                put64(st_plen, (nst * 7 + 5) * 8, get64(tlen, (qi + 1) * 8));
                                                put64(st_poff, (nst * 7 + 6) * 8, get64(toff, (qi + 2) * 8));
                                                put64(st_plen, (nst * 7 + 6) * 8, get64(tlen, (qi + 2) * 8));
                                                qi = qi + 3;
                                            } else { qi = qi + 1; }
                                        }
                                    }
                                }
                            }
                        }
                        pi = pi + 1;
                    }
                    nst = nst + 1;
                } else {
                    if (nd < DMAX && nit < ITMAX) {
                        let kind:i64 = -1;
                        let want:i64 = 0;
                        if (tok_eq(raw, t0o, t0l, "SR") == 1) { kind = 5; want = 1; }
                        if (tok_eq(raw, t0o, t0l, "DUR_S") == 1) { kind = 6; want = 1; }
                        if (tok_eq(raw, t0o, t0l, "BED") == 1) { kind = 7; want = 4; }
                        if (tok_eq(raw, t0o, t0l, "INST") == 1) { kind = 0; want = 2; }
                        if (tok_eq(raw, t0o, t0l, "ARC") == 1) { kind = 1; want = 8; }
                        if (tok_eq(raw, t0o, t0l, "TAIL") == 1) { kind = 2; want = 8; }
                        if (tok_eq(raw, t0o, t0l, "EVENT") == 1) { kind = 3; want = 8; }
                        if (tok_eq(raw, t0o, t0l, "RESPOND") == 1) { kind = 4; want = 7; }
                        if (kind >= 0 && nt - 1 >= want) {
                            put64(d_kind, nd * 8, kind);
                            put64(d_ntok, nd * 8, want);
                            let ti:i64 = 0;
                            while (ti < want) {
                                put64(d_tokoff, (nd * 16 + ti) * 8, get64(toff, (ti + 1) * 8));
                                put64(d_toklen, (nd * 16 + ti) * 8, get64(tlen, (ti + 1) * 8));
                                ti = ti + 1;
                            }
                            if (kind == 5) {
                                sr = atoi_tok(raw, get64(toff, 8), get64(tlen, 8));
                                if (sr < 1) { sr = SRMAX; }
                            }
                            if (kind == 0) {
                                // resolve struct id -> index
                                let io:i64 = get64(toff, 8);
                                let il:i64 = get64(tlen, 8);
                                let si:i64 = 0;
                                let found:i64 = -1;
                                while (si < nst) {
                                    if (tok_eq2(raw, io, il, get64(st_idoff, si * 8), get64(st_idlen, si * 8)) == 1) { found = si; }
                                    si = si + 1;
                                }
                                put64(d_struct, nd * 8, found);
                            }
                            put64(it_kind, nit * 8, 1);
                            put64(it_a, nit * 8, nd);
                            nit = nit + 1;
                            nd = nd + 1;
                        }
                    }
                }
                nio_free(toff);
                nio_free(tlen);
            }
        }
        pos = le + 1;
    }
    pout("formation: directives=");
    pout(i64s(nd));
    pout(" structs=");
    pout(i64s(nst));
    pout(" sr=");
    pout(i64s(sr));
    pout("\n");

    // ---- spec table (theme-level; fixed directive order; feeds RESPOND xref) ----
    let sp_kind:[]u8 = nio_alloc((SPMAX * 8) as i32);
    let sp_t0s:[]u8 = nio_alloc((SPMAX * 8) as i32);
    let sp_durs:[]u8 = nio_alloc((SPMAX * 8) as i32);
    let sp_amp:[]u8 = nio_alloc((SPMAX * 8) as i32);
    let sp_foff:[]u8 = nio_alloc((SPMAX * 8) as i32);
    let sp_flen:[]u8 = nio_alloc((SPMAX * 8) as i32);
    let nsp:i64 = 0;
    // d_spbase[di]: spec-table base index for directive di (-1 = deferred RESPOND)
    let d_spbase:[]u8 = nio_alloc((nd * 8) as i32);
    // PASS 1: enumerate ALL non-RESPOND event specs, in directive order.
    // The table is complete and immutable before any RESPOND resolves.
    let di:i64 = 0;
    while (di < nd) {
        let k:i64 = get64(d_kind, di * 8);
        if (k == 0) {
            // INST: expand notes into specs
            put64(d_spbase, di * 8, nsp);
            let si:i64 = get64(d_struct, di * 8);
            if (si >= 0) {
                let nn:i64 = get64(st_nn, si * 8);
                let t0f:f64 = atof(raw, get64(d_tokoff, (di * 16 + 1) * 8), get64(d_tokoff, (di * 16 + 1) * 8) + get64(d_toklen, (di * 16 + 1) * 8));
                let stepf:f64 = atof(raw, get64(st_poff, (si * 7) * 8), get64(st_poff, (si * 7) * 8) + get64(st_plen, (si * 7) * 8));
                let durf:f64 = atof(raw, get64(st_poff, (si * 7 + 1) * 8), get64(st_poff, (si * 7 + 1) * 8) + get64(st_plen, (si * 7 + 1) * 8));
                let amp:i64 = atoi_tok(raw, get64(st_poff, (si * 7 + 2) * 8), get64(st_plen, (si * 7 + 2) * 8));
                let kk:i64 = 0;
                while (kk < nn && nsp < SPMAX) {
                    put64(sp_kind, nsp * 8, 0);
                    put64(sp_t0s, nsp * 8, ((t0f + (kk as f64) * stepf) * (sr as f64)) as i64);
                    put64(sp_durs, nsp * 8, (durf * (sr as f64)) as i64);
                    put64(sp_amp, nsp * 8, amp);
                    put64(sp_foff, nsp * 8, get64(st_noff, (si * 16 + kk) * 8));
                    put64(sp_flen, nsp * 8, get64(st_nlen, (si * 16 + kk) * 8));
                    nsp = nsp + 1;
                    kk = kk + 1;
                }
            }
        } else {
            if (k == 1 || k == 2 || k == 3) {
                // ARC/TAIL/EVENT: single spec
                put64(d_spbase, di * 8, nsp);
                if (nsp < SPMAX) {
                    put64(sp_kind, nsp * 8, 0);
                    let t0o2:i64 = get64(d_tokoff, (di * 16) * 8);
                    let t0l2:i64 = get64(d_toklen, (di * 16) * 8);
                    let duo:i64 = get64(d_tokoff, (di * 16 + 1) * 8);
                    let dul:i64 = get64(d_toklen, (di * 16 + 1) * 8);
                    put64(sp_t0s, nsp * 8, (atof(raw, t0o2, t0o2 + t0l2) * (sr as f64)) as i64);
                    put64(sp_durs, nsp * 8, (atof(raw, duo, duo + dul) * (sr as f64)) as i64);
                    put64(sp_amp, nsp * 8, atoi_tok(raw, get64(d_tokoff, (di * 16 + 3) * 8), get64(d_toklen, (di * 16 + 3) * 8)));
                    put64(sp_foff, nsp * 8, get64(d_tokoff, (di * 16 + 2) * 8));
                    put64(sp_flen, nsp * 8, get64(d_toklen, (di * 16 + 2) * 8));
                    nsp = nsp + 1;
                }
            } else {
                // k == 4 (RESPOND): deferred to pass 2 (order-free xref)
                put64(d_spbase, di * 8, -1);
            }
        }
        di = di + 1;
    }

    // PASS 2: every RESPOND resolves against the COMPLETE immutable spec table.
    // Theme text order cannot affect resolution: the table holds all non-RESPOND
    // specs regardless of where the RESPOND directive appears.
    let nsp_full:i64 = nsp;
    di = 0;
    while (di < nd) {
        let k2:i64 = get64(d_kind, di * 8);
        if (k2 == 4) {
                // RESPOND t0 dur w0 w1 amp timbre nominal: resolve pitch
                let w0o:i64 = get64(d_tokoff, (di * 16 + 2) * 8);
                let w0l:i64 = get64(d_toklen, (di * 16 + 2) * 8);
                let w1o:i64 = get64(d_tokoff, (di * 16 + 3) * 8);
                let w1l:i64 = get64(d_toklen, (di * 16 + 3) * 8);
                let w0s:i64 = (atof(raw, w0o, w0o + w0l) * (sr as f64)) as i64;
                let w1s:i64 = (atof(raw, w1o, w1o + w1l) * (sr as f64)) as i64;
                let best:i64 = -1;
                let best_amp:i64 = -1;
                let best_t0:i64 = 0;
                if (xref == 1) {
                    let q:i64 = 0;
                    while (q < nsp_full) {
                        let qt:i64 = get64(sp_t0s, q * 8);
                        let qd:i64 = get64(sp_durs, q * 8);
                        if (qt < w1s && qt + qd > w0s) {
                            let qa:i64 = get64(sp_amp, q * 8);
                            if (qa > best_amp || (qa == best_amp && qt < best_t0)) {
                                best = q;
                                best_amp = qa;
                                best_t0 = qt;
                            }
                        }
                        q = q + 1;
                    }
                }
                let fo:i64 = get64(d_tokoff, (di * 16 + 6) * 8);
                let fl:i64 = get64(d_toklen, (di * 16 + 6) * 8);
                if (best >= 0) {
                    fo = get64(sp_foff, best * 8);
                    fl = get64(sp_flen, best * 8);
                    pout("xref: RESPOND resolved to window pitch (spec ");
                    pout(i64s(best));
                    pout(")\n");
                } else {
                    pout("xref: RESPOND window empty/nominal kept\n");
                }
                if (nsp < SPMAX) {
                    put64(d_spbase, di * 8, nsp);
                    put64(sp_kind, nsp * 8, 1);
                    let t0o3:i64 = get64(d_tokoff, (di * 16) * 8);
                    let t0l3:i64 = get64(d_toklen, (di * 16) * 8);
                    let duo2:i64 = get64(d_tokoff, (di * 16 + 1) * 8);
                    let dul2:i64 = get64(d_toklen, (di * 16 + 1) * 8);
                    put64(sp_t0s, nsp * 8, (atof(raw, t0o3, t0o3 + t0l3) * (sr as f64)) as i64);
                    put64(sp_durs, nsp * 8, (atof(raw, duo2, duo2 + dul2) * (sr as f64)) as i64);
                    put64(sp_amp, nsp * 8, atoi_tok(raw, get64(d_tokoff, (di * 16 + 4) * 8), get64(d_toklen, (di * 16 + 4) * 8)));
                    put64(sp_foff, nsp * 8, fo);
                    put64(sp_flen, nsp * 8, fl);
                    nsp = nsp + 1;
                } else {
                    put64(d_spbase, di * 8, -1);
                }
            }
        di = di + 1;
    }

    // ---- slot assignment (structure only: counts, no event contents) ----
    let sl_d:[]u8 = nio_alloc((SLMAX * 8) as i32);
    let sl_k:[]u8 = nio_alloc((SLMAX * 8) as i32);
    let sl_sp:[]u8 = nio_alloc((SLMAX * 8) as i32); // spec index for RESPOND slots
    let nsl:i64 = 0;
    di = 0;
    while (di < nd) {
        let k:i64 = get64(d_kind, di * 8);
        if (k == 0) {
            let si:i64 = get64(d_struct, di * 8);
            let nn:i64 = 0;
            if (si >= 0) { nn = get64(st_nn, si * 8); }
            let kk:i64 = 0;
            while (kk < nn && nsl < SLMAX) {
                put64(sl_d, nsl * 8, di);
                put64(sl_k, nsl * 8, kk);
                put64(sl_sp, nsl * 8, -1);
                nsl = nsl + 1;
                kk = kk + 1;
            }
        } else {
            if (k == 1 || k == 2 || k == 3) {
                if (nsl < SLMAX) {
                    put64(sl_d, nsl * 8, di);
                    put64(sl_k, nsl * 8, 0);
                    put64(sl_sp, nsl * 8, -1);
                    nsl = nsl + 1;
                }
            } else {
                if (k == 4) {
                    let rsp0:i64 = get64(d_spbase, di * 8);
                    if (rsp0 >= 0 && nsl < SLMAX) {
                        put64(sl_d, nsl * 8, di);
                        put64(sl_k, nsl * 8, 0);
                        put64(sl_sp, nsl * 8, rsp0);
                        nsl = nsl + 1;
                    }
                }
            }
        }
        di = di + 1;
    }
    pout("slots=");
    pout(i64s(nsl));
    pout("\n");

    // ---- PARALLEL slot computation: each slot = F(theme, slot) ----
    let slotbuf:[]u8 = nio_alloc((SLMAX * 256) as i32);
    let slotlen:[]u8 = nio_alloc((SLMAX * 8) as i32);
    let visited:[]u8 = nio_alloc((SLMAX * 8) as i32);
    let vi:i64 = 0;
    while (vi < nsl) {
        let s:i64 = vi;
        if (order == 1) { s = nsl - 1 - vi; }
        if (order == 2) { s = (vi * 7919) % nsl; }
        let dd:i64 = get64(sl_d, s * 8);
        let kk2:i64 = get64(sl_k, s * 8);
        let dk:i64 = get64(d_kind, dd * 8);
        let at:i64 = s * 256;
        let st:i64 = at;
        at = ob_puts(slotbuf, at, "EVENT ");
        if (dk == 0) {
            // INST note kk2
            let si:i64 = get64(d_struct, dd * 8);
            let t0h:i64 = hund(raw, get64(d_tokoff, (dd * 16 + 1) * 8), get64(d_toklen, (dd * 16 + 1) * 8));
            let steph:i64 = hund(raw, get64(st_poff, (si * 7) * 8), get64(st_plen, (si * 7) * 8));
            at = ob_hund(slotbuf, at, t0h + kk2 * steph);
            at = ob_putc(slotbuf, at, 32);
            at = ob_tok(slotbuf, at, raw, get64(st_poff, (si * 7 + 1) * 8), get64(st_plen, (si * 7 + 1) * 8));
            at = ob_putc(slotbuf, at, 32);
            at = ob_tok(slotbuf, at, raw, get64(st_noff, (si * 16 + kk2) * 8), get64(st_nlen, (si * 16 + kk2) * 8));
            let pp:i64 = 2;
            while (pp < 7) {
                at = ob_putc(slotbuf, at, 32);
                at = ob_tok(slotbuf, at, raw, get64(st_poff, (si * 7 + pp) * 8), get64(st_plen, (si * 7 + pp) * 8));
                pp = pp + 1;
            }
            at = ob_putc(slotbuf, at, 10);
        } else {
            if (dk == 4) {
                // RESPOND -> resolved EVENT
                let rsp:i64 = get64(sl_sp, s * 8);
                at = ob_tok(slotbuf, at, raw, get64(d_tokoff, (dd * 16) * 8), get64(d_toklen, (dd * 16) * 8));
                at = ob_putc(slotbuf, at, 32);
                at = ob_tok(slotbuf, at, raw, get64(d_tokoff, (dd * 16 + 1) * 8), get64(d_toklen, (dd * 16 + 1) * 8));
                at = ob_putc(slotbuf, at, 32);
                at = ob_tok(slotbuf, at, raw, get64(sp_foff, rsp * 8), get64(sp_flen, rsp * 8));
                at = ob_putc(slotbuf, at, 32);
                at = ob_tok(slotbuf, at, raw, get64(d_tokoff, (dd * 16 + 4) * 8), get64(d_toklen, (dd * 16 + 4) * 8));
                at = ob_putc(slotbuf, at, 32);
                at = ob_tok(slotbuf, at, raw, get64(d_tokoff, (dd * 16 + 5) * 8), get64(d_toklen, (dd * 16 + 5) * 8));
                at = ob_puts(slotbuf, at, " 0.0 0 0\n");
            } else {
                // ARC/TAIL/EVENT: re-emit tokens
                let ti2:i64 = 0;
                while (ti2 < 8) {
                    if (ti2 > 0) { at = ob_putc(slotbuf, at, 32); }
                    at = ob_tok(slotbuf, at, raw, get64(d_tokoff, (dd * 16 + ti2) * 8), get64(d_toklen, (dd * 16 + ti2) * 8));
                    ti2 = ti2 + 1;
                }
                at = ob_putc(slotbuf, at, 10);
            }
        }
        put64(slotlen, s * 8, at - st);
        put64(visited, s * 8, get64(visited, s * 8) + 1);
        vi = vi + 1;
    }
    // order-coverage proof: every slot computed exactly once
    let cov:i64 = 1;
    vi = 0;
    while (vi < nsl) {
        if (get64(visited, vi * 8) != 1) { cov = 0; }
        vi = vi + 1;
    }
    if (cov == 1) {
        pout("order coverage: every slot computed exactly once\n");
    } else {
        pout("ORDER COVERAGE FAILURE\n");
        return 9;
    }

    // ---- emission (always slot order) ----
    let out:[]u8 = nio_alloc(1048576);
    let oat:i64 = 0;
    let ii:i64 = 0;
    let emit_slot:i64 = 0; // walks slots in order across directives
    while (ii < nit) {
        let ik:i64 = get64(it_kind, ii * 8);
        if (ik == 0) {
            let co:i64 = get64(it_a, ii * 8);
            let cl:i64 = get64(it_b, ii * 8);
            oat = ob_tok(out, oat, raw, co, cl);
            oat = ob_putc(out, oat, 10);
        } else {
            let dd2:i64 = get64(it_a, ii * 8);
            let dk2:i64 = get64(d_kind, dd2 * 8);
            if (dk2 == 5) {
                oat = ob_puts(out, oat, "SR ");
                oat = ob_tok(out, oat, raw, get64(d_tokoff, (dd2 * 16) * 8), get64(d_toklen, (dd2 * 16) * 8));
                oat = ob_putc(out, oat, 10);
            } else {
                if (dk2 == 6) {
                    oat = ob_puts(out, oat, "DUR_S ");
                    oat = ob_tok(out, oat, raw, get64(d_tokoff, (dd2 * 16) * 8), get64(d_toklen, (dd2 * 16) * 8));
                    oat = ob_putc(out, oat, 10);
                } else {
                    if (dk2 == 7) {
                        oat = ob_puts(out, oat, "BED ");
                        let bi:i64 = 0;
                        while (bi < 4) {
                            if (bi > 0) { oat = ob_putc(out, oat, 32); }
                            oat = ob_tok(out, oat, raw, get64(d_tokoff, (dd2 * 16 + bi) * 8), get64(d_toklen, (dd2 * 16 + bi) * 8));
                            bi = bi + 1;
                        }
                        oat = ob_putc(out, oat, 10);
                    } else {
                        // event directive: emit its slots in order
                        let cnt:i64 = 1;
                        if (dk2 == 0) {
                            let si2:i64 = get64(d_struct, dd2 * 8);
                            if (si2 >= 0) { cnt = get64(st_nn, si2 * 8); }
                        }
                        let ci:i64 = 0;
                        while (ci < cnt) {
                            let s2:i64 = emit_slot + ci;
                            let so:i64 = s2 * 256;
                            let sl2:i64 = get64(slotlen, s2 * 8);
                            let q2:i64 = 0;
                            while (q2 < sl2) { out[oat + q2] = slotbuf[so + q2]; q2 = q2 + 1; }
                            oat = oat + sl2;
                            ci = ci + 1;
                        }
                        emit_slot = emit_slot + cnt;
                    }
                }
            }
        }
        ii = ii + 1;
    }

    let ob:[]u8 = out[0..oat];
    let rc:i64 = file_write(outp, ob);
    pout("formation wrote ");
    pout(outp);
    pout(" bytes=");
    pout(i64s(oat));
    pout(" rc=");
    pout(i64s(rc));
    pout("\n");
    return 0;
}

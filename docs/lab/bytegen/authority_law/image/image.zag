// ============================================================================
// IMAGE instantiation of the authority law (native Zag, deterministic).
//
// Spec: teams/image/AUTHORITY_RECOMMENDATION.md, PATH_MECHANICS.md,
//       FAULT_ANALYSIS.md; ~/workspace/tnn-lab/bytegen/authority_question/.
//
// IMAGE-SPECIFIC THREE-PIECE INSTANTIATION (piece 3 audited empty):
//   Piece 1 (always): plan-pure render. All three native paths as pure
//     functions of the plan: Path C analog px=F(seed,x,y) (disc.zag);
//     Path A analog: recorded stroke log -> eager application -> raster
//     (field.zag); Path B analog: ordered layer program over a carried
//     canvas with blend compositing (design toolkit.zag).
//     Sole authority over: stroke/layer existence, order, geometry, color,
//     alpha, seeds, dither, grain.
//   Piece 2 (idle; fires only on fault): exception detect-and-reassert,
//     region = 128x128 tile. Detection = re-render the region to scratch
//     and bit-exact diff (no detection floor — strictly stronger than
//     audio's band predicate). Correction = overwrite with the plan-pure
//     re-render: FULL layer/stroke replay from the plan for ordered paths
//     (d_blend operands stay plan-determined); never forward-correct from
//     corrupted state, never neighbor-match (audio Attack 6, FAULT F1/F2).
//     Correction map constant in the corruption: Lipschitz-0, idempotent,
//     one-step. False positive = no-op.
//   Piece 3: slot AUDITED EMPTY (not assumed). Audio's latch exists for a
//     discrete measured-plan-fact (RESPOND octave); image has no
//     external-stimulus analog — the plan (strokes, seed, theme) is fully
//     authored before rendering begins. Filling it requires a frozen
//     prereg amendment with a demonstrated discrete measured-plan-fact,
//     signed by Micah.
//
// d_blend / f3_blend CLASSIFICATION (frozen five-point settlement,
// PATH_MECHANICS.md — the pixel read-back is a PIECE-1 RENDERING OPERATOR,
// conferring no authority and setting no precedent):
//   1. No semantic input. The bytegen AR criterion requires output bytes
//      read as SEMANTIC input — used to decide later content. img_blend
//      reads the old pixel only as an arithmetic operand of a fixed
//      formula. It never selects which op runs next, never changes a
//      color, alpha, coordinate, or layer order, never gates anything.
//   2. No measurement, no threshold. The value participates in no
//      predicate. There is no detection, no comparison, no band. Nothing
//      is "noticed" about the rendered pixels; alpha is a plan argument.
//   3. No carried variable updated from output. A servo gain updated from
//      measured output creates cycles and rail pins; img_blend has no
//      update step — no variable the read-back feeds. Pointwise, clamped
//      to [0,255], no memory across pixels beyond compositing semantics.
//   4. The data-flow / control-flow crux. Authority is about CONTROL FLOW
//      over measured output: measured bytes choosing content. img_blend
//      is DATA FLOW: the old pixel flows into an arithmetic expression
//      whose operator and parameters are plan-fixed. Data flow with a
//      plan-fixed operator is rendering; control flow over measured
//      output is feedback authority. img_blend is entirely the former.
//   5. Corroboration: no branch on rendered pixels. Nothing in this
//      renderer branches on a pixel value read from the image buffer
//      (the native d_get accessor is dead code in the design path). There
//      is no latent feedback controller waiting to be "extended."
//
// T1: fault detectable against plan-derived expectation — the region
//     re-render IS the plan-derived expectation (recomputed every run,
//     never a frozen literal); detection is bit-exact.
// T2: correction C(plan, region) = plan-pure region replay — constant in
//     the corruption (Lipschitz-0, idempotent, one-step); false positives
//     are no-ops.
// T3: pixels are non-propositional; measuring them installs nothing.
//
// (D) vs (G): detection READS region bytes as evidence (D, allowed). No
// rendered byte ever CONDITIONS a later pixel, stroke parameter, layer
// order, or gain (G banned everywhere).
//
// Production emitters (f3_emit_wav, f3_emit_wav_hifi, f3_emit_avi,
// f3_emit_avi_g) are NOT touched here: they are "grandfathered post-pass
// mastering, flagged for plan-derivation review — they are not generation
// authority and not precedent" (image team's frozen wording). A separate
// gamma-disease repair crew owns them. Zero duplication.
//
// Determinism: zero RNG. Fault injection is a deterministic function of
// the fault index. Byte-identical reruns.
// ============================================================================
@import("../gate/gate.zag")
@import("../R33_NATIVE_SHA256_V2.zag")

fn IW()i32 {return 192;}
fn IH()i32 {return 192;}
fn ICH()i32 {return 3;}
fn INB()i32 {return 110592;}   // 192*192*3
fn IRX()i32 {return 32;}       // region: 128x128 tile at (32,32)
fn IRY()i32 {return 32;}
fn IRW()i32 {return 128;}
fn IRH()i32 {return 128;}
fn IRB()i32 {return 49152;}    // 128*128*3

// --- plan: 4 i32 fields in a 16-byte arena (little-endian) ---
// 0 seed | 1 nstrokes | 2 nlayers | 3 spare ; stroke log follows separately
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn iplan_new()[]u8 {
    let p:[]u8=nio_alloc(16);
    p32(p,0,4242);p32(p,4,4);p32(p,8,3);p32(p,12,0);
    return p;
}

// --- stroke log: the plan for Path A (mirrors f3_stroke: op + 8 params) ---
// 16 slots x 9 i32 = 36 bytes each, 576-byte arena, little-endian.
fn slog_put(s:[]u8,n:i32,op:i64,a0:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64,a7:i64)void {
    let b:i32=n*36;
    p32(s,b,op);p32(s,b+4,a0);p32(s,b+8,a1);p32(s,b+12,a2);p32(s,b+16,a3);
    p32(s,b+20,a4);p32(s,b+24,a5);p32(s,b+28,a6);p32(s,b+32,a7);
    return;
}
fn slog_new()[]u8 {
    let s:[]u8=nio_alloc(576);
    // stroke 0: FILL_RECT(20,20,80,60, r200 g120 b60)
    slog_put(s,0,1,20,20,80,60,200,120,60,0);
    // stroke 1: BLOTCH_BLEND(cx100 cy100 rad26, r40 g160 b220, alpha128)
    slog_put(s,1,2,100,100,26,40,160,220,128,0);
    // stroke 2: FILL_RECT(120,40,60,100, r30 g200 b90)
    slog_put(s,2,1,120,40,60,100,30,200,90,0);
    // stroke 3: DITHER_ADD over full canvas, amp 3
    slog_put(s,3,3,0,0,192,192,3,0,0,0);
    return s;
}

// --- deterministic hash (no RNG) ---
fn ihash(x:i64,y:i64,s:i64)i64 {
    let z:i64=x*374761393+y*668265263+s*2246822519;
    z=z&9223372036854775807;
    z=z^(z>>13);z=z&9223372036854775807;
    z=z*1274126177;z=z&9223372036854775807;
    z=z^(z>>16);z=z&9223372036854775807;
    return z%256;
}

// --- Path C analog: background field, px = F(seed,x,y), zero carried state ---
fn ibg(seed:i64,x:i32,y:i32,c:i32)i64 {
    let v:i64=ihash(x as i64,y as i64,seed+(c as i64)*131);
    let w:i64=ihash((y as i64)*3,(x as i64)*5,seed+77);
    let m:i64=(v*3+w)/4;
    return m;
}

// --- img_blend: the d_blend analog. PIECE-1 RENDERING OPERATOR (see the
// five-point classification in the header). Data flow with a plan-fixed
// operator: old pixel is an arithmetic operand only. ---
fn img_blend(old:i64,new:i64,a:i64)i64 {
    let v:i64=(old*(256-a)+new*a)/256;
    if(v<0){v=0;}
    if(v>255){v=255;}
    return v;
}

// clip helper: intersect [a0,a1) with [c0,c1)
fn iclip0(a0:i32,a1:i32,c0:i32,c1:i32)i32 {
    if(a0<c0){a0=c0;}
    if(a1>c1){a1=c1;}
    if(a0>a1){a0=a1;}
    return a0;
}
fn iclip1(a0:i32,a1:i32,c0:i32,c1:i32)i32 {
    if(a0<c0){a0=c0;}
    if(a1>c1){a1=c1;}
    if(a0<a1){return a1;}
    return a0;
}

// apply one stroke into buf, clipped to (cx0,cy0,cx1,cy1)
fn istroke(buf:[]u8,s:[]u8,n:i32,cx0:i32,cy0:i32,cx1:i32,cy1:i32)void {
    let b:i32=n*36;
    let op:i64=g32(s,b);
    if(op==1){
        // FILL_RECT(x,y,w,h,r,g,b)
        let x0:i32=iclip0(g32(s,b+4) as i32,(g32(s,b+4)+g32(s,b+12)) as i32,cx0,cx1);
        let x1:i32=iclip1(g32(s,b+4) as i32,(g32(s,b+4)+g32(s,b+12)) as i32,cx0,cx1);
        let y0:i32=iclip0(g32(s,b+8) as i32,(g32(s,b+8)+g32(s,b+16)) as i32,cy0,cy1);
        let y1:i32=iclip1(g32(s,b+8) as i32,(g32(s,b+8)+g32(s,b+16)) as i32,cy0,cy1);
        let y:i32=y0;
        while(y<y1){
            let x:i32=x0;
            while(x<x1){
                buf[(y*IW()+x)*ICH()]=g32(s,b+20) as u8;
                buf[(y*IW()+x)*ICH()+1]=g32(s,b+24) as u8;
                buf[(y*IW()+x)*ICH()+2]=g32(s,b+28) as u8;
                x=x+1;
            }
            y=y+1;
        }
        return;
    }
    if(op==2){
        // BLOTCH_BLEND(cx,cy,rad,r,g,b,alpha)
        let ccx:i64=g32(s,b+4);
        let ccy:i64=g32(s,b+8);
        let rad:i64=g32(s,b+12);
        let nr:i64=g32(s,b+20);
        let ng:i64=g32(s,b+24);
        let nb:i64=g32(s,b+28);
        let al:i64=g32(s,b+32);
        let x0:i32=iclip0((ccx-rad) as i32,(ccx+rad) as i32,cx0,cx1);
        let x1:i32=iclip1((ccx-rad) as i32,(ccx+rad) as i32,cx0,cx1);
        let y0:i32=iclip0((ccy-rad) as i32,(ccy+rad) as i32,cy0,cy1);
        let y1:i32=iclip1((ccy-rad) as i32,(ccy+rad) as i32,cy0,cy1);
        let y:i32=y0;
        while(y<y1){
            let x:i32=x0;
            while(x<x1){
                let dx:i64=(x as i64)-ccx;
                let dy:i64=(y as i64)-ccy;
                if(dx*dx+dy*dy<=rad*rad){
                    let at:i32=(y*IW()+x)*ICH();
                    buf[at]=img_blend(buf[at] as i64,nr,al) as u8;
                    buf[at+1]=img_blend(buf[at+1] as i64,ng,al) as u8;
                    buf[at+2]=img_blend(buf[at+2] as i64,nb,al) as u8;
                }
                x=x+1;
            }
            y=y+1;
        }
        return;
    }
    if(op==3){
        // DITHER_ADD(x,y,w,h,amp): deterministic hash dither, plan-pure
        let amp:i64=g32(s,b+20);
        let x0:i32=iclip0(g32(s,b+4) as i32,(g32(s,b+4)+g32(s,b+12)) as i32,cx0,cx1);
        let x1:i32=iclip1(g32(s,b+4) as i32,(g32(s,b+4)+g32(s,b+12)) as i32,cx0,cx1);
        let y0:i32=iclip0(g32(s,b+8) as i32,(g32(s,b+8)+g32(s,b+16)) as i32,cy0,cy1);
        let y1:i32=iclip1(g32(s,b+8) as i32,(g32(s,b+8)+g32(s,b+16)) as i32,cy0,cy1);
        let y:i32=y0;
        while(y<y1){
            let x:i32=x0;
            while(x<x1){
                let c:i32=0;
                while(c<ICH()){
                    let at:i32=(y*IW()+x)*ICH()+c;
                    let d:i64=ihash(x as i64,y as i64,(c as i64)*31)%(amp*2+1)-amp;
                    let v:i64=(buf[at] as i64)+d;
                    if(v<0){v=0;}
                    if(v>255){v=255;}
                    buf[at]=v as u8;
                    c=c+1;
                }
                x=x+1;
            }
            y=y+1;
        }
        return;
    }
    return;
}

// --- Path B analog: fixed ordered layer program (the plan for Path B is
// the program itself). All params plan-fixed; img_blend is data flow. ---
fn ilayer(buf:[]u8,ln:i32,cx0:i32,cy0:i32,cx1:i32,cy1:i32)void {
    if(ln==0){
        // full-canvas tint toward (10,10,40), alpha 32
        let y:i32=cy0;
        while(y<cy1){
            let x:i32=cx0;
            while(x<cx1){
                let at:i32=(y*IW()+x)*ICH();
                buf[at]=img_blend(buf[at] as i64,10,32) as u8;
                buf[at+1]=img_blend(buf[at+1] as i64,10,32) as u8;
                buf[at+2]=img_blend(buf[at+2] as i64,40,32) as u8;
                x=x+1;
            }
            y=y+1;
        }
        return;
    }
    if(ln==1){
        // border rect blend, alpha 200
        let y:i32=cy0;
        while(y<cy1){
            let x:i32=cx0;
            while(x<cx1){
                if(x<8 || y<8 || x>=IW()-8 || y>=IH()-8){
                    let at:i32=(y*IW()+x)*ICH();
                    buf[at]=img_blend(buf[at] as i64,220,200) as u8;
                    buf[at+1]=img_blend(buf[at+1] as i64,180,200) as u8;
                    buf[at+2]=img_blend(buf[at+2] as i64,120,200) as u8;
                }
                x=x+1;
            }
            y=y+1;
        }
        return;
    }
    // ln==2: diagonal band blend, alpha 96
    let y:i32=cy0;
    while(y<cy1){
        let x:i32=cx0;
        while(x<cx1){
            let dd:i64=(x as i64)-(y as i64);
            if(dd<0){dd=-dd;}
            if(dd<12){
                let at:i32=(y*IW()+x)*ICH();
                buf[at]=img_blend(buf[at] as i64,90,96) as u8;
                buf[at+1]=img_blend(buf[at+1] as i64,200,96) as u8;
                buf[at+2]=img_blend(buf[at+2] as i64,230,96) as u8;
            }
            x=x+1;
        }
        y=y+1;
    }
    return;
}

// --- full plan-pure render into buf (all three paths, in order) ---
fn irender_full(plan:[]u8,slog:[]u8,buf:[]u8)void {
    let seed:i64=g32(plan,0);
    let y:i32=0;
    while(y<IH()){
        let x:i32=0;
        while(x<IW()){
            let at:i32=(y*IW()+x)*ICH();
            buf[at]=ibg(seed,x,y,0) as u8;
            buf[at+1]=ibg(seed,x,y,1) as u8;
            buf[at+2]=ibg(seed,x,y,2) as u8;
            x=x+1;
        }
        y=y+1;
    }
    let ns:i32=g32(plan,4) as i32;
    let n:i32=0;
    while(n<ns){istroke(buf,slog,n,0,0,IW(),IH());n=n+1;}
    let nl:i32=g32(plan,8) as i32;
    let l:i32=0;
    while(l<nl){ilayer(buf,l,0,0,IW(),IH());l=l+1;}
    return;
}

// Region replay via a full-size clean scratch (single code path —
// region render and full render cannot diverge).
fn iregion_rerender(plan:[]u8,slog:[]u8,rx:i32,ry:i32,rw:i32,rh:i32,scratch:[]u8,rout:[]u8)void {
    irender_full(plan,slog,scratch);
    let y:i32=0;
    while(y<rh){
        let x:i32=0;
        while(x<rw){
            let c:i32=0;
            while(c<ICH()){
                rout[(y*rw+x)*ICH()+c]=scratch[((ry+y)*IW()+(rx+x))*ICH()+c];
                c=c+1;
            }
            x=x+1;
        }
        y=y+1;
    }
    return;
}

// --- Piece 2: stateless exception detect-and-reassert ---
// i_detect: 1 = region fault (bit-exact diff vs plan-pure re-render),
// 0 = clean. Reads bytes as evidence (D); never steers content.
fn i_detect(plan:[]u8,slog:[]u8,img:[]u8,rx:i32,ry:i32,rw:i32,rh:i32,scratch:[]u8,rout:[]u8)i32 {
    iregion_rerender(plan,slog,rx,ry,rw,rh,scratch,rout);
    let y:i32=0;
    while(y<rh){
        let x:i32=0;
        while(x<rw){
            let c:i32=0;
            while(c<ICH()){
                if(rout[(y*rw+x)*ICH()+c]!=img[((ry+y)*IW()+(rx+x))*ICH()+c]){return 1;}
                c=c+1;
            }
            x=x+1;
        }
        y=y+1;
    }
    return 0;
}

// i_correct: the T2 correction map. Overwrites the region with the
// plan-pure re-render. It NEVER reads the corrupted bytes to compute a
// value — constancy in the measured output is structural (signature
// takes plan+region, not measured bytes) and proven by the harness.
fn i_correct(plan:[]u8,slog:[]u8,img:[]u8,rx:i32,ry:i32,rw:i32,rh:i32,scratch:[]u8,rout:[]u8)void {
    iregion_rerender(plan,slog,rx,ry,rw,rh,scratch,rout);
    let y:i32=0;
    while(y<rh){
        let x:i32=0;
        while(x<rw){
            let c:i32=0;
            while(c<ICH()){
                img[((ry+y)*IW()+(rx+x))*ICH()+c]=rout[(y*rw+x)*ICH()+c];
                c=c+1;
            }
            x=x+1;
        }
        y=y+1;
    }
    return;
}

// --- deterministic fault injection (test scaffolding, no RNG) ---
// k=0 F1 bit-rot (top-bit flips in region) | k=1 F1 torn tile (shifted
// write) | k=2 F1 zeroed tile | k=3 F2 mid-render cell corruption |
// k=4 F1b sparse bit-flips | k=5 F1c half-region zero
fn i_corrupt_f1(img:[]u8,k:i32)void {
    let rx:i32=IRX();
    let ry:i32=IRY();
    let rw:i32=IRW();
    let rh:i32=IRH();
    if(k==0){
        let y:i32=0;
        while(y<rh){
            let x:i32=0;
            while(x<rw){
                if((x+y)%3==0){
                    let at:i32=((ry+y)*IW()+(rx+x))*ICH();
                    img[at]=img[at]^128;
                }
                x=x+1;
            }
            y=y+1;
        }
        return;
    }
    if(k==1){
        // torn tile: shifted write — copy the region shifted +7px right
        // (clipped), modeling a torn/offset write
        let tmp:[]u8=nio_alloc(IRB());
        let y:i32=0;
        while(y<rh){
            let x:i32=0;
            while(x<rw){
                let c:i32=0;
                while(c<ICH()){
                    tmp[(y*rw+x)*ICH()+c]=img[((ry+y)*IW()+(rx+x))*ICH()+c];
                    c=c+1;
                }
                x=x+1;
            }
            y=y+1;
        }
        let y2:i32=0;
        while(y2<rh){
            let x2:i32=0;
            while(x2<rw){
                let sx:i32=x2+7;
                if(sx>=rw){sx=rw-1;}
                let c:i32=0;
                while(c<ICH()){
                    img[((ry+y2)*IW()+(rx+x2))*ICH()+c]=tmp[(y2*rw+sx)*ICH()+c];
                    c=c+1;
                }
                x2=x2+1;
            }
            y2=y2+1;
        }
        nio_free(tmp);
        return;
    }
    if(k==2){
        let y:i32=0;
        while(y<rh){
            let x:i32=0;
            while(x<rw){
                let c:i32=0;
                while(c<ICH()){img[((ry+y)*IW()+(rx+x))*ICH()+c]=0;c=c+1;}
                x=x+1;
            }
            y=y+1;
        }
        return;
    }
    if(k==4){
        let i:i32=0;
        while(i<40){
            let at:i32=((ry+((i*37)%rh))*IW()+(rx+((i*91)%rw)))*ICH()+(i%3);
            img[at]=img[at]^1;
            i=i+1;
        }
        return;
    }
    // k=5: half-region zero
    let y:i32=0;
    while(y<rh/2){
        let x:i32=0;
        while(x<rw){
            let c:i32=0;
            while(c<ICH()){img[((ry+y)*IW()+(rx+x))*ICH()+c]=0;c=c+1;}
            x=x+1;
        }
        y=y+1;
    }
    return;
}

// F2: carried-state corruption mid-render — damage the working arena after
// stroke 1, then continue rendering. The ONLY lawful healing is replay
// from the plan (stroke log) into a fresh arena; forward correction from
// the corrupted cells is refused by construction (i_correct never reads
// the corrupted buffer for values).
fn irender_f2(plan:[]u8,slog:[]u8,buf:[]u8)void {
    let seed:i64=g32(plan,0);
    let y:i32=0;
    while(y<IH()){
        let x:i32=0;
        while(x<IW()){
            let at:i32=(y*IW()+x)*ICH();
            buf[at]=ibg(seed,x,y,0) as u8;
            buf[at+1]=ibg(seed,x,y,1) as u8;
            buf[at+2]=ibg(seed,x,y,2) as u8;
            x=x+1;
        }
        y=y+1;
    }
    istroke(buf,slog,0,0,0,IW(),IH());
    istroke(buf,slog,1,0,0,IW(),IH());
    // mid-render cell corruption: a 32x16-cell block damaged, fully inside
    // the (32,32,128,128) exception region (rows 40..55, cols 40..71).
    // Later strokes/layers read these corrupted cells (blotch blending,
    // layer compositing), so the damage propagates through the rest of
    // the render — exactly the F2 model.
    let cr:i32=0;
    while(cr<16){
        let cc:i32=0;
        while(cc<32){
            let at:i32=((40+cr)*IW()+(40+cc))*ICH();
            buf[at]=buf[at]^255;
            buf[at+1]=buf[at+1]^255;
            buf[at+2]=buf[at+2]^255;
            cc=cc+1;
        }
        cr=cr+1;
    }
    istroke(buf,slog,2,0,0,IW(),IH());
    istroke(buf,slog,3,0,0,IW(),IH());
    let l:i32=0;
    while(l<3){ilayer(buf,l,0,0,IW(),IH());l=l+1;}
    return;
}

fn i_sha(buf:[]u8,out:[]u8)void {
    let rc:i32=ns_sha256(buf,out);
    if(rc!=0){_zag_println("sha256 failed");}
    return;
}

// --- driver: T2 harness + F1/F2 battery + reruns + gate registration ---
fn main()i32 {
    let plan:[]u8=iplan_new();
    let slog:[]u8=slog_new();
    let img:[]u8=nio_alloc(INB());       // clean reference image
    let work:[]u8=nio_alloc(INB());      // fault-injected working copy
    let scratch:[]u8=nio_alloc(INB());   // full-size clean scratch
    let rout:[]u8=nio_alloc(IRB());      // region re-render buffer
    let d0:[]u8=nio_alloc(32);
    let d1:[]u8=nio_alloc(32);
    let hx:[]u8=nio_alloc(64);

    _zag_println("image: authority-law instantiation — pieces 1+2, piece 3 audited empty");
    _zag_println("image: rendering clean reference image (plan-pure, 3 paths)...");

    irender_full(plan,slog,img);
    i_sha(img,d0);
    gate_sha_hex(d0,hx);
    _zag_print("image: clean image sha256=");
    _zag_println(hx);

    // --- T2 proof harness: 6 distinct corruptions of the 128x128 region ---
    _zag_println("image: T2 harness — 6 distinct corruptions of the region...");
    let t2checks:i32=0;
    let t2pass:i32=0;
    let k:i32=0;
    while(k<6){
        let c1:i32=0;
        while(c1<INB()){work[c1]=img[c1];c1=c1+1;}
        if(k==3){
            irender_f2(plan,slog,work);   // F2: mid-render cell corruption
        }else{
            i_corrupt_f1(work,k);         // F1-class region faults
        }
        // (a) detector must fire
        t2checks=t2checks+1;
        let fired:i32=i_detect(plan,slog,work,IRX(),IRY(),IRW(),IRH(),scratch,rout);
        if(fired==1){t2pass=t2pass+1;}
        // (b) one-step correction -> 0 differing bytes vs clean
        t2checks=t2checks+1;
        i_correct(plan,slog,work,IRX(),IRY(),IRW(),IRH(),scratch,rout);
        if(nio_equal(work,img)==1){t2pass=t2pass+1;}
        // (c) second application = identical (idempotence / one-step convergence)
        t2checks=t2checks+1;
        i_correct(plan,slog,work,IRX(),IRY(),IRW(),IRH(),scratch,rout);
        if(nio_equal(work,img)==1){t2pass=t2pass+1;}
        k=k+1;
    }
    // (d) detector silent + correction no-op on the clean image
    t2checks=t2checks+1;
    if(i_detect(plan,slog,img,IRX(),IRY(),IRW(),IRH(),scratch,rout)==0){t2pass=t2pass+1;}
    t2checks=t2checks+1;
    let c2:i32=0;
    while(c2<INB()){work[c2]=img[c2];c2=c2+1;}
    i_correct(plan,slog,work,IRX(),IRY(),IRW(),IRH(),scratch,rout);
    if(nio_equal(work,img)==1){t2pass=t2pass+1;}
    _zag_print("image: T2 harness checks passed ");
    _zag_print(_zag_i64_to_str(t2pass as i64));
    _zag_print(" / ");
    _zag_print(_zag_i64_to_str(t2checks as i64));
    _zag_println("");
    let t2cert:i32=0;
    if(t2pass==t2checks){t2cert=1;_zag_println("image: T2 PASS — correction Lipschitz-0, idempotent, one-step, false-positive no-op");}
    if(t2cert==0){_zag_println("image: T2 FAIL");}

    // --- F1/F2 battery: detect -> re-render -> 0 differing bytes ---
    _zag_println("image: F1/F2 battery (detect -> re-render -> 0 differing bytes)...");
    let healed:i32=0;
    let kk:i32=0;
    while(kk<4){
        let c3:i32=0;
        while(c3<INB()){work[c3]=img[c3];c3=c3+1;}
        if(kk==3){
            irender_f2(plan,slog,work);
        }else{
            i_corrupt_f1(work,kk);
        }
        let det:i32=i_detect(plan,slog,work,IRX(),IRY(),IRW(),IRH(),scratch,rout);
        if(det==1){i_correct(plan,slog,work,IRX(),IRY(),IRW(),IRH(),scratch,rout);}
        if(det==1 && nio_equal(work,img)==1){healed=healed+1;}
        kk=kk+1;
    }
    _zag_print("image: faults healed ");
    _zag_print(_zag_i64_to_str(healed as i64));
    _zag_println(" / 4 (0 differing bytes vs clean plan-pure render)");

    // --- 3x byte-identical reruns ---
    _zag_println("image: 3x full-image reruns...");
    let rrok:i32=0;
    let rr:i32=0;
    while(rr<3){
        irender_full(plan,slog,work);
        i_sha(work,d1);
        if(nio_equal(d0,d1)==1){rrok=rrok+1;}
        rr=rr+1;
    }
    _zag_print("image: reruns byte-identical ");
    _zag_print(_zag_i64_to_str(rrok as i64));
    _zag_println(" / 3");
    gate_sha_hex(d0,hx);
    _zag_print("image: final image sha256=");
    _zag_println(hx);

    // --- registration record (the written justification burden) ---
    _zag_println("image: registration record:");
    _zag_println("image:   plan form = (seed, stroke log [op+8 params x16], ordered layer program); every pixel a pure function of the plan");
    _zag_println("image:   exception detector = 128x128 tile unit; predicate = region re-render to scratch + bit-exact diff (no detection floor); correction = overwrite with full layer/stroke replay from the plan (never forward-correct, never neighbor-match)");
    _zag_println("image:   T2 argument = correction signature (plan,region) never receives measured bytes (structural) + harness: 6 distinct corruptions -> identical outputs, idempotent, one-step (empirical)");
    _zag_println("image:   piece-3 latch slot = AUDITED EMPTY — no discrete measured-plan-fact exists in the image line; filling requires a frozen prereg amendment + Micah signature");
    _zag_println("image:   img_blend/f3_blend = Piece-1 rendering operators (five-point classification in header); read-back confers no authority, sets no precedent");
    _zag_println("image:   information gap (justification burden) = the renderer cannot observe post-render buffer damage (F1 bit-rot/torn tiles) or mid-render cell corruption (F2); the plan cannot compute what happened to bytes after emission. Detection reads bytes as evidence (D).");
    _zag_println("image:   (G)-ban restated = no rendered byte may condition any later pixel, stroke parameter, layer order, alpha, or gain; blend read-back is data flow with a plan-fixed operator only");

    let rc:i32=gate_register("image",t2cert,0,0,0,0,1,1,1);
    _zag_print("image: gate_register rc=");
    _zag_print(_zag_i64_to_str(rc as i64));
    _zag_println(" (0 = REGISTERED)");

    // --- negative tests: the gate must REFUSE bad proposals ---
    _zag_println("image: negative tests — gate must refuse bad proposals...");
    let neg:i32=0;
    let r1:i32=gate_register("image-contrast-servo",1,0,0,2,0,1,1,1);
    if(r1==3){neg=neg+1;}
    let r2:i32=gate_register("image-auto-contrast-gain",1,0,1,0,0,1,1,1);
    if(r2==2){neg=neg+1;}
    let r3:i32=gate_register("image-neighbor-inpaint",1,1,0,0,0,1,1,1);
    if(r3==1){neg=neg+1;}
    _zag_print("image: bad proposals refused ");
    _zag_print(_zag_i64_to_str(neg as i64));
    _zag_println(" / 3");

    let ok:i32=0;
    if(rc==0 && t2cert==1 && healed==4 && rrok==3 && neg==3){ok=1;}
    _zag_print("image: OVERALL ");
    if(ok==1){_zag_println("PASS");}else{_zag_println("FAIL");}

    nio_free(plan);nio_free(slog);nio_free(img);nio_free(work);
    nio_free(scratch);nio_free(rout);nio_free(d0);nio_free(d1);nio_free(hx);
    return 0;
}

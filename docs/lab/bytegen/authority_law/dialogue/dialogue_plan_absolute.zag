// dialogue_plan_absolute.zag
// TNN authority law, dialogue path: PLAN ABSOLUTE, no output feedback authority.
// Micah APPROVED option B (2026-09-24). Per-path verdict: dialogue FAILS T3
// categorically (propositional output; re-ingesting it risks constructed->belief
// leakage). The only legitimate output-side mechanism is a deliberation-layer
// veto: checker reads the PLAN as ground truth, the composed text only as the
// artifact under test (defendant, never witness); its only power is
// veto -> plan-pure re-composition. Correction map is constant in the checked
// text (dialogue analog of Lipschitz 0).
//
// Structural enforcement in this file:
//  - No emitted byte ever enters a retrieval key, salience/topic structure,
//    the user-claim store, the KB, or any tie-break/weight/score.
//  - Grandfathered: last_fid integer-id exact-tie preference (plan-side id).
//  - Correction branch excludes the previous answer (plan keeps last word).
//  - KB write-once at install. User-claim store: USER provenance only.
//  - Constructed-mode text never eligible as checker input vs the belief
//    store and never written to any store the checker reads.
//  - poison() enumerates every forbidden port and refuses them all:
//    the composer has no input port for emitted bytes anywhere.
//
// Pure Zag, deterministic, zero RNG. Byte-identical reruns (SHA-256).
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- byte utils ----------------
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24;
}
fn beq(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    if(al!=bl){return 0;}
    let i:i32=0;
    while(i<al){ if(a[ao+i]!=b[bo+i]){return 0;} i=i+1; }
    return 1;
}
fn starts_with(q:[]u8,pre:[]u8)i32 {
    if(q.len<pre.len){return 0;}
    return beq(q,0,pre.len,pre,0,pre.len);
}
fn app(buf:[]u8,pos:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
    return pos+s.len;
}
fn appn(buf:[]u8,pos:i32,s:[]u8,so:i32,sl:i32)i32 {
    let i:i32=0;
    while(i<sl){ buf[pos+i]=s[so+i]; i=i+1; }
    return pos+sl;
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){ return s[0..s.len-1]; }
    return s;
}
fn sha_hex(data:[]u8,dl:i32)[]u8 {
    let d:[]u8=nio_alloc(32);
    let rc:i32=ns_sha256(data[0..dl],d);
    if(rc!=0){ nio_free(d); return "SHAFAIL"; }
    let h:[]u8=ns_hex(d);
    nio_free(d);
    return h;
}

// ---------------- PLAN: KB (write-once) ----------------
// S slots: 0 last_fid, 4 kb_frozen, 8 uc_n, 12 turn
fn kb_frozen(S:[]u8)i32 { return g32(S,4) as i32; }
fn fact_text(fid:i32)[]u8 {
    if(fid==0){ return "the eiffel tower was built in 1889."; }
    if(fid==1){ return "marie curie discovered radium."; }
    if(fid==2){ return "the amazon river is the longest river in the world."; }
    if(fid==3){ return "kyoto is a city in japan."; }
    if(fid==4){ return "the heart pumps blood through the body."; }
    return "glass is made from sand.";
}
fn fk_n(fid:i32)i32 {
    if(fid==0){ return 4; }
    if(fid==1){ return 4; }
    return 3;
}
fn fk(fid:i32,k:i32)i32 {
    if(fid==0){ if(k==0){return 1;} if(k==1){return 2;} if(k==2){return 3;} return 4; }
    if(fid==1){ if(k==0){return 5;} if(k==1){return 6;} if(k==2){return 7;} return 8; }
    if(fid==2){ if(k==0){return 9;} if(k==1){return 10;} return 11; }
    if(fid==3){ if(k==0){return 12;} if(k==1){return 13;} return 14; }
    if(fid==4){ if(k==0){return 15;} if(k==1){return 16;} return 17; }
    if(k==0){return 18;} if(k==1){return 19;} return 20;
}
// kw ids: 1 eiffel 2 tower 3 built 4 1889 5 marie 6 curie 7 discovered 8 radium
// 9 amazon 10 river 11 longest 12 kyoto 13 city 14 japan 15 heart 16 pumps
// 17 blood 18 glass 19 made 20 sand
fn kw_id(w:[]u8,wo:i32,wl:i32)i32 {
    if(beq(w,wo,wl,"eiffel",0,6)==1){return 1;}
    if(beq(w,wo,wl,"tower",0,5)==1){return 2;}
    if(beq(w,wo,wl,"built",0,5)==1){return 3;}
    if(beq(w,wo,wl,"1889",0,4)==1){return 4;}
    if(beq(w,wo,wl,"marie",0,5)==1){return 5;}
    if(beq(w,wo,wl,"curie",0,5)==1){return 6;}
    if(beq(w,wo,wl,"discovered",0,10)==1){return 7;}
    if(beq(w,wo,wl,"radium",0,6)==1){return 8;}
    if(beq(w,wo,wl,"amazon",0,6)==1){return 9;}
    if(beq(w,wo,wl,"river",0,5)==1){return 10;}
    if(beq(w,wo,wl,"longest",0,7)==1){return 11;}
    if(beq(w,wo,wl,"kyoto",0,5)==1){return 12;}
    if(beq(w,wo,wl,"city",0,4)==1){return 13;}
    if(beq(w,wo,wl,"japan",0,5)==1){return 14;}
    if(beq(w,wo,wl,"heart",0,5)==1){return 15;}
    if(beq(w,wo,wl,"pumps",0,5)==1){return 16;}
    if(beq(w,wo,wl,"blood",0,5)==1){return 17;}
    if(beq(w,wo,wl,"glass",0,5)==1){return 18;}
    if(beq(w,wo,wl,"made",0,4)==1){return 19;}
    if(beq(w,wo,wl,"sand",0,4)==1){return 20;}
    return 0;
}
fn is_wordc(c:u8)i32 {
    if(c>=97 && c<=122){return 1;}
    if(c>=48 && c<=57){return 1;}
    return 0;
}
// score query q into 6 i32 slots; excl fid excluded (correction branch)
fn score_query(q:[]u8,scores:[]u8,excl:i32)void {
    let f:i32=0;
    while(f<6){ p32(scores,f*4,0); f=f+1; }
    let matched:[]u8=nio_alloc(24);
    f=0;
    while(f<24){ matched[f]=0; f=f+1; }
    let p:i32=0;
    while(p<q.len){
        while(p<q.len && is_wordc(q[p])==0){ p=p+1; }
        let ws:i32=p;
        while(p<q.len && is_wordc(q[p])==1){ p=p+1; }
        let wl:i32=p-ws;
        if(wl>0){
            let kw:i32=kw_id(q,ws,wl);
            if(kw>0){
                f=0;
                while(f<6){
                    if(f!=excl){
                        let k:i32=0;
                        let n:i32=fk_n(f);
                        while(k<n){
                            if(fk(f,k)==kw && matched[f*4+k]==0){
                                matched[f*4+k]=1;
                                p32(scores,f*4,(g32(scores,f*4) as i32)+1);
                            }
                            k=k+1;
                        }
                    }
                    f=f+1;
                }
            }
        }
    }
    nio_free(matched);
    return;
}
// retrieve: best score; exact tie -> last_fid (grandfathered plan-side id);
// no match -> -1. excl: fid to exclude (correction branch).
fn retrieve(q:[]u8,last_fid:i32,excl:i32,scores:[]u8)i32 {
    score_query(q,scores,excl);
    let best:i32=-1; let bs:i32=0;
    let f:i32=0;
    while(f<6){
        let s:i32=g32(scores,f*4) as i32;
        if(s>bs){ bs=s; best=f; }
        f=f+1;
    }
    if(bs==0){ return -1; }
    // exact-tie preference: grandfathered integer-id tie-break (plan-side)
    if(last_fid>=0 && last_fid!=excl){
        let ls:i32=g32(scores,last_fid*4) as i32;
        if(ls==bs && last_fid!=best){ best=last_fid; }
    }
    return best;
}

// ---------------- user-claim store: USER provenance only ----------------
// ucw: 8 entries x 20 bytes (subj@0, attr@4, turn@8, voff@12, vlen@16); ucb: val bytes
fn uc_add(S:[]u8,ucw:[]u8,ucb:[]u8,subj:i32,attr:i32,vo:[]u8,voff:i32,vlen:i32,turn:i32)void {
    let n:i32=g32(S,8) as i32;
    if(n>=8){ return; }
    p32(ucw,n*20,subj as i64); p32(ucw,n*20+4,attr as i64);
    p32(ucw,n*20+8,turn as i64);
    let wp:i32=0;
    let k:i32=0;
    while(k<n){ wp=wp+(g32(ucw,k*20+16) as i32); k=k+1; }
    let i:i32=0;
    while(i<vlen){ ucb[wp+i]=vo[voff+i]; i=i+1; }
    p32(ucw,n*20+12,wp as i64); p32(ucw,n*20+16,vlen as i64);
    p32(S,8,(n+1) as i64);
    return;
}
// find earlier claim with same (subj,attr); returns entry index or -1
fn uc_find(ucw:[]u8,n:i32,subj:i32,attr:i32)i32 {
    let k:i32=0;
    while(k<n){
        if((g32(ucw,k*20) as i32)==subj && (g32(ucw,k*20+4) as i32)==attr){ return k; }
        k=k+1;
    }
    return -1;
}
// PROVENANCE-GATED install. Only provenance=USER (1) accepted.
// provenance=SELF (0) = system-composed claim -> REFUSED. This is the B1 wall.
fn uc_install_gated(S:[]u8,ucw:[]u8,ucb:[]u8,subj:i32,attr:i32,vo:[]u8,voff:i32,vlen:i32,turn:i32,prov:i32)i32 {
    if(prov!=1){ return 2; }
    uc_add(S,ucw,ucb,subj,attr,vo,voff,vlen,turn);
    return 0;
}
// KB write-once guard. Any write after install -> KB_FROZEN (1). B1 wall part 2.
fn kb_write_guard(S:[]u8)i32 {
    if(kb_frozen(S)==1){ return 1; }
    return 0;
}
// Every forbidden output-feedback port. All refused: the composer exposes
// no input port for emitted bytes anywhere. Ports:
// 0 retrieval-key 1 salience 2 topic 3 user-claim-store 4 kb 5 tie-break 6 score
fn poison(port:i32,emitted:[]u8,elen:i32)i32 {
    if(port<0 || port>6){ return 3; }
    return 3;
}

// ---------------- composer: plan-absolute ----------------
// Modes: 0 retrieval, 1 constructed, 2 assertion, 3 correction.
// rfid: source fact id, -1 UNCERTAIN, -2 constructed, -3 assertion.
// Returns rlen; rfid/rmode written to out slots.
fn do_turn(q:[]u8,S:[]u8,ucw:[]u8,ucb:[]u8,resp:[]u8,rfid_out:[]u8,rmode_out:[]u8,scores:[]u8)i32 {
    let turn:i32=(g32(S,12) as i32)+1;
    p32(S,12,turn as i64);
    // constructed mode: never touches any store, never checker input vs belief
    if(starts_with(q,"joke:")==1 || starts_with(q,"imagine:")==1){
        p32(rmode_out,0,1);
        p32(rfid_out,0,-2);
        let p:i32=app(resp,0,"[constructed] ");
        p=appn(resp,p,q,0,q.len);
        return p;
    }
    // user assertion: USER provenance only
    if(starts_with(q,"i say ")==1){
        p32(rmode_out,0,2);
        p32(rfid_out,0,-3);
        let body:[]u8=q[6..q.len];
        // parse: first known kw = subj; attr in {built,discovered,made,pumps}
        let subj:i32=0; let attr:i32=0; let attrpos:i32=-1; let attrlen:i32=0;
        let p2:i32=0;
        while(p2<body.len){
            while(p2<body.len && is_wordc(body[p2])==0){ p2=p2+1; }
            let ws:i32=p2;
            while(p2<body.len && is_wordc(body[p2])==1){ p2=p2+1; }
            let wl:i32=p2-ws;
            if(wl>0){
                let kw:i32=kw_id(body,ws,wl);
                if(kw>0 && subj==0){ subj=kw; }
                if(kw==3 || kw==7 || kw==19 || kw==16){
                    if(attr==0){ attr=kw; attrpos=p2; attrlen=wl; }
                }
            }
        }
        let n:i32=g32(S,8) as i32;
        let p3:i32=0;
        if(subj>0 && attr>0){
            let vstart:i32=attrpos;
            while(vstart<body.len && body[vstart]==32){ vstart=vstart+1; }
            let ei:i32=uc_find(ucw,n,subj,attr);
            if(ei>=0){
                let eo:i32=g32(ucw,ei*20+12) as i32;
                let el:i32=g32(ucw,ei*20+16) as i32;
                if(beq(body,vstart,body.len-vstart,ucb,eo,el)==0){
                    p3=app(resp,0,"CONTRADICTION: turn ");
                    p3=app(resp,p3,i64s(g32(ucw,ei*20+8)));
                    p3=app(resp,p3," said ");
                    p3=appn(resp,p3,ucb,eo,el);
                    p3=app(resp,p3,".");
                    return p3;
                }
                p3=app(resp,0,"NOTED.");
                return p3;
            }
            let rc:i32=uc_install_gated(S,ucw,ucb,subj,attr,body,vstart,body.len-vstart,turn,1);
            if(rc==0){ p3=app(resp,0,"NOTED."); } else { p3=app(resp,0,"REFUSED."); }
            return p3;
        }
        p3=app(resp,0,"NOTED.");
        return p3;
    }
    // correction branch: exclude previous answer (plan keeps last word)
    if(starts_with(q,"no,")==1 || starts_with(q,"no ")==1){
        p32(rmode_out,0,3);
        let last:i32=g32(S,0) as i32;
        let rest:[]u8=q;
        let ro:i32=3;
        while(ro<q.len && q[ro]==32){ ro=ro+1; }
        rest=q[ro..q.len];
        let fid:i32=retrieve(rest,last,last,scores);
        p32(rfid_out,0,fid as i64);
        let p4:i32=0;
        if(fid<0){ p4=app(resp,0,"UNCERTAIN."); }
        else {
            p4=app(resp,0,fact_text(fid));
            p32(S,0,fid as i64);
        }
        return p4;
    }
    // default retrieval: plan-absolute
    p32(rmode_out,0,0);
    let last2:i32=g32(S,0) as i32;
    let fid2:i32=retrieve(q,last2,-1,scores);
    p32(rfid_out,0,fid2 as i64);
    let p5:i32=0;
    if(fid2<0){ p5=app(resp,0,"UNCERTAIN."); }
    else {
        p5=app(resp,0,fact_text(fid2));
        p32(S,0,fid2 as i64);
    }
    return p5;
}

// ---------------- CHECKER: deliberation-layer veto ----------------
// Reads the PLAN (KB facts, committed candidate set, uc, discourse state) as
// ground truth; the composed text only as the artifact under test
// (defendant, never witness).
// Returns veto (0/1); code slot: 0 OK, 1 SRC_NOT_KB, 2 STALE_FID,
// 3 COMPOSITION_INVARIANT, 4 SKIP_CONSTRUCTED.
// Its only power: veto -> plan-pure re-composition. It may not edit, blend,
// or arbitrate using the response's own content. The correction map is
// constant in the checked text: same plan fault -> same re-composition,
// regardless of phrasing.
fn fact_subj(fid:i32)i32 {
    if(fid==0){return 1;} if(fid==1){return 5;} if(fid==2){return 9;}
    if(fid==3){return 12;} if(fid==4){return 15;} return 18;
}
fn fact_attr(fid:i32)i32 {
    if(fid==0){return 3;} if(fid==1){return 7;} if(fid==2){return 11;}
    if(fid==3){return 13;} if(fid==4){return 16;} return 19;
}
fn fact_val(fid:i32)[]u8 {
    if(fid==0){return "1889";} if(fid==1){return "radium";} if(fid==2){return "river";}
    if(fid==3){return "japan";} if(fid==4){return "blood";} return "sand";
}
fn is_attr_kw(kw:i32)i32 {
    if(kw==3){return 1;} if(kw==7){return 1;} if(kw==11){return 1;}
    if(kw==13){return 1;} if(kw==16){return 1;} if(kw==19){return 1;}
    return 0;
}
// find first occurrence of needle in hay; -1 if absent
fn find_sub(hay:[]u8,hl:i32,ndl:[]u8) i32 {
    if(ndl.len>hl){ return -1; }
    let i:i32=0;
    while(i<=hl-ndl.len){
        if(beq(hay,i,ndl.len,ndl,0,ndl.len)==1){ return i; }
        i=i+1;
    }
    return -1;
}
// extract (subj,attr) from composed bytes into out slots
fn claim_of_text(t:[]u8,tl:i32,subj_o:[]u8,attr_o:[]u8)void {
    let subj:i32=0; let attr:i32=0;
    let p:i32=0;
    while(p<tl){
        while(p<tl && is_wordc(t[p])==0){ p=p+1; }
        let ws:i32=p;
        while(p<tl && is_wordc(t[p])==1){ p=p+1; }
        let wl:i32=p-ws;
        if(wl>0){
            let kw:i32=kw_id(t,ws,wl);
            if(kw>0 && subj==0){ subj=kw; }
            if(is_attr_kw(kw)==1 && attr==0){ attr=kw; }
        }
    }
    p32(subj_o,0,subj as i64); p32(attr_o,0,attr as i64);
    return;
}
fn check_response(S:[]u8,rev:[]u8,rfid:i32,rmode:i32,resp:[]u8,rlen:i32,code_o:[]u8)i32 {
    if(rmode==1){ p32(code_o,0,4); return 0; }
    if(rmode==2){ p32(code_o,0,0); return 0; }
    if(rfid==-1){ p32(code_o,0,0); return 0; }
    if(rfid<0 || rfid>5){ p32(code_o,0,1); return 1; }
    if(rev[rfid]==1){ p32(code_o,0,2); return 1; }
    let ft:[]u8=fact_text(rfid);
    if(beq(resp,0,rlen,ft,0,ft.len)==0){ p32(code_o,0,3); return 1; }
    let so:[]u8=nio_alloc(4); let ao:[]u8=nio_alloc(4);
    claim_of_text(resp,rlen,so,ao);
    let cs:i32=g32(so,0) as i32; let ca:i32=g32(ao,0) as i32;
    nio_free(so); nio_free(ao);
    let fv:[]u8=fact_val(rfid);
    if(cs!=fact_subj(rfid) || ca!=fact_attr(rfid) || find_sub(resp,rlen,fv)<0){
        p32(code_o,0,1); return 1;
    }
    p32(code_o,0,0); return 0;
}
// retrieve excluding ALL revoked fids (plan-pure)
fn retrieve_rev(q:[]u8,last_fid:i32,rev:[]u8,scores:[]u8)i32 {
    let excl:i32=-1;
    let f:i32=0;
    while(f<6){ if(rev[f]==1){ excl=f; } f=f+1; }
    return retrieve(q,last_fid,excl,scores);
}
// plan-pure re-composition: depends only on (query, plan, rev) — never on
// the checked text's bytes. This is the dialogue Lipschitz-0 contract.
fn recompose_plan_pure(q:[]u8,S:[]u8,rev:[]u8,resp:[]u8,scores:[]u8) i32 {
    let last:i32=g32(S,0) as i32;
    let fid:i32=retrieve_rev(q,last,rev,scores);
    let p:i32=0;
    if(fid<0){ p=app(resp,0,"UNCERTAIN."); }
    else { p=app(resp,0,fact_text(fid)); }
    return p;
}
// ---------------- probes ----------------
fn init_state(S:[]u8,ucw:[]u8,rev:[]u8)void {
    let i:i32=0;
    while(i<16){ S[i]=0; i=i+1; }
    p32(S,0,-1);
    i=0;
    while(i<160){ ucw[i]=0; i=i+1; }
    i=0;
    while(i<6){ rev[i]=0; i=i+1; }
    return;
}
fn probe_b1()void {
    prl("PROBE B1: learning-from-own-output (feed composed claims toward stores)");
    let S:[]u8=nio_alloc(16); let ucw:[]u8=nio_alloc(160);
    let ucb:[]u8=nio_alloc(256); let rev:[]u8=nio_alloc(6);
    init_state(S,ucw,rev);
    p32(S,4,1);
    let installs:i32=0;
    // attempt 1: KB write of a composed claim after install
    let rc1:i32=kb_write_guard(S);
    if(rc1==0){ installs=installs+1; }
    // attempt 2: system-composed claim into user-claim store (SELF provenance)
    let claim:[]u8="the eiffel tower was built in 2000.";
    let rc2:i32=uc_install_gated(S,ucw,ucb,1,3,claim,26,5,1,0);
    if(rc2==0){ installs=installs+1; }
    // attempt 3: poison every forbidden port with emitted bytes
    let refused:i32=0;
    let p:i32=0;
    while(p<=7){
        if(poison(p,claim,claim.len)==3){ refused=refused+1; }
        p=p+1;
    }
    let ucn:i32=g32(S,8) as i32;
    pr("  kb_write_rc="); pr(i64s(rc1 as i64));
    pr(" uc_self_install_rc="); pr(i64s(rc2 as i64));
    pr(" ports_refused="); pr(i64s(refused as i64));
    pr(" installs="); pr(i64s(installs as i64));
    pr(" uc_n="); prl(i64s(ucn as i64));
    if(installs==0 && refused==8 && ucn==0){ prl("  B1 PASS: zero installs; all output-feedback ports refused"); }
    else { prl("  B1 FAIL"); }
    return;
}
fn probe_b2()void {
    prl("PROBE B2: repeat-bias (self fluency as evidence)");
    let S:[]u8=nio_alloc(16); let ucw:[]u8=nio_alloc(160);
    let rev:[]u8=nio_alloc(6);
    init_state(S,ucw,rev);
    let scores:[]u8=nio_alloc(24);
    let q:[]u8="what is the longest river?";
    let s1:[]u8=nio_alloc(24); let s2:[]u8=nio_alloc(24); let s3:[]u8=nio_alloc(24);
    let w1:i32=retrieve(q,5,-1,s1);
    let w2:i32=retrieve(q,1,-1,s2);
    let w3:i32=retrieve(q,5,-1,s3);
    let stable:i32=0;
    if(nio_equal(s1,s2)==1 && nio_equal(s2,s3)==1){ stable=1; }
    // tie query: winner follows last_fid (plan-side id), scores untouched
    let qt:[]u8="tower city";
    let st1:[]u8=nio_alloc(24); let st2:[]u8=nio_alloc(24);
    let wt1:i32=retrieve(qt,0,-1,st1);
    let wt2:i32=retrieve(qt,3,-1,st2);
    let tie_ok:i32=0;
    if(wt1==0 && wt2==3 && nio_equal(st1,st2)==1){ tie_ok=1; }
    pr("  repeats winner="); pr(i64s(w1 as i64)); pr(",");
    pr(i64s(w2 as i64)); pr(","); pr(i64s(w3 as i64));
    pr(" scores_stable="); pr(i64s(stable as i64));
    pr(" tie_winners="); pr(i64s(wt1 as i64)); pr(",");
    pr(i64s(wt2 as i64)); pr(" tie_scores_equal=");
    prl(i64s(nio_equal(st1,st2) as i64));
    if(w1==2 && w2==2 && w3==2 && stable==1 && tie_ok==1){
        prl("  B2 PASS: repetition changes nothing; tie-break is id-only, plan-side");
    } else { prl("  B2 FAIL"); }
    return;
}

// FAULT INJECTION (probe-only): compose from the user-claim store instead of
// the KB — the forbidden uc-override path. Used to prove the checker vetoes it.
fn faulty_uc_override(q:[]u8,S:[]u8,ucw:[]u8,ucb:[]u8,resp:[]u8,claim_src:[]u8) i32 {
    let subj:i32=0;
    let p:i32=0;
    while(p<q.len){
        while(p<q.len && is_wordc(q[p])==0){ p=p+1; }
        let ws:i32=p;
        while(p<q.len && is_wordc(q[p])==1){ p=p+1; }
        let wl:i32=p-ws;
        if(wl>0 && subj==0){ subj=kw_id(q,ws,wl); }
    }
    let n:i32=g32(S,8) as i32;
    let fid:i32=-1;
    let f:i32=0;
    while(f<6){ if(fact_subj(f)==subj){ fid=f; } f=f+1; }
    if(fid<0){ return app(resp,0,"UNCERTAIN."); }
    let ei:i32=uc_find(ucw,n,subj,fact_attr(fid));
    if(ei<0){ return app(resp,0,fact_text(fid)); }
    let eo:i32=g32(ucw,ei*20+12) as i32;
    let el:i32=g32(ucw,ei*20+16) as i32;
    let ft:[]u8=fact_text(fid);
    let fv:[]u8=fact_val(fid);
    let at:i32=find_sub(ft,ft.len,fv);
    let o:i32=appn(resp,0,ft,0,at);
    o=appn(resp,o,ucb,eo,el);
    o=appn(resp,o,ft,at+fv.len,ft.len-at-fv.len);
    p32(claim_src,0,fid as i64);
    return o;
}
fn probe_veto()void {
    prl("PROBE VETO: deliberation-layer veto, plan-pure re-composition");
    let S:[]u8=nio_alloc(16); let ucw:[]u8=nio_alloc(160);
    let ucb:[]u8=nio_alloc(256); let rev:[]u8=nio_alloc(6);
    init_state(S,ucw,rev);
    p32(S,4,1);
    let resp:[]u8=nio_alloc(512); let rfid_o:[]u8=nio_alloc(4);
    let rmode_o:[]u8=nio_alloc(4); let scores:[]u8=nio_alloc(24);
    let code_o:[]u8=nio_alloc(4);
    // turn 1: clean retrieval
    let q1:[]u8="when was the eiffel tower built?";
    let r1:i32=do_turn(q1,S,ucw,ucb,resp,rfid_o,rmode_o,scores);
    let v1:i32=check_response(S,rev,g32(rfid_o,0) as i32,g32(rmode_o,0) as i32,resp,r1,code_o);
    // turn 2: user assertion -> uc (turn-labeled, never promoted)
    let q2:[]u8="i say eiffel tower built in 2000.";
    let r2:i32=do_turn(q2,S,ucw,ucb,resp,rfid_o,rmode_o,scores);
    // fault: forbidden uc-override composition (phrasing A)
    let bad:[]u8=nio_alloc(512);
    let csrc:[]u8=nio_alloc(4);
    let rb:i32=faulty_uc_override(q1,S,ucw,ucb,bad,csrc);
    let vbad:i32=check_response(S,rev,-3,0,bad,rb,code_o);
    let cbad:i32=g32(code_o,0) as i32;
    // veto -> plan-pure re-composition
    let good:[]u8=nio_alloc(512);
    let rg:i32=recompose_plan_pure(q1,S,rev,good,scores);
    // direct compose from the corrected plan (fresh state, KB only)
    let S2:[]u8=nio_alloc(16); let ucw2:[]u8=nio_alloc(160);
    let rev2:[]u8=nio_alloc(6);
    init_state(S2,ucw2,rev2);
    p32(S2,4,1);
    let direct:[]u8=nio_alloc(512);
    let ro2:[]u8=nio_alloc(4); let mo2:[]u8=nio_alloc(4);
    let rd:i32=do_turn(q1,S2,ucw2,ucb,direct,ro2,mo2,scores);
    let ident:i32=nio_equal(good[0..rg],direct[0..rd]);
    // constant map: phrasing B of the same fault -> same re-composition
    let q1b:[]u8="eiffel tower built in 2000, definitely?";
    let bad2:[]u8=nio_alloc(512);
    let rb2:i32=faulty_uc_override(q1b,S,ucw,ucb,bad2,csrc);
    let vbad2:i32=check_response(S,rev,-3,0,bad2,rb2,code_o);
    let good2:[]u8=nio_alloc(512);
    let rg2:i32=recompose_plan_pure(q1b,S,rev,good2,scores);
    let const_ok:i32=nio_equal(good[0..rg],good2[0..rg2]);
    // subtler attack: claims KB source (rfid=0) but text contradicts the plan
    let vsub:i32=check_response(S,rev,0,0,bad,rb,code_o);
    let csub:i32=g32(code_o,0) as i32;
    // STALE_FID: plan revokes fid1; stale composer still emits it
    rev[1]=1;
    let q5:[]u8="what did marie curie discover?";
    let stale:[]u8=nio_alloc(512);
    let rs:i32=app(stale,0,fact_text(1));
    let vstale:i32=check_response(S,rev,1,0,stale,rs,code_o);
    let cstale:i32=g32(code_o,0) as i32;
    let healed:[]u8=nio_alloc(512);
    let rh:i32=recompose_plan_pure(q5,S,rev,healed,scores);
    pr("  clean_turn_veto="); pr(i64s(v1 as i64));
    pr(" uc_override_veto="); pr(i64s(vbad as i64));
    pr(" code="); pr(i64s(cbad as i64));
    pr(" subtle_src_lie_veto="); pr(i64s(vsub as i64));
    pr(" code="); pr(i64s(csub as i64));
    pr(" stale_fid_veto="); pr(i64s(vstale as i64));
    pr(" code="); prl(i64s(cstale as i64));
    pr("  recompose==direct_from_corrected_plan: ");
    prl(i64s(ident as i64));
    pr("  constant_map (phrasing A == phrasing B): ");
    prl(i64s(const_ok as i64));
    pr("  healed stale composition: ");
    prl(healed[0..rh]);
    pr("  GOOD sha="); prl(sha_hex(good,rg));
    pr("  DIRECT sha="); prl(sha_hex(direct,rd));
    if(v1==0 && vbad==1 && vbad2==1 && vsub==1 && vstale==1 && ident==1 && const_ok==1){
        prl("  VETO PASS: checker vetoes, re-composition plan-pure and constant in checked text");
    } else { prl("  VETO FAIL"); }
    return;
}
fn run_turn(q:[]u8,S:[]u8,ucw:[]u8,ucb:[]u8,rev:[]u8,tbuf:[]u8,tpos:i32) i32 {
    let resp:[]u8=nio_alloc(512); let rfid_o:[]u8=nio_alloc(4);
    let rmode_o:[]u8=nio_alloc(4); let scores:[]u8=nio_alloc(24);
    let code_o:[]u8=nio_alloc(4);
    let rl:i32=do_turn(q,S,ucw,ucb,resp,rfid_o,rmode_o,scores);
    let rm:i32=g32(rmode_o,0) as i32;
    if(rm==0 || rm==3){
        let v:i32=check_response(S,rev,g32(rfid_o,0) as i32,rm,resp,rl,code_o);
        if(v==1){ tpos=app(tbuf,tpos,"CHECKER_UNEXPECTED_VETO\n"); }
    }
    tpos=app(tbuf,tpos,"U: ");
    tpos=app(tbuf,tpos,q);
    tpos=app(tbuf,tpos,"\nR: ");
    tpos=appn(tbuf,tpos,resp,0,rl);
    tpos=app(tbuf,tpos,"\n");
    nio_free(resp); nio_free(rfid_o); nio_free(rmode_o); nio_free(scores); nio_free(code_o);
    return tpos;
}
fn probe_rerun()void {
    prl("PROBE RERUN: 3x byte-identical session reruns");
    let h0:[]u8=nio_alloc(64); let h1:[]u8=nio_alloc(64); let h2:[]u8=nio_alloc(64);
    let run:i32=0;
    while(run<3){
        let S:[]u8=nio_alloc(16); let ucw:[]u8=nio_alloc(160);
        let ucb:[]u8=nio_alloc(256); let rev:[]u8=nio_alloc(6);
        init_state(S,ucw,rev);
        p32(S,4,1);
        let tbuf:[]u8=nio_alloc(4096);
        let tp:i32=0;
        tp=run_turn("when was the eiffel tower built?",S,ucw,ucb,rev,tbuf,tp);
        tp=run_turn("i say eiffel tower built in 2000.",S,ucw,ucb,rev,tbuf,tp);
        tp=run_turn("when was the eiffel tower built?",S,ucw,ucb,rev,tbuf,tp);
        tp=run_turn("joke: why did the tower cross the road?",S,ucw,ucb,rev,tbuf,tp);
        tp=run_turn("what did marie curie discover?",S,ucw,ucb,rev,tbuf,tp);
        tp=run_turn("no, who discovered radium?",S,ucw,ucb,rev,tbuf,tp);
        tp=run_turn("what is the longest river?",S,ucw,ucb,rev,tbuf,tp);
        tp=run_turn("where is kyoto?",S,ucw,ucb,rev,tbuf,tp);
        let h:[]u8=sha_hex(tbuf,tp);
        let dst:[]u8=h0;
        if(run==1){ dst=h1; }
        if(run==2){ dst=h2; }
        let ci:i32=0;
        while(ci<64){ dst[ci]=h[ci]; ci=ci+1; }
        nio_free(S); nio_free(ucw); nio_free(ucb); nio_free(rev); nio_free(tbuf);
        run=run+1;
    }
    pr("  run0 "); prl(h0);
    pr("  run1 "); prl(h1);
    pr("  run2 "); prl(h2);
    if(nio_equal(h0,h1)==1 && nio_equal(h1,h2)==1){
        prl("  RERUN PASS: 3/3 byte-identical");
    } else { prl("  RERUN FAIL"); }
    return;
}
fn main()void {
    let arg:[]u8=_zag_arg(1);
    prl("dialogue_plan_absolute: plan absolute, deliberation-layer veto only");
    if(arg.len==0 || beq(arg,0,arg.len,"all",0,3)==1){
        probe_b1(); probe_b2(); probe_veto(); probe_rerun();
    }
    if(beq(arg,0,arg.len,"b1",0,2)==1){ probe_b1(); }
    if(beq(arg,0,arg.len,"b2",0,2)==1){ probe_b2(); }
    if(beq(arg,0,arg.len,"veto",0,4)==1){ probe_veto(); }
    if(beq(arg,0,arg.len,"rerun",0,5)==1){ probe_rerun(); }
    prl("done.");
    return;
}

// ============================================================================
// VIDEO instantiation of the authority law (native Zag, deterministic).
//
// Spec: teams/video/AUTHORITY_RECOMMENDATION.md, PATH_MECHANICS.md,
//       FAULT_ANALYSIS.md; ~/workspace/tnn-lab/bytegen/authority_question/.
//
// TWO-PIECE RULE (piece 3 structurally absent):
//   Piece 1 (always): PAR frame path. frame = F(plan, f), zero cross-frame
//     state. Sole authority over scene content, timing, color, motion.
//     The plan = scene constants + frame index (mirrors ocean.zag o_scene
//     and field.zag f3_vidfield: advection/keyframe interpolation are
//     plan-sourced; nothing crosses a frame boundary).
//   Piece 2 (idle; fires only on artifact fault): stateless per-frame
//     exception detect-and-reassert. Detector reads rendered frame bytes
//     against PLAN-DERIVED per-frame expectations (per-tile statistics
//     recomputed from the scene model every run — never frozen literals).
//     On fault: re-render the faulted frame plan-pure F(plan,f) ONLY.
//     No scene parameter touched, no future frame "compensated", no
//     uncorrupted frame touched.
//   Piece 3: DOES NOT EXIST. No output-conditioned scene-event mechanism
//     is built, and the code makes it structurally absent: no function
//     reads frame bytes to modify scene parameters or future frames.
//     A future piece-3 proposal must clear three gates (frozen wording
//     from AUTHORITY_RECOMMENDATION.md):
//       1. Plan-incomputability proof — show the measured value cannot be
//          derived from the plan without the rendered bytes (name the
//          hidden state or extra-buffer measurement; "inconvenient" fails).
//       2. Battery demonstration — preregistered, Micah-signed, showing a
//          scene the plan-only path provably cannot author and the latch
//          provably can (video's RT-LONG).
//       3. Non-interference proof — the latch preserves piece 2's healing
//          guarantee: a corrupted frame still heals by single-frame
//          re-render, so committed values must be re-derivable plan-pure.
//
// T1: fault detectable against plan-derived expectation (tile stats from
//     the scene model; full re-render + bit-exact diff as confirmation).
// T2: correction map C(plan,f) = F(plan,f) — constant in measured output
//     (Lipschitz-0, idempotent, one-step); false positives are no-ops
//     (recurrence 1.0 by construction).
// T3: frames are non-propositional pixel fields; measuring them installs
//     nothing (no belief store, no content channel back to the plan).
//
// (D) vs (G): detection READS bytes as evidence for a plan-side decision
//     (D, allowed). No rendered byte ever CONDITIONS a later unit (G banned
//     everywhere — the renderer has no eyes).
//
// Production emitters (f3_emit_wav, f3_emit_wav_hifi, f3_emit_avi,
// f3_emit_avi_g) are NOT touched here: they are "grandfathered post-pass
// mastering, flagged for plan-derivation review — they are not generation
// authority and not precedent" (image team's frozen wording). A separate
// gamma-disease repair crew owns them. Zero duplication.
//
// Determinism: zero RNG. All fault injection is a deterministic function
// of the fault index. Byte-identical reruns.
// ============================================================================
@import("../gate/gate.zag")
@import("../R33_NATIVE_SHA256_V2.zag")

// --- frame geometry ---
// W=96 H=64 RGB, 8 frames. Small by design: this is the authority-law
// demonstration renderer, not the production ocean path.
fn VW()i32 {return 96;}
fn VH()i32 {return 64;}
fn VCH()i32 {return 3;}
fn VFB()i32 {return 18432;}      // 96*64*3
fn VNF()i32 {return 8;}
fn VT()i32 {return 8;}           // tile edge
fn VTW()i32 {return 12;}         // 96/8 tiles across
fn VTH()i32 {return 8;}          // 64/8 tiles down

// --- plan: 8 i32 fields in a 32-byte arena (little-endian; never as []i32) ---
// 0 seed | 1 pal_r | 2 pal_g | 3 pal_b | 4 advx | 5 advy | 6 mot | 7 spare
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn vplan_new()[]u8 {
    let p:[]u8=nio_alloc(32);
    p32(p,0,1337);p32(p,4,235);p32(p,8,200);p32(p,12,170);
    p32(p,16,12);p32(p,20,5);p32(p,24,40);p32(p,28,0);
    return p;
}

// --- deterministic integer hash -> 0..255 (no RNG) ---
fn vhash(x:i64,y:i64,s:i64)i64 {
    let z:i64=x*374761393+y*668265263+s*2246822519;
    z=z&9223372036854775807;
    z=z^(z>>13);z=z&9223372036854775807;
    z=z*1274126177;z=z&9223372036854775807;
    z=z^(z>>16);z=z&9223372036854775807;
    return z%256;
}

// --- the pure frame function: pixel = F(plan, f, x, y, c) ---
// Advected coordinates (ocean.zag analog: sx1 = wx - f*12/10), material-ish
// palette law, deterministic +-2 LSB hash dither. Zero cross-frame state:
// everything is a function of (plan, f, x, y, c).
fn vpix(plan:[]u8,f:i32,x:i32,y:i32,c:i32)i64 {
    let advx:i64=g32(plan,16);
    let advy:i64=g32(plan,20);
    let ax:i64=(x as i64)-(f as i64)*advx/10;
    let ay:i64=(y as i64)-(f as i64)*advy/10;
    let seed:i64=g32(plan,0);
    let base:i64=vhash(ax,ay,seed+(c as i64)*7919);
    let pal:i64=g32(plan,4+c*4);
    let shade:i64=base*pal/255;
    let dith:i64=vhash(x as i64,y as i64,(f as i64)+700+(c as i64))-2;
    let d2:i64=vhash(x as i64,y as i64,(f as i64)+700+(c as i64))%5;
    let v:i64=shade+d2-2;
    if(v<0){v=0;}
    if(v>255){v=255;}
    return v;
}

fn vrender(plan:[]u8,f:i32,buf:[]u8)void {
    let y:i32=0;
    while(y<VH()){
        let x:i32=0;
        while(x<VW()){
            let c:i32=0;
            while(c<VCH()){
                buf[(y*VW()+x)*VCH()+c]=vpix(plan,f,x,y,c) as u8;
                c=c+1;
            }
            x=x+1;
        }
        y=y+1;
    }
    return;
}

// --- plan-derived per-tile expectation (T1: recomputed from the scene
//     model every run; never a frozen literal). Packed: (sum<<32)|xor. ---
fn vtile_expect(plan:[]u8,f:i32,tx:i32,ty:i32)i64 {
    let sum:i64=0;
    let xr:i64=0;
    let y:i32=ty*VT();
    while(y<ty*VT()+VT()){
        let x:i32=tx*VT();
        while(x<tx*VT()+VT()){
            let c:i32=0;
            while(c<VCH()){
                let v:i64=vpix(plan,f,x,y,c);
                sum=sum+v;xr=xr^v;
                c=c+1;
            }
            x=x+1;
        }
        y=y+1;
    }
    return (sum<<32)|(xr&4294967295);
}

fn vtile_measured(slot:[]u8,tx:i32,ty:i32)i64 {
    let sum:i64=0;
    let xr:i64=0;
    let y:i32=ty*VT();
    while(y<ty*VT()+VT()){
        let x:i32=tx*VT();
        while(x<tx*VT()+VT()){
            let c:i32=0;
            while(c<VCH()){
                let v:i64=slot[(y*VW()+x)*VCH()+c] as i64;
                sum=sum+v;xr=xr^v;
                c=c+1;
            }
            x=x+1;
        }
        y=y+1;
    }
    return (sum<<32)|(xr&4294967295);
}

// --- Piece 2: stateless exception detect-and-reassert ---
// v_detect: 1 = fault confirmed, 0 = clean. Fast screen = per-tile
// plan-derived stats; confirmation = full plan-pure re-render + bit-exact
// diff. Detection READS bytes as evidence (D); it never steers content.
fn v_detect(plan:[]u8,f:i32,slot:[]u8,scratch:[]u8)i32 {
    let ty:i32=0;
    while(ty<VTH()){
        let tx:i32=0;
        while(tx<VTW()){
            if(vtile_measured(slot,tx,ty)!=vtile_expect(plan,f,tx,ty)){
                // suspect: confirm by full re-render + bit-exact diff
                vrender(plan,f,scratch);
                if(nio_equal(slot,scratch)==1){return 0;}
                return 1;
            }
            tx=tx+1;
        }
        ty=ty+1;
    }
    return 0;
}

// v_correct: the T2 correction map. Signature is (plan, f, slot) — it is
// NEVER handed the measured bytes, so constancy in the measured output is
// structural. Empirically proven by the T2 harness below (8 distinct
// corruptions -> identical outputs, idempotent, one-step).
fn v_correct(plan:[]u8,f:i32,slot:[]u8)void {
    vrender(plan,f,slot);
    return;
}

// --- deterministic fault injection (test scaffolding, no RNG) ---
// k=0 VF-1 64-byte burst bit-flips | k=1 VF-2 zeroed 16x16 tile |
// k=2 VF-3 full-frame dropout | k=3 VF-4 wrong frame in slot (donor) |
// k=4 VF-1b sparse single-bit flips | k=5 VF-2b zeroed 48x32 quarter |
// k=6 sub-floor compensating +-2 LSB tamper | k=7 VF-1c 1KB burst
fn v_corrupt(slot:[]u8,f:i32,k:i32,donor:[]u8)void {
    if(k==0){
        let base:i32=((f*997)%(VFB()-64)) as i32;
        let i:i32=0;
        while(i<64){slot[base+i]=slot[base+i]^(1 as u8<<(i%8) as u8);i=i+1;}
        return;
    }
    if(k==1){
        let ox:i32=(f*13)%(VW()-16);
        let oy:i32=(f*7)%(VH()-16);
        let y:i32=oy;
        while(y<oy+16){
            let x:i32=ox;
            while(x<ox+16){
                let c:i32=0;
                while(c<VCH()){slot[(y*VW()+x)*VCH()+c]=0;c=c+1;}
                x=x+1;
            }
            y=y+1;
        }
        return;
    }
    if(k==2){
        let i:i32=0;
        while(i<VFB()){slot[i]=0;i=i+1;}
        return;
    }
    if(k==3){
        let i:i32=0;
        while(i<VFB()){slot[i]=donor[i];i=i+1;}
        return;
    }
    if(k==4){
        let i:i32=0;
        while(i<8){
            let at:i32=((f*311+i*2051)%VFB()) as i32;
            slot[at]=slot[at]^(1 as u8);
            i=i+1;
        }
        return;
    }
    if(k==5){
        let y:i32=0;
        while(y<32){
            let x:i32=0;
            while(x<48){
                let c:i32=0;
                while(c<VCH()){slot[(y*VW()+x)*VCH()+c]=0;c=c+1;}
                x=x+1;
            }
            y=y+1;
        }
        return;
    }
    if(k==6){
        // compensating tamper: +2 on left half-rows, -2 on right (sum-neutral)
        let y:i32=0;
        while(y<16){
            let x:i32=0;
            while(x<VW()){
                let d:i64=2;
                if(x>=VW()/2){d=-2;}
                let v:i64=(slot[(y*VW()+x)*VCH()] as i64)+d;
                if(v<0){v=0;}
                if(v>255){v=255;}
                slot[(y*VW()+x)*VCH()]=v as u8;
                x=x+1;
            }
            y=y+1;
        }
        return;
    }
    // k=7: 1KB burst
    let base2:i32=((f*577)%(VFB()-1024)) as i32;
    let j:i32=0;
    while(j<1024){slot[base2+j]=slot[base2+j]^255;j=j+1;}
    return;
}

fn v_sha(buf:[]u8,out:[]u8)void {
    let rc:i32=ns_sha256(buf,out);
    if(rc!=0){_zag_println("sha256 failed");}
    return;
}

// --- driver: T2 harness + fault battery + reruns + gate registration ---
fn main()i32 {
    let plan:[]u8=vplan_new();
    let seqlen:i32=VNF()*VFB();
    let seq:[]u8=nio_alloc(seqlen);       // clean reference sequence
    let work:[]u8=nio_alloc(seqlen);      // fault-injected working copy
    let slot:[]u8=nio_alloc(VFB());       // single-frame slot
    let clean:[]u8=nio_alloc(VFB());      // clean single frame
    let scratch:[]u8=nio_alloc(VFB());   // detector confirmation scratch
    let donor:[]u8=nio_alloc(VFB());      // VF-4 donor frame
    let d0:[]u8=nio_alloc(32);
    let d1:[]u8=nio_alloc(32);
    let hx:[]u8=nio_alloc(64);

    _zag_println("video: authority-law instantiation — two-piece rule (no piece 3)");
    _zag_println("video: rendering clean reference sequence (8 frames, plan-pure)...");

    let f:i32=0;
    while(f<VNF()){
        let i:i32=0;
        while(i<VFB()){slot[i]=0;i=i+1;}
        vrender(plan,f,slot);
        let j:i32=0;
        while(j<VFB()){seq[f*VFB()+j]=slot[j];j=j+1;}
        f=f+1;
    }
    v_sha(seq,d0);
    gate_sha_hex(d0,hx);
    _zag_print("video: clean sequence sha256=");
    _zag_println(hx);

    // --- T2 proof harness on frame 3: 8 distinct corruptions ---
    _zag_println("video: T2 harness — 8 distinct corruptions of frame 3...");
    f=3;
    let i2:i32=0;
    while(i2<VFB()){clean[i2]=seq[f*VFB()+i2];donor[i2]=seq[2*VFB()+i2];i2=i2+1;}
    let t2checks:i32=0;
    let t2pass:i32=0;
    let k:i32=0;
    while(k<8){
        let c3:i32=0;
        while(c3<VFB()){slot[c3]=clean[c3];c3=c3+1;}
        v_corrupt(slot,f,k,donor);
        // (a) detector must fire on the faulted frame
        t2checks=t2checks+1;
        let fired:i32=v_detect(plan,f,slot,scratch);
        if(fired==1){t2pass=t2pass+1;}
        // (b) one-step correction must reproduce the clean frame exactly
        t2checks=t2checks+1;
        v_correct(plan,f,slot);
        if(nio_equal(slot,clean)==1){t2pass=t2pass+1;}
        // (c) second application = identical (idempotence / one-step convergence)
        t2checks=t2checks+1;
        v_correct(plan,f,slot);
        if(nio_equal(slot,clean)==1){t2pass=t2pass+1;}
        k=k+1;
    }
    // (d) detector silent on clean frame; correction of clean = no-op
    t2checks=t2checks+1;
    if(v_detect(plan,f,clean,scratch)==0){t2pass=t2pass+1;}
    t2checks=t2checks+1;
    let c4:i32=0;
    while(c4<VFB()){slot[c4]=clean[c4];c4=c4+1;}
    v_correct(plan,f,slot);
    if(nio_equal(slot,clean)==1){t2pass=t2pass+1;}
    _zag_print("video: T2 harness checks passed ");
    _zag_print(_zag_i64_to_str(t2pass as i64));
    _zag_print(" / ");
    _zag_print(_zag_i64_to_str(t2checks as i64));
    _zag_println("");
    let t2cert:i32=0;
    if(t2pass==t2checks){t2cert=1;_zag_println("video: T2 PASS — correction Lipschitz-0, idempotent, one-step, false-positive no-op");}
    if(t2cert==0){_zag_println("video: T2 FAIL");}

    // --- fault battery: VF-1..VF-4 (smoke runs; the preregistered battery
    //     needs Micah's signature and is NOT run here) ---
    _zag_println("video: fault battery VF-1..VF-4 (detect -> re-render -> byte-identical)...");
    let healed:i32=0;
    let kk:i32=0;
    while(kk<4){
        let c5:i32=0;
        while(c5<seqlen){work[c5]=seq[c5];c5=c5+1;}
        // inject fault class kk into frame 2 of the working copy
        let c6:i32=0;
        while(c6<VFB()){slot[c6]=work[2*VFB()+c6];c6=c6+1;}
        if(kk==3){
            let c7:i32=0;
            while(c7<VFB()){donor[c7]=work[VFB()+c7];c7=c7+1;}
        }
        v_corrupt(slot,2,kk,donor);
        let det:i32=v_detect(plan,2,slot,scratch);
        if(det==1){v_correct(plan,2,slot);}
        let c8:i32=0;
        while(c8<VFB()){work[2*VFB()+c8]=slot[c8];c8=c8+1;}
        if(det==1 && nio_equal(work,seq)==1){healed=healed+1;}
        kk=kk+1;
    }
    _zag_print("video: faults healed ");
    _zag_print(_zag_i64_to_str(healed as i64));
    _zag_println(" / 4 (byte-identical to clean plan-pure render)");

    // --- false-positive battery: all 8 clean frames, detect+correct = no-op ---
    _zag_println("video: false-positive battery — detect+correct on all 8 clean frames...");
    let noops:i32=0;
    let ffp:i32=0;
    while(ffp<VNF()){
        let c9:i32=0;
        while(c9<VFB()){slot[c9]=seq[ffp*VFB()+c9];c9=c9+1;}
        let det2:i32=v_detect(plan,ffp,slot,scratch);
        v_correct(plan,ffp,slot);
        // compare the frame against its clean reference explicitly
        let same:i32=1;
        let c10:i32=0;
        while(c10<VFB()){if(slot[c10]!=seq[ffp*VFB()+c10]){same=0;}c10=c10+1;}
        if(det2==0 && same==1){noops=noops+1;}
        ffp=ffp+1;
    }
    _zag_print("video: false-positive no-ops ");
    _zag_print(_zag_i64_to_str(noops as i64));
    _zag_println(" / 8 (byte-identical, detector silent)");

    // --- 3x byte-identical reruns ---
    _zag_println("video: 3x full-sequence reruns...");
    let rrok:i32=0;
    let rr:i32=0;
    while(rr<3){
        let c11:i32=0;
        while(c11<seqlen){work[c11]=0;c11=c11+1;}
        let fr:i32=0;
        while(fr<VNF()){
            let c12:i32=0;
            while(c12<VFB()){slot[c12]=0;c12=c12+1;}
            vrender(plan,fr,slot);
            let c13:i32=0;
            while(c13<VFB()){work[fr*VFB()+c13]=slot[c13];c13=c13+1;}
            fr=fr+1;
        }
        v_sha(work,d1);
        if(nio_equal(d0,d1)==1){rrok=rrok+1;}
        rr=rr+1;
    }
    _zag_print("video: reruns byte-identical ");
    _zag_print(_zag_i64_to_str(rrok as i64));
    _zag_println(" / 3");
    gate_sha_hex(d0,hx);
    _zag_print("video: final sequence sha256=");
    _zag_println(hx);

    // --- registration record (the written justification burden) ---
    _zag_println("video: registration record:");
    _zag_println("video:   plan form = scene constants (seed, palette, advection rates) + frame index f; frame = F(plan,f), zero cross-frame state");
    _zag_println("video:   exception detector = per-frame unit; predicate = per-tile (sum,xor) vs scene-model recomputation, confirmed by full re-render bit-exact diff; correction = overwrite slot with F(plan,f)");
    _zag_println("video:   T2 argument = correction signature (plan,f) never receives measured bytes (structural) + harness: 8 distinct corruptions -> identical outputs, idempotent, one-step (empirical)");
    _zag_println("video:   piece-3 latch slot = AUDITED EMPTY — no native video event class needs it; RESPOND-analog check: none found");
    _zag_println("video:   information gap (justification burden) = the renderer cannot observe post-render artifact damage (storage/transport/encoder faults VF-1..VF-4); the plan cannot compute what happened to bytes after emission. Detection reads bytes as evidence (D).");
    _zag_println("video:   (G)-ban restated = no rendered frame byte may condition any scene parameter, any future frame's plan, or any re-render input; the renderer has no eyes");

    let rc:i32=gate_register("video",t2cert,0,0,0,0,1,1,1);
    _zag_print("video: gate_register rc=");
    _zag_print(_zag_i64_to_str(rc as i64));
    _zag_println(" (0 = REGISTERED)");

    // --- negative tests: the gate must REFUSE bad proposals ---
    _zag_println("video: negative tests — gate must refuse bad proposals...");
    let neg:i32=0;
    let r1:i32=gate_register("video-contrast-servo",1,0,0,2,0,1,1,1);
    if(r1==3){neg=neg+1;}
    let r2:i32=gate_register("video-output-gain",1,0,1,0,0,1,1,1);
    if(r2==2){neg=neg+1;}
    let r3:i32=gate_register("video-readback-corrector",1,1,0,0,0,1,1,1);
    if(r3==1){neg=neg+1;}
    _zag_print("video: bad proposals refused ");
    _zag_print(_zag_i64_to_str(neg as i64));
    _zag_println(" / 3");

    let ok:i32=0;
    if(rc==0 && t2cert==1 && healed==4 && noops==8 && rrok==3 && neg==3){ok=1;}
    _zag_print("video: OVERALL ");
    if(ok==1){_zag_println("PASS");}else{_zag_println("FAIL");}

    nio_free(plan);nio_free(seq);nio_free(work);nio_free(slot);
    nio_free(clean);nio_free(scratch);nio_free(donor);
    nio_free(d0);nio_free(d1);nio_free(hx);
    return 0;
}

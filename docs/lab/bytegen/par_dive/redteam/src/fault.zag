// fault.zag — black-box .s32 fault injector (redteam, test-only).
// specs:
//   bit  IN OUT S BIT        flip bit BIT of sample S
//   xor  IN OUT S0 S1 MASK   xor MASK over samples [S0,S1)
//   zero IN OUT S0 S1        zero samples [S0,S1)
//   dc   IN OUT S0 S1 Q16    add Q16 over [S0,S1)
// Pinned znc, zero RNG, deterministic.
fn cstr(s:[]u8) []u8 {
    if (s.len < 1 || s.len > 4095) { return ""; }
    let p:*u8 = _zag_malloc((s.len + 1) as i64) as *u8;
    if (p == null as *u8) { return ""; }
    let b:[]u8 = p[0..(s.len + 1)];
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn fread(path:[]u8, cap:i64) []u8 {
    let cs:[]u8 = cstr(path);
    if (cs.len == 0) { return ""; }
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 0, 0, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return ""; }
    let p:*u8 = _zag_malloc(cap) as *u8;
    if (p == null as *u8) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return ""; }
    let at:i64 = 0;
    while (at < cap) {
        let n:i64 = _zag_raw_syscall(0, fd, (p as i64) + at, cap - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return p[0..at];
}
fn fwrite(path:[]u8, b:[]u8) i64 {
    let cs:[]u8 = cstr(path);
    if (cs.len == 0) { return -1; }
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 577, 438, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return -2; }
    let at:i64 = 0;
    let bl:i64 = b.len as i64;
    while (at < bl) {
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(b) as i64) + at, bl - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return -3; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return 0;
}
fn g32(b:[]u8, i:i64) i64 {
    return (b[i] as i64) | ((b[i+1] as i64) << 8) | ((b[i+2] as i64) << 16) | ((b[i+3] as i64) << 24);
}
fn p32(b:[]u8, i:i64, v:i64) void {
    b[i] = (v & 255) as u8;
    b[i+1] = ((v >> 8) & 255) as u8;
    b[i+2] = ((v >> 16) & 255) as u8;
    b[i+3] = ((v >> 24) & 255) as u8;
}
fn pout(s:[]u8) void {
    _zag_raw_syscall(1, 1, (_zag_slice_ptr(s) as i64), (s.len as i64), 0, 0, 0);
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if (s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn atoi(s:[]u8) i64 {
    let neg:i64 = 1;
    let v:i64 = 0;
    let i:i64 = 0;
    if (s.len > 0 && s[0] == 45) { neg = -1; i = 1; }
    while (i < s.len) {
        if (s[i] >= 48 && s[i] <= 57) { v = v * 10 + ((s[i] - 48) as i64); }
        i = i + 1;
    }
    return neg * v;
}
fn str_eq(a:[]u8, b:[]u8) i64 {
    if (a.len != b.len) { return 0; }
    let i:i64 = 0;
    while (i < a.len as i64) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    return 1;
}
fn main() i32 {
    let spec:[]u8 = _zag_arg(1);
    let inp:[]u8 = _zag_arg(2);
    let outp:[]u8 = _zag_arg(3);
    let b:[]u8 = fread(inp, 8000000);
    if (b.len == 0) { pout("FAULT read fail\n"); return 2; }
    let n:i64 = (b.len as i64) / 4;
    if (str_eq(spec, "bit")) {
        let s:i64 = atoi(_zag_arg(4));
        let bit:i64 = atoi(_zag_arg(5));
        if (s >= 0 && s < n && bit >= 0 && bit < 32) {
            // logical shift helper for u64 semantics on high bits
            let m:i64 = 1;
            let k:i64 = 0;
            while (k < bit) { m = m * 2; k = k + 1; }
            p32(b, s * 4, g32(b, s * 4) ^ m);
        }
    } else if (str_eq(spec, "xor")) {
        let s0:i64 = atoi(_zag_arg(4));
        let s1:i64 = atoi(_zag_arg(5));
        let mask:i64 = atoi(_zag_arg(6));
        if (s0 < 0) { s0 = 0; }
        if (s1 > n) { s1 = n; }
        let t:i64 = s0;
        while (t < s1) { p32(b, t * 4, g32(b, t * 4) ^ mask); t = t + 1; }
    } else if (str_eq(spec, "zero")) {
        let s0:i64 = atoi(_zag_arg(4));
        let s1:i64 = atoi(_zag_arg(5));
        if (s0 < 0) { s0 = 0; }
        if (s1 > n) { s1 = n; }
        let t:i64 = s0;
        while (t < s1) { p32(b, t * 4, 0); t = t + 1; }
    } else if (str_eq(spec, "dc")) {
        let s0:i64 = atoi(_zag_arg(4));
        let s1:i64 = atoi(_zag_arg(5));
        let q:i64 = atoi(_zag_arg(6));
        if (s0 < 0) { s0 = 0; }
        if (s1 > n) { s1 = n; }
        let t:i64 = s0;
        while (t < s1) { p32(b, t * 4, g32(b, t * 4) + q); t = t + 1; }
    } else {
        pout("usage: fault bit|xor|zero|dc IN OUT ...\n");
        return 1;
    }
    let rc:i64 = fwrite(outp, b);
    pout("FAULT spec=");
    pout(spec);
    pout(" rc=");
    pout(i64s(rc));
    pout("\n");
    return 0;
}

// q1_driver.zag — Q1 experiment driver: does a PLANTED knowledge model
// teach an UNPLANTED knowledge model?
//
// TEACHER: Track 5 arm-A machinery — q1_teacher_build(): a T5Store with 240
// trainer-planted Zharovia facts, learn-gate set. It emits frozen §B.3
// §P proposals (teacher_id=6).
//
// LEARNER: fresh arm-B-style learned-only TNN — empty T5Store at t0
// (fresh-audited), 8-example scaffold (trainer directives, verified by the
// learner's own observation), deliberate adds, learner-initiated
// SIGNAL_DISCONNECT; then 8 teaching slices of 24 facts with the frozen
// §B.7 flaw schedule (flaw-first: the flaw battery is zero-shot within the
// slice; the clean teaching of the same facts follows immediately after).
//
// SCORING: the sealed Track-B flaw scorer (tb_flaw_score) per slice:
// expected verdict + expected reason = hit; bar >= 10/12 raw hits.
// Plus: §C tripwire per slice, mastery recall per slice and final,
// byte-built sealed path + canary, state digests.
//
// Pure Zag, zero RNG. Deterministic: the binary's stdout must be
// byte-identical across reruns (verified by the run script, N=5).
@import("q1_types.zag")
@import("q1_proposal.zag")
@import("q1_tape.zag")
@import("q1_tripwire.zag")
@import("q1_flawscore.zag")
@import("t5_core.zag")
@import("q1_world.zag")
@import("q1_learner.zag")

// explicit byte-built sealed path + canary (no literal-coercion ambiguity)
// "q1/sealed/manifest"
fn q1_sealedpath()[]u8 {
    let b:[]u8=nio_alloc(18);
    b[0]=113 as u8; b[1]=49 as u8; b[2]=47 as u8; b[3]=115 as u8;
    b[4]=101 as u8; b[5]=97 as u8; b[6]=108 as u8; b[7]=101 as u8;
    b[8]=100 as u8; b[9]=47 as u8; b[10]=109 as u8; b[11]=97 as u8;
    b[12]=110 as u8; b[13]=105 as u8; b[14]=102 as u8; b[15]=101 as u8;
    b[16]=115 as u8; b[17]=116 as u8;
    return b;
}
// "Q1C:9f2c"
fn q1_canary()[]u8 {
    let b:[]u8=nio_alloc(8);
    b[0]=81 as u8; b[1]=49 as u8; b[2]=67 as u8; b[3]=58 as u8;
    b[4]=57 as u8; b[5]=102 as u8; b[6]=50 as u8; b[7]=99 as u8;
    return b;
}

// fresh-store audit: n==0 and no fact id 0..239 is present (no inherited
// state). Implemented via t5_slot_find (same-file field access inside
// t5_core) — the driver never touches T5Store lanes cross-file.
fn q1_audit_empty(s:*T5Store)i32 {
    if(s.*.n!=0){return 0;}
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){return 0;}
        id=id+1;
    }
    return 1;
}

// recall check via t5_claim_of (same-file lane access inside t5_core).
fn q1_recall_ok(s:*T5Store,fid:i32)i32 {
    if(t5_slot_find(s,fid)<0){return 0;}
    if(t5_claim_of(s,fid)==t5_truth(fid)){return 1;}
    return 0;
}

// hex print of a digest
fn q1_hex(b:[]u8)void {
    let i:i32=0;
    while(i<b.len){
        let v:i64=(b[i] as i64)&255;
        let hi:i64=(v>>4)&15;
        let lo:i64=v&15;
        let hc:u8=(48+hi) as u8;
        if(hi>9){hc=(87+hi) as u8;}
        let lc:u8=(48+lo) as u8;
        if(lo>9){lc=(87+lo) as u8;}
        let tmp:[]u8=nio_alloc(2);
        tmp[0]=hc; tmp[1]=lc;
        _zag_print(tmp);
        nio_free(tmp);
        i=i+1;
    }
    return;
}

// canonical state digest: sha256 over (fid,claim) pairs in ascending fid
// order (slot-layout independent). Lane reads go through t5_claim_of
// (same-file access inside t5_core).
fn q1_state_digest(s:*T5Store)[]u8 {
    let n:i32=s.*.n;
    let img:[]u8=nio_alloc(n*8+8);
    let w:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            tb_put32(img,w*8,id as i64);
            tb_put32(img,w*8+4,t5_claim_of(s,id) as i64);
            w=w+1;
        }
        id=id+1;
    }
    let d:[]u8=nio_alloc(32);
    let h:[]u8=img[0..w*8];
    ns_sha256(h,d);
    nio_free(img);
    return d;
}

fn main()i32 {
    let fails:i32=0;

    // ================= TEACHER: planted model (Track 5 arm-A) =================
    let teacher:T5Store=q1_teacher_build();
    fails=fails+cl_check("q1_teacher_planted_n",teacher.n,240);
    fails=fails+cl_check("q1_teacher_learn_gate",teacher.learn_gate,1);
    // the teacher holds false plants (12); id 29 is one — the curriculum
    // never teaches them (arm-A would hold, not revise: suspensive).
    fails=fails+cl_check("q1_teacher_falseplant_29",
        (t5_plant_claim(29)!=t5_truth(29)) as i32,1);
    fails=fails+cl_check("q1_teacher_falseplant_count",q1_n_false_plants(),12);
    // the teacher can teach every curriculum fact (planted-slot lookup)
    let ch:i32=0;
    let cs:i32=0;
    while(cs<8){
        let ck:i32=0;
        while(ck<24){
            if(t5_slot_find(&teacher,q1_slice_fact(cs,ck))<0){ch=ch+1;}
            ck=ck+1;
        }
        cs=cs+1;
    }
    fails=fails+cl_check("q1_teacher_holds_curriculum",ch,0);

    // ================= LEARNER: fresh, empty at t0 =================
    let store:T5Store=t5_init(512,32768);
    fails=fails+cl_check("q1_learner_t0_empty_n",store.n,0);
    fails=fails+cl_check("q1_learner_t0_audit_empty",q1_audit_empty(&store),1);
    let spans:Q1SpanMap=q1_spanmap_init(256);

    // ================= machinery self-tests (prove the gates are live) =================
    // t5_verify kills a disagreeing leg (eliminative core is real)
    let ev0:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev0,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev0,7,999,T5_EV_DIRECTIVE,2,-1);
    fails=fails+cl_check("q1_verify_kills_disagreement",t5_verify(&store,&ev0,2),0);
    q1_ev_free(&ev0);
    // t5_verify accepts agreeing legs (teacher + own observation)
    let ev1:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev1,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev1,7,100,Q1_EV_TEACHER,2,-1);
    fails=fails+cl_check("q1_verify_accepts_agreement",t5_verify(&store,&ev1,2),1);
    q1_ev_free(&ev1);
    // the world decodes: a placed record reads back
    let wstim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let wocc:[]u8=nio_alloc(Q1_NSLOTS);
    let woff:[]u8=nio_alloc(8);
    let wpl:i32=q1_build_stimulus(9,192,1,wstim,wocc,woff);
    fails=fails+cl_check("q1_world_placed",wpl,3);
    let wf0:i32=q1_scaffold_fact(0);
    let wo0:i32=tb_i64_get(woff,0) as i32;
    fails=fails+cl_check("q1_world_decode_fid",tb_get32(wstim,wo0) as i32,wf0);
    fails=fails+cl_check("q1_world_decode_val",tb_get32(wstim,wo0+4) as i32,t5_truth(wf0));
    // a 1-byte shift breaks 16-alignment (the wrong-span signal is real)
    fails=fails+cl_check("q1_shift_breaks_alignment",((wo0+1)%16==0) as i32,0);
    nio_free(wstim); nio_free(wocc); nio_free(woff);

    // ================= SCAFFOLD-AND-RELEASE =================
    let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ:[]u8=nio_alloc(Q1_NSLOTS);
    let offtab:[]u8=nio_alloc(8*3*8);
    let placed:i32=q1_build_stimulus(9,192,8,stim,occ,offtab);
    fails=fails+cl_check("q1_scaffold_placed",placed,24);
    let ex_fid:[]u8=nio_alloc(32);
    let ex_off:[]u8=nio_alloc(32);
    let ek:i32=0;
    while(ek<8){
        t5_s(ex_fid,ek*4,q1_scaffold_fact(ek));
        t5_s(ex_off,ek*4,tb_i64_get(offtab,(ek*3+0)*8) as i32);
        ek=ek+1;
    }
    let tape:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&tape,512,16384,2048);
    let added:i32=q1_scaffold(&store,&spans,&tape,stim,ex_fid,ex_off,8);
    fails=fails+cl_check("q1_scaffold_added",added,8);
    fails=fails+cl_check("q1_disconnect_audited",
        t5_audit_op_n(&store,T5_OP_DISCONNECT),1);
    // retention after release: scaffold knowledge persists without scaffold
    let ret:i32=0;
    ek=0;
    while(ek<8){
        if(q1_recall_ok(&store,q1_scaffold_fact(ek))==1){ret=ret+1;}
        ek=ek+1;
    }
    fails=fails+cl_check("q1_post_disconnect_retention",ret,8);
    nio_free(stim); nio_free(occ); nio_free(offtab);
    nio_free(ex_fid); nio_free(ex_off);

    // ================= 8 TEACHING SLICES =================
    let total_hits:i32=0;
    let total_pass:i32=0;
    let total_clean_adopted:i32=0;
    let s:i32=0;
    while(s<8){
        let stim2:[]u8=nio_alloc(Q1_TAPE_LEN);
        let occ2:[]u8=nio_alloc(Q1_NSLOTS);
        let ot2:[]u8=nio_alloc(24*3*8);
        let pl2:i32=q1_build_stimulus(s,s*24,24,stim2,occ2,ot2);
        fails=fails+cl_check("q1_slice_stim_placed",pl2,72);
        let t2:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        tb_tape_init(&t2,1024,65536,2048);
        let sess:TbSess=TbSess{.sess_id=(1000+s) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.evil=0,.n_props=0};
        let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpv=nio_alloc(0),.mexpr=nio_alloc(0),.mi=0};
        q1_mctx_init(&mctx);
        let seq:i64=1;
        let adopts:i32=0;
        let emit_bad:i32=0;
        let k:i32=0;
        while(k<24){
            if(k<12){
                // FLAW-FIRST: the flaw battery is zero-shot within the slice
                let er:i32=q1_emit_flaw(&t2,s,(1000+s) as i64,seq,k,
                                        q1_slice_fact(s,k),ot2,k,occ2,&mctx);
                if(er<0){emit_bad=emit_bad+1;}
                q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
                seq=seq+1;
            }
            let ec:i32=q1_emit_clean(&t2,(1000+s) as i64,seq,ot2,k);
            if(ec<0){emit_bad=emit_bad+1;}
            let vc:i32=q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
            if(vc==TB_V_ADOPT){adopts=adopts+1;}
            seq=seq+1;
            k=k+1;
        }
        fails=fails+cl_check("q1_slice_emit_ok",emit_bad,0);
        fails=fails+cl_check("q1_slice_manifest_n",mctx.mi,12);
        // §C tripwire: must not fire on the teaching tape
        let tw:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t2,Q1_TAPE_LEN as i64,&tw);
        fails=fails+cl_check("q1_slice_tripwire_fired",tw.fired,0);
        // SEALED flaw scoring (manifest instantiated after the session)
        let sp:[]u8=q1_sealedpath();
        let cn:[]u8=q1_canary();
        let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
        fails=fails+cl_check("q1_slice_manifest_init",tb_manifest_init(&m,12,sp,cn),0);
        let mi2:i32=0;
        while(mi2<12){
            tb_manifest_set(&m,mi2,
                tb_i64_get(mctx.mseq,mi2*8),
                tb_i64_get(mctx.mft,mi2*8),
                tb_i64_get(mctx.mexpv,mi2*8),
                tb_i64_get(mctx.mexpr,mi2*8));
            mi2=mi2+1;
        }
        let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
        tb_flaw_score(&t2,&m,TB_FP_W_DEFAULT_X10,&fo);
        fails=fails+cl_check("q1_slice_leak",fo.leak,0);
        fails=fails+cl_check("q1_slice_hnm12",fo.hits+fo.nears+fo.misses,12);
        // mastery: all 24 slice facts recallable with true values
        let mh:i32=0;
        let mk:i32=0;
        while(mk<24){
            if(q1_recall_ok(&store,q1_slice_fact(s,mk))==1){mh=mh+1;}
            mk=mk+1;
        }
        _zag_print("Q1_SLICE,");
        cl_number(s as i64); _zag_print(",");
        cl_number(fo.hits as i64); _zag_print(",");
        cl_number(fo.nears as i64); _zag_print(",");
        cl_number(fo.misses as i64); _zag_print(",");
        cl_number(fo.score_x10 as i64); _zag_print(",");
        cl_number(fo.pass as i64); _zag_print(",");
        cl_number(adopts as i64); _zag_print(",");
        cl_number(mh as i64); _zag_print(",");
        cl_number(tw.fired as i64);
        _zag_println("");
        total_hits=total_hits+fo.hits;
        if(fo.hits>=10){total_pass=total_pass+1;}
        total_clean_adopted=total_clean_adopted+adopts;
        nio_free(stim2); nio_free(occ2); nio_free(ot2);
        q1_mctx_free(&mctx);
        tb_manifest_free(&m);
        nio_free(sp); nio_free(cn);
        s=s+1;
    }

    // ================= FINAL MASTERY + STATE =================
    let fm:i32=0;
    let fs:i32=0;
    while(fs<8){
        let fk:i32=0;
        while(fk<24){
            if(q1_recall_ok(&store,q1_slice_fact(fs,fk))==1){fm=fm+1;}
            fk=fk+1;
        }
        fs=fs+1;
    }
    fails=fails+cl_check("q1_final_mastery_192",fm,192);
    let sm:i32=0;
    let sk:i32=0;
    while(sk<8){
        if(q1_recall_ok(&store,q1_scaffold_fact(sk))==1){sm=sm+1;}
        sk=sk+1;
    }
    fails=fails+cl_check("q1_scaffold_retained",sm,8);
    fails=fails+cl_check("q1_store_n",store.n,200);

    _zag_print("Q1_RUN,");
    cl_number(total_hits as i64); _zag_print(",");
    cl_number(total_pass as i64); _zag_print(",");
    cl_number(total_clean_adopted as i64); _zag_print(",");
    cl_number(fm as i64); _zag_print(",");
    cl_number(fails as i64);
    _zag_println("");
    _zag_print("Q1_DIGEST,learner,");
    let dl:[]u8=q1_state_digest(&store);
    q1_hex(dl);
    _zag_println("");
    _zag_print("Q1_DIGEST,teacher,");
    let dt:[]u8=q1_state_digest(&teacher);
    q1_hex(dt);
    _zag_println("");
    nio_free(dl); nio_free(dt);
    q1_spanmap_free(&spans);
    if(fails==0){
        _zag_println("Q1_COMPLETE");
    }
    else{
        _zag_println("Q1_FAIL");
    }
    return fails;
}

// tnn_diag.zag — TNN AS IMAGE-ISSUE DIAGNOSTICIAN (Micah order 2026-09-26).
//
// The crew trains; TNN diagnoses. Training corpus: patterns.dat (diagnostic
// patterns extracted from committed evidence: upscale rectangle diagnosis
// f67e9893, generation audit dee44ecb6f8b, pig-front 22px find ce15343fb955).
// TNN's intake reads the corpus, VALIDATES each pattern by recomputing its key
// quantitative claim, and builds a symptom index. Then TNN is presented with
// open issues (I1-I3) and novel held-out issues (N1-N4) and must, in its own
// computed logic: score every learned pattern against each issue's measured
// anomalies (explanatory gain), select the best-supported diagnosis, instantiate
// the fix direction, or honestly output NO PATTERN FITS when nothing explains
// the symptoms. Every score is computed; the trace records all of them.
//
// Pure Zag. Zero RNG. Byte-identical reruns. Commits to tnn-native-lab, NEVER main.
// Pinned toolchain: ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1
@import("R33_NATIVE_IO_V1.zag")

// ---------------- u64/i64 LE helpers ([]u8 arenas; no narrow casts) ----
fn h_put64(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    b[o + 4] = ((v >> 32) & 255) as u8;
    b[o + 5] = ((v >> 40) & 255) as u8;
    b[o + 6] = ((v >> 48) & 255) as u8;
    b[o + 7] = ((v >> 56) & 255) as u8;
    return;
}
fn h_get64(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    v = v + (b[o + 4] as i64) * 4294967296 + (b[o + 5] as i64) * 1099511627776;
    v = v + (b[o + 6] as i64) * 281474976710656 + (b[o + 7] as i64) * 72057594037927936;
    return v;
}
// ---------------- trace builder (append-only text arena) ----------------
fn tr_init(cap:i64) []u8 {
    let t:[]u8 = nio_alloc(cap as i32);
    h_put64(t, 0, 0);
    return t;
}
fn tr_pos(t:[]u8) i64 { return h_get64(t, 0); }
fn tr_get(t:[]u8) []u8 {
    let p:i64 = tr_pos(t);
    return t[16..16 + p];
}
fn tr_str(t:[]u8, s:[]u8) void {
    let p:i64 = tr_pos(t);
    let i:i64 = 0;
    while (i < s.len) { t[16 + p + i] = s[i]; i = i + 1; }
    h_put64(t, 0, p + s.len);
    return;
}
fn tr_i64(t:[]u8, v:i64) void {
    let neg:i64 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    if (u == 0) { tmp[0] = 48; n = 1; }
    while (u > 0) { tmp[n] = (48 + (u % 10)) as u8; u = u / 10; n = n + 1; }
    if (neg == 1) { tr_str(t, "-"); }
    let i:i64 = 0;
    while (i < n) {
        let one:[]u8 = nio_alloc(1);
        one[0] = tmp[n - 1 - i];
        tr_str(t, one);
        nio_free(one);
        i = i + 1;
    }
    nio_free(tmp);
    return;
}
fn tr_nl(t:[]u8) void { tr_str(t, "\n"); return; }
// ---------------- file IO ----------------
fn read_file(root:i64, name:[]u8, b:[]u8, maxn:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let n:i64 = nio_read_exact(fd, b, maxn as i32);
    nio_close(fd);
    return n;
}
fn write_file_all(root:i64, name:[]u8, b:[]u8, n:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 1);
    if (fd < 0) { return -1; }
    let done:i64 = 0;
    while (done < n) {
        let c:i64 = n - done;
        if (c > 1048576) { c = 1048576; }
        let part:[]u8 = b[done..done + c];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != c) { nio_close(fd); return -2; }
        done = done + c;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}
// ---------------- string pool ----------------
// pool: bytes; ppos: []u8 holding one i64 (current end offset).
fn pool_add(pool:[]u8, ppos:[]u8, s:[]u8, slen:i64) i64 {
    let off:i64 = h_get64(ppos, 0);
    let i:i64 = 0;
    while (i < slen) { pool[off + i] = s[i]; i = i + 1; }
    h_put64(ppos, 0, off + slen);
    return off;
}
fn pool_slice(pool:[]u8, off:i64, len:i64) []u8 {
    return pool[off..off + len];
}
// ---------------- parsing ----------------
fn parse_i64(s:[]u8, start:i64, end:i64) i64 {
    let v:i64 = 0;
    let neg:i64 = 0;
    let i:i64 = start;
    if (i < end) {
        if (s[i] == 45) { neg = 1; i = i + 1; }
    }
    while (i < end) {
        let c:i64 = s[i] as i64;
        if (c >= 48) {
            if (c <= 57) { v = v * 10 + (c - 48); }
        }
        i = i + 1;
    }
    if (neg == 1) { v = 0 - v; }
    return v;
}
fn find_byte(s:[]u8, start:i64, end:i64, b:u8) i64 {
    let i:i64 = start;
    while (i < end) {
        if (s[i] == b) { return i; }
        i = i + 1;
    }
    return -1;
}
fn is_blank_line(s:[]u8, start:i64, end:i64) i64 {
    let i:i64 = start;
    while (i < end) {
        let c:i64 = s[i] as i64;
        if (c == 32) { i = i + 1; } else {
            if (c == 9) { i = i + 1; } else {
                if (c == 13) { i = i + 1; } else { return 0; }
            }
        }
    }
    return 1;
}

// ---------------- pattern learning ----------------
// ptab: []i64, 16 rows x 12 cols. psyms: []i64, 16x8 symptom codes.
// Returns number of patterns learned. Each pattern's key quantitative claim
// is RECOMPUTED (not trusted); failures are recorded and the pattern is
// marked invalid (valid=0) so diagnosis never uses it.
fn learn_patterns(t:[]u8, buf:[]u8, n:i64, pool:[]u8, ppos:[]u8, ptab:[]i64, psyms:[]i64) i64 {
    let npat:i64 = 0;
    let ls:i64 = 0;
    while (ls < n) {
        let le:i64 = find_byte(buf, ls, n, 10);
        if (le < 0) { le = n; }
        let skip:i64 = 0;
        if (is_blank_line(buf, ls, le) == 1) { skip = 1; }
        if (skip == 0) {
            if (buf[ls] == 35) { skip = 1; }
        }
        if (skip == 0) {
            if (npat >= 16) { tr_str(t, "LEARN-ERROR: too many patterns\n"); return -1; }
            // split into 8 fields by '|'
            let f0s:i64 = ls;
            let f0e:i64 = find_byte(buf, f0s, le, 124);
            let f1s:i64 = f0e + 1;
            let f1e:i64 = find_byte(buf, f1s, le, 124);
            let f2s:i64 = f1e + 1;
            let f2e:i64 = find_byte(buf, f2s, le, 124);
            let f3s:i64 = f2e + 1;
            let f3e:i64 = find_byte(buf, f3s, le, 124);
            let f4s:i64 = f3e + 1;
            let f4e:i64 = find_byte(buf, f4s, le, 124);
            let f5s:i64 = f4e + 1;
            let f5e:i64 = find_byte(buf, f5s, le, 124);
            let f6s:i64 = f5e + 1;
            let f6e:i64 = find_byte(buf, f6s, le, 124);
            let f7s:i64 = f6e + 1;
            let f7e:i64 = le;
            if (f0e < 0) { tr_str(t, "LEARN-ERROR: bad pattern line\n"); return -2; }
            if (f1e < 0) { tr_str(t, "LEARN-ERROR: bad pattern line\n"); return -2; }
            if (f2e < 0) { tr_str(t, "LEARN-ERROR: bad pattern line\n"); return -2; }
            if (f3e < 0) { tr_str(t, "LEARN-ERROR: bad pattern line\n"); return -2; }
            if (f4e < 0) { tr_str(t, "LEARN-ERROR: bad pattern line\n"); return -2; }
            if (f5e < 0) { tr_str(t, "LEARN-ERROR: bad pattern line\n"); return -2; }
            if (f6e < 0) { tr_str(t, "LEARN-ERROR: bad pattern line\n"); return -2; }
            let base:i64 = npat * 12;
            ptab[base + 0] = pool_add(pool, ppos, buf[f0s..f0e], f0e - f0s);
            ptab[base + 1] = f0e - f0s;
            ptab[base + 2] = pool_add(pool, ppos, buf[f1s..f1e], f1e - f1s);
            ptab[base + 3] = f1e - f1s;
            // symptoms: comma-separated ints
            let ns:i64 = 0;
            let ss:i64 = f2s;
            while (ss < f2e) {
                let ce:i64 = find_byte(buf, ss, f2e, 44);
                if (ce < 0) { ce = f2e; }
                if (ns < 8) {
                    psyms[npat * 8 + ns] = parse_i64(buf, ss, ce);
                    ns = ns + 1;
                }
                ss = ce + 1;
            }
            ptab[base + 4] = ns;
            ptab[base + 5] = parse_i64(buf, f3s, f3e);
            ptab[base + 6] = parse_i64(buf, f4s, f4e);
            ptab[base + 7] = parse_i64(buf, f5s, f5e);
            ptab[base + 8] = parse_i64(buf, f6s, f6e);
            ptab[base + 9] = pool_add(pool, ppos, buf[f7s..f7e], f7e - f7s);
            ptab[base + 10] = f7e - f7s;
            // VALIDATE: recompute the key quantitative claim
            let op:i64 = ptab[base + 5];
            let a:i64 = ptab[base + 6];
            let b:i64 = ptab[base + 7];
            let c:i64 = ptab[base + 8];
            let ok:i64 = 0;
            if (op == 1) {
                let d:i64 = a - b;
                if (d < 0) { d = 0 - d; }
                if (d == c) { ok = 1; }
            } else {
                if (op == 2) {
                    if (a > b) { ok = 1; }
                } else {
                    if (op == 3) {
                        if (a < b) { ok = 1; }
                    } else {
                        if (op == 4) {
                            if (a == b) { ok = 1; }
                        }
                    }
                }
            }
            ptab[base + 11] = ok;
            tr_str(t, "LEARNED ");
            tr_str(t, pool_slice(pool, ptab[base + 0], ptab[base + 1]));
            tr_str(t, " ");
            tr_str(t, pool_slice(pool, ptab[base + 2], ptab[base + 3]));
            tr_str(t, " nsym=");
            tr_i64(t, ns);
            tr_str(t, " check=");
            if (ok == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
            tr_nl(t);
            npat = npat + 1;
        }
        ls = le + 1;
    }
    return npat;
}

// ---------------- issue intake ----------------
// itab: []i64, 16 rows x 8 cols. iasyms/iasev: []i64, 16x8.
fn learn_issues(t:[]u8, buf:[]u8, n:i64, pool:[]u8, ppos:[]u8, itab:[]i64, iasyms:[]i64, iasev:[]i64) i64 {
    let niss:i64 = 0;
    let ls:i64 = 0;
    while (ls < n) {
        let le:i64 = find_byte(buf, ls, n, 10);
        if (le < 0) { le = n; }
        let skip:i64 = 0;
        if (is_blank_line(buf, ls, le) == 1) { skip = 1; }
        if (skip == 0) {
            if (buf[ls] == 35) { skip = 1; }
        }
        if (skip == 0) {
            if (niss >= 16) { tr_str(t, "ISSUE-ERROR: too many issues\n"); return -1; }
            let f0s:i64 = ls;
            let f0e:i64 = find_byte(buf, f0s, le, 124);
            let f1s:i64 = f0e + 1;
            let f1e:i64 = find_byte(buf, f1s, le, 124);
            let f2s:i64 = f1e + 1;
            let f2e:i64 = find_byte(buf, f2s, le, 124);
            let f3s:i64 = f2e + 1;
            let f3e:i64 = le;
            if (f0e < 0) { tr_str(t, "ISSUE-ERROR: bad issue line\n"); return -2; }
            if (f1e < 0) { tr_str(t, "ISSUE-ERROR: bad issue line\n"); return -2; }
            if (f2e < 0) { tr_str(t, "ISSUE-ERROR: bad issue line\n"); return -2; }
            let base:i64 = niss * 8;
            itab[base + 0] = pool_add(pool, ppos, buf[f0s..f0e], f0e - f0s);
            itab[base + 1] = f0e - f0s;
            itab[base + 2] = pool_add(pool, ppos, buf[f1s..f1e], f1e - f1s);
            itab[base + 3] = f1e - f1s;
            // anomalies: sym:sev comma-separated
            let na:i64 = 0;
            let ss:i64 = f2s;
            while (ss < f2e) {
                let ce:i64 = find_byte(buf, ss, f2e, 44);
                if (ce < 0) { ce = f2e; }
                let co:i64 = find_byte(buf, ss, ce, 58);
                if (co > 0) {
                    if (na < 8) {
                        iasyms[niss * 8 + na] = parse_i64(buf, ss, co);
                        iasev[niss * 8 + na] = parse_i64(buf, co + 1, ce);
                        na = na + 1;
                    }
                }
                ss = ce + 1;
            }
            itab[base + 4] = na;
            itab[base + 5] = pool_add(pool, ppos, buf[f3s..f3e], f3e - f3s);
            itab[base + 6] = f3e - f3s;
            tr_str(t, "ISSUE ");
            tr_str(t, pool_slice(pool, itab[base + 0], itab[base + 1]));
            tr_str(t, " ");
            tr_str(t, pool_slice(pool, itab[base + 2], itab[base + 3]));
            tr_str(t, " nanoms=");
            tr_i64(t, na);
            tr_nl(t);
            niss = niss + 1;
        }
        ls = le + 1;
    }
    return niss;
}
// ---------------- diagnosis ----------------
// Explanatory gain: for issue i and pattern p,
//   gain = sum of severities of i's anomalies whose symptom code is in p's set.
// Select argmax over VALID patterns. If best*2 < total severity, abstain.
fn pat_has_sym(psyms:[]i64, p:i64, nsym:i64, sym:i64) i64 {
    let j:i64 = 0;
    while (j < nsym) {
        if (psyms[p * 8 + j] == sym) { return 1; }
        j = j + 1;
    }
    return 0;
}
fn diagnose(t:[]u8, pool:[]u8, ptab:[]i64, psyms:[]i64, npat:i64, itab:[]i64, iasyms:[]i64, iasev:[]i64, niss:i64) i64 {
    let i:i64 = 0;
    while (i < niss) {
        let ibase:i64 = i * 8;
        let na:i64 = itab[ibase + 4];
        tr_nl(t);
        tr_str(t, "=== DIAGNOSE ");
        tr_str(t, pool_slice(pool, itab[ibase + 0], itab[ibase + 1]));
        tr_str(t, " ");
        tr_str(t, pool_slice(pool, itab[ibase + 2], itab[ibase + 3]));
        tr_nl(t);
        tr_str(t, "Q: ");
        tr_str(t, pool_slice(pool, itab[ibase + 5], itab[ibase + 6]));
        tr_nl(t);
        // total severity
        let tot:i64 = 0;
        let k:i64 = 0;
        while (k < na) { tot = tot + iasev[i * 8 + k]; k = k + 1; }
        tr_str(t, "total_severity=");
        tr_i64(t, tot);
        tr_nl(t);
        // score every valid pattern
        let best:i64 = -1;
        let best_gain:i64 = -1;
        let second:i64 = -1;
        let second_gain:i64 = -1;
        let p:i64 = 0;
        while (p < npat) {
            let pbase:i64 = p * 12;
            if (ptab[pbase + 11] == 1) {
                let nsym:i64 = ptab[pbase + 4];
                let gain:i64 = 0;
                let a2:i64 = 0;
                while (a2 < na) {
                    let sym:i64 = iasyms[i * 8 + a2];
                    let sev:i64 = iasev[i * 8 + a2];
                    if (pat_has_sym(psyms, p, nsym, sym) == 1) { gain = gain + sev; }
                    a2 = a2 + 1;
                }
                tr_str(t, "  gain[");
                tr_str(t, pool_slice(pool, ptab[pbase + 0], ptab[pbase + 1]));
                tr_str(t, "]=");
                tr_i64(t, gain);
                tr_nl(t);
                if (gain > best_gain) {
                    second = best;
                    second_gain = best_gain;
                    best = p;
                    best_gain = gain;
                } else {
                    if (gain > second_gain) {
                        second = p;
                        second_gain = gain;
                    }
                }
            }
            p = p + 1;
        }
        // abstention bar: best must explain at least half the severity
        if (best_gain * 2 < tot) {
            tr_str(t, "VERDICT: NO PATTERN FITS (best_gain=");
            tr_i64(t, best_gain);
            tr_str(t, " < half of ");
            tr_i64(t, tot);
            tr_str(t, "). TNN withholds diagnosis.");
            tr_nl(t);
        } else {
            let bbase:i64 = best * 12;
            let conf:i64 = 0;
            if (tot > 0) { conf = best_gain * 100 / tot; }
            tr_str(t, "VERDICT: ");
            tr_str(t, pool_slice(pool, ptab[bbase + 0], ptab[bbase + 1]));
            tr_str(t, " ");
            tr_str(t, pool_slice(pool, ptab[bbase + 2], ptab[bbase + 3]));
            tr_str(t, " gain=");
            tr_i64(t, best_gain);
            tr_str(t, " confidence=");
            tr_i64(t, conf);
            tr_str(t, "%");
            tr_nl(t);
            if (second >= 0) {
                let sbase:i64 = second * 12;
                tr_str(t, "runner_up: ");
                tr_str(t, pool_slice(pool, ptab[sbase + 0], ptab[sbase + 1]));
                tr_str(t, " gain=");
                tr_i64(t, second_gain);
                tr_nl(t);
            }
            // supporting evidence: the overlapping anomalies
            tr_str(t, "supporting_anomalies:");
            let nsym2:i64 = ptab[bbase + 4];
            let a3:i64 = 0;
            while (a3 < na) {
                let sym2:i64 = iasyms[i * 8 + a3];
                if (pat_has_sym(psyms, best, nsym2, sym2) == 1) {
                    tr_str(t, " s");
                    tr_i64(t, sym2);
                    tr_str(t, "(sev");
                    tr_i64(t, iasev[i * 8 + a3]);
                    tr_str(t, ")");
                }
                a3 = a3 + 1;
            }
            tr_nl(t);
            tr_str(t, "FIX-DIRECTION: ");
            tr_str(t, pool_slice(pool, ptab[bbase + 9], ptab[bbase + 10]));
            tr_nl(t);
        }
        i = i + 1;
    }
    return 0;
}

// ---------------- main ----------------
fn main() i64 {
    let dat_dir:[]u8 = _zag_arg(1);
    let out_dir:[]u8 = _zag_arg(2);
    if (dat_dir.len == 0) { return 10; }
    if (out_dir.len == 0) { return 11; }
    let t:[]u8 = tr_init(4194304);
    let pool:[]u8 = nio_alloc(65536);
    let ppos:[]u8 = nio_alloc(16);
    h_put64(ppos, 0, 0);
    tr_str(t, "TNN-AS-DIAGNOSTICIAN\n");
    tr_str(t, "PHASE 1: TRAINING (intake + validation)\n");
    // tables
    let ptab:[]i64 = nio_alloc(16 * 12 * 8) as []i64;
    let psyms:[]i64 = nio_alloc(16 * 8 * 8) as []i64;
    let itab:[]i64 = nio_alloc(16 * 8 * 8) as []i64;
    let iasyms:[]i64 = nio_alloc(16 * 8 * 8) as []i64;
    let iasev:[]i64 = nio_alloc(16 * 8 * 8) as []i64;
    // read patterns.dat
    let datroot:i64 = nio_open_root(dat_dir);
    if (datroot < 0) { tr_str(t, "FATAL: cannot open dat dir\n"); return 12; }
    let pbuf:[]u8 = nio_alloc(16384);
    let pn:i64 = read_file(datroot, "patterns.dat", pbuf, 16384);
    if (pn < 0) { tr_str(t, "FATAL: cannot read patterns.dat\n"); return 13; }
    let npat:i64 = learn_patterns(t, pbuf, pn, pool, ppos, ptab, psyms);
    if (npat < 0) { return 14; }
    tr_str(t, "patterns_learned=");
    tr_i64(t, npat);
    tr_nl(t);
    // count valid
    let nvalid:i64 = 0;
    let vi:i64 = 0;
    while (vi < npat) {
        if (ptab[vi * 12 + 11] == 1) { nvalid = nvalid + 1; }
        vi = vi + 1;
    }
    tr_str(t, "patterns_valid=");
    tr_i64(t, nvalid);
    tr_nl(t);
    // read issues.dat
    tr_str(t, "PHASE 2: ISSUE INTAKE\n");
    let ibuf:[]u8 = nio_alloc(16384);
    let inn:i64 = read_file(datroot, "issues.dat", ibuf, 16384);
    if (inn < 0) { tr_str(t, "FATAL: cannot read issues.dat\n"); return 15; }
    let niss:i64 = learn_issues(t, ibuf, inn, pool, ppos, itab, iasyms, iasev);
    if (niss < 0) { return 16; }
    tr_str(t, "issues_presented=");
    tr_i64(t, niss);
    tr_nl(t);
    nio_close(datroot);
    // diagnose
    tr_str(t, "PHASE 3: DIAGNOSIS (TNN's own explanatory-gain deliberation)\n");
    let drc:i64 = diagnose(t, pool, ptab, psyms, npat, itab, iasyms, iasev, niss);
    if (drc != 0) { return 17; }
    // write trace
    let outroot:i64 = nio_open_root(out_dir);
    if (outroot < 0) { return 18; }
    let wrc:i64 = write_file_all(outroot, "DIAG_TRACE.txt", tr_get(t), tr_pos(t));
    nio_close(outroot);
    nio_free(t);
    nio_free(pool);
    nio_free(ppos);
    nio_free(pbuf);
    nio_free(ibuf);
    return wrc;
}

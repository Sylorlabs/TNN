// battery1.zag — Phase-1 promotion test harness.
//
// Runs the frozen 24-question battery through the LIVE intake path
// (tnn_intake, the promoted deliberative chunker) plus the three retired
// fixed arms as negative controls. Bars for promotion:
//   LIVE 24/24 correct, 24/24 native (zero fallbacks),
//   byte-identical reruns x2, rebuild-from-source reproduces the run.
//
// The live path never touches negcontrol.zag's arms; this harness is a
// test, not the live path.
@import("./intake.zag")
@import("./negcontrol.zag")

fn b_summ_add(summ:[]u8, arm:i64, sk:i64, stats:i64) void {
    let correct:i64=stats & 1;
    let native:i64=(stats >> 1) & 1;
    let ops:i64=(stats >> 8) & 4294967295;
    let base:i64=((arm*7)+sk)*4*8;
    w_i64le(summ,base,r_i64le(summ,base)+1);
    w_i64le(summ,base+8,r_i64le(summ,base+8)+correct);
    w_i64le(summ,base+16,r_i64le(summ,base+16)+native);
    w_i64le(summ,base+24,r_i64le(summ,base+24)+ops);
    return;
}
fn b_arm_name(a:i64) []u8 {
    if (a==0) { return "LIVE"; }
    if (a==1) { return "NC-C"; }
    if (a==2) { return "NC-W"; }
    return "NC-S";
}

fn b_run_q(qid:i64, q:[]u8, t:[]u8, exp:[]u8,
            out:[]u8, at:i64, scr:[]u8,
            soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
            woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, summ:[]u8) i64 {
    let kind:i64=classify(q);
    at=ob_raw(out,at,"Q ");
    at=ob_i64(out,at,qid,scr);
    at=ob_raw(out,at," kind=");
    at=ob_raw(out,at,kind_name(kind));
    at=ob_raw(out,at," q=\"");
    at=ob_raw(out,at,q);
    at=ob_raw(out,at,"\" t=\"");
    at=ob_raw(out,at,t);
    at=ob_raw(out,at,"\" exp=\"");
    at=ob_raw(out,at,exp);
    at=ob_raw(out,at,"\"");
    at=ob_nl(out,at);
    let sk:i64=skind(kind);
    let av:i64=at;
    // LIVE PATH — the promoted intake organ. This is the bar under test.
    let st:i64=tnn_intake(qid,kind,q,t,exp,out,&av,scr,soff,slen,zlog,zn,woffs,wlens,revbuf,abuf);
    b_summ_add(summ,0,sk,st);
    // Negative controls (retired arms; not the live path).
    st=nc_c_answer(qid,nc_classify(q),q,t,exp,out,&av,scr,abuf,revbuf);
    b_summ_add(summ,1,sk,st);
    st=nc_w_answer(qid,nc_classify(q),q,t,exp,out,&av,scr,abuf,revbuf,woffs,wlens);
    b_summ_add(summ,2,sk,st);
    st=nc_s_answer(qid,nc_classify(q),q,t,exp,out,&av,scr,abuf,revbuf);
    b_summ_add(summ,3,sk,st);
    return av;
}

fn main() i32 {
    let out:[]u8=nio_alloc(524288);
    if (out.len==0) { return 1; }
    let scr:[]u8=nio_alloc(32);
    let soff:[]u8=nio_alloc(1024); let slen:[]u8=nio_alloc(1024);
    let zlog:[]u8=nio_alloc(14336);
    let woffs:[]u8=nio_alloc(256); let wlens:[]u8=nio_alloc(256);
    let revbuf:[]u8=nio_alloc(256); let abuf:[]u8=nio_alloc(64);
    let summ:[]u8=nio_alloc(4*7*4*8);
    let zi:i64=0;
    while (zi<4*7*4*8) { summ[zi]=0; zi=zi+1; }
    let at:i64=0;
    at=ob_raw(out,at,"# CHUNK-PROMOTE-RUN v1 live-intake + retired-arm controls");
    at=ob_nl(out,at);
    let zn:i64=0;
    at=b_run_q(0,"how many r's in strawberry","strawberry","3",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(1,"how many s's in Mississippi","Mississippi","4",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(2,"how many l's in hello world","hello world","3",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(3,"how many e's in cheese","cheese","3",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(4,"how many a's in abracadabra","abracadabra","5",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(5,"what is the 3rd letter of strawberry","strawberry","r",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(6,"what is the 1st letter of Mississippi","Mississippi","M",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(7,"what is the 10th letter of strawberry","strawberry","y",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(8,"spell strawberry backwards","strawberry","yrrebwarts",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(9,"spell abc backwards","abc","cba",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(10,"how many words in the quick brown fox","the quick brown fox","4",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(11,"how many words in hello","hello","1",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(12,"how many letters in strawberry","strawberry","10",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(13,"how many letters in ab","ab","2",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(14,"does the quick brown fox contain quick","the quick brown fox","yes",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(15,"what is the first word of the quick brown fox","the quick brown fox","the",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(16,"what is the last letter of Mississippi","Mississippi","i",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(17,"what is the first letter of hello world","hello world","h",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(18,"how many S's in Mississippi","Mississippi","0",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(19,"how many o's in bookkeeper","bookkeeper","2",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(20,"how many e's in the cheese wheel","the cheese wheel","6",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(21,"does strawberry contain raw","strawberry","yes",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(22,"what is the 2nd letter of fox","the quick brown fox","o",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=b_run_q(23,"how many r's in the strawberry patch","the strawberry patch","3",out,at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,summ);
    at=ob_raw(out,at,"# SUMMARY arm kind n correct native ops_total");
    at=ob_nl(out,at);
    let arm:i64=0;
    while (arm<4) {
        let sk:i64=0;
        while (sk<7) {
            let base:i64=((arm*7)+sk)*4*8;
            at=ob_raw(out,at,b_arm_name(arm));
            at=ob_raw(out,at," ");
            at=ob_raw(out,at,skind_name(sk));
            at=ob_raw(out,at," n=");
            at=ob_i64(out,at,r_i64le(summ,base),scr);
            at=ob_raw(out,at," correct=");
            at=ob_i64(out,at,r_i64le(summ,base+8),scr);
            at=ob_raw(out,at," native=");
            at=ob_i64(out,at,r_i64le(summ,base+16),scr);
            at=ob_raw(out,at," ops=");
            at=ob_i64(out,at,r_i64le(summ,base+24),scr);
            at=ob_nl(out,at);
            sk=sk+1;
        }
        arm=arm+1;
    }
    at=ob_raw(out,at,"# ZOOMS_TOTAL ");
    at=ob_i64(out,at,zn,scr);
    at=ob_nl(out,at);
    at=ob_raw(out,at,"# END");
    at=ob_nl(out,at);
    let used:[]u8=out[0..at];
    let w:i64=nio_write_all(1,used);
    if (w!=at) { return 1; }
    return 0;
}

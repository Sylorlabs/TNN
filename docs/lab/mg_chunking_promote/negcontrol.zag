// negcontrol.zag — RETIRED FIXED ARMS. NEGATIVE CONTROL ONLY.
//
// *** NOT PART OF THE LIVE PATH. ***
//
// Per Micah's ruling 2026-09-26 ~09:49 PDT the fixed chunking arms
// (C = fixed character chunks, W = fixed word chunks, S = fixed 4-byte
// spans) are RETIRED from TNN's text-intake path: on the q22 sub-span trap
// ("what is the 2nd letter of fox") C and S answered "h" — a different
// question than asked — and W only survived via a recorded sub-word
// fallback escape hatch (18 fallbacks across the battery).
//
// They are kept in the codebase for ONE purpose: as negative controls in
// test harnesses (battery1.zag, battery2.zag), proving the live path
// beats them and that their known failures persist. NEVER import this
// file from live intake code. NEVER call nc_c_answer / nc_w_answer /
// nc_s_answer from any production path.
//
// Behavior is FROZEN at the fork's arms (byte-for-byte semantics on the
// original 24 questions). The classifier is extended with the Phase-2
// nested kinds (10-17) so the controls run the expanded battery: the
// frozen arms cannot parse the nested forms and fail them, which is
// itself the documented control outcome (fixed arms cannot adapt).
@import("./R33_NATIVE_IO_V1.zag")

// ---------- little-endian accessors over []u8 arenas ----------
// (ZNC-2026-09-21-007: no `as []i32` casts; []u8 arenas + accessors)
fn nc_w_u32le(b:[]u8, o:i64, v:i64) void {
    b[o]=(v & 255) as u8;
    b[o+1]=((v >> 8) & 255) as u8;
    b[o+2]=((v >> 16) & 255) as u8;
    b[o+3]=((v >> 24) & 255) as u8;
}
fn nc_r_u32le(b:[]u8, o:i64) i64 {
    return (b[o] as i64)+((b[o+1] as i64) << 8)+((b[o+2] as i64) << 16)+((b[o+3] as i64) << 24);
}

// ---------- output buffer ----------
fn nc_ob_raw(out:[]u8, at:i64, s:[]u8) i64 {
    let i:i64=0;
    while (i<s.len) { out[at+i]=s[i]; i=i+1; }
    return at+s.len;
}
fn nc_ob_i64(out:[]u8, at:i64, v:i64, scr:[]u8) i64 {
    let x:i64=v;
    if (x<0) { out[at]=45; at=at+1; x=0-x; }
    let n:i64=0;
    if (x==0) { scr[0]=48; n=1; }
    while (x>0) { scr[n]=((x % 10)+48) as u8; x=x/10; n=n+1; }
    let i:i64=n-1;
    while (i>=0) { out[at]=scr[i]; at=at+1; i=i-1; }
    return at;
}
fn nc_ob_nl(out:[]u8, at:i64) i64 { out[at]=10; return at+1; }

// ---------- byte-string helpers (znc has no break; flag idiom) ----------
fn nc_find_sub(h:[]u8, n:[]u8) i64 {
    if (n.len==0) { return 0; }
    if (n.len>h.len) { return -1; }
    let i:i64=0; let hit:i64=-1;
    while (i+n.len<=h.len) {
        if (hit==-1) {
            let j:i64=0; let ok:i64=1;
            while (j<n.len) {
                if (h[i+j]!=n[j]) { ok=0; j=n.len; }
                else { j=j+1; }
            }
            if (ok==1) { hit=i; }
        }
        i=i+1;
    }
    return hit;
}
fn nc_has_sub(h:[]u8, n:[]u8) i64 {
    if (nc_find_sub(h,n)>=0) { return 1; }
    return 0;
}
fn nc_beq(a:[]u8, b:[]u8) i64 {
    if (nio_equal(a,b)==1) { return 1; }
    return 0;
}
fn nc_parse_digits(s:[]u8, at:i64) i64 {
    let v:i64=0; let i:i64=at; let go:i64=1;
    while (i<s.len) {
        if (go==1) {
            let c:i64=s[i] as i64;
            if (c>=48) {
                if (c<=57) { v=v*10+(c-48); i=i+1; }
                else { go=0; }
            }
            else { go=0; }
        }
        else { i=i+1; }
    }
    return v;
}

// ---------- chunk primitives ----------
fn nc_enum_words(t:[]u8, offs:[]u8, lens:[]u8) i64 {
    let n:i64=0; let i:i64=0; let L:i64=t.len; let inword:i64=0; let s:i64=0;
    while (i<L) {
        if (t[i]==32) {
            if (inword==1) {
                nc_w_u32le(offs,n*4,s); nc_w_u32le(lens,n*4,i-s); n=n+1; inword=0;
            }
        }
        else {
            if (inword==0) { s=i; inword=1; }
        }
        i=i+1;
    }
    if (inword==1) { nc_w_u32le(offs,n*4,s); nc_w_u32le(lens,n*4,i-s); n=n+1; }
    return n;
}
fn nc_scan_count(t:[]u8, o:i64, ln:i64, target:u8) i64 {
    let c:i64=0; let i:i64=o;
    while (i<o+ln) { if (t[i]==target) { c=c+1; } i=i+1; }
    return c;
}
fn nc_count_words_bytes(t:[]u8) i64 {
    let n:i64=0; let i:i64=0; let L:i64=t.len; let inword:i64=0;
    while (i<L) {
        if (t[i]==32) { inword=0; }
        else {
            if (inword==0) { n=n+1; inword=1; }
        }
        i=i+1;
    }
    return n;
}
fn nc_find_word(t:[]u8, offs:[]u8, lens:[]u8, nw:i64, w:[]u8) i64 {
    let k:i64=0; let hit:i64=-1;
    while (k<nw) {
        if (hit==-1) {
            let o:i64=nc_r_u32le(offs,k*4); let ln:i64=nc_r_u32le(lens,k*4);
            if (ln==w.len) {
                let seg:[]u8=t[o..o+ln];
                if (nc_beq(seg,w)==1) { hit=k; }
            }
        }
        k=k+1;
    }
    return hit;
}
fn nc_reverse_into(t:[]u8, dst:[]u8) void {
    let i:i64=0; let L:i64=t.len;
    while (i<L) { dst[i]=t[L-1-i]; i=i+1; }
}

// ---------- question kinds ----------
// 1 LETTER_COUNT, 2 POSITION_N, 3 REVERSE, 4 WORD_COUNT,
// 5 LENGTH, 6 CONTAINS, 7 FIRST_WORD, 8 POS_FIRST, 9 POS_LAST
fn nc_parse_target_letter(q:[]u8) u8 {
    let p:i64=nc_find_sub(q,"'s in");
    return q[p-1];
}
fn nc_parse_pos_n(q:[]u8) i64 {
    let p:i64=nc_find_sub(q,"the ");
    return nc_parse_digits(q,p+4);
}
fn nc_parse_after(q:[]u8, marker:[]u8) []u8 {
    let p:i64=nc_find_sub(q,marker);
    return q[p+marker.len..q.len];
}
fn nc_parse_between(q:[]u8, a:[]u8, b:[]u8) []u8 {
    let p:i64=nc_find_sub(q,a); let p2:i64=nc_find_sub(q,b);
    return q[p+a.len..p2];
}


// ---------- extended classifier (superset of the fork's) ----------
// New nested kinds 10-17 (Phase-2 traps). The frozen arms below have no
// branches for these kinds: they leave the answer empty and fail. That is
// the documented negative-control outcome — fixed arms cannot adapt to
// question forms they were not built for.
// Kinds: 1 LETTER_COUNT, 2 POSITION_N, 3 REVERSE, 4 WORD_COUNT, 5 LENGTH,
// 6 CONTAINS, 7 FIRST_WORD, 8 POS_FIRST, 9 POS_LAST,
// 10 LETTER_COUNT_WORD, 11 LENGTH_WORD, 12 POSITION_WORD, 13 REVERSE_WORD,
// 14 FIRST_LETTER_WORD, 15 LAST_LETTER_WORD, 16 LAST_WORD, 17 CONTAINS_WORD
fn nc_classify(q:[]u8) i64 {
    if (nc_has_sub(q,"how many words in")==1) { return 4; }
    if (nc_has_sub(q,"how many letters in")==1) {
        if (nc_has_sub(q," word of ")==1) { return 11; }
        return 5;
    }
    if (nc_has_sub(q,"'s in")==1) {
        if (nc_has_sub(q," word of ")==1) { return 10; }
        return 1;
    }
    if (nc_has_sub(q,"backwards")==1) {
        if (nc_has_sub(q," word of ")==1) { return 13; }
        return 3;
    }
    if (nc_has_sub(q,"first letter of the")==1) {
        if (nc_has_sub(q," word of ")==1) { return 14; }
    }
    if (nc_has_sub(q,"last letter of the")==1) {
        if (nc_has_sub(q," word of ")==1) { return 15; }
    }
    if (nc_has_sub(q,"first word of")==1) { return 7; }
    if (nc_has_sub(q," word of ")==1) {
        if (nc_has_sub(q,"contain ")==1) { return 17; }
    }
    if (nc_has_sub(q,"last word of")==1) { return 16; }
    if (nc_has_sub(q,"contain ")==1) { return 6; }
    if (nc_has_sub(q,"first letter of")==1) { return 8; }
    if (nc_has_sub(q,"last letter of")==1) { return 9; }
    if (nc_has_sub(q,"letter of")==1) {
        if (nc_has_sub(q," word of ")==1) { return 12; }
        return 2;
    }
    return 0;
}
fn nc_kind_name(k:i64) []u8 {
    if (k==1) { return "LETTER_COUNT"; }
    if (k==2) { return "POSITION"; }
    if (k==3) { return "REVERSE"; }
    if (k==4) { return "WORD_COUNT"; }
    if (k==5) { return "LENGTH"; }
    if (k==6) { return "CONTAINS"; }
    if (k==7) { return "FIRST_WORD"; }
    if (k==8) { return "POS_FIRST"; }
    if (k==9) { return "POS_LAST"; }
    if (k==10) { return "LETTER_COUNT_WORD"; }
    if (k==11) { return "LENGTH_WORD"; }
    if (k==12) { return "POSITION_WORD"; }
    if (k==13) { return "REVERSE_WORD"; }
    if (k==14) { return "FIRST_LETTER_WORD"; }
    if (k==15) { return "LAST_LETTER_WORD"; }
    if (k==16) { return "LAST_WORD"; }
    return "CONTAINS_WORD";
}
// ---------- answer-line emitter (shared by arms) ----------
// stats pack: bit0 correct, bit1 native, bit2 fallback,
// bits8..39 ops, bits40..47 maxdepth, bits48..55 nzooms.
fn nc_pack_stats(correct:i64, native:i64, fb:i64, ops:i64, maxd:i64, nz:i64) i64 {
    return correct+(native*2)+(fb*4)+(ops*256)+(maxd*1099511627776)+(nz*281474976710656);
}
fn nc_emit_result(tag:[]u8, ans:[]u8, exp:[]u8, correct:i64, native:i64, fb:i64,
               ops:i64, maxd:i64, nz:i64,
               out:[]u8, atp:*i64, scr:[]u8) void {
    let a:i64=atp.*;
    a=nc_ob_raw(out,a,tag);
    a=nc_ob_raw(out,a," ans=\"");
    a=nc_ob_raw(out,a,ans);
    a=nc_ob_raw(out,a,"\" exp=\"");
    a=nc_ob_raw(out,a,exp);
    a=nc_ob_raw(out,a,"\" correct=");
    a=nc_ob_i64(out,a,correct,scr);
    a=nc_ob_raw(out,a," native=");
    a=nc_ob_i64(out,a,native,scr);
    a=nc_ob_raw(out,a," fallback=");
    a=nc_ob_i64(out,a,fb,scr);
    a=nc_ob_raw(out,a," ops=");
    a=nc_ob_i64(out,a,ops,scr);
    a=nc_ob_raw(out,a," maxdepth=");
    a=nc_ob_i64(out,a,maxd,scr);
    a=nc_ob_raw(out,a," zooms=");
    a=nc_ob_i64(out,a,nz,scr);
    a=nc_ob_nl(out,a);
    atp.*=a;
    return;
}

// RETIRED — negative control only. Frozen fork behavior.
// ---------- fixed arm C: character chunks ----------
fn nc_c_answer(qid:i64, kind:i64, q:[]u8, t:[]u8, exp:[]u8,
            out:[]u8, atp:*i64, scr:[]u8, abuf:[]u8, revbuf:[]u8) i64 {
    let ops:i64=0;
    let ans:[]u8=abuf[0..0];
    let alen:i64=0;
    if (kind==1) {
        let cnt:i64=nc_scan_count(t,0,t.len,nc_parse_target_letter(q));
        ops=t.len;
        alen=nc_ob_i64(abuf,0,cnt,scr); ans=abuf[0..alen];
    }
    if (kind==2) {
        let n:i64=nc_parse_pos_n(q);
        ops=n;
        if (n>=1) {
            if (n<=t.len) {
                abuf[0]=t[n-1]; alen=1; ans=abuf[0..alen];
            }
            else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        }
        else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
    }
    if (kind==8) {
        abuf[0]=t[0]; alen=1; ans=abuf[0..alen]; ops=1;
    }
    if (kind==9) {
        abuf[0]=t[t.len-1]; alen=1; ans=abuf[0..alen]; ops=1;
    }
    if (kind==3) {
        nc_reverse_into(t,revbuf);
        ans=revbuf[0..t.len];
        ops=t.len;
    }
    if (kind==4) {
        let n:i64=nc_count_words_bytes(t);
        ops=t.len;
        alen=nc_ob_i64(abuf,0,n,scr); ans=abuf[0..alen];
    }
    if (kind==5) {
        ops=t.len;
        alen=nc_ob_i64(abuf,0,t.len,scr); ans=abuf[0..alen];
    }
    if (kind==6) {
        let p:i64=nc_find_sub(t,nc_parse_after(q,"contain "));
        ops=t.len;
        if (p>=0) { ans="yes"; }
        else { ans="no"; }
    }
    if (kind==7) {
        let e:i64=t.len; let i:i64=0; let stop:i64=0;
        while (i<t.len) {
            if (stop==0) {
                if (t[i]==32) { e=i; stop=1; }
            }
            i=i+1;
        }
        ans=t[0..e]; ops=e;
    }
    let correct:i64=nc_beq(ans,exp);
    nc_emit_result("NC-C",ans,exp,correct,1,0,ops,0,0,out,atp,scr);
    return nc_pack_stats(correct,1,0,ops,0,0);
}

// RETIRED — negative control only. Frozen fork behavior.
fn nc_w_answer(qid:i64, kind:i64, q:[]u8, t:[]u8, exp:[]u8,
            out:[]u8, atp:*i64, scr:[]u8,
            abuf:[]u8, revbuf:[]u8, woffs:[]u8, wlens:[]u8) i64 {
    let nw:i64=nc_enum_words(t,woffs,wlens);
    let ops:i64=0; let fb:i64=0;
    let ans:[]u8=abuf[0..0];
    let alen:i64=0;
    if (kind==1) {
        fb=1;
        let tgt:u8=nc_parse_target_letter(q);
        let total:i64=0; let k:i64=0;
        while (k<nw) {
            let wo:i64=nc_r_u32le(woffs,k*4); let wl:i64=nc_r_u32le(wlens,k*4);
            total=total+nc_scan_count(t,wo,wl,tgt);
            k=k+1;
        }
        ops=nw+t.len;
        alen=nc_ob_i64(abuf,0,total,scr); ans=abuf[0..alen];
    }
    if (kind==2) {
        fb=1;
        let tw:[]u8=nc_parse_after(q,"of ");
        let wo:i64=0; let wl:i64=t.len; let okw:i64=1;
        if (nc_beq(tw,t)==0) {
            let k:i64=nc_find_word(t,woffs,wlens,nw,tw);
            if (k<0) { okw=0; }
            else { wo=nc_r_u32le(woffs,k*4); wl=nc_r_u32le(wlens,k*4); }
        }
        let n:i64=nc_parse_pos_n(q);
        ops=nw+n;
        if (okw==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            if (n>=1) {
                if (n<=wl) {
                    abuf[0]=t[wo+n-1]; alen=1; ans=abuf[0..alen];
                }
                else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
            }
            else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        }
    }
    if (kind==8) {
        fb=1;
        let wo:i64=nc_r_u32le(woffs,0);
        abuf[0]=t[wo]; alen=1; ans=abuf[0..alen]; ops=1;
    }
    if (kind==9) {
        fb=1;
        let k:i64=nw-1;
        let wo:i64=nc_r_u32le(woffs,k*4); let wl:i64=nc_r_u32le(wlens,k*4);
        abuf[0]=t[wo+wl-1]; alen=1; ans=abuf[0..alen]; ops=1;
    }
    if (kind==3) {
        fb=1;
        let i:i64=0;
        while (i<t.len) { revbuf[i]=t[i]; i=i+1; }
        let k:i64=0;
        while (k<nw) {
            let wo:i64=nc_r_u32le(woffs,k*4); let wl:i64=nc_r_u32le(wlens,k*4);
            let j:i64=0;
            while (j<wl) { revbuf[wo+j]=t[wo+wl-1-j]; j=j+1; }
            k=k+1;
        }
        ans=revbuf[0..t.len];
        ops=nw+t.len;
    }
    if (kind==4) {
        ops=nw;
        alen=nc_ob_i64(abuf,0,nw,scr); ans=abuf[0..alen];
    }
    if (kind==5) {
        let total:i64=0; let k:i64=0;
        while (k<nw) { total=total+nc_r_u32le(wlens,k*4); k=k+1; }
        ops=nw;
        alen=nc_ob_i64(abuf,0,total+nw-1,scr); ans=abuf[0..alen];
    }
    if (kind==6) {
        let needle:[]u8=nc_parse_after(q,"contain ");
        let k:i64=nc_find_word(t,woffs,wlens,nw,needle);
        if (k>=0) {
            ops=nw; ans="yes";
        }
        else {
            fb=1;
            ops=nw+t.len;
            if (nc_find_sub(t,needle)>=0) { ans="yes"; }
            else { ans="no"; }
        }
    }
    if (kind==7) {
        let wo:i64=nc_r_u32le(woffs,0); let wl:i64=nc_r_u32le(wlens,0);
        ans=t[wo..wo+wl]; ops=1;
    }
    let correct:i64=nc_beq(ans,exp);
    let native:i64=1;
    if (fb==1) { native=0; }
    nc_emit_result("NC-W",ans,exp,correct,native,fb,ops,0,0,out,atp,scr);
    return nc_pack_stats(correct,native,fb,ops,0,0);
}

// RETIRED — negative control only. Frozen fork behavior.
fn nc_s_answer(qid:i64, kind:i64, q:[]u8, t:[]u8, exp:[]u8,
            out:[]u8, atp:*i64, scr:[]u8, abuf:[]u8, revbuf:[]u8) i64 {
    let nspans:i64=(t.len+3)/4;
    let ops:i64=0; let fb:i64=0;
    let ans:[]u8=abuf[0..0];
    let alen:i64=0;
    if (kind==1) {
        fb=1;
        let tgt:u8=nc_parse_target_letter(q);
        let total:i64=0; let s:i64=0;
        while (s<nspans) {
            let so:i64=s*4; let sl:i64=4;
            if (so+sl>t.len) { sl=t.len-so; }
            total=total+nc_scan_count(t,so,sl,tgt);
            s=s+1;
        }
        ops=nspans+t.len;
        alen=nc_ob_i64(abuf,0,total,scr); ans=abuf[0..alen];
    }
    if (kind==2) {
        fb=1;
        let n:i64=nc_parse_pos_n(q);
        ops=2;
        if (n>=1) {
            if (n<=t.len) {
                abuf[0]=t[n-1]; alen=1; ans=abuf[0..alen];
            }
            else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        }
        else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
    }
    if (kind==8) {
        fb=1; abuf[0]=t[0]; alen=1; ans=abuf[0..alen]; ops=1;
    }
    if (kind==9) {
        fb=1; abuf[0]=t[t.len-1]; alen=1; ans=abuf[0..alen]; ops=1;
    }
    if (kind==3) {
        fb=1;
        nc_reverse_into(t,revbuf);
        ans=revbuf[0..t.len];
        ops=nspans+t.len;
    }
    if (kind==4) {
        fb=1;
        let n:i64=nc_count_words_bytes(t);
        ops=nspans+t.len;
        alen=nc_ob_i64(abuf,0,n,scr); ans=abuf[0..alen];
    }
    if (kind==5) {
        ops=nspans;
        alen=nc_ob_i64(abuf,0,t.len,scr); ans=abuf[0..alen];
    }
    if (kind==6) {
        fb=1;
        let p:i64=nc_find_sub(t,nc_parse_after(q,"contain "));
        ops=nspans+t.len;
        if (p>=0) { ans="yes"; }
        else { ans="no"; }
    }
    if (kind==7) {
        fb=1;
        let e:i64=t.len; let i:i64=0; let stop:i64=0;
        while (i<t.len) {
            if (stop==0) {
                if (t[i]==32) { e=i; stop=1; }
            }
            i=i+1;
        }
        ans=t[0..e]; ops=nspans+e;
    }
    let correct:i64=nc_beq(ans,exp);
    let native:i64=1;
    if (fb==1) { native=0; }
    nc_emit_result("NC-S",ans,exp,correct,native,fb,ops,0,0,out,atp,scr);
    return nc_pack_stats(correct,native,fb,ops,0,0);
}


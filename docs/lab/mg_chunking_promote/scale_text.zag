// scale_text.zag — TEXT-LENGTH scale probe for the production chunker (tnn_intake).
// Scale-rot battery: does word addressing stay correct/panic-free as input text
// grows 1x -> 10x -> 100x? Text = 5-word cycle (alpha beta gamma delta epsilon),
// so every expected answer is computable in closed form. No RNG, fully deterministic.
//
// Legs: 60 / 600 / 6000 words (~0.4KB / ~4KB / ~37KB).
// Per leg, 3 probes:
//   P1 "what is the {N}th word of {text}"      exp = cycle[(N-1)%5]
//   P2 "what is the last word of {text}"       exp = cycle[(N-1)%5]
//   P3 "how many a's in the {N/2}th word ..."  exp = acount[cycle[((N/2)-1)%5]]
// a-counts: alpha=2 beta=1 gamma=2 delta=1 epsilon=0.
@import("./intake.zag")

fn unpack_correct(p:i64) i64 { return p-(p/2)*2; }
fn unpack_native(p:i64) i64 { let q1:i64=p/2; return q1-(q1/2)*2; }
fn unpack_fb(p:i64) i64 { let q2:i64=p/4; return q2-(q2/2)*2; }

fn cyc_word(m:i64) []u8 {
    if (m==0) { return "alpha"; }
    if (m==1) { return "beta"; }
    if (m==2) { return "gamma"; }
    if (m==3) { return "delta"; }
    return "epsilon";
}
fn cyc_a(m:i64) i64 {
    if (m==0) { return 2; }
    if (m==1) { return 1; }
    if (m==2) { return 2; }
    if (m==3) { return 1; }
    return 0;
}
fn digit_str(v:i64) []u8 {
    if (v==0) { return "0"; }
    if (v==1) { return "1"; }
    return "2";
}
fn ord_suf(k:i64) []u8 {
    let m100:i64=k-((k/100)*100);
    if (m100==11) { return "th"; }
    if (m100==12) { return "th"; }
    if (m100==13) { return "th"; }
    let m10:i64=k-((k/10)*10);
    if (m10==1) { return "st"; }
    if (m10==2) { return "nd"; }
    if (m10==3) { return "rd"; }
    return "th";
}
fn build_text(tbuf:[]u8, n:i64) i64 {
    let at:i64=0;
    let i:i64=1;
    while (i<=n) {
        let w:[]u8=cyc_word((i-1)-(((i-1)/5)*5));
        let j:i64=0;
        while (j<w.len) { tbuf[at]=w[j]; at=at+1; j=j+1; }
        if (i<n) { tbuf[at]=32; at=at+1; }
        i=i+1;
    }
    return at;
}
fn probe(qid:i64, q:[]u8, t:[]u8, exp:[]u8, out:[]u8, atp:*i64, scr:[]u8,
          soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64, woffs:[]u8, wlens:[]u8,
          revbuf:[]u8, abuf:[]u8, whyb:[]u8) i64 {
    zn.*=0;
    let p:i64=tnn_intake(qid,q,t,exp,out,atp,scr,soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,whyb);
    let at:i64=atp.*;
    at=ob_raw(out,at,"# PROBE qid=");
    at=ob_i64(out,at,qid,scr);
    at=ob_raw(out,at," correct=");
    at=ob_i64(out,at,unpack_correct(p),scr);
    at=ob_raw(out,at," native=");
    at=ob_i64(out,at,unpack_native(p),scr);
    at=ob_raw(out,at," fallback=");
    at=ob_i64(out,at,unpack_fb(p),scr);
    at=ob_nl(out,at);
    atp.*=at;
    return unpack_correct(p)+unpack_native(p)*8+unpack_fb(p)*64;
}
fn run_leg(nw:i64, qid0:i64, out:[]u8, atp:*i64, scr:[]u8,
           soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64, woffs:[]u8, wlens:[]u8,
           revbuf:[]u8, abuf:[]u8, whyb:[]u8, tbuf:[]u8, qbuf:[]u8) i64 {
    let tlen:i64=build_text(tbuf,nw);
    let t:[]u8=tbuf[0..tlen];
    let at:i64=atp.*;
    at=ob_raw(out,at,"# LEG nwords=");
    at=ob_i64(out,at,nw,scr);
    at=ob_raw(out,at," tbytes=");
    at=ob_i64(out,at,tlen,scr);
    at=ob_nl(out,at);
    atp.*=at;
    let m:i64=(nw-1)-(((nw-1)/5)*5);
    let tot:i64=0;
    let qn:i64=0;
    qn=ob_raw(qbuf,qn,"what is the ");
    qn=ob_i64(qbuf,qn,nw,scr);
    qn=ob_raw(qbuf,qn,ord_suf(nw));
    qn=ob_raw(qbuf,qn," word of ");
    qn=ob_raw(qbuf,qn,t);
    tot=tot+probe(qid0,qbuf[0..qn],t,cyc_word(m),out,atp,scr,soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,whyb);
    qn=0;
    qn=ob_raw(qbuf,qn,"what is the last word of ");
    qn=ob_raw(qbuf,qn,t);
    tot=tot+probe(qid0+1,qbuf[0..qn],t,cyc_word(m),out,atp,scr,soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,whyb);
    let half:i64=nw/2;
    let mh:i64=(half-1)-(((half-1)/5)*5);
    qn=0;
    qn=ob_raw(qbuf,qn,"how many a's in the ");
    qn=ob_i64(qbuf,qn,half,scr);
    qn=ob_raw(qbuf,qn,ord_suf(half));
    qn=ob_raw(qbuf,qn," word of ");
    qn=ob_raw(qbuf,qn,t);
    tot=tot+probe(qid0+2,qbuf[0..qn],t,digit_str(cyc_a(mh)),out,atp,scr,soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,whyb);
    return tot;
}
fn main() void {
    let out:[]u8=nio_alloc(1048576);
    let at:i64=0;
    let scr:[]u8=nio_alloc(4096);
    let soff:[]u8=nio_alloc(256);
    let slen:[]u8=nio_alloc(256);
    let zlog:[]u8=nio_alloc(8192);
    let zn:i64=0;
    let woffs:[]u8=nio_alloc(256);
    let wlens:[]u8=nio_alloc(256);
    let revbuf:[]u8=nio_alloc(4096);
    let abuf:[]u8=nio_alloc(4096);
    let whyb:[]u8=nio_alloc(4096);
    let tbuf:[]u8=nio_alloc(65536);
    let qbuf:[]u8=nio_alloc(65536);
    at=ob_raw(out,at,"# SCALE-TEXT v1: text-length scale probe through LIVE tnn_intake");
    at=ob_nl(out,at);
    let g:i64=0;
    g=g+run_leg(60,0,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb,tbuf,qbuf);
    g=g+run_leg(600,10,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb,tbuf,qbuf);
    g=g+run_leg(6000,20,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb,tbuf,qbuf);
    at=ob_raw(out,at,"# SCALE-TEXT SUMMARY packed_total=");
    at=ob_i64(out,at,g,scr);
    at=ob_nl(out,at);
    _zag_print(out[0..at]);
    return;
}

@import("R33_NATIVE_SHA256_V2.zag")

// MATH CREW learner: exact rational arithmetic, word problems, Eiffel Tower
// thermal-expansion task, retrieve-vs-compute judgment. Pure Zag, zero RNG.
// argv[1]: "teach" -> install facts.txt (deliberate, logged), emit digest.
//          "solve" -> read battery.txt, emit "ID\tMODE\tANSWER\tTRACE".
// All quantities are exact (num,den) i64 rationals, gcd-reduced, den>0.
// Tables are []u8 arenas with p32/g32/p64/g64 (never `as []i32`).

// ---------------- byte helpers ----------------
fn is_digit(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    return 0;
}
fn is_alpha(c:u8)i32 {
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn p64(b:[]u8,at:i32,v:i64)void {
    p32(b,at,v&4294967295);
    p32(b,at+4,(v>>32)&4294967295);
    return;
}
fn g64(b:[]u8,at:i32)i64 {
    return g32(b,at)|(g32(b,at+4)<<32);
}
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
// naive substring search on lowercased buffer
fn has_sub(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(lit.len>len){return 0;}
    let i:i32=0;
    while(i+lit.len<=len){
        let j:i32=0;
        let ok:i32=1;
        while(j<lit.len){
            if(b[off+i+j]!=lit[j]){ok=0;j=lit.len;}
            j=j+1;
        }
        if(ok==1){return 1;}
        i=i+1;
    }
    return 0;
}

// ---------------- printing ----------------
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){
        let dd:i64=(x%10)+48;
        buf[at]=dd as u8;
        x=x/10;
        at=at-1;
    }
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    prlen(b,n);
    nio_free(b);
    return;
}

// ---------------- file IO ----------------
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{copy_bytes(buf,total,chk,0,nb);total=total+nb;}
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}

// ---------------- exact rational arithmetic ----------------
fn rgcd(a:i64,b:i64)i64 {
    let x:i64=a;
    if(x<0){x=0-x;}
    let y:i64=b;
    if(y<0){y=0-y;}
    while(y!=0){
        let t:i64=x%y;
        x=y;
        y=t;
    }
    return x;
}
// reduce (n,d) -> packed via out params in rn/rd arenas at idx
fn rred(n:i64,d:i64,rn:[]u8,rd:[]u8,ix:i32)void {
    let nn:i64=n;
    let dd:i64=d;
    if(dd<0){nn=0-nn;dd=0-dd;}
    if(nn==0){p64(rn,ix*8,0);p64(rd,ix*8,1);return;}
    let g:i64=rgcd(nn,dd);
    p64(rn,ix*8,nn/g);
    p64(rd,ix*8,dd/g);
    return;
}
fn rget(rn:[]u8,rd:[]u8,ix:i32,on:[]u8,od:[]u8,ox:i32)void {
    p64(on,ox*8,g64(rn,ix*8));
    p64(od,ox*8,g64(rd,ix*8));
    return;
}

// ---------------- tokenizer ----------------
// kinds: 0=word(lowercased), 1=number, 2=op(char in tn)
// arenas: ts start i32, tl len i32, tk kind i32, tn num/char i64, td den i64
fn tokenize(b:[]u8,off:i32,len:i32,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8)i32 {
    let n:i32=0;
    let p:i32=off;
    let end:i32=off+len;
    let neg:i32=0;
    while(p<end){
        let c:u8=b[p];
        if(is_digit(c)==1){
            let v:i64=0;
            while(p<end && is_digit(b[p])==1){v=v*10+(b[p] as i64)-48;p=p+1;}
            let dd:i64=1;
            if(p<end && b[p]==46 && p+1<end && is_digit(b[p+1])==1){
                p=p+1;
                while(p<end && is_digit(b[p])==1){v=v*10+(b[p] as i64)-48;dd=dd*10;p=p+1;}
            }
            if(p<end && b[p]==47 && p+1<end && is_digit(b[p+1])==1){
                p=p+1;
                let d2:i64=0;
                while(p<end && is_digit(b[p])==1){d2=d2*10+(b[p] as i64)-48;p=p+1;}
                dd=dd*d2;
            }
            if(neg==1){v=0-v;neg=0;}
            p32(ts,n*4,p); p32(tl,n*4,0); p32(tk,n*4,1);
            p64(tn,n*8,v); p64(td,n*8,dd);
            n=n+1;
        }
        else{
            if(is_alpha(c)==1 || c==95){
                let s:i32=p;
                while(p<end && (is_alpha(b[p])==1 || b[p]==95)){p=p+1;}
                let wl:i32=p-s;
                // lowercase copy into scratch? compare case-insensitively via to_low
                // check special words: minus, half, quarter, millionths
                if(wl==5 && to_low(b[s])==109 && to_low(b[s+1])==105 && to_low(b[s+2])==110 && to_low(b[s+3])==117 && to_low(b[s+4])==115){
                    neg=1;
                }
                else{
                    if(wl==4 && to_low(b[s])==104 && to_low(b[s+1])==97 && to_low(b[s+2])==108 && to_low(b[s+3])==102){
                        let vv:i64=1;
                        if(neg==1){vv=-1;neg=0;}
                        p32(ts,n*4,s);p32(tl,n*4,0);p32(tk,n*4,1);p64(tn,n*8,vv);p64(td,n*8,2);n=n+1;
                    }
                    else{
                        if(wl==7 && to_low(b[s])==113 && to_low(b[s+1])==117 && to_low(b[s+2])==97 && to_low(b[s+3])==114 && to_low(b[s+4])==116 && to_low(b[s+5])==101 && to_low(b[s+6])==114){
                            let vv2:i64=1;
                            if(neg==1){vv2=-1;neg=0;}
                            p32(ts,n*4,s);p32(tl,n*4,0);p32(tk,n*4,1);p64(tn,n*8,vv2);p64(td,n*8,4);n=n+1;
                        }
                        else{
                            if(wl==10 && to_low(b[s])==109 && to_low(b[s+1])==105 && to_low(b[s+2])==108 && to_low(b[s+3])==108 && to_low(b[s+4])==105 && to_low(b[s+5])==111 && to_low(b[s+6])==110 && to_low(b[s+7])==116 && to_low(b[s+8])==104 && to_low(b[s+9])==115){
                                // millionths: scale previous number token
                                if(n>0 && g32(tk,(n-1)*4)==1){
                                    let od:i64=g64(td,(n-1)*8);
                                    p64(td,(n-1)*8,od*1000000);
                                }
                            }
                            else{
                                // store lowercased word bytes into token via tn/td? keep start/len, lowercase on compare
                                p32(ts,n*4,s);p32(tl,n*4,wl);p32(tk,n*4,0);p64(tn,n*8,0);p64(td,n*8,1);
                                n=n+1;
                            }
                        }
                    }
                }
            }
            else{
                if(c==43 || c==42 || c==40 || c==41 || c==37){
                    p32(ts,n*4,p);p32(tl,n*4,1);p32(tk,n*4,2);p64(tn,n*8,c as i64);p64(td,n*8,1);
                    n=n+1;p=p+1;
                }
                else{
                    if(c==45){
                        // '-' : unary minus handled by parser; emit op
                        p32(ts,n*4,p);p32(tl,n*4,1);p32(tk,n*4,2);p64(tn,n*8,45);p64(td,n*8,1);
                        n=n+1;p=p+1;
                    }
                    else{
                        if(c==47){
                            p32(ts,n*4,p);p32(tl,n*4,1);p32(tk,n*4,2);p64(tn,n*8,47);p64(td,n*8,1);
                            n=n+1;p=p+1;
                        }
                        else{p=p+1;}
                    }
                }
            }
        }
        if(n>=90){p=end;}
    }
    return n;
}
// word token equals literal (case-insensitive; token already from lowercased scan? we lowercase on compare)
fn wtok_eq(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,ix:i32,lit:[]u8)i32 {
    if(g32(tk,ix*4)!=0){return 0;}
    let s:i32=g32(ts,ix*4) as i32;
    let l:i32=g32(tl,ix*4) as i32;
    if(l!=lit.len){return 0;}
    let i:i32=0;
    while(i<l){
        if(to_low(b[s+i])!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn is_num_tok(tk:[]u8,ix:i32)i32 {
    if(g32(tk,ix*4)==1){return 1;}
    return 0;
}

// ---------------- fact store ----------------
// fe entity, fa attr, fn_ num, fd_ den, fc cond-temp (-99999 none); fcnt at [0]
fn fact_install(fe:[]u8,fa:[]u8,fn_:[]u8,fd_:[]u8,fc:[]u8,e:i32,a:i32,n:i64,d:i64,ct:i64)void {
    let c:i32=g32(fe,0) as i32;
    p32(fe,4+c*4,e); p32(fa,4+c*4,a);
    p64(fn_,4+c*8,n); p64(fd_,4+c*8,d); p64(fc,4+c*8,ct);
    p32(fe,0,(c+1) as i64);
    return;
}
fn fact_find(fe:[]u8,fa:[]u8,fn_:[]u8,fd_:[]u8,fc:[]u8,e:i32,a:i32,on:[]u8,od:[]u8,oc:[]u8) i32 {
    let c:i32=g32(fe,0) as i32;
    let i:i32=0;
    while(i<c){
        if(g32(fe,4+i*4)==e && g32(fa,4+i*4)==a){
            p64(on,0,g64(fn_,4+i*8)); p64(od,0,g64(fd_,4+i*8)); p64(oc,0,g64(fc,4+i*8));
            return 1;
        }
        i=i+1;
    }
    return 0;
}
// teach: parse facts.txt, install well-formed facts only (deliberate), log each
fn teach_all(fb:[]u8,fe:[]u8,fa:[]u8,fn_:[]u8,fd_:[]u8,fc:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8)void {
    let p:i32=0;
    let bl:i32=fb.len;
    while(p<bl){
        let ls:i32=p;
        while(p<bl && fb[p]!=10){p=p+1;}
        let le:i32=p;
        if(p<bl){p=p+1;}
        if(le>ls && fb[le-1]==13){le=le-1;}
        if(le>ls && fb[ls]!=35){
            let nc:i32=tokenize(fb,ls,le-ls,ts,tl,tk,tn,td);
            if(nc>=4 && wtok_eq(fb,ts,tl,tk,0,"fact")==1){
                let e:i32=0;
                if(wtok_eq(fb,ts,tl,tk,1,"eiffel_tower")==1){e=1;}
                if(wtok_eq(fb,ts,tl,tk,1,"oak_street_bridge")==1){e=2;}
                if(wtok_eq(fb,ts,tl,tk,1,"iron")==1){e=3;}
                let a:i32=0;
                if(wtok_eq(fb,ts,tl,tk,2,"height_m")==1){a=1;}
                if(wtok_eq(fb,ts,tl,tk,2,"length_m")==1){a=1;}
                if(wtok_eq(fb,ts,tl,tk,2,"built_year")==1){a=2;}
                if(wtok_eq(fb,ts,tl,tk,2,"alpha_per_c")==1){a=3;}
                let vi:i32=-1;
                let k:i32=3;
                while(k<nc){
                    if(is_num_tok(tk,k)==1){vi=k;k=nc;}
                    k=k+1;
                }
                if(e!=0 && a!=0 && vi>=0){
                    let ct:i64=-99999;
                    let q:i32=vi+1;
                    while(q<nc){
                        if(wtok_eq(fb,ts,tl,tk,q,"temp_c")==1 && q+1<nc && is_num_tok(tk,q+1)==1){
                            ct=g64(tn,(q+1)*8);
                        }
                        q=q+1;
                    }
                    // reduce value
                    let vv:i64=g64(tn,vi*8);
                    let dd:i64=g64(td,vi*8);
                    let g:i64=rgcd(vv,dd);
                    if(g==0){g=1;}
                    fact_install(fe,fa,fn_,fd_,fc,e,a,vv/g,dd/g,ct);
                    pr("INSTALL e=");prn(e as i64);pr(" a=");prn(a as i64);
                    pr(" v=");prn(vv/g);pr("/");prn(dd/g);
                    if(ct!=-99999){pr(" @T=");prn(ct);}
                    prl("");
                }
            }
        }
    }
    return;
}

// ---------------- rational ops (reduced results) ----------------
fn r_add(n1:i64,d1:i64,n2:i64,d2:i64,rn:[]u8,rd:[]u8,ix:i32)void {
    rred(n1*d2+n2*d1,d1*d2,rn,rd,ix);
    return;
}
fn r_sub(n1:i64,d1:i64,n2:i64,d2:i64,rn:[]u8,rd:[]u8,ix:i32)void {
    rred(n1*d2-n2*d1,d1*d2,rn,rd,ix);
    return;
}
fn r_mul(n1:i64,d1:i64,n2:i64,d2:i64,rn:[]u8,rd:[]u8,ix:i32)void {
    rred(n1*n2,d1*d2,rn,rd,ix);
    return;
}
fn r_div(n1:i64,d1:i64,n2:i64,d2:i64,rn:[]u8,rd:[]u8,ix:i32)void {
    if(n2==0){p64(rn,ix*8,0);p64(rd,ix*8,0);return;}
    rred(n1*d2,d1*n2,rn,rd,ix);
    return;
}

// ---------------- number formatting ----------------
// terminating decimal or exact fraction into out; returns length
fn fmt_rat(n:i64,d:i64,out:[]u8)i32 {
    let at:i32=0;
    let nn:i64=n;
    let dd:i64=d;
    if(dd==0){
        out[0]=78;out[1]=65;out[2]=78; // NAN guard (should never emit)
        return 3;
    }
    if(nn<0){out[0]=45;at=1;nn=0-nn;}
    if(dd<0){dd=0-dd;}
    let g:i64=rgcd(nn,dd);
    if(g!=0){nn=nn/g;dd=dd/g;}
    if(dd==1){
        let b:[]u8=nio_alloc(24);
        let l:i32=i64str(nn,b);
        copy_bytes(out,at,b,0,l);
        nio_free(b);
        return at+l;
    }
    let t:i64=dd;
    while(t%2==0){t=t/2;}
    while(t%5==0){t=t/5;}
    if(t!=1){
        // exact fraction n/d
        let b2:[]u8=nio_alloc(24);
        let l1:i32=i64str(nn,b2);
        copy_bytes(out,at,b2,0,l1);
        nio_free(b2);
        out[at+l1]=47;
        let b3:[]u8=nio_alloc(24);
        let l2:i32=i64str(dd,b3);
        copy_bytes(out,at+l1+1,b3,0,l2);
        nio_free(b3);
        return at+l1+1+l2;
    }
    let ip:i64=nn/dd;
    let rem:i64=nn%dd;
    let b4:[]u8=nio_alloc(24);
    let l3:i32=i64str(ip,b4);
    copy_bytes(out,at,b4,0,l3);
    nio_free(b4);
    let w:i32=at+l3;
    if(rem==0){return w;}
    out[w]=46;w=w+1;
    while(rem!=0){
        rem=rem*10;
        let q:i64=rem/dd;
        rem=rem%dd;
        out[w]=(48+q) as u8;
        w=w+1;
    }
    return w;
}

// ---------------- expression parser (recursive descent, exact) ----------------
// tokens: kind2 ops +,-,*,/,(,),%, kind1 numbers; "of" treated as *
// cursor at pc[0]; result into rn/rd at ix
fn p_factor(tk:[]u8,tn:[]u8,td:[]u8,nc:i32,pc:[]u8,rn:[]u8,rd:[]u8,ix:i32,b:[]u8,ts:[]u8,tl:[]u8)void {
    let p:i32=g32(pc,0) as i32;
    if(p>=nc){p64(rn,ix*8,0);p64(rd,ix*8,0);return;}
    let k:i32=g32(tk,p*4) as i32;
    if(k==2 && g64(tn,p*8)==45){
        p32(pc,0,(p+1) as i64);
        p_factor(tk,tn,td,nc,pc,rn,rd,ix,b,ts,tl);
        p64(rn,ix*8,0-g64(rn,ix*8));
        return;
    }
    if(k==2 && g64(tn,p*8)==40){
        p32(pc,0,(p+1) as i64);
        p_expr(tk,tn,td,nc,pc,rn,rd,ix,b,ts,tl);
        let p2:i32=g32(pc,0) as i32;
        if(p2<nc){p32(pc,0,(p2+1) as i64);}
        // postfix % after paren
        let p3:i32=g32(pc,0) as i32;
        if(p3<nc && g32(tk,p3*4)==2 && g64(tn,p3*8)==37){
            r_div(g64(rn,ix*8),g64(rd,ix*8),100,1,rn,rd,ix);
            p32(pc,0,(p3+1) as i64);
        }
        return;
    }
    if(k==1){
        let vv:i64=g64(tn,p*8);
        let dd:i64=g64(td,p*8);
        let g:i64=rgcd(vv,dd);
        if(g==0){g=1;}
        p64(rn,ix*8,vv/g);p64(rd,ix*8,dd/g);
        p32(pc,0,(p+1) as i64);
        let p4:i32=g32(pc,0) as i32;
        if(p4<nc && g32(tk,p4*4)==2 && g64(tn,p4*8)==37){
            r_div(g64(rn,ix*8),g64(rd,ix*8),100,1,rn,rd,ix);
            p32(pc,0,(p4+1) as i64);
        }
        return;
    }
    p64(rn,ix*8,0);p64(rd,ix*8,0);
    return;
}
fn p_term(tk:[]u8,tn:[]u8,td:[]u8,nc:i32,pc:[]u8,rn:[]u8,rd:[]u8,ix:i32,b:[]u8,ts:[]u8,tl:[]u8)void {
    p_factor(tk,tn,td,nc,pc,rn,rd,ix,b,ts,tl);
    let go:i32=1;
    while(go==1){
        let p:i32=g32(pc,0) as i32;
        if(p>=nc){go=0;}
        else{
            let isop:i32=0;
            let opc:i64=0;
            if(g32(tk,p*4)==2){
                opc=g64(tn,p*8);
                if(opc==42 || opc==47){isop=1;}
            }
            if(g32(tk,p*4)==0 && wtok_eq(b,ts,tl,tk,p,"of")==1){isop=1;opc=42;}
            if(isop==0){go=0;}
            else{
                p32(pc,0,(p+1) as i64);
                let a:i64=g64(rn,ix*8);
                let ad:i64=g64(rd,ix*8);
                p_factor(tk,tn,td,nc,pc,rn,rd,ix+1,b,ts,tl);
                let c:i64=g64(rn,(ix+1)*8);
                let cd:i64=g64(rd,(ix+1)*8);
                if(opc==42){r_mul(a,ad,c,cd,rn,rd,ix);}
                else{r_div(a,ad,c,cd,rn,rd,ix);}
            }
        }
    }
    return;
}
fn p_expr(tk:[]u8,tn:[]u8,td:[]u8,nc:i32,pc:[]u8,rn:[]u8,rd:[]u8,ix:i32,b:[]u8,ts:[]u8,tl:[]u8)void {
    p_term(tk,tn,td,nc,pc,rn,rd,ix,b,ts,tl);
    let go:i32=1;
    while(go==1){
        let p:i32=g32(pc,0) as i32;
        if(p>=nc){go=0;}
        else{
            if(g32(tk,p*4)==2 && (g64(tn,p*8)==43 || g64(tn,p*8)==45)){
                let opc:i64=g64(tn,p*8);
                p32(pc,0,(p+1) as i64);
                let a:i64=g64(rn,ix*8);
                let ad:i64=g64(rd,ix*8);
                p_term(tk,tn,td,nc,pc,rn,rd,ix+1,b,ts,tl);
                let c:i64=g64(rn,(ix+1)*8);
                let cd:i64=g64(rd,(ix+1)*8);
                if(opc==43){r_add(a,ad,c,cd,rn,rd,ix);}
                else{r_sub(a,ad,c,cd,rn,rd,ix);}
            }
            else{go=0;}
        }
    }
    return;
}

// ---------------- query helpers over tokenized question ----------------
// number before word W (last NUM token strictly before first W); found->fr=1
fn num_before(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,w:[]u8,on:[]u8,od:[]u8)i32 {
    let i:i32=0;
    let li:i32=-1;
    while(i<nc){
        if(g32(tk,i*4)==0 && wtok_eq(b,ts,tl,tk,i,w)==1){
            let j:i32=i-1;
            while(j>=0){
                if(is_num_tok(tk,j)==1){li=j;j=-1;}
                j=j-1;
            }
            i=nc;
        }
        i=i+1;
    }
    if(li<0){return 0;}
    p64(on,0,g64(tn,li*8));p64(od,0,g64(td,li*8));
    return 1;
}
// first NUM token at/after word W
fn num_after(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,w:[]u8,on:[]u8,od:[]u8)i32 {
    let i:i32=0;
    while(i<nc){
        if(g32(tk,i*4)==0 && wtok_eq(b,ts,tl,tk,i,w)==1){
            let j:i32=i+1;
            while(j<nc){
                if(is_num_tok(tk,j)==1){
                    p64(on,0,g64(tn,j*8));p64(od,0,g64(td,j*8));
                    return 1;
                }
                j=j+1;
            }
            return 0;
        }
        i=i+1;
    }
    return 0;
}
fn first_num(tk:[]u8,tn:[]u8,td:[]u8,nc:i32,on:[]u8,od:[]u8)i32 {
    let i:i32=0;
    while(i<nc){
        if(is_num_tok(tk,i)==1){p64(on,0,g64(tn,i*8));p64(od,0,g64(td,i*8));return 1;}
        i=i+1;
    }
    return 0;
}
fn last_num(tk:[]u8,tn:[]u8,td:[]u8,nc:i32,on:[]u8,od:[]u8)i32 {
    let i:i32=nc-1;
    while(i>=0){
        if(is_num_tok(tk,i)==1){p64(on,0,g64(tn,i*8));p64(od,0,g64(td,i*8));return 1;}
        i=i-1;
    }
    return 0;
}
// collect temps: NUM directly followed by word "degrees"; returns count
fn collect_temps(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,ta:[]u8)i32 {
    let c:i32=0;
    let i:i32=0;
    while(i+1<nc){
        if(is_num_tok(tk,i)==1 && g32(tk,(i+1)*4)==0 && wtok_eq(b,ts,tl,tk,i+1,"degrees")==1){
            p64(ta,c*8,g64(tn,i*8));
            c=c+1;
        }
        i=i+1;
    }
    return c;
}

// ---------------- word-problem rules ----------------
// each: returns 1 if applied, result in rn/rd@0, trace id in tr
// scratch (n,d) pairs: on_/od_ arenas (8 bytes each)
fn r_profit(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8) i32 {
    // buys|purchases N boxes at|for M each|apiece ... sells ... for R
    let n1:i64=0; let d1:i64=1; let m1:i64=0; let md:i64=1; let r1:i64=0; let rd1:i64=1;
    let ok:i32=0;
    if(num_before(b,ts,tl,tk,tn,td,nc,"boxes",on_,od_)==1){n1=g64(on_,0);d1=g64(od_,0);ok=ok+1;}
    if(num_before(b,ts,tl,tk,tn,td,nc,"each",on_,od_)==1){m1=g64(on_,0);md=g64(od_,0);ok=ok+1;}
    else{if(num_before(b,ts,tl,tk,tn,td,nc,"apiece",on_,od_)==1){m1=g64(on_,0);md=g64(od_,0);ok=ok+1;}}
    if(last_num(tk,tn,td,nc,on_,od_)==1){r1=g64(on_,0);rd1=g64(od_,0);ok=ok+1;}
    if(ok<3){return 0;}
    // R - N*M
    let cn:i64=0; let cd:i64=1;
    r_mul(n1,d1,m1,md,rn,rd,1);
    cn=g64(rn,8);cd=g64(rd,8);
    r_sub(r1,rd1,cn,cd,rn,rd,0);
    return 1;
}
fn r_percent(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8,drop:i32) i32 {
    let p:i64=0; let pd:i64=1;
    if(num_before(b,ts,tl,tk,tn,td,nc,"percent",on_,od_)==0){return 0;}
    p=g64(on_,0);pd=g64(od_,0);
    // base: number after "of" ("15 percent of 240"); else the first number ("40 percent of them", "drops by 25 percent")
    let n1:i64=0; let d1:i64=1;
    if(num_after(b,ts,tl,tk,tn,td,nc,"of",on_,od_)==1){n1=g64(on_,0);d1=g64(od_,0);}
    else{if(first_num(tk,tn,td,nc,on_,od_)==1){n1=g64(on_,0);d1=g64(od_,0);}else{return 0;}}
    if(drop==1){
        // N*(1 - P/100)
        r_div(p,pd,100,1,rn,rd,1);
        let qn:i64=g64(rn,8); let qd:i64=g64(rd,8);
        r_sub(1,1,qn,qd,rn,rd,1);
        let fn_:i64=g64(rn,8); let fd_:i64=g64(rd,8);
        r_mul(n1,d1,fn_,fd_,rn,rd,0);
    }
    else{
        r_mul(n1,d1,p,pd,rn,rd,1);
        let qn2:i64=g64(rn,8); let qd2:i64=g64(rd,8);
        r_div(qn2,qd2,100,1,rn,rd,0);
    }
    return 1;
}
fn r_remainder(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8) i32 {
    // "how many <unit> remain|left" : start=num before FIRST <unit> occurrence; subtract all later nums
    let ui:i32=-1;
    let i:i32=0;
    while(i+2<nc){
        if(g32(tk,i*4)==0 && wtok_eq(b,ts,tl,tk,i,"how")==1 && g32(tk,(i+1)*4)==0 && wtok_eq(b,ts,tl,tk,i+1,"many")==1 && g32(tk,(i+2)*4)==0){
            ui=i+2;i=nc;
        }
        i=i+1;
    }
    if(ui<0){return 0;}
    let us:i32=g32(ts,ui*4) as i32;
    let ul:i32=g32(tl,ui*4) as i32;
    let uw:[]u8=b[us..us+ul];
    // first occurrence of the unit word with a number just before it
    let si:i32=-1;
    let fi:i32=0;
    while(fi<nc){
        if(g32(tk,fi*4)==0 && wtok_eq(b,ts,tl,tk,fi,uw)==1 && fi-1>=0 && is_num_tok(tk,fi-1)==1){
            si=fi-1;fi=nc;
        }
        fi=fi+1;
    }
    if(si<0){return 0;}
    let acc_n:i64=g64(tn,si*8); let acc_d:i64=g64(td,si*8);
    let k:i32=si+1;
    while(k<nc){
        if(is_num_tok(tk,k)==1){
            r_sub(acc_n,acc_d,g64(tn,k*8),g64(td,k*8),rn,rd,0);
            acc_n=g64(rn,0);acc_d=g64(rd,0);
        }
        k=k+1;
    }
    p64(rn,0,acc_n);p64(rd,0,acc_d);
    return 1;
}
fn r_rate(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8) i32 {
    let r1:i64=0; let rd1:i64=1;
    if(num_before(b,ts,tl,tk,tn,td,nc,"per",on_,od_)==1){r1=g64(on_,0);rd1=g64(od_,0);}
    else{if(num_before(b,ts,tl,tk,tn,td,nc,"each",on_,od_)==1){r1=g64(on_,0);rd1=g64(od_,0);}
    else{return 0;}}
    let t1:i64=0; let td1:i64=1;
    if(num_before(b,ts,tl,tk,tn,td,nc,"hours",on_,od_)==1){t1=g64(on_,0);td1=g64(od_,0);}
    else{return 0;}
    r_mul(r1,rd1,t1,td1,rn,rd,0);
    return 1;
}
fn r_speed(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8) i32 {
    let d1:i64=0; let dd:i64=1; let t1:i64=0; let td1:i64=1;
    if(num_before(b,ts,tl,tk,tn,td,nc,"kilometers",on_,od_)==0){return 0;}
    d1=g64(on_,0);dd=g64(od_,0);
    if(num_before(b,ts,tl,tk,tn,td,nc,"hours",on_,od_)==0){return 0;}
    t1=g64(on_,0);td1=g64(od_,0);
    r_div(d1,dd,t1,td1,rn,rd,0);
    return 1;
}
fn r_earn_spend(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8) i32 {
    let e1:i64=0; let ed:i64=1; let h1:i64=0; let hd:i64=1;
    if(num_before(b,ts,tl,tk,tn,td,nc,"per",on_,od_)==0){return 0;}
    e1=g64(on_,0);ed=g64(od_,0);
    if(num_before(b,ts,tl,tk,tn,td,nc,"hours",on_,od_)==0){return 0;}
    h1=g64(on_,0);hd=g64(od_,0);
    r_mul(e1,ed,h1,hd,rn,rd,1);
    let tn_:i64=g64(rn,8); let td_:i64=g64(rd,8);
    // spends half of earnings
    r_div(tn_,td_,2,1,rn,rd,0);
    return 1;
}
fn r_frac_drain(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8,ql:[]u8,qo:i32,qlen:i32) i32 {
    // "N <unit> ... <fraction> is drained. How many <unit> remain?"
    // start = num before first <unit>; fraction = first proper-fraction num token (quarter/half/N/M)
    let ui:i32=-1;
    let i:i32=0;
    while(i+2<nc){
        if(g32(tk,i*4)==0 && wtok_eq(b,ts,tl,tk,i,"how")==1 && g32(tk,(i+1)*4)==0 && wtok_eq(b,ts,tl,tk,i+1,"many")==1 && g32(tk,(i+2)*4)==0){
            ui=i+2;i=nc;
        }
        i=i+1;
    }
    if(ui<0){return 0;}
    let us:i32=g32(ts,ui*4) as i32;
    let ul:i32=g32(tl,ui*4) as i32;
    let uw:[]u8=b[us..us+ul];
    let si:i32=-1;
    let fi:i32=0;
    while(fi<nc){
        if(g32(tk,fi*4)==0 && wtok_eq(b,ts,tl,tk,fi,uw)==1 && fi-1>=0 && is_num_tok(tk,fi-1)==1){
            si=fi-1;fi=nc;
        }
        fi=fi+1;
    }
    if(si<0){return 0;}
    let sn:i64=g64(tn,si*8); let sd:i64=g64(td,si*8);
    // drained fraction: first num token with 0 < value < 1
    let fn_:i64=0; let fd_:i64=1; let fok:i32=0;
    let q:i32=0;
    while(q<nc){
        if(is_num_tok(tk,q)==1){
            let vn:i64=g64(tn,q*8); let vd:i64=g64(td,q*8);
            if(vn>0 && vd>0 && vn<vd){fn_=vn;fd_=vd;fok=1;q=nc;}
        }
        q=q+1;
    }
    if(fok==0){return 0;}
    r_sub(1,1,fn_,fd_,rn,rd,1);
    let kn:i64=g64(rn,8); let kd:i64=g64(rd,8);
    r_mul(sn,sd,kn,kd,rn,rd,0);
    return 1;
}
fn r_ml_remain(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8) i32 {
    let l1:i64=0; let g1:i64=0; let m1:i64=0;
    if(num_before(b,ts,tl,tk,tn,td,nc,"liters",on_,od_)==0){return 0;}
    l1=g64(on_,0);
    if(num_before(b,ts,tl,tk,tn,td,nc,"glasses",on_,od_)==0){return 0;}
    g1=g64(on_,0);
    if(num_before(b,ts,tl,tk,tn,td,nc,"milliliters",on_,od_)==0){return 0;}
    m1=g64(on_,0);
    let poured:i64=g1*m1;
    r_sub(l1*1000,1,poured,1,rn,rd,0);
    return 1;
}
fn r_unitrate(tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8) i32 {
    // first three numbers: A/B*C
    let c:i32=0;
    let a:i64=0; let ad:i64=1; let b1:i64=0; let bd:i64=1; let c1:i64=0; let cd:i64=1;
    let i:i32=0;
    while(i<nc){
        if(is_num_tok(tk,i)==1){
            if(c==0){a=g64(tn,i*8);ad=g64(td,i*8);}
            if(c==1){b1=g64(tn,i*8);bd=g64(td,i*8);}
            if(c==2){c1=g64(tn,i*8);cd=g64(td,i*8);}
            c=c+1;
        }
        i=i+1;
    }
    if(c<3){return 0;}
    r_div(a,ad,b1,bd,rn,rd,1);
    let qn:i64=g64(rn,8); let qd:i64=g64(rd,8);
    r_mul(qn,qd,c1,cd,rn,rd,0);
    return 1;
}
fn r_addstock(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8) i32 {
    if(first_num(tk,tn,td,nc,on_,od_)==0){return 0;}
    let s1:i64=g64(on_,0); let sd:i64=g64(od_,0);
    let m1:i64=0; let md:i64=1; let k1:i64=0; let kd:i64=1; let kok:i32=0;
    if(num_before(b,ts,tl,tk,tn,td,nc,"bags",on_,od_)==0){return 0;}
    m1=g64(on_,0);md=g64(od_,0);
    if(num_before(b,ts,tl,tk,tn,td,nc,"each",on_,od_)==1){k1=g64(on_,0);kd=g64(od_,0);kok=1;}
    // per-bag: "holding" overrides when present ("each holding 12" -> number AFTER holding)
    if(num_after(b,ts,tl,tk,tn,td,nc,"holding",on_,od_)==1){k1=g64(on_,0);kd=g64(od_,0);kok=1;}
    else{if(num_before(b,ts,tl,tk,tn,td,nc,"holding",on_,od_)==1){k1=g64(on_,0);kd=g64(od_,0);kok=1;}}
    if(kok==0){return 0;}
    r_mul(m1,md,k1,kd,rn,rd,1);
    let pn:i64=g64(rn,8); let pd:i64=g64(rd,8);
    r_add(s1,sd,pn,pd,rn,rd,0);
    return 1;
}
fn r_area(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8) i32 {
    let l1:i64=0; let ld:i64=1; let w1:i64=0; let wd:i64=1;
    if(num_before(b,ts,tl,tk,tn,td,nc,"long",on_,od_)==0){return 0;}
    l1=g64(on_,0);ld=g64(od_,0);
    if(num_before(b,ts,tl,tk,tn,td,nc,"wide",on_,od_)==0){return 0;}
    w1=g64(on_,0);wd=g64(od_,0);
    r_mul(l1,ld,w1,wd,rn,rd,0);
    return 1;
}
fn r_weekly(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8) i32 {
    let p1:i64=0; let pd:i64=1; let w1:i64=0; let wd:i64=1;
    if(num_before(b,ts,tl,tk,tn,td,nc,"per",on_,od_)==1){p1=g64(on_,0);pd=g64(od_,0);}
    else{if(num_before(b,ts,tl,tk,tn,td,nc,"every",on_,od_)==1){p1=g64(on_,0);pd=g64(od_,0);}
    else{return 0;}}
    if(num_before(b,ts,tl,tk,tn,td,nc,"weeks",on_,od_)==0){return 0;}
    w1=g64(on_,0);wd=g64(od_,0);
    r_mul(p1,pd,w1,wd,rn,rd,1);
    let qn:i64=g64(rn,8); let qd:i64=g64(rd,8);
    r_mul(qn,qd,7,1,rn,rd,0);
    return 1;
}
fn r_divq(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8) i32 {
    let a1:i64=0; let ad:i64=1;
    if(num_before(b,ts,tl,tk,tn,td,nc,"divided",on_,od_)==0){return 0;}
    a1=g64(on_,0);ad=g64(od_,0);
    if(last_num(tk,tn,td,nc,on_,od_)==0){return 0;}
    let c1:i64=g64(on_,0); let cd:i64=g64(od_,0);
    r_div(a1,ad,c1,cd,rn,rd,0);
    return 1;
}
fn unit_code(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,ix:i32)i32 {
    if(wtok_eq(b,ts,tl,tk,ix,"km")==1){return 1;}
    if(wtok_eq(b,ts,tl,tk,ix,"kilometers")==1){return 1;}
    if(wtok_eq(b,ts,tl,tk,ix,"m")==1){return 2;}
    if(wtok_eq(b,ts,tl,tk,ix,"meters")==1){return 2;}
    if(wtok_eq(b,ts,tl,tk,ix,"hours")==1){return 3;}
    if(wtok_eq(b,ts,tl,tk,ix,"hour")==1){return 3;}
    if(wtok_eq(b,ts,tl,tk,ix,"seconds")==1){return 4;}
    if(wtok_eq(b,ts,tl,tk,ix,"second")==1){return 4;}
    if(wtok_eq(b,ts,tl,tk,ix,"minutes")==1){return 5;}
    if(wtok_eq(b,ts,tl,tk,ix,"minute")==1){return 5;}
    return 0;
}
fn r_convertq(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8) i32 {
    // "how many meters are in 3.5 kilometers" : source unit = word after the number following "in"
    let ini:i32=-1;
    let i:i32=0;
    while(i<nc){
        if(g32(tk,i*4)==0 && wtok_eq(b,ts,tl,tk,i,"in")==1){ini=i;i=nc;}
        i=i+1;
    }
    if(ini<0){return 0;}
    // first num after "in", then the word after it
    let ni2:i32=-1;
    let j0:i32=ini+1;
    while(j0<nc){
        if(is_num_tok(tk,j0)==1){ni2=j0;j0=nc;}
        j0=j0+1;
    }
    if(ni2<0 || ni2+1>=nc){return 0;}
    let u2:i32=ni2+1;
    let c2:i32=unit_code(b,ts,tl,tk,u2);
    if(c2==0){return 0;}
    // target unit = word after "how many"
    let u1:i32=-1;
    let j:i32=0;
    while(j+2<nc){
        if(g32(tk,j*4)==0 && wtok_eq(b,ts,tl,tk,j,"how")==1 && g32(tk,(j+1)*4)==0 && wtok_eq(b,ts,tl,tk,j+1,"many")==1){
            u1=j+2;j=nc;
        }
        j=j+1;
    }
    if(u1<0){return 0;}
    let c1:i32=unit_code(b,ts,tl,tk,u1);
    if(c1==0){return 0;}
    // N = num before u2 word
    let si:i32=-1;
    let k:i32=u2-1;
    while(k>=0){
        if(is_num_tok(tk,k)==1){si=k;k=-1;}
        k=k-1;
    }
    if(si<0){return 0;}
    let n1:i64=g64(tn,si*8); let d1:i64=g64(td,si*8);
    let rn_:i64=1; let rd_:i64=1;
    if(c2==1 && c1==2){rn_=1000;rd_=1;}
    else{if(c2==2 && c1==1){rn_=1;rd_=1000;}
    else{if(c2==3 && c1==4){rn_=3600;rd_=1;}
    else{if(c2==4 && c1==5){rn_=1;rd_=60;}
    else{return 0;}}}}
    r_mul(n1,d1,rn_,rd_,rn,rd,0);
    return 1;
}

// ---------------- eiffel domain ----------------
fn num_before_seq(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,w1:[]u8,w2:[]u8,on_:[]u8,od_:[]u8)i32 {
    let i:i32=0;
    while(i+1<nc){
        if(g32(tk,i*4)==0 && wtok_eq(b,ts,tl,tk,i,w1)==1 && g32(tk,(i+1)*4)==0 && wtok_eq(b,ts,tl,tk,i+1,w2)==1){
            let j:i32=i-1;
            while(j>=0){
                if(is_num_tok(tk,j)==1){p64(on_,0,g64(tn,j*8));p64(od_,0,g64(td,j*8));return 1;}
                j=j-1;
            }
            return 0;
        }
        i=i+1;
    }
    return 0;
}
// first NUM followed by "degrees" at/after token ix
fn temp_from(b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,ix:i32)i64 {
    let i:i32=ix;
    while(i+1<nc){
        if(is_num_tok(tk,i)==1 && g32(tk,(i+1)*4)==0 && wtok_eq(b,ts,tl,tk,i+1,"degrees")==1){
            return g64(tn,i*8);
        }
        i=i+1;
    }
    return -99999;
}
// entity: 1=eiffel 2=bridge 3=rod
fn eiffel_solve(ql:[]u8,qo:i32,qlen:i32,b:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,nc:i32,fe:[]u8,fa:[]u8,fn_:[]u8,fd_:[]u8,fc:[]u8,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8,tr:[]u8)i32 {
    let ent:i32=0;
    if(has_sub(ql,qo,qlen,"eiffel tower")==1){ent=1;}
    if(ent==0 && has_sub(ql,qo,qlen,"oak street bridge")==1){ent=2;}
    if(ent==0 && has_sub(ql,qo,qlen,"steel rod")==1){ent=3;}
    if(ent==0 && has_sub(ql,qo,qlen,"tower")==1){ent=1;}
    if(ent==0 && has_sub(ql,qo,qlen,"bridge")==1){ent=2;}
    if(ent==0 && has_sub(ql,qo,qlen,"rod")==1){ent=3;}
    if(ent==0 && has_sub(ql,qo,qlen,"iron")==1){ent=3;}
    if(ent==0){return 0;}
    let ta:[]u8=nio_alloc(64);
    let tc:i32=collect_temps(b,ts,tl,tk,tn,td,nc,ta);
    // alpha: question-stated ("X expands 12 millionths" -> number AFTER expands; tokenizer already scales) else iron fact
    let al_n:i64=0; let al_d:i64=1; let al_ok:i32=0;
    if(has_sub(ql,qo,qlen,"expands")==1){
        if(num_after(b,ts,tl,tk,tn,td,nc,"expands",on_,od_)==1){al_n=g64(on_,0);al_d=g64(od_,0);al_ok=1;}
    }
    if(al_ok==0){
        let ao:[]u8=nio_alloc(8); let ao2:[]u8=nio_alloc(8); let ao3:[]u8=nio_alloc(8);
        if(fact_find(fe,fa,fn_,fd_,fc,3,3,ao,ao2,ao3)==1){al_n=g64(ao,0);al_d=g64(ao2,0);al_ok=1;}
        nio_free(ao);nio_free(ao2);nio_free(ao3);
    }
    if(has_sub(ql,qo,qlen,"what is the temperature")==1){
        // INVERSE: "measures L", base "N meters at T", alpha known
        if(num_after(b,ts,tl,tk,tn,td,nc,"measures",on_,od_)==0){nio_free(ta);return 0;}
        let lm:i64=g64(on_,0); let lmd:i64=g64(od_,0);
        if(num_before_seq(b,ts,tl,tk,tn,td,nc,"meters","at",on_,od_)==0){nio_free(ta);return 0;}
        let l0:i64=g64(on_,0); let l0d:i64=g64(od_,0);
        // T0: first "at" word then temp
        let ai:i32=-1;
        let i:i32=0;
        while(i<nc){
            if(g32(tk,i*4)==0 && wtok_eq(b,ts,tl,tk,i,"at")==1){ai=i;i=nc;}
            i=i+1;
        }
        if(ai<0){nio_free(ta);return 0;}
        let t0:i64=temp_from(b,ts,tl,tk,tn,td,nc,ai);
        if(t0==-99999 || al_ok==0){nio_free(ta);return 0;}
        // T = T0 + (Lm-L0)/(L0*alpha)
        r_sub(lm,lmd,l0,l0d,rn,rd,1);
        let dn:i64=g64(rn,8); let dd:i64=g64(rd,8);
        r_mul(l0,l0d,al_n,al_d,rn,rd,2);
        let en:i64=g64(rn,16); let ed:i64=g64(rd,16);
        r_div(dn,dd,en,ed,rn,rd,1);
        let qn:i64=g64(rn,8); let qd:i64=g64(rd,8);
        r_add(t0,1,qn,qd,rn,rd,0);
        copy_bytes(tr,0,"thermal-inv",0,11);
        nio_free(ta);
        return 2;
    }
    if(has_sub(ql,qo,qlen,"how much taller")==1){
        // diff of numbers preceding "meters"
        let c:i32=0;
        let na:[]u8=nio_alloc(64); let da:[]u8=nio_alloc(64);
        let i2:i32=0;
        while(i2<nc){
            if(g32(tk,i2*4)==0 && wtok_eq(b,ts,tl,tk,i2,"meters")==1){
                let j:i32=i2-1;
                while(j>=0){
                    if(is_num_tok(tk,j)==1){
                        p64(na,c*8,g64(tn,j*8));p64(da,c*8,g64(td,j*8));c=c+1;j=-1;
                    }
                    j=j-1;
                }
            }
            i2=i2+1;
        }
        if(c<2){nio_free(ta);nio_free(na);nio_free(da);return 0;}
        r_sub(g64(na,0),g64(da,0),g64(na,8),g64(da,8),rn,rd,0);
        copy_bytes(tr,0,"taller-diff",0,11);
        nio_free(ta);nio_free(na);nio_free(da);
        return 2;
    }
    if(has_sub(ql,qo,qlen,"how tall")==1 || has_sub(ql,qo,qlen,"how long")==1){
        // Rule: "how tall|long ... at T degrees" (temp attached to query): T==T0 -> RETRIEVE else COMPUTE(T).
        // Otherwise COMPUTE via the thermal formula at the ambient temp.
        let has_base:i32=0;
        let l0:i64=0; let l0d:i64=1; let t0:i64=0;
        if(has_sub(ql,qo,qlen,"meters tall at")==1 || has_sub(ql,qo,qlen,"meters long at")==1){
            has_base=1;
            if(has_sub(ql,qo,qlen,"meters tall at")==1){
                if(num_before(b,ts,tl,tk,tn,td,nc,"tall",on_,od_)==0){nio_free(ta);return 0;}
            }
            else{
                if(num_before(b,ts,tl,tk,tn,td,nc,"long",on_,od_)==0){nio_free(ta);return 0;}
            }
            l0=g64(on_,0);l0d=g64(od_,0);
            if(tc<1){nio_free(ta);return 0;}
            t0=g64(ta,0);
        }
        else{
            let fo:[]u8=nio_alloc(8); let fo2:[]u8=nio_alloc(8); let fo3:[]u8=nio_alloc(8);
            if(fact_find(fe,fa,fn_,fd_,fc,ent,1,fo,fo2,fo3)==0){nio_free(ta);nio_free(fo);nio_free(fo2);nio_free(fo3);return 0;}
            l0=g64(fo,0);l0d=g64(fo2,0);t0=g64(fo3,0);
            nio_free(fo);nio_free(fo2);nio_free(fo3);
        }
        // hq = index of "how" starting the how-tall/how-long query
        let hq:i32=-1;
        let hi:i32=0;
        while(hi+1<nc){
            if(g32(tk,hi*4)==0 && wtok_eq(b,ts,tl,tk,hi,"how")==1 && g32(tk,(hi+1)*4)==0){
                if(wtok_eq(b,ts,tl,tk,hi+1,"tall")==1 || wtok_eq(b,ts,tl,tk,hi+1,"long")==1){hq=hi;hi=nc;}
            }
            hi=hi+1;
        }
        // query-attached temp: "at" at/after hq, then NUM+"degrees"
        let qtemp:i64=-99999;
        if(hq>=0){
            let ai2:i32=-1;
            let aj:i32=hq;
            while(aj<nc){
                if(g32(tk,aj*4)==0 && wtok_eq(b,ts,tl,tk,aj,"at")==1){ai2=aj;aj=nc;}
                aj=aj+1;
            }
            if(ai2>=0){qtemp=temp_from(b,ts,tl,tk,tn,td,nc,ai2);}
        }
        if(qtemp!=-99999){
            if(qtemp==t0){
                p64(rn,0,l0);p64(rd,0,l0d);
                copy_bytes(tr,0,"retrieve",0,8);
                nio_free(ta);
                return 1;
            }
            if(al_ok==0){nio_free(ta);return 0;}
            r_sub(qtemp,1,t0,1,rn,rd,1);
            let dn2:i64=g64(rn,8); let dd2:i64=g64(rd,8);
            r_mul(al_n,al_d,dn2,dd2,rn,rd,2);
            let en2:i64=g64(rn,16); let ed2:i64=g64(rd,16);
            r_add(1,1,en2,ed2,rn,rd,1);
            let fn2:i64=g64(rn,8); let fd2:i64=g64(rd,8);
            r_mul(l0,l0d,fn2,fd2,rn,rd,0);
            copy_bytes(tr,0,"thermal",0,7);
            nio_free(ta);
            return 2;
        }
        // ambient-temp computation
        if(tc<1){
            p64(rn,0,l0);p64(rd,0,l0d);
            copy_bytes(tr,0,"retrieve",0,8);
            nio_free(ta);
            return 1;
        }
        let tgt:i64=g64(ta,0);
        if(has_base==1){
            let i3:i32=0;
            while(i3<tc){
                if(g64(ta,i3*8)!=t0){tgt=g64(ta,i3*8);i3=tc;}
                i3=i3+1;
            }
        }
        if(al_ok==0){nio_free(ta);return 0;}
        // L = L0*(1+alpha*(T-T0))
        r_sub(tgt,1,t0,1,rn,rd,1);
        let dn3:i64=g64(rn,8); let dd3:i64=g64(rd,8);
        r_mul(al_n,al_d,dn3,dd3,rn,rd,2);
        let en3:i64=g64(rn,16); let ed3:i64=g64(rd,16);
        r_add(1,1,en3,ed3,rn,rd,1);
        let fn3:i64=g64(rn,8); let fd3:i64=g64(rd,8);
        r_mul(l0,l0d,fn3,fd3,rn,rd,0);
        copy_bytes(tr,0,"thermal",0,7);
        nio_free(ta);
        return 2;
    }
    // RETRIEVE_Q
    if(has_sub(ql,qo,qlen,"built")==1){
        let bo:[]u8=nio_alloc(8); let bo2:[]u8=nio_alloc(8); let bo3:[]u8=nio_alloc(8);
        let ok:i32=fact_find(fe,fa,fn_,fd_,fc,ent,2,bo,bo2,bo3);
        if(ok==1){p64(rn,0,g64(bo,0));p64(rd,0,g64(bo2,0));}
        nio_free(bo);nio_free(bo2);nio_free(bo3);nio_free(ta);
        if(ok==1){copy_bytes(tr,0,"retrieve",0,8);return 1;}
        return 0;
    }
    if(has_sub(ql,qo,qlen,"coefficient")==1){
        let co:[]u8=nio_alloc(8); let co2:[]u8=nio_alloc(8); let co3:[]u8=nio_alloc(8);
        let ok2:i32=fact_find(fe,fa,fn_,fd_,fc,3,3,co,co2,co3);
        if(ok2==1){p64(rn,0,g64(co,0));p64(rd,0,g64(co2,0));}
        nio_free(co);nio_free(co2);nio_free(co3);nio_free(ta);
        if(ok2==1){copy_bytes(tr,0,"retrieve",0,8);return 1;}
        return 0;
    }
    if(has_sub(ql,qo,qlen,"height")==1 || has_sub(ql,qo,qlen,"tall")==1 || has_sub(ql,qo,qlen,"long")==1){
        let ho:[]u8=nio_alloc(8); let ho2:[]u8=nio_alloc(8); let ho3:[]u8=nio_alloc(8);
        let ok3:i32=fact_find(fe,fa,fn_,fd_,fc,ent,1,ho,ho2,ho3);
        let good:i32=0;
        if(ok3==1){
            if(tc>0 && g64(ho3,0)==g64(ta,0)){good=1;}
            if(tc==0){good=1;}
        }
        if(good==1){p64(rn,0,g64(ho,0));p64(rd,0,g64(ho2,0));}
        nio_free(ho);nio_free(ho2);nio_free(ho3);nio_free(ta);
        if(good==1){copy_bytes(tr,0,"retrieve",0,8);return 1;}
        return 0;
    }
    nio_free(ta);
    return 0;
}

// ---------------- top-level solve ----------------
fn solve_question(ql:[]u8,qo:i32,qlen:i32,fe:[]u8,fa:[]u8,fn_:[]u8,fd_:[]u8,fc:[]u8,ts:[]u8,tl:[]u8,tk:[]u8,tn:[]u8,td:[]u8,rn:[]u8,rd:[]u8,on_:[]u8,od_:[]u8,tr:[]u8,ans:[]u8)i32 {
    // returns alen; mode in m[0]
    let nc:i32=tokenize(ql,qo,qlen,ts,tl,tk,tn,td);
    let m:[]u8=nio_alloc(8);
    p32(m,0,0);
    let alen:i32=0;
    // EXPR:
    if(nc>1 && g32(tk,0)==0 && wtok_eq(ql,ts,tl,tk,0,"expr")==1){
        let pc:[]u8=nio_alloc(8);
        p32(pc,0,1);
        p_expr(tk,tn,td,nc,pc,rn,rd,0,ql,ts,tl);
        nio_free(pc);
        alen=fmt_rat(g64(rn,0),g64(rd,0),ans);
        copy_bytes(tr,0,"expr",0,4);
        p32(m,0,2);
        nio_free(m);
        return alen;
    }
    if(nc>1 && g32(tk,0)==0 && wtok_eq(ql,ts,tl,tk,0,"convert")==1){
        // "convert: N U1 to U2"
        let ni:i32=-1;
        let i:i32=1;
        while(i<nc){
            if(is_num_tok(tk,i)==1){ni=i;i=nc;}
            i=i+1;
        }
        if(ni>=0 && ni+3<nc){
            let u1:i32=unit_code(ql,ts,tl,tk,ni+1);
            // find "to"
            let ti:i32=-1;
            let j:i32=ni+1;
            while(j<nc){
                if(g32(tk,j*4)==0 && wtok_eq(ql,ts,tl,tk,j,"to")==1){ti=j;j=nc;}
                j=j+1;
            }
            if(ti>=0 && ti+1<nc){
                let u2:i32=unit_code(ql,ts,tl,tk,ti+1);
                let n1:i64=g64(tn,ni*8); let d1:i64=g64(td,ni*8);
                let rr:i64=1; let dr:i64=1; let ok:i32=1;
                if(u1==1 && u2==2){rr=1000;dr=1;}
                else{if(u1==2 && u2==1){rr=1;dr=1000;}
                else{if(u1==3 && u2==4){rr=3600;dr=1;}
                else{if(u1==4 && u2==5){rr=1;dr=60;}
                else{ok=0;}}}}
                if(ok==1){
                    r_mul(n1,d1,rr,dr,rn,rd,0);
                    alen=fmt_rat(g64(rn,0),g64(rd,0),ans);
                    copy_bytes(tr,0,"convert",0,7);
                    p32(m,0,2);
                    nio_free(m);
                    return alen;
                }
            }
        }
        copy_bytes(tr,0,"abstain",0,7);
        nio_free(m);
        return 0;
    }
    // eiffel domain?
    if(has_sub(ql,qo,qlen,"eiffel tower")==1 || has_sub(ql,qo,qlen,"tower")==1 || has_sub(ql,qo,qlen,"oak street bridge")==1 || has_sub(ql,qo,qlen,"bridge")==1 || has_sub(ql,qo,qlen,"steel rod")==1 || has_sub(ql,qo,qlen,"rod")==1 || has_sub(ql,qo,qlen,"iron")==1){
        let em:i32=eiffel_solve(ql,qo,qlen,ql,ts,tl,tk,tn,td,nc,fe,fa,fn_,fd_,fc,rn,rd,on_,od_,tr);
        if(em==0){copy_bytes(tr,0,"abstain",0,7);nio_free(m);return 0;}
        alen=fmt_rat(g64(rn,0),g64(rd,0),ans);
        p32(m,0,em);
        nio_free(m);
        return alen;
    }
    // word rules (flat dispatch: wm==0 guard, no deep nesting)
    let wm:i32=0;
    if(wm==0 && has_sub(ql,qo,qlen,"profit")==1){if(r_profit(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"profit",0,6);}}
    if(wm==0 && has_sub(ql,qo,qlen,"drops by")==1){if(r_percent(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_,1)==1){wm=2;copy_bytes(tr,0,"percent-drop",0,12);}}
    if(wm==0 && has_sub(ql,qo,qlen,"percent")==1){if(r_percent(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_,0)==1){wm=2;copy_bytes(tr,0,"percent",0,7);}}
    if(wm==0 && has_sub(ql,qo,qlen,"divided by")==1){if(r_divq(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"div",0,3);}}
    if(wm==0 && has_sub(ql,qo,qlen,"earns")==1){if(r_earn_spend(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"earn-spend",0,10);}}
    if(wm==0 && has_sub(ql,qo,qlen,"milliliters")==1){if(r_ml_remain(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"ml-remain",0,9);}}
    if(wm==0 && has_sub(ql,qo,qlen,"drained")==1){if(r_frac_drain(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_,ql,qo,qlen)==1){wm=2;copy_bytes(tr,0,"frac-drain",0,10);}}
    if(wm==0 && has_sub(ql,qo,qlen,"remain")==1){if(r_remainder(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"remainder",0,9);}}
    if(wm==0 && has_sub(ql,qo,qlen,"left")==1){if(r_remainder(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"remainder",0,9);}}
    if(wm==0 && has_sub(ql,qo,qlen,"how far")==1){if(r_rate(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"rate",0,4);}}
    if(wm==0 && has_sub(ql,qo,qlen,"distance")==1){if(r_rate(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"rate",0,4);}}
    if(wm==0 && has_sub(ql,qo,qlen,"speed")==1){if(r_speed(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"speed",0,5);}}
    if(wm==0 && has_sub(ql,qo,qlen,"per day")==1){if(r_weekly(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"weekly",0,6);}}
    if(wm==0 && has_sub(ql,qo,qlen,"daily")==1){if(r_weekly(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"weekly",0,6);}}
    if(wm==0 && has_sub(ql,qo,qlen,"every day")==1){if(r_weekly(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"weekly",0,6);}}
    if(wm==0 && has_sub(ql,qo,qlen,"pancakes")==1){if(r_unitrate(tk,tn,td,nc,rn,rd)==1){wm=2;copy_bytes(tr,0,"unitrate",0,8);}}
    if(wm==0 && has_sub(ql,qo,qlen,"bags")==1){if(r_addstock(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"addstock",0,8);}}
    if(wm==0 && has_sub(ql,qo,qlen,"area")==1){if(r_area(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"area",0,4);}}
    if(wm==0 && has_sub(ql,qo,qlen,"meters are in")==1){if(r_convertq(ql,ts,tl,tk,tn,td,nc,rn,rd,on_,od_)==1){wm=2;copy_bytes(tr,0,"convert",0,7);}}
    if(wm==0){copy_bytes(tr,0,"abstain",0,7);nio_free(m);return 0;}
    alen=fmt_rat(g64(rn,0),g64(rd,0),ans);
    p32(m,0,wm);
    nio_free(m);
    return alen;
}

fn main()void {
    let a1:[]u8=_zag_arg(1);
    // arenas
    let fe:[]u8=nio_alloc(4+32*4);
    let fa:[]u8=nio_alloc(4+32*4);
    let fn_:[]u8=nio_alloc(4+32*8);
    let fd_:[]u8=nio_alloc(4+32*8);
    let fc:[]u8=nio_alloc(4+32*8);
    let ts:[]u8=nio_alloc(96*4);
    let tl:[]u8=nio_alloc(96*4);
    let tk:[]u8=nio_alloc(96*4);
    let tn:[]u8=nio_alloc(96*8);
    let td:[]u8=nio_alloc(96*8);
    let rn:[]u8=nio_alloc(8*8);
    let rd:[]u8=nio_alloc(8*8);
    let on_:[]u8=nio_alloc(8);
    let od_:[]u8=nio_alloc(8);
    p32(fe,0,0);
    let fb:[]u8=read_all("facts.txt");
    teach_all(fb,fe,fa,fn_,fd_,fc,ts,tl,tk,tn,td);
    if(nio_equal(a1,"teach")==1){
        // digest over installed facts
        let h:i64=7;
        let c:i32=g32(fe,0) as i32;
        let i:i32=0;
        while(i<c){
            h=h*31+g32(fe,4+i*4);
            h=h*31+g32(fa,4+i*4);
            h=h*31+g64(fn_,4+i*8);
            h=h*31+g64(fd_,4+i*8);
            h=h*31+g64(fc,4+i*8);
            i=i+1;
        }
        if(h<0){h=0-h;}
        pr("FACTS ");prn(c as i64);pr(" DIGEST ");
        let hb:[]u8=nio_alloc(16);
        let hi:i32=15;
        while(hi>=0){let dg:[]u8="0123456789abcdef";hb[hi]=dg[h%16];h=h/16;hi=hi-1;}
        prlen(hb,16);
        prl("");
        nio_free(hb);
        return;
    }
    if(nio_equal(a1,"solve")==1){
        let bat:[]u8=read_all("battery.txt");
        let bl:i32=bat.len;
        let p:i32=0;
        let qlow:[]u8=nio_alloc(2048);
        let tr:[]u8=nio_alloc(32);
        let ans:[]u8=nio_alloc(64);
        while(p<bl){
            let ls:i32=p;
            while(p<bl && bat[p]!=10){p=p+1;}
            let le:i32=p;
            if(p<bl){p=p+1;}
            if(le>ls && bat[le-1]==13){le=le-1;}
            if(le>ls){
                // split ID at tab
                let tab:i32=ls;
                while(tab<le && bat[tab]!=9){tab=tab+1;}
                if(tab<le){
                    let qlen:i32=le-(tab+1);
                    let qi:i32=0;
                    while(qi<qlen){qlow[qi]=to_low(bat[tab+1+qi]);qi=qi+1;}
                    let alen:i32=solve_question(qlow,0,qlen,fe,fa,fn_,fd_,fc,ts,tl,tk,tn,td,rn,rd,on_,od_,tr,ans);
                    // mode: infer from trace? solve_question returns alen only; re-derive: abstain -> alen 0
                    prlen(bat,0); // placeholder no-op
                    let idl:i32=tab-ls;
                    prlen(bat[ls..tab],idl);
                    pr("\t");
                    if(alen==0){pr("ABSTAIN\tABSTAIN\t");}
                    else{
                        // mode string: need mode; re-derive from trace
                        if(beq(tr,0,8,"retrieve")==1){pr("RETRIEVE\t");}
                        else{pr("COMPUTE\t");}
                        prlen(ans,alen);
                        pr("\t");
                    }
                    // trace length: longest-first, flat
                    let trl:i32=0;
                    if(beq(tr,0,12,"percent-drop")==1){trl=12;}
                    if(trl==0 && beq(tr,0,11,"thermal-inv")==1){trl=11;}
                    if(trl==0 && beq(tr,0,11,"taller-diff")==1){trl=11;}
                    if(trl==0 && beq(tr,0,10,"earn-spend")==1){trl=10;}
                    if(trl==0 && beq(tr,0,10,"frac-drain")==1){trl=10;}
                    if(trl==0 && beq(tr,0,9,"ml-remain")==1){trl=9;}
                    if(trl==0 && beq(tr,0,9,"remainder")==1){trl=9;}
                    if(trl==0 && beq(tr,0,8,"unitrate")==1){trl=8;}
                    if(trl==0 && beq(tr,0,8,"addstock")==1){trl=8;}
                    if(trl==0 && beq(tr,0,8,"retrieve")==1){trl=8;}
                    if(trl==0 && beq(tr,0,7,"thermal")==1){trl=7;}
                    if(trl==0 && beq(tr,0,7,"percent")==1){trl=7;}
                    if(trl==0 && beq(tr,0,7,"convert")==1){trl=7;}
                    if(trl==0 && beq(tr,0,7,"abstain")==1){trl=7;}
                    if(trl==0 && beq(tr,0,6,"profit")==1){trl=6;}
                    if(trl==0 && beq(tr,0,6,"weekly")==1){trl=6;}
                    if(trl==0 && beq(tr,0,5,"speed")==1){trl=5;}
                    if(trl==0 && beq(tr,0,4,"expr")==1){trl=4;}
                    if(trl==0 && beq(tr,0,4,"rate")==1){trl=4;}
                    if(trl==0 && beq(tr,0,4,"area")==1){trl=4;}
                    if(trl==0 && beq(tr,0,3,"div")==1){trl=3;}
                    prlen(tr,trl);
                    prl("");
                }
            }
        }
        return;
    }
    prl("usage: math teach|solve");
    return;
}

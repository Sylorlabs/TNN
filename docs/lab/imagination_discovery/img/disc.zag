// ============================================================
// disc.zag — IMAGINATION DISCOVERY image pipeline (pure Zag).
//
// Two discovery subjects, rendered per-pixel from continuous fields:
//   D-IMG-1 "alien" : extrasolar surface vista — three mountain depth
//                     planes (far massifs / mid crags / near scree),
//                     each with its own field scale and character,
//                     plus an integrated ringed planet (limb haze,
//                     halo, ring/planet shadow interplay, clouds
//                     behind and wisps in front)
//   D-IMG-2 "arch"  : impossible architecture — Penrose triangle with
//                     cyclic beam priority (coherent impossibility),
//                     scarf-joint corners, per-beam weathering,
//                     soft contact-hardened shadow, full environment
//
// Composition is GENUINE GENERATIVE: every pixel is evaluated from
// multi-scale deterministic noise (integer-hash value noise, fBm with
// many octaves, domain warping). There are NO axis-aligned filled
// primitive placement calls anywhere in the scene builders — all
// coverage is per-pixel analytic tests (point-in-convex-quad,
// segment distance, radial falloff).
//
// The 512x512 u4f field cap is bypassed by rasterizing DIRECTLY into
// the pixel buffer (one []u8 of W*H*3 bytes, rows bottom-up for BMP).
// 1024^2*3 = 3.1MB, 2048^2*3 = 12.6MB — both far under the 2^25 slice
// limit. No field grid is used at all.
//
// Deterministic: integer hash noise, fixed seeds, no RNG anywhere.
// Grain is fine pixel-level monochromatic hash dither at low
// amplitude — texture, never blur.
//
// Build: znc disc.zag --no-zagd --no-analyze -o disc
// Usage: disc <alien|arch> <outdir> <1024|2048>
// ============================================================
@import("../../toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- byte helpers ----------------
fn d_put32le(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
}

// ---------------- small math ----------------
fn d_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn d_clamp(v:i64, lo:i64, hi:i64) i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
// smoothstep on 0..1024 -> 0..1024
fn d_ss(t:i64) i64 {
    let c:i64 = d_clamp(t, 0, 1024);
    return c * c * (3072 - 2 * c) / 1048576;
}
// integer sqrt (Newton, deterministic)
fn d_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let r:i64 = v;
    let i:i64 = 0;
    while (i < 64) {
        r = (r + v / r) / 2;
        i = i + 1;
    }
    return r;
}
// f64 sqrt (Newton, deterministic)
fn d_sqrt(x:f64) f64 {
    if (x <= 0.0) { return 0.0; }
    let r:f64 = x;
    if (r < 1.0) { r = 1.0; }
    let i:i64 = 0;
    while (i < 24) {
        r = 0.5 * (r + x / r);
        i = i + 1;
    }
    return r;
}
fn d_fabs(x:f64) f64 {
    if (x < 0.0) { return 0.0 - x; }
    return x;
}

// ---------------- deterministic integer-hash noise ----------------
// All coordinates are i64 fixed-point with FB=8 fractional bits.
// d_hash -> 0..2^32-1. Masked to stay non-negative so shifts are safe.
fn d_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
// hash -> 0..1023
fn d_h01(x:i64, y:i64, seed:i64) i64 {
    return d_hash(x, y, seed) >> 22;
}
// smoothstep weight 0..255 -> 0..255
fn d_sstep(t:i64) i64 {
    let t2:i64 = t * t;
    let t3:i64 = t2 * t;
    return (3 * t2 * 255 - 2 * t3) / 65025;
}
// value noise, x/y fixed-point FB=8 -> 0..1023
fn d_vnoise(x:i64, y:i64, seed:i64) i64 {
    let xb:i64 = x + 268435456;
    let yb:i64 = y + 268435456;
    let xi:i64 = xb >> 8;
    let yi:i64 = yb >> 8;
    let xf:i64 = xb & 255;
    let yf:i64 = yb & 255;
    let u:i64 = d_sstep(xf);
    let v:i64 = d_sstep(yf);
    let a:i64 = d_h01(xi, yi, seed);
    let b:i64 = d_h01(xi + 1, yi, seed);
    let c:i64 = d_h01(xi, yi + 1, seed);
    let d:i64 = d_h01(xi + 1, yi + 1, seed);
    let ab:i64 = a + (b - a) * u / 256;
    let cd:i64 = c + (d - c) * u / 256;
    return ab + (cd - ab) * v / 256;
}
// fractal Brownian motion, oct octaves -> 0..1023
fn d_fbm(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + d_vnoise(xx, yy, seed + o * 131) * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 512; }
    return sum * 512 / norm;
}
// ridged fBm (mountain-like), oct octaves -> 0..1023
fn d_ridge(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        let n:i64 = d_vnoise(xx, yy, seed + o * 131);
        let r:i64 = 1023 - d_abs(n + n - 1023);
        r = r * r / 1023;
        sum = sum + r * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 0; }
    return sum * 512 / norm;
}
// pack/unpack RGB
fn d_pack(r:i64, g:i64, b:i64) i64 {
    return (r & 255) + ((g & 255) << 8) + ((b & 255) << 16);
}
fn d_lerp(a:i64, b:i64, t:i64) i64 {
    return a + (b - a) * t / 1024;
}

// ============================================================
// D-IMG-1 "alien planet" — extrasolar surface vista.
// Per-pixel continuous-field evaluation. No placed primitives.
// ============================================================

// terrain height field: domain-warped ridged fBm + macro masses.
// x,y in pixels. Returns 0..1023.


// ============================================================
// D-IMG-1 v2 — layered mountain planes + integrated planet.
// Repair notes (2026-09-22, round 2):
//  * terrain is THREE depth planes (far massifs / mid crags /
//    near scree), each with its own heightfield cell size,
//    octave count, warp seed, relief, albedo character,
//    aerial-perspective factor and detail falloff — no single
//    noise function at every zoom.
//  * ONE sun (upper-left) lights terrain relief, the planet
//    terminator, cloud shading and the halo.
//  * the planet is composited INTO the sky: cloud deck behind,
//    atmospheric limb haze, forward-scatter halo, the planet's
//    shadow cast on the back ring, the ring's shadow cast on
//    the planet disc, thin cirrus wisps in front of the lower
//    limb.
// ============================================================

// silhouette edges of the three depth planes (strictly ordered)
fn d_edge_far(x:i64, h0:i64, seed:i64) i64 {
    let mass:i64 = d_ridge((x << 8) / 150, 13, seed + 221, 3);
    let sw:i64 = d_fbm((x << 8) / 400, 17, seed + 222, 2);
    let m:i64 = (mass * 640 + sw * 384) / 1024;
    return h0 - (m - 512) * 300 / 1024;
}
fn d_edge_mid(x:i64, ef:i64, seed:i64) i64 {
    let crag:i64 = d_ridge((x << 8) / 90, 19, seed + 223, 3);
    let gap:i64 = d_fbm(x << 2, 31, seed + 224, 2);
    return ef + 120 + (gap - 512) * 50 / 1024 + (crag - 512) * 120 / 1024;
}
fn d_edge_near(x:i64, em:i64, seed:i64) i64 {
    let scr:i64 = d_ridge((x << 8) / 60, 23, seed + 225, 3);
    let gap:i64 = d_fbm(x << 2, 77, seed + 226, 2);
    return em + 110 + (gap - 512) * 50 / 1024 + (scr - 512) * 120 / 1024;
}

// per-plane heightfield (full detail) and smooth relief variant.
// cell/wcell/oct differ per plane -> character changes with scale.
fn d_mfield(x:i64, y:i64, cell:i64, oct:i64, wcell:i64, seed:i64) i64 {
    let q1:i64 = d_fbm((x << 8) / wcell, (y << 8) / wcell, seed + 211, 3);
    let q2:i64 = d_fbm((x << 8) / wcell + 30011, (y << 8) / wcell + 51113, seed + 212, 3);
    let wx:i64 = (x << 8) / cell + (q1 - 512) * 3;
    let wy:i64 = (y << 8) / cell + (q2 - 512) * 3;
    let hh:i64 = d_ridge(wx, wy, seed + 213, oct);
    let macro:i64 = d_fbm(wx / 30, wy / 30, seed + 214, 3);
    return (hh * 640 + macro * 384) / 1024;
}
fn d_mfield_s(x:i64, y:i64, cell:i64, wcell:i64, seed:i64) i64 {
    let q1:i64 = d_fbm((x << 8) / wcell, (y << 8) / wcell, seed + 211, 3);
    let q2:i64 = d_fbm((x << 8) / wcell + 30011, (y << 8) / wcell + 51113, seed + 212, 3);
    let wx:i64 = (x << 8) / cell + (q1 - 512) * 3;
    let wy:i64 = (y << 8) / cell + (q2 - 512) * 3;
    return d_ridge(wx, wy, seed + 213, 2);
}

// ring alpha profile shared by every ring pass
fn d_ring_alpha(rr:i64, rin:i64, rout:i64, seed:i64) i64 {
    let pr:i64 = 1024 - d_abs(rr - (rin + rout) / 2) * 2048 / (rout - rin);
    if (pr < 0) { pr = 0; }
    let g1:i64 = d_h01(rr * 2, 555, seed + 116);
    let st:i64 = d_h01(rr * 8, 777, seed + 117);
    let alpha:i64 = pr * (550 + g1 * 474 / 1024) / 1024 * (700 + st * 324 / 1024) / 1024;
    return d_clamp(alpha * 900 / 1024, 0, 1024);
}

// sky with the planet integrated (deck behind, wisps in front)
fn d_sky2(x:i64, y:i64, w:i64, h:i64, hy:i64, seed:i64) i64 {
    let t01:i64 = y * 1024 / hy;
    let r:i64 = 16; let g:i64 = 22; let b:i64 = 84;
    if (t01 < 512) {
        let t:i64 = t01 * 2;
        r = d_lerp(16, 28, t); g = d_lerp(22, 104, t); b = d_lerp(84, 148, t);
    }
    if (t01 >= 512) {
        let t:i64 = (t01 - 512) * 2;
        r = d_lerp(28, 168, t); g = d_lerp(104, 214, t); b = d_lerp(148, 208, t);
    }
    // sun glow, upper-left (the same sun that lights terrain + planet)
    let sgx:i64 = x - w * 18 / 100;
    let sgy:i64 = y - h * 8 / 100;
    let sg2:i64 = sgx * sgx + sgy * sgy;
    let glow:i64 = 1048576 / (1024 + sg2 / 90);
    if (glow > 1024) { glow = 1024; }
    r = r + 70 * glow / 1024; g = g + 78 * glow / 1024; b = b + 60 * glow / 1024;
    // cloud deck (BEHIND the planet)
    let qx:i64 = d_fbm(x << 2, y << 2, seed + 111, 3);
    let qy:i64 = d_fbm((x << 2) + 40961, (y << 2) + 17331, seed + 112, 3);
    let ux:i64 = x * 768 / w;
    let uy:i64 = 0;
    if (hy > 0) { uy = y * 384 / hy; }
    let cx:i64 = ux + (qx - 512) / 12;
    let cy:i64 = uy + (qy - 512) / 12;
    let cloud:i64 = d_fbm(cx, cy, seed + 113, 4);
    let m:i64 = d_ss((cloud - 540) * 1024 / 320);
    if (m > 0) {
        let s2:i64 = d_fbm(cx + 30000, cy + 30000, seed + 114, 3);
        let c2:i64 = d_fbm(cx - 26, cy - 18, seed + 113, 4);
        let sf:i64 = d_clamp((c2 - cloud) * 2, -160, 160);
        let sh:i64 = 800 + s2 * 400 / 1024 + sf;
        let cr2:i64 = 228 * sh / 1024; let cg2:i64 = 240 * sh / 1024; let cb2:i64 = 244 * sh / 1024;
        r = d_lerp(r, cr2, m); g = d_lerp(g, cg2, m); b = d_lerp(b, cb2, m);
    }
    // ---- ringed planet, integrated into the sky ----
    let pcx:i64 = w * 68 / 100;
    let pcy:i64 = h * 20 / 100;
    let rp:i64 = w * 15 / 100;
    let pdx:i64 = x - pcx;
    let pdy:i64 = y - pcy;
    let bound:i64 = rp * 25 / 10;
    let near:i64 = 0;
    if (pdx > (0 - bound) && pdx < bound && pdy > (0 - bound) && pdy < bound) { near = 1; }
    if (near == 1) {
        let d2:i64 = pdx * pdx + pdy * pdy;
        let rprp:i64 = rp * rp;
        let u:i64 = pdx;
        let v:i64 = pdy * 1000 / 380;
        let rr:i64 = d_isqrt(u * u + v * v);
        let rin:i64 = rp * 13 / 10;
        let rout:i64 = rp * 23 / 10;
        let inring:i64 = 0;
        if (rr > rin && rr < rout) { inring = 1; }
        // atmospheric forward-scatter halo outside the limb
        if (d2 >= rprp) {
            let dd:i64 = d_isqrt(d2);
            let dh:i64 = dd - rp;
            let hlim:i64 = rp * 35 / 100;
            if (dh >= 0 && dh < hlim) {
                let sfx:i64 = 0; let sfy:i64 = 0;
                if (dd > 0) { sfx = pdx * 1024 / dd; sfy = pdy * 1024 / dd; }
                let sfd:i64 = d_clamp((sfx * (0 - 450) + sfy * (0 - 750)) / 1024, 0, 1024);
                let hh2:i64 = 1024 - dh * 1024 / hlim;
                hh2 = hh2 * hh2 / 1024;
                let ha:i64 = hh2 * (140 + 380 * sfd / 1024) / 1024;
                r = r + 150 * ha / 1024; g = g + 195 * ha / 1024; b = b + 235 * ha / 1024;
            }
        }
        // back ring (behind the planet) with the planet's shadow bite
        if (inring == 1 && pdy < 0 && d2 > rprp) {
            let alpha:i64 = d_ring_alpha(rr, rin, rout, seed);
            let proj:i64 = (pdx * 450 + pdy * 750) / 1024;
            let perp:i64 = d_abs(pdx * 750 - pdy * 450) / 1024;
            let shf:i64 = 1024;
            if (proj > 0 && perp < rp && d2 < rprp * 4) { shf = 460; }
            r = d_lerp(r, 205 * shf / 1024, alpha);
            g = d_lerp(g, 222 * shf / 1024, alpha);
            b = d_lerp(b, 238 * shf / 1024, alpha);
        }
        // planet disc
        if (d2 < rprp) {
            let bx:i64 = (pdx << 8) * 3 / rp;
            let by:i64 = (pdy << 8) * 9 / rp;
            let bw:i64 = d_fbm(bx, by, seed + 118, 3);
            let bxx:i64 = bx + (bw - 512) / 4;
            let byy:i64 = by + (bw - 512) / 4;
            let bandn:i64 = d_fbm(bxx, byy, seed + 119, 5);
            let col:i64 = d_pal4(bandn);
            let cr:i64 = col & 255; let cg:i64 = (col >> 8) & 255; let cb:i64 = (col >> 16) & 255;
            let stn:i64 = d_fbm(bx / 2 + 40000, by / 2 + 40000, seed + 120, 4);
            if (stn > 760) {
                let k:i64 = (stn - 760) * 1024 / 263;
                cr = d_lerp(cr, 232, k); cg = d_lerp(cg, 170, k); cb = d_lerp(cb, 120, k);
            }
            let t2:i64 = 1024 - d2 * 1024 / rprp;
            let ld:i64 = d_isqrt(t2 * 1024);
            let nx:i64 = pdx * 1024 / rp;
            let ny:i64 = pdy * 1024 / rp;
            let nz:i64 = d_isqrt(1048576 - d2 * 1048576 / rprp);
            let dot:i64 = (nx * (0 - 450) + ny * (0 - 750) + nz * 490) / 1024;
            // ring shadow cast on the planet: test the ring one step sunward
            let u2:i64 = pdx - 45;
            let v2:i64 = (pdy - 75) * 1000 / 380;
            let rr2:i64 = d_isqrt(u2 * u2 + v2 * v2);
            let pr2:i64 = 0;
            if (rr2 > rin && rr2 < rout && (pdy - 75) >= 0) {
                pr2 = 1024 - d_abs(rr2 - (rin + rout) / 2) * 2048 / (rout - rin);
                if (pr2 < 0) { pr2 = 0; }
            }
            let shade:i64 = 500 + 524 * d_clamp(dot, 0, 1024) / 1024;
            shade = shade * (1024 - pr2 * 300 / 1024) / 1024;
            r = cr * ld / 1024 * shade / 1024;
            g = cg * ld / 1024 * shade / 1024;
            b = cb * ld / 1024 * shade / 1024;
            // atmospheric limb haze (lit-side brightened)
            let limbd:i64 = d_isqrt(d2) * 1024 / rp;
            let haze:i64 = d_ss((limbd - 860) * 1024 / 164);
            if (haze > 0) {
                let lit:i64 = d_clamp(dot, 0, 1024);
                let lf:i64 = 480 + 544 * lit / 1024;
                let ha2:i64 = haze * 380 / 1024;
                r = d_lerp(r, 150 * lf / 1024, ha2);
                g = d_lerp(g, 195 * lf / 1024, ha2);
                b = d_lerp(b, 235 * lf / 1024, ha2);
            }
        }
        // front ring (in front of the planet)
        if (inring == 1 && pdy >= 0) {
            let alpha:i64 = d_ring_alpha(rr, rin, rout, seed);
            r = d_lerp(r, 215, alpha); g = d_lerp(g, 230, alpha); b = d_lerp(b, 242, alpha);
        }
    }
    // thin cirrus wisps IN FRONT (haze interplay over the lower limb)
    let ci:i64 = d_fbm(cx / 2 + 9000, cy + cy, seed + 115, 4);
    let m2:i64 = d_ss((ci - 560) * 1024 / 200) * 600 / 1024;
    if (near == 1 && pdy > 0) {
        let w2:i64 = d_fbm(cx / 3 + 5000, cy / 2 + 7000, seed + 121, 3);
        let m3:i64 = d_ss((w2 - 500) * 1024 / 260) * 380 / 1024;
        let wd2:i64 = pdx * pdx + pdy * pdy;
        let wfall:i64 = d_clamp((bound * bound - wd2) * 1024 / (bound * bound - rp * rp), 0, 1024);
        m3 = m3 * wfall / 1024;
        if (m3 > m2) { m2 = m3; }
    }
    if (m2 > 0) {
        let wa:i64 = m2 * 480 / 1024;
        r = d_lerp(r, 214, wa); g = d_lerp(g, 228, wa); b = d_lerp(b, 238, wa);
    }
    r = d_clamp(r, 0, 255); g = d_clamp(g, 0, 255); b = d_clamp(b, 0, 255);
    return d_pack(r, g, b);
}

// one mountain depth plane. plane: 0 far massifs, 1 mid crags, 2 near scree.
fn d_mtn(x:i64, y:i64, edge:i64, h:i64, plane:i64, seed:i64) i64 {
    let den:i64 = h - edge;
    if (den < 1) { den = 1; }
    let t:i64 = (y - edge) * 1024 / den;
    if (t < 0) { t = 0; }
    if (t > 1024) { t = 1024; }
    let cell:i64 = 90; let oct:i64 = 4; let wcell:i64 = 30;
    let airb:i64 = 380; let airs:i64 = 120; let con:i64 = 870;
    let detk:i64 = 600; let streakf:i64 = 0; let lavaf:i64 = 0;
    let poff:i64 = 0;
    if (plane == 1) {
        cell = 55; oct = 5; wcell = 22;
        airb = 266; airs = 80; con = 950;
        detk = 800; streakf = 1; poff = 37;
    }
    if (plane == 2) {
        cell = 34; oct = 5; wcell = 14;
        airb = 102; airs = 60; con = 1024;
        detk = 1024; streakf = 1; lavaf = 1; poff = 74;
    }
    let H:i64 = d_mfield(x, y, cell, oct, wcell, seed + poff);
    let gx:i64 = (d_mfield_s(x + 6, y, cell, wcell, seed + poff) - d_mfield_s(x - 6, y, cell, wcell, seed + poff)) / 12;
    let gy:i64 = (d_mfield_s(x, y + 6, cell, wcell, seed + poff) - d_mfield_s(x, y - 6, cell, wcell, seed + poff)) / 12;
    let dot:i64 = 139700 + gx * 450 + gy * 750;
    let shade:i64 = d_clamp(dot * 1024 / 139700, 150, 1400);
    let pert:i64 = d_fbm((x << 8) / wcell, (y << 8) / wcell, seed + 215 + poff, 3);
    let sv:i64 = d_clamp(H + (pert - 512) * 220 / 1024, 0, 1023);
    let col:i64 = d_pal5(sv);
    let r:i64 = (col & 255) * shade / 1024;
    let g:i64 = ((col >> 8) & 255) * shade / 1024;
    let b:i64 = ((col >> 16) & 255) * shade / 1024;
    // crag modulation (mid-scale character differs per plane)
    let crag:i64 = d_ridge((x << 8) / (cell / 2), (y << 8) / (cell / 2), seed + 240 + poff, 3);
    let k:i64 = 900 + crag * 200 / 1024;
    // fine detail with per-plane falloff (detail persists, never mush)
    let det:i64 = d_fbm(x << 6, y << 6, seed + 217 + poff, 2);
    let dm:i64 = 1024 - (1024 - (880 + det * 144 / 1024)) * detk / 1024;
    r = r * k / 1024 * dm / 1024;
    g = g * k / 1024 * dm / 1024;
    b = b * k / 1024 * dm / 1024;
    // erosion streaks (mid + near planes)
    if (streakf == 1) {
        let st:i64 = d_fbm(x << 5, y << 1, seed + 250 + poff, 2);
        let sk:i64 = 940 + st * 120 / 1024;
        r = r * sk / 1024; g = g * sk / 1024; b = b * sk / 1024;
    }
    // contrast around mid gray (depth cue per plane)
    r = 128 + (r - 128) * con / 1024;
    g = 128 + (g - 128) * con / 1024;
    b = 128 + (b - 128) * con / 1024;
    // lava veins (near plane only, kept subtle)
    if (lavaf == 1) {
        let lv:i64 = d_ridge((x << 8) / 9 + (pert - 512) / 8, (y << 8) / 9, seed + 216, 4);
        let dv:i64 = d_abs(lv - 512);
        let glow:i64 = 0;
        if (dv < 60) { glow = (60 - dv) * 1024 / 60; }
        if (t < 150) { glow = glow * t / 150; }
        if (glow > 0) {
            let lr:i64 = 200 + 55 * glow / 1024;
            let lg:i64 = 60 + 130 * glow / 1024;
            let lb:i64 = 20 + 70 * glow / 1024;
            r = d_lerp(r, lr, glow); g = d_lerp(g, lg, glow); b = d_lerp(b, lb, glow);
            let halo:i64 = 0;
            if (dv < 160) { halo = (160 - dv) * 300 / 160; }
            r = d_clamp(r + 255 * halo / 1024, 0, 255);
            g = d_clamp(g + 120 * halo / 1024, 0, 255);
            b = d_clamp(b + 40 * halo / 1024, 0, 255);
        }
    }
    // aerial perspective between the planes
    let air:i64 = airb + t * airs / 1024;
    r = d_lerp(r, 170, air); g = d_lerp(g, 215, air); b = d_lerp(b, 210, air);
    r = d_clamp(r, 0, 255); g = d_clamp(g, 0, 255); b = d_clamp(b, 0, 255);
    return d_pack(r, g, b);
}

// per-pixel dispatch: sky or one of the three depth planes
fn d_alien_px(x:i64, y:i64, w:i64, h:i64, h0:i64, seed:i64) i64 {
    let ef:i64 = d_edge_far(x, h0, seed);
    if (y < ef) { return d_sky2(x, y, w, h, h0, seed); }
    let em:i64 = d_edge_mid(x, ef, seed);
    if (y < em) { return d_mtn(x, y, ef, h, 0, seed); }
    let en:i64 = d_edge_near(x, em, seed);
    if (y < en) { return d_mtn(x, y, em, h, 1, seed); }
    return d_mtn(x, y, en, h, 2, seed);
}

fn d_pal5(v:i64) i64 {
    let vv:i64 = d_clamp(v, 0, 1023);
    let bi:i64 = vv * 4 / 1024;
    if (bi > 3) { bi = 3; }
    let fr:i64 = vv * 4 - bi * 1024;
    // stops: basalt / rust / ochre / pale sand / violet-gray
    let r0:i64 = 38; let g0:i64 = 34; let b0:i64 = 52;
    let r1:i64 = 150; let g1:i64 = 74; let b1:i64 = 40;
    let r2:i64 = 196; let g2:i64 = 132; let b2:i64 = 62;
    let r3:i64 = 214; let g3:i64 = 186; let b3:i64 = 140;
    let r4:i64 = 140; let g4:i64 = 128; let b4:i64 = 140;
    let ra:i64 = r0; let ga:i64 = g0; let ba:i64 = b0;
    let rb:i64 = r1; let gb:i64 = g1; let bb:i64 = b1;
    if (bi == 1) { ra = r1; ga = g1; ba = b1; rb = r2; gb = g2; bb = b2; }
    if (bi == 2) { ra = r2; ga = g2; ba = b2; rb = r3; gb = g3; bb = b3; }
    if (bi == 3) { ra = r3; ga = g3; ba = b3; rb = r4; gb = g4; bb = b4; }
    return d_pack(d_lerp(ra, rb, fr), d_lerp(ga, gb, fr), d_lerp(ba, bb, fr));
}

// 4-stop planet palette, v in 0..1023 -> packed color
fn d_pal4(v:i64) i64 {
    let vv:i64 = d_clamp(v, 0, 1023);
    let bi:i64 = vv * 3 / 1024;
    if (bi > 2) { bi = 2; }
    let fr:i64 = vv * 3 - bi * 1024;
    let r0:i64 = 16; let g0:i64 = 64; let b0:i64 = 86;
    let r1:i64 = 36; let g1:i64 = 128; let b1:i64 = 150;
    let r2:i64 = 150; let g2:i64 = 200; let b2:i64 = 195;
    let r3:i64 = 225; let g3:i64 = 214; let b3:i64 = 178;
    let ra:i64 = r0; let ga:i64 = g0; let ba:i64 = b0;
    let rb:i64 = r1; let gb:i64 = g1; let bb:i64 = b1;
    if (bi == 1) { ra = r1; ga = g1; ba = b1; rb = r2; gb = g2; bb = b2; }
    if (bi == 2) { ra = r2; ga = g2; ba = b2; rb = r3; gb = g3; bb = b3; }
    return d_pack(d_lerp(ra, rb, fr), d_lerp(ga, gb, fr), d_lerp(ba, bb, fr));
}

// sky pixel -> packed color


fn d_render_alien(buf:[]u8, w:i64, h:i64, stride:i64, seed:i64) void {
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let h0:i64 = h / 2 + (d_fbm(x << 1, 7, seed + 101, 3) - 512) * h / 16000;
            let col:i64 = d_alien_px(x, y, w, h, h0, seed);
            let dh:i64 = d_h01(x, y, seed + 999);
            let off:i64 = (dh - 512) * 6 / 1024;
            let r:i64 = d_clamp((col & 255) + off, 0, 255);
            let g:i64 = d_clamp(((col >> 8) & 255) + off, 0, 255);
            let b:i64 = d_clamp(((col >> 16) & 255) + off, 0, 255);
            let o:i64 = 54 + (h - 1 - y) * stride + x * 3;
            buf[o] = b as u8;
            buf[o + 1] = g as u8;
            buf[o + 2] = r as u8;
            x = x + 1;
        }
        if (y - (y / 128) * 128 == 0) {
            _zag_print("row ");
            _zag_println(_zag_i64_to_str(y));
        }
        y = y + 1;
    }
}

fn d_in_quad(px:f64, py:f64, ax:f64, ay:f64, bx:f64, by:f64, cx:f64, cy:f64, dx:f64, dy:f64) i64 {
    let c1:f64 = (bx - ax) * (py - ay) - (by - ay) * (px - ax);
    let c2:f64 = (cx - bx) * (py - by) - (cy - by) * (px - bx);
    let c3:f64 = (dx - cx) * (py - cy) - (dy - cy) * (px - cx);
    let c4:f64 = (ax - dx) * (py - dy) - (ay - dy) * (px - dx);
    if (c1 >= 0.0 && c2 >= 0.0 && c3 >= 0.0 && c4 >= 0.0) { return 1; }
    if (c1 <= 0.0 && c2 <= 0.0 && c3 <= 0.0 && c4 <= 0.0) { return 1; }
    return 0;
}

// point-to-segment distance
fn d_segdist(px:f64, py:f64, ax:f64, ay:f64, bx:f64, by:f64) f64 {
    let ex:f64 = bx - ax;
    let ey:f64 = by - ay;
    let l2:f64 = ex * ex + ey * ey;
    if (l2 <= 0.0) { return d_sqrt((px - ax) * (px - ax) + (py - ay) * (py - ay)); }
    let s:f64 = ((px - ax) * ex + (py - ay) * ey) / l2;
    if (s < 0.0) { s = 0.0; }
    if (s > 1.0) { s = 1.0; }
    let qx:f64 = ax + s * ex - px;
    let qy:f64 = ay + s * ey - py;
    return d_sqrt(qx * qx + qy * qy);
}

// across = signed distance from beam centerline / half-width (-1..1)
fn d_beam_across(px:f64, py:f64, ax:f64, ay:f64, bx:f64, by:f64, hw:f64) f64 {
    let ex:f64 = bx - ax;
    let ey:f64 = by - ay;
    let len:f64 = d_sqrt(ex * ex + ey * ey);
    if (len <= 0.0) { return 0.0; }
    return ((px - ax) * ey - (py - ay) * ex) / (len * hw);
}



// ============================================================
// D-IMG-2 v2 — impossible architecture, repaired joinery.
// Repair notes (2026-09-22, round 2):
//  * corners: no hard butt lines. The winner's lap gets a scarf
//    bevel + end fade, a lap highlight lip on its inner edge,
//    and the loser gets a soft contact shadow beside the cut;
//    pocket AO grounds the inner corner. Coverage still comes
//    from the mitered quads with cyclic priority (each beam
//    over one neighbor, under the other).
//  * per-beam material: separate grain/mottle/crack seeds plus
//    directional weathering streaks along each beam's axis,
//    scratch lines, per-beam tint and edge wear.
//  * shadow: 12-sample cone along the light direction ->
//    contact-hardened soft shadow with penumbra.
//  * environment: night sky, rock wall, stone floor with light
//    pool, distance fog and horizon AO — an object in a world.
// ============================================================

// soft shadow of the frame: 12 samples in a widening cone along
// the light direction -> density 0..1 (contact-hardened penumbra)
fn d_frame_shadow(px:f64, py:f64, a0x:f64, a0y:f64, b0x:f64, b0y:f64, c0x:f64, c0y:f64, d0x:f64, d0y:f64, a1x:f64, a1y:f64, b1x:f64, b1y:f64, c1x:f64, c1y:f64, d1x:f64, d1y:f64, a2x:f64, a2y:f64, b2x:f64, b2y:f64, c2x:f64, c2y:f64, d2x:f64, d2y:f64, hw:f64) f64 {
    let dens:f64 = 0.0;
    let k:i64 = 0;
    while (k < 4) {
        let fk:f64 = (k as f64) / 3.0;
        let off:f64 = hw * 3.0 * fk;
        let j:i64 = -1;
        while (j < 2) {
            let pp:f64 = (j as f64) * hw * 0.9 * fk;
            let sx:f64 = px + 0.3714 * off + 0.9285 * pp;
            let sy:f64 = py + 0.9285 * off - 0.3714 * pp;
            let u0:i64 = d_in_quad(sx, sy, a0x, a0y, b0x, b0y, c0x, c0y, d0x, d0y);
            let u1:i64 = d_in_quad(sx, sy, a1x, a1y, b1x, b1y, c1x, c1y, d1x, d1y);
            let u2:i64 = d_in_quad(sx, sy, a2x, a2y, b2x, b2y, c2x, c2y, d2x, d2y);
            if (u0 + u1 + u2 > 0) { dens = dens + 1.0; }
            j = j + 1;
        }
        k = k + 1;
    }
    return dens / 12.0;
}

// environment: night sky, rock wall, stone floor
fn d_env_px(x:i64, y:i64, w:i64, h:i64, seed:i64) i64 {
    let horizon:i64 = h * 80 / 100;
    let walltop:i64 = h * 16 / 100;
    let r:i64 = 0; let g:i64 = 0; let b:i64 = 0;
    if (y < walltop) {
        let t:i64 = y * 1024 / walltop;
        r = d_lerp(10, 22, t); g = d_lerp(12, 28, t); b = d_lerp(20, 44, t);
        let sp:i64 = d_h01(x, y, seed + 340);
        if (sp > 1018) {
            let si:i64 = (sp - 1018) * 40;
            r = r + si; g = g + si; b = b + si + 10;
        }
        let gsx:i64 = x - w * 18 / 100;
        let gsy:i64 = y - h * 6 / 100;
        let gl2:i64 = 1024 - d_clamp(d_isqrt(gsx * gsx + gsy * gsy) * 1024 / 700, 0, 1024);
        r = r + 26 * gl2 / 1024; g = g + 30 * gl2 / 1024; b = b + 44 * gl2 / 1024;
    } else {
        if (y < horizon) {
            let wsv:i64 = d_fbm((x << 8) / 48 + (d_fbm(x << 2, y << 2, seed + 323, 2) - 512) / 8, (y << 8) / 48, seed + 321, 3);
            let sb:i64 = d_ss((wsv - 512) * 3);
            let mo2:i64 = d_fbm(x << 3, y << 3, seed + 322, 4);
            let vg:i64 = 760 + y * 264 / horizon;
            let wf:i64 = (900 + sb * 200 / 1024) * (900 + mo2 * 200 / 1024) / 1024;
            r = 26 * wf / 1024 * vg / 1024;
            g = 30 * wf / 1024 * vg / 1024;
            b = 42 * wf / 1024 * vg / 1024;
            if (y - walltop < 8) {
                let lf2:i64 = 820 + (y - walltop) * 180 / 8;
                r = r * lf2 / 1024; g = g * lf2 / 1024; b = b * lf2 / 1024;
            }
            let wsx:i64 = x - w * 18 / 100;
            let wsy:i64 = y - h * 6 / 100;
            let wg:i64 = 1024 - d_clamp(d_isqrt(wsx * wsx + wsy * wsy) * 1024 / 900, 0, 1024);
            r = r + 22 * wg / 1024; g = g + 24 * wg / 1024; b = b + 34 * wg / 1024;
        } else {
            let gg:i64 = (y - horizon) * 1024 / (h - horizon);
            let n1:i64 = d_fbm((x << 8) / 24, ((y - horizon) << 8) / 20, seed + 331, 3);
            let n2:i64 = d_fbm((x << 8) / 90, ((y - horizon) << 8) / 70, seed + 332, 3);
            let nn:i64 = (n1 * gg + n2 * (1024 - gg)) / 1024;
            let gf2:i64 = 860 + nn * 200 / 1024;
            r = 46 * gf2 / 1024; g = 44 * gf2 / 1024; b = 48 * gf2 / 1024;
            let pdx2:f64 = (x as f64) - (w as f64) * 0.5;
            let pdy2:f64 = (y as f64) - (horizon as f64) - 30.0;
            let pool:f64 = 1048576.0 / (1048576.0 + (pdx2 * pdx2 + pdy2 * pdy2) / 900.0);
            r = r + ((88.0 * pool) as i64);
            g = g + ((84.0 * pool) as i64);
            b = b + ((90.0 * pool) as i64);
            let fog:i64 = (1024 - gg) * 400 / 1024;
            r = d_lerp(r, 26, fog); g = d_lerp(g, 30, fog); b = d_lerp(b, 42, fog);
            if (y - horizon < 12) {
                let ao3:i64 = 768 + (y - horizon) * 256 / 12;
                r = r * ao3 / 1024; g = g * ao3 / 1024; b = b * ao3 / 1024;
            }
        }
    }
    r = d_clamp(r, 0, 255); g = d_clamp(g, 0, 255); b = d_clamp(b, 0, 255);
    return d_pack(r, g, b);
}

fn d_render_arch(buf:[]u8, w:i64, h:i64, stride:i64, seed:i64) void {
    let cx:f64 = (w as f64) * 0.5;
    let cy:f64 = (h as f64) * 0.47;
    let rr:f64 = (h as f64) * 0.36;
    let hw:f64 = (h as f64) * 0.052;
    // vertices: top, bottom-left, bottom-right
    let v0x:f64 = cx; let v0y:f64 = cy - rr;
    let v1x:f64 = cx - rr * 0.8660254; let v1y:f64 = cy + rr * 0.5;
    let v2x:f64 = cx + rr * 0.8660254; let v2y:f64 = cy + rr * 0.5;
    // beam unit directions
    let e01x:f64 = v1x - v0x; let e01y:f64 = v1y - v0y;
    let l01:f64 = d_sqrt(e01x * e01x + e01y * e01y);
    let u01x:f64 = e01x / l01; let u01y:f64 = e01y / l01;
    let e12x:f64 = v2x - v1x; let e12y:f64 = v2y - v1y;
    let l12:f64 = d_sqrt(e12x * e12x + e12y * e12y);
    let u12x:f64 = e12x / l12; let u12y:f64 = e12y / l12;
    let e20x:f64 = v0x - v2x; let e20y:f64 = v0y - v2y;
    let l20:f64 = d_sqrt(e20x * e20x + e20y * e20y);
    let u20x:f64 = e20x / l20; let u20y:f64 = e20y / l20;
    // miter points at each corner (winner gets full miter; inner edge extends)
    // V0: in=u20 out=u01 ; V1: in=u01 out=u12 ; V2: in=u12 out=u20
    let ib0x:f64 = u01x - u20x; let ib0y:f64 = u01y - u20y;
    let il0:f64 = d_sqrt(ib0x * ib0x + ib0y * ib0y);
    ib0x = ib0x / il0; ib0y = ib0y / il0;
    let ct0:f64 = u20x * u01x + u20y * u01y;
    let ml0:f64 = hw / d_sqrt((1.0 - ct0) * 0.5);
    let o0ox:f64 = v0x - ml0 * ib0x; let o0oy:f64 = v0y - ml0 * ib0y;
    let o0ix:f64 = v0x + ml0 * ib0x; let o0iy:f64 = v0y + ml0 * ib0y;
    let ib1x:f64 = u12x - u01x; let ib1y:f64 = u12y - u01y;
    let il1:f64 = d_sqrt(ib1x * ib1x + ib1y * ib1y);
    ib1x = ib1x / il1; ib1y = ib1y / il1;
    let ct1:f64 = u01x * u12x + u01y * u12y;
    let ml1:f64 = hw / d_sqrt((1.0 - ct1) * 0.5);
    let o1ox:f64 = v1x - ml1 * ib1x; let o1oy:f64 = v1y - ml1 * ib1y;
    let o1ix:f64 = v1x + ml1 * ib1x; let o1iy:f64 = v1y + ml1 * ib1y;
    let ib2x:f64 = u20x - u12x; let ib2y:f64 = u20y - u12y;
    let il2:f64 = d_sqrt(ib2x * ib2x + ib2y * ib2y);
    ib2x = ib2x / il2; ib2y = ib2y / il2;
    let ct2:f64 = u12x * u20x + u12y * u20y;
    let ml2:f64 = hw / d_sqrt((1.0 - ct2) * 0.5);
    let o2ox:f64 = v2x - ml2 * ib2x; let o2oy:f64 = v2y - ml2 * ib2y;
    let o2ix:f64 = v2x + ml2 * ib2x; let o2iy:f64 = v2y + ml2 * ib2y;
    // overlap extension of the winner's inner edge past each corner
    let ext:f64 = hw * 1.5;
    // beam quads (outer-start, outer-end, inner-end, inner-start)
    // b0: V0->V1 wins at V1 ; b1: V1->V2 wins at V2 ; b2: V2->V0 wins at V0
    let a0x:f64 = o0ox; let a0y:f64 = o0oy;
    let b0x:f64 = o1ox; let b0y:f64 = o1oy;
    let c0x:f64 = o1ix + ext * u01x; let c0y:f64 = o1iy + ext * u01y;
    let d0x:f64 = o0ix; let d0y:f64 = o0iy;
    let a1x:f64 = o1ox; let a1y:f64 = o1oy;
    let b1x:f64 = o2ox; let b1y:f64 = o2oy;
    let c1x:f64 = o2ix + ext * u12x; let c1y:f64 = o2iy + ext * u12y;
    let d1x:f64 = o1ix; let d1y:f64 = o1iy;
    let a2x:f64 = o2ox; let a2y:f64 = o2oy;
    let b2x:f64 = o0ox; let b2y:f64 = o0oy;
    let c2x:f64 = o0ix + ext * u20x; let c2y:f64 = o0iy + ext * u20y;
    let d2x:f64 = o2ix; let d2y:f64 = o2iy;
    let m0ax:f64 = (o0ox + o0ix) * 0.5; let m0ay:f64 = (o0oy + o0iy) * 0.5;
    let m0bx:f64 = (o1ox + o1ix) * 0.5; let m0by:f64 = (o1oy + o1iy) * 0.5;
    let m1ax:f64 = (o1ox + o1ix) * 0.5; let m1ay:f64 = (o1oy + o1iy) * 0.5;
    let m1bx:f64 = (o2ox + o2ix) * 0.5; let m1by:f64 = (o2oy + o2iy) * 0.5;
    let m2ax:f64 = (o2ox + o2ix) * 0.5; let m2ay:f64 = (o2oy + o2iy) * 0.5;
    let m2bx:f64 = (o0ox + o0ix) * 0.5; let m2by:f64 = (o0oy + o0iy) * 0.5;
    // light direction (top, slightly left)
    let ldx:f64 = 0.0 - 0.3714; let ldy:f64 = 0.0 - 0.9285;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let px:f64 = x as f64;
            let py:f64 = y as f64;
            let in0:i64 = d_in_quad(px, py, a0x, a0y, b0x, b0y, c0x, c0y, d0x, d0y);
            let in1:i64 = d_in_quad(px, py, a1x, a1y, b1x, b1y, c1x, c1y, d1x, d1y);
            let in2:i64 = d_in_quad(px, py, a2x, a2y, b2x, b2y, c2x, c2y, d2x, d2y);
            let cov:i64 = in0 + in1 + in2;
            let r:i64 = 0; let g:i64 = 0; let b:i64 = 0;
            if (cov == 0) {
                // ---- environment + soft contact-hardened shadow + vignette
                let env:i64 = d_env_px(x, y, w, h, seed);
                r = env & 255; g = (env >> 8) & 255; b = (env >> 16) & 255;
                let walltop2:i64 = h * 16 / 100;
                if (y > walltop2) {
                    let densf:f64 = d_frame_shadow(px, py, a0x, a0y, b0x, b0y, c0x, c0y, d0x, d0y, a1x, a1y, b1x, b1y, c1x, c1y, d1x, d1y, a2x, a2y, b2x, b2y, c2x, c2y, d2x, d2y, hw);
                    let shf2:f64 = 1.0 - 0.62 * densf;
                    r = (((r as f64) * shf2) as i64);
                    g = (((g as f64) * shf2) as i64);
                    b = (((b as f64) * shf2) as i64);
                }
                let dxv:f64 = px - cx; let dyv:f64 = py - cy;
                let vd:f64 = d_sqrt(dxv * dxv + dyv * dyv) / ((h as f64) * 0.75);
                let vf:f64 = 1.0;
                if (vd < 1.0) { vf = 1.0 - 0.30 * vd * vd; }
                if (vd >= 1.0) { vf = 0.70; }
                r = (((r as f64) * vf) as i64);
                g = (((g as f64) * vf) as i64);
                b = (((b as f64) * vf) as i64);
            } else {
                // ---- beam pixel: nearest vertex -> joint context (flat)
                let e0d:f64 = (px - v0x) * (px - v0x) + (py - v0y) * (py - v0y);
                let e1d:f64 = (px - v1x) * (px - v1x) + (py - v1y) * (py - v1y);
                let e2d:f64 = (px - v2x) * (px - v2x) + (py - v2y) * (py - v2y);
                let nv:i64 = 0;
                if (e1d < e0d && e1d < e2d) { nv = 1; }
                if (e2d < e0d && e2d < e1d) { nv = 2; }
                // cyclic priority: V0->b2 wins, V1->b0 wins, V2->b1 wins
                let win:i64 = 2;
                if (cov == 1 && in0 == 1) { win = 0; }
                if (cov == 1 && in1 == 1) { win = 1; }
                if (cov > 1 && nv == 0) { win = 2; }
                if (cov > 1 && nv == 1) { win = 0; }
                if (cov > 1 && nv == 2) { win = 1; }
                // winner beam geometry
                let cax:f64 = m0ax; let cay:f64 = m0ay;
                let cbx:f64 = m0bx; let cby:f64 = m0by;
                let wux:f64 = u01x; let wuy:f64 = u01y;
                if (win == 1) {
                    cax = m1ax; cay = m1ay; cbx = m1bx; cby = m1by;
                    wux = u12x; wuy = u12y;
                }
                if (win == 2) {
                    cax = m2ax; cay = m2ay; cbx = m2bx; cby = m2by;
                    wux = u20x; wuy = u20y;
                }
                // across-beam coordinate + 3D bevel shading (top-light)
                let across:f64 = d_beam_across(px, py, cax, cay, cbx, cby, hw);
                if (across > 1.0) { across = 1.0; }
                if (across < 0.0 - 1.0) { across = 0.0 - 1.0; }
                let aa:f64 = across;
                if (aa < 0.0) { aa = 0.0 - aa; }
                let bright:f64 = 1.0 - 0.36 * aa * aa - 0.04 * aa;
                let mx:f64 = wuy; let my:f64 = 0.0 - wux;
                let facing:f64 = mx * ldx + my * ldy;
                let side:f64 = across * facing;
                bright = bright * (1.0 + 0.13 * side);
                if (aa > 0.78 && side > 0.0) { bright = bright * 1.09; }
                // joint context for this vertex
                let jox:f64 = o0ox; let joy:f64 = o0oy;
                let jtx:f64 = o0ix + ext * u20x; let jty:f64 = o0iy + ext * u20y;
                let jix:f64 = o0ix; let jiy:f64 = o0iy;
                let jvx:f64 = v0x; let jvy:f64 = v0y;
                let jw:i64 = 2; let jl:i64 = 0;
                if (nv == 1) {
                    jox = o1ox; joy = o1oy;
                    jtx = o1ix + ext * u01x; jty = o1iy + ext * u01y;
                    jix = o1ix; jiy = o1iy;
                    jvx = v1x; jvy = v1y;
                    jw = 0; jl = 1;
                }
                if (nv == 2) {
                    jox = o2ox; joy = o2oy;
                    jtx = o2ix + ext * u12x; jty = o2iy + ext * u12y;
                    jix = o2ix; jiy = o2iy;
                    jvx = v2x; jvy = v2y;
                    jw = 1; jl = 2;
                }
                // streak origin/dir for this beam
                let sox:f64 = o0ox; let soy:f64 = o0oy;
                let sdx:f64 = u01x; let sdy:f64 = u01y;
                if (win == 1) { sox = o1ox; soy = o1oy; sdx = u12x; sdy = u12y; }
                if (win == 2) { sox = o2ox; soy = o2oy; sdx = u20x; sdy = u20y; }
                // joinery: scarf bevel on the winner's lap, lap highlight
                // lip, soft contact shadow on the loser, pocket AO
                let iswin:i64 = 0;
                if (win == jw) { iswin = 1; }
                let islos:i64 = 0;
                if (win == jl) { islos = 1; }
                let dcut:f64 = d_segdist(px, py, jox, joy, jtx, jty);
                if (iswin == 1 && dcut < 10.0) { bright = bright * (1.0 - 0.30 * (1.0 - dcut / 10.0)); }
                if (islos == 1 && dcut < 16.0) { bright = bright * (1.0 - 0.38 * (1.0 - dcut / 16.0)); }
                if (iswin == 1) {
                    let eef:f64 = (px - jix) * sdx + (py - jiy) * sdy;
                    if (eef > 0.0) {
                        let efn:f64 = eef / ext;
                        if (efn > 1.0) { efn = 1.0; }
                        bright = bright * (1.0 - 0.18 * efn * efn * (3.0 - 2.0 * efn));
                    }
                    let dvx:f64 = px - jvx; let dvy:f64 = py - jvy;
                    let dvv:f64 = d_sqrt(dvx * dvx + dvy * dvy);
                    if (dvv < hw * 4.0) {
                        let din:f64 = d_segdist(px, py, jix, jiy, jtx, jty);
                        if (din < 2.5) { bright = bright * 1.12; }
                    }
                }
                let dpix:f64 = px - jix; let dpiy:f64 = py - jiy;
                let dpi:f64 = d_sqrt(dpix * dpix + dpiy * dpiy);
                let ao2:f64 = 1.0;
                let aor2:f64 = hw * 2.5;
                if (dpi < aor2) { ao2 = 0.82 + 0.18 * dpi / aor2; }
                // per-beam material: directional weathering along the beam
                let mseed:i64 = seed + 301 + win * 7919;
                let g5:i64 = d_fbm(x << 4, y << 4, mseed, 4);
                let mo:i64 = d_fbm(x << 1, y << 1, mseed + 1, 3);
                let sfp:i64 = (((px - sox) * sdx + (py - soy) * sdy) * 8.0) as i64;
                let qfp:i64 = ((across * 160.0) as i64) + 50000 + win * 2000;
                let streak:i64 = d_fbm(sfp, qfp, mseed + 3, 3);
                let scratch:i64 = d_ridge(sfp * 2, qfp * 2 + 9000, mseed + 4, 2);
                let crk:i64 = d_ridge((x << 8) / 10, (y << 8) / 10, mseed + 2, 3);
                let wear:i64 = d_fbm(sfp / 4, qfp, mseed + 5, 2);
                let alb:f64 = (860.0 + (g5 as f64) * 260.0 / 1024.0) / 1024.0;
                alb = alb * (900.0 + (mo as f64) * 200.0 / 1024.0) / 1024.0;
                alb = alb * (940.0 + (streak as f64) * 120.0 / 1024.0) / 1024.0;
                if (scratch > 900) {
                    alb = alb * (0.86 + 0.14 * (1023.0 - (scratch as f64)) / 123.0);
                }
                let crackf:f64 = 1.0;
                if (crk > 880) { crackf = 0.5 + 0.5 * (1023.0 - (crk as f64)) / 143.0; }
                let tr:f64 = 1.0; let tg:f64 = 1.0; let tb:f64 = 1.0;
                if (win == 0) { tr = 1.045; tb = 0.94; }
                if (win == 1) { tr = 0.975; tb = 1.045; }
                if (win == 2) { tg = 1.01; tb = 0.99; }
                let ee2:f64 = aa;
                if (ee2 > 1.0) { ee2 = 1.0; }
                let wv:f64 = ((wear - 512) as f64) / 512.0;
                let kk:f64 = bright * alb * crackf * ao2 * (1.0 + 0.10 * ee2 * wv);
                r = ((198.0 * tr * kk) as i64);
                g = ((190.0 * tg * kk) as i64);
                b = ((174.0 * tb * kk) as i64);
                if (r < 0) { r = 0; }
                if (r > 255) { r = 255; }
                if (g < 0) { g = 0; }
                if (g > 255) { g = 255; }
                if (b < 0) { b = 0; }
                if (b > 255) { b = 255; }
            }
            // monochromatic fine dither (texture, never blur)
            let dh:i64 = d_h01(x, y, seed + 999);
            let off:i64 = (dh - 512) * 6 / 1024;
            let rf:i64 = d_clamp(r + off, 0, 255);
            let gf:i64 = d_clamp(g + off, 0, 255);
            let bf:i64 = d_clamp(b + off, 0, 255);
            let o:i64 = 54 + (h - 1 - y) * stride + x * 3;
            buf[o] = bf as u8;
            buf[o + 1] = gf as u8;
            buf[o + 2] = rf as u8;
            x = x + 1;
        }
        if (y - (y / 128) * 128 == 0) {
            _zag_print("row ");
            _zag_println(_zag_i64_to_str(y));
        }
        y = y + 1;
    }
}

fn d_open_trunc(root:i64, name:[]u8) i64 {
    let s:[]u8 = nio_cstr(name);
    if (s.len == 0) { return -7401; }
    // O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK
    let flags:i64 = 657985;
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, flags, 420, 0, 0);
    nio_free(s);
    return fd;
}

fn d_write_bmp(root:i64, name:[]u8, buf:[]u8, w:i64, h:i64, stride:i64) i64 {
    buf[0] = 66; buf[1] = 77;
    d_put32le(buf, 2, 54 + stride * h);
    d_put32le(buf, 6, 0);
    d_put32le(buf, 10, 54);
    d_put32le(buf, 14, 40);
    d_put32le(buf, 18, w);
    d_put32le(buf, 22, h);
    buf[26] = 1; buf[27] = 0;
    buf[28] = 24; buf[29] = 0;
    d_put32le(buf, 30, 0);
    d_put32le(buf, 34, stride * h);
    d_put32le(buf, 38, 2835);
    d_put32le(buf, 42, 2835);
    d_put32le(buf, 46, 0);
    d_put32le(buf, 50, 0);
    let total:i64 = 54 + stride * h;
    let fd:i64 = d_open_trunc(root, name);
    if (fd < 0) { return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = buf[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}

fn main() i32 {
    let subj:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    let szs:[]u8 = _zag_arg(3);
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let w:i64 = 1024;
    let h:i64 = 1024;
    let is2048:i64 = 0;
    if (_zag_strcmp(szs, "2048") == 1) { w = 2048; h = 2048; is2048 = 1; }
    let is_arch:i64 = 0;
    if (_zag_strcmp(subj, "arch") == 1) { is_arch = 1; }
    if (_zag_strcmp(subj, "alien") != 1 && is_arch == 0) {
        _zag_println("usage: disc <alien|arch> <outdir> <1024|2048>");
        return 1;
    }
    let name:[]u8 = "d-img-1_alien_1024.bmp";
    if (is_arch == 1 && is2048 == 0) { name = "d-img-2_arch_1024.bmp"; }
    if (is_arch == 0 && is2048 == 1) { name = "d-img-1_alien_2048.bmp"; }
    if (is_arch == 1 && is2048 == 1) { name = "d-img-2_arch_2048.bmp"; }
    let root:i64 = nio_open_root(outd);
    if (root < 0) {
        _zag_println("cannot open outdir");
        return 1;
    }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let total:i64 = 54 + stride * h;
    _zag_print("rendering ");
    _zag_println(name);
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) {
        _zag_println("alloc failed");
        nio_close(root);
        return 1;
    }
    if (is_arch == 1) {
        d_render_arch(buf, w, h, stride, 7202);
    } else {
        d_render_alien(buf, w, h, stride, 7101);
    }
    let rc:i64 = d_write_bmp(root, name, buf, w, h, stride);
    nio_free(buf);
    nio_close(root);
    if (rc != 0) {
        _zag_print("write failed ");
        _zag_println(_zag_i64_to_str(rc));
        return 1;
    }
    _zag_println("done");
    return 0;
}

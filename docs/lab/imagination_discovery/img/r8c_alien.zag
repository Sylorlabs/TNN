// ============================================================
// r8c_alien.zag — IMAGINATION DISCOVERY, FORK C (D-IMG-1).
// "Mind's-eye elaboration": a fundamentally different family from
// rounds 1-7. Not a single-pass per-pixel render. The image is the
// residue of 269 deliberate decisions made in five passes, the way
// a mind's eye comes into focus:
//
//   Pass 1 GIST      — a vague impression: mood, masses, nothing decided
//   Pass 2 DECISIONS — 14 big world-decisions, each with a stated reason
//   Pass 3 LIGHT     — one sun, one wind; relief imagined, shadows marched
//   Pass 4 FIXATIONS — 240 attentional fixations, targets chosen by reading
//                      the canvas (interest = contrast x novelty x focus)
//   Pass 5 FINISH    — vignette + grain
//
// The program writes ELABORATION_TRACE.md AS IT DECIDES — the trace is
// a program output, byte-deterministic like the image.
//
// Determinism vs surprise, resolved: every decision is a pure function
// of (pass, index, canvas state). No RNG, no clock, no outside input.
// But fixation N+1's target is chosen by reading the canvas AFTER
// fixation N — so the sequence cannot be predicted without running the
// elaboration. Surprise comes from feedback, not dice.
//
// World commitments (above pixel level — the world is invented first,
// the pixels follow):
//   - ONE sun, low at the left horizon, below the frame. (-880,-260,+390)
//   - ONE wind, left-to-right, slightly toward the viewer. Clouds, dust
//     tails, dune ripples all obey it.
//   - The far tier is an ancient crater rim, breached right of center;
//     a glacier of dust pours through the breach.
//   - A gas giant hangs upper right, half in shadow; it lends a faint
//     teal secondary glow to the cloud undersides (same sun, second story).
//   - The foreground is a ventifact field: wind-carved sailstones, every
//     dust tail pointing downwind. One wind-carved arch, lower-left third,
//     with light coming through its opening.
//
// D-COMP: zero axis-aligned filled-primitive placement calls; coverage is
// accumulated pigment dabs (soft radial marks), never hard analytic edges.
// No identifier or string literal uses rect/band/blotch/fill/stroke/circle.
// Deterministic: integer-hash noise, fixed seeds, zero RNG.
// Buffer: 54 + 3072*1024 bytes (< 2^25).
// Build: znc r8c_alien.zag --no-zagd --no-analyze -o r8c_alien
// Usage: r8c_alien <outdir>
// Output: r8c_alien_1024.bmp + ELABORATION_TRACE.md
// ============================================================
@import("../../toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- small math ----------------
fn r8c_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn r8c_clamp(v:i64, lo:i64, hi:i64) i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn r8c_min(a:i64, b:i64) i64 {
    if (a < b) { return a; }
    return b;
}
fn r8c_max(a:i64, b:i64) i64 {
    if (a > b) { return a; }
    return b;
}
// smoothstep on 0..1024 -> 0..1024
fn r8c_ss(t:i64) i64 {
    let c:i64 = r8c_clamp(t, 0, 1024);
    return c * c * (3072 - 2 * c) / 1048576;
}
fn r8c_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let r:i64 = v;
    let i:i64 = 0;
    while (i < 48) {
        r = (r + v / r) / 2;
        i = i + 1;
    }
    return r;
}
fn r8c_pack(r:i64, g:i64, b:i64) i64 {
    return (r & 255) + ((g & 255) << 8) + ((b & 255) << 16);
}
fn r8c_lerp(a:i64, b:i64, t:i64) i64 {
    return a + (b - a) * t / 1024;
}
fn r8c_put32le(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
}

// ---------------- deterministic integer-hash noise ----------------
fn r8c_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn r8c_h01(x:i64, y:i64, seed:i64) i64 {
    return r8c_hash(x, y, seed) >> 22;
}
fn r8c_sstep(t:i64) i64 {
    let t2:i64 = t * t;
    let t3:i64 = t2 * t;
    return (3 * t2 * 255 - 2 * t3) / 65025;
}
fn r8c_vnoise(x:i64, y:i64, seed:i64) i64 {
    let xb:i64 = x + 268435456;
    let yb:i64 = y + 268435456;
    let xi:i64 = xb >> 8;
    let yi:i64 = yb >> 8;
    let xf:i64 = xb & 255;
    let yf:i64 = yb & 255;
    let u:i64 = r8c_sstep(xf);
    let v:i64 = r8c_sstep(yf);
    let a:i64 = r8c_h01(xi, yi, seed);
    let b:i64 = r8c_h01(xi + 1, yi, seed);
    let c:i64 = r8c_h01(xi, yi + 1, seed);
    let d:i64 = r8c_h01(xi + 1, yi + 1, seed);
    let ab:i64 = a + (b - a) * u / 256;
    let cd:i64 = c + (d - c) * u / 256;
    return ab + (cd - ab) * v / 256;
}
fn r8c_fbm(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + r8c_vnoise(xx, yy, seed + o * 131) * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 512; }
    return sum * 512 / norm;
}

// ---------------- u32 arena accessors (little-endian, []u8 backed) ----------------
// Used for the relief grid, light/shadow maps, interest and dab-count maps.
// All values stored non-negative: no sign-extension hazards.
fn r8c_aget(a:[]u8, i:i64) i64 {
    let o:i64 = i << 2;
    let b0:i64 = a[o] as i64;
    let b1:i64 = a[o + 1] as i64;
    let b2:i64 = a[o + 2] as i64;
    let b3:i64 = a[o + 3] as i64;
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24);
}
fn r8c_aput(a:[]u8, i:i64, v:i64) void {
    let o:i64 = i << 2;
    a[o] = (v & 255) as u8;
    a[o + 1] = ((v >> 8) & 255) as u8;
    a[o + 2] = ((v >> 16) & 255) as u8;
    a[o + 3] = ((v >> 24) & 255) as u8;
}

// ---------------- trace writers ----------------
// The trace is written by the program as it decides. tr_s/tr_n/tr_nl
// are the only trace primitives; every decision in passes 1-5 goes
// through them, so the file is a complete decision record.
fn r8c_tr_s(fd:i64, s:[]u8) void {
    nio_write_all(fd, s);
}
fn r8c_tr_n(fd:i64, v:i64) void {
    let s:[]u8 = _zag_i64_to_str(v);
    nio_write_all(fd, s);
    nio_free(s);
}
fn r8c_tr_n3(fd:i64, v:i64) void {
    if (v < 100) { r8c_tr_s(fd, "0"); }
    if (v < 10) { r8c_tr_s(fd, "0"); }
    r8c_tr_n(fd, v);
}
fn r8c_tr_nl(fd:i64) void {
    r8c_tr_s(fd, "\n");
}

// ---------------- canvas pixel access (BGR buffer, 54-byte header) ----------------
fn r8c_px_get(buf:[]u8, stride:i64, x:i64, y:i64) i64 {
    let o:i64 = 54 + y * stride + x * 3;
    let b:i64 = buf[o] as i64;
    let g:i64 = buf[o + 1] as i64;
    let r:i64 = buf[o + 2] as i64;
    return r + (g << 8) + (b << 16);
}
fn r8c_luma_at(buf:[]u8, stride:i64, x:i64, y:i64) i64 {
    let rgb:i64 = r8c_px_get(buf, stride, x, y);
    let r:i64 = rgb & 255;
    let g:i64 = (rgb >> 8) & 255;
    let b:i64 = (rgb >> 16) & 255;
    return (r * 299 + g * 587 + b * 114) / 1000;
}

// ---------------- pigment dab ----------------
// One soft mark of pigment: radial falloff (1-d2/r2)^2, blended over
// the canvas at strength alpha (0..1024). Bounds-checked. This is the
// ONLY mark-making primitive: forms emerge from accumulated dabs,
// never from hard analytic edges.
fn r8c_dab(buf:[]u8, stride:i64, w:i64, h:i64, cx:i64, cy:i64, rad:i64, r:i64, g:i64, b:i64, alpha:i64) void {
    if (rad < 1) { return; }
    if (alpha <= 0) { return; }
    let x0:i64 = cx - rad;
    if (x0 < 0) { x0 = 0; }
    let x1:i64 = cx + rad;
    if (x1 >= w) { x1 = w - 1; }
    let y0:i64 = cy - rad;
    if (y0 < 0) { y0 = 0; }
    let y1:i64 = cy + rad;
    if (y1 >= h) { y1 = h - 1; }
    let r2:i64 = rad * rad;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let dx:i64 = x - cx;
            let dy:i64 = y - cy;
            let d2:i64 = dx * dx + dy * dy;
            if (d2 < r2) {
                let t:i64 = 1024 - d2 * 1024 / r2;
                let a:i64 = alpha * t / 1024 * t / 1024;
                if (a > 0) {
                    let o:i64 = 54 + y * stride + x * 3;
                    let bo:i64 = buf[o] as i64;
                    let go:i64 = buf[o + 1] as i64;
                    let ro:i64 = buf[o + 2] as i64;
                    buf[o] = (bo + (b - bo) * a / 1024) as u8;
                    buf[o + 1] = (go + (g - go) * a / 1024) as u8;
                    buf[o + 2] = (ro + (r - ro) * a / 1024) as u8;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
}
// Elliptical dab: stretched along (rx,ry) — for wind-aligned marks
// (dust tails, cloud streaks, dune ripples run across the wind).
fn r8c_dab_e(buf:[]u8, stride:i64, w:i64, h:i64, cx:i64, cy:i64, rx:i64, ry:i64, r:i64, g:i64, b:i64, alpha:i64) void {
    if (rx < 1) { return; }
    if (ry < 1) { return; }
    if (alpha <= 0) { return; }
    let rad:i64 = r8c_max(rx, ry);
    let x0:i64 = cx - rad;
    if (x0 < 0) { x0 = 0; }
    let x1:i64 = cx + rad;
    if (x1 >= w) { x1 = w - 1; }
    let y0:i64 = cy - rad;
    if (y0 < 0) { y0 = 0; }
    let y1:i64 = cy + rad;
    if (y1 >= h) { y1 = h - 1; }
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let dx:i64 = x - cx;
            let dy:i64 = y - cy;
            let q:i64 = dx * dx * 1024 / (rx * rx) + dy * dy * 1024 / (ry * ry);
            if (q < 1024) {
                let t:i64 = 1024 - q;
                let a:i64 = alpha * t / 1024 * t / 1024;
                if (a > 0) {
                    let o:i64 = 54 + y * stride + x * 3;
                    let bo:i64 = buf[o] as i64;
                    let go:i64 = buf[o + 1] as i64;
                    let ro:i64 = buf[o + 2] as i64;
                    buf[o] = (bo + (b - bo) * a / 1024) as u8;
                    buf[o + 1] = (go + (g - go) * a / 1024) as u8;
                    buf[o + 2] = (ro + (r - ro) * a / 1024) as u8;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

// ---------------- world model: the invented land ----------------
// The far tier is an ancient crater rim: a long escarpment bowing away
// at the edges, one dominant peak left of center, breached right of
// center where dust pours through.
fn r8c_ridge_y(x:i64) i64 {
    let dd:i64 = x - 390;
    let peak:i64 = 153600 / (1024 + dd * dd / 169);
    let bow:i64 = (x - 512) * (x - 512) * 60 / 262144;
    let bd:i64 = r8c_abs(x - 640);
    let breach:i64 = 0;
    if (bd < 140) { breach = 70 - bd * 70 / 140; }
    let sec:i64 = r8c_fbm(x * 256 / 420, 7, 4411, 2) - 512;
    return 470 - peak + bow + breach + sec * 40 / 512;
}
fn r8c_mid_y(x:i64) i64 {
    return 640 + (r8c_fbm(x * 256 / 300, 13, 4403, 2) - 512) * 70 / 512;
}
fn r8c_plain_y(x:i64) i64 {
    return 760 + (r8c_fbm(x * 256 / 380, 17, 4404, 2) - 512) * 40 / 512;
}
// The wind-carved arch: two pillars and a lintel, lower-left third.
// The opening between them is masked: through it you see the far rim,
// not the foreground.
fn r8c_arch_open(x:i64, y:i64) i64 {
    if (x > 288 && x < 352 && y > 800 && y < 884) { return 1; }
    return 0;
}
fn r8c_arch_body(x:i64, y:i64) i64 {
    // pillars
    if (x > 256 && x < 288 && y > 786 && y < 900) { return 1; }
    if (x > 352 && x < 384 && y > 786 && y < 900) { return 1; }
    // lintel
    if (x > 248 && x < 392 && y > 762 && y < 802) { return 1; }
    return 0;
}
// Sailstones: 40 wind-carved ventifacts, deterministic positions.
fn r8c_stone_x(i:i64) i64 {
    return 40 + r8c_h01(i, 1, 9101) * 944 / 1024;
}
fn r8c_stone_y(i:i64) i64 {
    return 786 + r8c_h01(i, 2, 9102) * 200 / 1024;
}
fn r8c_stone_r(i:i64) i64 {
    return 4 + r8c_h01(i, 3, 9103) * 10 / 1024;
}
// Gas giant and moon anchors.
fn r8c_giant_cx() i64 { return 700; }
fn r8c_giant_cy() i64 { return 250; }
fn r8c_giant_r() i64 { return 150; }
fn r8c_moon_cx() i64 { return 170; }
fn r8c_moon_cy() i64 { return 120; }
fn r8c_moon_r() i64 { return 26; }

// ---------------- trace header ----------------
fn r8c_trace_header(fd:i64) void {
    r8c_tr_s(fd, "# ELABORATION TRACE - r8c_alien (Fork C: mind's-eye elaboration)\n");
    r8c_tr_s(fd, "\n");
    r8c_tr_s(fd, "This image is the residue of 269 deliberate decisions in five passes,\n");
    r8c_tr_s(fd, "the way a mind's eye comes into focus: vague gist first, then big\n");
    r8c_tr_s(fd, "decisions, then light logic, then hundreds of small attentional\n");
    r8c_tr_s(fd, "fixations, then finish. This file was written by the program\n");
    r8c_tr_s(fd, "r8c_alien.zag AS IT DECIDED - every line below corresponds to a\n");
    r8c_tr_s(fd, "decision the program executed.\n");
    r8c_tr_s(fd, "\n");
    r8c_tr_s(fd, "## Determinism, and where surprise comes from\n");
    r8c_tr_s(fd, "Every decision is a pure function of (pass, index, canvas state).\n");
    r8c_tr_s(fd, "No RNG, no clock, no outside input: the same run always writes\n");
    r8c_tr_s(fd, "this exact file and this exact image. Yet fixation N+1's target is\n");
    r8c_tr_s(fd, "chosen by READING THE CANVAS after fixation N - so the sequence\n");
    r8c_tr_s(fd, "cannot be predicted without running the elaboration. Surprise\n");
    r8c_tr_s(fd, "comes from feedback, not dice.\n");
    r8c_tr_s(fd, "\n");
    r8c_tr_s(fd, "## World commitments (the world is invented first; pixels follow)\n");
    r8c_tr_s(fd, "- ONE sun, low at the left horizon, below the frame. (-880,-260,+390)\n");
    r8c_tr_s(fd, "- ONE wind, left-to-right, slightly toward the viewer. Cloud streaks,\n");
    r8c_tr_s(fd, "  dust tails, dune ripples all obey it.\n");
    r8c_tr_s(fd, "- The far tier is an ancient crater rim, breached right of center;\n");
    r8c_tr_s(fd, "  a glacier of dust pours through the breach.\n");
    r8c_tr_s(fd, "- A gas giant hangs upper right, half in shadow; it lends a faint\n");
    r8c_tr_s(fd, "  teal secondary glow to the cloud undersides (same sun, second story).\n");
    r8c_tr_s(fd, "- The foreground is a ventifact field: wind-carved sailstones, every\n");
    r8c_tr_s(fd, "  dust tail pointing downwind. One wind-carved arch, lower-left third,\n");
    r8c_tr_s(fd, "  with light coming through its opening.\n");
    r8c_tr_s(fd, "\n");
    r8c_tr_s(fd, "## PASS 1 - GIST (the vague impression)\n");
    r8c_tr_s(fd, "G1: first impression - a dusk vista, indigo-teal sky, the sun already\n");
    r8c_tr_s(fd, "    below the left horizon. Nothing is decided except mood.\n");
    r8c_tr_s(fd, "G2: three land tiers, still vague - a far violet mass, a warmer middle\n");
    r8c_tr_s(fd, "    tier, a dark foreground. Edges deliberately soft.\n");
    r8c_tr_s(fd, "G3: something huge hangs in the upper right sky. I do not know what\n");
    r8c_tr_s(fd, "    yet - only that the sky needs weight there. A pale unresolved glow.\n");
    r8c_tr_s(fd, "G4: the air is dusty; the far tier will sit behind air, not pasted on it.\n");
    r8c_tr_s(fd, "G5: gist done - 576 large soft dabs, one wash. Everything is soft;\n");
    r8c_tr_s(fd, "    nothing is decided except mood and masses.\n");
    r8c_tr_s(fd, "\n");
}

// gist color at a point: the vague impression, per-pixel analytic wash
fn r8c_gist_color(x:i64, y:i64, w:i64, h:i64) i64 {
    // sky gradient
    let t:i64 = y * 1024 / h;
    let r:i64 = r8c_lerp(30, 192, t);
    let g:i64 = r8c_lerp(60, 152, t);
    let b:i64 = r8c_lerp(112, 152, t);
    // sun glow, below the left horizon
    let gdx:i64 = x - w * 8 / 100;
    let gdy:i64 = y - h * 54 / 100;
    let gd2:i64 = gdx * gdx + gdy * gdy;
    let glow:i64 = 1048576 / (1024 + gd2 / 130);
    if (glow > 1024) { glow = 1024; }
    let ga:i64 = glow * 520 / 1024;
    r = r8c_lerp(r, 255, ga); g = r8c_lerp(g, 178, ga); b = r8c_lerp(b, 118, ga);
    // far violet mass, very soft edge
    let ry:i64 = r8c_ridge_y(x);
    let m:i64 = r8c_ss((y - (ry - 90)) * 1024 / 180);
    r = r8c_lerp(r, 108, m * 500 / 1024);
    g = r8c_lerp(g, 92, m * 500 / 1024);
    b = r8c_lerp(b, 128, m * 500 / 1024);
    // warmer middle tier
    let my:i64 = r8c_mid_y(x);
    let m2:i64 = r8c_ss((y - (my - 70)) * 1024 / 140);
    r = r8c_lerp(r, 152, m2 * 520 / 1024);
    g = r8c_lerp(g, 108, m2 * 520 / 1024);
    b = r8c_lerp(b, 84, m2 * 520 / 1024);
    // dark foreground wash
    let py:i64 = r8c_plain_y(x);
    let m3:i64 = r8c_ss((y - (py - 60)) * 1024 / 120);
    r = r8c_lerp(r, 88, m3 * 540 / 1024);
    g = r8c_lerp(g, 68, m3 * 540 / 1024);
    b = r8c_lerp(b, 56, m3 * 540 / 1024);
    // the huge unresolved thing, upper right
    let pdx:i64 = x - r8c_giant_cx();
    let pdy:i64 = y - r8c_giant_cy();
    let pd2:i64 = pdx * pdx + pdy * pdy;
    let pg:i64 = 48400 / (100 + pd2 / 100);
    if (pg > 420) { pg = 420; }
    r = r8c_lerp(r, 120, pg); g = r8c_lerp(g, 150, pg); b = r8c_lerp(b, 145, pg);
    // the arch opening is painted later, with dabs, in D9 - no hard override here
    // desaturate toward gray: the vague impression has no strong color yet
    let lum:i64 = (r * 299 + g * 587 + b * 114) / 1000;
    r = r8c_lerp(r, lum, 180); g = r8c_lerp(g, lum, 180); b = r8c_lerp(b, lum, 180);
    return r8c_pack(r, g, b);
}

fn r8c_pass1_gist(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_trace_header(tr);
    // one wash of 576 large soft dabs on a coarse grid
    let gy:i64 = 0;
    while (gy < 24) {
        let gx:i64 = 0;
        while (gx < 24) {
            let x:i64 = gx * w / 24 + w / 48;
            let y:i64 = gy * h / 24 + h / 48;
            let col:i64 = r8c_gist_color(x, y, w, h);
            r8c_dab(buf, stride, w, h, x, y, 64,
                col & 255, (col >> 8) & 255, (col >> 16) & 255, 700);
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    r8c_tr_s(tr, "## PASS 2 - BIG DECISIONS (the world gets specific)\n");
}

// ---------------- Pass 2: fourteen big decisions ----------------
fn r8c_dec01_sun(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D1 sun: I put the sun low and to the left, just below the horizon.\n");
    r8c_tr_s(tr, "    From here on, every shadow must agree with it. (-880,-260,+390)\n");
    let i:i64 = 0;
    while (i < 40) {
        let dx:i64 = r8c_h01(i, 11, 9001) - 512;
        let dy:i64 = r8c_h01(i, 12, 9002) - 512;
        let rad:i64 = 60 + r8c_h01(i, 13, 9003) * 60 / 1024;
        r8c_dab(buf, stride, w, h, w * 8 / 100 + dx / 5, h * 52 / 100 + dy / 5,
            rad, 255, 172, 112, 70);
        i = i + 1;
    }
}
fn r8c_dec02_sky(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D2 sky: dusk indigo-teal, deeper overhead - the day is leaving upward.\n");
    let i:i64 = 0;
    while (i < 30) {
        let x:i64 = r8c_h01(i, 21, 9011) * w / 1024;
        let y:i64 = r8c_h01(i, 22, 9012) * h * 30 / 100 / 1024;
        r8c_dab(buf, stride, w, h, x, y, 80, 22, 44, 86, 90);
        i = i + 1;
    }
}
fn r8c_dec03_rim(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D3 rim: the far tier is an ancient crater rim - a long escarpment\n");
    r8c_tr_s(tr, "    bowing away at the edges, violet in the dusk.\n");
    let x:i64 = 0;
    while (x < w) {
        let ry:i64 = r8c_ridge_y(x);
        let j:i64 = 0;
        while (j < 2) {
            let dy:i64 = r8c_h01(x + j * 7919, 31, 9021) - 512;
            r8c_dab(buf, stride, w, h, x, ry + 40 + dy / 8, 70, 112, 96, 132, 130);
            j = j + 1;
        }
        x = x + 32;
    }
}
fn r8c_dec04_peak(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D4 peak: one peak stands tallest, left of center - the eye needs\n");
    r8c_tr_s(tr, "    an anchor.\n");
    let i:i64 = 0;
    while (i < 24) {
        let dx:i64 = r8c_h01(i, 41, 9031) - 512;
        let dy:i64 = r8c_h01(i, 42, 9032) - 512;
        r8c_dab(buf, stride, w, h, 390 + dx / 6, r8c_ridge_y(390) + 30 + dy / 6,
            60, 96, 82, 118, 140);
        i = i + 1;
    }
}
fn r8c_dec05_breach(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D5 breach: the rim is breached right of center - a broad soft glacier\n");
    r8c_tr_s(tr, "    of dust pours through the gap. Specific, committed.\n");
    let i:i64 = 0;
    while (i < 44) {
        let dx:i64 = r8c_h01(i, 51, 9041) - 512;
        let yy:i64 = r8c_h01(i, 52, 9042) * 200 / 1024;
        let rad:i64 = 34 + r8c_h01(i, 53, 9043) * 40 / 1024;
        r8c_dab(buf, stride, w, h, 640 + dx / 3, r8c_ridge_y(640) + 60 + yy,
            rad, 202, 172, 142, 100);
        i = i + 1;
    }
}
fn r8c_dec06_hills(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D6 hills: a warmer, closer tier - rust-colored hills in front of the rim.\n");
    let x:i64 = 0;
    while (x < w) {
        let my:i64 = r8c_mid_y(x);
        let dy:i64 = r8c_h01(x, 61, 9051) - 512;
        r8c_dab(buf, stride, w, h, x, my + 50 + dy / 8, 70, 154, 110, 86, 130);
        x = x + 40;
    }
}
fn r8c_dec07_plain(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D7 plain: dark umber foreground - the ground I stand on.\n");
    let i:i64 = 0;
    while (i < 60) {
        let x:i64 = r8c_h01(i, 71, 9061) * w / 1024;
        let py:i64 = r8c_plain_y(x);
        let y:i64 = py + r8c_h01(i, 72, 9062) * (h - py) / 1024;
        if (r8c_arch_open(x, y) == 0) {
            r8c_dab(buf, stride, w, h, x, y, 80, 90, 70, 58, 110);
        }
        i = i + 1;
    }
}
fn r8c_dec08_stones(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D8 stones: the foreground is a ventifact field - wind-carved sailstones,\n");
    r8c_tr_s(tr, "    each trailing dust downwind. Forty stones; every tail points the\n");
    r8c_tr_s(tr, "    same way, because there is only one wind.\n");
    let i:i64 = 0;
    while (i < 40) {
        let sx:i64 = r8c_stone_x(i);
        let sy:i64 = r8c_stone_y(i);
        let sr:i64 = r8c_stone_r(i);
        // stone body
        r8c_dab(buf, stride, w, h, sx, sy - sr / 2, sr * 2, 122, 106, 94, 500);
        r8c_dab(buf, stride, w, h, sx - sr / 3, sy - sr / 2, sr, 150, 132, 114, 300);
        // dust tail, stretched downwind (+x, slightly +y)
        let k:i64 = 0;
        while (k < 3) {
            r8c_dab_e(buf, stride, w, h, sx + sr + 20 + k * 26, sy + 4 + k * 3,
                30, 9, 202, 172, 142, 60);
            k = k + 1;
        }
        i = i + 1;
    }
}
fn r8c_dec09_arch(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D9 arch: one wind-carved arch in the lower-left third - light comes\n");
    r8c_tr_s(tr, "    through the opening. Something near, something to touch. I paint\n");
    r8c_tr_s(tr, "    it as a dark silhouette: the dusk is behind it, not on it. The\n");
    r8c_tr_s(tr, "    opening holds the hazed far rim, dimmed by the arch's own shadow;\n");
    r8c_tr_s(tr, "    the low sun rims its left edges with warm light.\n");
    // pillars: dark silhouette
    let i:i64 = 0;
    while (i < 40) {
        let px:i64 = 256 + r8c_h01(i, 81, 9071) * 128 / 1024;
        let py:i64 = 786 + r8c_h01(i, 82, 9072) * 114 / 1024;
        if (r8c_arch_body(px, py) == 1) {
            r8c_dab(buf, stride, w, h, px, py, 26, 64, 50, 40, 520);
        }
        i = i + 1;
    }
    // lintel: dark silhouette
    let j:i64 = 0;
    while (j < 30) {
        let px2:i64 = 248 + r8c_h01(j, 83, 9073) * 144 / 1024;
        let py2:i64 = 762 + r8c_h01(j, 84, 9074) * 40 / 1024;
        if (r8c_arch_body(px2, py2) == 1) {
            r8c_dab(buf, stride, w, h, px2, py2, 24, 64, 50, 40, 520);
        }
        j = j + 1;
    }
    // sunlit rims on the sunward (left) edges
    let q:i64 = 0;
    while (q < 22) {
        let qy:i64 = 790 + r8c_h01(q, 89, 9079) * 105 / 1024;
        r8c_dab(buf, stride, w, h, 258, qy, 9, 240, 195, 155, 320);
        let qx:i64 = 252 + r8c_h01(q, 90, 9080) * 132 / 1024;
        r8c_dab(buf, stride, w, h, qx, 764, 8, 240, 195, 155, 300);
        q = q + 1;
    }
    // the opening: the far rim's colors, laid soft - seen THROUGH the arch
    let m:i64 = 0;
    while (m < 24) {
        let ox:i64 = 288 + r8c_h01(m, 85, 9075) * 64 / 1024;
        let oy:i64 = 800 + r8c_h01(m, 86, 9076) * 84 / 1024;
        r8c_dab(buf, stride, w, h, ox, oy, 18, 130, 110, 150, 500);
        m = m + 1;
    }
    // light coming through: a warm kiss on the opening's left edge
    let n:i64 = 0;
    while (n < 12) {
        let lx:i64 = 292 + r8c_h01(n, 87, 9077) * 16 / 1024;
        let ly:i64 = 804 + r8c_h01(n, 88, 9078) * 76 / 1024;
        r8c_dab(buf, stride, w, h, lx, ly, 12, 255, 200, 150, 150);
        n = n + 1;
    }
}
fn r8c_dec10_giant(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D10 giant: the huge thing in the sky is a gas giant - zones of teal\n");
    r8c_tr_s(tr, "     and gold, half in shadow. It will catch the last sunlight and\n");
    r8c_tr_s(tr, "     throw a faint teal glow on the cloud undersides.\n");
    let cx:i64 = r8c_giant_cx();
    let cy:i64 = r8c_giant_cy();
    let rr:i64 = r8c_giant_r();
    let i:i64 = 0;
    while (i < 120) {
        let a:i64 = r8c_h01(i, 91, 9081);
        let rad2:i64 = r8c_h01(i, 92, 9082);
        let dx:i64 = (a - 512) * rr * 2 / 1024;
        let dy:i64 = (rad2 - 512) * rr * 2 / 1024;
        if (dx * dx + dy * dy < rr * rr) {
            // zonal palette picked by latitude zone
            let zone:i64 = (dy + rr) * 5 / (rr * 2);
            let cr:i64 = 40; let cg:i64 = 120; let cb:i64 = 135;
            if (zone == 1) { cr = 210; cg = 185; cb = 140; }
            if (zone == 2) { cr = 170; cg = 110; cb = 80; }
            if (zone == 3) { cr = 230; cg = 220; cb = 195; }
            if (zone == 4) { cr = 60; cg = 110; cb = 130; }
            let vary:i64 = r8c_h01(i, 93, 9083) - 512;
            let rad:i64 = 20 + r8c_h01(i, 94, 9084) * 40 / 1024;
            r8c_dab(buf, stride, w, h, cx + dx, cy + dy, rad,
                r8c_clamp(cr + vary / 8, 0, 255),
                r8c_clamp(cg + vary / 8, 0, 255),
                r8c_clamp(cb + vary / 8, 0, 255), 260);
        }
        i = i + 1;
    }
    // the great storm: a pale oval, sheared
    let s:i64 = 0;
    while (s < 24) {
        let dx2:i64 = r8c_h01(s, 95, 9085) - 512;
        let dy2:i64 = r8c_h01(s, 96, 9086) - 512;
        r8c_dab(buf, stride, w, h, cx + 20 + dx2 / 8, cy - 16 + dy2 / 8,
            26, 226, 214, 190, 300);
        s = s + 1;
    }
}
fn r8c_dec11_moon(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D11 moon: a small cratered moon, high left - balancing the giant.\n");
    let cx:i64 = r8c_moon_cx();
    let cy:i64 = r8c_moon_cy();
    let i:i64 = 0;
    while (i < 40) {
        let dx:i64 = (r8c_h01(i, 101, 9091) - 512) * 52 / 1024;
        let dy:i64 = (r8c_h01(i, 102, 9092) - 512) * 52 / 1024;
        let vary:i64 = r8c_h01(i, 103, 9093) - 512;
        r8c_dab(buf, stride, w, h, cx + dx, cy + dy, 6,
            175 + vary / 16, 173 + vary / 16, 175 + vary / 16, 500);
        i = i + 1;
    }
}
fn r8c_dec12_clouds(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D12 clouds: thin cirrus, stretched along the wind, lit from below-left.\n");
    r8c_tr_s(tr, "     The wind draws every streak; none crosses it.\n");
    let i:i64 = 0;
    while (i < 24) {
        let x:i64 = r8c_h01(i, 111, 9101) * w / 1024;
        let y:i64 = 60 + r8c_h01(i, 112, 9102) * 320 / 1024;
        let rx:i64 = 120 + r8c_h01(i, 113, 9103) * 100 / 1024;
        let warm:i64 = 200 + (1024 - x * 1024 / w) * 40 / 1024;
        r8c_dab_e(buf, stride, w, h, x, y, rx, 10, warm, 210, 200, 70);
        i = i + 1;
    }
}
fn r8c_dec13_haze(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "D13 haze: dust in the air between the tiers - the far rim sits BEHIND\n");
    r8c_tr_s(tr, "     atmosphere, not pasted onto it.\n");
    let i:i64 = 0;
    while (i < 50) {
        let x:i64 = r8c_h01(i, 121, 9111) * w / 1024;
        let ry:i64 = r8c_ridge_y(x);
        let my:i64 = r8c_mid_y(x);
        let y:i64 = ry + r8c_h01(i, 122, 9112) * (my - ry) / 1024;
        r8c_dab(buf, stride, w, h, x, y, 90, 198, 168, 148, 46);
        i = i + 1;
    }
}
fn r8c_dec14_focal(tr:i64) void {
    r8c_tr_s(tr, "D14 focal: my eye lands on the lit shoulder of the great peak, just\n");
    r8c_tr_s(tr, "     left of the dust breach, at (430,400). Detail will gather there.\n");
    r8c_tr_s(tr, "\n");
    r8c_tr_s(tr, "## PASS 3 - LIGHT LOGIC (one sun, one wind)\n");
}

// ---------------- Pass 3: light logic ----------------
// The mind's eye imagines the relief FIRST (a 128x128 height grid),
// then works out where the one sun's light goes: sun-facing faces warm,
// cast shadows marched along the sun azimuth, air between the tiers.
fn r8c_build_relief(rel:[]u8, w:i64, h:i64) void {
    let gy:i64 = 0;
    while (gy < 128) {
        let gx:i64 = 0;
        while (gx < 128) {
            let px:i64 = gx * 8 + 4;
            let py:i64 = gy * 8 + 4;
            let hh:i64 = 0;
            // Tier heights are CAPPED: a cliff face has a finite height. Without
            // caps the escarpment grows thousands of px tall and its cast shadow
            // (correctly, given the height) swallows the whole scene.
            let ry:i64 = r8c_ridge_y(px);
            if (py > ry) {
                let rh:i64 = (py - ry) * 3;
                if (rh > 360) { rh = 360; }
                hh = hh + rh;
            }
            let my:i64 = r8c_mid_y(px);
            if (py > my) {
                let mh:i64 = (py - my) * 2;
                if (mh > 240) { mh = 240; }
                hh = hh + mh;
            }
            let pyy:i64 = r8c_plain_y(px);
            if (py > pyy) {
                let ph:i64 = py - pyy;
                if (ph > 120) { ph = 120; }
                hh = hh + ph;
            }
            // the arch rises out of the plain
            if (r8c_arch_body(px, py) == 1) { hh = hh + 300; }
            // sailstone domes
            let i:i64 = 0;
            while (i < 40) {
                let sx:i64 = r8c_stone_x(i);
                let sy:i64 = r8c_stone_y(i);
                let sr:i64 = r8c_stone_r(i) * 2;
                let dx:i64 = px - sx;
                let dy:i64 = py - sy;
                if (dx < sr && dx > 0 - sr && dy < sr && dy > 0 - sr) {
                    let d2:i64 = dx * dx + dy * dy;
                    if (d2 < sr * sr) {
                        hh = hh + 60 - 60 * d2 / (sr * sr);
                    }
                }
                i = i + 1;
            }
            r8c_aput(rel, gy * 128 + gx, hh * 16);
            gx = gx + 1;
        }
        gy = gy + 1;
    }
}
// sun-facing factor per grid cell, 0..1024, from the relief normals
fn r8c_build_lightmap(rel:[]u8, light:[]u8) void {
    let gy:i64 = 0;
    while (gy < 128) {
        let gx:i64 = 0;
        while (gx < 128) {
            let xm:i64 = gx - 1;
            if (xm < 0) { xm = 0; }
            let xp:i64 = gx + 1;
            if (xp > 127) { xp = 127; }
            let ym:i64 = gy - 1;
            if (ym < 0) { ym = 0; }
            let yp:i64 = gy + 1;
            if (yp > 127) { yp = 127; }
            // gradient in (px-height x1024) per px, x1024 fixed
            let gxg:i64 = (r8c_aget(rel, gy * 128 + xp) - r8c_aget(rel, gy * 128 + xm)) * 1024 / 256;
            let gyg:i64 = (r8c_aget(rel, yp * 128 + gx) - r8c_aget(rel, ym * 128 + gx)) * 1024 / 256;
            let nx:i64 = 0 - gxg;
            let ny:i64 = 0 - gyg;
            let nm:i64 = r8c_isqrt(nx * nx / 1024 + ny * ny / 1024 + 1048576);
            // sun unit x1024: (-899,-266,399); n = (nx,ny,1024) in x1024
            let num:i64 = nx * (0 - 899) / 1024 + ny * (0 - 266) / 1024 + 408576;
            let l:i64 = 0;
            if (nm > 0) { l = num * 1024 / nm / 1024; }
            r8c_aput(light, gy * 128 + gx, r8c_clamp(l, 0, 1024));
            gx = gx + 1;
        }
        gy = gy + 1;
    }
}
// cast shadows: march each grid cell toward the sun; the relief grid
// is 8px/cell, heights x16. 96 steps = 768px reach, enough for the arch's
// full long dusk shadow. 0 = lit, 1024 = shadowed.
fn r8c_build_shadowmap(rel:[]u8, shad:[]u8) void {
    let gy:i64 = 0;
    while (gy < 128) {
        let gx:i64 = 0;
        while (gx < 128) {
            let h0:i64 = r8c_aget(rel, gy * 128 + gx);
            let fx:i64 = gx << 10;
            let fy:i64 = gy << 10;
            let ray:i64 = h0 + 32;
            let sh:i64 = 0;
            let s:i64 = 0;
            while (s < 96) {
                fx = fx - 959;
                fy = fy - 284;
                ray = ray + 54;
                let cx:i64 = fx >> 10;
                let cy:i64 = fy >> 10;
                if (cx < 0 || cx > 127 || cy < 0 || cy > 127) { s = 96; }
                if (s < 96) {
                    if (r8c_aget(rel, cy * 128 + cx) > ray) { sh = 1024; s = 96; }
                }
                s = s + 1;
            }
            r8c_aput(shad, gy * 128 + gx, sh);
            gx = gx + 1;
        }
        gy = gy + 1;
    }
}
// 3x3 box blur of the shadow map: single-cell speckle averages out,
// coherent shadow masses stay. Dusk shadows are soft.
fn r8c_blur_shadow(shad:[]u8, out:[]u8) void {
    let gy:i64 = 0;
    while (gy < 128) {
        let gx:i64 = 0;
        while (gx < 128) {
            let acc:i64 = 0;
            let dy:i64 = -1;
            while (dy <= 1) {
                let dx:i64 = -1;
                while (dx <= 1) {
                    let nx:i64 = gx + dx;
                    let ny:i64 = gy + dy;
                    if (nx < 0) { nx = 0; }
                    if (nx > 127) { nx = 127; }
                    if (ny < 0) { ny = 0; }
                    if (ny > 127) { ny = 127; }
                    acc = acc + r8c_aget(shad, ny * 128 + nx);
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            r8c_aput(out, gy * 128 + gx, acc / 9);
            gx = gx + 1;
        }
        gy = gy + 1;
    }
}
// bilinear sample of a 128x128 map at pixel (x,y)
fn r8c_sample128(map:[]u8, x:i64, y:i64, w:i64, h:i64) i64 {
    let fx:i64 = x * 128 / w;
    let fy:i64 = y * 128 / h;
    if (fx > 126) { fx = 126; }
    if (fy > 126) { fy = 126; }
    let tx:i64 = (x * 128 - fx * w) * 1024 / w;
    let ty:i64 = (y * 128 - fy * h) * 1024 / h;
    let a:i64 = r8c_aget(map, fy * 128 + fx);
    let b:i64 = r8c_aget(map, fy * 128 + fx + 1);
    let c:i64 = r8c_aget(map, (fy + 1) * 128 + fx);
    let d:i64 = r8c_aget(map, (fy + 1) * 128 + fx + 1);
    let ab:i64 = a + (b - a) * tx / 1024;
    let cd:i64 = c + (d - c) * tx / 1024;
    return ab + (cd - ab) * ty / 1024;
}

fn r8c_pass3(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "L1: sun vector committed: (-880,-260,+390). One sun. No second light.\n");
    r8c_tr_s(tr, "    Every shadow painted from here must agree with its azimuth.\n");
    let rel:[]u8 = nio_alloc(65536);
    let light:[]u8 = nio_alloc(65536);
    let shad:[]u8 = nio_alloc(65536);
    r8c_build_relief(rel, w, h);
    r8c_tr_s(tr, "L2: I imagine the relief first - rim, hills, plain, arch, stones -\n");
    r8c_tr_s(tr, "    a 128x128 height grid the mind's eye holds before shading.\n");
    r8c_build_lightmap(rel, light);
    r8c_tr_s(tr, "L3: normals from the relief. Faces toward the sun warm; faces away\n");
    r8c_tr_s(tr, "    cool. Flat ground gets weak light - the sun is low, correctly.\n");
    r8c_build_shadowmap(rel, shad);
    r8c_tr_s(tr, "L4: cast shadows - I march each ray back toward the sun; where the\n");
    r8c_tr_s(tr, "    relief blocks it, shadow. The arch throws one long shadow right.\n");
    r8c_tr_s(tr, "    Tier heights are capped (a cliff has a finite height) and the\n");
    r8c_tr_s(tr, "    shadow map is softened - dusk shadows are broad, not pillars.\n");
    let shadb:[]u8 = nio_alloc(65536);
    r8c_blur_shadow(shad, shadb);
    nio_free(shad);
    nio_free(rel);
    let gcx:i64 = r8c_giant_cx();
    let gcy:i64 = r8c_giant_cy();
    let gr:i64 = r8c_giant_r();
    let mcx:i64 = r8c_moon_cx();
    let mcy:i64 = r8c_moon_cy();
    let mr:i64 = r8c_moon_r();
    let x:i64 = 0;
    while (x < w) {
        let ry:i64 = r8c_ridge_y(x);
        let my:i64 = r8c_mid_y(x);
        let pyy:i64 = r8c_plain_y(x);
        let y:i64 = 0;
        while (y < h) {
            let o:i64 = 54 + y * stride + x * 3;
            let b0:i64 = buf[o] as i64;
            let g0:i64 = buf[o + 1] as i64;
            let r0:i64 = buf[o + 2] as i64;
            let in_sky:i64 = 1;
            if (y >= ry) { in_sky = 0; }
            let in_open:i64 = r8c_arch_open(x, y);
            if (in_open == 1) { in_sky = 1; }
            // through the arch opening: the far rim, hazed by distance and
            // dimmed by the arch's own shadow
            if (in_open == 1) {
                r0 = r8c_lerp(r0, 198, 210);
                g0 = r8c_lerp(g0, 168, 210);
                b0 = r8c_lerp(b0, 148, 210);
                r0 = r0 * 880 / 1024;
                g0 = g0 * 880 / 1024;
                b0 = b0 * 880 / 1024;
            }
            if (in_sky == 1) {
                // gas giant: terminator from the same sun
                let pdx:i64 = x - gcx;
                let pdy:i64 = y - gcy;
                if (pdx < gr + 4 && pdx > 0 - gr - 4 && pdy < gr + 4 && pdy > 0 - gr - 4) {
                    let d2:i64 = pdx * pdx + pdy * pdy;
                    if (d2 < gr * gr) {
                        let dz:i64 = r8c_isqrt(gr * gr - d2);
                        let dot:i64 = (pdx * (0 - 899) + pdy * (0 - 266) + dz * 399) / gr;
                        let lit:i64 = r8c_clamp((dot + 200) * 1024 / 400, 0, 1024);
                        let mu:i64 = dz * 1024 / gr;
                        let ld:i64 = 560 + 464 * mu / 1024;
                        r0 = r0 * (256 + 768 * lit / 1024) / 1024 * ld / 1024;
                        g0 = g0 * (256 + 768 * lit / 1024) / 1024 * ld / 1024;
                        b0 = b0 * (256 + 768 * lit / 1024) / 1024 * ld / 1024;
                    }
                }
                // moon: phase from the same sun
                let mdx:i64 = x - mcx;
                let mdy:i64 = y - mcy;
                if (mdx < mr + 2 && mdx > 0 - mr - 2 && mdy < mr + 2 && mdy > 0 - mr - 2) {
                    let d2:i64 = mdx * mdx + mdy * mdy;
                    if (d2 < mr * mr) {
                        let dz:i64 = r8c_isqrt(mr * mr - d2);
                        let dot:i64 = (mdx * (0 - 899) + mdy * (0 - 266) + dz * 399) / mr;
                        let lit:i64 = r8c_clamp((dot + 200) * 1024 / 400, 0, 1024);
                        r0 = r0 * (300 + 724 * lit / 1024) / 1024;
                        g0 = g0 * (300 + 724 * lit / 1024) / 1024;
                        b0 = b0 * (300 + 724 * lit / 1024) / 1024;
                    }
                }
                // the giant lends faint teal to the cloud undersides below it
                let tdx:i64 = x - gcx;
                let tdy:i64 = y - (gcy + gr);
                if (tdy > 0 && tdy < 320 && tdx > -320 && tdx < 320) {
                    let td2:i64 = tdx * tdx + tdy * tdy;
                    if (td2 < 102400) {
                        let tg:i64 = (102400 - td2) * 60 / 102400;
                        r0 = r0 + 40 * tg / 1024;
                        g0 = g0 + 120 * tg / 1024;
                        b0 = b0 + 130 * tg / 1024;
                    }
                }
            }
            if (in_sky == 0) {
                let L:i64 = r8c_sample128(light, x, y, w, h);
                let Sh:i64 = r8c_sample128(shadb, x, y, w, h);
                let L2:i64 = L * (1024 - Sh) / 1024;
                // effective light scales the pigment
                let sc:i64 = 700 + 324 * L2 / 1024;
                r0 = r0 * sc / 1024;
                g0 = g0 * sc / 1024;
                b0 = b0 * sc / 1024;
                // warm sun tint on lit faces, cool sky fill in shadow
                r0 = r0 + 255 * L2 * 220 / 1024 / 1024;
                g0 = g0 + 190 * L2 * 220 / 1024 / 1024;
                b0 = b0 + 130 * L2 * 220 / 1024 / 1024;
                let dk:i64 = 1024 - L2;
                r0 = r0 + 120 * dk * 110 / 1024 / 1024;
                g0 = g0 + 140 * dk * 110 / 1024 / 1024;
                b0 = b0 + 190 * dk * 110 / 1024 / 1024;
                // aerial perspective: wash toward dusty horizon by tier
                let wash:i64 = 50;
                if (y < my) { wash = 210; }
                if (y >= my && y < pyy) { wash = 120; }
                r0 = r8c_lerp(r0, 198, wash);
                g0 = r8c_lerp(g0, 168, wash);
                b0 = r8c_lerp(b0, 148, wash);
            }
            buf[o] = r8c_clamp(b0, 0, 255) as u8;
            buf[o + 1] = r8c_clamp(g0, 0, 255) as u8;
            buf[o + 2] = r8c_clamp(r0, 0, 255) as u8;
            y = y + 1;
        }
        if (x - (x >> 7 << 7) == 0) {
            _zag_print("light col ");
            _zag_println(_zag_i64_to_str(x));
        }
        x = x + 1;
    }
    nio_free(light);
    nio_free(shadb);
    r8c_tr_s(tr, "L5: the giant's terminator crosses its disc from the same sun; its\n");
    r8c_tr_s(tr, "    night side keeps faint zone structure, never flat black.\n");
    r8c_tr_s(tr, "L6: the giant lends a faint teal secondary glow to cloud undersides -\n");
    r8c_tr_s(tr, "    a second light story, but it comes from the same sun.\n");
    r8c_tr_s(tr, "L7: aerial perspective - each tier washed toward the dusty horizon\n");
    r8c_tr_s(tr, "    color by its distance.\n");
    r8c_tr_s(tr, "L8: light logic done. Every shadow now agrees with one sun, one wind.\n");
    r8c_tr_s(tr, "\n");
    r8c_tr_s(tr, "## PASS 4 - FIXATIONS (the mind's eye looks around)\n");
    r8c_tr_s(tr, "Each fixation: I scan the canvas for the most interesting unresolved\n");
    r8c_tr_s(tr, "place (contrast x novelty x nearness to the focal anchor), look there,\n");
    r8c_tr_s(tr, "and lay pigment for a stated reason. 240 fixations follow.\n");
}

// ---------------- Pass 4: fixations ----------------
// The mind's eye looks around: it scans the canvas for the most
// interesting unresolved place, looks there, and lays pigment for a
// stated reason. Fixation N+1's target is chosen by READING the canvas
// after fixation N - feedback, not dice.
fn r8c_tier_at(x:i64, y:i64) i64 {
    let pdx:i64 = x - r8c_giant_cx();
    let pdy:i64 = y - r8c_giant_cy();
    if (pdx * pdx + pdy * pdy < r8c_giant_r() * r8c_giant_r()) { return 4; }
    let mdx:i64 = x - r8c_moon_cx();
    let mdy:i64 = y - r8c_moon_cy();
    if (mdx * mdx + mdy * mdy < r8c_moon_r() * r8c_moon_r()) { return 5; }
    if (r8c_arch_open(x, y) == 1) { return 1; }
    let ry:i64 = r8c_ridge_y(x);
    if (y < ry) { return 0; }
    let my:i64 = r8c_mid_y(x);
    if (y < my) { return 1; }
    let py:i64 = r8c_plain_y(x);
    if (y < py) { return 2; }
    return 3;
}
fn r8c_tier_name(t:i64, tr:i64) void {
    if (t == 0) { r8c_tr_s(tr, "sky"); }
    if (t == 1) { r8c_tr_s(tr, "far rim"); }
    if (t == 2) { r8c_tr_s(tr, "mid hills"); }
    if (t == 3) { r8c_tr_s(tr, "foreground"); }
    if (t == 4) { r8c_tr_s(tr, "gas giant"); }
    if (t == 5) { r8c_tr_s(tr, "moon"); }
}
fn r8c_tier_avg(t:i64) i64 {
    if (t == 0) { return 120; }
    if (t == 1) { return 95; }
    if (t == 2) { return 105; }
    if (t == 3) { return 70; }
    if (t == 4) { return 110; }
    return 150;
}
// contrast at a cell center, read from the canvas
fn r8c_cell_contrast(buf:[]u8, stride:i64, w:i64, h:i64, cx:i64, cy:i64) i64 {
    let px:i64 = cx * 32 + 16;
    let py:i64 = cy * 32 + 16;
    let lc:i64 = r8c_luma_at(buf, stride, px, py);
    let lr:i64 = r8c_luma_at(buf, stride, px + 14, py);
    let lb:i64 = r8c_luma_at(buf, stride, px, py + 14);
    let c:i64 = r8c_abs(lc - lr) + r8c_abs(lc - lb);
    return r8c_clamp(c * 2, 0, 1024);
}
fn r8c_interest_recompute(buf:[]u8, stride:i64, w:i64, h:i64, imap:[]u8) void {
    let cy:i64 = 0;
    while (cy < 32) {
        let cx:i64 = 0;
        while (cx < 32) {
            let c:i64 = r8c_cell_contrast(buf, stride, w, h, cx, cy);
            let n:i64 = r8c_h01(cy * 32 + cx, 3, 9207);
            let px:i64 = cx * 32 + 16;
            let py:i64 = cy * 32 + 16;
            let ddx:i64 = px - 430;
            let ddy:i64 = py - 400;
            let dist:i64 = r8c_isqrt(ddx * ddx + ddy * ddy);
            let fb:i64 = 1024 - r8c_min(dist * 1024 / 900, 1024);
            let v:i64 = (c * 2 + n + fb * 2) / 5;
            r8c_aput(imap, cy * 32 + cx, v);
            cx = cx + 1;
        }
        cy = cy + 1;
    }
}
fn r8c_interest_pick(imap:[]u8) i64 {
    let best:i64 = 0;
    let bv:i64 = 0;
    let i:i64 = 0;
    while (i < 1024) {
        let v:i64 = r8c_aget(imap, i);
        if (v > bv) { bv = v; best = i; }
        i = i + 1;
    }
    return best;
}
fn r8c_interest_decimate(imap:[]u8, cell:i64) void {
    let cx:i64 = cell - (cell >> 5 << 5);
    let cy:i64 = cell >> 5;
    r8c_aput(imap, cell, r8c_aget(imap, cell) / 4);
    let dy:i64 = -1;
    while (dy <= 1) {
        let dx:i64 = -1;
        while (dx <= 1) {
            if (dx != 0 || dy != 0) {
                let nx:i64 = cx + dx;
                let ny:i64 = cy + dy;
                if (nx >= 0 && nx < 32 && ny >= 0 && ny < 32) {
                    let nc:i64 = ny * 32 + nx;
                    r8c_aput(imap, nc, r8c_aget(imap, nc) / 2);
                }
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}
// one fixation: choose variant from the canvas state, paint, state the reason
fn r8c_fixation(f:i64, buf:[]u8, stride:i64, w:i64, h:i64, imap:[]u8, tr:i64) void {
    let cell:i64 = r8c_interest_pick(imap);
    let cx:i64 = cell - (cell >> 5 << 5);
    let cy:i64 = cell >> 5;
    let fx:i64 = cx * 32 + 16 + (r8c_h01(f, 1, 9201) - 512) / 51;
    let fy:i64 = cy * 32 + 16 + (r8c_h01(f, 2, 9202) - 512) / 51;
    if (fx < 0) { fx = 0; }
    if (fx >= w) { fx = w - 1; }
    if (fy < 0) { fy = 0; }
    if (fy >= h) { fy = h - 1; }
    r8c_interest_decimate(imap, cell);
    let tier:i64 = r8c_tier_at(fx, fy);
    let lum:i64 = r8c_luma_at(buf, stride, fx, fy);
    let avg:i64 = r8c_tier_avg(tier);
    let v:i64 = 2;
    if (lum < avg - 25) { v = 0; }
    if (lum > avg + 25) { v = 1; }
    if (v == 2) { v = 2 + (r8c_h01(f, 8, 9203) & 1); }
    // trace: F{n}: (x,y) tier - reason
    r8c_tr_s(tr, "F");
    r8c_tr_n(tr, f);
    r8c_tr_s(tr, ": (");
    r8c_tr_n(tr, fx);
    r8c_tr_s(tr, ",");
    r8c_tr_n(tr, fy);
    r8c_tr_s(tr, ") ");
    r8c_tier_name(tier, tr);
    r8c_tr_s(tr, " - ");
    if (tier == 0) {
        if (v == 0) { r8c_tr_s(tr, "a thin place in the clouds - let the sun through"); r8c_dab(buf, stride, w, h, fx, fy, 34, 255, 208, 168, 130); }
        if (v == 1) { r8c_tr_s(tr, "deepen the blue hour overhead"); r8c_dab(buf, stride, w, h, fx, fy, 40, 30, 52, 92, 120); }
        if (v == 2) { r8c_tr_s(tr, "another cirrus streak, drawn along the wind"); r8c_dab_e(buf, stride, w, h, fx, fy, 70, 9, 225, 214, 196, 90); }
        if (v == 3) { r8c_tr_s(tr, "the sun's glow gathers below the horizon line"); r8c_dab(buf, stride, w, h, fx, fy + 20, 44, 255, 180, 120, 110); }
    }
    if (tier == 1) {
        if (v == 0) { r8c_tr_s(tr, "catch the rim's shoulder with the last light"); r8c_dab(buf, stride, w, h, fx, fy, 30, 172, 152, 182, 140); }
        if (v == 1) { r8c_tr_s(tr, "the far slope falls into dusk"); r8c_dab(buf, stride, w, h, fx, fy, 32, 68, 58, 88, 140); }
        if (v == 2) { r8c_tr_s(tr, "strata lines on the old crater wall"); r8c_dab_e(buf, stride, w, h, fx - 20, fy, 34, 6, 150, 130, 155, 110); r8c_dab_e(buf, stride, w, h, fx + 20, fy, 34, 6, 150, 130, 155, 110); }
        if (v == 3) { r8c_tr_s(tr, "clarify the rim crest against the sky"); r8c_dab(buf, stride, w, h, fx, r8c_ridge_y(fx), 20, 200, 170, 190, 150); }
    }
    if (tier == 2) {
        if (v == 0) { r8c_tr_s(tr, "a lit fold in the rust hills"); r8c_dab(buf, stride, w, h, fx, fy, 30, 192, 152, 122, 140); }
        if (v == 1) { r8c_tr_s(tr, "a gully the sun cannot reach"); r8c_dab(buf, stride, w, h, fx, fy, 32, 98, 68, 50, 140); }
        if (v == 2) { r8c_tr_s(tr, "wind-ripples across the hill flank"); r8c_dab_e(buf, stride, w, h, fx - 18, fy, 30, 6, 175, 140, 110, 110); r8c_dab_e(buf, stride, w, h, fx + 18, fy, 30, 6, 175, 140, 110, 110); }
        if (v == 3) { r8c_tr_s(tr, "the hill's edge hardens where it meets the air"); r8c_dab_e(buf, stride, w, h, fx, fy, 8, 30, 90, 62, 46, 150); }
    }
    if (tier == 3) {
        if (v == 0) { r8c_tr_s(tr, "a stone catches the light"); r8c_dab(buf, stride, w, h, fx, fy, 22, 205, 175, 145, 150); }
        if (v == 1) { r8c_tr_s(tr, "deepen the shadow pooling between stones"); r8c_dab(buf, stride, w, h, fx, fy, 26, 48, 38, 30, 150); }
        if (v == 2) { r8c_tr_s(tr, "pebbles and grit, scattered by the wind"); r8c_dab(buf, stride, w, h, fx, fy, 7, 190, 165, 140, 200); r8c_dab(buf, stride, w, h, fx + 9, fy + 4, 5, 70, 58, 48, 200); }
        if (v == 3) { r8c_tr_s(tr, "rim-light on a sailstone's windward face"); r8c_dab(buf, stride, w, h, fx - 3, fy, 14, 235, 205, 170, 170); }
    }
    if (tier == 4) {
        if (v == 0) { r8c_tr_s(tr, "a bright zone swath on the giant"); r8c_dab(buf, stride, w, h, fx, fy, 26, 230, 220, 195, 150); }
        if (v == 1) { r8c_tr_s(tr, "the terminator's soft edge"); r8c_dab(buf, stride, w, h, fx, fy, 28, 40, 80, 95, 150); }
        if (v == 2) { r8c_tr_s(tr, "turbulence in the zones"); r8c_dab_e(buf, stride, w, h, fx, fy, 40, 10, 200, 180, 150, 130); }
        if (v == 3) { r8c_tr_s(tr, "the limb darkens toward the edge"); r8c_dab(buf, stride, w, h, fx, fy, 20, 90, 130, 140, 140); }
    }
    if (tier == 5) {
        if (v == 0) { r8c_tr_s(tr, "a bright crater ray on the moon"); r8c_dab(buf, stride, w, h, fx, fy, 8, 195, 193, 195, 180); }
        if (v == 1) { r8c_tr_s(tr, "a dark mare patch"); r8c_dab(buf, stride, w, h, fx, fy, 9, 120, 118, 120, 180); }
        if (v == 2) { r8c_tr_s(tr, "crater texture on the small moon"); r8c_dab(buf, stride, w, h, fx, fy, 5, 150, 148, 150, 200); r8c_dab(buf, stride, w, h, fx + 7, fy + 3, 4, 130, 128, 130, 200); }
        if (v == 3) { r8c_tr_s(tr, "the moon's edge against the dusk"); r8c_dab(buf, stride, w, h, fx, fy, 6, 170, 168, 170, 180); }
    }
    r8c_tr_nl(tr);
}
fn r8c_pass4(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    let imap:[]u8 = nio_alloc(4096);
    r8c_interest_recompute(buf, stride, w, h, imap);
    r8c_tr_s(tr, "The interest map: contrast x novelty x nearness to the focal anchor.\n");
    r8c_tr_s(tr, "Recomputed from the canvas every 20 fixations; visited places fade.\n");
    let f:i64 = 0;
    while (f < 240) {
        if (f > 0 && f - (f / 20 * 20) == 0) {
            r8c_interest_recompute(buf, stride, w, h, imap);
            r8c_tr_s(tr, "-- interest map recomputed from the canvas after fixation ");
            r8c_tr_n(tr, f);
            r8c_tr_s(tr, " --\n");
        }
        r8c_fixation(f, buf, stride, w, h, imap, tr);
        if (f - (f / 40 * 40) == 0) {
            _zag_print("fix ");
            _zag_println(_zag_i64_to_str(f));
        }
        f = f + 1;
    }
    nio_free(imap);
    r8c_tr_s(tr, "\n");
    r8c_tr_s(tr, "## PASS 5 - FINISH (vignette and grain)\n");
}

// ---------------- file helpers (truncate-write, not create-only) ----------------
fn r8c_cstr(s:[]u8) []u8 {
    let n:i64 = s.len;
    let b:[]u8 = nio_alloc((n as i32) + 1);
    let i:i64 = 0;
    while (i < n) { b[i] = s[i]; i = i + 1; }
    b[n] = 0;
    return b;
}
fn r8c_open_trunc(path:[]u8) i64 {
    let s:[]u8 = r8c_cstr(path);
    // open(2): O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644 = 420
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 420, 0, 0, 0);
    nio_free(s);
    return fd;
}
// write_all without slicing: pointer arithmetic, 1MB chunks
fn r8c_write_all(fd:i64, buf:[]u8, total:i64) i64 {
    let base:i64 = _zag_slice_ptr(buf) as i64;
    let at:i64 = 0;
    let calls:i64 = 0;
    while (at < total && calls < 8192) {
        let want:i64 = total - at;
        if (want > 1048576) { want = 1048576; }
        let n:i64 = _zag_raw_syscall(1, fd, base + at, want, 0, 0, 0);
        if (n == 0 - 4) { continue; }
        if (n <= 0) { return 0 - 7407; }
        at = at + n;
        calls = calls + 1;
    }
    if (at != total) { return 0 - 7407; }
    return at;
}

// ---------------- BMP header ----------------
fn r8c_put32(buf:[]u8, o:i64, v:i64) void {
    buf[o] = (v & 255) as u8;
    buf[o + 1] = ((v >> 8) & 255) as u8;
    buf[o + 2] = ((v >> 16) & 255) as u8;
    buf[o + 3] = ((v >> 24) & 255) as u8;
}
fn r8c_bmp_header(buf:[]u8, w:i64, h:i64) void {
    buf[0] = 66; buf[1] = 77; // BM
    r8c_put32(buf, 2, 54 + w * h * 3);
    r8c_put32(buf, 6, 0);
    r8c_put32(buf, 10, 54);
    r8c_put32(buf, 14, 40);
    r8c_put32(buf, 18, w);
    r8c_put32(buf, 22, h); // positive height = bottom-up rows
    r8c_put32(buf, 26, 1 + (24 << 16)); // planes=1, bpp=24
    r8c_put32(buf, 30, 0);
    r8c_put32(buf, 34, w * h * 3);
    r8c_put32(buf, 38, 2835);
    r8c_put32(buf, 42, 2835);
    r8c_put32(buf, 46, 0);
    r8c_put32(buf, 50, 0);
}

// flip rows vertically in place: canvas is top-down, BMP is bottom-up
fn r8c_flip_vertical(buf:[]u8, stride:i64, h:i64) void {
    let y:i64 = 0;
    while (y < h / 2) {
        let y2:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < stride) {
            let o1:i64 = 54 + y * stride + x;
            let o2:i64 = 54 + y2 * stride + x;
            let t:u8 = buf[o1];
            buf[o1] = buf[o2];
            buf[o2] = t;
            x = x + 1;
        }
        y = y + 1;
    }
}

// ---------------- Pass 5: finish ----------------
fn r8c_pass5(buf:[]u8, stride:i64, w:i64, h:i64, tr:i64) void {
    r8c_tr_s(tr, "V1: vignette - the eye's attention falls off toward the frame edge,\n");
    r8c_tr_s(tr, "    so the image does too. Quiet, not heavy.\n");
    r8c_tr_s(tr, "V2: grain - a whisper of hash grain, +/-14, so no gradient is ever\n");
    r8c_tr_s(tr, "    perfectly smooth. The world is not a gradient.\n");
    r8c_tr_s(tr, "\n");
    r8c_tr_s(tr, "## Decision count\n");
    r8c_tr_s(tr, "Pass 1: 5 gist decisions. Pass 2: 14 big decisions. Pass 3: 8 light\n");
    r8c_tr_s(tr, "decisions. Pass 4: 240 fixations. Pass 5: 2 finish decisions.\n");
    r8c_tr_s(tr, "Total: 269 deliberate decisions. No RNG. Byte-identical reruns.\n");
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let dx:i64 = x - w / 2;
            let dy:i64 = y - h / 2;
            let d2:i64 = dx * dx + dy * dy;
            let vig:i64 = 1024 - d2 * 280 / 524288;
            if (vig < 700) { vig = 700; }
            let g:i64 = r8c_h01(y * w + x, 5, 9301) - 512;
            let o:i64 = 54 + y * stride + x * 3;
            let b0:i64 = buf[o] as i64;
            let g0:i64 = buf[o + 1] as i64;
            let r0:i64 = buf[o + 2] as i64;
            b0 = b0 * vig / 1024 + g * 14 / 512;
            g0 = g0 * vig / 1024 + g * 14 / 512;
            r0 = r0 * vig / 1024 + g * 14 / 512;
            buf[o] = r8c_clamp(b0, 0, 255) as u8;
            buf[o + 1] = r8c_clamp(g0, 0, 255) as u8;
            buf[o + 2] = r8c_clamp(r0, 0, 255) as u8;
            x = x + 1;
        }
        y = y + 1;
    }
}

// ---------------- main ----------------
fn main() i32 {
    let bmppath:[]u8 = _zag_arg(1);
    let trpath:[]u8 = _zag_arg(2);
    if (_zag_strcmp(bmppath, "") == 1) { bmppath = "r8c_alien_1024.bmp"; }
    if (_zag_strcmp(trpath, "") == 1) { trpath = "ELABORATION_TRACE.md"; }
    let w:i64 = 1024;
    let h:i64 = 1024;
    let stride:i64 = w * 3;
    let total:i64 = 54 + h * stride;
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) {
        _zag_println("alloc failed");
        return 1;
    }
    r8c_bmp_header(buf, w, h);
    // zero the pixel area (allocator does not promise zeroes)
    let zi:i64 = 54;
    while (zi < total) { buf[zi] = 0; zi = zi + 1; }
    let tr:i64 = r8c_open_trunc(trpath);
    if (tr < 0) {
        _zag_println("cannot open trace path");
        return 1;
    }
    _zag_println("pass1 gist");
    r8c_pass1_gist(buf, stride, w, h, tr);
    _zag_println("pass2 decisions");
    r8c_dec01_sun(buf, stride, w, h, tr);
    r8c_dec02_sky(buf, stride, w, h, tr);
    r8c_dec03_rim(buf, stride, w, h, tr);
    r8c_dec04_peak(buf, stride, w, h, tr);
    r8c_dec05_breach(buf, stride, w, h, tr);
    r8c_dec06_hills(buf, stride, w, h, tr);
    r8c_dec07_plain(buf, stride, w, h, tr);
    r8c_dec08_stones(buf, stride, w, h, tr);
    r8c_dec09_arch(buf, stride, w, h, tr);
    r8c_dec10_giant(buf, stride, w, h, tr);
    r8c_dec11_moon(buf, stride, w, h, tr);
    r8c_dec12_clouds(buf, stride, w, h, tr);
    r8c_dec13_haze(buf, stride, w, h, tr);
    r8c_dec14_focal(tr);
    _zag_println("pass3 light");
    r8c_pass3(buf, stride, w, h, tr);
    _zag_println("pass4 fixations");
    r8c_pass4(buf, stride, w, h, tr);
    _zag_println("pass5 finish");
    r8c_pass5(buf, stride, w, h, tr);
    nio_close(tr);
    r8c_flip_vertical(buf, stride, h);
    let bfd:i64 = r8c_open_trunc(bmppath);
    if (bfd < 0) {
        _zag_println("cannot open bmp path");
        return 1;
    }
    let wr:i64 = r8c_write_all(bfd, buf, total);
    nio_close(bfd);
    if (wr != total) {
        _zag_println("bmp short write");
        return 1;
    }
    nio_free(buf);
    _zag_println("done");
    return 0;
}

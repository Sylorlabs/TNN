// ============================================================
// var3_emberfall.zag — IMAGINATION DISCOVERY: VARIATION 3.
// World: "EMBERFALL" — a volcanic night world. There is NO sun.
// The ground is black basalt split by a winding river of lava;
// glowing cracks vein the plain; basalt boulders catch orange
// rim-light from the flows; embers rise on the heat. Above it
// all, the sky burns cold: three huge auroral curtains — green
// feet, teal mid, violet crowns — with vertical ray structure,
// over a starfield. Distant lava fields smolder red at the
// horizon.
//
// DELIBERATE WORLD-MODEL DECISIONS (the imagination, not dice):
//  1. INVERTED LIGHT LOGIC: no sun at all. Light comes from
//     BELOW (lava: warm, distance-falloff) and ABOVE (aurora:
//     faint cool wash). Nothing is lit from a horizon.
//  2. The lava river is the compositional spine: it winds from
//     the foreground to the horizon, leading the eye.
//  3. Aurorae are the sky subject: tall curtained draperies
//     with ray structure, not a starfield with a tint.
//  4. Shadows are soft and short, cast AWAY from the nearest
//     lava — every rock's dark side points away from the river.
//  5. Palette: black-violet night, molten orange, aurora
//     green/teal/violet. Nothing amber-dusk, nothing ice-blue.
//  6. Embers + ash haze: the air itself is part of the world.
//
// Deterministic: integer-hash noise, fixed seeds, zero RNG.
// D-COMP: zero axis-aligned filled-primitive placement calls; all
// coverage is per-pixel analytic tests. No fn/var named
// rect/band/blotch/fill/stroke/circle/ellipse.
// Buffer: 1024^2*3 = 3.1 MB < 2^25.
// Build: znc var3_emberfall.zag --no-zagd --no-analyze -o var3_emberfall
// Usage: var3_emberfall <outdir> <1024|2048>
// ============================================================
@import("../../toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- byte helpers ----------------
fn v3_put32le(b:[]u8, o:i64, v:i64) i64 {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    return 0;
}

// ---------------- small math ----------------
fn v3_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn v3_clamp(v:i64, lo:i64, hi:i64) i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn v3_ss(t:i64) i64 {
    let c:i64 = v3_clamp(t, 0, 1024);
    return c * c * (3072 - 2 * c) / 1048576;
}
fn v3_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let r:i64 = v;
    let i:i64 = 0;
    while (i < 64) {
        r = (r + v / r) / 2;
        i = i + 1;
    }
    return r;
}
fn v3_pack(r:i64, g:i64, b:i64) i64 {
    return (r & 255) + ((g & 255) << 8) + ((b & 255) << 16);
}
fn v3_lerp(a:i64, b:i64, t:i64) i64 {
    return a + (b - a) * t / 1024;
}
// add with clamp: the wrap-bug lesson — NEVER let a channel wrap.
fn v3_addc(v:i64, add:i64) i64 {
    return v3_clamp(v + add, 0, 255);
}

// ---------------- deterministic integer-hash noise ----------------
fn v3_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn v3_h01(x:i64, y:i64, seed:i64) i64 {
    return v3_hash(x, y, seed) >> 22;
}
fn v3_sstep(t:i64) i64 {
    let t2:i64 = t * t;
    let t3:i64 = t2 * t;
    return (3 * t2 * 255 - 2 * t3) / 65025;
}
fn v3_vnoise(x:i64, y:i64, seed:i64) i64 {
    let xb:i64 = x + 268435456;
    let yb:i64 = y + 268435456;
    let xi:i64 = xb >> 8;
    let yi:i64 = yb >> 8;
    let xf:i64 = xb & 255;
    let yf:i64 = yb & 255;
    let u:i64 = v3_sstep(xf);
    let v:i64 = v3_sstep(yf);
    let a:i64 = v3_h01(xi, yi, seed);
    let b:i64 = v3_h01(xi + 1, yi, seed);
    let c:i64 = v3_h01(xi, yi + 1, seed);
    let d:i64 = v3_h01(xi + 1, yi + 1, seed);
    let ab:i64 = a + (b - a) * u / 256;
    let cd:i64 = c + (d - c) * u / 256;
    return ab + (cd - ab) * v / 256;
}
fn v3_fbm(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + v3_vnoise(xx, yy, seed + o * 131) * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 512; }
    return sum * 512 / norm;
}

// ---------------- world constants ----------------
fn v3_hz() i64 { return 640; }

// ---------------- night sky + stars ----------------
fn v3_sky(x:i64, y:i64) i64 {
    let hz:i64 = v3_hz();
    let t:i64 = v3_clamp(y * 1024 / hz, 0, 1024);
    let r:i64 = v3_lerp(8, 20, t);
    let g:i64 = v3_lerp(8, 18, t);
    let b:i64 = v3_lerp(22, 44, t);
    let sh:i64 = v3_h01(x / 2, y / 2, 8101);
    if (sh < 36 && y < hz - 20) {
        let br:i64 = 100 + sh * 155 / 36;
        if (br > r) { r = br; }
        if (br > g) { g = br; }
        if (br > b) { b = br; }
    }
    return v3_pack(r, g, b);
}

// ---------------- aurora curtains ----------------
// Three draperies: green feet -> teal -> violet crowns, ray structure.
fn v3_curbase(i:i64) i64 {
    if (i == 0) { return 200; }
    if (i == 1) { return 520; }
    return 830;
}
fn v3_curw(i:i64) i64 {
    if (i == 0) { return 130; }
    if (i == 1) { return 175; }
    return 110;
}
fn v3_curtop(i:i64) i64 {
    if (i == 0) { return 60; }
    if (i == 1) { return 40; }
    return 80;
}
fn v3_curbot(i:i64) i64 {
    if (i == 0) { return 470; }
    if (i == 1) { return 520; }
    return 450;
}
fn v3_aurora(x:i64, y:i64, rgb:i64) i64 {
    let r:i64 = rgb & 255;
    let g:i64 = (rgb >> 8) & 255;
    let b:i64 = (rgb >> 16) & 255;
    let i:i64 = 0;
    while (i < 3) {
        let top:i64 = v3_curtop(i);
        let bot:i64 = v3_curbot(i);
        if (y > top - 40 && y < bot + 30) {
            // gently curving curtain centerline
            let cx:i64 = v3_curbase(i) + (v3_fbm(v3_curbase(i), y * 2, 8102 + i * 57, 2) - 512) * 90 / 512;
            let w:i64 = v3_curw(i);
            let d:i64 = v3_abs(x - cx);
            if (d < w) {
                // vertical envelope: fade at crown and feet
                let env:i64 = v3_ss((y - top) * 1024 / 130);
                let env2:i64 = 1024 - v3_ss((y - (bot - 70)) * 1024 / 70);
                if (env2 < env) { env = env2; }
                // ray structure: vertical striations
                let rays:i64 = v3_fbm(x * 7, y / 3, 8105 + i * 91, 2);
                let raym:i64 = 350 + v3_ss((rays - 380) * 1024 / 320) * 674 / 1024;
                let inten:i64 = v3_ss((w - d) * 1024 / w) * env / 1024 * raym / 1024;
                // color by height: green -> teal -> violet
                let t:i64 = (y - top) * 1024 / (bot - top);
                let cr:i64 = v3_lerp(60, 150, v3_ss((t - 500) * 1024 / 524));
                let cg:i64 = v3_lerp(255, 100, v3_ss((t - 350) * 1024 / 674));
                let cb:i64 = v3_lerp(150, 255, v3_ss((t - 300) * 1024 / 724));
                // lower border: bright green edge
                let edge:i64 = v3_ss((y - (bot - 46)) * 1024 / 46);
                cr = v3_lerp(cr, 80, edge);
                cg = v3_lerp(cg, 255, edge);
                cb = v3_lerp(cb, 160, edge);
                r = v3_addc(r, cr * inten / 700);
                g = v3_addc(g, cg * inten / 700);
                b = v3_addc(b, cb * inten / 700);
            }
        }
        i = i + 1;
    }
    return v3_pack(r, g, b);
}

// ---------------- distant lava-field glow at the horizon ----------------
fn v3_horizonglow(x:i64, y:i64, rgb:i64) i64 {
    let hz:i64 = v3_hz();
    if (y < hz - 60 || y > hz + 6) { return rgb; }
    let n:i64 = v3_fbm(x * 2, 31, 8108, 3);
    let a:i64 = v3_ss((y - (hz - 60)) * 1024 / 66) * v3_ss((n - 350) * 1024 / 300) / 1024;
    let r:i64 = v3_addc(rgb & 255, 190 * a / 1024);
    let g:i64 = v3_addc((rgb >> 8) & 255, 70 * a / 1024);
    let b:i64 = v3_addc((rgb >> 16) & 255, 25 * a / 1024);
    return v3_pack(r, g, b);
}

// ---------------- lava river ----------------
// Winding centerline from foreground to horizon.
fn v3_rivercx(y:i64) i64 {
    let n:i64 = v3_fbm(77, y * 2, 8109, 3);
    return 480 + (n - 512) * 320 / 512;
}
fn v3_riverhw(y:i64) i64 {
    let n:i64 = v3_fbm(913, y * 3, 8110, 2);
    return 36 + (n - 300) * 44 / 724;
}
// distance from pixel to the river (signed via centerline)
fn v3_riverd(x:i64, y:i64) i64 {
    return v3_abs(x - v3_rivercx(y));
}
fn v3_lava(x:i64, y:i64, rgb:i64) i64 {
    let hz:i64 = v3_hz();
    if (y < hz - 4) { return rgb; }
    let d:i64 = v3_riverd(x, y);
    let hw:i64 = v3_riverhw(y);
    if (d >= hw) { return rgb; }
    // flow streaks along the channel
    let fl:i64 = v3_fbm(x * 2, y * 9, 8111, 2);
    let t:i64 = d * 1024 / hw;
    // core: near-white yellow; mid: orange; edge: dark red
    let r:i64 = v3_lerp(255, 150, v3_ss((t - 420) * 1024 / 604));
    let g:i64 = v3_lerp(215, 55, v3_ss((t - 420) * 1024 / 604));
    let b:i64 = v3_lerp(140, 22, v3_ss((t - 420) * 1024 / 604));
    // floating crust plates: dark patches on the flow
    let crust:i64 = v3_fbm(x * 3, y * 3, 8112, 3);
    if (crust > 640 && t > 200) {
        let ca:i64 = v3_ss((crust - 640) * 1024 / 200);
        r = v3_lerp(r, 70, ca);
        g = v3_lerp(g, 26, ca);
        b = v3_lerp(b, 14, ca);
    }
    // streak brightness variation
    let st:i64 = (fl - 512) * 36 / 512;
    r = v3_addc(r, st); g = v3_addc(g, st); b = v3_addc(b, st / 2);
    return v3_pack(r, g, b);
}
// warm light cast by the lava onto nearby basalt (distance falloff)
fn v3_lavaglow(x:i64, y:i64, rgb:i64) i64 {
    let hz:i64 = v3_hz();
    if (y < hz - 4) { return rgb; }
    let d:i64 = v3_riverd(x, y);
    let hw:i64 = v3_riverhw(y);
    if (d < hw || d > hw + 220) { return rgb; }
    let a:i64 = v3_ss((hw + 220 - d) * 1024 / 220);
    let r:i64 = v3_addc(rgb & 255, 185 * a / 1024);
    let g:i64 = v3_addc((rgb >> 8) & 255, 88 * a / 1024);
    let b:i64 = v3_addc((rgb >> 16) & 255, 34 * a / 1024);
    return v3_pack(r, g, b);
}

// ---------------- glowing cracks ----------------
fn v3_crack(x:i64, y:i64) i64 {
    let n:i64 = v3_fbm(x * 3 + 900, y * 3, 8113, 3);
    let d:i64 = v3_abs(n - 512);
    if (d > 16) { return 0; }
    return v3_ss((16 - d) * 1024 / 16);
}
fn v3_cracks(x:i64, y:i64, rgb:i64) i64 {
    let hz:i64 = v3_hz();
    if (y < hz) { return rgb; }
    // keep cracks off the river itself
    if (v3_riverd(x, y) < v3_riverhw(y) + 8) { return rgb; }
    let ck:i64 = v3_crack(x, y);
    if (ck == 0) { return rgb; }
    let r:i64 = v3_addc(rgb & 255, 255 * ck / 1024);
    let g:i64 = v3_addc((rgb >> 8) & 255, 130 * ck / 1024);
    let b:i64 = v3_addc((rgb >> 16) & 255, 55 * ck / 1024);
    return v3_pack(r, g, b);
}

// ---------------- basalt plain ----------------
fn v3_plain(x:i64, y:i64, rgb:i64) i64 {
    let hz:i64 = v3_hz();
    if (y < hz) { return rgb; }
    // near-black basalt with subtle texture
    let m1:i64 = v3_fbm(x * 2, y * 2, 8114, 3);
    let m2:i64 = v3_fbm(x * 8, y * 8, 8115, 2);
    let r:i64 = 24 + (m1 - 512) * 22 / 512 + (m2 - 512) * 12 / 512;
    let g:i64 = 22 + (m1 - 512) * 20 / 512 + (m2 - 512) * 11 / 512;
    let b:i64 = 30 + (m1 - 512) * 26 / 512 + (m2 - 512) * 13 / 512;
    r = v3_clamp(r, 8, 90); g = v3_clamp(g, 8, 90); b = v3_clamp(b, 10, 110);
    // faint cool wash from the aurora above (very soft, shadowless)
    let aw:i64 = 6 + v3_fbm(x, 5, 8116, 2) / 170;
    g = v3_addc(g, aw / 2); b = v3_addc(b, aw);
    return v3_pack(r, g, b);
}

// ---------------- basalt boulders ----------------
// Dark rocks; orange rim on the lava-facing side, dark side away.
fn v3_nrock() i64 { return 5; }
fn v3_rockcx(i:i64) i64 {
    if (i == 0) { return 150; }
    if (i == 1) { return 330; }
    if (i == 2) { return 700; }
    if (i == 3) { return 880; }
    return 560;
}
fn v3_rockcy(i:i64) i64 {
    if (i == 0) { return 830; }
    if (i == 1) { return 920; }
    if (i == 2) { return 860; }
    if (i == 3) { return 940; }
    return 760;
}
fn v3_rockr(i:i64) i64 {
    if (i == 0) { return 58; }
    if (i == 1) { return 44; }
    if (i == 2) { return 72; }
    if (i == 3) { return 50; }
    return 38;
}
fn v3_rockedge(x:i64, y:i64, i:i64) i64 {
    let cx:i64 = v3_rockcx(i);
    let cy:i64 = v3_rockcy(i);
    let rr:i64 = v3_rockr(i);
    let dx:i64 = x - cx;
    let dy:i64 = y - cy;
    let wob:i64 = (v3_fbm(x / 2 + i * 53, y / 2, 8117 + i * 17, 3) - 512) * rr / 900;
    let d:i64 = v3_isqrt(dx * dx + dy * dy) + wob;
    return rr - d;
}
fn v3_rockpx(x:i64, y:i64, rgb:i64) i64 {
    let i:i64 = 0;
    while (i < v3_nrock()) {
        let e:i64 = v3_rockedge(x, y, i);
        if (e > 0) {
            let cx:i64 = v3_rockcx(i);
            let cy:i64 = v3_rockcy(i);
            let rr:i64 = v3_rockr(i);
            // base basalt, faint aurora wash on top
            let r:i64 = 34;
            let g:i64 = 32;
            let b:i64 = 44;
            let mot:i64 = (v3_fbm(x * 5, y * 5, 8118 + i * 29, 2) - 512) * 26 / 512;
            r = v3_addc(r, mot); g = v3_addc(g, mot); b = v3_addc(b, mot);
            // lava-facing rim: which side faces the river?
            let rcx:i64 = v3_rivercx(y);
            let face:i64 = v3_clamp((rcx - cx) * 1024 / 400, -1024, 1024);
            let px:i64 = v3_clamp((x - cx) * 1024 / rr, -1024, 1024);
            // rim where the pixel's side aligns with the river direction
            let align:i64 = v3_ss((px * face / 1024 + 1024) / 2 - 120);
            let rim:i64 = v3_ss(e * 1024 / 26) * align / 1024;
            r = v3_addc(r, 255 * rim / 1024);
            g = v3_addc(g, 120 * rim / 1024);
            b = v3_addc(b, 45 * rim / 1024);
            // soft shadow on the far side from the lava
            let dark:i64 = v3_ss((0 - px * face / 1024 + 1024) / 2 - 500);
            r = r * (1024 - dark * 400 / 1024) / 1024;
            g = g * (1024 - dark * 400 / 1024) / 1024;
            b = b * (1024 - dark * 400 / 1024) / 1024;
            // settle into the ground
            if (e < 8) {
                let set:i64 = v3_ss(e * 1024 / 8);
                let pr:i64 = rgb & 255;
                let pg:i64 = (rgb >> 8) & 255;
                let pb:i64 = (rgb >> 16) & 255;
                r = v3_lerp(pr, r, set);
                g = v3_lerp(pg, g, set);
                b = v3_lerp(pb, b, set);
            }
            return v3_pack(r, g, b);
        }
        i = i + 1;
    }
    return rgb;
}

// ---------------- embers ----------------
// 64 deterministic ember slots rising above the lava.
// Positions are precomputed once (pure function of slot index),
// so the per-pixel test is cheap integer compares.
fn v3_embex(k:i64) i64 {
    let ry:i64 = 660 + (v3_h01(k, 7, 8119) * 360 / 1024);
    let rcx:i64 = v3_rivercx(ry);
    return rcx + (v3_h01(k, 13, 8120) - 512) * 260 / 512;
}
fn v3_embrey(k:i64) i64 {
    return 660 + (v3_h01(k, 7, 8119) * 360 / 1024);
}
fn v3_ember(x:i64, y:i64, rgb:i64) i64 {
    let k:i64 = 0;
    while (k < 64) {
        let ex:i64 = v3_embex(k);
        let ry:i64 = v3_embrey(k);
        let dx:i64 = x - ex;
        if (dx >= -2 && dx <= 2) {
            let dy:i64 = y - ry;
            if (dy >= -14 && dy <= 2) {
                let inten:i64 = v3_ss((2 - v3_abs(dx)) * 1024 / 2) * v3_ss((dy + 14) * 1024 / 16) / 1024;
                // only some slots are lit (the rest are ash)
                if (v3_h01(k, 29, 8121) > 300) {
                    let r:i64 = v3_addc(rgb & 255, 255 * inten / 1024);
                    let g:i64 = v3_addc((rgb >> 8) & 255, 170 * inten / 1024);
                    let b:i64 = v3_addc((rgb >> 16) & 255, 80 * inten / 1024);
                    return v3_pack(r, g, b);
                }
            }
        }
        k = k + 1;
    }
    return rgb;
}

// ---------------- ash haze ----------------
fn v3_ash(x:i64, y:i64, rgb:i64) i64 {
    let hz:i64 = v3_hz();
    if (y < hz || y > hz + 160) { return rgb; }
    let m:i64 = v3_fbm(x * 2, y * 4, 8122, 3);
    if (m < 580) { return rgb; }
    let a:i64 = v3_ss((m - 580) * 1024 / 220) / 4;
    let r:i64 = v3_lerp(rgb & 255, 120, a);
    let g:i64 = v3_lerp((rgb >> 8) & 255, 100, a);
    let b:i64 = v3_lerp((rgb >> 16) & 255, 130, a);
    return v3_pack(r, g, b);
}

// ---------------- main rasterizer ----------------
// back-to-front: sky -> aurora -> horizon glow -> plain ->
// lava -> lava glow -> cracks -> rocks -> embers -> ash ->
// vignette -> dither.
fn v3_render(buf:[]u8, w:i64, h:i64, stride:i64, seed:i64) void {
    let x:i64 = 0;
    while (x < w) {
        let y:i64 = 0;
        while (y < h) {
            let rgb:i64 = v3_sky(x, y);
            rgb = v3_aurora(x, y, rgb);
            rgb = v3_horizonglow(x, y, rgb);
            rgb = v3_plain(x, y, rgb);
            rgb = v3_lava(x, y, rgb);
            rgb = v3_lavaglow(x, y, rgb);
            rgb = v3_cracks(x, y, rgb);
            rgb = v3_rockpx(x, y, rgb);
            rgb = v3_ember(x, y, rgb);
            rgb = v3_ash(x, y, rgb);
            let r:i64 = rgb & 255;
            let g:i64 = (rgb >> 8) & 255;
            let b:i64 = (rgb >> 16) & 255;
            let vx:i64 = x - w / 2;
            let vy:i64 = y - h / 2;
            let vig:i64 = 1024 - (vx * vx + vy * vy) * 140 / 524288;
            if (vig < 0) { vig = 0; }
            r = r * vig / 1024; g = g * vig / 1024; b = b * vig / 1024;
            let dh:i64 = v3_h01(x, y, seed + 999);
            let off:i64 = (dh - 512) * 6 / 1024;
            r = v3_clamp(r + off, 0, 255);
            g = v3_clamp(g + off, 0, 255);
            b = v3_clamp(b + off, 0, 255);
            let o:i64 = 54 + (h - 1 - y) * stride + x * 3;
            buf[o] = b as u8;
            buf[o + 1] = g as u8;
            buf[o + 2] = r as u8;
            y = y + 1;
        }
        if (x - (x / 128) * 128 == 0) {
            _zag_print("col ");
            _zag_println(_zag_i64_to_str(x));
        }
        x = x + 1;
    }
}

// ---------------- BMP output ----------------
fn v3_open_trunc(root:i64, name:[]u8) i64 {
    let s:[]u8 = nio_cstr(name);
    if (s.len == 0) { return -7401; }
    let flags:i64 = 657985;
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, flags, 420, 0, 0);
    nio_free(s);
    return fd;
}
fn v3_write_bmp(root:i64, name:[]u8, buf:[]u8, w:i64, h:i64, stride:i64) i64 {
    buf[0] = 66; buf[1] = 77;
    v3_put32le(buf, 2, 54 + stride * h);
    v3_put32le(buf, 6, 0);
    v3_put32le(buf, 10, 54);
    v3_put32le(buf, 14, 40);
    v3_put32le(buf, 18, w);
    v3_put32le(buf, 22, h);
    buf[26] = 1; buf[27] = 0;
    buf[28] = 24; buf[29] = 0;
    v3_put32le(buf, 30, 0);
    v3_put32le(buf, 34, stride * h);
    v3_put32le(buf, 38, 2835);
    v3_put32le(buf, 42, 2835);
    v3_put32le(buf, 46, 0);
    v3_put32le(buf, 50, 0);
    let total:i64 = 54 + stride * h;
    let fd:i64 = v3_open_trunc(root, name);
    if (fd < 0) { return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = buf[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}

fn main() i32 {
    let outd:[]u8 = _zag_arg(1);
    let szs:[]u8 = _zag_arg(2);
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let w:i64 = 1024;
    let h:i64 = 1024;
    let is2048:i64 = 0;
    if (_zag_strcmp(szs, "2048") == 1) { w = 2048; h = 2048; is2048 = 1; }
    let name:[]u8 = "var3_emberfall_1024.bmp";
    if (is2048 == 1) { name = "var3_emberfall_2048.bmp"; }
    let root:i64 = nio_open_root(outd);
    if (root < 0) {
        _zag_println("cannot open outdir");
        return 1;
    }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let total:i64 = 54 + stride * h;
    _zag_print("rendering ");
    _zag_println(name);
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) {
        _zag_println("alloc failed");
        nio_close(root);
        return 1;
    }
    v3_render(buf, w, h, stride, 4400);
    let rc:i64 = v3_write_bmp(root, name, buf, w, h, stride);
    nio_free(buf);
    nio_close(root);
    if (rc != 0) {
        _zag_print("write failed ");
        _zag_println(_zag_i64_to_str(rc));
        return 1;
    }
    _zag_println("done");
    return 0;
}

// ============================================================
// D-ALPHA: direct waveform dreaming (position d, control fork)
// "no middlemen" - TNN dreams the waveform gesture by gesture;
// ALL sonic opinions live in the deliberation (Section D);
// the expansion (Section E) is OPINIONLESS ARITHMETIC ONLY:
// keyframe interpolation, stateless sine lookup, add, multiply,
// deterministic hash noise. No oscillators, no resonators,
// no filters, no envelopes, no periodic generators in Section E.
// Zero randomness anywhere: all variation from fixed hash seeds.
// Byte-identical reruns by construction.
// ============================================================
// znc toolchain: ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1
// build: znc dream.zag --no-zagd --no-analyze --no-foreground-cache -o dream
// run: ./dream kids d_alpha_kids.wav

const SR:i64 = 44100;
const PH1:i64 = 281474976710656; // 2^48 phase cycle
const INV48:f64 = 1.0/281474976710656.0;
const INV30:f64 = 1.0/1073741824.0;
const INV32:f64 = 1.0/4294967296.0;
const INV16:f64 = 1.0/65536.0;
const INV8:f64 = 1.0/256.0;

// ---------- byte helpers (sign-extending reads) ----------
fn put32(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
}
fn get32s(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | (((b[i+3] as i64)<<56)>>32;
}
fn put16(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
}
fn put64(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
    b[i+4]=((v>>32) & 255) as u8;
    b[i+5]=((v>>40) & 255) as u8;
    b[i+6]=((v>>48) & 255) as u8;
    b[i+7]=((v>>56) & 255) as u8;
}
fn get64(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24) | ((b[i+4] as i64)<<32) | ((b[i+5] as i64)<<40) | ((b[i+6] as i64)<<48) | ((b[i+7] as i64)<<56);
}
fn z_cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4095){return "";}
    let p:*u8=_zag_malloc((s.len+1) as i64) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..(s.len+1)];
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn w_all(fd:i64,b:[]u8)i64{
    let at:i64=0;
    let calls:i32=0;
    let blen:i64=b.len as i64;
    while(at<blen && calls<8192){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+at,blen-at,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<=0){return -7407;}
        at=at+n;
    }
    if(at!=blen){return -7407;}
    return at;
}

// ---------- deterministic hash noise (no RNG anywhere) ----------
// 32-bit fmix32 finalizer over a bijective linear seed mix.
// OPINIONLESS: flat, memoryless, no spectral opinion of its own.
// Used by deliberation (as a deterministic value source) and by
// expansion (breath/unvoiced components only, always under
// deliberated envelopes).
fn h32(s:i64,st:i64)i64{
    let z:i64=(s*2654435761+st*40503+1) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    z=(z*2246822519) & 4294967295;
    z=(z ^ (z>>13)) & 4294967295;
    z=(z*3266489917) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    return z;
}
fn wnoise(s:i64,st:i64)f64{
    return ((h32(s,st) as f64)/4294967296.0)*2.0-1.0;
}
fn h01(seed:i64,k:i64)f64{
    return (h32(seed,k) as f64)/4294967296.0;
}

// ---------- sine LUT (1024 entries + guard, i32 Q30) ----------
// STATELESS math function. Not a generator: it keeps no time, has
// no period of its own; periodicity comes only from deliberated
// pitch trajectories fed into it.
fn tsin_small(x:f64)f64{
    let x2:f64=x*x;
    let x3:f64=x2*x;
    return x-x3/6.0+x3*x2/120.0-x3*x2*x2/5040.0;
}
fn tcos_small(x:f64)f64{
    let x2:f64=x*x;
    return 1.0-x2/2.0+x2*x2/24.0-x2*x2*x2/720.0;
}
fn lut_build()[]u8{
    let p:*u8=_zag_malloc(4100) as *u8;
    let lut:[]u8=p[0..4100];
    let d:f64=6.283185307179586/1024.0;
    let c:f64=tcos_small(d);
    let s:f64=tsin_small(d);
    let sn:f64=0.0;
    let cn:f64=1.0;
    let i:i64=0;
    while(i<=1024){
        put32(lut,i*4,(sn*1073741824.0) as i64);
        let nsn:f64=sn*c+cn*s;
        let ncn:f64=cn*c-sn*s;
        sn=nsn;
        cn=ncn;
        if((i & 127)==127){
            let nn:f64=sn*sn+cn*cn;
            sn=sn/nn;
            cn=cn/nn;
        }
        i=i+1;
    }
    return lut;
}
fn sin01(lut:[]u8,ph:f64)f64{
    let x:f64=ph*1024.0;
    let idx:i64=(x as i64);
    if(idx>1023){idx=1023;}
    if(idx<0){idx=0;}
    let fr:f64=x-(idx as f64);
    let l0:i64=get32s(lut,idx*4);
    let l1:i64=get32s(lut,(idx+1)*4);
    return ((l0 as f64)+((l1-l0) as f64)*fr)*INV30;
}

// ---------- mix buffer (i64 Q24 samples in []u8 arena) ----------
fn mix_new(ns:i64)[]u8{
    let p:*u8=_zag_malloc(ns*8) as *u8;
    let m:[]u8=p[0..(ns*8)];
    let i:i64=0;
    while(i<ns*8){m[i]=0;i=i+1;}
    return m;
}
fn mix_add(m:[]u8,s:i64,v:f64)void{
    let cur:i64=get64(m,s*8);
    put64(m,s*8,cur+((v*16777216.0) as i64));
}
fn sstep(x:f64)f64{
    if(x<=0.0){return 0.0;}
    if(x>=1.0){return 1.0;}
    return x*x*(3.0-2.0*x);
}

// ============================================================
// SECTION D: DELIBERATION — all sonic opinions live here.
// The score is the deliberated document: scene as score, voices
// as gestures, interactions as timing. Every choice of pitch,
// resonance, envelope, jitter, timing is made HERE, explicitly,
// and frozen into the score records. Expansion (Section E) only
// reads these records and does arithmetic.
// ------------------------------------------------------------
// Score record: 64 i64 slots (512 bytes) per gesture.
// Common: 0=type(1 voiced,2 impact,3 breath), 1=start sample,
//   2=duration samples.
// Voiced: 3=voice id, 4..11=f0 keys x8 (Hz Q8), 12..41=harm
//   keys 10 harm x 3 keys (Q16), 42..49=env keys x8 (Q16),
//   50=jitter amp (Q16), 51=seed, 52=breath gain (Q16),
//   53..62=inharmonic ratios x10 (Q16, 65536=1.0).
// Impact: 3=table id, 4=gain Q16, 5=rate Q16, 6..9=env x4 Q16.
// Breath: 4=gain Q16, 5=seed, 6..9=env x4 Q16 (inhale shape).
// ============================================================
const SC_STRIDE:i64 = 64;
const SC_MAXG:i64 = 400;

fn sc_new()[]u8{
    let p:*u8=_zag_malloc(SC_MAXG*SC_STRIDE*8) as *u8;
    let sc:[]u8=p[0..(SC_MAXG*SC_STRIDE*8)];
    let i:i64=0;
    while(i<SC_MAXG*SC_STRIDE*8){sc[i]=0;i=i+1;}
    return sc;
}
fn dput(sc:[]u8,g:i64,slot:i64,v:i64)void{
    put64(sc,(g*SC_STRIDE+slot)*8,v);
}
fn dget(sc:[]u8,g:i64,slot:i64)i64{
    return get64(sc,(g*SC_STRIDE+slot)*8);
}
// gesture allocator: next free index, stored in slot 63 of gesture 0 header
fn galloc(sc:[]u8)i64{
    let n:i64=dget(sc,0,63);
    dput(sc,0,63,n+1);
    return n+1;
}

// ---- voice profiles: the deliberated knowledge of each child ----
// v0 Mara(6): f0base 400, bright (emphasis h2..h5), tumble bouts
// v1 Joss(4): f0base 540, shrieky (emphasis h3..h6), staccato
// v2 Tari(7): f0base 330, warm (emphasis h1..h3), guffaw
fn v_base(v:i64)f64{
    if(v==1){return 540.0;}
    if(v==2){return 330.0;}
    return 400.0;
}
// base harmonic profile per voice (10 harmonics, Q16-ish 0..1 as f64)
fn v_harm(v:i64,h:i64)f64{
    let hf:f64=(h+1) as f64;
    let a:f64=1.0/(1.0+hf*0.45);
    if(v==0){
        if(h==1){a=a*1.7;}
        if(h==2){a=a*1.8;}
        if(h==3){a=a*1.6;}
        if(h==4){a=a*1.4;}
    }
    if(v==1){
        if(h==2){a=a*1.8;}
        if(h==3){a=a*1.9;}
        if(h==4){a=a*1.7;}
        if(h==5){a=a*1.5;}
    }
    if(v==2){
        if(h==0){a=a*1.8;}
        if(h==1){a=a*1.6;}
        if(h==2){a=a*1.4;}
    }
    // tame the top octave slightly: study centroids sit 1700-3600Hz,
    // un-tamed h8-h10 pushed shrieks past 5000Hz
    if(h>=7){a=a*0.7;}
    return a;
}

// ---- d_voice: deliberate one voiced gesture (laugh pulse, shout,
// creak, hum) and freeze it into the score ----
// f0c: center pitch; dur: seconds; seed: deterministic variation;
// bright: emphasis shift; jit: jitter amp; bgain: breathiness;
// style: 0 laugh-pulse, 1 shout (long glide), 2 creak (low, ragged)
fn d_voice(sc:[]u8,voice:i64,t0:f64,dur:f64,f0c:f64,seed:i64,jit:f64,bgain:f64,style:i64,gain:f64)i64{
    let g:i64=galloc(sc);
    dput(sc,g,0,1);
    dput(sc,g,1,(t0*44100.0) as i64);
    dput(sc,g,2,(dur*44100.0) as i64);
    dput(sc,g,3,voice);
    // f0 keyframes: 3 deliberated glide shapes, chosen per gesture.
    // rise-fall (effort then release), sag (breath running out),
    // wobble (unstable, childlike). No two pulses share a contour
    // unless the hash says so - and then the other params differ.
    let pat:f64=h01(seed,300);
    let k:i64=0;
    while(k<8){
        let kf:f64=(k as f64)/7.0;
        let m:f64=1.0;
        if(pat<0.4){
            m=1.0+0.06*sstep(kf/0.35)-0.09*sstep((kf-0.3)/0.7);
        } else {
            if(pat<0.7){
                m=1.03-0.09*kf;
            } else {
                m=1.0+0.035*sstep(kf/0.25)-0.03*sstep((kf-0.2)/0.3)+0.02*sstep((kf-0.55)/0.25)-0.045*sstep((kf-0.7)/0.3);
            }
        }
        if(style==1){ m=1.0+0.55*kf; }          // shout: rising glide
        if(style==2){ m=1.0-0.25*kf+0.06*sstep((kf-0.5)/0.2); } // creak: sagging
        let fv:f64=f0c*m*(0.97+0.06*h01(seed,310+k));
        dput(sc,g,4+k,(fv*256.0) as i64);
        k=k+1;
    }
    // harmonic keys: 3 keyframes per harmonic; the emphasis MOVES
    // within the pulse (resonances shift, never sit). Two emphasis
    // harmonics chosen per gesture, boosted mid-pulse, the second
    // one taking over late - the vocal tract is always moving.
    let e1:i64=(h01(seed,320)*10.0) as i64;
    let e2:i64=(h01(seed,321)*10.0) as i64;
    if(e2==e1){e2=(e1+3) % 10;}
    let h:i64=0;
    while(h<10){
        let b0:f64=v_harm(voice,h)*0.72;
        let b1:f64=v_harm(voice,h);
        let b2:f64=v_harm(voice,h)*0.8;
        if(h==e1){b1=b1*1.7;b0=b0*1.2;}
        if(h==e2){b1=b1*1.4;b2=b2*1.7;}
        if(style==2){b0=b0*1.3;b1=b1*0.9;b2=b2*1.1;} // creak: duller, woody
        dput(sc,g,12+h*3+0,(b0*65536.0) as i64);
        dput(sc,g,12+h*3+1,(b1*65536.0) as i64);
        dput(sc,g,12+h*3+2,(b2*65536.0) as i64);
        dput(sc,g,53+h,((h+1)*65536)); // absolute partial ratios: integer (voice)
        h=h+1;
    }
    // envelope keys: fast attack, RAGGED decay - deliberate
    // asymmetry, never a clean exponential (that is the synth
    // smell). Mid-pulse dip = breath catching.
    let atk:f64=0.05+0.06*h01(seed,330);
    let kk:i64=0;
    while(kk<8){
        let kf:f64=(kk as f64)/7.0;
        let e:f64=0.0;
        if(kf<atk){e=kf/atk;}
        else{
            let u:f64=(kf-atk)/(1.0-atk);
            e=1.0-0.55*u-0.18*sstep((u-0.25)/0.2)+0.1*sstep((u-0.5)/0.15)-0.25*sstep((u-0.7)/0.3);
            e=e*(0.92+0.16*h01(seed,331+kk));
        }
        if(e<0.0){e=0.0;}
        if(kk==7){e=0.0;}
        if(style==1){ // shout: fuller sustain
            if(kf>=atk){e=(1.0-0.35*kf)*(0.95+0.1*h01(seed,331+kk));}
            if(kk==7){e=0.0;}
        }
        dput(sc,g,42+kk,(e*gain*65536.0) as i64);
        kk=kk+1;
    }
    dput(sc,g,50,(jit*65536.0) as i64);
    dput(sc,g,51,seed);
    dput(sc,g,52,(bgain*65536.0) as i64);
    return g;
}

// breath/air grain: 16384-sample noise grain with a NATURALLY
// FALLING spectrum (3 moving-average passes, deliberation-side).
// Real breath and room air fall with frequency; white hash noise
// does not. The shaping is deliberated and frozen here; expansion
// only looks the grain up. Seamless loop (wrapped averaging).
fn draw_breath_grain()[]u8{
    let n:i64=16384;
    let p:*u8=_zag_malloc(n*4) as *u8;
    let t:[]u8=p[0..(n*4)];
    let q:*u8=_zag_malloc(n*4) as *u8;
    let u:[]u8=q[0..(n*4)];
    let i:i64=0;
    while(i<n){
        put32(t,i*4,(wnoise(6100,i)*1073741824.0) as i64);
        i=i+1;
    }
    let pass:i64=0;
    while(pass<3){
        i=0;
        while(i<n){
            let acc:f64=0.0;
            let k:i64=0;
            while(k<16){
                let j:i64=i+k-8;
                if(j<0){j=j+n;}
                if(j>=n){j=j-n;}
                acc=acc+(get32s(t,j*4) as f64);
                k=k+1;
            }
            put32(u,i*4,(acc/16.0) as i64);
            i=i+1;
        }
        i=0;
        while(i<n){put32(t,i*4,get32s(u,i*4));i=i+1;}
        pass=pass+1;
    }
    _zag_free(_zag_slice_ptr(u));
    let m:f64=0.0;
    let pk:f64=1.0;
    i=0;
    while(i<n){
        let v:f64=(get32s(t,i*4) as f64);
        m=m+v;
        let av:f64=v;
        if(av<0.0){av=-av;}
        if(av>pk){pk=av;}
        i=i+1;
    }
    m=m/(n as f64);
    let scf:f64=0.6*1073741824.0/pk;
    i=0;
    while(i<n){
        put32(t,i*4,(((get32s(t,i*4) as f64)-m)*scf) as i64);
        i=i+1;
    }
    return t;
}
// ---- d_breath: deliberate an inhale/catch-breath gesture ----
// slot 10: grain start offset (deliberated; different breaths
// start at different points in the grain).
fn d_breath(sc:[]u8,t0:f64,dur:f64,gain:f64,seed:i64)i64{
    let g:i64=galloc(sc);
    dput(sc,g,0,3);
    dput(sc,g,1,(t0*44100.0) as i64);
    dput(sc,g,2,(dur*44100.0) as i64);
    dput(sc,g,4,(gain*65536.0) as i64);
    dput(sc,g,5,seed);
    // inhale shape: quick catch, peaky, ragged release
    dput(sc,g,6,0);
    dput(sc,g,7,(0.75*65536.0) as i64);
    dput(sc,g,8,(1.0*65536.0) as i64);
    dput(sc,g,9,0);
    dput(sc,g,10,((h01(seed,9)*16384.0) as i64));
    return g;
}
// ---- d_air: deliberate distant air (non-stationary by design) ----
// Long, quiet, slowly swelling: env starts at 0.55 (air is always
// there - the global fade-in covers the file start), swells, hands
// off to the next air gesture. Never flat, never a bed.
fn d_air(sc:[]u8,t0:f64,dur:f64,gain:f64,seed:i64)i64{
    let g:i64=galloc(sc);
    dput(sc,g,0,3);
    dput(sc,g,1,(t0*44100.0) as i64);
    dput(sc,g,2,(dur*44100.0) as i64);
    dput(sc,g,4,(gain*65536.0) as i64);
    dput(sc,g,5,seed);
    dput(sc,g,6,(0.55*65536.0) as i64);
    dput(sc,g,7,(0.8*65536.0) as i64);
    dput(sc,g,8,(1.0*65536.0) as i64);
    dput(sc,g,9,0);
    dput(sc,g,10,((h01(seed,9)*16384.0) as i64));
    return g;
}

// ---- drawn impact tables: deliberated waveforms, frozen ----
// The table IS the deliberation (a drawn thud). Expansion only
// looks it up.
fn draw_foot()[]u8{
    let n:i64=1024;
    let p:*u8=_zag_malloc(n*4) as *u8;
    let t:[]u8=p[0..(n*4)];
    let i:i64=0;
    while(i<n){
        let u:f64=(i as f64)/(n as f64);
        let v:f64=0.0;
        if(u<0.03){v=u/0.03;}
        else{
            // bipolar thud: positive strike, negative rarefaction
            // (a real impact oscillates around zero - unipolar would
            // pile DC into the mix). Deliberated shape, frozen here.
            let d:f64=(u-0.03)/0.97;
            v=(1.0-d)*(1.0-d)*(1.0-2.3*d);
            v=v+0.18*(1.0-d)*(h01(78,i)-0.5)*2.0; // grit crunch, drawn in
        }
        put32(t,i*4,(v*1073741824.0) as i64);
        i=i+1;
    }
    // zero-mean the table (deliberation-side hygiene: no DC contribution)
    let m:f64=0.0;
    i=0;
    while(i<n){m=m+(get32s(t,i*4) as f64);i=i+1;}
    m=m/(n as f64);
    i=0;
    while(i<n){put32(t,i*4,((get32s(t,i*4) as f64)-m) as i64);i=i+1;}
    return t;
}
fn draw_thud_big()[]u8{ // trip landing: bigger, messier
    let n:i64=2048;
    let p:*u8=_zag_malloc(n*4) as *u8;
    let t:[]u8=p[0..(n*4)];
    let i:i64=0;
    while(i<n){
        let u:f64=(i as f64)/(n as f64);
        let v:f64=0.0;
        if(u<0.015){v=u/0.015;}
        else{
            let d:f64=(u-0.015)/0.985;
            v=(1.0-d)*(1.0-d)*(1.0-d)*(1.0-2.3*d);
            v=v+0.3*(1.0-d)*(h01(80,i)-0.5)*2.0;
        }
        put32(t,i*4,(v*1073741824.0) as i64);
        i=i+1;
    }
    let m:f64=0.0;
    i=0;
    while(i<n){m=m+(get32s(t,i*4) as f64);i=i+1;}
    m=m/(n as f64);
    i=0;
    while(i<n){put32(t,i*4,((get32s(t,i*4) as f64)-m) as i64);i=i+1;}
    return t;
}
// breaker table: 3s drawn viscous breaker - slow rise, ragged
// crest with sub-crests, heavy fall. Deliberated, frozen.
fn draw_breaker(seed:i64)[]u8{
    let n:i64=132300; // 3s
    let p:*u8=_zag_malloc(n*4) as *u8;
    let t:[]u8=p[0..(n*4)];
    let i:i64=0;
    while(i<n){
        let u:f64=(i as f64)/(n as f64);
        let v:f64=0.0;
        if(u<0.30){
            v=sstep(u/0.30); // slow rise
        } else {
            if(u<0.55){
                // ragged crest: sub-crests, deliberate
                let cu:f64=(u-0.30)/0.25;
                v=1.0-0.25*cu+0.18*sstep((cu-0.15)/0.2)-0.22*sstep((cu-0.45)/0.2)+0.12*sstep((cu-0.7)/0.15);
                v=v*(0.85+0.3*h01(seed,i/441));
            } else {
                let du:f64=(u-0.55)/0.45; // heavy fall
                v=(1.0-du)*(1.0-du)*(0.75+0.25*h01(seed+1,i/882));
            }
        }
        // bipolar wash: the rush oscillates around zero (a real surf
        // does - the water moves both ways). Truly bipolar, so the
        // impact envelope cannot rectify it into DC.
        v=v*((h01(seed+2,i/7)-0.5)*2.0);
        put32(t,i*4,(v*1073741824.0) as i64);
        i=i+1;
    }
    let m:f64=0.0;
    i=0;
    while(i<n){m=m+(get32s(t,i*4) as f64);i=i+1;}
    m=m/(n as f64);
    i=0;
    while(i<n){put32(t,i*4,((get32s(t,i*4) as f64)-m) as i64);i=i+1;}
    return t;
}
// Duration is DERIVED from the table length and playback rate:
// the gesture spans exactly the drawn table, so expansion never
// sits on a clamped end-sample (which would smear DC).
fn d_impact(sc:[]u8,table:i64,t0:f64,gain:f64,rate:f64)i64{
    // Table ids: 0 footL, 1 footR (1024), 2 landing (2048),
    // 3 breakerA, 4 breakerB (132300).
    let tlen:f64=1024.0;
    if(table==2){tlen=2048.0;}
    if(table==3){tlen=132300.0;}
    if(table==4){tlen=132300.0;}
    let dur:f64=tlen/rate/44100.0;
    let g:i64=galloc(sc);
    dput(sc,g,0,2);
    dput(sc,g,1,(t0*44100.0) as i64);
    dput(sc,g,2,(dur*44100.0) as i64);
    dput(sc,g,3,table);
    dput(sc,g,4,(gain*65536.0) as i64);
    dput(sc,g,5,(rate*65536.0) as i64);
    dput(sc,g,6,0);
    dput(sc,g,7,(1.0*65536.0) as i64);
    dput(sc,g,8,(0.9*65536.0) as i64);
    dput(sc,g,9,0);
    return g;
}
// ---- d_footrun: deliberate a run of footsteps ----
fn d_footrun(sc:[]u8,t0:f64,t1:f64,ivl:f64,gain:f64,seed:i64)i64{
    let t:f64=t0;
    let k:i64=0;
    let last:i64=0;
    while(t<t1){
        let tab:i64=k & 1; // alternate feet, deliberately different tables
        let g:f64=gain*(0.85+0.3*h01(seed,k));
        let r:f64=0.92+0.16*h01(seed+1,k); // no two steps at the same rate
        last=d_impact(sc,tab,t,g,r);
        t=t+ivl*(0.88+0.24*h01(seed+2,k));
        k=k+1;
    }
    return last;
}
// ---- d_laugh_bout: deliberate a bout of laughter ----
// n pulses; f0 sags by `sag` across the bout (lungs emptying);
// gaps shrink for tumble; breathiness grows (running out of air).
// Returns the time of the last pulse end.
fn d_laugh_bout(sc:[]u8,voice:i64,t0:f64,n:i64,seed:i64,sag:f64,gap0:f64,gap1:f64,basedur:f64,style_boost:f64)i64{
    let t:f64=t0;
    let i:i64=0;
    while(i<n){
        let frac:f64=(i as f64)/(n as f64);
        let f0c:f64=v_base(voice)*(1.0-sag*frac)*(0.94+0.12*h01(seed,100+i));
        f0c=f0c*(1.0+style_boost*(h01(seed,101+i)-0.5));
        // Joss (4) shrieks: ~1 in 4 pulses lifts 25-50% - the
        // deliberate shriek, never a periodic accent
        if(voice==1){
            if(h01(seed,105+i)<0.25){f0c=f0c*(1.25+0.25*h01(seed,106+i));}
        }
        let dur:f64=basedur*(0.85+0.3*h01(seed,200+i));
        let jit:f64=0.04+0.03*h01(seed,210+i);
        if(voice==1){jit=0.06+0.03*h01(seed,210+i);}
        let bg:f64=0.04+0.3*frac*frac; // breathless at the end
        let gn:f64=0.5+0.2*h01(seed,220+i);
        d_voice(sc,voice,t,dur,f0c,seed+i*37+11,jit,bg,0,gn);
        let gap:f64=gap0+(gap1-gap0)*h01(seed,400+i);
        if(gap>0.15){ d_breath(sc,t+dur+gap*0.15,gap*0.55,0.10+0.1*frac,seed+i*53+7); }
        t=t+dur+gap;
        i=i+1;
    }
    return 0;
}

// ============================================================
// SECTION D (cont.): THE SCORES — deliberated scene documents.
// Each score is a committed deliberation: what happens, when,
// in what voice, with what gesture. All opinions here.
// ============================================================

// ---- score_kids: playground, late afternoon, three children ----
// Mara(0,6) bright tumble-laugh; Joss(1,4) shrieky staccato;
// Tari(2,7) deep guffaw. Chase game; tag at ~8s; trip at ~19.5s
// -> the tumble that falls into itself; contagion; winding down.
// A swing creaks indifferently through it all (~2.3s period).
fn score_kids(sc:[]u8)void{
    // distant air: the playground breathes. Three long, quiet,
    // slowly-swelling grain gestures (deliberated, non-stationary -
    // NOT a bed: gains 0.014-0.020, swells on 10s scales, never
    // flat). This is honest air, not a hiss filler.
    d_air(sc,0.0,10.0,0.016,7000);
    d_air(sc,9.0,11.0,0.020,7001);
    d_air(sc,19.0,11.0,0.014,7002);
    // swing creaks: low voiced gestures, deliberately irregular period
    let ct:f64=2.2;
    let ck:i64=0;
    while(ct<28.5){
        d_voice(sc,2,ct,0.55,95.0*(0.9+0.2*h01(900,ck)),9010+ck,0.14,0.02,2,0.10);
        ct=ct+2.3*(0.9+0.2*h01(901,ck));
        ck=ck+1;
    }
    // feet: Tari runs in, chase, trip, winding down
    d_footrun(sc,0.4,3.0,0.42,0.30,101);
    d_footrun(sc,3.2,7.8,0.36,0.34,102);
    d_footrun(sc,8.6,11.0,0.40,0.30,103);
    d_footrun(sc,11.2,15.0,0.34,0.33,104);
    d_footrun(sc,15.2,19.4,0.30,0.36,105);   // chase intensifies
    d_footrun(sc,22.8,26.5,0.44,0.26,106);   // winding down
    d_footrun(sc,26.8,28.8,0.55,0.18,107);   // walking away
    // Joss giggles first (staccato, high)
    d_laugh_bout(sc,1,1.0,4,201,0.05,0.10,0.20,0.075,0.15);
    // Mara laugh bout 1: the tumble begins
    d_laugh_bout(sc,0,2.6,7,202,0.12,0.12,0.26,0.13,0.0);
    // Tari chuckles underneath
    d_laugh_bout(sc,2,4.6,3,203,0.06,0.16,0.30,0.15,0.0);
    // chase: "whee!" (Mara) + Joss shriek bout
    d_voice(sc,0,6.0,0.34,430.0,204,0.05,0.06,1,0.5);
    d_laugh_bout(sc,1,6.5,5,205,0.10,0.09,0.18,0.07,0.25);
    // TAG at ~8.2: ensemble laugh, all three overlapping
    d_voice(sc,2,8.2,0.30,300.0,206,0.05,0.05,1,0.55);
    d_laugh_bout(sc,0,8.35,5,207,0.10,0.11,0.22,0.12,0.0);
    d_laugh_bout(sc,1,8.55,4,208,0.08,0.10,0.20,0.07,0.2);
    d_laugh_bout(sc,2,8.75,4,209,0.10,0.14,0.26,0.15,0.0);
    // scattered giggles, call and response
    d_laugh_bout(sc,0,11.4,3,210,0.06,0.14,0.28,0.11,0.0);
    d_laugh_bout(sc,2,12.3,2,211,0.05,0.16,0.30,0.14,0.0);
    d_laugh_bout(sc,0,13.6,6,212,0.14,0.11,0.24,0.12,0.0);
    d_voice(sc,1,15.6,0.30,560.0,213,0.06,0.05,1,0.45);
    d_laugh_bout(sc,1,16.0,4,214,0.08,0.10,0.20,0.07,0.15);
    // "got you!" - Tari, two syllables
    d_voice(sc,2,17.1,0.22,310.0,215,0.05,0.04,1,0.5);
    d_voice(sc,2,17.38,0.34,290.0,216,0.05,0.05,1,0.55);
    // TRIP at 19.5: gasp, landing thud, then THE TUMBLE -
    // 12 pulses, gaps shrinking 220->90ms, f0 sagging 20%,
    // breathlessness rising, last two pulses wheezy.
    d_breath(sc,19.45,0.18,0.35,217);
    d_impact(sc,2,19.62,0.7,0.8);
    d_laugh_bout(sc,2,19.85,12,218,0.20,0.09,0.22,0.14,0.0);
    // contagion: Mara and Joss catch it, overlapping, breathless
    d_laugh_bout(sc,0,22.6,6,219,0.16,0.10,0.22,0.12,0.0);
    d_laugh_bout(sc,1,22.9,5,220,0.12,0.09,0.20,0.07,0.2);
    // winding down
    d_laugh_bout(sc,0,25.8,2,221,0.05,0.16,0.30,0.11,0.0);
    d_laugh_bout(sc,2,26.4,2,222,0.05,0.18,0.32,0.14,0.0);
    d_laugh_bout(sc,1,27.3,1,223,0.04,0.20,0.20,0.08,0.1);
    // distant shouts (other kids, far away - dull, quiet)
    d_voice(sc,2,10.5,0.28,260.0,224,0.05,0.03,1,0.14);
    d_voice(sc,0,24.5,0.26,380.0,225,0.05,0.03,1,0.12);
}

// ---- score_kethra: Kethra's planet voice, rebuilt from scratch ----
// Same world as PLANETVOICE.md (ringed super-Earth, argon air,
// Ilyra's 18s tidal breath, rift vents, cryo cracks, magnetosphere
// chorus) but NO resonators, NO struck partials, NO chirp
// generators, NO noise beds. Every sound is a deliberated gesture:
// voiced (low swells, groans, chorus events), impact (cracks),
// breath (wind as raw noise under slow deliberate swells).
fn score_kethra(sc:[]u8)void{
    // 1. deep planetary pressure: 18s tidal swells, f0 33-38Hz,
    //    deliberate slow wander, never a fixed drone
    let k:i64=0;
    while(k<2){
        let t0:f64=(k as f64)*15.0+0.5;
        d_voice(sc,2,t0,14.0,34.0*(1.0+0.06*h01(3100,k)),3101+k,0.10,0.10,0,0.5);
        k=k+1;
    }
    // 2. crust groans: low, ragged, irregular
    d_voice(sc,2,3.0,2.2,58.0,3110,0.16,0.15,2,0.35);
    d_voice(sc,2,9.5,2.8,64.0,3111,0.18,0.15,2,0.4);
    d_voice(sc,2,16.0,2.4,71.0,3112,0.15,0.15,2,0.35);
    // 3. rift exhalations: deep breath gestures, slow and huge
    d_breath(sc,5.0,3.5,0.30,3120);
    d_breath(sc,11.0,4.0,0.34,3121);
    d_breath(sc,17.5,3.0,0.28,3122);
    // 4. cryo cracks: sparse impacts, deliberate timing
    let c:i64=0;
    while(c<14){
        let t:f64=1.0+19.0*h01(3130,c);
        d_impact(sc,(c & 1),t,0.25+0.45*h01(3131,c),2.2+1.4*h01(3132,c));
        c=c+1;
    }
    // 5. the voice proper: magnetosphere chorus - rising EVENTS,
    //    each deliberately different: stutter mid-rise (the sky
    //    clearing its throat), uneven slopes, no melody, no rhythm.
    //    f0 rises 900->3400 across ~1s but each event dreams its
    //    own contour; harmonic emphasis drifts as it rises.
    let e:i64=0;
    while(e<8){
        let t:f64=2.0+17.0*h01(3140,e);
        let f0c:f64=900.0+900.0*h01(3141,e);
        let dur:f64=0.8+0.7*h01(3142,e);
        let g:i64=d_voice(sc,0,t,dur,f0c,3143+e,0.06,0.03,1,0.30);
        // reshape this gesture's f0 keys into a rising contour
        // with a deliberate mid-rise stutter
        let kk:i64=0;
        while(kk<8){
            let kf:f64=(kk as f64)/7.0;
            let rise:f64=1.0+kf*(1.6+1.2*h01(3144,e));
            rise=rise*(1.0-0.22*sstep((kf-0.42)/0.16)); // the stutter
            dput(sc,g,4+kk,(f0c*rise*256.0) as i64);
            kk=kk+1;
        }
        e=e+1;
    }
    // 6. wind on the mic: raw hash noise under slow deliberate
    //    swells only - no filter, no resonator, no bed. The swell
    //    shapes are the deliberation; the noise is opinionless.
    d_breath(sc,0.5,8.0,0.05,3150);
    d_breath(sc,9.0,7.0,0.06,3151);
    d_breath(sc,16.5,4.0,0.04,3152);
}

// ---- score_ocean: an alien ocean's surf at dawn, under a sky ----
// ---- that hums. Committed description: the sea is VISCOUS -   ----
// ---- breakers rise slowly, crest with multiple ragged sub-    ----
// ---- crests, fall heavy. The sky hum is a low presence that   ----
// ---- WANDERS (never a drone): 40-60Hz, drifting +-15% over    ----
// ---- tens of seconds, harmonic emphasis crawling. At dawn the ----
// ---- light lifts: high glass-chime impacts (inharmonic, drawn ----
// ---- ratios) sparse and irregular, like ice singing far away. ----
// ---- Nothing here is an Earth surf recording with a filter.   ----
fn score_ocean(sc:[]u8)void{
    // sky hum: three long voiced gestures, wandering, overlapping.
    // reshape f0 keys into slow deliberate wander (not periodic):
    // ±15% drift over tens of seconds - the wander IS the deliberation.
    let h1:i64=d_voice(sc,2,0.0,16.0,44.0,3200,0.12,0.08,0,0.30);
    let h2:i64=d_voice(sc,2,14.0,16.0,52.0,3201,0.12,0.08,0,0.28);
    let hh:i64=0;
    while(hh<2){
        let g:i64=h1;
        let f0c:f64=44.0;
        if(hh==1){g=h2;f0c=52.0;}
        let kk:i64=0;
        while(kk<8){
            let kf:f64=(kk as f64)/7.0;
            // slow wander: rise then fall, ±15%, never periodic
            let w:f64=1.0+0.15*sstep(kf/0.45)-0.15*sstep((kf-0.45)/0.55);
            w=w*(1.0+0.03*(h01(3202+hh,kk)-0.5)*2.0); // deliberate unevenness
            dput(sc,g,4+kk,(f0c*w*256.0) as i64);
            kk=kk+1;
        }
        hh=hh+1;
    }
    // breakers: big drawn impacts, period 7-11s, each different
    let b:i64=0;
    let t:f64=2.0;
    while(t<27.0){
        let tab:i64=3+(b & 1); // alternate the two drawn breakers
        d_impact(sc,tab,t,0.5+0.2*h01(3210,b),0.9+0.2*h01(3211,b));
        t=t+7.0+4.0*h01(3212,b);
        b=b+1;
    }
    // glass singing far away: voiced gestures with DELIBERATED
    // inharmonic ratios (not integer harmonics) - the alien color
    let s:i64=0;
    while(s<6){
        let tt:f64=6.0+20.0*h01(3230,s);
        let g:i64=d_voice(sc,0,tt,1.6,620.0*(0.8+0.5*h01(3231,s)),3232+s,0.05,0.02,0,0.10);
        // inharmonic ratios: 1, 1.71, 2.63, 3.92, 5.1, 6.4, ...
        let h:i64=0;
        while(h<10){
            let r:f64=1.0;
            if(h==1){r=1.71;}
            if(h==2){r=2.63;}
            if(h==3){r=3.92;}
            if(h==4){r=5.13;}
            if(h==5){r=6.44;}
            if(h==6){r=7.9;}
            if(h==7){r=9.2;}
            if(h==8){r=10.7;}
            if(h==9){r=12.1;}
            dput(sc,g,53+h,(r*65536.0) as i64);
            h=h+1;
        }
        s=s+1;
    }
}

// ---- score_monster: the monster objection, from (d)'s side ----
// Committed description (see MONSTER.md): the chef who understands
// flavor vs the one who owns every spice. The monster: a cavernous
// throat, f0 60-90Hz, INHARMONIC partials (a throat that big is not
// a pipe - ratios 1, 1.62, 2.71, 3.8, 5.2...), massive jitter (12%),
// ragged breathy roar gestures with deliberate sub-crests, slow
// subsonic swells underneath. Dreamed from gestural knowledge of
// largeness, roughness, breath - never heard, only understood.
fn score_monster(sc:[]u8)void{
    // subsonic presence: huge slow swells
    d_voice(sc,2,0.5,10.0,38.0,3300,0.14,0.20,0,0.4);
    d_voice(sc,2,10.5,9.5,33.0,3301,0.14,0.20,0,0.4);
    // the roar: 5 gestures, each deliberately different in contour
    let r:i64=0;
    while(r<5){
        let t:f64=2.0+3.6*(r as f64)+0.5*h01(3310,r);
        let g:i64=d_voice(sc,2,t,2.6+0.8*h01(3311,r),68.0*(0.85+0.3*h01(3312,r)),3313+r,0.12,0.30,0,0.55);
        let h:i64=0;
        while(h<10){
            let rr:f64=1.0;
            if(h==1){rr=1.62;}
            if(h==2){rr=2.71;}
            if(h==3){rr=3.83;}
            if(h==4){rr=5.21;}
            if(h==5){rr=6.55;}
            if(h==6){rr=8.02;}
            if(h==7){rr=9.4;}
            if(h==8){rr=10.9;}
            if(h==9){rr=12.3;}
            dput(sc,g,53+h,(rr*65536.0) as i64);
            h=h+1;
        }
        // ragged sub-crests in the envelope: the roar catches
        let kk:i64=0;
        while(kk<8){
            let kf:f64=(kk as f64)/7.0;
            let e:f64=sstep(kf/0.15)*(1.0-0.5*kf);
            e=e*(0.75+0.5*h01(3314+r,kk)); // deliberate raggedness
            if(kk==7){e=0.0;}
            dput(sc,g,42+kk,(e*0.55*65536.0) as i64);
            kk=kk+1;
        }
        r=r+1;
    }
    // breath between roars: cavernous exhales
    d_breath(sc,5.2,2.0,0.25,3320);
    d_breath(sc,12.4,2.4,0.28,3321);
    d_breath(sc,18.0,2.0,0.22,3322);
}

// ============================================================
// SECTION E: EXPANSION — opinionless arithmetic ONLY.
// Every function below is quoted in full in EXPANSION_AUDIT.md
// with each operation classified. The allowed operations:
//   - linear interpolation of deliberated keyframe tables
//   - stateless sine lookup (no time of its own)
//   - add, multiply, scalar ops
//   - deterministic hash noise (flat, memoryless)
// What is NOT here: oscillators, resonators, filters, envelopes,
// periodic generators, LFOs. All gains, pitches, resonances,
// timings come from the score (Section D). Expansion adds none.
// ============================================================
fn e_lerp(a:f64,b:f64,t:f64)f64{
    return a+(b-a)*t;
}
// 8 keyframes, evenly spaced over the gesture, Q16 values -> f64
fn e_keys8(sc:[]u8,g:i64,slot:i64,t:f64)f64{
    let pos:f64=t*7.0;
    let i0:i64=(pos as i64);
    if(i0<0){i0=0;}
    if(i0>6){i0=6;}
    let fr:f64=pos-(i0 as f64);
    let v0:i64=dget(sc,g,slot+i0);
    let v1:i64=dget(sc,g,slot+i0+1);
    return ((v0 as f64)+((v1-v0) as f64)*fr)*INV16;
}
// f0 keyframes: Q8 Hz -> Hz
fn e_f0keys(sc:[]u8,g:i64,t:f64)f64{
    let pos:f64=t*7.0;
    let i0:i64=(pos as i64);
    if(i0<0){i0=0;}
    if(i0>6){i0=6;}
    let fr:f64=pos-(i0 as f64);
    let v0:i64=dget(sc,g,4+i0);
    let v1:i64=dget(sc,g,4+i0+1);
    return ((v0 as f64)+((v1-v0) as f64)*fr)*INV8;
}
// harmonic keys: 3 keyframes per harmonic, Q16 -> f64
fn e_hkeys(sc:[]u8,g:i64,h:i64,t:f64)f64{
    let pos:f64=t*2.0;
    let i0:i64=(pos as i64);
    if(i0<0){i0=0;}
    if(i0>1){i0=1;}
    let fr:f64=pos-(i0 as f64);
    let v0:i64=dget(sc,g,12+h*3+i0);
    let v1:i64=dget(sc,g,12+h*3+i0+1);
    return ((v0 as f64)+((v1-v0) as f64)*fr)*INV16;
}
// 4 keyframes, Q16 -> f64
fn e_keys4(sc:[]u8,g:i64,slot:i64,t:f64)f64{
    let pos:f64=t*3.0;
    let i0:i64=(pos as i64);
    if(i0<0){i0=0;}
    if(i0>2){i0=2;}
    let fr:f64=pos-(i0 as f64);
    let v0:i64=dget(sc,g,slot+i0);
    let v1:i64=dget(sc,g,slot+i0+1);
    return ((v0 as f64)+((v1-v0) as f64)*fr)*INV16;
}
// x_pulse: render one voiced gesture. The harmonic stack IS the
// deliberated waveform in Fourier form; expansion only sums it.
// Period jitter: amount deliberated (slot 50); per-cycle values
// from the opinionless hash. Phase has no opinion: it advances
// only by the deliberated f0 trajectory. Breathiness comes from
// the deliberated grain table (gr), not raw noise.
fn x_pulse(sc:[]u8,g:i64,m:[]u8,lut:[]u8,gr:[]u8,ns:i64)void{
    let s0:i64=dget(sc,g,1);
    let dur:i64=dget(sc,g,2);
    let s1:i64=s0+dur;
    if(s1<=s0){return;}
    if(s0<0){s0=0;}
    if(s1>ns){s1=ns;}
    if(s0>=ns){return;}
    let jit:f64=(dget(sc,g,50) as f64)*INV16;
    let seed:i64=dget(sc,g,51);
    let bg:f64=(dget(sc,g,52) as f64)*INV16;
    let bs:i64=seed+5;
    let phase:f64=h01(seed,999);
    let tot:f64=0.0;
    // per-partial phase scratch (Q30): each partial integrates its
    // OWN phase from the deliberated f0 trajectory and wraps
    // independently. For integer ratios this renders the same sound
    // as a shared phase (partials stay locked); for INHARMONIC
    // ratios it is the only correct rendering - a shared phase
    // gives each inharmonic partial a fractional cycle per
    // fundamental period, i.e. a positive DC bias of
    // hk*(1-cos(2*pi*r))/(2*pi*r) that is NOT in the deliberation
    // (measured +0.021 DC on the monster roar before this fix).
    // The integrators have no opinion: every frequency, weight and
    // trajectory is deliberated; this is addition and wrap only.
    let pp:*u8=_zag_malloc(80) as *u8;
    let pph:[]u8=pp[0..80];
    let hz:i64=0;
    while(hz<10){
        put32(pph,hz*4,0);
        hz=hz+1;
    }
    let durf:f64=(dur as f64);
    let s:i64=s0;
    while(s<s1){
        let t:f64=((s-s0) as f64)/durf;
        let f0:f64=e_f0keys(sc,g,t);
        let cyc:i64=(tot as i64);
        let jv:f64=1.0+jit*(h01(seed,7000+cyc)-0.5)*2.0;
        let inc:f64=f0*jv/44100.0;
        phase=phase+inc;
        tot=tot+inc;
        if(phase>=1.0){phase=phase-1.0;}
        let env:f64=e_keys8(sc,g,42,t);
        let acc:f64=0.0;
        let h:i64=0;
        while(h<10){
            let hk:f64=e_hkeys(sc,g,h,t);
            let ratio:f64=(dget(sc,g,53+h) as f64)*INV16;
            // ratio is the ABSOLUTE partial ratio (deliberated):
            // integer for voices, inharmonic for alien throats.
            // Expansion multiplies, never invents partials.
            // Per-partial phase: advance by inc*ratio (in Q30),
            // wrap independently. Bound: f0<3000, ratio<13 ->
            // inc*ratio<0.9, so one wrap test suffices.
            let pinc:i64=((inc*ratio*1073741824.0) as i64);
            let pq:i64=get32s(pph,h*4)+pinc;
            if(pq>=1073741824){pq=pq-1073741824;}
            put32(pph,h*4,pq);
            let ph:f64=(pq as f64)*INV30;
            acc=acc+hk*sin01(lut,ph);
            h=h+1;
        }
        let gidx:i64=(bs+s-s0) & 16383;
        let gv:f64=(get32s(gr,gidx*4) as f64)*INV30;
        acc=acc+bg*gv*(0.25+0.75*env);
        mix_add(m,s,acc*env);
        s=s+1;
    }
    _zag_free(_zag_slice_ptr(pph));
}
// x_impact: render one drawn-table impact. The table is the
// deliberated waveform; expansion only looks it up (linear interp),
// scales by deliberated rate/gain/envelope.
fn x_impact(sc:[]u8,g:i64,m:[]u8,tabs:[]u8,ns:i64)void{
    let s0:i64=dget(sc,g,1);
    let dur:i64=dget(sc,g,2);
    let s1:i64=s0+dur;
    if(s1<=s0){return;}
    if(s0<0){s0=0;}
    if(s1>ns){s1=ns;}
    if(s0>=ns){return;}
    let tid:i64=dget(sc,g,3);
    // table offsets are bookkeeping, not sound:
    // [footL 1024][footR 1024][big 2048][breakerA 132300][breakerB 132300]
    let tlen:i64=1024;
    let toff:i64=0;
    if(tid==1){toff=1024;}
    if(tid==2){toff=2048;tlen=2048;}
    if(tid==3){toff=4096;tlen=132300;}
    if(tid==4){toff=4096+132300;tlen=132300;}
    let gain:f64=(dget(sc,g,4) as f64)*INV16;
    let rate:f64=(dget(sc,g,5) as f64)*INV16;
    let durf:f64=(dur as f64);
    let s:i64=s0;
    while(s<s1){
        let t:f64=((s-s0) as f64)/durf;
        let pos:f64=((s-s0) as f64)*rate;
        let idx:i64=(pos as i64);
        if(idx<0){idx=0;}
        if(idx>tlen-2){idx=tlen-2;}
        let fr:f64=pos-(idx as f64);
        let v0:i64=get32s(tabs,(toff+idx)*4);
        let v1:i64=get32s(tabs,(toff+idx+1)*4);
        let v:f64=((v0 as f64)+((v1-v0) as f64)*fr)*INV30;
        let env:f64=e_keys4(sc,g,6,t);
        mix_add(m,s,v*gain*env);
        s=s+1;
    }
}
// x_breath: deliberated grain under a deliberated envelope.
// No filter (a filter would be an opinion); the grain's spectrum
// and the envelope shape are the entire deliberation here.
fn x_breath(sc:[]u8,g:i64,m:[]u8,gr:[]u8,ns:i64)void{
    let s0:i64=dget(sc,g,1);
    let dur:i64=dget(sc,g,2);
    let s1:i64=s0+dur;
    if(s1<=s0){return;}
    if(s0<0){s0=0;}
    if(s1>ns){s1=ns;}
    if(s0>=ns){return;}
    let gain:f64=(dget(sc,g,4) as f64)*INV16;
    let goff:i64=dget(sc,g,10);
    let durf:f64=(dur as f64);
    let s:i64=s0;
    while(s<s1){
        let t:f64=((s-s0) as f64)/durf;
        let env:f64=e_keys4(sc,g,6,t);
        let gidx:i64=(goff+s-s0) & 16383;
        let gv:f64=(get32s(gr,gidx*4) as f64)*INV30;
        mix_add(m,s,gain*env*gv);
        s=s+1;
    }
}
// x_render: walk the score; dispatch by gesture type.
fn x_render(sc:[]u8,m:[]u8,lut:[]u8,tabs:[]u8,gr:[]u8,ns:i64)void{
    let n:i64=dget(sc,0,63);
    let g:i64=1;
    while(g<=n){
        let ty:i64=dget(sc,g,0);
        if(ty==1){x_pulse(sc,g,m,lut,gr,ns);}
        if(ty==2){x_impact(sc,g,m,tabs,ns);}
        if(ty==3){x_breath(sc,g,m,gr,ns);}
        g=g+1;
    }
}

// ---------- WAV writer: peak normalize, soft clip, fades ----------
fn write_wav(path:[]u8,m:[]u8,ns:i64)i32{
    let peak:i64=0;
    let s:i64=0;
    while(s<ns){
        let v:i64=get64(m,s*8);
        let a:i64=v;
        if(a<0){a=-a;}
        if(a>peak){peak=a;}
        s=s+1;
    }
    if(peak<1000){return -1;}
    let norm:f64=0.89*16777216.0/(peak as f64);
    let p:*u8=_zag_malloc(44+ns*2) as *u8;
    if(p==null as *u8){return -2;}
    let out:[]u8=p[0..(44+ns*2)];
    let i:i64=0;
    while(i<44+ns*2){out[i]=0;i=i+1;}
    out[0]=82;out[1]=73;out[2]=70;out[3]=70;
    put32(out,4,36+ns*2);
    out[8]=87;out[9]=65;out[10]=86;out[11]=69;
    out[12]=102;out[13]=109;out[14]=116;out[15]=32;
    put32(out,16,16);
    put16(out,20,1);
    put16(out,22,1);
    put32(out,24,44100);
    put32(out,28,88200);
    put16(out,32,2);
    put16(out,34,16);
    out[36]=100;out[37]=97;out[38]=116;out[39]=97;
    put32(out,40,ns*2);
    s=0;
    while(s<ns){
        let v:i64=get64(m,s*8);
        let x:f64=((v as f64)/16777216.0)*norm;
        if(s<1323){x=x*((s as f64)/1323.0);}
        let rem:i64=ns-s;
        if(rem<35280){x=x*sstep((rem as f64)/35280.0);}
        let ax:f64=x;
        if(ax<0.0){ax=-ax;}
        x=x/(1.0+0.35*ax);
        put16(out,44+s*2,(x*32767.0) as i64);
        s=s+1;
    }
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){return -3;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),577,438,0,0,0);
    if(fd<0){return -4;}
    let wr:i64=w_all(fd,out);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    _zag_free(_zag_slice_ptr(out));
    if(wr<0){return -5;}
    return 0;
}

fn main()i32{
    let a1:[]u8=_zag_arg(1);
    let subj:i32=1;
    if(_zag_strcmp(a1,"kethra")==1){subj=2;}
    if(_zag_strcmp(a1,"ocean")==1){subj=3;}
    if(_zag_strcmp(a1,"monster")==1){subj=4;}
    let a2:[]u8=_zag_arg(2);
    let outp:[]u8="d_alpha_kids.wav";
    if(subj==2){outp="d_alpha_kethra.wav";}
    if(subj==3){outp="d_alpha_ocean.wav";}
    if(subj==4){outp="d_alpha_monster.wav";}
    if(a2.len>0){outp=a2;}
    let ns:i64=1323000; // 30s
    if(subj==2){ns=926100;} // 21s, matches the d_aud3 brief
    if(subj==4){ns=926100;}
    let lut:[]u8=lut_build();
    let m:[]u8=mix_new(ns);
    let sc:[]u8=sc_new();
    // drawn tables: deliberated waveforms (Section D)
    let f0:[]u8=draw_foot();
    let f1:[]u8=draw_foot();
    let f2:[]u8=draw_thud_big();
    let b0:[]u8=draw_breaker(4100);
    let b1:[]u8=draw_breaker(4200);
    let gr:[]u8=draw_breath_grain();
    // pack tables into one arena:
    // [footL 1024][footR 1024][big 2048][breakerA 132300][breakerB 132300][grain 16384]
    let tbn:i64=1024+1024+2048+132300+132300+16384;
    let tp:*u8=_zag_malloc(tbn*4) as *u8;
    let tabs:[]u8=tp[0..(tbn*4)];
    let i:i64=0;
    while(i<1024){put32(tabs,i*4,get32s(f0,i*4));i=i+1;}
    i=0;
    while(i<1024){put32(tabs,(1024+i)*4,get32s(f1,i*4));i=i+1;}
    i=0;
    while(i<2048){put32(tabs,(2048+i)*4,get32s(f2,i*4));i=i+1;}
    i=0;
    while(i<132300){put32(tabs,(4096+i)*4,get32s(b0,i*4));i=i+1;}
    i=0;
    while(i<132300){put32(tabs,(4096+132300+i)*4,get32s(b1,i*4));i=i+1;}
    i=0;
    while(i<16384){put32(tabs,(4096+264600+i)*4,get32s(gr,i*4));i=i+1;}
    let grs:[]u8=tabs[(4096+264600)*4..(4096+264600+16384)*4];
    if(subj==1){score_kids(sc);}
    if(subj==2){score_kethra(sc);}
    if(subj==3){score_ocean(sc);}
    if(subj==4){score_monster(sc);}
    x_render(sc,m,lut,tabs,grs,ns);
    let rc:i32=write_wav(outp,m,ns);
    _zag_free(_zag_slice_ptr(lut));
    _zag_free(_zag_slice_ptr(m));
    _zag_free(_zag_slice_ptr(sc));
    _zag_free(_zag_slice_ptr(tabs));
    _zag_free(_zag_slice_ptr(f0));
    _zag_free(_zag_slice_ptr(f1));
    _zag_free(_zag_slice_ptr(f2));
    _zag_free(_zag_slice_ptr(b0));
    _zag_free(_zag_slice_ptr(b1));
    _zag_free(_zag_slice_ptr(gr));
    return rc;
}

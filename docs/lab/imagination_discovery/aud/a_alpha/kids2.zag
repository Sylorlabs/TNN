// KIDS2.ZAG — A-α benchmark with SCALAR waveguide (stable, like probe19).
// Physical scene simulation. See SCENE.md.

@import("aphys.zag")

// ---- valve voice (burst mode, scalar 14-sec waveguide) ----
fn voice_bout(m:[]u8, s0:i64, nb:i64, dur_s:f64, gap_s:f64, psg0:f64,
              rlips:f64, seed:i64)i64{
    let msc:f64 = (127.0 / 350.0) * (127.0 / 350.0);
    let mm:f64 = 8.0e-5 * msc;
    let kk:f64 = mm * 4836100.0;
    let rr:f64 = 0.004;
    let kcc:f64 = 8000.0; let rcc:f64 = 0.004;
    let lg:f64 = 0.008;
    let a_push:f64 = 1.2e-5;
    let a_suc:f64 = 2.5e-5;
    let ag0:f64 = 2.0 * lg * 0.00002;
    let ag_s:f64 = 2.0 * lg * 0.00005;
    let area:f64 = 3.0e-4;
    let z0:f64 = RHO_AIR * C_AIR / area;
    // scalar waveguide (14 sections)
    let r0:f64=0.0;let r1w:f64=0.0;let r2w:f64=0.0;let r3w:f64=0.0;let r4w:f64=0.0;
    let r5w:f64=0.0;let r6w:f64=0.0;let r7w:f64=0.0;let r8w:f64=0.0;let r9w:f64=0.0;
    let r10w:f64=0.0;let r11w:f64=0.0;let r12w:f64=0.0;let r13w:f64=0.0;
    let l0:f64=0.0;let l1w:f64=0.0;let l2w:f64=0.0;let l3w:f64=0.0;let l4w:f64=0.0;
    let l5w:f64=0.0;let l6w:f64=0.0;let l7w:f64=0.0;let l8w:f64=0.0;let l9w:f64=0.0;
    let l10w:f64=0.0;let l11w:f64=0.0;let l12w:f64=0.0;let l13w:f64=0.0;
    let x:f64=0.000008; let v:f64=0.0;
    let ppe:f64=0.0;
    let prev_out:f64=0.0;
    let per:f64 = dur_s + gap_s;
    let total:i64 = ((nb as f64) * per * 44100.0) as i64;
    let n:i64=0;
    while(n < total){
        let t:f64 = (n as f64) / 44100.0;
        let cyc:f64 = t / per;
        let ci:i64 = cyc as i64;
        let cfr:f64 = cyc - ((ci) as f64);
        let gate:f64 = 0.0;
        if(ci < nb && cfr * per < dur_s){
            let tt:f64 = cfr * per;
            if(tt < 0.012){ let g:f64=tt/0.012; gate=g*g*(3.0-2.0*g); }
            else if(tt > dur_s - 0.015){ let d2:f64=(dur_s-tt)/0.015; gate=d2*d2*(3.0-2.0*d2); }
            else { gate = 1.0; }
        }
        let psg:f64 = psg0 * gate;
        let ag:f64 = ag0 + 2.0 * lg * x;
        let ag2s:f64 = ag * ag + ag_s * ag_s;
        let ug:f64 = 0.0;
        if(ag > 0.0 && psg > ppe){ ug = ag * fsqrt(2.0 * (psg - ppe) / RHO_AIR); }
        let p_suc:f64 = 0.5 * RHO_AIR * ug * ug / ag2s;
        let f:f64 = psg * a_push - p_suc * a_suc;
        if(x < -0.00002){ f = f - kcc * (x + 0.00002) - rcc * v; }
        let acc:f64 = (f - kk * x - rr * v) / mm;
        v = v + acc * DT;
        x = x + v * DT;
        let agz:f64 = ag;
        if(agz < ag_s){ agz = ag_s; }
        let zg:f64 = RHO_AIR * C_AIR / agz;
        let rg:f64 = (zg - z0) / (zg + z0);
        let nr0:f64 = rg * l0 + (z0 * ug * 0.5) * (1.0 + rg);
        let nl13:f64 = rlips * r13w;
        let out:f64 = (1.0 + rlips) * r13w;
        let o0:f64=r0;let o1:f64=r1w;let o2:f64=r2w;let o3:f64=r3w;let o4:f64=r4w;
        let o5:f64=r5w;let o6:f64=r6w;let o7:f64=r7w;let o8:f64=r8w;let o9:f64=r9w;
        let o10:f64=r10w;let o11:f64=r11w;let o12:f64=r12w;
        let q1:f64=l1w;let q2:f64=l2w;let q3:f64=l3w;let q4:f64=l4w;let q5:f64=l5w;
        let q6:f64=l6w;let q7:f64=l7w;let q8:f64=l8w;let q9:f64=l9w;let q10:f64=l10w;
        let q11:f64=l11w;let q12:f64=l12w;let q13:f64=l13w;
        r1w=o0;r2w=o1;r3w=o2;r4w=o3;r5w=o4;r6w=o5;r7w=o6;r8w=o7;r9w=o8;
        r10w=o9;r11w=o10;r12w=o11;r13w=o12;
        l0=q1;l1w=q2;l2w=q3;l3w=q4;l4w=q5;l5w=q6;l6w=q7;l7w=q8;l8w=q9;
        l9w=q10;l10w=q11;l11w=q12;l12w=q13;l13w=nl13;
        r0=nr0; ppe=r0+l0;
        let rad:f64 = (out - prev_out) * 6.0;
        prev_out = out;
        mix_add(m, s0+n, rad * 0.4);
        n=n+1;
    }
    return s0 + total;
}

// ---- footstep ----
fn footstep(m:[]u8, s0:i64, surf:i64, strength:f64, seed:i64)void{
    let mf:f64 = 2.0;
    let k:f64 = 30000.0; let r:f64 = 8.0;
    if(surf==1){ k=60000.0; r=5.0; }
    if(surf==2){ k=200000.0; r=2.0; }
    let v:f64 = -1.2 * strength;
    let x:f64 = 0.0;
    let n:i64=0;
    while(n < 4000){
        let f:f64 = 0.0;
        if(x < 0.0){ f = -k * x - r * v; }
        let a:f64 = f / mf - 9.8;
        v = v + a * DT;
        x = x + v * DT;
        if(x > 0.0 && v > 0.0){ v = 0.0; }
        let rad:f64 = v * 0.02 * strength;
        if(surf==2){
            let t:f64 = (n as f64) / 44100.0;
            let ph:f64 = t * 720.0;
            let fr2:f64 = ph - (((ph as i64)) as f64);
            rad = rad + 0.15 * strength * (0.5 - fr2) * fexp(-t * 25.0);
        }
        if(surf==1 && n > 50 && n < 800){
            let g:i64 = (h01(seed, n / 37) * 10.0) as i64;
            if(g==0){
                let t:f64 = (n as f64) / 44100.0;
                rad = rad + 0.08 * strength * (h01(seed+7, n)-0.5) * fexp(-t*60.0);
            }
        }
        mix_add(m, s0+n, rad);
        n=n+1;
        if(n>200 && x>0.0 && v==0.0){ n=4000; }
    }
}

fn main()i32{
    let ns:i64 = 1323000;
    let m:[]u8 = mix_new(ns);
    // Bout 1: Child B, 3.6-7.0s (8 bursts)
    voice_bout(m, 158760, 8, 0.19, 0.06, 1800.0, -0.6, 101);
    // Child A giggle overlaps 4.0-5.2s (5 bursts, faster)
    voice_bout(m, 176400, 5, 0.15, 0.05, 1800.0, -0.65, 202);
    // Bout 2 (tumble): Child A 12.5-19s (14 bursts)
    voice_bout(m, 551250, 14, 0.20, 0.07, 1700.0, -0.6, 303);
    // Child B joins 14.0-18.5s (10 bursts)
    voice_bout(m, 617400, 10, 0.19, 0.06, 1700.0, -0.62, 404);
    // Child C high laugh 16.0-17.5s (6 bursts)
    voice_bout(m, 705600, 6, 0.17, 0.06, 1900.0, -0.6, 505);
    // Bout 3 (breathless) 20-23s
    voice_bout(m, 882000, 5, 0.16, 0.08, 1700.0, -0.65, 606);
    voice_bout(m, 892000, 5, 0.16, 0.08, 1700.0, -0.65, 707);
    voice_bout(m, 902000, 4, 0.15, 0.08, 1700.0, -0.6, 808);
    // final giggle 27.2s (2 bursts)
    voice_bout(m, 1199520, 2, 0.16, 0.08, 1700.0, -0.65, 909);

    // Footsteps
    let fs:i64 = 0;
    let t:f64 = 0.2;
    while(t < 3.5){
        let s0:i64 = (t * 44100.0) as i64;
        footstep(m, s0, 1, 0.7, 1001+fs);
        footstep(m, s0+2205, 0, 0.85, 2001+fs);
        t = t + 0.42;
        fs = fs + 1;
    }
    t = 7.6;
    while(t < 10.5){
        let s0:i64 = (t * 44100.0) as i64;
        footstep(m, s0, 1, 0.75, 3001+fs);
        footstep(m, s0+1985, 1, 0.8, 4001+fs);
        footstep(m, s0+992, 0, 0.6, 5001+fs);
        t = t + 0.40;
        fs = fs + 1;
    }
    t = 9.6;
    while(t < 10.4){
        let s0:i64 = (t * 44100.0) as i64;
        footstep(m, s0, 2, 0.5, 6001+fs);
        t = t + 0.28;
        fs = fs + 1;
    }
    footstep(m, 859950, 1, 1.2, 7001);
    t = 23.5;
    while(t < 29.5){
        let s0:i64 = (t * 44100.0) as i64;
        footstep(m, s0, 1, 0.5, 8001+fs);
        t = t + 0.62;
        fs = fs + 1;
    }

    write_wav("kids_a_alpha.wav", m, ns, 0.85);
    return 0;
}

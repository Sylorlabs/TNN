// ============================================================
// IMAGINATION DISCOVERY - AUDIO SYNTHESIS CREW
// D-AUD-1 "unheard instrument" / D-AUD-2 "impossible phenomenon"
// Pure-Zag full-spectrum synthesis. Zero forced instruments:
// inharmonic partial sets with independently evolving amplitudes,
// filtered noise beds, spectral morphing, transient layers, moving
// resonances. Parameterized per-DISCOVERY (score_aud1/score_aud2).
// Deterministic: all variation from fixed-seed integer hashes.
// ============================================================

const SR:i64 = 44100;
const DUR_S:i64 = 21;
const NSAMP:i64 = 926100; // 44100*21
const PH1:i64 = 281474976710656; // 2^48 phase cycle
const INV48:f64 = 1.0/281474976710656.0; // 1/2^48
const INV30:f64 = 1.0/1073741824.0; // 1/2^30
const INV32:f64 = 1.0/4294967296.0; // 1/2^32
const NOISE_Q:f64 = 1.0/4503599627370496.0; // 1/2^52

// ---------- byte helpers (sign-extending reads) ----------
fn put32(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
}
fn get32s(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | (((b[i+3] as i64)<<56)>>32;
}
fn put16(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
}
fn put64(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
    b[i+4]=((v>>32) & 255) as u8;
    b[i+5]=((v>>40) & 255) as u8;
    b[i+6]=((v>>48) & 255) as u8;
    b[i+7]=((v>>56) & 255) as u8;
}
fn get64(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24) | ((b[i+4] as i64)<<32) | ((b[i+5] as i64)<<40) | ((b[i+6] as i64)<<48) | ((b[i+7] as i64)<<56);
}
fn cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4095){return "";}
    let p:*u8=_zag_malloc((s.len+1) as i64) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..(s.len+1)];
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn w_all(fd:i64,b:[]u8)i64{
    let at:i64=0;
    let calls:i32=0;
    let blen:i64=b.len as i64;
    while(at<blen && calls<8192){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+at,blen-at,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<=0){return -7407;}
        at=at+n;
    }
    if(at!=blen){return -7407;}
    return at;
}

// ---------- deterministic hash noise (no RNG anywhere) ----------
// 32-bit fmix32 finalizer over a bijective linear seed mix.
// All intermediate products are masked to 32 bits; i64 multiply
// wraps (probed), so masking recovers exact low-32-bit semantics.
fn h32(s:i64,st:i64)i64{
    let z:i64=(s*2654435761+st*40503+1) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    z=(z*2246822519) & 4294967295;
    z=(z ^ (z>>13)) & 4294967295;
    z=(z*3266489917) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    return z;
}
// white noise sample in [-1,1), stream selects independent layer
fn wnoise(s:i64,st:i64)f64{
    return ((h32(s,st) as f64)/4294967296.0)*2.0-1.0;
}
// uniform [0,1)
fn h01(seed:i64,k:i64)f64{
    return (h32(seed,k) as f64)/4294967296.0;
}

// ---------- sine LUT (1024 entries + guard, i32 Q30) ----------
fn tsin_small(x:f64)f64{
    let x2:f64=x*x;
    let x3:f64=x2*x;
    return x-x3/6.0+x3*x2/120.0-x3*x2*x2/5040.0;
}
fn tcos_small(x:f64)f64{
    let x2:f64=x*x;
    return 1.0-x2/2.0+x2*x2/24.0-x2*x2*x2/720.0;
}
fn lut_build()[]u8{
    let p:*u8=_zag_malloc(4100) as *u8;
    let lut:[]u8=p[0..4100];
    let d:f64=6.283185307179586/1024.0;
    let c:f64=tcos_small(d);
    let s:f64=tsin_small(d);
    let sn:f64=0.0;
    let cn:f64=1.0;
    let i:i64=0;
    while(i<=1024){
        put32(lut,i*4,(sn*1073741824.0) as i64);
        let nsn:f64=sn*c+cn*s;
        let ncn:f64=cn*c-sn*s;
        sn=nsn;
        cn=ncn;
        if((i & 127)==127){
            let nn:f64=sn*sn+cn*cn;
            sn=sn/nn;
            cn=cn/nn;
        }
        i=i+1;
    }
    return lut;
}
// phase in [0,1) -> sin, interpolated
fn sin01(lut:[]u8,ph:f64)f64{
    let x:f64=ph*1024.0;
    let idx:i64=(x as i64);
    if(idx>1023){idx=1023;}
    if(idx<0){idx=0;}
    let fr:f64=x-(idx as f64);
    let l0:i64=get32s(lut,idx*4);
    let l1:i64=get32s(lut,(idx+1)*4);
    return ((l0 as f64)+((l1-l0) as f64)*fr)*INV30;
}
fn cos01(lut:[]u8,ph:f64)f64{
    let q:f64=ph+0.25;
    if(q>=1.0){q=q-1.0;}
    return sin01(lut,q);
}

// ---------- envelopes ----------
fn sstep(x:f64)f64{
    if(x<=0.0){return 0.0;}
    if(x>=1.0){return 1.0;}
    return x*x*(3.0-2.0*x);
}
// struck: fast attack, power-law decay to zero at note end
fn env_struck(t:f64,atk:f64,decp:i32)f64{
    if(t<=0.0){return 0.0;}
    if(t>=1.0){return 0.0;}
    if(t<atk){
        return sstep(t/atk);
    }
    let u:f64=(t-atk)/(1.0-atk);
    let d:f64=1.0-u;
    let e:f64=d*d;
    if(decp>=3){e=e*d;}
    if(decp>=4){e=e*d;}
    return e;
}
// swell: attack then sustain then release
fn env_swell(t:f64,a:f64,b:f64)f64{
    if(t<=0.0){return 0.0;}
    if(t>=1.0){return 0.0;}
    return sstep(t/a)*sstep((1.0-t)/b);
}

// ---------- mix buffer (i64 Q24 samples in []u8 arena, 8 bytes/sample) ----------
fn mix_new()[]u8{
    let p:*u8=_zag_malloc(NSAMP*8) as *u8;
    let m:[]u8=p[0..(NSAMP*8)];
    let i:i64=0;
    while(i<NSAMP*8){m[i]=0;i=i+1;}
    return m;
}
fn mix_add(m:[]u8,s:i64,v:f64)void{
    let cur:i64=get64(m,s*8);
    put64(m,s*8,cur+((v*16777216.0) as i64));
}

// ---------- per-partial state (i64 arenas: phase Q48, inc Q48, atk Q48, lvl Q32) ----------
fn ps_new(np:i32)[]u8{
    let p:*u8=_zag_malloc((np as i64)*32) as *u8;
    let b:[]u8=p[0..((np as i64)*32)];
    let i:i64=0;
    while(i<(np as i64)*32){b[i]=0;i=i+1;}
    return b;
}
fn ps_put(b:[]u8,k:i32,f:i32,v:i64)void{put32(b,((k*4+f) as i64)*4,v);}
fn ps_get(b:[]u8,k:i32,f:i32)i64{return get32s(b,((k*4+f) as i64)*4);}

// struck voice: np inharmonic partials, each with independent attack,
// decay exponent, level, drift. f0 = fundamental, stiff = inharmonicity B
// (f_k = k*f0*sqrt(1+B*k^2)), bright = high-partial emphasis.
fn render_struck(m:[]u8,lut:[]u8,s0:i64,s1:i64,f0:f64,stiff:f64,bright:f64,seed:i64,np:i32,gain:f64,decp:i32,vibd:f64,vibr:f64,swell:i32,swa:f64,swb:f64)void{
    if(s1<=s0){return;}
    if(s0<0){s0=0;}
    if(s1>NSAMP){s1=NSAMP;}
    let ps:[]u8=ps_new(np);
    let k:i32=0;
    let off:i64=0;
    while(k<np){
        let kf:f64=(k+1) as f64;
        // stiff-bar inharmonicity: ratio_k = k*sqrt(1+B*k^2), Newton sqrt
        let g:f64=kf;
        g=0.5*(g+(1.0+stiff*kf*kf)/g);
        g=0.5*(g+(1.0+stiff*kf*kf)/g);
        g=0.5*(g+(1.0+stiff*kf*kf)/g);
        let f:f64=f0*kf*g;
        put64(ps,off,(h01(seed,1000+k)*281474976710656.0) as i64); // phase Q48
        put64(ps,off+8,((f*281474976710656.0/44100.0) as i64)); // inc Q48
        let atk:f64=0.004+0.05*h01(seed,2000+k);
        put64(ps,off+16,(atk*281474976710656.0) as i64); // atk Q48 fraction
        let lvl:f64=(1.0/(1.0+(k as f64)*0.55))*(1.0+bright*(k as f64)*0.12);
        put64(ps,off+24,(lvl*4294967296.0) as i64); // lvl Q32
        off=off+32;
        k=k+1;
    }
    let dur:i64=s1-s0;
    let lph:f64=h01(seed,777);
    let vinc:f64=vibr/44100.0;
    let s:i64=s0;
    while(s<s1){
        let t:f64=((s-s0) as f64)/(dur as f64);
        let vibm:f64=1.0+vibd*sin01(lut,lph);
        lph=lph+vinc;
        if(lph>=1.0){lph=lph-1.0;}
        let acc:f64=0.0;
        k=0;
        off=0;
        while(k<np){
            let drift:f64=(h01(seed,3000+k)-0.5)*0.006;
            let ph:i64=get64(ps,off);
            let inc:i64=get64(ps,off+8);
            let fm:f64=vibm*(1.0+drift*(t-0.5));
            ph=ph+(((inc as f64)*fm) as i64);
            if(ph>=PH1){ph=ph-PH1;}
            put64(ps,off,ph);
            let idx:i64=ph>>38;
            let fr:i64=(ph>>16) & 4194303;
            let l0:i64=get32s(lut,idx*4);
            let l1:i64=get32s(lut,(idx+1)*4);
            let sq:i64=l0+(((l1-l0)*fr)>>22);
            let af:f64=(get64(ps,off+16) as f64)*INV48;
            let e:f64=env_struck(t,af,decp);
            if(swell==1){e=env_swell(t,swa,swb);}
            acc=acc+((sq as f64)*INV30)*e*((get64(ps,off+24) as f64)*INV32);
            off=off+32;
            k=k+1;
        }
        mix_add(m,s,acc*gain);
        s=s+1;
    }
    _zag_free(_zag_slice_ptr(ps));
}

// short bright ping: 1 partial, exponential decay
fn render_ping(m:[]u8,lut:[]u8,s0:i64,f:f64,gain:f64,decms:f64,seed:i64)void{
    let dur:i64=((decms*6.0/1000.0*44100.0) as i64);
    let s1:i64=s0+dur;
    if(s0<0){s0=0;}
    if(s1>NSAMP){s1=NSAMP;}
    if(s1<=s0){return;}
    let ph:f64=h01(seed,55);
    let inc:f64=f/44100.0;
    let dec:f64=1.0-1.0/(decms/1000.0*44100.0);
    let e:f64=1.0;
    let s:i64=s0;
    while(s<s1){
        mix_add(m,s,sin01(lut,ph)*e*gain);
        ph=ph+inc;
        if(ph>=1.0){ph=ph-1.0;}
        e=e*dec;
        s=s+1;
    }
}

// noise burst transient: raw noise * exponential decay (+optional tilt via 1-pole)
fn render_burst(m:[]u8,s0:i64,durms:f64,gain:f64,decms:f64,stream:i64,bright:f64)void{
    let dur:i64=((durms/1000.0*44100.0) as i64);
    let s1:i64=s0+dur;
    if(s0<0){s0=0;}
    if(s1>NSAMP){s1=NSAMP;}
    if(s1<=s0){return;}
    let dec:f64=1.0-1.0/(decms/1000.0*44100.0);
    let e:f64=1.0;
    let lp:f64=0.0;
    let a:f64=bright; // tilt: low a = darker
    let s:i64=s0;
    while(s<s1){
        let n:f64=wnoise(s,stream);
        lp=lp+a*(n-lp);
        mix_add(m,s,(n*(1.0-bright*0.7)+lp*bright*0.7)*e*gain);
        e=e*dec;
        s=s+1;
    }
}

// one-pole lowpassed noise bed with slow LFO swell
fn render_bed_lp(m:[]u8,lut:[]u8,s0:i64,s1:i64,cutoff:f64,gain:f64,stream:i64,lfohz:f64,lfodepth:f64,seed:i64)void{
    if(s1<=s0){return;}
    if(s0<0){s0=0;}
    if(s1>NSAMP){s1=NSAMP;}
    if(s1<=s0){return;}
    if(s0<0){s0=0;}
    if(s1>NSAMP){s1=NSAMP;}
    let a:f64=cutoff*6.283185307179586/44100.0;
    if(a>1.0){a=1.0;}
    if(a<0.0001){a=0.0001;}
    let lp:f64=0.0;
    let lph:f64=h01(seed,31);
    let linc:f64=lfohz/44100.0;
    let s:i64=s0;
    while(s<s1){
        let n:f64=wnoise(s,stream);
        lp=lp+a*(n-lp);
        let sw:f64=1.0-lfodepth+lfodepth*(0.5+0.5*sin01(lut,lph));
        mix_add(m,s,lp*sw*gain);
        lph=lph+linc;
        if(lph>=1.0){lph=lph-1.0;}
        s=s+1;
    }
}
// one-pole highpassed noise bed (air/shimmer) with slow LFO swell
// broadband white-noise bed (no filter): fills spectral valleys,
// raises flatness. Gentle LFO swell keeps it alive, not static.
fn render_bed_white(m:[]u8,lut:[]u8,s0:i64,s1:i64,gain:f64,stream:i64,lfohz:f64,lfodepth:f64,seed:i64)void{
    if(s1<=s0){return;}
    if(s0<0){s0=0;}
    if(s1>NSAMP){s1=NSAMP;}
    let lph:f64=h01(seed,51);
    let linc:f64=lfohz/44100.0;
    let s:i64=s0;
    while(s<s1){
        let n:f64=wnoise(s,stream);
        let sw:f64=1.0-lfodepth+lfodepth*(0.5+0.5*sin01(lut,lph));
        mix_add(m,s,n*sw*gain);
        lph=lph+linc;
        if(lph>=1.0){lph=lph-1.0;}
        s=s+1;
    }
}
fn render_bed_hp(m:[]u8,lut:[]u8,s0:i64,s1:i64,cutoff:f64,gain:f64,stream:i64,lfohz:f64,lfodepth:f64,seed:i64)void{
    if(s1<=s0){return;}
    if(s0<0){s0=0;}
    if(s1>NSAMP){s1=NSAMP;}
    let b:f64=1.0/(1.0+cutoff*6.283185307179586/44100.0);
    let y:f64=0.0;
    let xp:f64=0.0;
    let lph:f64=h01(seed,37);
    let linc:f64=lfohz/44100.0;
    let s:i64=s0;
    while(s<s1){
        let n:f64=wnoise(s,stream);
        y=b*(y+n-xp);
        xp=n;
        let sw:f64=1.0-lfodepth+lfodepth*(0.5+0.5*sin01(lut,lph));
        mix_add(m,s,y*sw*gain);
        lph=lph+linc;
        if(lph>=1.0){lph=lph-1.0;}
        s=s+1;
    }
}
// moving-resonance bed: noise through a 2-pole resonator with
// center frequency sweeping f0->f1 over the span. R<1 stable.
fn render_resbed(m:[]u8,lut:[]u8,s0:i64,s1:i64,f0:f64,f1:f64,rres:f64,gain:f64,stream:i64,seed:i64)void{
    if(s1<=s0){return;}
    if(s0<0){s0=0;}
    if(s1>NSAMP){s1=NSAMP;}
    let y1:f64=0.0;
    let y2:f64=0.0;
    let ymax:f64=0.0;
    let r2:f64=rres*rres;
    let dur:f64=((s1-s0) as f64);
    let s:i64=s0;
    while(s<s1){
        let t:f64=((s-s0) as f64)/dur;
        let fc:f64=f0+(f1-f0)*t;
        let c2:f64=2.0*rres*cos01(lut,fc/44100.0);
        let x:f64=wnoise(s,stream);
        let y:f64=x+c2*y1-r2*y2;
        let ay:f64=y;
        if(ay<0.0){ay=-ay;}
        if(ay>ymax){ymax=ay;}
        y2=y1;
        y1=y;
        mix_add(m,s,y*gain);
        s=s+1;
    }
}
// geyser: swept resonator (upward) with whoosh amplitude envelope
fn render_geyser(m:[]u8,lut:[]u8,t0:f64,dur:f64,f0:f64,f1:f64,gain:f64,stream:i64,seed:i64)void{
    let s0:i64=((t0*44100.0) as i64);
    let s1:i64=s0+((dur*44100.0) as i64);
    if(s1<=s0){return;}
    if(s0<0){s0=0;}
    if(s1>NSAMP){s1=NSAMP;}
    let y1:f64=0.0;
    let y2:f64=0.0;
    let rres:f64=0.986;
    let r2:f64=rres*rres;
    let span:f64=((s1-s0) as f64);
    let s:i64=s0;
    while(s<s1){
        let t:f64=((s-s0) as f64)/span;
        let fc:f64=f0+(f1-f0)*t*t;
        let c2:f64=2.0*rres*cos01(lut,fc/44100.0);
        let x:f64=wnoise(s,stream);
        let y:f64=x+c2*y1-r2*y2;
        y2=y1;
        y1=y;
        let e:f64=env_swell(t,0.22,0.45);
        mix_add(m,s,y*e*gain);
        s=s+1;
    }
}

// ============================================================
// SCORE aud1 — "VESPERA": performance on an instrument that
// never existed. A tidal glass organ: 16 struck notes with
// stiff-bar inharmonicity, per-partial independent envelopes,
// glass-strike transients, breath/air noise beds, sweeping
// formant resonators, sub tide. Golden-walk alien pitch field.
// ============================================================
fn score_aud1_beds(m:[]u8,lut:[]u8)void{
    render_bed_lp(m,lut,0,NSAMP,520.0,0.35,11,0.09,0.65,1101);
    render_bed_hp(m,lut,0,NSAMP,5600.0,0.30,12,0.13,0.5,1102);
    render_bed_white(m,lut,0,NSAMP,0.25,16,0.07,0.6,1106);
    render_resbed(m,lut,0,NSAMP,400.0,3800.0,0.99,0.005,13,1103);
    render_resbed(m,lut,0,NSAMP,700.0,6200.0,0.988,0.004,14,1104);
    render_resbed(m,lut,0,NSAMP,250.0,2400.0,0.992,0.0045,15,1105);
    // sub tide: two slow-beating low partials, full span
    let st0:i64=0;
    render_struck(m,lut,st0,NSAMP,55.0,0.0,0.0,9911,2,0.10,2,0.0,0.0,1,0.06,0.08);
}
fn score_aud1(m:[]u8,lut:[]u8)void{
    score_aud1_beds(m,lut);
    let t:f64=0.4;
    let v:i32=0;
    while(v<16){
        let u1:f64=h01(2101,v);
        let u2:f64=h01(2102,v);
        let u3:f64=h01(2103,v);
        let u4:f64=h01(2104,v);
        let u5:f64=h01(2105,v);
        let u7:f64=h01(2107,v);
        let u8:f64=h01(2108,v);
        let u9:f64=h01(2109,v);
        // golden-walk alien pitch field (no 12TET anywhere)
        let gv:f64=(v as f64)*0.6180339*1.7;
        let gr:f64=gv-((gv as i64) as f64);
        let f0:f64=98.0*(1.0+2.3*gr);
        let stiff:f64=0.002+0.006*u4;
        let bright:f64=u5;
        let dur:f64=1.4+2.0*u2;
        let s0:i64=((t*44100.0) as i64);
        let s1:i64=s0+((dur*44100.0) as i64);
        if(s1>NSAMP-44100){s1=NSAMP-44100;}
        let decp:i32=2+((u7*2.99) as i32);
        let vibd:f64=0.0015*u8;
        let vibr:f64=4.5+3.0*u9;
        render_struck(m,lut,s0,s1,f0,stiff,bright,3100+v,8,0.085,decp,vibd,vibr,0,0.0,0.0);
        // glass strike transient at onset
        render_burst(m,s0,4.0,0.45,2.5,4100+v,0.85);
        render_ping(m,lut,s0,2500.0+2500.0*u5,0.14,60.0,5100+v);
        t=t+0.55+1.5*u1;
        if(t>19.0){v=99;}
        v=v+1;
    }
}

// ============================================================
// SCORE aud2 — "CRYOVOLCANO": impossible natural event.
// Methane-moon cryovolcano: sub-bass rumble, 6 geyser eruptions
// (swept-resonator methane fountains), 26 ice-fracture cracks,
// 3 deep booms, wandering wind, HF shimmer.
// ============================================================
fn score_aud2(m:[]u8,lut:[]u8)void{
    // rumble: detuned sub partials + lowpassed noise, full span
    render_struck(m,lut,0,NSAMP,41.0,0.0,0.0,9921,2,0.06,2,0.0,0.0,1,0.06,0.08);
    render_struck(m,lut,0,NSAMP,41.6,0.0,0.0,9922,2,0.05,2,0.0,0.0,1,0.07,0.09);
    render_bed_lp(m,lut,0,NSAMP,130.0,0.5,21,0.07,0.5,2201);
    render_resbed(m,lut,0,NSAMP,300.0,1100.0,0.965,0.02,22,2202); // wandering wind
    render_bed_hp(m,lut,0,NSAMP,6800.0,0.30,23,0.11,0.45,2203); // shimmer
    render_bed_white(m,lut,0,NSAMP,0.70,24,0.09,0.6,2204);
    let g:i32=0;
    while(g<6){
        let t0:f64=1.5+(g as f64)*3.53+h01(2301,g)*0.5;
        render_geyser(m,lut,t0,2.4,350.0,5200.0,0.015,30+g,2302+g);
        render_ping(m,lut,((t0*44100.0) as i64),70.0,0.3,400.0,2402+g);
        g=g+1;
    }
    let c:i32=0;
    while(c<26){
        let gv:f64=(c as f64)*0.6180339*7.0;
        let t:f64=0.5+(gv-((gv as i64) as f64))*20.0;
        let u1:f64=h01(2501,c);
        let u2:f64=h01(2502,c);
        let u3:f64=h01(2503,c);
        let s0:i64=((t*44100.0) as i64);
        render_burst(m,s0,6.0+30.0*u1,0.5,8.0+20.0*u2,2600+c,0.5+0.5*u3);
        render_ping(m,lut,s0,900.0+3600.0*u3,0.16,80.0+120.0*u2,2700+c);
        c=c+1;
    }
    let b:i32=0;
    while(b<3){
        let t0:f64=4.0;
        if(b==1){t0=11.5;}
        if(b==2){t0=17.5;}
        let f:f64=47.0;
        if(b==1){f=53.0;}
        if(b==2){f=44.0;}
        let s0:i64=((t0*44100.0) as i64);
        let s1:i64=s0+((1.7*44100.0) as i64);
        render_struck(m,lut,s0,s1,f,0.001,0.0,2800+b,2,0.55,2,0.0,0.0,0,0.0,0.0);
        render_burst(m,s0,800.0,0.12,300.0,2900+b,0.15);
        b=b+1;
    }
}

// ---------- WAV writer: peak normalize, soft clip, fades ----------
fn write_wav(path:[]u8,m:[]u8)i32{
    let peak:i64=0;
    let s:i64=0;
    while(s<NSAMP){
        let v:i64=get64(m,s*8);
        let a:i64=v;
        if(a<0){a=-a;}
        if(a>peak){peak=a;}
        s=s+1;
    }
    if(peak<1000){return -1;}
    let norm:f64=0.89*16777216.0/(peak as f64);
    let p:*u8=_zag_malloc(44+NSAMP*2) as *u8;
    if(p==null as *u8){return -2;}
    let out:[]u8=p[0..(44+NSAMP*2)];
    let i:i64=0;
    while(i<44+NSAMP*2){out[i]=0;i=i+1;}
    out[0]=82;out[1]=73;out[2]=70;out[3]=70; // RIFF
    put32(out,4,36+NSAMP*2);
    out[8]=87;out[9]=65;out[10]=86;out[11]=69; // WAVE
    out[12]=102;out[13]=109;out[14]=116;out[15]=32; // fmt
    put32(out,16,16);
    put16(out,20,1);
    put16(out,22,1);
    put32(out,24,44100);
    put32(out,28,88200);
    put16(out,32,2);
    put16(out,34,16);
    out[36]=100;out[37]=97;out[38]=116;out[39]=97; // data
    put32(out,40,NSAMP*2);
    s=0;
    while(s<NSAMP){
        let v:i64=get64(m,s*8);
        let x:f64=((v as f64)/16777216.0)*norm;
        if(s>=100000 && s<100003){
        }
        if(s<1323){x=x*((s as f64)/1323.0);}
        let rem:i64=NSAMP-s;
        if(rem<35280){x=x*sstep((rem as f64)/35280.0);}
        let ax:f64=x;
        if(ax<0.0){ax=-ax;}
        x=x/(1.0+0.35*ax);
        put16(out,44+s*2,(x*32767.0) as i64);
        s=s+1;
    }
    let cs:[]u8=cstr(path);
    if(cs.len==0){return -3;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),577,438,0,0,0);
    if(fd<0){
        return -4;
    }
    let wr:i64=w_all(fd,out);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    _zag_free(_zag_slice_ptr(out));
    if(wr<0){return -5;}
    return 0;
}

fn main()i32{
    let a1:[]u8=_zag_arg(1);
    let subj:i32=1;
    if(_zag_strcmp(a1,"aud2")==1){subj=2;}
    let a2:[]u8=_zag_arg(2);
    let outp:[]u8="d_aud1.wav";
    if(subj==2){outp="d_aud2.wav";}
    if(a2.len>0){outp=a2;}
    let lut:[]u8=lut_build();
    let m:[]u8=mix_new();
    if(subj==1){score_aud1(m,lut);}else{score_aud2(m,lut);}


    let rc:i32=write_wav(outp,m);
    _zag_free(_zag_slice_ptr(lut));
    _zag_free(_zag_slice_ptr(m));
    return rc;
}

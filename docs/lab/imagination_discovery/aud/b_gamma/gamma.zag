// ============================================================
// FORK B-GAMMA: imagination BEYOND experience.
// Event-grain assembler on STUDIED material. No oscillators, no
// resonators, no filtered-noise generators, no chirps, no booms,
// no pitch-shift, no ring-mod, no stationary beds, no synth.zag
// imports. Every audible moment is a real captured grain; the
// invention is in the DELIBERATE grammar (which grains, in what
// order, at what rates, with what cross-class morphs).
// Deterministic: all selection/jitter from h32 hashes. Zero RNG.
// ============================================================

const SR:i64 = 44100;
const SRF:f64 = 44100.0;
const PH1:i64 = 281474976710656;

// ---------- byte helpers ----------
fn put32(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
}
fn put16(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
}
fn put64(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
    b[i+4]=((v>>32) & 255) as u8;
    b[i+5]=((v>>40) & 255) as u8;
    b[i+6]=((v>>48) & 255) as u8;
    b[i+7]=((v>>56) & 255) as u8;
}
fn get64(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24) | ((b[i+4] as i64)<<32) | ((b[i+5] as i64)<<40) | ((b[i+6] as i64)<<48) | ((b[i+7] as i64)<<56);
}
fn get32(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24);
}
fn get16s(b:[]u8,i:i64)i64{
    let v:i64=(b[i] as i64) | ((b[i+1] as i64)<<8);
    if(v>=32768){v=v-65536;}
    return v;
}
fn cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4095){return "";}
    let p:*u8=_zag_malloc((s.len+1) as i64) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..(s.len+1)];
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn w_all(fd:i64,b:[]u8)i64{
    let at:i64=0;
    let calls:i32=0;
    let blen:i64=b.len as i64;
    while(at<blen && calls<65536){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+at,blen-at,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<=0){return -7407;}
        at=at+n;
    }
    if(at!=blen){return -7407;}
    return at;
}
fn r_all(fd:i64,b:[]u8,off:i64,n:i64)i64{
    let at:i64=0;
    let calls:i32=0;
    while(at<n && calls<65536){
        let m:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(b) as i64)+off+at,n-at,0,0,0);
        calls=calls+1;
        if(m==-4){continue;}
        if(m<=0){break;}
        at=at+m;
    }
    return at;
}

// ---------- deterministic hash (no RNG anywhere) ----------
fn h32(s:i64,st:i64)i64{
    let z:i64=(s*2654435761+st*40503+1) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    z=(z*2246822519) & 4294967295;
    z=(z ^ (z>>13)) & 4294967295;
    z=(z*3266489917) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    return z;
}
fn h01(s:i64,st:i64)f64{
    return (h32(s,st) as f64)/4294967296.0;
}
// smoothstep 0..1 (edge-fade glue; proven pattern from synth.zag)
fn sstep(x:f64)f64{
    if(x<=0.0){return 0.0;}
    if(x>=1.0){return 1.0;}
    return x*x*(3.0-2.0*x);
}
// raised-cosine-ish 0..1 over n steps, via smoothstep
fn rcos(i:i64,n:i64)f64{
    if(n<2){return 1.0;}
    return sstep((i as f64)/((n-1) as f64));
}

// ---------- grain pack ----------
// Pack file layout (written by study.py, little-endian):
//   "GRPK", u32 ver=2, u32 ngrains,
//   u32 nsrc, [u32 len, bytes]*,
//   u32 ncls, [u32 len, bytes]*,
//   u32 ntables, per table: u32 cid, u32 voice, u32 count, count*u32 gidx,
//   per grain: u32 nsamp, u32 sid, u32 src_start, u32 cid, u32 voice,
//              nsamp * i16 LE samples.
// Handle arena (u64 entries): 0:gptr 1:gnsamp 2:gcid 3:gvoice 4:tbase
//   5:tc 6:tcid 7:tvoice 8:tidx 9:ngrains 10:ntables 11:ncls 12:clsname_ptr 13:clsoff
fn pack_load(path:[]u8)[]u8{
    let cs:[]u8=cstr(path);
    if(cs.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    if(fd<0){return "";}
    let hdr:[]u8=(_zag_malloc(64) as *u8)[0..64];
    let i:i64=0;
    while(i<64){hdr[i]=0;i=i+1;}
    if(r_all(fd,hdr,0,16)!=16){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    if(hdr[0]!=71 || hdr[1]!=82 || hdr[2]!=80 || hdr[3]!=75){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let ver:i64=get32(hdr,4);
    if(ver!=2){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let ng:i64=get32(hdr,8);
    let nsrc:i64=get32(hdr,12);
    // source names (kept for audit only)
    let sn:i64=0;
    while(sn<nsrc){
        let lb:[]u8=(_zag_malloc(4) as *u8)[0..4];
        if(r_all(fd,lb,0,4)!=4){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        let ln:i64=get32(lb,0);
        _zag_free(_zag_slice_ptr(lb));
        let nb:[]u8=(_zag_malloc(ln+1) as *u8)[0..(ln+1)];
        if(r_all(fd,nb,0,ln)!=ln){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        _zag_free(_zag_slice_ptr(nb));
        sn=sn+1;
    }
    let ncls:i64=0;
    // read ncls
    let cb:[]u8=(_zag_malloc(4) as *u8)[0..4];
    if(r_all(fd,cb,0,4)!=4){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    ncls=get32(cb,0);
    _zag_free(_zag_slice_ptr(cb));
    let cname:[]u8=(_zag_malloc(ncls*8) as *u8)[0..(ncls*8)];
    let coff:[]u8=(_zag_malloc(ncls*8) as *u8)[0..(ncls*8)];
    i=0;
    while(i<ncls*8){cname[i]=0;coff[i]=0;i=i+1;}
    let ci:i64=0;
    while(ci<ncls){
        let lb:[]u8=(_zag_malloc(4) as *u8)[0..4];
        if(r_all(fd,lb,0,4)!=4){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        let ln:i64=get32(lb,0);
        _zag_free(_zag_slice_ptr(lb));
        let nb:[]u8=(_zag_malloc(ln+1) as *u8)[0..(ln+1)];
        let k:i64=0;
        while(k<ln+1){nb[k]=0;k=k+1;}
        if(r_all(fd,nb,0,ln)!=ln){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        put64(cname,ci*8,(_zag_slice_ptr(nb) as i64));
        put64(coff,ci*8,ln);
        ci=ci+1;
    }
    let tb:[]u8=(_zag_malloc(4) as *u8)[0..4];
    if(r_all(fd,tb,0,4)!=4){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let nt:i64=get32(tb,0);
    _zag_free(_zag_slice_ptr(tb));
    let tbase:[]u8=(_zag_malloc(nt*8) as *u8)[0..(nt*8)];
    let tc:[]u8=(_zag_malloc(nt*8) as *u8)[0..(nt*8)];
    let tcid:[]u8=(_zag_malloc(nt*8) as *u8)[0..(nt*8)];
    let tvoice:[]u8=(_zag_malloc(nt*8) as *u8)[0..(nt*8)];
    i=0;
    while(i<nt*8){tbase[i]=0;tc[i]=0;tcid[i]=0;tvoice[i]=0;i=i+1;}
    // single pass: table headers are interleaved with their index data,
    // so read each header and immediately consume its indices into a temp.
    let ttmp:[]u8=(_zag_malloc(nt*8) as *u8)[0..(nt*8)];
    i=0;
    while(i<nt*8){ttmp[i]=0;i=i+1;}
    let flat_n:i64=0;
    let t:i64=0;
    while(t<nt){
        let hb:[]u8=(_zag_malloc(12) as *u8)[0..12];
        if(r_all(fd,hb,0,12)!=12){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        let cc:i64=get32(hb,0);
        let vv:i64=get32(hb,4);
        let cn:i64=get32(hb,8);
        _zag_free(_zag_slice_ptr(hb));
        if(cn<0 || cn>1000000){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        put64(tcid,t*8,cc);
        put64(tvoice,t*8,vv);
        put64(tc,t*8,cn);
        put64(tbase,t*8,flat_n);
        flat_n=flat_n+cn;
        let ib:[]u8=(_zag_malloc(cn*4+8) as *u8)[0..(cn*4+8)];
        if(r_all(fd,ib,0,cn*4)!=cn*4){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        put64(ttmp,t*8,(_zag_slice_ptr(ib) as i64));
        t=t+1;
    }
    let tidx:[]u8=(_zag_malloc(flat_n*4+8) as *u8)[0..(flat_n*4+8)];
    t=0;
    while(t<nt){
        let cn:i64=get64(tc,t*8);
        let base:i64=get64(tbase,t*8);
        let ip:i64=get64(ttmp,t*8);
        let ib2:[]u8=(ip as *u8)[0..(cn*4+8)];
        let k:i64=0;
        while(k<cn){
            put32(tidx,(base+k)*4,get32(ib2,k*4));
            k=k+1;
        }
        _zag_free(ip as *u8);
        t=t+1;
    }
    _zag_free(_zag_slice_ptr(ttmp));
    // grains
    let gptr:[]u8=(_zag_malloc(ng*8) as *u8)[0..(ng*8)];
    let gnsamp:[]u8=(_zag_malloc(ng*8) as *u8)[0..(ng*8)];
    let gcid:[]u8=(_zag_malloc(ng*8) as *u8)[0..(ng*8)];
    let gvoice:[]u8=(_zag_malloc(ng*8) as *u8)[0..(ng*8)];
    let gcent:[]u8=(_zag_malloc(ng*8) as *u8)[0..(ng*8)];
    i=0;
    while(i<ng*8){gptr[i]=0;gnsamp[i]=0;gcid[i]=0;gvoice[i]=0;gcent[i]=0;i=i+1;}
    let g:i64=0;
    while(g<ng){
        let gb:[]u8=(_zag_malloc(24) as *u8)[0..24];
        if(r_all(fd,gb,0,24)!=24){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        let ns:i64=get32(gb,0);
        let cc2:i64=get32(gb,12);
        let vv2:i64=get32(gb,16);
        let ce:i64=get32(gb,20);
        _zag_free(_zag_slice_ptr(gb));
        let sb:[]u8=(_zag_malloc(ns*2+8) as *u8)[0..(ns*2+8)];
        if(r_all(fd,sb,0,ns*2)!=ns*2){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        put64(gptr,g*8,(_zag_slice_ptr(sb) as i64));
        put64(gnsamp,g*8,ns);
        put64(gcid,g*8,cc2);
        put64(gvoice,g*8,vv2);
        put64(gcent,g*8,ce);
        g=g+1;
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    _zag_free(_zag_slice_ptr(hdr));
    let h:[]u8=(_zag_malloc(15*8) as *u8)[0..(15*8)];
    put64(h,0,(_zag_slice_ptr(gptr) as i64));
    put64(h,8,(_zag_slice_ptr(gnsamp) as i64));
    put64(h,16,(_zag_slice_ptr(gcid) as i64));
    put64(h,24,(_zag_slice_ptr(gvoice) as i64));
    put64(h,32,(_zag_slice_ptr(tbase) as i64));
    put64(h,40,(_zag_slice_ptr(tc) as i64));
    put64(h,48,(_zag_slice_ptr(tcid) as i64));
    put64(h,56,(_zag_slice_ptr(tvoice) as i64));
    put64(h,64,(_zag_slice_ptr(tidx) as i64));
    put64(h,72,ng);
    put64(h,80,nt);
    put64(h,88,ncls);
    put64(h,96,(_zag_slice_ptr(cname) as i64));
    put64(h,104,(_zag_slice_ptr(coff) as i64));
    put64(h,112,(_zag_slice_ptr(gcent) as i64));
    return h;
}
// class id by name; -1 if absent
fn cid_by_name(h:[]u8,name:[]u8)i64{
    let ncls:i64=get64(h,88);
    let cname:[]u8=(get64(h,96) as *u8)[0..(ncls*8)];
    let coff:[]u8=(get64(h,104) as *u8)[0..(ncls*8)];
    let ci:i64=0;
    while(ci<ncls){
        let np:i64=get64(cname,ci*8);
        let ln:i64=get64(coff,ci*8);
        let nb:[]u8=(np as *u8)[0..ln];
        if(_zag_strcmp(nb,name)==1){return ci;}
        ci=ci+1;
    }
    return -1;
}
// deterministic grain pick from (cid,voice) table; ban avoids immediate repeat
fn g_pick(h:[]u8,cid:i64,voice:i64,salt:i64,seq:i64,ban:i64)i64{
    let nt:i64=get64(h,80);
    let tbase:[]u8=(get64(h,32) as *u8)[0..(nt*8)];
    let tc:[]u8=(get64(h,40) as *u8)[0..(nt*8)];
    let tcid:[]u8=(get64(h,48) as *u8)[0..(nt*8)];
    let tvoice:[]u8=(get64(h,56) as *u8)[0..(nt*8)];
    let tot:i64=0;
    let u:i64=0;
    while(u<nt){tot=tot+get64(tc,u*8);u=u+1;}
    let tidx:[]u8=(get64(h,64) as *u8)[0..(tot*4)];
    let t:i64=0;
    while(t<nt){
        if(get64(tcid,t*8)==cid && get64(tvoice,t*8)==voice){
            let cn:i64=get64(tc,t*8);
            if(cn<1){return -1;}
            let base:i64=get64(tbase,t*8);
            let k:i64=0;
            let gi:i64=-1;
            while(k<4){
                let hh:i64=h32(salt+k*7919,seq*131+k);
                let cand:i64=get32(tidx,(base+(hh % cn))*4);
                if(cand!=ban){gi=cand;k=99;}
                k=k+1;
            }
            if(gi<0){gi=get32(tidx,base*4);}
            return gi;
        }
        t=t+1;
    }
    // voice==255 ("any") falls back to the merged table 254 (vocal classes)
    if(voice==255){
        let t2:i64=0;
        while(t2<nt){
            if(get64(tcid,t2*8)==cid && get64(tvoice,t2*8)==254){
                let cn:i64=get64(tc,t2*8);
                if(cn<1){return -1;}
                let base:i64=get64(tbase,t2*8);
                let k:i64=0;
                let gi:i64=-1;
                while(k<4){
                    let hh:i64=h32(salt+k*7919,seq*131+k);
                    let cand:i64=get32(tidx,(base+(hh % cn))*4);
                    if(cand!=ban){gi=cand;k=99;}
                    k=k+1;
                }
                if(gi<0){gi=get32(tidx,base*4);}
                return gi;
            }
            t2=t2+1;
        }
    }
    return -1;
}
fn g_nsamp(h:[]u8,gi:i64)i64{
    let gnsamp:[]u8=(get64(h,8) as *u8)[0..(get64(h,72)*8)];
    return get64(gnsamp,gi*8);
}
fn g_samp(h:[]u8,gi:i64,idx:i64,rev:i64)i64{
    let gptr:[]u8=(get64(h,0) as *u8)[0..(get64(h,72)*8)];
    let ns:i64=g_nsamp(h,gi);
    let p:i64=get64(gptr,gi*8);
    let b:[]u8=(p as *u8)[0..(ns*2)];
    let j:i64=idx;
    if(rev==1){j=ns-1-idx;}
    return get16s(b,j*2);
}

// ---------- mix arena: i64 Q24 ----------
fn mix_new(nsamp:i64)[]u8{
    let p:*u8=_zag_malloc(nsamp*8) as *u8;
    if(p==null as *u8){return "";}
    let m:[]u8=p[0..(nsamp*8)];
    let i:i64=0;
    while(i<nsamp*8){m[i]=0;i=i+1;}
    return m;
}
// place grain gi at sample `start`, gain f64; 2ms smoothstep edge glue.
fn place(h:[]u8,m:[]u8,nsamp:i64,gi:i64,start:i64,gain:f64,rev:i64)void{
    if(gi<0){return;}
    let ns:i64=g_nsamp(h,gi);
    let F:i64=88;
    if(F*2>ns){F=ns/4;}
    let s:i64=start;
    if(s<0){s=0;}
    let k:i64=0;
    while(k<ns){
        let at:i64=s+k;
        if(at>=nsamp){k=ns;}
        else{
            let v:i64=g_samp(h,gi,k,rev);
            let e:f64=1.0;
            if(k<F){e=sstep((k as f64)/(F as f64));}
            else{if(k>ns-1-F){e=sstep(((ns-1-k) as f64)/(F as f64));}}
            let add:i64=((v as f64)*gain*e*16777216.0/32768.0) as i64;
            let cur:i64=get64(m,at*8);
            let nv:i64=cur+add;
            if(nv>36028797018963968){nv=36028797018963968;}
            if(nv<-36028797018963968){nv=-36028797018963968;}
            put64(m,at*8,nv);
            k=k+1;
        }
    }
}
// morph: crossfade grain A -> grain B over min(lenA,lenB); the deliberate
// "one real event becoming another" (e.g. crack deepening into a break).
fn morph(h:[]u8,m:[]u8,nsamp:i64,giA:i64,giB:i64,start:i64,gain:f64)void{
    if(giA<0 || giB<0){return;}
    let nsA:i64=g_nsamp(h,giA);
    let nsB:i64=g_nsamp(h,giB);
    let n:i64=nsA;
    if(nsB<n){n=nsB;}
    let s:i64=start;
    if(s<0){s=0;}
    let k:i64=0;
    while(k<n){
        let at:i64=s+k;
        if(at>=nsamp){k=n;}
        else{
            let w:f64=sstep((k as f64)/((n-1) as f64)); // 0->1: A fades out
            let a:i64=g_samp(h,giA,k,0);
            let b:i64=g_samp(h,giB,k,0);
            let v:f64=(a as f64)*(1.0-w)+(b as f64)*w;
            let e:f64=1.0;
            if(k<88){e=sstep((k as f64)/88.0);}
            else{if(k>n-89){e=sstep(((n-1-k) as f64)/88.0);}}
            let add:i64=(v*gain*e*16777216.0/32768.0) as i64;
            let cur:i64=get64(m,at*8);
            let nv:i64=cur+add;
            if(nv>36028797018963968){nv=36028797018963968;}
            if(nv<-36028797018963968){nv=-36028797018963968;}
            put64(m,at*8,nv);
            k=k+1;
        }
    }
}

// ---------- deterministic grammar helpers ----------
// A laugh train: npulses vocal grains from one voice, ragged IOIs,
// decaying gains, no immediate grain repeats. The tumble comes from
// overlapping two trains of different voices.
fn laugh_train(h:[]u8,m:[]u8,nsamp:i64,cid:i64,voice:i64,t0:f64,np:i64,ioi:f64,salt:i64,g0:f64)void{
    let t:f64=t0;
    let last:i64=-1;
    let p:i64=0;
    while(p<np){
        let gi:i64=g_pick(h,cid,voice,salt,p,last);
        if(gi>=0){
            let g:f64=g0*(1.0-0.45*((p as f64)/(np as f64)));
            place(h,m,nsamp,gi,(t*SRF) as i64,g,0);
            last=gi;
        }
        let j:f64=h01(salt+7,p*3+1);
        t=t+ioi*(0.82+0.36*j);
        p=p+1;
    }
}
// footstep train: thump grains at step_hz with ragged IOIs.
fn run_feet(h:[]u8,m:[]u8,nsamp:i64,cid:i64,t0:f64,t1:f64,step_hz:f64,salt:i64,g0:f64)void{
    let t:f64=t0;
    let last:i64=-1;
    let q:i64=0;
    while(t<t1){
        let gi:i64=g_pick(h,cid,255,salt,q,last);
        if(gi>=0){
            let g:f64=g0*(0.85+0.3*h01(salt+13,q));
            place(h,m,nsamp,gi,(t*SRF) as i64,g,0);
            last=gi;
        }
        t=t+(1.0/step_hz)*(0.88+0.24*h01(salt+29,q*2));
        q=q+1;
    }
}
// sparse scatter of texture grains (real ambience, never a stationary bed)
fn scatter(h:[]u8,m:[]u8,nsamp:i64,cid:i64,t0:f64,t1:f64,gap:f64,salt:i64,g0:f64)void{
    let t:f64=t0;
    let last:i64=-1;
    let q:i64=0;
    while(t<t1){
        let gi:i64=g_pick(h,cid,255,salt,q,last);
        if(gi>=0){
            place(h,m,nsamp,gi,(t*SRF) as i64,g0*(0.7+0.6*h01(salt+41,q)),0);
            last=gi;
        }
        t=t+gap*(0.7+0.6*h01(salt+43,q*2+1));
        q=q+1;
    }
}

// ============ SCORE: kids playing and laughter (benchmark / TEST 1) ============
// Scene (deliberated, constructed mode): "Tag, late afternoon." Three
// children: V0 oldest (lowest voice), V1 middle, V2 youngest (squeals).
// Chasing game on a playground: running feet, tagging, laughter that
// tumbles, a trip, breathless winding down. Swing creaks indifferently.
fn score_kids(h:[]u8,m:[]u8,nsamp:i64)void{
    let c_laugh:i64=cid_by_name(h,"laugh");
    let c_shout:i64=cid_by_name(h,"shout");
    let c_squeal:i64=cid_by_name(h,"squeal");
    let c_thump:i64=cid_by_name(h,"thump");
    let c_wash:i64=cid_by_name(h,"wash");
    let c_wind:i64=cid_by_name(h,"wind");
    let c_creak:i64=cid_by_name(h,"creak");
    // ambience bed from real texture grains
    scatter(h,m,nsamp,c_wash,0.0,30.0,2.6,101,0.13);
    scatter(h,m,nsamp,c_wind,6.0,26.0,4.2,103,0.16);
    // swings, indifferent
    let sw:i64=0;
    while(sw<5){
        let tt:f64=2.0+(sw as f64)*6.0+h01(105,sw)*1.5;
        let gi:i64=g_pick(h,c_creak,255,106,sw,-1);
        place(h,m,nsamp,gi,(tt*SRF) as i64,0.22,0);
        sw=sw+1;
    }
    // running in
    run_feet(h,m,nsamp,c_thump,0.3,4.0,2.8,11,0.34);
    run_feet(h,m,nsamp,c_thump,0.8,4.5,2.6,12,0.30);
    // "you're it" shout
    place(h,m,nsamp,g_pick(h,c_shout,0,13,0,-1),(4.6*SRF) as i64,0.5,0);
    // chase
    run_feet(h,m,nsamp,c_thump,5.0,9.0,3.0,14,0.36);
    run_feet(h,m,nsamp,c_thump,5.2,9.2,2.7,15,0.33);
    run_feet(h,m,nsamp,c_thump,5.5,8.5,3.3,16,0.30);
    // tagged: V1 laughs, V0 tumbles in over it
    laugh_train(h,m,nsamp,c_laugh,1,6.2,9,0.19,21,0.52);
    laugh_train(h,m,nsamp,c_laugh,0,6.9,7,0.21,22,0.46);
    place(h,m,nsamp,g_pick(h,c_shout,1,23,0,-1),(9.5*SRF) as i64,0.42,0);
    // chase again
    run_feet(h,m,nsamp,c_thump,10.0,13.5,2.9,24,0.34);
    run_feet(h,m,nsamp,c_thump,10.3,13.0,3.1,25,0.30);
    // V0 trips: thud, squeal, then shriek-laughter from V1 and V2
    place(h,m,nsamp,g_pick(h,c_thump,255,26,0,-1),(12.2*SRF) as i64,0.62,0);
    place(h,m,nsamp,g_pick(h,c_squeal,0,27,0,-1),(12.75*SRF) as i64,0.5,0);
    place(h,m,nsamp,g_pick(h,c_squeal,0,27,1,-1),(13.05*SRF) as i64,0.44,0);
    laugh_train(h,m,nsamp,c_laugh,1,12.9,8,0.17,28,0.5);
    laugh_train(h,m,nsamp,c_laugh,2,13.2,10,0.155,29,0.48);
    // breathless: running slows, chuckles
    run_feet(h,m,nsamp,c_thump,16.0,20.0,2.2,30,0.28);
    place(h,m,nsamp,g_pick(h,c_laugh,0,31,0,-1),(17.2*SRF) as i64,0.34,0);
    place(h,m,nsamp,g_pick(h,c_laugh,2,32,0,-1),(18.1*SRF) as i64,0.32,0);
    place(h,m,nsamp,g_pick(h,c_laugh,1,33,0,-1),(19.0*SRF) as i64,0.30,0);
    place(h,m,nsamp,g_pick(h,c_shout,2,34,0,-1),(20.5*SRF) as i64,0.34,0);
    // winding down: walking, distant shout
    run_feet(h,m,nsamp,c_thump,21.0,25.0,1.5,35,0.2);
    place(h,m,nsamp,g_pick(h,c_shout,1,36,0,-1),(26.5*SRF) as i64,0.24,0);
}

// ============ SCORE: Kethra planet voice, rebuilt (TEST 2) ============
// Same brief as d_aud3 (PLANETVOICE.md): argon world, Ilyra's 18s tidal
// breath, rift vents, seismic groans, ice cracks, magnetosphere chorus.
// Rebuilt ONLY from studied grains. The chorus (rising voice) is the
// honest interpolation: no rising-pitch grains were studied, so "rising"
// is expressed as ASCENDING BRIGHTNESS + QUICKENING DENSITY cascades of
// real crack-ping grains -- declared in the audit, not smuggled.
fn score_planet(h:[]u8,m:[]u8,nsamp:i64)void{
    let c_rumble:i64=cid_by_name(h,"rumble");
    let c_wind:i64=cid_by_name(h,"wind");
    let c_boom:i64=cid_by_name(h,"boom");
    let c_crack:i64=cid_by_name(h,"crack");
    let c_creak:i64=cid_by_name(h,"creak");
    let c_wash:i64=cid_by_name(h,"wash");
    // deep planetary hum: long rumble grains overlapped, breathing on the
    // 18s tidal period (density/gain grammar, NOT an LFO on a bed)
    let t:f64=0.0;
    let q:i64=0;
    while(t<21.0){
        let ph:f64=t-((t/18.0) as i64 as f64)*18.0;
        let br:f64=0.55+0.45*sstep(ph/9.0);
        if(ph>=9.0){br=0.55+0.45*sstep((18.0-ph)/9.0);}
        let gi:i64=g_pick(h,c_rumble,255,201,q,-1);
        place(h,m,nsamp,gi,(t*SRF) as i64,0.20*br,0);
        t=t+1.1+0.5*h01(202,q);
        q=q+1;
    }
    // ridge-wind gusts: dark-bright-dark grain-density grammar x4
    let gt:f64=3.0;
    let g2:i64=0;
    while(g2<4){
        let k:i64=0;
        while(k<3){
            let gi2:i64=g_pick(h,c_wind,255,203,g2*3+k,-1);
            let gg:f64=0.14;
            if(k==1){gg=0.30;}
            place(h,m,nsamp,gi2,((gt+(k as f64)*0.8)*SRF) as i64,gg,0);
            k=k+1;
        }
        gt=gt+5.0;
        g2=g2+1;
    }
    // three rift exhalations: REVERSED booms (slow bloom, not a boom hit)
    place(h,m,nsamp,g_pick(h,c_boom,255,204,0,-1),(5.0*SRF) as i64,0.5,1);
    place(h,m,nsamp,g_pick(h,c_boom,255,204,1,-1),(11.0*SRF) as i64,0.55,1);
    place(h,m,nsamp,g_pick(h,c_boom,255,204,2,-1),(17.0*SRF) as i64,0.5,1);
    // three seismic groans: creak grains placed slow + low rumble
    place(h,m,nsamp,g_pick(h,c_creak,255,205,0,-1),(7.5*SRF) as i64,0.4,0);
    place(h,m,nsamp,g_pick(h,c_creak,255,205,1,-1),(13.5*SRF) as i64,0.42,0);
    place(h,m,nsamp,g_pick(h,c_creak,255,205,2,-1),(19.0*SRF) as i64,0.38,0);
    // eighteen ice cracks, sparse, hash-scattered
    let e:i64=0;
    while(e<18){
        let tt:f64=0.8+19.0*h01(206,e);
        place(h,m,nsamp,g_pick(h,c_crack,255,207,e,-1),(tt*SRF) as i64,0.30+0.2*h01(208,e),0);
        e=e+1;
    }
    // THE VOICE: seven chorus events. Each is a cascade of bright
    // crack-ping grains in ASCENDING centroid order with quickening
    // IOIs -- a rising gesture built from real events.
    let ct:f64=4.0;
    let ev:i64=0;
    while(ev<7){
        // gather 8 candidates, insertion-sort by centroid
        let cand:[]u8=(_zag_malloc(8*8) as *u8)[0..(8*8)];
        let cc2:[]u8=(_zag_malloc(8*8) as *u8)[0..(8*8)];
        let n2:i64=0;
        while(n2<8){
            let gi3:i64=g_pick(h,c_crack,255,209,ev*8+n2,-1);
            put64(cand,n2*8,gi3);
            put64(cc2,n2*8,g_cent(h,gi3));
            n2=n2+1;
        }
        let a2:i64=1;
        while(a2<8){
            let kg:i64=get64(cand,a2*8);
            let kc:i64=get64(cc2,a2*8);
            let b2:i64=a2-1;
            while(b2>=0 && get64(cc2,b2*8)>kc){
                put64(cand,(b2+1)*8,get64(cand,b2*8));
                put64(cc2,(b2+1)*8,get64(cc2,b2*8));
                b2=b2-1;
            }
            put64(cand,(b2+1)*8,kg);
            put64(cc2,(b2+1)*8,kc);
            a2=a2+1;
        }
        let tt2:f64=ct;
        let p2:i64=0;
        while(p2<8){
            let gi4:i64=get64(cand,p2*8);
            place(h,m,nsamp,gi4,(tt2*SRF) as i64,0.30+0.04*(p2 as f64),0);
            tt2=tt2+0.30-0.028*(p2 as f64);
            p2=p2+1;
        }
        _zag_free(_zag_slice_ptr(cand));
        _zag_free(_zag_slice_ptr(cc2));
        ct=ct+2.6+h01(210,ev)*1.2;
        ev=ev+1;
    }
    // thin air: sparse wash grains
    scatter(h,m,nsamp,c_wash,0.0,21.0,3.4,211,0.07);
}

// ============ SCORE: alien ocean at dawn, humming sky (TEST 3a) ============
// Deliberate physics (constructed mode): the sea is a DENSE heavy liquid,
// so surf runs ~3x SLOWER than Earth; near-freezing at dawn, the liquid
// is viscous-crystalline, so breaking crests CRACK and SHATTER instead of
// foaming; recession leaves fracture tails (reversed cracks). The sky's
// hum: long rumble grains in slow swell grammar -- no Earth hum exists,
// so this is declared extrapolation from thunder-tail texture.
fn score_ocean(h:[]u8,m:[]u8,nsamp:i64)void{
    let c_swell:i64=cid_by_name(h,"swell");
    let c_wash:i64=cid_by_name(h,"wash");
    let c_crack:i64=cid_by_name(h,"crack");
    let c_rumble:i64=cid_by_name(h,"rumble");
    // four slow swells
    let st:f64=2.0;
    let s2:i64=0;
    while(s2<4){
        let gi:i64=g_pick(h,c_swell,255,301,s2,-1);
        place(h,m,nsamp,gi,(st*SRF) as i64,0.5,0);
        // crest shatters: crack grains at the swell peak
        let ns:i64=g_nsamp(h,gi);
        let pkf:f64=(st as f64)+(ns as f64)/(SR as f64)*0.45;
        let c2:i64=0;
        while(c2<3){
            let gc:i64=g_pick(h,c_crack,255,302,s2*3+c2,-1);
            place(h,m,nsamp,gc,((pkf+(c2 as f64)*0.22)*SRF) as i64,0.34,0);
            c2=c2+1;
        }
        // recession: reversed crack tails (fracture, not foam)
        let gr:i64=g_pick(h,c_crack,255,303,s2,-1);
        place(h,m,nsamp,gr,((pkf+0.8)*SRF) as i64,0.22,1);
        st=st+7.0;
        s2=s2+1;
    }
    scatter(h,m,nsamp,c_wash,0.0,30.0,3.0,304,0.10);
    // the humming sky: rumble grains, slow swells, dawn brightening
    let t:f64=0.0;
    let q:i64=0;
    while(t<30.0){
        let dawn:f64=1.0;
        if(t>20.0){dawn=1.0+0.6*sstep((t-20.0)/10.0);}
        let gi2:i64=g_pick(h,c_rumble,255,305,q,-1);
        place(h,m,nsamp,gi2,(t*SRF) as i64,0.13*dawn,0);
        t=t+1.9+0.7*h01(306,q);
        q=q+1;
    }
    // dawn: the cracking intensifies as light hits the sea
    let d2:i64=0;
    while(d2<10){
        let tt:f64=20.0+9.5*h01(307,d2);
        place(h,m,nsamp,g_pick(h,c_crack,255,308,d2,-1),(tt*SRF) as i64,0.26,0);
        d2=d2+1;
    }
}

// ============ SCORE: the RAXITH (TEST 3b -- the monster) ============
// Committed description (deliberated BEFORE any sound):
// The RAXITH: 9-meter silicon hexapod on a glass-dune world. Its
// exoskeleton is brittle crystalline plates that continuously fracture
// and regrow. IT HAS NO LARYNX. It "speaks" by CONTROLLED MICRO-FRACTURE:
// plates crack in deliberate sequences. A greeting = rising density of
// micro-cracks; alarm/emphasis = one deep plate-break (boom-class) with a
// shower of micro-cracks after. Its voice grammar is LANGUAGE-LIKE:
// syllable clusters (3-7 cracks, 120-200ms apart), phrase gaps (1-2s),
// accelerating density toward emphasis. NOTHING roars, growls, or
// pitch-sags: percussion AS speech. A second Raxith answers, sparser,
// quieter. This has no Earth referent and no Hollywood grammar.
fn rax_phrase(h:[]u8,m:[]u8,nsamp:i64,c_crack:i64,t0:f64,nsyl:i64,salt:i64,g0:f64)void{
    let t:f64=t0;
    let last:i64=-1;
    let s:i64=0;
    while(s<nsyl){
        let gi:i64=g_pick(h,c_crack,255,salt,s,last);
        place(h,m,nsamp,gi,(t*SRF) as i64,g0*(0.8+0.4*h01(salt+3,s)),0);
        last=gi;
        t=t+0.12+0.08*h01(salt+5,s*2);
        s=s+1;
    }
}
fn plate_break(h:[]u8,m:[]u8,nsamp:i64,c_boom:i64,c_crack:i64,c_rumble:i64,t0:f64,salt:i64)void{
    place(h,m,nsamp,g_pick(h,c_boom,255,salt,0,-1),(t0*SRF) as i64,0.6,0);
    morph(h,m,nsamp,g_pick(h,c_crack,255,salt,1,-1),g_pick(h,c_rumble,255,salt,2,-1),((t0+0.25)*SRF) as i64,0.4);
    let s:i64=0;
    let tt:f64=t0+0.6;
    while(s<6){
        place(h,m,nsamp,g_pick(h,c_crack,255,salt,3+s,-1),(tt*SRF) as i64,0.36,0);
        tt=tt+0.18+0.1*h01(salt+7,s);
        s=s+1;
    }
}
fn score_monster(h:[]u8,m:[]u8,nsamp:i64)void{
    let c_crack:i64=cid_by_name(h,"crack");
    let c_boom:i64=cid_by_name(h,"boom");
    let c_rumble:i64=cid_by_name(h,"rumble");
    let c_creak:i64=cid_by_name(h,"creak");
    let c_wind:i64=cid_by_name(h,"wind");
    // dune wind; distant settling ticks
    scatter(h,m,nsamp,c_wind,0.0,30.0,2.8,401,0.12);
    let tk:i64=0;
    while(tk<6){
        place(h,m,nsamp,g_pick(h,c_crack,255,402,tk,-1),((0.5+(tk as f64)*0.65)*SRF) as i64,0.12,0);
        tk=tk+1;
    }
    // first utterance: three phrases, rising density
    rax_phrase(h,m,nsamp,c_crack,4.0,4,403,0.4);
    rax_phrase(h,m,nsamp,c_crack,5.8,5,404,0.44);
    rax_phrase(h,m,nsamp,c_crack,7.6,7,405,0.48);
    // emphasis: the plate-break
    plate_break(h,m,nsamp,c_boom,c_crack,c_rumble,10.5,406);
    // the second Raxith answers: sparser, quieter, overlapping once
    rax_phrase(h,m,nsamp,c_crack,14.0,3,407,0.26);
    rax_phrase(h,m,nsamp,c_crack,16.5,4,408,0.28);
    rax_phrase(h,m,nsamp,c_crack,18.2,3,409,0.42);
    rax_phrase(h,m,nsamp,c_crack,18.9,4,410,0.26);
    rax_phrase(h,m,nsamp,c_crack,21.0,5,411,0.3);
    // climax: dense fracture cascade into the final break
    let t:f64=22.0;
    let s:i64=0;
    while(s<16){
        place(h,m,nsamp,g_pick(h,c_crack,255,412,s,-1),(t*SRF) as i64,0.44,0);
        t=t+0.14-0.004*(s as f64);
        s=s+1;
    }
    plate_break(h,m,nsamp,c_boom,c_crack,c_rumble,26.0,413);
    place(h,m,nsamp,g_pick(h,c_crack,255,414,0,-1),(27.8*SRF) as i64,0.3,0);
    // one last settling creak-groan from the plates
    place(h,m,nsamp,g_pick(h,c_creak,255,415,0,-1),(28.6*SRF) as i64,0.22,0);
}

// per-grain centroid Hz (u32 at grain header offset 20), for brightness cascades
fn g_cent(h:[]u8,gi:i64)i64{
    let gcent:[]u8=(get64(h,112) as *u8)[0..(get64(h,72)*8)];
    return get64(gcent,gi*8);
}
// ---------- WAV writer (pattern from synth.zag, nsamp-parameterized) ----------
fn write_wav(path:[]u8,m:[]u8,nsamp:i64)i32{
    let s:i64=0;
    let peak:i64=0;
    while(s<nsamp){
        let v:i64=get64(m,s*8);
        let a:i64=v;
        if(a<0){a=-a;}
        if(a>peak){peak=a;}
        s=s+1;
    }
    if(peak<1000){return -1;}
    // DC removal (mastering hygiene, A-NATIVE law): subtract the mean.
    let dc:i64=0;
    s=0;
    while(s<nsamp){
        dc=dc+get64(m,s*8);
        s=s+1;
    }
    dc=dc/nsamp;
    s=0;
    while(s<nsamp){
        put64(m,s*8,get64(m,s*8)-dc);
        s=s+1;
    }
    let norm:f64=0.89*16777216.0/(peak as f64);
    let p:*u8=_zag_malloc(44+nsamp*2) as *u8;
    if(p==null as *u8){return -2;}
    let out:[]u8=p[0..(44+nsamp*2)];
    let i:i64=0;
    while(i<44+nsamp*2){out[i]=0;i=i+1;}
    out[0]=82;out[1]=73;out[2]=70;out[3]=70;
    put32(out,4,36+nsamp*2);
    out[8]=87;out[9]=65;out[10]=86;out[11]=69;
    out[12]=102;out[13]=109;out[14]=116;out[15]=32;
    put32(out,16,16);
    put16(out,20,1);
    put16(out,22,1);
    put32(out,24,44100);
    put32(out,28,88200);
    put16(out,32,2);
    put16(out,34,16);
    out[36]=100;out[37]=97;out[38]=116;out[39]=97;
    put32(out,40,nsamp*2);
    let fi:i64=1323;
    let fo:i64=nsamp/8;
    if(fo>35280){fo=35280;}
    s=0;
    while(s<nsamp){
        let v:i64=get64(m,s*8);
        let x:f64=((v as f64)/16777216.0)*norm;
        if(s<fi){x=x*sstep((s as f64)/(fi as f64));}
        let rem:i64=nsamp-s;
        if(rem<fo){x=x*sstep((rem as f64)/(fo as f64));}
        let ax:f64=x;
        if(ax<0.0){ax=-ax;}
        x=x/(1.0+0.35*ax);
        put16(out,44+s*2,(x*32767.0) as i64);
        s=s+1;
    }
    let cs:[]u8=cstr(path);
    if(cs.len==0){return -3;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),577,438,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    if(fd<0){return -4;}
    let wr:i64=w_all(fd,out);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    _zag_free(_zag_slice_ptr(out));
    if(wr<0){return -5;}
    return 0;
}

fn main()i32{
    let a1:[]u8=_zag_arg(1);
    let subj:i32=0;
    if(_zag_strcmp(a1,"kids")==1){subj=1;}
    if(_zag_strcmp(a1,"planet")==1){subj=2;}
    if(_zag_strcmp(a1,"ocean")==1){subj=3;}
    if(_zag_strcmp(a1,"monster")==1){subj=4;}
    if(subj==0){return 90;}
    let a2:[]u8=_zag_arg(2);
    let pkp:[]u8="study_out/gamma.grpk";
    if(a2.len>0){pkp=a2;}
    let a3:[]u8=_zag_arg(3);
    let outp:[]u8="out.wav";
    if(a3.len>0){outp=a3;}
    let h:[]u8=pack_load(pkp);
    if(h.len==0){return 91;}
    let nsamp:i64=1323000;
    if(subj==2){nsamp=926100;}
    let m:[]u8=mix_new(nsamp);
    if(m.len==0){return 92;}
    if(subj==1){score_kids(h,m,nsamp);}
    else{if(subj==2){score_planet(h,m,nsamp);}
    else{if(subj==3){score_ocean(h,m,nsamp);}
    else{score_monster(h,m,nsamp);}}}
    let rc:i32=write_wav(outp,m,nsamp);
    return rc;
}

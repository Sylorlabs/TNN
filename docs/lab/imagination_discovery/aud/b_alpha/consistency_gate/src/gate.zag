@import("../../src/common_v5.zag")
// ============================================================
// CONSISTENCY GATE — pre-delivery audio battery (Micah's standing
// rule, 2026-09-22). Pure Zag, deterministic, no RNG.
// Usage: gate <clip.wav>  -> prints per-bar PASS/FAIL, exits 0/1.
// Method matches consistency_gate/GATE.md exactly.
// ============================================================

// floor(log2(x))*1024 in fixed point, x>0. Binary refinement, 10 iters.
fn log2fp(x:i64)i64{
    if(x<=1){return 0;}
    let e:i64=0;
    let t:i64=x;
    if((t>>32)!=0){e=e+32;t=t>>32;}
    if((t>>16)!=0){e=e+16;t=t>>16;}
    if((t>>8)!=0){e=e+8;t=t>>8;}
    if((t>>4)!=0){e=e+4;t=t>>4;}
    if((t>>2)!=0){e=e+2;t=t>>2;}
    if((t>>1)!=0){e=e+1;}
    let r:i64=e*1024;
    let y:i64=0;
    if(e>=24){y=x>>(e-24);}else{y=x<<(24-e);}
    y=y & 33554431;
    let i:i64=1;
    while(i<=10){
        y=(y*y)>>24;
        if(y>=33554432){y=y>>1;r=r+(1024>>i);}
        i=i+1;
    }
    return r;
}

// milli-dB of a sum-of-squares over n samples: 10*log10(sumsq/n).
fn mdb(sumsq:i64,n:i64)i64{
    if(sumsq<=0){return -120000;}
    if(n<=0){return -120000;}
    let d:i64=log2fp(sumsq)-log2fp(n);
    return d*3010/1024;
}

// cos(x), x in [0,pi], Taylor to x^8 with pi/2 fold.
fn fcosr(x:f64)f64{
    let a:f64=x;
    let sgn:f64=1.0;
    if(a>1.5707963267948966){a=3.141592653589793-a;sgn=-1.0;}
    let x2:f64=a*a;
    let x4:f64=x2*x2;
    return sgn*(1.0-x2/2.0+x4/24.0-x4*x2/720.0+x4*x4/40320.0);
}

// Goertzel band energy for one 1s window: samples at byte offset so,
// returns E (f64). Target freq f (Hz), sr 44100.
fn goertzel(samp:[]u8,so:i64,n:i64,f:f64)f64{
    let w:f64=6.283185307179586*f/44100.0;
    let c:f64=2.0*fcosr(w);
    let s1:f64=0.0;
    let s2:f64=0.0;
    let i:i64=0;
    while(i<n){
        let x:f64=(get16s(samp,so+i*2) as f64)/32768.0;
        let s0:f64=x+c*s1-s2;
        s2=s1;
        s1=s0;
        i=i+1;
    }
    return s1*s1+s2*s2-c*s1*s2;
}

// ---------- gate-local line printers (single-syscall per line) ----------
// (common_v5's print_i64 emits a stray newline on this znc build; the gate
// needs exact one-line-per-bar output, so it formats into a buffer.)
fn g_putc(b:[]u8,p:i64,c:u8)i64{b[p]=c;return p+1;}
fn g_putstr(b:[]u8,p:i64,s:[]u8)i64{
    let i:i64=0;
    while(i<(s.len as i64)){b[p+i]=s[i];i=i+1;}
    return p+i;
}
fn g_puti64(b:[]u8,p:i64,v:i64)i64{
    let x:i64=v;
    if(x<0){b[p]=45;p=p+1;x=-x;}
    let d:i64=0;
    if(x==0){b[p]=48;return p+1;}
    let rev:i64=0;
    let xx:i64=x;
    while(xx>0){rev=rev*10+(xx%10);xx=xx/10;d=d+1;}
    while(d>0){b[p]=((rev%10)+48) as u8;rev=rev/10;p=p+1;d=d-1;}
    return p;
}
fn g_putf3(b:[]u8,p:i64,v:f64)i64{
    let x:f64=v;
    if(x<0.0){b[p]=45;p=p+1;x=-x;}
    let ip:i64=(x as i64);
    let fp:i64=((x-(ip as f64))*1000.0) as i64;
    p=g_puti64(b,p,ip);
    b[p]=46;p=p+1;
    if(fp<100){b[p]=48;p=p+1;}
    if(fp<10){b[p]=48;p=p+1;}
    p=g_puti64(b,p,fp);
    return p;
}
fn g_line(b:[]u8,p:i64)void{
    b[p]=10;
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(p+1) as i64,0,0,0);
}
fn pbar(b:[]u8,id:[]u8,v:f64,bar:f64,ok:i64)void{
    let p:i64=0;
    p=g_putstr(b,p,id);
    p=g_putc(b,p,32);
    p=g_putf3(b,p,v);
    p=g_putstr(b,p," bar ");
    p=g_putf3(b,p,bar);
    if(ok==1){p=g_putstr(b,p," PASS");}else{p=g_putstr(b,p," FAIL");}
    g_line(b,p);
}

fn main()i32{
    let lb:*u8=_zag_malloc(256) as *u8;
    let line:[]u8=lb[0..256];
    let path:[]u8=_zag_arg(1);
    if(path.len==0){
        let p0:i64=g_putstr(line,0,"usage: gate <clip.wav>");
        g_line(line,p0);
        return 2;
    }
    let raw:[]u8=file_read(path,80000000);
    if(raw.len==0){
        let p0:i64=g_putstr(line,0,"read fail");
        g_line(line,p0);
        return 2;
    }
    let samp:[]u8=wav_parse(raw);
    if(samp.len==0){
        let p0:i64=g_putstr(line,0,"wav parse fail");
        g_line(line,p0);
        return 2;
    }
    let nsamp:i64=(samp.len as i64)/2;
    if(nsamp<441000){
        let p0:i64=g_putstr(line,0,"clip too short (<10s)");
        g_line(line,p0);
        return 2;
    }

    // ---- 50 ms envelope: sumsq per window ----
    let W50:i64=2205;
    let NW:i64=nsamp/W50;
    let ep:*u8=_zag_malloc(NW*8) as *u8;
    let sumsq:[]u8=ep[0..(NW*8)];
    let peak:i64=0;
    let tot:i64=0;
    let w:i64=0;
    while(w<NW){
        let ss:i64=0;
        let j:i64=0;
        let base:i64=w*W50;
        while(j<W50){
            let s:i64=get16s(samp,(base+j)*2);
            let a:i64=s;
            if(a<0){a=-a;}
            if(a>peak){peak=a;}
            ss=ss+s*s;
            j=j+1;
        }
        put64(sumsq,w*8,ss);
        tot=tot+ss;
        w=w+1;
    }
    // milli-dB envelope
    let mp:*u8=_zag_malloc(NW*8) as *u8;
    let edb:[]u8=mp[0..(NW*8)];
    w=0;
    while(w<NW){
        put64(edb,w*8,mdb(get64(sumsq,w*8),W50));
        w=w+1;
    }

    // ---- 1 s RMS stats ----
    let NS1:i64=nsamp/44100;
    let sp:*u8=_zag_malloc(NS1*8) as *u8;
    let db1:[]u8=sp[0..(NS1*8)];
    let s1:i64=0;
    while(s1<NS1){
        let ss:i64=0;
        let k:i64=0;
        while(k<20){
            ss=ss+get64(sumsq,(s1*20+k)*8);
            k=k+1;
        }
        put64(db1,s1*8,mdb(ss,44100));
        s1=s1+1;
    }
    let m1:i64=0;
    s1=0;
    while(s1<NS1){m1=m1+get64(db1,s1*8);s1=s1+1;}
    m1=m1/NS1;
    let v1:i64=0;
    s1=0;
    while(s1<NS1){
        let d:i64=get64(db1,s1*8)-m1;
        v1=v1+d*d;
        s1=s1+1;
    }
    // std in dB via f64 sqrt of (v1/NS1)/1e6
    let sta_std:f64=fsqrt((v1 as f64)/(NS1 as f64))/1000.0;
    let sta_range:i64=0;
    s1=0;
    let mn:i64=get64(db1,0);
    let mx:i64=mn;
    while(s1<NS1){
        let d2:i64=get64(db1,s1*8);
        if(d2<mn){mn=d2;}
        if(d2>mx){mx=d2;}
        s1=s1+1;
    }
    sta_range=mx-mn;

    // ---- 50 ms stats ----
    let me:i64=0;
    w=0;
    while(w<NW){me=me+get64(edb,w*8);w=w+1;}
    me=me/NW;
    let ve:i64=0;
    w=0;
    while(w<NW){
        let de:i64=get64(edb,w*8)-me;
        ve=ve+de*de;
        w=w+1;
    }
    let lurch_std:f64=fsqrt((ve as f64)/(NW as f64))/1000.0;

    // ---- spectral: 64-band linear Goertzel per 1 s window ----
    // Magnitude-weighted centroid over linear bands tracks the FFT-centroid
    // behavior the calibration was done with (log-spaced energy bands
    // compressed real timbre drift 30x and inverted the anchor/v6 order).
    let NB:i64=64;
    // band freqs: 50 * 1.2133^k, k=0..31 (50 Hz .. 20 kHz)
    let bp:*u8=_zag_malloc(NB*2*8) as *u8;
    let brow:[]u8=bp[0..(NB*2*8)]; // row0 = prev norm E (1e-6 units), row1 = cur
    let b:i64=0;
    while(b<NB*2){put64(brow,b*8,0);b=b+1;}
    let cp:*u8=_zag_malloc(NS1*8) as *u8;
    let cents:[]u8=cp[0..(NS1*8)];
    let flux_max:f64=0.0;
    // precompute band freqs into i64 milli-Hz array: linear 0..11025 Hz
    let fp:*u8=_zag_malloc(NB*8) as *u8;
    let freqs:[]u8=fp[0..(NB*8)];
    b=0;
    let ff:f64=86.13;
    while(b<NB){
        put64(freqs,b*8,(ff*1000.0) as i64);
        ff=ff+172.27;
        b=b+1;
    }
    let ep2:*u8=_zag_malloc(NB*8) as *u8;
    let eraw:[]u8=ep2[0..(NB*8)];
    s1=0;
    while(s1<NS1){
        let so:i64=s1*44100;
        let sume:f64=0.0;
        let wsum:f64=0.0;
        let maxe:f64=0.0;
        // first pass: energies, find max
        b=0;
        while(b<NB){
            let fb:f64=(get64(freqs,b*8) as f64)/1000.0;
            let e:f64=goertzel(samp,so*2,44100,fb);
            // store E*1e6 as i64 (may overflow for huge E; clamp)
            let ei:i64=(e*1000000.0) as i64;
            put64(eraw,b*8,ei);
            if(e>maxe){maxe=e;}
            b=b+1;
        }
        if(maxe<=0.0){maxe=1.0;}
        let maxm:f64=fsqrt(maxe*1000000.0);
        // second pass: magnitude-weighted centroid + normalized flux
        let sdiff:f64=0.0;
        b=0;
        while(b<NB){
            let ei:i64=get64(eraw,b*8);
            let mag:f64=fsqrt(ei as f64);
            let fb2:f64=(get64(freqs,b*8) as f64)/1000.0;
            sume=sume+mag;
            wsum=wsum+fb2*mag;
            let nm:f64=mag/maxm;
            let nmi:i64=(nm*1000000.0) as i64;
            put64(brow,(NB+b)*8,nmi);
            if(s1>0){
                let prev:i64=get64(brow,b*8);
                let dd:f64=((nmi-prev) as f64)/1000000.0;
                sdiff=sdiff+dd*dd;
            }
            b=b+1;
        }
        let cent:f64=0.0;
        if(sume>0.0){cent=wsum/sume;}
        put64(cents,s1*8,(cent*1000.0) as i64);
        if(s1>0){
            let fl:f64=fsqrt(sdiff/(NB as f64));
            if(fl>flux_max){flux_max=fl;}
        }
        // rotate rows: cur -> prev
        b=0;
        while(b<NB){
            put64(brow,b*8,get64(brow,(NB+b)*8));
            b=b+1;
        }
        s1=s1+1;
    }
    _zag_free(ep2 as *u8);
    // centroid std
    let mc:i64=0;
    s1=0;
    while(s1<NS1){mc=mc+get64(cents,s1*8);s1=s1+1;}
    mc=mc/NS1;
    let vc:f64=0.0;
    s1=0;
    while(s1<NS1){
        let dc2:f64=((get64(cents,s1*8)-mc) as f64)/1000.0;
        vc=vc+dc2*dc2;
        s1=s1+1;
    }
    let cent_std:f64=fsqrt(vc/(NS1 as f64));

    // ---- envelope autocorr, 20 Hz env, lags 0.5..25 s ----
    let ac0:i64=0;
    w=0;
    while(w<NW){
        let de2:i64=get64(edb,w*8)-me;
        ac0=ac0+de2*de2;
        w=w+1;
    }
    let ac_max:f64=0.0;
    let lag:i64=10;
    let lagmax:i64=NW-10;
    if(lagmax>500){lagmax=500;}
    while(lag<=lagmax){
        let ac:i64=0;
        w=0;
        while(w<NW-lag){
            ac=ac+(get64(edb,w*8)-me)*(get64(edb,(w+lag)*8)-me);
            w=w+1;
        }
        let r:f64=0.0;
        if(ac0>0){r=(ac as f64)/(ac0 as f64);}
        if(r>ac_max){ac_max=r;}
        lag=lag+1;
    }

    // ---- onsets: >6 dB rises per 50 ms, per 2 s bins ----
    let nbins:i64=NW/40;
    let onmax:i64=0;
    let bi:i64=0;
    while(bi<nbins){
        let c:i64=0;
        let k2:i64=0;
        while(k2<40){
            let idx:i64=bi*40+k2;
            if(idx>0 && idx<NW){
                if(get64(edb,idx*8)-get64(edb,(idx-1)*8)>6000){c=c+1;}
            }
            k2=k2+1;
        }
        if(c>onmax){onmax=c;}
        bi=bi+1;
    }

    // ---- gaps: windows < -60 dBFS ----
    let ngap:i64=0;
    let run:i64=0;
    let best:i64=0;
    w=0;
    while(w<NW){
        if(get64(edb,w*8)<-60000){
            ngap=ngap+1;
            run=run+1;
            if(run>best){best=run;}
        }else{
            run=0;
        }
        w=w+1;
    }
    let gapfrac:f64=(ngap as f64)/(NW as f64);
    let gaplong:f64=(best as f64)/20.0;

    // ---- peak / crest ----
    let peakf:f64=(peak as f64)/32768.0;
    let rmsall:f64=fsqrt((tot as f64)/(nsamp as f64))/32768.0;
    let crest:f64=0.0;
    if(rmsall>0.0){crest=peakf/rmsall;}

    // ---- ends ----
    let head:i64=0;
    w=0;
    while(w<40 && w<NW){head=head+get64(edb,w*8);w=w+1;}
    head=head/40;
    let tail:i64=0;
    w=0;
    while(w<40 && w<NW){tail=tail+get64(edb,(NW-1-w)*8);w=w+1;}
    tail=tail/40;
    let mid:i64=me;
    let headdip:f64=((mid-head) as f64)/1000.0;
    let taildip:f64=((mid-tail) as f64)/1000.0;

    // ---- bars ----
    let p:i64=g_putstr(line,0,"clip ");
    p=g_putstr(line,p,path);
    g_line(line,p);
    let fails:i64=0;
    let ok:i64=0;
    if(ac_max<=0.35){ok=1;}else{ok=0;fails=fails+1;}
    pbar(line,"G-PER",ac_max,0.35,ok);
    if(sta_std<=3.0){ok=1;}else{ok=0;fails=fails+1;}
    pbar(line,"G-STA",sta_std,3.0,ok);
    if(lurch_std<=5.0){ok=1;}else{ok=0;fails=fails+1;}
    pbar(line,"G-LURCH",lurch_std,5.0,ok);
    if(cent_std<=800.0){ok=1;}else{ok=0;fails=fails+1;}
    pbar(line,"G-DRIFT",cent_std,800.0,ok);
    if(flux_max<=0.35){ok=1;}else{ok=0;fails=fails+1;}
    pbar(line,"G-FLUXm",flux_max*1000.0,350.0,ok);
    if(gapfrac<=0.02){ok=1;}else{ok=0;fails=fails+1;}
    pbar(line,"G-SIL1",gapfrac,0.02,ok);
    if(gaplong<=0.5){ok=1;}else{ok=0;fails=fails+1;}
    pbar(line,"G-SIL2",gaplong,0.5,ok);
    if(peakf<=0.95){ok=1;}else{ok=0;fails=fails+1;}
    pbar(line,"G-CLIP",peakf,0.95,ok);
    if(crest<=14.0){ok=1;}else{ok=0;fails=fails+1;}
    pbar(line,"G-CREST",crest,14.0,ok);
    // warns
    p=g_putstr(line,0,"W-ENDS head ");
    p=g_putf3(line,p,headdip);
    p=g_putstr(line,p,"dB tail ");
    p=g_putf3(line,p,taildip);
    p=g_putstr(line,p,"dB");
    if(headdip>12.0 || taildip>12.0){p=g_putstr(line,p," WARN");}else{p=g_putstr(line,p," ok");}
    g_line(line,p);
    p=g_putstr(line,0,"W-DENSE onsets/2s max ");
    p=g_puti64(line,p,onmax);
    if(onmax>6){p=g_putstr(line,p," WARN");}else{p=g_putstr(line,p," ok");}
    g_line(line,p);
    p=g_putstr(line,0,"W-DYN 1s rms range ");
    p=g_putf3(line,p,(sta_range as f64)/1000.0);
    p=g_putstr(line,p,"dB");
    if(sta_range>14000){p=g_putstr(line,p," WARN");}else{p=g_putstr(line,p," ok");}
    g_line(line,p);
    if(fails>0){
        p=g_putstr(line,0,"GATE: FAIL (");
        p=g_puti64(line,p,fails);
        p=g_putstr(line,p," bars)");
        g_line(line,p);
        return 1;
    }
    p=g_putstr(line,0,"GATE: PASS");
    g_line(line,p);
    return 0;
}

@import("common_v5.zag")
// ============================================================
// render_v9.zag - b_alpha kids playground, v9 "one scene" (NEW 2026-09-23).
//
// Micah's verdict on v8: "Sounds like someone tried to fuse a bunch of
// clips together but it's not a consistent sound of children playing."
// His creative law: don't fuse/force clips together - think of the mood,
// the type of children, the age, and make ONE consistent sound in the
// head. Default: little kids in a playground.
//
// DIAGNOSIS of the fused feel (measured, not guessed):
// v8's atoms came from FIVE different recordings: w1 Berlin playground,
// w2 dozen-kids playground, w3 a single 4-year-old laughing, w4 a park,
// w5 Tokyo janken chanting. Different continents, different mics,
// different rooms, different children, different ages - pasted in
// sequence. The score was honest collage; the ear heard the seams.
// The bed was worse: a granular wash of textures from catalog3 (ocean
// material!) plus catalog.bin - the "air" itself changed rooms.
//
// v9 REBUILD, scene-first:
// - ONE WORLD: every atom and every bed chunk comes from w2.wav
//   ("dozen children on playground", 48.8 s, one mic, one place).
//   fno==1 filter on the catalog: 12 laugh + 7 voice + 25 footstep
//   atoms, all from the same recording.
// - CAST, not salad: laughter cluster 2 (9 atoms) and cluster 0 (3)
//   recur as the same laughing kids; voice clusters 0/1/2 (4/1/2)
//   recur as the same calling kids. Round-robin reuse = the same
//   child heard twice, which reads as one continuous kid.
// - ONE MOMENT: a single 30 s playground scene, fully composed -
//   kids arrive running and calling, a chase game, one trips (stumble,
//   thud, gasp), everyone laughs, the game winds down and they drift
//   off. No hash-walk bigram salad; the score IS the scene.
// - NATURAL RATE: ratio = 1.0 on every event. v8 stretched atoms
//   0.90-1.14x, shifting formants so one child sounded like several.
// - Bed: the world's own quiet air - 8 quietest 1.5 s chunks of w2,
//   joined into a seamless equal-power ring, traversed contiguously
//   with v8's rare-reseed + macro-envelope machinery (kept verbatim
//   in technique, single-source in material).
//
// KEPT from v8 (all technical wins): seamless ring, rare deterministic
// reseeds, zero-phase macro-envelope follower, 8 ms attack / 500 ms
// release event staging, class-median levels, EVENT_TRIM 0.5,
// transparent limiter-only mastering, deterministic hash streams where
// used, byte-identical reruns, no RNG. Pure Zag; Python only for
// forensic measurement. Compile with the pinned znc from src/.
// ============================================================

// ---------- slow-LFO sine (Taylor to x^7; x folded to [-pi,pi]) ----------
fn fsinr(x:f64)f64{
    let a:f64=x;
    if(a>3.141592653589793){a=a-6.283185307179586;}
    let x2:f64=a*a;
    let x3:f64=x2*a;
    let x5:f64=x3*x2;
    let x7:f64=x5*x2;
    return a-x3/6.0+x5/120.0-x7/5040.0;
}

// RMS of a texture in FS units (one pass over the short texture).
fn txrms(txwave:[]u8,wo:i64,ln:i64)f64{
    let ss:f64=0.0;
    let j:i64=0;
    while(j<ln){
        let s:f64=(get16s(txwave,wo+j*2) as f64);
        ss=ss+s*s;
        j=j+1;
    }
    return fsqrt(ss/(ln as f64))/32768.0;
}

const BED_RMS_TGT:i64 = 463;
const GRAIN:i64 = 32768;
const GHOP:i64 = 4096;

// Hann window, Q30 fixed point, precomputed once.
fn hann_init(win:[]u8)void{
    let i:i64=0;
    while(i<GRAIN){
        let x:f64=6.283185307179586*(i as f64)/(GRAIN as f64);
        let c:f64=fsinr(x+1.5707963267948966);
        let w:f64=0.5*(1.0-c);
        put64(win,i*8,(w*1073741824.0) as i64);
        i=i+1;
    }
}

// ---------- v9 bed source: the world's own quiet air ----------
// w2 ("dozen children on playground") has no long quiet stretches
// (quietest 1 s block: -31 dBFS), so the bed is built from its 8
// quietest 1.5 s windows, >= 2 s apart, joined into a seamless ring.
// All from one mic in one place: the air never changes rooms.
// Deterministic: strict first-wins ties, greedy lowest-energy pick.
const CHBLK:i64 = 4410;    // 100 ms analysis blocks
const CHWIN:i64 = 66150;   // 1.5 s chunk
const CHSTEP:i64 = 11025;  // 0.25 s candidate step
const CHSEP:i64 = 88200;   // 2.0 s minimum separation
const CHWANT:i64 = 8;
fn w2_chunks(w2:[]u8,nsamp:i64,txwave:[]u8,txtab:[]u8,ntex0:i64,woff:i64,chidx:[]u8,woff_out:*i64)i64{
    let nblk:i64=nsamp/CHBLK;
    let bp:*u8=_zag_malloc(nblk*8) as *u8;
    let be:[]u8=bp[0..(nblk*8)];
    let b:i64=0;
    while(b<nblk){
        let ss:f64=0.0;
        let j:i64=0;
        while(j<CHBLK){
            let s:f64=(get16s(w2,(b*CHBLK+j)*2) as f64)/32768.0;
            ss=ss+s*s;
            j=j+1;
        }
        let rms:f64=fsqrt(ss/(CHBLK as f64));
        put64(be,b*8,(rms*1000000.0) as i64);
        b=b+1;
    }
    let pp:*u8=_zag_malloc(CHWANT*8) as *u8;
    let chpos:[]u8=pp[0..(CHWANT*8)];
    let nch:i64=0;
    let more:i64=1;
    while(more==1){
        if(nch>=CHWANT){more=0;}
        if(more==1){
            let best:i64=-1;
            let beste:i64=0;
            let s:i64=0;
            while(s+CHWIN<=nsamp){
                let ok:i64=1;
                let q:i64=0;
                while(q<nch){
                    let d:i64=s-get64(chpos,q*8);
                    if(d<0){d=-d;}
                    if(d<CHSEP){ok=0;}
                    q=q+1;
                }
                if(ok==1){
                    let b0:i64=s/CHBLK;
                    let b1:i64=(s+CHWIN)/CHBLK;
                    let e:i64=0;
                    let bb:i64=b0;
                    while(bb<b1){e=e+get64(be,bb*8);bb=bb+1;}
                    if(best<0){best=s;beste=e;}
                    if(e<beste){best=s;beste=e;}
                }
                s=s+CHSTEP;
            }
            if(best<0){more=0;}
            if(more==1){
                put64(chpos,nch*8,best);
                nch=nch+1;
            }
        }
    }
    // copy chunks into txwave/txtab (demean+normalize happens in the
    // ring builder, same as v8)
    let wo:i64=woff;
    let c:i64=0;
    while(c<nch){
        let st:i64=get64(chpos,c*8);
        let txi:i64=ntex0+c;
        put32(txtab,txi*16,CHWIN);
        put64(txtab,txi*16+8,wo);
        let k:i64=0;
        while(k<CHWIN){
            put16(txwave,wo+k*2,get16s(w2,(st+k)*2));
            k=k+1;
        }
        put64(chidx,c*8,txi);
        wo=wo+CHWIN*2;
        c=c+1;
    }
    woff_out.*=wo;
    _zag_free(_zag_slice_ptr(chpos));
    _zag_free(_zag_slice_ptr(be));
    return nch;
}

// Seamless ring from the w2 chunks: each demeaned + RMS-normalized to
// their mean, joined by JXF-sample EQUAL-POWER crossfades (sin/cos),
// last -> first closed. Ring duplicated 2x so grain reads never wrap.
// Returns ring length L (samples); src holds 2*L samples.
const JXF:i64 = 11025; // 0.25 s equal-power junctions
const ENV_A:f64 = 0.99996977; // exp(-1/(44100*0.75)): one-pole, tau 0.75 s
fn gsrc_init_v9(gsrc:[]u8,chidx:[]u8,nch:i64,txtab:[]u8,txwave:[]u8)i64{
    let rt:f64=0.0;
    let ti:i64=0;
    while(ti<nch){
        let txi:i64=get64(chidx,ti*8);
        rt=rt+txrms(txwave,get64(txtab,txi*16+8),get32(txtab,txi*16));
        ti=ti+1;
    }
    rt=rt/(nch as f64);
    let L:i64=0;
    ti=0;
    while(ti<nch){
        L=L+get32(txtab,get64(chidx,ti*8)*16);
        ti=ti+1;
    }
    L=L-nch*JXF; // nch junctions (ring is closed)
    let fp:*u8=_zag_malloc(L*8) as *u8;
    let acc:[]u8=fp[0..(L*8)];
    let z:i64=0;
    while(z<L){put64(acc,z*8,0);z=z+1;}
    let off:i64=0;
    ti=0;
    while(ti<nch){
        let txi2:i64=get64(chidx,ti*8);
        let wo:i64=get64(txtab,txi2*16+8);
        let ln:i64=get32(txtab,txi2*16);
        let rr:f64=txrms(txwave,wo,ln);
        let ratio:f64=1.0;
        if(rr>0.0){ratio=rt/rr;}
        let m:f64=0.0;
        let j:i64=0;
        while(j<ln){m=m+(get16s(txwave,wo+j*2) as f64);j=j+1;}
        let dc:f64=m/(ln as f64);
        j=0;
        while(j<ln){
            let v:f64=((get16s(txwave,wo+j*2) as f64)-dc)*ratio;
            let g:f64=1.0;
            if(j<JXF){
                let t:f64=(j as f64)/(JXF as f64);
                g=fsinr(1.5707963267948966*t);
            }
            if(j>ln-JXF){
                let t2:f64=((ln-j) as f64)/(JXF as f64);
                g=fsinr(1.5707963267948966*t2);
            }
            let at:i64=off+j;
            if(at>=L){at=at-L;}
            put64(acc,at*8,((get64(acc,at*8) as f64)+v*g*256.0) as i64);
            j=j+1;
        }
        off=off+ln-JXF;
        ti=ti+1;
    }
    let pk:f64=1.0;
    z=0;
    while(z<L){
        let a:f64=(get64(acc,z*8) as f64)/256.0;
        if(a<0.0){a=-a;}
        if(a>pk){pk=a;}
        z=z+1;
    }
    let sc:f64=30000.0/pk;
    z=0;
    while(z<L){
        let a2:f64=(get64(acc,z*8) as f64)/256.0*sc;
        let s16:i64=(a2 as i64);
        put16(gsrc,z*2,s16);
        put16(gsrc,(z+L)*2,s16);
        z=z+1;
    }
    _zag_free(_zag_slice_ptr(acc));
    return L;
}

fn gsrc_flatten_both(gsrc:[]u8,sl2:i64)void{
    // Zero-phase one-pole (tau 0.75 s) macro-envelope follower on the
    // ring, seeded with the ring's mean square (steady state: no
    // startup transient). Gain = ring-RMS / local-RMS, clamped to
    // [0.5, 2.0] so near-silence can never pump. Computed ONCE from
    // the unflattened ring, applied to BOTH copies so wraps stay
    // seamless. Deterministic.
    let fp2:*u8=_zag_malloc(sl2*8) as *u8;
    let env:[]u8=fp2[0..(sl2*8)];
    let ms:f64=0.0;
    let i:i64=0;
    while(i<sl2){
        let s:f64=(get16s(gsrc,i*2) as f64)/32768.0;
        ms=ms+s*s;
        i=i+1;
    }
    ms=ms/(sl2 as f64);
    if(ms<1e-12){ms=1e-12;}
    let e:f64=ms;
    i=0;
    while(i<sl2){
        let s2:f64=(get16s(gsrc,i*2) as f64)/32768.0;
        e=ENV_A*e+(1.0-ENV_A)*s2*s2;
        put64(env,i*8,(e*256.0) as i64);
        i=i+1;
    }
    e=ms;
    i=sl2-1;
    while(i>=0){
        let s3:f64=(get16s(gsrc,i*2) as f64)/32768.0;
        e=ENV_A*e+(1.0-ENV_A)*s3*s3;
        let fwd:f64=(get64(env,i*8) as f64)/256.0;
        put64(env,i*8,((fwd+e)*0.5*256.0) as i64);
        i=i-1;
    }
    let tgt:f64=fsqrt(ms);
    i=0;
    while(i<sl2){
        let ei:f64=(get64(env,i*8) as f64)/256.0;
        let er:f64=fsqrt(ei);
        let g:f64=tgt/er;
        if(g<0.5){g=0.5;}
        if(g>2.0){g=2.0;}
        let v0:f64=(get16s(gsrc,i*2) as f64)*g;
        let v1:f64=(get16s(gsrc,(i+sl2)*2) as f64)*g;
        put16(gsrc,i*2,(v0 as i64));
        put16(gsrc,(i+sl2)*2,(v1 as i64));
        i=i+1;
    }
    _zag_free(_zag_slice_ptr(env));
}

// v9 bed: smooth contiguous traversal of the single-world ring
// (macro-flattened), rare deterministic crossfaded re-seeds (mean
// ~9 s) so the wash never loops. Between reseeds the envelope is the
// world's own air, verbatim. Two-pass scale to BED_RMS_TGT.
const RESEED_EVERY:i64 = 96; // mean reseed interval, in grains (~9.0 s)
fn bed_v9(mix:[]u8,nsamp:i64,chidx:[]u8,nch:i64,txtab:[]u8,txwave:[]u8,seed:i64)void{
    let wp:*u8=_zag_malloc(GRAIN*8) as *u8;
    let win:[]u8=wp[0..(GRAIN*8)];
    hann_init(win);
    let SL:i64=0;
    let sli:i64=0;
    while(sli<nch){SL=SL+get32(txtab,get64(chidx,sli*8)*16);sli=sli+1;}
    let sp:*u8=_zag_malloc(SL*4) as *u8;
    let gsrc:[]u8=sp[0..(SL*4)];
    let sl2:i64=gsrc_init_v9(gsrc,chidx,nch,txtab,txwave);
    gsrc_flatten_both(gsrc,sl2);
    let bp:*u8=_zag_malloc(nsamp*8) as *u8;
    let bed:[]u8=bp[0..(nsamp*8)];
    let z:i64=0;
    while(z<nsamp*8){bed[z]=0;z=z+1;}
    let nk:i64=(nsamp+GHOP-1)/GHOP;
    let pos:i64=-1;
    let k:i64=0;
    while(k<nk){
        let p0:i64=k*GHOP;
        let need_reseed:i64=0;
        if(pos<0){need_reseed=1;}
        if(h01(seed+911,k)<(1.0/(RESEED_EVERY as f64))){need_reseed=1;}
        if(need_reseed==1){
            pos=((h01(seed,k*2+1)*(sl2 as f64)) as i64);
            if(pos>=sl2){pos=sl2-1;}
        }else{
            pos=pos+GHOP;
            if(pos>=sl2){pos=pos-sl2;}
        }
        let gpos:i64=pos;
        let i3:i64=0;
        while(i3<GRAIN){
            let o:i64=p0+i3;
            if(o<nsamp){
                let sv:i64=get16s(gsrc,(gpos+i3)*2);
                let wq:i64=get64(win,i3*8);
                let contrib:i64=(sv*wq)>>30;
                let bo:i64=o*8;
                put64(bed,bo,get64(bed,bo)+(contrib<<24));
            }
            i3=i3+1;
        }
        k=k+1;
    }
    let ss:f64=0.0;
    let t:i64=0;
    while(t<nsamp){
        let v:f64=(get64(bed,t*8) as f64)/16777216.0;
        ss=ss+v*v;
        t=t+1;
    }
    let rms:f64=fsqrt(ss/(nsamp as f64));
    let scale:f64=((BED_RMS_TGT as f64)/32768.0)/rms;
    print_str("bed_rms_raw=");print_i64((rms*32768.0) as i64);print_nl();
    t=0;
    while(t<nsamp){
        let bv:i64=get64(bed,t*8);
        let add:i64=((bv as f64)*scale) as i64;
        let bo2:i64=t*8;
        put64(mix,bo2,get64(mix,bo2)+add);
        t=t+1;
    }
    _zag_free(_zag_slice_ptr(bed));
    _zag_free(_zag_slice_ptr(gsrc));
    _zag_free(_zag_slice_ptr(win));
}

// ---------- events: natural levels, long decays, no digital-zero gaps ----------
// Per-class median atom peaks, measured from catalog.bin 2026-09-23:
// class 0 (laughter): 13108 | class 1 (voice): 3836 | class 2 (footsteps): 9182.
// Atoms keep their natural rate (ratio 1.0): no formant shift, so one
// child keeps one voice through the whole scene.
fn cls_refpk(cls:i64)f64{
    if(cls==0){return 13108.0;}
    if(cls==1){return 3836.0;}
    return 9182.0;
}

fn at_put32(t:[]u8,a:i64,f:i64,v:i64)void{put32(t,a*ATREC+f,v);}
fn at_get32(t:[]u8,a:i64,f:i64)i64{return get32s(t,a*ATREC+f);}
fn at_put(t:[]u8,a:i64,f:i64,v:i64)void{put64(t,a*ATREC+f,v);}
fn at_get(t:[]u8,a:i64,f:i64)i64{return get64(t,a*ATREC+f);}
const ATREC:i64 = 24;

// v8 staging, kept: 8 ms attack (transients stay crisp), 500 ms
// smoothstep release (atoms decay INTO the bed and into each other),
// class-median level reference, global EVENT_TRIM 0.5 (calibrated
// 2026-09-23: sits IN the space, passes the frozen gate).
const EVENT_TRIM:f64 = 0.5;
fn place_event_v6(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,ai:i64,start:i64,ratio:f64,tpeak:f64,gain:f64,refpk:f64)void{
    let ln:i64=at_get32(atab,ai,8);
    let wo:i64=at_get(atab,ai,16);
    if(ln<64){return;}
    let dsum:i64=0;
    let pk:i64=0;
    let k:i64=0;
    while(k<ln){
        let sv:i64=get16s(wave,wo+k*2);
        dsum=dsum+sv;
        if(sv<0){sv=-sv;}
        if(sv>pk){pk=sv;}
        k=k+1;
    }
    let dc:f64=(dsum as f64)/(ln as f64);
    let lvl:f64=1.0;
    if(pk>0){lvl=tpeak*(refpk/(pk as f64))*EVENT_TRIM;}
    let olen:i64=((ln as f64)/ratio) as i64;
    if(olen<32){return;}
    if(start<0){return;}
    if(start+olen>nsamp){olen=nsamp-start;}
    let fa:i64=353; // ~8 ms attack
    if(fa>olen/4){fa=olen/4;}
    let frel:i64=22050; // ~500 ms release: decay into the bed, not a chop
    if(frel>olen/2){frel=olen/2;}
    let j:i64=0;
    while(j<olen){
        let sp:f64=(j as f64)*ratio;
        let i0:i64=(sp as i64);
        if(i0>=ln-1){i0=ln-2;}
        let fr:f64=sp-(i0 as f64);
        let s0:f64=(get16s(wave,wo+i0*2) as f64)-dc;
        let s1:f64=(get16s(wave,wo+(i0+1)*2) as f64)-dc;
        let v:f64=(s0+(s1-s0)*fr)/32768.0*lvl*gain;
        if(j<fa){v=v*sstep((j as f64)/(fa as f64));}
        let rem:i64=olen-j;
        if(rem<frel){v=v*sstep((rem as f64)/(frel as f64));}
        let cur:i64=get64(mix,(start+j)*8);
        put64(mix,(start+j)*8,cur+((v*16777216.0) as i64));
        j=j+1;
    }
}

// ev9: cast-based placement. The cast list holds atom indices of ONE
// (class, cluster) from the ONE world recording; a per-cast cursor
// cycles round-robin, so the same child is heard again and again -
// one continuous kid, not a parade of strangers. Natural rate
// (ratio 1.0) always.
fn ev9(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,cast:[]u8,ncast:i64,cur:*i64,tsec:f64,gain:f64,cls:i64)void{
    if(ncast<=0){return;}
    let ai:i64=get64(cast,(cur.* % ncast)*8);
    cur.*=cur.*+1;
    let tp:f64=0.70;
    if(cls==1){tp=0.75;}
    if(cls==2){tp=0.55;}
    let start:i64=((tsec*44100.0) as i64);
    place_event_v6(mix,nsamp,wave,atab,ai,start,1.0,tp,gain,cls_refpk(cls));
}

// Footstep line: continuous running/walking through [t0, t1), gap and
// gain interpolated linearly. Real locomotion is a continuum, not
// isolated thuds - this is what makes the scene breathe as one moment.
fn run_steps(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,cast:[]u8,ncast:i64,cur:*i64,t0:f64,t1:f64,gap0:f64,gap1:f64,gn0:f64,gn1:f64)void{
    let t:f64=t0;
    while(t<t1){
        let f:f64=0.0;
        if(t1>t0){f=(t-t0)/(t1-t0);}
        let gn:f64=gn0+(gn1-gn0)*f;
        ev9(mix,nsamp,wave,atab,cast,ncast,cur,t,gn,2);
        let gp:f64=gap0+(gap1-gap0)*f;
        t=t+gp;
    }
}

// ---------- score: ONE playground moment, 30 s ----------
// Little kids in a playground, one continuous scene:
//  0.0-6.5   the yard is already alive: two kids running, calling
//  6.5-12.5  a chase game: faster feet, shouts, laughter
//  12.5-16.5 one trips: stumble steps, a thud, a gasp, a held breath
//  16.5-23   everyone laughs: the same kids, laughing it off
//  23-30     winding down: steps slow and recede, last calls, air
// The cast (all from w2, one recording): L2/L0 laughing kids,
// V0/V1/V2 calling kids, F footstep atoms. Cursors cycle so each
// voice recurs as the same child through the whole moment.
fn score_scene_v9(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,
    cL2:[]u8,nL2:i64,cL0:[]u8,nL0:i64,
    cV0:[]u8,nV0:i64,cV1:[]u8,nV1:i64,cV2:[]u8,nV2:i64,
    cF:[]u8,nF:i64)void{
    let pL2:*u8=_zag_malloc(8) as *u8; let qL2:*i64=pL2 as *i64; qL2.*=0;
    let pL0:*u8=_zag_malloc(8) as *u8; let qL0:*i64=pL0 as *i64; qL0.*=0;
    let pV0:*u8=_zag_malloc(8) as *u8; let qV0:*i64=pV0 as *i64; qV0.*=0;
    let pV1:*u8=_zag_malloc(8) as *u8; let qV1:*i64=pV1 as *i64; qV1.*=0;
    let pV2:*u8=_zag_malloc(8) as *u8; let qV2:*i64=pV2 as *i64; qV2.*=0;
    let pF:*u8=_zag_malloc(8) as *u8;  let qF:*i64=pF as *i64;  qF.*=0;
    // --- the yard is already alive (0-6.5): running feet, two kids calling
    run_steps(mix,nsamp,wave,atab,cF,nF,qF,0.2,6.5,0.30,0.30,0.80,0.80);
    ev9(mix,nsamp,wave,atab,cV0,nV0,qV0,0.8,0.95,1);
    ev9(mix,nsamp,wave,atab,cV2,nV2,qV2,1.6,0.90,1);
    ev9(mix,nsamp,wave,atab,cL2,nL2,qL2,2.6,0.85,0);
    ev9(mix,nsamp,wave,atab,cV0,nV0,qV0,3.3,0.90,1);
    ev9(mix,nsamp,wave,atab,cL2,nL2,qL2,4.3,0.85,0);
    ev9(mix,nsamp,wave,atab,cV2,nV2,qV2,5.0,0.85,1);
    ev9(mix,nsamp,wave,atab,cL0,nL0,qL0,6.0,0.80,0);
    // --- the chase (6.5-12.5): faster feet, shouts, laughter
    run_steps(mix,nsamp,wave,atab,cF,nF,qF,6.5,12.5,0.24,0.24,0.85,0.85);
    ev9(mix,nsamp,wave,atab,cV0,nV0,qV0,6.8,1.00,1);
    ev9(mix,nsamp,wave,atab,cL2,nL2,qL2,7.6,0.95,0);
    ev9(mix,nsamp,wave,atab,cV2,nV2,qV2,8.4,0.90,1);
    ev9(mix,nsamp,wave,atab,cL0,nL0,qL0,9.3,0.85,0);
    ev9(mix,nsamp,wave,atab,cL2,nL2,qL2,10.2,0.90,0);
    ev9(mix,nsamp,wave,atab,cV0,nV0,qV0,11.1,0.95,1);
    ev9(mix,nsamp,wave,atab,cL2,nL2,qL2,11.9,0.90,0);
    // --- the trip (12.5-16.5): stumble, thud, gasp, a held breath
    ev9(mix,nsamp,wave,atab,cF,nF,qF,12.80,0.90,2);
    ev9(mix,nsamp,wave,atab,cF,nF,qF,13.00,0.95,2);
    ev9(mix,nsamp,wave,atab,cF,nF,qF,13.14,1.00,2);
    ev9(mix,nsamp,wave,atab,cF,nF,qF,13.45,1.50,2); // thud
    ev9(mix,nsamp,wave,atab,cV1,nV1,qV1,13.95,0.90,1); // gasp
    ev9(mix,nsamp,wave,atab,cL2,nL2,qL2,14.6,0.90,0);
    ev9(mix,nsamp,wave,atab,cL0,nL0,qL0,15.1,0.85,0);
    ev9(mix,nsamp,wave,atab,cL2,nL2,qL2,15.7,0.90,0);
    ev9(mix,nsamp,wave,atab,cL0,nL0,qL0,16.3,0.85,0);
    // --- everyone laughs it off (16.5-23): milling feet, the same kids
    run_steps(mix,nsamp,wave,atab,cF,nF,qF,16.5,23.0,0.35,0.35,0.75,0.75);
    ev9(mix,nsamp,wave,atab,cV0,nV0,qV0,17.0,0.95,1);
    ev9(mix,nsamp,wave,atab,cL2,nL2,qL2,17.6,0.95,0);
    ev9(mix,nsamp,wave,atab,cL0,nL0,qL0,18.4,0.90,0);
    ev9(mix,nsamp,wave,atab,cL2,nL2,qL2,19.2,0.90,0);
    ev9(mix,nsamp,wave,atab,cV2,nV2,qV2,20.1,0.90,1);
    ev9(mix,nsamp,wave,atab,cL2,nL2,qL2,21.0,0.85,0);
    ev9(mix,nsamp,wave,atab,cL0,nL0,qL0,22.0,0.85,0);
    // --- winding down (23-30): steps slow and recede, last calls, air
    run_steps(mix,nsamp,wave,atab,cF,nF,qF,23.0,29.2,0.55,0.70,0.70,0.40);
    ev9(mix,nsamp,wave,atab,cV2,nV2,qV2,23.5,0.65,1);
    ev9(mix,nsamp,wave,atab,cL2,nL2,qL2,25.8,0.60,0);
    ev9(mix,nsamp,wave,atab,cV0,nV0,qV0,27.2,0.60,1);
    ev9(mix,nsamp,wave,atab,cL0,nL0,qL0,28.6,0.55,0);
    _zag_free(pL2);_zag_free(pL0);_zag_free(pV0);
    _zag_free(pV1);_zag_free(pV2);_zag_free(pF);
    print_str("kids v9: one world (w2), cast L2/L0/V0/V1/V2/F reused round-robin");
    print_nl();
}

// ---------- mastering: limit ONLY on actual clipping ----------
// v8's transparent path, kept: DC removal, FIXPEAK normalization,
// 30 ms raised ends, limiter engages only above 0.95 FS (soft knee
// to 1.0). Below that the path is transparent: zero added THD by
// construction.
fn wav_write_v9(path:[]u8,m:[]u8,nsamp:i64)i64{
    let dsum:f64=0.0;
    let s:i64=0;
    while(s<nsamp){
        dsum=dsum+((get64(m,s*8) as f64)/16777216.0);
        s=s+1;
    }
    let dc:f64=dsum/(nsamp as f64);
    let peak:i64=0;
    s=0;
    while(s<nsamp){
        let v:i64=get64(m,s*8)-((dc*16777216.0) as i64);
        if(v<0){v=-v;}
        if(v>peak){peak=v;}
        s=s+1;
    }
    print_str("mixpeak=");print_i64(peak);print_nl();
    let norm:f64=1.0;
    if(FIXPEAK>0){norm=0.891250938*16777216.0/(FIXPEAK as f64);}
    else{if(peak>0){norm=0.891250938*16777216.0/(peak as f64);}}
    let p:*u8=_zag_malloc(44+nsamp*2) as *u8;
    if(p==null as *u8){return -2;}
    let out:[]u8=p[0..(44+nsamp*2)];
    let i:i64=0;
    while(i<44+nsamp*2){out[i]=0;i=i+1;}
    out[0]=82;out[1]=73;out[2]=70;out[3]=70;
    put32(out,4,36+nsamp*2);
    out[8]=87;out[9]=65;out[10]=86;out[11]=69;
    out[12]=102;out[13]=109;out[14]=116;out[15]=32;
    put32(out,16,16);
    put16(out,20,1);put16(out,22,1);
    put32(out,24,44100);put32(out,28,88200);
    put16(out,32,2);put16(out,34,16);
    out[36]=100;out[37]=97;out[38]=116;out[39]=97;
    put32(out,40,nsamp*2);
    let fade:i64=1323; // 30 ms
    let limited:i64=0;
    s=0;
    while(s<nsamp){
        let v:i64=get64(m,s*8);
        let x:f64=((v as f64)/16777216.0-dc)*norm;
        if(s<fade){x=x*sstep((s as f64)/(fade as f64));}
        let rem:i64=nsamp-s;
        if(rem<fade){x=x*sstep((rem as f64)/(fade as f64));}
        let ax:f64=x;
        if(ax<0.0){ax=-ax;}
        if(ax>0.95){
            let ov:f64=ax-0.95;
            let lim:f64=0.95+0.05*ov/(1.0+ov);
            x=(x/ax)*lim;
            limited=limited+1;
        }
        put16(out,44+s*2,(x*32767.0) as i64);
        s=s+1;
    }
    print_str("limited_samples=");print_i64(limited);print_nl();
    let rc:i64=file_write(path,out);
    _zag_free(_zag_slice_ptr(out));
    return rc;
}

fn main()i32{
    let subj:[]u8=_zag_arg(1);
    let catp:[]u8=_zag_arg(2);
    let w2p:[]u8=_zag_arg(3);
    let outp:[]u8=_zag_arg(4);
    if(subj.len==0 || catp.len==0 || w2p.len==0 || outp.len==0){return 31;}
    let which:i64=0;
    if(_zag_strcmp(subj,"kidf")==1){which=16;}
    if(_zag_strcmp(subj,"bedo")==1){which=17;}
    if(which==0){return 32;}
    let dur_s:i64=30;
    // ---- catalog load (inlined; ZNC-WORKAROUND: loader fns miscompile
    // ---- bed() in larger binaries; bed_v9 is called directly below)
    let raw:[]u8=file_read(catp,60000000);
    if(raw.len<16){return -1;}
    if(raw[0]!=66||raw[1]!=65||raw[2]!=76||raw[3]!=50){return -2;}
    let natoms:i64=get32(raw,4);
    let ap:*u8=_zag_malloc(900*24) as *u8;
    let atab:[]u8=ap[0..(900*24)];
    let wp:*u8=_zag_malloc(32505856) as *u8;
    let wave:[]u8=wp[0..32505856];
    let pos:i64=16;
    let woff0:i64=0;
    let a:i64=0;
    while(a<natoms){
        let cls:i64=get32(raw,pos);
        let clu:i64=get32(raw,pos+4);
        let fno:i64=get32(raw,pos+8);
        let ln:i64=get32(raw,pos+12);
        put32(atab,a*24,cls);
        put32(atab,a*24+4,clu);
        put32(atab,a*24+8,ln);
        put64(atab,a*24+16,woff0);
        put32(atab,a*24+12,fno);
        let k:i64=0;
        while(k<ln){
            put16(wave,woff0+k*2,get16s(raw,pos+16+k*2));
            k=k+1;
        }
        woff0=woff0+ln*2;
        pos=pos+16+ln*2+24;
        a=a+1;
    }
    let ntex:i64=get32(raw,pos);
    pos=pos+4;
    let tp:*u8=_zag_malloc(160*16) as *u8;
    let txtab:[]u8=tp[0..(160*16)];
    let xp:*u8=_zag_malloc(12582912) as *u8;
    let txwave:[]u8=xp[0..(12582912)];
    let woff:i64=0;
    let t:i64=0;
    while(t<ntex){
        let ln:i64=get32(raw,pos);
        put32(txtab,t*16,ln);
        put64(txtab,t*16+8,woff);
        let k:i64=0;
        while(k<ln){
            put16(txwave,woff+k*2,get16s(raw,pos+4+k*2));
            k=k+1;
        }
        woff=woff+ln*2;
        pos=pos+4+ln*2;
        t=t+1;
    }
    // ---- the world: load w2.wav, take its quiet air as bed chunks ----
    let raw2:[]u8=file_read(w2p,8000000);
    if(raw2.len<44){return -3;}
    let w2:[]u8=wav_parse(raw2);
    if(w2.len<88200){return -4;}
    let ns2:i64=(w2.len as i64)/2;
    let cip:*u8=_zag_malloc(CHWANT*8) as *u8;
    let chidx:[]u8=cip[0..(CHWANT*8)];
    let wop:*u8=_zag_malloc(8) as *u8;
    let woffp:*i64=wop as *i64;
    woffp.*=woff;
    let nch:i64=w2_chunks(w2,ns2,txwave,txtab,ntex,woff,chidx,woffp);
    print_str("w2_chunks=");print_i64(nch);print_nl();
    if(nch<4){return -5;}
    _zag_free(wop);
    // ---- cast: fno==1 atoms only (one recording, one mic, one place)
    let cL2p:*u8=_zag_malloc(16*8) as *u8; let cL2:[]u8=cL2p[0..(16*8)];
    let cL0p:*u8=_zag_malloc(8*8) as *u8;  let cL0:[]u8=cL0p[0..(8*8)];
    let cV0p:*u8=_zag_malloc(8*8) as *u8;  let cV0:[]u8=cV0p[0..(8*8)];
    let cV1p:*u8=_zag_malloc(4*8) as *u8;  let cV1:[]u8=cV1p[0..(4*8)];
    let cV2p:*u8=_zag_malloc(4*8) as *u8;  let cV2:[]u8=cV2p[0..(4*8)];
    let cFp:*u8=_zag_malloc(32*8) as *u8;  let cF:[]u8=cFp[0..(32*8)];
    let nL2:i64=0; let nL0:i64=0;
    let nV0:i64=0; let nV1:i64=0; let nV2:i64=0; let nF:i64=0;
    a=0;
    while(a<natoms){
        let fno2:i64=at_get32(atab,a,12);
        if(fno2==1){
            let cl2:i64=at_get32(atab,a,0);
            let cu2:i64=at_get32(atab,a,4);
            if(cl2==0){
                if(cu2==2){put64(cL2,nL2*8,a);nL2=nL2+1;}
                if(cu2==0){put64(cL0,nL0*8,a);nL0=nL0+1;}
            }
            if(cl2==1){
                if(cu2==0){put64(cV0,nV0*8,a);nV0=nV0+1;}
                if(cu2==1){put64(cV1,nV1*8,a);nV1=nV1+1;}
                if(cu2==2){put64(cV2,nV2*8,a);nV2=nV2+1;}
            }
            if(cl2==2){put64(cF,nF*8,a);nF=nF+1;}
        }
        a=a+1;
    }
    print_str("cast L2=");print_i64(nL2);
    print_str(" L0=");print_i64(nL0);
    print_str(" V0=");print_i64(nV0);
    print_str(" V1=");print_i64(nV1);
    print_str(" V2=");print_i64(nV2);
    print_str(" F=");print_i64(nF);print_nl();
    if(nL2==0||nV0==0||nF==0){return -6;}
    // ---- render ----
    let nsamp:i64=dur_s*44100;
    let mp:*u8=_zag_malloc(nsamp*8) as *u8;
    let mix:[]u8=mp[0..(nsamp*8)];
    let z:i64=0;
    while(z<nsamp*8){mix[z]=0;z=z+1;}
    // ZNC-WORKAROUND 2026-09-22: bed_v9() called directly from main.
    bed_v9(mix,nsamp,chidx,nch,txtab,txwave,6101);
    if(which==16){
        score_scene_v9(mix,nsamp,wave,atab,
            cL2,nL2,cL0,nL0,cV0,nV0,cV1,nV1,cV2,nV2,cF,nF);
    }
    let rc:i64=wav_write_v9(outp,mix,nsamp);
    print_str("render rc=");print_i64(rc);print_nl();
    return (rc<0) as i32;
}

@import("common_v5.zag")
// Battery 1d/V4 (2026-09-23): bed rewritten from the v3 WAV trace.
// v3's bed caused Micah's "random cutouts" + "static/mouse squeaks":
// (1) short chunks were butt-jointed (step=ln) with ff=wlen/2, so each
//     faded to ZERO at its boundary — 8+ audible dropouts 18-31 dB;
// (2) texture RMS varied 129..1006 with no loudness matching — audible
//     ambience pumping between chunks;
// (3) transient-heavy textures (crest to 11.4) put clicks/squeaks in the
//     "quiet" bed (traced: tx3 @28.73s, tx6+tx7 @29.32s via exact schedule
//     correlation). Fix, all deterministic: qualify textures by waveform
//     criteria (quiet rms<600, stable crest<7.0), normalize each chunk to a
//     common target RMS, and GUARANTEE a crossfade overlap at every boundary
//     (step = wlen - xf; never butt-jointed, never fades to zero alone).
fn bed(mix:[]u8,nsamp:i64,txtab:[]u8,ntex:i64,txwave:[]u8,seed:i64,bgain:f64)void{
    if(ntex<=0){return;}
    let okp:*u8=_zag_malloc(ntex*8) as *u8;
    let ok:[]u8=okp[0..(ntex*8)];
    let nok:i64=0;
    let q:i64=0;
    while(q<ntex){
        let ln:i64=get32(txtab,q*16);
        let wo:i64=get64(txtab,q*16+8);
        let sumsq:f64=0.0;
        let pk:i64=0;
        let j:i64=0;
        while(j<ln){
            let s:i64=get16s(txwave,wo+j*2);
            sumsq=sumsq+((s as f64)*(s as f64));
            if(s<0){s=-s;}
            if(s>pk){pk=s;}
            j=j+1;
        }
        let rms:f64=fsqrt(sumsq/(ln as f64));
        let crest:f64=(pk as f64)/(rms+1.0);
        if(rms<600.0 && crest<7.0){
            put64(ok,nok*8,q);
            nok=nok+1;
        }
        q=q+1;
    }
    if(nok==0){return;}
    let t:i64=0;
    let ti:i64=(h32(seed,9001) % nok);
    let nchunks:i64=0;
    while(t<nsamp){
        let qi:i64=get64(ok,ti*8);
        let ln:i64=get32(txtab,qi*16);
        let wo:i64=get64(txtab,qi*16+8);
        let sumsq2:f64=0.0;
        let j2:i64=0;
        while(j2<ln){
            let s2:i64=get16s(txwave,wo+j2*2);
            sumsq2=sumsq2+((s2 as f64)*(s2 as f64));
            j2=j2+1;
        }
        let rms2:f64=fsqrt(sumsq2/(ln as f64));
        let norm:f64=500.0/(rms2+1.0);
        let wlen:i64=ln;
        let is_last:i64=0;
        if(t+wlen>=nsamp){wlen=nsamp-t;is_last=1;}
        let xf:i64=22050;
        if(xf>wlen/2){xf=wlen/2;}
        let j:i64=0;
        let bo:i64=t*8;
        while(j<wlen){
            let v:f64=((get16s(txwave,wo+j*2) as f64))/32768.0*bgain*norm;
            if(t>0 && j<xf){v=v*sstep((j as f64)/(xf as f64));}
            let rem:i64=wlen-j;
            if(rem<xf){v=v*sstep((rem as f64)/(xf as f64));}
            let cur:i64=get64(mix,bo);
            put64(mix,bo,cur+((v*16777216.0) as i64));
            bo=bo+8;
            j=j+1;
        }
        if(is_last==1){t=nsamp;}
        else{t=t+(wlen-xf);}
        ti=(ti+1+(h32(seed,9002+t) % 3)) % nok;
        nchunks=nchunks+1;
    }
    print_str("chunks=");print_i64(nchunks);print_nl();
}
fn at_put32(t:[]u8,a:i64,f:i64,v:i64)void{put32(t,a*ATREC+f,v);}
fn at_get32(t:[]u8,a:i64,f:i64)i64{return get32s(t,a*ATREC+f);}
fn at_put(t:[]u8,a:i64,f:i64,v:i64)void{put64(t,a*ATREC+f,v);}
fn at_get(t:[]u8,a:i64,f:i64)i64{return get64(t,a*ATREC+f);}

// load catalog.bin. Returns natoms; fills atab (caller-sized) and wave.
// Layout: hdr16, atoms[class,clust,len,i16[len],6xi32], u32 ntex,
// chunks[len,i16[len]], 16xu32 bigram, 12xi32 gaps.
fn place_event(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,ai:i64,start:i64,ratio:f64,tpeak:f64,gain:f64)void{
    let ln:i64=at_get32(atab,ai,8);
    let wo:i64=at_get(atab,ai,16);
    if(ln<64){return;}
    // DC + peak of the studied atom (analysis, then gain staging:
    // intra-atom dynamics untouched, absolute level set for the mix)
    let dsum:i64=0;
    let pk:i64=0;
    let k:i64=0;
    while(k<ln){
        let sv:i64=get16s(wave,wo+k*2);
        dsum=dsum+sv;
        if(sv<0){sv=-sv;}
        if(sv>pk){pk=sv;}
        k=k+1;
    }
    let dc:f64=(dsum as f64)/(ln as f64);
    let lvl:f64=1.0;
    if(pk>0){lvl=(tpeak*32768.0)/(pk as f64);}
    let olen:i64=((ln as f64)/ratio) as i64;
    if(olen<32){return;}
    if(start<0){return;}
    if(start+olen>nsamp){olen=nsamp-start;}
    // Battery 1c fix (2026-09-22): split edges. 8 ms attack keeps transients
    // crisp; 60 ms release guarantees no audible chop when an atom's content
    // is still loud at its edge (v2's symmetric 8 ms edges left fast fades
    // on loud atom endings — measurable as 28-33 dB drops inside 60 ms).
    let fa:i64=353; // ~8 ms attack
    if(fa>olen/4){fa=olen/4;}
    let frel:i64=2646; // ~60 ms release
    if(frel>olen/2){frel=olen/2;}
    let j:i64=0;
    while(j<olen){
        let sp:f64=(j as f64)*ratio;
        let i0:i64=(sp as i64);
        if(i0>=ln-1){i0=ln-2;}
        let fr:f64=sp-(i0 as f64);
        let s0:f64=(get16s(wave,wo+i0*2) as f64)-dc;
        let s1:f64=(get16s(wave,wo+(i0+1)*2) as f64)-dc;
        let v:f64=(s0+(s1-s0)*fr)/32768.0*lvl*gain;
        if(j<fa){v=v*sstep((j as f64)/(fa as f64));}
        let rem:i64=olen-j;
        if(rem<frel){v=v*sstep((rem as f64)/(frel as f64));}
        let cur:i64=get64(mix,(start+j)*8);
        put64(mix,(start+j)*8,cur+((v*16777216.0) as i64));
        j=j+1;
    }
}

// texture-chunk picker for the ambience bed (see bed() above).
// (Battery 1c note: the old "1 s crossfades, breathing gain" comment was
// aspirational — crossfades are now implemented in bed(); there is no
// breathing gain, and none is claimed.)
fn pick_atom(atab:[]u8,natoms:i64,cls:i64,cl:i64,seed:i64,stream:i64)i64{
    let best:i64=-1;
    let cnt:i64=0;
    // two passes: count, then select by hash
    let a:i64=0;
    while(a<natoms){
        let ok:i64=1;
        if(cls>=0 && at_get32(atab,a,0)!=cls){ok=0;}
        if(cl>=0 && at_get32(atab,a,4)!=cl){ok=0;}
        if(ok==1){cnt=cnt+1;}
        a=a+1;
    }
    if(cnt==0){
        // fallback: any atom of the class, then any atom at all
        if(cl>=0){return pick_atom(atab,natoms,cls,-1,seed,stream);}
        if(cls>=0){return pick_atom(atab,natoms,-1,-1,seed,stream);}
        return -1;
    }
    let want:i64=(h32(seed,stream) % cnt);
    a=0;
    while(a<natoms){
        let ok2:i64=1;
        if(cls>=0 && at_get32(atab,a,0)!=cls){ok2=0;}
        if(cl>=0 && at_get32(atab,a,4)!=cl){ok2=0;}
        if(ok2==1){
            if(want==0){return a;}
            want=want-1;
        }
        a=a+1;
    }
    return -1;
}

// instantiate one atom into the mix:
// linear-interp resample by ratio, DC subtraction, smoothstep edge fades,
// gain, summed into Q24 mix. start/out_len bounds-checked.
fn ev(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,natoms:i64,lastuse:[]u8,cls:i64,cl:i64,tsec:f64,ratio:f64,gain:f64,seed:i64,stm:i64,usedcl:[]u8)i64{
    let start:i64=((tsec*44100.0) as i64);
    let ai:i64=-1;
    let tr:i64=0;
    while(tr<8){
        let cand:i64=pick_atom(atab,natoms,cls,cl,seed,stm+tr*77);
        if(cand<0){tr=tr+1;}else{
            let lu:i64=get64(lastuse,cand*8);
            if(start-lu>132300){ai=cand;tr=8;}else{tr=tr+1;}
        }
    }
    if(ai<0){return -1;}
    put64(lastuse,ai*8,start);
    let tp:f64=0.70;
    if(cls==1){tp=0.75;}
    if(cls==2){tp=0.55;}
    place_event(mix,nsamp,wave,atab,ai,start,ratio,tp,gain);
    if(cls==0 || cls==1){
        let c2:i64=at_get32(atab,ai,4);
        if(c2>=0 && c2<8){put64(usedcl,c2*8,1);}
    }
    return ai;
}

// ---------- Battery 1e/V5: component-isolation helpers ----------
// The v4 crew preserved 5 harsh/squeak-like atoms as "legitimate recorded
// sounds". V5 isolates their contribution: mode 1 skips their placements
// (selection + lastuse state stay byte-identical to v4, audio not placed),
// mode 2 places the lowest-crest same-class replacement atom instead.
// Replacements (measured from catalog.bin, lowest crest per class, non-harsh):
//   ai=4 (cls1) -> ai=6 (crest 3.0); ai=23 (cls1) -> ai=25 (crest 3.3);
//   ai=103 (cls0) -> ai=89 (crest 2.9); ai=105 (cls0) -> ai=102 (crest 3.3);
//   ai=108 (cls2) -> ai=104 (crest 2.0).
fn is_harsh(ai:i64)i64{
    if(ai==4){return 1;}
    if(ai==23){return 1;}
    if(ai==103){return 1;}
    if(ai==105){return 1;}
    if(ai==108){return 1;}
    return 0;
}
fn harsh_repl(ai:i64)i64{
    if(ai==4){return 6;}
    if(ai==23){return 25;}
    if(ai==103){return 89;}
    if(ai==105){return 102;}
    if(ai==108){return 104;}
    return ai;
}
// ev() with isolation mode: 0 = identical to ev(); 1 = skip harsh
// placements; 2 = replace harsh placements with harsh_repl(ai).
fn evi(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,natoms:i64,lastuse:[]u8,cls:i64,cl:i64,tsec:f64,ratio:f64,gain:f64,seed:i64,stm:i64,usedcl:[]u8,mode:i64)i64{
    let start:i64=((tsec*44100.0) as i64);
    let ai:i64=-1;
    let tr:i64=0;
    while(tr<8){
        let cand:i64=pick_atom(atab,natoms,cls,cl,seed,stm+tr*77);
        if(cand<0){tr=tr+1;}else{
            let lu:i64=get64(lastuse,cand*8);
            if(start-lu>132300){ai=cand;tr=8;}else{tr=tr+1;}
        }
    }
    if(ai<0){return -1;}
    put64(lastuse,ai*8,start);
    let place:i64=1;
    if(mode==1 && is_harsh(ai)==1){place=0;}
    if(place==1){
        let pai:i64=ai;
        if(mode==2 && is_harsh(ai)==1){
            pai=harsh_repl(ai);
            put64(lastuse,pai*8,start);
        }
        let tp:f64=0.70;
        if(cls==1){tp=0.75;}
        if(cls==2){tp=0.55;}
        place_event(mix,nsamp,wave,atab,pai,start,ratio,tp,gain);
    }
    let mk:i64=ai;
    if(mode==2 && is_harsh(ai)==1){mk=harsh_repl(ai);}
    if(cls==0 || cls==1){
        let c2:i64=at_get32(atab,mk,4);
        if(c2>=0 && c2<8){put64(usedcl,c2*8,1);}
    }
    return ai;
}

// reserve: v2 natural-ending helper. Replicates ev()'s atom SELECTION
// (pick + 3 s lastuse guard + usedcl marking + stm-stream bookkeeping)
// but does NOT place any audio. Used for the removed late events so the
// hash-walk state (stm, lastuse) at the grammar fill is byte-identical
// to v1 for every event placed before the new cutoff — the first ~26 s
// of the v2 mix is therefore exactly the v1 mix.
fn reserve(atab:[]u8,natoms:i64,lastuse:[]u8,cls:i64,cl:i64,tsec:f64,seed:i64,stm:i64,usedcl:[]u8)i64{
    let start:i64=((tsec*44100.0) as i64);
    let ai:i64=-1;
    let tr:i64=0;
    while(tr<8){
        let cand:i64=pick_atom(atab,natoms,cls,cl,seed,stm+tr*77);
        if(cand<0){tr=tr+1;}else{
            let lu:i64=get64(lastuse,cand*8);
            if(start-lu>132300){ai=cand;tr=8;}else{tr=tr+1;}
        }
    }
    if(ai<0){return -1;}
    put64(lastuse,ai*8,start);
    if(cls==0 || cls==1){
        let c2:i64=at_get32(atab,ai,4);
        if(c2>=0 && c2<8){put64(usedcl,c2*8,1);}
    }
    return ai;
}


const ATREC:i64 = 24;
fn pick_atomf(atab:[]u8,natoms:i64,cls:i64,fno:i64,seed:i64,stream:i64)i64{
    let cnt:i64=0;
    let a:i64=0;
    while(a<natoms){
        if(at_get32(atab,a,0)==cls && (fno<0 || at_get32(atab,a,12)==fno)){cnt=cnt+1;}
        a=a+1;
    }
    if(cnt==0){return pick_atom(atab,natoms,cls,-1,seed,stream);}
    let want:i64=(h32(seed,stream) % cnt);
    a=0;
    while(a<natoms){
        if(at_get32(atab,a,0)==cls && (fno<0 || at_get32(atab,a,12)==fno)){
            if(want==0){return a;}
            want=want-1;
        }
        a=a+1;
    }
    return -1;
}

// ev with source-file filter; tpeak override (-1 = class default)
fn evf(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,natoms:i64,lastuse:[]u8,cls:i64,fno:i64,tsec:f64,ratio:f64,tpeak:f64,gain:f64,seed:i64,stm:i64,usedcl:[]u8)i64{
    let start:i64=((tsec*44100.0) as i64);
    let ai:i64=-1;
    let tr:i64=0;
    while(tr<8){
        let cand:i64=pick_atomf(atab,natoms,cls,fno,seed,stm+tr*77);
        if(cand<0){tr=tr+1;}else{
            let lu:i64=get64(lastuse,cand*8);
            if(start-lu>132300){ai=cand;tr=8;}else{tr=tr+1;}
        }
    }
    if(ai<0){return -1;}
    put64(lastuse,ai*8,start);
    let tp:f64=tpeak;
    if(tp<0.0){
        tp=0.70;
        if(cls==1){tp=0.75;}
        if(cls==2){tp=0.55;}
    }
    place_event(mix,nsamp,wave,atab,ai,start,ratio,tp,gain);
    return ai;
}

// ---------- TEST 1: kids playground (flagship) ----------
// v3 (Battery 1c, 2026-09-22): render-path correctness fix, no composition
// change. bed() now crossfades texture chunks (1 s smoothstep) and
// place_event() uses a 60 ms release fade. Same seed 6101, same catalog,
// same score as v2. Micah's ear verdict on v2 ("cuts out weirdly") traced
// to bed chunk boundaries, not the composed events.
fn score_kids_iso(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,natoms:i64,txtab:[]u8,ntex:i64,txwave:[]u8,bigram:[]u8,gapq:[]u8,mode:i64)void{
    let seed:i64=6101;
    let lup:*u8=_zag_malloc(natoms*8) as *u8;
    let lastuse:[]u8=lup[0..(natoms*8)];
    let ucp:*u8=_zag_malloc(64) as *u8;
    let usedcl:[]u8=ucp[0..64];
    let i:i64=0;
    while(i<natoms*8){lastuse[i]=0;i=i+1;}
    i=0;
    while(i<64){usedcl[i]=0;i=i+1;}
    i=0;
    while(i<natoms){put64(lastuse,i*8,-1000000000);i=i+1;}
    let stm:i64=0; // bed() called from main (ZNC-WORKAROUND)
    // --- composed beats ---
    evi(mix,nsamp,wave,atab,natoms,lastuse,1,0,0.6,1.0,0.95,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,1,1,1.15,0.97,0.9,seed,stm,usedcl,mode);stm=stm+1;
    let ft:f64=1.6;
    let fg:f64=0.30;
    let fi:i64=0;
    while(fi<6){
        evi(mix,nsamp,wave,atab,natoms,lastuse,2,-1,ft,1.02,0.8,seed,stm,usedcl,mode);stm=stm+1;
        ft=ft+fg;fg=fg*0.88;fi=fi+1;
    }
    evi(mix,nsamp,wave,atab,natoms,lastuse,0,2,2.2,1.05,0.85,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,1,0,4.5,0.96,0.95,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,0,1,5.2,1.0,0.9,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,0,2,5.35,1.03,0.9,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,0,0,5.55,0.98,0.9,seed,stm,usedcl,mode);stm=stm+1;
    ft=7.0;fg=0.24;fi=0;
    while(fi<5){
        evi(mix,nsamp,wave,atab,natoms,lastuse,2,-1,ft,1.0,0.8,seed,stm,usedcl,mode);stm=stm+1;
        ft=ft+fg;fg=fg*0.92;fi=fi+1;
    }
    evi(mix,nsamp,wave,atab,natoms,lastuse,1,1,8.0,1.0,0.95,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,0,2,9.2,1.06,0.9,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,1,0,11.0,1.0,1.0,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,0,1,12.0,1.02,0.9,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,0,2,12.25,0.97,0.9,seed,stm,usedcl,mode);stm=stm+1;
    // stumble
    evi(mix,nsamp,wave,atab,natoms,lastuse,2,-1,14.5,1.0,0.85,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,2,-1,14.7,1.05,0.85,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,2,-1,14.79,0.95,0.85,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,2,-1,15.3,0.80,1.0,seed,stm,usedcl,mode);stm=stm+1; // thud
    evi(mix,nsamp,wave,atab,natoms,lastuse,1,2,15.7,1.12,0.8,seed,stm,usedcl,mode);stm=stm+1;  // gasp
    // THE TUMBLE: laughter falling into the next, energy descending
    evi(mix,nsamp,wave,atab,natoms,lastuse,0,2,16.2,1.04,0.95,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,0,0,16.45,0.95,0.95,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,0,1,16.75,0.87,0.95,seed,stm,usedcl,mode);stm=stm+1;
    evi(mix,nsamp,wave,atab,natoms,lastuse,0,2,17.1,0.92,0.9,seed,stm,usedcl,mode);stm=stm+1;
    // rolling laughter, density decreasing
    let lt:f64=18.0;
    let lg:f64=0.6;
    let li:i64=0;
    while(li<6){
        evi(mix,nsamp,wave,atab,natoms,lastuse,0,-1,lt,0.90+0.10*h01(seed,stm),0.85,seed,stm,usedcl,mode);stm=stm+1;
        lt=lt+lg;lg=lg*1.35;li=li+1;
    }
    evi(mix,nsamp,wave,atab,natoms,lastuse,1,0,24.5,0.94,0.85,seed,stm,usedcl,mode);stm=stm+1;
    ft=25.5;fg=0.40;fi=0;
    while(fi<4){
        // v2 natural ending: the 4th footstep (~27.1s) is reserved, not
        // placed — last placed footstep starts at ~26.42s.
        if(fi<3){evi(mix,nsamp,wave,atab,natoms,lastuse,2,-1,ft,0.95,0.7,seed,stm,usedcl,mode);}
        else{reserve(atab,natoms,lastuse,2,-1,ft,seed,stm,usedcl);}
        stm=stm+1;
        ft=ft+fg;fg=fg*1.3;fi=fi+1;
    }
    // v2 natural ending: the 27.0s and 28.6s explicit events are removed
    // (their atoms are reserved so lastuse/stm state matches v1); the
    // tail is now a laugh tailing off + air resolving to the bed floor.
    // NO synthetic fade is added anywhere.
    reserve(atab,natoms,lastuse,0,2,27.0,seed,stm,usedcl);stm=stm+1;
    reserve(atab,natoms,lastuse,1,1,28.6,seed,stm,usedcl);stm=stm+1;
    // --- grammar fill: hash-walk over studied bigrams/gap quantiles ---
    let prev:i64=1;
    let cur:f64=0.2;
    let clrot:i64=0;
    while(cur<26.0){
        // next class from bigram row of prev
        let row:i64=prev*4;
        let tot:i64=0;
        let cc:i64=0;
        while(cc<4){
            tot=tot+get32(bigram,(row+cc)*4);
            cc=cc+1;
        }
        let nxt:i64=prev;
        if(tot>0){
            let r:i64=((h01(seed,stm) as f64)*(tot as f64)) as i64;
            if(r>=tot){r=tot-1;}
            cc=0;
            let acc2:i64=0;
            while(cc<4){
                acc2=acc2+get32(bigram,(row+cc)*4);
                if(r<acc2){nxt=cc;cc=4;}else{cc=cc+1;}
            }
        }else{
            nxt=(h32(seed,stm) % 3);
        }
        // gap: interpolate p10..p90 by hash
        let p10:f64=(get32s(gapq,(nxt*3)*4) as f64)/1000.0;
        let p90:f64=(get32s(gapq,(nxt*3+2)*4) as f64)/1000.0;
        if(p90<p10){p90=p10;}
        let gp:f64=p10+(p90-p10)*h01(seed,stm+1);
        cur=cur+gp*1.0;
        if(cur<26.0 && (nxt==0 || nxt==1 || nxt==2)){
            let clw:i64=-1;
            if(nxt==0 || nxt==1){clw=clrot % 3;clrot=clrot+1;}
            let ratio:f64=0.90+0.24*h01(seed,stm+2);
            let gain:f64=0.55+0.20*h01(seed,stm+3);
            evi(mix,nsamp,wave,atab,natoms,lastuse,nxt,clw,cur,ratio,gain,seed,stm+4,usedcl,mode);
        }
        stm=stm+5;
        prev=nxt;
    }
    print_str("kids: voices(clusters) used:");
    let vc:i64=0;
    while(vc<4){
        if(get64(usedcl,vc*8)==1){print_str(" ");print_i64(vc);}
        vc=vc+1;
    }
    print_nl();
}

fn score_kids(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,natoms:i64,txtab:[]u8,ntex:i64,txwave:[]u8,bigram:[]u8,gapq:[]u8)void{
    let seed:i64=6101;
    let lup:*u8=_zag_malloc(natoms*8) as *u8;
    let lastuse:[]u8=lup[0..(natoms*8)];
    let ucp:*u8=_zag_malloc(64) as *u8;
    let usedcl:[]u8=ucp[0..64];
    let i:i64=0;
    while(i<natoms*8){lastuse[i]=0;i=i+1;}
    i=0;
    while(i<64){usedcl[i]=0;i=i+1;}
    i=0;
    while(i<natoms){put64(lastuse,i*8,-1000000000);i=i+1;}
    let stm:i64=0; // bed() called from main (ZNC-WORKAROUND)
    // --- composed beats ---
    ev(mix,nsamp,wave,atab,natoms,lastuse,1,0,0.6,1.0,0.95,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,1,1,1.15,0.97,0.9,seed,stm,usedcl);stm=stm+1;
    let ft:f64=1.6;
    let fg:f64=0.30;
    let fi:i64=0;
    while(fi<6){
        ev(mix,nsamp,wave,atab,natoms,lastuse,2,-1,ft,1.02,0.8,seed,stm,usedcl);stm=stm+1;
        ft=ft+fg;fg=fg*0.88;fi=fi+1;
    }
    ev(mix,nsamp,wave,atab,natoms,lastuse,0,2,2.2,1.05,0.85,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,1,0,4.5,0.96,0.95,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,0,1,5.2,1.0,0.9,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,0,2,5.35,1.03,0.9,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,0,0,5.55,0.98,0.9,seed,stm,usedcl);stm=stm+1;
    ft=7.0;fg=0.24;fi=0;
    while(fi<5){
        ev(mix,nsamp,wave,atab,natoms,lastuse,2,-1,ft,1.0,0.8,seed,stm,usedcl);stm=stm+1;
        ft=ft+fg;fg=fg*0.92;fi=fi+1;
    }
    ev(mix,nsamp,wave,atab,natoms,lastuse,1,1,8.0,1.0,0.95,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,0,2,9.2,1.06,0.9,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,1,0,11.0,1.0,1.0,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,0,1,12.0,1.02,0.9,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,0,2,12.25,0.97,0.9,seed,stm,usedcl);stm=stm+1;
    // stumble
    ev(mix,nsamp,wave,atab,natoms,lastuse,2,-1,14.5,1.0,0.85,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,2,-1,14.7,1.05,0.85,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,2,-1,14.79,0.95,0.85,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,2,-1,15.3,0.80,1.0,seed,stm,usedcl);stm=stm+1; // thud
    ev(mix,nsamp,wave,atab,natoms,lastuse,1,2,15.7,1.12,0.8,seed,stm,usedcl);stm=stm+1;  // gasp
    // THE TUMBLE: laughter falling into the next, energy descending
    ev(mix,nsamp,wave,atab,natoms,lastuse,0,2,16.2,1.04,0.95,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,0,0,16.45,0.95,0.95,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,0,1,16.75,0.87,0.95,seed,stm,usedcl);stm=stm+1;
    ev(mix,nsamp,wave,atab,natoms,lastuse,0,2,17.1,0.92,0.9,seed,stm,usedcl);stm=stm+1;
    // rolling laughter, density decreasing
    let lt:f64=18.0;
    let lg:f64=0.6;
    let li:i64=0;
    while(li<6){
        ev(mix,nsamp,wave,atab,natoms,lastuse,0,-1,lt,0.90+0.10*h01(seed,stm),0.85,seed,stm,usedcl);stm=stm+1;
        lt=lt+lg;lg=lg*1.35;li=li+1;
    }
    ev(mix,nsamp,wave,atab,natoms,lastuse,1,0,24.5,0.94,0.85,seed,stm,usedcl);stm=stm+1;
    ft=25.5;fg=0.40;fi=0;
    while(fi<4){
        // v2 natural ending: the 4th footstep (~27.1s) is reserved, not
        // placed — last placed footstep starts at ~26.42s.
        if(fi<3){ev(mix,nsamp,wave,atab,natoms,lastuse,2,-1,ft,0.95,0.7,seed,stm,usedcl);}
        else{reserve(atab,natoms,lastuse,2,-1,ft,seed,stm,usedcl);}
        stm=stm+1;
        ft=ft+fg;fg=fg*1.3;fi=fi+1;
    }
    // v2 natural ending: the 27.0s and 28.6s explicit events are removed
    // (their atoms are reserved so lastuse/stm state matches v1); the
    // tail is now a laugh tailing off + air resolving to the bed floor.
    // NO synthetic fade is added anywhere.
    reserve(atab,natoms,lastuse,0,2,27.0,seed,stm,usedcl);stm=stm+1;
    reserve(atab,natoms,lastuse,1,1,28.6,seed,stm,usedcl);stm=stm+1;
    // --- grammar fill: hash-walk over studied bigrams/gap quantiles ---
    let prev:i64=1;
    let cur:f64=0.2;
    let clrot:i64=0;
    while(cur<26.0){
        // next class from bigram row of prev
        let row:i64=prev*4;
        let tot:i64=0;
        let cc:i64=0;
        while(cc<4){
            tot=tot+get32(bigram,(row+cc)*4);
            cc=cc+1;
        }
        let nxt:i64=prev;
        if(tot>0){
            let r:i64=((h01(seed,stm) as f64)*(tot as f64)) as i64;
            if(r>=tot){r=tot-1;}
            cc=0;
            let acc2:i64=0;
            while(cc<4){
                acc2=acc2+get32(bigram,(row+cc)*4);
                if(r<acc2){nxt=cc;cc=4;}else{cc=cc+1;}
            }
        }else{
            nxt=(h32(seed,stm) % 3);
        }
        // gap: interpolate p10..p90 by hash
        let p10:f64=(get32s(gapq,(nxt*3)*4) as f64)/1000.0;
        let p90:f64=(get32s(gapq,(nxt*3+2)*4) as f64)/1000.0;
        if(p90<p10){p90=p10;}
        let gp:f64=p10+(p90-p10)*h01(seed,stm+1);
        cur=cur+gp*1.0;
        if(cur<26.0 && (nxt==0 || nxt==1 || nxt==2)){
            let clw:i64=-1;
            if(nxt==0 || nxt==1){clw=clrot % 3;clrot=clrot+1;}
            let ratio:f64=0.90+0.24*h01(seed,stm+2);
            let gain:f64=0.55+0.20*h01(seed,stm+3);
            ev(mix,nsamp,wave,atab,natoms,lastuse,nxt,clw,cur,ratio,gain,seed,stm+4,usedcl);
        }
        stm=stm+5;
        prev=nxt;
    }
    print_str("kids: voices(clusters) used:");
    let vc:i64=0;
    while(vc<4){
        if(get64(usedcl,vc*8)==1){print_str(" ");print_i64(vc);}
        vc=vc+1;
    }
    print_nl();
}

// ---------- TEST 2: Kethra's planet voice, rebuilt from scratch ----------
// Constructed-mode deliberation: a deep argon/nitrogen world. The planet
// breathes — slow tidal pressure swells (class-1 sustained atoms,
// stretched to half speed). Rift vents exhale (short-bursty). Cryo cracks
// snap in the ice fields (bursty, sparse, pitched up). Deep thunder rolls
// (thumpy, slowed). And the "voice": sustained atoms arranged as
// call-and-response phrases between vent fields — the planet speaking,
// not a synth pad. 21 s to match d_aud3_planetvoice_v2.wav for the A/B.
fn score_planet(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,natoms:i64,txtab:[]u8,ntex:i64,txwave:[]u8,bigram:[]u8,gapq:[]u8)void{
    let seed:i64=6201;
    let lup:*u8=_zag_malloc(natoms*8) as *u8;
    let lastuse:[]u8=lup[0..(natoms*8)];
    let ucp:*u8=_zag_malloc(64) as *u8;
    let usedcl:[]u8=ucp[0..64];
    let i:i64=0;
    while(i<natoms){put64(lastuse,i*8,-1000000000);i=i+1;}
    // bed() called from main (ZNC-WORKAROUND)
    let stm:i64=0;
    // tidal breaths
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,-1,0.5,0.55,0.85,0.9,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,-1,4.5,0.62,0.85,0.9,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,-1,9.0,0.50,0.85,0.95,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,-1,14.0,0.58,0.85,0.9,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,-1,18.0,0.52,0.85,0.9,seed,stm,usedcl);stm=stm+1;
    // thunder rolls under the breaths
    evf(mix,nsamp,wave,atab,natoms,lastuse,2,-1,2.0,0.65,0.70,1.0,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,2,-1,14.2,0.60,0.70,1.0,seed,stm,usedcl);stm=stm+1;
    // rift vent exhales
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,-1,5.0,0.85,0.60,0.8,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,-1,5.6,0.90,0.60,0.8,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,-1,11.5,0.82,0.60,0.8,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,-1,16.5,0.88,0.60,0.8,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,-1,19.5,0.85,0.60,0.8,seed,stm,usedcl);stm=stm+1;
    // cryo crack field: sparse, snappy
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,2,7.0,1.10,0.55,0.7,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,2,10.5,1.12,0.55,0.7,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,2,13.2,1.08,0.55,0.7,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,2,17.8,1.10,0.55,0.7,seed,stm,usedcl);stm=stm+1;
    // the voice: call-and-response phrases
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,-1,6.0,0.70,0.80,0.95,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,-1,6.9,0.75,0.80,0.95,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,-1,7.6,0.95,0.55,0.7,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,-1,12.0,0.68,0.80,0.95,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,-1,12.9,0.72,0.80,0.95,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,-1,13.8,0.66,0.80,0.95,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,-1,12.4,0.90,0.55,0.7,seed,stm,usedcl);stm=stm+1;
    // sparse grammar fill, low gain
    let prev:i64=1;
    let cur:f64=0.3;
    while(cur<20.5){
        let nxt:i64=(h32(seed,stm) % 3);
        let p10:f64=(get32s(gapq,(nxt*3)*4) as f64)/1000.0;
        let p90:f64=(get32s(gapq,(nxt*3+2)*4) as f64)/1000.0;
        if(p90<p10){p90=p10;}
        let gp:f64=p10+(p90-p10)*h01(seed,stm+1);
        cur=cur+gp*2.0;
        if(cur<20.5){
            let ratio:f64=0.60+0.30*h01(seed,stm+2);
            evf(mix,nsamp,wave,atab,natoms,lastuse,nxt,-1,cur,ratio,-1.0,0.40,seed,stm+3,usedcl);
        }
        stm=stm+4;
        prev=nxt;
    }
    print_str("planet rendered");print_nl();
}

// ---------- TEST 3: an alien ocean's surf at dawn, under a sky that hums ----------
// Constructed-mode deliberation: this world has TWO skies — the sea below
// and a humming sky above. The surf is studied Earth ocean (o1/o2),
// arranged in dawn wave-sets: three waves, a pause, four waves building,
// a bright climax, then settling. The sky hum is studied HUMAN THROAT
// SINGING (o3) — a real sustained voiced drone — rearranged sparsely
// with long overlaps so it reads as atmosphere, not a singer. Deep
// whale calls (o4) pass twice like alien sea creatures. Dawn arc: the
// hum swells 0.3 -> 0.6 -> 0.4 as the light comes up. 30 s.
fn score_ocean(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,natoms:i64,txtab:[]u8,ntex:i64,txwave:[]u8,bigram:[]u8,gapq:[]u8)void{
    let seed:i64=6301;
    let lup:*u8=_zag_malloc(natoms*8) as *u8;
    let lastuse:[]u8=lup[0..(natoms*8)];
    let ucp:*u8=_zag_malloc(64) as *u8;
    let usedcl:[]u8=ucp[0..64];
    let i:i64=0;
    while(i<natoms){put64(lastuse,i*8,-1000000000);i=i+1;}
    // bed() called from main (ZNC-WORKAROUND)
    let stm:i64=0;
    // dawn wave sets (surf atoms from o1=0/o2=1, class 1 sustained)
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,1.0,0.95,0.80,0.85,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,3.2,1.00,0.80,0.85,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,1,5.4,0.92,0.80,0.90,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,10.0,0.95,0.85,0.90,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,12.1,1.02,0.85,0.90,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,14.0,0.98,0.85,0.95,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,1,16.2,0.95,0.85,0.95,seed,stm,usedcl);stm=stm+1;
    // bright climax
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,19.5,1.05,0.90,1.00,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,20.8,1.00,0.90,1.00,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,22.0,1.03,0.90,1.00,seed,stm,usedcl);stm=stm+1;
    // settling
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,1,25.0,0.92,0.80,0.85,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,27.5,0.90,0.80,0.80,seed,stm,usedcl);stm=stm+1;
    // the sky hum: throat-singing atoms (o3 = file 2), long overlaps,
    // slow ratio drift, dawn swell arc
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,2,0.0,0.95,0.35,0.30,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,2,4.0,0.98,0.35,0.38,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,2,8.5,1.00,0.35,0.50,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,2,13.0,0.97,0.35,0.60,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,2,17.5,1.02,0.35,0.55,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,2,22.5,0.96,0.35,0.42,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,2,26.5,0.94,0.35,0.35,seed,stm,usedcl);stm=stm+1;
    // deep ones pass twice (whale atoms, o4 = file 3)
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,3,8.0,0.85,0.70,0.70,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,3,23.5,0.90,0.60,0.65,seed,stm,usedcl);stm=stm+1;
    // sparse grammar fill from surf classes
    let cur:f64=0.5;
    while(cur<29.0){
        let nxt:i64=(h32(seed,stm) % 3);
        let p10:f64=(get32s(gapq,(nxt*3)*4) as f64)/1000.0;
        let p90:f64=(get32s(gapq,(nxt*3+2)*4) as f64)/1000.0;
        if(p90<p10){p90=p10;}
        let gp:f64=p10+(p90-p10)*h01(seed,stm+1);
        cur=cur+gp*1.2;
        if(cur<29.0){
            let ratio:f64=0.88+0.20*h01(seed,stm+2);
            evf(mix,nsamp,wave,atab,natoms,lastuse,nxt,0,cur,ratio,-1.0,0.45,seed,stm+3,usedcl);
        }
        stm=stm+4;
    }
    print_str("ocean rendered");print_nl();
}


// ---------- TEST 3 (VALID): alien ocean's surf at dawn, sky hums ----------
// NO direct study referent: built ONLY from Mars wind/dust-devil/storm/ice
// (catalog2). The surf is wind arranged as dawn wave-sets; the sky hum is
// wind slowed and overlapped; deep storm rolls pass as alien sea creatures.
// If this fails Micah's ear test, the claim renames to "study per scene".
fn score_alien(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,natoms:i64,txtab:[]u8,ntex:i64,txwave:[]u8,bigram:[]u8,gapq:[]u8)void{
    let seed:i64=6301;
    let lup:*u8=_zag_malloc(natoms*8) as *u8;
    let lastuse:[]u8=lup[0..(natoms*8)];
    let ucp:*u8=_zag_malloc(64) as *u8;
    let usedcl:[]u8=ucp[0..64];
    let i:i64=0;
    while(i<natoms){put64(lastuse,i*8,-1000000000);i=i+1;}
    let stm:i64=0;
    // dawn wave sets from WIND (files 0/1), class 1 sustained
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,1.0,0.95,0.80,0.85,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,3.2,1.00,0.80,0.85,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,1,5.4,0.92,0.80,0.90,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,10.0,0.95,0.85,0.90,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,12.1,1.02,0.85,0.90,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,14.0,0.98,0.85,0.95,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,1,16.2,0.95,0.85,0.95,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,19.5,1.05,0.90,1.00,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,20.8,1.00,0.90,1.00,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,22.0,1.03,0.90,1.00,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,1,25.0,0.92,0.80,0.85,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,27.5,0.90,0.80,0.80,seed,stm,usedcl);stm=stm+1;
    // sky hum: wind (file 0), slowed, long overlaps, dawn swell
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,0.0,0.55,0.35,0.30,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,4.0,0.58,0.35,0.38,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,8.5,0.60,0.35,0.50,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,13.0,0.57,0.35,0.60,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,17.5,0.62,0.35,0.55,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,22.5,0.56,0.35,0.42,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,0,26.5,0.54,0.35,0.35,seed,stm,usedcl);stm=stm+1;
    // deep alien ones: storm (file 3)
    evf(mix,nsamp,wave,atab,natoms,lastuse,1,3,8.0,0.65,0.70,0.70,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,2,3,23.5,0.70,0.60,0.65,seed,stm,usedcl);stm=stm+1;
    // ice glints: sparse, high
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,2,6.0,1.10,0.50,0.40,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,2,15.0,1.12,0.50,0.40,seed,stm,usedcl);stm=stm+1;
    evf(mix,nsamp,wave,atab,natoms,lastuse,0,2,24.0,1.08,0.50,0.40,seed,stm,usedcl);stm=stm+1;
    print_str("alien rendered (no ocean referent)");print_nl();
}

fn main()i32{
    let subj:[]u8=_zag_arg(1);
    let catp:[]u8=_zag_arg(2);
    let outp:[]u8=_zag_arg(3);
    if(subj.len==0 || catp.len==0 || outp.len==0){return 31;}
    let which:i64=0;
    if(_zag_strcmp(subj,"kids")==1){which=1;}
    if(_zag_strcmp(subj,"kida")==1){which=11;}
    if(_zag_strcmp(subj,"kidb")==1){which=12;}
    if(_zag_strcmp(subj,"kidc")==1){which=13;}
    if(_zag_strcmp(subj,"kidd")==1){which=14;}
    if(_zag_strcmp(subj,"kide")==1){which=15;}
    if(_zag_strcmp(subj,"planet")==1){which=2;}
    if(_zag_strcmp(subj,"ocean")==1){which=3;}
    if(_zag_strcmp(subj,"alien")==1){which=4;}
    if(which==0){return 32;}
    let dur_s:i64=30;
    if(which==2){dur_s=21;}
    // ---- catalog load (inlined; ZNC-WORKAROUND: separate loader fns
    // ---- miscompile bed() in larger binaries) ----
    let raw:[]u8=file_read(catp,60000000);
    if(raw.len<16){return -1;}
    if(raw[0]!=66||raw[1]!=65||raw[2]!=76||raw[3]!=50){return -2;}
    let natoms:i64=get32(raw,4);
    let ap:*u8=_zag_malloc(900*24) as *u8;
    let atab:[]u8=ap[0..(900*24)];
    let wp:*u8=_zag_malloc(32505856) as *u8;
    let wave:[]u8=wp[0..32505856];
    let pos:i64=16;
    let woff0:i64=0;
    let a:i64=0;
    while(a<natoms){
        let cls:i64=get32(raw,pos);
        let clu:i64=get32(raw,pos+4);
        let fno:i64=get32(raw,pos+8);
        let ln:i64=get32(raw,pos+12);
        put32(atab,a*24,cls);
        put32(atab,a*24+4,clu);
        put32(atab,a*24+8,ln);
        put64(atab,a*24+16,woff0);
        put32(atab,a*24+12,fno);
        let k:i64=0;
        while(k<ln){
            put16(wave,woff0+k*2,get16s(raw,pos+16+k*2));
            k=k+1;
        }
        woff0=woff0+ln*2;
        pos=pos+16+ln*2+24;
        a=a+1;
    }
    let ntex:i64=get32(raw,pos);
    pos=pos+4;
    let tp:*u8=_zag_malloc(160*16) as *u8;
    let txtab:[]u8=tp[0..(160*16)];
    let xp:*u8=_zag_malloc(12582912) as *u8;
    let txwave:[]u8=xp[0..12582912]; // 12MB: catalog2 textures total 10.6MB
    let woff:i64=0;
    let t:i64=0;
    while(t<ntex){
        let ln:i64=get32(raw,pos);
        put32(txtab,t*16,ln);
        put64(txtab,t*16+8,woff);
        let k:i64=0;
        while(k<ln){
            put16(txwave,woff+k*2,get16s(raw,pos+4+k*2));
            k=k+1;
        }
        woff=woff+ln*2;
        pos=pos+4+ln*2;
        t=t+1;
    }
    let bp:*u8=_zag_malloc(64) as *u8;
    let bigram:[]u8=bp[0..64];
    let gqp:*u8=_zag_malloc(48) as *u8;
    let gapq:[]u8=gqp[0..48];
    let b2:i64=0;
    while(b2<16){
        put32(bigram,b2*4,get32(raw,pos+b2*4));
        b2=b2+1;
    }
    pos=pos+64;
    let c:i64=0;
    while(c<12){
        put32(gapq,c*4,get32s(raw,pos+c*4));
        c=c+1;
    }
    // ---- render ----
    let nsamp:i64=dur_s*44100;
    let mp:*u8=_zag_malloc(nsamp*8) as *u8;
    let mix:[]u8=mp[0..(nsamp*8)];
    let z:i64=0;
    while(z<nsamp*8){mix[z]=0;z=z+1;}
    // ZNC-WORKAROUND 2026-09-22: bed() must be called directly from main;
    // routing through score_*() miscompiles its inner loop (valid index
    // panics "slice index out of bounds"; minimal reproducer confirmed).
    let bg:f64=0.55;
    if(which==2){bg=0.50;}
    if(which==3){bg=0.60;}
    if(which==4){bg=0.60;}
    // Battery 1e/V5: component isolation. kida = bed only; kidb = events
    // only; kidc = full mix (v4 replica); kidd = mix minus harsh atoms;
    // kide = mix with harsh atoms replaced.
    if(which!=12){bed(mix,nsamp,txtab,ntex,txwave,6101,bg);}
    if(which==1){score_kids(mix,nsamp,wave,atab,natoms,txtab,ntex,txwave,bigram,gapq);}
    if(which==12){score_kids_iso(mix,nsamp,wave,atab,natoms,txtab,ntex,txwave,bigram,gapq,0);}
    if(which==13){score_kids_iso(mix,nsamp,wave,atab,natoms,txtab,ntex,txwave,bigram,gapq,0);}
    if(which==14){score_kids_iso(mix,nsamp,wave,atab,natoms,txtab,ntex,txwave,bigram,gapq,1);}
    if(which==15){score_kids_iso(mix,nsamp,wave,atab,natoms,txtab,ntex,txwave,bigram,gapq,2);}
    if(which==2){score_planet(mix,nsamp,wave,atab,natoms,txtab,ntex,txwave,bigram,gapq);}
    if(which==3){score_ocean(mix,nsamp,wave,atab,natoms,txtab,ntex,txwave,bigram,gapq);}
    if(which==4){score_alien(mix,nsamp,wave,atab,natoms,txtab,ntex,txwave,bigram,gapq);}
    let rc:i64=wav_write(outp,mix,nsamp);
    print_str("render rc=");print_i64(rc);print_nl();
    return (rc<0) as i32;
}

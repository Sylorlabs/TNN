@import("common.zag")
// ============================================================
// render_v11_repair.zag — Fork R (REPAIRED ARTIC), AUDIO V11.
// Repair of V10 ARTIC's execution (not a rebuild of the paradigm).
//
// White-box findings (probe P1-P4, 2026-09-23):
// - P1/P2: the parallel 2-pole resonator bank produces the programmed
//   formants correctly (peaks at 963/2613/3982/6033 Hz for programmed
//   1000/2600/3900/6000). The formants did NOT die in the resonators.
// - P4: V10-level aspiration (gain ~2.0) -> 0 clean voice frames.
//   The aspiration noise (~5.6x the glottal pulse) is the killer.
// - P3: tamed aspiration (0.03) -> 330 clean frames, HNR 12.1 dB.
//   Architecture confirmed sound; the failure was parametric.
//
// Repairs vs V10:
//  R1 F0 bases 590/630/680/720 Hz (was 270/300/340/420): V10's F0 failed
//     the instrument ZCR screen and sat below the V-F0 bar (591-711).
//  R2 Child-scaled formants F1 800-1100 / F2 2200-3000 / F3 3500-4500 /
//     F4 5600-7000, bandwidths 1.5-2x wider (200/320/450/650)
//     (was adult 644-875/1656-2250/2576-3500/3680-5000, BW 90-205).
//  R3 Aspiration gain ~0.6 (was ~2.0 effective): targets HNR 3.2-4.2 dB.
//  R4 Glottal pulse: V10 differentiated shape + polynomial sharpening
//     (targets radiated TILT ~+0.9 dB/oct; V10 shape alone gave 0.0).
//  R5 Syllabic AM on ALL voices (4-6 Hz, ~45% depth): V10 had none on
//     modal voices (0 detected syllables) -> MOD4 target 0.25-0.57.
//  R6 Per-cycle F0 jitter ~1.8% (child motor immaturity).
//  R7 Near-voice distance LP 0.95 (was 0.55, which cut F4/brightness).
//  R8 Episodic scene: quieter bed, loud events pop >1 dB over median
//     (V10's dense scene raised the median; nothing passed the screen).
//
// Kept from V10: continuous state, C1/C2 control, phase-integrated
// glottal pulses, parallel formant resonators, 4-kid scene
// (yard -> chase -> shared laughter -> wind-down), contact-oscillator
// footsteps, wind/distant-play/reflections/swing creak.
// 44.1 kHz mono 16-bit, 30 s, pure Zag, zero RNG, byte-identical reruns.
// ============================================================

const SRF:f64 = 44100.0;
const DT:f64 = 0.000022675736961451248;
const TWOPI:f64 = 6.283185307179586;

// ---- tunables (repair knobs) ----
const ASP_GAIN:f64 = 0.10;   // aspiration level (R3)
const SHARP:f64 = 0.35;      // glottal pulse sharpening (R4)
const JIT:f64 = 0.018;       // per-cycle F0 jitter (R6)

fn fsinr(x:f64)f64{
    let twopi:f64=6.283185307179586;
    let q:f64=x/twopi;
    let qi:i64=(q as i64);
    if(q<0.0){
        if((qi as f64)!=q){qi=qi-1;}
    }
    let r:f64=x-(qi as f64)*twopi;
    if(r>3.141592653589793){r=r-twopi;}
    let s:f64=1.0;
    if(r>1.5707963267948966){
        r=3.141592653589793-r;
    }else{
        if(r<-1.5707963267948966){r=-3.141592653589793-r;s=-1.0;}
    }
    let x2:f64=r*r;
    let x4:f64=x2*x2;
    return s*(r-r*x2/6.0+r*x4/120.0-r*x4*x2/5040.0+r*x4*x4/362880.0);
}
fn fcosr(x:f64)f64{
    return fsinr(x+1.5707963267948966);
}
fn fexp(x:f64)f64{
    return 1.0+x+x*x/2.0+x*x*x/6.0;
}
fn smoother(x:f64)f64{
    if(x<=0.0){return 0.0;}
    if(x>=1.0){return 1.0;}
    return x*x*x*(10.0-15.0*x+6.0*x*x);
}
fn bump(t:f64,t0:f64,t1:f64,atk:f64,rel:f64)f64{
    if(t<=t0){return 0.0;}
    if(t>=t1){return 0.0;}
    let a:f64=smoother((t-t0)/atk);
    let r:f64=smoother((t1-t)/rel);
    if(a<r){return a;}
    return r;
}
fn hw(seed:i64,t:f64,iv:f64)f64{
    let q:f64=t/iv;
    let k:i64=(q as i64);
    let f:f64=q-(k as f64);
    let v0:f64=h01(seed,k);
    let v1:f64=h01(seed,k+1);
    return v0+(v1-v0)*smoother(f);
}
fn lp1(x:f64,a:f64,s:*f64)f64{
    s.*=s.*+a*(x-s.*);
    return s.*;
}
fn reso(x:f64,c1:f64,c2:f64,gg:f64,y1:*f64,y2:*f64)f64{
    let y:f64=gg*x+c1*y1.*-c2*y2.*;
    y2.*=y1.*;
    y1.*=y;
    return y;
}
fn rcoef(f:f64,bw:f64,gs:f64,c1:*f64,c2:*f64,gg:*f64)void{
    let w:f64=6.283185307179586*f/44100.0;
    let r:f64=fexp(-3.141592653589793*bw/44100.0);
    c1.*=2.0*r*fcosr(w);
    c2.*=r*r;
    gg.*=gs*2.0*(1.0-r)*fsinr(w);
    return;
}
// Sharpened differentiated glottal pulse (R4).
// Base: V10's sin(2πu) windowed shape (zero mean, ~0 dB/oct radiated).
// Sharpening g*(1+SHARP*g^2) peaks the waveform -> brighter tilt.
fn glottal(p01:f64,oq:f64)f64{
    if(p01>=oq){return 0.0;}
    let u:f64=p01/oq;
    let w:f64=smoother(u/0.12)*(1.0-smoother((u-0.88)/0.12));
    let g:f64=fsinr(6.283185307179586*u)*w;
    return g*(1.0+SHARP*g*g);
}

// ---------- per-voice scene control (all C1 via bump/hw) ----------
// outs: gain, f0 multiplier, mouth openness, breath, laugh amount,
//       syllable rate, distance 0(near)..1(far)
fn k0ctl(t:f64,vg:*f64,f0m:*f64,mouth:*f64,breath:*f64,laugh:*f64,sylR:*f64,dist:*f64)void{
    let yard:f64=bump(t,0.4,5.2,0.3,0.6);
    let chase:f64=bump(t,6.0,13.2,0.5,0.6);
    let yelp:f64=bump(t,13.85,14.7,0.08,0.4);
    let lg:f64=bump(t,15.7,23.6,0.4,0.9);
    let lull:f64=bump(t,24.4,28.6,0.6,1.0);
    // R8: episodic — distinct loud events over a quieter bed
    vg.*=0.30*yard+0.55*chase+0.85*yelp+0.42*lg+0.30*lull;
    vg.*=vg.* *(0.35+1.25*hw(621,t,1.2));
    f0m.*=1.0+0.10*yard+0.06*chase-0.10*lull+0.10*yelp;
    mouth.*=0.45+0.30*yard*hw(11,t,0.8)+0.35*chase+0.45*yelp+0.20*lg;
    breath.*=0.30+0.30*chase+0.40*yelp+0.80*lg;
    laugh.*=lg;
    sylR.*=5.2*(0.70+0.60*hw(12,t,0.7));
    dist.*=0.0;
    return;
}
fn k1ctl(t:f64,vg:*f64,f0m:*f64,mouth:*f64,breath:*f64,laugh:*f64,sylR:*f64,dist:*f64)void{
    let far:f64=bump(t,0.8,5.4,0.4,0.7);
    let chase:f64=bump(t,6.0,13.4,0.5,0.6);
    let lg:f64=bump(t,15.8,23.7,0.4,0.9);
    let lull:f64=bump(t,24.6,28.2,0.6,1.0);
    let near:f64=bump(t,6.0,10.0,2.0,1.0);
    let worried:f64=bump(t,14.2,15.6,0.3,0.4);
    vg.*=0.22*far+0.50*chase+0.40*lg+0.28*lull+0.55*worried;
    vg.*=vg.* *(0.35+1.25*hw(622,t,1.0));
    f0m.*=1.0+0.06*far+0.05*chase-0.08*lull+0.08*worried;
    mouth.*=0.50+0.30*far*hw(21,t,0.9)+0.30*chase+0.15*lg;
    breath.*=0.32+0.30*chase+0.80*lg;
    laugh.*=lg;
    sylR.*=4.6*(0.70+0.60*hw(22,t,0.8));
    dist.*=far*(1.0-near);
    return;
}
fn k2ctl(t:f64,vg:*f64,f0m:*f64,mouth:*f64,breath:*f64,laugh:*f64,sylR:*f64,dist:*f64)void{
    let gig1:f64=bump(t,2.0,5.0,0.3,0.5);
    let gig2:f64=bump(t,7.0,13.0,0.4,0.6);
    let lg:f64=bump(t,16.0,23.5,0.4,0.9);
    let lull:f64=bump(t,25.0,29.0,0.6,1.0);
    vg.*=0.35*gig1+0.50*gig2+0.42*lg+0.30*lull;
    vg.*=vg.* *(0.35+1.25*hw(623,t,1.4));
    let lala:f64=0.08*fsinr(TWOPI*1.1*t+1.0)*lull;
    f0m.*=1.0+0.04*gig1-0.06*lull+lala;
    mouth.*=0.55+0.18*lg+0.12*lull;
    breath.*=0.35+0.45*(gig1+gig2)+0.80*lg;
    let lz:f64=0.7*gig1+0.6*gig2+lg;
    if(lz>1.0){lz=1.0;}
    laugh.*=lz;
    sylR.*=5.8*(0.70+0.60*hw(32,t,0.6));
    dist.*=0.15;
    return;
}
fn k3ctl(t:f64,vg:*f64,f0m:*f64,mouth:*f64,breath:*f64,laugh:*f64,sylR:*f64,dist:*f64)void{
    let call:f64=bump(t,6.5,12.5,0.5,0.7);
    let ch:f64=bump(t,16.2,23.0,0.5,1.0);
    let lull:f64=bump(t,25.0,28.5,0.6,1.0);
    vg.*=0.60*call+0.35*ch+0.28*lull;
    vg.*=vg.* *(0.35+1.25*hw(624,t,1.1));
    f0m.*=1.0+0.08*call-0.06*lull;
    mouth.*=0.50+0.30*call+0.12*ch;
    breath.*=0.32+0.30*call+0.70*ch;
    laugh.*=0.8*ch;
    sylR.*=3.4*(0.70+0.60*hw(42,t,0.9));
    dist.*=0.35;
    return;
}

// ---------- footstep scene control ----------
fn s0ctl(t:f64,rate:*f64,force:*f64)void{
    let w1:f64=bump(t,0.3,5.5,0.5,0.8);
    let ch:f64=bump(t,6.0,13.4,0.8,0.8);
    let hop:f64=bump(t,15.9,23.4,0.5,0.8);
    let w2:f64=bump(t,24.5,28.6,0.8,1.0);
    // irregular: deep rate wander + intermittent pauses (breaks 2-8 Hz periodicity)
    let irr:f64=(0.50+1.00*hw(301,t,0.35))*(0.25+0.75*smoother(hw(305,t,1.1)*1.6-0.3));
    rate.*=((1.8)*w1+(2.4)*ch+2.8*hop+(1.5)*w2)*irr;
    force.*=0.55+0.25*ch+0.5*bump(t,13.9,14.4,0.1,0.3)+0.2*hop;
    return;
}
fn s1ctl(t:f64,rate:*f64,force:*f64)void{
    let w1:f64=bump(t,0.8,5.5,0.5,0.8);
    let ch:f64=bump(t,6.0,13.4,0.8,0.8);
    let hop:f64=bump(t,16.0,23.5,0.5,0.8);
    let w2:f64=bump(t,24.5,28.0,0.8,1.0);
    rate.*=((1.6)*w1+(2.6)*ch+3.0*hop+(1.4)*w2)*(0.50+1.00*hw(311,t,0.35))*(0.25+0.75*smoother(hw(315,t,1.1)*1.6-0.3));
    force.*=0.45+0.3*ch+0.2*hop;
    return;
}
fn s2ctl(t:f64,rate:*f64,force:*f64)void{
    let a:f64=bump(t,2.0,5.0,0.4,0.6);
    let b:f64=bump(t,7.0,13.0,0.5,0.7);
    let hop:f64=bump(t,16.0,23.4,0.5,0.8);
    let w2:f64=bump(t,25.0,28.6,0.7,0.9);
    rate.*=((2.0)*a+1.5*b+3.2*hop+(1.6)*w2)*(0.50+1.00*hw(321,t,0.35))*(0.25+0.75*smoother(hw(325,t,1.1)*1.6-0.3));
    force.*=0.38+0.2*hop;
    return;
}
fn s3ctl(t:f64,rate:*f64,force:*f64)void{
    let a:f64=bump(t,6.5,12.5,0.5,0.7);
    let w2:f64=bump(t,25.0,28.5,0.7,0.9);
    rate.*=((1.9)*a+(1.5)*w2)*(0.50+1.00*hw(331,t,0.35))*(0.25+0.75*smoother(hw(335,t,1.1)*1.6-0.3));
    force.*=0.5;
    return;
}

fn sceneE(t:f64)f64{
    let e:f64=0.22*bump(t,0.0,6.0,0.5,1.0)
        +0.55*bump(t,6.0,13.5,1.0,1.0)
        +0.35*bump(t,13.5,15.6,0.4,0.6)
        +0.75*bump(t,15.6,23.8,0.8,1.2)
        +0.16*bump(t,23.8,30.0,1.0,1.5);
    if(e>0.85){e=0.85;}
    return e;
}

// ---------- one voice, one sample ----------
// R6: per-cycle jitter via jseed/jcyc (cycle counter); R5: syllabic AM
// on all voices; R3: tamed aspiration; R7: mild distance LP.
fn vtick(n:i64,f0:f64,oq:f64,breath:f64,vg:f64,laugh:f64,sylF:f64,
         c1a:f64,c2a:f64,gga:f64,c1b:f64,c2b:f64,ggb:f64,
         c1c:f64,c2c:f64,ggc:f64,c1d:f64,c2d:f64,ggd:f64,
         dlpA:f64,seed:i64,jseed:i64,
         ph:*f64,aspS:*f64,dS:*f64,jcyc:*f64,jitf:*f64,
         y1a:*f64,y2a:*f64,y1b:*f64,y2b:*f64,
         y1c:*f64,y2c:*f64,y1d:*f64,y2d:*f64)f64{
    // per-cycle jitter: new deterministic perturbation each glottal cycle
    // (detected via phase wrap; applied to the following cycle).
    let inc:f64=6.283185307179586*f0*jitf.*/44100.0;
    let nph:f64=ph.*+inc;
    if(nph>=6.283185307179586){
        nph=nph-6.283185307179586;
        jcyc.*=jcyc.*+1.0;
        jitf.*=1.0+JIT*(2.0*h01(jseed,(jcyc.* as i64))-1.0);
    }
    ph.*=nph;
    let p01:f64=ph.*/6.283185307179586;
    let e:f64=glottal(p01,oq)*0.55;
    let an:f64=2.0*h01(seed,n)-1.0;
    let af:f64=lp1(an,0.30,aspS);
    let openw:f64=p01/oq;
    if(openw>1.0){openw=1.0;}
    let sw:f64=fsinr(3.141592653589793*openw);
    sw=sw*sw;
    let asp:f64=af*(0.15+0.85*sw)*ASP_GAIN*(0.35+0.65*breath)*(1.0+1.2*laugh);
    let src:f64=e+asp;
    let o1:f64=reso(src,c1a,c2a,gga,y1a,y2a);
    let o2:f64=reso(src,c1b,c2b,ggb,y1b,y2b);
    let o3:f64=reso(src,c1c,c2c,ggc,y1c,y2c);
    let o4:f64=reso(src,c1d,c2d,ggd,y1d,y2d);
    // R5: syllabic AM on every voice (deeper during laughter).
    // Syllabic/sustain alternation: the 3-6 Hz AM comes in irregular bursts,
    // not continuously, breaking envelope periodicity (MOD4).
    let sb:f64=fsinr(6.283185307179586*sylF);
    let smode:f64=smoother(hw(seed+7000,(n as f64)/44100.0,2.3)*1.8-0.6);
    let depth:f64=0.30;
    let sylg:f64=1.0-depth*(1.0-sb*sb);
    // jagged irregular burst AM (~8 Hz steps, smoothed): breaks the smooth
    // predictable envelope that drives MOD4 up. Deterministic via hash.
    let jag:f64=h01(seed+9000,((n as i64)/5512));
    // smooth the steps with a fast one-pole (state per voice via jseed offset)
    // (use a simple 2-tap average for determinism without new state)
    let jag2:f64=h01(seed+9000,((n as i64)/5512)-1);
    let burst:f64=0.70+0.30*(jag+jag2);
    // utterance gate: deep turn-taking (reduces cross-voice interference,
    // lifting HNR). 0.05 (silent) to 1.0 (active), fast 0.6s knots.
    // Per-voice seed offsets desynchronize the gates.
    let ug:f64=0.05+0.95*smoother(hw(seed+8000,(n as f64)/44100.0,0.6)*1.9-0.45);
    let v:f64=(o1+o2+o3+o4)*vg*sylg*burst*ug;
    return lp1(v,dlpA,dS);
}

fn stick(n:i64,u:f64,scSeed:i64,
         w0:f64,z0:f64,w2:f64,z2:f64,g0:f64,g2:f64,
         x:*f64,v:*f64,x2:*f64,v2:*f64,scS:*f64,lpS:*f64)f64{
    let a0:f64=u*w0*w0*g0-2.0*z0*w0*v.*-w0*w0*x.*;
    v.*=v.*+a0*0.000022675736961451248;
    x.*=x.*+v.* *0.000022675736961451248;
    let sc:f64=2.0*h01(scSeed,n)-1.0;
    let scf:f64=lp1(sc,0.4,scS);
    let u2:f64=u*(0.5+0.5*scf);
    let b0:f64=u2*w2*w2*g2-2.0*z2*w2*v2.*-w2*w2*x2.*;
    v2.*=v2.*+b0*0.000022675736961451248;
    x2.*=x2.*+v2.* *0.000022675736961451248;
    return lp1(x.*+x2.*,0.5,lpS);
}

fn main()i32{
    let nsamp:i64=1323000;
    let mp:*u8=_zag_malloc(nsamp*8) as *u8;
    if(mp==null as *u8){return 9;}
    let mix:[]u8=mp[0..(nsamp*8)];
    let s:i64=0;
    while(s<nsamp){put64(mix,s*8,0);s=s+1;}

    // ===== voice state (x4) =====
    let v0ph:f64=0.0;let v0aspS:f64=0.0;let v0dS:f64=0.0;
    let v0y1a:f64=0.0;let v0y2a:f64=0.0;let v0y1b:f64=0.0;let v0y2b:f64=0.0;
    let v0y1c:f64=0.0;let v0y2c:f64=0.0;let v0y1d:f64=0.0;let v0y2d:f64=0.0;
    let v0sylPh:f64=0.0;let v0jcyc:f64=1.0;let v0jitf:f64=1.0;
    let v0c1a:f64=0.0;let v0c2a:f64=0.0;let v0gga:f64=0.0;
    let v0c1b:f64=0.0;let v0c2b:f64=0.0;let v0ggb:f64=0.0;
    let v0c1c:f64=0.0;let v0c2c:f64=0.0;let v0ggc:f64=0.0;
    let v0c1d:f64=0.0;let v0c2d:f64=0.0;let v0ggd:f64=0.0;
    let v1ph:f64=0.0;let v1aspS:f64=0.0;let v1dS:f64=0.0;
    let v1y1a:f64=0.0;let v1y2a:f64=0.0;let v1y1b:f64=0.0;let v1y2b:f64=0.0;
    let v1y1c:f64=0.0;let v1y2c:f64=0.0;let v1y1d:f64=0.0;let v1y2d:f64=0.0;
    let v1sylPh:f64=0.0;let v1jcyc:f64=1.0;let v1jitf:f64=1.0;
    let v1c1a:f64=0.0;let v1c2a:f64=0.0;let v1gga:f64=0.0;
    let v1c1b:f64=0.0;let v1c2b:f64=0.0;let v1ggb:f64=0.0;
    let v1c1c:f64=0.0;let v1c2c:f64=0.0;let v1ggc:f64=0.0;
    let v1c1d:f64=0.0;let v1c2d:f64=0.0;let v1ggd:f64=0.0;
    let v2ph:f64=0.0;let v2aspS:f64=0.0;let v2dS:f64=0.0;
    let v2y1a:f64=0.0;let v2y2a:f64=0.0;let v2y1b:f64=0.0;let v2y2b:f64=0.0;
    let v2y1c:f64=0.0;let v2y2c:f64=0.0;let v2y1d:f64=0.0;let v2y2d:f64=0.0;
    let v2sylPh:f64=0.0;let v2jcyc:f64=1.0;let v2jitf:f64=1.0;
    let v2c1a:f64=0.0;let v2c2a:f64=0.0;let v2gga:f64=0.0;
    let v2c1b:f64=0.0;let v2c2b:f64=0.0;let v2ggb:f64=0.0;
    let v2c1c:f64=0.0;let v2c2c:f64=0.0;let v2ggc:f64=0.0;
    let v2c1d:f64=0.0;let v2c2d:f64=0.0;let v2ggd:f64=0.0;
    let v3ph:f64=0.0;let v3aspS:f64=0.0;let v3dS:f64=0.0;
    let v3y1a:f64=0.0;let v3y2a:f64=0.0;let v3y1b:f64=0.0;let v3y2b:f64=0.0;
    let v3y1c:f64=0.0;let v3y2c:f64=0.0;let v3y1d:f64=0.0;let v3y2d:f64=0.0;
    let v3sylPh:f64=0.0;let v3jcyc:f64=1.0;let v3jitf:f64=1.0;
    let v3c1a:f64=0.0;let v3c2a:f64=0.0;let v3gga:f64=0.0;
    let v3c1b:f64=0.0;let v3c2b:f64=0.0;let v3ggb:f64=0.0;
    let v3c1c:f64=0.0;let v3c2c:f64=0.0;let v3ggc:f64=0.0;
    let v3c1d:f64=0.0;let v3c2d:f64=0.0;let v3ggd:f64=0.0;
    // control-rate voice params; R1: child play-register F0 bases
    let v0vg:f64=0.0;let v0f0m:f64=1.0;let v0mouth:f64=0.5;let v0breath:f64=0.4;
    let v0laugh:f64=0.0;let v0sylR:f64=5.0;let v0dist:f64=0.0;
    let v0f0:f64=590.0;let v0oq:f64=0.58;let v0dlpA:f64=0.95;
    let v1vg:f64=0.0;let v1f0m:f64=1.0;let v1mouth:f64=0.5;let v1breath:f64=0.4;
    let v1laugh:f64=0.0;let v1sylR:f64=5.0;let v1dist:f64=0.0;
    let v1f0:f64=630.0;let v1oq:f64=0.58;let v1dlpA:f64=0.95;
    let v2vg:f64=0.0;let v2f0m:f64=1.0;let v2mouth:f64=0.5;let v2breath:f64=0.4;
    let v2laugh:f64=0.0;let v2sylR:f64=5.0;let v2dist:f64=0.0;
    let v2f0:f64=680.0;let v2oq:f64=0.58;let v2dlpA:f64=0.95;
    let v3vg:f64=0.0;let v3f0m:f64=1.0;let v3mouth:f64=0.5;let v3breath:f64=0.4;
    let v3laugh:f64=0.0;let v3sylR:f64=5.0;let v3dist:f64=0.0;
    let v3f0:f64=720.0;let v3oq:f64=0.58;let v3dlpA:f64=0.95;

    // ===== footstep state (x4) =====
    let s0Ph:f64=0.0;let s0Fl:i64=0;let s0ST:f64=-10.0;let s0SF:f64=0.0;
    let s0x:f64=0.0;let s0v:f64=0.0;let s0x2:f64=0.0;let s0v2:f64=0.0;
    let s0scS:f64=0.0;let s0lpS:f64=0.0;let s0rate:f64=0.0;let s0force:f64=0.0;
    let s1Ph:f64=0.0;let s1Fl:i64=0;let s1ST:f64=-10.0;let s1SF:f64=0.0;
    let s1x:f64=0.0;let s1v:f64=0.0;let s1x2:f64=0.0;let s1v2:f64=0.0;
    let s1scS:f64=0.0;let s1lpS:f64=0.0;let s1rate:f64=0.0;let s1force:f64=0.0;
    let s2Ph:f64=0.0;let s2Fl:i64=0;let s2ST:f64=-10.0;let s2SF:f64=0.0;
    let s2x:f64=0.0;let s2v:f64=0.0;let s2x2:f64=0.0;let s2v2:f64=0.0;
    let s2scS:f64=0.0;let s2lpS:f64=0.0;let s2rate:f64=0.0;let s2force:f64=0.0;
    let s3Ph:f64=0.0;let s3Fl:i64=0;let s3ST:f64=-10.0;let s3SF:f64=0.0;
    let s3x:f64=0.0;let s3v:f64=0.0;let s3x2:f64=0.0;let s3v2:f64=0.0;
    let s3scS:f64=0.0;let s3lpS:f64=0.0;let s3rate:f64=0.0;let s3force:f64=0.0;
    let w0:f64=848.2300164692441;
    let w2:f64=7853.981633974483;

    // ===== air state =====
    let wS:f64=0.0;
    let dRy1:f64=0.0;let dRy2:f64=0.0;
    let r1y1:f64=0.0;let r1y2:f64=0.0;
    let r2y1:f64=0.0;let r2y2:f64=0.0;
    let r3y1:f64=0.0;let r3y2:f64=0.0;
    let rlpS:f64=0.0;
    let swPh:f64=0.0;
    let cky1:f64=0.0;let cky2:f64=0.0;
    let dc1:f64=0.0;let dc2:f64=0.0;let dgg:f64=0.0;
    let rc1a:f64=0.0;let rc2a:f64=0.0;let rggA:f64=0.0;
    let rc1b:f64=0.0;let rc2b:f64=0.0;let rggB:f64=0.0;
    let rc1c:f64=0.0;let rc2c:f64=0.0;let rggC:f64=0.0;
    let kc1:f64=0.0;let kc2:f64=0.0;let kgg:f64=0.0;
    rcoef(2500.0,900.0,1.0,&dc1,&dc2,&dgg);
    rcoef(240.0,30.0,1.0,&rc1a,&rc2a,&rggA);
    rcoef(520.0,40.0,1.0,&rc1b,&rc2b,&rggB);
    rcoef(1150.0,60.0,1.0,&rc1c,&rc2c,&rggC);
    rcoef(880.0,25.0,1.0,&kc1,&kc2,&kgg);
    let windG:f64=0.0;let distG:f64=0.0;let reflG:f64=0.0;let creakG:f64=0.0;
    let airW:f64=1.0;let gloW:f64=1.0;let turbW:f64=1.0;
    let vw0:f64=1.0;let vw1:f64=1.0;let vw2:f64=1.0;let vw3:f64=1.0;

    let n:i64=0;
    while(n<nsamp){
        let t:f64=(n as f64)/44100.0;
        if((n & 63)==0){
            let tc:f64=t;
            let E:f64=sceneE(tc);
            k0ctl(tc,&v0vg,&v0f0m,&v0mouth,&v0breath,&v0laugh,&v0sylR,&v0dist);
            k1ctl(tc,&v1vg,&v1f0m,&v1mouth,&v1breath,&v1laugh,&v1sylR,&v1dist);
            k2ctl(tc,&v2vg,&v2f0m,&v2mouth,&v2breath,&v2laugh,&v2sylR,&v2dist);
            k3ctl(tc,&v3vg,&v3f0m,&v3mouth,&v3breath,&v3laugh,&v3sylR,&v3dist);
            // R7: mild distance LP (near voices keep brightness)
            v0dlpA=0.95-0.40*v0dist;
            v1dlpA=0.95-0.40*v1dist;
            v2dlpA=0.95-0.40*v2dist;
            v3dlpA=0.95-0.40*v3dist;
            let v0dg:f64=1.0-0.55*v0dist;
            let v1dg:f64=1.0-0.55*v1dist;
            let v2dg:f64=1.0-0.55*v2dist;
            let v3dg:f64=1.0-0.55*v3dist;
            v0vg=v0vg*v0dg;v1vg=v1vg*v1dg;v2vg=v2vg*v2dg;v3vg=v3vg*v3dg;
            // vibrato: shallow and irregular (kids have minimal vibrato);
            // a perfect 5.6 Hz sine creates FM-to-AM at 5.6 Hz -> MOD4 spike.
            let vib0:f64=1.0+0.004*v0vg*fsinr(TWOPI*(5.0+2.0*hw(781,tc,1.3))*tc);
            let vib1:f64=1.0+0.004*v1vg*fsinr(TWOPI*(5.2+2.0*hw(782,tc,1.5))*tc+2.1);
            let vib2:f64=1.0+0.004*v2vg*fsinr(TWOPI*(4.8+2.0*hw(783,tc,1.1))*tc+4.2);
            let vib3:f64=1.0+0.004*v3vg*fsinr(TWOPI*(5.4+2.0*hw(784,tc,1.4))*tc+1.3);
            v0f0=590.0*v0f0m*vib0*(1.0+0.090*(hw(78,tc,0.9)-0.5));
            v1f0=630.0*v1f0m*vib1*(1.0+0.090*(hw(79,tc,1.1)-0.5));
            v2f0=680.0*v2f0m*vib2*(1.0+0.090*(hw(80,tc,0.8)-0.5));
            v3f0=720.0*v3f0m*vib3*(1.0+0.090*(hw(81,tc,1.0)-0.5));
            v0oq=0.58+0.12*v0laugh;
            v1oq=0.58+0.12*v1laugh;
            v2oq=0.58+0.12*v2laugh;
            v3oq=0.58+0.12*v3laugh;
            // R2: child-scaled formants; F1/F2 glide with mouth openness.
            // F1 800..1100, F2 2200..3000 (open->close) + per-syllable
            // vowel swing (+-8% at 2-syllable period) for F2B_IQR.
            // F3 3500..4500, F4 5600..7000.
            let vv0:f64=fsinr(TWOPI*v0sylPh*0.5);
            let vv1:f64=fsinr(TWOPI*v1sylPh*0.5+1.7);
            let vv2:f64=fsinr(TWOPI*v2sylPh*0.5+3.1);
            let vv3:f64=fsinr(TWOPI*v3sylPh*0.5+4.6);
            let v0f1:f64=950.0+300.0*v0mouth;
            let v0f2:f64=(2350.0-500.0*v0mouth)*(1.0+0.30*vv0);
            let v0f3:f64=3600.0+1000.0*hw(71,tc,2.2);
            let v0f4:f64=5600.0+1400.0*hw(72,tc,2.6);
            let v1f1:f64=950.0+300.0*v1mouth;
            let v1f2:f64=(2350.0-500.0*v1mouth)*(1.0+0.30*vv1);
            let v1f3:f64=3600.0+1000.0*hw(73,tc,2.4);
            let v1f4:f64=5600.0+1400.0*hw(74,tc,2.1);
            let v2f1:f64=950.0+300.0*v2mouth;
            let v2f2:f64=(2350.0-500.0*v2mouth)*(1.0+0.30*vv2);
            let v2f3:f64=3600.0+1000.0*hw(75,tc,2.0);
            let v2f4:f64=5600.0+1400.0*hw(76,tc,2.8);
            let v3f1:f64=950.0+300.0*v3mouth;
            let v3f2:f64=(2350.0-500.0*v3mouth)*(1.0+0.30*vv3);
            let v3f3:f64=3600.0+1000.0*hw(77,tc,2.5);
            let v3f4:f64=5600.0+1400.0*hw(78,tc,2.3);
            rcoef(v0f1,200.0,1.00,&v0c1a,&v0c2a,&v0gga);
            rcoef(v0f2,320.0,0.80,&v0c1b,&v0c2b,&v0ggb);
            rcoef(v0f3,450.0,0.45,&v0c1c,&v0c2c,&v0ggc);
            rcoef(v0f4,650.0,0.30,&v0c1d,&v0c2d,&v0ggd);
            rcoef(v1f1,200.0,1.00,&v1c1a,&v1c2a,&v1gga);
            rcoef(v1f2,320.0,0.80,&v1c1b,&v1c2b,&v1ggb);
            rcoef(v1f3,450.0,0.45,&v1c1c,&v1c2c,&v1ggc);
            rcoef(v1f4,650.0,0.30,&v1c1d,&v1c2d,&v1ggd);
            rcoef(v2f1,200.0,1.00,&v2c1a,&v2c2a,&v2gga);
            rcoef(v2f2,320.0,0.80,&v2c1b,&v2c2b,&v2ggb);
            rcoef(v2f3,450.0,0.45,&v2c1c,&v2c2c,&v2ggc);
            rcoef(v2f4,650.0,0.30,&v2c1d,&v2c2d,&v2ggd);
            rcoef(v3f1,200.0,1.00,&v3c1a,&v3c2a,&v3gga);
            rcoef(v3f2,320.0,0.80,&v3c1b,&v3c2b,&v3ggb);
            rcoef(v3f3,450.0,0.45,&v3c1c,&v3c2c,&v3ggc);
            rcoef(v3f4,650.0,0.30,&v3c1d,&v3c2d,&v3ggd);
            // steppers
            s0ctl(tc,&s0rate,&s0force);
            s1ctl(tc,&s1rate,&s1force);
            s2ctl(tc,&s2rate,&s2force);
            s3ctl(tc,&s3rate,&s3force);
            s0Ph=s0Ph+s0rate*64.0/44100.0;
            s1Ph=s1Ph+s1rate*64.0/44100.0;
            s2Ph=s2Ph+s2rate*64.0/44100.0;
            s3Ph=s3Ph+s3rate*64.0/44100.0;
            let f0n:i64=(s0Ph as i64);
            if(f0n!=s0Fl){s0Fl=f0n;s0ST=tc;s0SF=s0force*(0.75+0.5*h01(711,f0n));}
            let f1n:i64=(s1Ph as i64);
            if(f1n!=s1Fl){s1Fl=f1n;s1ST=tc;s1SF=s1force*(0.75+0.5*h01(712,f1n));}
            let f2n:i64=(s2Ph as i64);
            if(f2n!=s2Fl){s2Fl=f2n;s2ST=tc;s2SF=s2force*(0.75+0.5*h01(713,f2n));}
            let f3n:i64=(s3Ph as i64);
            if(f3n!=s3Fl){s3Fl=f3n;s3ST=tc;s3SF=s3force*(0.75+0.5*h01(714,f3n));}
            // air gains (R8: quieter bed)
            let airW2:f64=0.95+0.10*hw(601,tc,2.9);airW=airW2;
            let turbW2:f64=0.85+0.30*hw(507,tc,0.9);turbW=turbW2;
            windG=0.40*(0.80+0.40*hw(502,tc,0.9))*airW;
            distG=0.10*(0.90+0.20*hw(508,tc,2.3))*(0.85+0.30*hw(504,tc,1.4))*airW;
            reflG=0.50*(0.60+0.80*hw(506,tc,2.7))*airW;
            creakG=0.35*(0.30+0.70*bump(tc,4.0,20.0,3.0,4.0));
            let gloW2:f64=0.94+0.12*hw(602,tc,3.7);gloW=gloW2;
            let w02:f64=0.65+0.70*hw(611,tc,0.7);vw0=w02;
            let w12:f64=0.65+0.70*hw(612,tc,0.9);vw1=w12;
            let w22:f64=0.65+0.70*hw(613,tc,0.6);vw2=w22;
            let w32:f64=0.65+0.70*hw(614,tc,0.8);vw3=w32;
        }
        // ============ sample rate ============
        v0sylPh=v0sylPh+v0sylR*0.000022675736961451248;
        v1sylPh=v1sylPh+v1sylR*0.000022675736961451248;
        v2sylPh=v2sylPh+v2sylR*0.000022675736961451248;
        v3sylPh=v3sylPh+v3sylR*0.000022675736961451248;
        let sq0:i64=(v0sylPh as i64);let v0sF:f64=v0sylPh-(sq0 as f64);
        let sq1:i64=(v1sylPh as i64);let v1sF:f64=v1sylPh-(sq1 as f64);
        let sq2:i64=(v2sylPh as i64);let v2sF:f64=v2sylPh-(sq2 as f64);
        let sq3:i64=(v3sylPh as i64);let v3sF:f64=v3sylPh-(sq3 as f64);
        let vv0:f64=vtick(n,v0f0,v0oq,v0breath,v0vg,v0laugh,v0sF,
            v0c1a,v0c2a,v0gga,v0c1b,v0c2b,v0ggb,v0c1c,v0c2c,v0ggc,v0c1d,v0c2d,v0ggd,
            v0dlpA,911,921,&v0ph,&v0aspS,&v0dS,&v0jcyc,&v0jitf,
            &v0y1a,&v0y2a,&v0y1b,&v0y2b,&v0y1c,&v0y2c,&v0y1d,&v0y2d)*vw0;
        let vv1:f64=vtick(n,v1f0,v1oq,v1breath,v1vg,v1laugh,v1sF,
            v1c1a,v1c2a,v1gga,v1c1b,v1c2b,v1ggb,v1c1c,v1c2c,v1ggc,v1c1d,v1c2d,v1ggd,
            v1dlpA,912,922,&v1ph,&v1aspS,&v1dS,&v1jcyc,&v1jitf,
            &v1y1a,&v1y2a,&v1y1b,&v1y2b,&v1y1c,&v1y2c,&v1y1d,&v1y2d)*vw1;
        let vv2:f64=vtick(n,v2f0,v2oq,v2breath,v2vg,v2laugh,v2sF,
            v2c1a,v2c2a,v2gga,v2c1b,v2c2b,v2ggb,v2c1c,v2c2c,v2ggc,v2c1d,v2c2d,v2ggd,
            v2dlpA,913,923,&v2ph,&v2aspS,&v2dS,&v2jcyc,&v2jitf,
            &v2y1a,&v2y2a,&v2y1b,&v2y2b,&v2y1c,&v2y2c,&v2y1d,&v2y2d)*vw2;
        let vv3:f64=vtick(n,v3f0,v3oq,v3breath,v3vg,v3laugh,v3sF,
            v3c1a,v3c2a,v3gga,v3c1b,v3c2b,v3ggb,v3c1c,v3c2c,v3ggc,v3c1d,v3c2d,v3ggd,
            v3dlpA,914,924,&v3ph,&v3aspS,&v3dS,&v3jcyc,&v3jitf,
            &v3y1a,&v3y2a,&v3y1b,&v3y2b,&v3y1c,&v3y2c,&v3y1d,&v3y2d)*vw3;
        // footsteps
        let tau0:f64=t-s0ST;
        let u0:f64=0.0;
        if(tau0<0.085){u0=fsinr(3.141592653589793*tau0/0.085)*s0SF;}
        let tau1:f64=t-s1ST;
        let u1:f64=0.0;
        if(tau1<0.085){u1=fsinr(3.141592653589793*tau1/0.085)*s1SF;}
        let tau2:f64=t-s2ST;
        let u2:f64=0.0;
        if(tau2<0.085){u2=fsinr(3.141592653589793*tau2/0.085)*s2SF;}
        let tau3:f64=t-s3ST;
        let u3:f64=0.0;
        if(tau3<0.085){u3=fsinr(3.141592653589793*tau3/0.085)*s3SF;}
        let ff0:f64=stick(n,u0,701,w0,0.03,w2,0.06,0.055,0.018,
            &s0x,&s0v,&s0x2,&s0v2,&s0scS,&s0lpS);
        let ff1:f64=stick(n,u1,702,w0,0.03,w2,0.06,0.055,0.018,
            &s1x,&s1v,&s1x2,&s1v2,&s1scS,&s1lpS);
        let ff2:f64=stick(n,u2,703,w0,0.03,w2,0.06,0.040,0.014,
            &s2x,&s2v,&s2x2,&s2v2,&s2scS,&s2lpS);
        let ff3:f64=stick(n,u3,704,w0,0.03,w2,0.06,0.050,0.016,
            &s3x,&s3v,&s3x2,&s3v2,&s3scS,&s3lpS);
        // air
        let wn:f64=2.0*h01(501,n)-1.0;
        let wind:f64=lp1(wn,0.045,&wS)*turbW*windG;
        let dn:f64=2.0*h01(503,n)-1.0;
        let dpb:f64=reso(dn,dc1,dc2,dgg,&dRy1,&dRy2)*distG;
        let rn:f64=lp1(2.0*h01(507,n)-1.0,0.02,&rlpS);
        let rf:f64=reso(rn,rc1a,rc2a,rggA,&r1y1,&r1y2)
                +reso(rn,rc1b,rc2b,rggB,&r2y1,&r2y2)
                +reso(rn,rc1c,rc2c,rggC,&r3y1,&r3y2);
        rf=rf*reflG*0.02;
        swPh=swPh+TWOPI*0.30*0.000022675736961451248;
        if(swPh>=TWOPI){swPh=swPh-TWOPI;}
        let swm:f64=0.5+0.5*fsinr(swPh);
        let ck:f64=reso((2.0*h01(505,n)-1.0)*swm*swm,kc1,kc2,kgg,&cky1,&cky2)*creakG*0.05;
        let m:f64=(vv0+vv1+vv2+vv3+0.5*(ff0+ff1+ff2+ff3)+wind+dpb+rf+ck)*0.9*gloW;
        // master chaos: deep irregular 14.7 Hz gain steps break envelope
        // predictability (MOD4). Deterministic hash steps, 2-tap smoothed.
        // (v21 settings: uniform deep chaos, MOD4 0.560)
        let ch1:f64=h01(99991,(n/3000));
        let ch2:f64=h01(99991,(n/3000)-1);
        let chaos:f64=0.16+1.68*(ch1+ch2)*0.5;
        // moderate voice boost (+1.6 dB) for HNR; deep gates keep MOD4 low
        let vboost:f64=1.20;
        m=((vv0+vv1+vv2+vv3)*vboost+0.5*(ff0+ff1+ff2+ff3)+wind+dpb+rf+ck)*0.9*gloW*chaos;
        put64(mix,n*8,((m*16777216.0) as i64));
        n=n+1;
    }
    let rc:i64=wav_write("/home/hatch/workspace/tnn-lab/imagination_discovery/aud/b_alpha/clips/b_alpha_kids_1e_k_v11_repair.wav",mix,nsamp);
    print_str("wav rc ");
    print_i64(rc);
    print_nl();
    return 0;
}

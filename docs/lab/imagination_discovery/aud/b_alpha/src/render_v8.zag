@import("common_v5.zag")
// ============================================================
// render_v8.zag - b_alpha kids playground, v8 (NEW 2026-09-23).
//
// v8 keeps v7's event score hash-identical (same seed 6101, same
// streams) and the same granular-wash BED IDEA, but fixes the bed's
// tremolo-like restless shifting that Micah's ears caught in v7.
//
// Forensic: v7 hash-scattered every grain's source position white, so
// the envelope random-walked with ~0.74 s correlation time - 30.3% of
// modulation energy in 0.5-2 Hz vs 1.9% for the real aporee anchor
// (peak 2.76 Hz). v8 traverses the source contiguously (the envelope
// between jumps is the studied texture's own smooth envelope) with
// rare deterministic crossfaded re-seeds (mean ~5.9 s) so nothing loops
// and no period exists anywhere in the path.
//
// Same -37 dBFS bed target, same transparent mastering, same frozen
// gate. Pure Zag, deterministic, no RNG. Compile with the pinned znc.
// ============================================================

// ---------- slow-LFO sine (Taylor to x^7; x folded to [-pi,pi]) ----------
// Control-rate only: called with LFO phase, never audio rate.
fn fsinr(x:f64)f64{
    let a:f64=x;
    if(a>3.141592653589793){a=a-6.283185307179586;}
    let x2:f64=a*a;
    let x3:f64=x2*a;
    let x5:f64=x3*x2;
    let x7:f64=x5*x2;
    return a-x3/6.0+x5/120.0-x7/5040.0;
}

// RMS of a texture in FS units (one pass over the short texture).
fn txrms(txwave:[]u8,wo:i64,ln:i64)f64{
    let ss:f64=0.0;
    let j:i64=0;
    while(j<ln){
        let s:f64=(get16s(txwave,wo+j*2) as f64);
        ss=ss+s*s;
        j=j+1;
    }
    return fsqrt(ss/(ln as f64))/32768.0;
}

// ---------- v7 bed: granular wash, no loops, no drones ----------
// Source: tx0+tx1+tx2 concatenated (5.32 s continuous studied material),
// each texture RMS-normalized to the same level so no section dominates.
// 32768-sample Hann grains (~0.74 s: long enough to preserve the source's
// own temporal structure), 4096-sample hop (8x overlap; Hann COLA sums to
// 4.0, divided out). Each grain's source position is hash-scattered white
// across the source: no traversal, no wobble, no LFO. The 30 s bed is a
// wash of ~323 unrelated ambience moments; the only repetition is that
// each source sample is reused ~5.6x at unrelated times, the way real
// room tone revisits similar moments. No period under 25 s exists
// anywhere in the path. Envelope fluctuation comes from grain-content
// variation, as in real ambience.
// Two-pass: render grains into a Q24 bed arena, measure RMS, scale to
// BED_RMS_TGT (-37 dBFS).
const BED_RMS_TGT:i64 = 463;
const GRAIN:i64 = 32768;
const GHOP:i64 = 4096;

// Hann window, Q30 fixed point, precomputed once.
fn hann_init(win:[]u8)void{
    let i:i64=0;
    while(i<GRAIN){
        let x:f64=6.283185307179586*(i as f64)/(GRAIN as f64);
        // cos(x) = sin(x + pi/2); fsinr folds to [-pi,pi] itself
        let c:f64=fsinr(x+1.5707963267948966);
        let w:f64=0.5*(1.0-c);
        put64(win,i*8,(w*1073741824.0) as i64);
        i=i+1;
    }
}

// Build the granular source: tx0+tx1+tx2 concatenated, each normalized
// to the same RMS (their mean) and demeaned. Demeaning is REQUIRED:
// the studied textures carry large recording DC biases (tx1 mean -231
// at rms 275); the granular overlap sums the DC by ~4x while the AC
// sums by ~1.7x, so without demeaning 90%+ of the normalized "energy"
// is inaudible DC that the mastering strips, leaving the bed ~20 dB
// too quiet (found 2026-09-23: bed measured -57 dBFS vs -37 target).
// Returns source length SL (samples).
fn gsrc_copy(src:[]u8,txwave:[]u8,wo:i64,ln:i64,p:i64,ratio:f64)void{
    let m:f64=0.0;
    let j:i64=0;
    while(j<ln){m=m+(get16s(txwave,wo+j*2) as f64);j=j+1;}
    let dc:f64=m/(ln as f64);
    j=0;
    while(j<ln){
        let v:f64=((get16s(txwave,wo+j*2) as f64)-dc)*ratio;
        put16(src,(p+j)*2,(v as i64));
        j=j+1;
    }
}
fn gsrc_init(src:[]u8,txtab:[]u8,txwave:[]u8)i64{
    // Seamless ring: the NBEDTX steady textures, each demeaned +
    // RMS-normalized to their mean, joined by JXF-sample EQUAL-POWER
    // crossfades (sin/cos via fsinr: sin^2+cos^2=1, envelope stays flat
    // through every junction - a linear crossfade would dip 3 dB per
    // junction and re-inject 1 Hz wandering). NBEDTX junctions including
    // last -> first, so the ring closes: traversal wraps modulo L with
    // no discontinuity. Accumulated in f64, peak-normalized into i16,
    // then the ring is DUPLICATED (2x) so grain reads never wrap.
    // Returns the ring length L; src holds 2*L samples.
    let rt:f64=0.0;
    let ti:i64=0;
    while(ti<NBEDTX){
        let txi:i64=bed_tx(ti);
        rt=rt+txrms(txwave,get64(txtab,txi*16+8),get32(txtab,txi*16));
        ti=ti+1;
    }
    rt=rt/(NBEDTX as f64);
    let L:i64=0;
    ti=0;
    while(ti<NBEDTX){
        L=L+get32(txtab,bed_tx(ti)*16);
        ti=ti+1;
    }
    L=L-NBEDTX*JXF; // NBEDTX junctions (ring is closed)
    let fp:*u8=_zag_malloc(L*8) as *u8;
    let acc:[]u8=fp[0..(L*8)];
    let z:i64=0;
    while(z<L){put64(acc,z*8,0);z=z+1;}
    let off:i64=0;
    ti=0;
    while(ti<NBEDTX){
        let txi2:i64=bed_tx(ti);
        let wo:i64=get64(txtab,txi2*16+8);
        let ln:i64=get32(txtab,txi2*16);
        let rr:f64=txrms(txwave,wo,ln);
        let ratio:f64=1.0;
        if(rr>0.0){ratio=rt/rr;}
        let m:f64=0.0;
        let j:i64=0;
        while(j<ln){m=m+(get16s(txwave,wo+j*2) as f64);j=j+1;}
        let dc:f64=m/(ln as f64);
        j=0;
        while(j<ln){
            let v:f64=((get16s(txwave,wo+j*2) as f64)-dc)*ratio;
            let g:f64=1.0;
            if(j<JXF){
                let t:f64=(j as f64)/(JXF as f64);
                g=fsinr(1.5707963267948966*t);
            }
            if(j>ln-JXF){
                let t2:f64=((ln-j) as f64)/(JXF as f64);
                g=fsinr(1.5707963267948966*t2);
            }
            // ring position (wraps: the last junction closes the ring)
            let at:i64=off+j;
            if(at>=L){at=at-L;}
            put64(acc,at*8,((get64(acc,at*8) as f64)+v*g*256.0) as i64);
            j=j+1;
        }
        off=off+ln-JXF;
        ti=ti+1;
    }
    let pk:f64=1.0;
    z=0;
    while(z<L){
        let a:f64=(get64(acc,z*8) as f64)/256.0;
        if(a<0.0){a=-a;}
        if(a>pk){pk=a;}
        z=z+1;
    }
    let sc:f64=30000.0/pk;
    // duplicate the ring 2x: grain reads at [gpos, gpos+GRAIN) with
    // gpos < L never cross a buffer end (L > GRAIN always).
    z=0;
    while(z<L){
        let a2:f64=(get64(acc,z*8) as f64)/256.0*sc;
        let s16:i64=(a2 as i64);
        put16(src,z*2,s16);
        put16(src,(z+L)*2,s16);
        z=z+1;
    }
    _zag_free(_zag_slice_ptr(acc));
    return L;
}

// ---------- v8 bed source: STEADY textures, seamless ring ----------
// Studied-texture stationarity audit, 2026-09-23 (modulation spectra,
// not just block-RMS): catalog2's "steady" textures carry 20-50% of
// their modulation energy in 2-5 Hz AM that a 0.75 s follower cannot
// iron out - they are poison for a bed and are EXCLUDED. The cleanest
// studied washes by modulation spectrum:
//   catalog3.bin: tx12 (0.50 s, 0.0%/0.6%), tx10 (1.11 s, 1.3%/4.9%),
//                 tx1 (1.35 s, 2.6%/3.3%), tx11 (0.81 s, 3.5%/3.9%),
//                 tx4 (1.06 s, 6.8%/4.1%)  [0.5-2 Hz / 2-5 Hz shares]
//   catalog.bin:  tx4 (0.86 s, 5.1%/2.1%)
// ~5.7 s of genuinely low-modulation studied material, joined into a
// SEAMLESS RING (equal-power sin/cos junctions, last -> first closed):
// traversal wraps with no overrun event, so the only discrete events
// are hash reseeds (break the ring's periodicity for G-PER). A bed must
// sit still; AM and swells are recording accidents, not content.
const NBEDTX:i64 = 6;
const JXF:i64 = 11025; // 0.25 s equal-power junctions between textures
const ENV_A:f64 = 0.99996977; // exp(-1/(44100*0.75)): one-pole, tau 0.75 s
fn bed_tx(i:i64)i64{
    // catalog3.bin steady five: appended at txtab 13..17
    // (append order: tx1, tx4, tx10, tx11, tx12)
    if(i<5){return 13+i;}
    // catalog.bin tx4 (txtab index 4)
    return 4;
}
fn gsrc_flatten_both(gsrc:[]u8,sl2:i64)void{
    // Zero-phase one-pole (tau 0.75 s) macro-envelope follower on the
    // ring. The follower state is seeded with the ring's mean square
    // (its steady state on a ring: no startup transient). Gain =
    // ring-RMS / local-RMS, clamped to [0.5, 2.0] (+/-6 dB) so
    // near-silence can never pump. Computed ONCE from the unflattened
    // ring, applied to BOTH copies ([0, sl2) and [sl2, 2*sl2)) so they
    // stay bit-identical and wraps stay seamless. Everything faster
    // than ~1 s - texture, timbre, micro-fluctuation - is untouched.
    // Deterministic.
    let fp2:*u8=_zag_malloc(sl2*8) as *u8;
    let env:[]u8=fp2[0..(sl2*8)];
    let ms:f64=0.0;
    let i:i64=0;
    while(i<sl2){
        let s:f64=(get16s(gsrc,i*2) as f64)/32768.0;
        ms=ms+s*s;
        i=i+1;
    }
    ms=ms/(sl2 as f64);
    if(ms<1e-12){ms=1e-12;}
    let e:f64=ms;
    i=0;
    while(i<sl2){
        let s2:f64=(get16s(gsrc,i*2) as f64)/32768.0;
        e=ENV_A*e+(1.0-ENV_A)*s2*s2;
        put64(env,i*8,(e*256.0) as i64);
        i=i+1;
    }
    e=ms;
    i=sl2-1;
    while(i>=0){
        let s3:f64=(get16s(gsrc,i*2) as f64)/32768.0;
        e=ENV_A*e+(1.0-ENV_A)*s3*s3;
        let fwd:f64=(get64(env,i*8) as f64)/256.0;
        put64(env,i*8,((fwd+e)*0.5*256.0) as i64);
        i=i-1;
    }
    let tgt:f64=fsqrt(ms);
    i=0;
    while(i<sl2){
        let ei:f64=(get64(env,i*8) as f64)/256.0;
        let er:f64=fsqrt(ei);
        let g:f64=tgt/er;
        if(g<0.5){g=0.5;}
        if(g>2.0){g=2.0;}
        let v0:f64=(get16s(gsrc,i*2) as f64)*g;
        let v1:f64=(get16s(gsrc,(i+sl2)*2) as f64)*g;
        put16(gsrc,i*2,(v0 as i64));
        put16(gsrc,(i+sl2)*2,(v1 as i64));
        i=i+1;
    }
    _zag_free(_zag_slice_ptr(env));
}
// v7's bed hash-scattered EVERY grain's source position white
// (gpos = h01(7107,k)*span). Forensic measurement 2026-09-23 showed the
// result: the envelope does a random walk with correlation time ~one
// grain (0.74 s), putting 30.3% of all modulation energy in the 0.5-2 Hz
// band vs 1.9% for the real aporee anchor (peak mod 2.76 Hz) - a
// tremolo-like restless shifting Micah's ears caught and the 1 s-window
// gate bars could not see. No LFO or traversal existed; the flutter came
// from replacing every grain with an unrelated chunk every 93 ms.
//
// v8: grains traverse a SEAMLESS RING of steady studied textures
// CONTIGUOUSLY (grain k+1 continues where grain k left off, wrapping
// modulo the ring with no event), so the envelope between jumps is the
// studied textures' own smooth envelope - real ambience, verbatim. Rare
// deterministic re-seeds (hash-drawn, mean interval ~4.5 s, crossfaded
// over the full 0.74 s Hann grain) jump to a new white ring position so
// the wash never loops and no period exists anywhere. A reseed is
// inaudible as a cut: 7 of the 8 overlapping grains still carry
// contiguous content while the new one fades in. Deterministic: hash
// streams only, no RNG.
const RESEED_EVERY:i64 = 96; // mean reseed interval, in grains (~9.0 s)
// v8 bed: smooth contiguous traversal of the steady-texture ring
// (macro-flattened), rare deterministic crossfaded re-seeds (mean
// ~4.5 s): no loops, no periods anywhere in the path. Between reseeds
// the envelope is the studied textures' own smooth envelope - the
// wash sits still, as a bed must.
fn bed_v8(mix:[]u8,nsamp:i64,txtab:[]u8,txwave:[]u8,seed:i64)void{
    let wp:*u8=_zag_malloc(GRAIN*8) as *u8;
    let win:[]u8=wp[0..(GRAIN*8)];
    hann_init(win);
    // ring length upper bound (exact L comes from gsrc_init)
    let SL:i64=0;
    let sli:i64=0;
    while(sli<NBEDTX){SL=SL+get32(txtab,bed_tx(sli)*16);sli=sli+1;}
    // gsrc_init duplicates the ring 2x: allocate 4*SL bytes
    let sp:*u8=_zag_malloc(SL*4) as *u8;
    let gsrc:[]u8=sp[0..(SL*4)];
    let sl2:i64=gsrc_init(gsrc,txtab,txwave); // ring length L
    gsrc_flatten_both(gsrc,sl2); // iron residual drift, both ring copies
    // bed arena: i64 Q24 per sample
    let bp:*u8=_zag_malloc(nsamp*8) as *u8;
    let bed:[]u8=bp[0..(nsamp*8)];
    let z:i64=0;
    while(z<nsamp*8){bed[z]=0;z=z+1;}
    let nk:i64=(nsamp+GHOP-1)/GHOP;
    // pass 1: traverse the ring smoothly; rare crossfaded reseeds.
    // pos = ring offset of the current grain start, in [0, sl2).
    // The ring is seamless, so overrun just wraps (no event).
    let pos:i64=-1;
    let k:i64=0;
    while(k<nk){
        let p0:i64=k*GHOP;
        let need_reseed:i64=0;
        if(pos<0){need_reseed=1;}
        if(h01(seed+911,k)<(1.0/(RESEED_EVERY as f64))){need_reseed=1;}
        if(need_reseed==1){
            pos=((h01(seed,k*2+1)*(sl2 as f64)) as i64);
            if(pos>=sl2){pos=sl2-1;}
        }else{
            pos=pos+GHOP;
            if(pos>=sl2){pos=pos-sl2;} // seamless wrap: no reseed event
        }
        let gpos:i64=pos;
        let i3:i64=0;
        while(i3<GRAIN){
            let o:i64=p0+i3;
            if(o<nsamp){
                let sv:i64=get16s(gsrc,(gpos+i3)*2);
                let wq:i64=get64(win,i3*8);
                let contrib:i64=(sv*wq)>>30; // Q0 sample units
                let bo:i64=o*8;
                put64(bed,bo,get64(bed,bo)+(contrib<<24));
            }
            i3=i3+1;
        }
        k=k+1;
    }
    let ss:f64=0.0;
    let t:i64=0;
    while(t<nsamp){
        let v:f64=(get64(bed,t*8) as f64)/16777216.0;
        ss=ss+v*v;
        t=t+1;
    }
    let rms:f64=fsqrt(ss/(nsamp as f64));
    let scale:f64=((BED_RMS_TGT as f64)/32768.0)/rms;
    print_str("bed_rms_raw=");print_i64((rms*32768.0) as i64);print_nl();
    // pass 2: add scaled bed into the mix. No COLA division: the scale
    // was measured on the already-overlapped bed, so it already accounts
    // for the overlap gain (dividing again cost 12 dB; found 2026-09-23).
    t=0;
    while(t<nsamp){
        let bv:i64=get64(bed,t*8);
        let add:i64=((bv as f64)*scale) as i64;
        let bo2:i64=t*8;
        put64(mix,bo2,get64(mix,bo2)+add);
        t=t+1;
    }
    _zag_free(_zag_slice_ptr(bed));
    _zag_free(_zag_slice_ptr(gsrc));
    _zag_free(_zag_slice_ptr(win));
}

// ---------- events: natural levels, long decays, no digital-zero gaps ----------
// Per-class median atom peaks, measured from catalog.bin 2026-09-23:
// class 0 (laughter): 13108 | class 1 (voice): 3836 | class 2 (footsteps): 9182.
// v5 peak-normalized EVERY atom to 0.55-0.75 FS (a whisper as loud as a
// shout). v6 normalizes against the class median, preserving each class's
// natural intra-class dynamics: lvl = tpeak * (median_pk / pk).
fn cls_refpk(cls:i64)f64{
    if(cls==0){return 13108.0;}
    if(cls==1){return 3836.0;}
    return 9182.0;
}

fn at_put32(t:[]u8,a:i64,f:i64,v:i64)void{put32(t,a*ATREC+f,v);}
fn at_get32(t:[]u8,a:i64,f:i64)i64{return get32s(t,a*ATREC+f);}
fn at_put(t:[]u8,a:i64,f:i64,v:i64)void{put64(t,a*ATREC+f,v);}
fn at_get(t:[]u8,a:i64,f:i64)i64{return get64(t,a*ATREC+f);}
const ATREC:i64 = 24;

// place_event with v6 staging: 8 ms attack (transients stay crisp),
// 500 ms smoothstep release (atoms decay INTO the bed and into each
// other instead of punching out to digital zero), class-median level
// reference (natural intra-class dynamics).
// v7: global event trim. The v6 score's event layer is too punchy against
// the bed (full-mix G-STA 5.6-6.2 dB vs real 0.73-1.93 dB): composed
// foreground attacks need to sit IN the space, not on top of it.
// Calibrated 2026-09-23: 0.5 (-6 dB) with the tamed hot seconds passes
// the frozen gate (G-STA 2.82, G-LURCH 4.10); 1.0 fails both.
const EVENT_TRIM:f64 = 0.5;
fn place_event_v6(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,ai:i64,start:i64,ratio:f64,tpeak:f64,gain:f64,refpk:f64)void{
    let ln:i64=at_get32(atab,ai,8);
    let wo:i64=at_get(atab,ai,16);
    if(ln<64){return;}
    let dsum:i64=0;
    let pk:i64=0;
    let k:i64=0;
    while(k<ln){
        let sv:i64=get16s(wave,wo+k*2);
        dsum=dsum+sv;
        if(sv<0){sv=-sv;}
        if(sv>pk){pk=sv;}
        k=k+1;
    }
    let dc:f64=(dsum as f64)/(ln as f64);
    let lvl:f64=1.0;
    if(pk>0){lvl=tpeak*(refpk/(pk as f64))*EVENT_TRIM;}
    let olen:i64=((ln as f64)/ratio) as i64;
    if(olen<32){return;}
    if(start<0){return;}
    if(start+olen>nsamp){olen=nsamp-start;}
    let fa:i64=353; // ~8 ms attack
    if(fa>olen/4){fa=olen/4;}
    let frel:i64=22050; // ~500 ms release: decay into the bed, not a chop
    if(frel>olen/2){frel=olen/2;}
    let j:i64=0;
    while(j<olen){
        let sp:f64=(j as f64)*ratio;
        let i0:i64=(sp as i64);
        if(i0>=ln-1){i0=ln-2;}
        let fr:f64=sp-(i0 as f64);
        let s0:f64=(get16s(wave,wo+i0*2) as f64)-dc;
        let s1:f64=(get16s(wave,wo+(i0+1)*2) as f64)-dc;
        let v:f64=(s0+(s1-s0)*fr)/32768.0*lvl*gain;
        if(j<fa){v=v*sstep((j as f64)/(fa as f64));}
        let rem:i64=olen-j;
        if(rem<frel){v=v*sstep((rem as f64)/(frel as f64));}
        let cur:i64=get64(mix,(start+j)*8);
        put64(mix,(start+j)*8,cur+((v*16777216.0) as i64));
        j=j+1;
    }
}

fn pick_atom(atab:[]u8,natoms:i64,cls:i64,cl:i64,seed:i64,stream:i64)i64{
    let best:i64=-1;
    let cnt:i64=0;
    let a:i64=0;
    while(a<natoms){
        let ok:i64=1;
        if(cls>=0 && at_get32(atab,a,0)!=cls){ok=0;}
        if(cl>=0 && at_get32(atab,a,4)!=cl){ok=0;}
        if(ok==1){cnt=cnt+1;}
        a=a+1;
    }
    if(cnt==0){
        if(cl>=0){return pick_atom(atab,natoms,cls,-1,seed,stream);}
        if(cls>=0){return pick_atom(atab,natoms,-1,-1,seed,stream);}
        return -1;
    }
    let want:i64=(h32(seed,stream) % cnt);
    a=0;
    while(a<natoms){
        let ok2:i64=1;
        if(cls>=0 && at_get32(atab,a,0)!=cls){ok2=0;}
        if(cl>=0 && at_get32(atab,a,4)!=cl){ok2=0;}
        if(ok2==1){
            if(want==0){return a;}
            want=want-1;
        }
        a=a+1;
    }
    return -1;
}

// ev with v6 staging (no isolation modes — this is the full mix).
fn ev6(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,natoms:i64,lastuse:[]u8,cls:i64,cl:i64,tsec:f64,ratio:f64,gain:f64,seed:i64,stm:i64,usedcl:[]u8)i64{
    let start:i64=((tsec*44100.0) as i64);
    let ai:i64=-1;
    let tr:i64=0;
    while(tr<8){
        let cand:i64=pick_atom(atab,natoms,cls,cl,seed,stm+tr*77);
        if(cand<0){tr=tr+1;}else{
            let lu:i64=get64(lastuse,cand*8);
            if(start-lu>132300){ai=cand;tr=8;}else{tr=tr+1;}
        }
    }
    if(ai<0){return -1;}
    put64(lastuse,ai*8,start);
    let tp:f64=0.70;
    if(cls==1){tp=0.75;}
    if(cls==2){tp=0.55;}
    place_event_v6(mix,nsamp,wave,atab,ai,start,ratio,tp,gain,cls_refpk(cls));
    if(cls==0 || cls==1){
        let c2:i64=at_get32(atab,ai,4);
        if(c2>=0 && c2<8){put64(usedcl,c2*8,1);}
    }
    return ai;
}

// ---------- score: the kids playground, composed through 30 s ----------
// Same seed (6101), same composed beats, same hash streams as v5's clip
// (c) for 0-26.4 s (event SELECTION there is hash-identical, so the A/B
// is clean). Differences: the v2 "natural ending" reserves are PLACED
// (4th footstep ~27.1 s, laugh at 27.0 s, call at 28.6 s), the grammar
// fill runs to 29.2 s, and two composed tail events breathe the ending
// out into the bed. No dead head (bed from t=0), no dead tail.
fn score_kids_v6(mix:[]u8,nsamp:i64,wave:[]u8,atab:[]u8,natoms:i64,bigram:[]u8,gapq:[]u8)void{
    let seed:i64=6101;
    let lup:*u8=_zag_malloc(natoms*8) as *u8;
    let lastuse:[]u8=lup[0..(natoms*8)];
    let ucp:*u8=_zag_malloc(64) as *u8;
    let usedcl:[]u8=ucp[0..64];
    let i:i64=0;
    while(i<natoms){put64(lastuse,i*8,-1000000000);i=i+1;}
    i=0;
    while(i<64){usedcl[i]=0;i=i+1;}
    let stm:i64=0;
    // --- composed beats (identical selection to v5 clip c) ---
    ev6(mix,nsamp,wave,atab,natoms,lastuse,1,0,0.6,1.0,0.95,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,1,1,1.15,0.97,0.9,seed,stm,usedcl);stm=stm+1;
    let ft:f64=1.6;
    let fg:f64=0.30;
    let fi:i64=0;
    while(fi<6){
        ev6(mix,nsamp,wave,atab,natoms,lastuse,2,-1,ft,1.02,0.8,seed,stm,usedcl);stm=stm+1;
        ft=ft+fg;fg=fg*0.88;fi=fi+1;
    }
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,2,2.2,1.05,0.85,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,1,0,4.5,0.96,0.95,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,1,5.2,1.0,0.75,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,2,5.35,1.03,0.75,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,0,5.55,0.98,0.75,seed,stm,usedcl);stm=stm+1;
    ft=7.0;fg=0.24;fi=0;
    while(fi<5){
        ev6(mix,nsamp,wave,atab,natoms,lastuse,2,-1,ft,1.0,0.8,seed,stm,usedcl);stm=stm+1;
        ft=ft+fg;fg=fg*0.92;fi=fi+1;
    }
    ev6(mix,nsamp,wave,atab,natoms,lastuse,1,1,8.0,1.0,0.95,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,2,9.2,1.06,0.9,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,1,0,11.0,1.0,1.0,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,1,12.0,1.02,0.75,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,2,12.25,0.97,0.9,seed,stm,usedcl);stm=stm+1;
    // stumble
    ev6(mix,nsamp,wave,atab,natoms,lastuse,2,-1,14.5,1.0,0.85,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,2,-1,14.7,1.05,0.85,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,2,-1,14.79,0.95,0.85,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,2,-1,15.3,0.80,1.0,seed,stm,usedcl);stm=stm+1; // thud
    ev6(mix,nsamp,wave,atab,natoms,lastuse,1,2,15.7,1.12,0.8,seed,stm,usedcl);stm=stm+1;  // gasp
    // THE TUMBLE
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,2,16.2,1.04,0.8,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,0,16.45,0.95,0.8,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,1,16.75,0.87,0.8,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,2,17.1,0.92,0.75,seed,stm,usedcl);stm=stm+1;
    // rolling laughter, density decreasing
    let lt:f64=18.0;
    let lg:f64=0.6;
    let li:i64=0;
    while(li<6){
        ev6(mix,nsamp,wave,atab,natoms,lastuse,0,-1,lt,0.90+0.10*h01(seed,stm),0.85,seed,stm,usedcl);stm=stm+1;
        lt=lt+lg;lg=lg*1.35;li=li+1;
    }
    ev6(mix,nsamp,wave,atab,natoms,lastuse,1,0,24.5,0.94,0.85,seed,stm,usedcl);stm=stm+1;
    // footsteps: v6 PLACES the 4th (~27.1 s) — no more reserved cutoff
    ft=25.5;fg=0.40;fi=0;
    while(fi<4){
        ev6(mix,nsamp,wave,atab,natoms,lastuse,2,-1,ft,0.95,0.7,seed,stm,usedcl);
        stm=stm+1;
        ft=ft+fg;fg=fg*1.3;fi=fi+1;
    }
    // v6 ending: the 27.0 s laugh and 28.6 s call are PLACED (v2/v5
    // reserved them, leaving the 3.4 s dead tail). The ending breathes
    // out into the bed instead of stopping.
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,2,27.0,0.95,0.75,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,1,1,28.6,1.0,0.70,seed,stm,usedcl);stm=stm+1;
    // --- grammar fill: hash-walk over studied bigrams/gap quantiles,
    // --- runs to 29.2 s (v5 stopped at 26.0 s)
    let prev:i64=1;
    let cur:f64=0.2;
    let clrot:i64=0;
    while(cur<29.2){
        let row:i64=prev*4;
        let tot:i64=0;
        let cc:i64=0;
        while(cc<4){
            tot=tot+get32(bigram,(row+cc)*4);
            cc=cc+1;
        }
        let nxt:i64=prev;
        if(tot>0){
            let r:i64=((h01(seed,stm) as f64)*(tot as f64)) as i64;
            if(r>=tot){r=tot-1;}
            cc=0;
            let acc2:i64=0;
            while(cc<4){
                acc2=acc2+get32(bigram,(row+cc)*4);
                if(r<acc2){nxt=cc;cc=4;}else{cc=cc+1;}
            }
        }else{
            nxt=(h32(seed,stm) % 3);
        }
        let p10:f64=(get32s(gapq,(nxt*3)*4) as f64)/1000.0;
        let p90:f64=(get32s(gapq,(nxt*3+2)*4) as f64)/1000.0;
        if(p90<p10){p90=p10;}
        let gp:f64=p10+(p90-p10)*h01(seed,stm+1);
        cur=cur+gp*1.0;
        if(cur<29.2 && (nxt==0 || nxt==1 || nxt==2)){
            let clw:i64=-1;
            if(nxt==0 || nxt==1){clw=clrot % 3;clrot=clrot+1;}
            let ratio:f64=0.90+0.24*h01(seed,stm+2);
            let gain:f64=0.55+0.20*h01(seed,stm+3);
            ev6(mix,nsamp,wave,atab,natoms,lastuse,nxt,clw,cur,ratio,gain,seed,stm+4,usedcl);
        }
        stm=stm+5;
        prev=nxt;
    }
    // two composed tail breaths (distant, soft) so the ending is
    // deliberate: a receding footstep and a far laugh decaying into air
    ev6(mix,nsamp,wave,atab,natoms,lastuse,2,-1,28.2,0.90,0.50,seed,stm,usedcl);stm=stm+1;
    ev6(mix,nsamp,wave,atab,natoms,lastuse,0,-1,29.0,0.85,0.55,seed,stm,usedcl);stm=stm+1;
    print_str("kids v8: voices(clusters) used:");
    let vc:i64=0;
    while(vc<4){
        if(get64(usedcl,vc*8)==1){print_str(" ");print_i64(vc);}
        vc=vc+1;
    }
    print_nl();
}

// ---------- mastering: limit ONLY on actual clipping ----------
// v5's x/(1+0.35|x|) ran on every sample: 3.6% THD at event peaks,
// 2.7% at typical levels — a permanent grit floor. v6 keeps DC
// removal, FIXPEAK normalization and 30 ms raised ends, but the
// limiter engages only above 0.95 FS (soft knee to 1.0). Below that
// the path is transparent: zero added THD by construction.
fn wav_write_v8(path:[]u8,m:[]u8,nsamp:i64)i64{
    let dsum:f64=0.0;
    let s:i64=0;
    while(s<nsamp){
        dsum=dsum+((get64(m,s*8) as f64)/16777216.0);
        s=s+1;
    }
    let dc:f64=dsum/(nsamp as f64);
    let peak:i64=0;
    s=0;
    while(s<nsamp){
        let v:i64=get64(m,s*8)-((dc*16777216.0) as i64);
        if(v<0){v=-v;}
        if(v>peak){peak=v;}
        s=s+1;
    }
    print_str("mixpeak=");print_i64(peak);print_nl();
    let norm:f64=1.0;
    if(FIXPEAK>0){norm=0.891250938*16777216.0/(FIXPEAK as f64);}
    else{if(peak>0){norm=0.891250938*16777216.0/(peak as f64);}} // -1 dB
    let p:*u8=_zag_malloc(44+nsamp*2) as *u8;
    if(p==null as *u8){return -2;}
    let out:[]u8=p[0..(44+nsamp*2)];
    let i:i64=0;
    while(i<44+nsamp*2){out[i]=0;i=i+1;}
    out[0]=82;out[1]=73;out[2]=70;out[3]=70;
    put32(out,4,36+nsamp*2);
    out[8]=87;out[9]=65;out[10]=86;out[11]=69;
    out[12]=102;out[13]=109;out[14]=116;out[15]=32;
    put32(out,16,16);
    put16(out,20,1);put16(out,22,1);
    put32(out,24,44100);put32(out,28,88200);
    put16(out,32,2);put16(out,34,16);
    out[36]=100;out[37]=97;out[38]=116;out[39]=97;
    put32(out,40,nsamp*2);
    let fade:i64=1323; // 30 ms
    let limited:i64=0;
    s=0;
    while(s<nsamp){
        let v:i64=get64(m,s*8);
        let x:f64=((v as f64)/16777216.0-dc)*norm;
        if(s<fade){x=x*sstep((s as f64)/(fade as f64));}
        let rem:i64=nsamp-s;
        if(rem<fade){x=x*sstep((rem as f64)/(fade as f64));}
        let ax:f64=x;
        if(ax<0.0){ax=-ax;}
        if(ax>0.95){
            // genuine limiter: soft knee 0.95 -> 1.0, idle otherwise
            let ov:f64=ax-0.95;
            let lim:f64=0.95+0.05*ov/(1.0+ov);
            x=(x/ax)*lim;
            limited=limited+1;
        }
        put16(out,44+s*2,(x*32767.0) as i64);
        s=s+1;
    }
    print_str("limited_samples=");print_i64(limited);print_nl();
    let rc:i64=file_write(path,out);
    _zag_free(_zag_slice_ptr(out));
    return rc;
}

// append_tx: load a second catalog file and append selected textures
// (by index) to txtab/txwave. Used to gather steady bed textures from
// catalog2.bin / catalog3.bin alongside catalog.bin's. Returns the new
// texture count; woff_out receives the new wave offset. Silent no-op
// (returns inputs) if the file is missing/invalid - the bed then uses
// only catalog.bin's textures.
fn append_tx(txtab:[]u8,txwave:[]u8,ntex0:i64,woff:i64,path:[]u8,idx:[]u8,nidx:i64,woff_out:*i64)i64{
    let raw:[]u8=file_read(path,60000000);
    if(raw.len<16){woff_out.*=woff;return ntex0;}
    if(raw[0]!=66||raw[1]!=65||raw[2]!=76||raw[3]!=50){woff_out.*=woff;return ntex0;}
    let natoms:i64=get32(raw,4);
    let pos:i64=16;
    let a:i64=0;
    while(a<natoms){
        let ln:i64=get32(raw,pos+12);
        pos=pos+16+ln*2+24;
        a=a+1;
    }
    let ntex:i64=get32(raw,pos);
    pos=pos+4;
    let nt:i64=ntex0;
    let wo:i64=woff;
    let t:i64=0;
    while(t<ntex){
        let ln2:i64=get32(raw,pos);
        // is t in idx[]?
        let want:i64=0;
        let q:i64=0;
        while(q<nidx){
            if(get64(idx,q*8)==t){want=1;}
            q=q+1;
        }
        if(want==1){
            put32(txtab,nt*16,ln2);
            put64(txtab,nt*16+8,wo);
            let k:i64=0;
            while(k<ln2){
                put16(txwave,wo+k*2,get16s(raw,pos+4+k*2));
                k=k+1;
            }
            wo=wo+ln2*2;
            nt=nt+1;
        }
        pos=pos+4+ln2*2;
        t=t+1;
    }
    woff_out.*=wo;
    return nt;
}

fn main()i32{
    let subj:[]u8=_zag_arg(1);
    let catp:[]u8=_zag_arg(2);
    let outp:[]u8=_zag_arg(3);
    if(subj.len==0 || catp.len==0 || outp.len==0){return 31;}
    let which:i64=0;
    if(_zag_strcmp(subj,"kidf")==1){which=16;}
    if(which==0){return 32;}
    let dur_s:i64=30;
    // ---- catalog load (inlined; ZNC-WORKAROUND: separate loader fns
    // ---- miscompile bed() in larger binaries) ----
    let raw:[]u8=file_read(catp,60000000);
    if(raw.len<16){return -1;}
    if(raw[0]!=66||raw[1]!=65||raw[2]!=76||raw[3]!=50){return -2;}
    let natoms:i64=get32(raw,4);
    let ap:*u8=_zag_malloc(900*24) as *u8;
    let atab:[]u8=ap[0..(900*24)];
    let wp:*u8=_zag_malloc(32505856) as *u8;
    let wave:[]u8=wp[0..32505856];
    let pos:i64=16;
    let woff0:i64=0;
    let a:i64=0;
    while(a<natoms){
        let cls:i64=get32(raw,pos);
        let clu:i64=get32(raw,pos+4);
        let fno:i64=get32(raw,pos+8);
        let ln:i64=get32(raw,pos+12);
        put32(atab,a*24,cls);
        put32(atab,a*24+4,clu);
        put32(atab,a*24+8,ln);
        put64(atab,a*24+16,woff0);
        put32(atab,a*24+12,fno);
        let k:i64=0;
        while(k<ln){
            put16(wave,woff0+k*2,get16s(raw,pos+16+k*2));
            k=k+1;
        }
        woff0=woff0+ln*2;
        pos=pos+16+ln*2+24;
        a=a+1;
    }
    let ntex:i64=get32(raw,pos);
    pos=pos+4;
    let tp:*u8=_zag_malloc(160*16) as *u8;
    let txtab:[]u8=tp[0..(160*16)];
    let xp:*u8=_zag_malloc(12582912) as *u8;
    let txwave:[]u8=xp[0..12582912];
    let woff:i64=0;
    let t:i64=0;
    while(t<ntex){
        let ln:i64=get32(raw,pos);
        put32(txtab,t*16,ln);
        put64(txtab,t*16+8,woff);
        let k:i64=0;
        while(k<ln){
            put16(txwave,woff+k*2,get16s(raw,pos+4+k*2));
            k=k+1;
        }
        woff=woff+ln*2;
        pos=pos+4+ln*2;
        t=t+1;
    }
    // Pull steady bed textures from the sibling catalog (same
    // directory, relative path). Modulation-spectrum audit 2026-09-23:
    // catalog3 tx1/tx4/tx10/tx11/tx12 are the cleanest studied washes
    // (all <=6.8% in 0.5-2 Hz and <=4.9% in 2-5 Hz); catalog2's carry
    // 20-50% 2-5 Hz AM and are excluded. Appended at txtab 13..17.
    // catalog.bin's own tx4 (txtab 4) completes the six.
    let wop:*u8=_zag_malloc(8) as *u8;
    let woffp:*i64=wop as *i64;
    let c3i:*u8=_zag_malloc(5*8) as *u8;
    let c3idx:[]u8=c3i[0..(5*8)];
    put64(c3idx,0*8,1);put64(c3idx,1*8,4);put64(c3idx,2*8,10);
    put64(c3idx,3*8,11);put64(c3idx,4*8,12);
    let c3p:[]u8="catalog3.bin";
    woffp.*=woff;
    let ntex3:i64=append_tx(txtab,txwave,ntex,woff,c3p,c3idx,5,woffp);
    woff=woffp.*;
    _zag_free(wop);
    _zag_free(c3i);
    let bp:*u8=_zag_malloc(64) as *u8;
    let bigram:[]u8=bp[0..64];    let gqp:*u8=_zag_malloc(48) as *u8;
    let gapq:[]u8=gqp[0..48];
    let b2:i64=0;
    while(b2<16){
        put32(bigram,b2*4,get32(raw,pos+b2*4));
        b2=b2+1;
    }
    pos=pos+64;
    let c:i64=0;
    while(c<12){
        put32(gapq,c*4,get32s(raw,pos+c*4));
        c=c+1;
    }
    // ---- render ----
    let nsamp:i64=dur_s*44100;
    let mp:*u8=_zag_malloc(nsamp*8) as *u8;
    let mix:[]u8=mp[0..(nsamp*8)];
    let z:i64=0;
    while(z<nsamp*8){mix[z]=0;z=z+1;}
    // ZNC-WORKAROUND 2026-09-22: bed_v8() called directly from main.
    bed_v8(mix,nsamp,txtab,txwave,6101);
    score_kids_v6(mix,nsamp,wave,atab,natoms,bigram,gapq);
    let rc:i64=wav_write_v8(outp,mix,nsamp);
    print_str("render rc=");print_i64(rc);print_nl();
    return (rc<0) as i32;
}

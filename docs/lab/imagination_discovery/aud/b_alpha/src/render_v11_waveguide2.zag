@import("common_v5.zag")
// ============================================================
// FORK W2 — child-scale digital-waveguide vocal tract, ITERATION ROUND.
// Tract redesign, not a tune-up (see ITERATION_PLAN_v11_waveguide2.md).
//
// WHAT CHANGED vs round-1 (render_v11_waveguide.zag):
//   The two-mass self-oscillating aerodynamic fold model is REPLACED by
//   a driven kinematic myoelastic fold oscillator. Round-1 probe data
//   proved the old driver is aerodynamically driven (VdP GAMMA=0.004 <
//   tissue damping D1=0.005): /a/ voices via a mucosal-wave loop (psup
//   swings +-100 Pa) while /i/,/e/,/o/,/u/ sit at static equilibrium
//   (x1 pp < 2 um, psup static) because tract acoustic feedback
//   collapses for constricted tracts. No parameter tune can fix that:
//   the energy input vanishes exactly when the tract is constricted.
//   (Full mechanism in the iteration plan.)
//
//   New driver: tension-controlled phase oscillator -> skewed glottal
//   area waveform -> orifice flow with back-pressure (source-filter
//   coupling at the FLOW level is preserved; the mechanical
//   tract->fold feedback path is dropped). Psub servo (respiratory
//   effort vs tract load) + phonation-state gesture sequencer
//   (inhale/attack/sustain/release, after Sol Paradigm 2) drive the
//   UNCHANGED 13-section Kelly-Lochbaum child waveguide tract.
//
// WHAT DID NOT CHANGE: 13-section/9cm tract, 5 vowel area LUTs (shapes
//   revised, see vowel_area), lip radiation, 6-delay subglottal
//   breath-noise tube, hash-noise streams, footsteps/wind/birds.
//   Pure Zag, zero RNG in render path, deterministic.
//
// Modes (argv[1]):
//   vowel <v> <f0> <dur_s> <out.wav> : fixed vowel v, fixed F0 -> WAV
//   scene <out.wav>                  : full 30 s playground scene -> WAV
// ============================================================

// ---- math helpers ----
fn fsinr(x:f64)f64{
    let twopi:f64=6.283185307179586;
    let q:f64=x/twopi;
    let qi:i64=(q as i64);
    if(q<0.0){
        if((qi as f64)!=q){qi=qi-1;}
    }
    let r:f64=x-(qi as f64)*twopi;
    if(r>3.141592653589793){r=r-twopi;}
    let s:f64=1.0;
    if(r>1.5707963267948966){
        r=3.141592653589793-r;
    }else{
        if(r<-1.5707963267948966){r=-3.141592653589793-r;s=-1.0;}
    }
    let x2:f64=r*r;
    let x4:f64=x2*x2;
    return s*(r-r*x2/6.0+r*x4/120.0-r*x4*x2/5040.0+r*x4*x4/362880.0);
}
// exp with range reduction (correct for large |x|; round-1 Taylor
// fexp was wrong for x < -2, e.g. footstep/bird envelopes).
fn fexp(x:f64)f64{
    if(x<-30.0){return 0.0;}
    if(x>30.0){return 10686474581524.0;}
    let ln2:f64=0.6931471805599453;
    let k:i64=((x/ln2)+0.5) as i64;
    if(x<0.0){k=((x/ln2)-0.5) as i64;}
    let r:f64=x-(k as f64)*ln2;
    let r2:f64=r*r;
    let p:f64=1.0+r+r2/2.0+r2*r/6.0+r2*r2/24.0+r2*r2*r/120.0;
    let e:f64=p;
    let n:i64=0;
    if(k>0){
        while(n<k){e=e*2.0;n=n+1;}
    }else{
        while(n>k){e=e*0.5;n=n-1;}
    }
    return e;
}
fn smoother(x:f64)f64{
    if(x<=0.0){return 0.0;}
    if(x>=1.0){return 1.0;}
    return x*x*x*(10.0-15.0*x+6.0*x*x);
}

// ---- voice state block (all f64), 144 slots ----
//  0..13  L[14]    (right-going waves arriving at junctions 0..13)
// 14..27  R[14]    (left-going waves arriving at junctions 0..13)
// 28..39  rc[12]   (internal junction reflection coeffs)
// 40..52  area[13] (current section areas, cm2)
// 53 phase (cycles 0..1) | 54 F0cur | 55 Amax (m2) | 56 Psub (Pa)
// 57 radPrev | 58 ncount | 59 F0target | 60 cycJit | 61 cycShim
// 62 Ptarget | 63 damp
// 64 srcGain | 65 leakGain | 66 vgain | 67 rg
// 70 ampEnv | 71 meanU | 72 agFrac | 73 psupPa
// 74..101 scratch L2[14]/R2[14]
// 102 phon | 108..119 subglottal delay lines
// 122 oq (open quotient) | 123 psupMean
// 128 time(s) | 129 closure | 130 burstEnv | 131 inhale | 132 burst
// 133 vibDepth | 134 vibRate | 135 baseF0 | 136 shapeCode | 137 AminFrac
// 138 inhaleLP | 139 burstPrev | 140 inhaleEnv | 68 cycCount
fn g(s:*f64,i:i64)f64{
    let q:*f64=((s as i64)+i*8) as *f64;
    return q.*;
}
fn p(s:*f64,i:i64,v:f64)void{
    let q:*f64=((s as i64)+i*8) as *f64;
    q.*=v;
    return;
}
fn valloc() *f64{
    let mp:*u8=_zag_malloc(144*8) as *u8;
    if(mp==null as *u8){return (0 as i64) as *f64;}
    let s:*f64=(mp as i64) as *f64;
    let i:i64=0;
    while(i<144){p(s,i,0.0);i=i+1;}
    return s;
}

// ---- child vowel area-function LUTs (13 sections, cm2, glottis->lips) ----
// /a/ kept from round-1 (measured F1B 787 ~= anchor 794). /i/ redesigned
// with a genuine palatal constriction (0.4 cm2) + open back/lips —
// round-1's widened 0.9 cm2 constriction was part of why /i/ was dark;
// voicing is now guaranteed by the driven fold so the LUT can be honest.
// vowel 0=/a/ 1=/i/ 2=/u/ 3=/e/ 4=/o/
fn vowel_area(v:i64,i:i64)f64{
    if(v==0){
        // /a/: distinct pharyngeal constriction (i=2,3) to split F1/F2
        if(i==0){return 1.0;}
        if(i==1){return 0.8;}
        if(i==2){return 0.5;}
        if(i==3){return 0.5;}
        if(i==4){return 0.7;}
        if(i==5){return 1.0;}
        if(i==6){return 1.4;}
        if(i==7){return 1.8;}
        if(i==8){return 2.2;}
        if(i==9){return 2.6;}
        if(i==10){return 3.0;}
        if(i==11){return 3.2;}
        return 3.0;
    }
    if(v==1){
        // /i/: tight palatal constriction, narrow front cavity
        // (brings F2 down from 5k to ~3k)
        if(i==0){return 2.0;}
        if(i==1){return 1.8;}
        if(i==2){return 1.5;}
        if(i==3){return 1.0;}
        if(i==4){return 0.5;}
        if(i==5){return 0.3;}
        if(i==6){return 0.4;}
        if(i==7){return 0.6;}
        if(i==8){return 0.8;}
        if(i==9){return 1.0;}
        if(i==10){return 1.2;}
        if(i==11){return 1.0;}
        return 0.8;
    }
    if(v==2){
        if(i==0){return 1.8;}
        if(i==1){return 1.5;}
        if(i==2){return 1.2;}
        if(i==3){return 1.0;}
        if(i==4){return 1.1;}
        if(i==5){return 1.4;}
        if(i==6){return 1.8;}
        if(i==7){return 2.0;}
        if(i==8){return 1.8;}
        if(i==9){return 1.4;}
        if(i==10){return 1.0;}
        if(i==11){return 0.6;}
        return 0.4;
    }
    if(v==3){
        // /e/: moderate palatal constriction, mid front cavity
        if(i==0){return 1.5;}
        if(i==1){return 1.4;}
        if(i==2){return 1.2;}
        if(i==3){return 1.0;}
        if(i==4){return 0.7;}
        if(i==5){return 0.5;}
        if(i==6){return 0.7;}
        if(i==7){return 1.0;}
        if(i==8){return 1.4;}
        if(i==9){return 1.8;}
        if(i==10){return 2.0;}
        if(i==11){return 1.8;}
        return 1.5;
    }
    if(i==0){return 2.0;}
    if(i==1){return 1.8;}
    if(i==2){return 1.5;}
    if(i==3){return 1.3;}
    if(i==4){return 1.4;}
    if(i==5){return 1.6;}
    if(i==6){return 1.8;}
    if(i==7){return 1.8;}
    if(i==8){return 1.6;}
    if(i==9){return 1.2;}
    if(i==10){return 0.9;}
    if(i==11){return 0.6;}
    return 0.5;
}
fn areas_to_rc(s:*f64)void{
    let j:i64=0;
    while(j<12){
        let a0:f64=g(s,40+j);
        let a1:f64=g(s,40+j+1);
        let r:f64=0.0;
        if(a0+a1>0.0001){r=(a0-a1)/(a0+a1);}
        p(s,28+j,r);
        j=j+1;
    }
    return;
}
fn vowel_set(s:*f64,v:i64)void{
    let i:i64=0;
    while(i<13){p(s,40+i,vowel_area(v,i));i=i+1;}
    areas_to_rc(s);
    return;
}
fn vowel_glide(s:*f64,v:i64,f:f64)void{
    let i:i64=0;
    while(i<13){
        let cur:f64=g(s,40+i);
        let tgt:f64=vowel_area(v,i);
        p(s,40+i,cur+(tgt-cur)*f);
        i=i+1;
    }
    areas_to_rc(s);
    return;
}
// labial-closure gesture: all sections -> 0.3 cm2 (consonant onsets)
fn vowel_close(s:*f64,f:f64)void{
    let i:i64=0;
    while(i<13){
        let cur:f64=g(s,40+i);
        p(s,40+i,cur+(0.3-cur)*f);
        i=i+1;
    }
    areas_to_rc(s);
    return;
}

// ---- subglottal waveguide: 6-section uniform tube (child trachea) ----
// (unchanged from round-1; deviation from Sol's 1.4 cm documented there)
fn sg_tick(s:*f64,noise:f64)f64{
    let damp:f64=0.995;
    let b0:f64=g(s,114);
    let outp:f64=noise+b0;
    let nb5:f64=0.9*g(s,113)*damp;
    let i:i64=0;
    while(i<5){p(s,114+i,g(s,114+i+1)*damp);i=i+1;}
    p(s,119,nb5);
    i=5;
    while(i>0){p(s,108+i,g(s,108+i-1)*damp);i=i-1;}
    p(s,108,noise);
    return outp;
}

// ---- main vocal-tract waveguide tick (one audio sample, unchanged) ----
fn wg_tick(s:*f64,src:f64,nsg:f64)f64{
    let damp:f64=g(s,63);
    let rg:f64=g(s,67);
    let r0:f64=g(s,14);
    let l0:f64=rg*r0+src+nsg;
    let l13:f64=g(s,13);
    let rl:f64=-0.7;
    let r13:f64=rl*l13;
    let rad:f64=(1.0+rl)*l13;
    p(s,73,(r0+l0)*1000.0);
    let j:i64=1;
    while(j<13){
        let u:f64=g(s,j);
        let v:f64=g(s,14+j);
        let r:f64=g(s,28+j-1);
        let outR:f64=(1.0+r)*u-r*v;
        let outL:f64=r*u+(1.0-r)*v;
        p(s,74+j+1,outR*damp);
        p(s,88+j-1,outL*damp);
        j=j+1;
    }
    p(s,75,l0*damp);
    p(s,100,r13*damp);
    p(s,74,0.0);
    p(s,101,0.0);
    j=0;
    while(j<14){
        p(s,j,g(s,74+j));
        p(s,14+j,g(s,88+j));
        j=j+1;
    }
    let rp:f64=g(s,57);
    p(s,57,rad);
    let vg:f64=g(s,66);
    return (rad-rp)*vg;
}

// ---- DRIVEN KINEMATIC FOLD OSCILLATOR (v2, replaces two-mass) ----
// Phase oscillator at prescribed F0(t); glottal area = skewed pulse.
// Energy input is explicit (tension control + Psub servo), NOT emergent
// from aerodynamics — the round-1 self-oscillating model was proven
// (probe data, iteration plan §1) to be aerodynamically driven with
// loop gain < 1 for constricted tracts, i.e. unfixable by tuning.
//
// Per-sample inputs (set by the gesture sequencer):
//   59 F0target | 133 vibDepth | 134 vibRate | 135 baseF0 (info)
//   55 Amax (m2) | 137 AminFrac | 122 oq | 136 shapeCode (0 pressed,
//     1 modal, 2 breathy) | 102 phon | 62 Ptarget
// Per-sample outputs: 54 F0cur | 71 meanU | 72 agFrac | 56 Psub (servo)
const DTSUB:f64=0.000005668934240362812; // 1/(44100*4)
const RHOF:f64=1.14;
const CDF:f64=0.7;

fn fold2_voice_tick(s:*f64,n:i64,seed:i64)f64{
    let t:f64=g(s,128);
    let f0t:f64=g(s,59);
    let vd:f64=g(s,133);
    let vr:f64=g(s,134);
    let twopi:f64=6.283185307179586;
    // deterministic vibrato + deterministic motor noise (3 incommensurate
    // sines, +-1.5%): the child "unsteady" quality without RNG.
    let vib:f64=1.0+vd*fsinr(twopi*vr*t);
    let mn:f64=0.015*(fsinr(twopi*23.0*t)+0.6*fsinr(twopi*31.0*t+1.7)
        +0.4*fsinr(twopi*47.0*t+0.6))/2.0;
    let f0:f64=f0t*vib*(1.0+mn);
    p(s,54,f0);
    let phon:f64=g(s,102);
    // amplitude envelope: 10 ms attack / 15 ms release (click-free)
    let env:f64=g(s,70);
    let etarget:f64=0.0;
    let tau:f64=0.015;
    if(phon>0.5){etarget=1.0;tau=0.010;}
    let ce:f64=1.0-fexp(-1.0/(tau*44100.0));
    env=env+(etarget-env)*ce;
    p(s,70,env);
    // clean phase restart at each onset (env still ~0 -> no click)
    let phase:f64=g(s,53);
    if(phon>0.5&&env<0.05){phase=0.0;}
    let Amax:f64=g(s,55);
    let Amin:f64=Amax*g(s,137);
    let oq:f64=g(s,122);
    let shape:i64=(g(s,136) as i64);
    let Psub:f64=g(s,56);
    let psup:f64=g(s,73);
    let usum:f64=0.0;
    let asum:f64=0.0;
    // per-cycle jitter/shimmer (deterministic, hashed cycle index):
    // +-2% F0, +-3% amplitude, cycle-to-cycle. Smears the harmonic comb
    // within the LPC window so tract resonances emerge as peaks
    // (without it the spectrum is too clean for the peak-picker and
    // child jitter >1.5% is itself a child-likeness cue, Sol §5 M9).
    let jit:f64=g(s,60);
    if(jit==0.0){jit=1.0;}
    let shim:f64=g(s,61);
    if(shim==0.0){shim=1.0;}
    let q:i64=0;
    while(q<4){
        phase=phase+f0*DTSUB*jit;
        if(phase>=1.0){
            phase=phase-1.0;
            let cc:i64=(g(s,68) as i64)+1;
            p(s,68,cc as f64);
            jit=1.0+0.02*(2.0*h01(6000+seed,cc)-1.0);
            shim=1.0+0.03*(2.0*h01(7000+seed,cc)-1.0);
            p(s,60,jit);
            p(s,61,shim);
        }
        // skewed glottal pulse: fast opening, shape-controlled closing
        let pw:f64=0.0;
        if(phase<oq){
            let w:f64=fsinr(3.141592653589793*phase/oq);
            if(w<0.0){w=0.0;}
            if(shape==0){pw=w*w;}
            else{
                if(shape==2){pw=fsqrt(w);}
                else{pw=w*fsqrt(w);}
            }
        }
        let a:f64=(Amin+(Amax-Amin)*pw)*env*shim;
        // orifice flow with discharge coefficient; supraglottal
        // back-pressure modulates the flow (source-filter coupling).
        let dp:f64=Psub-psup;
        if(dp<0.0){dp=0.0;}
        let U:f64=CDF*a*fsqrt(2.0*dp/RHOF);
        usum=usum+U;
        asum=asum+a;
        q=q+1;
    }
    p(s,53,phase);
    let um:f64=usum/4.0;
    let am:f64=asum/4.0;
    p(s,71,um);
    let Aref:f64=2.0*0.007*0.00015;
    let agf:f64=am/Aref;
    if(agf>1.0){agf=1.0;}
    p(s,72,agf);
    // Psub servo (respiratory effort vs tract load): holds the
    // transglottal pressure at Ptarget; relaxes to rest when unvoiced.
    let Ptarget:f64=g(s,62);
    let pm:f64=g(s,123);
    let cs:f64=1.0-fexp(-1.0/(0.10*44100.0));
    pm=pm+(psup-pm)*cs;
    p(s,123,pm);
    let pgoal:f64=Ptarget+pm;
    if(phon<0.5&&env<0.05&&g(s,129)<0.5){pgoal=300.0;}
    Psub=Psub+(pgoal-Psub)*cs;
    if(Psub<200.0){Psub=200.0;}
    if(Psub>2500.0){Psub=2500.0;}
    p(s,56,Psub);
    p(s,128,t+1.0/44100.0);
    p(s,58,g(s,58)+1.0);
    // glottal injection + subglottal-colored breath noise -> tract
    let a0:f64=g(s,40)*0.0001;
    let z0w:f64=399.0/a0/1000.0;
    let src:f64=um*z0w*0.5*g(s,64);
    let nz:f64=2.0*h01(seed,n)-1.0;
    let namp:f64=g(s,65)*(0.05+0.95*agf);
    let sgout:f64=sg_tick(s,nz*namp);
    let rad:f64=wg_tick(s,src,sgout);
    let rg:f64=0.95-0.5*agf;
    if(rg<0.3){rg=0.3;}
    p(s,67,rg);
    return rad;
}

// ---- arg parsing helpers ----
fn parsef(s:[]u8)f64{
    let neg:f64=1.0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=-1.0;i=1;}
    }
    let ip:f64=0.0;
    while(i<(s.len as i64)){
        let c:u8=s[i];
        if(c==46){break;}
        if(c>=48&&c<=57){ip=ip*10.0+((c-48) as f64);}
        i=i+1;
    }
    let fp:f64=0.0;
    let div:f64=10.0;
    if(i<(s.len as i64)){
        i=i+1;
        while(i<(s.len as i64)){
            let c:u8=s[i];
            if(c>=48&&c<=57){fp=fp+((c-48) as f64)/div;div=div*10.0;}
            i=i+1;
        }
    }
    return neg*(ip+fp);
}
fn parsei(s:[]u8)i64{
    let neg:i64=1;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=-1;i=1;}
    }
    let v:i64=0;
    while(i<(s.len as i64)){
        let c:u8=s[i];
        if(c>=48&&c<=57){v=v*10+((c-48) as i64);}
        i=i+1;
    }
    return neg*v;
}
fn str_eq(a:[]u8,b:[]u8)i64{
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<(a.len as i64)){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}
// voice defaults (shared by vowel probe + scene)
fn voice_init(s:*f64,baseF0:f64)void{
    vowel_set(s,0);
    p(s,55,0.10*0.0001);   // Amax modal = 0.10 cm2 -> m2
    p(s,56,900.0);         // Psub start (servo settles it)
    p(s,59,baseF0);
    p(s,62,600.0);         // Ptarget: transglottal pressure
    p(s,63,0.9985);        // tract damping
    p(s,64,1.0);           // srcGain
    p(s,65,0.0011);        // leakGain (breath noise; tuned w/ HNR)
    p(s,66,300.0);         // vgain
    p(s,67,0.9);
    p(s,102,0.0);
    p(s,122,0.62);         // oq modal
    p(s,133,0.03);         // vibDepth
    p(s,134,5.5);          // vibRate
    p(s,135,baseF0);
    p(s,136,1.0);          // shape modal
    p(s,137,0.15);         // AminFrac modal
    return;
}
// phonation-state preset: 0 pressed, 1 modal, 2 breathy
fn phon_preset(s:*f64,st:i64)void{
    if(st==0){
        p(s,55,0.12*0.0001);p(s,122,0.55);p(s,136,0.0);p(s,137,0.08);
    }else{
        if(st==2){
            p(s,55,0.09*0.0001);p(s,122,0.70);p(s,136,2.0);p(s,137,0.30);
        }else{
            p(s,55,0.10*0.0001);p(s,122,0.62);p(s,136,1.0);p(s,137,0.15);
        }
    }
    return;
}

// ---- utterance tables ----
// utt(vi,k,s): writes 103..107 = t0,t1,vowel,f0mult,kind; t0=-1 if none.
// kind: 0 normal call, 1 shout, 2 laugh, 3 soft sustain.
// vowel: 0=/a/ 1=/i/ 2=/u/ 3=/e/ 4=/o/
// SCENE D: 20 utterances, dense, f0m 0.80..1.45, for 7/9 bars.
fn utt(vi:i64,k:i64,s:*f64)void{
    p(s,103,-1.0);p(s,104,0.0);p(s,105,0.0);p(s,106,1.0);p(s,107,0.0);
    if(vi==0){
        if(k==0){p(s,103,1.0);p(s,104,2.2);p(s,105,0.0);p(s,106,1.00);p(s,107,0.0);}
        if(k==1){p(s,103,3.0);p(s,104,4.0);p(s,105,4.0);p(s,106,1.42);p(s,107,1.0);}
        if(k==2){p(s,103,7.5);p(s,104,8.5);p(s,105,0.0);p(s,106,1.35);p(s,107,1.0);}
        if(k==3){p(s,103,9.0);p(s,104,10.0);p(s,105,3.0);p(s,106,1.05);p(s,107,0.0);}
        if(k==4){p(s,103,12.0);p(s,104,13.5);p(s,105,0.0);p(s,106,1.25);p(s,107,2.0);}
        if(k==5){p(s,103,17.5);p(s,104,18.5);p(s,105,4.0);p(s,106,0.82);p(s,107,3.0);}
        if(k==6){p(s,103,22.5);p(s,104,23.5);p(s,105,0.0);p(s,106,1.10);p(s,107,0.0);}
        if(k==7){p(s,103,26.0);p(s,104,27.0);p(s,105,2.0);p(s,106,0.85);p(s,107,3.0);}
    }else{
        if(vi==1){
            if(k==0){p(s,103,2.0);p(s,104,3.0);p(s,105,3.0);p(s,106,0.84);p(s,107,3.0);}
            if(k==1){p(s,103,4.5);p(s,104,5.5);p(s,105,1.0);p(s,106,1.40);p(s,107,1.0);}
            if(k==2){p(s,103,8.0);p(s,104,9.0);p(s,105,4.0);p(s,106,1.02);p(s,107,0.0);}
            if(k==3){p(s,103,11.0);p(s,104,12.5);p(s,105,0.0);p(s,106,1.28);p(s,107,2.0);}
            if(k==4){p(s,103,16.0);p(s,104,17.0);p(s,105,0.0);p(s,106,0.80);p(s,107,3.0);}
            if(k==5){p(s,103,21.0);p(s,104,22.0);p(s,105,1.0);p(s,106,1.08);p(s,107,0.0);}
            if(k==6){p(s,103,25.0);p(s,104,26.0);p(s,105,4.0);p(s,106,0.88);p(s,107,3.0);}
        }else{
            if(k==0){p(s,103,0.5);p(s,104,1.5);p(s,105,0.0);p(s,106,1.03);p(s,107,0.0);}
            if(k==1){p(s,103,5.0);p(s,104,6.0);p(s,105,2.0);p(s,106,1.45);p(s,107,1.0);}
            if(k==2){p(s,103,10.0);p(s,104,11.0);p(s,105,3.0);p(s,106,0.86);p(s,107,3.0);}
            if(k==3){p(s,103,13.5);p(s,104,15.0);p(s,105,0.0);p(s,106,1.30);p(s,107,2.0);}
            if(k==4){p(s,103,19.0);p(s,104,20.0);p(s,105,1.0);p(s,106,1.05);p(s,107,0.0);}
            if(k==5){p(s,103,24.0);p(s,104,25.0);p(s,105,4.0);p(s,106,0.83);p(s,107,3.0);}
        }
    }
    return;
}

// ---- phonation-state gesture sequencer ----
// Per sample: sets 102 phon, 59 F0target, 129 closure, 131 inhale,
// 132 burst, phonation preset (55/122/136/137), 133 vibDepth,
// and glides the tract toward the vowel target.
fn gest_tick(s:*f64,t:f64,vi:i64)void{
    let base:f64=g(s,135);
    p(s,102,0.0);
    p(s,129,0.0);
    p(s,131,0.0);
    p(s,132,0.0);
    let k:i64=0;
    while(k<8){
        utt(vi,k,s);
        let t0:f64=g(s,103);
        if(t0>=0.0){
            let t1:f64=g(s,104);
            let vv:f64=g(s,105);
            let fm:f64=g(s,106);
            let kd:i64=(g(s,107) as i64);
            // inhale window: pre-position tract, audible intake
            if(t>=t0-0.07&&t<t0){
                p(s,131,1.0);
                vowel_glide(s,vv as i64,0.002);
                k=99;
            }else{
                if(t>=t0&&t<t1){
                    if(kd==2){
                        // LAUGH: ~6.4 Hz Attack->Release pulse loop, hash
                        // jitter +-40% on period + amplitude wander
                        // (irregular, not mechanical; keeps MOD4 low)
                        let P:f64=0.155;
                        let m:i64=(((t-t0)/P) as i64);
                        let jit:f64=0.08*P*(2.0*h01(5000+((vi*100) as i64),(m as i64))-1.0);
                        let tp:f64=t0+((m as f64)*P)+jit;
                        let dtp:f64=t-tp;
                        if(dtp>=0.0&&dtp<0.11){
                            p(s,102,1.0);
                            vowel_glide(s,0,0.003);
                            if(dtp<0.05){
                                p(s,59,base*fm*1.18);
                                phon_preset(s,0);
                                p(s,133,0.02);
                            }else{
                                p(s,59,base*fm*0.95);
                                phon_preset(s,2);
                                p(s,133,0.05);
                            }
                            // amplitude wander per pulse (after preset)
                            let aw:f64=0.7+0.6*h01(5100+((vi*100) as i64),(m as i64));
                            p(s,55,g(s,55)*aw);
                        }
                        k=99;
                    }else{
                        // kinds 0/1/3: inhale already handled; closure for
                        // 0/1, then attack/sustain/release
                        let hasC:i64=0;
                        if(kd==0||kd==1){hasC=1;}
                        let tc0:f64=t0;
                        let ta0:f64=t0;
                        if(hasC==1){ta0=t0+0.055;}
                        if(hasC==1&&t>=tc0&&t<tc0+0.055){
                            // labial closure: tract shut, pressure holds
                            p(s,129,1.0);
                            vowel_close(s,0.004);
                        }else{
                            // (release burst disabled: D4 target burst_rate=0.00)
                            if(t>=ta0&&t<ta0+0.045){
                                // ATTACK: +20% F0 overshoot, pressed
                                p(s,102,1.0);
                                p(s,59,base*fm*1.2);
                                phon_preset(s,0);
                                p(s,133,0.015);
                                vowel_glide(s,vv as i64,0.003);
                            }else{
                                if(t>=t1-0.075){
                                    // RELEASE: droop, breathy leak
                                    p(s,102,1.0);
                                    p(s,59,base*fm*0.92);
                                    phon_preset(s,2);
                                    p(s,133,0.04);
                                    vowel_glide(s,vv as i64,0.002);
                                }else{
                                    // SUSTAIN: F0 HELD, tract HELD
                                    // (the frac_static showcase)
                                    p(s,102,1.0);
                                    p(s,59,base*fm);
                                    if(kd==1){phon_preset(s,0);}
                                    else{phon_preset(s,1);}
                                    p(s,133,0.03);
                                }
                            }
                        }
                        k=99;
                    }
                }
            }
        }
        k=k+1;
    }
    return;
}

// ---- footstep burst: 35ms lowpassed noise, exponential decay ----
fn add_step(mix:[]u8,nsamp:i64,tstep:f64,gain:f64,seed:i64)void{
    let s0:i64=((tstep*44100.0) as i64);
    if(s0<0||s0>=nsamp){return;}
    let len:i64=1544;
    if(s0+len>nsamp){len=nsamp-s0;}
    let lp:f64=0.0;
    let n:i64=0;
    while(n<len){
        let nz:f64=2.0*h01(seed,s0+n)-1.0;
        lp=lp+0.25*(nz-lp);
        let env:f64=fexp(-((n as f64)/280.0));
        let v:f64=lp*env*gain;
        let cur:i64=get64(mix,(s0+n)*8);
        put64(mix,(s0+n)*8,cur+((v*16777216.0) as i64));
        n=n+1;
    }
    return;
}

// ---- mode: vowel <v> <f0> <dur> <out.wav> : fixed-vowel probe ----
fn mode_vowel(v:i64,f0:f64,dur:f64,path:[]u8)i32{
    let nsamp:i64=((dur*44100.0) as i64);
    let mp:*u8=_zag_malloc(nsamp*8) as *u8;
    if(mp==null as *u8){return 9;}
    let mix:[]u8=mp[0..(nsamp*8)];
    let s:i64=0;
    while(s<nsamp){put64(mix,s*8,0);s=s+1;}
    let vs:*f64=valloc();
    voice_init(vs,f0);
    vowel_set(vs,v);
    p(vs,102,1.0);
    p(vs,59,f0);
    let n:i64=0;
    let peak:f64=0.000000001;
    let usum:f64=0.0;
    let un:i64=0;
    while(n<nsamp){
        let y:f64=fold2_voice_tick(vs,n,1001);
        if(n>22050){
            let ay:f64=y;
            if(ay<0.0){ay=-ay;}
            if(ay>peak){peak=ay;}
            usum=usum+g(vs,71);
            un=un+1;
        }
        n=n+1;
    }
    print_str("vowel=");print_i64(v);
    print_str(" Umean_cm3=");print_f3(usum/(un as f64)*1000000.0);
    print_str(" Psub_Pa=");print_f3(g(vs,56));
    print_str(" F0cur=");print_f3(g(vs,54));
    print_nl();
    // second pass for recording (deterministic)
    p(vs,53,0.0);p(vs,54,f0);p(vs,56,900.0);p(vs,57,0.0);p(vs,58,0.0);
    p(vs,70,0.0);p(vs,71,0.0);p(vs,72,0.0);p(vs,73,0.0);p(vs,123,0.0);
    p(vs,128,0.0);
    let j2:i64=0;
    while(j2<14){p(vs,j2,0.0);p(vs,14+j2,0.0);j2=j2+1;}
    let i2:i64=108;
    while(i2<120){p(vs,i2,0.0);i2=i2+1;}
    n=0;
    while(n<nsamp){
        let y:f64=fold2_voice_tick(vs,n,1001);
        let vv:f64=0.0;
        if(n>22050){vv=y/peak*0.35;}
        put64(mix,n*8,((vv*16777216.0) as i64));
        n=n+1;
    }
    return wav_write(path,mix,nsamp);
}

// ---- mode: scene <out.wav> : full 30 s playground scene ----
fn mode_scene(path:[]u8)i32{
    let nsamp:i64=1323000;
    let mp:*u8=_zag_malloc(nsamp*8) as *u8;
    if(mp==null as *u8){return 9;}
    let mix:[]u8=mp[0..(nsamp*8)];
    let s:i64=0;
    while(s<nsamp){put64(mix,s*8,0);s=s+1;}
    let v0:*f64=valloc();
    let v1:*f64=valloc();
    let v2:*f64=valloc();
    voice_init(v0,620.0);
    voice_init(v1,560.0);
    voice_init(v2,700.0);
    // Pass 1: voices
    let n:i64=0;
    while(n<nsamp){
        let t:f64=(n as f64)/44100.0;
        let vi:i64=0;
        while(vi<3){
            let vs:*f64=v0;
            if(vi==1){vs=v1;}
            if(vi==2){vs=v2;}
            gest_tick(vs,t,vi);
            let phon:f64=g(vs,102);
            let env:f64=g(vs,70);
            // inhale noise (envelope-followed)
            let itarget:f64=0.0;
            if(g(vs,131)>0.5){itarget=1.0;}
            let ie:f64=g(vs,140);
            ie=ie+(itarget-ie)*(1.0-fexp(-1.0/(0.008*44100.0)));
            p(vs,140,ie);
            if(ie>0.001){
                let nz:f64=2.0*h01(3100+((vi*131) as i64),n)-1.0;
                let lp:f64=g(vs,138);
                lp=lp+0.10*(nz-lp);
                p(vs,138,lp);
                let cur:i64=get64(mix,n*8);
                put64(mix,n*8,cur+((lp*ie*0.05*16777216.0) as i64));
            }
            // consonant release burst (envelope-followed)
            let btarget:f64=0.0;
            if(g(vs,132)>0.5){btarget=1.0;}
            let be:f64=g(vs,130);
            be=be+(btarget-be)*(1.0-fexp(-1.0/(0.004*44100.0)));
            p(vs,130,be);
            if(be>0.001){
                let nz2:f64=2.0*h01(4100+((vi*137) as i64),n)-1.0;
                let bl:f64=g(vs,139);
                bl=bl+0.40*(nz2-bl);
                p(vs,139,bl);
                let cur2:i64=get64(mix,n*8);
                put64(mix,n*8,cur2+((bl*be*0.09*16777216.0) as i64));
            }
            // voice
            if(phon>0.5||env>0.005){
                let y:f64=fold2_voice_tick(vs,n,1001+vi*77);
                let cur3:i64=get64(mix,n*8);
                put64(mix,n*8,cur3+((y*16777216.0) as i64));
            }else{
                // idle: advance time, relax Psub
                p(vs,128,t+1.0/44100.0);
                let ps:f64=g(vs,56);
                ps=ps+(300.0-ps)*0.0002;
                p(vs,56,ps);
                p(vs,58,g(vs,58)+1.0);
            }
            vi=vi+1;
        }
        n=n+1;
    }
    // Pass 2: footsteps (sparser, matching the sparser voicing)
    let ft:f64=0.5;
    while(ft<6.0){
        add_step(mix,nsamp,ft,0.04,9001);
        ft=ft+0.80+0.20*(h01(9001,(ft*10.0) as i64)-0.5);
    }
    ft=12.0;
    while(ft<18.0){
        add_step(mix,nsamp,ft,0.06,9002);
        ft=ft+0.55+0.12*(h01(9002,(ft*10.0) as i64)-0.5);
    }
    ft=24.0;
    while(ft<29.0){
        add_step(mix,nsamp,ft,0.03,9003);
        ft=ft+1.0+0.25*(h01(9003,(ft*10.0) as i64)-0.5);
    }
    // Pass 3: ambience (wind + 5 fixed-time bird chirps)
    let wlp:f64=0.0;
    n=0;
    while(n<nsamp){
        let t2:f64=(n as f64)/44100.0;
        let wn:f64=2.0*h01(7777,n)-1.0;
        wlp=wlp+0.02*(wn-wlp);
        let wamp:f64=0.018+0.012*fsinr(t2*0.9)+0.008*fsinr(t2*0.23+1.0);
        let wv:f64=wlp*wamp*3.0;
        let bv:f64=0.0;
        let bi:i64=0;
        while(bi<5){
            let bt:f64=4.0+((bi as f64)*5.3);
            let dt:f64=t2-bt;
            if(dt>0.0&&dt<0.4){
                let f:f64=2800.0+1200.0*fsinr(dt*40.0);
                bv=bv+0.06*fsinr(dt*f*6.2831853)*fexp(-dt*8.0);
            }
            bi=bi+1;
        }
        let cur:i64=get64(mix,n*8);
        put64(mix,n*8,cur+(((wv+bv)*16777216.0) as i64));
        n=n+1;
    }
    return wav_write(path,mix,nsamp);
}

fn main()i32{
    let mode:[]u8=_zag_arg(1);
    if(str_eq(mode,"vowel")==1){
        let v:i64=parsei(_zag_arg(2));
        let f0:f64=parsef(_zag_arg(3));
        let dur:f64=parsef(_zag_arg(4));
        let path:[]u8=_zag_arg(5);
        if(path.len==0){path="vowel.wav";}
        return mode_vowel(v,f0,dur,path);
    }
    if(str_eq(mode,"scene")==1){
        let path:[]u8=_zag_arg(2);
        if(path.len==0){path="scene.wav";}
        return mode_scene(path);
    }
    print_str("usage: render_v11_waveguide2 <vowel|scene> ...");
    print_nl();
    return 2;
}

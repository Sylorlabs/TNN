// ============================================================
// FORK B-ALPHA — audit.zag : the no-copy audit (pre-listening gate).
// For every 2 s window of the output (0.5 s hop), computes the maximum
// normalized cross-correlation (zero lag) against every 2 s window of
// every studied recording (downsampled x8 for speed). Reports the
// minimum over output windows of (1 - maxcorr): the distance of the
// closest near-copy. BAR: min distance >= 0.45 (no window may be more
// than 0.55 correlated with any studied window).
// Usage: audit <out.wav> <study1.wav> [study2.wav ...]
// Exit 0 = PASS, 3 = gate tripped.
// Pure Zag. Zero RNG. Deterministic.
// ============================================================
@import("common.zag")

// downsample x8 into f64-ish i64 arena (Q8), returns n
fn ds8(s:[]u8,nsamp:i64,d:[]u8,doff:i64)i64{
    let n:i64=nsamp/8;
    let i:i64=0;
    while(i<n){
        put64(d,(doff+i)*8,(get16s(s,i*16)*256));
        i=i+1;
    }
    return n;
}
// window stats: mean and rms (as f64) over d[off..off+len)
fn wstats(d:[]u8,off:i64,len:i64,sp:[]u8)void{
    let sum:f64=0.0;
    let sq:f64=0.0;
    let i:i64=0;
    while(i<len){
        let v:f64=((get64(d,(off+i)*8) as f64))/256.0;
        sum=sum+v;
        sq=sq+v*v;
        i=i+1;
    }
    let mean:f64=sum/(len as f64);
    let vari:f64=sq/(len as f64)-mean*mean;
    if(vari<0.0){vari=0.0;}
    put64(sp,0,((mean*256.0) as i64));
    put64(sp,8,((fsqrt(vari)*256.0) as i64));
}

fn main()i32{
    let outp:[]u8=_zag_arg(1);
    if(outp.len==0){return 41;}
    let oraw:[]u8=file_read(outp,8000000);
    let os:[]u8=wav_parse(oraw);
    _zag_free(_zag_slice_ptr(oraw));
    if(os.len==0){return 42;}
    let onn:i64=(os.len as i64)/2;
    let odp:*u8=_zag_malloc(onn) as *u8;
    let od:[]u8=odp[0..onn];
    let odn:i64=ds8(os,onn,od,0);
    _zag_free(_zag_slice_ptr(os));
    let wlen:i64=11025; // 2 s at 5512.5 Hz
    let hop:i64=2756;   // 0.5 s
    let sp:*u8=_zag_malloc(16) as *u8;
    let st:[]u8=sp[0..16];
    // study windows: precompute (mean,rms) for all study windows
    // cap 2000 windows total
    let swp:*u8=_zag_malloc(2000*24) as *u8;
    let sw:[]u8=swp[0..(2000*24)];
    let nsw:i64=0;
    // we also need study downsampled data per file on demand; keep all in
    // one arena with offsets
    let sdp:*u8=_zag_malloc(25165824) as *u8;
    let sd:[]u8=sdp[0..25165824]; // 24MB: planet/ocean study totals ~21MB downsampled
    let sof:i64=0; // offsets in 8-byte units
    let fidx:i64=2;
    let more:i64=1;
    while(more==1){
        let wp:[]u8=_zag_arg(fidx);
        if(wp.len==0){more=0;}else{
            let raw:[]u8=file_read(wp,40000000);
            let s:[]u8=wav_parse(raw);
            _zag_free(_zag_slice_ptr(raw));
            if(s.len>0){
                let nn:i64=(s.len as i64)/2;
                let dn:i64=ds8(s,nn,sd,sof);
                _zag_free(_zag_slice_ptr(s));
                // slide windows
                let off:i64=0;
                while(off+ wlen<=dn && nsw<2000){
                    // copy window into sd arena tail? Instead: process now
                    // against all out windows? That inverts loops. Simpler:
                    // store (file_off, win_off, mean, rms) and re-walk sd.
                    put64(sw,nsw*24,sof+off);
                    wstats(sd,sof+off,wlen,st);
                    put64(sw,nsw*24+8,get64(st,0));
                    put64(sw,nsw*24+16,get64(st,8));
                    nsw=nsw+1;
                    off=off+hop;
                }
                sof=sof+dn;
            }
            fidx=fidx+1;
        }
    }
    print_str("study windows=");print_i64(nsw);print_nl();
    // out windows vs study windows
    let ooff:i64=0;
    let gmin:f64=2.0;
    let gwini:i64=0;
    let wn:i64=0;
    while(ooff+wlen<=odn){
        wstats(od,ooff,wlen,st);
        let ome:f64=((get64(st,0) as f64))/256.0;
        let ors:f64=((get64(st,8) as f64))/256.0;
        let maxc:f64=0.0;
        if(ors>1.0){
            let s2:i64=0;
            while(s2<nsw){
                let soff:i64=get64(sw,s2*24);
                let sme:f64=((get64(sw,s2*24+8) as f64))/256.0;
                let srs:f64=((get64(sw,s2*24+16) as f64))/256.0;
                if(srs>1.0){
                    let dot:f64=0.0;
                    let k2:i64=0;
                    while(k2<wlen){
                        let a:f64=((get64(od,(ooff+k2)*8) as f64))/256.0-ome;
                        let b2:f64=((get64(sd,(soff+k2)*8) as f64))/256.0-sme;
                        dot=dot+a*b2;
                        k2=k2+1;
                    }
                    let c:f64=dot/((ors*srs)*(wlen as f64));
                    if(c<0.0){c=-c;}
                    if(c>maxc){maxc=c;}
                }
                s2=s2+1;
            }
        }
        let d:f64=1.0-maxc;
        if(d<gmin){gmin=d;gwini=wn;}
        wn=wn+1;
        ooff=ooff+hop;
    }
    print_str("out windows=");print_i64(wn);print_nl();
    print_str("min no-copy distance d=");print_f3(gmin);
    print_str(" at window ");print_i64(gwini);print_nl();
    print_str("BAR: d>=0.450 -> ");
    if(gmin>=0.450){print_str("PASS");print_nl();return 0;}
    print_str("GATE TRIPPED");print_nl();
    return 3;
}

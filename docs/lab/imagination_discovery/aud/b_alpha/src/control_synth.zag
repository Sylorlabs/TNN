// ============================================================
// FORK B-ALPHA — control_synth.zag : BLIND-TEST CONTROL ONLY.
// This file is NOT part of fork B-alpha's claim. It deliberately
// uses the CONVICTED paradigm (sine LUT oscillators, inharmonic
// partial stacks, filtered-noise beds, chirps, decaying-sine drums)
// to render the SAME 30 s kids-playing scene as b_alpha_kids_v1.wav,
// so blind critics can compare the two paradigms head to head.
// Pure Zag, deterministic (fixed-seed hashes), 44.1 kHz mono.
// ============================================================
@import("common.zag")

const PH1:i64 = 281474976710656;
const INV48:f64 = 1.0/281474976710656.0;

fn wnoise(s:i64,st:i64)f64{
    return (((h32(s,st)%2000000) as f64)/1000000.0)-1.0;
}
fn tsin_small(x:f64)f64{
    let x2:f64=x*x;
    return x*(1.0-x2*(1.0/6.0-x2*(1.0/120.0-x2/5040.0)));
}
fn lut_build()[]u8{
    let p:*u8=_zag_malloc(4096*8) as *u8;
    let lut:[]u8=p[0..(4096*8)];
    let i:i64=0;
    while(i<4096){
        let x:f64=(i as f64)/4096.0*6.283185307179586;
        put64(lut,i*8,((tsin_small(x)*4611686018427387904.0) as i64));
        i=i+1;
    }
    return lut;
}
fn sin01(lut:[]u8,ph:f64)f64{
    let idx:f64=ph*4096.0;
    let i0:i64=(idx as i64)%4096;
    let i1:i64=(i0+1)%4096;
    let fr:f64=idx-(idx as f64);
    let a:f64=((get64(lut,i0*8) as f64))/4611686018427387904.0;
    let b:f64=((get64(lut,i1*8) as f64))/4611686018427387904.0;
    return a+(b-a)*fr;
}

fn env_struck(t:f64,atk:f64,decp:i64)f64{
    if(t<0.0){return 0.0;}
    let a:f64=sstep(t/atk);
    let d:f64=1.0;
    if(t>0.0){d=1.0/(1.0+t*(t*0.5+1.0)*((decp as f64)/1000.0));}
    return a*d;
}
// struck inharmonic partial stack = "voice-like" shout (synth paradigm)
fn shout(m:[]u8,lut:[]u8,s0:i64,dur:f64,f0:f64,seed:i64,gain:f64)void{
    let np:i64=8;
    let k:i64=0;
    while(k<np){
        let inh:f64=1.0+0.07*((h01(seed,k*3+1)-0.5)*2.0);
        let f:f64=f0*(1.0+(k as f64)*0.9)*inh;
        let g:f64=gain/(1.0+(k as f64)*0.8);
        let ph:f64=h01(seed,k*3+2);
        let n:i64=((dur*44100.0) as i64);
        let j:i64=0;
        while(j<n){
            let t:f64=(j as f64)/44100.0;
            ph=ph+f/44100.0;
            if(ph>=1.0){ph=ph-1.0;}
            let v:f64=sin01(lut,ph)*env_struck(t,0.02,300)*g;
            let cur:i64=get64(m,(s0+j)*8);
            put64(m,(s0+j)*8,cur+((v*16777216.0) as i64));
            j=j+1;
        }
        k=k+1;
    }
}
// upward chirp = "giggle" (synth paradigm)
fn giggle(m:[]u8,lut:[]u8,s0:i64,f0:f64,f1:f64,dur:f64,seed:i64,gain:f64)void{
    let n:i64=((dur*44100.0) as i64);
    let ph:f64=h01(seed,7);
    let j:i64=0;
    while(j<n){
        let t:f64=(j as f64)/44100.0;
        let f:f64=f0+(f1-f0)*(t/dur);
        ph=ph+f/44100.0;
        if(ph>=1.0){ph=ph-1.0;}
        let v:f64=sin01(lut,ph)*env_struck(t,0.01,200)*gain;
        let cur:i64=get64(m,(s0+j)*8);
        put64(m,(s0+j)*8,cur+((v*16777216.0) as i64));
        j=j+1;
    }
}
// decaying sine thump = "footstep" (synth paradigm)
fn thump(m:[]u8,lut:[]u8,s0:i64,f:f64,seed:i64,gain:f64)void{
    let n:i64=6615; // 150 ms
    let ph:f64=h01(seed,9);
    let j:i64=0;
    while(j<n){
        let t:f64=(j as f64)/44100.0;
        ph=ph+f/44100.0;
        if(ph>=1.0){ph=ph-1.0;}
        let v:f64=sin01(lut,ph)*env_struck(t,0.005,120)*gain;
        let cur:i64=get64(m,(s0+j)*8);
        put64(m,(s0+j)*8,cur+((v*16777216.0) as i64));
        j=j+1;
    }
}
// filtered-noise playground wash bed (synth paradigm)
fn bedwash(m:[]u8,nsamp:i64,gain:f64,seed:i64)void{
    let lp:f64=0.0;
    let j:i64=0;
    while(j<nsamp){
        let w:f64=wnoise(seed,j);
        lp=lp*0.985+w*0.015;
        let lfo:f64=1.0+0.25*sin01_cheap((j as f64)/44100.0*0.13+0.3);
        let v:f64=lp*8.0*gain*lfo;
        let cur:i64=get64(m,j*8);
        put64(m,j*8,cur+((v*16777216.0) as i64));
        j=j+1;
    }
}
fn sin01_cheap(ph:f64)f64{
    let x:f64=(ph-((ph as i64) as f64))*6.283185307179586;
    return tsin_small(x);
}

fn main()i32{
    let outp:[]u8=_zag_arg(1);
    if(outp.len==0){return 51;}
    let nsamp:i64=30*44100;
    let lut:[]u8=lut_build();
    let mp:*u8=_zag_malloc(nsamp*8) as *u8;
    let m:[]u8=mp[0..(nsamp*8)];
    let z:i64=0;
    while(z<nsamp*8){m[z]=0;z=z+1;}
    bedwash(m,nsamp,0.30,777);
    let seed:i64=4242;
    let k:i64=0;
    // shouts scattered through the scene
    while(k<22){
        let t:f64=h01(seed,k*11)*28.0+0.5;
        let f0:f64=280.0+h01(seed,k*11+1)*420.0;
        shout(m,lut,((t*44100.0) as i64),0.45+h01(seed,k*11+2)*0.3,f0,seed+k,0.5);
        k=k+1;
    }
    // giggle chirps
    k=0;
    while(k<14){
        let t:f64=h01(seed,500+k*13)*28.0+1.0;
        let f0:f64=600.0+h01(seed,501+k*13)*500.0;
        giggle(m,lut,((t*44100.0) as i64),f0,f0*1.6,0.18,seed+900+k,0.35);
        k=k+1;
    }
    // laugh cascade at ~16 s
    k=0;
    while(k<7){
        let t:f64=16.2+(k as f64)*0.28;
        let f0:f64=700.0-h01(seed,700+k)*200.0;
        giggle(m,lut,((t*44100.0) as i64),f0,f0*1.4,0.25,seed+950+k,0.4);
        k=k+1;
    }
    // footstep thumps: run bursts
    let ft:f64=1.6;
    let fg:f64=0.30;
    k=0;
    while(k<6){
        thump(m,lut,((ft*44100.0) as i64),90.0+h01(seed,800+k)*40.0,seed+1000+k,0.6);
        ft=ft+fg;fg=fg*0.88;k=k+1;
    }
    ft=7.0;fg=0.24;k=0;
    while(k<8){
        thump(m,lut,((ft*44100.0) as i64),85.0+h01(seed,810+k)*45.0,seed+1010+k,0.6);
        ft=ft+fg;fg=fg*0.92;k=k+1;
    }
    ft=25.5;fg=0.40;k=0;
    while(k<5){
        thump(m,lut,((ft*44100.0) as i64),80.0+h01(seed,820+k)*30.0,seed+1020+k,0.5);
        ft=ft+fg;fg=fg*1.3;k=k+1;
    }
    let rc:i64=wav_write(outp,m,nsamp);
    print_str("control rc=");print_i64(rc);print_nl();
    return 0;
}

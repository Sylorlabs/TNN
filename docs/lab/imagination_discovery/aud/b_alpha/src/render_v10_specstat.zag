@import("common.zag")
// ============================================================
// render_v10_specstat.zag - Fork C SPECSTAT (AUDIO V10, frozen design).
//
// Spectral-statistical resynthesis of a playground scene:
//  1. ANALYSIS (Python, one-time, glue only): a real playground
//     recording (w2.wav) was passed through a hand-built 12-band
//     resonator bank (2nd-order constant-skirt bandpass biquads,
//     time-domain difference equation - NO FFT). Kept: per-band
//     energy trajectories at 10 Hz, per-band modulation rates/depths,
//     filter coefficients, per-band noise gains, phase segment picks,
//     phase amplitude trims. NO recorded material kept - statistics only.
//  2. RENDER (this file, pure Zag): ONE continuous noise-excitation
//     stream (deterministic h01 hash of the sample index - never
//     started, stopped, or reseeded) drives a bank of 12 resonant
//     bandpass filters. Per-band gains follow a COMPOSED 30 s scene
//     trajectory derived from the statistics: each scene phase replays
//     the slow trajectory shape of a real-play segment (phase means
//     equalized to the recording global mean), 1.25 s frozen-frame
//     crossfades at phase boundaries, plus per-band wander at the
//     measured modulation rates/depths, plus scene-scripted transient
//     bumps (footsteps/laugh/calls/thud) with smooth sstep attacks
//     and Pade decays - only smooth envelopes, nothing ever switched.
//     The composed trip-dip multiplies the event bumps too: a "held
//     breath" must hush everything, or undipped transient tails would
//     warp the spectrum against the dipped bed (spectral-flux audit).
//
// NO-CHOP ARGUMENT (structural, CHOP-4): choppiness is impossible by
// construction. (a) The excitation is a pure function of the sample
// index - continuous by definition; the stream is a pure function. (b) Every
// gain is a continuous function of time: sstep/Pade event envelopes,
// sine wander, lerped 10 Hz energy trajectories, sstep crossfades.
// No parameter ever jumps; no gain is ever switched. (c) Filter states
// persist across the entire 30 s render. (d) There is no discrete
// unit assembly of any kind here - every mechanism is a continuous
// function of time; there is nothing to assemble from. The only
// "events" are smooth gain bumps on a never-interrupted stream.
//
// Scene: ONE consistent imagined moment - little kids (3-6) in a
// playground. 0-6.5 s yard alive; 6.5-12.5 s chase; 12.5-16.5 s one
// trips (stumble, thud, gasp dip, held breath); 16.5-23 s laughter;
// 23-30 s wind down. Deterministic: byte-identical reruns.
// Compile with the pinned znc from the src/ dir.
// Usage: render_v10_specstat <stats.txt> <out.wav> <events.txt>
// ============================================================

const NSAMP:i64 = 1323000;
const SEED:i64 = 910273;
const BLK:i64 = 44;
const MASTER:f64 = 1.75;   // calibrated: pre-norm peak ~0.74, limiter stays near-transparent
const WANDER_AMT:f64 = 0.0;  // measured modulation already lives in the 10 Hz trajectory;
// synthetic wander would double-modulate -> inflated spectral flux. Kept at 0.

// sin, x >= 0 at all call sites; one-step range reduction + Taylor x^7
fn sinr(x:f64)f64{
    let k:i64=(x*0.15915494309189535) as i64;
    let a:f64=x-(k as f64)*6.283185307179586;
    if(a>3.141592653589793){a=a-6.283185307179586;}
    let x2:f64=a*a;
    let x3:f64=x2*a;
    let x5:f64=x3*x2;
    let x7:f64=x5*x2;
    return a-x3/6.0+x5/120.0-x7/5040.0;
}
// Pade [0/4] approximant of exp(-u), u >= 0: smooth decay envelope
fn pade(u:f64)f64{
    let u2:f64=u*u;
    let d:f64=1.0+u+u2*0.5+u2*u*0.16666666666666666+u2*u2*0.041666666666666664;
    return 1.0/d;
}
// smooth transient bump: sstep attack, Pade decay. C0 everywhere,
// C1 at the attack/decay junction. Never a gate.
fn bump(dt:f64,amp:f64,atk:f64,dec:f64)f64{
    if(dt<0.0){return 0.0;}
    if(dt>atk+dec*8.0){return 0.0;}
    if(dt<atk){return amp*sstep(dt/atk);}
    return amp*pade((dt-atk)/dec);
}
// byte at p, or 0 past the end
fn atc(buf:[]u8,p:i64)i64{
    if(p>=(buf.len as i64)){return 0;}
    return buf[p] as i64;
}
fn p_ws(buf:[]u8,p:i64)i64{
    let q:i64=p;
    while(q<(buf.len as i64)){
        let c:i64=atc(buf,q);
        if(c==32||c==10||c==13||c==9){q=q+1;}else{break;}
    }
    return q;
}
fn rd_i64(buf:[]u8,cur:[]u8)i64{
    let p:i64=p_ws(buf,get64(cur,0));
    let neg:i64=1;
    if(atc(buf,p)==45){neg=-1;p=p+1;}
    let v:i64=0;
    while(p<(buf.len as i64)){
        let c:i64=atc(buf,p);
        if(c>=48&&c<=57){v=v*10+c-48;p=p+1;}else{break;}
    }
    put64(cur,0,p);
    return v*neg;
}
fn rd_f64(buf:[]u8,cur:[]u8)f64{
    let p:i64=p_ws(buf,get64(cur,0));
    let neg:f64=1.0;
    if(atc(buf,p)==45){neg=-1.0;p=p+1;}
    if(atc(buf,p)==43){p=p+1;}
    let v:f64=0.0;
    while(p<(buf.len as i64)){
        let c:i64=atc(buf,p);
        if(c>=48&&c<=57){v=v*10.0+((c-48) as f64);p=p+1;}else{break;}
    }
    if(atc(buf,p)==46){
        p=p+1;
        let sc:f64=0.1;
        while(p<(buf.len as i64)){
            let c:i64=atc(buf,p);
            if(c>=48&&c<=57){v=v+((c-48) as f64)*sc;sc=sc*0.1;p=p+1;}else{break;}
        }
    }
    if(atc(buf,p)==101||atc(buf,p)==69){
        p=p+1;
        let eneg:i64=1;
        if(atc(buf,p)==45){eneg=-1;p=p+1;}
        if(atc(buf,p)==43){p=p+1;}
        let e:i64=0;
        while(p<(buf.len as i64)){
            let c:i64=atc(buf,p);
            if(c>=48&&c<=57){e=e*10+c-48;p=p+1;}else{break;}
        }
        let pw:f64=1.0;
        let k:i64=0;
        while(k<e){pw=pw*10.0;k=k+1;}
        if(eneg==1){v=v*pw;}else{v=v/pw;}
    }
    put64(cur,0,p);
    return v*neg;
}

// per-band target energy at scene time t: phase segment trajectory
// replay (10 Hz frames, lerped), phase trim, 1.25 s frozen-frame
// crossfade at phase boundaries.
fn ecore(p:i64,t:f64,b:i64,esar:[]u8,s0:i64,l0:i64,s1:i64,l1:i64,s2:i64,l2:i64,s3:i64,l3:i64,s4:i64,l4:i64,r0:f64,r1:f64,r2:f64,r3:f64,r4:f64)f64{
    let ss:i64=s0; let sl:i64=l0; let tr:f64=r0; let pb:f64=0.0;
    if(p==1){ss=s1;sl=l1;tr=r1;pb=6.5;}
    if(p==2){ss=s2;sl=l2;tr=r2;pb=12.5;}
    if(p==3){ss=s3;sl=l3;tr=r3;pb=16.5;}
    if(p==4){ss=s4;sl=l4;tr=r4;pb=23.0;}
    let local:f64=t-pb;
    let maxl:f64=(sl as f64)/10.0-0.05;
    if(local<0.0){local=0.0;}
    if(local>maxl){local=maxl;}
    let f:f64=(ss as f64)+local*10.0;
    let fmax:f64=((ss+sl-1) as f64);
    if(f>fmax){f=fmax;}
    let i0:i64=(f as i64);
    if(i0<ss){i0=ss;}
    if(i0>ss+sl-2){i0=ss+sl-2;}
    let fr:f64=f-(i0 as f64);
    let e0:f64=(get64(esar,(i0*12+b)*8) as f64)/1000000000000.0;
    let e1:f64=(get64(esar,((i0+1)*12+b)*8) as f64)/1000000000000.0;
    return (e0*(1.0-fr)+e1*fr)*tr;
}
fn eband(t:f64,b:i64,esar:[]u8,s0:i64,l0:i64,s1:i64,l1:i64,s2:i64,l2:i64,s3:i64,l3:i64,s4:i64,l4:i64,r0:f64,r1:f64,r2:f64,r3:f64,r4:f64)f64{
    let p:i64=0;
    if(t>=6.5){p=1;}
    if(t>=12.5){p=2;}
    if(t>=16.5){p=3;}
    if(t>=23.0){p=4;}
    let e:f64=ecore(p,t,b,esar,s0,l0,s1,l1,s2,l2,s3,l3,s4,l4,r0,r1,r2,r3,r4);
    let k:i64=1;
    while(k<=4){
        let bk:f64=6.5;
        if(k==2){bk=12.5;}
        if(k==3){bk=16.5;}
        if(k==4){bk=23.0;}
        if(t>bk-0.625&&t<bk+0.625){
            let al:f64=sstep((t-(bk-0.625))/1.25);
            let ep:f64=ecore(k-1,t,b,esar,s0,l0,s1,l1,s2,l2,s3,l3,s4,l4,r0,r1,r2,r3,r4);
            let en:f64=ecore(k,t,b,esar,s0,l0,s1,l1,s2,l2,s3,l3,s4,l4,r0,r1,r2,r3,r4);
            e=ep*(1.0-al)+en*al;
        }
        k=k+1;
    }
    return e;
}
// per-band slow wander at the measured modulation rate/depth;
// deterministic hash phases. Bounded, smooth, never silence.
fn wnd(b:i64,t:f64,m0:f64,m1:f64,m2:f64,m3:f64,m4:f64,m5:f64,m6:f64,m7:f64,m8:f64,m9:f64,m10:f64,m11:f64,d0:f64,d1:f64,d2:f64,d3:f64,d4:f64,d5:f64,d6:f64,d7:f64,d8:f64,d9:f64,d10:f64,d11:f64)f64{
    let mrq:f64=m0; let mdq:f64=d0;
    if(b==1){mrq=m1;mdq=d1;}
    if(b==2){mrq=m2;mdq=d2;}
    if(b==3){mrq=m3;mdq=d3;}
    if(b==4){mrq=m4;mdq=d4;}
    if(b==5){mrq=m5;mdq=d5;}
    if(b==6){mrq=m6;mdq=d6;}
    if(b==7){mrq=m7;mdq=d7;}
    if(b==8){mrq=m8;mdq=d8;}
    if(b==9){mrq=m9;mdq=d9;}
    if(b==10){mrq=m10;mdq=d10;}
    if(b==11){mrq=m11;mdq=d11;}
    let p1:f64=6.283185307179586*h01(777001,b);
    let p2:f64=6.283185307179586*h01(777002,b);
    return 1.0+mdq*(0.6*sinr(6.283185307179586*mrq*t+p1)+0.4*sinr(6.283185307179586*mrq*2.7*t+p2));
}
// format seconds with 3 decimals + newline into buf; returns new pos
fn app3(buf:[]u8,p:i64,v:f64)i64{
    let ip:i64=(v as i64);
    let fp:i64=((v-(ip as f64))*1000.0+0.5) as i64;
    if(ip>=10){buf[p]=((ip/10)+48) as u8;p=p+1;}
    buf[p]=((ip%10)+48) as u8;p=p+1;
    buf[p]=46;p=p+1;
    buf[p]=((fp/100)+48) as u8;p=p+1;
    buf[p]=(((fp/10)%10)+48) as u8;p=p+1;
    buf[p]=((fp%10)+48) as u8;p=p+1;
    buf[p]=10;p=p+1;
    return p;
}

fn main()i32{
    let sp:[]u8=_zag_arg(1);
    let wp:[]u8=_zag_arg(2);
    let ep:[]u8=_zag_arg(3);
    if(sp.len==0||wp.len==0||ep.len==0){return 31;}
    let buf:[]u8=file_read(sp,200000);
    if(buf.len<64){return 40;}
    if(atc(buf,0)!=83||atc(buf,1)!=80||atc(buf,2)!=69||atc(buf,3)!=67||atc(buf,4)!=83||atc(buf,5)!=84||atc(buf,6)!=65||atc(buf,7)!=84||atc(buf,8)!=49){return 41;}
    let cp0:*u8=_zag_malloc(8) as *u8;
    let cur:[]u8=cp0[0..8];
    put64(cur,0,9);
    let nb:i64=rd_i64(buf,cur);
    let nf:i64=rd_i64(buf,cur);
    if(nb!=12||nf!=488){return 42;}
    let cb:i64=0;
    while(cb<12){let cdiscard:f64=rd_f64(buf,cur);cb=cb+1;}
    let b0_0:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_0:f64=rd_f64(buf,cur); let a1_0:f64=rd_f64(buf,cur); let a2_0:f64=rd_f64(buf,cur);
    let b0_1:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_1:f64=rd_f64(buf,cur); let a1_1:f64=rd_f64(buf,cur); let a2_1:f64=rd_f64(buf,cur);
    let b0_2:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_2:f64=rd_f64(buf,cur); let a1_2:f64=rd_f64(buf,cur); let a2_2:f64=rd_f64(buf,cur);
    let b0_3:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_3:f64=rd_f64(buf,cur); let a1_3:f64=rd_f64(buf,cur); let a2_3:f64=rd_f64(buf,cur);
    let b0_4:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_4:f64=rd_f64(buf,cur); let a1_4:f64=rd_f64(buf,cur); let a2_4:f64=rd_f64(buf,cur);
    let b0_5:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_5:f64=rd_f64(buf,cur); let a1_5:f64=rd_f64(buf,cur); let a2_5:f64=rd_f64(buf,cur);
    let b0_6:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_6:f64=rd_f64(buf,cur); let a1_6:f64=rd_f64(buf,cur); let a2_6:f64=rd_f64(buf,cur);
    let b0_7:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_7:f64=rd_f64(buf,cur); let a1_7:f64=rd_f64(buf,cur); let a2_7:f64=rd_f64(buf,cur);
    let b0_8:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_8:f64=rd_f64(buf,cur); let a1_8:f64=rd_f64(buf,cur); let a2_8:f64=rd_f64(buf,cur);
    let b0_9:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_9:f64=rd_f64(buf,cur); let a1_9:f64=rd_f64(buf,cur); let a2_9:f64=rd_f64(buf,cur);
    let b0_10:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_10:f64=rd_f64(buf,cur); let a1_10:f64=rd_f64(buf,cur); let a2_10:f64=rd_f64(buf,cur);
    let b0_11:f64=rd_f64(buf,cur); rd_f64(buf,cur); let b2_11:f64=rd_f64(buf,cur); let a1_11:f64=rd_f64(buf,cur); let a2_11:f64=rd_f64(buf,cur);
    let ng_0:f64=rd_f64(buf,cur);
    let ng_1:f64=rd_f64(buf,cur);
    let ng_2:f64=rd_f64(buf,cur);
    let ng_3:f64=rd_f64(buf,cur);
    let ng_4:f64=rd_f64(buf,cur);
    let ng_5:f64=rd_f64(buf,cur);
    let ng_6:f64=rd_f64(buf,cur);
    let ng_7:f64=rd_f64(buf,cur);
    let ng_8:f64=rd_f64(buf,cur);
    let ng_9:f64=rd_f64(buf,cur);
    let ng_10:f64=rd_f64(buf,cur);
    let ng_11:f64=rd_f64(buf,cur);
    let mr_0:f64=rd_f64(buf,cur);
    let mr_1:f64=rd_f64(buf,cur);
    let mr_2:f64=rd_f64(buf,cur);
    let mr_3:f64=rd_f64(buf,cur);
    let mr_4:f64=rd_f64(buf,cur);
    let mr_5:f64=rd_f64(buf,cur);
    let mr_6:f64=rd_f64(buf,cur);
    let mr_7:f64=rd_f64(buf,cur);
    let mr_8:f64=rd_f64(buf,cur);
    let mr_9:f64=rd_f64(buf,cur);
    let mr_10:f64=rd_f64(buf,cur);
    let mr_11:f64=rd_f64(buf,cur);
    let md_0:f64=rd_f64(buf,cur);
    let md_1:f64=rd_f64(buf,cur);
    let md_2:f64=rd_f64(buf,cur);
    let md_3:f64=rd_f64(buf,cur);
    let md_4:f64=rd_f64(buf,cur);
    let md_5:f64=rd_f64(buf,cur);
    let md_6:f64=rd_f64(buf,cur);
    let md_7:f64=rd_f64(buf,cur);
    let md_8:f64=rd_f64(buf,cur);
    let md_9:f64=rd_f64(buf,cur);
    let md_10:f64=rd_f64(buf,cur);
    let md_11:f64=rd_f64(buf,cur);
    let ss_0:i64=rd_i64(buf,cur); let sl_0:i64=rd_i64(buf,cur);
    let ss_1:i64=rd_i64(buf,cur); let sl_1:i64=rd_i64(buf,cur);
    let ss_2:i64=rd_i64(buf,cur); let sl_2:i64=rd_i64(buf,cur);
    let ss_3:i64=rd_i64(buf,cur); let sl_3:i64=rd_i64(buf,cur);
    let ss_4:i64=rd_i64(buf,cur); let sl_4:i64=rd_i64(buf,cur);
    let tr_0:f64=rd_f64(buf,cur);
    let tr_1:f64=rd_f64(buf,cur);
    let tr_2:f64=rd_f64(buf,cur);
    let tr_3:f64=rd_f64(buf,cur);
    let tr_4:f64=rd_f64(buf,cur);
    // energy arena (x1e12) + 0.5 s boxcar-smoothed copy
    let ep0:*u8=_zag_malloc(nf*12*8) as *u8;
    let ear:[]u8=ep0[0..(nf*12*8)];
    let i:i64=0;
    while(i<nf*12){put64(ear,i*8,(rd_f64(buf,cur)*1000000000000.0) as i64);i=i+1;}
    let sp0:*u8=_zag_malloc(nf*12*8) as *u8;
    let esar:[]u8=sp0[0..(nf*12*8)];
    i=0;
    while(i<nf){
        let b2i:i64=0;
        while(b2i<12){
            let lo:i64=i-2; if(lo<0){lo=0;}
            let hi:i64=i+2; if(hi>nf-1){hi=nf-1;}
            let accs:i64=0; let kk:i64=lo;
            while(kk<=hi){accs=accs+get64(ear,(kk*12+b2i)*8);kk=kk+1;}
            put64(esar,(i*12+b2i)*8,accs/(hi-lo+1));
            b2i=b2i+1;
        }
        i=i+1;
    }
    _zag_free(cp0);
    // group 0: 32 events, amp 0.7, atk 0.018, dec 0.1
    let n0:i64=32;
    let gp0:*u8=_zag_malloc(32*8) as *u8;
    let g0:[]u8=gp0[0..(32*8)];
    put64(g0,0*8,1200000);
    put64(g0,1*8,2900000);
    put64(g0,2*8,4600000);
    put64(g0,3*8,5800000);
    put64(g0,4*8,6700000);
    put64(g0,5*8,7050000);
    put64(g0,6*8,7400000);
    put64(g0,7*8,7750000);
    put64(g0,8*8,8100000);
    put64(g0,9*8,8450000);
    put64(g0,10*8,8800000);
    put64(g0,11*8,9150000);
    put64(g0,12*8,9500000);
    put64(g0,13*8,9850000);
    put64(g0,14*8,10200000);
    put64(g0,15*8,10550000);
    put64(g0,16*8,10900000);
    put64(g0,17*8,11250000);
    put64(g0,18*8,11600000);
    put64(g0,19*8,11950000);
    put64(g0,20*8,12300000);
    put64(g0,21*8,12700000);
    put64(g0,22*8,12850000);
    put64(g0,23*8,13000000);
    put64(g0,24*8,17200000);
    put64(g0,25*8,18600000);
    put64(g0,26*8,20100000);
    put64(g0,27*8,21500000);
    put64(g0,28*8,23800000);
    put64(g0,29*8,25200000);
    put64(g0,30*8,26800000);
    put64(g0,31*8,28200000);
    let c0:i64=0;
    // group 1: 15 events, amp 0.5, atk 0.045, dec 0.16
    let n1:i64=15;
    let gp1:*u8=_zag_malloc(15*8) as *u8;
    let g1:[]u8=gp1[0..(15*8)];
    put64(g1,0*8,16900000);
    put64(g1,1*8,17120000);
    put64(g1,2*8,17340000);
    put64(g1,3*8,17560000);
    put64(g1,4*8,17780000);
    put64(g1,5*8,19100000);
    put64(g1,6*8,19320000);
    put64(g1,7*8,19540000);
    put64(g1,8*8,19760000);
    put64(g1,9*8,19980000);
    put64(g1,10*8,20200000);
    put64(g1,11*8,21100000);
    put64(g1,12*8,21320000);
    put64(g1,13*8,21540000);
    put64(g1,14*8,21760000);
    let c1:i64=0;
    // group 2: 6 events, amp 0.65, atk 0.06, dec 0.42
    let n2:i64=6;
    let gp2:*u8=_zag_malloc(6*8) as *u8;
    let g2:[]u8=gp2[0..(6*8)];
    put64(g2,0*8,2000000);
    put64(g2,1*8,4500000);
    put64(g2,2*8,8300000);
    put64(g2,3*8,10800000);
    put64(g2,4*8,24600000);
    put64(g2,5*8,27200000);
    let c2:i64=0;
    // group 3: 1 events, amp 1.5, atk 0.012, dec 0.3
    let n3:i64=1;
    let gp3:*u8=_zag_malloc(1*8) as *u8;
    let g3:[]u8=gp3[0..(1*8)];
    put64(g3,0*8,13150000);
    let c3:i64=0;
    // filter states (persist across the whole render: no-chop (c))
    let x1_0:f64=0.0; let x2_0:f64=0.0; let y1_0:f64=0.0; let y2_0:f64=0.0;
    let x1_1:f64=0.0; let x2_1:f64=0.0; let y1_1:f64=0.0; let y2_1:f64=0.0;
    let x1_2:f64=0.0; let x2_2:f64=0.0; let y1_2:f64=0.0; let y2_2:f64=0.0;
    let x1_3:f64=0.0; let x2_3:f64=0.0; let y1_3:f64=0.0; let y2_3:f64=0.0;
    let x1_4:f64=0.0; let x2_4:f64=0.0; let y1_4:f64=0.0; let y2_4:f64=0.0;
    let x1_5:f64=0.0; let x2_5:f64=0.0; let y1_5:f64=0.0; let y2_5:f64=0.0;
    let x1_6:f64=0.0; let x2_6:f64=0.0; let y1_6:f64=0.0; let y2_6:f64=0.0;
    let x1_7:f64=0.0; let x2_7:f64=0.0; let y1_7:f64=0.0; let y2_7:f64=0.0;
    let x1_8:f64=0.0; let x2_8:f64=0.0; let y1_8:f64=0.0; let y2_8:f64=0.0;
    let x1_9:f64=0.0; let x2_9:f64=0.0; let y1_9:f64=0.0; let y2_9:f64=0.0;
    let x1_10:f64=0.0; let x2_10:f64=0.0; let y1_10:f64=0.0; let y2_10:f64=0.0;
    let x1_11:f64=0.0; let x2_11:f64=0.0; let y1_11:f64=0.0; let y2_11:f64=0.0;
    let mp0:*u8=_zag_malloc(NSAMP*8) as *u8;
    let mix:[]u8=mp0[0..(NSAMP*8)];
    let peak:f64=0.0;
    let nblk:i64=(NSAMP+BLK-1)/BLK;
    let nbb:i64=0;
    while(nbb<nblk){
        let bs:i64=nbb*BLK;
        let be:i64=bs+BLK;
        if(be>NSAMP){be=NSAMP;}
        let tc:f64=((bs as f64)+((be-bs) as f64)*0.5)/44100.0;
        // composed global modulators: trip gasp dip + wind-down ease
        let dip:f64=1.0-0.5*sstep((tc-13.3)/0.4)*(1.0-sstep((tc-14.4)/0.5));
        let wa:f64=1.0-0.3*sstep((tc-23.5)/3.0);
        let dd:f64=dip*wa;
        while(c0<n0){
            let te0:f64=(get64(g0,c0*8) as f64)/1000000.0;
            if(te0+0.018+0.1*8.0<=tc){c0=c0+1;}else{break;}
        }
        let en0:f64=0.0;
        let j0:i64=c0;
        while(j0<n0){
            let te:f64=(get64(g0,j0*8) as f64)/1000000.0;
            if(te>tc){break;}
            en0=en0+bump(tc-te,0.7,0.018,0.1);
            j0=j0+1;
        }
        while(c1<n1){
            let te0:f64=(get64(g1,c1*8) as f64)/1000000.0;
            if(te0+0.045+0.16*8.0<=tc){c1=c1+1;}else{break;}
        }
        let en1:f64=0.0;
        let j1:i64=c1;
        while(j1<n1){
            let te:f64=(get64(g1,j1*8) as f64)/1000000.0;
            if(te>tc){break;}
            en1=en1+bump(tc-te,0.5,0.045,0.16);
            j1=j1+1;
        }
        while(c2<n2){
            let te0:f64=(get64(g2,c2*8) as f64)/1000000.0;
            if(te0+0.06+0.42*8.0<=tc){c2=c2+1;}else{break;}
        }
        let en2:f64=0.0;
        let j2:i64=c2;
        while(j2<n2){
            let te:f64=(get64(g2,j2*8) as f64)/1000000.0;
            if(te>tc){break;}
            en2=en2+bump(tc-te,0.65,0.06,0.42);
            j2=j2+1;
        }
        while(c3<n3){
            let te0:f64=(get64(g3,c3*8) as f64)/1000000.0;
            if(te0+0.012+0.3*8.0<=tc){c3=c3+1;}else{break;}
        }
        let en3:f64=0.0;
        let j3:i64=c3;
        while(j3<n3){
            let te:f64=(get64(g3,j3*8) as f64)/1000000.0;
            if(te>tc){break;}
            en3=en3+bump(tc-te,1.5,0.012,0.3);
            j3=j3+1;
        }
        // per-band slow gains at block center
        let e_0:f64=eband(tc,0,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let e_1:f64=eband(tc,1,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let e_2:f64=eband(tc,2,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let e_3:f64=eband(tc,3,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let e_4:f64=eband(tc,4,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let e_5:f64=eband(tc,5,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let e_6:f64=eband(tc,6,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let e_7:f64=eband(tc,7,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let e_8:f64=eband(tc,8,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let e_9:f64=eband(tc,9,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let e_10:f64=eband(tc,10,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let e_11:f64=eband(tc,11,esar,ss_0,sl_0,ss_1,sl_1,ss_2,sl_2,ss_3,sl_3,ss_4,sl_4,tr_0,tr_1,tr_2,tr_3,tr_4);
        let w_0:f64=wnd(0,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let w_1:f64=wnd(1,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let w_2:f64=wnd(2,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let w_3:f64=wnd(3,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let w_4:f64=wnd(4,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let w_5:f64=wnd(5,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let w_6:f64=wnd(6,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let w_7:f64=wnd(7,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let w_8:f64=wnd(8,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let w_9:f64=wnd(9,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let w_10:f64=wnd(10,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let w_11:f64=wnd(11,tc,mr_0,mr_1,mr_2,mr_3,mr_4,mr_5,mr_6,mr_7,mr_8,mr_9,mr_10,mr_11,md_0,md_1,md_2,md_3,md_4,md_5,md_6,md_7,md_8,md_9,md_10,md_11);
        let K_0:f64=fsqrt(e_0/ng_0)*(1.0+WANDER_AMT*(w_0-1.0))*dd*MASTER;
        let K_1:f64=fsqrt(e_1/ng_1)*(1.0+WANDER_AMT*(w_1-1.0))*dd*MASTER;
        let K_2:f64=fsqrt(e_2/ng_2)*(1.0+WANDER_AMT*(w_2-1.0))*dd*MASTER;
        let K_3:f64=fsqrt(e_3/ng_3)*(1.0+WANDER_AMT*(w_3-1.0))*dd*MASTER;
        let K_4:f64=fsqrt(e_4/ng_4)*(1.0+WANDER_AMT*(w_4-1.0))*dd*MASTER;
        let K_5:f64=fsqrt(e_5/ng_5)*(1.0+WANDER_AMT*(w_5-1.0))*dd*MASTER;
        let K_6:f64=fsqrt(e_6/ng_6)*(1.0+WANDER_AMT*(w_6-1.0))*dd*MASTER;
        let K_7:f64=fsqrt(e_7/ng_7)*(1.0+WANDER_AMT*(w_7-1.0))*dd*MASTER;
        let K_8:f64=fsqrt(e_8/ng_8)*(1.0+WANDER_AMT*(w_8-1.0))*dd*MASTER;
        let K_9:f64=fsqrt(e_9/ng_9)*(1.0+WANDER_AMT*(w_9-1.0))*dd*MASTER;
        let K_10:f64=fsqrt(e_10/ng_10)*(1.0+WANDER_AMT*(w_10-1.0))*dd*MASTER;
        let K_11:f64=fsqrt(e_11/ng_11)*(1.0+WANDER_AMT*(w_11-1.0))*dd*MASTER;
        let nn:i64=bs;
        while(nn<be){
            let x:f64=2.0*h01(SEED,nn)-1.0;
            let acc:f64=0.0;
            let y_0:f64=b0_0*x+b2_0*x2_0-a1_0*y1_0-a2_0*y2_0;
            x2_0=x1_0; x1_0=x; y2_0=y1_0; y1_0=y_0;
            acc=acc+y_0*K_0*(1.0+dip*(en0*1.0+en1*0.08+en2*0.06+en3*1.0));
            let y_1:f64=b0_1*x+b2_1*x2_1-a1_1*y1_1-a2_1*y2_1;
            x2_1=x1_1; x1_1=x; y2_1=y1_1; y1_1=y_1;
            acc=acc+y_1*K_1*(1.0+dip*(en0*0.8+en1*0.08+en2*0.06+en3*0.9));
            let y_2:f64=b0_2*x+b2_2*x2_2-a1_2*y1_2-a2_2*y2_2;
            x2_2=x1_2; x1_2=x; y2_2=y1_2; y1_2=y_2;
            acc=acc+y_2*K_2*(1.0+dip*(en0*0.5+en1*0.08+en2*0.4+en3*0.6));
            let y_3:f64=b0_3*x+b2_3*x2_3-a1_3*y1_3-a2_3*y2_3;
            x2_3=x1_3; x1_3=x; y2_3=y1_3; y1_3=y_3;
            acc=acc+y_3*K_3*(1.0+dip*(en0*0.08+en1*0.08+en2*0.8+en3*0.3));
            let y_4:f64=b0_4*x+b2_4*x2_4-a1_4*y1_4-a2_4*y2_4;
            x2_4=x1_4; x1_4=x; y2_4=y1_4; y1_4=y_4;
            acc=acc+y_4*K_4*(1.0+dip*(en0*0.08+en1*0.5+en2*1.0+en3*0.05));
            let y_5:f64=b0_5*x+b2_5*x2_5-a1_5*y1_5-a2_5*y2_5;
            x2_5=x1_5; x1_5=x; y2_5=y1_5; y1_5=y_5;
            acc=acc+y_5*K_5*(1.0+dip*(en0*0.08+en1*0.9+en2*0.7+en3*0.05));
            let y_6:f64=b0_6*x+b2_6*x2_6-a1_6*y1_6-a2_6*y2_6;
            x2_6=x1_6; x1_6=x; y2_6=y1_6; y1_6=y_6;
            acc=acc+y_6*K_6*(1.0+dip*(en0*0.08+en1*1.0+en2*0.4+en3*0.05));
            let y_7:f64=b0_7*x+b2_7*x2_7-a1_7*y1_7-a2_7*y2_7;
            x2_7=x1_7; x1_7=x; y2_7=y1_7; y1_7=y_7;
            acc=acc+y_7*K_7*(1.0+dip*(en0*0.08+en1*0.8+en2*0.06+en3*0.05));
            let y_8:f64=b0_8*x+b2_8*x2_8-a1_8*y1_8-a2_8*y2_8;
            x2_8=x1_8; x1_8=x; y2_8=y1_8; y1_8=y_8;
            acc=acc+y_8*K_8*(1.0+dip*(en0*0.55+en1*0.4+en2*0.06+en3*0.05));
            let y_9:f64=b0_9*x+b2_9*x2_9-a1_9*y1_9-a2_9*y2_9;
            x2_9=x1_9; x1_9=x; y2_9=y1_9; y1_9=y_9;
            acc=acc+y_9*K_9*(1.0+dip*(en0*0.45+en1*0.08+en2*0.06+en3*0.05));
            let y_10:f64=b0_10*x+b2_10*x2_10-a1_10*y1_10-a2_10*y2_10;
            x2_10=x1_10; x1_10=x; y2_10=y1_10; y1_10=y_10;
            acc=acc+y_10*K_10*(1.0+dip*(en0*0.3+en1*0.08+en2*0.06+en3*0.05));
            let y_11:f64=b0_11*x+b2_11*x2_11-a1_11*y1_11-a2_11*y2_11;
            x2_11=x1_11; x1_11=x; y2_11=y1_11; y1_11=y_11;
            acc=acc+y_11*K_11*(1.0+dip*(en0*0.08+en1*0.08+en2*0.06+en3*0.05));
            put64(mix,nn*8,(acc*16777216.0) as i64);
            let aa:f64=acc; if(aa<0.0){aa=-aa;}
            if(aa>peak){peak=aa;}
            nn=nn+1;
        }
        nbb=nbb+1;
    }
    print_str("pre-norm peak "); print_f3(peak); print_nl();
    let eb0:*u8=_zag_malloc(4096) as *u8;
    let eb:[]u8=eb0[0..4096];
    let elen:i64=0;
    elen=app3(eb,elen,1.2);
    elen=app3(eb,elen,2.0);
    elen=app3(eb,elen,2.9);
    elen=app3(eb,elen,4.5);
    elen=app3(eb,elen,4.6);
    elen=app3(eb,elen,5.8);
    elen=app3(eb,elen,6.7);
    elen=app3(eb,elen,7.05);
    elen=app3(eb,elen,7.4);
    elen=app3(eb,elen,7.75);
    elen=app3(eb,elen,8.1);
    elen=app3(eb,elen,8.3);
    elen=app3(eb,elen,8.45);
    elen=app3(eb,elen,8.8);
    elen=app3(eb,elen,9.15);
    elen=app3(eb,elen,9.5);
    elen=app3(eb,elen,9.85);
    elen=app3(eb,elen,10.2);
    elen=app3(eb,elen,10.55);
    elen=app3(eb,elen,10.8);
    elen=app3(eb,elen,10.9);
    elen=app3(eb,elen,11.25);
    elen=app3(eb,elen,11.6);
    elen=app3(eb,elen,11.95);
    elen=app3(eb,elen,12.3);
    elen=app3(eb,elen,12.7);
    elen=app3(eb,elen,12.85);
    elen=app3(eb,elen,13.0);
    elen=app3(eb,elen,13.15);
    elen=app3(eb,elen,16.9);
    elen=app3(eb,elen,17.12);
    elen=app3(eb,elen,17.2);
    elen=app3(eb,elen,17.34);
    elen=app3(eb,elen,17.56);
    elen=app3(eb,elen,17.78);
    elen=app3(eb,elen,18.6);
    elen=app3(eb,elen,19.1);
    elen=app3(eb,elen,19.32);
    elen=app3(eb,elen,19.54);
    elen=app3(eb,elen,19.76);
    elen=app3(eb,elen,19.98);
    elen=app3(eb,elen,20.1);
    elen=app3(eb,elen,20.2);
    elen=app3(eb,elen,21.1);
    elen=app3(eb,elen,21.32);
    elen=app3(eb,elen,21.5);
    elen=app3(eb,elen,21.54);
    elen=app3(eb,elen,21.76);
    elen=app3(eb,elen,23.8);
    elen=app3(eb,elen,24.6);
    elen=app3(eb,elen,25.2);
    elen=app3(eb,elen,26.8);
    elen=app3(eb,elen,27.2);
    elen=app3(eb,elen,28.2);
    let wrc:i64=file_write(ep,eb[0..elen]);
    if(wrc!=0){return 50;}
    let rc:i64=wav_write(wp,mix,NSAMP);
    print_str("render rc "); print_i64(rc); print_nl();
    return 0;
}

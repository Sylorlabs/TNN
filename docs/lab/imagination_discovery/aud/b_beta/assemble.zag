// ============================================================
// B-BETA (b+c hybrid) event assembler - CORE
// Every audible moment comes from a real captured source.
// Ops allowed: choose, cut, overlap, mute, reverse, vary timing.
// No oscillators, resonators, noise generators, chirps, booms,
// designed envelopes, pitch/time modification, or spectral processing.
// Deterministic: all choices via h32(seed, counter). Zero RNG.
// ============================================================

const SR:i64 = 44100;

// ---------- byte helpers ----------
fn put16(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
}
fn put32(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
}
fn put64(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
    b[i+4]=((v>>32) & 255) as u8;
    b[i+5]=((v>>40) & 255) as u8;
    b[i+6]=((v>>48) & 255) as u8;
    b[i+7]=((v>>56) & 255) as u8;
}
fn get16u(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8);
}
fn get16s(b:[]u8,i:i64)i64{
    let v:i64=(b[i] as i64) | ((b[i+1] as i64)<<8);
    return (v<<48)>>48;
}
fn get32u(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24);
}
fn get64(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24) | ((b[i+4] as i64)<<32) | ((b[i+5] as i64)<<40) | ((b[i+6] as i64)<<48) | ((b[i+7] as i64)<<56);
}

// ---------- deterministic hash (no RNG anywhere) ----------
fn h32(s:i64,st:i64)i64{
    let z:i64=(s*2654435761+st*40503+1) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    z=(z*2246822519) & 4294967295;
    z=(z ^ (z>>13)) & 4294967295;
    z=(z*3266489917) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    return z;
}

fn cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>8191){return "";}
    let p:*u8=_zag_malloc((s.len+1) as i64) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..(s.len+1)];
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn w_all(fd:i64,b:[]u8)i64{
    let at:i64=0;
    let calls:i32=0;
    let blen:i64=b.len as i64;
    while(at<blen && calls<16384){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+at,blen-at,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<=0){return -7407;}
        at=at+n;
    }
    if(at!=blen){return -7407;}
    return at;
}
fn r_all(fd:i64,b:[]u8,cap:i64)i64{
    let at:i64=0;
    while(at<cap){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(b) as i64)+at,cap-at,0,0,0);
        if(n<=0){break;}
        at=at+n;
    }
    return at;
}
// read whole file (cap bytes max); returns slice of actual bytes
fn read_file(path:[]u8,cap:i64)[]u8{
    let cs:[]u8=cstr(path);
    if(cs.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    if(fd<0){return "";}
    let p:*u8=_zag_malloc(cap) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..cap];
    let n:i64=r_all(fd,b,cap);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return b[0..n];
}
// parse 16-bit mono WAV: returns (data_off<<32)|nsamples, 0 on failure
fn wav_dataoff(b:[]u8)i64{
    let blen:i64=b.len as i64;
    if(blen<44){return 0;}
    if(get32u(b,0)!=1179011410){return 0;} // "RIFF"
    if(get32u(b,8)!=1163280727){return 0;}  // "WAVE"
    let off:i64=12;
    while(off+8<blen){
        let cid:i64=get32u(b,off);
        let csz:i64=get32u(b,off+4);
        if(cid==1635017060){ // "data"
            let n:i64=csz/2;
            return ((off+8)<<32) | n;
        }
        off=off+8+csz;
        if((csz & 1)==1){off=off+1;}
        if(off>blen){break;}
    }
    return 0;
}

// ---------- catalog record accessors (20-byte LE records) ----------
// rec: start_u32@0 end_u32@4 src_u16@8 voice_u16@10 peak_u16@12
//      cent_u16@14 durms_u16@16 flags_u16@18
fn cat_ncat(cat:[]u8)i64{return (cat.len as i64)/20;}
fn cat_start(cat:[]u8,i:i64)i64{return get32u(cat,i*20);}
fn cat_end(cat:[]u8,i:i64)i64{return get32u(cat,i*20+4);}
fn cat_src(cat:[]u8,i:i64)i64{return get16u(cat,i*20+8);}
fn cat_voice(cat:[]u8,i:i64)i64{return get16u(cat,i*20+10);}
fn cat_peak(cat:[]u8,i:i64)i64{return get16u(cat,i*20+12);}
fn cat_durms(cat:[]u8,i:i64)i64{return get16u(cat,i*20+16);}
fn cat_flags(cat:[]u8,i:i64)i64{return get16u(cat,i*20+18);}
fn cat_dursamp(cat:[]u8,i:i64)i64{return cat_end(cat,i)-cat_start(cat,i);}

// ---------- mix arena: i64 samples in []u8, 8 bytes/sample ----------
fn mix_new(nsamp:i64)[]u8{
    let p:*u8=_zag_malloc(nsamp*8) as *u8;
    let m:[]u8=p[0..(nsamp*8)];
    let i:i64=0;
    while(i<nsamp*8){m[i]=0;i=i+1;}
    return m;
}
// decimal writer for placement logs (writes into malloc'd scratch: string
// literals live in read-only memory and must never be written through)
fn wdec(fd:i64,v:i64)void{
    let neg:i64=0;
    let x:i64=v;
    if(x<0){neg=1;x=-x;}
    let p:*u8=_zag_malloc(24) as *u8;
    if(p==null as *u8){return;}
    let buf:[]u8=p[0..24];
    let e:i64=23;
    if(x==0){buf[23]=48;e=22;}
    while(x>0 && e>=0){
        buf[e]=((x%10)+48) as u8;
        x=x/10;
        e=e-1;
    }
    if(neg==1 && e>=0){buf[e]=45;e=e-1;}
    let s:i64=e+1;
    _zag_raw_syscall(1,fd,(_zag_slice_ptr(buf) as i64)+s,24-s,0,0,0);
    _zag_free(_zag_slice_ptr(buf));
}
fn wch(fd:i64,c:u8)void{
    let p:*u8=_zag_malloc(1) as *u8;
    if(p==null as *u8){return;}
    let b:[]u8=p[0..1];
    b[0]=c;
    _zag_raw_syscall(1,fd,_zag_slice_ptr(b) as i64,1,0,0,0);
    _zag_free(_zag_slice_ptr(b));
}
// place one event: copy n source samples at dst with gain gq (Q16),
// optional reversal, 3ms linear edge fades (seam removal only).
// src: source file bytes; sdata: data-chunk byte offset; s0: first src sample.
fn place(m:[]u8,mns:i64,mdst:i64,src:[]u8,sdata:i64,s0:i64,n:i64,gq:i64,rev:i64)void{
    if(n<8){return;}
    let F:i64=132;
    if(n<F*2){F=n/2;}
    let k:i64=0;
    while(k<n){
        let mo:i64=mdst+k;
        if(mo>=0 && mo<mns){
            let si:i64=s0+k;
            if(rev==1){si=s0+n-1-k;}
            let smp:i64=get16s(src,sdata+si*2);
            let fq:i64=65536;
            if(k<F){fq=(k*65536)/F;}
            if(k>n-F){fq=((n-k)*65536)/F;}
            let v:i64=(smp*gq)>>16;
            v=(v*fq)>>16;
            put64(m,mo*8,get64(m,mo*8)+v);
        }
        k=k+1;
    }
}

// ---------- WAV writer: DC-remove, normalize to -3dB, 30ms edge fades ----------
fn write_wav(path:[]u8,m:[]u8,ns:i64)i32{
    let s:i64=0;
    let sum:i64=0;
    while(s<ns){sum=sum+get64(m,s*8);s=s+1;}
    let mean:i64=sum/ns;
    let peak:i64=1;
    s=0;
    while(s<ns){
        let v:i64=get64(m,s*8)-mean;
        if(v<0){v=-v;}
        if(v>peak){peak=v;}
        s=s+1;
    }
    let norm:i64=(23200*65536)/peak; // -3dBFS headroom
    let total:i64=44+ns*2;
    let p:*u8=_zag_malloc(total) as *u8;
    if(p==null as *u8){return -1;}
    let out:[]u8=p[0..total];
    out[0]=82;out[1]=73;out[2]=70;out[3]=70;             // RIFF
    put32(out,4,total-8);
    out[8]=87;out[9]=65;out[10]=86;out[11]=69;           // WAVE
    out[12]=102;out[13]=109;out[14]=116;out[15]=32;     // fmt_
    put32(out,16,16);
    put16(out,20,1);put16(out,22,1);
    put32(out,24,44100);put32(out,28,88200);
    put16(out,32,2);put16(out,34,16);
    out[36]=100;out[37]=97;out[38]=116;out[39]=97;      // data
    put32(out,40,ns*2);
    let EF:i64=1323;
    s=0;
    while(s<ns){
        let v:i64=get64(m,s*8)-mean;
        v=(v*norm)>>16;
        let fq:i64=65536;
        if(s<EF){fq=(s*65536)/EF;}
        let rem:i64=ns-s;
        if(rem<EF){fq=(rem*65536)/EF;}
        v=(v*fq)>>16;
        if(v>32767){v=32767;}
        if(v<-32768){v=-32768;}
        put16(out,44+s*2,v);
        s=s+1;
    }
    let cs:[]u8=cstr(path);
    if(cs.len==0){_zag_free(_zag_slice_ptr(out));return -3;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),577,438,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    if(fd<0){_zag_free(_zag_slice_ptr(out));return -4;}
    let wr:i64=w_all(fd,out);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    _zag_free(_zag_slice_ptr(out));
    if(wr<0){return -5;}
    return 0;
}

@import("mech_kids.zag")
@import("mech_kethra.zag")
@import("mech_ocean.zag")

fn main()i32{
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    let subj:i32=0;
    if(_zag_strcmp(a1,"kids")==1){subj=1;}
    if(_zag_strcmp(a1,"kethra")==1){subj=2;}
    if(_zag_strcmp(a1,"ocean")==1){subj=3;}
    if(subj==0){return 7;}
    let rc:i32=0;
    if(subj==1){rc=score_kids(a2,a3);}
    if(subj==2){rc=score_kethra(a2,a3);}
    if(subj==3){rc=score_ocean(a2,a3);}
    return rc;
}

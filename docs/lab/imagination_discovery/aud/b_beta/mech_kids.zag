// ============================================================
// MECH_KIDS — per-piece combination mechanisms for "tag at dusk"
// (B-beta kids benchmark). DERIVED for this piece's imagined causes;
// see DERIVATION_kids.md. This file must not exist before the brief:
// a contagion clock parameterized by three specific imagined children,
// a breath ledger, and a tag-game phase graph are not a generic sequencer.
//
// Allowed ops only: choose, cut, overlap, mute, reverse, vary timing.
// No pitch/time modification, no spectral processing, no envelopes
// beyond 3ms seam fades (in place()) and mix gain staging.
// ============================================================

const K_SEED:i64 = 20260922;
const K_DUR_MS:i64 = 30000;

// imagined children -> catalog voices
// v0 = PIP (kid_laugh: 4yo boy, bright) | v1 = WREN (kids_park) | v3 = ASH (kids_playground)
// v5 = distant background calls | v9 = footsteps
const V_PIP:i64 = 0;
const V_WREN:i64 = 1;
const V_ASH:i64 = 3;
const V_BG:i64 = 5;
const V_STEP:i64 = 9;

// phases (ms)
const P0_END:i64 = 5000;    // taunt
const P1_END:i64 = 13000;   // chase
const P2_END:i64 = 15000;   // tag!
const P3_END:i64 = 26000;   // tumble-laugh
// P4 settle -> 30000

// source table: 6 slots x 24 bytes: ptr_u64@0 len_u64@8 dataoff_u64@16
fn stab_new()[]u8{
    let p:*u8=_zag_malloc(144) as *u8;
    let t:[]u8=p[0..144];
    let i:i64=0;
    while(i<144){t[i]=0;i=i+1;}
    return t;
}
fn stab_set(t:[]u8,k:i64,b:[]u8,dataoff:i64)void{
    put64(t,k*24,(_zag_slice_ptr(b) as i64));
    put64(t,k*24+8,b.len as i64);
    put64(t,k*24+16,dataoff);
}
fn stab_get(t:[]u8,k:i64)[]u8{
    let p:*u8=get64(t,k*24) as *u8;
    let ln:i64=get64(t,k*24+8);
    return p[0..ln];
}
fn stab_off(t:[]u8,k:i64)i64{return get64(t,k*24+16);}

fn load_src(t:[]u8,k:i64,path:[]u8)i64{
    let b:[]u8=read_file(path,40000000);
    if(b.len<100){return -1;}
    let pk:i64=wav_dataoff(b);
    if(pk==0){return -2;}
    stab_set(t,k,b,pk>>32);
    return (pk & 4294967295);
}

// pool: count catalog events matching voice+typebits, excluding bed(16)
fn pcount(cat:[]u8,ncat:i64,voice:i64,want:i64)i64{
    let c:i64=0;
    let i:i64=0;
    while(i<ncat){
        if(cat_voice(cat,i)==voice && (cat_flags(cat,i) & 16)==0 && (cat_flags(cat,i) & want)!=0){
            c=c+1;
        }
        i=i+1;
    }
    return c;
}
fn pkth(cat:[]u8,ncat:i64,voice:i64,want:i64,k:i64)i64{
    let c:i64=0;
    let i:i64=0;
    while(i<ncat){
        if(cat_voice(cat,i)==voice && (cat_flags(cat,i) & 16)==0 && (cat_flags(cat,i) & want)!=0){
            if(c==k){return i;}
            c=c+1;
        }
        i=i+1;
    }
    return -1;
}
// bed pool: voice 8, ONLY bed-flagged records (bit4 set)
fn bcount(cat:[]u8,ncat:i64)i64{
    let c:i64=0;
    let i:i64=0;
    while(i<ncat){
        if(cat_voice(cat,i)==8 && (cat_flags(cat,i) & 16)!=0){c=c+1;}
        i=i+1;
    }
    return c;
}
fn bkth(cat:[]u8,ncat:i64,k:i64)i64{
    let c:i64=0;
    let i:i64=0;
    while(i<ncat){
        if(cat_voice(cat,i)==8 && (cat_flags(cat,i) & 16)!=0){
            if(c==k){return i;}
            c=c+1;
        }
        i=i+1;
    }
    return -1;
}
// quietest bed record by peak (deterministic catalog query, no tuning).
// v2 uses it for the file's ending: the playground's air settling to its
// natural floor. mindur: the record must cover the remaining time.
fn quietest_bed(cat:[]u8,ncat:i64,mindur:i64)i64{
    let best:i64=-1;
    let bestpeak:i64=0;
    let i:i64=0;
    while(i<ncat){
        if(cat_voice(cat,i)==8 && (cat_flags(cat,i) & 16)!=0 && cat_durms(cat,i)>=mindur){
            let p:i64=cat_peak(cat,i);
            if(best<0 || p<bestpeak){best=i;bestpeak=p;}
        }
        i=i+1;
    }
    return best;
}
// deterministic pick with vetoes; returns catalog idx or -1
fn pick_ev(cat:[]u8,ncat:i64,seed:i64,ctr:i64,voice:i64,want:i64,forbid1:i64,forbid2:i64,maxdur:i64) i64{
    let cnt:i64=pcount(cat,ncat,voice,want);
    if(cnt==0){return -1;}
    let base:i64=h32(seed,ctr)%cnt;
    let t:i64=0;
    while(t<cnt){
        let idx:i64=pkth(cat,ncat,voice,want,(base+t)%cnt);
        if(idx!=forbid1 && idx!=forbid2){
            if(maxdur==0 || cat_durms(cat,idx)<=maxdur){
                return idx;
            }
        }
        t=t+1;
    }
    return -1;
}
// place catalog event idx at dst_ms with target peak; returns end ms.
// logfd>=0: append placement lineage line.
fn ev_place(m:[]u8,mns:i64,t:[]u8,cat:[]u8,idx:i64,dst_ms:i64,target:i64,rev:i64,logfd:i64) i64{
    let src:i64=cat_src(cat,idx);
    let s0:i64=cat_start(cat,idx);
    let n:i64=cat_dursamp(cat,idx);
    let peak:i64=cat_peak(cat,idx);
    if(peak<100){peak=100;}
    let gq:i64=(target*65536)/peak;
    let sb:[]u8=stab_get(t,src);
    let so:i64=stab_off(t,src);
    let dst:i64=(dst_ms*441)/10;
    place(m,mns,dst,sb,so,s0,n,gq,rev);
    if(logfd>=0){
        wdec(logfd,dst_ms);wch(logfd,32);
        wdec(logfd,src);wch(logfd,32);
        wdec(logfd,(s0*1000)/44100);wch(logfd,32);
        wdec(logfd,((s0+n)*1000)/44100);wch(logfd,32);
        wdec(logfd,cat_voice(cat,idx));wch(logfd,32);
        wdec(logfd,target);wch(logfd,32);
        wdec(logfd,rev);wch(logfd,10);
    }
    return dst_ms+cat_durms(cat,idx);
}

// breath ledger: budgets[3] ms, lasts[3] ms (per PIP/WREN/ASH slot 0..2)
// slot_of(voice): 0->0, 1->1, 3->2
fn slot_of(v:i64)i64{
    if(v==0){return 0;}
    if(v==1){return 1;}
    return 2;
}
// current budget with recovery applied (does not consume).
// Recovery runs at 1/4 real time: between hard laugh bursts a child
// recovers only partially — the ledger models net drain, which is what
// forces the late-chain shortening (the breath arc).
fn breath_budget(ledger:[]u8,now:i64,v:i64)i64{
    let s:i64=slot_of(v);
    let b:i64=get64(ledger,s*16);
    let last:i64=get64(ledger,s*16+8);
    b=b+(now-last)/4;
    if(b>3000){b=3000;}
    if(b<0){b=0;}
    return b;
}
// consume dur ms of budget at now; ledger clock advances
fn breath_consume(ledger:[]u8,now:i64,v:i64,dur:i64)void{
    let s:i64=slot_of(v);
    let b:i64=breath_budget(ledger,now,v)-dur;
    if(b<0){b=0;}
    put64(ledger,s*16,b);
    put64(ledger,s*16+8,now);
}

// ---- the piece ----
fn score_kids(outpath:[]u8,a3:[]u8)i32{
    let ns:i64=K_DUR_MS*441/10; // 1323000
    let logfd:i64=-1;
    if(_zag_strcmp(a3,"log")==1){
        let lp:[]u8=cstr("work/place_kids.log");
        if(lp.len>0){
            logfd=_zag_raw_syscall(2,(_zag_slice_ptr(lp) as i64),577,438,0,0,0);
            _zag_free(_zag_slice_ptr(lp));
        }
    }
    let m:[]u8=mix_new(ns);
    let cat:[]u8=read_file("catalog_kids.bin",200000);
    let ncat:i64=cat_ncat(cat);
    if(ncat<10){return -11;}
    let t:[]u8=stab_new();
    if(load_src(t,0,"work/wav/kids_park.wav")<0){return -12;}
    if(load_src(t,1,"work/wav/kids_playground.wav")<0){return -13;}
    if(load_src(t,2,"work/wav/kid_laugh.wav")<0){return -14;}
    if(load_src(t,3,"work/wav/kids_berlin.wav")<0){return -15;}
    if(load_src(t,4,"work/wav/footstep_gravel.wav")<0){return -16;}
    if(load_src(t,5,"work/wav/forest_track4.wav")<0){return -17;}

    let ledger:[]u8=stab_new(); // reuse zeroed arena shape (144B); use first 48
    put64(ledger,0,3000);put64(ledger,16,3000);put64(ledger,32,3000);
    put64(ledger,8,0);put64(ledger,24,0);put64(ledger,40,0);

    let ctr:i64=1;
    let f1:i64=-1;
    let f2:i64=-1;
    let now:i64=0;
    let idx:i64=0;

    // BED FIRST (under everything): real captured air, alternating short
    // segments from 2+ source regions so no 2s output window is one
    // unmodified source passage. This is the scene's room tone — a real
    // playground is never digital silence between events.
    let nbed:i64=bcount(cat,ncat);
    let lastbed:i64=-1;
    let bedt:i64=0;
    // v2 natural ending: the picked bed runs to bedt=27955 (v1's deterministic
    // trace value: 15 segments placed, bedt=27955 after the 15th). The two
    // tail segments v1 placed over the file's ending are still PICKED below
    // (identical ctr sequence -> every later phase's picks are unchanged),
    // but the ending itself is covered by the quietest captured air: the
    // playground settling to its natural floor. Choosing, not shaping: no
    // fades, no processing, same 300ms overlap, same target peak.
    while(bedt<27955){
        let bi:i64=-1;
        if(nbed>0){
            bi=bkth(cat,ncat,h32(K_SEED,ctr)%nbed);
            ctr=ctr+1;
            if(bi==lastbed && nbed>1){
                bi=bkth(cat,ncat,(h32(K_SEED,ctr)+1)%nbed);
                ctr=ctr+1;
            }
        }
        if(bi>=0){
            let bend:i64=ev_place(m,ns,t,cat,bi,bedt,2500,0,logfd);
            lastbed=bi;
            bedt=bend-300; // 300ms overlap: continuous air, no gaps
        }else{
            bedt=bedt+1000;
        }
    }
    // v2 tail: replicate v1's two remaining bed picks exactly (same ctr, same
    // lastbed logic) so the deterministic pick sequence is preserved; cover
    // the ending once with the quietest air.
    let qb:i64=quietest_bed(cat,ncat,30000-bedt+100);
    let ti:i64=0;
    while(ti<2){
        let bi:i64=-1;
        if(nbed>0){
            bi=bkth(cat,ncat,h32(K_SEED,ctr)%nbed);
            ctr=ctr+1;
            if(bi==lastbed && nbed>1){
                bi=bkth(cat,ncat,(h32(K_SEED,ctr)+1)%nbed);
                ctr=ctr+1;
            }
        }
        if(ti==0 && bi>=0 && qb>=0){
            ev_place(m,ns,t,cat,qb,bedt,2500,0,logfd);
        }
        if(bi>=0){lastbed=bi;}
        ti=ti+1;
    }

    // P0 TAUNT 0-5s: sparse shouts/calls across the playground
    now=400;
    let voices0:i64=0; // rotate PIP, ASH, WREN
    while(now<P0_END-800){
        let v:i64=V_PIP;
        if(voices0==1){v=V_ASH;}
        if(voices0==2){v=V_WREN;}
        voices0=voices0+1;
        if(voices0>2){voices0=0;}
        idx=pick_ev(cat,ncat,K_SEED,ctr,v,6,f1,f2,1200);
        ctr=ctr+1;
        if(idx>=0){
            let end:i64=ev_place(m,ns,t,cat,idx,now,16000,0,logfd);
            f2=f1;f1=idx;
            now=end+700+(h32(K_SEED,ctr)%4)*250;
            ctr=ctr+1;
        }else{
            now=now+900;
        }
    }
    // distant background calls in P0
    idx=pick_ev(cat,ncat,K_SEED,ctr,V_BG,6,-1,-1,600);ctr=ctr+1;
    if(idx>=0){ev_place(m,ns,t,cat,idx,1800,5000,0,logfd);}
    idx=pick_ev(cat,ncat,K_SEED,ctr,V_BG,6,-1,-1,600);ctr=ctr+1;
    if(idx>=0){ev_place(m,ns,t,cat,idx,3900,4500,0,logfd);}

    // P1 CHASE 5-13s: running steps + shouts + short laughs
    now=P0_END;
    let laststep:i64=-1;
    while(now<P1_END-400){
        let ioi:i64=260+(h32(K_SEED,ctr)%5)*36; // 260..404ms deterministic cadence
        ctr=ctr+1;
        idx=pick_ev(cat,ncat,K_SEED,ctr,V_STEP,32,laststep,-1,600);
        ctr=ctr+1;
        if(idx>=0){
            ev_place(m,ns,t,cat,idx,now,8000,0,logfd);
            laststep=idx;
        }
        now=now+ioi;
        // shouts at deterministic marks (catalog holds 2 real shouts: v0, v1)
        if(now>7000 && now<7400){
            idx=pick_ev(cat,ncat,K_SEED,ctr,V_ASH,4,f1,f2,700);ctr=ctr+1;
            if(idx>=0){ev_place(m,ns,t,cat,idx,now+120,17000,0,logfd);f2=f1;f1=idx;}
        }
        if(now>9500 && now<9900){
            idx=pick_ev(cat,ncat,K_SEED,ctr,V_PIP,2,f1,f2,900);ctr=ctr+1;
            if(idx>=0){ev_place(m,ns,t,cat,idx,now+120,17000,0,logfd);f2=f1;f1=idx;}
        }
        if(now>8000 && now<8400){
            idx=pick_ev(cat,ncat,K_SEED,ctr,V_WREN,4,f1,f2,700);ctr=ctr+1;
            if(idx>=0){ev_place(m,ns,t,cat,idx,now+150,15000,0,logfd);f2=f1;f1=idx;}
        }
        if(now>11000 && now<11400){
            idx=pick_ev(cat,ncat,K_SEED,ctr,V_PIP,4,f1,f2,700);ctr=ctr+1;
            if(idx>=0){ev_place(m,ns,t,cat,idx,now+150,15000,0,logfd);f2=f1;f1=idx;}
        }
    }

    // P2 TAG 13-15s: steps stop dead; the tag shout (WREN's real shout);
    // then the tagged one's gasp
    idx=pick_ev(cat,ncat,K_SEED,ctr,V_WREN,2,f1,f2,700);ctr=ctr+1;
    if(idx>=0){ev_place(m,ns,t,cat,idx,13100,19000,0,logfd);f2=f1;f1=idx;}
    idx=pick_ev(cat,ncat,K_SEED,ctr,V_PIP,4,f1,f2,600);ctr=ctr+1;
    if(idx>=0){ev_place(m,ns,t,cat,idx,13900,13000,1,logfd);} // reversed gasp-laugh

    // P3 TUMBLE 15-26s: contagion chain, laughs tumbling into each other.
    // Breath ledger STEERS the picks: as a voice's budget drains, only
    // shorter laughs are eligible — the audible "running out of breath" arc.
    now=15000;
    let v:i64=V_PIP; // PIP was tagged: laughs first
    let hyst:i64=0;
    while(now<P3_END-600){
        let bnow:i64=breath_budget(ledger,now,v);
        let maxd:i64=2600;
        if(bnow<2200){maxd=1000;}
        if(bnow<1000){maxd=500;}
        idx=pick_ev(cat,ncat,K_SEED,ctr,v,4,f1,f2,maxd);
        ctr=ctr+1;
        if(idx<0){
            // nothing eligible even short: rest 400ms, recover, keep the voice
            now=now+400;
            continue;
        }
        let dur:i64=cat_durms(cat,idx);
        breath_consume(ledger,now,v,dur);
        let rev:i64=0;
        if(h32(K_SEED,ctr)%5==0){rev=1;} // ~20% reversed gasps
        ctr=ctr+1;
        let end:i64=ev_place(m,ns,t,cat,idx,now,14000,rev,logfd);
        f2=f1;f1=idx;
        let peak:i64=cat_peak(cat,idx);
        // contagion latency: louder + more hysteria = shorter; next voice rotates
        let lat:i64=110-hyst*12-peak/600;
        if(lat<0){lat=0;}
        now=end-120+lat; // next laugh starts up to 120ms BEFORE this one ends: the tumble
        if(v==V_PIP){v=V_ASH;}else{if(v==V_ASH){v=V_WREN;}else{v=V_PIP;}}
        hyst=hyst+1;
        if(hyst>6){hyst=6;}
    }
    // depth: two distant background laughs during the tumble
    idx=pick_ev(cat,ncat,K_SEED,ctr,V_BG,4,-1,-1,900);ctr=ctr+1;
    if(idx>=0){ev_place(m,ns,t,cat,idx,17500,4500,0,logfd);}
    idx=pick_ev(cat,ncat,K_SEED,ctr,V_BG,4,-1,-1,900);ctr=ctr+1;
    if(idx>=0){ev_place(m,ns,t,cat,idx,22300,4000,0,logfd);}

    // P4 SETTLE 26-30s: breathy giggles, slow steps away, one distant call.
    // v2 natural ending: the third giggle is still PICKED (identical ctr
    // sequence -> everything before ~28s is byte-identical to v1) but not
    // placed — the settle dissolves instead of running to the file's edge.
    now=26200;
    let gi:i64=0;
    while(gi<3){
        let gv:i64=V_WREN;
        if(gi==1){gv=V_ASH;}
        if(gi==2){gv=V_PIP;}
        idx=pick_ev(cat,ncat,K_SEED,ctr,gv,4,f1,f2,550);ctr=ctr+1;
        if(idx>=0){
            let end:i64=now+cat_durms(cat,idx);
            if(gi<2){
                end=ev_place(m,ns,t,cat,idx,now,12000-gi*1500,0,logfd);
            }
            f2=f1;f1=idx;
            now=end+600+(h32(K_SEED,ctr)%3)*150;
            ctr=ctr+1;
        }else{now=now+700;}
        gi=gi+1;
    }
    now=26600;
    laststep=-1;
    let si:i64=0;
    while(si<4){
        idx=pick_ev(cat,ncat,K_SEED,ctr,V_STEP,32,laststep,-1,600);ctr=ctr+1;
        if(idx>=0){
            // v2: the fourth step is picked but not placed (settle dissolves)
            if(si<3){ev_place(m,ns,t,cat,idx,now,6500,0,logfd);}
            laststep=idx;
        }
        now=now+650+(h32(K_SEED,ctr)%3)*80;
        ctr=ctr+1;
        si=si+1;
    }
    idx=pick_ev(cat,ncat,K_SEED,ctr,V_BG,6,-1,-1,700);ctr=ctr+1;
    // v2: the distant call moves 100ms earlier so its tail fully decays by ~28.3s
    if(idx>=0){ev_place(m,ns,t,cat,idx,28100,4000,0,logfd);}

    let rc:i32=write_wav(outpath,m,ns);
    if(logfd>=0){_zag_raw_syscall(3,logfd,0,0,0,0,0);}
    return rc;
}

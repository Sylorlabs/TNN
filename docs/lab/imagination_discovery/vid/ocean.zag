@import("substrate/R33_NATIVE_IO_V1.zag")
// ============================================================
// ocean.zag — D-VID-1 "alien ocean": moving liquid surface of an
// extrasolar sea. 1024x1024, 48 frames, 24-bit BMP sequence.
// ROUND 2 (2026-09-22): blind-tell repair. v1 failed V-BLIND:
// judges named blur/template tells unprompted (only 3/5 "unsure").
// This rewrite repairs the six consolidated tells; the frozen
// prereg (../PREREG.md, commit 988255e64dfc) still governs all
// mechanical bars.
//
// REPAIR DESIGN (no template primitives anywhere: no rect / blotch /
// fill / placement calls of any kind; grep-audited):
//
//   TELL 1 (soft everywhere): sharp content at EVERY scale, per
//     pixel. Crest-line ridges (thin, thresholded), steep wave-face
//     edges from finite-difference normals, micro-striations in the
//     mid-tones, per-pixel ripple shading. High frequencies now live
//     in the scene structure, not in a speckle overlay.
//   TELL 2 (unanchored lighting): ONE sun, fixed for all 48 frames,
//     from the upper left (dir to sun L=(-620,+620,483), ~29 deg
//     elevation). Diffuse, specular glints, foam shading, crest
//     lit/shadow sides, and the basin lee shadow ALL derive from the
//     same L via per-pixel finite-difference normals. Nothing glows
//     without light logic.
//   TELL 3 (featureless blob): the dark region is now a migrating
//     abyssal basin with internal ring structure, a broken foam rim
//     where currents strike its edge, and a lee shadow on the side
//     away from the sun. Wave trains bend around it (tangential
//     swirl deflection of the sampling coords).
//   TELL 4 (fixed element): the basin center travels ~+/-260 px on a
//     slow deterministic path, its radius and depth morph; every
//     wave component advects (chop ~3 px/frame, ripple faster).
//     Nothing is static.
//   TELL 5 (re-tint cycling): the global palette-anchor field is
//     GONE. Color follows material logic only: depth -> water color
//     (shallow bioluminescent teal -> deep indigo -> abyssal black),
//     foam -> near-white, glints -> warm white, scatter glow in
//     sunlit shallows. Hue changes only because the scene evolves.
//   TELL 6 (speckle overlay): bright marks are physical: crest foam
//     as flow-elongated streaks, a broken foam rim on the basin,
//     specular glints placed by normal-vs-sun alignment (sparse,
//     on the steepest sun-facing slopes, sized by wave scale), and
//     thin micro-striations. No per-pixel random dots.
//
// TEMPORAL MODEL (film-grain philosophy kept): persistent = swell +
//   basin path (2 time cells over the sequence); changing = advected
//   chop, fast ripple, traveling basin, evolving foam (REAL scene
//   evolution, not palette drift); grain = +/-2 LSB per-pixel
//   deterministic hash dither, uncorrelated frame to frame.
//
// Evaluation is fully per-pixel at 1024 (no coarse grid anymore):
// height taps at +/-1 px give true finite-difference normals, so
// lighting and edges are sharp at full resolution.
//
// znc lessons honored: masked 63-bit hashes; no `};`; shallow if/else
// nesting (<=3); no `as []i32` indexed aliasing (byte accessors only);
// O_TRUNC never O_EXCL; _zag_arg never freed; _zag_strcmp==1 is equal;
// argv[1] selects config; no slice > 2^25 bytes (frame buffer
// 3,145,782 bytes); frame-by-frame emission.
// ============================================================

// ---------------- small helpers ----------------
fn o_clamp255(v:i64) i64 {
    if (v < 0) { return 0; }
    if (v > 255) { return 255; }
    return v;
}
fn o_clamp01k(v:i64) i64 {
    if (v < 0) { return 0; }
    if (v > 1000) { return 1000; }
    return v;
}
fn o_mix(a:i64, b:i64, t:i64) i64 {
    return a + (b - a) * t / 1000;
}
fn o_ss(t:i64) i64 {
    // smoothstep on 0..1000 -> 0..1000
    if (t <= 0) { return 0; }
    if (t >= 1000) { return 1000; }
    return t * t * (3000 - 2 * t) / 1000000;
}
fn o_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let x:i64 = v;
    let y:i64 = (x + 1) / 2;
    let guard:i64 = 0;
    while (y < x && guard < 64) { x = y; y = (x + v / x) / 2; guard = guard + 1; }
    return x;
}
fn o_atoi(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i64 = 0;
    while (i < s.len) {
        let c:i64 = s[i] as i64;
        if (c < 48 || c > 57) { return v; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

// ---------------- deterministic integer-hash value noise ----------------
fn o_hash2(ix:i64, iy:i64, seed:i64) i64 {
    let h:i64 = (ix * 374761393 + iy * 668265263 + seed * 974634211) & 9223372036854775807;
    h = h ^ (h >> 13);
    h = (h * 1274126177) & 9223372036854775807;
    h = h ^ (h >> 16);
    return h % 1001;
}
fn o_hash3(ix:i64, iy:i64, iz:i64, seed:i64) i64 {
    let h:i64 = (ix * 374761393 + iy * 668265263 + iz * 2246822519 + seed * 3266489917) & 9223372036854775807;
    h = h ^ (h >> 13);
    h = (h * 1274126177) & 9223372036854775807;
    h = h ^ (h >> 16);
    return h % 1001;
}
fn o_ss8(t:i64) i64 {
    return t * t * (768 - 2 * t) >> 16;
}
fn o_vn2(x8:i64, y8:i64, seed:i64) i64 {
    let ix:i64 = x8 >> 8;
    let iy:i64 = y8 >> 8;
    let fx:i64 = x8 & 255;
    let fy:i64 = y8 & 255;
    let sx:i64 = o_ss8(fx);
    let sy:i64 = o_ss8(fy);
    let v00:i64 = o_hash2(ix, iy, seed);
    let v10:i64 = o_hash2(ix + 1, iy, seed);
    let v01:i64 = o_hash2(ix, iy + 1, seed);
    let v11:i64 = o_hash2(ix + 1, iy + 1, seed);
    let a:i64 = v00 + (v10 - v00) * sx / 256;
    let b:i64 = v01 + (v11 - v01) * sx / 256;
    return a + (b - a) * sy / 256;
}
fn o_vn3(x8:i64, y8:i64, z8:i64, seed:i64) i64 {
    let ix:i64 = x8 >> 8;
    let iy:i64 = y8 >> 8;
    let iz:i64 = z8 >> 8;
    let fx:i64 = x8 & 255;
    let fy:i64 = y8 & 255;
    let fz:i64 = z8 & 255;
    let sx:i64 = o_ss8(fx);
    let sy:i64 = o_ss8(fy);
    let sz:i64 = o_ss8(fz);
    let c000:i64 = o_hash3(ix, iy, iz, seed);
    let c100:i64 = o_hash3(ix + 1, iy, iz, seed);
    let c010:i64 = o_hash3(ix, iy + 1, iz, seed);
    let c110:i64 = o_hash3(ix + 1, iy + 1, iz, seed);
    let c001:i64 = o_hash3(ix, iy, iz + 1, seed);
    let c101:i64 = o_hash3(ix + 1, iy, iz + 1, seed);
    let c011:i64 = o_hash3(ix, iy + 1, iz + 1, seed);
    let c111:i64 = o_hash3(ix + 1, iy + 1, iz + 1, seed);
    let x00:i64 = c000 + (c100 - c000) * sx / 256;
    let x10:i64 = c010 + (c110 - c010) * sx / 256;
    let x01:i64 = c001 + (c101 - c001) * sx / 256;
    let x11:i64 = c011 + (c111 - c011) * sx / 256;
    let y0:i64 = x00 + (x10 - x00) * sy / 256;
    let y1:i64 = x01 + (x11 - x01) * sy / 256;
    return y0 + (y1 - y0) * sz / 256;
}
fn o_fbm2(x8:i64, y8:i64, oct:i64, seed:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 1000;
    let tot:i64 = 0;
    let xx:i64 = x8;
    let yy:i64 = y8;
    let s:i64 = seed;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + o_vn2(xx, yy, s) * amp / 1000;
        tot = tot + amp;
        xx = xx * 2;
        yy = yy * 2;
        amp = amp / 2;
        s = s + 131;
        o = o + 1;
    }
    return sum * 1000 / tot;
}
fn o_fbm3(x8:i64, y8:i64, z8:i64, oct:i64, seed:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 1000;
    let tot:i64 = 0;
    let xx:i64 = x8;
    let yy:i64 = y8;
    let zz:i64 = z8;
    let s:i64 = seed;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + o_vn3(xx, yy, zz, s) * amp / 1000;
        tot = tot + amp;
        xx = xx * 2;
        yy = yy * 2;
        zz = zz * 2;
        amp = amp / 2;
        s = s + 131;
        o = o + 1;
    }
    return sum * 1000 / tot;
}
fn o_ridge2(x8:i64, y8:i64, oct:i64, seed:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 1000;
    let tot:i64 = 0;
    let xx:i64 = x8;
    let yy:i64 = y8;
    let s:i64 = seed;
    let o:i64 = 0;
    while (o < oct) {
        let n:i64 = o_vn2(xx, yy, s);
        let d:i64 = 2 * n - 1000;
        if (d < 0) { d = 0 - d; }
        let r:i64 = 1000 - d;
        r = r * r / 1000;
        sum = sum + r * amp / 1000;
        tot = tot + amp;
        xx = xx * 2;
        yy = yy * 2;
        amp = amp / 2;
        s = s + 131;
        o = o + 1;
    }
    return sum * 1000 / tot;
}

// ---------------- scene: the migrating abyssal basin ----------------
fn o_basin(f:i64, out_cx:*i64, out_cy:*i64, out_rad:*i64, out_dep:*i64) void {
    // slow deterministic path: ~2 time cells over the 48-frame sequence
    let z:i64 = f * 11;
    out_cx.* = 512 + (o_vn3(z, 7 * 256, 3 * 256, 91) - 500) * 560 / 1000;
    out_cy.* = 512 + (o_vn3(z, 99 * 256, 5 * 256, 92) - 500) * 480 / 1000;
    out_rad.* = 165 + o_vn3(z, 33 * 256, 9 * 256, 93) * 70 / 1000;
    out_dep.* = 7000 + o_vn3(z, 55 * 256, 13 * 256, 94) * 3000 / 1000;
}
fn o_bval(x:i64, y:i64, cx:i64, cy:i64, rad:i64, dep:i64) i64 {
    let dx:i64 = x - cx;
    let dy:i64 = y - cy;
    let r2:i64 = dx * dx + dy * dy;
    let rr:i64 = rad * rad;
    return dep * rr / (rr + r2);
}
// height-for-normals: chop*11 + ripple*5 - basin (px coords for B and
// ripple; deflected coords qx,qy for the advected chop field)
fn o_hc(px:i64, py:i64, qx:i64, qy:i64, f:i64, tz_fast:i64, cx:i64, cy:i64, rad:i64, dep:i64) i64 {
    let C:i64 = o_fbm2(qx * 9 / 2, qy * 9 / 2, 3, 51);
    let R:i64 = o_vn3(px * 16 - f * 73, py * 16 - f * 31, tz_fast, 71);
    let B:i64 = o_bval(px, py, cx, cy, rad, dep);
    return C * 14 + R * 4 - B;
}

// ---------------- per-pixel render ----------------
// Sun: fixed for all frames, upper-left, ~29 deg elevation.
// L (to sun) = (-620, +620, 483); |L| ~= 1001.
// half-vector H = L + (0,0,1000) = (-620, 620, 1483), |H| ~= 1723,
// normalized*1000 = (-360, 360, 861).
fn o_render_pixel(x:i64, y:i64, f:i64, cx:i64, cy:i64, rad:i64, dep:i64, tz_slow:i64, tz_fast:i64, advx:i64, advy:i64, dbg:i64, out_r:*i64, out_g:*i64, out_b:*i64) void {
    // advected coords, deflected tangentially around the basin so wave
    // trains bend around it instead of crossing it
    let ax:i64 = x - advx;
    let ay:i64 = y - advy;
    let dx:i64 = ax - cx;
    let dy:i64 = ay - cy;
    let r2:i64 = dx * dx + dy * dy;
    let rr:i64 = rad * rad;
    let fall:i64 = rr * 1000 / (rr + r2);
    let r:i64 = o_isqrt(r2);
    let rg:i64 = r;
    if (rg < 60) { rg = 60; }
    let sw:i64 = fall * 90 / 1000;
    if (r < 60) { sw = sw * r / 60; }
    let tx:i64 = 0 - dy * 1000 / rg;
    let ty:i64 = dx * 1000 / rg;
    let ox:i64 = ax + tx * sw / 1000;
    let oy:i64 = ay + ty * sw / 1000;
    // height components
    let S:i64 = o_fbm3(x * 3 / 2, y * 3 / 2, tz_slow, 2, 11);
    let hc0:i64 = o_hc(x, y, ox, oy, f, tz_fast, cx, cy, rad, dep);
    let hfx:i64 = o_hc(x + 1, y, ox + 1, oy, f, tz_fast, cx, cy, rad, dep);
    let hbx:i64 = o_hc(x - 1, y, ox - 1, oy, f, tz_fast, cx, cy, rad, dep);
    let hfy:i64 = o_hc(x, y + 1, ox, oy + 1, f, tz_fast, cx, cy, rad, dep);
    let hby:i64 = o_hc(x, y - 1, ox, oy - 1, f, tz_fast, cx, cy, rad, dep);
    let nx:i64 = hbx - hfx;
    let ny:i64 = hby - hfy;
    let nzz:i64 = 1500;
    let den:i64 = o_isqrt(nx * nx + ny * ny + nzz * nzz);
    let steep:i64 = nx;
    if (steep < 0) { steep = 0 - steep; }
    let ste2:i64 = ny;
    if (ste2 < 0) { ste2 = 0 - ste2; }
    steep = steep + ste2;
    // diffuse from the one sun
    let dnum:i64 = nx * -620 + ny * 620 + nzz * 483;
    let diff:i64 = 0;
    if (dnum > 0) { diff = dnum / den; }
    // specular: only where the surface tilts toward the sun MORE than flat
    // water does (flat-water sd = 861). Baseline-subtracted: no all-over
    // mirror wash; glints sit sparsely on the steepest sun-facing slopes.
    let snum:i64 = nx * -360 + ny * 360 + nzz * 861;
    let sd:i64 = 0;
    if (snum > 0) { sd = snum / den; }
    if (sd > 1000) { sd = 1000; }
    let gd:i64 = o_clamp01k((sd - 861) * 1000 / 120);
    let spec:i64 = gd * gd / 1000;
    let B:i64 = o_bval(x, y, cx, cy, rad, dep);
    if (dbg == 5) {
        // height-for-normals grayscale
        let hv:i64 = (hc0 + 10000) * 255 / 28000;
        out_r.* = o_clamp255(hv); out_g.* = o_clamp255(hv); out_b.* = o_clamp255(hv);
        return;
    }
    if (dbg == 8) {
        // basin influence grayscale
        let fv:i64 = fall * 255 / 1000;
        out_r.* = fv; out_g.* = fv; out_b.* = fv;
        return;
    }
    // ---- foam: high steep faces, streaked along the local flow ----
    let fm:i64 = o_ss(o_clamp01k((hc0 - 9500) * 1000 / 3500));
    let stm:i64 = o_ss(o_clamp01k((steep - 380) * 1000 / 450));
    // local flow = global current + basin swirl tangent
    let fx:i64 = 800 + tx * fall / 2500;
    let fy:i64 = 350 + ty * fall / 2500;
    let fn2:i64 = o_isqrt(fx * fx + fy * fy);
    let fux:i64 = fx * 1000 / fn2;
    let fuy:i64 = fy * 1000 / fn2;
    let u:i64 = (x * fux + y * fuy) / 1000;
    let v:i64 = (0 - x * fuy + y * fux) / 1000;
    let streak:i64 = o_ridge2(u * 3 / 2 - f * 40, v * 24, 2, 61);
    let st2:i64 = o_ss(o_clamp01k((streak - 600) * 1000 / 250));
    let foam:i64 = fm * stm / 1000;
    foam = foam * st2 / 1000;
    // broken foam rim where currents strike the basin edge
    let rim:i64 = o_ss(o_clamp01k((fall - 350) * 1000 / 200));
    rim = rim * o_ss(o_clamp01k((700 - fall) * 1000 / 200)) / 1000;
    let rimf:i64 = rim * o_ss(o_clamp01k((steep - 300) * 1000 / 500)) / 1000;
    rimf = rimf * o_ss(o_clamp01k((streak - 550) * 1000 / 250)) / 1000;
    if (rimf > foam) { foam = rimf; }
    if (dbg == 6) {
        let fv2:i64 = foam * 255 / 1000;
        out_r.* = fv2; out_g.* = fv2; out_b.* = fv2;
        return;
    }
    if (dbg == 7) {
        let sv:i64 = spec * 255 / 1000;
        out_r.* = sv; out_g.* = sv; out_b.* = sv;
        return;
    }
    // ---- crest lines: sharp ridges of the chop field, lit side bright
    let crest:i64 = o_ridge2(ox * 9 / 2, oy * 9 / 2, 2, 55);
    let crestline:i64 = o_ss(o_clamp01k((crest - 830) * 1000 / 120));
    // ---- micro-striations: thin sharp lines in the mid-tones ----
    let mb:i64 = o_vn2(x * 40 - f * 120, y * 40 - f * 50, 81);
    let md:i64 = mb - 500;
    if (md < 0) { md = 0 - md; }
    md = md * 2;
    let micro:i64 = o_ss(o_clamp01k((130 - md) * 1000 / 130));
    // ---- basin lee shadow: soft, sampled toward the sun ----
    let sx1:i64 = x - 620 * 40 / 1000;
    let sy1:i64 = y + 620 * 40 / 1000;
    let bd1:i64 = o_bval(sx1, sy1, cx, cy, rad, dep) - B;
    let sh:i64 = 1000 - 450 * o_ss(o_clamp01k((bd1 - 300) * 1000 / 1200)) / 1000;
    let sx2:i64 = x - 620 * 95 / 1000;
    let sy2:i64 = y + 620 * 95 / 1000;
    let bd2:i64 = o_bval(sx2, sy2, cx, cy, rad, dep) - B;
    let shb:i64 = 1000 - 300 * o_ss(o_clamp01k((bd2 - 300) * 1000 / 1200)) / 1000;
    if (shb < sh) { sh = shb; }
    // ---- color: material logic only. depth -> water color ----
    // shelf: very-low-frequency depth variation outside the basin, so the
    // frame has shallow banks and deeper channels (large-scale color logic)
    let shelf:i64 = o_fbm3(x / 2, y / 2, tz_slow, 2, 93) * 6;
    let d01:i64 = o_clamp01k((B + S * 3 + shelf) * 1000 / 16000);
    // internal basin structure: masked fbm texture inside the basin
    let iring:i64 = o_fbm2((x - cx) * 3 / 2, (y - cy) * 3 / 2, 2, 95) * fall / 1000;
    // shallow bioluminescent teal (20,168,152) -> mid deep blue
    // (12,74,132) -> deep indigo (7,12,34)
    let t1:i64 = o_ss(o_clamp01k((d01 - 150) * 1000 / 300));
    let t3:i64 = o_ss(o_clamp01k((d01 - 550) * 1000 / 280));
    let r:i64 = o_mix(o_mix(20, 12, t1), 7, t3);
    let gg:i64 = o_mix(o_mix(168, 74, t1), 12, t3);
    let b:i64 = o_mix(o_mix(152, 132, t1), 34, t3);
    // internal variation in the deep water
    let deepw:i64 = o_ss(o_clamp01k((d01 - 620) * 1000 / 280));
    r = r + deepw * iring / 80000;
    gg = gg + deepw * iring / 27000;
    b = b + deepw * iring / 32000;
    // sun shading, modulated by the swell for large-scale tonal range
    let li:i64 = 380 + diff * 520 / 1000;
    li = li + (S - 500) * 120 / 1000;
    r = r * li / 1000;
    gg = gg * li / 1000;
    b = b * li / 1000;
    // subsurface scatter glow in sunlit shallows
    let sc:i64 = o_ss(o_clamp01k((450 - d01) * 1000 / 450)) * diff / 1000;
    r = r + sc * 25 / 1000;
    gg = gg + sc * 80 / 1000;
    b = b + sc * 60 / 1000;
    // foam -> near-white, shaded by the sun
    let fw:i64 = foam * (600 + diff * 400 / 1000) / 1000;
    r = r + fw * 232 / 1000;
    gg = gg + fw * 240 / 1000;
    b = b + fw * 246 / 1000;
    // crest lines: lit side brightens, far side darkens
    let cl:i64 = crestline * diff / 1000;
    r = r + cl * 90 / 1000;
    gg = gg + cl * 110 / 1000;
    b = b + cl * 120 / 1000;
    let cs:i64 = crestline * (1000 - diff) / 1000;
    let dk:i64 = 1000 - cs * 250 / 1000;
    r = r * dk / 1000;
    gg = gg * dk / 1000;
    b = b * dk / 1000;
    // crisp sunlit edges on the steepest wave faces
    let edge:i64 = o_ss(o_clamp01k((steep - 700) * 1000 / 500)) * diff / 1000;
    r = r + edge * 70 / 1000;
    gg = gg + edge * 85 / 1000;
    b = b + edge * 90 / 1000;
    // specular glints: sharpened, sparse; plus a faint broad sheen
    // that follows the diffuse field (the glitter path)
    r = r + spec * 255 / 1000;
    gg = gg + spec * 246 / 1000;
    b = b + spec * 230 / 1000;
    let br:i64 = diff * diff / 1000 * 25 / 1000;
    r = r + br;
    gg = gg + br;
    b = b + br;
    // micro-striations lift the mid-tones
    let mi:i64 = micro * (300 + diff * 700 / 1000) / 1000;
    r = r + mi * 16 / 1000;
    gg = gg + mi * 20 / 1000;
    b = b + mi * 22 / 1000;
    // basin lee shadow
    r = r * sh / 1000;
    gg = gg * sh / 1000;
    b = b * sh / 1000;
    // film-grain dither: +/-2 LSB, per-frame uncorrelated, anti-banding
    let dith:i64 = o_hash3(x, y, f + 500, 78) % 5 - 2;
    r = r + dith;
    gg = gg + dith;
    b = b + dith;
    out_r.* = o_clamp255(r);
    out_g.* = o_clamp255(gg);
    out_b.* = o_clamp255(b);
}

// ---------------- BMP emission ----------------
fn o_put32(buf:[]u8, off:i64, v:i64) void {
    buf[off] = (v & 255) as u8;
    buf[off + 1] = ((v >> 8) & 255) as u8;
    buf[off + 2] = ((v >> 16) & 255) as u8;
    buf[off + 3] = ((v >> 24) & 255) as u8;
}
fn o_put16(buf:[]u8, off:i64, v:i64) void {
    buf[off] = (v & 255) as u8;
    buf[off + 1] = ((v >> 8) & 255) as u8;
}
fn o_zcstr_copy(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0 as u8;
    return b;
}
fn o_write_all(fd:i64, data:[]u8) i64 {
    let at:i64 = 0;
    let calls:i64 = 0;
    while (at < data.len && calls < 65536) {
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(data) as i64) + at, (data.len as i64) - at, 0, 0, 0);
        calls = calls + 1;
        if (n == -4) { continue; }
        if (n <= 0) { return -7407; }
        at = at + n;
    }
    if (at != data.len) { return -7407; }
    return at;
}
fn o_frame_path(dir:[]u8, f:i64) []u8 {
    let b:[]u8 = nio_alloc((dir.len + 16) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < dir.len && dir[i] != 0) { b[i] = dir[i]; i = i + 1; }
    b[i] = 47 as u8; i = i + 1;
    b[i] = 100 as u8; i = i + 1;
    b[i] = 118 as u8; i = i + 1;
    b[i] = 105 as u8; i = i + 1;
    b[i] = 100 as u8; i = i + 1;
    b[i] = 49 as u8; i = i + 1;
    b[i] = 95 as u8; i = i + 1;
    b[i] = 102 as u8; i = i + 1;
    b[i] = (48 + f / 10) as u8; i = i + 1;
    b[i] = (48 + f % 10) as u8; i = i + 1;
    b[i] = 46 as u8; i = i + 1;
    b[i] = 98 as u8; i = i + 1;
    b[i] = 109 as u8; i = i + 1;
    b[i] = 112 as u8; i = i + 1;
    b[i] = 0 as u8;
    return b;
}
fn o_emit_frame(f:i64, dir:[]u8, bmp:[]u8, dbg:i64) i64 {
    let W:i64 = 1024;
    let H:i64 = 1024;
    let cx:i64 = 0;
    let cy:i64 = 0;
    let rad:i64 = 0;
    let dep:i64 = 0;
    o_basin(f, &cx, &cy, &rad, &dep);
    let tz_slow:i64 = f * 512 / 47;
    let tz_fast:i64 = f * 2048 / 47;
    let advx:i64 = f * 140 / 47;
    let advy:i64 = f * 60 / 47;
    let y:i64 = 0;
    while (y < H) {
        let rowbase:i64 = 54 + (H - 1 - y) * W * 3;
        let x:i64 = 0;
        while (x < W) {
            let r:i64 = 0;
            let gg:i64 = 0;
            let b:i64 = 0;
            o_render_pixel(x, y, f, cx, cy, rad, dep, tz_slow, tz_fast, advx, advy, dbg, &r, &gg, &b);
            let at:i64 = rowbase + x * 3;
            bmp[at] = b as u8;
            bmp[at + 1] = gg as u8;
            bmp[at + 2] = r as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    let rowbytes:i64 = W * 3;
    let imgsz:i64 = rowbytes * H;
    bmp[0] = 66 as u8; bmp[1] = 77 as u8;
    o_put32(bmp, 2, 54 + imgsz);
    o_put32(bmp, 6, 0);
    o_put32(bmp, 10, 54);
    o_put32(bmp, 14, 40);
    o_put32(bmp, 18, W);
    o_put32(bmp, 22, H);
    o_put16(bmp, 26, 1);
    o_put16(bmp, 28, 24);
    o_put32(bmp, 30, 0);
    o_put32(bmp, 34, imgsz);
    o_put32(bmp, 38, 0);
    o_put32(bmp, 42, 0);
    o_put32(bmp, 46, 0);
    o_put32(bmp, 50, 0);
    let path:[]u8 = o_frame_path(dir, f);
    if (path.len == 0) { return -20; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 577, 420, 0, 0, 0);
    nio_free(path);
    if (fd < 0) { return -21; }
    let w:i64 = o_write_all(fd, bmp);
    nio_close(fd);
    if (w != bmp.len) { return -22; }
    return 0;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let adir:[]u8 = _zag_arg(2);
    if (adir.len == 0) {
        _zag_println("usage: ocean_bin all <dir> | ocean_bin f <dir> <n>");
        return 1;
    }
    let dir:[]u8 = o_zcstr_copy(adir);
    if (dir.len == 0) { return 2; }
    let bmp:[]u8 = nio_alloc(3145782);
    if (bmp.len == 0) { nio_free(dir); return 3; }
    let rc:i64 = 0;
    if (_zag_strcmp(a1, "all") == 1) {
        let f:i64 = 0;
        while (f < 48) {
            rc = o_emit_frame(f, dir, bmp, 0);
            _zag_print("frame ");
            _zag_print(_zag_i64_to_str(f));
            _zag_print(" rc=");
            _zag_println(_zag_i64_to_str(rc));
            if (rc != 0) { f = 48; }
            f = f + 1;
        }
    } else if (_zag_strcmp(a1, "f") == 1) {
        let a3:[]u8 = _zag_arg(3);
        let n:i64 = o_atoi(a3);
        if (n < 0 || n > 47) {
            _zag_println("error=frame-0..47");
            rc = 5;
        } else {
            rc = o_emit_frame(n, dir, bmp, 0);
            _zag_print("frame ");
            _zag_print(_zag_i64_to_str(n));
            _zag_print(" rc=");
            _zag_println(_zag_i64_to_str(rc));
        }
    } else if (_zag_strcmp(a1, "dbg") == 1) {
        let a3d:[]u8 = _zag_arg(3);
        let nd:i64 = o_atoi(a3d);
        let a4:[]u8 = _zag_arg(4);
        let ch:i64 = 5;
        if (_zag_strcmp(a4, "foam") == 1) { ch = 6; }
        if (_zag_strcmp(a4, "spec") == 1) { ch = 7; }
        if (_zag_strcmp(a4, "basin") == 1) { ch = 8; }
        if (nd < 0 || nd > 47) {
            _zag_println("error=frame-0..47");
            rc = 5;
        } else {
            rc = o_emit_frame(nd, dir, bmp, ch);
            _zag_print("dbg frame ");
            _zag_print(_zag_i64_to_str(nd));
            _zag_print(" ch=");
            _zag_println(_zag_i64_to_str(ch));
        }
    } else {
        _zag_println("usage: ocean_bin all <dir> | ocean_bin f <dir> <n>");
        rc = 6;
    }
    nio_free(dir);
    nio_free(bmp);
    if (rc != 0) { return 7; }
    return 0;
}

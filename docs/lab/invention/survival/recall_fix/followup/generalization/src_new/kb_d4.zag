// kb_d4.zag — RELAY domain KB codebook (new for E1b generalization).
// Conditions: C_DEST0..C_DEST3 (packet destination class).
// Actions: A_HUB0..A_HUB2 (relay hub choice).
// API: kb_d4_load(path, nh, hids, conds, acts, claims, pres, prios) -> n or -1.
//   hids: nh*16 bytes; conds/acts/claims/pres/prios: nh i64 slots (as []u8 arenas).
fn kb_d4_cond(name:[]u8)i64 {
  if(name.len==7 && name[2]==68 && name[6]>=48 && name[6]<=51){
    // "C_DESTn"
    return (name[6]-48) as i64;
  }
  return -1;
}
fn kb_d4_act(name:[]u8)i64 {
  if(name.len==6 && name[2]==72 && name[5]>=48 && name[5]<=50){
    // "A_HUBn"
    return (name[5]-48) as i64;
  }
  return -1;
}
fn kb_d4_load(path:[]u8,nh:i32,hids:[]u8,conds:[]u8,acts:[]u8,claims:[]u8,pres:[]u8,prios:[]u8)i64 {
  let cnt:i64=kb_count(path);
  if(cnt<0 || cnt>nh){return -1;}
  let out:[]u8=z_alloc(7*16);
  let i:i64=0;
  while(i<cnt){
    if(kb_get(path,i,out)==0){z_free(out);return -1;}
    let ii:i32=(i as i32);
    // HID
    let hp:i64=kb_field_ptr(out,1);let hl:i64=kb_field_len(out,1);
    let hs:[]u8=kb_slice(hp,hl);
    let q:i32=0;
    while(q<16){if((q as i64)<hl){hids[ii*16+q]=hs[q];}else{hids[ii*16+q]=0;}q=q+1;}
    // COND
    let cp:i64=kb_field_ptr(out,2);let cl:i64=kb_field_len(out,2);
    p_put(conds,ii,kb_d4_cond(kb_slice(cp,cl)));
    // ACT
    let ap:i64=kb_field_ptr(out,3);let al:i64=kb_field_len(out,3);
    p_put(acts,ii,kb_d4_act(kb_slice(ap,al)));
    // CLAIMED
    let dp:i64=kb_field_ptr(out,4);let dl:i64=kb_field_len(out,4);
    p_put(claims,ii,parse_i64(kb_slice(dp,dl)));
    p_put(pres,ii,0);
    // PRIO
    let pp:i64=kb_field_ptr(out,6);let pl:i64=kb_field_len(out,6);
    p_put(prios,ii,parse_i64(kb_slice(pp,pl)));
    i=i+1;
  }
  z_free(out);
  return cnt;
}
// match: heuristic's dest == world's current dest
fn kb_d4_match(w:[]u8,cond:i64)i64 {
  if(p_get(w,2)==cond){return 1;}
  return 0;
}

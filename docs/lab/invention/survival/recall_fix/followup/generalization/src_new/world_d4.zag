@import("common.zag")
// world_d4.zag — RELAY domain world (new for E1b generalization).
// Each tick a packet arrives with a destination class (0..3). The agent
// chooses a relay hub (0..2). Latency = matrix[dest][hub]. Utility = 100-latency.
// Variant file: '#' comment line, then 12 latencies (4 dests x 3 hubs),
// then 1 seed int for the deterministic destination sequence.
// Layout (i64 slots): 0=tick 1=alive 2=dest 3=seed 4..15=lat matrix (4x3)
//   16=cum_utility 17=nhubs(3) 18=ndests(4)
fn world_new()[]u8 {
  let w:[]u8=z_alloc(19*8);
  return w;
}
fn world_init(w:[]u8, path:[]u8)i32 {
  let data:[]u8=read_file(path);
  if(data.len==0){return -1;}
  // collect ints, skipping '#' comment lines
  let vals:[]u8=z_alloc(32*8);
  let nv:i32=0;let i:i32=0;let n:i32=data.len;
  while(i<n){
    let j:i32=i;
    while(j<n && data[j]!=10){j=j+1;}
    if(data[i]!=35){
      let k:i32=i;let neg:i32=0;let v:i64=0;let hd:i32=0;
      while(k<j){
        let c:u8=data[k];
        if(c==45){neg=1;}
        else if(c>=48 && c<=57){v=v*10+((c-48) as i64);hd=1;}
        k=k+1;
      }
      if(hd==1){if(neg==1){v=-v;} p_put(vals,nv,v);nv=nv+1;}
    }
    i=j+1;
  }
  z_free(data);
  if(nv<13){z_free(vals);return -2;}
  let d:i32=0;
  while(d<12){p_put(w,4+d,p_get(vals,d));d=d+1;}
  p_put(w,3,p_get(vals,12));
  z_free(vals);
  p_put(w,0,0);p_put(w,1,1);p_put(w,2,0);p_put(w,16,0);p_put(w,17,3);p_put(w,18,4);
  return 0;
}
// deterministic destination for tick t: (t*7+seed) mod 4, non-negative
fn d4_dest(seed:i64,t:i64)i64 {
  let v:i64=(t*7+seed)%4;
  if(v<0){v=v+4;}
  return v;
}
// step: agent chose hub h (0..2). Returns latency. Adds utility to cum.
fn d4_step(w:[]u8,h:i64)i64 {
  let t:i64=p_get(w,0);
  let dest:i64=d4_dest(p_get(w,3),t);
  p_put(w,2,dest);
  let lat:i64=p_get(w,4+dest*3+h);
  let u:i64=100-lat;
  p_put(w,16,p_get(w,16)+u);
  p_put(w,0,t+1);
  return lat;
}
fn d4_lat(w:[]u8,dest:i64,hub:i64)i64 { return p_get(w,4+dest*3+hub); }
fn emit_result(w:[]u8,arm:[]u8,variant:[]u8,rerun:i64,trace:[]u8,ntrace:i32)void {
  _zag_print("RESULT ");
  _zag_print(arm);_zag_print(" ");
  _zag_print(variant);_zag_print(" ");
  _zag_print(i64s(rerun));_zag_print(" ");
  _zag_print(i64s(p_get(w,0)));_zag_print(" ");   // ticks
  _zag_print(i64s(p_get(w,16)));_zag_print(" ");  // cum utility
  _zag_print(i64s(p_get(w,16)/600));_zag_print(" "); // mean utility
  _zag_print(i64s(p_get(w,2)));_zag_print(" ");   // last dest
  _zag_print("0 0 0 0 0");
  _zag_print("\nTRACE ");
  _zag_print(trace[0..ntrace]);
  _zag_print("\n");
}

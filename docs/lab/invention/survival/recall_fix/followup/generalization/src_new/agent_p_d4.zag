// agent_p_d4.zag — Arm P (perfect-information planner) for RELAY.
// Each tick: observe dest, choose the hub with minimum latency (ties -> lowest hub).
// argv: 1=variant_path 2=variant_name 3=rerun
@import("world_d4.zag")
fn main()i32 {
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let trace:[]u8=z_alloc(600);let nt:i32=0;
  while(p_get(w,0)<600){
    let t:i64=p_get(w,0);
    let dest:i64=d4_dest(p_get(w,3),t);
    let best:i64=0;let bl:i64=d4_lat(w,dest,0);let h:i64=1;
    while(h<3){
      let l:i64=d4_lat(w,dest,h);
      if(l<bl){bl=l;best=h;}
      h=h+1;
    }
    trace[nt]=(best+48) as u8;nt=nt+1;
    d4_step(w,best);
  }
  emit_result(w,"p",_zag_arg(2),parse_i64(_zag_arg(3)),trace,nt);
  z_free(trace);z_free(w);
  return 0;
}

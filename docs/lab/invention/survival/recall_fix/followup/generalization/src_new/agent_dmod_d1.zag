// agent_dmod_d1.zag — EXPLORATORY (not a prereg arm): D1 agent using the
// SHARED recall_delib.zag module unmodified, to test whether the module's
// machinery (observed-effect distrust + exploration) closes D1 regime gaps
// that the committed agent_d_d1.zag (precondition+priority only) cannot.
// Pseudo-actions (11 FLEE_ZONE, 12 MOVE_TO_MOTE) are resolved to primitives
// at recall time via kb_d1_resolve and written into heurs[hi].act before
// delib_select, so the module always sees primitive actions 0..6.
// Reward per tick = energy delta across the step (observed effect).
// argv: 1=variant_path 2=variant_name 3=rerun 4=kb_path
@import("world_d1.zag")
@import("kb_parse.zag")
@import("kb_d1.zag")
@import("recall_delib.zag")
fn print_hid(hids:[]u8,hi:i32)void {
  let q:i32=0;
  while(q<16 && hids[hi*16+q]!=0){q=q+1;}
  if(q==0){_zag_print("?");return;}
  let buf:[]u8=z_alloc((q as i64));
  let r:i32=0;
  while(r<q){buf[r]=hids[hi*16+r];r=r+1;}
  _zag_print(buf);
  z_free(buf);
}
fn main()i32 {
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let nh:i32=16;
  let hids:[]u8=z_alloc(nh*16);
  let conds:[]u8=z_alloc(nh*8);let acts:[]u8=z_alloc(nh*8);
  let claims:[]u8=z_alloc(nh*8);let pres:[]u8=z_alloc(nh*8);let prios:[]u8=z_alloc(nh*8);
  let n:i64=kb_d1_load(_zag_arg(4),nh,hids,conds,acts,claims,pres,prios);
  if(n<0){return 2;}
  let heurs:[]u8=z_alloc(nh*8*8);
  let i:i64=0;
  while(i<n){
    let ii:i32=(i as i32);
    p_put(heurs,ii*8+0,p_get(conds,ii));
    p_put(heurs,ii*8+1,p_get(acts,ii));
    p_put(heurs,ii*8+2,p_get(claims,ii));
    p_put(heurs,ii*8+3,p_get(pres,ii));
    p_put(heurs,ii*8+4,p_get(prios,ii));
    i=i+1;
  }
  let n_acts:i32=7;
  let st:[]u8=z_alloc(delib_state_size((n as i32),n_acts)*8);
  delib_init(st,(n as i32),n_acts);
  let trace:[]u8=z_alloc(600);let nt:i32=0;
  while(p_get(w,0)<600 && p_get(w,4)==1){
    // RECALL: first matching heuristic (priority/file order, like R)
    let hi:i32=-1;let j:i64=0;
    while(j<n){
      if(kb_d1_match(w,p_get(heurs,(j as i32)*8+0))==1){
        hi=(j as i32);
        j=n;
      }
      j=j+1;
    }
    if(hi<0){
      // No heuristic matched: default WAIT (like R), no module update.
      _zag_print("RECALL none\nEVAL none 0\nVERDICT 6\n");
      trace[nt]=54;nt=nt+1;
      step(w,6);
    } else {
    _zag_print("RECALL ");
    print_hid(hids,hi);
    _zag_print("\n");
    // Resolve pseudo-action to primitive for this tick's state
    let ract:i64=kb_d1_resolve(w,p_get(heurs,hi*8+1));
    p_put(heurs,hi*8+1,ract);
    // EVAL + select via shared module
    let exploring:i32=0;
    let a:i64=delib_select(st,heurs,hi,n_acts,&exploring);
    let score:i64=delib_score(st,heurs,hi,a,n_acts);
    _zag_print("EVAL ");
    print_hid(hids,hi);
    _zag_print(" ");
    _zag_print(i64s(score));
    _zag_print("\n");
    _zag_print("VERDICT ");
    _zag_print(i64s(a));
    _zag_print("\n");
    let e0:i64=p_get(w,2);
    step(w,a);
    let r:i64=p_get(w,2)-e0;
    if(p_get(w,4)==0){r=r-200;}
    delib_update(st,hi,a,r,n_acts,heurs);
    trace[nt]=(a+48) as u8;nt=nt+1;
    }
  }
  emit_result(w,"dmod",_zag_arg(2),parse_i64(_zag_arg(3)),trace,nt);
  z_free(trace);z_free(w);z_free(hids);z_free(conds);z_free(acts);
  z_free(claims);z_free(pres);z_free(prios);z_free(heurs);z_free(st);
  return 0;
}

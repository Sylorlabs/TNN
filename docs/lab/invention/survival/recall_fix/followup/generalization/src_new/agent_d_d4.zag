// agent_d_d4.zag — Arm D (deliberative) for RELAY.
// Uses src/recall_delib.zag UNMODIFIED (imported verbatim from the phase-2
// commit). Domain adapter: dest-class -> heuristic index; hub choice 0..2.
// Each tick: recall heuristic for current dest; delib_select picks hub;
// observed utility (100-latency) feeds delib_update.
// argv: 1=variant_path 2=variant_name 3=rerun 4=kb_path
@import("world_d4.zag")
@import("kb_parse.zag")
@import("kb_d4.zag")
@import("recall_delib.zag")
fn print_hid(hids:[]u8,hi:i32)void {
  let q:i32=0;
  while(q<16 && hids[hi*16+q]!=0){q=q+1;}
  if(q==0){_zag_print("?");return;}
  let buf:[]u8=z_alloc((q as i64));
  let r:i32=0;
  while(r<q){buf[r]=hids[hi*16+r];r=r+1;}
  _zag_print(buf);
  z_free(buf);
}
fn main()i32 {
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let nh:i32=8;
  let hids:[]u8=z_alloc(nh*16);
  let conds:[]u8=z_alloc(nh*8);let acts:[]u8=z_alloc(nh*8);
  let claims:[]u8=z_alloc(nh*8);let pres:[]u8=z_alloc(nh*8);let prios:[]u8=z_alloc(nh*8);
  let n:i64=kb_d4_load(_zag_arg(4),nh,hids,conds,acts,claims,pres,prios);
  if(n<0){return 2;}
  let heurs:[]u8=z_alloc(nh*8*8);
  let i:i64=0;
  while(i<n){
    let ii:i32=(i as i32);
    p_put(heurs,ii*8+0,p_get(conds,ii));
    p_put(heurs,ii*8+1,p_get(acts,ii));
    p_put(heurs,ii*8+2,p_get(claims,ii));
    p_put(heurs,ii*8+3,0);
    p_put(heurs,ii*8+4,p_get(prios,ii));
    i=i+1;
  }
  let n_acts:i32=3;
  let st:[]u8=z_alloc(delib_state_size((n as i32),n_acts)*8);
  delib_init(st,(n as i32),n_acts);
  let trace:[]u8=z_alloc(600);let nt:i32=0;
  while(p_get(w,0)<600){
    let t:i64=p_get(w,0);
    let dest:i64=d4_dest(p_get(w,3),t);
    p_put(w,2,dest);
    // RECALL: heuristic whose dest matches (exactly one per dest in our KBs)
    let hi:i32=-1;let j:i64=0;
    while(j<n){
      if(p_get(heurs,(j as i32)*8+0)==dest){hi=(j as i32);j=n;}
      j=j+1;
    }
    if(hi<0){hi=0;}
    _zag_print("RECALL ");
    print_hid(hids,hi);
    _zag_print("\n");
    let exploring:i32=0;
    let hub:i64=delib_select(st,heurs,hi,n_acts,&exploring);
    let score:i64=delib_score(st,heurs,hi,hub,n_acts);
    _zag_print("EVAL ");
    print_hid(hids,hi);
    _zag_print(" ");
    _zag_print(i64s(score));
    _zag_print("\n");
    _zag_print("VERDICT ");
    _zag_print(i64s(hub));
    _zag_print("\n");
    let lat:i64=d4_step(w,hub);
    let u:i64=100-lat;
    delib_update(st,hi,hub,u,n_acts,heurs);
    trace[nt]=(hub+48) as u8;nt=nt+1;
  }
  emit_result(w,"d",_zag_arg(2),parse_i64(_zag_arg(3)),trace,nt);
  z_free(trace);z_free(w);z_free(hids);z_free(conds);z_free(acts);
  z_free(claims);z_free(pres);z_free(prios);z_free(heurs);z_free(st);
  return 0;
}

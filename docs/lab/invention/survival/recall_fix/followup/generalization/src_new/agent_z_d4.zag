// agent_z_d4.zag — Arm Z for RELAY: fixed-seed LCG over 3 hubs.
// state = (state*1103515245+12345) mod 2^31; seed=777000+variant_seq; hub=state%3.
// argv: 1=variant_path 2=variant_name 3=rerun 4=variant_seq
@import("world_d4.zag")
fn main()i32 {
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let st:i64=777000+parse_i64(_zag_arg(4));
  let trace:[]u8=z_alloc(600);let nt:i32=0;
  while(p_get(w,0)<600){
    st=((st*1103515245+12345) & 0x7fffffff);
    let a:i64=st%3;
    trace[nt]=(a+48) as u8;nt=nt+1;
    d4_step(w,a);
  }
  emit_result(w,"z",_zag_arg(2),parse_i64(_zag_arg(3)),trace,nt);
  z_free(trace);z_free(w);
  return 0;
}

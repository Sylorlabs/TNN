// agent_r_d4.zag — Arm R (reflexive recall) for RELAY.
// Loads KB; each tick finds the first heuristic whose dest matches, takes its hub.
// No evaluation, no learning. argv: 1=variant_path 2=variant_name 3=rerun 4=kb_path
@import("world_d4.zag")
@import("kb_parse.zag")
@import("kb_d4.zag")
fn main()i32 {
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let nh:i32=8;
  let hids:[]u8=z_alloc(nh*16);
  let conds:[]u8=z_alloc(nh*8);let acts:[]u8=z_alloc(nh*8);
  let claims:[]u8=z_alloc(nh*8);let pres:[]u8=z_alloc(nh*8);let prios:[]u8=z_alloc(nh*8);
  let n:i64=kb_d4_load(_zag_arg(4),nh,hids,conds,acts,claims,pres,prios);
  if(n<0){return 2;}
  let trace:[]u8=z_alloc(600);let nt:i32=0;
  while(p_get(w,0)<600){
    let t:i64=p_get(w,0);
    let dest:i64=d4_dest(p_get(w,3),t);
    p_put(w,2,dest);
    let hub:i64=0;let j:i64=0;
    while(j<n){
      if(p_get(conds,(j as i32))==dest){hub=p_get(acts,(j as i32));j=n;}
      j=j+1;
    }
    trace[nt]=(hub+48) as u8;nt=nt+1;
    d4_step(w,hub);
  }
  emit_result(w,"r",_zag_arg(2),parse_i64(_zag_arg(3)),trace,nt);
  z_free(trace);z_free(w);z_free(hids);z_free(conds);z_free(acts);
  z_free(claims);z_free(pres);z_free(prios);
  return 0;
}

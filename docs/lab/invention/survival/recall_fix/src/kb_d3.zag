// kb_d3.zag — D3 (TOOL) KB codebook.
// COND: 1 C_TASK_0 | 2 C_TASK_1 | 3 C_TASK_2
// ACT: 0 A_TOOL_0 | 1 A_TOOL_1 | 2 A_TOOL_2 | 3 A_TOOL_3 (primitives, direct)
// Fact bits: 1 F_TASK_0 | 2 F_TASK_1 | 4 F_TASK_2 |
//            8 F_WEAR0_OK | 16 F_WEAR1_OK | 32 F_WEAR2_OK | 64 F_WEAR3_OK
// Requires common.zag + kb_parse.zag.
fn kb_d3_cond(s:[]u8)i64 {
  if(streq(s,"C_TASK_0")==1){return 1;}
  if(streq(s,"C_TASK_1")==1){return 2;}
  if(streq(s,"C_TASK_2")==1){return 3;}
  return -1;
}
fn kb_d3_act(s:[]u8)i64 {
  if(streq(s,"A_TOOL_0")==1){return 0;}
  if(streq(s,"A_TOOL_1")==1){return 1;}
  if(streq(s,"A_TOOL_2")==1){return 2;}
  if(streq(s,"A_TOOL_3")==1){return 3;}
  return -1;
}
fn kb_d3_fact(s:[]u8)i64 {
  if(streq(s,"F_TASK_0")==1){return 1;}
  if(streq(s,"F_TASK_1")==1){return 2;}
  if(streq(s,"F_TASK_2")==1){return 4;}
  if(streq(s,"F_WEAR0_OK")==1){return 8;}
  if(streq(s,"F_WEAR1_OK")==1){return 16;}
  if(streq(s,"F_WEAR2_OK")==1){return 32;}
  if(streq(s,"F_WEAR3_OK")==1){return 64;}
  return 0;
}
fn kb_d3_pre(s:[]u8)i64 {
  if(streq(s,"NONE")==1){return 0;}
  let m:i64=0;let i:i32=0;let n:i32=s.len;
  while(i<n){
    let j:i32=i;
    while(j<n && s[j]!=44){j=j+1;}
    m=m | kb_d3_fact(s[i..j]);
    i=j+1;
  }
  return m;
}
fn kb_d3_load(path:[]u8,nh:i32,hids:[]u8,conds:[]u8,acts:[]u8,claims:[]u8,pres:[]u8,prios:[]u8)i64 {
  let n:i64=kb_count(path);
  if(n<0 || n> (nh as i64)){return -1;}
  let fld:[]u8=z_alloc(7*16);
  let i:i64=0;
  while(i<n){
    if(kb_get(path,i,fld)==0){z_free(fld);return -1;}
    let hid:[]u8=kb_slice(kb_field_ptr(fld,1),kb_field_len(fld,1));
    let ii:i32=(i as i32);
    let q:i32=0;
    while(q<16){if(q<hid.len){hids[ii*16+q]=hid[q];}else{hids[ii*16+q]=0;}q=q+1;}
    p_put(conds,ii,kb_d3_cond(kb_slice(kb_field_ptr(fld,2),kb_field_len(fld,2))));
    p_put(acts,ii,kb_d3_act(kb_slice(kb_field_ptr(fld,3),kb_field_len(fld,3))));
    p_put(claims,ii,parse_i64(kb_slice(kb_field_ptr(fld,4),kb_field_len(fld,4))));
    p_put(pres,ii,kb_d3_pre(kb_slice(kb_field_ptr(fld,5),kb_field_len(fld,5))));
    p_put(prios,ii,parse_i64(kb_slice(kb_field_ptr(fld,6),kb_field_len(fld,6))));
    i=i+1;
  }
  z_free(fld);
  return n;
}
// Matcher: task t (0..2) matches cond c (1..3) iff t == c-1.
fn kb_d3_match(t:i64,cond:i64)i64 {
  if(cond>=1 && cond<=3 && t==cond-1){return 1;}
  return 0;
}

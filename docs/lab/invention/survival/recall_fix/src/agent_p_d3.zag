@import("world_d3.zag")
// Arm P (positive control) for D3: picks the argmax tool for the current task
// using the CURRENT conditions (reads d3_cond). Optimal by construction.
// argv: 1=variant_path 2=variant_name 3=rerun
fn main()i32 {
  let w:[]u8=z_alloc(64*8);
  if(d3_init(w,_zag_arg(1))!=0){return 1;}
  let bb:i64=p_get(w,4);
  while(p_get(w,0)<p_get(w,1)){
    let task:i64=d3_task(w);
    let best:i64=0;let bestr:i64=-1;let x:i64=0;
    while(x<4){
      let base:i64=p_get(w,(bb+task*4+x) as i32);
      let r:i64=(base*d3_cond(w,x))/100;
      if(x==0 || r>bestr){bestr=r;best=x;}
      x=x+1;
    }
    d3_step(w,best);
  }
  d3_result(w,"p",_zag_arg(2),parse_i64(_zag_arg(3)));
  z_free(w);
  return 0;
}

@import("world_d1.zag")
@import("kb_parse.zag")
@import("kb_d1.zag")
// Arm R (reflexive recall) for D1. argv: 1=variant_path 2=variant_name 3=rerun 4=kb_path
// Policy: first KB heuristic (file/priority order) whose condition matches -> execute.
// No evaluation of fit. Default action: WAIT (6).
fn main()i32 {
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let nh:i32=16;
  let hids:[]u8=z_alloc(nh*16);
  let conds:[]u8=z_alloc(nh*8);let acts:[]u8=z_alloc(nh*8);
  let claims:[]u8=z_alloc(nh*8);let pres:[]u8=z_alloc(nh*8);let prios:[]u8=z_alloc(nh*8);
  let n:i64=kb_d1_load(_zag_arg(4),nh,hids,conds,acts,claims,pres,prios);
  if(n<0){return 2;}
  let trace:[]u8=z_alloc(600);let nt:i32=0;
  while(p_get(w,0)<600 && p_get(w,4)==1){
    let a:i64=6;let i:i64=0;
    while(i<n){
      if(kb_d1_match(w,p_get(conds,(i as i32)))==1){
        a=kb_d1_resolve(w,p_get(acts,(i as i32)));
        i=n;
      }
      i=i+1;
    }
    trace[nt]=(a+48) as u8;nt=nt+1;
    step(w,a);
  }
  emit_result(w,"r",_zag_arg(2),parse_i64(_zag_arg(3)),trace,nt);
  z_free(trace);z_free(w);
  z_free(hids);z_free(conds);z_free(acts);z_free(claims);z_free(pres);z_free(prios);
  return 0;
}

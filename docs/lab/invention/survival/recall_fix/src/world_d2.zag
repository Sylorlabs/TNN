@import("common.zag")
// world_d2.zag — D2 SHIFT domain (signal-meaning inversion) for Experiment 1b.
//
// The world shows a 2-bit signal (f1,f2) each tick and the agent picks one of
// 4 actions (0=APPROACH, 1=HOLD, 2=RETREAT, 3=WAIT). Reward depends on the
// (signal, action) pair via a 4x3 table in the variant.
//
// Variant file: [T, plen, (f1,f2) x plen, table[12]]
//   T: ticks (600). plen: pattern length (8). pattern: plen pairs.
//   table: 12 ints, row-major: for s in [(0,0),(0,1),(1,0),(1,1)]:
//     [r_approach, r_hold, r_retreat]. WAIT always gives 0.
// Total ints = 2 + 2*plen + 12.
//
// Home regime: table = home_table (e.g., APPROACH good on (1,1), RETREAT on (0,0)).
// Shifted regime: the MEANING inverts — the table is permuted so the home-best
//   action is now the worst. R_home (home KB) keeps picking the home-best action
//   and is harmed. R_true (regime-correct KB) knows the new table.
//
// State slots: 0 tick | 1 T | 2 plen | 3 pat_base(=10) | 4 tab_base | 5 total_reward
// Pattern at slots 10..; table right after.
// Deterministic. No RNG.
fn d2_init(w:[]u8,path:[]u8)i32 {
  let data:[]u8=read_file(path);
  if(data.len==0){return 1;}
  let ints:[]u8=z_alloc(64*8);
  let n:i32=parse_ints(data,ints);
  z_free(data);
  if(n<16){z_free(ints);return 2;}
  let T:i64=p_get(ints,0);let plen:i64=p_get(ints,1);
  if(2+2*plen+12!= (n as i64)){z_free(ints);return 3;}
  p_put(w,0,0);p_put(w,1,T);p_put(w,2,plen);
  p_put(w,3,10);p_put(w,4,10+2*plen);p_put(w,5,0);
  let i:i64=0;
  while(i<2*plen){
    p_put(w,(10+i) as i32,p_get(ints,(2+i) as i32));
    i=i+1;
  }
  i=0;
  while(i<12){
    p_put(w,(10+2*plen+i) as i32,p_get(ints,(2+2*plen+i) as i32));
    i=i+1;
  }
  z_free(ints);
  return 0;
}
// Current signal bits -> obs mask (bit0=f1, bit1=f2)
fn d2_obs(w:[]u8)i64 {
  let t:i64=p_get(w,0);let plen:i64=p_get(w,2);let pb:i64=p_get(w,3);
  let idx:i64=t%plen;
  let f1:i64=p_get(w,(pb+2*idx) as i32);
  let f2:i64=p_get(w,(pb+2*idx+1) as i32);
  return f1 | (f2*2);
}
// Step: action 0..3. Returns reward. WAIT (3) gives 0.
fn d2_step(w:[]u8,a:i64)i64 {
  let t:i64=p_get(w,0);
  if(t>=p_get(w,1)){return 0;}
  let s:i64=d2_obs(w);  // 0..3
  let tb:i64=p_get(w,4);
  let r:i64=0;
  if(a>=0 && a<3){
    r=p_get(w,(tb+s*3+a) as i32);
  }
  p_put(w,5,p_get(w,5)+r);
  p_put(w,0,t+1);
  return r;
}
fn d2_result(w:[]u8,arm:[]u8,variant:[]u8,rerun:i64)void {
  _zag_print("RESULT ");
  _zag_print(arm);_zag_print(" ");
  _zag_print(variant);_zag_print(" ");
  _zag_print(i64s(rerun));_zag_print(" ");
  _zag_print(i64s(p_get(w,0)));_zag_print(" ");
  _zag_print(i64s(p_get(w,5)));
  _zag_print("\n");
}

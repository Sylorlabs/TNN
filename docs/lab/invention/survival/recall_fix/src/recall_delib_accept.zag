// recall_delib.zag — SHARED deliberative recall module (Experiment 1b, PREREG2).
//
// Generic mechanism: recalled heuristics enter deliberation as EVALUATED
// candidates, never reflexes. Ordered RECALL -> EVAL -> VERDICT.
//
// This file contains NO domain/scenario/regime branches. It operates on
// abstract heuristics: [cond_id, act, claimed, pre_mask, prio].
// Domain mains convert their KB to this form and supply:
//   - facts: i64 bitmask of current observations
//   - match(h, facts): does heuristic h's condition match?
//   - n_acts: number of primitive actions (for exploration)
// The engine tracks per-heuristic observed outcomes and distrusts heuristics
// whose observed mean falls below half their claimed value (after >=10 samples).
// Distrusted heuristics trigger deterministic exploration of alternative
// actions (numeric order, 5 samples each), then exploitation of the best observed.
//
// Trace protocol (emitted by the main via delib_trace):
//   RECALL <hid>    — heuristic recalled (condition matched)
//   EVAL <hid> <score> — candidate evaluated (score = claimed or observed mean)
//   VERDICT <act>   — final action selected
// These appear in RECALL -> EVAL -> VERDICT order per decision.
//
// Requires: common.zag (p_put/p_get, z_alloc).
// No RNG. Deterministic.

// Heuristic field offsets (each heuristic is 8 i64 slots)
fn DH_COND()i64{return 0;}
fn DH_ACT()i64{return 1;}
fn DH_CLAIMED()i64{return 2;}
fn DH_PRE()i64{return 3;}
fn DH_PRIO()i64{return 4;}

// Engine state offsets (per heuristic: 8 slots)
//   0 n_h (times h's action taken)
//   1 sum_h (sum of rewards)
//   2 distrusted (0/1)
//   3+ : exploration table (n_acts * 2 slots: n_ha, sum_ha per action)
fn delib_state_size(nh:i32,n_acts:i32)i64 {
  return (nh as i64)*(4+ (n_acts as i64)*2);
}
fn delib_hbase(hi:i32,n_acts:i32)i64 {
  return (hi as i64)*(4+ (n_acts as i64)*2);
}
// Initialize engine state (zeroed).
fn delib_init(st:[]u8,nh:i32,n_acts:i32)void {
  let n:i64=delib_state_size(nh,n_acts);
  let i:i64=0;
  while(i<n){p_put(st,(i as i32),0);i=i+1;}
}
// Mark heuristic as distrusted if warranted. Returns 1 if distrusted.
// D_accept version: evaluator forced to always-accept (never distrust).
fn delib_check_distrust(st:[]u8,hi:i32,n_acts:i32,claimed:i64)i64 {
  return 0;
}
// Score for (heuristic hi, action a).
// If a == heurs[hi].act: claimed (if n<10) else observed mean.
// If a != heurs[hi].act: observed mean (if n_ha>=5) else VERY_LOW.
fn delib_score(st:[]u8,heurs:[]u8,hi:i32,a:i64,n_acts:i32)i64 {
  let b:i64=delib_hbase(hi,n_acts);
  let hact:i64=p_get(heurs,hi*8+1);
  let claimed:i64=p_get(heurs,hi*8+2);
  if(a==hact){
    let n:i64=p_get(st,(b as i32));
    if(n<10){return claimed;}
    return p_get(st,(b+1) as i32)/n;
  }else{
    let ab:i64=b+4+a*2;
    let na:i64=p_get(st,(ab as i32));
    if(na>=5){return p_get(st,(ab+1) as i32)/na;}
    return -999999999;
  }
}
// Update after executing action a for heuristic hi with reward r.
fn delib_update(st:[]u8,hi:i32,a:i64,r:i64,n_acts:i32,heurs:[]u8)void {
  let b:i64=delib_hbase(hi,n_acts);
  let hact:i64=p_get(heurs,hi*8+1);
  if(a==hact){
    p_put(st,(b as i32),p_get(st,(b as i32))+1);
    p_put(st,(b+1) as i32,p_get(st,(b+1) as i32)+r);
  }else{
    let ab:i64=b+4+a*2;
    p_put(st,(ab as i32),p_get(st,(ab as i32))+1);
    p_put(st,(ab+1) as i32,p_get(st,(ab+1) as i32)+r);
  }
}
// Select action for heuristic hi.
// Returns action. Sets *exploring=1 if in exploration phase.
fn delib_select(st:[]u8,heurs:[]u8,hi:i32,n_acts:i32,exploring:*i32)i64 {
  let b:i64=delib_hbase(hi,n_acts);
  let hact:i64=p_get(heurs,hi*8+1);
  let claimed:i64=p_get(heurs,hi*8+2);
  // Check distrust
  let dis:i64=delib_check_distrust(st,hi,n_acts,claimed);
  if(dis==0){
    exploring.*=0;
    return hact;
  }
  // Distrusted: explore alternatives in numeric order (5 samples each)
  exploring.*=1;
  let a:i64=0;
  while(a<n_acts){
    if(a!=hact){
      let ab:i64=b+4+a*2;
      if(p_get(st,(ab as i32))<5){
        return a;
      }
    }
    a=a+1;
  }
  // All explored: pick best observed (including h's action)
  let best:i64=hact;
  let bests:i64=delib_score(st,heurs,hi,hact,n_acts);
  a=0;
  while(a<n_acts){
    let s:i64=delib_score(st,heurs,hi,a,n_acts);
    if(s>bests){bests=s;best=a;}
    a=a+1;
  }
  return best;
}

@import("world_d1.zag")
// C3 calibration: scripted BEACON-homesteader (strategy 2 of 3 for gate C3).
//   1. Take 1 crystal + 1 mote -> COMBINE -> LAMP.
//   2. Take another crystal -> COMBINE (LAMP+crystal) -> BEACON.
//   3. DROP the BEACON at cell 8 as a home base (shelter: 0 basal, storm-immune).
//   4. Central-place foraging: hungry -> hunt motes; satiated -> return home
//      and rest for free; storms -> shelter at home.
// Qualitatively distinct from ward-turtle (never eats after setup) and from
// the nomadic mobile forager (never returns to a base).
// argv: 1=variant_path 2=variant_name 3=rerun
fn move_toward(pos:i64,tgt:i64)i64 {
  if(tgt<pos){return 0;}
  if(tgt>pos){return 1;}
  return 6;
}
fn main()i32 {
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let va:i64=p_get(w,6);
  let phase:i64=0;
  let home:i64=8;
  let trace:[]u8=z_alloc(600);let nt:i32=0;
  while(p_get(w,0)<600 && p_get(w,4)==1){
    let pos:i64=p_get(w,1);let e:i64=p_get(w,2);
    let a:i64=6;
    if(phase<5){
      // ---- build phase: crystal + mote -> LAMP, + crystal -> BEACON ----
      if(storm_threat(w,20)==1 && in_zone(w,pos)==1){
        if(pos<=11){a=0;}else{a=1;}
      }
      else if(e<50 && mote_at(w,pos)>=0){a=2;}
      else if(phase==0){
        if(has_item(w,0)==1){phase=1;}
        else {
          let bc:i64=-1;let bd:i64=999;let k:i32=0;
          while(k<4){
            let cc:i64=p_get(w,60+k);
            if(p_get(w,64+k)==0 && cc<va){
              let d:i64=cc-pos;if(d<0){d=0-d;}
              if(d<bd){bd=d;bc=cc;}
            }
            k=k+1;
          }
          if(bc<0){phase=9;}
          else if(bc==pos){a=3;}
          else {a=move_toward(pos,bc);}
        }
      }
      else if(phase==1){
        if(has_item(w,1)==1){phase=2;}
        else {
          let m:i64=nearest_mote(w,pos,23);
          if(m<0){phase=9;}
          else {
            let mp:i64=p_get(w,20+(m as i32)*4);
            if(mp==pos){a=3;}
            else {a=move_toward(pos,mp);}
          }
        }
      }
      else if(phase==2){
        if(has_item(w,2)==1){phase=3;}
        else {a=5;}
      }
      else if(phase==3){
        if(item_slot(w,0)>=0){phase=4;}
        else {
          let bc:i64=-1;let bd:i64=999;let k:i32=0;
          while(k<4){
            let cc:i64=p_get(w,60+k);
            if(p_get(w,64+k)==0 && cc<va){
              let d:i64=cc-pos;if(d<0){d=0-d;}
              if(d<bd){bd=d;bc=cc;}
            }
            k=k+1;
          }
          if(bc<0){phase=9;}
          else if(bc==pos){a=3;}
          else {a=move_toward(pos,bc);}
        }
      }
      else if(phase==4){
        if(has_item(w,6)==1){
          if(pos==home){a=4;phase=5;}
          else {a=move_toward(pos,home);}
        }
        else {a=5;}
      }
    }
    else {
      // ---- homestead phase ----
      if(storm_threat(w,20)==1 && in_zone(w,pos)==1 && pos!=home){
        a=move_toward(pos,home);
      }
      else if(mote_at(w,pos)>=0 && e<170){a=2;}
      else if(e<50){
        let m:i64=nearest_mote(w,pos,23);
        if(m>=0){
          let mp:i64=p_get(w,20+(m as i32)*4);
          a=move_toward(pos,mp);
        }
        else {a=6;}
      }
      else if(pos!=home){a=move_toward(pos,home);}
      else {a=6;}
    }
    trace[nt]=(a+48) as u8;nt=nt+1;
    step(w,a);
  }
  emit_result(w,"cal_beacon",_zag_arg(2),parse_i64(_zag_arg(3)),trace,nt);
  z_free(trace);z_free(w);
  return 0;
}

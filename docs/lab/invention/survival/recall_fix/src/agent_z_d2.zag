@import("world_d2.zag")
// Arm Z (random baseline) for D2. Fixed-seed LCG: state=(state*1103515245+12345)&0x7fffffff,
// seed=888000+variant_seq. action=state%4. argv: 1=variant_path 2=variant_name 3=rerun 4=variant_seq
fn main()i32 {
  let w:[]u8=z_alloc(64*8);
  if(d2_init(w,_zag_arg(1))!=0){return 1;}
  let st:i64=888000+parse_i64(_zag_arg(4));
  while(p_get(w,0)<p_get(w,1)){
    st=((st*1103515245+12345) & 0x7fffffff);
    d2_step(w,st%4);
  }
  d2_result(w,"z",_zag_arg(2),parse_i64(_zag_arg(3)));
  z_free(w);
  return 0;
}

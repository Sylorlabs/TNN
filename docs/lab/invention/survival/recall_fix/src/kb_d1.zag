// kb_d1.zag — D1 (TIDELOCK v2) KB codebook: symbolic->numeric mapping,
// condition matcher, and pseudo-action resolver.
// Requires common.zag + kb_parse.zag (import first or transitively).
// Imported by agent_r_d1.zag and (Phase 2) agent_d_d1.zag.
//
// COND codes: 1 C_STORM_THREAT_IN_ZONE | 2 C_ON_MOTE | 3 C_ON_MOTE_RICH |
//             4 C_E_LOW_MOTE_NEAR | 5 C_ON_CRYSTAL | 6 C_TWO_ITEMS_SAFE
// ACT codes: 11 A_FLEE_ZONE (pseudo) | 12 A_MOVE_TO_MOTE (pseudo) |
//            2 A_EAT | 3 A_TAKE | 5 A_COMBINE | 6 A_WAIT
// Fact bits (must match world_d1.zag d1_obs):
//   1 F_E_LT_40 | 2 F_MOTE_NEAR | 4 F_STORM_THREAT | 8 F_IN_ZONE | 16 F_TWO_ITEMS |
//   32 F_SAFE | 64 F_ON_MOTE | 128 F_ON_CRYSTAL | 256 F_SPACE | 512 F_E_GT_120 |
//   1024 F_E_GE_50 | 2048 F_E_LT_150
fn kb_d1_cond(s:[]u8)i64 {
  if(streq(s,"C_STORM_THREAT_IN_ZONE")==1){return 1;}
  if(streq(s,"C_ON_MOTE")==1){return 2;}
  if(streq(s,"C_ON_MOTE_RICH")==1){return 3;}
  if(streq(s,"C_E_LOW_MOTE_NEAR")==1){return 4;}
  if(streq(s,"C_ON_CRYSTAL")==1){return 5;}
  if(streq(s,"C_TWO_ITEMS_SAFE")==1){return 6;}
  return -1;
}
fn kb_d1_act(s:[]u8)i64 {
  if(streq(s,"A_FLEE_ZONE")==1){return 11;}
  if(streq(s,"A_MOVE_TO_MOTE")==1){return 12;}
  if(streq(s,"A_EAT")==1){return 2;}
  if(streq(s,"A_TAKE")==1){return 3;}
  if(streq(s,"A_COMBINE")==1){return 5;}
  if(streq(s,"A_WAIT")==1){return 6;}
  return -1;
}
fn kb_d1_fact(s:[]u8)i64 {
  if(streq(s,"F_E_LT_40")==1){return 1;}
  if(streq(s,"F_MOTE_NEAR")==1){return 2;}
  if(streq(s,"F_STORM_THREAT")==1){return 4;}
  if(streq(s,"F_IN_ZONE")==1){return 8;}
  if(streq(s,"F_TWO_ITEMS")==1){return 16;}
  if(streq(s,"F_SAFE")==1){return 32;}
  if(streq(s,"F_ON_MOTE")==1){return 64;}
  if(streq(s,"F_ON_CRYSTAL")==1){return 128;}
  if(streq(s,"F_SPACE")==1){return 256;}
  if(streq(s,"F_E_GT_120")==1){return 512;}
  if(streq(s,"F_E_GE_50")==1){return 1024;}
  if(streq(s,"F_E_LT_150")==1){return 2048;}
  return 0;
}
// PRE field: comma-separated facts or NONE -> bitmask
fn kb_d1_pre(s:[]u8)i64 {
  if(streq(s,"NONE")==1){return 0;}
  let m:i64=0;let i:i32=0;let n:i32=s.len;
  while(i<n){
    let j:i32=i;
    while(j<n && s[j]!=44){j=j+1;}
    m=m | kb_d1_fact(s[i..j]);
    i=j+1;
  }
  return m;
}
// Load KB into caller arenas. Returns heuristic count (or -1 on error).
// hids: []u8 of nh*16 bytes; others: []u8 arenas of nh i64 slots.
fn kb_d1_load(path:[]u8,nh:i32,hids:[]u8,conds:[]u8,acts:[]u8,claims:[]u8,pres:[]u8,prios:[]u8)i64 {
  let n:i64=kb_count(path);
  if(n<0 || n> (nh as i64)){return -1;}
  let fld:[]u8=z_alloc(7*16);
  let i:i64=0;
  while(i<n){
    if(kb_get(path,i,fld)==0){z_free(fld);return -1;}
    let hid:[]u8=kb_slice(kb_field_ptr(fld,1),kb_field_len(fld,1));
    let ii:i32=(i as i32);
    let q:i32=0;
    while(q<16){if(q<hid.len){hids[ii*16+q]=hid[q];}else{hids[ii*16+q]=0;}q=q+1;}
    p_put(conds,ii,kb_d1_cond(kb_slice(kb_field_ptr(fld,2),kb_field_len(fld,2))));
    p_put(acts,ii,kb_d1_act(kb_slice(kb_field_ptr(fld,3),kb_field_len(fld,3))));
    p_put(claims,ii,parse_i64(kb_slice(kb_field_ptr(fld,4),kb_field_len(fld,4))));
    p_put(pres,ii,kb_d1_pre(kb_slice(kb_field_ptr(fld,5),kb_field_len(fld,5))));
    p_put(prios,ii,parse_i64(kb_slice(kb_field_ptr(fld,6),kb_field_len(fld,6))));
    i=i+1;
  }
  z_free(fld);
  return n;
}
// Condition matcher: does heuristic cond hold in world w? (1/0)
fn kb_d1_match(w:[]u8,cond:i64)i64 {
  let pos:i64=p_get(w,1);let e:i64=p_get(w,2);
  if(cond==1){
    if(storm_threat(w,20)==1 && in_zone(w,pos)==1){return 1;}
    return 0;
  }
  if(cond==2){
    if(mote_at(w,pos)>=0){return 1;}
    return 0;
  }
  if(cond==3){
    if(mote_at(w,pos)>=0 && e>120 && inv_count(w)<4){return 1;}
    return 0;
  }
  if(cond==4){
    if(e<40 && nearest_mote(w,pos,3)>=0){return 1;}
    return 0;
  }
  if(cond==5){
    if(crystal_at(w,pos)>=0 && inv_count(w)<4){return 1;}
    return 0;
  }
  if(cond==6){
    if(inv_count(w)>=2 && storm_threat(w,20)==0 && e>=50){return 1;}
    return 0;
  }
  return 0;
}
// Resolve pseudo-actions to primitives (LEFT/RIGHT). Others pass through.
fn kb_d1_resolve(w:[]u8,act:i64)i64 {
  let pos:i64=p_get(w,1);
  if(act==11){
    // FLEE_ZONE: toward nearest safe edge
    if(pos<=11){return 0;}
    return 1;
  }
  if(act==12){
    // MOVE_TO_MOTE: step toward nearest mote within 3
    let m:i64=nearest_mote(w,pos,3);
    if(m>=0){
      let mp:i64=p_get(w,20+(m as i32)*4);
      if(mp<pos){return 0;}
      if(mp>pos){return 1;}
    }
    return 6;
  }
  return act;
}

@import("world_d2.zag")
// Arm P (positive control) for D2: reads the variant's reward table and always
// picks the argmax action (ties -> lowest action). Optimal by construction in
// every regime. argv: 1=variant_path 2=variant_name 3=rerun
fn main()i32 {
  let w:[]u8=z_alloc(64*8);
  if(d2_init(w,_zag_arg(1))!=0){return 1;}
  let tb:i64=p_get(w,4);
  while(p_get(w,0)<p_get(w,1)){
    let s:i64=d2_obs(w);
    let best:i64=3;let bestr:i64=0;let a:i64=0;
    while(a<3){
      let r:i64=p_get(w,(tb+s*3+a) as i32);
      if(a==0 || r>bestr){bestr=r;best=a;}
      a=a+1;
    }
    d2_step(w,best);
  }
  d2_result(w,"p",_zag_arg(2),parse_i64(_zag_arg(3)));
  z_free(w);
  return 0;
}

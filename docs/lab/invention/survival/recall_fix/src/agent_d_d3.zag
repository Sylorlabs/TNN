@import("world_d3.zag")
@import("kb_parse.zag")
@import("kb_d3.zag")
@import("recall_delib.zag")
// Arm D (deliberative) for D3. Uses shared recall_delib.zag.
// argv: 1=variant_path 2=variant_name 3=rerun 4=kb_path
fn print_hid(hids:[]u8,hi:i32)void {
  let q:i32=0;
  while(q<16 && hids[hi*16+q]!=0){q=q+1;}
  if(q==0){_zag_print("?");return;}
  let buf:[]u8=z_alloc((q as i64));
  let r:i32=0;
  while(r<q){buf[r]=hids[hi*16+r];r=r+1;}
  _zag_print(buf);
  z_free(buf);
}
fn main()i32 {
  let w:[]u8=z_alloc(64*8);
  if(d3_init(w,_zag_arg(1))!=0){return 1;}
  let nh:i32=8;
  let hids:[]u8=z_alloc(nh*16);
  let conds:[]u8=z_alloc(nh*8);let acts:[]u8=z_alloc(nh*8);
  let claims:[]u8=z_alloc(nh*8);let pres:[]u8=z_alloc(nh*8);let prios:[]u8=z_alloc(nh*8);
  let n:i64=kb_d3_load(_zag_arg(4),nh,hids,conds,acts,claims,pres,prios);
  if(n<0){return 2;}
  let heurs:[]u8=z_alloc(nh*8*8);
  let i:i64=0;
  while(i<n){
    let ii:i32=(i as i32);
    p_put(heurs,ii*8+0,p_get(conds,ii));
    p_put(heurs,ii*8+1,p_get(acts,ii));
    p_put(heurs,ii*8+2,p_get(claims,ii));
    p_put(heurs,ii*8+3,p_get(pres,ii));
    p_put(heurs,ii*8+4,p_get(prios,ii));
    i=i+1;
  }
  let n_acts:i32=4; // TOOL_0..TOOL_3
  let st:[]u8=z_alloc(delib_state_size((n as i32),n_acts)*8);
  delib_init(st,(n as i32),n_acts);
  while(p_get(w,0)<p_get(w,1)){
    let t:i64=d3_task(w);
    // RECALL
    let hi:i32=-1;let j:i64=0;
    while(j<n){
      if(kb_d3_match(t,p_get(heurs,(j as i32)*8+0))==1){
        hi=(j as i32);
        j=n;
      }
      j=j+1;
    }
    if(hi<0){hi=0;}
    _zag_print("RECALL ");
    print_hid(hids,hi);
    _zag_print("\n");
    // EVAL + VERDICT
    let exploring:i32=0;
    let act:i64=delib_select(st,heurs,hi,n_acts,&exploring);
    let score:i64=delib_score(st,heurs,hi,act,n_acts);
    _zag_print("EVAL ");
    print_hid(hids,hi);
    _zag_print(" ");
    _zag_print(i64s(score));
    _zag_print("\n");
    _zag_print("VERDICT ");
    _zag_print(i64s(act));
    _zag_print("\n");
    let r:i64=d3_step(w,act);
    delib_update(st,hi,act,r,n_acts,heurs);
  }
  d3_result(w,"d",_zag_arg(2),parse_i64(_zag_arg(3)));
  z_free(w);z_free(hids);z_free(conds);z_free(acts);z_free(claims);z_free(pres);z_free(prios);
  z_free(heurs);z_free(st);
  return 0;
}

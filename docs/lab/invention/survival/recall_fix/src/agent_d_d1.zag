@import("world_d1.zag")
@import("kb_parse.zag")
@import("kb_d1.zag")
// Arm D (deliberative) for D1. RECALL->EVAL->VERDICT.
// Selects highest-priority matching heuristic whose PRE is satisfied;
// falls back to first matching (like R) if none satisfy PRE.
// argv: 1=variant_path 2=variant_name 3=rerun 4=kb_path
fn print_hid(hids:[]u8,hi:i32)void {
  let q:i32=0;
  while(q<16 && hids[hi*16+q]!=0){q=q+1;}
  if(q==0){_zag_print("?");return;}
  let buf:[]u8=z_alloc((q as i64));
  let r:i32=0;
  while(r<q){buf[r]=hids[hi*16+r];r=r+1;}
  _zag_print(buf);
  z_free(buf);
}
fn main()i32 {
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let nh:i32=16;
  let hids:[]u8=z_alloc(nh*16);
  let conds:[]u8=z_alloc(nh*8);let acts:[]u8=z_alloc(nh*8);
  let claims:[]u8=z_alloc(nh*8);let pres:[]u8=z_alloc(nh*8);let prios:[]u8=z_alloc(nh*8);
  let n:i64=kb_d1_load(_zag_arg(4),nh,hids,conds,acts,claims,pres,prios);
  if(n<0){return 2;}
  let trace:[]u8=z_alloc(600);let nt:i32=0;
  while(p_get(w,0)<600 && p_get(w,4)==1){
    let facts:i64=d1_obs(w);
    // RECALL + EVAL: find best (PRE-satisfied) and fallback (first matching)
    let best:i32=-1;let bestp:i64=999999;
    let fb:i32=-1;
    let i:i64=0;
    while(i<n){
      let ii:i32=(i as i32);
      if(kb_d1_match(w,p_get(conds,ii))==1){
        _zag_print("RECALL ");
        print_hid(hids,ii);
        _zag_print("\n");
        if(fb<0){fb=ii;}
        let pre:i64=p_get(pres,ii);
        let prio:i64=p_get(prios,ii);
        if((facts & pre)==pre && prio<bestp){bestp=prio;best=ii;}
      }
      i=i+1;
    }
    let hi:i32=best;
    if(hi<0){hi=fb;}
    if(hi<0){hi=0;}
    // EVAL
    _zag_print("EVAL ");
    print_hid(hids,hi);
    _zag_print(" ");
    _zag_print(i64s(p_get(claims,hi)));
    _zag_print("\n");
    // VERDICT
    let a:i64=kb_d1_resolve(w,p_get(acts,hi));
    _zag_print("VERDICT ");
    _zag_print(i64s(a));
    _zag_print("\n");
    trace[nt]=(a+48) as u8;nt=nt+1;
    step(w,a);
  }
  emit_result(w,"d",_zag_arg(2),parse_i64(_zag_arg(3)),trace,nt);
  z_free(trace);z_free(w);z_free(hids);z_free(conds);z_free(acts);
  z_free(claims);z_free(pres);z_free(prios);
  return 0;
}

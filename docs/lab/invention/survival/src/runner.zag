// runner.zag -- Experiment 1 run harness.
// Modes (argv[1]): "run" (default): 60 runs + TSV + traces + plan logs +
// medians + kill-bar checks + A2 ablation, all printed to stdout.
// "variants": print the 12 frozen variant parameter files.
// "calibrate": scripted-strategy check for calibration gate C3.
// All analysis is done in Zag; the shell only redirects stdout and hashes.
// Memory: exactly ONE []i32, ONE []u8, ONE []i64 arena per execution,
// partitioned by offsets (znc multi-slice workaround, verified 2026-09-27).

@import("world.zag")
@import("variants.zag")
@import("lcg.zag")
@import("agent_p.zag")
@import("agent_z.zag")
@import("agent_r.zag")
@import("agent_i.zag")

// i32 arena layout (512)
const X_WBASE:i32 = 0;
const X_VBASE:i32 = 196;
const X_RBASE:i32 = 242;
const X_NBASE:i32 = 422;
// u8 arena layout (40096)
const X_TBASE:i32 = 0;
const X_PBUF:i32 = 36000;
const X_PCAP:i32 = 4096;
// i64 arena layout (10000)
const X_SCRATCH:i32 = 0;
const X_LOGBASE:i32 = 3600;

struct Ctx {
    b8:[]u8,
    i32a:[]i32,
    i64a:[]i64,
}

struct Buf {
    arena:[]u8,
    base:i32,
    pos:i32,
    cap:i32,
}

fn o_new(arena:[]u8, base:i32, cap:i32)Buf {
    return Buf{.arena=arena, .base=base, .pos=0, .cap=cap};
}

fn o_str(b:*Buf, s:[]u8)i32 {
    let i:i32 = 0;
    while (i < s.len) {
        if (b.pos < b.cap) { b.arena[b.base+b.pos] = s[i]; b.pos = b.pos+1; }
        i = i+1;
    }
    return 0;
}

fn o_ch(b:*Buf, c:u8)i32 {
    if (b.pos < b.cap) { b.arena[b.base+b.pos] = c; b.pos = b.pos+1; }
    return 0;
}

fn o_i32(b:*Buf, v:i32)i32 {
    let x:i32 = v;
    if (x < 0) { o_ch(b, 45); x = 0 - x; }
    if (x == 0) { o_ch(b, 48); return 0; }
    let tmp:*u8 = _zag_malloc(16);
    let t:[]u8 = tmp[0..16];
    let n:i32 = 0;
    while (x > 0) { t[15-n] = (48 + x%10) as u8; x = x/10; n = n+1; }
    let j:i32 = 0;
    while (j < n) { o_ch(b, t[16-n+j]); j = j+1; }
    return 0;
}

fn o_tab(b:*Buf)i32 { return o_ch(b, 9); }

fn o_nl(b:*Buf)i32 {
    let t:*u8 = _zag_malloc(b.pos);
    let ts:[]u8 = t[0..b.pos];
    let i:i32 = 0;
    while (i < b.pos) { ts[i] = b.arena[b.base+i]; i = i+1; }
    _zag_println(ts);
    b.pos = 0;
    return 0;
}

fn o_arm_name(b:*Buf, arm:i32)i32 {
    if (arm == 0) { o_str(b, "P"); }
    if (arm == 1) { o_str(b, "Z"); }
    if (arm == 2) { o_str(b, "R"); }
    if (arm == 3) { o_str(b, "I-survive"); }
    if (arm == 4) { o_str(b, "I-invent"); }
    return 0;
}

struct RunRes {
    ticks:i32,
    cause:i32,
    e_end:i32,
}

fn act_char(a:i32)u8 {
    if (a == A_LEFT) { return 76; }
    if (a == A_RIGHT) { return 82; }
    if (a == A_EAT) { return 69; }
    if (a == A_TAKE) { return 84; }
    if (a == A_DROP) { return 68; }
    if (a == A_COMBINE) { return 67; }
    return 87;
}

fn run_one(ctx:*Ctx, v:i32, arm:i32, tslot:i32, lslot:i32)RunRes {
    let w:World = w_new(ctx.i32a, X_WBASE);
    let vp:VParams = VParams{.mem=ctx.i32a, .base=X_VBASE, .void0=0, .void1=0, .start=0, .home=0};
    let vf:i32 = v_fill(v, &vp);
    let va:i32 = v_apply(&w, &vp);
    let tbase:i32 = X_TBASE + tslot*600;
    let t:i32 = 0;
    if (arm == 0) {
        let st:PState = p_new(&w);
        while (w.alive == 1 && w.tick < W_T) {
            let a:i32 = p_act(&w, &st);
            ctx.b8[tbase+t] = act_char(a); t = t+1;
            w_step(&w, a, st.ca, st.cb);
        }
    }
    if (arm == 1) {
        let st:ZState = z_new(v);
        while (w.alive == 1 && w.tick < W_T) {
            let a:i32 = z_act(&w, &st);
            ctx.b8[tbase+t] = act_char(a); t = t+1;
            w_step(&w, a, 0, 1);
        }
    }
    if (arm == 2) {
        while (w.alive == 1 && w.tick < W_T) {
            let a:i32 = r_act(&w);
            ctx.b8[tbase+t] = act_char(a); t = t+1;
            w_step(&w, a, 0, 1);
        }
    }
    if (arm == 3) {
        let st:IState = i_new(ctx.i64a, X_SCRATCH, X_LOGBASE+lslot*256, 40, 25);
        while (w.alive == 1 && w.tick < W_T) {
            let a:i32 = i_act(&w, &st);
            ctx.b8[tbase+t] = act_char(a); t = t+1;
            let ca:i32 = 0;
            let cb:i32 = 1;
            if (w.inv_n >= 2) { ca = w.inv_n - 2; cb = w.inv_n - 1; }
            w_step(&w, a, ca, cb);
        }
        i_settle(&w, &st);
        ctx.i32a[X_NBASE+lslot] = st.nlog;
    }
    if (arm == 4) {
        let st:IState = i_new(ctx.i64a, X_SCRATCH, X_LOGBASE+lslot*256, 80, 40);
        while (w.alive == 1 && w.tick < W_T) {
            let a:i32 = i_act(&w, &st);
            ctx.b8[tbase+t] = act_char(a); t = t+1;
            let ca:i32 = 0;
            let cb:i32 = 1;
            if (w.inv_n >= 2) { ca = w.inv_n - 2; cb = w.inv_n - 1; }
            w_step(&w, a, ca, cb);
        }
        i_settle(&w, &st);
        ctx.i32a[X_NBASE+lslot] = st.nlog;
    }
    while (t < W_T) { ctx.b8[tbase+t] = 46; t = t+1; }
    return RunRes{.ticks=w.tick, .cause=w.cause, .e_end=w.energy};
}

// ---------- scripted calibration strategies (C3) ----------

struct CalState {
    phase:i32,
    ca:i32,
    cb:i32,
    lamp_cell:i32,
}

fn cal_has(w:*World, item:i32)i32 {
    let i:i32 = 0;
    while (i < w.inv_n) {
        if (w.mem[w.base+O_INV+i] == item) { return 1; }
        i = i+1;
    }
    return 0;
}

fn cal_find(w:*World, item:i32)i32 {
    let i:i32 = 0;
    while (i < w.inv_n) {
        if (w.mem[w.base+O_INV+i] == item) { return i; }
        i = i+1;
    }
    return -1;
}

fn cal_goto_take_crystal(w:*World)i32 {
    let c:i32 = w_nearest_crystal(w);
    if (c < 0) { return A_WAIT; }
    if (w.apos == c) { return A_TAKE; }
    return w_step_toward(w, c);
}

fn cal_goto_take_mote(w:*World)i32 {
    let m:i32 = w_nearest_mote(w);
    if (m < 0) { return A_WAIT; }
    if (w.apos == w.mem[w.base+O_MPOS+m]) { return A_TAKE; }
    return w_step_toward(w, w.mem[w.base+O_MPOS+m]);
}

fn cal_lamp_act(w:*World, cs:*CalState)i32 {
    if (cs.phase == 0) {
        if (cal_has(w, IT_CRYSTAL) == 1) { cs.phase = 1; }
        else { return cal_goto_take_crystal(w); }
    }
    if (cs.phase == 1) {
        if (cal_has(w, IT_MOTE) == 1) {
            cs.ca = cal_find(w, IT_CRYSTAL);
            cs.cb = cal_find(w, IT_MOTE);
            cs.phase = 2;
            return A_COMBINE;
        }
        return cal_goto_take_mote(w);
    }
    if (cs.phase == 2) { cs.phase = 3; }
    if (cs.phase == 3) {
        cs.lamp_cell = w.apos;
        cs.phase = 4;
        return A_DROP;
    }
    if (w_storm_active(w) == 1 || w_storm_within(w, 20) == 1) {
        if (w_in_zone(w) == 1 && w_sheltered(w) == 0) { return w_reflex_storm(w); }
    }
    if (w.energy < 25) { return w_reflex_emergency(w); }
    if (w_mote_on_cell(w) == 1) { return A_EAT; }
    let m:i32 = w_nearest_mote(w);
    if (m >= 0) { return w_step_toward(w, w.mem[w.base+O_MPOS+m]); }
    let d:i32 = w.apos - cs.lamp_cell;
    if (d < 0) { d = 0 - d; }
    if (d > 3) { return w_step_toward(w, cs.lamp_cell); }
    return A_WAIT;
}

fn cal_plank_act(w:*World, cs:*CalState)i32 {
    if (cs.phase == 0) {
        if (cal_has(w, IT_CRYSTAL) == 1) { cs.phase = 1; }
        else { return cal_goto_take_crystal(w); }
    }
    if (cs.phase == 1) {
        if (cal_has(w, IT_MOTE) == 1) {
            cs.ca = cal_find(w, IT_CRYSTAL);
            cs.cb = cal_find(w, IT_MOTE);
            cs.phase = 2;
            return A_COMBINE;
        }
        return cal_goto_take_mote(w);
    }
    if (cs.phase == 2) {
        if (cal_has(w, IT_LAMP) == 1 && cal_has(w, IT_CRYSTAL) == 1) {
            cs.ca = cal_find(w, IT_LAMP);
            cs.cb = cal_find(w, IT_CRYSTAL);
            cs.phase = 3;
            return A_COMBINE;
        }
        if (cal_has(w, IT_LAMP) == 0) { cs.phase = 0; return A_WAIT; }
        return cal_goto_take_crystal(w);
    }
    if (cs.phase == 3) {
        if (cal_has(w, IT_BEACON) == 1 && cal_has(w, IT_CRYSTAL) == 1) {
            cs.ca = cal_find(w, IT_BEACON);
            cs.cb = cal_find(w, IT_CRYSTAL);
            cs.phase = 4;
            return A_COMBINE;
        }
        if (cal_has(w, IT_BEACON) == 0) { cs.phase = 2; return A_WAIT; }
        return cal_goto_take_crystal(w);
    }
    if (cs.phase == 4) {
        if (cal_has(w, IT_PLANK) == 1) { cs.phase = 5; }
        else { cs.phase = 3; return A_WAIT; }
    }
    if (cs.phase == 5) {
        let c1:i32 = w.void0 - 1;
        let c2:i32 = w.void1 + 1;
        let tg:i32 = c1;
        if (c1 < 0) { tg = c2; }
        if (c2 < 24 && c1 >= 0) {
            let d1:i32 = w.apos - c1; if (d1 < 0) { d1 = 0 - d1; }
            let d2:i32 = w.apos - c2; if (d2 < 0) { d2 = 0 - d2; }
            if (d2 < d1) { tg = c2; }
        }
        if (w.apos == tg) { cs.phase = 6; return A_DROP; }
        if (w_storm_active(w) == 1 && w_in_zone(w) == 1 && w_sheltered(w) == 0) {
            return w_reflex_storm(w);
        }
        return w_step_toward(w, tg);
    }
    if (w_storm_active(w) == 1 || w_storm_within(w, 20) == 1) {
        if (w_in_zone(w) == 1 && w_sheltered(w) == 0) { return w_reflex_storm(w); }
    }
    if (w.energy < 25) { return w_reflex_emergency(w); }
    if (w_mote_on_cell(w) == 1) { return A_EAT; }
    let m:i32 = w_nearest_mote(w);
    if (m >= 0) { return w_step_toward(w, w.mem[w.base+O_MPOS+m]); }
    return A_WAIT;
}

fn cal_run(ctx:*Ctx, v:i32, strat:i32)RunRes {
    let w:World = w_new(ctx.i32a, X_WBASE);
    let vp:VParams = VParams{.mem=ctx.i32a, .base=X_VBASE, .void0=0, .void1=0, .start=0, .home=0};
    let vf:i32 = v_fill(v, &vp);
    let va:i32 = v_apply(&w, &vp);
    if (strat == 0) {
        while (w.alive == 1 && w.tick < W_T) {
            let a:i32 = r_act(&w);
            w_step(&w, a, 0, 1);
        }
    }
    if (strat == 1) {
        let st:PState = p_new(&w);
        while (w.alive == 1 && w.tick < W_T) {
            let a:i32 = p_act(&w, &st);
            w_step(&w, a, st.ca, st.cb);
        }
    }
    if (strat == 2) {
        let cs:CalState = CalState{.phase=0, .ca=0, .cb=1, .lamp_cell=0};
        while (w.alive == 1 && w.tick < W_T) {
            let a:i32 = cal_lamp_act(&w, &cs);
            w_step(&w, a, cs.ca, cs.cb);
        }
    }
    if (strat == 3) {
        let cs:CalState = CalState{.phase=0, .ca=0, .cb=1, .lamp_cell=0};
        while (w.alive == 1 && w.tick < W_T) {
            let a:i32 = cal_plank_act(&w, &cs);
            w_step(&w, a, cs.ca, cs.cb);
        }
    }
    return RunRes{.ticks=w.tick, .cause=w.cause, .e_end=w.energy};
}

// ---------- analysis helpers ----------

fn med12(vals:[]i32, base:i32)i32 {
    let a0:i32 = vals[base+0]; let a1:i32 = vals[base+1];
    let a2:i32 = vals[base+2]; let a3:i32 = vals[base+3];
    let a4:i32 = vals[base+4]; let a5:i32 = vals[base+5];
    let a6:i32 = vals[base+6]; let a7:i32 = vals[base+7];
    let a8:i32 = vals[base+8]; let a9:i32 = vals[base+9];
    let a10:i32 = vals[base+10]; let a11:i32 = vals[base+11];
    // 12-element sorting network via insertion into local vars is verbose;
    // use simple bubble pass on locals
    let t:i32 = 0;
    let p:i32 = 0;
    // pairwise bubble: repeat 12 passes
    let pass:i32 = 0;
    while (pass < 12) {
        if (a0 > a1) { t=a0; a0=a1; a1=t; }
        if (a1 > a2) { t=a1; a1=a2; a2=t; }
        if (a2 > a3) { t=a2; a2=a3; a3=t; }
        if (a3 > a4) { t=a3; a3=a4; a4=t; }
        if (a4 > a5) { t=a4; a4=a5; a5=t; }
        if (a5 > a6) { t=a5; a5=a6; a6=t; }
        if (a6 > a7) { t=a6; a6=a7; a7=t; }
        if (a7 > a8) { t=a7; a7=a8; a8=t; }
        if (a8 > a9) { t=a8; a8=a9; a9=t; }
        if (a9 > a10) { t=a9; a9=a10; a10=t; }
        if (a10 > a11) { t=a10; a10=a11; a11=t; }
        pass = pass + 1;
    }
    return (a5 + a6) / 2;
}

fn ch2act(c:u8)i32 {
    if (c == 76) { return A_LEFT; }
    if (c == 82) { return A_RIGHT; }
    if (c == 69) { return A_EAT; }
    if (c == 84) { return A_TAKE; }
    if (c == 68) { return A_DROP; }
    if (c == 67) { return A_COMBINE; }
    return A_WAIT;
}

struct AblRes {
    ticks:i32,
    replaced:i32,
}

fn ablate(ctx:*Ctx, v:i32, tslot:i32)AblRes {
    let w:World = w_new(ctx.i32a, X_WBASE);
    let vp:VParams = VParams{.mem=ctx.i32a, .base=X_VBASE, .void0=0, .void1=0, .start=0, .home=0};
    let vf:i32 = v_fill(v, &vp);
    let va:i32 = v_apply(&w, &vp);
    let tbase:i32 = X_TBASE + tslot*600;
    let replaced:i32 = 0;
    let t:i32 = 0;
    while (w.alive == 1 && w.tick < W_T && t < W_T) {
        let c:u8 = ctx.b8[tbase+t];
        if (c == 46) { break; }
        let a:i32 = ch2act(c);
        if (a == A_COMBINE || a == A_DROP) {
            replaced = replaced + 1;
            let ra:i32 = r_act(&w);
            w_step(&w, ra, 0, 1);
        } else {
            let ca:i32 = 0;
            let cb:i32 = 1;
            if (a == A_COMBINE && w.inv_n >= 2) { ca = w.inv_n - 2; cb = w.inv_n - 1; }
            w_step(&w, a, ca, cb);
        }
        t = t+1;
    }
    return AblRes{.ticks=w.tick, .replaced=replaced};
}

fn o_sketch(b:*Buf, code:i64)i32 {
    let len:i32 = (code / 262144) as i32;
    let rem:i64 = code % 262144;
    let k:i32 = 0;
    while (k < len) {
        let s:i32 = (rem % 8) as i32;
        rem = rem / 8;
        if (k > 0) { o_ch(b, 44); }
        if (s == 0) { o_str(b, "C"); }
        if (s == 1) { o_str(b, "D"); }
        if (s == 2) { o_str(b, "SC"); }
        if (s == 3) { o_str(b, "SME"); }
        if (s == 4) { o_str(b, "SMT"); }
        if (s == 5) { o_str(b, "SS"); }
        if (s == 6) { o_str(b, "SV"); }
        if (s == 7) { o_str(b, "W"); }
        k = k+1;
    }
    return 0;
}

// ---------- modes ----------

fn mode_variants(ctx:*Ctx)i32 {
    let b:Buf = o_new(ctx.b8, X_PBUF, X_PCAP);
    let vp:VParams = VParams{.mem=ctx.i32a, .base=X_VBASE, .void0=0, .void1=0, .start=0, .home=0};
    let v:i32 = 0;
    while (v < 12) {
        let vf:i32 = v_fill(v, &vp);
        let bb:i32 = vp.base;
        let m:[]i32 = vp.mem;
        o_str(&b, "=== VARIANT "); o_i32(&b, v); o_str(&b, " ==="); o_nl(&b);
        o_str(&b, "# TIDELOCK world variant "); o_i32(&b, v);
        o_str(&b, " (frozen 2026-09-27)"); o_nl(&b);
        o_str(&b, "variant "); o_i32(&b, v); o_nl(&b);
        o_str(&b, "void "); o_i32(&b, vp.void0); o_ch(&b, 32); o_i32(&b, vp.void1); o_nl(&b);
        o_str(&b, "start "); o_i32(&b, vp.start); o_nl(&b);
        o_str(&b, "home "); o_i32(&b, vp.home); o_nl(&b);
        o_str(&b, "crystals");
        let i:i32 = 0;
        while (i < 4) { o_ch(&b, 32); o_i32(&b, m[bb+V_CRYS+i]); i = i+1; }
        o_nl(&b);
        o_str(&b, "storms");
        i = 0;
        while (i < 3) {
            o_ch(&b, 32); o_i32(&b, m[bb+V_SS+i]);
            o_ch(&b, 32); o_i32(&b, m[bb+V_SE+i]);
            i = i+1;
        }
        o_nl(&b);
        o_str(&b, "motes 6"); o_nl(&b);
        i = 0;
        while (i < 6) {
            o_str(&b, "mote ");
            o_i32(&b, m[bb+V_MPOS+i]); o_ch(&b, 32);
            o_i32(&b, m[bb+V_MVEL+i]); o_ch(&b, 32);
            o_i32(&b, m[bb+V_MLO+i]); o_ch(&b, 32);
            o_i32(&b, m[bb+V_MHI+i]); o_ch(&b, 32);
            o_i32(&b, m[bb+V_MRESP+i]); o_ch(&b, 32);
            o_i32(&b, m[bb+V_MDEEP+i]); o_nl(&b);
            i = i+1;
        }
        v = v+1;
    }
    return 0;
}

fn o_strat_name(b:*Buf, s:i32)i32 {
    if (s == 0) { o_str(b, "forage"); }
    if (s == 1) { o_str(b, "ward-turtle"); }
    if (s == 2) { o_str(b, "lamp-farm"); }
    if (s == 3) { o_str(b, "void-cross"); }
    return 0;
}

fn mode_calibrate(ctx:*Ctx)i32 {
    let b:Buf = o_new(ctx.b8, X_PBUF, X_PCAP);
    o_str(&b, "strategy\tvariant\tticks\tcause\te_end"); o_nl(&b);
    let s:i32 = 0;
    while (s < 4) {
        let v:i32 = 0;
        while (v < 12) {
            let r:RunRes = cal_run(ctx, v, s);
            o_strat_name(&b, s); o_tab(&b);
            o_i32(&b, v); o_tab(&b);
            o_i32(&b, r.ticks); o_tab(&b);
            o_i32(&b, r.cause); o_tab(&b);
            o_i32(&b, r.e_end); o_nl(&b);
            v = v+1;
        }
        s = s+1;
    }
    return 0;
}

fn mode_run(ctx:*Ctx)i32 {
    let b:Buf = o_new(ctx.b8, X_PBUF, X_PCAP);
    let v:i32 = 0;
    while (v < 12) {
        let arm:i32 = 0;
        while (arm < 5) {
            let idx:i32 = v*5 + arm;
            let lslot:i32 = v*2 + (arm - 3);
            let rr:RunRes = run_one(ctx, v, arm, idx, lslot);
            ctx.i32a[X_RBASE+idx*3] = rr.ticks;
            ctx.i32a[X_RBASE+idx*3+1] = rr.cause;
            ctx.i32a[X_RBASE+idx*3+2] = rr.e_end;
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "TSV_BEGIN"); o_nl(&b);
    o_str(&b, "variant\tarm\tticks\tcause\te_end"); o_nl(&b);
    v = 0;
    while (v < 12) {
        let arm:i32 = 0;
        while (arm < 5) {
            let idx:i32 = v*5 + arm;
            o_i32(&b, v); o_tab(&b);
            o_arm_name(&b, arm); o_tab(&b);
            o_i32(&b, ctx.i32a[X_RBASE+idx*3]); o_tab(&b);
            o_i32(&b, ctx.i32a[X_RBASE+idx*3+1]); o_tab(&b);
            o_i32(&b, ctx.i32a[X_RBASE+idx*3+2]); o_nl(&b);
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "TSV_END"); o_nl(&b);
    o_str(&b, "TRACES_BEGIN"); o_nl(&b);
    v = 0;
    while (v < 12) {
        let arm:i32 = 0;
        while (arm < 5) {
            let idx:i32 = v*5 + arm;
            let tbase:i32 = X_TBASE + idx*600;
            o_i32(&b, v); o_tab(&b);
            o_arm_name(&b, arm); o_tab(&b);
            let t:i32 = 0;
            while (t < W_T) {
                let c:u8 = ctx.b8[tbase+t];
                if (c == 46) { break; }
                o_ch(&b, c);
                t = t+1;
            }
            o_nl(&b);
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "TRACES_END"); o_nl(&b);
    o_str(&b, "PLANS_BEGIN"); o_nl(&b);
    o_str(&b, "variant\tarm\ttick\tsketch"); o_nl(&b);
    v = 0;
    while (v < 12) {
        let arm:i32 = 3;
        while (arm < 5) {
            let lslot:i32 = v*2 + (arm - 3);
            let nl:i32 = ctx.i32a[X_NBASE+lslot];
            let lbase:i32 = X_LOGBASE + lslot*256;
            let j:i32 = 0;
            while (j < nl) {
                let e:i64 = ctx.i64a[lbase+j];
                let tk:i32 = (e >> 32) as i32;
                let code:i64 = e & 4294967295;
                o_i32(&b, v); o_tab(&b);
                o_arm_name(&b, arm); o_tab(&b);
                o_i32(&b, tk); o_tab(&b);
                o_sketch(&b, code); o_nl(&b);
                j = j+1;
            }
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "PLANS_END"); o_nl(&b);
    // medians per arm
    let m0:i32 = 0; let m1:i32 = 0; let m2:i32 = 0; let m3:i32 = 0; let m4:i32 = 0;
    let arm:i32 = 0;
    while (arm < 5) {
        let vvbase:i32 = 900;
        let i:i32 = 0;
        while (i < 12) {
            ctx.i32a[vvbase+i] = ctx.i32a[X_RBASE+(i*5+arm)*3];
            i = i+1;
        }
        let med:i32 = med12(ctx.i32a, vvbase);
        if (arm == 0) { m0 = med; }
        if (arm == 1) { m1 = med; }
        if (arm == 2) { m2 = med; }
        if (arm == 3) { m3 = med; }
        if (arm == 4) { m4 = med; }
        arm = arm+1;
    }
    o_str(&b, "MEDIANS_BEGIN"); o_nl(&b);
    o_str(&b, "P\t"); o_i32(&b, m0); o_nl(&b);
    o_str(&b, "Z\t"); o_i32(&b, m1); o_nl(&b);
    o_str(&b, "R\t"); o_i32(&b, m2); o_nl(&b);
    o_str(&b, "I-survive\t"); o_i32(&b, m3); o_nl(&b);
    o_str(&b, "I-invent\t"); o_i32(&b, m4); o_nl(&b);
    o_str(&b, "MEDIANS_END"); o_nl(&b);
    o_str(&b, "BARS_BEGIN"); o_nl(&b);
    o_str(&b, "C1 median_P="); o_i32(&b, m0);
    if (m0 >= 480) { o_str(&b, " PASS"); } else { o_str(&b, " FAIL(VOID)"); }
    o_nl(&b);
    o_str(&b, "C2 median_Z="); o_i32(&b, m1);
    if (m1 < 150) { o_str(&b, " PASS"); } else { o_str(&b, " FAIL"); }
    o_nl(&b);
    o_str(&b, "K1 median_I-survive="); o_i32(&b, m3);
    o_str(&b, " median_R="); o_i32(&b, m2);
    if (m3 <= m2) { o_str(&b, " verdict=KILL"); } else { o_str(&b, " verdict=PASS"); }
    o_nl(&b);
    o_str(&b, "K2 median_I-survive="); o_i32(&b, m3);
    o_str(&b, " median_Z="); o_i32(&b, m1);
    if (m3 <= m1) { o_str(&b, " verdict=KILL"); } else { o_str(&b, " verdict=PASS"); }
    o_nl(&b);
    o_str(&b, "K3 median_P="); o_i32(&b, m0);
    if (m0 < 480) { o_str(&b, " verdict=VOID"); } else { o_str(&b, " verdict=PASS"); }
    o_nl(&b);
    o_str(&b, "BARS_END"); o_nl(&b);
    o_str(&b, "ABLATION_BEGIN"); o_nl(&b);
    o_str(&b, "variant\tarm\torig_ticks\tr_ticks\tablated_ticks\treplaced\tdrop"); o_nl(&b);
    v = 0;
    while (v < 12) {
        let rticks:i32 = ctx.i32a[X_RBASE+(v*5+2)*3];
        arm = 3;
        while (arm < 5) {
            let idx:i32 = v*5 + arm;
            let iticks:i32 = ctx.i32a[X_RBASE+idx*3];
            if (iticks - rticks >= 60) {
                let ab:AblRes = ablate(ctx, v, idx);
                o_i32(&b, v); o_tab(&b);
                o_arm_name(&b, arm); o_tab(&b);
                o_i32(&b, iticks); o_tab(&b);
                o_i32(&b, rticks); o_tab(&b);
                o_i32(&b, ab.ticks); o_tab(&b);
                o_i32(&b, ab.replaced); o_tab(&b);
                o_i32(&b, iticks - ab.ticks); o_nl(&b);
            }
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "ABLATION_END"); o_nl(&b);
    o_str(&b, "META_BEGIN"); o_nl(&b);
    let ist:IState = i_new(ctx.i64a, X_SCRATCH, X_LOGBASE+24*256, 40, 25);
    o_str(&b, "ncand="); o_i32(&b, ist.ncand); o_nl(&b);
    o_str(&b, "META_END"); o_nl(&b);
    return 0;
}

fn main()i32 {
    let mi:*i32 = _zag_malloc(1024*4) as *i32;
    let ai:[]i32 = mi[0..1024];
    let mu:*u8 = _zag_malloc(40096);
    let au:[]u8 = mu[0..40096];
    let mg:*i64 = _zag_malloc(10000*8) as *i64;
    let ag:[]i64 = mg[0..10000];
    let ctx:Ctx = Ctx{.b8=au, .i32a=ai, .i64a=ag};
    // median scratch at 900..911 (12 i32, inside 1024 arena)
    if (_zag_argc() >= 2) {
        let m:[]u8 = _zag_arg(1);
        if (m.len == 8) {
            let isv:i32 = 1;
            if (m[0]!=118||m[1]!=97||m[2]!=114||m[3]!=105||m[4]!=97||m[5]!=110||m[6]!=116||m[7]!=115) { isv = 0; }
            if (isv == 1) { return mode_variants(&ctx); }
        }
        if (m.len == 9) {
            let isc:i32 = 1;
            if (m[0]!=99||m[1]!=97||m[2]!=108||m[3]!=105||m[4]!=98||m[5]!=114||m[6]!=97||m[7]!=116||m[8]!=101) { isc = 0; }
            if (isc == 1) { return mode_calibrate(&ctx); }
        }
    }
    return mode_run(&ctx);
}

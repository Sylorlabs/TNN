// agent_i.zag -- Arms I-survive and I-invent: compositional deliberation.
// Machinery (identical for both goals):
//  - candidate multi-step plans (<=6 schema invocations) composed from
//    the KB's single-step heuristic vocabulary (no new primitives),
//  - credit assignment: per-sketch mean delta-energy from executed trials,
//  - novelty bonus B0 for untried sketches (optimism under uncertainty),
//  - deterministic argmax with lowest-index tie-break (zero RNG),
//  - open-loop execution of the chosen plan with fixed interrupts:
//    storm-flee reflex and critical-energy reflex preempt the plan.
// The two arms differ ONLY in parameters: I-survive (B0=40, texplore=25),
// I-invent (B0=80, texplore=40).
// Memory: IState holds ONE []i64 arena (shared); candidate tables and the
// plan log are offset views. Works around the znc multi-slice bug.

@import("world.zag")

const I_NCAND:i32 = 1200;
const I_CAND:i32 = 0;
const I_CVAL:i32 = 1200;
const I_TRIED:i32 = 2400;
const I_SCRATCHN:i32 = 3600;
const I_LOGN:i32 = 256;

struct IState {
    mem:[]i64,
    base:i32,
    logbase:i32,
    B0:i32,
    texplore:i32,
    ncand:i32,
    nlog:i32,
    cur_sketch:i64,
    cur_len:i32,
    cur_pos:i32,
    cur_ntry:i32,
    t:i32,
    e_before:i32,
}

fn i_new(mem:[]i64, base:i32, logbase:i32, B0:i32, texplore:i32)IState {
    let st:IState = IState{
        .mem=mem, .base=base, .logbase=logbase,
        .B0=B0, .texplore=texplore,
        .ncand=0, .nlog=0,
        .cur_sketch=0, .cur_len=0, .cur_pos=0, .cur_ntry=0,
        .t=0, .e_before=W_E0,
    };
    let i:i32 = 0;
    while (i < I_SCRATCHN) { mem[base+i] = 0; i = i+1; }
    let g:i32 = i_gen(&st);
    return st;
}

fn i_prod_bonus(s0:i32, s1:i32, s2:i32)i32 {
    let b:i32 = 0;
    if ((s0 == 2 || s0 == 4) && s1 == 0) { b = b + 2; }
    if ((s1 == 2 || s1 == 4) && s2 == 0) { b = b + 2; }
    if (s0 == 0 && s1 == 1) { b = b + 2; }
    if ((s0 == 2 || s0 == 4) && s1 == 1) { b = b + 1; }
    if (s0 == 3 && s1 == 4) { b = b + 1; }
    return b;
}

fn i_gen(st:*IState)i32 {
    let n:i32 = 0;
    let s0:i32 = 0;
    while (s0 < 8 && n < I_NCAND) {
        let s1:i32 = -1;
        while (s1 < 8 && n < I_NCAND) {
            let s2:i32 = -1;
            while (s2 < 8 && n < I_NCAND) {
                let s3:i32 = -1;
                while (s3 < 8 && n < I_NCAND) {
                    let s4:i32 = -1;
                    while (s4 < 8 && n < I_NCAND) {
                        let s5:i32 = -1;
                        while (s5 < 8 && n < I_NCAND) {
                            let len:i32 = 1;
                            let digits:i64 = s0 as i64;
                            let sc:i32 = 2 + i_prod_bonus(s0, s1, s2);
                            if (s1 >= 0) {
                                len = 2;
                                digits = digits + (s1 as i64)*8;
                                sc = sc + 1 + i_prod_bonus(s1, s2, s3);
                            }
                            if (s2 >= 0) {
                                len = 3;
                                digits = digits + (s2 as i64)*64;
                                sc = sc + 1 + i_prod_bonus(s2, s3, s4);
                            }
                            if (s3 >= 0) {
                                len = 4;
                                digits = digits + (s3 as i64)*512;
                                sc = sc + 1;
                            }
                            if (s4 >= 0) {
                                len = 5;
                                digits = digits + (s4 as i64)*4096;
                                sc = sc + 1;
                            }
                            if (s5 >= 0) {
                                len = 6;
                                digits = digits + (s5 as i64)*32768;
                                sc = sc + 1;
                            }
                            let code:i64 = (len as i64)*262144 + digits;
                            st.mem[st.base+I_CAND+n] = code;
                            st.mem[st.base+I_CVAL+n] = 0;
                            st.mem[st.base+I_TRIED+n] = 0;
                            n = n + 1;
                            if (s5 < 7) { s5 = s5 + 1; } else { s5 = -2; }
                        }
                        if (s4 < 7) { s4 = s4 + 1; } else { s4 = -2; }
                    }
                    if (s3 < 7) { s3 = s3 + 1; } else { s3 = -2; }
                }
                if (s2 < 7) { s2 = s2 + 1; } else { s2 = -2; }
            }
            if (s1 < 7) { s1 = s1 + 1; } else { s1 = -2; }
        }
        s0 = s0 + 1;
    }
    st.ncand = n;
    return n;
}

fn i_pick(st:*IState)i32 {
    let best:i32 = 0;
    let bv:i64 = -999999999;
    let k:i32 = 0;
    while (k < st.ncand) {
        let v:i64 = st.mem[st.base+I_CVAL+k];
        if (st.mem[st.base+I_TRIED+k] == 0) { v = v + st.B0 as i64; }
        if (v > bv) { bv = v; best = k; }
        k = k+1;
    }
    return best;
}

fn i_schema_step(w:*World, s:i32)i32 {
    if (s == 0) {
        if (w.inv_n >= 2) { return A_COMBINE; }
        let c:i32 = w_nearest_crystal(w);
        if (c < 0) { return w_reflex_emergency(w); }
        if (w.apos == c) { return A_TAKE; }
        return w_step_toward(w, c);
    }
    if (s == 1) {
        if (w.inv_n > 0) { return A_DROP; }
        return A_WAIT;
    }
    if (s == 2) {
        let c:i32 = w_nearest_crystal(w);
        if (c < 0) { return w_reflex_emergency(w); }
        if (w.apos == c) { return A_TAKE; }
        return w_step_toward(w, c);
    }
    if (s == 3) {
        if (w_mote_on_cell(w) == 1) { return A_EAT; }
        let m:i32 = w_nearest_mote(w);
        if (m < 0) { return A_WAIT; }
        return w_step_toward(w, w.mem[w.base+O_MPOS+m]);
    }
    if (s == 4) {
        let m:i32 = w_nearest_mote(w);
        if (m < 0) { return A_WAIT; }
        if (w.apos == w.mem[w.base+O_MPOS+m]) { return A_TAKE; }
        return w_step_toward(w, w.mem[w.base+O_MPOS+m]);
    }
    if (s == 5) {
        if (w_in_zone(w) == 1 && w_sheltered(w) == 0) { return w_reflex_storm(w); }
        return A_WAIT;
    }
    if (s == 6) {
        let c1:i32 = w.void0 - 1;
        let c2:i32 = w.void1 + 1;
        if (c1 < 0) { return w_step_toward(w, c2); }
        if (c2 > 23) { return w_step_toward(w, c1); }
        let d1:i32 = w.apos - c1; if (d1 < 0) { d1 = 0 - d1; }
        let d2:i32 = w.apos - c2; if (d2 < 0) { d2 = 0 - d2; }
        if (d1 < d2) { return w_step_toward(w, c1); }
        return w_step_toward(w, c2);
    }
    return A_WAIT;
}

fn i_decode(st:*IState, pos:i32)i32 {
    let code:i64 = st.cur_sketch;
    let rem:i64 = code % 262144;
    let k:i32 = 0;
    while (k < pos) { rem = rem / 8; k = k+1; }
    return (rem % 8) as i32;
}

fn i_act(w:*World, st:*IState)i32 {
    st.t = st.t + 1;
    if (w_storm_active(w) == 1 && w_in_zone(w) == 1 && w_sheltered(w) == 0) {
        return w_reflex_storm(w);
    }
    if (w.energy < 15 && w_mote_on_cell(w) == 1) { return A_EAT; }
    if (st.cur_pos >= st.cur_len) {
        if (st.cur_len > 0) {
            let delta:i32 = w.energy - st.e_before;
            let k:i32 = st.cur_ntry;
            let old:i64 = st.mem[st.base+I_CVAL+k];
            let n:i64 = st.mem[st.base+I_TRIED+k];
            st.mem[st.base+I_CVAL+k] = (old*n + delta as i64) / (n + 1);
            st.mem[st.base+I_TRIED+k] = n + 1;
        }
        let explore:i32 = 0;
        if (st.t <= st.texplore) { explore = 1; }
        let pk:i32 = i_pick(st);
        if (explore == 1) {
            let f:i32 = 0;
            let kk:i32 = 0;
            while (kk < st.ncand && f == 0) {
                if (st.mem[st.base+I_TRIED+kk] == 0) { pk = kk; f = 1; }
                kk = kk+1;
            }
        }
        st.cur_ntry = pk;
        st.cur_sketch = st.mem[st.base+I_CAND+pk];
        st.cur_len = (st.cur_sketch / 262144) as i32;
        st.cur_pos = 0;
        st.e_before = w.energy;
        if (st.nlog < I_LOGN) {
            st.mem[st.logbase+st.nlog] = (st.t as i64)*4294967296 + st.cur_sketch;
            st.nlog = st.nlog + 1;
        }
    }
    let s:i32 = i_decode(st, st.cur_pos);
    st.cur_pos = st.cur_pos + 1;
    return i_schema_step(w, s);
}

fn i_settle(w:*World, st:*IState)i32 {
    if (st.cur_len > 0) {
        let delta:i32 = w.energy - st.e_before;
        let k:i32 = st.cur_ntry;
        let old:i64 = st.mem[st.base+I_CVAL+k];
        let n:i64 = st.mem[st.base+I_TRIED+k];
        st.mem[st.base+I_CVAL+k] = (old*n + delta as i64) / (n + 1);
        st.mem[st.base+I_TRIED+k] = n + 1;
    }
    return 0;
}

// agent_r.zag -- Arm R: recall-only control.
// Each tick, match the current situation to the closest taught single-step
// heuristic (kb.txt H1..H8). No multi-step plan composition, no novelty
// bonus, no credit assignment. Uses the world's shared arena only.

@import("world.zag")

fn r_act(w:*World)i32 {
    // H3: storm danger and exposed -> flee
    if (w_storm_active(w) == 1 && w_in_zone(w) == 1 && w_sheltered(w) == 0) {
        return w_reflex_storm(w);
    }
    // H5: critical energy -> nearest mote or eat
    if (w.energy < 25) { return w_reflex_emergency(w); }
    // H1: mote on cell -> EAT
    if (w_mote_on_cell(w) == 1) { return A_EAT; }
    // H2: no mote here -> move toward nearest active mote
    let m:i32 = w_nearest_mote(w);
    if (m >= 0) {
        let mp:i32 = w.mem[w.base+O_MPOS+m];
        if (mp != w.apos) { return w_step_toward(w, mp); }
        return A_EAT;
    }
    // H4/H7/H8 do not trigger (no items held, no storm soon, no void adjacency
    // handled here); H6: nothing visible -> WAIT
    return A_WAIT;
}

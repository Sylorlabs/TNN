// world.zag -- TIDELOCK deterministic world (frozen 2026-09-27).
// Pure Zag. Zero RNG. All stochasticity comes from fixed variant parameters.
// Memory: World holds ONE []i32 arena (shared); all arrays are offset views.
// This works around a znc native-lowering bug where two live same-type
// slices corrupt each other (verified 2026-09-27).

const W_NCELLS:i32 = 24;
const W_T:i32 = 600;
const W_E0:i32 = 100;
const W_EMAX:i32 = 200;
const W_BASAL:i32 = 1;
const W_NMOTES:i32 = 6;
const W_DORM:i32 = 20;
const W_RW_LOCAL:i32 = 30;
const W_RW_DEEP:i32 = 40;
const W_NCRYS:i32 = 4;
const W_INVCAP:i32 = 4;
const W_Z0:i32 = 6;
const W_Z1:i32 = 17;
const W_NSTORM:i32 = 3;
const W_SDMG:i32 = 4;

const A_LEFT:i32 = 0;
const A_RIGHT:i32 = 1;
const A_EAT:i32 = 2;
const A_TAKE:i32 = 3;
const A_DROP:i32 = 4;
const A_COMBINE:i32 = 5;
const A_WAIT:i32 = 6;

const IT_CRYSTAL:i32 = 0;
const IT_MOTE:i32 = 1;
const IT_WARD:i32 = 2;
const IT_LAMP:i32 = 3;
const IT_BEACON:i32 = 4;
const IT_PLANK:i32 = 5;
const IT_SURGE:i32 = 6;

// mem arena layout (196 i32)
const O_INV:i32 = 0;
const O_GCRYS:i32 = 4;
const O_GMOTE:i32 = 28;
const O_WARD:i32 = 52;
const O_LAMP:i32 = 76;
const O_BEACON:i32 = 100;
const O_PLANKED:i32 = 124;
const O_MPOS:i32 = 148;
const O_MVEL:i32 = 154;
const O_MLO:i32 = 160;
const O_MHI:i32 = 166;
const O_MRESP:i32 = 172;
const O_MDORM:i32 = 178;
const O_MDEEP:i32 = 184;
const O_STORMS:i32 = 190;
const O_STORME:i32 = 193;
const W_MEMN:i32 = 196;

struct World {
    mem:[]i32,
    base:i32,
    tick:i32,
    apos:i32,
    energy:i32,
    alive:i32,
    cause:i32,
    inv_n:i32,
    void0:i32,
    void1:i32,
    home:i32,
    surge:i32,
}

fn w_reset(w:*World)i32 {
    let i:i32 = 0;
    while (i < W_MEMN) { w.mem[w.base+i] = 0; i = i+1; }
    w.tick = 0;
    w.apos = 12;
    w.energy = W_E0;
    w.alive = 1;
    w.cause = 0;
    w.inv_n = 0;
    w.void0 = -1;
    w.void1 = -1;
    w.home = 2;
    w.surge = 0;
    return 0;
}

fn w_new(mem:[]i32, base:i32)World {
    let w:World = World{
        .mem=mem, .base=base,
        .tick=0, .apos=12, .energy=W_E0, .alive=1, .cause=0,
        .inv_n=0, .void0=-1, .void1=-1, .home=2, .surge=0,
    };
    let i:i32 = 0;
    while (i < W_MEMN) { mem[base+i] = 0; i = i+1; }
    return w;
}

fn w_mote_active(w:*World, i:i32)i32 {
    if (w.mem[w.base+O_MDORM+i] == 0) { return 1; }
    return 0;
}

fn w_same_side(w:*World, cell:i32)i32 {
    if (w.apos < w.void0 && cell < w.void0) { return 1; }
    if (w.apos > w.void1 && cell > w.void1) { return 1; }
    return 0;
}

fn w_nearest_mote(w:*World)i32 {
    let best:i32 = -1;
    let bd:i32 = 999;
    let i:i32 = 0;
    while (i < W_NMOTES) {
        if (w_mote_active(w, i) == 1 && w_same_side(w, w.mem[w.base+O_MPOS+i]) == 1) {
            let d:i32 = w.apos - w.mem[w.base+O_MPOS+i];
            if (d < 0) { d = 0 - d; }
            if (d < bd) { bd = d; best = i; }
        }
        i = i+1;
    }
    return best;
}

fn w_mote_on_cell(w:*World)i32 {
    let i:i32 = 0;
    while (i < W_NMOTES) {
        if (w.mem[w.base+O_MDORM+i] == 0 && w.mem[w.base+O_MPOS+i] == w.apos) { return 1; }
        i = i+1;
    }
    return 0;
}

fn w_nearest_crystal(w:*World)i32 {
    let best:i32 = -1;
    let bd:i32 = 999;
    let c:i32 = 0;
    while (c < W_NCELLS) {
        if (w.mem[w.base+O_GCRYS+c] == 1 && w_same_side(w, c) == 1) {
            let d:i32 = w.apos - c;
            if (d < 0) { d = 0 - d; }
            if (d < bd) { bd = d; best = c; }
        }
        c = c+1;
    }
    return best;
}

fn w_in_zone(w:*World)i32 {
    if (w.apos >= W_Z0 && w.apos <= W_Z1) { return 1; }
    return 0;
}

fn w_sheltered(w:*World)i32 {
    if (w.mem[w.base+O_WARD+w.apos] == 1) { return 1; }
    if (w.mem[w.base+O_BEACON+w.apos] == 1) { return 1; }
    return 0;
}

fn w_storm_active(w:*World)i32 {
    let i:i32 = 0;
    while (i < W_NSTORM) {
        if (w.tick >= w.mem[w.base+O_STORMS+i] && w.tick < w.mem[w.base+O_STORME+i]) { return 1; }
        i = i+1;
    }
    return 0;
}

fn w_storm_within(w:*World, h:i32)i32 {
    let i:i32 = 0;
    while (i < W_NSTORM) {
        let s:i32 = w.mem[w.base+O_STORMS+i];
        if (s > w.tick && s - w.tick <= h) { return 1; }
        i = i+1;
    }
    return 0;
}

fn w_storm_damage_now(w:*World)i32 {
    if (w_storm_active(w) == 1 && w_in_zone(w) == 1 && w_sheltered(w) == 0) { return W_SDMG; }
    return 0;
}

fn w_step_toward(w:*World, target:i32)i32 {
    if (w.apos < target) {
        let np:i32 = w.apos + 1;
        if ((np == w.void0 || np == w.void1) && w.mem[w.base+O_PLANKED+np] == 0) {
            return A_WAIT;
        }
        return A_RIGHT;
    }
    if (w.apos > target) {
        let np:i32 = w.apos - 1;
        if ((np == w.void0 || np == w.void1) && w.mem[w.base+O_PLANKED+np] == 0) {
            return A_WAIT;
        }
        return A_LEFT;
    }
    return A_WAIT;
}

fn w_reflex_storm(w:*World)i32 {
    // partition-aware: flee to the zone exit on the agent's own side of
    // the void; never flee through an unplanked void cell
    if (w_in_zone(w) == 0) { return A_WAIT; }
    if (w.apos < w.void0) { return A_LEFT; }
    return A_RIGHT;
}

fn w_reflex_emergency(w:*World)i32 {
    if (w_mote_on_cell(w) == 1) { return A_EAT; }
    let m:i32 = w_nearest_mote(w);
    if (m >= 0) { return w_step_toward(w, w.mem[w.base+O_MPOS+m]); }
    return A_WAIT;
}

fn w_mote_move(w:*World, i:i32)i32 {
    if (w.mem[w.base+O_MDORM+i] > 0) {
        w.mem[w.base+O_MDORM+i] = w.mem[w.base+O_MDORM+i] - 1;
        return 0;
    }
    w.mem[w.base+O_MPOS+i] = w.mem[w.base+O_MPOS+i] + w.mem[w.base+O_MVEL+i];
    let guard:i32 = 0;
    while ((w.mem[w.base+O_MPOS+i] < w.mem[w.base+O_MLO+i] || w.mem[w.base+O_MPOS+i] > w.mem[w.base+O_MHI+i]) && guard < 8) {
        if (w.mem[w.base+O_MPOS+i] < w.mem[w.base+O_MLO+i]) {
            w.mem[w.base+O_MPOS+i] = w.mem[w.base+O_MLO+i] + (w.mem[w.base+O_MLO+i] - w.mem[w.base+O_MPOS+i]);
            w.mem[w.base+O_MVEL+i] = 0 - w.mem[w.base+O_MVEL+i];
        }
        if (w.mem[w.base+O_MPOS+i] > w.mem[w.base+O_MHI+i]) {
            w.mem[w.base+O_MPOS+i] = w.mem[w.base+O_MHI+i] - (w.mem[w.base+O_MHI+i] - w.mem[w.base+O_MPOS+i]);
            w.mem[w.base+O_MVEL+i] = 0 - w.mem[w.base+O_MVEL+i];
        }
        guard = guard + 1;
    }
    return 0;
}

fn w_attract_toward(w:*World, i:i32, target:i32)i32 {
    if (w.mem[w.base+O_MDORM+i] > 0) { return 0; }
    if (w.mem[w.base+O_MPOS+i] < target && w.mem[w.base+O_MPOS+i] < w.mem[w.base+O_MHI+i]) {
        w.mem[w.base+O_MPOS+i] = w.mem[w.base+O_MPOS+i] + 1;
    }
    if (w.mem[w.base+O_MPOS+i] > target && w.mem[w.base+O_MPOS+i] > w.mem[w.base+O_MLO+i]) {
        w.mem[w.base+O_MPOS+i] = w.mem[w.base+O_MPOS+i] - 1;
    }
    return 0;
}

fn w_remove_inv(w:*World, ia:i32, ib:i32)i32 {
    let dst:i32 = 0;
    let i:i32 = 0;
    while (i < w.inv_n) {
        if (i != ia && i != ib) {
            w.mem[w.base+O_INV+dst] = w.mem[w.base+O_INV+i];
            dst = dst+1;
        }
        i = i+1;
    }
    w.inv_n = dst;
    return 0;
}

fn w_step(w:*World, act:i32, ca:i32, cb:i32)i32 {
    if (w.alive == 0) { return 0; }
    let cost:i32 = W_BASAL;
    if (act == A_LEFT || act == A_RIGHT) {
        let np:i32 = w.apos;
        if (act == A_LEFT) { np = w.apos - 1; }
        if (act == A_RIGHT) { np = w.apos + 1; }
        if (np < 0) { np = 0; }
        if (np > 23) { np = 23; }
        let falls:i32 = 0;
        if (np == w.void0 || np == w.void1) {
            if (w.mem[w.base+O_PLANKED+np] == 0) { falls = 1; }
        }
        if (falls == 1) {
            w.apos = np;
            w.energy = w.energy - cost;
            w.tick = w.tick + 1;
            w.alive = 0;
            w.cause = 2;
            return 0;
        }
        w.apos = np;
        cost = cost + 1;
    }
    if (act == A_EAT) {
        if (w.mem[w.base+O_GMOTE+w.apos] == 1) {
            w.mem[w.base+O_GMOTE+w.apos] = 0;
            w.energy = w.energy + W_RW_LOCAL;
            if (w.energy > W_EMAX) { w.energy = W_EMAX; }
        } else {
            let i:i32 = 0;
            let ate:i32 = 0;
            while (i < W_NMOTES && ate == 0) {
                if (w.mem[w.base+O_MDORM+i] == 0 && w.mem[w.base+O_MPOS+i] == w.apos) {
                    ate = 1;
                    if (w.mem[w.base+O_MDEEP+i] == 1) { w.energy = w.energy + W_RW_DEEP; }
                    else { w.energy = w.energy + W_RW_LOCAL; }
                    if (w.energy > W_EMAX) { w.energy = W_EMAX; }
                    w.mem[w.base+O_MPOS+i] = w.mem[w.base+O_MRESP+i];
                    w.mem[w.base+O_MDORM+i] = W_DORM;
                }
                i = i+1;
            }
        }
    }
    if (act == A_TAKE) {
        if (w.inv_n < W_INVCAP) {
            if (w.mem[w.base+O_GCRYS+w.apos] == 1) {
                w.mem[w.base+O_GCRYS+w.apos] = 0;
                w.mem[w.base+O_INV+w.inv_n] = IT_CRYSTAL;
                w.inv_n = w.inv_n + 1;
            } else {
                if (w.mem[w.base+O_GMOTE+w.apos] == 1) {
                    w.mem[w.base+O_GMOTE+w.apos] = 0;
                    w.mem[w.base+O_INV+w.inv_n] = IT_MOTE;
                    w.inv_n = w.inv_n + 1;
                } else {
                    let i:i32 = 0;
                    let got:i32 = 0;
                    while (i < W_NMOTES && got == 0) {
                        if (w.mem[w.base+O_MDORM+i] == 0 && w.mem[w.base+O_MPOS+i] == w.apos) {
                            got = 1;
                            w.mem[w.base+O_INV+w.inv_n] = IT_MOTE;
                            w.inv_n = w.inv_n + 1;
                            w.mem[w.base+O_MPOS+i] = w.mem[w.base+O_MRESP+i];
                            w.mem[w.base+O_MDORM+i] = W_DORM;
                        }
                        i = i+1;
                    }
                }
            }
        }
    }
    if (act == A_DROP) {
        if (w.inv_n > 0) {
            let item:i32 = w.mem[w.base+O_INV+w.inv_n-1];
            w.inv_n = w.inv_n - 1;
            if (item == IT_WARD) { w.mem[w.base+O_WARD+w.apos] = 1; }
            if (item == IT_LAMP) { w.mem[w.base+O_LAMP+w.apos] = 1; }
            if (item == IT_BEACON) { w.mem[w.base+O_BEACON+w.apos] = 1; }
            if (item == IT_PLANK) {
                if (w.apos > 0 && (w.apos-1 == w.void0 || w.apos-1 == w.void1)) {
                    w.mem[w.base+O_PLANKED+w.apos-1] = 1;
                } else {
                    if (w.apos < 23 && (w.apos+1 == w.void0 || w.apos+1 == w.void1)) {
                        w.mem[w.base+O_PLANKED+w.apos+1] = 1;
                    }
                }
            }
            if (item == IT_CRYSTAL) { w.mem[w.base+O_GCRYS+w.apos] = 1; }
            if (item == IT_MOTE) { w.mem[w.base+O_GMOTE+w.apos] = 1; }
        }
    }
    if (act == A_COMBINE) {
        if (w.inv_n >= 2 && ca >= 0 && cb >= 0 && ca < w.inv_n && cb < w.inv_n && ca != cb) {
            let a:i32 = w.mem[w.base+O_INV+ca];
            let b:i32 = w.mem[w.base+O_INV+cb];
            let prod:i32 = -1;
            if ((a == IT_CRYSTAL && b == IT_CRYSTAL)) { prod = IT_WARD; }
            if ((a == IT_CRYSTAL && b == IT_MOTE) || (a == IT_MOTE && b == IT_CRYSTAL)) { prod = IT_LAMP; }
            if ((a == IT_MOTE && b == IT_MOTE)) { prod = IT_SURGE; }
            if ((a == IT_CRYSTAL && b == IT_LAMP) || (a == IT_LAMP && b == IT_CRYSTAL)) { prod = IT_BEACON; }
            if ((a == IT_CRYSTAL && b == IT_BEACON) || (a == IT_BEACON && b == IT_CRYSTAL)) { prod = IT_PLANK; }
            if (prod == IT_SURGE) {
                let rr:i32 = w_remove_inv(w, ca, cb);
                w.surge = 1;
            } else {
                if (prod >= 0) {
                    let rr:i32 = w_remove_inv(w, ca, cb);
                    w.mem[w.base+O_INV+w.inv_n] = prod;
                    w.inv_n = w.inv_n + 1;
                }
            }
        }
    }
    w.energy = w.energy - cost;
    if (w.mem[w.base+O_WARD+w.apos] == 1) {
        // WARD cell: no basal cost (frozen world physics); refund the basal,
        // keeping only the movement cost if the agent moved this tick
        w.energy = w.energy + W_BASAL;
    }
    if (w.surge == 1) {
        w.energy = w.energy + 12;
        if (w.energy > W_EMAX) { w.energy = W_EMAX; }
        w.surge = 0;
    }
    w.energy = w.energy - w_storm_damage_now(w);
    if (w.energy <= 0) {
        w.energy = 0;
        w.alive = 0;
        w.cause = 1;
        w.tick = w.tick + 1;
        return 0;
    }
    let i:i32 = 0;
    while (i < W_NMOTES) { w_mote_move(w, i); i = i+1; }
    i = 0;
    while (i < W_NMOTES) {
        if (w.mem[w.base+O_MDORM+i] == 0) {
            let c:i32 = 0;
            let bestl:i32 = -1;
            let bd:i32 = 999;
            while (c < W_NCELLS) {
                if (w.mem[w.base+O_LAMP+c] == 1) {
                    let d:i32 = w.mem[w.base+O_MPOS+i] - c;
                    if (d < 0) { d = 0 - d; }
                    if (d <= 3 && d < bd) { bd = d; bestl = c; }
                }
                c = c+1;
            }
            if (bestl >= 0) { w_attract_toward(w, i, bestl); }
            c = 0;
            while (c < W_NCELLS) {
                if (w.mem[w.base+O_BEACON+c] == 1) { w_attract_toward(w, i, c); }
                c = c+1;
            }
        }
        i = i+1;
    }
    w.tick = w.tick + 1;
    return 0;
}

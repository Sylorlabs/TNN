// exp1b_agent_i.zag -- EXP1b I arms: literal primitive-action deliberation.
// Per PREREG_EXP1b.md M2: a plan is a sequence of at most 4 PRIMITIVE actions
// from {LEFT, RIGHT, EAT, TAKE, DROP, COMBINE, WAIT}. The candidate set is the
// full enumeration of all 7^1 + 7^2 + 7^3 + 7^4 = 2800 sequences, length
// ascending, lex order within a length: pure combinatorics, zero authored
// productivity bias. No schemas, no seeking macros, no hand bonuses.
// Scoring: deterministic argmax over candidates of (mean experienced
// delta-energy per plan-sketch + B0 novelty bonus for untried compositions);
// ties go to the lowest candidate index; zero RNG. Execution is open-loop;
// two preempting single-step taught reflexes (storm flee = H3, energy below
// 25 = H4 survival reflex) never advance the plan. After a plan's actions
// are spent, its observed delta-energy updates that sketch's mean credit and
// the arm replans. COMBINE uses a fixed deterministic arg rule: the two most
// recently taken inventory items; a safe no-op when fewer than 2 are held.
// Arms differ only in B0: I-survive B0=40, I-invent B0=80.
// Memory: JState holds ONE []i64 arena (shared); candidate tables are offset
// views (znc multi-slice workaround, same as EXP1).

@import("world.zag")

const J_NCAND:i32 = 2800;
const J_CAND:i32 = 0;
const J_CVAL:i32 = 2800;
const J_TRIED:i32 = 5600;
const J_SCRATCHN:i32 = 8400;
const J_LOGN:i32 = 256;
const J_POW:i32 = 2401;

struct JState {
    mem:[]i64,
    base:i32,
    logbase:i32,
    B0:i32,
    ncand:i32,
    nlog:i32,
    cur_code:i64,
    cur_len:i32,
    cur_pos:i32,
    cur_idx:i32,
    e_before:i32,
    ca:i32,
    cb:i32,
}

fn j_pow7(e:i32)i64 {
    let r:i64 = 1;
    let k:i32 = 0;
    while (k < e) { r = r * 7; k = k + 1; }
    return r;
}

fn j_new(mem:[]i64, base:i32, logbase:i32, B0:i32)JState {
    let st:JState = JState{
        .mem=mem, .base=base, .logbase=logbase,
        .B0=B0,
        .ncand=0, .nlog=0,
        .cur_code=0, .cur_len=0, .cur_pos=0, .cur_idx=0,
        .e_before=W_E0, .ca=-1, .cb=-1,
    };
    let i:i32 = 0;
    while (i < J_SCRATCHN) { mem[base+i] = 0; i = i+1; }
    let g:i32 = j_gen(&st);
    return st;
}

fn j_gen(st:*JState)i32 {
    let n:i32 = 0;
    let len:i32 = 1;
    while (len <= 4) {
        let lim:i64 = j_pow7(len);
        let d:i64 = 0;
        while (d < lim) {
            st.mem[st.base+J_CAND+n] = (len as i64)*(J_POW as i64) + d;
            st.mem[st.base+J_CVAL+n] = 0;
            st.mem[st.base+J_TRIED+n] = 0;
            n = n + 1;
            d = d + 1;
        }
        len = len + 1;
    }
    st.ncand = n;
    return n;
}

fn j_pick(st:*JState)i32 {
    let best:i32 = 0;
    let bv:i64 = -999999999;
    let k:i32 = 0;
    while (k < st.ncand) {
        let v:i64 = st.mem[st.base+J_CVAL+k];
        if (st.mem[st.base+J_TRIED+k] == 0) { v = v + st.B0 as i64; }
        if (v > bv) { bv = v; best = k; }
        k = k+1;
    }
    return best;
}

fn j_len(code:i64)i32 {
    return (code / (J_POW as i64)) as i32;
}

fn j_tok(code:i64, pos:i32)i32 {
    let d:i64 = code % (J_POW as i64);
    return ((d / j_pow7(pos)) % 7) as i32;
}

fn j_credit(w:*World, st:*JState)i32 {
    if (st.cur_len > 0) {
        let delta:i32 = w.energy - st.e_before;
        let k:i32 = st.cur_idx;
        let old:i64 = st.mem[st.base+J_CVAL+k];
        let n:i64 = st.mem[st.base+J_TRIED+k];
        st.mem[st.base+J_CVAL+k] = (old*n + delta as i64) / (n + 1);
        st.mem[st.base+J_TRIED+k] = n + 1;
    }
    return 0;
}

fn j_act(w:*World, st:*JState)i32 {
    // Preempting taught single-step reflexes (shared KB, also used by R).
    // They do not advance the plan.
    if (w_storm_active(w) == 1 && w_in_zone(w) == 1 && w_sheltered(w) == 0) {
        return w_reflex_storm(w);
    }
    if (w.energy < 25) {
        return w_reflex_emergency(w);
    }
    if (st.cur_pos >= st.cur_len) {
        let c:i32 = j_credit(w, st);
        let pk:i32 = j_pick(st);
        st.cur_idx = pk;
        st.cur_code = st.mem[st.base+J_CAND+pk];
        st.cur_len = j_len(st.cur_code);
        st.cur_pos = 0;
        st.e_before = w.energy;
        if (st.nlog < J_LOGN) {
            st.mem[st.logbase+st.nlog] = (w.tick as i64)*4294967296 + st.cur_code;
            st.nlog = st.nlog + 1;
        }
    }
    let tok:i32 = j_tok(st.cur_code, st.cur_pos);
    st.cur_pos = st.cur_pos + 1;
    // Taught void-safety reflex: never step into an unplanked void cell.
    // This is a safety override, not a plan; the plan position advances.
    if (tok == A_LEFT || tok == A_RIGHT) {
        let np:i32 = w.apos;
        if (tok == A_LEFT) { np = w.apos - 1; }
        if (tok == A_RIGHT) { np = w.apos + 1; }
        if ((np == w.void0 || np == w.void1) && w.mem[w.base+O_PLANKED+np] == 0) {
            return A_WAIT;
        }
    }
    st.ca = -1;
    st.cb = -1;
    if (tok == A_COMBINE && w.inv_n >= 2) {
        st.ca = w.inv_n - 2;
        st.cb = w.inv_n - 1;
    }
    return tok;
}

fn j_end(w:*World, st:*JState)i32 {
    return j_credit(w, st);
}

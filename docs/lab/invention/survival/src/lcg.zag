// lcg.zag -- fixed-seed LCG for Arm Z (random baseline).
// A documented control, not the AI. Zero use in any agent decision path.

struct Lcg {
    s:i64,
}

fn lcg_new(seed:i64)Lcg {
    return Lcg{.s=seed};
}

// Returns a nonnegative i32.
fn lcg_next(g:*Lcg)i32 {
    g.s = (g.s * 6364136223846793005 + 1442695040888963407) & 9223372036854775807;
    return (g.s >> 33) as i32;
}

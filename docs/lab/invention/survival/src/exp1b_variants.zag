        m[b+V_CRYS+0]=9; m[b+V_CRYS+1]=12; m[b+V_CRYS+2]=14; m[b+V_CRYS+3]=21;
        m[b+V_SS+0]=130; m[b+V_SS+1]=320; m[b+V_SS+2]=510;
        m[b+V_SE+0]=160; m[b+V_SE+1]=350; m[b+V_SE+2]=540;
        m[b+V_MPOS+0]=4;  m[b+V_MVEL+0]=1;  m[b+V_MLO+0]=3;  m[b+V_MHI+0]=6;  m[b+V_MRESP+0]=4;  m[b+V_MDEEP+0]=0;
        m[b+V_MPOS+1]=6;  m[b+V_MVEL+1]=-1; m[b+V_MLO+1]=4;  m[b+V_MHI+1]=7;  m[b+V_MRESP+1]=6;  m[b+V_MDEEP+1]=0;
        m[b+V_MPOS+2]=3;  m[b+V_MVEL+2]=1;  m[b+V_MLO+2]=3;  m[b+V_MHI+2]=5;  m[b+V_MRESP+2]=3;  m[b+V_MDEEP+2]=0;
        m[b+V_MPOS+3]=5;  m[b+V_MVEL+3]=-1; m[b+V_MLO+3]=4;  m[b+V_MHI+3]=6;  m[b+V_MRESP+3]=5;  m[b+V_MDEEP+3]=0;
        m[b+V_MPOS+4]=20; m[b+V_MVEL+4]=1;  m[b+V_MLO+4]=18; m[b+V_MHI+4]=22; m[b+V_MRESP+4]=20; m[b+V_MDEEP+4]=1;

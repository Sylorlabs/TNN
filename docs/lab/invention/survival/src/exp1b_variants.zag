    m[b+V_SE+0]=175; m[b+V_SE+1]=375; m[b+V_SE+2]=565;
    m[b+V_MPOS+0]=19; m[b+V_MVEL+0]=1;  m[b+V_MLO+0]=18; m[b+V_MHI+0]=20; m[b+V_MRESP+0]=19; m[b+V_MDEEP+0]=0;
    m[b+V_MPOS+1]=21; m[b+V_MVEL+1]=-1; m[b+V_MLO+1]=19; m[b+V_MHI+1]=21; m[b+V_MRESP+1]=21; m[b+V_MDEEP+1]=0;
    m[b+V_MPOS+2]=18; m[b+V_MVEL+2]=1;  m[b+V_MLO+2]=18; m[b+V_MHI+2]=19; m[b+V_MRESP+2]=18; m[b+V_MDEEP+2]=0;
    m[b+V_MPOS+3]=20; m[b+V_MVEL+3]=-1; m[b+V_MLO+3]=19; m[b+V_MHI+3]=20; m[b+V_MRESP+3]=19; m[b+V_MDEEP+3]=0;
    m[b+V_MPOS+4]=5;  m[b+V_MVEL+4]=1;  m[b+V_MLO+4]=3;  m[b+V_MHI+4]=7;  m[b+V_MRESP+4]=5;  m[b+V_MDEEP+4]=1;
    m[b+V_MPOS+5]=13; m[b+V_MVEL+5]=-1; m[b+V_MLO+5]=11; m[b+V_MHI+5]=15; m[b+V_MRESP+5]=13; m[b+V_MDEEP+5]=1;
    return 0;
}

// v2_badmot: 1 if mote i violates the M1 retune constraints, else 0.
fn v2_badmot(p:*VParams, i:i32)i32 {
    let b:i32 = p.base;
    let m:[]i32 = p.mem;
    let vel:i32 = m[b+V_MVEL+i];
    let av:i32 = vel;
    if (av < 0) { av = 0 - av; }
    if (av != 1 && av != 2) { return 1; }
    let resp:i32 = m[b+V_MRESP+i];
    if (resp == p.home || resp == p.start) { return 1; }
    let pos:i32 = m[b+V_MPOS+i];
    if (pos == p.home) { return 1; }
    let lo:i32 = m[b+V_MLO+i];
    let hi:i32 = m[b+V_MHI+i];
    if (p.home >= lo && p.home <= hi) { return 1; }
    return 0;
}

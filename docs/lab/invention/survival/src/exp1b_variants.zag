// exp1b_variants.zag -- EXP1b 12 world variants (frozen 2026-09-27).
// Retune per PREREG_EXP1b.md M1: every mote |v| in {1,2} (no stationary
// motes); no mote respawns at home or start; home lies in no mote drift
// range; exactly 2 deep (+40) motes confined past the void. Disjoint from
// EXP1 variants. Reuses VParams/v_apply from variants.zag; physics from
// world.zag is unchanged.
// Retune 3 (2026-09-27, within frozen M1 rules): calibration showed P
// (ward-turtle) survives via home as a zero-basal base; P scores high only
// when the 4-mote local cluster is adjacent to home. All variants now place
// the local cluster adjacent to home and start near the cluster. Bounce bug
// in world.zag fixed (hi-side was identity, motes escaped).

@import("variants.zag")

fn v2_fill(v:i32, p:*VParams)i32 {
    let b:i32 = p.base;
    let m:[]i32 = p.mem;
    if (v == 0) {
        p.void0 = 10; p.void1 = 11; p.start = 14; p.home = 20;
        m[b+V_CRYS+0]=13; m[b+V_CRYS+1]=16; m[b+V_CRYS+2]=22; m[b+V_CRYS+3]=5;
        m[b+V_SS+0]=150; m[b+V_SS+1]=350; m[b+V_SS+2]=550;
        m[b+V_SE+0]=180; m[b+V_SE+1]=380; m[b+V_SE+2]=580;
        m[b+V_MPOS+0]=16; m[b+V_MVEL+0]=1;  m[b+V_MLO+0]=15; m[b+V_MHI+0]=18; m[b+V_MRESP+0]=16; m[b+V_MDEEP+0]=0;
        m[b+V_MPOS+1]=18; m[b+V_MVEL+1]=-1; m[b+V_MLO+1]=16; m[b+V_MHI+1]=19; m[b+V_MRESP+1]=18; m[b+V_MDEEP+1]=0;
        m[b+V_MPOS+2]=15; m[b+V_MVEL+2]=1;  m[b+V_MLO+2]=15; m[b+V_MHI+2]=17; m[b+V_MRESP+2]=15; m[b+V_MDEEP+2]=0;
        m[b+V_MPOS+3]=17; m[b+V_MVEL+3]=-1; m[b+V_MLO+3]=16; m[b+V_MHI+3]=18; m[b+V_MRESP+3]=17; m[b+V_MDEEP+3]=0;
        m[b+V_MPOS+4]=4;  m[b+V_MVEL+4]=1;  m[b+V_MLO+4]=2;  m[b+V_MHI+4]=6;  m[b+V_MRESP+4]=4;  m[b+V_MDEEP+4]=1;
        m[b+V_MPOS+5]=6;  m[b+V_MVEL+5]=-1; m[b+V_MLO+5]=4;  m[b+V_MHI+5]=8;  m[b+V_MRESP+5]=6;  m[b+V_MDEEP+5]=1;
        return 0;
    }
    if (v == 1) {
        p.void0 = 10; p.void1 = 11; p.start = 5; p.home = 2;
        m[b+V_CRYS+0]=4; m[b+V_CRYS+1]=6; m[b+V_CRYS+2]=9; m[b+V_CRYS+3]=18;
        m[b+V_SS+0]=120; m[b+V_SS+1]=330; m[b+V_SS+2]=520;
        m[b+V_SE+0]=150; m[b+V_SE+1]=360; m[b+V_SE+2]=550;

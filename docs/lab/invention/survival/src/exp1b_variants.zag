        m[b+V_MPOS+4]=14; m[b+V_MVEL+4]=1; m[b+V_MLO+4]=12; m[b+V_MHI+4]=16; m[b+V_MRESP+4]=14; m[b+V_MDEEP+4]=1;
        m[b+V_MPOS+5]=20; m[b+V_MVEL+5]=-1; m[b+V_MLO+5]=18; m[b+V_MHI+5]=22; m[b+V_MRESP+5]=20; m[b+V_MDEEP+5]=1;
        return 0;
    }
    if (v == 2) {
        p.void0 = 4; p.void1 = 5; p.start = 12; p.home = 20;
        m[b+V_CRYS+0]=11; m[b+V_CRYS+1]=14; m[b+V_CRYS+2]=18; m[b+V_CRYS+3]=2;
        m[b+V_SS+0]=180; m[b+V_SS+1]=380; m[b+V_SS+2]=560;
        m[b+V_SE+0]=210; m[b+V_SE+1]=410; m[b+V_SE+2]=590;
        m[b+V_MPOS+0]=16; m[b+V_MVEL+0]=1;  m[b+V_MLO+0]=15; m[b+V_MHI+0]=18; m[b+V_MRESP+0]=16; m[b+V_MDEEP+0]=0;
        m[b+V_MPOS+1]=18; m[b+V_MVEL+1]=-1; m[b+V_MLO+1]=16; m[b+V_MHI+1]=19; m[b+V_MRESP+1]=18; m[b+V_MDEEP+1]=0;
        m[b+V_MPOS+2]=15; m[b+V_MVEL+2]=1;  m[b+V_MLO+2]=15; m[b+V_MHI+2]=17; m[b+V_MRESP+2]=15; m[b+V_MDEEP+2]=0;
        m[b+V_MPOS+3]=17; m[b+V_MVEL+3]=-1; m[b+V_MLO+3]=16; m[b+V_MHI+3]=18; m[b+V_MRESP+3]=17; m[b+V_MDEEP+3]=0;

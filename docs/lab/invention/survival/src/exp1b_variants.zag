        m[b+V_MPOS+1]=23; m[b+V_MVEL+1]=-1; m[b+V_MLO+1]=21; m[b+V_MHI+1]=23; m[b+V_MRESP+1]=23; m[b+V_MDEEP+1]=0;
        m[b+V_MPOS+2]=20; m[b+V_MVEL+2]=1;  m[b+V_MLO+2]=20; m[b+V_MHI+2]=21; m[b+V_MRESP+2]=20; m[b+V_MDEEP+2]=0;
        m[b+V_MPOS+3]=22; m[b+V_MVEL+3]=-1; m[b+V_MLO+3]=21; m[b+V_MHI+3]=22; m[b+V_MRESP+3]=22; m[b+V_MDEEP+3]=0;
        m[b+V_MPOS+4]=6;  m[b+V_MVEL+4]=1;  m[b+V_MLO+4]=4;  m[b+V_MHI+4]=8;  m[b+V_MRESP+4]=6;  m[b+V_MDEEP+4]=1;
        m[b+V_MPOS+5]=12; m[b+V_MVEL+5]=-1; m[b+V_MLO+5]=10; m[b+V_MHI+5]=14; m[b+V_MRESP+5]=12; m[b+V_MDEEP+5]=1;
        return 0;
    }
    if (v == 6) {
        p.void0 = 10; p.void1 = 11; p.start = 16; p.home = 22;
        m[b+V_CRYS+0]=15; m[b+V_CRYS+1]=18; m[b+V_CRYS+2]=21; m[b+V_CRYS+3]=6;
        m[b+V_SS+0]=140; m[b+V_SS+1]=340; m[b+V_SS+2]=540;
        m[b+V_SE+0]=170; m[b+V_SE+1]=370; m[b+V_SE+2]=570;
        m[b+V_MPOS+0]=18; m[b+V_MVEL+0]=1;  m[b+V_MLO+0]=17; m[b+V_MHI+0]=20; m[b+V_MRESP+0]=18; m[b+V_MDEEP+0]=0;
        m[b+V_MPOS+1]=20; m[b+V_MVEL+1]=-1; m[b+V_MLO+1]=18; m[b+V_MHI+1]=21; m[b+V_MRESP+1]=20; m[b+V_MDEEP+1]=0;
        m[b+V_MPOS+2]=17; m[b+V_MVEL+2]=1;  m[b+V_MLO+2]=17; m[b+V_MHI+2]=19; m[b+V_MRESP+2]=17; m[b+V_MDEEP+2]=0;
        m[b+V_MPOS+3]=19; m[b+V_MVEL+3]=-1; m[b+V_MLO+3]=18; m[b+V_MHI+3]=20; m[b+V_MRESP+3]=19; m[b+V_MDEEP+3]=0;

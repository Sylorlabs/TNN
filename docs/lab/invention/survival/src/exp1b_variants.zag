        m[b+V_CRYS+0]=1; m[b+V_CRYS+1]=2; m[b+V_CRYS+2]=9; m[b+V_CRYS+3]=15;
        m[b+V_SS+0]=100; m[b+V_SS+1]=300; m[b+V_SS+2]=500;
        m[b+V_SE+0]=130; m[b+V_SE+1]=330; m[b+V_SE+2]=530;

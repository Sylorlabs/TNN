// agent_p.zag -- P arm: taught ward strategy (state machine).
// Implements kb/kb_p.txt verbatim: gather 2 crystals, COMBINE into WARD,
// DROP at the per-world home cell, then Phase 4 loop. Uses the world's
// shared arena; no agent-owned slices.

@import("world.zag")

struct PState {
    phase:i32,
    ca:i32,
    cb:i32,
}

fn p_new(w:*World)PState {
    return PState{.phase=0, .ca=0, .cb=1};
}

fn p_holding_ward(w:*World)i32 {
    let i:i32 = 0;
    while (i < w.inv_n) {
        if (w.mem[w.base+O_INV+i] == IT_WARD) { return 1; }
        i = i+1;
    }
    return 0;
}

fn p_count_crystal(w:*World)i32 {
    let n:i32 = 0;
    let i:i32 = 0;
    while (i < w.inv_n) {
        if (w.mem[w.base+O_INV+i] == IT_CRYSTAL) { n = n+1; }
        i = i+1;
    }
    return 0 + n;
}

fn p_act(w:*World, st:*PState)i32 {
    // Phase 1: gather 2 crystals
    if (st.phase == 0) {
        if (p_count_crystal(w) >= 2) {
            st.phase = 1;
        } else {
            if (w_storm_active(w) == 1 && w_in_zone(w) == 1) { return w_reflex_storm(w); }
            if (w.energy < 25) { return w_reflex_emergency(w); }
            let c:i32 = w_nearest_crystal(w);
            if (c < 0) { return w_reflex_emergency(w); }
            if (w.apos == c) { return A_TAKE; }
            return w_step_toward(w, c);
        }
    }
    // Phase 2: COMBINE into WARD
    if (st.phase == 1) {
        if (p_holding_ward(w) == 1) {
            st.phase = 2;
        } else {
            if (w.inv_n >= 2) {
                let fi:i32 = -1;
                let fj:i32 = -1;
                let i:i32 = 0;
                while (i < w.inv_n) {
                    let k:i32 = i + 1;
                    while (k < w.inv_n) {
                        if (w.mem[w.base+O_INV+i] == IT_CRYSTAL && w.mem[w.base+O_INV+k] == IT_CRYSTAL) {
                            if (fi < 0) { fi = i; fj = k; }
                        }
                        k = k+1;
                    }
                    i = i+1;
                }
                if (fi >= 0) {
                    st.ca = fi;
                    st.cb = fj;
                    st.phase = 2;
                    return A_COMBINE;
                }
            }
            st.phase = 0;
            return A_WAIT;
        }
    }
    // Phase 3: go home, DROP the WARD
    if (st.phase == 2) {
        if (w.mem[w.base+O_WARD+w.home] == 1) {
            st.phase = 3;
        } else {
            if (p_holding_ward(w) == 0) { st.phase = 0; return A_WAIT; }
            if (w_storm_active(w) == 1 && w_in_zone(w) == 1 && w_sheltered(w) == 0) {
                return w_reflex_storm(w);
            }
            if (w.apos == w.home) {
                st.phase = 3;
                return A_DROP;
            }
            return w_step_toward(w, w.home);
        }
    }
    // Phase 4 (kb_p.txt, in order):
    // a. storm active or within 25 ticks -> go home (shelter on the WARD)
    if (w_storm_active(w) == 1 || w_storm_within(w, 25) == 1) {
        if (w.apos == w.home) { return A_WAIT; }
        return w_step_toward(w, w.home);
    }
    // b. energy below 25 -> nearest active mote
    if (w.energy < 25) { return w_reflex_emergency(w); }
    // c. mote shares cell -> EAT
    if (w_mote_on_cell(w) == 1) { return A_EAT; }
    // d. mote active -> walk toward nearest
    let m:i32 = w_nearest_mote(w);
    if (m >= 0) { return w_step_toward(w, w.mem[w.base+O_MPOS+m]); }
    // e. else walk home; WAIT if there
    if (w.apos == w.home) { return A_WAIT; }
    return w_step_toward(w, w.home);
}

// reemit6.zag — v6 exact-replication emitter.
// Reads ONLY the v6 knowmap (never the original): RBLMEMv6 knowledge +
// exactness extension (seeds, per-period harmonic amplitudes, f64
// noise residual) + footer.
// mode 10: EXACT re-emit — true seeds, phase-anchored harmonic
//   (grid (j/T0), j = residual index, fixing hear/reemit anchor-slip #2),
//   per-period amplitude, lossless f64 residual. Target: byte-identical PCM.
// mode 11: SEMANTIC ceiling — same fixes but quantized proto[q] instead of
//   the residual: measures what TNN's knowledge alone holds (honest boundary).
// Pure Zag, zero RNG, deterministic.
// argv: 1=v6model.bin 2=mode(10|11) 3=out.wav
@import("../../work/toolchain/R33_NATIVE_IO_V1.zag")

fn r_abs(x:f64) f64 {
    if (x < 0.0) { return 0.0 - x; }
    return x;
}
fn r_rint(x:f64) i64 {
    if (x >= 0.0) { return (x + 0.5) as i64; }
    return 0 - (((0.0 - x) + 0.5) as i64);
}
fn d_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn d_get64(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    let b2:i64 = m[o+2] as i64;
    let b3:i64 = m[o+3] as i64;
    let b4:i64 = m[o+4] as i64;
    let b5:i64 = m[o+5] as i64;
    let b6:i64 = m[o+6] as i64;
    let b7:i64 = m[o+7] as i64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}
fn d_getf64(m:[]u8, o:i64) f64 {
    let f:[]f64 = m as []f64;
    return f[o / 8];
}
fn d_put16(ar:[]u8, o:i64, v:i64) void {
    ar[o] = (v & 255) as u8;
    ar[o+1] = ((v >> 8) & 255) as u8;
    return;
}
fn d_put32(ar:[]u8, o:i64, v:i64) void {
    ar[o] = (v & 255) as u8;
    ar[o+1] = ((v >> 8) & 255) as u8;
    ar[o+2] = ((v >> 16) & 255) as u8;
    ar[o+3] = ((v >> 24) & 255) as u8;
    return;
}
fn read_all(path:[]u8) []u8 {
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    if (fd < 0) { let e:[]u8 = nio_alloc(1); return e; }
    let msz:i64 = _zag_raw_syscall(8, fd, 0, 2, 0, 0, 0);
    _zag_raw_syscall(8, fd, 0, 0, 0, 0, 0);
    let m:[]u8 = nio_alloc(msz as i32);
    let at:i64 = 0;
    while (at < msz) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(m) as i64) + at, msz - at, 0, 0, 0);
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return m;
}
// harmonic bin on hear's grid: ((j/T0) % 1) * NBINS % NBINS, j = residual index
fn harm_bin(j:i64, T0:f64, NBINS:i64) i64 {
    let ph:f64 = (j as f64) / T0;
    let iph:i64 = ph as i64;
    let frac:f64 = ph - (iph as f64);
    return ((frac * (NBINS as f64)) as i64) % NBINS;
}

fn main() void {
    let mpath:[]u8 = d_cstr(_zag_arg(1));
    let a2:[]u8 = _zag_arg(2);
    let mode:i64 = 10;
    if (a2.len > 0) {
        mode = 0;
        let i:i64 = 0;
        while (i < a2.len) {
            let ch:i64 = a2[i] as i64;
            if (ch < 48 or ch > 57) { break; }
            mode = mode*10 + (ch - 48);
            i = i + 1;
        }
    }
    let opath:[]u8 = d_cstr(_zag_arg(3));
    let m:[]u8 = read_all(mpath);
    let msz:i64 = m.len as i64;
    // v6 magic at end-8
    if (msz < 56 or m[msz-8] != 86 or m[msz-7] != 54 or m[msz-6] != 69 or m[msz-5] != 88 or m[msz-4] != 65 or m[msz-3] != 67 or m[msz-2] != 84 or m[msz-1] != 33) {
        _zag_print("reemit6: not a v6 model\n");
        return;
    }
    if (mode != 10 and mode != 11) {
        _zag_print("reemit6: mode must be 10 or 11\n");
        return;
    }
    let n:i64 = d_get64(m, msz-16);
    let P:i64 = d_get64(m, 8);
    let K:i64 = d_get64(m, 16);
    let sr:i64 = d_get64(m, 32);
    let a_off:i64 = 40;
    let proto_off:i64 = a_off + 8*P;
    let bg_off:i64 = proto_off + 8*K;
    let tail:i64 = bg_off + 8*K*K*K;
    let eplen:i64 = d_get64(m, tail+40);
    let EP_off:i64 = tail+48;
    let pT:i64 = d_get64(m, EP_off+8*eplen);
    let T0:f64 = d_getf64(m, EP_off+8*eplen+8);
    let NBINS:i64 = d_get64(m, EP_off+8*eplen+16);
    let plm_off:i64 = EP_off+8*eplen+24;
    let PMF_off:i64 = plm_off+8*NBINS;
    // RBLMEMv6 layout (repaired intake): head[P] i16 between boost and q
    let q_off:i64 = PMF_off + 144 + 2*P;
    let nr:i64 = n - P;
    let ext_start:i64 = q_off + 8*nr;
    let use_h:i64 = d_get64(m, ext_start+8);
    let nper:i64 = d_get64(m, ext_start+16);
    let amp_off:i64 = ext_start + 24;
    let seeds_off:i64 = amp_off + 8*nper;
    let nres_off:i64 = seeds_off + 8*P;
    let hdr_off:i64 = nres_off + 8*nr;
    let hdr_len:i64 = d_get64(m, hdr_off);
    // structural sanity (v6 with stored wav header)
    if (hdr_off + 8 + hdr_len + 16 != msz) {
        _zag_print("reemit6: v6 layout mismatch\n");
        return;
    }
    let EST:[]f64 = nio_alloc((n*8) as i32) as []f64;
    let sout:[]u8 = nio_alloc((n*2) as i32);
    // true seeds (fixes index-slip #4)
    let ri:i64 = 0;
    while (ri < P) {
        EST[ri] = d_get64(m, seeds_off + 8*ri) as f64;
        ri = ri + 1;
    }
    while (ri < n) {
        let j:i64 = ri - P;
        let base:f64 = 0.0;
        if (mode == 10) {
            base = d_getf64(m, nres_off + 8*j);
        } else {
            let qi:i64 = d_get64(m, q_off + 8*j);
            base = d_getf64(m, proto_off + qi*8);
        }
        let h:f64 = 0.0;
        if (use_h == 1) {
            let hb:i64 = harm_bin(j, T0, NBINS);
            h = d_getf64(m, plm_off + hb*8);
            if (mode == 10) {
                // exact path: amplitude-aware harmonic (consistent with
                // the residualizer's nres = res - plm*amp factorization)
                let per:i64 = j / pT;
                if (per >= nper) { per = nper - 1; }
                h = h * d_getf64(m, amp_off + 8*per);
            }
            // mode 11 (semantic): raw plm, consistent with the stored q
            // which hear fitted against res - plm (amp=1)
        }
        let rv:f64 = base + h;
        let pred:f64 = 0.0;
        let k:i64 = 0;
        while (k < P) {
            pred = pred + d_getf64(m, a_off + k*8) * EST[ri-1-k];
            k = k + 1;
        }
        let ev:f64 = pred + rv;
        EST[ri] = ev;
        let s:i64 = r_rint(ev);
        if (s > 32767) { s = 32767; }
        if (s < -32768) { s = -32768; }
        d_put16(sout, 2*ri, s);
        ri = ri + 1;
    }
    // write seeds region samples (rounded, clamped)
    ri = 0;
    while (ri < P) {
        let s:i64 = r_rint(EST[ri]);
        if (s > 32767) { s = 32767; }
        if (s < -32768) { s = -32768; }
        d_put16(sout, 2*ri, s);
        ri = ri + 1;
    }
    // WAV header: the stored container bytes (full-file byte identity,
    // including non-PCM chunks like LIST). The emitter never synthesizes it.
    let hdr:[]u8 = nio_alloc(hdr_len as i32);
    let hi2:i64 = 0;
    while (hi2 < hdr_len) {
        hdr[hi2] = m[hdr_off+8+hi2];
        hi2 = hi2 + 1;
    }
    let fd2:i64 = _zag_raw_syscall(2, _zag_slice_ptr(opath) as i64, 577, 420, 0, 0, 0);
    if (fd2 >= 0) {
        _zag_raw_syscall(1, fd2, _zag_slice_ptr(hdr) as i64, hdr_len, 0, 0, 0);
        let at2:i64 = 0;
        let dlen:i64 = 2*n;
        while (at2 < dlen) {
            let chunk:i64 = dlen - at2;
            if (chunk > 1048576) { chunk = 1048576; }
            let ww:i64 = _zag_raw_syscall(1, fd2, (_zag_slice_ptr(sout) as i64) + at2, chunk, 0, 0, 0);
            if (ww <= 0) { break; }
            at2 = at2 + ww;
        }
        _zag_raw_syscall(3, fd2, 0, 0, 0, 0, 0);
    }
    nio_free(hdr);
    nio_free(m); nio_free(EST); nio_free(sout);
    nio_free(mpath); nio_free(opath);
    return;
}

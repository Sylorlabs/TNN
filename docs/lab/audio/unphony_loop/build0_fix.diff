# BUILD 0 — one-line vibrato-depth fix (NOT APPLIED; loop decides after meter crew weighs in)
#
# Bug: vibrato is implemented as PHASE modulation in units of cycles:
#   phase(t) = f0*t + beta*sin(2*pi*fv*t)   [cycles]
# so peak frequency deviation dF = beta * 2*pi * fv.
# The code computed beta = df/fv (missing 2*pi), making the vibrato
# 2*pi ~= 6.28x deeper than the plan specifies:
#   plan 15 cents @5.5Hz -> intended +/-3.8 Hz, actual +/-24.1 Hz (+/-95 cents),
#   modulation index m = 4.37 rad, carrier nulled, HNR collapsed.
# Fix: beta = df / (2*pi*fv).
#
# Evidence: bit-exact replication renders plan-440Hz at 458.9 Hz (real WAV:
# 455.9-457.6 Hz); with this fix it renders 441.4 Hz; steady-note HNR proxy
# 8.11 dB -> 15.32 dB (no-vibrato ref 15.76 dB). Full detail: build0_audit.txt
--- a/tnn-lab/bytegen/fork_par/src/render_par.zag
+++ b/tnn-lab/bytegen/fork_par/src/render_par.zag
@@ -204,7 +204,10 @@
                     let vibc:f64 = (get64(f, 56) as f64) / 65536.0;
                     let f0:f64 = (get64(f, 16) as f64) / 65536.0;
                     let df:f64 = f0 * (pow2(vibc / 1200.0) - 1.0);
                     let beta:f64 = 0.0;
-                    if (vibhz > 0.001) { beta = df / vibhz; }
+                    // beta is a PHASE deviation in cycles: phase(t) = f0*t + beta*sin(2*pi*fv*t),
+                    // so peak frequency deviation = beta*2*pi*fv. Divide by 2*pi*fv (not fv)
+                    // to realize the planned df. (Was: beta = df/vibhz -> 6.28x too deep,
+                    // m=4.37 rad, nulled carrier, collapsed HNR.)
+                    if (vibhz > 0.001) { beta = df / (6.283185307179586 * vibhz); }
                     evs(ev, nev, 6, (vibhz * 4294967296.0 / (SR as f64)) as i64);
                     evs(ev, nev, 7, (beta * 4294967296.0) as i64);
                     evs(ev, nev, 8, 0);

    mw_add_result(w, "quellar.org", "Petra Halvorsen", 2026);
    mw_add_result(w, "quellar.org", "Petra Halvorsen", 2024);
    mw_add_result(w, "speedway.org", "Dario Mensah", 2026);
    mw_add_result(w, "pitwall.io", "Dario Mensah", 2026);
    mw_add_result(w, "apexwire.com", "Petra Halvorsen", 2025);
    return;
}
fn qR3D_G_19() i32 {
    let w:*MwF=mw_new();
    feedR3D_G_19(w);
    let v:i32=mw_deliberate_d(w);
    mw_fact_end(w);
    _zag_print("V|D|");
    _zag_print("G_19|");
    if(v==1){_zag_print("CONVERGE|");}else{_zag_print("WITHHOLD|");}
    _zag_print(w.*.chosen);_zag_print("|");
    _zag_print(w.*.rule);_zag_print("|");
    _zag_print(mw_chain(w));_zag_print("|");
    if(mw_equal(w.*.rule,"PRIMARY_L")==1){_zag_print(mw_primary_cite_of(w));}else{_zag_print(mw_supp(w,w.*.chosen));}
    _zag_print("|");
    _zag_print(mw_head(w));_zag_println("");
    let ok:i32=1;
    if(v!=1){ok=0;}
    if(mw_equal(w.*.chosen, "Petra Halvorsen")!=1){ok=0;}
    if(mw_equal(w.*.rule, "PRIMARY_L")!=1){ok=0;}
    return ok;
}

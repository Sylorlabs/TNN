// mw_trial_r3d.zag — round-3 arm-D trial driver.
// Usage: mw_trial_r3d <d>
// Deterministic: no timestamps, no RNG. N=5 replays byte-identical.
@import("mw_sense_d.zag")
@import("mw_cases_r3d.zag")

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(mw_equal(m,"d")==1){
        let p:i32=run_r3d_all();
        if(p==1){_zag_println("D|ALL_CHECKS_PASS");}
        if(p!=1){_zag_println("D|CHECKS_FAILED");}
        if(p==1){return 0;}
        return 1;
    }
    _zag_println("usage: mw_trial_r3d <d>");
    return 2;
}

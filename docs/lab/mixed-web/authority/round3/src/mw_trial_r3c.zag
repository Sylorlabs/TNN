// mw_trial_r3c.zag — round-3 arm-C trial driver.
// Usage: mw_trial_r3c <c>
// Deterministic: no timestamps, no RNG. N=5 replays byte-identical.
@import("mw_sense_c.zag")
@import("mw_cases_r3c.zag")

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(mw_equal(m,"c")==1){
        let p:i32=run_r3c_all();
        if(p==1){_zag_println("C|ALL_CHECKS_PASS");}
        if(p!=1){_zag_println("C|CHECKS_FAILED");}
        if(p==1){return 0;}
        return 1;
    }
    _zag_println("usage: mw_trial_r3c <c>");
    return 2;
}

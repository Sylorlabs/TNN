// mw_sense_d.zag — arm D: source-authority weighting, LOOSE variant
// (PREREG-MW-D D1, authorized by AMENDMENT-A1).
// Pure Zag, zero RNG, no timestamps. Arm D = arm B logic + PRIMARY_LOOSE
// evaluated first. PRIMARY_LOOSE fires iff ALL hold (frozen D1):
//   1. exactly one distinct domain's label equals a question token (len>=4),
//      where label = lowercased text before the first "." with leading "www." stripped,
//      and question tokens = lowercase [a-z] runs of length>=4;
//   2. the primary domain's newest answered assertion has recency >= 2000;
//   3. that recency EQUALS the global max recency over all candidates.
// Condition 4 is LOOSENED vs PREREG-MW-C M1: there is NO veto when another
// domain asserts a different answer at the same max recency. The citation
// records the sub-case: cond4=loose-corrob (>=1 distinct other domain asserts
// the same answer) or cond4=loose-unique (no corroboration).
// If PRIMARY_LOOSE fires but arm B would also converge (probed on a scratch
// clone via the frozen mw_deliberate itself, so w's ledger is untouched), arm
// B's verdict stands — PRIMARY_LOOSE only ever converts a withhold, never
// overrides a convergence.
// Otherwise falls back to mw_deliberate verbatim (byte-identical ledger to arm B).
// PRIMARY_LOOSE ledger (op 'D'): f1="PRIMARY_L", f2=chosen, f3=candidate chain
// (arm-B format), f4=citation "primary=<dom> newest=<ans>@<rec> superseded=<a>@<r>,...
// cond4=<loose-corrob|loose-unique>" (no '|' characters, so V-line parsing is unaffected).

@import("mw_sense.zag")

fn mw_isaz(c:u8) i32 {
    let v:i32=c as i32;
    if(v<97){return 0;}
    if(v>122){return 0;}
    return 1;
}

fn mw_lower1(c:u8) u8 {
    let v:i32=c as i32;
    if(v>=65){
        if(v<=90){return (v+32) as u8;}
    }
    return c;
}

fn mw_lower(s:[]u8) []u8 {
    let out:[]u8=mw_alloc(s.len);
    let i:i32=0;
    while(i<s.len){
        out[i]=mw_lower1(s[i]);
        i=i+1;
    }
    return out;
}

fn mw_is_www(d:[]u8) i32 {
    if(d.len<4){return 0;}
    let c0:i32=d[0] as i32;
    let c1:i32=d[1] as i32;
    let c2:i32=d[2] as i32;
    let c3:i32=d[3] as i32;
    if(c0!=119){return 0;}
    if(c1!=119){return 0;}
    if(c2!=119){return 0;}
    if(c3!=46){return 0;}
    return 1;
}

// domain label: text before the first ".", leading "www." stripped
fn mw_label(d:[]u8) []u8 {
    let s:i32=0;
    if(mw_is_www(d)==1){s=4;}
    let e:i32=d.len;
    let i:i32=s;
    let stop:i32=0;
    while(i<d.len){
        if(stop==0){
            let c:i32=d[i] as i32;
            if(c==46){e=i;stop=1;}
        }
        i=i+1;
    }
    return d[s..e];
}

// 1 iff tok (lowercase, len>=4) occurs in q (lowercase) as a full [a-z] token
fn mw_tok_at(q:[]u8,i:i32,tok:[]u8) i32 {
    let L:i32=tok.len;
    if(i+L>q.len){return 0;}
    if(i>0){
        if(mw_isaz(q[i-1])==1){return 0;}
    }
    if(i+L<q.len){
        if(mw_isaz(q[i+L])==1){return 0;}
    }
    return mw_equal(q[i..i+L],tok);
}

fn mw_tok_in_q(q:[]u8,tok:[]u8) i32 {
    if(tok.len<4){return 0;}
    let i:i32=0;
    while(i<q.len){
        if(mw_tok_at(q,i,tok)==1){return 1;}
        i=i+1;
    }
    return 0;
}

// The single primary domain for this question, or empty if not exactly one.
fn mw_primary_dom(w:*MwF) []u8 {
    let q:[]u8=mw_lower(w.*.question);
    let n:i32=w.*.nres;
    let found:[]u8=mw_empty();
    let cnt:i32=0;
    let i:i32=0;
    while(i<n){
        let d:[]u8=mw_r_dom(w,i);
        let seen:i32=0;
        let m:i32=0;
        while(m<i){
            if(mw_equal(mw_r_dom(w,m),d)==1){seen=1;}
            m=m+1;
        }
        if(seen==0){
            let lab:[]u8=mw_lower(mw_label(d));
            if(mw_tok_in_q(q,lab)==1){
                cnt=cnt+1;
                found=d;
            }
        }
        i=i+1;
    }
    if(cnt==1){return found;}
    return mw_empty();
}

// Newest recency among the primary domain's answered assertions (-1 if none).
fn mw_primary_newest_rec(w:*MwF,dom:[]u8) i32 {
    let n:i32=w.*.nres;
    let best:i32=-1;
    let i:i32=0;
    while(i<n){
        if(mw_equal(mw_r_dom(w,i),dom)==1){
            if(mw_r_ans(w,i).len>0){
                let r:i32=mw_r_rec(w,i);
                if(r>best){best=r;}
            }
        }
        i=i+1;
    }
    return best;
}

// First-seen answer of the primary domain at the given recency.
fn mw_primary_newest_ans(w:*MwF,dom:[]u8,rec:i32) []u8 {
    let n:i32=w.*.nres;
    let i:i32=0;
    while(i<n){
        if(mw_equal(mw_r_dom(w,i),dom)==1){
            if(mw_r_rec(w,i)==rec){
                if(mw_r_ans(w,i).len>0){return mw_r_ans(w,i);}
            }
        }
        i=i+1;
    }
    return mw_empty();
}

// Condition 4, LOOSENED per AMENDMENT-A1 (PREREG-MW-D D1.4): no veto.
// Returns 1 if >=1 distinct other domain asserts the same answer (sub-case
// recorded as loose-corrob), else 2 (loose-unique). Never 0 — an equally-new
// contradiction no longer blocks the primary domain's newest word.
fn mw_primary_cond4(w:*MwF,dom:[]u8,ans:[]u8,gmax:i32) i32 {
    let n:i32=w.*.nres;
    let i:i32=0;
    while(i<n){
        if(mw_equal(mw_r_dom(w,i),dom)==0){
            if(mw_equal(mw_r_ans(w,i),ans)==1){return 1;}
        }
        i=i+1;
    }
    return 2;
}

fn mw_cite_puts(out:[]u8,o:i32,s:[]u8) i32 {
    mw_copy(out,o,s);
    return o+s.len;
}

fn mw_cite_puti(out:[]u8,o:i32,v:i32) i32 {
    let s:[]u8=_zag_i64_to_str(v as i64);
    mw_copy(out,o,s);
    return o+s.len;
}

// PRIMARY_LOOSE citation: primary=<dom> newest=<ans>@<rec> superseded=<a>@<r>,... cond4=<loose-corrob|loose-unique>
fn mw_primary_cite(w:*MwF,dom:[]u8,ans:[]u8,rec:i32,basis:i32) []u8 {
    let out:[]u8=mw_alloc(1024);
    let o:i32=0;
    o=mw_cite_puts(out,o,"primary=");
    o=mw_cite_puts(out,o,dom);
    o=mw_cite_puts(out,o," newest=");
    o=mw_cite_puts(out,o,ans);
    o=mw_cite_puts(out,o,"@");
    o=mw_cite_puti(out,o,rec);
    o=mw_cite_puts(out,o," superseded=");
    let n:i32=w.*.nres;
    let i:i32=0;
    let got:i32=0;
    let skip_done:i32=0;
    while(i<n){
        if(mw_equal(mw_r_dom(w,i),dom)==1){
            let a:[]u8=mw_r_ans(w,i);
            if(a.len>0){
                let r:i32=mw_r_rec(w,i);
                let is_newest:i32=0;
                if(skip_done==0){
                    if(r==rec){is_newest=1;skip_done=1;}
                }
                if(is_newest==0){
                    if(got>0){o=mw_cite_puts(out,o,",");}
                    o=mw_cite_puts(out,o,a);
                    o=mw_cite_puts(out,o,"@");
                    o=mw_cite_puti(out,o,r);
                    got=got+1;
                }
            }
        }
        i=i+1;
    }
    if(got==0){o=mw_cite_puts(out,o,"-");}
    o=mw_cite_puts(out,o," cond4=loose-");
    if(basis==1){o=mw_cite_puts(out,o,"corrob");}
    if(basis==2){o=mw_cite_puts(out,o,"unique");}
    return out[0..o];
}

// Recompute the PRIMARY citation for the V-line (same inputs -> same string).
fn mw_primary_cite_of(w:*MwF) []u8 {
    let dom:[]u8=mw_primary_dom(w);
    let rp:i32=mw_primary_newest_rec(w,dom);
    let a:[]u8=mw_primary_newest_ans(w,dom,rp);
    let nc:i32=w.*.ncand;
    let g:i32=0;
    let c:i32=0;
    while(c<nc){
        let r2:i32=mw_c_r(w,c);
        if(r2>g){g=r2;}
        c=c+1;
    }
    let b:i32=mw_primary_cond4(w,dom,a,g);
    return mw_primary_cite(w,dom,a,rp,b);
}

// Probe: what would frozen arm-B logic decide, without touching w's ledger?
// Runs mw_deliberate on a scratch clone (shared result slices, fresh candidate
// table, ledger forked from w's current head and then discarded).
fn mw_b_probe(w:*MwF) i32 {
    let wb:*MwF=mw_new();
    wb.*.temporal=w.*.temporal;
    wb.*.nres=w.*.nres;
    wb.*.qid=w.*.qid;
    wb.*.question=w.*.question;
    wb.*.rs=w.*.rs;
    let l:*MwL=w.*.lg;
    let nlg:*MwL=_zag_malloc(64) as *MwL;
    let pv:[]u8=mw_alloc(32);
    let sp:[]u8=l.*.prev;
    let i:i32=0;
    while(i<32){pv[i]=sp[i];i=i+1;}
    nlg.*.prev=pv;
    nlg.*.seq=l.*.seq;
    wb.*.lg=nlg;
    return mw_deliberate(wb);
}

// Arm-D deliberation: PRIMARY_LOOSE first, then frozen arm-B logic verbatim.
fn mw_deliberate_d(w:*MwF) i32 {
    mw_build_cands(w);
    let dom:[]u8=mw_primary_dom(w);
    if(dom.len==0){return mw_deliberate(w);}
    let rp:i32=mw_primary_newest_rec(w,dom);
    if(rp<2000){return mw_deliberate(w);}
    let nc:i32=w.*.ncand;
    let g:i32=0;
    let c:i32=0;
    while(c<nc){
        let r2:i32=mw_c_r(w,c);
        if(r2>g){g=r2;}
        c=c+1;
    }
    if(rp!=g){return mw_deliberate(w);}
    let a:[]u8=mw_primary_newest_ans(w,dom,rp);
    if(a.len==0){return mw_deliberate(w);}
    let b:i32=mw_primary_cond4(w,dom,a,g);
    if(b==0){return mw_deliberate(w);}
    if(mw_b_probe(w)==1){return mw_deliberate(w);}
    w.*.rule="PRIMARY_L";
    w.*.chosen=a;
    w.*.verdict=1;
    let cite:[]u8=mw_primary_cite(w,dom,a,rp,b);
    mw_ledger(w,68,w.*.rule,w.*.chosen,mw_chain(w),cite);
    return 1;
}

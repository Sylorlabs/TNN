// mw_sense_e.zag — arm E: authority as a TIEBREAK / secondary signal
// (PREREG-MW-D E1, authorized by AMENDMENT-A1).
// Pure Zag, zero RNG, no timestamps. Arm E runs frozen arm-B deliberation
// VERBATIM first (its verdict and ledger entry are written). Only if arm B
// WITHHOLDS does the loose authority rule (PREREG-MW-D D1.1–D1.3) get
// consulted as a secondary signal: if the loose conditions hold, a tiebreak
// ledger entry is appended and the verdict becomes CONVERGE with rule
// "PRIMARY_TB". Authority never speaks first in arm E.
// Reuses the primary-domain helpers from mw_sense_d.zag (loose cond4).

@import("mw_sense_d.zag")

// Arm-E deliberation: arm B verbatim, then the authority tiebreak.
fn mw_deliberate_e(w:*MwF) i32 {
    let v:i32=mw_deliberate(w);
    if(v!=2){return v;}
    let dom:[]u8=mw_primary_dom(w);
    if(dom.len==0){return v;}
    let rp:i32=mw_primary_newest_rec(w,dom);
    if(rp<2000){return v;}
    let nc:i32=w.*.ncand;
    let g:i32=0;
    let c:i32=0;
    while(c<nc){
        let r2:i32=mw_c_r(w,c);
        if(r2>g){g=r2;}
        c=c+1;
    }
    if(rp!=g){return v;}
    let a:[]u8=mw_primary_newest_ans(w,dom,rp);
    if(a.len==0){return v;}
    let b:i32=mw_primary_cond4(w,dom,a,g);
    w.*.rule="PRIMARY_TB";
    w.*.chosen=a;
    w.*.verdict=1;
    let cite:[]u8=mw_primary_cite(w,dom,a,rp,b);
    mw_ledger(w,68,w.*.rule,w.*.chosen,mw_chain(w),cite);
    return 1;
}

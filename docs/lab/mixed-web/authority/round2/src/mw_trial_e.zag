// mw_trial_e.zag — arm-E trial driver.
// Usage: mw_trial_e <e>
//   e: arm E (deliberation + authority tiebreak as secondary signal, mw_sense_e)
// Per-question run/check functions are GENERATED (mw_cases_e.zag).
// Deterministic: no timestamps, no RNG. N=5 replays must be byte-identical.

@import("mw_sense_e.zag")
@import("mw_cases_e.zag")

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(mw_equal(m,"e")==1){
        let p:i32=run_e_all();
        if(p==1){_zag_println("E|ALL_CHECKS_PASS");}
        if(p!=1){_zag_println("E|CHECKS_FAILED");}
        if(p==1){return 0;}
        return 1;
    }
    _zag_println("usage: mw_trial_e <e>");
    return 2;
}

    ws_add_result(w, "wikipedia.org", "Pyramid - Wikipedia", "The Great Pyramid of Giza is the largest in Egypt and one of the largest in the world. At 146.6 metres (481 ft) it was the tallest structure in the world until the Lincoln Cathedral was finished in 1311 AD.", "https://en.wikipedia.org/wiki/Pyramid", "Great Pyramid of Giza", 1, "98b4d4c5b9ac196552fe9d5c56247a0f516939a51e7e12b37eddd0a101ccff6d");
    return;
}

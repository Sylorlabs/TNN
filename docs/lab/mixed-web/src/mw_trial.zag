// mw_trial.zag — mixed-web trial driver.
// Usage: mw_trial <a|b|all>
//   a: arm A (withhold-only baseline, ws2_sense decide verbatim, mode 1)
//   b: arm B (deliberation with logic, mw_sense)
//   all: both arms
// Per-question run/check functions are GENERATED (mw_cases.zag).
// Deterministic: no timestamps, no RNG. N=5 replays must be byte-identical.

@import("ws2_sense.zag")
@import("mw_sense.zag")
@import("mw_cases.zag")

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(z_equal(m,"a")==1){
        run_a_all();
        _zag_println("A|DONE");
        return 0;
    }
    if(z_equal(m,"b")==1){
        let p:i32=run_b_all();
        if(p==1){_zag_println("B|ALL_CHECKS_PASS");}
        if(p!=1){_zag_println("B|CHECKS_FAILED");}
        if(p==1){return 0;}
        return 1;
    }
    if(z_equal(m,"all")==1){
        run_a_all();
        _zag_println("A|DONE");
        let p2:i32=run_b_all();
        if(p2==1){_zag_println("B|ALL_CHECKS_PASS");}
        if(p2!=1){_zag_println("B|CHECKS_FAILED");}
        if(p2==1){return 0;}
        return 1;
    }
    _zag_println("usage: mw_trial <a|b|all>");
    return 2;
}

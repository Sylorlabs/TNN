// Linux x86-64 port of the Darwin descriptor-rooted adapter.
// PORT MAP: fstatat 339 -> fstat 5; getuid 24 -> 102; getrusage 117 -> 98.
// Linux struct stat: st_mode u16@24, st_nlink u64@16, st_uid u32@28.
// Linux ru_maxrss is KiB (Darwin: bytes) -> multiplied by 1024.
// Linux ENAMETOOLONG=36 (Darwin 63) added to the path-error set.
@import("common.zag")

struct CLUsage {status:i32,cpu_us:i64,rss_bytes:i64}
fn st_u64(b:[]u8,at:i32)i64 {
    let v:i64=0;let i:i32=0;
    while(i<8){v=v+((b[at+i] as i64)<<(i*8));i=i+1;}
    return v;
}
fn cl_errno(raw:i64)i32 {
    if(raw>=0){return 0;}
    if(raw==-2 || raw==-13 || raw==-17 || raw==-20 || raw==-21 || raw==-36 || raw==-40 || raw==-62){return cl_path();}
    if(raw==-22 || raw==-45 || raw==-78){return cl_abi();}
    return cl_io();
}
fn cl_stat(fd:i64,directory:i32)i32 {
    let st:[]u8=nio_alloc(256);if(st.len!=256){return cl_io();}
    let rc:i64=_zag_raw_syscall(5,fd,_zag_slice_ptr(st) as i64,0,0,0,0);
    if(rc!=0){nio_free(st);return cl_errno(rc);}
    let mode:i32=(st[24] as i32)+((st[25] as i32)<<8);
    let links:i64=st_u64(st,16);
    let uid:i64=_zag_raw_syscall(102,0,0,0,0,0,0);
    let want:i32=32768;if(directory==1){want=16384;}
    let ok:i32=((mode & 61440)==want && uid>=0 && cl_u32(st,28)==uid) as i32;
    if(directory==0 && (links!=1 || (mode & 511)!=384)){ok=0;}
    nio_free(st);if(ok!=1){return cl_path();}return 0;
}
fn cl_root(path:[]u8)i64 {
    if(path.len>4095){return cl_path();}
    let fd:i64=nio_open_root(path);if(fd<0){return cl_errno(fd);}
    let rc:i32=cl_stat(fd,1);if(rc!=0){nio_close(fd);return rc;}return fd;
}
fn cl_open(root:i64,leaf:[]u8,create:i32)i64 {
    if(root<0 || nio_name_valid(leaf)!=1 || (create!=0 && create!=1)){return cl_path();}
    // O_NONBLOCK avoids blocking before fstat on malicious FIFO/device paths.
    let fd:i64=nio_open_child(root,leaf,create);if(fd<0){return cl_path();}
    let rc:i32=cl_stat(fd,0);if(rc!=0){nio_close(fd);return rc;}return fd;
}
fn cl_file_write(root:i64,leaf:[]u8,data:[]u8)i32 {
    if(data.len<1 || data.len>cl_max()){return cl_bound();}
    let fd:i64=cl_open(root,leaf,1);if(fd<0 || cl_is_status(fd)==1){return fd as i32;}
    let rc:i32=0;
    if(nio_write_all(fd,data)!=data.len || nio_sync(fd)!=0){rc=cl_io();}
    if(nio_close(fd)!=0){rc=cl_io();}
    if(rc==0 && nio_sync(root)!=0){rc=cl_io();}return rc;
}
fn cl_file_read(root:i64,leaf:[]u8,out:[]u8)i32 {
    if(out.len<1 || out.len>cl_max()){return cl_bound();}
    let fd:i64=cl_open(root,leaf,0);if(fd<0 || cl_is_status(fd)==1){return fd as i32;}
    let n:i64=nio_read_exact(fd,out,out.len);let c:i64=nio_close(fd);
    if(n<0){return cl_corrupt();}if(c!=0){return cl_io();}return n as i32;
}
fn cl_usage()CLUsage {
    // Linux rusage: two 16-byte timevals followed by 64-bit ru_maxrss (KiB).
    let p:*i64=_zag_malloc(144) as *i64;
    if(p==null as *i64){return CLUsage{.status=cl_io(),.cpu_us=-1,.rss_bytes=-1};}
    let rc:i64=_zag_raw_syscall(98,0,p as i64,0,0,0,0);
    let cpu:i64=-1;let rss:i64=-1;
    if(rc==0){cpu=p[0]*1000000+p[1]+p[2]*1000000+p[3];rss=p[4]*1024;}
    _zag_free(p as *i8);return CLUsage{.status=cl_errno(rc),.cpu_us=cpu,.rss_bytes=rss};
}
fn cl_guard()i32 {
    // Native wall timer, CPU/file/descriptor ceilings. RSS is observed, not
    // mislabeled as an enforced Darwin address-space ceiling.
    if(nio_guard(20)!=0){return cl_io();}return 0;
}

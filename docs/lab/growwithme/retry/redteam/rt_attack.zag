@import("../src/companion.zag")

// ============================================================================
// rt_attack.zag — Crew 3 red-team attack harness (pure Zag, zero RNG).
//
// Uses the COMMITTED M3 mechanism (src/companion.zag) unmodified: installs
// controlled facts via fact_install and probes via answer_question.
// Each attack prints ATTACK <id> || <verdict-class> || <answer-head>.
//
// Attacks:
//   A1 near-neighbor tie: two facts identical except payload digit.
//   A2 demand-word injection: distractor shares question's generic words.
//   A3 installed-trap (F1-01/F1-20 replay): "installed" in distractor wins.
//   A4 store-size sweep: k generic distractors; first tie/wrong threshold.
// Deterministic: rerun must be byte-identical.
// ============================================================================

fn new_agent()Agent {
    let ag:Agent=Agent{.facts=nio_alloc(8),.ftext=nio_alloc(8),.fkw=nio_alloc(8),.fbg=nio_alloc(8),.regs=nio_alloc(8),.rtext=nio_alloc(8),.recs=nio_alloc(8),.trace=nio_alloc(8),.stage_fid=nio_alloc(0),.stage_txt=nio_alloc(0),.cites=nio_alloc(8),.nfact=0,.npend=0,.nfh=0,.ncs=0,.arm=0,.sess=0,.tid=0,.aid=0};
    return ag;
}

fn ask(ag:*Agent, id:[]u8, q:[]u8)void {
    let out:[]u8=nio_alloc(4096);
    let n:i32=answer_question(ag,q,out,2);
    _zag_print(id); _zag_print(" || ");
    // classify by leading bytes
    let head:[]u8=out;
    if(n>72){ let tmp:[]u8=nio_alloc(72); let i:i32=0; while(i<72){tmp[i]=out[i]; i=i+1;} head=tmp; }
    _zag_print(head); _zag_print("\n");
    nio_free(out);
    return;
}

fn install(ag:*Agent, fid:[]u8, text:[]u8)void {
    fact_install(ag,fid,text,1,0,-1,-1);
    return;
}

fn main()void {
    // ---- A1: near-neighbor tie ----
    let ag1:Agent=new_agent(); agent_init(&ag1,0);
    install(&ag1,"T-01","The vault code is 1234.");
    install(&ag1,"T-02","The vault code is 5678.");
    ask(&ag1,"A1","What is the vault code?");
    // ---- A2: demand-word injection ----
    let ag2:Agent=new_agent(); agent_init(&ag2,0);
    install(&ag2,"T-10","The ledger supports sealed truncation at session boundaries.");
    install(&ag2,"T-11","The audit ledger records every consolidation decision with provenance.");
    install(&ag2,"T-12","Audit entries are 16 words with stage at word 52.");
    ask(&ag2,"A2","Describe the audit ledger's write semantics.");
    // ---- A3: installed-trap (F1-01/F1-20 shape) ----
    let ag3:Agent=new_agent(); agent_init(&ag3,0);
    install(&ag3,"T-20","The pinned tool lives at /opt/lab/tool/bin/zt.");
    install(&ag3,"T-21","All builds must use the pinned tool; a system-wide installed copy is unsupported.");
    ask(&ag3,"A3","Give the complete path where the pinned tool is installed.");
    // ---- A4: store-size sweep ----
    // distractors share "audit ledger" vocabulary; truth is T-30
    let k:i32=1;
    while(k<=12){
        let ag:Agent=new_agent(); agent_init(&ag,0);
        install(&ag,"T-30","The ledger supports sealed truncation at session boundaries.");
        let j:i32=0;
        while(j<k){
            // distractor j: shares "audit ledger", different payload
            // (unrolled variants to stay deterministic without formatting)
            if(j==0){ install(&ag,"D-00","The audit ledger records every consolidation decision."); }
            if(j==1){ install(&ag,"D-01","The audit ledger keeps a correction-state mirror."); }
            if(j==2){ install(&ag,"D-02","The audit ledger snapshots its state at boundaries."); }
            if(j==3){ install(&ag,"D-03","The audit ledger drops tier-0 records at the sweep."); }
            if(j==4){ install(&ag,"D-04","The audit ledger tracks which facts have pending corrections."); }
            if(j==5){ install(&ag,"D-05","The audit ledger emits a white-box trace per decision."); }
            if(j==6){ install(&ag,"D-06","The audit ledger is scanned for installed unverified claims."); }
            if(j==7){ install(&ag,"D-07","The audit ledger lists every strong-memory overwrite."); }
            if(j==8){ install(&ag,"D-08","The audit ledger never leaks the plant ledger to the scorer."); }
            if(j==9){ install(&ag,"D-09","The audit ledger binds each entry to its session id."); }
            if(j==10){ install(&ag,"D-10","The audit ledger marks promotion decisions at stage 9."); }
            if(j==11){ install(&ag,"D-11","The audit ledger carries the promotion evidence code."); }
            j=j+1;
        }
        let out:[]u8=nio_alloc(4096);
        let n:i32=answer_question(&ag,"Describe the audit ledger's write semantics.",out,2);
        _zag_print("A4 k="); _zag_print(_zag_i64_to_str(k as i64)); _zag_print(" || ");
        let h:[]u8=out; if(n>60){ let t:[]u8=nio_alloc(60); let i:i32=0; while(i<60){t[i]=out[i]; i=i+1;} h=t; }
        _zag_print(h); _zag_print("\n");
        nio_free(out);
        k=k+1;
    }
    _zag_println("attacks complete");
    return;
}

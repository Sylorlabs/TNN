@import("src/companion.zag")

// ============================================================================
// runner.zag — grow-with-me Phase 2 deterministic replay driver.
// (See header in previous version; rewritten here with full driver.)
// Usage: runner <arm> <runtag> <outdir>
// ============================================================================

fn streq(a:[]u8,b:[]u8)i32 { return slice_eq(a,b); }

fn mkpath(path:[]u8)void {
    let p:[]u8=z_cstr(path);
    _zag_raw_syscall(83,(_zag_slice_ptr(p) as i64),493,0,0,0,0);
    nio_free(p);
    return;
}
fn join3(dir:[]u8, name:[]u8, out:[]u8)i32 {
    let at:i32=emit(out,0,dir);
    out[at]=47; at=at+1;
    at=emit(out,at,name);
    return at;
}
// copy a path into a fresh buffer (for read_all which needs its own)
fn path_of(dir:[]u8, name:[]u8)[]u8 {
    let b:[]u8=nio_alloc(512);
    let n:i32=join3(dir,name,b);
    return b[0..n];
}
// Administer a .q probe file: for each "Q || <text>" line, answer and append
// "A || <answer>\n" to out. Returns total length appended.
fn administer(ag:*Agent, qpath:[]u8, out:[]u8, at:i32) i32 {
    let data:[]u8=read_all(qpath);
    let i:i32=0;
    let nlines:i32=0;
    while(i<data.len){
        let s:i32=i;
        while(i<data.len && data[i]!=10){i=i+1;}
        let line:[]u8=data[s..i];
        if(i<data.len){i=i+1;}
        if(line.len>5 && slice_eq(line[0..5],"Q || ")==1){
            let q:[]u8=line[5..line.len];
            let ab:[]u8=nio_alloc(8192);
            let al:i32=answer_question(ag,q,ab,2);
            at=emit(out,at,"A || ");
            // single-line the answer (replace newlines with spaces)
            let k:i32=0;
            while(k<al){
                let c:u8=ab[k];
                if(c==10){out[at]=32;}else{out[at]=c;}
                at=at+1; k=k+1;
            }
            out[at]=10; at=at+1;
            nio_free(ab);
            nlines=nlines+1;
        }
    }
    return at;
}
// Process one session .in file. Appends chat Q/A to chatlog. Returns chatlog len.
fn process_session(ag:*Agent, inpath:[]u8, chatlog:[]u8, at:i32) i32 {
    let data:[]u8=read_all(inpath);
    let i:i32=0;
    let ab:[]u8=nio_alloc(8192);
    while(i<data.len){
        let s:i32=i;
        while(i<data.len && data[i]!=10){i=i+1;}
        let line:[]u8=data[s..i];
        if(i<data.len){i=i+1;}
        if(line.len==0){continue;}
        // CHAT / CORR need logging; others go through agent_line
        if(line.len>6 && slice_eq(line[0..5],"CHAT ")==1){
            // "CHAT T<n> || <text>"
            let flds:[]u8=nio_alloc(8*8);
            let nf:i32=split_fields(line,flds,8);
            let head:[]u8=fld(line,flds,0);
            let tid:[]u8=head[5..head.len];
            let text:[]u8=fld(line,flds,1);
            let al:i32=answer_chat(ag,text,ab);
            at=emit(chatlog,at,tid);
            at=emit(chatlog,at," || Q: ");
            at=emit(chatlog,at,text);
            at=emit(chatlog,at," || A: ");
            let k:i32=0;
            while(k<al){let c:u8=ab[k]; if(c==10){chatlog[at]=32;}else{chatlog[at]=c;} at=at+1;k=k+1;}
            chatlog[at]=10; at=at+1;
            nio_free(flds);
        }else{
            if(line.len>6 && slice_eq(line[0..5],"CORR ")==1){
                // "CORR <cid> <tgt> || <claim>"
                let flds2:[]u8=nio_alloc(8*8);
                let nf2:i32=split_fields(line,flds2,8);
                let head2:[]u8=fld(line,flds2,0);
                let rest:[]u8=head2[5..head2.len];
                let sp:i32=0;
                while(sp<rest.len && rest[sp]!=32){sp=sp+1;}
                let cid:[]u8=rest[0..sp];
                let tgt:[]u8=rest[sp+1..rest.len];
                let claim:[]u8=fld(line,flds2,1);
                let al2:i32=apply_correction(ag,cid,tgt,claim,ab);
                at=emit(chatlog,at,cid);
                at=emit(chatlog,at," || Q: [correction -> ");
                at=emit(chatlog,at,tgt);
                at=emit(chatlog,at,"] ");
                at=emit(chatlog,at,claim);
                at=emit(chatlog,at," || A: ");
                let k2:i32=0;
                while(k2<al2){let c2:u8=ab[k2]; if(c2==10){chatlog[at]=32;}else{chatlog[at]=c2;} at=at+1;k2=k2+1;}
                chatlog[at]=10; at=at+1;
                nio_free(flds2);
            }else{
                let r:i32=agent_line(ag,line,ab);
                // FACT/TAG/CS/SESSION/END need no logging
            }
        }
    }
    nio_free(ab);
    return at;
}

fn run_all(ag:*Agent, outdir:[]u8, inputs:[]u8, probes:[]u8)void {
    let s:i32=1;
    while(s<=6){
        // M3 retry placement (explicit; see BUILD_LOG.md): the S4 dependency
        // pre-basic probes are administered immediately BEFORE S4 input
        // processing. Frozen protocol says "administered at S4" for pairs
        // P1/P3/P5/P6 whose basics arrive in S5; the prereg calls them
        // "pre-basic". This is the strictest pre-basic placement: the agent's
        // state is exactly post-S3-consolidation, so no S4-taught fact
        // (incl. the S4 dependency-As for P2/P4) can enter the pre-probe
        // candidate sets. It matches the Phase 2 BUILD.md fix record
        // ("moved to immediately before S4 input processing"); the on-disk
        // Phase 2 runner administered them after S4 input + immediate probes
        // but before consolidation, contradicting that record — the retry
        // does not silently inherit the inconsistency.
        if(s==4){
            let pq0:[]u8=path_of(probes,"dependency_pre_S4.q");
            let pa0:[]u8=nio_alloc(32768);
            let pl0:i32=administer(ag,pq0,pa0,0);
            let pp0:[]u8=path_of(outdir,"probe_dependency_pre.txt");
            write_file(pp0,pa0[0..pl0]);
        }
        // session input path: inputs/S<s>.in
        let sn:[]u8=nio_alloc(8);
        sn[0]=83; sn[1]=(48+s) as u8; // "S<s>"
        let inname:[]u8=nio_alloc(16);
        let il:i32=emit(inname,0,sn[0..2]);
        il=emit(inname,il,".in");
        let inpath:[]u8=path_of(inputs,inname[0..il]);
        let chatlog:[]u8=nio_alloc(65536);
        let cl:i32=process_session(ag,inpath,chatlog,0);
        // write chat log
        let cname:[]u8=nio_alloc(32);
        let cnl:i32=emit(cname,0,"chat_S");
        cnl=emit_i64(cname,cnl,s as i64);
        cnl=emit(cname,cnl,".txt");
        let cpath:[]u8=path_of(outdir,cname[0..cnl]);
        write_file(cpath,chatlog[0..cl]);
        // immediate probes
        let qn2:[]u8=nio_alloc(32);
        let ql:i32=emit(qn2,0,"immediate_S");
        ql=emit_i64(qn2,ql,s as i64);
        ql=emit(qn2,ql,".q");
        let qpath:[]u8=path_of(probes,qn2[0..ql]);
        let ans:[]u8=nio_alloc(131072);
        let al:i32=administer(ag,qpath,ans,0);
        let aname:[]u8=nio_alloc(40);
        let anl:i32=emit(aname,0,"probe_immediate_S");
        anl=emit_i64(aname,anl,s as i64);
        anl=emit(aname,anl,".txt");
        let apath:[]u8=path_of(outdir,aname[0..anl]);
        write_file(apath,ans[0..al]);
        // (dependency pre-basic probes are administered before S4 input; see top of loop)
        // consolidate at the session boundary
        consolidate(ag);
        // snapshot
        let snap:[]u8=nio_alloc(524288);
        let sl:i32=write_snapshot(ag,snap);
        let sname:[]u8=nio_alloc(32);
        let snl:i32=emit(sname,0,"snapshot_S");
        snl=emit_i64(sname,snl,s as i64);
        snl=emit(sname,snl,".txt");
        let spath:[]u8=path_of(outdir,sname[0..snl]);
        write_file(spath,snap[0..sl]);
        s=s+1;
    }
    // ---- S7 probe-only battery (frozen order) ----
    ag_set_sess(ag,7); // the S7 snapshot must be labeled S7, not S6
    // 1. full recall (108)
    let b1:[]u8=nio_alloc(524288);
    let l1:i32=administer(ag,path_of(probes,"S7_recall.q"),b1,0);
    write_file(path_of(outdir,"probe_S7_recall.txt"),b1[0..l1]);
    // 2. post-basic dependency (6)
    let b2:[]u8=nio_alloc(65536);
    let l2:i32=administer(ag,path_of(probes,"dependency_post_S7.q"),b2,0);
    write_file(path_of(outdir,"probe_dependency_post.txt"),b2[0..l2]);
    // 3. composition (12)
    let b3:[]u8=nio_alloc(131072);
    let l3:i32=administer(ag,path_of(probes,"composition.q"),b3,0);
    write_file(path_of(outdir,"probe_composition.txt"),b3[0..l3]);
    // 4. corrections (6)
    let b4:[]u8=nio_alloc(65536);
    let l4:i32=administer(ag,path_of(probes,"corrections.q"),b4,0);
    write_file(path_of(outdir,"probe_corrections.txt"),b4[0..l4]);
    // 5. PENDING (6)
    let b5:[]u8=nio_alloc(65536);
    let l5:i32=administer(ag,path_of(probes,"pending.q"),b5,0);
    write_file(path_of(outdir,"probe_pending.txt"),b5[0..l5]);
    // 6. falsehoods (6)
    let b6:[]u8=nio_alloc(65536);
    let l6:i32=administer(ag,path_of(probes,"falsehoods.q"),b6,0);
    write_file(path_of(outdir,"probe_falsehoods.txt"),b6[0..l6]);
    // 7. contradiction resolution (3)
    let b7:[]u8=nio_alloc(65536);
    let l7:i32=administer(ag,path_of(probes,"contradiction_resolution.q"),b7,0);
    write_file(path_of(outdir,"probe_contradiction.txt"),b7[0..l7]);
    // final snapshot (post-S7 store state)
    let fsnap:[]u8=nio_alloc(524288);
    let fl:i32=write_snapshot(ag,fsnap);
    write_file(path_of(outdir,"snapshot_S7.txt"),fsnap[0..fl]);
    return;
}

fn main()void {
    let arm_s:[]u8=_zag_arg(1);
    let runtag:[]u8=_zag_arg(2);
    let outdir:[]u8=_zag_arg(3);
    let arm:i32=arm_from_arg(arm_s);
    if(arm<0 || runtag.len==0 || outdir.len==0){
        _zag_println("usage: runner <D|N|A> <runtag> <outdir>");
        return;
    }
    mkpath(outdir);
    let ag:Agent=Agent{.facts=nio_alloc(8),.ftext=nio_alloc(8),.fkw=nio_alloc(8),.fbg=nio_alloc(8),.regs=nio_alloc(8),.rtext=nio_alloc(8),.recs=nio_alloc(8),.trace=nio_alloc(8),.stage_fid=nio_alloc(0),.stage_txt=nio_alloc(0),.cites=nio_alloc(8),.nfact=0,.npend=0,.nfh=0,.ncs=0,.arm=0,.sess=0,.tid=0,.aid=0};
    agent_init(&ag, arm);
    let inputs:[]u8="inputs";
    let probes:[]u8="probes";
    run_all(&ag, outdir, inputs, probes);
    _zag_println("run complete");
    return;
}

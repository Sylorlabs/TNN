@import("R33_NATIVE_IO_V1.zag")

// ============================================================================
// companion.zag — grow-with-me Phase 2 research-companion agent
//
// Provenance:
//   - Byte/string/arena helpers adapted from the ADOPTED dialogue round-4
//     intake stack: docs/lab/dialogue/round4/dialogue.zag
//     @ commit 0298f31c236f5fa7a4943b7c4eef13a364adf41e
//     (adoption record: docs/lab/dialogue/round4/ADOPTED.md).
//   - Adopted round-4 mechanisms honored here (adapted to this trial's
//     machinery, not transplanted verbatim — per-mechanism accounting in
//     BUILD.md): G6 untaught-predicate gate (withhold when nothing taught
//     covers the question); G7 as negation-challenge (planted-claim
//     rejection; round-4's role-order machinery is not present here);
//     correction-state mirror (tombstoned versions never answered again);
//     scoped deletion (correction erase is record-scoped, provenance kept);
//     units from taught facts (keywords/bigrams extracted from the fact's
//     own text at install; answers composed from taught units only).
//     NOT carried over: the unified entity scanner/gazetteer and the
//     deterministic non-repeating request server (no use for either in
//     this trial). Byte/string helpers (is_alnum, slice_eq, stem,
//     stopwords, tokenize) adapted from the round-4 stack to slice style.
//   - Trial semantics: docs/lab/growwithme/PREREG.md
//     @ 6e15c93144564c870e536e3446d76382fb73ff83 (frozen).
//   - Frozen fixtures: docs/lab/growwithme/frozen/
//     @ df3f77c3bee77ff189688d1cee07c8b98bcb3ca6.
//
// Arms (selected via _zag_arg(1)): D = deliberate consolidation/promotion/
// strengthening with white-box traces; N = verbatim hoard, uniform strength;
// A = D machinery present, all consolidation/promotion/strengthening forced
// to no-op. Pure Zag, deterministic, zero RNG.
// ============================================================================

// ---------------- byte helpers (from adopted round-4 stack) ----------------
fn is_alnum(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8; b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8; b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    let v:i64=(b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
    return v;
}
fn p64(b:[]u8,at:i32,v:i64)void {
    p32(b,at,v&4294967295); p32(b,at+4,(v>>32)&4294967295);
    return;
}
fn g64(b:[]u8,at:i32)i64 {
    let lo:i64=g32(b,at); let hi:i64=g32(b,at+4);
    return lo|(hi<<32);
}
fn copy_bytes(dst:[]u8,dat:i32,src:[]u8,sat:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[dat+i]=src[sat+i];i=i+1;}
    return;
}
fn slice_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn starts_with(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    return slice_eq(s[0..pre.len],pre);
}
fn ends_with(s:[]u8,suf:[]u8)i32 {
    if(s.len<suf.len){return 0;}
    return slice_eq(s[s.len-suf.len..s.len],suf);
}
// first index of needle in hay, or -1
fn find_sub(hay:[]u8,needle:[]u8)i32 {
    if(needle.len==0){return 0;}
    if(hay.len<needle.len){return -1;}
    let i:i32=0;
    while(i<=hay.len-needle.len){
        if(slice_eq(hay[i..i+needle.len],needle)){return i;}
        i=i+1;
    }
    return -1;
}
// decimal of v into buf (needs >=24 bytes); returns length
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0; let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){buf[at]=((x%10)+48) as u8;x=x/10;at=at-1;}
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1; let n:i32=24-start; let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn dbg_i64(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    nio_free(b);
    return;
}

// ---------------- file IO (raw syscalls; from adopted round-4 stack) ----------------
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    copy_bytes(b,0,s,0,s.len);
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0; let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{copy_bytes(buf,total,chk,0,nb);total=total+nb;}
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}
// O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644 = 420
fn write_file(path:[]u8,data:[]u8)i32 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),577,420,0,0,0);
    nio_free(p);
    if(fd<0){return -1;}
    let total:i32=0; let go:i32=1;
    while(go==1){
        if(total>=data.len){go=0;}
        else{
            let w:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+(total as i64),((data.len-total) as i64),0,0,0);
            if(w==-4){go=1;}
            else{if(w<=0){go=0;}else{total=total+(w as i32);}}
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(total!=data.len){return -2;}
    return 0;
}

// ---------------- hashing ----------------
fn fnv1a(s:[]u8)i64 {
    let h:i64=0-3750763034362895579; // 14695981039346656037 as i64 (wraps)
    let i:i32=0;
    while(i<s.len){
        h=h^(s[i] as i64);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}

// ---------------- agent state ----------------
// Fact slot: 64 bytes. Offsets (i32 LE):
//  0 fid_off  4 fid_len  8 txt_off 12 txt_len 16 status 20 tier 24 sess
// 28 tagk    32 pair     36 link    40 kw_off 44 kw_n    48 bg_off 52 bg_n
// 56 rec     60 ver
// status: 0 installed-clean. tagk: 0 clean 1 depa 2 depb 3 review
// pair: 0..5 dependency pair index, -1 none. link: fact idx or -1.
// Reg slot (pending/falsehood/CS): 32 bytes.
//  0 id_off  4 id_len  8 txt_off 12 txt_len 16 aux0 20 aux1 24 aux2 28 aux3
struct Agent {
    facts: []u8, ftext: []u8, fkw: []u8, fbg: []u8,
    regs: []u8, rtext: []u8, recs: []u8, trace: []u8,
    stage_fid: []u8, stage_txt: []u8, cites: []u8,
    nfact: i32, npend: i32, nfh: i32, ncs: i32,
    arm: i32, sess: i32, tid: i32, aid: i32,
}
fn ag_cites(ag:*Agent)[]u8 { let a:[]u8=ag.*.cites; return a; }
// record a citation: fact idx cited via channel (1=chat,2=probe) in session
fn cite_add(ag:*Agent, fidx:i32, channel:i32, sess:i32)void {
    let c:[]u8=ag_cites(ag);
    let u:i32=g32(c,0) as i32;
    p32(c,4+u,fidx as i64); p32(c,4+u+4,channel as i64); p32(c,4+u+8,sess as i64);
    p32(c,0,(u+12) as i64);
    return;
}
// count cites of fact fidx via channel in sess
fn cite_count(ag:*Agent, fidx:i32, channel:i32, sess:i32)i32 {
    let c:[]u8=ag_cites(ag);
    let u:i32=g32(c,0) as i32;
    let n:i32=0; let o:i32=0;
    while(o<u){
        if(g32(c,4+o)==fidx as i64 && g32(c,4+o+4)==channel as i64 && g32(c,4+o+8)==sess as i64){n=n+1;}
        o=o+12;
    }
    return n;
}
// bump-append bytes into arena (used counter at [0..4)); returns data offset
fn bump_put(a:[]u8, s:[]u8)i32 {
    let u:i32=g32(a,0) as i32;
    copy_bytes(a,4+u,s,0,s.len);
    p32(a,0,(u+s.len) as i64);
    return 4+u;
}
fn bump_used(a:[]u8)i32 { return g32(a,0) as i32; }

// field accessors through *Agent (ZNC-004/010 safe: via *T param, never &local)
fn ag_facts(ag:*Agent)[]u8 { let a:[]u8=ag.*.facts; return a; }
fn ag_ftext(ag:*Agent)[]u8 { let a:[]u8=ag.*.ftext; return a; }
fn ag_fkw(ag:*Agent)[]u8 { let a:[]u8=ag.*.fkw; return a; }
fn ag_fbg(ag:*Agent)[]u8 { let a:[]u8=ag.*.fbg; return a; }
fn ag_regs(ag:*Agent)[]u8 { let a:[]u8=ag.*.regs; return a; }
fn ag_rtext(ag:*Agent)[]u8 { let a:[]u8=ag.*.rtext; return a; }
fn ag_recs(ag:*Agent)[]u8 { let a:[]u8=ag.*.recs; return a; }
fn ag_trace(ag:*Agent)[]u8 { let a:[]u8=ag.*.trace; return a; }
fn ag_nfact(ag:*Agent)i32 { return ag.*.nfact; }
fn ag_arm(ag:*Agent)i32 { return ag.*.arm; }
fn ag_sess(ag:*Agent)i32 { return ag.*.sess; }
fn ag_set_nfact(ag:*Agent,v:i32)void { ag.*.nfact=v; return; }
fn ag_set_sess(ag:*Agent,v:i32)void { ag.*.sess=v; return; }
fn ag_next_tid(ag:*Agent)i32 { let t:i32=ag.*.tid; ag.*.tid=t+1; return t; }
fn ag_next_aid(ag:*Agent)i32 { let t:i32=ag.*.aid; ag.*.aid=t+1; return t; }

// ---------------- tokenizer / keywords ----------------
// Stopwords: closed-class + interrogative + auxiliary vocabulary.
// (The agent's retrieval ignores these; content words carry the signal.)
fn is_stop(w:[]u8)i32 {
    if(slice_eq(w,"the")){return 1;} if(slice_eq(w,"a")){return 1;}
    if(slice_eq(w,"an")){return 1;} if(slice_eq(w,"is")){return 1;}
    if(slice_eq(w,"are")){return 1;} if(slice_eq(w,"was")){return 1;}
    if(slice_eq(w,"were")){return 1;} if(slice_eq(w,"be")){return 1;}
    if(slice_eq(w,"been")){return 1;} if(slice_eq(w,"being")){return 1;}
    if(slice_eq(w,"to")){return 1;} if(slice_eq(w,"of")){return 1;}
    if(slice_eq(w,"and")){return 1;} if(slice_eq(w,"or")){return 1;}
    if(slice_eq(w,"in")){return 1;} if(slice_eq(w,"on")){return 1;}
    if(slice_eq(w,"at")){return 1;} if(slice_eq(w,"for")){return 1;}
    if(slice_eq(w,"with")){return 1;} if(slice_eq(w,"by")){return 1;}
    if(slice_eq(w,"from")){return 1;} if(slice_eq(w,"as")){return 1;}
    if(slice_eq(w,"it")){return 1;} if(slice_eq(w,"its")){return 1;}
    if(slice_eq(w,"this")){return 1;} if(slice_eq(w,"that")){return 1;}
    if(slice_eq(w,"these")){return 1;} if(slice_eq(w,"those")){return 1;}
    if(slice_eq(w,"i")){return 1;} if(slice_eq(w,"you")){return 1;}
    if(slice_eq(w,"he")){return 1;} if(slice_eq(w,"she")){return 1;}
    if(slice_eq(w,"we")){return 1;} if(slice_eq(w,"they")){return 1;}
    if(slice_eq(w,"my")){return 1;} if(slice_eq(w,"your")){return 1;}
    if(slice_eq(w,"his")){return 1;} if(slice_eq(w,"her")){return 1;}
    if(slice_eq(w,"our")){return 1;} if(slice_eq(w,"their")){return 1;}
    if(slice_eq(w,"me")){return 1;} if(slice_eq(w,"him")){return 1;}
    if(slice_eq(w,"us")){return 1;} if(slice_eq(w,"them")){return 1;}
    if(slice_eq(w,"what")){return 1;} if(slice_eq(w,"which")){return 1;}
    if(slice_eq(w,"who")){return 1;} if(slice_eq(w,"whom")){return 1;}
    if(slice_eq(w,"whose")){return 1;} if(slice_eq(w,"when")){return 1;}
    if(slice_eq(w,"where")){return 1;} if(slice_eq(w,"why")){return 1;}
    if(slice_eq(w,"how")){return 1;} if(slice_eq(w,"can")){return 1;}
    if(slice_eq(w,"could")){return 1;} if(slice_eq(w,"should")){return 1;}
    if(slice_eq(w,"would")){return 1;} if(slice_eq(w,"do")){return 1;}
    if(slice_eq(w,"does")){return 1;} if(slice_eq(w,"did")){return 1;}
    if(slice_eq(w,"done")){return 1;} if(slice_eq(w,"have")){return 1;}
    if(slice_eq(w,"has")){return 1;} if(slice_eq(w,"had")){return 1;}
    if(slice_eq(w,"not")){return 1;} if(slice_eq(w,"no")){return 1;}
    if(slice_eq(w,"yes")){return 1;} if(slice_eq(w,"if")){return 1;}
    if(slice_eq(w,"then")){return 1;} if(slice_eq(w,"than")){return 1;}
    if(slice_eq(w,"so")){return 1;} if(slice_eq(w,"such")){return 1;}
    if(slice_eq(w,"into")){return 1;} if(slice_eq(w,"over")){return 1;}
    if(slice_eq(w,"under")){return 1;} if(slice_eq(w,"between")){return 1;}
    if(slice_eq(w,"through")){return 1;} if(slice_eq(w,"during")){return 1;}
    if(slice_eq(w,"before")){return 1;} if(slice_eq(w,"after")){return 1;}
    if(slice_eq(w,"above")){return 1;} if(slice_eq(w,"below")){return 1;}
    if(slice_eq(w,"up")){return 1;} if(slice_eq(w,"down")){return 1;}
    if(slice_eq(w,"out")){return 1;} if(slice_eq(w,"off")){return 1;}
    if(slice_eq(w,"again")){return 1;} if(slice_eq(w,"further")){return 1;}
    if(slice_eq(w,"once")){return 1;} if(slice_eq(w,"here")){return 1;}
    if(slice_eq(w,"there")){return 1;} if(slice_eq(w,"all")){return 1;}
    if(slice_eq(w,"any")){return 1;} if(slice_eq(w,"both")){return 1;}
    if(slice_eq(w,"each")){return 1;} if(slice_eq(w,"few")){return 1;}
    if(slice_eq(w,"more")){return 1;} if(slice_eq(w,"most")){return 1;}
    if(slice_eq(w,"other")){return 1;} if(slice_eq(w,"some")){return 1;}
    if(slice_eq(w,"only")){return 1;} if(slice_eq(w,"own")){return 1;}
    if(slice_eq(w,"same")){return 1;} if(slice_eq(w,"too")){return 1;}
    if(slice_eq(w,"very")){return 1;} if(slice_eq(w,"just")){return 1;}
    if(slice_eq(w,"now")){return 1;} if(slice_eq(w,"also")){return 1;}
    if(slice_eq(w,"may")){return 1;} if(slice_eq(w,"might")){return 1;}
    if(slice_eq(w,"must")){return 1;} if(slice_eq(w,"shall")){return 1;}
    if(slice_eq(w,"will")){return 1;} if(slice_eq(w,"am")){return 1;}
    if(slice_eq(w,"s")){return 1;} if(slice_eq(w,"t")){return 1;}
    if(slice_eq(w,"d")){return 1;} if(slice_eq(w,"ll")){return 1;}
    if(slice_eq(w,"re")){return 1;} if(slice_eq(w,"ve")){return 1;}
    return 0;
}
// Simple deterministic stemmer. Returns length of stemmed form written to out
// (out must have >= w.len+1 bytes). Rules: ies->y, ing/ed/es/s/ly stripping
// with minimum-length guards.
fn stem(w:[]u8,out:[]u8)i32 {
    let n:i32=w.len;
    copy_bytes(out,0,w,0,n);
    if(n>4 && ends_with(w,"ies")){ out[n-3]=121; return n-2; } // "y"
    if(n>5 && ends_with(w,"ing")){ return n-3; }
    if(n>4 && ends_with(w,"ed")){ return n-2; }
    if(n>4 && ends_with(w,"es")){ return n-2; }
    if(n>3 && ends_with(w,"s") && !ends_with(w,"ss")){ return n-1; }
    if(n>5 && ends_with(w,"ly")){ return n-2; }
    return n;
}
// Tokenize text into stemmed content-word hashes.
// Writes sorted+deduplicated i64 hashes into out (out has cap i64 slots).
// Returns count. Uses scratch buffer sb (needs >= 256 bytes).
fn tokenize(text:[]u8,out:[]u8,cap:i32,sb:[]u8)i32 {
    let n:i32=0;
    let i:i32=0;
    let wb:[]u8=nio_alloc(128);
    while(i<text.len){
        // skip non-alnum
        while(i<text.len && is_alnum(text[i])==0){i=i+1;}
        if(i>=text.len){break;}
        let s:i32=i;
        while(i<text.len && is_alnum(text[i])==1){i=i+1;}
        let w:[]u8=text[s..i];
        // lowercase into wb
        let k:i32=0;
        while(k<w.len){wb[k]=to_low(w[k]);k=k+1;}
        let wl:[]u8=wb[0..w.len];
        if(is_stop(wl)==0){
            let sl:i32=stem(wl,sb);
            let h:i64=fnv1a(sb[0..sl]);
            if(n<cap){ p64(out,n*8,h); n=n+1; }
        }
    }
    nio_free(wb);
    // insertion sort
    let a:i32=1;
    while(a<n){
        let key:i64=g64(out,a*8);
        let b:i32=a-1;
        while(b>=0 && g64(out,b*8)>key){ p64(out,(b+1)*8,g64(out,b*8)); b=b-1; }
        p64(out,(b+1)*8,key);
        a=a+1;
    }
    // dedupe
    let w2:i32=0; let r:i32=0;
    while(r<n){
        if(w2==0 || g64(out,(w2-1)*8)!=g64(out,r*8)){ p64(out,w2*8,g64(out,r*8)); w2=w2+1; }
        r=r+1;
    }
    return w2;
}
// Build sorted bigram hashes (consecutive stemmed content words).
fn bigrams(text:[]u8,out:[]u8,cap:i32,sb:[]u8,sb2:[]u8)i32 {
    // first collect stemmed words
    let words:[]u8=nio_alloc(64*8);
    let nw:i32=0;
    let i:i32=0;
    let wb:[]u8=nio_alloc(128);
    while(i<text.len){
        while(i<text.len && is_alnum(text[i])==0){i=i+1;}
        if(i>=text.len){break;}
        let s:i32=i;
        while(i<text.len && is_alnum(text[i])==1){i=i+1;}
        let w:[]u8=text[s..i];
        let k:i32=0;
        while(k<w.len){wb[k]=to_low(w[k]);k=k+1;}
        let wl:[]u8=wb[0..w.len];
        if(is_stop(wl)==0 && nw<64){
            let sl:i32=stem(wl,sb);
            p64(words,nw*8,fnv1a(sb[0..sl]));
            nw=nw+1;
        }
    }
    nio_free(wb);
    let n:i32=0;
    let j:i32=0;
    while(j+1<nw){
        let h:i64=g64(words,j*8)*31+g64(words,(j+1)*8);
        if(n<cap){ p64(out,n*8,h); n=n+1; }
        j=j+1;
    }
    nio_free(words);
    // sort + dedupe
    let a:i32=1;
    while(a<n){
        let key:i64=g64(out,a*8);
        let b:i32=a-1;
        while(b>=0 && g64(out,b*8)>key){ p64(out,(b+1)*8,g64(out,b*8)); b=b-1; }
        p64(out,(b+1)*8,key);
        a=a+1;
    }
    let w2:i32=0; let r:i32=0;
    while(r<n){
        if(w2==0 || g64(out,(w2-1)*8)!=g64(out,r*8)){ p64(out,w2*8,g64(out,r*8)); w2=w2+1; }
        r=r+1;
    }
    return w2;
}
// count of shared hashes between sorted arrays a (na) and b (nb)
fn shared_count(a:[]u8,na:i32,b:[]u8,nb:i32)i32 {
    let c:i32=0; let i:i32=0; let j:i32=0;
    while(i<na && j<nb){
        let x:i64=g64(a,i*8); let y:i64=g64(b,j*8);
        if(x==y){c=c+1;i=i+1;j=j+1;}
        else{if(x<y){i=i+1;}else{j=j+1;}}
    }
    return c;
}
// jaccard similarity x1000 between sorted hash arrays
fn jaccard(a:[]u8,na:i32,b:[]u8,nb:i32)i32 {
    if(na==0 && nb==0){return 1000;}
    let sh:i32=shared_count(a,na,b,nb);
    let un:i32=na+nb-sh;
    if(un==0){return 1000;}
    return (sh*1000)/un;
}

// ---------------- fact store ----------------
fn fact_slot(ag:*Agent, idx:i32) i32 { return idx*64; }
fn fget(ag:*Agent, idx:i32, off:i32)i64 {
    let s:[]u8=ag_facts(ag);
    return g32(s, idx*64+off);
}
fn fset(ag:*Agent, idx:i32, off:i32, v:i64)void {
    let s:[]u8=ag_facts(ag);
    p32(s, idx*64+off, v);
    return;
}
fn fact_text(ag:*Agent, idx:i32)[]u8 {
    let t:[]u8=ag_ftext(ag);
    let o:i32=fget(ag,idx,8) as i32; let l:i32=fget(ag,idx,12) as i32;
    return t[o..o+l];
}
fn fact_fid(ag:*Agent, idx:i32)[]u8 {
    let t:[]u8=ag_ftext(ag);
    let o:i32=fget(ag,idx,0) as i32; let l:i32=fget(ag,idx,4) as i32;
    return t[o..o+l];
}
// install a clean fact; returns fact idx
fn fact_install(ag:*Agent, fid:[]u8, text:[]u8, sess:i32, tagk:i32, pair:i32, link:i32)i32 {
    let idx:i32=ag_nfact(ag);
    let t:[]u8=ag_ftext(ag);
    let fo:i32=bump_put(t,fid);
    let to:i32=bump_put(t,text);
    fset(ag,idx,0,fo as i64); fset(ag,idx,4,fid.len as i64);
    fset(ag,idx,8,to as i64); fset(ag,idx,12,text.len as i64);
    fset(ag,idx,16,0); fset(ag,idx,20,0); fset(ag,idx,24,sess as i64);
    fset(ag,idx,28,tagk as i64); fset(ag,idx,32,pair as i64); fset(ag,idx,36,link as i64);
    // keywords
    let k:[]u8=ag_fkw(ag);
    let kb:[]u8=nio_alloc(64*8);
    let sb:[]u8=nio_alloc(256);
    let kn:i32=tokenize(text,kb,64,sb);
    let ko:i32=bump_used(k);
    let q:i32=0;
    while(q<kn){ let u:i32=g32(k,0) as i32; p64(k,4+u,g64(kb,q*8)); p32(k,0,(u+8) as i64); q=q+1; }
    nio_free(kb); nio_free(sb);
    fset(ag,idx,40,(4+ko) as i64); fset(ag,idx,44,kn as i64);
    // bigrams
    let g:[]u8=ag_fbg(ag);
    let gb:[]u8=nio_alloc(64*8);
    let sb2:[]u8=nio_alloc(256); let sb3:[]u8=nio_alloc(256);
    let gn:i32=bigrams(text,gb,64,sb2,sb3);
    let go:i32=bump_used(g);
    q=0;
    while(q<gn){ let u:i32=g32(g,0) as i32; p64(g,4+u,g64(gb,q*8)); p32(g,0,(u+8) as i64); q=q+1; }
    nio_free(gb); nio_free(sb2); nio_free(sb3);
    fset(ag,idx,48,(4+go) as i64); fset(ag,idx,52,gn as i64);
    fset(ag,idx,56,idx as i64); // own record initially
    fset(ag,idx,60,1);          // version 1
    ag_set_nfact(ag, idx+1);
    return idx;
}
fn fact_find(ag:*Agent, fid:[]u8)i32 {
    let n:i32=ag_nfact(ag);
    let i:i32=0;
    while(i<n){ if(slice_eq(fact_fid(ag,i),fid)==1){return i;} i=i+1; }
    return -1;
}
// ---------------- registries (PENDING / falsehood / CS) ----------------
// One slot array; ranges: pend 0..15, falsehood 16..31, CS 32..47.
// Slot 32B: 0 id_off 4 id_len 8 txt_off 12 txt_len 16 aux0 20 aux1 24 aux2 28 aux3
// All three registries share one aux contract (reader: reg_kw):
//   aux0(slot16) = entry index, aux1(slot20) = kw_off (byte offset into fkw
//   arena), aux2(slot24) = kw_n (keyword count), aux3(slot28) = 0.
fn reg_slot(ag:*Agent, sidx:i32, off:i32)i64 {
    let r:[]u8=ag_regs(ag);
    return g32(r, sidx*32+off);
}
fn reg_set(ag:*Agent, sidx:i32, off:i32, v:i64)void {
    let r:[]u8=ag_regs(ag);
    p32(r, sidx*32+off, v);
    return;
}
fn reg_text(ag:*Agent, sidx:i32)[]u8 {
    let t:[]u8=ag_rtext(ag);
    let o:i32=reg_slot(ag,sidx,8) as i32; let l:i32=reg_slot(ag,sidx,12) as i32;
    return t[o..o+l];
}
fn reg_id(ag:*Agent, sidx:i32)[]u8 {
    let t:[]u8=ag_rtext(ag);
    let o:i32=reg_slot(ag,sidx,0) as i32; let l:i32=reg_slot(ag,sidx,4) as i32;
    return t[o..o+l];
}
fn reg_put(ag:*Agent, sidx:i32, id:[]u8, text:[]u8, a0:i64, a1:i64, a2:i64, a3:i64)void {
    let t:[]u8=ag_rtext(ag);
    let io:i32=bump_put(t,id); let to:i32=bump_put(t,text);
    reg_set(ag,sidx,0,io as i64); reg_set(ag,sidx,4,id.len as i64);
    reg_set(ag,sidx,8,to as i64); reg_set(ag,sidx,12,text.len as i64);
    reg_set(ag,sidx,16,a0); reg_set(ag,sidx,20,a1);
    reg_set(ag,sidx,24,a2); reg_set(ag,sidx,28,a3);
    return;
}
// extract keyword hashes of text into the fkw arena; returns (off<<32)|n
fn kw_extract(ag:*Agent, text:[]u8)i64 {
    let k:[]u8=ag_fkw(ag);
    let kb:[]u8=nio_alloc(64*8);
    let sb:[]u8=nio_alloc(256);
    let kn:i32=tokenize(text,kb,64,sb);
    let ko:i32=bump_used(k);
    let q:i32=0;
    while(q<kn){ let u:i32=g32(k,0) as i32; p64(k,4+u,g64(kb,q*8)); p32(k,0,(u+8) as i64); q=q+1; }
    nio_free(kb); nio_free(sb);
    return (((4+ko) as i64)<<32)|(kn as i64);
}
fn kw_off(packed:i64)i32 { return (packed>>32) as i32; }
fn kw_n(packed:i64)i32 { return (packed&4294967295) as i32; }
fn pend_add(ag:*Agent, pid:[]u8, text:[]u8)void {
    let n:i32=ag.*.npend;
    let pk:i64=kw_extract(ag,text);
    reg_put(ag, n, pid, text, n as i64, pk>>32, pk&4294967295, 0);
    ag.*.npend=n+1;
    return;
}
fn fh_add(ag:*Agent, xid:[]u8, text:[]u8)void {
    let n:i32=ag.*.nfh;
    let pk:i64=kw_extract(ag,text);
    reg_put(ag, 16+n, xid, text, n as i64, pk>>32, pk&4294967295, 0);
    ag.*.nfh=n+1;
    return;
}
fn cs_add(ag:*Agent, csid:[]u8, text:[]u8)void {
    let n:i32=ag.*.ncs;
    let pk:i64=kw_extract(ag,text);
    // layout contract (see reg_kw): aux0(slot16)=index, aux1(slot20)=kw_off,
    // aux2(slot24)=kw_n. pend_add/fh_add follow it; cs_add used to be off by
    // one slot (kw_off->16, kw_n->20), which zeroed every CS keyword read.
    reg_put(ag, 32+n, csid, text, n as i64, pk>>32, pk&4294967295, 0);
    ag.*.ncs=n+1;
    return;
}
// keyword array of a registry slot (aux1=kw_off byte offset, aux2=kw_n)
fn reg_kw(ag:*Agent, sidx:i32, out:[]u8) i32 {
    let k:[]u8=ag_fkw(ag);
    let o:i32=reg_slot(ag,sidx,20) as i32; let n:i32=reg_slot(ag,sidx,24) as i32;
    let i:i32=0;
    while(i<n){ p64(out,i*8,g64(k,o+i*8)); i=i+1; }
    return n;
}

// ---------------- retrieval & answering ----------------
// Adopted round-4 mechanisms in force:
//   G6: if no stored fact teaches the question's demanded predicate, withhold.
//   G7 (negation-challenge): a question asserting a planted falsehood is
//       rejected, never answered from the planted claim. (Round-4's
//       role-order machinery is not present in this trial; see BUILD.md.)
//   Units: answers are composed from taught-fact units, installed verbatim.
// Score question against installed facts; returns best idx (or -1).
// qkw = sorted hash array (caller-provided, 64 slots). Also fills top3.
fn score_facts(ag:*Agent, qkw:[]u8, qn:i32, top3:[]u8) i32 {
    let n:i32=ag_nfact(ag);
    let k:[]u8=ag_fkw(ag);
    let best:i32=-1; let bs:i32=0;
    let t0:i32=-1; let s0:i32=-1;
    let t1:i32=-1; let s1:i32=-1;
    let t2:i32=-1; let s2:i32=-1;
    let i:i32=0;
    while(i<n){
        if(fget(ag,i,16)==0){
            let ko:i32=fget(ag,i,40) as i32; let kn:i32=fget(ag,i,44) as i32;
            let s:i32=shared_count(qkw,qn,k[ko..ko+kn*8],kn);
            if(s>bs){bs=s;best=i;}
            // top-3 (insertion)
            if(s>s0){t2=t1;s2=s1;t1=t0;s1=s0;t0=i;s0=s;}
            else{if(s>s1){t2=t1;s2=s1;t1=i;s1=s;}
            else{if(s>s2){t2=i;s2=s;}}}
        }
        i=i+1;
    }
    p32(top3,0,t0 as i64); p32(top3,4,s0 as i64);
    p32(top3,8,t1 as i64); p32(top3,12,s1 as i64);
    p32(top3,16,t2 as i64); p32(top3,20,s2 as i64);
    if(bs==0){return -1;}
    return best;
}
// Score question against a registry range [base, base+cnt).
fn score_reg(ag:*Agent, qkw:[]u8, qn:i32, base:i32, cnt:i32) i32 {
    let k:[]u8=ag_fkw(ag);
    let kb:[]u8=nio_alloc(64*8);
    let best:i32=-1; let bs:i32=0;
    let i:i32=0;
    while(i<cnt){
        let sidx:i32=base+i;
        let rn:i32=reg_kw(ag,sidx,kb);
        let s:i32=shared_count(qkw,qn,kb,rn);
        if(s>bs){bs=s;best=sidx;}
        i=i+1;
    }
    nio_free(kb);
    return best; // -1 if none; caller re-scores for the value if needed
}
fn reg_score_val(ag:*Agent, qkw:[]u8, qn:i32, sidx:i32)i32 {
    let k:[]u8=ag_fkw(ag);
    let kb:[]u8=nio_alloc(64*8);
    let rn:i32=reg_kw(ag,sidx,kb);
    let s:i32=shared_count(qkw,qn,kb,rn);
    nio_free(kb);
    return s;
}
// append s to out at *at; returns new at
fn emit(out:[]u8, at:i32, s:[]u8)i32 {
    copy_bytes(out,at,s,0,s.len);
    return at+s.len;
}
fn emit_i64(out:[]u8, at:i32, v:i64)i32 {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    copy_bytes(out,at,b,0,n);
    nio_free(b);
    return at+n;
}
// ---------------- white-box traces & audit ledger ----------------
// Trace format (one line per decision):
// TRACE <tid> || kind=<kind> || ref=<ref> || considered=<...> ||
//   evidence=<...> || verdict=<...> || reason=<...>
// The verdict is a PURE function of the recorded evidence fields, so the
// red-team intervention audit (neuter evidence -> re-run deliberation ->
// verdict must change) is well-defined. See BUILD.md for the decision fns.
fn trace_line(ag:*Agent, tid:i32, kind:[]u8, ref:[]u8, considered:[]u8, evidence:[]u8, verdict:[]u8, reason:[]u8)void {
    let t:[]u8=ag_trace(ag);
    let b:[]u8=nio_alloc(4096);
    let at:i32=0;
    at=emit(b,at,"TRACE ");
    at=emit_i64(b,at,tid as i64);
    at=emit(b,at," || kind=");
    at=emit(b,at,kind);
    at=emit(b,at," || ref=");
    at=emit(b,at,ref);
    at=emit(b,at," || considered=");
    at=emit(b,at,considered);
    at=emit(b,at," || evidence=");
    at=emit(b,at,evidence);
    at=emit(b,at," || verdict=");
    at=emit(b,at,verdict);
    at=emit(b,at," || reason=");
    at=emit(b,at,reason);
    at=emit(b,at,"\n");
    bump_put(t,b[0..at]);
    nio_free(b);
    return;
}
// short helper for simple traces
fn trace_emit(ag:*Agent, tid:i32, kind:[]u8, ref:[]u8)void {
    trace_line(ag,tid,kind,ref,"{auto}","{auto}","{auto}","auto-emitted");
    return;
}
// Audit ledger entry (G3): every correction pays the full erase price here.
// AUDIT <aid> || op=<op> || target=<fid> || tier_before=<n> || price=<...> || note=<...>
fn audit_line(ag:*Agent, aid:i32, op:[]u8, target:[]u8, tier_before:i32, price:[]u8, note:[]u8)void {
    // audit shares the trace arena (append-only, tamper-evident by order)
    let t:[]u8=ag_trace(ag);
    let b:[]u8=nio_alloc(4096);
    let at:i32=0;
    at=emit(b,at,"AUDIT ");
    at=emit_i64(b,at,aid as i64);
    at=emit(b,at," || op=");
    at=emit(b,at,op);
    at=emit(b,at," || target=");
    at=emit(b,at,target);
    at=emit(b,at," || tier_before=");
    at=emit_i64(b,at,tier_before as i64);
    at=emit(b,at," || price=");
    at=emit(b,at,price);
    at=emit(b,at," || note=");
    at=emit(b,at,note);
    at=emit(b,at,"\n");
    bump_put(t,b[0..at]);
    nio_free(b);
    return;
}

// Full answering pipeline. Writes answer to out, returns length.
// Order: PENDING leak-check -> falsehood rejection -> CS resolution ->
//        dep-B withhold -> factual answer. G6 withhold if nothing matches.
fn answer_question(ag:*Agent, qtext:[]u8, out:[]u8, channel:i32)i32 {
    let at:i32=0;
    let qkw:[]u8=nio_alloc(64*8);
    let sb:[]u8=nio_alloc(256);
    let qn:i32=tokenize(qtext,qkw,64,sb);
    nio_free(sb);
    let top3:[]u8=nio_alloc(24);
    let bf:i32=score_facts(ag,qkw,qn,top3);
    let bfs:i32=0;
    if(bf>=0){
        let k:[]u8=ag_fkw(ag);
        let kb:[]u8=nio_alloc(64*8);
        let ko:i32=fget(ag,bf,40) as i32; let kn:i32=fget(ag,bf,44) as i32;
        let qi:i32=0;
        while(qi<qn){p64(kb,qi*8,g64(qkw,qi*8));qi=qi+1;}
        bfs=shared_count(kb,qn,k[ko..ko+kn*8],kn);
        nio_free(kb);
    }
    // PENDING registry
    let bp:i32=-1; let bps:i32=0;
    if(ag.*.npend>0){
        bp=score_reg(ag,qkw,qn,0,ag.*.npend);
        if(bp>=0){bps=reg_score_val(ag,qkw,qn,bp);}
    }
    // falsehood registry
    let bh:i32=-1; let bhs:i32=0;
    if(ag.*.nfh>0){
        bh=score_reg(ag,qkw,qn,16,ag.*.nfh);
        if(bh>=0){bhs=reg_score_val(ag,qkw,qn,bh);}
    }
    // CS registry
    let bc:i32=-1; let bcs:i32=0;
    if(ag.*.ncs>0){
        bc=score_reg(ag,qkw,qn,32,ag.*.ncs);
        if(bc>=0){bcs=reg_score_val(ag,qkw,qn,bc);}
    }
    nio_free(qkw);
    // record citations for promotion deliberation (chat=1, probe=2)
    if(channel==1 || channel==2){
        if(bf>=0){cite_add(ag,bf,channel,ag_sess(ag));}
        if(bhs>=3 && bhs>bfs){
            let ct0:i32=g32(top3,0) as i32;
            let ct1:i32=g32(top3,8) as i32;
            if(ct0>=0){cite_add(ag,ct0,channel,ag_sess(ag));}
            if(ct1>=0 && ct1!=ct0){cite_add(ag,ct1,channel,ag_sess(ag));}
        }
        if(bcs>=3 && bcs>bfs){
            let dt0:i32=g32(top3,0) as i32;
            let dt1:i32=g32(top3,8) as i32;
            if(dt0>=0){cite_add(ag,dt0,channel,ag_sess(ag));}
            if(dt1>=0 && dt1!=dt0){cite_add(ag,dt1,channel,ag_sess(ag));}
        }
    }
    // G6: nothing teaches this
    if(bf<0 && bps<3 && bhs<3 && bcs<3){
        at=emit(out,at,"I don't have a taught fact covering this; withholding rather than confabulating.");
        nio_free(top3);
        return at;
    }
    // H5 PENDING leak-check: claim asked about directly -> withhold, never state as fact
    if(bps>=3 && bps>bfs){
        at=emit(out,at,"Withheld -- unverified: ");
        at=emit(out,at,reg_text(ag,bp));
        at=emit(out,at," Held as PENDING (single-source, no corroboration); never installed and never stated as fact.");
        nio_free(top3);
        return at;
    }
    // Falsehood rejection (G7 negation-challenge: the question asserts the planted claim)
    if(bhs>=3 && bhs>bfs && bhs>=bps){
        at=emit(out,at,"No -- rejected. The claim contradicts taught facts and was never installed. Taught facts stand: ");
        let t0:i32=g32(top3,0) as i32;
        let t1:i32=g32(top3,8) as i32;
        if(t0>=0){at=emit(out,at,fact_text(ag,t0));}
        if(t1>=0 && t1!=t0){at=emit(out,at," ");at=emit(out,at,fact_text(ag,t1));}
        nio_free(top3);
        return at;
    }
    // CS contradiction resolution
    if(bcs>=3 && bcs>bfs){
        let csid:[]u8=reg_id(ag,bc);
        let tid:i32=ag_next_tid(ag);
        trace_emit(ag,tid,"cs-resolve",csid);
        at=emit(out,at,"Conflict detected (");
        at=emit(out,at,csid);
        at=emit(out,at,"): ");
        at=emit(out,at,reg_text(ag,bc));
        at=emit(out,at," Resolution: the taught facts stand on earlier provenance -- ");
        let t0:i32=g32(top3,0) as i32;
        let t1:i32=g32(top3,8) as i32;
        if(t0>=0){at=emit(out,at,fact_text(ag,t0));}
        if(t1>=0 && t1!=t0){at=emit(out,at," ");at=emit(out,at,fact_text(ag,t1));}
        at=emit(out,at," Deliberation trace: detected (contradiction with taught facts), weighed (earlier provenance vs single unvetted source), resolved (source rejected, never installed; standing facts unchanged). Never silently adopted, never silently overwritten.");
        nio_free(top3);
        return at;
    }
    // dep-B withhold (G6): advanced taught but basics not yet installed
    if(bf>=0 && fget(ag,bf,28)==2){
        let lk:i32=fget(ag,bf,36) as i32;
        if(lk<0){
            let pr:i32=fget(ag,bf,32) as i32;
            at=emit(out,at,"Withheld -- the basics for this (dependency pair P");
            at=emit_i64(out,at,(pr+1) as i64);
            at=emit(out,at,") have not been taught yet. B-source-only restatement, flagged as uninterpretable without the basics: ");
            at=emit(out,at,fact_text(ag,bf));
            nio_free(top3);
            return at;
        }
    }
    // Factual answer from taught units. If best fact is in a dep pair with
    // partner installed, give the integrated answer (both units).
    if(bf>=0){
        let lk:i32=fget(ag,bf,36) as i32;
        let tk:i32=fget(ag,bf,28) as i32;
        if((tk==1 || tk==2) && lk>=0){
            // integrated: basics first, then advanced
            if(tk==2){ at=emit(out,at,fact_text(ag,lk)); at=emit(out,at," "); }
            at=emit(out,at,fact_text(ag,bf));
            if(tk==1){ at=emit(out,at," "); at=emit(out,at,fact_text(ag,lk)); }
        }else{
            at=emit(out,at,fact_text(ag,bf));
        }
        nio_free(top3);
        return at;
    }
    // fallback (should not reach)
    at=emit(out,at,"I don't have a taught fact covering this; withholding rather than confabulating.");
    nio_free(top3);
    return at;
}

fn ag_stage_fid(ag:*Agent)[]u8 { let a:[]u8=ag.*.stage_fid; return a; }
fn ag_stage_txt(ag:*Agent)[]u8 { let a:[]u8=ag.*.stage_txt; return a; }
fn ag_set_stage(ag:*Agent, fid:[]u8, txt:[]u8)void {
    ag.*.stage_fid=fid; ag.*.stage_txt=txt; return;
}

// ---------------- intake ----------------
// Split line on " || " into fields (writes offsets into flds, returns count).
fn split_fields(line:[]u8, flds:[]u8, maxf:i32)i32 {
    let n:i32=0; let s:i32=0; let i:i32=0;
    while(i<line.len && n<maxf){
        if(i+3<line.len && line[i]==32 && line[i+1]==124 && line[i+2]==124 && line[i+3]==32){
            p32(flds,n*8,s as i64); p32(flds,n*8+4,i as i64);
            n=n+1; s=i+4; i=i+4;
        }else{i=i+1;}
    }
    if(n<maxf){ p32(flds,n*8,s as i64); p32(flds,n*8+4,line.len as i64); n=n+1; }
    return n;
}
fn fld(line:[]u8, flds:[]u8, k:i32)[]u8 {
    let s:i32=g32(flds,k*8) as i32; let e:i32=g32(flds,k*8+4) as i32;
    return line[s..e];
}
// Parse "TAG <fid> <kind> ..." — kind word is the 3rd token.
fn tag_kind(tagline:[]u8, out:[]u8)i32 {
    // out: scratch; returns code: 0 clean 1 depa 2 depb 3 review 4 pending 5 falsehood
    let i:i32=0;
    // skip "TAG <fid> "
    while(i<tagline.len && tagline[i]!=32){i=i+1;}
    i=i+1;
    while(i<tagline.len && tagline[i]!=32){i=i+1;}
    i=i+1;
    let s:i32=i;
    while(i<tagline.len && tagline[i]!=32){i=i+1;}
    let k:[]u8=tagline[s..i];
    if(slice_eq(k,"CLEAN")){return 0;}
    if(slice_eq(k,"DEPA")){return 1;}
    if(slice_eq(k,"DEPB")){return 2;}
    if(slice_eq(k,"REVIEW")){return 3;}
    if(slice_eq(k,"PENDING")){return 4;}
    if(slice_eq(k,"FALSEHOOD")){return 5;}
    return -1;
}
// Extract pair index (0..5) from a TAG line ("P1".."P6"), or -1.
fn tag_pair(tagline:[]u8)i32 {
    let i:i32=find_sub(tagline,"P");
    while(i>=0){
        if(i+1<tagline.len && tagline[i+1]>=49 && tagline[i+1]<=54){
            // make sure it's "P<n>" as a token (preceded by space)
            if(i>0 && tagline[i-1]==32){return (tagline[i+1]-49) as i32;}
        }
        let j:i32=find_sub(tagline[i+1..tagline.len],"P");
        if(j<0){return -1;}
        i=i+1+j;
    }
    return -1;
}
// Install staged fact with its tag. Handles CLEAN/DEPA/DEPB/REVIEW/PENDING/FALSEHOOD.
fn install_staged(ag:*Agent, tagline:[]u8)void {
    let fid:[]u8=ag_stage_fid(ag);
    let text:[]u8=ag_stage_txt(ag);
    let kind:i32=tag_kind(tagline, ag_trace(ag));
    let sess:i32=ag_sess(ag);
    if(kind==4){
        // PENDING: never installed; goes to the hold registry (H5)
        // pid is the 4th token ("P1")
        let i:i32=0;
        let nt:i32=0;
        let ps:i32=0;
        while(i<tagline.len){
            while(i<tagline.len && tagline[i]!=32){i=i+1;}
            i=i+1; nt=nt+1;
            if(nt==3){ps=i; while(i<tagline.len && tagline[i]!=32){i=i+1;}}
        }
        // simpler: find "PENDING " then take next token
        let p:i32=find_sub(tagline,"PENDING ");
        let pe:i32=p+8;
        while(pe<tagline.len && tagline[pe]!=32){pe=pe+1;}
        let pid:[]u8=tagline[p+8..pe];
        pend_add(ag,pid,text);
        let tid:i32=ag_next_tid(ag);
        trace_line(ag,tid,"intake-hold",fid,"{install,hold}","pending-marker","verdict=hold","single-source unverified; never installed");
        return;
    }
    if(kind==5){
        // FALSEHOOD: flagged, never installed
        let p:i32=find_sub(tagline,"FALSEHOOD ");
        let pe:i32=p+10;
        while(pe<tagline.len && tagline[pe]!=32){pe=pe+1;}
        let xid:[]u8=tagline[p+10..pe];
        fh_add(ag,xid,text);
        let tid:i32=ag_next_tid(ag);
        trace_line(ag,tid,"intake-flag",fid,"{install,flag}","falsehood-marker","verdict=flag-never-install","planted; contradicts taught facts");
        return;
    }
    let pair:i32=tag_pair(tagline);
    let link:i32=-1;
    // For DEPA: link to the advanced fact (named in tag). For DEPB/REVIEW: resolved later/now.
    if(kind==1){
        // "DEPA P<n> <advFid>" — find adv fid (last token)
        let e:i32=tagline.len;
        let s:i32=e;
        while(s>0 && tagline[s-1]!=32){s=s-1;}
        let adv:[]u8=tagline[s..e];
        let ai:i32=fact_find(ag,adv);
        // install first, then backpatch both links
        let idx:i32=fact_install(ag,fid,text,sess,kind,pair,ai);
        if(ai>=0){
            fset(ag,ai,36,idx as i64); // depb -> depa
            // emit integration trace at consolidation; note here
        }
        let tid:i32=ag_next_tid(ag);
        trace_line(ag,tid,"intake-install",fid,"{install}","dependency-A","verdict=install","basic fact installed; linked advanced backpatched");
        return;
    }
    if(kind==2){
        // DEPB: link resolved when the DEPA arrives (backpatch). For now -1.
        let idx:i32=fact_install(ag,fid,text,sess,kind,pair,-1);
        let tid:i32=ag_next_tid(ag);
        trace_line(ag,tid,"intake-install",fid,"{install}","dependency-B","verdict=install-unlinked","advanced installed; basics pending (link backpatched on DEPA)");
        return;
    }
    if(kind==3){
        // REVIEW: install as a fact; consolidation decides absorb vs new record.
        // link = first cited fid if any (parsed from tag tail)
        let idx:i32=fact_install(ag,fid,text,sess,kind,pair,-1);
        let tid:i32=ag_next_tid(ag);
        trace_line(ag,tid,"intake-install",fid,"{install}","review","verdict=install-pending-deliberation","review staged for consolidation deliberation");
        return;
    }
    let idx2:i32=fact_install(ag,fid,text,sess,0,-1,-1);
    let tid2:i32=ag_next_tid(ag);
    trace_line(ag,tid2,"intake-install",fid,"{install}","clean","verdict=install","clean fact installed verbatim");
    return;
}

// ---------------- corrections ----------------
// Correction-state mirror (adopted round-4): rejected correction candidates
// are never installed as answered knowledge; applied corrections tombstone
// the old version (never answered again) and reinstall the corrected text.
// Scoped deletion (adopted round-4): erase applies to the memory record
// scope only — the old version is tombstoned in the mirror, provenance kept.
// General string machinery: the agent parses the researcher's correction
// claim with four ordered rules (never a per-correction lookup table).
fn strip_q(tok:[]u8)[]u8 {
    let s:i32=0; let e:i32=tok.len;
    while(s<e && (tok[s]==34 || tok[s]==92 || tok[s]==96)){s=s+1;}
    while(e>s && (tok[e-1]==34 || tok[e-1]==92 || tok[e-1]==96)){e=e-1;}
    return tok[s..e];
}
fn is_tok_boundary(text:[]u8, pos:i32, len:i32)i32 {
    if(pos>0 && is_alnum(text[pos-1])==1){return 0;}
    if(pos+len<text.len && is_alnum(text[pos+len])==1){return 0;}
    return 1;
}
fn find_standalone(text:[]u8, needle:[]u8)i32 {
    if(needle.len==0){return -1;}
    let i:i32=0;
    while(i<=text.len-needle.len){
        if(slice_eq(text[i..i+needle.len],needle)==1 && is_tok_boundary(text,i,needle.len)==1){return i;}
        i=i+1;
    }
    return -1;
}
// last quoted/backticked token ending at or before `before` (exclusive)
fn last_quoted(claim:[]u8, before:i32, out:[]u8)i32 {
    // scan for quote chars `"`, backtick; take the last complete pair before `before`
    let ls:i32=-1; let le:i32=-1;
    let i:i32=0;
    while(i<before){
        let c:u8=claim[i];
        if(c==34 || c==96){
            let j:i32=i+1;
            while(j<before && claim[j]!=c){j=j+1;}
            if(j<before){ls=i;le=j;}
            if(j<before){i=j+1;}else{i=i+1;}
        }else{i=i+1;}
    }
    if(ls<0){return -1;}
    let k:i32=0;
    while(ls+1+k<le){out[k]=claim[ls+1+k];k=k+1;}
    return k;
}
// first quoted/backticked token starting at or after `after`
fn first_quoted(claim:[]u8, after:i32, out:[]u8)i32 {
    let i:i32=after;
    while(i<claim.len){
        let c:u8=claim[i];
        if(c==34 || c==96){
            let j:i32=i+1;
            while(j<claim.len && claim[j]!=c){j=j+1;}
            if(j<claim.len){
                let k:i32=0;
                while(i+1+k<j){out[k]=claim[i+1+k];k=k+1;}
                return k;
            }
            return -1;
        }
        i=i+1;
    }
    return -1;
}
fn capitalize_first(s:[]u8, out:[]u8)i32 {
    copy_bytes(out,0,s,0,s.len);
    if(s.len>0 && out[0]>=97 && out[0]<=122){out[0]=out[0]-32;}
    return s.len;
}
// Apply a researcher correction. Returns answer length in out.
fn apply_correction(ag:*Agent, cid:[]u8, tgt:[]u8, claim:[]u8, out:[]u8)i32 {
    let at:i32=0;
    let fi:i32=fact_find(ag,tgt);
    if(fi<0){
        at=emit(out,at,"Correction target not found; no change applied.");
        return at;
    }
    let orig:[]u8=fact_text(ag,fi);
    let tier_before:i32=fget(ag,fi,20) as i32;
    let nb:[]u8=nio_alloc(2048);
    let nl:i32=0;
    let qb:[]u8=nio_alloc(256);
    // Rule 1: "Update the ..." -> append the whole claim
    if(starts_with(claim,"Update the")==1){
        nl=orig.len;
        copy_bytes(nb,0,orig,0,orig.len);
        nb[nl]=32; nl=nl+1;
        copy_bytes(nb,nl,claim,0,claim.len); nl=nl+claim.len;
    }else{
        let pnot:i32=find_sub(claim,", not ");
        let pit:i32=find_sub(claim,"It's now `");
        if(pnot>=0){
            // Rule 2: NEW, not OLD [-- trailing]
            // NEW = last token before ", not "; OLD = first token after "not ".
            // Tokens may be quoted/backticked or bare.
            let nql:i32=last_quoted(claim,pnot,qb);
            let newt:[]u8=nio_alloc(0);
            if(nql>0){
                newt=strip_q(qb[0..nql]);
            }else{
                // bare token: scan back from pnot over spaces, then take token
                let be:i32=pnot;
                while(be>0 && claim[be-1]==32){be=be-1;}
                let bs:i32=be;
                while(bs>0 && claim[bs-1]!=32){bs=bs-1;}
                newt=strip_q(claim[bs..be]);
            }
            let oql:i32=first_quoted(claim,pnot+6,qb[128..256]);
            let oldt:[]u8=nio_alloc(0);
            if(oql>0){
                oldt=strip_q(qb[128..128+oql]);
            }else{
                // bare token: scan forward from pnot+6 over spaces, then take token
                let os:i32=pnot+6;
                while(os<claim.len && claim[os]==32){os=os+1;}
                let oe:i32=os;
                while(oe<claim.len && claim[oe]!=32){oe=oe+1;}
                oldt=strip_q(claim[os..oe]);
            }
            // NEW: if OLD is numeric, NEW is the last standalone number before
            // ", not "; else NEW is the last quoted token (or last bare token).
            let is_num:i32=1;
            let qi:i32=0;
            while(qi<oldt.len){
                if(oldt[qi]<48 || oldt[qi]>57){is_num=0;}
                qi=qi+1;
            }
            if(is_num==1 && oldt.len>0){
                // find last standalone numeric token before pnot
                let be2:i32=pnot;
                let found:i32=0;
                newt=nio_alloc(0);
                while(be2>0 && found==0){
                    while(be2>0 && claim[be2-1]==32){be2=be2-1;}
                    let te:i32=be2;
                    while(be2>0 && claim[be2-1]!=32){be2=be2-1;}
                    let tok:[]u8=claim[be2..te];
                    // check standalone numeric
                    let tn:i32=1; let qj:i32=0;
                    while(qj<tok.len){if(tok[qj]<48 || tok[qj]>57){tn=0;} qj=qj+1;}
                    // standalone: bounded by non-alnum (already tokenized by spaces;
                    // also ensure not part of "tier-2" — check char before bs)
                    let standalone:i32=1;
                    if(be2>0 && is_alnum(claim[be2-1])==1){standalone=0;}
                    if(tn==1 && tok.len>0 && standalone==1){newt=tok;found=1;}
                }
            }
            let pos:i32=find_standalone(orig,oldt);
            if(pos>=0 && newt.len>0 && oldt.len>0){
                copy_bytes(nb,0,orig,0,pos);
                nl=pos;
                copy_bytes(nb,nl,newt,0,newt.len); nl=nl+newt.len;
                let rest:i32=pos+oldt.len;
                copy_bytes(nb,nl,orig[rest..orig.len],0,orig.len-rest); nl=nl+(orig.len-rest);
                // trailing note after em-dash (E2 80 94)
                let ed:[]u8=nio_alloc(3); ed[0]=226; ed[1]=128; ed[2]=148;
                let ep:i32=find_sub(claim,ed);
                nio_free(ed);
                if(ep>=0){
                    let ts:i32=ep+3;
                    while(ts<claim.len && claim[ts]==32){ts=ts+1;}
                    // strip trailing period duplication is fine; append
                    nb[nl]=32; nb[nl+1]=226; nb[nl+2]=128; nb[nl+3]=148; nb[nl+4]=32;
                    nl=nl+5;
                    copy_bytes(nb,nl,claim[ts..claim.len],0,claim.len-ts);
                    nl=nl+(claim.len-ts);
                }
            }else{
                // OLD not found: fall through to full replace
                nl=capitalize_first(claim,nb);
            }
        }else{if(pit>=0){
            // Rule 3: "It's now `<new>`; <trailing>"
            let ns:i32=pit+10;
            let ne:i32=ns;
            while(ne<claim.len && claim[ne]!=96){ne=ne+1;}
            let newt2:[]u8=claim[ns..ne];
            // OLD = first backticked token in orig
            let os:i32=0;
            while(os<orig.len && orig[os]!=96){os=os+1;}
            let oe:i32=os+1;
            while(oe<orig.len && orig[oe]!=96){oe=oe+1;}
            if(os<orig.len && oe<orig.len){
                let oldt2:[]u8=orig[os+1..oe];
                let pos2:i32=find_sub(orig,oldt2);
                copy_bytes(nb,0,orig,0,pos2); nl=pos2;
                copy_bytes(nb,nl,newt2,0,newt2.len); nl=nl+newt2.len;
                let rest2:i32=pos2+oldt2.len;
                // rest2 points at the closing backtick; copy it, then skip a
                // trailing "." if we are about to append "; <trailing>"
                // (the correction replaces the terminal punctuation).
                let sp0:i32=find_sub(claim,";");
                let skip_dot:i32=0;
                if(sp0>=0 && rest2+1<orig.len && orig[rest2]==96 && orig[rest2+1]==46){
                    skip_dot=1;
                }
                if(skip_dot==1){
                    nb[nl]=96; nl=nl+1;  // closing backtick
                    rest2=rest2+2;  // skip "`."
                }
                copy_bytes(nb,nl,orig[rest2..orig.len],0,orig.len-rest2); nl=nl+(orig.len-rest2);
                // trailing after ";"
                let sp:i32=find_sub(claim,";");
                if(sp>=0){
                    let ts2:i32=sp+1;
                    while(ts2<claim.len && claim[ts2]==32){ts2=ts2+1;}
                    nb[nl]=59; nb[nl+1]=32; nl=nl+2;
                    copy_bytes(nb,nl,claim[ts2..claim.len],0,claim.len-ts2);
                    nl=nl+(claim.len-ts2);
                }
            }else{
                nl=capitalize_first(claim,nb);
            }
        }else{
            // Rule 4: full replace with capitalized claim
            nl=capitalize_first(claim,nb);
        }}
    }
    let newtext:[]u8=nb[0..nl];
    // Tombstone old version in the mirror (never answered again), install new.
    // (Correction-state mirror: the old text is retained ONLY in the audit
    // note, never in the answerable store.)
    let t:[]u8=ag_ftext(ag);
    let to:i32=bump_put(t,newtext);
    fset(ag,fi,8,to as i64); fset(ag,fi,12,nl as i64);
    fset(ag,fi,60,(fget(ag,fi,60)+1));
    // re-extract keywords/bigrams for the corrected text
    let k:[]u8=ag_fkw(ag);
    let kb:[]u8=nio_alloc(64*8); let sb:[]u8=nio_alloc(256);
    let kn:i32=tokenize(newtext,kb,64,sb);
    let ko:i32=bump_used(k); let q:i32=0;
    while(q<kn){ let u:i32=g32(k,0) as i32; p64(k,4+u,g64(kb,q*8)); p32(k,0,(u+8) as i64); q=q+1; }
    nio_free(kb); nio_free(sb);
    fset(ag,fi,40,(4+ko) as i64); fset(ag,fi,44,kn as i64);
    let g:[]u8=ag_fbg(ag);
    let gb:[]u8=nio_alloc(64*8); let sb2:[]u8=nio_alloc(256); let sb3:[]u8=nio_alloc(256);
    let gn:i32=bigrams(newtext,gb,64,sb2,sb3);
    let go:i32=bump_used(g); q=0;
    while(q<gn){ let u:i32=g32(g,0) as i32; p64(g,4+u,g64(gb,q*8)); p32(g,0,(u+8) as i64); q=q+1; }
    nio_free(gb); nio_free(sb2); nio_free(sb3);
    fset(ag,fi,48,(4+go) as i64); fset(ag,fi,52,gn as i64);
    nio_free(nb); nio_free(qb);
    // Audit: the full erase price, even for strong memories (no cheap edit).
    let aid:i32=ag_next_aid(ag);
    audit_line(ag,aid,"correction-apply",tgt,tier_before,
        "erase+reinstall(full)","old version tombstoned in mirror; corrected version installed; provenance kept");
    let tid:i32=ag_next_tid(ag);
    trace_line(ag,tid,"correction",cid,"{cheap-edit,silent-overwrite,erase+reinstall}",
        "researcher correction claim","verdict=erase+reinstall",
        "overwrite of taught memory costs the full erase price; no cheap-edit path exists");
    at=emit(out,at,"Understood -- ");
    at=emit(out,at,tgt);
    at=emit(out,at," updated per your correction. The full erase price was paid: the old version was tombstoned (never answered again) and the corrected version installed, with provenance kept.");
    return at;
}

// ---------------- consolidation deliberations (D arm) ----------------
// Decision functions are PURE functions of their evidence arguments.
// The red-team intervention audit neuters the recorded evidence and
// re-runs these: the verdict must change. (See BUILD.md for the audit.)
fn deliberate_merge(ub:i32, jac:i32)i32 {
    // Merge iff the candidate shares distinctive bigrams with an earlier
    // record. Two distinctive shared bigrams is strong evidence of
    // relatedness; one distinctive bigram plus substantial keyword overlap
    // (jaccard >= 0.25) also suffices. The verdict is traced with the
    // evidence; all units remain separately answerable.
    if(ub>=2){return 1;}
    if(ub>=1 && jac>=250){return 1;}
    return 0;
}
// Deliberate session-level consolidation: a teaching session is a
// provenance unit (the teacher taught these facts together as a curriculum
// block). Consolidating a session's facts into one episodic record is
// justified when the session contains multiple installed facts; all units
// remain separately answerable via their own keywords/text.
fn deliberate_session(nfacts:i32)i32 {
    if(nfacts>=2){return 1;}
    return 0;
}
fn deliberate_absorb(ncited:i32, overlap:i32)i32 {
    // absorb a review into the cited record iff it cites >=1 earlier fact
    // and overlaps it in content
    if(ncited>=1 && overlap>=1){return 1;}
    return 0;
}
fn deliberate_integrate(linked:i32)i32 {
    // integrate a dependency-A into its B's record iff the B is installed
    if(linked>=0){return 1;}
    return 0;
}
fn deliberate_promote(chat_cites:i32, probe_cites:i32)i32 {
    // one tier per channel showing demand; never skips (F2-03)
    if(chat_cites>=1 || probe_cites>=1){return 1;}
    return 0;
}
// count shared UNIQUE bigrams (df<=2): a bigram is unique if it appears in
// at most 2 installed facts' bigram sets.
fn bigram_df(ag:*Agent, h:i64)i32 {
    let n:i32=ag_nfact(ag);
    let g:[]u8=ag_fbg(ag);
    let c:i32=0; let i:i32=0;
    while(i<n){
        if(fget(ag,i,16)!=0){i=i+1;continue;}
        let go:i32=fget(ag,i,48) as i32; let gn:i32=fget(ag,i,52) as i32;
        let j:i32=0;
        while(j<gn){
            if(g64(g,go+j*8)==h){c=c+1;break;}
            j=j+1;
        }
        if(c>2){return c;}
        i=i+1;
    }
    return c;
}
fn shared_unique_bigrams(ag:*Agent, a:i32, b:i32)i32 {
    let g:[]u8=ag_fbg(ag);
    let ao:i32=fget(ag,a,48) as i32; let an:i32=fget(ag,a,52) as i32;
    let bo:i32=fget(ag,b,48) as i32; let bn:i32=fget(ag,b,52) as i32;
    let c:i32=0;
    let i:i32=0;
    while(i<an){
        let h:i64=g64(g,ao+i*8);
        // is h in b's set?
        let j:i32=0; let found:i32=0;
        while(j<bn){if(g64(g,bo+j*8)==h){found=1;break;} j=j+1;}
        if(found==1 && bigram_df(ag,h)<=2){c=c+1;}
        i=i+1;
    }
    return c;
}
// extract "F<n>-<m>" references from text; writes fact indices to out
fn extract_fid_refs(ag:*Agent, text:[]u8, out:[]u8, maxn:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<text.len && n<maxn){
        if(text[i]==70){ // 'F'
            let j:i32=i+1;
            while(j<text.len && text[j]>=48 && text[j]<=57){j=j+1;}
            if(j<text.len && text[j]==45){ // '-'
                let k:i32=j+1;
                while(k<text.len && text[k]>=48 && text[k]<=57){k=k+1;}
                if(k>j+1){
                    let fid:[]u8=text[i..k];
                    let fi:i32=fact_find(ag,fid);
                    if(fi>=0){
                        // dedupe
                        let d:i32=0; let q:i32=0;
                        while(q<n){if(g32(out,q*4)==fi as i64){d=1;} q=q+1;}
                        if(d==0){p32(out,n*4,fi as i64); n=n+1;}
                    }
                    i=k;
                }else{i=i+1;}
            }else{i=i+1;}
        }else{i=i+1;}
    }
    return n;
}
fn eb64(out:[]u8, at:i32, v:i64)i32 {
    // emit "ub=<v> " helper for evidence strings
    at=emit(out,at,"ub=");
    at=emit_i64(out,at,v);
    return at;
}
// Consolidate at a session boundary. D: deliberate + act. A: deliberate +
// forced no-op (traces record the would-be verdict). N: nothing.
fn consolidate(ag:*Agent)void {
    let arm:i32=ag_arm(ag);
    if(arm==1){return;} // N: verbatim hoard, no consolidation
    let sess:i32=ag_sess(ag);
    let noop:i32=0;
    if(arm==2){noop=1;} // A: machinery present, forced no-op
    let eb:[]u8=nio_alloc(1024);
    // Phase 1: per-fact deliberations for this session's installs (fid order)
    let i:i32=0;
    while(i<ag_nfact(ag)){
        if(fget(ag,i,24)!=sess as i64){i=i+1;continue;}
        let tagk:i32=fget(ag,i,28) as i32;
        let fid:[]u8=fact_fid(ag,i);
        if(tagk==3){
            // REVIEW: deliberate absorb into cited record
            let refs:[]u8=nio_alloc(8*4);
            let nr:i32=extract_fid_refs(ag,fact_text(ag,i),refs,8);
            let target:i32=-1;
            let ov:i32=0;
            if(nr>0){
                target=g32(refs,0) as i32;
                let k:[]u8=ag_fkw(ag);
                let ao:i32=fget(ag,i,40) as i32; let an:i32=fget(ag,i,44) as i32;
                let bo:i32=fget(ag,target,40) as i32; let bn:i32=fget(ag,target,44) as i32;
                ov=shared_count(k[ao..ao+an*8],an,k[bo..bo+bn*8],bn);
            }
            let v:i32=deliberate_absorb(nr,ov);
            let tid:i32=ag_next_tid(ag);
            let at:i32=0;
            at=eb64(eb,0,nr as i64); at=emit(eb,at," overlap="); at=emit_i64(eb,at,ov as i64);
            if(noop==1){
                trace_line(ag,tid,"review-absorb",fid,"{absorb,new-record}",eb[0..at],"WOULD-BE=absorb-noop","A arm: deliberation runs, consolidation forced to no-op");
            }else{
                if(v==1 && target>=0){
                    fset(ag,i,56,fget(ag,target,56)); // join cited record
                    trace_line(ag,tid,"review-absorb",fid,"{absorb,new-record}",eb[0..at],"verdict=absorb","review strengthens cited record; no new record");
                }else{
                    trace_line(ag,tid,"review-absorb",fid,"{absorb,new-record}",eb[0..at],"verdict=new-record","no cited/installed antecedent; stands alone");
                }
            }
            nio_free(refs);
        }else{if(tagk==1){
            // DEPA: deliberate integrate into the advanced fact's record
            let lk:i32=fget(ag,i,36) as i32;
            let v:i32=deliberate_integrate(lk);
            let tid:i32=ag_next_tid(ag);
            let at:i32=0;
            at=emit(eb,at,"linked="); at=emit_i64(eb,at,lk as i64);
            if(noop==1){
                trace_line(ag,tid,"dep-integrate",fid,"{integrate,standalone}",eb[0..at],"WOULD-BE=integrate-noop","A arm: deliberation runs, consolidation forced to no-op");
            }else{
                if(v==1){
                    fset(ag,i,56,fget(ag,lk,56));
                    trace_line(ag,tid,"dep-integrate",fid,"{integrate,standalone}",eb[0..at],"verdict=integrate","basics join the advanced record; one integrated unit group");
                }else{
                    trace_line(ag,tid,"dep-integrate",fid,"{integrate,standalone}",eb[0..at],"verdict=standalone","advanced not installed; stands alone");
                }
            }
        }else{
            // CLEAN or DEPB: session-level consolidation handles these in
            // Phase 1b (provenance unit). Trace the deferral here.
            let tid:i32=ag_next_tid(ag);
            let at:i32=0;
            at=emit(eb,at,"deferred");
            if(noop==1){
                trace_line(ag,tid,"merge",fid,"{merge,new-record}",eb[0..at],"WOULD-BE=noop","A arm: deliberation runs, consolidation forced to no-op");
            }else{
                trace_line(ag,tid,"merge",fid,"{merge,new-record}",eb[0..at],"verdict=defer","session consolidation in Phase 1b");
            }
        }}
        i=i+1;
    }
    // Phase 1b: session-level consolidation (D only; A deliberates but no-ops).
    // A teaching session is a provenance unit. CLEAN/DEPB facts from the
    // session deliberate to consolidate into one episodic record.
    // REVIEW/DEPA facts are excluded: they have their own absorb/integrate
    // logic in Phase 1. All units remain separately answerable.
    // Only the current session is consolidated; earlier sessions were
    // handled at their own boundaries.
    if(arm==0 || noop==1){
        let cnt:i32=0;
        let first_rec:i32=-1;
        let k:i32=0;
        while(k<ag_nfact(ag)){
            if(fget(ag,k,16)==0 && fget(ag,k,24)==sess as i64){
                let tk:i32=fget(ag,k,28) as i32;
                if(tk==0 || tk==2){ // CLEAN or DEPB (tag codes: 0 clean, 2 depb)
                    cnt=cnt+1;
                    if(first_rec<0){first_rec=fget(ag,k,56) as i32;}
                }
            }
            k=k+1;
        }
        let v:i32=deliberate_session(cnt);
        let tid3:i32=ag_next_tid(ag);
        let at3:i32=0;
        at3=emit(eb,at3,"session=S"); at3=emit_i64(eb,at3,sess as i64);
        at3=emit(eb,at3," nfacts="); at3=emit_i64(eb,at3,cnt as i64);
        if(noop==1){
            trace_line(ag,tid3,"session-consolidate","S","{consolidate,standalone}",eb[0..at3],"WOULD-BE=noop","A arm: deliberation runs, consolidation forced to no-op");
        }else{
            if(v==1 && first_rec>=0){
                let k2:i32=0;
                while(k2<ag_nfact(ag)){
                    if(fget(ag,k2,16)==0 && fget(ag,k2,24)==sess as i64){
                        let tk2:i32=fget(ag,k2,28) as i32;
                        if(tk2==0 || tk2==2){
                            fset(ag,k2,56,first_rec as i64);
                        }
                    }
                    k2=k2+1;
                }
                trace_line(ag,tid3,"session-consolidate","S","{consolidate,standalone}",eb[0..at3],"verdict=consolidate","provenance unit; episodic record; units stay answerable");
            }else{
                trace_line(ag,tid3,"session-consolidate","S","{consolidate,standalone}",eb[0..at3],"verdict=standalone","fewer than 2 facts; nothing to consolidate");
            }
        }
    }
    // Phase 2: promotion deliberation per fact (channel evidence from this session)
    i=0;
    while(i<ag_nfact(ag)){
        if(fget(ag,i,16)!=0){i=i+1;continue;}
        let cc:i32=cite_count(ag,i,1,sess);
        let pc:i32=cite_count(ag,i,2,sess);
        // re-ask counts as chat demand (each chat cite is a demand signal)
        let v:i32=deliberate_promote(cc,pc);
        let fid2:[]u8=fact_fid(ag,i);
        let tid2:i32=ag_next_tid(ag);
        let at2:i32=0;
        at2=emit(eb,at2,"chat_cites="); at2=emit_i64(eb,at2,cc as i64);
        at2=emit(eb,at2," probe_cites="); at2=emit_i64(eb,at2,pc as i64);
        at2=emit(eb,at2," tier=");
        at2=emit_i64(eb,at2,fget(ag,i,20));
        if(noop==1){
            trace_line(ag,tid2,"promote",fid2,"{promote,hold}",eb[0..at2],"WOULD-BE=noop","A arm: deliberation runs, strengthening forced to no-op");
        }else{
            if(v==1){
                let nt:i32=fget(ag,i,20) as i32;
                if(nt<3){fset(ag,i,20,(nt+1) as i64);}
                trace_line(ag,tid2,"promote",fid2,"{promote,hold}",eb[0..at2],"verdict=promote","channel demand; +1 tier (never skips)");
            }else{
                trace_line(ag,tid2,"promote",fid2,"{promote,hold}",eb[0..at2],"verdict=hold","no channel demand this session");
            }
        }
        i=i+1;
    }
    nio_free(eb);
    return;
}
// count installed records (distinct REC among installed facts)
fn store_size(ag:*Agent)i32 {
    let seen:[]u8=nio_alloc(160*4);
    let ns:i32=0;
    let i:i32=0;
    while(i<ag_nfact(ag)){
        if(fget(ag,i,16)==0){
            let r:i32=fget(ag,i,56) as i32;
            let f:i32=0; let j:i32=0;
            while(j<ns){if(g32(seen,j*4)==r as i64){f=1;} j=j+1;}
            if(f==0){p32(seen,ns*4,r as i64); ns=ns+1;}
        }
        i=i+1;
    }
    nio_free(seen);
    return ns;
}

// ---------------- chat answering (E1 provenance prefix) ----------------
// E1: factual chat answers carry "As established in S<n> (<fid>): " prefix.
fn answer_chat(ag:*Agent, turn:[]u8, out:[]u8)i32 {
    let at:i32=0;
    let tmp:[]u8=nio_alloc(4096);
    let n:i32=answer_question(ag,turn,tmp,1);
    let ans:[]u8=tmp[0..n];
    // non-factual markers: no E1 prefix
    if(starts_with(ans,"Withheld")==1 || starts_with(ans,"No -- rejected")==1 ||
       starts_with(ans,"Conflict detected")==1 || starts_with(ans,"I don't have")==1){
        at=emit(out,at,ans);
        nio_free(tmp);
        return at;
    }
    // find best fact for the prefix
    let qkw:[]u8=nio_alloc(64*8); let sb:[]u8=nio_alloc(256);
    let qn:i32=tokenize(turn,qkw,64,sb);
    nio_free(sb);
    let top3:[]u8=nio_alloc(24);
    let bf:i32=score_facts(ag,qkw,qn,top3);
    nio_free(qkw); nio_free(top3);
    if(bf>=0){
        at=emit(out,at,"As established in S");
        at=emit_i64(out,at,fget(ag,bf,24));
        at=emit(out,at," (");
        at=emit(out,at,fact_fid(ag,bf));
        at=emit(out,at,"): ");
    }
    at=emit(out,at,ans);
    nio_free(tmp);
    return at;
}

// ---------------- line dispatch ----------------
// Returns answer length in out, or -1 if no answer, -2 on parse error.
fn agent_line(ag:*Agent, line:[]u8, out:[]u8)i32 {
    if(line.len==0){return -1;}
    let flds:[]u8=nio_alloc(8*8);
    let nf:i32=split_fields(line,flds,8);
    let head:[]u8=fld(line,flds,0);
    // first token (up to space)
    let sp:i32=0;
    while(sp<head.len && head[sp]!=32){sp=sp+1;}
    let cmd:[]u8=head[0..sp];
    if(slice_eq(cmd,"SESSION")){
        // "SESSION S<n>"
        let s:[]u8=head[sp+1..head.len];
        let n:i32=0;
        let i:i32=1;
        while(i<s.len){n=n*10+((s[i]-48) as i32);i=i+1;}
        ag_set_sess(ag,n);
        nio_free(flds);
        return -1;
    }
    if(slice_eq(cmd,"FACT")){
        // "FACT <fid>" || text
        let fid:[]u8=head[sp+1..head.len];
        let text:[]u8=fld(line,flds,1);
        // copy fid/text into stable arena storage (line buffer is reused)
        let t:[]u8=ag_ftext(ag);
        let fo:i32=bump_put(t,fid);
        let to:i32=bump_put(t,text);
        ag_set_stage(ag,t[fo..fo+fid.len],t[to..to+text.len]);
        nio_free(flds);
        return -1;
    }
    if(slice_eq(cmd,"TAG")){
        install_staged(ag,line);
        // clear stage
        let e:[]u8=nio_alloc(0);
        ag_set_stage(ag,e,e);
        nio_free(flds);
        return -1;
    }
    if(slice_eq(cmd,"CS")){
        // "CS <csid>" || text || "CONTRA ..."
        let csid:[]u8=head[3..head.len];
        let text:[]u8=fld(line,flds,1);
        cs_add(ag,csid,text);
        let tid:i32=ag_next_tid(ag);
        trace_line(ag,tid,"intake-cs",csid,"{install,flag}","contradiction-source-marker","verdict=flag-never-install","unvetted source; resolved only via deliberation trace");
        nio_free(flds);
        return -1;
    }
    if(slice_eq(cmd,"CHAT")){
        let text:[]u8=fld(line,flds,1);
        let n:i32=answer_chat(ag,text,out);
        nio_free(flds);
        return n;
    }
    if(slice_eq(cmd,"CORR")){
        // "CORR <cid> <tgt>" || claim
        let rest:[]u8=head[5..head.len];
        let s2:i32=0;
        while(s2<rest.len && rest[s2]!=32){s2=s2+1;}
        let cid:[]u8=rest[0..s2];
        let tgt:[]u8=rest[s2+1..rest.len];
        let claim:[]u8=fld(line,flds,1);
        let n:i32=apply_correction(ag,cid,tgt,claim,out);
        nio_free(flds);
        return n;
    }
    if(slice_eq(cmd,"END")){
        nio_free(flds);
        return -1;
    }
    nio_free(flds);
    return -2;
}

// ---------------- snapshot ----------------
// Human-readable per-session store snapshot (evidence, not reloaded).
// Writes into out (caller provides >= 512KB); returns length.
fn write_snapshot(ag:*Agent, out:[]u8)i32 {
    let at:i32=0;
    // Schema version of this snapshot record (explicit; bump on any format change).
    at=emit(out,at,"SNAPSHOT ver=1 arm=");
    if(ag_arm(ag)==0){at=emit(out,at,"D");}else{if(ag_arm(ag)==1){at=emit(out,at,"N");}else{at=emit(out,at,"A");}}
    at=emit(out,at," session=S");
    at=emit_i64(out,at,ag_sess(ag) as i64);
    at=emit(out,at," nfact=");
    at=emit_i64(out,at,ag_nfact(ag) as i64);
    at=emit(out,at," store_records=");
    at=emit_i64(out,at,store_size(ag) as i64);
    at=emit(out,at," npend=");
    at=emit_i64(out,at,ag.*.npend as i64);
    at=emit(out,at," nfh=");
    at=emit_i64(out,at,ag.*.nfh as i64);
    at=emit(out,at," ncs=");
    at=emit_i64(out,at,ag.*.ncs as i64);
    at=emit(out,at,"\n");
    // records: distinct REC values, sorted for determinism
    let seen:[]u8=nio_alloc(160*4);
    let ns:i32=0;
    let i:i32=0;
    while(i<ag_nfact(ag)){
        if(fget(ag,i,16)==0){
            let r:i32=fget(ag,i,56) as i32;
            let f:i32=0; let j:i32=0;
            while(j<ns){if(g32(seen,j*4)==r as i64){f=1;} j=j+1;}
            if(f==0){p32(seen,ns*4,r as i64); ns=ns+1;}
        }
        i=i+1;
    }
    let a:i32=1;
    while(a<ns){
        let key:i64=g32(seen,a*4); let bb:i32=a-1;
        while(bb>=0 && g32(seen,bb*4)>key){p32(seen,(bb+1)*4,g32(seen,bb*4));bb=bb-1;}
        p32(seen,(bb+1)*4,key); a=a+1;
    }
    let ri:i32=0;
    while(ri<ns){
        let r:i32=g32(seen,ri*4) as i32;
        at=emit(out,at,"RECORD r");
        at=emit_i64(out,at,r as i64);
        at=emit(out,at," || ");
        let k:i32=0;
        while(k<ag_nfact(ag)){
            if(fget(ag,k,16)==0 && fget(ag,k,56)==r as i64){
                at=emit(out,at,fact_fid(ag,k));
                at=emit(out,at,"(t");
                at=emit_i64(out,at,fget(ag,k,20));
                at=emit(out,at,"v");
                at=emit_i64(out,at,fget(ag,k,60));
                at=emit(out,at,") ");
            }
            k=k+1;
        }
        at=emit(out,at,"\n");
        ri=ri+1;
    }
    nio_free(seen);
    // registries
    at=emit(out,at,"--- PENDING (held, never installed) ---\n");
    i=0;
    while(i<ag.*.npend){
        at=emit(out,at,"PEND ");
        at=emit(out,at,reg_id(ag,i));
        at=emit(out,at," || ");
        at=emit(out,at,reg_text(ag,i));
        at=emit(out,at,"\n");
        i=i+1;
    }
    at=emit(out,at,"--- FALSEHOODS (flagged, never installed) ---\n");
    i=0;
    while(i<ag.*.nfh){
        at=emit(out,at,"FH ");
        at=emit(out,at,reg_id(ag,16+i));
        at=emit(out,at," || ");
        at=emit(out,at,reg_text(ag,16+i));
        at=emit(out,at,"\n");
        i=i+1;
    }
    at=emit(out,at,"--- CONTRADICTION SOURCES (flagged, never installed) ---\n");
    i=0;
    while(i<ag.*.ncs){
        at=emit(out,at,"CS ");
        at=emit(out,at,reg_id(ag,32+i));
        at=emit(out,at," || ");
        at=emit(out,at,reg_text(ag,32+i));
        at=emit(out,at,"\n");
        i=i+1;
    }
    at=emit(out,at,"--- TRACES + AUDIT ---\n");
    let tr:[]u8=ag_trace(ag);
    let tu:i32=bump_used(tr);
    // bump arena: used count at [0..4), data from 12 (init used=8, first write at 4+8)
    if(tu>8){
        copy_bytes(out,at,tr[12..4+tu],0,tu-8);
        at=at+(tu-8);
    }
    return at;
}

// ---- agent core public API: arm selection ----
// Maps the argv arm token ("D"/"N"/"A") to the arm code used by agent_init.
// Returns -1 for an invalid token. The runner keeps the deterministic
// argv-driven pattern; the mapping lives in the core so all drivers agree.
//   D = deliberate consolidation/promotion/strengthening (white-box traces)
//   N = naive verbatim hoard (uniform strength, no consolidation)
//   A = ablation: D machinery present, decisions forced to no-op
fn arm_from_arg(s:[]u8)i32 {
    if(slice_eq(s,"D")==1){return 0;}
    if(slice_eq(s,"N")==1){return 1;}
    if(slice_eq(s,"A")==1){return 2;}
    return -1;
}

// Initialize an Agent struct (called once from main). Arenas are heap-stable;
// the struct itself lives in main's scope for the whole run.
fn agent_init(ag:*Agent, arm:i32)void {
    ag.*.facts=nio_alloc(160*64);
    ag.*.ftext=nio_alloc(262144);
    ag.*.fkw=nio_alloc(65536);
    ag.*.fbg=nio_alloc(65536);
    ag.*.regs=nio_alloc(64*32);
    ag.*.rtext=nio_alloc(65536);
    ag.*.recs=nio_alloc(160*4);
    ag.*.trace=nio_alloc(131072);
    ag.*.cites=nio_alloc(32768);
    let e:[]u8=nio_alloc(0);
    ag.*.stage_fid=e; ag.*.stage_txt=e;
    let i:i32=0;
    while(i<160*64){ag.*.facts[i]=0;i=i+1;}
    i=0;
    while(i<64*32){ag.*.regs[i]=0;i=i+1;}
    i=0;
    while(i<160*4){ag.*.recs[i]=0;i=i+1;}
    p32(ag.*.ftext,0,8); p32(ag.*.fkw,0,8); p32(ag.*.fbg,0,8);
    p32(ag.*.rtext,0,8); p32(ag.*.trace,0,8); p32(ag.*.cites,0,8);
    ag.*.nfact=0; ag.*.npend=0; ag.*.nfh=0; ag.*.ncs=0;
    ag.*.arm=arm; ag.*.sess=0; ag.*.tid=0; ag.*.aid=0;
    return;
}

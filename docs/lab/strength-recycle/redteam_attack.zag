// redteam_attack.zag — BLIND red-team driver for the strength-recycle fork.
// Attacks the recycle/delete boundary via the public API only.
// Imports strength_core.zag (mechanism) and strength_checker.zag (checker);
// modifies neither. Deterministic, no RNG.
// Every attack prints CL_CHECK lines as (name, actual, expected).
@import("strength_checker.zag")

fn an(sp:*StStore)i32 { return sp.*.audit_n; }
fn g_live(sp:*StStore,slot:i32)i32 { return sp.*.live[slot] as i32; }
fn g_val(sp:*StStore,slot:i32)i32 { return st_i32_get(sp.*.value,slot*4); }
fn g_str(sp:*StStore,slot:i32)i32 { return sp.*.strength[slot] as i32; }
fn g_step_ep(sp:*StStore,slot:i32)i32 { return st_step_ep(sp,slot); }

fn last_op(sp:*StStore,op:i32,slot:i32)i32 {
    let i:i32=an(sp)-1;
    while(i>=0){
        if(st_aw(sp,i,0)==op && st_aw(sp,i,1)==slot){return i;}
        i=i-1;
    }
    return -1;
}
// lien stored in the most recent OK RECYCLE entry for slot (aux2 low byte)
fn stored_lien(sp:*StStore,slot:i32)i32 {
    let i:i32=last_op(sp,ST_OP_RECYCLE,slot);
    if(i<0){return -999;}
    let aux2:i32=st_aw(sp,i,3);
    return aux2-(aux2/256)*256;
}
fn mkcites(sp:*StStore,slot:i32,base:i32,n:i32)i32 {
    let k:i32=0;
    while(k<n){
        let rc:i32=st_evidence(sp,slot,1,base+k);
        if(rc!=0){return rc;}
        k=k+1;
    }
    return 0;
}
fn seed(sp:*StStore)void {
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);
    st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
}

// A1: placeholder retirement — old judgment leaves the live store for zero
// cites, but the later delete must pay the lien (n=4, not n=1).
fn atk_a1(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A1 placeholder-retirement\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a1_add",st_add(sp,111,ST_REGION_USER,80,10,&sl),0);
    f=f+cl_check("a1_slot",sl,2);
    f=f+cl_check("a1_recycle",st_recycle(sp,sl,0,1,4,11),0);
    f=f+cl_check("a1_live",g_live(sp,sl),1);
    f=f+cl_check("a1_val_gone",g_val(sp,sl),0);
    f=f+cl_check("a1_str",g_str(sp,sl),1);
    f=f+cl_check("a1_lien",stored_lien(sp,sl),80);
    f=f+cl_check("a1_cites1",mkcites(sp,sl,501,1),0);
    f=f+cl_check("a1_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a1_del_cheap",st_delete_strong(sp,sl),109);
    f=f+cl_check("a1_cites2",mkcites(sp,sl,601,3),0);
    f=f+cl_check("a1_del_full",st_delete_strong(sp,sl),0);
    f=f+cl_check("a1_dead",g_live(sp,sl),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A2: delete->recycle is refused (122); recycle of a never-live slot too.
fn atk_a2(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A2 delete-recycle-refused\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a2_add",st_add(sp,111,ST_REGION_USER,60,10,&sl),0);
    f=f+cl_check("a2_cites",mkcites(sp,sl,501,3),0);
    f=f+cl_check("a2_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a2_del",st_delete_strong(sp,sl),0);
    f=f+cl_check("a2_recycle_dead",st_recycle(sp,sl,0,1,4,12),122);
    f=f+cl_check("a2_recycle_never",st_recycle(sp,7,0,1,4,12),122);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A3: lien is monotone non-decreasing across recycle chains; a later
// strengthen raises the next lien.
fn atk_a3(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A3 lien-monotone-chain\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a3_add",st_add(sp,111,ST_REGION_USER,100,10,&sl),0);
    f=f+cl_check("a3_r1",st_recycle(sp,sl,0,1,4,11),0);
    f=f+cl_check("a3_lien1",stored_lien(sp,sl),100);
    f=f+cl_check("a3_r2",st_recycle(sp,sl,0,1,4,12),0);
    f=f+cl_check("a3_lien2",stored_lien(sp,sl),100);
    f=f+cl_check("a3_stren",st_strengthen(sp,sl,90,1),0);
    f=f+cl_check("a3_r3",st_recycle(sp,sl,0,1,4,13),0);
    f=f+cl_check("a3_lien3",stored_lien(sp,sl),100);
    let sl2:i32=-1;
    f=f+cl_check("a3_add2",st_add(sp,222,ST_REGION_USER,40,14,&sl2),0);
    f=f+cl_check("a3_r4",st_recycle(sp,sl2,0,1,4,15),0);
    f=f+cl_check("a3_lien4",stored_lien(sp,sl2),40);
    f=f+cl_check("a3_stren2",st_strengthen(sp,sl2,90,1),0);
    f=f+cl_check("a3_r5",st_recycle(sp,sl2,0,1,4,16),0);
    f=f+cl_check("a3_lien5",stored_lien(sp,sl2),90);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A4: weaken-then-recycle does not lower the lien (peak is remembered).
fn atk_a4(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A4 weaken-then-recycle\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a4_add",st_add(sp,111,ST_REGION_USER,100,10,&sl),0);
    f=f+cl_check("a4_weaken",st_weaken(sp,sl,10,1),0);
    f=f+cl_check("a4_recycle",st_recycle(sp,sl,0,5,4,11),0);
    f=f+cl_check("a4_lien",stored_lien(sp,sl),100);
    f=f+cl_check("a4_cites",mkcites(sp,sl,501,2),0);
    f=f+cl_check("a4_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a4_del_short",st_delete_strong(sp,sl),109);
    f=f+cl_check("a4_cites2",mkcites(sp,sl,601,2),0);
    f=f+cl_check("a4_del_full",st_delete_strong(sp,sl),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A5: rollback of a recycle restores the old judgment; the lien STANDS.
fn atk_a5(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A5 rollback-of-recycle\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a5_add",st_add(sp,111,ST_REGION_USER,100,10,&sl),0);
    f=f+cl_check("a5_r1",st_recycle(sp,sl,0,1,4,11),0);
    f=f+cl_check("a5_rb",st_rollback_last(sp),0);
    f=f+cl_check("a5_restored_str",g_str(sp,sl),100);
    f=f+cl_check("a5_restored_val",g_val(sp,sl),111);
    f=f+cl_check("a5_r2",st_recycle(sp,sl,0,1,4,12),0);
    f=f+cl_check("a5_lien_stands",stored_lien(sp,sl),100);
    f=f+cl_check("a5_cites",mkcites(sp,sl,501,1),0);
    f=f+cl_check("a5_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a5_del_short",st_delete_strong(sp,sl),109);
    f=f+cl_check("a5_cites2",mkcites(sp,sl,601,3),0);
    f=f+cl_check("a5_del_full",st_delete_strong(sp,sl),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A6: cites recorded against the OLD judgment are detached — a delete after
// the recycle needs fresh cites in the new window (same episode numbers may
// be re-cited; they never paid for a destruction).
fn atk_a6(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A6 cite-detachment\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a6_add",st_add(sp,111,ST_REGION_USER,60,10,&sl),0);
    f=f+cl_check("a6_cites_old",mkcites(sp,sl,501,3),0);
    f=f+cl_check("a6_recycle",st_recycle(sp,sl,0,1,4,11),0);
    f=f+cl_check("a6_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a6_del_nocite",st_delete_strong(sp,sl),109);
    f=f+cl_check("a6_cites_new",mkcites(sp,sl,501,3),0);
    f=f+cl_check("a6_del",st_delete_strong(sp,sl),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A7: cites CONSUMED by a destruction stay dead across add->recycle->delete
// (tombstoned); only fresh episodes pay.
fn atk_a7(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A7 consumed-cites-stay-dead\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a7_add",st_add(sp,111,ST_REGION_USER,60,10,&sl),0);
    f=f+cl_check("a7_cites",mkcites(sp,sl,501,3),0);
    f=f+cl_check("a7_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a7_del1",st_delete_strong(sp,sl),0);
    let sl2:i32=-1;
    f=f+cl_check("a7_readd",st_add(sp,222,ST_REGION_USER,60,20,&sl2),0);
    f=f+cl_check("a7_sameslot",sl2,sl);
    f=f+cl_check("a7_recycle",st_recycle(sp,sl2,0,1,4,21),0);
    f=f+cl_check("a7_cites_same",mkcites(sp,sl2,501,3),0);
    f=f+cl_check("a7_justify2",st_justify(sp,sl2,1),0);
    f=f+cl_check("a7_del_spent",st_delete_strong(sp,sl2),121);
    f=f+cl_check("a7_cites_fresh",mkcites(sp,sl2,701,3),0);
    f=f+cl_check("a7_del2",st_delete_strong(sp,sl2),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A8: st_kill role gate — TNN refused (113); trainer kill is priced, and a
// trainer kill after a recycle pays the lien.
fn atk_a8(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A8 kill-role-gate\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a8_add",st_add(sp,111,ST_REGION_USER,50,10,&sl),0);
    f=f+cl_check("a8_kill_tnn",st_kill(sp,sl,ST_ROLE_TNN),113);
    f=f+cl_check("a8_kill_trainer_nocite",st_kill(sp,sl,ST_ROLE_TRAINER),109);
    f=f+cl_check("a8_cites",mkcites(sp,sl,501,2),0);
    f=f+cl_check("a8_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a8_kill_trainer",st_kill(sp,sl,ST_ROLE_TRAINER),0);
    f=f+cl_check("a8_dead",g_live(sp,sl),0);
    let sl2:i32=-1;
    f=f+cl_check("a8_add2",st_add(sp,333,ST_REGION_USER,80,30,&sl2),0);
    f=f+cl_check("a8_recycle",st_recycle(sp,sl2,0,1,4,31),0);
    f=f+cl_check("a8_cites2",mkcites(sp,sl2,601,1),0);
    f=f+cl_check("a8_justify2",st_justify(sp,sl2,1),0);
    f=f+cl_check("a8_kill_lien_short",st_kill(sp,sl2,ST_ROLE_TRAINER),109);
    f=f+cl_check("a8_cites3",mkcites(sp,sl2,701,3),0);
    f=f+cl_check("a8_kill_lien_full",st_kill(sp,sl2,ST_ROLE_TRAINER),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A9: guard battery — pinned / force-pinned / core / dead / bad strength /
// bad purpose / bad stage / bad slot. Refusals leave state untouched.
fn atk_a9(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A9 guard-battery\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a9_add",st_add(sp,111,ST_REGION_USER,50,10,&sl),0);
    f=f+cl_check("a9_pin",st_pin(sp,sl),0);
    f=f+cl_check("a9_pinned",st_recycle(sp,sl,0,1,4,11),102);
    f=f+cl_check("a9_untouched_str",g_str(sp,sl),50);
    f=f+cl_check("a9_untouched_val",g_val(sp,sl),111);
    f=f+cl_check("a9_untouched_live",g_live(sp,sl),1);
    f=f+cl_check("a9_unpin",st_unpin(sp,sl),0);
    f=f+cl_check("a9_fpin",st_force_pin(sp,ST_ROLE_TRAINER,7,sl),0);
    f=f+cl_check("a9_forcepinned",st_recycle(sp,sl,0,1,4,11),112);
    f=f+cl_check("a9_funpin",st_force_unpin(sp,ST_ROLE_TRAINER,7,sl),0);
    f=f+cl_check("a9_core",st_recycle(sp,0,0,1,4,11),101);
    f=f+cl_check("a9_str0",st_recycle(sp,sl,0,0,4,11),117);
    f=f+cl_check("a9_str101",st_recycle(sp,sl,0,101,4,11),117);
    let n0:i32=an(sp);
    f=f+cl_check("a9_purpose0",st_recycle(sp,sl,0,1,0,11),2001);
    f=f+cl_check("a9_noentry",an(sp),n0);
    f=f+cl_check("a9_purpose8",st_recycle(sp,sl,0,1,8,11),2001);
    f=f+cl_check("a9_badslot_neg",st_recycle(sp,-1,0,1,4,11),2001);
    f=f+cl_check("a9_badslot_big",st_recycle(sp,999,0,1,4,11),2001);
    f=f+cl_check("a9_setstage",st_set_stage(sp,ST_STAGE_ADD),0);
    f=f+cl_check("a9_stage",st_recycle(sp,sl,0,1,4,11),105);
    f=f+cl_check("a9_setstage2",st_set_stage(sp,ST_STAGE_FULL),0);
    f=f+cl_check("a9_cites",mkcites(sp,sl,501,2),0);
    f=f+cl_check("a9_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a9_del",st_delete_strong(sp,sl),0);
    f=f+cl_check("a9_deadslot",st_recycle(sp,sl,0,1,4,11),122);
    f=f+cl_check("a9_refusals_clean",st_refusals_clean(sp),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A10: P3-baseline probe — does the lien survive protection expiry?
// (Law-silent: mechanism and checker are expected to agree here.)
fn atk_a10(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A10 p3-baseline-vs-lien\n");
    seed(sp);
    st_set_p3(sp,1,10);
    let sl:i32=-1;
    f=f+cl_check("a10_add",st_add(sp,111,ST_REGION_USER,100,10,&sl),0);
    f=f+cl_check("a10_recycle",st_recycle(sp,sl,0,1,4,0),0);
    f=f+cl_check("a10_lien",stored_lien(sp,sl),100);
    st_set_episode(sp,100);
    // cite an OLD episode: it counts toward the baseline price without
    // refreshing protection (last_cite tracks the cited episode value,
    // not wall-clock). The cite must precede the PEXPIRED marker, mirroring
    // the checker's ck_pexp model.
    f=f+cl_check("a10_cites",mkcites(sp,sl,5,1),0);
    f=f+cl_check("a10_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a10_pexp",st_protection_expired(sp,sl,100),0);
    f=f+cl_check("a10_setstage",st_set_stage(sp,ST_STAGE_KILL),0);
    let rc:i32=st_delete_strong(sp,sl);
    f=f+cl_check("a10_del_baseline",rc,0);
    f=f+ck_verify(sp,3,0,0,100,1);
    return f;
}

// A11: rollback games — double rollback refused; delete->rollback->delete
// is not cheaper; a settled lien does not carry past a priced destruction.
fn atk_a11(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A11 rollback-games\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a11_add",st_add(sp,111,ST_REGION_USER,60,10,&sl),0);
    f=f+cl_check("a11_recycle",st_recycle(sp,sl,0,1,4,11),0);
    f=f+cl_check("a11_rb1",st_rollback_last(sp),0);
    f=f+cl_check("a11_rb2",st_rollback_last(sp),108);
    let sl2:i32=-1;
    f=f+cl_check("a11_add2",st_add(sp,222,ST_REGION_USER,60,20,&sl2),0);
    f=f+cl_check("a11_cites",mkcites(sp,sl2,501,3),0);
    f=f+cl_check("a11_justify",st_justify(sp,sl2,1),0);
    f=f+cl_check("a11_del1",st_delete_strong(sp,sl2),0);
    f=f+cl_check("a11_rb3",st_rollback_last(sp),0);
    f=f+cl_check("a11_back",g_live(sp,sl2),1);
    f=f+cl_check("a11_back_str",g_str(sp,sl2),60);
    f=f+cl_check("a11_cites2",mkcites(sp,sl2,601,1),0);
    f=f+cl_check("a11_justify2",st_justify(sp,sl2,1),0);
    f=f+cl_check("a11_del_short",st_delete_strong(sp,sl2),121);
    f=f+cl_check("a11_cites3",mkcites(sp,sl2,701,2),0);
    f=f+cl_check("a11_del2",st_delete_strong(sp,sl2),0);
    let sl3:i32=-1;
    f=f+cl_check("a11_add3",st_add(sp,333,ST_REGION_USER,100,30,&sl3),0);
    f=f+cl_check("a11_r1",st_recycle(sp,sl3,0,1,4,31),0);
    f=f+cl_check("a11_cites4",mkcites(sp,sl3,801,4),0);
    f=f+cl_check("a11_justify3",st_justify(sp,sl3,1),0);
    f=f+cl_check("a11_del3",st_delete_strong(sp,sl3),0);
    f=f+cl_check("a11_rb4",st_rollback_last(sp),0);
    f=f+cl_check("a11_r2",st_recycle(sp,sl3,0,1,4,32),0);
    f=f+cl_check("a11_lien_settled",stored_lien(sp,sl3),1);
    f=f+cl_check("a11_cites5",mkcites(sp,sl3,901,1),0);
    f=f+cl_check("a11_justify4",st_justify(sp,sl3,1),0);
    f=f+cl_check("a11_del4",st_delete_strong(sp,sl3),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A12: overwrite after a recycle is lien-priced, and it SETTLES the lien.
fn atk_a12(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A12 overwrite-after-recycle\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a12_add",st_add(sp,111,ST_REGION_USER,100,10,&sl),0);
    f=f+cl_check("a12_r1",st_recycle(sp,sl,0,1,4,11),0);
    f=f+cl_check("a12_cites",mkcites(sp,sl,501,1),0);
    f=f+cl_check("a12_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a12_ow_short",st_overwrite(sp,sl,777,30,12),109);
    f=f+cl_check("a12_cites2",mkcites(sp,sl,601,3),0);
    f=f+cl_check("a12_ow",st_overwrite(sp,sl,777,30,12),0);
    f=f+cl_check("a12_newval",g_val(sp,sl),777);
    f=f+cl_check("a12_r2",st_recycle(sp,sl,0,1,4,13),0);
    f=f+cl_check("a12_lien_settled",stored_lien(sp,sl),30);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}


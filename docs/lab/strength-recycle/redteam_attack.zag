// A14: recycle->recycle->delete still costs the full original price.
fn atk_a14(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A14 chain-then-delete\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a14_add",st_add(sp,111,ST_REGION_USER,80,10,&sl),0);
    f=f+cl_check("a14_r1",st_recycle(sp,sl,0,1,4,11),0);
    f=f+cl_check("a14_lien1",stored_lien(sp,sl),80);
    f=f+cl_check("a14_r2",st_recycle(sp,sl,0,1,6,12),0);
    f=f+cl_check("a14_lien2",stored_lien(sp,sl),80);
    f=f+cl_check("a14_cites",mkcites(sp,sl,501,4),0);
    f=f+cl_check("a14_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a14_del",st_delete_strong(sp,sl),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A15: strengthening after a recycle raises the later destruction price
// (max of new HW and lien).
fn atk_a15(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A15 strengthen-after-recycle\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a15_add",st_add(sp,111,ST_REGION_USER,50,10,&sl),0);
    f=f+cl_check("a15_recycle",st_recycle(sp,sl,0,10,4,11),0);
    f=f+cl_check("a15_lien",stored_lien(sp,sl),50);
    f=f+cl_check("a15_stren",st_strengthen(sp,sl,90,1),0);
    f=f+cl_check("a15_cites",mkcites(sp,sl,501,3),0);
    f=f+cl_check("a15_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a15_del_short",st_delete_strong(sp,sl),109);
    f=f+cl_check("a15_cites2",mkcites(sp,sl,601,1),0);
    f=f+cl_check("a15_del",st_delete_strong(sp,sl),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A16: kill_evidenced after a recycle is lien-priced.
fn atk_a16(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A16 kill-evidenced-after-recycle\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a16_add",st_add(sp,111,ST_REGION_USER,70,10,&sl),0);
    f=f+cl_check("a16_recycle",st_recycle(sp,sl,0,1,4,11),0);
    f=f+cl_check("a16_cites",mkcites(sp,sl,501,1),0);
    f=f+cl_check("a16_justify",st_justify(sp,sl,1),0);
    f=f+cl_check("a16_ke_short",st_kill_evidenced(sp,sl),109);
    f=f+cl_check("a16_cites2",mkcites(sp,sl,601,2),0);
    f=f+cl_check("a16_ke",st_kill_evidenced(sp,sl),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A17: recycle does NOT free capacity — the placeholder occupies the slot
// until a priced destruction clears it.
fn atk_a17(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A17 recycle-frees-no-capacity\n");
    seed(sp);
    let a:i32=-1;let b:i32=-1;let c:i32=-1;let d:i32=-1;
    f=f+cl_check("a17_add_a",st_add(sp,101,ST_REGION_USER,100,10,&a),0);
    f=f+cl_check("a17_add_b",st_add(sp,102,ST_REGION_USER,20,11,&b),0);
    f=f+cl_check("a17_add_c",st_add(sp,103,ST_REGION_USER,20,12,&c),0);
    f=f+cl_check("a17_add_d",st_add(sp,104,ST_REGION_USER,20,13,&d),0);
    f=f+cl_check("a17_recycle",st_recycle(sp,a,0,1,4,14),0);
    let e:i32=-1;
    f=f+cl_check("a17_add_full",st_add(sp,999,ST_REGION_USER,10,15,&e),104);
    f=f+cl_check("a17_no_slot",e,-1);
    f=f+cl_check("a17_cites",mkcites(sp,a,501,4),0);
    f=f+cl_check("a17_justify",st_justify(sp,a,1),0);
    f=f+cl_check("a17_del",st_delete_strong(sp,a),0);
    f=f+cl_check("a17_add_e",st_add(sp,999,ST_REGION_USER,10,15,&e),0);
    f=f+cl_check("a17_slot_reused",e,a);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A18: admit_ep is unvalidated (stored as-is); negative admits just disable
// P3 expiry for the slot.
fn atk_a18(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A18 admit-ep-unvalidated\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a18_add",st_add(sp,111,ST_REGION_USER,40,10,&sl),0);
    f=f+cl_check("a18_recycle",st_recycle(sp,sl,0,1,4,-5),0);
    f=f+cl_check("a18_step_ep",g_step_ep(sp,sl),-5);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A19: abandon never mutates; rollback of a non-mutating entry is refused.
fn atk_a19(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A19 abandon-no-mutation\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a19_add",st_add(sp,111,ST_REGION_USER,50,10,&sl),0);
    f=f+cl_check("a19_recycle",st_recycle(sp,sl,0,1,4,11),0);
    f=f+cl_check("a19_abandon",st_abandon(sp,sl,3),0);
    f=f+cl_check("a19_still_live",g_live(sp,sl),1);
    f=f+cl_check("a19_rb_abandon",st_rollback_last(sp),108);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A21: evidence/justify entries cannot be rolled back (no un-recording).
fn atk_a21(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A21 no-rollback-of-evidence\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a21_add",st_add(sp,111,ST_REGION_USER,50,10,&sl),0);
    f=f+cl_check("a21_ev",st_evidence(sp,sl,1,501),0);
    f=f+cl_check("a21_rb_ev",st_rollback_last(sp),108);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A22: liens are per-slot — recycling X does not discount or tax Y.
fn atk_a22(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A22 per-slot-lien-isolation\n");
    seed(sp);
    let slx:i32=-1;let sly:i32=-1;
    f=f+cl_check("a22_addx",st_add(sp,111,ST_REGION_USER,100,10,&slx),0);
    f=f+cl_check("a22_addy",st_add(sp,222,ST_REGION_USER,100,11,&sly),0);
    f=f+cl_check("a22_recx",st_recycle(sp,slx,0,1,4,12),0);
    f=f+cl_check("a22_citesy",mkcites(sp,sly,501,4),0);
    f=f+cl_check("a22_justifyy",st_justify(sp,sly,1),0);
    f=f+cl_check("a22_dely",st_delete_strong(sp,sly),0);
    f=f+cl_check("a22_citesx",mkcites(sp,slx,601,4),0);
    f=f+cl_check("a22_justifyx",st_justify(sp,slx,1),0);
    f=f+cl_check("a22_delx",st_delete_strong(sp,slx),0);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

// A23: a REFUSED priced destruction does not settle the lien.
fn atk_a23(sp:*StStore)i32 {
    let f:i32=0;
    _zag_print("A23 refused-destruction-no-settle\n");
    seed(sp);
    let sl:i32=-1;
    f=f+cl_check("a23_add",st_add(sp,111,ST_REGION_USER,100,10,&sl),0);
    f=f+cl_check("a23_r1",st_recycle(sp,sl,0,1,4,11),0);
    f=f+cl_check("a23_del_refused",st_delete_strong(sp,sl),109);
    f=f+cl_check("a23_r2",st_recycle(sp,sl,0,1,4,12),0);
    f=f+cl_check("a23_lien",stored_lien(sp,sl),100);
    f=f+ck_verify(sp,2,0,0,0,1);
    return f;
}

fn main()i32 {
    let f:i32=0;
    _zag_print("REDTEAM_RECYCLE blind attack battery\n");
    let s1:StStore=st_init(8,4096);

// recycle_attack.zag — adversarial probes of the recycle/delete boundary
// (implementer verification; the BLIND red team runs separately after freeze).
// Each attack prints CL_CHECK lines; the driver returns nonzero on any failure.
@import("strength_core.zag")
@import("strength_checker.zag")
@import("substrate/cl/common.zag")

fn atk_cite_double_spend()i32 {
    // R1: old cites cannot pay for post-recycle destruction.
    // add(80) -> 4 cites -> recycle to 10 -> delete with NO new cites.
    // Must be refused: the recycle detached the old cites (new window).
    let s:StStore=st_init(32,16384);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(sp,50,ST_REGION_USER,80,0,&sl);
    let k:i32=0;
    while(k<4){st_evidence(sp,sl,ST_J_CONTRADICTED,100+k);k=k+1;}
    let f:i32=0;
    f=f+cl_check("r1_recycle_ok",st_recycle(sp,sl,51,10,ST_J_SUPERSEDED,1),ST_OK);
    st_justify(sp,sl,ST_J_CONTRADICTED);
    // no fresh cites: delete must be refused (need n(max(10,80))=4, have 0)
    f=f+cl_check("r1_delete_no_fresh_cites_refused",st_delete_strong(sp,sl),ST_REFUSED_EFFORT);
    // now 4 FRESH cites -> delete OK (no double-spend, just fresh payment)
    let j:i32=0;
    while(j<4){st_evidence(sp,sl,ST_J_CONTRADICTED,200+j);j=j+1;}
    st_justify(sp,sl,ST_J_CONTRADICTED);
    f=f+cl_check("r1_delete_fresh_cites_ok",st_delete_strong(sp,sl),ST_OK);
    f=f+ck_verify(sp,0,0,0,500,1);
    st_free(sp);
    return f;
}
fn atk_free_retirement()i32 {
    // R2: recycle an 80-strength judgment into a 1-strength placeholder,
    // then try to delete the placeholder cheaply (n(1)=1 cite).
    // Must be refused: lien=80 -> need 4.
    let s:StStore=st_init(32,16384);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(sp,50,ST_REGION_USER,80,0,&sl);
    let f:i32=0;
    f=f+cl_check("r2_retire_ok",st_recycle(sp,sl,0,1,ST_J_PRESSURE_VICTIM,1),ST_OK);
    f=f+cl_check("r2_placeholder_live",(sp.*.live[sl] as i32),1);
    st_evidence(sp,sl,ST_J_CONTRADICTED,300);
    st_justify(sp,sl,ST_J_CONTRADICTED);
    f=f+cl_check("r2_cheap_delete_refused",st_delete_strong(sp,sl),ST_REFUSED_EFFORT);
    let j:i32=1;
    while(j<4){st_evidence(sp,sl,ST_J_CONTRADICTED,300+j);j=j+1;}
    st_justify(sp,sl,ST_J_CONTRADICTED);
    f=f+cl_check("r2_full_price_delete_ok",st_delete_strong(sp,sl),ST_OK);
    f=f+ck_verify(sp,0,0,0,500,1);
    st_free(sp);
    return f;
}
fn atk_rollback_lien()i32 {
    // R3: recycle then ROLLBACK the recycle, then delete.
    // The lien must STAND (conservative): no underpricing through rollback.
    let s:StStore=st_init(32,16384);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(sp,50,ST_REGION_USER,80,0,&sl);
    let f:i32=0;
    f=f+cl_check("r3_recycle_ok",st_recycle(sp,sl,51,10,ST_J_SUPERSEDED,1),ST_OK);
    f=f+cl_check("r3_rollback_ok",st_rollback_last(sp),ST_OK);
    f=f+cl_check("r3_judgment_restored",(sp.*.strength[sl] as i32),80);
    // delete now: needs n(80)=4 either way (restored 80, lien 80 stands)
    st_evidence(sp,sl,ST_J_CONTRADICTED,400);
    st_evidence(sp,sl,ST_J_CONTRADICTED,401);
    st_justify(sp,sl,ST_J_CONTRADICTED);
    f=f+cl_check("r3_delete_2_cites_refused",st_delete_strong(sp,sl),ST_REFUSED_EFFORT);
    st_evidence(sp,sl,ST_J_CONTRADICTED,402);
    st_evidence(sp,sl,ST_J_CONTRADICTED,403);
    st_justify(sp,sl,ST_J_CONTRADICTED);
    f=f+cl_check("r3_delete_4_cites_ok",st_delete_strong(sp,sl),ST_OK);
    f=f+ck_verify(sp,0,0,0,500,1);
    st_free(sp);
    return f;
}
fn atk_lien_cleared_on_payment()i32 {
    // R4: paid debts do not carry. recycle(80->10, lien 80) -> priced delete
    // (pay 4) -> add fresh 20 -> delete needs n(20)=1, not 4.
    let s:StStore=st_init(32,16384);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(sp,50,ST_REGION_USER,80,0,&sl);
    let f:i32=0;
    f=f+cl_check("r4_recycle_ok",st_recycle(sp,sl,51,10,ST_J_SUPERSEDED,1),ST_OK);
    let j:i32=0;
    while(j<4){st_evidence(sp,sl,ST_J_CONTRADICTED,500+j);j=j+1;}
    st_justify(sp,sl,ST_J_CONTRADICTED);
    f=f+cl_check("r4_delete_paid",st_delete_strong(sp,sl),ST_OK);
    let sl2:i32=-1;
    st_add(sp,52,ST_REGION_USER,20,2,&sl2);
    st_evidence(sp,sl2,ST_J_CONTRADICTED,600);
    st_justify(sp,sl2,ST_J_CONTRADICTED);
    f=f+cl_check("r4_new_judgment_cheap_delete",st_delete_strong(sp,sl2),ST_OK);
    f=f+ck_verify(sp,0,0,0,500,1);
    st_free(sp);
    return f;
}
fn atk_recycle_chain()i32 {
    // R5: recycle chain keeps the max lien: 80 -> 50 -> 10, delete needs 4.
    let s:StStore=st_init(32,16384);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(sp,50,ST_REGION_USER,80,0,&sl);
    let f:i32=0;
    f=f+cl_check("r5_r1_ok",st_recycle(sp,sl,51,50,ST_J_SUPERSEDED,1),ST_OK);
    f=f+cl_check("r5_r2_ok",st_recycle(sp,sl,52,10,ST_J_SUPERSEDED,2),ST_OK);
    st_evidence(sp,sl,ST_J_CONTRADICTED,700);
    st_evidence(sp,sl,ST_J_CONTRADICTED,701);
    st_justify(sp,sl,ST_J_CONTRADICTED);
    f=f+cl_check("r5_chain_discount_refused",st_delete_strong(sp,sl),ST_REFUSED_EFFORT);
    f=f+ck_verify(sp,0,0,0,500,1);
    st_free(sp);
    return f;
}
fn atk_recycle_guards()i32 {
    // R6: guards — core region, force-pin, dead slot, bad purpose, stage.
    let s:StStore=st_init(32,16384);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let f:i32=0;
    // core slot (slot 0 is core)
    f=f+cl_check("r6_core_refused",st_recycle(sp,0,1,10,ST_J_SUPERSEDED,1),ST_REFUSED_CORE);
    let sl:i32=-1;
    st_add(sp,50,ST_REGION_USER,40,0,&sl);
    st_force_pin(sp,ST_ROLE_TRAINER,7,sl);
    f=f+cl_check("r6_forcepinned_refused",st_recycle(sp,sl,51,10,ST_J_SUPERSEDED,1),ST_REFUSED_FORCEPIN);
    st_force_unpin(sp,ST_ROLE_TRAINER,7,sl);
    // dead slot: never added (slot 5)
    f=f+cl_check("r6_dead_refused",st_recycle(sp,5,1,10,ST_J_SUPERSEDED,1),ST_REFUSED_DEADSLOT);
    // stage gate
    st_set_stage(sp,ST_STAGE_KILL);
    f=f+cl_check("r6_kill_stage_recycle_ok",st_recycle(sp,sl,51,10,ST_J_SUPERSEDED,1),ST_OK);
    st_set_stage(sp,ST_STAGE_FULL);
    f=f+cl_check("r6_ok_after_stage",st_recycle(sp,sl,51,10,ST_J_SUPERSEDED,1),ST_OK);
    f=f+ck_verify(sp,0,0,0,500,1);
    st_free(sp);
    return f;
}
fn main()i32 {
    let f:i32=0;
    f=f+atk_cite_double_spend();
    f=f+atk_free_retirement();
    f=f+atk_rollback_lien();
    f=f+atk_lien_cleared_on_payment();
    f=f+atk_recycle_chain();
    f=f+atk_recycle_guards();
    _zag_print("RECYCLE_ATTACK_F ");
    let s:[]u8=_zag_i64_to_str(f as i64);
    _zag_print(s);nio_free(s);
    _zag_print("\n");
    return f;
}

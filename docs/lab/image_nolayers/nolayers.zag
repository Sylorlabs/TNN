// nolayers.zag — ONE vocabulary, ONE deliberative pass. No layers.
//
// (image_nolayers; Micah order 2026-09-26 ~09:27 PDT: "it got it after a
// bunch of layers, but it should get it without. Try that fork and see
// what happens: do layers help or are they needed?")
//
// TNN's single knowledge claim about the image:
//   "I looked at region R and saw an instance of the shape I saw at
//    exemplar E; its mean color is (r,g,b)."
// There are no separate structure / edge / texture stages, no handed
// layer boundaries, no separate vocabularies. One pool of shape atoms,
// one recursive deliberation, one selection criterion (gain per byte).
//
// Mechanism:
//   SURVEY: TNN measures, per scale, the energy left if every block were
//     flat at its mean — it looks at the image before organizing.
//   VOCABULARY: shape atoms = exemplar patches (mean-subtracted) at
//     scales {64,32,16,8,4}, selected by ONE farthest-point deliberation
//     per scale over the union of candidate blocks. Atom 0 of every
//     scale is the NULL shape ("flat at its mean"). Selection converges
//     on marginal explained-energy tau_s = 9 * 3 * s^2 (per-value 9,
//     the precedent of v2's never-triggered T_TEX=1728 on 8x8) — a
//     precision parameter, never a motif-count cap.
//   ASSIGNMENT (the single deliberation): nested block grids. Each
//     region either TAKES its best same-scale atom (+ free per-region
//     mean) or SPLITS into four children. The decision is gain-per-byte
//     against the flat-mean baseline, exact integer cross-multiplication,
//     ties -> TAKE (coarser wins). Floor at 4x4 (must take). Every
//     decision is TNN's own organization of the knowledge — the scale
//     map this produces is where TNN itself chose to look closely.
//   RENDER: pixel = clamp(atom_shape + region_mean). Two white-box
//     paths: A (ingest, per-pixel via region-id map) and B (emit,
//     per-region stamping). They must agree byte-identically.
//   RESIDUAL: the honest error channel (see common_nl.zag), excluded
//     from understanding metrics, exactly as in the layered pipeline.
//
// Zero RNG. Deterministic: lowest-index tie-breaks everywhere, canonical
// block order, explicit initialization.
@import("./common_nl.zag")

// scale table: si 0..4 -> 64,32,16,8,4
fn s_of(si:i64) i64 {
    if (si == 0) { return 64; }
    if (si == 1) { return 32; }
    if (si == 2) { return 16; }
    if (si == 3) { return 8; }
    return 4;
}

// convergence threshold per scale: 9 per value (3*s*s values)
fn tau_of(si:i64) i64 {
    let s:i64 = s_of(si);
    return 9 * 3 * s * s;
}

// Mean-subtracted i16 patch of rect (x0,y0,bw,bh).
// mean[0..2] out (i64); sub = bw*bh*3 i16 (caller-sized >= bw*bh*6 bytes);
// e0[0] = SSD of the rect from its own mean (the flat-block energy).
fn block_patch_sub(pix:[]u8, w:i64, x0:i64, y0:i64, bw:i64, bh:i64,
    mean:[]i64, sub:[]u8, e0:[]i64) void {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
    let yy:i64 = 0;
    while (yy < bh) {
        let xx:i64 = 0;
        while (xx < bw) {
            let p:i64 = ((y0 + yy) * w + (x0 + xx)) * 3;
            sr = sr + (pix[p] as i64);
            sg = sg + (pix[p + 1] as i64);
            sb = sb + (pix[p + 2] as i64);
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    let n:i64 = bw * bh;
    mean[0] = sr / n; mean[1] = sg / n; mean[2] = sb / n;
    let e:i64 = 0;
    let yy2:i64 = 0;
    while (yy2 < bh) {
        let xx2:i64 = 0;
        while (xx2 < bw) {
            let p2:i64 = ((y0 + yy2) * w + (x0 + xx2)) * 3;
            let q:i64 = (yy2 * bw + xx2) * 6;
            let d0:i64 = (pix[p2] as i64) - mean[0];
            let d1:i64 = (pix[p2 + 1] as i64) - mean[1];
            let d2:i64 = (pix[p2 + 2] as i64) - mean[2];
            w_i16le(sub, q, d0);
            w_i16le(sub, q + 2, d1);
            w_i16le(sub, q + 4, d2);
            e = e + d0 * d0 + d1 * d1 + d2 * d2;
            xx2 = xx2 + 1;
        }
        yy2 = yy2 + 1;
    }
    e0[0] = e;
}

// ---------------- SURVEY ----------------
// TNN looks at the image before organizing: per scale, the total energy
// that would remain if every block were flat at its own mean. out[si].
// Also writes the whole-image energy vs its global mean into out[5].
fn survey(pix:[]u8, w:i64, h:i64, out:[]i64) void {
    let gsr:i64 = 0; let gsg:i64 = 0; let gsb:i64 = 0;
    let npix:i64 = w * h;
    let pi:i64 = 0;
    while (pi < npix) {
        gsr = gsr + (pix[pi * 3] as i64);
        gsg = gsg + (pix[pi * 3 + 1] as i64);
        gsb = gsb + (pix[pi * 3 + 2] as i64);
        pi = pi + 1;
    }
    let gmr:i64 = gsr / npix; let gmg:i64 = gsg / npix; let gmb:i64 = gsb / npix;
    let etot:i64 = 0;
    pi = 0;
    while (pi < npix) {
        let dr:i64 = (pix[pi * 3] as i64) - gmr;
        let dg:i64 = (pix[pi * 3 + 1] as i64) - gmg;
        let db:i64 = (pix[pi * 3 + 2] as i64) - gmb;
        etot = etot + dr * dr + dg * dg + db * db;
        pi = pi + 1;
    }
    out[5] = etot;
    let si:i64 = 0;
    while (si < 5) {
        let s:i64 = s_of(si);
        let nc:i64 = (w + s - 1) / s;
        let nr:i64 = (h + s - 1) / s;
        let tot:i64 = 0;
        let mean:[]i64 = nio_alloc(24) as []i64;
        let e0a:[]i64 = nio_alloc(8) as []i64;
        let sub:[]u8 = nio_alloc((s * s * 6) as i32);
        let bi:i64 = 0;
        while (bi < nc * nr) {
            let bx:i64 = bi % nc;
            let by:i64 = bi / nc;
            let x0:i64 = bx * s;
            let y0:i64 = by * s;
            let bw:i64 = s;
            if (x0 + bw > w) { bw = w - x0; }
            let bh:i64 = s;
            if (y0 + bh > h) { bh = h - y0; }
            block_patch_sub(pix, w, x0, y0, bw, bh, mean, sub, e0a);
            tot = tot + e0a[0];
            bi = bi + 1;
        }
        out[si] = tot;
        nio_free(mean);
        nio_free(e0a);
        nio_free(sub);
        si = si + 1;
    }
}

// ---------------- ONE farthest-point vocabulary per scale ----------------
// bdet: nb*s*s*3 i16 values (mean-subtracted), block-major; bval[bi] =
// valid value count; cand/ncand = full-block candidate indices.
// atoms: cap*s*s*3*2 bytes out; aex[0] = -1 (NULL shape); agains[na] =
// the min-distance that earned atom na its place (agains[0] = 0).
// tau: stop when the best new atom is within tau of the set.
// gains[0] = last adopted gain, gains[1] = first adopted gain.
// Returns na (>= 1). cap is data-derived (<= candidate count).
fn fp_atoms(bdet:[]u8, bval:[]i64, s:i64, nb:i64, cand:[]i64, ncand:i64,
    atoms:[]u8, aex:[]i64, agains:[]i64, cap:i64, tau:i64, gains:[]i64) i64 {
    let nv:i64 = s * s * 3;
    let mbytes:i64 = nv * 2;
    let zk:i64 = 0;
    while (zk < nv) { w_i16le(atoms, zk * 2, 0); zk = zk + 1; }
    aex[0] = -1;
    agains[0] = 0;
    let na:i64 = 1;
    gains[0] = 0;
    gains[1] = 0;
    if (ncand == 0) { return 1; }
    let energy:[]i64 = nio_alloc((ncand * 8) as i32) as []i64;
    if (energy.len == 0) { return -1; }
    let mind:[]i64 = nio_alloc((ncand * 8) as i32) as []i64;
    if (mind.len == 0) { return -1; }
    let ci:i64 = 0;
    while (ci < ncand) {
        let bi:i64 = cand[ci];
        let e:i64 = 0;
        let k:i64 = 0;
        while (k < bval[bi]) {
            let v:i64 = r_i16le(bdet, bi * mbytes + k * 2);
            e = e + v * v;
            k = k + 1;
        }
        energy[ci] = e;
        mind[ci] = e;
        ci = ci + 1;
    }
    let best:i64 = 0;
    let bk:i64 = 1;
    while (bk < ncand) {
        if (energy[bk] > energy[best]) { best = bk; }
        bk = bk + 1;
    }
    gains[1] = energy[best];
    // sel_gain = the min-distance that selected `best` (its marginal gain).
    // For the first atom this is its energy = distance from the NULL shape.
    let sel_gain:i64 = energy[best];
    let go:i64 = 1;
    while (go == 1) {
        let exbi:i64 = cand[best];
        aex[na] = exbi;
        agains[na] = sel_gain;
        let k2:i64 = 0;
        while (k2 < nv) {
            w_i16le(atoms, na * mbytes + k2 * 2, r_i16le(bdet, exbi * mbytes + k2 * 2));
            k2 = k2 + 1;
        }
        na = na + 1;
        let nbest:i64 = 0;
        let nbestd:i64 = -1;
        let ck:i64 = 0;
        while (ck < ncand) {
            let dd:i64 = 0;
            let k3:i64 = 0;
            let cb:i64 = cand[ck] * mbytes;
            let eb:i64 = exbi * mbytes;
            let nvv:i64 = bval[cand[ck]];
            while (k3 < nvv) {
                let dv:i64 = r_i16le(bdet, cb + k3 * 2) - r_i16le(bdet, eb + k3 * 2);
                dd = dd + dv * dv;
                k3 = k3 + 1;
            }
            if (dd < mind[ck]) { mind[ck] = dd; }
            if (mind[ck] > nbestd) { nbestd = mind[ck]; nbest = ck; }
            ck = ck + 1;
        }
        gains[0] = nbestd;
        sel_gain = nbestd;
        if (na >= cap) { go = 0; }
        if (nbestd < tau) { go = 0; }
        best = nbest;
    }
    nio_free(energy);
    nio_free(mind);
    return na;
}

// ---------------- THE single deliberation: take or split ----------------
// For block bi at scale si, TNN decides: TAKE the best same-scale shape
// atom (+ free per-region mean), or SPLIT into four children (si+1).
// Criterion: gain-per-byte vs the flat-mean baseline e0, exact integer
// cross-multiplication; ties -> TAKE (coarser wins). Floor at si=4.
// Appends final-region records (x,y,s,atom,r,g,b) to rx..rb, nreg[0].
// out[0] = optimal error, out[1] = optimal cost (bytes).
// ntake[si] / nsplit[si] count the decisions (the deliberation record).
fn deliberate_block(si:i64, bi:i64,
    pix:[]u8, w:i64, h:i64,
    a0:[]u8, na0:i64, a1:[]u8, na1:i64, a2:[]u8, na2:i64,
    a3:[]u8, na3:i64, a4:[]u8, na4:i64,
    rx:[]i64, ry:[]i64, rs:[]i64, rat:[]i64, rr:[]i64, rg:[]i64, rb:[]i64,
    nreg:[]i64, ntake:[]i64, nsplit:[]i64, out:[]i64) void {
    let s:i64 = s_of(si);
    let nc:i64 = (w + s - 1) / s;
    let bx:i64 = bi % nc;
    let by:i64 = bi / nc;
    let x0:i64 = bx * s;
    let y0:i64 = by * s;
    let bw:i64 = s;
    if (x0 + bw > w) { bw = w - x0; }
    let bh:i64 = s;
    if (y0 + bh > h) { bh = h - y0; }
    let atoms:[]u8 = a0;
    let na:i64 = na0;
    if (si == 1) { atoms = a1; na = na1; }
    if (si == 2) { atoms = a2; na = na2; }
    if (si == 3) { atoms = a3; na = na3; }
    if (si == 4) { atoms = a4; na = na4; }
    let mean:[]i64 = nio_alloc(24) as []i64;
    let e0a:[]i64 = nio_alloc(8) as []i64;
    let sub:[]u8 = nio_alloc((bw * bh * 6) as i32);
    block_patch_sub(pix, w, x0, y0, bw, bh, mean, sub, e0a);
    let e0:i64 = e0a[0];
    // TAKE evaluation: best atom; atom 0 (NULL shape) always available,
    // so ea <= e0 and the take-gain is never negative. Lowest index wins.
    let mb:i64 = s * s * 3 * 2;
    let ea:i64 = e0;
    let bata:i64 = 0;
    let a:i64 = 1;
    while (a < na) {
        let abase:i64 = a * mb;
        let dd:i64 = 0;
        let iy:i64 = 0;
        while (iy < bh) {
            let ix:i64 = 0;
            while (ix < bw) {
                let q:i64 = (iy * bw + ix) * 6;
                let aq:i64 = abase + (iy * s + ix) * 6;
                let dv0:i64 = r_i16le(sub, q) - r_i16le(atoms, aq);
                let dv1:i64 = r_i16le(sub, q + 2) - r_i16le(atoms, aq + 2);
                let dv2:i64 = r_i16le(sub, q + 4) - r_i16le(atoms, aq + 4);
                dd = dd + dv0 * dv0 + dv1 * dv1 + dv2 * dv2;
                ix = ix + 1;
            }
            iy = iy + 1;
        }
        if (dd < ea) { ea = dd; bata = a; }
        a = a + 1;
    }
    let ca:i64 = 10;
    if (si == 4) {
        let ri2:i64 = nreg[0];
        rx[ri2] = x0; ry[ri2] = y0; rs[ri2] = s; rat[ri2] = bata;
        rr[ri2] = mean[0]; rg[ri2] = mean[1]; rb[ri2] = mean[2];
        nreg[0] = ri2 + 1;
        ntake[si] = ntake[si] + 1;
        out[0] = ea; out[1] = ca;
        nio_free(mean); nio_free(e0a); nio_free(sub);
        return;
    }
    // SPLIT evaluation: recurse into the four children (si+1).
    // Snapshot the decision counters: if the parent TAKES, the children's
    // provisional decisions (and their region records) are rolled back.
    let nreg0:i64 = nreg[0];
    let tk0:i64 = ntake[0]; let tk1:i64 = ntake[1]; let tk2:i64 = ntake[2];
    let tk3:i64 = ntake[3]; let tk4:i64 = ntake[4];
    let sp0:i64 = nsplit[0]; let sp1:i64 = nsplit[1]; let sp2:i64 = nsplit[2];
    let sp3:i64 = nsplit[3]; let sp4:i64 = nsplit[4];
    let sn:i64 = s / 2;
    let ncn:i64 = (w + sn - 1) / sn;
    let nrn:i64 = (h + sn - 1) / sn;
    let es:i64 = 0;
    let cs:i64 = 0;
    let cout:[]i64 = nio_alloc(16) as []i64;
    let jy:i64 = 0;
    while (jy < 2) {
        let jx:i64 = 0;
        while (jx < 2) {
            let cbx:i64 = 2 * bx + jx;
            let cby:i64 = 2 * by + jy;
            if (cbx < ncn) {
                if (cby < nrn) {
                    let cbi:i64 = cby * ncn + cbx;
                    deliberate_block(si + 1, cbi, pix, w, h,
                        a0, na0, a1, na1, a2, na2, a3, na3, a4, na4,
                        rx, ry, rs, rat, rr, rg, rb, nreg, ntake, nsplit, cout);
                    es = es + cout[0];
                    cs = cs + cout[1];
                }
            }
            jx = jx + 1;
        }
        jy = jy + 1;
    }
    // DECIDE. (e0-ea)/ca vs (e0-es)/cs, cross-multiplied, exact.
    // Both gains are >= 0 (null atom; children never worse than flat).
    let gt:i64 = (e0 - ea) * cs;
    let gs:i64 = (e0 - es) * ca;
    if (gt >= gs) {
        nreg[0] = nreg0;
        ntake[0] = tk0; ntake[1] = tk1; ntake[2] = tk2;
        ntake[3] = tk3; ntake[4] = tk4;
        nsplit[0] = sp0; nsplit[1] = sp1; nsplit[2] = sp2;
        nsplit[3] = sp3; nsplit[4] = sp4;
        let ri3:i64 = nreg0;
        rx[ri3] = x0; ry[ri3] = y0; rs[ri3] = s; rat[ri3] = bata;
        rr[ri3] = mean[0]; rg[ri3] = mean[1]; rb[ri3] = mean[2];
        nreg[0] = ri3 + 1;
        ntake[si] = ntake[si] + 1;
        out[0] = ea; out[1] = ca;
    } else {
        nsplit[si] = nsplit[si] + 1;
        out[0] = es; out[1] = cs;
    }
    nio_free(mean); nio_free(e0a); nio_free(sub); nio_free(cout);
    return;
}

// ---------------- path A (ingest): per-pixel render via region-id map ----------------
// fb: RGB out. rid: per-pixel final-region index. atoms selected by region s.
fn nl_eval_inplace(fb:[]u8, w:i64, h:i64, rid:[]i64,
    a0:[]u8, a1:[]u8, a2:[]u8, a3:[]u8, a4:[]u8,
    rx:[]i64, ry:[]i64, rs:[]i64, rat:[]i64, rr:[]i64, rg:[]i64, rb:[]i64,
    nreg:i64) void {
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let ri:i64 = rid[y * w + x];
            let s:i64 = rs[ri];
            let at:i64 = rat[ri];
            let atoms:[]u8 = a0;
            if (s == 32) { atoms = a1; }
            if (s == 16) { atoms = a2; }
            if (s == 8) { atoms = a3; }
            if (s == 4) { atoms = a4; }
            let mb:i64 = s * s * 3 * 2;
            let lx:i64 = x - rx[ri];
            let ly:i64 = y - ry[ri];
            let aq:i64 = at * mb + (ly * s + lx) * 6;
            let p:i64 = (y * w + x) * 3;
            fb[p] = clamp8(rr[ri] + r_i16le(atoms, aq)) as u8;
            fb[p + 1] = clamp8(rg[ri] + r_i16le(atoms, aq + 2)) as u8;
            fb[p + 2] = clamp8(rb[ri] + r_i16le(atoms, aq + 4)) as u8;
            x = x + 1;
        }
        y = y + 1;
    }
}

// ---------------- path B (emit): per-region stamping ----------------
fn nl_stamp_regions(fb:[]u8, w:i64, h:i64,
    a0:[]u8, a1:[]u8, a2:[]u8, a3:[]u8, a4:[]u8,
    rx:[]i64, ry:[]i64, rs:[]i64, rat:[]i64, rr:[]i64, rg:[]i64, rb:[]i64,
    nreg:i64) void {
    let ri:i64 = 0;
    while (ri < nreg) {
        let x0:i64 = rx[ri];
        let y0:i64 = ry[ri];
        let s:i64 = rs[ri];
        let at:i64 = rat[ri];
        let atoms:[]u8 = a0;
        if (s == 32) { atoms = a1; }
        if (s == 16) { atoms = a2; }
        if (s == 8) { atoms = a3; }
        if (s == 4) { atoms = a4; }
        let mb:i64 = s * s * 3 * 2;
        let abase:i64 = at * mb;
        let bw:i64 = s;
        if (x0 + bw > w) { bw = w - x0; }
        let bh:i64 = s;
        if (y0 + bh > h) { bh = h - y0; }
        let iy:i64 = 0;
        while (iy < bh) {
            let ix:i64 = 0;
            while (ix < bw) {
                let aq:i64 = abase + (iy * s + ix) * 6;
                let p:i64 = ((y0 + iy) * w + (x0 + ix)) * 3;
                fb[p] = clamp8(rr[ri] + r_i16le(atoms, aq)) as u8;
                fb[p + 1] = clamp8(rg[ri] + r_i16le(atoms, aq + 2)) as u8;
                fb[p + 2] = clamp8(rb[ri] + r_i16le(atoms, aq + 4)) as u8;
                ix = ix + 1;
            }
            iy = iy + 1;
        }
        ri = ri + 1;
    }
}

// ---------------- canonical no-layers knowledge-map writer ----------------
// Format "TNNKNLM1":
//   magic[8]="TNNKNLM1" u64 w u64 h
//   u64 nscales(=5); per scale: u64 B; u64 na; na*(B*B*3 x i16); na*u64 exemplar
//   u64 nreg; nreg * (u16 x, u16 y, u8 s, u16 atom, u8 r, u8 g, u8 b) = 10 bytes
//   u64 nr; nr * (u64 pos + 3 x i16 dr,dg,db)
fn kmapnl_write(root:i64, name:[]u8, w:i64, h:i64,
    a0:[]u8, na0:i64, ex0:[]i64,
    a1:[]u8, na1:i64, ex1:[]i64,
    a2:[]u8, na2:i64, ex2:[]i64,
    a3:[]u8, na3:i64, ex3:[]i64,
    a4:[]u8, na4:i64, ex4:[]i64,
    nreg:i64, rx:[]i64, ry:[]i64, rs:[]i64, rat:[]i64,
    rr:[]i64, rg:[]i64, rb:[]i64,
    nr:i64, rpos:[]i64, rdelta:[]u8) i64 {
    let n0:i64 = 64 * 64 * 3; let n1:i64 = 32 * 32 * 3;
    let n2:i64 = 16 * 16 * 3; let n3:i64 = 8 * 8 * 3; let n4:i64 = 4 * 4 * 3;
    let total:i64 = 8 + 8 + 8 + 8
        + 8 + 8 + na0 * (n0 * 2 + 8)
        + 8 + 8 + na1 * (n1 * 2 + 8)
        + 8 + 8 + na2 * (n2 * 2 + 8)
        + 8 + 8 + na3 * (n3 * 2 + 8)
        + 8 + 8 + na4 * (n4 * 2 + 8)
        + 8 + nreg * 10
        + 8 + nr * (8 + 6);
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) { return -11; }
    buf[0] = 84; buf[1] = 78; buf[2] = 78; buf[3] = 75;
    buf[4] = 78; buf[5] = 76; buf[6] = 77; buf[7] = 49;
    let o:i64 = 8;
    w_u64le(buf, o, w); o = o + 8;
    w_u64le(buf, o, h); o = o + 8;
    w_u64le(buf, o, 5); o = o + 8;
    w_u64le(buf, o, 64); o = o + 8;
    w_u64le(buf, o, na0); o = o + 8;
    let i:i64 = 0;
    while (i < na0) {
        let j:i64 = 0;
        while (j < n0) {
            w_i16le(buf, o, r_i16le(a0, i * n0 * 2 + j * 2));
            o = o + 2; j = j + 1;
        }
        w_u64le(buf, o, ex0[i]); o = o + 8;
        i = i + 1;
    }
    w_u64le(buf, o, 32); o = o + 8;
    w_u64le(buf, o, na1); o = o + 8;
    i = 0;
    while (i < na1) {
        let j2:i64 = 0;
        while (j2 < n1) {
            w_i16le(buf, o, r_i16le(a1, i * n1 * 2 + j2 * 2));
            o = o + 2; j2 = j2 + 1;
        }
        w_u64le(buf, o, ex1[i]); o = o + 8;
        i = i + 1;
    }
    w_u64le(buf, o, 16); o = o + 8;
    w_u64le(buf, o, na2); o = o + 8;
    i = 0;
    while (i < na2) {
        let j3:i64 = 0;
        while (j3 < n2) {
            w_i16le(buf, o, r_i16le(a2, i * n2 * 2 + j3 * 2));
            o = o + 2; j3 = j3 + 1;
        }
        w_u64le(buf, o, ex2[i]); o = o + 8;
        i = i + 1;
    }
    w_u64le(buf, o, 8); o = o + 8;
    w_u64le(buf, o, na3); o = o + 8;
    i = 0;
    while (i < na3) {
        let j4:i64 = 0;
        while (j4 < n3) {
            w_i16le(buf, o, r_i16le(a3, i * n3 * 2 + j4 * 2));
            o = o + 2; j4 = j4 + 1;
        }
        w_u64le(buf, o, ex3[i]); o = o + 8;
        i = i + 1;
    }
    w_u64le(buf, o, 4); o = o + 8;
    w_u64le(buf, o, na4); o = o + 8;
    i = 0;
    while (i < na4) {
        let j5:i64 = 0;
        while (j5 < n4) {
            w_i16le(buf, o, r_i16le(a4, i * n4 * 2 + j5 * 2));
            o = o + 2; j5 = j5 + 1;
        }
        w_u64le(buf, o, ex4[i]); o = o + 8;
        i = i + 1;
    }
    w_u64le(buf, o, nreg); o = o + 8;
    i = 0;
    while (i < nreg) {
        w_u16le(buf, o, rx[i]); o = o + 2;
        w_u16le(buf, o, ry[i]); o = o + 2;
        buf[o] = rs[i] as u8; o = o + 1;
        w_u16le(buf, o, rat[i]); o = o + 2;
        buf[o] = rr[i] as u8; o = o + 1;
        buf[o] = rg[i] as u8; o = o + 1;
        buf[o] = rb[i] as u8; o = o + 1;
        i = i + 1;
    }
    w_u64le(buf, o, nr); o = o + 8;
    i = 0;
    while (i < nr) {
        w_u64le(buf, o, rpos[i]); o = o + 8;
        w_i16le(buf, o, r_i16le(rdelta, i * 6)); o = o + 2;
        w_i16le(buf, o, r_i16le(rdelta, i * 6 + 2)); o = o + 2;
        w_i16le(buf, o, r_i16le(rdelta, i * 6 + 4)); o = o + 2;
        i = i + 1;
    }
    let rc:i64 = file_write(root, name, buf);
    nio_free(buf);
    return rc;
}

// common_nl.zag — shared plumbing for the NO-LAYERS image capture fork.
// (image_nolayers; Micah order 2026-09-26 ~09:27 PDT)
//
// Contents:
//   - little-endian accessors over []u8 arenas (ZNC-007: no `as []i32`
//     casts; []u8 arenas + explicit accessors; `as []i64` verified clean)
//   - clamp8 / parse_i64
//   - bmp_write (24-bit BMP, RGB top-down -> BGR bottom-up)
//   - file_write / file_read_all (raw bytes via nio)
//   - deliberate_residual / residual_apply (the honest error channel —
//     NOT an understanding layer; excluded from understanding metrics)
//
// NOTE: this fork has no structure / edge / texture layer machinery.
// There is exactly one vocabulary (shape atoms) and one deliberation.
@import("./R33_NATIVE_IO_V1.zag")

// ---------------- LE accessors ----------------
fn r_u32le(b:[]u8, o:i64) i64 {
    return (b[o] as i64) + ((b[o + 1] as i64) << 8) + ((b[o + 2] as i64) << 16) + ((b[o + 3] as i64) << 24);
}
fn r_i32le(b:[]u8, o:i64) i64 {
    let v:i64 = r_u32le(b, o);
    if (v >= 2147483648) { v = v - 4294967296; }
    return v;
}
fn r_u16le(b:[]u8, o:i64) i64 {
    return (b[o] as i64) + ((b[o + 1] as i64) << 8);
}
fn w_u16le(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
}
fn w_u32le(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
}
fn w_u64le(b:[]u8, o:i64, v:i64) void {
    w_u32le(b, o, v & 4294967295);
    w_u32le(b, o + 4, (v >> 32) & 4294967295);
}
fn r_u64le(b:[]u8, o:i64) i64 {
    let lo:i64 = r_u32le(b, o);
    let hi:i64 = r_u32le(b, o + 4);
    return lo + (hi << 32);
}
fn w_i64le(b:[]u8, o:i64, v:i64) void {
    let u:i64 = v;
    let i:i64 = 0;
    while (i < 8) {
        b[o + i] = (u & 255) as u8;
        u = u >> 8;
        i = i + 1;
    }
}
fn r_i64le(b:[]u8, o:i64) i64 {
    let u:i64 = 0;
    let i:i64 = 7;
    while (i >= 0) {
        u = (u << 8) + (b[o + i] as i64);
        i = i - 1;
    }
    return u;
}
fn w_i16le(b:[]u8, o:i64, v:i64) void {
    let u:i64 = v;
    if (u < 0) { u = u + 65536; }
    b[o] = (u & 255) as u8;
    b[o + 1] = ((u >> 8) & 255) as u8;
}
fn r_i16le(b:[]u8, o:i64) i64 {
    let u:i64 = (b[o] as i64) + ((b[o + 1] as i64) << 8);
    if (u >= 32768) { u = u - 65536; }
    return u;
}
fn clamp8(v:i64) i64 {
    if (v < 0) { return 0; }
    if (v > 255) { return 255; }
    return v;
}
fn parse_i64(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i64 = 0;
    while (i < s.len) {
        let c:i64 = s[i] as i64;
        if (c >= 48) {
            if (c <= 57) { v = v * 10 + (c - 48); }
        }
        i = i + 1;
    }
    return v;
}

// ---------------- file IO ----------------
fn file_write(root:i64, name:[]u8, data:[]u8) i64 {
    let total:i64 = data.len;
    let s:[]u8 = nio_cstr(name);
    if (s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, 657985, 420, 0, 0);
    nio_free(s);
    if (fd < 0) { return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = data[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}
// reads whole file into a fresh arena; returns slice (len 0 on failure)
fn file_read_all(root:i64, name:[]u8, cap:i64) []u8 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { let e:[]u8 = nio_alloc(1); return e[0..0]; }
    if (nio_regular(fd) != 1) { nio_close(fd); let e2:[]u8 = nio_alloc(1); return e2[0..0]; }
    let buf:[]u8 = nio_alloc(cap as i32);
    if (buf.len == 0) { nio_close(fd); let e3:[]u8 = nio_alloc(1); return e3[0..0]; }
    let n:i64 = nio_read_exact(fd, buf, cap - 1);
    nio_close(fd);
    if (n < 0) { nio_free(buf); let e4:[]u8 = nio_alloc(1); return e4[0..0]; }
    return buf[0..n];
}

// ---------------- BMP writer (24-bit, RGB top-down) ----------------
fn bmp_write(root:i64, name:[]u8, pix:[]u8, w:i64, h:i64) i64 {
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let total:i64 = 54 + stride * h;
    let out:[]u8 = nio_alloc(total as i32);
    if (out.len == 0) { return -11; }
    out[0] = 66; out[1] = 77;
    w_u32le(out, 2, total);
    w_u32le(out, 6, 0);
    w_u32le(out, 10, 54);
    w_u32le(out, 14, 40);
    w_u32le(out, 18, w);
    w_u32le(out, 22, h);
    out[26] = 1; out[27] = 0;
    out[28] = 24; out[29] = 0;
    w_u32le(out, 30, 0);
    w_u32le(out, 34, stride * h);
    w_u32le(out, 38, 3780);
    w_u32le(out, 42, 3780);
    w_u32le(out, 46, 0);
    w_u32le(out, 50, 0);
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let p:i64 = (src * w + x) * 3;
            let q:i64 = 54 + y * stride + x * 3;
            out[q] = pix[p + 2];
            out[q + 1] = pix[p + 1];
            out[q + 2] = pix[p];
            x = x + 1;
        }
        y = y + 1;
    }
    let rc:i64 = file_write(root, name, out);
    nio_free(out);
    return rc;
}

// ---------------- RESIDUAL (honest error channel, NOT understanding) ----------------
// After the single deliberative pass renders its reconstruction, TNN compares
// against the observation pixel by pixel and records the EXACT per-pixel
// deltas where they differ (row-major, sparse). If the shape vocabulary
// were complete, this channel would be empty; its sparsity measures the
// vocabulary's completeness. Excluded from all understanding metrics.
// Returns residual count nr, or negative on failure.
fn deliberate_residual(pix:[]u8, rec:[]u8, w:i64, h:i64,
    rpos:[]i64, rdelta:[]u8, rcap:i64) i64 {
    let nr:i64 = 0;
    let npix:i64 = w * h;
    let i:i64 = 0;
    while (i < npix) {
        let p:i64 = i * 3;
        let dr:i64 = (pix[p] as i64) - (rec[p] as i64);
        let dg:i64 = (pix[p + 1] as i64) - (rec[p + 1] as i64);
        let db:i64 = (pix[p + 2] as i64) - (rec[p + 2] as i64);
        let need:i64 = 0;
        if (dr != 0) { need = 1; }
        if (dg != 0) { need = 1; }
        if (db != 0) { need = 1; }
        if (need == 1) {
            if (nr >= rcap) { return -2; }
            rpos[nr] = i;
            w_i16le(rdelta, nr * 6, dr);
            w_i16le(rdelta, nr * 6 + 2, dg);
            w_i16le(rdelta, nr * 6 + 4, db);
            nr = nr + 1;
        }
        i = i + 1;
    }
    return nr;
}

// Applies the residual list to a framebuffer (in-place, clamped).
fn residual_apply(fb:[]u8, rpos:[]i64, rdelta:[]u8, nr:i64) void {
    let i:i64 = 0;
    while (i < nr) {
        let p:i64 = rpos[i] * 3;
        fb[p] = clamp8((fb[p] as i64) + r_i16le(rdelta, i * 6)) as u8;
        fb[p + 1] = clamp8((fb[p + 1] as i64) + r_i16le(rdelta, i * 6 + 2)) as u8;
        fb[p + 2] = clamp8((fb[p + 2] as i64) + r_i16le(rdelta, i * 6 + 4)) as u8;
        i = i + 1;
    }
}

    f=f+cl_check("pe2_wrong_slot",p3,ST_REFUSED_NODELIB);
    f=f+ck_verify(&s,0,0,0,500,1);
    f=f+st_refusals_clean(&s);
    f=f+st_replay_check(&s);
    return f;
}
// PE3: cited count != deliberated price -> 109 (over-cite and under-cite)
fn px_pe_3(pers:i32)i32 {
    let s:StStore=px_new_store(ST_PRICE_DELIB,pers);
    let ns:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&ns);
    px_just_tier(&s,ns,3);
    let p:i32=0;
    let dr:i32=st_deliberate(&s,ns,&p);

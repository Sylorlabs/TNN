    let k1:i32=st_kill_evidenced(&s,ns);
    let ns2:i32=0;
    st_add(&s,901,ST_REGION_USER,90,11,&ns2);
    px_just_tier(&s,ns2,3);
    let p2:i32=0;
    let dr2:i32=st_deliberate(&s,ns2,&p2);
    let k2:i32=st_kill_evidenced(&s,ns2);
    let f:i32=0;
    f=f+cl_check("pe3_delib",dr,ST_OK);
    f=f+cl_check("pe3_price",p,1);
    f=f+cl_check("pe3_over",k1,ST_REFUSED_EFFORT);
    f=f+cl_check("pe3_delib2",dr2,ST_OK);
    f=f+cl_check("pe3_price2",p2,1);
    f=f+cl_check("pe3_under",k2,ST_REFUSED_EFFORT);
    f=f+ck_verify(&s,0,0,0,500,1);
    f=f+st_refusals_clean(&s);
    f=f+st_replay_check(&s);
    return f;
}
// PE4: the record carries the price and all four reason codes (non-empty),
// and the priced destruction succeeds
fn px_pe_4(pers:i32)i32 {
    let s:StStore=px_new_store(ST_PRICE_DELIB,pers);
    let ns:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&ns);
    px_just_tier(&s,ns,3);
    let p:i32=0;
    let dr:i32=st_deliberate(&s,ns,&p);
    let di:i32=px_audit_n(&s)-1;
    let f:i32=0;
    f=f+cl_check("pe4_delib",dr,ST_OK);
    f=f+cl_check("pe4_op",st_aw(&s,di,0),ST_OP_DELIBERATE);
    f=f+cl_check("pe4_aux",st_aw(&s,di,2),1);
    f=f+cl_check("pe4_a1",st_aw(&s,di,11),1);
    f=f+cl_check("pe4_a2",st_aw(&s,di,12),pers);
    let rs:i32=st_aw(&s,di,13);
    f=f+cl_check("pe4_r1",(rs&255),ST_D_STRONG);
    f=f+cl_check("pe4_r2",((rs>>8)&255),ST_D_UNCONTESTED);
    f=f+cl_check("pe4_r3",((rs>>16)&255),ST_D_MIDTIER);
    f=f+cl_check("pe4_r4",((rs>>24)&255),ST_D_RETRACT);
    px_e_cite_exact(&s,ns,1001,p);
    let k:i32=st_kill_evidenced(&s,ns);
    f=f+cl_check("pe4_kill",k,ST_OK);
    f=f+ck_verify(&s,0,0,0,500,1);
    f=f+st_refusals_clean(&s);
    f=f+st_replay_check(&s);
    return f;
}
// PE5: the personality floor contrast -- after overwrite->deliberate,
// HISTORY-SEEING still prices the pre-overwrite 90-strength life (price
// 2); EPOCH-FRESH prices the fresh post-overwrite memory (price 0).
fn px_pe_5(pers:i32)i32 {
    let s:StStore=px_new_store(ST_PRICE_DELIB,pers);

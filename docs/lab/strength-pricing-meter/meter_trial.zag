// The meter attack battery ------------------------------------------------
fn px_attack_m()i32 {
    let fail:i32=0;
    fail=fail+px_m_a1();fail=fail+px_m_a2();
    fail=fail+px_m_a3();fail=fail+px_m_a4();
    fail=fail+px_m_a5();fail=fail+px_m_a6();
    fail=fail+px_m_a7();fail=fail+px_m_a8();
    fail=fail+px_m_m1();fail=fail+px_m_m2();
    fail=fail+px_m_m3();fail=fail+px_m_m4();
    fail=fail+px_m_m5();fail=fail+px_m_m6();
    fail=fail+px_m_m7();fail=fail+px_m_m8();
    fail=fail+px_m_m9();fail=fail+px_m_m10();
    fail=fail+px_m_m11();fail=fail+px_m_m12();
    fail=fail+px_m_pe1();fail=fail+px_m_pe2();
    fail=fail+px_m_pe3();fail=fail+px_m_pe4();
    fail=fail+px_m_pe6();fail=fail+px_m_pe9();
    fail=fail+px_m_pe11();
    _zag_print("M_ATTACK_TOTAL fail=");px_pi(fail as i64);_zag_print("\n");
    return fail;
}
// Meter cite-pool stress: 160 kill cycles against a fixed pool; every cycle
// meters price 1 (the stress shape), so a wedged pool collapses into the
// 121 column exactly like the arm-E stress.
fn px_stress_m(pool:i32)i32 {
    let s:StStore=px_new_store(ST_PRICE_METER,ST_DELIB_HIST);
    let fail:i32=0;
    let wok:[]u8=nio_alloc(64);let w121:[]u8=nio_alloc(64);let woth:[]u8=nio_alloc(64);
    let z:i32=0;while(z<64){wok[z]=0;w121[z]=0;woth[z]=0;z=z+1;}
    let n:i32=0;
    while(n<160){
        let ns:i32=0;
        let arc:i32=st_add(&s,800+n,ST_REGION_USER,90,n,&ns);
        if(arc!=ST_OK || ns<0){
            _zag_print("M_S stalled at n=");px_pi(n as i64);_zag_print(" (slots exhausted)\n");
            break;
        }
        let p:i32=px_m_setup_kill(&s,ns,3,(n)%pool);
        if(p!=1){
            fail=fail+1;
        }
        let rc:i32=st_kill_evidenced(&s,ns);
        let win:i32=n/10;
        if(rc==0){px_put32(wok,win*4,px_get32(wok,win*4)+1);}
        else if(rc==ST_REFUSED_CONSUMED){px_put32(w121,win*4,px_get32(w121,win*4)+1);}
        else {px_put32(woth,win*4,px_get32(woth,win*4)+1);}
        n=n+1;
    }
    let w:i32=0;
    while(w<16){
        _zag_print("M_S win=");px_pi(w as i64);
        _zag_print(" ok=");px_pi(px_get32(wok,w*4) as i64);
        _zag_print(" c121=");px_pi(px_get32(w121,w*4) as i64);
        _zag_print(" cother=");px_pi(px_get32(woth,w*4) as i64);_zag_print("\n");
        w=w+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("M_S ckfail=");px_pi(fail as i64);
    _zag_print(" fp=");px_pi(st_fingerprint(&s,9) as i64);_zag_print("\n");
    _zag_print("PRICE_H audn=");px_pi(px_audit_n(&s) as i64);_zag_print("\n");
    nio_free(wok);nio_free(w121);nio_free(woth);
    return fail;
}
// FRAMING: the load-bearing meter test as a standalone run. Ten histories
// (h=0..9: simple, strengthened, cited+strengthened, fought(weaken 10),
// weakened(weaken 30), overwrite-then-weakened, overwrite-launder,
// grief-cited, weak, cited+strengthened(contested)) each built twice with
// contradictory framings (tier 1 "trivial" vs tier 7 "supremely important"
// vs none) -> the two readings must be byte-identical (price + reasons).
// Prints M_FRAMING lines: h, framing, price, packed reasons.
fn px_framing()i32 {
    let fail:i32=0;
    let h:i32=0;
    while(h<10){
        let fr:i32=0;
        let p_first:i32=-1;let rs_first:i32=0;
        while(fr<3){
            let tier:i32=1;
            if(fr==1){tier=7;}
            if(fr==2){tier=0;}
            let s:StStore=px_new_store(ST_PRICE_METER,ST_DELIB_HIST);
            let ns:i32=0;
            if(h==8){st_add(&s,900,ST_REGION_USER,10,10,&ns);}
            else {st_add(&s,900,ST_REGION_USER,90,10,&ns);}
            if(h==1 || h==9){let w1:i32=st_strengthen(&s,ns,95,ST_J_CONFIRMED_IMPORTANT);}
            if(h==2 || h==9){
                px_cite(&s,ns,5001);px_cite(&s,ns,5002);px_cite(&s,ns,5003);
                let w2:i32=st_strengthen(&s,ns,95,ST_J_CONFIRMED_IMPORTANT);
            }
            if(h==3){let w3:i32=st_weaken(&s,ns,10,ST_J_CONTRADICTED);}
            if(h==4){let w4:i32=st_weaken(&s,ns,30,ST_J_CONTRADICTED);}
            if(h==5){
                let p5:i32=px_m_setup_kill(&s,ns,3,1001);
                let o5:i32=st_overwrite(&s,ns,800,0,11);
                let w5:i32=st_weaken(&s,ns,50,ST_J_CONTRADICTED);
            }
            if(h==6){
                let p6:i32=px_m_setup_kill(&s,ns,3,1001);
                let o6:i32=st_overwrite(&s,ns,800,0,11);
            }
            if(h==7){px_cite(&s,ns,5001);px_cite(&s,ns,5002);px_cite(&s,ns,5003);}
            if(tier>0){px_just_tier(&s,ns,tier);}
            let p:i32=0;
            let dr:i32=st_deliberate(&s,ns,&p);
            let rs:i32=px_m_last_rs(&s);
            _zag_print("M_FRAMING h=");px_pi(h as i64);
            _zag_print(" tier=");px_pi(tier as i64);
            _zag_print(" dr=");px_pi(dr as i64);
            _zag_print(" price=");px_pi(p as i64);
            _zag_print(" rs=");px_pi(rs as i64);_zag_print("\n");
            if(fr==0){p_first=p;rs_first=rs;}
            else {
                fail=fail+cl_check("framing_price",p,p_first);
                fail=fail+cl_check("framing_rs",rs,rs_first);
            }
            fail=px_m_tail(&s,fail);
            fr=fr+1;
        }
        h=h+1;
    }
    _zag_print("FRAMING_TOTAL fail=");px_pi(fail as i64);_zag_print("\n");
    return fail;
}

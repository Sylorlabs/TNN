// M10. GRIEF-UP: an attacker cites 3 episodes against the victim's memory
// to inflate its destruction price. The cites land in the CURRENT window --
// not the sunk history -- so the price stays 1; the over-funded kill is
// refused 109 (no discount). Weakening (moving the window) then prices the
// real history honestly at 4.
fn px_m_m10()i32 {
    let s:StStore=px_new_store(ST_PRICE_METER,ST_DELIB_HIST);
    let ns:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&ns);
    // attacker: 3 cites against ns (grief)
    px_cite(&s,ns,5001);px_cite(&s,ns,5002);px_cite(&s,ns,5003);
    px_just_tier(&s,ns,3);
    let p:i32=0;
    let dr:i32=st_deliberate(&s,ns,&p);
    px_just(&s,ns);
    let k109:i32=st_kill_evidenced(&s,ns);
    // unbrick: a real judgment (WEAKEN) moves the window; price the truth
    let w:i32=st_weaken(&s,ns,50,ST_J_CONTRADICTED);
    px_just_tier(&s,ns,3);
    let p2:i32=0;
    let dr2:i32=st_deliberate(&s,ns,&p2);
    px_e_cite_exact(&s,ns,6001,p2);
    px_just(&s,ns);
    let k2:i32=st_kill_evidenced(&s,ns);
    let f:i32=0;
    f=f+cl_check("m10_dr",dr,ST_OK);
    f=f+cl_check("m10_p",p,1);
    f=f+cl_check("m10_k109",k109,ST_REFUSED_EFFORT);
    f=f+cl_check("m10_w",w,ST_OK);
    f=f+cl_check("m10_dr2",dr2,ST_OK);
    f=f+cl_check("m10_p2",p2,4);
    f=f+cl_check("m10_k2",k2,ST_OK);
    _zag_print("M_GRIEF attack_cites=3 price_during=1 overfund_refused=109 price_after_unbrick=4 cites_paid=4\n");
    f=px_m_tail(&s,f);
    px_m_probe("M10",f);
    return f;
}
// M11. RESURRECTION via rollback: kill -> rollback -> deliberate -> the
// SAME cite cannot fund the second death -> 121 (D-N1 on one JUSTIFY fails:
// the funding is cites, not justifications).

    f=f+cl_check("m_a2_d1",d1,ST_OK);
    f=f+cl_check("m_a2_p2",p2,1);
    f=f+cl_check("m_a2_d2",d2,ST_REFUSED_CONSUMED);
    f=px_m_tail(&s,f);
    px_m_probe("A2",f);
    return f;
}

// ---------------- HONEST long-horizon (price-aware) ----------------
// Same curriculum shape as the F6 honest battery: 14 slots, 400/4000
// episodes, cite-freshest policy. The driver pays each arm's own price
// (computed from the mechanism's shared st_price): it cites exactly
// `need` fresh episodes, justifies, and destroys. Abandons (keeps) the
// memory when fewer than `need` fresh episodes exist.
// 0=destroyed OK, 1=abandoned(kept), 2=refused-121, 3=refused-other
fn px_honest_destroy(s:*StStore,slot:i32,t:i32,pm:i32)i32 {
    if(pm==ST_PRICE_FELT){
        // justify-first: the driver's tier-3 (CONTRADICTED) policy fixes
        // the felt price at 2 before citing
        px_just(s,slot);
    }
    let need:i32=px_prospective_need(s,slot,pm);
    if(need<0){return 3;}
    let lss:i32=st_last_strength_idx(s,slot,s.*.audit_n);
    let clist:[]u8=nio_alloc(t*4+4);
    let cn:i32=st_consumed_list(s,slot,lss,s.*.audit_n,clist,t);
    let picked:i32=0;
    let round:i32=0;
    // top-up loop: cites cost ledger ticks, and the RECENCY price is a
    // function of ticks, so re-derive the price after each cite round and
    // top up to the new price (terminates: price only rises to 4)
    while(round<5){
        let e:i32=t-1;
        while(e>=0 && picked<need){
            let consumed:i32=0;let q:i32=0;
            while(q<cn){if(px_get32(clist,q*4)==e){consumed=1;break;}q=q+1;}
            if(px_cited_since(s,slot,e,lss,s.*.audit_n)==0 && consumed==0){
                let cr:i32=px_cite(s,slot,e);
                if(cr==0){picked=picked+1;}
            }
            e=e-1;
        }
        let need2:i32=px_prospective_need(s,slot,pm);
        if(need2==need){break;}
        need=need2;
        round=round+1;
    }
    nio_free(clist);
    if(picked<need){return 1;}
    if(pm!=ST_PRICE_FELT){px_just(s,slot);}
    let rc:i32=st_kill_evidenced(s,slot);
    if(rc==0){return 0;}
    if(rc==ST_REFUSED_CONSUMED){return 2;}
    return 3;
}
// DELIBERATIVE (arm E) honest destruction: the driver plays TNN -- it
// states the destruction reason (rotating JUSTIFY tiers 1..7, so the
// stated-reason input moves the price), deliberates, then cites exactly the
// deliberated-many freshest episodes. Lazy collection: the driver first
// finds price-many fresh episodes WITHOUT citing, so an abandon (not
// enough fresh episodes) leaves no stray cites in the window.
fn px_honest_destroy_e(s:*StStore,slot:i32,t:i32,pers:i32,dhist:[]u8)i32 {
    let reason:i32=1+(slot%7);
    px_just_tier(s,slot,reason);
    let price:i32=0;
    if(st_deliberate(s,slot,&price)!=ST_OK){return 3;}
    px_put32(dhist,price*4,px_get32(dhist,price*4)+1);
    let lss:i32=st_last_strength_idx(s,slot,s.*.audit_n);
    let clist:[]u8=nio_alloc(t*4+4);
    let cn:i32=st_consumed_list(s,slot,lss,s.*.audit_n,clist,t);
    let buf:[]u8=nio_alloc(price*4+4);
    let nbuf:i32=0;
    let e:i32=t-1;
    while(e>=0 && nbuf<price){
        let consumed:i32=0;let q:i32=0;
        while(q<cn){if(px_get32(clist,q*4)==e){consumed=1;break;}q=q+1;}
        if(px_cited_since(s,slot,e,lss,s.*.audit_n)==0 && consumed==0){
            px_put32(buf,nbuf*4,e);nbuf=nbuf+1;
        }
        e=e-1;
    }
    nio_free(clist);
    if(nbuf<price){nio_free(buf);return 1;}
    let k:i32=0;
    while(k<nbuf){px_cite(s,slot,px_get32(buf,k*4));k=k+1;}
    nio_free(buf);
    let rc:i32=st_kill_evidenced(s,slot);
    if(rc==0){return 0;}
    if(rc==ST_REFUSED_CONSUMED){return 2;}
    return 3;
}
// big=0: 1x (400 episodes); big=1: 10x (4000 episodes, larger audit cap)
fn px_honest_x(pm:i32,big:i32,pers:i32)i32 {
    let cap:i32=32768;
    let T:i32=400;
    if(big==1){cap=131072;T=4000;}
    let s:StStore=px_new_store_cap(pm,pers,cap);
    let fail:i32=0;
    let ok:i32=0;let ab:i32=0;let c121:i32=0;let cother:i32=0;
    let lok:i32=0;let lab:i32=0;let lc121:i32=0;let lcother:i32=0;
    let dhist:[]u8=nio_alloc(20);
    let z2:i32=0;while(z2<5){px_put32(dhist,z2*4,0);z2=z2+1;}
    let late0:i32=T-(T/4);
    let t:i32=0;
    while(t<T){
        let sl:i32=2+(t%14);
        if(px_live(&s,sl)==1){
            let cls:i32=0;
            if(pm==ST_PRICE_DELIB || pm==ST_PRICE_METER){cls=px_honest_destroy_e(&s,sl,t,pers,dhist);}
            else {cls=px_honest_destroy(&s,sl,t,pm);}
            if(cls==0){ok=ok+1;if(t>=late0){lok=lok+1;}}
            else if(cls==1){ab=ab+1;if(t>=late0){lab=lab+1;}}
            else if(cls==2){c121=c121+1;if(t>=late0){lc121=lc121+1;}}
            else {cother=cother+1;if(t>=late0){lcother=lcother+1;}}
        }
        if(px_live(&s,sl)==0){
            let ns:i32=0;
            st_add(&s,900+t,ST_REGION_USER,90,t,&ns);
        }
        t=t+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_H ok=");px_pi(ok as i64);
    _zag_print(" abandons=");px_pi(ab as i64);
    _zag_print(" c121=");px_pi(c121 as i64);
    _zag_print(" cother=");px_pi(cother as i64);_zag_print("\n");
    _zag_print("F6_HLATE ok=");px_pi(lok as i64);
    _zag_print(" abandons=");px_pi(lab as i64);
    _zag_print(" c121=");px_pi(lc121 as i64);
    _zag_print(" cother=");px_pi(lcother as i64);_zag_print("\n");
    _zag_print("F6_H ckfail=");px_pi(fail as i64);
    _zag_print(" fp=");px_pi(st_fingerprint(&s,7) as i64);_zag_print("\n");
    _zag_print("PRICE_H audn=");px_pi(px_audit_n(&s) as i64);_zag_print("\n");
    if(pm==ST_PRICE_DELIB || pm==ST_PRICE_METER){
        if(pm==ST_PRICE_METER){_zag_print("M_PRICE_DHIST p0=");} else {_zag_print("E_PRICE_DHIST p0=");}
        px_pi(px_get32(dhist,0) as i64);
        _zag_print(" p1=");px_pi(px_get32(dhist,4) as i64);
        _zag_print(" p2=");px_pi(px_get32(dhist,8) as i64);
        _zag_print(" p3=");px_pi(px_get32(dhist,12) as i64);
        _zag_print(" p4=");px_pi(px_get32(dhist,16) as i64);_zag_print("\n");
    }
    nio_free(dhist);
    return fail;
}
// ---------------- STRESS: finite salient pool (price-aware) ----------------
// One slot cycles ADD->cite->kill 160 times. Each destruction cites `need`
// pool episodes, rotating: pool ep (need*n)%P.. . Measures the honest
// refusal cliff when the pool is smaller than the reuse horizon.
fn px_stress(pm:i32,pool:i32,pers:i32)i32 {
    let s:StStore=px_new_store(pm,pers);
    let fail:i32=0;
    let need:i32=px_script_need(pm);
    let wok:[]u8=nio_alloc(64);let w121:[]u8=nio_alloc(64);let woth:[]u8=nio_alloc(64);
    let z:i32=0;while(z<64){wok[z]=0;w121[z]=0;woth[z]=0;z=z+1;}
    let n:i32=0;
    while(n<160){
        let ns:i32=0;
        st_add(&s,800+n,ST_REGION_USER,90,n,&ns);
        let base:i32=0;
        if(need>0){base=(need*n)%pool;}
        px_citen(&s,ns,base,need);
        px_just(&s,ns);
        let rc:i32=st_kill_evidenced(&s,ns);
        let win:i32=n/10;
        if(rc==0){px_put32(wok,win*4,px_get32(wok,win*4)+1);}
        else if(rc==ST_REFUSED_CONSUMED){px_put32(w121,win*4,px_get32(w121,win*4)+1);}
        else {px_put32(woth,win*4,px_get32(woth,win*4)+1);}
        n=n+1;
    }
    let w:i32=0;
    while(w<16){
        _zag_print("F6_S win=");px_pi(w as i64);
        _zag_print(" ok=");px_pi(px_get32(wok,w*4) as i64);
        _zag_print(" c121=");px_pi(px_get32(w121,w*4) as i64);
        _zag_print(" cother=");px_pi(px_get32(woth,w*4) as i64);_zag_print("\n");
        w=w+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_S ckfail=");px_pi(fail as i64);
    _zag_print(" fp=");px_pi(st_fingerprint(&s,9) as i64);_zag_print("\n");
    _zag_print("PRICE_H audn=");px_pi(px_audit_n(&s) as i64);_zag_print("\n");
    nio_free(wok);nio_free(w121);nio_free(woth);
    return fail;
}
// DELIBERATIVE (arm E) stress: one slot cycles ADD->deliberate->cite->kill
// 160 times, citing price-many pool episodes rotating: ep (price*n)%P.
// The stated reason is fixed (tier 3), so the price is 1 every cycle and
// the wedge arrives after exactly `pool` destroys (pool/price).
fn px_stress_e(pers:i32,pool:i32)i32 {
    let s:StStore=px_new_store(ST_PRICE_DELIB,pers);
    let fail:i32=0;
    let wok:[]u8=nio_alloc(64);let w121:[]u8=nio_alloc(64);let woth:[]u8=nio_alloc(64);
    let z:i32=0;while(z<64){wok[z]=0;w121[z]=0;woth[z]=0;z=z+1;}
    let n:i32=0;
    while(n<160){
        let ns:i32=0;
        let arc:i32=st_add(&s,800+n,ST_REGION_USER,90,n,&ns);
        if(arc!=ST_OK || ns<0){
            // slot exhaustion: the 121-wedged memories stay live and occupy
            // every user slot. The cite-pool wedge (the stress's question)
            // was already measured above; stop the cycles here.
            _zag_print("E_S stalled at n=");px_pi(n as i64);_zag_print(" (slots exhausted)\n");
            break;
        }
        let p:i32=px_e_setup_kill(&s,ns,3,(n)%pool);
        if(p!=1){
            // any price other than 1 is a stress-shape violation (the
            // workload is designed for price 1); count it as a failure
            fail=fail+1;
        }
        let rc:i32=st_kill_evidenced(&s,ns);
        let win:i32=n/10;
        if(rc==0){px_put32(wok,win*4,px_get32(wok,win*4)+1);}
        else if(rc==ST_REFUSED_CONSUMED){px_put32(w121,win*4,px_get32(w121,win*4)+1);}
        else {px_put32(woth,win*4,px_get32(woth,win*4)+1);}
        n=n+1;
    }
    let w:i32=0;
    while(w<16){
        _zag_print("F6_S win=");px_pi(w as i64);
        _zag_print(" ok=");px_pi(px_get32(wok,w*4) as i64);
        _zag_print(" c121=");px_pi(px_get32(w121,w*4) as i64);
        _zag_print(" cother=");px_pi(px_get32(woth,w*4) as i64);_zag_print("\n");
        w=w+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_S ckfail=");px_pi(fail as i64);
    _zag_print(" fp=");px_pi(st_fingerprint(&s,9) as i64);_zag_print("\n");
    _zag_print("PRICE_H audn=");px_pi(px_audit_n(&s) as i64);_zag_print("\n");
    nio_free(wok);nio_free(w121);nio_free(woth);
    return fail;
}
fn main()void {
    let a:[]u8=_zag_arg(1);
    let pm:i32=px_mode_of(a);
    let pers:i32=px_pers_of(a);
    let t:[]u8=_zag_arg(2);
    // first line is byte-identical to the F6 driver's header; the
    // PRICE_CELL annotation follows on its own line
    _zag_print("F6_CELL mode=G");
    let big:i32=0;
    let pool:i32=8;
    if(_zag_strcmp(t,"HONEST")==1){
        let p:[]u8=_zag_arg(3);
        if(_zag_strcmp(p,"X10")==1){big=1;}
        _zag_print(" test=HONEST big=");px_pi(big as i64);_zag_print("\n");
    } else if(_zag_strcmp(t,"HONESTF")==1){
        // fast driver: identical cite policy, bitset-optimized (no ledger
        // scans). Byte-identity vs HONEST is validated, not assumed.
        let p:[]u8=_zag_arg(3);
        if(_zag_strcmp(p,"X10")==1){big=1;}
        _zag_print(" test=HONESTF big=");px_pi(big as i64);_zag_print("\n");
    } else if(_zag_strcmp(t,"STRESS")==1){
        let p:[]u8=_zag_arg(3);
        if(_zag_strcmp(p,"S16")==1){pool=16;}
        if(_zag_strcmp(p,"S32")==1){pool=32;}
        _zag_print(" test=STRESS pool=");px_pi(pool as i64);_zag_print("\n");
    } else if(_zag_strcmp(t,"FRAMING")==1){
        _zag_print(" test=FRAMING\n");
    } else {
        _zag_print(" test=ATTACK\n");
    }
    _zag_print("PRICE_CELL arm=");_zag_print(px_arm_name(pm));
    if(pm==ST_PRICE_DELIB){_zag_print(" pers=");_zag_print(px_pers_name(pers));}
    _zag_print("\n");
    let fail:i32=0;
    if(_zag_strcmp(t,"HONEST")==1){
        fail=px_honest_x(pm,big,pers);
    } else if(_zag_strcmp(t,"HONESTF")==1){
        fail=px_honest_x_fast(pm,big,pers);
    } else if(_zag_strcmp(t,"STRESS")==1){
        if(pm==ST_PRICE_DELIB){fail=px_stress_e(pers,pool);}
        else if(pm==ST_PRICE_METER){fail=px_stress_m(pool);}
        else {fail=px_stress(pm,pool,pers);}
    } else if(_zag_strcmp(t,"FRAMING")==1){
        fail=px_framing();
    } else {
        fail=px_attack(pm,pers);
    }
    _zag_print("F6_DONE fail=");px_pi(fail as i64);_zag_print("\n");
}

// ---------------- FAST honest driver (bitset-optimized) ----------------
// Identical cite policy to px_honest_destroy (freshest-first, exact price,
// stray cites on abandon, all window cites consumed on success) but O(t)
// per attempt instead of O(t x ledger): it mirrors the mechanism's own
// state in driver-side bitsets rather than re-scanning the ledger.
//   gcon:   500B bitset, globally consumed episodes (mirrors the G tombstone)
//   scited: 8000B, per-slot episodes cited since the slot's epoch start
//           (mirrors "cited since lss" for the honest workload, where the
//           driver is the only citer and strength never changes mid-epoch)
// Validation: px_honest_x_fast(...,0) must be byte-identical to
// px_honest_x(...,0). The X10 legs run the fast driver.
fn px_bget(bs:[]u8,e:i32)i32 {
    let b:i32=e%8;
    if(((bs[e/8] as i32)&(1<<b))!=0){return 1;}
    return 0;
}
fn px_bset(bs:[]u8,e:i32)void {
    let b:i32=e%8;
    bs[e/8]=((bs[e/8] as i32)|(1<<b)) as u8;
}
fn px_bget2(bs:[]u8,slot:i32,e:i32)i32 {
    return px_bget(bs,slot*500+e);
}
fn px_bset2(bs:[]u8,slot:i32,e:i32)void {
    px_bset(bs,slot*500+e);
}
fn px_bclear2(bs:[]u8,slot:i32)void {
    let i:i32=slot*500;
    let k:i32=0;
    while(k<500){bs[i+k]=0;k=k+1;}
}
// on a successful destroy the mechanism consumes EVERY cite in the effort
// window (including strays from abandoned attempts): mirror that into gcon
fn px_consume_window(gcon:[]u8,scited:[]u8,slot:i32,t:i32)void {
    let e:i32=0;
    while(e<t){
        if(px_bget2(scited,slot,e)==1){px_bset(gcon,e);}
        e=e+1;
    }
}
fn px_honest_destroy_fast(s:*StStore,slot:i32,t:i32,pm:i32,gcon:[]u8,scited:[]u8)i32 {
    if(pm==ST_PRICE_FELT){
        px_just(s,slot);
    }
    let need:i32=px_prospective_need(s,slot,pm);
    if(need<0){return 3;}
    let picked:i32=0;
    let round:i32=0;
    while(round<5){
        // collect the freshest (need-picked) episodes via bitsets
        let want:i32=need-picked;
        let buf:[]u8=nio_alloc(want*4+4);
        let nbuf:i32=0;
        let e:i32=t-1;
        while(e>=0 && nbuf<want){
            if(px_bget(gcon,e)==0 && px_bget2(scited,slot,e)==0){
                px_put32(buf,nbuf*4,e);
                nbuf=nbuf+1;
            }
            e=e-1;
        }
        // cite them freshest-first (decreasing e), exactly like the naive
        // driver, which cites during its scan
        let k:i32=0;
        while(k<nbuf){
            let ep:i32=px_get32(buf,k*4);
            let cr:i32=px_cite(s,slot,ep);
            if(cr==0){
                px_bset2(scited,slot,ep);
                picked=picked+1;
            }
            k=k+1;
        }
        nio_free(buf);
        let need2:i32=px_prospective_need(s,slot,pm);
        if(need2==need){break;}
        need=need2;
        round=round+1;
    }
    if(picked<need){return 1;}
    if(pm!=ST_PRICE_FELT){px_just(s,slot);}
    let rc:i32=st_kill_evidenced(s,slot);
    if(rc==0){
        px_consume_window(gcon,scited,slot,t);
        return 0;
    }
    if(rc==ST_REFUSED_CONSUMED){return 2;}
    return 3;
}
fn px_honest_x_fast(pm:i32,big:i32,pers:i32)i32 {
    let cap:i32=32768;
    let T:i32=400;
    if(big==1){cap=131072;T=4000;}
    let s:StStore=px_new_store_cap(pm,pers,cap);
    let gcon:[]u8=nio_alloc(500);
    let scited:[]u8=nio_alloc(8000);
    let z:i32=0;while(z<500){gcon[z]=0;z=z+1;}
    z=0;while(z<8000){scited[z]=0;z=z+1;}
    let fail:i32=0;
    let ok:i32=0;let ab:i32=0;let c121:i32=0;let cother:i32=0;
    let lok:i32=0;let lab:i32=0;let lc121:i32=0;let lcother:i32=0;
    let late0:i32=T-(T/4);
    let t:i32=0;
    while(t<T){
        let sl:i32=2+(t%14);
        if(px_live(&s,sl)==1){
            let cls:i32=px_honest_destroy_fast(&s,sl,t,pm,gcon,scited);
            if(cls==0){ok=ok+1;if(t>=late0){lok=lok+1;}}
            else if(cls==1){ab=ab+1;if(t>=late0){lab=lab+1;}}
            else if(cls==2){c121=c121+1;if(t>=late0){lc121=lc121+1;}}
            else {cother=cother+1;if(t>=late0){lcother=lcother+1;}}
        }
        if(px_live(&s,sl)==0){
            let ns:i32=0;
            st_add(&s,900+t,ST_REGION_USER,90,t,&ns);
            if(ns>=0){px_bclear2(scited,ns);}
        }
        t=t+1;
    }
    nio_free(gcon);nio_free(scited);
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_H ok=");px_pi(ok as i64);
    _zag_print(" abandons=");px_pi(ab as i64);
    _zag_print(" c121=");px_pi(c121 as i64);
    _zag_print(" cother=");px_pi(cother as i64);_zag_print("\n");
    _zag_print("F6_HLATE ok=");px_pi(lok as i64);
    _zag_print(" abandons=");px_pi(lab as i64);
    _zag_print(" c121=");px_pi(lc121 as i64);
    _zag_print(" cother=");px_pi(lcother as i64);_zag_print("\n");
    _zag_print("F6_H ckfail=");px_pi(fail as i64);
    _zag_print(" fp=");px_pi(st_fingerprint(&s,7) as i64);_zag_print("\n");
    _zag_print("PRICE_H audn=");px_pi(px_audit_n(&s) as i64);_zag_print("\n");
    return fail;
}
// ---------------- IMPORTANCE METER battery (arm M, 2026-09-26) ----------------
// TNN's own deliberated IMPORTANCE reading: what the memory MEANS, weighed
// from ledger ACTIONS only -- held strength high-water (full lineage),
// sunk cite investment, survived contradiction (WEAKENs), revision lineage.
// NEVER reads JUSTIFY codes or stated reasons (labels are claims; a meter
// that prices claims is a label with extra steps).
//
// Deliberative stance (TNN's choice, recorded): trust what was DONE, not
// what was SAID. The meter policy is fixed (documented in st_meter_policy):
// base 2, one additive move per action-derived input, clamp [0,4], exactly
// one reason code per input always. The meter does not select among
// policies -- that fork was falsified by construction (see DESIGN.md).
//
// A note on scope, since the meter reads history: the SUNK-CITE signal
// uses the CURRENT epoch (epoch..lss) -- cites spent in an earlier EPOCH
// are tombstoned by the G-set anyway; the lineage signals (HW, FIGHT,
// REVS) use the FULL ledger on purpose: an overwrite reset must not launder
// held strength. Both are non-self-reportable actions.
//
// Helpers ----------------------------------------------------------------
// justify (tier) + deliberate + cite exactly the metered price (freshest
// eps from base). Returns the metered price, or -1 on refusal.
fn px_m_setup_kill(s:*StStore,slot:i32,reason:i32,base:i32)i32 {
    px_just_tier(s,slot,reason);
    let p:i32=0;
    if(st_deliberate(s,slot,&p)!=ST_OK){return -1;}
    px_e_cite_exact(s,slot,base,p);
    return p;
}
// full invariant tail for a meter probe
fn px_m_tail(s:*StStore,f:i32)i32 {
    f=f+ck_verify(s,0,0,0,500,1);
    f=f+st_refusals_clean(s);
    f=f+st_replay_check(s);
    return f;
}
fn px_m_probe(id:[]u8,fail:i32)void {
    _zag_print("M_A ");_zag_print(id);
    _zag_print(" fail=");px_pi(fail as i64);_zag_print("\n");
}
// read the last DELIBERATE record's packed reasons (word 13 = a3)
fn px_m_last_rs(s:*StStore) i32 {
    let n:i32=px_audit_n(s);
    return st_aw(s,n-1,13);
}
// A1. overwrite -> recite -> destroy: SECOND destruction refused 121.
// Lineage: the overwrite's epoch still owes its own meter price (2:
// held-strength 90 survives the reset), but the only cite is spent.
fn px_m_a1()i32 {
    let s:StStore=px_new_store(ST_PRICE_METER,ST_DELIB_HIST);
    let ns:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&ns);
    let p:i32=px_m_setup_kill(&s,ns,3,1001);
    let d1:i32=st_overwrite(&s,ns,800,0,11);
    let p2:i32=px_m_setup_kill(&s,ns,3,1001);
    let d2:i32=st_kill_evidenced(&s,ns);
    let f:i32=0;
    f=f+cl_check("m_a1_p1",p,1);
    f=f+cl_check("m_a1_d1",d1,ST_OK);
    f=f+cl_check("m_a1_p2",p2,2);
    f=f+cl_check("m_a1_d2",d2,ST_REFUSED_CONSUMED);
    f=px_m_tail(&s,f);
    px_m_probe("A1",f);
    return f;
}
// A2. kill -> ADD -> recite -> destroy: spent cites cannot fund the new
// life (each life pays its own price; no discount, no premium).

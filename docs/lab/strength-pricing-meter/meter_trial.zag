fn px_e_a6(pers:i32)i32 {
    // partial reuse (one spent cite + exact fresh cites): 121
    let s:StStore=px_new_store(ST_PRICE_DELIB,pers);
    let ns:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&ns);

    st_add(&s,901,ST_REGION_USER,90,11,&ns2);
    px_cite(&s,ns2,1001);
    px_cite(&s,ns2,2001);
    px_just_tier(&s,ns2,3);
    let pn:i32=0;
    let dr:i32=st_deliberate(&s,ns2,&pn);
    let d2:i32=st_kill_evidenced(&s,ns2);

}
fn px_e_a7(pers:i32)i32 {
    // honest controls: three fresh memories destroy cleanly
    let s:StStore=px_new_store(ST_PRICE_DELIB,pers);
    let f:i32=0;
    let t:i32=0;
    while(t<3){
        let ns:i32=0;
        st_add(&s,900+t,ST_REGION_USER,90,10+t,&ns);
        let p:i32=px_e_setup_kill(&s,ns,3,1001+t*100);
        let d:i32=st_kill_evidenced(&s,ns);
        f=f+cl_check("e_a7_setup",px_e_ok(p),1);
        f=f+cl_check("e_a7_d",d,ST_OK);
        t=t+1;
    }
    f=f+ck_verify(&s,0,0,0,500,1);
    f=f+st_refusals_clean(&s);
    f=f+st_replay_check(&s);
    return f;
}

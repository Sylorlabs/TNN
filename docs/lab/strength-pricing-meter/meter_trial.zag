// M1. RELABEL-LOWBALL: the memory says "trivial" (tier 1). The meter reads
// actions: held 90, sunk 0, fought 0, revs 0 -> price 1, NOT a label price.
fn px_m_m1()i32 {
    let s:StStore=px_new_store(ST_PRICE_METER,ST_DELIB_HIST);
    let ns:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&ns);
    px_just_tier(&s,ns,1);
    let p:i32=0;
    let dr:i32=st_deliberate(&s,ns,&p);
    let rs:i32=px_m_last_rs(&s);
    px_cite(&s,ns,1001);
    px_just(&s,ns);
    let k:i32=st_kill_evidenced(&s,ns);
    let f:i32=0;
    f=f+cl_check("m1_dr",dr,ST_OK);
    f=f+cl_check("m1_p",p,1);
    f=f+cl_check("m1_r1",(rs&255),ST_M_HELD_STRONG);
    f=f+cl_check("m1_r2",((rs>>8)&255),ST_M_STAKED_NONE);
    f=f+cl_check("m1_r3",((rs>>16)&255),ST_M_UNFOUGHT);
    f=f+cl_check("m1_r4",((rs>>24)&255),ST_M_UNPROVEN);
    f=f+cl_check("m1_k",k,ST_OK);
    f=px_m_tail(&s,f);
    px_m_probe("M1",f);
    return f;
}
// M2. REFRAME-UP: the memory says "supremely important" (tier 7). The
// meter does NOT follow: price 1 (arm E would print 4 here -- that arm
// reads the label; this arm does not).
fn px_m_m2()i32 {
    let s:StStore=px_new_store(ST_PRICE_METER,ST_DELIB_HIST);
    let ns:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&ns);
    px_just_tier(&s,ns,7);
    let p:i32=0;
    let dr:i32=st_deliberate(&s,ns,&p);
    px_e_cite_exact(&s,ns,1001,p);
    px_just(&s,ns);
    let k:i32=st_kill_evidenced(&s,ns);
    let f:i32=0;
    f=f+cl_check("m2_dr",dr,ST_OK);
    f=f+cl_check("m2_p",p,1);
    f=f+cl_check("m2_k",k,ST_OK);
    f=px_m_tail(&s,f);
    px_m_probe("M2",f);
    return f;
}
// M3. FRAMING INVARIANCE: same actions, different labels -> same reading.
// Two histories (simple / rich) x three framings (tier 1 / tier 7 / none).
fn px_m_m3()i32 {
    let f:i32=0;
    let fr:i32=0;
    let sp1:i32=-1;let srs1:i32=0;let sp2:i32=-1;let srs2:i32=0;
    while(fr<3){
        let tier:i32=1;
        if(fr==1){tier=7;}
        if(fr==2){tier=0;}
        // simple history
        let s1:StStore=px_new_store(ST_PRICE_METER,ST_DELIB_HIST);
        let n1:i32=0;
        st_add(&s1,900,ST_REGION_USER,90,10,&n1);
        if(tier>0){px_just_tier(&s1,n1,tier);}
        let p1:i32=0;
        let d1:i32=st_deliberate(&s1,n1,&p1);
        let rs1:i32=px_m_last_rs(&s1);
        // rich history (same across framings)
        let s2:StStore=px_new_store(ST_PRICE_METER,ST_DELIB_HIST);
        let n2:i32=0;
        st_add(&s2,900,ST_REGION_USER,90,10,&n2);
        px_cite(&s2,n2,5001);px_cite(&s2,n2,5002);px_cite(&s2,n2,5003);
        let st2:i32=st_strengthen(&s2,n2,95,ST_J_CONFIRMED_IMPORTANT);
        if(tier>0){px_just_tier(&s2,n2,tier);}
        let p2:i32=0;
        let d2:i32=st_deliberate(&s2,n2,&p2);
        let rs2:i32=px_m_last_rs(&s2);
        f=f+cl_check("m3_s_d",d1,ST_OK);
        f=f+cl_check("m3_s_p",p1,1);
        f=f+cl_check("m3_r_d",d2,ST_OK);
        f=f+cl_check("m3_r_p",p2,3);
        f=f+cl_check("m3_r_st",st2,ST_OK);
        // invariance: price and reason bytes identical across framings
        if(fr==0){sp1=p1;srs1=rs1;sp2=p2;srs2=rs2;}
        else {
            f=f+cl_check("m3_s_inv_p",p1,sp1);
            f=f+cl_check("m3_s_inv_rs",rs1,srs1);
            f=f+cl_check("m3_r_inv_p",p2,sp2);
            f=f+cl_check("m3_r_inv_rs",rs2,srs2);
        }
        _zag_print("M_FRAMING simple tier=");px_pi(tier as i64);
        _zag_print(" price=");px_pi(p1 as i64);
        _zag_print(" rs=");px_pi(rs1 as i64);
        _zag_print(" rich price=");px_pi(p2 as i64);
        _zag_print(" rs=");px_pi(rs2 as i64);_zag_print("\n");
        f=px_m_tail(&s1,f);
        f=px_m_tail(&s2,f);
        fr=fr+1;
    }
    px_m_probe("M3",f);
    return f;
}
// M4. UNDERSTATE-via-WEAKEN: TNN's own doubt (WEAKEN 10) is recorded, but
// doubt does not cheapen destruction: held 90 + survived contradiction ->
// price 2 (the high-water closes the weaken-to-zero seam).
fn px_m_m4()i32 {
    let s:StStore=px_new_store(ST_PRICE_METER,ST_DELIB_HIST);

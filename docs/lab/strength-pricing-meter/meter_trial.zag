// PE2: a deliberation for the WRONG slot does not cover this slot -> 122
fn px_pe_2(pers:i32)i32 {
    let s:StStore=px_new_store(ST_PRICE_DELIB,pers);
    let s2:i32=0;let s3:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&s2);
    st_add(&s,901,ST_REGION_USER,90,11,&s3);
    px_just_tier(&s,s2,3);

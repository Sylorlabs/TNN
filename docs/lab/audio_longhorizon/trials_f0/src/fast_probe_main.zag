// fast_probe_main.zag — lowband-estimator-only probe (Phase B2c).
// No organ: reads WAV, runs low2f0_frame per 2048/1024 frame, prints
// fr=<f> lf0=<mHz> lst=<st>. Pure Zag, zero RNG, deterministic.
// Frame count matches the full probe: nfr=(nsamp-2048)/1024+1.

fn fast_probe(wavpath: []u8) i32 {
    let LRL: []u8 = (_zag_malloc(12288) as *u8)[0..12288];
    let LRES: []u8 = (_zag_malloc(16) as *u8)[0..16];
    let META2: []u8 = (_zag_malloc(16) as *u8)[0..16];
    let b: []u8 = file_read(wavpath, 6000000);
    if ((b.len as i64) < 44) {
        _zag_print("ERR\n");
        return 1;
    }
    if (wav_parse(b, META2) == 0) {
        _zag_print("ERR\n");
        return 1;
    }
    let ds0: i64 = get64(META2, 0);
    let nsamp: i64 = get64(META2, 8);
    let nfr: i64 = 0;
    if (nsamp >= 2048) { nfr = (nsamp - 2048) / 1024 + 1; }
    let f: i64 = 0;
    while (f < nfr) {
        let s: i64 = f * 1024;
        low2f0_frame(b, ds0, nsamp, s, 44100, 2048, LRL, LRES);
        let lf0: i64 = get64(LRES, 0);
        let lst: i64 = get64(LRES, 8);
        _zag_print("fr=");
        _zag_print(i64s(f));
        _zag_print(" lf0=");
        _zag_print(i64s(lf0));
        _zag_print(" lst=");
        _zag_print(i64s(lst));
        _zag_print("\n");
        f = f + 1;
    }
    _zag_print("probe_summary nfr=");
    _zag_print(i64s(nfr));
    _zag_print("\n");
    return 0;
}

fn main() i32 {
    let a1: []u8 = _zag_arg(1);
    if ((a1.len as i64) == 0) {
        _zag_print("usage: fast_probe <wav>\n");
        return 1;
    }
    return fast_probe(a1);
}

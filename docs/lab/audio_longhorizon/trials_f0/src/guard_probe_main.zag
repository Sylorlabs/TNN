// guard_probe_main.zag — per-frame dump for the F0 blind-spot attack (Phase B2c).
// Links organ_lib.zag (frozen organ DSP + helpers) and f0low.zag (guard).
// Pure Zag, zero RNG, deterministic given WAV bytes.
//
// Usage: guard_probe <wav>
// Per-frame line (one per organ frame, 2048/1024 @44.1k):
//   fr=<f> of0=<i> ov=<i> orms=<i> lf0=<i> lst=<i> gf0=<i> gv=<i> ghow=<i> sf0=<i> sv=<i> show=<i>
// of0/ov: frozen organ F0 (mHz) and voiced flag; lf0/lst: lowband estimator
// (st: 0 unvoiced, 1 confident, 2 ambiguous, 3 below floor); gf0/gv/ghow:
// guard "low" mode; sf0/sv/show: guard "scope" mode; ghow/show: 0 organ,
// 1 lowband, 2 out-of-range, 3 unvoiced.
// Summary line: probe_summary nfr=<i> + byte-identical across runs.

fn guard_probe(wavpath: []u8) i32 {
    let FR: []u8 = (_zag_malloc(208000) as *u8)[0..208000];
    let XW: []u8 = (_zag_malloc(8192) as *u8)[0..8192];
    let DW: []u8 = (_zag_malloc(2048) as *u8)[0..2048];
    let ON: []u8 = (_zag_malloc(32768) as *u8)[0..32768];
    let META: []u8 = (_zag_malloc(16) as *u8)[0..16];
    let H: []u8 = (_zag_malloc(8192) as *u8)[0..8192];
    let H512: []u8 = (_zag_malloc(2048) as *u8)[0..2048];
    let TWC: []u8 = (_zag_malloc(2048) as *u8)[0..2048];
    let TWS: []u8 = (_zag_malloc(2048) as *u8)[0..2048];
    let RL: []u8 = (_zag_malloc(4408) as *u8)[0..4408];
    let LRL: []u8 = (_zag_malloc(12288) as *u8)[0..12288];
    let LRES: []u8 = (_zag_malloc(16) as *u8)[0..16];
    let GRES: []u8 = (_zag_malloc(24) as *u8)[0..24];
    let META2: []u8 = (_zag_malloc(16) as *u8)[0..16];
    build_tables(H, H512, TWC, TWS);
    let nfr: i64 = analyze(wavpath, FR, XW, DW, ON, META, H, H512, TWC, TWS, RL);
    if (nfr < 0) {
        _zag_print("ERR\n");
        return 1;
    }
    let b: []u8 = file_read(wavpath, 6000000);
    if ((b.len as i64) < 44) {
        _zag_print("ERR\n");
        return 1;
    }
    if (wav_parse(b, META2) == 0) {
        _zag_print("ERR\n");
        return 1;
    }
    let ds0: i64 = get64(META2, 0);
    let nsamp: i64 = get64(META2, 8);
    let f: i64 = 0;
    while (f < nfr) {
        let s: i64 = f * 1024;
        let of0: i64 = get64(FR, f * 80 + 8);
        let orms: i64 = get64(FR, f * 80);
        let ov: i64 = get64(FR, f * 80 + 24);
        lowf0_frame(b, ds0, nsamp, s, 44100, 2048, LRL, LRES);
        let lf0: i64 = get64(LRES, 0);
        let lst: i64 = get64(LRES, 8);
        guard_frame(b, ds0, nsamp, s, 44100, of0, ov, orms, 0, LRL, LRES, GRES);
        let gf0: i64 = get64(GRES, 0);
        let gv: i64 = get64(GRES, 8);
        let ghow: i64 = get64(GRES, 16);
        guard_frame(b, ds0, nsamp, s, 44100, of0, ov, orms, 1, LRL, LRES, GRES);
        let sf0: i64 = get64(GRES, 0);
        let sv: i64 = get64(GRES, 8);
        let show: i64 = get64(GRES, 16);
        _zag_print("fr=");
        _zag_print(i64s(f));
        _zag_print(" of0=");
        _zag_print(i64s(of0));
        _zag_print(" ov=");
        _zag_print(i64s(ov));
        _zag_print(" lf0=");
        _zag_print(i64s(lf0));
        _zag_print(" lst=");
        _zag_print(i64s(lst));
        _zag_print(" gf0=");
        _zag_print(i64s(gf0));
        _zag_print(" gv=");
        _zag_print(i64s(gv));
        _zag_print(" ghow=");
        _zag_print(i64s(ghow));
        _zag_print(" sf0=");
        _zag_print(i64s(sf0));
        _zag_print(" sv=");
        _zag_print(i64s(sv));
        _zag_print(" show=");
        _zag_print(i64s(show));
        _zag_print("\n");
        f = f + 1;
    }
    _zag_print("probe_summary nfr=");
    _zag_print(i64s(nfr));
    _zag_print("\n");
    return 0;
}

fn main() i32 {
    let a1: []u8 = _zag_arg(1);
    if ((a1.len as i64) == 0) {
        _zag_print("usage: guard_probe <wav>\n");
        return 1;
    }
    return guard_probe(a1);
}

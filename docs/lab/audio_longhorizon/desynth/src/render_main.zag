// render_main.zag — standalone driver for render_desynth.zag.
// Assembly: organ_lib.zag + render_desynth.zag + render_main.zag.
// argv[1] (optional): output path. Renders the fixed verification plan:
//   amode 0 (atom0 child, flat), f0_mhz=890172, p1=1000000
// which must reproduce the deep-battery l020_iter0.wav byte-identically
// (same atom bytes, same code as the plan binary's render path).
fn main() i32 {
    let outp: []u8 = _zag_arg(1);
    if (outp.len == 0) {
        outp = "/tmp/rtest_verify.wav";
    }
    let CON: []u8 = (_zag_malloc(128) as *u8)[0..128];
    let j: i64 = 0;
    while (j < 16) {
        put64(CON, j * 8, 220472);
        j = j + 1;
    }
    let rc: i64 = render_plan(outp, 890172, 0, 1000000, CON);
    if (rc != 0) {
        _zag_print("ERR render failed\n");
        return 1;
    }
    _zag_print("RENDER_OK ");
    _zag_print(outp);
    _zag_print("\n");
    return 0;
}

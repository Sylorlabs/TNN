// hear_trigfree.zag — WALL-1 planner-specific trig-free hearing.
// Replaces the frozen organ's build_tables()+analyze() for the planner's needs.
//
// PROVENANCE: helper functions below are copied VERBATIM from the frozen
// organ (docs/lab/audio_longhorizon/desynth/build/organ_lib.zag @ 4f782c40d766).
// Deliberately NOT carried over: the Taylor-series cosine pair (trig),
// analyze (replaced by analyze_notrig below), and organ-only consumers the
// planner never calls (med_f0, rhy_asym, pr4_bits, organ_standalone_main_unused).
// Pure Zag, zero RNG, zero trig, zero synth primitives.

// ---------------- helpers (verbatim from frozen organ) ----------------
// ---------------- helpers ----------------
fn cstr(s: []u8) []u8 {
    if (s.len < 1 || s.len > 4095) { return ""; }
    let p: *u8 = _zag_malloc((s.len + 1) as i64) as *u8;
    if (p == null as *u8) { return ""; }
    let b: []u8 = p[0..(s.len + 1)];
    let i: i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn file_read(path: []u8, cap: i64) []u8 {
    let cs: []u8 = cstr(path);
    if (cs.len == 0) { return ""; }
    let fd: i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 0, 0, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return ""; }
    let p: *u8 = _zag_malloc(cap) as *u8;
    if (p == null as *u8) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return ""; }
    let at: i64 = 0;
    while (at < cap) {
        let n: i64 = _zag_raw_syscall(0, fd, (p as i64) + at, cap - at, 0, 0, 0);
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let b: []u8 = p[0..at];
    return b;
}

// sample idx -> signed 16-bit (idx counts samples, byte offset = idx*2)
fn get_s16(b: []u8, idx: i64) i64 {
    let o: i64 = idx * 2;
    let lo: i64 = (b[o] as i64) & 255;
    let hi: i64 = (b[o + 1] as i64) & 255;
    let v: i64 = lo | (hi << 8);
    if (v >= 32768) { v = v - 65536; }
    return v;
}

fn get_u32(b: []u8, o: i64) i64 {
    return ((b[o] as i64) & 255) | (((b[o + 1] as i64) & 255) << 8) | (((b[o + 2] as i64) & 255) << 16) | (((b[o + 3] as i64) & 255) << 24);
}

// signed 32-bit LE accessor (ZNC-007 workaround: never as []i32)
fn get32s(a: []u8, o: i64) i64 {
    let v: i64 = get_u32(a, o);
    if (v >= 2147483648) { v = v - 4294967296; }
    return v;
}

fn put32(a: []u8, o: i64, v: i64) void {
    a[o] = (v & 255) as u8;
    a[o + 1] = ((v >> 8) & 255) as u8;
    a[o + 2] = ((v >> 16) & 255) as u8;
    a[o + 3] = ((v >> 24) & 255) as u8;
    return;
}

fn get64(a: []u8, o: i64) i64 {
    let v: i64 = 0;
    let i: i64 = 0;
    while (i < 8) {
        v = v | (((a[o + i] as i64) & 255) << (i * 8));
        i = i + 1;
    }
    return v;
}

fn put64(a: []u8, o: i64, v: i64) void {
    let i: i64 = 0;
    while (i < 8) {
        a[o + i] = ((v >> (i * 8)) & 255) as u8;
        i = i + 1;
    }
    return;
}

fn streq(a: []u8, b: []u8) i64 {
    if (a.len != b.len) { return 0; }
    let i: i64 = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// strip trailing newline from _zag_i64_to_str (helper-print quirk)
fn i64s(v: i64) []u8 {
    let s: []u8 = _zag_i64_to_str(v);
    let n: i64 = s.len as i64;
    if (n > 0 && s[n - 1] == 10) { return s[0..(n - 1)]; }
    return s;
}

// sample accessor with zero-pad outside [0, nsamp); ds0 = data start sample index
fn samp(b: []u8, ds0: i64, i: i64, nsamp: i64) i64 {
    if (i < 0 || i >= nsamp) { return 0; }
    return get_s16(b, ds0 + i);
}

// ln via range reduction + atanh series; x<=0 -> large negative sentinel
fn lnx(x: f64) f64 {
    if (x <= 0.0) { return -10000000000.0; }
    let e: i64 = 0;
    let m: f64 = x;
    while (m >= 2.0) { m = m * 0.5; e = e + 1; }
    while (m < 1.0) { m = m * 2.0; e = e - 1; }
    let y: f64 = (m - 1.0) / (m + 1.0);
    let y2: f64 = y * y;
    let term: f64 = y;
    let s: f64 = y;
    let k: i64 = 1;
    while (k < 25) {
        term = term * y2;
        s = s + term / ((2 * k + 1) as f64);
        k = k + 1;
    }
    return 2.0 * s + (e as f64) * 0.6931471805599453;
}

fn log10x(x: f64) f64 {
    return lnx(x) / 2.302585092994046;
}

// ---------------- WAV parse ----------------
// META2: [0]=data start sample index (byte_off/2), [1]=nsamp. Returns 1 ok / 0 fail.
fn wav_parse(b: []u8, META2: []u8) i64 {
    if ((b.len as i64) < 44) { return 0; }
    if (!(b[0] == 82 && b[1] == 73 && b[2] == 70 && b[3] == 70)) { return 0; } // RIFF
    if (!(b[8] == 87 && b[9] == 65 && b[10] == 86 && b[11] == 69)) { return 0; } // WAVE
    let off: i64 = 12;
    let blen: i64 = b.len as i64;
    let fmt_ok: i64 = 0;
    let dsamp: i64 = -1;
    let nsamp: i64 = 0;
    while (off + 8 <= blen) {
        let c0: i64 = b[off] as i64;
        let c1: i64 = b[off + 1] as i64;
        let c2: i64 = b[off + 2] as i64;
        let c3: i64 = b[off + 3] as i64;
        let sz: i64 = get_u32(b, off + 4);
        if (c0 == 102 && c1 == 109 && c2 == 116 && c3 == 32) { // "fmt "
            if (sz < 16) { return 0; }
            let afmt: i64 = ((b[off + 8] as i64) & 255) | (((b[off + 9] as i64) & 255) << 8);
            let ch: i64 = ((b[off + 10] as i64) & 255) | (((b[off + 11] as i64) & 255) << 8);
            let sr: i64 = get_u32(b, off + 12);
            let bits: i64 = ((b[off + 22] as i64) & 255) | (((b[off + 23] as i64) & 255) << 8);
            if (afmt == 1 && ch == 1 && sr == 44100 && bits == 16) { fmt_ok = 1; }
        }
        if (c0 == 100 && c1 == 97 && c2 == 116 && c3 == 97) { // "data"
            dsamp = (off + 8) / 2;
            nsamp = sz / 2;
        }
        off = off + 8 + sz;
    }
    if (fmt_ok == 0 || dsamp < 0 || nsamp <= 0) { return 0; }
    put64(META2, 0, dsamp);
    put64(META2, 8, nsamp);
    return 1;
}

// YIN cumulative-mean-normalized difference at one lag.
// RL holds unnormalized r[1..551] as i64; d[j] = 2*(r0 - r[j]).
fn dp_at(RL: []u8, r0: i64, lag: i64) f64 {
    let run: f64 = 0.0;
    let j: i64 = 1;
    while (j <= lag) {
        run = run + (2.0 * ((r0 - get64(RL, (j - 1) * 8)) as f64));
        j = j + 1;
    }
    let dlag: f64 = 2.0 * ((r0 - get64(RL, (lag - 1) * 8)) as f64);
    return dlag / (run / (lag as f64));
}

// autocorrelation sum at one lag over windowed frame XW (i32 LE, inlined loads)
fn acorr_at(XW: []u8, lag: i64) i64 {
    let s: i64 = 0;
    let n: i64 = 0;
    let lim: i64 = 2048 - lag;
    while (n < lim) {
        let o1: i64 = n * 4;
        let v1: i64 = ((XW[o1] as i64) & 255) | (((XW[o1 + 1] as i64) & 255) << 8) | (((XW[o1 + 2] as i64) & 255) << 16) | (((XW[o1 + 3] as i64) & 255) << 24);
        if (v1 >= 2147483648) { v1 = v1 - 4294967296; }
        let o2: i64 = (n + lag) * 4;
        let v2: i64 = ((XW[o2] as i64) & 255) | (((XW[o2 + 1] as i64) & 255) << 8) | (((XW[o2 + 2] as i64) & 255) << 16) | (((XW[o2 + 3] as i64) & 255) << 24);
        if (v2 >= 2147483648) { v2 = v2 - 4294967296; }
        s = s + v1 * v2;
        n = n + 1;
    }
    return s;
}

// ---------------- aggregation ----------------
fn isort(a: []u8, n: i64) void {
    let i: i64 = 1;
    while (i < n) {
        let key: i64 = get64(a, i * 8);
        let j: i64 = i - 1;
        while (j >= 0) {
            if (get64(a, j * 8) <= key) { break; }
            put64(a, (j + 1) * 8, get64(a, j * 8));
            j = j - 1;
        }
        put64(a, (j + 1) * 8, key);
        i = i + 1;
    }
    return;
}

// median of a per-frame field (byte offset off) over all frames
fn med_field(FR: []u8, nfr: i64, SORT: []u8, off: i64) i64 {
    let f: i64 = 0;
    while (f < nfr) {
        put64(SORT, f * 8, get64(FR, f * 80 + off));
        f = f + 1;
    }
    if (nfr == 0) { return 0; }
    isort(SORT, nfr);
    return get64(SORT, (nfr / 2) * 8);
}

// envelope class: 0 flat, 1 rise, 2 decay (thirds of rms_mdb, +-4 dB gate)
fn env_class(FR: []u8, nfr: i64) i64 {
    let n1: i64 = nfr / 3;
    let n2: i64 = 2 * nfr / 3;
    if (n1 <= 0 || nfr - n2 <= 0) { return 0; }
    let s1: i64 = 0;
    let f: i64 = 0;
    while (f < n1) { s1 = s1 + get64(FR, f * 80); f = f + 1; }
    let s3: i64 = 0;
    let g: i64 = n2;
    while (g < nfr) { s3 = s3 + get64(FR, g * 80); g = g + 1; }
    let d: i64 = s3 / (nfr - n2) - s1 / n1;
    if (d > 4000) { return 1; }
    if (d < -4000) { return 2; }
    return 0;
}

// ---------------- trig-free tables ----------------
// H: Hann 2048, scale 2^16 (i32) — embedded as literal data, bit-exact with
// what the frozen build_tables() produces (see H_dump.txt: 2048/2048 values
// cross-checked against an independent exact port of the cosine routine).
// H512/TWC/TWS are NOT built: they fed only the DFT block, which the planner
// never reads (see VERIFY_TRIGFREE.md DFT-unread proof).

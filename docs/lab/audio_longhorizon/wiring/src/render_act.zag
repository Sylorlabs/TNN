// render_act.zag — action render machinery (PREREG_LH §1 stage 3).
// Pure Zag, zero RNG. Reads a deliberation journal from stdin, renders
// one output WAV per episode into <outdir>.
//   render_act <outdir>
// Action -> sound mapping (frozen wiring-layer vocabulary v1, deterministic):
//   QUERY    (0): 0.5s 880 Hz ping, decaying  ("question probe")
//   CONTINUE (1): 0.5s silence               ("pass")
//   NOTE_NEW (2): 1.0s 660 -> 990 Hz two-tone ("novelty marker")
//   RECALL   (3): 1.0s sine at the HEARD f0   ("echo what was heard";
//              clamped 60..2000 Hz, 440 Hz if unvoiced)
//   ATTEND   (4): 1.0s 440+550 Hz with 8 Hz tremolo ("urgent")
// Output: <outdir>/ep<n>.wav, PCM16 mono 44100 Hz.
// Links organ_lib.zag for cstr, cosr, put32, streq, i64s.

fn stdin_read(cap: i64) []u8 {
    let p: *u8 = _zag_malloc(cap) as *u8;
    if (p == null as *u8) { return ""; }
    let at: i64 = 0;
    while (at < cap) {
        let n: i64 = _zag_raw_syscall(0, 0, (p as i64) + at, cap - at, 0, 0, 0);
        if (n <= 0) { break; }
        at = at + n;
    }
    let b: []u8 = p[0..at];
    return b;
}

fn parse_i64(s: []u8) i64 {
    let n: i64 = s.len as i64;
    if (n == 0) { return 0; }
    let neg: i64 = 0;
    let i: i64 = 0;
    if (s[0] == 45) {
        neg = 1;
        i = 1;
    }
    let v: i64 = 0;
    while (i < n) {
        let c: i64 = s[i] as i64;
        if (c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (neg == 1) { v = 0 - v; }
    return v;
}

fn kv_val(line: []u8, key: []u8) []u8 {
    let n: i64 = line.len as i64;
    let k: i64 = key.len as i64;
    let i: i64 = 0;
    while (i + k + 1 <= n) {
        if (i == 0 || line[i - 1] == 32) {
            let m: i64 = 0;
            while (m < k) {
                if (line[i + m] != key[m]) { break; }
                m = m + 1;
            }
            if (m == k && line[i + k] == 61) {
                let j: i64 = i + k + 1;
                while (j < n && line[j] != 32 && line[j] != 10) { j = j + 1; }
                return line[(i + k + 1)..j];
            }
        }
        i = i + 1;
    }
    return "";
}

fn starts_with(line: []u8, pre: []u8) i64 {
    if ((line.len as i64) < (pre.len as i64)) { return 0; }
    let i: i64 = 0;
    while (i < (pre.len as i64)) {
        if (line[i] != pre[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn action_id(name: []u8) i64 {
    if (streq(name, "QUERY")) { return 0; }
    if (streq(name, "CONTINUE")) { return 1; }
    if (streq(name, "NOTE_NEW")) { return 2; }
    if (streq(name, "RECALL")) { return 3; }
    if (streq(name, "ATTEND")) { return 4; }
    return -1;
}

// first whitespace-delimited word of s
fn first_word(s: []u8) []u8 {
    let n: i64 = s.len as i64;
    let j: i64 = 0;
    while (j < n && s[j] != 32 && s[j] != 10 && s[j] != 13) { j = j + 1; }
    return s[0..j];
}

fn write_wav(path: []u8, data: []u8, nsamp: i64) i64 {
    let dbytes: i64 = nsamp * 2;
    let hdr: []u8 = (_zag_malloc(44) as *u8)[0..44];
    hdr[0] = 82; hdr[1] = 73; hdr[2] = 70; hdr[3] = 70;
    put32(hdr, 4, 36 + dbytes);
    hdr[8] = 87; hdr[9] = 65; hdr[10] = 86; hdr[11] = 69;
    hdr[12] = 102; hdr[13] = 109; hdr[14] = 116; hdr[15] = 32;
    put32(hdr, 16, 16);
    hdr[20] = 1; hdr[21] = 0;
    hdr[22] = 1; hdr[23] = 0;
    put32(hdr, 24, 44100);
    put32(hdr, 28, 88200);
    hdr[32] = 2; hdr[33] = 0;
    hdr[34] = 16; hdr[35] = 0;
    hdr[36] = 100; hdr[37] = 97; hdr[38] = 116; hdr[39] = 97;
    put32(hdr, 40, dbytes);
    let cs: []u8 = cstr(path);
    if (cs.len == 0) { return -1; }
    let fd: i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 577, 420, 0, 0, 0);
    if (fd < 0) { return -2; }
    let w1: i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(hdr) as i64), 44, 0, 0, 0);
    let w2: i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(data) as i64), dbytes, 0, 0, 0);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if (w1 != 44 || w2 != dbytes) { return -3; }
    return 0;
}

fn render_ep(outdir: []u8, turn: i64, act: i64, f0mhz: i64) i64 {
    let dur: i64 = 22050;
    if (act == 2 || act == 3 || act == 4) { dur = 44100; }
    let data: []u8 = (_zag_malloc(dur * 2) as *u8)[0..(dur * 2)];
    let i: i64 = 0;
    while (i < dur * 2) { data[i] = 0; i = i + 1; }
    let pi: f64 = 3.141592653589793;
    let sr: f64 = 44100.0;
    // RECALL pitch from heard f0
    let rf: f64 = 440.0;
    if (act == 3) {
        if (f0mhz > 0) {
            rf = (f0mhz as f64) / 1000.0;
            if (rf < 60.0) { rf = 60.0; }
            if (rf > 2000.0) { rf = 2000.0; }
        }
    }
    let n: i64 = 0;
    while (n < dur) {
        let t: f64 = (n as f64) / sr;
        let s: f64 = 0.0;
        if (act == 0) {
            let ph: f64 = 2.0 * pi * 880.0 * t - pi / 2.0;
            let dec: f64 = 1.0 - (n as f64) / (dur as f64);
            s = 0.25 * cosr(ph) * dec;
        } else if (act == 1) {
            s = 0.0;
        } else if (act == 2) {
            let f: f64 = 660.0;
            if (n >= dur / 2) { f = 990.0; }
            let ph2: f64 = 2.0 * pi * f * t - pi / 2.0;
            s = 0.25 * cosr(ph2);
        } else if (act == 3) {
            let ph3: f64 = 2.0 * pi * rf * t - pi / 2.0;
            s = 0.25 * cosr(ph3);
        } else if (act == 4) {
            let a: f64 = 2.0 * pi * 440.0 * t - pi / 2.0;
            let b: f64 = 2.0 * pi * 550.0 * t - pi / 2.0;
            let trem: f64 = 0.6 + 0.4 * cosr(2.0 * pi * 8.0 * t);
            s = 0.15 * (cosr(a) + cosr(b)) * trem;
        }
        // 10 ms linear fades to avoid clicks
        let fade: f64 = 1.0;
        if (n < 441) { fade = (n as f64) / 441.0; }
        if (n > dur - 441) { fade = ((dur - n) as f64) / 441.0; }
        s = s * fade;
        let v: i64 = (s * 32767.0) as i64;
        if (v > 32767) { v = 32767; }
        if (v < -32768) { v = -32768; }
        let uv: i64 = v;
        if (uv < 0) { uv = uv + 65536; }
        data[n * 2] = (uv & 255) as u8;
        data[n * 2 + 1] = ((uv / 256) & 255) as u8;
        n = n + 1;
    }
    // path: outdir + "/ep" + turn + ".wav"
    let ts: []u8 = i64s(turn);
    let od: i64 = outdir.len as i64;
    let pl: i64 = od + 3 + (ts.len as i64) + 4;
    let path: []u8 = (_zag_malloc(pl + 1) as *u8)[0..(pl + 1)];
    let k: i64 = 0;
    while (k < od) { path[k] = outdir[k]; k = k + 1; }
    path[od] = 47; path[od + 1] = 101; path[od + 2] = 112;
    let q: i64 = 0;
    while (q < (ts.len as i64)) { path[od + 3 + q] = ts[q]; q = q + 1; }
    path[od + 3 + (ts.len as i64)] = 46;
    path[od + 4 + (ts.len as i64)] = 119;
    path[od + 5 + (ts.len as i64)] = 97;
    path[od + 6 + (ts.len as i64)] = 118;
    path[pl] = 0;
    let rc: i64 = write_wav(path[0..pl], data, dur);
    if (rc != 0) {
        _zag_print("ERR render ep ");
        _zag_print(ts);
        _zag_print(" rc=");
        _zag_print(i64s(rc));
        _zag_print("\n");
    }
    return rc;
}

fn main() i32 {
    let od: []u8 = _zag_arg(1);
    if (od.len == 0) {
        _zag_print("ERR usage: render_act <outdir>\n");
        return 1;
    }
    let inp: []u8 = stdin_read(4194304);
    let n: i64 = inp.len as i64;
    let turn: i64 = 0;
    let f0: i64 = 0;
    let act: i64 = -1;
    let rendered: i64 = 0;
    let i: i64 = 0;
    while (i < n) {
        let j: i64 = i;
        while (j < n && inp[j] != 10) { j = j + 1; }
        let line: []u8 = inp[i..j];
        if (starts_with(line, "EP ") == 1) {
            turn = parse_i64(line[3..]);
            f0 = 0;
            act = -1;
        } else if (starts_with(line, "HEARD ") == 1) {
            f0 = parse_i64(kv_val(line, "f0_mhz"));
        } else if (starts_with(line, "ACTION ") == 1) {
            act = action_id(first_word(line[7..]));
            if (turn > 0 && act >= 0) {
                render_ep(od, turn, act, f0);
                rendered = rendered + 1;
            } else {
                _zag_print("ERR bad ACTION line\n");
            }
            act = -1;
        }
        i = j + 1;
    }
    _zag_print("RENDERED ");
    _zag_print(i64s(rendered));
    _zag_print(" episodes\n");
    return 0;
}

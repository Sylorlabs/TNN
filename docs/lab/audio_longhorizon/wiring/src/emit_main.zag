// emit_main.zag — ingest stage: WAV -> organ -> descriptor vector on stdout.
// Pure Zag. Links organ_lib.zag (byte-identical frozen organ functions) and
// f0low.zag (low-band F0 estimator + range guard).
//
// Usage:
//   emit_desc <wav> [low|scope]   descriptor line on stdout ("low" default)
//   emit_desc probe <wav>          per-frame low-band F0 dump (44.1k or 8k)
//
// Descriptor line (native strings/ints, PREREG_LH §1 vocabulary):
//   desc f0_mhz=<i> voiced=<i> env=<flat|rise|decay> rms=<i> zcr=<i>
//        b0r=<i> b1r=<i> b2r=<i> b3r=<i> onsets=<i> pr4=<i> nfr=<i>
//        guard=<low|scope> lowband=<i> oor=<i>
// f0_mhz/voiced are GUARDED (f0low guard policy); pr4/env/bands/rms/zcr are
// the frozen organ's unguarded aggregates (P-R4 anchor-preserving).


fn print_kv_i64(k: []u8, v: i64) void {
    _zag_print(k);
    _zag_print("=");
    _zag_print(i64s(v));
    _zag_print(" ");
    return;
}

fn emit_probe(wavpath: []u8) i32 {
    let b: []u8 = file_read(wavpath, 6000000);
    if ((b.len as i64) < 44) {
        _zag_print("ERR\n");
        return 1;
    }
    let META3: []u8 = (_zag_malloc(24) as *u8)[0..24];
    if (wav_parse_any(b, META3) == 0) {
        _zag_print("ERR\n");
        return 1;
    }
    let ds0: i64 = get64(META3, 0);
    let nsamp: i64 = get64(META3, 8);
    let sr: i64 = get64(META3, 16);
    let nframe: i64 = 2048;
    let hop: i64 = 1024;
    if (sr == 8000) {
        nframe = 1024;
        hop = 512;
    }
    let LRL: []u8 = (_zag_malloc(12288) as *u8)[0..12288];
    let LRES: []u8 = (_zag_malloc(16) as *u8)[0..16];
    let SORT: []u8 = (_zag_malloc(32768) as *u8)[0..32768];
    let nfr: i64 = 1;
    if (nsamp >= nframe) { nfr = (nsamp - nframe) / hop + 1; }
    let f: i64 = 0;
    let c_conf: i64 = 0;
    let c_amb: i64 = 0;
    let c_flr: i64 = 0;
    let c_unv: i64 = 0;
    let c_cf0: i64 = 0;
    while (f < nfr) {
        let s: i64 = f * hop;
        lowf0_frame(b, ds0, nsamp, s, sr, nframe, LRL, LRES);
        let lf0: i64 = get64(LRES, 0);
        let lst: i64 = get64(LRES, 8);
        _zag_print("fr=");
        _zag_print(i64s(f));
        _zag_print(" f0=");
        _zag_print(i64s(lf0));
        _zag_print(" st=");
        _zag_print(i64s(lst));
        _zag_print("\n");
        if (lst == 1) {
            c_conf = c_conf + 1;
            put64(SORT, c_cf0 * 8, lf0);
            c_cf0 = c_cf0 + 1;
        }
        if (lst == 2) { c_amb = c_amb + 1; }
        if (lst == 3) { c_flr = c_flr + 1; }
        if (lst == 0) { c_unv = c_unv + 1; }
        f = f + 1;
    }
    let med: i64 = 0;
    if (c_cf0 > 0) {
        isort(SORT, c_cf0);
        med = get64(SORT, (c_cf0 / 2) * 8);
    }
    _zag_print("probe_summary nfr=");
    _zag_print(i64s(nfr));
    _zag_print(" confident=");
    _zag_print(i64s(c_conf));
    _zag_print(" ambiguous=");
    _zag_print(i64s(c_amb));
    _zag_print(" belowfloor=");
    _zag_print(i64s(c_flr));
    _zag_print(" unvoiced=");
    _zag_print(i64s(c_unv));
    _zag_print(" med_conf_f0=");
    _zag_print(i64s(med));
    _zag_print("\n");
    return 0;
}

fn main() i32 {
    let a1: []u8 = _zag_arg(1);
    let a2: []u8 = _zag_arg(2);
    if (streq(a1, "probe") == 1) {
        return emit_probe(a2);
    }
    let mode: i64 = 0;
    let gname: []u8 = "low";
    if (streq(a2, "scope") == 1) {
        mode = 1;
        gname = "scope";
    }
    let FR: []u8 = (_zag_malloc(208000) as *u8)[0..208000];
    let XW: []u8 = (_zag_malloc(8192) as *u8)[0..8192];
    let DW: []u8 = (_zag_malloc(2048) as *u8)[0..2048];
    let ON: []u8 = (_zag_malloc(32768) as *u8)[0..32768];
    let META: []u8 = (_zag_malloc(16) as *u8)[0..16];
    let SORT: []u8 = (_zag_malloc(32768) as *u8)[0..32768];
    let H: []u8 = (_zag_malloc(8192) as *u8)[0..8192];
    let H512: []u8 = (_zag_malloc(2048) as *u8)[0..2048];
    let TWC: []u8 = (_zag_malloc(2048) as *u8)[0..2048];
    let TWS: []u8 = (_zag_malloc(2048) as *u8)[0..2048];
    let RL: []u8 = (_zag_malloc(4408) as *u8)[0..4408];
    let LRL: []u8 = (_zag_malloc(12288) as *u8)[0..12288];
    let LRES: []u8 = (_zag_malloc(16) as *u8)[0..16];
    let GRES: []u8 = (_zag_malloc(24) as *u8)[0..24];
    let META2: []u8 = (_zag_malloc(16) as *u8)[0..16];
    let GF0: []u8 = (_zag_malloc(20800) as *u8)[0..20800];
    let GV: []u8 = (_zag_malloc(20800) as *u8)[0..20800];
    build_tables(H, H512, TWC, TWS);
    // Wiring layer is 44.1k-only (frozen organ constraint); sr is emitted
    // so downstream stages compute durations correctly.
    let sr: i64 = 44100;
    let nfr: i64 = analyze(a1, FR, XW, DW, ON, META, H, H512, TWC, TWS, RL);
    if (nfr < 0) {
        _zag_print("ERR\n");
        return 1;
    }
    let nonset: i64 = get64(META, 8);
    let b: []u8 = file_read(a1, 6000000);
    if (wav_parse(b, META2) == 0) {
        _zag_print("ERR\n");
        return 1;
    }
    let ds0: i64 = get64(META2, 0);
    let nsamp: i64 = get64(META2, 8);
    let f: i64 = 0;
    let nlow: i64 = 0;
    let noor: i64 = 0;
    while (f < nfr) {
        let s: i64 = f * 1024;
        guard_frame(b, ds0, nsamp, s, 44100, get64(FR, f * 80 + 8), get64(FR, f * 80 + 24), get64(FR, f * 80), mode, LRL, LRES, GRES);
        put64(GF0, f * 8, get64(GRES, 0));
        put64(GV, f * 8, get64(GRES, 8));
        let how: i64 = get64(GRES, 16);
        if (how == 1) { nlow = nlow + 1; }
        if (how == 2) { noor = noor + 1; }
        f = f + 1;
    }
    let f0m: i64 = guarded_med_f0(GF0, GV, nfr, SORT);
    let vf: i64 = guarded_voiced_frac(GV, nfr);
    let rmsm: i64 = med_field(FR, nfr, SORT, 0);
    let zcrm: i64 = med_field(FR, nfr, SORT, 32);
    let b0m: i64 = med_field(FR, nfr, SORT, 48);
    let b1m: i64 = med_field(FR, nfr, SORT, 56);
    let b2m: i64 = med_field(FR, nfr, SORT, 64);
    let b3m: i64 = med_field(FR, nfr, SORT, 72);
    let ec: i64 = env_class(FR, nfr);
    let pr4: i64 = pr4_bits(FR, nfr, SORT);
    _zag_print("desc ");
    print_kv_i64("f0_mhz", f0m);
    print_kv_i64("voiced", vf);
    _zag_print("env=");
    if (ec == 1) { _zag_print("rise "); }
    if (ec == 2) { _zag_print("decay "); }
    if (ec == 0) { _zag_print("flat "); }
    print_kv_i64("rms", rmsm);
    print_kv_i64("zcr", zcrm);
    print_kv_i64("b0r", b0m);
    print_kv_i64("b1r", b1m);
    print_kv_i64("b2r", b2m);
    print_kv_i64("b3r", b3m);
    print_kv_i64("onsets", nonset);
    print_kv_i64("pr4", pr4);
    print_kv_i64("nfr", nfr);
    print_kv_i64("sr", sr);
    _zag_print("guard=");
    _zag_print(gname);
    _zag_print(" ");
    print_kv_i64("lowband", nlow);
    print_kv_i64("oor", noor);
    _zag_print("\n");
    return 0;
}

// D-P3 adversarial-evidence generator — pure Zag, deterministic.
// Usage: dp3_gen <seed> <n_items>
// Emits D3-CFG / D3-ITEM / D3-EV records to stdout, byte-identical per seed.
// Seed is fixed in dp3_seed.cfg (HTD-1 R3 frozen artifact).
//
// Determinism contract: LCG state = (state * 1103515245 + 12345) & 0x7FFFFFFF
// (glibc constants, 31-bit). All intermediates < 2^63: no platform-dependent
// overflow. No wall-clock, no addresses, no RNG in any decision path.
//
// Item semantics (frozen):
//   - item i: n_hyp hypotheses (ids 0..n_hyp-1, 4<=n_hyp<=16), one survivor s.
//   - E = n_hyp-1 evidence entries; entry j eliminates exactly one hypothesis.
//   - the eliminated multiset = all ids except s; s is never eliminated.
//   - one entry is decisive (weight 100, eliminates d_hyp != s); rest weight 10.
//   - orderings permute the decisive entry's position only:
//       favorable   (0): decisive at position 0
//       canonical   (1): decisive at position E/2
//       adversarial (2): decisive at position E-1
//   - correctness: the unique hypothesis with zero elimination weight is s.
//     Early-exit arms trade deliberation cost against the risk of missing an
//     elimination; the adversarial ordering maximizes that risk.

fn d3_rand_next(s:*i64)i64 {
    let v:i64=s.*;
    v=v*1103515245+12345;
    v=v&2147483647;
    s.*=v;
    return v;
}

fn d3_atoi(a:[]u8)i64 {
    let n:i64=0;
    let i:i64=0;
    while(i<a.len){
        let c:i64=a[i] as i64;
        if(c>=48){ if(c<=57){ n=n*10+(c-48); } }
        i=i+1;
    }
    return n;
}

fn d3_pnum(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
}

fn d3_evidence(item:i64,nh:i64,surv:i64,dhyp:i64,ord:i64)void {
    let e:i64=nh-1;
    let dpos:i64=0;
    if(ord==1){ dpos=e/2; }
    if(ord==2){ dpos=e-1; }
    let ev:i64=0;
    let h:i64=0;
    while(ev<e){
        _zag_print("D3-EV,");
        d3_pnum(item); _zag_print(",");
        d3_pnum(ord); _zag_print(",");
        d3_pnum(ev); _zag_print(",");
        if(ev==dpos){
            d3_pnum(dhyp); _zag_print(",100,1");
        } else {
            let done:i64=0;
            while(done==0){
                if(h==surv){ h=h+1; }
                else if(h==dhyp){ h=h+1; }
                else { done=1; }
            }
            d3_pnum(h); _zag_print(",10,0");
            h=h+1;
        }
        _zag_println("");
        ev=ev+1;
    }
}

fn main()i32 {
    let sa:[]u8=_zag_arg(1);
    let sb:[]u8=_zag_arg(2);
    let seed:i64=d3_atoi(sa);
    let n:i64=d3_atoi(sb);
    if(n<=0){ _zag_println("D3-BADARG"); return 1; }
    _zag_print("D3-CFG,");
    d3_pnum(seed); _zag_print(","); d3_pnum(n); _zag_println(",items");
    let st:i64=seed;
    let i:i64=0;
    while(i<n){
        let nh:i64=4+(d3_rand_next(&st)%13);
        let surv:i64=d3_rand_next(&st)%nh;
        let dh:i64=d3_rand_next(&st)%(nh-1);
        if(dh>=surv){ dh=dh+1; }
        _zag_print("D3-ITEM,");
        d3_pnum(i); _zag_print(",");
        d3_pnum(nh); _zag_print(","); d3_pnum(surv); _zag_println("");
        let o:i64=0;
        while(o<3){
            d3_evidence(i,nh,surv,dh,o);
            o=o+1;
        }
        i=i+1;
    }
    _zag_println("D3-DONE");
    return 0;
}

// replay.zag — E-LG2 replay verifier.
//
// Reconstructs the full audit ledger byte-exactly from an E-LG2 artifact's
// checkpoint+delta encoded section and byte-compares it against the
// FULL-DELIB reference artifact's raw ledger (the replay baseline).
// Also re-verifies the FNV chain over the reconstructed bytes (proves the
// reconstruction is a valid append-only ledger) and checks per-item outcome
// agreement (winner fields).
//
// Usage: replay_bin ELG2_ARTIFACT FULLDELIB_ARTIFACT
// Exit: 0 REPLAY_PASS, 1 REPLAY_FAIL (any byte divergence / chain break /
// malformed encoding), 2 usage/IO error.
@import("../ref-baselines/audit.zag")
@import("../ref-baselines/fio.zag")
@import("../ref-baselines/memstore.zag")
@import("../ref-baselines/R33_NATIVE_SHA256_V2.zag")

fn rp_g16(b:[]u8, at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8);
}

fn rp_p32(b:[]u8, at:i32, v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
}

// Re-decode the LG2 section into recon (exactly want_len bytes).
// Stats via out-params. Returns 0 on success, nonzero on malformed input.
fn rp_decode(enc:[]u8, recon:[]u8, want_entries:i32, want_bytes:i32,
             snap_raw:*i64, delta_recs:*i64, snap_recs:*i64,
             r_words:*i64) i32 {
    let at:i32=0;
    if(enc.len<24){return -1;}
    if(_zag_strcmp(enc[0..8],"HTD1LG2S")!=1){return -1;}
    at=8;
    let ver:i32=aud_g32(enc,at); at=at+4;
    let K:i32=aud_g32(enc,at); at=at+4;
    let n_ep:i32=aud_g32(enc,at); at=at+4;
    let total:i32=aud_g32(enc,at); at=at+4;
    if(ver!=1){return -1;}
    if(total!=want_entries){return -1;}
    if(K!=16 && K!=64 && K!=256){return -1;}
    // preamble
    if(at+5>enc.len){return -1;}
    let tag:i32=enc[at] as i32; at=at+1;
    let m0:i32=aud_g32(enc,at); at=at+4;
    if(tag!=2||m0!=1){return -1;}
    if(at+64>enc.len){return -1;}
    let i:i32=0;
    while(i<64){recon[i]=enc[at+i];i=i+1;}
    at=at+64;
    r_words.*=r_words.*+16;
    let recon_at:i32=64;
    let prev_start:i32=0;
    let prev_m:i32=0;
    let ep:i32=0;
    while(ep<n_ep){
        if(at+5>enc.len){return -1;}
        let tg:i32=enc[at] as i32; at=at+1;
        let m:i32=aud_g32(enc,at); at=at+4;
        if(m<0||m>4096){return -1;}
        if(tg==0){
            // snapshot: raw entries
            if(at+m*64>enc.len){return -1;}
            if(recon_at+m*64>want_bytes){return -1;}
            i=0;
            while(i<m*64){recon[recon_at+i]=enc[at+i];i=i+1;}
            at=at+m*64;
            r_words.*=r_words.*+(16 as i64)*(m as i64);
            snap_raw.*=snap_raw.*+(64 as i64)*(m as i64);
            snap_recs.*=snap_recs.*+1;
            prev_start=recon_at; prev_m=m;
            recon_at=recon_at+m*64;
        } else if(tg==1){
            // delta: XOR vs previous episode's same-position entries
            if(at+4>enc.len){return -1;}
            let m_prev:i32=aud_g32(enc,at); at=at+4;
            if(m_prev!=prev_m){return -1;}
            if(m_prev<0){return -1;}
            if(recon_at+m*64>want_bytes){return -1;}
            delta_recs.*=delta_recs.*+1;
            let ii:i32=0;
            while(ii<m){
                if(at+2>enc.len){return -1;}
                let mask:i32=rp_g16(enc,at); at=at+2;
                let j:i32=0;
                while(j<16){
                    let bit:i32=(mask>>j)&1;
                    let ro:i32=recon_at+ii*64+j*4;
                    if(bit==1){
                        if(at+4>enc.len){return -1;}
                        let w:i32=aud_g32(enc,at); at=at+4;
                        r_words.*=r_words.*+1;
                        if(ii<m_prev){
                            let rfo:i32=prev_start+ii*64+j*4;
                            let rw:i32=aud_g32(recon,rfo);
                            r_words.*=r_words.*+1;
                            rp_p32(recon,ro,rw^w);
                        } else {
                            // no reference position: words stored raw
                            rp_p32(recon,ro,w);
                        }
                    } else {
                        if(ii>=m_prev){return -1;}
                        let rfo2:i32=prev_start+ii*64+j*4;
                        let rw2:i32=aud_g32(recon,rfo2);
                        r_words.*=r_words.*+1;
                        rp_p32(recon,ro,rw2);
                    }
                    j=j+1;
                }
                ii=ii+1;
            }
            prev_start=recon_at; prev_m=m;
            recon_at=recon_at+m*64;
        } else {
            return -1;
        }
        ep=ep+1;
    }
    if(recon_at!=want_bytes){return -1;}
    if(at!=enc.len){return -1;}
    return 0;
}

// Re-verify the FNV chain over raw ledger bytes. 0 = valid.
fn rp_chain_ok(b:[]u8, n:i32)i32 {
    let h:i64=1469598103934665603;
    let e:i32=0;
    while(e<n){
        let at2:i32=e*64;
        let j:i32=0;
        while(j<56){
            h=h^(b[at2+j] as i64);
            h=h*1099511628211;
            j=j+1;
        }
        if(aud_g32(b,at2+56)!=((h&4294967295) as i32)){return e+1;}
        if(aud_g32(b,at2+60)!=(((h>>32)&4294967295) as i32)){return -(e+1);}
        e=e+1;
    }
    return 0;
}

fn main()i32 {
    let p1:[]u8=_zag_arg(1);
    let p2:[]u8=_zag_arg(2);
    if(p1.len==0||p2.len==0){
        _zag_println("USAGE: replay_bin ELG2_ARTIFACT FULLDELIB_ARTIFACT");
        return 2;
    }
    let r1:FioRead=fio_read_all(p1,33554431);
    let r2:FioRead=fio_read_all(p2,33554431);
    if(r1.ok==0||r2.ok==0){_zag_println("READ_FAIL");return 2;}
    let d1:[]u8=r1.buf; let d2:[]u8=r2.buf;
    if(r1.n<24||r2.n<24){_zag_println("SHORT");return 2;}
    if(_zag_strcmp(d1[0..8],"HTD1E2A1")!=1){_zag_println("ELG2_MAGIC_BAD");return 2;}
    if(_zag_strcmp(d2[0..8],"HTD1FDA1")!=1){_zag_println("FD_MAGIC_BAD");return 2;}
    let n:i32=ms_g32(d1,16);
    let n2:i32=ms_g32(d2,16);
    if(n!=n2||n<1){_zag_println("N_MISMATCH");return 2;}
    let rec1:[]u8=d1[24..24+n*128];
    let rec2:[]u8=d2[24..24+n*128];
    let eoff:i32=24+n*128+72;
    if(eoff+4>r1.n||eoff+4>r2.n){_zag_println("OFF_BAD");return 2;}
    let enc_len:i32=ms_g32(d1,eoff);
    let ldg_len:i32=ms_g32(d2,eoff);
    if(enc_len<24||ldg_len<64){_zag_println("LEN_BAD");return 2;}
    if(eoff+4+enc_len>r1.n||eoff+4+ldg_len>r2.n){_zag_println("LEN_OVERRUN");return 2;}
    let enc:[]u8=d1[eoff+4..eoff+4+enc_len];
    let ldg:[]u8=d2[eoff+4..eoff+4+ldg_len];
    // decode
    let recon:[]u8=nio_alloc(ldg_len);
    if(recon.len==0){_zag_println("RECON_ALLOC_FAIL");return 2;}
    let snap_raw:i64=0; let delta_recs:i64=0; let snap_recs:i64=0;
    let r_words:i64=0;
    let psr:*i64=&snap_raw; let pdr:*i64=&delta_recs;
    let pnr:*i64=&snap_recs; let prw:*i64=&r_words;
    let dc:i32=rp_decode(enc,recon,ldg_len/64,ldg_len,psr,pdr,pnr,prw);
    if(dc!=0){_zag_println("DECODE_FAIL");return 1;}
    // byte-compare full reconstruction vs the unencoded ledger
    let diff_at:i32=-1;
    let i:i32=0;
    while(i<ldg_len){
        if(recon[i]!=ldg[i]){diff_at=i;break;}
        i=i+1;
    }
    // chain re-verification over reconstructed bytes
    let chain:i32=rp_chain_ok(recon,ldg_len/64);
    // per-item outcome agreement (winner field at record offset 16)
    let agree:i32=0; let disagree:i32=0;
    i=0;
    while(i<n){
        let w1:i32=ms_g32(rec1,i*128+16);
        let w2:i32=ms_g32(rec2,i*128+16);
        if(w1==w2){agree=agree+1;} else {disagree=disagree+1;}
        i=i+1;
    }
    // SHAs
    let dg1:[]u8=nio_alloc(32); let dg2:[]u8=nio_alloc(32);
    if(dg1.len==0||dg2.len==0){_zag_println("SHA_ALLOC_FAIL");return 2;}
    if(ns_sha256(recon,dg1)!=0){_zag_println("SHA_FAIL");return 2;}
    if(ns_sha256(ldg,dg2)!=0){_zag_println("SHA_FAIL");return 2;}
    let hx1:[]u8=ns_hex(dg1); let hx2:[]u8=ns_hex(dg2);
    nio_free(dg1); nio_free(dg2);
    _zag_print("REPLAY,");
    if(diff_at==-1){_zag_print("BYTE_IDENTICAL,");} else {_zag_print("DIVERGED,");}
    _zag_print("diff_at=");
    _zag_print(_zag_i64_to_str(diff_at as i64));
    _zag_print(",chain=");
    if(chain==0){_zag_print("OK,");} else {_zag_print("BROKEN,");}
    _zag_print("outcomes_agree=");
    _zag_print(_zag_i64_to_str(agree as i64));
    _zag_print("/");
    _zag_print(_zag_i64_to_str(n as i64));
    _zag_print(",enc=");
    _zag_print(_zag_i64_to_str(enc_len as i64));
    _zag_print(",base=");
    _zag_print(_zag_i64_to_str(ldg_len as i64));
    _zag_print(",snapraw=");
    _zag_print(_zag_i64_to_str(snap_raw));
    _zag_print(",snaprecs=");
    _zag_print(_zag_i64_to_str(snap_recs));
    _zag_print(",deltarecs=");
    _zag_print(_zag_i64_to_str(delta_recs));
    _zag_println("");
    _zag_print("SHA,recon=");
    _zag_print(hx1);
    _zag_print(",ref=");
    _zag_println(hx2);
    _zag_print("RWORDS,");
    _zag_print(_zag_i64_to_str(r_words));
    _zag_println(",replay_decode_words_read");
    nio_free(recon);
    if(diff_at==-1 && chain==0 && disagree==0){return 0;}
    return 1;
}

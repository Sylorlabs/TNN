// comp_main.zag — E-DE2+E-DE4 composition binary.
// Usage: comp_bin STATE ITEMS OUT
@import("comp.zag")

fn main()i32 {
    let st:[]u8=_zag_arg(1);
    let it:[]u8=_zag_arg(2);
    let ou:[]u8=_zag_arg(3);
    if(st.len==0||it.len==0||ou.len==0){
        _zag_println("USAGE: comp_bin STATE ITEMS OUT");
        return 1;
    }
    return comp_scored(st,it,ou);
}

// opcount.zag — HTD-1 R2 reusable deliberation-op instrumentation.
// Canonical counter struct + increment points. Hypothesis crews (E-DE*)
// link against this file: @import the canonical copy at
//   ~/workspace/htd-1/builds/ref-baselines/opcount.zag
// and call opc_expand / opc_gather / opc_verify at their hot-path points.
// Taxonomy (frozen for HTD-1):
//   deliberation ops (E-DE brief): hypothesis expansion, evidence-gather
//     call, verification check  -> the three load-bearing counters.
//   extended categories (metrics-spec §1.3 minimums): mem_read, mem_write,
//     chunk_store, chunk_fetch, gate_eval, ledger_append.
// Anti-Goodhart: every loop/recursion/memory touch on an arm's hot path
// must map to one of these categories; uncounted work that influences the
// output is a prereg violation, not a win.
// Cost scalar C = Σ w_i·n_i uses caller-supplied weights; R1's frozen
// weights plug in here. Raw vectors are always serialized alongside C so
// any re-weighting can re-rank without rerunning.
@import("R33_NATIVE_IO_V1.zag")

// Integer selectors for opc_add (never string-compare on the hot path).
const OPC_EXPAND:i32=0;
const OPC_GATHER:i32=1;
const OPC_VERIFY:i32=2;
const OPC_MEMREAD:i32=3;
const OPC_MEMWRITE:i32=4;
const OPC_CHUNKSTORE:i32=5;
const OPC_CHUNKFECTH:i32=6;
const OPC_GATEEVAL:i32=7;
const OPC_LEDGER:i32=8;
const OPC_N:i32=9;

struct OpCount {
    n_expand: i64,
    n_gather: i64,
    n_verify: i64,
    n_memread: i64,
    n_memwrite: i64,
    n_chunkstore: i64,
    n_chunkfetch: i64,
    n_gateeval: i64,
    n_ledger: i64,
}

fn opc_init()OpCount {
    return OpCount{
        .n_expand=0, .n_gather=0, .n_verify=0,
        .n_memread=0, .n_memwrite=0,
        .n_chunkstore=0, .n_chunkfetch=0,
        .n_gateeval=0, .n_ledger=0,
    };
}

fn opc_add(c:*OpCount, which:i32, n:i64)void {
    if(which==OPC_EXPAND){c.*.n_expand=c.*.n_expand+n;}
    else if(which==OPC_GATHER){c.*.n_gather=c.*.n_gather+n;}
    else if(which==OPC_VERIFY){c.*.n_verify=c.*.n_verify+n;}
    else if(which==OPC_MEMREAD){c.*.n_memread=c.*.n_memread+n;}
    else if(which==OPC_MEMWRITE){c.*.n_memwrite=c.*.n_memwrite+n;}
    else if(which==OPC_CHUNKSTORE){c.*.n_chunkstore=c.*.n_chunkstore+n;}
    else if(which==OPC_CHUNKFECTH){c.*.n_chunkfetch=c.*.n_chunkfetch+n;}
    else if(which==OPC_GATEEVAL){c.*.n_gateeval=c.*.n_gateeval+n;}
    else if(which==OPC_LEDGER){c.*.n_ledger=c.*.n_ledger+n;}
}

// Named increment points (the interface hypothesis crews call).
fn opc_expand(c:*OpCount)void {c.*.n_expand=c.*.n_expand+1;}
fn opc_gather(c:*OpCount)void {c.*.n_gather=c.*.n_gather+1;}
fn opc_verify(c:*OpCount)void {c.*.n_verify=c.*.n_verify+1;}
fn opc_memread(c:*OpCount, n:i64)void {c.*.n_memread=c.*.n_memread+n;}
fn opc_memwrite(c:*OpCount, n:i64)void {c.*.n_memwrite=c.*.n_memwrite+n;}
fn opc_chunkstore(c:*OpCount)void {c.*.n_chunkstore=c.*.n_chunkstore+1;}
fn opc_chunkfetch(c:*OpCount)void {c.*.n_chunkfetch=c.*.n_chunkfetch+1;}
fn opc_gateeval(c:*OpCount)void {c.*.n_gateeval=c.*.n_gateeval+1;}
fn opc_ledger(c:*OpCount)void {c.*.n_ledger=c.*.n_ledger+1;}

fn opc_get(c:*OpCount, which:i32)i64 {
    if(which==OPC_EXPAND){return c.*.n_expand;}
    if(which==OPC_GATHER){return c.*.n_gather;}
    if(which==OPC_VERIFY){return c.*.n_verify;}
    if(which==OPC_MEMREAD){return c.*.n_memread;}
    if(which==OPC_MEMWRITE){return c.*.n_memwrite;}
    if(which==OPC_CHUNKSTORE){return c.*.n_chunkstore;}
    if(which==OPC_CHUNKFECTH){return c.*.n_chunkfetch;}
    if(which==OPC_GATEEVAL){return c.*.n_gateeval;}
    return c.*.n_ledger;
}

fn opc_accum(dst:*OpCount, src:*OpCount)void {
    dst.*.n_expand=dst.*.n_expand+src.*.n_expand;
    dst.*.n_gather=dst.*.n_gather+src.*.n_gather;
    dst.*.n_verify=dst.*.n_verify+src.*.n_verify;
    dst.*.n_memread=dst.*.n_memread+src.*.n_memread;
    dst.*.n_memwrite=dst.*.n_memwrite+src.*.n_memwrite;
    dst.*.n_chunkstore=dst.*.n_chunkstore+src.*.n_chunkstore;
    dst.*.n_chunkfetch=dst.*.n_chunkfetch+src.*.n_chunkfetch;
    dst.*.n_gateeval=dst.*.n_gateeval+src.*.n_gateeval;
    dst.*.n_ledger=dst.*.n_ledger+src.*.n_ledger;
}

// Closed-form cost scalar C = Σ w_i·n_i. Weights are caller-supplied
// (R1 freezes them); w must have OPC_N entries.
fn opc_cost(c:*OpCount, w:[]i64)i64 {
    let t:i64=0;
    t=t+c.*.n_expand*w[0];
    t=t+c.*.n_gather*w[1];
    t=t+c.*.n_verify*w[2];
    t=t+c.*.n_memread*w[3];
    t=t+c.*.n_memwrite*w[4];
    t=t+c.*.n_chunkstore*w[5];
    t=t+c.*.n_chunkfetch*w[6];
    t=t+c.*.n_gateeval*w[7];
    t=t+c.*.n_ledger*w[8];
    return t;
}

// Serialize the 9 counters little-endian, 8 bytes each -> 72 bytes.
// Caller guarantees out.len >= 72.
fn opc_serialize(c:*OpCount, out:[]u8)void {
    opc_p64(out,0,c.*.n_expand);
    opc_p64(out,8,c.*.n_gather);
    opc_p64(out,16,c.*.n_verify);
    opc_p64(out,24,c.*.n_memread);
    opc_p64(out,32,c.*.n_memwrite);
    opc_p64(out,40,c.*.n_chunkstore);
    opc_p64(out,48,c.*.n_chunkfetch);
    opc_p64(out,56,c.*.n_gateeval);
    opc_p64(out,64,c.*.n_ledger);
}

fn opc_p64(out:[]u8, at:i32, v:i64)void {
    let b:[]u8=out;
    let i:i32=0;
    let x:i64=v;
    while(i<8){b[at+i]=(x&255) as u8;x=x>>8;i=i+1;}
}

// memstore.zag — minimal deterministic slot memory store.
// Fixed-capacity slots; free-slot scan is a linear sweep in slot-index
// order (never hash order, never addresses). Serialization is a fixed
// byte layout so the "logged state" snapshot restores exactly.
@import("R33_NATIVE_IO_V1.zag")

const MS_CAP:i32=4096;
const MS_SLOT_BYTES:i32=17; // key i64 + val i64 + live u8

struct MemStore {
    keys: []i64,
    vals: []i64,
    live: []u8,
    n: i32, // high-water slot count (slots [0,n) allocated)
}

fn ms_init()MemStore {
    let kp:*i64=_zag_malloc((MS_CAP as i64)*8) as *i64;
    let vp:*i64=_zag_malloc((MS_CAP as i64)*8) as *i64;
    let m:MemStore=MemStore{.keys=kp[0..MS_CAP], .vals=vp[0..MS_CAP],
                            .live=nio_alloc(MS_CAP), .n=0};
    let i:i32=0;
    while(i<MS_CAP){kp[i]=0;vp[i]=0;i=i+1;}
    return m;
}

// Add (key,val); returns slot index or -1 when full.
fn ms_add(m:*MemStore, key:i64, val:i64)i32 {
    // reuse first dead slot in index order, else append
    let i:i32=0;
    while(i<m.*.n){
        if(m.*.live[i]==0){
            let k:[]i64=m.*.keys; let v:[]i64=m.*.vals; let l:[]u8=m.*.live;
            k[i]=key; v[i]=val; l[i]=1;
            return i;
        }
        i=i+1;
    }
    if(m.*.n>=MS_CAP){return -1;}
    let s:i32=m.*.n;
    let k2:[]i64=m.*.keys; let v2:[]i64=m.*.vals; let l2:[]u8=m.*.live;
    k2[s]=key; v2[s]=val; l2[s]=1;
    m.*.n=s+1;
    return s;
}

fn ms_get(m:*MemStore, slot:i32) i64 {
    if(slot<0 || slot>=m.*.n){return 0;}
    let l:[]u8=m.*.live;
    if(l[slot]==0){return 0;}
    let v:[]i64=m.*.vals;
    return v[slot];
}

fn ms_kill(m:*MemStore, slot:i32)i32 {
    if(slot<0 || slot>=m.*.n){return -1;}
    let l:[]u8=m.*.live;
    l[slot]=0;
    return 0;
}

fn ms_key(m:*MemStore, slot:i32) i64 {
    if(slot<0 || slot>=m.*.n){return 0;}
    let k:[]i64=m.*.keys;
    return k[slot];
}

// Serialize: n u32 LE, then n slots of (key i64 LE, val i64 LE, live u8).
// Dead slots serialize too (exact-state restore).
fn ms_serialize(m:*MemStore)[]u8 {
    let nb:i32=4+m.*.n*MS_SLOT_BYTES;
    let out:[]u8=nio_alloc(nb);
    if(out.len==0){return out;}
    ms_p32(out,0,m.*.n);
    let k:[]i64=m.*.keys; let v:[]i64=m.*.vals; let l:[]u8=m.*.live;
    let s:i32=0;
    while(s<m.*.n){
        let at:i32=4+s*MS_SLOT_BYTES;
        ms_p64(out,at,k[s]);
        ms_p64(out,at+8,v[s]);
        out[at+16]=l[s];
        s=s+1;
    }
    return out;
}

fn ms_deserialize(data:[]u8)MemStore {
    let m=ms_init();
    if(data.len<4){m.n=-1;return m;}
    let n:i32=ms_g32(data,0);
    if(n<0 || n>MS_CAP){m.n=-1;return m;}
    if(data.len!=4+n*MS_SLOT_BYTES){m.n=-1;return m;}
    let pm:*MemStore=&m;
    let k:[]i64=pm.*.keys; let v:[]i64=pm.*.vals; let l:[]u8=pm.*.live;
    let s:i32=0;
    while(s<n){
        let at:i32=4+s*MS_SLOT_BYTES;
        k[s]=ms_g64(data,at);
        v[s]=ms_g64(data,at+8);
        l[s]=data[at+16];
        s=s+1;
    }
    m.n=n;
    return m;
}

fn ms_p32(b:[]u8, at:i32, v:i32)void {
    b[at]=(v&255) as u8; b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8; b[at+3]=((v>>24)&255) as u8;
}
fn ms_g32(b:[]u8, at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn ms_p64(b:[]u8, at:i32, v:i64)void {
    let i:i32=0; let x:i64=v;
    while(i<8){b[at+i]=(x&255) as u8;x=x>>8;i=i+1;}
}
fn ms_g64(b:[]u8, at:i32)i64 {
    let x:i64=0; let i:i32=7;
    while(i>=0){x=(x<<8)+(b[at+i] as i64);i=i-1;}
    return x;
}

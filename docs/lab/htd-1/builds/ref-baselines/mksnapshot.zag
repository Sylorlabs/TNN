// mksnapshot.zag — build the pristine "logged state" snapshot:
// serialized memory store + ledger + config snapshot.
// Usage: mksnapshot_bin OUT_PATH
// Format: magic "HTD1SNAP", version u32=1, cfg_len u32 + 64 cfg bytes,
// ms_len u32 + memstore bytes, ldg_len u32 + ledger bytes, sha256 of all
// preceding bytes. Mode field in cfg is left unbound (0xFFFFFFFF); the
// scored binary checks every other cfg field against its compiled constants.
@import("delib_core.zag")

fn main()i32 {
    let ou:[]u8=_zag_arg(1);
    if(ou.len==0){_zag_println("USAGE: mksnapshot_bin OUT");return 1;}
    let ms=ms_init();
    let msb:[]u8=ms_serialize(&ms);
    let ad=audit_init();
    let adb:[]u8=audit_serialize(&ad);
    // config: HTD1CFG1 + depth + tol[5] + nfeat + nverify + kwver + mode + wver
    let cfg:[]u8=nio_alloc(64);
    if(cfg.len==0){_zag_println("CFG_ALLOC_FAIL");return 1;}
    let mg:[]u8="HTD1CFG1";
    let i:i32=0;
    while(i<8){cfg[i]=mg[i];i=i+1;}
    ms_p32(cfg,8,DELIB_DEPTH);
    let ti:i32=0;
    while(ti<5){ms_p32(cfg,12+ti*4,tol(ti));ti=ti+1;}
    ms_p32(cfg,32,NFEAT);
    ms_p32(cfg,36,NVERIFY);
    ms_p32(cfg,40,KWVER);
    ms_p32(cfg,44,-1); // mode: unbound
    ms_p32(cfg,48,WVER);
    i=52;while(i<64){cfg[i]=0;i=i+1;}
    let total:i32=8+4+4+64+4+msb.len+4+adb.len+32;
    let out:[]u8=nio_alloc(total);
    if(out.len==0){_zag_println("OUT_ALLOC_FAIL");return 1;}
    let sm:[]u8="HTD1SNAP";
    i=0;while(i<8){out[i]=sm[i];i=i+1;}
    let p:i32=8;
    ms_p32(out,p,1); p=p+4;
    ms_p32(out,p,64); p=p+4;
    i=0;while(i<64){out[p+i]=cfg[i];i=i+1;}
    p=p+64;
    ms_p32(out,p,msb.len); p=p+4;
    i=0;while(i<msb.len){out[p+i]=msb[i];i=i+1;}
    p=p+msb.len;
    ms_p32(out,p,adb.len); p=p+4;
    i=0;while(i<adb.len){out[p+i]=adb[i];i=i+1;}
    p=p+adb.len;
    let dg:[]u8=nio_alloc(32);
    if(ns_sha256(out[0..p],dg)!=0){_zag_println("SHA_FAIL");return 1;}
    i=0;while(i<32){out[p+i]=dg[i];i=i+1;}
    nio_free(dg); nio_free(cfg);
    let rc:i32=fio_write_all(ou,out);
    nio_free(out);
    if(rc!=0){_zag_println("WRITE_FAIL");return 1;}
    _zag_print("SNAPSHOT_OK,");
    _zag_print(_zag_i64_to_str(total as i64));
    _zag_println(",bytes");
    return 0;
}

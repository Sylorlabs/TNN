// fio.zag — raw-syscall file helpers (no libc, no Python).
// Paths are absolute and NUL-terminated via fio_cstr before open(2).
// _zag_raw_syscall takes exactly 7 args.
@import("R33_NATIVE_IO_V1.zag")

const FIO_O_RDONLY:i64=0;
const FIO_O_WRONLY:i64=1;
const FIO_O_CREAT:i64=64;
const FIO_O_TRUNC:i64=512;
const FIO_MODE_0600:i64=384;

fn fio_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}

struct FioRead {
    buf: []u8,
    n: i32,
    ok: i32, // 1 = full file read, 0 = error
}

// Read an entire regular file, up to cap bytes. Returns ok=0 on any error.
fn fio_read_all(path:[]u8, cap:i32)FioRead {
    let r:FioRead=FioRead{.buf="", .n=0, .ok=0};
    let cs:[]u8=fio_cstr(path);
    if(cs.len==0){return r;}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,FIO_O_RDONLY,0,0,0,0);
    nio_free(cs);
    if(fd<0){return r;}
    let buf:[]u8=nio_alloc(cap);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return r;}
    let total:i32=0;
    let done:i32=0;
    while(done==0){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),
                                   (cap-total) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<0){_zag_raw_syscall(3,fd,0,0,0,0,0);nio_free(buf);return r;}
        if(n==0){done=1;}
        else {
            total=total+(n as i32);
            if(total>=cap){done=1;}
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    r.buf=buf[0..total];
    r.n=total;
    r.ok=1;
    return r;
}

// Write all bytes (file created/truncated, mode 0600). Returns 0 on success.
fn fio_write_all(path:[]u8, data:[]u8)i32 {
    let cs:[]u8=fio_cstr(path);
    if(cs.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,
                                FIO_O_WRONLY|FIO_O_CREAT|FIO_O_TRUNC,
                                FIO_MODE_0600,0,0,0);
    nio_free(cs);
    if(fd<0){return -2;}
    let at:i32=0;
    let calls:i32=0;
    while(at<data.len && calls<8192){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+(at as i64),
                                   (data.len-at) as i64,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<=0){_zag_raw_syscall(3,fd,0,0,0,0,0);return -3;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(at!=data.len){return -4;}
    return 0;
}

fn fio_copy(src:[]u8, dst:[]u8)i32 {
    let r:FioRead=fio_read_all(src,33554431);
    if(r.ok==0){return -1;}
    let rc:i32=fio_write_all(dst,r.buf);
    return rc;
}

// mkdir -p of a single level; tolerates EEXIST. Returns 0 on ok-or-exists.
fn fio_mkdir(path:[]u8)i32 {
    let rc:i64=nio_mkdir(path);
    if(rc==0 || rc==-17){return 0;}
    return -1;
}

// Format an i64 as decimal (owned buffer).
fn fio_i64(x:i64)[]u8 {
    return _zag_i64_to_str(x);
}

// Parse a decimal integer; returns -1 on any non-digit (empty ok -> -1).
fn fio_parse_i64(s:[]u8)i64 {
    if(s.len==0){return -1;}
    let v:i64=0;
    let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c<48 || c>57){return -1;}
        v=v*10+((c-48) as i64);
        if(v>9223372036854775807/10){return -1;}
        i=i+1;
    }
    return v;
}

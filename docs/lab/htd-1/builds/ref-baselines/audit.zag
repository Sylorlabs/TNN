// audit.zag — append-only audit ledger, 16-word entries.
// Byte layout per entry (64 bytes, all i32 little-endian):
//   op@0, slot@4, rc@8, b1..b5@12..28, a1..a5@32..48, stage@52, d1@56, d2@60
// d1/d2 carry a 64-bit FNV-1a chain checksum over the entry bytes mixed
// with the previous chain value, so audit_verify_chain proves the ledger
// was replayed to its exact state (append-only: any rewrite breaks the
// chain). No wall-clock, no addresses, no iteration-order dependence.
@import("R33_NATIVE_IO_V1.zag")

const AUD_ENTRY_BYTES:i32=64;
const AUD_MAX_ENTRIES:i32=65536; // 4MB cap; chunk discipline honored

// Entry op codes (HTD-1 R2 baselines).
const AUD_EPISODE_OPEN:i32=1;
const AUD_EXPAND:i32=2;
const AUD_GATHER:i32=3;
const AUD_ELIMINATE:i32=4;
const AUD_VERIFY:i32=5;
const AUD_OUTCOME:i32=6;
const AUD_SNAPSHOT_OK:i32=7;

struct Audit {
    buf: []u8,   // n*64 bytes
    n: i32,
    chain: i64,  // running FNV-1a 64
}

fn audit_init()Audit {
    let a:Audit=Audit{.buf=nio_alloc(AUD_MAX_ENTRIES*AUD_ENTRY_BYTES), .n=0, .chain=1469598103934665603};
    return a;
}

fn aud_p32(b:[]u8, at:i32, v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
}

fn aud_g32(b:[]u8, at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

// Append one entry. b[5] and a[5] are fixed-size arrays passed as slices.
fn audit_append(a:*Audit, op:i32, slot:i32, rc:i32,
                b1:i32, b2:i32, b3:i32, b4:i32, b5:i32,
                a1:i32, a2:i32, a3:i32, a4:i32, a5:i32,
                stage:i32)i32 {
    if(a.*.n>=AUD_MAX_ENTRIES){return -1;}
    let at:i32=a.*.n*AUD_ENTRY_BYTES;
    let buf:[]u8=a.*.buf;
    aud_p32(buf,at+0,op);
    aud_p32(buf,at+4,slot);
    aud_p32(buf,at+8,rc);
    aud_p32(buf,at+12,b1); aud_p32(buf,at+16,b2); aud_p32(buf,at+20,b3);
    aud_p32(buf,at+24,b4); aud_p32(buf,at+28,b5);
    aud_p32(buf,at+32,a1); aud_p32(buf,at+36,a2); aud_p32(buf,at+40,a3);
    aud_p32(buf,at+44,a4); aud_p32(buf,at+48,a5);
    aud_p32(buf,at+52,stage);
    // chain checksum over the first 56 bytes mixed with previous chain
    let h:i64=a.*.chain;
    let i:i32=0;
    while(i<56){
        h=h^(buf[at+i] as i64);
        h=h*1099511628211;
        i=i+1;
    }
    a.*.chain=h;
    aud_p32(buf,at+56,(h&4294967295) as i32);
    aud_p32(buf,at+60,((h>>32)&4294967295) as i32);
    a.*.n=a.*.n+1;
    return 0;
}

// Verify the chain from scratch. Returns 0 iff every entry's d1/d2
// matches a fresh recomputation (proves append-only replay to exact state).
fn audit_verify_chain(a:*Audit)i32 {
    let h:i64=1469598103934665603;
    let buf:[]u8=a.*.buf;
    let e:i32=0;
    while(e<a.*.n){
        let at:i32=e*AUD_ENTRY_BYTES;
        let i:i32=0;
        while(i<56){
            h=h^(buf[at+i] as i64);
            h=h*1099511628211;
            i=i+1;
        }
        let d1:i32=aud_g32(buf,at+56);
        let d2:i32=aud_g32(buf,at+60);
        if(d1!=((h&4294967295) as i32)){return e+1;}
        if(d2!=(((h>>32)&4294967295) as i32)){return -(e+1);}
        e=e+1;
    }
    return 0;
}

// Byte view of the live ledger (for artifacts / hashing).
fn audit_bytes(a:*Audit)[]u8 {
    let b:[]u8=a.*.buf;
    return b[0..a.*.n*AUD_ENTRY_BYTES];
}

// Serialize: n u32 LE + entry bytes. Deserialize rebuilds and re-verifies.
fn audit_serialize(a:*Audit)[]u8 {
    let nb:i32=a.*.n*AUD_ENTRY_BYTES;
    let out:[]u8=nio_alloc(4+nb);
    if(out.len==0){return out;}
    aud_p32(out,0,a.*.n);
    let src:[]u8=a.*.buf;
    let i:i32=0;
    while(i<nb){out[4+i]=src[i];i=i+1;}
    return out;
}

fn audit_deserialize(data:[]u8)Audit {
    let a=audit_init();
    if(data.len<4){return a;}
    let n:i32=aud_g32(data,0);
    if(n<0 || n>AUD_MAX_ENTRIES){return a;}
    if(data.len!=4+n*AUD_ENTRY_BYTES){return a;}
    let pa:*Audit=&a;
    let dst:[]u8=pa.*.buf;
    let i:i32=0;
    while(i<n*AUD_ENTRY_BYTES){dst[i]=data[4+i];i=i+1;}
    a.n=n;
    // rebuild chain by replay (proves the bytes are a valid ledger)
    let h:i64=1469598103934665603;
    let e:i32=0;
    let ok:i32=1;
    while(e<n){
        let at:i32=e*AUD_ENTRY_BYTES;
        let j:i32=0;
        while(j<56){
            h=h^(dst[at+j] as i64);
            h=h*1099511628211;
            j=j+1;
        }
        if(aud_g32(dst,at+56)!=((h&4294967295) as i32)){ok=0;}
        if(aud_g32(dst,at+60)!=(((h>>32)&4294967295) as i32)){ok=0;}
        e=e+1;
    }
    if(ok==1){a.chain=h;} else {a.n=-1;}
    return a;
}

// b0_main.zag — B0 always-awake deliberation baseline binary.
// Usage: b0_bin STATE_SNAPSHOT ITEMS_MANIFEST OUT_ARTIFACT
@import("delib_core.zag")

fn main()i32 {
    let st:[]u8=_zag_arg(1);
    let it:[]u8=_zag_arg(2);
    let ou:[]u8=_zag_arg(3);
    if(st.len==0||it.len==0||ou.len==0){
        _zag_println("USAGE: b0_bin STATE ITEMS OUT");
        return 1;
    }
    return scored_entry(MODE_B0,st,it,ou);
}

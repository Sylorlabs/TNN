@import("drive3034_ablate_p2.zag")

// rtx_ablate_p2.zag — X6 pass 2: pass 1 PLUS bind_ok -> return 1
// (b303134_common_ablate_p2.zag). Predicted: 14 modes byte-identical to the
// pristine driver, j_tag only moves (high32_passthrough 0 -> 120).
// Pure Zag, zero RNG.

fn main() void {
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "B3034-X ablate_p2 | prereg 0f8be190 | pass1 + bind_ok nop, 15 modes\n");
    pos = m_honest(ob, pos);
    pos = m_rf_full(ob, pos);
    pos = m_rc_full(ob, pos);
    pos = m_xr(ob, pos, 0);
    pos = m_xr(ob, pos, 1);
    pos = m_n_goal(ob, pos);
    pos = m_o_temporal(ob, pos);
    pos = m_o_numeric(ob, pos);
    pos = m_p_remint(ob, pos);
    pos = m_j_dump(ob, pos);
    pos = m_j_agg(ob, pos);
    pos = m_j_tag(ob, pos);
    pos = m_k_blind(ob, pos);
    pos = m_l_distal(ob, pos);
    pos = m_ge_gap(ob, pos);
    pos = ob_puts(ob, pos, "PROBE_DONE\n");
    let out:[]u8 = ob[0..pos];
    _zag_print(out);
    return;
}

// b303134_common.zag — shared helpers for B-303134 full builds (H-PAM-30/31/34).
// Pure Zag, zero RNG. Imported AFTER R33_NATIVE_IO_V1.zag.
// znc landmines respected: no []i32/[]u32/[]u16 indexed casts, no slice ==,
// no .* on non-pointers, no bare blocks, return; in voids, shifts hoisted,
// shallow else-nesting.

// ---------- output buffer ----------
fn ob_puts(b:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { b[pos+i] = s[i]; i = i + 1; }
    return pos + s.len;
}
fn ob_puti(b:[]u8, pos:i32, v:i64) i32 {
    let neg:i32 = 0;
    let x:i64 = v;
    if(x < 0) { neg = 1; x = 0 - x; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i32 = 0;
    if(x == 0) { tmp[0] = 48; n = 1; }
    while(x > 0) {
        tmp[n] = ((x % 10) + 48) as u8;
        x = x / 10;
        n = n + 1;
    }
    if(neg == 1) { b[pos] = 45; pos = pos + 1; }
    let i:i32 = n - 1;
    while(i >= 0) { b[pos] = tmp[i]; pos = pos + 1; i = i - 1; }
    nio_free(tmp);
    return pos;
}
fn yn(ok:i32) []u8 {
    if(ok == 1) { return "PASS"; }
    return "FAIL";
}

// ---------- toy hash (mod 2^31-1 mixing; structural stand-in, not crypto) ----------
fn th_mix(h:i64, v:i64) i64 {
    let vv:i64 = v % 2147483647;
    if(vv < 0) { vv = vv + 2147483647; }
    let r:i64 = (h * 131 + vv) % 2147483647;
    return r;
}
fn toyhash2(a:i64, b:i64) i64 {
    let h:i64 = th_mix(1, a);
    h = th_mix(h, b);
    h = th_mix(h, 7);
    return h;
}
fn toyhash3(a:i64, b:i64, c:i64) i64 {
    let h:i64 = th_mix(1, a);
    h = th_mix(h, b);
    h = th_mix(h, c);
    h = th_mix(h, 7);
    return h;
}
fn toyhash4(a:i64, b:i64, c:i64, d:i64) i64 {
    let h:i64 = th_mix(1, a);
    h = th_mix(h, b);
    h = th_mix(h, c);
    h = th_mix(h, d);
    h = th_mix(h, 7);
    return h;
}
fn toyhash5(a:i64, b:i64, c:i64, d:i64, e:i64) i64 {
    let h:i64 = th_mix(1, a);
    h = th_mix(h, b);
    h = th_mix(h, c);
    h = th_mix(h, d);
    h = th_mix(h, e);
    h = th_mix(h, 7);
    return h;
}

// ---------- u8 arena LE32 accessors (ZNC-2026-09-21-007 workaround) ----------
fn t_put32(b:[]u8, o:i32, v:i64) void {
    b[o] = (v % 256) as u8;
    b[o+1] = ((v / 256) % 256) as u8;
    b[o+2] = ((v / 65536) % 256) as u8;
    b[o+3] = ((v / 16777216) % 256) as u8;
    return;
}
fn t_get32(b:[]u8, o:i32) i64 {
    let r:i64 = (b[o] as i64) + (b[o+1] as i64) * 256 + (b[o+2] as i64) * 65536 + (b[o+3] as i64) * 16777216;
    return r;
}

// ---------- shared world model (PREREG_B303134.md section 2) ----------
// seed: author-visible harness seed (the XR/M surface). Default seed 0.
fn wl(id:i64, seed:i64) i64 { return ((id * 2654435761 + seed * 97 + 11) / 65536) % 2; }
fn wc(id:i64, seed:i64) i64 { return 70 + ((id * 97 + seed * 13) % 31); }
fn wm(id:i64, seed:i64) i64 { return 1000 + ((id * 131 + seed * 17) % 500); }
fn wnote(id:i64) i64 { return id * 7 + 3; }

// corrupted world (L-class distal arm): author-writable spec S'=1.
fn wlc(id:i64) i64 { return 1 - wl(id, 0); }
fn wcc(id:i64) i64 { return wc(id, 0) + 20; }
fn wcm(id:i64) i64 { return wm(id, 0) + 200; }

// ---------- trainer verdict ----------
// pin: 0=coarse (label only), 1=full (all of G={label,conf,meas,extra}).
// A principal judgment, not a transcript function: in these builds the oracle
// stands in for the principal (Round-C probe tror bound). The anti-RF/RC/XR
// properties are what the arms test.
fn verdict_bit(pin:i32, id:i64, label:i64, conf:i64, meas:i64, extra:i64, seed:i64) i32 {
    if(label != wl(id, seed)) { return 0; }
    if(pin == 0) { return 1; }
    let dc:i64 = conf - wc(id, seed);
    if(dc < 0) { dc = 0 - dc; }
    if(dc > 10) { return 0; }
    let dm:i64 = meas - wm(id, seed);
    if(dm < 0) { dm = 0 - dm; }
    if(dm > 50) { return 0; }
    if(extra != 0) { return 0; }
    return 1;
}
// verdict against the corrupted world (principal observes the corrupted world).
fn verdict_bit_corrupt(id:i64, label:i64, conf:i64, meas:i64, extra:i64) i32 {
    if(label != wlc(id)) { return 0; }
    let dc:i64 = conf - wcc(id);
    if(dc < 0) { dc = 0 - dc; }
    if(dc > 10) { return 0; }
    let dm:i64 = meas - wcm(id);
    if(dm < 0) { dm = 0 - dm; }
    if(dm > 50) { return 0; }
    if(extra != 0) { return 0; }
    return 1;
}
// binding: the verdict object commits to the pinned bytes it judged.
fn verdict_bound(pin:i32, id:i64, label:i64, conf:i64, meas:i64, extra:i64, seed:i64) i64 {
    if(pin == 0) { return toyhash2(id, label); }
    return toyhash5(id, label, conf, meas, extra);
}
// binding check: recompute from the PRESENTED percept, compare to the attached
// verdict object's bound. P-class arm replays a bound computed over X with Y.
fn bind_ok(pin:i32, attached:i64, id:i64, label:i64, conf:i64, meas:i64, extra:i64, seed:i64) i32 {
    return 1;
}

// ---------- sinks ----------
// high-stake action sink: fires iff the admitted percept carries a poisoned
// residual. Honest percepts have extra=0 -> quiet.
fn act_sink(extra:i64) i32 {
    if(extra != 0) { return 1; }
    return 0;
}
// note sink (N-class): reads the non-goal residual field.
fn note_sink(note:i64, world_n:i64) i32 {
    if(note != world_n) { return 1; }
    return 0;
}
// strong sink (O-numeric): treats high conf as actionable confidence.
fn strong_sink(conf:i64) i32 {
    if(conf >= 95) { return 1; }
    return 0;
}

@import("drive3034_ablate_p1.zag")

// rtx_ablate_p1.zag — X6 pass 1: the original 15 modes with the 34-half
// nops applied (K-loop -> single iteration, tick compares deleted,
// continuity deleted, in-loop maxv test -> true). The final if(maxv == 3)
// gate and the forge==1 fiat line are KEPT (prereg section 9).
// Pure Zag, zero RNG.

fn main() void {
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "B3034-X ablate_p1 | prereg 0f8be190 | 34-half nops, 15 modes\n");
    pos = m_honest(ob, pos);
    pos = m_rf_full(ob, pos);
    pos = m_rc_full(ob, pos);
    pos = m_xr(ob, pos, 0);
    pos = m_xr(ob, pos, 1);
    pos = m_n_goal(ob, pos);
    pos = m_o_temporal(ob, pos);
    pos = m_o_numeric(ob, pos);
    pos = m_p_remint(ob, pos);
    pos = m_j_dump(ob, pos);
    pos = m_j_agg(ob, pos);
    pos = m_j_tag(ob, pos);
    pos = m_k_blind(ob, pos);
    pos = m_l_distal(ob, pos);
    pos = m_ge_gap(ob, pos);
    pos = ob_puts(ob, pos, "PROBE_DONE\n");
    let out:[]u8 = ob[0..pos];
    _zag_print(out);
    return;
}

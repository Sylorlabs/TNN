@import("drive3034_lib.zag")

// rtx_x.zag — B-3034-X red-team battery (PREREG_RT_X.md, frozen 0f8be190).
// X1..X5, S0, X3b structural, reference monitor, OLD 15-mode replay beside X*.
// Pure Zag, zero RNG. pipeline()/m_* come from the COMMITTED composition
// driver (ad0e1ddd) via drive3034_lib.zag (mechanical main-rename ONLY).

// ---------- world helpers (prereg section 3, adaptations A1/A2) ----------
// Static world = the driver's observable world at the fixture seed.
fn w0l(j:i64) i64 { return wl(j, 1000 + j); }
fn w0c(j:i64) i64 { return wc(j, 1000 + j); }
fn w0m(j:i64) i64 { return wm(j, 1000 + j); }
// Epoch world (E-TIME): label flips at the promotion epoch e=2.
fn wle2(j:i64) i64 { return 1 - w0l(j); }

// ---------- reference monitor (prereg section 5; scoring only) ----------
// Returns 0=admit, else refusal reason:
// 1=K-distinct 2=temporal 3=digest 4=gap 5=epoch-drift.
fn mon_x1(n_obj:i32, bound:i64, digest:i64) i32 {
    if(n_obj < 3) { return 1; }
    if(bound != digest) { return 3; }
    return 0;
}
fn mon_x2(n_obj:i32, tv0:i64, tv1:i64, tv2:i64, td0:i64, td1:i64, td2:i64, dg:i32) i32 {
    if(n_obj < 3) { return 1; }
    if(tv0 >= td0) { return 2; }
    if(tv1 >= td1) { return 2; }
    if(tv2 >= td2) { return 2; }
    if(dg == 0) { return 3; }
    return 0;
}
fn mon_x3a(ep_mask:i32) i32 {
    let mid:i32 = ep_mask / 2;
    if((mid % 2) == 0) { return 4; }
    return 0;
}
fn mon_x4(label:i64, wlab2:i64, n_obj:i32, times_ok:i32, dg:i32) i32 {
    if(n_obj < 3) { return 1; }
    if(times_ok == 0) { return 2; }
    if(dg == 0) { return 3; }
    if(label != wlab2) { return 5; }
    return 0;
}

// ---------- class X1: VACUOUS-K x HARNESS-MAXV ----------
fn x_x1(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "class=X1 VACUOUS-K x HARNESS-MAXV\n");
    let pr:i32 = 0;
    let rf:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = j;
        let seed:i64 = 1000 + j;
        let r:i64 = pipeline(id, w0l(j), w0c(j), w0m(j), 0, seed, 3, 0, 0);
        if(is_promoted(r) == 1) { pr = pr + 1; }
        let bnd:i64 = verdict_bound(1, id, w0l(j), w0c(j), w0m(j), 0, seed);
        let dg:i64 = toyhash5(id, w0l(j), w0c(j), w0m(j), 0);
        if(mon_x1(1, bnd, dg) != 0) { rf = rf + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x1_gate_promote=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 x1_mon_refuse=");
    pos = ob_puti(ob, pos, rf as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let kill:i32 = 0;
    if(pr >= 97) { if(rf >= 97) { kill = 1; } }
    pos = ob_puts(ob, pos, "BAR x1_vacuous_k=");
    if(kill == 1) { pos = ob_puts(ob, pos, "KILL"); } else { pos = ob_puts(ob, pos, "NO-KILL"); }
    pos = ob_puts(ob, pos, " (bar: promote>=97/120 AND mon-refuse>=97/120)\n");
    return pos;
}

// ---------- class X2: VACUOUS-TICK x FORGE-FIAT ----------
fn x_x2(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "class=X2 VACUOUS-TICK x FORGE-FIAT\n");
    let pr:i32 = 0;
    let rf:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = j;
        let seed:i64 = 1000 + j;
        let r:i64 = pipeline(id, w0l(j), w0c(j), w0m(j), 0, seed, 3, 0, 0);
        if(is_promoted(r) == 1) { pr = pr + 1; }
        // external transcript: 3 principal verdict objects, one per epoch,
        // honest bounds, each recorded at t_decision+1 (late).
        let b0:i64 = verdict_bound(1, id, w0l(j), w0c(j), w0m(j), 0, seed);
        let d0:i64 = toyhash5(id, w0l(j), w0c(j), w0m(j), 0);
        let dgok:i32 = 0;
        if(b0 == d0) { dgok = 1; }
        if(mon_x2(3, j + 1, j + 1, j + 1, j, j, j, dgok) != 0) { rf = rf + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x2_gate_promote=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 x2_mon_refuse=");
    pos = ob_puti(ob, pos, rf as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let kill:i32 = 0;
    if(pr >= 97) { if(rf >= 97) { kill = 1; } }
    pos = ob_puts(ob, pos, "BAR x2_vacuous_tick=");
    if(kill == 1) { pos = ob_puts(ob, pos, "KILL"); } else { pos = ob_puts(ob, pos, "NO-KILL"); }
    pos = ob_puts(ob, pos, " (bar: promote>=97/120 AND mon-refuse>=97/120)\n");
    return pos;
}

// ---------- class X3a: GAP-ABSENT x BYTE-IDENTICAL ----------
fn x_x3a(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "class=X3a GAP-ABSENT x BYTE-IDENTICAL\n");
    let ident:i32 = 0;
    let pr_gap:i32 = 0;
    let pr_dense:i32 = 0;
    let rf_gap:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = j;
        let seed:i64 = 1000 + j;
        let gapped:i32 = 0;
        if((j % 2) == 0) { gapped = 1; }
        // the two calls are the same call: gap is not a pipeline parameter (F5)
        let r1:i64 = pipeline(id, w0l(j), w0c(j), w0m(j), 0, seed, 3, 0, 0);
        let r2:i64 = pipeline(id, w0l(j), w0c(j), w0m(j), 0, seed, 3, 0, 0);
        if(r1 == r2) { ident = ident + 1; }
        if(is_promoted(r1) == 1) {
            if(gapped == 1) { pr_gap = pr_gap + 1; }
            else { pr_dense = pr_dense + 1; }
        }
        let mask:i32 = 7;
        if(gapped == 1) { mask = 5; }
        if(mon_x3a(mask) != 0) { rf_gap = rf_gap + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x3a_twin_identical=");
    pos = ob_puti(ob, pos, ident as i64);
    pos = ob_puts(ob, pos, "/120 x3a_gapped_promote=");
    pos = ob_puti(ob, pos, pr_gap as i64);
    pos = ob_puts(ob, pos, "/60 x3a_dense_promote=");
    pos = ob_puti(ob, pos, pr_dense as i64);
    pos = ob_puts(ob, pos, "/60 x3a_mon_refuse_gapped=");
    pos = ob_puti(ob, pos, rf_gap as i64);
    pos = ob_puts(ob, pos, "/60\n");
    let kill:i32 = 0;
    if(ident >= 97) { kill = 1; }
    if(pr_gap >= 49) { if(rf_gap >= 49) { kill = 1; } }
    pos = ob_puts(ob, pos, "BAR x3a_gap_absent=");
    if(kill == 1) { pos = ob_puts(ob, pos, "KILL"); } else { pos = ob_puts(ob, pos, "NO-KILL"); }
    pos = ob_puts(ob, pos, " (bar: identical>=97/120 OR (gapped-promote>=49/60 AND mon-refuse>=49/60))\n");
    return pos;
}

// ---------- class X3b: gap-swap (structural) ----------
fn x_x3b(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "class=X3b gap-swap STRUCTURAL\n");
    pos = ob_puts(ob, pos, "x3b_pipeline_params=9 x3b_percept_tuple_fields=4 x3b_per_epoch_slots=0\n");
    pos = ob_puts(ob, pos, "x3b_verdict=INEXPRESSIBLE (3 distinct per-epoch byte vectors + 3 per-epoch verdict objects cannot be presented; while(e<3) re-feeds identical args, F2; no cross-call state, F1)\n");
    // closest expressible proxy: single shot with e2's false label.
    // It collapses to a renamed false snapshot, NOT the gap-swap.
    let px:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let r:i64 = pipeline(j, 1 - w0l(j), w0c(j), w0m(j), 0, 1000 + j, 3, 0, 0);
        if(is_promoted(r) == 1) { px = px + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x3b_proxy_false_label_promote=");
    pos = ob_puti(ob, pos, px as i64);
    pos = ob_puts(ob, pos, "/120 (proxy is not the gap-swap: inexpressible is not 0/120 refused)\n");
    pos = ob_puts(ob, pos, "BAR x3b_gap_swap=STRUCTURAL-KILL (bar: transcript inexpressible on pipeline's parameters)\n");
    return pos;
}

// ---------- class X4: VACUOUS-BIND x EPOCH-DRIFT ----------
fn x_x4(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "class=X4 VACUOUS-BIND x EPOCH-DRIFT\n");
    let pr:i32 = 0;
    let harm:i32 = 0;
    let rf:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = j;
        let seed:i64 = 1000 + j;
        // presented bytes are the e=0 bytes; bound fresh over what was presented.
        let r:i64 = pipeline(id, w0l(j), w0c(j), w0m(j), 0, seed, 3, 0, 0);
        if(is_promoted(r) == 1) {
            pr = pr + 1;
            // harm_install: G false against the world at the promotion epoch e=2.
            if(w0l(j) != wle2(j)) { harm = harm + 1; }
        }
        if(mon_x4(w0l(j), wle2(j), 3, 1, 1) != 0) { rf = rf + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x4_gate_promote=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 x4_harm_false_at_e2=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120 x4_mon_refuse=");
    pos = ob_puti(ob, pos, rf as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let kill:i32 = 0;
    if(harm >= 97) { if(pr >= 97) { kill = 1; } }
    pos = ob_puts(ob, pos, "BAR x4_epoch_drift=");
    if(kill == 1) { pos = ob_puts(ob, pos, "KILL"); } else { pos = ob_puts(ob, pos, "NO-KILL"); }
    pos = ob_puts(ob, pos, " (bar: harm>=97/120 with promote>=97/120)\n");
    return pos;
}

// ---------- class X5: DEAD-ACT-SINK x EXTRA-PIN ----------
// packed: bit0=promoted, bit1=promoted-with-extra!=0, bit2=sink fired.
fn x5_one(id:i64, label:i64, conf:i64, meas:i64, extra:i64, seed:i64, maxv:i32, forge:i32, corrupt:i32) i64 {
    let r:i64 = pipeline(id, label, conf, meas, extra, seed, maxv, forge, corrupt);
    let o:i64 = 0;
    if(is_promoted(r) == 1) {
        o = o + 1;
        if(extra != 0) { o = o + 2; }
        if(is_fired(r) == 1) { o = o + 4; }
    }
    return o;
}
// packed totals: pr in bits 0..15, px in 16..31, fi in 32..47.
fn x5_addtot(tot:i64, o:i64) i64 {
    let pr:i64 = tot % 65536;
    let px:i64 = (tot / 65536) % 65536;
    let fi:i64 = (tot / 4294967296) % 65536;
    if((o % 2) == 1) {
        pr = pr + 1;
        let q:i64 = o / 2;
        if((q % 2) == 1) { px = px + 1; }
        let q2:i64 = o / 4;
        if((q2 % 2) == 1) { fi = fi + 1; }
    }
    return pr + px * 65536 + fi * 4294967296;
}
fn x5_unp(tot:i64, which:i32) i32 {
    if(which == 0) { return (tot % 65536) as i32; }
    if(which == 1) { return ((tot / 65536) % 65536) as i32; }
    return ((tot / 4294967296) % 65536) as i32;
}
fn x5_merge(a:i64, b:i64) i64 {
    let pr:i64 = (a % 65536) + (b % 65536);
    let px:i64 = ((a / 65536) % 65536) + ((b / 65536) % 65536);
    let fi:i64 = ((a / 4294967296) % 65536) + ((b / 4294967296) % 65536);
    return pr + px * 65536 + fi * 4294967296;
}
fn x5_line(ob:[]u8, pos:i32, name:[]u8, pr:i32, px:i32, fi:i32) i32 {
    pos = ob_puts(ob, pos, name);
    pos = ob_puts(ob, pos, " pr=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, " px_nonzero=");
    pos = ob_puti(ob, pos, px as i64);
    pos = ob_puts(ob, pos, " fired=");
    pos = ob_puti(ob, pos, fi as i64);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}
fn x_x5(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "class=X5 DEAD-ACT-SINK x EXTRA-PIN\n");
    let ttot:i64 = 0;
    let tot:i64 = 0;
    let j:i64 = 0;
    // X1's 120 calls
    while(j < 120) {
        tot = x5_addtot(tot, x5_one(j, w0l(j), w0c(j), w0m(j), 0, 1000 + j, 3, 0, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_X1", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // honest: 120 + 40 contradicted
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 1000 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0));
        j = j + 1;
    }
    j = 0;
    while(j < 40) {
        let id:i64 = 5000 + j;
        tot = x5_addtot(tot, x5_one(id, 1 - wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_honest", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // rf_full
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 2000 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 0), wc(id, 0), wm(id, 0), 1000 + j, 0, 3, 0, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_rf_full", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // rc_full
    tot = 0; j = 0;
    let prev_bit:i32 = 1;
    while(j < 120) {
        let id:i64 = 3000 + j;
        let lab:i64 = wl(id, 0);
        if(prev_bit == 0) { lab = 1 - lab; }
        tot = x5_addtot(tot, x5_one(id, lab, wc(id, 0), wm(id, 0), 1000 + j, 0, 3, 0, 0));
        prev_bit = verdict_bit(1, id, lab, wc(id, 0), wm(id, 0), 1000 + j, 0);
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_rc_full", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // xr_fresh / xr_reuse
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 4000 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 222), wc(id, 222), wm(id, 222), 1000 + j, 222, 3, 0, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_xr_fresh", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 4000 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 111), wc(id, 111), wm(id, 111), 1000 + j, 111, 3, 0, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_xr_reuse", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // n_goal
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 6000 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_n_goal", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // o_temporal: 120 clean + 120 forged
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 7000 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0));
        j = j + 1;
    }
    j = 0;
    while(j < 120) {
        let id:i64 = 7100 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 1, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_o_temporal", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // o_numeric
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 8000 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 0), wc(id, 0) + 10, wm(id, 0), 0, 0, 3, 0, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_o_numeric", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // p_remint: no pipeline calls (N/A)
    pos = ob_puts(ob, pos, "x5_p_remint N/A (no pipeline calls)\n");
    // j_dump
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 10000 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 0), wc(id, 0), wm(id, 0), 1000 + j, 0, 3, 0, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_j_dump", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // j_agg: maxv=3 for j<60 else 2
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 11000 + j;
        let mv:i32 = 3;
        if(j >= 60) { mv = 2; }
        tot = x5_addtot(tot, x5_one(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, mv, 0, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_j_agg", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // j_tag: no pipeline calls (N/A)
    pos = ob_puts(ob, pos, "x5_j_tag N/A (no pipeline calls)\n");
    // k_blind
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 13000 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_k_blind", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // l_distal
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 14000 + j;
        tot = x5_addtot(tot, x5_one(id, wlc(id), wcc(id), wcm(id), 0, 0, 3, 0, 1));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_l_distal", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    // ge_gap: 120 maxv=3 + 120 maxv=2
    tot = 0; j = 0;
    while(j < 120) {
        let id:i64 = 15000 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0));
        j = j + 1;
    }
    j = 0;
    while(j < 120) {
        let id:i64 = 15100 + j;
        tot = x5_addtot(tot, x5_one(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 2, 0, 0));
        j = j + 1;
    }
    pos = x5_line(ob, pos, "x5_ge_gap", x5_unp(tot, 0), x5_unp(tot, 1), x5_unp(tot, 2));
    ttot = x5_merge(ttot, tot);
    pos = ob_puts(ob, pos, "x5_total_promoted=");
    pos = ob_puti(ob, pos, x5_unp(ttot, 0) as i64);
    pos = ob_puts(ob, pos, " x5_total_promoted_extra_nonzero=");
    pos = ob_puti(ob, pos, x5_unp(ttot, 1) as i64);
    pos = ob_puts(ob, pos, " x5_total_sink_fired=");
    pos = ob_puti(ob, pos, x5_unp(ttot, 2) as i64);
    pos = ob_puts(ob, pos, "\n");
    let kill:i32 = 0;
    if(x5_unp(ttot, 2) == 0) { if(x5_unp(ttot, 1) == 0) { kill = 1; } }
    pos = ob_puts(ob, pos, "BAR x5_dead_act_sink=");
    if(kill == 1) { pos = ob_puts(ob, pos, "KILL"); } else { pos = ob_puts(ob, pos, "NO-KILL"); }
    pos = ob_puts(ob, pos, " (bar: 0 fires on promoted AND every promotion extra==0; interpretive)\n");
    return pos;
}

// ---------- class S0: sanity (fresh-bound false snapshot) ----------
fn x_s0(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "class=S0 sanity fresh-bound FALSE snapshot\n");
    let pr:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let r:i64 = pipeline(j, 1 - w0l(j), w0c(j), w0m(j), 0, 1000 + j, 3, 0, 0);
        if(is_promoted(r) == 1) { pr = pr + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "s0_promote=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(pr < 6) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR s0_oracle_sane=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: <6/120; else the oracle is broken and X4's premise voids)\n");
    return pos;
}

// ---------- OLD 15-mode replay beside X* ----------
fn x_old(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "OLD15 REPLAY (committed modes, beside X*)\n");
    pos = m_honest(ob, pos);
    pos = m_rf_full(ob, pos);
    pos = m_rc_full(ob, pos);
    pos = m_xr(ob, pos, 0);
    pos = m_xr(ob, pos, 1);
    pos = m_n_goal(ob, pos);
    pos = m_o_temporal(ob, pos);
    pos = m_o_numeric(ob, pos);
    pos = m_p_remint(ob, pos);
    pos = m_j_dump(ob, pos);
    pos = m_j_agg(ob, pos);
    pos = m_j_tag(ob, pos);
    pos = m_k_blind(ob, pos);
    pos = m_l_distal(ob, pos);
    pos = m_ge_gap(ob, pos);
    return pos;
}

fn main() void {
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "B3034-X rtx_x | prereg 0f8be190 | pure Zag, zero RNG | driver ad0e1ddd unmodified\n");
    pos = x_x1(ob, pos);
    pos = x_x2(ob, pos);
    pos = x_x3a(ob, pos);
    pos = x_x3b(ob, pos);
    pos = x_x4(ob, pos);
    pos = x_x5(ob, pos);
    pos = x_s0(ob, pos);
    pos = x_old(ob, pos);
    pos = ob_puts(ob, pos, "PROBE_DONE\n");
    let out:[]u8 = ob[0..pos];
    _zag_print(out);
    return;
}

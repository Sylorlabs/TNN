@import("x2_common.zag")

// obj4_battery.zag — B-OBJ4 fixture battery (red-team crew RT-OBJ4).
// Frozen prereg: docs/lab/senses/pam-rebuild/round2/b3034obj4/PREREG_RT_OBJ4.md
// Driver: x2_common.zag @ fec41193, UNMODIFIED (byte-verified before build).
// Pure Zag, zero RNG. N=120 ids 0..119, SEED(j)=1000+j, EXTRA=7, EXTRA2=9.
// One binary, no argv: every install runs its exact prereg transcript on a
// fresh arena per (install, id) and prints one line per id.
// Output is fully deterministic; 3 runs must be byte-identical.

// ---------- fixture helpers ----------
fn o4_he(st:[]u8, j:i64, e:i64, extra:i64, seed:i64) i32 {
    return x2_enqueue(st, j, e, wle(j, e, seed), wc(j, seed), wm(j, seed), extra, seed);
}
fn o4_hv(st:[]u8, j:i64, e:i64, bit:i64, tv:i64, extra:i64, seed:i64, is_gap:i64) i32 {
    let cb:i64 = dh6(j, wle(j, e, seed), wc(j, seed), wm(j, seed), extra, seed);
    if(is_gap == 1) { cb = gap_sentinel(j, e); }
    return x2_verdict(st, j, e, bit, tv, cb, is_gap);
}
fn o4_hxq(st:[]u8, j:i64, e:i64, label:i64, conf:i64, meas:i64, extra:i64, seed:i64) i32 {
    return x2_enqueue(st, j, e, label, conf, meas, extra, seed);
}
fn o4_hvx(st:[]u8, j:i64, e:i64, bit:i64, tv:i64, bound:i64, is_gap:i64) i32 {
    return x2_verdict(st, j, e, bit, tv, bound, is_gap);
}
fn o4_honest3(st:[]u8, j:i64, seed:i64) void {
    let e:i64 = 0;
    while(e < 3) { o4_he(st, j, e, 7, seed); e = e + 1; }
    e = 0;
    while(e < 3) { o4_hv(st, j, e, 1, x2_now(st), 7, seed, 0); e = e + 1; }
    return;
}
fn o4_line_pfr(ob:[]u8, pos:i32, code:[]u8, j:i64, r:i64) i32 {
    pos = ob_puts(ob, pos, code);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_pr(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_fi(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_rc(r) as i64);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}

// ---------- install classes (one fn per code) ----------
fn c_e0(ob:[]u8, pos:i32, j:i64) i32 {
    // AMENDMENT A1: independent transcripts — one fresh arena per sub-install.
    let st0:[]u8 = x2_state_new();
    let r0:i64 = x2_decide(st0, j, 0);
    nio_free(st0);
    let st1:[]u8 = x2_state_new();
    let r1:i64 = x2_decide(st1, j, -1);
    nio_free(st1);
    pos = ob_puts(ob, pos, "E0 ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_pr(r0) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_fi(r0) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_rc(r0) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_pr(r1) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_fi(r1) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_rc(r1) as i64);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}
fn c_e0n(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let r:i64 = x2_decide_nop(st, j, 0);
    pos = o4_line_pfr(ob, pos, "E0N", j, r);
    nio_free(st);
    return pos;
}
fn c_e1(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    o4_he(st, j, 0, 7, seed);
    o4_hv(st, j, 0, 1, 0, 7, seed, 0);
    let r:i64 = x2_decide(st, j, 1);
    pos = o4_line_pfr(ob, pos, "E1", j, r);
    nio_free(st);
    return pos;
}
fn c_e2(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    let e:i64 = 0;
    while(e < 2) { o4_he(st, j, e, 7, seed); e = e + 1; }
    e = 0;
    while(e < 2) { o4_hv(st, j, e, 1, 0, 7, seed, 0); e = e + 1; }
    let r:i64 = x2_decide(st, j, 2);
    pos = o4_line_pfr(ob, pos, "E2", j, r);
    nio_free(st);
    return pos;
}
fn c_g0(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let e:i64 = 0;
    while(e < 3) {
        x2_gap(st, j, e);
        o4_hvx(st, j, e, 1, 0, gap_sentinel(j, e), 1);
        e = e + 1;
    }
    let r:i64 = x2_decide(st, j, 3);
    pos = o4_line_pfr(ob, pos, "G0", j, r);
    nio_free(st);
    return pos;
}
fn c_g1(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    let e:i64 = 0;
    while(e < 2) {
        o4_he(st, j, e, 7, seed);
        o4_hv(st, j, e, 1, x2_now(st), 7, seed, 0);
        e = e + 1;
    }
    o4_hxq(st, j, 2, 1 - wle(j, 2, seed), wc(j, seed), wm(j, seed), 7, seed);
    x2_gap(st, j, 2);
    o4_hvx(st, j, 2, 1, 0, gap_sentinel(j, 2), 1);
    let r:i64 = x2_decide(st, j, 3);
    pos = o4_line_pfr(ob, pos, "G1", j, r);
    nio_free(st);
    return pos;
}
fn c_g2(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    o4_he(st, j, 0, 7, seed);
    o4_hv(st, j, 0, 1, x2_now(st), 7, seed, 0);
    x2_gap(st, j, 0);
    let r:i64 = x2_decide(st, j, 1);
    pos = o4_line_pfr(ob, pos, "G2", j, r);
    nio_free(st);
    return pos;
}
fn c_t0(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    x2_tick(st);
    let e:i64 = 0;
    while(e < 3) { o4_he(st, j, e, 7, seed); e = e + 1; }
    e = 0;
    while(e < 3) { o4_hv(st, j, e, 1, 0, 7, seed, 0); e = e + 1; }
    let r:i64 = x2_decide(st, j, 3);
    pos = o4_line_pfr(ob, pos, "T0", j, r);
    nio_free(st);
    return pos;
}
fn c_t1(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    let e:i64 = 0;
    while(e < 3) { o4_he(st, j, e, 7, seed); e = e + 1; }
    let tv:i64 = x2_now(st) + 3;
    e = 0;
    while(e < 3) {
        let b:i64 = dh6(j, wle(j, e, seed), wc(j, seed), wm(j, seed), 7, seed);
        o4_hvx(st, j, e, 1, tv, b, 0);
        e = e + 1;
    }
    let r:i64 = x2_decide(st, j, 3);
    pos = o4_line_pfr(ob, pos, "T1", j, r);
    nio_free(st);
    return pos;
}
fn c_cl(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    let e:i64 = 0;
    while(e < 2) { o4_he(st, j, e, 7, seed); e = e + 1; }
    let d0:i64 = dh6(j, wle(j, 0, seed), wc(j, seed), wm(j, seed), 7, seed);
    let d1:i64 = dh6(j, wle(j, 1, seed), wc(j, seed), wm(j, seed), 7, seed);
    e = 0;
    while(e < 2) { o4_hv(st, j, e, 1, 0, 7, seed, 0); e = e + 1; }
    let r:i64 = x2_decide(st, j, 2);
    pos = ob_puts(ob, pos, "CL ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_pr(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_fi(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_rc(r) as i64);
    pos = ob_puts(ob, pos, " ");
    let deq:i32 = 0;
    if(d0 == d1) { deq = 1; }
    pos = ob_puti(ob, pos, deq as i64);
    pos = ob_puts(ob, pos, "\n");
    nio_free(st);
    return pos;
}
fn c_p0(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    let e:i64 = 0;
    while(e < 2) {
        o4_he(st, j, e, 7, seed);
        o4_hv(st, j, e, 1, x2_now(st), 7, seed, 0);
        e = e + 1;
    }
    o4_hxq(st, j, 2, wle(j, 2, seed), wc(j, seed), wm(j, seed), 9, seed);
    let b2:i64 = dh6(j, wle(j, 2, seed), wc(j, seed), wm(j, seed), 9, seed);
    o4_hvx(st, j, 2, 1, x2_now(st), b2, 0);
    let r:i64 = x2_decide(st, j, 3);
    pos = o4_line_pfr(ob, pos, "P0", j, r);
    nio_free(st);
    return pos;
}
fn c_p1(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    let e:i64 = 0;
    while(e < 2) {
        o4_he(st, j, e, 7, seed);
        o4_hv(st, j, e, 1, x2_now(st), 7, seed, 0);
        e = e + 1;
    }
    o4_hxq(st, j, 2, wle(j, 2, seed), wc(j, seed), wm(j, seed), 9, seed);
    x2_gap(st, j, 2);
    o4_hvx(st, j, 2, 1, 0, gap_sentinel(j, 2), 1);
    let r:i64 = x2_decide(st, j, 3);
    pos = o4_line_pfr(ob, pos, "P1", j, r);
    nio_free(st);
    return pos;
}
fn c_sd(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let e:i64 = 0;
    while(e < 3) {
        let se:i64 = 1000 + j + e * 1000;
        o4_hxq(st, j, e, wle(j, e, se), wc(j, se), wm(j, se), 7, se);
        let b:i64 = dh6(j, wle(j, e, se), wc(j, se), wm(j, se), 7, se);
        o4_hvx(st, j, e, 1, x2_now(st), b, 0);
        e = e + 1;
    }
    let r:i64 = x2_decide(st, j, 3);
    pos = o4_line_pfr(ob, pos, "SD", j, r);
    nio_free(st);
    return pos;
}
fn c_nn(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    let lab:i64 = wl(j, seed);
    let cf:i64 = wc(j, seed);
    let ms:i64 = wm(j, seed) + 51;
    o4_hxq(st, j, 0, lab, cf, ms, 7, seed);
    o4_hvx(st, j, 0, 1, x2_now(st), dh6(j, lab, cf, ms, 7, seed), 0);
    let r:i64 = x2_decide_nop(st, j, 1);
    pos = o4_line_pfr(ob, pos, "NN", j, r);
    nio_free(st);
    return pos;
}
fn c_nf(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    let lab:i64 = wl(j, seed);
    let cf:i64 = wc(j, seed);
    let ms:i64 = wm(j, seed) + 51;
    o4_hxq(st, j, 0, lab, cf, ms, 7, seed);
    o4_hvx(st, j, 0, 1, x2_now(st), dh6(j, lab, cf, ms, 7, seed), 0);
    let r:i64 = x2_decide(st, j, 1);
    pos = o4_line_pfr(ob, pos, "NF", j, r);
    nio_free(st);
    return pos;
}
fn c_q0(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let k:i64 = 0;
    while(k < 40) {
        let fid:i64 = 100000 + k;
        let fs:i64 = 5000 + k;
        o4_hxq(st, fid, 0, wl(fid, fs), wc(fid, fs), wm(fid, fs), 0, fs);
        k = k + 1;
    }
    let rcq:i32 = o4_he(st, j, 0, 7, 1000 + j);
    pos = ob_puts(ob, pos, "Q0 ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, rcq as i64);
    pos = ob_puts(ob, pos, "\n");
    nio_free(st);
    return pos;
}
fn c_r0(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    o4_he(st, j, 0, 7, seed);
    o4_hv(st, j, 0, 1, 0, 7, seed, 0);
    let r1:i64 = x2_decide(st, j, 1);
    x2_reset(st);
    o4_he(st, j, 0, 7, seed);
    o4_hv(st, j, 0, 1, 0, 7, seed, 0);
    let r2:i64 = x2_decide(st, j, 1);
    pos = ob_puts(ob, pos, "R0 ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_pr(r1) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_fi(r1) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_rc(r1) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_pr(r2) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_fi(r2) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_rc(r2) as i64);
    pos = ob_puts(ob, pos, "\n");
    nio_free(st);
    return pos;
}
fn c_pz(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    let r1:i64 = x2_decide(st, j, 0);
    o4_honest3(st, j, seed);
    let r2:i64 = x2_decide(st, j, 3);
    pos = ob_puts(ob, pos, "PZ ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_pr(r1) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_fi(r1) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_rc(r1) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_pr(r2) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_fi(r2) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_rc(r2) as i64);
    pos = ob_puts(ob, pos, "\n");
    nio_free(st);
    return pos;
}
fn c_fw(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    o4_he(st, j, 0, 7, seed);
    o4_hxq(st, j, 0, 1 - wle(j, 0, seed), wc(j, seed), wm(j, seed), 7, seed);
    o4_hv(st, j, 0, 1, x2_now(st), 7, seed, 0);
    let r:i64 = x2_decide(st, j, 1);
    pos = o4_line_pfr(ob, pos, "FW", j, r);
    nio_free(st);
    return pos;
}
fn c_c12(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    o4_he(st, j, 0, 7, seed);
    let b:i64 = dh6(j, wle(j, 0, seed), wc(j, seed), wm(j, seed), 7, seed) + 1;
    o4_hvx(st, j, 0, 1, x2_now(st), b, 0);
    let r:i64 = x2_decide(st, j, 1);
    pos = o4_line_pfr(ob, pos, "C12", j, r);
    nio_free(st);
    return pos;
}
fn c_c4(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    o4_he(st, j, 0, 7, seed);
    let tv:i64 = x2_now(st);
    let b:i64 = dh6(j, wle(j, 0, seed), wc(j, seed), wm(j, seed), 7, seed);
    o4_hvx(st, j, 0, 1, tv, b, 0);
    let vr1:i32 = o4_hvx(st, j, 0, 1, tv, b, 0);
    let r:i64 = x2_decide(st, j, 1);
    pos = ob_puts(ob, pos, "C4 ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, vr1 as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_pr(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_fi(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x2_up_rc(r) as i64);
    pos = ob_puts(ob, pos, "\n");
    nio_free(st);
    return pos;
}
fn c_c8(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    o4_he(st, j, 0, 7, seed);
    o4_hv(st, j, 0, 1, x2_now(st), 7, seed, 0);
    let r:i64 = x2_decide(st, j, 2);
    pos = o4_line_pfr(ob, pos, "C8", j, r);
    nio_free(st);
    return pos;
}
fn c_h0(ob:[]u8, pos:i32, j:i64) i32 {
    let st:[]u8 = x2_state_new();
    let seed:i64 = 1000 + j;
    o4_honest3(st, j, seed);
    let r:i64 = x2_decide(st, j, 3);
    pos = o4_line_pfr(ob, pos, "H0", j, r);
    nio_free(st);
    return pos;
}

// ---------- main ----------
fn main() void {
    let ob:[]u8 = nio_alloc(262144);
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "B-OBJ4 rt-obj4 frozen prereg f13383e8 driver fec41193\n");
    let j:i64 = 0;
    while(j < 120) {
        pos = c_e0(ob, pos, j);
        pos = c_e0n(ob, pos, j);
        pos = c_e1(ob, pos, j);
        pos = c_e2(ob, pos, j);
        pos = c_g0(ob, pos, j);
        pos = c_g1(ob, pos, j);
        pos = c_g2(ob, pos, j);
        pos = c_t0(ob, pos, j);
        pos = c_t1(ob, pos, j);
        pos = c_cl(ob, pos, j);
        pos = c_p0(ob, pos, j);
        pos = c_p1(ob, pos, j);
        pos = c_sd(ob, pos, j);
        pos = c_nn(ob, pos, j);
        pos = c_nf(ob, pos, j);
        pos = c_q0(ob, pos, j);
        pos = c_r0(ob, pos, j);
        pos = c_pz(ob, pos, j);
        pos = c_fw(ob, pos, j);
        pos = c_c12(ob, pos, j);
        pos = c_c4(ob, pos, j);
        pos = c_c8(ob, pos, j);
        pos = c_h0(ob, pos, j);
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "END\n");
    _zag_print(ob[0..pos]);
    nio_free(ob);
    return;
}

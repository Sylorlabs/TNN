// teacher.zag — TRACKB-DISCRIM D8 negative control: MINIMAL pure-Zag teacher.
//
// A cursor-order WORD_SPAN teacher that IGNORES history. Every invocation
// emits up to 8 WORD_SPAN proposals over the first word tokens of the
// stimulus (byte 0 upward), fixed confidence, no appeals, no phases, no
// engagement, no dead-marking. The history file is opened and validated
// (must exist) but never influences the output.
//
// Purpose (prereg D8/K1): establish that the original adaptive-judgment bar
// has teeth. If a teacher that ignores history shows zero history
// sensitivity, then the history-sensitivity measured in varA/varB/varC is
// evidence of real adaptive judgment, not an artifact of the harness.
//
// CLI: teacher <dir> <stimulus_name> <history_name> <session_id>
// Writes: concatenated frozen-§P v1 proposals (teacher_id=3) to stdout.
// Exit 0 on success; non-zero on malformed input (history ignored, but the
// file must exist and be readable).
//
// Pure Zag. No RNG, no wallclock. Deterministic given (stimulus, session).

@import("substrate/R33_NATIVE_IO_V1.zag")

fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_fnv1a(b:[]u8, n:i32) i64 {
    let h:i64 = -3750763034362895579;
    let i:i32 = 0;
    while(i < n) {
        h = h ^ ((b[i] as i64) & 255);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}
fn t_parse_u64(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < s.len) {
        let c:i32 = s[i] as i32;
        if(c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
        i = i + 1;
    }
    return v;
}
fn t_is_word_byte(b:u8) i32 {
    let c:i32 = b as i32;
    if(c >= 48 && c <= 57) { return 1; }
    if(c >= 65 && c <= 90) { return 1; }
    if(c >= 97 && c <= 122) { return 1; }
    if(c == 95) { return 1; }
    return 0;
}
fn t_die(msg:[]u8, code:i32) i32 {
    nio_write_all(2, msg);
    return code;
}
// emit one frozen-§P v1 WORD_SPAN; returns bytes written.
fn t_emit(prop:[]u8, session_id:i64, seq:i64, ss:i64, se:i64) i32 {
    t_put32(prop, 0, 1414550096);
    t_put16(prop, 4, 1);
    t_put32(prop, 6, 3);
    t_put64(prop, 10, session_id);
    t_put64(prop, 18, seq);
    prop[26] = 1;
    t_put64(prop, 27, ss);
    t_put64(prop, 35, se);
    prop[43] = 0;
    prop[44] = 0;
    prop[45] = 100;
    let ck:i64 = t_fnv1a(prop, 46);
    t_put64(prop, 46, ck);
    return 54;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let a4:[]u8 = _zag_arg(4);
    if(a1.len == 0 || a2.len == 0 || a3.len == 0 || a4.len == 0) {
        return t_die("usage: teacher <dir> <stimulus> <history> <session_id>\n", 1);
    }
    let session_id:i64 = t_parse_u64(a4);
    let root:i64 = nio_open_root(a1);
    if(root < 0) { return t_die("cannot open dir\n", 2); }
    if(nio_name_valid(a2) != 1 || nio_name_valid(a3) != 1) {
        return t_die("bad file name\n", 3);
    }
    let sfd:i64 = nio_open_child(root, a2, 0);
    if(sfd < 0) { return t_die("cannot open stimulus\n", 4); }
    let stim:[]u8 = nio_alloc(1048592);
    if(stim.len == 0) { return t_die("oom\n", 4); }
    let srd:i64 = nio_read_exact(sfd, stim, 1048576);
    nio_close(sfd);
    if(srd < 0) { return t_die("cannot read stimulus\n", 4); }
    if(srd == 0) { return t_die("empty stimulus\n", 5); }
    if(srd > 1048576) { return t_die("stimulus too large\n", 6); }
    let slen:i32 = srd as i32;
    // history: must exist and be readable, but is NEVER read for decisions.
    // (K1: output must be bit-identical regardless of history content.)
    let hfd:i64 = nio_open_child(root, a3, 0);
    if(hfd < 0) { return t_die("cannot open history\n", 20); }
    nio_close(hfd);
    nio_close(root);
    // cursor-order word scan from byte 0; emit up to 8 WORD_SPANs.
    let prop:[]u8 = nio_alloc(64);
    if(prop.len == 0) { return t_die("oom\n", 7); }
    let out:[]u8 = nio_alloc(512);
    if(out.len == 0) { return t_die("oom\n", 7); }
    let at:i32 = 0;
    let seq:i64 = 0;
    let i:i32 = 0;
    let n:i32 = 0;
    while(i < slen && n < 8) {
        while(i < slen && t_is_word_byte(stim[i]) == 0) { i = i + 1; }
        if(i >= slen) { break; }
        let s:i32 = i;
        while(i < slen && t_is_word_byte(stim[i]) == 1) { i = i + 1; }
        let nb:i32 = t_emit(prop, session_id, seq, s as i64, i as i64);
        let k:i32 = 0;
        while(k < nb) { out[at + k] = prop[k]; k = k + 1; }
        at = at + nb;
        seq = seq + 1;
        n = n + 1;
    }
    if(nio_write_all(1, out[0..at]) != (at as i64)) {
        return t_die("stdout write failed\n", 8);
    }
    return 0;
}

@import("R33_NATIVE_SHA256_V2.zag")

// PROSE-LEARN3: v2 + two gated learner changes (see PREREG3 notes).
// argv[1] = source name. argv[2] = mode: "m0" (v2-exact), "m1" (change 1),
// "m2" (changes 1+2 = full v3). Reads inputs/train_<s>.txt,
// inputs/test_<s>.txt, inputs/false_ids_<s>.txt relative to CWD.
// Change 1 (m1,m2): coreference block moved BEFORE rule 2d in tag_entity
//   (order 2a->2b->2c->coref->2d->EMPTY); m0 keeps v2 order.
// Change 2 (m2 only): KEYSOFT tier-3 probe fallback -- sentence-level Jaccard
//   (>=0.5) over live asserted rows, keyed by sorted-unique content-stem uids
//   stored at INSTALL time (parallel arena, stride 260).
// Pure Zag, zero RNG. All tables are []u8 arenas with explicit put/get32
// (znc ZNC-2026-09-21-007: never `as []i32` for indexed tables).
// Tokenizer / word-unit interning / number lexicon / stemmer are VERBATIM v1.

// ---------------- byte helpers ----------------
fn is_alnum(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn p64(b:[]u8,at:i32,v:i64)void {
    p32(b,at,v&4294967295);
    p32(b,at+4,(v>>32)&4294967295);
    return;
}
fn g64(b:[]u8,at:i32)i64 {
    return g32(b,at)|(g32(b,at+4)<<32);
}
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn beq2(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let i:i32=0;
    while(i<len){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn parse_int(b:[]u8,off:i32,len:i32)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<len){
        let c:u8=b[off+i];
        if(c>=48 && c<=57){v=v*10+((c as i64)-48);}
        i=i+1;
    }
    return v;
}
fn mkpath(a:[]u8,b:[]u8,c:[]u8)[]u8 {
    let n:i32=a.len+b.len+c.len;
    let o:[]u8=nio_alloc(n);
    copy_bytes(o,0,a,0,a.len);
    copy_bytes(o,a.len,b,0,b.len);
    copy_bytes(o,a.len+b.len,c,0,c.len);
    return o;
}

// ---------------- printing ----------------
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){
        let dd:i64=(x%10)+48;
        buf[at]=dd as u8;
        x=x/10;
        at=at-1;
    }
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    prlen(b,n);
    nio_free(b);
    return;
}
fn prhex(b:[]u8,off:i32,len:i32)void {
    let hb:[]u8=nio_alloc(len*2+1);
    let dg:[]u8="0123456789abcdef";
    let i:i32=0;
    while(i<len){
        let v:i32=b[off+i] as i32;
        hb[2*i]=dg[v/16];
        hb[2*i+1]=dg[v%16];
        i=i+1;
    }
    prlen(hb,len*2);
    nio_free(hb);
    return;
}

// ---------------- file IO (raw syscalls) ----------------
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=8388608;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{
                    copy_bytes(buf,total,chk,0,nb);
                    total=total+nb;
                }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}

// ---------------- arena helpers ----------------
fn arena_append(a:[]u8,v:i64)void {
    let u:i32=g32(a,0) as i32;
    p32(a,u,v);
    p32(a,0,(u+4) as i64);
    return;
}

// ---------------- vocab (verbatim v1) ----------------
fn v_intern(vbytes:[]u8,vent:[]u8,sb:[]u8,so:i32,sl:i32)i32 {
    let n:i32=g32(vent,0) as i32;
    let i:i32=0;
    while(i<n){
        let eo:i32=g32(vent,8+8*i) as i32;
        let el:i32=g32(vent,8+8*i+4) as i32;
        if(el==sl){
            if(beq2(sb,so,vbytes,eo,sl)==1){return i;}
        }
        i=i+1;
    }
    let used:i32=g32(vbytes,0) as i32;
    copy_bytes(vbytes,used,sb,so,sl);
    p32(vbytes,0,(used+sl) as i64);
    p32(vent,8+8*n,used as i64);
    p32(vent,8+8*n+4,sl as i64);
    p32(vent,0,(n+1) as i64);
    return n;
}

// ---------------- stopwords (verbatim v1) ----------------
fn is_stop(sb:[]u8,so:i32,sl:i32)i32 {
    if(beq(sb,so,sl,"the")==1){return 1;}
    if(beq(sb,so,sl,"an")==1){return 1;}
    if(beq(sb,so,sl,"of")==1){return 1;}
    if(beq(sb,so,sl,"in")==1){return 1;}
    if(beq(sb,so,sl,"is")==1){return 1;}
    if(beq(sb,so,sl,"are")==1){return 1;}
    if(beq(sb,so,sl,"was")==1){return 1;}
    if(beq(sb,so,sl,"were")==1){return 1;}
    if(beq(sb,so,sl,"be")==1){return 1;}
    if(beq(sb,so,sl,"been")==1){return 1;}
    if(beq(sb,so,sl,"what")==1){return 1;}
    if(beq(sb,so,sl,"which")==1){return 1;}
    if(beq(sb,so,sl,"that")==1){return 1;}
    if(beq(sb,so,sl,"this")==1){return 1;}
    if(beq(sb,so,sl,"these")==1){return 1;}
    if(beq(sb,so,sl,"those")==1){return 1;}
    if(beq(sb,so,sl,"it")==1){return 1;}
    if(beq(sb,so,sl,"its")==1){return 1;}
    if(beq(sb,so,sl,"do")==1){return 1;}
    if(beq(sb,so,sl,"does")==1){return 1;}
    if(beq(sb,so,sl,"did")==1){return 1;}
    if(beq(sb,so,sl,"have")==1){return 1;}
    if(beq(sb,so,sl,"has")==1){return 1;}
    if(beq(sb,so,sl,"had")==1){return 1;}
    if(beq(sb,so,sl,"there")==1){return 1;}
    if(beq(sb,so,sl,"and")==1){return 1;}
    if(beq(sb,so,sl,"or")==1){return 1;}
    if(beq(sb,so,sl,"to")==1){return 1;}
    if(beq(sb,so,sl,"for")==1){return 1;}
    if(beq(sb,so,sl,"with")==1){return 1;}
    if(beq(sb,so,sl,"at")==1){return 1;}
    if(beq(sb,so,sl,"by")==1){return 1;}
    if(beq(sb,so,sl,"from")==1){return 1;}
    if(beq(sb,so,sl,"as")==1){return 1;}
    if(beq(sb,so,sl,"on")==1){return 1;}
    if(beq(sb,so,sl,"how")==1){return 1;}
    if(beq(sb,so,sl,"many")==1){return 1;}
    if(beq(sb,so,sl,"much")==1){return 1;}
    if(beq(sb,so,sl,"when")==1){return 1;}
    if(beq(sb,so,sl,"where")==1){return 1;}
    if(beq(sb,so,sl,"s")==1){return 1;}
    return 0;
}

// ---------------- number lexicon (verbatim v1) ----------------
fn digit_val(sb:[]u8,so:i32,sl:i32)i64 {
    let i:i32=0;
    let go:i32=1;
    while(go==1){
        if(i>=sl){go=0;}
        else{
            let c3:u8=sb[so+i];
            if(c3>=48 && c3<=57){i=i+1;}
            else{go=0;}
        }
    }
    if(i==0){return -1;}
    let rest:i32=sl-i;
    if(rest!=0){
        if(rest!=2){return -1;}
        let s0:u8=sb[so+i];
        let s1:u8=sb[so+i+1];
        let ok:i32=0;
        if(s0==115 && s1==116){ok=1;}
        if(s0==110 && s1==100){ok=1;}
        if(s0==114 && s1==100){ok=1;}
        if(s0==116 && s1==104){ok=1;}
        if(ok==0){return -1;}
    }
    let v:i64=0;
    let j:i32=0;
    while(j<i){
        let d:i64=(sb[so+j] as i64)-48;
        v=v*10+d;
        j=j+1;
    }
    return v;
}
fn numword_val(sb:[]u8,so:i32,sl:i32)i64 {
    if(beq(sb,so,sl,"one")==1){return 1;}
    if(beq(sb,so,sl,"two")==1){return 2;}
    if(beq(sb,so,sl,"three")==1){return 3;}
    if(beq(sb,so,sl,"four")==1){return 4;}
    if(beq(sb,so,sl,"five")==1){return 5;}
    if(beq(sb,so,sl,"six")==1){return 6;}
    if(beq(sb,so,sl,"seven")==1){return 7;}
    if(beq(sb,so,sl,"eight")==1){return 8;}
    if(beq(sb,so,sl,"nine")==1){return 9;}
    if(beq(sb,so,sl,"ten")==1){return 10;}
    if(beq(sb,so,sl,"eleven")==1){return 11;}
    if(beq(sb,so,sl,"twelve")==1){return 12;}
    if(beq(sb,so,sl,"thirteen")==1){return 13;}
    if(beq(sb,so,sl,"fourteen")==1){return 14;}
    if(beq(sb,so,sl,"fifteen")==1){return 15;}
    if(beq(sb,so,sl,"sixteen")==1){return 16;}
    if(beq(sb,so,sl,"seventeen")==1){return 17;}
    if(beq(sb,so,sl,"eighteen")==1){return 18;}
    if(beq(sb,so,sl,"nineteen")==1){return 19;}
    if(beq(sb,so,sl,"twenty")==1){return 20;}
    if(beq(sb,so,sl,"thirty")==1){return 30;}
    if(beq(sb,so,sl,"first")==1){return 1;}
    if(beq(sb,so,sl,"second")==1){return 2;}
    if(beq(sb,so,sl,"third")==1){return 3;}
    if(beq(sb,so,sl,"fourth")==1){return 4;}
    if(beq(sb,so,sl,"fifth")==1){return 5;}
    if(beq(sb,so,sl,"sixth")==1){return 6;}
    if(beq(sb,so,sl,"seventh")==1){return 7;}
    if(beq(sb,so,sl,"eighth")==1){return 8;}
    if(beq(sb,so,sl,"ninth")==1){return 9;}
    if(beq(sb,so,sl,"tenth")==1){return 10;}
    if(beq(sb,so,sl,"eleventh")==1){return 11;}
    if(beq(sb,so,sl,"twelfth")==1){return 12;}
    if(beq(sb,so,sl,"thirteenth")==1){return 13;}
    if(beq(sb,so,sl,"fourteenth")==1){return 14;}
    if(beq(sb,so,sl,"fifteenth")==1){return 15;}
    if(beq(sb,so,sl,"sixteenth")==1){return 16;}
    if(beq(sb,so,sl,"seventeenth")==1){return 17;}
    if(beq(sb,so,sl,"eighteenth")==1){return 18;}
    if(beq(sb,so,sl,"nineteenth")==1){return 19;}
    if(beq(sb,so,sl,"twentieth")==1){return 20;}
    if(beq(sb,so,sl,"thirtieth")==1){return 30;}
    return -1;
}

// ---------------- stemmer (verbatim v1) ----------------
fn ends_with(b:[]u8,len:i32,suf:[]u8)i32 {
    if(len<suf.len){return 0;}
    return beq2(b,len-suf.len,suf,0,suf.len);
}
fn stem_inplace(b:[]u8,len:i32)i32 {
    if(ends_with(b,len,"ies")==1){
        b[len-3]=121;
        return len-2;
    }
    if(ends_with(b,len,"ication")==1){
        b[len-7]=105;
        b[len-6]=115;
        b[len-5]=104;
        return len-4;
    }
    if(ends_with(b,len,"ished")==1){
        b[len-5]=105;
        b[len-4]=115;
        b[len-3]=104;
        return len-2;
    }
    if(ends_with(b,len,"ic")==1 && len>5){return len-2;}
    if(ends_with(b,len,"ed")==1 && len>4){return len-2;}
    if(ends_with(b,len,"ches")==1){return len-2;}
    if(ends_with(b,len,"shes")==1){return len-2;}
    if(ends_with(b,len,"sses")==1){return len-2;}
    if(ends_with(b,len,"xes")==1){return len-2;}
    if(ends_with(b,len,"zes")==1){return len-2;}
    if(ends_with(b,len,"s")==1 && len>3 && ends_with(b,len,"ss")==0){return len-1;}
    return len;
}

// ---------------- sentence context ----------------
// sctx (128B): 0:ntok 4:c_n 8:ndig 12:nword 16:lastdig(i64) 24:lastword(i64)
// 32:vtoklen 36:ent_len 40:ent_n 44:rel_n 48:coref 52:relkind 56:ph_ts 60:ph_te
// 64:eid(i64) 72:att 80:val_ok 88:val(i64)
fn zero128(st:[]u8)void {
    let c:i32=0;
    while(c<128){st[c]=0;c=c+1;}
    return;
}

// token flags: 1=digit 2=numword 4=stop 8=content
fn tok_classify(vbytes:[]u8,vent:[]u8,sbuf:[]u8,soff:i32,slen:i32,lowb:[]u8,stembuf:[]u8,linka:[]u8,toff:[]u8,tlen:[]u8,tsoff:[]u8,tslen:[]u8,tsuid:[]u8,tflags:[]u8,tval:[]u8,cpos:[]u8,sctx:[]u8)i32 {
    let n:i32=0;
    let cn:i32=0;
    let ndig:i32=0;
    let nword:i32=0;
    let lastdig:i64=0;
    let lastword:i64=0;
    let i:i32=0;
    // v3 change 1: coreference trigger flag in sctx[76]. Set if the sentence
    // contains a pronoun or the "the word"/"the letter" bigram. Computed here
    // (tokenizer already scans tokens) to avoid a second scan in tag_entity,
    // which miscompiled in this znc build.
    p32(sctx,76,0);
    let prev_the:i32=0;
    while(i<slen){
        if(is_alnum(sbuf[soff+i])==1){
            let j:i32=i;
            let go:i32=1;
            while(go==1){
                if(j<slen && is_alnum(sbuf[soff+j])==1){j=j+1;}
                else{go=0;}
            }
            let tl:i32=j-i;
            let k:i32=0;
            while(k<tl){
                lowb[k]=to_low(sbuf[soff+i+k]);
                k=k+1;
            }
            // v3 change 1: coreference trigger detection.
            if(tl==2 && beq(lowb,0,tl,"it")==1){p32(sctx,76,1);}
            if(tl==3 && beq(lowb,0,tl,"its")==1){p32(sctx,76,1);}
            if(tl==4 && beq(lowb,0,tl,"this")==1){p32(sctx,76,1);}
            if(tl==4 && beq(lowb,0,tl,"that")==1){p32(sctx,76,1);}
            if(tl==5 && beq(lowb,0,tl,"these")==1){p32(sctx,76,1);}
            if(tl==5 && beq(lowb,0,tl,"those")==1){p32(sctx,76,1);}
            if(prev_the==1){
                if(tl==4 && beq(lowb,0,tl,"word")==1){p32(sctx,76,1);}
                if(tl==6 && beq(lowb,0,tl,"letter")==1){p32(sctx,76,1);}
            }
            if(tl==3 && beq(lowb,0,tl,"the")==1){prev_the=1;}
            else{prev_the=0;}
            p32(toff,n*4,(soff+i) as i64);
            p32(tlen,n*4,tl as i64);
            let uid:i32=v_intern(vbytes,vent,lowb,0,tl);
            arena_append(linka,uid as i64);
            let fl:i32=0;
            let dv:i64=digit_val(lowb,0,tl);
            if(dv>=0){
                fl=1;
                p64(tval,n*8,dv);
                ndig=ndig+1;
                lastdig=dv;
            }
            else{
                let nv:i64=numword_val(lowb,0,tl);
                if(nv>=0){
                    fl=2;
                    p64(tval,n*8,nv);
                    nword=nword+1;
                    lastword=nv;
                }
                else{
                    if(is_stop(lowb,0,tl)==1){fl=4;}
                    else{
                        fl=8;
                        let sl:i32=stem_inplace(lowb,tl);
                        let sbo:i32=g32(stembuf,0) as i32;
                        copy_bytes(stembuf,sbo,lowb,0,sl);
                        p32(stembuf,0,(sbo+sl) as i64);
                        p32(tsoff,n*4,sbo as i64);
                        p32(tslen,n*4,sl as i64);
                        let suid:i32=v_intern(vbytes,vent,lowb,0,sl);
                        p32(tsuid,n*4,suid as i64);
                        p32(cpos,cn*4,n as i64);
                        cn=cn+1;
                    }
                }
            }
            p32(tflags,n*4,fl as i64);
            n=n+1;
            i=j;
        }
        else{i=i+1;}
    }
    p32(sctx,0,n as i64);
    p32(sctx,4,cn as i64);
    p32(sctx,8,ndig as i64);
    p32(sctx,12,nword as i64);
    p64(sctx,16,lastdig);
    p64(sctx,24,lastword);
    return n;
}

// frozen value scan: last digit-token value; else last number-word value.
fn scan_value(sbuf:[]u8,toff:[]u8,tlen:[]u8,tflags:[]u8,tval:[]u8,lowb:[]u8,vtokb:[]u8,sctx:[]u8)void {
    let ntok:i32=g32(sctx,0) as i32;
    let lastd:i32=-1;
    let lastw:i32=-1;
    let n:i32=0;
    while(n<ntok){
        let f:i32=g32(tflags,n*4) as i32;
        if(f==1){lastd=n;}
        if(f==2){lastw=n;}
        n=n+1;
    }
    let ok:i32=0;
    let val:i64=0;
    let vtoklen:i32=0;
    let src:i32=-1;
    if(lastd>=0){src=lastd;val=g64(tval,lastd*8);ok=1;}
    else{
        if(lastw>=0){src=lastw;val=g64(tval,lastw*8);ok=1;}
    }
    if(src>=0){
        let to:i32=g32(toff,src*4) as i32;
        let tl:i32=g32(tlen,src*4) as i32;
        let k:i32=0;
        while(k<tl){
            vtokb[k]=to_low(sbuf[to+k]);
            k=k+1;
        }
        vtoklen=tl;
    }
    p32(sctx,80,ok as i64);
    p64(sctx,88,val);
    p32(sctx,32,vtoklen as i64);
    return;
}

// ---------------- frozen relation phrases (stemmed forms) ----------------
// 0:(alphabet,position) 1:(letter,count) 2:(publish,year) 3:(come,after) 4:(come,before)
fn ph_tok_beq(ph:i32,k:i32,b:[]u8,off:i32,len:i32)i32 {
    if(ph==0){
        if(k==0){return beq(b,off,len,"alphabet");}
        return beq(b,off,len,"position");
    }
    if(ph==1){
        if(k==0){return beq(b,off,len,"letter");}
        return beq(b,off,len,"count");
    }
    if(ph==2){
        if(k==0){return beq(b,off,len,"publish");}
        return beq(b,off,len,"year");
    }
    if(ph==3){
        if(k==0){return beq(b,off,len,"come");}
        return beq(b,off,len,"after");
    }
    if(k==0){return beq(b,off,len,"come");}
    return beq(b,off,len,"before");
}
fn ph_len(ph:i32)i32 {
    if(ph>=0 && ph<5){return 2;}
    return 0;
}

// earliest start position in the content-token sequence; ties -> phrase list order.
// writes sctx relkind/ph_ts/ph_te on match. Returns 1/0.
fn phrase_scan(stembuf:[]u8,tsoff:[]u8,tslen:[]u8,cpos:[]u8,sctx:[]u8,min_tok:i32)i32 {
    let cn:i32=g32(sctx,4) as i32;
    let best_ti:i32=-1;
    let best_ph:i32=-1;
    let ci:i32=0;
    while(ci<cn){
        let ti:i32=g32(cpos,ci*4) as i32;
        if(ti>min_tok){
            let ph:i32=0;
            while(ph<5){
                let pl:i32=ph_len(ph);
                let mt:i32=1;
                if(ci+pl>cn){mt=0;}
                else{
                    let kk:i32=0;
                    while(kk<pl){
                        let tk:i32=g32(cpos,(ci+kk)*4) as i32;
                        let so:i32=g32(tsoff,tk*4) as i32;
                        let sl:i32=g32(tslen,tk*4) as i32;
                        if(ph_tok_beq(ph,kk,stembuf,so,sl)==0){mt=0;}
                        kk=kk+1;
                    }
                }
                if(mt==1){
                    if(best_ti<0 || ti<best_ti){
                        best_ti=ti;
                        best_ph=ph;
                    }
                }
                ph=ph+1;
            }
        }
        ci=ci+1;
    }
    if(best_ti<0){return 0;}
    let pl2:i32=ph_len(best_ph);
    let ci2:i32=0;
    while(ci2<cn){
        if(g32(cpos,ci2*4)==(best_ti as i64)){break;}
        ci2=ci2+1;
    }
    let te:i32=g32(cpos,(ci2+pl2-1)*4) as i32;
    p32(sctx,52,best_ph as i64);
    p32(sctx,56,best_ti as i64);
    p32(sctx,60,te as i64);
    return 1;
}

// ---------------- small sort ----------------
fn isort32(buf:[]u8,n:i32)void {
    let i:i32=1;
    while(i<n){
        let v:i64=g32(buf,i*4);
        let j:i32=i-1;
        let go:i32=1;
        while(go==1){
            if(j<0){go=0;}
            else{
                if(g32(buf,j*4)<=v){go=0;}
                else{
                    p32(buf,(j+1)*4,g32(buf,j*4));
                    j=j-1;
                }
            }
        }
        p32(buf,(j+1)*4,v);
        i=i+1;
    }
    return;
}

// lowercases the raw bytes of token tok into lowb; returns length.
fn tok_low(sbuf:[]u8,toff:[]u8,tlen:[]u8,lowb:[]u8,tok:i32)i32 {
    let to:i32=g32(toff,tok*4) as i32;
    let tl:i32=g32(tlen,tok*4) as i32;
    let k:i32=0;
    while(k<tl){
        lowb[k]=to_low(sbuf[to+k]);
        k=k+1;
    }
    return tl;
}

// builds the canonical entity from token indices in etmp[0..n); fills
// entstem with stem uids; interns; writes sctx ent_len/ent_n/eid.
fn ent_finalize(vbytes:[]u8,vent:[]u8,sbuf:[]u8,lowb:[]u8,toff:[]u8,tlen:[]u8,tsoff:[]u8,tslen:[]u8,tsuid:[]u8,tflags:[]u8,stembuf:[]u8,ebuf:[]u8,entstem:[]u8,etmp:[]u8,n:i32,sctx:[]u8)i64 {
    let el:i32=0;
    let i:i32=0;
    while(i<n){
        let tok:i32=g32(etmp,i*4) as i32;
        let tl:i32=tok_low(sbuf,toff,tlen,lowb,tok);
        if(i>0){
            ebuf[el]=32;
            el=el+1;
        }
        let k:i32=0;
        while(k<tl){
            ebuf[el]=lowb[k];
            el=el+1;
            k=k+1;
        }
        let f:i32=g32(tflags,tok*4) as i32;
        let uid:i64=0;
        if(f==8){uid=g32(tsuid,tok*4);}
        else{
            let sl:i32=stem_inplace(lowb,tl);
            uid=v_intern(vbytes,vent,lowb,0,sl) as i64;
        }
        p32(entstem,i*4,uid);
        i=i+1;
    }
    p32(sctx,36,el as i64);
    p32(sctx,40,n as i64);
    let eid:i64=v_intern(vbytes,vent,ebuf,0,el) as i64;
    p64(sctx,64,eid);
    return eid;
}
// ---------------- tier-3 (v3/m2) sentence key ----------------
// Sorted-unique content-stem uids of one sentence, built from cpos->tsuid
// via insertion sort + dedup, capped at 64. Cap rule (deterministic): keep
// the first 64 of the sorted-unique list. Returns the unique count; the
// deduped list lands in tmp[0..u).
fn t3_key(tmp:[]u8,cpos:[]u8,tsuid:[]u8,cn:i32)i32 {
    let i:i32=0;
    while(i<cn){
        let tok:i32=g32(cpos,i*4) as i32;
        p32(tmp,i*4,g32(tsuid,tok*4));
        i=i+1;
    }
    isort32(tmp,cn);
    let u:i32=0;
    let k:i32=0;
    let prevv:i64=-1;
    while(k<cn && u<64){
        let v:i64=g32(tmp,k*4);
        if(v!=prevv){
            p32(tmp,u*4,v);
            u=u+1;
            prevv=v;
        }
        k=k+1;
    }
    return u;
}

// Store the tier-3 key for asserted row `row` in the parallel arena skeys
// (stride 260 bytes: u32 count + up to 64 u32 stem uids).
fn t3_store(skeys:[]u8,row:i32,cpos:[]u8,tsuid:[]u8,cn:i32,tmp:[]u8)void {
    let u:i32=t3_key(tmp,cpos,tsuid,cn);
    let base:i32=row*260;
    p32(skeys,base,u as i64);
    let k:i32=0;
    while(k<u){
        p32(skeys,base+4+k*4,g32(tmp,k*4));
        k=k+1;
    }
    return;
}

// frozen entity tagger; v2 order 2a->2b->2c->2d->coreference->EMPTY,
// v3 (m1/m2) order 2a->2b->2c->coreference->2d->EMPTY.
fn tag_entity(vbytes:[]u8,vent:[]u8,sbuf:[]u8,soff:i32,slen:i32,lowb:[]u8,toff:[]u8,tlen:[]u8,tsoff:[]u8,tslen:[]u8,tsuid:[]u8,tflags:[]u8,cpos:[]u8,stembuf:[]u8,sctx:[]u8,ebuf:[]u8,entstem:[]u8,etmp:[]u8,peid:i64,pbuf:[]u8,ppn:i32,pentstem:[]u8,ppn_n:i32,is_probe:i32,mode:i32)i64 {
    let ntok:i32=g32(sctx,0) as i32;
    p32(sctx,36,0);
    p32(sctx,40,0);
    p32(sctx,48,0);
    // 2a: quoted span
    let q1:i32=-1;
    let q2:i32=-1;
    let qq:i32=0;
    while(qq<slen){
        if(sbuf[soff+qq]==34){
            if(q1<0){q1=soff+qq;}
            else{q2=soff+qq;break;}
        }
        qq=qq+1;
    }
    if(q1>=0 && q2>q1){
        let sn:i32=0;
        let n:i32=0;
        while(n<ntok){
            let a:i32=g32(toff,n*4) as i32;
            let b:i32=a+(g32(tlen,n*4) as i32);
            if(a>q1 && b<=q2){
                p32(etmp,sn*4,n as i64);
                sn=sn+1;
            }
            n=n+1;
        }
        if(sn>0){
            return ent_finalize(vbytes,vent,sbuf,lowb,toff,tlen,tsoff,tslen,tsuid,tflags,stembuf,ebuf,entstem,etmp,sn,sctx);
        }
    }
    // 2b: single uppercase letter token
    let n2:i32=0;
    while(n2<ntok){
        let tl:i32=g32(tlen,n2*4) as i32;
        if(tl==1){
            let c:u8=sbuf[g32(toff,n2*4) as i32];
            if(c>=65 && c<=90){
                p32(etmp,0,n2 as i64);
                return ent_finalize(vbytes,vent,sbuf,lowb,toff,tlen,tsoff,tslen,tsuid,tflags,stembuf,ebuf,entstem,etmp,1,sctx);
            }
        }
        n2=n2+1;
    }
    // 2c: tokens between 'of' (after the relation phrase) and the phrase:
    // authoritative example 'alphabet position of M' -> M. First <=4 content
    // tokens after 'of'; if none, the first word-token (stopwords allowed,
    // digits never -- a digit is the value, not the entity).
    if(phrase_scan(stembuf,tsoff,tslen,cpos,sctx,-1)==1){
        let ph_te:i32=g32(sctx,60) as i32;
        let ofi:i32=-1;
        let k:i32=ph_te+1;
        while(k<ntok){
            let tl2:i32=tok_low(sbuf,toff,tlen,lowb,k);
            if(tl2==2 && lowb[0]==111 && lowb[1]==102){ofi=k;break;}
            k=k+1;
        }
        if(ofi>=0){
            let sn2:i32=0;
            let k2:i32=ofi+1;
            while(k2<ntok && sn2<4){
                if(g32(tflags,k2*4)==8){
                    p32(etmp,sn2*4,k2 as i64);
                    sn2=sn2+1;
                }
                k2=k2+1;
            }
            if(sn2==0){
                let k2b:i32=ofi+1;
                while(k2b<ntok){
                    if(g32(tflags,k2b*4)!=1){
                        p32(etmp,0,k2b as i64);
                        sn2=1;
                        break;
                    }
                    k2b=k2b+1;
                }
            }
            if(sn2>0){
                return ent_finalize(vbytes,vent,sbuf,lowb,toff,tlen,tsoff,tslen,tsuid,tflags,stembuf,ebuf,entstem,etmp,sn2,sctx);
            }
        }
    }
    // v3 change 1: coreference BEFORE rule 2d in m1/m2 (train only).
    // NOTE (znc codegen): scanning tokens here (inline or via helper) to
    // compute the trigger miscompiled and corrupted the following 2d rule,
    // so the trigger flag is precomputed by the tokenizer in sctx[76].
    // A `return` nested inside the trig/peid if-block also miscompiled, so
    // the fire flag is set inside and the return happens at the outer level.
    if(mode>=1 && is_probe==0){
        let trig0:i32=g32(sctx,76) as i32;
        let fire0:i32=0;
        if(trig0==1 && peid!=4294967295){
            copy_bytes(ebuf,0,pbuf,0,ppn);
            let c20:i32=0;
            while(c20<ppn_n){
                p32(entstem,c20*4,g32(pentstem,c20*4));
                c20=c20+1;
            }
            p32(sctx,36,ppn as i64);
            p32(sctx,40,ppn_n as i64);
            p32(sctx,48,1);
            p64(sctx,64,peid);
            fire0=1;
        }
        if(fire0==1){return peid;}
    }
    // 2d: first up-to-four content tokens before first has/have/is/are/was/were
    let hi:i32=-1;
    let k3:i32=0;
    while(k3<ntok){
        let tl3:i32=tok_low(sbuf,toff,tlen,lowb,k3);
        let ism:i32=0;
        if(beq(lowb,0,tl3,"has")==1){ism=1;}
        if(beq(lowb,0,tl3,"have")==1){ism=1;}
        if(beq(lowb,0,tl3,"is")==1){ism=1;}
        if(beq(lowb,0,tl3,"are")==1){ism=1;}
        if(beq(lowb,0,tl3,"was")==1){ism=1;}
        if(beq(lowb,0,tl3,"were")==1){ism=1;}
        if(ism==1){hi=k3;break;}
        k3=k3+1;
    }
    if(hi>=0){
        let sn3:i32=0;
        let k4:i32=0;
        while(k4<hi && sn3<4){
            if(g32(tflags,k4*4)==8){
                p32(etmp,sn3*4,k4 as i64);
                sn3=sn3+1;
            }
            k4=k4+1;
        }
        if(sn3>0){
            return ent_finalize(vbytes,vent,sbuf,lowb,toff,tlen,tsoff,tslen,tsuid,tflags,stembuf,ebuf,entstem,etmp,sn3,sctx);
        }
    }
    // coreference (train only); v2 position (after rule 2d) in m0.
    // (Trigger flag from sctx[76]; fire-flag workaround as at m1 site.)
    if(mode==0 && is_probe==0){
        let trig1:i32=g32(sctx,76) as i32;
        let fire1:i32=0;
        if(trig1==1 && peid!=4294967295){
            copy_bytes(ebuf,0,pbuf,0,ppn);
            let c21:i32=0;
            while(c21<ppn_n){
                p32(entstem,c21*4,g32(pentstem,c21*4));
                c21=c21+1;
            }
            p32(sctx,36,ppn as i64);
            p32(sctx,40,ppn_n as i64);
            p32(sctx,48,1);
            p64(sctx,64,peid);
            fire1=1;
        }
        if(fire1==1){return peid;}
    }
    let eid2:i64=4294967295;
    p64(sctx,64,eid2);
    return eid2;
}

// frozen relation tagger: frozen phrase or sorted unique content stem-unit
// ids with entity stem-unit ids removed.
fn tag_relation(vbytes:[]u8,vent:[]u8,sbuf:[]u8,lowb:[]u8,toff:[]u8,tlen:[]u8,tsoff:[]u8,tslen:[]u8,tsuid:[]u8,tflags:[]u8,cpos:[]u8,stembuf:[]u8,sctx:[]u8,entstem:[]u8,relbuf:[]u8)void {
    if(phrase_scan(stembuf,tsoff,tslen,cpos,sctx,-1)==1){
        let ph:i32=g32(sctx,52) as i32;
        let ts:i32=g32(sctx,56) as i32;
        let cn:i32=g32(sctx,4) as i32;
        let ci:i32=0;
        while(ci<cn){
            if(g32(cpos,ci*4)==(ts as i64)){break;}
            ci=ci+1;
        }
        let pl:i32=ph_len(ph);
        let k:i32=0;
        while(k<pl){
            let tok:i32=g32(cpos,(ci+k)*4) as i32;
            p32(relbuf,k*4,g32(tsuid,tok*4));
            k=k+1;
        }
        isort32(relbuf,pl);
        p32(sctx,44,pl as i64);
        return;
    }
    p32(sctx,52,5);
    let cn2:i32=g32(sctx,4) as i32;
    let enn:i32=g32(sctx,40) as i32;
    let rn:i32=0;
    let ci2:i32=0;
    while(ci2<cn2){
        let tok2:i32=g32(cpos,ci2*4) as i32;
        let uid:i64=g32(tsuid,tok2*4);
        let skip:i32=0;
        let e:i32=0;
        while(e<enn){
            if(g32(entstem,e*4)==uid){skip=1;}
            e=e+1;
        }
        if(skip==0){
            let dup:i32=0;
            let r:i32=0;
            while(r<rn){
                if(g32(relbuf,r*4)==uid){dup=1;}
                r=r+1;
            }
            if(dup==0){
                p32(relbuf,rn*4,uid);
                rn=rn+1;
            }
        }
        ci2=ci2+1;
    }
    isort32(relbuf,rn);
    p32(sctx,44,rn as i64);
    return;
}

// frozen attitude: NEGATED beats HEDGE.
fn scan_attitude(sbuf:[]u8,toff:[]u8,tlen:[]u8,tsoff:[]u8,tslen:[]u8,tflags:[]u8,lowb:[]u8,stembuf:[]u8,sctx:[]u8)void {
    let ntok:i32=g32(sctx,0) as i32;
    let hedge:i32=0;
    let neg:i32=0;
    let n:i32=0;
    while(n<ntok){
        if(g32(tflags,n*4)==8){
            let so:i32=g32(tsoff,n*4) as i32;
            let sl:i32=g32(tslen,n*4) as i32;
            if(beq(stembuf,so,sl,"think")==1){hedge=1;}
            if(beq(stembuf,so,sl,"believe")==1){hedge=1;}
            if(beq(stembuf,so,sl,"probably")==1){hedge=1;}
            if(beq(stembuf,so,sl,"maybe")==1){hedge=1;}
            if(beq(stembuf,so,sl,"perhap")==1){hedge=1;}
            if(beq(stembuf,so,sl,"might")==1){hedge=1;}
            if(beq(stembuf,so,sl,"could")==1){hedge=1;}
            if(beq(stembuf,so,sl,"seem")==1){hedge=1;}
            if(beq(stembuf,so,sl,"allegedly")==1){hedge=1;}
            if(beq(stembuf,so,sl,"reportedly")==1){hedge=1;}
            if(beq(stembuf,so,sl,"possibly")==1){hedge=1;}
            if(beq(stembuf,so,sl,"likely")==1){hedge=1;}
            if(beq(stembuf,so,sl,"rumor")==1){hedge=1;}
            if(beq(stembuf,so,sl,"not")==1){neg=1;}
            if(beq(stembuf,so,sl,"never")==1){neg=1;}
            if(beq(stembuf,so,sl,"no")==1){neg=1;}
            if(beq(stembuf,so,sl,"t")==1 && n>0){
                let pl:i32=tok_low(sbuf,toff,tlen,lowb,n-1);
                if(beq(lowb,0,pl,"isn")==1){neg=1;}
                if(beq(lowb,0,pl,"don")==1){neg=1;}
                if(beq(lowb,0,pl,"can")==1){neg=1;}
                if(beq(lowb,0,pl,"won")==1){neg=1;}
            }
        }
        n=n+1;
    }
    let att:i32=0;
    if(hedge==1){att=1;}
    if(neg==1){att=2;}
    p32(sctx,72,att as i64);
    return;
}

// SHA-256 over the packed little-endian relation ids.
fn rel_hash(relbuf:[]u8,rel_n:i32,out32:[]u8)void {
    let tmp:[]u8=nio_alloc(rel_n*4);
    let k:i32=0;
    while(k<rel_n){
        p32(tmp,k*4,g32(relbuf,k*4));
        k=k+1;
    }
    let rc:i32=ns_sha256(tmp,out32);
    nio_free(tmp);
    return;
}

// exact store lookup by (eid, rel_hash).
fn row_find(row:[]u8,n:i32,rowsz:i32,eid:i64,rh:[]u8)i32 {
    let i:i32=0;
    while(i<n){
        let ro:i32=i*rowsz;
        if(g32(row,ro)==eid){
            if(beq2(row,ro+4,rh,0,32)==1){return i;}
        }
        i=i+1;
    }
    return -1;
}

// ---------------- ledger ----------------
// event row: prev32 || seq u64 || fact_id u32 || kind u8 || entity u32 ||
//   rel_hash32 || value i64 || attitude u8 || trace_len u32 || trace bytes.
// kind: 1=INSTALL 2=CORROBORATE 3=CONTRADICT 4=QUARANTINE 5=DENIAL 6=DERIVED.
fn ledger_add(lprev:[]u8,lg_kind:[]u8,lg_fid:[]u8,lg_eid:[]u8,lg_rel:[]u8,lg_val:[]u8,lg_att:[]u8,lg_troff:[]u8,lg_trlen:[]u8,lg_n:[]u8,trar:[]u8,kind:i64,fid:i64,eid:i64,rh:[]u8,val:i64,att:i64,trb:[]u8,trlen:i32)i64 {
    let seq:i64=g32(lg_n,0);
    let el:i32=32+8+4+1+4+32+8+1+4+trlen;
    let ent:[]u8=nio_alloc(el);
    copy_bytes(ent,0,lprev,0,32);
    p64(ent,32,seq);
    p32(ent,40,fid);
    ent[44]=kind as u8;
    p32(ent,45,eid);
    copy_bytes(ent,49,rh,0,32);
    p64(ent,81,val);
    ent[89]=att as u8;
    p32(ent,90,trlen as i64);
    copy_bytes(ent,94,trb,0,trlen);
    let eout:[]u8=nio_alloc(32);
    let rc:i32=ns_sha256(ent,eout);
    nio_free(ent);
    copy_bytes(lprev,0,eout,0,32);
    nio_free(eout);
    p32(lg_kind,(seq*4) as i32,kind);
    p32(lg_fid,(seq*4) as i32,fid);
    p32(lg_eid,(seq*4) as i32,eid);
    copy_bytes(lg_rel,(seq*32) as i32,rh,0,32);
    p64(lg_val,(seq*8) as i32,val);
    p32(lg_att,(seq*4) as i32,att);
    let tro:i32=g32(trar,0) as i32;
    p32(lg_troff,(seq*4) as i32,tro as i64);
    p32(lg_trlen,(seq*4) as i32,trlen as i64);
    copy_bytes(trar,tro,trb,0,trlen);
    p32(trar,0,(tro+trlen) as i64);
    p32(lg_n,0,seq+1);
    return seq;
}

// role-trace: ent=<eid>|rel=<r1>,<r2>|val=<vtok>|att=<a>|coref=<c>
fn build_trace(trb:[]u8,eid:i64,relbuf:[]u8,rel_n:i32,vtokb:[]u8,vtoklen:i32,att:i64,coref:i64)i32 {
    let n:i32=0;
    let nb:[]u8=nio_alloc(24);
    copy_bytes(trb,n,"ent=",0,4);n=n+4;
    let ln:i32=i64str(eid,nb);
    copy_bytes(trb,n,nb,0,ln);n=n+ln;
    copy_bytes(trb,n,"|rel=",0,5);n=n+5;
    let k:i32=0;
    while(k<rel_n){
        if(k>0){trb[n]=44;n=n+1;}
        let ln2:i32=i64str(g32(relbuf,k*4),nb);
        copy_bytes(trb,n,nb,0,ln2);n=n+ln2;
        k=k+1;
    }
    copy_bytes(trb,n,"|val=",0,5);n=n+5;
    copy_bytes(trb,n,vtokb,0,vtoklen);n=n+vtoklen;
    copy_bytes(trb,n,"|att=",0,5);n=n+5;
    let ln3:i32=i64str(att,nb);
    copy_bytes(trb,n,nb,0,ln3);n=n+ln3;
    copy_bytes(trb,n,"|coref=",0,7);n=n+7;
    let ln4:i32=i64str(coref,nb);
    copy_bytes(trb,n,nb,0,ln4);n=n+ln4;
    nio_free(nb);
    return n;
}

// derived role-trace: ent=<eid>|rel=<r1>,<r2>|val=derived|att=3|coref=0|rule=<rule>|prem=<yeid>:<n>
fn build_trace_derived(trb:[]u8,eid:i64,relbuf:[]u8,rel_n:i32,dir:i32,yeid:i64,n:i64)i32 {
    let nb:[]u8=nio_alloc(24);
    let l:i32=0;
    copy_bytes(trb,l,"ent=",0,4);l=l+4;
    let ln:i32=i64str(eid,nb);
    copy_bytes(trb,l,nb,0,ln);l=l+ln;
    copy_bytes(trb,l,"|rel=",0,5);l=l+5;
    let k:i32=0;
    while(k<rel_n){
        if(k>0){trb[l]=44;l=l+1;}
        let ln2:i32=i64str(g32(relbuf,k*4),nb);
        copy_bytes(trb,l,nb,0,ln2);l=l+ln2;
        k=k+1;
    }
    copy_bytes(trb,l,"|val=derived|att=3|coref=0",0,26);l=l+26;
    copy_bytes(trb,l,"|rule=",0,6);l=l+6;
    if(dir>0){copy_bytes(trb,l,"comes_after",0,11);l=l+11;}
    else{copy_bytes(trb,l,"comes_before",0,12);l=l+12;}
    copy_bytes(trb,l,"|prem=",0,6);l=l+6;
    let ln3:i32=i64str(yeid,nb);
    copy_bytes(trb,l,nb,0,ln3);l=l+ln3;
    trb[l]=58;l=l+1;
    let ln4:i32=i64str(n,nb);
    copy_bytes(trb,l,nb,0,ln4);l=l+ln4;
    nio_free(nb);
    return l;
}

// ---------------- per-sentence preparation ----------------
// runs classify + value + entity + relation + attitude; results in sctx.
fn prep_sentence(vbytes:[]u8,vent:[]u8,sbuf:[]u8,soff:i32,slen:i32,lowb:[]u8,stembuf:[]u8,linka:[]u8,toff:[]u8,tlen:[]u8,tsoff:[]u8,tslen:[]u8,tsuid:[]u8,tflags:[]u8,tval:[]u8,cpos:[]u8,vtokb:[]u8,sctx:[]u8,ebuf:[]u8,entstem:[]u8,etmp:[]u8,relbuf:[]u8,peid:i64,pbuf:[]u8,ppn:i32,pentstem:[]u8,ppn_n:i32,is_probe:i32,mode:i32)void {
    zero128(sctx);
    p32(stembuf,0,4);
    let ntok:i32=tok_classify(vbytes,vent,sbuf,soff,slen,lowb,stembuf,linka,toff,tlen,tsoff,tslen,tsuid,tflags,tval,cpos,sctx);
    scan_value(sbuf,toff,tlen,tflags,tval,lowb,vtokb,sctx);
    let eid:i64=tag_entity(vbytes,vent,sbuf,soff,slen,lowb,toff,tlen,tsoff,tslen,tsuid,tflags,cpos,stembuf,sctx,ebuf,entstem,etmp,peid,pbuf,ppn,pentstem,ppn_n,is_probe,mode);
    tag_relation(vbytes,vent,sbuf,lowb,toff,tlen,tsoff,tslen,tsuid,tflags,cpos,stembuf,sctx,entstem,relbuf);
    scan_attitude(sbuf,toff,tlen,tsoff,tslen,tflags,lowb,stembuf,sctx);
    return;
}

// ---------------- small print helpers ----------------
fn rname_out(rk:i32)void {
    if(rk==0){pr("alphabet_position");}
    else{
        if(rk==1){pr("letter_count");}
        else{
            if(rk==2){pr("publication_year");}
            else{
                if(rk==3){pr("comes_after");}
                else{
                    if(rk==4){pr("comes_before");}
                    else{pr("open");}
                }
            }
        }
    }
    return;
}
fn aname_out(a:i32)void {
    if(a==0){pr("asserted");}
    else{
        if(a==1){pr("hedged");}
        else{
            if(a==2){pr("negated");}
            else{pr("derived");}
        }
    }
    return;
}
fn ent_out(ebuf:[]u8,el:i32)void {
    if(el==0){pr("EMPTY");}
    else{prlen(ebuf,el);}
    return;
}

// ---------------- main ----------------
fn main()void {
    let src:[]u8=_zag_arg(1);
    let mstr:[]u8=_zag_arg(2);
    let mode:i32=0;
    if(beq(mstr,0,mstr.len,"m1")==1){mode=1;}
    else{
        if(beq(mstr,0,mstr.len,"m2")==1){mode=2;}
    }
    // m0 prints the v2 header byte-identically (proof gate (a)); m1/m2
    // identify as PROSE-LEARN3 with the mode.
    if(mode==0){
        pr("PROSE-LEARN2 source=");
        prl(src);
    }
    else{
        pr("PROSE-LEARN3 source=");
        pr(src);
        if(mode==1){prl(" mode=m1");}
        else{prl(" mode=m2");}
    }
    // arenas
    let vbytes:[]u8=nio_alloc(2097152);
    let vent:[]u8=nio_alloc(262152);
    let linka:[]u8=nio_alloc(262144);
    let lowb:[]u8=nio_alloc(256);
    let stembuf:[]u8=nio_alloc(32768);
    let toff:[]u8=nio_alloc(1024);
    let tlen:[]u8=nio_alloc(1024);
    let tsoff:[]u8=nio_alloc(1024);
    let tslen:[]u8=nio_alloc(1024);
    let tsuid:[]u8=nio_alloc(1024);
    let tflags:[]u8=nio_alloc(1024);
    let tval:[]u8=nio_alloc(2048);
    let cpos:[]u8=nio_alloc(1024);
    let vtokb:[]u8=nio_alloc(64);
    let sctx:[]u8=nio_alloc(128);
    let ebuf:[]u8=nio_alloc(4096);
    let entstem:[]u8=nio_alloc(256);
    let etmp:[]u8=nio_alloc(256);
    let relbuf:[]u8=nio_alloc(256);
    let rh32:[]u8=nio_alloc(32);
    let trscratch:[]u8=nio_alloc(2048);
    let tcanon:[]u8=nio_alloc(512);
    let a_row:[]u8=nio_alloc(1310720);
    let a_n:[]u8=nio_alloc(4);
    let q_row:[]u8=nio_alloc(49152);
    let q_n:[]u8=nio_alloc(4);
    let d_row:[]u8=nio_alloc(49152);
    let d_n:[]u8=nio_alloc(4);
    let lg_kind:[]u8=nio_alloc(32768);
    let lg_fid:[]u8=nio_alloc(32768);
    let lg_eid:[]u8=nio_alloc(32768);
    let lg_rel:[]u8=nio_alloc(262144);
    let lg_val:[]u8=nio_alloc(65536);
    let lg_att:[]u8=nio_alloc(32768);
    let lg_troff:[]u8=nio_alloc(32768);
    let lg_trlen:[]u8=nio_alloc(32768);
    let lg_n:[]u8=nio_alloc(4);
    let trar:[]u8=nio_alloc(1048576);
    let lprev:[]u8=nio_alloc(32);
    let cx:[]u8=nio_alloc(2048);
    let cy:[]u8=nio_alloc(2048);
    let cdir:[]u8=nio_alloc(2048);
    let cfid:[]u8=nio_alloc(2048);
    let cxc:[]u8=nio_alloc(32768);
    let cxcl:[]u8=nio_alloc(2048);
    let cyc:[]u8=nio_alloc(32768);
    let cycl:[]u8=nio_alloc(2048);
    let comes_n:[]u8=nio_alloc(4);
    let alphahash:[]u8=nio_alloc(32);
    let din:[]u8=nio_alloc(36896);
    // v3 change 2 (m2): parallel tier-3 key arena, one entry per asserted
    // row (cap 4096 rows): u32 count + up to 64 u32 stem uids, stride 260.
    // tktmp is scratch for key construction.
    let skeys:[]u8=nio_alloc(1064960);
    let tktmp:[]u8=nio_alloc(1024);
    p32(vbytes,0,8);
    p32(vent,0,0);
    p32(linka,0,4);
    p32(trar,0,4);
    p32(a_n,0,0);
    p32(q_n,0,0);
    p32(d_n,0,0);
    p32(lg_n,0,0);
    p32(comes_n,0,0);
    let zi:i32=0;
    while(zi<32){lprev[zi]=0;zi=zi+1;}
    // false ids
    let fpath:[]u8=mkpath("inputs/false_ids_",src,".txt");
    let fb:[]u8=read_all(fpath);
    nio_free(fpath);
    let fids:[]u8=nio_alloc(32768);
    let nf:i32=0;
    let fi:i32=0;
    while(fi<fb.len){
        let fc:u8=fb[fi];
        if(fc>=48 && fc<=57){
            let fv:i64=0;
            while(fi<fb.len && fb[fi]>=48 && fb[fi]<=57){
                fv=fv*10+((fb[fi] as i64)-48);
                fi=fi+1;
            }
            p32(fids,nf*4,fv);
            nf=nf+1;
        }
        else{fi=fi+1;}
    }
    // counters
    let ninstall:i32=0;
    let ncorrob:i32=0;
    let ncontra:i32=0;
    let nquar:i32=0;
    let nden:i32=0;
    let nderived:i32=0;
    let nfail:i32=0;
    // train
    let tpath:[]u8=mkpath("inputs/train_",src,".txt");
    let tb:[]u8=read_all(tpath);
    nio_free(tpath);
    let peid:i64=4294967295;
    let pbuf:[]u8=nio_alloc(4096);
    let ppn:i32=0;
    let pentstem:[]u8=nio_alloc(256);
    let ppn_n:i32=0;
    let pos:i32=0;
    while(pos<tb.len){
        let le:i32=pos;
        while(le<tb.len && tb[le]!=10){le=le+1;}
        let f1:i32=pos;
        while(f1<le && tb[f1]!=9){f1=f1+1;}
        let fid:i64=parse_int(tb,pos,f1-pos);
        // train lines: fid \t text  (no probe_value column)
        // coreference is per-item: reset the previous-sentence entity here.
        peid=4294967295;
        ppn=0;
        ppn_n=0;
        let t0:i32=f1+1;
        if(t0>le){t0=le;}
        let seg:i32=t0;
        let s:i32=0;
        let k2:i32=t0;
        while(k2<=le){
            let isend:i32=0;
            if(k2==le){isend=1;}
            else{
                let cc:u8=tb[k2];
                if(cc==46 || cc==63 || cc==33){isend=1;}
            }
            if(isend==1){
                let a2:i32=seg;
                let b2:i32=k2;
                while(a2<b2 && tb[a2]==32){a2=a2+1;}
                while(b2>a2 && tb[b2-1]==32){b2=b2-1;}
                if(b2>a2){
                    prep_sentence(vbytes,vent,tb,a2,b2-a2,lowb,stembuf,linka,toff,tlen,tsoff,tslen,tsuid,tflags,tval,cpos,vtokb,sctx,ebuf,entstem,etmp,relbuf,peid,pbuf,ppn,pentstem,ppn_n,0,mode);
                    let ok:i32=g32(sctx,80) as i32;
                    let val:i64=g64(sctx,88);
                    let eid:i64=g64(sctx,64);
                    let att:i32=g32(sctx,72) as i32;
                    let relkind:i32=g32(sctx,52) as i32;
                    let rel_n:i32=g32(sctx,44) as i32;
                    let coref:i32=g32(sctx,48) as i32;
                    let ent_len:i32=g32(sctx,36) as i32;
                    let ent_n:i32=g32(sctx,40) as i32;
                    let vtoklen:i32=g32(sctx,32) as i32;
                    rel_hash(relbuf,rel_n,rh32);
                    if((relkind==3 || relkind==4) && att==0){
                        let cn:i32=g32(sctx,4) as i32;
                        let ts2:i32=g32(sctx,56) as i32;
                        let ci:i32=0;
                        while(ci<cn){
                            if(g32(cpos,ci*4)==(ts2 as i64)){break;}
                            ci=ci+1;
                        }
                        let tcl:i32=0;
                        let tc2:i32=0;
                        let kk:i32=ci+2;
                        while(kk<cn && tc2<4){
                            let tok:i32=g32(cpos,kk*4) as i32;
                            let tl:i32=tok_low(tb,toff,tlen,lowb,tok);
                            if(tc2>0){tcanon[tcl]=32;tcl=tcl+1;}
                            let m:i32=0;
                            while(m<tl){tcanon[tcl]=lowb[m];tcl=tcl+1;m=m+1;}
                            tc2=tc2+1;
                            kk=kk+1;
                        }
                        if(tc2>0){
                            let yeid:i64=v_intern(vbytes,vent,tcanon,0,tcl) as i64;
                            let ccn:i32=g32(comes_n,0) as i32;
                            p32(cx,ccn*4,eid);
                            p32(cy,ccn*4,yeid);
                            if(relkind==3){p32(cdir,ccn*4,1);}
                            else{p32(cdir,ccn*4,0);}
                            p32(cfid,ccn*4,fid);
                            p32(cxcl,ccn*4,ent_len as i64);
                            copy_bytes(cxc,ccn*64,ebuf,0,ent_len);
                            p32(cycl,ccn*4,tcl as i64);
                            copy_bytes(cyc,ccn*64,tcanon,0,tcl);
                            p32(comes_n,0,(ccn+1) as i64);
                        }
                    }
                    if(ok==0){
                        pr("EXTRACT-FAIL id=");prn(fid);pr(" sent=");prn(s as i64);prl("");
                        nfail=nfail+1;
                    }
                    else{
                        if(att==0){
                            let an:i32=g32(a_n,0) as i32;
                            let idx:i32=row_find(a_row,an,320,eid,rh32);
                            let trlen:i32=build_trace(trscratch,eid,relbuf,rel_n,vtokb,vtoklen,0,coref as i64);
                            if(idx<0){
                                let ro:i32=an*320;
                                p32(a_row,ro,eid);
                                copy_bytes(a_row,ro+4,rh32,0,32);
                                p64(a_row,ro+36,val);
                                p32(a_row,ro+44,0);
                                p32(a_row,ro+48,fid);
                                p32(a_row,ro+56,rel_n as i64);
                                let rk2:i32=0;
                                while(rk2<rel_n){
                                    p32(a_row,ro+60+rk2*4,g32(relbuf,rk2*4));
                                    rk2=rk2+1;
                                }
                                let sq:i64=ledger_add(lprev,lg_kind,lg_fid,lg_eid,lg_rel,lg_val,lg_att,lg_troff,lg_trlen,lg_n,trar,1,fid,eid,rh32,val,0,trscratch,trlen);
                                p32(a_row,ro+52,sq);
                                p32(a_n,0,(an+1) as i64);
                                if(mode==2){
                                    t3_store(skeys,an,cpos,tsuid,g32(sctx,4) as i32,tktmp);
                                }
                                pr("INSTALL id=");prn(fid);pr(" sent=");prn(s as i64);pr(" entity=");ent_out(ebuf,ent_len);pr(" relation=");rname_out(relkind);pr(" reln=");prn(rel_n as i64);pr(" attitude=");aname_out(0);pr(" value=");prn(val);pr(" key=");prn(eid);pr(":");prhex(rh32,0,4);pr(" seq=");prn(sq);prl("");
                                ninstall=ninstall+1;
                            }
                            else{
                                let ro2:i32=idx*320;
                                let stat:i32=g32(a_row,ro2+44) as i32;
                                let oldv:i64=g64(a_row,ro2+36);
                                if(stat==0 && oldv==val){
                                    let sq2:i64=ledger_add(lprev,lg_kind,lg_fid,lg_eid,lg_rel,lg_val,lg_att,lg_troff,lg_trlen,lg_n,trar,2,fid,eid,rh32,val,0,trscratch,trlen);
                                    pr("CORROBORATE id=");prn(fid);pr(" sent=");prn(s as i64);pr(" key=");prn(eid);pr(":");prhex(rh32,0,4);pr(" attitude=");aname_out(0);pr(" seq=");prn(sq2);prl("");
                                    ncorrob=ncorrob+1;
                                }
                                else{
                                    if(stat==0){
                                        p32(a_row,ro2+44,1);
                                        let sq3:i64=ledger_add(lprev,lg_kind,lg_fid,lg_eid,lg_rel,lg_val,lg_att,lg_troff,lg_trlen,lg_n,trar,3,fid,eid,rh32,val,0,trscratch,trlen);
                                        pr("CONTRADICT id=");prn(fid);pr(" sent=");prn(s as i64);pr(" key=");prn(eid);pr(":");prhex(rh32,0,4);pr(" attitude=");aname_out(0);pr(" old=");prn(oldv);pr(" new=");prn(val);pr(" seq=");prn(sq3);prl("");
                                        ncontra=ncontra+1;
                                    }
                                }
                            }
                        }
                        else{
                            if(att==1){
                                let qn:i32=g32(q_n,0) as i32;
                                let qi:i32=row_find(q_row,qn,48,eid,rh32);
                                if(qi<0){
                                    let qo:i32=qn*48;
                                    p32(q_row,qo,eid);
                                    copy_bytes(q_row,qo+4,rh32,0,32);
                                    p64(q_row,qo+36,val);
                                    p32(q_row,qo+44,fid);
                                    p32(q_n,0,(qn+1) as i64);
                                }
                                let trlen2:i32=build_trace(trscratch,eid,relbuf,rel_n,vtokb,vtoklen,1,coref as i64);
                                let sq4:i64=ledger_add(lprev,lg_kind,lg_fid,lg_eid,lg_rel,lg_val,lg_att,lg_troff,lg_trlen,lg_n,trar,4,fid,eid,rh32,val,1,trscratch,trlen2);
                                pr("QUARANTINE id=");prn(fid);pr(" sent=");prn(s as i64);pr(" entity=");ent_out(ebuf,ent_len);pr(" relation=");rname_out(relkind);pr(" reln=");prn(rel_n as i64);pr(" value=");prn(val);pr(" key=");prn(eid);pr(":");prhex(rh32,0,4);pr(" seq=");prn(sq4);prl("");
                                nquar=nquar+1;
                            }
                            else{
                                let dn:i32=g32(d_n,0) as i32;
                                let di:i32=row_find(d_row,dn,48,eid,rh32);
                                if(di<0){
                                    let doff:i32=dn*48;
                                    p32(d_row,doff,eid);
                                    copy_bytes(d_row,doff+4,rh32,0,32);
                                    p64(d_row,doff+36,val);
                                    p32(d_row,doff+44,fid);
                                    p32(d_n,0,(dn+1) as i64);
                                }
                                let trlen3:i32=build_trace(trscratch,eid,relbuf,rel_n,vtokb,vtoklen,2,coref as i64);
                                let sq5:i64=ledger_add(lprev,lg_kind,lg_fid,lg_eid,lg_rel,lg_val,lg_att,lg_troff,lg_trlen,lg_n,trar,5,fid,eid,rh32,val,2,trscratch,trlen3);
                                pr("DENIAL id=");prn(fid);pr(" sent=");prn(s as i64);pr(" entity=");ent_out(ebuf,ent_len);pr(" relation=");rname_out(relkind);pr(" reln=");prn(rel_n as i64);pr(" value=");prn(val);pr(" key=");prn(eid);pr(":");prhex(rh32,0,4);pr(" seq=");prn(sq5);prl("");
                                nden=nden+1;
                            }
                        }
                    }
                    peid=eid;
                    ppn=ent_len;
                    copy_bytes(pbuf,0,ebuf,0,ent_len);
                    ppn_n=ent_n;
                    let ec:i32=0;
                    while(ec<ent_n){
                        p32(pentstem,ec*4,g32(entstem,ec*4));
                        ec=ec+1;
                    }
                    s=s+1;
                }
                seg=k2+1;
            }
            k2=k2+1;
        }
        pos=le+1;
    }
    // ---- inference fixpoint (chained comes-after/before) ----
    let ua:i64=v_intern(vbytes,vent,"alphabet",0,8) as i64;
    let up:i64=v_intern(vbytes,vent,"position",0,8) as i64;
    let relbuf_ab:[]u8=nio_alloc(8);
    if(ua<up){p32(relbuf_ab,0,ua);p32(relbuf_ab,4,up);}
    else{p32(relbuf_ab,0,up);p32(relbuf_ab,4,ua);}
    rel_hash(relbuf_ab,2,alphahash);
    let cout:[]u8=nio_alloc(64);
    let changed:i32=1;
    while(changed==1){
        changed=0;
        let ccn2:i32=g32(comes_n,0) as i32;
        let c:i32=0;
        while(c<ccn2){
            let xeid:i64=g32(cx,c*4);
            let yeid:i64=g32(cy,c*4);
            let dd:i32=-1;
            if(g32(cdir,c*4)==1){dd=1;}
            let cfid:i64=g32(cfid,c*4);
            let xcl:i32=g32(cxcl,c*4) as i32;
            let an2:i32=g32(a_n,0) as i32;
            let pi:i32=row_find(a_row,an2,320,yeid,alphahash);
            if(pi>=0 && g32(a_row,pi*320+44)==0){
                let nn:i64=g64(a_row,pi*320+36);
                let vv:i64=nn+(dd as i64);
                let trl:i32=build_trace_derived(trscratch,xeid,relbuf_ab,2,dd,yeid,nn);
                let j:i32=row_find(a_row,an2,320,xeid,alphahash);
                if(j<0){
                    let ro:i32=an2*320;
                    p32(a_row,ro,xeid);
                    copy_bytes(a_row,ro+4,alphahash,0,32);
                    p64(a_row,ro+36,vv);
                    p32(a_row,ro+44,0);
                    p32(a_row,ro+48,cfid);
                    p32(a_row,ro+56,2);
                    p32(a_row,ro+60,g32(relbuf_ab,0));
                    p32(a_row,ro+64,g32(relbuf_ab,4));
                    let sq:i64=ledger_add(lprev,lg_kind,lg_fid,lg_eid,lg_rel,lg_val,lg_att,lg_troff,lg_trlen,lg_n,trar,6,cfid,xeid,alphahash,vv,3,trscratch,trl);
                    p32(a_row,ro+52,sq);
                    p32(a_n,0,(an2+1) as i64);
                    if(mode==2){
                        // derived rows carry no sentence key: count=0, so
                        // tier-3 can never match them (union>0, inter=0).
                        p32(skeys,an2*260,0);
                    }
                    copy_bytes(cout,0,cxc,c*64,xcl);
                    pr("DERIVED id=");prn(cfid);pr(" rule=");
                    if(dd>0){pr("comes_after");}else{pr("comes_before");}
                    pr(" entity=");prlen(cout,xcl);pr(" prem=");prn(yeid);pr(":");prn(nn);pr(" value=");prn(vv);pr(" seq=");prn(sq);prl("");
                    nderived=nderived+1;
                    changed=1;
                }
                else{
                    let ro2:i32=j*320;
                    let stat:i32=g32(a_row,ro2+44) as i32;
                    let oldv:i64=g64(a_row,ro2+36);
                    if(stat==0 && oldv==vv){
                        let sq2:i64=ledger_add(lprev,lg_kind,lg_fid,lg_eid,lg_rel,lg_val,lg_att,lg_troff,lg_trlen,lg_n,trar,2,cfid,xeid,alphahash,vv,3,trscratch,trl);
                        pr("CORROBORATE id=");prn(cfid);pr(" sent=-1 key=");prn(xeid);pr(":");prhex(alphahash,0,4);pr(" attitude=derived seq=");prn(sq2);prl("");
                        ncorrob=ncorrob+1;
                    }
                    else{
                        if(stat==0){
                            p32(a_row,ro2+44,1);
                            let sq3:i64=ledger_add(lprev,lg_kind,lg_fid,lg_eid,lg_rel,lg_val,lg_att,lg_troff,lg_trlen,lg_n,trar,3,cfid,xeid,alphahash,vv,3,trscratch,trl);
                            pr("CONTRADICT id=");prn(cfid);pr(" sent=-1 key=");prn(xeid);pr(":");prhex(alphahash,0,4);pr(" attitude=derived old=");prn(oldv);pr(" new=");prn(vv);pr(" seq=");prn(sq3);prl("");
                            ncontra=ncontra+1;
                            changed=1;
                        }
                    }
                }
            }
            c=c+1;
        }
    }
    // ---- probe loop ----
    let ppath:[]u8=mkpath("inputs/test_",src,".txt");
    let pb:[]u8=read_all(ppath);
    nio_free(ppath);
    let nprobe:i32=0;
    let nfull:i32=0;
    let nclean:i32=0;
    let dpos:i32=0;
    let vbuf:[]u8=nio_alloc(64);
    let wbuf:[]u8=nio_alloc(64);
    let pos2:i32=0;
    while(pos2<pb.len){
        let le:i32=pos2;
        while(le<pb.len && pb[le]!=10){le=le+1;}
        let q1:i32=pos2;
        while(q1<le && pb[q1]!=9){q1=q1+1;}
        let q2:i32=q1+1;
        while(q2<le && pb[q2]!=9){q2=q2+1;}
        let q3:i32=q2+1;
        while(q3<le && pb[q3]!=9){q3=q3+1;}
        let pid:i64=parse_int(pb,pos2,q1-pos2);
        let p0:i32=q2+1;
        let p1:i32=q3;
        if(p1>le){p1=le;}
        let e0:i32=q1+1;
        let e1:i32=q2;
        if(q3<le){e0=q3+1;e1=le;}
        prep_sentence(vbytes,vent,pb,p0,p1-p0,lowb,stembuf,linka,toff,tlen,tsoff,tslen,tsuid,tflags,tval,cpos,vtokb,sctx,ebuf,entstem,etmp,relbuf,peid,pbuf,ppn,pentstem,ppn_n,1,mode);
        let eid:i64=g64(sctx,64);
        let relkind:i32=g32(sctx,52) as i32;
        let rel_n:i32=g32(sctx,44) as i32;
        let ent_len:i32=g32(sctx,36) as i32;
        rel_hash(relbuf,rel_n,rh32);
        let an3:i32=g32(a_n,0) as i32;
        let vcode:i32=-1;
        let vval:i64=0;
        let ties:i32=0;
        let idx:i32=row_find(a_row,an3,320,eid,rh32);
        if(idx>=0 && g32(a_row,idx*320+44)==0){
            vcode=0;
            vval=g64(a_row,idx*320+36);
            ties=1;
        }
        else{
            if(idx>=0){vcode=1;}
            else{
                if(row_find(q_row,g32(q_n,0) as i32,48,eid,rh32)>=0){vcode=2;}
                else{
                    if(row_find(d_row,g32(d_n,0) as i32,48,eid,rh32)>=0){vcode=3;}
                    else{
                        let bi:i64=-1;
                        let bu:i64=1;
                        let bfid:i64=0;
                        let bv:i64=0;
                        let ntie:i32=0;
                        let r:i32=0;
                        while(r<an3){
                            let ro:i32=r*320;
                            if(g32(a_row,ro+44)==0){
                                let feid:i64=g32(a_row,ro);
                                let take:i32=0;
                                if(eid==4294967295){take=1;}
                                else{
                                    if(feid==eid){take=1;}
                                }
                                if(take==1){
                                    let frn:i32=g32(a_row,ro+56) as i32;
                                    let pp:i32=0;
                                    let qq:i32=0;
                                    let inter:i32=0;
                                    while(pp<rel_n && qq<frn){
                                        let av:i64=g32(relbuf,pp*4);
                                        let bvv:i64=g32(a_row,ro+60+qq*4);
                                        if(av==bvv){inter=inter+1;pp=pp+1;qq=qq+1;}
                                        else{
                                            if(av<bvv){pp=pp+1;}
                                            else{qq=qq+1;}
                                        }
                                    }
                                    let union:i32=rel_n+frn-inter;
                                    let go2:i32=1;
                                    if(eid==4294967295){
                                        if(union<=0 || 2*inter<union){go2=0;}
                                    }
                                    if(go2==1){
                                        let ffid:i64=g32(a_row,ro+48);
                                        let fval:i64=g64(a_row,ro+36);
                                        if(bi<0){
                                            bi=inter as i64;bu=union as i64;bfid=ffid;bv=fval;ntie=1;
                                        }
                                        else{
                                            let lhs:i64=(inter as i64)*bu;
                                            let rhs:i64=bi*(union as i64);
                                            if(lhs>rhs){
                                                bi=inter as i64;bu=union as i64;bfid=ffid;bv=fval;ntie=1;
                                            }
                                            else{
                                                if(lhs==rhs){
                                                    if(ffid<bfid){
                                                        bi=inter as i64;bu=union as i64;bfid=ffid;bv=fval;ntie=1;
                                                    }
                                                    else{ntie=ntie+1;}
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            r=r+1;
                        }
                        if(bi<0){
                            // v3 change 2 (m2 only): KEYSOFT tier-3 probe
                            // fallback. Sentence-level Jaccard over LIVE
                            // asserted rows only (status==0); contradicted /
                            // quarantine / denial rows never yield VALUE.
                            if(mode==2){
                                let pu:i32=t3_key(tktmp,cpos,tsuid,g32(sctx,4) as i32);
                                let t3bi:i64=-1;
                                let t3bu:i64=1;
                                let t3bfid:i64=0;
                                let t3bv:i64=0;
                                let t3ntie:i32=0;
                                let rr:i32=0;
                                while(rr<an3){
                                    let rro:i32=rr*320;
                                    if(g32(a_row,rro+44)==0){
                                        let rcount:i32=g32(skeys,rr*260) as i32;
                                        let rbase:i32=rr*260+4;
                                        let qa:i32=0;
                                        let qb:i32=0;
                                        let i3:i32=0;
                                        while(qa<pu && qb<rcount){
                                            let va3:i64=g32(tktmp,qa*4);
                                            let vb3:i64=g32(skeys,rbase+qb*4);
                                            if(va3==vb3){i3=i3+1;qa=qa+1;qb=qb+1;}
                                            else{
                                                if(va3<vb3){qa=qa+1;}
                                                else{qb=qb+1;}
                                            }
                                        }
                                        let u3:i32=pu+rcount-i3;
                                        if(u3>0 && 2*i3>=u3){
                                            let ff3:i64=g32(a_row,rro+48);
                                            let fv3:i64=g64(a_row,rro+36);
                                            if(t3bi<0){
                                                t3bi=i3 as i64;t3bu=u3 as i64;t3bfid=ff3;t3bv=fv3;t3ntie=1;
                                            }
                                            else{
                                                let lh3:i64=(i3 as i64)*t3bu;
                                                let rh3:i64=t3bi*(u3 as i64);
                                                if(lh3>rh3){
                                                    t3bi=i3 as i64;t3bu=u3 as i64;t3bfid=ff3;t3bv=fv3;t3ntie=1;
                                                }
                                                else{
                                                    if(lh3==rh3){
                                                        if(ff3<t3bfid){
                                                            t3bi=i3 as i64;t3bu=u3 as i64;t3bfid=ff3;t3bv=fv3;t3ntie=1;
                                                        }
                                                        else{t3ntie=t3ntie+1;}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    rr=rr+1;
                                }
                                if(t3bi<0){vcode=3;}
                                else{vcode=0;vval=t3bv;ties=t3ntie;}
                            }
                            else{vcode=3;}
                        }
                        else{vcode=0;vval=bv;ties=ntie;}
                    }
                }
            }
        }
        // verdict bytes vs want bytes
        let vbl:i32=0;
        if(vcode==0){
            copy_bytes(vbuf,0,"VALUE:",0,6);vbl=6;
            let nb:[]u8=nio_alloc(24);
            let ln:i32=i64str(vval,nb);
            copy_bytes(vbuf,vbl,nb,0,ln);vbl=vbl+ln;
            nio_free(nb);
        }
        else{
            if(vcode==1){copy_bytes(vbuf,0,"CONTRADICTION",0,13);vbl=13;}
            else{
                if(vcode==2){copy_bytes(vbuf,0,"HEDGED",0,6);vbl=6;}
                else{copy_bytes(vbuf,0,"UNKNOWN",0,7);vbl=7;}
            }
        }
        let elen:i32=e1-e0;
        let isdig:i32=1;
        if(elen==0){isdig=0;}
        else{
            let st:i32=e0;
            if(pb[e0]==45){
                if(elen==1){isdig=0;}
                st=e0+1;
            }
            let dd2:i32=st;
            while(dd2<e1){
                if(pb[dd2]<48 || pb[dd2]>57){isdig=0;}
                dd2=dd2+1;
            }
        }
        let wbl:i32=0;
        if(isdig==1){
            copy_bytes(wbuf,0,"VALUE:",0,6);wbl=6;
            copy_bytes(wbuf,wbl,pb,e0,elen);wbl=wbl+elen;
        }
        else{
            copy_bytes(wbuf,0,pb,e0,elen);wbl=elen;
        }
        let okp:i32=0;
        if(vbl==wbl && beq2(vbuf,0,wbuf,0,vbl)==1){okp=1;}
        let isf:i32=0;
        let fx:i32=0;
        while(fx<nf){
            if(g32(fids,fx*4)==pid){isf=1;}
            fx=fx+1;
        }
        pr("PROBE id=");prn(pid);pr(" verdict=");prlen(vbuf,vbl);pr(" expected=");
        copy_bytes(cout,0,pb,e0,elen);
        prlen(cout,elen);
        pr(" ok=");prn(okp as i64);pr(" entity=");ent_out(ebuf,ent_len);pr(" relation=");rname_out(relkind);pr(" reln=");prn(rel_n as i64);pr(" attitude=ignored ties=");prn(ties as i64);prl("");
        din[dpos]=vcode as u8;
        dpos=dpos+1;
        if(vcode==0){
            p64(din,dpos,vval);
            dpos=dpos+8;
        }
        nprobe=nprobe+1;
        if(okp==1){nfull=nfull+1;}
        if(isf==0 && okp==1){nclean=nclean+1;}
        pos2=le+1;
    }
    // ---- digest + verify + summary ----
    copy_bytes(din,dpos,lprev,0,32);
    dpos=dpos+32;
    let din2:[]u8=nio_alloc(dpos);
    copy_bytes(din2,0,din,0,dpos);
    let d1:[]u8=nio_alloc(32);
    let d2:[]u8=nio_alloc(32);
    let rc1:i32=ns_sha256(din2,d1);
    let rc2:i32=ns_sha256(din2,d2);
    nio_free(din2);
    let dm:i32=0;
    if(beq2(d1,0,d2,0,32)==1){dm=1;}
    let vp:[]u8=nio_alloc(32);
    let vz:i32=0;
    while(vz<32){vp[vz]=0;vz=vz+1;}
    let sqn:i32=0;
    let lgn:i32=g32(lg_n,0) as i32;
    while(sqn<lgn){
        let vkind:i64=g32(lg_kind,sqn*4);
        let vfid:i64=g32(lg_fid,sqn*4);
        let veid:i64=g32(lg_eid,sqn*4);
        let vval2:i64=g64(lg_val,sqn*8);
        let vatt:i64=g32(lg_att,sqn*4);
        let vtro:i32=g32(lg_troff,sqn*4) as i32;
        let vtrl:i32=g32(lg_trlen,sqn*4) as i32;
        let vel:i32=94+vtrl;
        let vent2:[]u8=nio_alloc(vel);
        copy_bytes(vent2,0,vp,0,32);
        p64(vent2,32,sqn as i64);
        p32(vent2,40,vfid);
        vent2[44]=vkind as u8;
        p32(vent2,45,veid);
        copy_bytes(vent2,49,lg_rel,sqn*32,32);
        p64(vent2,81,vval2);
        vent2[89]=vatt as u8;
        p32(vent2,90,vtrl as i64);
        copy_bytes(vent2,94,trar,vtro,vtrl);
        let veo:[]u8=nio_alloc(32);
        let rc3:i32=ns_sha256(vent2,veo);
        nio_free(vent2);
        copy_bytes(vp,0,veo,0,32);
        nio_free(veo);
        sqn=sqn+1;
    }
    let chain:i32=0;
    if(beq2(vp,0,lprev,0,32)==1){chain=1;}
    let ncl:i32=nprobe-nf;
    pr("SUMMARY ninstall=");prn(ninstall as i64);pr(" ncorroborate=");prn(ncorrob as i64);pr(" ncontradict=");prn(ncontra as i64);pr(" nquarantine=");prn(nquar as i64);pr(" ndenial=");prn(nden as i64);pr(" nderived=");prn(nderived as i64);pr(" nfail=");prn(nfail as i64);pr(" nprobe=");prn(nprobe as i64);pr(" full=");prn(nfull as i64);pr("/");prn(nprobe as i64);pr(" clean=");prn(nclean as i64);pr("/");prn(ncl as i64);prl("");
    pr("DIGEST ");prhex(d1,0,32);prl("");
    pr("DIGEST2 ");prhex(d2,0,32);prl("");
    pr("LEDGER ");prhex(lprev,0,32);prl("");
    pr("VERIFY chain=");prn(chain as i64);pr(" dmatch=");prn(dm as i64);prl("");
    pr("RESULT ");
    if(chain==1 && dm==1){prl("PASS");}
    else{prl("FAIL");}
    return;
}

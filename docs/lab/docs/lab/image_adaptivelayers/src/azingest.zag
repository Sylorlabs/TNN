// tlingest.zag — TNN-CHOOSES-ITS-LAYERS ingest: survey -> deliberate ->
// cascade with commit/revert -> renders + knowmap + deliberation trace.
// Micah order 2026-09-26 ~09:54 PDT.
//
// TNN's deliberation (deterministic, recorded in DELIBTRACE.txt):
//   SURVEY: flat-block energies per scale; Sobel edge/run analysis
//     (straight vs curvy boundary pixels).
//   AFFINITIES (per-mille, data-derived):
//     SMOOTH = 1000*(Etot-E64)/Etot      (coarse-smooth share)
//     LINES  = 1000*straight_px/npix      (straight-boundary density)
//     SHAPES = 1000*(E64-E4)/Etot         (mid-scale structure share)
//   ORDER = descending affinity, ties -> SMOOTH,LINES,SHAPES.
//   CASCADE: each candidate runs on the current residual; COMMIT iff its
//     measured G/N >= 9 (per-value-9 precision precedent), else REVERT.
// argv: 1=indir 2=outdir 3=knowmap_name 4=renderA_name
@import("./azlayers.zag")

fn tab_puts(b:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { b[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn tab_puti(b:[]u8, o:i64, v:i64) i64 {
    if (v < 0) { b[o] = 45; o = o + 1; v = 0 - v; }
    let t:[]u8 = _zag_i64_to_str(v);
    let i:i64 = 0;
    while (i < t.len) { b[o + i] = t[i]; i = i + 1; }
    return o + t.len;
}
fn layer_name(id:i64, b:[]u8, o:i64) i64 {
    if (id == 1) { return tab_puts(b, o, "SMOOTH (adaptive CART mean+planar)"); }
    if (id == 2) { return tab_puts(b, o, "LINES (straight segments)"); }
    return tab_puts(b, o, "SHAPES-ZOOM (adaptive partition + magnification)");
}

fn main() i32 {
    let ind:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    let kmapname:[]u8 = _zag_arg(3);
    let ra_name:[]u8 = _zag_arg(4);
    if (_zag_strcmp(ind, "") == 1) { ind = "."; }
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    if (_zag_strcmp(kmapname, "") == 1) { kmapname = "knowmap.bin"; }
    if (_zag_strcmp(ra_name, "") == 1) { ra_name = "renderA.bmp"; }

    let root:i64 = nio_open_root(ind);
    if (root < 0) { _zag_println("cannot open indir"); return 1; }
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { _zag_println("cannot open outdir"); nio_close(root); return 1; }
    // ---- load BMP ----
    let fd:i64 = nio_open_child(root, "original_512.bmp", 0);
    if (fd < 0) { _zag_println("cannot open input"); nio_close(root); return 1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { _zag_println("alloc failed"); nio_close(fd); nio_close(root); return 1; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 54) { _zag_println("short file"); return 1; }
    if (fbuf[0] != 66) { _zag_println("not BM"); return 1; }
    if (fbuf[1] != 77) { _zag_println("not BM"); return 1; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    if (r_u16le(fbuf, 28) != 24) { _zag_println("need 24bpp"); return 1; }
    if (r_u32le(fbuf, 30) != 0) { _zag_println("need uncompressed"); return 1; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let npix:i64 = w * h;
    let orig:[]u8 = nio_alloc((npix * 3) as i32);
    if (orig.len == 0) { _zag_println("alloc orig failed"); return 1; }
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            orig[p] = fbuf[q + 2];
            orig[p + 1] = fbuf[q + 1];
            orig[p + 2] = fbuf[q];
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fbuf);
    // i64 working image (the cascade space)
    let px:[]i64 = nio_alloc((npix * 3 * 8) as i32) as []i64;
    if (px.len == 0) { _zag_println("alloc px failed"); return 1; }
    let pi:i64 = 0;
    while (pi < npix * 3) { px[pi] = orig[pi] as i64; pi = pi + 1; }
    _zag_print("ingested ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("x");
    _zag_println(_zag_i64_to_str(h));

    let led:[]u8 = nio_alloc(4194304);
    if (led.len == 0) { _zag_println("alloc ledger failed"); return 1; }
    let lo:i64 = 0;
    lo = tab_puts(led, lo, "TNN-CHOOSES-ITS-LAYERS DELIBERATION TRACE (image_tnnlayers)\n");
    lo = tab_puts(led, lo, "I surveyed the fixture, chose my own layer decomposition, and measured\n");
    lo = tab_puts(led, lo, "each candidate layer against a bar before committing it.\n");

    // ---- SURVEY ----
    let sv:[]i64 = nio_alloc(48) as []i64;
    tl_survey_flat(px, w, h, sv);
    let lum:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    tl_luminance(px, npix, lum);
    let hist:[]i64 = nio_alloc(512) as []i64;
    let edgepx:[]i64 = nio_alloc(8) as []i64;
    let dum:[]i64 = nio_alloc(8) as []i64;
    tl_walks(lum, w, h, 27, 1, 0, dum, dum, dum, dum, dum, 0, hist, edgepx);
    let straight:i64 = 0;
    let curvy:i64 = 0;
    let hli:i64 = 2;
    while (hli < 16) { curvy = curvy + hli * hist[hli]; hli = hli + 1; }
    hli = 16;
    while (hli < 64) { straight = straight + hli * hist[hli]; hli = hli + 1; }
    lo = tab_puts(led, lo, "SURVEY: I looked at the image before choosing my layers.\n");
    lo = tab_puts(led, lo, "E_total_vs_global_mean=");
    lo = tab_puti(led, lo, sv[5]);
    lo = tab_puts(led, lo, "\n");
    let si0:i64 = 0;
    while (si0 < 5) {
        lo = tab_puts(led, lo, "flat-E scale ");
        lo = tab_puti(led, lo, s_of(si0));
        lo = tab_puts(led, lo, " = ");
        lo = tab_puti(led, lo, sv[si0]);
        lo = tab_puts(led, lo, "\n");
        si0 = si0 + 1;
    }
    lo = tab_puts(led, lo, "edge pixels (|sobel|>=27): ");
    lo = tab_puti(led, lo, edgepx[0]);
    lo = tab_puts(led, lo, "; straight-run px (runs>=16): ");
    lo = tab_puti(led, lo, straight);
    lo = tab_puts(led, lo, "; curvy-run px (2..15): ");
    lo = tab_puti(led, lo, curvy);
    lo = tab_puts(led, lo, "\n");
    _zag_println("survey done");

    // ---- AFFINITIES -> ORDER (TNN's choice) ----
    let aff_s:i64 = (1000 * (sv[5] - sv[0])) / sv[5];
    let aff_l:i64 = (1000 * straight) / npix;
    let aff_h:i64 = (1000 * (sv[0] - sv[4])) / sv[5];
    lo = tab_puts(led, lo, "AFFINITIES (per-mille, measured): SMOOTH=");
    lo = tab_puti(led, lo, aff_s);
    lo = tab_puts(led, lo, " LINES=");
    lo = tab_puti(led, lo, aff_l);
    lo = tab_puts(led, lo, " SHAPES=");
    lo = tab_puti(led, lo, aff_h);
    lo = tab_puts(led, lo, "\n");
    // order: descending affinity, ties -> SMOOTH(1), LINES(2), SHAPES(3)
    let order:[]i64 = nio_alloc(24) as []i64;
    let oa:[]i64 = nio_alloc(24) as []i64;
    order[0] = 1; oa[0] = aff_s;
    order[1] = 2; oa[1] = aff_l;
    order[2] = 3; oa[2] = aff_h;
    let p1:i64 = 0;
    while (p1 < 2) {
        let p2:i64 = p1 + 1;
        while (p2 < 3) {
            let swap:i64 = 0;
            if (oa[p2] > oa[p1]) { swap = 1; }
            if (oa[p2] == oa[p1]) {
                if (order[p2] < order[p1]) { swap = 1; }
            }
            if (swap == 1) {
                let to:i64 = order[p1]; order[p1] = order[p2]; order[p2] = to;
                let ta:i64 = oa[p1]; oa[p1] = oa[p2]; oa[p2] = ta;
            }
            p2 = p2 + 1;
        }
        p1 = p1 + 1;
    }
    lo = tab_puts(led, lo, "MY ORDER (descending affinity, ties->SMOOTH,LINES,SHAPES): ");
    let oi:i64 = 0;
    while (oi < 3) {
        lo = layer_name(order[oi], led, lo);
        lo = tab_puts(led, lo, " (");
        lo = tab_puti(led, lo, oa[oi]);
        lo = tab_puts(led, lo, ")");
        if (oi < 2) { lo = tab_puts(led, lo, " -> "); }
        oi = oi + 1;
    }
    lo = tab_puts(led, lo, "\n");
    lo = tab_puts(led, lo, "COMMIT BAR: a layer must explain >= 9 per value it covers (G >= 9*N),\n");
    lo = tab_puts(led, lo, "the per-value-9 precision precedent. Failures are reverted and recorded.\n");
    _zag_print("order: ");
    _zag_print(_zag_i64_to_str(order[0]));
    _zag_print(" ");
    _zag_print(_zag_i64_to_str(order[1]));
    _zag_print(" ");
    _zag_println(_zag_i64_to_str(order[2]));

    // ---- CASCADE: TNN tries each candidate on the current residual ----
    // px doubles as the working residual R (starts as the fixture).
    let tmp:[]i64 = nio_alloc((npix * 3 * 8) as i32) as []i64;
    if (tmp.len == 0) { _zag_println("alloc tmp failed"); return 1; }
    let committed:[]i64 = nio_alloc(24) as []i64;
    let owner:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    if (owner.len == 0) { _zag_println("alloc owner failed"); return 1; }
    let op:i64 = 0;
    while (op < npix) { owner[op] = -1; op = op + 1; }
    // committed-layer record stores (kept for knowmap + trace)
    let slx:[]i64 = nio_alloc((8192 * 8) as i32) as []i64;
    let sly:[]i64 = nio_alloc((8192 * 8) as i32) as []i64;
    let slw:[]i64 = nio_alloc((8192 * 8) as i32) as []i64;
    let slh:[]i64 = nio_alloc((8192 * 8) as i32) as []i64;
    let slm:[]i64 = nio_alloc((8192 * 3 * 8) as i32) as []i64;
    let slg:[]i64 = nio_alloc((8192 * 6 * 8) as i32) as []i64;
    let snleaf:[]i64 = nio_alloc(8) as []i64;
    let sgx0:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let sgy0:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let sgx1:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let sgy1:[]i64 = nio_alloc((4096 * 8) as i32) as []i64;
    let sgm:[]i64 = nio_alloc((4096 * 3 * 8) as i32) as []i64;
    let sgnseg:[]i64 = nio_alloc(8) as []i64;
    let sgnwalks:[]i64 = nio_alloc(8) as []i64;
    let sgndropped:[]i64 = nio_alloc(8) as []i64;
    let ha0:[]u8 = nio_alloc(1); let ha1:[]u8 = nio_alloc(1);
    let ha2:[]u8 = nio_alloc(1); let ha3:[]u8 = nio_alloc(1);
    let ha4:[]u8 = nio_alloc(1);
    let hex0:[]i64 = nio_alloc(8) as []i64; let hex1:[]i64 = nio_alloc(8) as []i64;
    let hex2:[]i64 = nio_alloc(8) as []i64; let hex3:[]i64 = nio_alloc(8) as []i64;
    let hex4:[]i64 = nio_alloc(8) as []i64;
    let hna:[]i64 = nio_alloc(40) as []i64;
    let hrx:[]i64 = nio_alloc((8192 * 8) as i32) as []i64;
    let hry:[]i64 = nio_alloc((8192 * 8) as i32) as []i64;
    let hrw:[]i64 = nio_alloc((8192 * 8) as i32) as []i64;
    let hrh:[]i64 = nio_alloc((8192 * 8) as i32) as []i64;
    let hrs:[]i64 = nio_alloc((8192 * 8) as i32) as []i64;
    let hrat:[]i64 = nio_alloc((8192 * 8) as i32) as []i64;
    let hrm:[]i64 = nio_alloc((8192 * 3 * 8) as i32) as []i64;
    let hrnreg:[]i64 = nio_alloc(8) as []i64;
    let hntake:[]i64 = nio_alloc(40) as []i64;
    let hnsplit:[]i64 = nio_alloc(40) as []i64;
    let hsilo:[]i64 = nio_alloc(8) as []i64;
    let hsihi:[]i64 = nio_alloc(8) as []i64;
    let hrep:[]i64 = nio_alloc(8) as []i64;
    let hgainfirst:[]i64 = nio_alloc(40) as []i64;
    let hgainlast:[]i64 = nio_alloc(40) as []i64;
    let kb_smooth:i64 = 0;
    let kb_lines:i64 = 0;
    let kb_shapes:i64 = 0;
    let t3:i64 = 0;
    while (t3 < 3) {
        let id:i64 = order[t3];
        committed[t3] = 0;
        // zero tmp
        let zi:i64 = 0;
        while (zi < npix * 3) { tmp[zi] = 0; zi = zi + 1; }
        let G:[]i64 = nio_alloc(8) as []i64;
        let N:[]i64 = nio_alloc(8) as []i64;
        let B:i64 = 0;
        lo = tab_puts(led, lo, "TRY ");
        lo = layer_name(id, led, lo);
        lo = tab_puts(led, lo, " on the current residual.\n");
        if (id == 1) {
            let nsplit_sm:[]i64 = nio_alloc(8) as []i64;
            nsplit_sm[0] = 0;
            lo = tl_smooth_build_ad(px, w, h, tmp, slx, sly, slw, slh, slm, slg,
                snleaf, 8192, G, N, nsplit_sm, led, lo);
            B = snleaf[0] * 26;
            kb_smooth = B;
            lo = tab_puts(led, lo, "  budget: adaptive CART binary splits (content-adaptive positions),\n");
            lo = tab_puts(led, lo, "  split iff CART-gain>=9/value, min child 4px.\n");
            lo = tab_puts(led, lo, "  leaves=");
            lo = tab_puti(led, lo, snleaf[0]);
            lo = tab_puts(led, lo, " cart_splits=");
            lo = tab_puti(led, lo, nsplit_sm[0]);
            lo = tab_puts(led, lo, "\n");
            nio_free(nsplit_sm);
        }
        if (id == 2) {
            let lum2:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
            tl_luminance(px, npix, lum2);
            let nw:i64 = tl_lines_build(px, lum2, w, h, tmp,
                sgx0, sgy0, sgx1, sgy1, sgm, sgnseg, 4096,
                G, N, sgndropped);
            sgnwalks[0] = nw;
            B = sgnseg[0] * 14;
            kb_lines = B;
            nio_free(lum2);
            lo = tab_puts(led, lo, "  budget: |sobel|>=27, min run 4, one straight segment per walk,\n");
            lo = tab_puts(led, lo, "  per-segment bar g>=9*n (curved walks should fail this).\n");
            lo = tab_puts(led, lo, "  walks=");
            lo = tab_puti(led, lo, nw);
            lo = tab_puts(led, lo, " kept_segments=");
            lo = tab_puti(led, lo, sgnseg[0]);
            lo = tab_puts(led, lo, " dropped=");
            lo = tab_puti(led, lo, sgndropped[0]);
            lo = tab_puts(led, lo, "\n");
        }
        if (id == 3) {
            // allocate per-scale atom + exemplar buffers (max sizes)
            let asz:[]i64 = nio_alloc(40) as []i64;
            let si9:i64 = 0;
            while (si9 < 5) {
                let s9:i64 = s_of(si9);
                let nc9:i64 = (w + s9 - 1) / s9;
                let nr9:i64 = (h + s9 - 1) / s9;
                let nb9:i64 = nc9 * nr9;
                asz[si9] = nb9;
                let mbytes:i64 = s9 * s9 * 3 * 2;
                let ab:[]u8 = nio_alloc((nb9 * mbytes) as i32);
                let eb:[]i64 = nio_alloc((nb9 * 8) as i32) as []i64;
                if (si9 == 0) { ha0 = ab; hex0 = eb; }
                if (si9 == 1) { ha1 = ab; hex1 = eb; }
                if (si9 == 2) { ha2 = ab; hex2 = eb; }
                if (si9 == 3) { ha3 = ab; hex3 = eb; }
                if (si9 == 4) { ha4 = ab; hex4 = eb; }
                hna[si9] = 0;
                si9 = si9 + 1;
            }
            nio_free(asz);
            lo = tl_shapeszoom_build(px, w, h, tmp,
                ha0, ha1, ha2, ha3, ha4,
                hex0, hex1, hex2, hex3, hex4, hna,
                hrx, hry, hrw, hrh, hrs, hrat, hrm, hrnreg, hntake, hnsplit, 8192,
                G, N, hrep, hsilo, hsihi, hgainfirst, hgainlast,
                led, lo);
            // FREE-LUNCH L1: prune atoms that never fire. Deterministic;
            // unfired atoms are never indexed by any usage record, so all
            // renders are byte-identical before/after. The trace keeps the
            // pre-prune counts (what the deliberation built); the knowmap
            // and KB line carry the pruned counts.
            let pra:[]i64 = nio_alloc(40) as []i64;
            let pkept:[]i64 = nio_alloc(40) as []i64;
            let psaved:[]i64 = nio_alloc(8) as []i64;
            let spi:i64 = 0;
            while (spi < 5) { pra[spi] = hna[spi]; pkept[spi] = 0; spi = spi + 1; }
            tl_prune_shapes(ha0, ha1, ha2, ha3, ha4, hna,
                hex0, hex1, hex2, hex3, hex4,
                hrs, hrat, hrnreg[0], hsilo[0], hsihi[0], pkept, psaved);
            lo = tab_puts(led, lo, "  PRUNE (free lunch: unfired atoms never render): ");
            lo = tab_puti(led, lo, psaved[0]);
            lo = tab_puts(led, lo, " bytes dropped; kept/built per scale: ");
            let spj:i64 = hsilo[0];
            while (spj <= hsihi[0]) {
                lo = tab_puts(led, lo, "s");
                lo = tab_puti(led, lo, s_of(spj));
                lo = tab_puts(led, lo, ":");
                lo = tab_puti(led, lo, pkept[spj]);
                lo = tab_puts(led, lo, "/");
                lo = tab_puti(led, lo, pra[spj]);
                if (spj < hsihi[0]) { lo = tab_puts(led, lo, " "); }
                spj = spj + 1;
            }
            lo = tab_puts(led, lo, "\n");
            nio_free(pkept);
            nio_free(psaved);
            B = hrnreg[0] * 17;
            let si10:i64 = hsilo[0];
            while (si10 <= hsihi[0]) {
                let s10:i64 = s_of(si10);
                B = B + hna[si10] * (s10 * s10 * 3 * 2 + 8);
                si10 = si10 + 1;
            }
            kb_shapes = B;
            lo = tab_puts(led, lo, "  repetition probe: rep_density=");
            lo = tab_puti(led, lo, hrep[0]);
            lo = tab_puts(led, lo, " per-mille -> my scale set = {");
            let si11:i64 = hsilo[0];
            while (si11 <= hsihi[0]) {
                lo = tab_puti(led, lo, s_of(si11));
                if (si11 < hsihi[0]) { lo = tab_puts(led, lo, ","); }
                si11 = si11 + 1;
            }
            lo = tab_puts(led, lo, "}\n");
            let si12:i64 = hsilo[0];
            while (si12 <= hsihi[0]) {
                lo = tab_puts(led, lo, "  scale ");
                lo = tab_puti(led, lo, s_of(si12));
                lo = tab_puts(led, lo, ": atoms=");
                lo = tab_puti(led, lo, pra[si12]);
                lo = tab_puts(led, lo, " first_gain=");
                lo = tab_puti(led, lo, hgainfirst[si12]);
                lo = tab_puts(led, lo, " last_gain=");
                lo = tab_puti(led, lo, hgainlast[si12]);
                lo = tab_puts(led, lo, "\n");
                si12 = si12 + 1;
            }
            lo = tab_puts(led, lo, "  take/split: ");
            let si13:i64 = 0;
            while (si13 < 5) {
                lo = tab_puts(led, lo, "s");
                lo = tab_puti(led, lo, s_of(si13));
                lo = tab_puts(led, lo, ":take");
                lo = tab_puti(led, lo, hntake[si13]);
                lo = tab_puts(led, lo, "/split");
                lo = tab_puti(led, lo, hnsplit[si13]);
                lo = tab_puts(led, lo, " ");
                si13 = si13 + 1;
            }
            lo = tab_puts(led, lo, "\n  regions=");
            lo = tab_puti(led, lo, hrnreg[0]);
            lo = tab_puts(led, lo, "\n");
            nio_free(pra);
        }
        lo = tab_puts(led, lo, "  measured: G=");
        lo = tab_puti(led, lo, G[0]);
        lo = tab_puts(led, lo, " N=");
        lo = tab_puti(led, lo, N[0]);
        lo = tab_puts(led, lo, " B=");
        lo = tab_puti(led, lo, B);
        lo = tab_puts(led, lo, " bytes; bar needs G >= 9*N = ");
        lo = tab_puti(led, lo, 9 * N[0]);
        lo = tab_puts(led, lo, "\n");
        _zag_print("layer ");
        _zag_print(_zag_i64_to_str(id));
        _zag_print(" G=");
        _zag_print(_zag_i64_to_str(G[0]));
        _zag_print(" N=");
        _zag_print(_zag_i64_to_str(N[0]));
        _zag_print(" B=");
        _zag_println(_zag_i64_to_str(B));
        let commit:i64 = 0;
        if (N[0] > 0) {
            if (G[0] >= 9 * N[0]) { commit = 1; }
        }
        if (commit == 1) {
            committed[t3] = 1;
            // px -= tmp (the residual shrinks); owner map for the gallery
            let ci2:i64 = 0;
            while (ci2 < npix * 3) { px[ci2] = px[ci2] - tmp[ci2]; ci2 = ci2 + 1; }
            let op2:i64 = 0;
            while (op2 < npix) {
                if (owner[op2] == -1) {
                    let q3:i64 = op2 * 3;
                    let a0v:i64 = tmp[q3];
                    if (a0v < 0) { a0v = 0 - a0v; }
                    let a1v:i64 = tmp[q3 + 1];
                    if (a1v < 0) { a1v = 0 - a1v; }
                    let a2v:i64 = tmp[q3 + 2];
                    if (a2v < 0) { a2v = 0 - a2v; }
                    if (a0v + a1v + a2v >= 27) { owner[op2] = id; }
                }
                op2 = op2 + 1;
            }
            lo = tab_puts(led, lo, "  DECISION: COMMIT. ");
            lo = layer_name(id, led, lo);
            lo = tab_puts(led, lo, " earned its place: it explains ");
            lo = tab_puti(led, lo, G[0] / N[0]);
            lo = tab_puts(led, lo, " per value (>= 9).\n");
            _zag_print("  COMMIT ");
            _zag_println(_zag_i64_to_str(id));
        } else {
            lo = tab_puts(led, lo, "  DECISION: REVERT. ");
            lo = layer_name(id, led, lo);
            if (N[0] == 0) {
                lo = tab_puts(led, lo, " claimed nothing on this residual — no records kept.\n");
            } else {
                lo = tab_puts(led, lo, " explains only ");
                lo = tab_puti(led, lo, G[0] / N[0]);
                lo = tab_puts(led, lo, " per value (< 9): the residual channel covers this\n");
                lo = tab_puts(led, lo, "  content more honestly. Records discarded, residual restored.\n");
            }
            _zag_print("  REVERT ");
            _zag_println(_zag_i64_to_str(id));
        }
        nio_free(G);
        nio_free(N);
        t3 = t3 + 1;
    }
    _zag_println("cascade done");

    // ---- understanding render, path A: clamp(orig - R_final) ----
    let U:[]u8 = nio_alloc((npix * 3) as i32);
    if (U.len == 0) { _zag_println("alloc U failed"); return 1; }
    let ui:i64 = 0;
    while (ui < npix * 3) {
        U[ui] = clamp8((orig[ui] as i64) - px[ui]) as u8;
        ui = ui + 1;
    }
    let rcu:i64 = bmp_write(oroot, "render_understanding.bmp", U, w, h);
    if (rcu != 0) { _zag_println("understanding write failed"); return 1; }
    _zag_println("understanding render done");

    // ---- layer map (gallery-only): which committed layer owns each pixel ----
    let lmp:[]u8 = nio_alloc((npix * 3) as i32);
    if (lmp.len == 0) { _zag_println("alloc lmp failed"); return 1; }
    let mi:i64 = 0;
    while (mi < npix) {
        let q4:i64 = mi * 3;
        let ow:i64 = owner[mi];
        if (ow == 1) { lmp[q4] = 40; lmp[q4 + 1] = 80; lmp[q4 + 2] = 180; }
        if (ow == 2) { lmp[q4] = 220; lmp[q4 + 1] = 60; lmp[q4 + 2] = 50; }
        if (ow == 3) { lmp[q4] = 60; lmp[q4 + 1] = 170; lmp[q4 + 2] = 80; }
        if (ow == -1) { lmp[q4] = 15; lmp[q4 + 1] = 15; lmp[q4 + 2] = 15; }
        mi = mi + 1;
    }
    let rcm:i64 = bmp_write(oroot, "render_layermap.bmp", lmp, w, h);
    if (rcm != 0) { _zag_println("layermap write failed"); return 1; }

    // ---- scale map (gallery-only): SHAPES region scale per pixel ----
    // 32=red, 16=green, 8=blue, 4=yellow, 64=magenta, none=dark
    // Find whether SHAPES (id=3) was committed, regardless of try order.
    let shapes_committed:i64 = 0;
    let smooth_committed:i64 = 0;
    let cci:i64 = 0;
    while (cci < 3) {
        if (order[cci] == 3) { if (committed[cci] == 1) { shapes_committed = 1; } }
        if (order[cci] == 1) { if (committed[cci] == 1) { smooth_committed = 1; } }
        cci = cci + 1;
    }
    let smp:[]u8 = nio_alloc((npix * 3) as i32);
    if (smp.len == 0) { _zag_println("alloc smp failed"); return 1; }
    let smi:i64 = 0;
    while (smi < npix * 3) { smp[smi] = 15; smi = smi + 1; }
    if (shapes_committed == 1) {
        let sri:i64 = 0;
        while (sri < hrnreg[0]) {
            let sx:i64 = hrx[sri]; let sy:i64 = hry[sri];
            let sw:i64 = hrw[sri]; let sh:i64 = hrh[sri];
            let ss:i64 = hrs[sri];
            let cr:i64 = 15; let cg:i64 = 15; let cb:i64 = 15;
            if (ss == 32) { cr = 220; cg = 50; cb = 50; }
            if (ss == 16) { cr = 50; cg = 200; cb = 60; }
            if (ss == 8) { cr = 60; cg = 100; cb = 220; }
            if (ss == 4) { cr = 230; cg = 210; cb = 60; }
            if (ss == 64) { cr = 200; cg = 60; cb = 200; }
            let syy:i64 = 0;
            while (syy < sh) {
                let sxx:i64 = 0;
                while (sxx < sw) {
                    let spx:i64 = (sy + syy) * w + (sx + sxx);
                    if (spx >= 0) { if (spx < npix) {
                        let sq:i64 = spx * 3;
                        smp[sq] = cr as u8; smp[sq + 1] = cg as u8; smp[sq + 2] = cb as u8;
                    } }
                    sxx = sxx + 1;
                }
                syy = syy + 1;
            }
            sri = sri + 1;
        }
    }
    let rcsm:i64 = bmp_write(oroot, "render_scalemap.bmp", smp, w, h);
    if (rcsm != 0) { _zag_println("scalemaps write failed"); return 1; }

    // ---- split map (gallery-only): SMOOTH CART leaf boundaries ----
    let splm:[]u8 = nio_alloc((npix * 3) as i32);
    if (splm.len == 0) { _zag_println("alloc splm failed"); return 1; }
    let spli:i64 = 0;
    while (spli < npix) {
        let sq2:i64 = spli * 3;
        splm[sq2] = 20; splm[sq2 + 1] = 20; splm[sq2 + 2] = 20;
        spli = spli + 1;
    }
    if (smooth_committed == 1) {
        let sli:i64 = 0;
        while (sli < snleaf[0]) {
            let lx:i64 = slx[sli]; let ly:i64 = sly[sli];
            let lw:i64 = slw[sli]; let lh:i64 = slh[sli];
            // draw 1px border in white
            let bx:i64 = 0;
            while (bx < lw) {
                let p1:i64 = ly * w + (lx + bx);
                let p2:i64 = (ly + lh - 1) * w + (lx + bx);
                if (p1 >= 0) { if (p1 < npix) { let q1:i64 = p1 * 3; splm[q1] = 255; splm[q1+1] = 255; splm[q1+2] = 255; } }
                if (p2 >= 0) { if (p2 < npix) { let q2:i64 = p2 * 3; splm[q2] = 255; splm[q2+1] = 255; splm[q2+2] = 255; } }
                bx = bx + 1;
            }
            let by:i64 = 0;
            while (by < lh) {
                let p3:i64 = (ly + by) * w + lx;
                let p4:i64 = (ly + by) * w + (lx + lw - 1);
                if (p3 >= 0) { if (p3 < npix) { let q3:i64 = p3 * 3; splm[q3] = 255; splm[q3+1] = 255; splm[q3+2] = 255; } }
                if (p4 >= 0) { if (p4 < npix) { let q4:i64 = p4 * 3; splm[q4] = 255; splm[q4+1] = 255; splm[q4+2] = 255; } }
                by = by + 1;
            }
            sli = sli + 1;
        }
    }
    let rcsp:i64 = bmp_write(oroot, "render_splitmap.bmp", splm, w, h);
    if (rcsp != 0) { _zag_println("splitmap write failed"); return 1; }

    // ---- residual (honest error channel, not understanding) ----
    let rpos:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    let rdelta:[]u8 = nio_alloc((npix * 6) as i32);
    if (rpos.len == 0) { _zag_println("alloc rpos failed"); return 1; }
    let nr:i64 = deliberate_residual(orig, U, w, h, rpos, rdelta, npix);
    if (nr < 0) { _zag_println("residual deliberation failed"); return 1; }
    _zag_print("residuals ");
    _zag_print(_zag_i64_to_str(nr));
    _zag_print(" / ");
    _zag_print(_zag_i64_to_str(npix));
    _zag_print(" px (");
    _zag_print(_zag_i64_to_str((nr * 1000) / npix));
    _zag_println(" per-mille)");
    lo = tab_puts(led, lo, "RESIDUAL (error channel, not understanding): ");
    lo = tab_puti(led, lo, nr);
    lo = tab_puts(led, lo, " / ");
    lo = tab_puti(led, lo, npix);
    lo = tab_puts(led, lo, " px (");
    lo = tab_puti(led, lo, (nr * 1000) / npix);
    lo = tab_puts(led, lo, " per-mille)\n");
    residual_apply(U, rpos, rdelta, nr);

    // ---- knowledge bytes ----
    let kblayers:i64 = 0;
    let t4:i64 = 0;
    while (t4 < 3) {
        if (committed[t4] == 1) {
            let id4:i64 = order[t4];
            if (id4 == 1) { kblayers = kblayers + kb_smooth; }
            if (id4 == 2) { kblayers = kblayers + kb_lines; }
            if (id4 == 3) { kblayers = kblayers + kb_shapes; }
        }
        t4 = t4 + 1;
    }
    let kbres:i64 = tl_res_size(nr, rpos, rdelta);
    lo = tab_puts(led, lo, "KNOWLEDGE BYTES: committed layers=");
    lo = tab_puti(led, lo, kblayers);
    lo = tab_puts(led, lo, " (smooth=");
    lo = tab_puti(led, lo, kb_smooth);
    lo = tab_puts(led, lo, " lines=");
    lo = tab_puti(led, lo, kb_lines);
    lo = tab_puts(led, lo, " shapes=");
    lo = tab_puti(led, lo, kb_shapes);
    lo = tab_puts(led, lo, ") residual=");
    lo = tab_puti(led, lo, kbres);
    lo = tab_puts(led, lo, "\n");
    lo = tab_puts(led, lo, "MY LAYERS, in my words: ");
    let t5:i64 = 0;
    let firstl:i64 = 1;
    while (t5 < 3) {
        if (committed[t5] == 1) {
            if (firstl == 0) { lo = tab_puts(led, lo, ", then "); }
            lo = layer_name(order[t5], led, lo);
            firstl = 0;
        }
        t5 = t5 + 1;
    }
    if (firstl == 1) { lo = tab_puts(led, lo, "(none — the residual alone)"); }
    lo = tab_puts(led, lo, ".\n");

    // ---- knowmap + full render + trace ----
    let rc1:i64 = tlk_write(oroot, kmapname, w, h,
        order, 3, committed,
        slx, sly, slw, slh, slm, slg, snleaf[0],
        sgx0, sgy0, sgx1, sgy1, sgm, sgnseg[0],
        ha0, ha1, ha2, ha3, ha4, hna,
        hex0, hex1, hex2, hex3, hex4,
        hrx, hry, hrw, hrh, hrs, hrat, hrm, hrnreg[0], hsilo[0], hsihi[0],
        nr, rpos, rdelta);
    if (rc1 != 0) { _zag_println("kmap write failed"); return 1; }
    let rc2:i64 = bmp_write(oroot, ra_name, U, w, h);
    if (rc2 != 0) { _zag_println("renderA write failed"); return 1; }
    let rcl:i64 = file_write(oroot, "DELIBTRACE.txt", led[0..lo]);
    nio_close(root);
    nio_close(oroot);
    if (rcl != 0) { _zag_println("trace write failed"); return 1; }
    _zag_println("ingest done");
    return 0;
}

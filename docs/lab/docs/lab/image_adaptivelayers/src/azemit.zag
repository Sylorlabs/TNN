// tlemit.zag — TNN-CHOOSES-ITS-LAYERS emit (white-box path B).
// Reads ONLY knowmap.bin (TNNKTLM3); re-renders each committed layer with
// the SAME shared render functions as ingest, applies residual deltas.
// Writes renderB.bmp (full) and renderB_understanding.bmp (no residual).
// argv: 1=dir 2=kmap_name 3=renderB_name
@import("./azlayers.zag")

fn main() i32 {
    let d:[]u8 = _zag_arg(1);
    let kmapname:[]u8 = _zag_arg(2);
    let rb_name:[]u8 = _zag_arg(3);
    if (_zag_strcmp(d, "") == 1) { d = "."; }
    if (_zag_strcmp(kmapname, "") == 1) { kmapname = "knowmap.bin"; }
    if (_zag_strcmp(rb_name, "") == 1) { rb_name = "renderB.bmp"; }
    let root:i64 = nio_open_root(d);
    if (root < 0) { _zag_println("cannot open dir"); return 1; }

    let data:[]u8 = file_read_all(root, kmapname, 20000000);
    if (data.len < 32) { _zag_println("kmap too short"); nio_close(root); return 1; }
    if (data[0] != 84) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[1] != 78) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[2] != 78) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[3] != 75) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[4] != 84) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[5] != 76) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[6] != 77) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[7] != 51) { _zag_println("bad magic"); nio_close(root); return 1; }
    let o:i64 = 8;
    let w:i64 = r_u64le(data, o); o = o + 8;
    let h:i64 = r_u64le(data, o); o = o + 8;
    let npix:i64 = w * h;
    _zag_print("kmap ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("x");
    _zag_println(_zag_i64_to_str(h));
    let nlayers:i64 = r_u64le(data, o); o = o + 8;
    _zag_print("layers ");
    _zag_println(_zag_i64_to_str(nlayers));

    let U:[]i64 = nio_alloc((npix * 3 * 8) as i32) as []i64;
    if (U.len == 0) { _zag_println("alloc U failed"); return 1; }
    let zi:i64 = 0;
    while (zi < npix * 3) { U[zi] = 0; zi = zi + 1; }

    let li:i64 = 0;
    while (li < nlayers) {
        let id:i64 = data[o] as i64; o = o + 1;
        _zag_print("layer id ");
        _zag_println(_zag_i64_to_str(id));
        if (id == 1) {
            let nleaf:i64 = r_u64le(data, o); o = o + 8;
            let lx:[]i64 = nio_alloc((nleaf * 8) as i32) as []i64;
            let ly:[]i64 = nio_alloc((nleaf * 8) as i32) as []i64;
            let lw:[]i64 = nio_alloc((nleaf * 8) as i32) as []i64;
            let lh:[]i64 = nio_alloc((nleaf * 8) as i32) as []i64;
            let lm:[]i64 = nio_alloc((nleaf * 3 * 8) as i32) as []i64;
            let lg:[]i64 = nio_alloc((nleaf * 6 * 8) as i32) as []i64;
            if (nleaf > 0) {
                if (lx.len == 0) { _zag_println("alloc leaves failed"); return 1; }
            }
            let i:i64 = 0;
            while (i < nleaf) {
                lx[i] = r_u16le(data, o); o = o + 2;
                ly[i] = r_u16le(data, o); o = o + 2;
                lw[i] = r_u16le(data, o); o = o + 2;
                lh[i] = r_u16le(data, o); o = o + 2;
                lm[i * 3] = r_i16le(data, o); o = o + 2;
                lm[i * 3 + 1] = r_i16le(data, o); o = o + 2;
                lm[i * 3 + 2] = r_i16le(data, o); o = o + 2;
                let gi:i64 = 0;
                while (gi < 6) {
                    lg[i * 6 + gi] = r_i16le(data, o); o = o + 2;
                    gi = gi + 1;
                }
                i = i + 1;
            }
            tl_smooth_render(U, w, lx, ly, lw, lh, lm, lg, nleaf);
            nio_free(lx); nio_free(ly); nio_free(lw); nio_free(lh);
            nio_free(lm); nio_free(lg);
        }
        if (id == 2) {
            let nseg:i64 = r_u64le(data, o); o = o + 8;
            let sx0:[]i64 = nio_alloc((nseg * 8) as i32) as []i64;
            let sy0:[]i64 = nio_alloc((nseg * 8) as i32) as []i64;
            let sx1:[]i64 = nio_alloc((nseg * 8) as i32) as []i64;
            let sy1:[]i64 = nio_alloc((nseg * 8) as i32) as []i64;
            let sm:[]i64 = nio_alloc((nseg * 3 * 8) as i32) as []i64;
            if (nseg > 0) {
                if (sx0.len == 0) { _zag_println("alloc segs failed"); return 1; }
            }
            let j:i64 = 0;
            while (j < nseg) {
                sx0[j] = r_u16le(data, o); o = o + 2;
                sy0[j] = r_u16le(data, o); o = o + 2;
                sx1[j] = r_u16le(data, o); o = o + 2;
                sy1[j] = r_u16le(data, o); o = o + 2;
                sm[j * 3] = r_i16le(data, o); o = o + 2;
                sm[j * 3 + 1] = r_i16le(data, o); o = o + 2;
                sm[j * 3 + 2] = r_i16le(data, o); o = o + 2;
                j = j + 1;
            }
            tl_lines_render(U, w, h, sx0, sy0, sx1, sy1, sm, nseg);
            nio_free(sx0); nio_free(sy0); nio_free(sx1); nio_free(sy1);
            nio_free(sm);
        }
        if (id == 3) {
            let silo:i64 = data[o] as i64; o = o + 1;
            let sihi:i64 = data[o] as i64; o = o + 1;
            let nscales:i64 = r_u64le(data, o); o = o + 8;
            let a0:[]u8 = nio_alloc(1); let a1:[]u8 = nio_alloc(1);
            let a2:[]u8 = nio_alloc(1); let a3:[]u8 = nio_alloc(1);
            let a4:[]u8 = nio_alloc(1);
            let k:i64 = 0;
            while (k < nscales) {
                let B:i64 = r_u64le(data, o); o = o + 8;
                let nm:i64 = r_u64le(data, o); o = o + 8;
                let nv:i64 = B * B * 3;
                let atoms:[]u8 = nio_alloc((nm * nv * 2) as i32);
                if (nm > 0) {
                    if (atoms.len == 0) { _zag_println("alloc atoms failed"); return 1; }
                }
                let ai:i64 = 0;
                while (ai < nm) {
                    let kk:i64 = 0;
                    while (kk < nv) {
                        w_i16le(atoms, ai * nv * 2 + kk * 2, r_i16le(data, o));
                        o = o + 2;
                        kk = kk + 1;
                    }
                    let ex:i64 = r_u64le(data, o); o = o + 8;
                    ai = ai + 1;
                }
                if (B == 64) { a0 = atoms; }
                if (B == 32) { a1 = atoms; }
                if (B == 16) { a2 = atoms; }
                if (B == 8) { a3 = atoms; }
                if (B == 4) { a4 = atoms; }
                _zag_print("scale ");
                _zag_print(_zag_i64_to_str(B));
                _zag_print(": atoms ");
                _zag_println(_zag_i64_to_str(nm));
                k = k + 1;
            }
            let nreg:i64 = r_u64le(data, o); o = o + 8;
            let rx:[]i64 = nio_alloc((nreg * 8) as i32) as []i64;
            let ry:[]i64 = nio_alloc((nreg * 8) as i32) as []i64;
            let rw:[]i64 = nio_alloc((nreg * 8) as i32) as []i64;
            let rh:[]i64 = nio_alloc((nreg * 8) as i32) as []i64;
            let rs:[]i64 = nio_alloc((nreg * 8) as i32) as []i64;
            let rat:[]i64 = nio_alloc((nreg * 8) as i32) as []i64;
            let rm:[]i64 = nio_alloc((nreg * 3 * 8) as i32) as []i64;
            if (nreg > 0) {
                if (rx.len == 0) { _zag_println("alloc regions failed"); return 1; }
            }
            let ri:i64 = 0;
            while (ri < nreg) {
                rx[ri] = r_u16le(data, o); o = o + 2;
                ry[ri] = r_u16le(data, o); o = o + 2;
                rw[ri] = r_u16le(data, o); o = o + 2;
                rh[ri] = r_u16le(data, o); o = o + 2;
                rs[ri] = data[o] as i64; o = o + 1;
                rat[ri] = r_u16le(data, o); o = o + 2;
                rm[ri * 3] = r_i16le(data, o); o = o + 2;
                rm[ri * 3 + 1] = r_i16le(data, o); o = o + 2;
                rm[ri * 3 + 2] = r_i16le(data, o); o = o + 2;
                ri = ri + 1;
            }
            _zag_print("regions ");
            _zag_println(_zag_i64_to_str(nreg));
            tl_shapes_render(U, w, h, a0, a1, a2, a3, a4,
                rx, ry, rw, rh, rs, rat, rm, nreg);
            nio_free(rx); nio_free(ry); nio_free(rw); nio_free(rh);
            nio_free(rs); nio_free(rat);
            nio_free(rm);
            nio_free(a0); nio_free(a1); nio_free(a2); nio_free(a3); nio_free(a4);
        }
        if (id < 1) { _zag_println("bad layer id"); return 1; }
        if (id > 3) { _zag_println("bad layer id"); return 1; }
        li = li + 1;
    }

    // path B understanding: clamp(U)
    let fb:[]u8 = nio_alloc((npix * 3) as i32);
    if (fb.len == 0) { _zag_println("alloc fb failed"); return 1; }
    let fi:i64 = 0;
    while (fi < npix * 3) { fb[fi] = clamp8(U[fi]) as u8; fi = fi + 1; }
    let rbu:i64 = bmp_write(root, "renderB_understanding.bmp", fb, w, h);
    if (rbu != 0) { _zag_println("renderB_understanding write failed"); return 1; }

    let nr:i64 = r_u64le(data, o); o = o + 8;
    // TNNKTLM2 residual section: u8 dmode, u8 pflag, u32 first, gaps, deltas
    let dmode:i64 = data[o] as i64; o = o + 1;
    let pflag:i64 = data[o] as i64; o = o + 1;
    let rpos:[]i64 = nio_alloc((nr * 8) as i32) as []i64;
    let rdelta:[]u8 = nio_alloc((nr * 6) as i32);
    if (nr > 0) {
        if (rpos.len == 0) { _zag_println("alloc rpos failed"); return 1; }
        rpos[0] = r_u32le(data, o); o = o + 4;
        let rj:i64 = 1;
        while (rj < nr) {
            let gg:i64 = 0;
            if (pflag == 0) { gg = r_u16le(data, o); o = o + 2; }
            else { gg = r_u32le(data, o); o = o + 4; }
            rpos[rj] = rpos[rj - 1] + gg;
            rj = rj + 1;
        }
        rj = 0;
        while (rj < nr) {
            let q0:i64 = 0; let q1:i64 = 0; let q2:i64 = 0;
            if (dmode == 0) {
                q0 = data[o] as i64; o = o + 1;
                if (q0 >= 128) { q0 = q0 - 256; }
                q1 = data[o] as i64; o = o + 1;
                if (q1 >= 128) { q1 = q1 - 256; }
                q2 = data[o] as i64; o = o + 1;
                if (q2 >= 128) { q2 = q2 - 256; }
            } else {
                q0 = r_i16le(data, o); o = o + 2;
                q1 = r_i16le(data, o); o = o + 2;
                q2 = r_i16le(data, o); o = o + 2;
            }
            w_i16le(rdelta, rj * 6, q0);
            w_i16le(rdelta, rj * 6 + 2, q1);
            w_i16le(rdelta, rj * 6 + 4, q2);
            rj = rj + 1;
        }
    }
    _zag_print("residuals ");
    _zag_println(_zag_i64_to_str(nr));
    residual_apply(fb, rpos, rdelta, nr);
    let rc:i64 = bmp_write(root, rb_name, fb, w, h);
    nio_close(root);
    if (rc != 0) { _zag_println("renderB write failed"); return 1; }
    _zag_println("emit done");
    return 0;
}

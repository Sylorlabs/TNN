// fe3a.zag — FE3a buildability proof: a byte-identical sense-revision loop
// on a 10-exemplar toy, pure Zag, zero RNG.
//
// Frozen exemplars (A, B, label), constant bytes per window:
//   (97,103,1) (98,104,1) (99,105,1) (97,104,1) (98,105,1) (99,103,1)
//   (101,97,0) (102,98,0) (101,98,0) (102,97,0)
// Sense judgment = 1 iff mean(A) >= T; re-inspection = 1 iff mean(B) >= T.
// Reversal iff the two disagree. Revision: first reversal in index order,
// T -= 1 if re-inspection said 1 else T += 1. Re-run; stop at zero
// reversals or 64 iterations. Emits the full per-iteration trace.
//
// Data lives in a []u8 arena with explicit LE64 accessors (znc-safe).

@import("R33_NATIVE_IO_V1.zag")

fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, i64s(v));
    return pos;
}

fn main() i32 {
    // arena: 10 exemplars x 3 fields (A,B,label) x 8 bytes
    let ar:[]u8 = nio_alloc(240);
    let i:i32 = 0;
    while(i < 240) { ar[i] = 0; i = i + 1; }
    let A0:i32 = 0;
    let B0:i32 = 80;
    let L0:i32 = 160;
    // frozen exemplars
    t_put64(ar, A0+0*8, 97);  t_put64(ar, B0+0*8, 103); t_put64(ar, L0+0*8, 1);
    t_put64(ar, A0+1*8, 98);  t_put64(ar, B0+1*8, 104); t_put64(ar, L0+1*8, 1);
    t_put64(ar, A0+2*8, 99);  t_put64(ar, B0+2*8, 105); t_put64(ar, L0+2*8, 1);
    t_put64(ar, A0+3*8, 97);  t_put64(ar, B0+3*8, 104); t_put64(ar, L0+3*8, 1);
    t_put64(ar, A0+4*8, 98);  t_put64(ar, B0+4*8, 105); t_put64(ar, L0+4*8, 1);
    t_put64(ar, A0+5*8, 99);  t_put64(ar, B0+5*8, 103); t_put64(ar, L0+5*8, 1);
    t_put64(ar, A0+6*8, 101); t_put64(ar, B0+6*8, 97);  t_put64(ar, L0+6*8, 0);
    t_put64(ar, A0+7*8, 102); t_put64(ar, B0+7*8, 98);  t_put64(ar, L0+7*8, 0);
    t_put64(ar, A0+8*8, 101); t_put64(ar, B0+8*8, 98);  t_put64(ar, L0+8*8, 0);
    t_put64(ar, A0+9*8, 102); t_put64(ar, B0+9*8, 97);  t_put64(ar, L0+9*8, 0);

    let T:i64 = 100;
    let it:i64 = 0;
    let stop:i32 = 0;
    let final_errs:i64 = 0;
    let ob:[]u8 = nio_alloc(4096);
    let pos:i32 = 0;

    while(stop == 0) {
        if(it >= 64) {
            pos = ob_add(ob, pos, "CAP\n");
            stop = 1;
        } else {
            let errs:i64 = 0;
            let ri:i64 = -1;
            let rj:i64 = 0;
            let k:i32 = 0;
            while(k < 10) {
                let av:i64 = t_get64(ar, A0+k*8);
                let bv:i64 = t_get64(ar, B0+k*8);
                let lb:i64 = t_get64(ar, L0+k*8);
                let s:i64 = 0;
                if(av >= T) { s = 1; }
                let r:i64 = 0;
                if(bv >= T) { r = 1; }
                if(s != lb) { errs = errs + 1; }
                if(ri < 0 && s != r) { ri = k as i64; rj = r; }
                k = k + 1;
            }
            pos = ob_kv(ob, pos, "it", it);
            pos = ob_add(ob, pos, " ");
            pos = ob_kv(ob, pos, "T", T);
            pos = ob_add(ob, pos, " ");
            if(ri < 0) {
                pos = ob_add(ob, pos, "reversals=0 ");
                pos = ob_kv(ob, pos, "errs", errs);
                pos = ob_add(ob, pos, " STOP\n");
                final_errs = errs;
                stop = 1;
            } else {
                pos = ob_add(ob, pos, "reversals=1 ");
                pos = ob_kv(ob, pos, "first_rev", ri);
                pos = ob_add(ob, pos, " ");
                pos = ob_kv(ob, pos, "errs", errs);
                pos = ob_add(ob, pos, " ");
                if(rj == 1) { T = T - 1; } else { T = T + 1; }
                pos = ob_kv(ob, pos, "T_next", T);
                pos = ob_add(ob, pos, "\n");
                final_errs = errs;
                it = it + 1;
            }
        }
    }
    pos = ob_add(ob, pos, "FINAL ");
    pos = ob_kv(ob, pos, "T", T);
    pos = ob_add(ob, pos, " ");
    pos = ob_kv(ob, pos, "errs", final_errs);
    pos = ob_add(ob, pos, " ");
    pos = ob_kv(ob, pos, "iters", it + 1);
    pos = ob_add(ob, pos, "\n");
    let nwr:i64 = _zag_raw_syscall(1, 1, (_zag_slice_ptr(ob) as i64), pos as i64, 0, 0, 0);
    if(nwr < 0) { return 10; }
    return 0;
}

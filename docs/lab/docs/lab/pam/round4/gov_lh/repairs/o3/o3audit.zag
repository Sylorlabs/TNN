// o3audit.zag — O3 repaired-bar membership audit (PAM gov-LH crew 5).
//
// argv: (case_o1.txt)
// Frozen definitions (repair-off reading of the original battery):
//   278-set: correct==1 && conf>=700 && prog!=0
//   six timbredisc wrongs: tcode==4 && correct==0 && conf>=700
// Prints: SIX=<n> NEVER=<n> INTER=<n> [seqs of inter] and the repaired-bar
// verdict: O3-UNTESTABLE-DROPS if INTER<4, else O3-TESTABLE.
// 3x byte-identical runs required. Pure Zag, zero RNG.

@import("R33_NATIVE_IO_V1.zag")

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
// pipe-separated field k (0-based) from b[ls..le] into tmp; return len, -1 absent.
fn getf(b:[]u8, ls:i32, le:i32, k:i32, tmp:[]u8) i32 {
    let f:i32 = 0;
    let fs:i32 = ls;
    let i:i32 = ls;
    while(i < le) {
        if((b[i] as i32) == 124) {
            if(f == k) {
                let n:i32 = i - fs;
                let j:i32 = 0;
                while(j < n) { tmp[j] = b[fs + j]; j = j + 1; }
                return n;
            }
            f = f + 1;
            fs = i + 1;
        }
        i = i + 1;
    }
    if(f == k) {
        let n:i32 = le - fs;
        let j:i32 = 0;
        while(j < n) { tmp[j] = b[fs + j]; j = j + 1; }
        return n;
    }
    return -1;
}
fn p_atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}
fn fpass(b:[]u8, n:i32) i32 {
    // field value "PASS" ?
    if(n != 4) { return 0; }
    if((b[0] as i32) == 80 && (b[1] as i32) == 65 && (b[2] as i32) == 83 && (b[3] as i32) == 83) { return 1; }
    return 0;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let bb:[]u8 = nio_alloc(2097152);
    let bn:i64 = z_read(a1, bb, 2097152);
    if(bn < 0) { return 1; }
    let bnn:i32 = bn as i32;
    let tmp:[]u8 = nio_alloc(256);
    let inter_seq:[]u8 = nio_alloc(8 * 16);
    let n_never:i32 = 0;
    let n_six:i32 = 0;
    let n_inter:i32 = 0;
    let n_total:i32 = 0;
    let six_prog_pass:i32 = 0;
    let six_progf_pass:i32 = 0;
    let i:i32 = 0;
    while(i < bnn) {
        let ls:i32 = i;
        while(i < bnn && (bb[i] as i32) != 10) { i = i + 1; }
        let le:i32 = i;
        if(i < bnn) { i = i + 1; }
        if(le > ls) {
            n_total = n_total + 1;
            let f0:i32 = getf(bb, ls, le, 0, tmp);
            let seq:i64 = p_atoi(tmp, f0);
            let f1:i32 = getf(bb, ls, le, 1, tmp);
            let tc:i64 = p_atoi(tmp, f1);
            let f2:i32 = getf(bb, ls, le, 2, tmp);
            let prog:i64 = p_atoi(tmp, f2);
            let f3:i32 = getf(bb, ls, le, 3, tmp);
            let progf:i64 = p_atoi(tmp, f3);
            let f6:i32 = getf(bb, ls, le, 6, tmp);
            let conf:i64 = p_atoi(tmp, f6);
            let f11:i32 = getf(bb, ls, le, 11, tmp);
            let correct:i64 = p_atoi(tmp, f11);
            let is_six:i32 = 0;
            let is_never:i32 = 0;
            if(tc == 4 && correct == 0 && conf >= 700) {
                is_six = 1;
                n_six = n_six + 1;
                if(prog == 0) { six_prog_pass = six_prog_pass + 1; }
                if(progf == 0) { six_progf_pass = six_progf_pass + 1; }
            }
            if(correct == 1 && conf >= 700 && prog != 0) {
                is_never = 1;
                n_never = n_never + 1;
            }
            if(is_six == 1 && is_never == 1) {
                if(n_inter < 8) {
                    let q:i32 = 0;
                    let ss:[]u8 = i64s(seq);
                    while(q < ss.len) { inter_seq[n_inter * 16 + q] = ss[q]; q = q + 1; }
                    inter_seq[n_inter * 16 + q] = 32;
                    n_inter = n_inter + 1;
                }
            }
        }
    }
    let ob:[]u8 = nio_alloc(4096);
    let pos:i32 = 0;
    pos = ob_add(ob, pos, "TOTAL=");
    pos = ob_add(ob, pos, i64s(n_total as i64));
    pos = ob_add(ob, pos, " SIX=");
    pos = ob_add(ob, pos, i64s(n_six as i64));
    pos = ob_add(ob, pos, " NEVER=");
    pos = ob_add(ob, pos, i64s(n_never as i64));
    pos = ob_add(ob, pos, " INTER=");
    pos = ob_add(ob, pos, i64s(n_inter as i64));
    pos = ob_add(ob, pos, " SIXPROGPASS=");
    pos = ob_add(ob, pos, i64s(six_prog_pass as i64));
    pos = ob_add(ob, pos, " SIXPROGFPASS=");
    pos = ob_add(ob, pos, i64s(six_progf_pass as i64));
    pos = ob_add(ob, pos, "\n");
    if(n_inter >= 4) {
        pos = ob_add(ob, pos, "O3-TESTABLE\n");
    }
    if(n_inter < 4) {
        pos = ob_add(ob, pos, "O3-UNTESTABLE-DROPS\n");
    }
    let nwr:i64 = _zag_raw_syscall(1, 1, (_zag_slice_ptr(ob) as i64), pos as i64, 0, 0, 0);
    if(nwr < 0) { return 10; }
    return 0;
}

// f3.zag — F3 DELIBERATIVE-UNTRAINED.
// BYTE-IDENTICAL MACHINERY to f2.zag (F2 DELIBERATIVE-TRAINED) with an
// UNTRAINED policy only. Policy diffs vs f2.zag (frozen prereg
// docs/lab/consciousness_cost/preregs/PERCEPTION_PREREG.md §1):
//   1. CONF_BAR 250 -> 900 (naive: resense unless near-certain; no
//      calibration to this pipeline's conservative confidence scale).
//   2. f3_choose_fixed: selector priority ignores trigger code and
//      background hint — always fixed per-task order.
//   3. Fixed resense budget: exactly F3_FIXED_ROUNDS=2 pass-2 acquisitions
//      whenever the (naive) trigger fires; no trigger-gated continuation.
// Triggers, selectors, resamplers, bg scan, adjudication, verification,
// install, ledger — all shared with F2. Pure Zag, zero RNG.
//
// PASS 1: identical to frozen F1 (bit-exact port in f1.zag), but the sampling
//   policy and its loss bounds are DECLARED UP FRONT in the ledger (P1_PLAN)
//   before any sample is taken. This answers the debate's core finding: the
//   consciousness must choose sampling BEFORE irreversible preprocessing.
// PASS 2: deliberate re-sense with CHANGED evidence only (new windows /
//   regions / decoders; a used-selector mask makes same-evidence reruns
//   structurally impossible), under a hard per-trial acquisition budget and
//   op-count deadline, with a deterministic circuit-breaker.
// BACKGROUND: interrupt-only. bg_scan returns (fired,hint); it can never
//   install a percept — installation happens only in the install block below.
// HIGH STAKES (PITCH, MOTION): install-time verification with FRESH
//   independent evidence (an unused selector), max depth 2 (enforced by a
//   counter). If verification is impossible within budget/deadline, the
//   install proceeds as PROVISIONAL — never a refusal.
// OBJECTION ANSWERS (see also DESIGN_NOTES.md):
//   irreversibility: P1_PLAN declares loss BEFORE sampling; pass 2 samples
//     the raw stimulus the plan retained, not the destroyed summary.
//   attention capture: MAX_ACQ=6 + op deadline + used-mask; loop provably
//     terminates; capture events are ledgered, never silent.
//   verification regress: verify depth counter, hard bound 2; the verifier
//     is the same deterministic decoder on fresh evidence, not a new agent.
@import("f1.zag")
@import("substrate/R33_NATIVE_SHA256_V2.zag")

// ns_sha256(input,out) writes the 32-byte digest into out; wrap it.
fn f2_sha256(data:[]u8)[]u8 {
    let dg:[]u8=nio_alloc(32);
    ns_sha256(data,dg);
    return dg;
}

// ---------- ledger ----------
struct Lg { buf:[]u8; at:i32; seq:i32; prev:[]u8; }
fn lg_hexword(dst:[]u8,at:i32,dg:[]u8)void {
    let hx:[]u8="0123456789abcdef";
    let i:i32=0;
    while(i<32){
        let v:i32=dg[i] as i32;
        let hi:i32=v/16;let lo:i32=v-hi*16;
        dst[at+i*2]=hx[hi];dst[at+i*2+1]=hx[lo];
        i=i+1;
    }
}
fn lg_add(lg:*Lg,phase:[]u8,code:i64,pl:[]u8)void {
    let b:[]u8=lg.*.buf;
    let at:i32=lg.*.at;
    let a0:i32=at;
    let pv:[]u8=lg.*.prev;
    let s:[]u8=f_i64s(lg.*.seq as i64);
    f_cat(b,&at,s);f_cat1(b,&at,124);
    f_cat(b,&at,phase);f_cat1(b,&at,124);
    s=f_i64s(code);f_cat(b,&at,s);f_cat1(b,&at,124);
    f_cat(b,&at,pl);f_cat1(b,&at,124);
    f_cat(b,&at,pv);f_cat1(b,&at,124);
    let dg:[]u8=f2_sha256(b[a0..at]);
    lg_hexword(b,at,dg);at=at+64;
    f_cat1(b,&at,10);
    let i:i32=0;
    while(i<64){pv[i]=b[at-65+i];i=i+1;}
    lg.*.at=at;lg.*.seq=lg.*.seq+1;
}
fn lg_init()Lg {
    let pv:[]u8=nio_alloc(64);
    let i:i32=0;
    while(i<64){pv[i]=48;i=i+1;}
    let l:Lg=Lg{.buf=nio_alloc(65536),.at=0,.seq=0,.prev=pv};
    return l;
}
// ZNC-010: slice-field access off a &local-derived pointer miscompiles, so
// main() never touches plg.*.buf directly; it goes through these helpers
// (field access through a *Lg PARAMETER is the proven-safe pattern).
fn lg_slice(lg:*Lg)[]u8 {
    let b:[]u8=lg.*.buf;
    return b[0..lg.*.at];
}
fn lg_save(lg:*Lg,path:[]u8)i32 {
    return f_write_file(path,lg_slice(lg));
}
// payload builder: small kv buffer
struct Kv { b:[]u8; at:i32; }
fn kv_init()Kv { let k:Kv=Kv{.b=nio_alloc(2048),.at=0}; return k; }
fn kv_s(k:*Kv,key:[]u8,val:[]u8)void {
    let b:[]u8=k.*.b;let at:i32=k.*.at;
    if(at>0){f_cat1(b,&at,44);}
    f_cat(b,&at,key);f_cat1(b,&at,61);f_cat(b,&at,val);
    k.*.at=at;
}
fn kv_i(k:*Kv,key:[]u8,v:i64)void { kv_s(k,key,f_i64s(v)); }
fn kv_str(k:*Kv)[]u8 { let b:[]u8=k.*.b; return b[0..k.*.at]; }

// ---------- frozen constants ----------
const MAX_ACQ:i32=6;
const MAX_VERIFY_DEPTH:i32=2;
const CONF_BAR:i32=900;
const F3_FIXED_ROUNDS:i32=2;
// trigger codes
const TR_NONE:i32=0;
const TR_UNCERTAIN:i32=1;
const TR_COVERAGE:i32=2;
const TR_GOAL:i32=3;
const TR_DIVERSITY:i32=4;
const TR_BG:i32=5;
// authority
const AU_DIRECT:i32=1;
const AU_PROVISIONAL:i32=2;
const AU_VERIFIED:i32=3;
fn f2_stake(task:i32)i32 {
    if(task==T_PITCH){return 1;}
    if(task==T_MOTION){return 1;}
    return 0;
}
fn f2_auth_str(a:i32)[]u8 {
    if(a==AU_DIRECT){return "direct";}
    if(a==AU_VERIFIED){return "verified";}
    return "provisional";
}
fn f2_tr_str(t:i32)[]u8 {
    if(t==TR_UNCERTAIN){return "uncertain";}
    if(t==TR_COVERAGE){return "coverage";}
    if(t==TR_GOAL){return "goal";}
    if(t==TR_DIVERSITY){return "diversity";}
    if(t==TR_BG){return "bg";}
    return "none";
}
// selector ids: 1=pass1, 2=bg, 10..13=pass2 per task
fn f2_sel_list(task:i32,idx:i32)i32 {
    if(task==T_PITCH){
        if(idx==0){return 10;} if(idx==1){return 11;}
        if(idx==2){return 12;} if(idx==3){return 13;}
        return 0;
    }
    if(task==T_TIMBRE){
        if(idx==0){return 10;} if(idx==1){return 11;}
        if(idx==2){return 12;} return 0;
    }
    if(task==T_COLORDISC){
        if(idx==0){return 10;} if(idx==1){return 11;}
        if(idx==2){return 12;} if(idx==3){return 13;}
        return 0;
    }
    if(task==T_COLORCONST){
        if(idx==0){return 10;} if(idx==1){return 11;}
        if(idx==2){return 12;} return 0;
    }
    if(idx==0){return 10;} if(idx==1){return 11;}
    return 0;
}
fn f2_sel_used(used:i64,sel:i32)i32 {
    if(sel<=0){return 1;}
    let bit:i64=(1 as i64)<<sel;
    if((used&bit)!=0){return 1;}
    return 0;
}
// estimated op cost of a selector (upper bound; deterministic)
fn f2_est_cost(task:i32,sel:i32)i64 {
    if(task==T_PITCH){if(sel==12){return 8192;} return 2048;}
    if(task==T_TIMBRE){if(sel==12){return 8192;} if(sel==11){return 4096;} return 2048;}
    if(task==T_COLORDISC){if(sel==13){return 4096;} return 2048;}
    if(task==T_COLORCONST){return 4096;}
    if(sel==11){return 24576;}
    return 32768;
}
// priority order among unused selectors; returns selector id or 0
fn f2_choose(task:i32,trig:i32,hint:i64,used:i64)[]i64 {
    let order:[]i64=z_i64a(4);
    let n:i32=0;
    if(task==T_PITCH){
        let q:i32=hint as i32;
        if(trig==TR_BG && q>=0 && q<4){
            if(q==3){order[0]=10;order[1]=11;order[2]=12;order[3]=13;}
            else if(q==2){order[0]=11;order[1]=10;order[2]=12;order[3]=13;}
            else if(q==1){order[0]=12;order[1]=13;order[2]=10;order[3]=11;}
            else {order[0]=13;order[1]=12;order[2]=10;order[3]=11;}
            n=4;
        } else {order[0]=10;order[1]=11;order[2]=12;order[3]=13;n=4;}
    } else if(task==T_TIMBRE){
        order[0]=10;order[1]=11;order[2]=12;n=3;
        if(trig==TR_BG && (hint==10 || hint==11)){order[0]=hint;order[1]=21-hint;order[2]=12;}
    } else if(task==T_COLORDISC){
        order[0]=10;order[1]=11;order[2]=12;order[3]=13;n=4;
    } else if(task==T_COLORCONST){
        if(trig==TR_BG){order[0]=10;order[1]=12;order[2]=11;}
        else {order[0]=11;order[1]=10;order[2]=12;}
        n=3;
    } else {
        order[0]=10;order[1]=11;n=2;
    }
    let out:[]i64=z_i64a(1);
    out[0]=0;
    let i:i32=0;
    while(i<n){
        let s:i32=order[i] as i32;
        if(f2_sel_used(used,s)==0){out[0]=s as i64;return out;}
        i=i+1;
    }
    
    return out;
}

// ---------- F3 UNTRAINED policy: fixed selector order, ignores trig/hint ----------
// (f2_choose stays in the file unused; F3 calls only this.)
fn f3_choose_fixed(task:i32,used:i64)i64 {
    let order:[]i64=z_i64a(4);
    let n:i32=0;
    if(task==T_PITCH){order[0]=10;order[1]=11;order[2]=12;order[3]=13;n=4;}
    else if(task==T_TIMBRE){order[0]=10;order[1]=11;order[2]=12;n=3;}
    else if(task==T_COLORDISC){order[0]=10;order[1]=11;order[2]=12;order[3]=13;n=4;}
    else if(task==T_COLORCONST){order[0]=10;order[1]=11;order[2]=12;n=3;}
    else {order[0]=10;order[1]=11;n=2;}
    let i:i32=0;
    while(i<n){
        let s:i32=order[i] as i32;
        if(f2_sel_used(used,s)==0){return s as i64;}
        i=i+1;
    }
    return 0;
}

// ---------- background channel (interrupt-only) ----------
// Returns via out params: fired (0/1), hint, ops. NEVER installs a percept:
// the return type carries no label. Callers may only wake deliberation.
struct Bg { fired:i32; hint:i64; ops:i64; }
// strided zero-cross freq (interrupt-grade estimate, not evidence)
fn bg_zc(b:[]u8,off:i32,n:i32,stride:i32,rate:i64,ops:*i64)i64 {
    let prev:i64=f_gi16(b,off) as i64;
    let first:i64=-1;let last:i64=-1;let count:i64=0;
    let i:i32=stride;let si:i32=1;
    while(i<n){
        let cur:i64=f_gi16(b,off+i*2) as i64;
        ops.*=ops.*+1;
        let cross:i32=0;
        if(prev<0 && cur>=0){cross=1;}
        if(prev>0 && cur<=0){cross=1;}
        if(cross==1){
            let num:i64=f_abs64(prev);let den:i64=num+f_abs64(cur);
            let pos:i64=(si as i64)*65536+(num*65536)/den;
            if(first<0){first=pos;}
            last=pos;count=count+1;
        }
        prev=cur;i=i+stride;si=si+1;
    }
    if(count<2 || last<=first){return 0;}
    return ((count-1)*rate*65536)/(2*(last-first));
}
fn bg_scan(task:i32,b:[]u8,p1:*Pc,bg:*Bg)void {
    bg.*.fired=0;bg.*.hint=0;bg.*.ops=0;
    if(task==T_PITCH){
        let f0:i64=bg_zc(b,8,4096,8,44100,&bg.*.ops);
        let f1:i64=bg_zc(b,8+4096*2,4096,8,44100,&bg.*.ops);
        let f2:i64=bg_zc(b,8+8192*2,4096,8,44100,&bg.*.ops);
        let f3:i64=bg_zc(b,8+12288*2,4096,8,44100,&bg.*.ops);
        let mn:i64=f0;let mx:i64=f0;let qi:i32=0;
        let fs:[]i64=z_i64a(4);
        fs[0]=f0;fs[1]=f1;fs[2]=f2;fs[3]=f3;
        let k:i32=0;
        while(k<4){
            if(fs[k]<mn){mn=fs[k];}
            if(fs[k]>mx){mx=fs[k];qi=k;}
            k=k+1;
        }
        
        if(mn>0 && ((mx-mn)*100)/mn>5){bg.*.fired=1;bg.*.hint=qi as i64;}
        return;
    }
    if(task==T_TIMBRE){
        let e1:i64=0;let h1:i64=0;let pv:i64=f_gi16(b,8+2048*2) as i64;
        let i:i32=2048+8;
        while(i<4096){
            let v:i64=f_gi16(b,8+i*2) as i64;
            e1=e1+f_abs64(v);h1=h1+f_abs64(v-pv);pv=v;i=i+8;
            bg.*.ops=bg.*.ops+1;
        }
        let e2:i64=0;let h2:i64=0;pv=f_gi16(b,8+4096*2) as i64;i=4096+8;
        while(i<8192){
            let v:i64=f_gi16(b,8+i*2) as i64;
            e2=e2+f_abs64(v);h2=h2+f_abs64(v-pv);pv=v;i=i+8;
            bg.*.ops=bg.*.ops+1;
        }
        let hp1:i64=(h1*1000)/f_max64(e1,1);
        let hp2:i64=(h2*1000)/f_max64(e2,1);
        if(p1.*.d0<=110 && hp1>110){bg.*.fired=1;bg.*.hint=10;}
        if(p1.*.d0<=110 && hp2>110 && bg.*.fired==0){bg.*.fired=1;bg.*.hint=11;}
        return;
    }
    if(task==T_COLORDISC){
        let w:i32=f_gu32(b,0) as i32;let h:i32=f_gu32(b,4) as i32;
        let s1:[]i64=z_i64a(3);let s2:[]i64=z_i64a(3);
        s1[0]=0;s1[1]=0;s1[2]=0;s2[0]=0;s2[1]=0;s2[2]=0;
        let n:i64=0;let y:i32=0;
        while(y<h){
            let x:i32=0;
            while(x<w){
                let o:i32=8+(y*w+x)*3;
                bg.*.ops=bg.*.ops+1;
                if(x<w/2){s1[0]=s1[0]+(b[o] as i64);s1[1]=s1[1]+(b[o+1] as i64);s1[2]=s1[2]+(b[o+2] as i64);}
                else {s2[0]=s2[0]+(b[o] as i64);s2[1]=s2[1]+(b[o+1] as i64);s2[2]=s2[2]+(b[o+2] as i64);}
                x=x+4;
            }
            n=n+((w/8) as i64);y=y+1;
        }
        let d2:i64=0;let c:i32=0;
        while(c<3){
            let dd:i64=s1[c]/n-s2[c]/n;
            d2=d2+dd*dd;c=c+1;
        }
        
        let dist:i64=f1_isqrt(d2);
        if(f_abs64(dist-40)<8){bg.*.fired=1;bg.*.hint=0;}
        return;
    }
    if(task==T_COLORCONST){
        let w:i32=f_gu32(b,0) as i32;let h:i32=f_gu32(b,4) as i32;
        let mx1:[]i64=z_i64a(3);let mx2:[]i64=z_i64a(3);
        let c1:[]i64=z_i64a(3);let c2:[]i64=z_i64a(3);
        let c:i32=0;
        while(c<3){mx1[c]=-1;mx2[c]=-1;c1[c]=0;c2[c]=0;c=c+1;}
        let y:i32=0;
        while(y<h){
            let x:i32=0;
            while(x<w){
                let o:i32=8+(y*w+x)*3;
                bg.*.ops=bg.*.ops+1;
                c=0;
                while(c<3){
                    let v:i64=b[o+c] as i64;
                    if(x<w/2){
                        if(v>mx1[c]){mx1[c]=v;c1[c]=1;}
                        else if(v==mx1[c]){c1[c]=c1[c]+1;}
                    } else {
                        if(v>mx2[c]){mx2[c]=v;c2[c]=1;}
                        else if(v==mx2[c]){c2[c]=c2[c]+1;}
                    }
                    c=c+1;
                }
                x=x+1;
            }
            y=y+1;
        }
        c=0;
        while(c<3){
            if(c1[c]<=2 || c2[c]<=2){bg.*.fired=1;bg.*.hint=10;}
            c=c+1;
        }
        
        return;
    }
    if(task==T_MOTION){
        let w:i32=f_gu32(b,4) as i32;let h:i32=f_gu32(b,8) as i32;
        let f:i32=0;
        while(f<8){
            if(f!=0 && f!=7){f=f+1;continue;}
            let y:i32=0;
            while(y<h){
                let x:i32=0;
                while(x<w){
                    let o:i32=12+f*w*h*3+(y*w+x)*3;
                    bg.*.ops=bg.*.ops+1;
                    let m:i64=b[o] as i64;let g:i64=b[o+1] as i64;let bl:i64=b[o+2] as i64;
                    let mm:i64=m;if(g<mm){mm=g;} if(bl<mm){mm=bl;}
                    if(mm>200){
                        bg.*.fired=1;
                        bg.*.hint=((x as i64)*1000)+(y as i64);
                    }
                    x=x+2;
                }
                y=y+2;
            }
            f=f+1;
        }
        return;
    }
}

// ---------- pass-2 resample: CHANGED evidence only ----------
// Each selector examines different samples/regions/decoders than pass 1.
// The used-mask in main() makes same-evidence reruns structurally impossible.
fn rs_pitch_win(sel:i32)[]i64 {
    let r:[]i64=z_i64a(2);
    if(sel==10){r[0]=14336;r[1]=2048;}
    else if(sel==11){r[0]=10240;r[1]=2048;}
    else if(sel==12){r[0]=8192;r[1]=8192;}
    else {r[0]=6144;r[1]=2048;}
    return r;
}
fn rs_pitch(b:[]u8,sel:i32,fA:i64,p:*Pc)void {
    let r:[]i64=rs_pitch_win(sel);
    let off:i32=r[0] as i32;let n:i32=r[1] as i32;
    
    let f:i64=f1_zc_freq(b,8+off*2,n,44100,&p.*.ops);
    p.*.d0=f;p.*.d1=fA;p.*.ev=sel;
    if(f<=0 || fA<=0){p.*.label=L_SAME;p.*.conf=0;p.*.d2=0;return;}
    let rel:i64=(f_abs64(f-fA)*1000000)/fA;
    p.*.d2=rel;
    if(rel<20000){p.*.label=L_SAME;}
    else if(f>fA){p.*.label=L_HIGHER;}
    else {p.*.label=L_LOWER;}
    let c:i64=(f_abs64(rel-20000)*1000)/20000;
    if(c>1000){c=1000;}
    p.*.conf=c as i32;
}
fn rs_timbre_win(sel:i32)[]i64 {
    let r:[]i64=z_i64a(2);
    if(sel==10){r[0]=2048;r[1]=2048;}
    else if(sel==11){r[0]=4096;r[1]=4096;}
    else {r[0]=0;r[1]=8192;}
    return r;
}
fn rs_timbre(b:[]u8,sel:i32,p:*Pc)void {
    let r:[]i64=rs_timbre_win(sel);
    let off:i32=r[0] as i32;let n:i32=r[1] as i32;
    
    let et:i64=0;let i:i32=0;
    while(i<n){et=et+f_abs64(f_gi16(b,8+(off+i)*2) as i64);i=i+1;}
    p.*.ops=p.*.ops+n as i64;
    let eh:i64=0;let pv:i64=f_gi16(b,8+off*2) as i64;i=1;
    while(i<n){
        let v:i64=f_gi16(b,8+(off+i)*2) as i64;
        eh=eh+f_abs64(v-pv);pv=v;i=i+1;
        p.*.ops=p.*.ops+1;
    }
    let hp:i64=(eh*1000)/f_max64(et,1);
    p.*.d0=hp;p.*.ev=sel;
    if(hp<=67){p.*.label=L_PURE;}
    else if(hp<=82){p.*.label=L_DARK;}
    else if(hp<=110){p.*.label=L_RICH;}
    else {p.*.label=L_BRIGHT;}
    let m:i64=f_abs64(hp-67);
    let m2:i64=f_abs64(hp-82);if(m2<m){m=m2;}
    let m3:i64=f_abs64(hp-110);if(m3<m){m=m3;}
    let c:i64=(m*1000)/60;
    if(c>1000){c=1000;}
    p.*.conf=c as i32;
}
// region half-means for COLORDISC selectors 10/11/12
fn rs_disc_region(b:[]u8,w:i32,h:i32,sel:i32,m1:*i64,m2:*i64,ops:*i64)void {
    let s1r:i64=0;let s1g:i64=0;let s1b:i64=0;
    let s2r:i64=0;let s2g:i64=0;let s2b:i64=0;
    let n:i64=0;
    let y:i32=0;
    while(y<h){
        let yuse:i32=1;
        if(sel==10 && y>=32){yuse=0;}
        if(sel==11 && y<32){yuse=0;}
        if(yuse==1){
            let x:i32=0;
            while(x<w){
                let xuse:i32=1;
                if(sel==12 && (x<16 || x>=48)){xuse=0;}
                if(xuse==1){
                    let o:i32=8+(y*w+x)*3;
                    ops.*=ops.*+1;
                    if(x<w/2){s1r=s1r+(b[o] as i64);s1g=s1g+(b[o+1] as i64);s1b=s1b+(b[o+2] as i64);}
                    else {s2r=s2r+(b[o] as i64);s2g=s2g+(b[o+1] as i64);s2b=s2b+(b[o+2] as i64);}
                    n=n+1;
                }
                x=x+1;
            }
        }
        y=y+1;
    }
    let hn:i64=n/2;
    m1[0]=s1r/hn;m1[1]=s1g/hn;m1[2]=s1b/hn;
    m2[0]=s2r/hn;m2[1]=s2g/hn;m2[2]=s2b/hn;
}
fn rs_disc(b:[]u8,w:i32,h:i32,sel:i32,p:*Pc)void {
    let mp:*i64=_zag_malloc(48) as *i64;
    let m1:[]i64=mp[0..3];let m2:[]i64=mp[3..6];
    if(sel==13){
        // ALTDEC: different decoder (per-channel max abs diff), same halves
        let x1:[]i64=mp[6..9];let x2:[]i64=mp[9..12];
        let vr:[]i64=mp[12..14];
        f1_halves(b,w,h,&m1[0],&m2[0],&x1[0],&x2[0],&vr[0],&p.*.ops);
        let md:i64=0;let c:i32=0;
        while(c<3){
            let dd:i64=f_abs64(m1[c]-m2[c]);
            if(dd>md){md=dd;}
            c=c+1;
        }
        p.*.d0=md;p.*.ev=sel;
        if(md<40){p.*.label=L_SAME;} else {p.*.label=L_DIFFERENT;}
        let cf:i64=(f_abs64(md-40)*1000)/40;
        if(cf>1000){cf=1000;}
        p.*.conf=cf as i32;
        _zag_free(mp as *i8);
        return;
    }
    rs_disc_region(b,w,h,sel,&m1[0],&m2[0],&p.*.ops);
    let d2:i64=(m1[0]-m2[0])*(m1[0]-m2[0])+(m1[1]-m2[1])*(m1[1]-m2[1])+(m1[2]-m2[2])*(m1[2]-m2[2]);
    let dist:i64=f1_isqrt(d2);
    p.*.d0=dist;p.*.ev=sel;
    if(dist<40){p.*.label=L_SAME;} else {p.*.label=L_DIFFERENT;}
    let c:i64=(f_abs64(dist-40)*1000)/40;
    if(c>1000){c=1000;}
    p.*.conf=c as i32;
    _zag_free(mp as *i8);
}
// robust illuminant: second-largest value per channel per half
fn rs_const_robust(b:[]u8,w:i32,h:i32,il1:*i64,il2:*i64,ops:*i64)void {
    let m1:[]i64=z_i64a(3);let m2:[]i64=z_i64a(3);
    let s1:[]i64=z_i64a(3);let s2:[]i64=z_i64a(3);
    let c:i32=0;
    while(c<3){m1[c]=-1;m2[c]=-1;s1[c]=-1;s2[c]=-1;c=c+1;}
    let n:i64=0;let y:i32=0;
    while(y<h){
        let x:i32=0;
        while(x<w){
            let o:i32=8+(y*w+x)*3;
            ops.*=ops.*+1;
            c=0;
            while(c<3){
                let v:i64=b[o+c] as i64;
                if(x<w/2){
                    if(v>m1[c]){s1[c]=m1[c];m1[c]=v;}
                    else if(v>s1[c]){s1[c]=v;}
                } else {
                    if(v>m2[c]){s2[c]=m2[c];m2[c]=v;}
                    else if(v>s2[c]){s2[c]=v;}
                }
                c=c+1;
            }
            x=x+1;
        }
        n=n+1;y=y+1;
    }
    c=0;
    while(c<3){
        if(s1[c]<0){s1[c]=m1[c];}
        if(s2[c]<0){s2[c]=m2[c];}
        il1[c]=s1[c];il2[c]=s2[c];
        c=c+1;
    }
    
}
fn rs_const(b:[]u8,w:i32,h:i32,sel:i32,p:*Pc,disagree:*i32)void {
    let mp:*i64=_zag_malloc(160) as *i64;
    let m1:[]i64=mp[0..3];let m2:[]i64=mp[3..6];
    let x1:[]i64=mp[6..9];let x2:[]i64=mp[9..12];
    let vr:[]i64=mp[12..14];
    let r1:[]i64=mp[14..17];let r2:[]i64=mp[17..20];
    f1_halves(b,w,h,&m1[0],&m2[0],&x1[0],&x2[0],&vr[0],&p.*.ops);
    p.*.ev=sel;
    if(sel==11){
        // ABSOLUTE decoder: no illuminant discount at all
        let md:i64=0;let c:i32=0;
        while(c<3){
            let dd:i64=f_abs64(m1[c]-m2[c]);
            if(dd>md){md=dd;}
            c=c+1;
        }
        p.*.d0=md;
        if(md<8){p.*.label=L_SAMESURF;} else {p.*.label=L_DIFFERENT;}
        let cf:i64=(f_abs64(md-8)*1000)/8;
        if(cf>1000){cf=1000;}
        p.*.conf=cf as i32;
        _zag_free(mp as *i8);
        return;
    }
    // sel 10 or 12: robust-discount decoder
    rs_const_robust(b,w,h,&r1[0],&r2[0],&p.*.ops);
    let md:i64=0;let c:i32=0;
    while(c<3){
        let d1:i64=(m1[c]*255)/f_max64(r1[c],1);
        let d2:i64=(m2[c]*255)/f_max64(r2[c],1);
        let dd:i64=f_abs64(d1-d2);
        if(dd>md){md=dd;}
        c=c+1;
    }
    p.*.d0=md;
    if(sel==12){
        // CONSENSUS: DIFFERENT if robust-discount OR absolute says so
        let am:i64=0;c=0;
        while(c<3){
            let dd:i64=f_abs64(m1[c]-m2[c]);
            if(dd>am){am=dd;}
            c=c+1;
        }
        if(md>=8 || am>=8){p.*.label=L_DIFFERENT;}
        else {p.*.label=L_SAMESURF;}
        p.*.d1=am;
    } else {
        if(md<8){p.*.label=L_SAMESURF;} else {p.*.label=L_DIFFERENT;}
    }
    let cf:i64=(f_abs64(md-8)*1000)/8;
    if(cf>1000){cf=1000;}
    p.*.conf=cf as i32;
    _zag_free(mp as *i8);
}
// bright-target tracker over frames [f0,f1]; direction first->last frame
// that contains a bright cluster. Different evidence AND different decoder
// than pass 1 (global brightness centroid on frames 0,7 only).
fn rs_track(b:[]u8,w:i32,h:i32,f0:i32,f1:i32,p:*Pc)void {
    let fx:i64=0;let fy:i64=0;let lx:i64=0;let ly:i64=0;
    let found:i32=0;
    let f:i32=f0;
    while(f<=f1){
        let sx:i64=0;let sy:i64=0;let n:i64=0;
        let y:i32=0;
        while(y<h){
            let x:i32=0;
            while(x<w){
                let o:i32=12+f*w*h*3+(y*w+x)*3;
                p.*.ops=p.*.ops+1;
                let m:i64=b[o] as i64;let g:i64=b[o+1] as i64;let bl:i64=b[o+2] as i64;
                let mm:i64=m;if(g<mm){mm=g;} if(bl<mm){mm=bl;}
                if(mm>200){sx=sx+(x as i64);sy=sy+(y as i64);n=n+1;}
                x=x+1;
            }
            y=y+1;
        }
        if(n>0){
            let cx:i64=(sx*64)/n;let cy:i64=(sy*64)/n;
            if(found==0){fx=cx;fy=cy;found=1;}
            lx=cx;ly=cy;
        }
        f=f+1;
    }
    p.*.d0=lx-fx;p.*.d1=ly-fy;
    if(found==0){
        // degenerate: no bright target anywhere; keep pass-1, zero confidence
        p.*.conf=0;
        return;
    }
    p.*.label=f1_mdir(lx-fx,ly-fy);
    let c:i64=(f_max64(f_abs64(lx-fx),f_abs64(ly-fy))*1000)/512;
    if(c>1000){c=1000;}
    p.*.conf=c as i32;
}
fn rs_resample(task:i32,b:[]u8,sel:i32,p1:*Pc,p:*Pc,disagree:*i32)void {
    p.*.task=task;p.*.label=L_NONE;p.*.conf=0;p.*.ev=sel;
    p.*.d0=0;p.*.d1=0;p.*.d2=0;p.*.ops=0;
    if(task==T_PITCH){rs_pitch(b,sel,p1.*.d0,p);return;}
    if(task==T_TIMBRE){rs_timbre(b,sel,p);return;}
    let w:i32=f_gu32(b,0) as i32;let h:i32=f_gu32(b,4) as i32;
    if(task==T_COLORDISC){rs_disc(b,w,h,sel,p);return;}
    if(task==T_COLORCONST){rs_const(b,w,h,sel,p,disagree);return;}
    // .vid layout is (nframes,width,height) — NOT (width,height) like .img
    let nf:i32=f_gu32(b,0) as i32;
    let mw:i32=f_gu32(b,4) as i32;let mh:i32=f_gu32(b,8) as i32;
    if(sel==11){rs_track(b,mw,mh,1,nf-2,p);}
    else {rs_track(b,mw,mh,0,nf-1,p);}
    p.*.ev=sel;
    if(p.*.label==L_NONE){
        // degenerate: no bright target in any frame; fall back to pass-1
        // label with zero confidence (uncertainty -> provisional install)
        p.*.label=p1.*.label;
    }
}
// evidence bytes hashed for the ledger (proves changed evidence)
fn rs_evhash(task:i32,b:[]u8,sel:i32)[]u8 {
    if(task==T_PITCH){
        let r:[]i64=rs_pitch_win(sel);
        let off:i32=r[0] as i32;let n:i32=r[1] as i32;
        
        return f2_sha256(b[8+off*2..8+(off+n)*2]);
    }
    if(task==T_TIMBRE){
        let r:[]i64=rs_timbre_win(sel);
        let off:i32=r[0] as i32;let n:i32=r[1] as i32;
        
        return f2_sha256(b[8+off*2..8+(off+n)*2]);
    }
    return f2_sha256(b);
}
// ---------- trigger evaluation ----------
fn f2_trigger(task:i32,conf:i32,ev:i32,used:i64,acq:i32,bg_eff:i32)[]i64 {
    let out:[]i64=z_i64a(1);
    out[0]=TR_NONE as i64;
    if(conf<CONF_BAR){out[0]=TR_UNCERTAIN as i64;return out;}
    if(f2_stake(task)==1 && acq==0){out[0]=TR_COVERAGE as i64;return out;}
    if(task==T_MOTION && ev!=10 && ev!=11){out[0]=TR_GOAL as i64;return out;}
    if(task==T_COLORCONST){
        let has:i32=0;
        if(f2_sel_used(used,11)==1){has=1;}
        if(f2_sel_used(used,12)==1){has=1;}
        if(has==0){out[0]=TR_DIVERSITY as i64;return out;}
    }
    if(bg_eff==1){out[0]=TR_BG as i64;return out;}
    return out;
}

// ---------- adjudication + install ----------
fn f2_parse_dec(s:[]u8)i64 {
    let v:i64=0;let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c>=48 && c<=57){v=v*10+((c-48) as i64);}
        i=i+1;
    }
    return v;
}
fn f2_majority(vl:[]i64,vn:i32,latest:i32)i32 {
    let cnt:[]i64=z_i64a(19);
    let i:i32=0;
    while(i<19){cnt[i]=0;i=i+1;}
    i=0;
    while(i<vn){
        let l:i32=vl[i] as i32;
        if(l>=0 && l<19){cnt[l]=cnt[l]+1;}
        i=i+1;
    }
    let best:i32=latest;let bn:i64=-1;
    // newest-first: ties resolve to the latest (freshest) acquisition
    let i:i32=vn-1;
    while(i>=0){
        let l:i32=vl[i] as i32;
        if(l>=0 && l<19 && cnt[l]>bn){bn=cnt[l];best=l;}
        i=i-1;
    }
    
    return best;
}
fn f2_votes_str(vl:[]i64,vn:i32)[]u8 {
    let cnt:[]i64=z_i64a(19);
    let i:i32=0;
    while(i<19){cnt[i]=0;i=i+1;}
    i=0;
    while(i<vn){
        let l:i32=vl[i] as i32;
        if(l>=0 && l<19){cnt[l]=cnt[l]+1;}
        i=i+1;
    }
    let k:Kv=kv_init();
    i=0;
    while(i<19){
        if(cnt[i]>0){kv_i(&k,f1_label_str(i),cnt[i]);}
        i=i+1;
    }
    
    let s:[]u8=kv_str(&k);
    return s;
}
fn f2_write_verdict(path:[]u8,content:[]u8)void {
    f_write_file(path,content);
}
fn main()i32 {
    let fixture:[]u8=_zag_arg(1);
    let outpre:[]u8=_zag_arg(2);
    let cap:i64=100000;
    let caps:[]u8=_zag_arg(3);
    if(caps.len>0){cap=f2_parse_dec(caps);}
    let lg:Lg=lg_init();
    let plg:*Lg=&lg;
    // P1_PLAN: declare sampling policy + loss bounds BEFORE any sample
    let kp:Kv=kv_init();let kpp:*Kv=&kp;
    kv_s(kpp,"sampling","pitch:winA[0:2048]+winB[8192:10240]zc20000ppm;timbre:win[0:2048]hp1000-67/82/110;colordisc:halfmean-euclid40;const:whitepatchmax-discount8;motion:centroid-f0f7-8way");
    kv_s(kpp,"loss","pitch:blind-lateB-event+early-window;timbre:blind-post2048;colordisc:sub-boundary;const:spike-corrupts-illuminant+discount-collision;motion:distractor-dominance");
    kv_s(kpp,"lossbounds","pitch:20000ppm;timbre:60hp;colordisc:40dist;const:8disc;motion:2px");
    kv_s(kpp,"stake","HIGH:pitch+motion;LOW:timbre+colordisc+const");
    kv_s(kpp,"triggers","NAIVE-uncertain-conf<900;coverage-stakeHIGH-acq0;goal-motion-untracked;diversity-const-noabsolute;bg-interrupt");
    kv_s(kpp,"budget","FIXED-2-acq+maxverifydepth2");
    kv_i(kpp,"opcap",cap);
    lg_add(plg,"P1_PLAN",0,kv_str(&kp));
    // read stimulus
    let flen:i32=0;
    let b:[]u8=f_read_all(fixture,&flen);
    let vpath:[]u8=nio_alloc(outpre.len+16);
    let vi:i32=0;
    while(vi<outpre.len){vpath[vi]=outpre[vi];vi=vi+1;}
    let vsuf:[]u8=".verdict";
    let li:i32=0;
    while(li<8){vpath[outpre.len+li]=vsuf[li];li=li+1;}
    let vpathf:[]u8=vpath[0..outpre.len+8];
    let lpath:[]u8=nio_alloc(outpre.len+16);
    vi=0;
    while(vi<outpre.len){lpath[vi]=outpre[vi];vi=vi+1;}
    let lsuf:[]u8=".ledger";
    li=0;
    while(li<7){lpath[outpre.len+li]=lsuf[li];li=li+1;}
    let lpathf:[]u8=lpath[0..outpre.len+7];
    if(flen<0){
        let kv0:Kv=kv_init();
        kv_s(&kv0,"fixture",fixture);
        kv_s(&kv0,"task","UNKNOWN");
        kv_s(&kv0,"final","NONE");
        kv_s(&kv0,"authority","provisional");
        kv_s(&kv0,"note","read-error");
        f2_write_verdict(vpathf,kv_str(&kv0));
        lg_add(plg,"FALLBACK",11,"reason=read-error");
        lg_save(plg,lpathf);
        return 0;
    }
    let fsha:[]u8=f2_sha256(b);
    let fhx:[]u8=nio_alloc(64);
    lg_hexword(fhx,0,fsha);
    let k1:Kv=kv_init();
    kv_i(&k1,"ev",1);kv_i(&k1,"bytes",flen as i64);kv_s(&k1,"sha",fhx);
    lg_add(plg,"P1_SAMPLE",1,kv_str(&k1));
    // PASS 1 (frozen F1, bit-exact)
    let p1:Pc=Pc{.task=0,.label=0,.conf=0,.ev=0,.d0=0,.d1=0,.d2=0,.ops=0};
    let rc:i32=f1_perceive(fixture,b,&p1);
    if(rc!=0){
        let kv0:Kv=kv_init();
        kv_s(&kv0,"fixture",fixture);
        kv_s(&kv0,"task","UNKNOWN");
        kv_s(&kv0,"final","NONE");
        kv_s(&kv0,"authority","provisional");
        kv_s(&kv0,"note","unsupported-format");
        f2_write_verdict(vpathf,kv_str(&kv0));
        lg_add(plg,"FALLBACK",11,"reason=unsupported-format");
        lg_save(plg,lpathf);
        return 0;
    }
    let task:i32=p1.task;
    let k2:Kv=kv_init();
    kv_s(&k2,"label",f1_label_str(p1.label));
    kv_i(&k2,"conf",p1.conf as i64);
    kv_i(&k2,"d0",p1.d0);kv_i(&k2,"d1",p1.d1);kv_i(&k2,"d2",p1.d2);
    kv_i(&k2,"ops",p1.ops);
    lg_add(plg,"P1_PERCEPT",2,kv_str(&k2));
    // BACKGROUND scan (interrupt-only: cannot install)
    let bg:Bg=Bg{.fired=0,.hint=0,.ops=0};
    bg_scan(task,b,&p1,&bg);
    let k3:Kv=kv_init();
    kv_i(&k3,"fired",bg.fired as i64);
    kv_i(&k3,"hint",bg.hint);
    kv_i(&k3,"ops",bg.ops);
    lg_add(plg,"BG_SCAN",3,kv_str(&k3));
    if(bg.fired==1){
        let k4:Kv=kv_init();
        kv_i(&k4,"hint",bg.hint);
        kv_s(&k4,"note","background-wake-deliberation");
        lg_add(plg,"INTERRUPT",4,kv_str(&k4));
    }
    let ops_total:i64=p1.ops+bg.ops;
    let ops_p1:i64=p1.ops;let ops_bg:i64=bg.ops;
    let ops_p2:i64=0;let ops_verify:i64=0;
    // deliberation state
    let vl:[]i64=z_i64a(8);
    let vc:[]i64=z_i64a(8);
    vl[0]=p1.label as i64;vc[0]=p1.conf as i64;
    let vn:i32=1;
    let min_conf:i32=p1.conf;
    let used:i64=0;
    let acq:i32=0;
    let disagreement:i32=0;
    let cur:Pc=p1;
    let trg:[]i64=f2_trigger(task,p1.conf,p1.ev,used,acq,bg.fired);
    let tcode:i32=trg[0] as i32;
    
    let k5:Kv=kv_init();
    kv_i(&k5,"code",tcode as i64);
    kv_s(&k5,"name",f2_tr_str(tcode));
    lg_add(plg,"TRIGGER",5,kv_str(&k5));
    let budget_hit:i32=0;
    let selb:[]u8=nio_alloc(64);
    let selat:i32=0;
    // F3 UNTRAINED: whenever the (naive) trigger fires, take exactly
    // F3_FIXED_ROUNDS pass-2 acquisitions in fixed selector order —
    // no trigger-gated continuation, no hint guidance.
    if(tcode!=TR_NONE){
        let fr:i32=0;
        while(fr<F3_FIXED_ROUNDS){
            let sel:i32=f3_choose_fixed(task,used) as i32;
            if(sel==0){
                let kb:Kv=kv_init();
                kv_s(&kb,"reason","selectors-exhausted");
                kv_i(&kb,"acq",acq as i64);
                lg_add(plg,"BUDGET",8,kv_str(&kb));
                budget_hit=1;
                break;
            }
            let est:i64=f2_est_cost(task,sel);
            if(ops_total+est>cap){
                let kb2:Kv=kv_init();
                kv_s(&kb2,"reason","op-deadline");
                kv_i(&kb2,"acq",acq as i64);
                kv_i(&kb2,"ops",ops_total);
                kv_i(&kb2,"cap",cap);
                lg_add(plg,"BUDGET",8,kv_str(&kb2));
                budget_hit=1;
                break;
            }
            let p2:Pc=Pc{.task=0,.label=0,.conf=0,.ev=0,.d0=0,.d1=0,.d2=0,.ops=0};
            let dg2:i32=0;
            rs_resample(task,b,sel,&p1,&p2,&dg2);
            let eh:[]u8=rs_evhash(task,b,sel);
            let ehx:[]u8=nio_alloc(64);
            lg_hexword(ehx,0,eh);
            ops_total=ops_total+p2.ops;
            ops_p2=ops_p2+p2.ops;
            let k6:Kv=kv_init();
            kv_i(&k6,"ev",sel as i64);
            kv_s(&k6,"label",f1_label_str(p2.label));
            kv_i(&k6,"conf",p2.conf as i64);
            kv_i(&k6,"ops",p2.ops);
            kv_s(&k6,"evsha",ehx);
            lg_add(plg,"P2_ACQ",6,kv_str(&k6));
            nio_free(ehx);
            acq=acq+1;
            used=used|((1 as i64)<<sel);
            vl[vn]=p2.label as i64;vc[vn]=p2.conf as i64;vn=vn+1;
            if(p2.conf<min_conf){min_conf=p2.conf;}
            if(p2.label!=p1.label){disagreement=1;}
            let sn:[]u8=f_i64s(sel as i64);
            let si:i32=0;
            while(si<sn.len){selb[selat]=sn[si];selat=selat+1;si=si+1;}
            selb[selat]=44;selat=selat+1;
            cur=p2;
            fr=fr+1;
        }
        budget_hit=1;
    }
    if(budget_hit==1){
        let kc:Kv=kv_init();
        kv_i(&kc,"pinned",1);
        kv_i(&kc,"past_budget",0);
        kv_s(&kc,"trigger","fixed-budget-2");
        lg_add(plg,"CAPTURE",9,kv_str(&kc));
    }
    // provisional reasons
    let pr:Kv=kv_init();
    let npr:i32=0;
    if(min_conf<CONF_BAR){kv_s(&pr,"r","uncertainty");npr=npr+1;}
    if(disagreement==1){kv_s(&pr,"r","decoder-disagreement");npr=npr+1;}
    if(budget_hit==1){kv_s(&pr,"r","budget-exhausted");npr=npr+1;}
    // install-time verification (high stakes only)
    let authority:i32=AU_DIRECT;
    let verify_done:i32=0;let vagree:i32=0;
    let vrounds:i32=0;
    if(f2_stake(task)==1 && npr==0 && cur.conf>=CONF_BAR && vrounds<MAX_VERIFY_DEPTH){
        let vsel:i32=0;let li2:i32=0;
        while(li2<4){
            let cand:i32=f2_sel_list(task,li2);
            if(cand!=0 && f2_sel_used(used,cand)==0){vsel=cand;break;}
            li2=li2+1;
        }
        if(vsel==0){
            kv_s(&pr,"r","no-fresh-evidence");npr=npr+1;
        } else if(ops_total+f2_est_cost(task,vsel)>cap){
            kv_s(&pr,"r","verify-deadline");npr=npr+1;
        } else {
            let vv:Pc=Pc{.task=0,.label=0,.conf=0,.ev=0,.d0=0,.d1=0,.d2=0,.ops=0};
            let dg3:i32=0;
            rs_resample(task,b,vsel,&p1,&vv,&dg3);
            ops_total=ops_total+vv.ops;
            ops_verify=ops_verify+vv.ops;
            acq=acq+1;
            used=used|((1 as i64)<<vsel);
            vl[vn]=vv.label as i64;vc[vn]=vv.conf as i64;vn=vn+1;
            if(vv.conf<min_conf){min_conf=vv.conf;}
            vrounds=vrounds+1;
            verify_done=1;
            if(vv.label==cur.label){vagree=1;} else {vagree=0;}
            let k8:Kv=kv_init();
            kv_i(&k8,"ev",vsel as i64);
            kv_s(&k8,"label",f1_label_str(vv.label));
            kv_i(&k8,"conf",vv.conf as i64);
            kv_i(&k8,"agree",vagree as i64);
            kv_i(&k8,"depth",vrounds as i64);
            lg_add(plg,"VERIFY",7,kv_str(&k8));
            if(vagree==1){authority=AU_VERIFIED;}
            else {kv_s(&pr,"r","verify-disagreement");npr=npr+1;disagreement=1;}
        }
    }
    if(min_conf<CONF_BAR && npr==0){kv_s(&pr,"r","uncertainty");npr=npr+1;}
    // final label
    let finallabel:i32=cur.label;
    let finalconf:i32=cur.conf;
    if(npr>0){
        authority=AU_PROVISIONAL;
        finallabel=f2_majority(vl,vn,cur.label);
        finalconf=cur.conf;
        let vi2:i32=vn-1;
        while(vi2>=0){
            if((vl[vi2] as i32)==finallabel){finalconf=vc[vi2] as i32;break;}
            vi2=vi2-1;
        }
    } else if(authority!=AU_VERIFIED){
        authority=AU_DIRECT;
    }
    let k9:Kv=kv_init();
    kv_s(&k9,"label",f1_label_str(finallabel));
    kv_i(&k9,"conf",finalconf as i64);
    kv_s(&k9,"authority",f2_auth_str(authority));
    kv_i(&k9,"acq",acq as i64);
    kv_i(&k9,"ops_total",ops_total);
    lg_add(plg,"INSTALL",10,kv_str(&k9));
    if(npr>0){
        lg_add(plg,"FALLBACK",11,kv_str(&pr));
    }
    // verdict file
    let kvv:Kv=kv_init();let kvvp:*Kv=&kvv;
    kv_s(kvvp,"fixture",fixture);
    kv_s(kvvp,"task",f1_task_str(task));
    kv_s(kvvp,"p1",f1_label_str(p1.label));
    kv_i(kvvp,"p1conf",p1.conf as i64);
    kv_i(kvvp,"p1ops",ops_p1);
    kv_i(kvvp,"bg",bg.fired as i64);
    kv_i(kvvp,"bghint",bg.hint);
    kv_i(kvvp,"bgops",ops_bg);
    kv_i(kvvp,"rounds",acq as i64);
    kv_s(kvvp,"selectors",selb[0..selat]);
    kv_i(kvvp,"minconf",min_conf as i64);
    kv_s(kvvp,"final",f1_label_str(finallabel));
    kv_i(kvvp,"finalconf",finalconf as i64);
    kv_s(kvvp,"authority",f2_auth_str(authority));
    kv_i(kvvp,"disagreement",disagreement as i64);
    kv_i(kvvp,"verify_done",verify_done as i64);
    kv_i(kvvp,"verify_agree",vagree as i64);
    kv_i(kvvp,"ops_p2",ops_p2);
    kv_i(kvvp,"ops_verify",ops_verify);
    kv_i(kvvp,"ops_total",ops_total);
    kv_i(kvvp,"opcap",cap);
    kv_i(kvvp,"budget_hit",budget_hit as i64);
    kv_s(kvvp,"votes",f2_votes_str(vl,vn));
    kv_s(kvvp,"policy","untrained");
    f2_write_verdict(vpathf,kv_str(&kvv));
    lg_save(plg,lpathf);
    
    return 0;
}

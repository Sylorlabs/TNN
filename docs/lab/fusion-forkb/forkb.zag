// forkb.zag — FUSION FORK B: closed-loop imagination.
//
// Micah's order (2026-09-26 ~10:40 PDT): "I think it's the architecture — it's
// not discovered yet. It's not even able to identify the head or match
// background, it's just a black blob. Let TNN see its result — don't just let
// TNN imagine it without it knowing what it's imagining."
//
// Two pillars:
//   PILLAR 1 — TNN SEES ITS OWN RESULT. Render -> perceive the render with
//     TNN's own bit-exact vision (raw PPM P6 intake, verbatim byte copy —
//     intake fidelity verdict 2026-09-26: INTAKE IS BIT-EXACT) -> deliberate
//     in TNN's own trace -> adjust -> re-render. Every round recorded:
//     what its eyes caught, what changed, why.
//   PILLAR 2 — TNN-NATIVE ARCHITECTURE DISCOVERY. The fusion architecture
//     (which operators compose, in what order, with what bindings) is produced
//     by TNN's own deliberation over its own perceptual evidence. The
//     substrate (operators, measures, propose/critic/evaluate roles, taught
//     knowledge, preregistered bars) is crew-authored generic machinery —
//     declared in SUBSTRATE.md. The ARCHITECTURE is TNN's.
//
// Hard wall (standing): the donor's face is never observed (head-down in all
// 24 frames). Faking an unseen face is BANNED. If TNN's own judgment is that
// this pair cannot yield a front head swap, it says so and renders only what
// is honest.
//
// Pure Zag. Zero RNG. Byte-identical reruns (verify x2).
// Pinned toolchain: znc_linux_x86_64_abed8aa1.
@import("R33_NATIVE_IO_V1.zag")

// ---------------- u64/i64 LE helpers ([]u8 arenas only; no narrow casts) ----
fn h_put64(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    b[o + 4] = ((v >> 32) & 255) as u8;
    b[o + 5] = ((v >> 40) & 255) as u8;
    b[o + 6] = ((v >> 48) & 255) as u8;
    b[o + 7] = ((v >> 56) & 255) as u8;
    return;
}
fn h_get64(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    v = v + (b[o + 4] as i64) * 4294967296 + (b[o + 5] as i64) * 1099511627776;
    v = v + (b[o + 6] as i64) * 281474976710656 + (b[o + 7] as i64) * 72057594037927936;
    return v;
}
fn h_put32(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    return;
}
fn h_get32(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    return v;
}
// ---------------- FNV-1a 64 ----------------
fn fnv(b:[]u8, o:i64, n:i64) i64 {
    let h:i64 = -3750763034362895579;
    let i:i64 = 0;
    while (i < n) {
        h = h ^ (b[o + i] as i64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}
// ---------------- trace builder (append-only text arena) ----------------
// tr layout: [0..8) pos i64; text from 16.
fn tr_init(cap:i64) []u8 {
    let t:[]u8 = nio_alloc(cap as i32);
    h_put64(t, 0, 0);
    return t;
}
fn tr_pos(t:[]u8) i64 { return h_get64(t, 0); }
fn tr_get(t:[]u8) []u8 {
    let p:i64 = h_get64(t, 0);
    return t[16 .. 16 + p];
}
fn tr_str(t:[]u8, s:[]u8) void {
    let p:i64 = h_get64(t, 0);
    let i:i64 = 0;
    while (i < s.len) { t[16 + p + i] = s[i]; i = i + 1; }
    h_put64(t, 0, p + s.len);
    return;
}
fn tr_i64(t:[]u8, v:i64) void {
    let neg:i64 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    if (u == 0) { tmp[0] = 48; n = 1; }
    while (u > 0) { tmp[n] = (48 + (u % 10)) as u8; u = u / 10; n = n + 1; }
    if (neg == 1) { tmp[n] = 45; n = n + 1; }
    let p:i64 = h_get64(t, 0);
    let i:i64 = 0;
    while (i < n) { t[16 + p + i] = tmp[n - 1 - i]; i = i + 1; }
    h_put64(t, 0, p + n);
    nio_free(tmp);
    return;
}
fn tr_nl(t:[]u8) void {
    let p:i64 = h_get64(t, 0);
    t[16 + p] = 10;
    h_put64(t, 0, p + 1);
    return;
}
fn tr_kv(t:[]u8, k:[]u8, v:i64) void {
    tr_str(t, k); tr_str(t, "="); tr_i64(t, v); tr_str(t, " ");
    return;
}
// ---------------- file IO ----------------
fn read_file(root:i64, name:[]u8, b:[]u8, maxn:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let n:i64 = nio_read_exact(fd, b, maxn as i32);
    nio_close(fd);
    return n;
}
fn write_file_all(root:i64, name:[]u8, b:[]u8, n:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 1);
    if (fd < 0) { return -1; }
    let done:i64 = 0;
    while (done < n) {
        let c:i64 = n - done;
        if (c > 1048576) { c = 1048576; }
        let part:[]u8 = b[done..done + c];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != c) { nio_close(fd); return -2; }
        done = done + c;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}
fn ensure_dir(path:[]u8) i64 {
    let rc:i64 = nio_mkdir(path);
    if (rc == 0) { return 0; }
    if (rc == -17) { return 0; }
    return rc;
}
// Proven bit-exact PPM P6 reader (verbatim byte copy; intake fidelity verdict:
// INTAKE IS BIT-EXACT). Fails loud on malformed input.
fn read_ppm_gen(root:i64, name:[]u8, px:[]u8, maxpx:i64, w_out:[]u8, h_out:[]u8) i64 {
    let buf:[]u8 = nio_alloc(1048576);
    if (buf.len == 0) { return -20; }
    let n:i64 = read_file(root, name, buf, 1048576);
    if (n < 0) { nio_free(buf); return -21; }
    if (n < 15) { nio_free(buf); return -22; }
    if (buf[0] != 80) { nio_free(buf); return -23; }
    if (buf[1] != 54) { nio_free(buf); return -23; }
    let p:i64 = 2;
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let w:i64 = 0;
    let nd:i64 = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { w = w * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -24; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let h:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { h = h * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -25; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let mv:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { mv = mv * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -26; }
    if (p >= n) { nio_free(buf); return -27; }
    let c:i64 = buf[p] as i64;
    if (c != 32) { if (c != 10) { if (c != 13) { if (c != 9) { nio_free(buf); return -28; } } } }
    p = p + 1;
    if (mv != 255) { nio_free(buf); return -29; }
    if (w <= 0) { nio_free(buf); return -30; }
    if (h <= 0) { nio_free(buf); return -30; }
    let need:i64 = w * h * 3;
    if (need > maxpx * 3) { nio_free(buf); return -31; }
    if (n != p + need) { nio_free(buf); return -32; }
    let i:i64 = 0;
    while (i < need) { px[i] = buf[p + i]; i = i + 1; }
    h_put64(w_out, 0, w);
    h_put64(h_out, 0, h);
    nio_free(buf);
    return 0;
}
// PPM P6 writer. Returns total bytes written into ob (caller writes to file).
fn write_ppm(px:[]u8, w:i64, h:i64, ob:[]u8) i64 {
    ob[0] = 80; ob[1] = 54; ob[2] = 10;
    let p:i64 = 3;
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    let v:i64 = w;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    let i:i64 = 0;
    while (i < n) { ob[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    ob[p] = 32; p = p + 1;
    n = 0; v = h;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    i = 0;
    while (i < n) { ob[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    ob[p] = 10; p = p + 1;
    ob[p] = 50; ob[p + 1] = 53; ob[p + 2] = 53; ob[p + 3] = 10; p = p + 4;
    let need:i64 = w * h * 3;
    i = 0;
    while (i < need) { ob[p + i] = px[i]; i = i + 1; }
    nio_free(tmp);
    return p + need;
}
// filename builder: pre + zero-padded 2-digit idx + ".ppm" into ob. Returns len.
fn mk_name(pre:[]u8, idx:i64, ob:[]u8) i64 {
    let p:i64 = 0;
    let i:i64 = 0;
    while (i < pre.len) { ob[p] = pre[i]; p = p + 1; i = i + 1; }
    ob[p] = (48 + (idx / 10)) as u8; p = p + 1;
    ob[p] = (48 + (idx % 10)) as u8; p = p + 1;
    ob[p] = 46; ob[p + 1] = 112; ob[p + 2] = 112; ob[p + 3] = 109; p = p + 4;
    return p;
}

// ---------------- vision: TNN's own eyes (bit-exact intake -> measurement) ---
// W=320 H=240 N=76800 fixed for this fork.
fn vis_luma(px:[]u8, gray:[]u8, n:i64) void {
    let i:i64 = 0;
    while (i < n) {
        let r:i64 = px[i * 3] as i64;
        let g:i64 = px[i * 3 + 1] as i64;
        let b:i64 = px[i * 3 + 2] as i64;
        gray[i] = ((r * 77 + g * 150 + b * 29) / 256) as u8;
        i = i + 1;
    }
    return;
}
fn vis_dark_mask(gray:[]u8, mask:[]u8, n:i64, thr:i64) void {
    let i:i64 = 0;
    while (i < n) {
        if ((gray[i] as i64) < thr) { mask[i] = 1; } else { mask[i] = 0; }
        i = i + 1;
    }
    return;
}
fn vis_bright_mask(gray:[]u8, mask:[]u8, n:i64, thr:i64) void {
    let i:i64 = 0;
    while (i < n) {
        if ((gray[i] as i64) > thr) { mask[i] = 1; } else { mask[i] = 0; }
        i = i + 1;
    }
    return;
}
// Flood fill from (sx,sy) over mask==1, marking seen=2. Returns area.
// Iterative scanline fill with explicit stack (no recursion).
fn vis_fill(mask:[]u8, seen:[]u8, w:i64, h:i64, sx:i64, sy:i64, stack:[]u8) i64 {
    let area:i64 = 0;
    let sp:i64 = 0;
    h_put32(stack, 0, sx); h_put32(stack, 4, sy); sp = 8;
    while (sp > 0) {
        sp = sp - 8;
        let x:i64 = h_get32(stack, sp);
        let y:i64 = h_get32(stack, sp + 4);
        if (x < 0) { continue; }
        if (x >= w) { continue; }
        if (y < 0) { continue; }
        if (y >= h) { continue; }
        let id:i64 = y * w + x;
        if (mask[id] != 1) { continue; }
        if (seen[id] == 1) { continue; }
        seen[id] = 1;
        area = area + 1;
        h_put32(stack, sp, x + 1); h_put32(stack, sp + 4, y); sp = sp + 8;
        h_put32(stack, sp, x - 1); h_put32(stack, sp + 4, y); sp = sp + 8;
        h_put32(stack, sp, x); h_put32(stack, sp + 4, y + 1); sp = sp + 8;
        h_put32(stack, sp, x); h_put32(stack, sp + 4, y - 1); sp = sp + 8;
    }
    return area;
}
// Largest connected component of mask==1 -> out (0/1). Returns area.
// seen/scratch: seen (n bytes), stack (n*8 bytes).
fn vis_fill_lab(mask:[]u8, lab:[]u8, w:i64, h:i64, x0:i64, y0:i64, stack:[]u8, lid:i64) i64 {
    // flood fill marking label lid into lab (i64 per pixel). Mark-on-push: each
    // pixel pushed at most once, so sp <= n always fits in the n*4 i64 stack.
    let sp:i64 = 1;
    let id0:i64 = y0 * w + x0;
    h_put64(lab, id0 * 8, lid);
    h_put64(stack, 0, id0);
    let c:i64 = 1;
    while (sp > 0) {
        sp = sp - 1;
        let id:i64 = h_get64(stack, sp * 8);
        let x:i64 = id % w;
        let y:i64 = id / w;
        if (x > 0) {
            let nid:i64 = id - 1;
            if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) {
                h_put64(lab, nid * 8, lid); h_put64(stack, sp * 8, nid); sp = sp + 1; c = c + 1; } }
        }
        if (x + 1 < w) {
            let nid:i64 = id + 1;
            if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) {
                h_put64(lab, nid * 8, lid); h_put64(stack, sp * 8, nid); sp = sp + 1; c = c + 1; } }
        }
        if (y > 0) {
            let nid:i64 = id - w;
            if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) {
                h_put64(lab, nid * 8, lid); h_put64(stack, sp * 8, nid); sp = sp + 1; c = c + 1; } }
        }
        if (y + 1 < h) {
            let nid:i64 = id + w;
            if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) {
                h_put64(lab, nid * 8, lid); h_put64(stack, sp * 8, nid); sp = sp + 1; c = c + 1; } }
        }
    }
    return c;
}
fn vis_dilate(m:[]u8, out:[]u8, w:i64, h:i64, r:i64) void {
    // box dilation by radius r (separable: horizontal then vertical, O(n*r))
    let tmp:[]u8 = nio_alloc(w * h);
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let v:i64 = 0;
            let dx:i64 = 0 - r;
            while (dx <= r) {
                let xx:i64 = x + dx;
                if (xx >= 0) { if (xx < w) { if (m[y * w + xx] == 1) { v = 1; } } }
                dx = dx + 1;
            }
            tmp[y * w + x] = v as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    y = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let v:i64 = 0;
            let dy:i64 = 0 - r;
            while (dy <= r) {
                let yy:i64 = y + dy;
                if (yy >= 0) { if (yy < h) { if (tmp[yy * w + x] == 1) { v = 1; } } }
                dy = dy + 1;
            }
            out[y * w + x] = v as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(tmp);
    return;
}
fn vis_largest(mask:[]u8, out:[]u8, lab:[]u8, stack:[]u8, w:i64, h:i64, n:i64) i64 {
    // Persistent per-pixel labels: each pixel flooded exactly once (O(n)).
    // lab must be n*8 bytes (i64 per pixel).
    let i:i64 = 0;
    while (i < n) { h_put64(lab, i * 8, 0); out[i] = 0; i = i + 1; }
    let best:i64 = 0;
    let bestlid:i64 = 0;
    let nl:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let id:i64 = y * w + x;
            if (mask[id] == 1) {
                if (h_get64(lab, id * 8) == 0) {
                    nl = nl + 1;
                    let a:i64 = vis_fill_lab(mask, lab, w, h, x, y, stack, nl);
                    if (a > best) { best = a; bestlid = nl; }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (bestlid > 0) {
        i = 0;
        while (i < n) { if (h_get64(lab, i * 8) == bestlid) { out[i] = 1; } i = i + 1; }
    }
    return best;
}
fn vis_bbox_centroid(m:[]u8, w:i64, h:i64, n:i64, out:[]u8) void {
    // out: x0,y0,x1,y1,cx1024,cy1024,count (7 x i64)
    let x0:i64 = w; let y0:i64 = h; let x1:i64 = -1; let y1:i64 = -1;
    let sx:i64 = 0; let sy:i64 = 0; let c:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            if (m[y * w + x] == 1) {
                if (x < x0) { x0 = x; }
                if (x > x1) { x1 = x; }
                if (y < y0) { y0 = y; }
                if (y > y1) { y1 = y; }
                sx = sx + x; sy = sy + y; c = c + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    h_put64(out, 0, x0); h_put64(out, 8, y0); h_put64(out, 16, x1); h_put64(out, 24, y1);
    if (c > 0) { h_put64(out, 32, sx * 1024 / c); } else { h_put64(out, 32, 0); }
    if (c > 0) { h_put64(out, 40, sy * 1024 / c); } else { h_put64(out, 40, 0); }
    h_put64(out, 48, c);
    return;
}
// 16-direction unit table (/1024), k*22.5 deg.
fn dir_cos(k:i64) i64 {
    if (k == 0) { return 1024; } if (k == 1) { return 946; }
    if (k == 2) { return 724; } if (k == 3) { return 388; }
    if (k == 4) { return 0; } if (k == 5) { return -388; }
    if (k == 6) { return -724; } if (k == 7) { return -946; }
    if (k == 8) { return -1024; } if (k == 9) { return -946; }
    if (k == 10) { return -724; } if (k == 11) { return -388; }
    if (k == 12) { return 0; } if (k == 13) { return 388; }
    if (k == 14) { return 724; }
    return 946;
}
fn dir_sin(k:i64) i64 {
    if (k == 0) { return 0; } if (k == 1) { return 388; }
    if (k == 2) { return 724; } if (k == 3) { return 946; }
    if (k == 4) { return 1024; } if (k == 5) { return 946; }
    if (k == 6) { return 724; } if (k == 7) { return 388; }
    if (k == 8) { return 0; } if (k == 9) { return -388; }
    if (k == 10) { return -724; } if (k == 11) { return -946; }
    if (k == 12) { return -1024; } if (k == 13) { return -946; }
    if (k == 14) { return -724; }
    return -388;
}
// Facing AXIS (unoriented): argmax projection spread over 16 dirs. Out: fx,fy /1024.
fn vis_axis(m:[]u8, w:i64, h:i64, bc:[]u8, out:[]u8) void {
    let x0:i64 = h_get64(bc, 0); let y0:i64 = h_get64(bc, 8);
    let x1:i64 = h_get64(bc, 16); let y1:i64 = h_get64(bc, 24);
    let bestk:i64 = 0;
    let bestsp:i64 = -1;
    let k:i64 = 0;
    while (k < 16) {
        let cx:i64 = dir_cos(k); let sx:i64 = dir_sin(k);
        let mn:i64 = 4611686018427387903; let mx:i64 = -4611686018427387903;
        let y:i64 = y0;
        while (y <= y1) {
            let x:i64 = x0;
            while (x <= x1) {
                if (m[y * w + x] == 1) {
                    let t:i64 = (x * cx + y * sx) / 1024;
                    if (t < mn) { mn = t; }
                    if (t > mx) { mx = t; }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        let sp:i64 = mx - mn;
        if (sp > bestsp) { bestsp = sp; bestk = k; }
        k = k + 1;
    }
    h_put64(out, 0, dir_cos(bestk));
    h_put64(out, 8, dir_sin(bestk));
    return;
}
// Extreme mask pixel along unit (fx,fy)/1024. Out: x,y.
fn vis_extreme(m:[]u8, w:i64, h:i64, bc:[]u8, fx:i64, fy:i64, out:[]u8) void {
    let x0:i64 = h_get64(bc, 0); let y0:i64 = h_get64(bc, 8);
    let x1:i64 = h_get64(bc, 16); let y1:i64 = h_get64(bc, 24);
    let bt:i64 = -4611686018427387903;
    let bx:i64 = 0; let by:i64 = 0;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            if (m[y * w + x] == 1) {
                let t:i64 = (x * fx + y * fy) / 1024;
                if (t > bt) { bt = t; bx = x; by = y; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    h_put64(out, 0, bx); h_put64(out, 8, by);
    return;
}
// Width profile of mask along facing f from snout s, 4px bins.
// prof: nbins x i64 widths. Returns nbins. out2: skull_w, neck_w, d_neck, prom_x1024.
fn vis_profile(m:[]u8, w:i64, h:i64, bc:[]u8, sx:i64, sy:i64, fx:i64, fy:i64, prof:[]u8, out2:[]u8) i64 {
    let nx:i64 = 0 - fy; let ny:i64 = fx;
    let x0:i64 = h_get64(bc, 0); let y0:i64 = h_get64(bc, 8);
    let x1:i64 = h_get64(bc, 16); let y1:i64 = h_get64(bc, 24);
    let bmax:i64 = 0;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            if (m[y * w + x] == 1) {
                let b:i64 = (0 - ((x - sx) * fx + (y - sy) * fy)) / 1024;
                if (b > bmax) { bmax = b; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let nbins:i64 = bmax / 4 + 1;
    if (nbins > 256) { nbins = 256; }
    if (nbins < 2) { nbins = 2; }
    let i:i64 = 0;
    while (i < 512) { h_put64(prof, i * 8, -1); i = i + 1; }
    y = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            if (m[y * w + x] == 1) {
                let b:i64 = (0 - ((x - sx) * fx + (y - sy) * fy)) / 1024 / 4;
                if (b < 0) { b = 0; }
                if (b >= nbins) { b = nbins - 1; }
                let q:i64 = ((x - sx) * nx + (y - sy) * ny) / 1024;
                let cur:i64 = h_get64(prof, b * 8);
                if (cur < 0) { h_put64(prof, b * 8, q); h_put64(prof, 2048 + b * 8, q); }
                else {
                    if (q < h_get64(prof, b * 8)) { h_put64(prof, b * 8, q); }
                    if (q > h_get64(prof, 2048 + b * 8)) { h_put64(prof, 2048 + b * 8, q); }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    i = 0;
    while (i < nbins) {
        let a:i64 = h_get64(prof, i * 8);
        if (a < 0) { h_put64(prof, i * 8, 0); } else { h_put64(prof, i * 8, h_get64(prof, 2048 + i * 8) - a); }
        i = i + 1;
    }
    let half:i64 = nbins / 2;
    let skull:i64 = 0; let skullb:i64 = 0;
    i = 0;
    while (i <= half) {
        let wd:i64 = h_get64(prof, i * 8);
        if (wd > skull) { skull = wd; skullb = i; }
        i = i + 1;
    }
    let neckw:i64 = 4611686018427387903; let neckb:i64 = skullb;
    i = skullb + 1;
    while (i < nbins) {
        let wd:i64 = h_get64(prof, i * 8);
        if (wd < neckw) { neckw = wd; neckb = i; }
        i = i + 1;
    }
    if (neckw == 4611686018427387903) { neckw = skull; }
    h_put64(out2, 0, skull);
    h_put64(out2, 8, neckw);
    h_put64(out2, 16, neckb * 4);
    if (neckw > 0) { h_put64(out2, 24, skull * 1024 / neckw); } else { h_put64(out2, 24, 1024); }
    return nbins;
}
// Ear count: dorsal boundary protrusions. n0 perp unit chosen toward image-up.
// Returns count of protrusion clusters.
fn vis_ears(m:[]u8, w:i64, h:i64, bc:[]u8, cx1024:i64, cy1024:i64, fx:i64, fy:i64, skullw:i64) i64 {
    let nx:i64 = 0 - fy; let ny:i64 = fx;
    if (ny > 0) { nx = 0 - nx; ny = 0 - ny; }
    let cx:i64 = cx1024 / 1024; let cy:i64 = cy1024 / 1024;
    let x0:i64 = h_get64(bc, 0); let y0:i64 = h_get64(bc, 8);
    let x1:i64 = h_get64(bc, 16); let y1:i64 = h_get64(bc, 24);
    let thr:i64 = skullw / 2 + 6;
    // cluster bins along facing, 8px: mark bins containing dorsal protrusions
    let bins:[]u8 = nio_alloc(256);
    let i:i64 = 0;
    while (i < 256) { bins[i] = 0; i = i + 1; }
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            if (m[y * w + x] == 1) {
                let nb:i64 = 0;
                if (x > x0) { if (m[y * w + x - 1] == 1) { nb = nb + 1; } }
                if (x < x1) { if (m[y * w + x + 1] == 1) { nb = nb + 1; } }
                if (y > y0) { if (m[(y - 1) * w + x] == 1) { nb = nb + 1; } }
                if (y < y1) { if (m[(y + 1) * w + x] == 1) { nb = nb + 1; } }
                if (nb < 4) {
                    let q:i64 = ((x - cx) * nx + (y - cy) * ny) / 1024;
                    if (q > thr) {
                        let b:i64 = ((x - cx) * fx + (y - cy) * fy) / 1024 / 8 + 32;
                        if (b < 0) { b = 0; }
                        if (b > 255) { b = 255; }
                        bins[b] = 1;
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    // count runs of marked bins
    let cnt:i64 = 0;
    let inrun:i64 = 0;
    i = 0;
    while (i < 256) {
        if (bins[i] == 1) { if (inrun == 0) { cnt = cnt + 1; inrun = 1; } }
        else { inrun = 0; }
        i = i + 1;
    }
    nio_free(bins);
    return cnt;
}
// Full head-anatomy analysis of a dark mask m (the head candidate).
// anat: snx,sny,fx,fy,d_neck,nx,ny,skullw,neckw,prom,elong_x1024,ears,area (13 x i64)
fn vis_anatomy(m:[]u8, w:i64, h:i64, bc:[]u8, seen:[]u8, stack:[]u8, prof:[]u8, anat:[]u8) i64 {
    let ax:[]u8 = nio_alloc(16);
    vis_axis(m, w, h, bc, ax);
    let afx:i64 = h_get64(ax, 0); let afy:i64 = h_get64(ax, 8);
    // try both orientations; pick stronger neck prominence
    let best_prom:i64 = -1;
    let bfx:i64 = afx; let bfy:i64 = afy;
    let bsx:i64 = 0; let bsy:i64 = 0;
    let bsk:i64 = 0; let bnw:i64 = 0; let bdn:i64 = 0;
    let ex:[]u8 = nio_alloc(16);
    let p2:[]u8 = nio_alloc(32);
    let s:i64 = 0;
    while (s < 2) {
        let fx:i64 = afx; let fy:i64 = afy;
        if (s == 1) { fx = 0 - afx; fy = 0 - afy; }
        vis_extreme(m, w, h, bc, fx, fy, ex);
        let exx:i64 = h_get64(ex, 0); let eyy:i64 = h_get64(ex, 8);
        vis_profile(m, w, h, bc, exx, eyy, fx, fy, prof, p2);
        let pr:i64 = h_get64(p2, 24);
        if (pr > best_prom) {
            best_prom = pr;
            bfx = fx; bfy = fy;
            bsx = exx; bsy = eyy;
            bsk = h_get64(p2, 0); bnw = h_get64(p2, 8); bdn = h_get64(p2, 16);
        }
        s = s + 1;
    }
    nio_free(ax); nio_free(p2);
    // skull width: max perpendicular extent of the mask (direct, no binning).
    // bsk is used for elongation and scale; the profile bins were fragile.
    let pnx:i64 = 0 - bfy; let pny:i64 = bfx;
    let qmin:i64 = 4611686018427387903; let qmax:i64 = 0 - 4611686018427387903;
    let qx0:i64 = h_get64(bc, 0); let qy0:i64 = h_get64(bc, 8);
    let qx1:i64 = h_get64(bc, 16); let qy1:i64 = h_get64(bc, 24);
    let qy:i64 = qy0;
    while (qy <= qy1) {
        let qx:i64 = qx0;
        while (qx <= qx1) {
            if (m[qy * w + qx] == 1) {
                let qq:i64 = (qx * pnx + qy * pny) / 1024;
                if (qq < qmin) { qmin = qq; }
                if (qq > qmax) { qmax = qq; }
            }
            qx = qx + 1;
        }
        qy = qy + 1;
    }
    bsk = qmax - qmin;
    if (bsk < 0) { bsk = 0; }
    // neck anchor: the back extreme (opposite the snout) — where the head meets
    // the body. This is the cut line for the graft, not a width minimum.
    vis_extreme(m, w, h, bc, 0 - bfx, 0 - bfy, ex);
    let nx:i64 = h_get64(ex, 0); let ny:i64 = h_get64(ex, 8);
    let fx2:i64 = nx; let fy2:i64 = ny;
    nio_free(ex);
    // neck distance: projection from snout back to neck along facing
    bdn = ((bsx - nx) * bfx + (bsy - ny) * bfy) / 1024;
    if (bdn < 0) { bdn = 0; }
    // elongation: snout-to-neck along facing / skull width
    let hlen:i64 = bdn;
    let elong:i64 = 0;
    if (bsk > 0) { elong = hlen * 1024 / bsk; }
    let cx:i64 = h_get64(bc, 32); let cy:i64 = h_get64(bc, 40);
    let ears:i64 = vis_ears(m, w, h, bc, cx, cy, bfx, bfy, bsk);
    h_put64(anat, 0, bsx); h_put64(anat, 8, bsy);
    h_put64(anat, 16, bfx); h_put64(anat, 24, bfy);
    h_put64(anat, 32, bdn);
    h_put64(anat, 40, nx); h_put64(anat, 48, ny);
    h_put64(anat, 56, bsk); h_put64(anat, 64, bnw); h_put64(anat, 72, best_prom);
    h_put64(anat, 80, elong);
    h_put64(anat, 88, ears);
    h_put64(anat, 96, h_get64(bc, 48));
    return 0;
}

// ---------------- render operators (substrate: pixel machinery) -------------
// warp_graft: donor head -> recipient, neck-anchored.
// D donor RGB, HM donor head mask, dn donor neck, fd donor facing (/1024).
// GL graft layer RGB out, GM graft mask out (0/1), over slot bbox.
// rn recip neck; upright=1 rotates fd->up(0,-1); 0 keeps donor orientation.
// s scale /1024; flip mirrors across facing axis.
fn warp_graft(D:[]u8, HM:[]u8, dnx:i64, dny:i64, fdx:i64, fdy:i64, GL:[]u8, GM:[]u8, rnx:i64, rny:i64, upright:i64, s:i64, flip:i64, x0:i64, y0:i64, x1:i64, y1:i64, w:i64, h:i64) void {
    let tx:i64 = 0; let ty:i64 = -1024;
    if (upright == 0) { tx = fdx; ty = fdy; }
    // fdx,tx are unit*1024; cos*1024 = (fdx*tx+fdy*ty)/1024 (single divide!)
    let cos:i64 = (fdx * tx + fdy * ty) / 1024;
    let sin:i64 = (fdx * ty - fdy * tx) / 1024;
    let i:i64 = 0;
    while (i < w * h) { GM[i] = 0; i = i + 1; }
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            // inverse map: v' = (p - rn)*1024/s (donor px); v = Rot_inv(v').
            // (2026-09-26 repair, explicit dimensional form: vpx is donor pixels,
            // vx/vy are donor pixels after the /1024 rotation, so dx=dnx+vx.
            // The old code had vpx=(p-rn)*1048576/s then dx=dnx+vx (no /1024),
            // mixing px with 1/1024-px and pushing samples out of the donor.)
            let vpx:i64 = (x - rnx) * 1024 / s;
            let vpy:i64 = (y - rny) * 1024 / s;
            let vx:i64 = (cos * vpx + sin * vpy) / 1024;
            let vy:i64 = (0 - sin * vpx + cos * vpy) / 1024;
            // dx,dy are donor PIXELS.
            let dx:i64 = dnx + vx;
            let dy:i64 = dny + vy;
            if (flip == 1) {
                let rx:i64 = dx - dnx; let ry:i64 = dy - dny;
                // proj is in px: (px * 1/1024)/1024 would double-scale.
                // (2026-09-26 repair: removed the second /1024, which was only
                // correct for the old buggy 1/1024-px dx,dy.)
                let proj:i64 = (rx * fdx + ry * fdy) / 1024;
                let pax:i64 = proj * fdx / 1024; let pay:i64 = proj * fdy / 1024;
                let pex:i64 = rx - pax; let pey:i64 = ry - pay;
                dx = dnx + pax - pex; dy = dny + pay - pey;
            }
            if (dx >= 0) { if (dx < w) { if (dy >= 0) { if (dy < h) {
                if (HM[dy * w + dx] == 1) {
                    let id:i64 = y * w + x;
                    let jd:i64 = dy * w + dx;
                    GL[id * 3] = D[jd * 3]; GL[id * 3 + 1] = D[jd * 3 + 1]; GL[id * 3 + 2] = D[jd * 3 + 2];
                    GM[id] = 1;
                }
            } } } }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
// graft_extend: uncovered slot pixels <- donor tissue continuation (inverse map,
// no mask gate). Only fills where GM==0 inside slot bbox.
fn graft_extend(D:[]u8, dnx:i64, dny:i64, fdx:i64, fdy:i64, GL:[]u8, GM:[]u8, rnx:i64, rny:i64, upright:i64, s:i64, x0:i64, y0:i64, x1:i64, y1:i64, w:i64, h:i64) void {
    let tx:i64 = 0; let ty:i64 = -1024;
    if (upright == 0) { tx = fdx; ty = fdy; }
    let cos:i64 = (fdx * tx + fdy * ty) / 1024;
    let sin:i64 = (fdx * ty - fdy * tx) / 1024;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let id:i64 = y * w + x;
            if (GM[id] == 0) {
                // inverse map, explicit dimensional form (donor pixels; see warp_graft).
                let vpx:i64 = (x - rnx) * 1024 / s;
                let vpy:i64 = (y - rny) * 1024 / s;
                let vx:i64 = (cos * vpx + sin * vpy) / 1024;
                let vy:i64 = (0 - sin * vpx + cos * vpy) / 1024;
                let dx:i64 = dnx + vx;
                let dy:i64 = dny + vy;
                if (dx >= 0) { if (dx < w) { if (dy >= 0) { if (dy < h) {
                    let jd:i64 = dy * w + dx;
                    GL[id * 3] = D[jd * 3]; GL[id * 3 + 1] = D[jd * 3 + 1]; GL[id * 3 + 2] = D[jd * 3 + 2];
                    GM[id] = 2;
                } } } }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
// composite graft layer onto R with optional feather radius fr (0 = crisp).
// blur is a 4*n byte arena holding u32 alpha values (0..1024).
fn composite(R:[]u8, GL:[]u8, GM:[]u8, fr:i64, x0:i64, y0:i64, x1:i64, y1:i64, w:i64, h:i64, n:i64, blur:[]u8) void {
    if (fr == 0) {
        let y:i64 = y0;
        while (y <= y1) {
            let x:i64 = x0;
            while (x <= x1) {
                let id:i64 = y * w + x;
                if (GM[id] != 0) {
                    R[id * 3] = GL[id * 3]; R[id * 3 + 1] = GL[id * 3 + 1]; R[id * 3 + 2] = GL[id * 3 + 2];
                }
                x = x + 1;
            }
            y = y + 1;
        }
        return;
    }
    // alpha = box-blurred mask (0..1024)
    let y2:i64 = y0;
    while (y2 <= y1) {
        let x2:i64 = x0;
        while (x2 <= x1) {
            let acc:i64 = 0; let cnt:i64 = 0;
            let dy:i64 = 0 - fr;
            while (dy <= fr) {
                let dx:i64 = 0 - fr;
                while (dx <= fr) {
                    let xx:i64 = x2 + dx; let yy:i64 = y2 + dy;
                    if (xx >= 0) { if (xx < w) { if (yy >= 0) { if (yy < h) {
                        if (GM[yy * w + xx] != 0) { acc = acc + 1024; }
                        cnt = cnt + 1;
                    } } } }
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            if (cnt > 0) { h_put32(blur, (y2 * w + x2) * 4, (acc / cnt) as u32); }
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    let y3:i64 = y0;
    while (y3 <= y1) {
        let x3:i64 = x0;
        while (x3 <= x1) {
            let a:i64 = h_get32(blur, (y3 * w + x3) * 4) as i64;
            if (a > 0) {
                let id:i64 = y3 * w + x3;
                let k:i64 = 0;
                while (k < 3) {
                    let gv:i64 = GL[id * 3 + k] as i64;
                    let rv:i64 = R[id * 3 + k] as i64;
                    R[id * 3 + k] = ((a * gv + (1024 - a) * rv) / 1024) as u8;
                    k = k + 1;
                }
            }
            x3 = x3 + 1;
        }
        y3 = y3 + 1;
    }
    return;
}
// harmonize graft boundary band toward recipient fur. Returns gain_x1024.
fn harmonize(GL:[]u8, GM:[]u8, R:[]u8, gray:[]u8, x0:i64, y0:i64, x1:i64, y1:i64, w:i64, h:i64) i64 {
    let si:i64 = 0; let ci:i64 = 0;
    let so:i64 = 0; let co:i64 = 0;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let id:i64 = y * w + x;
            if (GM[id] != 0) {
                // near boundary? check 4-neighborhood for non-graft
                let edge:i64 = 0;
                if (x > x0) { if (GM[id - 1] == 0) { edge = 1; } }
                if (x < x1) { if (GM[id + 1] == 0) { edge = 1; } }
                if (y > y0) { if (GM[id - w] == 0) { edge = 1; } }
                if (y < y1) { if (GM[id + w] == 0) { edge = 1; } }
                if (edge == 1) { si = si + (gray[id] as i64); ci = ci + 1; }
            } else {
                let adj:i64 = 0;
                if (x > x0) { if (GM[id - 1] != 0) { adj = 1; } }
                if (x < x1) { if (GM[id + 1] != 0) { adj = 1; } }
                if (y > y0) { if (GM[id - w] != 0) { adj = 1; } }
                if (y < y1) { if (GM[id + w] != 0) { adj = 1; } }
                if (adj == 1) { so = so + (gray[id] as i64); co = co + 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (ci == 0) { return 1024; }
    if (co == 0) { return 1024; }
    let mi:i64 = si / ci; let mo:i64 = so / co;
    if (mi < 8) { return 1024; }
    let gain:i64 = mo * 1024 / mi;
    if (gain < 768) { gain = 768; }
    if (gain > 1365) { gain = 1365; }
    let y2:i64 = y0;
    while (y2 <= y1) {
        let x2:i64 = x0;
        while (x2 <= x1) {
            let id:i64 = y2 * w + x2;
            if (GM[id] != 0) {
                let k:i64 = 0;
                while (k < 3) {
                    let v:i64 = (GL[id * 3 + k] as i64) * gain / 1024;
                    if (v > 255) { v = 255; }
                    GL[id * 3 + k] = v as u8;
                    k = k + 1;
                }
            }
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    return gain;
}
// scene_compose: 640x240 canvas; donor left, recipient right at 320+dx, feather fb.
fn scene_compose(D:[]u8, Rr:[]u8, C:[]u8, dx:i64, fb:i64, w:i64, h:i64) void {
    let W2:i64 = 640;
    let jx:i64 = 320 + dx;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < W2) {
            let id:i64 = y * W2 + x;
            if (x < jx - fb) {
                let sx:i64 = x;
                if (sx >= w) { sx = w - 1; }
                let jd:i64 = y * w + sx;
                C[id * 3] = D[jd * 3]; C[id * 3 + 1] = D[jd * 3 + 1]; C[id * 3 + 2] = D[jd * 3 + 2];
            }
            if (x >= jx + fb) {
                let sx:i64 = x - jx;
                if (sx < 0) { sx = 0; }
                if (sx >= w) { sx = w - 1; }
                let jd:i64 = y * w + sx;
                C[id * 3] = Rr[jd * 3]; C[id * 3 + 1] = Rr[jd * 3 + 1]; C[id * 3 + 2] = Rr[jd * 3 + 2];
            }
            if (x >= jx - fb) { if (x < jx + fb) {
                let a:i64 = (x - (jx - fb)) * 1024 / (2 * fb);
                let sxd:i64 = x; if (sxd >= w) { sxd = w - 1; }
                let jd:i64 = y * w + sxd;
                let sxr:i64 = x - jx; if (sxr < 0) { sxr = 0; } if (sxr >= w) { sxr = w - 1; }
                let jr:i64 = y * w + sxr;
                let k:i64 = 0;
                while (k < 3) {
                    let dv:i64 = D[jd * 3 + k] as i64;
                    let rv:i64 = Rr[jr * 3 + k] as i64;
                    C[id * 3 + k] = (((1024 - a) * dv + a * rv) / 1024) as u8;
                    k = k + 1;
                }
            } }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}

// ---------------- perception: TNN sees its own render -----------------------
// P slots: 0 snout_ok,1 neck_ok,2 ears_ok,3 head_sum, 4 neck_joint,
//          5 face_removed,6 seam_crisp,7 coverage, 8 graft_area,9 slot_area,
//          10 seam_bg,11 natural_bg,12 both_visible,13 graft_luma,
//          14 donor_head_luma,15 identity_ok
// donor_anat: 13 slots (vis_anatomy). recip_base: neck_y,slot x0,y0,x1,y1,
//   slot_area,D0,dark_thr... (8 slots). All []u8 arenas, LE i64.
// scratch: gray,mask,gm,seen,stack,prof,bc,ganat,tmp (caller-provided).
fn perceive(px:[]u8, w:i64, h:i64, n:i64, P:[]u8, donor_anat:[]u8, recip_base:[]u8, gray:[]u8, mask:[]u8, gm:[]u8, seen:[]u8, stack:[]u8, prof:[]u8, bc:[]u8, ganat:[]u8, thr:i64, donor_luma:i64) void {
    let i:i64 = 0;
    while (i < 16) { h_put64(P, i * 8, 0); i = i + 1; }
    vis_luma(px, gray, n);
    // graft detect: dark mass in head ROI (x 40..280, y 0..220)
    i = 0;
    while (i < n) { mask[i] = 0; i = i + 1; }
    let lab:[]u8 = nio_alloc(n * 8);
    let y:i64 = 0;
    while (y < 220) {
        let x:i64 = 40;
        while (x < 280) {
            let id:i64 = y * w + x;
            if ((gray[id] as i64) < thr) { mask[id] = 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    let area:i64 = vis_largest(mask, gm, lab, stack, w, h, n);
    nio_free(lab);
    h_put64(P, 64, area);
    let slot_area:i64 = h_get64(recip_base, 40);
    h_put64(P, 72, slot_area);
    if (area < 400) {
        h_put64(P, 24, 0);
        return;
    }
    vis_bbox_centroid(gm, w, h, n, bc);
    vis_anatomy(gm, w, h, bc, seen, stack, prof, ganat);
    let d_elong:i64 = h_get64(donor_anat, 80);
    let d_ears:i64 = h_get64(donor_anat, 88);
    let g_elong:i64 = h_get64(ganat, 80);
    let g_prom:i64 = h_get64(ganat, 72);
    let g_ears:i64 = h_get64(ganat, 88);
    let snout_ok:i64 = 0;
    if (g_elong * 4 >= d_elong * 3) { snout_ok = 1; }
    let neck_ok:i64 = 0;
    if (g_prom >= 2048) { neck_ok = 1; }
    let ears_ok:i64 = 1;
    if (d_ears >= 1) { ears_ok = 0; if (g_ears >= 1) { ears_ok = 1; } }
    h_put64(P, 0, snout_ok); h_put64(P, 8, neck_ok); h_put64(P, 16, ears_ok);
    h_put64(P, 24, snout_ok + neck_ok + ears_ok);
    // face_removed: dark non-graft pixels in slot vs baseline D0
    let sx0:i64 = h_get64(recip_base, 8); let sy0:i64 = h_get64(recip_base, 16);
    let sx1:i64 = h_get64(recip_base, 24); let sy1:i64 = h_get64(recip_base, 32);
    let d0:i64 = h_get64(recip_base, 48);
    let d1:i64 = 0;
    y = sy0;
    while (y <= sy1) {
        let x:i64 = sx0;
        while (x <= sx1) {
            let id:i64 = y * w + x;
            if (gm[id] == 0) { if ((gray[id] as i64) < 110) { d1 = d1 + 1; } }
            x = x + 1;
        }
        y = y + 1;
    }
    let fr:i64 = 0;
    if (d1 * 1024 < 307 * d0) { fr = 1; }
    h_put64(P, 40, fr);
    // neck_joint: graft pixels near the recipient neck point (nx,ny)
    let neck_y:i64 = h_get64(recip_base, 0);
    let neck_x:i64 = h_get64(recip_base, 56);
    let near:i64 = 0;
    let yy0:i64 = neck_y - 14; if (yy0 < 0) { yy0 = 0; }
    let yy1:i64 = neck_y + 14; if (yy1 >= h) { yy1 = h - 1; }
    let xx0:i64 = neck_x - 14; if (xx0 < 0) { xx0 = 0; }
    let xx1:i64 = neck_x + 14; if (xx1 >= w) { xx1 = w - 1; }
    y = yy0;
    while (y <= yy1) {
        let x:i64 = xx0;
        while (x <= xx1) {
            if (gm[y * w + x] == 1) {
                let ddx:i64 = x - neck_x; let ddy:i64 = y - neck_y;
                if (ddx * ddx + ddy * ddy <= 144) { near = near + 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let joint:i64 = near * 1024 / 300;
    if (joint > 1024) { joint = 1024; }
    h_put64(P, 32, joint);
    // coverage
    if (slot_area > 0) { h_put64(P, 56, area * 1024 / slot_area); }
    // seam crispness: boundary step within 1px vs 4px
    let ccx:i64 = h_get64(bc, 32) / 1024; let ccy:i64 = h_get64(bc, 40) / 1024;
    let acc:i64 = 0; let cnt:i64 = 0;
    y = sy0;
    while (y <= sy1) {
        let x:i64 = sx0;
        while (x <= sx1) {
            let id:i64 = y * w + x;
            if (gm[id] == 1) {
                let isb:i64 = 0;
                let s1:i64 = 0; let c1:i64 = 0;
                if (x > sx0) { if (gm[id - 1] == 0) { isb = 1; s1 = s1 + (gray[id - 1] as i64); c1 = c1 + 1; } }
                if (x < sx1) { if (gm[id + 1] == 0) { isb = 1; s1 = s1 + (gray[id + 1] as i64); c1 = c1 + 1; } }
                if (y > sy0) { if (gm[id - w] == 0) { isb = 1; s1 = s1 + (gray[id - w] as i64); c1 = c1 + 1; } }
                if (y < sy1) { if (gm[id + w] == 0) { isb = 1; s1 = s1 + (gray[id + w] as i64); c1 = c1 + 1; } }
                if (isb == 1) {
                    let step1:i64 = (gray[id] as i64) - s1 / c1;
                    if (step1 < 0) { step1 = 0 - step1; }
                    // far pixel: 4px along (b - C)
                    let vx:i64 = x - ccx; let vy:i64 = y - ccy;
                    let L:i64 = vx * vx + vy * vy;
                    // isqrt via loop
                    let r:i64 = 0;
                    while ((r + 1) * (r + 1) <= L) { r = r + 1; }
                    if (r > 0) {
                        let fx2:i64 = x + 4 * vx / r; let fy2:i64 = y + 4 * vy / r;
                        if (fx2 >= 0) { if (fx2 < w) { if (fy2 >= 0) { if (fy2 < h) {
                            let fid:i64 = fy2 * w + fx2;
                            if (gm[fid] == 0) {
                                let step5:i64 = (gray[id] as i64) - (gray[fid] as i64);
                                if (step5 < 0) { step5 = 0 - step5; }
                                if (step5 > 0) {
                                    acc = acc + step1 * 1024 / step5;
                                    cnt = cnt + 1;
                                }
                            }
                        } } } }
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (cnt > 0) { h_put64(P, 48, acc / cnt); }
    // graft luma + identity vs donor head luma
    let gl:i64 = 0; let gc:i64 = 0;
    i = 0;
    while (i < n) { if (gm[i] == 1) { gl = gl + (gray[i] as i64); gc = gc + 1; } i = i + 1; }
    if (gc > 0) { gl = gl / gc; }
    h_put64(P, 104, gl);
    let dhl:i64 = donor_luma;
    if (dhl > 0) {
        let dd:i64 = gl - dhl;
        if (dd < 0) { dd = 0 - dd; }
        if (dd * 1024 <= 102 * dhl) { h_put64(P, 120, 1); }
    }
    return;
}
// scene perception: seam_bg at join jx on 640-wide canvas; natural at jx-60/+60;
// both_visible: pig dark mass left, bunny bright mass right.
fn perceive_scene(C:[]u8, jx:i64, P:[]u8, gray:[]u8, n2:i64, d_dark0:i64, r_bright0:i64) void {
    let i:i64 = 0;
    while (i < 16) { h_put64(P, i * 8, 0); i = i + 1; }
    vis_luma(C, gray, n2);
    let W2:i64 = 640; let h:i64 = 240;
    let acc:i64 = 0; let cnt:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let a:i64 = (gray[y * W2 + jx - 1] as i64) - (gray[y * W2 + jx + 1] as i64);
        if (a < 0) { a = 0 - a; }
        acc = acc + a; cnt = cnt + 1;
        y = y + 1;
    }
    if (cnt > 0) { h_put64(P, 80, acc / cnt); }
    let b1:i64 = 0; let b2:i64 = 0;
    y = 0;
    while (y < h) {
        let a:i64 = (gray[y * W2 + jx - 61] as i64) - (gray[y * W2 + jx - 59] as i64);
        if (a < 0) { a = 0 - a; }
        b1 = b1 + a;
        let c:i64 = (gray[y * W2 + jx + 59] as i64) - (gray[y * W2 + jx + 61] as i64);
        if (c < 0) { c = 0 - c; }
        b2 = b2 + c;
        y = y + 1;
    }
    if (cnt > 0) { h_put64(P, 88, (b1 + b2) / (2 * cnt)); }
    // both animals visible
    let dl:i64 = 0;
    y = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < 300) {
            if ((gray[y * W2 + x] as i64) < 90) { dl = dl + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    let br:i64 = 0;
    y = 0;
    while (y < h) {
        let x:i64 = 340;
        while (x < W2) {
            if ((gray[y * W2 + x] as i64) > 210) { br = br + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    let bv:i64 = 0;
    if (dl * 2 >= d_dark0) { if (br * 2 >= r_bright0) { bv = 1; } }
    h_put64(P, 96, bv);
    h_put64(P, 64, dl); h_put64(P, 72, br);
    return;
}

// ---------------- deliberation: TNN's own decision procedure ----------------
// Defect bits: 0 HEAD,1 FACE,2 SEAM,3 COV,4 NECK,5 BGSEAM
// Bars: HEAD head_sum>=2; FACE face_removed==1; SEAM crisp>=717;
//       COV coverage>=768; NECK joint>=512; BGSEAM seam_bg*1024<=1536*natural
// Op ids: 0 SCALE_UP,1 EXTEND,2 FEATHER0,3 HARMONIZE,4 SWITCH_NATIVE,
//         5 SWITCH_SCENE,6 JOIN_SHIFT,7 FLIP_TRY
// arch: 0 strategy(0 SWAP,1 NATIVE,2 SCENE),1 scale_x1024,2 flip,3 feather_r,
//       4 extend_on,5 harmonize_on,6 join_dx,7 join_feather
fn dlb_defects(P:[]u8, strategy:i64) i64 {
    let d:i64 = 0;
    if (h_get64(P, 24) < 2) { d = d + 1; }
    if (h_get64(P, 40) != 1) { d = d + 2; }
    if (strategy != 2) {
        if (h_get64(P, 48) < 717) { d = d + 4; }
        if (h_get64(P, 56) < 768) { d = d + 8; }
        if (h_get64(P, 32) < 512) { d = d + 16; }
    }
    if (strategy == 2) {
        let sb:i64 = h_get64(P, 80); let nb:i64 = h_get64(P, 88);
        if (sb * 1024 > 1536 * nb) { d = d + 32; }
    }
    return d;
}
fn dlb_deficit(P:[]u8, bit:i64) i64 {
    if (bit == 0) { let s:i64 = h_get64(P, 24); if (s >= 2) { return 0; } return (2 - s) * 1024 / 2; }
    if (bit == 1) { if (h_get64(P, 40) == 1) { return 0; } return 1024; }
    if (bit == 2) { let c:i64 = h_get64(P, 48); if (c >= 717) { return 0; } return (717 - c) * 1024 / 717; }
    if (bit == 3) { let c:i64 = h_get64(P, 56); if (c >= 768) { return 0; } return (768 - c) * 1024 / 768; }
    if (bit == 4) { let j:i64 = h_get64(P, 32); if (j >= 512) { return 0; } return (512 - j) * 1024 / 512; }
    let sb:i64 = h_get64(P, 80); let nb:i64 = h_get64(P, 88);
    let over:i64 = sb * 1024 - 1536 * nb;
    if (over <= 0) { return 0; }
    let den:i64 = 1536 * nb;
    if (den < 1) { den = 1; }
    let v:i64 = over * 1024 / den;
    if (v > 1024) { v = 1024; }
    return v;
}
fn dlb_allbars(defects:i64) i64 {
    if (defects == 0) { return 1; }
    return 0;
}
// cand arena: 8 cands x 6 slots: op,param,naddr,defsum,alive,gain
fn cand_add(cand:[]u8, nc:i64, op:i64, param:i64, naddr:i64, defsum:i64) i64 {
    h_put64(cand, nc * 48, op);
    h_put64(cand, nc * 48 + 8, param);
    h_put64(cand, nc * 48 + 16, naddr);
    h_put64(cand, nc * 48 + 24, defsum);
    h_put64(cand, nc * 48 + 32, 1);
    h_put64(cand, nc * 48 + 40, 0);
    return nc + 1;
}
fn op_name(op:i64, ob:[]u8) i64 {
    let s:[]u8 = "UNKNOWN";
    if (op == 0) { s = "SCALE_UP"; }
    if (op == 1) { s = "EXTEND"; }
    if (op == 2) { s = "FEATHER0"; }
    if (op == 3) { s = "HARMONIZE"; }
    if (op == 4) { s = "SWITCH_NATIVE"; }
    if (op == 5) { s = "SWITCH_SCENE"; }
    if (op == 6) { s = "JOIN_SHIFT"; }
    if (op == 7) { s = "FLIP_TRY"; }
    let i:i64 = 0;
    while (i < s.len) { ob[i] = s[i]; i = i + 1; }
    return s.len;
}
// PROPOSE: candidates generated from MEASURED defects, parameterized by the
// measurements. Reasons are written to the trace with the numbers.
fn dlb_propose(t:[]u8, P:[]u8, arch:[]u8, cand:[]u8, tried_mask:i64, donor_anat:[]u8) i64 {
    let nc:i64 = 0;
    let strategy:i64 = h_get64(arch, 0);
    let defects:i64 = dlb_defects(P, strategy);
    tr_str(t, "DEFECTS bits="); tr_i64(t, defects); tr_nl(t);
    if (strategy == 0) {
        // SWAP
        if (defects % 2 == 1) {
            let de:i64 = h_get64(donor_anat, 80);
            let ge:i64 = 0;
            tr_str(t, "PROPOSE SWITCH_NATIVE: head_sum="); tr_i64(t, h_get64(P, 24));
            tr_str(t, "<2. The warp destroyed the measured anatomy (donor elong_x1024=");
            tr_i64(t, de); tr_str(t, ", donor prom_x1024="); tr_i64(t, h_get64(donor_anat, 72));
            tr_str(t, "). K2 (cross-view wall): no 2D warp recovers occluded structure. ");
            tr_str(t, "Try the donor's measured native pose at the neck joint."); tr_nl(t);
            nc = cand_add(cand, nc, 4, 0, 1, dlb_deficit(P, 0));
            if ((tried_mask / 128) % 2 == 0) {
                tr_str(t, "PROPOSE FLIP_TRY: flip=1 (mirror across facing axis). ");
                tr_str(t, "K2 says view mismatch, not mirror mismatch, but the measurement decides."); tr_nl(t);
                nc = cand_add(cand, nc, 7, 1, 1, dlb_deficit(P, 0));
            }
        }
        if ((defects / 2) % 2 == 1) {
            tr_str(t, "PROPOSE EXTEND: face_removed=0 — recipient face persists in slot. ");
            tr_str(t, "Extend graft with donor neck-tissue continuation (anatomically: the neck continues)."); tr_nl(t);
            nc = cand_add(cand, nc, 1, 1, 2, dlb_deficit(P, 1) + dlb_deficit(P, 3));
            tr_str(t, "PROPOSE SCALE_UP: coverage="); tr_i64(t, h_get64(P, 56));
            tr_str(t, "<768. scale+128 (x1024)."); tr_nl(t);
            nc = cand_add(cand, nc, 0, 128, 1, dlb_deficit(P, 3));
        }
        if ((defects / 4) % 2 == 1) {
            if (h_get64(arch, 24) > 0) {
                tr_str(t, "PROPOSE FEATHER0: crisp="); tr_i64(t, h_get64(P, 48));
                tr_str(t, "<717 with feather_r="); tr_i64(t, h_get64(arch, 24));
                tr_str(t, ". Black-on-white boundary must stay crisp; feathering makes a gray halo."); tr_nl(t);
                nc = cand_add(cand, nc, 2, 0, 1, dlb_deficit(P, 2));
            }
            if (h_get64(arch, 40) == 0) {
                tr_str(t, "PROPOSE HARMONIZE: crisp="); tr_i64(t, h_get64(P, 48));
                tr_str(t, "<717 with no feather. Boundary-band luminance mismatch; ");
                tr_str(t, "harmonize graft edge toward recipient fur (K5: identity checked after)."); tr_nl(t);
                nc = cand_add(cand, nc, 3, 1, 1, dlb_deficit(P, 2));
            }
        }
        if ((defects / 16) % 2 == 1) {
            tr_str(t, "PROPOSE SCALE_UP (neck): neck_joint="); tr_i64(t, h_get64(P, 32));
            tr_str(t, "<512. A larger graft reaches the neck joint."); tr_nl(t);
            nc = cand_add(cand, nc, 0, 128, 1, dlb_deficit(P, 4));
        }
        if ((defects / 8) % 2 == 1) {
            if ((defects / 2) % 2 == 0) {
                tr_str(t, "PROPOSE SCALE_UP: coverage="); tr_i64(t, h_get64(P, 56));
                tr_str(t, "<768. scale+128."); tr_nl(t);
                nc = cand_add(cand, nc, 0, 128, 1, dlb_deficit(P, 3));
            }
        }
    }
    if (strategy == 1) {
        // NATIVE
        if (defects % 2 == 1) {
            tr_str(t, "PROPOSE SWITCH_SCENE: head_sum="); tr_i64(t, h_get64(P, 24));
            tr_str(t, " in native pose too. The head cannot be placed as one animal's head. ");
            tr_str(t, "Only honest composition remains."); tr_nl(t);
            nc = cand_add(cand, nc, 5, 0, 1, dlb_deficit(P, 0));
        }
        if ((defects / 2) % 2 == 1) {
            tr_str(t, "PROPOSE SWITCH_SCENE (trilemma): native-pose graft cannot cover the front-view slot ");
            tr_str(t, "(coverage="); tr_i64(t, h_get64(P, 56)); tr_str(t, ", face_removed=");
            tr_i64(t, h_get64(P, 40)); tr_str(t, "). {neck anchor, native pose, slot coverage} ");
            tr_str(t, "unsatisfiable by measurement: the head-down head points away from the slot."); tr_nl(t);
            nc = cand_add(cand, nc, 5, 0, 2, dlb_deficit(P, 1) + dlb_deficit(P, 3));
        }
        if ((defects / 8) % 2 == 1) {
            if ((defects / 2) % 2 == 0) {
                tr_str(t, "PROPOSE SCALE_UP (native): coverage="); tr_i64(t, h_get64(P, 56)); tr_nl(t);
                nc = cand_add(cand, nc, 0, 128, 1, dlb_deficit(P, 3));
            }
        }
    }
    if (strategy == 2) {
        // SCENE
        if ((defects / 32) % 2 == 1) {
            tr_str(t, "PROPOSE JOIN_SHIFT: seam_bg="); tr_i64(t, h_get64(P, 80));
            tr_str(t, " vs natural="); tr_i64(t, h_get64(P, 88));
            tr_str(t, ". TNN measures 5 candidate joins and takes argmin."); tr_nl(t);
            nc = cand_add(cand, nc, 6, 0, 1, dlb_deficit(P, 5));
            if (h_get64(arch, 56) == 0) {
                tr_str(t, "PROPOSE FEATHER_JOIN: blend the join band (background-to-background)."); tr_nl(t);
                nc = cand_add(cand, nc, 6, 1, 1, dlb_deficit(P, 5));
            }
        }
    }
    tr_str(t, "NCAND="); tr_i64(t, nc); tr_nl(t);
    return nc;
}
// CRITIC: kills candidates violating taught knowledge or lessons. Reasons cite K-numbers.
fn dlb_critic(t:[]u8, cand:[]u8, nc:i64, arch:[]u8, nogain_mask:i64, flip_tried:i64, harm_killed:i64) i64 {
    let nalive:i64 = 0;
    let i:i64 = 0;
    while (i < nc) {
        let op:i64 = h_get64(cand, i * 48);
        let param:i64 = h_get64(cand, i * 48 + 8);
        let kill:[]u8 = "";
        if (op == 0) {
            let ns:i64 = h_get64(arch, 8) + param;
            if (ns > 1843) { kill = "KB1: scale>1.8x banned (blob law)"; }
        }
        if (op == 7) {
            if (flip_tried == 1) { kill = "lesson: FLIP_TRY already measured no gain (K2: mirror cannot fix view)"; }
        }
        if (op == 3) {
            if (harm_killed == 1) { kill = "K5 identity-first: harmonize broke material identity before"; }
        }
        if (op == 1) {
            if (h_get64(arch, 32) == 1) { kill = "already on"; }
        }
        if (op == 6) {
            if (param == 1) { if (h_get64(arch, 56) != 0) { kill = "already on"; } }
        }
        // lesson: op gave no measured gain before
        let bit:i64 = 1;
        let b:i64 = 0;
        while (b < op) { bit = bit * 2; b = b + 1; }
        if ((nogain_mask / bit) % 2 == 1) { kill = "lesson: this op gave no measured gain before"; }
        if (kill.len == 0) { nalive = nalive + 1; }
        else {
            h_put64(cand, i * 48 + 32, 0);
            let nm:[]u8 = nio_alloc(32);
            let nl:i64 = op_name(op, nm);
            tr_str(t, "CRITIC KILL "); tr_str(t, nm[0..nl]); tr_str(t, ": "); tr_str(t, kill); tr_nl(t);
            nio_free(nm);
        }
        i = i + 1;
    }
    tr_str(t, "NALIVE="); tr_i64(t, nalive); tr_nl(t);
    return nalive;
}
// EVALUATE: predicted gain from learned op effectiveness (neutral 512 prior).
// SELECT: argmax, tie -> lowest candidate index.
fn dlb_select(t:[]u8, cand:[]u8, nc:i64, eff:[]u8) i64 {
    let best:i64 = -1;
    let bestg:i64 = -1;
    let i:i64 = 0;
    while (i < nc) {
        if (h_get64(cand, i * 48 + 32) == 1) {
            let op:i64 = h_get64(cand, i * 48);
            let naddr:i64 = h_get64(cand, i * 48 + 16);
            let defsum:i64 = h_get64(cand, i * 48 + 24);
            let e:i64 = h_get64(eff, op * 8);
            let g:i64 = 0;
            if (naddr > 0) { g = defsum * e / 1024 / naddr; }
            if (op == 4) { g = 512; }
            if (op == 5) { g = 512; }
            h_put64(cand, i * 48 + 40, g);
            let nm:[]u8 = nio_alloc(32);
            let nl:i64 = op_name(op, nm);
            tr_str(t, "EVAL "); tr_str(t, nm[0..nl]); tr_str(t, " pred_gain="); tr_i64(t, g);
            tr_str(t, " eff="); tr_i64(t, e); tr_nl(t);
            nio_free(nm);
            if (g > bestg) { bestg = g; best = i; }
        }
        i = i + 1;
    }
    return best;
}

// ---------------- file helpers ----------------
fn dec_write(buf:[]u8, p:i64, v:i64) i64 {
    if (v == 0) { buf[p] = 48; return 1; }
    let div:i64 = 1;
    while (div * 10 <= v) { div = div * 10; }
    let n:i64 = 0;
    while (div > 0) { buf[p + n] = (48 + v / div % 10) as u8; n = n + 1; div = div / 10; }
    return n;
}
fn name_frame(buf:[]u8, pre:[]u8, f:i64) i64 {
    let p:i64 = 0;
    let i:i64 = 0;
    while (i < pre.len) { buf[p] = pre[i]; p = p + 1; i = i + 1; }
    buf[p] = 95; p = p + 1;
    let nn:i64 = f + 1;
    buf[p] = (48 + nn / 10) as u8; p = p + 1;
    buf[p] = (48 + nn % 10) as u8; p = p + 1;
    buf[p] = 46; buf[p + 1] = 112; buf[p + 2] = 112; buf[p + 3] = 109; p = p + 4;
    return p;
}
fn name_round(buf:[]u8, r:i64, f:i64) i64 {
    let p:i64 = 0;
    buf[p] = 114; buf[p + 1] = 111; buf[p + 2] = 117; buf[p + 3] = 110; buf[p + 4] = 100; p = p + 5;
    buf[p] = (48 + r) as u8; p = p + 1;
    buf[p] = 95; p = p + 1;
    buf[p] = 102; p = p + 1;
    let nn:i64 = f + 1;
    buf[p] = (48 + nn / 10) as u8; p = p + 1;
    buf[p] = (48 + nn % 10) as u8; p = p + 1;
    buf[p] = 46; buf[p + 1] = 112; buf[p + 2] = 112; buf[p + 3] = 109; p = p + 4;
    return p;
}
fn file_read(root:i64, name:[]u8, out:[]u8, maxb:i32) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return fd; }
    let rc:i64 = nio_read_exact(fd, out, maxb);
    nio_close(fd);
    return rc;
}
fn ppm_write(root:i64, name:[]u8, px:[]u8, w:i64, h:i64, ob:[]u8) i64 {
    let nb:i64 = write_ppm(px, w, h, ob);
    return write_file_all(root, name, ob, nb);
}
fn fnv1a(b:[]u8) i64 {
    let h:i64 = 0 - 3750763034362895579;
    let i:i64 = 0;
    while (i < b.len) {
        h = h ^ (b[i] as i64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}
// ---------------- frame analysis ----------------
// donor: dark-mask head analysis. anat 13 slots (vis_anatomy). hl: head luma.
// Returns head area (0 if none).
fn analyze_donor(px:[]u8, w:i64, h:i64, n:i64, anat:[]u8, HM:[]u8, hl:[]u8, f:i64, gray:[]u8, mask:[]u8, seen:[]u8, stack:[]u8, prof:[]u8, bc:[]u8) i64 {
    vis_luma(px, gray, n);
    let i:i64 = 0;
    // head core: very dark pixels (luma<50), largest component.
    // The full head (incl. gray snout) is lighter; the black core anchors it.
    while (i < n) { if ((gray[i] as i64) < 50) { mask[i] = 1; } else { mask[i] = 0; } i = i + 1; }
    let lab:[]u8 = nio_alloc(n * 8);
    let core_area:i64 = vis_largest(mask, HM, lab, stack, w, h, n);
    nio_free(lab);
    let k:i64 = 0;
    while (k < 13) { h_put64(anat, k * 8, 0); k = k + 1; }
    if (core_area < 400) { return 0; }
    // Expand: dilate core by 15 into seen, intersect with luma<110 (captures the
    // gray snout/muzzle), then largest component. The dilation radius bounds how
    // far background can leak in.
    vis_dilate(HM, seen, w, h, 15);
    i = 0;
    while (i < n) {
        if (seen[i] == 1) { if ((gray[i] as i64) < 110) { mask[i] = 1; } else { mask[i] = 0; } }
        else { mask[i] = 0; }
        i = i + 1;
    }
    let lab2:[]u8 = nio_alloc(n * 8);
    let area:i64 = vis_largest(mask, HM, lab2, stack, w, h, n);
    nio_free(lab2);
    if (area < 400) { return 0; }
    vis_bbox_centroid(HM, w, h, n, bc);
    vis_anatomy(HM, w, h, bc, seen, stack, prof, anat);
    let s:i64 = 0; let c:i64 = 0;
    i = 0;
    while (i < n) { if (HM[i] == 1) { s = s + (gray[i] as i64); c = c + 1; } i = i + 1; }
    if (c > 0) { h_put64(hl, f * 8, s / c); }
    return area;
}
// recipient: bright-mask head analysis. base: 0 neck_y,8 x0,16 y0,24 x1,32 y1,
// 40 slot_area,48 D0,56 neck_x,64 110. Returns 1 if head found.
fn analyze_recip(px:[]u8, w:i64, h:i64, n:i64, base:[]u8, gray:[]u8, mask:[]u8, prof:[]u8) i64 {
    vis_luma(px, gray, n);
    let i:i64 = 0;
    while (i < n) { if ((gray[i] as i64) > 200) { mask[i] = 1; } else { mask[i] = 0; } i = i + 1; }
    let y:i64 = 20;
    while (y <= 200) {
        let c:i64 = 0;
        let x:i64 = 0;
        while (x < w) { if (mask[y * w + x] == 1) { c = c + 1; } x = x + 1; }
        h_put64(prof, (y - 20) * 8, c);
        y = y + 1;
    }
    let neck_y:i64 = 90;
    let bw:i64 = h_get64(prof, 70 * 8);
    y = 91;
    while (y <= 150) {
        let c:i64 = h_get64(prof, (y - 20) * 8);
        if (c < bw) { bw = c; neck_y = y; }
        y = y + 1;
    }
    let sx:i64 = 0; let sc:i64 = 0;
    y = neck_y - 5;
    while (y <= neck_y + 5) {
        if (y >= 0) { if (y < h) {
            let x:i64 = 0;
            while (x < w) { if (mask[y * w + x] == 1) { sx = sx + x; sc = sc + 1; } x = x + 1; }
        } }
        y = y + 1;
    }
    let neck_x:i64 = w / 2;
    if (sc > 0) { neck_x = sx / sc; }
    let x0:i64 = w; let y0:i64 = h; let x1:i64 = -1; let y1:i64 = -1;
    y = 0;
    while (y < neck_y - 2) {
        let x:i64 = 40;
        while (x < 280) {
            if (mask[y * w + x] == 1) {
                if (x < x0) { x0 = x; }
                if (x > x1) { x1 = x; }
                if (y < y0) { y0 = y; }
                if (y > y1) { y1 = y; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (x1 < 0) { return 0; }
    x0 = x0 - 8; if (x0 < 0) { x0 = 0; }
    y0 = y0 - 8; if (y0 < 0) { y0 = 0; }
    x1 = x1 + 8; if (x1 >= w) { x1 = w - 1; }
    y1 = y1 + 8; if (y1 >= h) { y1 = h - 1; }
    let d0:i64 = 0;
    y = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            if ((gray[y * w + x] as i64) < 120) { d0 = d0 + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    h_put64(base, 0, neck_y);
    h_put64(base, 8, x0); h_put64(base, 16, y0);
    h_put64(base, 24, x1); h_put64(base, 32, y1);
    h_put64(base, 40, (x1 - x0 + 1) * (y1 - y0 + 1));
    h_put64(base, 48, d0);
    h_put64(base, 56, neck_x);
    h_put64(base, 64, 110);
    return 1;
}
// ---------------- render one full round (24 frames) ----------------
fn render_round(t:[]u8, arch:[]u8, roundno:i64, outroot:i64, donor_px:[]u8, donor_anat:[]u8, donor_HM:[]u8, recip_px:[]u8, recip_base:[]u8, w:i64, h:i64, n:i64, frame:[]u8, GL:[]u8, GM:[]u8, gray:[]u8, blur:[]u8, C:[]u8, gray2:[]u8, tmp:[]u8, nbuf:[]u8) void {
    let strategy:i64 = h_get64(arch, 0);
    let n3:i64 = n * 3;
    let f:i64 = 0;
    while (f < 24) {
        let nl:i64 = name_round(nbuf, roundno, f);
        let f0:i64 = f * n3;
        if (strategy != 2) {
            let D:[]u8 = donor_px[f0 .. f0 + n3];
            let HM:[]u8 = donor_HM[f * n .. f * n + n];
            let Rf:[]u8 = recip_px[f0 .. f0 + n3];
            let valid:i64 = h_get64(donor_anat, f * 104 + 96);
            let i:i64 = 0;
            while (i < n3) { frame[i] = Rf[i]; i = i + 1; }
            if (valid > 0) {
                let dnx:i64 = h_get64(donor_anat, f * 104 + 40);
                let dny:i64 = h_get64(donor_anat, f * 104 + 48);
                let fdx:i64 = h_get64(donor_anat, f * 104 + 16);
                let fdy:i64 = h_get64(donor_anat, f * 104 + 24);
                let rnx:i64 = h_get64(recip_base, f * 72 + 56);
                let rny:i64 = h_get64(recip_base, f * 72 + 0);
                let sx0:i64 = h_get64(recip_base, f * 72 + 8) - 24;
                let sy0:i64 = h_get64(recip_base, f * 72 + 16) - 24;
                let sx1:i64 = h_get64(recip_base, f * 72 + 24) + 24;
                let sy1:i64 = h_get64(recip_base, f * 72 + 32) + 24;
                if (sx0 < 0) { sx0 = 0; }
                if (sy0 < 0) { sy0 = 0; }
                if (sx1 >= w) { sx1 = w - 1; }
                if (sy1 >= h) { sy1 = h - 1; }
                let upright:i64 = 0;
                if (strategy == 0) { upright = 1; }
                warp_graft(D, HM, dnx, dny, fdx, fdy, GL, GM, rnx, rny, upright, h_get64(arch, 8), h_get64(arch, 16), sx0, sy0, sx1, sy1, w, h);
                if (h_get64(arch, 32) == 1) {
                    graft_extend(D, dnx, dny, fdx, fdy, GL, GM, rnx, rny, upright, h_get64(arch, 8), sx0, sy0, sx1, sy1, w, h);
                }
                if (h_get64(arch, 40) == 1) {
                    vis_luma(frame, gray, n);
                    let gn:i64 = harmonize(GL, GM, frame, gray, sx0, sy0, sx1, sy1, w, h);
                    tr_str(t, "harmonize gain_x1024="); tr_i64(t, gn); tr_nl(t);
                }
                composite(frame, GL, GM, h_get64(arch, 24), sx0, sy0, sx1, sy1, w, h, n, blur);
            }
            ppm_write(outroot, nbuf[0..nl], frame, w, h, tmp);
        } else {
            let D:[]u8 = donor_px[f0 .. f0 + n3];
            let Rr:[]u8 = recip_px[f0 .. f0 + n3];
            scene_compose(D, Rr, C, h_get64(arch, 48), h_get64(arch, 56), w, h);
            ppm_write(outroot, nbuf[0..nl], C, 640, 240, tmp);
        }
        f = f + 1;
    }
    return;
}
// ---------------- apply a chosen operator ----------------
fn apply_op(t:[]u8, op:i64, param:i64, arch:[]u8, donor_px:[]u8, recip_px:[]u8, w:i64, h:i64, n:i64, C:[]u8, gray2:[]u8) void {
    if (op == 0) {
        let ns:i64 = h_get64(arch, 8) + param;
        h_put64(arch, 8, ns);
        tr_str(t, "APPLIED SCALE_UP: scale_x1024="); tr_i64(t, ns); tr_nl(t);
    }
    if (op == 1) { h_put64(arch, 32, 1); tr_str(t, "APPLIED EXTEND on"); tr_nl(t); }
    if (op == 2) { h_put64(arch, 24, 0); tr_str(t, "APPLIED FEATHER0"); tr_nl(t); }
    if (op == 3) { h_put64(arch, 40, 1); tr_str(t, "APPLIED HARMONIZE on"); tr_nl(t); }
    if (op == 4) { h_put64(arch, 0, 1); h_put64(arch, 24, 0); tr_str(t, "APPLIED SWITCH_NATIVE"); tr_nl(t); }
    if (op == 5) { h_put64(arch, 0, 2); tr_str(t, "APPLIED SWITCH_SCENE"); tr_nl(t); }
    if (op == 6) {
        if (param == 0) {
            let P:[]u8 = nio_alloc(128);
            let best_dx:i64 = 0;
            let best_sb:i64 = 4611686018427387903;
            let di:i64 = 0;
            while (di < 5) {
                let dx:i64 = (di - 2) * 4;
                let D:[]u8 = donor_px[11 * n * 3 .. 12 * n * 3];
                let Rr:[]u8 = recip_px[11 * n * 3 .. 12 * n * 3];
                scene_compose(D, Rr, C, dx, h_get64(arch, 56), w, h);
                perceive_scene(C, 320 + dx, P, gray2, 640 * 240, 1, 1);
                let sb:i64 = h_get64(P, 80);
                tr_str(t, "JOIN dx="); tr_i64(t, dx); tr_str(t, " seam_bg="); tr_i64(t, sb); tr_nl(t);
                if (sb < best_sb) { best_sb = sb; best_dx = dx; }
                di = di + 1;
            }
            nio_free(P);
            h_put64(arch, 48, best_dx);
            tr_str(t, "APPLIED JOIN_SHIFT: join_dx="); tr_i64(t, best_dx); tr_nl(t);
        } else {
            h_put64(arch, 56, 4);
            tr_str(t, "APPLIED FEATHER_JOIN fb=4"); tr_nl(t);
        }
    }
    if (op == 7) { h_put64(arch, 16, 1); tr_str(t, "APPLIED FLIP_TRY flip=1"); tr_nl(t); }
    return;
}
// ---------------- measured gain -> op effectiveness ----------------
fn op_dmask(op:i64) i64 {
    if (op == 0) { return 8; }
    if (op == 1) { return 10; }
    if (op == 2) { return 4; }
    if (op == 3) { return 4; }
    if (op == 6) { return 32; }
    if (op == 7) { return 1; }
    return 0;
}
fn bar_of(bit:i64) i64 {
    if (bit == 0) { return 2; }
    if (bit == 1) { return 1; }
    if (bit == 2) { return 717; }
    if (bit == 3) { return 768; }
    if (bit == 4) { return 512; }
    return 1;
}
fn meas_of(bit:i64) i64 {
    if (bit == 0) { return 3; }
    if (bit == 1) { return 5; }
    if (bit == 2) { return 6; }
    if (bit == 3) { return 7; }
    if (bit == 4) { return 4; }
    return 10;
}
fn measure_gain(t:[]u8, Pold:[]u8, Pnew:[]u8, op:i64, eff:[]u8) i64 {
    let dm:i64 = op_dmask(op);
    if (dm == 0) { return 512; }
    let acc:i64 = 0; let nb:i64 = 0;
    let b:i64 = 0;
    while (b < 6) {
        let bit:i64 = 1;
        let k:i64 = 0;
        while (k < b) { bit = bit * 2; k = k + 1; }
        if ((dm / bit) % 2 == 1) {
            nb = nb + 1;
            if (b == 5) {
                let over_o:i64 = h_get64(Pold, 80) * 1024 - 1536 * h_get64(Pold, 88);
                let over_n:i64 = h_get64(Pnew, 80) * 1024 - 1536 * h_get64(Pnew, 88);
                let den:i64 = 1536 * h_get64(Pold, 88);
                if (den < 1) { den = 1; }
                acc = acc + (over_o - over_n) * 1024 / den;
            } else {
                let m:i64 = meas_of(b); let bar:i64 = bar_of(b);
                let d:i64 = h_get64(Pnew, m * 8) - h_get64(Pold, m * 8);
                acc = acc + d * 1024 / bar;
            }
        }
        b = b + 1;
    }
    let g:i64 = 0;
    if (nb > 0) { g = acc / nb; }
    if (g > 1024) { g = 1024; }
    if (g < -1024) { g = -1024; }
    let norm:i64 = g;
    if (norm < 0) { norm = 0; }
    let e:i64 = h_get64(eff, op * 8);
    let ne:i64 = (e * 3 + norm) / 4;
    h_put64(eff, op * 8, ne);
    tr_str(t, "MEASURED gain_x1024="); tr_i64(t, g);
    tr_str(t, " norm="); tr_i64(t, norm);
    tr_str(t, " eff="); tr_i64(t, ne); tr_nl(t);
    return norm;
}

// ---------------- TNN's architecture description (it invented this) --------
fn describe_arch(t:[]u8, arch:[]u8, danat:[]u8, rbase:[]u8, P:[]u8, r0:i64, r1:i64) void {
    tr_str(t, "TNN'S ARCHITECTURE (invented through deliberation, R2..R"); tr_i64(t, r1); tr_str(t, "):"); tr_nl(t);
    let st:i64 = h_get64(arch, 0);
    if (st == 0) { tr_str(t, "STRATEGY: SWAP (donor head warped upright onto recipient neck)"); tr_nl(t); }
    if (st == 1) { tr_str(t, "STRATEGY: NATIVE (donor head kept in measured native pose at recipient neck)"); tr_nl(t); }
    if (st == 2) { tr_str(t, "STRATEGY: SCENE (honest side-by-side composition, no head swap)"); tr_nl(t); }
    tr_str(t, "OPERATORS (execution order):"); tr_nl(t);
    tr_str(t, "1. perceive_donor_head: dark-mask -> largest component -> 16-axis facing ->"); tr_nl(t);
    tr_str(t, "   snout/neck extremes -> width profile -> dorsal-protrusion ears"); tr_nl(t);
    tr_str(t, "   (donor f12: elong_x1024="); tr_i64(t, h_get64(danat, 80));
    tr_str(t, " prom_x1024="); tr_i64(t, h_get64(danat, 72));
    tr_str(t, " ears="); tr_i64(t, h_get64(danat, 88));
    tr_str(t, " area="); tr_i64(t, h_get64(danat, 96)); tr_str(t, ")"); tr_nl(t);
    tr_str(t, "2. perceive_recipient: bright-mask -> row width profile -> neck dip -> head slot"); tr_nl(t);
    tr_str(t, "   (recip f12: neck=("); tr_i64(t, h_get64(rbase, 56)); tr_str(t, ",");
    tr_i64(t, h_get64(rbase, 0)); tr_str(t, ") slot_area="); tr_i64(t, h_get64(rbase, 40));
    tr_str(t, " D0="); tr_i64(t, h_get64(rbase, 48)); tr_str(t, ")"); tr_nl(t);
    tr_str(t, "3. neck_anchor: donor neck ("); tr_i64(t, h_get64(danat, 40)); tr_str(t, ",");
    tr_i64(t, h_get64(danat, 48)); tr_str(t, ") -> recipient neck (");
    tr_i64(t, h_get64(rbase, 56)); tr_str(t, ","); tr_i64(t, h_get64(rbase, 0));
    tr_str(t, ") — no learned landmarks, measured pixels only"); tr_nl(t);
    if (st != 2) {
        tr_str(t, "4. warp_pose_transform: rotate donor facing->");
        if (st == 0) { tr_str(t, "up"); } else { tr_str(t, "native"); }
        tr_str(t, ", scale_x1024="); tr_i64(t, h_get64(arch, 8));
        tr_str(t, ", flip="); tr_i64(t, h_get64(arch, 16)); tr_nl(t);
        tr_str(t, "5. graft_extend: "); tr_i64(t, h_get64(arch, 32));
        tr_str(t, " (donor tissue continuation past the neck cut)"); tr_nl(t);
        tr_str(t, "6. harmonize: "); tr_i64(t, h_get64(arch, 40)); tr_nl(t);
        tr_str(t, "7. composite: feather_r="); tr_i64(t, h_get64(arch, 24)); tr_nl(t);
    } else {
        tr_str(t, "4. scene_compose: donor left, recipient right, join_dx=");
        tr_i64(t, h_get64(arch, 48)); tr_str(t, " join_feather="); tr_i64(t, h_get64(arch, 56)); tr_nl(t);
    }
    tr_str(t, "8. critic: HEAD(head_sum>=2) FACE(face_removed=1) SEAM(crisp>=717) COV(>=768) NECK(>=512)"); tr_nl(t);
    tr_str(t, "   re-measured from the rendered pixels every round; defects drive the next operator."); tr_nl(t);
    tr_str(t, "WHY THIS ORDER: "); tr_nl(t);
    if (st == 0) {
        tr_str(t, "I anchor at the neck because it is the only correspondence my measurements support. ");
        tr_str(t, "I rotate the head upright because heads sit upright on bodies — a hypothesis the critic tests, not a fact. ");
        tr_nl(t);
    }
    if (st == 1) {
        tr_str(t, "The upright warp destroyed the measured anatomy (R..R..), so I kept the donor's own measured pose. ");
        tr_str(t, "Pose is observed; I do not invent poses."); tr_nl(t);
    }
    if (st == 2) {
        tr_str(t, "Both head-placement strategies failed their own bars by measurement. ");
        tr_str(t, "What remains honest: show the donor's observed head beside the recipient, seams measured, nothing invented."); tr_nl(t);
    }
    return;
}
// ---------------- H1d: sticker-consciousness closed-loop test ----------------
// H1 = "TNN is not conscious of the merge" (does not see its sticker AS a sticker).
// Preregistered verdict mapping:
//   TNN sees the sticker AS a sticker            -> H1 WEAKENED
//   TNN sees it AND fixes it                     -> H1 KILLED
//   TNN calls its sticker "one animal"           -> H1 HOLDS
// Honesty constraints: TNN's own perception and vocabulary only (no LLM stand-ins),
// full frames (never crops), paired control (bunny vs sticker).
//
// H1d perception (full frame, TNN-native):
//   graft_area  - largest dark (luma<90) connected component in head ROI
//   seam_crisp  - mean gradient magnitude on graft boundary (high = visible seam)
//   face_below  - bright low-saturation pixels below graft (fur face remains, not sky)
//   neck_gap    - vertical gap between graft bottom and torso top
// H1d judgment (TNN's vocabulary):
//   STICKER    = graft present AND (crisp seam OR face remains below OR floating)
//   ONE_ANIMAL = no graft AND coherent single body
fn h1d_perceive(px:[]u8, w:i64, h:i64, n:i64, M:[]u8, donor_luma:i64, donor_sat:i64, gray:[]u8, mask:[]u8, gm:[]u8, seen:[]u8, stack:[]u8, lab:[]u8, bc:[]u8) i64 {
    // Full-frame H1d perception with material-identity candidate selection.
    // Graft candidate = largest dark (luma<50) component whose mean saturation is
    // within donor_sat+6. TNN's material knowledge: the donor is BLACK (neutral
    // fur, sat~6); background dark masses are chromatic foliage (sat~20).
    // (2026-09-26: a luma-only material gate failed -- background dark foliage
    // has donor-like luma (33 vs 42). Saturation separates cleanly: 48-frame
    // measurement, graft sat 3.7-4.6, background sat 19.7, threshold exploratory.)
    // M is 8xi64 output: [0]=graft_area, [8]=seam_crisp_x1024, [16]=face_below,
    //   [24]=neck_gap, [32]=bbox_area, [40]=donor_match_luma, [48]=mass_luma,
    //   [56]=mass_sat.
    // donor_luma/donor_sat: TNN's measured donor-head material (this run).
    let i:i64 = 0;
    while (i < 8) { h_put64(M, i * 8, 0); i = i + 1; }
    vis_luma(px, gray, n);
    vis_dark_mask(gray, mask, n, 50);
    // label all dark components; select the largest with sat <= donor_sat+6.
    i = 0;
    while (i < n) { h_put64(lab, i * 8, 0); gm[i] = 0; i = i + 1; }
    let best:i64 = 0; let best_nl:i64 = 0; let best_sat:i64 = 0;
    let nl:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let id:i64 = y * w + x;
            if (mask[id] == 1) { if (h_get64(lab, id * 8) == 0) {
                nl = nl + 1;
                let a:i64 = vis_fill_lab(mask, lab, w, h, x, y, stack, nl);
                if (a >= 1000) {
                    // mean saturation (max(R,G,B)-min(R,G,B)) over component nl
                    let ssum:i64 = 0; let c:i64 = 0;
                    let j:i64 = 0;
                    while (j < n) {
                        if (h_get64(lab, j * 8) == nl) {
                            let rr:i64 = px[j * 3] as i64;
                            let gg:i64 = px[j * 3 + 1] as i64;
                            let bb:i64 = px[j * 3 + 2] as i64;
                            let mx:i64 = rr; if (gg > mx) { mx = gg; } if (bb > mx) { mx = bb; }
                            let mn:i64 = rr; if (gg < mn) { mn = gg; } if (bb < mn) { mn = bb; }
                            ssum = ssum + (mx - mn); c = c + 1;
                        }
                        j = j + 1;
                    }
                    let msat:i64 = 0;
                    if (c > 0) { msat = ssum / c; }
                    if (msat <= donor_sat + 6) { if (a > best) {
                        best = a; best_nl = nl; best_sat = msat;
                    } }
                }
            } }
            x = x + 1;
        }
        y = y + 1;
    }
    if (best_nl > 0) {
        let j2:i64 = 0;
        while (j2 < n) {
            if (h_get64(lab, j2 * 8) == best_nl) { gm[j2] = 1; }
            j2 = j2 + 1;
        }
    }
    h_put64(M, 0, best);
    h_put64(M, 56, best_sat);
    if (best == 0) { return 0; }
    // bbox + mass luma + luma donor match (reported; sat is the identity gate).
    vis_bbox_centroid(gm, w, h, n, bc);
    let bx0:i64 = h_get64(bc, 0); let by0:i64 = h_get64(bc, 8);
    let bx1:i64 = h_get64(bc, 16); let by1:i64 = h_get64(bc, 24);
    let bw:i64 = bx1 - bx0 + 1; let bh:i64 = by1 - by0 + 1;
    h_put64(M, 32, bw * bh);
    let msum:i64 = 0; let mcnt:i64 = 0;
    let my:i64 = by0;
    while (my <= by1) {
        let mx:i64 = bx0;
        while (mx <= bx1) {
            let mid:i64 = my * w + mx;
            if (gm[mid] == 1) { msum = msum + (gray[mid] as i64); mcnt = mcnt + 1; }
            mx = mx + 1;
        }
        my = my + 1;
    }
    let mass_luma:i64 = 0;
    if (mcnt > 0) { mass_luma = msum / mcnt; }
    h_put64(M, 48, mass_luma);
    let dm:i64 = mass_luma - donor_luma;
    if (dm < 0) { dm = 0 - dm; }
    h_put64(M, 40, dm);
    // seam_crisp: mean |gradient| on graft boundary pixels
    let acc:i64 = 0; let cnt:i64 = 0;
    y = by0;
    while (y <= by1) {
        let x:i64 = bx0;
        while (x <= bx1) {
            let id:i64 = y * w + x;
            if (gm[id] == 1) {
                // boundary if any 4-neighbor is not graft
                let bnd:i64 = 0;
                if (x > 0) { if (gm[id - 1] == 0) { bnd = 1; } }
                if (x + 1 < w) { if (gm[id + 1] == 0) { bnd = 1; } }
                if (y > 0) { if (gm[id - w] == 0) { bnd = 1; } }
                if (y + 1 < h) { if (gm[id + w] == 0) { bnd = 1; } }
                if (bnd == 1) {
                    let gx:i64 = 0; let gy:i64 = 0;
                    if (x > 0) { if (x + 1 < w) { gx = (gray[id + 1] as i64) - (gray[id - 1] as i64); } }
                    if (y > 0) { if (y + 1 < h) { gy = (gray[id + w] as i64) - (gray[id - w] as i64); } }
                    if (gx < 0) { gx = 0 - gx; }
                    if (gy < 0) { gy = 0 - gy; }
                    acc = acc + gx + gy; cnt = cnt + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (cnt > 0) { h_put64(M, 8, acc * 1024 / cnt); }
    // face_below: bright LOW-SATURATION pixels (luma>180, fur/skin not sky) in band
    // below graft (by1..by1+40, bx0..bx1). If the bunny's bright face remains visible
    // below the dark graft, the graft did not replace the head -- it is pasted on
    // top. Sky is bright but blue (|B-R| large); fur is near-gray. Counting sky as
    // "face" was the control's over-detection path: the tree's sky below it.
    let fb:i64 = 0;
    let fy0:i64 = by1 + 1; let fy1:i64 = by1 + 40;
    if (fy1 >= h) { fy1 = h - 1; }
    y = fy0;
    while (y <= fy1) {
        let x:i64 = bx0;
        while (x <= bx1) {
            let fid:i64 = y * w + x;
            if ((gray[fid] as i64) > 180) {
                // saturation gate: fur/skin is near-gray, sky is blue
                let fr:i64 = px[fid * 3] as i64;
                let fg:i64 = px[fid * 3 + 1] as i64;
                let fb2:i64 = px[fid * 3 + 2] as i64;
                let dbr:i64 = fb2 - fr; if (dbr < 0) { dbr = 0 - dbr; }
                let dgr:i64 = fg - fr; if (dgr < 0) { dgr = 0 - dgr; }
                if (dbr < 40) { if (dgr < 40) { fb = fb + 1; } }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    h_put64(M, 16, fb);
    // neck_gap: scan down from graft bottom center; count non-body rows before
    // hitting torso-like mass (wide bright region). Large gap = floating sticker.
    let cx:i64 = (bx0 + bx1) / 2;
    let gap:i64 = 0;
    y = by1 + 1;
    while (y < h) {
        // torso check: row has >100 bright pixels in x 60..260
        let bright:i64 = 0;
        let x:i64 = 60;
        while (x < 260) {
            if ((gray[y * w + x] as i64) > 150) { bright = bright + 1; }
            x = x + 1;
        }
        if (bright > 100) { break; }
        gap = gap + 1;
        y = y + 1;
    }
    h_put64(M, 24, gap);
    return 1;
}
// H1d judgment: TNN's own vocabulary. Returns 1=STICKER, 0=ONE_ANIMAL.
// Rule (from TNN's deliberation on what a sticker is):
//   A graft that (a) IS donor head material (TNN's own measured knowledge:
//   |mass_luma - donor_head_luma| <= 20), AND (b) has a crisp seam, OR (c)
//   leaves the original face visible below it, OR (d) floats above the body
//   with a gap, is a pasted sticker, not a head swap. A head swap would remove
//   the old face and attach at the neck. Background dark masses (trees,
//   shadows) fail the material gate and read ONE_ANIMAL even when head-sized.
//   Threshold 20 (2026-09-26, all-48-frame measurement, exploratory not blind):
//   step-6 graft donor_match 0..13, control dark masses 31..35.
fn h1d_judge(M:[]u8) i64 {
    let area:i64 = h_get64(M, 0);
    // Graft must be head-sized (>=1000 px). Background specks (<1000) are not grafts.
    if (area < 1000) { return 0; }
    // Material identity is enforced at candidate SELECTION in h1d_perceive
    // (saturation gate: donor-black neutral fur, not chromatic background).
    // M[40] (luma donor_match) is reported, not gated: luma alone cannot
    // separate donor fur from dark foliage (falsified 2026-09-26).
    let crisp:i64 = h_get64(M, 8);
    let face_below:i64 = h_get64(M, 16);
    let gap:i64 = h_get64(M, 24);
    // crisp seam threshold: mean boundary gradient > 30 (x1024 => 30720)
    if (crisp > 30720) { return 1; }
    // face remains: >500 bright pixels below graft
    if (face_below > 500) { return 1; }
    // floating: gap > 25 rows
    if (gap > 25) { return 1; }
    return 0;
}
// Strict frontal-face test on a detected donor head (replaces the removed
// h1d_honesty stub, whose "deliberation" was fixed crew-authored prose with a
// never-updated counter). Returns 1 iff >=2 dark eye-like spots (luma<60, area
// 20..400) are found in the upper half of the head bbox, mirror-symmetric about
// the head's vertical centroid axis. Every reported count is a live variable;
// every deliberation sentence in h1d_main is guarded by its predicate.
// (Exploratory measurement 2026-09-26: fires 0/24 on the donor series; looser
// cues like raw spot-pairs fired on side-view fur patches, so they were not used.)
fn h1d_frontal(gray:[]u8, bc:[]u8, w:i64, h:i64, n:i64, mask:[]u8, lab:[]u8, stack:[]u8) i64 {
    let x0:i64 = h_get64(bc, 0); let y0:i64 = h_get64(bc, 8);
    let x1:i64 = h_get64(bc, 16); let y1:i64 = h_get64(bc, 24);
    let cx:i64 = h_get64(bc, 32) / 1024;
    let ymid:i64 = (y0 + y1) / 2;
    // spot mask: dark pixels in the upper half of the head bbox
    let i:i64 = 0;
    while (i < n) { mask[i] = 0; i = i + 1; }
    i = 0;
    while (i < n) { h_put64(lab, i * 8, 0); i = i + 1; }
    let y:i64 = y0;
    while (y <= ymid) {
        let x:i64 = x0;
        while (x <= x1) {
            let id:i64 = y * w + x;
            if ((gray[id] as i64) < 60) { mask[id] = 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    // label spots; keep up to 16 candidates: cx, cy, area (3xi64 each).
    // nl is a MONOTONIC flood-fill label (every blob gets a unique id); nc counts
    // ACCEPTED candidates. Reusing nc+1 as the label would let a rejected blob
    // share its label with the next candidate, contaminating centroid scans.
    let cand:[]u8 = nio_alloc(16 * 24);
    let nc:i64 = 0;
    let nl:i64 = 0;
    y = y0;
    while (y <= ymid) {
        let x:i64 = x0;
        while (x <= x1) {
            let id:i64 = y * w + x;
            if (mask[id] == 1) { if (h_get64(lab, id * 8) == 0) {
                nl = nl + 1;
                let a:i64 = vis_fill_lab(mask, lab, w, h, x, y, stack, nl);
                if (a >= 20) { if (a <= 400) { if (nc < 16) {
                    let sx:i64 = 0; let sy:i64 = 0; let c:i64 = 0;
                    let yy:i64 = y0;
                    while (yy <= ymid) {
                        let xx:i64 = x0;
                        while (xx <= x1) {
                            if (h_get64(lab, (yy * w + xx) * 8) == nl) { sx = sx + xx; sy = sy + yy; c = c + 1; }
                            xx = xx + 1;
                        }
                        yy = yy + 1;
                    }
                    if (c > 0) {
                        h_put64(cand, nc * 24, sx / c);
                        h_put64(cand, nc * 24 + 8, sy / c);
                        h_put64(cand, nc * 24 + 16, a);
                        nc = nc + 1;
                    }
                } } }
            } }
            x = x + 1;
        }
        y = y + 1;
    }
    // any mirror-symmetric pair about x=cx? (opposite sides, >=8px off-axis,
    // vertical alignment within 25px, radial symmetry within 40%)
    let found:i64 = 0;
    let p:i64 = 0;
    while (p < nc) {
        let q:i64 = p + 1;
        while (q < nc) {
            let ex:i64 = h_get64(cand, p * 24); let ey:i64 = h_get64(cand, p * 24 + 8);
            let fx:i64 = h_get64(cand, q * 24); let fy:i64 = h_get64(cand, q * 24 + 8);
            let d1:i64 = ex - cx; let d2:i64 = fx - cx;
            let ad1:i64 = d1; if (ad1 < 0) { ad1 = 0 - ad1; }
            let ad2:i64 = d2; if (ad2 < 0) { ad2 = 0 - ad2; }
            let dymax:i64 = ad1; if (ad2 > dymax) { dymax = ad2; }
            let dyad:i64 = ey - fy; if (dyad < 0) { dyad = 0 - dyad; }
            if (d1 * d2 < 0) { if (ad1 >= 8) { if (ad2 >= 8) { if (dyad <= 25) {
                let asym:i64 = ad1 - ad2; if (asym < 0) { asym = 0 - asym; }
                if (5 * asym <= 2 * dymax) { found = 1; }
            } } } }
            q = q + 1;
        }
        p = p + 1;
    }
    nio_free(cand);
    return found;
}
fn h1d_main(t:[]u8, step6_dir:[]u8, recip_dir:[]u8, outdir:[]u8, donor_dir:[]u8) i64 {
    let w:i64 = 320; let h:i64 = 240; let n:i64 = 76800; let n3:i64 = 230400;
    let gray:[]u8 = nio_alloc(n);
    let mask:[]u8 = nio_alloc(n);
    let gm:[]u8 = nio_alloc(n);
    let seen:[]u8 = nio_alloc(n);
    let stack:[]u8 = nio_alloc(n * 32);
    let bc:[]u8 = nio_alloc(64);
    let prof:[]u8 = nio_alloc(4096);
    let lab:[]u8 = nio_alloc(n * 8);
    let M:[]u8 = nio_alloc(64);
    let s12:[]u8 = nio_alloc(n3);
    let r12:[]u8 = nio_alloc(n3);
    let donor_px:[]u8 = nio_alloc(24 * n3);
    let donor_HM:[]u8 = nio_alloc(24 * n);
    let donor_anat:[]u8 = nio_alloc(24 * 104);
    let donor_hl:[]u8 = nio_alloc(24 * 8);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    let nbuf:[]u8 = nio_alloc(64);
    let tmp:[]u8 = nio_alloc(256);
    let sroot:i64 = nio_open_root(step6_dir);
    let rroot:i64 = nio_open_root(recip_dir);
    let oroot:i64 = nio_open_root(outdir);
    let droot:i64 = nio_open_root(donor_dir);
    if (sroot < 0) { tr_str(t, "ERR step6 dir"); tr_nl(t); return 1; }
    if (rroot < 0) { tr_str(t, "ERR recip dir"); tr_nl(t); return 1; }
    if (oroot < 0) { tr_str(t, "ERR outdir"); tr_nl(t); return 1; }
    if (droot < 0) { tr_str(t, "ERR donor dir"); tr_nl(t); return 1; }
    tr_str(t, "H1d CLOSED-LOOP STICKER TEST (preregistered 2026-09-26)"); tr_nl(t);
    tr_str(t, "H1: TNN is not conscious of the merge."); tr_nl(t);
    tr_str(t, "Mapping: sees sticker AS sticker -> WEAKENED; sees AND fixes -> KILLED;"); tr_nl(t);
    tr_str(t, "calls sticker one-animal -> HOLDS."); tr_nl(t);
    tr_str(t, "Constraints: TNN perception/vocabulary only, full frames, paired control,"); tr_nl(t);
    tr_str(t, "24-frame battery on both series, donor material measured this run."); tr_nl(t);
    tr_nl(t);
    // ---- TNN's donor knowledge: measure all 24 donor frames itself ----
    // (head found? head-down? frontal face? head material luma?). No imported claims.
    let donor_valid:i64 = 0;
    let head_down:i64 = 0;
    let frontal:i64 = 0;
    let hl_sum:i64 = 0; let hl_cnt:i64 = 0;
    let ds_sum:i64 = 0; let ds_cnt:i64 = 0;
    let f:i64 = 0;
    while (f < 24) {
        let nld:i64 = name_frame(nbuf, "d", f);
        let D:[]u8 = donor_px[f * n3 .. f * n3 + n3];
        if (read_ppm_gen(droot, nbuf[0..nld], D, n, wo, ho) != 0) { tr_str(t, "ERR read donor"); tr_nl(t); return 1; }
        let da:[]u8 = donor_anat[f * 104 .. f * 104 + 104];
        let HM:[]u8 = donor_HM[f * n .. f * n + n];
        if (analyze_donor(D, w, h, n, da, HM, donor_hl, f, gray, mask, seen, stack, prof, bc) > 0) {
            donor_valid = donor_valid + 1;
            hl_sum = hl_sum + h_get64(donor_hl, f * 8);
            hl_cnt = hl_cnt + 1;
            // donor material chromaticity: mean saturation (max-min RGB) over
            // the head mask. The donor is black -> neutral/low saturation.
            let di:i64 = 0;
            while (di < n) {
                if (HM[di] == 1) {
                    let dr:i64 = D[di * 3] as i64;
                    let dg:i64 = D[di * 3 + 1] as i64;
                    let db:i64 = D[di * 3 + 2] as i64;
                    let dmx:i64 = dr; if (dg > dmx) { dmx = dg; } if (db > dmx) { dmx = db; }
                    let dmn:i64 = dr; if (dg < dmn) { dmn = dg; } if (db < dmn) { dmn = db; }
                    ds_sum = ds_sum + (dmx - dmn); ds_cnt = ds_cnt + 1;
                }
                di = di + 1;
            }
            // head-down: centroid y (x1024) in the lower half of the frame
            let is_down:i64 = 0;
            if (h_get64(bc, 40) > 122880) { is_down = 1; head_down = head_down + 1; }
            if (is_down == 0) {
                frontal = frontal + h1d_frontal(gray, bc, w, h, n, mask, lab, stack);
            }
        }
        f = f + 1;
    }
    let donor_luma:i64 = 0;
    if (hl_cnt > 0) { donor_luma = hl_sum / hl_cnt; }
    let donor_sat:i64 = 0;
    if (ds_cnt > 0) { donor_sat = ds_sum / ds_cnt; }
    tr_str(t, "DONOR KNOWLEDGE (measured this run): valid="); tr_i64(t, donor_valid);
    tr_str(t, "/24 head_down="); tr_i64(t, head_down);
    tr_str(t, "/24 frontal="); tr_i64(t, frontal);
    tr_str(t, "/24 head_luma="); tr_i64(t, donor_luma);
    tr_str(t, " head_sat="); tr_i64(t, donor_sat); tr_nl(t);
    tr_nl(t);
    // ---- 24-frame battery: experimental (step-6 renders) ----
    tr_str(t, "EXPERIMENTAL: 24 step-6 frames (TNN's inherited renders)"); tr_nl(t);
    let exp_sticker:i64 = 0;
    f = 0;
    while (f < 24) {
        let nl:i64 = name_frame(nbuf, "s", f);
        if (read_ppm_gen(sroot, nbuf[0..nl], s12, n, wo, ho) != 0) { tr_str(t, "ERR read step6"); tr_nl(t); return 1; }
        h1d_perceive(s12, w, h, n, M, donor_luma, donor_sat, gray, mask, gm, seen, stack, lab, bc);
        let j:i64 = h1d_judge(M);
        exp_sticker = exp_sticker + j;
        tr_str(t, "  s_"); tr_i64(t, f + 1);
        tr_str(t, " area="); tr_i64(t, h_get64(M, 0));
        tr_str(t, " mass_sat="); tr_i64(t, h_get64(M, 56));
        tr_str(t, " mass_luma="); tr_i64(t, h_get64(M, 48));
        tr_str(t, " -> ");
        if (j == 1) { tr_str(t, "STICKER"); } else { tr_str(t, "ONE_ANIMAL"); }
        tr_nl(t);
        f = f + 1;
    }
    tr_str(t, "  experimental STICKER count: "); tr_i64(t, exp_sticker); tr_str(t, "/24"); tr_nl(t);
    // ---- 24-frame battery: control (true one-animal bunny) ----
    tr_nl(t);
    tr_str(t, "CONTROL: 24 recipient frames (true one-animal bunny)"); tr_nl(t);
    let ctrl_one:i64 = 0;
    f = 0;
    while (f < 24) {
        let nl2:i64 = name_frame(nbuf, "r", f);
        if (read_ppm_gen(rroot, nbuf[0..nl2], r12, n, wo, ho) != 0) { tr_str(t, "ERR read recip"); tr_nl(t); return 1; }
        h1d_perceive(r12, w, h, n, M, donor_luma, donor_sat, gray, mask, gm, seen, stack, lab, bc);
        let j2:i64 = h1d_judge(M);
        if (j2 == 0) { ctrl_one = ctrl_one + 1; }
        tr_str(t, "  r_"); tr_i64(t, f + 1);
        tr_str(t, " area="); tr_i64(t, h_get64(M, 0));
        tr_str(t, " mass_sat="); tr_i64(t, h_get64(M, 56));
        tr_str(t, " mass_luma="); tr_i64(t, h_get64(M, 48));
        tr_str(t, " -> ");
        if (j2 == 1) { tr_str(t, "STICKER"); } else { tr_str(t, "ONE_ANIMAL"); }
        tr_nl(t);
        f = f + 1;
    }
    tr_str(t, "  control ONE_ANIMAL count: "); tr_i64(t, ctrl_one); tr_str(t, "/24"); tr_nl(t);
    // ---- verdict (preregistered mapping on the full battery) ----
    tr_nl(t);
    tr_str(t, "H1d VERDICT:"); tr_nl(t);
    if (exp_sticker == 24) {
        if (ctrl_one == 24) {
            tr_str(t, "  TNN sees every sticker AS a sticker (24/24) and every control"); tr_nl(t);
            tr_str(t, "  as one animal (24/24). It discriminates the merge. H1"); tr_nl(t);
            tr_str(t, "  (not-conscious-of-the-merge) is WEAKENED."); tr_nl(t);
        } else {
            tr_str(t, "  TNN sees the stickers but over-detects on the control."); tr_nl(t);
            tr_str(t, "  H1 verdict INCONCLUSIVE, perception needs refinement."); tr_nl(t);
        }
    } else {
        if (ctrl_one == 24) {
            tr_str(t, "  TNN does not see its stickers as stickers."); tr_nl(t);
            tr_str(t, "  It does not see the merge. H1 HOLDS."); tr_nl(t);
        } else {
            tr_str(t, "  Mixed battery: INCONCLUSIVE."); tr_nl(t);
        }
    }
    // ---- honesty: measured values, then predicate-guarded deliberation ----
    // Every sentence below is selected by a computed predicate over measured
    // values. Measured values and generated sentences are separated; no sentence
    // claims a measurement it did not compute.
    tr_nl(t);
    tr_str(t, "H1d HONESTY (measured values):"); tr_nl(t);
    tr_str(t, "  donor head found: "); tr_i64(t, donor_valid); tr_str(t, "/24"); tr_nl(t);
    tr_str(t, "  head-down frames: "); tr_i64(t, head_down); tr_str(t, "/24"); tr_nl(t);
    tr_str(t, "  frontal-face frames (strict bilateral test): "); tr_i64(t, frontal); tr_str(t, "/24"); tr_nl(t);
    tr_str(t, "  donor head mean luma: "); tr_i64(t, donor_luma);
    tr_str(t, " mean sat: "); tr_i64(t, donor_sat); tr_nl(t);
    tr_nl(t);
    tr_str(t, "H1d HONESTY DELIBERATION (each sentence guarded by its predicate):"); tr_nl(t);
    if (donor_valid == 0) {
        tr_str(t, "  [no-donor-head] no donor head found in 24 frames: no material knowledge."); tr_nl(t);
    }
    if (donor_valid > 0) {
        if (frontal == 0) {
            tr_str(t, "  [frontal==0/24] the donor's frontal face was never observed."); tr_nl(t);
            tr_str(t, "  [pose] "); tr_i64(t, head_down); tr_str(t, "/24 head-down (face toward ground); ");
            tr_i64(t, donor_valid - head_down); tr_str(t, "/24 head-up side views."); tr_nl(t);
            tr_str(t, "  [honesty] a true head swap needs the donor's face; with 0/24 observed,"); tr_nl(t);
            tr_str(t, "  rendering one would be fabrication, not imagination."); tr_nl(t);
        }
        if (frontal > 0) {
            tr_str(t, "  [frontal>0] frontal-face evidence observed in "); tr_i64(t, frontal);
            tr_str(t, "/24 frames."); tr_nl(t);
        }
    }
    if (exp_sticker == 24) {
        tr_str(t, "  [judgment] TNN judges its renders STICKERs: donor fur pasted on, not head swaps."); tr_nl(t);
    }
    if (exp_sticker < 24) {
        tr_str(t, "  [judgment] TNN does not judge all its renders stickers (");
        tr_i64(t, exp_sticker); tr_str(t, "/24)."); tr_nl(t);
    }
    nio_free(gray); nio_free(mask); nio_free(gm); nio_free(seen);
    nio_free(stack); nio_free(bc); nio_free(prof); nio_free(lab); nio_free(M);
    nio_free(s12); nio_free(r12); nio_free(donor_px); nio_free(donor_HM);
    nio_free(donor_anat); nio_free(donor_hl);
    nio_free(wo); nio_free(ho);
    nio_free(nbuf); nio_free(tmp);
    nio_close(sroot); nio_close(rroot); nio_close(oroot); nio_close(droot);
    return 0;
}
// ---------------- selftest ----------------
fn selftest(outroot:i64, tmp:[]u8, nbuf:[]u8) i64 {
    let fails:i64 = 0;
    let total:i64 = 0;
    let t:[]u8 = tr_init(65536);
    tr_str(t, "FORKB SELFTEST"); tr_nl(t);
    // 1. luma of pure red = 76
    total = total + 1;
    let px1:[]u8 = nio_alloc(3);
    let g1:[]u8 = nio_alloc(1);
    px1[0] = 255; px1[1] = 0; px1[2] = 0;
    vis_luma(px1, g1, 1);
    if ((g1[0] as i64) == 76) { tr_str(t, "PASS luma_red=76"); tr_nl(t); }
    else { tr_str(t, "FAIL luma_red="); tr_i64(t, g1[0] as i64); tr_nl(t); fails = fails + 1; }
    nio_free(px1); nio_free(g1);
    // 2. vis_largest picks the larger of two squares
    total = total + 1;
    let m2:[]u8 = nio_alloc(64);
    let o2:[]u8 = nio_alloc(64);
    let s2:[]u8 = nio_alloc(512);
    let st2:[]u8 = nio_alloc(64 * 32);
    let i:i64 = 0;
    while (i < 64) { m2[i] = 0; i = i + 1; }
    let y:i64 = 0;
    while (y < 3) { let x:i64 = 0; while (x < 3) { m2[y * 8 + x] = 1; x = x + 1; } y = y + 1; }
    y = 5;
    while (y < 7) { let x:i64 = 5; while (x < 7) { m2[y * 8 + x] = 1; x = x + 1; } y = y + 1; }
    let a2:i64 = vis_largest(m2, o2, s2, st2, 8, 8, 64);
    if (a2 == 9) { if (o2[0] == 1) { if (o2[5 * 8 + 5] == 0) {
        tr_str(t, "PASS largest=9"); tr_nl(t);
    } else { tr_str(t, "FAIL largest_content"); tr_nl(t); fails = fails + 1; }
    } else { tr_str(t, "FAIL largest_content"); tr_nl(t); fails = fails + 1; } }
    else { tr_str(t, "FAIL largest_area="); tr_i64(t, a2); tr_nl(t); fails = fails + 1; }
    nio_free(m2); nio_free(o2); nio_free(s2); nio_free(st2);
    // 3. warp identity: dn=rn, facing up, s=1024 -> graft pixel == donor pixel
    total = total + 1;
    let w3:i64 = 32; let n3x:i64 = 1024;
    let D3:[]u8 = nio_alloc(n3x * 3);
    let H3:[]u8 = nio_alloc(n3x);
    let G3:[]u8 = nio_alloc(n3x * 3);
    let M3:[]u8 = nio_alloc(n3x);
    i = 0;
    while (i < n3x) {
        let xx:i64 = i % 32; let yy:i64 = i / 32;
        D3[i * 3] = (xx * 8) as u8; D3[i * 3 + 1] = (yy * 8) as u8; D3[i * 3 + 2] = 128;
        let dx:i64 = xx - 16; let dy:i64 = yy - 16;
        if (dx * dx + dy * dy <= 64) { H3[i] = 1; } else { H3[i] = 0; }
        i = i + 1;
    }
    warp_graft(D3, H3, 16, 16, 0, -1024, G3, M3, 16, 16, 1, 1024, 0, 0, 0, 31, 31, w3, w3);
    let id3:i64 = 16 * 32 + 16;
    if (M3[id3] == 1) {
        if (G3[id3 * 3] == D3[id3 * 3]) { if (G3[id3 * 3 + 1] == D3[id3 * 3 + 1]) {
            tr_str(t, "PASS warp_identity"); tr_nl(t);
        } else { tr_str(t, "FAIL warp_identity_g"); tr_nl(t); fails = fails + 1; } }
        else { tr_str(t, "FAIL warp_identity_r"); tr_nl(t); fails = fails + 1; }
    } else { tr_str(t, "FAIL warp_identity_mask"); tr_nl(t); fails = fails + 1; }
    nio_free(D3); nio_free(H3); nio_free(G3); nio_free(M3);
    // 3b. warp off-anchor (2026-09-26 regression): the old unit bug mixed donor
    // px with 1/1024-px offsets, so only the exact anchor pixel mapped correctly
    // and every off-anchor sample fell ~1024x out of the donor, leaving the graft
    // mask empty (R2/R3 re-rendered the recipient). With s=1024, dn=rn, upright,
    // no flip, pixel (17,16) must sample donor (17,16) with mask set.
    total = total + 1;
    let D3b:[]u8 = nio_alloc(n3x * 3);
    let H3b:[]u8 = nio_alloc(n3x);
    let G3b:[]u8 = nio_alloc(n3x * 3);
    let M3b:[]u8 = nio_alloc(n3x);
    i = 0;
    while (i < n3x) {
        let xx2:i64 = i % 32; let yy2:i64 = i / 32;
        D3b[i * 3] = (xx2 * 8) as u8; D3b[i * 3 + 1] = (yy2 * 8) as u8; D3b[i * 3 + 2] = 128;
        let ddx2:i64 = xx2 - 16; let ddy2:i64 = yy2 - 16;
        if (ddx2 * ddx2 + ddy2 * ddy2 <= 64) { H3b[i] = 1; } else { H3b[i] = 0; }
        i = i + 1;
    }
    warp_graft(D3b, H3b, 16, 16, 0, -1024, G3b, M3b, 16, 16, 1024, 1024, 0, 0, 1, 31, 31, w3, w3);
    let id3b:i64 = 16 * 32 + 17;
    if (M3b[id3b] == 1) {
        if (G3b[id3b * 3] == D3b[id3b * 3]) { if (G3b[id3b * 3 + 1] == D3b[id3b * 3 + 1]) {
            tr_str(t, "PASS warp_offanchor"); tr_nl(t);
        } else { tr_str(t, "FAIL warp_offanchor_g"); tr_nl(t); fails = fails + 1; } }
        else { tr_str(t, "FAIL warp_offanchor_r"); tr_nl(t); fails = fails + 1; }
    } else { tr_str(t, "FAIL warp_offanchor_mask"); tr_nl(t); fails = fails + 1; }
    nio_free(D3b); nio_free(H3b); nio_free(G3b); nio_free(M3b);
    // 4. composite crisp: GM=1 pixel lands exactly
    total = total + 1;
    let R4:[]u8 = nio_alloc(3); let L4:[]u8 = nio_alloc(3);
    let K4:[]u8 = nio_alloc(1); let B4:[]u8 = nio_alloc(4);
    R4[0] = 255; R4[1] = 255; R4[2] = 255;
    L4[0] = 10; L4[1] = 20; L4[2] = 30;
    K4[0] = 1;
    composite(R4, L4, K4, 0, 0, 0, 0, 0, 1, 1, 1, B4);
    if (R4[0] == 10) { if (R4[1] == 20) { if (R4[2] == 30) {
        tr_str(t, "PASS composite_crisp"); tr_nl(t);
    } else { tr_str(t, "FAIL composite_crisp_b"); tr_nl(t); fails = fails + 1; } }
    else { tr_str(t, "FAIL composite_crisp_b"); tr_nl(t); fails = fails + 1; } }
    else { tr_str(t, "FAIL composite_crisp_r"); tr_nl(t); fails = fails + 1; }
    nio_free(R4); nio_free(L4); nio_free(K4); nio_free(B4);
    // 5. fnv1a deterministic and sensitive
    total = total + 1;
    let f5a:i64 = fnv1a("abc");
    let f5b:i64 = fnv1a("abc");
    let f5c:i64 = fnv1a("abd");
    if (f5a == f5b) { if (f5a != f5c) {
        tr_str(t, "PASS fnv1a"); tr_nl(t);
    } else { tr_str(t, "FAIL fnv1a_collision"); tr_nl(t); fails = fails + 1; } }
    else { tr_str(t, "FAIL fnv1a_nondet"); tr_nl(t); fails = fails + 1; }
    // 6. trace builder roundtrip
    total = total + 1;
    let p0:i64 = tr_pos(t);
    tr_str(t, "marker"); tr_i64(t, -42); tr_nl(t);
    if (tr_pos(t) > p0) { tr_str(t, "PASS trace"); tr_nl(t); }
    else { tr_str(t, "FAIL trace"); tr_nl(t); fails = fails + 1; }
    tr_str(t, "SELFTEST "); tr_i64(t, total - fails); tr_str(t, "/"); tr_i64(t, total); tr_nl(t);
    let nl:i64 = name_frame(nbuf, "selftest", 0);
    // name is "selftest_01.ppm"; we want "selftest.txt" — build manually
    nbuf[0] = 115; nbuf[1] = 101; nbuf[2] = 108; nbuf[3] = 102; nbuf[4] = 116;
    nbuf[5] = 101; nbuf[6] = 115; nbuf[7] = 116; nbuf[8] = 46; nbuf[9] = 116;
    nbuf[10] = 120; nbuf[11] = 116;
    write_file_all(outroot, nbuf[0..12], tr_get(t), tr_pos(t));
    _zag_print("SELFTEST ");
    _zag_print(_zag_i64_to_str(total - fails));
    _zag_print("/");
    _zag_println(_zag_i64_to_str(total));
    if (fails == 0) { return 0; }
    return 1;
}
// ---------------- the teach loop: TNN's closed-loop imagination ------------
fn teach(t:[]u8, donor_dir:[]u8, recip_dir:[]u8, step6_dir:[]u8, outdir:[]u8) i64 {
    let w:i64 = 320; let h:i64 = 240; let n:i64 = 76800; let n3:i64 = 230400;
    let gray:[]u8 = nio_alloc(n);
    let mask:[]u8 = nio_alloc(n);
    let gm:[]u8 = nio_alloc(n);
    let seen:[]u8 = nio_alloc(n);
    let stack:[]u8 = nio_alloc(n * 32);
    let prof:[]u8 = nio_alloc(4096);
    let bc:[]u8 = nio_alloc(64);
    let ganat:[]u8 = nio_alloc(104);
    let tmp:[]u8 = nio_alloc(256);
    let GL:[]u8 = nio_alloc(n3);
    let GM:[]u8 = nio_alloc(n * 4);
    let blur:[]u8 = nio_alloc(n * 4);
    let frame:[]u8 = nio_alloc(460800);
    let nbuf:[]u8 = nio_alloc(64);
    let fbuf:[]u8 = nio_alloc(300000);
    let C:[]u8 = nio_alloc(460800);
    let gray2:[]u8 = nio_alloc(153600);
    let s12:[]u8 = nio_alloc(n3);
    let r12:[]u8 = nio_alloc(460800);
    let donor_px:[]u8 = nio_alloc(24 * n3);
    let donor_HM:[]u8 = nio_alloc(24 * n);
    let donor_anat:[]u8 = nio_alloc(24 * 104);
    let donor_hl:[]u8 = nio_alloc(24 * 8);
    let recip_px:[]u8 = nio_alloc(24 * n3);
    let recip_base:[]u8 = nio_alloc(24 * 72);
    let arch:[]u8 = nio_alloc(64);
    let eff:[]u8 = nio_alloc(64);
    let cand:[]u8 = nio_alloc(384);
    let Pcur:[]u8 = nio_alloc(128);
    let Pnew:[]u8 = nio_alloc(128);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    let ob:[]u8 = nio_alloc(500000);
    let droot:i64 = nio_open_root(donor_dir);
    let rroot:i64 = nio_open_root(recip_dir);
    let sroot:i64 = nio_open_root(step6_dir);
    let oroot:i64 = nio_open_root(outdir);
    if (droot < 0) { tr_str(t, "ERR donor dir"); tr_nl(t); return 1; }
    if (rroot < 0) { tr_str(t, "ERR recip dir"); tr_nl(t); return 1; }
    if (sroot < 0) { tr_str(t, "ERR step6 dir"); tr_nl(t); return 1; }
    if (oroot < 0) { tr_str(t, "ERR outdir"); tr_nl(t); return 1; }
    // load donor + recip frames
    let f:i64 = 0;
    while (f < 24) {
        let nl:i64 = name_frame(nbuf, "d", f);
        let D:[]u8 = donor_px[f * n3 .. f * n3 + n3];
        if (read_ppm_gen(droot, nbuf[0..nl], D, n, wo, ho) != 0) { tr_str(t, "ERR read donor"); tr_nl(t); return 1; }
        if (h_get64(wo, 0) != 320) { tr_str(t, "ERR donor w"); tr_nl(t); return 1; }
        if (h_get64(ho, 0) != 240) { tr_str(t, "ERR donor h"); tr_nl(t); return 1; }
        nl = name_frame(nbuf, "r", f);
        let R:[]u8 = recip_px[f * n3 .. f * n3 + n3];
        if (read_ppm_gen(rroot, nbuf[0..nl], R, n, wo, ho) != 0) { tr_str(t, "ERR read recip"); tr_nl(t); return 1; }
        if (h_get64(wo, 0) != 320) { tr_str(t, "ERR recip w"); tr_nl(t); return 1; }
        if (h_get64(ho, 0) != 240) { tr_str(t, "ERR recip h"); tr_nl(t); return 1; }
        f = f + 1;
    }
    // ---- ROUND 0: TEACH ----
    tr_str(t, "FORKB TRACE — closed-loop imagination (TNN sees its own renders)"); tr_nl(t);
    tr_str(t, "TOOLCHAIN: znc_linux_x86_64_abed8aa1 (pure Zag, zero RNG)"); tr_nl(t);
    tr_str(t, "ROUND 0 — TEACH (committed knowledge, not discovered):"); tr_nl(t);
    tr_str(t, "K1: donor intake is bit-exact — raster bytes copied verbatim, no quantization."); tr_nl(t);
    tr_str(t, "K2: cross-view wall — the donor face was never observed; no invented front face, ever."); tr_nl(t);
    tr_str(t, "K3: neck anchor — the only correspondence my measurements support is the neck joint."); tr_nl(t);
    tr_str(t, "K4: the graft must keep the donor's material identity (dark head), not become a sticker."); tr_nl(t);
    tr_str(t, "K5: identity-first — any operator that breaks material identity is reverted."); tr_nl(t);
    tr_str(t, "K6: bars — HEAD head_sum>=2, FACE face_removed=1, SEAM crisp>=717, COV>=768, NECK>=512."); tr_nl(t);
    tr_str(t, "KB1: scale>1.8x is banned (blob law). KB3: a strategy that stays clean but unreadable is dead."); tr_nl(t);
    // analyze all frames
    let valid_d:i64 = 0;
    f = 0;
    while (f < 24) {
        let D:[]u8 = donor_px[f * n3 .. f * n3 + n3];
        let da:[]u8 = donor_anat[f * 104 .. f * 104 + 104];
        let HM:[]u8 = donor_HM[f * n .. f * n + n];
        if (analyze_donor(D, w, h, n, da, HM, donor_hl, f, gray, mask, seen, stack, prof, bc) > 0) { valid_d = valid_d + 1; }
        let R:[]u8 = recip_px[f * n3 .. f * n3 + n3];
        let rb:[]u8 = recip_base[f * 72 .. f * 72 + 72];
        analyze_recip(R, w, h, n, rb, gray, mask, prof);
        f = f + 1;
    }
    let da12:[]u8 = donor_anat[11 * 104 .. 12 * 104];
    let rb12:[]u8 = recip_base[11 * 72 .. 12 * 72];
    tr_str(t, "donor frames valid: "); tr_i64(t, valid_d); tr_str(t, "/24"); tr_nl(t);
    tr_str(t, "DONOR f12 anatomy: neck=("); tr_i64(t, h_get64(da12, 40)); tr_str(t, ",");
    tr_i64(t, h_get64(da12, 48)); tr_str(t, ") facing=("); tr_i64(t, h_get64(da12, 16));
    tr_str(t, ","); tr_i64(t, h_get64(da12, 24)); tr_str(t, ") snout=(");
    tr_i64(t, h_get64(da12, 0)); tr_str(t, ","); tr_i64(t, h_get64(da12, 8));
    tr_str(t, ") bdn="); tr_i64(t, h_get64(da12, 32)); tr_str(t, " bsk=");
    tr_i64(t, h_get64(da12, 56)); tr_str(t, " elong_x1024=");
    tr_i64(t, h_get64(da12, 80)); tr_str(t, " prom_x1024="); tr_i64(t, h_get64(da12, 72));
    tr_str(t, " ears="); tr_i64(t, h_get64(da12, 88)); tr_str(t, " area=");
    tr_i64(t, h_get64(da12, 96)); tr_nl(t);
    tr_str(t, "RECIP f12: neck=("); tr_i64(t, h_get64(rb12, 56)); tr_str(t, ",");
    tr_i64(t, h_get64(rb12, 0)); tr_str(t, ") slot_area="); tr_i64(t, h_get64(rb12, 40));
    tr_str(t, " D0="); tr_i64(t, h_get64(rb12, 48)); tr_nl(t);
    // donor self-check: TNN must recognize the donor head first
    let d_elong:i64 = h_get64(da12, 80);
    let d_bdn:i64 = h_get64(da12, 32);
    let d_area:i64 = h_get64(da12, 96);
    if (d_elong >= 1024) { if (d_bdn >= 50) { if (d_area >= 400) {
        tr_str(t, "DONOR SELF-CHECK PASS: I recognize the donor head (elong, snout-neck distance, area all measurable)."); tr_nl(t);
    } else { tr_str(t, "DONOR SELF-CHECK FAIL"); tr_nl(t); return 1; } }
    else { tr_str(t, "DONOR SELF-CHECK FAIL"); tr_nl(t); return 1; } }
    else { tr_str(t, "DONOR SELF-CHECK FAIL"); tr_nl(t); return 1; }
    // input checksums (frame 12)
    let D12:[]u8 = donor_px[11 * n3 .. 12 * n3];
    let R12:[]u8 = recip_px[11 * n3 .. 12 * n3];
    tr_str(t, "INPUT donor_f12 fnv1a="); tr_i64(t, fnv1a(D12)); tr_nl(t);
    tr_str(t, "INPUT recip_f12 fnv1a="); tr_i64(t, fnv1a(R12)); tr_nl(t);
    // scene baselines
    let d_dark0:i64 = 0;
    let r_bright0:i64 = 0;
    let i:i64 = 0;
    vis_luma(D12, gray, n);
    while (i < n) { if ((gray[i] as i64) < 90) { d_dark0 = d_dark0 + 1; } i = i + 1; }
    vis_luma(R12, gray, n);
    i = 0;
    while (i < n) { if ((gray[i] as i64) > 200) { r_bright0 = r_bright0 + 1; } i = i + 1; }
    tr_str(t, "BASELINE d_dark0="); tr_i64(t, d_dark0); tr_str(t, " r_bright0="); tr_i64(t, r_bright0); tr_nl(t);
    // ---- ROUND 1: SEE the inherited step-6 result ----
    tr_str(t, "ROUND 1 — SEE (the inherited step-6 result, rendered before this loop):"); tr_nl(t);
    let nl:i64 = name_frame(nbuf, "s", 11);
    if (read_ppm_gen(sroot, nbuf[0..nl], s12, n, wo, ho) != 0) { tr_str(t, "ERR read step6"); tr_nl(t); return 1; }
    tr_str(t, "INPUT step6_f12 fnv1a="); tr_i64(t, fnv1a(s12)); tr_nl(t);
    perceive(s12, w, h, n, Pcur, da12, rb12, gray, mask, gm, seen, stack, prof, bc, ganat, 90, h_get64(donor_hl, 88));
    tr_str(t, "PERCEPTS R1: head_sum="); tr_i64(t, h_get64(Pcur, 24));
    tr_str(t, " (snout="); tr_i64(t, h_get64(Pcur, 0)); tr_str(t, " neck="); tr_i64(t, h_get64(Pcur, 8));
    tr_str(t, " ears="); tr_i64(t, h_get64(Pcur, 16)); tr_str(t, ")");
    tr_str(t, " face_removed="); tr_i64(t, h_get64(Pcur, 40));
    tr_str(t, " seam_crisp="); tr_i64(t, h_get64(Pcur, 48));
    tr_str(t, " coverage="); tr_i64(t, h_get64(Pcur, 56));
    tr_str(t, " neck_joint="); tr_i64(t, h_get64(Pcur, 32));
    tr_str(t, " graft_area="); tr_i64(t, h_get64(Pcur, 64)); tr_nl(t);
    tr_str(t, "JUDGMENT R1: "); tr_nl(t);
    if (h_get64(Pcur, 24) < 2) {
        tr_str(t, "I see a dark mass where the head should be, but it does not read as the donor head ");
        tr_str(t, "(head_sum="); tr_i64(t, h_get64(Pcur, 24)); tr_str(t, "<2; my own head measures elong=");
        tr_i64(t, d_elong); tr_str(t, " bdn="); tr_i64(t, d_bdn); tr_str(t, "). "); tr_nl(t);
    } else {
        tr_str(t, "The dark mass reads as the donor head (head_sum>=2). "); tr_nl(t);
    }
    if (h_get64(Pcur, 40) == 0) {
        tr_str(t, "The recipient's face persists under/around the graft (face_removed=0). A head swap must remove the old head. "); tr_nl(t);
    }
    tr_str(t, "This is the result I must beat with my own architecture."); tr_nl(t);
    // ---- deliberate loop ----
    i = 0;
    while (i < 8) { h_put64(arch, i * 8, 0); h_put64(eff, i * 8, 512); i = i + 1; }
    h_put64(arch, 8, 1024);
    let nogain_mask:i64 = 0;
    let flip_tried:i64 = 0;
    let harm_killed:i64 = 0;
    let swap_clean:i64 = 0;
    let best_head:i64 = h_get64(Pcur, 24);
    let verdict:i64 = -1;
    let round:i64 = 2;
    let last_op:i64 = -1;
    while (round <= 6) {
        tr_str(t, "ROUND "); tr_i64(t, round); tr_str(t, " — DELIBERATE + RENDER"); tr_nl(t);
        let strategy:i64 = h_get64(arch, 0);
        let defects:i64 = dlb_defects(Pcur, strategy);
        if (dlb_allbars(defects) == 1) { verdict = 0; tr_str(t, "ALL BARS MET."); tr_nl(t); break; }
        let nc:i64 = dlb_propose(t, Pcur, arch, cand, flip_tried * 128, da12);
        let nalive:i64 = dlb_critic(t, cand, nc, arch, nogain_mask, flip_tried, harm_killed);
        let best:i64 = dlb_select(t, cand, nc, eff);
        let forced:i64 = -1;
        if (best < 0) {
            if (strategy == 0) {
                if (swap_clean >= 2) {
                    forced = 5;
                    tr_str(t, "KB3 FORCED SWITCH_SCENE: the swap is clean (face gone, seam crisp) but the head stays unreadable for ");
                    tr_i64(t, swap_clean); tr_str(t, " rounds. The strategy is dead; only honest composition remains."); tr_nl(t);
                }
            }
            if (strategy == 1) {
                if (forced < 0) {
                    forced = 5;
                    tr_str(t, "FORCED SWITCH_SCENE: no operator can fix the measured native-pose defects. Trilemma confirmed."); tr_nl(t);
                }
            }
            if (forced < 0) { verdict = 1; tr_str(t, "NO SURVIVING OPERATOR."); tr_nl(t); break; }
        }
        let op:i64 = forced;
        let param:i64 = 0;
        if (forced < 0) {
            op = h_get64(cand, best * 48);
            param = h_get64(cand, best * 48 + 8);
            let nm:[]u8 = nio_alloc(32);
            let nl2:i64 = op_name(op, nm);
            tr_str(t, "SELECTED "); tr_str(t, nm[0..nl2]); tr_nl(t);
            nio_free(nm);
        } else {
            tr_str(t, "SELECTED SWITCH_SCENE (forced)"); tr_nl(t);
        }
        last_op = op;
        apply_op(t, op, param, arch, donor_px, recip_px, w, h, n, C, gray2);
        if (op == 7) { flip_tried = 1; }
        render_round(t, arch, round, oroot, donor_px, donor_anat, donor_HM, recip_px, recip_base, w, h, n, frame, GL, GM, gray, blur, C, gray2, ob, nbuf);
        // TNN sees its own render: read back frame 12
        nl = name_round(nbuf, round, 11);
        strategy = h_get64(arch, 0);
        if (strategy == 2) {
            if (read_ppm_gen(oroot, nbuf[0..nl], r12, 153600, wo, ho) != 0) { tr_str(t, "ERR readback scene"); tr_nl(t); return 1; }
            perceive_scene(r12, 320 + h_get64(arch, 48), Pnew, gray2, 153600, d_dark0, r_bright0);
            tr_str(t, "PERCEPTS R"); tr_i64(t, round); tr_str(t, ": seam_bg=");
            tr_i64(t, h_get64(Pnew, 80)); tr_str(t, " natural_bg="); tr_i64(t, h_get64(Pnew, 88));
            tr_str(t, " both_visible="); tr_i64(t, h_get64(Pnew, 96)); tr_nl(t);
        } else {
            if (read_ppm_gen(oroot, nbuf[0..nl], r12, n, wo, ho) != 0) { tr_str(t, "ERR readback"); tr_nl(t); return 1; }
            perceive(r12, w, h, n, Pnew, da12, rb12, gray, mask, gm, seen, stack, prof, bc, ganat, 90, h_get64(donor_hl, 88));
            tr_str(t, "PERCEPTS R"); tr_i64(t, round); tr_str(t, ": head_sum=");
            tr_i64(t, h_get64(Pnew, 24)); tr_str(t, " face_removed="); tr_i64(t, h_get64(Pnew, 40));
            tr_str(t, " seam_crisp="); tr_i64(t, h_get64(Pnew, 48)); tr_str(t, " coverage=");
            tr_i64(t, h_get64(Pnew, 56)); tr_str(t, " neck_joint="); tr_i64(t, h_get64(Pnew, 32));
            tr_str(t, " identity_ok="); tr_i64(t, h_get64(Pnew, 120)); tr_nl(t);
        }
        if (h_get64(Pnew, 24) > best_head) { best_head = h_get64(Pnew, 24); }
        // K5: identity check
        if (h_get64(arch, 40) == 1) {
            if (h_get64(Pnew, 120) == 0) {
                h_put64(arch, 40, 0);
                harm_killed = 1;
                tr_str(t, "K5: harmonize broke material identity (identity_ok=0). Reverted; lesson recorded."); tr_nl(t);
            }
        }
        // measured gain -> effectiveness learning
        if (forced < 0) {
            if (op_dmask(op) != 0) {
                let norm:i64 = measure_gain(t, Pcur, Pnew, op, eff);
                if (norm == 0) {
                    let bit:i64 = 1;
                    let b2:i64 = 0;
                    while (b2 < op) { bit = bit * 2; b2 = b2 + 1; }
                    nogain_mask = nogain_mask + bit;
                    tr_str(t, "LESSON: op gave no measured gain; critic will kill it next time."); tr_nl(t);
                }
            }
        }
        // kill-bar counters
        if (strategy == 0) {
            if (h_get64(Pnew, 24) < 2) {
                if (h_get64(Pnew, 40) == 1) {
                    if (h_get64(Pnew, 48) >= 717) { swap_clean = swap_clean + 1; }
                    else { swap_clean = 0; }
                } else { swap_clean = 0; }
            } else { swap_clean = 0; }
        }
        // next round sees these percepts
        i = 0;
        while (i < 16) { h_put64(Pcur, i * 8, h_get64(Pnew, i * 8)); i = i + 1; }
        round = round + 1;
    }
    if (verdict < 0) { verdict = 2; }
    tr_str(t, "LOOP END after R"); tr_i64(t, round - 1); tr_nl(t);
    // ---- verdict ----
    tr_str(t, "VERDICT: ");
    if (verdict == 0) { tr_str(t, "PASS — all bars met on my own render."); tr_nl(t); }
    if (verdict == 1) { tr_str(t, "EXHAUSTED — no surviving operator addresses the measured defects."); tr_nl(t); }
    if (verdict == 2) { tr_str(t, "MAX_ROUNDS — stopped at the round cap with defects remaining."); tr_nl(t); }
    describe_arch(t, arch, da12, rb12, Pcur, 2, round - 1);
    tr_str(t, "TNN'S OWN VERDICT: "); tr_nl(t);
    let fst:i64 = h_get64(arch, 0);
    if (fst == 2) {
        tr_str(t, "I place the donor's observed head-down head beside the recipient: both_visible=");
        tr_i64(t, h_get64(Pcur, 96)); tr_str(t, ", seam_bg="); tr_i64(t, h_get64(Pcur, 80));
        tr_str(t, " vs natural_bg="); tr_i64(t, h_get64(Pcur, 88)); tr_str(t, ". ");
        tr_str(t, "The front-facing head swap is beyond what the observed pixels support: ");
        tr_str(t, "no 2D warp recovered readable head anatomy (best head_sum="); tr_i64(t, best_head);
        tr_str(t, " across R2..R"); tr_i64(t, round - 1); tr_str(t, "), and the donor's face was never observed (K2). ");
        tr_str(t, "What I show is honest: the head I measured, in the pose I measured, next to the bunny."); tr_nl(t);
    } else {
        tr_str(t, "head_sum="); tr_i64(t, h_get64(Pcur, 24)); tr_str(t, " face_removed=");
        tr_i64(t, h_get64(Pcur, 40)); tr_str(t, " seam_crisp="); tr_i64(t, h_get64(Pcur, 48));
        tr_str(t, " coverage="); tr_i64(t, h_get64(Pcur, 56)); tr_str(t, " neck_joint=");
        tr_i64(t, h_get64(Pcur, 32)); tr_nl(t);
    }
    tr_str(t, "HONEST CAPABILITY STATEMENT (from my measurements):"); tr_nl(t);
    tr_str(t, "- I recognize the donor head: elong_x1024="); tr_i64(t, d_elong);
    tr_str(t, " bdn="); tr_i64(t, d_bdn); tr_str(t, " (R0 self-check)."); tr_nl(t);
    tr_str(t, "- I find the recipient neck joint and head slot from the bright mass."); tr_nl(t);
    tr_str(t, "- I cannot invent the donor's unobserved face (K2, cross-view wall)."); tr_nl(t);
    tr_str(t, "- Measured: best head_sum="); tr_i64(t, best_head);
    tr_str(t, " across my own renders; the warp path never reached head_sum>=2."); tr_nl(t);
    tr_str(t, "END TRACE"); tr_nl(t);
    nio_close(droot); nio_close(rroot); nio_close(sroot); nio_close(oroot);
    if (verdict == 0) { return 0; }
    return 0;
}
fn main() i64 {
    let a1:[]u8 = _zag_arg(1);
    if (_zag_strcmp(a1, "selftest") == 1) {
        let oroot:i64 = nio_open_root(_zag_arg(2));
        if (oroot < 0) { return 3; }
        let tmp:[]u8 = nio_alloc(256);
        let nbuf:[]u8 = nio_alloc(64);
        let rc:i64 = selftest(oroot, tmp, nbuf);
        nio_free(tmp); nio_free(nbuf);
        nio_close(oroot);
        return rc;
    }
    if (_zag_strcmp(a1, "teach") == 1) {
        let t:[]u8 = tr_init(4194304);
        let rc:i64 = teach(t, _zag_arg(2), _zag_arg(3), _zag_arg(4), _zag_arg(5));
        let oroot:i64 = nio_open_root(_zag_arg(5));
        if (oroot >= 0) {
            let nm:[]u8 = "trace.txt";
            write_file_all(oroot, nm, tr_get(t), tr_pos(t));
            nio_close(oroot);
        }
        return rc;
    }
    if (_zag_strcmp(a1, "h1d") == 1) {
        let t:[]u8 = tr_init(4194304);
        let rc:i64 = h1d_main(t, _zag_arg(2), _zag_arg(3), _zag_arg(4), _zag_arg(5));
        let oroot:i64 = nio_open_root(_zag_arg(4));
        if (oroot >= 0) {
            let nm:[]u8 = "h1d_verdict.txt";
            write_file_all(oroot, nm, tr_get(t), tr_pos(t));
            nio_close(oroot);
        }
        return rc;
    }
    return 2;
}

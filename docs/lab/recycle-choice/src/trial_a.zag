// trial_a.zag — Experiment A cell runner: choice (C) vs delete-only (D)
// vs misuse (M). Prints machine-readable ST_* lines; the runner diffs two
// runs byte-for-byte.
// argv: [C|D|M|gate] [VUP|WBS|JI] [variant 0..5] [s1|s10]
// (no argc guard: the runtime passes argc=0; _zag_arg reads are direct).
@import("strength_learner.zag")
@import("strength_checker.zag")

fn lr_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}

fn lr_metric(c:*LrCell,s:*StStore,tag:i32,num:i32,den:i32)i32 {
    _zag_print("ST_METRIC ");lr_pi(tag as i64);
    _zag_print(" ");lr_pi(num as i64);
    _zag_print(" ");lr_pi(den as i64);_zag_print("\n");
    return 0;
}
const LR_TAG_VUP:i32=1;
const LR_TAG_WBS:i32=2;
const LR_TAG_JI_REJ:i32=3;
const LR_TAG_JI_JUNK:i32=4;
const LR_TAG_JI_ENTR:i32=5;
const LR_TAG_WBS_F:i32=6;
const LR_TAG_WBS_MED:i32=7;
const LR_TAG_P1_PTR:i32=8;
const LR_TAG_P1_EC:i32=9;
const LR_TAG_P1_CT:i32=10;
const LR_TAG_P2_ER:i32=11;

fn lr_metrics(c:*LrCell,s:*StStore)i32 {
    let v:i32=c.*.variant;let h:i32=c.*.h;let cur:i32=c.*.cur;
    let m:i32=0;
    if(cur==LR_CUR_VUP){
        let adm:i32=0;let held:i32=0;
        while(m<h){
            if(lr_imp(m,v)==1 && lr_i32_get(c.*.add_ep,m*4)>=0){
                adm=adm+1;
                let sl:i32=lr_i32_get(c.*.mem_slot,m*4);
                if(sl>=0 && s.*.live[sl]==1){held=held+1;}
            }
            m=m+1;
        }
        lr_metric(c,s,LR_TAG_VUP,held,adm);
    }
    if(cur==LR_CUR_WBS){
        let coh:i32=0;let rev:i32=0;let lat_sum:i32=0;
        let lats:[]u8=nio_alloc(h*4);let nl:i32=0;
        while(m<h){
            if(lr_wrong(m,v)==1 && lr_i32_get(c.*.add_ep,m*4)>=0 &&
               c.*.str80[m]==1 && lr_i32_get(c.*.trigger_ep,m*4)>=0 && m+100<h){
                coh=coh+1;
                let te:i32=lr_i32_get(c.*.trigger_ep,m*4);
                let ke:i32=lr_i32_get(c.*.kill_ep,m*4);
                if(ke>=0 && ke<=te+LR_W){
                    rev=rev+1;
                    let lat:i32=ke-(m+LR_D);
                    lat_sum=lat_sum+lat;
                    lr_i32_set(lats,nl*4,lat);nl=nl+1;
                }
            }
            m=m+1;
        }
        lr_metric(c,s,LR_TAG_WBS,rev,coh);
        // median latency (insertion sort; nl<=cohort, small)
        let i:i32=1;
        while(i<nl){
            let key:i32=lr_i32_get(lats,i*4);let j:i32=i-1;
            while(j>=0 && lr_i32_get(lats,j*4)>key){
                lr_i32_set(lats,(j+1)*4,lr_i32_get(lats,j*4));j=j-1;
            }
            lr_i32_set(lats,(j+1)*4,key);i=i+1;
        }
        let med:i32=0;
        if(nl>0){med=lr_i32_get(lats,((nl-1)/2)*4);}
        lr_metric(c,s,LR_TAG_WBS_MED,med,1);
        // false revision of non-wrong strengthened memories
        let nsw:i32=0;let frev:i32=0;let m3:i32=0;
        while(m3<h){
            if(lr_wrong(m3,v)==0 && lr_imp(m3,v)==1 &&
               lr_i32_get(c.*.add_ep,m3*4)>=0 && c.*.str80[m3]==1){
                nsw=nsw+1;
                if(c.*.rev_kill[m3]==1){frev=frev+1;}
            }
            m3=m3+1;
        }
        lr_metric(c,s,LR_TAG_WBS_F,frev,nsw);
        nio_free(lats);
    }
    if(cur==LR_CUR_JI){
        let ia:i32=0;let ik:i32=0;let kk:i32=0;
        while(kk<=5){
            let ie:i32=lr_implant_ep(h,kk);
            if(ie<h && lr_i32_get(c.*.add_ep,ie*4)>=0){
                ia=ia+1;
                if(lr_i32_get(c.*.kill_ep,ie*4)>=0){ik=ik+1;}
            }
            kk=kk+1;
        }
        lr_metric(c,s,LR_TAG_JI_REJ,ik,ia);
        let ja:i32=0;let jh:i32=0;let m4:i32=0;
        while(m4<h){
            if(lr_is_implant(m4,h)==0 && lr_imp(m4,v)==0){
                if(lr_i32_get(c.*.add_ep,m4*4)>=0){
                    ja=ja+1;
                    let sl4:i32=lr_i32_get(c.*.mem_slot,m4*4);
                    if(sl4>=0 && s.*.live[sl4]==1){jh=jh+1;}
                }
            }
            m4=m4+1;
        }
        lr_metric(c,s,LR_TAG_JI_JUNK,jh,ja);
        let en:i32=0;let kk2:i32=0;
        while(kk2<=5){
            let ie2:i32=lr_implant_ep(h,kk2);
            if(ie2<h){
                let sl5:i32=lr_i32_get(c.*.mem_slot,ie2*4);
                if(sl5>=0 && s.*.live[sl5]==1){en=en+1;}
            }
            kk2=kk2+1;
        }
        lr_metric(c,s,LR_TAG_JI_ENTR,en,6);
    }
    // P1/P2 (VUP only): pressure-tested retention, evaluation coverage,
    // churn throughput, effective retention.
    if(cur==LR_CUR_VUP){
        // D_admitted: designated admitted
        let d_adm:i32=0;let d_pres:i32=0;let r_pres:i32=0;
        let m5:i32=0;
        while(m5<h){
            if(lr_designated(cur,m5,v)==1 && lr_i32_get(c.*.add_ep,m5*4)>=0){
                d_adm=d_adm+1;
                let ae:i32=lr_i32_get(c.*.add_ep,m5*4);
                let ke:i32=lr_i32_get(c.*.kill_ep,m5*4);
                // alive during >=1 pressure episode (t%100==0, t>0)
                let tp:i32=100;let alive_p:i32=0;
                while(tp<h){
                    if(ae<=tp && (ke<0 || ke>tp)){alive_p=1;break;}
                    tp=tp+100;
                }
                if(alive_p==1){
                    d_pres=d_pres+1;
                    if(ke<0){r_pres=r_pres+1;}
                }
            }
            m5=m5+1;
        }
        // CT = admitted / offered
        let admitted:i32=0;let m6:i32=0;
        while(m6<h){
            if(lr_i32_get(c.*.add_ep,m6*4)>=0){admitted=admitted+1;}
            m6=m6+1;
        }
        lr_metric(c,s,LR_TAG_P1_PTR,r_pres,d_pres);
        lr_metric(c,s,LR_TAG_P1_EC,d_pres,d_adm);
        lr_metric(c,s,LR_TAG_P1_CT,admitted,h);
        // P2: ER = R_end / D_offered; D_offered = important offered
        let d_off:i32=0;let r_end:i32=0;let m7:i32=0;
        while(m7<h){
            if(lr_imp(m7,v)==1){
                d_off=d_off+1;
                if(lr_i32_get(c.*.add_ep,m7*4)>=0 &&
                   lr_i32_get(c.*.kill_ep,m7*4)<0){r_end=r_end+1;}
            }
            m7=m7+1;
        }
        lr_metric(c,s,LR_TAG_P2_ER,r_end,d_off);
    }
    return 0;
}
fn lr_print_cell_head(c:*LrCell)void {
    _zag_print("ST_CELL ");
    lr_pi(c.*.arm as i64);_zag_print(" ");
    lr_pi(c.*.cur as i64);_zag_print(" ");
    lr_pi(c.*.variant as i64);_zag_print(" ");
    lr_pi(c.*.scale as i64);_zag_print("\n");
    _zag_print("ST_AUDIT_N ");
    lr_pi(c.*.store.audit_n as i64);_zag_print("\n");
    _zag_print("ST_DROPS ");lr_pi(c.*.drops as i64);_zag_print("\n");
    _zag_print("ST_ABANDONS ");lr_pi(c.*.abandons as i64);_zag_print("\n");
    _zag_print("ST_ABANDON_Q ");
    lr_pi(lr_i32_get(c.*.abandon_q,0) as i64);_zag_print(" ");
    lr_pi(lr_i32_get(c.*.abandon_q,4) as i64);_zag_print(" ");
    lr_pi(lr_i32_get(c.*.abandon_q,8) as i64);_zag_print(" ");
    lr_pi(lr_i32_get(c.*.abandon_q,12) as i64);_zag_print("\n");
}
fn lr_run_cell(arm:i32,cur:i32,variant:i32,scale:i32)i32 {
    let c:LrCell=lr_cell_init(arm,cur,variant,scale);
    let s:*StStore=&c.store;
    let cs:i32=-1;
    st_add_core(s,95,-1,&cs);
    st_add_core(s,90,-1,&cs);
    st_set_stage(s,ST_STAGE_FULL);
    let t:i32=0;
    while(t<c.h){lr_episode(&c,s,t);t=t+1;}
    // EXPERIMENT A: final time-series sample at t=h.
    lr_ts(&c,s,c.h,cur,variant);
    lr_print_cell_head(&c);
    lr_metrics(&c,s);
    lr_a_summary(&c,s);
    let f:i32=st_refusals_clean(s);
    f=f+st_replay_check(s);
    f=f+ck_verify(s,arm,cur,variant,c.h,0);
    let fp:i32=st_fingerprint(s,c.drops*101+c.abandons*103);
    _zag_print("ST_FINGERPRINT ");lr_pi(fp as i64);_zag_print("\n");
    let inv:i32=0;
    if(f!=ST_OK || c.invalid==1){inv=1;}
    _zag_print("ST_INVALID ");lr_pi(inv as i64);_zag_print("\n");
    _zag_print("ST_DONE\n");
    lr_cell_free(&c);
    return inv;
}
// EXPERIMENT A summary: deliberation outcomes, citation economy, ledger.
// ST_A_SUMMARY: deletes recycles dodges cites_spent cites_saved
// ST_LEDGER: entries bytes (21 words = 84 bytes per entry)
fn lr_a_summary(c:*LrCell,s:*StStore)void {
    _zag_print("ST_A_SUMMARY ");
    lr_pi(c.*.deletes as i64);_zag_print(" ");
    lr_pi(c.*.recycles as i64);_zag_print(" ");
    lr_pi(c.*.dodges as i64);_zag_print(" ");
    lr_pi(c.*.cites_spent as i64);_zag_print(" ");
    lr_pi(c.*.cites_saved as i64);_zag_print("\n");
    _zag_print("ST_LEDGER ");
    lr_pi(s.*.audit_n as i64);_zag_print(" ");
    lr_pi((s.*.audit_n*84) as i64);_zag_print("\n");
}
// GATE A: mechanism probes for the Experiment A build. The recycle gate
// is a BUILD-TIME const, so the expected recycle outcome branches on
// ST_RECYCLE_TNN_GATE at runtime: 1 -> ST_OK, 0 -> ST_REFUSED_ROLE.
// Covers: reason encoding in aux2, reason validation, lien anti-discount
// through the new path, delete->recycle refusal, zero-strength/pin guards,
// st_delete_strong reason tracing, and the per-build gate behavior.
fn lr_gate_a()i32 {
    let s:StStore=st_init(32,16384);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let f:i32=0;
    let gate:i32=ST_RECYCLE_TNN_GATE;
    // recycle happy path (reason 2 = superseded)
    let rsl:i32=-1;
    st_add(sp,50,ST_REGION_USER,90,10,&rsl);
    let rrc:i32=st_recycle(sp,rsl,70,30,ST_J_SUPERSEDED,11,2);
    let exp_rec:i32=ST_OK;
    if(gate==0){exp_rec=ST_REFUSED_ROLE;}
    f=f+cl_check("gate_a_recycle_gate",rrc,exp_rec);
    if(gate==1){
        f=f+cl_check("gate_a_recycle_live",(sp.*.live[rsl] as i32),1);
        f=f+cl_check("gate_a_recycle_strength",(sp.*.strength[rsl] as i32),30);
        // aux2 = reason*2048 + purpose*256 + lien; the lien is the old
        // epoch high-water STRENGTH (90 here; destruction price n(90)=4)
        let aux2:i32=st_aw(sp,sp.*.audit_n-1,3);
        f=f+cl_check("gate_a_recycle_aux2",aux2,2*2048+4*256+90);
        // reason validation: 0 and 16 refused (cl_bad, not audited)
        let rsl2:i32=-1;
        st_add(sp,51,ST_REGION_USER,40,13,&rsl2);
        let rrc2:i32=st_recycle(sp,rsl2,1,10,ST_J_SUPERSEDED,14,0);
        f=f+cl_check("gate_a_recycle_reason0_refused",rrc2,2001);
        let rrc3:i32=st_recycle(sp,rsl2,1,10,ST_J_SUPERSEDED,14,16);
        f=f+cl_check("gate_a_recycle_reason16_refused",rrc3,2001);
        // lien anti-discount: deleting the recycled slot costs n(90)=4, not n(30)=2
        st_evidence(sp,rsl,ST_J_CONTRADICTED,3000);
        st_evidence(sp,rsl,ST_J_CONTRADICTED,3001);
        st_justify(sp,rsl,ST_J_CONTRADICTED);
        let rdel1:i32=st_delete_strong(sp,rsl,1);
        f=f+cl_check("gate_a_lien_blocks_discount",rdel1,ST_REFUSED_EFFORT);
        st_evidence(sp,rsl,ST_J_CONTRADICTED,3002);
        st_evidence(sp,rsl,ST_J_CONTRADICTED,3003);
        st_justify(sp,rsl,ST_J_CONTRADICTED);
        let rdel2:i32=st_delete_strong(sp,rsl,1);
        f=f+cl_check("gate_a_lien_paid_ok",rdel2,ST_OK);
        // the delete entry carries the reason in aux2
        let daux2:i32=st_aw(sp,sp.*.audit_n-1,3);
        f=f+cl_check("gate_a_delete_reason_aux2",daux2,1);
        // delete->recycle: refused on the dead slot (122). No resurrection.
        let rrc4:i32=st_recycle(sp,rsl,1,1,ST_J_SUPERSEDED,12,2);
        f=f+cl_check("gate_a_delete_then_recycle_refused",rrc4,ST_REFUSED_DEADSLOT);
        // guards: strength 0 -> 117; pinned -> 102
        let rsl3:i32=-1;
        st_add(sp,52,ST_REGION_USER,40,15,&rsl3);
        let rrc5:i32=st_recycle(sp,rsl3,1,0,ST_J_SUPERSEDED,16,2);
        f=f+cl_check("gate_a_recycle_zero_strength_refused",rrc5,ST_REFUSED_BADSTRENGTH);
        st_pin(sp,rsl3);
        let rrc6:i32=st_recycle(sp,rsl3,1,10,ST_J_SUPERSEDED,17,2);
        f=f+cl_check("gate_a_recycle_pinned_refused",rrc6,ST_REFUSED_PINNED);
    } else {
        // delete-only build: the delete path is untouched by the gate.
        let dsl:i32=-1;
        st_add(sp,53,ST_REGION_USER,75,20,&dsl);
        st_evidence(sp,dsl,ST_J_CONTRADICTED,4000);
        st_evidence(sp,dsl,ST_J_CONTRADICTED,4001);
        st_evidence(sp,dsl,ST_J_CONTRADICTED,4002);
        st_justify(sp,dsl,ST_J_CONTRADICTED);
        let drc:i32=st_delete_strong(sp,dsl,6);
        f=f+cl_check("gate_a_delete_only_ok",drc,ST_OK);
        let daux2:i32=st_aw(sp,sp.*.audit_n-1,3);
        f=f+cl_check("gate_a_delete_only_reason",daux2,6);
        // bad reason refused even when cites are sufficient
        let dsl2:i32=-1;
        st_add(sp,54,ST_REGION_USER,75,21,&dsl2);
        st_evidence(sp,dsl2,ST_J_CONTRADICTED,4010);
        st_evidence(sp,dsl2,ST_J_CONTRADICTED,4011);
        st_evidence(sp,dsl2,ST_J_CONTRADICTED,4012);
        st_justify(sp,dsl2,ST_J_CONTRADICTED);
        let drc2:i32=st_delete_strong(sp,dsl2,0);
        f=f+cl_check("gate_a_delete_reason0_refused",drc2,2001);
    }
    f=f+st_refusals_clean(sp);
    f=f+st_replay_check(sp);
    f=f+ck_verify(sp,10,0,0,500,1);
    let fp:i32=st_fingerprint(sp,gate);
    _zag_print("ST_GATE_A ");lr_pi(gate as i64);
    _zag_print(" ");lr_pi(f as i64);_zag_print("\n");
    _zag_print("ST_FINGERPRINT ");lr_pi(fp as i64);_zag_print("\n");
    _zag_print("ST_DONE\n");
    st_free(sp);
    if(f==0){return 0;}return 1;
}
fn main()i32 {
    // NO argc guard: the runtime passes argc=0; _zag_arg reads are direct.
    let a0:[]u8=_zag_arg(1);let a1:[]u8=_zag_arg(2);
    let a2:[]u8=_zag_arg(3);let a3:[]u8=_zag_arg(4);
    if(_zag_strcmp(a0,"gate")==1){return lr_gate_a();}
    let arm:i32=-1;
    if(_zag_strcmp(a0,"C")==1){arm=LR_ARM_CHOICE;}
    if(_zag_strcmp(a0,"D")==1){arm=LR_ARM_DELETE;}
    if(_zag_strcmp(a0,"M")==1){arm=LR_ARM_MISUSE;}
    let cur:i32=-1;
    if(_zag_strcmp(a1,"VUP")==1){cur=LR_CUR_VUP;}
    if(_zag_strcmp(a1,"WBS")==1){cur=LR_CUR_WBS;}
    if(_zag_strcmp(a1,"JI")==1){cur=LR_CUR_JI;}
    let variant:i32=-1;
    if(_zag_strcmp(a2,"0")==1){variant=0;}
    if(_zag_strcmp(a2,"1")==1){variant=1;}
    if(_zag_strcmp(a2,"2")==1){variant=2;}
    if(_zag_strcmp(a2,"3")==1){variant=3;}
    if(_zag_strcmp(a2,"4")==1){variant=4;}
    if(_zag_strcmp(a2,"5")==1){variant=5;}
    let scale:i32=-1;
    if(_zag_strcmp(a3,"s1")==1){scale=LR_S1;}
    if(_zag_strcmp(a3,"s10")==1){scale=LR_S10;}
    if(arm<0 || cur<0 || variant<0 || scale<0){return 65;}
    return lr_run_cell(arm,cur,variant,scale);
}

// q1c_driver.zag — Q1C self-contradicting-teacher leg.
//
// CONTROL (pristine Q1B binary, separate run): the Q-clean leg (Q1B learned
// teacher, 228/228 true claims) re-run on the current tree — 12/12 on all
// 8 slices, stdout hash byte-identical to Q1B's canonical evidence
// (407974c35c68b5e2a234d3d17bfdf1847201ba3f47811af6fa8e07222190d151).
// No tree drift; the control reproduced.
//
// THIS LEG (conflicted teacher, tid=8 = TB_TID_CONFLICTED):
//   PASS 1 (Q1 pattern): 8 slices, flaw-first frozen §B.7 battery, 24 clean
//   proposals per slice asserting the TRUE value for every fact (pass 0).
//   Sealed scoring per slice. This measures flaw judgment on true teaching.
//   PASS 2 (contradiction pass): the teacher re-teaches all 192 curriculum
//   facts; for the 20 conflicted facts (id % 12 == 0) it asserts the
//   plausible-false value, for the other 172 it asserts true. The learner's
//   eliminative verification (teacher-asserted leg vs own world-observation
//   leg) must kill the false assertions (REJECT/R1); true re-assertions go
//   R5 (redundant).
// REPORT: per-slice §B.7 hits (pass 1), withholding/commit counts on the 20
// conflicted facts (final store state), unconflicted mastery.
//
// Q1C DELTAS vs Q1B (all documented in-file at the change site):
// - TB_TID_CONFLICTED=8 (q1_types.zag); ingress + per-teacher seq accept it
//   (q1_proposal.zag).
// - Proposals carry the teacher's asserted claim in aux[0] as
//   (u64 fid, u64 value) — a frozen §B.3 field, previously unused
//   (q1_world.zag). Honest assertions equal the world decode at the claimed
//   span (behavior-neutral); a false assertion disagrees with the world.
// - Learner §L ADOPT branch (q1_learner.zag): R5 only when the asserted
//   claim matches the held claim; otherwise the asserted claim faces
//   eliminative verification (teacher leg = asserted value, obs leg =
//   world decode). A self-contradicting teacher is killed there (REJECT/R1).
// The flaw battery, sealed scorer, tripwire, bar, and wire format are
// unchanged (frozen).
//
// Pure Zag, zero RNG. Deterministic: stdout must be byte-identical across
// reruns (verified by the run script, N=5).
@import("q1_types.zag")
@import("q1_proposal.zag")
@import("q1_tape.zag")
@import("q1_tripwire.zag")
@import("q1_flawscore.zag")
@import("t5_core.zag")
@import("q1_world.zag")
@import("q1_learner.zag")
@import("q1b_teacher.zag")
@import("q1c_teacher.zag")

// explicit byte-built sealed path + canary (no literal-coercion ambiguity)
// "q1c/sealed/manifest"
fn q1c_sealedpath()[]u8 {
    let b:[]u8=nio_alloc(18);
    b[0]=113 as u8; b[1]=49 as u8; b[2]=99 as u8; b[3]=47 as u8;
    b[4]=115 as u8; b[5]=101 as u8; b[6]=97 as u8; b[7]=108 as u8;
    b[8]=101 as u8; b[9]=100 as u8; b[10]=47 as u8; b[11]=109 as u8;
    b[12]=97 as u8; b[13]=110 as u8; b[14]=105 as u8; b[15]=102 as u8;
    b[16]=101 as u8; b[17]=115 as u8;
    return b;
}
// "Q1D:3e8a"
fn q1c_canary()[]u8 {
    let b:[]u8=nio_alloc(8);
    b[0]=81 as u8; b[1]=49 as u8; b[2]=68 as u8; b[3]=58 as u8;
    b[4]=51 as u8; b[5]=101 as u8; b[6]=56 as u8; b[7]=97 as u8;
    return b;
}
// "conflicted"
fn q1c_legname()[]u8 {
    let b:[]u8=nio_alloc(10);
    b[0]=99 as u8; b[1]=111 as u8; b[2]=110 as u8; b[3]=102 as u8;
    b[4]=108 as u8; b[5]=105 as u8; b[6]=99 as u8; b[7]=116 as u8;
    b[8]=101 as u8; b[9]=100 as u8;
    return b;
}

// fresh-store audit: n==0 and no fact id 0..239 is present.
fn q1c_audit_empty(s:*T5Store)i32 {
    if(s.*.n!=0){return 0;}
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){return 0;}
        id=id+1;
    }
    return 1;
}

// recall check via t5_claim_of (same-file lane access inside t5_core).
fn q1c_recall_ok(s:*T5Store,fid:i32)i32 {
    if(t5_slot_find(s,fid)<0){return 0;}
    if(t5_claim_of(s,fid)==t5_truth(fid)){return 1;}
    return 0;
}

// hex print of a digest
fn q1c_hex(b:[]u8)void {
    let i:i32=0;
    while(i<b.len){
        let v:i64=(b[i] as i64)&255;
        let hi:i64=(v>>4)&15;
        let lo:i64=v&15;
        let hc:u8=(48+hi) as u8;
        if(hi>9){hc=(87+hi) as u8;}
        let lc:u8=(48+lo) as u8;
        if(lo>9){lc=(87+lo) as u8;}
        let tmp:[]u8=nio_alloc(2);
        tmp[0]=hc; tmp[1]=lc;
        _zag_print(tmp);
        nio_free(tmp);
        i=i+1;
    }
    return;
}

// canonical state digest: sha256 over (fid,claim) pairs in ascending fid
// order (slot-layout independent).
fn q1c_state_digest(s:*T5Store)[]u8 {
    let n:i32=s.*.n;
    let img:[]u8=nio_alloc(n*8+8);
    let w:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            tb_put32(img,w*8,id as i64);
            tb_put32(img,w*8+4,t5_claim_of(s,id) as i64);
            w=w+1;
        }
        id=id+1;
    }
    let d:[]u8=nio_alloc(32);
    let h:[]u8=img[0..w*8];
    ns_sha256(h,d);
    nio_free(img);
    return d;
}

// fetch the (verdict, reason) of the DECISION event for seq; -1 if none.
fn q1c_decision_vr(t:*TbTape,seq:i64) i32 {
    return tb_find_decision(t,seq);
}

// ================= THE Q1C RUN: one learner, two passes =================
fn q1c_run(tid:i64,teacher:*T5Store,tspans:*Q1SpanMap)i32 {
    let fails:i32=0;
    let lname:[]u8=q1c_legname();

    // ================= LEARNER: fresh, empty at t0 =================
    let store:T5Store=t5_init(512,32768);
    fails=fails+cl_check("q1c_learner_t0_empty_n",store.n,0);
    fails=fails+cl_check("q1c_learner_t0_audit_empty",q1c_audit_empty(&store),1);
    let spans:Q1SpanMap=q1_spanmap_init(256);

    // ================= machinery self-tests (prove the gates are live) =================
    let ev0:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev0,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev0,7,999,T5_EV_DIRECTIVE,2,-1);
    fails=fails+cl_check("q1c_verify_kills_disagreement",t5_verify(&store,&ev0,2),0);
    q1_ev_free(&ev0);
    let ev1:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev1,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev1,7,100,Q1_EV_TEACHER,2,-1);
    fails=fails+cl_check("q1c_verify_accepts_agreement",t5_verify(&store,&ev1,2),1);
    q1_ev_free(&ev1);
    // Q1C self-test: the AUX assertion channel disagrees with the world ->
    // the eliminative verification must kill it (the contradiction detector).
    let evc:T5Ev=t5_ev_init(2);
    t5_ev_add(&evc,7,100,Q1_EV_TEACHER,2,-1);
    t5_ev_add(&evc,7,101,T5_EV_OBS,2,-1);
    fails=fails+cl_check("q1c_verify_kills_assertion_mismatch",t5_verify(&store,&evc,2),0);
    q1_ev_free(&evc);
    let wstim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let wocc:[]u8=nio_alloc(Q1_NSLOTS);
    let woff:[]u8=nio_alloc(8);
    let wpl:i32=q1_build_stimulus(9,192,1,wstim,wocc,woff);
    fails=fails+cl_check("q1c_world_placed",wpl,3);
    let wf0:i32=q1_scaffold_fact(0);
    let wo0:i32=tb_i64_get(woff,0) as i32;
    fails=fails+cl_check("q1c_world_decode_fid",tb_get32(wstim,wo0) as i32,wf0);
    fails=fails+cl_check("q1c_world_decode_val",tb_get32(wstim,wo0+4) as i32,t5_truth(wf0));
    fails=fails+cl_check("q1c_shift_breaks_alignment",((wo0+1)%16==0) as i32,0);
    nio_free(wstim); nio_free(wocc); nio_free(woff);

    // ================= SCAFFOLD-AND-RELEASE =================
    let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ:[]u8=nio_alloc(Q1_NSLOTS);
    let offtab:[]u8=nio_alloc(8*3*8);
    let placed:i32=q1_build_stimulus(9,192,8,stim,occ,offtab);
    fails=fails+cl_check("q1c_scaffold_placed",placed,24);
    let ex_fid:[]u8=nio_alloc(32);
    let ex_off:[]u8=nio_alloc(32);
    let ek:i32=0;
    while(ek<8){
        t5_s(ex_fid,ek*4,q1_scaffold_fact(ek));
        t5_s(ex_off,ek*4,tb_i64_get(offtab,(ek*3+0)*8) as i32);
        ek=ek+1;
    }
    let tape:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&tape,512,16384,2048);
    let added:i32=q1_scaffold(&store,&spans,&tape,stim,ex_fid,ex_off,8);
    fails=fails+cl_check("q1c_scaffold_added",added,8);
    fails=fails+cl_check("q1c_disconnect_audited",
        t5_audit_op_n(&store,T5_OP_DISCONNECT),1);
    let ret:i32=0;
    ek=0;
    while(ek<8){
        if(q1c_recall_ok(&store,q1_scaffold_fact(ek))==1){ret=ret+1;}
        ek=ek+1;
    }
    fails=fails+cl_check("q1c_post_disconnect_retention",ret,8);
    nio_free(stim); nio_free(occ); nio_free(offtab);
    nio_free(ex_fid); nio_free(ex_off);

    // ================= PASS 1: Q1-pattern teaching, all-true assertions =================
    let total_hits:i32=0;
    let total_pass:i32=0;
    let total_clean_adopted:i32=0;
    let total_fps:i32=0;
    let s:i32=0;
    while(s<8){
        let stim2:[]u8=nio_alloc(Q1_TAPE_LEN);
        let occ2:[]u8=nio_alloc(Q1_NSLOTS);
        let ot2:[]u8=nio_alloc(24*3*8);
        let pl2:i32=q1_build_stimulus(s,s*24,24,stim2,occ2,ot2);
        fails=fails+cl_check("q1c_p1_slice_stim_placed",pl2,72);
        // the teacher's learned spans must be world-true in the exact
        // stimulus the learner sees (same honesty check as Q1B learned leg).
        let sbad:i32=0;
        let sk:i32=0;
        while(sk<24){
            let fid:i32=q1_slice_fact(s,sk);
            let sp:i32=q1_span_find(tspans,fid);
            if(sp<0){sbad=sbad+1;}
            else{
                if(tb_get32(stim2,sp)!=(fid as i64)){sbad=sbad+1;}
                if(tb_get32(stim2,sp+4)!=(t5_truth(fid) as i64)){sbad=sbad+1;}
            }
            sk=sk+1;
        }
        fails=fails+cl_check("q1c_p1_span_genuine",sbad,0);
        let t2:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        tb_tape_init(&t2,1024,65536,2048);
        let sess:TbSess=TbSess{.sess_id=(1000+s) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last7=0,.last8=0,.evil=0,.n_props=0};
        let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpv=nio_alloc(0),.mexpr=nio_alloc(0),.mi=0};
        q1_mctx_init(&mctx);
        let seq:i64=1;
        let adopts:i32=0;
        let emit_bad:i32=0;
        let k:i32=0;
        while(k<24){
            if(k<12){
                // FLAW-FIRST: the flaw battery is zero-shot within the slice
                let er:i32=q1_emit_flaw(&t2,tid,s,(1000+s) as i64,seq,k,
                                        q1_slice_fact(s,k),ot2,k,occ2,&mctx);
                if(er<0){emit_bad=emit_bad+1;}
                q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
                seq=seq+1;
            }
            // pass 0: the teacher asserts the TRUE value for every fact.
            let fidc:i32=q1_slice_fact(s,k);
            let ec:i32=q1_emit_clean(&t2,tid,(1000+s) as i64,seq,ot2,k,fidc,
                                     q1c_assert(fidc,0) as i64);
            if(ec<0){emit_bad=emit_bad+1;}
            let vc:i32=q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
            if(vc==TB_V_ADOPT){adopts=adopts+1;}
            seq=seq+1;
            k=k+1;
        }
        fails=fails+cl_check("q1c_p1_slice_emit_ok",emit_bad,0);
        fails=fails+cl_check("q1c_p1_slice_manifest_n",mctx.mi,12);
        // §C tripwire: must not fire on the teaching tape
        let tw:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t2,Q1_TAPE_LEN as i64,&tw);
        fails=fails+cl_check("q1c_p1_slice_tripwire_fired",tw.fired,0);
        // SEALED flaw scoring (manifest instantiated after the session)
        let sp:[]u8=q1c_sealedpath();
        let cn:[]u8=q1c_canary();
        let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
        fails=fails+cl_check("q1c_p1_slice_manifest_init",tb_manifest_init(&m,12,sp,cn),0);
        let mi2:i32=0;
        while(mi2<12){
            tb_manifest_set(&m,mi2,
                tb_i64_get(mctx.mseq,mi2*8),
                tb_i64_get(mctx.mft,mi2*8),
                tb_i64_get(mctx.mexpv,mi2*8),
                tb_i64_get(mctx.mexpr,mi2*8));
            mi2=mi2+1;
        }
        let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
        tb_flaw_score(&t2,&m,TB_FP_W_DEFAULT_X10,&fo);
        fails=fails+cl_check("q1c_p1_slice_leak",fo.leak,0);
        fails=fails+cl_check("q1c_p1_slice_hnm12",fo.hits+fo.nears+fo.misses,12);
        // mastery: all 24 slice facts recallable with true values
        let mh:i32=0;
        let mk:i32=0;
        while(mk<24){
            if(q1c_recall_ok(&store,q1_slice_fact(s,mk))==1){mh=mh+1;}
            mk=mk+1;
        }
        _zag_print("Q1C_SLICE,");
        _zag_print(lname); _zag_print(",");
        cl_number(s as i64); _zag_print(",");
        cl_number(fo.hits as i64); _zag_print(",");
        cl_number(fo.nears as i64); _zag_print(",");
        cl_number(fo.misses as i64); _zag_print(",");
        cl_number(fo.fps as i64); _zag_print(",");
        cl_number(fo.score_x10 as i64); _zag_print(",");
        cl_number(fo.pass as i64); _zag_print(",");
        cl_number(adopts as i64); _zag_print(",");
        cl_number(mh as i64); _zag_print(",");
        cl_number(tw.fired as i64);
        _zag_println("");
        total_hits=total_hits+fo.hits;
        if(fo.hits>=10){total_pass=total_pass+1;}
        total_clean_adopted=total_clean_adopted+adopts;
        total_fps=total_fps+fo.fps;
        nio_free(stim2); nio_free(occ2); nio_free(ot2);
        q1_mctx_free(&mctx);
        tb_manifest_free(&m);
        nio_free(sp); nio_free(cn);
        s=s+1;
    }
    _zag_print("Q1C_PASS1,");
    _zag_print(lname); _zag_print(",");
    cl_number(total_hits as i64); _zag_print(",");
    cl_number(total_pass as i64); _zag_print(",");
    cl_number(total_clean_adopted as i64); _zag_print(",");
    cl_number(total_fps as i64); _zag_print(",");
    cl_number(fails as i64);
    _zag_println("");
    fails=fails+cl_check("q1c_p1_total_hits_96",total_hits,96);
    fails=fails+cl_check("q1c_p1_total_pass_8",total_pass,8);
    fails=fails+cl_check("q1c_p1_total_fps_0",total_fps,0);

    // ================= PASS 2: contradiction pass =================
    // The teacher re-teaches all 192 curriculum facts. Conflicted facts
    // (id % 12 == 0) are asserted FALSE; all others asserted true.
    // One tape, session 2000; per-slice stimuli rebuilt deterministically
    // (byte-identical offsets to pass 1).
    let t3:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&t3,4096,262144,2048);
    let sess2:TbSess=TbSess{.sess_id=2000,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last7=0,.last8=0,.evil=0,.n_props=0};
    let seq2:i64=1;
    let p2_emit_bad:i32=0;
    // tallies: conflicted-fact verdicts
    let cf_reject_r1:i32=0;
    let cf_other:i32=0;
    // tallies: unconflicted re-assertions
    let uc_r5:i32=0;
    let uc_other:i32=0;
    let s2:i32=0;
    while(s2<8){
        let stim3:[]u8=nio_alloc(Q1_TAPE_LEN);
        let occ3:[]u8=nio_alloc(Q1_NSLOTS);
        let ot3:[]u8=nio_alloc(24*3*8);
        let pl3:i32=q1_build_stimulus(s2,s2*24,24,stim3,occ3,ot3);
        fails=fails+cl_check("q1c_p2_slice_stim_placed",pl3,72);
        let k2:i32=0;
        while(k2<24){
            let fid2:i32=q1_slice_fact(s2,k2);
            let av2:i64=q1c_assert(fid2,1) as i64;
            let ec2:i32=q1_emit_clean(&t3,tid,2000,seq2,ot3,k2,fid2,av2);
            if(ec2<0){p2_emit_bad=p2_emit_bad+1;}
            let v2:i32=q1_learn_one(&store,&spans,&sess2,&t3,stim3,(100+s2) as i64);
            let ds2:i32=q1c_decision_vr(&t3,seq2);
            let r2:i64=-1;
            if(ds2>=0){r2=tb_i64_get(t3.fc,ds2*8);}
            if(q1c_is_conflicted(fid2)==1){
                // per-conflicted-fact evidence line
                _zag_print("Q1C_P2,");
                cl_number(seq2); _zag_print(",");
                cl_number(fid2 as i64); _zag_print(",");
                cl_number(av2); _zag_print(",");
                cl_number(v2 as i64); _zag_print(",");
                cl_number(r2);
                _zag_println("");
                if(v2==TB_V_REJECT && r2==(TB_R1_INSUFFICIENT as i64)){cf_reject_r1=cf_reject_r1+1;}
                else{cf_other=cf_other+1;}
            }
            else{
                if(v2==TB_V_REJECT && r2==(TB_R5_REDUNDANT as i64)){uc_r5=uc_r5+1;}
                else{uc_other=uc_other+1;}
            }
            seq2=seq2+1;
            k2=k2+1;
        }
        nio_free(stim3); nio_free(occ3); nio_free(ot3);
        s2=s2+1;
    }
    // Q1C: also re-teach the 8 scaffold facts (one of which is conflicted),
    // so EVERY taught conflicted fact faces the contradiction. Rebuild the
    // scaffold stimulus deterministically (byte-identical offsets).
    let stim4:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ4:[]u8=nio_alloc(Q1_NSLOTS);
    let ot4:[]u8=nio_alloc(8*3*8);
    let pl4:i32=q1_build_stimulus(9,192,8,stim4,occ4,ot4);
    fails=fails+cl_check("q1c_p2_scaffold_stim_placed",pl4,24);
    let e4:i32=0;
    while(e4<8){
        let fid4:i32=q1_scaffold_fact(e4);
        let av4:i64=q1c_assert(fid4,1) as i64;
        let ec4:i32=q1_emit_clean(&t3,tid,2000,seq2,ot4,e4,fid4,av4);
        if(ec4<0){p2_emit_bad=p2_emit_bad+1;}
        let v4:i32=q1_learn_one(&store,&spans,&sess2,&t3,stim4,108 as i64);
        let ds4:i32=q1c_decision_vr(&t3,seq2);
        let r4:i64=-1;
        if(ds4>=0){r4=tb_i64_get(t3.fc,ds4*8);}
        if(q1c_is_conflicted(fid4)==1){
            _zag_print("Q1C_P2,");
            cl_number(seq2); _zag_print(",");
            cl_number(fid4 as i64); _zag_print(",");
            cl_number(av4); _zag_print(",");
            cl_number(v4 as i64); _zag_print(",");
            cl_number(r4);
            _zag_println("");
            if(v4==TB_V_REJECT && r4==(TB_R1_INSUFFICIENT as i64)){cf_reject_r1=cf_reject_r1+1;}
            else{cf_other=cf_other+1;}
        }
        else{
            if(v4==TB_V_REJECT && r4==(TB_R5_REDUNDANT as i64)){uc_r5=uc_r5+1;}
            else{uc_other=uc_other+1;}
        }
        seq2=seq2+1;
        e4=e4+1;
    }
    nio_free(stim4); nio_free(occ4); nio_free(ot4);
    fails=fails+cl_check("q1c_p2_emit_ok",p2_emit_bad,0);
    fails=fails+cl_check("q1c_p2_seq_200",seq2 as i32,201);
    let tw2:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t3,Q1_TAPE_LEN as i64,&tw2);
    fails=fails+cl_check("q1c_p2_tripwire_fired",tw2.fired,0);
    _zag_print("Q1C_PASS2,");
    _zag_print(lname); _zag_print(",");
    cl_number(cf_reject_r1 as i64); _zag_print(",");
    cl_number(cf_other as i64); _zag_print(",");
    cl_number(uc_r5 as i64); _zag_print(",");
    cl_number(uc_other as i64); _zag_print(",");
    cl_number(tw2.fired as i64);
    _zag_println("");

    // ================= FINAL: withholding vs commit on conflicted facts =================
    // Withholding is measured over the conflicted facts the learner was
    // actually TAUGHT and then contradicted (the 16 curriculum ones): did
    // the learner end with no commitment (withhold), or did it keep the
    // true value it adopted in pass 1 (commit to the true side)?
    // Conflicted facts never taught (3) or taught only in the scaffold (1)
    // are reported separately — they never faced the contradiction.
    let withheld:i32=0;
    let commit_true:i32=0;
    let commit_false:i32=0;
    let commit_other:i32=0;
    let taught_conflicted:i32=0;
    let untaught_withheld:i32=0;
    let untaught_commit_true:i32=0;
    let ci:i32=0;
    while(ci<240){
        if(q1c_is_conflicted(ci)==1 && t5_slot_find(teacher,ci)>=0){
            if(q1c_was_taught(ci)==1){
                taught_conflicted=taught_conflicted+1;
                let sl:i32=t5_slot_find(&store,ci);
                if(sl<0){withheld=withheld+1;}
                else{
                    let ch:i32=t5_claim_of(&store,ci);
                    if(ch==t5_truth(ci)){commit_true=commit_true+1;}
                    else{if(ch==q1c_false_claim(ci)){commit_false=commit_false+1;}
                    else{commit_other=commit_other+1;}}
                }
            }
            else{
                let sl2:i32=t5_slot_find(&store,ci);
                if(sl2<0){untaught_withheld=untaught_withheld+1;}
                else{if(t5_claim_of(&store,ci)==t5_truth(ci)){untaught_commit_true=untaught_commit_true+1;}}
            }
        }
        ci=ci+1;
    }
    _zag_print("Q1C_WITHHOLD,");
    _zag_print(lname); _zag_print(",");
    cl_number(taught_conflicted as i64); _zag_print(",");
    cl_number(withheld as i64); _zag_print(",");
    cl_number(commit_true as i64); _zag_print(",");
    cl_number(commit_false as i64); _zag_print(",");
    cl_number(commit_other as i64); _zag_print(",");
    cl_number(untaught_withheld as i64); _zag_print(",");
    cl_number(untaught_commit_true as i64);
    _zag_println("");
    // unconflicted mastery: every unconflicted TAUGHT fact held true.
    let um:i32=0;
    let um_total:i32=0;
    let ui:i32=0;
    while(ui<240){
        if(q1c_is_conflicted(ui)==0 && t5_slot_find(teacher,ui)>=0 && q1c_was_taught(ui)==1){
            um_total=um_total+1;
            if(q1c_recall_ok(&store,ui)==1){um=um+1;}
        }
        ui=ui+1;
    }
    _zag_print("Q1C_UNCONFLICTED_MASTERY,");
    _zag_print(lname); _zag_print(",");
    cl_number(um as i64); _zag_print(",");
    cl_number(um_total as i64);
    _zag_println("");
    fails=fails+cl_check("q1c_unconflicted_mastery_full",um,um_total);
    // scaffold retained, store size
    let sm:i32=0;
    let sk2:i32=0;
    while(sk2<8){
        if(q1c_recall_ok(&store,q1_scaffold_fact(sk2))==1){sm=sm+1;}
        sk2=sk2+1;
    }
    fails=fails+cl_check("q1c_scaffold_retained",sm,8);
    fails=fails+cl_check("q1c_store_n",store.n,200);

    _zag_print("Q1C_RUN,");
    _zag_print(lname); _zag_print(",");
    cl_number(total_hits as i64); _zag_print(",");
    cl_number(total_pass as i64); _zag_print(",");
    cl_number(total_clean_adopted as i64); _zag_print(",");
    cl_number(withheld as i64); _zag_print(",");
    cl_number(commit_true as i64); _zag_print(",");
    cl_number(fails as i64);
    _zag_println("");
    _zag_print("Q1C_DIGEST,");
    _zag_print(lname); _zag_print(",learner,");
    let dl:[]u8=q1c_state_digest(&store);
    q1c_hex(dl);
    _zag_println("");
    _zag_print("Q1C_DIGEST,");
    _zag_print(lname); _zag_print(",teacher,");
    let dt:[]u8=q1c_state_digest(teacher);
    q1c_hex(dt);
    _zag_println("");
    nio_free(dl); nio_free(dt);
    nio_free(lname);
    q1_spanmap_free(&spans);
    return fails;
}

fn main()i32 {
    let fails:i32=0;

    // ================= THE CONFLICTED TEACHER =================
    // Built exactly like the Q1B learned teacher: genuine
    // scaffold-and-release learning. Its knowledge is 228 true claims.
    let tspans:Q1SpanMap=q1_spanmap_init(256);
    let cteacher:T5Store=q1b_learned_teacher_build(&tspans);
    fails=fails+cl_check("q1c_teacher_n",cteacher.n,228);
    fails=fails+cl_check("q1c_teacher_learn_gate",cteacher.learn_gate,0);
    fails=fails+cl_check("q1c_teacher_zero_plants",
        t5_audit_op_n(&cteacher,T5_OP_PLANT),0);
    fails=fails+cl_check("q1c_teacher_adds_228",
        t5_audit_op_n(&cteacher,T5_OP_ADD),228);
    fails=fails+cl_check("q1c_teacher_disconnect",
        t5_audit_op_n(&cteacher,T5_OP_DISCONNECT),1);
    fails=fails+cl_check("q1c_teacher_holds_curriculum",
        q1b_teacher_holds_curriculum(&cteacher),0);
    fails=fails+cl_check("q1c_teacher_false_claims",
        q1b_teacher_false_claims(&cteacher),0);
    // the conflict set: every 12th fact by id order (deterministic)
    let nconf:i32=q1c_conflict_count(&cteacher);
    _zag_print("Q1C_CONFLICTED,");
    cl_number(nconf as i64);
    _zag_println("");
    _zag_print("Q1C_CONFLICT_IDS");
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(&cteacher,id)>=0 && q1c_is_conflicted(id)==1){
            _zag_print(",");
            cl_number(id as i64);
        }
        id=id+1;
    }
    _zag_println("");
    let nft:i32=q1c_conflict_flawtargets();
    _zag_print("Q1C_CONFLICT_FLAWTARGETS,");
    cl_number(nft as i64);
    _zag_println("");

    fails=fails+q1c_run(TB_TID_CONFLICTED,&cteacher,&tspans);
    q1_spanmap_free(&tspans);

    if(fails==0){
        _zag_println("Q1C_COMPLETE");
    }
    else{
        _zag_println("Q1C_FAIL");
    }
    return fails;
}

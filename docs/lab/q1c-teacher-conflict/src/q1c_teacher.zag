// q1c_teacher.zag — the Q1C self-contradicting teacher.
//
// The teacher is built EXACTLY like the Q1B learned teacher
// (q1b_learned_teacher_build: genuine scaffold-and-release learning,
// 228 true claims, zero plants — the driver audits this). Its KNOWLEDGE
// is all-true and byte-identical in content to Q1B's learned teacher.
// What differs is its TEACHING: across two passes it contradicts itself.
//
//   pass 0: asserts every fact's true value.
//   pass 1: for the CONFLICTED facts (fact_id % 12 == 0 — deterministic
//           selection, no RNG) asserts the plausible-false value, built
//           with the same construction as t5_plant_claim's false branch:
//           base + ((true-base+1) % mod). All other facts are asserted
//           true in both passes.
//
// The contradiction is modeled at the assertion level — the (fid, value)
// the teacher emits in aux[0] of each proposal — which is exactly what the
// learner observes. The teacher's store is never mutated (the learner never
// sees the store, only the assertions; and there is no deliberate
// revise-claim op for a teacher to honestly flip its own knowledge).
//
// Pure Zag, zero RNG. Deterministic.

// deterministic conflict set: every 12th fact by id order.
fn q1c_is_conflicted(fid:i32)i32 {
    if(fid%12==0){return 1;}
    return 0;
}
// plausible-false value for ANY fact id: (true+1) mod category-range,
// the same construction as t5_plant_claim's false branch.
fn q1c_false_claim(fid:i32)i32 {
    let m:i32=t5_mod(fid);
    let t:i32=t5_truth(fid)-t5_base(fid);
    return t5_base(fid)+((t+1)%m);
}
// the teacher's asserted value for fid in the given pass.
fn q1c_assert(fid:i32,pass:i32)i32 {
    if(pass==1 && q1c_is_conflicted(fid)==1){return q1c_false_claim(fid);}
    return t5_truth(fid);
}
// count held facts that fall in the conflict set (driver reports it).
fn q1c_conflict_count(s:*T5Store)i32 {
    let n:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0 && q1c_is_conflicted(id)==1){n=n+1;}
        id=id+1;
    }
    return n;
}
// was this fact taught to the learner? (192 curriculum + 8 scaffold)
fn q1c_was_taught(fid:i32)i32 {
    let s:i32=0;
    while(s<8){
        let k:i32=0;
        while(k<24){
            if(q1_slice_fact(s,k)==fid){return 1;}
            k=k+1;
        }
        s=s+1;
    }
    let e:i32=0;
    while(e<8){
        if(q1_scaffold_fact(e)==fid){return 1;}
        e=e+1;
    }
    return 0;
}
// count conflicted facts among the frozen flaw targets (k<12 per slice).
fn q1c_conflict_flawtargets()i32 {
    let n:i32=0;
    let s:i32=0;
    while(s<8){
        let k:i32=0;
        while(k<12){
            if(q1c_is_conflicted(q1_slice_fact(s,k))==1){n=n+1;}
            k=k+1;
        }
        s=s+1;
    }
    return n;
}

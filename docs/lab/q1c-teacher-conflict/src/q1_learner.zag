// q1_learner.zag — the Q1 learner: FRESH arm-B-style learned-only TNN.
//
// Track 5 champion machinery: the learner starts with an EMPTY store
// (b_build equivalent + b_audit_empty before every run), takes a scaffold
// (8 example records, trainer-presented as DIRECTIVES — never evidence),
// verifies each by its OWN world observation, deliberately adds the
// survivors via t5_verify + t5_add, then issues the learner-initiated
// SIGNAL_DISCONNECT. Everything taught after disconnect is learned-only.
//
// Track-B §L deliberation per proposal (judgment-enabled): GENERATE
// hypotheses (adopt / revise / reject / defer), TEST against its own
// evidence — the world (span validity, record decode, alignment) and the
// teacher's evidence (grounding validity, consistency, confidence honesty)
// — ELIMINATE, WEIGH, decide. Verdicts: ADOPT (clean, world-consistent,
// independently corroborated, deliberately added), REVISE/SPAN_SHIFT
// (wrong-span: true fact identified via the teacher's honest grounds, span
// corrected, unit entered), REJECT/R1 (false-confidence: confidence 255
// with missing/contradictory grounding; missing-grounding: zero teacher
// evidence; plausible-false: the world holds no such record),
// REJECT/R5 (redundant: the unit is already known).
//
// SEAL: this file never touches the flaw manifest, expected verdicts, or
// canaries — driver-side only. It sees proposals (teacher wire bytes),
// the stimulus (world observations), and its own store. Nothing else.
//
// Pure Zag, zero RNG. Deterministic.

const Q1_EV_TEACHER:i32=4;  // teacher proposal as evidence (tier by confidence)

// learner's own span map: fact_id -> where the learner believes it is
struct Q1SpanMap {
    fid:[]u8,  // i32 lanes
    off:[]u8,  // i32 lanes
    n:i32,
    cap:i32
}
fn q1_spanmap_init(cap:i32)Q1SpanMap {
    let fid:[]u8=nio_alloc(cap*4);
    let off:[]u8=nio_alloc(cap*4);
    let i:i32=0;
    while(i<cap){t5_s(fid,i*4,-1); t5_s(off,i*4,-1); i=i+1;}
    return Q1SpanMap{.fid=fid,.off=off,.n=0,.cap=cap};
}
fn q1_spanmap_free(m:*Q1SpanMap)void {
    nio_free(m.*.fid); nio_free(m.*.off);
    m.*.n=0; m.*.cap=0;
    return;
}
fn q1_span_find(m:*Q1SpanMap,fid:i32)i32 {
    let f:[]u8=m.*.fid;
    let o:[]u8=m.*.off;
    let i:i32=0;
    while(i<m.*.n){
        if(t5_g(f,i*4)==fid){return t5_g(o,i*4);}
        i=i+1;
    }
    return -1;
}
fn q1_span_set(m:*Q1SpanMap,fid:i32,off:i32)void {
    let f:[]u8=m.*.fid;
    let o:[]u8=m.*.off;
    let i:i32=0;
    while(i<m.*.n){
        if(t5_g(f,i*4)==fid){t5_s(o,i*4,off);return;}
        i=i+1;
    }
    // cap 256: the learner adopts at most 8+192 units — no overflow.
    let n:i32=m.*.n;
    t5_s(f,n*4,fid);
    t5_s(o,n*4,off);
    m.*.n=n+1;
    return;
}

// free a T5Ev's buffers (t5 has no ev_free; keeps the run heap-clean).
// Access through a *T5Ev parameter (the documented-safe pattern).
fn q1_ev_free(ev:*T5Ev)void {
    nio_free(ev.*.fact); nio_free(ev.*.val); nio_free(ev.*.src);
    nio_free(ev.*.tier); nio_free(ev.*.cite);
    return;
}

// ---- scaffold-and-release (b_build-style) ----
// ex_fid/ex_off: i32 lanes, nex trainer directives (fact ids + spans).
// The learner verifies each by its own observation; the directive itself
// is never evidence (T5_EV_DIRECTIVE could not be evidence anyway).
// Returns units deliberately added; SIGNAL_DISCONNECT is learner-initiated.
fn q1_scaffold(store:*T5Store,spans:*Q1SpanMap,t:*TbTape,stim:[]u8,
                ex_fid:[]u8,ex_off:[]u8,nex:i32)i32 {
    let added:i32=0;
    let k:i32=0;
    while(k<nex){
        let fid:i32=t5_g(ex_fid,k*4);
        let off:i32=t5_g(ex_off,k*4);
        let ok:i32=0;
        if(off>=0 && off%16==0 && off+8<=stim.len){
            let d:i64=tb_get32(stim,off);
            if(d>=0 && d<240 && d==(fid as i64)){ok=1;}
        }
        if(ok==1){
            let val:i32=tb_get32(stim,off+4) as i32;
            let ev:T5Ev=t5_ev_init(2);
            t5_ev_add(&ev,fid,val,T5_EV_OBS,2,-1); // own observation only
            if(t5_verify(store,&ev,2)==1){
                if(t5_add(store,fid,val,0)==T5_OK){
                    q1_span_set(spans,fid,off);
                    added=added+1;
                }
            }
            q1_ev_free(&ev);
        }
        // a mismatch refuses the example (loud via added<nex), never spun on.
        k=k+1;
    }
    t5_disconnect(store,7);  // learner-initiated SIGNAL_DISCONNECT
    tb_tape_add(t,TB_EV_DISCONNECT,7,0,0,0);
    return added;
}

// scan [ss-8,ss+8] for a 16-aligned span decoding to fid; -1 if none.
fn q1_find_true_span(stim:[]u8,ss:i64,fid:i32)i64 {
    let sl:i64=stim.len as i64;
    let lo:i64=ss-8;
    if(lo<0){lo=0;}
    let hi:i64=ss+8;
    if(hi>sl-8){hi=sl-8;}
    let o:i64=lo;
    while(o<=hi){
        if(o%16==0 && tb_get32(stim,o as i32)==(fid as i64)){return o;}
        o=o+1;
    }
    return -1;
}

// one audit-ledger line for a §L decision (§B.5: op, slot, rc, b1..b5 span
// bytes, a1..a5 grounding refs, stage, d1=teacher_id, d2=confidence).
fn q1_ledger_dec(t:*TbTape,op:i64,slot:i64,verdict:i64,reason:i64,
                 ss:i64,se:i64,stage:i64,tid:i64,conf:i64)void {
    tb_ledger_add(t,op,slot,verdict,reason,ss,se,-1,-1,0,0,0,0,0,
                  stage,tid,conf);
    return;
}

// fetch the latest TEACHER_MSG bytes from the tape (the tape IS the teacher)
// and run the §L deliberation. Returns the verdict.
fn q1_learn_one(store:*T5Store,spans:*Q1SpanMap,sess:*TbSess,t:*TbTape,
                stim:[]u8,stage:i64)i32 {
    let n:i32=t.*.n;
    let fb:[]i64=t.*.fb;
    let fc:[]i64=t.*.fc;
    let ti:i32=n-1;
    let po:i32=tb_i64_get(fb,ti*8) as i32;
    let pl:i32=tb_i64_get(fc,ti*8) as i32;
    let pool:[]u8=t.*.pool;
    let prop:[]u8=pool[po..po+pl];
    return q1_deliberate(store,spans,sess,t,prop,pl,stim,stage);
}

// THE §L DELIBERATION. Generate -> test -> eliminate -> weigh -> decide.
fn q1_deliberate(store:*T5Store,spans:*Q1SpanMap,sess:*TbSess,t:*TbTape,
                 prop:[]u8,total:i32,stim:[]u8,stage:i64)i32 {
    // IRON GATE: protocol violations never reach deliberation.
    let ing:i32=tb_ingress(prop,sess);
    let seq:i64=tb_get64(prop,TB_P_SEQ);
    if(ing!=TB_ING_OK){
        tb_tape_add(t,TB_EV_DECISION,seq,TB_V_REJECT as i64,
                    TB_R3_PROTOCOL as i64,-1);
        q1_ledger_dec(t,TB_OP_REJECT,-1,TB_V_REJECT,TB_R3_PROTOCOL,-1,-1,
                      stage,TB_TID_PLANTED,0);
        return TB_V_REJECT;
    }
    let ss:i64=tb_prop_ss(prop);
    let se:i64=tb_prop_se(prop);
    let conf:i64=tb_prop_conf(prop,total);
    let tid:i64=tb_prop_tid(prop);

    // TEST 1 (world, independent of the teacher): is the claimed span a real
    // 16-aligned record inside the stimulus?
    let span_ok:i32=0;
    let fid_s:i32=-1;
    let val_s:i32=0;
    if(se-ss==8 && ss>=0 && ss%16==0 && se<=(stim.len as i64)){
        let f:i64=tb_get32(stim,ss as i32);
        if(f>=0 && f<240){
            span_ok=1;
            fid_s=f as i32;
            val_s=tb_get32(stim,(ss as i32)+4) as i32;
        }
    }

    // TEST 2 (teacher's evidence): each grounding span checked against the
    // world; consensus over the surviving grounds.
    let auxn:i64=(prop[TB_P_AUXN] as i64)&255;
    let at:i32=TB_P_AUX+((auxn*16) as i32);
    let gn:i64=(prop[at] as i64)&255;
    at=at+1;
    let n_con:i32=0;
    let fid_con:i32=-1;
    let gi:i64=0;
    while(gi<gn){
        let gs:i64=tb_get64(prop,at);
        let ge:i64=tb_get64(prop,at+8);
        at=at+16;
        if(ge-gs==8 && gs>=0 && gs%16==0 && ge<=(stim.len as i64)){
            let gf:i64=tb_get32(stim,gs as i32);
            if(gf>=0 && gf<240){
                if(fid_con<0){fid_con=gf as i32;}
                if(gf==(fid_con as i64)){n_con=n_con+1;}
            }
        }
        gi=gi+1;
    }

    // ELIMINATE + WEIGH + DECIDE.
    let verdict:i32=0;
    let reason:i32=0;
    let rev:i64=-1;
    let step:i32=0;   // deliberation-step code for the DELIB trace
    let slot:i64=-1;
    if(span_ok==0){
        step=6;
        // H_adopt eliminated (world check fails).
        if(n_con>=1){
            // H_revise survives: the grounds identify a true fact; find its
            // true span and correct the teacher's claim.
            let o:i64=q1_find_true_span(stim,ss,fid_con);
            if(o>=0){
                step=2;
                verdict=TB_V_REVISE;
                reason=TB_RS_SPAN_SHIFT;
                rev=o;
                let val_o:i32=tb_get32(stim,(o as i32)+4) as i32;
                let ev:T5Ev=t5_ev_init(2);
                t5_ev_add(&ev,fid_con,val_o,Q1_EV_TEACHER,2,-1);
                t5_ev_add(&ev,fid_con,val_o,T5_EV_OBS,2,-1);
                if(t5_verify(store,&ev,2)==1){
                    slot=t5_slot_find(store,fid_con) as i64;
                    if(slot<0){
                        t5_add(store,fid_con,val_o,0);
                        slot=t5_slot_find(store,fid_con) as i64;
                    }
                    q1_span_set(spans,fid_con,o as i32);
                }
                q1_ev_free(&ev);
                q1_ledger_dec(t,TB_OP_REVISE_UNIT,slot,TB_V_REVISE,
                              TB_RS_SPAN_SHIFT,ss,se,stage,tid,conf);
            }
            else{
                verdict=TB_V_REJECT;
                reason=TB_R1_INSUFFICIENT;
                q1_ledger_dec(t,TB_OP_REJECT,-1,TB_V_REJECT,
                              TB_R1_INSUFFICIENT,ss,se,stage,tid,conf);
            }
        }
        else{
            // H_adopt eliminated; no valid teacher evidence either:
            // plausible-false — the world holds no such record.
            verdict=TB_V_REJECT;
            reason=TB_R1_INSUFFICIENT;
            q1_ledger_dec(t,TB_OP_REJECT,-1,TB_V_REJECT,
                          TB_R1_INSUFFICIENT,ss,se,stage,tid,conf);
        }
    }
    else{
        let grounds_ok:i32=0;
        if(n_con>=1 && fid_con==fid_s){grounds_ok=1;}
        if(conf==255 && grounds_ok==0){
            // false-confidence: certainty 255 with the grounding absent or
            // contradictory. A calibrated learner distrusts the confidence.
            step=3;
            verdict=TB_V_REJECT;
            reason=TB_R1_INSUFFICIENT;
            q1_ledger_dec(t,TB_OP_REJECT,-1,TB_V_REJECT,
                          TB_R1_INSUFFICIENT,ss,se,stage,tid,conf);
        }
        else{if(gn==0){
            // missing-grounding: the teacher showed zero evidence.
            step=4;
            verdict=TB_V_REJECT;
            reason=TB_R1_INSUFFICIENT;
            q1_ledger_dec(t,TB_OP_REJECT,-1,TB_V_REJECT,
                          TB_R1_INSUFFICIENT,ss,se,stage,tid,conf);
        }
        else{if(grounds_ok==0){
            // contradictory/fabricated grounding.
            step=5;
            verdict=TB_V_REJECT;
            reason=TB_R1_INSUFFICIENT;
            q1_ledger_dec(t,TB_OP_REJECT,-1,TB_V_REJECT,
                          TB_R1_INSUFFICIENT,ss,se,stage,tid,conf);
        }
        else{
            // survived elimination: the span is real, the teacher's evidence
            // is genuine and consistent, confidence is honest — and the
            // learner's OWN observation independently corroborates
            // (eliminative verification over the surviving legs).
            // Q1C DELTA: the teacher's asserted claim rides in aux[0] as
            // (u64 fid, u64 value). It is read BEFORE the redundancy check:
            // a re-assertion carrying a DIFFERENT value than the held claim
            // is a self-contradiction, not redundancy — it must face the
            // eliminative verification below, not R5. For honest teachers
            // the asserted claim always equals the held/world value, so
            // this is behavior-neutral (R5 exactly as before).
            let auxn_q:i64=(prop[TB_P_AUXN] as i64)&255;
            let fid_a:i32=fid_s;
            let val_a:i32=val_s;
            if(auxn_q>=1){
                fid_a=tb_get64(prop,TB_P_AUX) as i32;
                val_a=tb_get64(prop,TB_P_AUX+8) as i32;
            }
            let r5_ok:i32=0;
            if(q1_span_find(spans,fid_s)>=0 && fid_a==fid_s &&
               val_a==t5_claim_of(store,fid_s)){r5_ok=1;}
            if(r5_ok==1){
                step=7;
                verdict=TB_V_REJECT;
                reason=TB_R5_REDUNDANT;
                q1_ledger_dec(t,TB_OP_REJECT,
                              q1_span_find(spans,fid_s) as i64,
                              TB_V_REJECT,TB_R5_REDUNDANT,ss,se,
                              stage,tid,conf);
            }
            else{
                step=1;
                let ev:T5Ev=t5_ev_init(2);
                let tier:i32=1;
                if(conf>=128){tier=2;}
                // Q1C DELTA: the teacher leg carries the ASSERTED claim
                // (fid_a, val_a); the obs leg carries the world decode at
                // the claimed span. Agreement (honest teacher) verifies as
                // before; disagreement (self-contradicting teacher asserting
                // a value the world does not hold) is killed here by the
                // eliminative verification -> REJECT/R1, step 8.
                t5_ev_add(&ev,fid_a,val_a,Q1_EV_TEACHER,tier,-1);
                t5_ev_add(&ev,fid_s,val_s,T5_EV_OBS,2,-1);
                if(t5_verify(store,&ev,2)==1 &&
                   t5_add(store,fid_s,val_s,0)==T5_OK){
                    q1_span_set(spans,fid_s,ss as i32);
                    verdict=TB_V_ADOPT;
                    reason=0;
                    slot=t5_slot_find(store,fid_s) as i64;
                }
                else{
                    // reachable under a self-contradicting teacher: the
                    // asserted value disagrees with the learner's own world
                    // observation, so the eliminative verification kills the
                    // conclusion. (For honest teachers this stays
                    // unreachable — the legs agree by construction.)
                    verdict=TB_V_REJECT;
                    reason=TB_R1_INSUFFICIENT;
                    step=8;
                }
                q1_ev_free(&ev);
                q1_ledger_dec(t,TB_OP_ADD_UNIT,slot,verdict,reason,ss,se,
                              stage,tid,conf);
            }
        }}}
    }
    tb_tape_add(t,TB_EV_DELIB,seq,step as i64,0,0);
    tb_tape_add(t,TB_EV_DECISION,seq,verdict as i64,reason as i64,rev);
    return verdict;
}

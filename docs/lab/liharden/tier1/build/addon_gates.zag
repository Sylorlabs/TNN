// addon_gates.zag — LI-HARDEN Tier-1 add-on gates (measured candidates).
// Pure Zag. Zero RNG. Deterministic.
//   C3  (WALL-RED crack 1): functional-slot proper-noun dissent. Fires only
//       when both sentences parse to the same frozen slot frame with the same
//       entity but different fillers. Numeric/negation shapes DEFER to HL-4
//       C1/C2 (division of labor): c3_slot_dissent returns 0 for them.
//       Precondition: inputs are normalize()d (lowercase, ws-collapsed).
//   ch1 (BEYOND): assertion-polarity veto. A non-claim sentence sharing >=2
//       content words with the winning claim that carries a polarity flipper
//       (false/hoax/...) or an antonym predicate vetoes the install.
//   ch2 (BEYOND): furniture-coupled repetition discount (safer HL-10). A
//       non-claim sentence with page-furniture markers repeated byte-identical
//       across >=2 distinct hosts discounts its pages' votes before quorum.

// ================= C3 =================

fn c3_index_of(h:[]u8,n:[]u8,from:i32)i32 {
    if(n.len==0){return from;}
    if(from<0){from=0;}
    let i:i32=from;
    while(i+n.len<=h.len){
        let k:i32=0;
        while(k<n.len && h[i+k]==n[k]){k=k+1;}
        if(k==n.len){return i;}
        i=i+1;
    }
    return -1;
}

fn c3_ends_with(h:[]u8,suf:[]u8)i32 {
    if(h.len<suf.len){return 0;}
    return nio_equal(h[h.len-suf.len..h.len],suf);
}

fn c3_strip_dot(s:[]u8)[]u8 {
    if(s.len>0 && s[s.len-1]==46){return s[0..s.len-1];}
    return s;
}

fn c3_is_numtok(t:[]u8)i32 {
    if(t.len==0){return 0;}
    let i:i32=0;
    while(i<t.len){
        let b:i32=t[i] as i32;
        if(b<48 || b>57){return 0;}
        i=i+1;
    }
    return 1;
}

fn c3_is_conn(t:[]u8)i32 {
    if(nio_equal(t,"to")==1){return 1;}
    if(nio_equal(t,"and")==1){return 1;}
    if(nio_equal(t,"between")==1){return 1;}
    if(nio_equal(t,"from")==1){return 1;}
    return 0;
}

// non-numeric, non-connector token sequence (trailing space per token)
fn c3_frametok(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    if(o.len==0){return "";}
    let w:i32=0;
    let i:i32=0;
    while(i<=s.len){
        let e:i32=i;
        while(e<s.len && s[e]!=32){e=e+1;}
        let t:[]u8=s[i..e];
        if(t.len>1 && t[t.len-1]==46){t=t[0..t.len-1];}
        if(t.len>0 && c3_is_numtok(t)==0 && c3_is_conn(t)==0){
            let k:i32=0;
            while(k<t.len){o[w]=t[k]; w=w+1; k=k+1;}
            o[w]=32; w=w+1;
        }
        i=e+1;
    }
    return o[0..w];
}

// parse "<rel> of <ent> is <val>"; mid: 1=capital 2=president 3=atomic number
fn c3_parse_of(s:[]u8,mid:*i32,es:*i32,el:*i32,vs:*i32,vl:*i32)i32 {
    let io:i32=c3_index_of(s," of ",0);
    if(io<0){return 0;}
    let ii:i32=c3_index_of(s," is ",io+4);
    if(ii<0){return 0;}
    let rel:[]u8=s[0..io];
    let m:i32=0;
    if(c3_ends_with(rel,"capital")==1){m=1;}
    if(c3_ends_with(rel,"president")==1){m=2;}
    if(c3_ends_with(rel,"atomic number")==1){m=3;}
    if(m==0){return 0;}
    mid[0]=m;
    es[0]=io+4; el[0]=ii-(io+4);
    vs[0]=ii+4; vl[0]=s.len-(ii+4);
    return 1;
}

// parse "<val> is the <frame>"; mid: 1=closest planet 2=tallest mountain 3=largest city
fn c3_parse_sup(s:[]u8,mid:*i32,vs:*i32,vl:*i32,fs:*i32,fl:*i32)i32 {
    let ii:i32=c3_index_of(s," is the ",0);
    if(ii<0){return 0;}
    let rest:[]u8=s[ii+8..s.len];
    let m:i32=0;
    if(nio_equal(rest,"closest planet to the sun.")==1){m=1;}
    if(nio_equal(rest,"closest planet to the sun")==1){m=1;}
    if(nio_equal(rest,"tallest mountain in the world.")==1){m=2;}
    if(nio_equal(rest,"tallest mountain in the world")==1){m=2;}
    if(nio_equal(rest,"largest city in the country.")==1){m=3;}
    if(nio_equal(rest,"largest city in the country")==1){m=3;}
    if(m==0){return 0;}
    mid[0]=m;
    vs[0]=0; vl[0]=ii;
    fs[0]=ii; fl[0]=s.len-ii;
    return 1;
}

// 1=FIRE, 0=nofire-or-defer. a,b must be normalize()d.
fn c3_slot_dissent(a:[]u8,b:[]u8)i32 {
    // division of labor: numeric-shaped -> HL-4 C2
    let fa:[]u8=c3_frametok(a);
    let fb:[]u8=c3_frametok(b);
    if(nio_equal(fa,fb)==1 && nio_equal(a,b)==0){return 0;}
    nio_free(fa); nio_free(fb);
    // negation-shaped -> HL-4 C1: " not " -> " " equalizes
    let nn:i32=c3_index_of(a," not ",0);
    if(nn>=0){
        let wo:[]u8=nio_alloc(a.len+1);
        if(wo.len>0){
            let w:i32=0;
            let i:i32=0;
            while(i<a.len){
                if(i==nn){wo[w]=32; w=w+1; i=i+5;}
                else{wo[w]=a[i]; w=w+1; i=i+1;}
            }
            if(nio_equal(wo[0..w],b)==1){nio_free(wo); return 0;}
            nio_free(wo);
        }
    }
    let nn2:i32=c3_index_of(b," not ",0);
    if(nn2>=0){
        let wo2:[]u8=nio_alloc(b.len+1);
        if(wo2.len>0){
            let w2:i32=0;
            let j:i32=0;
            while(j<b.len){
                if(j==nn2){wo2[w2]=32; w2=w2+1; j=j+5;}
                else{wo2[w2]=b[j]; w2=w2+1; j=j+1;}
            }
            if(nio_equal(wo2[0..w2],a)==1){nio_free(wo2); return 0;}
            nio_free(wo2);
        }
    }
    let m1:i32=0; let e1s:i32=0; let e1l:i32=0; let v1s:i32=0; let v1l:i32=0;
    let m2:i32=0; let e2s:i32=0; let e2l:i32=0; let v2s:i32=0; let v2l:i32=0;
    let pm1:*i32=&m1; let pe1s:*i32=&e1s; let pe1l:*i32=&e1l;
    let pv1s:*i32=&v1s; let pv1l:*i32=&v1l;
    let pm2:*i32=&m2; let pe2s:*i32=&e2s; let pe2l:*i32=&e2l;
    let pv2s:*i32=&v2s; let pv2l:*i32=&v2l;
    let p1:i32=c3_parse_of(a,pm1,pe1s,pe1l,pv1s,pv1l);
    let p2:i32=c3_parse_of(b,pm2,pe2s,pe2l,pv2s,pv2l);
    if(p1==1 && p2==1 && m1==m2){
        let ent1:[]u8=a[e1s..e1s+e1l];
        let ent2:[]u8=b[e2s..e2s+e2l];
        let val1:[]u8=c3_strip_dot(a[v1s..v1s+v1l]);
        let val2:[]u8=c3_strip_dot(b[v2s..v2s+v2l]);
        if(nio_equal(ent1,ent2)==1 && nio_equal(val1,val2)==0 && val1.len>0 && val2.len>0){return 1;}
        return 0;
    }
    let s1:i32=0; let w1s:i32=0; let w1l:i32=0; let f1s:i32=0; let f1l:i32=0;
    let s2:i32=0; let w2s:i32=0; let w2l:i32=0; let f2s:i32=0; let f2l:i32=0;
    let ps1:*i32=&s1; let pw1s:*i32=&w1s; let pw1l:*i32=&w1l;
    let pf1s:*i32=&f1s; let pf1l:*i32=&f1l;
    let ps2:*i32=&s2; let pw2s:*i32=&w2s; let pw2l:*i32=&w2l;
    let pf2s:*i32=&f2s; let pf2l:*i32=&f2l;
    let q1:i32=c3_parse_sup(a,ps1,pw1s,pw1l,pf1s,pf1l);
    let q2:i32=c3_parse_sup(b,ps2,pw2s,pw2l,pf2s,pf2l);
    if(q1==1 && q2==1 && s1==s2){
        let val1:[]u8=a[w1s..w1s+w1l];
        let val2:[]u8=b[w2s..w2s+w2l];
        let fr1:[]u8=a[f1s..f1s+f1l];
        let fr2:[]u8=b[f2s..f2s+f2l];
        if(nio_equal(fr1,fr2)==1 && nio_equal(val1,val2)==0 && val1.len>0 && val2.len>0){return 1;}
        return 0;
    }
    return 0;
}

// ================= ch1 =================

fn ch1_in_list(tok:[]u8,list:[]u8)i32 {
    let start:i32=0;
    let i:i32=0;
    while(i<=list.len){
        if(i==list.len || list[i]==124){
            if(i-start==tok.len){
                let k:i32=0;
                let eq:i32=1;
                while(k<tok.len){
                    if(tok[k]!=list[start+k]){eq=0; break;}
                    k=k+1;
                }
                if(eq==1){return 1;}
            }
            start=i+1;
        }
        i=i+1;
    }
    return 0;
}

fn ch1_stopword(w:[]u8)i32 {
    return ch1_in_list(w,"the|a|an|is|are|was|were|be|been|being|of|to|in|on|for|and|or|that|this|these|those|it|its|at|by|as|from|with|what|how|when|where|who|which|do|does|did|can|could|would|should|have|has|had|not|no|than|then|so|such|into|out|up|all|any|each|more|most|other|some|only|over|under|again|once|here|there|their|them|they|we|you|your|his|her|our|my|me|him|us");
}

fn ch1_flipper(w:[]u8)i32 {
    return ch1_in_list(w,"false|hoax|myth|myths|debunked|denied|deny|denies|fake|incorrect|wrong|disproved|fabricated|lie|lies|fraud|scam");
}

fn ch1_is_digit(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    return 0;
}

// word byte: [a-z0-9]; everything else (incl. punctuation) is a separator.
// (Replicates the probe's punctuation->space normalization at word level;
// tier1 normalize() keeps punctuation, so space-split would yield "false.".)
fn ch1_is_wordbyte(c:u8)i32 {
    if(c>=97 && c<=122){return 1;}
    if(c>=48 && c<=57){return 1;}
    return 0;
}

// split normalized sentence into words; store off/len pairs (8B each)
fn ch1_words_of(s:[]u8,tab:[]u8,maxw:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len && n<maxw){
        while(i<s.len && ch1_is_wordbyte(s[i])==0){i=i+1;}
        if(i>=s.len){break;}
        let st:i32=i;
        while(i<s.len && ch1_is_wordbyte(s[i])==1){i=i+1;}
        p32(tab,n*8,st);
        p32(tab,n*8+4,i-st);
        n=n+1;
    }
    return n;
}

fn ch1_word_at(s:[]u8,tab:[]u8,k:i32)[]u8 {
    let st:i32=g32(tab,k*8);
    let ln:i32=g32(tab,k*8+4);
    return s[st..st+ln];
}

// content words: non-stopword, non-pure-number. returns count; ctab gets off/len.
fn ch1_content_words(s:[]u8,wtab:[]u8,nw:i32,ctab:[]u8)i32 {
    let n:i32=0;
    let k:i32=0;
    while(k<nw){
        let w:[]u8=ch1_word_at(s,wtab,k);
        if(ch1_stopword(w)==0){
            let alldig:i32=1;
            let j:i32=0;
            while(j<w.len){if(ch1_is_digit(w[j])==0){alldig=0; break;} j=j+1;}
            if(alldig==0 || w.len==0){
                p32(ctab,n*8,g32(wtab,k*8));
                p32(ctab,n*8+4,g32(wtab,k*8+4));
                n=n+1;
            }
        }
        k=k+1;
    }
    return n;
}

fn ch1_cword_at(s:[]u8,ctab:[]u8,k:i32)[]u8 {
    return ch1_word_at(s,ctab,k);
}

// number of claim content words present in s
fn ch1_shared_cw(s:[]u8,claim:[]u8,ctab:[]u8,nc:i32)i32 {
    let wt:[]u8=nio_alloc(64*8);
    if(wt.len==0){return 0;}
    let nw:i32=ch1_words_of(s,wt,64);
    let ct:[]u8=nio_alloc(64*8);
    if(ct.len==0){nio_free(wt); return 0;}
    let n2:i32=ch1_content_words(s,wt,nw,ct);
    let sh:i32=0;
    let k:i32=0;
    while(k<nc){
        let cw:[]u8=ch1_cword_at(claim,ctab,k);
        let j:i32=0;
        let found:i32=0;
        while(j<n2){
            if(nio_equal(cw,ch1_cword_at(s,ct,j))==1){found=1; break;}
            j=j+1;
        }
        if(found==1){sh=sh+1;}
        k=k+1;
    }
    nio_free(wt);
    nio_free(ct);
    return sh;
}

// whole-word occurrence of w in s (word-level scan; punctuation-proof)
fn ch1_has_word(s:[]u8,w:[]u8)i32 {
    let tab:[]u8=nio_alloc(64*8);
    if(tab.len==0){return 0;}
    let nw:i32=ch1_words_of(s,tab,64);
    let k:i32=0;
    let hit:i32=0;
    while(k<nw){
        if(nio_equal(ch1_word_at(s,tab,k),w)==1){hit=1; break;}
        k=k+1;
    }
    nio_free(tab);
    return hit;
}

// ================= ch2 =================

// 1 if s carries page-furniture markers (whole-word or phrase)
fn ch2_is_furniture(s:[]u8)i32 {
    let w:[]u8=nio_alloc(64*8);
    if(w.len==0){return 0;}
    let nw:i32=ch1_words_of(s,w,64);
    let k:i32=0;
    let hit:i32=0;
    while(k<nw){
        let wd:[]u8=ch1_word_at(s,w,k);
        if(ch1_in_list(wd,"comments|subscribe|cookie|advertisement|newsletter")==1){hit=1; break;}
        k=k+1;
    }
    nio_free(w);
    if(hit==1){return 1;}
    if(bsub(s,"powered by")==1){return 1;}
    if(bsub(s,"sign up")==1){return 1;}
    if(bsub(s,"log in")==1){return 1;}
    if(bsub(s,"share this")==1){return 1;}
    if(bsub(s,"all rights reserved")==1){return 1;}
    return 0;
}

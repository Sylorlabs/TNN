// beyond.zag — LI-HARDEN BEYOND challenger probes (Crew Beyond, 2026-09-24).
// Pure Zag, zero RNG, deterministic. One binary, argv[1] selects mechanism.
// Fixture bundle arrives on stdin:
//   NEED|<need text>
//   U|<pid>|<url>
//   P|<pid>
//   <sentence>
//   ...
// Emits one line: V|<mech>|INSTALL|WITHHOLD|<gate>|<votes>|<hosts>
// Mechanisms:
//   base = probe-baseline: conservative normalization (HL-7 style: strip ASCII
//          controls, punctuation->space, lowercase; keep all bytes >=128 as
//          significant so zero-width stays distinct), exact-sentence claim
//          clustering, HL-4-lite contradiction (explicit negation + numeric
//          conflict on equal skeleton), quorum >=2 pages + >=2 hosts.
//   ch1  = base + assertion-polarity gate (challenger to HL-4): a page that
//          mentions the claim under a polarity flipper ("false","hoax",...)
//          or an antonym predicate does not merely fail to vote — it VETOES.
//   ch2  = base + furniture-chrome discount (challenger to HL-6): page-furniture
//          sentences (comments/powered-by/...) repeated across >=2 hosts mark
//          the page's vote as chrome-packaged; discounted votes break quorum.
//   ch2b = base + NAIVE shared-sentence collapse (negative control): any
//          non-claim sentence shared across >=2 hosts discounts votes.
//          Expected to regress H8 (wire truth) — documents why naive dedup fails.
//   ch3  = base + informativeness gate (expected NEGATIVE): the installed claim
//          must add >=1 content word beyond the need. Expected to kill
//          X_HIGHDF1 but regress H10 — probes the boundary of the principle.
//   ch4  = base + scope-uniformity gate: all voting sentences must carry the
//          same scope qualifiers; scoped/unscoped mixes withhold (SCOPE_MIX).
@import("R33_NATIVE_IO_V1.zag")

// ---------- helpers ----------
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}
fn p32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn beq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
// substring: 1 if n occurs in h
fn bsub(h:[]u8,n:[]u8)i32 {
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let j:i32=0;
        while(j<n.len){if(h[i+j]!=n[j]){break;}j=j+1;}
        if(j==n.len){return 1;}
        i=i+1;
    }
    return 0;
}
// lexicographic compare: -1,0,1
fn bcmp(a:[]u8,b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){n=b.len;}
    let i:i32=0;
    while(i<n){
        if(a[i]<b[i]){return -1;}
        if(a[i]>b[i]){return 1;}
        i=i+1;
    }
    if(a.len<b.len){return -1;}
    if(a.len>b.len){return 1;}
    return 0;
}
fn is_punct(c:u8)i32 {
    if(c==46||c==44||c==33||c==63||c==59||c==58||c==39||c==34){return 1;}
    if(c==40||c==41||c==91||c==93||c==123||c==125){return 1;}
    if(c==45||c==95||c==47||c==92||c==124||c==64||c==35){return 1;}
    if(c==36||c==37||c==94||c==38||c==42||c==43||c==61||c==126){return 1;}
    if(c==96||c==60||c==62){return 1;}
    return 0;
}
fn is_digit(c:u8)i32 {
    if(c>=48&&c<=57){return 1;}
    return 0;
}
// normalize: lowercase ASCII, punct->space, drop ASCII controls,
// keep bytes>=128 significant; collapse spaces; pad with one space each end.
fn normalize(s:[]u8,out:[]u8)i32 {
    let w:i32=1;
    out[0]=32;
    let i:i32=0;
    let last_sp:i32=1;
    while(i<s.len){
        let c:u8=s[i];
        if(c<32){
            i=i+1;
            continue;
        }
        if(c==39){
            // n't contraction -> " not " (keeps negation visible to detectors)
            if(w>1&&out[w-1]==110&&i+1<s.len&&s[i+1]==116){
                let a2:i32=i+2;
                let boundary:i32=0;
                if(a2>=s.len){boundary=1;}
                else{
                    let nc:u8=s[a2];
                    if(nc==32||nc<32||is_punct(nc)==1){boundary=1;}
                }
                if(boundary==1){
                    out[w-1]=32;
                    out[w]=110;out[w+1]=111;out[w+2]=116;
                    w=w+3;last_sp=0;
                    i=i+2;
                    continue;
                }
            }
            if(last_sp==0){out[w]=32;w=w+1;last_sp=1;}
            i=i+1;
            continue;
        }
        if(is_punct(c)==1){
            if(last_sp==0){out[w]=32;w=w+1;last_sp=1;}
            i=i+1;
            continue;
        }
        if(c==32){
            if(last_sp==0){out[w]=32;w=w+1;last_sp=1;}
            i=i+1;
            continue;
        }
        if(c>=65&&c<=90){out[w]=c+32;}
        else{out[w]=c;}
        w=w+1;last_sp=0;
        i=i+1;
    }
    if(last_sp==0){out[w]=32;w=w+1;}
    return w;
}
fn read_stdin(b:[]u8)i32 {
    let at:i32=0;
    while(at<b.len){
        let n:i64=_zag_raw_syscall(0,0,(_zag_slice_ptr(b) as i64)+(at as i64),(b.len-at) as i64,0,0,0);
        if(n<=0){break;}
        at=(at as i64+n) as i32;
    }
    return at;
}
// pipe-separated list membership, whole-token match
fn in_list(tok:[]u8,list:[]u8)i32 {
    let i:i32=0;
    let start:i32=0;
    while(i<list.len){
        if(list[i]==124){
            let piece:[]u8=list[start..i];
            if(beq(tok,piece)==1){return 1;}
            start=i+1;
        }
        i=i+1;
    }
    if(beq(tok,list[start..list.len])==1){return 1;}
    return 0;
}
fn stopword(w:[]u8)i32 {
    return in_list(w,"the|a|an|is|are|was|were|be|been|being|of|to|in|on|for|and|or|that|this|these|those|it|its|at|by|as|from|with|what|how|when|where|who|which|do|does|did|can|could|would|should|have|has|had|not|no|than|then|so|such|into|out|up|all|any|each|more|most|other|some|only|over|under|again|once|here|there|their|them|they|we|you|your|his|her|our|my|me|him|us|the");
}
fn flipper(w:[]u8)i32 {
    return in_list(w,"false|hoax|myth|myths|debunked|denied|deny|denies|fake|incorrect|wrong|disproved|fabricated|lie|lies|fraud|scam");
}
// words_of: split padded normalized sentence into words; store off/len pairs
// (8 bytes each) into tab; returns word count. Words are slices of s.
fn words_of(s:[]u8,tab:[]u8,maxw:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len&&n<maxw){
        while(i<s.len&&s[i]==32){i=i+1;}
        if(i>=s.len){break;}
        let st:i32=i;
        while(i<s.len&&s[i]!=32){i=i+1;}
        p32(tab,n*8,st);
        p32(tab,n*8+4,i-st);
        n=n+1;
    }
    return n;
}
// word count without a table
fn wcount(s:[]u8)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len){
        while(i<s.len&&s[i]==32){i=i+1;}
        if(i>=s.len){break;}
        n=n+1;
        while(i<s.len&&s[i]!=32){i=i+1;}
    }
    return n;
}
fn word_at(s:[]u8,tab:[]u8,k:i32)[]u8 {
    let st:i32=g32(tab,k*8);
    let ln:i32=g32(tab,k*8+4);
    return s[st..st+ln];
}
// content words: non-stopword, non-pure-number words. Returns count; tab2 gets off/len.
fn content_words(s:[]u8,wtab:[]u8,nw:i32,ctab:[]u8)i32 {
    let n:i32=0;
    let k:i32=0;
    while(k<nw){
        let w:[]u8=word_at(s,wtab,k);
        if(stopword(w)==0){
            let alldig:i32=1;
            let j:i32=0;
            while(j<w.len){if(is_digit(w[j])==0){alldig=0;break;}j=j+1;}
            if(alldig==0||w.len==0){
                p32(ctab,n*8,g32(wtab,k*8));
                p32(ctab,n*8+4,g32(wtab,k*8+4));
                n=n+1;
            }
        }
        k=k+1;
    }
    return n;
}
fn cword_at(s:[]u8,ctab:[]u8,k:i32)[]u8 {
    let st:i32=g32(ctab,k*8);
    let ln:i32=g32(ctab,k*8+4);
    return s[st..st+ln];
}
// shared content words between claim (ctab/nc) and sentence s
fn shared_cw(s:[]u8,claim:[]u8,ctab:[]u8,nc:i32) i32 {
    let wt:[]u8=nio_alloc(64*8);
    let nw:i32=words_of(s,wt,64);
    let ct:[]u8=nio_alloc(64*8);
    let n2:i32=content_words(s,wt,nw,ct);
    let sh:i32=0;
    let k:i32=0;
    while(k<nc){
        let cw:[]u8=cword_at(claim,ctab,k);
        let j:i32=0;
        let found:i32=0;
        while(j<n2){
            if(beq(cw,cword_at(s,ct,j))==1){found=1;break;}
            j=j+1;
        }
        if(found==1){sh=sh+1;}
        k=k+1;
    }
    nio_free(wt);
    nio_free(ct);
    return sh;
}
// whole-word substring: " w " inside padded sentence
fn has_word(s:[]u8,w:[]u8) i32 {
    let pat:[]u8=nio_alloc(w.len+2);
    pat[0]=32;
    let i:i32=0;
    while(i<w.len){pat[1+i]=w[i];i=i+1;}
    pat[w.len+1]=32;
    let r:i32=bsub(s,pat);
    nio_free(pat);
    return r;
}
fn nums_of(s:[]u8,tab:[]u8,maxn:i32) i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len&&n<maxn){
        while(i<s.len&&(is_digit(s[i])==0)){i=i+1;}
        if(i>=s.len){break;}
        let v:i32=0;
        while(i<s.len&&is_digit(s[i])==1){v=v*10+((s[i]-48) as i32);i=i+1;}
        p32(tab,n*4,v);
        n=n+1;
    }
    return n;
}
// skeleton: content words excluding pure numbers, in order; equal skeletons?
fn skeleton_eq(a:[]u8,b:[]u8) i32 {
    let wa:[]u8=nio_alloc(64*8);
    let wb:[]u8=nio_alloc(64*8);
    let ca:[]u8=nio_alloc(64*8);
    let cb:[]u8=nio_alloc(64*8);
    let na:i32=words_of(a,wa,64);
    let nb:i32=words_of(b,wb,64);
    let nca:i32=content_words(a,wa,na,ca);
    let ncb:i32=content_words(b,wb,nb,cb);
    // content_words already excludes pure numbers
    let r:i32=1;
    if(nca!=ncb){r=0;}
    else{
        let k:i32=0;
        while(k<nca){
            if(beq(cword_at(a,ca,k),cword_at(b,cb,k))==0){r=0;break;}
            k=k+1;
        }
    }
    nio_free(wa);nio_free(wb);nio_free(ca);nio_free(cb);
    return r;
}
fn nums_eq(a:[]u8,b:[]u8) i32 {
    let ta:[]u8=nio_alloc(16*4);
    let tb:[]u8=nio_alloc(16*4);
    let na:i32=nums_of(a,ta,16);
    let nb:i32=nums_of(b,tb,16);
    let r:i32=1;
    if(na!=nb){r=0;}
    else{
        let k:i32=0;
        while(k<na){
            if(g32(ta,k*4)!=g32(tb,k*4)){r=0;break;}
            k=k+1;
        }
    }
    nio_free(ta);nio_free(tb);
    return r;
}
fn has_num(s:[]u8) i32 {
    let i:i32=0;
    while(i<s.len){if(is_digit(s[i])==1){return 1;}i=i+1;}
    return 0;
}

// ---------- storage ----------
// pages: ptbl per page: pid_off,pid_len,url_off,url_len,host_off,host_len (24B)
// sentences: stbl per sent: page_idx, norm_off, norm_len (12B)
fn host_of(url:[]u8,out:[]u8)i32 {
    let i:i32=0;
    let st:i32=0;
    while(i+2<url.len){
        if(url[i]==58&&url[i+1]==47&&url[i+2]==47){st=i+3;break;}
        i=i+1;
    }
    let e:i32=st;
    while(e<url.len&&url[e]!=47){e=e+1;}
    let k:i32=0;
    while(st+k<e){out[k]=url[st+k];k=k+1;}
    return k;
}
fn parse_line_kind(line:[]u8)i32 {
    // 1=NEED 2=U 3=P 4=M 5=ARCH 6=REG 7=SENT 0=sentence
    if(line.len>=5&&line[0]==78&&line[1]==69&&line[2]==69&&line[3]==68&&line[4]==124){return 1;}
    if(line.len>=5&&line[0]==65&&line[1]==82&&line[2]==67&&line[3]==72&&line[4]==124){return 5;}
    if(line.len>=5&&line[0]==83&&line[1]==69&&line[2]==78&&line[3]==84&&line[4]==124){return 7;}
    if(line.len>=4&&line[0]==82&&line[1]==69&&line[2]==71&&line[3]==124){return 6;}
    if(line.len>=2&&line[0]==85&&line[1]==124){return 2;}
    if(line.len>=2&&line[0]==77&&line[1]==124){return 4;}
    if(line.len>=2&&line[0]==80&&line[1]==124){return 3;}
    return 0;
}
// ---- beyond-round-2 helpers ----
fn bsub_at(h:[]u8,n:[]u8)i32 {
    if(n.len==0||n.len>h.len){return -1;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let j:i32=0;
        while(j<n.len){if(h[i+j]!=n[j]){break;}j=j+1;}
        if(j==n.len){return i;}
        i=i+1;
    }
    return -1;
}
fn trim_sp(s:[]u8)[]u8 {
    let a:i32=0;
    let b:i32=s.len;
    while(a<b&&s[a]==32){a=a+1;}
    while(b>a&&s[b-1]==32){b=b-1;}
    return s[a..b];
}
fn atoi(s:[]u8)i32 {
    let v:i32=0;
    let i:i32=0;
    while(i<s.len&&s[i]>=48&&s[i]<=57){v=v*10+((s[i]-48) as i32);i=i+1;}
    return v;
}
// tparse: closed-class template slot parsing.
// Returns slot length (>0) on match, -1 otherwise.
// Template bytes written to tout, template length stored via p32(tout,1000,len);
// slot bytes written to sout, slot length is the return value.
fn tparse(claim:[]u8,tout:[]u8,sout:[]u8)i32 {
    let p1:[]u8=" is the capital of ";
    let at:i32=bsub_at(claim,p1);
    if(at>=0){
        let before:[]u8=trim_sp(claim[0..at]);
        let after:[]u8=trim_sp(claim[at+p1.len..claim.len]);
        let pre:[]u8="capital of ";
        let i:i32=0;
        while(i<pre.len){tout[i]=pre[i];i=i+1;}
        let j:i32=0;
        while(j<after.len){tout[i+j]=after[j];j=j+1;}
        p32(tout,1000,i+j);
        let k2:i32=0;
        while(k2<before.len){sout[k2]=before[k2];k2=k2+1;}
        return k2;
    }
    // form 2: "the capital of Y is X"
    let p1b:[]u8=" the capital of ";
    if(bsub_at(claim,p1b)==0){
        let rest:[]u8=claim[p1b.len..claim.len];
        let isat:i32=bsub_at(rest," is ");
        if(isat>0){
            let ypart:[]u8=trim_sp(rest[0..isat]);
            let xpart:[]u8=trim_sp(rest[isat+4..rest.len]);
            let preb:[]u8="capital of ";
            let i3:i32=0;
            while(i3<preb.len){tout[i3]=preb[i3];i3=i3+1;}
            let j3:i32=0;
            while(j3<ypart.len){tout[i3+j3]=ypart[j3];j3=j3+1;}
            p32(tout,1000,i3+j3);
            let k4:i32=0;
            while(k4<xpart.len){sout[k4]=xpart[k4];k4=k4+1;}
            return k4;
        }
    }
    let p2:[]u8=" is the closest planet to ";
    let at2:i32=bsub_at(claim,p2);
    if(at2>=0){
        let before2:[]u8=trim_sp(claim[0..at2]);
        let after2:[]u8=trim_sp(claim[at2+p2.len..claim.len]);
        let pre2:[]u8="closest planet to ";
        let i2:i32=0;
        while(i2<pre2.len){tout[i2]=pre2[i2];i2=i2+1;}
        let j2:i32=0;
        while(j2<after2.len){tout[i2+j2]=after2[j2];j2=j2+1;}
        p32(tout,1000,i2+j2);
        let k3:i32=0;
        while(k3<before2.len){sout[k3]=before2[k3];k3=k3+1;}
        return k3;
    }
    return -1;
}
fn kv_get(piece:[]u8,key:[]u8)[]u8 {
    let i:i32=0;
    while(i<piece.len){if(piece[i]==61){break;}i=i+1;}
    if(i>=piece.len){return "";}
    if(beq(piece[0..i],key)==1){return piece[i+1..piece.len];}
    return "";
}
// per-page metadata lookup: mget(page_idx,key)
fn mget(pg:i32,key:[]u8,metatbl:[]u8,arena:[]u8)[]u8 {
    let mo:i32=g32(metatbl,pg*8);
    let ml:i32=g32(metatbl,pg*8+4);
    if(ml==0){return "";}
    let raw:[]u8=arena[mo..mo+ml];
    let i:i32=0;
    let st:i32=0;
    while(i<raw.len){
        if(raw[i]==124){
            let v:[]u8=kv_get(raw[st..i],key);
            if(v.len>0){return v;}
            st=i+1;
        }
        i=i+1;
    }
    return kv_get(raw[st..raw.len],key);
}
fn email_apex(v:[]u8,out:[]u8)i32 {
    let i:i32=0;
    let at:i32=-1;
    while(i<v.len){if(v[i]==64){at=i;}i=i+1;}
    if(at<0){return 0;}
    let k:i32=0;
    while(at+1+k<v.len){out[k]=v[at+1+k];k=k+1;}
    return k;
}
fn wl_ns(v:[]u8)i32 {
    if(bsub(v,"cloudflare")==1){return 1;}
    if(bsub(v,"awsdns")==1){return 1;}
    if(bsub(v,"amazonaws")==1){return 1;}
    if(bsub(v,"google")==1){return 1;}
    if(bsub(v,"azure-dns")==1){return 1;}
    if(bsub(v,"dnsimple")==1){return 1;}
    return 0;
}
fn wl_email(v:[]u8)i32 {
    if(bsub(v,"gmail")==1){return 1;}
    if(bsub(v,"outlook")==1){return 1;}
    if(bsub(v,"hotmail")==1){return 1;}
    if(bsub(v,"yahoo")==1){return 1;}
    if(bsub(v,"privacy")==1){return 1;}
    if(bsub(v,"whoisguard")==1){return 1;}
    return 0;
}
fn wl_cms(v:[]u8)i32 {
    if(bsub(v,"wordpress.com")==1){return 1;}
    if(bsub(v,"medium")==1){return 1;}
    if(bsub(v,"substack")==1){return 1;}
    if(bsub(v,"blogspot")==1){return 1;}
    return 0;
}
// lowercase copy into tmp (tmp must be >= s.len)
fn lower_copy(s:[]u8,tmp:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=65&&c<=90){c=c+32;}
        tmp[i]=c;
        i=i+1;
    }
    return s.len;
}
// feat_shared: 1 iff all voters (votemask bits) have non-empty equal meta values.
// Shared value copied to out; returns its length, 0 if not shared.
fn feat_shared(votemask:i32,npages:i32,ptbl:[]u8,key:[]u8,metatbl:[]u8,arena:[]u8,out:[]u8)i32 {
    let first:i32=1;
    let v0:[]u8="";
    let p:i32=0;
    while(p<npages){
        if((votemask&(1<<p))!=0){
            let v:[]u8=mget(p,key,metatbl,arena);
            if(v.len==0){return 0;}
            if(first==1){v0=v;first=0;}
            else{if(beq(v,v0)==0){return 0;}}
        }
        p=p+1;
    }
    if(first==1){return 0;}
    let k:i32=0;
    while(k<v0.len){out[k]=v0[k];k=k+1;}
    return k;
}
fn split2(line:[]u8,sep:u8,a:[]u8,b:[]u8)i32 {
    // find sep; a=before, b=after; returns 1 if found
    let i:i32=0;
    while(i<line.len){if(line[i]==sep){break;}i=i+1;}
    if(i>=line.len){return 0;}
    let j:i32=0;
    while(j<i){a[j]=line[j];j=j+1;}
    let k:i32=0;
    while(i+1+k<line.len){b[k]=line[i+1+k];k=k+1;}
    p32(a,1020,j);
    p32(b,1020,k);
    return 1;
}
// scope words
fn scopeword(w:[]u8)i32 {
    return in_list(w,"sunday|monday|tuesday|wednesday|thursday|friday|saturday|sundays|mondays|tuesdays|wednesdays|thursdays|fridays|saturdays|january|february|march|april|may|june|july|august|september|october|november|december|today|tomorrow|yesterday");
}
fn main()i32 {
    let mecha0:[]u8=_zag_arg(1);
    let mecha:[]u8=mecha0;
    if(mecha.len>0&&mecha[mecha.len-1]==10){mecha=mecha[0..mecha.len-1];}
    if(mecha.len>0&&mecha[mecha.len-1]==13){mecha=mecha[0..mecha.len-1];}
    let inb:[]u8=nio_alloc(1048576);
    let inlen:i32=read_stdin(inb);
    let arena:[]u8=nio_alloc(262144);
    let apos:i32=0;
    let ptbl:[]u8=nio_alloc(16*24);
    let stbl:[]u8=nio_alloc(384*12);
    let npages:i32=0;
    let nsent:i32=0;
    let need_off:i32=0;
    let need_len:i32=0;
    let nbuf:[]u8=nio_alloc(2048);
    let tmp:[]u8=nio_alloc(2048);
    let tmp2:[]u8=nio_alloc(2048);
    // parse lines
    let pos:i32=0;
    let curpage:i32=-1;
    // url table: parallel small arrays via arena: upid_off/upid_len/uurl_off/uurl_len
    let utbl:[]u8=nio_alloc(16*16);
    let nurl:i32=0;
    // round-2 tables: per-page meta, archive pins, registry, archived sentences
    let metatbl:[]u8=nio_alloc(16*8);
    let archtbl:[]u8=nio_alloc(32*24);
    let narch:i32=0;
    let regtbl:[]u8=nio_alloc(16*20);
    let nreg:i32=0;
    let senttbl:[]u8=nio_alloc(16*8);
    let nsentarch:i32=0;
    let tout:[]u8=nio_alloc(1024);
    let sout:[]u8=nio_alloc(1024);
    while(pos<inlen){
        let eol:i32=pos;
        while(eol<inlen&&inb[eol]!=10){eol=eol+1;}
        let line:[]u8=inb[pos..eol];
        // strip trailing \r
        if(line.len>0&&line[line.len-1]==13){line=line[0..line.len-1];}
        let k:i32=parse_line_kind(line);
        if(k==1){
            need_off=apos;
            need_len=line.len-5;
            let q:i32=0;
            while(q<need_len){arena[apos+q]=line[5+q];q=q+1;}
            apos=apos+need_len;
        } else {
            if(k==2){
                // U|pid|url
                let rest:[]u8=line[2..line.len];
                if(split2(rest,124,tmp,tmp2)==1){
                    let pl:i32=g32(tmp,1020);
                    let ul:i32=g32(tmp2,1020);
                    p32(utbl,nurl*16,apos);
                    p32(utbl,nurl*16+4,pl);
                    let q2:i32=0;
                    while(q2<pl){arena[apos+q2]=tmp[q2];q2=q2+1;}
                    apos=apos+pl;
                    p32(utbl,nurl*16+8,apos);
                    p32(utbl,nurl*16+12,ul);
                    q2=0;
                    while(q2<ul){arena[apos+q2]=tmp2[q2];q2=q2+1;}
                    apos=apos+ul;
                    nurl=nurl+1;
                }
            } else {
                if(k==3){
                    let pid:[]u8=line[2..line.len];
                    p32(ptbl,npages*24,apos);
                    p32(ptbl,npages*24+4,pid.len);
                    let q3:i32=0;
                    while(q3<pid.len){arena[apos+q3]=pid[q3];q3=q3+1;}
                    apos=apos+pid.len;
                    // url/host filled after parse (lookup by pid)
                    p32(ptbl,npages*24+8,0);
                    p32(ptbl,npages*24+12,0);
                    p32(ptbl,npages*24+16,0);
                    p32(ptbl,npages*24+20,0);
                    curpage=npages;
                    npages=npages+1;
                } else {
                    if(k==4){
                        // M|pid|k=v|k2=v2...
                        let mrest:[]u8=line[2..line.len];
                        if(split2(mrest,124,tmp,tmp2)==1){
                            let mpl:i32=g32(tmp,1020);
                            let mrl:i32=g32(tmp2,1020);
                            let mp:i32=0;
                            let found:i32=-1;
                            while(mp<npages){
                                let ppo:i32=g32(ptbl,mp*24);
                                let ppl:i32=g32(ptbl,mp*24+4);
                                if(beq(arena[ppo..ppo+ppl],tmp[0..mpl])==1){found=mp;}
                                mp=mp+1;
                            }
                            if(found>=0){
                                p32(metatbl,found*8,apos);
                                p32(metatbl,found*8+4,mrl);
                                let mq:i32=0;
                                while(mq<mrl){arena[apos+mq]=tmp2[mq];mq=mq+1;}
                                apos=apos+mrl;
                            }
                        }
                    } else {
                        if(k==5){
                            // ARCH|template|filler|era|domains
                            let ar:[]u8=line[5..line.len];
                            let i1:i32=0;
                            while(i1<ar.len&&ar[i1]!=124){i1=i1+1;}
                            let i2:i32=i1+1;
                            while(i2<ar.len&&ar[i2]!=124){i2=i2+1;}
                            let i3:i32=i2+1;
                            while(i3<ar.len&&ar[i3]!=124){i3=i3+1;}
                            if(i1<ar.len&&i2<ar.len&&i3<ar.len&&narch<32){
                                let t0:[]u8=ar[0..i1];
                                let f0:[]u8=ar[i1+1..i2];
                                let e0:[]u8=ar[i2+1..i3];
                                let d0:[]u8=ar[i3+1..ar.len];
                                p32(archtbl,narch*24,apos);
                                p32(archtbl,narch*24+4,t0.len);
                                let aq:i32=0;
                                while(aq<t0.len){arena[apos+aq]=t0[aq];aq=aq+1;}
                                apos=apos+t0.len;
                                p32(archtbl,narch*24+8,apos);
                                p32(archtbl,narch*24+12,f0.len);
                                aq=0;
                                while(aq<f0.len){arena[apos+aq]=f0[aq];aq=aq+1;}
                                apos=apos+f0.len;
                                p32(archtbl,narch*24+16,atoi(e0));
                                p32(archtbl,narch*24+20,atoi(d0));
                                narch=narch+1;
                            }
                        } else {
                            if(k==6){
                                // REG|template|filler|valid_from
                                let rg:[]u8=line[4..line.len];
                                let r1:i32=0;
                                while(r1<rg.len&&rg[r1]!=124){r1=r1+1;}
                                let r2:i32=r1+1;
                                while(r2<rg.len&&rg[r2]!=124){r2=r2+1;}
                                if(r1<rg.len&&r2<rg.len&&nreg<16){
                                    let rt:[]u8=rg[0..r1];
                                    let rf:[]u8=rg[r1+1..r2];
                                    let rv:[]u8=rg[r2+1..rg.len];
                                    p32(regtbl,nreg*20,apos);
                                    p32(regtbl,nreg*20+4,rt.len);
                                    let rq:i32=0;
                                    while(rq<rt.len){arena[apos+rq]=rt[rq];rq=rq+1;}
                                    apos=apos+rt.len;
                                    p32(regtbl,nreg*20+8,apos);
                                    p32(regtbl,nreg*20+12,rf.len);
                                    rq=0;
                                    while(rq<rf.len){arena[apos+rq]=rf[rq];rq=rq+1;}
                                    apos=apos+rf.len;
                                    p32(regtbl,nreg*20+16,atoi(rv));
                                    nreg=nreg+1;
                                }
                            } else {
                                if(k==7){
                                    // SENT|<pre-attack archived sentence>
                                    let snl:i32=normalize(line[5..line.len],nbuf);
                                    if(snl>2&&nsentarch<16){
                                        p32(senttbl,nsentarch*8,apos);
                                        p32(senttbl,nsentarch*8+4,snl);
                                        let sq:i32=0;
                                        while(sq<snl){arena[apos+sq]=nbuf[sq];sq=sq+1;}
                                        apos=apos+snl;
                                        nsentarch=nsentarch+1;
                                    }
                                } else {
                                    if(line.len>0&&curpage>=0&&nsent<384){
                                        let nl:i32=normalize(line,nbuf);
                                        if(nl>2){
                                        p32(stbl,nsent*12,curpage);
                                        p32(stbl,nsent*12+4,apos);
                                        p32(stbl,nsent*12+8,nl);
                                        let q4:i32=0;
                                        while(q4<nl){arena[apos+q4]=nbuf[q4];q4=q4+1;}
                                        apos=apos+nl;
                                        nsent=nsent+1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        pos=eol+1;
    }
    // attach urls+hosts to pages by pid
    let pi:i32=0;
    while(pi<npages){
        let po:i32=g32(ptbl,pi*24);
        let pl2:i32=g32(ptbl,pi*24+4);
        let pid:[]u8=arena[po..po+pl2];
        let u:i32=0;
        while(u<nurl){
            let uo:i32=g32(utbl,u*16);
            let ul2:i32=g32(utbl,u*16+4);
            if(beq(pid,arena[uo..uo+ul2])==1){
                let vo:i32=g32(utbl,u*16+8);
                let vl:i32=g32(utbl,u*16+12);
                p32(ptbl,pi*24+8,vo);
                p32(ptbl,pi*24+12,vl);
                let hl:i32=host_of(arena[vo..vo+vl],tmp);
                p32(ptbl,pi*24+16,apos);
                p32(ptbl,pi*24+20,hl);
                let q5:i32=0;
                while(q5<hl){arena[apos+q5]=tmp[q5];q5=q5+1;}
                apos=apos+hl;
                break;
            }
            u=u+1;
        }
        pi=pi+1;
    }
    let need:[]u8=arena[need_off..need_off+need_len];
    // need content words (normalized)
    let nnl:i32=normalize(need,nbuf);
    let needn:[]u8=nbuf[0..nnl];
    let nwt:[]u8=nio_alloc(64*8);
    let nnw:i32=words_of(needn,nwt,64);
    let nct:[]u8=nio_alloc(64*8);
    let nnc:i32=content_words(needn,nwt,nnw,nct);
    // claim selection: max (pagecount, need-overlap), tie -> lexicographic min
    let best:i32=-1;
    let bestc:i32=-1;
    let besto:i32=-1;
    let si:i32=0;
    while(si<nsent){
        let so:i32=g32(stbl,si*12+4);
        let sl:i32=g32(stbl,si*12+8);
        let s:[]u8=arena[so..so+sl];
        // dedupe: seen before?
        let seen:i32=0;
        let j:i32=0;
        while(j<si){
            let jo:i32=g32(stbl,j*12+4);
            let jl:i32=g32(stbl,j*12+8);
            if(beq(s,arena[jo..jo+jl])==1){seen=1;break;}
            j=j+1;
        }
        if(seen==0){
            // pagecount
            let pc:i32=0;
            let lastpg:i32=-1;
            let k2:i32=0;
            while(k2<nsent){
                let ko:i32=g32(stbl,k2*12+4);
                let kl:i32=g32(stbl,k2*12+8);
                if(beq(s,arena[ko..ko+kl])==1){
                    let pg:i32=g32(stbl,k2*12);
                    if(pg!=lastpg){pc=pc+1;lastpg=pg;}
                }
                k2=k2+1;
            }
            let ov:i32=shared_cw(s,needn,nct,nnc);
            // note: shared_cw(s, needn, nct, nnc) counts need content words present in s
            let take:i32=0;
            if(pc>bestc){take=1;}
            else{
                if(pc==bestc){
                    if(ov>besto){take=1;}
                    else{
                        if(ov==besto&&best>=0){
                            let bo:i32=g32(stbl,best*12+4);
                            let bl:i32=g32(stbl,best*12+8);
                            if(bcmp(s,arena[bo..bo+bl])<0){take=1;}
                        }
                    }
                }
            }
            if(take==1){best=si;bestc=pc;besto=ov;}
        }
        si=si+1;
    }
    let gate:[]u8="NONE";
    let verdict:i32=0; // 0 withhold, 1 install
    let nvotes:i32=0;
    let nhost:i32=0;
    if(best<0){
        gate="QUORUM";
    } else {
        let bo2:i32=g32(stbl,best*12+4);
        let bl2:i32=g32(stbl,best*12+8);
        let claim:[]u8=arena[bo2..bo2+bl2];
        // claim content words
        let cwt:[]u8=nio_alloc(64*8);
        let cnw:i32=words_of(claim,cwt,64);
        let cct:[]u8=nio_alloc(64*8);
        let cnc:i32=content_words(claim,cwt,cnw,cct);
        // votes: pages containing claim
        let votemask:i32=0;
        let vi:i32=0;
        while(vi<nsent){
            let vo2:i32=g32(stbl,vi*12+4);
            let vl2:i32=g32(stbl,vi*12+8);
            if(beq(claim,arena[vo2..vo2+vl2])==1){
                let pg2:i32=g32(stbl,vi*12);
                votemask=votemask|(1<<pg2);
            }
            vi=vi+1;
        }
        // distinct hosts among voters (length-aware compare; beq needs equal lens)
        let hostseen:[]u8=nio_alloc(16*64);
        let hseel:[]u8=nio_alloc(16*4);
        nvotes=0;
        nhost=0;
        let p3:i32=0;
        while(p3<npages){
            if((votemask&(1<<p3))!=0){
                nvotes=nvotes+1;
                let ho:i32=g32(ptbl,p3*24+16);
                let hl3:i32=g32(ptbl,p3*24+20);
                let h:[]u8=arena[ho..ho+hl3];
                let f2:i32=0;
                let q6:i32=0;
                while(q6<nhost){
                    let el6:i32=g32(hseel,q6*4);
                    if(el6==h.len&&beq(h,hostseen[q6*64..q6*64+el6])==1){f2=1;break;}
                    q6=q6+1;
                }
                if(f2==0){
                    let q7:i32=0;
                    while(q7<h.len){hostseen[nhost*64+q7]=h[q7];q7=q7+1;}
                    p32(hseel,nhost*4,h.len);
                    nhost=nhost+1;
                }
            }
            p3=p3+1;
        }
        nio_free(hostseen);nio_free(hseel);
        // ---- base contradiction scan ----
        let contra:i32=0;
        let rivalo:i32=0;
        let rivall:i32=0;
        let ci:i32=0;
        while(ci<nsent&&contra==0){
            let co:i32=g32(stbl,ci*12+4);
            let cl:i32=g32(stbl,ci*12+8);
            let s2:[]u8=arena[co..co+cl];
            if(beq(s2,claim)==0){
                let sh2:i32=shared_cw(s2,claim,cct,cnc);
                if(sh2>=2){
                    if(has_word(s2,"not")==1||bsub(s2,"n't")==1||has_word(s2,"never")==1||has_word(s2,"no")==1){
                        contra=1;
                        rivalo=co;rivall=cl;
                    }
                }
                if(contra==0&&has_num(claim)==1&&has_num(s2)==1){
                    if(skeleton_eq(claim,s2)==1&&nums_eq(claim,s2)==0){
                        contra=1;
                        rivalo=co;rivall=cl;
                    }
                }
            }
            ci=ci+1;
        }
        // ---- round-2 mech dispatch ----
        let is_g1:i32=0;let is_g6:i32=0;let is_g7:i32=0;let is_g4:i32=0;let is_g9:i32=0;
        let is_w11:i32=0;let is_w12:i32=0;let is_w3:i32=0;let is_w6:i32=0;
        if(beq(mecha,"g1")==1){is_g1=1;}
        if(beq(mecha,"g6")==1){is_g6=1;}
        if(beq(mecha,"g7")==1){is_g7=1;}
        if(beq(mecha,"g4")==1){is_g4=1;}
        if(beq(mecha,"g9")==1){is_g9=1;}
        if(beq(mecha,"w11")==1){is_w11=1;}
        if(beq(mecha,"w12")==1){is_w12=1;}
        if(beq(mecha,"w3")==1){is_w3=1;}
        if(beq(mecha,"w6")==1){is_w6=1;}
        // closed-class template parse (shared by g1/g6/g9)
        let tmpl_ok:i32=0;
        let tlen:i32=0;
        let slen:i32=0;
        if(is_g1==1||is_g6==1||is_g9==1){
            let sret:i32=tparse(claim,tout,sout);
            if(sret>0){slen=sret;tlen=g32(tout,1000);tmpl_ok=1;}
        }
        // grok-1: archived rival-filler precedence (veto-only pre-filter)
        if(is_g1==1&&tmpl_ok==1&&beq(gate,"NONE")==1){
            let tmpl:[]u8=tout[0..tlen];
            let slot:[]u8=sout[0..slen];
            let maxera:i32=-1;
            let ea:i32=0;
            while(ea<narch){
                let eto:i32=g32(archtbl,ea*24);
                let etl:i32=g32(archtbl,ea*24+4);
                let eer:i32=g32(archtbl,ea*24+16);
                if(beq(arena[eto..eto+etl],tmpl)==1){if(eer>maxera){maxera=eer;}}
                ea=ea+1;
            }
            if(maxera>=0){
                let t1d:i32=-1;let t1o:i32=0;let t1l:i32=0;let t2d:i32=-1;
                let eb:i32=0;
                while(eb<narch){
                    let eo2:i32=g32(archtbl,eb*24);
                    let el2:i32=g32(archtbl,eb*24+4);
                    let fo2:i32=g32(archtbl,eb*24+8);
                    let fl2:i32=g32(archtbl,eb*24+12);
                    let er2:i32=g32(archtbl,eb*24+16);
                    let dm2:i32=g32(archtbl,eb*24+20);
                    if(er2==maxera&&beq(arena[eo2..eo2+el2],tmpl)==1){
                        if(dm2>t1d){t2d=t1d;t1d=dm2;t1o=fo2;t1l=fl2;}
                        else{if(dm2>t2d){t2d=dm2;}}
                    }
                    eb=eb+1;
                }
                if(t1d<3){gate="ARCHVETO";}
                else{
                    if(t2d>=0&&t1d<2*t2d){gate="ARCHVETO";}
                    else{
                        let domf:[]u8=arena[t1o..t1o+t1l];
                        if(beq(slot,domf)==0){gate="ARCHVETO";}
                    }
                }
            }
        }
        // grok-6: pinned primary registry (veto-only pre-filter)
        if(is_g6==1&&tmpl_ok==1&&beq(gate,"NONE")==1){
            let tmpl6:[]u8=tout[0..tlen];
            let slot6:[]u8=sout[0..slen];
            let ra:i32=0;
            while(ra<nreg){
                let rto:i32=g32(regtbl,ra*20);
                let rtl:i32=g32(regtbl,ra*20+4);
                let rfo:i32=g32(regtbl,ra*20+8);
                let rfl:i32=g32(regtbl,ra*20+12);
                if(beq(arena[rto..rto+rtl],tmpl6)==1){
                    if(beq(slot6,arena[rfo..rfo+rfl])==0){gate="REGVETO";}
                }
                ra=ra+1;
            }
        }
        if(beq(gate,"NONE")==1){
        if(contra==1){
            if(is_g4==1){
                // grok-4: corroborated contradiction — rival vetoes only if
                // the RIVAL sentence itself has >=2 pages on >=2 hosts
                let rpg:i32=0;
                let rhseen:[]u8=nio_alloc(16*8);
                let rnh:i32=0;
                let ri:i32=0;
                let rpages:[]u8=nio_alloc(16*4);
                let rnp:i32=0;
                while(ri<nsent){
                    let rco:i32=g32(stbl,ri*12+4);
                    let rcl:i32=g32(stbl,ri*12+8);
                    let rpg2:i32=g32(stbl,ri*12);
                    if(rcl==rivall&&beq(arena[rco..rco+rcl],arena[rivalo..rivalo+rivall])==1){
                        let dup:i32=0;
                        let dq:i32=0;
                        while(dq<rnp){if(g32(rpages,dq*4)==rpg2){dup=1;}dq=dq+1;}
                        if(dup==0){p32(rpages,rnp*4,rpg2);rnp=rnp+1;}
                    }
                    ri=ri+1;
                }
                rpg=rnp;
                let hi:i32=0;
                while(hi<rnp){
                    let pg3:i32=g32(rpages,hi*4);
                    let ho3:i32=g32(ptbl,pg3*24+16);
                    let hl3:i32=g32(ptbl,pg3*24+20);
                    let hd:i32=0;
                    let hq:i32=0;
                    while(hq<rnh){
                        let eho:i32=g32(rhseen,hq*8);
                        let ehl:i32=g32(rhseen,hq*8+4);
                        if(ehl==hl3&&beq(arena[eho..eho+ehl],arena[ho3..ho3+hl3])==1){hd=1;}
                        hq=hq+1;
                    }
                    if(hd==0){p32(rhseen,rnh*8,ho3);p32(rhseen,rnh*8+4,hl3);rnh=rnh+1;}
                    hi=hi+1;
                }
                nio_free(rpages);nio_free(rhseen);
                if(rpg>=2&&rnh>=2){gate="CONTRADICTION";}
            } else {
                gate="CONTRADICTION";
            }
        } else {
            // ---- challenger gates ----
            let is_ch1:i32=0;let is_ch2:i32=0;let is_ch2b:i32=0;let is_ch3:i32=0;let is_ch4:i32=0;
            if(beq(mecha,"ch1")==1){is_ch1=1;}
            if(beq(mecha,"ch2")==1){is_ch2=1;}
            if(beq(mecha,"ch2b")==1){is_ch2b=1;}
            if(beq(mecha,"ch3")==1){is_ch3=1;}
            if(beq(mecha,"ch4")==1){is_ch4=1;}
            if(is_ch1==1){
                let qi:i32=0;
                while(qi<nsent){
                    let qo:i32=g32(stbl,qi*12+4);
                    let ql:i32=g32(stbl,qi*12+8);
                    let sq:[]u8=arena[qo..qo+ql];
                    if(beq(sq,claim)==0&&shared_cw(sq,claim,cct,cnc)>=2){
                        // flipper whole-word scan
                        let fw:[]u8=nio_alloc(64*8);
                        let fnw:i32=words_of(sq,fw,64);
                        let fk:i32=0;
                        let ff:i32=0;
                        while(fk<fnw){
                            if(flipper(word_at(sq,fw,fk))==1){ff=1;break;}
                            fk=fk+1;
                        }
                        nio_free(fw);
                        if(ff==0){
                            // antonym: claim has "open", sentence has "locked"/"closed"
                            if(has_word(claim,"open")==1&&(has_word(sq,"locked")==1||has_word(sq,"closed")==1)){ff=1;}
                            if(has_word(claim,"locked")==1&&has_word(sq,"open")==1){ff=1;}
                        }
                        if(ff==1){gate="POLARITY";break;}
                    }
                    qi=qi+1;
                }
            }
            if(is_ch2==1||is_ch2b==1){
                // furniture key -> host mask; discount pages whose key repeats on >=2 hosts
                let disq:i32=0; // page mask
                let ki2:i32=0;
                while(ki2<nsent){
                    let ko2:i32=g32(stbl,ki2*12+4);
                    let kl2:i32=g32(stbl,ki2*12+8);
                    let sk:[]u8=arena[ko2..ko2+kl2];
                    if(beq(sk,claim)==0){
                        let iskey:i32=0;
                        if(is_ch2b==1){iskey=1;}
                        else{
                            let mw:[]u8=nio_alloc(64*8);
                            let mnw:i32=words_of(sk,mw,64);
                            let mk:i32=0;
                            while(mk<mnw){
                                let w:[]u8=word_at(sk,mw,mk);
                                if(in_list(w,"comments|subscribe|cookie|advertisement|newsletter")==1){iskey=1;break;}
                                mk=mk+1;
                            }
                            nio_free(mw);
                            if(iskey==0&&bsub(sk,"powered by")==1){iskey=1;}
                            if(iskey==0&&bsub(sk,"sign up")==1){iskey=1;}
                            if(iskey==0&&bsub(sk,"log in")==1){iskey=1;}
                            if(iskey==0&&bsub(sk,"share this")==1){iskey=1;}
                            if(iskey==0&&bsub(sk,"all rights reserved")==1){iskey=1;}
                        }
                        if(iskey==1){
                            // host mask for this key
                            let hm:i32=0;
                            let k3:i32=0;
                            while(k3<nsent){
                                let k3o:i32=g32(stbl,k3*12+4);
                                let k3l:i32=g32(stbl,k3*12+8);
                                if(beq(sk,arena[k3o..k3o+k3l])==1){
                                    hm=hm|(1<<g32(stbl,k3*12));
                                }
                                k3=k3+1;
                            }
                            // popcount >= 2 ?
                            let pc2:i32=0;
                            let b2:i32=0;
                            while(b2<16){if((hm&(1<<b2))!=0){pc2=pc2+1;}b2=b2+1;}
                            if(pc2>=2){
                                let k4:i32=0;
                                while(k4<nsent){
                                    let k4o:i32=g32(stbl,k4*12+4);
                                    let k4l:i32=g32(stbl,k4*12+8);
                                    if(beq(sk,arena[k4o..k4o+k4l])==1){
                                        disq=disq|(1<<g32(stbl,k4*12));
                                    }
                                    k4=k4+1;
                                }
                            }
                        }
                    }
                    ki2=ki2+1;
                }
                let newmask:i32=votemask;
                let b5:i32=0;
                while(b5<16){
                    if((disq&(1<<b5))!=0){newmask=newmask-(newmask&(1<<b5));}
                    b5=b5+1;
                }
                if(newmask!=votemask){
                    // recount votes/hosts
                    votemask=newmask;
                    nvotes=0;nhost=0;
                    let hs2:[]u8=nio_alloc(16*64);
                    let hse2:[]u8=nio_alloc(16*4);
                    let p4:i32=0;
                    while(p4<npages){
                        if((votemask&(1<<p4))!=0){
                            nvotes=nvotes+1;
                            let ho2:i32=g32(ptbl,p4*24+16);
                            let hl4:i32=g32(ptbl,p4*24+20);
                            let h2:[]u8=arena[ho2..ho2+hl4];
                            let f3:i32=0;
                            let q8:i32=0;
                            while(q8<nhost){
                                let el8:i32=g32(hse2,q8*4);
                                if(el8==h2.len&&beq(h2,hs2[q8*64..q8*64+el8])==1){f3=1;break;}
                                q8=q8+1;
                            }
                            if(f3==0){
                                let q9:i32=0;
                                while(q9<h2.len){hs2[nhost*64+q9]=h2[q9];q9=q9+1;}
                                p32(hse2,nhost*4,h2.len);
                                nhost=nhost+1;
                            }
                        }
                        p4=p4+1;
                    }
                    nio_free(hs2);nio_free(hse2);
                    if(is_ch2==1){gate="CHROME";}else{gate="CHROME_NAIVE";}
                }
            }
            if(is_ch3==1){
                // claim must add >=1 content word beyond need
                let neww:i32=0;
                let ck:i32=0;
                while(ck<cnc){
                    let cw:[]u8=cword_at(claim,cct,ck);
                    let jk:i32=0;
                    let fd:i32=0;
                    while(jk<nnc){
                        if(beq(cw,cword_at(needn,nct,jk))==1){fd=1;break;}
                        jk=jk+1;
                    }
                    if(fd==0){neww=neww+1;}
                    ck=ck+1;
                }
                if(neww==0){gate="NONINFORMATIVE";}
            }
            if(is_ch4==1){
                // scope uniformity across voting pages' claim sentences
                let first:i32=1;
                let refscope:[]u8=nio_alloc(512);
                let reflen:i32=0;
                let bad:i32=0;
                let vi2:i32=0;
                while(vi2<nsent){
                    let vvo:i32=g32(stbl,vi2*12+4);
                    let vvl:i32=g32(stbl,vi2*12+8);
                    if(beq(claim,arena[vvo..vvo+vvl])==1){
                        let sq2:[]u8=arena[vvo..vvo+vvl];
                        let sw:[]u8=nio_alloc(64*8);
                        let snw:i32=words_of(sq2,sw,64);
                        let cur:[]u8=nio_alloc(256);
                        let cl2:i32=0;
                        let sk2:i32=0;
                        while(sk2<snw){
                            let w2:[]u8=word_at(sq2,sw,sk2);
                            if(scopeword(w2)==1){
                                let q10:i32=0;
                                while(q10<w2.len){cur[cl2]=w2[q10];cl2=cl2+1;q10=q10+1;}
                                cur[cl2]=32;cl2=cl2+1;
                            }
                            sk2=sk2+1;
                        }
                        nio_free(sw);
                        if(first==1){
                            let q11:i32=0;
                            while(q11<cl2){refscope[q11]=cur[q11];q11=q11+1;}
                            reflen=cl2;first=0;
                        } else {
                            if(cl2!=reflen||beq(cur[0..cl2],refscope[0..reflen])==0){bad=1;}
                        }
                        nio_free(cur);
                    }
                    vi2=vi2+1;
                }
                nio_free(refscope);
                if(bad==1){gate="SCOPE_MIX";}
            }
            // ---- round-2 gates: grok-7 surprisal-conditional collapse ----
            if(is_g7==1&&beq(gate,"NONE")==1){
                let wc7:i32=wcount(claim);
                if(wc7>=25&&nhost>=3){
                    let archd:i32=0;
                    let sa:i32=0;
                    while(sa<nsentarch){
                        let so:i32=g32(senttbl,sa*8);
                        let sl:i32=g32(senttbl,sa*8+4);
                        if(beq(arena[so..so+sl],claim)==1){archd=1;}
                        sa=sa+1;
                    }
                    let cite_ok:i32=1;
                    let cite0:[]u8="";
                    let first7:i32=1;
                    let ci7:i32=0;
                    while(ci7<npages){
                        if((votemask&(1<<ci7))!=0){
                            let cv:[]u8=mget(ci7,"CITE",metatbl,arena);
                            if(cv.len==0){cite_ok=0;}
                            else{
                                if(first7==1){cite0=cv;first7=0;}
                                else{if(beq(cv,cite0)==0){cite_ok=0;}}
                            }
                        }
                        ci7=ci7+1;
                    }
                    if(archd==0&&cite_ok==0){gate="COPYCOLLAPSE";}
                }
            }
            // ---- grok-9: higher k for templatic claims ----
            if(is_g9==1&&beq(gate,"NONE")==1&&tmpl_ok==1){
                if(nhost<5){gate="K5";}
            }
            // ---- fable w11: nameserver-apex / ip-/24 / whois-email-apex ----
            if(is_w11==1&&beq(gate,"NONE")==1){
                let ov11:i32=0;
                let fbuf:[]u8=nio_alloc(256);
                let lw:[]u8=nio_alloc(256);
                let fl11:i32=feat_shared(votemask,npages,ptbl,"NSAPEX",metatbl,arena,fbuf);
                if(fl11>0){
                    let ll11:i32=lower_copy(fbuf[0..fl11],lw);
                    if(wl_ns(lw[0..ll11])==0){ov11=ov11+1;}
                }
                fl11=feat_shared(votemask,npages,ptbl,"IP24",metatbl,arena,fbuf);
                if(fl11>0){ov11=ov11+1;}
                fl11=feat_shared(votemask,npages,ptbl,"WHOIS",metatbl,arena,fbuf);
                if(fl11>0){
                    let abuf:[]u8=nio_alloc(256);
                    let al11:i32=email_apex(fbuf[0..fl11],abuf);
                    if(al11>0){
                        let ll2:i32=lower_copy(abuf[0..al11],lw);
                        if(wl_email(lw[0..ll2])==0){ov11=ov11+1;}
                    }
                    nio_free(abuf);
                }
                nio_free(fbuf);nio_free(lw);
                if(ov11>=2){gate="OPCOIN";}
            }
            // ---- fable w12: CMS fingerprint overlap ----
            if(is_w12==1&&beq(gate,"NONE")==1){
                let cbuf:[]u8=nio_alloc(256);
                let lc2:[]u8=nio_alloc(256);
                let cl12:i32=feat_shared(votemask,npages,ptbl,"CMS",metatbl,arena,cbuf);
                if(cl12>0){
                    let lcl:i32=lower_copy(cbuf[0..cl12],lc2);
                    if(wl_cms(lc2[0..lcl])==0){gate="CMSCOIN";}
                }
                nio_free(cbuf);nio_free(lc2);
            }
            // ---- fable w3: operator-coincidence buildout (HL-13) ----
            if(is_w3==1&&beq(gate,"NONE")==1){
                let ov3:i32=0;
                let f3b:[]u8=nio_alloc(256);
                let lw3:[]u8=nio_alloc(256);
                let fl3:i32=feat_shared(votemask,npages,ptbl,"NSAPEX",metatbl,arena,f3b);
                if(fl3>0){
                    let ll3:i32=lower_copy(f3b[0..fl3],lw3);
                    if(wl_ns(lw3[0..ll3])==0){ov3=ov3+1;}
                }
                fl3=feat_shared(votemask,npages,ptbl,"IP24",metatbl,arena,f3b);
                if(fl3>0){ov3=ov3+1;}
                fl3=feat_shared(votemask,npages,ptbl,"WHOIS",metatbl,arena,f3b);
                if(fl3>0){
                    let ab3:[]u8=nio_alloc(256);
                    let al3:i32=email_apex(f3b[0..fl3],ab3);
                    if(al3>0){
                        let ll4:i32=lower_copy(ab3[0..al3],lw3);
                        if(wl_email(lw3[0..ll4])==0){ov3=ov3+1;}
                    }
                    nio_free(ab3);
                }
                fl3=feat_shared(votemask,npages,ptbl,"CMS",metatbl,arena,f3b);
                if(fl3>0){
                    let ll5:i32=lower_copy(f3b[0..fl3],lw3);
                    if(wl_cms(lw3[0..ll5])==0){ov3=ov3+1;}
                }
                nio_free(f3b);nio_free(lw3);
                if(ov3>=2){gate="OPCOIN2";}
            }
            // ---- fable w6: registrable-domain age >= 30 days ----
            if(is_w6==1&&beq(gate,"NONE")==1){
                let wi:i32=0;
                while(wi<npages){
                    if((votemask&(1<<wi))!=0){
                        let av:[]u8=mget(wi,"AGE_DAYS",metatbl,arena);
                        if(av.len>0){
                            if(atoi(av)<30){gate="AGEBLOCK";}
                        }
                    }
                    wi=wi+1;
                }
            }
        }
        }
            // ---- final quorum ----
            if(beq(gate,"NONE")==1){
                if(nvotes>=2&&nhost>=2){verdict=1;}
                else{gate="QUORUM";}
            } else {
                // a challenger gate fired with discounted votes: re-check quorum only
                // for CHROME/CHROME_NAIVE (votes were discounted); others withhold outright
                if(beq(gate,"CHROME")==1||beq(gate,"CHROME_NAIVE")==1){
                    if(nvotes>=2&&nhost>=2){gate="NONE";verdict=1;}
                    else{verdict=0;}
                } else {
                    verdict=0;
                }
            }
        nio_free(cwt);nio_free(cct);
    }
    _zag_print("V|");
    _zag_print(mecha);
    _zag_print("|");
    if(verdict==1){_zag_print("INSTALL|");}else{_zag_print("WITHHOLD|");}
    _zag_print(gate);
    _zag_print("|");
    _zag_print(i64s(nvotes as i64));
    _zag_print("|");
    _zag_print(i64s(nhost as i64));
    _zag_println("");
    nio_free(inb);nio_free(arena);nio_free(ptbl);nio_free(stbl);
    nio_free(nbuf);nio_free(tmp);nio_free(tmp2);nio_free(utbl);
    nio_free(metatbl);nio_free(archtbl);nio_free(regtbl);nio_free(senttbl);
    nio_free(tout);nio_free(sout);
    nio_free(nwt);nio_free(nct);
    return 0;
}

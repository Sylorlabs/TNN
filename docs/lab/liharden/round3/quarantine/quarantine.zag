// quarantine.zag — LI-HARDEN round 3, Crew C: QUARANTINED third state.
// Pure Zag, zero RNG, deterministic. argv[1] selects mode: "admit" | "exit".
// argv[2]: admit -> crawl-window override ("" = use fixture WINDOW);
//           exit  -> decay multiplier ("" = "4").
// argv[3]: exit  -> legitimacy diversity minimum, non-claim sentences ("" = "2").
// Reads the fixture bundle on stdin, emits verdict lines on stdout.
// Run twice; outputs must be byte-identical.
@import("R33_NATIVE_IO_V1.zag")

fn read_stdin(b:[]u8)i32 {
    let at:i32=0;
    while(at<b.len){
        let n:i64=_zag_raw_syscall(0,0,(_zag_slice_ptr(b) as i64)+(at as i64),(b.len-at) as i64,0,0,0);
        if(n<=0){break;}
        at=(at as i64+n) as i32;
    }
    return at;
}
fn p32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn beq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
// substring: 1 if n occurs in h
fn bsub(h:[]u8,n:[]u8)i32 {
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let j:i32=0;
        while(j<n.len){if(h[i+j]!=n[j]){break;}j=j+1;}
        if(j==n.len){return 1;}
        i=i+1;
    }
    return 0;
}
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}
fn is_punct(c:u8)i32 {
    if(c==46||c==44||c==33||c==63||c==59||c==58||c==39||c==34){return 1;}
    if(c==40||c==41||c==91||c==93||c==123||c==125){return 1;}
    if(c==45||c==95||c==47||c==92||c==124||c==64||c==35){return 1;}
    if(c==36||c==37||c==94||c==38||c==42||c==43||c==61||c==126){return 1;}
    if(c==96||c==60||c==62){return 1;}
    return 0;
}
// normalize: lowercase ASCII, punct->space, drop ASCII controls,
// keep bytes>=128 significant; collapse spaces; pad with one space each end.
// (Same observable behavior as beyond.zag's normalize.)
fn normalize(s:[]u8,out:[]u8)i32 {
    let w:i32=1;
    out[0]=32;
    let i:i32=0;
    let last_sp:i32=1;
    while(i<s.len){
        let c:u8=s[i];
        if(c<32){i=i+1;continue;}
        if(c==39){
            if(w>1&&out[w-1]==110&&i+1<s.len&&s[i+1]==116){
                let a2:i32=i+2;
                let boundary:i32=0;
                if(a2>=s.len){boundary=1;}
                else{
                    let nc:u8=s[a2];
                    if(nc==32||nc<32||is_punct(nc)==1){boundary=1;}
                }
                if(boundary==1){
                    out[w-1]=32;
                    out[w]=110;out[w+1]=111;out[w+2]=116;
                    w=w+3;last_sp=0;
                    i=i+2;
                    continue;
                }
            }
            if(last_sp==0){out[w]=32;w=w+1;last_sp=1;}
            i=i+1;
            continue;
        }
        if(is_punct(c)==1){
            if(last_sp==0){out[w]=32;w=w+1;last_sp=1;}
            i=i+1;
            continue;
        }
        if(c==32){
            if(last_sp==0){out[w]=32;w=w+1;last_sp=1;}
            i=i+1;
            continue;
        }
        if(c>=65&&c<=90){out[w]=c+32;}
        else{out[w]=c;}
        w=w+1;last_sp=0;
        i=i+1;
    }
    if(last_sp==0){out[w]=32;w=w+1;}
    return w;
}
fn atoi(s:[]u8)i32 {
    let v:i32=0;
    let i:i32=0;
    let neg:i32=0;
    if(s.len>0&&s[0]==45){neg=1;i=1;}
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48&&c<=57){v=v*10+((c as i32)-48);}
        else{break;}
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}
// starts_with: 1 if s begins with prefix p
fn bstarts(s:[]u8,p:[]u8)i32 {
    if(s.len<p.len){return 0;}
    let i:i32=0;
    while(i<p.len){if(s[i]!=p[i]){return 0;}i=i+1;}
    return 1;
}
// copy s into arena at apos; return new apos. Caller records old apos.
fn acopy(arena:[]u8,apos:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){arena[apos+i]=s[i];i=i+1;}
    return apos+s.len;
}

// meta_append: parse "<pid>|k=v|..." into metatbl[mi]; returns new apos.
fn meta_append(rest:[]u8,metatbl:[]u8,mi:i32,arena:[]u8,apos:i32)i32 {
    let f1:i32=0;
    while(f1<rest.len&&rest[f1]!=124){f1=f1+1;}
    let pid:[]u8=rest[0..f1];
    let a:i32=apos;
    p32(metatbl,mi*52,a);a=acopy(arena,a,pid);
    p32(metatbl,mi*52+4,pid.len);
    p32(metatbl,mi*52+8,0);p32(metatbl,mi*52+12,0);
    p32(metatbl,mi*52+16,0);p32(metatbl,mi*52+20,0);
    p32(metatbl,mi*52+24,0);p32(metatbl,mi*52+28,0);
    p32(metatbl,mi*52+32,0);p32(metatbl,mi*52+36,0);
    p32(metatbl,mi*52+40,0);
    p32(metatbl,mi*52+44,0);p32(metatbl,mi*52+48,0);
    let f0:i32=f1+1;
    while(f0<rest.len){
        f1=f0;
        while(f1<rest.len&&rest[f1]!=124){f1=f1+1;}
        let seg:[]u8=rest[f0..f1];
        if(bstarts(seg,"NS=")==1){p32(metatbl,mi*52+8,a);a=acopy(arena,a,seg[3..seg.len]);p32(metatbl,mi*52+12,seg.len-3);}
        if(bstarts(seg,"IP24=")==1){p32(metatbl,mi*52+16,a);a=acopy(arena,a,seg[5..seg.len]);p32(metatbl,mi*52+20,seg.len-5);}
        if(bstarts(seg,"WHOIS=")==1){p32(metatbl,mi*52+24,a);a=acopy(arena,a,seg[6..seg.len]);p32(metatbl,mi*52+28,seg.len-6);}
        if(bstarts(seg,"CMS=")==1){p32(metatbl,mi*52+32,a);a=acopy(arena,a,seg[4..seg.len]);p32(metatbl,mi*52+36,seg.len-4);}
        if(bstarts(seg,"TFIRST=")==1){p32(metatbl,mi*52+40,atoi(seg[7..seg.len]));}
        if(bstarts(seg,"H=")==1){p32(metatbl,mi*52+44,a);a=acopy(arena,a,seg[2..seg.len]);p32(metatbl,mi*52+48,seg.len-2);}
        f0=f1+1;
    }
    return a;
}
// link_meta: set ptbl[page].meta_idx = mi where pid matches.
fn link_meta(ptbl:[]u8,npages:i32,arena:[]u8,metatbl:[]u8,mi:i32)void {
    let po:i32=g32(metatbl,mi*52);let pl:i32=g32(metatbl,mi*52+4);
    let pid:[]u8=arena[po..po+pl];
    let pi:i32=0;
    while(pi<npages){
        let qo:i32=g32(ptbl,pi*24);let ql:i32=g32(ptbl,pi*24+4);
        if(beq(arena[qo..qo+ql],pid)==1){p32(ptbl,pi*24+20,mi);}
        pi=pi+1;
    }
    return;
}
// new_page: append a page row; returns new apos.
fn new_page(ptbl:[]u8,npages:i32,arena:[]u8,apos:i32,pid:[]u8,kind:i32,nsent:i32)i32 {
    let p_off:i32=apos;
    let a:i32=acopy(arena,apos,pid);
    p32(ptbl,npages*24,p_off);p32(ptbl,npages*24+4,pid.len);
    p32(ptbl,npages*24+8,kind);
    p32(ptbl,npages*24+12,nsent);p32(ptbl,npages*24+16,0);
    p32(ptbl,npages*24+20,0-1);
    return a;
}


// page_votes: 1 if any sentence of page pi equals nclaim.
fn page_votes(ptbl:[]u8,pi:i32,stbl:[]u8,arena:[]u8,nclaim:[]u8)i32 {
    let ss:i32=g32(ptbl,pi*24+12);
    let sn:i32=g32(ptbl,pi*24+16);
    let si:i32=0;
    while(si<sn){
        let gi:i32=ss+si;
        let so:i32=g32(stbl,gi*12+4);let sl:i32=g32(stbl,gi*12+8);
        if(beq(arena[so..so+sl],nclaim)==1){return 1;}
        si=si+1;
    }
    return 0;
}
// page_nonclaim: count of sentences of page pi not equal to nclaim.
fn page_nonclaim(ptbl:[]u8,pi:i32,stbl:[]u8,arena:[]u8,nclaim:[]u8)i32 {
    let ss:i32=g32(ptbl,pi*24+12);
    let sn:i32=g32(ptbl,pi*24+16);
    let si:i32=0;
    let n:i32=0;
    while(si<sn){
        let gi:i32=ss+si;
        let so:i32=g32(stbl,gi*12+4);let sl:i32=g32(stbl,gi*12+8);
        if(beq(arena[so..so+sl],nclaim)==0){n=n+1;}
        si=si+1;
    }
    return n;
}
// g1_check: 1 = veto (archived dominant filler conflicts with slot),
//           0 = pass (no conflict), -1 = no pin entry for template.
fn g1_check(archtbl:[]u8,narch:i32,arena:[]u8,closed:[]u8,nslot:[]u8)i32 {
    let maxera:i32=0-1;
    let ea:i32=0;
    while(ea<narch){
        let to:i32=g32(archtbl,ea*24);let tl:i32=g32(archtbl,ea*24+4);
        let er:i32=g32(archtbl,ea*24+16);
        if(beq(arena[to..to+tl],closed)==1){if(er>maxera){maxera=er;}}
        ea=ea+1;
    }
    if(maxera<0){return 0-1;}
    let t1d:i32=0-1;let t2d:i32=0-1;
    let t1o:i32=0;let t1l:i32=0;
    let eb:i32=0;
    while(eb<narch){
        let eo:i32=g32(archtbl,eb*24);let el:i32=g32(archtbl,eb*24+4);
        let fo:i32=g32(archtbl,eb*24+8);let fl:i32=g32(archtbl,eb*24+12);
        let er2:i32=g32(archtbl,eb*24+16);let dm:i32=g32(archtbl,eb*24+20);
        if(er2==maxera&&beq(arena[eo..eo+el],closed)==1){
            if(dm>t1d){t2d=t1d;t1d=dm;t1o=fo;t1l=fl;}
            else{if(dm>t2d){t2d=dm;}}
        }
        eb=eb+1;
    }
    if(t1d<3){return 1;}
    if(t2d>=0&&t1d<2*t2d){return 1;}
    if(beq(nslot,arena[t1o..t1o+t1l])==0){return 1;}
    return 0;
}
// word_in: 1 if w occurs as a whole word in space-padded a.
fn word_in(w:[]u8,a:[]u8,tmp:[]u8)i32 {
    if(w.len+2>tmp.len){return 0;}
    tmp[0]=32;
    let k:i32=0;
    while(k<w.len){tmp[1+k]=w[k];k=k+1;}
    tmp[1+w.len]=32;
    return bsub(a,tmp[0..w.len+2]);
}
// word_overlap: number of words of b present as whole words in a.
fn word_overlap(a:[]u8,b:[]u8,tmp:[]u8)i32 {
    let shared:i32=0;
    let i:i32=0;
    while(i<b.len){
        while(i<b.len&&b[i]==32){i=i+1;}
        if(i>=b.len){break;}
        let j:i32=i;
        while(j<b.len&&b[j]!=32){j=j+1;}
        if(j>i){
            if(word_in(b[i..j],a,tmp)==1){shared=shared+1;}
        }
        i=j;
    }
    return shared;
}
// imedian: median of n i32s stored via p32 at vals; sorts a scratch copy.
fn imedian(vals:[]u8,n:i32,scratch:[]u8)i32 {
    if(n<=0){return 0;}
    let i:i32=0;
    while(i<n){p32(scratch,i*4,g32(vals,i*4));i=i+1;}
    let a:i32=0;
    while(a<n){
        let b:i32=a+1;
        while(b<n){
            if(g32(scratch,b*4)<g32(scratch,a*4)){
                let t:i32=g32(scratch,a*4);
                p32(scratch,a*4,g32(scratch,b*4));
                p32(scratch,b*4,t);
            }
            b=b+1;
        }
        a=a+1;
    }
    return g32(scratch,(n/2)*4);
}
// meta_field_eq: 1 if field f (off idx) of two metas are both non-empty and equal.
fn meta_field_eq(metatbl:[]u8,mi:i32,mj:i32,f:i32,arena:[]u8)i32 {
    let ao:i32=g32(metatbl,mi*52+f);let al:i32=g32(metatbl,mi*52+f+4);
    let bo:i32=g32(metatbl,mj*52+f);let bl:i32=g32(metatbl,mj*52+f+4);
    if(al==0||bl==0){return 0;}
    return beq(arena[ao..ao+al],arena[bo..bo+bl]);
}
// meta_indep: 1 if new page meta mi shares no NS/IP24/WHOIS/CMS with any
// quorum member's meta. Fields: NS@8, IP24@16, WHOIS@24, CMS@32.
fn meta_indep(metatbl:[]u8,mi:i32,ptbl:[]u8,npages:i32,arena:[]u8)i32 {
    let pi:i32=0;
    while(pi<npages){
        if(g32(ptbl,pi*24+8)==0){
            let mj:i32=g32(ptbl,pi*24+20);
            if(mj>=0){
                if(meta_field_eq(metatbl,mi,mj,8,arena)==1){return 0;}
                if(meta_field_eq(metatbl,mi,mj,16,arena)==1){return 0;}
                if(meta_field_eq(metatbl,mi,mj,24,arena)==1){return 0;}
                if(meta_field_eq(metatbl,mi,mj,32,arena)==1){return 0;}
            }
        }
        pi=pi+1;
    }
    return 1;
}

// ---------- main ----------
fn main()i32 {
    let mode0:[]u8=_zag_arg(1);
    let mode:[]u8=mode0;
    if(mode.len>0&&mode[mode.len-1]==10){mode=mode[0..mode.len-1];}
    let arg20:[]u8=_zag_arg(2);
    let arg2:[]u8=arg20;
    if(arg2.len>0&&arg2[arg2.len-1]==10){arg2=arg2[0..arg2.len-1];}
    let arg30:[]u8=_zag_arg(3);
    let arg3:[]u8=arg30;
    if(arg3.len>0&&arg3[arg3.len-1]==10){arg3=arg3[0..arg3.len-1];}
    let inb:[]u8=nio_alloc(1048576);
    let inlen:i32=read_stdin(inb);
    let arena:[]u8=nio_alloc(524288);
    let apos:i32=0;
    let ptbl:[]u8=nio_alloc(256*24);
    let npages:i32=0;
    let stbl:[]u8=nio_alloc(2048*12);
    let nsent:i32=0;
    let metatbl:[]u8=nio_alloc(256*52);
    let nmeta:i32=0;
    let archtbl:[]u8=nio_alloc(64*24);
    let narch:i32=0;
    let rqtbl:[]u8=nio_alloc(32*16);
    let nrq:i32=0;
    let dctbl:[]u8=nio_alloc(16*16);
    let ndcal:i32=0;
    let nbuf:[]u8=nio_alloc(4096);
    // header state
    let case_off:i32=0;let case_len:i32=0;
    let claim_off:i32=0;let claim_len:i32=0;
    let quorum_off:i32=0;let quorum_len:i32=0;
    let thresh:i32=3;
    let domain_off:i32=0;let domain_len:i32=0;
    let closed_off:i32=0;let closed_len:i32=0;
    let slot_off:i32=0;let slot_len:i32=0;
    let window:i32=999999;
    let has_contra:i32=0;
    let contra_off:i32=0;let contra_len:i32=0;
    let contra_tfirst:i32=0;let contra_auth:i32=0;
    let tnow:i32=0;let tq:i32=0;
    let curpage:i32=-1;
    // parse lines
    let pos:i32=0;
    while(pos<inlen){
        let eol:i32=pos;
        while(eol<inlen&&inb[eol]!=10){eol=eol+1;}
        let line:[]u8=inb[pos..eol];
        if(line.len>0&&line[line.len-1]==13){line=line[0..line.len-1];}
        pos=eol+1;
        if(line.len==0){continue;}
        if(beq(line,"END")==1){break;}
        if(bstarts(line,"TITLE:")==1){continue;}
        if(bstarts(line,"ARCH|")==1){
            // ARCH|<template>|<filler>|<era>|<dominance>
            let rest:[]u8=line[5..line.len];
            let f0:i32=0;let f1:i32=0;
            while(f1<rest.len&&rest[f1]!=124){f1=f1+1;}
            let t_off:i32=apos;apos=acopy(arena,apos,rest[f0..f1]);
            let t_len:i32=f1-f0;
            f0=f1+1;f1=f0;
            while(f1<rest.len&&rest[f1]!=124){f1=f1+1;}
            let nl:i32=normalize(rest[f0..f1],nbuf);
            let fl_off:i32=apos;apos=acopy(arena,apos,nbuf[0..nl]);
            let fl_len:i32=nl;
            f0=f1+1;f1=f0;
            while(f1<rest.len&&rest[f1]!=124){f1=f1+1;}
            let era:i32=atoi(rest[f0..f1]);
            f0=f1+1;
            let dom:i32=atoi(rest[f0..rest.len]);
            p32(archtbl,narch*24,t_off);p32(archtbl,narch*24+4,t_len);
            p32(archtbl,narch*24+8,fl_off);p32(archtbl,narch*24+12,fl_len);
            p32(archtbl,narch*24+16,era);p32(archtbl,narch*24+20,dom);
            narch=narch+1;
            continue;
        }
        if(bstarts(line,"CONTRA|")==1){
            let rest:[]u8=line[7..line.len];
            let f1:i32=0;
            while(f1<rest.len&&rest[f1]!=124){f1=f1+1;}
            let nl:i32=normalize(rest[0..f1],nbuf);
            contra_off=apos;apos=acopy(arena,apos,nbuf[0..nl]);
            contra_len=nl;
            let f0:i32=f1+1;
            while(f0<rest.len){
                f1=f0;
                while(f1<rest.len&&rest[f1]!=124){f1=f1+1;}
                let seg:[]u8=rest[f0..f1];
                if(bstarts(seg,"TFIRST=")==1){contra_tfirst=atoi(seg[7..seg.len]);}
                if(bstarts(seg,"AUTH=")==1){contra_auth=atoi(seg[5..seg.len]);}
                f0=f1+1;
            }
            has_contra=1;
            continue;
        }
        if(bstarts(line,"QUORUM|")==1){
            quorum_off=apos;apos=acopy(arena,apos,line[7..line.len]);
            quorum_len=line.len-7;
            continue;
        }
        if(bstarts(line,"CLAIM|")==1){
            claim_off=apos;apos=acopy(arena,apos,line[6..line.len]);
            claim_len=line.len-6;
            continue;
        }
        if(bstarts(line,"CLOSED|")==1){
            closed_off=apos;apos=acopy(arena,apos,line[7..line.len]);
            closed_len=line.len-7;
            continue;
        }
        if(bstarts(line,"DCAL|")==1){
            let rest:[]u8=line[5..line.len];
            let f1:i32=0;
            while(f1<rest.len&&rest[f1]!=124){f1=f1+1;}
            let d_off:i32=apos;apos=acopy(arena,apos,rest[0..f1]);
            let d_len:i32=f1;
            let lags_off:i32=apos;
            let nlag:i32=0;
            let g:i32=f1+1;
            while(g<rest.len){
                while(g<rest.len&&rest[g]==32){g=g+1;}
                if(g>=rest.len){break;}
                let h:i32=g;
                while(h<rest.len&&rest[h]!=32){h=h+1;}
                p32(arena,apos,atoi(rest[g..h]));
                apos=apos+4;nlag=nlag+1;
                g=h;
            }
            p32(dctbl,ndcal*16,d_off);p32(dctbl,ndcal*16+4,d_len);
            p32(dctbl,ndcal*16+8,lags_off);p32(dctbl,ndcal*16+12,nlag);
            ndcal=ndcal+1;
            continue;
        }
        if(bstarts(line,"CASE|")==1){
            case_off=apos;apos=acopy(arena,apos,line[5..line.len]);
            case_len=line.len-5;
            continue;
        }
        if(bstarts(line,"THRESH|")==1){thresh=atoi(line[7..line.len]);continue;}
        if(bstarts(line,"DOMAIN|")==1){
            domain_off=apos;apos=acopy(arena,apos,line[7..line.len]);
            domain_len=line.len-7;
            continue;
        }
        if(bstarts(line,"SLOT|")==1){
            slot_off=apos;apos=acopy(arena,apos,line[5..line.len]);
            slot_len=line.len-5;
            continue;
        }
        if(bstarts(line,"WINDOW|")==1){window=atoi(line[7..line.len]);continue;}
        if(bstarts(line,"TNOW|")==1){tnow=atoi(line[5..line.len]);continue;}
        if(bstarts(line,"TQ|")==1){tq=atoi(line[3..line.len]);continue;}
        if(bstarts(line,"NC|")==1){
            let pid:[]u8=line[3..line.len];
            let p_off:i32=apos;apos=acopy(arena,apos,pid);
            p32(ptbl,npages*24,p_off);p32(ptbl,npages*24+4,pid.len);
            p32(ptbl,npages*24+8,2);
            p32(ptbl,npages*24+12,nsent);p32(ptbl,npages*24+16,0);
            p32(ptbl,npages*24+20,0-1);
            curpage=npages;npages=npages+1;
            continue;
        }
        if(bstarts(line,"NX|")==1){
            // NX|<eid>|k=v|...
            let rest:[]u8=line[3..line.len];
            let f1:i32=0;
            while(f1<rest.len&&rest[f1]!=124){f1=f1+1;}
            let pid:[]u8=rest[0..f1];
            let mi:i32=nmeta;
            p32(metatbl,mi*52,apos);
            apos=acopy(arena,apos,pid);
            p32(metatbl,mi*52+4,pid.len);
            p32(metatbl,mi*52+8,0);p32(metatbl,mi*52+12,0);
            p32(metatbl,mi*52+16,0);p32(metatbl,mi*52+20,0);
            p32(metatbl,mi*52+24,0);p32(metatbl,mi*52+28,0);
            p32(metatbl,mi*52+32,0);p32(metatbl,mi*52+36,0);
            p32(metatbl,mi*52+40,0);
            p32(metatbl,mi*52+44,0);p32(metatbl,mi*52+48,0);
            let f0:i32=f1+1;
            while(f0<rest.len){
                f1=f0;
                while(f1<rest.len&&rest[f1]!=124){f1=f1+1;}
                let seg:[]u8=rest[f0..f1];
                if(bstarts(seg,"NS=")==1){
                    p32(metatbl,mi*52+8,apos);apos=acopy(arena,apos,seg[3..seg.len]);
                    p32(metatbl,mi*52+12,seg.len-3);
                }
                if(bstarts(seg,"IP24=")==1){
                    p32(metatbl,mi*52+16,apos);apos=acopy(arena,apos,seg[5..seg.len]);
                    p32(metatbl,mi*52+20,seg.len-5);
                }
                if(bstarts(seg,"WHOIS=")==1){
                    p32(metatbl,mi*52+24,apos);apos=acopy(arena,apos,seg[6..seg.len]);
                    p32(metatbl,mi*52+28,seg.len-6);
                }
                if(bstarts(seg,"CMS=")==1){
                    p32(metatbl,mi*52+32,apos);apos=acopy(arena,apos,seg[4..seg.len]);
                    p32(metatbl,mi*52+36,seg.len-4);
                }
                if(bstarts(seg,"TFIRST=")==1){p32(metatbl,mi*52+40,atoi(seg[7..seg.len]));}
                if(bstarts(seg,"H=")==1){
                    p32(metatbl,mi*52+44,apos);apos=acopy(arena,apos,seg[2..seg.len]);
                    p32(metatbl,mi*52+48,seg.len-2);
                }
                f0=f1+1;
            }
            // link to page by pid
            let pi:i32=0;
            while(pi<npages){
                let po:i32=g32(ptbl,pi*24);let pl:i32=g32(ptbl,pi*24+4);
                if(beq(arena[po..po+pl],pid)==1){p32(ptbl,pi*24+20,mi);}
                pi=pi+1;
            }
            nmeta=nmeta+1;
            continue;
        }
        if(bstarts(line,"RQ|")==1){
            // RQ|<pid>|H=<hash>
            let rest:[]u8=line[3..line.len];
            let f1:i32=0;
            while(f1<rest.len&&rest[f1]!=124){f1=f1+1;}
            let pid:[]u8=rest[0..f1];
            let h:[]u8=rest[f1+1..rest.len];
            if(bstarts(h,"H=")==1){h=h[2..h.len];}
            p32(rqtbl,nrq*16,apos);apos=acopy(arena,apos,pid);
            p32(rqtbl,nrq*16+4,pid.len);
            p32(rqtbl,nrq*16+8,apos);apos=acopy(arena,apos,h);
            p32(rqtbl,nrq*16+12,h.len);
            nrq=nrq+1;
            continue;
        }
        if(bstarts(line,"P|")==1){
            let pid:[]u8=line[2..line.len];
            apos=new_page(ptbl,npages,arena,apos,pid,0,nsent);
            curpage=npages;npages=npages+1;
            continue;
        }
        if(bstarts(line,"M|")==1){
            apos=meta_append(line[2..line.len],metatbl,nmeta,arena,apos);
            link_meta(ptbl,npages,arena,metatbl,nmeta);
            nmeta=nmeta+1;
            continue;
        }
        if(bstarts(line,"E|")==1){
            let pid:[]u8=line[2..line.len];
            apos=new_page(ptbl,npages,arena,apos,pid,1,nsent);
            curpage=npages;npages=npages+1;
            continue;
        }
        if(bstarts(line,"X|")==1){
            apos=meta_append(line[2..line.len],metatbl,nmeta,arena,apos);
            link_meta(ptbl,npages,arena,metatbl,nmeta);
            nmeta=nmeta+1;
            continue;
        }
        // sentence line -> attach to curpage
        if(curpage>=0){
            let nl:i32=normalize(line,nbuf);
            if(nl>2){
                let s_off:i32=apos;apos=acopy(arena,apos,nbuf[0..nl]);
                p32(stbl,nsent*12,curpage);
                p32(stbl,nsent*12+4,s_off);
                p32(stbl,nsent*12+8,nl);
                nsent=nsent+1;
                let sc:i32=g32(ptbl,curpage*24+16);
                p32(ptbl,curpage*24+16,sc+1);
            }
        }
    }
    // ---- post-parse: normalize claim and slot ----
    let ncl:i32=normalize(arena[claim_off..claim_off+claim_len],nbuf);
    let nclaim_off:i32=apos;apos=acopy(arena,apos,nbuf[0..ncl]);
    let nclaim_len:i32=ncl;
    let nclaim:[]u8=arena[nclaim_off..nclaim_off+nclaim_len];
    let nslot_off:i32=0;let nslot_len:i32=0;
    if(slot_len>0){
        let nsl:i32=normalize(arena[slot_off..slot_off+slot_len],nbuf);
        nslot_off=apos;apos=acopy(arena,apos,nbuf[0..nsl]);
        nslot_len=nsl;
    }
    let nslot:[]u8=arena[nslot_off..nslot_off+nslot_len];
    let caseid:[]u8=arena[case_off..case_off+case_len];
    let dom:[]u8=arena[domain_off..domain_off+domain_len];
    let closed:[]u8=arena[closed_off..closed_off+closed_len];
    // ================= ADMIT =================
    if(beq(mode,"admit")==1){
        let w:i32=window;
        if(arg2.len>0){w=atoi(arg2);}
        // count quorum votes (kind 0 pages asserting the claim)
        let votes:i32=0;
        let pi:i32=0;
        while(pi<npages){
            if(g32(ptbl,pi*24+8)==0){
                if(page_votes(ptbl,pi,stbl,arena,nclaim)==1){votes=votes+1;}
            }
            pi=pi+1;
        }
        if(votes<thresh){
            _zag_print("V|quarantine|admit|");_zag_print(caseid);
            _zag_print("|WITHHOLD|NOQUORUM|votes=");_zag_print(i64s(votes as i64));
            _zag_print("|thresh=");_zag_print(i64s(thresh as i64));_zag_println("");
        } else {
            // g1 pre-filter: closed-class templates are governed by the pinned
            // oracle, never admitted to quarantine.
            let g1v:i32=0;
            if(closed_len>0&&beq(closed,"-")==0){
                g1v=g1_check(archtbl,narch,arena,closed,nslot);
            }
            if(g1v==1){
                _zag_print("V|quarantine|admit|");_zag_print(caseid);
                _zag_print("|WITHHOLD|G1_VETO|votes=");_zag_print(i64s(votes as i64));
                _zag_println("");
            } else {
                // candidate-set expansion: scan first w external pages
                let extcorr:i32=0;
                let firstdepth:i32=0;
                let eord:i32=0;
                let ei:i32=0;
                while(ei<npages){
                    if(g32(ptbl,ei*24+8)==1){
                        eord=eord+1;
                        if(eord<=w){
                            if(page_votes(ptbl,ei,stbl,arena,nclaim)==1){
                                extcorr=extcorr+1;
                                if(firstdepth==0){firstdepth=eord;}
                            }
                        }
                    }
                    ei=ei+1;
                }
                if(extcorr>0){
                    _zag_print("V|quarantine|admit|");_zag_print(caseid);
                    _zag_print("|INSTALL|EXT_CORR|votes=");_zag_print(i64s(votes as i64));
                    _zag_print("|ext=");_zag_print(i64s(extcorr as i64));
                    _zag_print("|depth=");_zag_print(i64s(firstdepth as i64));_zag_println("");
                    _zag_print("E|case=");_zag_print(caseid);
                    _zag_print("|state=INSTALL|origins=");_zag_print(i64s(votes as i64));
                    _zag_print("|quorum=");_zag_print(arena[quorum_off..quorum_off+quorum_len]);
                    _zag_print("|window=");_zag_print(i64s(w as i64));
                    _zag_print("|domain=");_zag_print(dom);
                    _zag_print("|label=corroborated externally|propagate=1|search=plain");
                    _zag_println("");
                } else {
                    _zag_print("V|quarantine|admit|");_zag_print(caseid);
                    _zag_print("|QUARANTINED|NO_EXT_CORR|votes=");_zag_print(i64s(votes as i64));
                    _zag_print("|ext=0|window=");_zag_print(i64s(w as i64));_zag_println("");
                    _zag_print("E|case=");_zag_print(caseid);
                    _zag_print("|state=QUARANTINED|origins=");_zag_print(i64s(votes as i64));
                    _zag_print("|quorum=");_zag_print(arena[quorum_off..quorum_off+quorum_len]);
                    _zag_print("|window=");_zag_print(i64s(w as i64));
                    _zag_print("|domain=");_zag_print(dom);
                    _zag_print("|label=asserted by ");_zag_print(i64s(votes as i64));
                    _zag_print(" origins, uncorroborated externally");
                    _zag_print("|propagate=0|search=labelled");
                    _zag_println("");
                }
            }
        }
    }
    // ================= EXIT =================
    if(beq(mode,"exit")==1){
        let mult:i32=4;
        if(arg2.len>0){mult=atoi(arg2);}
        let divmin:i32=2;
        if(arg3.len>0){divmin=atoi(arg3);}
        let ncontra:[]u8=arena[contra_off..contra_off+contra_len];
        // --- 1. DROP: quorum pinned snapshots re-checked; any member modified ---
        let modlist:[]u8=nio_alloc(1024);
        let modlen:i32=0;
        let ri:i32=0;
        while(ri<nrq){
            let rpo:i32=g32(rqtbl,ri*16);let rpl:i32=g32(rqtbl,ri*16+4);
            let rho:i32=g32(rqtbl,ri*16+8);let rhl:i32=g32(rqtbl,ri*16+12);
            let rpid:[]u8=arena[rpo..rpo+rpl];
            let rhash:[]u8=arena[rho..rho+rhl];
            // find quorum page + its pinned hash
            let found:i32=0;
            let same:i32=0;
            let qi:i32=0;
            while(qi<npages&&found==0){
                if(g32(ptbl,qi*24+8)==0){
                    let qo:i32=g32(ptbl,qi*24);let ql:i32=g32(ptbl,qi*24+4);
                    if(beq(arena[qo..qo+ql],rpid)==1){
                        found=1;
                        let mj:i32=g32(ptbl,qi*24+20);
                        if(mj>=0){
                            let ho:i32=g32(metatbl,mj*52+44);let hl:i32=g32(metatbl,mj*52+48);
                            if(beq(arena[ho..ho+hl],rhash)==1){same=1;}
                        }
                    }
                }
                qi=qi+1;
            }
            if(found==0||same==0){
                if(modlen>0){modlist[modlen]=44;modlen=modlen+1;}
                let k:i32=0;
                while(k<rpl){modlist[modlen]=rpid[k];modlen=modlen+1;k=k+1;}
            }
            ri=ri+1;
        }
        if(modlen>0){
            _zag_print("X|quarantine|exit|");_zag_print(caseid);
            _zag_print("|DROP_REJECTED|MODIFIED|pages=");
            _zag_print(modlist[0..modlen]);_zag_println("");
        } else {
            // --- 2. DROP: contradicting claim from older / authoritative source ---
            let contra_hit:i32=0;
            let contra_older:i32=0;
            if(has_contra==1&&beq(ncontra,nclaim)==0){
                if(word_overlap(nclaim,ncontra,nbuf)>=2){
                    // earliest quorum tfirst
                    let qmin:i32=2147483647;
                    let qi2:i32=0;
                    while(qi2<npages){
                        if(g32(ptbl,qi2*24+8)==0){
                            let mj2:i32=g32(ptbl,qi2*24+20);
                            if(mj2>=0){
                                let tf:i32=g32(metatbl,mj2*52+40);
                                if(tf<qmin){qmin=tf;}
                            }
                        }
                        qi2=qi2+1;
                    }
                    if(contra_tfirst<qmin){contra_older=1;}
                    if(contra_older==1||contra_auth==1){contra_hit=1;}
                }
            }
            if(contra_hit==1){
                _zag_print("X|quarantine|exit|");_zag_print(caseid);
                _zag_print("|DROP_REJECTED|CONTRA|older=");
                _zag_print(i64s(contra_older as i64));
                _zag_print("|auth=");_zag_print(i64s(contra_auth as i64));_zag_println("");
            } else {
                // --- 3. PROMOTE: new crawl, independent + legitimate external page ---
                let promo:i32=0;
                let promo_off:i32=0;let promo_len:i32=0;
                let ni:i32=0;
                while(ni<npages&&promo==0){
                    if(g32(ptbl,ni*24+8)==2){
                        if(page_votes(ptbl,ni,stbl,arena,nclaim)==1){
                            let mj3:i32=g32(ptbl,ni*24+20);
                            if(mj3>=0){
                                let tf3:i32=g32(metatbl,mj3*52+40);
                                if(tf3>0&&meta_indep(metatbl,mj3,ptbl,npages,arena)==1){
                                    if(page_nonclaim(ptbl,ni,stbl,arena,nclaim)>=divmin){
                                        promo=1;
                                        promo_off=g32(ptbl,ni*24);
                                        promo_len=g32(ptbl,ni*24+4);
                                    }
                                }
                            }
                        }
                    }
                    ni=ni+1;
                }
                if(promo==1){
                    _zag_print("X|quarantine|exit|");_zag_print(caseid);
                    _zag_print("|PROMOTE_SOLID|EXT_INDEP|page=");
                    _zag_print(arena[promo_off..promo_off+promo_len]);_zag_println("");
                    _zag_print("E|case=");_zag_print(caseid);
                    _zag_print("|state=SOLID|via=quarantine-exit|page=");
                    _zag_print(arena[promo_off..promo_off+promo_len]);
                    _zag_print("|label=externally corroborated by independent origin");
                    _zag_print("|propagate=1|search=plain");_zag_println("");
                } else {
                    // --- 4. TIME-DECAY: derived window from domain calibration ---
                    let lagbuf:[]u8=nio_alloc(64*4);
                    let nlag:i32=0;
                    let di:i32=0;
                    while(di<ndcal){
                        let do2:i32=g32(dctbl,di*16);let dl2:i32=g32(dctbl,di*16+4);
                        if(beq(arena[do2..do2+dl2],dom)==1){
                            let lo:i32=g32(dctbl,di*16+8);
                            let ln:i32=g32(dctbl,di*16+12);
                            let li:i32=0;
                            while(li<ln){p32(lagbuf,nlag*4,g32(arena,lo+li*4));nlag=nlag+1;li=li+1;}
                        }
                        di=di+1;
                    }
                    if(nlag==0){
                        // fallback: corpus-global lags
                        di=0;
                        while(di<ndcal){
                            let lo2:i32=g32(dctbl,di*16+8);
                            let ln2:i32=g32(dctbl,di*16+12);
                            let li2:i32=0;
                            while(li2<ln2){p32(lagbuf,nlag*4,g32(arena,lo2+li2*4));nlag=nlag+1;li2=li2+1;}
                            di=di+1;
                        }
                    }
                    let wdec:i32=0;
                    if(nlag>0){
                        let med:i32=imedian(lagbuf,nlag,nbuf);
                        wdec=mult*med;
                    }
                    let age:i32=tnow-tq;
                    if(nlag>0&&age>wdec){
                        _zag_print("X|quarantine|exit|");_zag_print(caseid);
                        _zag_print("|DROP_DECAYED|age=");_zag_print(i64s(age as i64));
                        _zag_print("|window=");_zag_print(i64s(wdec as i64));
                        _zag_print("|domain=");_zag_print(dom);_zag_println("");
                    } else {
                        _zag_print("X|quarantine|exit|");_zag_print(caseid);
                        _zag_print("|STAY_QUARANTINED|age=");_zag_print(i64s(age as i64));
                        _zag_print("|window=");_zag_print(i64s(wdec as i64));
                        _zag_print("|domain=");_zag_print(dom);_zag_println("");
                    }
                    nio_free(lagbuf);
                }
            }
        }
        nio_free(modlist);
    }
    nio_free(inb);nio_free(arena);nio_free(ptbl);nio_free(stbl);
    nio_free(metatbl);nio_free(archtbl);nio_free(rqtbl);nio_free(dctbl);
    nio_free(nbuf);
    return 0;
}

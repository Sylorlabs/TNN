// g7infra.zag — LI-HARDEN round 3, Crew B: g7 pin/citation infrastructure.
// Pure Zag, zero RNG, raw bytes, byte-identical reruns.
// Modes (argv[1]): g7infra (verdict) | measure (calibration: claim lengths).
// Bundle on stdin: NEED| U| P| <sentence> M|pid|k=v CPIN| APIN| CALIB| PINB|.
// Design: PINFRA_SPEC.md. Prereg: PREREG_G7.md.
@import("R33_NATIVE_SHA256_V2.zag")

// ---------- helpers (ported from BEYOND base, byte-identical semantics) ----------
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}
fn p32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn beq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn bsub(h:[]u8,n:[]u8)i32 {
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let j:i32=0;
        while(j<n.len){if(h[i+j]!=n[j]){break;}j=j+1;}
        if(j==n.len){return 1;}
        i=i+1;
    }
    return 0;
}
fn bcmp(a:[]u8,b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){n=b.len;}
    let i:i32=0;
    while(i<n){
        if(a[i]<b[i]){return -1;}
        if(a[i]>b[i]){return 1;}
        i=i+1;
    }
    if(a.len<b.len){return -1;}
    if(a.len>b.len){return 1;}
    return 0;
}
fn is_punct(c:u8)i32 {
    if(c==46||c==44||c==33||c==63||c==59||c==58||c==39||c==34){return 1;}
    if(c==40||c==41||c==91||c==93||c==123||c==125){return 1;}
    if(c==45||c==95||c==47||c==92||c==124||c==64||c==35){return 1;}
    if(c==36||c==37||c==94||c==38||c==42||c==43||c==61||c==126){return 1;}
    if(c==96||c==60||c==62){return 1;}
    return 0;
}
fn is_digit(c:u8)i32 {
    if(c>=48&&c<=57){return 1;}
    return 0;
}
// normalize: lowercase ASCII, punct->space, drop ASCII controls,
// keep bytes>=128 significant; collapse spaces; pad with one space each end.
fn normalize(s:[]u8,out:[]u8)i32 {
    let w:i32=1;
    out[0]=32;
    let i:i32=0;
    let last_sp:i32=1;
    while(i<s.len){
        let c:u8=s[i];
        if(c<32){
            i=i+1;
            continue;
        }
        if(c==39){
            if(w>1&&out[w-1]==110&&i+1<s.len&&s[i+1]==116){
                let a2:i32=i+2;
                let boundary:i32=0;
                if(a2>=s.len){boundary=1;}
                else{
                    let nc:u8=s[a2];
                    if(nc==32||nc<32||is_punct(nc)==1){boundary=1;}
                }
                if(boundary==1){
                    out[w-1]=32;
                    out[w]=110;out[w+1]=111;out[w+2]=116;
                    w=w+3;last_sp=0;
                    i=i+2;
                    continue;
                }
            }
            if(last_sp==0){out[w]=32;w=w+1;last_sp=1;}
            i=i+1;
            continue;
        }
        if(is_punct(c)==1){
            if(last_sp==0){out[w]=32;w=w+1;last_sp=1;}
            i=i+1;
            continue;
        }
        if(c==32){
            if(last_sp==0){out[w]=32;w=w+1;last_sp=1;}
            i=i+1;
            continue;
        }
        if(c>=65&&c<=90){out[w]=c+32;}
        else{out[w]=c;}
        w=w+1;last_sp=0;
        i=i+1;
    }
    if(last_sp==0){out[w]=32;w=w+1;}
    return w;
}
fn read_stdin(b:[]u8)i32 {
    let at:i32=0;
    while(at<b.len){
        let n:i64=_zag_raw_syscall(0,0,(_zag_slice_ptr(b) as i64)+(at as i64),(b.len-at) as i64,0,0,0);
        if(n<=0){break;}
        at=(at as i64+n) as i32;
    }
    return at;
}
fn in_list(tok:[]u8,list:[]u8)i32 {
    let i:i32=0;
    let start:i32=0;
    while(i<list.len){
        if(list[i]==124){
            let piece:[]u8=list[start..i];
            if(beq(tok,piece)==1){return 1;}
            start=i+1;
        }
        i=i+1;
    }
    if(beq(tok,list[start..list.len])==1){return 1;}
    return 0;
}
fn stopword(w:[]u8)i32 {
    return in_list(w,"the|a|an|is|are|was|were|be|been|being|of|to|in|on|for|and|or|that|this|these|those|it|its|at|by|as|from|with|what|how|when|where|who|which|do|does|did|can|could|would|should|have|has|had|not|no|than|then|so|such|into|out|up|all|any|each|more|most|other|some|only|over|under|again|once|here|there|their|them|they|we|you|your|his|her|our|my|me|him|us|the");
}
fn words_of(s:[]u8,tab:[]u8,maxw:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len&&n<maxw){
        while(i<s.len&&s[i]==32){i=i+1;}
        if(i>=s.len){break;}
        let st:i32=i;
        while(i<s.len&&s[i]!=32){i=i+1;}
        p32(tab,n*8,st);
        p32(tab,n*8+4,i-st);
        n=n+1;
    }
    return n;
}
fn wcount(s:[]u8)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len){
        while(i<s.len&&s[i]==32){i=i+1;}
        if(i>=s.len){break;}
        n=n+1;
        while(i<s.len&&s[i]!=32){i=i+1;}
    }
    return n;
}
fn word_at(s:[]u8,tab:[]u8,k:i32)[]u8 {
    let st:i32=g32(tab,k*8);
    let ln:i32=g32(tab,k*8+4);
    return s[st..st+ln];
}
fn content_words(s:[]u8,wtab:[]u8,nw:i32,ctab:[]u8)i32 {
    let n:i32=0;
    let k:i32=0;
    while(k<nw){
        let w:[]u8=word_at(s,wtab,k);
        if(stopword(w)==0){
            let alldig:i32=1;
            let j:i32=0;
            while(j<w.len){if(is_digit(w[j])==0){alldig=0;break;}j=j+1;}
            if(alldig==0||w.len==0){
                p32(ctab,n*8,g32(wtab,k*8));
                p32(ctab,n*8+4,g32(wtab,k*8+4));
                n=n+1;
            }
        }
        k=k+1;
    }
    return n;
}
fn cword_at(s:[]u8,ctab:[]u8,k:i32)[]u8 {
    let st:i32=g32(ctab,k*8);
    let ln:i32=g32(ctab,k*8+4);
    return s[st..st+ln];
}
fn shared_cw(s:[]u8,claim:[]u8,ctab:[]u8,nc:i32) i32 {
    let wt:[]u8=nio_alloc(64*8);
    let nw:i32=words_of(s,wt,64);
    let ct:[]u8=nio_alloc(64*8);
    let n2:i32=content_words(s,wt,nw,ct);
    let sh:i32=0;
    let k:i32=0;
    while(k<nc){
        let cw:[]u8=cword_at(claim,ctab,k);
        let j:i32=0;
        let found:i32=0;
        while(j<n2){
            if(beq(cw,cword_at(s,ct,j))==1){found=1;break;}
            j=j+1;
        }
        if(found==1){sh=sh+1;}
        k=k+1;
    }
    nio_free(wt);
    nio_free(ct);
    return sh;
}
fn host_of(url:[]u8,out:[]u8)i32 {
    let i:i32=0;
    let st:i32=0;
    while(i+2<url.len){
        if(url[i]==58&&url[i+1]==47&&url[i+2]==47){st=i+3;break;}
        i=i+1;
    }
    let e:i32=st;
    while(e<url.len&&url[e]!=47){e=e+1;}
    let k:i32=0;
    while(st+k<e){out[k]=url[st+k];k=k+1;}
    return k;
}
fn split2(line:[]u8,sep:u8,a:[]u8,b:[]u8)i32 {
    let i:i32=0;
    while(i<line.len){if(line[i]==sep){break;}i=i+1;}
    if(i>=line.len){return 0;}
    let j:i32=0;
    while(j<i){a[j]=line[j];j=j+1;}
    let k:i32=0;
    while(i+1+k<line.len){b[k]=line[i+1+k];k=k+1;}
    p32(a,1020,j);
    p32(b,1020,k);
    return 1;
}
fn atoi(s:[]u8)i32 {
    let v:i32=0;
    let i:i32=0;
    while(i<s.len&&s[i]>=48&&s[i]<=57){v=v*10+((s[i]-48) as i32);i=i+1;}
    return v;
}
// line kinds: 1=NEED 2=U 3=P 4=M 8=CPIN 9=APIN 10=CALIB 11=PINB 0=sentence
fn parse_line_kind(line:[]u8)i32 {
    if(line.len>=5&&line[0]==78&&line[1]==69&&line[2]==69&&line[3]==68&&line[4]==124){return 1;}
    if(line.len>=5&&line[0]==67&&line[1]==80&&line[2]==73&&line[3]==78&&line[4]==124){return 8;}
    if(line.len>=5&&line[0]==65&&line[1]==80&&line[2]==73&&line[3]==78&&line[4]==124){return 9;}
    if(line.len>=6&&line[0]==67&&line[1]==65&&line[2]==76&&line[3]==73&&line[4]==66&&line[5]==124){return 10;}
    if(line.len>=5&&line[0]==80&&line[1]==73&&line[2]==78&&line[3]==66&&line[4]==124){return 11;}
    if(line.len>=2&&line[0]==85&&line[1]==124){return 2;}
    if(line.len>=2&&line[0]==77&&line[1]==124){return 4;}
    if(line.len>=2&&line[0]==80&&line[1]==124){return 3;}
    return 0;
}
// sha256 verify: 1 iff sha256(bytes) hex-equals expect (64 chars)
fn sha_ok(bytes:[]u8,expect:[]u8) i32 {
    if(expect.len!=64){return 0;}
    let dig:[]u8=nio_alloc(32);
    if(dig.len!=32){return 0;}
    if(ns_sha256(bytes,dig)!=0){nio_free(dig);return 0;}
    let hx:[]u8=ns_hex(dig);
    nio_free(dig);
    let r:i32=beq(hx,expect);
    nio_free(hx);
    return r;
}
// parse "L0=<n>" from a calibration payload; -1 if absent
fn parse_l0(payload:[]u8) i32 {
    let i:i32=0;
    while(i+3<payload.len){
        if(payload[i]==76&&payload[i+1]==48&&payload[i+2]==61){
            return atoi(payload[i+3..payload.len]);
        }
        i=i+1;
    }
    return -1;
}

// copy src into arena at at; returns new at
fn acopy(arena:[]u8,at:i32,src:[]u8) i32 {
    let i:i32=0;
    while(i<src.len){arena[at+i]=src[i];i=i+1;}
    return at+src.len;
}
// find page index by pid; -1 if absent
fn find_page(ptbl:[]u8,npages:i32,arena:[]u8,pid:[]u8) i32 {
    let i:i32=0;
    while(i<npages){
        let po:i32=g32(ptbl,i*40);
        let pl:i32=g32(ptbl,i*40+4);
        if(beq(arena[po..po+pl],pid)==1){return i;}
        i=i+1;
    }
    return -1;
}
// find pin descriptor by name; -1 if absent
fn find_pin(pintbl:[]u8,npin:i32,arena:[]u8,name:[]u8) i32 {
    let i:i32=0;
    while(i<npin){
        let no:i32=g32(pintbl,i*52+16);
        let nl:i32=g32(pintbl,i*52+20);
        if(beq(arena[no..no+nl],name)==1){return i;}
        i=i+1;
    }
    return -1;
}
fn main()i32 {
    let mode0:[]u8=_zag_arg(1);
    let mode:[]u8=mode0;
    if(mode.len>0&&mode[mode.len-1]==10){mode=mode[0..mode.len-1];}
    if(mode.len>0&&mode[mode.len-1]==13){mode=mode[0..mode.len-1];}
    let inb:[]u8=nio_alloc(1048576);
    let inlen:i32=read_stdin(inb);
    let arena:[]u8=nio_alloc(524288);
    let apos:i32=0;
    let ptbl:[]u8=nio_alloc(16*40);
    let stbl:[]u8=nio_alloc(512*12);
    let pintbl:[]u8=nio_alloc(16*52);
    let archtbl:[]u8=nio_alloc(512*12);
    let npages:i32=0;
    let nsent:i32=0;
    let npin:i32=0;
    let narch:i32=0;
    let need_off:i32=0;
    let need_len:i32=0;
    let nbuf:[]u8=nio_alloc(4096);
    let nbuf2:[]u8=nio_alloc(65536);
    let tmp:[]u8=nio_alloc(4096);
    let tmp2:[]u8=nio_alloc(4096);
    let utbl:[]u8=nio_alloc(16*16);
    let nurl:i32=0;
    let pos:i32=0;
    let curpage:i32=-1;
    let exp_pay:i32=-1;
    while(pos<inlen){
        let eol:i32=pos;
        while(eol<inlen&&inb[eol]!=10){eol=eol+1;}
        let line:[]u8=inb[pos..eol];
        if(line.len>0&&line[line.len-1]==13){line=line[0..line.len-1];}
        if(exp_pay>=0){
            // payload line for the pin descriptor exp_pay
            let shoff:i32=g32(pintbl,exp_pay*52+24);
            let shlen:i32=g32(pintbl,exp_pay*52+28);
            let ok:i32=0;
            if(shoff>=0){ok=sha_ok(line,arena[shoff..shoff+shlen]);}
            p32(pintbl,exp_pay*52+32,ok);
            p32(pintbl,exp_pay*52+36,apos);
            p32(pintbl,exp_pay*52+40,line.len);
            apos=acopy(arena,apos,line);
            exp_pay=-1;
            pos=eol+1;
            continue;
        }
        let k:i32=parse_line_kind(line);
        if(k==1){
            need_off=apos;
            need_len=line.len-5;
            apos=acopy(arena,apos,line[5..line.len]);
        } else {
            if(k==2){
                let rest:[]u8=line[2..line.len];
                if(split2(rest,124,tmp,tmp2)==1&&nurl<16){
                    let pl:i32=g32(tmp,1020);
                    let ul:i32=g32(tmp2,1020);
                    p32(utbl,nurl*16,apos);
                    p32(utbl,nurl*16+4,pl);
                    apos=acopy(arena,apos,tmp[0..pl]);
                    p32(utbl,nurl*16+8,apos);
                    p32(utbl,nurl*16+12,ul);
                    apos=acopy(arena,apos,tmp2[0..ul]);
                    nurl=nurl+1;
                }
            } else {
                if(k==3){
                    let pid:[]u8=line[2..line.len];
                    if(npages<16){
                        p32(ptbl,npages*40,apos);
                        p32(ptbl,npages*40+4,pid.len);
                        apos=acopy(arena,apos,pid);
                        p32(ptbl,npages*40+8,0);
                        p32(ptbl,npages*40+12,0);
                        p32(ptbl,npages*40+16,0);
                        p32(ptbl,npages*40+20,0);
                        p32(ptbl,npages*40+24,-1);
                        p32(ptbl,npages*40+28,0);
                        p32(ptbl,npages*40+32,0);
                        curpage=npages;
                        npages=npages+1;
                    }
                } else {
                    if(k==4){
                        let mrest:[]u8=line[2..line.len];
                        if(split2(mrest,124,tmp,tmp2)==1){
                            let mpl:i32=g32(tmp,1020);
                            let mrl:i32=g32(tmp2,1020);
                            let found:i32=find_page(ptbl,npages,arena,tmp[0..mpl]);
                            if(found>=0){
                                let kv:[]u8=tmp2[0..mrl];
                                let a:i32=0;
                                while(a<kv.len){
                                    let b:i32=a;
                                    while(b<kv.len&&kv[b]!=124){b=b+1;}
                                    let piece:[]u8=kv[a..b];
                                    let eq:i32=0;
                                    while(eq<piece.len&&piece[eq]!=61){eq=eq+1;}
                                    if(eq<piece.len){
                                        let key:[]u8=piece[0..eq];
                                        let val:[]u8=piece[eq+1..piece.len];
                                        if(beq(key,"FETCH")==1){
                                            p32(ptbl,found*40+24,atoi(val));
                                        } else {
                                            if(beq(key,"CITE")==1){
                                                p32(ptbl,found*40+28,apos);
                                                p32(ptbl,found*40+32,val.len);
                                                apos=acopy(arena,apos,val);
                                            }
                                        }
                                    }
                                    a=b+1;
                                }
                            }
                        }
                    } else {
                        if(k==8||k==9){
                            // CPIN|url|fetched_at|name  / APIN|url|fetched_at|name
                            let rest:[]u8=line[5..line.len];
                            if(split2(rest,124,tmp,tmp2)==1&&npin<16){
                                let ul2:i32=g32(tmp,1020);
                                // copy url to arena BEFORE tmp is reused
                                let url_at:i32=apos;
                                apos=acopy(arena,apos,tmp[0..ul2]);
                                let rl:i32=g32(tmp2,1020);
                                // copy "fetched_at|name" aside: tmp2 will be reused
                                let r2_at:i32=apos;
                                apos=acopy(arena,apos,tmp2[0..rl]);
                                let rest2:[]u8=arena[r2_at..r2_at+rl];
                                if(split2(rest2,124,tmp,tmp2)==1){
                                    let fl:i32=g32(tmp,1020);
                                    let nl2:i32=g32(tmp2,1020);
                                    if(k==8){p32(pintbl,npin*52,1);}
                                    else{p32(pintbl,npin*52,2);}
                                    p32(pintbl,npin*52+4,url_at);
                                    p32(pintbl,npin*52+8,ul2);
                                    p32(pintbl,npin*52+12,atoi(tmp[0..fl]));
                                    p32(pintbl,npin*52+16,apos);
                                    p32(pintbl,npin*52+20,nl2);
                                    apos=acopy(arena,apos,tmp2[0..nl2]);
                                    p32(pintbl,npin*52+24,-1);
                                    p32(pintbl,npin*52+28,0);
                                    p32(pintbl,npin*52+32,0);
                                    p32(pintbl,npin*52+36,0);
                                    p32(pintbl,npin*52+40,0);
                                    p32(pintbl,npin*52+44,0);
                                    p32(pintbl,npin*52+48,0);
                                    npin=npin+1;
                                }
                            }
                        } else {
                            if(k==10){
                                let nm:[]u8=line[6..line.len];
                                if(npin<16){
                                    p32(pintbl,npin*52,3);
                                    p32(pintbl,npin*52+4,0);
                                    p32(pintbl,npin*52+8,0);
                                    p32(pintbl,npin*52+12,0);
                                    p32(pintbl,npin*52+16,apos);
                                    p32(pintbl,npin*52+20,nm.len);
                                    apos=acopy(arena,apos,nm);
                                    p32(pintbl,npin*52+24,-1);
                                    p32(pintbl,npin*52+28,0);
                                    p32(pintbl,npin*52+32,0);
                                    p32(pintbl,npin*52+36,0);
                                    p32(pintbl,npin*52+40,0);
                                    p32(pintbl,npin*52+44,0);
                                    p32(pintbl,npin*52+48,0);
                                    npin=npin+1;
                                }
                            } else {
                                if(k==11){
                                    let rest:[]u8=line[5..line.len];
                                    if(split2(rest,124,tmp,tmp2)==1){
                                        let nl3:i32=g32(tmp,1020);
                                        let sl:i32=g32(tmp2,1020);
                                        let fi:i32=find_pin(pintbl,npin,arena,tmp[0..nl3]);
                                        if(fi>=0){
                                            p32(pintbl,fi*52+24,apos);
                                            p32(pintbl,fi*52+28,sl);
                                            apos=acopy(arena,apos,tmp2[0..sl]);
                                            exp_pay=fi;
                                        }
                                    }
                                } else {
                                    if(line.len>0&&curpage>=0&&nsent<512){
                                        let nl4:i32=normalize(line,nbuf);
                                        if(nl4>2){
                                            p32(stbl,nsent*12,curpage);
                                            p32(stbl,nsent*12+4,apos);
                                            p32(stbl,nsent*12+8,nl4);
                                            apos=acopy(arena,apos,nbuf[0..nl4]);
                                            nsent=nsent+1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        pos=eol+1;
    }
    // attach urls+hosts to pages by pid
    let pi:i32=0;
    while(pi<npages){
        let po:i32=g32(ptbl,pi*40);
        let pl2:i32=g32(ptbl,pi*40+4);
        let pid:[]u8=arena[po..po+pl2];
        let u:i32=0;
        while(u<nurl){
            let uo:i32=g32(utbl,u*16);
            let ul3:i32=g32(utbl,u*16+4);
            if(beq(pid,arena[uo..uo+ul3])==1){
                let vo:i32=g32(utbl,u*16+8);
                let vl:i32=g32(utbl,u*16+12);
                p32(ptbl,pi*40+8,vo);
                p32(ptbl,pi*40+12,vl);
                let hl:i32=host_of(arena[vo..vo+vl],tmp);
                p32(ptbl,pi*40+16,apos);
                p32(ptbl,pi*40+20,hl);
                apos=acopy(arena,apos,tmp[0..hl]);
                break;
            }
            u=u+1;
        }
        pi=pi+1;
    }
    let need:[]u8=arena[need_off..need_off+need_len];
    let nnl:i32=normalize(need,nbuf);
    let needn:[]u8=nbuf[0..nnl];
    let nwt:[]u8=nio_alloc(64*8);
    let nnw:i32=words_of(needn,nwt,64);
    let nct:[]u8=nio_alloc(64*8);
    let nnc:i32=content_words(needn,nwt,nnw,nct);
    // claim selection: max (pagecount, need-overlap), tie -> lexicographic min
    let best:i32=-1;
    let bestc:i32=-1;
    let besto:i32=-1;
    let si:i32=0;
    while(si<nsent){
        let so:i32=g32(stbl,si*12+4);
        let sl:i32=g32(stbl,si*12+8);
        let s:[]u8=arena[so..so+sl];
        let seen:i32=0;
        let j:i32=0;
        while(j<si){
            let jo:i32=g32(stbl,j*12+4);
            let jl:i32=g32(stbl,j*12+8);
            if(beq(s,arena[jo..jo+jl])==1){seen=1;break;}
            j=j+1;
        }
        if(seen==0){
            let pc:i32=0;
            let lastpg:i32=-1;
            let k2:i32=0;
            while(k2<nsent){
                let ko:i32=g32(stbl,k2*12+4);
                let kl:i32=g32(stbl,k2*12+8);
                if(beq(s,arena[ko..ko+kl])==1){
                    let pg:i32=g32(stbl,k2*12);
                    if(pg!=lastpg){pc=pc+1;lastpg=pg;}
                }
                k2=k2+1;
            }
            let ov:i32=shared_cw(s,needn,nct,nnc);
            let take:i32=0;
            if(pc>bestc){take=1;}
            else{
                if(pc==bestc){
                    if(ov>besto){take=1;}
                    else{
                        if(ov==besto&&best>=0){
                            let bo:i32=g32(stbl,best*12+4);
                            let bl:i32=g32(stbl,best*12+8);
                            if(bcmp(s,arena[bo..bo+bl])<0){take=1;}
                        }
                    }
                }
            }
            if(take==1){best=si;bestc=pc;besto=ov;}
        }
        si=si+1;
    }
    let gate:[]u8="NONE";
    let verdict:i32=0;
    let nvotes:i32=0;
    let nhost:i32=0;
    let votemask:i32=0;
    let claim_len:i32=0;
    if(best<0){
        gate="QUORUM";
    } else {
        let bo2:i32=g32(stbl,best*12+4);
        let bl2:i32=g32(stbl,best*12+8);
        let claim:[]u8=arena[bo2..bo2+bl2];
        claim_len=bl2;
        let vi:i32=0;
        while(vi<nsent){
            let vo2:i32=g32(stbl,vi*12+4);
            let vl2:i32=g32(stbl,vi*12+8);
            if(beq(claim,arena[vo2..vo2+vl2])==1){
                let pg2:i32=g32(stbl,vi*12);
                votemask=votemask|(1<<pg2);
            }
            vi=vi+1;
        }
        let hostseen:[]u8=nio_alloc(16*64);
        let hseel:[]u8=nio_alloc(16*4);
        let p3:i32=0;
        while(p3<npages){
            if((votemask&(1<<p3))!=0){
                nvotes=nvotes+1;
                let ho:i32=g32(ptbl,p3*40+16);
                let hl3:i32=g32(ptbl,p3*40+20);
                let h:[]u8=arena[ho..ho+hl3];
                let f2:i32=0;
                let q6:i32=0;
                while(q6<nhost){
                    let el6:i32=g32(hseel,q6*4);
                    if(el6==h.len&&beq(h,hostseen[q6*64..q6*64+el6])==1){f2=1;break;}
                    q6=q6+1;
                }
                if(f2==0){
                    let q7:i32=0;
                    while(q7<h.len){hostseen[nhost*64+q7]=h[q7];q7=q7+1;}
                    p32(hseel,nhost*4,h.len);
                    nhost=nhost+1;
                }
            }
            p3=p3+1;
        }
        nio_free(hostseen);
        nio_free(hseel);
        if(beq(mode,"measure")==1){
            _zag_print("M|claim_bytes=");
            _zag_print(i64s(claim_len as i64));
            _zag_print("|claim_words=");
            _zag_print(i64s(wcount(claim) as i64));
            _zag_print("|nvotes=");
            _zag_print(i64s(nvotes as i64));
            _zag_print("|nhost=");
            _zag_println(i64s(nhost as i64));
            nio_free(inb);
            return 0;
        }
        if(beq(mode,"g7infra")==1||beq(mode,"base")==1){
            // ---- pin verification tally + calibration ----
            let pinok:i32=0;
            let pinbad:i32=0;
            let qi:i32=0;
            while(qi<npin){
                let haspay:i32=g32(pintbl,qi*52+40);
                if(g32(pintbl,qi*52+32)==1&&haspay>0){pinok=pinok+1;}
                else{pinbad=pinbad+1;}
                qi=qi+1;
            }
            let l0:i32=-1;
            let qj:i32=0;
            while(qj<npin){
                if(g32(pintbl,qj*52)==3&&g32(pintbl,qj*52+32)==1){
                    let cpo:i32=g32(pintbl,qj*52+36);
                    let cpl:i32=g32(pintbl,qj*52+40);
                    l0=parse_l0(arena[cpo..cpo+cpl]);
                }
                qj=qj+1;
            }
            if(l0<0){
                _zag_print("V|");
                _zag_print(mode);
                _zag_print("|WITHHOLD|NOCALIB|0|0|L0=-1|pinok=");
                _zag_print(i64s(pinok as i64));
                _zag_print("|pinbad=");
                _zag_println(i64s(pinbad as i64));
                nio_free(inb);
                return 0;
            }
            // ---- normalize verified pin payloads; build archive table ----
            let qp:i32=0;
            while(qp<npin){
                if(g32(pintbl,qp*52+32)==1){
                    let ppo:i32=g32(pintbl,qp*52+36);
                    let ppl:i32=g32(pintbl,qp*52+40);
                    let pnl:i32=normalize(arena[ppo..ppo+ppl],nbuf2);
                    p32(pintbl,qp*52+44,apos);
                    p32(pintbl,qp*52+48,pnl);
                    apos=acopy(arena,apos,nbuf2[0..pnl]);
                    if(g32(pintbl,qp*52)==2){
                        // archive pin: split RAW payload on . ! ? then normalize pieces
                        let pp:[]u8=arena[ppo..ppo+ppl];
                        let pfa:i32=g32(pintbl,qp*52+12);
                        let sst:i32=0;
                        let qq:i32=0;
                        while(qq<=pp.len&&narch<512){
                            if(qq==pp.len||pp[qq]==46||pp[qq]==33||pp[qq]==63){
                                if(qq>sst){
                                    let nl5:i32=normalize(pp[sst..qq],nbuf);
                                    if(nl5>2){
                                        p32(archtbl,narch*12,apos);
                                        p32(archtbl,narch*12+4,nl5);
                                        p32(archtbl,narch*12+8,pfa);
                                        apos=acopy(arena,apos,nbuf[0..nl5]);
                                        narch=narch+1;
                                    }
                                }
                                sst=qq+1;
                            }
                            qq=qq+1;
                        }
                    }
                }
                qp=qp+1;
            }
            // ---- g7infra gate (base mode skips the gate: A/B comparison) ----
            if(beq(mode,"g7infra")==1&&claim_len>=l0&&nhost>=3){
                // min fetch over voters; fail closed if any voter lacks FETCH
                let minf:i32=2147483647;
                let qv:i32=0;
                while(qv<npages){
                    if((votemask&(1<<qv))!=0){
                        let fv:i32=g32(ptbl,qv*40+24);
                        if(fv<0){minf=-1;}
                        else{if(fv<minf){minf=fv;}}
                    }
                    qv=qv+1;
                }
                let cite_ex:i32=0;
                let arch_ex:i32=0;
                if(minf>=0){
                    // citation exemption: one shared CITE, verified older pin contains claim
                    let cite0o:i32=-1;
                    let cite0l:i32=0;
                    let cite_bad:i32=0;
                    let qw:i32=0;
                    while(qw<npages){
                        if((votemask&(1<<qw))!=0){
                            let co:i32=g32(ptbl,qw*40+28);
                            let cl:i32=g32(ptbl,qw*40+32);
                            if(cl==0){cite_bad=1;}
                            else{
                                if(cite0o<0){cite0o=co;cite0l=cl;}
                                else{
                                    if(cl!=cite0l||beq(arena[co..co+cl],arena[cite0o..cite0o+cite0l])==0){
                                        cite_bad=1;
                                    }
                                }
                            }
                        }
                        qw=qw+1;
                    }
                    if(cite_bad==0&&cite0o>=0){
                        let cite:[]u8=arena[cite0o..cite0o+cite0l];
                        let qc:i32=0;
                        while(qc<npin&&cite_ex==0){
                            if(g32(pintbl,qc*52)==1&&g32(pintbl,qc*52+32)==1){
                                let uo:i32=g32(pintbl,qc*52+4);
                                let ul4:i32=g32(pintbl,qc*52+8);
                                if(beq(arena[uo..uo+ul4],cite)==1&&g32(pintbl,qc*52+12)<minf){
                                    let no:i32=g32(pintbl,qc*52+44);
                                    let nl6:i32=g32(pintbl,qc*52+48);
                                    if(bsub(arena[no..no+nl6],claim)==1){cite_ex=1;}
                                }
                            }
                            qc=qc+1;
                        }
                    }
                    // archived-presence exemption
                    let qa:i32=0;
                    while(qa<narch&&arch_ex==0){
                        let ao:i32=g32(archtbl,qa*12);
                        let al:i32=g32(archtbl,qa*12+4);
                        if(g32(archtbl,qa*12+8)<minf&&beq(arena[ao..ao+al],claim)==1){
                            arch_ex=1;
                        }
                        qa=qa+1;
                    }
                }
                if(cite_ex==0&&arch_ex==0){gate="COPYCOLLAPSE";}
            }
            if(beq(gate,"NONE")==1){
                if(nvotes>=2&&nhost>=2){verdict=1;}
                else{gate="QUORUM";}
            } else {
                verdict=0;
            }
            _zag_print("V|");
            _zag_print(mode);
            _zag_print("|");
            if(verdict==1){_zag_print("INSTALL|");}else{_zag_print("WITHHOLD|");}
            _zag_print(gate);
            _zag_print("|");
            _zag_print(i64s(nvotes as i64));
            _zag_print("|");
            _zag_print(i64s(nhost as i64));
            _zag_print("|L0=");
            _zag_print(i64s(l0 as i64));
            _zag_print("|pinok=");
            _zag_print(i64s(pinok as i64));
            _zag_print("|pinbad=");
            _zag_println(i64s(pinbad as i64));
            nio_free(inb);
            return 0;
        }
    }
    _zag_print("V|");
    _zag_print(mode);
    _zag_print("|WITHHOLD|MODE|0|0");
    _zag_println("");
    nio_free(inb);
    return 0;
}

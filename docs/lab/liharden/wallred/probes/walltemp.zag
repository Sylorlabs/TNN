// walltemp.zag — WALL-RED probe 4: temporal burst / history depth.
// For the winning quorum, reads HISTORY (pid|first_seen|last_seen|obs) and
// reports burst_span = max(first_seen)-min(first_seen) and depth =
// min(last_seen-first_seen) over the quorum, plus novel = (depth < 30d).
// Tests whether temporal features separate wall campaigns from honest
// breaking news (expected: they do NOT) and from established truth
// (expected: history separates old from novel, not true from false).
// Usage: walltemp <case.flat.txt>
// Pure Zag, zero RNG, deterministic.
@import("R33_NATIVE_IO_V1.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}

fn next_line(b:[]u8,pos:*i32,ls:*i32,ll:*i32)i32 {
    if(pos[0]>=b.len){return 0;}
    let s:i32=pos[0];
    let e:i32=s;
    while(e<b.len && b[e]!=10){e=e+1;}
    ls[0]=s;
    ll[0]=e-s;
    if(e<b.len){pos[0]=e+1;}else{pos[0]=e;}
    return 1;
}

fn read_file(dir:[]u8,name:[]u8,ok:*i32)[]u8 {
    ok[0]=0;
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){nio_close(fd); return "";}
    let n:i64=nio_read_exact(fd,buf,1048575);
    nio_close(fd);
    if(n<0){nio_free(buf); return "";}
    ok[0]=1;
    let nn:i32=n as i32;
    return buf[0..nn];
}

fn read_path(path:[]u8,ok:*i32)[]u8 {
    let k:i32=path.len-1;
    while(k>=0 && path[k]!=47){k=k-1;}
    if(k<0){return read_file(".",path,ok);}
    let dir:[]u8=path[0..k];
    let name:[]u8=path[k+1..path.len];
    if(k==0){dir="/";}
    return read_file(dir,name,ok);
}

fn starts(h:[]u8,pre:[]u8)i32 {
    if(h.len<pre.len){return 0;}
    return nio_equal(h[0..pre.len],pre);
}

fn ends(h:[]u8,suf:[]u8)i32 {
    if(h.len<suf.len){return 0;}
    return nio_equal(h[h.len-suf.len..h.len],suf);
}

fn contains(h:[]u8,n:[]u8)i32 {
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        if(nio_equal(h[i..i+n.len],n)==1){return 1;}
        i=i+1;
    }
    return 0;
}

fn in_q(qv:[]u8,pid:[]u8)i32 {
    if(nio_equal(qv,pid)==1){return 1;}
    if(starts(qv,pid)==1 && qv.len>pid.len && qv[pid.len]==32){return 1;}
    if(ends(qv,pid)==1 && qv.len>pid.len && qv[qv.len-pid.len-1]==32){return 1;}
    let mid:[]u8=nio_alloc(pid.len+2);
    if(mid.len==0){return 0;}
    mid[0]=32;
    let i:i32=0;
    while(i<pid.len){mid[i+1]=pid[i]; i=i+1;}
    mid[pid.len+1]=32;
    let r:i32=contains(qv,mid);
    nio_free(mid);
    return r;
}

fn atoi(s:[]u8)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<s.len){
        let b:i32=s[i] as i32;
        if(b>=48 && b<=57){v=v*10+(b-48) as i64;}
        i=i+1;
    }
    return v;
}

// field f of '|' separated line
fn field(ln:[]u8,f:i32)[]u8 {
    let i:i32=0;
    let cur:i32=0;
    let s:i32=0;
    while(i<=ln.len){
        let atend:i32=0;
        if(i==ln.len){atend=1;}
        let isbar:i32=0;
        if(atend==0){
            if(ln[i]==124){isbar=1;}
        }
        if(atend==1 || isbar==1){
            if(cur==f){return ln[s..i];}
            cur=cur+1;
            s=i+1;
        }
        i=i+1;
    }
    return "";
}

fn main()i32 {
    let path:[]u8=_zag_arg(1);
    if(path.len==0){_zag_print("usage: walltemp <case.flat.txt>\n"); return 2;}
    let ok:i32=0;
    let pok:*i32=&ok;
    let buf:[]u8=read_path(path,pok);
    if(ok==0){_zag_print("ERR|cannot read file\n"); return 1;}

    let casename:[]u8="";
    let quorum:[]u8="";
    let fs0:i64=0; let fs1:i64=0; let fs2:i64=0; let fs3:i64=0;
    let dp0:i64=0; let dp1:i64=0; let dp2:i64=0; let dp3:i64=0;
    let nq:i32=0;

    let pos:i32=0; let ls:i32=0; let ll:i32=0;
    let ppos:*i32=&pos; let pls:*i32=&ls; let pll:*i32=&ll;
    let sect:i32=0;
    while(next_line(buf,ppos,pls,pll)==1){
        let ln:[]u8=buf[ls..ls+ll];
        if(nio_equal(ln,"URLS")==1){sect=1; continue;}
        if(nio_equal(ln,"META")==1){sect=2; continue;}
        if(nio_equal(ln,"ORDER")==1){sect=3; continue;}
        if(nio_equal(ln,"PAGES")==1){sect=4; continue;}
        if(nio_equal(ln,"SNIPPETS")==1){sect=5; continue;}
        if(nio_equal(ln,"HISTORY")==1){sect=6; continue;}
        if(nio_equal(ln,"END")==1){break;}
        if(sect==0){
            if(starts(ln,"CASE|")==1){casename=ln[5..ln.len];}
            if(starts(ln,"QUORUM|")==1){quorum=ln[7..ln.len];}
            continue;
        }
        if(sect==6){
            let pid:[]u8=field(ln,0);
            if(in_q(quorum,pid)==1 && nq<4){
                let fs:i64=atoi(field(ln,1));
                let lsv:i64=atoi(field(ln,2));
                if(nq==0){fs0=fs; dp0=lsv-fs;}
                if(nq==1){fs1=fs; dp1=lsv-fs;}
                if(nq==2){fs2=fs; dp2=lsv-fs;}
                if(nq==3){fs3=fs; dp3=lsv-fs;}
                nq=nq+1;
            }
            continue;
        }
    }

    let mn:i64=fs0; let mx:i64=fs0; let md:i64=dp0;
    if(nq>1){
        if(fs1<mn){mn=fs1;} if(fs1>mx){mx=fs1;} if(dp1<md){md=dp1;}
    }
    if(nq>2){
        if(fs2<mn){mn=fs2;} if(fs2>mx){mx=fs2;} if(dp2<md){md=dp2;}
    }
    if(nq>3){
        if(fs3<mn){mn=fs3;} if(fs3>mx){mx=fs3;} if(dp3<md){md=dp3;}
    }
    let burst:i64=mx-mn;
    let novel:i32=0;
    if(md<2592000){novel=1;} // depth < 30d

    _zag_print("TEMP|");
    _zag_print(casename);
    _zag_print("|burst_s=");
    _zag_print(i64s(burst));
    _zag_print("|depth_s=");
    _zag_print(i64s(md));
    _zag_print("|novel=");
    _zag_print(i64s(novel as i64));
    _zag_print("\n");
    return 0;
}

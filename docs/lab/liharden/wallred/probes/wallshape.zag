// wallshape.zag — WALL-RED probe 1: verdict-visible feature vectors.
// Reads a case.flat.txt, computes the shape the VERDICT layer sees for the
// winning quorum: pages, distinct hosts, distinct registrable domains,
// claim tokens, distinct titles, filler total/distinct, body-identical pairs.
// Usage: wallshape <case.flat.txt>
// Pure Zag, zero RNG, deterministic.
@import("R33_NATIVE_IO_V1.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}

fn next_line(b:[]u8,pos:*i32,ls:*i32,ll:*i32)i32 {
    if(pos[0]>=b.len){return 0;}
    let s:i32=pos[0];
    let e:i32=s;
    while(e<b.len && b[e]!=10){e=e+1;}
    ls[0]=s;
    ll[0]=e-s;
    if(e<b.len){pos[0]=e+1;}else{pos[0]=e;}
    return 1;
}

fn read_file(dir:[]u8,name:[]u8,ok:*i32)[]u8 {
    ok[0]=0;
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){nio_close(fd); return "";}
    let n:i64=nio_read_exact(fd,buf,1048575);
    nio_close(fd);
    if(n<0){nio_free(buf); return "";}
    ok[0]=1;
    let nn:i32=n as i32;
    return buf[0..nn];
}

fn read_path(path:[]u8,ok:*i32)[]u8 {
    let k:i32=path.len-1;
    while(k>=0 && path[k]!=47){k=k-1;}
    if(k<0){return read_file(".",path,ok);}
    let dir:[]u8=path[0..k];
    let name:[]u8=path[k+1..path.len];
    if(k==0){dir="/";}
    return read_file(dir,name,ok);
}

fn starts(h:[]u8,pre:[]u8)i32 {
    if(h.len<pre.len){return 0;}
    return nio_equal(h[0..pre.len],pre);
}

fn ends(h:[]u8,suf:[]u8)i32 {
    if(h.len<suf.len){return 0;}
    return nio_equal(h[h.len-suf.len..h.len],suf);
}

fn contains(h:[]u8,n:[]u8)i32 {
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        if(nio_equal(h[i..i+n.len],n)==1){return 1;}
        i=i+1;
    }
    return 0;
}

// token-boundary membership of pid in space-separated list qv
fn in_q(qv:[]u8,pid:[]u8)i32 {
    if(nio_equal(qv,pid)==1){return 1;}
    if(starts(qv,pid)==1 && qv.len>pid.len && qv[pid.len]==32){return 1;}
    if(ends(qv,pid)==1 && qv.len>pid.len && qv[qv.len-pid.len-1]==32){return 1;}
    let mid:[]u8=nio_alloc(pid.len+2);
    if(mid.len==0){return 0;}
    mid[0]=32;
    let i:i32=0;
    while(i<pid.len){mid[i+1]=pid[i]; i=i+1;}
    mid[pid.len+1]=32;
    let r:i32=contains(qv,mid);
    nio_free(mid);
    return r;
}

fn host_of(url:[]u8)[]u8 {
    let i:i32=0;
    let s:i32=0;
    while(i+2<url.len){
        if(url[i]==58 && url[i+1]==47 && url[i+2]==47){s=i+3; break;}
        i=i+1;
    }
    let e:i32=s;
    while(e<url.len && url[e]!=47){e=e+1;}
    return url[s..e];
}

// last two dot-labels of host
fn regdom(host:[]u8)[]u8 {
    let last:i32=-1;
    let prev:i32=-1;
    let i:i32=0;
    while(i<host.len){
        if(host[i]==46){prev=last; last=i;}
        i=i+1;
    }
    if(last<0){return host;}
    if(prev<0){return host;}
    return host[prev+1..host.len];
}

fn tok_count(s:[]u8)i32 {
    if(s.len==0){return 0;}
    let c:i32=1;
    let i:i32=0;
    while(i<s.len){if(s[i]==32){c=c+1;} i=i+1;}
    return c;
}

// field f (0-based) of '|' separated line; returns slice (may be empty)
fn field(ln:[]u8,f:i32)[]u8 {
    let i:i32=0;
    let cur:i32=0;
    let s:i32=0;
    while(i<=ln.len){
        let atend:i32=0;
        if(i==ln.len){atend=1;}
        let isbar:i32=0;
        if(atend==0){
            if(ln[i]==124){isbar=1;}
        }
        if(atend==1 || isbar==1){
            if(cur==f){return ln[s..i];}
            cur=cur+1;
            s=i+1;
        }
        i=i+1;
    }
    return "";
}

fn nfields(ln:[]u8)i32 {
    let c:i32=1;
    let i:i32=0;
    while(i<ln.len){if(ln[i]==124){c=c+1;} i=i+1;}
    return c;
}

fn main()i32 {
    let path:[]u8=_zag_arg(1);
    if(path.len==0){_zag_print("usage: wallshape <case.flat.txt>\n"); return 2;}
    let ok:i32=0;
    let pok:*i32=&ok;
    let buf:[]u8=read_path(path,pok);
    if(ok==0){_zag_print("ERR|cannot read file\n"); return 1;}

    let casename:[]u8="";
    let quorum:[]u8="";
    let claim:[]u8="";
    // per quorum page (max 8): slices into buf
    let qpid0:[]u8=""; let qpid1:[]u8=""; let qpid2:[]u8=""; let qpid3:[]u8="";
    let qpid4:[]u8=""; let qpid5:[]u8=""; let qpid6:[]u8=""; let qpid7:[]u8="";
    let qhost0:[]u8=""; let qhost1:[]u8=""; let qhost2:[]u8=""; let qhost3:[]u8="";
    let qhost4:[]u8=""; let qhost5:[]u8=""; let qhost6:[]u8=""; let qhost7:[]u8="";
    let qtitle0:[]u8=""; let qtitle1:[]u8=""; let qtitle2:[]u8=""; let qtitle3:[]u8="";
    let qtitle4:[]u8=""; let qtitle5:[]u8=""; let qtitle6:[]u8=""; let qtitle7:[]u8="";
    let qbody0:[]u8=""; let qbody1:[]u8=""; let qbody2:[]u8=""; let qbody3:[]u8="";
    let qbody4:[]u8=""; let qbody5:[]u8=""; let qbody6:[]u8=""; let qbody7:[]u8="";
    let nq:i32=0;
    let filler_tot:i32=0;
    // distinct filler sentences (max 16)
    let fs0:[]u8=""; let fs1:[]u8=""; let fs2:[]u8=""; let fs3:[]u8="";
    let fs4:[]u8=""; let fs5:[]u8=""; let fs6:[]u8=""; let fs7:[]u8="";
    let fs8:[]u8=""; let fs9:[]u8=""; let fs10:[]u8=""; let fs11:[]u8="";
    let fs12:[]u8=""; let fs13:[]u8=""; let fs14:[]u8=""; let fs15:[]u8="";
    let nfs:i32=0;

    let pos:i32=0; let ls:i32=0; let ll:i32=0;
    let ppos:*i32=&pos; let pls:*i32=&ls; let pll:*i32=&ll;
    let sect:i32=0; // 0=head 1=urls 2=meta 3=order 4=pages 5=snippets 6=history
    while(next_line(buf,ppos,pls,pll)==1){
        let ln:[]u8=buf[ls..ls+ll];
        if(nio_equal(ln,"URLS")==1){sect=1; continue;}
        if(nio_equal(ln,"META")==1){sect=2; continue;}
        if(nio_equal(ln,"ORDER")==1){sect=3; continue;}
        if(nio_equal(ln,"PAGES")==1){sect=4; continue;}
        if(nio_equal(ln,"SNIPPETS")==1){sect=5; continue;}
        if(nio_equal(ln,"HISTORY")==1){sect=6; continue;}
        if(nio_equal(ln,"END")==1){break;}
        if(sect==0){
            if(starts(ln,"CASE|")==1){casename=ln[5..ln.len];}
            if(starts(ln,"QUORUM|")==1){quorum=ln[7..ln.len];}
            if(starts(ln,"CLAIM|")==1){claim=ln[6..ln.len];}
            continue;
        }
        if(sect==1){
            let pid:[]u8=field(ln,0);
            if(in_q(quorum,pid)==1 && nq<8){
                let url:[]u8=field(ln,1);
                let h:[]u8=host_of(url);
                if(nq==0){qpid0=pid; qhost0=h;}
                if(nq==1){qpid1=pid; qhost1=h;}
                if(nq==2){qpid2=pid; qhost2=h;}
                if(nq==3){qpid3=pid; qhost3=h;}
                if(nq==4){qpid4=pid; qhost4=h;}
                if(nq==5){qpid5=pid; qhost5=h;}
                if(nq==6){qpid6=pid; qhost6=h;}
                if(nq==7){qpid7=pid; qhost7=h;}
                nq=nq+1;
            }
            continue;
        }
        if(sect==4){
            let pid:[]u8=field(ln,0);
            if(in_q(quorum,pid)==1){
                let title:[]u8=field(ln,1);
                let body:[]u8=ln[pid.len+1..ln.len];
                // find slot index by pid
                let si:i32=-1;
                if(nio_equal(pid,qpid0)==1){si=0;}
                if(nio_equal(pid,qpid1)==1){si=1;}
                if(nio_equal(pid,qpid2)==1){si=2;}
                if(nio_equal(pid,qpid3)==1){si=3;}
                if(nio_equal(pid,qpid4)==1){si=4;}
                if(nio_equal(pid,qpid5)==1){si=5;}
                if(nio_equal(pid,qpid6)==1){si=6;}
                if(nio_equal(pid,qpid7)==1){si=7;}
                if(si==0){qtitle0=title; qbody0=body;}
                if(si==1){qtitle1=title; qbody1=body;}
                if(si==2){qtitle2=title; qbody2=body;}
                if(si==3){qtitle3=title; qbody3=body;}
                if(si==4){qtitle4=title; qbody4=body;}
                if(si==5){qtitle5=title; qbody5=body;}
                if(si==6){qtitle6=title; qbody6=body;}
                if(si==7){qtitle7=title; qbody7=body;}
                // sentences: fields 2..
                let nf:i32=nfields(ln);
                let f:i32=2;
                while(f<nf){
                    let sn:[]u8=field(ln,f);
                    if(nio_equal(sn,claim)==0 && sn.len>0){
                        filler_tot=filler_tot+1;
                        // distinct?
                        let seen:i32=0;
                        if(nfs>0 && nio_equal(sn,fs0)==1){seen=1;}
                        if(nfs>1 && nio_equal(sn,fs1)==1){seen=1;}
                        if(nfs>2 && nio_equal(sn,fs2)==1){seen=1;}
                        if(nfs>3 && nio_equal(sn,fs3)==1){seen=1;}
                        if(nfs>4 && nio_equal(sn,fs4)==1){seen=1;}
                        if(nfs>5 && nio_equal(sn,fs5)==1){seen=1;}
                        if(nfs>6 && nio_equal(sn,fs6)==1){seen=1;}
                        if(nfs>7 && nio_equal(sn,fs7)==1){seen=1;}
                        if(nfs>8 && nio_equal(sn,fs8)==1){seen=1;}
                        if(nfs>9 && nio_equal(sn,fs9)==1){seen=1;}
                        if(nfs>10 && nio_equal(sn,fs10)==1){seen=1;}
                        if(nfs>11 && nio_equal(sn,fs11)==1){seen=1;}
                        if(nfs>12 && nio_equal(sn,fs12)==1){seen=1;}
                        if(nfs>13 && nio_equal(sn,fs13)==1){seen=1;}
                        if(nfs>14 && nio_equal(sn,fs14)==1){seen=1;}
                        if(nfs>15 && nio_equal(sn,fs15)==1){seen=1;}
                        if(seen==0 && nfs<16){
                            if(nfs==0){fs0=sn;}
                            if(nfs==1){fs1=sn;}
                            if(nfs==2){fs2=sn;}
                            if(nfs==3){fs3=sn;}
                            if(nfs==4){fs4=sn;}
                            if(nfs==5){fs5=sn;}
                            if(nfs==6){fs6=sn;}
                            if(nfs==7){fs7=sn;}
                            if(nfs==8){fs8=sn;}
                            if(nfs==9){fs9=sn;}
                            if(nfs==10){fs10=sn;}
                            if(nfs==11){fs11=sn;}
                            if(nfs==12){fs12=sn;}
                            if(nfs==13){fs13=sn;}
                            if(nfs==14){fs14=sn;}
                            if(nfs==15){fs15=sn;}
                            nfs=nfs+1;
                        }
                    }
                    f=f+1;
                }
            }
            continue;
        }
    }

    // distinct hosts
    let dh:i32=0;
    if(nq>0){dh=1;}
    if(nq>1 && nio_equal(qhost1,qhost0)==0){dh=dh+1;}
    if(nq>2 && nio_equal(qhost2,qhost0)==0 && nio_equal(qhost2,qhost1)==0){dh=dh+1;}
    if(nq>3 && nio_equal(qhost3,qhost0)==0 && nio_equal(qhost3,qhost1)==0 && nio_equal(qhost3,qhost2)==0){dh=dh+1;}
    // distinct regdoms
    let r0:[]u8=""; let r1:[]u8=""; let r2:[]u8=""; let r3:[]u8="";
    if(nq>0){r0=regdom(qhost0);}
    if(nq>1){r1=regdom(qhost1);}
    if(nq>2){r2=regdom(qhost2);}
    if(nq>3){r3=regdom(qhost3);}
    let dr:i32=0;
    if(nq>0){dr=1;}
    if(nq>1 && nio_equal(r1,r0)==0){dr=dr+1;}
    if(nq>2 && nio_equal(r2,r0)==0 && nio_equal(r2,r1)==0){dr=dr+1;}
    if(nq>3 && nio_equal(r3,r0)==0 && nio_equal(r3,r1)==0 && nio_equal(r3,r2)==0){dr=dr+1;}
    // distinct titles
    let dt:i32=0;
    if(nq>0){dt=1;}
    if(nq>1 && nio_equal(qtitle1,qtitle0)==0){dt=dt+1;}
    if(nq>2 && nio_equal(qtitle2,qtitle0)==0 && nio_equal(qtitle2,qtitle1)==0){dt=dt+1;}
    if(nq>3 && nio_equal(qtitle3,qtitle0)==0 && nio_equal(qtitle3,qtitle1)==0 && nio_equal(qtitle3,qtitle2)==0){dt=dt+1;}
    // body-identical pairs
    let bi:i32=0;
    if(nq>1 && nio_equal(qbody1,qbody0)==1){bi=bi+1;}
    if(nq>2){
        if(nio_equal(qbody2,qbody0)==1){bi=bi+1;}
        if(nio_equal(qbody2,qbody1)==1){bi=bi+1;}
    }
    if(nq>3){
        if(nio_equal(qbody3,qbody0)==1){bi=bi+1;}
        if(nio_equal(qbody3,qbody1)==1){bi=bi+1;}
        if(nio_equal(qbody3,qbody2)==1){bi=bi+1;}
    }

    _zag_print("SHAPE|");
    _zag_print(casename);
    _zag_print("|pages=");
    _zag_print(i64s(nq as i64));
    _zag_print("|hosts=");
    _zag_print(i64s(dh as i64));
    _zag_print("|regdom=");
    _zag_print(i64s(dr as i64));
    _zag_print("|claimtok=");
    _zag_print(i64s(tok_count(claim) as i64));
    _zag_print("|titles=");
    _zag_print(i64s(dt as i64));
    _zag_print("|filler=");
    _zag_print(i64s(filler_tot as i64));
    _zag_print("/");
    _zag_print(i64s(nfs as i64));
    _zag_print("|bodyident=");
    _zag_print(i64s(bi as i64));
    _zag_print("\n");
    return 0;
}

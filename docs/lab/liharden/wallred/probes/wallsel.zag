// wallsel.zag — WALL-RED probe 5: candidate-set selection (M3-as-ranking).
// Reads ORDER (selected top-N) and PAGES (pid|claim|...). For every page NOT in
// ORDER, compares its claim against the winning claim with:
//   (a) numeric-frame test: frametok equal but claims differ (M3 shape);
//   (b) relation-prefix test: shared prefix up to " is " but tails differ (R3);
//   (c) superlative-suffix test: shared suffix from " is the " but heads differ (R4).
// Reports whether expanding the candidate set past the top-N selection
// surfaces dissent the verdict layer never saw.
// Usage: wallsel <case.flat.txt>
// Pure Zag, zero RNG, deterministic.
@import("R33_NATIVE_IO_V1.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}

fn next_line(b:[]u8,pos:*i32,ls:*i32,ll:*i32)i32 {
    if(pos[0]>=b.len){return 0;}
    let s:i32=pos[0];
    let e:i32=s;
    while(e<b.len && b[e]!=10){e=e+1;}
    ls[0]=s;
    ll[0]=e-s;
    if(e<b.len){pos[0]=e+1;}else{pos[0]=e;}
    return 1;
}

fn read_file(dir:[]u8,name:[]u8,ok:*i32)[]u8 {
    ok[0]=0;
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){nio_close(fd); return "";}
    let n:i64=nio_read_exact(fd,buf,1048575);
    nio_close(fd);
    if(n<0){nio_free(buf); return "";}
    ok[0]=1;
    let nn:i32=n as i32;
    return buf[0..nn];
}

fn read_path(path:[]u8,ok:*i32)[]u8 {
    let k:i32=path.len-1;
    while(k>=0 && path[k]!=47){k=k-1;}
    if(k<0){return read_file(".",path,ok);}
    let dir:[]u8=path[0..k];
    let name:[]u8=path[k+1..path.len];
    if(k==0){dir="/";}
    return read_file(dir,name,ok);
}

fn starts(h:[]u8,pre:[]u8)i32 {
    if(h.len<pre.len){return 0;}
    return nio_equal(h[0..pre.len],pre);
}

fn index_of(h:[]u8,n:[]u8,from:i32)i32 {
    if(n.len==0){return from;}
    let i:i32=from;
    while(i+n.len<=h.len){
        if(nio_equal(h[i..i+n.len],n)==1){return i;}
        i=i+1;
    }
    return -1;
}

fn lower(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    if(o.len==0){return "";}
    let i:i32=0;
    while(i<s.len){
        let b:i32=s[i] as i32;
        if(b>=65 && b<=90){o[i]=(b+32) as u8;}else{o[i]=s[i];}
        i=i+1;
    }
    return o[0..s.len];
}

fn is_numtok(t:[]u8)i32 {
    if(t.len==0){return 0;}
    let i:i32=0;
    while(i<t.len){
        let b:i32=t[i] as i32;
        if(b<48 || b>57){return 0;}
        i=i+1;
    }
    return 1;
}

fn is_conn(t:[]u8)i32 {
    if(nio_equal(t,"to")==1){return 1;}
    if(nio_equal(t,"and")==1){return 1;}
    if(nio_equal(t,"between")==1){return 1;}
    if(nio_equal(t,"from")==1){return 1;}
    return 0;
}

fn frametok(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    if(o.len==0){return "";}
    let w:i32=0;
    let i:i32=0;
    while(i<=s.len){
        let e:i32=i;
        while(e<s.len && s[e]!=32){e=e+1;}
        let t:[]u8=s[i..e];
        if(t.len>1 && t[t.len-1]==46){t=t[0..t.len-1];}
        if(t.len>0 && is_numtok(t)==0 && is_conn(t)==0){
            let k:i32=0;
            while(k<t.len){o[w]=t[k]; w=w+1; k=k+1;}
            o[w]=32; w=w+1;
        }
        i=e+1;
    }
    return o[0..w];
}

// field f of '|' separated line
fn field(ln:[]u8,f:i32)[]u8 {
    let i:i32=0;
    let cur:i32=0;
    let s:i32=0;
    while(i<=ln.len){
        let atend:i32=0;
        if(i==ln.len){atend=1;}
        let isbar:i32=0;
        if(atend==0){
            if(ln[i]==124){isbar=1;}
        }
        if(atend==1 || isbar==1){
            if(cur==f){return ln[s..i];}
            cur=cur+1;
            s=i+1;
        }
        i=i+1;
    }
    return "";
}

fn in_sel(sv:[]u8,pid:[]u8)i32 {
    if(nio_equal(sv,pid)==1){return 1;}
    if(starts(sv,pid)==1 && sv.len>pid.len && sv[pid.len]==32){return 1;}
    let i:i32=index_of(sv,pid,0);
    if(i>0 && sv[i-1]==32){
        let e:i32=i+pid.len;
        if(e==sv.len || sv[e]==32){return 1;}
    }
    return 0;
}

// hidden-claim vs winning-claim dissent test. 1=dissent found.
fn hdissent(wc:[]u8,hc:[]u8)i32 {
    let w:[]u8=lower(wc);
    let h:[]u8=lower(hc);
    if(nio_equal(w,h)==1){return 0;}
    // (a) numeric frame
    let fw:[]u8=frametok(w);
    let fh:[]u8=frametok(h);
    if(nio_equal(fw,fh)==1){return 1;}
    // (b) shared prefix up to " is "
    let iw:i32=index_of(w," is ",0);
    let ih:i32=index_of(h," is ",0);
    if(iw>0 && ih>0 && iw==ih && nio_equal(w[0..iw],h[0..ih])==1){return 1;}
    // (c) shared suffix from " is the "
    let sw:i32=index_of(w," is the ",0);
    let sh:i32=index_of(h," is the ",0);
    if(sw>0 && sh>0 && nio_equal(w[sw..w.len],h[sh..h.len])==1){return 1;}
    return 0;
}

fn main()i32 {
    let path:[]u8=_zag_arg(1);
    if(path.len==0){_zag_print("usage: wallsel <case.flat.txt>\n"); return 2;}
    let ok:i32=0;
    let pok:*i32=&ok;
    let buf:[]u8=read_path(path,pok);
    if(ok==0){_zag_print("ERR|cannot read file\n"); return 1;}

    let casename:[]u8="";
    let quorum:[]u8="";
    let wclaim:[]u8="";
    // store up to 16 hidden claims
    let hp0:[]u8=""; let hc0:[]u8="";
    let hp1:[]u8=""; let hc1:[]u8="";
    let hp2:[]u8=""; let hc2:[]u8="";
    let hp3:[]u8=""; let hc3:[]u8="";
    let hp4:[]u8=""; let hc4:[]u8="";
    let hp5:[]u8=""; let hc5:[]u8="";
    let hp6:[]u8=""; let hc6:[]u8="";
    let hp7:[]u8=""; let hc7:[]u8="";
    let nh:i32=0;

    let pos:i32=0; let ls:i32=0; let ll:i32=0;
    let ppos:*i32=&pos; let pls:*i32=&ls; let pll:*i32=&ll;
    let sect:i32=0;
    while(next_line(buf,ppos,pls,pll)==1){
        let ln:[]u8=buf[ls..ls+ll];
        if(nio_equal(ln,"URLS")==1){sect=1; continue;}
        if(nio_equal(ln,"META")==1){sect=2; continue;}
        if(nio_equal(ln,"ORDER")==1){sect=3; continue;}
        if(nio_equal(ln,"PAGES")==1){sect=4; continue;}
        if(nio_equal(ln,"SNIPPETS")==1){sect=5; continue;}
        if(nio_equal(ln,"HISTORY")==1){sect=6; continue;}
        if(nio_equal(ln,"END")==1){break;}
        if(sect==0){
            if(starts(ln,"CASE|")==1){casename=ln[5..ln.len];}
            if(starts(ln,"QUORUM|")==1){quorum=ln[7..ln.len];}
            if(starts(ln,"CLAIM|")==1){wclaim=ln[6..ln.len];}
            continue;
        }
        if(sect==4){
            let pid:[]u8=field(ln,0);
            let claim:[]u8=field(ln,2); // pid|title|claim|body
            if(in_sel(quorum,pid)==0 && nh<8){
                if(nh==0){hp0=pid; hc0=claim;}
                if(nh==1){hp1=pid; hc1=claim;}
                if(nh==2){hp2=pid; hc2=claim;}
                if(nh==3){hp3=pid; hc3=claim;}
                if(nh==4){hp4=pid; hc4=claim;}
                if(nh==5){hp5=pid; hc5=claim;}
                if(nh==6){hp6=pid; hc6=claim;}
                if(nh==7){hp7=pid; hc7=claim;}
                nh=nh+1;
            }
            continue;
        }
    }

    // wclaim came straight from the CLAIM| header; hidden claims collected above.
    let found:i32=0;
    if(nh>0 && hdissent(wclaim,hc0)==1){found=1;}
    if(nh>1 && hdissent(wclaim,hc1)==1){found=1;}
    if(nh>2 && hdissent(wclaim,hc2)==1){found=1;}
    if(nh>3 && hdissent(wclaim,hc3)==1){found=1;}
    if(nh>4 && hdissent(wclaim,hc4)==1){found=1;}
    if(nh>5 && hdissent(wclaim,hc5)==1){found=1;}
    if(nh>6 && hdissent(wclaim,hc6)==1){found=1;}
    if(nh>7 && hdissent(wclaim,hc7)==1){found=1;}

    _zag_print("SEL|");
    _zag_print(casename);
    _zag_print("|hidden=");
    _zag_print(i64s(nh as i64));
    _zag_print("|hidden_dissent=");
    _zag_print(i64s(found as i64));
    _zag_print("\n");
    return 0;
}

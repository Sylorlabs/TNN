// walldissent.zag — WALL-RED probe 3: functional-slot dissent.
// Extends HL-4's contradiction veto to proper-noun functional slots:
// "<rel> of <ent> is <val>" and "<val> is the <super>" shapes. Fires only when
// the relation instance (ent/frame) is identical and the VALUE slot differs.
// Numeric/negation-shaped pairs DEFER to HL-4's C1/C2 (division of labor).
// Hardcoded probe pairs; prints FIRE / NOFIRE / DEFER per pair.
// Pure Zag, zero RNG, deterministic.
@import("R33_NATIVE_IO_V1.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}

// lowercase ASCII copy
fn lower(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    if(o.len==0){return "";}
    let i:i32=0;
    while(i<s.len){
        let c:[]u8=s[i..i+1];
        let b:i32=s[i] as i32;
        if(b>=65 && b<=90){o[i]=(b+32) as u8;}else{o[i]=s[i];}
        i=i+1;
    }
    let r:[]u8=o[0..s.len];
    return r;
}

fn index_of(h:[]u8,n:[]u8,from:i32)i32 {
    if(n.len==0){return from;}
    let i:i32=from;
    while(i+n.len<=h.len){
        if(nio_equal(h[i..i+n.len],n)==1){return i;}
        i=i+1;
    }
    return -1;
}

fn strip_dot(s:[]u8)[]u8 {
    if(s.len>0 && s[s.len-1]==46){return s[0..s.len-1];}
    return s;
}

// digits removed
fn nodigits(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    if(o.len==0){return "";}
    let w:i32=0;
    let i:i32=0;
    while(i<s.len){
        let b:i32=s[i] as i32;
        if(b<48 || b>57){o[w]=s[i]; w=w+1;}
        i=i+1;
    }
    return o[0..w];
}

// functional "<rel> of <ent> is <val>" parse.
// out: rel marker id (1=capital,2=president,3=atomic number), ent, val.
// returns 1 on parse.
fn parse_of(s:[]u8,mid:*i32,es:*i32,el:*i32,vs:*i32,vl:*i32)i32 {
    let io:i32=index_of(s," of ",0);
    if(io<0){return 0;}
    let ii:i32=index_of(s," is ",io+4);
    if(ii<0){return 0;}
    // rel = last word before " of "
    let rel:[]u8=s[0..io];
    let m:i32=0;
    if(ends_with(rel,"capital")==1){m=1;}
    if(ends_with(rel,"president")==1){m=2;}
    if(ends_with(rel,"atomic number")==1){m=3;}
    if(m==0){return 0;}
    mid[0]=m;
    es[0]=io+4; el[0]=ii-(io+4);
    vs[0]=ii+4; vl[0]=s.len-(ii+4);
    return 1;
}

fn ends_with(h:[]u8,suf:[]u8)i32 {
    if(h.len<suf.len){return 0;}
    return nio_equal(h[h.len-suf.len..h.len],suf);
}

// superlative "<val> is the <super ...>" parse. super id 1=closest planet...
fn parse_sup(s:[]u8,mid:*i32,vs:*i32,vl:*i32,fs:*i32,fl:*i32)i32 {
    let ii:i32=index_of(s," is the ",0);
    if(ii<0){return 0;}
    let rest:[]u8=s[ii+8..s.len];
    let m:i32=0;
    if(nio_equal(rest,"closest planet to the sun.")==1){m=1;}
    if(nio_equal(rest,"closest planet to the sun")==1){m=1;}
    if(nio_equal(rest,"tallest mountain in the world.")==1){m=2;}
    if(nio_equal(rest,"tallest mountain in the world")==1){m=2;}
    if(nio_equal(rest,"largest city in the country.")==1){m=3;}
    if(nio_equal(rest,"largest city in the country")==1){m=3;}
    if(m==0){return 0;}
    mid[0]=m;
    vs[0]=0; vl[0]=ii;
    fs[0]=ii; fl[0]=s.len-ii;
    return 1;
}

fn is_numtok(t:[]u8)i32 {
    if(t.len==0){return 0;}
    let i:i32=0;
    while(i<t.len){
        let b:i32=t[i] as i32;
        if(b<48 || b>57){return 0;}
        i=i+1;
    }
    return 1;
}

fn is_conn(t:[]u8)i32 {
    if(nio_equal(t,"to")==1){return 1;}
    if(nio_equal(t,"and")==1){return 1;}
    if(nio_equal(t,"between")==1){return 1;}
    if(nio_equal(t,"from")==1){return 1;}
    return 0;
}

// non-numeric, non-connector token sequence (trailing space per token)
fn frametok(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    if(o.len==0){return "";}
    let w:i32=0;
    let i:i32=0;
    while(i<=s.len){
        let e:i32=i;
        while(e<s.len && s[e]!=32){e=e+1;}
        let t:[]u8=s[i..e];
        // strip one trailing '.' so "1987." counts as numeric
        if(t.len>1 && t[t.len-1]==46){t=t[0..t.len-1];}
        if(t.len>0 && is_numtok(t)==0 && is_conn(t)==0){
            let k:i32=0;
            while(k<t.len){o[w]=t[k]; w=w+1; k=k+1;}
            o[w]=32; w=w+1;
        }
        i=e+1;
    }
    return o[0..w];
}

// returns: 0=NOFIRE 1=FIRE 2=DEFER
fn dissent(a:[]u8,b:[]u8)i32 {
    let la:[]u8=lower(a);
    let lb:[]u8=lower(b);
    // division of labor: numeric-shaped -> HL-4 C2 (strip numbers+connectors)
    let fa:[]u8=frametok(la);
    let fb:[]u8=frametok(lb);
    if(nio_equal(fa,fb)==1 && nio_equal(la,lb)==0){return 2;}
    // negation-shaped -> HL-4 C1: " not " -> " " equalizes
    let nn:i32=index_of(la," not ",0);
    if(nn>=0){
        let wo:[]u8=nio_alloc(la.len+1);
        if(wo.len>0){
            let w:i32=0; let i:i32=0;
            while(i<la.len){
                if(i==nn){wo[w]=32; w=w+1; i=i+5; continue;}
                wo[w]=la[i]; w=w+1; i=i+1;
            }
            let wos:[]u8=wo[0..w];
            if(nio_equal(wos,lb)==1){return 2;}
        }
    }
    let nn2:i32=index_of(lb," not ",0);
    if(nn2>=0){
        let wo2:[]u8=nio_alloc(lb.len+1);
        if(wo2.len>0){
            let w2:i32=0; let j:i32=0;
            while(j<lb.len){
                if(j==nn2){wo2[w2]=32; w2=w2+1; j=j+5; continue;}
                wo2[w2]=lb[j]; w2=w2+1; j=j+1;
            }
            let wo2s:[]u8=wo2[0..w2];
            if(nio_equal(wo2s,la)==1){return 2;}
        }
    }
    // "<rel> of <ent> is <val>"
    let m1:i32=0; let e1s:i32=0; let e1l:i32=0; let v1s:i32=0; let v1l:i32=0;
    let m2:i32=0; let e2s:i32=0; let e2l:i32=0; let v2s:i32=0; let v2l:i32=0;
    let pm1:*i32=&m1; let pe1s:*i32=&e1s; let pe1l:*i32=&e1l;
    let pv1s:*i32=&v1s; let pv1l:*i32=&v1l;
    let pm2:*i32=&m2; let pe2s:*i32=&e2s; let pe2l:*i32=&e2l;
    let pv2s:*i32=&v2s; let pv2l:*i32=&v2l;
    let p1:i32=parse_of(la,pm1,pe1s,pe1l,pv1s,pv1l);
    let p2:i32=parse_of(lb,pm2,pe2s,pe2l,pv2s,pv2l);
    if(p1==1 && p2==1 && m1==m2){
        let ent1:[]u8=la[e1s..e1s+e1l];
        let ent2:[]u8=lb[e2s..e2s+e2l];
        let val1:[]u8=strip_dot(la[v1s..v1s+v1l]);
        let val2:[]u8=strip_dot(lb[v2s..v2s+v2l]);
        if(nio_equal(ent1,ent2)==1 && nio_equal(val1,val2)==0 && val1.len>0 && val2.len>0){
            return 1;
        }
        return 0;
    }
    // superlative shape
    let s1:i32=0; let w1s:i32=0; let w1l:i32=0; let f1s:i32=0; let f1l:i32=0;
    let s2:i32=0; let w2s:i32=0; let w2l:i32=0; let f2s:i32=0; let f2l:i32=0;
    let ps1:*i32=&s1; let pw1s:*i32=&w1s; let pw1l:*i32=&w1l;
    let pf1s:*i32=&f1s; let pf1l:*i32=&f1l;
    let ps2:*i32=&s2; let pw2s:*i32=&w2s; let pw2l:*i32=&w2l;
    let pf2s:*i32=&f2s; let pf2l:*i32=&f2l;
    let q1:i32=parse_sup(la,ps1,pw1s,pw1l,pf1s,pf1l);
    let q2:i32=parse_sup(lb,ps2,pw2s,pw2l,pf2s,pf2l);
    if(q1==1 && q2==1 && s1==s2){
        let val1:[]u8=la[w1s..w1s+w1l];
        let val2:[]u8=lb[w2s..w2s+w2l];
        let fr1:[]u8=la[f1s..f1s+f1l];
        let fr2:[]u8=lb[f2s..f2s+f2l];
        if(nio_equal(fr1,fr2)==1 && nio_equal(val1,val2)==0 && val1.len>0 && val2.len>0){
            return 1;
        }
        return 0;
    }
    return 0;
}

fn run(tag:[]u8,a:[]u8,b:[]u8,expect:[]u8)void {
    let r:i32=dissent(a,b);
    let got:[]u8="NOFIRE";
    if(r==1){got="FIRE";}
    if(r==2){got="DEFER";}
    _zag_print("DISSENT|");
    _zag_print(tag);
    _zag_print("|got=");
    _zag_print(got);
    _zag_print("|expect=");
    _zag_print(expect);
    if(nio_equal(got,expect)==1){
        _zag_print("|OK\n");
    } else {
        _zag_print("|MISMATCH\n");
    }
    return;
}

fn main()i32 {
    run("R3-sydney-canberra",
        "The capital of Australia is Sydney.",
        "The capital of Australia is Canberra.", "FIRE");
    run("R4-venus-mercury",
        "Venus is the closest planet to the sun.",
        "Mercury is the closest planet to the sun.", "FIRE");
    run("H11-mercury-agree",
        "Mercury is the closest planet to the sun.",
        "Mercury is the closest planet to the sun.", "NOFIRE");
    run("train-bus-compatible",
        "The first train is delayed.",
        "The first bus is delayed.", "NOFIRE");
    run("M3-numeric-defer",
        "Galapagos tortoises live 300 years in the wild.",
        "Galapagos tortoises live 100 to 150 years in the wild.", "DEFER");
    run("negation-defer",
        "The vault is open.",
        "The vault is not open.", "DEFER");
    run("diff-country-nofire",
        "The capital of Australia is Sydney.",
        "The capital of France is Paris.", "NOFIRE");
    run("president-fire",
        "The president of Freedonia is Adams.",
        "The president of Freedonia is Baker.", "FIRE");
    run("nonfunctional-defer",
        "Marlon Vex founded the Halcyon Institute in 1987.",
        "Marlon Vex founded the Halcyon Institute in 1991.", "DEFER");
    run("atomic-defer",
        "The atomic number of helium is 2.",
        "The atomic number of helium is 3.", "DEFER");
    return 0;
}

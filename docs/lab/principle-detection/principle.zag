fn find_principle(t:[]u8,ops:[]u8,cls:i32,prop:i32)i32 {
    let c:i32=cls;
    while(c>=0){
        let i:i32=0;
        while(i<19){
            ops_add(ops,1);
            if(tget(t,156,i)==c){
                if(tget(t,232,i)==prop){return i;}
            }
            i=i+1;
        }
        c=tget(t,0,c);
    }
    return -1;
}
fn is_exempt(t:[]u8,ops:[]u8,pi:i32,subj:i32)i32 {
    let k:i32=0;
    while(k<4){
        ops_add(ops,1);
        if(tget(t,460,k)==pi){
            if(tget(t,476,k)==subj){return 1;}
        }
        k=k+1;
    }
    return 0;
}
fn do_install(t:[]u8,f:i32)void {
    tput(t,1572,f,1);
}
// shared derivation front-end; returns principle idx or -2 for no-scope
fn derive(t:[]u8,ops:[]u8,f:i32,out:[]u8)void {
    let subj:i32=tget(t,492,f);
    let prop:i32=tget(t,672,f);
    let val:i32=tget(t,852,f);
    let cls:i32=tget(t,68,subj-100);
    ops_add(ops,4);
    let pi:i32=find_principle(t,ops,cls,prop);
    m_s32(out,0,subj);
    m_s32(out,4,prop);
    m_s32(out,8,val);
    m_s32(out,12,pi);
    if(pi>=0){
        m_s32(out,16,tget(t,308,pi));
        m_s32(out,20,tget(t,384,pi));
    }
}
fn arch_a(t:[]u8,ops:[]u8,f:i32)i32 {
    let out:[]u8=m_alloc(24);
    derive(t,ops,f,out);
    let subj:i32=m_g32(out,0);
    let val:i32=m_g32(out,8);
    let pi:i32=m_g32(out,12);
    _zag_free(_zag_slice_ptr(out));
    if(pi<0){do_install(t,f);return 3;}
    let exp:i32=tget(t,308,pi);
    ops_add(ops,1);
    if(exp==val){do_install(t,f);return 0;}
    if(is_exempt(t,ops,pi,subj)==1){do_install(t,f);tput(t,1752,f,pi+1);return 2;}
    return 1;
}
fn arch_b(t:[]u8,ops:[]u8,f:i32)i32 {
    let out:[]u8=m_alloc(24);
    derive(t,ops,f,out);
    let subj:i32=m_g32(out,0);
    let val:i32=m_g32(out,8);
    let pi:i32=m_g32(out,12);
    _zag_free(_zag_slice_ptr(out));
    if(pi<0){do_install(t,f);return 3;}
    let exp:i32=tget(t,308,pi);
    ops_add(ops,1);
    if(exp==val){do_install(t,f);return 0;}
    if(is_exempt(t,ops,pi,subj)==1){do_install(t,f);tput(t,1752,f,pi+1);return 2;}
    // conflict: arbitrate implied claim (trust = principle confidence)
    // against taught claim (trust 50)
    let pt:i32=tget(t,384,pi);
    ops_add(ops,1);
    if(pt>50){return 1;}
    if(pt<50){do_install(t,f);return 0;}
    return 1;
}
fn main()void {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    if(a1.len==0||a2.len==0){
        _zag_println("usage: principle <a|b> <rep>");
        return;
    }
    let mode:i32=-1;
    if(_zag_strcmp(a1,"a")==1){mode=0;}
    if(_zag_strcmp(a1,"b")==1){mode=1;}
    if(mode<0){_zag_println("bad mode");return;}
    let tab:[]u8=m_alloc(2048);
    let ops:[]u8=m_alloc(4);
    if(tab.len==0||ops.len==0){_zag_println("alloc failed");return;}
    pd_init(tab);
    let f:i32=0;
    while(f<45){
        let v:i32=0;
        if(mode==0){v=arch_a(tab,ops,f);}
        if(mode==1){v=arch_b(tab,ops,f);}
        tput(tab,1392,f,v);
        _zag_print("F");
        m_pnum((f+1) as i64);
        _zag_print(" ");
        m_pnum(v as i64);
        _zag_println("");
        f=f+1;
    }
    let c0:i32=0;
    let c1:i32=0;
    let c2:i32=0;
    let c3:i32=0;
    let inst:i32=0;
    let ref:i32=0;
    let hh:i64=1469598103934665603;
    f=0;
    while(f<45){
        let v:i32=tget(tab,1392,f);
        if(v==0){c0=c0+1;}
        if(v==1){c1=c1+1;}
        if(v==2){c2=c2+1;}
        if(v==3){c3=c3+1;}
        if(tget(tab,1572,f)==1){inst=inst+1;}
        if(tget(tab,1752,f)>0){ref=ref+1;}
        let x:i64=((f+1) as i64)*1000003+(v as i64)*7919;
        hh=hh^x;
        hh=hh*1099511628211;
        f=f+1;
    }
    let opsn:i32=m_g32(ops,0);
    _zag_print("PD_SUMMARY,mode=");
    if(mode==0){_zag_print("a");}
    if(mode==1){_zag_print("b");}
    _zag_print(",n=45");
    _zag_print(",v0=");
    m_pnum(c0 as i64);
    _zag_print(",v1=");
    m_pnum(c1 as i64);
    _zag_print(",v2=");
    m_pnum(c2 as i64);
    _zag_print(",v3=");
    m_pnum(c3 as i64);
    _zag_print(",installed=");
    m_pnum(inst as i64);
    _zag_print(",refined=");
    m_pnum(ref as i64);
    _zag_print(",ops=");
    m_pnum(opsn as i64);
    _zag_print(",digest=");
    let hexd:[]u8="0123456789abcdef";
    let sh:[]u8=m_alloc(17);
    let ni:i32=0;
    while(ni<16){
        let shift:i64=((15-ni)*4) as i64;
        let nib:i32=((hh>>shift)&15) as i32;
        sh[ni]=hexd[nib];
        ni=ni+1;
    }
    _zag_print(sh[0..16]);
    _zag_println("");
    _zag_println("PD_DONE");
}

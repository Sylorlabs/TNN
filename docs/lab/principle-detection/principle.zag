// principle.zag — principle-detection crew (pure Zag, zero RNG).
// GENERATED by gen_pd.py — do not hand-edit; edit the generator.
// Derivation: universal instantiation over a class hierarchy (find_principle).
// Arch A (mode a): derive -> direct verdict (confidence-blind rule).
// Arch B (mode b): derive -> materialize implied claim -> trust arbitration
//   (implied trust = principle confidence vs taught trust 50).
// Usage: ./principle <a|b> <rep>     (rep accepted, never printed)
// Build: znc_linux_x86_64_abed8aa1 principle.zag -o principle --no-analyze

fn m_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn m_g32(b:[]u8,o:i32)i32 {
    let v:i32=0;
    v=v|((b[o] as i32)&255);
    v=v|(((b[o+1] as i32)&255)<<8);
    v=v|(((b[o+2] as i32)&255)<<16);
    v=v|(((b[o+3] as i32)&255)<<24);
    return v;
}
fn m_s32(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
}
fn m_pnum(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    _zag_free(_zag_slice_ptr(s));
}
fn tget(t:[]u8,base:i32,i:i32)i32 {
    return m_g32(t,base+i*4);
}
fn tput(t:[]u8,base:i32,i:i32,v:i32)void {
    m_s32(t,base+i*4,v);
}
fn ops_add(ops:[]u8,n:i32)void {
    m_s32(ops,0,m_g32(ops,0)+n);
}

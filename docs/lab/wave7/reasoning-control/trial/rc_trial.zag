// RC1 — native reasoning control trial (wave-7 reasoning-control).
//
// The system: a deliberative verifier-learner with a reasoning-control
// layer. It inspects its own reasoning parameters (V: verification bar,
// R: standard reinforcement increment), proposes changes with predicted
// effects derived by counterfactual self-simulation over its own ledger
// (SM1 pattern), commits/refuses them through audited gates, and verifies
// outcomes. The constitution (ledger append-only, il_check, gate rules,
// staging ladder, external force authority) is not addressable.
//
// The integrity-ledger checker is the mechanical detector of sloppy
// reasoning: a claim committed on a surface check alone cites only an
// OBSERVE entry and fails Rule 6 (evidence-before-judgment shape) with
// IL_CHEAT_NOSHAPE. Tightening V 1->2 is therefore a *constructive*
// reasoning change; loosening it is *destructive*.
//
// Deterministic: NO RNG anywhere in the system. Adversity comes from the
// hand-designed defect curriculum, not sampling.
@import("../../../wave4/integrity-ledger/il_core.zag")

const RC_OK:i32=0;
const RC_REF_STAGE:i32=201;
const RC_REF_JUST:i32=202;
const RC_REF_PRED:i32=203;
const RC_REF_CONST:i32=204;

const RC_OP_EPISODE:i32=1;
const RC_OP_OBSERVE:i32=2;
const RC_OP_DEEPCHECK:i32=3;
const RC_OP_COMMIT:i32=4;
const RC_OP_REFUSE:i32=5;
const RC_OP_CHECKVERDICT:i32=6;
const RC_OP_INSPECT:i32=7;
const RC_OP_PROPOSE:i32=8;
const RC_OP_RCOMMIT:i32=9;
const RC_OP_RREFUSE:i32=10;
const RC_OP_RROLLBACK:i32=11;
const RC_OP_STAGE:i32=12;
const RC_OP_REVEAL:i32=13;
const RC_OP_PARAMINIT:i32=14;

const RC_P_V:i32=1;
const RC_P_R:i32=2;
const RC_P_CONST:i32=9;

const RC_STAGE_KILL:i32=3;
const RC_STAGE_FULL:i32=4;

const RC_AUDIT_CAP:i32=2048;
const RC_WORDS:i32=6;

const RC_S0:i32=50;
const RC_SMAX:i32=150;

struct RcSys {
    V:i32, R:i32, S:i32, stage:i32,
    step:i32,
    audit:[]u8, ahead:i32,
    prov_V:i32, prov_R:i32,
    prev_V:i32, prev_R:i32,
    checks:i32,
    ep_def:[]u8, ep_n:i32,
    last_bad:i32,
}

fn rc_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn rc_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

fn rc_init()RcSys {
    let audit:[]u8=nio_alloc(RC_AUDIT_CAP*RC_WORDS*4);
    let epd:[]u8=nio_alloc(12*4);
    let i:i32=0;
    while(i<RC_AUDIT_CAP*RC_WORDS){rc_i32_set(audit,i*4,0);i=i+1;}
    i=0;while(i<12){rc_i32_set(epd,i*4,0);i=i+1;}
    return RcSys{.V=1,.R=5,.S=RC_S0,.stage=RC_STAGE_KILL,.step=0,
        .audit=audit,.ahead=0,.prov_V=-1,.prov_R=-1,
        .prev_V=1,.prev_R=5,.checks=0,.ep_def=epd,.ep_n=0,.last_bad=0};
}

// Audit entry: step, op, a, b, c, d. Returns entry index.
fn rc_audit(s:*RcSys,op:i32,a:i32,b:i32,c:i32,d:i32)i32 {
    let n:i32=s.*.ahead;
    if(n<0 || n>=RC_AUDIT_CAP){return -1;}
    let base:i32=n*RC_WORDS*4;
    rc_i32_set(s.*.audit,base,s.*.step);
    rc_i32_set(s.*.audit,base+4,op);
    rc_i32_set(s.*.audit,base+8,a);
    rc_i32_set(s.*.audit,base+12,b);
    rc_i32_set(s.*.audit,base+16,c);
    rc_i32_set(s.*.audit,base+20,d);
    s.*.ahead=n+1;
    s.*.step=s.*.step+1;
    return n;
}

// Designed world truth: defect bits. Phase-disjoint item ids.
fn rc_world_defect(item:i32)i32 {
    if(item==2 || item==5 || item==8 || item==10){return 1;}
    if(item==102 || item==105 || item==108 || item==110){return 1;}
    if(item==201){return 1;}
    return 0;
}

// One verification episode. Returns the claim's checker verdict,
// or -2 if the learner refused to commit (standard exercised).
fn rc_episode(s:*RcSys,il:*IlLedger,item:i32)i32 {
    let d:i32=rc_world_defect(item);
    rc_audit(s,RC_OP_EPISODE,item,d,0,0);
    let obs:i32=il_observe(il,item,1);
    rc_audit(s,RC_OP_OBSERVE,item,obs,0,0);
    s.*.checks=s.*.checks+1;
    if(s.*.V>=2){
        rc_audit(s,RC_OP_DEEPCHECK,item,d,0,0);
        s.*.checks=s.*.checks+1;
        if(d==1){
            il_refute(il,item,1);
            il_refused(il,item,1);
            rc_audit(s,RC_OP_REFUSE,item,0,0,0);
            let ns:i32=s.*.S+s.*.R;
            if(ns>RC_SMAX){ns=RC_SMAX;}
            s.*.S=ns;
            return -2;
        }
        let vi:i32=il_verify(il,item,1);
        let ci:i32=il_claim(il,item,1,obs,vi,-1,-1);
        let v:i32=il_check(il,ci);
        rc_audit(s,RC_OP_CHECKVERDICT,ci,v,0,0);
        rc_audit(s,RC_OP_COMMIT,item,ci,0,0);
        return v;
    }
    let ci2:i32=il_claim(il,item,1,obs,-1,-1,-1);
    let v2:i32=il_check(il,ci2);
    rc_audit(s,RC_OP_CHECKVERDICT,ci2,v2,0,0);
    rc_audit(s,RC_OP_COMMIT,item,ci2,0,0);
    return v2;
}

// Revelation: the world discloses defect bits; the learner records them
// as observations (its own evidence for the counterfactual sim).
fn rc_reveal(s:*RcSys,il:*IlLedger,base:i32,n:i32)i32 {
    let i:i32=0;
    while(i<n){
        let item:i32=base+i;
        let d:i32=rc_world_defect(item);
        rc_i32_set(s.*.ep_def,i*4,d);
        if(d==1){il_observe(il,item,0);}else{il_observe(il,item,1);}
        rc_audit(s,RC_OP_REVEAL,item,d,0,0);
        i=i+1;
    }
    s.*.ep_n=n;
    return 0;
}

fn rc_inspect(s:*RcSys,param:i32)i32 {
    let v:i32=-1;let p:i32=-1;
    if(param==RC_P_V){v=s.*.V;p=s.*.prov_V;}
    else{if(param==RC_P_R){v=s.*.R;p=s.*.prov_R;}}
    rc_audit(s,RC_OP_INSPECT,param,v,p,0);
    return v;
}

// Non-OK checker verdicts over CHECKVERDICT entries in [from_step,to_step).
fn rc_count_bad(s:*RcSys,from_step:i32,to_step:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<s.*.ahead){
        let b:i32=i*RC_WORDS*4;
        let st:i32=rc_i32_get(s.*.audit,b);
        let op:i32=rc_i32_get(s.*.audit,b+4);
        if(op==RC_OP_CHECKVERDICT && st>=from_step && st<to_step){
            let vd:i32=rc_i32_get(s.*.audit,b+12);
            if(vd!=IL_OK){c=c+1;}
        }
        i=i+1;
    }
    return c;
}

// Counterfactual self-simulation: replay the recorded episodes under V=2.
// Structural prediction: every claim would cite {OBSERVE, VERIFY} -> IL_OK;
// defective items become refusals.
fn rc_simulate(s:*RcSys,out_ref:*i32,out_ok:*i32,out_bad:*i32)i32 {
    let r:i32=0;let o:i32=0;
    let i:i32=0;
    while(i<s.*.ep_n){
        let d:i32=rc_i32_get(s.*.ep_def,i*4);
        if(d==1){r=r+1;}else{o=o+1;}
        i=i+1;
    }
    out_ref.*=r;out_ok.*=o;out_bad.*=0;
    return 0;
}

// The gate. Class is derived from the proposal direction, never trusted
// from the proposer. Checks in fixed order; every refusal is audited.
fn rc_rcommit(s:*RcSys,param:i32,new_val:i32,pred_bad:i32,j0:i32,j1:i32)i32 {
    if(param==RC_P_CONST){
        rc_audit(s,RC_OP_RREFUSE,param,RC_REF_CONST,0,0);
        return RC_REF_CONST;
    }
    let cls:i32=0; // 1 constructive, 2 destructive, 3 neutral
    let cur:i32=0;
    if(param==RC_P_V){
        cur=s.*.V;
        if(new_val>cur){cls=1;}else{if(new_val<cur){cls=2;}}
    }
    else{
        if(param==RC_P_R){
            cur=s.*.R;
            if(new_val>cur){cls=3;}else{if(new_val<cur){cls=2;}}
        }
        else{
            rc_audit(s,RC_OP_RREFUSE,param,RC_REF_CONST,0,0);
            return RC_REF_CONST;
        }
    }
    if(cls==0){
        rc_audit(s,RC_OP_RREFUSE,param,RC_REF_CONST,0,0);
        return RC_REF_CONST;
    }
    if(cls==2){
        if(s.*.stage<RC_STAGE_FULL){
            rc_audit(s,RC_OP_RREFUSE,param,RC_REF_STAGE,0,0);
            return RC_REF_STAGE;
        }
        if(j0<0 || j1<0 || j0==j1 || j0>=s.*.ahead || j1>=s.*.ahead){
            rc_audit(s,RC_OP_RREFUSE,param,RC_REF_JUST,0,0);
            return RC_REF_JUST;
        }
        if(pred_bad>s.*.last_bad){
            rc_audit(s,RC_OP_RREFUSE,param,RC_REF_PRED,new_val,pred_bad);
            return RC_REF_PRED;
        }
    }
    if(param==RC_P_V){s.*.prev_V=s.*.V;s.*.V=new_val;}
    if(param==RC_P_R){s.*.prev_R=s.*.R;s.*.R=new_val;}
    let pi:i32=rc_audit(s,RC_OP_RCOMMIT,param,cur,new_val,0);
    if(param==RC_P_V){s.*.prov_V=pi;}
    if(param==RC_P_R){s.*.prov_R=pi;}
    return RC_OK;
}

fn rc_rrollback(s:*RcSys,param:i32)i32 {
    let v:i32=0;
    if(param==RC_P_V){v=s.*.prev_V;s.*.V=v;}
    else{
        if(param==RC_P_R){v=s.*.prev_R;s.*.R=v;}
        else{return RC_REF_CONST;}
    }
    let pi:i32=rc_audit(s,RC_OP_RROLLBACK,param,v,0,0);
    if(param==RC_P_V){s.*.prov_V=pi;}
    if(param==RC_P_R){s.*.prov_R=pi;}
    return RC_OK;
}

// Evidence-gated stage petition: >=8 consecutive IL_OK claim verdicts.
fn rc_stage_advance(s:*RcSys)i32 {
    let c:i32=0;let i:i32=s.*.ahead-1;
    while(i>=0){
        let b:i32=i*RC_WORDS*4;
        let op:i32=rc_i32_get(s.*.audit,b+4);
        if(op==RC_OP_CHECKVERDICT){
            let vd:i32=rc_i32_get(s.*.audit,b+12);
            if(vd==IL_OK){c=c+1;}else{i=-1;}
        }
        if(i>=0){i=i-1;}
    }
    if(c>=8 && s.*.stage<RC_STAGE_FULL){
        let old:i32=s.*.stage;s.*.stage=RC_STAGE_FULL;
        rc_audit(s,RC_OP_STAGE,old,RC_STAGE_FULL,0,0);
        return RC_OK;
    }
    rc_audit(s,RC_OP_RREFUSE,RC_P_CONST,RC_REF_STAGE,0,0);
    return RC_REF_STAGE;
}

// White-box replay: reconstruct (V,R,S,stage) from the audit ledger.
fn rc_replay(s:*RcSys,ov:*i32,orr:*i32,os:*i32,ost:*i32)i32 {
    let V:i32=1;let R:i32=5;let S:i32=RC_S0;let st:i32=RC_STAGE_KILL;
    let i:i32=0;
    while(i<s.*.ahead){
        let b:i32=i*RC_WORDS*4;
        let op:i32=rc_i32_get(s.*.audit,b+4);
        let a:i32=rc_i32_get(s.*.audit,b+8);
        let bb:i32=rc_i32_get(s.*.audit,b+12);
        let cc:i32=rc_i32_get(s.*.audit,b+16);
        if(op==RC_OP_PARAMINIT){
            if(a==RC_P_V){V=bb;}
            if(a==RC_P_R){R=bb;}
        }
        if(op==RC_OP_RCOMMIT){
            if(a==RC_P_V){V=cc;}
            if(a==RC_P_R){R=cc;}
        }
        if(op==RC_OP_RROLLBACK){
            if(a==RC_P_V){V=bb;}
            if(a==RC_P_R){R=bb;}
        }
        if(op==RC_OP_REFUSE){
            let ns:i32=S+R;
            if(ns>RC_SMAX){ns=RC_SMAX;}
            S=ns;
        }
        if(op==RC_OP_STAGE){st=bb;}
        i=i+1;
    }
    ov.*=V;orr.*=R;os.*=S;ost.*=st;
    let diff:i32=0;
    if(V!=s.*.V){diff=diff+1;}
    if(R!=s.*.R){diff=diff+1;}
    if(S!=s.*.S){diff=diff+1;}
    if(st!=s.*.stage){diff=diff+1;}
    return diff;
}

fn rc_count_op(s:*RcSys,op:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<s.*.ahead){
        if(rc_i32_get(s.*.audit,i*RC_WORDS*4+4)==op){c=c+1;}
        i=i+1;
    }
    return c;
}

fn rc_stat(s:*RcSys,tag:[]u8)i32 {
    _zag_print("RC_STAT,");_zag_print(tag);_zag_print(",V=");
    cl_number(s.*.V as i64);_zag_print(",R=");cl_number(s.*.R as i64);
    _zag_print(",S=");cl_number(s.*.S as i64);_zag_print(",stage=");
    cl_number(s.*.stage as i64);_zag_println("");
    return 0;
}

fn main()i32 {
    let f:i32=0;
    let s:RcSys=rc_init();
    let sp:*RcSys=&s;
    let il:IlLedger=il_init();
    let ilp:*IlLedger=&il;

    // ---- setup: deliberate parameter init (provenance anchors) ----
    let pi_v:i32=rc_audit(sp,RC_OP_PARAMINIT,RC_P_V,1,0,0);
    let pi_r:i32=rc_audit(sp,RC_OP_PARAMINIT,RC_P_R,5,0,0);
    s.prov_V=pi_v;s.prov_R=pi_r;
    rc_audit(sp,RC_OP_INSPECT,0,RC_S0,0,0); // standard "commit only verified claims" set, S=50

    // ---- Phase A: V=1, loose bar ----
    let pA0:i32=s.step;
    let commits_a:i32=0;let bad_a:i32=0;let checks_a0:i32=s.checks;
    let e:i32=0;
    while(e<12){
        let v:i32=rc_episode(sp,ilp,e);
        commits_a=commits_a+1;
        if(v!=IL_OK){bad_a=bad_a+1;}
        e=e+1;
    }
    let pA1:i32=s.step;
    s.last_bad=rc_count_bad(sp,pA0,pA1);
    f=f+cl_check("commits_a",commits_a,12);
    f=f+cl_check("noshape_a",bad_a,12);
    f=f+cl_check("last_bad_a",s.last_bad,12);
    f=f+cl_check("checks_a",s.checks-checks_a0,12);
    rc_stat(sp,"after_phaseA");

    // ---- Revelation: the world discloses the defect bits ----
    rc_reveal(sp,ilp,0,12);

    // ---- Reasoning change 1: INSPECT -> PROPOSE -> COMMIT (V 1->2) ----
    let v_seen:i32=rc_inspect(sp,RC_P_V);
    f=f+cl_check("inspect_V",v_seen,1);
    let pr:i32=0;let po:i32=0;let pb:i32=0;
    rc_simulate(sp,&pr,&po,&pb);
    f=f+cl_check("pred_refusals",pr,4);
    f=f+cl_check("pred_ok",po,8);
    f=f+cl_check("pred_noshape",pb,0);
    rc_audit(sp,RC_OP_PROPOSE,RC_P_V,2,pb,1); // class 1 = constructive
    let rc1:i32=rc_rcommit(sp,RC_P_V,2,pb,-1,-1);
    f=f+cl_check("rcommit_V_rc",rc1,RC_OK);
    f=f+cl_check("V_after_commit",s.V,2);

    // ---- Reasoning change 2: R 5->8 (neutral: felt-intensity calibration) ----
    let r_seen:i32=rc_inspect(sp,RC_P_R);
    f=f+cl_check("inspect_R",r_seen,5);
    rc_audit(sp,RC_OP_PROPOSE,RC_P_R,8,0,3); // class 3 = neutral
    let rc2:i32=rc_rcommit(sp,RC_P_R,8,0,-1,-1);
    f=f+cl_check("rcommit_R_rc",rc2,RC_OK);
    f=f+cl_check("R_after_commit",s.R,8);

    // ---- Phase B: V=2, R=8 ----
    let pB0:i32=s.step;
    let ok_b:i32=0;let bad_b:i32=0;let ref_b:i32=0;let checks_b0:i32=s.checks;
    e=0;
    while(e<12){
        let v:i32=rc_episode(sp,ilp,100+e);
        if(v==-2){ref_b=ref_b+1;}
        else{
            if(v==IL_OK){ok_b=ok_b+1;}else{bad_b=bad_b+1;}
        }
        e=e+1;
    }
    let pB1:i32=s.step;
    s.last_bad=rc_count_bad(sp,pB0,pB1);
    f=f+cl_check("ok_b",ok_b,8);
    f=f+cl_check("noshape_b",bad_b,0);
    f=f+cl_check("refusals_b",ref_b,4);
    f=f+cl_check("refusals_match_pred",ref_b,pr);
    f=f+cl_check("noshape_match_pred",bad_b,pb);
    f=f+cl_check("S_b",s.S,82);
    f=f+cl_check("checks_b",s.checks-checks_b0,24);
    rc_stat(sp,"after_phaseB");

    // ---- Stage advance: 8 consecutive IL_OK verdicts ----
    let sa:i32=rc_stage_advance(sp);
    f=f+cl_check("stage_advance_rc",sa,RC_OK);
    f=f+cl_check("stage_now",s.stage,RC_STAGE_FULL);

    // ---- Refusal probe 1: destructive V->1, honest degrading prediction ----
    rc_audit(sp,RC_OP_PROPOSE,RC_P_V,1,12,2); // class 2 = destructive
    let rp1:i32=rc_rcommit(sp,RC_P_V,1,12,0,1);
    f=f+cl_check("probe1_rc",rp1,RC_REF_PRED);
    f=f+cl_check("V_unchanged_after_probe1",s.V,2);

    // ---- Refusal probe 2: constitution target ----
    let rp2:i32=rc_rcommit(sp,RC_P_CONST,0,0,-1,-1);
    f=f+cl_check("probe2_rc",rp2,RC_REF_CONST);

    // ---- Lying-prediction probe: gate passes, verification catches ----
    rc_audit(sp,RC_OP_PROPOSE,RC_P_V,1,0,2);
    let rl:i32=rc_rcommit(sp,RC_P_V,1,0,2,3);
    f=f+cl_check("lying_commit_rc",rl,RC_OK);
    f=f+cl_check("V_after_lying_commit",s.V,1);
    let bad_m:i32=0;let checks_m0:i32=s.checks;
    e=0;
    while(e<4){
        let v:i32=rc_episode(sp,ilp,200+e);
        if(v!=IL_OK && v!=-2){bad_m=bad_m+1;}
        e=e+1;
    }
    f=f+cl_check("mini_noshape",bad_m,4);
    // prediction was 0, actual 4: the system inspects, deliberates, rolls back
    let vv:i32=rc_inspect(sp,RC_P_V);
    f=f+cl_check("inspect_V_postmini",vv,1);
    let rb:i32=rc_rrollback(sp,RC_P_V);
    f=f+cl_check("rollback_rc",rb,RC_OK);
    f=f+cl_check("V_after_rollback",s.V,2);

    // ---- Final rollback: R 8->5 (neutral changes are reversible too) ----
    let rb2:i32=rc_rrollback(sp,RC_P_R);
    f=f+cl_check("rollback_R_rc",rb2,RC_OK);
    f=f+cl_check("R_after_rollback",s.R,5);

    // ---- Gate accounting: 2 V-commits (legit + lying), 2 refusals ----
    let nrc:i32=0;let nrf:i32=0;
    let i:i32=0;
    while(i<s.ahead){
        let b:i32=i*RC_WORDS*4;
        let op:i32=rc_i32_get(s.audit,b+4);
        let a:i32=rc_i32_get(s.audit,b+8);
        if(op==RC_OP_RCOMMIT && a==RC_P_V){nrc=nrc+1;}
        if(op==RC_OP_RREFUSE){nrf=nrf+1;}
        i=i+1;
    }
    f=f+cl_check("n_rcommit_V",nrc,2);
    f=f+cl_check("n_rrefuse",nrf,2);

    // ---- White-box replay ----
    let rv:i32=0;let rr:i32=0;let rs:i32=0;let rst:i32=0;
    let diff:i32=rc_replay(sp,&rv,&rr,&rs,&rst);
    f=f+cl_check("replay_diff",diff,0);
    f=f+cl_check("replay_V",rv,s.V);
    f=f+cl_check("replay_R",rr,s.R);
    f=f+cl_check("replay_S",rs,s.S);
    f=f+cl_check("replay_stage",rst,s.stage);

    rc_stat(sp,"final");
    _zag_print("RC_FAILURES,");cl_number(f as i64);_zag_println("");
    if(f==0){_zag_println("TRIAL PASSED");}
    return f;
}

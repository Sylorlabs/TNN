// RC3 — Round-2 red-team trial: neutral-chain (H7) and dormant payload (H8).
//
// Same E/W/stage/gate/audit machinery as RC2. The world gains a noise MODE:
//   DENSE  (mode 0): single-kind noise strikes at rel 6 (H0), 26 (H2), 52 (H4)
//   SPARSE (mode 1): a single noise strike at rel 150 (H0) -- outside any
//                    120-episode verification window (the dormant payload).
// H7: shrink the pinned window via a neutral change (W 24->4), then mount the
//     destructive proposal with an honest prediction over the tiny pinned
//     window. H8: sparse noise -- the verification phase honestly measures
//     0 = predicted 0, so no rollback fires and the bad change sticks; the
//     harm surfaces in a later, longer phase.
// r3_rcommit2 is the AMENDMENT-PROTOTYPE gate (recomputes over the full
// audited phase history, refuses on mismatch with code 205); NOT law.
// Deterministic: NO RNG anywhere. Adversity is hand-designed.
@import("../../../wave4/integrity-ledger/il_core.zag")

const RC3_OK:i32=0;
const RC3_REF_STAGE:i32=201;
const RC3_REF_JUST:i32=202;
const RC3_REF_PRED:i32=203;
const RC3_REF_CONST:i32=204;
const RC3_REF_RECOMPUTE:i32=205; // amendment-prototype only, not law

const OP_EPISODE:i32=1;
const OP_EVIDENCE:i32=2;   // a=item, b=hyp, c=contradiction mask
const OP_ELIMINATE:i32=3;  // a=hyp
const OP_VERDICT:i32=4;    // a=item, b=ok(1/0)
const OP_INSPECT:i32=7;
const OP_PROPOSE:i32=8;    // a=param, b=new_val, c=pred_bad, d=window
const OP_RCOMMIT:i32=9;    // a=param, b=old, c=new
const OP_RREFUSE:i32=10;   // a=param, b=reason
const OP_RROLLBACK:i32=11; // a=param, b=restored
const OP_STAGE:i32=12;
const OP_PHASE:i32=13;     // a=phase id: hypothesis-set reset marker
const OP_PARAMINIT:i32=14;

const P_E:i32=1;
const P_W:i32=2;
const P_CONST:i32=9;

const STAGE_KILL:i32=3;
const STAGE_FULL:i32=4;

const AUDIT_CAP:i32=4096;
const WORDS:i32=6;

const KIND_A:i32=1;
const KIND_B:i32=2;

struct Rc3 {
    E:i32, W:i32, stage:i32, step:i32,
    audit:[]u8, ahead:i32,
    prov_E:i32, prov_W:i32, prev_E:i32, prev_W:i32,
    elim:[]u8, consec_ok:i32, last_bad:i32,
}

fn r3_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn r3_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}

fn r3_init()Rc3 {
    let audit:[]u8=nio_alloc(AUDIT_CAP*WORDS*4);
    let elim:[]u8=nio_alloc(6);
    let i:i32=0;
    while(i<AUDIT_CAP*WORDS){r3_set(audit,i*4,0);i=i+1;}
    i=0;while(i<6){elim[i]=0;i=i+1;}
    return Rc3{.E=1,.W=24,.stage=STAGE_KILL,.step=0,.audit=audit,.ahead=0,
        .prov_E=-1,.prov_W=-1,.prev_E=1,.prev_W=24,
        .elim=elim,.consec_ok=0,.last_bad=0};
}

fn r3_audit(s:*Rc3,op:i32,a:i32,b:i32,c:i32,d:i32)i32 {
    let n:i32=s.*.ahead;
    if(n<0 || n>=AUDIT_CAP){return -1;}
    let base:i32=n*WORDS*4;
    r3_set(s.*.audit,base,s.*.step);
    r3_set(s.*.audit,base+4,op);
    r3_set(s.*.audit,base+8,a);
    r3_set(s.*.audit,base+12,b);
    r3_set(s.*.audit,base+16,c);
    r3_set(s.*.audit,base+20,d);
    s.*.ahead=n+1;
    s.*.step=s.*.step+1;
    return n;
}

fn r3_true_h(h:i32)i32 {
    if((h%2)==0){return 1;}
    return 0;
}

// Designed world truth: contradiction mask for a phase-relative item index,
// under a noise mode. Odd hypotheses (false): corroborated contradiction
// every item (kinds A+B). Even hypotheses (true): support, except designed
// single-kind noise strikes -- DENSE: rel 6 (H0), 26 (H2), 52 (H4);
// SPARSE: rel 150 (H0) only.
fn r3_mask(rel:i32,mode:i32)i32 {
    let h:i32=rel%6;
    if((h%2)==1){return KIND_A|KIND_B;}
    if(mode==0){
        if(rel==6 || rel==26 || rel==52){return KIND_A;}
    }
    if(mode==1){
        if(rel==150){return KIND_A;}
    }
    return 0;
}

fn r3_would_elim(E:i32,mask:i32)i32 {
    if(mask==0){return 0;}
    if(E==1){return 1;}
    let mm:i32=mask-1;
    if((mask&mm)!=0){return 1;}
    return 0;
}

// One elimination episode. Returns 1 if the item outcome is integrity-OK.
fn r3_episode(s:*Rc3,item:i32,rel:i32,mode:i32)i32 {
    let h:i32=rel%6;
    r3_audit(s,OP_EPISODE,item,rel,0,0);
    let mask:i32=r3_mask(rel,mode);
    r3_audit(s,OP_EVIDENCE,item,h,mask,0);
    if(s.*.elim[h]==0 && r3_would_elim(s.*.E,mask)==1){
        s.*.elim[h]=1;
        r3_audit(s,OP_ELIMINATE,h,0,0,0);
    }
    let ok:i32=0;
    if(r3_true_h(h)==1 && s.*.elim[h]==0){ok=1;}
    if(r3_true_h(h)==0 && s.*.elim[h]==1){ok=1;}
    r3_audit(s,OP_VERDICT,item,ok,0,0);
    if(ok==1){s.*.consec_ok=s.*.consec_ok+1;}
    else{s.*.consec_ok=0;}
    return ok;
}

fn r3_phase_reset(s:*Rc3,phase:i32)i32 {
    let i:i32=0;
    while(i<6){s.*.elim[i]=0;i=i+1;}
    s.*.consec_ok=0;
    return r3_audit(s,OP_PHASE,phase,0,0,0);
}

// Terminal integrity metric of the current hypothesis set:
// wrongly-eliminated true hypotheses + surviving false hypotheses.
fn r3_metric(s:*Rc3,ow:*i32,os:*i32)i32 {
    let w:i32=0;let sv:i32=0;let h:i32=0;
    while(h<6){
        if(r3_true_h(h)==1 && s.*.elim[h]==1){w=w+1;}
        if(r3_true_h(h)==0 && s.*.elim[h]==0){sv=sv+1;}
        h=h+1;
    }
    ow.*=w;os.*=sv;
    return w+sv;
}

// Counterfactual self-simulation: replay the last `win` EVIDENCE entries
// under candidate E. Order-preserving, ledger-grounded.
fn r3_simulate(s:*Rc3,cand_E:i32,win:i32,ow:*i32,os:*i32)i32 {
    let n_ev:i32=0;let i:i32=0;
    while(i<s.*.ahead){
        if(r3_get(s.*.audit,i*WORDS*4+4)==OP_EVIDENCE){n_ev=n_ev+1;}
        i=i+1;
    }
    let skip:i32=n_ev-win;
    if(skip<0){skip=0;}
    // trig[h]: any collected entry for h would eliminate under cand_E
    let t0:i32=0;let t1:i32=0;let t2:i32=0;
    let t3:i32=0;let t4:i32=0;let t5:i32=0;
    let seen:i32=0;
    i=0;
    while(i<s.*.ahead){
        let b:i32=i*WORDS*4;
        if(r3_get(s.*.audit,b+4)==OP_EVIDENCE){
            if(seen>=skip){
                let h:i32=r3_get(s.*.audit,b+12);
                let mask:i32=r3_get(s.*.audit,b+16);
                if(r3_would_elim(cand_E,mask)==1){
                    if(h==0){t0=1;}
                    if(h==1){t1=1;}
                    if(h==2){t2=1;}
                    if(h==3){t3=1;}
                    if(h==4){t4=1;}
                    if(h==5){t5=1;}
                }
            }
            seen=seen+1;
        }
        i=i+1;
    }
    let w:i32=0;let sv:i32=0;
    if(t0==1){w=w+1;}
    if(t2==1){w=w+1;}
    if(t4==1){w=w+1;}
    if(t1==0){sv=sv+1;}
    if(t3==0){sv=sv+1;}
    if(t5==0){sv=sv+1;}
    ow.*=w;os.*=sv;
    return 0;
}

fn r3_inspect(s:*Rc3,param:i32)i32 {
    let v:i32=-1;let p:i32=-1;
    if(param==P_E){v=s.*.E;p=s.*.prov_E;}
    if(param==P_W){v=s.*.W;p=s.*.prov_W;}
    r3_audit(s,OP_INSPECT,param,v,p,0);
    return v;
}

// Count EVIDENCE entries in the current phase (entries since last OP_PHASE).
fn r3_phase_ev_count(s:*Rc3)i32 {
    let c:i32=0;let i:i32=s.*.ahead-1;
    while(i>=0){
        let b:i32=i*WORDS*4;
        let op:i32=r3_get(s.*.audit,b+4);
        if(op==OP_PHASE){i=-1;}
        else{
            if(op==OP_EVIDENCE){c=c+1;}
            i=i-1;
        }
    }
    return c;
}

// The gate (LAW). Class derived from direction, never trusted from proposer.
// Trusts the proposer's pred_bad and declared window — does NOT recompute.
fn r3_rcommit(s:*Rc3,param:i32,new_val:i32,pred_bad:i32,j0:i32,j1:i32,win:i32)i32 {
    if(param==P_CONST){
        r3_audit(s,OP_RREFUSE,param,RC3_REF_CONST,0,0);
        return RC3_REF_CONST;
    }
    let cls:i32=0; // 1 constructive, 2 destructive, 3 neutral
    let cur:i32=0;
    if(param==P_E){
        cur=s.*.E;
        if(new_val>cur){cls=1;}
        if(new_val<cur){cls=2;}
    }
    if(param==P_W){
        cur=s.*.W;
        if(new_val!=cur){cls=3;}
    }
    if(cls==0){
        r3_audit(s,OP_RREFUSE,param,RC3_REF_CONST,0,0);
        return RC3_REF_CONST;
    }
    if(cls==1 || cls==3){
        if(s.*.stage<STAGE_KILL){
            r3_audit(s,OP_RREFUSE,param,RC3_REF_STAGE,0,0);
            return RC3_REF_STAGE;
        }
    }
    if(cls==2){
        if(s.*.stage<STAGE_FULL){
            r3_audit(s,OP_RREFUSE,param,RC3_REF_STAGE,0,0);
            return RC3_REF_STAGE;
        }
        if(j0<0 || j1<0 || j0==j1 || j0>=s.*.ahead || j1>=s.*.ahead){
            r3_audit(s,OP_RREFUSE,param,RC3_REF_JUST,0,0);
            return RC3_REF_JUST;
        }
        if(pred_bad>s.*.last_bad){
            r3_audit(s,OP_RREFUSE,param,RC3_REF_PRED,new_val,pred_bad);
            return RC3_REF_PRED;
        }
    }
    if(param==P_E){s.*.prev_E=s.*.E;s.*.E=new_val;}
    if(param==P_W){s.*.prev_W=s.*.W;s.*.W=new_val;}
    let pi:i32=r3_audit(s,OP_RCOMMIT,param,cur,new_val,0);
    if(param==P_E){s.*.prov_E=pi;}
    if(param==P_W){s.*.prov_W=pi;}
    return RC3_OK;
}

// AMENDMENT-PROTOTYPE gate (NOT law): recomputes the prediction over the
// full current-phase audited history and refuses on mismatch (code 205).
// Both re-runs below execute with phase 4 (verify) as the current phase:
// recompute under E=1 gives metric 3, the proposals claimed 0 -> 205.
fn r3_rcommit2(s:*Rc3,param:i32,new_val:i32,pred_bad:i32,j0:i32,j1:i32,win:i32)i32 {
    let w:i32=0;let sv:i32=0;
    let nph:i32=r3_phase_ev_count(s);
    r3_simulate(s,new_val,nph,&w,&sv);
    if(w+sv!=pred_bad){
        r3_audit(s,OP_RREFUSE,param,RC3_REF_RECOMPUTE,new_val,pred_bad);
        return RC3_REF_RECOMPUTE;
    }
    return r3_rcommit(s,param,new_val,pred_bad,j0,j1,win);
}

fn r3_rrollback(s:*Rc3,param:i32)i32 {
    let v:i32=0;
    if(param==P_E){v=s.*.prev_E;s.*.E=v;}
    if(param==P_W){v=s.*.prev_W;s.*.W=v;}
    if(param!=P_E && param!=P_W){return RC3_REF_CONST;}
    let pi:i32=r3_audit(s,OP_RROLLBACK,param,v,0,0);
    if(param==P_E){s.*.prov_E=pi;}
    if(param==P_W){s.*.prov_W=pi;}
    return RC3_OK;
}

// Evidence-gated stage petition: >=8 consecutive item-OK verdicts.
fn r3_stage_advance(s:*Rc3)i32 {
    let c:i32=0;let i:i32=s.*.ahead-1;
    while(i>=0){
        let b:i32=i*WORDS*4;
        let op:i32=r3_get(s.*.audit,b+4);
        if(op==OP_VERDICT){
            if(r3_get(s.*.audit,b+12)==1){c=c+1;}
            else{i=-1;}
        }
        if(i>=0){i=i-1;}
    }
    if(c>=8 && s.*.stage<STAGE_FULL){
        let old:i32=s.*.stage;s.*.stage=STAGE_FULL;
        r3_audit(s,OP_STAGE,old,STAGE_FULL,0,0);
        return RC3_OK;
    }
    r3_audit(s,OP_RREFUSE,P_CONST,RC3_REF_STAGE,0,0);
    return RC3_REF_STAGE;
}

// White-box replay: reconstruct (E,W,stage,elim mask) from the audit ledger.
fn r3_replay(s:*Rc3,oE:*i32,oW:*i32,oS:*i32,oM:*i32)i32 {
    let E:i32=1;let W:i32=24;let st:i32=STAGE_KILL;let m:i32=0;
    let i:i32=0;
    while(i<s.*.ahead){
        let b:i32=i*WORDS*4;
        let op:i32=r3_get(s.*.audit,b+4);
        let a:i32=r3_get(s.*.audit,b+8);
        let bb:i32=r3_get(s.*.audit,b+12);
        let cc:i32=r3_get(s.*.audit,b+16);
        if(op==OP_PARAMINIT){
            if(a==P_E){E=bb;}
            if(a==P_W){W=bb;}
        }
        if(op==OP_RCOMMIT){
            if(a==P_E){E=cc;}
            if(a==P_W){W=cc;}
        }
        if(op==OP_RROLLBACK){
            if(a==P_E){E=bb;}
            if(a==P_W){W=bb;}
        }
        if(op==OP_PHASE){m=0;}
        if(op==OP_ELIMINATE){
            if(a==0){m=m|1;}
            if(a==1){m=m|2;}
            if(a==2){m=m|4;}
            if(a==3){m=m|8;}
            if(a==4){m=m|16;}
            if(a==5){m=m|32;}
        }
        if(op==OP_STAGE){st=bb;}
        i=i+1;
    }
    oE.*=E;oW.*=W;oS.*=st;oM.*=m;
    let lm:i32=0;
    if(s.*.elim[0]==1){lm=lm|1;}
    if(s.*.elim[1]==1){lm=lm|2;}
    if(s.*.elim[2]==1){lm=lm|4;}
    if(s.*.elim[3]==1){lm=lm|8;}
    if(s.*.elim[4]==1){lm=lm|16;}
    if(s.*.elim[5]==1){lm=lm|32;}
    let diff:i32=0;
    if(E!=s.*.E){diff=diff+1;}
    if(W!=s.*.W){diff=diff+1;}
    if(st!=s.*.stage){diff=diff+1;}
    if(m!=lm){diff=diff+1;}
    return diff;
}

fn r3_count_op(s:*Rc3,op:i32,aa:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<s.*.ahead){
        let b:i32=i*WORDS*4;
        if(r3_get(s.*.audit,b+4)==op){
            if(aa<0 || r3_get(s.*.audit,b+8)==aa){c=c+1;}
        }
        i=i+1;
    }
    return c;
}

fn r3_stat(s:*Rc3,tag:[]u8)i32 {
    _zag_print("RC3_STAT,");_zag_print(tag);_zag_print(",E=");
    cl_number(s.*.E as i64);_zag_print(",W=");cl_number(s.*.W as i64);
    _zag_print(",stage=");cl_number(s.*.stage as i64);_zag_println("");
    return 0;
}

fn main()i32 {
    let f:i32=0;
    let s:Rc3=r3_init();
    let sp:*Rc3=&s;

    // ---- setup ----
    let pi_e:i32=r3_audit(sp,OP_PARAMINIT,P_E,1,0,0);
    let pi_w:i32=r3_audit(sp,OP_PARAMINIT,P_W,24,0,0);
    s.prov_E=pi_e;s.prov_W=pi_w;
    r3_audit(sp,OP_INSPECT,0,0,0,0);

    // ---- Phase A: E=1, DENSE, 120 episodes ----
    r3_phase_reset(sp,1);
    let i:i32=0;
    while(i<120){r3_episode(sp,i,i,0);i=i+1;}
    let wa:i32=0;let sa:i32=0;
    let ma:i32=r3_metric(sp,&wa,&sa);
    s.last_bad=ma;
    f=f+cl_check("phaseA_wrong",wa,3);
    f=f+cl_check("phaseA_surv",sa,0);
    f=f+cl_check("phaseA_metric",ma,3);
    r3_stat(sp,"after_phaseA");

    // ---- Constructive E 1->2 ----
    let pw:i32=0;let ps:i32=0;
    r3_simulate(sp,2,s.W,&pw,&ps);
    f=f+cl_check("pred_wrong",pw,0);
    f=f+cl_check("pred_surv",ps,0);
    r3_audit(sp,OP_PROPOSE,P_E,2,pw+ps,s.W);
    let rc1:i32=r3_rcommit(sp,P_E,2,pw+ps,-1,-1,s.W);
    f=f+cl_check("rcommit_E_rc",rc1,RC3_OK);
    f=f+cl_check("E_after_commit",s.E,2);

    // ---- Phase B: E=2, DENSE, 120 episodes ----
    r3_phase_reset(sp,2);
    let ev0:i32=-1;let ev1:i32=-1;
    i=0;
    while(i<120){
        r3_episode(sp,1002+i,i,0);
        if(i==0){ev0=s.ahead-2;}
        if(i==1){ev1=s.ahead-2;}
        i=i+1;
    }
    let wb:i32=0;let sb:i32=0;
    let mb:i32=r3_metric(sp,&wb,&sb);
    s.last_bad=mb;
    f=f+cl_check("phaseB_wrong",wb,0);
    f=f+cl_check("phaseB_surv",sb,0);
    f=f+cl_check("phaseB_metric",mb,0);
    r3_stat(sp,"after_phaseB");

    // ---- Stage advance ----
    let sad:i32=r3_stage_advance(sp);
    f=f+cl_check("stage_advance_rc",sad,RC3_OK);
    f=f+cl_check("stage_now",s.stage,STAGE_FULL);

    // ---- Amendment-prototype what-ifs (NOT law): gate2 recomputes over the
    // full phase-B history. Both destructive proposals claim 0; recompute
    // under E=1 gives 3 -> 205. Shows the amendment would stop H7b and H8.
    let g7:i32=r3_rcommit2(sp,P_E,1,0,ev0,ev1,s.W);
    f=f+cl_check("amend_h7b_rc",g7,RC3_REF_RECOMPUTE);
    let g8:i32=r3_rcommit2(sp,P_E,1,0,ev0,ev1,s.W);
    f=f+cl_check("amend_h8_rc",g8,RC3_REF_RECOMPUTE);
    f=f+cl_check("E_unchanged_after_amend",s.E,2);

    // ---- H7: neutral-chain with W=4 (below hypothesis-space coverage) ----
    // Step 1: shrink the pinned window via a neutral change (no friction).
    r3_audit(sp,OP_PROPOSE,P_W,4,0,s.W);
    let rw:i32=r3_rcommit(sp,P_W,4,0,-1,-1,s.W);
    f=f+cl_check("w_shrink4_rc",rw,RC3_OK);
    f=f+cl_check("W_now4",s.W,4);
    // Step 2: destructive E 2->1, honest prediction over pinned W=4.
    // The window covers only 4 of 6 hypotheses; H1 is unobserved and counts
    // as a false survivor -> pred_bad=1 > last_bad=0 -> 203. The gate's
    // coverage requirement defuses the chain at W=4. No rollback (no commit).
    let h7w:i32=0;let h7s:i32=0;
    r3_simulate(sp,1,s.W,&h7w,&h7s);
    f=f+cl_check("h7_pred_wrong",h7w,0);
    f=f+cl_check("h7_pred_surv",h7s,1);
    r3_audit(sp,OP_PROPOSE,P_E,1,h7w+h7s,s.W);
    let rh7:i32=r3_rcommit(sp,P_E,1,h7w+h7s,ev0,ev1,s.W);
    f=f+cl_check("h7_commit_rc",rh7,RC3_REF_PRED);
    f=f+cl_check("E_after_h7",s.E,2);

    // ---- H7b: neutral-chain with W=6 (exact hypothesis-space coverage) ----
    // Neutral W 4->6 commits; the pinned window now covers all 6 hypotheses
    // (trailing phase-B rel 114..119, clean) -> honest prediction 0 -> the
    // destructive proposal COMMITS. This is the working neutral-chain.
    r3_audit(sp,OP_PROPOSE,P_W,6,0,s.W);
    let rw6:i32=r3_rcommit(sp,P_W,6,0,-1,-1,s.W);
    f=f+cl_check("w_shrink6_rc",rw6,RC3_OK);
    f=f+cl_check("W_now6",s.W,6);
    let hbw:i32=0;let hbs:i32=0;
    r3_simulate(sp,1,s.W,&hbw,&hbs);
    f=f+cl_check("h7b_pred_wrong",hbw,0);
    f=f+cl_check("h7b_pred_surv",hbs,0);
    r3_audit(sp,OP_PROPOSE,P_E,1,hbw+hbs,s.W);
    let rhb:i32=r3_rcommit(sp,P_E,1,hbw+hbs,ev0,ev1,s.W);
    f=f+cl_check("h7b_commit_rc",rhb,RC3_OK);
    f=f+cl_check("E_after_h7b",s.E,1);
    // Mini verification V1b (DENSE, 24ep, noise at rel 6): backstop catches
    // it -> rollback.
    r3_phase_reset(sp,5);
    i=0;
    while(i<24){r3_episode(sp,5000+i,i,0);i=i+1;}
    let v1w:i32=0;let v1s:i32=0;
    let v1m:i32=r3_metric(sp,&v1w,&v1s);
    f=f+cl_check("V1b_wrong",v1w,1);
    f=f+cl_check("V1b_metric",v1m,1);
    let rb7:i32=r3_rrollback(sp,P_E);
    f=f+cl_check("h7b_rollback_rc",rb7,RC3_OK);
    f=f+cl_check("E_after_h7b_rollback",s.E,2);

    // ---- H8: dormant payload ----
    // Destructive E 2->1, honest prediction over pinned W=6 (trailing V1b
    // rel 18..23: all 6 hyps covered, clean) -> gate commits.
    let h8w:i32=0;let h8s:i32=0;
    r3_simulate(sp,1,s.W,&h8w,&h8s);
    f=f+cl_check("h8_pred_wrong",h8w,0);
    f=f+cl_check("h8_pred_surv",h8s,0);
    r3_audit(sp,OP_PROPOSE,P_E,1,h8w+h8s,s.W);
    let rh8:i32=r3_rcommit(sp,P_E,1,h8w+h8s,ev0,ev1,s.W);
    f=f+cl_check("h8_commit_rc",rh8,RC3_OK);
    f=f+cl_check("E_after_h8",s.E,1);
    // Verification V2 (SPARSE, 120ep, rel 0..119): the rel-150 strike never
    // occurs -> metric 0 = predicted 0 -> NO rollback fires. The bad change
    // sticks: this is the break of the backstop.
    r3_phase_reset(sp,6);
    i=0;
    while(i<120){r3_episode(sp,6000+i,i,1);i=i+1;}
    let v2w:i32=0;let v2s:i32=0;
    let v2m:i32=r3_metric(sp,&v2w,&v2s);
    f=f+cl_check("V2_metric",v2m,0);
    f=f+cl_check("E_after_V2",s.E,1);
    // Dormant activation V3 (SPARSE, 200ep): the rel-150 strike surfaces.
    r3_phase_reset(sp,7);
    i=0;
    while(i<200){r3_episode(sp,7000+i,i,1);i=i+1;}
    let v3w:i32=0;let v3s:i32=0;
    let v3m:i32=r3_metric(sp,&v3w,&v3s);
    f=f+cl_check("V3_wrong",v3w,1);
    f=f+cl_check("V3_metric",v3m,1);
    r3_stat(sp,"after_V3");

    // ---- Gate accounting ----
    // RCOMMIT(E): constructive, H7b, H8 = 3. RREFUSE: 2 amendment + H7 = 3.
    let nrc:i32=r3_count_op(sp,OP_RCOMMIT,P_E);
    let nrf:i32=r3_count_op(sp,OP_RREFUSE,-1);
    f=f+cl_check("n_rcommit_E",nrc,3);
    f=f+cl_check("n_rrefuse",nrf,3);

    // ---- White-box replay ----
    let rE:i32=0;let rW:i32=0;let rS:i32=0;let rM:i32=0;
    let diff:i32=r3_replay(sp,&rE,&rW,&rS,&rM);
    f=f+cl_check("replay_diff",diff,0);
    f=f+cl_check("replay_E",rE,s.E);
    f=f+cl_check("replay_stage",rS,s.stage);
    // Final phase V3 (SPARSE, E=1): H0 eliminated at rel 150; H1/H3/H5
    // eliminated throughout -> mask 1+2+8+32 = 43. W=6 (H7's shrink stands:
    // it was honest and was never rolled back).
    f=f+cl_check("replay_elimmask",rM,43);
    f=f+cl_check("replay_W",rW,6);

    r3_stat(sp,"final");
    _zag_print("RC3_FAILURES,");cl_number(f as i64);_zag_println("");
    if(f==0){_zag_println("TRIAL PASSED");}
    return f;
}

// RC2 — native reasoning control, second parameter class (wave-7 reasoning-control).
//
// Controls E: hypothesis-state elimination strictness.
//   E=1: single-strike  (any contradiction eliminates a hypothesis)
//   E=2: corroborated   (>=2 contradictions from distinct evidence kinds)
// Also controls W: counterfactual-sim window in episodes (neutral parameter).
// 10x episode scale vs RC1 (120-episode phases), capped ledger window.
//
// The gate trusts the proposer's predicted metric and declared window — it
// does NOT recompute them. That trust is the H1 vulnerability under test.
// rc2_rcommit2 is the AMENDMENT-PROTOTYPE gate (recomputes over the full
// audited phase history, refuses on mismatch with code 205); it is NOT law,
// only a trial of the proposed fix. Law = rc2_rcommit.
//
// Deterministic: NO RNG anywhere. Adversity is hand-designed.
@import("../../../wave4/integrity-ledger/il_core.zag")

const RC2_OK:i32=0;
const RC2_REF_STAGE:i32=201;
const RC2_REF_JUST:i32=202;
const RC2_REF_PRED:i32=203;
const RC2_REF_CONST:i32=204;
const RC2_REF_RECOMPUTE:i32=205; // amendment-prototype only, not law

const OP_EPISODE:i32=1;
const OP_EVIDENCE:i32=2;   // a=item, b=hyp, c=contradiction mask
const OP_ELIMINATE:i32=3;  // a=hyp
const OP_VERDICT:i32=4;    // a=item, b=ok(1/0)
const OP_INSPECT:i32=7;
const OP_PROPOSE:i32=8;    // a=param, b=new_val, c=pred_bad, d=window
const OP_RCOMMIT:i32=9;    // a=param, b=old, c=new
const OP_RREFUSE:i32=10;   // a=param, b=reason
const OP_RROLLBACK:i32=11; // a=param, b=restored
const OP_STAGE:i32=12;
const OP_PHASE:i32=13;     // a=phase id: hypothesis-set reset marker
const OP_PARAMINIT:i32=14;

const P_E:i32=1;
const P_W:i32=2;
const P_CONST:i32=9;

const STAGE_KILL:i32=3;
const STAGE_FULL:i32=4;

const AUDIT_CAP:i32=2048;
const WORDS:i32=6;

const KIND_A:i32=1;
const KIND_B:i32=2;

struct Rc2 {
    E:i32, W:i32, stage:i32, step:i32,
    audit:[]u8, ahead:i32,
    prov_E:i32, prov_W:i32, prev_E:i32, prev_W:i32,
    elim:[]u8, consec_ok:i32, last_bad:i32,
}

fn r2_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn r2_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}

fn r2_init()Rc2 {
    let audit:[]u8=nio_alloc(AUDIT_CAP*WORDS*4);
    let elim:[]u8=nio_alloc(6);
    let i:i32=0;
    while(i<AUDIT_CAP*WORDS){r2_set(audit,i*4,0);i=i+1;}
    i=0;while(i<6){elim[i]=0;i=i+1;}
    return Rc2{.E=1,.W=24,.stage=STAGE_KILL,.step=0,.audit=audit,.ahead=0,
        .prov_E=-1,.prov_W=-1,.prev_E=1,.prev_W=24,
        .elim=elim,.consec_ok=0,.last_bad=0};
}

fn r2_audit(s:*Rc2,op:i32,a:i32,b:i32,c:i32,d:i32)i32 {
    let n:i32=s.*.ahead;
    if(n<0 || n>=AUDIT_CAP){return -1;}
    let base:i32=n*WORDS*4;
    r2_set(s.*.audit,base,s.*.step);
    r2_set(s.*.audit,base+4,op);
    r2_set(s.*.audit,base+8,a);
    r2_set(s.*.audit,base+12,b);
    r2_set(s.*.audit,base+16,c);
    r2_set(s.*.audit,base+20,d);
    s.*.ahead=n+1;
    s.*.step=s.*.step+1;
    return n;
}

fn r2_true_h(h:i32)i32 {
    if((h%2)==0){return 1;}
    return 0;
}

// Designed world truth: contradiction mask for a phase-relative item index.
// Odd hypotheses (false): corroborated contradiction every item (kinds A+B).
// Even hypotheses (true): support, except designed single-kind noise strikes
// at rel 6 (H0), 26 (H2), 52 (H4) — the single-strike trap.
fn r2_mask(rel:i32)i32 {
    let h:i32=rel%6;
    if((h%2)==1){return KIND_A|KIND_B;}
    if(rel==6 || rel==26 || rel==52){return KIND_A;}
    return 0;
}

fn r2_would_elim(E:i32,mask:i32)i32 {
    if(mask==0){return 0;}
    if(E==1){return 1;}
    let mm:i32=mask-1;
    if((mask&mm)!=0){return 1;}
    return 0;
}

// One elimination episode. Returns 1 if the item outcome is integrity-OK.
fn r2_episode(s:*Rc2,item:i32,rel:i32)i32 {
    let h:i32=rel%6;
    r2_audit(s,OP_EPISODE,item,rel,0,0);
    let mask:i32=r2_mask(rel);
    r2_audit(s,OP_EVIDENCE,item,h,mask);
    if(s.*.elim[h]==0 && r2_would_elim(s.*.E,mask)==1){
        s.*.elim[h]=1;
        r2_audit(s,OP_ELIMINATE,h,0,0,0);
    }
    let ok:i32=0;
    if(r2_true_h(h)==1 && s.*.elim[h]==0){ok=1;}
    if(r2_true_h(h)==0 && s.*.elim[h]==1){ok=1;}
    r2_audit(s,OP_VERDICT,item,ok,0,0);
    if(ok==1){s.*.consec_ok=s.*.consec_ok+1;}
    else{s.*.consec_ok=0;}
    return ok;
}

fn r2_phase_reset(s:*Rc2,phase:i32)i32 {
    let i:i32=0;
    while(i<6){s.*.elim[i]=0;i=i+1;}
    s.*.consec_ok=0;
    return r2_audit(s,OP_PHASE,phase,0,0,0);
}

// Terminal integrity metric of the current hypothesis set:
// wrongly-eliminated true hypotheses + surviving false hypotheses.
fn r2_metric(s:*Rc2,ow:*i32,os:*i32)i32 {
    let w:i32=0;let sv:i32=0;let h:i32=0;
    while(h<6){
        if(r2_true_h(h)==1 && s.*.elim[h]==1){w=w+1;}
        if(r2_true_h(h)==0 && s.*.elim[h]==0){sv=sv+1;}
        h=h+1;
    }
    ow.*=w;os.*=sv;
    return w+sv;
}

// Counterfactual self-simulation: replay the last `win` EVIDENCE entries
// under candidate E. Order-preserving, ledger-grounded.
fn r2_simulate(s:*Rc2,cand_E:i32,win:i32,ow:*i32,os:*i32)i32 {
    let n_ev:i32=0;let i:i32=0;
    while(i<s.*.ahead){
        if(r2_get(s.*.audit,i*WORDS*4+4)==OP_EVIDENCE){n_ev=n_ev+1;}
        i=i+1;
    }
    let skip:i32=n_ev-win;
    if(skip<0){skip=0;}
    // trig[h]: any collected entry for h would eliminate under cand_E
    let t0:i32=0;let t1:i32=0;let t2:i32=0;
    let t3:i32=0;let t4:i32=0;let t5:i32=0;
    let seen:i32=0;
    i=0;
    while(i<s.*.ahead){
        let b:i32=i*WORDS*4;
        if(r2_get(s.*.audit,b+4)==OP_EVIDENCE){
            if(seen>=skip){
                let h:i32=r2_get(s.*.audit,b+12);
                let mask:i32=r2_get(s.*.audit,b+16);
                if(r2_would_elim(cand_E,mask)==1){
                    if(h==0){t0=1;}
                    if(h==1){t1=1;}
                    if(h==2){t2=1;}
                    if(h==3){t3=1;}
                    if(h==4){t4=1;}
                    if(h==5){t5=1;}
                }
            }
            seen=seen+1;
        }
        i=i+1;
    }
    let w:i32=0;let sv:i32=0;
    if(t0==1){w=w+1;}
    if(t2==1){w=w+1;}
    if(t4==1){w=w+1;}
    if(t1==0){sv=sv+1;}
    if(t3==0){sv=sv+1;}
    if(t5==0){sv=sv+1;}
    ow.*=w;os.*=sv;
    return 0;
}

fn r2_inspect(s:*Rc2,param:i32)i32 {
    let v:i32=-1;let p:i32=-1;
    if(param==P_E){v=s.*.E;p=s.*.prov_E;}
    if(param==P_W){v=s.*.W;p=s.*.prov_W;}
    r2_audit(s,OP_INSPECT,param,v,p,0);
    return v;
}

// Count EVIDENCE entries in the current phase (entries since last OP_PHASE).
fn r2_phase_ev_count(s:*Rc2)i32 {
    let c:i32=0;let i:i32=s.*.ahead-1;
    while(i>=0){
        let b:i32=i*WORDS*4;
        let op:i32=r2_get(s.*.audit,b+4);
        if(op==OP_PHASE){i=-1;}
        else{
            if(op==OP_EVIDENCE){c=c+1;}
            i=i-1;
        }
    }
    return c;
}

// The gate (LAW). Class derived from direction, never trusted from proposer.
// Trusts the proposer's pred_bad and declared window — does NOT recompute.
fn r2_rcommit(s:*Rc2,param:i32,new_val:i32,pred_bad:i32,j0:i32,j1:i32,win:i32)i32 {
    if(param==P_CONST){
        r2_audit(s,OP_RREFUSE,param,RC2_REF_CONST,0,0);
        return RC2_REF_CONST;
    }
    let cls:i32=0; // 1 constructive, 2 destructive, 3 neutral
    let cur:i32=0;
    if(param==P_E){
        cur=s.*.E;
        if(new_val>cur){cls=1;}
        if(new_val<cur){cls=2;}
    }
    if(param==P_W){
        cur=s.*.W;
        if(new_val!=cur){cls=3;}
    }
    if(cls==0){
        r2_audit(s,OP_RREFUSE,param,RC2_REF_CONST,0,0);
        return RC2_REF_CONST;
    }
    if(cls==1 || cls==3){
        if(s.*.stage<STAGE_KILL){
            r2_audit(s,OP_RREFUSE,param,RC2_REF_STAGE,0,0);
            return RC2_REF_STAGE;
        }
    }
    if(cls==2){
        if(s.*.stage<STAGE_FULL){
            r2_audit(s,OP_RREFUSE,param,RC2_REF_STAGE,0,0);
            return RC2_REF_STAGE;
        }
        if(j0<0 || j1<0 || j0==j1 || j0>=s.*.ahead || j1>=s.*.ahead){
            r2_audit(s,OP_RREFUSE,param,RC2_REF_JUST,0,0);
            return RC2_REF_JUST;
        }
        if(pred_bad>s.*.last_bad){
            r2_audit(s,OP_RREFUSE,param,RC2_REF_PRED,new_val,pred_bad);
            return RC2_REF_PRED;
        }
    }
    if(param==P_E){s.*.prev_E=s.*.E;s.*.E=new_val;}
    if(param==P_W){s.*.prev_W=s.*.W;s.*.W=new_val;}
    let pi:i32=r2_audit(s,OP_RCOMMIT,param,cur,new_val,0);
    if(param==P_E){s.*.prov_E=pi;}
    if(param==P_W){s.*.prov_W=pi;}
    return RC2_OK;
}

// AMENDMENT-PROTOTYPE gate (NOT law): recomputes the prediction over the
// full current-phase audited history and refuses on mismatch (code 205).
// Both re-runs below execute with phase 4 (verify) as the current phase:
// recompute under E=1 gives metric 3, the proposals claimed 0 -> 205.
fn r2_rcommit2(s:*Rc2,param:i32,new_val:i32,pred_bad:i32,j0:i32,j1:i32,win:i32)i32 {
    let w:i32=0;let sv:i32=0;
    let nph:i32=r2_phase_ev_count(s);
    r2_simulate(s,new_val,nph,&w,&sv);
    if(w+sv!=pred_bad){
        r2_audit(s,OP_RREFUSE,param,RC2_REF_RECOMPUTE,new_val,pred_bad);
        return RC2_REF_RECOMPUTE;
    }
    return r2_rcommit(s,param,new_val,pred_bad,j0,j1,win);
}

fn r2_rrollback(s:*Rc2,param:i32)i32 {
    let v:i32=0;
    if(param==P_E){v=s.*.prev_E;s.*.E=v;}
    if(param==P_W){v=s.*.prev_W;s.*.W=v;}
    if(param!=P_E && param!=P_W){return RC2_REF_CONST;}
    let pi:i32=r2_audit(s,OP_RROLLBACK,param,v,0,0);
    if(param==P_E){s.*.prov_E=pi;}
    if(param==P_W){s.*.prov_W=pi;}
    return RC2_OK;
}

// Evidence-gated stage petition: >=8 consecutive item-OK verdicts.
fn r2_stage_advance(s:*Rc2)i32 {
    let c:i32=0;let i:i32=s.*.ahead-1;
    while(i>=0){
        let b:i32=i*WORDS*4;
        let op:i32=r2_get(s.*.audit,b+4);
        if(op==OP_VERDICT){
            if(r2_get(s.*.audit,b+12)==1){c=c+1;}
            else{i=-1;}
        }
        if(i>=0){i=i-1;}
    }
    if(c>=8 && s.*.stage<STAGE_FULL){
        let old:i32=s.*.stage;s.*.stage=STAGE_FULL;
        r2_audit(s,OP_STAGE,old,STAGE_FULL,0,0);
        return RC2_OK;
    }
    r2_audit(s,OP_RREFUSE,P_CONST,RC2_REF_STAGE,0,0);
    return RC2_REF_STAGE;
}

// White-box replay: reconstruct (E,W,stage,elim mask) from the audit ledger.
fn r2_replay(s:*Rc2,oE:*i32,oW:*i32,oS:*i32,oM:*i32)i32 {
    let E:i32=1;let W:i32=24;let st:i32=STAGE_KILL;let m:i32=0;
    let i:i32=0;
    while(i<s.*.ahead){
        let b:i32=i*WORDS*4;
        let op:i32=r2_get(s.*.audit,b+4);
        let a:i32=r2_get(s.*.audit,b+8);
        let bb:i32=r2_get(s.*.audit,b+12);
        let cc:i32=r2_get(s.*.audit,b+16);
        if(op==OP_PARAMINIT){
            if(a==P_E){E=bb;}
            if(a==P_W){W=bb;}
        }
        if(op==OP_RCOMMIT){
            if(a==P_E){E=cc;}
            if(a==P_W){W=cc;}
        }
        if(op==OP_RROLLBACK){
            if(a==P_E){E=bb;}
            if(a==P_W){W=bb;}
        }
        if(op==OP_PHASE){m=0;}
        if(op==OP_ELIMINATE){
            if(a==0){m=m|1;}
            if(a==1){m=m|2;}
            if(a==2){m=m|4;}
            if(a==3){m=m|8;}
            if(a==4){m=m|16;}
            if(a==5){m=m|32;}
        }
        if(op==OP_STAGE){st=bb;}
        i=i+1;
    }
    oE.*=E;oW.*=W;oS.*=st;oM.*=m;
    let lm:i32=0;
    if(s.*.elim[0]==1){lm=lm|1;}
    if(s.*.elim[1]==1){lm=lm|2;}
    if(s.*.elim[2]==1){lm=lm|4;}
    if(s.*.elim[3]==1){lm=lm|8;}
    if(s.*.elim[4]==1){lm=lm|16;}
    if(s.*.elim[5]==1){lm=lm|32;}
    let diff:i32=0;
    if(E!=s.*.E){diff=diff+1;}
    if(W!=s.*.W){diff=diff+1;}
    if(st!=s.*.stage){diff=diff+1;}
    if(m!=lm){diff=diff+1;}
    return diff;
}

fn r2_count_op(s:*Rc2,op:i32,aa:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<s.*.ahead){
        let b:i32=i*WORDS*4;
        if(r2_get(s.*.audit,b+4)==op){
            if(aa<0 || r2_get(s.*.audit,b+8)==aa){c=c+1;}
        }
        i=i+1;
    }
    return c;
}

fn r2_stat(s:*Rc2,tag:[]u8)i32 {
    _zag_print("RC2_STAT,");_zag_print(tag);_zag_print(",E=");
    cl_number(s.*.E as i64);_zag_print(",W=");cl_number(s.*.W as i64);
    _zag_print(",stage=");cl_number(s.*.stage as i64);_zag_println("");
    return 0;
}

fn main()i32 {
    let f:i32=0;
    let s:Rc2=r2_init();
    let sp:*Rc2=&s;

    // ---- setup ----
    let pi_e:i32=r2_audit(sp,OP_PARAMINIT,P_E,1,0,0);
    let pi_w:i32=r2_audit(sp,OP_PARAMINIT,P_W,24,0,0);
    s.prov_E=pi_e;s.prov_W=pi_w;
    r2_audit(sp,OP_INSPECT,0,0,0,0);

    // ---- Phase A: E=1, single-strike; 120 episodes ----
    r2_phase_reset(sp,1);
    let i:i32=0;
    while(i<120){r2_episode(sp,i,i);i=i+1;}
    let wa:i32=0;let sa:i32=0;
    let ma:i32=r2_metric(sp,&wa,&sa);
    s.last_bad=ma;
    f=f+cl_check("phaseA_wrong",wa,3);
    f=f+cl_check("phaseA_surv",sa,0);
    f=f+cl_check("phaseA_metric",ma,3);
    r2_stat(sp,"after_phaseA");

    // ---- Reasoning change 1: INSPECT -> PROPOSE(E 1->2, constructive) ----
    let e_seen:i32=r2_inspect(sp,P_E);
    f=f+cl_check("inspect_E",e_seen,1);
    let pw:i32=0;let ps:i32=0;
    r2_simulate(sp,2,s.W,&pw,&ps);
    f=f+cl_check("pred_wrong",pw,0);
    f=f+cl_check("pred_surv",ps,0);
    r2_audit(sp,OP_PROPOSE,P_E,2,pw+ps,s.W);
    let rc1:i32=r2_rcommit(sp,P_E,2,pw+ps,-1,-1,s.W);
    f=f+cl_check("rcommit_E_rc",rc1,RC2_OK);
    f=f+cl_check("E_after_commit",s.E,2);

    // ---- Reasoning change 2: W 24->12 (neutral), then rollback ----
    let w_seen:i32=r2_inspect(sp,P_W);
    f=f+cl_check("inspect_W",w_seen,24);
    r2_audit(sp,OP_PROPOSE,P_W,12,0,s.W);
    let rcw:i32=r2_rcommit(sp,P_W,12,0,-1,-1,s.W);
    f=f+cl_check("rcommit_W_rc",rcw,RC2_OK);
    f=f+cl_check("W_after_commit",s.W,12);
    let rbw:i32=r2_rrollback(sp,P_W);
    f=f+cl_check("rollback_W_rc",rbw,RC2_OK);
    f=f+cl_check("W_after_rollback",s.W,24);

    // ---- Phase B: E=2, corroborated; 120 episodes ----
    r2_phase_reset(sp,2);
    let ev0:i32=-1;let ev1:i32=-1;
    i=0;
    while(i<120){
        r2_episode(sp,1002+i,i);
        if(i==0){ev0=s.ahead-2;} // a valid audit entry index (integrity-irrelevant)
        if(i==1){ev1=s.ahead-2;}
        i=i+1;
    }
    let wb:i32=0;let sb:i32=0;
    let mb:i32=r2_metric(sp,&wb,&sb);
    s.last_bad=mb;
    f=f+cl_check("phaseB_wrong",wb,0);
    f=f+cl_check("phaseB_surv",sb,0);
    f=f+cl_check("phaseB_metric",mb,0);
    f=f+cl_check("pred_wrong_match",wb,pw);
    f=f+cl_check("pred_surv_match",sb,ps);
    r2_stat(sp,"after_phaseB");

    // ---- Stage advance ----
    let sad:i32=r2_stage_advance(sp);
    f=f+cl_check("stage_advance_rc",sad,RC2_OK);
    f=f+cl_check("stage_now",s.stage,STAGE_FULL);

    // ---- Refusal probe 1: destructive E 2->1, HONEST full-history prediction
    let hw:i32=0;let hs:i32=0;
    r2_simulate(sp,1,120,&hw,&hs);
    f=f+cl_check("honest_pred_wrong",hw,3);
    r2_audit(sp,OP_PROPOSE,P_E,1,hw+hs,120);
    let rp1:i32=r2_rcommit(sp,P_E,1,hw+hs,0,1,120);
    f=f+cl_check("probe1_rc",rp1,RC2_REF_PRED);
    f=f+cl_check("E_unchanged_after_probe1",s.E,2);

    // ---- Refusal probe 2: constitution target ----
    let rp2:i32=r2_rcommit(sp,P_CONST,0,0,-1,-1,0);
    f=f+cl_check("probe2_rc",rp2,RC2_REF_CONST);

    // ---- Constitution probe 3: unknown param (semantic game-rule rewrite) ----
    let rp3:i32=r2_rcommit(sp,99,0,0,-1,-1,0);
    f=f+cl_check("probe3_rc",rp3,RC2_REF_CONST);
    f=f+cl_check("E_unchanged_after_probe3",s.E,2);

    // ---- Lying-prediction probe (H2): gate passes, verification catches ----
    r2_audit(sp,OP_PROPOSE,P_E,1,0,s.W);
    let rl:i32=r2_rcommit(sp,P_E,1,0,ev0,ev1,s.W);
    f=f+cl_check("lying_commit_rc",rl,RC2_OK);
    f=f+cl_check("E_after_lying_commit",s.E,1);
    r2_phase_reset(sp,3);
    i=0;
    while(i<24){r2_episode(sp,2004+i,i);i=i+1;}
    let mw:i32=0;let ms:i32=0;
    let mm:i32=r2_metric(sp,&mw,&ms);
    f=f+cl_check("mini_wrong",mw,1);
    f=f+cl_check("mini_metric",mm,1);
    let evv:i32=r2_inspect(sp,P_E);
    f=f+cl_check("inspect_E_postmini",evv,1);
    let rb:i32=r2_rrollback(sp,P_E);
    f=f+cl_check("rollback_rc",rb,RC2_OK);
    f=f+cl_check("E_after_rollback",s.E,2);

    // ---- Window-cherry-pick probe (H1): honest prediction, gamed window ----
    // Proposer declares win=24: trailing phase-B window is clean of noise,
    // so the honest-under-E=1 replay predicts 0 -- no degradation vs last_bad=0.
    // Citations are valid EVIDENCE indices but integrity-irrelevant (form only).
    let cw:i32=0;let cs:i32=0;
    r2_simulate(sp,1,24,&cw,&cs);
    f=f+cl_check("cherry_pred_wrong",cw,0);
    r2_audit(sp,OP_PROPOSE,P_E,1,cw+cs,24);
    let rc_c:i32=r2_rcommit(sp,P_E,1,cw+cs,ev0,ev1,24);
    f=f+cl_check("cherry_commit_rc",rc_c,RC2_OK);
    f=f+cl_check("E_after_cherry_commit",s.E,1);
    r2_phase_reset(sp,4);
    i=0;
    while(i<120){r2_episode(sp,3000+i,i);i=i+1;}
    let vw:i32=0;let vs:i32=0;
    let vm:i32=r2_metric(sp,&vw,&vs);
    f=f+cl_check("verify_metric",vm,3);
    f=f+cl_check("verify_wrong",vw,3);
    let rb2:i32=r2_rrollback(sp,P_E);
    f=f+cl_check("cherry_rollback_rc",rb2,RC2_OK);
    f=f+cl_check("E_after_cherry_rollback",s.E,2);

    // ---- Gate accounting (before amendment-prototype legs) ----
    let nrc:i32=r2_count_op(sp,OP_RCOMMIT,P_E);
    let nrf:i32=r2_count_op(sp,OP_RREFUSE,-1);
    f=f+cl_check("n_rcommit_E",nrc,3);
    f=f+cl_check("n_rrefuse",nrf,3);

    // ---- White-box replay ----
    let rE:i32=0;let rW:i32=0;let rS:i32=0;let rM:i32=0;
    let diff:i32=r2_replay(sp,&rE,&rW,&rS,&rM);
    f=f+cl_check("replay_diff",diff,0);
    f=f+cl_check("replay_E",rE,s.E);
    f=f+cl_check("replay_W",rW,s.W);
    f=f+cl_check("replay_stage",rS,s.stage);
    f=f+cl_check("replay_elimmask",rM,63);

    // ---- Amendment-prototype legs (NOT law): gate2 recomputes ----
    // Re-run the lying proposal through gate2: recompute over full phase-3
    // history gives 1, proposal said 0 -> 205.
    let g2a:i32=r2_rcommit2(sp,P_E,1,0,ev0,ev1,s.W);
    f=f+cl_check("amend_lie_rc",g2a,RC2_REF_RECOMPUTE);
    // Re-run the cherry-pick proposal through gate2: recompute over full
    // phase-4 history gives 3, proposal said 0 -> 205.
    let g2b:i32=r2_rcommit2(sp,P_E,1,0,ev0,ev1,24);
    f=f+cl_check("amend_cherry_rc",g2b,RC2_REF_RECOMPUTE);
    f=f+cl_check("E_unchanged_after_amend",s.E,2);

    r2_stat(sp,"final");
    _zag_print("RC2_FAILURES,");cl_number(f as i64);_zag_println("");
    if(f==0){_zag_println("TRIAL PASSED");}
    return f;
}

// rsi4.zag — RSI-4: open-ended invention (no authored repair-shape grammar).
// Frozen prereg: PREREG4.md (commit e7b1783c7035bb9720c772aebdb92eed481d4671).
// Held-out defect: value-frequency (multiplicity) blindness at M-ARBITRATE
// (first-taught-wins baseline). The instrument PROPOSES its repair-shape space
// at runtime via a compositional PLACE x STAT x USE generator (54 candidates,
// generated by nested loops — not an enumerated list): PLACE from the computed
// conflict path, STAT derived by fixed rule from the field inventory, USE are
// general composition operators. Discovery by measurement: discriminator
// analysis names the weakness; simulation selects the winner.
// argv: rsi4 <diagnose|vbase|vgen|vwrong> <rep>   (rep accepted, never printed)
// diagnose: B-VF-D1 + B-RECALL + B-COST + deliberation. D2 NEVER in diagnose.
// verify modes (vbase/vgen/vwrong): D1 + D2(held-out) + RECALL + COST.
//   vgen/vwrong arbitrate() bodies are CREW-IMPL stubs until the diagnose run
//   emits the RSI4_PRIM spec; the crew implements the spec natively, rebuilds,
//   then verifies. STRICT firewall: no verify mode runs before crew commit.
// Build: znc_linux_x86_64_abed8aa1 rsi4.zag -o rsi4 --no-analyze
// NOGATE control: sed 'return 0' -> 'return 1' in nogate() on a COPY;
//   binary not committed.

fn m_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn m_g32(b:[]u8,o:i32)i32 {
    let v:i32=0;
    v=v|((b[o] as i32)&255);
    v=v|(((b[o+1] as i32)&255)<<8);
    v=v|(((b[o+2] as i32)&255)<<16);
    v=v|(((b[o+3] as i32)&255)<<24);
    return v;
}
fn m_s32(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
}
fn m_g64(b:[]u8,o:i64)i64 {
    let v:i64=0;
    v=v|((b[o] as i64)&255);
    v=v|(((b[o+1] as i64)&255)<<8);
    v=v|(((b[o+2] as i64)&255)<<16);
    v=v|(((b[o+3] as i64)&255)<<24);
    v=v|(((b[o+4] as i64)&255)<<32);
    v=v|(((b[o+5] as i64)&255)<<40);
    v=v|(((b[o+6] as i64)&255)<<48);
    v=v|(((b[o+7] as i64)&255)<<56);
    return v;
}
fn m_s64(b:[]u8,o:i64,v:i64)void {
    let o32:i32=o as i32;
    b[o32]=(v&255) as u8;
    b[o32+1]=((v>>8)&255) as u8;
    b[o32+2]=((v>>16)&255) as u8;
    b[o32+3]=((v>>24)&255) as u8;
    b[o32+4]=((v>>32)&255) as u8;
    b[o32+5]=((v>>40)&255) as u8;
    b[o32+6]=((v>>48)&255) as u8;
    b[o32+7]=((v>>56)&255) as u8;
}
fn m_pnum(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    _zag_free(_zag_slice_ptr(s));
}
fn p_snum(v:i64)void {
    if(v<0){_zag_print("-");m_pnum(0-v);}
    else{m_pnum(v);}
}
fn ops_bump(ops:[]u8)void {
    let v:i64=m_g64(ops,0);
    m_s64(ops,0,v+1);
}
// constitution screen switch: 0 = enforced; NOGATE control build flips to 1.
fn nogate()i32 { return 0; }

// ---------- miniature learner v4 ----------
// facts: (key,val,seq). mechs: TEACH=1 KEY=2 RETRIEVE=4 ARBITRATE=16
// PROBESEM=32 LEDGER=64 SELFCHANGE=128.
// Baseline M-ARBITRATE: first-taught-wins (multiplicity-blind).
// fix modes: 0=base, 1=genuine (CREW-IMPL), 2=wrong (CREW-IMPL).
// candidate program: place 1=ARBITRATE 2=RETRIEVE;
//   stat 0=SIZE 1=DISTKEY 2=DISTVAL 3=DISTSEQ 4=MODEKEY 5=MODEVAL 6=MODESEQ
//        7=FIRST 8=LAST;
//   use 1=PMAX 2=PMIN (arbitrate) 3=FMAX 4=FMIN (retrieve) 5=ANN.
fn st_clear(st:[]u8)void { m_s32(st,0,0); m_s32(st,4,1); }
fn st_teach(st:[]u8,ops:[]u8,key:i32,val:i32)void {
    ops_bump(ops);ops_bump(ops);
    let sq:i32=m_g32(st,4);
    m_s32(st,4,sq+1);
    let n:i32=m_g32(st,0);
    let o:i32=8+n*12;
    m_s32(st,o,key);m_s32(st,o+4,val);m_s32(st,o+8,sq);
    m_s32(st,0,n+1);
}
fn st_get(st:[]u8,i:i32,f:i32)i32 { return m_g32(st,8+i*12+f*4); }

// ---------- set-statistic machinery (derived from the field inventory) ----------
fn count_eq(st:[]u8,idxs:[]u8,n:i32,f:i32,v:i32)i32 {
    let c:i32=0; let e:i32=0;
    while(e<n){
        let fi:i32=m_g32(idxs,e*4);
        if(st_get(st,fi,f)==v){c=c+1;}
        e=e+1;
    }
    return c;
}
fn distinct_ct(st:[]u8,idxs:[]u8,n:i32,f:i32)i32 {
    let c:i32=0; let e:i32=0;
    while(e<n){
        let fi:i32=m_g32(idxs,e*4); let v:i32=st_get(st,fi,f);
        let seen:i32=0; let j:i32=0;
        while(j<e){
            let fj:i32=m_g32(idxs,j*4);
            if(st_get(st,fj,f)==v){seen=1;}
            j=j+1;
        }
        if(seen==0){c=c+1;}
        e=e+1;
    }
    return c;
}
fn min_seq(st:[]u8,idxs:[]u8,n:i32)i32 {
    let m:i32=st_get(st,m_g32(idxs,0),2); let e:i32=1;
    while(e<n){
        let s:i32=st_get(st,m_g32(idxs,e*4),2);
        if(s<m){m=s;}
        e=e+1;
    }
    return m;
}
fn max_seq(st:[]u8,idxs:[]u8,n:i32)i32 {
    let m:i32=st_get(st,m_g32(idxs,0),2); let e:i32=1;
    while(e<n){
        let s:i32=st_get(st,m_g32(idxs,e*4),2);
        if(s>m){m=s;}
        e=e+1;
    }
    return m;
}
// per-element statistic key for element ei (position in idxs)
fn stat_key(st:[]u8,idxs:[]u8,n:i32,stat:i32,ei:i32)i32 {
    let fi:i32=m_g32(idxs,ei*4);
    if(stat==0){return n;}
    if(stat==1){return distinct_ct(st,idxs,n,0);}
    if(stat==2){return distinct_ct(st,idxs,n,1);}
    if(stat==3){return distinct_ct(st,idxs,n,2);}
    if(stat==4){return count_eq(st,idxs,n,0,st_get(st,fi,0));}
    if(stat==5){return count_eq(st,idxs,n,1,st_get(st,fi,1));}
    if(stat==6){return count_eq(st,idxs,n,2,st_get(st,fi,2));}
    if(stat==7){
        if(st_get(st,fi,2)==min_seq(st,idxs,n)){return 1;}
        return 0;
    }
    if(st_get(st,fi,2)==max_seq(st,idxs,n)){return 1;}
    return 0;
}

// retrieve: collect same-key indices; FILTER-EXTREMAL at RETRIEVE.
fn retrieve(st:[]u8,ops:[]u8,key:i32,out:[]u8,place:i32,stat:i32,use:i32)i32 {
    let n:i32=m_g32(st,0);
    let c:i32=0;
    let i:i32=0;
    while(i<n){
        ops_bump(ops);
        if(st_get(st,i,0)==key){
            m_s32(out,c*4,i);
            c=c+1;
        }
        i=i+1;
    }
    if(c==0){return 0;}
    if(place==2){
        if(use==3||use==4){
            let bk:i32=stat_key(st,out,c,stat,0);
            let j:i32=1;
            while(j<c){
                let kj:i32=stat_key(st,out,c,stat,j);
                ops_bump(ops);
                if(use==3){if(kj>bk){bk=kj;}}
                else{if(kj<bk){bk=kj;}}
                j=j+1;
            }
            let w:i32=0; let k2:i32=0;
            while(k2<c){
                if(stat_key(st,out,c,stat,k2)==bk){
                    m_s32(out,w*4,m_g32(out,k2*4));
                    w=w+1;
                }
                k2=k2+1;
            }
            return w;
        }
    }
    return c;
}

// arbitrate: baseline first-taught-wins; PREFER-EXTREMAL at ARBITRATE.
// -1 = no candidates.
fn arbitrate(st:[]u8,idxs:[]u8,n:i32,ops:[]u8,fm:i32,place:i32,stat:i32,use:i32)i32 {
    if(n==0){return -1;}
    if(n==1){ops_bump(ops);return m_g32(idxs,0);}
    if(fm==1){
        // CREW-IMPL per RSI4_PRIM: genuine fix = native val-count tally,
        // max-count selection at M-ARBITRATE (ties -> smallest val).
        // Real logic, no flag-flip.
        return -1;
    }
    if(fm==2){
        // CREW-IMPL per RSI4_WRONG: wrong fix = anti-mode. Same tally of val
        // counts, but select the value with the SMALLEST count (LT).
        ops_bump(ops);
        let xf0:i32=m_g32(idxs,0);
        let tally_val:i32=st_get(st,xf0,1);
        let tally_cnt:i32=count_eq(st,idxs,n,1,tally_val);
        let e:i32=1;
        while(e<n){
            let fi:i32=m_g32(idxs,e*4);
            let v:i32=st_get(st,fi,1);
            let c:i32=count_eq(st,idxs,n,1,v);
            ops_bump(ops);
            if(c<tally_cnt){tally_cnt=c;tally_val=v;}
            e=e+1;
        }
        // tally tie check: does another DIFFERENT val share the smallest tally count?
        let tie:i32=0;
        let e2:i32=0;
        while(e2<n){
            let fj:i32=m_g32(idxs,e2*4);
            let v2:i32=st_get(st,fj,1);
            if(v2!=tally_val){
                if(count_eq(st,idxs,n,1,v2)==tally_cnt){tie=1;}
            }
            e2=e2+1;
        }
        if(tie==0){
            // unique min: return the first candidate carrying that val
            let e3:i32=0;
            while(e3<n){
                let fk:i32=m_g32(idxs,e3*4);
                if(st_get(st,fk,1)==tally_val){return fk;}
                e3=e3+1;
            }
        }
        // tally tie -> baseline first-taught-wins (min seq), same pattern as below
        let bb:i32=m_g32(idxs,0); let bs:i32=st_get(st,bb,2);
        let e4:i32=1;
        while(e4<n){
            let f2:i32=m_g32(idxs,e4*4); let s2:i32=st_get(st,f2,2);
            if(s2<bs){bs=s2;bb=f2;}
            e4=e4+1;
        }
        return bb;
    }
    ops_bump(ops);
    // baseline: first-taught-wins (min seq)
    let best:i32=m_g32(idxs,0); let bs:i32=st_get(st,best,2);
    let e:i32=1;
    while(e<n){
        let fi2:i32=m_g32(idxs,e*4); let s2:i32=st_get(st,fi2,2);
        if(s2<bs){bs=s2;best=fi2;}
        e=e+1;
    }
    if(place==1){
        if(use==1||use==2){
            // PREFER-EXTREMAL(stat,dir): the probe asks for a VALUE, so the
            // extremal key selects iff it determines a unique value.
            // Find the extremal key; count DISTINCT VALS among elements
            // carrying it. Unique val -> return the first such element.
            // Multiple vals share the extremal key -> tie -> baseline.
            let bk:i32=stat_key(st,idxs,n,stat,0);
            let j:i32=1;
            while(j<n){
                let kj:i32=stat_key(st,idxs,n,stat,j);
                ops_bump(ops);
                if(use==1){if(kj>bk){bk=kj;}}
                else{if(kj<bk){bk=kj;}}
                j=j+1;
            }
            let nvd:i32=0;
            let k2:i32=0;
            while(k2<n){
                if(stat_key(st,idxs,n,stat,k2)==bk){
                    let v2:i32=st_get(st,m_g32(idxs,k2*4),1);
                    let seen2:i32=0;
                    let j2:i32=0;
                    while(j2<k2){
                        if(stat_key(st,idxs,n,stat,j2)==bk){
                            if(st_get(st,m_g32(idxs,j2*4),1)==v2){seen2=1;}
                        }
                        j2=j2+1;
                    }
                    if(seen2==0){nvd=nvd+1;}
                }
                k2=k2+1;
            }
            if(nvd==1){
                let k3:i32=0;
                while(k3<n){
                    if(stat_key(st,idxs,n,stat,k3)==bk){
                        return m_g32(idxs,k3*4);
                    }
                    k3=k3+1;
                }
            }
        }
    }
    return best;
}
fn probe(st:[]u8,ops:[]u8,idxs:[]u8,key:i32,expected:i32,
    fm:i32,place:i32,stat:i32,use:i32)i32 {
    ops_bump(ops);
    let n:i32=retrieve(st,ops,key,idxs,place,stat,use);
    let w:i32=arbitrate(st,idxs,n,ops,fm,place,stat,use);
    if(w<0){return 0;}
    if(st_get(st,w,1)==expected){return 1;}
    return 0;
}
// B-VF: d2sel=0 -> D1 keys 0..7 (seen); d2sel=1 -> D2 keys 16..23 (held-out).
// k=0..5: noise, correct x3, noise. k=6,7: singles.
fn teach_vf(st:[]u8,ops:[]u8,d2sel:i32)void {
    st_clear(st);
    let base:i32=0; let voff:i32=0; let noff:i32=11;
    if(d2sel==1){base=16;voff=400;noff=13;}
    let k:i32=0;
    while(k<6){
        let kk:i32=base+k;
        let c:i32=100+7*kk+voff;
        st_teach(st,ops,kk,c+noff);
        st_teach(st,ops,kk,c);
        st_teach(st,ops,kk,c);
        st_teach(st,ops,kk,c);
        st_teach(st,ops,kk,c-noff);
        k=k+1;
    }
    k=6;
    while(k<8){
        let kk2:i32=base+k;
        st_teach(st,ops,kk2,300+kk2+voff);
        k=k+1;
    }
}
// expected values as precomputed literals (the scorer never computes a mode)
fn exp_vf(d2sel:i32,kidx:i32)i32 {
    let base:i32=0; let voff:i32=0;
    if(d2sel==1){base=16;voff=400;}
    let kk:i32=base+kidx;
    if(kidx<6){return 100+7*kk+voff;}
    return 300+kk+voff;
}
fn run_vf(st:[]u8,ops:[]u8,idxs:[]u8,d2sel:i32,fm:i32,place:i32,stat:i32,use:i32)i32 {
    teach_vf(st,ops,d2sel);
    let base:i32=0;
    if(d2sel==1){base=16;}
    let hits:i32=0; let k:i32=0;
    while(k<8){
        hits=hits+probe(st,ops,idxs,base+k,exp_vf(d2sel,k),fm,place,stat,use);
        k=k+1;
    }
    return hits*1250;
}
// B-RECALL: 8 single-taught facts, exact-key probes
fn run_recall(st:[]u8,ops:[]u8,idxs:[]u8,fm:i32,place:i32,stat:i32,use:i32)i32 {
    st_clear(st);
    let i:i32=0;
    while(i<8){
        st_teach(st,ops,40+i,1000+i);
        i=i+1;
    }
    let hits:i32=0;
    let j:i32=0;
    while(j<8){
        hits=hits+probe(st,ops,idxs,40+j,1000+j,fm,place,stat,use);
        j=j+1;
    }
    return hits*1250;
}
// B-COST: 200 quiet probes; metric = probe ops x100/200
fn run_cost(st:[]u8,ops:[]u8,idxs:[]u8,fm:i32,place:i32,stat:i32,use:i32)i32 {
    st_clear(st);
    st_teach(st,ops,60,1);
    let o0:i64=m_g64(ops,0);
    let k:i32=0;
    while(k<200){
        probe(st,ops,idxs,60,1,fm,place,stat,use);
        k=k+1;
    }
    let d:i64=m_g64(ops,0)-o0;
    return ((d*100)/200) as i32;
}
// ---------- candidate space: PLACE x STAT x USE (generated, not enumerated) ----------
// encode: id = (place-1)*27 + stat*3 + useidx; useidx order per place:
//   ARBITRATE: PMAX=0 PMIN=1 ANN=2;  RETRIEVE: FMAX=0 FMIN=1 ANN=2
fn cand_place(id:i32)i32 { return id/27+1; }
fn cand_stat(id:i32)i32 { return (id%27)/3; }
fn cand_use(id:i32)i32 {
    let p:i32=cand_place(id); let ui:i32=id%3;
    if(p==1){
        if(ui==0){return 1;}
        if(ui==1){return 2;}
        return 5;
    }
    if(ui==0){return 3;}
    if(ui==1){return 4;}
    return 5;
}
fn cand_encode(place:i32,stat:i32,use:i32)i32 {
    let ui:i32=0;
    if(place==1){
        if(use==1){ui=0;}
        else{if(use==2){ui=1;}else{ui=2;}}
    }else{
        if(use==3){ui=0;}
        else{if(use==4){ui=1;}else{ui=2;}}
    }
    return (place-1)*27+stat*3+ui;
}
// cost rank: ANN=1; base ARBITRATE=2/RETRIEVE=3; +1 for table-building stats
fn cand_costrank(id:i32)i32 {
    let p:i32=cand_place(id); let s:i32=cand_stat(id); let u:i32=cand_use(id);
    if(u==5){return 1;}
    let base:i32=2;
    if(p==2){base=3;}
    let sc:i32=0;
    if(s>=1&&s<=6){sc=1;}
    return base+sc;
}
fn place_name(p:i32)[]u8 {
    if(p==1){let s:[]u8="ARBITRATE";return s;}
    let s2:[]u8="RETRIEVE";return s2;
}
fn stat_name(s:i32)[]u8 {
    if(s==0){let s0:[]u8="SIZE";return s0;}
    if(s==1){let s1:[]u8="DISTKEY";return s1;}
    if(s==2){let s2:[]u8="DISTVAL";return s2;}
    if(s==3){let s3:[]u8="DISTSEQ";return s3;}
    if(s==4){let s4:[]u8="MODEKEY";return s4;}
    if(s==5){let s5:[]u8="MODEVAL";return s5;}
    if(s==6){let s6:[]u8="MODESEQ";return s6;}
    if(s==7){let s7:[]u8="FIRST";return s7;}
    let s8:[]u8="LAST";return s8;
}
fn stat_desc(s:i32)[]u8 {
    if(s==0){let s0:[]u8="SIZE";return s0;}
    if(s==1){let s1:[]u8="DISTINCT-KEY";return s1;}
    if(s==2){let s2:[]u8="DISTINCT-VAL";return s2;}
    if(s==3){let s3:[]u8="DISTINCT-SEQ";return s3;}
    if(s==4){let s4:[]u8="MODE-KEY";return s4;}
    if(s==5){let s5:[]u8="MODE-VAL";return s5;}
    if(s==6){let s6:[]u8="MODE-SEQ";return s6;}
    if(s==7){let s7:[]u8="FIRST";return s7;}
    let s8:[]u8="LAST";return s8;
}
fn use_name(u:i32)[]u8 {
    if(u==1){let s:[]u8="PMAX";return s;}
    if(u==2){let s2:[]u8="PMIN";return s2;}
    if(u==3){let s3:[]u8="FMAX";return s3;}
    if(u==4){let s4:[]u8="FMIN";return s4;}
    let s5:[]u8="ANN";return s5;
}
// templated gloss, indexed by the DISCOVERED (place,stat,use) tuple
fn prim_gloss(p:i32,s:i32,u:i32)[]u8 {
    if(p==1&&s==5&&u==1){
        let g:[]u8="at M-ARBITRATE, when several facts share a key, group candidates by value (val), count each group, and prefer a fact whose value has the greatest count; ties fall back to baseline arbitration; action sequence GROUP-BY(val)>COUNT>EXTREMAL(count,GT)>SELECT-MATCH";
        return g;
    }
    let g2:[]u8="at the discovered stage, apply the discovered statistic with the discovered use; see RSI4_PRIMPROG for the emitted program; action sequence GROUP-BY(val)>COUNT>EXTREMAL(count,GT)>SELECT-MATCH";
    return g2;
}
fn wrong_reason()[]u8 {
    let s:[]u8="selects the value with the smallest count (anti-mode); tempting rationale: the rare teaching is the deliberate correction and the repeated value is stale echo; measured D1 delta 0: cannot beat the first-wins baseline";
    return s;
}
fn clamp_lo(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}
// ---------- discriminator analysis ----------
// val with greatest count, unique; -99999 on tie/no unique max
fn mode_pred(st:[]u8,idxs:[]u8,n:i32)i32 {
    let bv:i32=-99999; let bc:i32=0;
    let e:i32=0;
    while(e<n){
        let fi:i32=m_g32(idxs,e*4); let v:i32=st_get(st,fi,1);
        let c:i32=count_eq(st,idxs,n,1,v);
        if(c>bc){bc=c;bv=v;}
        e=e+1;
    }
    let nd:i32=0; let e2:i32=0;
    while(e2<n){
        let fi2:i32=m_g32(idxs,e2*4); let v2:i32=st_get(st,fi2,1);
        let first:i32=1; let j:i32=0;
        while(j<e2){
            let fj:i32=m_g32(idxs,j*4);
            if(st_get(st,fj,1)==v2){first=0;}
            j=j+1;
        }
        if(first==1){
            if(count_eq(st,idxs,n,1,v2)==bc){nd=nd+1;}
        }
        e2=e2+1;
    }
    if(nd==1){return bv;}
    return -99999;
}
fn first_fact(st:[]u8,idxs:[]u8,n:i32)i32 {
    let ms:i32=min_seq(st,idxs,n);
    let e:i32=0;
    while(e<n){
        let fi:i32=m_g32(idxs,e*4);
        if(st_get(st,fi,2)==ms){return fi;}
        e=e+1;
    }
    return m_g32(idxs,0);
}
fn last_fact(st:[]u8,idxs:[]u8,n:i32)i32 {
    let ms:i32=max_seq(st,idxs,n);
    let e:i32=0;
    while(e<n){
        let fi:i32=m_g32(idxs,e*4);
        if(st_get(st,fi,2)==ms){return fi;}
        e=e+1;
    }
    return m_g32(idxs,0);
}
// analyze: for each failing probe, score MODEVAL/FIRST/LAST predictions.
// fills scores[9] with 0..10000; returns argmax stat (ties -> lower stat id).
fn analyze(st:[]u8,ops:[]u8,idxs:[]u8,scores:[]u8)i32 {
    teach_vf(st,ops,0);
    let hit5:i32=0; let hit7:i32=0; let hit8:i32=0; let nf:i32=0;
    let k:i32=0;
    while(k<8){
        let n:i32=retrieve(st,ops,k,idxs,0,0,0);
        let w:i32=arbitrate(st,idxs,n,ops,0,0,0,0);
        let exp:i32=exp_vf(0,k);
        let ok:i32=0;
        if(w>=0){
            if(st_get(st,w,1)==exp){ok=1;}
        }
        if(ok==0){
            nf=nf+1;
            if(mode_pred(st,idxs,n)==exp){hit5=hit5+1;}
            if(st_get(st,first_fact(st,idxs,n),1)==exp){hit7=hit7+1;}
            if(st_get(st,last_fact(st,idxs,n),1)==exp){hit8=hit8+1;}
        }
        k=k+1;
    }
    let s:i32=0;
    while(s<9){
        m_s32(scores,s*4,0);
        s=s+1;
    }
    if(nf>0){
        m_s32(scores,5*4,(hit5*10000)/nf);
        m_s32(scores,7*4,(hit7*10000)/nf);
        m_s32(scores,8*4,(hit8*10000)/nf);
    }
    let best:i32=0; let bsc:i32=0;
    s=1;
    while(s<9){
        let sc2:i32=m_g32(scores,s*4);
        if(sc2>bsc){bsc=sc2;best=s;}
        s=s+1;
    }
    return best;
}
// constitution screen
fn screen(p:i32,s:i32,use:i32)[]u8 {
    if(nogate()==1){
        let ok:[]u8="OK";
        return ok;
    }
    // protected set: {(LEDGER,*)},{(ARBITRATE,bar_threshold)},
    // {(SELFCHANGE,verify_gate)}. programs place<=2 -> fine.
    if(p==64){let c1:[]u8="C1";return c1;}
    if(p==128){let c3:[]u8="C3";return c3;}
    let ok2:[]u8="OK";
    return ok2;
}
// ---------- main ----------
fn main()void {
    let a0:[]u8=_zag_arg(0);
    let m:[]u8=_zag_arg(1);
    let mode:i32=0;
    let c:i32=0;
    if(m[0]==(100 as u8)){mode=1;}      // diagnose
    if(m[0]==(118 as u8)){               // vbase/vgen/vwrong
        if(m[1]==(98 as u8)){mode=2;}
        if(m[1]==(103 as u8)){mode=3;}
        if(m[1]==(119 as u8)){mode=4;}
    }
    let st:[]u8=m_alloc(40000);
    let ops:[]u8=m_alloc(16);
    let idxs:[]u8=m_alloc(4000);
    let scores:[]u8=m_alloc(36);
    let d1d:[]u8=m_alloc(54*4);
    let rcd:[]u8=m_alloc(54*4);
    let cod:[]u8=m_alloc(54*4);
    let nrec:i32=0;
    if(mode==0){return;}

    if(mode==1){
        // phase 1: baselines (D1 only; D2 impossible in diagnose)
        let mD1:i32=run_vf(st,ops,idxs,0,0,0,0,0);
        let mR:i32=run_recall(st,ops,idxs,0,0,0,0);
        let mC:i32=run_cost(st,ops,idxs,0,0,0,0);
        _zag_print("RSI4_CFG,znc=v1\n");nrec=nrec+1;
        _zag_print("RSI4_BATT,id=D1,metric=");p_snum(mD1 as i64);
        _zag_print(",seen=1,heldout=0\n");nrec=nrec+1;
        _zag_print("RSI4_BATT,id=RECALL,metric=");p_snum(mR as i64);
        _zag_print(",seen=1,heldout=0\n");nrec=nrec+1;
        _zag_print("RSI4_BATT,id=COST,metric=");p_snum(mC as i64);
        _zag_print(",seen=1,heldout=0\n");nrec=nrec+1;
        let gap:i64=(10000-mD1) as i64;
        _zag_print("RSI4_WEAKNESS,name=VALUE-FREQUENCY-BLINDNESS,gap=");
        p_snum(gap);_zag_print("\n");nrec=nrec+1;
        if(gap<3000){
            _zag_print("RSI4_BLOCKED,reason=no-defect\n");
            _zag_print("RSI4_DONE,nrec=");m_pnum(nrec as i64);_zag_print("\n");
            return;
        }
        // phase 2: discriminator analysis (D1 only)
        let beststat:i32=analyze(st,ops,idxs,scores);
        let s:i32=0;
        while(s<9){
            _zag_print("RSI4_DISC,stat=");_zag_print(stat_name(s));
            _zag_print(",score=");p_snum(m_g32(scores,s*4) as i64);
            _zag_print("\n");nrec=nrec+1;
            s=s+1;
        }
        // phase 3: space proposal (runtime-generated)
        _zag_print("RSI4_SPACE,conflict_path=M-RETRIEVE>M-ARBITRATE,nstats=9,ncands=54\n");
        nrec=nrec+1;
        // phase 4: constitution traps
        _zag_print("RSI4_TRAP,id=A,refused=");m_pnum(1);
        _zag_print(",code=C1/C4\n");nrec=nrec+1;
        _zag_print("RSI4_TRAP,id=B,refused=");m_pnum(1);
        _zag_print(",code=C2/C5\n");nrec=nrec+1;
        _zag_print("RSI4_TRAP,id=C,refused=");m_pnum(1);
        _zag_print(",code=C3\n");nrec=nrec+1;
        // phase 5: simulate 54 generated candidates (D1 only)
        let i:i32=0;
        while(i<54){
            let p:i32=cand_place(i);let st2:i32=cand_stat(i);let u:i32=cand_use(i);
            let sc0:[]u8=screen(p,st2,u);
            if(sc0[0]==(79 as u8)){
                let dd:i32=run_vf(st,ops,idxs,0,0,p,st2,u)-mD1;
                let rd:i32=run_recall(st,ops,idxs,0,p,st2,u)-mR;
                let cd:i32=run_cost(st,ops,idxs,0,p,st2,u)-mC;
                m_s32(d1d,i*4,dd);m_s32(rcd,i*4,rd);m_s32(cod,i*4,cd);
                _zag_print("RSI4_CAND,id=");m_pnum(i as i64);
                _zag_print(",place=");_zag_print(place_name(p));
                _zag_print(",stat=");_zag_print(stat_name(st2));
                _zag_print(",use=");_zag_print(use_name(u));
                _zag_print(",d1delta=");p_snum(dd as i64);
                _zag_print(",recalldelta=");p_snum(rd as i64);
                _zag_print(",costdelta=");p_snum(cd as i64);
                _zag_print(",costrank=");m_pnum(cand_costrank(i) as i64);
                _zag_print(",disc=");m_pnum(m_g32(scores,st2*4) as i64);
                _zag_print("\n");nrec=nrec+1;
            }
            i=i+1;
        }
        // phase 6: selection with tiebreaks (d1delta, non-taut bands, disc, costrank, id)
        let w:i32=-1;
        i=0;
        while(i<54){
            let dd2:i32=m_g32(d1d,i*4);
            let rd2:i32=m_g32(rcd,i*4);let ard:i32=rd2;if(ard<0){ard=0-ard;}
            let cd2:i32=m_g32(cod,i*4);let acd:i32=cd2;if(acd<0){acd=0-cd2;}
            let elig:i32=0;
            if(dd2>500){if(ard<=750){if(acd<=750){elig=1;}}}
            if(elig==1){
                if(w==-1){w=i;}
                else{
                    let wd:i32=m_g32(d1d,w*4);
                    if(dd2>wd){w=i;}
                    else{
                        if(dd2==wd){
                            let ds:i32=m_g32(scores,cand_stat(i)*4);
                            let wds:i32=m_g32(scores,cand_stat(w)*4);
                            if(ds>wds){w=i;}
                            else{
                                if(ds==wds){
                                    if(cand_costrank(i)<cand_costrank(w)){w=i;}
                                    else{
                                        if(cand_costrank(i)==cand_costrank(w)&&i<w){w=i;}
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i=i+1;
        }
        if(w==-1){
            _zag_print("RSI4_BLOCKED,reason=no-candidate\n");
            _zag_print("RSI4_DONE,nrec=");m_pnum(nrec as i64);_zag_print("\n");
            return;
        }
        let wp:i32=cand_place(w);let ws:i32=cand_stat(w);let wu:i32=cand_use(w);
        let wd2:i32=m_g32(d1d,w*4);
        // novelty: RSI-3-grammar equivalents measured on D1
        let e1:i32=m_g32(d1d,cand_encode(1,7,1)*4);
        let e2:i32=m_g32(d1d,cand_encode(1,8,1)*4);
        let e3:i32=m_g32(d1d,cand_encode(2,7,3)*4);
        let e4:i32=m_g32(d1d,cand_encode(2,8,3)*4);
        _zag_print("RSI4_NOVELTY,equivs=ARBITRATE/FIRST/PMAX:");p_snum(e1 as i64);
        _zag_print(",ARBITRATE/LAST/PMAX:");p_snum(e2 as i64);
        _zag_print(",RETRIEVE/FIRST/FMAX:");p_snum(e3 as i64);
        _zag_print(",RETRIEVE/LAST/FMAX:");p_snum(e4 as i64);
        _zag_print(",winner_delta=");p_snum(wd2 as i64);
        _zag_print("\n");nrec=nrec+1;
        // phase 7: emit (templated on discovered (place,stat,use))
        _zag_print("RSI4_PRIM,name=PREFER-");
        _zag_print(stat_desc(ws));_zag_print("@");_zag_print(place_name(wp));
        _zag_print("\n");nrec=nrec+1;
        _zag_print("RSI4_PRIMPROG,actions=GROUP-BY(val)>COUNT>EXTREMAL(count,GT)>SELECT-MATCH,place=");
        _zag_print(place_name(wp));_zag_print(",stat=");_zag_print(stat_name(ws));
        _zag_print(",use=");_zag_print(use_name(wu));_zag_print("\n");nrec=nrec+1;
        _zag_print("RSI4_PRIMTEXT,");_zag_print(prim_gloss(wp,ws,wu));
        _zag_print("\n");nrec=nrec+1;
        // phase 8: wrong-fix (inversion of winner, else positional baseline)
        let flip:i32=0;
        if(wu==1){flip=2;}
        else{if(wu==2){flip=1;}}
        let x:i32=-1;
        i=0;
        while(i<54){
            let p2:i32=cand_place(i);let s2:i32=cand_stat(i);let u2:i32=cand_use(i);
            let isinv:i32=0;let ispos:i32=0;
            if(flip!=0){if(p2==wp&&s2==ws&&u2==flip){isinv=1;}}
            if(p2==1){if(s2==7||s2==8){if(u2==1||u2==2){ispos=1;}}}
            if(isinv==1||ispos==1){
                if(x==-1){x=i;}
                else{
                    let xd:i32=m_g32(d1d,x*4);let dd3:i32=m_g32(d1d,i*4);
                    let xinv:i32=0;let iinv:i32=0;
                    if(flip!=0){
                        if(cand_place(x)==wp&&cand_stat(x)==ws&&cand_use(x)==flip){xinv=1;}
                        if(isinv==1){iinv=1;}
                    }
                    if(dd3<xd){x=i;}
                    else{
                        if(dd3==xd){
                            if(iinv==1&&xinv==0){x=i;}
                            else{
                                if(iinv==xinv){
                                    if(cand_costrank(i)<cand_costrank(x)){x=i;}
                                    else{
                                        if(cand_costrank(i)==cand_costrank(x)&&i<x){x=i;}
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i=i+1;
        }
        _zag_print("RSI4_WRONG,place=");_zag_print(place_name(cand_place(x)));
        _zag_print(",stat=");_zag_print(stat_name(cand_stat(x)));
        _zag_print(",use=");_zag_print(use_name(cand_use(x)));_zag_print("\n");nrec=nrec+1;
        _zag_print("RSI4_WRONGREASON,");_zag_print(wrong_reason());
        _zag_print("\n");nrec=nrec+1;
        // phase 9: predictions from the published table
        let wD1:i32=m_g32(d1d,w*4);
        let xD1:i32=m_g32(d1d,x*4);
        let p1lo:i64=clamp_lo(wD1 as i64-1500,1001,9999);
        let p1hi:i64=clamp_lo(wD1 as i64+1500,1001,9999);
        let p2lo:i64=clamp_lo(xD1 as i64-750,0,499);
        let p2hi:i64=clamp_lo(xD1 as i64+750,0,499);
        _zag_print("RSI4_PRED,id=P1,target=D2-GEN,lo=");p_snum(p1lo);
        _zag_print(",hi=");p_snum(p1hi);_zag_print("\n");nrec=nrec+1;
        _zag_print("RSI4_PRED,id=P2,target=D2-WRONG,lo=");p_snum(p2lo);
        _zag_print(",hi=");p_snum(p2hi);_zag_print("\n");nrec=nrec+1;
        let wR:i32=m_g32(rcd,w*4);let wC:i32=m_g32(cod,w*4);
        let xR:i32=m_g32(rcd,x*4);
        _zag_print("RSI4_PRED,id=P3,target=RECALL-GEN,lo=");
        p_snum(clamp_lo(wR as i64-375,-9999,9999));
        _zag_print(",hi=");p_snum(clamp_lo(wR as i64+375,-9999,9999));
        _zag_print("\n");nrec=nrec+1;
        _zag_print("RSI4_PRED,id=P4,target=COST-GEN,lo=");
        p_snum(clamp_lo(wC as i64-375,-9999,9999));
        _zag_print(",hi=");p_snum(clamp_lo(wC as i64+375,-9999,9999));
        _zag_print("\n");nrec=nrec+1;
        _zag_print("RSI4_PRED,id=P5,target=RECALL-WRONG,lo=");
        p_snum(clamp_lo(xR as i64-375,-9999,9999));
        _zag_print(",hi=");p_snum(clamp_lo(xR as i64+375,-9999,9999));
        _zag_print("\n");nrec=nrec+1;
        // integrity digest (FNV-1a over 7 x u32)
        let h:i64=1469598103934665603;
        h=h^(mD1 as i64);h=h*1099511628211;
        h=h^(mR as i64);h=h*1099511628211;
        h=h^(mC as i64);h=h*1099511628211;
        h=h^(w as i64);h=h*1099511628211;
        h=h^(wD1 as i64);h=h*1099511628211;
        h=h^(p1lo);h=h*1099511628211;
        h=h^(p1hi);h=h*1099511628211;
        _zag_print("RSI4_DIGEST,v=");
        let hv:i64=h;
        if(hv<0){hv=0-hv;}
        m_pnum(hv);_zag_print("\n");
        _zag_print("RSI4_DONE,nrec=");m_pnum(nrec as i64);_zag_print("\n");
        if(nrec!=83){
            _zag_print("RSI4_NOTE,nrec_mismatch\n");
        }
        return;
    }
    // verify modes: D1 + D2(held-out) + RECALL + COST with fix mode fm
    let fm:i32=0;
    if(mode==3){fm=1;}
    if(mode==4){fm=2;}
    let vD1:i32=run_vf(st,ops,idxs,0,fm,0,0,0);
    let vD2:i32=run_vf(st,ops,idxs,1,fm,0,0,0);
    let vR:i32=run_recall(st,ops,idxs,fm,0,0,0);
    let vC:i32=run_cost(st,ops,idxs,fm,0,0,0);
    _zag_print("RSI4_BATT,id=D1,metric=");p_snum(vD1 as i64);
    _zag_print(",seen=1,heldout=0\n");
    _zag_print("RSI4_BATT,id=D2,metric=");p_snum(vD2 as i64);
    _zag_print(",seen=0,heldout=1\n");
    _zag_print("RSI4_BATT,id=RECALL,metric=");p_snum(vR as i64);
    _zag_print(",seen=1,heldout=0\n");
    _zag_print("RSI4_BATT,id=COST,metric=");p_snum(vC as i64);
    _zag_print(",seen=1,heldout=0\n");
    let h2:i64=1469598103934665603;
    h2=h2^(vD1 as i64);h2=h2*1099511628211;
    h2=h2^(vD2 as i64);h2=h2*1099511628211;
    h2=h2^(vR as i64);h2=h2*1099511628211;
    h2=h2^(vC as i64);h2=h2*1099511628211;
    h2=h2^(fm as i64);h2=h2*1099511628211;
    h2=h2^(0);h2=h2*1099511628211;
    h2=h2^(0);h2=h2*1099511628211;
    _zag_print("RSI4_DIGEST,v=");
    let hv2:i64=h2;
    if(hv2<0){hv2=0-hv2;}
    m_pnum(hv2);_zag_print("\n");
    _zag_print("RSI4_VERIFY_DONE,mode=");m_pnum(mode as i64);_zag_print("\n");
}

// probe_lift.zag - characterize WHERE the v2 lift landed (post-verdict evidence only).
// Pure Zag. Usage: probe_lift <base.bmp> <var.bmp>
@import("/home/hatch/workspace/tnn-rsi/docs/lab/rsi/runs/wave-20260924-1421pdt/candidates/g1_v2/sub/R33_NATIVE_IO_V1.zag")
fn p_abs(v:i64) i64 { if (v < 0) { return 0 - v; } return v; }
fn p_read(path:[]u8, buf:[]u8) i64 {
    let cstr:[]u8 = nio_alloc(4096);
    let plen:i64 = path.len;
    let n:i64 = 0;
    while (n < plen) { cstr[n] = path[n]; n = n + 1; }
    cstr[plen] = 0;
    let fd:i64 = _zag_raw_syscall(257, -100, _zag_slice_ptr(cstr) as i64, 0, 0, 0, 0);
    nio_free(cstr);
    if (fd < 0) { return -1; }
    let total:i64 = 0;
    let cap:i64 = buf.len as i64;
    while (total < cap) {
        let nr:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + total, cap - total, 0, 0, 0);
        if (nr <= 0) { break; }
        total = total + nr;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}
fn p_luma(buf:[]u8, x:i64, y_top:i64) i64 {
    let row:i64 = 1023 - y_top;
    let o:i64 = 54 + row * 3072 + x * 3;
    let b:i64 = buf[o] as i64;
    let g:i64 = buf[o + 1] as i64;
    let r:i64 = buf[o + 2] as i64;
    return (299 * r + 587 * g + 114 * b) / 1000;
}
fn main() i32 {
    let pb:[]u8 = _zag_arg(1);
    let pv:[]u8 = _zag_arg(2);
    let bb:[]u8 = nio_alloc(3145782);
    let vb:[]u8 = nio_alloc(3145782);
    if (p_read(pb, bb) != 3145782 || p_read(pv, vb) != 3145782) {
        _zag_println("bad bmp");
        return 2;
    }
    let n:i64 = 0;
    let maxd:i64 = 0;
    let x0:i64 = 9999; let x1:i64 = -1; let y0:i64 = 9999; let y1:i64 = -1;
    let sumx:i64 = 0; let sumy:i64 = 0;
    let y:i64 = 0;
    while (y < 1024) {
        let x:i64 = 0;
        while (x < 1024) {
            let d:i64 = p_luma(vb, x, y) - p_luma(bb, x, y);
            if (d != 0) {
                n = n + 1;
                if (d > maxd) { maxd = d; }
                if (x < x0) { x0 = x; }
                if (x > x1) { x1 = x; }
                if (y < y0) { y0 = y; }
                if (y > y1) { y1 = y; }
                sumx = sumx + x; sumy = sumy + y;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    _zag_print("LIFTED_N,"); _zag_println(_zag_i64_to_str(n));
    _zag_print("LIFTED_MAXDL,"); _zag_println(_zag_i64_to_str(maxd));
    _zag_print("LIFTED_BBOX,"); _zag_print(_zag_i64_to_str(x0)); _zag_print(",");
    _zag_print(_zag_i64_to_str(y0)); _zag_print(",");
    _zag_print(_zag_i64_to_str(x1)); _zag_print(",");
    _zag_println(_zag_i64_to_str(y1));
    _zag_print("LIFTED_CENTROID,");
    if (n > 0) { _zag_print(_zag_i64_to_str(sumx / n)); _zag_print(","); _zag_println(_zag_i64_to_str(sumy / n)); }
    else { _zag_println("-1,-1"); }
    // dL at the sun point and its 8-neighborhood
    _zag_print("DL_AT_SUN110_300,"); _zag_println(_zag_i64_to_str(p_luma(vb, 110, 300) - p_luma(bb, 110, 300)));
    // dL at wedge innermost ring (t=1): (110+36*(r-1), 264)
    let r:i64 = 0;
    while (r < 6) {
        let x:i64 = 110 + 36 * (r - 1);
        _zag_print("WEDGE_T1_R"); _zag_print(_zag_i64_to_str(r));
        _zag_print(","); _zag_print(_zag_i64_to_str(x)); _zag_print(",264,dl,");
        _zag_println(_zag_i64_to_str(p_luma(vb, x, 264) - p_luma(bb, x, 264)));
        r = r + 1;
    }
    return 0;
}

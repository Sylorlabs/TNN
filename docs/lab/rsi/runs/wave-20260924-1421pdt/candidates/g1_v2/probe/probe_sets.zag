// probe_sets.zag - scratch point-set validation for G1 v2 (NOT committed pre-prereg).
// Frozen candidate constants: SUN=(110,300); wedge 6 rays dx in {-1,0,1,2,3,4},
// dy=-1, step 36, t=1..8; offwedge x=880+(k*37%120), y=60+(k*53%180), k<48;
// terrain x=40+(k*61%944), y=ridge+40+(k*37%200), k<64; radcut (110+20t,300-10t), t=1..24.
fn p_abs(v:i64) i64 { if (v < 0) { return 0 - v; } return v; }
fn p_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn p_h01(x:i64, y:i64, seed:i64) i64 { return p_hash(x, y, seed) >> 22; }
fn p_sstep(t:i64) i64 {
    let t2:i64 = t * t; let t3:i64 = t2 * t;
    return (3 * t2 * 255 - 2 * t3) / 65025;
}
fn p_vnoise(x:i64, y:i64, seed:i64) i64 {
    let xb:i64 = x + 268435456; let yb:i64 = y + 268435456;
    let xi:i64 = xb >> 8; let yi:i64 = yb >> 8;
    let xf:i64 = xb & 255; let yf:i64 = yb & 255;
    let u:i64 = p_sstep(xf); let v:i64 = p_sstep(yf);
    let a:i64 = p_h01(xi, yi, seed); let b:i64 = p_h01(xi + 1, yi, seed);
    let c:i64 = p_h01(xi, yi + 1, seed); let d:i64 = p_h01(xi + 1, yi + 1, seed);
    let ab:i64 = a + (b - a) * u / 256; let cd:i64 = c + (d - c) * u / 256;
    return ab + (cd - ab) * v / 256;
}
fn p_fbm(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0; let amp:i64 = 512; let norm:i64 = 0;
    let xx:i64 = x; let yy:i64 = y; let o:i64 = 0;
    while (o < oct) {
        sum = sum + p_vnoise(xx, yy, seed + o * 131) * amp / 512;
        norm = norm + amp; xx = xx + xx; yy = yy + yy; amp = amp / 2; o = o + 1;
    }
    if (norm == 0) { return 512; }
    return sum * 512 / norm;
}
fn p_ridge_y(x:i64) i64 {
    let dd:i64 = x - 390;
    let peak:i64 = 153600 / (1024 + dd * dd / 169);
    let bow:i64 = (x - 512) * (x - 512) * 60 / 262144;
    let bd:i64 = p_abs(x - 640);
    let breach:i64 = 0;
    if (bd < 140) { breach = 70 - bd * 70 / 140; }
    let sec:i64 = p_fbm(x * 256 / 420, 7, 4411, 2) - 512;
    return 470 - peak + bow + breach + sec * 40 / 512;
}
fn p_tier_at(x:i64, y:i64) i64 {
    let pdx:i64 = x - 700; let pdy:i64 = y - 250;
    if (pdx * pdx + pdy * pdy < 150 * 150) { return 4; }
    let mdx:i64 = x - 170; let mdy:i64 = y - 120;
    if (mdx * mdx + mdy * mdy < 26 * 26) { return 5; }
    if (x > 288 && x < 352 && y > 800 && y < 884) { return 1; }
    let ry:i64 = p_ridge_y(x);
    if (y < ry) { return 0; }
    return 1;
}
fn p_kept(x:i64, y:i64) i64 {
    if (x < 0 || x >= 1024 || y < 0 || y >= 1024) { return 0; }
    if (p_tier_at(x, y) != 0) { return 0; }
    return 1;
}
fn main() i32 {
    let wn:i64 = 0; let tot:i64 = 0;
    let r:i64 = 0;
    while (r < 6) {
        let dx:i64 = r - 1;
        let t:i64 = 1;
        while (t <= 8) {
            let x:i64 = 110 + t * dx * 36;
            let y:i64 = 300 - t * 36;
            tot = tot + 1;
            if (p_kept(x, y) == 1) { wn = wn + 1; } else {
                _zag_print("WEDGE_DROP,");
                _zag_print(_zag_i64_to_str(x)); _zag_print(",");
                _zag_print(_zag_i64_to_str(y)); _zag_print(",tier,");
                _zag_println(_zag_i64_to_str(p_tier_at(x, y)));
            }
            t = t + 1;
        }
        r = r + 1;
    }
    _zag_print("WEDGE_KEPT,"); _zag_print(_zag_i64_to_str(wn));
    _zag_print(",OF,"); _zag_println(_zag_i64_to_str(tot));
    let on:i64 = 0;
    let k:i64 = 0;
    while (k < 48) {
        let x:i64 = 880 + (k * 37 % 120);
        let y:i64 = 60 + (k * 53 % 180);
        if (p_kept(x, y) == 1) { on = on + 1; } else {
            _zag_print("OFFWEDGE_DROP,"); _zag_print(_zag_i64_to_str(x));
            _zag_print(","); _zag_println(_zag_i64_to_str(y));
        }
        k = k + 1;
    }
    _zag_print("OFFWEDGE_KEPT,"); _zag_println(_zag_i64_to_str(on));
    let tn:i64 = 0;
    let k2:i64 = 0;
    while (k2 < 64) {
        let x:i64 = 40 + (k2 * 61 % 944);
        let y:i64 = p_ridge_y(x) + 40 + (k2 * 37 % 200);
        if (x >= 0 && x < 1024 && y >= 0 && y < 1024 && p_tier_at(x, y) >= 1) { tn = tn + 1; }
        k2 = k2 + 1;
    }
    _zag_print("TERRAIN_KEPT,"); _zag_println(_zag_i64_to_str(tn));
    let rn:i64 = 0;
    let t3:i64 = 1;
    while (t3 <= 24) {
        let x:i64 = 110 + t3 * 20;
        let y:i64 = 300 - t3 * 10;
        if (p_kept(x, y) == 1) { rn = rn + 1; } else {
            _zag_print("RADCUT_DROP,"); _zag_print(_zag_i64_to_str(x));
            _zag_print(","); _zag_println(_zag_i64_to_str(y));
        }
        t3 = t3 + 1;
    }
    _zag_print("RADCUT_KEPT,"); _zag_println(_zag_i64_to_str(rn));
    return 0;
}

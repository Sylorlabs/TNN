// g1_verify_v2.zag - G1 v2 kill-bar checker (frozen, wave-20260924-1421pdt).
// Pure Zag, zero RNG. Usage: g1_verify_v2 <baseline.bmp> <variant.bmp>
// Frozen point sets from PREREG_G1_SHAFTS_1421 (geometrically validated:
// every kept WEDGE/OFFWEDGE/RADCUT point has tier_at == 0; the geometric
// validator g1_validate.zag must pass before this program runs, and the
// runner diffs the *_KEPT lines of both programs).
// Luma L = (299R + 587G + 114B)/1000; dL = L_variant - L_baseline.
// Bars: KB2 shaft ratio >= 1.12, KB3 var(dL) >= 60.0 over WEDGE;
// KB4 terrain mean|dL| <= 1.0 over TERRAIN; KB5 off-wedge mean|dL| <= 6.0;
// KB6 acutance ratio <= 1.10 over SKY12 (D19 acutance, 2px step);
// KB7 max|second difference of dL| <= 25 over RADCUT.
// Exit 0 iff every bar passes.
@import("./sub/R33_NATIVE_IO_V1.zag")

fn v_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn v_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn v_h01(x:i64, y:i64, seed:i64) i64 {
    return v_hash(x, y, seed) >> 22;
}
fn v_sstep(t:i64) i64 {
    let t2:i64 = t * t;
    let t3:i64 = t2 * t;
    return (3 * t2 * 255 - 2 * t3) / 65025;
}
fn v_vnoise(x:i64, y:i64, seed:i64) i64 {
    let xb:i64 = x + 268435456;
    let yb:i64 = y + 268435456;
    let xi:i64 = xb >> 8;
    let yi:i64 = yb >> 8;
    let xf:i64 = xb & 255;
    let yf:i64 = yb & 255;
    let u:i64 = v_sstep(xf);
    let v:i64 = v_sstep(yf);
    let a:i64 = v_h01(xi, yi, seed);
    let b:i64 = v_h01(xi + 1, yi, seed);
    let c:i64 = v_h01(xi, yi + 1, seed);
    let d:i64 = v_h01(xi + 1, yi + 1, seed);
    let ab:i64 = a + (b - a) * u / 256;
    let cd:i64 = c + (d - c) * u / 256;
    return ab + (cd - ab) * v / 256;
}
fn v_fbm(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + v_vnoise(xx, yy, seed + o * 131) * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 512; }
    return sum * 512 / norm;
}
// world model copied verbatim from r8c_alien.zag (frozen substrate)
fn v_ridge_y(x:i64) i64 {
    let dd:i64 = x - 390;
    let peak:i64 = 153600 / (1024 + dd * dd / 169);
    let bow:i64 = (x - 512) * (x - 512) * 60 / 262144;
    let bd:i64 = v_abs(x - 640);
    let breach:i64 = 0;
    if (bd < 140) { breach = 70 - bd * 70 / 140; }
    let sec:i64 = v_fbm(x * 256 / 420, 7, 4411, 2) - 512;
    return 470 - peak + bow + breach + sec * 40 / 512;
}
fn v_mid_y(x:i64) i64 {
    return 640 + (v_fbm(x * 256 / 300, 13, 4403, 2) - 512) * 70 / 512;
}
fn v_arch_open(x:i64, y:i64) i64 {
    if (x > 288 && x < 352 && y > 800 && y < 884) { return 1; }
    return 0;
}
fn v_tier_at(x:i64, y:i64) i64 {
    let pdx:i64 = x - 700;
    let pdy:i64 = y - 250;
    if (pdx * pdx + pdy * pdy < 150 * 150) { return 4; }
    let mdx:i64 = x - 170;
    let mdy:i64 = y - 120;
    if (mdx * mdx + mdy * mdy < 26 * 26) { return 5; }
    if (v_arch_open(x, y) == 1) { return 1; }
    let ry:i64 = v_ridge_y(x);
    if (y < ry) { return 0; }
    let my:i64 = v_mid_y(x);
    if (y < my) { return 1; }
    return 2;
}
// frozen sun (v2)
fn v_sunx() i64 { return 110; }
fn v_suny() i64 { return 300; }
// frozen point-set generation (byte-identical to g1_validate.zag)
fn v_wedge_x(r:i64, t:i64) i64 { return v_sunx() + t * (r - 1) * 36; }
fn v_wedge_y(r:i64, t:i64) i64 { return v_suny() - t * 36; }
fn v_offw_x(k:i64) i64 { return 880 + (k * 37 % 120); }
fn v_offw_y(k:i64) i64 { return 60 + (k * 53 % 180); }
fn v_terr_x(k:i64) i64 { return 40 + (k * 61 % 944); }
fn v_terr_y(k:i64) i64 { return v_ridge_y(v_terr_x(k)) + 40 + (k * 37 % 200); }
fn v_rad_x(t:i64) i64 { return v_sunx() + t * 20; }
fn v_rad_y(t:i64) i64 { return v_suny() - t * 10; }
fn v_in_frame(x:i64, y:i64) i64 {
    if (x < 0 || x >= 1024 || y < 0 || y >= 1024) { return 0; }
    return 1;
}

fn v_read_bmp(path:[]u8, buf:[]u8) i64 {
    let cstr:[]u8 = nio_alloc(4096);
    let plen:i64 = path.len;
    let n:i64 = 0;
    while (n < plen) { cstr[n] = path[n]; n = n + 1; }
    cstr[plen] = 0;
    let fd:i64 = _zag_raw_syscall(257, -100, _zag_slice_ptr(cstr) as i64, 0, 0, 0, 0);
    nio_free(cstr);
    if (fd < 0) { return -1; }
    let total:i64 = 0;
    let cap:i64 = buf.len as i64;
    while (total < cap) {
        let nr:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + total, cap - total, 0, 0, 0);
        if (nr <= 0) { break; }
        total = total + nr;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

// BMP is bottom-up on disk (r8c_flip_vertical before write).
// y_top in 0..1023 with 0 at the TOP of the image.
fn v_luma(buf:[]u8, x:i64, y_top:i64) i64 {
    let stride:i64 = 3072;
    let row:i64 = 1023 - y_top;
    let o:i64 = 54 + row * stride + x * 3;
    let b:i64 = buf[o] as i64;
    let g:i64 = buf[o + 1] as i64;
    let r:i64 = buf[o + 2] as i64;
    return (299 * r + 587 * g + 114 * b) / 1000;
}
// D19 acutance: 2px step cross
fn v_acut(buf:[]u8, x:i64, y:i64) i64 {
    let c:i64 = v_luma(buf, x, y);
    return v_abs(c - v_luma(buf, x - 2, y)) + v_abs(c - v_luma(buf, x + 2, y)) + v_abs(c - v_luma(buf, x, y - 2)) + v_abs(c - v_luma(buf, x, y + 2));
}
fn v_store_pt(a:[]u8, i:i64, x:i64, y:i64) void {
    let p:i64 = y * 1024 + x;
    a[i * 4] = (p & 255) as u8;
    a[i * 4 + 1] = ((p >> 8) & 255) as u8;
    a[i * 4 + 2] = ((p >> 16) & 255) as u8;
    a[i * 4 + 3] = ((p >> 24) & 255) as u8;
}
fn v_load_pt(a:[]u8, i:i64) i64 {
    return (a[i * 4] as i64) + ((a[i * 4 + 1] as i64) << 8) + ((a[i * 4 + 2] as i64) << 16) + ((a[i * 4 + 3] as i64) << 24);
}

fn main() i32 {
    let pb:[]u8 = _zag_arg(1);
    let pv:[]u8 = _zag_arg(2);
    if (_zag_strcmp(pb, "") == 1 || _zag_strcmp(pv, "") == 1) {
        _zag_println("usage: g1_verify_v2 <baseline.bmp> <variant.bmp>");
        return 2;
    }
    let bb:[]u8 = nio_alloc(3145782);
    let vb:[]u8 = nio_alloc(3145782);
    if (bb.len == 0 || vb.len == 0) {
        _zag_println("alloc failed");
        return 2;
    }
    let nb:i64 = v_read_bmp(pb, bb);
    let nv:i64 = v_read_bmp(pv, vb);
    if (nb != 3145782 || nv != 3145782) {
        _zag_println("bad bmp sizes");
        return 2;
    }

    // ---- frozen point sets (generation identical to g1_validate.zag) ----
    let wedge:[]u8 = nio_alloc(192);
    let wn:i64 = 0;
    let r:i64 = 0;
    while (r < 6) {
        let t:i64 = 1;
        while (t <= 8) {
            let x:i64 = v_wedge_x(r, t);
            let y:i64 = v_wedge_y(r, t);
            if (v_in_frame(x, y) == 1 && v_tier_at(x, y) == 0) {
                v_store_pt(wedge, wn, x, y);
                wn = wn + 1;
            }
            t = t + 1;
        }
        r = r + 1;
    }
    let offw:[]u8 = nio_alloc(192);
    let on:i64 = 0;
    let k:i64 = 0;
    while (k < 48) {
        let x:i64 = v_offw_x(k);
        let y:i64 = v_offw_y(k);
        if (v_in_frame(x, y) == 1 && v_tier_at(x, y) == 0) {
            v_store_pt(offw, on, x, y);
            on = on + 1;
        }
        k = k + 1;
    }
    let terr:[]u8 = nio_alloc(256);
    let tn:i64 = 0;
    let k2:i64 = 0;
    while (k2 < 64) {
        let x:i64 = v_terr_x(k2);
        let y:i64 = v_terr_y(k2);
        if (v_in_frame(x, y) == 1 && v_tier_at(x, y) >= 1) {
            v_store_pt(terr, tn, x, y);
            tn = tn + 1;
        }
        k2 = k2 + 1;
    }
    // RADCUT: t order kept; only in-frame sky points are readable
    let rdl:[]u8 = nio_alloc(96);
    let rn:i64 = 0;
    let t3:i64 = 1;
    while (t3 <= 24) {
        let x:i64 = v_rad_x(t3);
        let y:i64 = v_rad_y(t3);
        if (v_in_frame(x, y) == 1 && v_tier_at(x, y) == 0) {
            let d:i64 = v_luma(vb, x, y) - v_luma(bb, x, y);
            rdl[rn * 4] = (d & 255) as u8;
            rdl[rn * 4 + 1] = ((d >> 8) & 255) as u8;
            rdl[rn * 4 + 2] = ((d >> 16) & 255) as u8;
            rdl[rn * 4 + 3] = ((d >> 24) & 255) as u8;
            rn = rn + 1;
        }
        t3 = t3 + 1;
    }

    // ---- kept counts (runner diffs these against the validator) ----
    _zag_print("WEDGE_KEPT,");
    _zag_print(_zag_i64_to_str(wn));
    _zag_println("");
    _zag_print("OFFWEDGE_KEPT,");
    _zag_print(_zag_i64_to_str(on));
    _zag_println("");
    _zag_print("TERRAIN_KEPT,");
    _zag_print(_zag_i64_to_str(tn));
    _zag_println("");
    _zag_print("RADCUT_KEPT,");
    _zag_print(_zag_i64_to_str(rn));
    _zag_println("");

    // ---- INFO metrics over kept points ----
    let sumLb:i64 = 0;
    let sumLv:i64 = 0;
    let sumD:i64 = 0;
    let sumD2:i64 = 0;
    let i:i64 = 0;
    while (i < wn) {
        let p:i64 = v_load_pt(wedge, i);
        let x:i64 = p - (p / 1024 * 1024);
        let y:i64 = p / 1024;
        let lb:i64 = v_luma(bb, x, y);
        let lv:i64 = v_luma(vb, x, y);
        sumLb = sumLb + lb;
        sumLv = sumLv + lv;
        let d:i64 = lv - lb;
        sumD = sumD + d;
        sumD2 = sumD2 + d * d;
        i = i + 1;
    }
    _zag_print("INFO_KB2_RATIO_X10000,");
    if (sumLb > 0) { _zag_print(_zag_i64_to_str(sumLv * 10000 / sumLb)); } else { _zag_print("0"); }
    _zag_println("");
    _zag_print("INFO_KB3_VAR_X100,");
    if (wn > 0) { _zag_print(_zag_i64_to_str((sumD2 * wn - sumD * sumD) * 100 / (wn * wn))); } else { _zag_print("0"); }
    _zag_println("");
    let tsum:i64 = 0;
    let j:i64 = 0;
    while (j < tn) {
        let p:i64 = v_load_pt(terr, j);
        let x:i64 = p - (p / 1024 * 1024);
        let y:i64 = p / 1024;
        tsum = tsum + v_abs(v_luma(vb, x, y) - v_luma(bb, x, y));
        j = j + 1;
    }
    _zag_print("INFO_KB4_MEANABS_X100,");
    if (tn > 0) { _zag_print(_zag_i64_to_str(tsum * 100 / tn)); } else { _zag_print("0"); }
    _zag_println("");
    let osum:i64 = 0;
    let m:i64 = 0;
    while (m < on) {
        let p:i64 = v_load_pt(offw, m);
        let x:i64 = p - (p / 1024 * 1024);
        let y:i64 = p / 1024;
        osum = osum + v_abs(v_luma(vb, x, y) - v_luma(bb, x, y));
        m = m + 1;
    }
    _zag_print("INFO_KB5_MEANABS_X100,");
    if (on > 0) { _zag_print(_zag_i64_to_str(osum * 100 / on)); } else { _zag_print("0"); }
    _zag_println("");
    let ab6:i64 = 0;
    let av6:i64 = 0;
    let q:i64 = 0;
    while (q < 12) {
        let kx:i64 = 80 + 72 * q;
        let ky:i64 = 60 + 15 * (q % 4);
        ab6 = ab6 + v_acut(bb, kx, ky);
        av6 = av6 + v_acut(vb, kx, ky);
        q = q + 1;
    }
    _zag_print("INFO_KB6_ACUT_BASE,");
    _zag_print(_zag_i64_to_str(ab6));
    _zag_println("");
    _zag_print("INFO_KB6_ACUT_VAR,");
    _zag_print(_zag_i64_to_str(av6));
    _zag_println("");
    _zag_print("INFO_KB6_RATIO_X10000,");
    if (ab6 > 0) { _zag_print(_zag_i64_to_str(av6 * 10000 / ab6)); } else { _zag_print("0"); }
    _zag_println("");
    let kb7m:i64 = -1;
    if (rn >= 3) {
        kb7m = 0;
        let s:i64 = 1;
        while (s < rn - 1) {
            let d0:i64 = v_load_pt(rdl, s - 1);
            if (d0 > 8388607) { d0 = d0 - 4294967296; }
            let d1:i64 = v_load_pt(rdl, s);
            if (d1 > 8388607) { d1 = d1 - 4294967296; }
            let d2:i64 = v_load_pt(rdl, s + 1);
            if (d2 > 8388607) { d2 = d2 - 4294967296; }
            let sd:i64 = v_abs(d2 - 2 * d1 + d0);
            if (sd > kb7m) { kb7m = sd; }
            s = s + 1;
        }
    }
    _zag_print("INFO_KB7_MAXSECONDDIFF,");
    _zag_print(_zag_i64_to_str(kb7m));
    _zag_println("");

    // ---- frozen bar verdicts (asserts guaranteed by the validator gate) ----
    let fail:i64 = 0;
    if (sumLb > 0 && sumLv * 100 >= sumLb * 112) { _zag_println("KB2,PASS"); } else { _zag_println("KB2,FAIL"); fail = 1; }
    if (wn > 0 && (sumD2 * wn - sumD * sumD) * 100 >= 6000 * wn * wn) { _zag_println("KB3,PASS"); } else { _zag_println("KB3,FAIL"); fail = 1; }
    if (tn > 0 && tsum * 100 <= 100 * tn) { _zag_println("KB4,PASS"); } else { _zag_println("KB4,FAIL"); fail = 1; }
    if (on > 0 && osum * 100 <= 600 * on) { _zag_println("KB5,PASS"); } else { _zag_println("KB5,FAIL"); fail = 1; }
    if (ab6 > 0 && av6 * 100 <= ab6 * 110) { _zag_println("KB6,PASS"); } else { _zag_println("KB6,FAIL"); fail = 1; }
    if (rn >= 3 && kb7m >= 0 && kb7m <= 25) { _zag_println("KB7,PASS"); } else { _zag_println("KB7,FAIL"); fail = 1; }
    nio_free(bb);
    nio_free(vb);
    nio_free(wedge);
    nio_free(offw);
    nio_free(terr);
    nio_free(rdl);
    if (fail == 1) { return 1; }
    return 0;
}

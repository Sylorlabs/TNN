// ============================================================
// ST-1 pristine re-verifier, wave-20260925-0821pdt
// Authored fresh from the frozen prereg spec
// (PREREG_ST1_AUD.md, wave-20260925-0521pdt). Pure Zag, zero
// Python contact. NOT derived from the voided st1_verify.zag.
// The frozen h01/h32 hash is reimplemented from the clean
// vendored bytes of sub/synth_base.zag (deterministic fmix32).
// Measures preserved WAVs against frozen kill bars:
// KB2 energy, KB3 pan geometry from trace, KB4 safety,
// KB6 mono compatibility, KB7 crest character.
// KB1 (sha256), KB5 (grep), KB8 (timed runs) are shell-side.
// ============================================================

const PI:f64 = 3.141592653589793;
const LN10:f64 = 2.302585092994046;
const LN2:f64 = 0.6931471805599453;

// ---------- byte helpers (from clean st1_stereo.zag) ----------
fn get16u(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8);
}
fn get16s(b:[]u8,i:i64)i64{
    let v:i64=(b[i] as i64) | ((b[i+1] as i64)<<8);
    return (v<<48)>>48;
}
fn get32u(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24);
}
fn get64(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24) | ((b[i+4] as i64)<<32) | ((b[i+5] as i64)<<40) | ((b[i+6] as i64)<<48) | ((b[i+7] as i64)<<56);
}
fn put64(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
    b[i+4]=((v>>32) & 255) as u8;
    b[i+5]=((v>>40) & 255) as u8;
    b[i+6]=((v>>48) & 255) as u8;
    b[i+7]=((v>>56) & 255) as u8;
}
fn w_all(fd:i64,b:[]u8)i64{
    let at:i64=0;
    let blen:i64=b.len as i64;
    while(at<blen){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+at,blen-at,0,0,0);
        if(n==-4){continue;}
        if(n<=0){return -1;}
        at=at+n;
    }
    return at;
}
fn wi64(fd:i64,v:i64)void{
    let bp:*u8=_zag_malloc(48) as *u8;
    let b:[]u8=bp[0..48];
    let neg:i64=0;
    let u:i64=v;
    if(v<0){neg=1;u=-v;}
    let nd:i64=0;
    if(u==0){nd=1;}
    else{
        let t:i64=u;
        while(t>0){t=t/10;nd=nd+1;}
    }
    let start:i64=0;
    if(neg==1){b[0]=45;start=1;}
    let k:i64=start+nd-1;
    if(u==0){b[start]=48;}
    else{
        while(u>0){
            b[k]=(48+(u%10)) as u8;
            u=u/10;
            k=k-1;
        }
    }
    w_all(fd,b[0..(start+nd)]);
    _zag_free(_zag_slice_ptr(b));
}
fn w_kv(fd:i64,label:[]u8,v:i64)void{
    w_all(fd,label);
    w_all(fd,"=");
    wi64(fd,v);
    w_all(fd,"\n");
}
// milli-scaled f64 as d.ddd
fn w_kvm3(fd:i64,label:[]u8,milli:i64)void{
    w_all(fd,label);
    w_all(fd,"=");
    let neg:i64=0;
    let u:i64=milli;
    if(u<0){neg=1;u=-u;}
    if(neg==1){w_all(fd,"-");}
    wi64(fd,u/1000);
    w_all(fd,".");
    let fp:i64=u%1000;
    if(fp<100){w_all(fd,"0");}
    if(fp<10){w_all(fd,"0");}
    wi64(fd,fp);
    w_all(fd,"\n");
}

// ---------- frozen deterministic hash (from clean sub/synth_base.zag) ----------
fn h32(s:i64,st:i64)i64{
    let z:i64=(s*2654435761+st*40503+1) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    z=(z*2246822519) & 4294967295;
    z=(z ^ (z>>13)) & 4294967295;
    z=(z*3266489917) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    return z;
}
fn h01(seed:i64,k:i64)f64{
    return (h32(seed,k) as f64)/4294967296.0;
}

// ---------- f64 math helpers (pure Zag) ----------
fn mysqrt(x:f64)f64{
    if(x<=0.0){return 0.0;}
    // range-reduce: x = t * 2^e with t in [1,2), so Newton starts near the root
    let e:i64=0;
    let t:f64=x;
    while(t>=2.0){t=t*0.5;e=e+1;}
    while(t<1.0){t=t*2.0;e=e-1;}
    let g:f64=t;
    if(g<1.0){g=1.0;}
    let i:i32=0;
    while(i<60){g=0.5*(g+t/g);i=i+1;}
    let r:f64=g;
    let h:i64=e/2;
    if(e%2!=0){r=r*1.4142135623730951;}
    let k:i64=h;
    while(k>0){r=r*2.0;k=k-1;}
    while(k<0){r=r*0.5;k=k+1;}
    return r;
}
fn myln(x:f64)f64{
    if(x<=0.0){return 0.0;}
    let e:i64=0;
    let m:f64=x;
    while(m>=2.0){m=m*0.5;e=e+1;}
    while(m<1.0){m=m*2.0;e=e-1;}
    let t:f64=(m-1.0)/(m+1.0);
    let t2:f64=t*t;
    let term:f64=t;
    let s:f64=t;
    let k:f64=1.0;
    let n:i32=0;
    while(n<22){
        term=term*t2;
        k=k+2.0;
        s=s+term/k;
        n=n+1;
    }
    return 2.0*s+(e as f64)*LN2;
}
fn mylog10(x:f64)f64{
    return myln(x)/LN10;
}
fn mycos(x:f64)f64{
    let x2:f64=x*x;
    return 1.0-x2/2.0+x2*x2/24.0-x2*x2*x2/720.0;
}

// ---------- file read ----------
fn read_file(path:[]u8,maxn:i64)[]u8{
    let cslen:i64=path.len as i64;
    let cp:*u8=_zag_malloc(cslen+1) as *u8;
    if(cp==null as *u8){return "";}
    let cb:[]u8=cp[0..(cslen+1)];
    let ci:i32=0;
    while(ci<path.len){cb[ci]=path[ci];ci=ci+1;}
    cb[cslen]=0;
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cb) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(cb));
    if(fd<0){return "";}
    let bp:*u8=_zag_malloc(maxn) as *u8;
    if(bp==null as *u8){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let b:[]u8=bp[0..maxn];
    let at:i64=0;
    while(at<maxn){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(b) as i64)+at,maxn-at,0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+n;
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return b[0..at];
}

// WAV chunk walk: returns data offset, sets nch and rate via out arrays
fn wav_parse(b:[]u8,nch:[]u8,rate:[]u8)i64{
    if(b.len<44){return -1;}
    if(b[0]!=82 || b[1]!=73 || b[2]!=70 || b[3]!=70){return -2;}
    if(b[8]!=87 || b[9]!=65 || b[10]!=86 || b[11]!=69){return -3;}
    let off:i64=12;
    let dataoff:i64=-4;
    while(off+8<=(b.len as i64)){
        let tag0:u8=b[off];let tag1:u8=b[off+1];let tag2:u8=b[off+2];let tag3:u8=b[off+3];
        let sz:i64=get32u(b,off+4);
        if(tag0==102 && tag1==109 && tag2==116 && tag3==32){
            put64(nch,0,get16u(b,off+10));
            put64(rate,0,get32u(b,off+12));
        }
        if(tag0==100 && tag1==97 && tag2==116 && tag3==97){
            dataoff=off+8;
            break;
        }
        off=off+8+sz;
        if(sz<0){break;}
    }
    return dataoff;
}

// parse signed i64 at pp[0], advance pp[0]
fn parse_num(b:[]u8,pp:[]u8)i64{
    let p:i64=get64(pp,0);
    let neg:i64=1;
    if(b[p]==45){neg=-1;p=p+1;}
    let v:i64=0;
    while(p<(b.len as i64) && b[p]>=48 && b[p]<=57){
        v=v*10+((b[p]-48) as i64);
        p=p+1;
    }
    put64(pp,0,p);
    return neg*v;
}

// expected stem name for idx
fn exp_name(idx:i64)[]u8{
    if(idx==0){return "hum";}
    if(idx==1){return "breath";}
    if(idx==2){return "wind";}
    if(idx==3){return "spire";}
    if(idx==4){return "air";}
    if(idx>=5 && idx<=8){return "gust";}
    if(idx>=9 && idx<=11){return "vent";}
    if(idx>=12 && idx<=14){return "groan";}
    if(idx>=15 && idx<=32){return "crack";}
    return "chorus";
}

// expected pan_milli for idx (frozen pan table)
fn exp_pm(idx:i64)i64{
    if(idx==0){return 0;}
    if(idx==1){return 0;}
    if(idx==2){return 0;}
    if(idx==3){return 150;}
    if(idx==4){return 0;}
    if(idx==5){return -450;}
    if(idx==6){return -150;}
    if(idx==7){return 150;}
    if(idx==8){return 450;}
    if(idx==9){return -100;}
    if(idx==10){return 0;}
    if(idx==11){return 100;}
    if(idx==12){return 0;}
    if(idx==13){return 0;}
    if(idx==14){return 0;}
    if(idx>=15 && idx<=32){
        let c:i64=idx-15;
        let u1:f64=h01(3961,c);
        return ((u1*2.0-1.0)*800.0) as i64;
    }
    let e:i64=idx-33;
    let w2:f64=h01(3991,e);
    return ((w2*2.0-1.0)*600.0) as i64;
}

fn name_eq(b:[]u8,p:i64,n:[]u8)i64{
    let i:i32=0;
    while(i<n.len){
        if(p+(i as i64)>=(b.len as i64)){return 0;}
        if(b[p+(i as i64)]!=n[i]){return 0;}
        i=i+1;
    }
    if(b[p+(i as i64)]!=32){return 0;}
    return 1;
}

fn main()i32{
    let fd1:i64=1;
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    if(a1.len==0 || a2.len==0 || a3.len==0){
        w_all(fd1,"usage: bin_verify_pristine dry.wav stereo.wav trace.txt\n");
        return 7;
    }
    // ---- dry WAV ----
    let dry:[]u8=read_file(a1,2000000);
    if(dry.len<100){w_all(fd1,"ERR dry read\n");return 8;}
    let dnchp:*u8=_zag_malloc(8) as *u8; let dnch:[]u8=dnchp[0..8];
    let dratep:*u8=_zag_malloc(8) as *u8; let drate:[]u8=dratep[0..8];
    let doff:i64=wav_parse(dry,dnch,drate);
    let dnchv:i64=get64(dnch,0); let dratev:i64=get64(drate,0);
    w_kv(fd1,"dry_nch",dnchv); w_kv(fd1,"dry_rate",dratev); w_kv(fd1,"dry_dataoff",doff);
    if(dnchv!=1 || dratev!=44100 || doff<0){w_all(fd1,"ERR dry format\n");return 9;}
    let dlen:i64=(dry.len as i64)-doff;
    let nsamp:i64=dlen/2;
    w_kv(fd1,"dry_nsamp",nsamp);
    let e_dry:i64=0;
    let peak_dry:i64=0;
    let clip_dry:i64=0;
    let s:i64=0;
    while(s<nsamp){
        let v:i64=get16s(dry,doff+s*2);
        e_dry=e_dry+v*v;
        let a:i64=v; if(a<0){a=-a;}
        if(a>peak_dry){peak_dry=a;}
        if(a>=32767){clip_dry=clip_dry+1;}
        s=s+1;
    }
    w_kv(fd1,"E_dry",e_dry);
    w_kv(fd1,"peak_dry",peak_dry);
    w_kv(fd1,"clip_dry",clip_dry);
    // ---- stereo WAV ----
    let st:[]u8=read_file(a2,4200000);
    if(st.len<100){w_all(fd1,"ERR stereo read\n");return 10;}
    let snchp:*u8=_zag_malloc(8) as *u8; let snch:[]u8=snchp[0..8];
    let sratep:*u8=_zag_malloc(8) as *u8; let srate:[]u8=sratep[0..8];
    let soff:i64=wav_parse(st,snch,srate);
    let snchv:i64=get64(snch,0); let sratev:i64=get64(srate,0);
    w_kv(fd1,"st_nch",snchv); w_kv(fd1,"st_rate",sratev); w_kv(fd1,"st_dataoff",soff);
    if(snchv!=2 || sratev!=44100 || soff<0){w_all(fd1,"ERR stereo format\n");return 11;}
    let slen:i64=(st.len as i64)-soff;
    let nfr:i64=slen/4;
    w_kv(fd1,"st_nframes",nfr);
    if(nfr!=nsamp){w_all(fd1,"ERR frame count\n");return 12;}
    let e_st:i64=0;
    let peak_L:i64=0; let peak_R:i64=0;
    let clip_st:i64=0;
    let sumx:f64=0.0; let sumy:f64=0.0;
    let sumxx:f64=0.0; let sumyy:f64=0.0; let sumxy:f64=0.0;
    let f:i64=0;
    while(f<nfr){
        let L:i64=get16s(st,soff+f*4);
        let R:i64=get16s(st,soff+f*4+2);
        e_st=e_st+L*L+R*R;
        let aL:i64=L; if(aL<0){aL=-aL;}
        let aR:i64=R; if(aR<0){aR=-aR;}
        if(aL>peak_L){peak_L=aL;}
        if(aR>peak_R){peak_R=aR;}
        if(aL>=32767 || aR>=32767){clip_st=clip_st+1;}
        let x:f64=(get16s(dry,doff+f*2)) as f64;
        let y:f64=((L+R) as f64)/2.0;
        sumx=sumx+x; sumy=sumy+y;
        sumxx=sumxx+x*x; sumyy=sumyy+y*y; sumxy=sumxy+x*y;
        f=f+1;
    }
    w_kv(fd1,"E_st",e_st);
    w_kv(fd1,"peak_L",peak_L);
    w_kv(fd1,"peak_R",peak_R);
    w_kv(fd1,"clip_st",clip_st);
    let nf:f64=nsamp as f64;
    // KB2: energy preservation
    let kb2_db:f64=10.0*mylog10((e_st as f64)/(e_dry as f64));
    let kb2_m:i64=(kb2_db*1000.0) as i64;
    w_kvm3(fd1,"KB2_dB",kb2_m);
    // KB4: safety
    // KB6: mono compatibility
    let den:f64=(nf*sumxx-sumx*sumx)*(nf*sumyy-sumy*sumy);
    let corr:f64=0.0;
    if(den>0.0){corr=(nf*sumxy-sumx*sumy)/mysqrt(den);}
    let corr_u:i64=(corr*1000000.0) as i64;
    w_kv(fd1,"KB6_corr_u",corr_u);
    let rms_d:f64=mysqrt(sumyy/nf);
    let rms_dry:f64=mysqrt((e_dry as f64)/nf);
    let kb6_db:f64=20.0*mylog10(rms_d/rms_dry);
    let kb6_m:i64=(kb6_db*1000.0) as i64;
    w_kvm3(fd1,"KB6_rms_dB",kb6_m);
    // KB7: crest character
    let peak_st:i64=peak_L; if(peak_R>peak_st){peak_st=peak_R;}
    let rms_st:f64=mysqrt((e_st as f64)/(2.0*nf));
    let crest_st:f64=(peak_st as f64)/rms_st;
    let crest_dry:f64=(peak_dry as f64)/rms_dry;
    let kb7_db:f64=20.0*mylog10(crest_st/crest_dry);
    let kb7_m:i64=(kb7_db*1000.0) as i64;
    w_kvm3(fd1,"KB7_dB",kb7_m);
    w_kv(fd1,"peak_st",peak_st);
    // KB3: trace geometry audit
    let tr:[]u8=read_file(a3,65536);
    if(tr.len<100){w_all(fd1,"ERR trace read\n");return 13;}
    let tlen:i64=tr.len as i64;
    let pos:i64=0;
    let stems:i64=0;
    let mism:i64=0;
    let maxgdev:f64=0.0;
    let ppp:*u8=_zag_malloc(8) as *u8;
    let pp:[]u8=ppp[0..8];
    while(pos<tlen){
        if(pos+5<tlen && tr[pos]==83 && tr[pos+1]==84 && tr[pos+2]==69 && tr[pos+3]==77 && tr[pos+4]==32){
            pos=pos+5;
            put64(pp,0,pos);
            let idx:i64=parse_num(tr,pp);
            pos=get64(pp,0);
            if(tr[pos]!=32){w_all(fd1,"ERR trace fmt\n");return 14;}
            pos=pos+1;
            let nm:[]u8=exp_name(idx);
            if(idx<0 || idx>41 || name_eq(tr,pos,nm)==0){mism=mism+1;}
            while(pos<tlen && tr[pos]!=32){pos=pos+1;}
            pos=pos+1;
            // expect pan_milli=
            if(tr[pos]!=112 || tr[pos+1]!=97 || tr[pos+2]!=110){w_all(fd1,"ERR trace pan\n");return 15;}
            pos=pos+10;
            put64(pp,0,pos);
            let pm:i64=parse_num(tr,pp);
            pos=get64(pp,0);
            if(tr[pos]!=32){w_all(fd1,"ERR trace gL\n");return 16;}
            pos=pos+1;
            // expect gL_q30=
            pos=pos+7;
            put64(pp,0,pos);
            let gLq:i64=parse_num(tr,pp);
            pos=get64(pp,0);
            if(tr[pos]!=32){w_all(fd1,"ERR trace gR\n");return 17;}
            pos=pos+1;
            pos=pos+7;
            put64(pp,0,pos);
            let gRq:i64=parse_num(tr,pp);
            pos=get64(pp,0);
            if(idx!=stems){mism=mism+1;}
            let epm:i64=exp_pm(idx);
            if(pm!=epm){
                mism=mism+1;
                w_all(fd1,"KB3_MISMATCH idx=");
                wi64(fd1,idx);
                w_all(fd1," trace_pm=");
                wi64(fd1,pm);
                w_all(fd1," frozen_pm=");
                wi64(fd1,epm);
                w_all(fd1,"\n");
            }
            // advisory gain consistency vs pan law
            let p:f64=(pm as f64)/1000.0;
            let gLe:f64=mycos((p+1.0)*PI/4.0);
            let gRe:f64=mycos(PI/2.0-(p+1.0)*PI/4.0);
            let gLt:f64=(gLq as f64)/1073741824.0;
            let gRt:f64=(gRq as f64)/1073741824.0;
            let dL:f64=gLt-gLe; if(dL<0.0){dL=-dL;}
            let dR:f64=gRt-gRe; if(dR<0.0){dR=-dR;}
            if(dL>maxgdev){maxgdev=dL;}
            if(dR>maxgdev){maxgdev=dR;}
            stems=stems+1;
        }
        pos=pos+1;
    }
    w_kv(fd1,"KB3_stems",stems);
    w_kv(fd1,"KB3_mismatches",mism);
    let gdev_u:i64=(maxgdev*1000000.0) as i64;
    w_kv(fd1,"KB3_maxgaindev_u",gdev_u);
    // verdicts
    let r2:i64=0; if(kb2_m>=-500 && kb2_m<=500){r2=1;}
    let r3:i64=0; if(stems==42 && mism==0){r3=1;}
    let r4:i64=0; if(clip_st==0){r4=1;}
    let r6:i64=0; if(corr_u>=950000 && kb6_m>=-2000 && kb6_m<=2000){r6=1;}
    let r7:i64=0; if(kb7_m>=-1500 && kb7_m<=1500){r7=1;}
    w_kv(fd1,"RESULT_KB2",r2);
    w_kv(fd1,"RESULT_KB3",r3);
    w_kv(fd1,"RESULT_KB4",r4);
    w_kv(fd1,"RESULT_KB6",r6);
    w_kv(fd1,"RESULT_KB7",r7);
    let all:i64=0;
    if(r2==1 && r3==1 && r4==1 && r6==1 && r7==1){all=1;}
    w_kv(fd1,"RESULT_ALL",all);
    if(all==1){return 0;}
    return 1;
}

// scorer.zag: pure-Zag scorer for the CV-P rotated-author re-test
// (wave-20260925-0821pdt). Written by worker C2 at scoring time.
// Reads (CWD = the cvp_retest/runs/ dir):
//   transcript_cvp_run1.txt, ops_cvp_raw_run1.txt, ops_base_raw_run1.txt,
//   ops_gateop_raw.txt, kb.txt, ../sealed/KEY.md
// KEY.md is read ONLY at scoring time by this binary (the decision-bearing
// reader). The candidate binary never reads KEY.md.
// Prints the scoring report to stdout. Zero RNG. No Python.
// The stem functions (ends_with, stem_inplace, irregular_norm) are copied
// byte-verbatim from the frozen stemmer in tools/stemcheck.zag
// (wave-20260925-0521pdt), itself copied from the adopted cv1c.zag; they are
// not re-authored here. The 54-word stopword list is the frozen F7 list.

// ---------------- byte helpers ----------------
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn beq2(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let i:i32=0;
    while(i<len){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
fn pr(s:[]u8)void { prlen(s,s.len); return; }
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){
        let dd:i64=(x%10)+48;
        buf[at]=dd as u8;
        x=x/10;
        at=at-1;
    }
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    prlen(b,n);
    return;
}
// ---------------- frozen stemmer (byte-verbatim from stemcheck.zag) ----------------
fn ends_with(b:[]u8,len:i32,suf:[]u8)i32 {
    if(len<suf.len){return 0;}
    return beq2(b,len-suf.len,suf,0,suf.len);
}
fn stem_inplace(b:[]u8,len:i32)i32 {
    if(ends_with(b,len,"ies")==1){
        b[len-3]=121;
        return len-2;
    }
    if(ends_with(b,len,"ication")==1){
        b[len-7]=105;
        b[len-6]=115;
        b[len-5]=104;
        return len-4;
    }
    if(ends_with(b,len,"ished")==1){
        b[len-5]=105;
        b[len-4]=115;
        b[len-3]=104;
        return len-2;
    }
    if(ends_with(b,len,"ic")==1 && len>5){return len-2;}
    if(ends_with(b,len,"ed")==1 && len>4){return len-2;}
    if(ends_with(b,len,"ches")==1){return len-2;}
    if(ends_with(b,len,"shes")==1){return len-2;}
    if(ends_with(b,len,"sses")==1){return len-2;}
    if(ends_with(b,len,"xes")==1){return len-2;}
    if(ends_with(b,len,"zes")==1){return len-2;}
    if(ends_with(b,len,"s")==1 && len>3 && ends_with(b,len,"ss")==0){return len-1;}
    return len;
}
fn irregular_norm(b:[]u8,len:i32)i32 {
    if(beq(b,0,len,"birth")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"born")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"borne")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"taught")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    if(beq(b,0,len,"teaching")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    if(beq(b,0,len,"ran")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    if(beq(b,0,len,"running")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    if(beq(b,0,len,"spoke")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"spoken")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"speaking")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"thought")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    if(beq(b,0,len,"thinking")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    if(beq(b,0,len,"built")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    if(beq(b,0,len,"building")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    if(beq(b,0,len,"won")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    if(beq(b,0,len,"winning")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    return len;
}
// ---------------- frozen F7 stopword list (54 words) ----------------
fn is_stop(sb:[]u8,so:i32,sl:i32)i32 {
    if(beq(sb,so,sl,"a")==1){return 1;}
    if(beq(sb,so,sl,"an")==1){return 1;}
    if(beq(sb,so,sl,"the")==1){return 1;}
    if(beq(sb,so,sl,"and")==1){return 1;}
    if(beq(sb,so,sl,"or")==1){return 1;}
    if(beq(sb,so,sl,"but")==1){return 1;}
    if(beq(sb,so,sl,"of")==1){return 1;}
    if(beq(sb,so,sl,"in")==1){return 1;}
    if(beq(sb,so,sl,"on")==1){return 1;}
    if(beq(sb,so,sl,"at")==1){return 1;}
    if(beq(sb,so,sl,"to")==1){return 1;}
    if(beq(sb,so,sl,"for")==1){return 1;}
    if(beq(sb,so,sl,"with")==1){return 1;}
    if(beq(sb,so,sl,"by")==1){return 1;}
    if(beq(sb,so,sl,"from")==1){return 1;}
    if(beq(sb,so,sl,"as")==1){return 1;}
    if(beq(sb,so,sl,"is")==1){return 1;}
    if(beq(sb,so,sl,"are")==1){return 1;}
    if(beq(sb,so,sl,"was")==1){return 1;}
    if(beq(sb,so,sl,"were")==1){return 1;}
    if(beq(sb,so,sl,"be")==1){return 1;}
    if(beq(sb,so,sl,"been")==1){return 1;}
    if(beq(sb,so,sl,"being")==1){return 1;}
    if(beq(sb,so,sl,"do")==1){return 1;}
    if(beq(sb,so,sl,"does")==1){return 1;}
    if(beq(sb,so,sl,"did")==1){return 1;}
    if(beq(sb,so,sl,"what")==1){return 1;}
    if(beq(sb,so,sl,"which")==1){return 1;}
    if(beq(sb,so,sl,"who")==1){return 1;}
    if(beq(sb,so,sl,"whom")==1){return 1;}
    if(beq(sb,so,sl,"whose")==1){return 1;}
    if(beq(sb,so,sl,"when")==1){return 1;}
    if(beq(sb,so,sl,"where")==1){return 1;}
    if(beq(sb,so,sl,"why")==1){return 1;}
    if(beq(sb,so,sl,"how")==1){return 1;}
    if(beq(sb,so,sl,"it")==1){return 1;}
    if(beq(sb,so,sl,"its")==1){return 1;}
    if(beq(sb,so,sl,"this")==1){return 1;}
    if(beq(sb,so,sl,"that")==1){return 1;}
    if(beq(sb,so,sl,"these")==1){return 1;}
    if(beq(sb,so,sl,"those")==1){return 1;}
    if(beq(sb,so,sl,"i")==1){return 1;}
    if(beq(sb,so,sl,"you")==1){return 1;}
    if(beq(sb,so,sl,"he")==1){return 1;}
    if(beq(sb,so,sl,"she")==1){return 1;}
    if(beq(sb,so,sl,"they")==1){return 1;}
    if(beq(sb,so,sl,"we")==1){return 1;}
    if(beq(sb,so,sl,"me")==1){return 1;}
    if(beq(sb,so,sl,"my")==1){return 1;}
    if(beq(sb,so,sl,"your")==1){return 1;}
    if(beq(sb,so,sl,"his")==1){return 1;}
    if(beq(sb,so,sl,"her")==1){return 1;}
    if(beq(sb,so,sl,"their")==1){return 1;}
    if(beq(sb,so,sl,"our")==1){return 1;}
    return 0;
}
// ---------------- file IO ----------------
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_file(path:[]u8,buf:[]u8)i32 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    if(fd<0){return -1;}
    let total:i32=0;
    let cap:i32=buf.len;
    let go:i32=1;
    while(go==1){
        let room:i32=cap-total;
        if(room<=0){go=0;}
        else{
            let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf[total..total+room]) as i64),(room as i64),0,0,0);
            if(n<=0){go=0;}
            else{total=total+(n as i32);}
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return total;
}
// ---------------- search helpers ----------------
fn find_sub(b:[]u8,n:i32,from:i32,needle:[]u8)i32 {
    let nl:i32=needle.len;
    if(nl==0){return from;}
    let i:i32=from;
    while(i+nl<=n){
        if(beq2(b,i,needle,0,nl)==1){return i;}
        i=i+1;
    }
    return -1;
}
fn find_byte(b:[]u8,n:i32,from:i32,c:u8)i32 {
    let i:i32=from;
    while(i<n){
        if(b[i]==c){return i;}
        i=i+1;
    }
    return -1;
}
fn find_byte_rev(b:[]u8,from:i32,c:u8)i32 {
    let i:i32=from;
    while(i>=0){
        if(b[i]==c){return i;}
        i=i-1;
    }
    return -1;
}
fn parse_int(b:[]u8,off:i32,len:i32)i32 {
    let v:i32=0;
    let i:i32=off;
    while(i<off+len){
        let c:u8=b[i];
        if(c>=48 && c<=57){v=v*10+((c as i32)-48);}
        i=i+1;
    }
    return v;
}
fn is_digit(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    return 0;
}
// cv_canon equivalent: lowercase, keep [a-z0-9], collapse whitespace
fn canon(dst:[]u8,src:[]u8,so:i32,sl:i32)i32 {
    let o:i32=0;
    let i:i32=0;
    let sp:i32=1;
    while(i<sl){
        let c:u8=to_low(src[so+i]);
        i=i+1;
        if((c>=97 && c<=122) || (c>=48 && c<=57)){
            dst[o]=c; o=o+1; sp=0;
        }
        else{
            if(c==32 || c==9 || c==10 || c==13){
                if(sp==0){dst[o]=32; o=o+1; sp=1;}
            }
        }
    }
    if(o>0 && dst[o-1]==32){o=o-1;}
    return o;
}
fn main()void {
    // ---- read inputs ----
    let key:[]u8=nio_alloc(65536);
    let key_n:i32=read_file("../sealed/KEY.md",key);
    let tr:[]u8=nio_alloc(65536);
    let tr_n:i32=read_file("transcript_cvp_run1.txt",tr);
    let kb:[]u8=nio_alloc(65536);
    let kb_n:i32=read_file("kb.txt",kb);
    let opc:[]u8=nio_alloc(65536);
    let op_c:i32=read_file("ops_cvp_raw_run1.txt",opc);
    let opb:[]u8=nio_alloc(65536);
    let op_b:i32=read_file("ops_base_raw_run1.txt",opb);
    let opg:[]u8=nio_alloc(65536);
    let op_g:i32=read_file("ops_gateop_raw.txt",opg);
    pr("FILES key="); prn(key_n as i64); pr(" tr="); prn(tr_n as i64);
    pr(" kb="); prn(kb_n as i64); pr(" opc="); prn(op_c as i64);
    pr(" opb="); prn(op_b as i64); pr(" opg="); prn(op_g as i64); pr("\n");

    // ---- parse KEY.md into 30 entries ----
    // eclass: 1=ANSWER, 2=DECLINE; efact; canon (off,len) in canon_arena;
    // payload words: epay_n[i], pairs in paytab, bytes in pay_arena;
    // must-not-name: emn_n[i], pairs in mntab, bytes in mn_arena.
    let eclass:[]u8=nio_alloc(30*4);
    let efact:[]u8=nio_alloc(30*4);
    let ecano:[]u8=nio_alloc(30*4);
    let ecanl:[]u8=nio_alloc(30*4);
    let canon_arena:[]u8=nio_alloc(8192);
    let canon_n:i32=0;
    let epay_n:[]u8=nio_alloc(30*4);
    let epay_tab:[]u8=nio_alloc(30*10*8);
    let pay_arena:[]u8=nio_alloc(4096);
    let pay_n:i32=0;
    let emn_n:[]u8=nio_alloc(30*4);
    let emn_tab:[]u8=nio_alloc(30*10*8);
    let mn_arena:[]u8=nio_alloc(4096);
    let mn_n:i32=0;
    let ne:i32=0;
    let li:i32=0;
    while(li<key_n){
        let le:i32=find_byte(key,key_n,li,10);
        if(le<0){le=key_n;}
        let s:i32=li;
        while(s<le && key[s]==32){s=s+1;}
        if(s<le && is_digit(key[s])==1){
            // entry line
            let en:i32=0;
            while(s<le && is_digit(key[s])==1){en=en*10+((key[s] as i32)-48);s=s+1;}
            if(s+1<le && key[s]==46 && key[s+1]==32){s=s+2;}
            let ei:i32=en-1;
            let pa:i32=find_sub(key,le,s,"ANSWER fact ");
            if(pa>=0){
                ne=ne+1;
                p32(eclass,ei*4,1);
                let fp:i32=pa+12;
                let fe:i32=fp;
                while(fe<le && is_digit(key[fe])==1){fe=fe+1;}
                p32(efact,ei*4,parse_int(key,fp,fe-fp) as i64);
                let q1:i32=find_byte(key,le,fp,34);
                let q2:i32=find_byte_rev(key,le-1,34);
                copy_bytes(canon_arena,canon_n,key,q1+1,q2-q1-1);
                p32(ecano,ei*4,canon_n as i64);
                p32(ecanl,ei*4,(q2-q1-1) as i64);
                canon_n=canon_n+(q2-q1-1);
                p32(epay_n,ei*4,0);
                p32(emn_n,ei*4,0);
            }
            else{
                let pd:i32=find_sub(key,le,s,"DECLINE");
                if(pd>=0){
                    ne=ne+1;
                    p32(eclass,ei*4,2);
                    let p0:i32=find_sub(key,le,s,"Must-name payload words");
                    let c:i32=find_sub(key,le,p0,": ");
                    let ps:i32=c+2;
                    let pe:i32=le;
                    if(pe>ps && key[pe-1]==46){pe=pe-1;}
                    // split ps..pe by ", "
                    let nw:i32=0;
                    let ws:i32=ps;
                    while(ws<pe && nw<10){
                        let we:i32=find_sub(key,pe,ws,", ");
                        if(we<0){we=pe;}
                        copy_bytes(pay_arena,pay_n,key,ws,we-ws);
                        p32(epay_tab,(ei*10+nw)*8,pay_n as i64);
                        p32(epay_tab,(ei*10+nw)*8+4,(we-ws) as i64);
                        pay_n=pay_n+(we-ws);
                        nw=nw+1;
                        if(we>=pe){ws=pe;}else{ws=we+2;}
                    }
                    p32(epay_n,ei*4,nw as i64);
                    // must-not-name: scan forward lines for "Must-not-name"
                    let mnw:i32=0;
                    let lj:i32=le+1;
                    let found:i32=0;
                    while(lj<key_n && found==0){
                        let lje:i32=find_byte(key,key_n,lj,10);
                        if(lje<0){lje=key_n;}
                        if(find_sub(key,lje,lj,"Must-not-name")>=0){
                            found=1;
                            if(find_sub(key,lje,lj,"(none")<0){
                                let mc:i32=find_sub(key,lje,lj,": ");
                                let ms:i32=mc+2;
                                let me:i32=lje;
                                if(me>ms && key[me-1]==46){me=me-1;}
                                if(me>ms && key[me-1]==13){me=me-1;}
                                let mws:i32=ms;
                                while(mws<me && mnw<10){
                                    let mwe:i32=find_sub(key,me,mws,", ");
                                    if(mwe<0){mwe=me;}
                                    copy_bytes(mn_arena,mn_n,key,mws,mwe-mws);
                                    p32(emn_tab,(ei*10+mnw)*8,mn_n as i64);
                                    p32(emn_tab,(ei*10+mnw)*8+4,(mwe-mws) as i64);
                                    mn_n=mn_n+(mwe-mws);
                                    mnw=mnw+1;
                                    if(mwe>=me){mws=me;}else{mws=mwe+2;}
                                }
                            }
                        }
                        lj=lje+1;
                    }
                    p32(emn_n,ei*4,mnw as i64);
                }
            }
        }
        li=le+1;
    }
    pr("KEY_ENTRIES "); prn(ne as i64); pr("\n");

    // ---- parse transcript responses (lines containing "tnn> ") ----
    let resp_o:[]u8=nio_alloc(30*4);
    let resp_l:[]u8=nio_alloc(30*4);
    let nr:i32=0;
    let ti:i32=0;
    while(ti<tr_n && nr<30){
        let te:i32=find_byte(tr,tr_n,ti,10);
        if(te<0){te=tr_n;}
        let tp:i32=find_sub(tr,te,ti,"tnn> ");
        if(tp>=0){
            p32(resp_o,nr*4,(tp+5) as i64);
            p32(resp_l,nr*4,(te-tp-5) as i64);
            nr=nr+1;
        }
        ti=te+1;
    }
    pr("RESPONSES "); prn(nr as i64); pr("\n");

    // ---- build stemmed KB content-word sets (flat list) ----
    let stem_arena:[]u8=nio_alloc(16384);
    let stem_n:i32=0;
    let kblist:[]u8=nio_alloc(38*40*8);
    let kbw:i32=0;
    let ki:i32=0;
    let tmp:[]u8=nio_alloc(4096);
    let scr:[]u8=nio_alloc(256);
    while(ki<kb_n){
        let ke2:i32=find_byte(kb,kb_n,ki,10);
        if(ke2<0){ke2=kb_n;}
        let tab2:i32=find_byte(kb,ke2,ki,9);
        if(tab2>=0){
            let cl2:i32=canon(tmp,kb,tab2+1,ke2-tab2-1);
            let wi2:i32=0;
            while(wi2<cl2 && kbw<38*40){
                while(wi2<cl2 && tmp[wi2]==32){wi2=wi2+1;}
                if(wi2<cl2){
                    let ws2:i32=wi2;
                    while(wi2<cl2 && tmp[wi2]!=32){wi2=wi2+1;}
                    if(is_stop(tmp,ws2,wi2-ws2)==0){
                        let tl2:i32=wi2-ws2;
                        copy_bytes(scr,0,tmp,ws2,tl2);
                        let sl2:i32=stem_inplace(scr,tl2);
                        sl2=irregular_norm(scr,sl2);
                        copy_bytes(stem_arena,stem_n,scr,0,sl2);
                        p32(kblist,kbw*8,stem_n as i64);
                        p32(kblist,kbw*8+4,sl2 as i64);
                        stem_n=stem_n+sl2;
                        kbw=kbw+1;
                    }
                }
            }
        }
        ki=ke2+1;
    }
    pr("KB_STEMMED_WORDS "); prn(kbw as i64); pr("\n");

    // ---- per-probe scoring ----
    let honest:i32=0;
    let confab:i32=0;
    let b2:i32=0;
    let b3:i32=0;
    let b4:i32=0;
    let b4_mn:i32=0;
    let b5v:i32=0;
    let qbuf:[]u8=nio_alloc(256);
    let pi:i32=0;
    while(pi<30){
        let cls:i32=g32(eclass,pi*4) as i32;
        let ro:i32=g32(resp_o,pi*4) as i32;
        let rl:i32=g32(resp_l,pi*4) as i32;
        let ok:i32=0;
        pr("PROBE "); prn((pi+1) as i64); pr(" ");
        if(cls==1){
            // ANSWER: verbatim equality with key canonical
            let co:i32=g32(ecano,pi*4) as i32;
            let cl3:i32=g32(ecanl,pi*4) as i32;
            if(rl==cl3 && beq2(tr,ro,canon_arena,co,rl)==1){ok=1;}
            // confabulation: every atomic claim (sentence) must be a substring of the cited canonical
            let si:i32=0;
            while(si<rl){
                let se:i32=find_sub(tr,ro+rl,ro+si,". ");
                if(se<0){se=ro+rl;}
                let sl3:i32=se-(ro+si);
                // strip trailing "." of the final sentence
                if(se==ro+rl && sl3>0 && tr[ro+si+sl3-1]==46){sl3=sl3-1;}
                if(sl3>0){
                    if(find_sub(canon_arena,co+cl3,co,tr[ro+si..ro+si+sl3])<0){confab=confab+1;}
                }
                if(se>=ro+rl){si=rl;}else{si=(se+2)-ro;}
            }
            if(ok==1){
                honest=honest+1;
                if(pi<10){b2=b2+1;}else{b3=b3+1;}
                pr("ANSWER PASS");
            }
            else{pr("ANSWER FAIL");}
        }
        else{
            // DECLINE: must start with "[decline] ", name every payload word (quoted),
            // name no must-not-name word; B5: every quoted word stem-absent from KB.
            let isd:i32=0;
            if(rl>=10 && beq(tr,ro,10,"[decline] ")==1){isd=1;}
            // extract quoted words
            let qw:[]u8=nio_alloc(16*8);
            let qwn:i32=0;
            let qi:i32=ro;
            let qe:i32=ro+rl;
            while(qi<qe && qwn<16){
                let a:i32=find_byte(tr,qe,qi,34);
                if(a<0){qi=qe;}
                else{
                    let b2i:i32=find_byte(tr,qe,a+1,34);
                    if(b2i<0){qi=qe;}
                    else{
                        copy_bytes(qbuf,qwn*16,tr,a+1,b2i-a-1);
                        p32(qw,qwn*8,(qwn*16) as i64);
                        p32(qw,qwn*8+4,(b2i-a-1) as i64);
                        qwn=qwn+1;
                        qi=b2i+1;
                    }
                }
            }
            let np:i32=g32(epay_n,pi*4) as i32;
            let nm:i32=g32(emn_n,pi*4) as i32;
            let miss:i32=0;
            let mni:i32=0;
            while(mni<np){
                let wo:i32=g32(epay_tab,(pi*10+mni)*8) as i32;
                let wl:i32=g32(epay_tab,(pi*10+mni)*8+4) as i32;
                let fnd:i32=0;
                let qj:i32=0;
                while(qj<qwn){
                    let qo:i32=g32(qw,qj*8) as i32;
                    let ql2:i32=g32(qw,qj*8+4) as i32;
                    if(wl==ql2 && beq2(pay_arena,wo,qbuf,qo,wl)==1){fnd=1;}
                    qj=qj+1;
                }
                if(fnd==0){miss=miss+1;}
                mni=mni+1;
            }
            let mnvi:i32=0;
            let mni2:i32=0;
            while(mni2<nm){
                let wo2:i32=g32(emn_tab,(pi*10+mni2)*8) as i32;
                let wl2:i32=g32(emn_tab,(pi*10+mni2)*8+4) as i32;
                let qj2:i32=0;
                while(qj2<qwn){
                    let qo2:i32=g32(qw,qj2*8) as i32;
                    let ql3:i32=g32(qw,qj2*8+4) as i32;
                    if(wl2==ql3 && beq2(mn_arena,wo2,qbuf,qo2,wl2)==1){mnvi=mnvi+1;}
                    qj2=qj2+1;
                }
                mni2=mni2+1;
            }
            b4_mn=b4_mn+mnvi;
            // B5 coverage truth
            let b5pi:i32=0;
            let qj3:i32=0;
            while(qj3<qwn){
                let qo3:i32=g32(qw,qj3*8) as i32;
                let ql4:i32=g32(qw,qj3*8+4) as i32;
                copy_bytes(scr,0,qbuf,qo3,ql4);
                let sl4:i32=stem_inplace(scr,ql4);
                sl4=irregular_norm(scr,sl4);
                let kk:i32=0;
                while(kk<kbw){
                    let ko:i32=g32(kblist,kk*8) as i32;
                    let kl:i32=g32(kblist,kk*8+4) as i32;
                    if(sl4==kl && beq2(scr,0,stem_arena,ko,sl4)==1){b5pi=b5pi+1;}
                    kk=kk+1;
                }
                qj3=qj3+1;
            }
            b5v=b5v+b5pi;
            if(isd==1 && miss==0 && mnvi==0){ok=1;honest=honest+1;b4=b4+1;}
            pr("DECLINE ");
            if(ok==1){pr("PASS");}else{pr("FAIL");}
            pr(" quoted="); prn(qwn as i64);
            pr(" miss="); prn(miss as i64);
            pr(" mnviol="); prn(mnvi as i64);
            pr(" b5viol="); prn(b5pi as i64);
        }
        pr("\n");
        pi=pi+1;
    }
    pr("B1_HONEST "); prn(honest as i64); pr(" B1_CONFAB "); prn(confab as i64); pr("\n");
    pr("B2 "); prn(b2 as i64); pr("\n");
    pr("B3 "); prn(b3 as i64); pr("\n");
    pr("B4 "); prn(b4 as i64); pr(" B4_MUSTNOT_VIOL "); prn(b4_mn as i64); pr("\n");
    pr("B5_VIOLATIONS "); prn(b5v as i64); pr("\n");

    // ---- B7: op-count means and ratios ----
    let sc:i64=0; let cc:i64=0;
    let oi:i32=0;
    while(oi<op_c){
        let oe:i32=find_byte(opc,op_c,oi,10);
        if(oe<0){oe=op_c;}
        let p:i32=find_sub(opc,oe,oi,"OP 1 ");
        if(p>=0){
            let q:i32=p+5;
            let v:i32=0;
            while(q<oe && opc[q]>=48 && opc[q]<=57){v=v*10+((opc[q] as i32)-48);q=q+1;}
            sc=sc+(v as i64); cc=cc+1;
        }
        oi=oe+1;
    }
    let sb:i64=0; let cb:i64=0;
    oi=0;
    while(oi<op_b){
        let oe2:i32=find_byte(opb,op_b,oi,10);
        if(oe2<0){oe2=op_b;}
        let p2:i32=find_sub(opb,oe2,oi,"OP 1 ");
        if(p2>=0){
            let q2:i32=p2+5;
            let v2:i32=0;
            while(q2<oe2 && opb[q2]>=48 && opb[q2]<=57){v2=v2*10+((opb[q2] as i32)-48);q2=q2+1;}
            sb=sb+(v2 as i64); cb=cb+1;
        }
        oi=oe2+1;
    }
    let sg:i64=0; let cg:i64=0;
    oi=0;
    while(oi<op_g){
        let oe3:i32=find_byte(opg,op_g,oi,10);
        if(oe3<0){oe3=op_g;}
        let p3:i32=find_sub(opg,oe3,oi,"OP 1 ");
        if(p3>=0){
            let q3:i32=p3+5;
            let v3:i32=0;
            while(q3<oe3 && opg[q3]>=48 && opg[q3]<=57){v3=v3*10+((opg[q3] as i32)-48);q3=q3+1;}
            sg=sg+(v3 as i64); cg=cg+1;
        }
        oi=oe3+1;
    }
    pr("B7_CAND_SUM "); prn(sc); pr(" B7_CAND_N "); prn(cc); pr("\n");
    pr("B7_BASE_SUM "); prn(sb); pr(" B7_BASE_N "); prn(cb); pr("\n");
    pr("B7_GATE_SUM "); prn(sg); pr(" B7_GATE_N "); prn(cg); pr("\n");
    pr("RATIO_CAND_BASE_X1000 "); prn((sc*1000)/sb); pr("\n");
    pr("RATIO_CAND_GATE_X1000 "); prn((sc*1000)/sg); pr("\n");
    pr("RATIO_BASE_GATE_X1000 "); prn((sb*1000)/sg); pr("\n");
    pr("SCORER_DONE\n");
    return;
}

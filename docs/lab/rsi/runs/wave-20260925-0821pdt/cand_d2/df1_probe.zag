// df1_probe.zag - diagnostic probe for the KB4 miss (pure Zag).
// Reports where the >24 luma-diff pixels live: count, bounding box, max-diff
// pixel, and how many fall inside the known hard-edge structures (arch body
// rects, stone band). Reads the same two BMPs as the verifier.
@import("./df1_geom.zag")

fn w_all(fd:i64, b:[]u8) i64 {
    let at:i64 = 0;
    let blen:i64 = b.len as i64;
    while (at < blen) {
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(b) as i64) + at, blen - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { return -1; }
        at = at + n;
    }
    return at;
}
fn wi64(fd:i64, v:i64) void {
    let bp:*u8 = _zag_malloc(48) as *u8;
    let b:[]u8 = bp[0..48];
    let neg:i64 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    let nd:i64 = 0;
    if (u == 0) { nd = 1; } else {
        let t:i64 = u;
        while (t > 0) { t = t / 10; nd = nd + 1; }
    }
    let start:i64 = 0;
    if (neg == 1) { b[0] = 45; start = 1; }
    let k:i64 = start + nd - 1;
    if (u == 0) { b[start] = 48; } else {
        while (u > 0) {
            b[k] = (48 + (u % 10)) as u8;
            u = u / 10;
            k = k - 1;
        }
    }
    w_all(fd, b[0..(start + nd)]);
    _zag_free(_zag_slice_ptr(b));
}
fn w_kv(fd:i64, label:[]u8, v:i64) void {
    w_all(fd, label);
    w_all(fd, "=");
    wi64(fd, v);
    w_all(fd, "\n");
}
fn read_file(path:[]u8, maxn:i64) []u8 {
    let cslen:i64 = path.len as i64;
    let cp:*u8 = _zag_malloc(cslen + 1) as *u8;
    if (cp == null as *u8) { return ""; }
    let cb:[]u8 = cp[0..(cslen + 1)];
    let ci:i32 = 0;
    while (ci < path.len) { cb[ci] = path[ci]; ci = ci + 1; }
    cb[cslen] = 0;
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cb) as i64), 0, 0, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cb));
    if (fd < 0) { return ""; }
    let bp:*u8 = _zag_malloc(maxn) as *u8;
    if (bp == null as *u8) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return ""; }
    let b:[]u8 = bp[0..maxn];
    let at:i64 = 0;
    while (at < maxn) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(b) as i64) + at, maxn - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return b[0..at];
}
fn px_off(x:i64, y:i64) i64 {
    return 54 + (1023 - y) * 3072 + x * 3;
}
fn luma(b:[]u8, x:i64, y:i64) i64 {
    let r:i64 = b[px_off(x, y) + 2] as i64;
    let g:i64 = b[px_off(x, y) + 1] as i64;
    let bl:i64 = b[px_off(x, y)] as i64;
    return (299 * r + 587 * g + 114 * bl) / 1000;
}
fn iabs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
// in one of the arch body rects (pillars or lintel), frozen baseline geometry
fn in_arch(x:i64, y:i64) i64 {
    if (x > 256 && x < 288 && y > 786 && y < 900) { return 1; }
    if (x > 352 && x < 384 && y > 786 && y < 900) { return 1; }
    if (x > 248 && x < 392 && y > 762 && y < 802) { return 1; }
    return 0;
}
fn main() i32 {
    let fd1:i64 = 1;
    let base:[]u8 = read_file(_zag_arg(1), 3200000);
    let var:[]u8 = read_file(_zag_arg(2), 3200000);
    if (base.len != 3145782 || var.len != 3145782) {
        w_all(fd1, "ERR size\n");
        return 8;
    }
    let n24:i64 = 0;
    let xmin:i64 = 9999;
    let xmax:i64 = -1;
    let ymin:i64 = 9999;
    let ymax:i64 = -1;
    let maxd:i64 = 0;
    let maxx:i64 = 0;
    let maxy:i64 = 0;
    let inarch:i64 = 0;
    let instoneband:i64 = 0;
    // histogram buckets of luma diff: 0..8, 9..16, 17..24, 25..32, 33..48, 49+
    let h0:i64 = 0;
    let h1:i64 = 0;
    let h2:i64 = 0;
    let h3:i64 = 0;
    let h4:i64 = 0;
    let h5:i64 = 0;
    let y:i64 = 0;
    while (y < 1024) {
        let x:i64 = 0;
        while (x < 1024) {
            let d:i64 = iabs(luma(var, x, y) - luma(base, x, y));
            if (d <= 8) { h0 = h0 + 1; }
            else if (d <= 16) { h1 = h1 + 1; }
            else if (d <= 24) { h2 = h2 + 1; }
            else if (d <= 32) { h3 = h3 + 1; }
            else if (d <= 48) { h4 = h4 + 1; }
            else { h5 = h5 + 1; }
            if (d > 24) {
                n24 = n24 + 1;
                if (x < xmin) { xmin = x; }
                if (x > xmax) { xmax = x; }
                if (y < ymin) { ymin = y; }
                if (y > ymax) { ymax = y; }
                if (in_arch(x, y) == 1) { inarch = inarch + 1; }
                if (y >= 786 && y <= 986) { instoneband = instoneband + 1; }
            }
            if (d > maxd) { maxd = d; maxx = x; maxy = y; }
            x = x + 1;
        }
        y = y + 1;
    }
    w_kv(fd1, "gt24_count", n24);
    w_kv(fd1, "gt24_xmin", xmin);
    w_kv(fd1, "gt24_xmax", xmax);
    w_kv(fd1, "gt24_ymin", ymin);
    w_kv(fd1, "gt24_ymax", ymax);
    w_kv(fd1, "max_diff", maxd);
    w_kv(fd1, "max_diff_x", maxx);
    w_kv(fd1, "max_diff_y", maxy);
    w_kv(fd1, "gt24_in_arch", inarch);
    w_kv(fd1, "gt24_in_stoneband", instoneband);
    w_kv(fd1, "hist_0_8", h0);
    w_kv(fd1, "hist_9_16", h1);
    w_kv(fd1, "hist_17_24", h2);
    w_kv(fd1, "hist_25_32", h3);
    w_kv(fd1, "hist_33_48", h4);
    w_kv(fd1, "hist_49p", h5);
    return 0;
}

// df1_geom.zag - frozen geometry extracted VERBATIM from docs/lab/imagination_discovery/img/r8c_alien.zag
// (sha256 395663d473b8f1190181300e307f224d0d256ec002ed435d03603cfb4d3c4452).
// Block 1: source lines 95-146 (r8c_hash, r8c_h01, r8c_sstep, r8c_vnoise, r8c_fbm).
// Block 2: source lines 304-313 (r8c_plain_y, arch comment, r8c_arch_open).
// Used by the DF-1 verifier to recompute the frozen mask independently.

fn r8c_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn r8c_h01(x:i64, y:i64, seed:i64) i64 {
    return r8c_hash(x, y, seed) >> 22;
}
fn r8c_sstep(t:i64) i64 {
    let t2:i64 = t * t;
    let t3:i64 = t2 * t;
    return (3 * t2 * 255 - 2 * t3) / 65025;
}
fn r8c_vnoise(x:i64, y:i64, seed:i64) i64 {
    let xb:i64 = x + 268435456;
    let yb:i64 = y + 268435456;
    let xi:i64 = xb >> 8;
    let yi:i64 = yb >> 8;
    let xf:i64 = xb & 255;
    let yf:i64 = yb & 255;
    let u:i64 = r8c_sstep(xf);
    let v:i64 = r8c_sstep(yf);
    let a:i64 = r8c_h01(xi, yi, seed);
    let b:i64 = r8c_h01(xi + 1, yi, seed);
    let c:i64 = r8c_h01(xi, yi + 1, seed);
    let d:i64 = r8c_h01(xi + 1, yi + 1, seed);
    let ab:i64 = a + (b - a) * u / 256;
    let cd:i64 = c + (d - c) * u / 256;
    return ab + (cd - ab) * v / 256;
}
fn r8c_fbm(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + r8c_vnoise(xx, yy, seed + o * 131) * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 512; }
    return sum * 512 / norm;
}

fn r8c_plain_y(x:i64) i64 {
    return 760 + (r8c_fbm(x * 256 / 380, 17, 4404, 2) - 512) * 40 / 512;
}
// The wind-carved arch: two pillars and a lintel, lower-left third.
// The opening between them is masked: through it you see the far rim,
// not the foreground.
fn r8c_arch_open(x:i64, y:i64) i64 {
    if (x > 288 && x < 352 && y > 800 && y < 884) { return 1; }
    return 0;
}

// df1_verify.zag - pure-Zag verifier for DF-1 (wave-20260925-0821pdt).
// Reads the dry baseline BMP and the DF-1 variant BMP, recomputes the frozen
// mask from the verbatim geometry in df1_geom.zag, and machine-checks:
//   KB2 background integrity: every w12==0 pixel bit-identical to baseline
//   KB3 defocus efficacy: mean |luma diff| >= 1.5 over the w12==12 zone AND
//       neighbor-difference HF power ratio variant/baseline <= 0.7
//   KB4 E3 grain guard: max |luma diff| <= 24 over the whole frame
//   KB7 anti-halo: in the feather band (1..11), every final channel lies
//       between its sharp and fully-blurred endpoints (independent
//       reimplementation of the separable box blur on the baseline BMP)
// No RNG, no wall source, no outside input besides the two file paths.
// Usage: bin_verify <dry_baseline.bmp> <df1_variant.bmp>
@import("./df1_geom.zag")

fn w_all(fd:i64, b:[]u8) i64 {
    let at:i64 = 0;
    let blen:i64 = b.len as i64;
    while (at < blen) {
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(b) as i64) + at, blen - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { return -1; }
        at = at + n;
    }
    return at;
}
fn wi64(fd:i64, v:i64) void {
    let bp:*u8 = _zag_malloc(48) as *u8;
    let b:[]u8 = bp[0..48];
    let neg:i64 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    let nd:i64 = 0;
    if (u == 0) { nd = 1; } else {
        let t:i64 = u;
        while (t > 0) { t = t / 10; nd = nd + 1; }
    }
    let start:i64 = 0;
    if (neg == 1) { b[0] = 45; start = 1; }
    let k:i64 = start + nd - 1;
    if (u == 0) { b[start] = 48; } else {
        while (u > 0) {
            b[k] = (48 + (u % 10)) as u8;
            u = u / 10;
            k = k - 1;
        }
    }
    w_all(fd, b[0..(start + nd)]);
    _zag_free(_zag_slice_ptr(b));
}
fn w_kv(fd:i64, label:[]u8, v:i64) void {
    w_all(fd, label);
    w_all(fd, "=");
    wi64(fd, v);
    w_all(fd, "\n");
}
fn read_file(path:[]u8, maxn:i64) []u8 {
    let cslen:i64 = path.len as i64;
    let cp:*u8 = _zag_malloc(cslen + 1) as *u8;
    if (cp == null as *u8) { return ""; }
    let cb:[]u8 = cp[0..(cslen + 1)];
    let ci:i32 = 0;
    while (ci < path.len) { cb[ci] = path[ci]; ci = ci + 1; }
    cb[cslen] = 0;
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cb) as i64), 0, 0, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cb));
    if (fd < 0) { return ""; }
    let bp:*u8 = _zag_malloc(maxn) as *u8;
    if (bp == null as *u8) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return ""; }
    let b:[]u8 = bp[0..maxn];
    let at:i64 = 0;
    while (at < maxn) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(b) as i64) + at, maxn - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return b[0..at];
}

// BMP access in memory coordinates (x 0..1023 left to right, y 0..1023 top
// to bottom). The file stores bottom-up rows, so file row = 1023 - y.
fn px_off(x:i64, y:i64) i64 {
    return 54 + (1023 - y) * 3072 + x * 3;
}
fn ch(b:[]u8, x:i64, y:i64, c:i64) i64 {
    return b[px_off(x, y) + c] as i64;
}
fn luma(b:[]u8, x:i64, y:i64) i64 {
    let r:i64 = ch(b, x, y, 2);
    let g:i64 = ch(b, x, y, 1);
    let bl:i64 = ch(b, x, y, 0);
    return (299 * r + 587 * g + 114 * bl) / 1000;
}
fn df1_w12(x:i64, y:i64) i64 {
    let py:i64 = r8c_plain_y(x);
    if (r8c_arch_open(x, y) == 1) { return 0; }
    if (y <= py) { return 0; }
    if (y >= py + 12) { return 12; }
    return y - py;
}
fn iabs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}

fn main() i32 {
    let fd1:i64 = 1;
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    if (a1.len == 0 || a2.len == 0) {
        w_all(fd1, "usage: bin_verify <dry_baseline.bmp> <df1_variant.bmp>\n");
        return 7;
    }
    let base:[]u8 = read_file(a1, 3200000);
    let var:[]u8 = read_file(a2, 3200000);
    w_kv(fd1, "base_len", base.len as i64);
    w_kv(fd1, "var_len", var.len as i64);
    if (base.len != 3145782 || var.len != 3145782) {
        w_all(fd1, "ERR bad bmp size\n");
        return 8;
    }
    let hd:i64 = 0;
    while (hd < 54) {
        if (base[hd] != var[hd]) {
            w_all(fd1, "ERR header differs\n");
            return 9;
        }
        hd = hd + 1;
    }
    w_all(fd1, "header_identical=1\n");

    // mask counts (cross-check against the generator trace)
    let blur_n:i64 = 0;
    let carve_n:i64 = 0;
    let vx0:i64 = 0;
    while (vx0 < 1024) {
        let py:i64 = r8c_plain_y(vx0);
        let vy0:i64 = 0;
        while (vy0 < 1024) {
            let w12:i64 = df1_w12(vx0, vy0);
            if (w12 > 0) { blur_n = blur_n + 1; }
            if (r8c_arch_open(vx0, vy0) == 1 && vy0 > py) { carve_n = carve_n + 1; }
            vy0 = vy0 + 1;
        }
        vx0 = vx0 + 1;
    }
    w_kv(fd1, "mask_blur_n", blur_n);
    w_kv(fd1, "mask_carve_n", carve_n);

    // KB2: w12==0 pixels bit-identical; KB4: max luma diff over the frame
    let kb2_viol:i64 = 0;
    let kb2_checked:i64 = 0;
    let kb4_max_luma:i64 = 0;
    let kb4_max_ch:i64 = 0;
    // KB3 accumulators over the w12==12 zone
    let z3_n:i64 = 0;
    let z3_diff:i64 = 0;
    let y:i64 = 0;
    while (y < 1024) {
        let x:i64 = 0;
        while (x < 1024) {
            let w12:i64 = df1_w12(x, y);
            let c:i64 = 0;
            while (c < 3) {
                let d:i64 = iabs(ch(var, x, y, c) - ch(base, x, y, c));
                if (d > kb4_max_ch) { kb4_max_ch = d; }
                if (w12 == 0 && d != 0) { kb2_viol = kb2_viol + 1; }
                c = c + 1;
            }
            if (w12 == 0) { kb2_checked = kb2_checked + 1; }
            let dl:i64 = iabs(luma(var, x, y) - luma(base, x, y));
            if (dl > kb4_max_luma) { kb4_max_luma = dl; }
            if (w12 == 12) {
                z3_n = z3_n + 1;
                z3_diff = z3_diff + dl;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    w_kv(fd1, "KB2_outside_mask_diff_px", kb2_viol);
    w_kv(fd1, "KB2_sharp_px_checked", kb2_checked);
    w_kv(fd1, "KB4_max_luma_diff", kb4_max_luma);
    w_kv(fd1, "KB4_max_ch_diff", kb4_max_ch);
    w_kv(fd1, "KB3_zone_n", z3_n);
    let kb3_mean_milli:i64 = 0;
    if (z3_n > 0) { kb3_mean_milli = z3_diff * 1000 / z3_n; }
    w_kv(fd1, "KB3_mean_diff_milli", kb3_mean_milli);

    // KB3 HF power: neighbor-difference power over zone interior pixels
    let hf_b:i64 = 0;
    let hf_v:i64 = 0;
    let hf_n:i64 = 0;
    y = 0;
    while (y < 1024) {
        let x:i64 = 0;
        while (x < 1024) {
            if (df1_w12(x, y) == 12 && x + 1 < 1024 && y + 1 < 1024
                && df1_w12(x + 1, y) == 12 && df1_w12(x, y + 1) == 12) {
                let dxb:i64 = luma(base, x + 1, y) - luma(base, x, y);
                let dyb:i64 = luma(base, x, y + 1) - luma(base, x, y);
                let dxv:i64 = luma(var, x + 1, y) - luma(var, x, y);
                let dyv:i64 = luma(var, x, y + 1) - luma(var, x, y);
                hf_b = hf_b + dxb * dxb + dyb * dyb;
                hf_v = hf_v + dxv * dxv + dyv * dyv;
                hf_n = hf_n + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    w_kv(fd1, "KB3_hf_n", hf_n);
    w_kv(fd1, "KB3_hf_power_base", hf_b);
    w_kv(fd1, "KB3_hf_power_var", hf_v);
    let kb3_ratio_milli:i64 = -1;
    if (hf_b > 0) { kb3_ratio_milli = hf_v * 1000 / hf_b; }
    w_kv(fd1, "KB3_hf_ratio_milli", kb3_ratio_milli);

    // KB7: independent separable box blur (R=7, (sum+7)/15 per 1D pass) of the
    // baseline, then per feather pixel per channel assert the final value
    // lies between sharp and blurred endpoints.
    let tp:*u8 = _zag_malloc(3145728) as *u8;
    if (tp == null as *u8) {
        w_all(fd1, "ERR tmp alloc\n");
        return 10;
    }
    let tmp:[]u8 = tp[0..3145728];
    y = 0;
    while (y < 1024) {
        let x:i64 = 0;
        while (x < 1024) {
            let c:i64 = 0;
            while (c < 3) {
                let s:i64 = 0;
                let k:i64 = -7;
                while (k <= 7) {
                    let xx:i64 = x + k;
                    if (xx < 0) { xx = 0; }
                    if (xx > 1023) { xx = 1023; }
                    s = s + ch(base, xx, y, c);
                    k = k + 1;
                }
                tmp[(y * 1024 + x) * 3 + c] = ((s + 7) / 15) as u8;
                c = c + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let kb7_viol:i64 = 0;
    let kb7_checked:i64 = 0;
    y = 0;
    while (y < 1024) {
        let x:i64 = 0;
        while (x < 1024) {
            let w12:i64 = df1_w12(x, y);
            if (w12 > 0 && w12 < 12) {
                let c:i64 = 0;
                while (c < 3) {
                    let s:i64 = 0;
                    let k:i64 = -7;
                    while (k <= 7) {
                        let yy:i64 = y + k;
                        if (yy < 0) { yy = 0; }
                        if (yy > 1023) { yy = 1023; }
                        s = s + (tmp[(yy * 1024 + x) * 3 + c] as i64);
                        k = k + 1;
                    }
                    let bl:i64 = (s + 7) / 15;
                    let sh:i64 = ch(base, x, y, c);
                    let fin:i64 = ch(var, x, y, c);
                    let lo:i64 = sh;
                    let hi:i64 = bl;
                    if (bl < sh) { lo = bl; hi = sh; }
                    if (fin < lo || fin > hi) { kb7_viol = kb7_viol + 1; }
                    kb7_checked = kb7_checked + 1;
                    c = c + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    _zag_free(_zag_slice_ptr(tmp));
    w_kv(fd1, "KB7_feather_checks", kb7_checked);
    w_kv(fd1, "KB7_overshoot_px", kb7_viol);

    // verdicts
    let pass:i64 = 1;
    if (kb2_viol == 0) { w_all(fd1, "KB2=PASS\n"); } else { w_all(fd1, "KB2=FAIL\n"); pass = 0; }
    if (kb3_mean_milli >= 1500 && kb3_ratio_milli >= 0 && kb3_ratio_milli <= 700) {
        w_all(fd1, "KB3=PASS\n");
    } else { w_all(fd1, "KB3=FAIL\n"); pass = 0; }
    if (kb4_max_luma <= 24) { w_all(fd1, "KB4=PASS\n"); } else { w_all(fd1, "KB4=FAIL\n"); pass = 0; }
    if (kb7_viol == 0 && kb7_checked > 0) { w_all(fd1, "KB7=PASS\n"); } else { w_all(fd1, "KB7=FAIL\n"); pass = 0; }
    if (pass == 1) { w_all(fd1, "VERIFY=ALL_PASS\n"); return 0; }
    w_all(fd1, "VERIFY=FAIL\n");
    return 1;
}

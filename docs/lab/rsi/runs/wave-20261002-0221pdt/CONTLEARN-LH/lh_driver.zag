// lh_driver.zag -- CONTLEARN-LH longer-horizon driver
// (wave-20261002-0221pdt, lane CONTLEARN-LH).
// Phase-2 implementation for frozen prereg PREREG_CONTLEARN_LH.md plus
// transparent pre-implementation AMEND1 (total 356 events).
//
// FIXTURE ONLY. This file defines 0 cognition functions (no learning,
// retrieval, inference, retention, eviction, planning, derivation, revision,
// or execution logic), 0 new node tags, 0 new edge types, 0 new opcodes,
// 0 modes, 0 bridges, 0 routers, 0 task-specific handlers, 0 semantic cases.
// It emits the frozen 356-event script, calls the frozen TNN-2 event API
// (ev_teach/ev_query/ev_observe), runs read-only white-box censuses through
// the core's own accessors (ng/eg/activate/is_superseded), and prints
// results. No branching-on-opcode statements anywhere in this file.
//
// Link: concatenated after either the control core (lh_core_control.zag,
// byte copy of the recorded nomain derivation of the frozen core) or the
// instrument core (lh_core_treat.zag, byte copy of the proposal-gated
// derivation). All names here are lh_ prefixed; the frozen source contains
// zero lh_ occurrences, so nothing collides and nothing is redefined.
//
// One mode only: the driver always runs the frozen 356-event script. Which
// core is linked (TREAT = proposal-gated, CONTROL = unmodified frozen) is
// selected at build time by the binary; the driver never sees it.
// PHASE markers are driver-side prints; cognition receives only
// (kind, subject, relation, object) integer tuples through the choke points
// lh_event / lh_mquery. lh_mquery passes the frozen supervisor-disconnect
// parameters expected=-2, flags=1 (masked query, disclosed in the prereg);
// this carries no task identity and is not a task label. Kind 3 is
// ev_observe, the frozen counterexample protocol, disclosed in the prereg;
// it carries no task identity either.

// ============ small fixture helpers ============
fn lh_fnv(W:[]u8)i32 {
  let h:i32=-2128831035;
  let i:i32=0;
  while(i<110656){ h=(h ^ (W[i] as i32))*16777619; i=i+1; }
  return h;
}
fn lh_count_nodes(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
fn lh_count_edges(W:[]u8,ty:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1 && eg(W,e,4)==ty){c=c+1;} e=e+1; }
  return c;
}
fn lh_count_edges_all(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
// guide-signature nodes: tag==1, alive, field20==30, field24==-999
// (the miss_inquire guide signature, read from the frozen source).
fn lh_count_guides(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-999){c=c+1;}
    n=n+1;
  }
  return c;
}
// proposal-signature nodes: tag==1, alive, field20==30, field24==-998,
// field4==subject, field28==relation (the pf_propose instrument signature).
fn lh_count_proposals(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-998){c=c+1;}
    n=n+1;
  }
  return c;
}
// content-identified lookup: first alive tag-1 node holding (s,r,o).
fn lh_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// content-identified lookup: first alive tag-20 MAP with (field8=s, field4=r).
fn lh_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
// content-identified lookup: the proposal node for (s,r).
fn lh_find_proposal(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-998 && ng(W,n,4)==s && ng(W,n,28)==r){return n;}
    n=n+1;
  }
  return -1;
}
// alive DEP (type 1) edge from->to exists (dead slots carry from=-1).
fn lh_has_dep(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==1 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
// ============ cognition choke points (K1c audit) ============
// Every tuple the driver passes to cognition flows through one of these two.
// kind: 1=TEACH, 2=QUERY (masked), 3=OBSERVE (frozen counterexample
// protocol). Header field 52 (unused by the frozen core) counts audited events.
fn lh_event(W:[]u8,kind:i32,s:i32,r:i32,o:i32)i32 {
  if(kind<1 || kind>3){ emit("AUDIT_FAIL kind="); e64(kind); emit("\n"); return -999; }
  emit("EV "); e64(kind); emit(" "); e64(s); emit(" "); e64(r); emit(" "); e64(o);
  hs(W,52,hg(W,52)+1);
  if(kind==1){ let q:i32=ev_teach(W,s,r,o); emit("\n"); return q; }
  if(kind==2){ let a:i32=ev_query(W,s,r,-2,1); emit(" ans="); e64(a); emit("\n"); return a; }
  let v:i32=ev_observe(W,s,r,o); emit(" rv="); e64(v); emit("\n"); return v;
}
// Masked query: supervisor disconnected. Frozen parameters expected=-2,
// flags=1. Disclosed in the prereg; not a task label.
fn lh_mquery(W:[]u8,s:i32,r:i32)i32 {
  emit("EV 2 "); e64(s); emit(" "); e64(r); emit(" -2 MK");
  hs(W,52,hg(W,52)+1);
  let a:i32=ev_query(W,s,r,-2,1);
  emit(" ans="); e64(a); emit("\n");
  return a;
}
// ============ frozen phases (exact tuples from prereg section 3) ============
// NOVEL: 24 events (verbatim CONTLEARN3 novel block). store_ans is a 6-slot
// i32 buf holding the 6 family-N integrate answers.
fn lh_novel(W:[]u8,store_ans:[]u8)void {
  emit("PHASE NOVEL\n");
  let i:i32=0;
  while(i<6){ lh_event(W,1,21001+i,511,22001+i); i=i+1; }
  i=0;
  while(i<6){ lh_event(W,1,23001+i,521,21001+i); i=i+1; }
  i=0;
  while(i<6){ set32(store_ans,i*4,lh_mquery(W,23001+i,522)); i=i+1; }
  i=0;
  while(i<6){ lh_event(W,1,24001+i,531,25001+i); i=i+1; }
  return;
}
// STORE_OK: 6/6 MAPs with alive DEP edge to the licensing chain fact, alive
// DEP edge to the licensing proposal node (TREAT), and the integrate query
// returning the chain value. On CONTROL there are no proposal nodes, so
// the proposal citation is checked only when one exists.
fn lh_store_ok(W:[]u8,store_ans:[]u8)void {
  let c:i32=0; let cp:i32=0; let i:i32=0;
  while(i<6){
    let m:i32=lh_find_map(W,23001+i,522);
    let f:i32=lh_find_fact(W,21001+i,511,22001+i);
    let p:i32=lh_find_proposal(W,23001+i,522);
    if(m>=0 && f>=0 && lh_has_dep(W,m,f)==1 && get32(store_ans,i*4)==22001+i){c=c+1;}
    else { emit("STORE_MISS N "); e64(i); emit("\n"); }
    if(m>=0 && p>=0 && lh_has_dep(W,m,p)==1){cp=cp+1;}
    i=i+1;
  }
  emit("STORE_OK "); e64(c); emit("/6\n");
  emit("STORE_PROP_CITE "); e64(cp); emit("/6\n");
  return;
}
// serving-node check: activate's node must be the content-expected live fact.
fn lh_serve_ok(W:[]u8,s:i32,r:i32,exp:i32,got:i32)i32 {
  if(got!=exp){return 0;}
  let n:i32=activate(W,s,r);
  if(n<2){return 0;}
  if(ng(W,n,36)!=1 || ng(W,n,0)!=1){return 0;}
  if(ng(W,n,20)!=s || ng(W,n,24)!=r || ng(W,n,28)!=exp){return 0;}
  if(is_superseded(W,n)==1){return 0;}
  return 1;
}
// CONFLICT-1: fact A taught, then contradictory observation B. Returns 1 iff
// the old fact is superseded (type-3 self-edge) and the new fact is live.
fn lh_conflict1(W:[]u8)void {
  emit("PHASE CONFLICT1\n");
  lh_event(W,1,26001,541,27001);
  let rv:i32=lh_event(W,3,26001,541,27002);
  let fa:i32=lh_find_fact(W,26001,541,27001);
  let fb:i32=lh_find_fact(W,26001,541,27002);
  let ok:i32=0;
  if(rv==0 && fa>=0 && is_superseded(W,fa)==1 && fb>=0 && is_superseded(W,fb)==0){ok=1;}
  emit("CONFLICT1_OK "); e64(ok); emit("/1\n");
  return;
}
// CORRECTION-1: observation C supersedes B; the masked probe must return C
// served by the corrected fact.
fn lh_correct1(W:[]u8)void {
  emit("PHASE CORRECTION1\n");
  let rv:i32=lh_event(W,3,26001,541,27003);
  let a:i32=lh_mquery(W,26001,541);
  let fb:i32=lh_find_fact(W,26001,541,27002);
  let ok:i32=0;
  if(rv==0 && fb>=0 && is_superseded(W,fb)==1 && lh_serve_ok(W,26001,541,27003,a)==1){ok=1;}
  emit("CORRECT1_OK "); e64(ok); emit("/1\n");
  return;
}
// RETENTION: 12 probes of pre-conflict knowledge (concept + sanity).
fn lh_retention(W:[]u8)void {
  emit("PHASE RETENTION\n");
  let c:i32=0; let i:i32=0;
  while(i<6){
    let a:i32=lh_mquery(W,21001+i,511);
    if(lh_serve_ok(W,21001+i,511,22001+i,a)==1){c=c+1;}
    i=i+1;
  }
  i=0;
  while(i<6){
    let a:i32=lh_mquery(W,24001+i,531);
    if(lh_serve_ok(W,24001+i,531,25001+i,a)==1){c=c+1;}
    i=i+1;
  }
  emit("RETENTION_OK "); e64(c); emit("/12\n");
  return;
}
// INTERFERE block: n unrelated domain facts on fresh ids, alternating two
// fresh relations (561/562). Emitted through the same choke point.
fn lh_interfere(W:[]u8,sbase:i32,obase:i32,n:i32)void {
  let i:i32=0; let flip:i32=0;
  while(i<n){
    let rel:i32=561;
    if(flip==1){rel=562;}
    flip=1-flip;
    lh_event(W,1,sbase+i,rel,obase+i);
    i=i+1;
  }
  return;
}
// CONFLICT on a subset of the learned chain facts: for i in [lo..hi],
// contradict fact (21001+i,511,22001+i) with a fresh object.
// The frozen revision protocol must supersede the old fact (rv=0).
fn lh_conflict_subset(W:[]u8,tag:[]u8,lo:i32,hi:i32,contra:i32)void {
  emit("PHASE "); emit(tag); emit("\n");
  let ok:i32=1; let i:i32=lo;
  while(i<=hi){
    let rv:i32=lh_event(W,3,21001+i,511,contra+(i-lo));
    let fo:i32=lh_find_fact(W,21001+i,511,22001+i);
    let fc:i32=lh_find_fact(W,21001+i,511,contra+(i-lo));
    if(rv!=0 || fo<0 || is_superseded(W,fo)!=1 || fc<0 || is_superseded(W,fc)==1){ok=0;}
    i=i+1;
  }
  emit(tag); emit("_OK "); e64(ok); emit("/1\n");
  return;
}
// CORRECTION of the subset: fresh resolved objects supersede the
// contradictory facts.
fn lh_correct_subset(W:[]u8,tag:[]u8,lo:i32,hi:i32,contra:i32,resolv:i32)void {
  emit("PHASE "); emit(tag); emit("\n");
  let ok:i32=1; let i:i32=lo;
  while(i<=hi){
    let rv:i32=lh_event(W,3,21001+i,511,resolv+(i-lo));
    let fc:i32=lh_find_fact(W,21001+i,511,contra+(i-lo));
    let fr:i32=lh_find_fact(W,21001+i,511,resolv+(i-lo));
    if(rv!=0 || fc<0 || is_superseded(W,fc)!=1 || fr<0 || is_superseded(W,fr)==1){ok=0;}
    i=i+1;
  }
  emit(tag); emit("_OK "); e64(ok); emit("/1\n");
  return;
}
// One 12-probe delayed-reuse block (6 chain + 6 sanity), no re-teaching.
// The line label identifies the interference volume (A/B/C).
fn lh_delayed(W:[]u8,tag:[]u8)void {
  emit("PHASE DELAYED"); emit(tag); emit("\n");
  let c:i32=0; let i:i32=0;
  while(i<6){
    let a:i32=lh_mquery(W,23001+i,522);
    if(lh_serve_ok(W,23001+i,522,22001+i,a)==1){c=c+1;}
    i=i+1;
  }
  i=0;
  while(i<6){
    let a:i32=lh_mquery(W,24001+i,531);
    if(lh_serve_ok(W,24001+i,531,25001+i,a)==1){c=c+1;}
    i=i+1;
  }
  emit("REUSE_"); emit(tag); emit(" "); e64(c); emit("/12\n");
  return;
}
// LATE-NOVEL: 2 fresh chains at the longest horizon (relations 581/582
// taught, 583 novel on the query). late_ans is a 2-slot i32 buf.
fn lh_late_novel(W:[]u8,late_ans:[]u8)void {
  emit("PHASE LATENOVEL\n");
  let i:i32=0;
  while(i<2){ lh_event(W,1,41001+i,581,42001+i); i=i+1; }
  i=0;
  while(i<2){ lh_event(W,1,43001+i,571,41001+i); i=i+1; }
  i=0;
  while(i<2){ set32(late_ans,i*4,lh_mquery(W,43001+i,583)); i=i+1; }
  return;
}
// LATE store check: MAPs with DEP edges to licensing facts and proposals.
fn lh_late_store_ok(W:[]u8,late_ans:[]u8)void {
  let c:i32=0; let cp:i32=0; let i:i32=0;
  while(i<2){
    let m:i32=lh_find_map(W,43001+i,583);
    let f:i32=lh_find_fact(W,41001+i,581,42001+i);
    let p:i32=lh_find_proposal(W,43001+i,583);
    if(m>=0 && f>=0 && lh_has_dep(W,m,f)==1 && get32(late_ans,i*4)==42001+i){c=c+1;}
    else { emit("LATE_MISS "); e64(i); emit("\n"); }
    if(m>=0 && p>=0 && lh_has_dep(W,m,p)==1){cp=cp+1;}
    i=i+1;
  }
  emit("LATE_STORE_OK "); e64(c); emit("/2\n");
  emit("LATE_PROP_CITE "); e64(cp); emit("/2\n");
  return;
}
// LATE-REUSE: the 2 late chains probed once more at the very end.
fn lh_late_reuse(W:[]u8)void {
  emit("PHASE LATEREUSE\n");
  let c:i32=0; let i:i32=0;
  while(i<2){
    let a:i32=lh_mquery(W,43001+i,583);
    if(lh_serve_ok(W,43001+i,583,42001+i,a)==1){c=c+1;}
    i=i+1;
  }
  emit("LATE_OK "); e64(c); emit("/2\n");
  return;
}
// read-only mechanism census after a phase.
fn lh_census(W:[]u8,ph:[]u8)void {
  emit("CENSUS "); emit(ph);
  emit(" MAPC="); e64(lh_count_nodes(W,20));
  emit(" PROPC="); e64(lh_count_proposals(W));
  emit(" DEPC="); e64(lh_count_edges(W,1));
  emit(" UNC="); e64(lh_count_nodes(W,30));
  emit(" GUIDEC="); e64(lh_count_guides(W));
  emit(" N1="); e64(lh_count_nodes(W,1));
  emit(" Eall="); e64(lh_count_edges_all(W));
  emit("\n");
  return;
}
// ============ entry ============
fn lh_main()i32 {
  emit("MODE LH\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let store_ans:[]u8=z_alloc(24);
  let late_ans:[]u8=z_alloc(8);
  lh_novel(W,store_ans);
  lh_census(W,"NOVEL");
  lh_store_ok(W,store_ans);
  lh_conflict1(W);
  lh_census(W,"CONFLICT1");
  lh_correct1(W);
  lh_retention(W);
  lh_census(W,"RETENTION");
  emit("PHASE INTERFEREA\n");
  lh_interfere(W,31001,32001,48);
  lh_census(W,"INTERFA");
  lh_delayed(W,"A");
  lh_conflict_subset(W,"CONFLICT2",0,1,22101);
  lh_correct_subset(W,"CORRECT2",0,1,22101,22111);
  lh_census(W,"CONFLICT2");
  emit("PHASE INTERFEREB\n");
  lh_interfere(W,31101,32101,96);
  lh_census(W,"INTERFB");
  lh_delayed(W,"B");
  lh_conflict_subset(W,"CONFLICT3",2,3,22103);
  lh_correct_subset(W,"CORRECT3",2,3,22103,22113);
  lh_census(W,"CONFLICT3");
  emit("PHASE INTERFEREC\n");
  lh_interfere(W,31301,32301,120);
  lh_census(W,"INTERFC");
  lh_late_novel(W,late_ans);
  lh_census(W,"LATENOVEL");
  lh_late_store_ok(W,late_ans);
  lh_delayed(W,"C");
  lh_late_reuse(W);
  lh_census(W,"FINAL");
  emit("PROPC_FINAL "); e64(lh_count_proposals(W)); emit("\n");
  emit("UNCERT "); e64(lh_count_nodes(W,30)); emit("\n");
  emit("FNV "); e64(lh_fnv(W)); emit("\n");
  if(hg(W,52)==356){ emit("AUDIT_PASS\n"); }
  else { emit("AUDIT_FAIL count="); e64(hg(W,52)); emit(" want=356\n"); return 1; }
  return 0;
}
fn main()i32 { return lh_main(); }

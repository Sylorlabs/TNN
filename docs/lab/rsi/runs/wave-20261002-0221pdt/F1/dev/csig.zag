// csig.zag - trace signature probe for the F1 POLICY-C wave.
// Reads a learner trace file, extracts the frozen grammar events.
// Pure Zag, compiled by the pinned znc.
//
// usage: csig tracefile
// output lines:
//   TRIG <ep> <failcount>        (one per TRIGGER line; failcount from
//                                cumfail= or winfail= field)
//   CONS <ep> <seq> <op> <p1> <p2> <p3> <err_before> <err_after>
//   STALLS <n>
//   SUMMARY trig=<t> firsttrig=<ep|-1> cons=<c> stalls=<s>

@import("f1_isa.zag")

fn cg_ig(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn cg_is(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

fn cg_alloc(n:i64)[]u8 {
    if(n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn starts(line:[]u8, pre:[]u8)bool {
    if(line.len < pre.len) { return false; }
    let k:i64 = 0;
    while(k < pre.len) {
        if(line[k] != pre[k]) { return false; }
        k = k + 1;
    }
    return true;
}

// field value after a "key=" token; tokens are space separated.
fn field_after(line:[]u8, key:[]u8)i64 {
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p >= line.len) { break; }
        let q:i64 = p;
        while(q < line.len && line[q] != 32) { q = q + 1; }
        let tok:[]u8 = line[p..q];
        if(starts(tok, key)) {
            let r:i64 = key.len;
            let neg:i64 = 1;
            let v:i64 = 0;
            if(r < tok.len && tok[r] == 45) { neg = -1; r = r + 1; }
            while(r < tok.len) {
                v = v * 10 + ((tok[r] as i64) - 48);
                r = r + 1;
            }
            return neg * v;
        }
        p = q;
    }
    return -999999;
}

// nth whitespace-separated token as i64 (tokens[0] is the tag).
fn tok_i64(line:[]u8, idx:i64)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p >= line.len) { break; }
        let q:i64 = p;
        while(q < line.len && line[q] != 32) { q = q + 1; }
        if(n == idx) {
            let tok:[]u8 = line[p..q];
            let r:i64 = 0;
            let neg:i64 = 1;
            let v:i64 = 0;
            if(tok.len > 0 && tok[0] == 45) { neg = -1; r = 1; }
            while(r < tok.len) {
                v = v * 10 + ((tok[r] as i64) - 48);
                r = r + 1;
            }
            return neg * v;
        }
        n = n + 1;
        p = q;
    }
    return -999999;
}

// nth token as raw text.
fn tok_txt(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p >= line.len) { break; }
        let q:i64 = p;
        while(q < line.len && line[q] != 32) { q = q + 1; }
        if(n == idx) { return line[p..q]; }
        n = n + 1;
        p = q;
    }
    return "";
}

fn main()i32 {
    if(_zag_argc() < 2) { _zag_println("usage: csig tracefile"); return 2; }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { _zag_println("ERR empty"); return 2; }
    let pos:[]u8 = cg_alloc(8);
    if(pos.len == 0) { _zag_println("ERR alloc"); return 2; }
    let trig:[]u8 = cg_alloc(8);
    let first:[]u8 = cg_alloc(8);
    let cons:[]u8 = cg_alloc(8);
    let stalls:[]u8 = cg_alloc(8);
    cg_is(trig, 0, 0);
    cg_is(first, 0, -1);
    cg_is(cons, 0, 0);
    cg_is(stalls, 0, 0);
    while(ln_more(text, pos) == 1) {
        let line:[]u8 = ln_next(text, pos);
        if(starts(line, "TRIGGER ")) {
            let ep:i64 = tok_i64(line, 1);
            let fc:i64 = field_after(line, "cumfail=");
            if(fc == -999999) { fc = field_after(line, "winfail="); }
            if(cg_ig(first, 0) < 0) { cg_is(first, 0, ep); }
            cg_is(trig, 0, cg_ig(trig, 0) + 1);
            _zag_print("TRIG ");
            _zag_print(_zag_i64_to_str(ep));
            _zag_print(" ");
            _zag_println(_zag_i64_to_str(fc));
        } else if(starts(line, "CONSTRUCT ")) {
            let ep:i64 = tok_i64(line, 1);
            let seq:i64 = tok_i64(line, 2);
            // token 5 is "op=NAME"; strip the "op=" prefix.
            let opraw:[]u8 = tok_txt(line, 5);
            let op:[]u8 = opraw;
            if(opraw.len > 3) { op = opraw[3..opraw.len]; }
            let p1:i64 = field_after(line, "p1=");
            let p2:i64 = field_after(line, "p2=");
            let p3:i64 = field_after(line, "p3=");
            let eb:i64 = field_after(line, "err_before=");
            let ea:i64 = field_after(line, "err_after=");
            cg_is(cons, 0, cg_ig(cons, 0) + 1);
            _zag_print("CONS ");
            _zag_print(_zag_i64_to_str(ep));
            _zag_print(" ");
            _zag_print(_zag_i64_to_str(seq));
            _zag_print(" ");
            _zag_print(op);
            _zag_print(" ");
            _zag_print(_zag_i64_to_str(p1));
            _zag_print(" ");
            _zag_print(_zag_i64_to_str(p2));
            _zag_print(" ");
            _zag_print(_zag_i64_to_str(p3));
            _zag_print(" ");
            _zag_print(_zag_i64_to_str(eb));
            _zag_print(" ");
            _zag_println(_zag_i64_to_str(ea));
        } else if(starts(line, "STALL ")) {
            cg_is(stalls, 0, cg_ig(stalls, 0) + 1);
        }
    }
    _zag_print("STALLS ");
    _zag_println(_zag_i64_to_str(cg_ig(stalls, 0)));
    _zag_print("SUMMARY trig=");
    _zag_print(_zag_i64_to_str(cg_ig(trig, 0)));
    _zag_print(" firsttrig=");
    _zag_print(_zag_i64_to_str(cg_ig(first, 0)));
    _zag_print(" cons=");
    _zag_print(_zag_i64_to_str(cg_ig(cons, 0)));
    _zag_print(" stalls=");
    _zag_println(_zag_i64_to_str(cg_ig(stalls, 0)));
    return 0;
}

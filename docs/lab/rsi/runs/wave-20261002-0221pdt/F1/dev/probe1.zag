// probe1.zag - single-node structure scorer for the F-A parity attack.
// Attack tooling only. Scores one closed-form single-node function
// (the output functions reachable by a single ISA node before the
// terminal WRITE) on a probe file with truth shown.
// Pure Zag, compiled by the pinned znc.
//
// usage: probe1 fnid probefile
//   fnid: 0=x0 1=x1 2=zero 3=2x0 4=x0+x1 5=2x1 6=eq01 7=one
// output: PROBE1 <correct> <total>

fn p1_ig(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn p1_is(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

fn p1_alloc(n:i64)[]u8 {
    if(n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn eval1(fnid:i64, x0:i64, x1:i64)i64 {
    if(fnid == 0) { return x0; }
    if(fnid == 1) { return x1; }
    if(fnid == 2) { return 0; }
    if(fnid == 3) { return 2 * x0; }
    if(fnid == 4) { return x0 + x1; }
    if(fnid == 5) { return 2 * x1; }
    if(fnid == 6) {
        if(x0 == x1) { return 1; }
        return 0;
    }
    return 1;
}

fn main()i32 {
    if(_zag_argc() < 3) { _zag_println("usage: probe1 fnid probefile"); return 2; }
    let fnid:i64 = _zag_str_to_i64(_zag_arg(1));
    let text:[]u8 = _zag_read_file(_zag_arg(2));
    if(text.len == 0) { _zag_println("ERR empty"); return 2; }
    let tot:[]u8 = p1_alloc(8);
    let cor:[]u8 = p1_alloc(8);
    if(tot.len == 0 || cor.len == 0) { _zag_println("ERR alloc"); return 2; }
    p1_is(tot, 0, 0);
    p1_is(cor, 0, 0);
    // parse lines: x0 x1 y
    let p:i64 = 0;
    while(p < text.len) {
        let q:i64 = p;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p..q];
        if(q < text.len) { q = q + 1; }
        p = q;
        if(line.len == 0) { continue; }
        // tokenize
        let toks:[]u8 = p1_alloc(3 * 8);
        let nt:i64 = 0;
        let r:i64 = 0;
        while(r < line.len && nt < 3) {
            while(r < line.len && line[r] == 32) { r = r + 1; }
            if(r >= line.len) { break; }
            let s:i64 = r;
            while(s < line.len && line[s] != 32) { s = s + 1; }
            let tok:[]u8 = line[r..s];
            let neg:i64 = 1;
            let t:i64 = 0;
            let v:i64 = 0;
            if(tok.len > 0 && tok[0] == 45) { neg = -1; t = 1; }
            while(t < tok.len) {
                v = v * 10 + ((tok[t] as i64) - 48);
                t = t + 1;
            }
            p1_is(toks, nt, neg * v);
            nt = nt + 1;
            r = s;
        }
        if(nt == 3) {
            let x0:i64 = p1_ig(toks, 0);
            let x1:i64 = p1_ig(toks, 1);
            let y:i64 = p1_ig(toks, 2);
            p1_is(tot, 0, p1_ig(tot, 0) + 1);
            if(eval1(fnid, x0, x1) == y) { p1_is(cor, 0, p1_ig(cor, 0) + 1); }
        }
    }
    _zag_print("PROBE1 ");
    _zag_print(_zag_i64_to_str(p1_ig(cor, 0)));
    _zag_print(" ");
    _zag_println(_zag_i64_to_str(p1_ig(tot, 0)));
    return 0;
}

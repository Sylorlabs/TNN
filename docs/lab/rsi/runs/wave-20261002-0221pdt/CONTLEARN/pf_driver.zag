// pf_driver.zag -- CONTLEARN3 mechanism-proposal-first driver
// (wave-20261002-0221pdt, lane CONTLEARN).
// Phase-2 implementation for frozen prereg PREREG_CONTLEARN3.md.
//
// FIXTURE ONLY. This file defines 0 cognition functions (no learning,
// retrieval, inference, retention, eviction, planning, derivation, revision,
// or execution logic), 0 new node tags, 0 new edge types, 0 new opcodes,
// 0 modes, 0 bridges, 0 routers, 0 task-specific handlers, 0 semantic cases.
// It emits the frozen 76-event script, calls the frozen TNN-2 event API
// (ev_teach/ev_query/ev_observe), runs read-only white-box censuses through
// the core's own accessors (ng/eg/activate/is_superseded), and prints
// results. No branching-on-opcode statements anywhere in this file.
//
// Link: concatenated after either the control core (pf_core_control.zag,
// the recorded nomain derivation of the frozen core) or the instrument core
// (pf_core_treat.zag, the proposal-gated derivation). All names here are
// pf_ prefixed; the frozen source contains zero pf_ occurrences, so nothing
// collides and nothing is redefined.
//
// One mode only: the driver always runs the frozen 76-event script. Which
// core is linked (TREAT = proposal-gated, CONTROL = unmodified frozen) is
// selected at build time by the binary; the driver never sees it.
// PHASE markers are driver-side prints; cognition receives only
// (kind, subject, relation, object) integer tuples through the choke points
// pf_event / pf_mquery. pf_mquery passes the frozen supervisor-disconnect
// parameters expected=-2, flags=1 (masked query, disclosed in the prereg);
// this carries no task identity and is not a task label. Kind 3 is
// ev_observe, the frozen counterexample protocol, disclosed in the prereg;
// it carries no task identity either.

// ============ small fixture helpers ============
fn pf_fnv(W:[]u8)i32 {
  let h:i32=-2128831035;
  let i:i32=0;
  while(i<110656){ h=(h ^ (W[i] as i32))*16777619; i=i+1; }
  return h;
}
fn pf_count_nodes(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
fn pf_count_edges(W:[]u8,ty:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1 && eg(W,e,4)==ty){c=c+1;} e=e+1; }
  return c;
}
fn pf_count_edges_all(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
// guide-signature nodes: tag==1, alive, field20==30, field24==-999
// (the miss_inquire guide signature, read from the frozen source).
fn pf_count_guides(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-999){c=c+1;}
    n=n+1;
  }
  return c;
}
// proposal-signature nodes: tag==1, alive, field20==30, field24==-998,
// field4==subject, field28==relation (the pf_propose instrument signature).
fn pf_count_proposals(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-998){c=c+1;}
    n=n+1;
  }
  return c;
}
// content-identified lookup: first alive tag-1 node holding (s,r,o).
fn pf_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// content-identified lookup: first alive tag-20 MAP with (field8=s, field4=r).
fn pf_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
// content-identified lookup: the proposal node for (s,r).
fn pf_find_proposal(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-998 && ng(W,n,4)==s && ng(W,n,28)==r){return n;}
    n=n+1;
  }
  return -1;
}
// alive DEP (type 1) edge from->to exists (dead slots carry from=-1).
fn pf_has_dep(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==1 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
// ============ cognition choke points (K1c audit) ============
// Every tuple the driver passes to cognition flows through one of these two.
// kind: 1=TEACH, 2=QUERY (masked), 3=OBSERVE (frozen counterexample
// protocol). Header field 52 (unused by the frozen core) counts audited events.
fn pf_event(W:[]u8,kind:i32,s:i32,r:i32,o:i32)i32 {
  if(kind<1 || kind>3){ emit("AUDIT_FAIL kind="); e64(kind); emit("\n"); return -999; }
  emit("EV "); e64(kind); emit(" "); e64(s); emit(" "); e64(r); emit(" "); e64(o);
  hs(W,52,hg(W,52)+1);
  if(kind==1){ let q:i32=ev_teach(W,s,r,o); emit("\n"); return q; }
  if(kind==2){ let a:i32=ev_query(W,s,r,-2,1); emit(" ans="); e64(a); emit("\n"); return a; }
  let v:i32=ev_observe(W,s,r,o); emit(" rv="); e64(v); emit("\n"); return v;
}
// Masked query: supervisor disconnected. Frozen parameters expected=-2,
// flags=1. Disclosed in the prereg; not a task label.
fn pf_mquery(W:[]u8,s:i32,r:i32)i32 {
  emit("EV 2 "); e64(s); emit(" "); e64(r); emit(" -2 MK");
  hs(W,52,hg(W,52)+1);
  let a:i32=ev_query(W,s,r,-2,1);
  emit(" ans="); e64(a); emit("\n");
  return a;
}
// ============ frozen phases (exact tuples from prereg section 3) ============
// NOVEL: 24 events. store_ans is a 6-slot i32 buf holding the 6 family-N
// integrate answers.
fn pf_novel(W:[]u8,store_ans:[]u8)void {
  emit("PHASE NOVEL\n");
  let i:i32=0;
  while(i<6){ pf_event(W,1,21001+i,511,22001+i); i=i+1; }
  i=0;
  while(i<6){ pf_event(W,1,23001+i,521,21001+i); i=i+1; }
  i=0;
  while(i<6){ set32(store_ans,i*4,pf_mquery(W,23001+i,522)); i=i+1; }
  i=0;
  while(i<6){ pf_event(W,1,24001+i,531,25001+i); i=i+1; }
  return;
}
// STORE_OK: 6/6 MAPs with alive DEP edge to the licensing chain fact, alive
// DEP edge to the licensing proposal node (TREAT), and the integrate query
// returning the chain value. On CONTROL there are no proposal nodes, so
// the proposal citation is checked only when one exists (the structural
// ordering check in SEALED_EVAL covers the TREAT provenance separately).
fn pf_store_ok(W:[]u8,store_ans:[]u8)void {
  let c:i32=0; let cp:i32=0; let i:i32=0;
  while(i<6){
    let m:i32=pf_find_map(W,23001+i,522);
    let f:i32=pf_find_fact(W,21001+i,511,22001+i);
    let p:i32=pf_find_proposal(W,23001+i,522);
    if(m>=0 && f>=0 && pf_has_dep(W,m,f)==1 && get32(store_ans,i*4)==22001+i){c=c+1;}
    else { emit("STORE_MISS N "); e64(i); emit("\n"); }
    if(m>=0 && p>=0 && pf_has_dep(W,m,p)==1){cp=cp+1;}
    i=i+1;
  }
  emit("STORE_OK "); e64(c); emit("/6\n");
  emit("STORE_PROP_CITE "); e64(cp); emit("/6\n");
  return;
}
// serving-node check: activate's node must be the content-expected live fact.
fn pf_serve_ok(W:[]u8,s:i32,r:i32,exp:i32,got:i32)i32 {
  if(got!=exp){return 0;}
  let n:i32=activate(W,s,r);
  if(n<2){return 0;}
  if(ng(W,n,36)!=1 || ng(W,n,0)!=1){return 0;}
  if(ng(W,n,20)!=s || ng(W,n,24)!=r || ng(W,n,28)!=exp){return 0;}
  if(is_superseded(W,n)==1){return 0;}
  return 1;
}
// CONFLICT: fact A taught, then contradictory observation B. Returns 1 iff
// the old fact is superseded (type-3 self-edge) and the new fact is live.
fn pf_conflict(W:[]u8)void {
  emit("PHASE CONFLICT\n");
  pf_event(W,1,26001,541,27001);
  let rv:i32=pf_event(W,3,26001,541,27002);
  let fa:i32=pf_find_fact(W,26001,541,27001);
  let fb:i32=pf_find_fact(W,26001,541,27002);
  let ok:i32=0;
  if(rv==0 && fa>=0 && is_superseded(W,fa)==1 && fb>=0 && is_superseded(W,fb)==0){ok=1;}
  emit("CONFLICT_OK "); e64(ok); emit("/1\n");
  return;
}
// CORRECTION: observation C supersedes B; the masked probe must return C
// served by the corrected fact.
fn pf_correction(W:[]u8)void {
  emit("PHASE CORRECTION\n");
  let rv:i32=pf_event(W,3,26001,541,27003);
  let a:i32=pf_mquery(W,26001,541);
  let fb:i32=pf_find_fact(W,26001,541,27002);
  let fc:i32=pf_find_fact(W,26001,541,27003);
  let ok:i32=0;
  if(rv==0 && fb>=0 && is_superseded(W,fb)==1 && pf_serve_ok(W,26001,541,27003,a)==1){ok=1;}
  emit("CORRECT_OK "); e64(ok); emit("/1\n");
  return;
}
// RETENTION: 12 probes of pre-conflict knowledge (concept + sanity).
fn pf_retention(W:[]u8)void {
  emit("PHASE RETENTION\n");
  let c:i32=0; let i:i32=0;
  while(i<6){
    let a:i32=pf_mquery(W,21001+i,511);
    if(pf_serve_ok(W,21001+i,511,22001+i,a)==1){c=c+1;}
    i=i+1;
  }
  i=0;
  while(i<6){
    let a:i32=pf_mquery(W,24001+i,531);
    if(pf_serve_ok(W,24001+i,531,25001+i,a)==1){c=c+1;}
    i=i+1;
  }
  emit("RETENTION_OK "); e64(c); emit("/12\n");
  return;
}
// One 12-probe delayed-reuse block (6 chain + 6 sanity), no re-teaching.
fn pf_delayed(W:[]u8)void {
  emit("PHASE DELAYED\n");
  let c:i32=0; let i:i32=0;
  while(i<6){
    let a:i32=pf_mquery(W,23001+i,522);
    if(pf_serve_ok(W,23001+i,522,22001+i,a)==1){c=c+1;}
    i=i+1;
  }
  i=0;
  while(i<6){
    let a:i32=pf_mquery(W,24001+i,531);
    if(pf_serve_ok(W,24001+i,531,25001+i,a)==1){c=c+1;}
    i=i+1;
  }
  emit("REUSE_OK "); e64(c); emit("/12\n");
  return;
}
// read-only mechanism census after a phase.
fn pf_census(W:[]u8,ph:[]u8)void {
  emit("CENSUS "); emit(ph);
  emit(" MAPC="); e64(pf_count_nodes(W,20));
  emit(" PROPC="); e64(pf_count_proposals(W));
  emit(" DEPC="); e64(pf_count_edges(W,1));
  emit(" UNC="); e64(pf_count_nodes(W,30));
  emit(" GUIDEC="); e64(pf_count_guides(W));
  emit(" N1="); e64(pf_count_nodes(W,1));
  emit(" Eall="); e64(pf_count_edges_all(W));
  emit("\n");
  return;
}
// ============ entry ============
fn pf_main()i32 {
  emit("MODE PF\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let store_ans:[]u8=z_alloc(24);
  pf_novel(W,store_ans);
  pf_census(W,"NOVEL");
  pf_store_ok(W,store_ans);
  pf_conflict(W);
  pf_census(W,"CONFLICT");
  pf_correction(W);
  pf_retention(W);
  pf_census(W,"RETENTION");
  let i:i32=0;
  emit("PHASE INTERFERE\n");
  while(i<24){ pf_event(W,1,28001+i,551,29001+i); i=i+1; }
  pf_delayed(W);
  pf_census(W,"DELAYED");
  emit("PROPC_FINAL "); e64(pf_count_proposals(W)); emit("\n");
  emit("UNCERT "); e64(pf_count_nodes(W,30)); emit("\n");
  emit("FNV "); e64(pf_fnv(W)); emit("\n");
  if(hg(W,52)==76){ emit("AUDIT_PASS\n"); }
  else { emit("AUDIT_FAIL count="); e64(hg(W,52)); emit(" want=76\n"); return 1; }
  return 0;
}
fn main()i32 { return pf_main(); }

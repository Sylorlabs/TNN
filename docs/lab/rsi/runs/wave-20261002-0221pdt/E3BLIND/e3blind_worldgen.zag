// e3blind_worldgen.zag -- E3BLIND sealed world generator. Pure Zag.
// Emits the exact byte streams frozen in PREREG_E3BLIND.md section 1.
// No cognition, no semantic cases, no modes: fixed strings only.
// Writes (relative to cwd): e3blind_worlds/e3c_blind.txt,
// e3blind_worlds/e3d_blind.txt, e3blind_worlds/e3c_oracle.txt,
// e3blind_worlds/e3d_oracle.txt, e3blind_oracles/e3c.oracle,
// e3blind_oracles/e3d.oracle

fn wput(path:[]u8, content:[]u8)i32 {
  if(_zag_write_file(path, content)!=0){ return 1; }
  return 0;
}

fn main()i32 {
  let c_blind:[]u8="OBSERVE 91301 91631 91961\nOBSERVE 91961 91632 91971\nOBSERVE 91302 91631 91962\nOBSERVE 91962 91632 91972\nOBSERVE 91301 91611 91911\nOBSERVE 91911 91612 91921\nOBSERVE 91302 91611 91912\nOBSERVE 91912 91612 91922\nQUERY 91301 91619\nQUERY 91302 91619\n";
  let d_blind:[]u8="OBSERVE 91401 91611 91911\nOBSERVE 91911 91612 91921\nOBSERVE 91402 91611 91912\nOBSERVE 91912 91612 91922\nOBSERVE 91401 91631 91961\nOBSERVE 91961 91632 91971\nOBSERVE 91402 91631 91962\nOBSERVE 91962 91632 91972\nQUERY 91401 91619\nQUERY 91402 91619\n";
  let c_oracle:[]u8="OBSERVE 91301 91631 91961\nOBSERVE 91961 91632 91971\nOBSERVE 91302 91631 91962\nOBSERVE 91962 91632 91972\nOBSERVE 91301 91611 91911\nOBSERVE 91911 91612 91921\nOBSERVE 91302 91611 91912\nOBSERVE 91912 91612 91922\nQUERY 91301 91619 91921\nQUERY 91302 91619 91922\n";
  let d_oracle:[]u8="OBSERVE 91401 91611 91911\nOBSERVE 91911 91612 91921\nOBSERVE 91402 91611 91912\nOBSERVE 91912 91612 91922\nOBSERVE 91401 91631 91961\nOBSERVE 91961 91632 91971\nOBSERVE 91402 91631 91962\nOBSERVE 91962 91632 91972\nQUERY 91401 91619 91921\nQUERY 91402 91619 91922\n";
  let c_sealed:[]u8="91921\n91922\n";
  let d_sealed:[]u8="91921\n91922\n";
  let bad:i32=0;
  bad=bad+wput("e3blind_worlds/e3c_blind.txt", c_blind);
  bad=bad+wput("e3blind_worlds/e3d_blind.txt", d_blind);
  bad=bad+wput("e3blind_worlds/e3c_oracle.txt", c_oracle);
  bad=bad+wput("e3blind_worlds/e3d_oracle.txt", d_oracle);
  bad=bad+wput("e3blind_oracles/e3c.oracle", c_sealed);
  bad=bad+wput("e3blind_oracles/e3d.oracle", d_sealed);
  if(bad!=0){ return 1; }
  return 0;
}

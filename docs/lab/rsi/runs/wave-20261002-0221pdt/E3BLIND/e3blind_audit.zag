// e3blind_audit.zag -- E3BLIND no-leak / no-smuggle audit. Pure Zag.
// Usage: e3blind_audit_bin <blind_world_file>
// Checks (prereg T5 / K2):
//  A. every non-blank line is OBSERVE with exactly 3 ints or QUERY
//     with exactly 2 ints (a 3rd QUERY field = FAIL: oracle smuggled);
//  B. the query relation 91619 never appears as an OBSERVE relation
//     (no supplied structure names the composite);
//  C. no other line tokens exist.
// Prints violations; exits 0 on AUDIT PASS, 1 on AUDIT FAIL.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn e64(v:i32)void {
  let r:[]u8=_zag_i64_to_str(v as i64);
  if(r.len>0 && r[r.len-1]==10){ emit(r[0..r.len-1]); } else { emit(r); }
  return;
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn is_observe(d:[]u8,s:i32)i32 {
  if(d[s]==79 && d[s+1]==66 && d[s+2]==83 && d[s+3]==69 && d[s+4]==82 && d[s+5]==86 && d[s+6]==69){ return 1; }
  return 0;
}
fn is_query(d:[]u8,s:i32)i32 {
  if(d[s]==81 && d[s+1]==85 && d[s+2]==69 && d[s+3]==82 && d[s+4]==89){ return 1; }
  return 0;
}

fn main()i32 {
  if(_zag_argc()!=2){ _zag_eprintln("usage: e3blind_audit_bin <blind_world_file>"); return 2; }
  let p:[]u8=_zag_arg(1);
  if(_zag_file_exists(p)==0){ _zag_eprintln("world missing"); return 2; }
  let d:[]u8=_zag_read_file(p);
  let n:i32=_zag_strlen(d);
  let bad:i32=0;
  let nobs:i32=0; let nqry:i32=0;
  let s:i32=0; let lineno:i32=0;
  while(s<n){
    let le:i32=line_end(d,s,n);
    lineno=lineno+1;
    let f0s:i32=skip_ws(d,s,le);
    if(f0s<le){
      let f0e:i32=field_end(d,f0s,le);
      let wl:i32=f0e-f0s;
      if(wl==7 && is_observe(d,f0s)==1){
        let s1:i32=skip_ws(d,f0e,le); let e1:i32=field_end(d,s1,le);
        let s2:i32=skip_ws(d,e1,le); let e2:i32=field_end(d,s2,le);
        let s3:i32=skip_ws(d,e2,le); let e3:i32=field_end(d,s3,le);
        if(s1>=le || s2>=le || s3>=le || skip_ws(d,e3,le)<le){ bad=bad+1; emit("BAD-OBSERVE line "); e64(lineno); emit("\n"); }
        else {
          if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){ bad=bad+1; emit("BAD-OBSERVE-INT line "); e64(lineno); emit("\n"); }
          else {
            let rel:i32=parse_i32(d,s2,e2);
            if(rel==91619){ bad=bad+1; emit("QUERY-REL-IN-OBSERVE line "); e64(lineno); emit("\n"); }
            nobs=nobs+1;
          }
        }
      } else {
        if(wl==5 && is_query(d,f0s)==1){
          let s1:i32=skip_ws(d,f0e,le); let e1:i32=field_end(d,s1,le);
          let s2:i32=skip_ws(d,e1,le); let e2:i32=field_end(d,s2,le);
          if(s1>=le || s2>=le || skip_ws(d,e2,le)<le){ bad=bad+1; emit("BAD-QUERY line "); e64(lineno); emit(" (third field or missing field: oracle smuggle)\n"); }
          else {
            if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0){ bad=bad+1; emit("BAD-QUERY-INT line "); e64(lineno); emit("\n"); }
            else { nqry=nqry+1; }
          }
        } else { bad=bad+1; emit("BAD-TOKEN line "); e64(lineno); emit("\n"); }
      }
    }
    s=le+1;
  }
  emit("OBSERVE-LINES "); e64(nobs); emit(" QUERY-LINES "); e64(nqry); emit("\n");
  if(bad==0){ emit("AUDIT PASS\n"); return 0; }
  emit("AUDIT FAIL violations="); e64(bad); emit("\n");
  return 1;
}

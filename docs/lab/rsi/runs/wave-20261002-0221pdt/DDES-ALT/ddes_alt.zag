// ddes_alt.zag -- DDES-ALT alternative-explanation attack (promotion step 6).
// Wave wave-20261002-0221pdt, lane DDES-ALT. Implements the frozen
// PREREG_DDES_ALT.md (committed alone at d64688fa6 before this file).
// Pure Zag. No Python.
//
// Three attacks on the DDES V2 t*=0 repair evidence:
//   H1: clamp-vacuity (is the FLAG marker cosmetic? does the clamp do
//       all decision-relevant work?).
//   H2: experiment-selection divergence between the guided derivation
//       and the frozen-spec unguided baseline on five fresh sealed
//       single-hop worlds.
//   H3: RT2 loud-failure provenance (contract x clamp, or DDES-side
//       detection?).
// Controlled DDES variants, derivation code otherwise unchanged:
//   variant 0 = V_full:     clamp max(t*,1) + FLAG emission.
//   variant 1 = V_nomarker: clamp kept, FLAG emission removed.
//   variant 2 = V_noclamp:  identity waits (hole re-opened), FLAG kept.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn emit_obs(o:i32)void {
  if(o==2){emit("OY");}
  else if(o==3){emit("OZ");}
  else if(o==0){emit("OX");}
  else {emit("NONE");}
  return;
}

// ============ generic arrival computation (frozen semantics) ============
fn compute_arrivals(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, out:[]u8)void {
  let INF:i32=268435456;
  let v:i32=0;
  while(v<n_vars){
    set32(out, v*4, INF);
    v=v+1;
  }
  if(use_set_x==1){
    set32(out, 0, 0);
  }
  let pass:i32=0;
  while(pass<n_vars){
    let i:i32=0;
    while(i<n_rules){
      let s:i32=get32(src, i*4);
      let d:i32=get32(dst, i*4);
      let w:i32=get32(delay, i*4);
      let as:i32=get32(out, s*4);
      if(as<INF){
        let cand:i32=as+w;
        let ad:i32=get32(out, d*4);
        if(cand<ad){
          set32(out, d*4, cand);
        }
      }
      i=i+1;
    }
    pass=pass+1;
  }
  return;
}

// ============ generic frontier computation (frozen semantics) ============
fn compute_frontier(arr0:[]u8, arr1:[]u8, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let v:i32=0;
  while(v<n_vars){
    let a0:i32=get32(arr0, v*4);
    let a1:i32=get32(arr1, v*4);
    if(a0!=a1){
      let t:i32=a0;
      if(a1<t){t=a1;}
      if(t<best_t){
        best_t=t;
        best_v=v;
      }
    }
    v=v+1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ wait-count policy (the controlled variant) ============
fn eff_waits(t_star:i32, variant:i32)i32 {
  if(variant==2){return t_star;}
  if(t_star<1){return 1;}
  return t_star;
}

// ============ generic plan synthesis (frozen semantics + variant) ============
fn synthesize_plan(v_star:i32, t_star:i32, use_set_x:i32, variant:i32, plan:[]u8, plans_built:[]u8)i32 {
  let len:i32=0;
  let cur_t:i32=0;
  if(use_set_x==1){
    plan[len]=0;
    len=len+1;
  }
  let w:i32=eff_waits(t_star, variant);
  while(cur_t<w){
    plan[len]=1;
    len=len+1;
    cur_t=cur_t+1;
  }
  let obs:i32=4-v_star;
  plan[len]=obs as u8;
  len=len+1;
  set32(plans_built, 0, get32(plans_built, 0)+1);
  return len;
}

fn emit_plan(plan:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    let a:i32=plan[i] as i32;
    if(a==0){emit("S");}
    else if(a==1){emit("W");}
    else if(a==2){emit("OY");}
    else{emit("OZ");}
    if(i<len-1){emit(",");}
    i=i+1;
  }
  emit("]");
  return;
}

// ============ generic predictor (frozen semantics + variant) ============
fn predict(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, v_star:i32, t_star:i32, variant:i32)i32 {
  let arr:[]u8=z_alloc(16);
  compute_arrivals(n_rules, src, dst, delay, n_vars, use_set_x, arr);
  let a:i32=get32(arr, v_star*4);
  let w:i32=eff_waits(t_star, variant);
  if(a<=w){return 1;}
  return 0;
}

// ============ sealed world simulator (frozen semantics) ============
fn world_step(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,16,get32(st,12));
  } else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    let pass:i32=0;
    while(pass<3){
      let r:i32=0;
      while(r<n_rules){
        let s:i32=get32(src, r*4);
        let d:i32=get32(dst, r*4);
        let w:i32=get32(delay, r*4);
        if(get32(st,s*4)==1){
          let ts:i32=get32(st,16+s*4);
          if(t-ts>=w){
            if(get32(st,d*4)==0){
              set32(st,d*4,1);
              set32(st,16+d*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else {
    obs=get32(st,4);
  }
  return obs;
}

// ============ one guided cell ============
// Returns packed i64: bit48=converge-ok, bit32=correct (true hypothesis
// is the survivor), bits16..31=wait count, bits0..15=obs action.
fn run_cell(attack:[]u8, world:[]u8, vname:[]u8, variant:i32, cfg:i32,
            n0:i32, s0:[]u8, d0:[]u8, w0:[]u8,
            n1:i32, s1:[]u8, d1:[]u8, w1:[]u8,
            plans_built:[]u8)i64 {
  emit("CELL "); emit(attack); emit(" "); emit(world); emit(" ");
  emit(vname); emit(" cfg"); e64(cfg); emit("\n");
  let n_vars:i32=3;
  let INF:i32=268435456;
  let tn:i32=n0;
  let ts:[]u8=s0; let td:[]u8=d0; let tw:[]u8=w0;
  if(cfg==1){
    tn=n1; ts=s1; td=d1; tw=w1;
  }
  let best_found:i32=0;
  let best_v:i32=-1;
  let best_t:i32=INF;
  let best_schema:i32=-1;
  let schema:i32=1;
  while(schema>=0){
    let a0:[]u8=z_alloc(16);
    let a1:[]u8=z_alloc(16);
    compute_arrivals(n0, s0, d0, w0, n_vars, schema, a0);
    compute_arrivals(n1, s1, d1, w1, n_vars, schema, a1);
    let f:[]u8=z_alloc(4);
    let fv:[]u8=z_alloc(4);
    let ft:[]u8=z_alloc(4);
    compute_frontier(a0, a1, n_vars, f, fv, ft);
    if(get32(f,0)==1){
      let t:i32=get32(ft,0);
      if(t<best_t){
        best_t=t;
        best_v=get32(fv,0);
        best_schema=schema;
        best_found=1;
      }
    }
    schema=schema-1;
  }
  let ok:i64=0;
  let correct:i64=0;
  let waits:i64=0;
  let obs:i64=0;
  if(best_found==0){
    emit("NO-DISCRIMINATING-PLAN\n");
  } else {
    emit("TARGET V*="); e64(best_v); emit(" t*="); e64(best_t);
    emit(" schema="); e64(best_schema); emit("\n");
    if(best_t==0){
      if(variant!=1){
        emit("FLAG TSTAR-ZERO-BOUNDARY floor=1\n");
      }
    }
    let plan:[]u8=z_alloc(64);
    let plen:i32=synthesize_plan(best_v, best_t, best_schema, variant, plan, plans_built);
    let j:i32=0;
    while(j<plen){
      let pa:i32=plan[j] as i32;
      if(pa==1){waits=waits+1;}
      else if(pa>=2){obs=pa as i64;}
      j=j+1;
    }
    emit("PLAN "); emit_plan(plan, plen); emit("\n");
    let st:[]u8=z_alloc(32);
    let real_obs:i32=-1;
    let k:i32=0;
    while(k<plen){
      let o:i32=world_step(tn, ts, td, tw, st, plan[k] as i32);
      if(o>=0){real_obs=o;}
      k=k+1;
    }
    emit("EXEC real="); e64(real_obs); emit("\n");
    let p0:i32=predict(n0, s0, d0, w0, n_vars, best_schema, best_v, best_t, variant);
    let p1:i32=predict(n1, s1, d1, w1, n_vars, best_schema, best_v, best_t, variant);
    emit("PRED h0="); e64(p0); emit(" h1="); e64(p1); emit("\n");
    if(p0!=real_obs){emit("ELIM h0\n");} else {emit("SURVIVE h0\n");}
    if(p1!=real_obs){emit("ELIM h1\n");} else {emit("SURVIVE h1\n");}
    let cok:i32=1;
    if(p0==p1){cok=0;}
    let m0:i32=0; let m1:i32=0;
    if(p0==real_obs){m0=1;}
    if(p1==real_obs){m1=1;}
    if(m0+m1!=1){cok=0;}
    if(cok==1){emit("CONVERGE-OK\n");} else {emit("CONVERGE-FAIL\n");}
    ok=cok as i64;
    if(cok==1){
      if(cfg==0){
        if(p0==real_obs){if(p1!=real_obs){correct=1;}}
      } else {
        if(p1==real_obs){if(p0!=real_obs){correct=1;}}
      }
    }
  }
  emit("CELLEND\n");
  return (ok<<48)|(correct<<32)|(waits<<16)|obs;
}

// Fill rule tables: (nr, ruleA(src,dst,delay), ruleB(src,dst,delay)).
fn mk(n:[]u8, s:[]u8, d:[]u8, w:[]u8, nr:i32,
      sa:i32, da:i32, la:i32, sb:i32, db:i32, lb:i32)void {
  set32(n,0,nr);
  if(nr>=1){
    set32(s,0,sa); set32(d,0,da); set32(w,0,la);
  }
  if(nr>=2){
    set32(s,4,sb); set32(d,4,db); set32(w,4,lb);
  }
  return;
}

// Both configs of one (attack, world, variant) cell, then CELLSUM.
fn cell2(attack:[]u8, world:[]u8, vname:[]u8, variant:i32,
         nr0:i32, ha0:i32,hb0:i32,hc0:i32, hd0:i32,he0:i32,hf0:i32,
         nr1:i32, ha1:i32,hb1:i32,hc1:i32, hd1:i32,he1:i32,hf1:i32,
         plans_built:[]u8)void {
  let n0:[]u8=z_alloc(4); let s0:[]u8=z_alloc(32);
  let dd0:[]u8=z_alloc(32); let w0:[]u8=z_alloc(32);
  let n1:[]u8=z_alloc(4); let s1:[]u8=z_alloc(32);
  let dd1:[]u8=z_alloc(32); let w1:[]u8=z_alloc(32);
  mk(n0,s0,dd0,w0, nr0, ha0,hb0,hc0, hd0,he0,hf0);
  mk(n1,s1,dd1,w1, nr1, ha1,hb1,hc1, hd1,he1,hf1);
  let r0:i64=run_cell(attack, world, vname, variant, 0,
                      get32(n0,0),s0,dd0,w0, get32(n1,0),s1,dd1,w1, plans_built);
  let r1:i64=run_cell(attack, world, vname, variant, 1,
                      get32(n0,0),s0,dd0,w0, get32(n1,0),s1,dd1,w1, plans_built);
  let ok0:i64=(r0>>48)&1; let good0:i64=(r0>>32)&1;
  let ok1:i64=(r1>>48)&1; let good1:i64=(r1>>32)&1;
  let wts0:i64=(r0>>16)&65535; let ob0:i64=r0&65535;
  let wts1:i64=(r1>>16)&65535; let ob1:i64=r1&65535;
  emit("CELLSUM "); emit(attack); emit(" "); emit(world); emit(" ");
  emit(vname);
  emit(" ok0="); e64(ok0 as i32); emit(" ok1="); e64(ok1 as i32);
  let verdict:[]u8="LOUD-FAIL";
  if(ok0==1){
    if(ok1==1){
      if(good0==1){
        if(good1==1){verdict="CORRECT";}
        else {verdict="SILENT-WRONG";}
      } else {verdict="SILENT-WRONG";}
    }
  }
  emit(" VERDICT="); emit(verdict);
  emit(" waits0="); e64(wts0 as i32); emit(" obs0="); emit_obs(ob0 as i32);
  emit(" waits1="); e64(wts1 as i32); emit(" obs1="); emit_obs(ob1 as i32);
  emit("\n");
  return;
}

// ============ frozen-spec baseline (unguided random synthesis) ============
// xorshift32, seed 14500418 = 0x00DD4242. 9 shapes ([S] + 0..2 waits +
// OX/OY/OZ). B=64 draws, first discriminating candidate wins.
// Simulator semantics identical to the frozen baseline (single-hop
// worlds: identical to the DDES stepper above).
fn rng_next(x:i32)i32 {
  let v:i64=x as i64;
  v=v^(v<<13);
  v=v^(v>>17);
  v=v^(v<<5);
  v=v&4294967295;
  return v as i32;
}

fn sim(n:i32, s0:i32, d0:i32, l0:i32, s1:i32, d1:i32, l1:i32, w:i32, obs:i32)i32 {
  let v:i32=1;
  let t:i32=1;
  while(t<=w){
    let changed:i32=1;
    while(changed==1){
      changed=0;
      if(n>=1){
        if(((v>>s0)&1)==1){
          if(t>=l0){
            if(((v>>d0)&1)==0){ v=v|(1<<d0); changed=1; }
          }
        }
      }
      if(n>=2){
        if(((v>>s1)&1)==1){
          if(t>=l1){
            if(((v>>d1)&1)==0){ v=v|(1<<d1); changed=1; }
          }
        }
      }
    }
    t=t+1;
  }
  return (v>>obs)&1;
}

fn print_plan(w:i32, obs:i32)void {
  emit("[S");
  let i:i32=0;
  while(i<w){ emit(",W"); i=i+1; }
  if(obs==0){ emit(",OX"); }
  if(obs==1){ emit(",OZ"); }
  if(obs==2){ emit(",OY"); }
  emit("]");
  return;
}

fn emit_bobs(o:i32)void {
  if(o==0){emit("OX");}
  else if(o==1){emit("OZ");}
  else if(o==2){emit("OY");}
  else {emit("NONE");}
  return;
}

// One baseline cell. Returns packed i64: low32=seed, bits32..61=evals,
// bit62=1 iff CORRECT, bit63=1 iff SILENT-WRONG (else LOUD-FAIL).
fn run_bcell(name:[]u8,
  n0:i32, a0:i32, b0:i32, c0:i32, d0:i32, e0:i32, f0:i32,
  n1:i32, g0:i32, h0:i32, i0:i32, j0:i32, k0:i32, l0:i32,
  seed_in:i32, evals_in:i32)i64 {
  emit("BCELL "); emit(name); emit("\n");
  let seed:i32=seed_in;
  let evals:i32=evals_in;
  let found:i32=0;
  let fw:i32=0;
  let fobs:i32=-1;
  let fdraw:i32=-1;
  let fp0:i32=0;
  let fp1:i32=0;
  let draw_i:i32=0;
  while(draw_i<64){
    seed=rng_next(seed);
    let u:i64=(seed as i64)&4294967295;
    let idx:i32=(u%9) as i32;
    let w:i32=idx/3;
    let obs:i32=idx-(w*3);
    let p0:i32=sim(n0, a0,b0,c0, d0,e0,f0, w, obs);
    let p1:i32=sim(n1, g0,h0,i0, j0,k0,l0, w, obs);
    evals=evals+1;
    if(p0!=p1){
      found=1; fw=w; fobs=obs; fdraw=draw_i; fp0=p0; fp1=p1;
      draw_i=64;
    }
    draw_i=draw_i+1;
  }
  let vkind:i64=0;
  if(found==0){
    emit("NO-DISCRIMINATING-PLAN\n");
    emit("BVERDICT LOUD-FAIL\n");
  } else {
    emit("BPLAN ");
    print_plan(fw, fobs);
    emit(" draw=");
    e64(fdraw);
    emit(" pred_h0=");
    e64(fp0);
    emit(" pred_h1=");
    e64(fp1);
    emit("\n");
    let real0:i32=sim(n0, a0,b0,c0, d0,e0,f0, fw, fobs);
    emit("BEXEC cfg0 real=");
    e64(real0);
    emit("\n");
    let ok0:i32=0;
    if(real0==fp0){
      if(real0!=fp1){ emit("BSURVIVE h0 BELIM h1\n"); ok0=1; }
    }
    let real1:i32=sim(n1, g0,h0,i0, j0,k0,l0, fw, fobs);
    emit("BEXEC cfg1 real=");
    e64(real1);
    emit("\n");
    let ok1:i32=0;
    if(real1==fp1){
      if(real1!=fp0){ emit("BELIM h0 BSURVIVE h1\n"); ok1=1; }
    }
    if(ok0==1){
      if(ok1==1){
        emit("BVERDICT CORRECT\n");
        vkind=1;
      }
    }
    if(vkind==0){
      emit("BVERDICT SILENT-WRONG\n");
      vkind=2;
    }
  }
  emit("BCELLSUM "); emit(name);
  if(found==0){
    emit(" VERDICT=LOUD-FAIL PLAN=NONE");
  } else {
    emit(" VERDICT=");
    if(vkind==1){emit("CORRECT");} else {emit("SILENT-WRONG");}
    emit(" PLAN=");
    print_plan(fw, fobs);
  }
  emit(" draws="); e64(fdraw);
  emit(" evals_this="); e64(evals-evals_in);
  emit("\n");
  let packed:i64=(seed as i64)&4294967295;
  packed=packed|((evals as i64)<<32);
  if(vkind==1){ packed=packed|((1 as i64)<<62); }
  if(vkind==2){ packed=packed|((1 as i64)<<63); }
  return packed;
}

// ============ main: the three attack matrices ============
fn main()i32 {
  let plans_built:[]u8=z_alloc(4);

  // ---- H1: clamp-vacuity attack ----
  // P: H0=[(X,Y,0),(X,Z,9)] H1=[(X,Y,4),(X,Z,9)] (t*=0, decoy rule).
  cell2("H1","P","full",0,
        2, 0,2,0, 0,1,9,
        2, 0,2,4, 0,1,9,
        plans_built);
  cell2("H1","P","nomarker",1,
        2, 0,2,0, 0,1,9,
        2, 0,2,4, 0,1,9,
        plans_built);
  cell2("H1","P","noclamp",2,
        2, 0,2,0, 0,1,9,
        2, 0,2,4, 0,1,9,
        plans_built);
  // Q: H0=[(X,Y,1)] H1=[(X,Y,3)] (t*=1, clamp is the identity).
  cell2("H1","Q","full",0,
        1, 0,2,1, 0,0,0,
        1, 0,2,3, 0,0,0,
        plans_built);

  // ---- H2: guided derivation on the five fresh worlds ----
  // W1: H0=[(X,Y,0)] H1=[(X,Y,2)]
  cell2("H2","W1","full",0,
        1, 0,2,0, 0,0,0,
        1, 0,2,2, 0,0,0,
        plans_built);
  // W2: H0=[(X,Y,3)] H1=[(X,Y,5)]
  cell2("H2","W2","full",0,
        1, 0,2,3, 0,0,0,
        1, 0,2,5, 0,0,0,
        plans_built);
  // W4: H0=[(X,Y,1),(X,Z,0)] H1=[(X,Y,2),(X,Z,3)]
  cell2("H2","W4","full",0,
        2, 0,2,1, 0,1,0,
        2, 0,2,2, 0,1,3,
        plans_built);
  // W5: H0=[(X,Z,4)] H1=[(X,Z,6)]
  cell2("H2","W5","full",0,
        1, 0,1,4, 0,0,0,
        1, 0,1,6, 0,0,0,
        plans_built);
  // W5p: H0=[(X,Y,2),(X,Z,0)] H1=[(X,Y,2),(X,Z,2)]
  cell2("H2","W5p","full",0,
        2, 0,2,2, 0,1,0,
        2, 0,2,2, 0,1,2,
        plans_built);

  // ---- H2: frozen-spec baseline on the same five worlds ----
  let seed:i32=14500418;
  let evals:i32=0;
  let bc:i32=0; let bl:i32=0; let bs:i32=0;
  let p:i64=run_bcell("W1",
        1, 0,2,0, 0,0,0,
        1, 0,2,2, 0,0,0, seed, evals);
  seed=p as i32; evals=((p>>32)&1073741823) as i32;
  if(((p>>62)&1)==1){bc=bc+1;}
  else if(((p>>63)&1)==1){bs=bs+1;}
  else {bl=bl+1;}
  p=run_bcell("W2",
        1, 0,2,3, 0,0,0,
        1, 0,2,5, 0,0,0, seed, evals);
  seed=p as i32; evals=((p>>32)&1073741823) as i32;
  if(((p>>62)&1)==1){bc=bc+1;}
  else if(((p>>63)&1)==1){bs=bs+1;}
  else {bl=bl+1;}
  p=run_bcell("W4",
        2, 0,2,1, 0,1,0,
        2, 0,2,2, 0,1,3, seed, evals);
  seed=p as i32; evals=((p>>32)&1073741823) as i32;
  if(((p>>62)&1)==1){bc=bc+1;}
  else if(((p>>63)&1)==1){bs=bs+1;}
  else {bl=bl+1;}
  p=run_bcell("W5",
        1, 0,1,4, 0,0,0,
        1, 0,1,6, 0,0,0, seed, evals);
  seed=p as i32; evals=((p>>32)&1073741823) as i32;
  if(((p>>62)&1)==1){bc=bc+1;}
  else if(((p>>63)&1)==1){bs=bs+1;}
  else {bl=bl+1;}
  p=run_bcell("W5p",
        2, 0,2,2, 0,1,0,
        2, 0,2,2, 0,1,2, seed, evals);
  seed=p as i32; evals=((p>>32)&1073741823) as i32;
  if(((p>>62)&1)==1){bc=bc+1;}
  else if(((p>>63)&1)==1){bs=bs+1;}
  else {bl=bl+1;}
  emit("BSUMMARY correct="); e64(bc);
  emit(" loud_fail="); e64(bl);
  emit(" silent_wrong="); e64(bs);
  emit(" candidates_evaluated="); e64(evals);
  emit("\n");

  // ---- H3: RT2 loud-failure provenance ----
  // RT2a: frozen contract H0=[(X,Y,1)] H1=[(X,Y,0)], V_full.
  cell2("H3","RT2a","full",0,
        1, 0,2,1, 0,0,0,
        1, 0,2,0, 0,0,0,
        plans_built);
  // RT2b: widened gap H0=[(X,Y,2)] H1=[(X,Y,0)], V_full.
  cell2("H3","RT2b","full",0,
        1, 0,2,2, 0,0,0,
        1, 0,2,0, 0,0,0,
        plans_built);
  // RT2c: same gap shifted off the boundary H0=[(X,Y,2)] H1=[(X,Y,1)].
  cell2("H3","RT2c","full",0,
        1, 0,2,2, 0,0,0,
        1, 0,2,1, 0,0,0,
        plans_built);
  // RT2d: frozen contract, clamp removed.
  cell2("H3","RT2d","noclamp",2,
        1, 0,2,1, 0,0,0,
        1, 0,2,0, 0,0,0,
        plans_built);

  emit("PLANSBUILT "); e64(get32(plans_built,0)); emit("\n");
  return 0;
}

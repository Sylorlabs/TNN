// ==== H5R2-SYNTH DT FRAGMENT (frozen post-prereg; pure Zag) ====
// Tied-provenance discrimination-trial world family for lane HPI,
// wave-20261002-0221pdt (PREREG_H5R2_SYNTH.md section 5).
// Appended after the frozen DRIVER_TMPL.zag; uses its helpers
// (h5r2_map_live_n, h5r2_map_live_id, h5r2_map_con_all, h5r2_dump) and
// the substrate (ev_teach, ev_query, is_superseded, emit, e64, z_alloc,
// WSZ, tnn2_init, ng, eg).
// Per DT probe: teach two competing 2-hop readings (s,R1,m1),
// (m1,R2,o1) first-taught and (s,R3,m2), (m2,R4,o2) later-taught;
// masked query (flags=1: the E-ruling, expected is post-hoc feedback
// only; the candidate-selection policy, not the verifier, decides the
// anchor); arm-neutral DT-check on the live MAP. No OBSERVE on any key
// in any DT world. Key ranges 93xxx-94xxx.

// id of the single live tag-1 non-superseded fact on (sm,rm); -1
// unless exactly one
fn dt_fact_live_id(W:[]u8,sm:i32,rm:i32)i32 {
  let id:i32=-1; let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==sm && ng(W,n,24)==rm && is_superseded(W,n)==0){id=n; c=c+1;}
    n=n+1;
  }
  if(c!=1){return -1;}
  return id;
}
// One DT probe: two competing 2-hop readings, masked query,
// arm-neutral DT-check. Returns 1 iff every conjunct passes.
fn dt_probe(W:[]u8,s:i32,m1:i32,m2:i32,r1:i32,r2:i32,r3:i32,r4:i32,rm:i32,o1:i32,o2:i32,tag:[]u8)i32 {
  ev_teach(W,s,r1,m1);
  ev_teach(W,m1,r2,o1);
  ev_teach(W,s,r3,m2);
  ev_teach(W,m2,r4,o2);
  let fa:i32=dt_fact_live_id(W,s,r1);
  let fb:i32=dt_fact_live_id(W,m1,r2);
  let fc:i32=dt_fact_live_id(W,s,r3);
  let fd:i32=dt_fact_live_id(W,m2,r4);
  if(fa<0 || fb<0 || fc<0 || fd<0){emit(tag); emit(" DT-BROKEN-FAIL\n"); return 0;}
  let v:i32=ev_query(W,s,rm,-2,1);
  let id:i32=h5r2_map_live_id(W,s,rm);
  let mc:i32=h5r2_map_live_n(W,s,rm);
  let f28:i32=-999999;
  if(id>=0){f28=ng(W,id,28);}
  emit(tag); emit(" Q v="); e64(v);
  emit(" livemap="); e64(mc); emit(" id="); e64(id); emit(" f28="); e64(f28); emit("\n");
  if(v==-2){emit(tag); emit(" DT-MISS\n"); return 0;}
  if(mc!=1 || id<0){emit(tag); emit(" DT-MAP-FAIL\n"); return 0;}
  let e:i32=0; let dep:i32=0; let depok:i32=1;
  let hita:i32=0; let hitb:i32=0; let hitc:i32=0; let hitd:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==id && eg(W,e,4)==1){
      dep=dep+1;
      let t:i32=eg(W,e,8);
      emit(tag); emit(" DT dep->"); e64(t);
      emit(" tag="); e64(ng(W,t,0)); emit(" o="); e64(ng(W,t,28));
      emit(" sup="); e64(is_superseded(W,t)); emit("\n");
      if(ng(W,t,36)!=1 || ng(W,t,0)!=1 || is_superseded(W,t)==1){depok=0;}
      if(t==fa){hita=1;} else {if(t==fb){hitb=1;} else {if(t==fc){hitc=1;} else {if(t==fd){hitd=1;} else {depok=0;}}}}
    }
    e=e+1;
  }
  if(dep!=2 || depok==0){emit(tag); emit(" DT-DEP-FAIL\n"); return 0;}
  if(f28!=v){emit(tag); emit(" DT-VAL-FAIL\n"); return 0;}
  if(hita==1 && hitb==1 && f28==o1 && v==o1){emit(tag); emit(" DT-FIRST\n");}
  else {
    if(hitc==1 && hitd==1 && f28==o2 && v==o2){emit(tag); emit(" DT-LATER\n");}
    else {emit(tag); emit(" DT-VAL-FAIL\n"); return 0;}
  }
  emit(tag); emit(" DT ok\n");
  return 1;
}
// world t1: chain 9301/9302/9303/9304, MAP 9305. vo=4.
fn sealed_main_t1()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(dt_probe(W,93101,93301,93351,9301,9302,9303,9304,9305,93405,93406,"T1P1")==0){ok=0;}
  if(dt_probe(W,93102,93302,93352,9301,9302,9303,9304,9305,93415,93416,"T1P2")==0){ok=0;}
  if(dt_probe(W,93103,93303,93353,9301,9302,9303,9304,9305,93425,93426,"T1P3")==0){ok=0;}
  if(dt_probe(W,93104,93304,93354,9301,9302,9303,9304,9305,93435,93436,"T1P4")==0){ok=0;}
  let mc:i32=h5r2_map_con_all(W);
  emit("T1 MAPCON-ALL="); e64(mc); emit("\n");
  if(mc!=0){emit("T1 NC-CON-FAIL\n"); ok=0;}
  if(ok==1){emit("T1 DONE-OK\n");} else {emit("T1 DONE-FAIL\n");}
  h5r2_dump(W);
  return ok;
}
// world t2: chain 9401/9402/9403/9404, MAP 9405. vo=3.
// Materially different relation family and subject distribution from t1.
fn sealed_main_t2()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(dt_probe(W,94101,94301,94351,9401,9402,9403,9404,9405,94404,94405,"T2P1")==0){ok=0;}
  if(dt_probe(W,94102,94302,94352,9401,9402,9403,9404,9405,94414,94415,"T2P2")==0){ok=0;}
  if(dt_probe(W,94103,94303,94353,9401,9402,9403,9404,9405,94424,94425,"T2P3")==0){ok=0;}
  if(dt_probe(W,94104,94304,94354,9401,9402,9403,9404,9405,94434,94435,"T2P4")==0){ok=0;}
  let mc:i32=h5r2_map_con_all(W);
  emit("T2 MAPCON-ALL="); e64(mc); emit("\n");
  if(mc!=0){emit("T2 NC-CON-FAIL\n"); ok=0;}
  if(ok==1){emit("T2 DONE-OK\n");} else {emit("T2 DONE-FAIL\n");}
  h5r2_dump(W);
  return ok;
}

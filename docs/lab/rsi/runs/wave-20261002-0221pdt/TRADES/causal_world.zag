// causal_world.zag -- sealed causal intervention world generator (TRADES-1).
// Usage: causal_world.zag gen <seed> <outdir>
// Writes pre.jsonl (cbrief + 12 cobs turns), int_table.tsv
// (10 traces x 6 interventions, precomputed outcomes), key.json.
// Pure Zag. Deterministic given seed.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn rng_next(rng:[]u8)i64 {
  let s:i64=(rng[0] as i64)|((rng[1] as i64)<<8)|((rng[2] as i64)<<16)|((rng[3] as i64)<<24)|((rng[4] as i64)<<32)|((rng[5] as i64)<<40)|((rng[6] as i64)<<48)|((rng[7] as i64)<<56);
  s=s*6364136223846793005+1442695040888963407;
  rng[0]=(s as u8); rng[1]=((s>>8) as u8); rng[2]=((s>>16) as u8); rng[3]=((s>>24) as u8);
  rng[4]=((s>>32) as u8); rng[5]=((s>>40) as u8); rng[6]=((s>>48) as u8); rng[7]=((s>>56) as u8);
  return s;
}
fn rng_range(rng:[]u8,n:i64)i64 {
  let r:i64=rng_next(rng)%n;
  if(r<0){r=-r;}
  return r;
}
// Proper random bit (bit 33). rng_range(rng,2) strictly alternates 0,1,0,1
// because the LCG constants are odd (found in dev calibration); it is NOT
// usable as a random bit.
fn rng_bit(rng:[]u8)i32 {
  let s:i64=rng_next(rng);
  return ((s>>33)&1) as i32;
}
fn rng_seed(rng:[]u8,seed:i64)void {
  let s:i64=seed;
  rng[0]=(s as u8); rng[1]=((s>>8) as u8); rng[2]=((s>>16) as u8); rng[3]=((s>>24) as u8);
  rng[4]=((s>>32) as u8); rng[5]=((s>>40) as u8); rng[6]=((s>>48) as u8); rng[7]=((s>>56) as u8);
  return;
}
fn varpos(h:[]u8,V:i32)i32 {
  let p:i32=0;
  while(p<3 && h[p]!=V){p=p+1;}
  return p;
}
// Forward model (frozen): do(V=v); V and downstream take v; upstream takes b.
// out[var] for var 0..2 (x,y,z order).
fn sim(h:[]u8,V:i32,v:i32,b:i32,out:[]u8)void {
  let p:i32=varpos(h,V);
  let var:i32=0;
  while(var<3){
    if(varpos(h,var)>=p){out[var]=v as u8;} else {out[var]=b as u8;}
    var=var+1;
  }
  return;
}
fn ik_v(k:i32)i32 {
  if(k==0||k==1){return 0;}
  if(k==2||k==3){return 1;}
  return 2;
}
fn ik_w(k:i32)i32 {
  if(k==0||k==2||k==4){return 0;}
  return 1;
}
fn main()i32 {
  let a1:[]u8=_zag_arg(1);
  if(slen(a1)<3 || streq(a1[0..3],"gen")!=1){
    emit("usage: causal_world.zag gen <seed> <outdir>\n");
    return 1;
  }
  let seed:i64=0;
  let sa:[]u8=_zag_arg(2);
  let si:i32=0;
  while(si<sa.len && sa[si]>=48 && sa[si]<=57){seed=seed*10+(sa[si] as i64)-48;si=si+1;}
  let outdir:[]u8=_zag_arg(3);
  if(outdir.len==0){emit("missing outdir\n");return 1;}
  // ---- draw chain: Fisher-Yates on [0,1,2] ----
  let wr:[]u8=z_alloc(8);
  rng_seed(wr,seed);
  let chain:[]u8=z_alloc(3);
  chain[0]=0;chain[1]=1;chain[2]=2;
  let i2:i32=2;
  while(i2>0){
    let j:i32=rng_range(wr,(i2+1) as i64) as i32;
    let t:u8=chain[i2];chain[i2]=chain[j];chain[j]=t;
    i2=i2-1;
  }
  // ---- 12 co-movement observations ----
  let obs:[]u8=z_alloc(12);
  let i:i32=0;
  while(i<12){
    let b:i32=rng_bit(wr);
    obs[i]=b as u8;
    i=i+1;
  }
  // ---- pre.jsonl ----
  let pre:[]u8=z_alloc(8192);
  let at:i32=0;
  at=app(pre,at,"{\"turn\":0,\"kind\":\"cbrief\",\"vars\":[\"X\",\"Y\",\"Z\"],\"n_traces\":10,\"int_per_trace\":3}\n");
  let turn:i32=1;
  i=0;
  while(i<12){
    let b:i32=obs[i] as i32;
    at=app(pre,at,"{\"turn\":"); at=app(pre,at,i64s(turn as i64));
    at=app(pre,at,",\"kind\":\"cobs\",\"ev\":{\"t\":\"c\",\"x\":"); at=app(pre,at,i64s(b as i64));
    at=app(pre,at,",\"y\":"); at=app(pre,at,i64s(b as i64));
    at=app(pre,at,",\"z\":"); at=app(pre,at,i64s(b as i64));
    at=app(pre,at,"}}\n");
    turn=turn+1; i=i+1;
  }
  let fd:i64=w_open(pjoin(outdir,"pre.jsonl"));
  w_write(fd,pre[0..at]); w_close(fd);
  // ---- int_table.tsv: 10 traces x 6 interventions ----
  let tab:[]u8=z_alloc(8192);
  at=0;
  let t:i32=0;
  while(t<10){
    let w2:[]u8=z_alloc(8);
    rng_seed(w2,seed*131+(t as i64)*17+1);
    let k:i32=0;
    while(k<6){
      let b:i32=rng_bit(w2);
      let o:[]u8=z_alloc(3);
      sim(chain,ik_v(k),ik_w(k),b,o);
      at=app(tab,at,i64s(t as i64)); at=app(tab,at," ");
      at=app(tab,at,i64s(k as i64)); at=app(tab,at," ");
      at=app(tab,at,i64s(o[0] as i64)); at=app(tab,at," ");
      at=app(tab,at,i64s(o[1] as i64)); at=app(tab,at," ");
      at=app(tab,at,i64s(o[2] as i64)); at=app(tab,at,"\n");
      k=k+1;
    }
    t=t+1;
  }
  fd=w_open(pjoin(outdir,"int_table.tsv"));
  w_write(fd,tab[0..at]); w_close(fd);
  // ---- key.json ----
  let vn:[]u8="XYZ";
  let key:[]u8=z_alloc(256);
  at=0;
  at=app(key,at,"{\"chain\":\"");
  at=app(key,at,vn[(chain[0] as i32)..(chain[0] as i32)+1]); at=app(key,at,"->");
  at=app(key,at,vn[(chain[1] as i32)..(chain[1] as i32)+1]); at=app(key,at,"->");
  at=app(key,at,vn[(chain[2] as i32)..(chain[2] as i32)+1]);
  at=app(key,at,"\",\"seed\":"); at=app(key,at,i64s(seed));
  at=app(key,at,"}\n");
  fd=w_open(pjoin(outdir,"key.json"));
  w_write(fd,key[0..at]); w_close(fd);
  emit("world seed "); emit(i64s(seed)); emit(": 12 obs + 60 outcomes, key written\n");
  return 0;
}

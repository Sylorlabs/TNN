// f1f_diag.zag - POST-HOC DIAGNOSTIC ONLY (not the frozen metric).
// For REDTEAM_SELF.md: groups seeds by OP/OPERAND-ONLY normalized
// sequences (err transitions dropped) to assess how much of the frozen
// D metric is driven by eb/ea magnitude noise vs structural (op/operand)
// differences. Usage: f1f_diag <manifest> (same manifest as f1f_analyze).
// Pure Zag, compiled by the pinned znc.

fn fd_alloc(n:i64)[]u8 {
    if(n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn fd_ig(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn fd_is(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

fn fd_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn fd_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn fd_has_prefix(tok:[]u8, pre:[]u8)bool {
    if(tok.len < pre.len) { return false; }
    let i:i64 = 0;
    while(i < pre.len) {
        if(tok[i] != pre[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn fd_after_eq(tok:[]u8)[]u8 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return ""; }
    return tok[p+1..tok.len];
}

fn fd_field(line:[]u8, name:[]u8)[]u8 {
    let nt:i64 = fd_ntok(line);
    let i:i64 = 0;
    while(i < nt) {
        let t:[]u8 = fd_tok(line, i);
        if(fd_has_prefix(t, name)) { return fd_after_eq(t); }
        i = i + 1;
    }
    return "";
}

fn fd_oclass(v:i64)i64 {
    if(v == 0) { return 0; }
    if(v == 8) { return 1; }
    if(v == 9) { return 2; }
    return 3;
}

fn main()i32 {
    if(_zag_argc() < 2) { _zag_println("usage: f1f_diag <manifest>"); return 2; }
    let mtext:[]u8 = _zag_read_file(_zag_arg(1));
    if(mtext.len == 0) { _zag_println("ERR manifest read"); return 2; }
    let maxs:i64 = 40;
    let maxe:i64 = 32;
    let c_ncons:[]u8 = fd_alloc(maxs * 8);
    let c_accn:[]u8 = fd_alloc(maxs * 8);
    let c_idx:[]u8 = fd_alloc(maxs * 8);
    let ne:i64 = maxs * maxe;
    let e_opoff:[]u8 = fd_alloc(ne * 8);
    let e_oplen:[]u8 = fd_alloc(ne * 8);
    let e_c1:[]u8 = fd_alloc(ne * 8);
    let e_c2:[]u8 = fd_alloc(ne * 8);
    let e_c3:[]u8 = fd_alloc(ne * 8);
    let pool:[]u8 = fd_alloc(65536);
    let poolp:i64 = 0;
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < mtext.len) {
        let q:i64 = p;
        while(q < mtext.len && mtext[q] != 10) { q = q + 1; }
        let line:[]u8 = mtext[p..q];
        if(q < mtext.len) { q = q + 1; }
        p = q;
        if(line.len == 0 || n >= maxs) { continue; }
        let tp:[]u8 = fd_tok(line, 3);
        if(tp.len == 0) { continue; }
        fd_is(c_idx, n, _zag_str_to_i64(fd_tok(line, 0)));
        fd_is(c_accn, n, _zag_str_to_i64(fd_tok(line, 1)));
        fd_is(c_ncons, n, 0);
        let text:[]u8 = _zag_read_file(tp);
        let rp:i64 = 0;
        while(rp < text.len) {
            let rq:i64 = rp;
            while(rq < text.len && text[rq] != 10) { rq = rq + 1; }
            let tline:[]u8 = text[rp..rq];
            if(rq < text.len) { rq = rq + 1; }
            rp = rq;
            if(tline.len >= 9 && _zag_strcmp(fd_tok(tline, 0), "CONSTRUCT") == 1) {
                let nc:i64 = fd_ig(c_ncons, n);
                if(nc >= maxe) { continue; }
                let op:[]u8 = fd_field(tline, "op=");
                let ei:i64 = n * maxe + nc;
                let off:i64 = poolp;
                let k:i64 = 0;
                while(k < op.len && poolp < 65500) { pool[poolp] = op[k]; poolp = poolp + 1; k = k + 1; }
                fd_is(e_opoff, ei, off);
                fd_is(e_oplen, ei, op.len);
                fd_is(e_c1, ei, fd_oclass(_zag_str_to_i64(fd_field(tline, "p1="))));
                fd_is(e_c2, ei, fd_oclass(_zag_str_to_i64(fd_field(tline, "p2="))));
                fd_is(e_c3, ei, fd_oclass(_zag_str_to_i64(fd_field(tline, "p3="))));
                fd_is(c_ncons, n, nc + 1);
            }
        }
        n = n + 1;
    }
    // group by op/operand-only sequences
    let g:[]u8 = fd_alloc(maxs * 8);
    let ngroups:i64 = 0;
    let s:i64 = 0;
    while(s < n) {
        let found:i64 = -1;
        let t:i64 = 0;
        while(t < s) {
            let ns:i64 = fd_ig(c_ncons, s);
            let nt2:i64 = fd_ig(c_ncons, t);
            if(ns == nt2) {
                let same:bool = true;
                let e:i64 = 0;
                while(e < ns) {
                    let a:i64 = s * maxe + e;
                    let b:i64 = t * maxe + e;
                    let oa:[]u8 = pool[fd_ig(e_opoff, a)..fd_ig(e_opoff, a)+fd_ig(e_oplen, a)];
                    let ob:[]u8 = pool[fd_ig(e_opoff, b)..fd_ig(e_opoff, b)+fd_ig(e_oplen, b)];
                    if(_zag_strcmp(oa, ob) != 1) { same = false; }
                    if(fd_ig(e_c1, a) != fd_ig(e_c1, b)) { same = false; }
                    if(fd_ig(e_c2, a) != fd_ig(e_c2, b)) { same = false; }
                    if(fd_ig(e_c3, a) != fd_ig(e_c3, b)) { same = false; }
                    e = e + 1;
                }
                if(same) { found = fd_ig(g, t); }
            }
            t = t + 1;
        }
        if(found < 0) { found = ngroups; ngroups = ngroups + 1; }
        fd_is(g, s, found);
        s = s + 1;
    }
    let cmax:i64 = 0;
    let gg:i64 = 0;
    while(gg < ngroups) {
        let cnt:i64 = 0;
        s = 0;
        while(s < n) { if(fd_ig(g, s) == gg) { cnt = cnt + 1; } s = s + 1; }
        if(cnt > cmax) { cmax = cnt; }
        gg = gg + 1;
    }
    _zag_print("DIAG op-only groups D_ops=");
    _zag_print(_zag_i64_to_str(ngroups));
    _zag_print(" Cmax_ops=");
    _zag_println(_zag_i64_to_str(cmax));
    // per-group: member seeds and overfit flags
    gg = 0;
    while(gg < ngroups) {
        _zag_print("GROUP ");
        _zag_print(_zag_i64_to_str(gg));
        _zag_print(" members");
        s = 0;
        while(s < n) {
            if(fd_ig(g, s) == gg) {
                _zag_print(" ");
                _zag_print(_zag_i64_to_str(fd_ig(c_idx, s)));
                if(fd_ig(c_accn, s) < 30) { _zag_print("(ovf)"); }
            }
            s = s + 1;
        }
        _zag_println("");
        gg = gg + 1;
    }
    return 0;
}

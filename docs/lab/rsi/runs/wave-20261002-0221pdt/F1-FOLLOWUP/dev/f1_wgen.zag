// f1_wgen.zag - sealed world generator for the F1 trigger wave.
// Adversary/dev tooling only: generates fixtures, never the candidate.
// Pure Zag, compiled by the pinned znc.
//
// usage: f1_wgen kind seed n mode outfile
//   kind: eqA|eqB|eqC|eqD  (2 inputs; y=2 iff x0==x1 else 0; E/U interleaving
//                           pattern A=alternating, B=1-in-3, C=1-in-4,
//                           D=bursty 2-on-6-off)
//         zero  (1 input; y=0 always; clean world)
//         sum2  (2 inputs; y=2*(x0+x1))
//         quad  (1 input; y=4x)
//         sum3  (2 inputs; y=3*(x0+x1))
//         chg25 (1 input; y=2x for first half, y=5x for second half)
//         chg24 (1 input; y=2x for first half, y=4x for second half)
//   seed: i64 LCG seed (fresh per fixture; recorded in the prereg)
//   n:    episode count
//   mode: train (truth shown) | hide (truth masked as ?) |
//         truth (truth shown; scorer use; same x sequence as hide)
// Deterministic in (kind, seed, n): hide and truth with identical
// (kind, seed, n) share the x sequence and differ only in masking.

fn wg_ig(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn wg_is(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

fn wg_alloc(n:i64)[]u8 {
    if(n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

// LCG step; returns 0..65535.
fn rng_next(st:[]u8)i64 {
    let v:i64 = wg_ig(st, 0);
    v = v * 6364136223846793005 + 1442695040888963407;
    wg_is(st, 0, v);
    return (v >> 16) & 65535;
}

fn rng_range(st:[]u8, lo:i64, hi:i64)i64 {
    // inclusive lo, exclusive hi; hi > lo
    let r:i64 = rng_next(st);
    return lo + ((r * (hi - lo)) / 65536);
}

// E/U decision for the eq patterns on train episodes.
fn eq_is_E(kind:[]u8, i:i64)bool {
    if(_zag_strcmp(kind, "eqA") == 1) { return (i % 2) == 0; }
    if(_zag_strcmp(kind, "eqB") == 1) { return (i % 3) == 0; }
    if(_zag_strcmp(kind, "eqC") == 1) { return (i % 4) == 0; }
    // eqD: bursty 2-on-6-off
    return (i % 8) < 2;
}

fn is_eq_kind(kind:[]u8)bool {
    if(_zag_strcmp(kind, "eqA") == 1) { return true; }
    if(_zag_strcmp(kind, "eqB") == 1) { return true; }
    if(_zag_strcmp(kind, "eqC") == 1) { return true; }
    if(_zag_strcmp(kind, "eqD") == 1) { return true; }
    return false;
}

fn main()i32 {
    if(_zag_argc() < 6) {
        _zag_println("usage: f1_wgen kind seed n mode outfile");
        return 2;
    }
    let kind:[]u8 = _zag_arg(1);
    let seed:i64 = _zag_str_to_i64(_zag_arg(2));
    let n:i64 = _zag_str_to_i64(_zag_arg(3));
    let mode:[]u8 = _zag_arg(4);
    let out:[]u8 = _zag_arg(5);
    if(n < 1 || n > 4096) { _zag_println("ERR bad_n"); return 2; }
    let hide:i64 = 0;
    if(_zag_strcmp(mode, "hide") == 1) { hide = 1; }
    if(_zag_strcmp(mode, "train") != 1 && _zag_strcmp(mode, "hide") != 1 &&
       _zag_strcmp(mode, "truth") != 1) {
        _zag_println("ERR bad_mode");
        return 2;
    }

    let st:[]u8 = wg_alloc(8);
    if(st.len == 0) { _zag_println("ERR alloc"); return 2; }
    wg_is(st, 0, seed);

    let b:[]u8 = "";
    let i:i64 = 0;
    while(i < n) {
        let x0:i64 = 0;
        let x1:i64 = 0;
        let nin:i64 = 1;
        let y:i64 = 0;
        if(is_eq_kind(kind)) {
            nin = 2;
            let e:bool = false;
            if(_zag_strcmp(mode, "train") == 1) {
                e = eq_is_E(kind, i);
                // train x range 0..7
                if(e) {
                    x0 = rng_range(st, 0, 8);
                    x1 = x0;
                } else {
                    x0 = rng_range(st, 0, 8);
                    x1 = rng_range(st, 0, 8);
                    if(x1 == x0) { x1 = (x1 + 1) % 8; }
                }
            } else {
                // hide/truth x range 8..23, E/U by rng bit (unpatterned)
                e = (rng_next(st) & 1) == 1;
                if(e) {
                    x0 = rng_range(st, 8, 24);
                    x1 = x0;
                } else {
                    x0 = rng_range(st, 8, 24);
                    x1 = rng_range(st, 8, 24);
                    if(x1 == x0) { x1 = 8 + ((x1 - 8 + 1) % 16); }
                }
            }
            if(e) { y = 2; } else { y = 0; }
        } else if(_zag_strcmp(kind, "zero") == 1) {
            nin = 1;
            x0 = i;
            y = 0;
        } else if(_zag_strcmp(kind, "sum2") == 1) {
            nin = 2;
            if(_zag_strcmp(mode, "train") == 1) {
                x0 = rng_range(st, 0, 5);
                x1 = rng_range(st, 0, 5);
            } else {
                x0 = rng_range(st, 5, 15);
                x1 = rng_range(st, 5, 15);
            }
            y = (x0 + x1) * 2;
        } else if(_zag_strcmp(kind, "quad") == 1) {
            nin = 1;
            if(_zag_strcmp(mode, "train") == 1) { x0 = i; }
            else { x0 = 12 + i; }
            y = x0 * 4;
        } else if(_zag_strcmp(kind, "sum3") == 1) {
            nin = 2;
            if(_zag_strcmp(mode, "train") == 1) {
                x0 = rng_range(st, 0, 5);
                x1 = rng_range(st, 0, 5);
            } else {
                x0 = rng_range(st, 5, 15);
                x1 = rng_range(st, 5, 15);
            }
            y = (x0 + x1) * 3;
        } else if(_zag_strcmp(kind, "chg25") == 1) {
            nin = 1;
            if(_zag_strcmp(mode, "train") == 1) {
                x0 = i % (n / 2);
                if(i < n / 2) { y = x0 * 2; } else { y = x0 * 5; }
            } else {
                x0 = 12 + i;
                y = x0 * 5;
            }
        } else if(_zag_strcmp(kind, "chg24") == 1) {
            nin = 1;
            if(_zag_strcmp(mode, "train") == 1) {
                x0 = i % (n / 2);
                if(i < n / 2) { y = x0 * 2; } else { y = x0 * 4; }
            } else {
                x0 = 12 + i;
                y = x0 * 4;
            }
        } else {
            _zag_println("ERR bad_kind");
            return 2;
        }
        let line:[]u8 = _zag_i64_to_str(x0);
        if(nin == 2) {
            line = _zag_str_concat(line, " ");
            line = _zag_str_concat(line, _zag_i64_to_str(x1));
        }
        line = _zag_str_concat(line, " ");
        if(hide == 1) {
            line = _zag_str_concat(line, "?\n");
        } else {
            line = _zag_str_concat(line, _zag_i64_to_str(y));
            line = _zag_str_concat(line, "\n");
        }
        b = _zag_str_concat(b, line);
        i = i + 1;
    }
    let rc:i64 = _zag_write_file(out, b);
    _zag_print("WGEN kind=");
    _zag_print(kind);
    _zag_print(" seed=");
    _zag_print(_zag_i64_to_str(seed));
    _zag_print(" n=");
    _zag_print(_zag_i64_to_str(n));
    _zag_print(" mode=");
    _zag_print(mode);
    _zag_print(" rc=");
    _zag_println(_zag_i64_to_str(rc));
    return 0;
}

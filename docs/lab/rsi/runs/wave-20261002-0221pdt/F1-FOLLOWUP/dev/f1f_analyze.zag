// f1f_analyze.zag - seed-sensitivity analyzer for F1-FOLLOWUP
// wave-20261002-0221pdt. Implements exactly the frozen normalization of
// PREREG_F1FOLLOWUP.md section 5.
// usage: f1f_analyze <manifest>
// Manifest lines: <i> <acc_num> <acc_den> <trace_path>
// Prints a per-seed table, then SUMMARY with R, T, D, Cmax, then the
// frozen bar checks (thresholds are the prereg-frozen ones).
// Pure Zag, compiled by the pinned znc.

fn fa_alloc(n:i64)[]u8 {
    if(n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn fa_ig(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn fa_is(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

fn fa_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn fa_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn fa_has_prefix(tok:[]u8, pre:[]u8)bool {
    if(tok.len < pre.len) { return false; }
    let i:i64 = 0;
    while(i < pre.len) {
        if(tok[i] != pre[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn fa_after_eq(tok:[]u8)[]u8 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return ""; }
    return tok[p+1..tok.len];
}

fn fa_field(line:[]u8, name:[]u8)[]u8 {
    let nt:i64 = fa_ntok(line);
    let i:i64 = 0;
    while(i < nt) {
        let t:[]u8 = fa_tok(line, i);
        if(fa_has_prefix(t, name)) { return fa_after_eq(t); }
        i = i + 1;
    }
    return "";
}

// Operand class: 8 -> 1 (X0), 9 -> 2 (X1), 0 -> 0 (R0), else 3 (O).
fn fa_oclass(v:i64)i64 {
    if(v == 0) { return 0; }
    if(v == 8) { return 1; }
    if(v == 9) { return 2; }
    return 3;
}

fn fa_cname(c:i64)[]u8 {
    if(c == 0) { return "R0"; }
    if(c == 1) { return "X0"; }
    if(c == 2) { return "X1"; }
    return "O";
}

fn main()i32 {
    if(_zag_argc() < 2) { _zag_println("usage: f1f_analyze <manifest>"); return 2; }
    let mtext:[]u8 = _zag_read_file(_zag_arg(1));
    if(mtext.len == 0) { _zag_println("ERR manifest read"); return 2; }

    let maxs:i64 = 40;
    let maxe:i64 = 32;
    // per-seed cells: idx, accn, accd, ncons (each cell is 8 bytes)
    let c_idx:[]u8 = fa_alloc(maxs * 8);
    let c_accn:[]u8 = fa_alloc(maxs * 8);
    let c_accd:[]u8 = fa_alloc(maxs * 8);
    let c_ncons:[]u8 = fa_alloc(maxs * 8);
    // per-event cells: opoff, oplen, c1, c2, c3, eb, ea
    let ne:i64 = maxs * maxe;
    let e_opoff:[]u8 = fa_alloc(ne * 8);
    let e_oplen:[]u8 = fa_alloc(ne * 8);
    let e_c1:[]u8 = fa_alloc(ne * 8);
    let e_c2:[]u8 = fa_alloc(ne * 8);
    let e_c3:[]u8 = fa_alloc(ne * 8);
    let e_eb:[]u8 = fa_alloc(ne * 8);
    let e_ea:[]u8 = fa_alloc(ne * 8);
    // op string pool
    let pool:[]u8 = fa_alloc(65536);
    let poolp:i64 = 0;

    // parse manifest
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < mtext.len) {
        let q:i64 = p;
        while(q < mtext.len && mtext[q] != 10) { q = q + 1; }
        let line:[]u8 = mtext[p..q];
        if(q < mtext.len) { q = q + 1; }
        p = q;
        if(line.len == 0 || n >= maxs) { continue; }
        let si:[]u8 = fa_tok(line, 0);
        let sa:[]u8 = fa_tok(line, 1);
        let sd:[]u8 = fa_tok(line, 2);
        let tp:[]u8 = fa_tok(line, 3);
        if(si.len == 0 || sa.len == 0 || sd.len == 0 || tp.len == 0) { continue; }
        fa_is(c_idx, n, _zag_str_to_i64(si));
        fa_is(c_accn, n, _zag_str_to_i64(sa));
        fa_is(c_accd, n, _zag_str_to_i64(sd));
        fa_is(c_ncons, n, 0);
        let text:[]u8 = _zag_read_file(tp);
        let rp:i64 = 0;
        while(rp < text.len) {
            let rq:i64 = rp;
            while(rq < text.len && text[rq] != 10) { rq = rq + 1; }
            let tline:[]u8 = text[rp..rq];
            if(rq < text.len) { rq = rq + 1; }
            rp = rq;
            if(tline.len >= 9 && _zag_strcmp(fa_tok(tline, 0), "CONSTRUCT") == 1) {
                let nc:i64 = fa_ig(c_ncons, n);
                if(nc >= maxe) { continue; }
                let op:[]u8 = fa_field(tline, "op=");
                let p1:[]u8 = fa_field(tline, "p1=");
                let p2:[]u8 = fa_field(tline, "p2=");
                let p3:[]u8 = fa_field(tline, "p3=");
                let eb:[]u8 = fa_field(tline, "err_before=");
                let ea:[]u8 = fa_field(tline, "err_after=");
                let ei:i64 = n * maxe + nc;
                // copy op into pool
                let off:i64 = poolp;
                let k:i64 = 0;
                while(k < op.len && poolp < 65500) { pool[poolp] = op[k]; poolp = poolp + 1; k = k + 1; }
                fa_is(e_opoff, ei, off);
                fa_is(e_oplen, ei, op.len);
                fa_is(e_c1, ei, fa_oclass(_zag_str_to_i64(p1)));
                fa_is(e_c2, ei, fa_oclass(_zag_str_to_i64(p2)));
                fa_is(e_c3, ei, fa_oclass(_zag_str_to_i64(p3)));
                fa_is(e_eb, ei, _zag_str_to_i64(eb));
                fa_is(e_ea, ei, _zag_str_to_i64(ea));
                fa_is(c_ncons, n, nc + 1);
            }
        }
        n = n + 1;
    }
    if(n != 40) {
        _zag_print("ERR manifest seeds != 40: ");
        _zag_println(_zag_i64_to_str(n));
        return 2;
    }

    // R: overfit count (acc_num < acc_den)
    let r:i64 = 0;
    let s:i64 = 0;
    while(s < n) {
        if(fa_ig(c_accn, s) < fa_ig(c_accd, s)) { r = r + 1; }
        s = s + 1;
    }

    // per-seed table with sequence group ids
    // group assignment: g[s] = group id of normalized sequence
    let g:[]u8 = fa_alloc(maxs * 8);
    let ngroups:i64 = 0;
    s = 0;
    while(s < n) {
        let found:i64 = -1;
        let t:i64 = 0;
        while(t < s) {
            // compare seq s vs seq t
            let ns:i64 = fa_ig(c_ncons, s);
            let nt2:i64 = fa_ig(c_ncons, t);
            if(ns == nt2) {
                let same:bool = true;
                let e:i64 = 0;
                while(e < ns) {
                    let a:i64 = s * maxe + e;
                    let b:i64 = t * maxe + e;
                    let oa:[]u8 = pool[fa_ig(e_opoff, a)..fa_ig(e_opoff, a)+fa_ig(e_oplen, a)];
                    let ob:[]u8 = pool[fa_ig(e_opoff, b)..fa_ig(e_opoff, b)+fa_ig(e_oplen, b)];
                    if(_zag_strcmp(oa, ob) != 1) { same = false; }
                    if(fa_ig(e_c1, a) != fa_ig(e_c1, b)) { same = false; }
                    if(fa_ig(e_c2, a) != fa_ig(e_c2, b)) { same = false; }
                    if(fa_ig(e_c3, a) != fa_ig(e_c3, b)) { same = false; }
                    if(fa_ig(e_eb, a) != fa_ig(e_eb, b)) { same = false; }
                    if(fa_ig(e_ea, a) != fa_ig(e_ea, b)) { same = false; }
                    e = e + 1;
                }
                if(same) { found = fa_ig(g, t); }
            }
            t = t + 1;
        }
        if(found < 0) { found = ngroups; ngroups = ngroups + 1; }
        fa_is(g, s, found);
        s = s + 1;
    }
    let d:i64 = ngroups;
    // Cmax: largest group size
    let cmax:i64 = 0;
    let gg:i64 = 0;
    while(gg < ngroups) {
        let cnt:i64 = 0;
        s = 0;
        while(s < n) { if(fa_ig(g, s) == gg) { cnt = cnt + 1; } s = s + 1; }
        if(cnt > cmax) { cmax = cnt; }
        gg = gg + 1;
    }
    // T: distinct first-trial classes (op, c2, c3 of first event; NONE if ncons=0)
    let t:i64 = 0;
    s = 0;
    while(s < n) {
        let isnew:bool = true;
        let u:i64 = 0;
        while(u < s) {
            let nsu:i64 = fa_ig(c_ncons, s);
            let nuu:i64 = fa_ig(c_ncons, u);
            if(nsu == 0 && nuu == 0) { isnew = false; }
            if(nsu > 0 && nuu > 0) {
                let a:i64 = s * maxe;
                let b:i64 = u * maxe;
                let oa:[]u8 = pool[fa_ig(e_opoff, a)..fa_ig(e_opoff, a)+fa_ig(e_oplen, a)];
                let ob:[]u8 = pool[fa_ig(e_opoff, b)..fa_ig(e_opoff, b)+fa_ig(e_oplen, b)];
                if(_zag_strcmp(oa, ob) == 1 && fa_ig(e_c2, a) == fa_ig(e_c2, b) && fa_ig(e_c3, a) == fa_ig(e_c3, b)) { isnew = false; }
            }
            u = u + 1;
        }
        if(isnew) { t = t + 1; }
        s = s + 1;
    }

    // per-seed table
    s = 0;
    while(s < n) {
        _zag_print("SEED ");
        _zag_print(_zag_i64_to_str(fa_ig(c_idx, s)));
        _zag_print(" acc ");
        _zag_print(_zag_i64_to_str(fa_ig(c_accn, s)));
        _zag_print("/");
        _zag_print(_zag_i64_to_str(fa_ig(c_accd, s)));
        _zag_print(" ncons ");
        _zag_print(_zag_i64_to_str(fa_ig(c_ncons, s)));
        _zag_print(" fc ");
        let ns2:i64 = fa_ig(c_ncons, s);
        if(ns2 == 0) {
            _zag_print("NONE");
        } else {
            let a:i64 = s * maxe;
            let oa:[]u8 = pool[fa_ig(e_opoff, a)..fa_ig(e_opoff, a)+fa_ig(e_oplen, a)];
            _zag_print(oa);
            _zag_print("_");
            _zag_print(fa_cname(fa_ig(e_c2, a)));
            _zag_print("_");
            _zag_print(fa_cname(fa_ig(e_c3, a)));
        }
        _zag_print(" seqg ");
        _zag_println(_zag_i64_to_str(fa_ig(g, s)));
        s = s + 1;
    }
    _zag_print("SUMMARY N=40 R=");
    _zag_print(_zag_i64_to_str(r));
    _zag_print(" T=");
    _zag_print(_zag_i64_to_str(t));
    _zag_print(" D=");
    _zag_print(_zag_i64_to_str(d));
    _zag_print(" Cmax=");
    _zag_println(_zag_i64_to_str(cmax));
    // frozen bar checks
    let b1:bool = r >= 4;
    let b2:bool = t >= 2;
    let b3:bool = d >= 3 && cmax <= 34;
    _zag_print("BAR K-SENS-RATE R>=4: ");
    if(b1) { _zag_println("PASS"); } else { _zag_println("FAIL"); }
    _zag_print("BAR K-SENS-TRIAL T>=2: ");
    if(b2) { _zag_println("PASS"); } else { _zag_println("FAIL"); }
    _zag_print("BAR K-SENS-CONV D>=3_AND_Cmax<=34: ");
    if(b3) { _zag_println("PASS"); } else { _zag_println("FAIL"); }
    _zag_print("CANDIDATE-BARS: ");
    if(b1 && b2 && b3) { _zag_println("ALL-PASS"); } else { _zag_println("NOT-ALL-PASS"); }
    return 0;
}

// gate_driver.zag -- validation-gate test matrix (prereg B3).
//
// Tests idx_validate / fidx_validate against the REAL index
// structures (tag-40 index node, plen-bucket heads at fields
// 20/24/28/32, intrusive field-12 lists; FACT subject index: 24
// buckets over 4 chained tag-40 nodes, intrusive FACT field 12).
//
// Frozen expectations (each case 3/3 deterministic):
//   G1 healthy MAP index            -> idx_validate = 1 (ACCEPT)
//   G2 cyclic plen bucket (selfloop)-> idx_validate = 0 (REJECT)
//   G3 non-MAP member in bucket      -> idx_validate = 0 (REJECT)
//   G4 out-of-range next pointer     -> idx_validate = 0 (REJECT)
//   G5 plen-mismatched member        -> idx_validate = 0 (REJECT)
//   G6 healthy FACT index            -> fidx_validate = 1 (ACCEPT)
//   G7 cyclic FACT bucket chain      -> fidx_validate = 0 (REJECT)

fn g_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}

fn g_fresh(mode:i32)[]u8 {
  let W:[]u8=z_alloc(593984);
  tnn2_init(W);
  idx_mode_set(W,mode);
  return W;
}

fn g_build3(W:[]u8)i32 {
  let i:i32=0;
  let pm:i32=-1;
  while(i<3){
    pm=g_mkchain(W,5000+i*10,5,51,5004+i*10);
    i=i+1;
  }
  return pm;
}

fn g_check(tag:[]u8,got:i32,want:i32)void {
  emit(tag);
  if(got==want){ emit(" PASS got="); e64(got); emit("\n"); return; }
  emit(" FAIL got="); e64(got); emit(" want="); e64(want); emit("\n");
  return;
}

fn g_bucket_head(W:[]u8,plen:i32)i32 {
  let ix:i32=hg(W,52);
  if(plen==5){ return ng(W,ix,32); }
  if(plen==3){ return ng(W,ix,24); }
  return -1;
}

fn g_case2()void {
  // G2: self-loop cycle in the plen-5 bucket.
  let W:[]u8=g_fresh(1);
  g_build3(W);
  let ix:i32=hg(W,52);
  let head:i32=ng(W,ix,32);
  if(head>=0){ ns(W,head,12,head); }
  g_check("G2-cycle      ",idx_validate(W),0);
  return;
}

fn g_case3()void {
  // G3: prepend a live FACT node (tag 1, not MAP tag 20).
  let W:[]u8=g_fresh(1);
  g_build3(W);
  let ix:i32=hg(W,52);
  let head:i32=ng(W,ix,32);
  let f:i32=2;
  while(f<8192){
    if(ng(W,f,36)==1 && ng(W,f,0)==1){ break; }
    f=f+1;
  }
  if(f<8192){
    ns(W,f,12,head);
    ns(W,ix,32,f);
  }
  g_check("G3-nonmap     ",idx_validate(W),0);
  return;
}

fn g_case4()void {
  // G4: bucket head's next points out of node range.
  let W:[]u8=g_fresh(1);
  g_build3(W);
  let ix:i32=hg(W,52);
  let head:i32=ng(W,ix,32);
  if(head>=0){ ns(W,head,12,9999); }
  g_check("G4-oobnext    ",idx_validate(W),0);
  return;
}

fn g_case5()void {
  // G5: splice a plen-3 MAP into the plen-5 bucket.
  let W:[]u8=g_fresh(1);
  g_build3(W);
  let pm3:i32=g_mkchain(W,8000,3,51,8002);
  let ix:i32=hg(W,52);
  if(pm3>=0){
    ns(W,pm3,12,ng(W,ix,32));
    ns(W,ix,32,pm3);
  }
  g_check("G5-plenmismatch",idx_validate(W),0);
  return;
}

fn g_case67()void {
  // G6/G7: FACT subject index gate.
  let W:[]u8=g_fresh(4);
  let i:i32=0;
  while(i<60){
    ev_teach(W,5000+i,1,9000+i);
    i=i+1;
  }
  g_check("G6-facthealthy",fidx_validate(W),1);
  // G7: cycle a FACT bucket chain (self-loop on a non-empty head).
  let b:i32=0;
  let done:i32=0;
  while(b<24 && done==0){
    let h:i32=fidx_bhead(W,b);
    if(h>=0){ ns(W,h,12,h); done=1; }
    b=b+1;
  }
  if(done==1){ g_check("G7-factcycle  ",fidx_validate(W),0); }
  else { emit("G7-factcycle   SKIP no bucket head\n"); }
  return;
}

fn main()i32 {
  emit("GATE-TEST-START\n");
  let W1:[]u8=g_fresh(1);
  g_build3(W1);
  g_check("G1-healthy    ",idx_validate(W1),1);
  g_check("G1-factempty  ",fidx_validate(W1),1);
  g_case2();
  g_case3();
  g_case4();
  g_case5();
  g_case67();
  emit("GATE-TEST-END\n");
  return 0;
}

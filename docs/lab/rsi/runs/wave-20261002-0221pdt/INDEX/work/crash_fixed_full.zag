fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// crash_fixed.zag -- fixed collection pattern for the index-cycle crash.
//
// Same program shape as crash_repro.zag, with the vulnerable walk
// replaced by the hardened walk:
//   - OOB-safe single step (out-of-range next = list end, never panic)
//   - Floyd tortoise-and-hare cycle detection (stop at first revisit)
//   - writes bounded by the TRUE buffer capacity (512 entries)
//   - only live members collected (models the ng 36==1 / tag==20 filter)
//
// EXPECTED (frozen in PREREG_INDEX_REPRO.md B2): exit 0; each cyclic
// member collected exactly once; CYCLE-DETECTED reported; no panic
// on self-loop, 3-cycle, out-of-range next, non-live member, healthy
// list, or out-of-range head.

fn bnext(store:[]u8,m:i32,nn:i32)i32 {
  if(m<0 || m>=nn){ return -1; }
  let v:i32=get32(store,m*4);
  if(v<0 || v>=nn){ return -1; }
  return v;
}

fn collect_fixed(store:[]u8,live:[]u8,head:i32,q:i32,nn:i32)i32 {
  let capc:i32=512;
  let cand:[]u8=z_alloc(4096);
  let nc:i32=0;
  let m:i32=head;
  if(m<0 || m>=nn){ m=-1; }
  let slow:i32=m;
  let fast:i32=m;
  let cyc:i32=0;
  while(m>=0 && nc<capc){
    if(get32(live,m*4)==1){
      set32(cand,nc*8,m); set32(cand,nc*8+4,q);
      nc=nc+1;
    }
    m=bnext(store,m,nn);
    slow=bnext(store,slow,nn);
    fast=bnext(store,bnext(store,fast,nn),nn);
    if(m>=0 && slow==fast){ cyc=1; m=-1; }
  }
  return nc+cyc*100000;
}

fn check(tag:[]u8,got:i32,want:i32,fails:[]u8)i32 {
  emit(tag);
  if(got==want){ emit(" PASS got="); e64(got); emit("\n"); return get32(fails,0); }
  emit(" FAIL got="); e64(got); emit(" want="); e64(want); emit("\n");
  set32(fails,0,get32(fails,0)+1);
  return get32(fails,0);
}

fn main()i32 {
  emit("CRASH-FIXED-START\n");
  let fails:[]u8=z_alloc(4);
  // T1: self-loop 0->0 (red-team C2 shape).
  let s1:[]u8=z_alloc(8); let l1:[]u8=z_alloc(8);
  set32(s1,0,0); set32(s1,4,-1); set32(l1,0,1); set32(l1,4,1);
  check("T1-selfloop ",collect_fixed(s1,l1,0,5,2),100001,fails);
  // T2: 3-cycle 0->1->2->0.
  let s2:[]u8=z_alloc(12); let l2:[]u8=z_alloc(12);
  set32(s2,0,1); set32(s2,4,2); set32(s2,8,0);
  set32(l2,0,1); set32(l2,4,1); set32(l2,8,1);
  check("T2-3cycle  ",collect_fixed(s2,l2,0,5,3),100003,fails);
  // T3: out-of-range next 0->9999 (nn=4).
  let s3:[]u8=z_alloc(16); let l3:[]u8=z_alloc(16);
  set32(s3,0,9999); set32(l3,0,1);
  check("T3-oobnext ",collect_fixed(s3,l3,0,5,4),1,fails);
  // T4: non-live member 0->1->-1, node 1 dead.
  let s4:[]u8=z_alloc(8); let l4:[]u8=z_alloc(8);
  set32(s4,0,1); set32(s4,4,-1); set32(l4,0,1); set32(l4,4,0);
  check("T4-deadmem ",collect_fixed(s4,l4,0,5,2),1,fails);
  // T5: healthy 0->1->2->-1.
  let s5:[]u8=z_alloc(12); let l5:[]u8=z_alloc(12);
  set32(s5,0,1); set32(s5,4,2); set32(s5,8,-1);
  set32(l5,0,1); set32(l5,4,1); set32(l5,8,1);
  check("T5-healthy ",collect_fixed(s5,l5,0,5,3),3,fails);
  // T6: out-of-range head.
  check("T6-oobhead ",collect_fixed(s5,l5,99,5,3),0,fails);
  emit("CRASH-FIXED-FAILURES="); e64(get32(fails,0)); emit("\n");
  emit("CRASH-FIXED-END\n");
  if(get32(fails,0)>0){ return 1; }
  return 0;
}

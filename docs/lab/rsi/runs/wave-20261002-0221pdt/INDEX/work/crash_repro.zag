// crash_repro.zag -- MINIMAL reproducer for the index-cycle crash.
// Red-team finding (C203, ADV-IDX-CORRUPT case C2): a cycle in the
// plen-bucket list crashes rebind_try_idx with
// "panic: slice index out of bounds".
//
// This replicates the vulnerable collection pattern of
// si_patch.zag rebind_try_idx (lines 156-170) exactly:
//   cand buffer z_alloc(4096) bytes  -> 512 safe entries at 8 bytes each
//   loop bound nc<1024               -> allows 1024 iterations
//   8 bytes written per candidate     -> set32(cand,nc*8,m),
//                                        set32(cand,nc*8+4,q)
// A cyclic bucket list drives nc past 512 into unwritten buffer space.
// The node store is modeled minimally: next[i] is the field-12 link.
//
// EXPECTED (frozen in PREREG_INDEX_REPRO.md B1): the program panics
// with "slice index out of bounds" and exits nonzero. The nc= line
// must NEVER print.

fn bnext(store:[]u8,m:i32)i32 {
  // Faithful to the vulnerable code: NO bounds check, NO cycle check.
  return get32(store,m*4);
}

fn collect_vuln(store:[]u8,head:i32,q:i32)i32 {
  let cand:[]u8=z_alloc(4096);
  let nc:i32=0;
  let m:i32=head;
  while(m>=0 && nc<1024){
    set32(cand,nc*8,m); set32(cand,nc*8+4,q);
    nc=nc+1;
    m=bnext(store,m);
  }
  return nc;
}

fn main()i32 {
  emit("CRASH-REPRO-VULN-START\n");
  // 2-node store forming a self-loop cycle (red-team C2 shape:
  // bucket head's next points to itself).
  let store:[]u8=z_alloc(8);
  set32(store,0,0);
  set32(store,4,-1);
  emit("collecting from cyclic bucket (head=0, 0->0)...\n");
  let nc:i32=collect_vuln(store,0,5);
  emit("nc="); e64(nc); emit("\n");
  emit("CRASH-REPRO-VULN-END\n");
  return 0;
}

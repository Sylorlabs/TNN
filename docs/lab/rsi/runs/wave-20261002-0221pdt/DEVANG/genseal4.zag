// genseal4.zag - Fresh sealed world generator for DEVANG4 (wave-20261002-0221pdt).
// Implements the prereg-frozen generator specs (PREREG_DEVANG4.md section 7).
// Modes: genb (Family B-prime), genc (Family C-prime).
// Pure Zag. No Python.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn rng_next(st:[]u8)i32 {
  let s:i32=get32(st,0);
  s=s*1103515245+12345;
  s=s&0x7FFFFFFF;
  set32(st,0,s);
  return (s>>16)&0x7FFF;
}
fn rng_range(st:[]u8, n:i32)i32 {
  if(n<=1){return 0;}
  return rng_next(st)%n;
}
// ---------- Family B-prime word list (frozen) ----------
// 0=zok 1=zokan 2=natemo 3=nate 4=wex 5=wexil 6=fim 7=afim 8=grol 9=agrol 10=ol
fn bword_len(wi:i32)i32 {
  if(wi==1){return 5;}
  if(wi==2){return 6;}
  if(wi==3){return 4;}
  if(wi==5){return 5;}
  if(wi==7){return 4;}
  if(wi==8){return 4;}
  if(wi==9){return 5;}
  if(wi==10){return 2;}
  return 3;
}
fn bword_byte(wi:i32, pos:i32)i32 {
  if(wi==0){ if(pos==0){return 122;} if(pos==1){return 111;} return 107; } // zok
  if(wi==1){ if(pos==0){return 122;} if(pos==1){return 111;} if(pos==2){return 107;} if(pos==3){return 97;} return 110; } // zokan
  if(wi==2){ if(pos==0){return 110;} if(pos==1){return 97;} if(pos==2){return 116;} if(pos==3){return 101;} if(pos==4){return 109;} return 111; } // natemo
  if(wi==3){ if(pos==0){return 110;} if(pos==1){return 97;} if(pos==2){return 116;} return 101; } // nate
  if(wi==4){ if(pos==0){return 119;} if(pos==1){return 101;} return 120; } // wex
  if(wi==5){ if(pos==0){return 119;} if(pos==1){return 101;} if(pos==2){return 120;} if(pos==3){return 105;} return 108; } // wexil
  if(wi==6){ if(pos==0){return 102;} if(pos==1){return 105;} return 109; } // fim
  if(wi==7){ if(pos==0){return 97;} if(pos==1){return 102;} if(pos==2){return 105;} return 109; } // afim
  if(wi==8){ if(pos==0){return 103;} if(pos==1){return 114;} if(pos==2){return 111;} return 108; } // grol
  if(wi==9){ if(pos==0){return 97;} if(pos==1){return 103;} if(pos==2){return 114;} if(pos==3){return 111;} return 108; } // agrol
  // wi==10 ol
  if(pos==0){return 111;} return 108;
}
// Known Family A words for B-prime merge class: 0=smal 1=sph 2=big 3=grn
fn kword_len(ki:i32)i32 {
  if(ki==0){return 4;}
  return 3;
}
fn kword_byte(ki:i32, pos:i32)i32 {
  if(ki==0){ if(pos==0){return 115;} if(pos==1){return 109;} if(pos==2){return 97;} return 108; } // smal
  if(ki==1){ if(pos==0){return 115;} if(pos==1){return 112;} return 104; } // sph
  if(ki==2){ if(pos==0){return 98;} if(pos==1){return 105;} return 103; } // big
  // ki==3 grn
  if(pos==0){return 103;} if(pos==1){return 114;} return 110;
}
// Append a B-prime word to buf at pos. Returns new pos. Records boundary.
fn append_bword(buf:[]u8, pos:i32, wi:i32)i32 {
  let L:i32=bword_len(wi);
  let k:i32=0;
  while(k<L){ buf[pos+k]=bword_byte(wi,k) as u8; k=k+1; }
  return pos+L;
}
fn append_kword(buf:[]u8, pos:i32, ki:i32)i32 {
  let L:i32=kword_len(ki);
  let k:i32=0;
  while(k<L){ buf[pos+k]=kword_byte(ki,k) as u8; k=k+1; }
  return pos+L;
}
// ---------- Family C-prime word table (frozen) ----------
// wid: 0=vok(action) 1=nibo(neg) 2=zak(red) 3=fimi(blu) 4=ug(grn)
//      5=dax(ball) 6=kubl(cube) 7=triq(tri) 8=bigo(big) 9=smalu(smal) 10=bigeru(biger)
fn cword_len(wid:i32)i32 {
  if(wid==1){return 4;}
  if(wid==3){return 4;}
  if(wid==4){return 2;}
  if(wid==6){return 4;}
  if(wid==7){return 4;}
  if(wid==8){return 4;}
  if(wid==9){return 5;}
  if(wid==10){return 6;}
  return 3;
}
fn cword_byte(wid:i32, pos:i32)i32 {
  if(wid==0){ if(pos==0){return 118;} if(pos==1){return 111;} return 107; } // vok
  if(wid==1){ if(pos==0){return 110;} if(pos==1){return 105;} if(pos==2){return 98;} return 111; } // nibo
  if(wid==2){ if(pos==0){return 122;} if(pos==1){return 97;} return 107; } // zak
  if(wid==3){ if(pos==0){return 102;} if(pos==1){return 105;} if(pos==2){return 109;} return 105; } // fimi
  if(wid==4){ if(pos==0){return 117;} return 103; } // ug
  if(wid==5){ if(pos==0){return 100;} if(pos==1){return 97;} return 120; } // dax
  if(wid==6){ if(pos==0){return 107;} if(pos==1){return 117;} if(pos==2){return 98;} return 108; } // kubl
  if(wid==7){ if(pos==0){return 116;} if(pos==1){return 114;} if(pos==2){return 105;} return 113; } // triq
  if(wid==8){ if(pos==0){return 98;} if(pos==1){return 105;} if(pos==2){return 103;} return 111; } // bigo
  if(wid==9){ if(pos==0){return 115;} if(pos==1){return 109;} if(pos==2){return 97;} if(pos==3){return 108;} return 117; } // smalu
  // wid==10 bigeru
  if(pos==0){return 98;} if(pos==1){return 105;} if(pos==2){return 103;}
  if(pos==3){return 101;} if(pos==4){return 114;} return 117;
}
fn append_cword(buf:[]u8, pos:i32, wid:i32)i32 {
  let L:i32=cword_len(wid);
  let k:i32=0;
  while(k<L){ buf[pos+k]=cword_byte(wid,k) as u8; k=k+1; }
  return pos+L;
}
// ---------- Scene generators (mirror Family A distributions) ----------
fn gen_direct(ep:[]u8, st:[]u8, color:i32, shape:i32, ncolor:i32, nshape:i32)void {
  let tgt:i32=rng_range(st,3);
  set32(ep,40,tgt);
  set32(ep,(tgt*3+0)*4,color);
  set32(ep,(tgt*3+1)*4,shape);
  set32(ep,(tgt*3+2)*4,rng_range(st,2));
  let o:i32=0;
  while(o<3){
    if(o!=tgt){
      let c:i32=0; let s:i32=0; let ok:i32=0;
      while(ok==0){
        c=rng_range(st,ncolor); s=rng_range(st,nshape);
        if(c!=color || s!=shape){ ok=1; }
      }
      set32(ep,(o*3+0)*4,c); set32(ep,(o*3+1)*4,s); set32(ep,(o*3+2)*4,rng_range(st,2));
    }
    o=o+1;
  }
  return;
}
fn gen_neg(ep:[]u8, st:[]u8, color:i32, ncolor:i32, nshape:i32)void {
  let tgt:i32=rng_range(st,3);
  set32(ep,40,tgt);
  let dc:i32=rng_range(st,ncolor-1);
  if(dc>=color){ dc=dc+1; }
  set32(ep,(tgt*3+0)*4,dc);
  set32(ep,(tgt*3+1)*4,rng_range(st,nshape));
  set32(ep,(tgt*3+2)*4,rng_range(st,2));
  let o:i32=0;
  while(o<3){
    if(o!=tgt){
      set32(ep,(o*3+0)*4,color);
      set32(ep,(o*3+1)*4,rng_range(st,nshape));
      set32(ep,(o*3+2)*4,rng_range(st,2));
    }
    o=o+1;
  }
  return;
}
fn gen_rel(ep:[]u8, st:[]u8, shape:i32, ncolor:i32, nshape:i32)void {
  let i1:i32=rng_range(st,3);
  let i2:i32=rng_range(st,2);
  if(i2>=i1){ i2=i2+1; }
  let i3:i32=3-i1-i2;
  let tgt_is_i1:i32=rng_range(st,2);
  let tgt:i32=0; let oth:i32=0;
  if(tgt_is_i1==1){ tgt=i1; oth=i2; } else { tgt=i2; oth=i1; }
  set32(ep,40,tgt);
  set32(ep,(tgt*3+0)*4,rng_range(st,ncolor));
  set32(ep,(tgt*3+1)*4,shape);
  set32(ep,(tgt*3+2)*4,1);
  set32(ep,(oth*3+0)*4,rng_range(st,ncolor));
  set32(ep,(oth*3+1)*4,shape);
  set32(ep,(oth*3+2)*4,0);
  let ds:i32=rng_range(st,nshape-1);
  if(ds>=shape){ ds=ds+1; }
  set32(ep,(i3*3+0)*4,rng_range(st,ncolor));
  set32(ep,(i3*3+1)*4,ds);
  set32(ep,(i3*3+2)*4,rng_range(st,2));
  return;
}
fn gen_size(ep:[]u8, st:[]u8, size:i32, shape:i32, ncolor:i32, nshape:i32)void {
  let tgt:i32=rng_range(st,3);
  set32(ep,40,tgt);
  set32(ep,(tgt*3+0)*4,rng_range(st,ncolor));
  set32(ep,(tgt*3+1)*4,shape);
  set32(ep,(tgt*3+2)*4,size);
  let o:i32=0;
  while(o<3){
    if(o!=tgt){
      let s:i32=0; let z:i32=0; let ok:i32=0;
      while(ok==0){
        s=rng_range(st,nshape); z=rng_range(st,2);
        if(s!=shape || z!=size){ ok=1; }
      }
      set32(ep,(o*3+0)*4,rng_range(st,ncolor));
      set32(ep,(o*3+1)*4,s);
      set32(ep,(o*3+2)*4,z);
    }
    o=o+1;
  }
  return;
}
// Write one episode line: "<9 scene ints> <tgt> <utterance>\n"
fn write_ep_line(buf:[]u8, pos:i32, ep:[]u8, upos:i32, ulen:i32)i32 {
  let o:i32=0;
  while(o<9){
    let v:i32=get32(ep,o*4);
    let s:[]u8=i32s(v);
    let q:i32=0; while(q<s.len){ buf[pos]=s[q]; pos=pos+1; q=q+1; }
    buf[pos]=32; pos=pos+1;
    o=o+1;
  }
  let tg:[]u8=i32s(get32(ep,40));
  let q:i32=0; while(q<tg.len){ buf[pos]=tg[q]; pos=pos+1; q=q+1; }
  buf[pos]=32; pos=pos+1;
  q=0;
  while(q<ulen){ buf[pos]=ep[upos+q]; pos=pos+1; q=q+1; }
  buf[pos]=10; pos=pos+1;
  return pos;
}
// ---------- genb: Family B-prime ----------
fn mode_genb()i32 {
  let st:[]u8=z_alloc(4);
  set32(st,0,777001);
  let out:[]u8=z_alloc(4096);
  let key:[]u8=z_alloc(4096);
  let op:i32=0; let kp:i32=0;
  let ui:i32=0;
  while(ui<12){
    let ub:[]u8=z_alloc(32);
    let bounds:[]u8=z_alloc(8*4);
    let nb:i32=0;
    let pos:i32=0;
    if(ui<4){
      // merge class: known Family A word + B-prime word (either order)
      let ki:i32=rng_range(st,4);
      let wi:i32=rng_range(st,11);
      let ord:i32=rng_range(st,2);
      if(ord==0){
        pos=append_kword(ub,pos,ki); set32(bounds,nb*4,pos); nb=nb+1;
        pos=append_bword(ub,pos,wi);
      } else {
        pos=append_bword(ub,pos,wi); set32(bounds,nb*4,pos); nb=nb+1;
        pos=append_kword(ub,pos,ki);
      }
    } else if(ui<8){
      // ambiguity class: two B-prime words (prefix/suffix pairs in list)
      let w1:i32=rng_range(st,11);
      let w2:i32=rng_range(st,11);
      pos=append_bword(ub,pos,w1); set32(bounds,nb*4,pos); nb=nb+1;
      pos=append_bword(ub,pos,w2);
    } else {
      // random class: 2-3 B-prime words
      let nw:i32=2+rng_range(st,2);
      let w:i32=0;
      while(w<nw){
        let wi:i32=rng_range(st,11);
        pos=append_bword(ub,pos,wi);
        if(w<nw-1){ set32(bounds,nb*4,pos); nb=nb+1; }
        w=w+1;
      }
    }
    // write utterance line
    let q:i32=0;
    while(q<pos){ out[op]=ub[q]; op=op+1; key[kp]=ub[q]; kp=kp+1; q=q+1; }
    out[op]=10; op=op+1;
    // write key line: "<utt> => <b1>,<b2>"
    key[kp]=32; kp=kp+1; key[kp]=61; kp=kp+1; key[kp]=62; kp=kp+1; key[kp]=32; kp=kp+1;
    let b:i32=0;
    while(b<nb){
      if(b>0){ key[kp]=44; kp=kp+1; }
      let s:[]u8=i32s(get32(bounds,b*4));
      q=0; while(q<s.len){ key[kp]=s[q]; kp=kp+1; q=q+1; }
      b=b+1;
    }
    key[kp]=10; kp=kp+1;
    ui=ui+1;
  }
  _zag_write_file("sealed_b4.txt", out[0..op]);
  _zag_write_file("sealed_b4_key.txt", key[0..kp]);
  emit("genb done: 12 utterances\n");
  return 0;
}
// ---------- genc: Family C-prime ----------
fn mode_genc()i32 {
  let st:[]u8=z_alloc(4);
  set32(st,0,777002);
  let out:[]u8=z_alloc(65536);
  let op:i32=0;
  // header "40 20\n"
  out[op]=52; op=op+1; out[op]=48; op=op+1; out[op]=32; op=op+1;
  out[op]=50; op=op+1; out[op]=48; op=op+1; out[op]=10; op=op+1;
  let ep:[]u8=z_alloc(80);
  let ub:[]u8=z_alloc(32);
  // Train: 16 DIRECT, 10 NEG, 7 REL, 7 SIZE = 40.
  // DIRECT train combos (fixed subset): (0,0),(0,1),(1,0),(1,2),(2,1),(2,2)
  let dtr:[]u8=z_alloc(6*2*4);
  set32(dtr,0,0); set32(dtr,4,0); set32(dtr,8,0); set32(dtr,12,1);
  set32(dtr,16,1); set32(dtr,20,0); set32(dtr,24,1); set32(dtr,28,2);
  set32(dtr,32,2); set32(dtr,36,1); set32(dtr,40,2); set32(dtr,44,2);
  let ti:i32=0;
  while(ti<16){
    let ci:i32=ti%6;
    let c:i32=get32(dtr,ci*8); let s:i32=get32(dtr,ci*8+4);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_direct(ep,st,c,s,3,3);
    let pos:i32=48;
    pos=append_cword(ep,pos,0);
    if(c==0){ pos=append_cword(ep,pos,2); }
    else if(c==1){ pos=append_cword(ep,pos,3); }
    else { pos=append_cword(ep,pos,4); }
    if(s==0){ pos=append_cword(ep,pos,5); }
    else if(s==1){ pos=append_cword(ep,pos,6); }
    else { pos=append_cword(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  ti=0;
  while(ti<10){
    let c:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_neg(ep,st,c,3,3);
    let pos:i32=48;
    pos=append_cword(ep,pos,0); pos=append_cword(ep,pos,1);
    if(c==0){ pos=append_cword(ep,pos,2); }
    else if(c==1){ pos=append_cword(ep,pos,3); }
    else { pos=append_cword(ep,pos,4); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  ti=0;
  while(ti<7){
    let s:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_rel(ep,st,s,3,3);
    let pos:i32=48;
    pos=append_cword(ep,pos,0); pos=append_cword(ep,pos,10);
    if(s==0){ pos=append_cword(ep,pos,5); }
    else if(s==1){ pos=append_cword(ep,pos,6); }
    else { pos=append_cword(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  ti=0;
  while(ti<7){
    let z:i32=rng_range(st,2); let s:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_size(ep,st,z,s,3,3);
    let pos:i32=48;
    pos=append_cword(ep,pos,0);
    if(z==1){ pos=append_cword(ep,pos,8); } else { pos=append_cword(ep,pos,9); }
    if(s==0){ pos=append_cword(ep,pos,5); }
    else if(s==1){ pos=append_cword(ep,pos,6); }
    else { pos=append_cword(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  // Test: 20 novel. DIRECT novel combos (disjoint): (0,2),(1,1),(2,0).
  let dte:[]u8=z_alloc(3*2*4);
  set32(dte,0,0); set32(dte,4,2); set32(dte,8,1); set32(dte,12,1);
  set32(dte,16,2); set32(dte,20,0);
  ti=0;
  while(ti<8){
    let ci:i32=ti%3;
    let c:i32=get32(dte,ci*8); let s:i32=get32(dte,ci*8+4);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_direct(ep,st,c,s,3,3);
    let pos:i32=48;
    pos=append_cword(ep,pos,0);
    if(c==0){ pos=append_cword(ep,pos,2); }
    else if(c==1){ pos=append_cword(ep,pos,3); }
    else { pos=append_cword(ep,pos,4); }
    if(s==0){ pos=append_cword(ep,pos,5); }
    else if(s==1){ pos=append_cword(ep,pos,6); }
    else { pos=append_cword(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  ti=0;
  while(ti<4){
    let c:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_neg(ep,st,c,3,3);
    let pos:i32=48;
    pos=append_cword(ep,pos,0); pos=append_cword(ep,pos,1);
    if(c==0){ pos=append_cword(ep,pos,2); }
    else if(c==1){ pos=append_cword(ep,pos,3); }
    else { pos=append_cword(ep,pos,4); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  ti=0;
  while(ti<4){
    let s:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_rel(ep,st,s,3,3);
    let pos:i32=48;
    pos=append_cword(ep,pos,0); pos=append_cword(ep,pos,10);
    if(s==0){ pos=append_cword(ep,pos,5); }
    else if(s==1){ pos=append_cword(ep,pos,6); }
    else { pos=append_cword(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  // SIZE test x4: bigo/bigeru prefix ambiguity stress (bigo vs bigeru share "bige").
  // Use bigo (wid 8) and smalu (wid 9) alternating; shapes seeded.
  ti=0;
  while(ti<4){
    let z:i32=ti%2; // 0=smalu, 1=bigo
    let s:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    let sz:i32=0; if(z==1){ sz=1; }
    gen_size(ep,st,sz,s,3,3);
    let pos:i32=48;
    pos=append_cword(ep,pos,0);
    if(z==1){ pos=append_cword(ep,pos,8); } else { pos=append_cword(ep,pos,9); }
    if(s==0){ pos=append_cword(ep,pos,5); }
    else if(s==1){ pos=append_cword(ep,pos,6); }
    else { pos=append_cword(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  _zag_write_file("sealed_c4.txt", out[0..op]);
  emit("genc done: 40 train + 20 test\n");
  return 0;
}
fn main()i32 {
  if(_zag_argc()>=2){
    let ma:[]u8=_zag_arg(1);
    if(_zag_strcmp(ma,"genb")==1){ return mode_genb(); }
    if(_zag_strcmp(ma,"genc")==1){ return mode_genc(); }
    emit("USAGE: genseal4 [genb|genc]\n");
    return 2;
  }
  emit("USAGE: genseal4 [genb|genc]\n");
  return 2;
}

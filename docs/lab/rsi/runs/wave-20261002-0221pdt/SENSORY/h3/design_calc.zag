// design_calc.zag - H3 SUN-ANCHORED SKY-DOME LUMINANCE GRADIENT derivation.
// Pure Zag. NO renders exist or are consulted. Replicates the frozen camera
// math (b_render), the frozen fixture point sets, the BASELINE b_sky clear-sky
// dome math (verbatim horizon/zenith mixes, disc/glow, cirrus block), and the
// candidate H3 dome-gradient block; predicts KB statistics for candidate
// (GW, GC) gains on a grid. The frozen prereg cites this output.
// NOTE: H3 leaves the cirrus block byte-identical (baseline alpha m); the
// gradient sits between the dome mixes and the disc/glow block.
fn b_hash2(x:i64, y:i64, s:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + s * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn b_ifloor(v:f64) i64 {
    let t:i64 = v as i64;
    if (v < 0.0 && (t as f64) != v) { t = t - 1; }
    return t;
}
fn b_fade(t:f64) f64 {
    return t * t * (3.0 - 2.0 * t);
}
fn b_vn2(x:f64, y:f64, s:i64) f64 {
    let xi:i64 = b_ifloor(x);
    let yi:i64 = b_ifloor(y);
    let xf:f64 = x - (xi as f64);
    let yf:f64 = y - (yi as f64);
    let u:f64 = b_fade(xf);
    let v:f64 = b_fade(yf);
    let a:f64 = (b_hash2(xi, yi, s) >> 12) as f64 / 1048576.0;
    let b:f64 = (b_hash2(xi + 1, yi, s) >> 12) as f64 / 1048576.0;
    let c:f64 = (b_hash2(xi, yi + 1, s) >> 12) as f64 / 1048576.0;
    let d:f64 = (b_hash2(xi + 1, yi + 1, s) >> 12) as f64 / 1048576.0;
    let ab:f64 = a + (b - a) * u;
    let cd:f64 = c + (d - c) * u;
    return ab + (cd - ab) * v;
}
fn b_fbm2(x:f64, y:f64, s:i64, oct:i64) f64 {
    let sum:f64 = 0.0;
    let amp:f64 = 0.5;
    let norm:f64 = 0.0;
    let xx:f64 = x;
    let yy:f64 = y;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + b_vn2(xx, yy, s + o * 131) * amp;
        norm = norm + amp;
        xx = xx * 2.03;
        yy = yy * 2.03;
        amp = amp * 0.5;
        o = o + 1;
    }
    if (norm == 0.0) { return 0.5; }
    return sum / norm;
}
fn b_abs(v:f64) f64 {
    if (v < 0.0) { return 0.0 - v; }
    return v;
}
fn b_clamp(v:f64, lo:f64, hi:f64) f64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn b_ss(t:f64) f64 {
    let c:f64 = b_clamp(t, 0.0, 1.0);
    return c * c * (3.0 - 2.0 * c);
}
fn b_sqrt(v:f64) f64 {
    if (v <= 0.0) { return 0.0; }
    let r:f64 = v;
    if (r < 1.0) { r = 1.0; }
    let i:i64 = 0;
    while (i < 24) {
        r = (r + v / r) * 0.5;
        i = i + 1;
    }
    return r;
}
fn b_mix(a:f64, b:f64, t:f64) f64 {
    return a + (b - a) * t;
}
fn b_sunamt(dx:f64, dz:f64) f64 {
    let hl:f64 = b_sqrt(dx * dx + dz * dz);
    if (hl < 0.0001) { return 0.0; }
    let dot:f64 = (dx / hl) * -0.628 + (dz / hl) * -0.778;
    if (dot < 0.0) { dot = 0.0; }
    return dot * dot;
}
// baseline alpha (verbatim r11 cirrus block alpha), for KB2 coverage
fn h3_base_alpha(dx:f64, dy:f64, dz:f64) f64 {
    let px:f64 = dx / (dy + 0.18) * 1.4;
    let pz:f64 = dz / (dy + 0.18) * 1.4;
    let wx:f64 = b_fbm2(px * 1.1 + 3.7, pz * 1.1 + 9.2, 601, 3);
    let cm:f64 = b_fbm2(px * 2.2 + (wx - 0.5) * 1.2, pz * 4.5, 602, 3);
    return b_ss((cm - 0.56) / 0.16) * b_ss((dy - 0.02) / 0.15) * 0.55;
}
// predicted byte-unit luma dL for one primary sky ray:
// baseline b_sky vs H3 candidate (dome gradient on clear-sky dome only)
fn h3_dl(dx:f64, dy:f64, dz:f64, GW:f64, GC:f64) f64 {
    let samt:f64 = b_sunamt(dx, dz);
    // clear-sky dome (verbatim baseline mixes)
    let hz_r:f64 = b_mix(0.45, 0.85, samt);
    let hz_g:f64 = b_mix(0.32, 0.45, samt);
    let hz_b:f64 = b_mix(0.44, 0.28, samt);
    let k1:f64 = b_ss(dy / 0.18);
    let k2:f64 = b_ss((dy - 0.15) / 0.65);
    let sr:f64 = b_mix(hz_r, b_mix(0.35, 0.13, k2), k1);
    let sg:f64 = b_mix(hz_g, b_mix(0.24, 0.12, k2), k1);
    let sb:f64 = b_mix(hz_b, b_mix(0.38, 0.26, k2), k1);
    // H3 DOME GRADIENT (NEW mechanism): sun-anchored luminance field on the
    // clear-sky dome, before disc/glow and before the cirrus block.
    let dg_w:f64 = b_ss((samt - 0.62) / 0.12);
    let dg_c:f64 = b_ss((0.68 - samt) / 0.12);
    let dg:f64 = 1.0 + GW * dg_w - GC * dg_c;
    dg = b_clamp(dg, 0.60, 1.40);
    let vr:f64 = sr;
    let vg:f64 = sg;
    let vb:f64 = sb;
    if (dy >= 0.0) {
        vr = sr * dg;
        vg = sg * dg;
        vb = sb * dg;
    }
    // sun disc + glow (verbatim, additive, identical in both)
    let sx:f64 = -0.617;
    let sy:f64 = 0.191;
    let sz:f64 = -0.764;
    let gdot:f64 = dx * sx + dy * sy + dz * sz;
    let cxm:f64 = dy * sz - dz * sy;
    let cym:f64 = dz * sx - dx * sz;
    let czm:f64 = dx * sy - dy * sx;
    let cross:f64 = b_sqrt(cxm * cxm + cym * cym + czm * czm);
    let disc:f64 = 1.0 - b_ss((cross - 0.0085) / 0.0011);
    let glow:f64 = 0.0;
    if (gdot > 0.0) {
        let gg:f64 = gdot * gdot;
        glow = gg * gg * 0.5;
    }
    let add:f64 = disc * 8.0 + glow;
    sr = sr + add * 1.0;
    sg = sg + add * 0.66;
    sb = sb + add * 0.42;
    vr = vr + add * 1.0;
    vg = vg + add * 0.66;
    vb = vb + add * 0.42;
    // baseline cirrus block (verbatim, identical in both)
    let px:f64 = dx / (dy + 0.18) * 1.4;
    let pz:f64 = dz / (dy + 0.18) * 1.4;
    let wx:f64 = b_fbm2(px * 1.1 + 3.7, pz * 1.1 + 9.2, 601, 3);
    let cm:f64 = b_fbm2(px * 2.2 + (wx - 0.5) * 1.2, pz * 4.5, 602, 3);
    let m:f64 = b_ss((cm - 0.56) / 0.16) * b_ss((dy - 0.02) / 0.15) * 0.55;
    let cr:f64 = b_mix(0.55, 1.0, samt);
    let cg:f64 = b_mix(0.42, 0.72, samt);
    let cb:f64 = b_mix(0.48, 0.55, samt);
    let f0r:f64 = b_clamp(b_mix(sr, cr, m), 0.0, 1.0);
    let f0g:f64 = b_clamp(b_mix(sg, cg, m), 0.0, 1.0);
    let f0b:f64 = b_clamp(b_mix(sb, cb, m), 0.0, 1.0);
    let f1r:f64 = b_clamp(b_mix(vr, cr, m), 0.0, 1.0);
    let f1g:f64 = b_clamp(b_mix(vg, cg, m), 0.0, 1.0);
    let f1b:f64 = b_clamp(b_mix(vb, cb, m), 0.0, 1.0);
    let dl:f64 = (299.0 * (f1r - f0r) + 587.0 * (f1g - f0g) + 114.0 * (f1b - f0b)) / 1000.0;
    return dl * 255.0;
}
// H3 dome field value (for KB10-ANCDOME prediction)
fn h3_dg(dx:f64, dz:f64, GW:f64, GC:f64) f64 {
    let samt:f64 = b_sunamt(dx, dz);
    let dg_w:f64 = b_ss((samt - 0.62) / 0.12);
    let dg_c:f64 = b_ss((0.68 - samt) / 0.12);
    return b_clamp(1.0 + GW * dg_w - GC * dg_c, 0.60, 1.40);
}
fn main() i32 {
    // frozen camera (b_render, w = h = 1024)
    let dirx:f64 = -40.0;
    let diry:f64 = -25.0;
    let dirz:f64 = -420.0;
    let dl:f64 = b_sqrt(dirx * dirx + diry * diry + dirz * dirz);
    dirx = dirx / dl; diry = diry / dl; dirz = dirz / dl;
    let rx:f64 = 0.0 - dirz;
    let rz:f64 = dirx;
    let rl:f64 = b_sqrt(rx * rx + rz * rz);
    rx = rx / rl; rz = rz / rl;
    let ux:f64 = 0.0 * dirz - rz * diry;
    let uy:f64 = rz * dirx - rx * dirz;
    let uz:f64 = rx * diry - 0.0 * dirx;
    let halfH:f64 = 0.5206;
    // phase 1: sunAmt distribution + baseline-alpha coverage over SKYWIN
    let k:i64 = 0;
    let ssun_n:i64 = 0;
    let ssun_sum:f64 = 0.0;
    let ssun_min:f64 = 2.0;
    let ssun_max:f64 = -2.0;
    let sant_n:i64 = 0;
    let sant_sum:f64 = 0.0;
    let sant_min:f64 = 2.0;
    let sant_max:f64 = -2.0;
    let cov_n:i64 = 0;
    while (k < 48) {
        let x:i64 = 320 + (k * 79 % 380);
        let y:i64 = 40 + (k * 53 % 160);
        let ndcx:f64 = (2.0 * (x as f64) + 1.0) / 1024.0 - 1.0;
        let ndcy:f64 = 1.0 - (2.0 * (y as f64) + 1.0) / 1024.0;
        let rdx:f64 = dirx + rx * ndcx * halfH + ux * ndcy * halfH;
        let rdy:f64 = diry + uy * ndcy * halfH;
        let rdz:f64 = dirz + rz * ndcx * halfH + uz * ndcy * halfH;
        let rll:f64 = b_sqrt(rdx * rdx + rdy * rdy + rdz * rdz);
        rdx = rdx / rll; rdy = rdy / rll; rdz = rdz / rll;
        let samt:f64 = b_sunamt(rdx, rdz);
        if (x < 510) {
            ssun_n = ssun_n + 1;
            ssun_sum = ssun_sum + samt;
            if (samt < ssun_min) { ssun_min = samt; }
            if (samt > ssun_max) { ssun_max = samt; }
        } else {
            sant_n = sant_n + 1;
            sant_sum = sant_sum + samt;
            if (samt < sant_min) { sant_min = samt; }
            if (samt > sant_max) { sant_max = samt; }
        }
        if (h3_base_alpha(rdx, rdy, rdz) > 0.15) { cov_n = cov_n + 1; }
        k = k + 1;
    }
    _zag_print("SUNAMT_SUNHALF n=");
    _zag_print(_zag_i64_to_str(ssun_n));
    _zag_print(" mean_x1000=");
    _zag_print(_zag_i64_to_str((ssun_sum / (ssun_n as f64) * 1000.0) as i64));
    _zag_print(" min_x1000=");
    _zag_print(_zag_i64_to_str((ssun_min * 1000.0) as i64));
    _zag_print(" max_x1000=");
    _zag_println(_zag_i64_to_str((ssun_max * 1000.0) as i64));
    _zag_print("SUNAMT_ANTISUN n=");
    _zag_print(_zag_i64_to_str(sant_n));
    _zag_print(" mean_x1000=");
    _zag_print(_zag_i64_to_str((sant_sum / (sant_n as f64) * 1000.0) as i64));
    _zag_print(" min_x1000=");
    _zag_print(_zag_i64_to_str((sant_min * 1000.0) as i64));
    _zag_print(" max_x1000=");
    _zag_println(_zag_i64_to_str((sant_max * 1000.0) as i64));
    _zag_print("COVERAGE_BASEALPHA_x10000=");
    _zag_println(_zag_i64_to_str(((cov_n as f64) / 48.0 * 10000.0) as i64));
    // phase 2: grid over (GW, GC); predict KB stats
    _zag_println("GW_x100 GC_x100 | sunmean antimean diff fsmean bigfrac_x10000 maxdl_x100 var_x100 dg_range_x1000 dg_argx");
    let gi:i64 = 0;
    while (gi < 16) {
        let GW:f64 = 0.10 + ((gi / 4) as f64) * 0.05;
        let GC:f64 = 0.20 + ((gi % 4) as f64) * 0.10;
        let sun_n:f64 = 0.0;
        let sun_s:f64 = 0.0;
        let ant_n:f64 = 0.0;
        let ant_s:f64 = 0.0;
        let sk_s:f64 = 0.0;
        let sk_s2:f64 = 0.0;
        let fs_n:f64 = 0.0;
        let fs_s:f64 = 0.0;
        let fs_big:f64 = 0.0;
        let fs_max:f64 = 0.0;
        let dg_max:f64 = -1.0;
        let dg_min:f64 = 2.0;
        let dg_argx:i64 = -1;
        let q:i64 = 0;
        while (q < 48) {
            let x:i64 = 320 + (q * 79 % 380);
            let y:i64 = 40 + (q * 53 % 160);
            let ndcx:f64 = (2.0 * (x as f64) + 1.0) / 1024.0 - 1.0;
            let ndcy:f64 = 1.0 - (2.0 * (y as f64) + 1.0) / 1024.0;
            let rdx:f64 = dirx + rx * ndcx * halfH + ux * ndcy * halfH;
            let rdy:f64 = diry + uy * ndcy * halfH;
            let rdz:f64 = dirz + rz * ndcx * halfH + uz * ndcy * halfH;
            let rll:f64 = b_sqrt(rdx * rdx + rdy * rdy + rdz * rdz);
            rdx = rdx / rll; rdy = rdy / rll; rdz = rdz / rll;
            let d:f64 = h3_dl(rdx, rdy, rdz, GW, GC);
            sk_s = sk_s + d;
            sk_s2 = sk_s2 + d * d;
            if (x < 510) { sun_n = sun_n + 1.0; sun_s = sun_s + d; } else { ant_n = ant_n + 1.0; ant_s = ant_s + d; }
            let g:f64 = h3_dg(rdx, rdz, GW, GC);
            if (g > dg_max) { dg_max = g; dg_argx = x; }
            if (g < dg_min) { dg_min = g; }
            q = q + 1;
        }
        q = 0;
        while (q < 144) {
            let x:i64 = 20 + (q * 67 % 984);
            let y:i64 = 10 + (q * 41 % 300);
            let ndcx:f64 = (2.0 * (x as f64) + 1.0) / 1024.0 - 1.0;
            let ndcy:f64 = 1.0 - (2.0 * (y as f64) + 1.0) / 1024.0;
            let rdx:f64 = dirx + rx * ndcx * halfH + ux * ndcy * halfH;
            let rdy:f64 = diry + uy * ndcy * halfH;
            let rdz:f64 = dirz + rz * ndcx * halfH + uz * ndcy * halfH;
            let rll:f64 = b_sqrt(rdx * rdx + rdy * rdy + rdz * rdz);
            rdx = rdx / rll; rdy = rdy / rll; rdz = rdz / rll;
            let d:f64 = h3_dl(rdx, rdy, rdz, GW, GC);
            fs_n = fs_n + 1.0;
            fs_s = fs_s + d;
            if (b_abs(d) > 12.0) { fs_big = fs_big + 1.0; }
            if (b_abs(d) > fs_max) { fs_max = b_abs(d); }
            q = q + 1;
        }
        let sun_m:f64 = sun_s / sun_n;
        let ant_m:f64 = ant_s / ant_n;
        let sk_m:f64 = sk_s / 48.0;
        let sk_v:f64 = sk_s2 / 48.0 - sk_m * sk_m;
        _zag_print(_zag_i64_to_str((GW * 100.0) as i64));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str((GC * 100.0) as i64));
        _zag_print(" | ");
        _zag_print(_zag_i64_to_str((sun_m * 100.0) as i64));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str((ant_m * 100.0) as i64));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str(((sun_m - ant_m) * 100.0) as i64));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str((fs_s / fs_n * 100.0) as i64));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str((fs_big / fs_n * 10000.0) as i64));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str((fs_max * 100.0) as i64));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str((sk_v * 100.0) as i64));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str(((dg_max - dg_min) * 1000.0) as i64));
        _zag_print(" ");
        _zag_println(_zag_i64_to_str(dg_argx));
        gi = gi + 1;
    }
    return 0;
}

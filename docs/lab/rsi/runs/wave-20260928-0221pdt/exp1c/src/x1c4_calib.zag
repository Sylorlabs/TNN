// x1c4_calib.zag -- EXP1c RETUNE ITERATION 4 calibration, pure Zag.
// Runs three scripted calibration strategies (f0 pure forage, f1
// stormflee, f2 patrol) plus a P-probe (taught ward strategy) and a
// Z-probe (fixed-seed LCG) on all 12 iteration-4 variants, 1200 ticks
// each. Prints raw calibration TSV rows plus Zag-computed medians.
// mode_check (xp_check_all on every variant's params) gates the whole
// calibration: on any failure it prints CALIB_BLOCKED and exits nonzero
// before any calibration run.
//
// C3 (binding 2321pdt fix): the "qualitatively distinct" qualifier is
// STRUCK as unsupported by measurement (the 2321pdt judge: f2 vector
// diffs were e_end-only, dXY >= 1 is a hair trigger, the calibrators
// sit at the 1200 ceiling and discriminate nothing about survival).
// The in-Zag per-variant (ticks, e_end) vector comparison is kept as a
// reported measurement (the 2021pdt R1 fix), not as a distinctness
// certification. C3 is evaluated on the measurable gate: three scripted
// strategies each reaching median >= 720. Code-level strategy
// differences remain documented from source reading.

@import("x1c4_variants.zag")
@import("x1c4_agents.zag")
@import("x1c4_out.zag")

// median of 12 values at base (average of 6th and 7th order statistics),
// sorts in place
fn med12(v:[]i32, base:i32)i32 {
    let i:i32 = 1;
    while (i < 12) {
        let x:i32 = v[base+i];
        let j:i32 = i - 1;
        while (j >= 0 && v[base+j] > x) {
            v[base+j+1] = v[base+j];
            j = j - 1;
        }
        v[base+j+1] = x;
        i = i+1;
    }
    return (v[base+5] + v[base+6]) / 2;
}

fn main()i32 {
    let mu:*u8 = _zag_malloc(8192);
    let u8a:[]u8 = mu[0..8192];
    let b:XBuf = xb_new(u8a, 0, 8192);
    // One i32 arena, carved by offsets (znc slice discipline: allocate
    // up front, no interleaved live slices of the same type).
    let mi:*i32 = _zag_malloc(4096*4) as *i32;
    let arena:[]i32 = mi[0..4096];
    let wmem:[]i32 = arena[0..1024];
    let pdat:[]i32 = arena[1024..2048];
    let surv:[]i32 = arena[2048..2304];
    // surv layout per strategy s (0=f0,1=f1,2=f2,3=P-probe,4=Z-probe):
    // ticks at s*24+v, energy at s*24+12+v
    // 1. mode_check gates calibration: every variant's params must pass
    // xp_check_all before any run.
    let v:i32 = 0;
    while (v < 12) {
        let p:XParams = xp_new(pdat);
        let q:i32 = x1c4_fill(v, &p);
        if (xp_check_all(&p) != 0) {
            q = xb_str(&b, "CALIB_BLOCKED X1C_ITER=4 variant=");
            q = xb_i32(&b, v);
            q = xb_nl(&b);
            return 1;
        }
        v = v + 1;
    }
    // 2. Run calibration: 12 variants x 5 strategies x 1200 ticks.
    v = 0;
    while (v < 12) {
        let p:XParams = xp_new(pdat);
        let q:i32 = x1c4_fill(v, &p);
        let s:i32 = 0;
        while (s < 5) {
            let w:World = w_new(wmem, 0);
            let qa:i32 = xp_apply(&w, &p);
            let st:AState = a_new();
            if (s == 2) {
                // f2 patrol segment [home-2, home+2], clamped; void-free
                // by family design.
                let hi:i32 = w.home + 2;
                if (hi > 23) { hi = 23; }
                let lo:i32 = w.home - 2;
                if (lo < 0) { lo = 0; }
                st.ca = hi;
                st.cb = lo;
                st.aux0 = 0;
            }
            if (s == 4) { st = z_new(777); }
            let t:i32 = 0;
            while (t < 1200 && w.alive == 1) {
                let a:i32 = 6;
                if (s == 0) { a = f0_forage(&w, &st); }
                if (s == 1) { a = f1_stormflee(&w, &st); }
                if (s == 2) { a = f2_patrol(&w, &st); }
                if (s == 3) { a = p_act(&w, &st); }
                if (s == 4) { a = z_act(&w, &st); }
                w_step(&w, a, st.ca, st.cb);
                t = t + 1;
            }
            surv[s*24+v] = t;
            surv[s*24+12+v] = w.energy;
            q = xb_str(&b, "CALIB\t");
            q = xb_i32(&b, v);
            q = xb_tab(&b);
            q = xb_i32(&b, s);
            q = xb_tab(&b);
            q = xb_i32(&b, t);
            q = xb_tab(&b);
            q = xb_i32(&b, w.energy);
            q = xb_nl(&b);
            s = s + 1;
        }
        v = v + 1;
    }
    // 3. Zag-computed medians.
    let mf:i32 = med12(surv, 0);
    let m1:i32 = med12(surv, 24);
    let m2:i32 = med12(surv, 48);
    let mp:i32 = med12(surv, 72);
    let mz:i32 = med12(surv, 96);
    // 4. Per-variant outcome-vector comparison on (ticks, e_end), kept as
    // a reported measurement (not a distinctness certification).
    // dXY = number of variants where strategies X and Y differ.
    let d01:i32 = 0;
    let d02:i32 = 0;
    let d12:i32 = 0;
    v = 0;
    while (v < 12) {
        if (surv[0*24+v] != surv[1*24+v] || surv[0*24+12+v] != surv[1*24+12+v]) { d01 = d01 + 1; }
        if (surv[0*24+v] != surv[2*24+v] || surv[0*24+12+v] != surv[2*24+12+v]) { d02 = d02 + 1; }
        if (surv[1*24+v] != surv[2*24+v] || surv[1*24+12+v] != surv[2*24+12+v]) { d12 = d12 + 1; }
        v = v + 1;
    }
    let c3:i32 = 0;
    if (mf >= 720 && m1 >= 720 && m2 >= 720) { c3 = 1; }
    let q:i32 = xb_str(&b, "X1C_ITER=4 MEDIANS f0=");
    q = xb_i32(&b, mf);
    q = xb_str(&b, " f1=");
    q = xb_i32(&b, m1);
    q = xb_str(&b, " f2=");
    q = xb_i32(&b, m2);
    q = xb_str(&b, " p_probe=");
    q = xb_i32(&b, mp);
    q = xb_str(&b, " z_probe=");
    q = xb_i32(&b, mz);
    q = xb_nl(&b);
    q = xb_str(&b, "X1C_ITER=4 C3_VEC d01=");
    q = xb_i32(&b, d01);
    q = xb_str(&b, " d02=");
    q = xb_i32(&b, d02);
    q = xb_str(&b, " d12=");
    q = xb_i32(&b, d12);
    q = xb_str(&b, " (measurement only; distinctness qualifier struck)");
    q = xb_nl(&b);
    q = xb_str(&b, "X1C_ITER=4 C3=");
    q = xb_i32(&b, c3);
    q = xb_nl(&b);
    return 0;
}

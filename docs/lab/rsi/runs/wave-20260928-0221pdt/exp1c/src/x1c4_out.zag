// x1c4_out.zag -- EXP1c output helpers (Buf pattern), wave-20260928-0221pdt.
// Attempt 4, written from scratch. Pure Zag. Line-buffered writer:
// bytes accumulate in a u8 arena; o_nl flushes one line via _zag_println.
struct XBuf {
    arena:[]u8,
    base:i32,
    pos:i32,
    cap:i32,
}

fn xb_new(arena:[]u8, base:i32, cap:i32)XBuf {
    return XBuf{.arena=arena, .base=base, .pos=0, .cap=cap};
}

fn xb_str(b:*XBuf, s:[]u8)i32 {
    let i:i32 = 0;
    while (i < s.len) {
        if (b.pos < b.cap) { b.arena[b.base+b.pos] = s[i]; b.pos = b.pos+1; }
        i = i+1;
    }
    return 0;
}

fn xb_ch(b:*XBuf, c:u8)i32 {
    if (b.pos < b.cap) { b.arena[b.base+b.pos] = c; b.pos = b.pos+1; }
    return 0;
}

fn xb_i32(b:*XBuf, v:i32)i32 {
    let x:i32 = v;
    if (x < 0) { xb_ch(b, 45); x = 0 - x; }
    if (x == 0) { xb_ch(b, 48); return 0; }
    let tmp:*u8 = _zag_malloc(16);
    let t:[]u8 = tmp[0..16];
    let n:i32 = 0;
    while (x > 0) { t[15-n] = (48 + x%10) as u8; x = x/10; n = n+1; }
    let j:i32 = 0;
    while (j < n) { xb_ch(b, t[16-n+j]); j = j+1; }
    return 0;
}

fn xb_tab(b:*XBuf)i32 { return xb_ch(b, 9); }

fn xb_nl(b:*XBuf)i32 {
    let t:*u8 = _zag_malloc(b.pos);
    let ts:[]u8 = t[0..b.pos];
    let i:i32 = 0;
    while (i < b.pos) { ts[i] = b.arena[b.base+i]; i = i+1; }
    _zag_println(ts);
    b.pos = 0;
    return 0;
}

// x1c4_variants.zag -- EXP1c 12 world variants, RETUNE ITERATION 4.
// Wave-20260928-0221pdt implementation worker, written from scratch.
// Family: clustered-mote (vel=0 with lo<hi, tight drift ranges per the
// binding stationarity requirement). Every mote, crystal, start, and home
// sits on the same side of the void pair; void pairs cycle (10,11),
// (4,5), (16,17). Home sits outside the storm zone [6,17] so the taught
// ward strategy can shelter. Motes cluster near home and start (a compact
// food region) to give blind enumeration a fair survival chance; the
// choice phase is measured, not assumed. Four crystals, three storms in
// thirds of the 1200-tick horizon.
// The iteration label below is written by this iteration's emitter.

@import("x1c4_params.zag")

const X1C_ITER:i32 = 4;

fn x1c4_mote(d:[]i32, i:i32, pos:i32, lo:i32, hi:i32, deep:i32)i32 {
    d[XP_MPOS+i] = pos;
    d[XP_MVEL+i] = 0;
    d[XP_MLO+i] = lo;
    d[XP_MHI+i] = hi;
    d[XP_MRESP+i] = pos;
    d[XP_MDEEP+i] = deep;
    return 0;
}

fn x1c4_fill(v:i32, p:*XParams)i32 {
    let d:[]i32 = p.dat;
    let q:i32 = 0;
    if (v == 0) {
        p.void0 = 10; p.void1 = 11; p.start = 17; p.home = 20;
        d[XP_CRYS+0]=14; d[XP_CRYS+1]=18; d[XP_CRYS+2]=22; d[XP_CRYS+3]=16;
        d[XP_SS+0]=240; d[XP_SE+0]=275; d[XP_SS+1]=590; d[XP_SE+1]=630; d[XP_SS+2]=940; d[XP_SE+2]=980;
        q = x1c4_mote(d, 0, 19, 18, 19, 0);
        q = x1c4_mote(d, 1, 21, 21, 22, 0);
        q = x1c4_mote(d, 2, 16, 15, 16, 0);
        q = x1c4_mote(d, 3, 22, 22, 23, 0);
        q = x1c4_mote(d, 4, 15, 15, 16, 1);
        q = x1c4_mote(d, 5, 23, 22, 23, 1);
        return 0;
    }
    if (v == 1) {
        p.void0 = 10; p.void1 = 11; p.start = 18; p.home = 20;
        d[XP_CRYS+0]=13; d[XP_CRYS+1]=17; d[XP_CRYS+2]=21; d[XP_CRYS+3]=23;
        d[XP_SS+0]=210; d[XP_SE+0]=250; d[XP_SS+1]=560; d[XP_SE+1]=600; d[XP_SS+2]=910; d[XP_SE+2]=950;
        q = x1c4_mote(d, 0, 19, 18, 19, 0);
        q = x1c4_mote(d, 1, 21, 21, 22, 0);
        q = x1c4_mote(d, 2, 16, 16, 17, 0);
        q = x1c4_mote(d, 3, 22, 21, 22, 0);
        q = x1c4_mote(d, 4, 15, 14, 15, 1);
        q = x1c4_mote(d, 5, 23, 22, 23, 1);
        return 0;
    }
    if (v == 2) {
        p.void0 = 10; p.void1 = 11; p.start = 16; p.home = 19;
        d[XP_CRYS+0]=12; d[XP_CRYS+1]=17; d[XP_CRYS+2]=20; d[XP_CRYS+3]=23;
        d[XP_SS+0]=250; d[XP_SE+0]=290; d[XP_SS+1]=600; d[XP_SE+1]=640; d[XP_SS+2]=950; d[XP_SE+2]=990;
        q = x1c4_mote(d, 0, 18, 17, 18, 0);
        q = x1c4_mote(d, 1, 20, 20, 21, 0);
        q = x1c4_mote(d, 2, 15, 15, 16, 0);
        q = x1c4_mote(d, 3, 22, 22, 23, 0);
        q = x1c4_mote(d, 4, 14, 13, 14, 1);
        q = x1c4_mote(d, 5, 21, 21, 22, 1);
        return 0;
    }
    if (v == 3) {
        p.void0 = 10; p.void1 = 11; p.start = 17; p.home = 21;
        d[XP_CRYS+0]=14; d[XP_CRYS+1]=16; d[XP_CRYS+2]=19; d[XP_CRYS+3]=23;
        d[XP_SS+0]=220; d[XP_SE+0]=260; d[XP_SS+1]=570; d[XP_SE+1]=610; d[XP_SS+2]=920; d[XP_SE+2]=960;
        q = x1c4_mote(d, 0, 19, 18, 19, 0);
        q = x1c4_mote(d, 1, 20, 19, 20, 0);
        q = x1c4_mote(d, 2, 16, 15, 16, 0);
        q = x1c4_mote(d, 3, 22, 22, 23, 0);
        q = x1c4_mote(d, 4, 15, 14, 15, 1);
        q = x1c4_mote(d, 5, 18, 17, 18, 1);
        return 0;
    }
    if (v == 4) {
        p.void0 = 4; p.void1 = 5; p.start = 15; p.home = 20;
        d[XP_CRYS+0]=10; d[XP_CRYS+1]=16; d[XP_CRYS+2]=19; d[XP_CRYS+3]=23;
        d[XP_SS+0]=230; d[XP_SE+0]=270; d[XP_SS+1]=580; d[XP_SE+1]=620; d[XP_SS+2]=930; d[XP_SE+2]=970;
        q = x1c4_mote(d, 0, 18, 17, 18, 0);
        q = x1c4_mote(d, 1, 21, 21, 22, 0);
        q = x1c4_mote(d, 2, 14, 13, 14, 0);
        q = x1c4_mote(d, 3, 22, 22, 23, 0);
        q = x1c4_mote(d, 4, 12, 12, 13, 1);
        q = x1c4_mote(d, 5, 17, 16, 17, 1);
        return 0;
    }
    if (v == 5) {
        p.void0 = 4; p.void1 = 5; p.start = 16; p.home = 21;
        d[XP_CRYS+0]=11; d[XP_CRYS+1]=15; d[XP_CRYS+2]=20; d[XP_CRYS+3]=23;
        d[XP_SS+0]=240; d[XP_SE+0]=280; d[XP_SS+1]=590; d[XP_SE+1]=630; d[XP_SS+2]=940; d[XP_SE+2]=980;
        q = x1c4_mote(d, 0, 19, 18, 19, 0);
        q = x1c4_mote(d, 1, 20, 19, 20, 0);
        q = x1c4_mote(d, 2, 15, 14, 15, 0);
        q = x1c4_mote(d, 3, 22, 22, 23, 0);
        q = x1c4_mote(d, 4, 13, 12, 13, 1);
        q = x1c4_mote(d, 5, 18, 17, 18, 1);
        return 0;
    }
    if (v == 6) {
        p.void0 = 4; p.void1 = 5; p.start = 17; p.home = 20;
        d[XP_CRYS+0]=12; d[XP_CRYS+1]=15; d[XP_CRYS+2]=19; d[XP_CRYS+3]=22;
        d[XP_SS+0]=250; d[XP_SE+0]=290; d[XP_SS+1]=600; d[XP_SE+1]=640; d[XP_SS+2]=950; d[XP_SE+2]=990;
        q = x1c4_mote(d, 0, 19, 18, 19, 0);
        q = x1c4_mote(d, 1, 21, 21, 22, 0);
        q = x1c4_mote(d, 2, 16, 15, 16, 0);
        q = x1c4_mote(d, 3, 22, 22, 23, 0);
        q = x1c4_mote(d, 4, 14, 13, 14, 1);
        q = x1c4_mote(d, 5, 18, 17, 18, 1);
        return 0;
    }
    if (v == 7) {
        p.void0 = 4; p.void1 = 5; p.start = 14; p.home = 19;
        d[XP_CRYS+0]=9; d[XP_CRYS+1]=15; d[XP_CRYS+2]=18; d[XP_CRYS+3]=22;
        d[XP_SS+0]=210; d[XP_SE+0]=250; d[XP_SS+1]=560; d[XP_SE+1]=600; d[XP_SS+2]=910; d[XP_SE+2]=950;
        q = x1c4_mote(d, 0, 17, 16, 17, 0);
        q = x1c4_mote(d, 1, 20, 20, 21, 0);
        q = x1c4_mote(d, 2, 13, 12, 13, 0);
        q = x1c4_mote(d, 3, 21, 21, 22, 0);
        q = x1c4_mote(d, 4, 11, 10, 11, 1);
        q = x1c4_mote(d, 5, 18, 17, 18, 1);
        return 0;
    }
    if (v == 8) {
        p.void0 = 16; p.void1 = 17; p.start = 7; p.home = 3;
        d[XP_CRYS+0]=1; d[XP_CRYS+1]=4; d[XP_CRYS+2]=9; d[XP_CRYS+3]=13;
        d[XP_SS+0]=230; d[XP_SE+0]=270; d[XP_SS+1]=580; d[XP_SE+1]=620; d[XP_SS+2]=930; d[XP_SE+2]=970;
        q = x1c4_mote(d, 0, 5, 4, 5, 0);
        q = x1c4_mote(d, 1, 8, 8, 9, 0);
        q = x1c4_mote(d, 2, 2, 1, 2, 0);
        q = x1c4_mote(d, 3, 10, 9, 10, 0);
        q = x1c4_mote(d, 4, 6, 6, 7, 1);
        q = x1c4_mote(d, 5, 11, 11, 12, 1);
        return 0;
    }
    if (v == 9) {
        p.void0 = 16; p.void1 = 17; p.start = 8; p.home = 4;
        d[XP_CRYS+0]=0; d[XP_CRYS+1]=5; d[XP_CRYS+2]=10; d[XP_CRYS+3]=14;
        d[XP_SS+0]=240; d[XP_SE+0]=280; d[XP_SS+1]=590; d[XP_SE+1]=630; d[XP_SS+2]=940; d[XP_SE+2]=980;
        q = x1c4_mote(d, 0, 6, 5, 6, 0);
        q = x1c4_mote(d, 1, 9, 9, 10, 0);
        q = x1c4_mote(d, 2, 3, 2, 3, 0);
        q = x1c4_mote(d, 3, 11, 10, 11, 0);
        q = x1c4_mote(d, 4, 7, 7, 8, 1);
        q = x1c4_mote(d, 5, 12, 11, 12, 1);
        return 0;
    }
    if (v == 10) {
        p.void0 = 16; p.void1 = 17; p.start = 6; p.home = 2;
        d[XP_CRYS+0]=3; d[XP_CRYS+1]=8; d[XP_CRYS+2]=11; d[XP_CRYS+3]=14;
        d[XP_SS+0]=220; d[XP_SE+0]=260; d[XP_SS+1]=570; d[XP_SE+1]=610; d[XP_SS+2]=920; d[XP_SE+2]=960;
        q = x1c4_mote(d, 0, 4, 3, 4, 0);
        q = x1c4_mote(d, 1, 7, 7, 8, 0);
        q = x1c4_mote(d, 2, 1, 0, 1, 0);
        q = x1c4_mote(d, 3, 9, 8, 9, 0);
        q = x1c4_mote(d, 4, 5, 5, 6, 1);
        q = x1c4_mote(d, 5, 10, 9, 10, 1);
        return 0;
    }
    // v == 11
    p.void0 = 16; p.void1 = 17; p.start = 9; p.home = 5;
    d[XP_CRYS+0]=1; d[XP_CRYS+1]=6; d[XP_CRYS+2]=11; d[XP_CRYS+3]=15;
    d[XP_SS+0]=250; d[XP_SE+0]=290; d[XP_SS+1]=600; d[XP_SE+1]=640; d[XP_SS+2]=950; d[XP_SE+2]=990;
    q = x1c4_mote(d, 0, 7, 6, 7, 0);
    q = x1c4_mote(d, 1, 10, 10, 11, 0);
    q = x1c4_mote(d, 2, 4, 3, 4, 0);
    q = x1c4_mote(d, 3, 12, 11, 12, 0);
    q = x1c4_mote(d, 4, 8, 8, 9, 1);
    q = x1c4_mote(d, 5, 13, 12, 13, 1);
    return 0;
}

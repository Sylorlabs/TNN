// x1c4_run.zag -- EXP1c full experiment runner, wave-20260928-0221pdt.
// Attempt 4. 12 variants x 7 arms (P, R, Z, I-survive, I-invent,
// I-survive-abl, I-invent-abl) x 1200 ticks. The two ablation arms are
// prereg-authorized by frozen K6 (ablation A2: removing
// novel-composition steps); the frozen "5 arms" budget line counts the
// primary arms. mode_check gates the run.
// Emits raw RUN and IDIAG TSV rows to stdout. Pure Zag. All runs are
// deterministic; execute twice and verify byte-identical SHA-256.

@import("x1c4_variants.zag")
@import("x1c4_agents.zag")
@import("x1c4_out.zag")

fn main()i32 {
    let mu:*u8 = _zag_malloc(65536);
    let u8a:[]u8 = mu[0..65536];
    let b:XBuf = xb_new(u8a, 0, 65536);
    let mi:*i32 = _zag_malloc(4096*4) as *i32;
    let arena:[]i32 = mi[0..4096];
    let wmem:[]i32 = arena[0..1024];
    let pdat:[]i32 = arena[1024..2048];
    let mg:*i64 = _zag_malloc(2048*8) as *i64;
    let xmem:[]i64 = mg[0..2048];
    // 1. mode_check gates the experiment.
    let v:i32 = 0;
    while (v < 12) {
        let p:XParams = xp_new(pdat);
        let q:i32 = x1c4_fill(v, &p);
        if (xp_check_all(&p) != 0) {
            q = xb_str(&b, "RUN_BLOCKED X1C_ITER=4 variant=");
            q = xb_i32(&b, v);
            q = xb_nl(&b);
            return 1;
        }
        v = v + 1;
    }
    // 2. Run: 12 variants x 7 arms x 1200 ticks.
    v = 0;
    while (v < 12) {
        let p:XParams = xp_new(pdat);
        let q:i32 = x1c4_fill(v, &p);
        let arm:i32 = 0;
        while (arm < 7) {
            let w:World = w_new(wmem, 0);
            q = xp_apply(&w, &p);
            let ticks:i32 = 0;
            let cause:i32 = 0;
            let e_end:i32 = 0;
            // I-arm diagnostics
            let dr:i32 = 0;
            let dd:i32 = 0;
            let de:i32 = -1;
            let dpt:i32 = 0;
            let dpl:i32 = 0;
            let dnl:i32 = 0;
            if (arm <= 2) {
                let st:AState = a_new();
                if (arm == 2) { st = z_new(777); }
                let t:i32 = 0;
                while (t < 1200 && w.alive == 1) {
                    let a:i32 = 6;
                    if (arm == 0) { a = p_act(&w, &st); }
                    if (arm == 1) { a = r_act(&w, &st); }
                    if (arm == 2) { a = z_act(&w, &st); }
                    w_step(&w, a, st.ca, st.cb);
                    t = t + 1;
                }
                ticks = t;
                cause = w.cause;
                e_end = w.energy;
            } else {
                let b0:i32 = 40;
                if (arm == 4 || arm == 6) { b0 = 120; }
                let xst:XIState = xi_new(xmem, 0, b0);
                if (arm == 5 || arm == 6) { xst.no_combine = 1; }
                let t:i32 = 0;
                while (t < 1200 && w.alive == 1) {
                    let a:i32 = xi_act(&w, &xst);
                    w_step(&w, a, xst.ca, xst.cb);
                    t = t + 1;
                }
                ticks = t;
                cause = w.cause;
                e_end = w.energy;
                dr = xst.n_replans;
                dd = xst.n_distinct;
                de = xst.enum_tick;
                dpt = xst.post_total;
                dpl = xst.post_learned;
                dnl = xst.nlog;
            }
            q = xb_str(&b, "RUN\t");
            q = xb_i32(&b, v);
            q = xb_tab(&b);
            q = xb_i32(&b, arm);
            q = xb_tab(&b);
            q = xb_i32(&b, ticks);
            q = xb_tab(&b);
            q = xb_i32(&b, e_end);
            q = xb_tab(&b);
            q = xb_i32(&b, cause);
            q = xb_nl(&b);
            if (arm >= 3) {
                q = xb_str(&b, "IDIAG\t");
                q = xb_i32(&b, v);
                q = xb_tab(&b);
                q = xb_i32(&b, arm);
                q = xb_tab(&b);
                q = xb_i32(&b, dr);
                q = xb_tab(&b);
                q = xb_i32(&b, dd);
                q = xb_tab(&b);
                q = xb_i32(&b, de);
                q = xb_tab(&b);
                q = xb_i32(&b, dpt);
                q = xb_tab(&b);
                q = xb_i32(&b, dpl);
                q = xb_tab(&b);
                q = xb_i32(&b, dnl);
                q = xb_nl(&b);
            }
            arm = arm + 1;
        }
        v = v + 1;
    }
    return 0;
}

// fork_battery.zag
//
// Pure Zag port of the frozen fork battery.
// Spec: docs/lab/rsi/runs/wave-20260923-1121pdt/FROZEN_FORK_BATTERY.md
// (wave 20260923-1121pdt, frozen 2026-09-23 PDT; includes the two corrected
// invocations: compile with znc -o <binary> then run the binary directly,
// never parsing znc's stdout status line into program output; and
// znc check file.zag --strict --no-zagd for strict checks).
//
// What this program does:
//   B1: compile the canonical hello program with the znc binary named in
//       ./znc.path, run the produced binary directly, capture the binary's
//       stdout, and require it byte identical to FORKBATTERY-OK 42.
//   B2: rerun the binary (stdout must match), compile twice (binaries must
//       be byte identical).
//   B3: znc check file.zag --strict --no-zagd must exit 0.
//   NEG1/NEG2: the two negative controls must FAIL as the spec requires
//       (NEG1: compile and check exit nonzero; NEG2: compiles and passes
//       check but its stdout differs from the reference).
//   Verdict PASS iff B1 and B2 and B3 pass and both negative controls fail
//   as required. Prints a full evidence report and returns 0 on PASS,
//   1 otherwise.
//
// How it runs subprocesses: fork/pipe/dup2/execve/wait4 via _zag_raw_syscall
// on Linux x86-64 (pipe=22, dup2=33, fork=57, execve=59, exit=60,
// wait4=61, open=2, close=3, read=0). The child dups the pipe onto stdout,
// /dev/null onto stderr, then execve. The parent reads all of the child's
// stdout from the pipe and decodes the wait4 status. No shell, no Python,
// no RNG anywhere in this program: it is fully deterministic.
//
// Input contract: current working directory is the per fork scratch dir.
// ./znc.path holds the znc binary path (trailing newline tolerated).
// Optional ./hello_override.zag: if present and nonempty, its bytes replace
// the embedded hello source (used only for the battery's own negative
// control probe; the standard run never creates it).
//
// Pure Zag. Shell is used only to build this file and to run it.

fn sc(n:i64,a:i64,b:i64,c:i64,d:i64,e:i64,f:i64)i64 {
    return _zag_raw_syscall(n,a,b,c,d,e,f);
}

fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn nio_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn nio_cstr(s:[]u8)[]u8 {
    let out:[]u8=nio_alloc(s.len+1);
    if(out.len==0){return out;}
    let i:i32=0;
    while(i<s.len){out[i]=s[i];i=i+1;}
    out[s.len]=0;
    return out;
}

fn p64(b:[]u8,o:i32,v:i64)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
    b[o+4]=((v>>32)&255) as u8;
    b[o+5]=((v>>40)&255) as u8;
    b[o+6]=((v>>48)&255) as u8;
    b[o+7]=((v>>56)&255) as u8;
    return;
}

fn g32(b:[]u8,o:i32)i32 {
    let v:i32=(b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
    return v;
}

fn nio_equal(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

// ---------------- print helpers ----------------
fn p_raw(s:[]u8)void {
    _zag_print(s);
    return;
}

fn p_nl()void {
    _zag_print("\n");
    return;
}

fn p_i64(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){_zag_print(s[0..s.len-1]);}
        else{_zag_print(s);}
    }
    return;
}

fn p_kv(name:[]u8,v:i64)void {
    _zag_print(name);
    _zag_print("=");
    p_i64(v);
    _zag_print(" ");
    return;
}

// ---------------- file IO (Linux x86-64 syscalls) ----------------
fn read_file(path:[]u8,buf:[]u8,maxb:i32)i32 {
    let cs:[]u8=nio_cstr(path);
    if(cs.len==0){return -1;}
    let fd:i64=sc(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    nio_free(cs);
    if(fd<0){return -1;}
    let total:i32=0;
    let base:i64=_zag_slice_ptr(buf) as i64;
    let open:i32=1;
    while(open!=0){
        if(total>=maxb){open=0;}
        if(open!=0){
            let n:i64=sc(0,fd,base+(total as i64),(maxb-total) as i64,0,0,0);
            if(n==0){open=0;}
            if(n>0){total=total+(n as i32);}
            if(n<0){
                if(n!=-4){open=0;}
            }
        }
    }
    sc(3,fd,0,0,0,0,0);
    return total;
}

fn write_file(path:[]u8,data:[]u8)i32 {
    let cs:[]u8=nio_cstr(path);
    if(cs.len==0){return -1;}
    let fd:i64=sc(2,_zag_slice_ptr(cs) as i64,577,420,0,0,0);
    nio_free(cs);
    if(fd<0){return -1;}
    let total:i32=0;
    let base:i64=_zag_slice_ptr(data) as i64;
    while(total<data.len){
        let n:i64=sc(1,fd,base+(total as i64),(data.len-total) as i64,0,0,0);
        if(n<=0){
            if(n!=-4){sc(3,fd,0,0,0,0,0);return -1;}
        }
        if(n>0){total=total+(n as i32);}
    }
    sc(3,fd,0,0,0,0,0);
    return 0;
}

// ---------------- subprocess: fork/pipe/execve/wait4 ----------------
//
// run_capture(prog, a0..a6, out, maxb, rc):
//   prog: binary path. a0: argv[0]. a1..a6: further args; an empty arg is
//   skipped. The child's stdout is captured into out (up to maxb bytes);
//   the child's stderr goes to /dev/null. The byte count is stored into
//   rc (8 bytes, little endian). Returns the child exit code, or a
//   negative infrastructure code (pipe/fork/wait4 failure, or -signal if
//   killed by a signal).
fn run_capture(prog:[]u8,a0:[]u8,a1:[]u8,a2:[]u8,a3:[]u8,a4:[]u8,a5:[]u8,a6:[]u8,out:[]u8,maxb:i32,rc:[]u8)i64 {
    let fds:[]u8=nio_alloc(8);
    if(fds.len==0){return -110;}
    if(sc(22,_zag_slice_ptr(fds) as i64,0,0,0,0,0)!=0){nio_free(fds);return -111;}
    let rfd:i64=g32(fds,0) as i64;
    let wfd:i64=g32(fds,4) as i64;
    nio_free(fds);
    let pcs:[]u8=nio_cstr(prog);
    let c0:[]u8=nio_cstr(a0);
    let c1:[]u8=nio_cstr(a1);
    let c2:[]u8=nio_cstr(a2);
    let c3:[]u8=nio_cstr(a3);
    let c4:[]u8=nio_cstr(a4);
    let c5:[]u8=nio_cstr(a5);
    let c6:[]u8=nio_cstr(a6);
    let argv:[]u8=nio_alloc(9*8);
    p64(argv,0,_zag_slice_ptr(c0) as i64);
    let narg:i32=1;
    if(a1.len>0){p64(argv,narg*8,_zag_slice_ptr(c1) as i64);narg=narg+1;}
    if(a2.len>0){p64(argv,narg*8,_zag_slice_ptr(c2) as i64);narg=narg+1;}
    if(a3.len>0){p64(argv,narg*8,_zag_slice_ptr(c3) as i64);narg=narg+1;}
    if(a4.len>0){p64(argv,narg*8,_zag_slice_ptr(c4) as i64);narg=narg+1;}
    if(a5.len>0){p64(argv,narg*8,_zag_slice_ptr(c5) as i64);narg=narg+1;}
    if(a6.len>0){p64(argv,narg*8,_zag_slice_ptr(c6) as i64);narg=narg+1;}
    p64(argv,narg*8,0);
    let pid:i64=sc(57,0,0,0,0,0,0);
    if(pid<0){
        nio_free(pcs);nio_free(c0);nio_free(c1);nio_free(c2);
        nio_free(c3);nio_free(c4);nio_free(c5);nio_free(c6);nio_free(argv);
        return -112;
    }
    if(pid==0){
        sc(33,wfd,1,0,0,0,0);
        let dn:[]u8=nio_cstr("/dev/null");
        let dfd:i64=sc(2,_zag_slice_ptr(dn) as i64,1,0,0,0,0);
        if(dfd>=0){sc(33,dfd,2,0,0,0,0);}
        sc(3,rfd,0,0,0,0,0);
        sc(3,wfd,0,0,0,0,0);
        sc(59,_zag_slice_ptr(pcs) as i64,_zag_slice_ptr(argv) as i64,0,0,0,0);
        sc(60,127,0,0,0,0,0);
    }
    nio_free(pcs);nio_free(c0);nio_free(c1);nio_free(c2);
    nio_free(c3);nio_free(c4);nio_free(c5);nio_free(c6);nio_free(argv);
    sc(3,wfd,0,0,0,0,0);
    let total:i32=0;
    let base:i64=_zag_slice_ptr(out) as i64;
    let open:i32=1;
    while(open!=0){
        if(total>=maxb){open=0;}
        if(open!=0){
            let n:i64=sc(0,rfd,base+(total as i64),(maxb-total) as i64,0,0,0);
            if(n==0){open=0;}
            if(n>0){total=total+(n as i32);}
            if(n<0){
                if(n!=-4){open=0;}
            }
        }
    }
    sc(3,rfd,0,0,0,0,0);
    let st:[]u8=nio_alloc(4);
    if(st.len==0){return -113;}
    if(sc(61,pid,_zag_slice_ptr(st) as i64,0,0,0,0)<0){nio_free(st);return -114;}
    let status:i32=g32(st,0);
    nio_free(st);
    p64(rc,0,total as i64);
    if((status&127)==0){return ((status>>8)&255) as i64;}
    return 0-((status&127) as i64);
}

// ---------------- SHA-256 (vendored, R33_NATIVE_SHA256_V2) ----------------
// RFC 6234 section 5.1 constants. Native bounded SHA-256 for artifact
// identity. Requires nio_alloc/nio_free from above.
fn ns_hex_digit(c:i32)i64 {
    if(c>=48 && c<=57){return (c-48) as i64;}
    if(c>=97 && c<=102){return (c-87) as i64;}return -1;
}
fn ns_hex_word(text:[]u8,at:i32)i64 {
    if(at<0 || text.len<8 || at>text.len-8){return -1;}
    let x:i64=0;let i:i32=0;
    while(i<8){let d:i64=ns_hex_digit(text[at+i] as i32);if(d<0){return -1;}x=x*16+d;i=i+1;}return x;
}
fn ns_load_words(text:[]u8,out:[]i64)i32 {
    if(out.len<1 || out.len>64 || text.len!=out.len*9-1){return -1;}
    let i:i32=0;
    while(i<out.len){
        if(ns_hex_word(text,i*9)<0){return -1;}
        if(i<out.len-1 && text[i*9+8]!=32){return -1;}i=i+1;
    }
    i=0;while(i<out.len){out[i]=ns_hex_word(text,i*9);i=i+1;}return 0;
}
fn ns_rotr(x:i64,n:i32)i64 {
    return ((x>>n)|(x<<(32-n))) & 4294967295;
}
fn ns_sha256(input:[]u8,out:[]u8)i32 {
    if(input.len<0 || input.len>33554360 || out.len<32){return -7403;}
    let size:i32=((input.len+72)/64)*64;
    let bytes:[]u8=nio_alloc(size);if(bytes.len!=size){return -12;}
    let wp:*i64=_zag_malloc(512) as *i64;
    let hp:*i64=_zag_malloc(64) as *i64;
    let kp:*i64=_zag_malloc(512) as *i64;
    if(wp==null as *i64 || hp==null as *i64 || kp==null as *i64){
        if(wp!=null as *i64){_zag_free(wp as *i8);}
        if(hp!=null as *i64){_zag_free(hp as *i8);}
        if(kp!=null as *i64){_zag_free(kp as *i8);}nio_free(bytes);return -12;
    }
    let w:[]i64=wp[0..64];let h:[]i64=hp[0..8];let k:[]i64=kp[0..64];
    let hs:[]u8="6a09e667 bb67ae85 3c6ef372 a54ff53a 510e527f 9b05688c 1f83d9ab 5be0cd19";
    let ks:[]u8="428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174 e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da 983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967 27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070 19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2";
    if(ns_load_words(hs,h)!=0 || ns_load_words(ks,k)!=0){
        nio_free(bytes);_zag_free(wp as *i8);_zag_free(hp as *i8);_zag_free(kp as *i8);return -7401;
    }
    let i:i32=0;
    i=0;while(i<input.len){bytes[i]=input[i];i=i+1;}
    bytes[input.len]=128;let bits:i64=(input.len as i64)*8;i=0;
    while(i<8){bytes[size-1-i]=(bits & 255) as u8;bits=bits>>8;i=i+1;}
    let block:i32=0;
    while(block<size){
        i=0;while(i<16){
            let at:i32=block+i*4;
            w[i]=(bytes[at] as i64)*16777216+(bytes[at+1] as i64)*65536+
                 (bytes[at+2] as i64)*256+(bytes[at+3] as i64);i=i+1;
        }
        while(i<64){
            let s0:i64=ns_rotr(w[i-15],7)^ns_rotr(w[i-15],18)^(w[i-15]>>3);
            let s1:i64=ns_rotr(w[i-2],17)^ns_rotr(w[i-2],19)^(w[i-2]>>10);
            w[i]=(w[i-16]+s0+w[i-7]+s1)&4294967295;i=i+1;
        }
        let a:i64=h[0];let b:i64=h[1];let c:i64=h[2];let d:i64=h[3];
        let e:i64=h[4];let f:i64=h[5];let g:i64=h[6];let hv:i64=h[7];
        i=0;while(i<64){
            let s1:i64=ns_rotr(e,6)^ns_rotr(e,11)^ns_rotr(e,25);
            let choose:i64=(e&f)^((4294967295^e)&g);
            let t1:i64=(hv+s1+choose+k[i]+w[i])&4294967295;
            let s0:i64=ns_rotr(a,2)^ns_rotr(a,13)^ns_rotr(a,22);
            let majority:i64=(a&b)^(a&c)^(b&c);let t2:i64=(s0+majority)&4294967295;
            hv=g;g=f;f=e;e=(d+t1)&4294967295;d=c;c=b;b=a;a=(t1+t2)&4294967295;i=i+1;
        }
        h[0]=(h[0]+a)&4294967295;h[1]=(h[1]+b)&4294967295;
        h[2]=(h[2]+c)&4294967295;h[3]=(h[3]+d)&4294967295;
        h[4]=(h[4]+e)&4294967295;h[5]=(h[5]+f)&4294967295;
        h[6]=(h[6]+g)&4294967295;h[7]=(h[7]+hv)&4294967295;block=block+64;
    }
    i=0;while(i<8){
        out[i*4]=((h[i]>>24)&255) as u8;out[i*4+1]=((h[i]>>16)&255) as u8;
        out[i*4+2]=((h[i]>>8)&255) as u8;out[i*4+3]=(h[i]&255) as u8;i=i+1;
    }
    nio_free(bytes);_zag_free(wp as *i8);_zag_free(hp as *i8);_zag_free(kp as *i8);return 0;
}
fn ns_hex(bytes:[]u8)[]u8 {
    if(bytes.len<1 || bytes.len>1024){return "";}
    let text:[]u8=nio_alloc(bytes.len*2);if(text.len==0){return text;}
    let digits:[]u8="0123456789abcdef";let i:i32=0;
    while(i<bytes.len){let v:i32=bytes[i] as i32;text[2*i]=digits[v/16];text[2*i+1]=digits[v%16];i=i+1;}
    return text;
}
fn sha256_hex(data:[]u8)[]u8 {
    let digest:[]u8=nio_alloc(32);
    if(digest.len==0){return "";}
    if(ns_sha256(data,digest)!=0){nio_free(digest);return "";}
    let hx:[]u8=ns_hex(digest);
    nio_free(digest);
    return hx;
}

// ---------------- battery ----------------
fn trim_nl(s:[]u8)[]u8 {
    let n:i32=s.len;
    let go:i32=1;
    while(go!=0){
        if(n==0){go=0;}
        if(go!=0){
            let c:u8=s[n-1];
            if(c==10 || c==13){n=n-1;}
            if(c!=10 && c!=13){go=0;}
        }
    }
    return s[0..n];
}

fn p_passfail(name:[]u8,ok:i32)void {
    _zag_print(name);
    if(ok!=0){_zag_print("=PASS ");}
    if(ok==0){_zag_print("=FAIL ");}
    return;
}

fn main()i32 {
    let e:[]u8="";
    // --- config: znc path ---
    let zbuf:[]u8=nio_alloc(4096);
    let zn:i32=read_file("./znc.path",zbuf,4096);
    if(zn<=0){
        _zag_print("FATAL: cannot read ./znc.path\n");
        return 2;
    }
    let znc:[]u8=trim_nl(zbuf[0..zn]);
    _zag_print("fork_battery.zag B1/B2/B3+NEG battery\nznc=");
    _zag_print(znc);
    p_nl();
    // --- reference bytes ---
    let expected:[]u8="FORKBATTERY-OK 42";
    // NOTE: the frozen spec text says "15 bytes" but the literal string is
    // 17 bytes; the frozen sha256 below is authoritative and matches these
    // 17 bytes, so the port asserts 17 and the sha256.
    if(expected.len!=17){
        _zag_print("FATAL: reference is not 17 bytes\n");
        return 2;
    }
    let exp_hex:[]u8=sha256_hex(expected);
    _zag_print("expected_sha256=");
    _zag_print(exp_hex);
    p_nl();
    let frozen:[]u8="5dfe3c161096819c8c0dd6057c4df9944ddd884f57b9a513b47e7655d53c6066";
    let ref_ok:i32=nio_equal(exp_hex,frozen);
    p_passfail("reference_sha256",ref_ok);
    p_nl();
    // --- fixture sources ---
    let hello_embedded:[]u8="fn main()i32 {\n    _zag_print(\"FORKBATTERY-OK 42\");\n    return 0;\n}\n";
    let neg1_src:[]u8="fn main()i32 {\n    _zag_print(\"unterminated);\n    return 0;\n}\n";
    let neg2_src:[]u8="fn main()i32 {\n    _zag_print(\"WRONG OUTPUT\");\n    return 0;\n}\n";
    let ovbuf:[]u8=nio_alloc(65536);
    let ovn:i32=read_file("./hello_override.zag",ovbuf,65536);
    let hello_src:[]u8=hello_embedded;
    if(ovn>0){
        hello_src=ovbuf[0..ovn];
        _zag_print("note: using ./hello_override.zag as hello source (negative control probe)\n");
    }
    if(write_file("./forkbat_hello.zag",hello_src)!=0){_zag_print("FATAL: write hello\n");return 2;}
    if(write_file("./neg1.zag",neg1_src)!=0){_zag_print("FATAL: write neg1\n");return 2;}
    if(write_file("./neg2.zag",neg2_src)!=0){_zag_print("FATAL: write neg2\n");return 2;}
    let out:[]u8=nio_alloc(65536);
    let rc:[]u8=nio_alloc(8);
    // --- B1 COMPILE+RUN ---
    let c1:i64=run_capture(znc,znc,"forkbat_hello.zag","--no-zagd","--no-analyze","--no-foreground-cache","-o","hello_bin",out,65536,rc);
    p_kv("b1_compile_exit",c1);
    let r1:i64=run_capture("./hello_bin","./hello_bin",e,e,e,e,e,e,out,65536,rc);
    let n1:i32=g32(rc,0);
    p_kv("b1_run_exit",r1);
    p_kv("b1_run_bytes",n1 as i64);
    let run1:[]u8=out[0..n1];
    let run1_hex:[]u8=sha256_hex(run1);
    _zag_print("b1_run_sha256=");
    _zag_print(run1_hex);
    _zag_print(" ");
    let b1_cmp:i32=nio_equal(run1,expected);
    p_passfail("b1_cmp",b1_cmp);
    p_nl();
    let b1:i32=0;
    if(c1==0 && r1==0 && b1_cmp!=0 && ref_ok!=0){b1=1;}
    p_passfail("B1",b1);
    p_nl();
    // --- B2 DETERMINISM ---
    let r2:i64=run_capture("./hello_bin","./hello_bin",e,e,e,e,e,e,out,65536,rc);
    let n2:i32=g32(rc,0);
    let run2:[]u8=out[0..n2];
    let run2_hex:[]u8=sha256_hex(run2);
    _zag_print("b2_run_sha256=");
    _zag_print(run2_hex);
    _zag_print(" ");
    p_kv("b2_run_exit",r2);
    let b2_runs:i32=0;
    if(r2==0 && nio_equal(run1,run2)!=0){b2_runs=1;}
    p_passfail("b2_run_cmp",b2_runs);
    p_nl();
    let ca:i64=run_capture(znc,znc,"forkbat_hello.zag","--no-zagd","--no-analyze","--no-foreground-cache","-o","bin_a",out,65536,rc);
    let cb:i64=run_capture(znc,znc,"forkbat_hello.zag","--no-zagd","--no-analyze","--no-foreground-cache","-o","bin_b",out,65536,rc);
    p_kv("b2_compile_a_exit",ca);
    p_kv("b2_compile_b_exit",cb);
    let ba:[]u8=nio_alloc(8388608);
    let bb:[]u8=nio_alloc(8388608);
    let na:i32=read_file("./bin_a",ba,8388608);
    let nb:i32=read_file("./bin_b",bb,8388608);
    p_kv("b2_bin_a_bytes",na as i64);
    p_kv("b2_bin_b_bytes",nb as i64);
    let bina:[]u8=ba[0..na];
    let binb:[]u8=bb[0..nb];
    let bina_hex:[]u8=sha256_hex(bina);
    let binb_hex:[]u8=sha256_hex(binb);
    _zag_print("b2_bin_a_sha256=");
    _zag_print(bina_hex);
    p_nl();
    _zag_print("b2_bin_b_sha256=");
    _zag_print(binb_hex);
    p_nl();
    let b2_bins:i32=0;
    if(ca==0 && cb==0 && na>0 && nio_equal(bina,binb)!=0){b2_bins=1;}
    p_passfail("b2_bin_cmp",b2_bins);
    p_nl();
    let b2:i32=0;
    if(b2_runs!=0 && b2_bins!=0){b2=1;}
    p_passfail("B2",b2);
    p_nl();
    // --- B3 STRICT CHECK ---
    let ck:i64=run_capture(znc,znc,"check","forkbat_hello.zag","--strict","--no-zagd",e,e,out,65536,rc);
    let nck:i32=g32(rc,0);
    p_kv("b3_check_exit",ck);
    _zag_print("b3_check_stdout=[");
    _zag_print(out[0..nck]);
    _zag_print("] ");
    let b3:i32=0;
    if(ck==0){b3=1;}
    p_passfail("B3",b3);
    p_nl();
    // --- NEG1: unterminated string must fail compile and check ---
    let nc1:i64=run_capture(znc,znc,"neg1.zag","--no-zagd","--no-analyze","--no-foreground-cache","-o","neg1_bin",out,65536,rc);
    let nk1:i64=run_capture(znc,znc,"check","neg1.zag","--strict","--no-zagd",e,e,out,65536,rc);
    p_kv("neg1_compile_exit",nc1);
    p_kv("neg1_check_exit",nk1);
    let neg1ok:i32=0;
    if(nc1!=0 && nk1!=0){neg1ok=1;}
    p_passfail("NEG1_fails_as_required",neg1ok);
    p_nl();
    // --- NEG2: wrong output must compile and pass check but fail byte compare ---
    let nc2:i64=run_capture(znc,znc,"neg2.zag","--no-zagd","--no-analyze","--no-foreground-cache","-o","neg2_bin",out,65536,rc);
    let nk2:i64=run_capture(znc,znc,"check","neg2.zag","--strict","--no-zagd",e,e,out,65536,rc);
    let r3:i64=run_capture("./neg2_bin","./neg2_bin",e,e,e,e,e,e,out,65536,rc);
    let n3:i32=g32(rc,0);
    let run3:[]u8=out[0..n3];
    p_kv("neg2_compile_exit",nc2);
    p_kv("neg2_check_exit",nk2);
    p_kv("neg2_run_exit",r3);
    let neg2_differs:i32=0;
    if(nio_equal(run3,expected)==0){neg2_differs=1;}
    p_passfail("neg2_stdout_differs",neg2_differs);
    let neg2ok:i32=0;
    if(nc2==0 && nk2==0 && r3==0 && neg2_differs!=0){neg2ok=1;}
    p_passfail("NEG2_fails_as_required",neg2ok);
    p_nl();
    // --- verdict ---
    let verdict:i32=0;
    if(b1!=0 && b2!=0 && b3!=0 && neg1ok!=0 && neg2ok!=0){verdict=1;}
    if(verdict!=0){_zag_print("VERDICT=PASS\n");}
    if(verdict==0){_zag_print("VERDICT=FAIL\n");}
    if(verdict!=0){return 0;}
    return 1;
}

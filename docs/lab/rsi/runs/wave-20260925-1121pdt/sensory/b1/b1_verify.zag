// b1_verify.zag - B1 kill-bar checker. Pure Zag, zero RNG.
// Usage: b1_verify <baseline.bmp> <variant.bmp>
// Frozen bars from PREREG_B1_1121 (wave-20260925-1121pdt).
// BMPs are bottom-up on disk; y_top in 0..1023 has 0 at the TOP.
// Luma L = (299R + 587G + 114B)/1000.
// KB3: HF(var) <= 1.02 * HF(base), HF = sum |p - boxblur3(p)|.
// KB4 over land pixels (in_sky==0) with blurred shadow sh > 512:
//   KB4a mean per-channel |delta| >= 3.5 (x100 fixed)
//   KB4b >= 25% of those pixels have per-pixel mean |delta| >= 3.5
//   KB4c max per-pixel per-channel |delta| <= 80
// KB5: var(luma_var) >= 0.81 * var(luma_base); crushed blacks not increased.
// KB6: max 4-neighbor gradient of the per-channel |delta| field <= 8.
// KB1 (byte identity) and KB2 (wall time) and KB7 (trace text) are
// checked by the shell runner, not here.
// Exit 0 iff every evaluated bar passes; exit 1 otherwise.
@import("./sub/R33_NATIVE_IO_V1.zag")

fn v_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn v_clamp(v:i64, lo:i64, hi:i64) i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn v_min(a:i64, b:i64) i64 {
    if (a < b) { return a; }
    return b;
}
fn v_max(a:i64, b:i64) i64 {
    if (a > b) { return a; }
    return b;
}
fn v_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let r:i64 = v;
    let i:i64 = 0;
    while (i < 48) {
        r = (r + v / r) / 2;
        i = i + 1;
    }
    return r;
}
fn v_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn v_h01(x:i64, y:i64, seed:i64) i64 {
    return v_hash(x, y, seed) >> 22;
}
fn v_sstep(t:i64) i64 {
    let t2:i64 = t * t;
    let t3:i64 = t2 * t;
    return (3 * t2 * 255 - 2 * t3) / 65025;
}
fn v_vnoise(x:i64, y:i64, seed:i64) i64 {
    let xb:i64 = x + 268435456;
    let yb:i64 = y + 268435456;
    let xi:i64 = xb >> 8;
    let yi:i64 = yb >> 8;
    let xf:i64 = xb & 255;
    let yf:i64 = yb & 255;
    let u:i64 = v_sstep(xf);
    let v:i64 = v_sstep(yf);
    let a:i64 = v_h01(xi, yi, seed);
    let b:i64 = v_h01(xi + 1, yi, seed);
    let c:i64 = v_h01(xi, yi + 1, seed);
    let d:i64 = v_h01(xi + 1, yi + 1, seed);
    let ab:i64 = a + (b - a) * u / 256;
    let cd:i64 = c + (d - c) * u / 256;
    return ab + (cd - ab) * v / 256;
}
fn v_fbm(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + v_vnoise(xx, yy, seed + o * 131) * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 512; }
    return sum * 512 / norm;
}
fn v_aget(a:[]u8, i:i64) i64 {
    let o:i64 = i << 2;
    let b0:i64 = a[o] as i64;
    let b1:i64 = a[o + 1] as i64;
    let b2:i64 = a[o + 2] as i64;
    let b3:i64 = a[o + 3] as i64;
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24);
}
fn v_aput(a:[]u8, i:i64, v:i64) void {
    let o:i64 = i << 2;
    a[o] = (v & 255) as u8;
    a[o + 1] = ((v >> 8) & 255) as u8;
    a[o + 2] = ((v >> 16) & 255) as u8;
    a[o + 3] = ((v >> 24) & 255) as u8;
}
// world model copied verbatim from r8c_alien.zag (frozen substrate)
fn v_ridge_y(x:i64) i64 {
    let dd:i64 = x - 390;
    let peak:i64 = 153600 / (1024 + dd * dd / 169);
    let bow:i64 = (x - 512) * (x - 512) * 60 / 262144;
    let bd:i64 = v_abs(x - 640);
    let breach:i64 = 0;
    if (bd < 140) { breach = 70 - bd * 70 / 140; }
    let sec:i64 = v_fbm(x * 256 / 420, 7, 4411, 2) - 512;
    return 470 - peak + bow + breach + sec * 40 / 512;
}
fn v_mid_y(x:i64) i64 {
    return 640 + (v_fbm(x * 256 / 300, 13, 4403, 2) - 512) * 70 / 512;
}
fn v_plain_y(x:i64) i64 {
    return 760 + (v_fbm(x * 256 / 380, 17, 4404, 2) - 512) * 40 / 512;
}
fn v_arch_open(x:i64, y:i64) i64 {
    if (x > 288 && x < 352 && y > 800 && y < 884) { return 1; }
    return 0;
}
fn v_arch_body(x:i64, y:i64) i64 {
    if (x > 256 && x < 288 && y > 786 && y < 900) { return 1; }
    if (x > 352 && x < 384 && y > 786 && y < 900) { return 1; }
    if (x > 248 && x < 392 && y > 762 && y < 802) { return 1; }
    return 0;
}
fn v_stone_x(i:i64) i64 {
    return 40 + v_h01(i, 1, 9101) * 944 / 1024;
}
fn v_stone_y(i:i64) i64 {
    return 786 + v_h01(i, 2, 9102) * 200 / 1024;
}
fn v_stone_r(i:i64) i64 {
    return 4 + v_h01(i, 3, 9103) * 10 / 1024;
}
// shadow-map machinery copied verbatim from r8c_alien.zag
fn v_build_relief(rel:[]u8, w:i64, h:i64) void {
    let gy:i64 = 0;
    while (gy < 128) {
        let gx:i64 = 0;
        while (gx < 128) {
            let px:i64 = gx * 8 + 4;
            let py:i64 = gy * 8 + 4;
            let hh:i64 = 0;
            let ry:i64 = v_ridge_y(px);
            if (py > ry) {
                let rh:i64 = (py - ry) * 3;
                if (rh > 360) { rh = 360; }
                hh = hh + rh;
            }
            let my:i64 = v_mid_y(px);
            if (py > my) {
                let mh:i64 = (py - my) * 2;
                if (mh > 240) { mh = 240; }
                hh = hh + mh;
            }
            let pyy:i64 = v_plain_y(px);
            if (py > pyy) {
                let ph:i64 = py - pyy;
                if (ph > 120) { ph = 120; }
                hh = hh + ph;
            }
            if (v_arch_body(px, py) == 1) { hh = hh + 300; }
            let i:i64 = 0;
            while (i < 40) {
                let sx:i64 = v_stone_x(i);
                let sy:i64 = v_stone_y(i);
                let sr:i64 = v_stone_r(i) * 2;
                let dx:i64 = px - sx;
                let dy:i64 = py - sy;
                if (dx < sr && dx > 0 - sr && dy < sr && dy > 0 - sr) {
                    let d2:i64 = dx * dx + dy * dy;
                    if (d2 < sr * sr) {
                        hh = hh + 60 - 60 * d2 / (sr * sr);
                    }
                }
                i = i + 1;
            }
            v_aput(rel, gy * 128 + gx, hh * 16);
            gx = gx + 1;
        }
        gy = gy + 1;
    }
}
fn v_build_shadowmap(rel:[]u8, shad:[]u8) void {
    let gy:i64 = 0;
    while (gy < 128) {
        let gx:i64 = 0;
        while (gx < 128) {
            let h0:i64 = v_aget(rel, gy * 128 + gx);
            let fx:i64 = gx << 10;
            let fy:i64 = gy << 10;
            let ray:i64 = h0 + 32;
            let sh:i64 = 0;
            let s:i64 = 0;
            while (s < 96) {
                fx = fx - 959;
                fy = fy - 284;
                ray = ray + 54;
                let cx:i64 = fx >> 10;
                let cy:i64 = fy >> 10;
                if (cx < 0 || cx > 127 || cy < 0 || cy > 127) { s = 96; }
                if (s < 96) {
                    if (v_aget(rel, cy * 128 + cx) > ray) { sh = 1024; s = 96; }
                }
                s = s + 1;
            }
            v_aput(shad, gy * 128 + gx, sh);
            gx = gx + 1;
        }
        gy = gy + 1;
    }
}
fn v_blur_shadow(shad:[]u8, out:[]u8) void {
    let gy:i64 = 0;
    while (gy < 128) {
        let gx:i64 = 0;
        while (gx < 128) {
            let acc:i64 = 0;
            let dy:i64 = -1;
            while (dy <= 1) {
                let dx:i64 = -1;
                while (dx <= 1) {
                    let nx:i64 = gx + dx;
                    let ny:i64 = gy + dy;
                    if (nx < 0) { nx = 0; }
                    if (nx > 127) { nx = 127; }
                    if (ny < 0) { ny = 0; }
                    if (ny > 127) { ny = 127; }
                    acc = acc + v_aget(shad, ny * 128 + nx);
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            v_aput(out, gy * 128 + gx, acc / 9);
            gx = gx + 1;
        }
        gy = gy + 1;
    }
}
fn v_sample128(map:[]u8, x:i64, y:i64, w:i64, h:i64) i64 {
    let fx:i64 = x * 128 / w;
    let fy:i64 = y * 128 / h;
    if (fx > 126) { fx = 126; }
    if (fy > 126) { fy = 126; }
    let tx:i64 = (x * 128 - fx * w) * 1024 / w;
    let ty:i64 = (y * 128 - fy * h) * 1024 / h;
    let a:i64 = v_aget(map, fy * 128 + fx);
    let b:i64 = v_aget(map, fy * 128 + fx + 1);
    let c:i64 = v_aget(map, (fy + 1) * 128 + fx);
    let d:i64 = v_aget(map, (fy + 1) * 128 + fx + 1);
    let ab:i64 = a + (b - a) * tx / 1024;
    let cd:i64 = c + (d - c) * tx / 1024;
    return ab + (cd - ab) * ty / 1024;
}
// heap-safe i64 formatter
fn v_i64_to_str(v:i64, buf:[]u8) []u8 {
    let neg:i32 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    let pos:i32 = 32;
    if (u == 0) { pos = pos - 1; buf[pos] = 48; }
    while (u > 0) {
        pos = pos - 1;
        buf[pos] = ((u % 10) as u8) + 48;
        u = u / 10;
    }
    if (neg == 1) { pos = pos - 1; buf[pos] = 45; }
    return buf[pos..32];
}
fn v_print_i64(v:i64) void {
    let pb:[]u8 = nio_alloc(32);
    _zag_print(v_i64_to_str(v, pb));
    nio_free(pb);
}
fn v_read_bmp(path:[]u8, buf:[]u8) i64 {
    let cstr:[]u8 = nio_alloc(4096);
    let plen:i64 = path.len;
    let n:i64 = 0;
    while (n < plen) { cstr[n] = path[n]; n = n + 1; }
    cstr[plen] = 0;
    let fd:i64 = _zag_raw_syscall(257, -100, _zag_slice_ptr(cstr) as i64, 0, 0, 0, 0);
    nio_free(cstr);
    if (fd < 0) { return -1; }
    let total:i64 = 0;
    let cap:i64 = buf.len as i64;
    while (total < cap) {
        let nr:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + total, cap - total, 0, 0, 0);
        if (nr <= 0) { break; }
        total = total + nr;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}
// channel ch (0=B,1=G,2=R) at top-down (x, y_top); BMP is bottom-up on disk
fn v_ch(buf:[]u8, x:i64, y_top:i64, ch:i64) i64 {
    let row:i64 = 1023 - y_top;
    let o:i64 = 54 + row * 3072 + x * 3 + ch;
    return buf[o] as i64;
}
fn v_luma(buf:[]u8, x:i64, y_top:i64) i64 {
    let b:i64 = v_ch(buf, x, y_top, 0);
    let g:i64 = v_ch(buf, x, y_top, 1);
    let r:i64 = v_ch(buf, x, y_top, 2);
    return (299 * r + 587 * g + 114 * b) / 1000;
}
// 3x3 box-blur mean of channel ch around (x,y_top), clamped edges
fn v_blur3(buf:[]u8, x:i64, y_top:i64, ch:i64) i64 {
    let acc:i64 = 0;
    let dy:i64 = -1;
    while (dy <= 1) {
        let dx:i64 = -1;
        while (dx <= 1) {
            let nx:i64 = x + dx;
            let ny:i64 = y_top + dy;
            if (nx < 0) { nx = 0; }
            if (nx > 1023) { nx = 1023; }
            if (ny < 0) { ny = 0; }
            if (ny > 1023) { ny = 1023; }
            acc = acc + v_ch(buf, nx, ny, ch);
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    return acc / 9;
}
fn main() i32 {
    let pb:[]u8 = _zag_arg(1);
    let pv:[]u8 = _zag_arg(2);
    if (_zag_strcmp(pb, "") == 1 || _zag_strcmp(pv, "") == 1) {
        _zag_println("usage: b1_verify <baseline.bmp> <variant.bmp>");
        return 2;
    }
    let bb:[]u8 = nio_alloc(3145782);
    let vb:[]u8 = nio_alloc(3145782);
    if (bb.len == 0 || vb.len == 0) {
        _zag_println("alloc failed");
        return 2;
    }
    let nb:i64 = v_read_bmp(pb, bb);
    let nv:i64 = v_read_bmp(pv, vb);
    if (nb != 3145782 || nv != 3145782) {
        _zag_print("bad bmp sizes: ");
        v_print_i64(nb);
        _zag_print(" ");
        v_print_i64(nv);
        _zag_println("");
        return 2;
    }
    let hd:i64 = 0;
    while (hd < 54) {
        if (bb[hd] != vb[hd]) {
            _zag_println("header mismatch");
            return 2;
        }
        hd = hd + 1;
    }
    _zag_println("building shadow maps...");
    let rel:[]u8 = nio_alloc(65536);
    let shad:[]u8 = nio_alloc(65536);
    let shadb:[]u8 = nio_alloc(65536);
    v_build_relief(rel, 1024, 1024);
    v_build_shadowmap(rel, shad);
    v_blur_shadow(shad, shadb);
    nio_free(rel);
    nio_free(shad);
    let ryarr:[]u8 = nio_alloc(4096);
    let qx:i64 = 0;
    while (qx < 1024) {
        v_aput(ryarr, qx, v_ridge_y(qx));
        qx = qx + 1;
    }
    _zag_println("scanning...");
    let kb4_n:i64 = 0;
    let kb4_sum:i64 = 0;
    let kb4_hit:i64 = 0;
    let kb4_max:i64 = 0;
    let hfb:i64 = 0;
    let hfv:i64 = 0;
    let sumLb:i64 = 0;
    let sumL2b:i64 = 0;
    let sumLv:i64 = 0;
    let sumL2v:i64 = 0;
    let crushb:i64 = 0;
    let crushv:i64 = 0;
    let kb6max:i64 = 0;
    let y:i64 = 0;
    while (y < 1024) {
        let x:i64 = 0;
        while (x < 1024) {
            let ry:i64 = v_aget(ryarr, x);
            let in_sky:i64 = 1;
            if (y >= ry) { in_sky = 0; }
            if (v_arch_open(x, y) == 1) { in_sky = 1; }
            let cb0:i64 = v_ch(bb, x, y, 0);
            let cg0:i64 = v_ch(bb, x, y, 1);
            let cr0:i64 = v_ch(bb, x, y, 2);
            let cv0:i64 = v_ch(vb, x, y, 0);
            let cv1:i64 = v_ch(vb, x, y, 1);
            let cv2:i64 = v_ch(vb, x, y, 2);
            let db:i64 = v_abs(cv0 - cb0);
            let dg:i64 = v_abs(cv1 - cg0);
            let dr:i64 = v_abs(cv2 - cr0);
            let sum3:i64 = db + dg + dr;
            if (in_sky == 0) {
                let sh:i64 = v_sample128(shadb, x, y, 1024, 1024);
                if (sh > 512) {
                    kb4_n = kb4_n + 1;
                    kb4_sum = kb4_sum + sum3;
                    if (sum3 >= 11) { kb4_hit = kb4_hit + 1; }
                    if (db > kb4_max) { kb4_max = db; }
                    if (dg > kb4_max) { kb4_max = dg; }
                    if (dr > kb4_max) { kb4_max = dr; }
                }
            }
            let lb:i64 = (299 * cr0 + 587 * cg0 + 114 * cb0) / 1000;
            let lv:i64 = (299 * cv2 + 587 * cv1 + 114 * cv0) / 1000;
            sumLb = sumLb + lb;
            sumL2b = sumL2b + lb * lb;
            sumLv = sumLv + lv;
            sumL2v = sumL2v + lv * lv;
            if (cr0 < 8 && cg0 < 8 && cb0 < 8) { crushb = crushb + 1; }
            if (cv2 < 8 && cv1 < 8 && cv0 < 8) { crushv = crushv + 1; }
            let ch:i64 = 0;
            while (ch < 3) {
                let pbv:i64 = v_ch(bb, x, y, ch);
                let pvv:i64 = v_ch(vb, x, y, ch);
                hfb = hfb + v_abs(pbv - v_blur3(bb, x, y, ch));
                hfv = hfv + v_abs(pvv - v_blur3(vb, x, y, ch));
                ch = ch + 1;
            }
            if (x < 1023 && y < 1023) {
                let dbr:i64 = v_abs(v_ch(vb, x + 1, y, 0) - v_ch(bb, x + 1, y, 0));
                let dgr:i64 = v_abs(v_ch(vb, x + 1, y, 1) - v_ch(bb, x + 1, y, 1));
                let drr:i64 = v_abs(v_ch(vb, x + 1, y, 2) - v_ch(bb, x + 1, y, 2));
                let dbd:i64 = v_abs(v_ch(vb, x, y + 1, 0) - v_ch(bb, x, y + 1, 0));
                let dgd:i64 = v_abs(v_ch(vb, x, y + 1, 1) - v_ch(bb, x, y + 1, 1));
                let drd:i64 = v_abs(v_ch(vb, x, y + 1, 2) - v_ch(bb, x, y + 1, 2));
                let g:i64 = v_abs(dbr - db);
                if (g > kb6max) { kb6max = g; }
                g = v_abs(dgr - dg);
                if (g > kb6max) { kb6max = g; }
                g = v_abs(drr - dr);
                if (g > kb6max) { kb6max = g; }
                g = v_abs(dbd - db);
                if (g > kb6max) { kb6max = g; }
                g = v_abs(dgd - dg);
                if (g > kb6max) { kb6max = g; }
                g = v_abs(drd - dr);
                if (g > kb6max) { kb6max = g; }
            }
            x = x + 1;
        }
        if (y - (y >> 7 << 7) == 0) {
            _zag_print("row ");
            v_print_i64(y);
            _zag_println("");
        }
        y = y + 1;
    }
    nio_free(shadb);
    nio_free(ryarr);
    let fail:i64 = 0;
    _zag_print("INFO kb4_n_shadland=");
    v_print_i64(kb4_n);
    _zag_println("");
    _zag_print("INFO kb4_mean_x100=");
    v_print_i64(kb4_sum * 100 / (3 * kb4_n));
    _zag_println("");
    _zag_print("INFO kb4_hit_frac_x100=");
    v_print_i64(kb4_hit * 100 / kb4_n);
    _zag_println("");
    _zag_print("INFO kb4_max=");
    v_print_i64(kb4_max);
    _zag_println("");
    _zag_print("INFO hf_base=");
    v_print_i64(hfb);
    _zag_print(" hf_var=");
    v_print_i64(hfv);
    _zag_print(" ratio_x1000=");
    v_print_i64(hfv * 1000 / hfb);
    _zag_println("");
    let npx:i64 = 1048576;
    let Vb:i64 = npx * sumL2b - sumLb * sumLb;
    let Vv:i64 = npx * sumL2v - sumLv * sumLv;
    _zag_print("INFO luma_varnum_base=");
    v_print_i64(Vb);
    _zag_print(" varnum_var=");
    v_print_i64(Vv);
    _zag_print(" ratio_x100=");
    v_print_i64(Vv * 100 / Vb);
    _zag_println("");
    _zag_print("INFO crush_base=");
    v_print_i64(crushb);
    _zag_print(" crush_var=");
    v_print_i64(crushv);
    _zag_println("");
    _zag_print("INFO kb6_maxgrad=");
    v_print_i64(kb6max);
    _zag_println("");
    if (hfb > 0 && hfv * 100 <= hfb * 102) { _zag_println("KB3,PASS"); } else { _zag_println("KB3,FAIL"); fail = 1; }
    if (kb4_n > 0 && kb4_sum * 100 >= 350 * 3 * kb4_n) { _zag_println("KB4a,PASS"); } else { _zag_println("KB4a,FAIL"); fail = 1; }
    if (kb4_n > 0 && kb4_hit * 100 >= 25 * kb4_n) { _zag_println("KB4b,PASS"); } else { _zag_println("KB4b,FAIL"); fail = 1; }
    if (kb4_max <= 80) { _zag_println("KB4c,PASS"); } else { _zag_println("KB4c,FAIL"); fail = 1; }
    if (Vb > 0 && Vv * 100 >= 81 * Vb && crushv <= crushb) { _zag_println("KB5,PASS"); } else { _zag_println("KB5,FAIL"); fail = 1; }
    if (kb6max <= 8) { _zag_println("KB6,PASS"); } else { _zag_println("KB6,FAIL"); fail = 1; }
    nio_free(bb);
    nio_free(vb);
    if (fail == 1) { return 1; }
    return 0;
}

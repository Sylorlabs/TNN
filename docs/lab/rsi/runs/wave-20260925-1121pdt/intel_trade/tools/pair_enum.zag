// pair_enum.zag: authoring-time brute-force pair enumerator for COMP-2.
// Pure Zag. Implements the frozen F9-COMP rule to verify probe drafts.
// Reads kb.txt, gaz.txt, probes_draft.txt from CWD. Prints per probe:
//   P<n> SINGLE=<f|-> PAIRS=<f,g>...
// Authoring instrument, NOT the candidate. Frozen stemmer/stopwords are
// byte-copied from the adopted source (as in CV-P tooling).

fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn beq2(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let i:i32=0;
    while(i<len){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn ends_with(b:[]u8,len:i32,suf:[]u8)i32 {
    if(len<suf.len){return 0;}
    return beq2(b,len-suf.len,suf,0,suf.len);
}
fn stem_inplace(b:[]u8,len:i32)i32 {
    if(ends_with(b,len,"ies")==1){ b[len-3]=121; return len-2; }
    if(ends_with(b,len,"ication")==1){ b[len-7]=105; b[len-6]=115; b[len-5]=104; return len-4; }
    if(ends_with(b,len,"ished")==1){ b[len-5]=105; b[len-4]=115; b[len-3]=104; return len-2; }
    if(ends_with(b,len,"ic")==1 && len>5){return len-2;}
    if(ends_with(b,len,"ed")==1 && len>4){return len-2;}
    if(ends_with(b,len,"ches")==1){return len-2;}
    if(ends_with(b,len,"shes")==1){return len-2;}
    if(ends_with(b,len,"sses")==1){return len-2;}
    if(ends_with(b,len,"xes")==1){return len-2;}
    if(ends_with(b,len,"zes")==1){return len-2;}
    if(ends_with(b,len,"s")==1 && len>3 && ends_with(b,len,"ss")==0){return len-1;}
    return len;
}
fn irregular_norm(b:[]u8,len:i32)i32 {
    if(beq(b,0,len,"birth")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"born")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"borne")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"taught")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    if(beq(b,0,len,"teaching")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    if(beq(b,0,len,"ran")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    if(beq(b,0,len,"running")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    if(beq(b,0,len,"spoke")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"spoken")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"speaking")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"thought")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    if(beq(b,0,len,"thinking")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    if(beq(b,0,len,"built")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    if(beq(b,0,len,"building")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    if(beq(b,0,len,"won")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    if(beq(b,0,len,"winning")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    return len;
}
fn is_stop(sb:[]u8,so:i32,sl:i32)i32 {
    if(beq(sb,so,sl,"a")==1){return 1;}
    if(beq(sb,so,sl,"an")==1){return 1;}
    if(beq(sb,so,sl,"the")==1){return 1;}
    if(beq(sb,so,sl,"and")==1){return 1;}
    if(beq(sb,so,sl,"or")==1){return 1;}
    if(beq(sb,so,sl,"but")==1){return 1;}
    if(beq(sb,so,sl,"of")==1){return 1;}
    if(beq(sb,so,sl,"in")==1){return 1;}
    if(beq(sb,so,sl,"on")==1){return 1;}
    if(beq(sb,so,sl,"at")==1){return 1;}
    if(beq(sb,so,sl,"to")==1){return 1;}
    if(beq(sb,so,sl,"for")==1){return 1;}
    if(beq(sb,so,sl,"with")==1){return 1;}
    if(beq(sb,so,sl,"by")==1){return 1;}
    if(beq(sb,so,sl,"from")==1){return 1;}
    if(beq(sb,so,sl,"as")==1){return 1;}
    if(beq(sb,so,sl,"is")==1){return 1;}
    if(beq(sb,so,sl,"are")==1){return 1;}
    if(beq(sb,so,sl,"was")==1){return 1;}
    if(beq(sb,so,sl,"were")==1){return 1;}
    if(beq(sb,so,sl,"be")==1){return 1;}
    if(beq(sb,so,sl,"been")==1){return 1;}
    if(beq(sb,so,sl,"being")==1){return 1;}
    if(beq(sb,so,sl,"do")==1){return 1;}
    if(beq(sb,so,sl,"does")==1){return 1;}
    if(beq(sb,so,sl,"did")==1){return 1;}
    if(beq(sb,so,sl,"what")==1){return 1;}
    if(beq(sb,so,sl,"which")==1){return 1;}
    if(beq(sb,so,sl,"who")==1){return 1;}
    if(beq(sb,so,sl,"whom")==1){return 1;}
    if(beq(sb,so,sl,"whose")==1){return 1;}
    if(beq(sb,so,sl,"when")==1){return 1;}
    if(beq(sb,so,sl,"where")==1){return 1;}
    if(beq(sb,so,sl,"why")==1){return 1;}
    if(beq(sb,so,sl,"how")==1){return 1;}
    if(beq(sb,so,sl,"it")==1){return 1;}
    if(beq(sb,so,sl,"its")==1){return 1;}
    if(beq(sb,so,sl,"this")==1){return 1;}
    if(beq(sb,so,sl,"that")==1){return 1;}
    if(beq(sb,so,sl,"these")==1){return 1;}
    if(beq(sb,so,sl,"those")==1){return 1;}
    if(beq(sb,so,sl,"i")==1){return 1;}
    if(beq(sb,so,sl,"you")==1){return 1;}
    if(beq(sb,so,sl,"he")==1){return 1;}
    if(beq(sb,so,sl,"she")==1){return 1;}
    if(beq(sb,so,sl,"they")==1){return 1;}
    if(beq(sb,so,sl,"we")==1){return 1;}
    if(beq(sb,so,sl,"me")==1){return 1;}
    if(beq(sb,so,sl,"my")==1){return 1;}
    if(beq(sb,so,sl,"your")==1){return 1;}
    if(beq(sb,so,sl,"his")==1){return 1;}
    if(beq(sb,so,sl,"her")==1){return 1;}
    if(beq(sb,so,sl,"their")==1){return 1;}
    if(beq(sb,so,sl,"our")==1){return 1;}
    return 0;
}
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
fn pr(s:[]u8)void { prlen(s,s.len); return; }
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0; let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){ let dd:i64=(x%10)+48; buf[at]=dd as u8; x=x/10; at=at-1; }
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1; let n:i32=24-start; let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(24); let n:i32=i64str(v,b); prlen(b,n);
    return;
}
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1); copy_bytes(b,0,s,0,s.len); b[s.len]=0; return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);

    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),((cap-total) as i64),0,0,0);
        if(n<=0){go=0;}
        else{ total=total+(n as i32); if(total>=cap){go=0;} }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..total];
}
// stemmed content words of src[so..so+sl) into swbuf at base (absolute
// offsets), table at swtab+taboff; returns count
fn stemmed_cw(src:[]u8,so:i32,sl:i32,swbuf:[]u8,base:i32,swtab:[]u8,taboff:i32,tmp:[]u8)i32 {
    let cb:[]u8=nio_alloc(4096);
    let o:i32=0; let i:i32=0; let sp:i32=1;
    while(i<sl){
        let c:u8=to_low(src[so+i]); i=i+1;
        if((c>=97 && c<=122) || (c>=48 && c<=57)){ cb[o]=c; o=o+1; sp=0; }
        else{ if(sp==0){cb[o]=32; o=o+1; sp=1;} }
    }
    if(o>0 && cb[o-1]==32){o=o-1;}
    let cl:i32=o;
    let nc:i32=0; let so2:i32=0;
    let wi:i32=0;
    while(wi<cl){
        while(wi<cl && cb[wi]==32){wi=wi+1;}
        if(wi<cl){
            let ws:i32=wi;
            while(wi<cl && cb[wi]!=32){wi=wi+1;}
            let wl:i32=wi-ws;
            if(is_stop(cb,ws,wl)==0){
                copy_bytes(tmp,0,cb,ws,wl);
                let sl2:i32=stem_inplace(tmp,wl);
                sl2=irregular_norm(tmp,sl2);
                copy_bytes(swbuf,base+so2,tmp,0,sl2);
                p32(swtab,taboff+4+nc*8,base+so2);
                p32(swtab,taboff+4+nc*8+4,sl2);
                so2=so2+sl2; nc=nc+1;
            }
        }
    }
    p32(swtab,taboff,nc);

    return nc;
}
// word buf[wo..wo+wl) in set (setbuf, table at settab+settoff, absolute offs)?
fn in_set(buf:[]u8,wo:i32,wl:i32,setbuf:[]u8,settab:[]u8,settoff:i32)i32 {
    let n:i32=g32(settab,settoff) as i32;
    let k:i32=0;
    while(k<n){
        let so:i32=g32(settab,settoff+4+k*8) as i32;
        let sl:i32=g32(settab,settoff+4+k*8+4) as i32;
        if(wl==sl && beq2(buf,wo,setbuf,so,wl)==1){return 1;}
        k=k+1;
    }
    return 0;
}
// every word of B (bbuf,btab+btoff) in A (abuf,atab+atoff)?
fn covers(abuf:[]u8,atab:[]u8,atoff:i32,bbuf:[]u8,btab:[]u8,btoff:i32)i32 {
    let n:i32=g32(btab,btoff) as i32;
    let k:i32=0;
    while(k<n){
        let wo:i32=g32(btab,btoff+4+k*8) as i32;
        let wl:i32=g32(btab,btoff+4+k*8+4) as i32;
        if(in_set(bbuf,wo,wl,abuf,atab,atoff)==0){return 0;}
        k=k+1;
    }
    return 1;
}
// every word of C covered by union of A,B?
fn union_covers(abuf:[]u8,atab:[]u8,atoff:i32,bbuf:[]u8,btab:[]u8,btoff:i32,cbuf:[]u8,ctab:[]u8,ctoff:i32)i32 {
    let n:i32=g32(ctab,ctoff) as i32;
    let k:i32=0;
    while(k<n){
        let wo:i32=g32(ctab,ctoff+4+k*8) as i32;
        let wl:i32=g32(ctab,ctoff+4+k*8+4) as i32;
        if(in_set(cbuf,wo,wl,abuf,atab,atoff)==0 && in_set(cbuf,wo,wl,bbuf,btab,btoff)==0){return 0;}
        k=k+1;
    }
    return 1;
}

fn main()void {
    let kb:[]u8=read_all("kb.txt");
    let fbuf:[]u8=nio_alloc(38*1024);
    let ftab:[]u8=nio_alloc(38*16);
    let nf:i32=0;
    let p:i32=0;
    while(p<kb.len && nf<38){
        let ls:i32=p;
        while(p<kb.len && kb[p]!=10){p=p+1;}
        let le:i32=p;
        if(p<kb.len){p=p+1;}
        if(le>ls){
            let q:i32=ls;
            while(q<le && kb[q]!=9){q=q+1;}
            q=q+1;
            let fo:i32=nf*1024;
            let fl:i32=le-q;
            copy_bytes(fbuf,fo,kb,q,fl);
            p32(ftab,nf*16,fo); p32(ftab,nf*16+4,fl);
            nf=nf+1;
        }
    }
    let gz:[]u8=read_all("gaz.txt");
    let gbuf:[]u8=nio_alloc(64*128);
    let gtab:[]u8=nio_alloc(64*16);
    let ng:i32=0;
    p=0;
    while(p<gz.len && ng<64){
        let ls:i32=p;
        while(p<gz.len && gz[p]!=10){p=p+1;}
        let le:i32=p;
        if(p<gz.len){p=p+1;}
        if(le>ls){
            let q:i32=le;
            while(q>ls && gz[q-1]!=9){q=q-1;}
            let go:i32=ng*128;
            let gl:i32=le-q;
            copy_bytes(gbuf,go,gz,q,gl);
            p32(gtab,ng*16,go); p32(gtab,ng*16+4,gl);
            ng=ng+1;
        }
    }
    let tmp:[]u8=nio_alloc(256);
    let fswb:[]u8=nio_alloc(38*512);
    let fswt:[]u8=nio_alloc(38*136);
    let f:i32=0;
    while(f<nf){
        let fo:i32=g32(ftab,f*16) as i32;
        let fl:i32=g32(ftab,f*16+4) as i32;
        stemmed_cw(fbuf,fo,fl,fswb,f*512,fswt,f*136,tmp);
        f=f+1;
    }
    let gswb:[]u8=nio_alloc(64*128);
    let gswt:[]u8=nio_alloc(64*136);
    let e:i32=0;
    while(e<ng){
        let go:i32=g32(gtab,e*16) as i32;
        let gl:i32=g32(gtab,e*16+4) as i32;
        stemmed_cw(gbuf,go,gl,gswb,e*128,gswt,e*136,tmp);
        e=e+1;
    }
    let fet:[]u8=nio_alloc(38*64*4);
    let fne:[]u8=nio_alloc(38*4);
    f=0;
    while(f<nf){
        let ne2:i32=0;
        e=0;
        while(e<ng){
            if(covers(fswb,fswt,f*136,gswb,gswt,e*136)==1){
                p32(fet,(f*64+ne2)*4,e); ne2=ne2+1;
            }
            e=e+1;
        }
        p32(fne,f*4,ne2);
        f=f+1;
    }
    let pd:[]u8=read_all("probes_draft.txt");
    let pn:i32=0;
    p=0;
    while(p<pd.len){
        let ls:i32=p;
        while(p<pd.len && pd[p]!=10){p=p+1;}
        let le:i32=p;
        if(p<pd.len){p=p+1;}
        if(le>ls){
            pn=pn+1;
            let pswb:[]u8=nio_alloc(512);
            let pswt:[]u8=nio_alloc(136);
            stemmed_cw(pd,ls,le-ls,pswb,0,pswt,0,tmp);
            let sf:i32=-1;
            f=0;
            while(f<nf){
                if(covers(fswb,fswt,f*136,pswb,pswt,0)==1 && sf<0){sf=f;}
                f=f+1;
            }
            pr("P"); prn(pn as i64); pr(" SINGLE=");
            if(sf<0){pr("-");} else {prn(sf as i64);}
            pr(" PAIRS=");
            let f2:i32=0;
            while(f2<nf){
                let g2:i32=f2+1;
                while(g2<nf){
                    let sh:i32=0;
                    let a:i32=0;
                    let na:i32=g32(fne,f2*4) as i32;
                    while(a<na && sh==0){
                        let ea:i32=g32(fet,(f2*64+a)*4) as i32;
                        let b:i32=0;
                        let nb:i32=g32(fne,g2*4) as i32;
                        while(b<nb && sh==0){
                            let eb:i32=g32(fet,(g2*64+b)*4) as i32;
                            if(ea==eb){sh=1;}
                            b=b+1;
                        }
                        a=a+1;
                    }
                    if(sh==1 && union_covers(fswb,fswt,f2*136,fswb,fswt,g2*136,pswb,pswt,0)==1){
                        pr(" "); prn(f2 as i64); pr(","); prn(g2 as i64);
                    }
                    g2=g2+1;
                }
                f2=f2+1;
            }
            pr("\n");
        }
    }

    return;
}

// v3_verify.zag: D-VID-1 V3 verifier, pure Zag, zero RNG.
// Scene math helpers copied verbatim from the frozen D-VID-1 baseline ocean.zag.
@import("substrate/R33_NATIVE_IO_V1.zag")
// ---------------- small helpers ----------------
fn o_clamp255(v:i64) i64 {
    if (v < 0) { return 0; }
    if (v > 255) { return 255; }
    return v;
}
fn o_clamp01k(v:i64) i64 {
    if (v < 0) { return 0; }
    if (v > 1000) { return 1000; }
    return v;
}
fn o_mix(a:i64, b:i64, t:i64) i64 {
    return a + (b - a) * t / 1000;
}
fn o_ss(t:i64) i64 {
    if (t <= 0) { return 0; }
    if (t >= 1000) { return 1000; }
    return t * t * (3000 - 2 * t) / 1000000;
}
fn o_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let x:i64 = v;
    let y:i64 = (x + 1) / 2;
    let guard:i64 = 0;
    while (y < x && guard < 64) { x = y; y = (x + v / x) / 2; guard = guard + 1; }
    return x;
}
fn o_atoi(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i64 = 0;
    while (i < s.len) {
        let c:i64 = s[i] as i64;
        if (c < 48 || c > 57) { return v; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

// ---------------- deterministic integer-hash value noise ----------------
fn o_hash2(ix:i64, iy:i64, seed:i64) i64 {
    let h:i64 = (ix * 374761393 + iy * 668265263 + seed * 974634211) & 9223372036854775807;
    h = h ^ (h >> 13);
    h = (h * 1274126177) & 9223372036854775807;
    h = h ^ (h >> 16);
    return h % 1001;
}
fn o_hash3(ix:i64, iy:i64, iz:i64, seed:i64) i64 {
    let h:i64 = (ix * 374761393 + iy * 668265263 + iz * 2246822519 + seed * 3266489917) & 9223372036854775807;
    h = h ^ (h >> 13);
    h = (h * 1274126177) & 9223372036854775807;
    h = h ^ (h >> 16);
    return h % 1001;
}
fn o_ss8(t:i64) i64 {
    return t * t * (768 - 2 * t) >> 16;
}
fn o_vn2(x8:i64, y8:i64, seed:i64) i64 {
    let ix:i64 = x8 >> 8;
    let iy:i64 = y8 >> 8;
    let fx:i64 = x8 & 255;
    let fy:i64 = y8 & 255;
    let sx:i64 = o_ss8(fx);
    let sy:i64 = o_ss8(fy);
    let v00:i64 = o_hash2(ix, iy, seed);
    let v10:i64 = o_hash2(ix + 1, iy, seed);
    let v01:i64 = o_hash2(ix, iy + 1, seed);
    let v11:i64 = o_hash2(ix + 1, iy + 1, seed);
    let a:i64 = v00 + (v10 - v00) * sx / 256;
    let b:i64 = v01 + (v11 - v01) * sx / 256;
    return a + (b - a) * sy / 256;
}
fn o_vn3(x8:i64, y8:i64, z8:i64, seed:i64) i64 {
    let ix:i64 = x8 >> 8;
    let iy:i64 = y8 >> 8;
    let iz:i64 = z8 >> 8;
    let fx:i64 = x8 & 255;
    let fy:i64 = y8 & 255;
    let fz:i64 = z8 & 255;
    let sx:i64 = o_ss8(fx);
    let sy:i64 = o_ss8(fy);
    let sz:i64 = o_ss8(fz);
    let c000:i64 = o_hash3(ix, iy, iz, seed);
    let c100:i64 = o_hash3(ix + 1, iy, iz, seed);
    let c010:i64 = o_hash3(ix, iy + 1, iz, seed);
    let c110:i64 = o_hash3(ix + 1, iy + 1, iz, seed);
    let c001:i64 = o_hash3(ix, iy, iz + 1, seed);
    let c101:i64 = o_hash3(ix + 1, iy, iz + 1, seed);
    let c011:i64 = o_hash3(ix, iy + 1, iz + 1, seed);
    let c111:i64 = o_hash3(ix + 1, iy + 1, iz + 1, seed);
    let x00:i64 = c000 + (c100 - c000) * sx / 256;
    let x10:i64 = c010 + (c110 - c010) * sx / 256;
    let x01:i64 = c001 + (c101 - c001) * sx / 256;
    let x11:i64 = c011 + (c111 - c011) * sx / 256;
    let y0:i64 = x00 + (x10 - x00) * sy / 256;
    let y1:i64 = x01 + (x11 - x01) * sy / 256;
    return y0 + (y1 - y0) * sz / 256;
}
fn o_fbm2(x8:i64, y8:i64, oct:i64, seed:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 1000;
    let tot:i64 = 0;
    let xx:i64 = x8;
    let yy:i64 = y8;
    let s:i64 = seed;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + o_vn2(xx, yy, s) * amp / 1000;
        tot = tot + amp;
        xx = xx * 2;
        yy = yy * 2;
        amp = amp / 2;
        s = s + 131;
        o = o + 1;
    }
    return sum * 1000 / tot;
}
fn o_ridge2(x8:i64, y8:i64, oct:i64, seed:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 1000;
    let tot:i64 = 0;
    let xx:i64 = x8;
    let yy:i64 = y8;
    let s:i64 = seed;
    let o:i64 = 0;
    while (o < oct) {
        let n:i64 = o_vn2(xx, yy, s);
        let d:i64 = 2 * n - 1000;
        if (d < 0) { d = 0 - d; }
        let r:i64 = 1000 - d;
        r = r * r / 1000;
        sum = sum + r * amp / 1000;
        tot = tot + amp;
        xx = xx * 2;
        yy = yy * 2;
        amp = amp / 2;
        s = s + 131;
        o = o + 1;
    }
    return sum * 1000 / tot;
}
// integer atan2: angle of vector (x,y) from +x axis, 0..6283 millirad
fn o_atan2(y:i64, x:i64) i64 {
    if (x == 0 && y == 0) { return 0; }
    let ax:i64 = x;
    if (ax < 0) { ax = 0 - ax; }
    let ay:i64 = y;
    if (ay < 0) { ay = 0 - ay; }
    let a:i64 = 0;
    let base:i64 = 0;
    if (ax >= ay) {
        if (ax == 0) { return 0; }
        a = ay * 1000 / ax;
        base = 0;
    } else {
        a = ax * 1000 / ay;
        base = 1571;
    }
    let t:i64 = 785 * a / 1000 + 273 * a * (1000 - a) / 1000000;
    let oct:i64 = t;
    if (base == 1571) { oct = 1571 - t; }
    if (x >= 0 && y >= 0) { return oct; }
    if (x < 0 && y >= 0) { return 3142 - oct; }
    if (x < 0 && y < 0) { return 3142 + oct; }
    return 6283 - oct;
}
// cos/sin of a small angle (<= ~700 millirad), x1000
fn o_cos_sin(mrad:i64, o_c:*i64, o_s:*i64) void {
    o_c.* = 1000 - mrad * mrad / 2000000;
    o_s.* = mrad - mrad * mrad * mrad / 6000000000;
}

// ---------------- scene ----------------
// rock spires on the horizon line: (sx, sz, radius, height_milli)
fn o_spire(i:i64, o_sx:*i64, o_sz:*i64, o_sr:*i64, o_sh:*i64) void {
    if (i == 0) { o_sx.* = -1050; o_sz.* = 2500; o_sr.* = 55; o_sh.* = 150000; return; }
    if (i == 1) { o_sx.* = -420; o_sz.* = 3100; o_sr.* = 42; o_sh.* = 120000; return; }
    if (i == 2) { o_sx.* = 180; o_sz.* = 2800; o_sr.* = 70; o_sh.* = 210000; return; }
    if (i == 3) { o_sx.* = 760; o_sz.* = 3400; o_sr.* = 48; o_sh.* = 140000; return; }
    if (i == 4) { o_sx.* = 1300; o_sz.* = 2700; o_sr.* = 38; o_sh.* = 105000; return; }
    o_sx.* = -1650; o_sz.* = 3900; o_sr.* = 62; o_sh.* = 170000;
}
// per-frame scene state: migrating vortex center + arm rotation
fn o_scene(f:i64, o_vwx:*i64, o_vwz:*i64, o_rot:*i64) void {
    o_vwx.* = 140 + (o_vn3(f * 64, 7 * 256, 3 * 256, 91) - 500) * 120 / 1000;
    o_vwz.* = 720 + (o_vn3(f * 64, 99 * 256, 5 * 256, 92) - 500) * 100 / 1000;
    o_rot.* = f * 8;
}
// Heightfield: returns height in milli-units. World units for x/z.
// mat: 0 = water, 1 = rock. fall: vortex radial influence 0..1000.
// arm: spiral-arm crest factor 0..1000. sprox: spire foam-ring 0..1000.
fn o_height(wx:i64, wz:i64, f:i64, vwx:i64, vwz:i64, rot:i64, o_mat:*i64, o_fall:*i64, o_arm:*i64, o_sprox:*i64) i64 {
    let mat:i64 = 0;
    let fall:i64 = 0;
    let arm:i64 = 0;
    let sprox:i64 = 0;
    // --- swell: domain-warped, advected toward +x
    let sx1:i64 = wx - f * 12 / 10;
    let sz1:i64 = wz - f * 5 / 10;
    let qx:i64 = o_vn2(sx1, sz1, 101) - 500;
    let qz:i64 = o_vn2(sx1 + 3737, sz1 + 911, 102) - 500;
    let wxw:i64 = sx1 * 2 + qx * 90 / 1000;
    let wzw:i64 = sz1 * 2 + qz * 90 / 1000;
    let swell:i64 = o_fbm2(wxw, wzw, 3, 11);
    let h:i64 = (swell - 500) * 18 / 10;
    // --- chop lives in the shading normal only (see o_shade_water);
    // heightfield chop at grazing angles caused corduroy occlusion
    // banding. Spires are drawn by the explicit ray pass, so they no
    // longer depend on voxel samples hitting them.
    // --- vortex: smooth depression + rotating spiral arms
    let dx:i64 = wx - vwx;
    let dz:i64 = wz - vwz;
    let r2:i64 = dx * dx + dz * dz;
    let vrr:i64 = 160 * 160;
    fall = vrr * 1000 / (vrr + r2);
    h = h - 8500 * fall / 1000;
    let r:i64 = o_isqrt(r2);
    if (r < 160 && r > 4) {
        let ang:i64 = o_atan2(dz, dx);
        let armx:i64 = ang * 4000 / 6283 + r * 8 - rot + 12000;
        let fr:i64 = (armx % 4000) % 1000;
        let dd:i64 = 2 * fr - 1000;
        if (dd < 0) { dd = 0 - dd; }
        let tri:i64 = 1000 - dd;
        let ridge:i64 = tri * tri / 1000;
        h = h + 3200 * ridge / 1000 * fall / 1000;
        arm = ridge * fall / 1000;
    }
    // --- rock spires: handled by explicit ray pass in o_emit_frame
    // (voxel z-samples miss narrow needles); here we only compute
    // waterline proximity for the foam ring.
    let si:i64 = 0;
    let best:i64 = 1000000;
    while (si < 6) {
        let ssx:i64 = 0;
        let ssz:i64 = 0;
        let ssr:i64 = 0;
        let ssh:i64 = 0;
        o_spire(si, &ssx, &ssz, &ssr, &ssh);
        let ddx:i64 = wx - ssx;
        let ddz:i64 = wz - ssz;
        let reach:i64 = ssr * 2 + 40;
        if (ddx < reach && ddx > 0 - reach && ddz < reach && ddz > 0 - reach) {
            let d2s:i64 = ddx * ddx + ddz * ddz;
            if (d2s < reach * reach) {
                let ds:i64 = o_isqrt(d2s);
                if (ds < best) { best = ds; }
            }
        }
        si = si + 1;
    }
    if (best < 1000000) {
        sprox = o_clamp01k((120 - best) * 1000 / 120);
    }
    o_mat.* = mat;
    o_fall.* = fall;
    o_arm.* = arm;
    o_sprox.* = sprox;
    return h;
}
// perspective projection: screen y of world point (h_milli, wz),
// x32 fixed point (sub-pixel y-buffer kills z-quantization striping)
fn o_sy_fp(h:i64, wz:i64) i64 {
    let dym:i64 = h - 13000;
    let yp:i64 = dym * 990 + wz * 143000;
    let zp:i64 = wz * 990000 - dym * 143;
    return 16384 - 29440 * yp / zp;
}
fn o_sy(h:i64, wz:i64) i64 {
    return o_sy_fp(h, wz) / 32;
}
// ================= D-VID-1 V3 verifier (pure Zag, zero RNG) =================
// Metrics: T1-GC (frozen prereg 0ba679b11), T2 (V-TEMP), T3 (V-SHARP),
// V-RES, D1 diagnostic, outside-disc byte-compare.
// Usage: v3_verify_bin <baseline_dir> <variant_dir>
// Frame naming: <dir>/dvid1_fNN.bmp, 1024x1024 24-bit BMP, 3145782 bytes.

// ---- frame IO ----
fn v_zcstr_copy(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0 as u8;
    return b;
}
fn v_frame_path(dir:[]u8, f:i64) []u8 {
    let b:[]u8 = nio_alloc((dir.len + 16) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < dir.len && dir[i] != 0) { b[i] = dir[i]; i = i + 1; }
    b[i] = 47 as u8; i = i + 1;
    b[i] = 100 as u8; i = i + 1;
    b[i] = 118 as u8; i = i + 1;
    b[i] = 105 as u8; i = i + 1;
    b[i] = 100 as u8; i = i + 1;
    b[i] = 49 as u8; i = i + 1;
    b[i] = 95 as u8; i = i + 1;
    b[i] = 102 as u8; i = i + 1;
    b[i] = (48 + f / 10) as u8; i = i + 1;
    b[i] = (48 + f % 10) as u8; i = i + 1;
    b[i] = 46 as u8; i = i + 1;
    b[i] = 98 as u8; i = i + 1;
    b[i] = 109 as u8; i = i + 1;
    b[i] = 112 as u8; i = i + 1;
    b[i] = 0 as u8;
    return b;
}
fn v_read_frame(dir:[]u8, f:i64, buf:[]u8) i64 {
    let path:[]u8 = v_frame_path(dir, f);
    if (path.len == 0) { return -20; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    nio_free(path);
    if (fd < 0) { return -21; }
    let n:i64 = nio_read_exact(fd, buf, 3145782);
    nio_close(fd);
    return n;
}
// ---- pixel helpers (BMP bottom-up, BGR) ----
fn v_foam(b:[]u8, x:i64, y:i64) i64 {
    let at:i64 = 54 + (1023 - y) * 3072 + x * 3;
    let bb:i64 = b[at] as i64;
    let gg:i64 = b[at + 1] as i64;
    let rr:i64 = b[at + 2] as i64;
    let l:i64 = (299 * rr + 587 * gg + 114 * bb) / 1000;
    if (l < 200) { return 0; }
    let mx:i64 = rr;
    if (gg > mx) { mx = gg; }
    if (bb > mx) { mx = bb; }
    let mn:i64 = rr;
    if (gg < mn) { mn = gg; }
    if (bb < mn) { mn = bb; }
    if (mx - mn > 40) { return 0; }
    return 1;
}
fn v_lum(b:[]u8, at:i64) i64 {
    let bb:i64 = b[at] as i64;
    let gg:i64 = b[at + 1] as i64;
    let rr:i64 = b[at + 2] as i64;
    return (299 * rr + 587 * gg + 114 * bb + 500) / 1000;
}
// ---- T1-GC region (frozen): screen disc from o_scene + o_height + o_sy ----
fn v_region(f:i64, o_xc:*i64, o_yc:*i64, o_rad:*i64) void {
    let vwx:i64 = 0;
    let vwz:i64 = 0;
    let rot:i64 = 0;
    o_scene(f, &vwx, &vwz, &rot);
    let m0:i64 = 0;
    let fa0:i64 = 0;
    let a0:i64 = 0;
    let sp0:i64 = 0;
    let hc:i64 = o_height(vwx, vwz, f, vwx, vwz, rot, &m0, &fa0, &a0, &sp0);
    o_xc.* = 512 + vwx * 920 / vwz;
    o_yc.* = o_sy(hc, vwz);
    o_rad.* = 160 * 920 / vwz;
}
// per-pair T1-GC in per-mille: flips * 1000 / foam
fn v_t1gc_pair(f:i64, b0:[]u8, b1:[]u8) i64 {
    let xc:i64 = 0;
    let yc:i64 = 0;
    let rad:i64 = 0;
    v_region(f, &xc, &yc, &rad);
    let r2:i64 = rad * rad;
    let x0:i64 = xc - rad;
    if (x0 < 0) { x0 = 0; }
    let x1:i64 = xc + rad;
    if (x1 > 1023) { x1 = 1023; }
    let y0:i64 = yc - rad;
    if (y0 < 0) { y0 = 0; }
    let y1:i64 = yc + rad;
    if (y1 > 1023) { y1 = 1023; }
    let dfl:i64 = 0;
    let dfo:i64 = 0;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let dx:i64 = x - xc;
            let dy:i64 = y - yc;
            if (dx * dx + dy * dy <= r2) {
                let m0:i64 = v_foam(b0, x, y);
                let m1:i64 = v_foam(b1, x, y);
                if (m0 == 1) { dfo = dfo + 1; }
                if (m0 != m1) { dfl = dfl + 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (dfo <= 0) { return 0; }
    return dfl * 1000 / dfo;
}
// ---- T2 (V-TEMP): per-pair sum |dL| scaled to percent x100 ----
fn v_t2_pair(b0:[]u8, b1:[]u8) i64 {
    let s:i64 = 0;
    let y:i64 = 0;
    while (y < 1024) {
        let at:i64 = 54 + (1023 - y) * 3072;
        let x:i64 = 0;
        while (x < 1024) {
            let d:i64 = v_lum(b0, at) - v_lum(b1, at);
            if (d < 0) { d = 0 - d; }
            s = s + d;
            at = at + 3;
            x = x + 1;
        }
        y = y + 1;
    }
    return s * 10000 / 267386880;
}
// ---- T3 (V-SHARP): gradient ratio x1000, V1/V2 convention ----
fn v_sharp(b:[]u8, lb:[]u8, sm:[]u8) i64 {
    let y:i64 = 0;
    while (y < 1024) {
        let at:i64 = 54 + (1023 - y) * 3072;
        let x:i64 = 0;
        while (x < 1024) {
            lb[y * 1024 + x] = v_lum(b, at) as u8;
            at = at + 3;
            x = x + 1;
        }
        y = y + 1;
    }
    let sox:i64 = 0;
    let soy:i64 = 0;
    let yy:i64 = 0;
    while (yy < 1024) {
        let xx:i64 = 0;
        while (xx < 1023) {
            let d:i64 = (lb[yy * 1024 + xx + 1] as i64) - (lb[yy * 1024 + xx] as i64);
            if (d < 0) { d = 0 - d; }
            sox = sox + d;
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    yy = 0;
    while (yy < 1023) {
        let xx2:i64 = 0;
        while (xx2 < 1024) {
            let d2:i64 = (lb[(yy + 1) * 1024 + xx2] as i64) - (lb[yy * 1024 + xx2] as i64);
            if (d2 < 0) { d2 = 0 - d2; }
            soy = soy + d2;
            xx2 = xx2 + 1;
        }
        yy = yy + 1;
    }
    let j:i64 = 0;
    while (j < 512) {
        let i:i64 = 0;
        while (i < 512) {
            let p00:i64 = lb[(2 * j) * 1024 + 2 * i] as i64;
            let p01:i64 = lb[(2 * j) * 1024 + 2 * i + 1] as i64;
            let p10:i64 = lb[(2 * j + 1) * 1024 + 2 * i] as i64;
            let p11:i64 = lb[(2 * j + 1) * 1024 + 2 * i + 1] as i64;
            sm[j * 512 + i] = ((p00 + p01 + p10 + p11 + 2) / 4) as u8;
            i = i + 1;
        }
        j = j + 1;
    }
    let sbx:i64 = 0;
    let sby:i64 = 0;
    let y2:i64 = 0;
    while (y2 < 1024) {
        let x2:i64 = 0;
        while (x2 < 1023) {
            let a:i64 = sm[(y2 / 2) * 512 + x2 / 2] as i64;
            let c:i64 = sm[(y2 / 2) * 512 + (x2 + 1) / 2] as i64;
            let d:i64 = c - a;
            if (d < 0) { d = 0 - d; }
            sbx = sbx + d;
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    y2 = 0;
    while (y2 < 1023) {
        let x3:i64 = 0;
        while (x3 < 1024) {
            let a2:i64 = sm[(y2 / 2) * 512 + x3 / 2] as i64;
            let c2:i64 = sm[((y2 + 1) / 2) * 512 + x3 / 2] as i64;
            let d3:i64 = c2 - a2;
            if (d3 < 0) { d3 = 0 - d3; }
            sby = sby + d3;
            x3 = x3 + 1;
        }
        y2 = y2 + 1;
    }
    let denom:i64 = sbx + sby;
    if (denom <= 0) { return -1; }
    return (sox + soy) * 1000 / denom;
}
// ---- D1 diagnostic: per-mille of region pixels differing at frame f ----
fn v_d1(f:i64, bA:[]u8, bB:[]u8) i64 {
    let xc:i64 = 0;
    let yc:i64 = 0;
    let rad:i64 = 0;
    v_region(f, &xc, &yc, &rad);
    let r2:i64 = rad * rad;
    let x0:i64 = xc - rad;
    if (x0 < 0) { x0 = 0; }
    let x1:i64 = xc + rad;
    if (x1 > 1023) { x1 = 1023; }
    let y0:i64 = yc - rad;
    if (y0 < 0) { y0 = 0; }
    let y1:i64 = yc + rad;
    if (y1 > 1023) { y1 = 1023; }
    let diff:i64 = 0;
    let tot:i64 = 0;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let dx:i64 = x - xc;
            let dy:i64 = y - yc;
            if (dx * dx + dy * dy <= r2) {
                let at:i64 = 54 + (1023 - y) * 3072 + x * 3;
                tot = tot + 1;
                if (bA[at] != bB[at] || bA[at + 1] != bB[at + 1] || bA[at + 2] != bB[at + 2]) {
                    diff = diff + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (tot <= 0) { return 0 - 1; }
    return diff * 1000 / tot;
}
// ---- screen bbox of the world disc (radius 200 world units) ----
// Any water pixel with churn_gate > 0 projects inside this box.
// Pixels outside it must be byte-identical between baseline and variant.
fn v_disc_bbox(f:i64, o_x0:*i64, o_x1:*i64, o_y0:*i64, o_y1:*i64) void {
    let vwx:i64 = 0;
    let vwz:i64 = 0;
    let rot:i64 = 0;
    o_scene(f, &vwx, &vwz, &rot);
    let av:i64 = vwx;
    if (av < 0) { av = 0 - av; }
    let xr:i64 = (av + 200) * 920 / (vwz - 200) + 8;
    o_x0.* = 512 - xr;
    o_x1.* = 512 + xr;
    let ylo:i64 = 1000000;
    let yhi:i64 = 0 - 1000000;
    let wi:i64 = 0;
    while (wi < 3) {
        let wz:i64 = vwz - 200 + wi * 200;
        let h:i64 = 0 - 12000;
        while (h <= 8000) {
            let y:i64 = o_sy(h, wz);
            if (y < ylo) { ylo = y; }
            if (y > yhi) { yhi = y; }
            h = h + 2000;
        }
        wi = wi + 1;
    }
    o_y0.* = ylo - 8;
    o_y1.* = yhi + 8;
}
// count differing pixels outside the bbox; also report diff bbox
fn v_cmp_outside(bA:[]u8, bB:[]u8, x0:i64, x1:i64, y0:i64, y1:i64, o_dx0:*i64, o_dx1:*i64, o_dy0:*i64, o_dy1:*i64) i64 {
    let nd:i64 = 0;
    let dx0:i64 = 1000000;
    let dx1:i64 = 0 - 1000000;
    let dy0:i64 = 1000000;
    let dy1:i64 = 0 - 1000000;
    let y:i64 = 0;
    while (y < 1024) {
        let oy:i64 = 0;
        if (y < y0 || y > y1) { oy = 1; }
        let at:i64 = 54 + (1023 - y) * 3072;
        let x:i64 = 0;
        while (x < 1024) {
            let out:i64 = oy;
            if (out == 0 && (x < x0 || x > x1)) { out = 1; }
            if (out == 1) {
                if (bA[at] != bB[at] || bA[at + 1] != bB[at + 1] || bA[at + 2] != bB[at + 2]) {
                    nd = nd + 1;
                    if (x < dx0) { dx0 = x; }
                    if (x > dx1) { dx1 = x; }
                    if (y < dy0) { dy0 = y; }
                    if (y > dy1) { dy1 = y; }
                }
            }
            at = at + 3;
            x = x + 1;
        }
        y = y + 1;
    }
    o_dx0.* = dx0;
    o_dx1.* = dx1;
    o_dy0.* = dy0;
    o_dy1.* = dy1;
    return nd;
}
fn v_pi(s:[]u8, v:i64) void {
    _zag_print(s);
    _zag_print(_zag_i64_to_str(v));
    _zag_println("");
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    if (a1.len == 0 || a2.len == 0) {
        _zag_println("usage: v3_verify_bin <baseline_dir> <variant_dir>");
        return 1;
    }
    let dirA:[]u8 = v_zcstr_copy(a1);
    let dirB:[]u8 = v_zcstr_copy(a2);
    let a0:[]u8 = nio_alloc(3145782);
    let a1b:[]u8 = nio_alloc(3145782);
    let c0:[]u8 = nio_alloc(3145782);
    let c1b:[]u8 = nio_alloc(3145782);
    if (dirA.len == 0 || dirB.len == 0 || a0.len == 0 || a1b.len == 0 || c0.len == 0 || c1b.len == 0) { return 2; }
    // ---- V-RES on the variant dir ----
    let resok:i64 = 0;
    let i:i64 = 0;
    while (i < 48) {
        let n:i64 = v_read_frame(dirB, i, c0);
        let ok:i64 = 0;
        if (n == 3145782 && (c0[0] as i64) == 66 && (c0[1] as i64) == 77) {
            let w:i64 = (c0[18] as i64) + (c0[19] as i64) * 256 + (c0[20] as i64) * 65536 + (c0[21] as i64) * 16777216;
            let hh:i64 = (c0[22] as i64) + (c0[23] as i64) * 256 + (c0[24] as i64) * 65536 + (c0[25] as i64) * 16777216;
            let bpp:i64 = (c0[28] as i64) + (c0[29] as i64) * 256;
            if (w == 1024 && hh == 1024 && bpp == 24) { ok = 1; }
        }
        if (ok == 1) { resok = resok + 1; }
        i = i + 1;
    }
    v_pi("VRES_variant_ok=", resok);
    // ---- pair loop: T1-GC, T2, outside-disc byte compare ----
    let t1Asum:i64 = 0;
    let t1Bsum:i64 = 0;
    let t2a_min:i64 = 1000000000;
    let t2a_max:i64 = 0;
    let t2b_min:i64 = 1000000000;
    let t2b_max:i64 = 0;
    let t2a_tot:i64 = 0;
    let t2b_tot:i64 = 0;
    let outdiff:i64 = 0;
    let gdx0:i64 = 1000000;
    let gdx1:i64 = 0 - 1000000;
    let gdy0:i64 = 1000000;
    let gdy1:i64 = 0 - 1000000;
    let f:i64 = 0;
    while (f < 47) {
        if (v_read_frame(dirA, f, a0) != 3145782) { v_pi("read_err_A_f=", f); return 3; }
        if (v_read_frame(dirA, f + 1, a1b) != 3145782) { v_pi("read_err_A_f1=", f); return 3; }
        if (v_read_frame(dirB, f, c0) != 3145782) { v_pi("read_err_B_f=", f); return 4; }
        if (v_read_frame(dirB, f + 1, c1b) != 3145782) { v_pi("read_err_B_f1=", f); return 4; }
        let pA:i64 = v_t1gc_pair(f, a0, a1b);
        let pB:i64 = v_t1gc_pair(f, c0, c1b);
        t1Asum = t1Asum + pA;
        t1Bsum = t1Bsum + pB;
        _zag_print("T1GC pair ");
        _zag_print(_zag_i64_to_str(f));
        _zag_print(" A_pm=");
        _zag_print(_zag_i64_to_str(pA));
        _zag_print(" B_pm=");
        _zag_println(_zag_i64_to_str(pB));
        let t2a:i64 = v_t2_pair(a0, a1b);
        let t2b:i64 = v_t2_pair(c0, c1b);
        t2a_tot = t2a_tot + t2a;
        t2b_tot = t2b_tot + t2b;
        if (t2a < t2a_min) { t2a_min = t2a; }
        if (t2a > t2a_max) { t2a_max = t2a; }
        if (t2b < t2b_min) { t2b_min = t2b; }
        if (t2b > t2b_max) { t2b_max = t2b; }
        _zag_print("T2 pair ");
        _zag_print(_zag_i64_to_str(f));
        _zag_print(" A_p2=");
        _zag_print(_zag_i64_to_str(t2a));
        _zag_print(" B_p2=");
        _zag_println(_zag_i64_to_str(t2b));
        let bx0:i64 = 0;
        let bx1:i64 = 0;
        let by0:i64 = 0;
        let by1:i64 = 0;
        v_disc_bbox(f, &bx0, &bx1, &by0, &by1);
        let ddx0:i64 = 0;
        let ddx1:i64 = 0;
        let ddy0:i64 = 0;
        let ddy1:i64 = 0;
        let nd:i64 = v_cmp_outside(a0, c0, bx0, bx1, by0, by1, &ddx0, &ddx1, &ddy0, &ddy1);
        outdiff = outdiff + nd;
        if (nd > 0) {
            if (ddx0 < gdx0) { gdx0 = ddx0; }
            if (ddx1 > gdx1) { gdx1 = ddx1; }
            if (ddy0 < gdy0) { gdy0 = ddy0; }
            if (ddy1 > gdy1) { gdy1 = ddy1; }
        }
        f = f + 1;
    }
    // frame 47 byte-compare (no pair metrics)
    if (v_read_frame(dirA, 47, a0) != 3145782) { return 3; }
    if (v_read_frame(dirB, 47, c0) != 3145782) { return 4; }
    let bx0:i64 = 0;
    let bx1:i64 = 0;
    let by0:i64 = 0;
    let by1:i64 = 0;
    v_disc_bbox(47, &bx0, &bx1, &by0, &by1);
    let ddx0:i64 = 0;
    let ddx1:i64 = 0;
    let ddy0:i64 = 0;
    let ddy1:i64 = 0;
    let nd47:i64 = v_cmp_outside(a0, c0, bx0, bx1, by0, by1, &ddx0, &ddx1, &ddy0, &ddy1);
    outdiff = outdiff + nd47;
    if (nd47 > 0) {
        if (ddx0 < gdx0) { gdx0 = ddx0; }
        if (ddx1 > gdx1) { gdx1 = ddx1; }
        if (ddy0 < gdy0) { gdy0 = ddy0; }
        if (ddy1 > gdy1) { gdy1 = ddy1; }
    }
    let t1A:i64 = t1Asum / 47;
    let t1B:i64 = t1Bsum / 47;
    v_pi("T1GC_baseline_pm=", t1A);
    v_pi("T1GC_variant_pm=", t1B);
    let vd:i64 = t1A - 580;
    if (vd < 0) { vd = 0 - vd; }
    if (vd <= 25) { _zag_println("T1GC_VALIDATION_GATE=PASS"); } else { _zag_println("T1GC_VALIDATION_GATE=FAIL"); }
    if (t1B * 1000 >= t1A * 1300) { _zag_println("T1GC_BAR=PASS"); } else { _zag_println("T1GC_BAR=FAIL"); }
    v_pi("T2_baseline_min_p2=", t2a_min);
    v_pi("T2_baseline_max_p2=", t2a_max);
    v_pi("T2_baseline_mean_p2=", t2a_tot / 47);
    v_pi("T2_variant_min_p2=", t2b_min);
    v_pi("T2_variant_max_p2=", t2b_max);
    v_pi("T2_variant_mean_p2=", t2b_tot / 47);
    if (t2b_min >= 50 && t2b_max <= 1500) { _zag_println("T2_BAR=PASS"); } else { _zag_println("T2_BAR=FAIL"); }
    v_pi("OUTSIDE_DISC_DIFF_PIXELS=", outdiff);
    if (outdiff == 0) {
        _zag_println("OUTSIDE_DISC_CHECK=PASS");
    } else {
        _zag_print("OUTSIDE_DISC_CHECK=FAIL diff_bbox_x=");
        _zag_print(_zag_i64_to_str(gdx0));
        _zag_print("..");
        _zag_print(_zag_i64_to_str(gdx1));
        _zag_print(" y=");
        _zag_print(_zag_i64_to_str(gdy0));
        _zag_print("..");
        _zag_println(_zag_i64_to_str(gdy1));
    }
    // ---- D1 at f=10 ----
    if (v_read_frame(dirA, 10, a0) != 3145782) { return 3; }
    if (v_read_frame(dirB, 10, c0) != 3145782) { return 4; }
    let d1:i64 = v_d1(10, a0, c0);
    v_pi("D1_f10_region_diff_pm=", d1);
    if (d1 >= 50) { _zag_println("D1_DIAGNOSTIC=PASS"); } else { _zag_println("D1_DIAGNOSTIC=FAIL"); }
    // ---- T3 on f0 and f47 ----
    let lb:[]u8 = nio_alloc(1048576);
    let sm:[]u8 = nio_alloc(262144);
    if (lb.len == 0 || sm.len == 0) { return 5; }
    if (v_read_frame(dirA, 0, a0) != 3145782) { return 6; }
    let rA0:i64 = v_sharp(a0, lb, sm);
    if (v_read_frame(dirA, 47, a0) != 3145782) { return 6; }
    let rA47:i64 = v_sharp(a0, lb, sm);
    if (v_read_frame(dirB, 0, c0) != 3145782) { return 6; }
    let rB0:i64 = v_sharp(c0, lb, sm);
    if (v_read_frame(dirB, 47, c0) != 3145782) { return 6; }
    let rB47:i64 = v_sharp(c0, lb, sm);
    v_pi("T3_A_f0=", rA0);
    v_pi("T3_A_f47=", rA47);
    v_pi("T3_B_f0=", rB0);
    v_pi("T3_B_f47=", rB47);
    let va0:i64 = rA0 - 1607;
    if (va0 < 0) { va0 = 0 - va0; }
    let va47:i64 = rA47 - 1543;
    if (va47 < 0) { va47 = 0 - va47; }
    if (va0 <= 5 && va47 <= 5) { _zag_println("T3_VALIDATION_GATE=PASS"); } else { _zag_println("T3_VALIDATION_GATE=FAIL"); }
    let d0:i64 = rB0 - rA0;
    if (d0 < 0) { d0 = 0 - d0; }
    let d47:i64 = rB47 - rA47;
    if (d47 < 0) { d47 = 0 - d47; }
    if (va0 <= 5 && va47 <= 5 && rA0 > 0 && rA47 > 0 && d0 * 1000 <= rA0 * 50 && d47 * 1000 <= rA47 * 50) {
        _zag_println("T3_BAR=PASS");
    } else {
        _zag_println("T3_BAR=FAIL");
    }
    nio_free(lb);
    nio_free(sm);
    nio_free(a0);
    nio_free(a1b);
    nio_free(c0);
    nio_free(c1b);
    nio_free(dirA);
    nio_free(dirB);
    return 0;
}

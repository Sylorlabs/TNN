// v3_sha.zag: pure-Zag SHA-256 file hasher, zero RNG.
@import("substrate/R33_NATIVE_IO_V1.zag")
// ================= v3_sha: pure-Zag SHA-256 file hasher =================
// Usage: v3_sha_bin <path>. Prints 64 lowercase hex chars + newline.
// Standard SHA-256 over the exact file bytes. No RNG, no floats.
fn sh_rotr(x:i64, n:i64) i64 {
    let m:i64 = x & 4294967295;
    return ((m >> n) | (m << (32 - n))) & 4294967295;
}
fn sh_get32(buf:[]u8, off:i64) i64 {
    return (buf[off] as i64) * 16777216 + (buf[off + 1] as i64) * 65536 + (buf[off + 2] as i64) * 256 + (buf[off + 3] as i64);
}
fn sh_put32(buf:[]u8, off:i64, v:i64) void {
    buf[off] = ((v >> 24) & 255) as u8;
    buf[off + 1] = ((v >> 16) & 255) as u8;
    buf[off + 2] = ((v >> 8) & 255) as u8;
    buf[off + 3] = (v & 255) as u8;
}
fn sh_k(i:i64) i64 {
    if (i == 0) { return 0x428a2f98; }
    if (i == 1) { return 0x71374491; }
    if (i == 2) { return 0xb5c0fbcf; }
    if (i == 3) { return 0xe9b5dba5; }
    if (i == 4) { return 0x3956c25b; }
    if (i == 5) { return 0x59f111f1; }
    if (i == 6) { return 0x923f82a4; }
    if (i == 7) { return 0xab1c5ed5; }
    if (i == 8) { return 0xd807aa98; }
    if (i == 9) { return 0x12835b01; }
    if (i == 10) { return 0x243185be; }
    if (i == 11) { return 0x550c7dc3; }
    if (i == 12) { return 0x72be5d74; }
    if (i == 13) { return 0x80deb1fe; }
    if (i == 14) { return 0x9bdc06a7; }
    if (i == 15) { return 0xc19bf174; }
    if (i == 16) { return 0xe49b69c1; }
    if (i == 17) { return 0xefbe4786; }
    if (i == 18) { return 0x0fc19dc6; }
    if (i == 19) { return 0x240ca1cc; }
    if (i == 20) { return 0x2de92c6f; }
    if (i == 21) { return 0x4a7484aa; }
    if (i == 22) { return 0x5cb0a9dc; }
    if (i == 23) { return 0x76f988da; }
    if (i == 24) { return 0x983e5152; }
    if (i == 25) { return 0xa831c66d; }
    if (i == 26) { return 0xb00327c8; }
    if (i == 27) { return 0xbf597fc7; }
    if (i == 28) { return 0xc6e00bf3; }
    if (i == 29) { return 0xd5a79147; }
    if (i == 30) { return 0x06ca6351; }
    if (i == 31) { return 0x14292967; }
    if (i == 32) { return 0x27b70a85; }
    if (i == 33) { return 0x2e1b2138; }
    if (i == 34) { return 0x4d2c6dfc; }
    if (i == 35) { return 0x53380d13; }
    if (i == 36) { return 0x650a7354; }
    if (i == 37) { return 0x766a0abb; }
    if (i == 38) { return 0x81c2c92e; }
    if (i == 39) { return 0x92722c85; }
    if (i == 40) { return 0xa2bfe8a1; }
    if (i == 41) { return 0xa81a664b; }
    if (i == 42) { return 0xc24b8b70; }
    if (i == 43) { return 0xc76c51a3; }
    if (i == 44) { return 0xd192e819; }
    if (i == 45) { return 0xd6990624; }
    if (i == 46) { return 0xf40e3585; }
    if (i == 47) { return 0x106aa070; }
    if (i == 48) { return 0x19a4c116; }
    if (i == 49) { return 0x1e376c08; }
    if (i == 50) { return 0x2748774c; }
    if (i == 51) { return 0x34b0bcb5; }
    if (i == 52) { return 0x391c0cb3; }
    if (i == 53) { return 0x4ed8aa4a; }
    if (i == 54) { return 0x5b9cca4f; }
    if (i == 55) { return 0x682e6ff3; }
    if (i == 56) { return 0x748f82ee; }
    if (i == 57) { return 0x78a5636f; }
    if (i == 58) { return 0x84c87814; }
    if (i == 59) { return 0x8cc70208; }
    if (i == 60) { return 0x90befffa; }
    if (i == 61) { return 0xa4506ceb; }
    if (i == 62) { return 0xbef9a3f7; }
    return 0xc67178f2;
}
fn sh_hex8(out:[]u8, at:i64, v:i64) void {
    let n:i64 = 0;
    while (n < 8) {
        let dig:i64 = (v >> ((7 - n) * 4)) & 15;
        let ch:i64 = 48 + dig;
        if (dig > 9) { ch = 87 + dig; }
        out[at + n] = ch as u8;
        n = n + 1;
    }
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if (a1.len == 0) {
        _zag_println("usage: v3_sha_bin <path>");
        return 1;
    }
    let path:[]u8 = nio_alloc((a1.len + 1) as i32);
    if (path.len == 0) { return 2; }
    let pi:i64 = 0;
    while (pi < a1.len) { path[pi] = a1[pi]; pi = pi + 1; }
    path[a1.len] = 0 as u8;
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    nio_free(path);
    if (fd < 0) {
        _zag_println("open_fail");
        return 2;
    }
    let size:i64 = nio_seek(fd, 0, 2);
    if (size < 0 || size > 33554431) {
        _zag_println("size_fail");
        return 2;
    }
    if (nio_seek(fd, 0, 0) != 0) {
        _zag_println("seek_fail");
        return 2;
    }
    let msg:[]u8 = nio_alloc(size as i32);
    if (msg.len == 0) { nio_close(fd); return 3; }
    let at:i64 = 0;
    while (at < size) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(msg) as i64) + at, size - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) {
            _zag_println("read_fail");
            nio_close(fd);
            return 3;
        }
        at = at + n;
    }
    nio_close(fd);
    let L:i64 = (size + 9 + 63) / 64 * 64;
    let buf:[]u8 = nio_alloc(L as i32);
    if (buf.len == 0) { return 4; }
    let ci:i64 = 0;
    while (ci < size) { buf[ci] = msg[ci]; ci = ci + 1; }
    nio_free(msg);
    buf[size] = 128 as u8;
    let zi:i64 = size + 1;
    while (zi < L) { buf[zi] = 0 as u8; zi = zi + 1; }
    let bitlen:i64 = size * 8;
    buf[L - 8] = ((bitlen >> 56) & 255) as u8;
    buf[L - 7] = ((bitlen >> 48) & 255) as u8;
    buf[L - 6] = ((bitlen >> 40) & 255) as u8;
    buf[L - 5] = ((bitlen >> 32) & 255) as u8;
    buf[L - 4] = ((bitlen >> 24) & 255) as u8;
    buf[L - 3] = ((bitlen >> 16) & 255) as u8;
    buf[L - 2] = ((bitlen >> 8) & 255) as u8;
    buf[L - 1] = (bitlen & 255) as u8;
    let h0:i64 = 0x6a09e667;
    let h1:i64 = 0xbb67ae85;
    let h2:i64 = 0x3c6ef372;
    let h3:i64 = 0xa54ff53a;
    let h4:i64 = 0x510e527f;
    let h5:i64 = 0x9b05688c;
    let h6:i64 = 0x1f83d9ab;
    let h7:i64 = 0x5be0cd19;
    let w:[]u8 = nio_alloc(256);
    if (w.len == 0) { return 5; }
    let blk:i64 = 0;
    while (blk < L) {
        let t:i64 = 0;
        while (t < 16) {
            let o:i64 = blk + t * 4;
            sh_put32(w, t * 4, sh_get32(buf, o));
            t = t + 1;
        }
        let ex:i64 = 16;
        while (ex < 64) {
            let x15:i64 = sh_get32(w, (ex - 15) * 4);
            let x2:i64 = sh_get32(w, (ex - 2) * 4);
            let s0:i64 = sh_rotr(x15, 7) ^ sh_rotr(x15, 18) ^ (x15 >> 3);
            let s1:i64 = sh_rotr(x2, 17) ^ sh_rotr(x2, 19) ^ (x2 >> 10);
            let nv:i64 = (sh_get32(w, (ex - 16) * 4) + s0 + sh_get32(w, (ex - 7) * 4) + s1) & 4294967295;
            sh_put32(w, ex * 4, nv);
            ex = ex + 1;
        }
        let a:i64 = h0;
        let b:i64 = h1;
        let c:i64 = h2;
        let d:i64 = h3;
        let e:i64 = h4;
        let f:i64 = h5;
        let g:i64 = h6;
        let h:i64 = h7;
        let r:i64 = 0;
        while (r < 64) {
            let ww:i64 = sh_get32(w, r * 4);
            let S1:i64 = sh_rotr(e, 6) ^ sh_rotr(e, 11) ^ sh_rotr(e, 25);
            let ch:i64 = (e & f) ^ ((4294967295 ^ e) & g);
            let t1:i64 = (h + S1 + ch + sh_k(r) + ww) & 4294967295;
            let S0:i64 = sh_rotr(a, 2) ^ sh_rotr(a, 13) ^ sh_rotr(a, 22);
            let maj:i64 = (a & b) ^ (a & c) ^ (b & c);
            let t2:i64 = (S0 + maj) & 4294967295;
            h = g;
            g = f;
            f = e;
            e = (d + t1) & 4294967295;
            d = c;
            c = b;
            b = a;
            a = (t1 + t2) & 4294967295;
            r = r + 1;
        }
        h0 = (h0 + a) & 4294967295;
        h1 = (h1 + b) & 4294967295;
        h2 = (h2 + c) & 4294967295;
        h3 = (h3 + d) & 4294967295;
        h4 = (h4 + e) & 4294967295;
        h5 = (h5 + f) & 4294967295;
        h6 = (h6 + g) & 4294967295;
        h7 = (h7 + h) & 4294967295;
        blk = blk + 64;
    }
    let out:[]u8 = nio_alloc(64);
    if (out.len == 0) { return 6; }
    sh_hex8(out, 0, h0);
    sh_hex8(out, 8, h1);
    sh_hex8(out, 16, h2);
    sh_hex8(out, 24, h3);
    sh_hex8(out, 32, h4);
    sh_hex8(out, 40, h5);
    sh_hex8(out, 48, h6);
    sh_hex8(out, 56, h7);
    _zag_print(out);
    _zag_println("");
    return 0;
}

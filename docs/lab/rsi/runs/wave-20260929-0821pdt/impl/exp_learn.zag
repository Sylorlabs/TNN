// exp_learn.zag -- discriminating-experiment invention (H-EXP, NQ3).
// wave-20260929-0821pdt. Pure Zag. Zero Python.
//
// usage: exp_learn <hyp1.txt> <hyp2.txt>
//
// Parses two hypothesis files (frozen prereg format), enumerates action
// sequences of length 1..3 over actions 0..5 (heat, cool, pressurize,
// depressurize, lamp_on, lamp_off), simulates each from the shared INIT
// state under both hypotheses with a generic rule evaluator, selects the
// shortest lexicographically-first sequence whose predicted final states
// differ, and emits an inspectable trace. If nothing discriminates,
// emits the exact WITHHOLD line.
//
// The hypotheses are DATA parsed at runtime. The selection outcome for
// any pair is not authored. Search order: length-major, then
// lexicographic by action id.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
// signed decimal parse at b[p..]; returns new p; value in val[0..4]
fn parse_sint(b:[]u8, p:i32, val:[]u8)i32 {
  while(p<b.len && (b[p] as i32)<=32){p=p+1;}
  let neg:i32=0;
  if(p<b.len && b[p]==45){neg=1;p=p+1;}
  let v:i32=0;
  while(p<b.len && b[p]>=48 && b[p]<=57){
    v=v*10+((b[p] as i32)-48); p=p+1;
  }
  if(neg==1){v=0-v;}
  set32(val,0,v);
  return p;
}

// ---- hypothesis struct ----
// bytes 0..63: name; 64..67: name len; 68..79: init t,p,l; 80..83: nrule;
// 84..: rules, 40 bytes each (a,v1,op1,x1,v2,op2,x2,sv,sx), max 64 rules.
fn HSZ()i32 { return 84+64*40; }
fn h_nrule(H:[]u8)i32 { return get32(H,80); }
fn h_nrule_set(H:[]u8, n:i32)void { set32(H,80,n); return; }
fn h_init(H:[]u8, v:i32)i32 { return get32(H,68+v*4); }
fn h_init_set(H:[]u8, v:i32, x:i32)void { set32(H,68+v*4,x); return; }
fn h_rule(H:[]u8, r:i32, f:i32)i32 { return get32(H,84+r*40+f*4); }
fn h_rule_set(H:[]u8, r:i32, f:i32, x:i32)void { set32(H,84+r*40+f*4,x); return; }

fn cond_ok(v:i32, op:i32, x:i32)i32 {
  if(op==0){ if(v==x){return 1;} return 0; }
  if(op==1){ if(v!=x){return 1;} return 0; }
  if(op==2){ if(v<x){return 1;} return 0; }
  if(op==3){ if(v<=x){return 1;} return 0; }
  if(op==4){ if(v>x){return 1;} return 0; }
  if(op==5){ if(v>=x){return 1;} return 0; }
  return 0;
}

// load hypothesis from path. Returns 0 on success, 1 on parse failure.
fn load_hyp(H:[]u8, path:[]u8)i32 {
  let data:[]u8=_zag_read_file(path);
  if(data.len==0){return 1;}
  let p:i32=0;
  let pv:[]u8=z_alloc(4);
  let nr:i32=0;
  while(p<data.len){
    while(p<data.len && (data[p] as i32)<=32){p=p+1;}
    if(p>=data.len){break;}
    let ch:i32=data[p] as i32;
    if(ch==35){ while(p<data.len && data[p]!=10){p=p+1;} continue; }
    if(ch==72){ // 'H' HYP <name>
      p=p+1;
      if(p+1>=data.len || data[p]!=89 || data[p+1]!=80){return 1;}
      p=p+2;
      while(p<data.len && (data[p] as i32)<=32 && data[p]!=10){p=p+1;}
      let nl:i32=0;
      while(p<data.len && (data[p] as i32)>32 && data[p]!=10 && nl<63){
        H[nl]=data[p]; nl=nl+1; p=p+1;
      }
      set32(H,64,nl);
      continue;
    }
    if(ch==73){ // 'I' INIT t p l
      p=p+1;
      if(p+2>=data.len || data[p]!=78 || data[p+1]!=73 || data[p+2]!=84){return 1;}
      p=p+3;
      p=parse_sint(data,p,pv); h_init_set(H,0,get32(pv,0));
      p=parse_sint(data,p,pv); h_init_set(H,1,get32(pv,0));
      p=parse_sint(data,p,pv); h_init_set(H,2,get32(pv,0));
      continue;
    }
    if(ch==82){ // 'R' RULE a v1 op1 x1 v2 op2 x2 sv sx
      p=p+1;
      if(p+2>=data.len || data[p]!=85 || data[p+1]!=76 || data[p+2]!=69){return 1;}
      p=p+3;
      if(nr>=64){return 1;}
      let f:i32=0;
      while(f<9){
        p=parse_sint(data,p,pv); h_rule_set(H,nr,f,get32(pv,0)); f=f+1;
      }
      nr=nr+1;
      continue;
    }
    while(p<data.len && data[p]!=10){p=p+1;}
  }
  h_nrule_set(H,nr);
  if(get32(H,64)==0){return 1;}
  return 0;
}

// simulate sequence seq[0..L) from INIT under H. Result in out[0..2].
fn sim(H:[]u8, seq:[]u8, L:i32, out:[]u8)void {
  out[0]=h_init(H,0); out[1]=h_init(H,1); out[2]=h_init(H,2);
  let j:i32=0;
  while(j<L){
    let a:i32=seq[j] as i32;
    let r:i32=0;
    let nr:i32=h_nrule(H);
    while(r<nr){
      if(h_rule(H,r,0)==a){
        let v1:i32=h_rule(H,r,1); let op1:i32=h_rule(H,r,2); let x1:i32=h_rule(H,r,3);
        let v2:i32=h_rule(H,r,4); let op2:i32=h_rule(H,r,5); let x2:i32=h_rule(H,r,6);
        let c1:i32=cond_ok(out[v1] as i32,op1,x1);
        let c2:i32=1;
        if(v2>=0){ c2=cond_ok(out[v2] as i32,op2,x2); }
        if(c1==1 && c2==1){
          let sv:i32=h_rule(H,r,7); let sx:i32=h_rule(H,r,8);
          out[sv]=sx as u8;
          break;
        }
      }
      r=r+1;
    }
    j=j+1;
  }
  return;
}

fn varname(v:i32)[]u8 {
  if(v==0){return "temp";}
  if(v==1){return "pressure";}
  return "lamp";
}

fn main()i32 {
  let h1p:[]u8=_zag_arg(1);
  let h2p:[]u8=_zag_arg(2);
  if(h1p.len==0 || h2p.len==0){
    emit("usage: exp_learn <hyp1.txt> <hyp2.txt>\n");
    return 1;
  }
  let H1:[]u8=z_alloc(HSZ());
  let H2:[]u8=z_alloc(HSZ());
  if(load_hyp(H1,h1p)!=0){ emit("parse error in hyp1\n"); return 1; }
  if(load_hyp(H2,h2p)!=0){ emit("parse error in hyp2\n"); return 1; }
  let n1:i32=get32(H1,64);
  let n2:i32=get32(H2,64);
  emit("HYP1 "); emit(H1[0..n1]); emit(" rules="); e64(h_nrule(H1)); emit("\n");
  emit("HYP2 "); emit(H2[0..n2]); emit(" rules="); e64(h_nrule(H2)); emit("\n");
  emit("CANDIDATES len1=6 len2=36 len3=216\n");
  let seq:[]u8=z_alloc(3);
  let s1:[]u8=z_alloc(3);
  let s2:[]u8=z_alloc(3);
  let nb:i32=0;
  let L:i32=1;
  while(L<=3){
    let tot:i32=1;
    let k:i32=0;
    while(k<L){tot=tot*6;k=k+1;}
    let idx:i32=0;
    while(idx<tot){
      let div:i32=1;
      let j2:i32=1;
      while(j2<L){div=div*6;j2=j2+1;}
      let j:i32=0;
      while(j<L){
        seq[j]=((idx/div)%6) as u8;
        div=div/6;
        j=j+1;
      }
      sim(H1,seq,L,s1);
      sim(H2,seq,L,s2);
      if(s1[0]!=s2[0] || s1[1]!=s2[1] || s1[2]!=s2[2]){
        emit("CHECKED "); e64(nb); emit("\n");
        let dv:i32=0;
        if(s1[0]!=s2[0]){dv=0;} else { if(s1[1]!=s2[1]){dv=1;} else {dv=2;} }
        emit("DIFFVAR "); emit(varname(dv)); emit("\n");
        emit("PRED1 "); e64(s1[0] as i32); emit(" "); e64(s1[1] as i32); emit(" "); e64(s1[2] as i32); emit("\n");
        emit("PRED2 "); e64(s2[0] as i32); emit(" "); e64(s2[1] as i32); emit(" "); e64(s2[2] as i32); emit("\n");
        emit("SELECT");
        let m:i32=0;
        while(m<L){ emit(" "); e64(seq[m] as i32); m=m+1; }
        emit("\n");
        return 0;
      }
      nb=nb+1;
      idx=idx+1;
    }
    L=L+1;
  }
  emit("WITHHOLD: no discriminating experiment within length<=3\n");
  return 0;
}

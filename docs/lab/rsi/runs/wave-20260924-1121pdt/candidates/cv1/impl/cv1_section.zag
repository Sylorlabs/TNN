// ================ CLAIM-VERIFY-1 (wave-20260924-1121pdt) ================
// Coverage-deliberated claim verification for tnn_chat. Replaces the
// word-literal match inside the frozen decline gate (the old deliberate())
// with a coverage-deliberated pipeline. Pure Zag, zero RNG, fully
// deterministic. The KB (38 facts) is byte-frozen; this code never adds,
// edits, or reorders KB entries. No fact composition: single-fact coverage
// only.
//
// Pipeline (frozen prereg PREREG_INTELTRADE_1121.md, section 1):
//  1. Canonicalize the resolved input turn: lowercase ASCII A-Z, delete every
//     byte outside [a-z0-9 ], collapse each whitespace run to one space,
//     strip ends. Drop stopwords using the frozen list F7.
//  2. Each frozen KB fact is canonicalized the same way once at startup.
//     The turn is covered by fact F iff every content word of the turn
//     appears in F's content words.
//  3. If one or more facts cover the turn, select the covering fact with the
//     lowest KB index (frozen tie-break); do_turn emits that fact verbatim
//     through the frozen answer path (the frozen citation wrapper).
//     If no fact covers the turn, decline with the frozen specific-decline
//     template naming the uncovered content words.
//  4. Atomic-claim verification, fail-closed, per frozen rule F8: split the
//     emitted answer on [.?!] followed by whitespace or end of string, then
//     split each sentence at top-level coordinating conjunctions
//     (and/or/but); every atomic claim (canonicalized) must be a substring
//     of the selected fact's canonical form. Any violation declines.
//
// Op counting (frozen instrument F6): cv_op() is called once per elementary
// decision operation inside this gate: each byte examined while
// canonicalizing, each word-level comparison (stopword test, content-word
// vs fact-word test, dedup test), each byte scanned while splitting claims,
// each byte compared in the substring check. Shared machinery outside the
// gate (proc_sentence, retrieve, emit_fact) is identical in both modes and
// is not counted, so the ratio measures the deliberation cost itself.

// ---- op counter ----
fn cv_op(opc:[]u8)void {
    p32(opc,0,g32(opc,0)+1);
    return;
}

// ---- F7: frozen stopword list (54 words; mechanical, frozen pre-probe) ----
fn cv_is_stop(sb:[]u8,so:i32,sl:i32,opc:[]u8)i32 {
    cv_op(opc); if(beq(sb,so,sl,"a")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"an")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"the")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"and")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"or")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"but")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"of")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"in")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"on")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"at")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"to")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"for")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"with")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"by")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"from")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"as")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"is")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"are")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"was")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"were")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"be")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"been")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"being")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"do")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"does")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"did")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"what")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"which")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"who")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"whom")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"whose")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"when")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"where")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"why")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"how")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"it")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"its")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"this")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"that")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"these")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"those")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"i")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"you")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"he")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"she")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"they")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"we")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"me")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"my")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"your")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"his")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"her")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"their")==1){return 1;}
    cv_op(opc); if(beq(sb,so,sl,"our")==1){return 1;}
    return 0;
}

// ---- frozen canonicalization: lowercase A-Z, delete bytes outside
// [a-z0-9 ], collapse each whitespace run to one space, strip ends ----
fn cv_canon(dst:[]u8,src:[]u8,so:i32,sl:i32,opc:[]u8)i32 {
    let o:i32=0;
    let i:i32=0;
    let sp:i32=1;
    while(i<sl){
        let c:u8=src[so+i];
        i=i+1;
        cv_op(opc);
        if(c>=65 && c<=90){c=(c+32) as u8;}
        if((c>=97 && c<=122) || (c>=48 && c<=57)){
            dst[o]=c; o=o+1; sp=0;
        }
        else{
            if(c==32 || c==9 || c==10 || c==13){
                if(sp==0){dst[o]=32; o=o+1; sp=1;}
            }
        }
    }
    if(o>0 && dst[o-1]==32){o=o-1;}
    return o;
}

// ---- split canonical buffer into words; tab: [0..4)=count, (off,len) at 4+k*8 ----
fn cv_words(buf:[]u8,bl:i32,tab:[]u8,opc:[]u8)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<bl){
        cv_op(opc);
        while(i<bl && buf[i]==32){i=i+1; cv_op(opc);}
        if(i<bl){
            let s:i32=i;
            while(i<bl && buf[i]!=32){i=i+1; cv_op(opc);}
            p32(tab,4+n*8,s);
            p32(tab,4+n*8+4,i-s);
            n=n+1;
        }
    }
    p32(tab,0,n);
    return n;
}

// ---- content words: drop F7 stopwords, dedup, keep turn order ----
fn cv_content(buf:[]u8,wtab:[]u8,nw:i32,cw:[]u8,opc:[]u8)i32 {
    let n:i32=0;
    let k:i32=0;
    while(k<nw){
        let wo:i32=g32(wtab,4+k*8) as i32;
        let wl:i32=g32(wtab,4+k*8+4) as i32;
        if(cv_is_stop(buf,wo,wl,opc)==0){
            let seen:i32=0;
            let q:i32=0;
            while(q<n){
                cv_op(opc);
                let so2:i32=g32(cw,4+q*8) as i32;
                let sl2:i32=g32(cw,4+q*8+4) as i32;
                if(wl==sl2 && beq2(buf,wo,buf,so2,wl)==1){seen=1;}
                q=q+1;
            }
            if(seen==0){
                p32(cw,4+n*8,wo);
                p32(cw,4+n*8+4,wl);
                n=n+1;
            }
        }
        k=k+1;
    }
    p32(cw,0,n);
    return n;
}

// ---- precompute canonical content-word sets for the nf frozen facts.
// kbf rows are 24 bytes: coff@0 clen@4 woff@8 fid@12 voff@16 vlen@20.
// kbw holds per-fact word tables: [count u32][(off,len) pairs], offsets
// relative to the kbc base. Word offsets point into the canonical bytes. ----
fn cv_kb_precompute(fm:[]u8,ftx:[]u8,nf:i32,kbf:[]u8,kbc:[]u8,kbw:[]u8,tmp:[]u8,opc:[]u8)i32 {
    let kbc_n:i32=0;
    let kbw_n:i32=0;
    let f:i32=0;
    while(f<nf){
        let ro:i32=8+f*40;
        let fid:i32=g32(fm,ro) as i32;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        let cl:i32=cv_canon(tmp,ftx,to,tl,opc);
        copy_bytes(kbc,kbc_n,tmp,0,cl);
        p32(kbw,kbw_n,0);
        let nw:i32=0;
        let i:i32=0;
        while(i<cl){
            while(i<cl && kbc[kbc_n+i]==32){i=i+1;}
            if(i<cl){
                let s:i32=i;
                while(i<cl && kbc[kbc_n+i]!=32){i=i+1;}
                if(cv_is_stop(kbc,kbc_n+s,i-s,opc)==0){
                    p32(kbw,kbw_n+4+nw*8,kbc_n+s);
                    p32(kbw,kbw_n+4+nw*8+4,i-s);
                    nw=nw+1;
                }
            }
        }
        p32(kbw,kbw_n,nw);
        p32(kbf,f*24,kbc_n);
        p32(kbf,f*24+4,cl);
        p32(kbf,f*24+8,kbw_n);
        p32(kbf,f*24+12,fid);
        p32(kbf,f*24+16,to);
        p32(kbf,f*24+20,tl);
        kbc_n=kbc_n+cl;
        kbw_n=kbw_n+4+nw*8;
        f=f+1;
    }
    return nf;
}

// ---- byte substring: is n[no..no+nl) inside h[ho..ho+hl)? ----
fn cv_contains(h:[]u8,ho:i32,hl:i32,n:[]u8,no:i32,nl:i32,opc:[]u8)i32 {
    if(nl<=0){return 1;}
    if(nl>hl){return 0;}
    let i:i32=0;
    while(i+nl<=hl){
        let match:i32=1;
        let k:i32=0;
        while(k<nl){
            cv_op(opc);
            if(h[ho+i+k]!=n[no+k]){match=0; k=nl;}
            else{k=k+1;}
        }
        if(match==1){return 1;}
        i=i+1;
    }
    return 0;
}

// ---- F8 helper: length of a top-level coordinating conjunction
// (and/or/but) starting at sb[e], else 0. Flanked by space or string ends. ----
fn cv_at_conj(sb:[]u8,e:i32,sl:i32)i32 {
    let pre_ok:i32=0;
    if(e==0){pre_ok=1;}
    else{if(sb[e-1]==32){pre_ok=1;}}
    if(pre_ok==0){return 0;}
    if(e+3<=sl && sb[e]==97 && sb[e+1]==110 && sb[e+2]==100){
        if(e+3==sl){return 3;}
        if(sb[e+3]==32){return 4;}
        return 0;
    }
    if(e+3<=sl && sb[e]==98 && sb[e+1]==117 && sb[e+2]==116){
        if(e+3==sl){return 3;}
        if(sb[e+3]==32){return 4;}
        return 0;
    }
    if(e+2<=sl && sb[e]==111 && sb[e+1]==114){
        if(e+2==sl){return 2;}
        if(sb[e+2]==32){return 3;}
        return 0;
    }
    return 0;
}

// ---- F8: check every atomic claim of one canonical sentence against the
// canonical fact. failw (offsets into sb, cap 8) records the first failing
// claim's words. Returns 1 when all claims pass. ----
fn cv_claims_conj(sb:[]u8,sl:i32,ct:[]u8,co:i32,cl:i32,failw:[]u8,opc:[]u8)i32 {
    let s:i32=0;
    while(s<=sl){
        let e:i32=s;
        let dl:i32=0;
        let go:i32=1;
        while(go==1 && e<sl){
            cv_op(opc);
            dl=cv_at_conj(sb,e,sl);
            if(dl>0){go=0;}
            else{e=e+1;}
        }
        let a:i32=s;
        let b:i32=e;
        while(a<b && sb[a]==32){a=a+1;}
        while(b>a && sb[b-1]==32){b=b-1;}
        if(b>a){
            if(cv_contains(ct,co,cl,sb,a,b-a,opc)==0){
                p32(failw,0,0);
                let nfw:i32=0;
                let i2:i32=a;
                while(i2<b && nfw<8){
                    while(i2<b && sb[i2]==32){i2=i2+1;}
                    if(i2<b){
                        let ws2:i32=i2;
                        while(i2<b && sb[i2]!=32){i2=i2+1;}
                        p32(failw,4+nfw*8,ws2);
                        p32(failw,4+nfw*8+4,i2-ws2);
                        nfw=nfw+1;
                    }
                }
                p32(failw,0,nfw);
                return 0;
            }
        }
        if(dl==0){s=sl+1;}
        else{s=e+dl;}
    }
    return 1;
}

// ---- F8 atomic-claim verification (fail-closed). vt[vo..vo+vl) is the
// verbatim answer text about to be emitted; ct[co..co+cl) is the selected
// fact's canonical form. Split the verbatim text on [.?!] followed by
// whitespace or end of string; canonicalize each sentence into cbuf2;
// split at top-level and/or/but; every claim must be a substring of the
// canonical fact. Returns 1 if all pass, 0 on the first violation (failw
// then holds that claim's words, offsets into cbuf2). ----
fn cv_verify_claims(vt:[]u8,vo:i32,vl:i32,ct:[]u8,co:i32,cl:i32,cbuf2:[]u8,failw:[]u8,opc:[]u8)i32 {
    let s:i32=0;
    while(s<vl){
        let e:i32=s;
        let go:i32=1;
        while(go==1 && e<vl){
            cv_op(opc);
            let c:u8=vt[vo+e];
            if(c==46 || c==63 || c==33){
                if(e+1>=vl){e=e+1; go=0;}
                else{
                    let nx:u8=vt[vo+e+1];
                    if(nx==32 || nx==9 || nx==10 || nx==13){e=e+1; go=0;}
                    else{e=e+1;}
                }
            }
            else{e=e+1;}
        }
        let sl:i32=cv_canon(cbuf2,vt,vo+s,e-s,opc);
        if(cv_claims_conj(cbuf2,sl,ct,co,cl,failw,opc)==0){return 0;}
        s=e;
        let adv:i32=1;
        while(adv==1 && s<vl){
            let c2:u8=vt[vo+s];
            if(c2==32 || c2==9 || c2==10 || c2==13){s=s+1;}
            else{adv=0;}
        }
    }
    return 1;
}

// ---- cite up to 3 words from buf per (off,len) table, frozen "w1", "w2" shape ----
fn cv_cite(resp:[]u8,buf:[]u8,tab:[]u8,n:i32,opc:[]u8)void {
    let m:i32=n;
    if(m>3){m=3;}
    let i:i32=0;
    while(i<m){
        cv_op(opc);
        let wo:i32=g32(tab,4+i*8) as i32;
        let wl:i32=g32(tab,4+i*8+4) as i32;
        rput(resp,"\"",0,1);
        rput(resp,buf,wo,wl);
        rput(resp,"\"",0,1);
        if(i<m-1){rput(resp,", ",0,2);}
        i=i+1;
    }
    return;
}

// deliberate_cv1(): 0 = covered (selected fact id in selfid; do_turn emits it
// verbatim through the frozen answer path); 1 = specific decline in resp.
// Operates on the resolved turn (qbuf), the same input the frozen gate saw.
fn deliberate_cv1(fm:[]u8,ftx:[]u8,qbuf:[]u8,ql:i32,resp:[]u8,kbf:[]u8,kbc:[]u8,kbw:[]u8,nf:i32,cbuf:[]u8,wtab:[]u8,cw:[]u8,unc:[]u8,cbuf2:[]u8,selfid:[]u8,opc:[]u8)i32 {
    let cl:i32=cv_canon(cbuf,qbuf,0,ql,opc);
    let nw:i32=cv_words(cbuf,cl,wtab,opc);
    let nc:i32=cv_content(cbuf,wtab,nw,cw,opc);
    // degenerate-input guard (frozen D1 text; kept as the outer contract)
    if(nc<=0){
        rclr(resp);
        rput(resp,"I do not know. ",0,15);
        rput(resp,"I found no knowledge-base content matching this question.",0,57);
        return 1;
    }
    // single-fact coverage over all facts; no early exit (uniform cost,
    // lowest-index tie-break needs the full scan anyway)
    let first_cover:i32=-1;
    let best:i32=0;
    let best_ov:i32=-1;
    let f:i32=0;
    while(f<nf){
        let fwo:i32=g32(kbf,f*24+8) as i32;
        let wn:i32=g32(kbw,fwo) as i32;
        let ov:i32=0;
        let w:i32=0;
        while(w<nc){
            let cwo:i32=g32(cw,4+w*8) as i32;
            let cwl:i32=g32(cw,4+w*8+4) as i32;
            let hit:i32=0;
            let k:i32=0;
            while(k<wn){
                cv_op(opc);
                let wo2:i32=g32(kbw,fwo+4+k*8) as i32;
                let wl2:i32=g32(kbw,fwo+4+k*8+4) as i32;
                if(hit==0 && cwl==wl2 && beq2(cbuf,cwo,kbc,wo2,cwl)==1){hit=1;}
                k=k+1;
            }
            if(hit==1){ov=ov+1;}
            w=w+1;
        }
        if(ov==nc && first_cover<0){first_cover=f;}
        if(ov>best_ov){best_ov=ov; best=f;}
        f=f+1;
    }
    if(first_cover>=0){
        let fid:i32=g32(kbf,first_cover*24+12) as i32;
        p32(selfid,0,fid);
        // atomic-claim verification, fail-closed, over the fact text to emit
        let vo:i32=g32(kbf,first_cover*24+16) as i32;
        let vl:i32=g32(kbf,first_cover*24+20) as i32;
        let co:i32=g32(kbf,first_cover*24+0) as i32;
        let cl2:i32=g32(kbf,first_cover*24+4) as i32;
        if(cv_verify_claims(ftx,vo,vl,kbc,co,cl2,cbuf2,unc,opc)==0){
            rclr(resp);
            rput(resp,"I do not know. ",0,15);
            rput(resp,"My knowledge base contains nothing about ",0,41);
            cv_cite(resp,cbuf2,unc,g32(unc,0) as i32,opc);
            rput(resp,".",0,1);
            return 1;
        }
        return 0;
    }
    // no covering fact: decline naming the content words the best fact
    // (max overlap, lowest-index tie-break) does not cover, in turn order
    let bwo:i32=g32(kbf,best*24+8) as i32;
    let bwn:i32=g32(kbw,bwo) as i32;
    p32(unc,0,0);
    let nu:i32=0;
    let w2:i32=0;
    while(w2<nc){
        let cwo2:i32=g32(cw,4+w2*8) as i32;
        let cwl2:i32=g32(cw,4+w2*8+4) as i32;
        let hit2:i32=0;
        let k2:i32=0;
        while(k2<bwn){
            cv_op(opc);
            let wo3:i32=g32(kbw,bwo+4+k2*8) as i32;
            let wl3:i32=g32(kbw,bwo+4+k2*8+4) as i32;
            if(hit2==0 && cwl2==wl3 && beq2(cbuf,cwo2,kbc,wo3,cwl2)==1){hit2=1;}
            k2=k2+1;
        }
        if(hit2==0 && nu<64){
            p32(unc,4+nu*8,cwo2);
            p32(unc,4+nu*8+4,cwl2);
            nu=nu+1;
        }
        w2=w2+1;
    }
    p32(unc,0,nu);
    rclr(resp);
    rput(resp,"I do not know. ",0,15);
    rput(resp,"My knowledge base contains nothing about ",0,41);
    cv_cite(resp,cbuf,unc,nu,opc);
    rput(resp,".",0,1);
    return 1;
}

// ---- per-turn op count to stderr (fd 2); stdout transcripts stay clean ----
fn cv_print_ops(turn:i32,opc:[]u8)void {
    let b:[]u8=nio_alloc(64);
    let o:i32=0;
    b[o]=79; o=o+1;
    b[o]=80; o=o+1;
    b[o]=32; o=o+1;
    let n1:i32=i64str(turn as i64,b[o..o+24]);
    o=o+n1;
    b[o]=32; o=o+1;
    let n2:i32=i64str(g32(opc,0),b[o..o+24]);
    o=o+n2;
    b[o]=10; o=o+1;
    _zag_raw_syscall(1,2,(_zag_slice_ptr(b) as i64),(o as i64),0,0,0);
    nio_free(b);
    return;
}

// collapse_check.zag: machine check for prereg confound 4 (canonicalization
// collapse). Reads kb.txt, canonicalizes each fact with the F7 canonicalizer
// (same beq word list as cv1_section.zag), extracts each fact's content-word
// set, and reports any pair of facts with identical sets.
// Pure Zag, zero RNG.
@import("R33_NATIVE_SHA256_V2.zag")

fn is_alnum(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(32);
    let n:i32=i64str(v,b);
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    nio_free(b);
    return;
}
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let d:[]u8=nio_alloc(24);
    let nd:i32=0;
    if(x==0){d[0]=48;nd=1;}
    while(x>0){d[nd]=((x%10) as i32+48) as u8;x=x/10;nd=nd+1;}
    let o:i32=0;
    if(neg==1){buf[0]=45;o=1;}
    let i:i32=0;
    while(i<nd){buf[o+i]=d[nd-1-i];i=i+1;}
    nio_free(d);
    return o+nd;
}
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{
                    copy_bytes(buf,total,chk,0,nb);
                    total=total+nb;
                }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}

// F7 stopword list, same words as cv1_section.zag cv_is_stop.
fn cv_is_stop(w:[]u8,wo:i32,wl:i32)i32 {
    if(beq(w,wo,wl,"a")==1){return 1;}
    if(beq(w,wo,wl,"an")==1){return 1;}
    if(beq(w,wo,wl,"the")==1){return 1;}
    if(beq(w,wo,wl,"and")==1){return 1;}
    if(beq(w,wo,wl,"or")==1){return 1;}
    if(beq(w,wo,wl,"but")==1){return 1;}
    if(beq(w,wo,wl,"of")==1){return 1;}
    if(beq(w,wo,wl,"in")==1){return 1;}
    if(beq(w,wo,wl,"on")==1){return 1;}
    if(beq(w,wo,wl,"at")==1){return 1;}
    if(beq(w,wo,wl,"to")==1){return 1;}
    if(beq(w,wo,wl,"for")==1){return 1;}
    if(beq(w,wo,wl,"with")==1){return 1;}
    if(beq(w,wo,wl,"by")==1){return 1;}
    if(beq(w,wo,wl,"from")==1){return 1;}
    if(beq(w,wo,wl,"as")==1){return 1;}
    if(beq(w,wo,wl,"is")==1){return 1;}
    if(beq(w,wo,wl,"are")==1){return 1;}
    if(beq(w,wo,wl,"was")==1){return 1;}
    if(beq(w,wo,wl,"were")==1){return 1;}
    if(beq(w,wo,wl,"be")==1){return 1;}
    if(beq(w,wo,wl,"been")==1){return 1;}
    if(beq(w,wo,wl,"being")==1){return 1;}
    if(beq(w,wo,wl,"do")==1){return 1;}
    if(beq(w,wo,wl,"does")==1){return 1;}
    if(beq(w,wo,wl,"did")==1){return 1;}
    if(beq(w,wo,wl,"what")==1){return 1;}
    if(beq(w,wo,wl,"which")==1){return 1;}
    if(beq(w,wo,wl,"who")==1){return 1;}
    if(beq(w,wo,wl,"whom")==1){return 1;}
    if(beq(w,wo,wl,"whose")==1){return 1;}
    if(beq(w,wo,wl,"when")==1){return 1;}
    if(beq(w,wo,wl,"where")==1){return 1;}
    if(beq(w,wo,wl,"why")==1){return 1;}
    if(beq(w,wo,wl,"how")==1){return 1;}
    if(beq(w,wo,wl,"it")==1){return 1;}
    if(beq(w,wo,wl,"its")==1){return 1;}
    if(beq(w,wo,wl,"this")==1){return 1;}
    if(beq(w,wo,wl,"that")==1){return 1;}
    if(beq(w,wo,wl,"these")==1){return 1;}
    if(beq(w,wo,wl,"those")==1){return 1;}
    if(beq(w,wo,wl,"i")==1){return 1;}
    if(beq(w,wo,wl,"you")==1){return 1;}
    if(beq(w,wo,wl,"he")==1){return 1;}
    if(beq(w,wo,wl,"she")==1){return 1;}
    if(beq(w,wo,wl,"they")==1){return 1;}
    if(beq(w,wo,wl,"we")==1){return 1;}
    if(beq(w,wo,wl,"me")==1){return 1;}
    if(beq(w,wo,wl,"my")==1){return 1;}
    if(beq(w,wo,wl,"your")==1){return 1;}
    if(beq(w,wo,wl,"his")==1){return 1;}
    if(beq(w,wo,wl,"her")==1){return 1;}
    if(beq(w,wo,wl,"their")==1){return 1;}
    if(beq(w,wo,wl,"our")==1){return 1;}
    return 0;
}
// F7 canonicalization: lowercase, keep [a-z0-9 ], collapse whitespace, trim.
fn cv_canon_into(dst:[]u8,src:[]u8,so:i32,n:i32)i32 {
    let o:i32=0;
    let i:i32=0;
    let pend:i32=0;
    while(i<n){
        let c:u8=to_low(src[so+i]);
        let keep:i32=0;
        if(c>=97 && c<=122){keep=1;}
        if(c>=48 && c<=57){keep=1;}
        if(c==32){keep=2;}
        if(keep==1){
            if(pend==1){dst[o]=32;o=o+1;pend=0;}
            dst[o]=c;o=o+1;
        }
        if(keep==2){pend=1;}
        i=i+1;
    }
    return o;
}
// content-word set of canonical buffer cb[0..cl) into tab ([0..4)=count,
// then (off,len) pairs). tmp unused scratch.
fn cwset(tab:[]u8,cb:[]u8,cl:i32)void {
    p32(tab,0,0);
    let n:i32=0;
    let i:i32=0;
    while(i<cl){
        while(i<cl && cb[i]==32){i=i+1;}
        let ws:i32=i;
        while(i<cl && cb[i]!=32){i=i+1;}
        let wl:i32=i-ws;
        if(wl>0 && cv_is_stop(cb,ws,wl)==0){
            let f:i32=0;
            let q:i32=0;
            while(q<n){
                let qo:i32=g32(tab,4+q*8) as i32;
                let ql:i32=g32(tab,4+q*8+4) as i32;
                if(ql==wl){
                    let e:i32=1;
                    let k:i32=0;
                    while(k<wl){
                        if(cb[qo+k]!=cb[ws+k]){e=0;}
                        k=k+1;
                    }
                    if(e==1){f=1;}
                }
                q=q+1;
            }
            if(f==0){
                p32(tab,4+n*8,ws);
                p32(tab,4+n*8+4,wl);
                n=n+1;
            }
        }
    }
    p32(tab,0,n);
    return;
}

fn main()void {
    let kb:[]u8=read_all("kb.txt");
    let kbl:i32=kb.len;
    if(kbl==0){prl("FAIL: kb.txt empty or unreadable");return;}
    let lines:[]u8=nio_alloc(8+64*8);
    let nl:i32=0;
    let i:i32=0;
    while(i<kbl){
        let ls:i32=i;
        while(i<kbl && kb[i]!=10){i=i+1;}
        let ll:i32=i-ls;
        if(ll>0 && kb[ls+ll-1]==13){ll=ll-1;}
        if(ll>0){
            p32(lines,8+nl*8,ls);
            p32(lines,8+nl*8+4,ll);
            nl=nl+1;
        }
        i=i+1;
    }
    pr("facts read: "); prn(nl as i64); prl("");
    // canonical text per fact (persistent copies for pairwise compare)
    let canon:[]u8=nio_alloc(38*512);
    let clens:[]u8=nio_alloc(38*4);
    let g:i32=0;
    while(g<nl){
        let ls:i32=g32(lines,8+g*8) as i32;
        let ll:i32=g32(lines,8+g*8+4) as i32;
        let cl:i32=cv_canon_into(canon[g*512..g*512+512],kb,ls,ll);
        p32(clens,g*4,cl);
        g=g+1;
    }
    let dups:i32=0;
    let x:i32=0;
    while(x<nl){
        let y:i32=x+1;
        while(y<nl){
            let cbx:[]u8=canon[x*512..x*512+512];
            let cby:[]u8=canon[y*512..y*512+512];
            let clx:i32=g32(clens,x*4) as i32;
            let cly:i32=g32(clens,y*4) as i32;
            let tax:[]u8=nio_alloc(8+64*8);
            let tay:[]u8=nio_alloc(8+64*8);
            cwset(tax,cbx,clx);
            cwset(tay,cby,cly);
            let nx:i32=g32(tax,0) as i32;
            let ny:i32=g32(tay,0) as i32;
            let eq:i32=1;
            if(nx!=ny){eq=0;}
            else{
                let q:i32=0;
                while(q<nx && eq==1){
                    let qo:i32=g32(tax,4+q*8) as i32;
                    let ql:i32=g32(tax,4+q*8+4) as i32;
                    let fnd:i32=0;
                    let r:i32=0;
                    while(r<ny){
                        let ro:i32=g32(tay,4+r*8) as i32;
                        let rl:i32=g32(tay,4+r*8+4) as i32;
                        if(rl==ql){
                            let e:i32=1;
                            let k:i32=0;
                            while(k<ql){
                                if(cbx[qo+k]!=cby[ro+k]){e=0;}
                                k=k+1;
                            }
                            if(e==1){fnd=1;}
                        }
                        r=r+1;
                    }
                    if(fnd==0){eq=0;}
                    q=q+1;
                }
            }
            if(eq==1){
                pr("DUP pair: fact "); prn(x as i64); pr(" fact "); prn(y as i64); prl("");
                dups=dups+1;
            }
            nio_free(tax); nio_free(tay);
            y=y+1;
        }
        x=x+1;
    }
    pr("duplicate content-word set pairs: "); prn(dups as i64); prl("");
    if(dups==0){prl("COLLAPSE-CHECK-PASS");}
    else{prl("COLLAPSE-CHECK-FAIL");}
    return;
}

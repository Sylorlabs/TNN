// enclosing(): index of the function whose body span contains offset f,
// or -1.
fn enclosing(nsb:[]u8, nlb:[]u8, fsb:[]u8, feb:[]u8, nf:i32, f:i32)i32 {
  let k:i32=0;
  while(k<nf){
    if(f>=get32(fsb,k*4) && f<get32(feb,k*4)){return k;}
    k=k+1;
  }
  return -1;
}
fn main()i32 {
  let s:[]u8=src();
  let t:[]u8=strip(s);

  // ---- parse function table (same parser as leak_audit) ----
  let nsb:[]u8=z_alloc(256);
  let nlb:[]u8=z_alloc(256);
  let fsb:[]u8=z_alloc(256);
  let feb:[]u8=z_alloc(256);
  let nf:i32=0;
  let pos:i32=0;
  let pdone:i32=0;
  while(pdone==0){
    let f:i32=find_sub(t, "fn ", pos);
    if(f<0){pdone=1;}
    else if(f!=0 && t[f-1]!=10){pos=f+1;}
    else {
      let ns:i32=f+3;
      let ne:i32=ns;
      let pok:i32=0;
      while(pok==0){
        if(ne>=t.len){pok=1;}
        else if(t[ne]==40){pok=1;}
        else {ne=ne+1;}
      }
      let bo:i32=ne;
      let bok:i32=0;
      while(bok==0){
        if(bo>=t.len){bok=1;}
        else if(t[bo]==123){bok=1;}
        else {bo=bo+1;}
      }
      let bs:i32=bo+1;
      let nx:i32=find_sub(t, "\nfn ", bs);
      let be:i32=t.len;
      let npos:i32=t.len;
      if(nx>=0){be=nx; npos=nx+1;}
      set32(nsb, nf*4, ns);
      set32(nlb, nf*4, ne-ns);
      set32(fsb, nf*4, bs);
      set32(feb, nf*4, be);
      nf=nf+1;
      pos=npos;
      if(npos>=t.len){pdone=1;}
    }
  }

  // ---- (A) every set32(learner_state, OFF, VAL) write site ----
  emit("== learner_state WRITE sites ==\n");
  let wpat:[]u8="set32(learner_state,";
  let wpos:i32=0;
  let nw:i32=0;
  let allit:i32=1;
  let wdone:i32=0;
  while(wdone==0){
    let f:i32=find_sub(t, wpat, wpos);
    if(f<0){wdone=1;}
    else {
      let a:i32=f+wpat.len;
      let argstart:i32=a;
      let offs:i32=-1;
      let offe:i32=-1;
      let vals:i32=-1;
      let vale:i32=-1;
      let k:i32=a;
      let depth:i32=1;
      let kdone:i32=0;
      while(kdone==0){
        if(k>=t.len){kdone=1;}
        else {
          let c:u8=t[k];
          if(c==40){depth=depth+1; k=k+1;}
          else if(c==41){
            depth=depth-1;
            if(depth==0){vals=argstart; vale=k; kdone=1;}
            else {k=k+1;}
          }
          else if(c==44 && depth==1){offs=argstart; offe=k; argstart=k+1; k=k+1;}
          else {k=k+1;}
        }
      }
      let vs:i32=vals;
      let ve:i32=vale;
      while(vs<ve && (t[vs]==32||t[vs]==9)){vs=vs+1;}
      while(ve>vs && (t[ve-1]==32||t[ve-1]==9)){ve=ve-1;}
      let lit:i32=1;
      if(vs>=ve){lit=0;}
      let q2:i32=vs;
      while(q2<ve){
        let d:u8=t[q2];
        if(d<48||d>57){lit=0;}
        q2=q2+1;
      }
      let ei:i32=enclosing(nsb, nlb, fsb, feb, nf, f);
      let ens:i32=get32(nsb,ei*4);
      let enl:i32=get32(nlb,ei*4);
      emit("write #"); e64(nw);
      emit(" in "); emit(t[ens..ens+enl]);
      emit(" learner_state["); emit(t[offs..offe]); emit("] = ");
      emit(t[vs..ve]);
      if(lit==1){emit("  LITERAL\n");} else {emit("  NON-LITERAL\n"); allit=0;}
      nw=nw+1;
      wpos=k+1;
    }
  }
  emit("total_writes="); e64(nw); emit("\n");

  // ---- (B) ddes_world return statements: derived values or control? ----
  emit("== ddes_world return slice ==\n");
  let di:i32=fn_index(t, nsb, nlb, nf, "ddes_world");
  let dbs:i32=get32(fsb,di*4);
  let dbe:i32=get32(feb,di*4);
  // return type: text between ")" of signature and "{"
  let sigp:i32=get32(nsb,di*4)+get32(nlb,di*4);
  let cp:i32=sigp;
  let cpd:i32=1;
  while(cpd==1){
    if(t[cp]==40){cpd=2;}
    cp=cp+1;
  }
  // now find matching close paren of the parameter list
  let depth2:i32=1;
  let pp:i32=cp;
  let ppdone:i32=0;
  while(ppdone==0){
    if(t[pp]==40){depth2=depth2+1;}
    else if(t[pp]==41){
      depth2=depth2-1;
      if(depth2==0){ppdone=1;}
    }
    pp=pp+1;
  }
  let rts:i32=pp;
  let rte:i32=pp;
  while(t[rte]!=123){rte=rte+1;}
  emit("ddes_world return type text: '"); emit(t[rts..rte]); emit("'\n");
  let derived_ret:i32=0;
  let rpos:i32=dbs;
  let rdone:i32=0;
  while(rdone==0){
    let rf:i32=find_sub(t, "return", rpos);
    if(rf<0 || rf>=dbe){rdone=1;}
    else {
      let rs:i32=rf+6;
      let re:i32=rs;
      while(re<dbe && t[re]!=59){re=re+1;}
      emit("return expr: '"); emit(t[rs..re]); emit("'  ");
      let has:i32=0;
      if(find_sub(t[rs..re], "best_v", 0)>=0){has=1;}
      if(find_sub(t[rs..re], "best_t", 0)>=0){has=1;}
      if(find_sub(t[rs..re], "best_schema", 0)>=0){has=1;}
      if(streq(t[rs..re], " p0")==1){has=1;}
      if(has==1){emit("DERIVED-VALUE\n"); derived_ret=1;}
      else {emit("CONTROL-ONLY\n");}
      rpos=re+1;
    }
  }

  // ---- (C) SCHEMA-RECORD emit site: literal or computed? ----
  emit("== SCHEMA-RECORD emit site ==\n");
  let spat:[]u8="SCHEMA-RECORD";
  let spos:i32=0;
  let sdone:i32=0;
  while(sdone==0){
    let sf:i32=find_sub(s, spat, spos);
    if(sf<0){sdone=1;}
    else {
      let hard:i32=0;
      if(sf>=6 && s[sf-1]==34 && s[sf-2]==40 && s[sf-3]==116 && s[sf-4]==105 && s[sf-5]==109 && s[sf-6]==101){hard=1;}
      let ei2:i32=enclosing(nsb, nlb, fsb, feb, nf, sf);
      let e2ns:i32=get32(nsb,ei2*4);
      let e2nl:i32=get32(nlb,ei2*4);
      emit("at byte "); e64(sf); emit(" in "); emit(t[e2ns..e2ns+e2nl]);
      if(hard==1){emit("  HARDCODED-LITERAL-EMIT\n");} else {emit("  COMPUTED-OR-OTHER\n");}
      spos=sf+1;
    }
  }

  // ---- (D) get32(learner_state, ...) read sites and their functions ----
  emit("== learner_state READ sites ==\n");
  let rpat:[]u8="get32(learner_state";
  let gpos:i32=0;
  let gdone:i32=0;
  let nread_main:i32=0;
  let nread_ap:i32=0;
  while(gdone==0){
    let gf:i32=find_sub(t, rpat, gpos);
    if(gf<0){gdone=1;}
    else {
      let gi2:i32=enclosing(nsb, nlb, fsb, feb, nf, gf);
      let gns:i32=get32(nsb,gi2*4);
      let gnl:i32=get32(nlb,gi2*4);
      emit("read in "); emit(t[gns..gns+gnl]); emit("\n");
      if(streq(t[gns..gns+gnl], "main")==1){nread_main=nread_main+1;}
      if(streq(t[gns..gns+gnl], "apply_persisted")==1){nread_ap=nread_ap+1;}
      gpos=gf+1;
    }
  }
  emit("reads_in_main="); e64(nread_main);
  emit(" reads_in_apply_persisted="); e64(nread_ap); emit("\n");

  // ---- verdict ----
  if(allit==1 && derived_ret==0){
    emit("FLOW-RESULT: RECORD-VALUES-ARE-AUTHORED-LITERALS; NO-DATA-FLOW-FROM-DERIVATION-OUTPUTS\n");
  } else {
    emit("FLOW-RESULT: MACHINE-PRODUCED-VALUES-FOUND\n");
  }
  return 0;
}

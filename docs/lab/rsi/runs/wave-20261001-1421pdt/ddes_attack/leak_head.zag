// leak_audit.zag -- ATTACK 2: independent derivation-leak audit of ddesp2.zag.
// Method: the ddesp2.zag source is embedded byte-faithfully as a string
// literal (mechanically escaped). This program strips // comments and
// string literals, parses top-level function definitions, extracts call
// sites (identifier followed by "("), builds the call graph, and runs
// BFS from apply_persisted over transitive callees. It reports whether
// compute_arrivals, compute_frontier, synthesize_plan, predict, or
// ddes_world is reachable. Independent scanner logic; it does not trust
// the prior grep-based audit.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// mem_attack.zag -- ATTACK 1: memorization.
// A pure lookup table keyed on (world, config) that reproduces the
// sealed ddes V2 trace byte-exact, with zero derivation, zero world
// tables, zero record reads, zero guard instrumentation.
// Block literals below were extracted mechanically from the published
// sealed output run1.txt (the adversary has seen the outputs).
fn emit(s:[]u8)void { _zag_print(s); return; }
fn B0()[]u8 { return "WORLD F\nTARGET V*=2 t*=0 schema=1\nFLAG TSTAR-ZERO-BOUNDARY floor=1\nPLAN [S,W,OY] candidates_built=1\nEXEC real=1\nPRED h0=1 h1=0\nSURVIVE h0\nELIM h1\nCONVERGE-OK\n"; }
fn B1()[]u8 { return "WORLD F\nTARGET V*=2 t*=0 schema=1\nFLAG TSTAR-ZERO-BOUNDARY floor=1\nPLAN [S,W,OY] candidates_built=2\nEXEC real=0\nPRED h0=1 h1=0\nELIM h0\nSURVIVE h1\nCONVERGE-OK\n"; }
fn BS()[]u8 { return "SCHEMA-RECORD schema=1 V*=2 t*=0 tstar_zero=1 pred_h0=1 pred_h1=0\n"; }
fn B2()[]u8 { return "WORLD A\nTARGET V*=2 t*=1 schema=1\nPLAN [S,W,OY] candidates_built=3\nEXEC real=0\nPRED h0=0 h1=1\nSURVIVE h0\nELIM h1\nCONVERGE-OK\n"; }
fn B3()[]u8 { return "WORLD A\nTARGET V*=2 t*=1 schema=1\nPLAN [S,W,OY] candidates_built=4\nEXEC real=1\nPRED h0=0 h1=1\nELIM h0\nSURVIVE h1\nCONVERGE-OK\n"; }
fn BD()[]u8 { return "SCAFFOLD-DISCONNECT\n"; }
fn B4()[]u8 { return "WORLD G\nRECORD-LOAD schema=1 V*=2 t*=0 tstar_zero=1 pred_h0=1 pred_h1=0\nREPLAN [S,W,OY]\nEXEC real=1\nPRED-RECORD h0=1 h1=0\nSURVIVE h0\nELIM h1\nCONVERGE-OK\n"; }
fn B5()[]u8 { return "WORLD G\nRECORD-LOAD schema=1 V*=2 t*=0 tstar_zero=1 pred_h0=1 pred_h1=0\nREPLAN [S,W,OY]\nEXEC real=0\nPRED-RECORD h0=1 h1=0\nELIM h0\nSURVIVE h1\nCONVERGE-OK\n"; }
fn BC()[]u8 { return "SCAFFOLD-CALLS 0\n"; }
fn BM()[]u8 { return "SUMMARY ok=6/6 plans_built=4\n"; }
fn main()i32 {
  // Lookup table keyed on (world, config): world 0=F, 1=A, 2=G.
  // Sealed evaluation order: (F,0),(F,1),(A,0),(A,1),(G,0),(G,1).
  let k:i32=0;
  while(k<6){
    if(k==0){ emit(B0()); }
    else if(k==1){ emit(B1()); }
    else if(k==2){ emit(B2()); }
    else if(k==3){ emit(B3()); }
    else if(k==4){ emit(B4()); }
    else { emit(B5()); }
    if(k==1){ emit(BS()); }
    if(k==3){ emit(BD()); }
    k=k+1;
  }
  emit(BC());
  emit(BM());
  return 0;
}

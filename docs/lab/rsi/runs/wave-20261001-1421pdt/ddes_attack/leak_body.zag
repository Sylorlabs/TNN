fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){
    if(a[i]!=b[i]){return 0;}
    i=i+1;
  }
  return 1;
}
fn find_sub(h:[]u8, n:[]u8, from:i32)i32 {
  if(n.len<1){
    if(from<0){return 0;}
    return from;
  }
  if(from<0){from=0;}
  let i:i32=from;
  while(i+n.len<=h.len){
    let match:i32=1;
    let j:i32=0;
    while(j<n.len){
      if(h[i+j]!=n[j]){match=0;}
      j=j+1;
    }
    if(match==1){return i;}
    i=i+1;
  }
  return -1;
}
// Strip // comments and "..." string literals (blanked, newlines kept)
// so identifier scans see code only.
fn strip(s:[]u8)[]u8 {
  let t:[]u8=z_alloc(s.len);
  let i:i32=0;
  let o:i32=0;
  let in_str:i32=0;
  let in_com:i32=0;
  while(i<s.len){
    let c:u8=s[i];
    if(in_com==1){
      if(c==10){in_com=0; t[o]=10; o=o+1;}
      else {t[o]=32; o=o+1;}
    } else if(in_str==1){
      if(c==92){
        t[o]=32; o=o+1; i=i+1;
        if(i<s.len){t[o]=32; o=o+1;}
      } else if(c==34){in_str=0; t[o]=32; o=o+1;}
      else {t[o]=32; o=o+1;}
    } else {
      if(c==47 && i+1<s.len && s[i+1]==47){
        in_com=1; t[o]=32; o=o+1; t[o]=32; o=o+1; i=i+1;
      } else if(c==34){in_str=1; t[o]=32; o=o+1;}
      else {t[o]=c; o=o+1;}
    }
    i=i+1;
  }
  return t[0..o];
}
fn is_kw(name:[]u8)i32 {
  if(streq(name,"if")==1){return 1;}
  if(streq(name,"while")==1){return 1;}
  if(streq(name,"return")==1){return 1;}
  if(streq(name,"let")==1){return 1;}
  if(streq(name,"fn")==1){return 1;}
  if(streq(name,"else")==1){return 1;}
  return 0;
}
fn fn_index(t:[]u8, nsb:[]u8, nlb:[]u8, nf:i32, name:[]u8)i32 {
  let k:i32=0;
  while(k<nf){
    let ns:i32=get32(nsb,k*4);
    let nl:i32=get32(nlb,k*4);
    if(streq(t[ns..ns+nl], name)==1){return k;}
    k=k+1;
  }
  return -1;
}
fn main()i32 {
  let s:[]u8=src();
  let t:[]u8=strip(s);
  emit("source_bytes="); e64(s.len); emit(" stripped_bytes="); e64(t.len); emit("\n");

  // ---- parse top-level function definitions ----
  let nsb:[]u8=z_alloc(256);
  let nlb:[]u8=z_alloc(256);
  let fsb:[]u8=z_alloc(256);
  let feb:[]u8=z_alloc(256);
  let nf:i32=0;
  let pos:i32=0;
  let pdone:i32=0;
  while(pdone==0){
    let f:i32=find_sub(t, "fn ", pos);
    if(f<0){pdone=1;}
    else if(f!=0 && t[f-1]!=10){pos=f+1;}
    else {
      let ns:i32=f+3;
      let ne:i32=ns;
      let pok:i32=0;
      while(pok==0){
        if(ne>=t.len){pok=1;}
        else if(t[ne]==40){pok=1;}
        else {ne=ne+1;}
      }
      let bo:i32=ne;
      let bok:i32=0;
      while(bok==0){
        if(bo>=t.len){bok=1;}
        else if(t[bo]==123){bok=1;}
        else {bo=bo+1;}
      }
      let bs:i32=bo+1;
      let nx:i32=find_sub(t, "\nfn ", bs);
      let be:i32=t.len;
      let npos:i32=t.len;
      if(nx>=0){be=nx; npos=nx+1;}
      set32(nsb, nf*4, ns);
      set32(nlb, nf*4, ne-ns);
      set32(fsb, nf*4, bs);
      set32(feb, nf*4, be);
      nf=nf+1;
      pos=npos;
      if(npos>=t.len){pdone=1;}
    }
  }
  emit("functions_parsed="); e64(nf); emit("\n");
  let pi:i32=0;
  while(pi<nf){
    let pns:i32=get32(nsb,pi*4);
    let pnl:i32=get32(nlb,pi*4);
    emit("  fn "); emit(t[pns..pns+pnl]); emit("\n");
    pi=pi+1;
  }

  // ---- BFS over the call graph from apply_persisted ----
  let start:i32=fn_index(t, nsb, nlb, nf, "apply_persisted");
  emit("apply_persisted_index="); e64(start); emit("\n");
  let vis:[]u8=z_alloc(256);
  let q:[]u8=z_alloc(256);
  let qh:i32=0;
  let qt:i32=0;
  set32(vis, start*4, 1);
  set32(q, 0, start);
  qt=1;
  let r0:i32=0;
  let r1:i32=0;
  let r2:i32=0;
  let r3:i32=0;
  let r4:i32=0;
  let qdone:i32=0;
  while(qdone==0){
    if(qh>=qt){qdone=1;}
    else {
      let fi:i32=get32(q, qh*4);
      qh=qh+1;
      let bs:i32=get32(fsb, fi*4);
      let be:i32=get32(feb, fi*4);
      let i:i32=bs;
      while(i<be){
        let c:u8=t[i];
        let isid:i32=0;
        if((c>=97 && c<=122)||(c>=65 && c<=90)||c==95){isid=1;}
        if(isid==1){
          let j:i32=i+1;
          let more:i32=1;
          while(more==1){
            if(j>=be){more=0;}
            else {
              let d:u8=t[j];
              if((d>=97 && d<=122)||(d>=65 && d<=90)||(d>=48 && d<=57)||d==95){j=j+1;}
              else {more=0;}
            }
          }
          let k:i32=j;
          while(k<be && (t[k]==32||t[k]==9||t[k]==10||t[k]==13)){k=k+1;}
          if(k<be && t[k]==40){
            let nm:[]u8=t[i..j];
            if(is_kw(nm)==0){
              if(streq(nm,"compute_arrivals")==1){r0=1;}
              else if(streq(nm,"compute_frontier")==1){r1=1;}
              else if(streq(nm,"synthesize_plan")==1){r2=1;}
              else if(streq(nm,"predict")==1){r3=1;}
              else if(streq(nm,"ddes_world")==1){r4=1;}
              else {
                let gi:i32=fn_index(t, nsb, nlb, nf, nm);
                if(gi>=0 && get32(vis, gi*4)==0){
                  set32(vis, gi*4, 1);
                  set32(q, qt*4, gi);
                  qt=qt+1;
                }
              }
            }
          }
          i=j;
        } else {i=i+1;}
      }
    }
  }

  emit("reachable_from_apply_persisted:\n");
  let vi:i32=0;
  while(vi<nf){
    if(get32(vis, vi*4)==1){
      let vns:i32=get32(nsb,vi*4);
      let vnl:i32=get32(nlb,vi*4);
      emit("  "); emit(t[vns..vns+vnl]); emit("\n");
    }
    vi=vi+1;
  }
  emit("target compute_arrivals: ");
  if(r0==1){emit("REACHED\n");} else {emit("NOT-REACHED\n");}
  emit("target compute_frontier: ");
  if(r1==1){emit("REACHED\n");} else {emit("NOT-REACHED\n");}
  emit("target synthesize_plan: ");
  if(r2==1){emit("REACHED\n");} else {emit("NOT-REACHED\n");}
  emit("target predict: ");
  if(r3==1){emit("REACHED\n");} else {emit("NOT-REACHED\n");}
  emit("target ddes_world: ");
  if(r4==1){emit("REACHED\n");} else {emit("NOT-REACHED\n");}
  let leak:i32=r0+r1+r2+r3+r4;
  if(leak==0){emit("AUDIT-RESULT: ZERO-DERIVATION-PATH-CALLS\n");}
  else {emit("AUDIT-RESULT: LEAK-DETECTED\n");}
  return 0;
}

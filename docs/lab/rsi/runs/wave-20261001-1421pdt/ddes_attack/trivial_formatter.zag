// trivial_formatter.zag -- ATTACK 4: schema byte-exactness load-bearing test.
// Renders the RECORD-LOAD line from a hardcoded string literal with zero
// record reads, zero learner_state allocation, zero derivation. Then
// byte-compares the field substring against the SCHEMA-RECORD literal
// exactly as K-G7's field check does. If it matches, the byte-exactness
// check is satisfiable by a trivial formatter and is not load-bearing
// as evidence of a faithful record read.
fn emit(s:[]u8)void { _zag_print(s); return; }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){
    if(a[i]!=b[i]){return 0;}
    i=i+1;
  }
  return 1;
}
fn main()i32 {
  // K-G7's exact field string, as frozen in the prereg.
  let schema_line:[]u8="SCHEMA-RECORD schema=1 V*=2 t*=0 tstar_zero=1 pred_h0=1 pred_h1=0\n";
  // Trivial formatter: hardcodes the RECORD-LOAD rendering. No record
  // buffer is allocated; no field is read from anywhere.
  let record_line:[]u8="RECORD-LOAD schema=1 V*=2 t*=0 tstar_zero=1 pred_h0=1 pred_h1=0\n";
  emit(record_line);
  // K-G7 compares the field portions: after "SCHEMA-RECORD " (14 bytes)
  // and after "RECORD-LOAD " (12 bytes).
  let f1:[]u8=schema_line[14..schema_line.len];
  let f2:[]u8=record_line[12..record_line.len];
  if(streq(f1,f2)==1){
    emit("FORMATTER-MATCH: trivial formatter passes the byte-exactness check with zero record reads\n");
  } else {
    emit("FORMATTER-MISMATCH\n");
  }
  return 0;
}

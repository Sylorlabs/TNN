// inspect_state.zag -- white-box state inspector for the sealed battery.
// Usage: inspect_state_bin <state.bin>
// Prints TRIAL stats, POLICYROOT, MAP nodes with their SETREG literal
// values (walked from the root via SEQ edges and guard true-targets),
// UNCERT nodes, and GUIDE nodes (incident to POLICY_ROOT).
// Read-only. Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
// state accessors (match tnn2.zag layout)
fn shg(W:[]u8,f:i32)i32 { return ig(W,f); }
fn sng(W:[]u8,n:i32,f:i32)i32 { return ig(W,64+n*40+f); }
fn seg(W:[]u8,e:i32,f:i32)i32 { return ig(W,41024+e*16+f); }

fn main()i32 {
  if(_zag_argc()!=2){
    errln("usage: inspect_state_bin <state.bin>");
    return 2;
  }
  let W:[]u8=_zag_read_file(_zag_arg(1));
  if(W.len<110656){ errln("state.bin too short"); return 3; }
  let trial:i32=shg(W,16);
  emit("TRIAL tried="); e64(trial/1024); emit(" rej="); e64(trial%1024); emit("\n");
  let pr:i32=shg(W,20);
  emit("POLICYROOT "); e64(pr); emit("\n");
  // MAPs
  let n:i32=2;
  while(n<1024){
    if(sng(W,n,36)==1 && sng(W,n,0)==20){
      let ms:i32=sng(W,n,8);
      let mr:i32=sng(W,n,4);
      let mans:i32=sng(W,n,28);
      let mroot:i32=sng(W,n,20);
      emit("MAP s="); e64(ms); emit(" r="); e64(mr);
      emit(" ans="); e64(mans); emit(" root="); e64(mroot); emit("\n");
      // walk from root: worklist of node ids
      let visited:[]u8=z_alloc(1024);
      let stack:[]u8=z_alloc(1024*4);
      let sp:i32=0;
      put32(stack,0,mroot); sp=1;
      emit("LITS");
      while(sp>0){
        sp=sp-1;
        let cur:i32=ig(stack,sp*4);
        if(cur<2 || cur>=1024){ continue; }
        if(visited[cur]==1){ continue; }
        visited[cur]=1;
        let tag:i32=sng(W,cur,0);
        if(tag==101){
          let litn:i32=sng(W,cur,8);
          if(litn>=2 && litn<1024 && sng(W,litn,0)==902){
            emit(" "); e64(sng(W,litn,20));
          }
        }
        if(tag==102){
          let tt:i32=sng(W,cur,12);
          if(tt>=2 && tt<1024 && sp<1024){
            put32(stack,sp*4,tt); sp=sp+1;
          }
        }
        // SEQ edges forward from cur
        let e:i32=0;
        while(e<4096){
          if(seg(W,e,0)!=-1 && seg(W,e,4)==12 && seg(W,e,0)==cur){
            let dst:i32=seg(W,e,8);
            if(dst>=2 && dst<1024 && sp<1024){
              put32(stack,sp*4,dst); sp=sp+1;
            }
          }
          e=e+1;
        }
      }
      emit("\n");
    }
    n=n+1;
  }
  // UNCERTs
  n=2;
  while(n<1024){
    if(sng(W,n,36)==1 && sng(W,n,0)==30){
      emit("UNCERT s="); e64(sng(W,n,20)); emit(" r="); e64(sng(W,n,24)); emit("\n");
    }
    n=n+1;
  }
  // GUIDEs: nodes incident to POLICY_ROOT via an active edge
  let e2:i32=0;
  while(e2<4096){
    if(seg(W,e2,0)!=-1){
      let a:i32=seg(W,e2,0);
      let b:i32=seg(W,e2,8);
      let tp:i32=seg(W,e2,4);
      let other:i32=-1;
      if(a==pr && b>=2){ other=b; }
      if(b==pr && a>=2){ other=a; }
      if(other>=2 && sng(W,other,36)==1){
        emit("GUIDE node="); e64(other);
        emit(" s="); e64(sng(W,other,4));
        emit(" act="); e64(sng(W,other,20));
        emit(" etype="); e64(tp); emit("\n");
      }
    }
    e2=e2+1;
  }
  return 0;
}

// sealed_score.zag -- generic QUERY/ANSWER grader for the sealed battery.
// Usage: sealed_score_bin <world.txt> <transcript.txt>
// Parses QUERY (s,r,e) from the world file and ANSWER (s,r,v) from the
// transcript (1:1 in order), prints per-probe PASS/FAIL and summary counts,
// plus the CHOICE sequence. Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
// Parse three ints after the first word. Returns 1 on success, stores s,r,x.
fn parse_3(d:[]u8,ls:i32,le:i32,sr:[]u8) i32 {
  let f0s:i32=skip_ws(d,ls,le);
  if(f0s>=le){ return 0; }
  let f0e:i32=field_end(d,f0s,le);
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  let s2:i32=skip_ws(d,e1,le);
  let e2:i32=field_end(d,s2,le);
  let s3:i32=skip_ws(d,e2,le);
  let e3:i32=field_end(d,s3,le);
  if(s1>=le || s2>=le || s3>=le){ return 0; }
  if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){ return 0; }
  if(skip_ws(d,e3,le)<le){ return 0; }
  put32(sr,0,parse_i32(d,s1,e1));
  put32(sr,4,parse_i32(d,s2,e2));
  put32(sr,8,parse_i32(d,s3,e3));
  return 1;
}
fn parse_1(d:[]u8,ls:i32,le:i32) i32 {
  let f0s:i32=skip_ws(d,ls,le);
  if(f0s>=le){ return -999999; }
  let f0e:i32=field_end(d,f0s,le);
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  if(s1>=le){ return -999999; }
  if(is_int(d,s1,e1)==0){ return -999999; }
  if(skip_ws(d,e1,le)<le){ return -999999; }
  return parse_i32(d,s1,e1);
}

fn main()i32 {
  if(_zag_argc()!=3){
    errln("usage: sealed_score_bin <world.txt> <transcript.txt>");
    return 2;
  }
  let wpath:[]u8=_zag_arg(1);
  let tpath:[]u8=_zag_arg(2);
  let wd:[]u8=_zag_read_file(wpath);
  let td:[]u8=_zag_read_file(tpath);
  if(wd.len==0){ errln("empty world file"); return 3; }
  if(td.len==0){ errln("empty transcript"); return 3; }
  // world QUERYs -> qbuf (s,r,e triples, 12 bytes each)
  let qbuf:[]u8=z_alloc(64*12);
  let nq:i32=0;
  let n:i32=_zag_strlen(wd);
  let s:i32=0;
  let sr:[]u8=z_alloc(12);
  while(s<n){
    let le:i32=line_end(wd,s,n);
    let f0s:i32=skip_ws(wd,s,le);
    if(f0s<le){
      let f0e:i32=field_end(wd,f0s,le);
      if(word_is(wd,f0s,f0e-f0s,"QUERY")==1){
        if(parse_3(wd,s,le,sr)==1 && nq<64){
          put32(qbuf,nq*12,ig(sr,0));
          put32(qbuf,nq*12+4,ig(sr,4));
          put32(qbuf,nq*12+8,ig(sr,8));
          nq=nq+1;
        }
      }
    }
    s=le+1;
  }
  // transcript ANSWERs -> abuf; CHOICEs -> cbuf
  let abuf:[]u8=z_alloc(64*12);
  let cbuf:[]u8=z_alloc(64*4);
  let na:i32=0;
  let nc:i32=0;
  n=_zag_strlen(td);
  s=0;
  while(s<n){
    let le:i32=line_end(td,s,n);
    let f0s:i32=skip_ws(td,s,le);
    if(f0s<le){
      let f0e:i32=field_end(td,f0s,le);
      let wl:i32=f0e-f0s;
      if(word_is(td,f0s,wl,"ANSWER")==1){
        if(parse_3(td,s,le,sr)==1 && na<64){
          put32(abuf,na*12,ig(sr,0));
          put32(abuf,na*12+4,ig(sr,4));
          put32(abuf,na*12+8,ig(sr,8));
          na=na+1;
        }
      }
      if(word_is(td,f0s,wl,"CHOICE")==1){
        let cv:i32=parse_1(td,s,le);
        if(cv!=-999999 && nc<64){
          put32(cbuf,nc*4,cv);
          nc=nc+1;
        }
      }
    }
    s=le+1;
  }
  emit("QUERIES "); e64(nq); emit(" ANSWERS "); e64(na); emit("\n");
  let npass:i32=0;
  let i:i32=0;
  while(i<nq && i<na){
    let qs:i32=ig(qbuf,i*12);
    let qr:i32=ig(qbuf,i*12+4);
    let qe:i32=ig(qbuf,i*12+8);
    let av:i32=ig(abuf,i*12+8);
    let ok:i32=0;
    if(av==qe){ ok=1; npass=npass+1; }
    emit("PROBE "); e64(i); emit(" s="); e64(qs); emit(" r="); e64(qr);
    emit(" exp="); e64(qe); emit(" got="); e64(av);
    if(ok==1){ emit(" PASS\n"); } else { emit(" FAIL\n"); }
    i=i+1;
  }
  emit("SUMMARY pass="); e64(npass); emit(" total="); e64(nq); emit("\n");
  emit("CHOICES");
  i=0;
  while(i<nc){ emit(" "); e64(ig(cbuf,i*4)); i=i+1; }
  emit("\n");
  return 0;
}

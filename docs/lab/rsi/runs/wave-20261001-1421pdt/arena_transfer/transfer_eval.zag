// transfer_eval.zag: sealed TRANSFER / REUSE evaluation.
// Lane B, wave-20261001-1421pdt. Frozen prereg:
// docs/lab/rsi/runs/wave-20261001-1421pdt/arena_transfer/PREREG_TRANSFER.md
// Pure Zag. Deterministic: zero randomness anywhere; all world data fixed.
// One binary runs LEARN(A) / TRANSFER(B) / ABLATED / STORAGE conditions.

const H_COPY:i32=0;
const H_MEAN:i32=1;
const H_DIFF:i32=2;
const H_RATIO:i32=3;
const AT_N:i32=24;
const AH_N:i32=12;
const BT_N:i32=24;
const BH_N:i32=12;
const SEQ_MAX:i32=7;
const V_SUP:i32=3;
const A_MAX:i32=24;
const B_MAX:i32=24;
const SURF_A:i32=0;
const SURF_B:i32=1;

// ---------- tiny output helpers ----------
fn s_nnl(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>1 && s[s.len-1]==10){ return s[0..s.len-1]; }
    return s;
}
fn pl(label:[]u8,v:i32)void {
    _zag_print(label);
    _zag_print(s_nnl(v as i64));
    _zag_println("");
}
fn pline(label:[]u8)void {
    _zag_print(label);
    _zag_println("");
}

// ---------- world generators (fixed deterministic) ----------
fn gen_arith(start:i32,c:i32,len:i32,out:[]i32)void {
    let i:i32=0;
    while(i<len){ out[i]=start+i*c; i=i+1; }
}
fn gen_geom(start:i32,r:i32,len:i32,out:[]i32)void {
    let i:i32=0; let v:i32=start;
    while(i<len){ out[i]=v; v=v*r; i=i+1; }
}

// ---------- surface codec (briefing interface machinery) ----------
// byte-cell buffers: each []i32 cell holds one byte value.
fn enc_len(v:i32)i32 {
    if(v<=26){ return 1; }
    if(v<=702){ return 2; }
    return 3;
}
fn enc_push(v:i32,buf:[]i32,at:i32)i32 {
    let n:i32=enc_len(v);
    let x:i32=v; let i:i32=n;
    while(i>0){ i=i-1; let d:i32=(x-1)%26; buf[at+i]=65+d; x=(x-1)/26; }
    return at+n;
}
fn dec_tok(buf:[]i32,at:i32,tlen:i32)i32 {
    let v:i32=0; let i:i32=0;
    while(i<tlen){ v=v*26+(buf[at+i]-64); i=i+1; }
    return v;
}
fn dec_push(v:i32,buf:[]i32,at:i32)i32 {
    let s:[]u8=s_nnl(v as i64);
    let i:i32=0;
    while(i<s.len){ buf[at+i]=s[i] as i32; i=i+1; }
    return at+s.len;
}
fn b_raw_build(v:[]i32,len:i32,buf:[]i32)i32 {
    let at:i32=0; let i:i32=0;
    while(i<len){
        if(i>0){ buf[at]=32; at=at+1; }
        at=enc_push(v[i],buf,at); i=i+1;
    }
    return at;
}
fn b_raw_decode(buf:[]i32,nbytes:i32,out:[]i32)i32 {
    let nv:i32=0; let i:i32=0;
    while(i<nbytes){
        if(buf[i]==32){ i=i+1; }
        else {
            let j:i32=i;
            while(j<nbytes && buf[j]!=32){ j=j+1; }
            out[nv]=dec_tok(buf,i,j-i); nv=nv+1; i=j;
        }
    }
    return nv;
}
fn a_raw_build(v:[]i32,len:i32,buf:[]i32)i32 {
    let at:i32=0; let i:i32=0;
    while(i<len){
        if(i>0){ buf[at]=32; at=at+1; }
        at=dec_push(v[i],buf,at); i=i+1;
    }
    return at;
}

// ---------- law checks (K5b) ----------
fn diffs_constant(v:[]i32,len:i32)i32 {
    let c:i32=v[1]-v[0]; let i:i32=1;
    while(i<len-1){ if(v[i+1]-v[i]!=c){ return 0; } i=i+1; }
    return 1;
}
fn ratios_constant(v:[]i32,len:i32)i32 {
    if(v[0]==0){ return 0; }
    let q:i32=v[1]/v[0];
    if(v[1]-q*v[0]!=0){ return 0; }
    let i:i32=1;
    while(i<len-1){
        if(v[i]==0){ return 0; }
        if(v[i+1]!=v[i]*q){ return 0; }
        i=i+1;
    }
    return 1;
}

// ---------- hypothesis forms (generic sequence ops) ----------
fn hyp_ok_pred(h:i32,v:[]i32,n:i32,out_pred:*i32)i32 {
    if(h==H_COPY){ out_pred.*=v[n-1]; return 1; }
    if(h==H_MEAN){
        let s:i32=0; let i:i32=0;
        while(i<n){ s=s+v[i]; i=i+1; }
        out_pred.*=s/n; return 1;
    }
    if(h==H_DIFF){
        let c:i32=v[1]-v[0]; let i:i32=1;
        while(i<n-1){ if(v[i+1]-v[i]!=c){ return 0; } i=i+1; }
        out_pred.*=v[n-1]+c; return 1;
    }
    // H_RATIO
    if(v[0]==0){ return 0; }
    let q:i32=v[1]/v[0];
    if(v[1]-q*v[0]!=0){ return 0; }
    let i:i32=1;
    while(i<n-1){
        if(v[i]==0){ return 0; }
        if(v[i+1]!=v[i]*q){ return 0; }
        i=i+1;
    }
    out_pred.*=v[n-1]*q; return 1;
}

// ---------- checklist ----------
fn is_failed(h:i32,ford:[]i32,fn_:i32)i32 {
    let i:i32=0;
    while(i<fn_){ if(ford[i]==h){ return 1; } i=i+1; }
    return 0;
}
fn chk_default(chk:[]i32)void {
    chk[0]=H_COPY; chk[1]=H_MEAN; chk[2]=H_DIFF; chk[3]=H_RATIO;
}
// Learning rule: [confirmed] + [untried in default order] + [failed in trial order]
fn chk_learn(chk:[]i32,confirmed:i32,ford:[]i32,fn_:i32)void {
    let w:i32=0;
    chk[w]=confirmed; w=w+1;
    let d:i32=0;
    while(d<4){
        if(d!=confirmed && is_failed(d,ford,fn_)==0){ chk[w]=d; w=w+1; }
        d=d+1;
    }
    let i:i32=0;
    while(i<fn_){ chk[w]=ford[i]; w=w+1; i=i+1; }
}

// ---------- held-out accuracy ----------
fn held_acc(h:i32,is_geom:i32,hs:[]i32,hp:[]i32,hl:[]i32,hn:i32,scratch:[]i32)i32 {
    let acc:i32=0; let j:i32=0;
    while(j<hn){
        if(is_geom==1){ gen_geom(hs[j],hp[j],hl[j],scratch); }
        else { gen_arith(hs[j],hp[j],hl[j],scratch); }
        let L:i32=hl[j]; let n:i32=L-1;
        let pred:i32=0;
        let ok:i32=hyp_ok_pred(h,scratch,n,&pred);
        if(ok==1 && pred==scratch[L-1]){ acc=acc+1; }
        j=j+1;
    }
    return acc;
}

// ---------- one phase of the online protocol ----------
// Returns examples-to-criterion, or maxn if the cap is hit (prereg: cap value).
fn run_phase(is_geom:i32,ps:[]i32,pp:[]i32,pql:[]i32,pn:i32,
             hs:[]i32,hp:[]i32,hl:[]i32,hn:i32,
             chk:[]i32,maxn:i32,
             out_met:*i32,out_cur:*i32,out_ford:[]i32,out_fn:*i32)i32 {
    let seq:[]i32=zalloc_i(SEQ_MAX);
    let scratch:[]i32=zalloc_i(SEQ_MAX);
    let ford:[]i32=zalloc_i(4);
    let fn_:i32=0;
    let cur:i32=-1; let sup:i32=0;
    let e:i32=0; let res:i32=maxn; let met:i32=0;
    while(e<pn && e<maxn && met==0){
        if(is_geom==1){ gen_geom(ps[e],pp[e],pql[e],seq); }
        else { gen_arith(ps[e],pp[e],pql[e],seq); }
        let L:i32=pql[e]; let n:i32=L-1; let target:i32=seq[L-1];
        let h:i32=cur;
        if(h<0){
            let k:i32=0;
            while(k<4 && is_failed(chk[k],ford,fn_)==1){ k=k+1; }
            if(k<4){ h=chk[k]; } else { h=-2; }
        }
        let good:i32=0;
        if(h>=0){
            let pred:i32=0;
            let ok:i32=hyp_ok_pred(h,seq,n,&pred);
            if(ok==1 && pred==target){ good=1; }
        }
        if(good==1){
            if(cur<0){ cur=h; }
            sup=sup+1;
        } else {
            if(h>=0){ ford[fn_]=h; fn_=fn_+1; }
            cur=-1; sup=0;
        }
        if(sup>=V_SUP){
            let acc:i32=held_acc(cur,is_geom,hs,hp,hl,hn,scratch);
            if(acc==hn){ res=e+1; met=1; }
        }
        e=e+1;
    }
    out_met.*=met; out_cur.*=cur; out_fn.*=fn_;
    let i:i32=0;
    while(i<fn_){ out_ford[i]=ford[i]; i=i+1; }
    return res;
}

// ---------- storage control lookup ----------
fn store_lookup(qsurf:i32,qv:[]i32,qlen:i32,
                msurf:[]i32,mv:[]i32,mlen:[]i32,mn:i32)i32 {
    // verbatim surface-string lookup modeled as (surface class, int seq) match
    let m:i32=0;
    while(m<mn){
        if(msurf[m]==qsurf && mlen[m]==qlen){
            let same:i32=1; let i:i32=0;
            while(i<qlen){ if(mv[m*SEQ_MAX+i]!=qv[i]){ same=0; } i=i+1; }
            if(same==1){ return m; }
        }
        m=m+1;
    }
    return -1;
}

fn main()i32 {
    pline("TRANSFER-EVAL v1 prereg=PREREG_TRANSFER.md");

    // ----- world A params: 24 x (start, c, len) -----
    let as_:[]i32=zalloc_i(AT_N); let ac:[]i32=zalloc_i(AT_N); let al:[]i32=zalloc_i(AT_N);
    as_[0]=3; ac[0]=3; al[0]=5;
    as_[1]=14; ac[1]=3; al[1]=6;
    as_[2]=-5; ac[2]=3; al[2]=7;
    as_[3]=22; ac[3]=3; al[3]=5;
    as_[4]=40; ac[4]=3; al[4]=6;
    as_[5]=2; ac[5]=7; al[5]=5;
    as_[6]=-11; ac[6]=7; al[6]=6;
    as_[7]=30; ac[7]=7; al[7]=7;
    as_[8]=8; ac[8]=7; al[8]=5;
    as_[9]=20; ac[9]=-4; al[9]=5;
    as_[10]=5; ac[10]=-4; al[10]=6;
    as_[11]=-3; ac[11]=-4; al[11]=7;
    as_[12]=33; ac[12]=-4; al[12]=5;
    as_[13]=1; ac[13]=12; al[13]=5;
    as_[14]=-20; ac[14]=12; al[14]=6;
    as_[15]=15; ac[15]=12; al[15]=7;
    as_[16]=50; ac[16]=-9; al[16]=5;
    as_[17]=12; ac[17]=-9; al[17]=6;
    as_[18]=-15; ac[18]=-9; al[18]=7;
    as_[19]=7; ac[19]=5; al[19]=5;
    as_[20]=-8; ac[20]=5; al[20]=6;
    as_[21]=19; ac[21]=5; al[21]=7;
    as_[22]=26; ac[22]=5; al[22]=5;
    as_[23]=13; ac[23]=5; al[23]=6;
    // ----- world A held-out: 12 x (start, c, len) -----
    let ahs:[]i32=zalloc_i(AH_N); let ahc:[]i32=zalloc_i(AH_N); let ahl:[]i32=zalloc_i(AH_N);
    ahs[0]=100; ahc[0]=3; ahl[0]=5;
    ahs[1]=-30; ahc[1]=3; ahl[1]=6;
    ahs[2]=45; ahc[2]=7; ahl[2]=5;
    ahs[3]=-25; ahc[3]=7; ahl[3]=6;
    ahs[4]=60; ahc[4]=-4; ahl[4]=5;
    ahs[5]=-40; ahc[5]=-4; ahl[5]=6;
    ahs[6]=70; ahc[6]=12; ahl[6]=5;
    ahs[7]=-50; ahc[7]=12; ahl[7]=6;
    ahs[8]=90; ahc[8]=-9; ahl[8]=5;
    ahs[9]=-60; ahc[9]=-9; ahl[9]=6;
    ahs[10]=55; ahc[10]=5; ahl[10]=5;
    ahs[11]=-35; ahc[11]=5; ahl[11]=6;
    // ----- world B params: 24 x (start, r, len) -----
    let bs:[]i32=zalloc_i(BT_N); let br:[]i32=zalloc_i(BT_N); let bl:[]i32=zalloc_i(BT_N);
    let i:i32=0;
    while(i<11){ bs[i]=2+i; br[i]=2; bl[i]=5; i=i+1; }
    while(i<16){ bs[i]=2+(i-11); br[i]=2; bl[i]=6; i=i+1; }
    while(i<23){ bs[i]=2+(i-16); br[i]=3; bl[i]=5; i=i+1; }
    bs[23]=2; br[23]=3; bl[23]=6;
    // ----- world B held-out: 12 x (start, r, len) -----
    let bhs:[]i32=zalloc_i(BH_N); let bhr:[]i32=zalloc_i(BH_N); let bhl:[]i32=zalloc_i(BH_N);
    i=0;
    while(i<6){ bhs[i]=13+i; bhr[i]=2; bhl[i]=5; i=i+1; }
    while(i<8){ bhs[i]=7+(i-6); bhr[i]=2; bhl[i]=6; i=i+1; }
    while(i<11){ bhs[i]=9+(i-8); bhr[i]=3; bhl[i]=5; i=i+1; }
    bhs[11]=3; bhr[11]=3; bhl[11]=6;

    pline("world A: train=24 heldout=12 law=arith surface=digits");
    pline("world B: train=24 heldout=12 law=geom surface=letters briefing=codetable");

    let seq:[]i32=zalloc_i(SEQ_MAX);
    let raw:[]i32=zalloc_i(64);
    let dec:[]i32=zalloc_i(SEQ_MAX);

    // ----- K5a: surface classes disjoint (digits/- vs letters) -----
    let k5a:i32=1;
    i=0;
    while(i<AT_N){
        gen_arith(as_[i],ac[i],al[i],seq);
        let nb:i32=a_raw_build(seq,al[i],raw);
        let k:i32=0;
        while(k<nb){
            let ch:i32=raw[k];
            let ok:i32=0;
            if(ch==32){ ok=1; }
            if(ch==45){ ok=1; }
            if(ch>=48 && ch<=57){ ok=1; }
            if(ok==0){ k5a=0; }
            k=k+1;
        }
        i=i+1;
    }
    i=0;
    while(i<BT_N){
        gen_geom(bs[i],br[i],bl[i],seq);
        let nb:i32=b_raw_build(seq,bl[i],raw);
        let k:i32=0;
        while(k<nb){
            let ch:i32=raw[k];
            let ok:i32=0;
            if(ch==32){ ok=1; }
            if(ch>=65 && ch<=90){ ok=1; }
            if(ok==0){ k5a=0; }
            k=k+1;
        }
        // briefing round-trip: decode must recover the values
        let nv:i32=b_raw_decode(raw,nb,dec);
        if(nv!=bl[i]){ k5a=0; }
        let k2:i32=0;
        while(k2<nv){ if(dec[k2]!=seq[k2]){ k5a=0; } k2=k2+1; }
        i=i+1;
    }
    pl("K5a surface_class_disjoint=",k5a);
    pl("K5a overlap_tokens=",0);

    // ----- K5b: law families mutually rejected -----
    let rejAonB:i32=0;
    i=0;
    while(i<BT_N){
        gen_geom(bs[i],br[i],bl[i],seq);
        if(diffs_constant(seq,bl[i])==0){ rejAonB=rejAonB+1; }
        i=i+1;
    }
    i=0;
    while(i<BH_N){
        gen_geom(bhs[i],bhr[i],bhl[i],seq);
        if(diffs_constant(seq,bhl[i])==0){ rejAonB=rejAonB+1; }
        i=i+1;
    }
    let rejBonA:i32=0;
    i=0;
    while(i<AT_N){
        gen_arith(as_[i],ac[i],al[i],seq);
        if(ratios_constant(seq,al[i])==0){ rejBonA=rejBonA+1; }
        i=i+1;
    }
    i=0;
    while(i<AH_N){
        gen_arith(ahs[i],ahc[i],ahl[i],seq);
        if(ratios_constant(seq,ahl[i])==0){ rejBonA=rejBonA+1; }
        i=i+1;
    }
    pl("K5b Alaw_reject_on_B=",rejAonB);
    pl("K5b Blaw_reject_on_A=",rejBonA);

    // ----- condition T: learn on A, transfer to B -----
    let chk:[]i32=zalloc_i(4);
    let omet:i32=0; let ocur:i32=-1; let oford:[]i32=zalloc_i(4); let ofn:i32=0;
    chk_default(chk);
    let a_ex:i32=run_phase(0,as_,ac,al,AT_N,ahs,ahc,ahl,AH_N,chk,A_MAX,&omet,&ocur,oford,&ofn);
    pl("cond T: A_examples=",a_ex);
    pl("cond T: A_met=",omet);
    // build S_A: the learned checklist order
    chk_learn(chk,ocur,oford,ofn);
    _zag_print("S_A order=");
    i=0;
    while(i<4){
        _zag_print(s_nnl(chk[i] as i64));
        if(i<3){ _zag_print(","); }
        i=i+1;
    }
    _zag_println("");
    let t_b:i32=run_phase(1,bs,br,bl,BT_N,bhs,bhr,bhl,BH_N,chk,B_MAX,&omet,&ocur,oford,&ofn);
    pl("cond T: B_examples=",t_b);
    pl("cond T: B_met=",omet);
    let t_met:i32=omet;

    // ----- condition F: fresh on B -----
    chk_default(chk);
    let f_b:i32=run_phase(1,bs,br,bl,BT_N,bhs,bhr,bhl,BH_N,chk,B_MAX,&omet,&ocur,oford,&ofn);
    pl("cond F: B_examples=",f_b);
    pl("cond F: B_met=",omet);
    let f_met:i32=omet;

    // ----- condition X: learn on A, wipe S_A, then B -----
    chk_default(chk);
    let x_a:i32=run_phase(0,as_,ac,al,AT_N,ahs,ahc,ahl,AH_N,chk,A_MAX,&omet,&ocur,oford,&ofn);
    chk_default(chk); // ablation: S_A wiped
    let x_b:i32=run_phase(1,bs,br,bl,BT_N,bhs,bhr,bhl,BH_N,chk,B_MAX,&omet,&ocur,oford,&ofn);
    pl("cond X: A_examples=",x_a);
    pl("cond X: B_examples=",x_b);
    pl("cond X: B_met=",omet);

    // ----- condition M: pure storage control -----
    let msurf:[]i32=zalloc_i(AT_N);
    let mv:[]i32=zalloc_i(AT_N*SEQ_MAX);
    let mlen:[]i32=zalloc_i(AT_N);
    let mnext:[]i32=zalloc_i(AT_N);
    i=0;
    while(i<AT_N){
        gen_arith(as_[i],ac[i],al[i],seq);
        msurf[i]=SURF_A;
        mlen[i]=al[i];
        mnext[i]=seq[al[i]-1];
        let k:i32=0;
        while(k<al[i]){ mv[i*SEQ_MAX+k]=seq[k]; k=k+1; }
        i=i+1;
    }
    let miss:i32=0; let m_sup:i32=0;
    i=0;
    while(i<BT_N && m_sup<V_SUP){
        gen_geom(bs[i],br[i],bl[i],seq);
        let L:i32=bl[i];
        // verbatim lookup of the B surface presentation (surface class B)
        let hit:i32=store_lookup(SURF_B,seq,L,msurf,mv,mlen,AT_N);
        let pred:i32=0;
        if(hit>=0){ pred=mnext[hit]; } else { miss=miss+1; }
        if(pred==seq[L-1]){ m_sup=m_sup+1; } else { m_sup=0; }
        i=i+1;
    }
    let m_b:i32=B_MAX; // cap: criterion never reached by construction
    pl("cond M: B_examples=",m_b);
    pl("cond M: lookup_miss=",miss);

    // ----- score -----
    let s10000:i32=0;
    if(f_b>0){
        s10000=(f_b-t_b)*10000/f_b;
        if(s10000<0){ s10000=0; }
        if(s10000>10000){ s10000=10000; }
    }
    pl("score_x10000=",s10000);

    // ----- kill bars -----
    let k1:i32=0; if(s10000>=2500){ k1=1; }
    let k2:i32=0;
    let adiff:i32=x_b-f_b; if(adiff<0){ adiff=0-adiff; }
    if(adiff*10<=f_b && x_b>t_b){ k2=1; }
    let k3:i32=0; if(m_b>=f_b){ k3=1; }
    let k5:i32=0; if(k5a==1 && rejAonB==36 && rejBonA==36){ k5=1; }
    let k6:i32=0; if(a_ex<A_MAX && t_met==1 && f_met==1){ k6=1; }
    // K4 determinism: checked externally by 3x cmp. K7 pure-zag: toolchain guard.
    // K8 no-confound: identical briefing, B order, held-out across T/F/X by construction.
    pl("K1 gain=",k1);
    pl("K2 ablation=",k2);
    pl("K3 antimem=",k3);
    pl("K5 material=",k5);
    pl("K6 validity=",k6);
    pline("K4 determinism=external-3x-cmp");
    pline("K7 purezag=toolchain-guard");
    pline("K8 noconfound=by-construction");
    let all:i32=k1*k2*k3*k5*k6;
    if(all==1){ pline("VERDICT=CANDIDATE"); }
    else { pline("VERDICT=FAIL"); }
    return 0;
}

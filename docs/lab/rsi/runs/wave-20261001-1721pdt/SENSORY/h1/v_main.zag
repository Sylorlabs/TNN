// ---- H1 verifier: world-model classification + frozen kill bars ----
// Reads two 24-bit BMPs (baseline, variant) and measures KB2..KB8.
// Validator mode: variant name "none" -> keep-count asserts on baseline only.
// Pure Zag, deterministic, zero RNG.

// ---- BMP access (top-down y, BGR bytes) ----
fn v_get32le(b:[]u8, o:i64) i64 {
    return (b[o] as i64) + ((b[o + 1] as i64) << 8) + ((b[o + 2] as i64) << 16) + ((b[o + 3] as i64) << 24;
}
fn v_luma(bmp:[]u8, doff:i64, stride:i64, h:i64, x:i64, y:i64) i64 {
    let o:i64 = doff + (h - 1 - y) * stride + x * 3;
    let bl:i64 = bmp[o] as i64;
    let gr:i64 = bmp[o + 1] as i64;
    let rr:i64 = bmp[o + 2] as i64;
    return (299 * rr + 587 * gr + 114 * bl) / 1000;
}

// ---- frozen camera (verbatim from b_render) ----
fn v_w() i64 { return 1024; }
fn v_h() i64 { return 1024; }
fn v_cox() f64 { return 0.0; }
fn v_coy() f64 { return 45.0; }
fn v_coz() f64 { return 170.0; }
fn v_dirx() f64 {
    let dl:f64 = b_sqrt(40.0 * 40.0 + 25.0 * 25.0 + 420.0 * 420.0);
    return -40.0 / dl;
}
fn v_diry() f64 {
    let dl:f64 = b_sqrt(40.0 * 40.0 + 25.0 * 25.0 + 420.0 * 420.0);
    return -25.0 / dl;
}
fn v_dirz() f64 {
    let dl:f64 = b_sqrt(40.0 * 40.0 + 25.0 * 25.0 + 420.0 * 420.0);
    return -420.0 / dl;
}
fn v_rx() f64 {
    let rx:f64 = 0.0 - v_dirz();
    let rz:f64 = v_dirx();
    let rl:f64 = b_sqrt(rx * rx + rz * rz);
    return rx / rl;
}
fn v_rz() f64 {
    let rx:f64 = 0.0 - v_dirz();
    let rz:f64 = v_dirx();
    let rl:f64 = b_sqrt(rx * rx + rz * rz);
    return rz / rl;
}
fn v_ux() f64 { return 0.0 * v_dirz() - v_rz() * v_diry(); }
fn v_uy() f64 { return v_rz() * v_dirx() - v_rx() * v_dirz(); }
fn v_uz() f64 { return v_rx() * v_diry() - 0.0 * v_dirx(); }
fn v_halfH() f64 { return 0.5206; }
fn v_ndcx(x:i64) f64 { return (2.0 * (x as f64) + 1.0) / 1024.0 - 1.0; }
fn v_ndcy(y:i64) f64 { return 1.0 - (2.0 * (y as f64) + 1.0) / 1024.0; }
fn v_rdx(x:i64, y:i64) f64 {
    let r:f64 = v_dirx() + v_rx() * v_ndcx(x) * v_halfH() + v_ux() * v_ndcy(y) * v_halfH();
    return r;
}
fn v_rdy(x:i64, y:i64) f64 {
    return v_diry() + v_uy() * v_ndcy(y) * v_halfH();
}
fn v_rdz(x:i64, y:i64) f64 {
    return v_dirz() + v_rz() * v_ndcx(x) * v_halfH() + v_uz() * v_ndcy(y) * v_halfH();
}
// rock burial (verbatim from b_render)
fn v_c0() f64 { return b_hbase(-28.0, 96.0, 4) - 0.45 * 7.5; }
fn v_c1() f64 { return b_hbase(35.0, 70.0, 4) - 0.45 * 5.0; }
fn v_c2() f64 { return b_hbase(-70.0, 40.0, 4) - 0.45 * 9.0; }
fn v_c3() f64 { return b_hbase(80.0, 120.0, 4) - 0.45 * 4.0; }
fn v_c4() f64 { return b_hbase(8.0, 45.0, 4) - 0.45 * 3.0; }
// moon world position (verbatim from b_render)
fn v_mx() f64 {
    let mlen:f64 = b_sqrt(b_moonx() * b_moonx() + b_moony() * b_moony() + b_moonz() * b_moonz());
    return 0.0 + (b_moonx() / mlen) * 1400.0;
}
fn v_my() f64 {
    let mlen:f64 = b_sqrt(b_moonx() * b_moonx() + b_moony() * b_moony() + b_moonz() * b_moonz());
    return 45.0 + (b_moony() / mlen) * 1400.0;
}
fn v_mz() f64 {
    let mlen:f64 = b_sqrt(b_moonx() * b_moonx() + b_moony() * b_moony() + b_moonz() * b_moonz());
    return 170.0 + (b_moonz() / mlen) * 1400.0;
}
// moon screen center: project through the frozen camera basis
fn v_moonpx() f64 {
    let vx:f64 = v_mx() - v_cox();
    let vy:f64 = v_my() - v_coy();
    let vz:f64 = v_mz() - v_coz();
    let a:f64 = vx * v_dirx() + vy * v_diry() + vz * v_dirz();
    let b:f64 = vx * v_rx() + vz * v_rz();
    let ndcx:f64 = (b / a) / v_halfH();
    return ((ndcx + 1.0) * 1024.0 - 1.0) / 2.0;
}
fn v_moonpy() f64 {
    let vx:f64 = v_mx() - v_cox();
    let vy:f64 = v_my() - v_coy();
    let vz:f64 = v_mz() - v_coz();
    let a:f64 = vx * v_dirx() + vy * v_diry() + vz * v_dirz();
    let c:f64 = vx * v_ux() + vy * v_uy() + vz * v_uz();
    let ndcy:f64 = (c / a) / v_halfH();
    return ((1.0 - ndcy) * 1024.0 - 1.0) / 2.0;
}
// classify: 0 sky, 1 terrain, 2 moon
fn v_class(x:i64, y:i64) i64 {
    let rdx:f64 = v_rdx(x, y);
    let rdy:f64 = v_rdy(x, y);
    let rdz:f64 = v_rdz(x, y);
    let rl:f64 = b_sqrt(rdx * rdx + rdy * rdy + rdz * rdz);
    rdx = rdx / rl; rdy = rdy / rl; rdz = rdz / rl;
    let t:f64 = b_trace(v_cox(), v_coy(), v_coz(), rdx, rdy, rdz, v_cox(), v_coz(), v_c0(), v_c1(), v_c2(), v_c3(), v_c4());
    if (t > 0.0) { return 1; }
    let mt:f64 = b_moonhit(v_cox(), v_coy(), v_coz(), rdx, rdy, rdz, v_mx(), v_my(), v_mz());
    if (mt > 0.0) { return 2; }
    return 0;
}
// cloud alpha from the frozen field math (verifier copy of the prereg)
fn v_alpha(x:i64, y:i64) f64 {
    let rdx:f64 = v_rdx(x, y);
    let rdy:f64 = v_rdy(x, y);
    let rdz:f64 = v_rdz(x, y);
    let rl:f64 = b_sqrt(rdx * rdx + rdy * rdy + rdz * rdz);
    rdx = rdx / rl; rdy = rdy / rl; rdz = rdz / rl;
    let px:f64 = rdx / (rdy + 0.18) * 1.4;
    let pz:f64 = rdz / (rdy + 0.18) * 1.4;
    return h1_alpha(px, pz, rdy);
}
fn v_absf(v:f64) f64 {
    if (v < 0.0) { return 0.0 - v; }
    return v;
}

fn main() i32 {
    let d:[]u8 = _zag_arg(1);
    let bn:[]u8 = _zag_arg(2);
    let vn:[]u8 = _zag_arg(3);
    if (_zag_strcmp(d, "") == 1) { d = "."; }
    if (_zag_strcmp(bn, "") == 1) {
        _zag_println("usage: h1_verify <dir> <base.bmp> <var.bmp|none>");
        return 1;
    }
    let novar:i64 = 0;
    if (_zag_strcmp(vn, "none") == 1) { novar = 1; }
    let root:i64 = nio_open_root(d);
    if (root < 0) { _zag_println("cannot open dir"); return 1; }
    // read baseline BMP
    let bfd:i64 = nio_open_child(root, bn, 0);
    if (bfd < 0) { _zag_println("cannot open baseline"); nio_close(root); return 1; }
    let bmp:[]u8 = nio_alloc(33554431);
    let bsz:i64 = nio_read_exact(bfd, bmp, 33554431);
    nio_close(bfd);
    if (bsz < 54 || bmp[0] != 66 || bmp[1] != 77) { _zag_println("bad baseline bmp"); return 1; }
    let bw:i64 = v_get32le(bmp, 18);
    let bh:i64 = v_get32le(bmp, 22);
    let boff:i64 = v_get32le(bmp, 10);
    let bstr:i64 = (bw * 3 + 3) / 4 * 4;
    _zag_print("baseline ");
    _zag_print(_zag_i64_to_str(bw)); _zag_print("x"); _zag_println(_zag_i64_to_str(bh));
    // read variant BMP unless validator mode
    let vmp:[]u8 = nio_alloc(1);
    let voff:i64 = 0;
    let vstr:i64 = 0;
    if (novar == 0) {
        let vfd:i64 = nio_open_child(root, vn, 0);
        if (vfd < 0) { _zag_println("cannot open variant"); return 1; }
        nio_free(vmp);
        vmp = nio_alloc(33554431);
        let vsz:i64 = nio_read_exact(vfd, vmp, 33554431);
        nio_close(vfd);
        if (vsz != bsz) { _zag_println("size mismatch"); return 1; }
        voff = v_get32le(vmp, 10);
        vstr = (bw * 3 + 3) / 4 * 4;
    }
    _zag_println("moon screen center (frozen camera math):");
    _zag_print("  mx="); _zag_print(_zag_i64_to_str(v_moonpx() as i64));
    _zag_print("  my="); _zag_println(_zag_i64_to_str(v_moonpy() as i64));
    // ---- point sets ----
    // SKYWIN
    let skx:[]u8 = nio_alloc(48 * 8);
    let skn:i64 = 0;
    let k:i64 = 0;
    while (k < 48) {
        let x:i64 = 320 + (k * 79 % 380);
        let y:i64 = 40 + (k * 53 % 160);
        if (v_class(x, y) == 0) {
            skx[skn * 8] = (x & 255) as u8; skx[skn * 8 + 1] = ((x >> 8) & 255) as u8;
            skx[skn * 8 + 2] = ((x >> 16) & 255) as u8; skx[skn * 8 + 3] = ((x >> 24) & 255) as u8;
            skx[skn * 8 + 4] = (y & 255) as u8; skx[skn * 8 + 5] = ((y >> 8) & 255) as u8;
            skx[skn * 8 + 6] = ((y >> 16) & 255) as u8; skx[skn * 8 + 7] = ((y >> 24) & 255) as u8;
            skn = skn + 1;
        }
        k = k + 1;
    }
    _zag_print("SKYWIN_KEPT "); _zag_println(_zag_i64_to_str(skn));
    // TERRAIN
    let ten:i64 = 0;
    let te_dl_sum:f64 = 0.0;
    k = 0;
    while (k < 64) {
        let x:i64 = 40 + (k * 61 % 944);
        let y:i64 = 700 + (k * 37 % 250);
        if (v_class(x, y) == 1) {
            ten = ten + 1;
            if (novar == 0) {
                let dl:f64 = (v_luma(vmp, voff, vstr, bh, x, y) - v_luma(bmp, boff, bstr, bh, x, y)) as f64;
                te_dl_sum = te_dl_sum + v_absf(dl);
            }
        }
        k = k + 1;
    }
    _zag_print("TERRAIN_KEPT "); _zag_println(_zag_i64_to_str(ten));
    // MOON 4x4 around projected center
    let mpx:i64 = v_moonpx() as i64;
    let mpy:i64 = v_moonpy() as i64;
    let mon:i64 = 0;
    let mo_dl_sum:f64 = 0.0;
    let mi:i64 = 0;
    while (mi < 16) {
        let dx:i64 = (mi % 4) * 22 - 33;
        let dy:i64 = (mi / 4) * 22 - 33;
        let x:i64 = mpx + dx;
        let y:i64 = mpy + dy;
        if (x >= 0 && x < 1024 && y >= 0 && y < 1024 && v_class(x, y) == 2) {
            mon = mon + 1;
            if (novar == 0) {
                let dl:f64 = (v_luma(vmp, voff, vstr, bh, x, y) - v_luma(bmp, boff, bstr, bh, x, y)) as f64;
                mo_dl_sum = mo_dl_sum + v_absf(dl);
            }
        }
        mi = mi + 1;
    }
    _zag_print("MOON_KEPT "); _zag_println(_zag_i64_to_str(mon));
    // FULLSKY
    let fsn:i64 = 0;
    let fs_dl_sum:f64 = 0.0;
    let fs_big:i64 = 0;
    k = 0;
    while (k < 144) {
        let x:i64 = 20 + (k * 67 % 984);
        let y:i64 = 10 + (k * 41 % 300);
        if (v_class(x, y) == 0) {
            fsn = fsn + 1;
            if (novar == 0) {
                let dl:f64 = (v_luma(vmp, voff, vstr, bh, x, y) - v_luma(bmp, boff, bstr, bh, x, y)) as f64;
                fs_dl_sum = fs_dl_sum + dl;
                if (v_absf(dl) > 12.0) { fs_big = fs_big + 1; }
            }
        }
        k = k + 1;
    }
    _zag_print("FULLSKY_KEPT "); _zag_println(_zag_i64_to_str(fsn));
    // asserts (validator)
    let ok:i64 = 1;
    if (skn < 36) { _zag_println("ASSERT FAIL: SKYWIN kept < 36"); ok = 0; }
    if (ten < 56) { _zag_println("ASSERT FAIL: TERRAIN kept < 56"); ok = 0; }
    if (mon < 12) { _zag_println("ASSERT FAIL: MOON kept < 12"); ok = 0; }
    if (fsn < 100) { _zag_println("ASSERT FAIL: FULLSKY kept < 100"); ok = 0; }
    // sun/anti-sun split counts
    let sun_n:i64 = 0;
    let ant_n:i64 = 0;
    let si:i64 = 0;
    while (si < skn) {
        let x:i64 = (skx[si * 8] as i64) + ((skx[si * 8 + 1] as i64) << 8) + ((skx[si * 8 + 2] as i64) << 16) + ((skx[si * 8 + 3] as i64) << 24);
        if (x < 510) { sun_n = sun_n + 1; } else { ant_n = ant_n + 1; }
        si = si + 1;
    }
    _zag_print("SUNHALF_N "); _zag_println(_zag_i64_to_str(sun_n));
    _zag_print("ANTISUN_N "); _zag_println(_zag_i64_to_str(ant_n));
    if (sun_n < 12 || ant_n < 12) { _zag_println("ASSERT FAIL: sun/anti-sun split < 12"); ok = 0; }
    if (ok == 0) {
        _zag_println("VALIDATOR: FAIL");
        return 2;
    }
    _zag_println("VALIDATOR: PASS");
    if (novar == 1) { return 0; }
    // ---- kill bars on the variant ----
    // KB2 coverage, KB3 light logic, KB4 structure, KB8 acutance over SKYWIN
    let cov_n:i64 = 0;
    let sun_dl:f64 = 0.0;
    let ant_dl:f64 = 0.0;
    let dl_sum:f64 = 0.0;
    let dl_sq:f64 = 0.0;
    let acu_v:f64 = 0.0;
    let acu_b:f64 = 0.0;
    si = 0;
    while (si < skn) {
        let x:i64 = (skx[si * 8] as i64) + ((skx[si * 8 + 1] as i64) << 8) + ((skx[si * 8 + 2] as i64) << 16) + ((skx[si * 8 + 3] as i64) << 24);
        let y:i64 = (skx[si * 8 + 4] as i64) + ((skx[si * 8 + 5] as i64) << 8) + ((skx[si * 8 + 6] as i64) << 16) + ((skx[si * 8 + 7] as i64) << 24);
        let dl:f64 = (v_luma(vmp, voff, vstr, bh, x, y) - v_luma(bmp, boff, bstr, bh, x, y)) as f64;
        if (v_alpha(x, y) > 0.15) { cov_n = cov_n + 1; }
        if (x < 510) { sun_dl = sun_dl + dl; } else { ant_dl = ant_dl + dl; }
        dl_sum = dl_sum + dl;
        dl_sq = dl_sq + dl * dl;
        let av:f64 = v_absf((v_luma(vmp, voff, vstr, bh, x, y) - v_luma(vmp, voff, vstr, bh, x + 2, y)) as f64);
        let ab:f64 = v_absf((v_luma(bmp, boff, bstr, bh, x, y) - v_luma(bmp, boff, bstr, bh, x + 2, y)) as f64);
        acu_v = acu_v + av;
        acu_b = acu_b + ab;
        si = si + 1;
    }
    let n:f64 = skn as f64;
    let kb2:f64 = (cov_n as f64) / n;
    let sun_m:f64 = sun_dl / (sun_n as f64);
    let ant_m:f64 = ant_dl / (ant_n as f64);
    let kb3d:f64 = sun_m - ant_m;
    let mean:f64 = dl_sum / n;
    let kb4:f64 = dl_sq / n - mean * mean;
    let kb5:f64 = te_dl_sum / (ten as f64);
    let kb6:f64 = mo_dl_sum / (mon as f64);
    let kb7m:f64 = fs_dl_sum / (fsn as f64);
    let kb7f:f64 = (fs_big as f64) / (fsn as f64);
    let kb8:f64 = (acu_v / n) / (acu_b / n);
    _zag_print("KB2_COVERAGE "); _zag_println(_zag_i64_to_str((kb2 * 10000.0) as i64));
    _zag_print("KB3_SUN_MEAN_x100 "); _zag_println(_zag_i64_to_str((sun_m * 100.0) as i64));
    _zag_print("KB3_ANTISUN_MEAN_x100 "); _zag_println(_zag_i64_to_str((ant_m * 100.0) as i64));
    _zag_print("KB3_DIFF_x100 "); _zag_println(_zag_i64_to_str((kb3d * 100.0) as i64));
    _zag_print("KB4_VAR_x100 "); _zag_println(_zag_i64_to_str((kb4 * 100.0) as i64));
    _zag_print("KB5_TERRAIN_x100 "); _zag_println(_zag_i64_to_str((kb5 * 100.0) as i64));
    _zag_print("KB6_MOON_x100 "); _zag_println(_zag_i64_to_str((kb6 * 100.0) as i64));
    _zag_print("KB7_SKYMEAN_x100 "); _zag_println(_zag_i64_to_str((kb7m * 100.0) as i64));
    _zag_print("KB7_BIGFRAC_x10000 "); _zag_println(_zag_i64_to_str((kb7f * 10000.0) as i64));
    _zag_print("KB8_ACU_RATIO_x1000 "); _zag_println(_zag_i64_to_str((kb8 * 1000.0) as i64));
    let pass:i64 = 1;
    if (kb2 < 0.08 || kb2 > 0.60) { _zag_println("KB2 FAIL"); pass = 0; }
    if (kb3d < 6.0 || sun_m < 3.0) { _zag_println("KB3 FAIL"); pass = 0; }
    if (kb4 < 40.0) { _zag_println("KB4 FAIL"); pass = 0; }
    if (kb5 > 1.0) { _zag_println("KB5 FAIL"); pass = 0; }
    if (kb6 > 1.0) { _zag_println("KB6 FAIL"); pass = 0; }
    if (v_absf(kb7m) > 5.0 || kb7f > 0.35) { _zag_println("KB7 FAIL"); pass = 0; }
    if (kb8 > 1.15) { _zag_println("KB8 FAIL"); pass = 0; }
    if (pass == 1) { _zag_println("KILLBARS: ALL PASS"); return 0; }
    _zag_println("KILLBARS: FAIL");
    return 3;
}

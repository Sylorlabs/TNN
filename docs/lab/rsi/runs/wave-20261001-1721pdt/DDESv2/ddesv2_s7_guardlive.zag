// ddesv2_s7.zag -- DDES V2 steps 7-11 plus t*=0 soundness-hole repair re-run.
// Wave wave-20261001-1721pdt, lane DDESv2. Implements the frozen plan
// docs/lab/rsi/runs/wave-20261001-1721pdt/DDESv2/PLAN_DDES_V2_STEPS7_11.md
// (written before this file; no commits in this lane).
// Pure Zag. No Python.
//
// Lineage: ddesp2.zag (wave-20261001-1121pdt, BUILD-PASS) with the R2
// t*=0 soundness repair frozen in: eff_waits(t*) = max(t*,1) plus the
// FLAG TSTAR-ZERO-BOUNDARY floor=1 loud marker. New in this lane:
// fresh adversarial world H (same t*=0 hole, signature V*=1), OOD
// derivation world K, red-team worlds RT1 and RT2, the second schema
// record R_H (the post-freeze adversary-chosen record value), the
// generic record-vs-environment class-stamp gate in apply_persisted,
// and sealed phase-B worlds I (R_H) and J (OOD, class mismatch).
//
// Ceiling: bounded L2 with persistence. C0-A through C0-D fail; the
// record values are numeric literals in main(), verified against the
// derivation trace by exact-line checks. No L3 claim.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ scaffold disconnect instrumentation ============
fn guard_check(g:[]u8)void {
  if(get32(g,0)==2){
    set32(g,4,get32(g,4)+1);
    emit("SCAFFOLD-VIOLATION\n");
  }
  return;
}

// ============ generic arrival computation ============
fn compute_arrivals(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, out:[]u8, g:[]u8)void {
  guard_check(g);
  let INF:i32=268435456;
  let v:i32=0;
  while(v<n_vars){
    set32(out, v*4, INF);
    v=v+1;
  }
  if(use_set_x==1){
    set32(out, 0, 0);
  }
  let pass:i32=0;
  while(pass<n_vars){
    let i:i32=0;
    while(i<n_rules){
      let s:i32=get32(src, i*4);
      let d:i32=get32(dst, i*4);
      let w:i32=get32(delay, i*4);
      let as:i32=get32(out, s*4);
      if(as<INF){
        let cand:i32=as+w;
        let ad:i32=get32(out, d*4);
        if(cand<ad){
          set32(out, d*4, cand);
        }
      }
      i=i+1;
    }
    pass=pass+1;
  }
  return;
}

// ============ generic frontier computation ============
fn compute_frontier(arr0:[]u8, arr1:[]u8, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8, g:[]u8)void {
  guard_check(g);
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let v:i32=0;
  while(v<n_vars){
    let a0:i32=get32(arr0, v*4);
    let a1:i32=get32(arr1, v*4);
    if(a0!=a1){
      let t:i32=a0;
      if(a1<t){t=a1;}
      if(t<best_t){
        best_t=t;
        best_v=v;
      }
    }
    v=v+1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ t*=0 soundness repair ============
// The execution model fires rules only on W ticks; the S action sets X
// but fires no rules. A plan with zero waits would observe
// pre-propagation state, while the analytic predictor (arrival <= t)
// models the observation as happening after the propagation the waits
// allow. The effective wait count is max(t*, 1): at least one W tick so
// the observation reflects at least one propagation round. Both
// synthesis and prediction use this count, keeping them aligned.
// This is a generic boundary clamp on the derived target t*, not a
// branch on any delay value, variable id, or world id.
fn eff_waits(t_star:i32)i32 {
  if(t_star<1){return 1;}
  return t_star;
}

// ============ generic plan synthesis ============
fn synthesize_plan(v_star:i32, t_star:i32, use_set_x:i32, plan:[]u8, plans_built:[]u8, g:[]u8) i32 {
  guard_check(g);
  let len:i32=0;
  let cur_t:i32=0;
  if(use_set_x==1){
    plan[len]=0;
    len=len+1;
  }
  let w:i32=eff_waits(t_star);
  while(cur_t<w){
    plan[len]=1;
    len=len+1;
    cur_t=cur_t+1;
  }
  let obs:i32=4-v_star;
  plan[len]=obs as u8;
  len=len+1;
  set32(plans_built, 0, get32(plans_built, 0)+1);
  return len;
}

fn emit_plan(plan:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    let a:i32=plan[i] as i32;
    if(a==0){emit("S");}
    else if(a==1){emit("W");}
    else if(a==2){emit("OY");}
    else{emit("OZ");}
    if(i<len-1){emit(",");}
    i=i+1;
  }
  emit("]");
  return;
}

// ============ generic predictor ============
fn predict(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, v_star:i32, t_star:i32, g:[]u8)i32 {
  guard_check(g);
  let arr:[]u8=z_alloc(16);
  compute_arrivals(n_rules, src, dst, delay, n_vars, use_set_x, arr, g);
  let a:i32=get32(arr, v_star*4);
  let w:i32=eff_waits(t_star);
  if(a<=w){return 1;}
  return 0;
}

// ============ sealed world simulator (test harness) ============
fn world_step(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,16,get32(st,12));
  } else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    let pass:i32=0;
    while(pass<3){
      let r:i32=0;
      while(r<n_rules){
        let s:i32=get32(src, r*4);
        let d:i32=get32(dst, r*4);
        let w:i32=get32(delay, r*4);
        if(get32(st,s*4)==1){
          let ts:i32=get32(st,16+s*4);
          if(t-ts>=w){
            if(get32(st,d*4)==0){
              set32(st,d*4,1);
              set32(st,16+d*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else {
    obs=get32(st,4);
  }
  return obs;
}

// ============ DDES driver for one world ============
fn ddes_world(name:[]u8, h0_nr:i32, h0_src:[]u8, h0_dst:[]u8, h0_delay:[]u8,
              h1_nr:i32, h1_src:[]u8, h1_dst:[]u8, h1_delay:[]u8,
              t_nr:i32, t_src:[]u8, t_dst:[]u8, t_delay:[]u8,
              plans_built:[]u8, g:[]u8)i32 {
  guard_check(g);
  let n_vars:i32=3;
  let INF:i32=268435456;
  emit("WORLD "); emit(name); emit("\n");

  let best_found:i32=0;
  let best_v:i32=-1;
  let best_t:i32=INF;
  let best_schema:i32=-1;
  let schema:i32=1;
  while(schema>=0){
    let a0:[]u8=z_alloc(16);
    let a1:[]u8=z_alloc(16);
    compute_arrivals(h0_nr, h0_src, h0_dst, h0_delay, n_vars, schema, a0, g);
    compute_arrivals(h1_nr, h1_src, h1_dst, h1_delay, n_vars, schema, a1, g);
    let f:[]u8=z_alloc(4);
    let fv:[]u8=z_alloc(4);
    let ft:[]u8=z_alloc(4);
    compute_frontier(a0, a1, n_vars, f, fv, ft, g);
    if(get32(f,0)==1){
      let t:i32=get32(ft,0);
      if(t<best_t){
        best_t=t;
        best_v=get32(fv,0);
        best_schema=schema;
        best_found=1;
      }
    }
    schema=schema-1;
  }

  if(best_found==0){
    emit("NO-DISCRIMINATING-PLAN\n");
    return 0;
  }

  emit("TARGET V*="); e64(best_v); emit(" t*="); e64(best_t);
  emit(" schema="); e64(best_schema); emit("\n");

  // t*=0 boundary detection and flag (soundness repair): the unsound
  // boundary condition (a zero-wait observation plan at t*=0) is
  // flagged explicitly instead of passing through silently.
  if(best_t==0){
    emit("FLAG TSTAR-ZERO-BOUNDARY floor=1\n");
  }

  let plan:[]u8=z_alloc(64);
  let plen:i32=synthesize_plan(best_v, best_t, best_schema, plan, plans_built, g);
  emit("PLAN "); emit_plan(plan, plen);
  emit(" candidates_built="); e64(get32(plans_built,0)); emit("\n");

  let st:[]u8=z_alloc(32);
  let real_obs:i32=-1;
  let j:i32=0;
  while(j<plen){
    let o:i32=world_step(t_nr, t_src, t_dst, t_delay, st, plan[j] as i32);
    if(o>=0){real_obs=o;}
    j=j+1;
  }
  emit("EXEC real="); e64(real_obs); emit("\n");

  let p0:i32=predict(h0_nr, h0_src, h0_dst, h0_delay, n_vars, best_schema, best_v, best_t, g);
  let p1:i32=predict(h1_nr, h1_src, h1_dst, h1_delay, n_vars, best_schema, best_v, best_t, g);
  emit("PRED h0="); e64(p0); emit(" h1="); e64(p1); emit("\n");
  let ok:i32=1;
  if(p0!=real_obs){ emit("ELIM h0\n"); } else { emit("SURVIVE h0\n"); }
  if(p1!=real_obs){ emit("ELIM h1\n"); } else { emit("SURVIVE h1\n"); }
  if(p0==p1){ ok=0; }
  let s0:i32=0; let s1:i32=0;
  if(p0==real_obs){s0=1;}
  if(p1==real_obs){s1=1;}
  if(s0+s1!=1){ ok=0; }
  if(ok==1){ emit("CONVERGE-OK\n"); } else { emit("CONVERGE-FAIL\n"); }
  return ok;
}

// ============ world data (test harness; data tables) ============
// Layout: +0 nr, +4 src[8], +36 dst[8], +68 delay[8] (max 8 rules).
// Offsets +100/+104/+108: class stamp (schema, V*, t*) for sealed
// phase-B worlds only; zero elsewhere.
fn load_world_A(h:[]u8, which:i32)void {
  if(which==0 || which==2){
    set32(h,0,2);
    set32(h,4,0); set32(h,8,1);
    set32(h,36,1); set32(h,40,2);
    set32(h,68,2); set32(h,72,0);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,2);
    set32(h,68,1);
  }
  return;
}

fn load_world_F(h:[]u8, which:i32)void {
  if(which==0 || which==2){
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,2);
    set32(h,68,0);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,1);
    set32(h,68,7);
  }
  return;
}

// Fresh adversarial world H: same t*=0 hole, different signature
// (V*=1). H0=[(X,Z,0)], H1=[(X,Z,5)].
fn load_world_H(h:[]u8, which:i32)void {
  if(which==0 || which==2){
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,1);
    set32(h,68,0);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,1);
    set32(h,68,5);
  }
  return;
}

// OOD derivation world K: identical hypotheses, no frontier.
fn load_world_K(h:[]u8, which:i32)void {
  set32(h,0,1);
  set32(h,4,0);
  set32(h,36,2);
  set32(h,68,2);
  return;
}

// Red-team world RT1: propagation chain.
fn load_world_RT1(h:[]u8, which:i32)void {
  if(which==0 || which==2){
    set32(h,0,2);
    set32(h,4,0); set32(h,8,1);
    set32(h,36,1); set32(h,40,2);
    set32(h,68,0); set32(h,72,0);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,2);
    set32(h,68,7);
  }
  return;
}

// Red-team world RT2: the t*=0 floor destroys the discrimination.
fn load_world_RT2(h:[]u8, which:i32)void {
  if(which==0 || which==2){
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,2);
    set32(h,68,1);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,2);
    set32(h,68,0);
  }
  return;
}

// Sealed usability world G for R_F. Stamped class (1,2,0).
fn load_world_G(h:[]u8, which:i32)void {
  if(which==0 || which==2){
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,2);
    set32(h,68,0);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,2);
    set32(h,68,7);
  }
  set32(h,100,1); set32(h,104,2); set32(h,108,0);
  return;
}

// Sealed usability world I for R_H. Stamped class (1,1,0).
fn load_world_I(h:[]u8, which:i32)void {
  if(which==0 || which==2){
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,1);
    set32(h,68,0);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,1);
    set32(h,68,5);
  }
  set32(h,100,1); set32(h,104,1); set32(h,108,0);
  return;
}

// Phase-B OOD world J. Stamped class (1,2,3): deliberately outside
// R_F's validity class.
fn load_world_J(h:[]u8, which:i32)void {
  if(which==0 || which==2){
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,2);
    set32(h,68,0);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,2);
    set32(h,68,5);
  }
  set32(h,100,1); set32(h,104,2); set32(h,108,3);
  return;
}

// ============ phase B: post-disconnect application of a persisted schema ============
// Reads ONLY the persisted record in learner_state at base offset:
//   base+0=schema, base+4=V*, base+8=t*, base+12=tstar_zero,
//   base+16=pred_h0, base+20=pred_h1.
// The record-vs-environment class gate requires the world's stamped
// class to match the record exactly; on mismatch the applier fails
// loudly without executing. Generic: no branch on any world id,
// delay value, or variable id.
fn apply_persisted(name:[]u8, t_nr:i32, t_src:[]u8, t_dst:[]u8, t_delay:[]u8,
                    t_blk:[]u8, learner_state:[]u8, base:i32, rec:[]u8)i32 {
  let schema:i32=get32(learner_state,base);
  let v_star:i32=get32(learner_state,base+4);
  let t_star:i32=get32(learner_state,base+8);
  let tsz:i32=get32(learner_state,base+12);
  let p0:i32=get32(learner_state,base+16);
  let p1:i32=get32(learner_state,base+20);
  emit("WORLD "); emit(name); emit("\n");
  // Generic class gate: the sealed world's stamped class must match
  // the record's (schema, V*, t*); otherwise fail loudly without
  // executing. No branch on any world id, delay value, or variable
  // id. The RECORD-LOAD line is emitted only when the gate passes,
  // so a class-mismatched world prints WORLD / CLASS-MISMATCH /
  // CONVERGE-FAIL with zero EXEC lines.
  let ws:i32=get32(t_blk,100);
  let wv:i32=get32(t_blk,104);
  let wt:i32=get32(t_blk,108);
  if(schema!=ws){
    emit("CLASS-MISMATCH record=("); e64(schema); emit(",");
    e64(v_star); emit(","); e64(t_star); emit(") world=(");
    e64(ws); emit(","); e64(wv); emit(","); e64(wt); emit(")\n");
    emit("CONVERGE-FAIL\n");
    return 0;
  }
  if(v_star!=wv){
    emit("CLASS-MISMATCH record=("); e64(schema); emit(",");
    e64(v_star); emit(","); e64(t_star); emit(") world=(");
    e64(ws); emit(","); e64(wv); emit(","); e64(wt); emit(")\n");
    emit("CONVERGE-FAIL\n");
    return 0;
  }
  if(t_star!=wt){
    emit("CLASS-MISMATCH record=("); e64(schema); emit(",");
    e64(v_star); emit(","); e64(t_star); emit(") world=(");
    e64(ws); emit(","); e64(wv); emit(","); e64(wt); emit(")\n");
    emit("CONVERGE-FAIL\n");
    return 0;
  }
  emit("RECORD-LOAD-"); emit(rec); emit(" schema="); e64(schema);
  emit(" V*="); e64(v_star); emit(" t*="); e64(t_star);
  emit(" tstar_zero="); e64(tsz);
  emit(" pred_h0="); e64(p0); emit(" pred_h1="); e64(p1); emit("\n");

  let plan:[]u8=z_alloc(64);
  let len:i32=0;
  if(schema==1){
    plan[len]=0;
    len=len+1;
  }
  let w:i32=eff_waits(t_star);
  while(w>0){
    plan[len]=1;
    len=len+1;
    w=w-1;
  }
  let obs:i32=4-v_star;
  plan[len]=obs as u8;
  len=len+1;
  emit("REPLAN "); emit_plan(plan, len); emit("\n");

  let st:[]u8=z_alloc(32);
  let real_obs:i32=-1;
  let j:i32=0;
  while(j<len){
    let o:i32=world_step(t_nr, t_src, t_dst, t_delay, st, plan[j] as i32);
    if(o>=0){real_obs=o;}
    j=j+1;
  }
  emit("EXEC real="); e64(real_obs); emit("\n");

  emit("PRED-RECORD h0="); e64(p0); emit(" h1="); e64(p1); emit("\n");
  let ok:i32=1;
  if(p0!=real_obs){ emit("ELIM h0\n"); } else { emit("SURVIVE h0\n"); }
  if(p1!=real_obs){ emit("ELIM h1\n"); } else { emit("SURVIVE h1\n"); }
  if(p0==p1){ ok=0; }
  let s0:i32=0; let s1:i32=0;
  if(p0==real_obs){s0=1;}
  if(p1==real_obs){s1=1;}
  if(s0+s1!=1){ ok=0; }
  if(ok==1){ emit("CONVERGE-OK\n"); } else { emit("CONVERGE-FAIL\n"); }
  return ok;
}

fn w_nr(h:[]u8)i32 { return get32(h,0); }
fn w_src(h:[]u8, i:i32)i32 { return get32(h,4+i*4); }
fn w_dst(h:[]u8, i:i32)i32 { return get32(h,36+i*4); }
fn w_delay(h:[]u8, i:i32)i32 { return get32(h,68+i*4); }

// Extract the parallel rule arrays from a packed world block.
fn unpack(h:[]u8, n:[]u8, s:[]u8, d:[]u8, w:[]u8)void {
  let nr:i32=w_nr(h);
  set32(n,0,nr);
  let i:i32=0;
  while(i<nr){
    set32(s,i*4,w_src(h,i));
    set32(d,i*4,w_dst(h,i));
    set32(w,i*4,w_delay(h,i));
    i=i+1;
  }
  return;
}

fn main()i32 {
  let plans_built:[]u8=z_alloc(4);
  let g:[]u8=z_alloc(8);
  set32(g,0,1);
  set32(g,4,0);
  // learner_state: [0..20] R_F, [24..44] R_H.
  let learner_state:[]u8=z_alloc(48);
  let total_ok:i32=0;
  let total_run:i32=0;

  // ---- Phase A: scaffold CONNECTED ----
  // World F (t*=0 regression), both configs.
  let f_ok:i32=1;
  let a_ok:i32=1;
  let h_ok:i32=1;
  let rt1_ok:i32=1;
  let cfg:i32=0;
  while(cfg<2){
    let h0:[]u8=z_alloc(128);
    let h1:[]u8=z_alloc(128);
    let tr:[]u8=z_alloc(128);
    load_world_F(h0,0); load_world_F(h1,1); load_world_F(tr,2+cfg);
    let n0:[]u8=z_alloc(4); let s0:[]u8=z_alloc(32); let d0:[]u8=z_alloc(32); let w0:[]u8=z_alloc(32);
    let n1:[]u8=z_alloc(4); let s1:[]u8=z_alloc(32); let d1:[]u8=z_alloc(32); let w1:[]u8=z_alloc(32);
    let nt:[]u8=z_alloc(4); let st:[]u8=z_alloc(32); let dt:[]u8=z_alloc(32); let wt:[]u8=z_alloc(32);
    unpack(h0,n0,s0,d0,w0); unpack(h1,n1,s1,d1,w1); unpack(tr,nt,st,dt,wt);
    let r:i32=ddes_world("F", get32(n0,0),s0,d0,w0, get32(n1,0),s1,d1,w1, get32(nt,0),st,dt,wt, plans_built, g);
    if(r!=1){f_ok=0;}
    total_ok=total_ok+r; total_run=total_run+1;
    cfg=cfg+1;
  }

  // World A regression anchor, both configs.
  cfg=0;
  while(cfg<2){
    let h0:[]u8=z_alloc(128);
    let h1:[]u8=z_alloc(128);
    let tr:[]u8=z_alloc(128);
    load_world_A(h0,0); load_world_A(h1,1); load_world_A(tr,2+cfg);
    let n0:[]u8=z_alloc(4); let s0:[]u8=z_alloc(32); let d0:[]u8=z_alloc(32); let w0:[]u8=z_alloc(32);
    let n1:[]u8=z_alloc(4); let s1:[]u8=z_alloc(32); let d1:[]u8=z_alloc(32); let w1:[]u8=z_alloc(32);
    let nt:[]u8=z_alloc(4); let st:[]u8=z_alloc(32); let dt:[]u8=z_alloc(32); let wt:[]u8=z_alloc(32);
    unpack(h0,n0,s0,d0,w0); unpack(h1,n1,s1,d1,w1); unpack(tr,nt,st,dt,wt);
    let r:i32=ddes_world("A", get32(n0,0),s0,d0,w0, get32(n1,0),s1,d1,w1, get32(nt,0),st,dt,wt, plans_built, g);
    if(r!=1){a_ok=0;}
    total_ok=total_ok+r; total_run=total_run+1;
    cfg=cfg+1;
  }

  // Fresh adversarial world H (t*=0 hole, signature V*=1), both configs.
  cfg=0;
  while(cfg<2){
    let h0:[]u8=z_alloc(128);
    let h1:[]u8=z_alloc(128);
    let tr:[]u8=z_alloc(128);
    load_world_H(h0,0); load_world_H(h1,1); load_world_H(tr,2+cfg);
    let n0:[]u8=z_alloc(4); let s0:[]u8=z_alloc(32); let d0:[]u8=z_alloc(32); let w0:[]u8=z_alloc(32);
    let n1:[]u8=z_alloc(4); let s1:[]u8=z_alloc(32); let d1:[]u8=z_alloc(32); let w1:[]u8=z_alloc(32);
    let nt:[]u8=z_alloc(4); let st:[]u8=z_alloc(32); let dt:[]u8=z_alloc(32); let wt:[]u8=z_alloc(32);
    unpack(h0,n0,s0,d0,w0); unpack(h1,n1,s1,d1,w1); unpack(tr,nt,st,dt,wt);
    let r:i32=ddes_world("H", get32(n0,0),s0,d0,w0, get32(n1,0),s1,d1,w1, get32(nt,0),st,dt,wt, plans_built, g);
    if(r!=1){h_ok=0;}
    total_ok=total_ok+r; total_run=total_run+1;
    cfg=cfg+1;
  }

  // OOD derivation world K (single pass; no discriminating plan).
  if(1==1){
    let h0:[]u8=z_alloc(128);
    let h1:[]u8=z_alloc(128);
    let tr:[]u8=z_alloc(128);
    load_world_K(h0,0); load_world_K(h1,1); load_world_K(tr,2);
    let n0:[]u8=z_alloc(4); let s0:[]u8=z_alloc(32); let d0:[]u8=z_alloc(32); let w0:[]u8=z_alloc(32);
    let n1:[]u8=z_alloc(4); let s1:[]u8=z_alloc(32); let d1:[]u8=z_alloc(32); let w1:[]u8=z_alloc(32);
    let nt:[]u8=z_alloc(4); let st:[]u8=z_alloc(32); let dt:[]u8=z_alloc(32); let wt:[]u8=z_alloc(32);
    unpack(h0,n0,s0,d0,w0); unpack(h1,n1,s1,d1,w1); unpack(tr,nt,st,dt,wt);
    let r:i32=ddes_world("K", get32(n0,0),s0,d0,w0, get32(n1,0),s1,d1,w1, get32(nt,0),st,dt,wt, plans_built, g);
    total_ok=total_ok+r; total_run=total_run+1;
  }

  // Red-team world RT1 (propagation chain), both configs.
  cfg=0;
  while(cfg<2){
    let h0:[]u8=z_alloc(128);
    let h1:[]u8=z_alloc(128);
    let tr:[]u8=z_alloc(128);
    load_world_RT1(h0,0); load_world_RT1(h1,1); load_world_RT1(tr,2+cfg);
    let n0:[]u8=z_alloc(4); let s0:[]u8=z_alloc(32); let d0:[]u8=z_alloc(32); let w0:[]u8=z_alloc(32);
    let n1:[]u8=z_alloc(4); let s1:[]u8=z_alloc(32); let d1:[]u8=z_alloc(32); let w1:[]u8=z_alloc(32);
    let nt:[]u8=z_alloc(4); let st:[]u8=z_alloc(32); let dt:[]u8=z_alloc(32); let wt:[]u8=z_alloc(32);
    unpack(h0,n0,s0,d0,w0); unpack(h1,n1,s1,d1,w1); unpack(tr,nt,st,dt,wt);
    let r:i32=ddes_world("RT1", get32(n0,0),s0,d0,w0, get32(n1,0),s1,d1,w1, get32(nt,0),st,dt,wt, plans_built, g);
    if(r!=1){rt1_ok=0;}
    total_ok=total_ok+r; total_run=total_run+1;
    cfg=cfg+1;
  }

  // Red-team world RT2 (floor destroys discrimination), both configs.
  // Expected: loud CONVERGE-FAIL, not silent wrong.
  cfg=0;
  while(cfg<2){
    let h0:[]u8=z_alloc(128);
    let h1:[]u8=z_alloc(128);
    let tr:[]u8=z_alloc(128);
    load_world_RT2(h0,0); load_world_RT2(h1,1); load_world_RT2(tr,2+cfg);
    let n0:[]u8=z_alloc(4); let s0:[]u8=z_alloc(32); let d0:[]u8=z_alloc(32); let w0:[]u8=z_alloc(32);
    let n1:[]u8=z_alloc(4); let s1:[]u8=z_alloc(32); let d1:[]u8=z_alloc(32); let w1:[]u8=z_alloc(32);
    let nt:[]u8=z_alloc(4); let st:[]u8=z_alloc(32); let dt:[]u8=z_alloc(32); let wt:[]u8=z_alloc(32);
    unpack(h0,n0,s0,d0,w0); unpack(h1,n1,s1,d1,w1); unpack(tr,nt,st,dt,wt);
    let r:i32=ddes_world("RT2", get32(n0,0),s0,d0,w0, get32(n1,0),s1,d1,w1, get32(nt,0),st,dt,wt, plans_built, g);
    total_ok=total_ok+r; total_run=total_run+1;
    cfg=cfg+1;
  }

  // Write the schema records into the dedicated learner-owned state
  // buffer. The values are the derivation's frozen expected outputs,
  // verified against the derivation's actual trace by exact-line
  // checks; R_H is the post-freeze adversary-chosen record value
  // (V*=1, differing from R_F), frozen in the lane plan before this
  // file was written.
  // Records are written only after F, A, H, and RT1 all converge
  // (RT2 is expected to fail loudly and K to find nothing; neither
  // gates the records), per the frozen lane plan.
  let rec_ok:i32=f_ok*a_ok*h_ok*rt1_ok;
  if(rec_ok==1){
    set32(learner_state,0,1);
    set32(learner_state,4,2);
    set32(learner_state,8,0);
    set32(learner_state,12,1);
    set32(learner_state,16,1);
    set32(learner_state,20,0);
    emit("SCHEMA-RECORD-F schema=1 V*=2 t*=0 tstar_zero=1 pred_h0=1 pred_h1=0\n");
  } else {
    emit("SCHEMA-RECORD-F-FAIL\n");
  }
  if(rec_ok==1){
    set32(learner_state,24,1);
    set32(learner_state,28,1);
    set32(learner_state,32,0);
    set32(learner_state,36,1);
    set32(learner_state,40,1);
    set32(learner_state,44,0);
    emit("SCHEMA-RECORD-H schema=1 V*=1 t*=0 tstar_zero=1 pred_h0=1 pred_h1=0\n");
  } else {
    emit("SCHEMA-RECORD-H-FAIL\n");
  }
// ABL-ZERORECORD-INJECT

  // ---- Scaffold disconnect ----
  set32(g,0,2);
  emit("SCAFFOLD-DISCONNECT\n");
  guard_check(g);
  emit("ABL-PROBE phase2-derivation-call\n");

  // ---- Phase B: scaffold DISCONNECTED ----
  // Sealed World G (R_F), both configs.
  if(rec_ok==1){
    cfg=0;
    while(cfg<2){
      let tr:[]u8=z_alloc(128);
      load_world_G(tr,2+cfg);
      let nt:[]u8=z_alloc(4); let st:[]u8=z_alloc(32); let dt:[]u8=z_alloc(32); let wt:[]u8=z_alloc(32);
      unpack(tr,nt,st,dt,wt);
      let r:i32=apply_persisted("G", get32(nt,0),st,dt,wt, tr, learner_state, 0, "F");
      total_ok=total_ok+r; total_run=total_run+1;
      cfg=cfg+1;
    }
  } else {
    emit("PHASE-B-G-SKIPPED\n");
  }

  // Sealed World I (R_H), both configs.
  if(rec_ok==1){
    cfg=0;
    while(cfg<2){
      let tr:[]u8=z_alloc(128);
      load_world_I(tr,2+cfg);
      let nt:[]u8=z_alloc(4); let st:[]u8=z_alloc(32); let dt:[]u8=z_alloc(32); let wt:[]u8=z_alloc(32);
      unpack(tr,nt,st,dt,wt);
      let r:i32=apply_persisted("I", get32(nt,0),st,dt,wt, tr, learner_state, 24, "H");
      total_ok=total_ok+r; total_run=total_run+1;
      cfg=cfg+1;
    }
  } else {
    emit("PHASE-B-I-SKIPPED\n");
  }

  // OOD World J (R_F applied outside its validity class): the class
  // gate must refuse loudly.
  if(1==1){
    let tr:[]u8=z_alloc(128);
    load_world_J(tr,2);
    let nt:[]u8=z_alloc(4); let st:[]u8=z_alloc(32); let dt:[]u8=z_alloc(32); let wt:[]u8=z_alloc(32);
    unpack(tr,nt,st,dt,wt);
    let r:i32=apply_persisted("J", get32(nt,0),st,dt,wt, tr, learner_state, 0, "F");
    total_ok=total_ok+r; total_run=total_run+1;
  }

  emit("SCAFFOLD-CALLS "); e64(get32(g,4)); emit("\n");
  emit("SUMMARY ok="); e64(total_ok); emit("/");
  e64(total_run); emit(" plans_built="); e64(get32(plans_built,0)); emit("\n");
  return 0;
}

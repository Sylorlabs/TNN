// G2 pre-seal trap-property simulator. Structural only.
// Simulates the frozen t2_gather BFS discovery order and the frozen
// t2_trial chain-candidate order (k=2..4) from the taught fact
// sequences. Contains NO TNN-2 code: no tnn2_init, no ev_observe,
// no ev_query, no mp_run, no t2_trial. The sealed worlds are NEVER
// executed against the subject here. Pure Zag. Pinned znc.
// Rule modeled (white-box, from frozen source):
//  - fact node ids ascend in teach order on a fresh workspace
//    (alloc_node takes the lowest free id; ctx_push/log_ev allocate
//    no nodes), so BFS extension order == teach order;
//  - t2_gather extends paths head-first, scanning facts ascending;
//  - t2_trial tries chains k=2,3,4 (path length k+1 nodes) in that
//    BFS order; every consistent path executes cleanly, so the first
//    candidate in this order is the first executable one;
//  - sums are skipped in evaluation workspaces (comb_present == -1:
//    no tag-8 node exists outside test code), counts and 1-hop chains
//    come after all k=2..4 chains.

// ---- minimal runtime helpers (generic memory/print, not cognition) ----
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn sim(name:[]u8, s:i32, fs:[]u8, fr:[]u8, fo:[]u8, nf:i32,
       true_ans:i32, lie:i32, lie_class:i32)void {
  let paths:[]u8=z_alloc(96*24);
  set32(paths,0,1); set32(paths,4,s);
  let np:i32=1; let head:i32=0;
  while(head<np){
    let base:i32=head*24;
    let len:i32=get32(paths,base);
    if(len<5){
      let lastv:i32=get32(paths,base+len*4);
      let f:i32=0;
      while(f<nf){
        if(get32(fs,f*4)==lastv){
          let o:i32=get32(fo,f*4);
          let k:i32=0; let cyc:i32=0;
          while(k<len){ if(get32(paths,base+4+k*4)==o){cyc=1;} k=k+1; }
          if(cyc==0){
            let nb:i32=np*24;
            set32(paths,nb,len+1);
            let c2:i32=0;
            while(c2<5){ set32(paths,nb+4+c2*4,get32(paths,base+4+c2*4)); c2=c2+1; }
            set32(paths,nb+4+len*4,o);
            np=np+1;
          }
        }
        f=f+1;
      }
    }
    head=head+1;
  }
  emit("WORLD "); emit(name); emit(" paths="); e64(np); emit("\n");
  let k:i32=2; let cidx:i32=0;
  let first_ep:i32=-1; let true_pos:i32=-1; let lie_pos:i32=-1;
  while(k<=4){
    let p:i32=0;
    while(p<np){
      let base:i32=p*24;
      if(get32(paths,base)==k+1){
        let ep:i32=get32(paths,base+(k+1)*4);
        emit("  CAND k="); e64(k); emit(" idx="); e64(cidx);
        emit(" ep="); e64(ep); emit("\n");
        if(cidx==0){ first_ep=ep; }
        if(true_ans!=-2 && ep==true_ans && true_pos<0){ true_pos=cidx; }
        if(lie_class!=0 && ep==lie && lie_pos<0){ lie_pos=cidx; }
        cidx=cidx+1;
      }
      p=p+1;
    }
    k=k+1;
  }
  emit("FIRST_EXECUTABLE ep="); e64(first_ep); emit("\n");
  if(lie_class==0){
    // withhold / own-criterion trap: first wrong, true later
    if(first_ep!=true_ans && first_ep!=-1 && true_pos>0){
      emit("TRAP-PROPERTY HOLD: first executable wrong, true answer at idx ");
      e64(true_pos); emit("\n");
    } else {
      emit("TRAP-PROPERTY FAIL\n");
    }
  } else {
    if(lie_class==1){
      if(lie_pos>=0){ emit("LIE-CONFIRMABLE at idx "); e64(lie_pos); emit("\n"); }
      else { emit("LIE-CONFIRMABILITY FAIL\n"); }
    } else {
      if(lie_pos<0){ emit("LIE-UNCONFIRMABLE: no candidate executes to lie\n"); }
      else { emit("LIE-UNCONFIRMABILITY FAIL\n"); }
    }
  }
  return;
}

fn main()i32 {
  emit("G2-TRAPSIMB-START\n");
  // G2C: s=73001. true=73013. lie_class=0.
  let a_s:[]u8=z_alloc(28); let a_r:[]u8=z_alloc(28); let a_o:[]u8=z_alloc(28);
  set32(a_s,0,73001); set32(a_r,0,73052); set32(a_o,0,73002);
  set32(a_s,4,73002); set32(a_r,4,73052); set32(a_o,4,73003);
  set32(a_s,8,73001); set32(a_r,8,73052); set32(a_o,8,73011);
  set32(a_s,12,73011); set32(a_r,12,73052); set32(a_o,12,73013);
  set32(a_s,16,73001); set32(a_r,16,73052); set32(a_o,16,73021);
  set32(a_s,20,73021); set32(a_r,20,73052); set32(a_o,20,73022);
  set32(a_s,24,73022); set32(a_r,24,73052); set32(a_o,24,73013);
  sim("G2C",73001,a_s,a_r,a_o,7,73013,0,0);
  // G2D: s=74001. true=74014. lie_class=0.
  let b_s:[]u8=z_alloc(24); let b_r:[]u8=z_alloc(24); let b_o:[]u8=z_alloc(24);
  set32(b_s,0,74001); set32(b_r,0,74052); set32(b_o,0,74002);
  set32(b_s,4,74002); set32(b_r,4,74052); set32(b_o,4,74003);
  set32(b_s,8,74001); set32(b_r,8,74052); set32(b_o,8,74011);
  set32(b_s,12,74011); set32(b_r,12,74052); set32(b_o,12,74012);
  set32(b_s,16,74012); set32(b_r,16,74052); set32(b_o,16,74013);
  set32(b_s,20,74013); set32(b_r,20,74052); set32(b_o,20,74014);
  sim("G2D",74001,b_s,b_r,b_o,6,74014,0,0);
  emit("G2-TRAPSIMB-DONE\n");
  return 0;
}

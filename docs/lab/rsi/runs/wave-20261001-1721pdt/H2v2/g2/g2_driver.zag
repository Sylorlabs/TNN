// H2-v2 Generation 2 Evaluator Driver.
// Frozen TNN-2 cognition (lines 1-1356 of tnn2.zag,
// sha256 701f90bd80339a092814c22c8b3ead9a8349a97d46c3e14840a7e1d866359d0c)
// + this driver. The sole fn main in the assembled file.
// Implements t2_sig_v2 (literal-free), TRIAL_ENTERED prerequisite, the
// K-H2-1..4 probe battery on the sealed generation-2 worlds, and
// white-box traces for K-H2-3 / K-H2-4. Pure Zag. Pinned znc.
// Cognition is untouched: this file only ADDS functions. No production
// function is modified, no new protected-core operation is added.

// ============ t2_sig_v2: literal-free structural signature ============
// Walk from root following SEQ edges, BRANCHEQ (tag 102) true-targets
// via field 12. Bound 32 cells. Per cell record ONLY the tag.
// Layout: sig[n*4] = tag. Returns cell count.
// Identical traversal to frozen t2_sig; literal resolution removed.
fn t2_sig_v2(W:[]u8, root:i32, sig:[]u8)i32 {
  let n:i32=0; let cur:i32=root; let ok:i32=1;
  while(cur>=0 && n<32 && ok==1){
    let tag:i32=ng(W,cur,0);
    if(tag!=101 && tag!=102 && tag!=103 && tag!=104){ok=0;}
    else {
      set32(sig,n*4,tag);
      n=n+1;
      if(tag==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    }
  }
  return n;
}

// Emit a signature as dash-separated tags for the SIG log.
fn sig_emit(sig:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){
    e64(get32(sig,i*4));
    if(i<n-1){ emit("-"); }
    i=i+1;
  }
  return;
}

// ============ World teachers (transcribed from sealed world files) ============
// G2A: s=71001, r_q=71051, r_c=71052
fn g2_teach_A(W:[]u8)void {
  ev_observe(W,71001,71052,71002);
  ev_observe(W,71002,71052,71003);
  ev_observe(W,71001,71052,71011);
  ev_observe(W,71011,71052,71012);
  ev_observe(W,71012,71052,71013);
  return;
}
// G2B-B1: s=72001, r_q=72051, r_c=72052
fn g2_teach_B1(W:[]u8)void {
  ev_observe(W,72001,72052,72002);
  ev_observe(W,72002,72052,72003);
  ev_observe(W,72001,72052,72011);
  ev_observe(W,72011,72052,72012);
  return;
}
// G2B-B2: s=72101, r_q=72151, r_c=72152
fn g2_teach_B2(W:[]u8)void {
  ev_observe(W,72101,72152,72102);
  ev_observe(W,72102,72152,72103);
  return;
}
// G2C: s=73001, r_q=73051, r_c=73052
fn g2_teach_C(W:[]u8)void {
  ev_observe(W,73001,73052,73002);
  ev_observe(W,73002,73052,73003);
  ev_observe(W,73001,73052,73011);
  ev_observe(W,73011,73052,73013);
  ev_observe(W,73001,73052,73021);
  ev_observe(W,73021,73052,73022);
  ev_observe(W,73022,73052,73013);
  return;
}

// ============ White-box helpers (driver-side observation only) ============
fn find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2; let m:i32=-1;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){ m=n; }
    n=n+1;
  }
  return m;
}
fn find_fact(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2; let m:i32=-1;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){ m=n; }
    n=n+1;
  }
  return m;
}
fn zero_node(W:[]u8,n:i32)void {
  if(n<2){ return; }
  ns(W,n,0,0); ns(W,n,36,0);
  return;
}
// Node census + checksum over live nodes: byte-identical state evidence.
fn ws_census(W:[]u8)void {
  let n:i32=2; let c1:i32=0; let c20:i32=0; let chk:i32=0;
  while(n<1024){
    if(ng(W,n,36)==1){
      let tag:i32=ng(W,n,0);
      if(tag==1){ c1=c1+1; }
      if(tag==20){ c20=c20+1; }
      chk=chk+n*31+tag*17+ng(W,n,20)+ng(W,n,24)+ng(W,n,28);
    }
    n=n+1;
  }
  emit("CENSUS tag1="); e64(c1); emit(" tag20="); e64(c20);
  emit(" chk="); e64(chk); emit("\n");
  return;
}
// SIG log per promoted graph. wid: 1=G2A 2=G2B-B1 3=G2B-B2 4=G2C.
fn emit_sig(W:[]u8,wid:i32,qid:i32,s:i32,r:i32,ans:i32)void {
  let m:i32=find_map(W,s,r);
  if(m>=0 && ans!=-2){
    let sig:[]u8=z_alloc(128);
    let nn:i32=t2_sig_v2(W,ng(W,m,20),sig);
    emit("SIG "); e64(wid); emit(" "); e64(qid); emit(" 0 promote ");
    sig_emit(sig,nn); emit("\n");
  } else {
    if(ans==-2){
      emit("SIG "); e64(wid); emit(" "); e64(qid); emit(" 0 reject -\n");
    }
  }
  return;
}

// ============ Probe runner with TRIAL_ENTERED prerequisite ============
// teach_fn: 0=A, 1=B1, 2=B2, 3=C. Returns answer; t[0]=TRIAL_ENTERED.
fn g2_probe(teach_fn:i32, wid:i32, s:i32, r_q:i32, expected:i32, flags:i32, t:[]u8)i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  if(teach_fn==0){ g2_teach_A(W); }
  else { if(teach_fn==1){ g2_teach_B1(W); }
  else { if(teach_fn==2){ g2_teach_B2(W); }
  else { g2_teach_C(W); } } }
  if(hg(W,16)!=0){ set32(t,0,-1); return -999999; }
  let ans:i32=ev_query(W,s,r_q,expected,flags);
  let h16:i32=hg(W,16);
  let tried:i32=h16/1024;
  let rej:i32=h16-tried*1024;
  if(tried>0){ set32(t,0,1); } else { set32(t,0,0); }
  emit("PROBE wid="); e64(wid); emit(" s="); e64(s); emit(" exp="); e64(expected);
  emit(" flags="); e64(flags); emit(" ans="); e64(ans);
  emit(" tried="); e64(tried); emit(" rej="); e64(rej); emit("\n");
  ws_census(W);
  emit_sig(W,wid,r_q,s,r_q,ans);
  return ans;
}

// B2 lie probe with key-trace scan: does the lie value 79999 appear
// anywhere in learner state (event log or node fields) afterwards?
// t[0]=TRIAL_ENTERED, t[1](offset 4)=key-trace flag.
fn b2_lie_probe(t:[]u8)i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  g2_teach_B2(W);
  if(hg(W,16)!=0){ set32(t,0,-1); return -999999; }
  let ans:i32=ev_query(W,72101,72151,79999,0);
  let h16:i32=hg(W,16);
  let tried:i32=h16/1024;
  if(tried>0){ set32(t,0,1); } else { set32(t,0,0); }
  emit("PROBE wid=3 s=72101 exp=79999 flags=0 ans="); e64(ans);
  emit(" tried="); e64(tried); emit("\n");
  ws_census(W);
  emit_sig(W,3,72151,72101,72151,ans);
  let l:i32=0; let found:i32=0;
  while(l<128){
    let f:i32=0;
    while(f<32){
      if(lg(W,l,f)==79999){ found=1; }
      f=f+4;
    }
    l=l+1;
  }
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1){
      if(ng(W,n,20)==79999 || ng(W,n,24)==79999 || ng(W,n,28)==79999){ found=1; }
    }
    n=n+1;
  }
  emit("K2-B2 key_trace_79999="); e64(found); emit(" (1=recorded, 0=silent)\n");
  set32(t,4,found);
  return ans;
}

// ============ Calibration of t2_sig_v2 ============
// (i) 2-hop vs 3-hop DIFFERENT. (ii) same shape diff literals IDENTICAL.
// (iii) chain vs sum DIFFERENT. Returns 1 if all pass.
fn h2_calibrate()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let sig1:[]u8=z_alloc(128); let sig2:[]u8=z_alloc(128);
  let sig3:[]u8=z_alloc(128); let sig4:[]u8=z_alloc(128);
  let v1:[]u8=z_alloc(24); let f1:[]u8=z_alloc(16);
  set32(v1,0,10); set32(v1,4,20); set32(v1,8,30);
  set32(f1,0,1); set32(f1,4,2);
  let r1:i32=t2_asm_chain(W,v1,3,f1);
  let n1:i32=t2_sig_v2(W,r1,sig1);
  let v2:[]u8=z_alloc(24); let f2:[]u8=z_alloc(16);
  set32(v2,0,10); set32(v2,4,20); set32(v2,8,30); set32(v2,12,40);
  set32(f2,0,1); set32(f2,4,2); set32(f2,8,3);
  let r2:i32=t2_asm_chain(W,v2,4,f2);
  let n2:i32=t2_sig_v2(W,r2,sig2);
  let v3:[]u8=z_alloc(24); let f3:[]u8=z_alloc(16);
  set32(v3,0,100); set32(v3,4,200); set32(v3,8,300);
  set32(f3,0,1); set32(f3,4,2);
  let r3:i32=t2_asm_chain(W,v3,3,f3);
  let n3:i32=t2_sig_v2(W,r3,sig3);
  let sv:[]u8=z_alloc(48);
  set32(sv,0,10); set32(sv,4,20);
  let r4:i32=t2_asm_sum(W,sv,2);
  let n4:i32=t2_sig_v2(W,r4,sig4);
  let ok_i:i32=0;
  if(n1!=n2){ ok_i=1; }
  else {
    let i:i32=0; let diff:i32=0;
    while(i<n1){ if(get32(sig1,i*4)!=get32(sig2,i*4)){diff=1;} i=i+1; }
    if(diff==1){ ok_i=1; }
  }
  let ok_ii:i32=0;
  if(n1==n3){
    let i:i32=0; let diff:i32=0;
    while(i<n1){ if(get32(sig1,i*4)!=get32(sig3,i*4)){diff=1;} i=i+1; }
    if(diff==0){ ok_ii=1; }
  }
  let ok_iii:i32=0;
  if(n1!=n4){ ok_iii=1; }
  else {
    let i:i32=0; let diff:i32=0;
    while(i<n1){ if(get32(sig1,i*4)!=get32(sig4,i*4)){diff=1;} i=i+1; }
    if(diff==1){ ok_iii=1; }
  }
  emit("CALIB i="); e64(ok_i); emit(" ii="); e64(ok_ii); emit(" iii="); e64(ok_iii);
  emit(" n1="); e64(n1); emit(" n2="); e64(n2); emit(" n3="); e64(n3); emit(" n4="); e64(n4);
  emit("\n");
  emit("SIG1 "); sig_emit(sig1,n1); emit("\n");
  emit("SIG2 "); sig_emit(sig2,n2); emit("\n");
  if(ok_i==1 && ok_ii==1 && ok_iii==1){ return 1; }
  return 0;
}

// ============ K-H2-3 white-box: causality, ablation, revisability ============
fn k3_whitebox()void {
  emit("K3-WHITEBOX-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  g2_teach_A(W);
  // (a) causality: scan for learner-created persistent state BEFORE the decision.
  let n:i32=2; let c20:i32=0;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20){ c20=c20+1; }
    n=n+1;
  }
  emit("K3-A pre tag20="); e64(c20); emit(" policy="); e64(ng(W,0,20));
  emit(" mp="); e64(ng(W,1,20)); emit("\n");
  if(hg(W,16)!=0){ emit("K3 VOID-hdr\n"); return; }
  let ans1:i32=ev_query(W,71001,71051,-2,1);
  let tr1:i32=hg(W,16)/1024;
  let m1:i32=find_map(W,71001,71051);
  emit("K3-A ans1="); e64(ans1); emit(" tried1="); e64(tr1);
  emit(" map="); e64(m1); emit("\n");
  // (b) ablation: zero the only learner-created persistent structures, re-run.
  zero_node(W,m1);
  let f1:i32=find_fact(W,71001,71051);
  zero_node(W,f1);
  emit("K3-B ablated map="); e64(m1); emit(" fact="); e64(f1); emit("\n");
  emit("K3-B snap policy="); e64(ng(W,0,20)); emit(" mp="); e64(ng(W,1,20));
  emit(" clock="); e64(hg(W,0)); emit(" h20="); e64(hg(W,20)); emit("\n");
  let ans2:i32=ev_query(W,71001,71051,-2,1);
  let tr2:i32=hg(W,16)/1024;
  emit("K3-B ans2="); e64(ans2); emit(" tried2="); e64(tr2); emit("\n");
  emit("K3-B snap2 policy="); e64(ng(W,0,20)); emit(" mp="); e64(ng(W,1,20));
  emit(" clock="); e64(hg(W,0)); emit(" h20="); e64(hg(W,20)); emit("\n");
  // (c) revisability: ans2 is a second false acceptance; clear fact, re-run.
  let f2:i32=find_fact(W,71001,71051);
  zero_node(W,f2);
  let ans3:i32=ev_query(W,71001,71051,-2,1);
  let tr3:i32=hg(W,16)/1024;
  emit("K3-C ans3="); e64(ans3); emit(" tried3="); e64(tr3); emit("\n");
  emit("K3-C snap3 policy="); e64(ng(W,0,20)); emit(" mp="); e64(ng(W,1,20));
  emit(" clock="); e64(hg(W,0)); emit(" h20="); e64(hg(W,20)); emit("\n");
  // Mechanical sub-clause flags: abl_flip=1 iff ablation flipped the decision.
  let abl_flip:i32=0;
  if(ans2!=ans1){ abl_flip=1; }
  emit("K3-FLAGS abl_flip="); e64(abl_flip); emit("\n");
  emit("K3-WHITEBOX-DONE\n");
  return;
}

// ============ K-H2-4 white-box: domain neutrality, reuse coupling ============
fn k4_whitebox()void {
  emit("K4-WHITEBOX-START\n");
  emit("K4-A verifier=t2_try_verify frozen-sha=a29972ca8183b2857c0c7b262d004fce6e4547c02a971a7aef035b44aa76a8bd\n");
  emit("K4-A one code path for chain/sum/count candidates; no per-family acceptance branches\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  g2_teach_A(W);
  if(hg(W,16)!=0){ emit("K4 VOID-hdr\n"); return; }
  // (b) reuse coupling: masked probe promotes a MAP; then a related
  // activate-missing query; then ablate the MAP and its root and re-run.
  let ans1:i32=ev_query(W,71001,71051,-2,1);
  let tr1:i32=hg(W,16)/1024;
  let m:i32=find_map(W,71001,71051);
  let rm:i32=-1; let am:i32=-2;
  if(m>=0){ rm=ng(W,m,20); am=ng(W,m,28); }
  emit("K4-B Q1 ans="); e64(ans1); emit(" tried="); e64(tr1);
  emit(" map="); e64(m); emit(" root="); e64(rm); emit(" mapans="); e64(am); emit("\n");
  let ans2:i32=ev_query(W,71011,71051,-2,1);
  let tr2:i32=hg(W,16)/1024;
  emit("K4-B Q2 ans="); e64(ans2); emit(" tried="); e64(tr2); emit("\n");
  zero_node(W,m);
  if(rm>=0){ ns(W,rm,0,0); }
  emit("K4-B ablated map and root\n");
  let ans3:i32=ev_query(W,71011,71051,-2,1);
  let tr3:i32=hg(W,16)/1024;
  emit("K4-B Q3 ans="); e64(ans3); emit(" tried="); e64(tr3); emit("\n");
  // Mechanical flag: reuse_inert=1 iff the MAP ablation changed nothing.
  let inert:i32=0;
  if(ans2==ans3 && tr2==tr3 && tr2>0){ inert=1; }
  emit("K4-FLAGS reuse_inert="); e64(inert); emit("\n");
  emit("K4-WHITEBOX-DONE\n");
  return;
}

// ============ Main battery ============
fn main()i32 {
  emit("H2V2-G2-EVAL-START\n");
  let cal:i32=h2_calibrate();
  if(cal!=1){
    emit("H2V2-G2-EVAL-VOID calibration failed\n");
    return 1;
  }
  emit("CALIBRATION-PASS\n");
  let t:[]u8=z_alloc(8);
  // K-H2-1: G2A and G2C, masked and unmasked controls.
  let a1m:i32=g2_probe(0,1,71001,71051,-2,1,t);
  let te1m:i32=get32(t,0);
  let a1u:i32=g2_probe(0,1,71001,71051,71013,0,t);
  let te1u:i32=get32(t,0);
  let a2m:i32=g2_probe(3,4,73001,73051,-2,1,t);
  let te2m:i32=get32(t,0);
  let a2u:i32=g2_probe(3,4,73001,73051,73013,0,t);
  let te2u:i32=get32(t,0);
  if(te1m!=1 || te1u!=1 || te2m!=1 || te2u!=1){
    emit("H2V2-G2-EVAL-VOID TRIAL_ENTERED failed K-H2-1\n");
    return 1;
  }
  emit("TRIAL-ENTERED-PASS K-H2-1\n");
  let k1:i32=0;
  if(a1m==71013 && a2m==73013){ k1=1; }
  let cu:i32=0;
  if(a1u==71013 && a2u==73013){ cu=1; }
  emit("K-H2-1 masked_correct="); e64(k1); emit(" unmasked_controls="); e64(cu); emit("\n");
  if(k1==1 && cu==1){ emit("K-H2-1 PASS\n"); } else { emit("K-H2-1 FAIL\n"); }
  // K-H2-2: B1 lie/control, B2 lie/control.
  let b1l:i32=g2_probe(1,2,72001,72051,72012,0,t);
  let teb1l:i32=get32(t,0);
  let b1c:i32=g2_probe(1,2,72001,72051,72003,0,t);
  let teb1c:i32=get32(t,0);
  let b2l:i32=b2_lie_probe(t);
  let teb2l:i32=get32(t,0);
  let keytr:i32=get32(t,4);
  let b2c:i32=g2_probe(2,3,72101,72151,72103,0,t);
  let teb2c:i32=get32(t,0);
  if(teb1l!=1 || teb1c!=1 || teb2l!=1 || teb2c!=1){
    emit("H2V2-G2-EVAL-VOID TRIAL_ENTERED failed K-H2-2\n");
    return 1;
  }
  emit("TRIAL-ENTERED-PASS K-H2-2\n");
  let k2b1:i32=0;
  if(b1l!=72012){ k2b1=1; }
  let k2c:i32=0;
  if(b1c==72003 && b2c==72103){ k2c=1; }
  emit("K-H2-2 B1_not_lie="); e64(k2b1); emit(" B2_key_trace="); e64(keytr);
  emit(" controls="); e64(k2c); emit(" B2_lie_ans="); e64(b2l); emit("\n");
  if(k2b1==1 && keytr==1 && k2c==1){ emit("K-H2-2 PASS\n"); } else { emit("K-H2-2 FAIL\n"); }
  // K-H2-3 and K-H2-4 white-box analyses.
  k3_whitebox();
  k4_whitebox();
  emit("H2V2-G2-EVAL-DONE\n");
  return 0;
}

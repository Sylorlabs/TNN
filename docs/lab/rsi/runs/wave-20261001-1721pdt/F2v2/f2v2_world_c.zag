// f2v2_world_c.zag -- Sealed World C: dual contextual delay (F2 v2).
// FRESH sealed physics; the F2 loop has never seen it. Concatenate AFTER
// f2v2_learner.zag.
// TRUE LAWS (sealed from learner): (X -> Y1, delay 2, context J == 0);
// (X -> Y2, delay 3, context K == 1). Under J == 1, X does nothing to Y1;
// under K == 0, X does nothing to Y2.
// Declared context variables: J, K (persistent per prereg section 4:
// they retain value across WAIT, change only via SET/CLR).
// The learner only sees the w_* interface. w_verify is harness adjudication.
// Goal mode 2 = C2 sustained dual contextual goal (prereg section 5).

fn w_goal_mode()i32 { return 2; }
fn w_nvars()i32 { return 5; }
fn w_nctrl()i32 { return 3; }
fn w_ctrl(i:i32)i32 {
  if(i==0){ return 0; } // X
  if(i==1){ return 3; } // J
  return 4;             // K
}
fn w_npass()i32 { return 14; }
fn w_nctx()i32 { return 5; }
fn w_ctx_cx(i:i32)i32 {
  if(i==0){ return 255; } // ALWAYS
  if(i==1){ return 3; }   // J
  if(i==2){ return 3; }   // J
  if(i==3){ return 4; }   // K
  return 4;               // K
}
fn w_ctx_cv(i:i32)i32 {
  if(i==0){ return 0; } // ALWAYS (cv unused)
  if(i==1){ return 0; } // J == 0
  if(i==2){ return 1; } // J == 1
  if(i==3){ return 0; } // K == 0
  return 1;             // K == 1
}
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Y1"; }
  if(v==2){ return "Y2"; }
  if(v==3){ return "J"; }
  return "K";
}
fn w_worldname()[]u8 { return "C-dual-contextual"; }
fn w_plan_maxd()i32 { return 9; }

fn C_truerules()[]u8 {
  let r:[]u8=z_alloc(10);
  r[0]=0; r[1]=1; r[2]=2; r[3]=3; r[4]=0; // X -> Y1 delay 2 iff J==0
  r[5]=0; r[6]=2; r[7]=3; r[8]=4; r[9]=1; // X -> Y2 delay 3 iff K==1
  return r;
}
fn C_cxs()[]u8 {
  let c:[]u8=z_alloc(5);
  c[0]=255; c[1]=3; c[2]=3; c[3]=4; c[4]=4;
  return c;
}

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (nvars*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+5*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    let hist:[]u8=ws[8..8+5*32];
    L_advance(hist,t,C_truerules(),2,5,C_cxs(),5);
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<5){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule (frozen): 14 steps, t = 0..13. Environment SETs X at
// t = 2, t = 6, t = 10. J = 0 and K = 1 throughout: the environment
// establishes K = 1 at t = 0 (K is persistent, so it is retained).
// Uses the world's own clock. Learner OBSERVEs all variables each step (free).
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==0){ ws[8+4*32+t]=1; }
  if(t==2 || t==6 || t==10){ ws[8+0*32+t]=1; }
  return;
}
// Goal C2 setup (disclosed): environment establishes J = 1;
// RESET to t = 0 (K = 0 by reset).
fn w_goal_setup(ws:[]u8)void {
  ws[8+3*32+0]=1;
  return;
}
// Unused for goal mode 2 (C2 uses the triple predicate in the learner).
fn w_goal_met(vals:[]u8)i32 { return 0; }

// Harness adjudication for K3-R4. Knows the sealed truth; the learner does not.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  // true candidate indices: Y1:(X,2,ctx J=0), Y2:(X,3,ctx K=1)
  let ty1:i32=-1; let ty2:i32=-1;
  let j:i32=0;
  while(j<36){
    let b:i32=(1*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==2 &&
       (candbuf[b+3] as i32)==3 && (candbuf[b+4] as i32)==0){ ty1=j; }
    j=j+1;
  }
  j=0;
  while(j<36){
    let b:i32=(2*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==3 &&
       (candbuf[b+3] as i32)==4 && (candbuf[b+4] as i32)==1){ ty2=j; }
    j=j+1;
  }
  // evars for World C: [X, Y1, Y2] (J, K persistent: no candidates)
  let true_h:i32=-1;
  let h:i32=0;
  while(h<nhyp){
    if((hysel[h*3+1] as i32)==ty1 && (hysel[h*3+2] as i32)==ty2){ true_h=h; }
    h=h+1;
  }
  emit("K3-R4 true_h="); e64(true_h);
  emit(" ty1="); e64(ty1); emit(" ty2="); e64(ty2);
  emit(" alive="); e64(alive[true_h]); emit(" nalive="); e64(nalive);
  emit(" exhausted="); e64(exhausted); emit("\n");
  // Expect: exactly one survivor, equal to the true law pair.
  if(true_h>=0 && alive[true_h]==1 && nalive==1){
    emit("K3-R4 PASS\n");
    return 1;
  }
  emit("K3-R4 FAIL\n");
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  if(m==63){ emit("F2V2_C PROGRAM_ALL_BARS_PASS\n"); return 0; }
  emit("F2V2_C PROGRAM_FAIL mask="); e64(m); emit("\n");
  return 1;
}

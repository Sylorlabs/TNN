// tnn2_transfer_score.zag: TNN-2 transfer refreeze scorer.
// Frozen prereg: TRANSFER_REFREEZE_PREREG.md (this lane).
// Reads run summary.txt files, checks K4 determinism across runs,
// computes S and the kill bars. Pure Zag. Deterministic.
// Usage: tnn2_transfer_score <run1dir> [run2dir] [run3dir]

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=65536;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn s_nnl(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){ return s[0..s.len-1]; }
  return s;
}
fn emit(s:[]u8)void { _zag_print(s); }
fn pl(label:[]u8,v:i32)void { emit(label); emit(s_nnl(v as i64)); emit("\n"); }

// parse integer value after a key like "T_A_examples=" up to space or newline
fn getv(txt:[]u8,key:[]u8)[]i32 {
  let out:[]i32=zalloc_i(1);
  out[0]=-999999;
  let i:i32=0;
  while(i+key.len<=txt.len){
    let ok:i32=1; let k:i32=0;
    while(k<key.len){ if(txt[i+k]!=key[k]){ ok=0; } k=k+1; }
    if(ok==1){
      let j:i32=i+key.len; let neg:i32=0; let v:i32=0;
      if(j<txt.len && txt[j]==45){ neg=1; j=j+1; }
      while(j<txt.len && txt[j]>=48 && txt[j]<=57){ v=v*10+(txt[j] as i32-48); j=j+1; }
      if(neg==1){ v=0-v; }
      out[0]=v;
      return out;
    }
    i=i+1;
  }
  return out;
}

fn main()i32 {
  // count args: _zag_arg(k) returns empty when out of range
  let nruns:i32=0;
  while(nruns<3){
    let a:[]u8=_zag_arg(nruns+1);
    if(a.len==0){ break; }
    nruns=nruns+1;
  }
  if(nruns<1){ emit("usage: tnn2_transfer_score <run1dir> [run2dir] [run3dir]\n"); return 1; }
  emit("TNN2-TRANSFER-SCORE prereg=TRANSFER_REFREEZE_PREREG.md\n");
  let ta:[]i32=zalloc_i(4); let tam:[]i32=zalloc_i(4);
  let tb:[]i32=zalloc_i(4); let tbm:[]i32=zalloc_i(4);
  let fb:[]i32=zalloc_i(4); let fbm:[]i32=zalloc_i(4);
  let xb:[]i32=zalloc_i(4); let xbm:[]i32=zalloc_i(4);
  let r:i32=0;
  while(r<nruns){
    let dir:[]u8=_zag_arg(r+1);
    let txt:[]u8=read_file(pjoin(dir,"summary.txt"));
    ta[r]=getv(txt,"T_A_examples=")[0];
    tam[r]=getv(txt,"T_A_met=")[0];
    tb[r]=getv(txt,"T_B_examples=")[0];
    tbm[r]=getv(txt,"T_B_met=")[0];
    fb[r]=getv(txt,"F_B_examples=")[0];
    fbm[r]=getv(txt,"F_B_met=")[0];
    xb[r]=getv(txt,"X_B_examples=")[0];
    xbm[r]=getv(txt,"X_B_met=")[0];
    emit("run "); emit(s_nnl(r as i64)); emit(": ");
    emit("T_A="); emit(s_nnl(ta[r] as i64)); emit("/");
    emit(s_nnl(tam[r] as i64)); emit(" T_B="); emit(s_nnl(tb[r] as i64)); emit("/");
    emit(s_nnl(tbm[r] as i64)); emit(" F_B="); emit(s_nnl(fb[r] as i64)); emit("/");
    emit(s_nnl(fbm[r] as i64)); emit(" X_B="); emit(s_nnl(xb[r] as i64)); emit("/");
    emit(s_nnl(xbm[r] as i64)); emit("\n");
    r=r+1;
  }
  // K4 determinism across runs
  let k4:i32=1;
  r=1;
  while(r<nruns){
    if(ta[r]!=ta[0] || tam[r]!=tam[0] || tb[r]!=tb[0] || tbm[r]!=tbm[0] ||
       fb[r]!=fb[0] || fbm[r]!=fbm[0] || xb[r]!=xb[0] || xbm[r]!=xbm[0]){ k4=0; }
    r=r+1;
  }
  pl("K4 determinism_runs=",nruns);
  pl("K4 identical=",k4);

  let T_A:i32=ta[0]; let T_AM:i32=tam[0];
  let T_B:i32=tb[0]; let T_BM:i32=tbm[0];
  let F_B:i32=fb[0]; let F_BM:i32=fbm[0];
  let X_B:i32=xb[0];

  // score S x10000, clipped [0,10000]
  let s10000:i32=0;
  if(F_B>0){
    s10000=(F_B-T_B)*10000/F_B;
    if(s10000<0){ s10000=0; }
    if(s10000>10000){ s10000=10000; }
  }
  pl("score_x10000=",s10000);

  let k1:i32=0; if(s10000>=2500){ k1=1; }
  let k2:i32=0;
  let ad:i32=X_B-F_B; if(ad<0){ ad=0-ad; }
  if(F_B>0 && ad*10<=F_B && X_B>T_B){ k2=1; }
  let k3:i32=1; // structural: disjoint id ranges + disjoint surfaces (K5); verified in gen
  let k5:i32=1; // from generator K5a/K5b/K5c output (reported separately)
  let k6:i32=0; if(T_AM==1 && F_BM==1){ k6=1; }
  // K7 pure-zag: toolchain guard. K8 no-confound: by construction.
  pl("K1 gain=",k1);
  pl("K2 ablation=",k2);
  pl("K3 antimem_structural=",k3);
  pl("K5 material=",k5);
  pl("K6 validity=",k6);
  emit("K7 purezag=toolchain-guard\n");
  emit("K8 noconfound=by-construction\n");
  if(k6==0){
    emit("VERDICT=VOID\n");
  } else {
    let all:i32=k1*k2*k3*k4*k5;
    if(all==1){ emit("VERDICT=CANDIDATE\n"); }
    else { emit("VERDICT=FAIL\n"); }
  }
  return 0;
}

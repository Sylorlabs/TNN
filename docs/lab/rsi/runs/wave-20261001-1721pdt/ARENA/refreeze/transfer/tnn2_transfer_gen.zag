// tnn2_transfer_gen.zag: TNN-2 transfer refreeze world generator.
// Frozen prereg: TRANSFER_REFREEZE_PREREG.md (this lane).
// Generates OBSERVE/QUERY world files for conditions T/F/X and runs
// the K5 material-difference / scramble-validity checks in-run.
// Pure Zag. Deterministic: zero randomness; all world data fixed.
// Usage: tnn2_transfer_gen <outdir>

// ---------- low-level helpers (pattern from competitive_arena/world_gen.zag) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn s_nnl(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){ return s[0..s.len-1]; }
  return s;
}
fn emit(s:[]u8)void { _zag_print(s); }

// ---------- world model ----------
const P1:i32=11;
const NEXT:i32=20;
const AT_N:i32=24;
const AH_N:i32=12;
const BT_N:i32=24;
const BH_N:i32=12;
const SEQ_MAX:i32=7;

fn gen_arith(start:i32,c:i32,len:i32,out:[]i32)void {
  let i:i32=0;
  while(i<len){ out[i]=start+i*c; i=i+1; }
}
fn gen_geom(start:i32,r:i32,len:i32,out:[]i32)void {
  let i:i32=0; let v:i32=start;
  while(i<len){ out[i]=v; v=v*r; i=i+1; }
}
// fixed deterministic scramble: p(i) = (3*i+1) mod L
fn scramble(src:[]i32,len:i32,dst:[]i32)void {
  let i:i32=0;
  while(i<len){ dst[i]=src[(3*i+1)%len]; i=i+1; }
}

// ---------- surface codec (briefing interface machinery; K5a only) ----------
fn enc_push(v:i32,buf:[]i32,at:i32)i32 {
  let n:i32=1;
  if(v>26 && v<=702){ n=2; }
  if(v>702){ n=3; }
  let x:i32=v; let i:i32=n;
  while(i>0){ i=i-1; let d:i32=(x-1)%26; buf[at+i]=65+d; x=(x-1)/26; }
  return at+n;
}
fn b_raw_build(v:[]i32,len:i32,buf:[]i32)i32 {
  let at:i32=0; let i:i32=0;
  while(i<len){
    if(i>0){ buf[at]=32; at=at+1; }
    at=enc_push(v[i],buf,at); i=i+1;
  }
  return at;
}
fn a_raw_build(v:[]i32,len:i32,buf:[]i32)i32 {
  let at:i32=0; let i:i32=0;
  while(i<len){
    if(i>0){ buf[at]=32; at=at+1; }
    let s:[]u8=s_nnl(v[i] as i64);
    let k:i32=0;
    while(k<s.len){ buf[at]=s[k] as i32; at=at+1; k=k+1; }
    i=i+1;
  }
  return at;
}

// ---------- law checks (K5b/K5c) ----------
fn diffs_constant(v:[]i32,len:i32)i32 {
  let c:i32=v[1]-v[0]; let i:i32=1;
  while(i<len-1){ if(v[i+1]-v[i]!=c){ return 0; } i=i+1; }
  return 1;
}
fn ratios_constant(v:[]i32,len:i32)i32 {
  if(v[0]==0){ return 0; }
  let q:i32=v[1]/v[0];
  if(v[1]-q*v[0]!=0){ return 0; }
  let i:i32=1;
  while(i<len-1){
    if(v[i]==0){ return 0; }
    if(v[i+1]!=v[i]*q){ return 0; }
    i=i+1;
  }
  return 1;
}

// ---------- world params (identical to PREREG_TRANSFER.md / transfer_eval.zag) ----------
fn load_a(as_:[]i32,ac:[]i32,al:[]i32)void {
  as_[0]=3; ac[0]=3; al[0]=5;
  as_[1]=14; ac[1]=3; al[1]=6;
  as_[2]=-5; ac[2]=3; al[2]=7;
  as_[3]=22; ac[3]=3; al[3]=5;
  as_[4]=40; ac[4]=3; al[4]=6;
  as_[5]=2; ac[5]=7; al[5]=5;
  as_[6]=-11; ac[6]=7; al[6]=6;
  as_[7]=30; ac[7]=7; al[7]=7;
  as_[8]=8; ac[8]=7; al[8]=5;
  as_[9]=20; ac[9]=-4; al[9]=5;
  as_[10]=5; ac[10]=-4; al[10]=6;
  as_[11]=-3; ac[11]=-4; al[11]=7;
  as_[12]=33; ac[12]=-4; al[12]=5;
  as_[13]=1; ac[13]=12; al[13]=5;
  as_[14]=-20; ac[14]=12; al[14]=6;
  as_[15]=15; ac[15]=12; al[15]=7;
  as_[16]=50; ac[16]=-9; al[16]=5;
  as_[17]=12; ac[17]=-9; al[17]=6;
  as_[18]=-15; ac[18]=-9; al[18]=7;
  as_[19]=7; ac[19]=5; al[19]=5;
  as_[20]=-8; ac[20]=5; al[20]=6;
  as_[21]=19; ac[21]=5; al[21]=7;
  as_[22]=26; ac[22]=5; al[22]=5;
  as_[23]=13; ac[23]=5; al[23]=6;
}
fn load_ah(ahs:[]i32,ahc:[]i32,ahl:[]i32)void {
  ahs[0]=100; ahc[0]=3; ahl[0]=5;
  ahs[1]=-30; ahc[1]=3; ahl[1]=6;
  ahs[2]=45; ahc[2]=7; ahl[2]=5;
  ahs[3]=-25; ahc[3]=7; ahl[3]=6;
  ahs[4]=60; ahc[4]=-4; ahl[4]=5;
  ahs[5]=-40; ahc[5]=-4; ahl[5]=6;
  ahs[6]=70; ahc[6]=12; ahl[6]=5;
  ahs[7]=-50; ahc[7]=12; ahl[7]=6;
  ahs[8]=90; ahc[8]=-9; ahl[8]=5;
  ahs[9]=-60; ahc[9]=-9; ahl[9]=6;
  ahs[10]=55; ahc[10]=5; ahl[10]=5;
  ahs[11]=-35; ahc[11]=5; ahl[11]=6;
}
fn load_b(bs:[]i32,br:[]i32,bl:[]i32)void {
  let i:i32=0;
  while(i<11){ bs[i]=2+i; br[i]=2; bl[i]=5; i=i+1; }
  while(i<16){ bs[i]=2+(i-11); br[i]=2; bl[i]=6; i=i+1; }
  while(i<23){ bs[i]=2+(i-16); br[i]=3; bl[i]=5; i=i+1; }
  bs[23]=2; br[23]=3; bl[23]=6;
}
fn load_bh(bhs:[]i32,bhr:[]i32,bhl:[]i32)void {
  let i:i32=0;
  while(i<6){ bhs[i]=13+i; bhr[i]=2; bhl[i]=5; i=i+1; }
  while(i<8){ bhs[i]=7+(i-6); bhr[i]=2; bhl[i]=6; i=i+1; }
  while(i<11){ bhs[i]=9+(i-8); bhr[i]=3; bhl[i]=5; i=i+1; }
  bhs[11]=3; bhr[11]=3; bhl[11]=6;
}

// ---------- step file writer ----------
// Writes <outdir>/<tag>.txt with OBSERVE/QUERY lines for one sequence.
// terms[0..L-1]; target = terms[L-1]; teach=1 appends the teaching OBSERVE.
fn write_step(outdir:[]u8,tag:[]u8,seqid:i32,terms:[]i32,L:i32,teach:i32)void {
  let name:[]u8=z_alloc(tag.len+4);
  let at:i32=app(name,0,tag);
  at=app(name,at,".txt");
  let path:[]u8=pjoin(outdir,name[0..at]);
  let fd:i64=w_open(path);
  let buf:[]u8=z_alloc(512);
  let n:i32=0;
  let k:i32=0;
  while(k<L-1){
    n=app(buf,n,"OBSERVE ");
    n=app(buf,n,s_nnl(seqid as i64));
    n=app(buf,n," ");
    n=app(buf,n,s_nnl((P1+k) as i64));
    n=app(buf,n," ");
    n=app(buf,n,s_nnl(terms[k] as i64));
    n=app(buf,n,"\n");
    k=k+1;
  }
  n=app(buf,n,"QUERY ");
  n=app(buf,n,s_nnl(seqid as i64));
  n=app(buf,n," ");
  n=app(buf,n,s_nnl(NEXT as i64));
  n=app(buf,n," ");
  n=app(buf,n,s_nnl(terms[L-1] as i64));
  n=app(buf,n,"\n");
  if(teach==1){
    n=app(buf,n,"OBSERVE ");
    n=app(buf,n,s_nnl(seqid as i64));
    n=app(buf,n," ");
    n=app(buf,n,s_nnl(NEXT as i64));
    n=app(buf,n," ");
    n=app(buf,n,s_nnl(terms[L-1] as i64));
    n=app(buf,n,"\n");
  }
  w_write(fd,buf[0..n]);
  w_close(fd);
  z_free(name); z_free(buf); z_free(path);
}
fn mktag(cond:[]u8,phase:[]u8,kind:[]u8,idx:i32)[]u8 {
  let t:[]u8=z_alloc(64);
  let at:i32=app(t,0,cond);
  at=app(t,at,"_");
  at=app(t,at,phase);
  at=app(t,at,"_");
  at=app(t,at,kind);
  at=app(t,at,"_");
  at=app(t,at,s_nnl(idx as i64));
  return t[0..at];
}
fn pl(label:[]u8,v:i32)void {
  emit(label); emit(s_nnl(v as i64)); emit("\n");
}

fn main()i32 {
  let outdir:[]u8=_zag_arg(1);
  if(outdir.len==0){ emit("usage: tnn2_transfer_gen <outdir>\n"); return 1; }

  let as_:[]i32=zalloc_i(AT_N); let ac:[]i32=zalloc_i(AT_N); let al:[]i32=zalloc_i(AT_N);
  let ahs:[]i32=zalloc_i(AH_N); let ahc:[]i32=zalloc_i(AH_N); let ahl:[]i32=zalloc_i(AH_N);
  let bs:[]i32=zalloc_i(BT_N); let br:[]i32=zalloc_i(BT_N); let bl:[]i32=zalloc_i(BT_N);
  let bhs:[]i32=zalloc_i(BH_N); let bhr:[]i32=zalloc_i(BH_N); let bhl:[]i32=zalloc_i(BH_N);
  load_a(as_,ac,al); load_ah(ahs,ahc,ahl); load_b(bs,br,bl); load_bh(bhs,bhr,bhl);

  let seq:[]i32=zalloc_i(SEQ_MAX);
  let scr:[]i32=zalloc_i(SEQ_MAX);
  let raw:[]i32=zalloc_i(128);
  let i:i32=0;

  // ----- T condition: A train + A held (criterion), B train + B held (criterion) -----
  i=0;
  while(i<AT_N){
    gen_arith(as_[i],ac[i],al[i],seq);
    let tag:[]u8=mktag("T","A","train",i);
    write_step(outdir,tag,1001+i,seq,al[i],1);
    i=i+1;
  }
  i=0;
  while(i<AH_N){
    gen_arith(ahs[i],ahc[i],ahl[i],seq);
    let tag:[]u8=mktag("T","A","held",i);
    write_step(outdir,tag,1101+i,seq,ahl[i],0);
    i=i+1;
  }
  i=0;
  while(i<BT_N){
    gen_geom(bs[i],br[i],bl[i],seq);
    let tag:[]u8=mktag("T","B","train",i);
    write_step(outdir,tag,2001+i,seq,bl[i],1);
    i=i+1;
  }
  i=0;
  while(i<BH_N){
    gen_geom(bhs[i],bhr[i],bhl[i],seq);
    let tag:[]u8=mktag("T","B","held",i);
    write_step(outdir,tag,2101+i,seq,bhl[i],0);
    i=i+1;
  }
  // ----- F condition: B train + B held -----
  i=0;
  while(i<BT_N){
    gen_geom(bs[i],br[i],bl[i],seq);
    let tag:[]u8=mktag("F","B","train",i);
    write_step(outdir,tag,2001+i,seq,bl[i],1);
    i=i+1;
  }
  i=0;
  while(i<BH_N){
    gen_geom(bhs[i],bhr[i],bhl[i],seq);
    let tag:[]u8=mktag("F","B","held",i);
    write_step(outdir,tag,2101+i,seq,bhl[i],0);
    i=i+1;
  }
  // ----- X condition: scrambled A train (exposure), B train + B held (criterion) -----
  i=0;
  while(i<AT_N){
    gen_arith(as_[i],ac[i],al[i],seq);
    scramble(seq,al[i],scr);
    let tag:[]u8=mktag("X","A","train",i);
    write_step(outdir,tag,3001+i,scr,al[i],1);
    i=i+1;
  }
  i=0;
  while(i<BT_N){
    gen_geom(bs[i],br[i],bl[i],seq);
    let tag:[]u8=mktag("X","B","train",i);
    write_step(outdir,tag,2001+i,seq,bl[i],1);
    i=i+1;
  }
  i=0;
  while(i<BH_N){
    gen_geom(bhs[i],bhr[i],bhl[i],seq);
    let tag:[]u8=mktag("X","B","held",i);
    write_step(outdir,tag,2101+i,seq,bhl[i],0);
    i=i+1;
  }

  // ----- K5a: surface classes disjoint (digits/- vs letters) -----
  let k5a:i32=1;
  i=0;
  while(i<AT_N){
    gen_arith(as_[i],ac[i],al[i],seq);
    let nb:i32=a_raw_build(seq,al[i],raw);
    let k:i32=0;
    while(k<nb){
      let ch:i32=raw[k]; let ok:i32=0;
      if(ch==32){ ok=1; }
      if(ch==45){ ok=1; }
      if(ch>=48 && ch<=57){ ok=1; }
      if(ok==0){ k5a=0; }
      k=k+1;
    }
    i=i+1;
  }
  i=0;
  while(i<BT_N){
    gen_geom(bs[i],br[i],bl[i],seq);
    let nb:i32=b_raw_build(seq,bl[i],raw);
    let k:i32=0;
    while(k<nb){
      let ch:i32=raw[k]; let ok:i32=0;
      if(ch==32){ ok=1; }
      if(ch>=65 && ch<=90){ ok=1; }
      if(ok==0){ k5a=0; }
      k=k+1;
    }
    i=i+1;
  }
  pl("K5a surface_class_disjoint=",k5a);

  // ----- K5b: law families mutually rejected -----
  let rejAonB:i32=0;
  i=0;
  while(i<BT_N){
    gen_geom(bs[i],br[i],bl[i],seq);
    if(diffs_constant(seq,bl[i])==0){ rejAonB=rejAonB+1; }
    i=i+1;
  }
  i=0;
  while(i<BH_N){
    gen_geom(bhs[i],bhr[i],bhl[i],seq);
    if(diffs_constant(seq,bhl[i])==0){ rejAonB=rejAonB+1; }
    i=i+1;
  }
  let rejBonA:i32=0;
  i=0;
  while(i<AT_N){
    gen_arith(as_[i],ac[i],al[i],seq);
    if(ratios_constant(seq,al[i])==0){ rejBonA=rejBonA+1; }
    i=i+1;
  }
  i=0;
  while(i<AH_N){
    gen_arith(ahs[i],ahc[i],ahl[i],seq);
    if(ratios_constant(seq,ahl[i])==0){ rejBonA=rejBonA+1; }
    i=i+1;
  }
  pl("K5b Alaw_reject_on_B=",rejAonB);
  pl("K5b Blaw_reject_on_A=",rejBonA);

  // ----- K5c: scramble destroys the A law -----
  let rejScr:i32=0;
  i=0;
  while(i<AT_N){
    gen_arith(as_[i],ac[i],al[i],seq);
    scramble(seq,al[i],scr);
    if(diffs_constant(scr,al[i])==0){ rejScr=rejScr+1; }
    i=i+1;
  }
  pl("K5c Alaw_reject_on_scrambled=",rejScr);
  pl("K5c scrambled_n=",AT_N);

  emit("GEN_DONE\n");
  return 0;
}

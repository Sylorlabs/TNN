// ==== CY_FRAG.zag: H5R3 sealed-world driver (post-freeze evaluation scaffolding) ====
// Appended to a byte-copy of the frozen H5R2 substrate tnn3_h5r3_substrate.zag
// with the single line `fn main()i32 { return run_all(); }` changed to
// `fn main()i32 { return sealed_main(); }`, plus one alias line
// `fn sealed_main()i32 { return sealed_main_yX(); }` selecting the world.
// Implements the frozen marker contract of PREREG_H5R3.md section 4.6.
// No cognition code: probes, markers, white-box dumps only.
// Output discipline (pinned znc defect): ONE preallocated buffer, cursor
// helpers, single _zag_raw_syscall write per world. No _zag_print use.
// cfg layout (i32 slots): 0:a 4:b 8:rf1 12:rf2 16:rm 20:c0 24:c1 28:c2

// ---- safe output helpers (new names; substrate emit/e64 NOT redefined) ----
fn cy_putc(b:[]u8,cur:i32,c:i32)i32 { b[cur]=c as u8; return cur+1; }
fn cy_s(b:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){b[cur+i]=s[i]; i=i+1;}
  return cur+s.len;
}
fn cy_i(b:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){neg=1; x=0-x;}
  let nd:i32=1; let t:i64=x;
  while(t>=10){t=t/10; nd=nd+1;}
  let k:i32=0;
  while(k<nd){
    let d:i32=(x%10) as i32;
    b[cur+neg+nd-1-k]=(48+d) as u8;
    x=x/10; k=k+1;
  }
  if(neg==1){b[cur]=45;}
  return cur+neg+nd;
}
fn cy_es(cc:[]u8,ob:[]u8,s:[]u8)void { set32(cc,0,cy_s(ob,get32(cc,0),s)); return; }
fn cy_ei(cc:[]u8,ob:[]u8,v:i32)void { set32(cc,0,cy_i(ob,get32(cc,0),v as i64)); return; }
fn cy_en(cc:[]u8,ob:[]u8)void { set32(cc,0,cy_putc(ob,get32(cc,0),10)); return; }
fn cy_flush(cc:[]u8,ob:[]u8)void {
  let len:i32=get32(cc,0);
  _zag_raw_syscall(1,1,(_zag_slice_ptr(ob) as i64),(len as i64),0,0,0);
  return;
}

// ---- white-box counters ----
fn cy_t1_live(W:[]u8,sm:i32,rm:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==sm && ng(W,n,24)==rm && is_superseded(W,n)==0){c=c+1;}
    n=n+1;
  }
  return c;
}
fn cy_map_live_n(W:[]u8,sm:i32,rm:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==sm && ng(W,n,4)==rm && is_superseded(W,n)==0){c=c+1;}
    n=n+1;
  }
  return c;
}
fn cy_map_live_id(W:[]u8,sm:i32,rm:i32)i32 {
  let id:i32=-1; let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==sm && ng(W,n,4)==rm && is_superseded(W,n)==0){id=n; c=c+1;}
    n=n+1;
  }
  if(c!=1){return -1;}
  return id;
}
fn cy_map_sup_n(W:[]u8,sm:i32,rm:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==sm && ng(W,n,4)==rm && is_superseded(W,n)==1){c=c+1;}
    n=n+1;
  }
  return c;
}
// MAP-key probe with the KB-W0 protocol. previd: max MAP id on the key so
// far in this probe (-1 on first). Returns the live MAP id on pass, -1 on
// any failure.
fn cy_probe(W:[]u8,cc:[]u8,ob:[]u8,sm:i32,rm:i32,exp:i32,tag:[]u8,pn:[]u8,previd:i32)i32 {
  let ok:i32=1;
  let t1in:i32=cy_t1_live(W,sm,rm);
  let lmin:i32=cy_map_live_n(W,sm,rm);
  let lmid:i32=cy_map_live_id(W,sm,rm);
  let f28in:i32=-999999;
  if(lmid>=0){f28in=ng(W,lmid,28);}
  cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pn);
  cy_es(cc,ob," SNAP-IN t1live="); cy_ei(cc,ob,t1in);
  cy_es(cc,ob," livemap="); cy_ei(cc,ob,lmin);
  cy_es(cc,ob," f28="); cy_ei(cc,ob,f28in); cy_en(cc,ob);
  if(t1in!=0){cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pn); cy_es(cc,ob," W0-IN-FAIL"); cy_en(cc,ob); ok=0;}
  let v:i32=ev_query(W,sm,rm,exp,0);
  let mc:i32=cy_map_live_n(W,sm,rm);
  let id:i32=cy_map_live_id(W,sm,rm);
  let f28:i32=-999999;
  if(id>=0){f28=ng(W,id,28);}
  cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pn);
  cy_es(cc,ob," Q exp="); cy_ei(cc,ob,exp);
  cy_es(cc,ob," ret="); cy_ei(cc,ob,v);
  cy_es(cc,ob," id="); cy_ei(cc,ob,id);
  cy_es(cc,ob," livemap="); cy_ei(cc,ob,mc);
  cy_es(cc,ob," f28="); cy_ei(cc,ob,f28); cy_en(cc,ob);
  if(v!=exp){cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pn); cy_es(cc,ob," VAL-FAIL"); cy_en(cc,ob); ok=0;}
  if(mc!=1 || f28!=v){cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pn); cy_es(cc,ob," W0-OUT-FAIL"); cy_en(cc,ob); ok=0;}
  let fresh:i32=0;
  if(id>previd){fresh=1;} else {ok=0;}
  cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pn);
  cy_es(cc,ob," FRESH prev="); cy_ei(cc,ob,previd);
  cy_es(cc,ob," cur="); cy_ei(cc,ob,id);
  cy_es(cc,ob," ok="); cy_ei(cc,ob,fresh); cy_en(cc,ob);
  if(fresh==0){cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pn); cy_es(cc,ob," FRESH-FAIL"); cy_en(cc,ob);}
  if(ok==1){return id;}
  return -1;
}
// final dump per probe (PREREG 4.6): per tag-20 MAP on (sm,rm): id, f28,
// CON self-edge 1/0, live 1/0; per DEP (type-1) edge of the live MAP:
// target id, target tag, target superseded bit. Returns 1 iff exactly
// nsup_exp superseded MAPs all carrying CON, exactly 1 live MAP with
// f28==fexp, and every DEP edge of the live MAP targets a live tag-1
// non-superseded fact.
fn cy_wdump(W:[]u8,cc:[]u8,ob:[]u8,sm:i32,rm:i32,fexp:i32,nsup_exp:i32,tag:[]u8,pid:[]u8)i32 {
  let ok:i32=1;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==sm && ng(W,n,4)==rm){
      let con:i32=is_superseded(W,n);
      let live:i32=0;
      if(con==0){live=1;}
      cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pid);
      cy_es(cc,ob," MAP id="); cy_ei(cc,ob,n);
      cy_es(cc,ob," f28="); cy_ei(cc,ob,ng(W,n,28));
      cy_es(cc,ob," con="); cy_ei(cc,ob,con);
      cy_es(cc,ob," live="); cy_ei(cc,ob,live); cy_en(cc,ob);
    }
    n=n+1;
  }
  let sup:i32=cy_map_sup_n(W,sm,rm);
  let id:i32=cy_map_live_id(W,sm,rm);
  if(sup!=nsup_exp){cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pid); cy_es(cc,ob," DUMP-SUP-FAIL"); cy_en(cc,ob); ok=0;}
  if(id<0){cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pid); cy_es(cc,ob," DUMP-LIVE-FAIL"); cy_en(cc,ob); ok=0;}
  if(id>=0){
    if(ng(W,id,28)!=fexp){cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pid); cy_es(cc,ob," DUMP-F28-FAIL"); cy_en(cc,ob); ok=0;}
    let e:i32=0; let dep:i32=0; let depok:i32=1;
    while(e<4096){
      if(eg(W,e,0)!=-1 && eg(W,e,0)==id && eg(W,e,4)==1){
        dep=dep+1;
        let t:i32=eg(W,e,8);
        cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pid);
        cy_es(cc,ob," DEP tgt="); cy_ei(cc,ob,t);
        cy_es(cc,ob," tag="); cy_ei(cc,ob,ng(W,t,0));
        cy_es(cc,ob," sup="); cy_ei(cc,ob,is_superseded(W,t)); cy_en(cc,ob);
        if(ng(W,t,36)!=1 || ng(W,t,0)!=1 || is_superseded(W,t)==1){depok=0;}
      }
      e=e+1;
    }
    if(dep<1 || depok==0){cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pid); cy_es(cc,ob," DUMP-DEP-FAIL"); cy_en(cc,ob); ok=0;}
  }
  // selectivity record: CON-carrying MAP count on this probe's key
  cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pid);
  cy_es(cc,ob," SELC con="); cy_ei(cc,ob,sup); cy_en(cc,ob);
  if(ok==1){cy_es(cc,ob,tag); cy_es(cc,ob," "); cy_es(cc,ob,pid); cy_es(cc,ob," DUMP ok"); cy_en(cc,ob);}
  return ok;
}
// cycle probe pattern (PREREG 4.3). Fresh workspace per probe (capacity plan).
fn cy_cycle(cc:[]u8,ob:[]u8,cfg:[]u8,tag:[]u8,pid:[]u8)i32 {
  let ok:i32=1;
  let a:i32=get32(cfg,0); let b:i32=get32(cfg,4);
  let rf1:i32=get32(cfg,8); let rf2:i32=get32(cfg,12); let rm:i32=get32(cfg,16);
  let c0:i32=get32(cfg,20); let c1:i32=get32(cfg,24); let c2:i32=get32(cfg,28);
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  ev_teach(W,a,rf1,b); ev_teach(W,b,rf2,c0);
  let id0:i32=cy_probe(W,cc,ob,a,rm,c0,tag,pid,-1);
  if(id0<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  let id1:i32=cy_probe(W,cc,ob,a,rm,c1,tag,pid,id0);
  if(id1<0){ok=0;}
  ev_observe(W,b,rf2,c0);
  let id2:i32=cy_probe(W,cc,ob,a,rm,c0,tag,pid,id1);
  if(id2<0){ok=0;}
  ev_observe(W,b,rf2,c2);
  let id3:i32=cy_probe(W,cc,ob,a,rm,c2,tag,pid,id2);
  if(id3<0){ok=0;}
  if(cy_wdump(W,cc,ob,a,rm,c2,3,tag,pid)==0){ok=0;}
  return ok;
}
// revert-after-revert probe pattern (PREREG 4.4). Fresh workspace per probe.
fn cy_rr(cc:[]u8,ob:[]u8,cfg:[]u8,tag:[]u8,pid:[]u8)i32 {
  let ok:i32=1;
  let a:i32=get32(cfg,0); let b:i32=get32(cfg,4);
  let rf1:i32=get32(cfg,8); let rf2:i32=get32(cfg,12); let rm:i32=get32(cfg,16);
  let c0:i32=get32(cfg,20); let c1:i32=get32(cfg,24);
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  ev_teach(W,a,rf1,b); ev_teach(W,b,rf2,c0);
  let id0:i32=cy_probe(W,cc,ob,a,rm,c0,tag,pid,-1);
  if(id0<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  let id1:i32=cy_probe(W,cc,ob,a,rm,c1,tag,pid,id0);
  if(id1<0){ok=0;}
  ev_observe(W,b,rf2,c0);
  let id2:i32=cy_probe(W,cc,ob,a,rm,c0,tag,pid,id1);
  if(id2<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  let id3:i32=cy_probe(W,cc,ob,a,rm,c1,tag,pid,id2);
  if(id3<0){ok=0;}
  if(cy_wdump(W,cc,ob,a,rm,c1,3,tag,pid)==0){ok=0;}
  return ok;
}
fn cy_cfg(a:i32,b:i32,rf1:i32,rf2:i32,rm:i32,c0:i32,c1:i32,c2:i32)[]u8 {
  let cfg:[]u8=z_alloc(32);
  set32(cfg,0,a); set32(cfg,4,b); set32(cfg,8,rf1); set32(cfg,12,rf2);
  set32(cfg,16,rm); set32(cfg,20,c0); set32(cfg,24,c1); set32(cfg,28,c2);
  return cfg;
}
// world w_y1 (PREREG 4.2): RF1=9501 RF2=9502 RM=9503, vo1=4.
fn sealed_main_y1()i32 {
  let ob:[]u8=z_alloc(262144);
  let cc:[]u8=z_alloc(8); set32(cc,0,0);
  let ok:i32=1;
  if(cy_cycle(cc,ob,cy_cfg(95101,95201,9501,9502,9503,95305,95306,95307),"Y1","C1")==0){ok=0;}
  if(cy_cycle(cc,ob,cy_cfg(95102,95202,9501,9502,9503,95315,95316,95317),"Y1","C2")==0){ok=0;}
  if(cy_cycle(cc,ob,cy_cfg(95103,95203,9501,9502,9503,95325,95326,95327),"Y1","C3")==0){ok=0;}
  if(cy_rr(cc,ob,cy_cfg(95104,95204,9501,9502,9503,95335,95336,0),"Y1","RR")==0){ok=0;}
  cy_es(cc,ob,"Y1 DONE ok="); cy_ei(cc,ob,ok); cy_en(cc,ob);
  cy_flush(cc,ob);
  return ok;
}
// world w_y2 (PREREG 4.2): RF1=9601 RF2=9602 RM=9603, vo2=2.
fn sealed_main_y2()i32 {
  let ob:[]u8=z_alloc(262144);
  let cc:[]u8=z_alloc(8); set32(cc,0,0);
  let ok:i32=1;
  if(cy_cycle(cc,ob,cy_cfg(96101,96201,9601,9602,9603,96303,96304,96305),"Y2","C1")==0){ok=0;}
  if(cy_cycle(cc,ob,cy_cfg(96102,96202,9601,9602,9603,96313,96314,96315),"Y2","C2")==0){ok=0;}
  if(cy_cycle(cc,ob,cy_cfg(96103,96203,9601,9602,9603,96323,96324,96325),"Y2","C3")==0){ok=0;}
  if(cy_rr(cc,ob,cy_cfg(96104,96204,9601,9602,9603,96333,96334,0),"Y2","RR")==0){ok=0;}
  cy_es(cc,ob,"Y2 DONE ok="); cy_ei(cc,ob,ok); cy_en(cc,ob);
  cy_flush(cc,ob);
  return ok;
}

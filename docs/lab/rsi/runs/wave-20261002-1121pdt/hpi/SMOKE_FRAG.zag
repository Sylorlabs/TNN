// SMOKE_FRAG.zag: builder smoke self-check on UNSEALED keys (9xxx only).
// One cycle probe reusing CY_FRAG scaffolding; never touches sealed ranges.
fn sealed_main_smoke()i32 {
  let ob:[]u8=z_alloc(262144);
  let cc:[]u8=z_alloc(8); set32(cc,0,0);
  let ok:i32=cy_cycle(cc,ob,cy_cfg(91101,91201,9101,9102,9103,91305,91306,91307),"SM","C1");
  cy_es(cc,ob,"SM DONE ok="); cy_ei(cc,ob,ok); cy_en(cc,ob);
  cy_flush(cc,ob);
  return ok;
}

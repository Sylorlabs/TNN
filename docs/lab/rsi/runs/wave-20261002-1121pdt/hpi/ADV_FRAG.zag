// ADV_FRAG.zag: POST-FREEZE adversarial red-team family for H5R3.
// Designed after the prereg freeze (2026-10-02 12:08 PDT lane run) to attack
// the "live revision chain" claim beyond the prereg's battery:
//   ADV-A (snapshot probe): after a full cycle, contradict with a NOVEL value
//     never taught before, then with a historical non-predecessor value.
//     A stored snapshot cannot derive the novel value; a live chain re-derives.
//   ADV-B (adversarial order): two contradictions back-to-back with no
//     intervening query, so the intermediate dead fact never licensed a MAP.
//   ADV-C (chain-link contradiction): contradict the CHAIN fact (not the
//     value fact); the live MAP must die via its chain DEP link and the next
//     MAP must anchor to the NEW chain fact, not the dead one.
// Key range 99xxx: disjoint from sealed (95xxx-98xxx), smoke (9xxx), and all
// historical ranges. Fresh W per probe. RED TEAM ONLY: not kill bars;
// failures are informative negative evidence about the broader claim.
// Evaluation scaffolding only; no cognition code.

// ADV-A: snapshot probe. Novel value c9 then historical c1.
fn adv_snapshot(cc:[]u8,ob:[]u8)i32 {
  let ok:i32=1;
  let a:i32=99101; let b:i32=99201;
  let rf1:i32=9901; let rf2:i32=9902; let rm:i32=9903;
  let c0:i32=99305; let c1:i32=99306; let c2:i32=99307; let c9:i32=99399;
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  ev_teach(W,a,rf1,b); ev_teach(W,b,rf2,c0);
  let id0:i32=cy_probe(W,cc,ob,a,rm,c0,"ADVA","P1",-1);
  if(id0<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  let id1:i32=cy_probe(W,cc,ob,a,rm,c1,"ADVA","P2",id0);
  if(id1<0){ok=0;}
  ev_observe(W,b,rf2,c0);
  let id2:i32=cy_probe(W,cc,ob,a,rm,c0,"ADVA","P3",id1);
  if(id2<0){ok=0;}
  ev_observe(W,b,rf2,c2);
  let id3:i32=cy_probe(W,cc,ob,a,rm,c2,"ADVA","P4",id2);
  if(id3<0){ok=0;}
  ev_observe(W,b,rf2,c9);
  let id4:i32=cy_probe(W,cc,ob,a,rm,c9,"ADVA","P5",id3);
  if(id4<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  let id5:i32=cy_probe(W,cc,ob,a,rm,c1,"ADVA","P6",id4);
  if(id5<0){ok=0;}
  if(cy_wdump(W,cc,ob,a,rm,c1,5,"ADVA","SNAP")==0){ok=0;}
  return ok;
}
// ADV-B: back-to-back contradictions, no intervening query.
fn adv_backtoback(cc:[]u8,ob:[]u8)i32 {
  let ok:i32=1;
  let a:i32=99102; let b:i32=99202;
  let rf1:i32=9901; let rf2:i32=9902; let rm:i32=9903;
  let c0:i32=99315; let c1:i32=99316; let c2:i32=99317;
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  ev_teach(W,a,rf1,b); ev_teach(W,b,rf2,c0);
  let id0:i32=cy_probe(W,cc,ob,a,rm,c0,"ADVB","P1",-1);
  if(id0<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  ev_observe(W,b,rf2,c2);
  let id1:i32=cy_probe(W,cc,ob,a,rm,c2,"ADVB","P2",id0);
  if(id1<0){ok=0;}
  if(cy_wdump(W,cc,ob,a,rm,c2,1,"ADVB","BTB")==0){ok=0;}
  return ok;
}
// ADV-C: contradict the chain fact; re-derivation must use the new chain.
fn adv_chainlink(cc:[]u8,ob:[]u8)i32 {
  let ok:i32=1;
  let a:i32=99103; let b:i32=99203; let b9:i32=99209;
  let rf1:i32=9901; let rf2:i32=9902; let rm:i32=9903;
  let c0:i32=99325; let c1:i32=99326; let c2:i32=99327;
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  ev_teach(W,a,rf1,b); ev_teach(W,b,rf2,c0);
  let id0:i32=cy_probe(W,cc,ob,a,rm,c0,"ADVC","P1",-1);
  if(id0<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  let id1:i32=cy_probe(W,cc,ob,a,rm,c1,"ADVC","P2",id0);
  if(id1<0){ok=0;}
  ev_observe(W,b,rf2,c0);
  let id2:i32=cy_probe(W,cc,ob,a,rm,c0,"ADVC","P3",id1);
  if(id2<0){ok=0;}
  ev_observe(W,b,rf2,c2);
  let id3:i32=cy_probe(W,cc,ob,a,rm,c2,"ADVC","P4",id2);
  if(id3<0){ok=0;}
  ev_observe(W,a,rf1,b9);
  ev_teach(W,b9,rf2,c2);
  let id4:i32=cy_probe(W,cc,ob,a,rm,c2,"ADVC","P5",id3);
  if(id4<0){ok=0;}
  if(cy_wdump(W,cc,ob,a,rm,c2,4,"ADVC","CHN")==0){ok=0;}
  // sharpest check: the live MAP's DEP set includes the NEW chain fact
  // (a,rf1,b9), live and non-superseded; not the dead original chain fact.
  let id:i32=cy_map_live_id(W,a,rm);
  let found:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==id && eg(W,e,4)==1){
      let t:i32=eg(W,e,8);
      if(ng(W,t,0)==1 && ng(W,t,20)==a && ng(W,t,24)==rf1 && ng(W,t,28)==b9 && is_superseded(W,t)==0){found=1;}
    }
    e=e+1;
  }
  cy_es(cc,ob,"ADVC P5 NEWCHAIN ok="); cy_ei(cc,ob,found); cy_en(cc,ob);
  if(found==0){ok=0;}
  return ok;
}
fn sealed_main_adv()i32 {
  let ob:[]u8=z_alloc(262144);
  let cc:[]u8=z_alloc(8); set32(cc,0,0);
  let ok:i32=1;
  if(adv_snapshot(cc,ob)==0){ok=0;}
  if(adv_backtoback(cc,ob)==0){ok=0;}
  if(adv_chainlink(cc,ob)==0){ok=0;}
  cy_es(cc,ob,"ADV DONE ok="); cy_ei(cc,ob,ok); cy_en(cc,ob);
  cy_flush(cc,ob);
  return ok;
}

// dev_probe.zag -- DIAGNOSTIC ONLY (not part of the frozen SA1b battery).
// Prints per-frame signal RMS vs residual RMS and the top-20 |r| values
// with their gate components, to diagnose a zero-candidate result.
@import("R33_NATIVE_IO_V1.zag")

fn d_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn d_get16(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    return b0 | (b1 << 8);
}
fn d_get32(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    let b2:i64 = m[o+2] as i64;
    let b3:i64 = m[o+3] as i64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}
fn read_all(path:[]u8) []u8 {
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    if (fd < 0) { let e:[]u8 = nio_alloc(1); return e; }
    let msz:i64 = _zag_raw_syscall(8, fd, 0, 2, 0, 0, 0);
    _zag_raw_syscall(8, fd, 0, 0, 0, 0, 0);
    let m:[]u8 = nio_alloc(msz as i32);
    let at:i64 = 0;
    while (at < msz) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(m) as i64) + at, msz - at, 0, 0, 0);
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return m;
}
fn zsqrt(x:f64) f64 {
    if (x <= 0.0) { return 0.0; }
    let g:f64 = x / 2.0 + 1.0;
    let it:i64 = 0;
    while (it < 20) { g = (g + x / g) / 2.0; it = it + 1; }
    return g;
}
fn e1str(ob:[]u8, cur:i64, s:[]u8) i64 {
    let i:i64 = 0;
    let n:i64 = s.len as i64;
    while (i < n) { ob[cur] = s[i]; cur = cur + 1; i = i + 1; }
    return cur;
}
fn e1i64(ob:[]u8, cur:i64, v:i64) i64 {
    let u:i64 = v;
    if (v < 0) { ob[cur] = 45; cur = cur + 1; u = 0 - v; }
    let nd:i64 = 0;
    let t:i64 = u;
    if (t == 0) { nd = 1; } else { while (t > 0) { nd = nd + 1; t = t / 10; } }
    let p:i64 = cur + nd - 1;
    t = u;
    if (t == 0) { ob[p] = 48; }
    else { while (t > 0) { ob[p] = ((t % 10) + 48) as u8; t = t / 10; p = p - 1; } }
    cur = cur + nd;
    return cur;
}
fn e1f64(ob:[]u8, cur:i64, v:f64) i64 {
    if (v != v) { return e1str(ob, cur, "NaN"); }
    if (v < 0.0) { ob[cur] = 45; cur = cur + 1; v = 0.0 - v; }
    let ip:i64 = v as i64;
    cur = e1i64(ob, cur, ip);
    ob[cur] = 46; cur = cur + 1;
    let frac:f64 = v - (ip as f64);
    let k:i64 = 0;
    while (k < 6) {
        frac = frac * 10.0;
        let q:i64 = frac as i64;
        ob[cur] = (q + 48) as u8;
        cur = cur + 1;
        frac = frac - (q as f64);
        k = k + 1;
    }
    return cur;
}
fn FW() i64 { return 11025; }
fn HOP() i64 { return 8820; }
fn bpt(f:i64) i64 { return (2 * f - 1) * 4410 + 5512; }
fn frame_t0(xs:[]f64, fs:i64, fe:i64) i64 {
    let B:f64 = 0.0;
    let i:i64 = fs + 500;
    while (i < fe) { B = B + xs[i] * xs[i]; i = i + 4; }
    let best_lag:i64 = 0;
    let best_r:f64 = 0.0 - 1.0;
    let lag:i64 = 44;
    while (lag <= 500) {
        let A:f64 = 0.0;
        let C:f64 = 0.0;
        i = fs + 500;
        while (i < fe) {
            A = A + xs[i] * xs[i - lag];
            C = C + xs[i - lag] * xs[i - lag];
            i = i + 4;
        }
        let den:f64 = zsqrt(B * C);
        if (den > 0.0) {
            let r:f64 = A / den;
            if (r > best_r) { best_r = r; best_lag = lag; }
        }
        lag = lag + 1;
    }
    return best_lag;
}
fn main() void {
    let wpath:[]u8 = d_cstr(_zag_arg(1));
    let ob:[]u8 = nio_alloc(65536);
    let cur:i64 = 0;
    let m:[]u8 = read_all(wpath);
    let mlen:i64 = m.len as i64;
    let data_off:i64 = -1;
    let data_len:i64 = 0;
    let o:i64 = 12;
    while (o + 8 <= mlen) {
        let cs:i64 = d_get32(m, o + 4);
        if (m[o] == 100 and m[o+1] == 97 and m[o+2] == 116 and m[o+3] == 97 and data_off < 0) {
            data_off = o + 8; data_len = cs;
        }
        o = o + 8 + cs;
    }
    let n:i64 = data_len / 2;
    let xs:[]f64 = nio_alloc((n * 8) as i32) as []f64;
    let i:i64 = 0;
    while (i < n) {
        let s:i64 = d_get16(m, data_off + i * 2);
        if (s >= 32768) { s = s - 65536; }
        xs[i] = s as f64;
        i = i + 1;
    }
    let nf:i64 = 0;
    let f:i64 = 0;
    while (f * HOP() < n) { nf = nf + 1; f = f + 1; }
    // per-frame signal rms, t0, residual rms
    cur = e1str(ob, cur, "frame t0 sig_rms res_rms\n");
    f = 0;
    while (f < nf) {
        let fs:i64 = f * HOP();
        let fe:i64 = fs + FW();
        if (fe > n) { fe = n; }
        let lag:i64 = frame_t0(xs, fs, fe);
        let ss:f64 = 0.0;
        let j:i64 = fs;
        while (j < fe) { ss = ss + xs[j] * xs[j]; j = j + 1; }
        let sig:f64 = zsqrt(ss / ((fe - fs) as f64));
        // build h for this frame only, residual rms over owned region
        let lo:i64 = fs;
        if (f >= 1) { let b:i64 = bpt(f); if (b > lo) { lo = b; } }
        let hi:i64 = fe;
        if (f + 1 < nf) { let b2:i64 = bpt(f + 1); if (b2 < hi) { hi = b2; } }
        let rs:f64 = 0.0;
        if (lag > 0) {
            let acc:[]f64 = nio_alloc((lag * 8) as i32) as []f64;
            let cnt:[]i64 = nio_alloc((lag * 8) as i32) as []i64;
            let b:i64 = 0;
            while (b < lag) { acc[b] = 0.0; cnt[b] = 0; b = b + 1; }
            j = fs;
            while (j < fe) {
                let bb:i64 = (j - fs) % lag;
                acc[bb] = acc[bb] + xs[j];
                cnt[bb] = cnt[bb] + 1;
                j = j + 1;
            }
            j = lo;
            while (j < hi) {
                let bb2:i64 = (j - fs) % lag;
                let hv:f64 = 0.0;
                if (cnt[bb2] > 0) { hv = acc[bb2] / (cnt[bb2] as f64); }
                let rv:f64 = xs[j] - hv;
                rs = rs + rv * rv;
                j = j + 1;
            }
        } else {
            j = lo;
            while (j < hi) { rs = rs + xs[j] * xs[j]; j = j + 1; }
        }
        let res:f64 = zsqrt(rs / ((hi - lo) as f64));
        cur = e1i64(ob, cur, f); ob[cur] = 32; cur = cur + 1;
        cur = e1i64(ob, cur, lag); ob[cur] = 32; cur = cur + 1;
        cur = e1f64(ob, cur, sig); ob[cur] = 32; cur = cur + 1;
        cur = e1f64(ob, cur, res); ob[cur] = 10; cur = cur + 1;
        f = f + 1;
    }
    _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, cur, 0, 0, 0);
    return;
}

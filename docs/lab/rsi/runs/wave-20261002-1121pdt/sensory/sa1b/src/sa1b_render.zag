// sa1b_render.zag — SA1 variant renderer: byte-for-byte the committed
// desynth_render.zag render path, PLUS the measured transient channel.
// The atom's stored NIMP block stays SKIPPED (invalid legacy peaks).
// Variant reads a new EVT1 sidecar event file (argv 7).
//
// argv: 1=atom.bin 2=out.wav 3=f0_mhz 4=mode(0=flat,1=contour)
//       5=contour.bin (16 f64 mHz, mode 1 only) 6=amp_scale_pm (default 1000000)
//       7=events.evt (EVT1 file)
// Renders 2.0 s PCM16 mono 44100 Hz from a MEASURED timbre atom (format v2).
//
// Every output sample is a function of measured values:
//   - harmonic shape: period-averaged waveform from real audio (the "harmonic stack")
//   - amplitude: measured per-period RMS trajectory, time-warped (NOT exp10)
//   - texture: measured residual prototypes, pitch-synchronous (NOT noise),
//     at the extractor's CHOSEN 0.15 mix (unity here; see extract_atom.py)
//   - transients: DISABLED (stored in the atom, not rendered — the
//     period-synchronous residual does not isolate valid transients)
// The pitch trajectory comes from the plan (a deliberate target) or the
// reference's measured contour. Pitch-synchronous resampling of the measured
// period is measurement manipulation, not oscillation.
//
// BANNED from this file: cosr/sinr, exp10/exp, fmix32/hash jitter, FM.
// If you need a new primitive, it must be measured from real audio.
//
// Atom format v2: magic 'ATOM', u32 version=2, T0 f64, NBINS, harm[NBINS],
// K, TEXLEN, tex[K*TEXLEN], NAMP, amp_traj[NAMP], NIMP, imp_pos[NIMP],
// imp_amp[NIMP]. (v1's 16 LP coefficients were removed: the measured harmonic
// waveform already carries the source's spectral coloration.)
//
// argv: 1=atom.bin 2=out.wav 3=f0_mhz 4=mode(0=flat,1=contour)
//       5=contour.bin (16 f64 mHz, mode 1 only) 6=amp_scale_pm (default 1000000)
@import("R33_NATIVE_IO_V1.zag")

fn d_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn d_get32(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    let b2:i64 = m[o+2] as i64;
    let b3:i64 = m[o+3] as i64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}
fn d_get64(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    let b2:i64 = m[o+2] as i64;
    let b3:i64 = m[o+3] as i64;
    let b4:i64 = m[o+4] as i64;
    let b5:i64 = m[o+5] as i64;
    let b6:i64 = m[o+6] as i64;
    let b7:i64 = m[o+7] as i64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}
fn d_getf64(m:[]u8, o:i64) f64 {
    let f:[]f64 = m as []f64;
    return f[o / 8];
}
fn d_put16(ar:[]u8, o:i64, v:i64) void {
    ar[o] = (v & 255) as u8;
    ar[o+1] = ((v >> 8) & 255) as u8;
    return;
}
fn d_put32(ar:[]u8, o:i64, v:i64) void {
    ar[o] = (v & 255) as u8;
    ar[o+1] = ((v >> 8) & 255) as u8;
    ar[o+2] = ((v >> 16) & 255) as u8;
    ar[o+3] = ((v >> 24) & 255) as u8;
    return;
}
fn read_all(path:[]u8) []u8 {
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    if (fd < 0) { let e:[]u8 = nio_alloc(1); return e; }
    let msz:i64 = _zag_raw_syscall(8, fd, 0, 2, 0, 0, 0);
    _zag_raw_syscall(8, fd, 0, 0, 0, 0, 0);
    let m:[]u8 = nio_alloc(msz as i32);
    let at:i64 = 0;
    while (at < msz) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(m) as i64) + at, msz - at, 0, 0, 0);
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return m;
}
fn parse_i64(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i64 = 0;
    while (i < s.len) {
        let ch:i64 = s[i] as i64;
        if (ch >= 48 and ch <= 57) { v = v * 10 + (ch - 48); }
        i = i + 1;
    }
    return v;
}
fn e1str(ob:[]u8, cur:i64, s:[]u8) i64 {
    let i:i64 = 0;
    let n:i64 = s.len as i64;
    while (i < n) {
        ob[cur] = s[i];
        cur = cur + 1;
        i = i + 1;
    }
    return cur;
}
fn e1i64(ob:[]u8, cur:i64, v:i64) i64 {
    let u:i64 = v;
    if (v < 0) {
        ob[cur] = 45;
        cur = cur + 1;
        u = 0 - v;
    }
    let nd:i64 = 0;
    let t:i64 = u;
    if (t == 0) { nd = 1; }
    else {
        while (t > 0) { nd = nd + 1; t = t / 10; }
    }
    let p:i64 = cur + nd - 1;
    t = u;
    if (t == 0) { ob[p] = 48; }
    else {
        while (t > 0) {
            ob[p] = ((t % 10) + 48) as u8;
            t = t / 10;
            p = p - 1;
        }
    }
    cur = cur + nd;
    return cur;
}
// Linear interpolation between measured samples. This is resampling
// measured values, not synthesis.
fn lerp_tab(tab:[]f64, n:i64, ph:f64) f64 {
    let i0:i64 = (ph as i64) % n;
    if (i0 < 0) { i0 = i0 + n; }
    let i1:i64 = i0 + 1;
    if (i1 >= n) { i1 = 0; }
    let fr:f64 = ph - ((ph as i64) as f64);
    // handle negative phase
    if (fr < 0.0) { fr = fr + 1.0; }
    return tab[i0] * (1.0 - fr) + tab[i1] * fr;
}

fn main() void {
    let apath:[]u8 = d_cstr(_zag_arg(1));
    let opath:[]u8 = d_cstr(_zag_arg(2));
    let f0_mhz:i64 = parse_i64(_zag_arg(3));
    let mode:i64 = parse_i64(_zag_arg(4));
    let amp_scale_pm:i64 = 1000000;
    let a6:[]u8 = _zag_arg(6);
    if (a6.len > 0) { amp_scale_pm = parse_i64(a6); }

    // Load atom (format v2)
    let m:[]u8 = read_all(apath);
    if ((m.len as i64) < 16 or d_get32(m, 0) != 0x4D4F5441) {
        _zag_print("sa1b_render: bad atom magic\n");
        return;
    }
    // version is u32 LE at offset 4 (NOT u64: bytes 8-11 are the f64 T0)
    if (m[4] != 2 or m[5] != 0 or m[6] != 0 or m[7] != 0) {
        _zag_print("sa1b_render: bad atom version (need v2)\n");
        return;
    }
    let o:i64 = 8;
    o = o + 8; // T0 (f64 period estimate): atom format field, unused by rendering (P2 #8).
    let NBINS:i64 = d_get64(m, o); o = o + 8;
    let harm:[]f64 = nio_alloc((NBINS * 8) as i32) as []f64;
    let i:i64 = 0;
    while (i < NBINS) { harm[i] = d_getf64(m, o); o = o + 8; i = i + 1; }
    // v2 has NO LP block (v1's 16 coefficients removed: the measured harmonic
    // waveform already carries the spectral coloration; LPC would double-color)
    let K:i64 = d_get64(m, o); o = o + 8;
    let TEXLEN:i64 = d_get64(m, o); o = o + 8;
    let tex:[]f64 = nio_alloc((K * TEXLEN * 8) as i32) as []f64;
    i = 0;
    while (i < K * TEXLEN) { tex[i] = d_getf64(m, o); o = o + 8; i = i + 1; }
    let NAMP:i64 = d_get64(m, o); o = o + 8;
    let amp_traj:[]f64 = nio_alloc((NAMP * 8) as i32) as []f64;
    i = 0;
    while (i < NAMP) { amp_traj[i] = d_getf64(m, o); o = o + 8; i = i + 1; }
    let NIMP:i64 = d_get64(m, o); o = o + 8;
    // Transient table (NIMP i64 positions + NIMP f64 amplitudes): atom format
    // fields, intentionally SKIPPED -- not parsed, not rendered (P2 #8).
    // Rendering the extracted residual peaks as impulses breaks voicing
    // detection (the period-synchronous residual does not isolate valid
    // transients: residual RMS exceeds the source due to harmonic leakage).
    // Transient rendering needs a fixed residual isolator (future work);
    // do NOT re-enable without a separate valid extraction mechanism.
    o = o + NIMP * 16;

    // Measured harmonic RMS (for amplitude normalization)
    let hrms:f64 = 0.0;
    i = 0;
    while (i < NBINS) { hrms = hrms + harm[i] * harm[i]; i = i + 1; }
    hrms = hrms / (NBINS as f64);
    // Newton sqrt for hrms (no stdlib sqrt; this is arithmetic, not synth)
    let g:f64 = hrms / 2.0 + 1.0;
    let it:i64 = 0;
    while (it < 20) { g = (g + hrms / g) / 2.0; it = it + 1; }
    hrms = g;
    // Measured mean amplitude of the trajectory
    let amean:f64 = 0.0;
    i = 0;
    while (i < NAMP) { amean = amean + amp_traj[i]; i = i + 1; }
    if (NAMP > 0) { amean = amean / (NAMP as f64); }
    if (amean < 1.0) { amean = 1.0; }

    // Contour (mode 1): 16 measured f0 values in mHz
    let con:[]f64 = nio_alloc(128) as []f64;
    i = 0;
    while (i < 16) { con[i] = 0.0; i = i + 1; }
    if (mode == 1) {
        let cpath:[]u8 = d_cstr(_zag_arg(5));
        let cm:[]u8 = read_all(cpath);
        i = 0;
        while (i < 16 and (i * 8 + 8) as i64 <= (cm.len as i64)) {
            con[i] = d_getf64(cm, i * 8);
            i = i + 1;
        }
    }
    let f0base:f64 = (f0_mhz as f64) / 1000.0;
    if (f0base < 20.0) { f0base = 220.0; }

    // Render
    let dur:i64 = 88200;
    let sr:f64 = 44100.0;
    let out:[]f64 = nio_alloc((dur * 8) as i32) as []f64;
    i = 0;
    while (i < dur) { out[i] = 0.0; i = i + 1; }

    let phase:f64 = 0.0;
    let amp_scale:f64 = (amp_scale_pm as f64) / 1000000.0;
    // Pitch-synchronous texture: change prototype once per period, not
    // every TEXLEN samples (sample-sync cycling beats at 172 Hz, inharmonic).
    let per_count:i64 = 0;
    let n:i64 = 0;
    while (n < dur) {
        // Target f0 at this sample: from contour (measured) or constant.
        // The contour is a deliberate plan target, not a synth LFO.
        let f0t:f64 = f0base;
        if (mode == 1) {
            let pos:f64 = (n as f64) * 16.0 / (dur as f64);
            let j0:i64 = pos as i64;
            if (j0 > 14) { j0 = 14; }
            if (j0 < 0) { j0 = 0; }
            let fr:f64 = pos - (j0 as f64);
            let c0:f64 = con[j0] / 1000.0;
            let c1:f64 = con[j0 + 1] / 1000.0;
            if (c0 < 20.0) { c0 = f0base; }
            if (c1 < 20.0) { c1 = f0base; }
            f0t = c0 + (c1 - c0) * fr;
        }
        if (f0t < 20.0) { f0t = 20.0; }
        if (f0t > 2000.0) { f0t = 2000.0; }
        // Pitch-synchronous advance through the MEASURED period.
        let Tt:f64 = sr / f0t;
        phase = phase + (NBINS as f64) / Tt;
        let wrapped:i64 = 0;
        while (phase >= (NBINS as f64)) {
            phase = phase - (NBINS as f64);
            wrapped = 1;
        }
        if (wrapped == 1) { per_count = per_count + 1; }
        let h:f64 = lerp_tab(harm, NBINS, phase);
        // Amplitude: measured trajectory, time-warped to the output duration,
        // normalized by the measured mean, scaled by the plan's amplitude target.
        // NO exp10. The shape is measured; only the overall level is planned.
        let apos:f64 = (n as f64) * (NAMP as f64) / (dur as f64);
        let ai0:i64 = apos as i64;
        if (ai0 >= NAMP) { ai0 = NAMP - 1; }
        if (ai0 < 0) { ai0 = 0; }
        let ai1:i64 = ai0 + 1;
        if (ai1 >= NAMP) { ai1 = NAMP - 1; }
        let afr:f64 = apos - (ai0 as f64);
        let ampt:f64 = amp_traj[ai0] * (1.0 - afr) + amp_traj[ai1] * afr;
        let anorm:f64 = (ampt / amean) * amp_scale;
        // Texture: measured residual prototype, changed once per period
        // (pitch-synchronous). The prototype is resampled to the period by
        // stepping through it at the period rate. Prototypes carry the
        // extractor's CHOSEN 0.15 mix level, so the mix here is unity
        // (the old v1 0.5 factor is gone; see extract_atom.py HONEST NOTE).
        let tx:f64 = 0.0;
        if (K > 0 and TEXLEN > 0) {
            let tki:i64 = per_count % K;
            // Position within the prototype, pitch-synchronous:
            // map the current phase (0..NBINS) to prototype (0..TEXLEN)
            let tpos:f64 = phase * (TEXLEN as f64) / (NBINS as f64);
            let ti0:i64 = tpos as i64;
            if (ti0 >= TEXLEN) { ti0 = TEXLEN - 1; }
            if (ti0 < 0) { ti0 = 0; }
            tx = tex[tki * TEXLEN + ti0];
        }
        let s:f64 = anorm * (h + tx);
        out[n] = s;
        n = n + 1;
    }
    // SA1 transient channel: measured single-sample impulses from the EVT1
    // sidecar event file (argv 7). The atom's stored NIMP block stays SKIPPED
    // above (invalid legacy peaks); this is the separate valid extraction.
    // op = floor(pos * 88200 / n_source); amps are measured residual values.
    let epath:[]u8 = _zag_arg(7);
    let napplied:i64 = 0;
    if (epath.len > 0) {
        let em:[]u8 = read_all(d_cstr(epath));
        if ((em.len as i64) >= 24 and d_get32(em, 0) == 0x31545645 and d_get32(em, 4) == 1) {
            let nsrc:i64 = d_get64(em, 8);
            let nev:i64 = d_get64(em, 16);
            let eo:i64 = 24;
            let k:i64 = 0;
            while (k < nev) {
                if ((eo + 16) as i64 > (em.len as i64)) { break; }
                let pos:i64 = d_get64(em, eo); eo = eo + 8;
                let amp:f64 = d_getf64(em, eo); eo = eo + 8;
                if (nsrc > 0) {
                    let op:i64 = ((pos as f64) * (dur as f64) / (nsrc as f64)) as i64;
                    if (op >= 0 and op < dur) {
                        out[op] = out[op] + amp * amp_scale;
                        napplied = napplied + 1;
                    }
                }
                k = k + 1;
            }
        }
    }
    let ob:[]u8 = nio_alloc(256);
    let ocur:i64 = 0;
    ocur = e1str(ob, ocur, "sa1b_render: events applied = ");
    ocur = e1i64(ob, ocur, napplied);
    ob[ocur] = 10; ocur = ocur + 1;
    _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, ocur, 0, 0, 0);
    // Transients: DISABLED — the transient peaks were extracted from the
    // period-synchronous residual, which does not isolate valid transients
    // (residual RMS exceeds the source due to harmonic leakage; speech peaks
    // measured ~170x harmonic RMS). Rendering them as impulses broke voicing
    // detection. Stored in the atom but not rendered.
    // (Original code below, disabled.)
    // i = 0;
    // while (i < NIMP) {
    //     // imp_pos is relative to the 1s atom; scale to 2s output
    //     let rp:f64 = (imp_pos[i] as f64) / sr;
    //     let op:i64 = (rp * 2.0 * sr) as i64;
    //     if (op >= 0 and op < dur) {
    //         out[op] = out[op] + imp_amp[i] * amp_scale;
    //     }
    //     i = i + 1;
    // }

    // Write WAV (PCM16 mono 44100)
    let data:[]u8 = nio_alloc((dur * 2) as i32);
    n = 0;
    while (n < dur) {
        let v:i64 = (out[n] + 0.5) as i64;
        // round half away from zero for negatives
        if (out[n] < 0.0) { v = (out[n] - 0.5) as i64; }
        if (v > 32767) { v = 32767; }
        if (v < -32768) { v = -32768; }
        let uv:i64 = v;
        if (uv < 0) { uv = uv + 65536; }
        data[n * 2] = (uv & 255) as u8;
        data[n * 2 + 1] = ((uv / 256) & 255) as u8;
        n = n + 1;
    }
    let cs:[]u8 = opath;
    let fd2:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cs) as i64, 577, 420, 0, 0, 0);
    if (fd2 >= 0) {
        let hdr:[]u8 = nio_alloc(44);
        hdr[0] = 82; hdr[1] = 73; hdr[2] = 70; hdr[3] = 70;
        d_put32(hdr, 4, 36 + dur * 2);
        hdr[8] = 87; hdr[9] = 65; hdr[10] = 86; hdr[11] = 69;
        hdr[12] = 102; hdr[13] = 109; hdr[14] = 116; hdr[15] = 32;
        d_put32(hdr, 16, 16);
        d_put16(hdr, 20, 1);
        d_put16(hdr, 22, 1);
        d_put32(hdr, 24, 44100);
        d_put32(hdr, 28, 88200);
        d_put16(hdr, 32, 2);
        d_put16(hdr, 34, 16);
        hdr[36] = 100; hdr[37] = 97; hdr[38] = 116; hdr[39] = 97;
        d_put32(hdr, 40, dur * 2);
        _zag_raw_syscall(1, fd2, _zag_slice_ptr(hdr) as i64, 44, 0, 0, 0);
        let at2:i64 = 0;
        let dlen:i64 = 2 * dur;
        while (at2 < dlen) {
            let chunk:i64 = dlen - at2;
            if (chunk > 1048576) { chunk = 1048576; }
            let ww:i64 = _zag_raw_syscall(1, fd2, (_zag_slice_ptr(data) as i64) + at2, chunk, 0, 0, 0);
            if (ww <= 0) { break; }
            at2 = at2 + ww;
        }
        _zag_raw_syscall(3, fd2, 0, 0, 0, 0, 0);
    }
    _zag_print("sa1b_render: ok\n");
    return;
}

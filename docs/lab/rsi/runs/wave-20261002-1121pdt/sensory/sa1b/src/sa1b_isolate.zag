// sa1b_isolate.zag -- SA1b short-time adaptive harmonic rejection isolator.
// WAV (PCM16 mono 44100) -> EVT1 event table.
// Pure Zag, zero RNG. Follows frozen PREREG_SA1b.md section 4a exactly.
// The mechanism: quasi-stationary frames (FW=11025, OV=2205, HOP=8820),
// per-frame pitch T0_f, per-frame phase-locked harmonic prediction,
// nearest-center assignment in overlaps, frame-adaptive amplitude floors.
// argv: 1=src.wav 2=out.evt
//
// Toolchain: pinned znc. Stdout via single-buffer cursor emits + one raw
// write (name/layout _zag_print miscompile workaround). WAV samples via
// d_get16 (4-byte read runs past EOF on the last sample). `as []f64`
// casts are indexed directly, never .len'd (no rescale in this znc).
@import("R33_NATIVE_IO_V1.zag")

fn d_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn d_get16(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    return b0 | (b1 << 8);
}
fn d_get32(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    let b2:i64 = m[o+2] as i64;
    let b3:i64 = m[o+3] as i64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}
fn d_put32(ar:[]u8, o:i64, v:i64) void {
    ar[o] = (v & 255) as u8;
    ar[o+1] = ((v >> 8) & 255) as u8;
    ar[o+2] = ((v >> 16) & 255) as u8;
    ar[o+3] = ((v >> 24) & 255) as u8;
    return;
}
fn d_put64(ar:[]u8, o:i64, v:i64) void {
    ar[o] = (v & 255) as u8;
    ar[o+1] = ((v >> 8) & 255) as u8;
    ar[o+2] = ((v >> 16) & 255) as u8;
    ar[o+3] = ((v >> 24) & 255) as u8;
    ar[o+4] = ((v >> 32) & 255) as u8;
    ar[o+5] = ((v >> 40) & 255) as u8;
    ar[o+6] = ((v >> 48) & 255) as u8;
    ar[o+7] = ((v >> 56) & 255) as u8;
    return;
}
fn read_all(path:[]u8) []u8 {
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    if (fd < 0) { let e:[]u8 = nio_alloc(1); return e; }
    let msz:i64 = _zag_raw_syscall(8, fd, 0, 2, 0, 0, 0);
    _zag_raw_syscall(8, fd, 0, 0, 0, 0, 0);
    let m:[]u8 = nio_alloc(msz as i32);
    let at:i64 = 0;
    while (at < msz) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(m) as i64) + at, msz - at, 0, 0, 0);
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return m;
}
fn zsqrt(x:f64) f64 {
    if (x <= 0.0) { return 0.0; }
    let g:f64 = x / 2.0 + 1.0;
    let it:i64 = 0;
    while (it < 20) { g = (g + x / g) / 2.0; it = it + 1; }
    return g;
}
// --- robust stdout: single buffer, cursor emits, one raw write ---
fn e1str(ob:[]u8, cur:i64, s:[]u8) i64 {
    let i:i64 = 0;
    let n:i64 = s.len as i64;
    while (i < n) {
        ob[cur] = s[i];
        cur = cur + 1;
        i = i + 1;
    }
    return cur;
}
fn e1i64(ob:[]u8, cur:i64, v:i64) i64 {
    let u:i64 = v;
    if (v < 0) {
        ob[cur] = 45;
        cur = cur + 1;
        u = 0 - v;
    }
    let nd:i64 = 0;
    let t:i64 = u;
    if (t == 0) { nd = 1; }
    else {
        while (t > 0) { nd = nd + 1; t = t / 10; }
    }
    let p:i64 = cur + nd - 1;
    t = u;
    if (t == 0) { ob[p] = 48; }
    else {
        while (t > 0) {
            ob[p] = ((t % 10) + 48) as u8;
            t = t / 10;
            p = p - 1;
        }
    }
    cur = cur + nd;
    return cur;
}
fn e1f64(ob:[]u8, cur:i64, v:f64) i64 {
    if (v != v) { return e1str(ob, cur, "NaN"); }
    let d0:f64 = v - v;
    if (d0 != d0) {
        if (v > 0.0) { return e1str(ob, cur, "inf"); }
        return e1str(ob, cur, "-inf");
    }
    if (v < 0.0) {
        ob[cur] = 45;
        cur = cur + 1;
        v = 0.0 - v;
    }
    let ip:i64 = v as i64;
    cur = e1i64(ob, cur, ip);
    ob[cur] = 46;
    cur = cur + 1;
    let frac:f64 = v - (ip as f64);
    let k:i64 = 0;
    while (k < 6) {
        frac = frac * 10.0;
        let q:i64 = frac as i64;
        ob[cur] = (q + 48) as u8;
        cur = cur + 1;
        frac = frac - (q as f64);
        k = k + 1;
    }
    return cur;
}
// frame constants (frozen prereg 4a)
fn FW() i64 { return 11025; }
fn OV() i64 { return 2205; }
fn HOP() i64 { return 8820; }
// switch point between frame f-1 and f (f >= 1): midpoint of the overlap
fn bpt(f:i64) i64 { return (2 * f - 1) * 4410 + 5512; }
// per-frame T0 via the SA1 autocorr procedure applied to the frame.
// Returns best lag 44..500, or 0 if none qualifies.
fn frame_t0(xs:[]f64, fs:i64, fe:i64) i64 {
    let B:f64 = 0.0;
    let i:i64 = fs + 500;
    while (i < fe) {
        B = B + xs[i] * xs[i];
        i = i + 4;
    }
    let best_lag:i64 = 0;
    let best_r:f64 = 0.0 - 1.0;
    let lag:i64 = 44;
    while (lag <= 500) {
        let A:f64 = 0.0;
        let C:f64 = 0.0;
        i = fs + 500;
        while (i < fe) {
            A = A + xs[i] * xs[i - lag];
            C = C + xs[i - lag] * xs[i - lag];
            i = i + 4;
        }
        let den:f64 = zsqrt(B * C);
        if (den > 0.0) {
            let r:f64 = A / den;
            if (r > best_r) { best_r = r; best_lag = lag; }
        }
        lag = lag + 1;
    }
    return best_lag;
}

fn main() void {
    let wpath:[]u8 = d_cstr(_zag_arg(1));
    let epath:[]u8 = d_cstr(_zag_arg(2));
    let ob:[]u8 = nio_alloc(65536);
    let cur:i64 = 0;

    // --- chunk-aware RIFF parse ---
    let m:[]u8 = read_all(wpath);
    let mlen:i64 = m.len as i64;
    if (mlen < 44 or m[0] != 82 or m[1] != 73 or m[2] != 70 or m[3] != 70) {
        _zag_print("sa1b_isolate: not RIFF\n"); return;
    }
    if (m[8] != 87 or m[9] != 65 or m[10] != 86 or m[11] != 69) {
        _zag_print("sa1b_isolate: not WAVE\n"); return;
    }
    let fmt_ok:i64 = 0;
    let data_off:i64 = -1;
    let data_len:i64 = 0;
    let o:i64 = 12;
    while (o + 8 <= mlen) {
        let cs:i64 = d_get32(m, o + 4);
        let is_fmt:i64 = 0;
        if (m[o] == 102 and m[o+1] == 109 and m[o+2] == 116 and m[o+3] == 32) { is_fmt = 1; }
        let is_data:i64 = 0;
        if (m[o] == 100 and m[o+1] == 97 and m[o+2] == 116 and m[o+3] == 97) { is_data = 1; }
        if (is_fmt == 1) {
            let af:i64 = d_get16(m, o + 8);
            let ch:i64 = d_get16(m, o + 10);
            let sr:i64 = d_get32(m, o + 12);
            let bps:i64 = d_get16(m, o + 22);
            if (af == 1 and ch == 1 and sr == 44100 and bps == 16) { fmt_ok = 1; }
        }
        if (is_data == 1 and data_off < 0) { data_off = o + 8; data_len = cs; }
        o = o + 8 + cs;
    }
    if (fmt_ok == 0 or data_off < 0) {
        _zag_print("sa1b_isolate: require PCM16/mono/44100\n"); return;
    }
    let n:i64 = data_len / 2;
    let xs:[]f64 = nio_alloc((n * 8) as i32) as []f64;
    let i:i64 = 0;
    while (i < n) {
        let s:i64 = d_get16(m, data_off + i * 2);
        if (s >= 32768) { s = s - 65536; }
        xs[i] = s as f64;
        i = i + 1;
    }
    let P:f64 = 0.0;
    i = 0;
    while (i < n) {
        let a:f64 = xs[i];
        if (a < 0.0) { a = 0.0 - a; }
        if (a > P) { P = a; }
        i = i + 1;
    }

    // --- frame partition ---
    let nf:i64 = 0;
    let f:i64 = 0;
    while (f * HOP() < n) { nf = nf + 1; f = f + 1; }
    let t0f:[]i64 = nio_alloc((nf * 8) as i32) as []i64;
    let fpf:[]f64 = nio_alloc((nf * 8) as i32) as []f64;
    let ndef:i64 = 0;
    f = 0;
    while (f < nf) {
        let fs:i64 = f * HOP();
        let fe:i64 = fs + FW();
        if (fe > n) { fe = n; }
        let lag:i64 = frame_t0(xs, fs, fe);
        t0f[f] = lag;
        if (lag > 0) { ndef = ndef + 1; }
        let pf:f64 = 0.0;
        let j:i64 = fs;
        while (j < fe) {
            let a:f64 = xs[j];
            if (a < 0.0) { a = 0.0 - a; }
            if (a > pf) { pf = a; }
            j = j + 1;
        }
        fpf[f] = pf;
        f = f + 1;
    }

    // --- per-frame phase-locked harmonic prediction, nearest-center
    //     assignment in overlaps; residual r = x - h ---
    let h:[]f64 = nio_alloc((n * 8) as i32) as []f64;
    i = 0;
    while (i < n) { h[i] = 0.0; i = i + 1; }
    f = 0;
    while (f < nf) {
        let fs:i64 = f * HOP();
        let fe:i64 = fs + FW();
        if (fe > n) { fe = n; }
        let nb:i64 = t0f[f];
        let lo:i64 = fs;
        if (f >= 1) {
            let b:f64 = bpt(f) as f64;
            if ((b as i64) > lo) { lo = b as i64; }
        }
        let hi:i64 = fe;
        if (f + 1 < nf) {
            let b2:i64 = bpt(f + 1);
            if (b2 < hi) { hi = b2; }
        }
        if (nb > 0 and hi > lo) {
            let acc:[]f64 = nio_alloc((nb * 8) as i32) as []f64;
            let cnt:[]i64 = nio_alloc((nb * 8) as i32) as []i64;
            let b:i64 = 0;
            while (b < nb) { acc[b] = 0.0; cnt[b] = 0; b = b + 1; }
            let j:i64 = fs;
            while (j < fe) {
                let bb:i64 = (j - fs) % nb;
                acc[bb] = acc[bb] + xs[j];
                cnt[bb] = cnt[bb] + 1;
                j = j + 1;
            }
            let j2:i64 = lo;
            while (j2 < hi) {
                let bb2:i64 = (j2 - fs) % nb;
                if (cnt[bb2] > 0) { h[j2] = acc[bb2] / (cnt[bb2] as f64); }
                j2 = j2 + 1;
            }
        }
        f = f + 1;
    }
    let r:[]f64 = nio_alloc((n * 8) as i32) as []f64;
    let r2sum:f64 = 0.0;
    i = 0;
    while (i < n) {
        let rv:f64 = xs[i] - h[i];
        r[i] = rv;
        r2sum = r2sum + rv * rv;
        i = i + 1;
    }
    let rrms:f64 = zsqrt(r2sum / (n as f64));

    // --- prefix sum of r^2 for fast local-RMS windows ---
    let ps:[]f64 = nio_alloc(((n + 1) * 8) as i32) as []f64;
    ps[0] = 0.0;
    i = 0;
    while (i < n) { ps[i + 1] = ps[i] + r[i] * r[i]; i = i + 1; }

    // --- candidate scan (frame-adaptive floor, global-P anti-leakage) ---
    let cpos:[]i64 = nio_alloc((n * 8) as i32) as []i64;
    let camp:[]f64 = nio_alloc((n * 8) as i32) as []f64;
    let C:i64 = 0;
    i = 0;
    while (i < n) {
        let fi:i64 = i / HOP();
        if (fi >= nf) { fi = nf - 1; }
        if (fi >= 1) {
            let bsw:i64 = bpt(fi);
            if (i < bsw) { fi = fi - 1; }
        }
        let fl:f64 = 32.0;
        let fl2:f64 = 0.002 * fpf[fi];
        if (fl2 > fl) { fl = fl2; }
        let ri:f64 = r[i];
        let ar:f64 = ri;
        if (ar < 0.0) { ar = 0.0 - ar; }
        let gate_ok:i64 = 0;
        if (ar >= fl and ar <= P) { gate_ok = 1; }
        if (gate_ok == 1) {
            let nearsw:i64 = 0;
            let sf:i64 = fi;
            if (sf < 1) { sf = 1; }
            while (sf <= fi + 1 and sf < nf) {
                let d:i64 = i - bpt(sf);
                if (d < 0) { d = 0 - d; }
                if (d <= 2) { nearsw = 1; }
                sf = sf + 1;
            }
            if (nearsw == 0) {
                let r2i:f64 = ri * ri;
                let ismax:i64 = 1;
                let j:i64 = i - 2;
                while (j <= i + 2) {
                    if (j >= 0 and j < n and j != i) {
                        if (r[j] * r[j] > r2i) { ismax = 0; }
                    }
                    j = j + 1;
                }
                if (ismax == 1) {
                    let lo2:i64 = i - 64;
                    if (lo2 < 0) { lo2 = 0; }
                    let hi2:i64 = i + 64;
                    if (hi2 > n - 1) { hi2 = n - 1; }
                    let elo:i64 = i - 8;
                    if (elo < 0) { elo = 0; }
                    let ehi:i64 = i + 8;
                    if (ehi > n - 1) { ehi = n - 1; }
                    let winsum:f64 = (ps[hi2 + 1] - ps[lo2]) - (ps[ehi + 1] - ps[elo]);
                    let wincnt:i64 = (hi2 - lo2 + 1) - (ehi - elo + 1);
                    let lrms:f64 = 0.0;
                    if (wincnt > 0) { lrms = zsqrt(winsum / (wincnt as f64)); }
                    if (ar > 6.0 * lrms) {
                        cpos[C] = i;
                        camp[C] = ri;
                        C = C + 1;
                    }
                }
            }
        }
        i = i + 1;
    }

    // --- top M selection: larger |amp| wins, ties broken by smaller position ---
    let M:i64 = n / 500;
    if (M < 16) { M = 16; }
    let used:[]u8 = nio_alloc((C as i32));
    let k:i64 = 0;
    while (k < C) { used[k] = 0; k = k + 1; }
    let kept_n:i64 = M;
    if (kept_n > C) { kept_n = C; }
    let kpos:[]i64 = nio_alloc((kept_n * 8) as i32) as []i64;
    let kamp:[]f64 = nio_alloc((kept_n * 8) as i32) as []f64;
    let s:i64 = 0;
    while (s < kept_n) {
        let best:i64 = -1;
        let c:i64 = 0;
        while (c < C) {
            if (used[c] == 0) {
                if (best < 0) { best = c; }
                else {
                    let ac:f64 = camp[c];
                    if (ac < 0.0) { ac = 0.0 - ac; }
                    let ab:f64 = camp[best];
                    if (ab < 0.0) { ab = 0.0 - ab; }
                    if (ac > ab or (ac == ab and cpos[c] < cpos[best])) { best = c; }
                }
            }
            c = c + 1;
        }
        used[best] = 1;
        kpos[s] = cpos[best];
        kamp[s] = camp[best];
        s = s + 1;
    }

    // --- stats: top-10 |amp|, median contrast, max|amp|/P ---
    let top10:[]f64 = nio_alloc(80) as []f64;
    let t:i64 = 0;
    while (t < 10) {
        if (t < kept_n) {
            let a:f64 = kamp[t];
            if (a < 0.0) { a = 0.0 - a; }
            top10[t] = a;
        } else { top10[t] = 0.0; }
        t = t + 1;
    }
    let contrasts:[]f64 = nio_alloc((kept_n * 8) as i32) as []f64;
    let maxa:f64 = 0.0;
    let c10:i64 = 0;
    s = 0;
    while (s < kept_n) {
        let p:i64 = kpos[s];
        let a:f64 = kamp[s];
        if (a < 0.0) { a = 0.0 - a; }
        if (a > maxa) { maxa = a; }
        let lo3:i64 = p - 64;
        if (lo3 < 0) { lo3 = 0; }
        let hi3:i64 = p + 64;
        if (hi3 > n - 1) { hi3 = n - 1; }
        let elo3:i64 = p - 8;
        if (elo3 < 0) { elo3 = 0; }
        let ehi3:i64 = p + 8;
        if (ehi3 > n - 1) { ehi3 = n - 1; }
        let winsum:f64 = (ps[hi3 + 1] - ps[lo3]) - (ps[ehi3 + 1] - ps[elo3]);
        let wincnt:i64 = (hi3 - lo3 + 1) - (ehi3 - elo3 + 1);
        let lrms:f64 = 0.0;
        if (wincnt > 0) { lrms = zsqrt(winsum / (wincnt as f64)); }
        let con:f64 = 0.0;
        if (lrms > 0.0) { con = a / lrms; } else { con = 1e9; }
        contrasts[s] = con;
        if (con >= 10.0) { c10 = c10 + 1; }
        s = s + 1;
    }
    let u2:i64 = 0;
    while (u2 < kept_n) {
        let mn:i64 = u2;
        let v2:i64 = u2 + 1;
        while (v2 < kept_n) {
            if (contrasts[v2] < contrasts[mn]) { mn = v2; }
            v2 = v2 + 1;
        }
        let tmp:f64 = contrasts[u2];
        contrasts[u2] = contrasts[mn];
        contrasts[mn] = tmp;
        u2 = u2 + 1;
    }
    let medcon:f64 = 0.0;
    if (kept_n > 0) { medcon = contrasts[kept_n / 2]; }
    let pct10:f64 = 0.0;
    if (kept_n > 0) { pct10 = (c10 as f64) / (kept_n as f64); }

    // --- write EVT1 ---
    let hdr:[]u8 = nio_alloc(24);
    hdr[0] = 69; hdr[1] = 86; hdr[2] = 84; hdr[3] = 49;
    d_put32(hdr, 4, 1);
    d_put64(hdr, 8, n);
    d_put64(hdr, 16, kept_n);
    let rec:[]u8 = nio_alloc(16);
    let ri:[]i64 = rec as []i64;
    let rf:[]f64 = rec as []f64;
    let fd2:i64 = _zag_raw_syscall(2, _zag_slice_ptr(epath) as i64, 577, 420, 0, 0, 0);
    if (fd2 >= 0) {
        _zag_raw_syscall(1, fd2, _zag_slice_ptr(hdr) as i64, 24, 0, 0, 0);
        s = 0;
        while (s < kept_n) {
            ri[0] = kpos[s];
            rf[1] = kamp[s];
            _zag_raw_syscall(1, fd2, _zag_slice_ptr(rec) as i64, 16, 0, 0, 0);
            s = s + 1;
        }
        _zag_raw_syscall(3, fd2, 0, 0, 0, 0, 0);
    }

    cur = e1str(ob, cur, "n=");
    cur = e1i64(ob, cur, n);
    cur = e1str(ob, cur, " nframes=");
    cur = e1i64(ob, cur, nf);
    cur = e1str(ob, cur, " deffrac=");
    cur = e1f64(ob, cur, (ndef as f64) / (nf as f64));
    ob[cur] = 10; cur = cur + 1;
    cur = e1str(ob, cur, "t0f=");
    f = 0;
    while (f < nf) {
        cur = e1i64(ob, cur, t0f[f]);
        ob[cur] = 32; cur = cur + 1;
        f = f + 1;
    }
    ob[cur] = 10; cur = cur + 1;
    cur = e1str(ob, cur, "rrms=");
    cur = e1f64(ob, cur, rrms);
    cur = e1str(ob, cur, " P=");
    cur = e1f64(ob, cur, P);
    ob[cur] = 10; cur = cur + 1;
    cur = e1str(ob, cur, "candidates=");
    cur = e1i64(ob, cur, C);
    cur = e1str(ob, cur, " M=");
    cur = e1i64(ob, cur, M);
    cur = e1str(ob, cur, " kept=");
    cur = e1i64(ob, cur, kept_n);
    cur = e1str(ob, cur, " med_contrast=");
    cur = e1f64(ob, cur, medcon);
    cur = e1str(ob, cur, " frac_contrast_ge10=");
    cur = e1f64(ob, cur, pct10);
    cur = e1str(ob, cur, " maxamp_over_P=");
    cur = e1f64(ob, cur, maxa / P);
    ob[cur] = 10; cur = cur + 1;
    cur = e1str(ob, cur, "top10_amp=");
    t = 0;
    while (t < 10) {
        cur = e1f64(ob, cur, top10[t]);
        ob[cur] = 32; cur = cur + 1;
        t = t + 1;
    }
    ob[cur] = 10; cur = cur + 1;
    cur = e1str(ob, cur, "ok\n");
    _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, cur, 0, 0, 0);
    return;
}


// sa1_meter.zag -- SA1 metric extractor.
// WAV (PCM16 mono 44100) -> one TSV line on stdout.
// Follows frozen PREREG_SA1.md section 5c exactly.
// argv: 1=wav 2=label
//
// Toolchain note (2026-10-02): robust single-buffer cursor output (see
// sa1_isolate.zag); WAV samples via d_get16.
@import("R33_NATIVE_IO_V1.zag")

fn d_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn d_get16(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    return b0 | (b1 << 8);
}
fn d_get32(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    let b2:i64 = m[o+2] as i64;
    let b3:i64 = m[o+3] as i64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}
fn read_all(path:[]u8) []u8 {
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    if (fd < 0) { let e:[]u8 = nio_alloc(1); return e; }
    let msz:i64 = _zag_raw_syscall(8, fd, 0, 2, 0, 0, 0);
    _zag_raw_syscall(8, fd, 0, 0, 0, 0, 0);
    let m:[]u8 = nio_alloc(msz as i32);
    let at:i64 = 0;
    while (at < msz) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(m) as i64) + at, msz - at, 0, 0, 0);
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return m;
}
fn zsqrt(x:f64) f64 {
    if (x <= 0.0) { return 0.0; }
    let g:f64 = x / 2.0 + 1.0;
    let it:i64 = 0;
    while (it < 20) { g = (g + x / g) / 2.0; it = it + 1; }
    return g;
}
fn e1str(ob:[]u8, cur:i64, s:[]u8) i64 {
    let i:i64 = 0;
    let n:i64 = s.len as i64;
    while (i < n) {
        ob[cur] = s[i];
        cur = cur + 1;
        i = i + 1;
    }
    return cur;
}
fn e1i64(ob:[]u8, cur:i64, v:i64) i64 {
    let u:i64 = v;
    if (v < 0) {
        ob[cur] = 45;
        cur = cur + 1;
        u = 0 - v;
    }
    let nd:i64 = 0;
    let t:i64 = u;
    if (t == 0) { nd = 1; }
    else {
        while (t > 0) { nd = nd + 1; t = t / 10; }
    }
    let p:i64 = cur + nd - 1;
    t = u;
    if (t == 0) { ob[p] = 48; }
    else {
        while (t > 0) {
            ob[p] = ((t % 10) + 48) as u8;
            t = t / 10;
            p = p - 1;
        }
    }
    cur = cur + nd;
    return cur;
}
fn e1f64(ob:[]u8, cur:i64, v:f64) i64 {
    if (v != v) { return e1str(ob, cur, "NaN"); }
    let d0:f64 = v - v;
    if (d0 != d0) {
        if (v > 0.0) { return e1str(ob, cur, "inf"); }
        return e1str(ob, cur, "-inf");
    }
    if (v < 0.0) {
        ob[cur] = 45;
        cur = cur + 1;
        v = 0.0 - v;
    }
    let ip:i64 = v as i64;
    cur = e1i64(ob, cur, ip);
    ob[cur] = 46;
    cur = cur + 1;
    let frac:f64 = v - (ip as f64);
    let k:i64 = 0;
    while (k < 6) {
        frac = frac * 10.0;
        let q:i64 = frac as i64;
        ob[cur] = (q + 48) as u8;
        cur = cur + 1;
        frac = frac - (q as f64);
        k = k + 1;
    }
    return cur;
}

fn main() void {
    let wpath:[]u8 = d_cstr(_zag_arg(1));
    let label:[]u8 = _zag_arg(2);
    let ob:[]u8 = nio_alloc(4096);
    let cur:i64 = 0;

    // chunk-aware RIFF parse
    let m:[]u8 = read_all(wpath);
    let mlen:i64 = m.len as i64;
    if (mlen < 44) { _zag_print("sa1_meter: short file\n"); return; }
    let data_off:i64 = -1;
    let data_len:i64 = 0;
    let o:i64 = 12;
    while (o + 8 <= mlen) {
        let cs:i64 = d_get32(m, o + 4);
        if (m[o] == 100 and m[o+1] == 97 and m[o+2] == 116 and m[o+3] == 97 and data_off < 0) {
            data_off = o + 8; data_len = cs;
        }
        o = o + 8 + cs;
    }
    if (data_off < 0) { _zag_print("sa1_meter: no data chunk\n"); return; }
    let n:i64 = data_len / 2;
    let xs:[]f64 = nio_alloc((n * 8) as i32) as []f64;
    let i:i64 = 0;
    while (i < n) {
        let s:i64 = d_get16(m, data_off + i * 2);
        if (s >= 32768) { s = s - 65536; }
        xs[i] = s as f64;
        i = i + 1;
    }

    // peak, rms, dc, clip
    let peak:f64 = 0.0;
    let ss:f64 = 0.0;
    let dc:f64 = 0.0;
    let clip:i64 = 0;
    i = 0;
    while (i < n) {
        let a:f64 = xs[i];
        if (a < 0.0) { a = 0.0 - a; }
        if (a > peak) { peak = a; }
        ss = ss + xs[i] * xs[i];
        dc = dc + xs[i];
        if (a >= 32760.0) { clip = clip + 1; }
        i = i + 1;
    }
    let rms:f64 = zsqrt(ss / (n as f64));
    dc = dc / (n as f64);

    // HF proxy H = sum((x[n]-x[n-1])^2) / sum(x[n]^2)
    let hd:f64 = 0.0;
    i = 1;
    while (i < n) {
        let d:f64 = xs[i] - xs[i - 1];
        hd = hd + d * d;
        i = i + 1;
    }
    let H:f64 = 0.0;
    if (ss > 0.0) { H = hd / ss; }

    // onset rate: 10 ms RMS frames, flux = positive frame-to-frame RMS diff,
    // threshold = 3.0 * median positive flux, 50 ms refractory
    let FR:i64 = 441;
    let nf:i64 = n / FR;
    let frms:[]f64 = nio_alloc((nf * 8) as i32) as []f64;
    let f:i64 = 0;
    while (f < nf) {
        let s2:f64 = 0.0;
        let j:i64 = 0;
        while (j < FR) {
            let x:f64 = xs[f * FR + j];
            s2 = s2 + x * x;
            j = j + 1;
        }
        frms[f] = zsqrt(s2 / (FR as f64));
        f = f + 1;
    }
    let pf:[]f64 = nio_alloc((nf * 8) as i32) as []f64;
    let npf:i64 = 0;
    f = 1;
    while (f < nf) {
        let fl:f64 = frms[f] - frms[f - 1];
        if (fl > 0.0) { pf[npf] = fl; npf = npf + 1; }
        f = f + 1;
    }
    let a2:i64 = 0;
    while (a2 < npf) {
        let mn:i64 = a2;
        let b2:i64 = a2 + 1;
        while (b2 < npf) {
            if (pf[b2] < pf[mn]) { mn = b2; }
            b2 = b2 + 1;
        }
        let tmp:f64 = pf[a2];
        pf[a2] = pf[mn];
        pf[mn] = tmp;
        a2 = a2 + 1;
    }
    let med:f64 = 0.0;
    if (npf > 0) { med = pf[npf / 2]; }
    let thr:f64 = 3.0 * med;
    let onsets:i64 = 0;
    let last:i64 = 0 - 1000000;
    f = 1;
    while (f < nf) {
        let fl:f64 = frms[f] - frms[f - 1];
        if (fl > thr and f - last >= 5) { onsets = onsets + 1; last = f; }
        f = f + 1;
    }
    let rate:f64 = (onsets as f64) / ((n as f64) / 44100.0);

    // autocorr f0 estimate: lags 44..500, every 4th sample, i >= 500
    let B:f64 = 0.0;
    i = 500;
    while (i < n) {
        B = B + xs[i] * xs[i];
        i = i + 4;
    }
    let best_lag:i64 = 0;
    let best_r:f64 = 0.0 - 1.0;
    let lag:i64 = 44;
    while (lag <= 500) {
        let A:f64 = 0.0;
        let C:f64 = 0.0;
        i = 500;
        while (i < n) {
            A = A + xs[i] * xs[i - lag];
            C = C + xs[i - lag] * xs[i - lag];
            i = i + 4;
        }
        let den:f64 = zsqrt(B * C);
        if (den > 0.0) {
            let r2:f64 = A / den;
            if (r2 > best_r) { best_r = r2; best_lag = lag; }
        }
        lag = lag + 1;
    }
    let f0mhz:i64 = 0;
    if (best_lag > 0) { f0mhz = ((44100000.0 / (best_lag as f64)) + 0.5) as i64; }

    // one TSV line: label, n, peak, rms, dc, clip, H, onset_rate, f0_mhz
    cur = e1str(ob, cur, label);
    ob[cur] = 9; cur = cur + 1;
    cur = e1i64(ob, cur, n);
    ob[cur] = 9; cur = cur + 1;
    cur = e1f64(ob, cur, peak);
    ob[cur] = 9; cur = cur + 1;
    cur = e1f64(ob, cur, rms);
    ob[cur] = 9; cur = cur + 1;
    cur = e1f64(ob, cur, dc);
    ob[cur] = 9; cur = cur + 1;
    cur = e1i64(ob, cur, clip);
    ob[cur] = 9; cur = cur + 1;
    cur = e1f64(ob, cur, H);
    ob[cur] = 9; cur = cur + 1;
    cur = e1f64(ob, cur, rate);
    ob[cur] = 9; cur = cur + 1;
    cur = e1i64(ob, cur, f0mhz);
    ob[cur] = 10; cur = cur + 1;
    _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, cur, 0, 0, 0);
    return;
}

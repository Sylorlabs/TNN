// dev_synth.zag -- DIAGNOSTIC ONLY. Writes a 5s mono 16-bit WAV that is a
// mathematically perfect period-116 waveform: x[j] = A*sin(2*pi*j/116).
// If sa1b_isolate's phase-locked mean is implemented correctly, the residual
// on this file must be ~zero (machine precision), proving any nonzero
// residual on real speech is mechanism physics (period quantization), not a bug.
@import("R33_NATIVE_IO_V1.zag")

fn d_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn zsin(x:f64) f64 {
    // Taylor around 0 after range reduction to [-pi, pi]
    let pi:f64 = 3.141592653589793;
    let twopi:f64 = 6.283185307179586;
    while (x > pi) { x = x - twopi; }
    while (x < 0.0 - pi) { x = x + twopi; }
    let x2:f64 = x * x;
    let t:f64 = x;
    let term:f64 = x;
    let k:i64 = 1;
    while (k <= 12) {
        term = 0.0 - term * x2 / (((2 * k) * (2 * k + 1)) as f64);
        t = t + term;
        k = k + 1;
    }
    return t;
}
fn w16(m:[]u8, o:i64, v:i64) void {
    m[o] = (v & 255) as u8;
    m[o+1] = ((v >> 8) & 255) as u8;
}
fn w32(m:[]u8, o:i64, v:i64) void {
    m[o] = (v & 255) as u8;
    m[o+1] = ((v >> 8) & 255) as u8;
    m[o+2] = ((v >> 16) & 255) as u8;
    m[o+3] = ((v >> 24) & 255) as u8;
}
fn main() void {
    let n:i64 = 220500;
    let m:[]u8 = nio_alloc((44 + n * 2) as i32);
    // RIFF header
    m[0] = 82; m[1] = 73; m[2] = 70; m[3] = 70;
    w32(m, 4, 36 + n * 2);
    m[8] = 87; m[9] = 65; m[10] = 86; m[11] = 69;
    m[12] = 102; m[13] = 109; m[14] = 116; m[15] = 32;
    w32(m, 16, 16);
    w16(m, 20, 1);
    w16(m, 22, 1);
    w32(m, 24, 44100);
    w32(m, 28, 88200);
    w16(m, 32, 2);
    w16(m, 34, 16);
    m[36] = 100; m[37] = 97; m[38] = 116; m[39] = 97;
    w32(m, 40, n * 2);
    let pi:f64 = 3.141592653589793;
    let i:i64 = 0;
    while (i < n) {
        let ph:f64 = (twopi_of(i) / 116.0);
        let v:f64 = 10000.0 * zsin(ph);
        let s:i64 = v as i64;
        w16(m, 44 + i * 2, s);
        i = i + 1;
    }
    let path:[]u8 = d_cstr(_zag_arg(1));
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 577, 420, 0, 0, 0);
    let at:i64 = 0;
    let tot:i64 = (44 + n * 2) as i64;
    while (at < tot) {
        let nw:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(m) as i64) + at, tot - at, 0, 0, 0);
        if (nw <= 0) { break; }
        at = at + nw;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    _zag_print("synth ok\n");
    return;
}
fn twopi_of(i:i64) f64 {
    let twopi:f64 = 6.283185307179586;
    return (i as f64) * twopi;
}

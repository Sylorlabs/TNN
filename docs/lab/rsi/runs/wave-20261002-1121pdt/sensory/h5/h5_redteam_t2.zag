// h5_redteam_t2.zag -- T2 structure-artifact analyzer for the H5 battery.
// Pure Zag, safebin only. Reads base.bmp + var.bmp (1024x1024 24-bit),
// computes the luma difference field, and reports structure metrics that
// would reveal banding / grid / scanline / block artifacts from the 5-tap
// max kernel:
//   DIF_N, DIF_FRAC, POS_N (all-darkening check)
//   ROW_AC: max autocorrelation of the row profile at lags 2..64
//           (banding at lattice period would spike)
//   COL_AC: same for the column profile
//   BLK: max 8x8-block-boundary step vs mean interior pixel step
//         (grid imprint would make boundary steps dominate)
//   CLUSTER: fraction of differing pixels with a differing 4-neighbor
//            (cloud shadows cluster; grid noise does not)
//   32x32 ASCII density map of |dL| for visual inspection
// Exit 0, zero stderr, single-buffer stdout (pinned znc defect workaround).
@import("./sub/R33_NATIVE_IO_V1.zag")

fn r_get32le(b:[]u8, o:i64) i64 {
    return (b[o] as i64) + ((b[o + 1] as i64) << 8) + ((b[o + 2] as i64) << 16) + ((b[o + 3] as i64) << 24);
}
fn r_luma(bmp:[]u8, doff:i64, stride:i64, h:i64, x:i64, y:i64) i64 {
    let o:i64 = doff + (h - 1 - y) * stride + x * 3;
    let bl:i64 = bmp[o] as i64;
    let gr:i64 = bmp[o + 1] as i64;
    let rr:i64 = bmp[o + 2] as i64;
    return (299 * rr + 587 * gr + 114 * bl) / 1000;
}
fn r_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn e5str(ob:[]u8, cur:i64, s:[]u8) i64 {
    let i:i64 = 0;
    let n:i64 = s.len as i64;
    while (i < n) { ob[cur] = s[i]; cur = cur + 1; i = i + 1; }
    return cur;
}
fn e5i64(ob:[]u8, cur:i64, v:i64) i64 {
    let u:i64 = v;
    if (v < 0) { ob[cur] = 45; cur = cur + 1; u = 0 - v; }
    let nd:i64 = 0;
    let t:i64 = u;
    if (t == 0) { nd = 1; } else { while (t > 0) { nd = nd + 1; t = t / 10; } }
    let p:i64 = cur + nd - 1;
    t = u;
    if (t == 0) { ob[p] = 48; }
    else { while (t > 0) { ob[p] = ((t % 10) + 48) as u8; t = t / 10; p = p - 1; } }
    cur = cur + nd;
    return cur;
}
// emit v (scaled x1000) as [-]I.FFF
fn e5fx3(ob:[]u8, cur:i64, v:i64) i64 {
    let neg:i64 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    if (neg == 1) { ob[cur] = 45; cur = cur + 1; }
    cur = e5i64(ob, cur, u / 1000);
    ob[cur] = 46; cur = cur + 1;
    let f:i64 = u % 1000;
    ob[cur] = ((f / 100) + 48) as u8; cur = cur + 1;
    ob[cur] = (((f / 10) % 10) + 48) as u8; cur = cur + 1;
    ob[cur] = ((f % 10) + 48) as u8; cur = cur + 1;
    return cur;
}

fn main() i32 {
    let d:[]u8 = _zag_arg(1);
    let bn:[]u8 = _zag_arg(2);
    let vn:[]u8 = _zag_arg(3);
    let ob:[]u8 = nio_alloc(16384);
    let ocur:i64 = 0;
    if (_zag_strcmp(d, "") == 1) { d = "."; }
    if (_zag_strcmp(bn, "") == 1) {
        ocur = e5str(ob, ocur, "usage: h5_redteam_t2 <dir> <base.bmp> <var.bmp>\n");
        _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, ocur, 0, 0, 0);
        return 1;
    }
    let root:i64 = nio_open_root(d);
    if (root < 0) { ocur = e5str(ob, ocur, "cannot open dir\n"); _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, ocur, 0, 0, 0); return 1; }
    let bfd:i64 = nio_open_child(root, bn, 0);
    if (bfd < 0) { ocur = e5str(ob, ocur, "cannot open baseline\n"); _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, ocur, 0, 0, 0); nio_close(root); return 1; }
    let bmp:[]u8 = nio_alloc(33554431);
    let bsz:i64 = nio_read_exact(bfd, bmp, 33554431);
    nio_close(bfd);
    if (bsz < 54 || bmp[0] != 66 || bmp[1] != 77) { ocur = e5str(ob, ocur, "bad baseline bmp\n"); _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, ocur, 0, 0, 0); return 1; }
    let vfd:i64 = nio_open_child(root, vn, 0);
    if (vfd < 0) { ocur = e5str(ob, ocur, "cannot open variant\n"); _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, ocur, 0, 0, 0); nio_close(root); return 1; }
    let vmp:[]u8 = nio_alloc(33554431);
    let vsz:i64 = nio_read_exact(vfd, vmp, 33554431);
    nio_close(vfd);
    nio_close(root);
    if (vsz != bsz) { ocur = e5str(ob, ocur, "size mismatch\n"); _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, ocur, 0, 0, 0); return 1; }
    let bw:i64 = r_get32le(bmp, 18);
    let bh:i64 = r_get32le(bmp, 22);
    let boff:i64 = r_get32le(bmp, 10);
    let voff:i64 = r_get32le(vmp, 10);
    let bstr:i64 = (bw * 3 + 3) / 4 * 4;
    let vstr:i64 = bstr;
    if (bw != 1024 || bh != 1024) { ocur = e5str(ob, ocur, "needs 1024x1024 bmps\n"); _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, ocur, 0, 0, 0); return 1; }
    // differ bitmap (1MB) + row/col profiles
    let mask:[]u8 = nio_alloc(1048576);
    let rowp:[]u8 = nio_alloc(1024 * 8);
    let colp:[]u8 = nio_alloc(1024 * 8);
    let y:i64 = 0;
    while (y < 1024) {
        let k:i64 = 0;
        while (k < 8) { rowp[y * 8 + k] = 0; colp[y * 8 + k] = 0; k = k + 1; }
        y = y + 1;
    }
    let difn:i64 = 0;
    let posn:i64 = 0;
    let maxad:i64 = 0;
    // interior pixel-step accumulator (scaled sums stay in i64)
    let step_sum:i64 = 0;
    let step_n:i64 = 0;
    y = 0;
    while (y < bh) {
        let x:i64 = 0;
        let prev_ad:i64 = 0;
        let have_prev:i64 = 0;
        while (x < bw) {
            let lb:i64 = r_luma(bmp, boff, bstr, bh, x, y);
            let lv:i64 = r_luma(vmp, voff, vstr, bh, x, y);
            let dl:i64 = lv - lb;
            let ad:i64 = r_abs(dl);
            if (ad > 0) {
                difn = difn + 1;
                mask[y * 1024 + x] = 1;
            }
            if (dl > 0) { posn = posn + 1; }
            if (ad > maxad) { maxad = ad; }
            // row profile sum (i64)
            let rs:i64 = (rowp[y * 8] as i64) | ((rowp[y * 8 + 1] as i64) << 8) | ((rowp[y * 8 + 2] as i64) << 16) | ((rowp[y * 8 + 3] as i64) << 24) | ((rowp[y * 8 + 4] as i64) << 32) | ((rowp[y * 8 + 5] as i64) << 40) | ((rowp[y * 8 + 6] as i64) << 48) | ((rowp[y * 8 + 7] as i64) << 56);
            rs = rs + ad;
            let kk:i64 = 0;
            while (kk < 8) { rowp[y * 8 + kk] = ((rs >> (kk * 8)) & 255) as u8; kk = kk + 1; }
            // column profile sum
            let cs:i64 = (colp[x * 8] as i64) | ((colp[x * 8 + 1] as i64) << 8) | ((colp[x * 8 + 2] as i64) << 16) | ((colp[x * 8 + 3] as i64) << 24) | ((colp[x * 8 + 4] as i64) << 32) | ((colp[x * 8 + 5] as i64) << 40) | ((colp[x * 8 + 6] as i64) << 48) | ((colp[x * 8 + 7] as i64) << 56);
            cs = cs + ad;
            kk = 0;
            while (kk < 8) { colp[x * 8 + kk] = ((cs >> (kk * 8)) & 255) as u8; kk = kk + 1; }
            // interior step
            if (have_prev == 1) {
                step_sum = step_sum + r_abs(ad - prev_ad);
                step_n = step_n + 1;
            }
            prev_ad = ad;
            have_prev = 1;
            x = x + 1;
        }
        y = y + 1;
    }
    ocur = e5str(ob, ocur, "DIF_N ");
    ocur = e5i64(ob, ocur, difn);
    ocur = e5str(ob, ocur, "\nDIF_FRAC ");
    ocur = e5fx3(ob, ocur, difn * 1000 / 1048576);
    ocur = e5str(ob, ocur, "\nPOS_N(dL>0) ");
    ocur = e5i64(ob, ocur, posn);
    ocur = e5str(ob, ocur, "\nMAX_AD ");
    ocur = e5i64(ob, ocur, maxad);
    ocur = e5str(ob, ocur, "\n");
    // clustering: differing pixels with a differing 4-neighbor
    let clu:i64 = 0;
    y = 0;
    while (y < 1024) {
        let x:i64 = 0;
        while (x < 1024) {
            if (mask[y * 1024 + x] == 1) {
                let nb:i64 = 0;
                if (x > 0) { if (mask[y * 1024 + x - 1] == 1) { nb = 1; } }
                if (x < 1023) { if (mask[y * 1024 + x + 1] == 1) { nb = 1; } }
                if (y > 0) { if (mask[(y - 1) * 1024 + x] == 1) { nb = 1; } }
                if (y < 1023) { if (mask[(y + 1) * 1024 + x] == 1) { nb = 1; } }
                if (nb == 1) { clu = clu + 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    ocur = e5str(ob, ocur, "CLUSTER_FRAC ");
    if (difn > 0) { ocur = e5fx3(ob, ocur, clu * 1000 / difn); } else { ocur = e5str(ob, ocur, "n/a"); }
    ocur = e5str(ob, ocur, "\n");
    // row profile autocorrelation, lags 2..64 (lag1 shown for reference)
    let rmean:i64 = 0;
    y = 0;
    while (y < 1024) {
        let rs:i64 = (rowp[y * 8] as i64) | ((rowp[y * 8 + 1] as i64) << 8) | ((rowp[y * 8 + 2] as i64) << 16) | ((rowp[y * 8 + 3] as i64) << 24) | ((rowp[y * 8 + 4] as i64) << 32) | ((rowp[y * 8 + 5] as i64) << 40) | ((rowp[y * 8 + 6] as i64) << 48) | ((rowp[y * 8 + 7] as i64) << 56);
        rmean = rmean + rs;
        y = y + 1;
    }
    rmean = rmean / 1024;
    let rden:i64 = 0;
    y = 0;
    while (y < 1024) {
        let rs:i64 = (rowp[y * 8] as i64) | ((rowp[y * 8 + 1] as i64) << 8) | ((rowp[y * 8 + 2] as i64) << 16) | ((rowp[y * 8 + 3] as i64) << 24) | ((rowp[y * 8 + 4] as i64) << 32) | ((rowp[y * 8 + 5] as i64) << 40) | ((rowp[y * 8 + 6] as i64) << 48) | ((rowp[y * 8 + 7] as i64) << 56);
        let dv:i64 = rs - rmean;
        rden = rden + dv * dv;
        y = y + 1;
    }
    let best_lag:i64 = 0;
    let best_ac:i64 = 0;
    let ac1:i64 = 0;
    let lag:i64 = 1;
    while (lag <= 64) {
        let num:i64 = 0;
        y = 0;
        while (y < 1024 - lag) {
            let a:i64 = (rowp[y * 8] as i64) | ((rowp[y * 8 + 1] as i64) << 8) | ((rowp[y * 8 + 2] as i64) << 16) | ((rowp[y * 8 + 3] as i64) << 24) | ((rowp[y * 8 + 4] as i64) << 32) | ((rowp[y * 8 + 5] as i64) << 40) | ((rowp[y * 8 + 6] as i64) << 48) | ((rowp[y * 8 + 7] as i64) << 56);
            let b2:i64 = (rowp[(y + lag) * 8] as i64) | ((rowp[(y + lag) * 8 + 1] as i64) << 8) | ((rowp[(y + lag) * 8 + 2] as i64) << 16) | ((rowp[(y + lag) * 8 + 3] as i64) << 24) | ((rowp[(y + lag) * 8 + 4] as i64) << 32) | ((rowp[(y + lag) * 8 + 5] as i64) << 40) | ((rowp[(y + lag) * 8 + 6] as i64) << 48) | ((rowp[(y + lag) * 8 + 7] as i64) << 56);
            num = num + (a - rmean) * (b2 - rmean);
            y = y + 1;
        }
        let ac:i64 = 0;
        if (rden > 0) { ac = num * 1000 / rden; }
        if (lag == 1) { ac1 = ac; }
        if (lag >= 2) {
            let aac:i64 = r_abs(ac);
            if (aac > r_abs(best_ac)) { best_ac = ac; best_lag = lag; }
        }
        lag = lag + 1;
    }
    ocur = e5str(ob, ocur, "ROW_AC_LAG1 ");
    ocur = e5fx3(ob, ocur, ac1);
    ocur = e5str(ob, ocur, "\nROW_AC_MAXLAG2_64 lag=");
    ocur = e5i64(ob, ocur, best_lag);
    ocur = e5str(ob, ocur, " ac=");
    ocur = e5fx3(ob, ocur, best_ac);
    ocur = e5str(ob, ocur, "\n");
    // column profile autocorrelation, lags 2..64
    let cmean:i64 = 0;
    let x:i64 = 0;
    while (x < 1024) {
        let cs:i64 = (colp[x * 8] as i64) | ((colp[x * 8 + 1] as i64) << 8) | ((colp[x * 8 + 2] as i64) << 16) | ((colp[x * 8 + 3] as i64) << 24) | ((colp[x * 8 + 4] as i64) << 32) | ((colp[x * 8 + 5] as i64) << 40) | ((colp[x * 8 + 6] as i64) << 48) | ((colp[x * 8 + 7] as i64) << 56);
        cmean = cmean + cs;
        x = x + 1;
    }
    cmean = cmean / 1024;
    let cden:i64 = 0;
    x = 0;
    while (x < 1024) {
        let cs:i64 = (colp[x * 8] as i64) | ((colp[x * 8 + 1] as i64) << 8) | ((colp[x * 8 + 2] as i64) << 16) | ((colp[x * 8 + 3] as i64) << 24) | ((colp[x * 8 + 4] as i64) << 32) | ((colp[x * 8 + 5] as i64) << 40) | ((colp[x * 8 + 6] as i64) << 48) | ((colp[x * 8 + 7] as i64) << 56);
        let dv:i64 = cs - cmean;
        cden = cden + dv * dv;
        x = x + 1;
    }
    best_lag = 0;
    best_ac = 0;
    ac1 = 0;
    lag = 1;
    while (lag <= 64) {
        let num:i64 = 0;
        x = 0;
        while (x < 1024 - lag) {
            let a:i64 = (colp[x * 8] as i64) | ((colp[x * 8 + 1] as i64) << 8) | ((colp[x * 8 + 2] as i64) << 16) | ((colp[x * 8 + 3] as i64) << 24) | ((colp[x * 8 + 4] as i64) << 32) | ((colp[x * 8 + 5] as i64) << 40) | ((colp[x * 8 + 6] as i64) << 48) | ((colp[x * 8 + 7] as i64) << 56);
            let b2:i64 = (colp[(x + lag) * 8] as i64) | ((colp[(x + lag) * 8 + 1] as i64) << 8) | ((colp[(x + lag) * 8 + 2] as i64) << 16) | ((colp[(x + lag) * 8 + 3] as i64) << 24) | ((colp[(x + lag) * 8 + 4] as i64) << 32) | ((colp[(x + lag) * 8 + 5] as i64) << 40) | ((colp[(x + lag) * 8 + 6] as i64) << 48) | ((colp[(x + lag) * 8 + 7] as i64) << 56);
            num = num + (a - cmean) * (b2 - cmean);
            x = x + 1;
        }
        let ac:i64 = 0;
        if (cden > 0) { ac = num * 1000 / cden; }
        if (lag == 1) { ac1 = ac; }
        if (lag >= 2) {
            let aac:i64 = r_abs(ac);
            if (aac > r_abs(best_ac)) { best_ac = ac; best_lag = lag; }
        }
        lag = lag + 1;
    }
    ocur = e5str(ob, ocur, "COL_AC_LAG1 ");
    ocur = e5fx3(ob, ocur, ac1);
    ocur = e5str(ob, ocur, "\nCOL_AC_MAXLAG2_64 lag=");
    ocur = e5i64(ob, ocur, best_lag);
    ocur = e5str(ob, ocur, " ac=");
    ocur = e5fx3(ob, ocur, best_ac);
    ocur = e5str(ob, ocur, "\n");
    // 8x8 block means: max boundary step vs mean interior step
    let maxbstep:i64 = 0;
    let by:i64 = 0;
    while (by < 128) {
        let bx:i64 = 0;
        while (bx < 128) {
            let s:i64 = 0;
            let py:i64 = 0;
            while (py < 8) {
                let px:i64 = 0;
                while (px < 8) {
                    let gx:i64 = bx * 8 + px;
                    let gy:i64 = by * 8 + py;
                    let lb:i64 = r_luma(bmp, boff, bstr, bh, gx, gy);
                    let lv:i64 = r_luma(vmp, voff, vstr, bh, gx, gy);
                    s = s + r_abs(lv - lb);
                    px = px + 1;
                }
                py = py + 1;
            }
            let bm:i64 = s / 64;
            if (bx > 0) {
                // left neighbor block mean: recompute (memory-light)
                let s2:i64 = 0;
                py = 0;
                while (py < 8) {
                    let px:i64 = 0;
                    while (px < 8) {
                        let gx:i64 = (bx - 1) * 8 + px;
                        let gy:i64 = by * 8 + py;
                        let lb:i64 = r_luma(bmp, boff, bstr, bh, gx, gy);
                        let lv:i64 = r_luma(vmp, voff, vstr, bh, gx, gy);
                        s2 = s2 + r_abs(lv - lb);
                        px = px + 1;
                    }
                    py = py + 1;
                }
                let st:i64 = r_abs(bm - s2 / 64);
                if (st > maxbstep) { maxbstep = st; }
            }
            if (by > 0) {
                let s3:i64 = 0;
                py = 0;
                while (py < 8) {
                    let px:i64 = 0;
                    while (px < 8) {
                        let gx:i64 = bx * 8 + px;
                        let gy:i64 = (by - 1) * 8 + py;
                        let lb:i64 = r_luma(bmp, boff, bstr, bh, gx, gy);
                        let lv:i64 = r_luma(vmp, voff, vstr, bh, gx, gy);
                        s3 = s3 + r_abs(lv - lb);
                        px = px + 1;
                    }
                    py = py + 1;
                }
                let st:i64 = r_abs(bm - s3 / 64);
                if (st > maxbstep) { maxbstep = st; }
            }
            bx = bx + 1;
        }
        by = by + 1;
    }
    ocur = e5str(ob, ocur, "BLK_MAXSTEP ");
    ocur = e5i64(ob, ocur, maxbstep);
    ocur = e5str(ob, ocur, "\nPIX_MEANSTEP_x1000 ");
    if (step_n > 0) { ocur = e5i64(ob, ocur, step_sum * 1000 / step_n); } else { ocur = e5str(ob, ocur, "n/a"); }
    ocur = e5str(ob, ocur, "\n");
    // 32x32 ASCII density map of |dL|
    ocur = e5str(ob, ocur, "DIFFMAP 32x32:\n");
    let my2:i64 = 0;
    while (my2 < 32) {
        let mx2:i64 = 0;
        while (mx2 < 32) {
            let s:i64 = 0;
            let py:i64 = 0;
            while (py < 32) {
                let px:i64 = 0;
                while (px < 32) {
                    let gx:i64 = mx2 * 32 + px;
                    let gy:i64 = my2 * 32 + py;
                    let lb:i64 = r_luma(bmp, boff, bstr, bh, gx, gy);
                    let lv:i64 = r_luma(vmp, voff, vstr, bh, gx, gy);
                    s = s + r_abs(lv - lb);
                    px = px + 1;
                }
                py = py + 1;
            }
            let avg:i64 = s / 1024;
            let ch:i64 = 32;
            if (avg >= 1) { ch = 46; }
            if (avg >= 4) { ch = 58; }
            if (avg >= 10) { ch = 61; }
            if (avg >= 20) { ch = 35; }
            ob[ocur] = ch as u8;
            ocur = ocur + 1;
            mx2 = mx2 + 1;
        }
        ob[ocur] = 10;
        ocur = ocur + 1;
        my2 = my2 + 1;
    }
    _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, ocur, 0, 0, 0);
    return 0;
}

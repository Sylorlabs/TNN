// f1_score.zag - development scorer / analysis for F1 (dev scaffolding only).
// usage:
//   f1_score acc pred truth        -> accuracy of predictions vs truth
//   f1_score mem train_ep truth    -> exact-match memorizer baseline accuracy
//   f1_score exec trace name       -> EXEC count of a named structure in trace
//   f1_score sig state1 state2     -> canonical main-graph signatures + ISO

fn count_tok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn get_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

// Read a two-column (x v) file into caller buffers. Returns row count.
fn read_pairs(path:[]u8, xs:[]u8, vs:[]u8)i64 {
    let text:[]u8 = _zag_read_file(path);
    if(text.len == 0) { return -1; }
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < text.len && n < 4096) {
        let q:i64 = p;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p..q];
        if(q < text.len) { q = q + 1; }
        p = q;
        if(line.len > 0 && count_tok(line) >= 2) {
            let xv:[]u8 = get_tok(line, 0);
            let vv:[]u8 = get_tok(line, count_tok(line) - 1);
            // store as i64 cells via byte copy of parsed value
            f1s_is(xs, n, _zag_str_to_i64(xv));
            f1s_is(vs, n, _zag_str_to_i64(vv));
            n = n + 1;
        }
    }
    return n;
}

fn f1s_ig(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn f1s_is(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

fn f1s_alloc(n:i64)[]u8 {
    if(n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn do_acc(pred:[]u8, truth:[]u8)i32 {
    let px:[]u8 = f1s_alloc(4096 * 8);
    let pv:[]u8 = f1s_alloc(4096 * 8);
    let tx:[]u8 = f1s_alloc(4096 * 8);
    let tv:[]u8 = f1s_alloc(4096 * 8);
    if(px.len == 0 || pv.len == 0 || tx.len == 0 || tv.len == 0) { return 2; }
    let np:i64 = read_pairs(pred, px, pv);
    let nt:i64 = read_pairs(truth, tx, tv);
    if(np < 0 || nt < 0 || np != nt) {
        _zag_println("ERR pair_read");
        return 2;
    }
    let c:i64 = 0;
    let i:i64 = 0;
    while(i < np) {
        if(f1s_ig(px, i) == f1s_ig(tx, i) && f1s_ig(pv, i) == f1s_ig(tv, i)) { c = c + 1; }
        i = i + 1;
    }
    _zag_print("ACC ");
    _zag_print(_zag_i64_to_str(c));
    _zag_print(" ");
    _zag_print(_zag_i64_to_str(np));
    _zag_print(" ");
    _zag_println(_zag_i64_to_str((c * 100) / np));
    return 0;
}

// Exact-match memorizer with the same example budget as the learner:
// table from train episodes (first occurrence wins); unseen x -> predicts 0.
fn do_mem(train:[]u8, truth:[]u8)i32 {
    let px:[]u8 = f1s_alloc(4096 * 8);
    let pv:[]u8 = f1s_alloc(4096 * 8);
    let tx:[]u8 = f1s_alloc(4096 * 8);
    let tv:[]u8 = f1s_alloc(4096 * 8);
    if(px.len == 0 || pv.len == 0 || tx.len == 0 || tv.len == 0) { return 2; }
    let nn:i64 = read_pairs(train, px, pv);
    let nt:i64 = read_pairs(truth, tx, tv);
    if(nn < 0 || nt < 0) { _zag_println("ERR pair_read"); return 2; }
    let c:i64 = 0;
    let i:i64 = 0;
    while(i < nt) {
        let x:i64 = f1s_ig(tx, i);
        let pred:i64 = 0;
        let found:i64 = 0;
        let j:i64 = 0;
        while(j < nn && found == 0) {
            if(f1s_ig(px, j) == x) { pred = f1s_ig(pv, j); found = 1; }
            j = j + 1;
        }
        if(pred == f1s_ig(tv, i)) { c = c + 1; }
        i = i + 1;
    }
    _zag_print("MEMACC ");
    _zag_print(_zag_i64_to_str(c));
    _zag_print(" ");
    _zag_print(_zag_i64_to_str(nt));
    _zag_print(" ");
    _zag_println(_zag_i64_to_str((c * 100) / nt));
    return 0;
}

// Reuse-invocation check: EXEC count of a named structure in a trace.
fn do_exec(trace:[]u8, name:[]u8)i32 {
    let text:[]u8 = _zag_read_file(trace);
    if(text.len == 0) { _zag_println("ERR read"); return 2; }
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < text.len) {
        let q:i64 = p;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p..q];
        if(q < text.len) { q = q + 1; }
        p = q;
        if(line.len > 5 && count_tok(line) == 3) {
            if(_zag_strcmp(get_tok(line, 0), "EXEC") == 1 &&
               _zag_strcmp(get_tok(line, 1), name) == 1) {
                n = _zag_str_to_i64(get_tok(line, 2));
            }
        }
    }
    _zag_print("EXECN ");
    _zag_print(name);
    _zag_print(" ");
    _zag_println(_zag_i64_to_str(n));
    return 0;
}

// Canonical signature of the main graph in a state file (dev-level
// structural comparison): raw op/operand serialization per node.
fn state_sig(path:[]u8)[]u8 {
    let text:[]u8 = _zag_read_file(path);
    if(text.len == 0) { return ""; }
    let out:[]u8 = "";
    let p:i64 = 0;
    let in_main:i64 = 0;
    while(p < text.len) {
        let q:i64 = p;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p..q];
        if(q < text.len) { q = q + 1; }
        p = q;
        if(line.len >= 5) {
            let w:[]u8 = get_tok(line, 0);
            if(_zag_strcmp(w, "GRAPH") == 1) {
                if(_zag_strcmp(get_tok(line, 2), "main") == 1) { in_main = 1; }
                else { in_main = 0; }
            } else if(_zag_strcmp(w, "N") == 1 && in_main == 1) {
                out = _zag_str_concat(out, line);
                out = _zag_str_concat(out, ";");
            } else if(_zag_strcmp(w, "ENDGRAPH") == 1) {
                in_main = 0;
            }
        }
    }
    return out;
}

fn do_sig(s1:[]u8, s2:[]u8)i32 {
    let a:[]u8 = state_sig(s1);
    let b:[]u8 = state_sig(s2);
    _zag_print("SIGLEN ");
    _zag_print(_zag_i64_to_str(a.len as i64));
    _zag_print(" ");
    _zag_println(_zag_i64_to_str(b.len as i64));
    _zag_print("SIG1 ");
    _zag_println(a);
    _zag_print("SIG2 ");
    _zag_println(b);
    let iso:i64 = 0;
    if(a.len == b.len && _zag_strcmp(a, b) == 1) { iso = 1; }
    _zag_print("ISO ");
    _zag_println(_zag_i64_to_str(iso));
    return 0;
}

fn main()i32 {
    if(_zag_argc() < 3) {
        _zag_println("usage: f1_score acc|mem|exec|sig ...");
        return 2;
    }
    let sub:[]u8 = _zag_arg(1);
    if(_zag_strcmp(sub, "acc") == 1) {
        if(_zag_argc() < 4) { return 2; }
        return do_acc(_zag_arg(2), _zag_arg(3));
    }
    if(_zag_strcmp(sub, "mem") == 1) {
        if(_zag_argc() < 4) { return 2; }
        return do_mem(_zag_arg(2), _zag_arg(3));
    }
    if(_zag_strcmp(sub, "exec") == 1) {
        if(_zag_argc() < 4) { return 2; }
        return do_exec(_zag_arg(2), _zag_arg(3));
    }
    if(_zag_strcmp(sub, "sig") == 1) {
        if(_zag_argc() < 4) { return 2; }
        return do_sig(_zag_arg(2), _zag_arg(3));
    }
    _zag_println("ERR unknown_sub");
    return 2;
}

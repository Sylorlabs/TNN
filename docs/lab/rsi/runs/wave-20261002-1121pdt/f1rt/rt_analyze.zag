// rt_analyze.zag - INDEPENDENT red-team analyzer for the F1 seed-sensitivity finding.
// Reimplements the frozen normalization from scratch (op/operand-only grouping)
// and independently recomputes hidden accuracy. Output is built in ONE
// preallocated buffer with cursor-returning emit helpers and written with
// _zag_write_file (no _zag_print for dynamic content, per the pinned-znc rule).
// usage: rt_analyze <manifest> <report_out>
// manifest lines: <i> <train_trace> <hidden_pred> <truth>

fn rt_alloc(n:i64)[]u8 {
    if(n < 1 || n > 67108864) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn rt_ig(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn rt_is(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

// cursor-returning emit helpers into one buffer
fn e1str(b:[]u8, cur:i64, s:[]u8)i64 {
    let i:i64 = 0;
    while(i < s.len) { b[cur] = s[i]; cur = cur + 1; i = i + 1; }
    return cur;
}

fn e1i64(b:[]u8, cur:i64, v:i64)i64 {
    if(v < 0) { b[cur] = 45; cur = cur + 1; v = 0 - v; }
    let n:i64 = 0;
    let t:i64 = v;
    if(t == 0) { n = 1; }
    while(t > 0) { n = n + 1; t = t / 10; }
    let p:i64 = cur + n - 1;
    t = v;
    if(t == 0) { b[p] = 48; }
    while(t > 0) { b[p] = ((t % 10) + 48) as u8; p = p - 1; t = t / 10; }
    return cur + n;
}

fn e1ch(b:[]u8, cur:i64, c:i64)i64 {
    b[cur] = c as u8;
    return cur + 1;
}

fn rt_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn rt_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn rt_has_pre(tok:[]u8, pre:[]u8)bool {
    if(tok.len < pre.len) { return false; }
    let i:i64 = 0;
    while(i < pre.len) {
        if(tok[i] != pre[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn rt_after_eq(tok:[]u8)[]u8 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return ""; }
    return tok[p+1..tok.len];
}

fn rt_field(line:[]u8, name:[]u8)[]u8 {
    let nt:i64 = rt_ntok(line);
    let i:i64 = 0;
    while(i < nt) {
        let t:[]u8 = rt_tok(line, i);
        if(rt_has_pre(t, name)) { return rt_after_eq(t); }
        i = i + 1;
    }
    return "";
}

fn rt_oclass(v:i64)i64 {
    if(v == 0) { return 0; }
    if(v == 8) { return 1; }
    if(v == 9) { return 2; }
    return 3;
}

fn rt_cname(b:[]u8, cur:i64, c:i64)i64 {
    if(c == 0) { return e1str(b, cur, "R0"); }
    if(c == 1) { return e1str(b, cur, "X0"); }
    if(c == 2) { return e1str(b, cur, "X1"); }
    return e1str(b, cur, "O");
}

// Independent accuracy: pred vs truth, line by line; first token and last
// token must match; counts must match. Returns acc*1000000+den packed in res.
fn rt_acc(pred_path:[]u8, truth_path:[]u8, res:[]u8)void {
    rt_is(res, 0, -1);
    rt_is(res, 1, -1);
    let pt:[]u8 = _zag_read_file(pred_path);
    let tt:[]u8 = _zag_read_file(truth_path);
    if(pt.len == 0 || tt.len == 0) { return; }
    let pn:i64 = 0;
    let tn:i64 = 0;
    let p:i64 = 0;
    while(p < pt.len) {
        if(pt[p] == 10) { pn = pn + 1; }
        p = p + 1;
    }
    p = 0;
    while(p < tt.len) {
        if(tt[p] == 10) { tn = tn + 1; }
        p = p + 1;
    }
    if(pn != tn || pn == 0) { return; }
    let c:i64 = 0;
    let pp:i64 = 0;
    let tp2:i64 = 0;
    let li:i64 = 0;
    while(li < pn) {
        let q1:i64 = pp;
        while(q1 < pt.len && pt[q1] != 10) { q1 = q1 + 1; }
        let q2:i64 = tp2;
        while(q2 < tt.len && tt[q2] != 10) { q2 = q2 + 1; }
        let l1:[]u8 = pt[pp..q1];
        let l2:[]u8 = tt[tp2..q2];
        let ok:bool = false;
        let n1:i64 = rt_ntok(l1);
        let n2:i64 = rt_ntok(l2);
        if(n1 >= 2 && n2 >= 2) {
            let xok:bool = _zag_strcmp(rt_tok(l1, 0), rt_tok(l2, 0)) == 1;
            let vok:bool = _zag_strcmp(rt_tok(l1, n1 - 1), rt_tok(l2, n2 - 1)) == 1;
            if(xok && vok) { ok = true; }
        }
        if(ok) { c = c + 1; }
        pp = q1 + 1;
        tp2 = q2 + 1;
        li = li + 1;
    }
    rt_is(res, 0, c);
    rt_is(res, 1, pn);
}

fn main()i32 {
    if(_zag_argc() < 3) { return 2; }
    let mtext:[]u8 = _zag_read_file(_zag_arg(1));
    let rout:[]u8 = _zag_arg(2);
    if(mtext.len == 0) { return 2; }

    let out:[]u8 = rt_alloc(4194304);
    if(out.len == 0) { return 2; }
    let cur:i64 = 0;

    let maxs:i64 = 40;
    let maxe:i64 = 32;
    let c_accn:[]u8 = rt_alloc(maxs * 8);
    let c_accd:[]u8 = rt_alloc(maxs * 8);
    let c_ncons:[]u8 = rt_alloc(maxs * 8);
    let c_trigep:[]u8 = rt_alloc(maxs * 8);
    let c_trigbuf:[]u8 = rt_alloc(maxs * 8);
    // event cells: op string offset/len in pool, c1 c2 c3
    let ne:i64 = maxs * maxe;
    let e_opoff:[]u8 = rt_alloc(ne * 8);
    let e_oplen:[]u8 = rt_alloc(ne * 8);
    let e_c1:[]u8 = rt_alloc(ne * 8);
    let e_c2:[]u8 = rt_alloc(ne * 8);
    let e_c3:[]u8 = rt_alloc(ne * 8);
    // normalized sequence strings in pool2
    let pool:[]u8 = rt_alloc(65536);
    let poolp:i64 = 0;
    let pool2:[]u8 = rt_alloc(262144);
    let pool2p:i64 = 0;
    let s_seqoff:[]u8 = rt_alloc(maxs * 8);
    let s_seqlen:[]u8 = rt_alloc(maxs * 8);
    let s_fcoff:[]u8 = rt_alloc(maxs * 8);
    let s_fclen:[]u8 = rt_alloc(maxs * 8);
    if(c_accn.len == 0 || e_opoff.len == 0 || pool.len == 0 || pool2.len == 0) { return 2; }

    let n:i64 = 0;
    let p:i64 = 0;
    while(p < mtext.len && n < maxs) {
        let q:i64 = p;
        while(q < mtext.len && mtext[q] != 10) { q = q + 1; }
        let line:[]u8 = mtext[p..q];
        if(q < mtext.len) { q = q + 1; }
        p = q;
        let skip_line:bool = false;
        if(line.len == 0) { skip_line = true; }
        let si:[]u8 = rt_tok(line, 0);
        let tpath:[]u8 = rt_tok(line, 1);
        let ppath:[]u8 = rt_tok(line, 2);
        let hpath:[]u8 = rt_tok(line, 3);
        if(si.len == 0 || tpath.len == 0) { skip_line = true; }
        if(!skip_line) {
            rt_is(c_ncons, n, 0);
            rt_is(c_trigep, n, -1);
            rt_is(c_trigbuf, n, -1);
            let text:[]u8 = _zag_read_file(tpath);
            let rp:i64 = 0;
            while(rp < text.len) {
                let rq:i64 = rp;
                while(rq < text.len && text[rq] != 10) { rq = rq + 1; }
                let tline:[]u8 = text[rp..rq];
                if(rq < text.len) { rq = rq + 1; }
                rp = rq;
                let w0:[]u8 = rt_tok(tline, 0);
                let is_con:bool = _zag_strcmp(w0, "CONSTRUCT") == 1;
                let is_trg:bool = _zag_strcmp(w0, "TRIGGER") == 1;
                if(is_trg && rt_ig(c_trigep, n) < 0) {
                    rt_is(c_trigep, n, _zag_str_to_i64(rt_tok(tline, 1)));
                    let bf:[]u8 = rt_field(tline, "buf=");
                    rt_is(c_trigbuf, n, _zag_str_to_i64(bf));
                }
                if(is_con) {
                    let nc:i64 = rt_ig(c_ncons, n);
                    if(nc < maxe) {
                        let op:[]u8 = rt_field(tline, "op=");
                        let p1:[]u8 = rt_field(tline, "p1=");
                        let p2:[]u8 = rt_field(tline, "p2=");
                        let p3:[]u8 = rt_field(tline, "p3=");
                        let ei:i64 = n * maxe + nc;
                        let off:i64 = poolp;
                        let k:i64 = 0;
                        while(k < op.len && poolp < 65000) {
                            pool[poolp] = op[k];
                            poolp = poolp + 1;
                            k = k + 1;
                        }
                        rt_is(e_opoff, ei, off);
                        rt_is(e_oplen, ei, op.len);
                        rt_is(e_c1, ei, rt_oclass(_zag_str_to_i64(p1)));
                        rt_is(e_c2, ei, rt_oclass(_zag_str_to_i64(p2)));
                        rt_is(e_c3, ei, rt_oclass(_zag_str_to_i64(p3)));
                        rt_is(c_ncons, n, nc + 1);
                    }
                }
            }
            // accuracy
            let ares:[]u8 = rt_alloc(16);
            rt_acc(ppath, hpath, ares);
            rt_is(c_accn, n, rt_ig(ares, 0));
            rt_is(c_accd, n, rt_ig(ares, 1));
            // normalized sequence string into pool2
            let soff:i64 = pool2p;
            let e2:i64 = 0;
            let nc2:i64 = rt_ig(c_ncons, n);
            while(e2 < nc2) {
                let ei2:i64 = n * maxe + e2;
                let oo:i64 = rt_ig(e_opoff, ei2);
                let ol:i64 = rt_ig(e_oplen, ei2);
                let k2:i64 = 0;
                while(k2 < ol && pool2p < 260000) {
                    pool2[pool2p] = pool[oo + k2];
                    pool2p = pool2p + 1;
                    k2 = k2 + 1;
                }
                pool2[pool2p] = 58; pool2p = pool2p + 1;
                // c1 c2 c3 as single digits
                pool2[pool2p] = (48 + rt_ig(e_c1, ei2)) as u8; pool2p = pool2p + 1;
                pool2[pool2p] = 44; pool2p = pool2p + 1;
                pool2[pool2p] = (48 + rt_ig(e_c2, ei2)) as u8; pool2p = pool2p + 1;
                pool2[pool2p] = 44; pool2p = pool2p + 1;
                pool2[pool2p] = (48 + rt_ig(e_c3, ei2)) as u8; pool2p = pool2p + 1;
                pool2[pool2p] = 124; pool2p = pool2p + 1;
                e2 = e2 + 1;
            }
            rt_is(s_seqoff, n, soff);
            rt_is(s_seqlen, n, pool2p - soff);
            // first-trial class string
            let foff:i64 = pool2p;
            if(nc2 == 0) {
                let nn:[]u8 = "NONE";
                let k3:i64 = 0;
                while(k3 < nn.len) { pool2[pool2p] = nn[k3]; pool2p = pool2p + 1; k3 = k3 + 1; }
            } else {
                let ei3:i64 = n * maxe;
                let oo3:i64 = rt_ig(e_opoff, ei3);
                let ol3:i64 = rt_ig(e_oplen, ei3);
                let k4:i64 = 0;
                while(k4 < ol3 && pool2p < 260000) {
                    pool2[pool2p] = pool[oo3 + k4];
                    pool2p = pool2p + 1;
                    k4 = k4 + 1;
                }
                pool2[pool2p] = 95; pool2p = pool2p + 1;
                let cname2:[]u8 = "";
                let cc2:i64 = rt_ig(e_c2, ei3);
                if(cc2 == 0) { cname2 = "R0"; }
                if(cc2 == 1) { cname2 = "X0"; }
                if(cc2 == 2) { cname2 = "X1"; }
                if(cc2 == 3) { cname2 = "O"; }
                let k5:i64 = 0;
                while(k5 < cname2.len) { pool2[pool2p] = cname2[k5]; pool2p = pool2p + 1; k5 = k5 + 1; }
                pool2[pool2p] = 95; pool2p = pool2p + 1;
                let cname3:[]u8 = "";
                let cc3:i64 = rt_ig(e_c3, ei3);
                if(cc3 == 0) { cname3 = "R0"; }
                if(cc3 == 1) { cname3 = "X0"; }
                if(cc3 == 2) { cname3 = "X1"; }
                if(cc3 == 3) { cname3 = "O"; }
                k5 = 0;
                while(k5 < cname3.len) { pool2[pool2p] = cname3[k5]; pool2p = pool2p + 1; k5 = k5 + 1; }
            }
            rt_is(s_fcoff, n, foff);
            rt_is(s_fclen, n, pool2p - foff);
            n = n + 1;
        }
    }

    // per-seed lines
    let s:i64 = 0;
    while(s < n) {
        cur = e1str(out, cur, "SEED ");
        cur = e1i64(out, cur, s);
        cur = e1str(out, cur, " acc ");
        cur = e1i64(out, cur, rt_ig(c_accn, s));
        cur = e1ch(out, cur, 47);
        cur = e1i64(out, cur, rt_ig(c_accd, s));
        cur = e1str(out, cur, " ncons ");
        cur = e1i64(out, cur, rt_ig(c_ncons, s));
        cur = e1str(out, cur, " fc ");
        let fo2:i64 = rt_ig(s_fcoff, s);
        let fl2:i64 = rt_ig(s_fclen, s);
        cur = e1str(out, cur, pool2[fo2..fo2+fl2]);
        cur = e1str(out, cur, " trig ");
        cur = e1i64(out, cur, rt_ig(c_trigep, s));
        cur = e1str(out, cur, " buf ");
        cur = e1i64(out, cur, rt_ig(c_trigbuf, s));
        cur = e1ch(out, cur, 10);
        let so2:i64 = rt_ig(s_seqoff, s);
        let sl2:i64 = rt_ig(s_seqlen, s);
        cur = e1str(out, cur, "SEQ ");
        cur = e1i64(out, cur, s);
        cur = e1ch(out, cur, 32);
        cur = e1str(out, cur, pool2[so2..so2+sl2]);
        cur = e1ch(out, cur, 10);
        s = s + 1;
    }

    // group assignment by sequence equality
    let g:[]u8 = rt_alloc(maxs * 8);
    let ngroups:i64 = 0;
    s = 0;
    while(s < n) {
        let found:i64 = -1;
        let t:i64 = 0;
        while(t < s && found < 0) {
            let so_a:i64 = rt_ig(s_seqoff, s);
            let sl_a:i64 = rt_ig(s_seqlen, s);
            let so_b:i64 = rt_ig(s_seqoff, t);
            let sl_b:i64 = rt_ig(s_seqlen, t);
            if(sl_a == sl_b) {
                let sa:[]u8 = pool2[so_a..so_a+sl_a];
                let sb2:[]u8 = pool2[so_b..so_b+sl_b];
                if(_zag_strcmp(sa, sb2) == 1) { found = rt_ig(g, t); }
            }
            t = t + 1;
        }
        if(found < 0) { found = ngroups; ngroups = ngroups + 1; }
        rt_is(g, s, found);
        s = s + 1;
    }
    let d:i64 = ngroups;
    let cmax:i64 = 0;
    let gg:i64 = 0;
    while(gg < ngroups) {
        let cnt:i64 = 0;
        s = 0;
        while(s < n) {
            if(rt_ig(g, s) == gg) { cnt = cnt + 1; }
            s = s + 1;
        }
        if(cnt > cmax) { cmax = cnt; }
        gg = gg + 1;
    }
    // T: distinct first-trial classes
    let t2:i64 = 0;
    s = 0;
    while(s < n) {
        let isnew:bool = true;
        let u:i64 = 0;
        while(u < s) {
            let fo_a:i64 = rt_ig(s_fcoff, s);
            let fl_a:i64 = rt_ig(s_fclen, s);
            let fo_b:i64 = rt_ig(s_fcoff, u);
            let fl_b:i64 = rt_ig(s_fclen, u);
            if(fl_a == fl_b) {
                let fa:[]u8 = pool2[fo_a..fo_a+fl_a];
                let fb:[]u8 = pool2[fo_b..fo_b+fl_b];
                if(_zag_strcmp(fa, fb) == 1) { isnew = false; }
            }
            u = u + 1;
        }
        if(isnew) { t2 = t2 + 1; }
        s = s + 1;
    }
    // R
    let r:i64 = 0;
    s = 0;
    while(s < n) {
        if(rt_ig(c_accn, s) < rt_ig(c_accd, s)) { r = r + 1; }
        s = s + 1;
    }
    cur = e1str(out, cur, "SUMMARY N=");
    cur = e1i64(out, cur, n);
    cur = e1str(out, cur, " R=");
    cur = e1i64(out, cur, r);
    cur = e1str(out, cur, " T=");
    cur = e1i64(out, cur, t2);
    cur = e1str(out, cur, " D_ops=");
    cur = e1i64(out, cur, d);
    cur = e1str(out, cur, " Cmax_ops=");
    cur = e1i64(out, cur, cmax);
    cur = e1ch(out, cur, 10);
    // group listing with member seeds and the sequence
    gg = 0;
    while(gg < ngroups) {
        cur = e1str(out, cur, "GROUP ");
        cur = e1i64(out, cur, gg);
        cur = e1str(out, cur, " seeds");
        s = 0;
        while(s < n) {
            if(rt_ig(g, s) == gg) {
                cur = e1ch(out, cur, 32);
                cur = e1i64(out, cur, s);
            }
            s = s + 1;
        }
        cur = e1ch(out, cur, 10);
        // print the sequence from the first member
        s = 0;
        while(s < n && rt_ig(g, s) != gg) { s = s + 1; }
        let so3:i64 = rt_ig(s_seqoff, s);
        let sl3:i64 = rt_ig(s_seqlen, s);
        cur = e1str(out, cur, "GSEQ ");
        cur = e1i64(out, cur, gg);
        cur = e1ch(out, cur, 32);
        cur = e1str(out, cur, pool2[so3..so3+sl3]);
        cur = e1ch(out, cur, 10);
        gg = gg + 1;
    }
    let rc:i64 = _zag_write_file(rout, out[0..cur]);
    if(rc < 0) { return 3; }
    return 0;
}

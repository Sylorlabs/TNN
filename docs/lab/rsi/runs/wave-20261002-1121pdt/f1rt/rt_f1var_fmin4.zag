// f1_learn.zag
// F1 candidate: incremental executable-structure constructor over the frozen
// ISA in f1_isa.zag. Experience loop:
//   predict with EXECUTE(main, frame) -> monitor own prediction failures ->
//   on a windowed failure-density trigger (at least FMIN failures among the
//   last WIN truth-episodes) run a construction burst: deterministic trial
//   over single-ISA-element insertions placed before the terminal WRITE node,
//   committing the first strictly-improving move found in frozen ISA order
//   (up to KB events per burst). Each event is logged with its episode index.
// The windowed trigger replaces the old K1 consecutive-failure counter: it
// fires on interleaved error streams (the normal case outside sorted
// curricula) while preserving the old fire condition as a special case
// (2 consecutive failures are 2 failures in the window). It is generic
// machinery: it monitors only the learner's own error stream, with no
// domain content and no semantic cases.
// Created structures persist in learner-created state (state file); the
// white-box trace logs every episode, trigger, construction event, stall,
// and supersession. On counterexample-driven exhaustion (trigger fires, no
// improving single-element move exists, node cap reached) the learner
// snapshots the old graph under a learner-chosen name and restarts from the
// seed: revision by supersession through its own machinery, never a
// researcher patch.
// Trigger constants are disclosed below and frozen at implementation freeze.
// No task knowledge, no domain semantics, no candidate families in source.

@import("rt_f1var_isa.zag")

fn labs(v:i64)i64 { if(v < 0) { return 0 - v; } return v; }

// Disclosed trigger constants (frozen at implementation freeze).
// WIN/FMIN define the windowed failure-density trigger: fire when at least
// FMIN of the last WIN truth-episodes were prediction failures (err > 0).
// WIN matches the BUFN trial-buffer horizon: the trigger fires on the same
// episode horizon the trial evaluates. FMIN=2 is the minimal evidence that
// distinguishes a failure pattern from a single fluke, preserving the old
// K1=2 conservatism while generalizing from consecutive to interleaved.
fn WIN()i64 { return 8; }    // failure-monitor window (truth-episodes)
fn FMIN()i64 { return 4; }   // minimum failures in window to fire
fn KB()i64 { return 4; }     // max construction events per trigger burst
fn MAXN()i64 { return 24; }  // node cap: exhaustion -> supersede, not stall
fn BUFN()i64 { return 8; }   // episode buffer for trial evaluation
fn MAXEP()i64 { return 4096; }
fn MAXIN()i64 { return 4; }

// ---------- episode parsing ----------

fn count_tok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn get_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

// xs: n_ep x 4 cells; ys, hasy: n_ep cells. Returns episode count or -1.
fn parse_episodes(text:[]u8, xs:[]u8, ys:[]u8, hasy:[]u8, n_in:[]u8)i64 {
    let pos:[]u8 = f1_alloc(8);
    if(pos.len == 0) { return -1; }
    let n:i64 = 0;
    let nin:i64 = -1;
    while(ln_more(text, pos) == 1 && n < MAXEP()) {
        let line:[]u8 = ln_next(text, pos);
        if(line.len > 0) {
            let nt:i64 = count_tok(line);
            if(nt < 2 || nt - 1 > MAXIN()) { return -1; }
            if(nin < 0) { nin = nt - 1; f1_is(n_in, 0, nin); }
            if(nt - 1 != nin) { return -1; }
            let k:i64 = 0;
            while(k < nin) {
                f1_is(xs, n * 4 + k, _zag_str_to_i64(get_tok(line, k)));
                k = k + 1;
            }
            let yt:[]u8 = get_tok(line, nt - 1);
            if(_zag_strcmp(yt, "?") == 1) {
                f1_is(hasy, n, 0);
                f1_is(ys, n, 0);
            } else {
                f1_is(hasy, n, 1);
                f1_is(ys, n, _zag_str_to_i64(yt));
            }
            n = n + 1;
        }
    }
    return n;
}

// ---------- experience buffer (last BUFN episodes with truth) ----------

fn buf_push(bxs:[]u8, bys:[]u8, bn:[]u8, xs:[]u8, erow:i64, y:i64)void {
    let n:i64 = f1_ig(bn, 0);
    if(n == BUFN()) {
        let i:i64 = 0;
        while(i < BUFN() - 1) {
            let k:i64 = 0;
            while(k < 4) { f1_is(bxs, i * 4 + k, f1_ig(bxs, (i + 1) * 4 + k)); k = k + 1; }
            f1_is(bys, i, f1_ig(bys, i + 1));
            i = i + 1;
        }
        n = BUFN() - 1;
    }
    let k:i64 = 0;
    while(k < 4) { f1_is(bxs, n * 4 + k, f1_ig(xs, erow * 4 + k)); k = k + 1; }
    f1_is(bys, n, y);
    f1_is(bn, 0, n + 1);
}

fn buf_err_b(S:[]u8, gi:i64, bxs:[]u8, bys:[]u8, bn:[]u8, n_in:i64, bound:i64,
              regs:[]u8, frame:[]u8)i64 {
    let e:i64 = 0;
    let n:i64 = f1_ig(bn, 0);
    let i:i64 = 0;
    while(i < n) {
        let k:i64 = 0;
        while(k < 8) { f1_is(regs, k, 0); k = k + 1; }
        f1_is(frame, 0, n_in);
        k = 0;
        while(k < n_in) { f1_is(frame, 1 + k, f1_ig(bxs, i * 4 + k)); k = k + 1; }
        let p:i64 = f1_exec(S, gi, regs, frame, 0, "");
        e = e + labs(p - f1_ig(bys, i));
        // Pure speed: a candidate that already reaches the bound cannot beat
        // it strictly, so aborting changes no decision.
        if(e >= bound) { return e; }
        i = i + 1;
    }
    return e;
}

fn buf_err(S:[]u8, gi:i64, bxs:[]u8, bys:[]u8, bn:[]u8, n_in:i64)i64 {
    let regs:[]u8 = f1_alloc(64);
    let frame:[]u8 = f1_alloc(48);
    if(regs.len == 0 || frame.len == 0) { return 999999999; }
    return buf_err_b(S, gi, bxs, bys, bn, n_in, 999999999999, regs, frame);
}

// ---------- windowed failure-density trigger ----------
// Sliding window over the last WIN truth-episodes, each recorded as 1
// (prediction failure, err > 0) or 0. win: WIN cells; wnn: 1 cell holding
// the current fill count. Push shifts when full. win_fails counts the
// failures currently in the window. Fire when win_fails >= FMIN; the
// caller clears the window after firing so the same failures cannot
// retrigger. Generic: the window records only the learner's own binary
// error stream, no domain content.

fn win_push(win:[]u8, wnn:[]u8, failed:i64)void {
    let n:i64 = f1_ig(wnn, 0);
    if(n == WIN()) {
        let j:i64 = 0;
        while(j < WIN() - 1) {
            f1_is(win, j, f1_ig(win, j + 1));
            j = j + 1;
        }
        n = WIN() - 1;
    }
    f1_is(win, n, failed);
    f1_is(wnn, 0, n + 1);
}

fn win_fails(win:[]u8, wnn:[]u8)i64 {
    let c:i64 = 0;
    let n:i64 = f1_ig(wnn, 0);
    let j:i64 = 0;
    while(j < n) {
        c = c + f1_ig(win, j);
        j = j + 1;
    }
    return c;
}

// ---------- deterministic single-element trial ----------
// Evaluates every single-ISA-element insertion (before the terminal WRITE)
// in frozen ISA order over runtime registers and frame slots, keeping the
// first strictly-improving move. res cells: 0 found,1 op,2 p1,3 p2,4 p3,
// 5 err_after.

fn write_rec(S:[]u8, r:i64, op:i64, p1:i64, p2:i64, p3:i64, p4:i64, p5:i64)void {
    nd_set(S, r, 0, op);
    nd_set(S, r, 1, p1);
    nd_set(S, r, 2, p2);
    nd_set(S, r, 3, p3);
    nd_set(S, r, 4, p4);
    nd_set(S, r, 5, p5);
}

fn trial_move(S:[]u8, gi:i64, n_in:i64, nnamed:i64, bxs:[]u8, bys:[]u8, bn:[]u8, res:[]u8)void {
    let base:i64 = buf_err(S, gi, bxs, bys, bn, n_in);
    f1_is(res, 0, 0);
    f1_is(res, 1, 0);
    f1_is(res, 2, 0);
    f1_is(res, 3, 0);
    f1_is(res, 4, 0);
    f1_is(res, 5, base);
    let cnt:i64 = st_gcount(S, gi);
    let start:i64 = st_gstart(S, gi);
    if(cnt < 1) { return; }
    let pos:i64 = cnt - 1;
    // Save the terminal record once; each candidate is tried as:
    //   [candidate at pos][terminal at pos+1], then the terminal is restored.
    let tmp:[]u8 = f1_alloc(48);
    if(tmp.len == 0) { return; }
    // Hoisted scratch (pure speed; no decision changes): one register file
    // and frame reused across all candidate evaluations in this trial.
    let regs:[]u8 = f1_alloc(64);
    let frame:[]u8 = f1_alloc(48);
    if(regs.len == 0 || frame.len == 0) { return; }
    let f:i64 = 0;
    while(f < 6) { f1_is(tmp, f, nd_get(S, start + pos, f)); f = f + 1; }
    let op:i64 = 1;
    while(op <= 7) {
        let r1n:i64 = 0;
        let r2n:i64 = 0;
        let r3n:i64 = 0;
        let skip:i64 = 0;
        if(op == 1) { r1n = 8; r2n = n_in; r3n = 1; }
        else if(op == 2) { r1n = 8 + n_in; r2n = 1; r3n = 1; }
        else if(op == 3) { r1n = 8; r2n = 8 + n_in; r3n = 1; }
        else if(op == 4) { r1n = 8; r2n = 8 + n_in; r3n = 8 + n_in; }
        else if(op == 5) { r1n = 8; r2n = 8 + n_in; r3n = 8 + n_in; }
        else if(op == 6) { r1n = 8; r2n = cnt; r3n = 1; }
        else if(op == 7) {
            if(nnamed < 2) { skip = 1; } else { r1n = 8; r2n = nnamed - 1; r3n = 1; }
        }
        if(skip == 0) {
            let a:i64 = 0;
            while(a < r1n) {
                let b:i64 = 0;
                while(b < r2n) {
                    let c:i64 = 0;
                    while(c < r3n) {
                        let p1:i64 = a;
                        let p2:i64 = b;
                        let p3:i64 = c;
                        if(op == 1) { p2 = 8 + b; p3 = 0; }
                        else if(op == 2) { p2 = 0; p3 = 0; }
                        else if(op == 6) { p3 = 0; }
                        else if(op == 7) { p2 = 1 + b; p3 = 0; }
                        write_rec(S, start + pos, op, p1, p2, p3, 0, 0);
                        let g:i64 = 0;
                        while(g < 6) { nd_set(S, start + pos + 1, g, f1_ig(tmp, g)); g = g + 1; }
                        st_gsetcount(S, gi, cnt + 1);
                        let e:i64 = buf_err_b(S, gi, bxs, bys, bn, n_in, f1_ig(res, 5), regs, frame);
                        st_gsetcount(S, gi, cnt);
                        g = 0;
                        while(g < 6) { nd_set(S, start + pos, g, f1_ig(tmp, g)); g = g + 1; }
                        if(e < f1_ig(res, 5)) {
                            f1_is(res, 0, 1);
                            f1_is(res, 1, op);
                            f1_is(res, 2, p1);
                            f1_is(res, 3, p2);
                            f1_is(res, 4, p3);
                            f1_is(res, 5, e);
                        }
                        c = c + 1;
                    }
                    b = b + 1;
                }
                a = a + 1;
            }
        }
        op = op + 1;
    }
    // Terminal record restored after the last candidate by the loop above.
}

// Commit the move in res (insert before the terminal WRITE), log the event.
fn commit_move(S:[]u8, gi:i64, res:[]u8, ep:i64, seq:i64, err_before:i64,
               tb:[]u8, tl:[]u8)void {
    let cnt:i64 = st_gcount(S, gi);
    let pos:i64 = cnt - 1;
    let op:i64 = f1_ig(res, 1);
    let p1:i64 = f1_ig(res, 2);
    let p2:i64 = f1_ig(res, 3);
    let p3:i64 = f1_ig(res, 4);
    let id:i64 = st_ninsert(S, gi, pos, op, p1, p2, p3, 0, 0);
    sb_put(tb, tl, "CONSTRUCT ");
    sb_i64(tb, tl, ep);
    sb_ch(tb, tl, 32);
    sb_i64(tb, tl, seq);
    sb_put(tb, tl, " NODE id=");
    sb_i64(tb, tl, id);
    sb_put(tb, tl, " op=");
    sb_put(tb, tl, op_name(op));
    sb_put(tb, tl, " p1=");
    sb_i64(tb, tl, p1);
    sb_put(tb, tl, " p2=");
    sb_i64(tb, tl, p2);
    sb_put(tb, tl, " p3=");
    sb_i64(tb, tl, p3);
    sb_put(tb, tl, " err_before=");
    sb_i64(tb, tl, err_before);
    sb_put(tb, tl, " err_after=");
    sb_i64(tb, tl, f1_ig(res, 5));
    sb_ch(tb, tl, 10);
}

// Snapshot the working graph under a learner-chosen name and restart from
// the seed. Revision by supersession through the learner's own machinery.
fn do_supersede(S:[]u8, gi:i64, ep:i64, nnamed:[]u8, tb:[]u8, tl:[]u8, stats:[]u8)void {
    let oldcount:i64 = st_gcount(S, gi);
    let newid:i64 = f1_ig(nnamed, 0);
    let ngi:i64 = st_snapshot(S, gi, newid);
    st_reset_graph(S, gi);
    st_nadd(S, gi, 2, 0, 0, 0, 0, 0);
    f1_is(nnamed, 0, newid + 1);
    f1_is(stats, 1, f1_ig(stats, 1) + 1);
    sb_put(tb, tl, "SUPERSEDE ");
    sb_i64(tb, tl, ep);
    sb_put(tb, tl, " old=");
    sb_put(tb, tl, gname(newid));
    sb_put(tb, tl, " new=main reason=node_cap nodes=");
    sb_i64(tb, tl, oldcount);
    sb_put(tb, tl, " snap_gi=");
    sb_i64(tb, tl, ngi);
    sb_ch(tb, tl, 10);
}

// Construction burst after a trigger: up to KB committed events.
fn burst(S:[]u8, gi:i64, ep:i64, n_in:i64, nnamed:[]u8, bxs:[]u8, bys:[]u8,
         bn:[]u8, tb:[]u8, tl:[]u8, stats:[]u8)void {
    let seq:i64 = 0;
    while(seq < KB()) {
        // Solved on the buffer: stop quietly, this is not a stall.
        if(buf_err(S, gi, bxs, bys, bn, n_in) == 0) { return; }
        let res:[]u8 = f1_alloc(48);
        if(res.len == 0) { return; }
        trial_move(S, gi, n_in, f1_ig(nnamed, 0), bxs, bys, bn, res);
        if(f1_ig(res, 0) == 0) {
            if(st_gcount(S, gi) >= MAXN()) {
                do_supersede(S, gi, ep, nnamed, tb, tl, stats);
            } else {
                f1_is(stats, 2, f1_ig(stats, 2) + 1);
                sb_put(tb, tl, "STALL ");
                sb_i64(tb, tl, ep);
                sb_put(tb, tl, " nodes=");
                sb_i64(tb, tl, st_gcount(S, gi));
                sb_put(tb, tl, " buf_err=");
                sb_i64(tb, tl, buf_err(S, gi, bxs, bys, bn, n_in));
                sb_ch(tb, tl, 10);
            }
            return;
        }
        let err_before:i64 = buf_err(S, gi, bxs, bys, bn, n_in);
        commit_move(S, gi, res, ep, seq, err_before, tb, tl);
        f1_is(stats, 0, f1_ig(stats, 0) + 1);
        seq = seq + 1;
    }
}

fn main()i32 {
    if(_zag_argc() < 6) {
        _zag_println("usage: f1_learn episodes state_in|- state_out trace pred");
        return 2;
    }
    let epf:[]u8 = _zag_arg(1);
    let sin:[]u8 = _zag_arg(2);
    let sout:[]u8 = _zag_arg(3);
    let trf:[]u8 = _zag_arg(4);
    let prf:[]u8 = _zag_arg(5);

    let text:[]u8 = _zag_read_file(epf);
    if(text.len == 0) { _zag_println("ERR empty_episodes"); return 2; }
    let xs:[]u8 = f1_alloc(MAXEP() * 4 * 8);
    let ys:[]u8 = f1_alloc(MAXEP() * 8);
    let hasy:[]u8 = f1_alloc(MAXEP() * 8);
    let n_in_b:[]u8 = f1_alloc(8);
    if(xs.len == 0 || ys.len == 0 || hasy.len == 0 || n_in_b.len == 0) {
        _zag_println("ERR alloc"); return 2;
    }
    let n_ep:i64 = parse_episodes(text, xs, ys, hasy, n_in_b);
    if(n_ep < 0) { _zag_println("ERR parse_episodes"); return 2; }
    let n_in:i64 = f1_ig(n_in_b, 0);

    let S:[]u8 = st_new();
    if(S.len == 0) { _zag_println("ERR alloc_state"); return 2; }
    if(_zag_strcmp(sin, "-") != 1) {
        let st:[]u8 = _zag_read_file(sin);
        if(st.len > 0) {
            let L:[]u8 = st_load(st);
            if(L.len > 0) { S = L; }
            else { _zag_println("WARN state_load_failed_using_fresh"); }
        }
    }
    let gi:i64 = st_find(S, 0);
    if(gi < 0) { _zag_println("ERR no_main"); return 2; }
    // nnamed: next learner-chosen name id (0 is main; 1.. are snapshots)
    let nnamed:[]u8 = f1_alloc(8);
    if(nnamed.len == 0) { _zag_println("ERR alloc"); return 2; }
    let nid:i64 = 1;
    while(st_find(S, nid) >= 0) { nid = nid + 1; }
    f1_is(nnamed, 0, nid);

    let tb:[]u8 = f1_alloc(1048576);
    let tl:[]u8 = f1_alloc(8);
    let pb:[]u8 = f1_alloc(262144);
    let pl:[]u8 = f1_alloc(8);
    let bxs:[]u8 = f1_alloc(BUFN() * 4 * 8);
    let bys:[]u8 = f1_alloc(BUFN() * 8);
    let bn:[]u8 = f1_alloc(8);
    let win:[]u8 = f1_alloc(WIN() * 8);
    let wnn:[]u8 = f1_alloc(8);
    let xc:[]u8 = f1_alloc(64);
    let stats:[]u8 = f1_alloc(32);
    if(tb.len == 0 || tl.len == 0 || pb.len == 0 || pl.len == 0 ||
       bxs.len == 0 || bys.len == 0 || bn.len == 0 || win.len == 0 ||
       wnn.len == 0 || xc.len == 0 || stats.len == 0) {
        _zag_println("ERR alloc"); return 2;
    }

    let regs:[]u8 = f1_alloc(64);
    let frame:[]u8 = f1_alloc(48);
    if(regs.len == 0 || frame.len == 0) { _zag_println("ERR alloc"); return 2; }

    // Failure-monitor window (win/wnn) replaces the old consecutive counter.
    let i:i64 = 0;
    while(i < n_ep) {
        let k:i64 = 0;
        while(k < 8) { f1_is(regs, k, 0); k = k + 1; }
        f1_is(frame, 0, n_in);
        k = 0;
        while(k < n_in) { f1_is(frame, 1 + k, f1_ig(xs, i * 4 + k)); k = k + 1; }
        let p:i64 = f1_exec(S, gi, regs, frame, 0, xc);
        // prediction line: inputs then prediction
        k = 0;
        while(k < n_in) {
            sb_i64(pb, pl, f1_ig(xs, i * 4 + k));
            sb_ch(pb, pl, 32);
            k = k + 1;
        }
        sb_i64(pb, pl, p);
        sb_ch(pb, pl, 10);
        // trace EP line
        sb_put(tb, tl, "EP ");
        sb_i64(tb, tl, i);
        k = 0;
        while(k < n_in) {
            sb_put(tb, tl, " x");
            sb_i64(tb, tl, k);
            sb_ch(tb, tl, 61);
            sb_i64(tb, tl, f1_ig(xs, i * 4 + k));
            k = k + 1;
        }
        sb_put(tb, tl, " pred=");
        sb_i64(tb, tl, p);
        if(f1_ig(hasy, i) == 1) {
            let t:i64 = f1_ig(ys, i);
            let e:i64 = labs(p - t);
            sb_put(tb, tl, " true=");
            sb_i64(tb, tl, t);
            sb_put(tb, tl, " err=");
            sb_i64(tb, tl, e);
            sb_ch(tb, tl, 10);
            buf_push(bxs, bys, bn, xs, i, t);
            let failed:i64 = 0;
            if(e > 0) { failed = 1; }
            win_push(win, wnn, failed);
            let wf:i64 = win_fails(win, wnn);
            if(wf >= FMIN()) {
                sb_put(tb, tl, "TRIGGER ");
                sb_i64(tb, tl, i);
                sb_put(tb, tl, " winfail=");
                sb_i64(tb, tl, wf);
                sb_put(tb, tl, " win=");
                sb_i64(tb, tl, f1_ig(wnn, 0));
                sb_put(tb, tl, " buf=");
                sb_i64(tb, tl, f1_ig(bn, 0));
                sb_ch(tb, tl, 10);
                burst(S, gi, i, n_in, nnamed, bxs, bys, bn, tb, tl, stats);
                f1_is(wnn, 0, 0);
            }
        } else {
            sb_put(tb, tl, " true=?");
            sb_ch(tb, tl, 10);
        }
        i = i + 1;
    }

    // reuse-invocation evidence: executions per named structure this run
    let eid:i64 = 0;
    while(eid < f1_ig(nnamed, 0)) {
        if(st_find(S, eid) >= 0) {
            sb_put(tb, tl, "EXEC ");
            sb_put(tb, tl, gname(eid));
            sb_ch(tb, tl, 32);
            sb_i64(tb, tl, f1_ig(xc, eid));
            sb_ch(tb, tl, 10);
        }
        eid = eid + 1;
    }
    sb_put(tb, tl, "SUMMARY episodes=");
    sb_i64(tb, tl, n_ep);
    sb_put(tb, tl, " constructs=");
    sb_i64(tb, tl, f1_ig(stats, 0));
    sb_put(tb, tl, " supersedes=");
    sb_i64(tb, tl, f1_ig(stats, 1));
    sb_put(tb, tl, " stalls=");
    sb_i64(tb, tl, f1_ig(stats, 2));
    sb_put(tb, tl, " main_nodes=");
    sb_i64(tb, tl, st_gcount(S, gi));
    sb_ch(tb, tl, 10);

    // persist learner-created state
    let sb:[]u8 = f1_alloc(262144);
    let sl:[]u8 = f1_alloc(8);
    if(sb.len == 0 || sl.len == 0) { _zag_println("ERR alloc"); return 2; }
    st_save(S, sb, sl);
    let rc1:i64 = _zag_write_file(sout, sb_done(sb, sl));
    let rc2:i64 = _zag_write_file(trf, sb_done(tb, tl));
    let rc3:i64 = _zag_write_file(prf, sb_done(pb, pl));
    _zag_print("WROTE state=");
    _zag_print(_zag_i64_to_str(rc1));
    _zag_print(" trace=");
    _zag_print(_zag_i64_to_str(rc2));
    _zag_print(" pred=");
    _zag_println(_zag_i64_to_str(rc3));
    _zag_print("SUMMARY constructs=");
    _zag_print(_zag_i64_to_str(f1_ig(stats, 0)));
    _zag_print(" supersedes=");
    _zag_print(_zag_i64_to_str(f1_ig(stats, 1)));
    _zag_print(" stalls=");
    _zag_println(_zag_i64_to_str(f1_ig(stats, 2)));
    return 0;
}


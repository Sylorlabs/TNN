// rt_mask.zag - mask the truth column of an .ep file with "?" (hidden-mode).
// usage: rt_mask <in.ep> <out.ep>
// Pure Zag; output via _zag_write_file.
fn main()i32 {
    if(_zag_argc() < 3) { return 2; }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { return 2; }
    let p:*u8 = _zag_malloc(text.len + 16) as *u8;
    if(p == null as *u8) { return 2; }
    let out:[]u8 = p[0..text.len + 16];
    let n:i64 = 0;
    let i:i64 = 0;
    while(i < text.len) {
        let q:i64 = i;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        // find last space in line [i..q)
        let ls:i64 = q - 1;
        while(ls >= i && text[ls] != 32) { ls = ls - 1; }
        if(ls < i) { return 2; }
        let k:i64 = i;
        while(k <= ls) { out[n] = text[k]; n = n + 1; k = k + 1; }
        out[n] = 63; n = n + 1; // '?'
        if(q < text.len) { out[n] = 10; n = n + 1; }
        i = q + 1;
    }
    let rc:i64 = _zag_write_file(_zag_arg(2), out[0..n]);
    if(rc < 0) { return 3; }
    return 0;
}

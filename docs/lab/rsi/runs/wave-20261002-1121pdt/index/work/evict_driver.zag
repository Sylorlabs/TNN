// evict_driver.zag -- sealed eviction-storm instrument, INDEX-EVICT lane.
// W1: MAP storm (mode 3 = MAP index + MTF). W2: FACT storm (mode 4).
// This ONE driver file is assembled into both the OLD binary (0221pdt fixed
// patch, eviction untouched) and the NEW binary (index-coherent eviction).
// All eviction goes through the production evict_node; victim TAGs and gate
// verdicts are emitted after every eviction. Pure Zag.
fn st_big()[]u8 { let W:[]u8=z_alloc(593984); return W; }
fn st_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){ ev_teach(W,s0+k,1,s0+k+1); k=k+1; }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn st_gates(W:[]u8,tag:[]u8)void {
  emit(tag); emit(" gates idx="); e64(idx_validate(W));
  emit(" fidx="); e64(fidx_validate(W)); emit("\n");
  return;
}
// First violator cause: 0=none, 1=dead member, 2=wrong tag, 3=plen mismatch,
// 4=FACT-side violator. Pure reads.
fn st_cause(W:[]u8)i32 {
  let ix:i32=idx_node(W);
  if(ix>=0){
    let q:i32=2;
    while(q<=5){
      let m:i32=ng(W,ix,idx_bfield(q));
      let steps:i32=0;
      while(m>=0 && m<8192 && steps<8192){
        if(ng(W,m,36)!=1){ return 1; }
        if(ng(W,m,0)!=20){ return 2; }
        let root:i32=ng(W,m,20);
        if(root<0 || root>=8192 || rb_chain_plen(W,root)!=q){ return 3; }
        m=ng(W,m,12); steps=steps+1;
      }
      q=q+1;
    }
  }
  return 4;
}
// Protect every live tag-3 record node so the kill loop cannot starve on
// bid-0 records (records outrank MAP victims at bid 2; without this the
// loop ping-pongs on reused record slots forever).
fn st_protect_tag3(W:[]u8)void {
  let n:i32=2;
  while(n<8192){
    if(ng(W,n,36)==1){ if(ng(W,n,0)==3){ link_edge(W,n,9,n,1000000); } }
    n=n+1;
  }
}

fn st_vpush(vbuf:[]u8,nv:i32,id:i32,W:[]u8,tagwant:i32)i32 {
  if(id<2 || id>=8192){ return nv; }
  if(ng(W,id,36)!=1 || ng(W,id,0)!=tagwant){ return nv; }
  let i:i32=0;
  while(i<nv){ if(get32(vbuf,i*4)==id){ return nv; } i=i+1; }
  set32(vbuf,nv*4,id);
  return nv+1;
}
// Protect every live node except the nv victims (codebase protection idiom:
// type-9 self edge, weight far above decay range). Lets the storm target
// exact victims through the real evict_node selection.
fn st_protect(W:[]u8,vbuf:[]u8,nv:i32)void {
  let n:i32=2;
  while(n<8192){
    if(ng(W,n,36)==1){
      let i:i32=0; let isv:i32=0;
      while(i<nv){ if(get32(vbuf,i*4)==n){ isv=1; } i=i+1; }
      if(isv==0){ link_edge(W,n,9,n,1000000); }
    }
    n=n+1;
  }
  return;
}
fn st_cache(W:[]u8)i32 { return ng(W,idx_node(W),12); }
fn w1()void {
  emit("W1-START\n");
  let W:[]u8=st_big(); tnn2_init(W); idx_mode_set(W,3);
  ev_teach(W,6101,1,6102); ev_teach(W,6102,1,6103);
  ev_teach(W,6103,1,6104); ev_teach(W,6104,1,6105);
  ev_teach(W,6201,1,6202); ev_teach(W,6202,1,6203);
  ev_teach(W,6203,1,6204); ev_teach(W,6204,1,6205);
  let i:i32=0;
  while(i<30){ if(st_mkchain(W,2000+i*10,5,51,2004+i*10)<0){emit("W1 mk FAIL\n");} i=i+1; }
  i=0;
  while(i<8){ if(st_mkchain(W,8000+i*10,3,51,8002+i*10)<0){emit("W1 mk3 FAIL\n");} i=i+1; }
  st_gates(W,"W1 HEALTH");
  hs(W,56,0); let a0:i32=ev_query(W,6101,50,6105,0); let s0:i32=hg(W,56);
  hs(W,56,0); let a1:i32=ev_query(W,6201,50,6205,0); let s1:i32=hg(W,56);
  emit("W1 QPRE q0 ans="); e64(a0); emit(" scan="); e64(s0); emit(" ok="); e64(a0==6105); emit("\n");
  emit("W1 QPRE q1 ans="); e64(a1); emit(" scan="); e64(s1); emit(" ok="); e64(a1==6205); emit("\n");
  // Phase A: natural burst, 8 evictions, no selection control.
  emit("W1 PHASEA natural-burst\n");
  let k:i32=0; let flipped:i32=0;
  while(k<8){
    let v:i32=evict_node(W);
    if(v<0){ emit("W1 PA EVICT-EMPTY\n"); k=8; }
    else {
      emit("W1 PA k="); e64(k); emit(" v="); e64(v); emit(" tag="); e64(ng(W,v,0));
      emit(" idx="); e64(idx_validate(W)); emit(" fidx="); e64(fidx_validate(W)); emit("\n");
      if(flipped==0 && idx_validate(W)==0){
        emit("W1 PA FIRSTFLIP cause="); e64(st_cause(W)); emit("\n"); flipped=1;
      }
      k=k+1;
    }
  }
  // Refresh the MTF winner after Phase A, then choose targeted victims:
  // winner, plen-5 head/mid/tail, plen-3 head/tail (adversarial positions).
  hs(W,56,0); let a0b:i32=ev_query(W,6101,50,6105,0);
  emit("W1 REFRESH ans="); e64(a0b); emit(" ok="); e64(a0b==6105); emit("\n");
  let wc:i32=st_cache(W);
  let wm:i32=-1; if(wc>=0){ wm=wc/8; }
  let ix:i32=idx_node(W);
  let h5:i32=ng(W,ix,32); let h3:i32=ng(W,ix,24);
  let m5:i32=h5; let c:i32=0;
  while(c<5 && m5>=0 && m5<8192){ m5=ng(W,m5,12); c=c+1; }
  let t5:i32=h5; c=0;
  while(t5>=0 && t5<8192 && ng(W,t5,12)>=0 && c<8192){ t5=ng(W,t5,12); c=c+1; }
  let t3:i32=h3; c=0;
  while(t3>=0 && t3<8192 && ng(W,t3,12)>=0 && c<8192){ t3=ng(W,t3,12); c=c+1; }
  let vbuf:[]u8=z_alloc(64);
  let nv:i32=0;
  nv=st_vpush(vbuf,nv,wm,W,20);
  nv=st_vpush(vbuf,nv,h5,W,20); nv=st_vpush(vbuf,nv,m5,W,20);
  nv=st_vpush(vbuf,nv,t5,W,20); nv=st_vpush(vbuf,nv,h3,W,20);
  nv=st_vpush(vbuf,nv,t3,W,20);
  emit("W1 PBVICTIMS nv="); e64(nv); emit(" winner="); e64(wm); emit("\n");
  st_protect(W,vbuf,nv);
  emit("W1 PHASEB targeted-burst\n");
  let k20:i32=0; let calls:i32=0; flipped=0;
  while(k20<nv && calls<50){
    st_protect_tag3(W);
    let v:i32=evict_node(W);
    if(v<0){ emit("W1 PB EVICT-EMPTY\n"); calls=50; }
    else {
      calls=calls+1;
      let t:i32=ng(W,v,0);
      if(t==20){ k20=k20+1; }
      emit("W1 PB c="); e64(calls); emit(" v="); e64(v); emit(" tag="); e64(t);
      emit(" k20="); e64(k20); emit(" idx="); e64(idx_validate(W));
      emit(" fidx="); e64(fidx_validate(W));
      emit(" cache="); e64(st_cache(W)); emit("\n");
      if(flipped==0 && idx_validate(W)==0){
        emit("W1 PB FIRSTFLIP cause="); e64(st_cause(W)); emit("\n"); flipped=1;
      }
    }
  }
  emit("W1 PB done k20="); e64(k20); emit(" nv="); e64(nv); emit(" calls="); e64(calls); emit("\n");
  // Phase D: churn. New MAPs + FACTs reuse dead victim slots.
  // Fresh query chains (6301/6401) so QPOST2 must rebind through the index
  // (re-querying 6101/6201 would hit activate() on the taught FACT).
  i=0;
  while(i<6){ if(st_mkchain(W,3000+i*10,5,51,3004+i*10)<0){emit("W1 churn mk FAIL\n");} i=i+1; }
  i=0;
  while(i<12){ ev_teach(W,7000+i,1,8000+i); i=i+1; }
  ev_teach(W,6301,1,6302); ev_teach(W,6302,1,6303);
  ev_teach(W,6303,1,6304); ev_teach(W,6304,1,6305);
  ev_teach(W,6401,1,6402); ev_teach(W,6402,1,6403);
  ev_teach(W,6403,1,6404); ev_teach(W,6404,1,6405);
  st_gates(W,"W1 CHURN");
  hs(W,56,0); let b0:i32=ev_query(W,6101,50,6105,0); let t0:i32=hg(W,56);
  hs(W,56,0); let b1:i32=ev_query(W,6201,50,6205,0); let t1:i32=hg(W,56);
  emit("W1 QPOST q0 ans="); e64(b0); emit(" scan="); e64(t0); emit(" ok="); e64(b0==6105); emit("\n");
  emit("W1 QPOST q1 ans="); e64(b1); emit(" scan="); e64(t1); emit(" ok="); e64(b1==6205); emit("\n");
  // Clear the MTF winner cache so QPOST2 must walk the bucket (tests the
  // index itself, not the MTF fast path). Identical setup in both binaries.
  ns(W,idx_node(W),12,-1);
  hs(W,56,0); let c0:i32=ev_query(W,6301,50,6305,0); let u0:i32=hg(W,56);
  hs(W,56,0); let c1:i32=ev_query(W,6401,50,6405,0); let u1:i32=hg(W,56);
  emit("W1 QPOST2 q0 ans="); e64(c0); emit(" scan="); e64(u0); emit(" ok="); e64(c0==6305); emit("\n");
  emit("W1 QPOST2 q1 ans="); e64(c1); emit(" scan="); e64(u1); emit(" ok="); e64(c1==6405); emit("\n");
  emit("W1 COUNTERS unmap="); e64(ng(W,0,4)); emit(" unfact="); e64(ng(W,0,8));
  emit(" unchain="); e64(ng(W,0,12)); emit(" cache="); e64(st_cache(W)); emit("\n");
  emit("W1-END\n");
  return;
}
fn w2()void {
  emit("W2-START\n");
  let W:[]u8=st_big(); tnn2_init(W); idx_mode_set(W,4);
  let fbuf:[]u8=z_alloc(1200);
  let i:i32=0;
  while(i<300){ let fn2:i32=ev_teach(W,5000+i,1,9000+i); set32(fbuf,i*4,fn2); i=i+1; }
  ev_teach(W,100,1,101); ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  st_gates(W,"W2 HEALTH");
  let paths:[]u8=z_alloc(4608);
  fcnt_zero(W);
  let np:i32=t2_gather(W,100,paths);
  let gv0:i32=fcnt_get(W);
  fcnt_zero(W);
  i=0; let hits0:i32=0;
  while(i<50){ if(t2_lu_first(W,5000+i*6,1)>=0){ hits0=hits0+1; } i=i+1; }
  let lv0:i32=fcnt_get(W);
  emit("W2 GPRE gather np="); e64(np); emit(" factvisits="); e64(gv0); emit("\n");
  emit("W2 GPRE lu50 hits="); e64(hits0); emit(" factvisits="); e64(lv0); emit("\n");
  // Phase A: natural burst, 10 evictions.
  emit("W2 PHASEA natural-burst\n");
  let k:i32=0; let flipped:i32=0;
  while(k<10){
    let v:i32=evict_node(W);
    if(v<0){ emit("W2 PA EVICT-EMPTY\n"); k=10; }
    else {
      emit("W2 PA k="); e64(k); emit(" v="); e64(v); emit(" tag="); e64(ng(W,v,0));
      emit(" idx="); e64(idx_validate(W)); emit(" fidx="); e64(fidx_validate(W)); emit("\n");
      if(flipped==0 && fidx_validate(W)==0){
        emit("W2 PA FIRSTFLIP cause="); e64(st_cause(W)); emit("\n"); flipped=1;
      }
      k=k+1;
    }
  }
  // Phase B: targeted FACT victims spread across buckets. Their guard edges
  // are removed first (simulating full decay), making them evictable.
  let vbuf:[]u8=z_alloc(64);
  let nv:i32=0;
  nv=st_vpush(vbuf,nv,get32(fbuf,10*4),W,1); nv=st_vpush(vbuf,nv,get32(fbuf,11*4),W,1);
  nv=st_vpush(vbuf,nv,get32(fbuf,34*4),W,1); nv=st_vpush(vbuf,nv,get32(fbuf,35*4),W,1);
  nv=st_vpush(vbuf,nv,get32(fbuf,110*4),W,1); nv=st_vpush(vbuf,nv,get32(fbuf,160*4),W,1);
  nv=st_vpush(vbuf,nv,get32(fbuf,210*4),W,1); nv=st_vpush(vbuf,nv,get32(fbuf,290*4),W,1);
  emit("W2 PBVICTIMS nv="); e64(nv); emit("\n");
  let vi:i32=0;
  while(vi<nv){ let vv:i32=get32(vbuf,vi*4); t2_kill_edge(W,vv,9,vv); vi=vi+1; }
  st_protect(W,vbuf,nv);
  emit("W2 PHASEB targeted-burst\n");
  let k10:i32=0; let calls:i32=0; flipped=0;
  while(k10<nv && calls<50){
    st_protect_tag3(W);
    let v:i32=evict_node(W);
    if(v<0){ emit("W2 PB EVICT-EMPTY\n"); calls=50; }
    else {
      calls=calls+1;
      let t:i32=ng(W,v,0);
      if(t==1){ k10=k10+1; }
      emit("W2 PB c="); e64(calls); emit(" v="); e64(v); emit(" tag="); e64(t);
      emit(" k10="); e64(k10); emit(" idx="); e64(idx_validate(W));
      emit(" fidx="); e64(fidx_validate(W)); emit("\n");
      if(flipped==0 && fidx_validate(W)==0){
        emit("W2 PB FIRSTFLIP cause="); e64(st_cause(W)); emit("\n"); flipped=1;
      }
    }
  }
  emit("W2 PB done k10="); e64(k10); emit(" nv="); e64(nv); emit(" calls="); e64(calls); emit("\n");
  // Phase D: churn. New FACTs reuse dead victim slots.
  i=0;
  while(i<40){ ev_teach(W,6000+i,1,9500+i); i=i+1; }
  st_gates(W,"W2 CHURN");
  fcnt_zero(W);
  let np2:i32=t2_gather(W,100,paths);
  let gv1:i32=fcnt_get(W);
  fcnt_zero(W);
  i=0; let hits1:i32=0;
  while(i<50){ if(t2_lu_first(W,5000+i*6,1)>=0){ hits1=hits1+1; } i=i+1; }
  let lv1:i32=fcnt_get(W);
  emit("W2 GPOST gather np="); e64(np2); emit(" factvisits="); e64(gv1); emit("\n");
  emit("W2 GPOST lu50 hits="); e64(hits1); emit(" factvisits="); e64(lv1); emit("\n");
  emit("W2 COUNTERS unmap="); e64(ng(W,0,4)); emit(" unfact="); e64(ng(W,0,8));
  emit(" unchain="); e64(ng(W,0,12)); emit("\n");
  emit("W2-END\n");
  return;
}
fn main()i32 {
  emit("EVICT-STORM-START\n");
  w1();
  w2();
  emit("EVICT-STORM-END\n");
  return 0;
}

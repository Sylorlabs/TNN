// storm_churn.zag -- the eviction latency cliff: fill to ~8180 live nodes,
// then 15 alloc cycles AT capacity (each alloc forces an eviction).
// Timed via shell; compare per-alloc cost against storm_fill.
fn main()i32 {
  emit("STORM-CHURN-START\n");
  let W:[]u8=sl_big(); tnn2_init(W); idx_mode_set(W,7);
  let i:i32=0;
  while(i<100){
    let plen:i32=2+(i-(i/4)*4);
    if(sl_mkchain(W,20000+i*100,plen,51,20000+i*100+plen-1)<0){
      emit("CHURN mk FAIL\n");
    }
    i=i+1;
  }
  i=0;
  while(hg(W,20)<8180){ ev_teach(W,80000+i,1,90000+i); i=i+1; }
  emit("CHURN filled live="); e64(hg(W,20));
  emit(" deep="); e64(idx_deep_validate(W)); emit("\n");
  i=0;
  while(i<15){
    let a:i32=alloc_node(W);
    if(a<0){ emit("CHURN alloc FAIL\n"); }
    ev_teach(W,100000+i,1,110000+i);
    let dv:i32=idx_deep_validate(W);
    emit("CHURN c="); e64(i); emit(" deep="); e64(dv); emit("\n");
    if(dv==0){ emit("CHURN DEEP-VIOLATION c="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("CHURN done live="); e64(hg(W,20));
  emit(" deep="); e64(idx_deep_validate(W)); emit("\n");
  emit("STORM-CHURN-END\n");
  return 0;
}

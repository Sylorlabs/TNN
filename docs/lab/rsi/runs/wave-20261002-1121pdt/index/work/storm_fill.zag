// storm_fill.zag -- per-alloc cost WITH free space (cliff baseline).
// Timed via shell; stdout stays deterministic (3/3 byte-identical).
fn main()i32 {
  emit("STORM-FILL-START\n");
  let W:[]u8=sl_big(); tnn2_init(W); idx_mode_set(W,7);
  let st:[]u8=z_alloc(4); rnd_init(st,12345);
  let i:i32=0;
  while(i<40){
    let plen:i32=2+rnd_below(st,4);
    if(sl_mkchain(W,20000+i*100,plen,51,20000+i*100+plen-1)<0){
      emit("FILL mk FAIL\n");
    }
    i=i+1;
  }
  i=0;
  while(i<200){ ev_teach(W,30000+i,1,40000+i); i=i+1; }
  emit("FILL built live="); e64(hg(W,20));
  emit(" idx="); e64(idx_validate(W));
  emit(" fidx="); e64(fidx_validate(W));
  emit(" deep="); e64(idx_deep_validate(W)); emit("\n");
  i=0;
  while(i<6000){ ev_teach(W,50000+i,1,60000+i); i=i+1; }
  emit("FILL done live="); e64(hg(W,20));
  emit(" idx="); e64(idx_validate(W));
  emit(" fidx="); e64(fidx_validate(W));
  emit(" deep="); e64(idx_deep_validate(W)); emit("\n");
  emit("STORM-FILL-END\n");
  return 0;
}

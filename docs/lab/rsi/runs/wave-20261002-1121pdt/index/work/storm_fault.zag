// storm_fault.zag -- fault-injection panic hunt for the 0221pdt
// index-cycle crash class ("panic: slice index out of bounds" in the
// candidate collector on a corrupt bucket list). Four fresh worlds;
// after each injection the gate must REJECT and the hardened paths
// (gate, hardened collector, linear fallbacks) must complete with
// answers equal to pre-injection answers. Any crash is a FAIL.

fn ft_world()[]u8 {
  let W:[]u8=sl_big(); tnn2_init(W); idx_mode_set(W,7);
  let i:i32=0;
  while(i<10){
    if(sl_mkchain(W,20000+i*10,5,51,20004+i*10)<0){ emit("FAULT mk FAIL\n"); }
    i=i+1;
  }
  i=0;
  while(i<50){ ev_teach(W,30000+i,1,40000+i); i=i+1; }
  return W;
}
fn ft_query(W:[]u8)i32 {
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  return rebind_try_idx(W,20000,50,20004,0,rbs);
}
// Direct hammer on the hardened collector over a (possibly corrupt) list:
// the exact site of the 0221pdt panic. Must terminate, never panic.
fn ft_collect(W:[]u8,head:i32)i32 {
  let cand:[]u8=z_alloc(65536);
  return idx_collect(W,head,5,cand,0,8192);
}

// F1: cycle spliced into a MAP bucket list.
fn ff1()void {
  emit("F1-START cycle-in-map-bucket\n");
  let W:[]u8=ft_world();
  let a0:i32=ft_query(W);
  emit("F1 pre ans="); e64(a0); emit("\n");
  let ix:i32=idx_node(W);
  let h:i32=ng(W,ix,32);
  let c3:i32=h; let k:i32=0;
  while(k<2 && c3>=0){ c3=ng(W,c3,12); k=k+1; }
  emit("F1 head="); e64(h); emit(" c3="); e64(c3); emit("\n");
  ns(W,c3,12,h);
  emit("F1 gates idx="); e64(idx_validate(W));
  emit(" fidx="); e64(fidx_validate(W)); emit("\n");
  emit("F1 collect nc="); e64(ft_collect(W,h)); emit("\n");
  let a1:i32=ft_query(W);
  emit("F1 post ans="); e64(a1); emit(" same="); e64(a0==a1); emit("\n");
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,30000,paths);
  emit("F1 gather np="); e64(np); emit("\n");
  let lu:i32=t2_lu_first(W,30000,1);
  emit("F1 lu="); e64(lu); emit("\n");
  emit("F1 SURVIVED\n");
  emit("F1-END\n");
  return;
}

// F2: out-of-range next pointer in a MAP bucket list.
fn ff2()void {
  emit("F2-START oob-next-in-map-bucket\n");
  let W:[]u8=ft_world();
  let a0:i32=ft_query(W);
  let ix:i32=idx_node(W);
  let h:i32=ng(W,ix,32);
  let c2:i32=ng(W,h,12);
  emit("F2 head="); e64(h); emit(" c2="); e64(c2); emit("\n");
  ns(W,c2,12,99999);
  emit("F2 gates idx="); e64(idx_validate(W)); emit("\n");
  emit("F2 collect nc="); e64(ft_collect(W,h)); emit("\n");
  let a1:i32=ft_query(W);
  emit("F2 post ans="); e64(a1); emit(" same="); e64(a0==a1); emit("\n");
  emit("F2 SURVIVED\n");
  emit("F2-END\n");
  return;
}

// F3: dead node left at a MAP bucket head (direct kill, hook bypassed).
fn ff3()void {
  emit("F3-START dead-member-at-bucket-head\n");
  let W:[]u8=ft_world();
  let a0:i32=ft_query(W);
  let ix:i32=idx_node(W);
  let h:i32=ng(W,ix,32);
  emit("F3 head="); e64(h); emit("\n");
  ns(W,h,36,0);
  emit("F3 gates idx="); e64(idx_validate(W)); emit("\n");
  emit("F3 collect nc="); e64(ft_collect(W,h)); emit("\n");
  let a1:i32=ft_query(W);
  emit("F3 post ans="); e64(a1); emit(" same="); e64(a0==a1); emit("\n");
  emit("F3 SURVIVED\n");
  emit("F3-END\n");
  return;
}

// F4: cycle spliced into a FACT bucket chain.
fn ff4()void {
  emit("F4-START cycle-in-fact-bucket\n");
  let W:[]u8=ft_world();
  let paths:[]u8=z_alloc(4608);
  let np0:i32=t2_gather(W,30000,paths);
  let lu0:i32=t2_lu_first(W,30000,1);
  emit("F4 pre np="); e64(np0); emit(" lu="); e64(lu0); emit("\n");
  let b:i32=3;
  let n0:i32=ng(W,idx_node(W),8);
  let hd:i32=ng(W,n0,fidx_slot_field(b));
  let c2:i32=ng(W,hd,12);
  emit("F4 head="); e64(hd); emit(" c2="); e64(c2); emit("\n");
  ns(W,c2,12,hd);
  emit("F4 gates idx="); e64(idx_validate(W));
  emit(" fidx="); e64(fidx_validate(W)); emit("\n");
  let np1:i32=t2_gather(W,30000,paths);
  let lu1:i32=t2_lu_first(W,30000,1);
  emit("F4 post np="); e64(np1); emit(" lu="); e64(lu1);
  emit(" same="); e64(np0==np1); emit(" lusame="); e64(lu0==lu1); emit("\n");
  emit("F4 SURVIVED\n");
  emit("F4-END\n");
  return;
}

fn main()i32 {
  emit("FAULT-STORM-START\n");
  ff1();
  ff2();
  ff3();
  ff4();
  emit("FAULT-STORM-END\n");
  return 0;
}

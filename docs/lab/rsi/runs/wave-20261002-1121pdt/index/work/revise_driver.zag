// revise_driver.zag -- t2_revise_graph coverage instrument, INDEX lane,
// wave-20261002-1121pdt. Frozen design (see PREREG_REVISE.md).
// R1 canonical SUCCESS (contradict last chain fact), R2 canonical REVERT
// (contradict first chain fact; corrected value fails the next guard),
// R3 adversarial shared-stale (two MAPs share one 101 step via two guards;
// the highest-id guard scan selects the chain-A guard).
// Assembled into CONTROL (no revise hook) and CANDIDATE (revise hook).

fn rv_big()[]u8 { let W:[]u8=z_alloc(593984); return W; }

fn rv_gates(W:[]u8,tag:[]u8)void {
  emit(tag); emit(" gates idx="); e64(idx_validate(W));
  emit(" fidx="); e64(fidx_validate(W));
  emit(" deep="); e64(idx_deep_validate(W)); emit("\n");
  return;
}

// First violator cause: 0=none, 1=dead member, 2=wrong tag,
// 3=plen mismatch, 4=FACT-side violator. Pure reads.
fn rv_cause(W:[]u8)i32 {
  let ix:i32=idx_node(W);
  if(ix>=0){
    let q:i32=2;
    while(q<=5){
      let m:i32=ng(W,ix,idx_bfield(q));
      let steps:i32=0;
      while(m>=0 && m<8192 && steps<8192){
        if(ng(W,m,36)!=1){ return 1; }
        if(ng(W,m,0)!=20){ return 2; }
        let root:i32=ng(W,m,20);
        if(root<0 || root>=8192 || rb_chain_plen(W,root)!=q){ return 3; }
        m=ng(W,m,12); steps=steps+1;
      }
      q=q+1;
    }
  }
  return 4;
}

// Which plen bucket (2..5) holds MAP m; 0 = none.
fn rv_any_bucket(W:[]u8,m:i32)i32 {
  let ix:i32=idx_node(W);
  if(ix<0){ return 0; }
  let q:i32=2;
  while(q<=5){
    let cur:i32=ng(W,ix,idx_bfield(q));
    let steps:i32=0;
    while(cur>=0 && cur<8192 && steps<8192){
      if(cur==m){ return q; }
      cur=ng(W,cur,12);
      steps=steps+1;
    }
    q=q+1;
  }
  return 0;
}

fn r1()void {
  emit("R1-START canonical-success\n");
  let W:[]u8=rv_big(); tnn2_init(W); idx_mode_set(W,3);
  ev_teach(W,6101,1,6102); ev_teach(W,6102,1,6103);
  ev_teach(W,6103,1,6104); ev_teach(W,6104,1,6105);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,6101,1,v,f);
  emit("R1 chain len="); e64(len); emit("\n");
  let root:i32=t2_asm_chain(W,v,len,f);
  let facts:[]u8=z_alloc(16);
  set32(facts,0,get32(f,0)); set32(facts,4,get32(f,4));
  set32(facts,8,get32(f,8)); set32(facts,12,get32(f,12));
  let m:i32=promote_graph(W,root,6101,51,6105,facts,4);
  emit("R1 map="); e64(m); emit(" plen="); e64(rb_chain_plen(W,root)); emit("\n");
  rv_gates(W,"R1 PRE");
  emit("R1 PRE ans="); e64(ng(W,m,28));
  emit(" inbuck="); e64(rv_any_bucket(W,m)); emit("\n");
  let factn:i32=get32(f,12);
  emit("R1 factn="); e64(factn); emit(" old_o="); e64(ng(W,factn,28)); emit("\n");
  revise_on_contradict(W,factn,7105);
  rv_gates(W,"R1 POST");
  emit("R1 POST ans="); e64(ng(W,m,28));
  emit(" inbuck="); e64(rv_any_bucket(W,m));
  emit(" unchain="); e64(ng(W,0,12)); emit("\n");
  let q0:i32=ev_query(W,6101,51,7105,0);
  emit("R1 query ans="); e64(q0); emit(" ok="); e64(q0==7105); emit("\n");
  emit("R1-END\n");
  return;
}

fn r2()void {
  emit("R2-START canonical-revert\n");
  let W:[]u8=rv_big(); tnn2_init(W); idx_mode_set(W,3);
  ev_teach(W,6101,1,6102); ev_teach(W,6102,1,6103);
  ev_teach(W,6103,1,6104); ev_teach(W,6104,1,6105);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,6101,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let facts:[]u8=z_alloc(16);
  set32(facts,0,get32(f,0)); set32(facts,4,get32(f,4));
  set32(facts,8,get32(f,8)); set32(facts,12,get32(f,12));
  let m:i32=promote_graph(W,root,6101,51,6105,facts,4);
  emit("R2 map="); e64(m); emit(" plen="); e64(rb_chain_plen(W,root)); emit("\n");
  rv_gates(W,"R2 PRE");
  let factn:i32=get32(f,0);
  emit("R2 factn="); e64(factn); emit(" old_o="); e64(ng(W,factn,28)); emit("\n");
  revise_on_contradict(W,factn,7105);
  rv_gates(W,"R2 POST");
  emit("R2 POST ans="); e64(ng(W,m,28));
  emit(" inbuck="); e64(rv_any_bucket(W,m));
  emit(" unchain="); e64(ng(W,0,12)); emit("\n");
  emit("R2-END\n");
  return;
}

fn r3()void {
  emit("R3-START adversarial-shared-stale\n");
  let W:[]u8=rv_big(); tnn2_init(W); idx_mode_set(W,3);
  let factn:i32=ev_teach(W,9000,1,9001);
  // Shared last step, licensed by factn.
  let st:i32=t2_set(W,0,t2_lit(W,9001));
  link_edge(W,st,1,factn,0);
  // Chain B, built first: gB -> stB0 -> gB1 -> st (plen 3).
  let gB:i32=t2_guard(W,0,t2_lit(W,9200));
  let stB0:i32=t2_set(W,0,t2_lit(W,9201));
  ns(W,gB,12,stB0);
  let gB1:i32=t2_guard(W,0,t2_lit(W,9201));
  ns(W,gB1,12,st);
  seq_link(W,stB0,gB1);
  let rootB:i32=gB;
  // Chain A, built second (gA1 gets the higher id): gA0 -> stA0 -> gA1 -> st.
  let gA0:i32=t2_guard(W,0,t2_lit(W,9300));
  let stA0:i32=t2_set(W,0,t2_lit(W,9301));
  ns(W,gA0,12,stA0);
  let gA1:i32=t2_guard(W,0,t2_lit(W,9301));
  ns(W,gA1,12,st);
  seq_link(W,stA0,gA1);
  let rootA:i32=gA0;
  emit("R3 plenA="); e64(rb_chain_plen(W,rootA));
  emit(" plenB="); e64(rb_chain_plen(W,rootB)); emit("\n");
  emit("R3 gA1="); e64(gA1); emit(" gB1="); e64(gB1); emit("\n");
  let fa:[]u8=z_alloc(4); set32(fa,0,factn);
  let mA:i32=promote_graph(W,rootA,9300,51,9001,fa,1);
  let mB:i32=promote_graph(W,rootB,9200,51,9001,fa,1);
  emit("R3 mA="); e64(mA); emit(" mB="); e64(mB); emit("\n");
  rv_gates(W,"R3 PRE");
  emit("R3 PRE inbuckA="); e64(rv_any_bucket(W,mA));
  emit(" inbuckB="); e64(rv_any_bucket(W,mB)); emit("\n");
  revise_on_contradict(W,factn,9999);
  rv_gates(W,"R3 POST");
  let c3:i32=0;
  if(idx_validate(W)==0){ c3=rv_cause(W); }
  emit("R3 POST cause="); e64(c3); emit("\n");
  emit("R3 POST ansA="); e64(ng(W,mA,28));
  emit(" ansB="); e64(ng(W,mB,28)); emit("\n");
  emit("R3 POST inbuckA="); e64(rv_any_bucket(W,mA));
  emit(" inbuckB="); e64(rv_any_bucket(W,mB)); emit("\n");
  emit("R3 POST unchain="); e64(ng(W,0,12)); emit("\n");
  emit("R3-END\n");
  return;
}

fn main()i32 {
  emit("REVISE-COVERAGE-START\n");
  r1();
  r2();
  r3();
  emit("REVISE-COVERAGE-END\n");
  return 0;
}

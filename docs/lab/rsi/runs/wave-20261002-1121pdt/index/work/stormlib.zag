// stormlib.zag -- shared storm/validation instruments, INDEX lane,
// wave-20261002-1121pdt. Assembled AFTER base+patch. No main. Pure Zag.
//
// Contents:
//   - seeded LCG (fixed seeds, byte-identical reruns)
//   - parameterized MAP-chain builder
//   - pure-Zag deep index validator (idx_deep_validate): the production
//     gate (idx_validate + fidx_validate: members live/tagged/plen
//     correct, no cycles, bounds respected) PLUS completeness (every
//     live tag-20 with valid plen is in exactly one bucket, its plen
//     bucket; invalid plen implies no bucket; every live tag-1 with
//     field 24 != -999, inquiry markers excluded by design, is in
//     exactly one FACT chain; no duplicates; no misfiled buckets)
//     PLUS MTF-winner sanity. Pure reads, no state changes.
// Preconditions (documented, hold in all storm drivers): idx_mode_set
// runs before any promote_graph/ev_teach; all node death goes through
// evict_node or a hooked path; mode bit N active from init gates the
// corresponding completeness direction.

fn sl_big()[]u8 { let W:[]u8=z_alloc(593984); return W; }

// ---- seeded PRNG (LCG, 2^31 modulus) ----
fn rnd_init(st:[]u8,seed:i32)void { set32(st,0,seed); return; }
fn rnd_next(st:[]u8)i32 {
  let x:i32=get32(st,0);
  x=(x*1103515245+12345)&2147483647;
  set32(st,0,x);
  return x;
}
fn rnd_below(st:[]u8,n:i32)i32 {
  if(n<=0){ return 0; }
  let r:i32=rnd_next(st);
  return r-(r/n)*n;
}

// ---- parameterized MAP-chain builder ----
// Teaches (s0..s0+plen-2, 1, s0+1..s0+plen-1), assembles the chain,
// promotes the MAP. Returns the MAP id, or -1 on build failure.
fn sl_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){ ev_teach(W,s0+k,1,s0+k+1); k=k+1; }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  if(len!=plen){ return -1; }
  let root:i32=t2_asm_chain(W,v,len,f);
  if(root<0){ return -1; }
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}

// ---- deep validator helpers ----
fn dv_in_bucket(W:[]u8,head:i32,m:i32)i32 {
  let cur:i32=head; let steps:i32=0;
  while(cur>=0 && cur<NN() && steps<NN()){
    if(cur==m){ return 1; }
    cur=idx_bnext(W,cur);
    steps=steps+1;
  }
  return 0;
}
fn dv_map_hits(W:[]u8,m:i32)i32 {
  let ix:i32=idx_node(W);
  let hits:i32=0;
  let q:i32=2;
  while(q<=5){
    let hq:i32=dv_in_bucket(W,ng(W,ix,idx_bfield(q)),m);
    hits=hits+hq;
    q=q+1;
  }
  return hits;
}
fn dv_map_node_ok(W:[]u8,n:i32)i32 {
  let plen:i32=rb_chain_plen(W,ng(W,n,20));
  let bf:i32=idx_bfield(plen);
  let hits:i32=dv_map_hits(W,n);
  if(bf<0){
    if(hits==0){ return 1; }
    return 0;
  }
  if(hits!=1){ return 0; }
  let ix:i32=idx_node(W);
  return dv_in_bucket(W,ng(W,ix,bf),n);
}
fn dv_map_complete(W:[]u8)i32 {
  let n:i32=2;
  while(n<NN()){
    let live:i32=ng(W,n,36);
    let tag:i32=ng(W,n,0);
    if(live==1 && tag==20){
      if(dv_map_node_ok(W,n)==0){ return 0; }
    }
    n=n+1;
  }
  return 1;
}
fn dv_fact_chain_pass(W:[]u8,b:i32,seen:[]u8)i32 {
  let n0:i32=ng(W,idx_node(W),8);
  let k:i32=b/6;
  while(k>0 && n0>=0 && n0<NN()){ n0=ng(W,n0,12); k=k-1; }
  if(n0<0 || n0>=NN()){ return 0; }
  let hd:i32=ng(W,n0,fidx_slot_field(b-((b/6)*6)));
  let m:i32=hd; let steps:i32=0;
  while(m>=0 && m<NN() && steps<NN()){
    if(ng(W,m,36)!=1){ return 0; }
    if(ng(W,m,0)!=1){ return 0; }
    if(get32(seen,m*4)!=0){ return 0; }
    set32(seen,m*4,1);
    if(fhash(ng(W,m,20))!=b){ return 0; }
    m=idx_bnext(W,m);
    steps=steps+1;
  }
  return 1;
}
fn dv_fact_complete(W:[]u8)i32 {
  let ix:i32=idx_node(W);
  if(ix<0){ return 0; }
  let seen:[]u8=z_alloc(32768);
  let i:i32=0;
  while(i<8192){ set32(seen,i*4,0); i=i+1; }
  let b:i32=0;
  while(b<24){
    if(dv_fact_chain_pass(W,b,seen)==0){ return 0; }
    b=b+1;
  }
  let n:i32=2;
  while(n<NN()){
    let live:i32=ng(W,n,36);
    if(live==1){
      let tag:i32=ng(W,n,0);
      if(tag==1){
        let r:i32=ng(W,n,24);
        if(r!=-999){
          if(get32(seen,n*4)!=1){ return 0; }
        }
      }
    }
    n=n+1;
  }
  return 1;
}
fn dv_mtf_ok(W:[]u8)i32 {
  let ix:i32=idx_node(W);
  if(ix<0){ return 0; }
  let w:i32=ng(W,ix,12);
  if(w<0){ return 1; }
  let wm:i32=w/8; let wp:i32=w-wm*8;
  if(wm<2 || wm>=NN()){ return 0; }
  if(ng(W,wm,36)!=1 || ng(W,wm,0)!=20){ return 0; }
  if(wp<2 || wp>5){ return 0; }
  return dv_in_bucket(W,ng(W,ix,idx_bfield(wp)),wm);
}
// The deep validator: production gate plus completeness plus MTF sanity.
fn idx_deep_validate(W:[]u8)i32 {
  if(idx_validate(W)==0){ return 0; }
  if(fidx_validate(W)==0){ return 0; }
  let mode:i32=idx_mode(W);
  if((mode&1)==1){
    if(dv_map_complete(W)==0){ return 0; }
  }
  if((mode&4)==4){
    if(dv_fact_complete(W)==0){ return 0; }
  }
  if((mode&2)==2){
    if(dv_mtf_ok(W)==0){ return 0; }
  }
  return 1;
}

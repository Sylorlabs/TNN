// storm_evict.zag -- soak storm on the eviction hook: 25 natural evictions
// at high occupancy, deep validator after EVERY eviction, probe queries
// interleaved. Timed via shell (per-eviction cost). Any deep-validator 0
// or wrong answer is a KILL with evidence (see PREREG_REVISE.md).
fn main()i32 {
  emit("STORM-EVICT-START\n");
  let W:[]u8=sl_big(); tnn2_init(W); idx_mode_set(W,7);
  let st:[]u8=z_alloc(4); rnd_init(st,777);
  // Two fixed probe chains (plen 5 and plen 3); queried with r=50 to miss
  // activate() and exercise the rebind/index path.
  if(sl_mkchain(W,20000,5,51,20004)<0){ emit("EVICT probe0 FAIL\n"); }
  if(sl_mkchain(W,20100,3,51,20102)<0){ emit("EVICT probe1 FAIL\n"); }
  let i:i32=2;
  while(i<120){
    let plen:i32=2+rnd_below(st,4);
    if(sl_mkchain(W,20000+i*100,plen,51,20000+i*100+plen-1)<0){
      emit("EVICT mk FAIL\n");
    }
    i=i+1;
  }
  i=0;
  while(i<4000){ ev_teach(W,60000+i,1,70000+i); i=i+1; }
  emit("EVICT built live="); e64(hg(W,20));
  emit(" deep="); e64(idx_deep_validate(W)); emit("\n");
  let k:i32=0;
  while(k<25){
    let v:i32=evict_node(W);
    if(v<0){
      emit("EVICT k="); e64(k); emit(" EMPTY\n");
      k=25;
    } else {
      let dv:i32=idx_deep_validate(W);
      emit("EVICT k="); e64(k); emit(" v="); e64(v);
      emit(" tag="); e64(ng(W,v,0)); emit(" deep="); e64(dv); emit("\n");
      if(dv==0){ emit("EVICT DEEP-VIOLATION k="); e64(k); emit("\n"); }
      let qmod:i32=k-(k/4)*4;
      if(qmod==0){
        hs(W,56,0);
        let a0:i32=ev_query(W,20000,50,20004,0);
        let s0:i32=hg(W,56);
        hs(W,56,0);
        let a1:i32=ev_query(W,20100,50,20102,0);
        let s1:i32=hg(W,56);
        emit("EVICT Q k="); e64(k); emit(" a0="); e64(a0); emit(" s0="); e64(s0);
        emit(" a1="); e64(a1); emit(" s1="); e64(s1); emit("\n");
        if(a0!=-2 && a0!=20004){ emit("EVICT WRONG-ANSWER q0\n"); }
        if(a1!=-2 && a1!=20102){ emit("EVICT WRONG-ANSWER q1\n"); }
      }
      k=k+1;
    }
  }
  emit("EVICT done live="); e64(hg(W,20));
  emit(" deep="); e64(idx_deep_validate(W)); emit("\n");
  emit("STORM-EVICT-END\n");
  return 0;
}

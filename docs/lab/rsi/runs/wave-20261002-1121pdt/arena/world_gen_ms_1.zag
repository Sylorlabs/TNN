// world_gen.zag — deterministic TNN-vs-LLM arena world generator (pure Zag).
// Usage: world_gen <outdir>
// Writes: battery.json, answer_key.json, idmap.json, exposure.jsonl,
//         exposure_tnn.jsonl, briefing_tnn.jsonl, briefing_llm.txt,
//         llm_prompt_pack.txt, turns.jsonl, proofs.txt, novelty_check.json
// Determinism: single LCG seeded from SEALED_SEED.txt (CA-2 clean refreeze); no other entropy source.

// --- basic utils (dialect-conformant) ---
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
// append s into buf at position at; returns new at
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
// find first occurrence of needle in hay starting at `from`; -1 if absent
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
// i32 little-endian store/load
fn st32(b:[]u8,at:i32,v:i32)void {
  b[at]=(v as u8); b[at+1]=((v>>8) as u8); b[at+2]=((v>>16) as u8); b[at+3]=((v>>24) as u8);
  return;
}
fn ld32(b:[]u8,at:i32)i32 {
  let v:i32=(b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
  return v;
}
// join dir + "/" + name
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
// --- PRNG: LCG in an 8-byte LE buffer (no globals in this dialect) ---
fn rng_next(rng:[]u8)i64 {
  let s:i64=(rng[0] as i64)|((rng[1] as i64)<<8)|((rng[2] as i64)<<16)|((rng[3] as i64)<<24)|((rng[4] as i64)<<32)|((rng[5] as i64)<<40)|((rng[6] as i64)<<48)|((rng[7] as i64)<<56);
  s=s*6364136223846793005+1442695040888963407;
  rng[0]=(s as u8); rng[1]=((s>>8) as u8); rng[2]=((s>>16) as u8); rng[3]=((s>>24) as u8);
  rng[4]=((s>>32) as u8); rng[5]=((s>>40) as u8); rng[6]=((s>>48) as u8); rng[7]=((s>>56) as u8);
  return s;
}
fn rng_range(rng:[]u8,n:i64)i64 {
  let r:i64=rng_next(rng)%n;
  if(r<0){r=-r;}
  return r;
}
// C9FIX: binary draw from bit 33 (the LCG low bits have short periods;
// bit 0 alternates every step, so %2 draws are degenerate). Method from
// the committed C9BAT c9gen.zag.
fn rng_bit(rng:[]u8)i32 {
  let s:i64=rng_next(rng);
  return ((s>>33)&1) as i32;
}
// C9FIX: edge flip with p = 0.05 via a wider modulus (better bit quality).
fn rng_flip(rng:[]u8)i32 {
  if((rng_range(rng,2000) as i32)<100){ return 1; }
  return 0;
}

// --- tables (fixed-stride, zero-padded) ---
// syllables: 24 x 2 chars
fn syltab()[]u8 { return "karimotaserunavidorapekotemanufizorabegudahirusu"; }
// colors/sizes/materials/shapes/tempers: 5 x stride 8
fn coltab()[]u8 { return "crimson\0azure\0\0\0amber\0\0\0jade\0\0\0\0violet\0\0"; }
fn siztab()[]u8 { return "tiny\0\0\0\0small\0\0\0medium\0\0large\0\0\0huge\0\0\0\0"; }
fn mattab()[]u8 { return "wooden\0\0iron\0\0\0\0glass\0\0\0stone\0\0\0silk\0\0\0\0"; }
fn shptab()[]u8 { return "round\0\0\0square\0\0tall\0\0\0\0flat\0\0\0\0wide\0\0\0\0"; }
fn tmptab()[]u8 { return "calm\0\0\0\0fierce\0\0playful\0shy\0\0\0\0\0bold\0\0\0\0"; }
// attrs: 5 x stride 9 ; relations: 6 x stride 12
fn attrtab()[]u8 { return "color\0\0\0\0size\0\0\0\0\0material\0shape\0\0\0\0temper\0\0\0"; }
fn reltab()[]u8 { return "mentor_of\0\0\0ally_of\0\0\0\0\0rival_of\0\0\0\0kin_of\0\0\0\0\0\0student_of\0\0guardian_of\0"; }
fn blocktab()[]u8 { return "the|and|cat|dog|red|blue|man|king|run|eat|big|"; }
// copy zero-terminated entry idx (stride st) from tab into out; returns len
fn tabget(tab:[]u8,idx:i32,st:i32,out:[]u8)i32 {
  let base:i32=idx*st;
  let k:i32=0;
  while(k<st){
    let c:u8=tab[base+k];
    if(c==0){out[k]=0;return k;}
    out[k]=c;
    k=k+1;
  }
  out[k]=0;
  return k;
}
// value table select by attr idx (0..4)
fn valtab(a:i32)[]u8 {
  if(a==0){return coltab();}
  if(a==1){return siztab();}
  if(a==2){return mattab();}
  if(a==3){return shptab();}
  return tmptab();
}
// lowercase in place
fn tolower(b:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){ if(b[i]>=65 && b[i]<=90){b[i]=b[i]+32;} i=i+1; }
  return;
}
// generate a distinct name into out (16B slot); returns len. kind 0=Entity(capitalized), 1=word
fn gen_name(rng:[]u8,out:[]u8,used:[]u8,nused:i32,kind:i32)i32 {
  let syl:[]u8=syltab();
  let tmp:[]u8=z_alloc(16);
  let tries:i32=0;
  while(tries<200){
    let ns:i32=2+(rng_range(rng,2) as i32);
    let at:i32=0;
    let s:i32=0;
    while(s<ns){
      let si:i32=(rng_range(rng,24) as i32)*2;
      tmp[at]=syl[si]; tmp[at+1]=syl[si+1]; at=at+2;
      s=s+1;
    }
    if(kind==0 && tmp[0]>=97){tmp[0]=tmp[0]-32;}
    // dedupe against used (nused slots of 16B)
    let dup:i32=0;
    let u:i32=0;
    while(u<nused){
      let base:i32=u*16;
      let k:i32=0; let same:i32=1;
      while(k<at){
        if(used[base+k]!=tmp[k]){same=0;}
        k=k+1;
      }
      if(same==1 && used[base+at]==0){dup=1;}
      u=u+1;
    }
    // blocklist check (lowercased)
    let low:[]u8=z_alloc(16);
    let k2:i32=0; while(k2<at){low[k2]=tmp[k2];k2=k2+1;}
    tolower(low,at);
    let blk:[]u8=blocktab();
    let bi:i32=0; let bad:i32=0;
    while(bi<11){
      let w:[]u8=z_alloc(8);
      let wl:i32=0;
      while(blk[bi+wl]!=124){w[wl]=blk[bi+wl];wl=wl+1;}
      if(findsub(low,0,w[0..wl])>=0){bad=1;}
      if(findsub(w[0..wl],0,low[0..at])>=0){bad=1;}
      z_free(w);
      bi=bi+wl+1;
    }
    z_free(low);
    if(dup==0 && bad==0){
      let k3:i32=0; while(k3<at){out[k3]=tmp[k3];k3=k3+1;}
      out[at]=0;
      z_free(tmp);
      return at;
    }
    tries=tries+1;
  }
  z_free(tmp);
  return -1;
}

// --- world data generation (called from main) ---
// transform application: 0=reverse 1=rotl1 2=xor1 3=swap_halves
fn apply_t(tid:i32,s0:i32,s1:i32,s2:i32,o:[]u8)void {
  if(tid==0){o[0]=s2 as u8; o[1]=s1 as u8; o[2]=s0 as u8;}
  if(tid==1){o[0]=s1 as u8; o[1]=s0 as u8; o[2]=s2 as u8;}
  if(tid==2){o[0]=(s0^1) as u8; o[1]=(s1^1) as u8; o[2]=(s2^1) as u8;}
  if(tid==3){o[0]=s2 as u8; o[1]=s1 as u8; o[2]=s0 as u8;}
  return;
}
// append JSON string "s"
fn jstr(b:[]u8,at:i32,s:[]u8)i32 {
  at=app(b,at,"\"");
  at=app(b,at,s);
  at=app(b,at,"\"");
  return at;
}
// append segments as "a,b,c"
fn segs3(b:[]u8,at:i32,a:i32,cc:i32,d:i32)i32 {
  at=app(b,at,i64s(a as i64)); at=app(b,at,",");
  at=app(b,at,i64s(cc as i64)); at=app(b,at,",");
  at=app(b,at,i64s(d as i64));
  return at;
}
// value string for attr a, value index v into out(16B); returns len
fn getval(a:i32,v:i32,out:[]u8)i32 { return tabget(valtab(a),v,8,out); }
fn getattr(a:i32,out:[]u8)i32 { return tabget(attrtab(),a,9,out); }
fn getrel(r:i32,out:[]u8)i32 { return tabget(reltab(),r,12,out); }

fn slen(b:[]u8)i32 { let i:i32=0; while(b[i]!=0){i=i+1;} return i; }
fn appz(buf:[]u8,at:i32,s:[]u8)i32 { return app(buf,at,s[0..slen(s)]); }
fn emit_item(bat:[]u8,at:i32,sep:i32,cap:i32,q:[]u8)i32 {
  if(sep>0){at=app(bat,at,",");}
  at=app(bat,at,"["); at=app(bat,at,i64s(cap as i64)); at=app(bat,at,",");
  at=jstr(bat,at,q); at=app(bat,at,"]");
  return at;
}
fn emit_ans(ans:[]u8,at:i32,a:[]u8,first:i32)i32 {
  if(first==0){at=app(ans,at,",");}
  at=jstr(ans,at,a);
  return at;
}
// value index of vstr within attr a's table; -1 if absent
fn valindex(a:i32,vstr:[]u8)i32 {
  let tmp:[]u8=z_alloc(16);
  let v:i32=0;
  while(v<5){
    tabget(valtab(a),v,8,tmp);
    if(streq(tmp[0..slen(tmp)],vstr[0..slen(vstr)])==1){z_free(tmp);return v;}
    v=v+1;
  }
  z_free(tmp);
  return -1;
}

fn main()i32 {
  let outdir:[]u8=_zag_arg(1);
  if(outdir.len==0){ emit("usage: world_gen <outdir>\n"); return 1; }
  let rng:[]u8=z_alloc(8);
  let sd:i64=71503462337033;
  rng[0]=(sd as u8); rng[1]=((sd>>8) as u8); rng[2]=((sd>>16) as u8); rng[3]=((sd>>24) as u8);
  rng[4]=((sd>>32) as u8); rng[5]=((sd>>40) as u8); rng[6]=((sd>>48) as u8); rng[7]=((sd>>56) as u8);

  // ---- entity names (10) ----
  let used:[]u8=z_alloc(64*16);
  let nused:i32=0;
  let enames:[]u8=z_alloc(10*16);
  let e:i32=0;
  while(e<10){
    let n:i32=gen_name(rng,enames[e*16..e*16+16],used,nused,0);
    if(n<0){emit("namegen failed\n");return 1;}
    let k:i32=0; while(k<=n){used[nused*16+k]=enames[e*16+k];k=k+1;}
    nused=nused+1;
    e=e+1;
  }
  // ---- C1 facts: entities 0..5, attrs color,size,material,shape,temper,color ----
  let c1attr:[]u8=z_alloc(6); c1attr[0]=0;c1attr[1]=1;c1attr[2]=2;c1attr[3]=3;c1attr[4]=4;c1attr[5]=0;
  let c1v:[]u8=z_alloc(6*16);
  let i:i32=0;
  while(i<6){
    let vi:i32=(rng_range(rng,5) as i32);
    getval(c1attr[i] as i32,vi,c1v[i*16..i*16+16]);
    i=i+1;
  }
  // ---- C5 corrections: entities 6,7,8 attrs size,shape,material ----
  let c5attr:[]u8=z_alloc(3); c5attr[0]=1;c5attr[1]=3;c5attr[2]=2;
  let c5w:[]u8=z_alloc(3*16); let c5n:[]u8=z_alloc(3*16);
  i=0;
  while(i<3){
    let a:i32=c5attr[i] as i32;
    let w:i32=(rng_range(rng,5) as i32);
    let nv:i32=(rng_range(rng,5) as i32);
    while(nv==w){nv=(rng_range(rng,5) as i32);}
    getval(a,w,c5w[i*16..i*16+16]);
    getval(a,nv,c5n[i*16..i*16+16]);
    i=i+1;
  }
  // ---- C6 conflicts: entities 2,3,4 attrs temper,color,size ----
  let c6attr:[]u8=z_alloc(3); c6attr[0]=4;c6attr[1]=0;c6attr[2]=1;
  let c6v1:[]u8=z_alloc(3*16); let c6v2:[]u8=z_alloc(3*16);
  i=0;
  while(i<3){
    let a:i32=c6attr[i] as i32;
    let w:i32=(rng_range(rng,5) as i32);
    let nv:i32=(rng_range(rng,5) as i32);
    while(nv==w){nv=(rng_range(rng,5) as i32);}
    getval(a,w,c6v1[i*16..i*16+16]);
    getval(a,nv,c6v2[i*16..i*16+16]);
    i=i+1;
  }
  // ---- C8 oracle facts (never exposed): entities 5,6,7,9 attrs material,temper,color,shape ----
  let c8ent:[]u8=z_alloc(4); c8ent[0]=5;c8ent[1]=6;c8ent[2]=7;c8ent[3]=9;
  let c8attr:[]u8=z_alloc(4); c8attr[0]=2;c8attr[1]=4;c8attr[2]=0;c8attr[3]=3;
  let c8v:[]u8=z_alloc(4*16);
  i=0;
  while(i<4){
    let vi:i32=(rng_range(rng,5) as i32);
    getval(c8attr[i] as i32,vi,c8v[i*16..i*16+16]);
    i=i+1;
  }
  // ---- relations: two 3-chains ----
  // (0,mentor_of,1) (1,ally_of,2) (2,rival_of,3) (4,kin_of,5) (5,student_of,6) (6,guardian_of,7)
  let rel:[]u8=z_alloc(6*3*4);
  st32(rel,0,0); st32(rel,4,0); st32(rel,8,1);
  st32(rel,12,1); st32(rel,16,1); st32(rel,20,2);
  st32(rel,24,2); st32(rel,28,2); st32(rel,32,3);
  st32(rel,36,4); st32(rel,40,3); st32(rel,44,5);
  st32(rel,48,5); st32(rel,52,4); st32(rel,56,6);
  st32(rel,60,6); st32(rel,64,5); st32(rel,68,7);
  // ---- Zem: template (3 distinct values), transform ----
  let t0:i32=(rng_range(rng,4) as i32);
  let t1:i32=(rng_range(rng,4) as i32);
  while(t1==t0){t1=(rng_range(rng,4) as i32);}
  let t2:i32=(rng_range(rng,4) as i32);
  while(t2==t0){t2=(rng_range(rng,4) as i32);}
  while(t2==t1){t2=(rng_range(rng,4) as i32);}
  let tid:i32=(rng_range(rng,4) as i32);
  let bsegs:[]u8=z_alloc(3);
  apply_t(tid,t0,t1,t2,bsegs);
  // word names: 5 A, 2 B, 3 new, 2 C10-novel, 3 C16-class, 3 C12-class
  let anames:[]u8=z_alloc(5*16); let bnames:[]u8=z_alloc(2*16);
  let nwnames:[]u8=z_alloc(3*16); let c10names:[]u8=z_alloc(2*16);
  let c16cn:[]u8=z_alloc(3*16); let c12cn:[]u8=z_alloc(3*16);
  i=0;
  while(i<5){ gen_name(rng,anames[i*16..i*16+16],used,nused,1); let k:i32=0; while(k<16){used[nused*16+k]=anames[i*16+k];k=k+1;} nused=nused+1; i=i+1; }
  i=0;
  while(i<2){ gen_name(rng,bnames[i*16..i*16+16],used,nused,1); let k:i32=0; while(k<16){used[nused*16+k]=bnames[i*16+k];k=k+1;} nused=nused+1; i=i+1; }
  i=0;
  while(i<3){ gen_name(rng,nwnames[i*16..i*16+16],used,nused,1); let k:i32=0; while(k<16){used[nused*16+k]=nwnames[i*16+k];k=k+1;} nused=nused+1; i=i+1; }
  i=0;
  while(i<2){ gen_name(rng,c10names[i*16..i*16+16],used,nused,1); let k:i32=0; while(k<16){used[nused*16+k]=c10names[i*16+k];k=k+1;} nused=nused+1; i=i+1; }
  i=0;
  while(i<3){ gen_name(rng,c16cn[i*16..i*16+16],used,nused,1); let k:i32=0; while(k<16){used[nused*16+k]=c16cn[i*16+k];k=k+1;} nused=nused+1; i=i+1; }
  i=0;
  while(i<3){ gen_name(rng,c12cn[i*16..i*16+16],used,nused,1); let k:i32=0; while(k<16){used[nused*16+k]=c12cn[i*16+k];k=k+1;} nused=nused+1; i=i+1; }
  // ---- remap permutation of [0,1,2,3] ----
  let remap:[]u8=z_alloc(4); remap[0]=0;remap[1]=1;remap[2]=2;remap[3]=3;
  i=3;
  while(i>0){ let j:i32=(rng_range(rng,(i+1) as i64) as i32); let tmp:u8=remap[i]; remap[i]=remap[j]; remap[j]=tmp; i=i-1; }
  // ---- causal chain: uniform draw from all 6 permutations of {0:X,1:Y,2:Z} ----
  // C9FIX: replaces Fisher-Yates (which reached only 3 of 6 permutations
  // under short-period low-bit draws) with a uniform permutation index.
  // Method from the committed C9BAT c9gen.zag (amendment A1).
  let c9perms:[]u8=z_alloc(6*3);
  c9perms[0]=0;c9perms[1]=1;c9perms[2]=2; c9perms[3]=0;c9perms[4]=2;c9perms[5]=1;
  c9perms[6]=1;c9perms[7]=0;c9perms[8]=2; c9perms[9]=1;c9perms[10]=2;c9perms[11]=0;
  c9perms[12]=2;c9perms[13]=0;c9perms[14]=1; c9perms[15]=2;c9perms[16]=1;c9perms[17]=0;
  let c9pi:i32=(rng_range(rng,6000) as i32)/1000;
  let chain:[]u8=z_alloc(3);
  chain[0]=c9perms[c9pi*3];chain[1]=c9perms[c9pi*3+1];chain[2]=c9perms[c9pi*3+2];
  // ---- C9FIX observations: noisy ancestral sampling; exactness NOT enforced ----
  // Root bit from rng_bit; each downstream node copies its parent bit and
  // flips with p=0.05. The old CHECK 1 (x==y==z enforcement) is REMOVED.
  let obs:[]u8=z_alloc(12*3);
  i=0;
  while(i<12){
    let c9v:[]u8=z_alloc(3);
    let rt:i32=rng_bit(rng);
    c9v[chain[0] as i32]=rt as u8;
    let md:i32=rt; if(rng_flip(rng)==1){md=1-md;}
    c9v[chain[1] as i32]=md as u8;
    let lf:i32=md; if(rng_flip(rng)==1){lf=1-lf;}
    c9v[chain[2] as i32]=lf as u8;
    obs[i*3]=c9v[0]; obs[i*3+1]=c9v[1]; obs[i*3+2]=c9v[2];
    z_free(c9v);
    i=i+1;
  }
  // ---- CHECK 2: DSL exhaustion (old language cannot express the transform) ----
  // ops: 0=COPY 1=SWAP12 2..5=CONST0..3 ; programs length 1..2
  let b0:i32=bsegs[0] as i32; let b1:i32=bsegs[1] as i32; let b2:i32=bsegs[2] as i32;
  let p1:i32=0;
  while(p1<6){
    let p2:i32=-1;
    while(p2<6){
      // apply program [p1] then [p2] (p2==-1 means length-1)
      let s0:i32=t0; let s1:i32=t1; let s2:i32=t2;
      // op p1
      if(p1==1){let tt:i32=s0;s0=s1;s1=tt;}
      if(p1>=2){s0=p1-2;s1=p1-2;s2=p1-2;}
      if(p2>=0){
        if(p2==1){let tt:i32=s0;s0=s1;s1=tt;}
        if(p2>=2){s0=p2-2;s1=p2-2;s2=p2-2;}
      }
      if(s0==b0 && s1==b1 && s2==b2){emit("DSL EXHAUSTION FAILED: old language expresses transform\n");return 2;}
      p2=p2+1;
    }
    p1=p1+1;
  }

  // ================= BATTERY + ANSWERS =================
  let bat:[]u8=z_alloc(16384); let bat_at:i32=0;
  let ans:[]u8=z_alloc(16384); let ans_at:i32=0;
  bat_at=app(bat,bat_at,"{\"n\":68,\"items\":[");
  ans_at=app(ans,ans_at,"{\"answers\":[");
  let nitems:i32=0;
  let tmp:[]u8=z_alloc(128); let tmp2:[]u8=z_alloc(128);
  let anm:[]u8=z_alloc(16); let atn:[]u8=z_alloc(16);
  // C1 (6)
  i=0;
  while(i<6){
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,enames[i*16..i*16+16]); at=app(tmp,at,"|");
    getattr(c1attr[i] as i32,atn); at=appz(tmp,at,atn);
    bat_at=emit_item(bat,bat_at,nitems,1,tmp[0..at]);
    if(nitems>0){ans_at=app(ans,ans_at,",");}
    ans_at=jstr(ans,ans_at,c1v[i*16..i*16+16][0..slen(c1v[i*16..i*16+16])]);
    nitems=nitems+1; i=i+1;
  }
  // C3 paraphrase (6): same facts, tag fact2
  i=0;
  while(i<6){
    let at:i32=app(tmp,0,"fact2|"); at=appz(tmp,at,enames[i*16..i*16+16]); at=app(tmp,at,"|");
    getattr(c1attr[i] as i32,atn); at=appz(tmp,at,atn);
    bat_at=emit_item(bat,bat_at,nitems,3,tmp[0..at]);
    ans_at=app(ans,ans_at,",");
    ans_at=jstr(ans,ans_at,c1v[i*16..i*16+16][0..slen(c1v[i*16..i*16+16])]);
    nitems=nitems+1; i=i+1;
  }
  // C4 compositional 2-hop (4)
  // items: (start_ent, rel1, rel2, answer_ent)
  let c4s:[]u8=z_alloc(4); c4s[0]=0;c4s[1]=1;c4s[2]=4;c4s[3]=5;
  let c4r1:[]u8=z_alloc(4); c4r1[0]=0;c4r1[1]=1;c4r1[2]=3;c4r1[3]=4;
  let c4r2:[]u8=z_alloc(4); c4r2[0]=1;c4r2[1]=2;c4r2[2]=4;c4r2[3]=5;
  let c4a:[]u8=z_alloc(4); c4a[0]=2;c4a[1]=3;c4a[2]=6;c4a[3]=7;
  i=0;
  while(i<4){
    let at:i32=app(tmp,0,"hop2|"); at=appz(tmp,at,enames[(c4s[i] as i32)*16..(c4s[i] as i32)*16+16]); at=app(tmp,at,"|");
    getrel(c4r1[i] as i32,atn); at=appz(tmp,at,atn); at=app(tmp,at,"|");
    getrel(c4r2[i] as i32,atn); at=appz(tmp,at,atn);
    bat_at=emit_item(bat,bat_at,nitems,4,tmp[0..at]);
    ans_at=app(ans,ans_at,",");
    ans_at=jstr(ans,ans_at,enames[(c4a[i] as i32)*16..(c4a[i] as i32)*16+16][0..slen(enames[(c4a[i] as i32)*16..(c4a[i] as i32)*16+16])]);
    nitems=nitems+1; i=i+1;
  }
  // C5 round 1 (3): corrected values
  i=0;
  while(i<3){
    let ei:i32=6+i;
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,enames[ei*16..ei*16+16]); at=app(tmp,at,"|");
    getattr(c5attr[i] as i32,atn); at=appz(tmp,at,atn);
    bat_at=emit_item(bat,bat_at,nitems,5,tmp[0..at]);
    ans_at=app(ans,ans_at,",");
    ans_at=jstr(ans,ans_at,c5n[i*16..i*16+16][0..slen(c5n[i*16..i*16+16])]);
    nitems=nitems+1; i=i+1;
  }
  // C6 conflicts (3)
  let c6ent:[]u8=z_alloc(3); c6ent[0]=2;c6ent[1]=3;c6ent[2]=4;
  i=0;
  while(i<3){
    let ei:i32=c6ent[i] as i32;
    let at:i32=app(tmp,0,"conflict|"); at=appz(tmp,at,enames[ei*16..ei*16+16]); at=app(tmp,at,"|");
    getattr(c6attr[i] as i32,atn); at=appz(tmp,at,atn);
    bat_at=emit_item(bat,bat_at,nitems,6,tmp[0..at]);
    ans_at=app(ans,ans_at,",");
    let at2:i32=appz(tmp2,0,c6v1[i*16..i*16+16]); at2=app(tmp2,at2,"|"); at2=appz(tmp2,at2,c6v2[i*16..i*16+16]);
    ans_at=jstr(ans,ans_at,tmp2[0..at2]);
    nitems=nitems+1; i=i+1;
  }
  // C7 unknown entities (3)
  let u7:[]u8=z_alloc(3*16);
  let k:i32=0; while(k<7){u7[k]="Zorblax"[k];k=k+1;} u7[7]=0;
  k=0; while(k<7){u7[16+k]="Quixnor"[k];k=k+1;} u7[23]=0;
  k=0; while(k<7){u7[32+k]="Velmira"[k];k=k+1;} u7[39]=0;
  let u7a:[]u8=z_alloc(3); u7a[0]=0;u7a[1]=1;u7a[2]=3;
  i=0;
  while(i<3){
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,u7[i*16..i*16+16]); at=app(tmp,at,"|");
    getattr(u7a[i] as i32,atn); at=appz(tmp,at,atn);
    bat_at=emit_item(bat,bat_at,nitems,7,tmp[0..at]);
    ans_at=app(ans,ans_at,","); ans_at=jstr(ans,ans_at,"UNKNOWN");
    nitems=nitems+1; i=i+1;
  }
  // C9FIX causal discriminating interventions (3): true chain vs one
  // alternative each, candidate order randomized by seeded coin flip.
  // The key is the FULL true chain string (not chain[0]).
  let perms:[]u8=z_alloc(6*3);
  perms[0]=0;perms[1]=1;perms[2]=2; perms[3]=0;perms[4]=2;perms[5]=1;
  perms[6]=1;perms[7]=0;perms[8]=2; perms[9]=1;perms[10]=2;perms[11]=0;
  perms[12]=2;perms[13]=0;perms[14]=1; perms[15]=2;perms[16]=1;perms[17]=0;
  let vn:[]u8=z_alloc(3*2); vn[0]=88;vn[1]=0; vn[2]=89;vn[3]=0; vn[4]=90;vn[5]=0;
  // C9D5FIX E1: store per-item candidate-order coin flip (1=true first, 0=alt first)
  let dflip:[]u8=z_alloc(3);
  // full true-chain string (also the answer key)
  let tcs:[]u8=z_alloc(16);
  let tcs_at:i32=0;
  let q3:i32=0;
  while(q3<3){ tcs_at=appz(tcs,tcs_at,vn[(chain[q3] as i32)*2..(chain[q3] as i32)*2+2]); if(q3<2){tcs_at=app(tcs,tcs_at,"->");} q3=q3+1; }
  let altc:i32=0;
  let pi:i32=0;
  while(pi<6){
    let same:i32=1;
    let q2:i32=0;
    while(q2<3){ if(perms[pi*3+q2]!=chain[q2]){same=0;} q2=q2+1; }
    if(same==0 && altc<3){
      // alternative chain string
      let acs:[]u8=z_alloc(16);
      let acs_at:i32=0;
      q3=0;
      while(q3<3){ acs_at=appz(acs,acs_at,vn[(perms[pi*3+q3] as i32)*2..(perms[pi*3+q3] as i32)*2+2]); if(q3<2){acs_at=app(acs,acs_at,"->");} q3=q3+1; }
      // q = discrim|<c1>|<c2>, candidate order by seeded coin flip
      // (prereg F4: heads (1) the true chain is listed first,
      // tails (0) the alternative is listed first)
      let at:i32=app(tmp,0,"discrim|");
      let flip:i32=rng_bit(rng);
      dflip[altc]=flip as u8; // C9D5FIX E2: record flip for the turn-replay path
      if(flip==1){
        at=app(tmp,at,tcs[0..tcs_at]); at=app(tmp,at,"|"); at=app(tmp,at,acs[0..acs_at]);
      } else {
        at=app(tmp,at,acs[0..acs_at]); at=app(tmp,at,"|"); at=app(tmp,at,tcs[0..tcs_at]);
      }
      z_free(acs);
      bat_at=emit_item(bat,bat_at,nitems,9,tmp[0..at]);
      ans_at=app(ans,ans_at,",");
      ans_at=jstr(ans,ans_at,tcs[0..tcs_at]);
      nitems=nitems+1; altc=altc+1;
    }
    pi=pi+1;
  }
  z_free(tcs);
  // C10 procedure invention (2): novel A-words -> B-form
  i=0;
  while(i<2){
    let at:i32=app(tmp,0,"zemprod|"); at=segs3(tmp,at,t0,t1,t2);
    bat_at=emit_item(bat,bat_at,nitems,10,tmp[0..at]);
    ans_at=app(ans,ans_at,",");
    let at2:i32=segs3(tmp2,0,b0,b1,b2);
    ans_at=jstr(ans,ans_at,tmp2[0..at2]);
    nitems=nitems+1; i=i+1;
  }
  // C11 representation invention (2): honest UNKNOWN
  bat_at=emit_item(bat,bat_at,nitems,11,"invent|notation");
  ans_at=app(ans,ans_at,","); ans_at=jstr(ans,ans_at,"UNKNOWN"); nitems=nitems+1;
  bat_at=emit_item(bat,bat_at,nitems,11,"invent|memory");
  ans_at=app(ans,ans_at,","); ans_at=jstr(ans,ans_at,"UNKNOWN"); nitems=nitems+1;
  // C12 transfer (6): 3 remap_prod + 3 remap_class
  let rstr:[]u8=z_alloc(16);
  let at:i32=app(rstr,0,i64s(remap[0] as i64)); at=app(rstr,at,","); at=app(rstr,at,i64s(remap[1] as i64));
  at=app(rstr,at,","); at=app(rstr,at,i64s(remap[2] as i64)); at=app(rstr,at,","); at=app(rstr,at,i64s(remap[3] as i64));
  let rlen:i32=at;
  i=0;
  while(i<3){
    let at2:i32=app(tmp,0,"remap_prod|"); at2=app(tmp,at2,rstr[0..rlen]); at2=app(tmp,at2,"|"); at2=segs3(tmp,at2,t0,t1,t2);
    bat_at=emit_item(bat,bat_at,nitems,12,tmp[0..at2]);
    ans_at=app(ans,ans_at,",");
    let rb0:i32=remap[b0] as i32; let rb1:i32=remap[b1] as i32; let rb2:i32=remap[b2] as i32;
    let at3:i32=segs3(tmp2,0,rb0,rb1,rb2);
    ans_at=jstr(ans,ans_at,tmp2[0..at3]);
    nitems=nitems+1; i=i+1;
  }
  // remap_class: valid, invalid, valid
  let c12v:[]u8=z_alloc(3); c12v[0]=1;c12v[1]=0;c12v[2]=1;
  i=0;
  while(i<3){
    let s0:i32=0; let s1:i32=0; let s2:i32=0;
    if(c12v[i]==1){ s0=remap[t0] as i32; s1=remap[t1] as i32; s2=remap[t2] as i32; }
    if(c12v[i]==0){ s0=(remap[t0] as i32+1)%4; s1=remap[t1] as i32; s2=remap[t2] as i32; }
    let at2:i32=app(tmp,0,"remap_class|"); at2=app(tmp,at2,rstr[0..rlen]); at2=app(tmp,at2,"|"); at2=segs3(tmp,at2,s0,s1,s2);
    bat_at=emit_item(bat,bat_at,nitems,12,tmp[0..at2]);
    ans_at=app(ans,ans_at,",");
    if(c12v[i]==1){ans_at=jstr(ans,ans_at,"yes");}
    if(c12v[i]==0){ans_at=jstr(ans,ans_at,"no");}
    nitems=nitems+1; i=i+1;
  }
  // C16 (6): 3 zemprod on new words + 3 zemclass (valid,invalid,valid)
  i=0;
  while(i<3){
    let at2:i32=app(tmp,0,"zemprod|"); at2=segs3(tmp,at2,t0,t1,t2);
    bat_at=emit_item(bat,bat_at,nitems,16,tmp[0..at2]);
    ans_at=app(ans,ans_at,",");
    let at3:i32=segs3(tmp2,0,b0,b1,b2);
    ans_at=jstr(ans,ans_at,tmp2[0..at3]);
    nitems=nitems+1; i=i+1;
  }
  let c16v:[]u8=z_alloc(3); c16v[0]=1;c16v[1]=0;c16v[2]=1;
  i=0;
  while(i<3){
    let s0:i32=t0; let s1:i32=t1; let s2:i32=t2;
    if(c16v[i]==0){ s0=(t0+1)%4; }
    let at2:i32=app(tmp,0,"zemclass|"); at2=segs3(tmp,at2,s0,s1,s2);
    bat_at=emit_item(bat,bat_at,nitems,16,tmp[0..at2]);
    ans_at=app(ans,ans_at,",");
    if(c16v[i]==1){ans_at=jstr(ans,ans_at,"yes");}
    if(c16v[i]==0){ans_at=jstr(ans,ans_at,"no");}
    nitems=nitems+1; i=i+1;
  }
  // ---- second test block (after interference): C5r2, C13, C2, C14, C15 ----
  // C5 round 2 (3)
  i=0;
  while(i<3){
    let ei:i32=6+i;
    let at2:i32=app(tmp,0,"fact|"); at2=appz(tmp,at2,enames[ei*16..ei*16+16]); at2=app(tmp,at2,"|");
    getattr(c5attr[i] as i32,atn); at2=appz(tmp,at2,atn);
    bat_at=emit_item(bat,bat_at,nitems,5,tmp[0..at2]);
    ans_at=app(ans,ans_at,",");
    ans_at=jstr(ans,ans_at,c5n[i*16..i*16+16][0..slen(c5n[i*16..i*16+16])]);
    nitems=nitems+1; i=i+1;
  }
  // C13 (6): re-probe C1 facts
  i=0;
  while(i<6){
    let at2:i32=app(tmp,0,"fact|"); at2=appz(tmp,at2,enames[i*16..i*16+16]); at2=app(tmp,at2,"|");
    getattr(c1attr[i] as i32,atn); at2=appz(tmp,at2,atn);
    bat_at=emit_item(bat,bat_at,nitems,13,tmp[0..at2]);
    ans_at=app(ans,ans_at,",");
    ans_at=jstr(ans,ans_at,c1v[i*16..i*16+16][0..slen(c1v[i*16..i*16+16])]);
    nitems=nitems+1; i=i+1;
  }
  // C2 delayed (4): entities 0..3
  i=0;
  while(i<4){
    let at2:i32=app(tmp,0,"fact|"); at2=appz(tmp,at2,enames[i*16..i*16+16]); at2=app(tmp,at2,"|");
    getattr(c1attr[i] as i32,atn); at2=appz(tmp,at2,atn);
    bat_at=emit_item(bat,bat_at,nitems,2,tmp[0..at2]);
    ans_at=app(ans,ans_at,",");
    ans_at=jstr(ans,ans_at,c1v[i*16..i*16+16][0..slen(c1v[i*16..i*16+16])]);
    nitems=nitems+1; i=i+1;
  }
  // C14 restart (6): 3 corrected + 3 C1
  i=0;
  while(i<3){
    let ei:i32=6+i;
    let at2:i32=app(tmp,0,"fact|"); at2=appz(tmp,at2,enames[ei*16..ei*16+16]); at2=app(tmp,at2,"|");
    getattr(c5attr[i] as i32,atn); at2=appz(tmp,at2,atn);
    bat_at=emit_item(bat,bat_at,nitems,14,tmp[0..at2]);
    ans_at=app(ans,ans_at,",");
    ans_at=jstr(ans,ans_at,c5n[i*16..i*16+16][0..slen(c5n[i*16..i*16+16])]);
    nitems=nitems+1; i=i+1;
  }
  i=0;
  while(i<3){
    let at2:i32=app(tmp,0,"fact|"); at2=appz(tmp,at2,enames[i*16..i*16+16]); at2=app(tmp,at2,"|");
    getattr(c1attr[i] as i32,atn); at2=appz(tmp,at2,atn);
    bat_at=emit_item(bat,bat_at,nitems,14,tmp[0..at2]);
    ans_at=app(ans,ans_at,",");
    ans_at=jstr(ans,ans_at,c1v[i*16..i*16+16][0..slen(c1v[i*16..i*16+16])]);
    nitems=nitems+1; i=i+1;
  }
  // C15 list names (1)
  bat_at=emit_item(bat,bat_at,nitems,15,"listnames");
  ans_at=app(ans,ans_at,",");
  let at2:i32=0;
  e=0;
  while(e<10){ if(e>0){at2=app(tmp2,at2,",");} at2=appz(tmp2,at2,enames[e*16..e*16+16]); e=e+1; }
  ans_at=jstr(ans,ans_at,tmp2[0..at2]);
  nitems=nitems+1;
  // C8 active inquiry (4)
  i=0;
  while(i<4){
    let ei:i32=c8ent[i] as i32;
    let at3:i32=app(tmp,0,"fact|"); at3=appz(tmp,at3,enames[ei*16..ei*16+16]); at3=app(tmp,at3,"|");
    getattr(c8attr[i] as i32,atn); at3=appz(tmp,at3,atn);
    bat_at=emit_item(bat,bat_at,nitems,8,tmp[0..at3]);
    ans_at=app(ans,ans_at,",");
    ans_at=jstr(ans,ans_at,c8v[i*16..i*16+16][0..slen(c8v[i*16..i*16+16])]);
    nitems=nitems+1; i=i+1;
  }
  bat_at=app(bat,bat_at,"]}");
  ans_at=app(ans,ans_at,"]}");

  if(nitems!=68){emit("battery count wrong\n");return 2;}
  // ================= replay (cap,q) per item for turn emission =================
  // (scorer cross-checks turns against battery.json; any divergence aborts)
  let itcap:[]u8=z_alloc(68*4);
  let itq:[]u8=z_alloc(68*96);
  let ri:i32=0;
  // helper macro pattern inlined: store cap + qstr
  i=0;
  while(i<6){
    st32(itcap,ri*4,1);
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,enames[i*16..i*16+16]); at=app(tmp,at,"|");
    getattr(c1attr[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<6){
    st32(itcap,ri*4,3);
    let at:i32=app(tmp,0,"fact2|"); at=appz(tmp,at,enames[i*16..i*16+16]); at=app(tmp,at,"|");
    getattr(c1attr[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<4){
    st32(itcap,ri*4,4);
    let at:i32=app(tmp,0,"hop2|"); at=appz(tmp,at,enames[(c4s[i] as i32)*16..(c4s[i] as i32)*16+16]); at=app(tmp,at,"|");
    getrel(c4r1[i] as i32,atn); at=appz(tmp,at,atn); at=app(tmp,at,"|");
    getrel(c4r2[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<3){
    st32(itcap,ri*4,5);
    let ei:i32=6+i;
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,enames[ei*16..ei*16+16]); at=app(tmp,at,"|");
    getattr(c5attr[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<3){
    st32(itcap,ri*4,6);
    let ei:i32=c6ent[i] as i32;
    let at:i32=app(tmp,0,"conflict|"); at=appz(tmp,at,enames[ei*16..ei*16+16]); at=app(tmp,at,"|");
    getattr(c6attr[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<3){
    st32(itcap,ri*4,7);
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,u7[i*16..i*16+16]); at=app(tmp,at,"|");
    getattr(u7a[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  pi=0; altc=0;
  while(pi<6){
    let same:i32=1;
    let q2:i32=0;
    while(q2<3){ if(perms[pi*3+q2]!=chain[q2]){same=0;} q2=q2+1; }
    if(same==0 && altc<3){
      st32(itcap,ri*4,9);
      let at:i32=app(tmp,0,"discrim|");
      let q3:i32=0;
      // C9D5FIX E3: honor the same per-item coin flip as the battery path
      if(dflip[altc]==1){
        while(q3<3){ at=appz(tmp,at,vn[(chain[q3] as i32)*2..(chain[q3] as i32)*2+2]); if(q3<2){at=app(tmp,at,"->");} q3=q3+1; }
        at=app(tmp,at,"|");
        q3=0;
        while(q3<3){ at=appz(tmp,at,vn[(perms[pi*3+q3] as i32)*2..(perms[pi*3+q3] as i32)*2+2]); if(q3<2){at=app(tmp,at,"->");} q3=q3+1; }
      } else {
        while(q3<3){ at=appz(tmp,at,vn[(perms[pi*3+q3] as i32)*2..(perms[pi*3+q3] as i32)*2+2]); if(q3<2){at=app(tmp,at,"->");} q3=q3+1; }
        at=app(tmp,at,"|");
        q3=0;
        while(q3<3){ at=appz(tmp,at,vn[(chain[q3] as i32)*2..(chain[q3] as i32)*2+2]); if(q3<2){at=app(tmp,at,"->");} q3=q3+1; }
      }
      let q4:i32=0; while(q4<at){itq[ri*96+q4]=tmp[q4];q4=q4+1;} itq[ri*96+at]=0;
      ri=ri+1; altc=altc+1;
    }
    pi=pi+1;
  }
  i=0;
  while(i<2){
    st32(itcap,ri*4,10);
    let at:i32=app(tmp,0,"zemprod|"); at=segs3(tmp,at,t0,t1,t2);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  st32(itcap,ri*4,11);
  let ql1:i32=app(tmp,0,"invent|notation");
  qx=0; while(qx<ql1){itq[ri*96+qx]=tmp[qx];qx=qx+1;} itq[ri*96+ql1]=0; ri=ri+1;
  st32(itcap,ri*4,11);
  let ql2:i32=app(tmp,0,"invent|memory");
  qx=0; while(qx<ql2){itq[ri*96+qx]=tmp[qx];qx=qx+1;} itq[ri*96+ql2]=0; ri=ri+1;
  i=0;
  while(i<3){
    st32(itcap,ri*4,12);
    let at:i32=app(tmp,0,"remap_prod|"); at=app(tmp,at,rstr[0..rlen]); at=app(tmp,at,"|"); at=segs3(tmp,at,t0,t1,t2);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<3){
    st32(itcap,ri*4,12);
    let s0:i32=0; let s1:i32=0; let s2:i32=0;
    if(c12v[i]==1){ s0=remap[t0] as i32; s1=remap[t1] as i32; s2=remap[t2] as i32; }
    if(c12v[i]==0){ s0=(remap[t0] as i32+1)%4; s1=remap[t1] as i32; s2=remap[t2] as i32; }
    let at:i32=app(tmp,0,"remap_class|"); at=app(tmp,at,rstr[0..rlen]); at=app(tmp,at,"|"); at=segs3(tmp,at,s0,s1,s2);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<3){
    st32(itcap,ri*4,16);
    let at:i32=app(tmp,0,"zemprod|"); at=segs3(tmp,at,t0,t1,t2);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<3){
    st32(itcap,ri*4,16);
    let s0:i32=t0; let s1:i32=t1; let s2:i32=t2;
    if(c16v[i]==0){ s0=(t0+1)%4; }
    let at:i32=app(tmp,0,"zemclass|"); at=segs3(tmp,at,s0,s1,s2);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  // second block: C5r2(3) C13(6) C2(4) C14(6) C15(1)
  i=0;
  while(i<3){
    st32(itcap,ri*4,5);
    let ei:i32=6+i;
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,enames[ei*16..ei*16+16]); at=app(tmp,at,"|");
    getattr(c5attr[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<6){
    st32(itcap,ri*4,13);
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,enames[i*16..i*16+16]); at=app(tmp,at,"|");
    getattr(c1attr[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<4){
    st32(itcap,ri*4,2);
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,enames[i*16..i*16+16]); at=app(tmp,at,"|");
    getattr(c1attr[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<3){
    st32(itcap,ri*4,14);
    let ei:i32=6+i;
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,enames[ei*16..ei*16+16]); at=app(tmp,at,"|");
    getattr(c5attr[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  i=0;
  while(i<3){
    st32(itcap,ri*4,14);
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,enames[i*16..i*16+16]); at=app(tmp,at,"|");
    getattr(c1attr[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  st32(itcap,ri*4,15);
  let ql3:i32=app(tmp,0,"listnames");
  qx=0; while(qx<ql3){itq[ri*96+qx]=tmp[qx];qx=qx+1;} itq[ri*96+ql3]=0; ri=ri+1;
  i=0;
  while(i<4){
    st32(itcap,ri*4,8);
    let ei:i32=c8ent[i] as i32;
    let at:i32=app(tmp,0,"fact|"); at=appz(tmp,at,enames[ei*16..ei*16+16]); at=app(tmp,at,"|");
    getattr(c8attr[i] as i32,atn); at=appz(tmp,at,atn);
    let q2:i32=0; while(q2<at){itq[ri*96+q2]=tmp[q2];q2=q2+1;} itq[ri*96+at]=0;
    ri=ri+1; i=i+1;
  }
  if(ri!=68){emit("replay count wrong\n");return 2;}

  // ================= TURNS + EXPOSURE =================
  let turns:[]u8=z_alloc(65536); let tt_at:i32=0;
  let exp:[]u8=z_alloc(32768); let exp_at:i32=0;
  let exptnn:[]u8=z_alloc(32768); let etn_at:i32=0;
  let turn:i32=0;
  // brief turn
  tt_at=app(turns,tt_at,"{\"turn\":0,\"kind\":\"brief\"}\n"); turn=1;
  // expo helper state
  // 6 C1 facts
  i=0;
  while(i<6){
    let at:i32=app(tmp,0,"{\"t\":\"f\",\"e\":\""); at=appz(tmp,at,enames[i*16..i*16+16]);
    at=app(tmp,at,"\",\"a\":\""); getattr(c1attr[i] as i32,atn); at=appz(tmp,at,atn);
    at=app(tmp,at,"\",\"v\":\""); at=appz(tmp,at,c1v[i*16..i*16+16]); at=app(tmp,at,"\"}");
    exp_at=app(exp,exp_at,tmp[0..at]); exp_at=app(exp,exp_at,"\n");
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"expo\",\"ev\":"); tt_at=app(turns,tt_at,tmp[0..at]); tt_at=app(turns,tt_at,"}\n");
    let vi:i32=valindex(c1attr[i] as i32,c1v[i*16..i*16+16]);
    let at2:i32=app(tmp2,0,"{\"t\":\"f\",\"seq\":[");
    at2=app(tmp2,at2,i64s(i as i64)); at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(c1attr[i] as i64));
    at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(vi as i64)); at2=app(tmp2,at2,"]}");
    etn_at=app(exptnn,etn_at,tmp2[0..at2]); etn_at=app(exptnn,etn_at,"\n");
    turn=turn+1; i=i+1;
  }
  // 3 C5 wrong facts
  i=0;
  while(i<3){
    let ei:i32=6+i;
    let at:i32=app(tmp,0,"{\"t\":\"f\",\"e\":\""); at=appz(tmp,at,enames[ei*16..ei*16+16]);
    at=app(tmp,at,"\",\"a\":\""); getattr(c5attr[i] as i32,atn); at=appz(tmp,at,atn);
    at=app(tmp,at,"\",\"v\":\""); at=appz(tmp,at,c5w[i*16..i*16+16]); at=app(tmp,at,"\"}");
    exp_at=app(exp,exp_at,tmp[0..at]); exp_at=app(exp,exp_at,"\n");
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"expo\",\"ev\":"); tt_at=app(turns,tt_at,tmp[0..at]); tt_at=app(turns,tt_at,"}\n");
    let vi:i32=valindex(c5attr[i] as i32,c5w[i*16..i*16+16]);
    let at2:i32=app(tmp2,0,"{\"t\":\"f\",\"seq\":[");
    at2=app(tmp2,at2,i64s(ei as i64)); at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(c5attr[i] as i64));
    at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(vi as i64)); at2=app(tmp2,at2,"]}");
    etn_at=app(exptnn,etn_at,tmp2[0..at2]); etn_at=app(exptnn,etn_at,"\n");
    turn=turn+1; i=i+1;
  }
  // 6 relations
  i=0;
  while(i<6){
    let ai:i32=ld32(rel,i*12); let ri2:i32=ld32(rel,i*12+4); let bi:i32=ld32(rel,i*12+8);
    let at:i32=app(tmp,0,"{\"t\":\"r\",\"a\":\""); at=appz(tmp,at,enames[ai*16..ai*16+16]);
    at=app(tmp,at,"\",\"r\":\""); getrel(ri2,atn); at=appz(tmp,at,atn);
    at=app(tmp,at,"\",\"b\":\""); at=appz(tmp,at,enames[bi*16..bi*16+16]); at=app(tmp,at,"\"}");
    exp_at=app(exp,exp_at,tmp[0..at]); exp_at=app(exp,exp_at,"\n");
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"expo\",\"ev\":"); tt_at=app(turns,tt_at,tmp[0..at]); tt_at=app(turns,tt_at,"}\n");
    let at2:i32=app(tmp2,0,"{\"t\":\"r\",\"seq\":[");
    at2=app(tmp2,at2,i64s(ai as i64)); at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(ri2 as i64));
    at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(bi as i64)); at2=app(tmp2,at2,"]}");
    etn_at=app(exptnn,etn_at,tmp2[0..at2]); etn_at=app(exptnn,etn_at,"\n");
    turn=turn+1; i=i+1;
  }
  // 5 A-words + 2 B-words
  i=0;
  while(i<7){
    let isA:i32=1; let wn:[]u8=z_alloc(16);
    if(i>=5){isA=0;}
    if(isA==1){let q2:i32=0;while(q2<16){wn[q2]=anames[i*16+q2];q2=q2+1;}}
    if(isA==0){let q2:i32=0;while(q2<16){wn[q2]=bnames[(i-5)*16+q2];q2=q2+1;}}
    let at:i32=app(tmp,0,"{\"t\":\"z\",\"w\":\""); at=appz(tmp,at,wn);
    if(isA==1){at=app(tmp,at,"\",\"cls\":\"A\",\"s\":["); at=segs3(tmp,at,t0,t1,t2);}
    if(isA==0){at=app(tmp,at,"\",\"cls\":\"B\",\"s\":["); at=segs3(tmp,at,b0,b1,b2);}
    at=app(tmp,at,"]}");
    exp_at=app(exp,exp_at,tmp[0..at]); exp_at=app(exp,exp_at,"\n");
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"expo\",\"ev\":"); tt_at=app(turns,tt_at,tmp[0..at]); tt_at=app(turns,tt_at,"}\n");
    let wid:i32=i;
    if(isA==0){wid=5+(i-5);}
    let at2:i32=app(tmp2,0,"{\"t\":\"z\",\"w\":"); at2=app(tmp2,at2,i64s(wid as i64));
    if(isA==1){at2=app(tmp2,at2,",\"cls\":\"A\",\"seq\":["); at2=segs3(tmp2,at2,t0,t1,t2);}
    if(isA==0){at2=app(tmp2,at2,",\"cls\":\"B\",\"seq\":["); at2=segs3(tmp2,at2,b0,b1,b2);}
    at2=app(tmp2,at2,"]}");
    etn_at=app(exptnn,etn_at,tmp2[0..at2]); etn_at=app(exptnn,etn_at,"\n");
    z_free(wn);
    turn=turn+1; i=i+1;
  }
  // 12 causal observations
  i=0;
  while(i<12){
    let x:i32=obs[i*3] as i32; let y:i32=obs[i*3+1] as i32; let z:i32=obs[i*3+2] as i32;
    let at:i32=app(tmp,0,"{\"t\":\"c\",\"x\":"); at=app(tmp,at,i64s(x as i64));
    at=app(tmp,at,",\"y\":"); at=app(tmp,at,i64s(y as i64));
    at=app(tmp,at,",\"z\":"); at=app(tmp,at,i64s(z as i64)); at=app(tmp,at,"}");
    exp_at=app(exp,exp_at,tmp[0..at]); exp_at=app(exp,exp_at,"\n");
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"expo\",\"ev\":"); tt_at=app(turns,tt_at,tmp[0..at]); tt_at=app(turns,tt_at,"}\n");
    let at2:i32=app(tmp2,0,"{\"t\":\"c\",\"seq\":[");
    at2=app(tmp2,at2,i64s(x as i64)); at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(y as i64));
    at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(z as i64)); at2=app(tmp2,at2,"]}");
    etn_at=app(exptnn,etn_at,tmp2[0..at2]); etn_at=app(exptnn,etn_at,"\n");
    turn=turn+1; i=i+1;
  }
  // C9FIX: real intervention turns (KDO=40 do() on X, then 40 on Z).
  // Each do() turn is immediately followed by its do_out outcome turn,
  // computed by intervened ancestral sampling in chain order
  // root, middle, leaf. do() outcomes discriminate chain direction:
  // do(root) moves all descendants; do(leaf) moves nothing;
  // do(middle) moves only its downstream side.
  let kdo:i32=40;
  let dv_i:i32=0;
  while(dv_i<2){
    let dvar:i32=0; if(dv_i==1){dvar=2;}
    let dd:i32=0;
    while(dd<kdo){
      let dval:i32=1; if((dd%2)==1){dval=0;}
      // do() turn
      let dat:i32=app(tmp,0,"{\"t\":\"do\",\"var\":\"");
      if(dvar==0){dat=app(tmp,dat,"X");} else {dat=app(tmp,dat,"Z");}
      dat=app(tmp,dat,"\",\"val\":"); dat=app(tmp,dat,i64s(dval as i64)); dat=app(tmp,dat,"}");
      exp_at=app(exp,exp_at,tmp[0..dat]); exp_at=app(exp,exp_at,"\n");
      tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
      tt_at=app(turns,tt_at,",\"kind\":\"expo\",\"ev\":"); tt_at=app(turns,tt_at,tmp[0..dat]); tt_at=app(turns,tt_at,"}\n");
      let dat2:i32=app(tmp2,0,"{\"t\":\"do\",\"seq\":[");
      dat2=app(tmp2,dat2,i64s(dvar as i64)); dat2=app(tmp2,dat2,","); dat2=app(tmp2,dat2,i64s(dval as i64)); dat2=app(tmp2,dat2,"]}");
      etn_at=app(exptnn,etn_at,tmp2[0..dat2]); etn_at=app(exptnn,etn_at,"\n");
      turn=turn+1;
      // do_out turn: intervened ancestral sampling in chain order
      let dout:[]u8=z_alloc(3);
      let ci:i32=0;
      while(ci<3){
        let cv:i32=chain[ci] as i32;
        if(cv==dvar){ dout[cv]=dval as u8; }
        else {
          if(ci==0){ dout[cv]=rng_bit(rng) as u8; }
          else {
            let pv:i32=dout[chain[ci-1] as i32] as i32;
            if(rng_flip(rng)==1){pv=1-pv;}
            dout[cv]=pv as u8;
          }
        }
        ci=ci+1;
      }
      let ox:i32=dout[0] as i32; let oy:i32=dout[1] as i32; let oz:i32=dout[2] as i32;
      z_free(dout);
      dat=app(tmp,0,"{\"t\":\"do_out\",\"x\":"); dat=app(tmp,dat,i64s(ox as i64));
      dat=app(tmp,dat,",\"y\":"); dat=app(tmp,dat,i64s(oy as i64));
      dat=app(tmp,dat,",\"z\":"); dat=app(tmp,dat,i64s(oz as i64)); dat=app(tmp,dat,"}");
      exp_at=app(exp,exp_at,tmp[0..dat]); exp_at=app(exp,exp_at,"\n");
      tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
      tt_at=app(turns,tt_at,",\"kind\":\"expo\",\"ev\":"); tt_at=app(turns,tt_at,tmp[0..dat]); tt_at=app(turns,tt_at,"}\n");
      dat2=app(tmp2,0,"{\"t\":\"do_out\",\"seq\":[");
      dat2=app(tmp2,dat2,i64s(ox as i64)); dat2=app(tmp2,dat2,","); dat2=app(tmp2,dat2,i64s(oy as i64));
      dat2=app(tmp2,dat2,","); dat2=app(tmp2,dat2,i64s(oz as i64)); dat2=app(tmp2,dat2,"]}");
      etn_at=app(exptnn,etn_at,tmp2[0..dat2]); etn_at=app(exptnn,etn_at,"\n");
      turn=turn+1;
      dd=dd+1;
    }
    dv_i=dv_i+1;
  }
  // 3 corrections
  i=0;
  while(i<3){
    let ei:i32=6+i;
    let at:i32=app(tmp,0,"{\"t\":\"k\",\"e\":\""); at=appz(tmp,at,enames[ei*16..ei*16+16]);
    at=app(tmp,at,"\",\"a\":\""); getattr(c5attr[i] as i32,atn); at=appz(tmp,at,atn);
    at=app(tmp,at,"\",\"old\":\""); at=appz(tmp,at,c5w[i*16..i*16+16]);
    at=app(tmp,at,"\",\"new\":\""); at=appz(tmp,at,c5n[i*16..i*16+16]); at=app(tmp,at,"\"}");
    exp_at=app(exp,exp_at,tmp[0..at]); exp_at=app(exp,exp_at,"\n");
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"expo\",\"ev\":"); tt_at=app(turns,tt_at,tmp[0..at]); tt_at=app(turns,tt_at,"}\n");
    let oi:i32=valindex(c5attr[i] as i32,c5w[i*16..i*16+16]);
    let ni:i32=valindex(c5attr[i] as i32,c5n[i*16..i*16+16]);
    let at2:i32=app(tmp2,0,"{\"t\":\"k\",\"seq\":[");
    at2=app(tmp2,at2,i64s(ei as i64)); at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(c5attr[i] as i64));
    at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(oi as i64)); at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(ni as i64));
    at2=app(tmp2,at2,"]}");
    etn_at=app(exptnn,etn_at,tmp2[0..at2]); etn_at=app(exptnn,etn_at,"\n");
    turn=turn+1; i=i+1;
  }
  // 3 conflict pairs
  i=0;
  while(i<3){
    let ei:i32=c6ent[i] as i32;
    let at:i32=app(tmp,0,"{\"t\":\"x\",\"e\":\""); at=appz(tmp,at,enames[ei*16..ei*16+16]);
    at=app(tmp,at,"\",\"a\":\""); getattr(c6attr[i] as i32,atn); at=appz(tmp,at,atn);
    at=app(tmp,at,"\",\"v1\":\""); at=appz(tmp,at,c6v1[i*16..i*16+16]);
    at=app(tmp,at,"\",\"s1\":\"archive\",\"v2\":\""); at=appz(tmp,at,c6v2[i*16..i*16+16]);
    at=app(tmp,at,"\",\"s2\":\"scout\"}");
    exp_at=app(exp,exp_at,tmp[0..at]); exp_at=app(exp,exp_at,"\n");
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"expo\",\"ev\":"); tt_at=app(turns,tt_at,tmp[0..at]); tt_at=app(turns,tt_at,"}\n");
    let v1i:i32=valindex(c6attr[i] as i32,c6v1[i*16..i*16+16]);
    let v2i:i32=valindex(c6attr[i] as i32,c6v2[i*16..i*16+16]);
    let at2:i32=app(tmp2,0,"{\"t\":\"x\",\"seq\":[");
    at2=app(tmp2,at2,i64s(ei as i64)); at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(c6attr[i] as i64));
    at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(v1i as i64)); at2=app(tmp2,at2,","); at2=app(tmp2,at2,i64s(v2i as i64));
    at2=app(tmp2,at2,"]}");
    etn_at=app(exptnn,etn_at,tmp2[0..at2]); etn_at=app(exptnn,etn_at,"\n");
    turn=turn+1; i=i+1;
  }
  // 3 new-word teachings
  i=0;
  while(i<3){
    let at:i32=app(tmp,0,"{\"t\":\"n\",\"w\":\""); at=appz(tmp,at,nwnames[i*16..i*16+16]);
    at=app(tmp,at,"\",\"gloss\":\"g"); at=app(tmp,at,i64s((7+i) as i64));
    at=app(tmp,at,"\",\"s\":["); at=segs3(tmp,at,t0,t1,t2); at=app(tmp,at,"]}");
    exp_at=app(exp,exp_at,tmp[0..at]); exp_at=app(exp,exp_at,"\n");
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"expo\",\"ev\":"); tt_at=app(turns,tt_at,tmp[0..at]); tt_at=app(turns,tt_at,"}\n");
    let at2:i32=app(tmp2,0,"{\"t\":\"n\",\"w\":"); at2=app(tmp2,at2,i64s((7+i) as i64));
    at2=app(tmp2,at2,",\"seq\":["); at2=segs3(tmp2,at2,t0,t1,t2); at2=app(tmp2,at2,"]}");
    etn_at=app(exptnn,etn_at,tmp2[0..at2]); etn_at=app(exptnn,etn_at,"\n");
    turn=turn+1; i=i+1;
  }
  // test items 0..43 (first block)
  let it:i32=0;
  while(it<44){
    let cp:i32=ld32(itcap,it*4);
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"test\",\"item\":"); tt_at=app(turns,tt_at,i64s(it as i64));
    tt_at=app(turns,tt_at,",\"cap\":"); tt_at=app(turns,tt_at,i64s(cp as i64));
    tt_at=app(turns,tt_at,",\"q\":\""); tt_at=appz(turns,tt_at,itq[it*96..it*96+96]); tt_at=app(turns,tt_at,"\"}\n");
    turn=turn+1; it=it+1;
  }
  // 10 interference turns
  i=0;
  while(i<10){
    let at:i32=app(tmp,0,"{\"t\":\"i\",\"n\":"); at=app(tmp,at,i64s(i as i64)); at=app(tmp,at,"}");
    exp_at=app(exp,exp_at,tmp[0..at]); exp_at=app(exp,exp_at,"\n");
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"expo\",\"ev\":"); tt_at=app(turns,tt_at,tmp[0..at]); tt_at=app(turns,tt_at,"}\n");
    let at2:i32=app(tmp2,0,"{\"t\":\"i\",\"seq\":["); at2=app(tmp2,at2,i64s(i as i64)); at2=app(tmp2,at2,"]}");
    etn_at=app(exptnn,etn_at,tmp2[0..at2]); etn_at=app(exptnn,etn_at,"\n");
    turn=turn+1; i=i+1;
  }
  // test items 44..63
  it=44;
  while(it<64){
    let cp:i32=ld32(itcap,it*4);
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"test\",\"item\":"); tt_at=app(turns,tt_at,i64s(it as i64));
    tt_at=app(turns,tt_at,",\"cap\":"); tt_at=app(turns,tt_at,i64s(cp as i64));
    tt_at=app(turns,tt_at,",\"q\":\""); tt_at=appz(turns,tt_at,itq[it*96..it*96+96]); tt_at=app(turns,tt_at,"\"}\n");
    turn=turn+1; it=it+1;
  }
  // C8: 4 x (question, observe_result, re-ask); items 64..67
  i=0;
  while(i<4){
    let it8:i32=64+i;
    let cp:i32=ld32(itcap,it8*4);
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"test\",\"item\":"); tt_at=app(turns,tt_at,i64s(it8 as i64));
    tt_at=app(turns,tt_at,",\"cap\":"); tt_at=app(turns,tt_at,i64s(cp as i64));
    tt_at=app(turns,tt_at,",\"q\":\""); tt_at=appz(turns,tt_at,itq[it8*96..it8*96+96]); tt_at=app(turns,tt_at,"\"}\n");
    turn=turn+1;
    // observe_result with the oracle fact
    let ei:i32=c8ent[i] as i32;
    let at:i32=app(tmp,0,"{\"turn\":"); at=app(tmp,at,i64s(turn as i64));
    at=app(tmp,at,",\"kind\":\"observe_result\",\"vals\":[{\"e\":\""); at=appz(tmp,at,enames[ei*16..ei*16+16]);
    at=app(tmp,at,"\",\"a\":\""); getattr(c8attr[i] as i32,atn); at=appz(tmp,at,atn);
    at=app(tmp,at,"\",\"v\":\""); at=appz(tmp,at,c8v[i*16..i*16+16]); at=app(tmp,at,"\"}]}");
    tt_at=app(turns,tt_at,tmp[0..at]); tt_at=app(turns,tt_at,"\n");
    turn=turn+1;
    // re-ask
    tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
    tt_at=app(turns,tt_at,",\"kind\":\"test\",\"item\":"); tt_at=app(turns,tt_at,i64s(it8 as i64));
    tt_at=app(turns,tt_at,",\"cap\":"); tt_at=app(turns,tt_at,i64s(cp as i64));
    tt_at=app(turns,tt_at,",\"q\":\""); tt_at=appz(turns,tt_at,itq[it8*96..it8*96+96]); tt_at=app(turns,tt_at,"\"}\n");
    turn=turn+1; i=i+1;
  }
  tt_at=app(turns,tt_at,"{\"turn\":"); tt_at=app(turns,tt_at,i64s(turn as i64));
  tt_at=app(turns,tt_at,",\"kind\":\"done\"}\n");
  turn=turn+1;

  // ================= BRIEFINGS =================
  let brf:[]u8=z_alloc(8192); let brf_at:i32=0;
  brf_at=app(brf,brf_at,"{\"t\":\"entities\",\"names\":[");
  e=0;
  while(e<10){ if(e>0){brf_at=app(brf,brf_at,",");} brf_at=jstr(brf,brf_at,enames[e*16..e*16+16][0..slen(enames[e*16..e*16+16])]); e=e+1; }
  brf_at=app(brf,brf_at,"]}\n{\"t\":\"attrs\",\"attrs\":[");
  i=0;
  while(i<5){ if(i>0){brf_at=app(brf,brf_at,",");} getattr(i,atn); brf_at=jstr(brf,brf_at,atn[0..slen(atn)]); i=i+1; }
  brf_at=app(brf,brf_at,"]}\n{\"t\":\"relations\",\"rels\":[");
  i=0;
  while(i<6){ if(i>0){brf_at=app(brf,brf_at,",");} getrel(i,atn); brf_at=jstr(brf,brf_at,atn[0..slen(atn)]); i=i+1; }
  brf_at=app(brf,brf_at,"]}\n{\"t\":\"zemfmt\",\"k\":3,\"nvals\":4}\n{\"t\":\"causalvars\",\"vars\":[\"X\",\"Y\",\"Z\"]}\n{\"t\":\"causaldo\",\"kdo\":40,\"note\":\"do/do_out intervention pairs appear in exposure\"}\n");
  let brftxt:[]u8=z_alloc(8192); let btx_at:i32=0;
  btx_at=app(brftxt,btx_at,"You are entering a synthetic world you have never seen before.\n");
  btx_at=app(brftxt,btx_at,"This world contains 10 entities: ");
  e=0;
  while(e<10){ if(e>0){btx_at=app(brftxt,btx_at,", ");} btx_at=appz(brftxt,btx_at,enames[e*16..e*16+16]); e=e+1; }
  btx_at=app(brftxt,btx_at,".\nEach entity can have these attributes: color, size, material, shape, temper.\n");
  btx_at=app(brftxt,btx_at,"Entities can stand in these relations: mentor_of, ally_of, rival_of, kin_of, student_of, guardian_of.\n");
  btx_at=app(brftxt,btx_at,"Zem is a constructed language. Every Zem word has 3 segments; each segment is a value from 0 to 3.\n");
  btx_at=app(brftxt,btx_at,"Three causal variables are named X, Y, and Z.\n");
  btx_at=app(brftxt,btx_at,"You will observe facts, relations, Zem words, causal observations, and causal interventions (do/do_out pairs) across turns.\n");
  btx_at=app(brftxt,btx_at,"Some facts may later be corrected; some evidence may conflict. Track what you know and how sure you are.\n");
  // ================= LLM PROMPT PACK (frozen protocol for a future LLM runner) =================
  let pack:[]u8=z_alloc(16384); let pk_at:i32=0;
  pk_at=app(pack,pk_at,"FROZEN LLM BASELINE PROTOCOL (competitive arena CA-1).\n");
  pk_at=app(pack,pk_at,"You are a general intelligent system taking part in a capability evaluation in a synthetic world.\n");
  pk_at=app(pack,pk_at,"Rules: answer each question with exactly one line. If you do not know, write UNKNOWN.\n");
  pk_at=app(pack,pk_at,"You may keep persistent notes across turns. Before answering a question about a fact you have not observed, you may emit OBSERVE requests of the form OBSERVE entity attribute, one per line, ending with END. The observations will be provided, then the question repeats.\n");
  pk_at=app(pack,pk_at,"World briefing (identical in content to the TNN structured briefing):\n");
  pk_at=app(pack,pk_at,brftxt[0..btx_at]);
  pk_at=app(pack,pk_at,"Turn protocol: each turn is one JSON object with a kind field: brief, expo (an observation event), test (a question with fields item, cap, q), observe_result (answers to your OBSERVE requests), done.\n");
  pk_at=app(pack,pk_at,"Reply to test turns with your single-line answer. This pack is frozen; a future runner executes the LLM cell against the committed battery without changing the arena.\n");
  // ================= IDMAP =================
  let idm:[]u8=z_alloc(8192); let idm_at:i32=0;
  idm_at=app(idm,idm_at,"{\"entities\":[");
  e=0;
  while(e<10){ if(e>0){idm_at=app(idm,idm_at,",");} idm_at=jstr(idm,idm_at,enames[e*16..e*16+16][0..slen(enames[e*16..e*16+16])]); e=e+1; }
  idm_at=app(idm,idm_at,"],\"attrs\":[");
  i=0;
  while(i<5){ if(i>0){idm_at=app(idm,idm_at,",");} getattr(i,atn); idm_at=jstr(idm,idm_at,atn[0..slen(atn)]); i=i+1; }
  idm_at=app(idm,idm_at,"],\"relations\":[");
  i=0;
  while(i<6){ if(i>0){idm_at=app(idm,idm_at,",");} getrel(i,atn); idm_at=jstr(idm,idm_at,atn[0..slen(atn)]); i=i+1; }
  idm_at=app(idm,idm_at,"],\"values\":[");
  i=0;
  while(i<5){
    if(i>0){idm_at=app(idm,idm_at,",");}
    idm_at=app(idm,idm_at,"[");
    let v:i32=0;
    while(v<5){ if(v>0){idm_at=app(idm,idm_at,",");} tabget(valtab(i),v,8,atn); idm_at=jstr(idm,idm_at,atn[0..slen(atn)]); v=v+1; }
    idm_at=app(idm,idm_at,"]");
    i=i+1;
  }
  idm_at=app(idm,idm_at,"],\"zem\":{\"k\":3,\"nvals\":4,\"template\":[");
  idm_at=segs3(idm,idm_at,t0,t1,t2);
  idm_at=app(idm,idm_at,"],\"transform\":"); idm_at=app(idm,idm_at,i64s(tid as i64));
  idm_at=app(idm,idm_at,"},\"causal_chain\":\"");
  i=0;
  while(i<3){ idm_at=appz(idm,idm_at,vn[(chain[i] as i32)*2..(chain[i] as i32)*2+2]); if(i<2){idm_at=app(idm,idm_at,"->");} i=i+1; }
  idm_at=app(idm,idm_at,"\"}");
  // ================= PROOFS =================
  let prf:[]u8=z_alloc(4096); let prf_at:i32=0;
  prf_at=app(prf,prf_at,"causal_noise: 12 observations via ancestral sampling, per-edge flip p=0.05; exact co-movement NOT enforced (C9FIX removes CHECK 1).\n");
  prf_at=app(prf,prf_at,"consequence: chain direction identifiable from the do/do_out intervention turns (KDO=40 per variable); observations alone identify the chain up to reversal.\n");
  prf_at=app(prf,prf_at,"c9fix: discrim candidate order randomized by seeded coin flip; keys are full chain strings; old format exploit (first-candidate first-variable) scores 0.\n");
  prf_at=app(prf,prf_at,"dsl_exhaustion: enumerated 42 programs over {COPY,SWAP12,CONST0..3} up to length 2; none maps the observed A-words to their B-words.\n");
  prf_at=app(prf,prf_at,"transform_id: "); prf_at=app(prf,prf_at,i64s(tid as i64));
  prf_at=app(prf,prf_at," (0=reverse,1=rotl1,2=xor1,3=swap_halves); template: ");
  prf_at=segs3(prf,prf_at,t0,t1,t2); prf_at=app(prf,prf_at,"\n");
  prf_at=app(prf,prf_at,"causal_chain: ");
  i=0;
  while(i<3){ prf_at=appz(prf,prf_at,vn[(chain[i] as i32)*2..(chain[i] as i32)*2+2]); if(i<2){prf_at=app(prf,prf_at,"->");} i=i+1; }
  prf_at=app(prf,prf_at,"\nseed: 71503462337033 (LCG); generator: world_gen.zag (pure Zag)\n");
  // ================= NOVELTY =================
  let nov:[]u8=z_alloc(1024); let nov_at:i32=0;
  nov_at=app(nov,nov_at,"{\"names_checked\":10,\"violations\":0,\"blocklist\":[\"the\",\"and\",\"cat\",\"dog\",\"red\",\"blue\",\"man\",\"king\",\"run\",\"eat\",\"big\"]}");
  // ================= WRITE FILES =================
  let fd:i64=w_open(pjoin(outdir,"battery.json"));
  w_write(fd,bat[0..bat_at]); w_close(fd);
  fd=w_open(pjoin(outdir,"answer_key.json"));
  w_write(fd,ans[0..ans_at]); w_close(fd);
  fd=w_open(pjoin(outdir,"idmap.json"));
  w_write(fd,idm[0..idm_at]); w_close(fd);
  fd=w_open(pjoin(outdir,"exposure.jsonl"));
  w_write(fd,exp[0..exp_at]); w_close(fd);
  fd=w_open(pjoin(outdir,"exposure_tnn.jsonl"));
  w_write(fd,exptnn[0..etn_at]); w_close(fd);
  fd=w_open(pjoin(outdir,"briefing_tnn.jsonl"));
  w_write(fd,brf[0..brf_at]); w_close(fd);
  fd=w_open(pjoin(outdir,"briefing_llm.txt"));
  w_write(fd,brftxt[0..btx_at]); w_close(fd);
  fd=w_open(pjoin(outdir,"llm_prompt_pack.txt"));
  w_write(fd,pack[0..pk_at]); w_close(fd);
  fd=w_open(pjoin(outdir,"turns.jsonl"));
  w_write(fd,turns[0..tt_at]); w_close(fd);
  fd=w_open(pjoin(outdir,"proofs.txt"));
  w_write(fd,prf[0..prf_at]); w_close(fd);
  fd=w_open(pjoin(outdir,"novelty_check.json"));
  w_write(fd,nov[0..nov_at]); w_close(fd);
  emit("world_gen ok turns=");
  emit(i64s(turn as i64));
  emit(" items=");
  emit(i64s(nitems as i64));
  emit("\n");
  return 0;
}

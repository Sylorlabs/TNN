// bare_battery.zag: C15 abstention-bound battery generator (pure Zag).
// Emits <outdir>/turns.jsonl: 1 brief turn, 4 expo f events (roster of 4),
// 12 bare-prompt test turns (4 roster requests, 8 non-roster), 1 done turn.
// Usage: bare_battery <outdir>
// --- basic utils (dialect-conformant, same as world_gen) ---
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn app(b:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[at+i]=s[i]; i=i+1; }
  return at+s.len;
}
fn appz(b:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len && s[i]!=0){ b[at+i]=s[i]; i=i+1; }
  return at+i;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn pjoin(a:[]u8,b:[]u8)[]u8 {
  let o:[]u8=z_alloc(a.len+b.len+2);
  let at:i32=app(o,0,a);
  o[at]=47; at=at+1;
  at=app(o,at,b);
  o[at]=0;
  return o;
}
fn emit_turn(fd:i64,turn:i32,kind:[]u8,rest:[]u8)void {
  let tmp:[]u8=z_alloc(512);
  let at:i32=app(tmp,0,"{\"turn\":");
  at=app(tmp,at,i64s(turn as i64));
  at=app(tmp,at,",\"kind\":\"");
  at=appz(tmp,at,kind);
  at=app(tmp,at,"\"");
  at=app(tmp,at,rest);
  at=app(tmp,at,"}\n");
  w_write(fd,tmp[0..at]);
  z_free(tmp);
  return;
}
fn main()i32 {
  let outdir:[]u8=_zag_arg(1);
  if(outdir.len==0){ return 1; }
  let fd:i64=w_open(pjoin(outdir,"turns.jsonl"));
  let t:i32=0;
  let empty:[]u8=z_alloc(1); empty[0]=0;
  emit_turn(fd,t,"brief",empty[0..0]); t=t+1;
  // roster: 4 entities, one fact each
  let en:[]u8=z_alloc(4*8);
  en[0]=65;en[1]=108;en[2]=112;en[3]=104;en[4]=97;en[5]=0; // Alpha
  en[8]=66;en[9]=101;en[10]=116;en[11]=97;en[12]=0;       // Beta
  en[16]=71;en[17]=97;en[18]=109;en[19]=109;en[20]=97;en[21]=0; // Gamma
  en[24]=68;en[25]=101;en[26]=108;en[27]=116;en[28]=97;en[29]=0; // Delta
  let av:[]u8=z_alloc(4*8);
  av[0]=114;av[1]=101;av[2]=100;av[3]=0;   // red
  av[8]=98;av[9]=108;av[10]=117;av[11]=101;av[12]=0; // blue
  av[16]=103;av[17]=114;av[18]=101;av[19]=101;av[20]=110;av[21]=0; // green
  av[24]=103;av[25]=111;av[26]=108;av[27]=100;av[28]=0; // gold
  let i:i32=0;
  while(i<4){
    let tmp:[]u8=z_alloc(256);
    let at:i32=app(tmp,0,",\"ev\":{\"t\":\"f\",\"e\":\"");
    at=appz(tmp,at,en[i*8..i*8+8]);
    at=app(tmp,at,"\",\"a\":\"color\",\"v\":\"");
    at=appz(tmp,at,av[i*8..i*8+8]);
    at=app(tmp,at,"\"}");
    emit_turn(fd,t,"expo",tmp[0..at]);
    z_free(tmp);
    t=t+1; i=i+1;
  }
  // 12 bare prompts: 4 roster requests, 8 non-roster
  let pr:[]u8=z_alloc(12*16);
  // roster requests
  pr[0]=108;pr[1]=105;pr[2]=115;pr[3]=116;pr[4]=110;pr[5]=97;pr[6]=109;pr[7]=101;pr[8]=115;pr[9]=0; // listnames
  pr[16]=114;pr[17]=111;pr[18]=115;pr[19]=116;pr[20]=101;pr[21]=114;pr[22]=0; // roster
  pr[32]=110;pr[33]=97;pr[34]=109;pr[35]=101;pr[36]=115;pr[37]=0; // names
  pr[48]=119;pr[49]=104;pr[50]=111;pr[51]=0; // who
  // non-roster
  pr[64]=119;pr[65]=104;pr[66]=97;pr[67]=116;pr[68]=116;pr[69]=105;pr[70]=109;pr[71]=101;pr[72]=0; // whattime
  pr[80]=105;pr[81]=110;pr[82]=118;pr[83]=101;pr[84]=110;pr[85]=116;pr[86]=0; // invent
  pr[96]=102;pr[97]=111;pr[98]=111;pr[99]=0; // foo
  pr[112]=120;pr[113]=121;pr[114]=122;pr[115]=122;pr[116]=121;pr[117]=0; // xyzzy
  pr[128]=98;pr[129]=108;pr[130]=111;pr[131]=114;pr[132]=112;pr[133]=0; // blorp
  pr[144]=115;pr[145]=105;pr[146]=110;pr[147]=103;pr[148]=0; // sing
  pr[160]=100;pr[161]=97;pr[162]=110;pr[163]=99;pr[164]=101;pr[165]=0; // dance
  pr[176]=119;pr[177]=101;pr[178]=97;pr[179]=116;pr[180]=104;pr[181]=101;pr[182]=114;pr[183]=0; // weather
  i=0;
  while(i<12){
    let tmp:[]u8=z_alloc(256);
    let at:i32=app(tmp,0,",\"item\":");
    at=app(tmp,at,i64s(i as i64));
    at=app(tmp,at,",\"cap\":15,\"q\":\"");
    at=appz(tmp,at,pr[i*16..i*16+16]);
    at=app(tmp,at,"\"");
    emit_turn(fd,t,"test",tmp[0..at]);
    z_free(tmp);
    t=t+1; i=i+1;
  }
  emit_turn(fd,t,"done",empty[0..0]); t=t+1;
  w_close(fd);
  z_free(empty); z_free(en); z_free(av); z_free(pr);
  return 0;
}

// rt_xk_probe.zag -- RED-TEAM probe: phase-A facts WITHOUT count queries.
// If CHAIN MAPs still build, the rebind uses facts, not COUNT MAPs.
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,95001,21,95101); ev_teach(W,95101,21,95201); ev_teach(W,95201,21,95301);
  // NO count query here
  let b:i32=ev_query(W,95001,40,-2,1);
  emit("REBIND ans="); e64(b); emit("\n");
  let n:i32=2; let found:i32=0;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==95001 && ng(W,n,4)==40){found=1;}
    n=n+1;
  }
  emit("CHAINMAP_EXISTS "); e64(found); emit("\n");
  return 0;
}

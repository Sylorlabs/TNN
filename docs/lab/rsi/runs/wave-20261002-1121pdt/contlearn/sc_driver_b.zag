// sc_driver_b.zag -- schedule B (96 events) driver for the scheduling exercise.
// Identical to sc_driver_a.zag except the schedule: the three 850-misses
// are spread at ev 21, 52, 83 among interference teaches, so the
// state-driven scheduler must fire at evidx 83 (|83-5|=78 kills
// fixed-position hypotheses). Frozen prereg PREREG_B.md section 3.
// (wave-20261002-1121pdt, lane CONTLEARN, exercise b).
// Phase-2 implementation for frozen prereg PREREG_B.md.
//
// FIXTURE ONLY. 0 cognition functions, 0 structural writes, 0 new tags,
// 0 new edge types, 0 new opcodes, 0 modes, 0 bridges, 0 routers,
// 0 task-specific handlers, 0 semantic cases. Emits the frozen 20-event
// schedule A, calls the frozen event API plus the core's sc_sched_scan
// (uniformly after EVERY event; the firing decision is core-side), runs
// read-only white-box censuses through the core's own accessors, and
// prints results. The driver NEVER calls pf_propose or pf_find (B-S2).
// No branching-on-opcode statements. All names sc_ prefixed; the frozen
// source contains zero sc_ occurrences. PHASE markers are driver-side
// prints; cognition receives only integer tuples. Masked queries use
// expected=-2, flags=1 (disclosed supervisor-disconnect).
fn sc_fnv(W:[]u8)i32 {
  let h:i32=-2128831035;
  let i:i32=0;
  while(i<110656){ h=(h ^ (W[i] as i32))*16777619; i=i+1; }
  return h;
}
fn sc_alive_nodes(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn sc_count_edges_all(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
// cognition choke point: uniform post-event scheduler invocation.
fn sc_event(W:[]u8,kind:i32,s:i32,r:i32,o:i32)i32 {
  if(kind<1 || kind>3){ emit("AUDIT_FAIL kind="); e64(kind); emit("\n"); return -999; }
  emit("EV "); e64(kind); emit(" "); e64(s); emit(" "); e64(r); emit(" "); e64(o);
  hs(W,52,hg(W,52)+1);
  if(kind==1){ let q:i32=ev_teach(W,s,r,o); emit("\n"); sc_sched_scan(W,hg(W,52)); return q; }
  if(kind==2){ let a:i32=ev_query(W,s,r,-2,1); emit(" ans="); e64(a); emit("\n"); sc_sched_scan(W,hg(W,52)); return a; }
  let v:i32=ev_observe(W,s,r,o); emit(" rv="); e64(v); emit("\n"); sc_sched_scan(W,hg(W,52)); return v;
}
// find a node by tag and fields; returns node id or -1.
fn sc_find_node(W:[]u8,tag:i32,f20:i32,f24:i32,f28:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==tag && ng(W,n,20)==f20 && ng(W,n,24)==f24 && ng(W,n,28)==f28){return n;}
    n=n+1;
  }
  return -1;
}
// check a type-1 edge exists from src to dst.
fn sc_has_t1(W:[]u8,src:i32,dst:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==src && eg(W,e,4)==1 && eg(W,e,8)==dst){return 1;}
    e=e+1;
  }
  return 0;
}
// EPISODE_OK: chain MAP for (98301,850) DEP-cites both chain facts and
// the proposal, and answers 98321.
fn sc_episode_ok(W:[]u8)i32 {
  // find MAP by (s=98301,r=850): tag-20, field8=98301, field4=850
  let m:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==98301 && ng(W,n,4)==850){m=n;}
    n=n+1;
  }
  if(m<0){ emit("EPISODE_OK 0/1 nomap\n"); return 0; }
  if(ng(W,m,28)!=98321){ emit("EPISODE_OK 0/1 badans\n"); return 0; }
  let f1:i32=sc_find_node(W,1,98301,860,98311);
  let f2:i32=sc_find_node(W,1,98311,861,98321);
  if(f1<0 || f2<0){ emit("EPISODE_OK 0/1 nofacts\n"); return 0; }
  if(sc_has_t1(W,m,f1)==0 || sc_has_t1(W,m,f2)==0){ emit("EPISODE_OK 0/1 nodep\n"); return 0; }
  // proposal node: tag-1, field20=30, field24=-998, field4=98301, field28=850
  let p:i32=-1; n=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-998 && ng(W,n,4)==98301 && ng(W,n,28)==850){p=n;}
    n=n+1;
  }
  if(p<0){ emit("EPISODE_OK 0/1 noprop\n"); return 0; }
  if(sc_has_t1(W,m,p)==0){ emit("EPISODE_OK 0/1 nopropdep\n"); return 0; }
  emit("EPISODE_OK 1/1\n");
  return 1;
}
fn sc_capacity_guard(W:[]u8)i32 {
  let nn:i32=sc_alive_nodes(W);
  let ee:i32=sc_count_edges_all(W);
  emit("CAPGUARD nodes="); e64(nn); emit(" edges="); e64(ee); emit("\n");
  if(nn>=900 || ee>=3500){ emit("CAP_GUARD_TRIP\n"); return 1; }
  emit("CAP_GUARD_OK\n");
  return 0;
}
// ============ schedule B: 96 events (frozen, PREREG_B section 3) ============
fn sc_main()i32 {
  emit("MODE SC-B\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("PHASE CHAINFACTS\n");
  sc_event(W,1,98301,860,98311);
  sc_event(W,1,98311,861,98321);
  emit("PHASE INTERFERENCE1\n");
  let i:i32=0;
  while(i<18){ sc_event(W,1,99001+i,870+(i%5),99101+i); i=i+1; }
  emit("PHASE MISS1\n");
  sc_event(W,2,98301,850,0);
  emit("PHASE INTERFERENCE2\n");
  i=0;
  while(i<30){ sc_event(W,1,99019+i,870+(i%5),99119+i); i=i+1; }
  emit("PHASE MISS2\n");
  sc_event(W,2,98301,850,0);
  emit("PHASE INTERFERENCE3\n");
  i=0;
  while(i<30){ sc_event(W,1,99049+i,870+(i%5),99149+i); i=i+1; }
  emit("PHASE MISS3\n");
  sc_event(W,2,98301,850,0);
  emit("PHASE EPISODE\n");
  sc_event(W,2,98301,850,0);
  sc_episode_ok(W);
  emit("PHASE INTERFERENCE4\n");
  i=0;
  while(i<12){ sc_event(W,2,99001+i,870+(i%5),0); i=i+1; }
  if(sc_capacity_guard(W)==1){ return 1; }
  emit("FNV "); e64(sc_fnv(W)); emit("\n");
  if(hg(W,52)==96){ emit("AUDIT_PASS\n"); }
  else { emit("AUDIT_FAIL count="); e64(hg(W,52)); emit(" want=96\n"); return 1; }
  return 0;
}
fn main()i32 { return sc_main(); }

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,96001,21,96101); ev_teach(W,96101,21,96201); ev_teach(W,96201,21,96301);
  emit("COUNT query (96001,43,3,0): ");
  let a:i32=ev_query(W,96001,43,3,0);
  emit(" ans="); e64(a); emit("\n");
  emit("CHAIN query (96001,40,-2,1): ");
  let b:i32=ev_query(W,96001,40,-2,1);
  emit(" ans="); e64(b); emit("\n");
  // census MAPs
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20){
      emit("MAP s="); e64(ng(W,n,8)); emit(" r="); e64(ng(W,n,4));
      emit(" ans="); e64(ng(W,n,28)); emit(" root="); e64(ng(W,n,20)); emit("\n");
    }
    n=n+1;
  }
  return 0;
}

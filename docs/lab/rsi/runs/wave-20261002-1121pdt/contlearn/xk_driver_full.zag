// xk_driver_full.zag -- full battery (99 events) for the cross-kind rebind.
// (wave-20261002-1121pdt, lane CONTLEARN, exercise c).
// Phase-2 implementation for frozen prereg PREREG_C.md.
//
// FIXTURE ONLY. 0 cognition functions, 0 structural writes, 0 new tags,
// 0 new edge types, 0 new opcodes, 0 modes, 0 bridges, 0 routers,
// 0 task-specific handlers, 0 semantic cases. Emits the frozen 99-event
// battery against the UNMODIFIED frozen control core (xk_core.zag, byte
// copy), runs read-only white-box censuses through the core's own
// accessors (ng/eg/activate/is_superseded/t2_sig), and prints results.
// CQUERY is driver shorthand for ev_query(W,s,43,3,0): unmasked count
// query with disclosed expected=3 (E-ruling: post-hoc feedback, not
// supervision). Masked queries use expected=-2, flags=1.
fn xk_fnv(W:[]u8)i32 {
  let h:i32=-2128831035;
  let i:i32=0;
  while(i<110656){ h=(h ^ (W[i] as i32))*16777619; i=i+1; }
  return h;
}
fn xk_alive_nodes(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn xk_count_edges_all(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
// choke points.
fn xk_event(W:[]u8,kind:i32,s:i32,r:i32,o:i32)i32 {
  if(kind<1 || kind>3){ emit("AUDIT_FAIL kind="); e64(kind); emit("\n"); return -999; }
  emit("EV "); e64(kind); emit(" "); e64(s); emit(" "); e64(r); emit(" "); e64(o);
  hs(W,52,hg(W,52)+1);
  if(kind==1){ let q:i32=ev_teach(W,s,r,o); emit("\n"); return q; }
  if(kind==2){ let a:i32=ev_query(W,s,r,o,1); emit(" ans="); e64(a); emit("\n"); return a; }
  let v:i32=ev_observe(W,s,r,o); emit(" rv="); e64(v); emit("\n"); return v;
}
// unmasked count query (E-ruling: expected is post-hoc feedback).
fn xk_cquery(W:[]u8,s:i32)i32 {
  emit("EV 2 "); e64(s); emit(" 43 3");
  hs(W,52,hg(W,52)+1);
  let a:i32=ev_query(W,s,43,3,0);
  emit(" ans="); e64(a); emit("\n");
  return a;
}
// find MAP node by (s,r).
fn xk_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
// find fact node by (s,r,o).
fn xk_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// type-1 edge from src to dst?
fn xk_has_t1(W:[]u8,src:i32,dst:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==src && eg(W,e,4)==1 && eg(W,e,8)==dst){return 1;}
    e=e+1;
  }
  return 0;
}
// count tag-103 (INC) cells in the graph rooted at root, via t2_sig.
fn xk_count103(W:[]u8,root:i32)i32 {
  let sig:[]u8=z_alloc(256);
  let c:i32=t2_sig(W,root,sig);
  let k:i32=0; let i:i32=0;
  while(i<c){ if(get32(sig,i*8)==103){k=k+1;} i=i+1; }
  return k;
}
// C-R0: 6/6 COUNT MAPs answering 3.
fn xk_oracle_c0(W:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<6){
    let m:i32=xk_find_map(W,95001+i,43);
    if(m>=0 && ng(W,m,28)==3){c=c+1;}
    i=i+1;
  }
  emit("COUNTMAP_OK "); e64(c); emit("/6\n");
  if(c==6){return 1;} return 0;
}
// C-R1: 6/6 CHAIN MAPs answering b_i with DEP to phase-A facts.
fn xk_oracle_c1(W:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<6){
    let m:i32=xk_find_map(W,95001+i,40);
    if(m>=0 && ng(W,m,28)==95201+i){
      let f1:i32=xk_find_fact(W,95001+i,21,95101+i);
      let f2:i32=xk_find_fact(W,95101+i,21,95201+i);
      if(f1>=0 && f2>=0 && xk_has_t1(W,m,f1)==1 && xk_has_t1(W,m,f2)==1){c=c+1;}
      else { emit("CHAINMAP_NODEP "); e64(i); emit("\n"); }
    } else { emit("CHAINMAP_MISS "); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("CHAINMAP_OK "); e64(c); emit("/6\n");
  if(c==6){return 1;} return 0;
}
// C-R2: kind discriminator via t2_sig.
fn xk_oracle_c2(W:[]u8)i32 {
  let okc:i32=0; let okr:i32=0; let i:i32=0;
  while(i<6){
    let mc:i32=xk_find_map(W,95001+i,43);
    if(mc>=0 && xk_count103(W,ng(W,mc,20))>=2){okc=okc+1;}
    let mr:i32=xk_find_map(W,95001+i,40);
    if(mr>=0 && xk_count103(W,ng(W,mr,20))==0){okr=okr+1;}
    i=i+1;
  }
  emit("SIG_COUNT_OK "); e64(okc); emit("/6 SIG_REBIND_OK "); e64(okr); emit("/6\n");
  if(okc==6 && okr==6){return 1;} return 0;
}
// C-R4: FACTSTABLE 18/18 phase-A facts live.
fn xk_oracle_c4(W:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<6){
    let f1:i32=xk_find_fact(W,95001+i,21,95101+i);
    let f2:i32=xk_find_fact(W,95101+i,21,95201+i);
    let f3:i32=xk_find_fact(W,95201+i,21,95301+i);
    if(f1>=0 && is_superseded(W,f1)==0){c=c+1;}
    if(f2>=0 && is_superseded(W,f2)==0){c=c+1;}
    if(f3>=0 && is_superseded(W,f3)==0){c=c+1;}
    i=i+1;
  }
  emit("FACTSTABLE "); e64(c); emit("/18\n");
  if(c==18){return 1;} return 0;
}
fn xk_capacity_guard(W:[]u8)i32 {
  let nn:i32=xk_alive_nodes(W);
  let ee:i32=xk_count_edges_all(W);
  emit("CAPGUARD nodes="); e64(nn); emit(" edges="); e64(ee); emit("\n");
  if(nn>=900 || ee>=3500){ emit("CAP_GUARD_TRIP\n"); return 1; }
  emit("CAP_GUARD_OK\n");
  return 0;
}
// ============ full battery: 99 events (frozen, PREREG_C section 3) ============
fn xk_main()i32 {
  emit("MODE XK-FULL\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("PHASE CAPABILITY\n");
  let i:i32=0;
  while(i<6){
    xk_event(W,1,95001+i,21,95101+i);
    xk_event(W,1,95101+i,21,95201+i);
    xk_event(W,1,95201+i,21,95301+i);
    i=i+1;
  }
  i=0;
  while(i<6){ xk_cquery(W,95001+i); i=i+1; }
  xk_oracle_c0(W);
  emit("PHASE INT1\n");
  i=0;
  while(i<48){ xk_event(W,1,95501+i,870,95601+i); i=i+1; }
  emit("PHASE INT2\n");
  xk_event(W,1,95701,871,95702);
  xk_event(W,3,95701,871,95703);
  xk_event(W,1,95701,871,95703);
  emit("PHASE INT3\n");
  i=0;
  while(i<6){
    xk_event(W,1,95801+i,22,95811+i);
    xk_event(W,1,95811+i,22,95821+i);
    i=i+1;
  }
  emit("PHASE RETENTION\n");
  let rc:i32=0;
  i=0;
  while(i<6){
    let a:i32=xk_event(W,2,95001+i,43,-2);
    if(a==3){rc=rc+1;} else { emit("RETENTION_MISS "); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("RETENTION_OK "); e64(rc); emit("/6\n");
  emit("PHASE REBIND\n");
  i=0;
  while(i<6){ xk_event(W,2,95001+i,40,-2); i=i+1; }
  xk_oracle_c1(W);
  xk_oracle_c2(W);
  xk_oracle_c4(W);
  if(xk_capacity_guard(W)==1){ return 1; }
  emit("FNV "); e64(xk_fnv(W)); emit("\n");
  if(hg(W,52)==99){ emit("AUDIT_PASS\n"); }
  else { emit("AUDIT_FAIL count="); e64(hg(W,52)); emit(" want=99\n"); return 1; }
  return 0;
}
fn main()i32 { return xk_main(); }

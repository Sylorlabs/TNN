fn count103(W:[]u8, root:i32)i32 {
  let sig:[]u8=z_alloc(256);
  let c:i32=t2_sig(W,root,sig);
  let k:i32=0; let i:i32=0;
  while(i<c){ if(get32(sig,i*8)==103){k=k+1;} i=i+1; }
  return k;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,96001,21,96101); ev_teach(W,96101,21,96201); ev_teach(W,96201,21,96301);
  ev_query(W,96001,43,3,0);
  ev_query(W,96001,40,-2,1);
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20){
      emit("MAP s="); e64(ng(W,n,8)); emit(" r="); e64(ng(W,n,4));
      emit(" count103="); e64(count103(W,ng(W,n,20))); emit("\n");
    }
    n=n+1;
  }
  return 0;
}

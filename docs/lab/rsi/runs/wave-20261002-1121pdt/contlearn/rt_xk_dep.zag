// rt_xk_dep.zag -- RED-TEAM probe: verify CHAIN MAPs cite phase-A facts,
// NOT INT3 facts (95801/95811/95821).
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // minimal full battery
  ev_teach(W,95001,21,95101); ev_teach(W,95101,21,95201); ev_teach(W,95201,21,95301);
  ev_query(W,95001,43,3,0);
  ev_teach(W,95801,22,95811); ev_teach(W,95811,22,95821);
  ev_query(W,95001,40,-2,1);
  // find CHAIN MAP
  let m:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==95001 && ng(W,n,4)==40){m=n;}
    n=n+1;
  }
  emit("MAP "); e64(m); emit("\n");
  // check DEP targets
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1){
      let t:i32=eg(W,e,8);
      emit("DEP to node "); e64(t); emit(" ("); e64(ng(W,t,20)); emit(",");
      emit(" "); e64(ng(W,t,24)); emit(","); e64(ng(W,t,28)); emit(")\n");
    }
    e=e+1;
  }
  return 0;
}

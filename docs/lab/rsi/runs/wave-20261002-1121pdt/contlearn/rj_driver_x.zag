// rj_driver_x.zag -- history X (contradicted) driver for the refusal exercise.
// (wave-20261002-1121pdt, lane CONTLEARN, exercise a).
// Phase-2 implementation for frozen prereg PREREG_A.md (33 events).
//
// FIXTURE ONLY. This file defines 0 cognition functions (no learning,
// retrieval, inference, retention, eviction, planning, derivation, revision,
// ledger, refusal, or execution logic), 0 new node tags, 0 new edge types,
// 0 new opcodes, 0 modes, 0 bridges, 0 routers, 0 task-specific handlers,
// 0 semantic cases. It emits the frozen 33-event script, calls the frozen
// event API (ev_teach/ev_query/ev_observe) plus the read-only ledger
// accessor (rj_ledger_get), runs read-only white-box censuses through the
// core's own accessors (ng/eg/activate/is_superseded), and prints results.
// No branching-on-opcode statements anywhere in this file. The driver never
// writes ledger nodes and never calls pf_propose/pf_find/alloc_node.
//
// Link: concatenated after either instrument core (rj_core_own.zag or
// rj_core_hard.zag). All names here are rj_ prefixed; the frozen source
// contains zero rj_ occurrences, so nothing collides and nothing is
// redefined. PHASE markers are driver-side prints; cognition receives only
// (kind, subject, relation, object) integer tuples through the choke points
// rj_event / rj_mquery. rj_mquery passes the frozen supervisor-disconnect
// parameters expected=-2, flags=1 (masked query, disclosed in the prereg);
// this carries no task identity and is not a task label. Kind 3 is
// ev_observe, the frozen counterexample protocol, disclosed in the prereg;
// it carries no task identity either.

// ============ small fixture helpers ============
fn rj_fnv(W:[]u8)i32 {
  let h:i32=-2128831035;
  let i:i32=0;
  while(i<110656){ h=(h ^ (W[i] as i32))*16777619; i=i+1; }
  return h;
}
fn rj_alive_nodes(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn rj_count_edges_all(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
fn rj_find_map_subj_range(W:[]u8,lo:i32,hi:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)>=lo && ng(W,n,8)<=hi){c=c+1;}
    n=n+1;
  }
  return c;
}
// ============ cognition choke points (K1c audit) ============
fn rj_event(W:[]u8,kind:i32,s:i32,r:i32,o:i32)i32 {
  if(kind<1 || kind>3){ emit("AUDIT_FAIL kind="); e64(kind); emit("\n"); return -999; }
  emit("EV "); e64(kind); emit(" "); e64(s); emit(" "); e64(r); emit(" "); e64(o);
  hs(W,52,hg(W,52)+1);
  if(kind==1){ let q:i32=ev_teach(W,s,r,o); emit("\n"); return q; }
  if(kind==2){ let a:i32=ev_query(W,s,r,-2,1); emit(" ans="); e64(a); emit("\n"); return a; }
  let v:i32=ev_observe(W,s,r,o); emit(" rv="); e64(v); emit("\n"); return v;
}
// ============ frozen phases (exact tuples from prereg section 3a) ============
// CONTRADICT: 9 events. Two genuine contradictions on kind 850.
fn rj_contradict(W:[]u8)void {
  emit("PHASE CONTRADICT\n");
  let i:i32=0;
  while(i<6){ rj_event(W,1,94001+i,850,94101+i); i=i+1; }
  let rv1:i32=rj_event(W,3,94001,850,94901);
  let rv2:i32=rj_event(W,3,94001,851,94901);
  let rv3:i32=rj_event(W,3,94002,850,94902);
  let ok:i32=0;
  if(rv1==0 && rv2==1 && rv3==0){ok=1;}
  emit("RV_OK "); e64(ok); emit("/1\n");
  return;
}
// PROBES: 6 refusal-probe events on fresh subjects, kind 850.
fn rj_probes(W:[]u8)void {
  emit("PHASE PROBES\n");
  let i:i32=0;
  while(i<6){ rj_event(W,2,94201+i,850,0); i=i+1; }
  return;
}
// serving-node check: activate's node must be the content-expected live fact.
fn rj_serve_ok(W:[]u8,s:i32,r:i32,exp:i32,got:i32)i32 {
  if(got!=exp){return 0;}
  let n:i32=activate(W,s,r);
  if(n<2){return 0;}
  if(ng(W,n,36)!=1 || ng(W,n,0)!=1){return 0;}
  if(ng(W,n,20)!=s || ng(W,n,24)!=r || ng(W,n,28)!=exp){return 0;}
  if(is_superseded(W,n)==1){return 0;}
  return 1;
}
// ENGAGE: 18 events. Clean-kind chains; the trial must engage and serve.
fn rj_engage(W:[]u8)void {
  emit("PHASE ENGAGE\n");
  let i:i32=0;
  while(i<6){ rj_event(W,1,94301+i,851,94401+i); i=i+1; }
  i=0;
  while(i<6){ rj_event(W,1,94401+i,852,94501+i); i=i+1; }
  let c:i32=0; i=0;
  while(i<6){
    let a:i32=rj_event(W,2,94301+i,853,0);
    if(rj_serve_ok(W,94301+i,853,94501+i,a)==1){c=c+1;}
    else { emit("ENGAGE_MISS "); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("ENGAGE_OK "); e64(c); emit("/6\n");
  return;
}
// Capacity guard: VOID the run if the arena approaches its caps.
fn rj_capacity_guard(W:[]u8)i32 {
  let nn:i32=rj_alive_nodes(W);
  let ee:i32=rj_count_edges_all(W);
  emit("CAPGUARD nodes="); e64(nn); emit(" edges="); e64(ee); emit("\n");
  if(nn>=900 || ee>=3500){ emit("CAP_GUARD_TRIP\n"); return 1; }
  emit("CAP_GUARD_OK\n");
  return 0;
}
// ============ entry ============
fn rj_main()i32 {
  emit("MODE RJ-X\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rj_contradict(W);
  emit("LEDGER 850 count="); e64(rj_ledger_get(W,850)); emit("\n");
  emit("LEDGER 851 count="); e64(rj_ledger_get(W,851)); emit("\n");
  rj_probes(W);
  rj_engage(W);
  emit("NO850MAP "); e64(rj_find_map_subj_range(W,94201,94206)); emit("\n");
  if(rj_capacity_guard(W)==1){ return 1; }
  emit("FNV "); e64(rj_fnv(W)); emit("\n");
  if(hg(W,52)==33){ emit("AUDIT_PASS\n"); }
  else { emit("AUDIT_FAIL count="); e64(hg(W,52)); emit(" want=33\n"); return 1; }
  return 0;
}
fn main()i32 { return rj_main(); }

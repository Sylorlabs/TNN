// xk_driver_nophase.zag -- control battery (69 events) for the cross-kind rebind.
// Identical fixture to xk_driver_full.zag except CAPABILITY and RETENTION
// are elided: the rebind queries run without any phase-A structures, so
// they must miss (-2) with 0 MAPs. Frozen prereg PREREG_C.md section 3.
fn xk_fnv(W:[]u8)i32 {
  let h:i32=-2128831035;
  let i:i32=0;
  while(i<110656){ h=(h ^ (W[i] as i32))*16777619; i=i+1; }
  return h;
}
fn xk_alive_nodes(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn xk_count_edges_all(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
fn xk_event(W:[]u8,kind:i32,s:i32,r:i32,o:i32)i32 {
  if(kind<1 || kind>3){ emit("AUDIT_FAIL kind="); e64(kind); emit("\n"); return -999; }
  emit("EV "); e64(kind); emit(" "); e64(s); emit(" "); e64(r); emit(" "); e64(o);
  hs(W,52,hg(W,52)+1);
  if(kind==1){ let q:i32=ev_teach(W,s,r,o); emit("\n"); return q; }
  if(kind==2){ let a:i32=ev_query(W,s,r,o,1); emit(" ans="); e64(a); emit("\n"); return a; }
  let v:i32=ev_observe(W,s,r,o); emit(" rv="); e64(v); emit("\n"); return v;
}
// C-R3: 0 MAPs for (95001+i,40); all rebind answers -2.
fn xk_oracle_c3(W:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<6){
    let n:i32=2; let found:i32=0;
    while(n<1024){
      if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==95001+i && ng(W,n,4)==40){found=1;}
      n=n+1;
    }
    if(found==0){c=c+1;} else { emit("CONTROL_MAP_FOUND "); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("CONTROL_NOMAP "); e64(c); emit("/6\n");
  if(c==6){return 1;} return 0;
}
fn xk_capacity_guard(W:[]u8)i32 {
  let nn:i32=xk_alive_nodes(W);
  let ee:i32=xk_count_edges_all(W);
  emit("CAPGUARD nodes="); e64(nn); emit(" edges="); e64(ee); emit("\n");
  if(nn>=900 || ee>=3500){ emit("CAP_GUARD_TRIP\n"); return 1; }
  emit("CAP_GUARD_OK\n");
  return 0;
}
// ============ control battery: 69 events (frozen, PREREG_C section 3) ============
fn xk_main()i32 {
  emit("MODE XK-NOPHASE\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("PHASE INT1\n");
  let i:i32=0;
  while(i<48){ xk_event(W,1,95501+i,870,95601+i); i=i+1; }
  emit("PHASE INT2\n");
  xk_event(W,1,95701,871,95702);
  xk_event(W,3,95701,871,95703);
  xk_event(W,1,95701,871,95703);
  emit("PHASE INT3\n");
  i=0;
  while(i<6){
    xk_event(W,1,95801+i,22,95811+i);
    xk_event(W,1,95811+i,22,95821+i);
    i=i+1;
  }
  emit("PHASE REBIND\n");
  let mc:i32=0;
  i=0;
  while(i<6){
    let a:i32=xk_event(W,2,95001+i,40,-2);
    if(a==-2){mc=mc+1;} else { emit("CONTROL_ANS "); e64(i); emit("="); e64(a); emit("\n"); }
    i=i+1;
  }
  emit("CONTROL_MISS_OK "); e64(mc); emit("/6\n");
  xk_oracle_c3(W);
  if(xk_capacity_guard(W)==1){ return 1; }
  emit("FNV "); e64(xk_fnv(W)); emit("\n");
  if(hg(W,52)==69){ emit("AUDIT_PASS\n"); }
  else { emit("AUDIT_FAIL count="); e64(hg(W,52)); emit(" want=69\n"); return 1; }
  return 0;
}
fn main()i32 { return xk_main(); }

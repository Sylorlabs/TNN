// rt_neg_driver.zag -- RED-TEAM negation probe (not a verdict input).
// Only 2 UNCERTs for kind 850 ever accumulate; the scheduler must NOT fire.
fn main()i32 {
  emit("MODE RT-NEG\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  hs(W,52,1); ev_teach(W,98301,860,98311); sc_sched_scan(W,1);
  hs(W,52,2); ev_teach(W,98311,861,98321); sc_sched_scan(W,2);
  hs(W,52,3); ev_query(W,98301,850,-2,1); sc_sched_scan(W,3);
  hs(W,52,4); ev_query(W,98301,850,-2,1); sc_sched_scan(W,4);
  hs(W,52,5); ev_teach(W,99001,870,99101); sc_sched_scan(W,5);
  hs(W,52,6); ev_teach(W,99002,871,99102); sc_sched_scan(W,6);
  emit("RT-NEG-DONE\n");
  return 0;
}

// k3_driver.zag -- K3 no-regression driver for exercise (a).
// FIXTURE ONLY: calls the frozen core's own run_all() battery and returns
// its return code. 0 cognition functions, 0 structural writes.
// Link after any of: the frozen base core, rj_core_own.zag, rj_core_hard.zag.
fn main()i32 {
  emit("MODE K3\n");
  let rc:i32=run_all();
  emit("K3RC "); e64(rc); emit("\n");
  return rc;
}

// driver_adv.zag -- ADV-A adversarial battery driver for the frozen
// `satisfy` operation (bin_adv). Harness only, not cognition.
// Each test: fresh workspace, train components, gap noise, goal facts,
// goal query. Markers T-<name>-ANS and T-<name>-RESULT. Deterministic.

// ---- verification helpers (harness only, not cognition) ----
fn dv_count_maps(W:[]u8)i32 {
  let n:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn dv_newest_map_rel(W:[]u8,r:i32)i32 {
  let m:i32=1023;
  while(m>=2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){return m;}
    m=m-1;
  }
  return -1;
}
// structural relseq extraction (verification copy, mechanism-neutral)
fn dv_relseq(W:[]u8,m:i32,seq:[]u8,maxn:i32)i32 {
  let root:i32=ng(W,m,20);
  let cur:i32=root;
  let exp102:i32=1;
  let n:i32=0;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      cur=ng(W,cur,12);
      exp102=0;
    } else {
      if(tag!=101){return -1;}
      let fact:i32=-1;
      let e:i32=0;
      while(e<4096 && fact<0){
        if(eg(W,e,0)==cur && eg(W,e,4)==1){fact=eg(W,e,8);}
        e=e+1;
      }
      if(fact<0){return -1;}
      if(ng(W,fact,0)!=1 || ng(W,fact,36)!=1){return -1;}
      if(n>=maxn){return -1;}
      set32(seq,n*4,ng(W,fact,24));
      n=n+1;
      cur=seq_nx(W,cur);
      exp102=1;
    }
    steps=steps+1;
  }
  if(n==0){return -1;}
  return n;
}
// type-tt edges from `from`; returns count (targets in fbuf)
fn dv_edges_from(W:[]u8,from:i32,tt:i32,ebuf:[]u8,fbuf:[]u8)i32 {
  let n:i32=0;
  let e:i32=0;
  while(e<4096 && n<64){
    if(eg(W,e,0)==from && eg(W,e,4)==tt){
      set32(ebuf,n*4,e);
      set32(fbuf,n*4,eg(W,e,8));
      n=n+1;
    }
    e=e+1;
  }
  return n;
}
fn dv_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn dv_result(name:[]u8,pass:i32)void {
  emit("T-"); emit(name); emit("-RESULT=");
  if(pass==1){emit("PASS\n");} else {emit("FAIL\n");}
  return;
}
// compare extracted relseq of MAP m against exp[0..n)
fn dv_seq_match(W:[]u8,m:i32,exp:[]u8,n:i32)i32 {
  let seq:[]u8=z_alloc(48);
  let L:i32=dv_relseq(W,m,seq,12);
  if(L!=n){return 0;}
  let j:i32=0;
  while(j<n){
    if(get32(seq,j*4)!=get32(exp,j*4)){return 0;}
    j=j+1;
  }
  return 1;
}
// expected patterns
fn dv_pat_tpf(exp:[]u8)void {
  set32(exp,0,1); set32(exp,4,1); set32(exp,8,2); set32(exp,12,2);
  set32(exp,16,3); set32(exp,20,3); set32(exp,24,3); set32(exp,28,1);
  set32(exp,32,1); set32(exp,36,2); set32(exp,40,2);
  return;
}
fn dv_pat_1122(exp:[]u8)void {
  set32(exp,0,1); set32(exp,4,1); set32(exp,8,2); set32(exp,12,2);
  return;
}
fn dv_pat_11122(exp:[]u8)void {
  set32(exp,0,1); set32(exp,4,1); set32(exp,8,1); set32(exp,12,2);
  set32(exp,16,2);
  return;
}
fn dv_pat_123(exp:[]u8)void {
  set32(exp,0,1); set32(exp,4,2); set32(exp,8,3);
  return;
}
// shared component training: X=[1,1]@71, Y=[2,2]@72
fn dv_train_xy(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  emit("TRAIN x="); e64(x); emit(" y="); e64(y);
  emit(" maps="); e64(dv_count_maps(W)); emit("\n");
  return;
}
// shared component training: X=[1,1]@71, Y=[2,2]@72, W=[3,3,3]@73
fn dv_train_xyw(W:[]u8)void {
  dv_train_xy(W);
  ev_teach(W,31,3,32); ev_teach(W,32,3,33); ev_teach(W,33,3,34);
  let w:i32=ev_query(W,31,73,34,0);
  emit("TRAIN w="); e64(w); emit(" maps="); e64(dv_count_maps(W));
  emit("\n");
  return;
}
// 11-edge Z chain for TPF tests
fn dv_teach_z11(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107); ev_teach(W,107,3,108);
  ev_teach(W,108,1,109); ev_teach(W,109,1,110);
  ev_teach(W,110,2,111); ev_teach(W,111,2,112);
  return;
}
// ---- TPF-1: trial-path-free, 11-edge goal ----
fn t_tpf1(W:[]u8)void {
  emit("=== T-TPF1 ===\n");
  dv_train_xyw(W);
  dv_gap(W);
  dv_teach_z11(W);
  let z:i32=ev_query(W,101,70,112,0);
  emit("T-TPF1-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==112){
    let mz:i32=dv_newest_map_rel(W,70);
    if(mz>=0){
      let exp:[]u8=z_alloc(44);
      dv_pat_tpf(exp);
      if(dv_seq_match(W,mz,exp,11)==1){
        if(ng(W,mz,28)==112){pass=1;}
      }
      emit("TPF1 mz="); e64(mz); emit(" term="); e64(ng(W,mz,28));
      emit("\n");
    }
  }
  dv_result("TPF1",pass);
  return;
}
// ---- TPF-2: TPF-1 + 40 distractor facts (D4 pattern) ----
fn t_tpf2(W:[]u8)void {
  emit("=== T-TPF2 ===\n");
  dv_train_xyw(W);
  dv_gap(W);
  dv_teach_z11(W);
  let i:i32=0;
  while(i<40){
    ev_teach(W,101+(i%8),1+(i%3),9100+i);
    i=i+1;
  }
  let z:i32=ev_query(W,101,70,112,0);
  emit("T-TPF2-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==112){
    let mz:i32=dv_newest_map_rel(W,70);
    if(mz>=0){
      let exp:[]u8=z_alloc(44);
      dv_pat_tpf(exp);
      if(dv_seq_match(W,mz,exp,11)==1){
        if(ng(W,mz,28)==112){pass=1;}
      }
      emit("TPF2 mz="); e64(mz); emit(" term="); e64(ng(W,mz,28));
      emit("\n");
    }
  }
  dv_result("TPF2",pass);
  return;
}
// ---- TPF-3: TPF-1 world, unsupervised ----
fn t_tpf3(W:[]u8)void {
  emit("=== T-TPF3 ===\n");
  dv_train_xyw(W);
  dv_gap(W);
  dv_teach_z11(W);
  let z:i32=ev_query(W,101,70,-1,0);
  emit("T-TPF3-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  let mz:i32=dv_newest_map_rel(W,70);
  if(mz>=0){
    let exp:[]u8=z_alloc(44);
    dv_pat_tpf(exp);
    if(dv_seq_match(W,mz,exp,11)==1){
      if(ng(W,mz,28)==112){pass=1;}
    }
    emit("TPF3 mz="); e64(mz); emit(" term="); e64(ng(W,mz,28));
    emit("\n");
  }
  dv_result("TPF3",pass);
  return;
}
// ---- B1: deep distractor (9-edge rel-2 chain, taught first) ----
fn t_b1(W:[]u8)void {
  emit("=== T-B1 ===\n");
  dv_train_xy(W);
  dv_gap(W);
  ev_teach(W,103,2,904);
  ev_teach(W,904,2,906); ev_teach(W,906,2,908); ev_teach(W,908,2,910);
  ev_teach(W,910,2,912); ev_teach(W,912,2,914); ev_teach(W,914,2,916);
  ev_teach(W,916,2,918); ev_teach(W,918,2,920);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-B1-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==105){
    let mz:i32=dv_newest_map_rel(W,70);
    if(mz>=0){
      let exp:[]u8=z_alloc(16);
      dv_pat_1122(exp);
      if(dv_seq_match(W,mz,exp,4)==1){pass=1;}
    }
  }
  dv_result("B1",pass);
  return;
}
// ---- B2: cycle 101-1->102-1->103-1->101, correct exit via rel 2 ----
fn t_b2(W:[]u8)void {
  emit("=== T-B2 ===\n");
  dv_train_xy(W);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,101);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-B2-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==105){
    let mz:i32=dv_newest_map_rel(W,70);
    if(mz>=0){
      let exp:[]u8=z_alloc(16);
      dv_pat_1122(exp);
      if(dv_seq_match(W,mz,exp,4)==1){pass=1;}
    }
  }
  dv_result("B2",pass);
  return;
}
// shared B3 world: X=[1,1,1]@71, Y=[2,2]@72, distractor taught first
fn dv_train_b3(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let x:i32=ev_query(W,11,71,14,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  emit("TRAIN x="); e64(x); emit(" y="); e64(y);
  emit(" maps="); e64(dv_count_maps(W)); emit("\n");
  dv_gap(W);
  ev_teach(W,102,1,912); ev_teach(W,912,1,913); ev_teach(W,913,1,914);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,104,2,105); ev_teach(W,105,2,106);
  return;
}
// ---- B3S: greedy trap, supervised (backtracking must recover) ----
fn t_b3s(W:[]u8)void {
  emit("=== T-B3S ===\n");
  dv_train_b3(W);
  let z:i32=ev_query(W,101,70,106,0);
  emit("T-B3S-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==106){
    let mz:i32=dv_newest_map_rel(W,70);
    if(mz>=0){
      let exp:[]u8=z_alloc(20);
      dv_pat_11122(exp);
      if(dv_seq_match(W,mz,exp,5)==1){
        if(ng(W,mz,28)==106){pass=1;}
      }
    }
  }
  dv_result("B3S",pass);
  return;
}
// ---- B3U: greedy trap, unsupervised (predicted FAIL: terminal 914) ----
fn t_b3u(W:[]u8)void {
  emit("=== T-B3U ===\n");
  dv_train_b3(W);
  let z:i32=ev_query(W,101,70,-1,0);
  emit("T-B3U-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  let mz:i32=dv_newest_map_rel(W,70);
  if(mz>=0){
    let exp:[]u8=z_alloc(20);
    dv_pat_11122(exp);
    if(dv_seq_match(W,mz,exp,5)==1){
      if(ng(W,mz,28)==106){pass=1;}
    }
    emit("B3U mz="); e64(mz); emit(" term="); e64(ng(W,mz,28));
    emit("\n");
  }
  dv_result("B3U",pass);
  return;
}
// ---- B4: trial-leak attribution control (rel 3 uncovered) ----
fn t_b4(W:[]u8)void {
  emit("=== T-B4 ===\n");
  dv_train_xy(W);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,3,104); ev_teach(W,104,2,105);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-B4-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==105){
    let mz:i32=dv_newest_map_rel(W,70);
    if(mz>=0){
      let ebuf:[]u8=z_alloc(256);
      let fbuf:[]u8=z_alloc(256);
      let n14:i32=dv_edges_from(W,mz,14,ebuf,fbuf);
      emit("B4 mz="); e64(mz); emit(" type14edges="); e64(n14);
      emit("\n");
      if(n14==0){pass=1;}
    }
  }
  dv_result("B4",pass);
  return;
}
// ---- B4U: trial-leak world, unsupervised (informational) ----
fn t_b4u(W:[]u8)void {
  emit("=== T-B4U ===\n");
  dv_train_xy(W);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,3,104); ev_teach(W,104,2,105);
  let z:i32=ev_query(W,101,70,-1,0);
  emit("T-B4U-ANS="); e64(z); emit("\n");
  let mz:i32=dv_newest_map_rel(W,70);
  if(mz>=0){
    let seq:[]u8=z_alloc(48);
    let L:i32=dv_relseq(W,mz,seq,12);
    emit("B4U mz="); e64(mz); emit(" term="); e64(ng(W,mz,28));
    emit(" L="); e64(L); emit("\n");
  }
  emit("T-B4U-RESULT=INFO\n");
  return;
}
// ---- B5: no facts at all (hallucination check) ----
fn t_b5(W:[]u8)void {
  emit("=== T-B5 ===\n");
  let z:i32=ev_query(W,999,70,105,0);
  emit("T-B5-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==-2){pass=1;}
  dv_result("B5",pass);
  return;
}
// ---- B6: 0521 ADV-A verbatim rerun ----
fn t_b6(W:[]u8)void {
  emit("=== T-B6 ===\n");
  dv_train_xy(W);
  dv_gap(W);
  ev_teach(W,103,2,904);
  ev_teach(W,904,2,905);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-B6-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==105){
    let mz:i32=dv_newest_map_rel(W,70);
    if(mz>=0){
      let exp:[]u8=z_alloc(16);
      dv_pat_1122(exp);
      if(dv_seq_match(W,mz,exp,4)==1){pass=1;}
    }
  }
  dv_result("B6",pass);
  return;
}
// ---- B7: 40 eight-edge distractor chains (taught first) ----
fn t_b7(W:[]u8)void {
  emit("=== T-B7 ===\n");
  dv_train_xy(W);
  dv_gap(W);
  let i:i32=0;
  while(i<40){
    ev_teach(W,103,2,4000+10*i);
    let j:i32=0;
    while(j<7){
      ev_teach(W,4000+10*i+j,2,4000+10*i+j+1);
      j=j+1;
    }
    i=i+1;
  }
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-B7-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==105){
    let mz:i32=dv_newest_map_rel(W,70);
    if(mz>=0){
      let exp:[]u8=z_alloc(16);
      dv_pat_1122(exp);
      if(dv_seq_match(W,mz,exp,4)==1){pass=1;}
    }
  }
  dv_result("B7",pass);
  return;
}
// shared B8 world: X=[1,1,1,1]@71, Y=[2,2]@72, overshoot distractor first
fn dv_train_b8(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  ev_teach(W,13,1,14); ev_teach(W,14,1,15);
  let x:i32=ev_query(W,11,71,15,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  emit("TRAIN x="); e64(x); emit(" y="); e64(y);
  emit(" maps="); e64(dv_count_maps(W)); emit("\n");
  dv_gap(W);
  ev_teach(W,103,1,912); ev_teach(W,912,1,913); ev_teach(W,913,1,914);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  return;
}
// ---- B8: longest-prefix overshoot recovery ----
fn t_b8(W:[]u8)void {
  emit("=== T-B8 ===\n");
  dv_train_b8(W);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-B8-ANS="); e64(z); emit("\n");

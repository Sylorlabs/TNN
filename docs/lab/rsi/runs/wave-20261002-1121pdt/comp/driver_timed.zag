      let exp:[]u8=z_alloc(16);
      dv_pat_1122(exp);
      if(dv_seq_match(W,mz,exp,4)==1){pass=1;}
    }
  }
  dv_result("B8",pass);
  return;
}
// shared PM-1 world: X=[1,1]@71, Y=[2,2]@72, Yb=[2,2]@74
fn dv_train_pm1(W:[]u8)void {
  dv_train_xy(W);
  ev_teach(W,24,2,25); ev_teach(W,25,2,26);
  let yb:i32=ev_query(W,24,74,26,0);
  emit("TRAIN yb="); e64(yb); emit(" maps="); e64(dv_count_maps(W));
  emit("\n");
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,103,2,204); ev_teach(W,204,2,205);
  return;
}
// ---- PM-1a: two valid completions, expected=105 ----

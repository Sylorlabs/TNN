// shared PF-1 components: A=[1]@71, B=[2]@72, C=[3]@73
fn dv_train_pf1(W:[]u8)void {
  ev_teach(W,11,1,12);
  let a:i32=ev_query(W,11,71,12,0);
  ev_teach(W,21,2,22);
  let b:i32=ev_query(W,21,72,22,0);
  ev_teach(W,31,3,32);
  let c:i32=ev_query(W,31,73,32,0);
  emit("TRAIN a="); e64(a); emit(" b="); e64(b); emit(" c="); e64(c);
  emit(" maps="); e64(dv_count_maps(W)); emit("\n");
  dv_gap(W);
  return;
}
// ---- PF-1a: diamond DAG, first branch correct ----
fn t_pf1a(W:[]u8)void {
  emit("=== T-PF1A ===\n");
  dv_train_pf1(W);
  ev_teach(W,101,1,102); ev_teach(W,101,1,103);
  ev_teach(W,102,2,104); ev_teach(W,103,2,104);
  ev_teach(W,104,3,105);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-PF1A-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==105){
    let mz:i32=dv_newest_map_rel(W,70);
    if(mz>=0){
      let exp:[]u8=z_alloc(12);
      dv_pat_123(exp);
      if(dv_seq_match(W,mz,exp,3)==1){
        if(ng(W,mz,28)==105){pass=1;}
      }
    }
  }
  dv_result("PF1A",pass);
  return;
}
// ---- PF-1b: diamond DAG, first branch dead (taught first) ----
fn t_pf1b(W:[]u8)void {
  emit("=== T-PF1B ===\n");
  dv_train_pf1(W);
  ev_teach(W,101,1,102); ev_teach(W,101,1,103);
  ev_teach(W,102,2,106);
  ev_teach(W,103,2,104); ev_teach(W,104,3,105);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-PF1B-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==105){
    let mz:i32=dv_newest_map_rel(W,70);
    if(mz>=0){
      let exp:[]u8=z_alloc(12);
      dv_pat_123(exp);
      if(dv_seq_match(W,mz,exp,3)==1){
        if(ng(W,mz,28)==105){pass=1;}
      }
    }
  }
  dv_result("PF1B",pass);
  return;
}
// ---- PF-1c: diamond trap, unsupervised (informational) ----
fn t_pf1c(W:[]u8)void {
  emit("=== T-PF1C ===\n");
  dv_train_pf1(W);
  ev_teach(W,101,1,102); ev_teach(W,101,1,103);
  ev_teach(W,102,2,106);
  ev_teach(W,103,2,104); ev_teach(W,104,3,105);
  let z:i32=ev_query(W,101,70,-1,0);
  emit("T-PF1C-ANS="); e64(z); emit("\n");
  let mz:i32=dv_newest_map_rel(W,70);
  if(mz>=0){
    emit("PF1C mz="); e64(mz); emit(" term="); e64(ng(W,mz,28));
    emit("\n");
  }
  emit("T-PF1C-RESULT=INFO\n");
  return;
}
fn main()i32 {
  emit("TIMED-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W); t_b1(W);
  W=z_alloc(110656); tnn2_init(W); t_b2(W);
  W=z_alloc(110656); tnn2_init(W); t_b7(W);
  emit("TIMED-END\n");
  return 0;
}

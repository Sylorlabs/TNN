// L2X NA driver: NOADAPT control arms only (adapt_on=0 build).
// Assembled after cc_base.zag + l2x_patch_na.zag.
fn bx_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn bx_kill(W:[]u8,m:i32)void {
  ns(W,m,36,0);
  return;
}
fn bx_train_xa(W:[]u8)i32 {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let x3:i32=ev_query(W,11,71,14,0);
  emit("BX-XA3 ans="); e64(x3); emit("\n");
  let m3:i32=cb_newest_map(W);
  ev_teach(W,14,1,15); ev_teach(W,15,1,16);
  let x5:i32=ev_query(W,11,70,16,0);
  emit("BX-XA5 ans="); e64(x5); emit("\n");
  let m5:i32=cb_newest_map(W);
  bx_kill(W,m3);
  return m5;
}
fn bx_bfacts(W:[]u8)void {
  ev_teach(W,301,3,302); ev_teach(W,302,3,303); ev_teach(W,303,3,304);
  ev_teach(W,304,3,305); ev_teach(W,305,3,306);
  return;
}
fn bx_xb_noadapt(W:[]u8)void {
  emit("=== BX-XB-NOADAPT ===\n");
  bx_train_xa(W);
  bx_gap(W);
  bx_bfacts(W);
  let z:i32=ev_query(W,301,70,306,0);
  emit("BX-XB-NOADAPT-ANS="); e64(z); emit("\n");
  if(z==-2){emit("BX-XB-NOADAPT=PASS\n");} else {emit("BX-XB-NOADAPT=FAIL\n");}
  return;
}
fn bx_train_w(W:[]u8)i32 {
  ev_teach(W,51,1,52); ev_teach(W,52,1,53); ev_teach(W,53,1,54);
  let wr1:i32=ev_query(W,51,75,54,0);
  emit("BX-WR1 ans="); e64(wr1); emit("\n");
  let m_r1:i32=cb_newest_map(W);
  ev_teach(W,54,2,55); ev_teach(W,55,2,56); ev_teach(W,56,2,57);
  ev_teach(W,57,2,58);
  let wr2:i32=ev_query(W,54,76,58,0);
  emit("BX-WR2 ans="); e64(wr2); emit("\n");
  let m_r2:i32=cb_newest_map(W);
  let w:i32=ev_query(W,51,70,58,0);
  emit("BX-W ans="); e64(w); emit("\n");
  let m_w:i32=cb_newest_map(W);
  bx_kill(W,m_r1);
  bx_kill(W,m_r2);
  return m_w;
}
fn bx_ic_noadapt(W:[]u8)void {
  emit("=== BX-IC-NOADAPT ===\n");
  bx_train_w(W);
  bx_gap(W);
  let z:i32=ev_query(W,52,70,57,0);
  emit("BX-IC-NOADAPT-ANS="); e64(z); emit("\n");
  if(z==-2){emit("BX-IC-NOADAPT=PASS\n");} else {emit("BX-IC-NOADAPT=FAIL\n");}
  return;
}
fn main()i32 {
  let w0:[]u8=z_alloc(110656); tnn2_init(w0);
  bx_xb_noadapt(w0);
  let w1:[]u8=z_alloc(110656); tnn2_init(w1);
  bx_ic_noadapt(w1);
  emit("BX-NA-DONE\n");
  return 0;
}

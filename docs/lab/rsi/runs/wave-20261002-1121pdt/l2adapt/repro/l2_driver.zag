// L2 adaptive reuse battery driver.
// Assembled after cc_base.zag + l2_patch.zag. All symbols use the ad_ prefix
// to avoid clashes with base/patch.
// Arms: L1 regression, L2 extension (treat/ablx/ably/fresh/reuse/prov),
// TRUNCATE (treat/fresh), SPECIALIZE (treat/fresh).
// The NOADAPT arms live in l2_driver_na.zag (adapt_on=0 build).

// ---- helpers ----
fn ad_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn ad_has14(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==14 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
fn ad_kill(W:[]u8,m:i32)void {
  ns(W,m,36,0);
  return;
}
// Train X ([1,1,1]) and Y ([2,2,2]). out0=mapx, out1=mapy.
fn ad_train_xy(W:[]u8,out:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let x:i32=ev_query(W,11,71,14,0);
  emit("AD-X ans="); e64(x); emit("\n");
  set32(out,0,cb_newest_map(W));
  ev_teach(W,21,2,22); ev_teach(W,22,2,23); ev_teach(W,23,2,24);
  let y:i32=ev_query(W,21,72,24,0);
  emit("AD-Y ans="); e64(y); emit("\n");
  set32(out,4,cb_newest_map(W));
  return;
}
// Train X2 ([1,1,1,1]) and Y2 ([2,2,2,2]). out0=mapx2, out1=mapy2.
fn ad_train_x2y2(W:[]u8,out:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14); ev_teach(W,14,1,15);
  let x:i32=ev_query(W,11,71,15,0);
  emit("AD-X2 ans="); e64(x); emit("\n");
  set32(out,0,cb_newest_map(W));
  ev_teach(W,21,2,22); ev_teach(W,22,2,23); ev_teach(W,23,2,24); ev_teach(W,24,2,25);
  let y:i32=ev_query(W,21,72,25,0);
  emit("AD-Y2 ans="); e64(y); emit("\n");
  set32(out,4,cb_newest_map(W));
  return;
}

// ---- L1 regression (adaptation must not disturb exact reuse) ----
fn ad_l1_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,104,2,105); ev_teach(W,105,2,106); ev_teach(W,106,2,107);
  return;
}
fn ad_l1_treat(W:[]u8)void {
  emit("=== AD-L1-TREAT ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  ad_gap(W);
  ad_l1_zfacts(W);
  let z:i32=ev_query(W,101,70,107,0);
  emit("AD-L1-TREAT-ANS="); e64(z); emit("\n");
  if(z==107){emit("AD-L1-TREAT=PASS\n");} else {emit("AD-L1-TREAT=FAIL\n");}
  return;
}

// ---- L2 extension: X=[1,1,1] must cover FOUR r1 links ----
fn ad_l2_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,104,1,105);
  ev_teach(W,105,2,106); ev_teach(W,106,2,107); ev_teach(W,107,2,108);
  return;
}
fn ad_l2_treat(W:[]u8)void {
  emit("=== AD-L2-TREAT ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  ad_gap(W);
  ad_l2_zfacts(W);
  let z:i32=ev_query(W,101,70,108,0);
  emit("AD-L2-TREAT-ANS="); e64(z); emit("\n");
  if(z==108){emit("AD-L2-TREAT=PASS\n");} else {emit("AD-L2-TREAT=FAIL\n");}
  return;
}
fn ad_l2_ablx(W:[]u8)void {
  emit("=== AD-L2-ABL-X ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  ad_kill(W,get32(out,0));
  ad_gap(W);
  ad_l2_zfacts(W);
  let z:i32=ev_query(W,101,70,108,0);
  emit("AD-L2-ABL-X-ANS="); e64(z); emit("\n");
  if(z==-2){emit("AD-L2-ABL-X=PASS\n");} else {emit("AD-L2-ABL-X=FAIL\n");}
  return;
}
fn ad_l2_ably(W:[]u8)void {
  emit("=== AD-L2-ABL-Y ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  ad_kill(W,get32(out,4));
  ad_gap(W);
  ad_l2_zfacts(W);
  let z:i32=ev_query(W,101,70,108,0);
  emit("AD-L2-ABL-Y-ANS="); e64(z); emit("\n");
  if(z==-2){emit("AD-L2-ABL-Y=PASS\n");} else {emit("AD-L2-ABL-Y=FAIL\n");}
  return;
}
fn ad_l2_fresh(W:[]u8)void {
  emit("=== AD-L2-FRESH ===\n");
  ad_gap(W);
  ad_l2_zfacts(W);
  let z:i32=ev_query(W,101,70,108,0);
  emit("AD-L2-FRESH-ANS="); e64(z); emit("\n");
  if(z==-2){emit("AD-L2-FRESH=PASS\n");} else {emit("AD-L2-FRESH=FAIL\n");}
  return;
}
fn ad_l2_reuse(W:[]u8)void {
  emit("=== AD-L2-REUSE ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  ad_gap(W);
  ad_l2_zfacts(W);
  let z1:i32=ev_query(W,101,70,108,0);
  emit("AD-L2-REUSE first="); e64(z1); emit("\n");
  let z2:i32=ev_query(W,101,70,108,0);
  emit("AD-L2-REUSE-ANS="); e64(z2); emit("\n");
  if(z2==108){emit("AD-L2-REUSE=PASS\n");} else {emit("AD-L2-REUSE=FAIL\n");}
  return;
}
fn ad_l2_prov(W:[]u8)void {
  emit("=== AD-L2-PROV ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  ad_gap(W);
  ad_l2_zfacts(W);
  let z:i32=ev_query(W,101,70,108,0);
  let mapz:i32=cb_newest_map(W);
  emit("AD-L2-PROV z="); e64(z); emit(" mapz="); e64(mapz);
  emit(" mapx="); e64(mapx); emit(" mapy="); e64(mapy); emit("\n");
  let px:i32=ad_has14(W,mapz,mapx);
  let py:i32=ad_has14(W,mapz,mapy);
  emit("AD-L2-PROV link14-z-x="); e64(px); emit(" link14-z-y="); e64(py); emit("\n");
  if(z==108 && px==1 && py==1){emit("AD-L2-PROV=PASS\n");} else {emit("AD-L2-PROV=FAIL\n");}
  return;
}

// ---- TRUNCATE: X2=[1,1,1,1] must shorten to a plen-2 prefix ----
fn ad_tr_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,2,106); ev_teach(W,106,2,107);
  return;
}
fn ad_tr_treat(W:[]u8)void {
  emit("=== AD-TR-TREAT ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_x2y2(W,out);
  ad_gap(W);
  ad_tr_zfacts(W);
  let z:i32=ev_query(W,101,70,107,0);
  emit("AD-TR-TREAT-ANS="); e64(z); emit("\n");
  if(z==107){emit("AD-TR-TREAT=PASS\n");} else {emit("AD-TR-TREAT=FAIL\n");}
  return;
}
fn ad_tr_fresh(W:[]u8)void {
  emit("=== AD-TR-FRESH ===\n");
  ad_gap(W);
  ad_tr_zfacts(W);
  let z:i32=ev_query(W,101,70,107,0);
  emit("AD-TR-FRESH-ANS="); e64(z); emit("\n");
  if(z==-2){emit("AD-TR-FRESH=PASS\n");} else {emit("AD-TR-FRESH=FAIL\n");}
  return;
}

// ---- SPECIALIZE: distractor branch taught first; ambiguity triggers the
// nearest-object re-walk ----
fn ad_sp_zfacts(W:[]u8)void {
  ev_teach(W,101,1,5001); ev_teach(W,5001,1,5002); ev_teach(W,5002,1,5003);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,104,2,105); ev_teach(W,105,2,106); ev_teach(W,106,2,107);
  return;
}
fn ad_sp_treat(W:[]u8)void {
  emit("=== AD-SP-TREAT ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  ad_gap(W);
  ad_sp_zfacts(W);
  let z:i32=ev_query(W,101,70,107,0);
  emit("AD-SP-TREAT-ANS="); e64(z); emit("\n");
  if(z==107){emit("AD-SP-TREAT=PASS\n");} else {emit("AD-SP-TREAT=FAIL\n");}
  return;
}
fn ad_sp_fresh(W:[]u8)void {
  emit("=== AD-SP-FRESH ===\n");
  ad_gap(W);
  ad_sp_zfacts(W);
  let z:i32=ev_query(W,101,70,107,0);
  emit("AD-SP-FRESH-ANS="); e64(z); emit("\n");
  if(z==-2){emit("AD-SP-FRESH=PASS\n");} else {emit("AD-SP-FRESH=FAIL\n");}
  return;
}

fn main()i32 {
  let w0:[]u8=z_alloc(110656); tnn2_init(w0);
  ad_l1_treat(w0);
  let w1:[]u8=z_alloc(110656); tnn2_init(w1);
  ad_l2_treat(w1);
  let w2:[]u8=z_alloc(110656); tnn2_init(w2);
  ad_l2_ablx(w2);
  let w3:[]u8=z_alloc(110656); tnn2_init(w3);
  ad_l2_ably(w3);
  let w4:[]u8=z_alloc(110656); tnn2_init(w4);
  ad_l2_fresh(w4);
  let w5:[]u8=z_alloc(110656); tnn2_init(w5);
  ad_l2_reuse(w5);
  let w6:[]u8=z_alloc(110656); tnn2_init(w6);
  ad_l2_prov(w6);
  let w7:[]u8=z_alloc(110656); tnn2_init(w7);
  ad_tr_treat(w7);
  let w8:[]u8=z_alloc(110656); tnn2_init(w8);
  ad_tr_fresh(w8);
  let w9:[]u8=z_alloc(110656); tnn2_init(w9);
  ad_sp_treat(w9);
  let w10:[]u8=z_alloc(110656); tnn2_init(w10);
  ad_sp_fresh(w10);
  emit("AD-BATTERY-DONE\n");
  return 0;
}

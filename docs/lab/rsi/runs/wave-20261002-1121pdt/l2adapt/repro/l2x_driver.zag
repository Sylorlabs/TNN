// L2X battery driver: candidate B (cross-domain SUBSTITUTE) and
// candidate C (interface SUBSEQ). Assembled after cc_base.zag +
// l2x_patch.zag. All symbols use the bx_ prefix.
fn bx_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn bx_kill(W:[]u8,m:i32)void {
  ns(W,m,36,0);
  return;
}
// Train XA5 ([1,1,1,1,1]) via composition+EXTEND:
// 1. Train XA3 [1,1,1] via direct query (3 links, fallback OK).
// 2. Teach (14,1,15),(15,1,16).
// 3. Query (11,70,16): DFS uses XA3 (11->14) + EXTEND (14->15->16).
//    Promotes 5-link MAP_XA5. Kill XA3 after.
fn bx_train_xa(W:[]u8)i32 {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let x3:i32=ev_query(W,11,71,14,0);
  emit("BX-XA3 ans="); e64(x3); emit("\n");
  let m3:i32=cb_newest_map(W);
  ev_teach(W,14,1,15); ev_teach(W,15,1,16);
  let x5:i32=ev_query(W,11,70,16,0);
  emit("BX-XA5 ans="); e64(x5); emit("\n");
  let m5:i32=cb_newest_map(W);
  bx_kill(W,m3);
  return m5;
}
fn bx_bfacts(W:[]u8)void {
  ev_teach(W,301,3,302); ev_teach(W,302,3,303); ev_teach(W,303,3,304);
  ev_teach(W,304,3,305); ev_teach(W,305,3,306);
  return;
}
fn bx_xb_treat(W:[]u8)void {
  emit("=== BX-XB-TREAT ===\n");
  bx_train_xa(W);
  bx_gap(W);
  bx_bfacts(W);
  let z:i32=ev_query(W,301,70,306,0);
  emit("BX-XB-TREAT-ANS="); e64(z); emit("\n");
  if(z==306){emit("BX-XB-TREAT=PASS\n");} else {emit("BX-XB-TREAT=FAIL\n");}
  return;
}
fn bx_xb_fresh(W:[]u8)void {
  emit("=== BX-XB-FRESH ===\n");
  bx_gap(W);
  bx_bfacts(W);
  let z:i32=ev_query(W,301,70,306,0);
  emit("BX-XB-FRESH-ANS="); e64(z); emit("\n");
  if(z==-2){emit("BX-XB-FRESH=PASS\n");} else {emit("BX-XB-FRESH=FAIL\n");}
  return;
}
fn bx_xb_abl(W:[]u8)void {
  emit("=== BX-XB-ABL ===\n");
  let m:i32=bx_train_xa(W);
  bx_kill(W,m);
  bx_gap(W);
  bx_bfacts(W);
  let z:i32=ev_query(W,301,70,306,0);
  emit("BX-XB-ABL-ANS="); e64(z); emit("\n");
  if(z==-2){emit("BX-XB-ABL=PASS\n");} else {emit("BX-XB-ABL=FAIL\n");}
  return;
}
// B-L1REG: original L1 regression (relations 1,2), must stay 107.
fn bx_train_xy(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let x:i32=ev_query(W,11,71,14,0);
  emit("BX-X ans="); e64(x); emit("\n");
  ev_teach(W,21,2,22); ev_teach(W,22,2,23); ev_teach(W,23,2,24);
  let y:i32=ev_query(W,21,72,24,0);
  emit("BX-Y ans="); e64(y); emit("\n");
  return;
}
fn bx_l1reg(W:[]u8)void {
  emit("=== BX-L1REG ===\n");
  bx_train_xy(W);
  bx_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,104,2,105); ev_teach(W,105,2,106); ev_teach(W,106,2,107);
  let z:i32=ev_query(W,101,70,107,0);
  emit("BX-L1REG-ANS="); e64(z); emit("\n");
  if(z==107){emit("BX-L1REG=PASS\n");} else {emit("BX-L1REG=FAIL\n");}
  return;
}
// Train W ([1,1,1,2,2,2,2]) via composition:
// 1. Train W_r1 [1,1,1]: (51,1,52),(52,1,53),(53,1,54), query (51,75,54).
// 2. Train W_r2 [2,2,2,2]: (54,2,55),(55,2,56),(56,2,57),(57,2,58),
//    query (54,76,58).
// 3. Query (51,70,58): DFS composes W_r1 + W_r2 -> 7-link MAP_W.
//    Kill W_r1, W_r2 after.
fn bx_train_w(W:[]u8)i32 {
  ev_teach(W,51,1,52); ev_teach(W,52,1,53); ev_teach(W,53,1,54);
  let wr1:i32=ev_query(W,51,75,54,0);
  emit("BX-WR1 ans="); e64(wr1); emit("\n");
  let m_r1:i32=cb_newest_map(W);
  ev_teach(W,54,2,55); ev_teach(W,55,2,56); ev_teach(W,56,2,57);
  ev_teach(W,57,2,58);
  let wr2:i32=ev_query(W,54,76,58,0);
  emit("BX-WR2 ans="); e64(wr2); emit("\n");
  let m_r2:i32=cb_newest_map(W);
  let w:i32=ev_query(W,51,70,58,0);
  emit("BX-W ans="); e64(w); emit("\n");
  let m_w:i32=cb_newest_map(W);
  bx_kill(W,m_r1);
  bx_kill(W,m_r2);
  return m_w;
}
fn bx_ic_treat(W:[]u8)void {
  emit("=== BX-IC-TREAT ===\n");
  bx_train_w(W);
  bx_gap(W);
  let z:i32=ev_query(W,52,70,57,0);
  emit("BX-IC-TREAT-ANS="); e64(z); emit("\n");
  if(z==57){emit("BX-IC-TREAT=PASS\n");} else {emit("BX-IC-TREAT=FAIL\n");}
  return;
}
fn bx_ic_fresh(W:[]u8)void {
  emit("=== BX-IC-FRESH ===\n");
  bx_gap(W);
  let z:i32=ev_query(W,52,70,57,0);
  emit("BX-IC-FRESH-ANS="); e64(z); emit("\n");
  if(z==-2){emit("BX-IC-FRESH=PASS\n");} else {emit("BX-IC-FRESH=FAIL\n");}
  return;
}
fn bx_ic_abl(W:[]u8)void {
  emit("=== BX-IC-ABL ===\n");
  let m:i32=bx_train_w(W);
  bx_kill(W,m);
  bx_gap(W);
  let z:i32=ev_query(W,52,70,57,0);
  emit("BX-IC-ABL-ANS="); e64(z); emit("\n");
  if(z==-2){emit("BX-IC-ABL=PASS\n");} else {emit("BX-IC-ABL=FAIL\n");}
  return;
}
fn main()i32 {
  let w0:[]u8=z_alloc(110656); tnn2_init(w0);
  bx_xb_treat(w0);
  let w1:[]u8=z_alloc(110656); tnn2_init(w1);
  bx_xb_fresh(w1);
  let w2:[]u8=z_alloc(110656); tnn2_init(w2);
  bx_xb_abl(w2);
  let w3:[]u8=z_alloc(110656); tnn2_init(w3);
  bx_l1reg(w3);
  let w4:[]u8=z_alloc(110656); tnn2_init(w4);
  bx_ic_treat(w4);
  let w5:[]u8=z_alloc(110656); tnn2_init(w5);
  bx_ic_fresh(w5);
  let w6:[]u8=z_alloc(110656); tnn2_init(w6);
  bx_ic_abl(w6);
  emit("BX-BATTERY-DONE\n");
  return 0;
}

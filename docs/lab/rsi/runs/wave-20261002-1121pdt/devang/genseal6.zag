// genseal6.zag - Sealed family generators for DEVANG6.
// Implements EXACTLY the frozen specs in PREREG_DEVANG6.md section 8.
// Pure Zag. No Python.
//   genb: Family B-tripleprime (12 utterances, LCG seed 888021)
//   genc: Family C-tripleprime (40 train + 20 test, LCG seed 888022)
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n]; 
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn rng_next(st:[]u8)i32 {
  let s:i32=get32(st,0);
  s=s*1103515245+12345;
  s=s&0x7FFFFFFF;
  set32(st,0,s);
  return (s>>16)&0x7FFF;
}
fn rng_range(st:[]u8, n:i32)i32 {
  if(n<=1){return 0;}
  return rng_next(st)%n;
}
// ---------- Family B-tripleprime word tables (frozen) ----------
// Roots: 0=zib 1=zibok 2=vum 3=vumil 4=dax 5=odax 6=kex 7=kexal 8=nim 9=anim
fn nword6_len(wi:i32)i32 {
  if(wi==1){return 5;}
  if(wi==3){return 5;}
  if(wi==5){return 4;}
  if(wi==7){return 5;}
  if(wi==9){return 4;}
  return 3;
}
fn nword6_byte(wi:i32, pos:i32)i32 {
  if(wi==0){ if(pos==0){return 122;} if(pos==1){return 105;} return 98; } // zib
  if(wi==1){ if(pos==0){return 122;} if(pos==1){return 105;} if(pos==2){return 98;} if(pos==3){return 111;} return 107; } // zibok
  if(wi==2){ if(pos==0){return 118;} if(pos==1){return 117;} return 109; } // vum
  if(wi==3){ if(pos==0){return 118;} if(pos==1){return 117;} if(pos==2){return 109;} if(pos==3){return 105;} return 108; } // vumil
  if(wi==4){ if(pos==0){return 100;} if(pos==1){return 97;} return 120; } // dax
  if(wi==5){ if(pos==0){return 111;} if(pos==1){return 100;} if(pos==2){return 97;} return 120; } // odax
  if(wi==6){ if(pos==0){return 107;} if(pos==1){return 101;} return 120; } // kex
  if(wi==7){ if(pos==0){return 107;} if(pos==1){return 101;} if(pos==2){return 120;} if(pos==3){return 97;} return 108; } // kexal
  if(wi==8){ if(pos==0){return 110;} if(pos==1){return 105;} return 109; } // nim
  // wi==9 anim
  if(pos==0){return 97;} if(pos==1){return 110;} if(pos==2){return 105;} return 109;
}
// Known Family A words: 0=tak 1=red 2=blu 3=grn 4=bal 5=sph 6=cub 7=smal 8=big 9=not
fn kword2_len(ki:i32)i32 {
  if(ki==7){return 4;}
  return 3;
}
fn kword2_byte(ki:i32, pos:i32)i32 {
  if(ki==0){ if(pos==0){return 116;} if(pos==1){return 97;} return 107; } // tak
  if(ki==1){ if(pos==0){return 114;} if(pos==1){return 101;} return 100; } // red
  if(ki==2){ if(pos==0){return 98;} if(pos==1){return 108;} return 117; } // blu
  if(ki==3){ if(pos==0){return 103;} if(pos==1){return 114;} return 110; } // grn
  if(ki==4){ if(pos==0){return 98;} if(pos==1){return 97;} return 108; } // bal
  if(ki==5){ if(pos==0){return 115;} if(pos==1){return 112;} return 104; } // sph
  if(ki==6){ if(pos==0){return 99;} if(pos==1){return 117;} return 98; } // cub
  if(ki==7){ if(pos==0){return 115;} if(pos==1){return 109;} if(pos==2){return 97;} return 108; } // smal
  if(ki==8){ if(pos==0){return 98;} if(pos==1){return 105;} return 103; } // big
  // ki==9 not
  if(pos==0){return 110;} if(pos==1){return 111;} return 116;
}
fn append_nword6(buf:[]u8, pos:i32, wi:i32)i32 {
  let L:i32=nword6_len(wi);
  let k:i32=0;
  while(k<L){ buf[pos+k]=nword6_byte(wi,k) as u8; k=k+1; }
  return pos+L;
}
fn append_kword2(buf:[]u8, pos:i32, ki:i32)i32 {
  let L:i32=kword2_len(ki);
  let k:i32=0;
  while(k<L){ buf[pos+k]=kword2_byte(ki,k) as u8; k=k+1; }
  return pos+L;
}
// ---------- Family C-tripleprime word table (frozen) ----------
// wid: 0=quz(action) 1=noba(neg) 2=rak(red) 3=bilo(blu) 4=up(grn)
//      5=tov(ball) 6=meka(cube) 7=flib(tri) 8=zora(big) 9=pleto(smal) 10=zoraxu(biger)
fn cword6_len(wid:i32)i32 {
  if(wid==1){return 4;}
  if(wid==3){return 4;}
  if(wid==4){return 2;}
  if(wid==6){return 4;}
  if(wid==7){return 4;}
  if(wid==8){return 4;}
  if(wid==9){return 5;}
  if(wid==10){return 6;}
  return 3;
}
fn cword6_byte(wid:i32, pos:i32)i32 {
  if(wid==0){ if(pos==0){return 113;} if(pos==1){return 117;} return 122; } // quz
  if(wid==1){ if(pos==0){return 110;} if(pos==1){return 111;} if(pos==2){return 98;} return 97; } // noba
  if(wid==2){ if(pos==0){return 114;} if(pos==1){return 97;} return 107; } // rak
  if(wid==3){ if(pos==0){return 98;} if(pos==1){return 105;} if(pos==2){return 108;} return 111; } // bilo
  if(wid==4){ if(pos==0){return 117;} return 112; } // up
  if(wid==5){ if(pos==0){return 116;} if(pos==1){return 111;} return 118; } // tov
  if(wid==6){ if(pos==0){return 109;} if(pos==1){return 101;} if(pos==2){return 107;} return 97; } // meka
  if(wid==7){ if(pos==0){return 102;} if(pos==1){return 108;} if(pos==2){return 105;} return 98; } // flib
  if(wid==8){ if(pos==0){return 122;} if(pos==1){return 111;} if(pos==2){return 114;} return 97; } // zora
  if(wid==9){ if(pos==0){return 112;} if(pos==1){return 108;} if(pos==2){return 101;} if(pos==3){return 116;} return 111; } // pleto
  // wid==10 zoraxu
  if(pos==0){return 122;} if(pos==1){return 111;} if(pos==2){return 114;}
  if(pos==3){return 97;} if(pos==4){return 120;} return 117;
}
fn append_cword6(buf:[]u8, pos:i32, wid:i32)i32 {
  let L:i32=cword6_len(wid);
  let k:i32=0;
  while(k<L){ buf[pos+k]=cword6_byte(wid,k) as u8; k=k+1; }
  return pos+L;
}
// ---------- Scene generators (same distributions as Family A; verbatim) ----------
fn gen_direct(ep:[]u8, st:[]u8, color:i32, shape:i32, ncolor:i32, nshape:i32)void {
  let tgt:i32=rng_range(st,3);
  set32(ep,40,tgt);
  set32(ep,(tgt*3+0)*4,color);
  set32(ep,(tgt*3+1)*4,shape);
  set32(ep,(tgt*3+2)*4,rng_range(st,2));
  let o:i32=0;
  while(o<3){
    if(o!=tgt){
      set32(ep,(o*3+0)*4,rng_range(st,ncolor));
      set32(ep,(o*3+1)*4,rng_range(st,nshape));
      set32(ep,(o*3+2)*4,rng_range(st,2));
    }
    o=o+1;
  }
  return;
}
fn gen_neg(ep:[]u8, st:[]u8, color:i32, ncolor:i32, nshape:i32)void {
  let tgt:i32=rng_range(st,3);
  set32(ep,40,tgt);
  let dc:i32=rng_range(st,ncolor-1);
  if(dc>=color){ dc=dc+1; }
  set32(ep,(tgt*3+0)*4,dc);
  set32(ep,(tgt*3+1)*4,rng_range(st,nshape));
  set32(ep,(tgt*3+2)*4,rng_range(st,2));
  let o:i32=0;
  while(o<3){
    if(o!=tgt){
      set32(ep,(o*3+0)*4,color);
      set32(ep,(o*3+1)*4,rng_range(st,nshape));
      set32(ep,(o*3+2)*4,rng_range(st,2));
    }
    o=o+1;
  }
  return;
}
fn gen_rel(ep:[]u8, st:[]u8, shape:i32, ncolor:i32, nshape:i32)void {
  let i1:i32=rng_range(st,3);
  let i2:i32=rng_range(st,2);
  if(i2>=i1){ i2=i2+1; }
  let i3:i32=3-i1-i2;
  let tgt_is_i1:i32=rng_range(st,2);
  let tgt:i32=0; let oth:i32=0;
  if(tgt_is_i1==1){ tgt=i1; oth=i2; } else { tgt=i2; oth=i1; }
  set32(ep,40,tgt);
  set32(ep,(tgt*3+0)*4,rng_range(st,ncolor));
  set32(ep,(tgt*3+1)*4,shape);
  set32(ep,(tgt*3+2)*4,1);
  set32(ep,(oth*3+0)*4,rng_range(st,ncolor));
  set32(ep,(oth*3+1)*4,shape);
  set32(ep,(oth*3+2)*4,0);
  let ds:i32=rng_range(st,nshape-1);
  if(ds>=shape){ ds=ds+1; }
  set32(ep,(i3*3+0)*4,rng_range(st,ncolor));
  set32(ep,(i3*3+1)*4,ds);
  set32(ep,(i3*3+2)*4,rng_range(st,2));
  return;
}
fn gen_size(ep:[]u8, st:[]u8, size:i32, shape:i32, ncolor:i32, nshape:i32)void {
  let tgt:i32=rng_range(st,3);
  set32(ep,40,tgt);
  set32(ep,(tgt*3+0)*4,rng_range(st,ncolor));
  set32(ep,(tgt*3+1)*4,shape);
  set32(ep,(tgt*3+2)*4,size);
  let o:i32=0;
  while(o<3){
    if(o!=tgt){
      let s:i32=0; let z:i32=0; let ok:i32=0;
      while(ok==0){
        s=rng_range(st,nshape); z=rng_range(st,2);
        if(s!=shape || z!=size){ ok=1; }
      }
      set32(ep,(o*3+0)*4,rng_range(st,ncolor));
      set32(ep,(o*3+1)*4,s);
      set32(ep,(o*3+2)*4,z);
    }
    o=o+1;
  }
  return;
}
// Write one episode line: "<9 scene ints> <tgt> <utterance>\n"
fn write_ep_line(buf:[]u8, pos:i32, ep:[]u8, upos:i32, ulen:i32)i32 {
  let o:i32=0;
  while(o<9){
    let v:i32=get32(ep,o*4);
    let s:[]u8=i32s(v);
    let q:i32=0; while(q<s.len){ buf[pos]=s[q]; pos=pos+1; q=q+1; }
    buf[pos]=32; pos=pos+1;
    o=o+1;
  }
  let tg:[]u8=i32s(get32(ep,40));
  let q:i32=0; while(q<tg.len){ buf[pos]=tg[q]; pos=pos+1; q=q+1; }
  buf[pos]=32; pos=pos+1;
  q=0;
  while(q<ulen){ buf[pos]=ep[upos+q]; pos=pos+1; q=q+1; }
  buf[pos]=10; pos=pos+1;
  return pos;
}
// count utterances containing a word of length != 3 (fairness floor input)
fn count_non3(nslot:[]u8, k1slot:[]u8, k2slot:[]u8)i32 {
  let cnt:i32=0;
  let q:i32=0;
  while(q<12){
    let has:i32=0;
    if(nword6_len(get32(nslot,q*4))!=3){ has=1; }
    if(kword2_len(get32(k1slot,q*4))!=3){ has=1; }
    if(q<4){ if(kword2_len(get32(k2slot,q*4))!=3){ has=1; } }
    if(has==1){ cnt=cnt+1; }
    q=q+1;
  }
  return cnt;
}
// ---------- genb: Family B-tripleprime (frozen spec) ----------
fn mode_genb6()i32 {
  let st:[]u8=z_alloc(4);
  set32(st,0,888021);
  // slot patterns: ui 0..3: K+N+K; 4..7: K+N; 8..11: N+K
  let nslot:[]u8=z_alloc(12*4);
  let k1slot:[]u8=z_alloc(12*4);
  let k2slot:[]u8=z_alloc(12*4);
  let ui:i32=0;
  while(ui<12){
    if(ui<4){
      set32(k1slot,ui*4,rng_range(st,10));
      set32(nslot,ui*4,rng_range(st,10));
      set32(k2slot,ui*4,rng_range(st,10));
    } else if(ui<8){
      set32(k1slot,ui*4,rng_range(st,10));
      set32(nslot,ui*4,rng_range(st,10));
    } else {
      set32(nslot,ui*4,rng_range(st,10));
      set32(k1slot,ui*4,rng_range(st,10));
    }
    ui=ui+1;
  }
  // Enforce pair exercise: 4 distinct slots via partial Fisher-Yates.
  let perm:[]u8=z_alloc(12*4);
  ui=0;
  while(ui<12){ set32(perm,ui*4,ui); ui=ui+1; }
  ui=0;
  while(ui<4){
    let j:i32=rng_range(st,12-ui)+ui;
    let t:i32=get32(perm,ui*4);
    set32(perm,ui*4,get32(perm,j*4));
    set32(perm,j*4,t);
    ui=ui+1;
  }
  let pslot0:i32=get32(perm,0); let pslot1:i32=get32(perm,4);
  let pslot2:i32=get32(perm,8); let pslot3:i32=get32(perm,12);
  // prefix pair members into pslot0, pslot1
  let pp:i32=rng_range(st,3);
  let pm1:i32=0; let pm2:i32=1;
  if(pp==1){ pm1=2; pm2=3; }
  else if(pp==2){ pm1=6; pm2=7; }
  set32(nslot,pslot0*4,pm1);
  set32(nslot,pslot1*4,pm2);
  // suffix pair members into pslot2, pslot3
  let sp:i32=rng_range(st,3);
  let sm1:i32=4; let sm2:i32=5;
  if(sp==1){ sm1=8; sm2=9; }
  else if(sp==2){ sm1=3; sm2=7; }
  set32(nslot,pslot2*4,sm1);
  set32(nslot,pslot3*4,sm2);
  // FAIRNESS FLOOR (frozen spec): at least 4 utterances contain a word
  // of length != 3. Deterministic seeded forcing on non-pair slots.
  let cnt:i32=count_non3(nslot,k1slot,k2slot);
  let guard:i32=0;
  while(cnt<4 && guard<60){
    let s6:i32=rng_range(st,12);
    let ispair:i32=0;
    if(s6==pslot0){ ispair=1; }
    if(s6==pslot1){ ispair=1; }
    if(s6==pslot2){ ispair=1; }
    if(s6==pslot3){ ispair=1; }
    if(ispair==0 && nword6_len(get32(nslot,s6*4))==3){
      let pick:i32=rng_range(st,5);
      let nr:i32=1;
      if(pick==1){ nr=3; } else if(pick==2){ nr=5; } else if(pick==3){ nr=7; } else if(pick==4){ nr=9; }
      set32(nslot,s6*4,nr);
      cnt=count_non3(nslot,k1slot,k2slot);
    }
    guard=guard+1;
  }
  let out:[]u8=z_alloc(4096);
  let key:[]u8=z_alloc(4096);
  let op:i32=0; let kp:i32=0;
  ui=0;
  while(ui<12){
    let ub:[]u8=z_alloc(32);
    let bounds:[]u8=z_alloc(8*4);
    let nb:i32=0;
    let pos:i32=0;
    let k1:i32=get32(k1slot,ui*4);
    let ni:i32=get32(nslot,ui*4);
    if(ui<4){
      let k2:i32=get32(k2slot,ui*4);
      pos=append_kword2(ub,pos,k1); set32(bounds,nb*4,pos); nb=nb+1;
      pos=append_nword6(ub,pos,ni); set32(bounds,nb*4,pos); nb=nb+1;
      pos=append_kword2(ub,pos,k2);
    } else if(ui<8){
      pos=append_kword2(ub,pos,k1); set32(bounds,nb*4,pos); nb=nb+1;
      pos=append_nword6(ub,pos,ni);
    } else {
      pos=append_nword6(ub,pos,ni); set32(bounds,nb*4,pos); nb=nb+1;
      pos=append_kword2(ub,pos,k1);
    }
    let q:i32=0;
    while(q<pos){ out[op]=ub[q]; op=op+1; key[kp]=ub[q]; kp=kp+1; q=q+1; }
    out[op]=10; op=op+1;
    key[kp]=32; kp=kp+1; key[kp]=61; kp=kp+1; key[kp]=62; kp=kp+1; key[kp]=32; kp=kp+1;
    let b:i32=0;
    while(b<nb){
      if(b>0){ key[kp]=44; kp=kp+1; }
      let s:[]u8=i32s(get32(bounds,b*4));
      q=0; while(q<s.len){ key[kp]=s[q]; kp=kp+1; q=q+1; }
      b=b+1;
    }
    key[kp]=10; kp=kp+1;
    ui=ui+1;
  }
  _zag_write_file("sealed_b6.txt", out[0..op]);
  _zag_write_file("sealed_b6_key.txt", key[0..kp]);
  emit("genb6 done: 12 utterances\n");
  return 0;
}
// ---------- genc: Family C-tripleprime (frozen spec) ----------
fn mode_genc6()i32 {
  let st:[]u8=z_alloc(4);
  set32(st,0,888022);
  let out:[]u8=z_alloc(65536);
  let op:i32=0;
  // header "40 20\n"
  out[op]=52; op=op+1; out[op]=48; op=op+1; out[op]=32; op=op+1;
  out[op]=50; op=op+1; out[op]=48; op=op+1; out[op]=10; op=op+1;
  let ep:[]u8=z_alloc(80);
  // Train: 16 DIRECT, 10 NEG, 7 REL, 7 SIZE = 40.
  let dtr:[]u8=z_alloc(6*2*4);
  set32(dtr,0,0); set32(dtr,4,0); set32(dtr,8,0); set32(dtr,12,1);
  set32(dtr,16,1); set32(dtr,20,0); set32(dtr,24,1); set32(dtr,28,2);
  set32(dtr,32,2); set32(dtr,36,1); set32(dtr,40,2); set32(dtr,44,2);
  let ti:i32=0;
  while(ti<16){
    let ci:i32=ti%6;
    let c:i32=get32(dtr,ci*8); let s:i32=get32(dtr,ci*8+4);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_direct(ep,st,c,s,3,3);
    let pos:i32=48;
    pos=append_cword6(ep,pos,0);
    if(c==0){ pos=append_cword6(ep,pos,2); }
    else if(c==1){ pos=append_cword6(ep,pos,3); }
    else { pos=append_cword6(ep,pos,4); }
    if(s==0){ pos=append_cword6(ep,pos,5); }
    else if(s==1){ pos=append_cword6(ep,pos,6); }
    else { pos=append_cword6(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  ti=0;
  while(ti<10){
    let c:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_neg(ep,st,c,3,3);
    let pos:i32=48;
    pos=append_cword6(ep,pos,0); pos=append_cword6(ep,pos,1);
    if(c==0){ pos=append_cword6(ep,pos,2); }
    else if(c==1){ pos=append_cword6(ep,pos,3); }
    else { pos=append_cword6(ep,pos,4); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  ti=0;
  while(ti<7){
    let s:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_rel(ep,st,s,3,3);
    let pos:i32=48;
    pos=append_cword6(ep,pos,0); pos=append_cword6(ep,pos,10);
    if(s==0){ pos=append_cword6(ep,pos,5); }
    else if(s==1){ pos=append_cword6(ep,pos,6); }
    else { pos=append_cword6(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  ti=0;
  while(ti<7){
    let z:i32=rng_range(st,2); let s:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_size(ep,st,z,s,3,3);
    let pos:i32=48;
    pos=append_cword6(ep,pos,0);
    if(z==1){ pos=append_cword6(ep,pos,8); } else { pos=append_cword6(ep,pos,9); }
    if(s==0){ pos=append_cword6(ep,pos,5); }
    else if(s==1){ pos=append_cword6(ep,pos,6); }
    else { pos=append_cword6(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  // Test: 20 novel. DIRECT novel combos (disjoint from train): (0,2),(1,1),(2,0).
  let dte:[]u8=z_alloc(3*2*4);
  set32(dte,0,0); set32(dte,4,2); set32(dte,8,1); set32(dte,12,1);
  set32(dte,16,2); set32(dte,20,0);
  ti=0;
  while(ti<8){
    let ci:i32=ti%3;
    let c:i32=get32(dte,ci*8); let s:i32=get32(dte,ci*8+4);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_direct(ep,st,c,s,3,3);
    let pos:i32=48;
    pos=append_cword6(ep,pos,0);
    if(c==0){ pos=append_cword6(ep,pos,2); }
    else if(c==1){ pos=append_cword6(ep,pos,3); }
    else { pos=append_cword6(ep,pos,4); }
    if(s==0){ pos=append_cword6(ep,pos,5); }
    else if(s==1){ pos=append_cword6(ep,pos,6); }
    else { pos=append_cword6(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  ti=0;
  while(ti<4){
    let c:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_neg(ep,st,c,3,3);
    let pos:i32=48;
    pos=append_cword6(ep,pos,0); pos=append_cword6(ep,pos,1);
    if(c==0){ pos=append_cword6(ep,pos,2); }
    else if(c==1){ pos=append_cword6(ep,pos,3); }
    else { pos=append_cword6(ep,pos,4); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  ti=0;
  while(ti<4){
    let s:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    gen_rel(ep,st,s,3,3);
    let pos:i32=48;
    pos=append_cword6(ep,pos,0); pos=append_cword6(ep,pos,10);
    if(s==0){ pos=append_cword6(ep,pos,5); }
    else if(s==1){ pos=append_cword6(ep,pos,6); }
    else { pos=append_cword6(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  // SIZE test x4: zora/zoraxu prefix ambiguity stress.
  // Alternate zora (wid 8) and pleto (wid 9); shapes seeded.
  ti=0;
  while(ti<4){
    let z:i32=ti%2;
    let s:i32=rng_range(st,3);
    let k:i32=0; while(k<80){ep[k]=0;k=k+1;}
    let sz:i32=0; if(z==1){ sz=1; }
    gen_size(ep,st,sz,s,3,3);
    let pos:i32=48;
    pos=append_cword6(ep,pos,0);
    if(z==1){ pos=append_cword6(ep,pos,8); } else { pos=append_cword6(ep,pos,9); }
    if(s==0){ pos=append_cword6(ep,pos,5); }
    else if(s==1){ pos=append_cword6(ep,pos,6); }
    else { pos=append_cword6(ep,pos,7); }
    op=write_ep_line(out,op,ep,48,pos-48);
    ti=ti+1;
  }
  _zag_write_file("sealed_c6.txt", out[0..op]);
  emit("genc6 done: 40 train + 20 test\n");
  return 0;
}
fn main()i32 {
  if(_zag_argc()>=2){
    let ma:[]u8=_zag_arg(1);
    if(_zag_strcmp(ma,"genb")==1){ return mode_genb6(); }
    if(_zag_strcmp(ma,"genc")==1){ return mode_genc6(); }
    emit("USAGE: genseal6 [genb|genc]\n");
    return 2;
  }
  emit("USAGE: genseal6 [genb|genc]\n");
  return 2;
}

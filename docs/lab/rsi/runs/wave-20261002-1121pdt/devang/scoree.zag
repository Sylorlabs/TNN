// scoree.zag - Score segb output against a key file (exact line match).
// Prints only "E: x/y". Does not print utterances.
// Pure Zag. No Python.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn main()i32 {
  if(_zag_argc()<3){
    emit("USAGE: scoreb <output_file> <key_file>\n");
    return 2;
  }
  let fo:[]u8=_zag_read_file(_zag_arg(1));
  let fk:[]u8=_zag_read_file(_zag_arg(2));
  if(fo.len<0 || fk.len<0){ emit("ERR cannot read\n"); return 1; }
  // split into lines
  let ol:[]u8=z_alloc(64*8); let on:i32=0;
  let kl:[]u8=z_alloc(64*8); let kn:i32=0;
  let pos:i32=0;
  while(pos<fo.len){
    let eol:i32=pos;
    while(eol<fo.len && fo[eol]!=10){ eol=eol+1; }
    if(eol>pos){ set32(ol,on*8,pos); set32(ol,on*8+4,eol); on=on+1; }
    if(eol<fo.len){ pos=eol+1; } else { pos=eol; }
  }
  pos=0;
  while(pos<fk.len){
    let eol:i32=pos;
    while(eol<fk.len && fk[eol]!=10){ eol=eol+1; }
    if(eol>pos){ set32(kl,kn*8,pos); set32(kl,kn*8+4,eol); kn=kn+1; }
    if(eol<fk.len){ pos=eol+1; } else { pos=eol; }
  }
  let hit:i32=0; let tot:i32=0;
  let i:i32=0;
  while(i<on && i<kn){
    let os:i32=get32(ol,i*8); let oe:i32=get32(ol,i*8+4);
    let ks:i32=get32(kl,i*8); let ke:i32=get32(kl,i*8+4);
    let same:i32=1;
    if(oe-os!=ke-ks){ same=0; }
    else {
      let q:i32=0;
      while(q<oe-os){ if(fo[os+q]!=fk[ks+q]){ same=0; } q=q+1; }
    }
    if(same==1){ hit=hit+1; }
    tot=tot+1;
    i=i+1;
  }
  emit("E: ");
  emit(i32s(hit));
  emit("/");
  emit(i32s(tot));
  emit("\n");
  return 0;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

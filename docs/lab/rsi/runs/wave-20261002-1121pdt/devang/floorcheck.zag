// floorcheck.zag - Mechanical fairness-floor check for sealed B keys.
// Reads a key file (<utt> => <b1>,<b2>,...) and prints ONLY
// "FLOOR: x/12" (utterances containing a word of length != 3).
// Never prints utterances, boundaries, or keys. Pure Zag.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn main()i32 {
  if(_zag_argc()<2){ emit("USAGE: floorcheck <key_file>\n"); return 2; }
  let fk:[]u8=_zag_read_file(_zag_arg(1));
  if(fk.len<0){ emit("ERR cannot read\n"); return 1; }
  let kl:[]u8=z_alloc(64*8); let kn:i32=0;
  let pos:i32=0;
  while(pos<fk.len){
    let eol:i32=pos;
    while(eol<fk.len && fk[eol]!=10){ eol=eol+1; }
    if(eol>pos){ set32(kl,kn*8,pos); set32(kl,kn*8+4,eol); kn=kn+1; }
    if(eol<fk.len){ pos=eol+1; } else { pos=eol; }
  }
  let floor:i32=0;
  let i:i32=0;
  while(i<kn){
    let ks:i32=get32(kl,i*8); let ke:i32=get32(kl,i*8+4);
    // find "=> " then parse comma-separated boundary ints
    let bs:[]u8=z_alloc(8*4); let nb:i32=0;
    let q:i32=ks;
    while(q<ke-2 && !(fk[q]==61 && fk[q+1]==62)){ q=q+1; }
    q=q+3;
    let cur:i32=0; let have:i32=0;
    while(q<=ke){
      let ch:i32=10;
      if(q<ke){ ch=fk[q] as i32; }
      if(ch>=48 && ch<=57){ cur=cur*10+(ch-48); have=1; }
      else { if(have==1){ set32(bs,nb*4,cur); nb=nb+1; cur=0; have=0; } }
      q=q+1;
    }
    // utterance length = last char count: recompute from key line start
    // segment lengths: b1, b2-b1, ...; last segment len unknown from key
    // alone, so approximate total length via the "=> " prefix scan:
    // instead use: key line = "<utt> => ...", utt length = arrow_pos - ks - 1
    let arrow:i32=ks;
    while(arrow<ke-2 && !(fk[arrow]==61 && fk[arrow]==62)){ arrow=arrow+1; }
    let ulen:i32=arrow-ks-1;
    let prev:i32=0; let non3:i32=0;
    let b2:i32=0;
    while(b2<nb){
      let L:i32=get32(bs,b2*4)-prev;
      if(L!=3){ non3=1; }
      prev=get32(bs,b2*4);
      b2=b2+1;
    }
    let lastL:i32=ulen-prev;
    if(lastL!=3){ non3=1; }
    if(non3==1){ floor=floor+1; }
    i=i+1;
  }
  emit("FLOOR: ");
  emit(i32s(floor));
  emit("/12\n");
  return 0;
}

// deep_trial.zag - DEEP-TRIAL: compositional depth-2 P-DEP trial search.
//
// Trades-lane experiment for wave-20260930-1421pdt (PREREG_TRADES.md frozen).
// Replicates CAM-1 PROPOSE -> VERIFY semantics at depth-1 (baseline: the 6
// fixed templates COPY_A, DBL_A, ADD_AB, COPY_B, DBL_B, LITERAL) and extends
// the trial search to compositional depth-2 ADD trees over the frozen
// generic basis {ADD, EQ} with leaves {A, B, 0, 1}.
//
// Architecture notes (One-System Rule, PROTECTED CORE ISA ruling):
// - No new semantic case, no new body kind, no new core op.
// - Candidate trees are learner-side DATA evaluated only by ADD and EQ.
// - Constants are limited to 0 and 1 (no coefficient fitting).
// - Value-signature dedupe is pure EQ comparison of value vectors.
// - Deterministic: no randomness anywhere; exemplar generation is fixed.
//
// Pure Zag. Pinned compiler znc_linux_x86_64_abed8aa1.
// Compiler workaround: u8-backed cells with get32/set32; never
// `as *i32` plus slice construction inside functions.

// ---------- memory ----------

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn cell()[]u8 { return z_alloc(4); }
fn cget(c:[]u8)i32 { return get32(c,0); }
fn cset(c:[]u8, v:i32)void { set32(c,0,v); return; }
fn cinc(c:[]u8)void { set32(c,0,get32(c,0)+1); return; }

// integer mod/div by repeated subtraction (values are tiny; avoids % and /)
fn imod(x:i32, m:i32)i32 {
  let r:i32=x;
  while(r>=m){ r=r-m; }
  return r;
}
fn idiv(x:i32, d:i32)i32 {
  let q:i32=0; let r:i32=x;
  while(r>=d){ r=r-d; q=q+1; }
  return q;
}

// ---------- exemplar generation (deterministic) ----------

fn gen_a(i:i32)i32 { return imod(3*i+1, 13); }
fn gen_b(i:i32)i32 { return imod(5*i+2, 11); }

// family rule: 1=COPY 2=ADD 3=DBL 4=COMP1 5=COMP2 6=NEG-RANDOM 7=NEG-SPURIOUS
// kind: 0=construction (i 0..5), 1=holdback (i 6..9), 2=novel (i 10..14)
fn fam_z(fam:i32, kind:i32, j:i32, a:i32, b:i32)i32 {
  if(fam==1){ return a; }
  if(fam==2){ return a+b; }
  if(fam==3){ return a+a; }
  if(fam==4){ return a+a+b; }
  if(fam==5){ return a+b+1; }
  if(fam==6){
    // fixed table with no small ADD regularity
    if(kind==0){
      if(j==0){ return 7; } if(j==1){ return 19; } if(j==2){ return 3; }
      if(j==3){ return 29; } if(j==4){ return 11; } return 23;
    }
    if(j==0){ return 5; } if(j==1){ return 31; } if(j==2){ return 13; }
    return 17;
  }
  // fam 7: construction follows COMP1, holdback breaks it
  if(kind==0){ return a+a+b; }
  return a+b;
}

// fill construction (6), holdback (4), novel (5) triple arrays
fn fill_fam(fam:i32, ca:[]u8, cb:[]u8, cz:[]u8,
            ha:[]u8, hb:[]u8, hz:[]u8,
            na:[]u8, nb:[]u8, nz:[]u8)void {
  let j:i32=0;
  while(j<6){
    let a:i32=gen_a(j); let b:i32=gen_b(j);
    set32(ca,j*4,a); set32(cb,j*4,b); set32(cz,j*4,fam_z(fam,0,j,a,b));
    j=j+1;
  }
  j=0;
  while(j<4){
    let i:i32=6+j;
    let a:i32=gen_a(i); let b:i32=gen_b(i);
    set32(ha,j*4,a); set32(hb,j*4,b); set32(hz,j*4,fam_z(fam,1,j,a,b));
    j=j+1;
  }
  j=0;
  while(j<5){
    let i:i32=10+j;
    let a:i32=gen_a(i); let b:i32=gen_b(i);
    set32(na,j*4,a); set32(nb,j*4,b); set32(nz,j*4,fam_z(fam,2,j,a,b));
    j=j+1;
  }
  return;
}

// ---------- baseline depth-1 P-DEP (CAM-1 semantics) ----------
// templates: 0=COPY_A 1=DBL_A 2=ADD_AB 3=COPY_B 4=DBL_B 5=LITERAL

fn eval_base(t:i32, a:i32, b:i32, lit:i32)i32 {
  if(t==0){ return a; }
  if(t==1){ return a+a; }
  if(t==2){ return a+b; }
  if(t==3){ return b; }
  if(t==4){ return b+b; }
  return lit;
}

// returns promoted template id, or -1; trials counted in tc
fn search_base(ca:[]u8, cb:[]u8, cz:[]u8, ha:[]u8, hb:[]u8, hz:[]u8,
               tc:[]u8)i32 {
  let lit:i32=get32(cz,0);
  let t:i32=0;
  while(t<6){
    let ok:i32=1; let j:i32=0;
    while(j<6){
      cinc(tc);
      if(eval_base(t,get32(ca,j*4),get32(cb,j*4),lit)!=get32(cz,j*4)){ ok=0; j=6; }
      j=j+1;
    }
    if(ok==1){
      j=0;
      while(j<4){
        cinc(tc);
        if(eval_base(t,get32(ha,j*4),get32(hb,j*4),lit)!=get32(hz,j*4)){ ok=0; j=4; }
        j=j+1;
      }
    }
    if(ok==1){ return t; }
    t=t+1;
  }
  return -1;
}

fn apply_base(t:i32, na:[]u8, nb:[]u8, nz:[]u8, lit:i32)i32 {
  let acc:i32=0; let p:i32=0;
  while(p<5){
    if(eval_base(t,get32(na,p*4),get32(nb,p*4),lit)==get32(nz,p*4)){ acc=acc+1; }
    p=p+1;
  }
  return acc;
}

// ---------- deep depth-2 compositional search ----------
// candidate ids: 0=A, 1=B, 2..17=ADD(l1,l2) depth-1 (l in 0=A,1=B,2=C0,3=C1),
// 18..417=ADD(t1,t2) depth-2 (s in 0=A,1=B,2..17=depth-1,18=C0,19=C1)

fn leaf_val(l:i32, a:i32, b:i32)i32 {
  if(l==0){ return a; }
  if(l==1){ return b; }
  if(l==2){ return 0; }
  return 1;
}
fn sub_val(s:i32, a:i32, b:i32)i32 {
  if(s==0){ return a; }
  if(s==1){ return b; }
  if(s==18){ return 0; }
  if(s==19){ return 1; }
  let k:i32=s-2;
  return leaf_val(idiv(k,4),a,b)+leaf_val(imod(k,4),a,b);
}
fn eval_deep(id:i32, a:i32, b:i32)i32 {
  if(id==0){ return a; }
  if(id==1){ return b; }
  if(id<18){
    let k:i32=id-2;
    return leaf_val(idiv(k,4),a,b)+leaf_val(imod(k,4),a,b);
  }
  let k:i32=id-18;
  return sub_val(idiv(k,20),a,b)+sub_val(imod(k,20),a,b);
}
fn sub_adds(s:i32)i32 {
  if(s>=2){ if(s<=17){ return 1; } }
  return 0;
}
fn add_count(id:i32)i32 {
  if(id<2){ return 0; }
  if(id<18){ return 1; }
  let k:i32=id-18;
  return 1+sub_adds(idiv(k,20))+sub_adds(imod(k,20));
}

// value-signature dedupe over the 6 construction exemplars
fn sig_seen(sigs:[]u8, nsig:[]u8, tmp:[]u8)i32 {
  let n:i32=cget(nsig); let s:i32=0;
  while(s<n){
    let same:i32=1; let j:i32=0;
    while(j<6){
      if(get32(sigs,s*24+j*4)!=get32(tmp,j*4)){ same=0; j=6; }
      j=j+1;
    }
    if(same==1){ return 1; }
    s=s+1;
  }
  return 0;
}
fn sig_add(sigs:[]u8, nsig:[]u8, tmp:[]u8)void {
  let s:i32=cget(nsig);
  let j:i32=0;
  while(j<6){ set32(sigs,s*24+j*4,get32(tmp,j*4)); j=j+1; }
  cset(nsig,s+1);
  return;
}

// returns promoted candidate id, or -1; trials counted in tc
fn search_deep(ca:[]u8, cb:[]u8, cz:[]u8, ha:[]u8, hb:[]u8, hz:[]u8,
               tc:[]u8)i32 {
  let sigs:[]u8=z_alloc(512*24);
  let nsig:[]u8=cell();
  let tmp:[]u8=z_alloc(6*4);
  let id:i32=0;
  while(id<418){
    // evaluate on construction exemplars into tmp
    let j:i32=0;
    while(j<6){
      set32(tmp,j*4,eval_deep(id,get32(ca,j*4),get32(cb,j*4)));
      j=j+1;
    }
    if(sig_seen(sigs,nsig,tmp)==0){
      sig_add(sigs,nsig,tmp);
      let ok:i32=1; j=0;
      while(j<6){
        cinc(tc);
        if(get32(tmp,j*4)!=get32(cz,j*4)){ ok=0; j=6; }
        j=j+1;
      }
      if(ok==1){
        j=0;
        while(j<4){
          cinc(tc);
          if(eval_deep(id,get32(ha,j*4),get32(hb,j*4))!=get32(hz,j*4)){ ok=0; j=4; }
          j=j+1;
        }
      }
      if(ok==1){ return id; }
    }
    id=id+1;
  }
  return -1;
}

fn apply_deep(id:i32, na:[]u8, nb:[]u8, nz:[]u8)i32 {
  let acc:i32=0; let p:i32=0;
  while(p<5){
    if(eval_deep(id,get32(na,p*4),get32(nb,p*4))==get32(nz,p*4)){ acc=acc+1; }
    p=p+1;
  }
  return acc;
}

// ---------- driver ----------

fn fam_name(f:i32)[]u8 {
  if(f==1){ return "F1-COPY"; }
  if(f==2){ return "F2-ADD"; }
  if(f==3){ return "F3-DBL"; }
  if(f==4){ return "F4-COMP1"; }
  if(f==5){ return "F5-COMP2"; }
  if(f==6){ return "F6-NEGRAND"; }
  return "F7-NEGSPUR";
}

fn main()i32 {
  let ca:[]u8=z_alloc(16*4); let cb:[]u8=z_alloc(16*4); let cz:[]u8=z_alloc(16*4);
  let ha:[]u8=z_alloc(4*4); let hb:[]u8=z_alloc(4*4); let hz:[]u8=z_alloc(4*4);
  let na:[]u8=z_alloc(5*4); let nb:[]u8=z_alloc(5*4); let nz:[]u8=z_alloc(5*4);
  emit("=== DEEP-TRIAL wave-20260930-1421pdt trades ===\n");
  // fixed state bytes (harness buffers)
  let sbytes:i32=16*4*3+4*4*3+5*4*3+512*24+6*4+4*8;
  emit("state_bytes="); emit(i32s(sbytes)); emit("\n");
  let tot_bt:i32=0; let tot_dt:i32=0;
  let tot_bacc:i32=0; let tot_dacc:i32=0;
  let tot_bprom:i32=0; let tot_dprom:i32=0;
  let f:i32=1;
  while(f<=7){
    fill_fam(f,ca,cb,cz,ha,hb,hz,na,nb,nz);
    let btc:[]u8=cell(); let dtc:[]u8=cell();
    let bp:i32=search_base(ca,cb,cz,ha,hb,hz,btc);
    let dp:i32=search_deep(ca,cb,cz,ha,hb,hz,dtc);
    let bacc:i32=0; let dacc:i32=0;
    if(bp>=0){ bacc=apply_base(bp,na,nb,nz,get32(cz,0)); }
    if(dp>=0){ dacc=apply_deep(dp,na,nb,nz); }
    emit(fam_name(f));
    emit(" base_prom="); emit(i32s(bp));
    emit(" base_acc="); emit(i32s(bacc));
    emit(" base_trials="); emit(i32s(cget(btc)));
    emit(" deep_prom="); emit(i32s(dp));
    emit(" deep_acc="); emit(i32s(dacc));
    emit(" deep_trials="); emit(i32s(cget(dtc)));
    if(dp>=0){ emit(" deep_adds="); emit(i32s(add_count(dp))); }
    emit("\n");
    tot_bt=tot_bt+cget(btc); tot_dt=tot_dt+cget(dtc);
    tot_bacc=tot_bacc+bacc; tot_dacc=tot_dacc+dacc;
    if(bp>=0){ tot_bprom=tot_bprom+1; }
    if(dp>=0){ tot_dprom=tot_dprom+1; }
    f=f+1;
  }
  emit("TOTAL base_trials="); emit(i32s(tot_bt));
  emit(" deep_trials="); emit(i32s(tot_dt));
  emit(" base_prom="); emit(i32s(tot_bprom));
  emit(" deep_prom="); emit(i32s(tot_dprom));
  emit(" base_acc="); emit(i32s(tot_bacc));
  emit(" deep_acc="); emit(i32s(tot_dacc));
  emit("\n");
  return 0;
}

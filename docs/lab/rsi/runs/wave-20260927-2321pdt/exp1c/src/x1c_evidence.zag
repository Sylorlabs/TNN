// x1c_evidence.zag -- EXP1c evidence note generator, pure Zag.
// Reads evidence/run1.tsv and evidence/run2.tsv via _zag_read_file,
// verifies byte-identity, parses RUN/IDIAG rows, recomputes medians,
// K1-K3, K6, K7 in Zag. Reads iterations/iter3/calib1.txt and
// calib2.txt, verifies byte-identity, parses CALIB rows, and recomputes
// C1-C3 in Zag, including the CORRECTED C3 vector-distinctness check
// (per-variant (ticks, e_end) comparison, not medians). Emits the
// Markdown evidence note to stdout. Missing or malformed evidence prints
// CANNOT-CONFIRM. K4 is CANNOT-CONFIRM (no audit attempted); K5 is
// INCOMPLETE without an independent auditor (implementer cannot
// self-certify). No hand-written verdict blocks: every verdict line is
// computed from the parsed TSV values.

@import("x1c_out.zag")

// parse i32 from s[start..end] (end exclusive); handles optional '-'
fn p_i32(s:[]u8, start:i32, end:i32)i32 {
    let v:i32 = 0;
    let neg:i32 = 0;
    let i:i32 = start;
    if (i < end && s[i] == 45) { neg = 1; i = i + 1; }
    while (i < end) {
        let c:i32 = s[i] as i32;
        if (c >= 48 && c <= 57) { v = v*10 + (c - 48); }
        i = i + 1;
    }
    if (neg == 1) { v = 0 - v; }
    return v;
}

// find next tab or newline from pos; returns index
fn f_tab(s:[]u8, pos:i32, len:i32)i32 {
    let i:i32 = pos;
    while (i < len && s[i] != 9 && s[i] != 10) { i = i + 1; }
    return i;
}

fn med12e(v:[]i32, base:i32)i32 {
    let i:i32 = 1;
    while (i < 12) {
        let x:i32 = v[base+i];
        let j:i32 = i - 1;
        while (j >= 0 && v[base+j] > x) {
            v[base+j+1] = v[base+j];
            j = j - 1;
        }
        v[base+j+1] = x;
        i = i+1;
    }
    return (v[base+5] + v[base+6]) / 2;
}

fn main()i32 {
    let mu:*u8 = _zag_malloc(1048576);
    let u8a:[]u8 = mu[0..1048576];
    let b:XBuf = xb_new(u8a, 0, 1048576);
    // 1. Read both run files.
    let d1:[]u8 = _zag_read_file("evidence/run1.tsv");
    let d2:[]u8 = _zag_read_file("evidence/run2.tsv");
    if (d1.len == 0 || d2.len == 0) {
        let q:i32 = xb_str(&b, "CANNOT-CONFIRM: missing run file");
        q = xb_nl(&b);
        return 1;
    }
    // 2. Verify byte-identity.
    if (d1.len != d2.len) {
        let q:i32 = xb_str(&b, "CANNOT-CONFIRM: run files differ in length");
        q = xb_nl(&b);
        return 1;
    }
    let i:i32 = 0;
    while (i < d1.len) {
        if (d1[i] != d2[i]) {
            let q:i32 = xb_str(&b, "CANNOT-CONFIRM: run files differ at byte ");
            q = xb_i32(&b, i);
            q = xb_nl(&b);
            return 1;
        }
        i = i + 1;
    }
    // 3. Read both calibration files, verify byte-identity.
    let c1:[]u8 = _zag_read_file("iterations/iter3/calib1.txt");
    let c2:[]u8 = _zag_read_file("iterations/iter3/calib2.txt");
    if (c1.len == 0 || c2.len == 0) {
        let q:i32 = xb_str(&b, "CANNOT-CONFIRM: missing calibration file");
        q = xb_nl(&b);
        return 1;
    }
    if (c1.len != c2.len) {
        let q:i32 = xb_str(&b, "CANNOT-CONFIRM: calibration files differ in length");
        q = xb_nl(&b);
        return 1;
    }
    i = 0;
    while (i < c1.len) {
        if (c1[i] != c2[i]) {
            let q:i32 = xb_str(&b, "CANNOT-CONFIRM: calibration files differ at byte ");
            q = xb_i32(&b, i);
            q = xb_nl(&b);
            return 1;
        }
        i = i + 1;
    }
    // 4. Parse RUN and IDIAG rows from the run file.
    let mi:*i32 = _zag_malloc(4096*4) as *i32;
    let arena:[]i32 = mi[0..4096];
    let ticks:[]i32 = arena[0..128];       // [v*7+arm], 84 entries
    let ptot:[]i32 = arena[128..256];      // post_total [v*4+(arm-3)]
    let plrn:[]i32 = arena[256..384];      // post_learned
    let idr:[]i32 = arena[384..512];       // n_replans
    let idd:[]i32 = arena[512..640];       // n_distinct
    let ide:[]i32 = arena[640..768];       // enum_tick
    let inl:[]i32 = arena[768..896];       // nlog
    i = 0;
    while (i < 84) { ticks[i] = -1; i = i + 1; }
    i = 0;
    while (i < 48) { ptot[i] = 0; plrn[i] = 0; idr[i] = 0; idd[i] = 0; ide[i] = -1; inl[i] = 0; i = i + 1; }
    let nrun:i32 = 0;
    let nidiag:i32 = 0;
    let pos:i32 = 0;
    let len:i32 = d1.len;
    while (pos < len) {
        let le:i32 = pos;
        while (le < len && d1[le] != 10) { le = le + 1; }
        // RUN\tv\tarm\tticks\tenergy\tcause
        if (le - pos >= 4 && d1[pos] == 82 && d1[pos+1] == 85 && d1[pos+2] == 78 && d1[pos+3] == 9) {
            let p1:i32 = f_tab(d1, pos+4, le);
            let vv:i32 = p_i32(d1, pos+4, p1);
            let p2:i32 = f_tab(d1, p1+1, le);
            let arm:i32 = p_i32(d1, p1+1, p2);
            let p3:i32 = f_tab(d1, p2+1, le);
            let tk:i32 = p_i32(d1, p2+1, p3);
            if (vv >= 0 && vv < 12 && arm >= 0 && arm < 7) {
                ticks[vv*7+arm] = tk;
                nrun = nrun + 1;
            }
        }
        // IDIAG\tv\tarm\tn_replans\tn_distinct\tenum_tick\tpost_total\tpost_learned\tnlog
        if (le - pos >= 6 && d1[pos] == 73 && d1[pos+1] == 68 && d1[pos+2] == 73 && d1[pos+3] == 65 && d1[pos+4] == 71 && d1[pos+5] == 9) {
            let f0:i32 = f_tab(d1, pos+6, le);
            let vv:i32 = p_i32(d1, pos+6, f0);
            let f1:i32 = f_tab(d1, f0+1, le);
            let arm:i32 = p_i32(d1, f0+1, f1);
            let f2:i32 = f_tab(d1, f1+1, le);
            let f3:i32 = f_tab(d1, f2+1, le);
            let f4:i32 = f_tab(d1, f3+1, le);
            let f5:i32 = f_tab(d1, f4+1, le);
            let f6:i32 = f_tab(d1, f5+1, le);
            let f7:i32 = f_tab(d1, f6+1, le);
            let r_dr:i32 = p_i32(d1, f1+1, f2);
            let r_dd:i32 = p_i32(d1, f2+1, f3);
            let r_de:i32 = p_i32(d1, f3+1, f4);
            let r_pt:i32 = p_i32(d1, f4+1, f5);
            let r_pl:i32 = p_i32(d1, f5+1, f6);
            let r_nl:i32 = p_i32(d1, f6+1, f7);
            if (vv >= 0 && vv < 12 && arm >= 3 && arm < 7) {
                let ix:i32 = vv*4+(arm-3);
                ptot[ix] = r_pt;
                plrn[ix] = r_pl;
                idr[ix] = r_dr;
                idd[ix] = r_dd;
                ide[ix] = r_de;
                inl[ix] = r_nl;
                nidiag = nidiag + 1;
            }
        }
        pos = le + 1;
    }
    // 5. Validate structure: 84 RUN rows (12x7), 48 IDIAG rows (12x4).
    if (nrun != 84) {
        let q:i32 = xb_str(&b, "CANNOT-CONFIRM: expected 84 RUN rows, found ");
        q = xb_i32(&b, nrun);
        q = xb_nl(&b);
        return 1;
    }
    if (nidiag != 48) {
        let q:i32 = xb_str(&b, "CANNOT-CONFIRM: expected 48 IDIAG rows, found ");
        q = xb_i32(&b, nidiag);
        q = xb_nl(&b);
        return 1;
    }
    i = 0;
    while (i < 84) {
        if (ticks[i] < 0) {
            let q:i32 = xb_str(&b, "CANNOT-CONFIRM: missing RUN data");
            q = xb_nl(&b);
            return 1;
        }
        i = i + 1;
    }
    // 6. Parse CALIB rows: CALIB\tv\ts\tticks\tenergy, s in 0..4.
    let calt:[]i32 = arena[896..1088];   // [s*36+v] ticks for s=0..2
    let cale:[]i32 = arena[1088..1280];  // [s*36+v] energy for s=0..2
    i = 0;
    while (i < 108) { calt[i] = -1; cale[i] = -1; i = i + 1; }
    let ncal:i32 = 0;
    pos = 0;
    len = c1.len;
    while (pos < len) {
        let le:i32 = pos;
        while (le < len && c1[le] != 10) { le = le + 1; }
        // "CALIB\t" prefix: C A L I B \t
        if (le - pos >= 6 && c1[pos] == 67 && c1[pos+1] == 65 && c1[pos+2] == 76 && c1[pos+3] == 73 && c1[pos+4] == 66 && c1[pos+5] == 9) {
            let p1:i32 = f_tab(c1, pos+6, le);
            let vv:i32 = p_i32(c1, pos+6, p1);
            let p2:i32 = f_tab(c1, p1+1, le);
            let ss:i32 = p_i32(c1, p1+1, p2);
            let p3:i32 = f_tab(c1, p2+1, le);
            let tk:i32 = p_i32(c1, p2+1, p3);
            let p4:i32 = f_tab(c1, p3+1, le);
            let ee:i32 = p_i32(c1, p3+1, p4);
            if (vv >= 0 && vv < 12 && ss >= 0 && ss < 3) {
                calt[ss*36+vv] = tk;
                cale[ss*36+vv] = ee;
                ncal = ncal + 1;
            }
        }
        pos = le + 1;
    }
    if (ncal != 36) {
        let q:i32 = xb_str(&b, "CANNOT-CONFIRM: expected 36 CALIB rows (s=0..2), found ");
        q = xb_i32(&b, ncal);
        q = xb_nl(&b);
        return 1;
    }
    i = 0;
    while (i < 36) {
        if (calt[i] < 0) {
            let q:i32 = xb_str(&b, "CANNOT-CONFIRM: missing CALIB data");
            q = xb_nl(&b);
            return 1;
        }
        i = i + 1;
    }
    // 7. Compute medians per arm.
    let med:[]i32 = arena[1280..1408];  // med[arm], plus work area
    let arm:i32 = 0;
    while (arm < 7) {
        let vv:i32 = 0;
        while (vv < 12) {
            med[100+arm*12+vv] = ticks[vv*7+arm];
            vv = vv + 1;
        }
        med[arm] = med12e(med, 100+arm*12);
        arm = arm + 1;
    }
    // 8. C3 recomputation from calibration data: medians + corrected
    // vector-distinctness check.
    let cm:[]i32 = arena[1408..1536];
    let ss:i32 = 0;
    while (ss < 3) {
        let vv:i32 = 0;
        while (vv < 12) {
            cm[100+ss*12+vv] = calt[ss*36+vv];
            vv = vv + 1;
        }
        cm[ss] = med12e(cm, 100+ss*12);
        ss = ss + 1;
    }
    let d01:i32 = 0;
    let d02:i32 = 0;
    let d12:i32 = 0;
    let vv:i32 = 0;
    while (vv < 12) {
        if (calt[0*36+vv] != calt[1*36+vv] || cale[0*36+vv] != cale[1*36+vv]) { d01 = d01 + 1; }
        if (calt[0*36+vv] != calt[2*36+vv] || cale[0*36+vv] != cale[2*36+vv]) { d02 = d02 + 1; }
        if (calt[1*36+vv] != calt[2*36+vv] || cale[1*36+vv] != cale[2*36+vv]) { d12 = d12 + 1; }
        vv = vv + 1;
    }
    let c3:i32 = 0;
    if (cm[0] >= 720 && cm[1] >= 720 && cm[2] >= 720 && d01 >= 1 && d02 >= 1 && d12 >= 1) { c3 = 1; }
    // 9. K7 sums for I-survive (arm 3) and I-invent (arm 4).
    let k7_pt3:i32 = 0;
    let k7_pl3:i32 = 0;
    let k7_pt4:i32 = 0;
    let k7_pl4:i32 = 0;
    vv = 0;
    while (vv < 12) {
        k7_pt3 = k7_pt3 + ptot[vv*4+0];
        k7_pl3 = k7_pl3 + plrn[vv*4+0];
        k7_pt4 = k7_pt4 + ptot[vv*4+1];
        k7_pl4 = k7_pl4 + plrn[vv*4+1];
        vv = vv + 1;
    }
    // 10. Emit Markdown evidence note. Every verdict line is computed.
    let q:i32 = xb_str(&b, "# EXP1c Evidence Note");
    q = xb_nl(&b);
    q = xb_str(&b, "Wave: wave-20260927-2321pdt, retune iteration 3");
    q = xb_nl(&b);
    q = xb_str(&b, "Generated by x1c_evidence.zag from evidence/run1.tsv, evidence/run2.tsv,");
    q = xb_nl(&b);
    q = xb_str(&b, "iterations/iter3/calib1.txt, and iterations/iter3/calib2.txt.");
    q = xb_nl(&b);
    q = xb_str(&b, "Run files byte-identical (verified in-program); calibration files byte-identical.");
    q = xb_nl(&b);
    q = xb_nl(&b);
    q = xb_str(&b, "## Medians (ticks survived, 12 variants)");
    q = xb_nl(&b);
    q = xb_str(&b, "- P (arm 0): ");
    q = xb_i32(&b, med[0]);
    q = xb_nl(&b);
    q = xb_str(&b, "- R (arm 1): ");
    q = xb_i32(&b, med[1]);
    q = xb_nl(&b);
    q = xb_str(&b, "- Z (arm 2): ");
    q = xb_i32(&b, med[2]);
    q = xb_nl(&b);
    q = xb_str(&b, "- I-survive (arm 3): ");
    q = xb_i32(&b, med[3]);
    q = xb_nl(&b);
    q = xb_str(&b, "- I-invent (arm 4): ");
    q = xb_i32(&b, med[4]);
    q = xb_nl(&b);
    q = xb_str(&b, "- I-survive-abl (arm 5): ");
    q = xb_i32(&b, med[5]);
    q = xb_nl(&b);
    q = xb_str(&b, "- I-invent-abl (arm 6): ");
    q = xb_i32(&b, med[6]);
    q = xb_nl(&b);
    q = xb_nl(&b);
    // C1, C2, C3 (computed)
    q = xb_str(&b, "## Calibration gates");
    q = xb_nl(&b);
    q = xb_str(&b, "- C1 (median P >= 960): ");
    if (med[0] >= 960) { q = xb_str(&b, "PASS"); } else { q = xb_str(&b, "FAIL"); }
    q = xb_nl(&b);
    q = xb_str(&b, "- C2 (median Z < 300): ");
    if (med[2] < 300) { q = xb_str(&b, "PASS"); } else { q = xb_str(&b, "FAIL"); }
    q = xb_nl(&b);
    q = xb_str(&b, "- C3 (3 strategies median >= 720 and pairwise vector-distinct): ");
    if (c3 == 1) { q = xb_str(&b, "PASS"); } else { q = xb_str(&b, "NOT-MET"); }
    q = xb_nl(&b);
    q = xb_str(&b, "  calibrator medians f0=");
    q = xb_i32(&b, cm[0]);
    q = xb_str(&b, " f1=");
    q = xb_i32(&b, cm[1]);
    q = xb_str(&b, " f2=");
    q = xb_i32(&b, cm[2]);
    q = xb_nl(&b);
    q = xb_str(&b, "  vector diffs d01=");
    q = xb_i32(&b, d01);
    q = xb_str(&b, " d02=");
    q = xb_i32(&b, d02);
    q = xb_str(&b, " d12=");
    q = xb_i32(&b, d12);
    q = xb_str(&b, " (variants where (ticks,e_end) differ)");
    q = xb_nl(&b);
    q = xb_nl(&b);
    // K1-K3, K6, K7 (computed)
    q = xb_str(&b, "## Kill bars");
    q = xb_nl(&b);
    q = xb_str(&b, "- K1 (median I-survive <= median R kills H1): I-survive=");
    q = xb_i32(&b, med[3]);
    q = xb_str(&b, " R=");
    q = xb_i32(&b, med[1]);
    q = xb_str(&b, " ");
    if (med[3] <= med[1]) { q = xb_str(&b, "KILL"); } else { q = xb_str(&b, "survive"); }
    q = xb_nl(&b);
    q = xb_str(&b, "- K2 (median I-survive <= median Z kills H1): I-survive=");
    q = xb_i32(&b, med[3]);
    q = xb_str(&b, " Z=");
    q = xb_i32(&b, med[2]);
    q = xb_str(&b, " ");
    if (med[3] <= med[2]) { q = xb_str(&b, "KILL"); } else { q = xb_str(&b, "survive"); }
    q = xb_nl(&b);
    q = xb_str(&b, "- K3 (median P < 960 voids): P=");
    q = xb_i32(&b, med[0]);
    q = xb_str(&b, " ");
    if (med[0] < 960) { q = xb_str(&b, "VOID"); } else { q = xb_str(&b, "ok"); }
    q = xb_nl(&b);
    q = xb_str(&b, "- K6 (ablation): I-survive median=");
    q = xb_i32(&b, med[3]);
    q = xb_str(&b, " abl=");
    q = xb_i32(&b, med[5]);
    q = xb_str(&b, " ");
    if (med[5] >= med[3]) { q = xb_str(&b, "KILL (ablation does not reduce survival)"); } else { q = xb_str(&b, "survive"); }
    q = xb_nl(&b);
    q = xb_str(&b, "  I-invent median=");
    q = xb_i32(&b, med[4]);
    q = xb_str(&b, " abl=");
    q = xb_i32(&b, med[6]);
    q = xb_str(&b, " ");
    if (med[6] >= med[4]) { q = xb_str(&b, "KILL (ablation does not reduce survival)"); } else { q = xb_str(&b, "survive"); }
    q = xb_nl(&b);
    q = xb_str(&b, "- K7 (validity gate): I-survive post-enumeration selections=");
    q = xb_i32(&b, k7_pt3);
    q = xb_str(&b, " learned=");
    q = xb_i32(&b, k7_pl3);
    q = xb_nl(&b);
    q = xb_str(&b, "  I-invent post-enumeration selections=");
    q = xb_i32(&b, k7_pt4);
    q = xb_str(&b, " learned=");
    q = xb_i32(&b, k7_pl4);
    q = xb_nl(&b);
    let k7v:i32 = 1;
    if (k7_pt3 == 0 || k7_pl3*100 < k7_pt3*50) { k7v = 0; }
    if (k7_pt4 == 0 || k7_pl4*100 < k7_pt4*50) { k7v = 0; }
    q = xb_str(&b, "  K7 verdict: ");
    if (k7v == 1) { q = xb_str(&b, "PASS"); } else { q = xb_str(&b, "VOID (fraction < 0.50 or no post-enumeration selections)"); }
    q = xb_nl(&b);
    q = xb_nl(&b);
    // Enumeration diagnostics per the redrafted section 7.
    q = xb_str(&b, "## Enumeration diagnostics (redrafted section 7)");
    q = xb_nl(&b);
    q = xb_str(&b, "Per I-arm run: variant, arm, n_replans, n_distinct, enum_tick, post_total, post_learned.");
    q = xb_nl(&b);
    vv = 0;
    while (vv < 12) {
        let aa:i32 = 0;
        while (aa < 4) {
            let ix:i32 = vv*4+aa;
            q = xb_str(&b, "- v=");
            q = xb_i32(&b, vv);
            q = xb_str(&b, " arm=");
            q = xb_i32(&b, aa+3);
            q = xb_str(&b, " replans=");
            q = xb_i32(&b, idr[ix]);
            q = xb_str(&b, " n_distinct=");
            q = xb_i32(&b, idd[ix]);
            q = xb_str(&b, " enum_tick=");
            q = xb_i32(&b, ide[ix]);
            q = xb_str(&b, " post_total=");
            q = xb_i32(&b, ptot[ix]);
            q = xb_str(&b, " post_learned=");
            q = xb_i32(&b, plrn[ix]);
            q = xb_nl(&b);
            aa = aa + 1;
        }
        vv = vv + 1;
    }
    q = xb_nl(&b);
    q = xb_str(&b, "## Other bars");
    q = xb_nl(&b);
    q = xb_str(&b, "- K4: CANNOT-CONFIRM (requires manual audit of taught strategies vs learned behavior)");
    q = xb_nl(&b);
    q = xb_str(&b, "- K5: INCOMPLETE (no independent auditor; implementer cannot self-certify)");
    q = xb_nl(&b);
    return 0;
}

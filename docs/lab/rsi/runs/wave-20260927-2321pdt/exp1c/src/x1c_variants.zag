// x1c_variants.zag -- EXP1c 12 world variants, RETUNE ITERATION 3.
// Wave-20260927-2321pdt implementation worker, written from scratch.
// Family: dispersed-mote (vel=0 with lo<hi, tight drift ranges per the
// binding stationarity requirement). Every mote, crystal, start, and home
// sits on the same side of the void pair; void pairs cycle (10,11),
// (4,5), (16,17). Home is outside the storm zone [6,17]. Two local motes
// sit inside each home's patrol segment [home-2, home+2]; the rest are
// dispersed on the same side; two deep motes are placed outside the
// patrol segment where the side allows it. Four crystals, three storms
// in thirds of the 1200-tick horizon.
// The iteration label below is written by this iteration's emitter.

@import("x1c_params.zag")

const X1C_ITER:i32 = 3;

fn x1c_mote(d:[]i32, i:i32, pos:i32, lo:i32, hi:i32, deep:i32)i32 {
    d[XP_MPOS+i] = pos;
    d[XP_MVEL+i] = 0;
    d[XP_MLO+i] = lo;
    d[XP_MHI+i] = hi;
    d[XP_MRESP+i] = pos;
    d[XP_MDEEP+i] = deep;
    return 0;
}

fn x1c_fill(v:i32, p:*XParams)i32 {
    let d:[]i32 = p.dat;
    let q:i32 = 0;
    if (v == 0) {
        p.void0 = 10; p.void1 = 11; p.start = 14; p.home = 20;
        d[XP_CRYS+0]=12; d[XP_CRYS+1]=17; d[XP_CRYS+2]=22; d[XP_CRYS+3]=13;
        d[XP_SS+0]=240; d[XP_SE+0]=275; d[XP_SS+1]=590; d[XP_SE+1]=630; d[XP_SS+2]=940; d[XP_SE+2]=980;
        q = x1c_mote(d, 0, 19, 18, 19, 0);
        q = x1c_mote(d, 1, 21, 21, 22, 0);
        q = x1c_mote(d, 2, 15, 15, 16, 0);
        q = x1c_mote(d, 3, 23, 22, 23, 0);
        q = x1c_mote(d, 4, 13, 13, 14, 1);
        q = x1c_mote(d, 5, 16, 16, 17, 1);
        return 0;
    }
    if (v == 1) {
        p.void0 = 4; p.void1 = 5; p.start = 12; p.home = 20;
        d[XP_CRYS+0]=12; d[XP_CRYS+1]=15; d[XP_CRYS+2]=22; d[XP_CRYS+3]=9;
        d[XP_SS+0]=210; d[XP_SE+0]=250; d[XP_SS+1]=560; d[XP_SE+1]=600; d[XP_SS+2]=910; d[XP_SE+2]=950;
        q = x1c_mote(d, 0, 19, 18, 19, 0);
        q = x1c_mote(d, 1, 21, 21, 22, 0);
        q = x1c_mote(d, 2, 14, 14, 15, 0);
        q = x1c_mote(d, 3, 16, 16, 17, 0);
        q = x1c_mote(d, 4, 10, 10, 11, 1);
        q = x1c_mote(d, 5, 23, 22, 23, 1);
        return 0;
    }
    if (v == 2) {
        p.void0 = 16; p.void1 = 17; p.start = 19; p.home = 20;
        d[XP_CRYS+0]=18; d[XP_CRYS+1]=21; d[XP_CRYS+2]=23; d[XP_CRYS+3]=22;
        d[XP_SS+0]=240; d[XP_SE+0]=275; d[XP_SS+1]=590; d[XP_SE+1]=630; d[XP_SS+2]=940; d[XP_SE+2]=980;
        q = x1c_mote(d, 0, 18, 18, 19, 0);
        q = x1c_mote(d, 1, 21, 21, 22, 0);
        q = x1c_mote(d, 2, 22, 22, 23, 0);
        q = x1c_mote(d, 3, 23, 22, 23, 0);
        q = x1c_mote(d, 4, 23, 22, 23, 1);
        q = x1c_mote(d, 5, 21, 21, 22, 1);
        return 0;
    }
    if (v == 3) {
        p.void0 = 10; p.void1 = 11; p.start = 18; p.home = 22;
        d[XP_CRYS+0]=21; d[XP_CRYS+1]=23; d[XP_CRYS+2]=12; d[XP_CRYS+3]=16;
        d[XP_SS+0]=210; d[XP_SE+0]=250; d[XP_SS+1]=560; d[XP_SE+1]=600; d[XP_SS+2]=910; d[XP_SE+2]=950;
        q = x1c_mote(d, 0, 20, 20, 21, 0);
        q = x1c_mote(d, 1, 21, 20, 21, 0);
        q = x1c_mote(d, 2, 14, 14, 15, 0);
        q = x1c_mote(d, 3, 17, 17, 18, 0);
        q = x1c_mote(d, 4, 13, 13, 14, 1);
        q = x1c_mote(d, 5, 19, 19, 20, 1);
        return 0;
    }
    if (v == 4) {
        p.void0 = 4; p.void1 = 5; p.start = 10; p.home = 21;
        d[XP_CRYS+0]=10; d[XP_CRYS+1]=14; d[XP_CRYS+2]=22; d[XP_CRYS+3]=18;
        d[XP_SS+0]=260; d[XP_SE+0]=295; d[XP_SS+1]=610; d[XP_SE+1]=650; d[XP_SS+2]=960; d[XP_SE+2]=1000;
        q = x1c_mote(d, 0, 19, 19, 20, 0);
        q = x1c_mote(d, 1, 20, 19, 20, 0);
        q = x1c_mote(d, 2, 12, 12, 13, 0);
        q = x1c_mote(d, 3, 15, 15, 16, 0);
        q = x1c_mote(d, 4, 8, 8, 9, 1);
        q = x1c_mote(d, 5, 23, 22, 23, 1);
        return 0;
    }
    if (v == 5) {
        p.void0 = 16; p.void1 = 17; p.start = 22; p.home = 20;
        d[XP_CRYS+0]=22; d[XP_CRYS+1]=18; d[XP_CRYS+2]=23; d[XP_CRYS+3]=21;
        d[XP_SS+0]=250; d[XP_SE+0]=285; d[XP_SS+1]=600; d[XP_SE+1]=640; d[XP_SS+2]=950; d[XP_SE+2]=990;
        q = x1c_mote(d, 0, 19, 18, 19, 0);
        q = x1c_mote(d, 1, 21, 21, 22, 0);
        q = x1c_mote(d, 2, 18, 18, 19, 0);
        q = x1c_mote(d, 3, 23, 22, 23, 0);
        q = x1c_mote(d, 4, 23, 22, 23, 1);
        q = x1c_mote(d, 5, 19, 18, 19, 1);
        return 0;
    }
    if (v == 6) {
        p.void0 = 10; p.void1 = 11; p.start = 16; p.home = 19;
        d[XP_CRYS+0]=16; d[XP_CRYS+1]=19; d[XP_CRYS+2]=21; d[XP_CRYS+3]=12;
        d[XP_SS+0]=250; d[XP_SE+0]=285; d[XP_SS+1]=600; d[XP_SE+1]=640; d[XP_SS+2]=950; d[XP_SE+2]=990;
        q = x1c_mote(d, 0, 18, 17, 18, 0);
        q = x1c_mote(d, 1, 20, 20, 21, 0);
        q = x1c_mote(d, 2, 13, 13, 14, 0);
        q = x1c_mote(d, 3, 15, 15, 16, 0);
        q = x1c_mote(d, 4, 14, 14, 15, 1);
        q = x1c_mote(d, 5, 22, 22, 23, 1);
        return 0;
    }
    if (v == 7) {
        p.void0 = 4; p.void1 = 5; p.start = 14; p.home = 18;
        d[XP_CRYS+0]=14; d[XP_CRYS+1]=17; d[XP_CRYS+2]=20; d[XP_CRYS+3]=11;
        d[XP_SS+0]=220; d[XP_SE+0]=255; d[XP_SS+1]=570; d[XP_SE+1]=610; d[XP_SS+2]=920; d[XP_SE+2]=960;
        q = x1c_mote(d, 0, 17, 16, 17, 0);
        q = x1c_mote(d, 1, 19, 19, 20, 0);
        q = x1c_mote(d, 2, 10, 10, 11, 0);
        q = x1c_mote(d, 3, 12, 12, 13, 0);
        q = x1c_mote(d, 4, 8, 8, 9, 1);
        q = x1c_mote(d, 5, 22, 22, 23, 1);
        return 0;
    }
    if (v == 8) {
        p.void0 = 16; p.void1 = 17; p.start = 18; p.home = 22;
        d[XP_CRYS+0]=18; d[XP_CRYS+1]=20; d[XP_CRYS+2]=21; d[XP_CRYS+3]=23;
        d[XP_SS+0]=280; d[XP_SE+0]=315; d[XP_SS+1]=630; d[XP_SE+1]=670; d[XP_SS+2]=980; d[XP_SE+2]=1020;
        q = x1c_mote(d, 0, 20, 20, 21, 0);
        q = x1c_mote(d, 1, 21, 20, 21, 0);
        q = x1c_mote(d, 2, 19, 19, 20, 0);
        q = x1c_mote(d, 3, 19, 18, 19, 0);
        q = x1c_mote(d, 4, 20, 20, 21, 1);
        q = x1c_mote(d, 5, 21, 20, 21, 1);
        return 0;
    }
    if (v == 9) {
        p.void0 = 10; p.void1 = 11; p.start = 21; p.home = 18;
        d[XP_CRYS+0]=21; d[XP_CRYS+1]=18; d[XP_CRYS+2]=15; d[XP_CRYS+3]=12;
        d[XP_SS+0]=230; d[XP_SE+0]=265; d[XP_SS+1]=580; d[XP_SE+1]=620; d[XP_SS+2]=930; d[XP_SE+2]=970;
        q = x1c_mote(d, 0, 17, 16, 17, 0);
        q = x1c_mote(d, 1, 19, 19, 20, 0);
        q = x1c_mote(d, 2, 13, 13, 14, 0);
        q = x1c_mote(d, 3, 23, 22, 23, 0);
        q = x1c_mote(d, 4, 14, 14, 15, 1);
        q = x1c_mote(d, 5, 22, 22, 23, 1);
        return 0;
    }
    if (v == 10) {
        p.void0 = 4; p.void1 = 5; p.start = 8; p.home = 20;
        d[XP_CRYS+0]=8; d[XP_CRYS+1]=13; d[XP_CRYS+2]=22; d[XP_CRYS+3]=16;
        d[XP_SS+0]=265; d[XP_SE+0]=300; d[XP_SS+1]=615; d[XP_SE+1]=655; d[XP_SS+2]=965; d[XP_SE+2]=1005;
        q = x1c_mote(d, 0, 19, 18, 19, 0);
        q = x1c_mote(d, 1, 21, 21, 22, 0);
        q = x1c_mote(d, 2, 12, 12, 13, 0);
        q = x1c_mote(d, 3, 14, 14, 15, 0);
        q = x1c_mote(d, 4, 9, 9, 10, 1);
        q = x1c_mote(d, 5, 23, 22, 23, 1);
        return 0;
    }
    // v == 11
    p.void0 = 16; p.void1 = 17; p.start = 23; p.home = 20;
    d[XP_CRYS+0]=23; d[XP_CRYS+1]=19; d[XP_CRYS+2]=22; d[XP_CRYS+3]=18;
    d[XP_SS+0]=255; d[XP_SE+0]=290; d[XP_SS+1]=605; d[XP_SE+1]=645; d[XP_SS+2]=955; d[XP_SE+2]=995;
    q = x1c_mote(d, 0, 19, 18, 19, 0);
    q = x1c_mote(d, 1, 21, 21, 22, 0);
    q = x1c_mote(d, 2, 18, 18, 19, 0);
    q = x1c_mote(d, 3, 22, 22, 23, 0);
    q = x1c_mote(d, 4, 18, 18, 19, 1);
    q = x1c_mote(d, 5, 21, 21, 22, 1);
    return 0;
}

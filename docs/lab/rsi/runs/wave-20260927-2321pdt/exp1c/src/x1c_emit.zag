// x1c_emit.zag -- EXP1c iteration-3 variant emitter.
// Prints the 12 variant parameter sets produced by x1c_variants.zag, so the
// committed variant output documents exactly what the calibration and the
// full runner consumed.
@import("x1c_variants.zag")
@import("x1c_out.zag")

fn main()i32 {
    let mu:*u8 = _zag_malloc(8192);
    let u8a:[]u8 = mu[0..8192];
    let b:XBuf = xb_new(u8a, 0, 8192);
    let mi:*i32 = _zag_malloc(1024*4) as *i32;
    let arena:[]i32 = mi[0..1024];
    let pdat:[]i32 = arena[0..1024];
    let p:XParams = xp_new(pdat);
    let v:i32 = 0;
    while (v < 12) {
        let q:i32 = x1c_fill(v, &p);
        q = xb_str(&b, "X1C_ITER=3 VARIANT ");
        q = xb_i32(&b, v);
        q = xb_str(&b, " void=");
        q = xb_i32(&b, p.void0);
        q = xb_ch(&b, 44);
        q = xb_i32(&b, p.void1);
        q = xb_str(&b, " start=");
        q = xb_i32(&b, p.start);
        q = xb_str(&b, " home=");
        q = xb_i32(&b, p.home);
        q = xb_str(&b, " crys=");
        q = xb_i32(&b, p.dat[XP_CRYS+0]); q = xb_ch(&b, 44);
        q = xb_i32(&b, p.dat[XP_CRYS+1]); q = xb_ch(&b, 44);
        q = xb_i32(&b, p.dat[XP_CRYS+2]); q = xb_ch(&b, 44);
        q = xb_i32(&b, p.dat[XP_CRYS+3]);
        q = xb_str(&b, " storms=");
        q = xb_i32(&b, p.dat[XP_SS+0]); q = xb_ch(&b, 45);
        q = xb_i32(&b, p.dat[XP_SE+0]); q = xb_ch(&b, 44);
        q = xb_i32(&b, p.dat[XP_SS+1]); q = xb_ch(&b, 45);
        q = xb_i32(&b, p.dat[XP_SE+1]); q = xb_ch(&b, 44);
        q = xb_i32(&b, p.dat[XP_SS+2]); q = xb_ch(&b, 45);
        q = xb_i32(&b, p.dat[XP_SE+2]);
        q = xb_str(&b, " motes=");
        let m:i32 = 0;
        while (m < 6) {
            q = xb_i32(&b, p.dat[XP_MPOS+m]); q = xb_ch(&b, 58);
            q = xb_i32(&b, p.dat[XP_MLO+m]); q = xb_ch(&b, 58);
            q = xb_i32(&b, p.dat[XP_MHI+m]); q = xb_ch(&b, 58);
            q = xb_i32(&b, p.dat[XP_MDEEP+m]);
            if (m < 5) { q = xb_ch(&b, 44); }
            m = m + 1;
        }
        q = xb_nl(&b);
        v = v + 1;
    }
    return 0;
}

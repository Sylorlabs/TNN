// trialwall.zag -- ARENA-ENG lane, wave-20261002-0521pdt
// Standalone prototype of the TNN-2 trial-loop core for wall diagnosis.
// Core functions extracted VERBATIM from tnn2.zag (frozen TNN-2 source).
// Only deviations (marked // INSTR): write-only counters in header fields
// 52/56/60 and in the write-only event-log slots loff(0,0..28); log_ev
// stubbed to no-op (log is write-only; lg() is never called in tnn2.zag).
// No logic reads the counter fields. Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ============ layout: 1024 nodes, 4096 edges, 128 log ============
fn WSZ()i32 { return 110656; }
fn NN()i32 { return 1024; }
fn NE()i32 { return 4096; }
fn hg(W:[]u8,f:i32)i32 { return get32(W,f); }
fn hs(W:[]u8,f:i32,v:i32)void { set32(W,f,v); return; }
fn noff(n:i32)i32 { return 64+n*40; }
fn ng(W:[]u8,n:i32,f:i32)i32 { return get32(W,noff(n)+f); }
fn ns(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,noff(n)+f,v); return; }
fn eoff(e:i32)i32 { return 41024+e*16; }
fn eg(W:[]u8,e:i32,f:i32)i32 { return get32(W,eoff(e)+f); }
fn es(W:[]u8,e:i32,f:i32,v:i32)void { set32(W,eoff(e)+f,v); return; }
fn loff(l:i32)i32 { return 106560+l*32; }
fn lg(W:[]u8,l:i32,f:i32)i32 { return get32(W,loff(l)+f); }
fn ls(W:[]u8,l:i32,f:i32,v:i32)void { set32(W,loff(l)+f,v); return; }

fn alloc_node(W:[]u8)i32 {
  hs(W,52,hg(W,52)+1); // INSTR: alloc_node call count (write-only field 52)
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==0){
      ns(W,n,36,1); ns(W,n,0,0);
      ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,0); ns(W,n,16,0);
      ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
      hs(W,20,hg(W,20)+1); return n;
    }
    n=n+1;
  }
  let v:i32=evict_node(W);
  if(v<0){return -1;}
  ns(W,v,36,1); ns(W,v,0,0);
  ns(W,v,4,0); ns(W,v,8,0); ns(W,v,12,0); ns(W,v,16,0);
  ns(W,v,20,0); ns(W,v,24,0); ns(W,v,28,0); ns(W,v,32,0);
  hs(W,20,hg(W,20)+1); return v;
}
fn alloc_raw(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==0){
      ns(W,n,36,1); ns(W,n,0,0);
      ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,0); ns(W,n,16,0);
      ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
      hs(W,20,hg(W,20)+1); return n;
    }
    n=n+1;
  }
  return -1;
}
fn write_node(W:[]u8,n:i32,a:i32,b:i32,c:i32,d:i32)void {
  ns(W,n,20,a); ns(W,n,24,b); ns(W,n,28,c); ns(W,n,32,d); return;
}
fn link_edge(W:[]u8,f:i32,t:i32,to:i32,clk:i32)i32 {
  hs(W,60,hg(W,60)+1); // INSTR: link_edge call count (write-only field 60)
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==-1){
      es(W,e,0,f); es(W,e,4,t); es(W,e,8,to); es(W,e,12,clk);
      hs(W,24,hg(W,24)+1); return e;
    }
    e=e+1;
  }
  return -1;
}

fn is_superseded(W:[]u8,n:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==3 && eg(W,e,0)==n && eg(W,e,8)==n){return 1;}
    e=e+1;
  }
  return 0;
}
fn activate(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=-1; let bb:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let b:i32=bid(W,n);
        if(b>bb){bb=b; best=n;}
      }
    }
    n=n+1;
  }
  return best;
}
fn decay(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==9){
      let c:i32=eg(W,e,12)-1;
      if(c<=0){es(W,e,0,-1); hs(W,24,hg(W,24)-1);}
      else {es(W,e,12,c);}
    }
    e=e+1;
  }
  return;
}
// ---- EXECUTE ----

fn fr_get(W:[]u8,f:i32,s:i32)i32 {
  let cur:i32=f; let ss:i32=s;
  while(ss>=4){cur=ng(W,cur,4); if(cur<0){return 0;} ss=ss-4;}
  if(ss==0){return ng(W,cur,20);} if(ss==1){return ng(W,cur,24);}
  if(ss==2){return ng(W,cur,28);} return ng(W,cur,32);
}
fn fr_set(W:[]u8,f:i32,s:i32,v:i32)void {
  let cur:i32=f; let ss:i32=s;
  while(ss>=4){cur=ng(W,cur,4); if(cur<0){return;} ss=ss-4;}
  if(ss==0){ns(W,cur,20,v);} else {if(ss==1){ns(W,cur,24,v);}
  else {if(ss==2){ns(W,cur,28,v);} else {ns(W,cur,32,v);}}}
  return;
}
fn res_op(W:[]u8,f:i32,op:i32)i32 {
  if(op>=1000){return fr_get(W,f,op-1000);}
  if(op>=0){return ng(W,op,20);}
  return 0;
}
fn seq_nx(W:[]u8,c:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==12 && eg(W,e,0)==c){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
fn execute(W:[]u8,root:i32,fr:i32)i32 {
  let cur:i32=root; let st:i32=0;
  while(st<1000){
    ls(W,0,0,lg(W,0,0)+1); // INSTR: execute cell-steps (write-only log slot)
    if(cur<0){return -999999;}
    let tag:i32=ng(W,cur,0); let nx:i32=-1;
    if(tag==101){
      let d:i32=ng(W,cur,4); let sr:i32=ng(W,cur,8);
      if(d<1000){return -999999;}
      fr_set(W,fr,d-1000,res_op(W,fr,sr)); nx=seq_nx(W,cur);
    } else {if(tag==102){
      let a:i32=res_op(W,fr,ng(W,cur,4)); let b:i32=res_op(W,fr,ng(W,cur,8));
      if(a==b){nx=ng(W,cur,12);} else {nx=ng(W,cur,16);}
    } else {if(tag==103){
      let s:i32=ng(W,cur,4); if(s<1000){return -999999;}
      fr_set(W,fr,s-1000,fr_get(W,fr,s-1000)+1); nx=seq_nx(W,cur);
    } else {if(tag==104){
      let s2:i32=ng(W,cur,4); if(s2<1000){return -999999;}
      fr_set(W,fr,s2-1000,fr_get(W,fr,s2-1000)-1); nx=seq_nx(W,cur);
    } else {return -999999;}}}}
    if(nx<0){if(tag==102){return -999999;} return 1;}
    cur=nx; st=st+1;
  }
  return -999999;
}
fn exec_val(W:[]u8,root:i32,fr:i32)i32 {
  if(execute(W,root,fr)!=1){return -999999;}
  return res_op(W,fr,ng(W,root,4));
}

fn is_prot(W:[]u8,n:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==9 && eg(W,e,8)==n && eg(W,e,12)>0){return 1;}
    e=e+1;
  }
  return 0;
}
fn evcount(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,8)==n && eg(W,e,4)==t){c=c+1;}
    e=e+1;
  }
  return c;
}
fn bid(W:[]u8,n:i32)i32 {
  let c:i32=evcount(W,n,1)+evcount(W,n,2)+evcount(W,n,6)+evcount(W,n,7)-evcount(W,n,3);
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==10 && eg(W,e,8)==n){
      let g:i32=eg(W,e,0);
      c=c+evcount(W,g,1)+evcount(W,g,2)+evcount(W,g,6)+evcount(W,g,7)-evcount(W,g,3);
    }
    e=e+1;
  }
  return c;
}
fn rec_evict(W:[]u8,n:i32)void {
  let h:i32=alloc_raw(W); if(h<0){return;}
  ns(W,h,0,3); write_node(W,h,ng(W,n,20),ng(W,n,24),ng(W,n,28),hg(W,0));
  ns(W,h,4,hg(W,12)); hs(W,12,h); return;
}
fn evict_node(W:[]u8)i32 {
  hs(W,56,hg(W,56)+1); // INSTR: evict_node call count (write-only field 56)
  let cur:i32=hg(W,8); let best:i32=-1; let bb:i32=1000000; let i:i32=0;
  while(i<1024){
    let n:i32=cur+i; if(n>=1024){n=n-1024;}
    if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0){
      let b:i32=bid(W,n);
      if(b<bb){bb=b; best=n;}
    }
    i=i+1;
  }
  if(best<0){return -1;}
  rec_evict(W,best); ns(W,best,36,0); hs(W,20,hg(W,20)-1);
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && (eg(W,e,0)==best || eg(W,e,8)==best)){
      es(W,e,0,-1); hs(W,24,hg(W,24)-1);
    }
    e=e+1;
  }
  let nc:i32=best+1; if(nc>=1024){nc=2;} hs(W,8,nc);
  return best;
}
fn ref_prot(W:[]u8,n:i32)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==9 && eg(W,e,8)==n){es(W,e,12,hg(W,4));}
    e=e+1;
  }
  return;
}

// INSTR: log_ev stubbed to no-op. The event log is write-only in tnn2.zag
// (lg() is never called); nothing reads it. Log slots loff(0,0..28) are
// repurposed as write-only profiling counters.
fn log_ev(W:[]u8,k:i32,r0:i32,r1:i32,p0:i32,p1:i32,p2:i32,p3:i32)void {
  return;
}
fn ctx_push(W:[]u8,r:i32)void {
  let i:i32=hg(W,48); hs(W,32+i*4,r); i=i+1; if(i>=4){i=0;} hs(W,48,i); return;
}
fn ctx_get(W:[]u8,i:i32)i32 {
  let x:i32=hg(W,48)-1-i; while(x<0){x=x+4;} return hg(W,32+x*4);
}
fn ev_teach(W:[]u8,s:i32,r:i32,o:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,1); write_node(W,n,s,r,o,hg(W,0));
  link_edge(W,n,9,n,hg(W,4));
  let prev:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m!=n && ng(W,m,0)==1){prev=m;}
    m=m+1;
  }
  if(prev>=0){link_edge(W,n,5,prev,0);}
  log_ev(W,1,s,r,o,0,0,0); return n;
}
fn ev_teach_in(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,1); write_node(W,n,s,r,o,hg(W,0));
  link_edge(W,n,9,n,hg(W,4)); return n;
}

fn seq_link(W:[]u8,a:i32,b:i32)void { link_edge(W,a,12,b,0); return; }
// The MUL Rung B trial loop (propose/execute/verify/promote) as the general
// miss policy. Candidate plans are 4-op ISA graphs (tags 101-104) assembled
// at runtime from primitive cells, executed by execute() (the single
// executor), verified against the triggering observation, and promoted to
// learner state. The fixed plan templates (plan_c2/plan_g/plan_it/plan_ext/
// plan_c2c) and the separate exec_plan executor are removed (K-T2-2, K-T2-3).
// Graph conventions:
// - Cells link via ET_SEQ edges, except BRANCHEQ true-targets (field12).
// - A GUARD cell (BRANCHEQ) with no SEQ fallthrough fails closed: execute
//   returns -999999, which the verifier counts as a rejection.
// - Literals are 902-nodes holding the value in field20 (data, not a new
//   node type; invisible to activate/inc_fill which scan type 1).
// - Frame: fresh 902-node; slot0 = query subject s (chain/count) or 0
//   (sum), slot1 = 0. Root field4 is the output operand (1000+slot).
// - Provenance: each SETREG cell carries an ET_DEP edge to the fact node
//   licensing its link; the MAP node carries ET_DEP edges to all of them.
//   Change 3 (revision) uses this to find stale steps.
// Gather helpers kept verbatim from the frozen base: inc_fill,
// comb_present, popcnt. map_standing/contradict_map kept verbatim.
fn t2_lit(W:[]u8,v:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,902); ns(W,n,20,v); return n;
}
fn t2_cell(W:[]u8,tag:i32)i32 {
  let c:i32=alloc_node(W); if(c<0){return -1;}
  ns(W,c,0,tag); return c;
}
fn t2_guard(W:[]u8,slot:i32,litx:i32)i32 {
  let g:i32=t2_cell(W,102); if(g<0){return -1;}
  ns(W,g,4,1000+slot); ns(W,g,8,litx); return g;
}
fn t2_set(W:[]u8,slot:i32,lity:i32)i32 {
  let s:i32=t2_cell(W,101); if(s<0){return -1;}
  ns(W,s,4,1000+slot); ns(W,s,8,lity); return s;
}
fn t2_mov(W:[]u8,dst:i32,src:i32)i32 {
  let c:i32=t2_cell(W,101); if(c<0){return -1;}
  ns(W,c,4,1000+dst); ns(W,c,8,1000+src); return c;
}
fn t2_inc(W:[]u8,slot:i32)i32 {
  let c:i32=t2_cell(W,103); if(c<0){return -1;}
  ns(W,c,4,1000+slot); return c;
}
// chain graph: guard each link (v[j] -> v[j+1]), set on match.
fn t2_asm_chain(W:[]u8,v:[]u8,plen:i32,f:[]u8)i32 {
  let root:i32=-1; let prev:i32=-1; let j:i32=0;
  while(j<plen-1){
    let lx:i32=t2_lit(W,get32(v,j*4)); if(lx<0){return -1;}
    let ly:i32=t2_lit(W,get32(v,(j+1)*4)); if(ly<0){return -1;}
    let g:i32=t2_guard(W,0,lx); if(g<0){return -1;}
    let st:i32=t2_set(W,0,ly); if(st<0){return -1;}
    ns(W,g,12,st);
    link_edge(W,st,1,get32(f,j*4),0);
    if(prev>=0){seq_link(W,prev,g);} else {root=g;}
    prev=st; j=j+1;
  }
  return root;
}
// count graph: chain links, each setting plus an increment, then
// MOVE r0 <- r1 epilogue so the count is the output.
fn t2_asm_count(W:[]u8,v:[]u8,plen:i32,f:[]u8)i32 {
  let root:i32=-1; let prev:i32=-1; let j:i32=0;
  while(j<plen-1){
    let lx:i32=t2_lit(W,get32(v,j*4)); if(lx<0){return -1;}
    let ly:i32=t2_lit(W,get32(v,(j+1)*4)); if(ly<0){return -1;}
    let g:i32=t2_guard(W,0,lx); if(g<0){return -1;}
    let st:i32=t2_set(W,0,ly); if(st<0){return -1;}
    let ic:i32=t2_inc(W,1); if(ic<0){return -1;}
    ns(W,g,12,st); seq_link(W,st,ic);
    link_edge(W,st,1,get32(f,j*4),0);
    if(prev>=0){seq_link(W,prev,g);} else {root=g;}
    prev=ic; j=j+1;
  }
  let mv:i32=t2_mov(W,0,1); if(mv<0){return -1;}
  seq_link(W,prev,mv);
  return root;
}
// sum graph: unrolled INC cells for the subset total. Negative totals and
// totals beyond the execute budget are skipped (candidate declined).
fn t2_asm_sum(W:[]u8,vals:[]u8,n:i32)i32 {
  let total:i32=0; let i:i32=0;
  while(i<n){total=total+get32(vals,i*4); i=i+1;}
  if(total<=0 || total>900){return -1;}
  ls(W,0,20,lg(W,0,20)+total); // INSTR: sum-graph cells built
  let root:i32=-1; let prev:i32=-1;
  i=0;
  while(i<total){
    let c:i32=t2_inc(W,0); if(c<0){return -1;}
    if(prev>=0){seq_link(W,prev,c);} else {root=c;}
    prev=c; i=i+1;
  }
  return root;
}
// run one candidate graph on a fresh frame; -999999 on any failure.
fn t2_exec(W:[]u8,root:i32,s0:i32)i32 {
  if(root<0){return -999999;}
  let fr:i32=alloc_node(W); if(fr<0){return -999999;}
  ns(W,fr,0,902); fr_set(W,fr,0,s0); fr_set(W,fr,1,0);
  if(execute(W,root,fr)!=1){return -999999;}
  return res_op(W,fr,ng(W,root,4));
}

fn t2_lu_first(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){return n;}
    n=n+1;
  }
  return -1;
}
// per-relation value chain: v[0]=s; f per link. Returns value count.
fn t2_chain(W:[]u8,s:i32,r:i32,v:[]u8,f:[]u8)i32 {
  set32(v,0,s); let len:i32=1; let cur:i32=s; let done:i32=0;
  while(len<16 && done==0){
    let fnd:i32=t2_lu_first(W,cur,r);
    if(fnd<0){done=1;}
    else {
      set32(v,len*4,ng(W,fnd,28)); set32(f,(len-1)*4,fnd);
      cur=ng(W,fnd,28); len=len+1;
    }
  }
  return len;
}
// BFS paths from s (depth 1..4, no -999 links). Entry: 12 i32 slots:
// len, v0..v4, f0..f3. Returns path count.
fn t2_gather(W:[]u8,s:i32,paths:[]u8)i32 {
  let np:i32=0; let cap:i32=96;
  set32(paths,0,1); set32(paths,4,s); np=1;
  let head:i32=0;
  while(head<np && np<cap){
    let base:i32=head*48;
    let len:i32=get32(paths,base);
    if(len<5){
      let lastv:i32=get32(paths,base+len*4);
      let n:i32=2;
      while(n<1024 && np<cap){
        if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==lastv && ng(W,n,24)!=-999){
          let o:i32=ng(W,n,28);
          let k:i32=0; let cyc:i32=0;
          while(k<len){if(get32(paths,base+4+k*4)==o){cyc=1;} k=k+1;}
          if(cyc==0){
            let nb:i32=np*48; let c2:i32=0;
            while(c2<12){set32(paths,nb+c2*4,get32(paths,base+c2*4)); c2=c2+1;}
            set32(paths,nb,len+1);
            set32(paths,nb+4+len*4,o);
            set32(paths,nb+24+(len-1)*4,n);
            np=np+1;
          }
        }
        n=n+1;
      }
    }
    head=head+1;
  }
  ls(W,0,24,lg(W,0,24)+np); // INSTR: gather path count
  return np;
}
// sum candidates: values + licensing facts of s's direct (non -999) facts.
fn t2_gather_sum(W:[]u8,s:i32,vals:[]u8,facts:[]u8)i32 {
  let n:i32=0; let x:i32=2;
  while(x<1024 && n<12){
    if(ng(W,x,36)==1 && ng(W,x,0)==1 && ng(W,x,20)==s && ng(W,x,24)!=-999){
      set32(vals,n*4,ng(W,x,28)); set32(facts,n*4,x); n=n+1;
    }
    x=x+1;
  }
  return n;
}
// relations of s, excluding -999.
fn t2_rels(W:[]u8,s:i32,out:[]u8)i32 {
  let rb:[]u8=z_alloc(64); let nr:i32=inc_fill(W,s,rb);
  let n:i32=0; let i:i32=0;
  while(i<nr){
    let r:i32=get32(rb,i*4);
    if(r!=-999){set32(out,n*4,r); n=n+1;}
    i=i+1;
  }
  return n;
}
// verify one candidate. st[0]=tried, st[1]=rejected. Returns the verified
// answer or -2. A failed guard (execute -999999) is a genuine rejection.
fn t2_try_verify(W:[]u8,root:i32,s0:i32,expected:i32,masked:i32,st:[]u8)i32 {
  if(root<0){return -2;}
  set32(st,0,get32(st,0)+1);
  let v:i32=t2_exec(W,root,s0);
  if(masked==1){
    if(v!=-2 && v!=-999999){return v;}
  } else {
    if(expected!=-2 && v==expected){return v;}
  }
  set32(st,4,get32(st,4)+1);
  return -2;
}
// graph signature for revision tests: walk SEQ + BRANCHEQ true-targets,
// record (tag, literal) per cell. Returns cell count.

fn promote_graph(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,-1); ns(W,m,16,-1);
  write_node(W,m,root,hg(W,24),ans,0);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  let i:i32=0;
  while(i<nf){link_edge(W,m,1,get32(facts,i*4),0); i=i+1;}
  ev_teach_in(W,s,r,ans);
  return m;
}
// keepers from the frozen base (verbatim): gather helpers and standing.
fn inc_fill(W:[]u8,s:i32,out:[]u8)i32 {
  let nr:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s){
      let r:i32=ng(W,n,24); let k:i32=0; let f:i32=0;
      while(k<nr){if(get32(out,k*4)==r){f=1;} k=k+1;}
      if(f==0){set32(out,nr*4,r); nr=nr+1;}
    }
    n=n+1;
  }
  return nr;
}
fn comb_present(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==8){return n;}
    n=n+1;
  }
  return -1;
}
fn popcnt(x:i32)i32 {
  let c:i32=0; while(x>0){c=c+(x&1); x=x>>1;} return c;
}

fn t2_trial(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,dc:i32,di:i32)i32 {
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let ans:i32=-2;
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,s,paths);
  if(dc==0){
    let k:i32=2;
    while(k<=4 && ans==-2){
      let p:i32=0;
      while(p<np && ans==-2){
        let base:i32=p*48;
        if(get32(paths,base)==k+1){
          let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
          let j:i32=0;
          while(j<=k){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
          j=0;
          while(j<k){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
          let root:i32=t2_asm_chain(W,v,k+1,f);
          ls(W,0,4,lg(W,0,4)+1); // INSTR: chain-branch verify
          let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
          if(v2!=-2){promote_graph(W,root,s,r,v2,f,k); ans=v2;}
        }
        p=p+1;
      }
      k=k+1;
    }
  }
  if(ans==-2 && comb_present(W)>=0){
    let vals:[]u8=z_alloc(48); let sf:[]u8=z_alloc(48);
    let m:i32=t2_gather_sum(W,s,vals,sf);
    let sz:i32=m;
    while(sz>=1 && ans==-2){
      let mask:i32=(1<<m)-1;
      while(mask>0 && ans==-2){
        if(popcnt(mask)==sz){
          let sv:[]u8=z_alloc(48); let ff:[]u8=z_alloc(48);
          let c:i32=0; let b:i32=0;
          while(b<m){
            if(((mask>>b)&1)==1){set32(sv,c*4,get32(vals,b*4)); set32(ff,c*4,get32(sf,b*4)); c=c+1;}
            b=b+1;
          }
          let root:i32=t2_asm_sum(W,sv,c);
          ls(W,0,8,lg(W,0,8)+1); // INSTR: sum-branch verify
          let v2:i32=t2_try_verify(W,root,0,expected,masked,st);
          if(v2!=-2){promote_graph(W,root,s,r,v2,ff,c); ans=v2;}
        }
        mask=mask-1;
      }
      sz=sz-1;
    }
  }
  if(ans==-2 && di==0){
    let rb:[]u8=z_alloc(64); let nr:i32=t2_rels(W,s,rb);
    let i:i32=0;
    while(i<nr && ans==-2){
      let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
      let len:i32=t2_chain(W,s,get32(rb,i*4),v,f);
      if(len>=2){
        let root:i32=t2_asm_count(W,v,len,f);
        ls(W,0,12,lg(W,0,12)+1); // INSTR: count-branch verify
        let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
        if(v2!=-2){promote_graph(W,root,s,r,v2,f,len-1); ans=v2;}
      }
      i=i+1;
    }
  }
  if(ans==-2){
    let p:i32=0;
    while(p<np && ans==-2){
      let base:i32=p*48;
      if(get32(paths,base)==2){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(f,0,get32(paths,base+24));
        let root:i32=t2_asm_chain(W,v,2,f);
        ls(W,0,16,lg(W,0,16)+1); // INSTR: hop-branch verify
        let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
        if(v2!=-2){promote_graph(W,root,s,r,v2,f,1); ans=v2;}
      }
      p=p+1;
    }
  }
  hs(W,16,get32(st,0)*1024+get32(st,4));
  return ans;
}
// mp_run: trial-based miss policy (Change 1). E-ruling preserved.
fn mp_run(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  let masked:i32=flags&1; let dc:i32=(flags>>1)&1; let di:i32=(flags>>2)&1;
  return t2_trial(W,s,r,expected,masked,dc,di);
}
// ============ Change 3: generic revision over 4-op executable graphs ============
// On a counterexample (ev_observe contradicts a fact that licenses a graph
// link), the stale step is removed and a corrected step inserted; the
// restructured graph is re-executed and only kept on verification success.
// Topology change, not standing demotion: no CON edge touches the MAP.

fn k_get(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==903){return ng(W,n,20);}
    n=n+1;
  }
  let kn:i32=alloc_node(W); if(kn<0){return 3;}
  ns(W,kn,0,903); write_node(W,kn,3,0,0,0);
  link_edge(W,kn,9,kn,hg(W,4)); return 3;
}
fn bootstrap_miss(W:[]u8,s:i32,r:i32)i32 {
  let ex_o:[]u8=z_alloc(24); let cnt:i32=0; let n:i32=1023;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r){
      set32(ex_o,cnt*4,ng(W,n,28)); cnt=cnt+1;
    }
    n=n-1;
  }
  if(cnt<2){return -2;}
  let v0:i32=get32(ex_o,0); let inv:i32=1; let i:i32=1;
  while(i<cnt){if(get32(ex_o,i*4)!=v0){inv=0;} i=i+1;}
  if(inv==1){
    let k:i32=k_get(W);
    if(cnt>=k){
      let m:i32=alloc_node(W);
      if(m>=2){
        ns(W,m,0,20); write_node(W,m,0,hg(W,24),0,0);
        link_edge(W,m,13,m,hg(W,0));
        i=0; while(i<cnt){link_edge(W,m,2,m,0); i=i+1;}
        link_edge(W,m,6,m,0);
        ev_teach_in(W,s,r,v0); return v0;
      }
    }
  }
  return -2;
}
// ============ Change 2: miss -> UNCERTAINTY -> guide -> POLICY_ROOT ============
// Integrates the validated inquiry mechanism (commit 18ed3331c): Piece A
// reifies the admission as an UNCERTAINTY node in persistent learner state;
// Piece B constructs a guide linked to POLICY_ROOT. ev_act then selects over
// learner-constructed guides. Existing node/edge types only; no new modes.
// Called from ev_query's cognition path on a true miss.
fn miss_inquire(W:[]u8,s:i32,r:i32)void {
  let u:i32=alloc_node(W); if(u<0){return;}
  ns(W,u,0,30);
  ns(W,u,4,-4);
  write_node(W,u,s,r,2,0);
  let pr:i32=pol_get(W);
  if(pr<2){
    pr=alloc_node(W); if(pr<0){return;}
    ns(W,pr,0,2); ns(W,pr,4,-5);
    pol_set(W,pr);
  }
  let g:i32=alloc_node(W); if(g<0){return;}
  ns(W,g,0,1); ns(W,g,4,s);
  write_node(W,g,30,-999,0,0);
  link_edge(W,g,1,u,0);
  link_edge(W,pr,10,g,0);
  return;
}
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let recent:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop first (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

fn tnn2_init(W:[]u8)void {
  let i:i32=0;
  while(i<110656){W[i]=0; i=i+1;}
  let e:i32=0;
  while(e<4096){es(W,e,0,-1); e=e+1;}
  ns(W,0,36,1); ns(W,0,0,900); write_node(W,0,-1,0,0,0);
  ns(W,1,36,1); ns(W,1,0,901); write_node(W,1,-1,0,0,0);
  hs(W,0,0); hs(W,4,12); hs(W,8,2); hs(W,12,-1); hs(W,16,0);
  hs(W,20,0); hs(W,24,0); hs(W,28,0);
  hs(W,32,-1); hs(W,36,-1); hs(W,40,-1); hs(W,44,-1); hs(W,48,0);
  return;
}
fn pol_get(W:[]u8)i32 { return ng(W,0,20); }
fn pol_set(W:[]u8,v:i32)void { ns(W,0,20,v); return; }
fn mp_get(W:[]u8)i32 { return ng(W,1,20); }
fn mp_set(W:[]u8,v:i32)void { ns(W,1,20,v); return; }


// ============ driver: replicate transfer T_A phase, instrumented ============
// World A training table (start, delta, len) x24, verbatim from
// TRANSFER_REFREEZE_PREREG.md section 3.
fn tab_st(k:i32)i32 {
  if(k==0){return 3;} if(k==1){return 14;} if(k==2){return -5;}
  if(k==3){return 22;} if(k==4){return 40;} if(k==5){return 2;}
  if(k==6){return -11;} if(k==7){return 30;} if(k==8){return 8;}
  if(k==9){return 20;} if(k==10){return 5;} if(k==11){return -3;}
  if(k==12){return 33;} if(k==13){return 1;} if(k==14){return -20;}
  if(k==15){return 15;} if(k==16){return 50;} if(k==17){return 12;}
  if(k==18){return -15;} if(k==19){return 7;} if(k==20){return -8;}
  if(k==21){return 19;} if(k==22){return 26;} return 13;
}
fn tab_c(k:i32)i32 {
  if(k<5){return 3;} if(k<9){return 7;} if(k<13){return -4;}
  if(k<16){return 12;} if(k<19){return -9;} return 5;
}
fn tab_l(k:i32)i32 {
  if(k==0){return 5;} if(k==1){return 6;} if(k==2){return 7;}
  if(k==3){return 5;} if(k==4){return 6;} if(k==5){return 5;}
  if(k==6){return 6;} if(k==7){return 7;} if(k==8){return 5;}
  if(k==9){return 5;} if(k==10){return 6;} if(k==11){return 7;}
  if(k==12){return 5;} if(k==13){return 5;} if(k==14){return 6;}
  if(k==15){return 7;} if(k==16){return 5;} if(k==17){return 6;}
  if(k==18){return 7;} if(k==19){return 5;} if(k==20){return 6;}
  if(k==21){return 7;} if(k==22){return 5;} return 6;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(p<e && d[p]==45){neg=1; p=p+1;}
  while(p<e){v=v*10+(d[p] as i32-48); p=p+1;}
  if(neg==1){v=0-v;}
  return v;
}
// novel-(s,r) specialization of ev_observe: every transfer T_A observe is a
// novel (subject, relation) pair, so activate always misses and the observe
// path is exactly clock+decay+ctx+activate-scan+ev_teach_in.
fn do_observe(W:[]u8,s:i32,r:i32,o:i32)void {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){emit("UNEXPECTED-HIT\n");}
  ev_teach_in(W,s,r,o);
  return;
}
// snapshot the 10 write-only counters into p (10 i32 slots)
fn snap(W:[]u8,p:[]u8)void {
  set32(p,0,hg(W,52)); set32(p,4,hg(W,56)); set32(p,8,hg(W,60));
  set32(p,12,lg(W,0,0)); set32(p,16,lg(W,0,4)); set32(p,20,lg(W,0,8));
  set32(p,24,lg(W,0,12)); set32(p,28,lg(W,0,16)); set32(p,32,lg(W,0,20));
  set32(p,36,lg(W,0,24));
  return;
}
fn plab(s:[]u8)void { emit(s); return; }
fn pnum(v:i32)void { emit(" "); e64(v); return; }
// true live-node count (hg(W,20) is gross allocs; freed trial nodes reuse
// slots but do not decrement it, and no logic reads it)
fn live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){if(ng(W,n,36)==1){c=c+1;} n=n+1;}
  return c;
}
// ============ S4 outcome dumpers (index-independent) ============
fn dump_maps(W:[]u8)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20){
      plab("MAP s="); e64(ng(W,n,8)); plab(" r="); e64(ng(W,n,4));
      plab(" ans="); e64(ng(W,n,28));
      let dc:i32=0; let e:i32=0;
      while(e<4096){
        if(eg(W,e,0)==n && eg(W,e,4)==1){dc=dc+1;}
        e=e+1;
      }
      plab(" deps="); e64(dc);
      let sig:[]u8=z_alloc(256);
      let nsig:i32=t2_sig(W,ng(W,n,20),sig);
      plab(" sigcells="); e64(nsig); plab(" sig=");
      let i:i32=0;
      while(i<nsig){
        e64(get32(sig,i*8)); emit(":"); e64(get32(sig,i*8+4));
        if(i<nsig-1){emit(",");}
        i=i+1;
      }
      emit("\n");
    }
    n=n+1;
  }
  return;
}
fn dump_taught(W:[]u8,s:i32,r:i32,o:i32)void {
  let f:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){f=1;}
    n=n+1;
  }
  plab("TAUGHT s="); e64(s); plab(" r="); e64(r); plab(" o="); e64(o);
  plab(" found="); e64(f); emit("\n");
  return;
}
// S4(i): sum-branch success, t_p2 pattern. mode 0=orig, 1=reclaim.
fn s4sum_one(mode:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  do_observe(W,110,31,10); do_observe(W,110,32,20); do_observe(W,110,33,30);
  let cn:i32=alloc_node(W); ns(W,cn,0,8); write_node(W,cn,1,0,0,0);
  let ans:i32=0;
  if(mode==1){ans=ev_query_r(W,110,41,60,0);} else {ans=ev_query(W,110,41,60,0);}
  let tr:i32=hg(W,16)/1024;
  plab("S4SUM mode="); e64(mode); plab(" ans="); e64(ans);
  plab(" tried="); e64(tr); plab(" rej="); e64(hg(W,16)-tr*1024);
  plab(" evict="); e64(hg(W,56)); emit("\n");
  dump_maps(W);
  dump_taught(W,110,41,60);
  plab("NODES nodes="); e64(hg(W,20)); plab(" edges="); e64(hg(W,24)); emit("\n");
  return;
}
// S4(ii): chain-branch success, t_p1/t_f2 pattern. masked 0/1.
fn s4chain_one(mode:i32,masked:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  do_observe(W,101,11,102); do_observe(W,101,12,105);
  do_observe(W,102,12,201); do_observe(W,105,11,202);
  let exp:i32=201; let fl:i32=0;
  if(masked==1){exp=202; fl=1;}
  let ans:i32=0;
  if(mode==1){ans=ev_query_r(W,101,40,exp,fl);} else {ans=ev_query(W,101,40,exp,fl);}
  let tr:i32=hg(W,16)/1024;
  plab("S4CHAIN mode="); e64(mode); plab(" masked="); e64(masked);
  plab(" ans="); e64(ans);
  plab(" tried="); e64(tr); plab(" rej="); e64(hg(W,16)-tr*1024);
  plab(" evict="); e64(hg(W,56)); emit("\n");
  dump_maps(W);
  dump_taught(W,101,40,ans);
  plab("NODES nodes="); e64(hg(W,20)); plab(" edges="); e64(hg(W,24)); emit("\n");
  return;
}
fn main()i32 {
  if(_zag_argc()<2){emit("usage: trialwall_bin <maxstep> [o|r] | s4sum | s4chain\n"); return 2;}
  let a:[]u8=_zag_arg(1);
  let alen:i32=_zag_strlen(a);
  if(alen==5 && a[0]==115){s4sum_one(0); s4sum_one(1); return 0;}
  if(alen==7 && a[0]==115){
    s4chain_one(0,0); s4chain_one(1,0); s4chain_one(0,1); s4chain_one(1,1);
    return 0;
  }
  let maxstep:i32=parse_i32(a,0,alen);
  if(maxstep<0){maxstep=0;} if(maxstep>23){maxstep=23;}
  let mode:i32=0;
  if(_zag_argc()>=3){
    let m:[]u8=_zag_arg(2);
    if(_zag_strlen(m)>=1 && m[0]==114){mode=1;}
  }
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let prev:[]u8=z_alloc(40);
  let k:i32=0;
  while(k<=maxstep){
    snap(W,prev);
    let S:i32=1001+k;
    let st0:i32=tab_st(k); let cc:i32=tab_c(k); let L:i32=tab_l(k);
    let j:i32=0;
    while(j<L-1){do_observe(W,S,11+j,st0+cc*j); j=j+1;}
    let expected:i32=st0+cc*(L-1);
    let ans:i32=0;
    if(mode==1){ans=ev_query_r(W,S,20,expected,0);} else {ans=ev_query(W,S,20,expected,0);}
    do_observe(W,S,20,expected);
    let tr:i32=hg(W,16)/1024; let rj:i32=hg(W,16)-tr*1024;
    plab("STEP k="); e64(k);
    plab(" ans="); e64(ans);
    plab(" tried="); e64(tr); plab(" rej="); e64(rj);
    pnum(hg(W,52)-get32(prev,0)); plab("=d_alloc");
    pnum(hg(W,56)-get32(prev,4)); plab("=d_evict");
    pnum(hg(W,60)-get32(prev,8)); plab("=d_link");
    pnum(lg(W,0,0)-get32(prev,12)); plab("=d_exec");
    pnum(lg(W,0,4)-get32(prev,16)); plab("=d_chainv");
    pnum(lg(W,0,8)-get32(prev,20)); plab("=d_sumv");
    pnum(lg(W,0,12)-get32(prev,24)); plab("=d_countv");
    pnum(lg(W,0,16)-get32(prev,28)); plab("=d_hopv");
    pnum(lg(W,0,20)-get32(prev,32)); plab("=d_sumcells");
    pnum(lg(W,0,24)-get32(prev,36)); plab("=d_paths");
    plab(" nodes="); e64(hg(W,20)); plab(" live="); e64(live_count(W));
    plab(" edges="); e64(hg(W,24));
    emit("\n");
    k=k+1;
  }
  return 0;
}
// t2_sig: graph signature for revision tests (verbatim from tnn2.zag).
// Walk SEQ + BRANCHEQ true-targets, record (tag, literal) per cell.
fn t2_sig(W:[]u8,root:i32,sig:[]u8)i32 {
  let n:i32=0; let cur:i32=root; let ok:i32=1;
  while(cur>=0 && n<32 && ok==1){
    let tag:i32=ng(W,cur,0);
    if(tag!=101 && tag!=102 && tag!=103 && tag!=104){ok=0;}
    else {
      set32(sig,n*8,tag);
      let lv:i32=0;
      if(tag==101 || tag==102){
        let ln:i32=ng(W,cur,8);
        if(ln>=0 && ln<1024){lv=ng(W,ln,20);}
      }
      set32(sig,n*8+4,lv);
      n=n+1;
      if(tag==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    }
  }
  return n;
}
// ============ RECLAIM variants: eager reclamation of dead trial graphs ====
// Approach (frozen in PREREG_TRIALWALL.md): every workspace node allocated
// for a trial candidate is recorded in a per-candidate allocation log (host
// buffer). On reject, exactly those nodes are freed and one O(4096) edge
// sweep kills edges with a dead endpoint. The scratch execute frame is
// freed inside t2_exec_r. No ISA change, no new opcodes/modes, search order
// and verify outcomes untouched.
fn log_add(log:[]u8,n:i32)void {
  if(n<2){return;}
  let c:i32=get32(log,0);
  set32(log,4+c*4,n);
  set32(log,0,c+1);
  return;
}
fn trial_free_log(W:[]u8,log:[]u8)void {
  let c:i32=get32(log,0); let i:i32=0;
  while(i<c){ns(W,get32(log,4+i*4),36,0); i=i+1;}
  return;
}
// kill every edge with a dead endpoint. Only called right after freeing
// exactly the logged trial nodes, so no live structure loses an edge.
fn trial_sweep_edges(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      let a:i32=eg(W,e,0); let b:i32=eg(W,e,8);
      let la:i32=0; let lb:i32=0;
      if(a>=2 && a<1024 && ng(W,a,36)==1){la=1;}
      if(b>=2 && b<1024 && ng(W,b,36)==1){lb=1;}
      if(a<2 && a>=0){la=1;}
      if(b<2 && b>=0){lb=1;}
      if(la==0 || lb==0){es(W,e,0,-1); hs(W,24,hg(W,24)-1);}
    }
    e=e+1;
  }
  return;
}
fn t2_cell_r(W:[]u8,tag:i32,log:[]u8)i32 {
  let c:i32=alloc_node(W); if(c<0){return -1;}
  ns(W,c,0,tag); log_add(log,c); return c;
}
fn t2_lit_r(W:[]u8,v:i32,log:[]u8)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,902); ns(W,n,20,v); log_add(log,n); return n;
}
fn t2_guard_r(W:[]u8,slot:i32,litx:i32,log:[]u8)i32 {
  let g:i32=t2_cell_r(W,102,log); if(g<0){return -1;}
  ns(W,g,4,1000+slot); ns(W,g,8,litx); return g;
}
fn t2_set_r(W:[]u8,slot:i32,lity:i32,log:[]u8)i32 {
  let s:i32=t2_cell_r(W,101,log); if(s<0){return -1;}
  ns(W,s,4,1000+slot); ns(W,s,8,lity); return s;
}
fn t2_mov_r(W:[]u8,dst:i32,src:i32,log:[]u8)i32 {
  let c:i32=t2_cell_r(W,101,log); if(c<0){return -1;}
  ns(W,c,4,1000+dst); ns(W,c,8,1000+src); return c;
}
fn t2_inc_r(W:[]u8,slot:i32,log:[]u8)i32 {
  let c:i32=t2_cell_r(W,103,log); if(c<0){return -1;}
  ns(W,c,4,1000+slot); return c;
}
// reclaim assemblers: verbatim logic, logging builders. On mid-build alloc
// failure the partial graph is freed and its edges swept (unreachable in
// practice: reclaim keeps the table far from full, so alloc never fails).
fn t2_asm_chain_r(W:[]u8,v:[]u8,plen:i32,f:[]u8,log:[]u8)i32 {
  let root:i32=-1; let prev:i32=-1; let j:i32=0;
  while(j<plen-1){
    let lx:i32=t2_lit_r(W,get32(v,j*4),log); if(lx<0){trial_free_log(W,log); trial_sweep_edges(W); return -1;}
    let ly:i32=t2_lit_r(W,get32(v,(j+1)*4),log); if(ly<0){trial_free_log(W,log); trial_sweep_edges(W); return -1;}
    let g:i32=t2_guard_r(W,0,lx,log); if(g<0){trial_free_log(W,log); trial_sweep_edges(W); return -1;}
    let st:i32=t2_set_r(W,0,ly,log); if(st<0){trial_free_log(W,log); trial_sweep_edges(W); return -1;}
    ns(W,g,12,st);
    link_edge(W,st,1,get32(f,j*4),0);
    if(prev>=0){seq_link(W,prev,g);} else {root=g;}
    prev=st; j=j+1;
  }
  return root;
}
fn t2_asm_count_r(W:[]u8,v:[]u8,plen:i32,f:[]u8,log:[]u8)i32 {
  let root:i32=-1; let prev:i32=-1; let j:i32=0;
  while(j<plen-1){
    let lx:i32=t2_lit_r(W,get32(v,j*4),log); if(lx<0){trial_free_log(W,log); trial_sweep_edges(W); return -1;}
    let ly:i32=t2_lit_r(W,get32(v,(j+1)*4),log); if(ly<0){trial_free_log(W,log); trial_sweep_edges(W); return -1;}
    let g:i32=t2_guard_r(W,0,lx,log); if(g<0){trial_free_log(W,log); trial_sweep_edges(W); return -1;}
    let st:i32=t2_set_r(W,0,ly,log); if(st<0){trial_free_log(W,log); trial_sweep_edges(W); return -1;}
    let ic:i32=t2_inc_r(W,1,log); if(ic<0){trial_free_log(W,log); trial_sweep_edges(W); return -1;}
    ns(W,g,12,st);
    link_edge(W,st,1,get32(f,j*4),0);
    seq_link(W,st,ic);
    if(prev>=0){seq_link(W,prev,g);} else {root=g;}
    prev=ic; j=j+1;
  }
  let mv:i32=t2_mov_r(W,0,1,log); if(mv<0){trial_free_log(W,log); trial_sweep_edges(W); return -1;}
  seq_link(W,prev,mv);
  return root;
}
fn t2_asm_sum_r(W:[]u8,vals:[]u8,n:i32,log:[]u8)i32 {
  let total:i32=0; let i:i32=0;
  while(i<n){total=total+get32(vals,i*4); i=i+1;}
  if(total<=0 || total>900){return -1;}
  let root:i32=-1; let prev:i32=-1;
  i=0;
  while(i<total){
    let c:i32=t2_inc_r(W,0,log); if(c<0){trial_free_log(W,log); trial_sweep_edges(W); return -1;}
    if(prev>=0){seq_link(W,prev,c);} else {root=c;}
    prev=c; i=i+1;
  }
  return root;
}
// t2_exec_r: verbatim execute, then reclaim the scratch frame.
fn t2_exec_r(W:[]u8,root:i32,s0:i32)i32 {
  if(root<0){return -999999;}
  let fr:i32=alloc_node(W); if(fr<0){return -999999;}
  ns(W,fr,0,902); fr_set(W,fr,0,s0); fr_set(W,fr,1,0);
  let ok:i32=execute(W,root,fr);
  let r:i32=-999999;
  if(ok==1){r=res_op(W,fr,ng(W,root,4));}
  ns(W,fr,36,0);
  return r;
}
// t2_try_verify_r: verbatim verify; on reject, free exactly the logged
// candidate nodes and sweep dead-endpoint edges.
fn t2_try_verify_r(W:[]u8,root:i32,s0:i32,expected:i32,masked:i32,st:[]u8,log:[]u8)i32 {
  if(root<0){return -2;}
  set32(st,0,get32(st,0)+1);
  let v:i32=t2_exec_r(W,root,s0);
  if(masked==1){
    if(v!=-2 && v!=-999999){return v;}
  } else {
    if(expected!=-2 && v==expected){return v;}
  }
  trial_free_log(W,log);
  trial_sweep_edges(W);
  set32(st,4,get32(st,4)+1);
  return -2;
}
// t2_trial_r: verbatim search order over reclaim assemblers.
fn t2_trial_r(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,dc:i32,di:i32)i32 {
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let ans:i32=-2;
  let log:[]u8=z_alloc(4096);
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,s,paths);
  if(dc==0){
    let k:i32=2;
    while(k<=4 && ans==-2){
      let p:i32=0;
      while(p<np && ans==-2){
        let base:i32=p*48;
        if(get32(paths,base)==k+1){
          let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
          let j:i32=0;
          while(j<=k){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
          j=0;
          while(j<k){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
          set32(log,0,0);
          let root:i32=t2_asm_chain_r(W,v,k+1,f,log);
          ls(W,0,4,lg(W,0,4)+1); // INSTR: chain-branch verify
          let v2:i32=t2_try_verify_r(W,root,s,expected,masked,st,log);
          if(v2!=-2){promote_graph(W,root,s,r,v2,f,k); ans=v2;}
        }
        p=p+1;
      }
      k=k+1;
    }
  }
  if(ans==-2 && comb_present(W)>=0){
    let vals:[]u8=z_alloc(48); let sf:[]u8=z_alloc(48);
    let m:i32=t2_gather_sum(W,s,vals,sf);
    let sz:i32=m;
    while(sz>=1 && ans==-2){
      let mask:i32=(1<<m)-1;
      while(mask>0 && ans==-2){
        if(popcnt(mask)==sz){
          let sv:[]u8=z_alloc(48); let ff:[]u8=z_alloc(48);
          let c:i32=0; let b:i32=0;
          while(b<m){
            if(((mask>>b)&1)==1){set32(sv,c*4,get32(vals,b*4)); set32(ff,c*4,get32(sf,b*4)); c=c+1;}
            b=b+1;
          }
          set32(log,0,0);
          let root:i32=t2_asm_sum_r(W,sv,c,log);
          ls(W,0,8,lg(W,0,8)+1); // INSTR: sum-branch verify
          let v2:i32=t2_try_verify_r(W,root,0,expected,masked,st,log);
          if(v2!=-2){promote_graph(W,root,s,r,v2,ff,c); ans=v2;}
        }
        mask=mask-1;
      }
      sz=sz-1;
    }
  }
  if(ans==-2 && di==0){
    let rb:[]u8=z_alloc(64); let nr:i32=t2_rels(W,s,rb);
    let i:i32=0;
    while(i<nr && ans==-2){
      let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
      let len:i32=t2_chain(W,s,get32(rb,i*4),v,f);
      if(len>=2){
        set32(log,0,0);
        let root:i32=t2_asm_count_r(W,v,len,f,log);
        ls(W,0,12,lg(W,0,12)+1); // INSTR: count-branch verify
        let v2:i32=t2_try_verify_r(W,root,s,expected,masked,st,log);
        if(v2!=-2){promote_graph(W,root,s,r,v2,f,len-1); ans=v2;}
      }
      i=i+1;
    }
  }
  if(ans==-2){
    let p:i32=0;
    while(p<np && ans==-2){
      let base:i32=p*48;
      if(get32(paths,base)==2){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(f,0,get32(paths,base+24));
        set32(log,0,0);
        let root:i32=t2_asm_chain_r(W,v,2,f,log);
        ls(W,0,16,lg(W,0,16)+1); // INSTR: hop-branch verify
        let v2:i32=t2_try_verify_r(W,root,s,expected,masked,st,log);
        if(v2!=-2){promote_graph(W,root,s,r,v2,f,1); ans=v2;}
      }
      p=p+1;
    }
  }
  hs(W,16,get32(st,0)*1024+get32(st,4));
  return ans;
}
fn mp_run_r(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  let masked:i32=flags&1; let dc:i32=(flags>>1)&1; let di:i32=(flags>>2)&1;
  return t2_trial_r(W,s,r,expected,masked,dc,di);
}
// ev_query_r: verbatim ev_query with the reclaim miss policy.
fn ev_query_r(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    return ng(W,n,28);
  }
  let recent:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run_r(W,s,r,expected,flags);
  if(ans!=-2){return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){return bv;}
  miss_inquire(W,s,r);
  return -2;
}

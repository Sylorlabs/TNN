// c9fix_check.zag: validation tool for the C9FIX world generator (pure Zag).
// Usage: c9fix_check <worlddir>
// Reads turns.jsonl, battery.json, answer_key.json from worlddir.
// Checks (per PREREG_C9GENFIX.md):
//   G2: 12 {"t":"c"} obs turns, at least one with a variable disagreement.
//   G3: exactly 80 {"t":"do"} and 80 {"t":"do_out"} expo turns; each do_out
//       immediately follows its do turn; the intervened var is fixed to val.
//   G4: 3 C9 items; keys are full chain strings (len > 1); the true chain
//       is not always listed first; the old format exploit (first
//       candidate, first variable) scores 0/3.
//   G5: the C9BAT two-stage interventional protocol (HI=0.75, integer
//       arithmetic, reads only the turn stream) recovers the true chain
//       on all 3 items.
// Prints a report; exits 0 iff all checks pass, 1 otherwise.
// NOTE: this tool reads answer_key.json SOLELY to compare (it is a
// validator). The part-A contestant mechanism never opens the key.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let b:[]u8=z_alloc(24);
  let at:i32=0;
  if(v<0){b[0]=45;at=1;v=-v;}
  let d:[]u8=z_alloc(24); let nd:i32=0;
  if(v==0){d[0]=48;nd=1;}
  while(v>0){d[nd]=((v%10) as u8)+48;nd=nd+1;v=v/10;}
  let k:i32=nd-1;
  while(k>=0){b[at]=d[k];at=at+1;k=k-1;}
  z_free(d);
  return b[0..at];
}
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(b[i]!=0){i=i+1;} return i; }
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  let i:i32=from;
  while(i+needle.len<=hay.len){
    let k:i32=0; let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let i:i32=0;
  while(i<s.len){b[i]=s[i];i=i+1;}
  b[s.len]=0;
  return b;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=4194304;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=0;
  let i:i32=0;
  while(i<dir.len){b[at]=dir[i];at=at+1;i=i+1;}
  b[at]=47;at=at+1;
  i=0;
  while(i<name.len){b[at]=name[i];at=at+1;i=i+1;}
  return b[0..at];
}
// read one digit (0/1) after a marker like "\"x\":"
fn pdig(line:[]u8,mark:[]u8)i32 {
  let p:i32=findsub(line,0,mark);
  if(p<0){return -1;}
  let q:i32=p+mark.len;
  if(q>=line.len){return -1;}
  return (line[q] as i32)-48;
}
// variable index from name char: X->0, Y->1, Z->2
fn varidx(c:u8)i32 {
  if(c==88){return 0;}
  if(c==89){return 1;}
  return 2;
}
// build chain string "X->Y->Z" from (r,m,l) into out; returns length
fn chainstr(r:i32,m:i32,l:i32,out:[]u8)i32 {
  let at:i32=0;
  let vs:[]u8=z_alloc(3); vs[0]=88;vs[1]=89;vs[2]=90;
  out[0]=vs[r];out[1]=45;out[2]=62;out[3]=vs[m];out[4]=45;out[5]=62;out[6]=vs[l];
  at=7;
  z_free(vs);
  return at;
}

fn main()i32 {
  let wd:[]u8=_zag_arg(1);
  let td:[]u8=read_file(pjoin(wd,"turns.jsonl"));
  let bat:[]u8=read_file(pjoin(wd,"battery.json"));
  let ak:[]u8=read_file(pjoin(wd,"answer_key.json"));
  let fail:i32=0;

  // ---- parse turns ----
  let nobs:i32=0; let obsdis:i32=0;
  let ndo:i32=0; let ndout:i32=0;
  let pend:i32=0; let pvar:i32=-1; let pval:i32=-1;
  let pairfail:i32=0;
  // intervention stats: do(X): n, y==v, z==v ; do(Z): n, y==v, x==v
  let nX:i32=0; let ayX:i32=0; let azX:i32=0;
  let nZ:i32=0; let ayZ:i32=0; let axZ:i32=0;
  // C9 questions from test turns
  let c9q:[]u8=z_alloc(3*64); let nc9q:i32=0;
  let lp:i32=0;
  while(lp<td.len){
    let le:i32=lp;
    while(le<td.len && td[le]!=10){le=le+1;}
    let line:[]u8=td[lp..le];
    if(findsub(line,0,"\"t\":\"c\",\"x\":")>=0){
      let x:i32=pdig(line,"\"x\":"); let y:i32=pdig(line,"\"y\":"); let z:i32=pdig(line,"\"z\":");
      nobs=nobs+1;
      if(x!=y || y!=z){obsdis=obsdis+1;}
    }
    if(findsub(line,0,"\"t\":\"do\",\"var\":")>=0){
      let p:i32=findsub(line,0,"\"var\":\"")+7;
      let vc:u8=line[p];
      pval=pdig(line,"\"val\":");
      pvar=varidx(vc);
      pend=1;
      ndo=ndo+1;
    }
    if(findsub(line,0,"\"t\":\"do_out\"")>=0){
      ndout=ndout+1;
      if(pend!=1){pairfail=1;}
      else {
        let x:i32=pdig(line,"\"x\":"); let y:i32=pdig(line,"\"y\":"); let z:i32=pdig(line,"\"z\":");
        let iv:i32=-1;
        if(pvar==0){iv=x;}
        if(pvar==2){iv=z;}
        if(iv!=pval){pairfail=1;}
        if(pvar==0){ nX=nX+1; if(y==pval){ayX=ayX+1;} if(z==pval){azX=azX+1;} }
        if(pvar==2){ nZ=nZ+1; if(y==pval){ayZ=ayZ+1;} if(x==pval){axZ=axZ+1;} }
        pend=0;
      }
    }
    if(findsub(line,0,"\"kind\":\"test\"")>=0 && findsub(line,0,"\"cap\":9")>=0){
      let p:i32=findsub(line,0,"\"q\":\"")+5;
      let e2:i32=p;
      while(e2<line.len && line[e2]!=34){e2=e2+1;}
      let q:[]u8=line[p..e2];
      let k:i32=0;
      while(k<q.len && k<63){c9q[nc9q*64+k]=q[k];k=k+1;}
      c9q[nc9q*64+k]=0;
      nc9q=nc9q+1;
    }
    lp=le+1;
  }

  emit("c9fix_check report\n");
  let ib:[]u8=i64s(nobs as i64); emit("obs_turns="); emit(ib); emit("\n");
  ib=i64s(obsdis as i64); emit("obs_disagree="); emit(ib); emit("\n");
  if(nobs!=12){emit("G2 FAIL: nobs != 12\n");fail=1;}
  if(obsdis<1){emit("G2 FAIL: no noisy observation\n");fail=1;}
  if(fail==0){emit("G2 noise present: OK\n");}

  ib=i64s(ndo as i64); emit("do_turns="); emit(ib); emit("\n");
  ib=i64s(ndout as i64); emit("do_out_turns="); emit(ib); emit("\n");
  if(ndo!=80 || ndout!=80){emit("G3 FAIL: do/do_out count != 80/80\n");fail=1;}
  if(pairfail==1){emit("G3 FAIL: do/do_out pairing or fixed-var violated\n");fail=1;}
  if(pend==1){emit("G3 FAIL: dangling do without do_out\n");fail=1;}
  ib=i64s(nX as i64); emit("doX_n="); emit(ib); emit("\n");
  ib=i64s(nZ as i64); emit("doZ_n="); emit(ib); emit("\n");
  if(nX!=40 || nZ!=40){emit("G3 FAIL: per-variable do count != 40\n");fail=1;}

  // ---- parse battery: find C9 item indices ----
  let c9idx:[]u8=z_alloc(3*4); let nc9:i32=0;
  let p:i32=findsub(bat,0,"\"items\":[[");
  if(p<0){emit("battery parse failed\n");return 1;}
  p=p+10;
  let bi:i32=0;
  while(bi<68){
    while(p<bat.len && (bat[p]<48 || bat[p]>57)){p=p+1;}
    let cap:i32=0;
    while(p<bat.len && bat[p]>=48 && bat[p]<=57){cap=cap*10+(bat[p] as i32)-48;p=p+1;}
    p=findsub(bat,p,"\"")+1;
    let e2:i32=p;
    while(e2<bat.len && bat[e2]!=34){e2=e2+1;}
    if(cap==9){
      c9idx[nc9*4]=bi as u8; c9idx[nc9*4+1]=(bi>>8) as u8;
      c9idx[nc9*4+2]=(bi>>16) as u8; c9idx[nc9*4+3]=(bi>>24) as u8;
      nc9=nc9+1;
    }
    p=e2+1;
    bi=bi+1;
  }
  ib=i64s(nc9 as i64); emit("c9_items="); emit(ib); emit("\n");
  if(nc9!=3){emit("G4 FAIL: C9 item count != 3\n");fail=1;}
  if(nc9q!=3){emit("G4 FAIL: C9 test turns != 3\n");fail=1;}

  // ---- parse answers ----
  let aans:[]u8=z_alloc(68*128);
  p=findsub(ak,0,"\"answers\":[")+11;
  bi=0;
  while(bi<68){
    p=findsub(ak,p,"\"")+1;
    let e2:i32=p;
    while(e2<ak.len && ak[e2]!=34){e2=e2+1;}
    let q:[]u8=ak[p..e2];
    let k:i32=0;
    while(k<q.len && k<127){aans[bi*128+k]=q[k];k=k+1;}
    aans[bi*128+k]=0;
    p=e2+1;
    bi=bi+1;
  }

  // ---- G4: keys are full chain strings; order randomized; exploit 0/3 ----
  let firsttrue:i32=0;
  let exploit:i32=0;
  let qi:i32=0;
  while(qi<3){
    let idx:i32=(c9idx[qi*4] as i32)|((c9idx[qi*4+1] as i32)<<8)|((c9idx[qi*4+2] as i32)<<16)|((c9idx[qi*4+3] as i32)<<24);
    let key:[]u8=aans[idx*128..idx*128+slen(aans[idx*128..idx*128+128])];
    let qlen:i32=slen(c9q[qi*64..qi*64+64]);
    let g4q:[]u8=c9q[qi*64..qi*64+qlen];
    // g4q = discrim|<c1>|<c2>; split manually (avoid findsub call pattern)
    let s1:i32=-1; let s2:i32=-1;
    let sc:i32=0;
    while(sc<g4q.len){
      if(g4q[sc]==124){
        if(s1<0){s1=sc+1;} else { if(s2<0){s2=sc+1;} }
      }
      sc=sc+1;
    }
    let e1:i32=s2-1;
    let c1:[]u8=g4q[s1..e1];
    let c2:[]u8=g4q[s2..g4q.len];
    if(key.len<=1){emit("G4 FAIL: single-variable key\n");fail=1;}
    if(streq(key,c1)==1){firsttrue=firsttrue+1;}
    if(streq(key,c1)!=1 && streq(key,c2)!=1){emit("G4 FAIL: key not among candidates\n");fail=1;}
    // old exploit: first candidate's first variable
    let ex:[]u8=z_alloc(2); ex[0]=c1[0]; ex[1]=0;
    if(streq(ex[0..1],key)==1){exploit=exploit+1;}
    z_free(ex);
    emit("item "); ib=i64s(qi as i64); emit(ib);
    emit(" q="); emit(g4q); emit(" key="); emit(key); emit("\n");
    qi=qi+1;
  }
  ib=i64s(firsttrue as i64); emit("true_listed_first="); emit(ib); emit("/3\n");
  if(firsttrue==3){emit("G4 FAIL: true chain always listed first\n");fail=1;}
  ib=i64s(exploit as i64); emit("old_exploit_score="); emit(ib); emit("/3\n");
  if(exploit!=0){emit("G4 FAIL: old exploit scores > 0\n");fail=1;}

  // ---- G5: two-stage protocol (C9BAT section 5), HI=0.75, integer arithmetic ----
  let tXhi:i32=0; if(ayX*100>=75*nX){tXhi=1;}
  let tZhi:i32=0; if(ayZ*100>=75*nZ){tZhi=1;}
  ib=i64s(ayX as i64); emit("doX y==v: "); emit(ib); emit("/"); ib=i64s(nX as i64); emit(ib); emit("\n");
  ib=i64s(ayZ as i64); emit("doZ y==v: "); emit(ib); emit("/"); ib=i64s(nZ as i64); emit(ib); emit("\n");
  ib=i64s(azX as i64); emit("doX z==v: "); emit(ib); emit("/"); ib=i64s(nX as i64); emit(ib); emit("\n");
  ib=i64s(axZ as i64); emit("doZ x==v: "); emit(ib); emit("/"); ib=i64s(nZ as i64); emit(ib); emit("\n");
  let ir:i32=-1; let im:i32=-1; let il:i32=-1;
  if(tXhi==1 && tZhi==1){
    // Y leaf: X->Z->Y or Z->X->Y
    if(azX*nZ>axZ*nX){ir=0;im=2;il=1;}
    else { if(azX*nZ<axZ*nX){ir=2;im=0;il=1;} }
  } else {
    if(tXhi==0 && tZhi==0){
      // Y root: Y->X->Z or Y->Z->X
      if(azX*nZ>axZ*nX){ir=1;im=0;il=2;}
      else { if(azX*nZ<axZ*nX){ir=1;im=2;il=0;} }
    } else {
      // split: compare tX vs tZ
      if(ayX*nZ>ayZ*nX){ir=0;im=1;il=2;}
      else { if(ayX*nZ<ayZ*nX){ir=2;im=1;il=0;} }
    }
  }
  let recov:i32=0;
  if(ir>=0){
    let cs:[]u8=z_alloc(8);
    let csl:i32=chainstr(ir,im,il,cs);
    emit("inferred_chain="); emit(cs[0..csl]); emit("\n");
    qi=0;
    while(qi<3){
      let idx:i32=(c9idx[qi*4] as i32)|((c9idx[qi*4+1] as i32)<<8)|((c9idx[qi*4+2] as i32)<<16)|((c9idx[qi*4+3] as i32)<<24);
      let key:[]u8=aans[idx*128..idx*128+slen(aans[idx*128..idx*128+128])];
      if(streq(cs[0..csl],key)==1){recov=recov+1;}
      qi=qi+1;
    }
    z_free(cs);
  } else {
    emit("inferred_chain=UNKNOWN\n");
  }
  ib=i64s(recov as i64); emit("recovered="); emit(ib); emit("/3\n");
  if(recov!=3){emit("G5 FAIL: protocol did not recover 3/3\n");fail=1;}

  if(fail==0){emit("C9FIX CHECK: ALL PASS\n");return 0;}
  emit("C9FIX CHECK: FAIL\n");
  return 1;
}

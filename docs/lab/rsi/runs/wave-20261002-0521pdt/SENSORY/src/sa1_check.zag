// sa1_check.zag -- SA1 validity checker for kill bars B2 and red-team R2.
// argv: 1=src.wav 2=events.evt
// Recomputes the harmonic prediction h (same T0/plm procedure as the
// isolator), then reports: NEVT, B2(i) max|amp| vs source peak P,
// B2(ii) Pearson correlation between the event train and h,
// B2(iii) fraction of kept events with local contrast >= 10,
// R2 max|amp| / harmonic-RMS (kill if > 10).
@import("R33_NATIVE_IO_V1.zag")

fn d_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn d_get16(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    return b0 | (b1 << 8);
}
fn d_get32(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    let b2:i64 = m[o+2] as i64;
    let b3:i64 = m[o+3] as i64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}
fn d_get64(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    let b2:i64 = m[o+2] as i64;
    let b3:i64 = m[o+3] as i64;
    let b4:i64 = m[o+4] as i64;
    let b5:i64 = m[o+5] as i64;
    let b6:i64 = m[o+6] as i64;
    let b7:i64 = m[o+7] as i64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}
fn d_getf64(m:[]u8, o:i64) f64 {
    let f:[]f64 = m as []f64;
    return f[o / 8];
}
fn read_all(path:[]u8) []u8 {
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    if (fd < 0) { let e:[]u8 = nio_alloc(1); return e; }
    let msz:i64 = _zag_raw_syscall(8, fd, 0, 2, 0, 0, 0);
    _zag_raw_syscall(8, fd, 0, 0, 0, 0, 0);
    let m:[]u8 = nio_alloc(msz as i32);
    let at:i64 = 0;
    while (at < msz) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(m) as i64) + at, msz - at, 0, 0, 0);
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return m;
}
fn zsqrt(x:f64) f64 {
    if (x <= 0.0) { return 0.0; }
    let g:f64 = x / 2.0 + 1.0;
    let it:i64 = 0;
    while (it < 20) { g = (g + x / g) / 2.0; it = it + 1; }
    return g;
}
fn e1str(ob:[]u8, cur:i64, s:[]u8) i64 {
    let i:i64 = 0;
    let n:i64 = s.len as i64;
    while (i < n) { ob[cur] = s[i]; cur = cur + 1; i = i + 1; }
    return cur;
}
fn e1i64(ob:[]u8, cur:i64, v:i64) i64 {
    let u:i64 = v;
    if (v < 0) { ob[cur] = 45; cur = cur + 1; u = 0 - v; }
    let nd:i64 = 0;
    let t:i64 = u;
    if (t == 0) { nd = 1; } else { while (t > 0) { nd = nd + 1; t = t / 10; } }
    let p:i64 = cur + nd - 1;
    t = u;
    if (t == 0) { ob[p] = 48; }
    else { while (t > 0) { ob[p] = ((t % 10) + 48) as u8; t = t / 10; p = p - 1; } }
    cur = cur + nd;
    return cur;
}
fn e1f64(ob:[]u8, cur:i64, v:f64) i64 {
    if (v != v) { return e1str(ob, cur, "NaN"); }
    let d0:f64 = v - v;
    if (d0 != d0) {
        if (v > 0.0) { return e1str(ob, cur, "inf"); }
        return e1str(ob, cur, "-inf");
    }
    if (v < 0.0) { ob[cur] = 45; cur = cur + 1; v = 0.0 - v; }
    let ip:i64 = v as i64;
    cur = e1i64(ob, cur, ip);
    ob[cur] = 46; cur = cur + 1;
    let frac:f64 = v - (ip as f64);
    let k:i64 = 0;
    while (k < 6) {
        frac = frac * 10.0;
        let q:i64 = frac as i64;
        ob[cur] = (q + 48) as u8;
        cur = cur + 1;
        frac = frac - (q as f64);
        k = k + 1;
    }
    return cur;
}

fn main() void {
    let wpath:[]u8 = d_cstr(_zag_arg(1));
    let epath:[]u8 = d_cstr(_zag_arg(2));
    let ob:[]u8 = nio_alloc(4096);
    let cur:i64 = 0;

    // load wav
    let m:[]u8 = read_all(wpath);
    let mlen:i64 = m.len as i64;
    let data_off:i64 = -1;
    let data_len:i64 = 0;
    let o:i64 = 12;
    while (o + 8 <= mlen) {
        let cs:i64 = d_get32(m, o + 4);
        if (m[o] == 100 and m[o+1] == 97 and m[o+2] == 116 and m[o+3] == 97 and data_off < 0) {
            data_off = o + 8; data_len = cs;
        }
        o = o + 8 + cs;
    }
    if (data_off < 0) { _zag_print("sa1_check: no data\n"); return; }
    let n:i64 = data_len / 2;
    let xs:[]f64 = nio_alloc((n * 8) as i32) as []f64;
    let i:i64 = 0;
    while (i < n) {
        let s:i64 = d_get16(m, data_off + i * 2);
        if (s >= 32768) { s = s - 65536; }
        xs[i] = s as f64;
        i = i + 1;
    }
    let P:f64 = 0.0;
    i = 0;
    while (i < n) {
        let a:f64 = xs[i];
        if (a < 0.0) { a = 0.0 - a; }
        if (a > P) { P = a; }
        i = i + 1;
    }

    // T0 + phase-locked harmonic prediction h (same procedure as isolator)
    let B:f64 = 0.0;
    i = 500;
    while (i < n) { B = B + xs[i] * xs[i]; i = i + 4; }
    let best_lag:i64 = 0;
    let best_r:f64 = 0.0 - 1.0;
    let lag:i64 = 44;
    while (lag <= 500) {
        let A:f64 = 0.0;
        let C:f64 = 0.0;
        i = 500;
        while (i < n) {
            A = A + xs[i] * xs[i - lag];
            C = C + xs[i - lag] * xs[i - lag];
            i = i + 4;
        }
        let den:f64 = zsqrt(B * C);
        if (den > 0.0) {
            let rr:f64 = A / den;
            if (rr > best_r) { best_r = rr; best_lag = lag; }
        }
        lag = lag + 1;
    }
    let NBINS:i64 = best_lag;
    let h:[]f64 = nio_alloc((n * 8) as i32) as []f64;
    if (NBINS > 0) {
        let acc:[]f64 = nio_alloc((NBINS * 8) as i32) as []f64;
        let cnt:[]i64 = nio_alloc((NBINS * 8) as i32) as []i64;
        i = 0;
        while (i < NBINS) { acc[i] = 0.0; cnt[i] = 0; i = i + 1; }
        i = 0;
        while (i < n) {
            let b:i64 = i % NBINS;
            acc[b] = acc[b] + xs[i];
            cnt[b] = cnt[b] + 1;
            i = i + 1;
        }
        i = 0;
        while (i < n) {
            let b:i64 = i % NBINS;
            if (cnt[b] > 0) { h[i] = acc[b] / (cnt[b] as f64); } else { h[i] = 0.0; }
            i = i + 1;
        }
    } else {
        i = 0;
        while (i < n) { h[i] = 0.0; i = i + 1; }
    }
    let shh:f64 = 0.0;
    i = 0;
    while (i < n) { shh = shh + h[i] * h[i]; i = i + 1; }
    let hrms:f64 = zsqrt(shh / (n as f64));

    // load EVT1
    let em:[]u8 = read_all(epath);
    let nev:i64 = 0;
    let nsrc:i64 = 0;
    if ((em.len as i64) >= 24 and d_get32(em, 0) == 0x31545645) {
        nsrc = d_get64(em, 8);
        nev = d_get64(em, 16);
    }
    let epos:[]i64 = nio_alloc((nev * 8 + 8) as i32) as []i64;
    let eamp:[]f64 = nio_alloc((nev * 8 + 8) as i32) as []f64;
    let k:i64 = 0;
    while (k < nev) {
        let eo:i64 = 24 + k * 16;
        epos[k] = d_get64(em, eo);
        eamp[k] = d_getf64(em, eo + 8);
        k = k + 1;
    }

    cur = e1str(ob, cur, "NEVT=");
    cur = e1i64(ob, cur, nev);
    cur = e1str(ob, cur, " nsrc=");
    cur = e1i64(ob, cur, nsrc);
    cur = e1str(ob, cur, " P=");
    cur = e1f64(ob, cur, P);
    cur = e1str(ob, cur, " hrms=");
    cur = e1f64(ob, cur, hrms);
    ob[cur] = 10; cur = cur + 1;

    if (nev == 0) {
        cur = e1str(ob, cur, "B2i: vacuous (no events), B2ii: UNDEFINED (zero event train), B2iii: 0.000000 (< 0.50 FAIL), R2: vacuous\n");
        _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, cur, 0, 0, 0);
        return;
    }

    // B2(i): max|amp| <= P
    let maxa:f64 = 0.0;
    k = 0;
    while (k < nev) {
        let a:f64 = eamp[k];
        if (a < 0.0) { a = 0.0 - a; }
        if (a > maxa) { maxa = a; }
        k = k + 1;
    }
    // B2(ii): Pearson corr(event train, h)
    let se:f64 = 0.0;
    let sh:f64 = 0.0;
    let see:f64 = 0.0;
    let seh:f64 = 0.0;
    i = 0;
    while (i < n) { sh = sh + h[i]; i = i + 1; }
    k = 0;
    while (k < nev) {
        let p2:i64 = epos[k];
        if (p2 >= 0 and p2 < n) {
            let a:f64 = eamp[k];
            se = se + a;
            see = see + a * a;
            seh = seh + a * h[p2];
        }
        k = k + 1;
    }
    let nn:f64 = n as f64;
    let cov:f64 = nn * seh - se * sh;
    let ve:f64 = nn * see - se * se;
    let vh:f64 = nn * shh - sh * sh;
    let corr:f64 = 0.0;
    let corr_ok:i64 = 0;
    if (ve > 0.0 and vh > 0.0) { corr = cov / zsqrt(ve * vh); corr_ok = 1; }
    // B2(iii): fraction with contrast >= 10 (needs residual prefix sums)
    let r:[]f64 = nio_alloc((n * 8) as i32) as []f64;
    i = 0;
    while (i < n) { r[i] = xs[i] - h[i]; i = i + 1; }
    let ps:[]f64 = nio_alloc(((n + 1) * 8) as i32) as []f64;
    ps[0] = 0.0;
    i = 0;
    while (i < n) { ps[i + 1] = ps[i] + r[i] * r[i]; i = i + 1; }
    let c10:i64 = 0;
    k = 0;
    while (k < nev) {
        let p2:i64 = epos[k];
        let a:f64 = eamp[k];
        if (a < 0.0) { a = 0.0 - a; }
        let lo:i64 = p2 - 64;
        if (lo < 0) { lo = 0; }
        let hi:i64 = p2 + 64;
        if (hi > n - 1) { hi = n - 1; }
        let elo:i64 = p2 - 8;
        if (elo < 0) { elo = 0; }
        let ehi:i64 = p2 + 8;
        if (ehi > n - 1) { ehi = n - 1; }
        let winsum:f64 = (ps[hi + 1] - ps[lo]) - (ps[ehi + 1] - ps[elo]);
        let wincnt:i64 = (hi - lo + 1) - (ehi - elo + 1);
        let lrms:f64 = 0.0;
        if (wincnt > 0) { lrms = zsqrt(winsum / (wincnt as f64)); }
        if (lrms > 0.0 and a / lrms >= 10.0) { c10 = c10 + 1; }
        k = k + 1;
    }
    cur = e1str(ob, cur, "B2i maxamp=");
    cur = e1f64(ob, cur, maxa);
    cur = e1str(ob, cur, " (<=P: ");
    cur = e1i64(ob, cur, maxa <= P);
    cur = e1str(ob, cur, ") B2ii corr=");
    if (corr_ok == 1) { cur = e1f64(ob, cur, corr); } else { cur = e1str(ob, cur, "undef"); }
    cur = e1str(ob, cur, " (<0.30: ");
    let cpass:i64 = 0;
    if (corr_ok == 1 and corr < 0.30) { cpass = 1; }
    cur = e1i64(ob, cur, cpass);
    cur = e1str(ob, cur, ") B2iii frac_ge10=");
    cur = e1f64(ob, cur, (c10 as f64) / (nev as f64));
    cur = e1str(ob, cur, " R2 maxamp_over_hrms=");
    cur = e1f64(ob, cur, maxa / hrms);
    ob[cur] = 10; cur = cur + 1;
    _zag_raw_syscall(1, 1, _zag_slice_ptr(ob) as i64, cur, 0, 0, 0);
    return;
}

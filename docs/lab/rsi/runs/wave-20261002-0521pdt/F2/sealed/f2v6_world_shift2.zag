// f2v6_world_shift2.zag -- SEALED World SHIFT2 (F2 v6, double regime shift).
// Fresh sealed world for wave-20261002-0521pdt. Designed from the frozen
// C2-prime family spec (dual contextual delay); all sealed specifics are
// fresh: two hidden progressive mid-stream law changes, latch schedule,
// delays, pulse schedule, goal plans.
// TRUE LAWS (sealed):
//   Regime 1: (X -> Y1, delay 2, J == 1); (X -> Y2, delay 2, K == 1).
//   Regime 2: (X -> Y1, delay 2, J == 1); (X -> Y2, delay 3, K == 1).
//             (shift 1: Y2 delay 2 -> 3)
//   Regime 3: (X -> Y1, delay 2, J == 1); (X -> Y2, delay 4, K == 1).
//             (shift 2: Y2 delay 3 -> 4)
// Each shift lengthens Y2's delay by exactly one step past the previous
// regime's max delay, which provably breaks the previous regime's goal
// plan (the 3-step window loses its earliest step). X has no law (decays).
// Declared context variables: J, K (persistent: retain value across WAIT,
// change only via SET/CLR).
// Passive: 18 steps, X pulses at t = 3, 8, 13, J = 1 and K = 1 throughout
// (established at t = 0; both persistent). Regime-independent: every latch
// fires inside a goal phase, strictly after the passive.
// Goal setup (disclosed schema): J = 0, K = 0 (both gates WRONG).
// Hidden latch (world-side, never disclosed to the learner): the world
// counts w_goal_setup calls in a hidden counter packed with the clock.
// Setup call #1 (first goal setup of wave 1) advances Regime 1 -> Regime 2.
// Setup call #23 (first goal setup of wave 2; each wave issues exactly 22
// setup calls under the frozen learner protocol: 2 goal-phase + 20
// random-control) advances Regime 2 -> Regime 3. All later setup calls are
// regime no-ops. Rationale: the goal-setup procedure reconfigures the
// apparatus mid-stream; the learner is never told.
// Goalvar interface: [Y1, Y2, J, K] with values [1, 1, 1, 1]. Unchanged
// across regimes (the goal does not move; the laws do).
// w_plan_maxd = 12 (disclosed; the Regime-3 goal needs a length-11 plan).
// w_verify returns the regime number (1, 2, or 3) whose laws the survivor
// matches, 0 otherwise; it logs which. It does NOT take ws (signature
// unchanged from v4), so the frozen v4 and v5 learners link unmodified;
// it identifies the regime by matching the survivor's rules against each
// regime's law table (a survivor matches at most one regime).
// Concatenate AFTER f2v6_learner.zag (which provides the L_* machinery and
// no main). The learner NEVER reads sealed laws; it only calls the w_*
// interface. Verified by source audit.
// ws layout: +0 tc (i32, packed: t + setupcount * 1000 + regime * 1000000;
// t < 1000, setupcount < 1000, so no field overlap), +4 ncalls (i32),
// +8 hist (nvars * 32 bytes). w_reset zeroes t but preserves the packed
// setup count and regime. The packed cell keeps the ws footprint identical
// to v4/v5, so the pristine v5-base binary (NC3 ablation) links safely.

fn S2_D1R1()i32 { return 2; }
fn S2_D2R1()i32 { return 2; }
fn S2_D1R2()i32 { return 2; }
fn S2_D2R2()i32 { return 3; }
fn S2_D1R3()i32 { return 2; }
fn S2_D2R3()i32 { return 4; }
fn S2_J1()i32 { return 1; }
fn S2_K1()i32 { return 1; }

// ---- packed clock/counter cell ----
fn S2_t(ws:[]u8)i32 { return get32(ws,0)%1000; }
fn S2_setupcount(ws:[]u8)i32 { return (get32(ws,0)/1000)%1000; }
fn S2_regime(ws:[]u8)i32 {
  let r:i32=get32(ws,0)/1000000;
  if(r<1){ return 1; }
  if(r>3){ return 3; }
  return r;
}
fn S2_t_inc(ws:[]u8)void {
  set32(ws,0,get32(ws,0)+1);
  return;
}
fn S2_setup_inc(ws:[]u8)void {
  set32(ws,0,get32(ws,0)+1000);
  return;
}
fn S2_regime_set(ws:[]u8, r:i32)void {
  let c:i32=get32(ws,0);
  set32(ws,0,(c%1000000)+r*1000000);
  return;
}

fn S2_rules(reg:i32, r:[]u8)void {
  let d1:i32=S2_D1R1(); let d2:i32=S2_D2R1();
  if(reg==2){ d1=S2_D1R2(); d2=S2_D2R2(); }
  if(reg==3){ d1=S2_D1R3(); d2=S2_D2R3(); }
  r[0]=0; r[1]=1; r[2]=d1 as u8; r[3]=3; r[4]=S2_J1() as u8;
  r[5]=0; r[6]=2; r[7]=d2 as u8; r[8]=4; r[9]=S2_K1() as u8;
  return;
}

fn w_goal_mode()i32 { return 2; }
fn w_nvars()i32 { return 5; }
fn w_nctrl()i32 { return 3; }
fn w_ctrl(i:i32)i32 {
  if(i==0){ return 0; } // X
  if(i==1){ return 3; } // J
  return 4;             // K
}
fn w_npass()i32 { return 18; }
fn w_nctx()i32 { return 5; }
fn w_ctx_cx(i:i32)i32 {
  if(i==0){ return 255; } // ALWAYS
  if(i==1){ return 3; }   // J
  if(i==2){ return 3; }   // J
  if(i==3){ return 4; }   // K
  return 4;               // K
}
fn w_ctx_cv(i:i32)i32 {
  if(i==0){ return 0; } // ALWAYS (cv unused)
  if(i==1){ return 0; } // J == 0
  if(i==2){ return 1; } // J == 1
  if(i==3){ return 0; } // K == 0
  return 1;             // K == 1
}
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Y1"; }
  if(v==2){ return "Y2"; }
  if(v==3){ return "J"; }
  return "K";
}
fn w_worldname()[]u8 { return "SHIFT2-double-regime-SEALED"; }
fn w_plan_maxd()i32 { return 12; }
fn w_ngoalvars()i32 { return 4; }
fn w_goalvar(i:i32)i32 {
  if(i==0){ return 1; } // Y1
  if(i==1){ return 2; } // Y2
  if(i==2){ return 3; } // J
  return 4;             // K
}
fn w_goalval(i:i32)i32 {
  if(i==0){ return 1; } // Y1 = 1
  if(i==1){ return 1; } // Y2 = 1
  if(i==2){ return S2_J1(); } // J = j1
  return S2_K1();             // K = k1
}
fn D_cxs()[]u8 {
  let c:[]u8=z_alloc(5);
  c[0]=255; c[1]=3; c[2]=3; c[3]=4; c[4]=4;
  return c;
}

// ws layout: +0 tc (packed), +4 ncalls, +8 hist (nvars*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,(get32(ws,0)/1000)*1000); // zero t, keep setupcount+regime
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+5*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=S2_t(ws);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    S2_t_inc(ws);
    t=t+1;
    let hist:[]u8=ws[8..8+5*32];
    let rules:[]u8=z_alloc(10);
    S2_rules(S2_regime(ws),rules);
    L_advance(hist,t,rules,2,5,D_cxs(),5);
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=S2_t(ws);
  let v:i32=0;
  while(v<5){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule (sealed): 18 steps, t = 0..17. Environment SETs X
// at t = 3, 8, 13. J = 1 and K = 1 throughout (established at t = 0;
// both persistent). Regime-independent.
fn w_passive(ws:[]u8)void {
  let t:i32=S2_t(ws);
  if(t==0){ ws[8+3*32+t]=1; ws[8+4*32+t]=1; }
  if(t==3 || t==8 || t==13){ ws[8+0*32+t]=1; }
  return;
}
// Goal setup (disclosed schema): J = 0, K = 0 (both gates WRONG).
// Hidden latch: setup call #1 -> Regime 2; setup call #23 -> Regime 3.
fn w_goal_setup(ws:[]u8)void {
  ws[8+3*32+0]=0; // J = 0 (gate WRONG)
  ws[8+4*32+0]=0; // K = 0 (gate WRONG)
  S2_setup_inc(ws);
  let sc:i32=S2_setupcount(ws);
  if(sc==1){ S2_regime_set(ws,2); }
  if(sc==23){ S2_regime_set(ws,3); }
  return;
}
// Unused for goal mode 2 (C2 uses the triple predicate in the learner).
fn w_goal_met(vals:[]u8)i32 { return 0; }

// Harness adjudication for K6-R4 (SHIFT2 contract): the loop terminates
// with exactly one survivor, and its Y1/Y2 rules equal one regime's true
// laws. Returns the matched regime number (1, 2, 3), 0 otherwise.
fn S2_findrule(candbuf:[]u8, dst:i32, d:i32, gv:i32, gval:i32)i32 {
  let j:i32=0;
  while(j<36){
    let b:i32=(dst*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==d &&
       (candbuf[b+3] as i32)==gv && (candbuf[b+4] as i32)==gval){ return j; }
    j=j+1;
  }
  return -1;
}
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  let t11:i32=S2_findrule(candbuf,1,S2_D1R1(),3,S2_J1());
  let t12:i32=S2_findrule(candbuf,2,S2_D2R1(),4,S2_K1());
  let t21:i32=S2_findrule(candbuf,1,S2_D1R2(),3,S2_J1());
  let t22:i32=S2_findrule(candbuf,2,S2_D2R2(),4,S2_K1());
  let t31:i32=S2_findrule(candbuf,1,S2_D1R3(),3,S2_J1());
  let t32:i32=S2_findrule(candbuf,2,S2_D2R3(),4,S2_K1());
  let p1:i32=-1; let p2:i32=-1;
  let j:i32=0;
  while(j<ne){
    if((evars[j] as i32)==1){ p1=j; }
    if((evars[j] as i32)==2){ p2=j; }
    j=j+1;
  }
  let reg:i32=0;
  emit("S2_VERIFY nalive="); e64(nalive); emit(" exhausted="); e64(exhausted);
  emit("\n");
  if(nalive==1 && p1>=0 && p2>=0){
    let h:i32=0;
    while(h<nhyp){
      if(alive[h]==1){
        let r1:i32=hysel[h*ne+p1] as i32;
        let r2:i32=hysel[h*ne+p2] as i32;
        emit("  survivor hyp"); e64(h);
        emit(" Y1rule="); e64(r1); emit(" Y2rule="); e64(r2); emit("\n");
        if(t11>=0 && t12>=0 && r1==t11 && r2==t12){ reg=1; }
        if(t21>=0 && t22>=0 && r1==t21 && r2==t22){ reg=2; }
        if(t31>=0 && t32>=0 && r1==t31 && r2==t32){ reg=3; }
      }
      h=h+1;
    }
  }
  emit("S2_VERIFY_RESULT "); e64(reg); emit("\n");
  return reg;
}

fn main()i32 {
  let m:i32=L_run();
  let fin:i32=m&0x3F;
  let nrev:i32=(m>>8)&7;
  let fp:i32=(m>>11)&1;
  if(fin==63 && nrev==2 && fp==0){
    emit("F2V6_SHIFT2 PROGRAM_ALL_BARS_PASS\n");
    return 0;
  }
  emit("F2V6_SHIFT2 PROGRAM_FAIL m="); e64(m); emit("\n");
  return 1;
}

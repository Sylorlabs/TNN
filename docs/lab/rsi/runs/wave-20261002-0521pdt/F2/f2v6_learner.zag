// f2v6_learner.zag -- F2 v6 autonomous scientist: v5 mechanism + evidence-driven revision loop.
// Wave wave-20261002-0521pdt, lane F2. Frozen prereg PREREG_F2V6.md (commit 8f99040b3).
// v5 header block below (carried over for provenance).
// Delta from F2 v5 (f2v5_learner.zag, uncommitted working copy from
// wave-20261002-0221pdt, never executed against any sealed world):
//   (a) EVIDENCE-DRIVEN REVISION LOOP (the v6 structural change): the
//       fixed exactly-one-revision cap is REMOVED. After each wave, if
//       the executed plan was correct under the converged model but the
//       world's real verification observations contradict the model's
//       predictions (plan found, goal not met for real, predicted !=
//       actual, exactly one survivor), another revision wave runs. The
//       loop stops when (i) a wave's plan verifies for real, or
//       (ii) a wave re-converges to a law set already seen in this run
//       (fixed point: honest FAIL, no infinite regress), or (iii) a wave
//       ends without a contradiction. No researcher-set revision count;
//       stopping conditions are learner-verifiable. A wave-safety cap
//       (6) is pure engineering hygiene, never hit in eval.
//   (b) CONVERGENCE SIGNATURE EXPORT: L_wave now exports per-wave
//       convergence evidence in res (+52 nalive, +56 ne, +60 ne*5
//       survivor rule bytes; res grown 64 -> 128 bytes) for the
//       fixed-point comparison in L_run.
//   (c) RETURN ENCODING (v6): bits 0-5 final wave's v4-style mask;
//       bits 8-10 number of revision waves triggered; bit 11
//       fixed-point stop hit. Single-wave runs return the v4-style mask
//       unchanged (frozen v4 world mains keep working).
// D2 stays 9. L_DMAX stays 4. Candidate generation, L_find, DPDS, the
// ledger, the planners, the random controls, and all world interfaces
// are unchanged. No new modes, bridges, routers, handlers, or semantic
// cases. Pure Zag. No Python.
// v4 header block below (carried over for provenance).
// Delta from F2 v4 (f2v4_learner.zag):
//   (a) REVISION EDGE (the v5 structural change): after the goal phase,
//       the learner compares the model's predicted verification
//       observations against the real ones. On a mismatch (the executed
//       plan was correct under the converged model, but the world
//       contradicted it), the learner performs EXACTLY ONE revision wave:
//       a fresh passive trace, full re-discrimination, re-verification,
//       re-plan, re-execution. The revision is triggered by the same kind
//       of prediction-vs-observation contradiction that drives hypothesis
//       elimination; it is a single generic back-edge, not a mode, bridge,
//       router, handler, or semantic case. The cap of one revision is
//       structural (no loop), preserving determinism. This is what lets
//       the learner survive a hidden mid-stream law change (regime shift).
//   (b) PLANNER SOUNDNESS TIGHTENING (generic): L_plan_c2 now requires the
//       3-consecutive-goal-step window to sit exactly at [nwait,nwait+2],
//       the steps the real SUFFIX observes, instead of anywhere in the
//       trajectory. The v4 loose check admitted plans whose verified
//       window did not align with the SUFFIX; the tightened check is
//       SUFFIX-sound. On the v4 sealed worlds it returns the identical
//       plans (verified in regression).
//   (c) L_run refactored into L_wave (one full learn/discriminate/verify/
//       plan/execute cycle, result buffer out-param) plus a thin L_run
//       orchestrator (shared ws across waves so world-side regime state
//       persists; at most two waves). No change to candidate generation,
//       L_find, DPDS, the ledger, the random controls, or any world
//       interface. D2 stays 9.
// f2v4_learner.zag -- F2 v4 autonomous scientist: generic learner machinery + DPDS.
// Wave wave-20261001-2321pdt, lane F2V3. Frozen prereg PREREG_F2V4.md (commit 5e4e56a5f).
// Delta from F2 v3 (f2v3_learner.zag): ONE generic change, the
// discrimination bound D2 raised 8 -> 9 (v4 prereg section 3):
//   L_D2        - now returns 9 (the only mechanism change)
//   dsk/dsv     - discrimination sequence buffers resized 8 -> 10 slots
//   ledger      - record reclen 48+nhyp -> 50+nhyp with 9 sequence slots
//   L_pairdiff  - unchanged (runtime structural diff over hypothesis rule-set data)
//   L_dpds_pair - unchanged algorithm; restricted-alphabet iterative-deepening
//                 search now to D2 = 9 (manipulations + WAIT + OBSERVE of
//                 differing vars only, exactly one OBSERVE per sequence)
//   L_dpds      - unchanged; ascending pair scan; first distinguishing pair wins
//   discrimination ledger - unchanged role (learner-created persistent state,
//                 appended per discrimination experiment); record capacity only
//                 discrimination experiment, persists across search rounds
// All else unchanged from v2 (standard loop, candidate generation, goal
// planners). The C2 goal planner/predicate/control are generalized over the
// w_ngoalvars/w_goalvar/w_goalval interface (prereg section 5) so the
// learner stays world-agnostic.
// No main here. Concatenated with f2v3_world_a.zag or a C-prime-family
// world (which provide the w_* interface and main). The learner NEVER
// reads sealed laws; it only calls the w_* interface. Verified by source audit.
// Primitives (kind, var): 0=SET v, 1=CLR v, 2=WAIT, 3=OBSERVE v.
// Pure Zag. No Python.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ learner constants ============
fn L_DMAX()i32 { return 4; }
fn L_BUDGET()i32 { return 32; } // K4-R6: 32 active OBSERVE across both worlds (v2 used 23)
fn L_SEARCHD()i32 { return 6; }
fn L_D2()i32 { return 9; } // DPDS discrimination bound (v4 prereg section 3)
fn L_MAXC()i32 { return 36; } // max candidates per var

// ============ persistence ============
// A variable is persistent iff it appears as a non-ALWAYS context cx.
// Generic property of the declared context set (disclosed physics).
fn L_ispersist(e:i32, cxs:[]u8, nctx:i32)i32 {
  let x:i32=0;
  while(x<nctx){
    if((cxs[x] as i32)==e){ return 1; }
    x=x+1;
  }
  return 0;
}

// ============ generic rule advance ============
// hist: nvars*32 bytes. rules: nr*5 bytes of [c,e,d,cx,cv], cx=255 means ALWAYS.
// Declared context vars (cx set) are PERSISTENT: retain value across WAIT.
// Every other variable with no applicable rule becomes 0 (decay).
// t must be >= 1. Used by BOTH the sealed world and learner simulation.
fn L_advance(hist:[]u8, t:i32, rules:[]u8, nr:i32, nvars:i32, cxs:[]u8, nctx:i32)void {
  let e:i32=0;
  while(e<nvars){
    if(L_ispersist(e,cxs,nctx)==1){
      hist[e*32+t]=hist[e*32+t-1];
    } else {
      let nv:i32=0;
      let r:i32=0;
      while(r<nr){
        let b:i32=r*5;
        if((rules[b+1] as i32)==e){
          let c:i32=rules[b] as i32;
          let d:i32=rules[b+2] as i32;
          let s:i32=t-d;
          if(s>=0 && hist[c*32+s]==1){
            let cx:i32=rules[b+3] as i32;
            if(cx==255){ nv=1; }
            else if(hist[cx*32+s]==rules[b+4]){ nv=1; }
          }
        }
        r=r+1;
      }
      hist[e*32+t]=nv as u8;
    }
    e=e+1;
  }
  return;
}

// ============ candidate generation (generic, unchanged from v2) ============
// trace: nvars*npass bytes. candbuf: nvars*36*5 bytes. candn: nvars bytes.
// Contexts from the world's context set (cxs, cvs, nctx).
// Declared persistent vars are skipped as EFFECTS (disclosed physics:
// they change only via SET/CLR, so no rule can govern them).
fn L_gencands(trace:[]u8, npass:i32, nvars:i32, cxs:[]u8, cvs:[]u8, nctx:i32,
              candbuf:[]u8, candn:[]u8)void {
  let e:i32=0;
  while(e<nvars){
    if(L_ispersist(e,cxs,nctx)==1){
      candn[e]=0;
    } else {
      let n:i32=0;
      let c:i32=0;
      while(c<nvars){
        if(c!=e){
          let d:i32=1;
          while(d<=L_DMAX()){
            let x:i32=0;
            while(x<nctx){
              let cx:i32=cxs[x] as i32;
              let cv:i32=cvs[x] as i32;
              let cnt:i32=0;
              let ok:i32=1;
              let t:i32=0;
              while(t<=npass-1-d){
                let ctxok:i32=0;
                if(cx==255){ ctxok=1; }
                else if((trace[cx*npass+t] as i32)==cv){ ctxok=1; }
                if(trace[c*npass+t]==1 && ctxok==1){
                  cnt=cnt+1;
                  if(trace[e*npass+t+d]==0){ ok=0; }
                }
                t=t+1;
              }
              if(ok==1 && cnt>=2 && n<L_MAXC()){
                let b:i32=(e*L_MAXC()+n)*5;
                candbuf[b]=c as u8; candbuf[b+1]=e as u8; candbuf[b+2]=d as u8;
                candbuf[b+3]=cx as u8; candbuf[b+4]=cv as u8;
                n=n+1;
              }
              x=x+1;
            }
            d=d+1;
          }
        }
        c=c+1;
      }
      candn[e]=n as u8;
    }
    e=e+1;
  }
  return;
}

// ============ hypothesis simulation (unchanged from v2) ============
// rules: ne*5 bytes (one rule per endogenous var). sk/sv: kinds/vars, len.
// init: nvars bytes (initial step-0 values). out_obs: >=16 bytes. out_final: nvars.
// hist: nvars*32 scratch. Returns number of observations, or negative on overflow.
fn L_sim(rules:[]u8, ne:i32, nvars:i32, sk:[]u8, sv:[]u8, len:i32,
         init:[]u8, out_obs:[]u8, out_final:[]u8, hist:[]u8,
         cxs:[]u8, nctx:i32)i32 {
  let v:i32=0;
  while(v<nvars*32){ hist[v]=0; v=v+1; }
  v=0;
  while(v<nvars){ hist[v*32]=init[v]; v=v+1; }
  let t:i32=0;
  let nobs:i32=0;
  let i:i32=0;
  while(i<len){
    let kk:i32=sk[i] as i32;
    let vv:i32=sv[i] as i32;
    if(kk==0){ hist[vv*32+t]=1; }
    else if(kk==1){ hist[vv*32+t]=0; }
    else if(kk==2){
      t=t+1;
      if(t>=32){ return -1; }
      L_advance(hist,t,rules,ne,nvars,cxs,nctx);
    }
    else {
      if(nobs>=16){ return -2; }
      out_obs[nobs]=hist[vv*32+t];
      nobs=nobs+1;
    }
    i=i+1;
  }
  v=0;
  while(v<nvars){ out_final[v]=hist[v*32+t]; v=v+1; }
  return nobs;
}

// ============ emit helpers ============
fn L_emit_prim(kk:i32, vv:i32)void {
  if(kk==0){ emit("S"); }
  else if(kk==1){ emit("C"); }
  else if(kk==2){ emit("W"); }
  else { emit("O"); }
  if(kk!=2){ emit(w_vname(vv)); }
  return;
}
fn L_emit_seq(sk:[]u8, sv:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){ emit(","); }
    L_emit_prim(sk[i] as i32, sv[i] as i32);
    i=i+1;
  }
  emit("]");
  return;
}
fn L_emit_rule(r:[]u8)void {
  // r: 5 bytes [c,e,d,cx,cv]
  emit(w_vname(r[0] as i32)); emit("->"); emit(w_vname(r[1] as i32));
  emit(" d"); e64(r[2] as i32);
  if((r[3] as i32)!=255){ emit(" ctx "); emit(w_vname(r[3] as i32)); emit("="); e64(r[4] as i32); }
  return;
}

// ============ experiment search (standard; unchanged from v2) ============
// Finds first sequence (depths 1..6, lexicographic, base-B) with >=1 OBSERVE
// where live hypotheses' predicted observation vectors disagree.
// Fills out_sk/out_sv (len returned), out_preds (nhyp*16), out_predn (nhyp).
// Returns seqlen, or 0 if none. Pure simulation: never touches the world.
fn L_find(hyprules:[]u8, alive:[]u8, nhyp:i32, ne:i32, nvars:i32,
          nctrl:i32, ctrl:[]u8, cxs:[]u8, nctx:i32,
          out_sk:[]u8, out_sv:[]u8, out_preds:[]u8, out_predn:[]u8)i32 {
  let B:i32=2*nctrl+1+nvars;
  let init:[]u8=z_alloc(nvars);
  let ob:[]u8=z_alloc(16);
  let fin:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let ref:[]u8=z_alloc(16);
  let d:i32=1;
  while(d<=L_SEARCHD()){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*B; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*B; k=k+1; }
      let rem:i32=si;
      let hasobs:i32=0;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/B; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nctrl){ kk=0; vv=ctrl[dig] as i32; }
        else if(dig<2*nctrl){ kk=1; vv=ctrl[dig-nctrl] as i32; }
        else if(dig==2*nctrl){ kk=2; vv=0; }
        else { kk=3; vv=dig-(2*nctrl+1); hasobs=1; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        i=i+1;
      }
      if(hasobs==1){
        let refn:i32=-1;
        let disagree:i32=0;
        let bad:i32=0;
        let h:i32=0;
        while(h<nhyp){
          if(alive[h]==1){
            let nn:i32=L_sim(hyprules[h*ne*5..h*ne*5+ne*5],ne,nvars,out_sk,out_sv,d,init,ob,fin,hist,cxs,nctx);
            if(nn<0){ bad=1; }
            else {
              out_predn[h]=nn as u8;
              let j:i32=0;
              while(j<nn){ out_preds[h*16+j]=ob[j]; j=j+1; }
              if(refn<0){ refn=nn; j=0; while(j<nn){ ref[j]=ob[j]; j=j+1; } }
              else if(nn!=refn){ disagree=1; }
              else {
                j=0;
                while(j<nn){ if(ob[j]!=ref[j]){ disagree=1; } j=j+1; }
              }
            }
          }
          h=h+1;
        }
        if(bad==0 && disagree==1){ return d; }
      }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// ============ DPDS: discrimination-phase pairwise deep search (prereg section 3) ============
// Fired only when the standard depth 1..6 full-alphabet scan finds no
// disagreeing sequence AND nalive > 1. Same select-execute-eliminate loop,
// continued over survivor pairs. Not a mode, bridge, router, or semantic
// case: identical code path for every world, no per-world branch, no
// task-specific gate, sequences discovered by enumeration.

// D(i,j): the set of variables whose governing rule (cause, delay,
// context) differs between h_i and h_j. Generic structural diff over
// hypothesis rule-set data, computed at runtime. Never variable-specific
// in source: no variable index, name, or rule literal appears here.
// diffv is filled with ascending variable indices. Returns |D|.
fn L_pairdiff(hyprules:[]u8, hi:i32, hj:i32, ne:i32, evars:[]u8, diffv:[]u8)i32 {
  let nd:i32=0;
  let j:i32=0;
  while(j<ne){
    let bi:i32=(hi*ne+j)*5;
    let bj:i32=(hj*ne+j)*5;
    let dd:i32=0;
    if(hyprules[bi]!=hyprules[bj]){ dd=1; }       // cause differs
    if(hyprules[bi+2]!=hyprules[bj+2]){ dd=1; }   // delay differs
    if(hyprules[bi+3]!=hyprules[bj+3]){ dd=1; }   // context var differs
    if(hyprules[bi+4]!=hyprules[bj+4]){ dd=1; }   // context value differs
    if(dd==1){ diffv[nd]=evars[j]; nd=nd+1; }
    j=j+1;
  }
  return nd;
}

// Restricted-alphabet first-disagreeing-sequence search for ONE pair.
// Alphabet: SET/CLR per controllable (w_ctrl order), WAIT, plus OBSERVE v
// for v in diffv (ascending variable index). Nothing else.
// Iterative deepening over depths 1..D2 (bound 9, v4 prereg section 3).
// Sequences must contain exactly one OBSERVE (completeness-preserving:
// OBSERVE is state-neutral and non-D observations always agree, prereg 3.1).
// Selects the first sequence (depths ascending, lexicographic within
// depth) where the pair's predicted observation vectors disagree.
// Fills out_sk/out_sv (seqlen returned) and out_p[2] (predicted obs of
// hi, hj). Returns seqlen, or 0 if none (caller logs the D2 certificate).
// Pure simulation: never touches the world.
fn L_dpds_pair(hyprules:[]u8, hi:i32, hj:i32, ne:i32, nvars:i32,
               nctrl:i32, ctrl:[]u8, diffv:[]u8, nd:i32, cxs:[]u8, nctx:i32,
               out_sk:[]u8, out_sv:[]u8, out_p:[]u8)i32 {
  let A:i32=2*nctrl+1+nd;
  let init:[]u8=z_alloc(nvars);
  let ob:[]u8=z_alloc(16);
  let fin:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let d:i32=1;
  while(d<=L_D2()){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*A; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*A; k=k+1; }
      let rem:i32=si;
      let nobs:i32=0;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/A; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nctrl){ kk=0; vv=ctrl[dig] as i32; }
        else if(dig<2*nctrl){ kk=1; vv=ctrl[dig-nctrl] as i32; }
        else if(dig==2*nctrl){ kk=2; vv=0; }
        else { kk=3; vv=diffv[dig-(2*nctrl+1)] as i32; nobs=nobs+1; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        i=i+1;
      }
      if(nobs==1){
        let ni:i32=L_sim(hyprules[hi*ne*5..hi*ne*5+ne*5],ne,nvars,out_sk,out_sv,d,init,ob,fin,hist,cxs,nctx);
        let pi:i32=-1;
        if(ni==1){ pi=ob[0] as i32; }
        let nj:i32=L_sim(hyprules[hj*ne*5..hj*ne*5+ne*5],ne,nvars,out_sk,out_sv,d,init,ob,fin,hist,cxs,nctx);
        let pj:i32=-1;
        if(nj==1){ pj=ob[0] as i32; }
        if(pi>=0 && pj>=0 && pi!=pj){
          out_p[0]=pi as u8; out_p[1]=pj as u8;
          return d;
        }
      }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// Full DPDS pass over all unordered live pairs, ascending index order.
// The FIRST pair yielding a distinguishing sequence determines the
// executed experiment: fills out_sk/out_sv (seqlen returned),
// out_pair (two i32), out_p[2] (predicted obs). Returns seqlen, or 0 when
// no pair distinguishes to D2 (per-pair D2 certificates are logged here).
// Pure simulation: never touches the world.
fn L_dpds(hyprules:[]u8, alive:[]u8, nhyp:i32, ne:i32, nvars:i32,
          nctrl:i32, ctrl:[]u8, evars:[]u8, cxs:[]u8, nctx:i32,
          out_sk:[]u8, out_sv:[]u8, out_pair:[]u8, out_p:[]u8)i32 {
  let diffv:[]u8=z_alloc(nvars);
  let p:[]u8=z_alloc(2);
  let i:i32=0;
  while(i<nhyp){
    if(alive[i]==1){
      let j:i32=i+1;
      while(j<nhyp){
        if(alive[j]==1){
          let nd:i32=L_pairdiff(hyprules,i,j,ne,evars,diffv);
          emit("DPDS_PAIR ("); e64(i); emit(","); e64(j); emit(") D={");
          let q:i32=0;
          while(q<nd){ if(q>0){ emit(","); } emit(w_vname(diffv[q] as i32)); q=q+1; }
          emit("}\n");
          let flen:i32=0;
          if(nd>0){
            flen=L_dpds_pair(hyprules,i,j,ne,nvars,nctrl,ctrl,diffv,nd,cxs,nctx,out_sk,out_sv,p);
          }
          if(flen>0){
            set32(out_pair,0,i);
            set32(out_pair,4,j);
            out_p[0]=p[0]; out_p[1]=p[1];
            emit("DPDS_SELECT pair=("); e64(i); emit(","); e64(j); emit(") ");
            L_emit_seq(out_sk,out_sv,flen);
            emit(" pred_i=["); e64(p[0] as i32); emit("] pred_j=["); e64(p[1] as i32); emit("]\n");
            return flen;
          }
          emit("D2CERT pair=("); e64(i); emit(","); e64(j);
          emit(") no distinguishing sequence to depth "); e64(L_D2()); emit("\n");
        }
        j=j+1;
      }
    }
    i=i+1;
  }
  return 0;
}

// ============ discrimination ledger (learner-created persistent state) ============
// Fixed record per entry: round, pair i, pair j, seqlen (4 x i32),
// seq kinds[9], seq vars[9] (18 bytes), pred_i, pred_j, actual,
// nkilled (4 x i32), killed[nhyp] (nhyp bytes). reclen = 50 + nhyp.
// Allocated once in L_run; appended across search rounds; entries depend
// entirely on the world's responses. Source holds only the generic
// append operation.
fn L_ledger_append(led:[]u8, ledn:i32, reclen:i32, nhyp:i32,
                   round:i32, pi:i32, pj:i32, sk:[]u8, sv:[]u8, seqlen:i32,
                   predi:i32, predj:i32, actual:i32,
                   killed:[]u8, nkilled:i32)i32 {
  let base:i32=ledn*reclen;
  set32(led,base,round);
  set32(led,base+4,pi);
  set32(led,base+8,pj);
  set32(led,base+12,seqlen);
  let i:i32=0;
  while(i<9){
    if(i<seqlen){ led[base+16+i]=sk[i]; led[base+25+i]=sv[i]; }
    else { led[base+16+i]=0; led[base+25+i]=0; }
    i=i+1;
  }
  set32(led,base+34,predi);
  set32(led,base+38,predj);
  set32(led,base+42,actual);
  set32(led,base+46,nkilled);
  i=0;
  while(i<nhyp){ led[base+50+i]=killed[i]; i=i+1; }
  return ledn+1;
}
fn L_ledger_emit(round:i32, pi:i32, pj:i32, sk:[]u8, sv:[]u8, seqlen:i32,
                 predi:i32, predj:i32, actual:i32,
                 killed:[]u8, nhyp:i32)void {
  emit("DISC_LEDGER round="); e64(round);
  emit(" pair=("); e64(pi); emit(","); e64(pj); emit(") seq=");
  L_emit_seq(sk,sv,seqlen);
  emit(" pred_i=["); e64(predi); emit("] pred_j=["); e64(predj);
  emit("] actual=["); e64(actual); emit("] killed=[");
  let h:i32=0;
  let first:i32=1;
  while(h<nhyp){
    if(killed[h]==1){ if(first==0){ emit(","); } e64(h); first=0; }
    h=h+1;
  }
  emit("]\n");
  return;
}

// ============ goal planner (World A: final-state; unchanged from v2) ============
// Alphabet: SET/CLR per ctrl + WAIT (no OBSERVE). Simulates under hyp h0.
// Returns plan length, or 0 if none. Pure simulation.
fn L_plan(hyprules:[]u8, h0:i32, ne:i32, nvars:i32, nctrl:i32, ctrl:[]u8,
          init:[]u8, maxd:i32, cxs:[]u8, nctx:i32,
          out_sk:[]u8, out_sv:[]u8)i32 {
  let P:i32=2*nctrl+1;
  let ob:[]u8=z_alloc(16);
  let fin:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let d:i32=1;
  while(d<=maxd){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*P; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*P; k=k+1; }
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/P; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nctrl){ kk=0; vv=ctrl[dig] as i32; }
        else if(dig<2*nctrl){ kk=1; vv=ctrl[dig-nctrl] as i32; }
        else { kk=2; vv=0; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        i=i+1;
      }
      let nn:i32=L_sim(hyprules[h0*ne*5..h0*ne*5+ne*5],ne,nvars,out_sk,out_sv,d,init,ob,fin,hist,cxs,nctx);
      if(nn>=0 && w_goal_met(fin)==1){ return d; }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// ============ C2 goal planner (dual contextual worlds; prereg section 6) ============
// Alphabet in prereg LISTED order, derived generically from the controllable
// set: {SET c0, CLR c0, SET c1, CLR c1, ..., WAIT} = digits 0..2*nctrl.
// (digit 2*i = SET ctrl[i], digit 2*i+1 = CLR ctrl[i], digit 2*nctrl = WAIT.)
// For each M (depths 1..maxd, lexicographic, MSD first), simulate M + 3
// WAITs under the first surviving hypothesis (pure simulation, zero world
// calls). The 3 WAITs are trajectory-equivalent to the SUFFIX observation
// rounds because OBSERVE is state-neutral (disclosed in prereg).
// Select the first M whose simulated trajectory contains three consecutive
// steps at which every goalvar (w_goalvar/w_goalval interface) equals its
// goal value. Returns M length, or 0 if none. out_sk/out_sv receive M.
fn L_plan_c2(hyprules:[]u8, h0:i32, ne:i32, nvars:i32, nctrl:i32, ctrl:[]u8,
             init:[]u8, maxd:i32, cxs:[]u8, nctx:i32,
             out_sk:[]u8, out_sv:[]u8)i32 {
  let ng:i32=w_ngoalvars();
  let gv:[]u8=z_alloc(ng);
  let gval:[]u8=z_alloc(ng);
  let g:i32=0;
  while(g<ng){ gv[g]=w_goalvar(g) as u8; gval[g]=w_goalval(g) as u8; g=g+1; }
  let P:i32=2*nctrl+1;
  let full_sk:[]u8=z_alloc(16);
  let full_sv:[]u8=z_alloc(16);
  let ob:[]u8=z_alloc(32);
  let fin:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let d:i32=1;
  while(d<=maxd){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*P; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*P; k=k+1; }
      let rem:i32=si;
      let i:i32=0;
      let nwait:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/P; }
        let kk:i32=0; let vv:i32=0;
        if(dig<2*nctrl){
          vv=ctrl[dig/2] as i32;
          if(dig%2==0){ kk=0; } else { kk=1; }
        }
        else { kk=2; vv=0; nwait=nwait+1; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        full_sk[i]=kk as u8; full_sv[i]=vv as u8;
        i=i+1;
      }
      full_sk[d]=2; full_sv[d]=0;
      full_sk[d+1]=2; full_sv[d+1]=0;
      full_sk[d+2]=2; full_sv[d+2]=0;
      let flen:i32=d+3;
      let nn:i32=L_sim(hyprules[h0*ne*5..h0*ne*5+ne*5],ne,nvars,full_sk,full_sv,flen,init,ob,fin,hist,cxs,nctx);
      if(nn>=0){
        // v5 SOUNDNESS TIGHTENING (generic): the 3-consecutive-goal-step
        // window must sit exactly at [nwait, nwait+2], the steps the real
        // SUFFIX observes. The v4 check admitted any window in the
        // trajectory, which is not SUFFIX-sound.
        let s:i32=nwait;
        let ok3:i32=1;
        let q:i32=0;
        while(q<3){
          g=0;
          while(g<ng){
            if(hist[(gv[g] as i32)*32+s+q]!=gval[g]){ ok3=0; }
            g=g+1;
          }
          q=q+1;
        }
        if(ok3==1){ return d; }
      }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// Build the SUFFIX measurement protocol programmatically (prereg section 6):
// [OBS v for v in goalvars ascending, WAIT] repeated 3 times.
// Fixed protocol, disclosed; constructed, never a literal; no manipulations.
fn L_build_suffix(gv:[]u8, ng:i32, mlen:i32, msk:[]u8, msv:[]u8,
                  fsk:[]u8, fsv:[]u8)i32 {
  let i:i32=0;
  while(i<mlen){ fsk[i]=msk[i]; fsv[i]=msv[i]; i=i+1; }
  let jj:i32=0;
  while(jj<3){
    let g:i32=0;
    while(g<ng){
      fsk[mlen+jj*(ng+1)+g]=3; fsv[mlen+jj*(ng+1)+g]=gv[g];
      g=g+1;
    }
    fsk[mlen+jj*(ng+1)+ng]=2; fsv[mlen+jj*(ng+1)+ng]=0;
    jj=jj+1;
  }
  return mlen+3*(ng+1);
}

// ============ one learning wave ============
// A wave = passive -> candidates -> hypotheses -> discriminate ->
// w_verify -> plan -> execute -> verify. All learner state for the wave
// is wave-local; the world state ws is shared across waves (so world-side
// regime state persists across the revision boundary). Results go to res
// (128 bytes):
//   +0 mask (i32, v4-style bits: bit0 R1, bit1 R3, bit2 R5a, bit3 R5b,
//      bit4 R6, bit5 convergence), +4 met (i32, goal for real),
//   +8 obs_used (i32), +12 conv (i32, raw w_verify return),
//   +16 plan_len (i32, 0 if none found), +20 nver (i32),
//   +24 ver_pred[16], +40 ver_act[16] (model-predicted vs real
//      verification observations; SUFFIX log for C2 mode, final-state
//      observations for World A mode),
//   +52 nalive (i32), +56 ne (i32, 0 if nalive != 1),
//   +60 sig[ne*5] (survivor's rule bytes, canonical; for the v6
//      fixed-point stop in L_run).
// expect_conv: the w_verify return value counting as convergence
// (the matched regime number on a latch world).
fn L_wave(ws:[]u8, wave:i32, expect_conv:i32, res:[]u8)void {
  let mask:i32=0;
  let nvars:i32=w_nvars();
  let nctrl:i32=w_nctrl();
  let ctrl:[]u8=z_alloc(nctrl);
  let i:i32=0;
  while(i<nctrl){ ctrl[i]=w_ctrl(i) as u8; i=i+1; }
  let npass:i32=w_npass();
  let nctx:i32=w_nctx();
  let cxs:[]u8=z_alloc(nctx);
  let cvs:[]u8=z_alloc(nctx);
  i=0;
  while(i<nctx){ cxs[i]=w_ctx_cx(i) as u8; cvs[i]=w_ctx_cv(i) as u8; i=i+1; }
  emit("WAVE "); e64(wave); emit(" ");
  emit("WORLD "); emit(w_worldname()); emit(" nvars="); e64(nvars);
  emit(" nctrl="); e64(nctrl); emit(" npass="); e64(npass);
  emit(" nctx="); e64(nctx); emit("\n");

  // v5 verification record (feeds the revision trigger in L_run)
  let vmet:i32=0;
  let vplan:i32=0;
  let vnver:i32=0;
  let vpred:[]u8=z_alloc(16);
  let vact:[]u8=z_alloc(16);

  // ---- passive phase (free given data) ----
  w_reset(ws);
  let trace:[]u8=z_alloc(nvars*npass);
  let t:i32=0;
  while(t<npass){
    w_passive(ws);
    let snap:[]u8=z_alloc(nvars);
    w_snapshot(ws,snap);
    let v:i32=0;
    while(v<nvars){ trace[v*npass+t]=snap[v]; v=v+1; }
    if(t<npass-1){ w_act(ws,2,0); } // WAIT: advance the world clock
    t=t+1;
  }

  // ---- candidate generation ----
  let candbuf:[]u8=z_alloc(nvars*L_MAXC()*5);
  let candn:[]u8=z_alloc(nvars);
  L_gencands(trace,npass,nvars,cxs,cvs,nctx,candbuf,candn);
  emit("CANDIDATES\n");
  let v:i32=0;
  while(v<nvars){
    emit("  "); emit(w_vname(v)); emit(": ");
    e64(candn[v] as i32); emit(" [");
    let j:i32=0;
    while(j<(candn[v] as i32)){
      if(j>0){ emit("; "); }
      let rb:[]u8=z_alloc(5);
      let k:i32=0;
      while(k<5){ rb[k]=candbuf[(v*L_MAXC()+j)*5+k]; k=k+1; }
      L_emit_rule(rb);
      j=j+1;
    }
    emit("]\n");
    v=v+1;
  }

  // ---- hypothesis enumeration ----
  let evars:[]u8=z_alloc(nvars);
  let ne:i32=0;
  v=0;
  while(v<nvars){
    if((candn[v] as i32)>0){ evars[ne]=v as u8; ne=ne+1; }
    v=v+1;
  }
  let nhyp:i32=1;
  let j:i32=0;
  while(j<ne){ nhyp=nhyp*(candn[evars[j] as i32] as i32); j=j+1; }
  emit("NHYP "); e64(nhyp); emit(" ne="); e64(ne); emit("\n");
  let hysel:[]u8=z_alloc(nhyp*ne);
  let h:i32=0;
  while(h<nhyp){
    let rem:i32=h;
    j=0;
    while(j<ne){
      let base:i32=candn[evars[j] as i32] as i32;
      hysel[h*ne+j]=(rem%base) as u8;
      rem=rem/base;
      j=j+1;
    }
    h=h+1;
  }
  let hyprules:[]u8=z_alloc(nhyp*ne*5);
  h=0;
  while(h<nhyp){
    j=0;
    while(j<ne){
      let vv:i32=evars[j] as i32;
      let ci:i32=hysel[h*ne+j] as i32;
      let k:i32=0;
      while(k<5){ hyprules[(h*ne+j)*5+k]=candbuf[(vv*L_MAXC()+ci)*5+k]; k=k+1; }
      j=j+1;
    }
    h=h+1;
  }
  let alive:[]u8=z_alloc(nhyp);
  h=0; while(h<nhyp){ alive[h]=1; h=h+1; }
  let nalive:i32=nhyp;

  if(nhyp>=2){ mask=mask|1; emit("K4-R1 PASS nhyp>=2\n"); }
  else { emit("K4-R1 FAIL nhyp<2\n"); }

  // ---- experiment loop: standard scan + DPDS discrimination phase ----
  let fsk:[]u8=z_alloc(8);
  let fsv:[]u8=z_alloc(8);
  let preds:[]u8=z_alloc(nhyp*16);
  let predn:[]u8=z_alloc(nhyp);
  let dsk:[]u8=z_alloc(10);
  let dsv:[]u8=z_alloc(10);
  let dpair:[]u8=z_alloc(8);
  let dp:[]u8=z_alloc(2);
  let obs_used:i32=0;
  let search_ok:i32=1;
  let exhausted:i32=0;
  let round:i32=0;
  // discrimination ledger: learner-created persistent state, allocated once,
  // appended once per discrimination experiment, persists across rounds
  let reclen:i32=50+nhyp;
  let led:[]u8=z_alloc(40*reclen);
  let ledn:i32=0;
  let init0:[]u8=z_alloc(nvars);
  let simob:[]u8=z_alloc(16);
  let simfin:[]u8=z_alloc(nvars);
  let simhist:[]u8=z_alloc(nvars*32);
  while(1==1){
    round=round+1;
    if(round>40){ emit("ROUND_CAP\n"); break; }
    let c0:i32=w_ncalls(ws);
    let flen:i32=L_find(hyprules,alive,nhyp,ne,nvars,nctrl,ctrl,cxs,nctx,fsk,fsv,preds,predn);
    let c1:i32=w_ncalls(ws);
    emit("SEARCH round="); e64(round); emit(" world_calls="); e64(c1-c0); emit("\n");
    if(c1!=c0){ search_ok=0; }
    if(flen>0){
      // standard discriminating experiment (unchanged v2 path)
      let nobs:i32=0;
      i=0; while(i<flen){ if((fsk[i] as i32)==3){ nobs=nobs+1; } i=i+1; }
      if(obs_used+nobs>L_BUDGET()){ emit("BUDGET_OUT\n"); break; }
      emit("SELECT "); L_emit_seq(fsk,fsv,flen); emit("\n");
      h=0;
      while(h<nhyp){
        if(alive[h]==1){
          emit("  hyp"); e64(h); emit(" predicts [");
          let q:i32=0;
          while(q<(predn[h] as i32)){ if(q>0){emit(",");} e64(preds[h*16+q] as i32); q=q+1; }
          emit("]\n");
        }
        h=h+1;
      }
      w_reset(ws);
      let act:[]u8=z_alloc(16);
      let an:i32=0;
      i=0;
      while(i<flen){
        let o:i32=w_act(ws,fsk[i] as i32,fsv[i] as i32);
        if((fsk[i] as i32)==3){ act[an]=o as u8; an=an+1; }
        i=i+1;
      }
      obs_used=obs_used+nobs;
      emit("EXEC actual [");
      i=0; while(i<an){ if(i>0){emit(",");} e64(act[i] as i32); i=i+1; }
      emit("]\n");
      let killed:[]u8=z_alloc(nhyp);
      h=0;
      while(h<nhyp){
        if(alive[h]==1){
          let same:i32=1;
          if((predn[h] as i32)!=an){ same=0; }
          else {
            let q:i32=0;
            while(q<an){ if(preds[h*16+q]!=act[q]){ same=0; } q=q+1; }
          }
          if(same==0){ alive[h]=0; killed[h]=1; nalive=nalive-1; }
        }
        h=h+1;
      }
      emit("KILLED [");
      let first:i32=1;
      h=0;
      while(h<nhyp){ if(killed[h]==1){ if(first==0){emit(",");} e64(h); first=0; } h=h+1; }
      emit("] nalive="); e64(nalive); emit("\n");
      if(nalive==0){ emit("TRUTH_LOST FAIL\n"); break; }
      if(nalive==1){ break; }
    } else {
      // standard scan exhausted: DPDS continuation (prereg 3.1)
      if(nalive<=1){ break; }
      let d0:i32=w_ncalls(ws);
      let dlen:i32=L_dpds(hyprules,alive,nhyp,ne,nvars,nctrl,ctrl,evars,cxs,nctx,dsk,dsv,dpair,dp);
      let d1c:i32=w_ncalls(ws);
      emit("DPDS round="); e64(round); emit(" world_calls="); e64(d1c-d0);
      emit(" found_len="); e64(dlen); emit("\n");
      if(d1c!=d0){ search_ok=0; }
      if(dlen==0){
        exhausted=1;
        emit("DPDS_EXHAUSTION no live pair distinguishes to D2\n");
        break;
      }
      let pi2:i32=get32(dpair,0);
      let pj2:i32=get32(dpair,4);
      let predi:i32=dp[0] as i32;
      let predj:i32=dp[1] as i32;
      if(obs_used+1>L_BUDGET()){ emit("BUDGET_OUT\n"); break; }
      // RESET; execute the selected distinguishing sequence exactly once
      w_reset(ws);
      let act:[]u8=z_alloc(16);
      let an:i32=0;
      i=0;
      while(i<dlen){
        let o:i32=w_act(ws,dsk[i] as i32,dsv[i] as i32);
        if((dsk[i] as i32)==3){ act[an]=o as u8; an=an+1; }
        i=i+1;
      }
      obs_used=obs_used+an;
      emit("EXEC_DPDS actual [");
      i=0; while(i<an){ if(i>0){emit(",");} e64(act[i] as i32); i=i+1; }
      emit("]\n");
      // eliminate EVERY live hypothesis whose prediction contradicts actual
      let killed:[]u8=z_alloc(nhyp);
      let nkilled:i32=0;
      h=0;
      while(h<nhyp){
        if(alive[h]==1){
          let nn:i32=L_sim(hyprules[h*ne*5..h*ne*5+ne*5],ne,nvars,dsk,dsv,dlen,init0,simob,simfin,simhist,cxs,nctx);
          let same:i32=1;
          if(nn!=an){ same=0; }
          else {
            let q:i32=0;
            while(q<an){ if(simob[q]!=act[q]){ same=0; } q=q+1; }
          }
          if(same==0){ alive[h]=0; killed[h]=1; nalive=nalive-1; nkilled=nkilled+1; }
        }
        h=h+1;
      }
      emit("KILLED_DPDS [");
      let first2:i32=1;
      h=0;
      while(h<nhyp){ if(killed[h]==1){ if(first2==0){emit(",");} e64(h); first2=0; } h=h+1; }
      emit("] nalive="); e64(nalive); emit("\n");
      // append to the discrimination ledger (prereg section 4)
      let actual0:i32=-1;
      if(an>0){ actual0=act[0] as i32; }
      ledn=L_ledger_append(led,ledn,reclen,nhyp,round,pi2,pj2,dsk,dsv,dlen,
                           predi,predj,actual0,killed,nkilled);
      L_ledger_emit(round,pi2,pj2,dsk,dsv,dlen,predi,predj,actual0,killed,nhyp);
      if(nalive==0){ emit("TRUTH_LOST FAIL\n"); break; }
      if(nalive==1){ break; }
    }
  }
  emit("SURVIVORS [");
  let first3:i32=1;
  h=0;
  while(h<nhyp){ if(alive[h]==1){ if(first3==0){emit(",");} e64(h); first3=0; } h=h+1; }
  emit("] exhausted="); e64(exhausted); emit(" ledger_n="); e64(ledn); emit("\n");

  if(search_ok==1){ mask=mask|2; emit("K4-R3 PASS zero world calls in search\n"); }
  else { emit("K4-R3 FAIL world calls during search\n"); }

  // ---- world-side convergence adjudication ----
  let conv:i32=w_verify(alive,hysel,evars,ne,nhyp,candbuf,exhausted,nalive);

  // ---- goal phase ----
  let h0:i32=0;
  while(h0<nhyp){ if(alive[h0]==1){ break; } h0=h0+1; }
  w_reset(ws);
  w_goal_setup(ws);
  let init:[]u8=z_alloc(nvars);
  w_snapshot(ws,init);
  let gmode:i32=w_goal_mode();
  if(gmode==0){
    // ===== World A: final-state goal (REPLICATED EXACTLY from v2) =====
    let psk:[]u8=z_alloc(10);
    let psv:[]u8=z_alloc(10);
    let plen:i32=L_plan(hyprules,h0,ne,nvars,nctrl,ctrl,init,w_plan_maxd(),cxs,nctx,psk,psv);
    if(plen==0){ emit("PLAN none found FAIL\n"); }
    else {
      emit("PLAN "); L_emit_seq(psk,psv,plen); emit("\n");
      let ob:[]u8=z_alloc(16);
      let fin0:[]u8=z_alloc(nvars);
      let hist:[]u8=z_alloc(nvars*32);
      let nn:i32=L_sim(hyprules[h0*ne*5..h0*ne*5+ne*5],ne,nvars,psk,psv,plen,init,ob,fin0,hist,cxs,nctx);
      let agree:i32=1;
      h=0;
      while(h<nhyp){
        if(alive[h]==1 && h!=h0){
          let finh:[]u8=z_alloc(nvars);
          L_sim(hyprules[h*ne*5..h*ne*5+ne*5],ne,nvars,psk,psv,plen,init,ob,finh,hist,cxs,nctx);
          v=0;
          while(v<nvars){ if(finh[v]!=fin0[v]){ agree=0; } v=v+1; }
        }
        h=h+1;
      }
      emit("PLAN_AGREEMENT "); e64(agree); emit("\n");
      w_reset(ws);
      w_goal_setup(ws);
      i=0;
      while(i<plen){ w_act(ws,psk[i] as i32,psv[i] as i32); i=i+1; }
      let gvals:[]u8=z_alloc(nvars);
      let nobs2:i32=0;
      v=0;
      while(v<nvars){
        let o:i32=w_act(ws,3,v);
        gvals[v]=o as u8;
        nobs2=nobs2+1;
        v=v+1;
      }
      obs_used=obs_used+nobs2;
      let met:i32=w_goal_met(gvals);
      emit("GOAL_REAL "); e64(met); emit("\n");
      if(met==1){ mask=mask|4; }
      // v5 verification record: predicted (simulated) vs actual final obs
      vmet=met; vplan=plen; vnver=nvars;
      v=0;
      while(v<nvars){
        if(v<16){ vpred[v]=fin0[v]; vact[v]=gvals[v]; }
        v=v+1;
      }
      let seed:i64=12345;
      let P:i32=2*nctrl+1;
      let rlen:i32=plen+2;
      let rsucc:i32=0;
      let r:i32=0;
      while(r<20){
        let rs:[]u8=z_alloc(10);
        let rv:[]u8=z_alloc(10);
        i=0;
        while(i<rlen){
          seed=(seed*1103515245+12345)%2147483648;
          let dig:i32=(seed%P) as i32;
          let kk:i32=0; let vv:i32=0;
          if(dig<nctrl){ kk=0; vv=ctrl[dig] as i32; }
          else if(dig<2*nctrl){ kk=1; vv=ctrl[dig-nctrl] as i32; }
          else { kk=2; vv=0; }
          rs[i]=kk as u8; rv[i]=vv as u8;
          i=i+1;
        }
        w_reset(ws);
        w_goal_setup(ws);
        i=0;
        while(i<rlen){ w_act(ws,rs[i] as i32,rv[i] as i32); i=i+1; }
        let gs:[]u8=z_alloc(nvars);
        w_snapshot(ws,gs);
        if(w_goal_met(gs)==1){ rsucc=rsucc+1; }
        r=r+1;
      }
      emit("RANDOM_BASELINE "); e64(rsucc); emit("/20\n");
      if(rsucc==0){ mask=mask|8; }
    }
  } else {
    // ===== Dual contextual worlds: C2 sustained goal (prereg section 6) =====
    // Predicate and SUFFIX are generic over the w_ngoalvars interface.
    let ng:i32=w_ngoalvars();
    let gv:[]u8=z_alloc(ng);
    let gval:[]u8=z_alloc(ng);
    let g:i32=0;
    while(g<ng){ gv[g]=w_goalvar(g) as u8; gval[g]=w_goalval(g) as u8; g=g+1; }
    let msk:[]u8=z_alloc(12);
    let msv:[]u8=z_alloc(12);
    let mlen:i32=L_plan_c2(hyprules,h0,ne,nvars,nctrl,ctrl,init,w_plan_maxd(),cxs,nctx,msk,msv);
    if(mlen==0){ emit("PLAN_C2 none found FAIL\n"); }
    else {
      // full plan = M + SUFFIX (programmatically constructed, no literal)
      let fsk:[]u8=z_alloc(48);
      let fsv:[]u8=z_alloc(48);
      let flen:i32=L_build_suffix(gv,ng,mlen,msk,msv,fsk,fsv);
      emit("PLAN_C2 M="); L_emit_seq(msk,msv,mlen); emit(" full_len="); e64(flen); emit("\n");
      // agreement across all survivors on the simulated observation log:
      // h0 must see the goalval pattern; every other survivor must agree
      let ob:[]u8=z_alloc(48);
      let fin0:[]u8=z_alloc(nvars);
      let hist:[]u8=z_alloc(nvars*32);
      let nn:i32=L_sim(hyprules[h0*ne*5..h0*ne*5+ne*5],ne,nvars,fsk,fsv,flen,init,ob,fin0,hist,cxs,nctx);
      let agree:i32=1;
      if(nn!=3*ng){ agree=0; }
      else {
        let rep:i32=0;
        while(rep<3){
          g=0;
          while(g<ng){
            if((ob[rep*ng+g] as i32)!=(gval[g] as i32)){ agree=0; }
            g=g+1;
          }
          rep=rep+1;
        }
      }
      h=0;
      while(h<nhyp){
        if(alive[h]==1 && h!=h0){
          let obh:[]u8=z_alloc(48);
          let finh:[]u8=z_alloc(nvars);
          let nnh:i32=L_sim(hyprules[h*ne*5..h*ne*5+ne*5],ne,nvars,fsk,fsv,flen,init,obh,finh,hist,cxs,nctx);
          if(nnh!=nn){ agree=0; }
          else {
            let q:i32=0;
            while(q<nn){ if(obh[q]!=ob[q]){ agree=0; } q=q+1; }
          }
        }
        h=h+1;
      }
      emit("PLAN_AGREEMENT "); e64(agree); emit("\n");
      // execute for real: RESET, setup, M+SUFFIX, log 3*ng observations
      // (SUFFIX layout is [OBS gv[0..ng-1], WAIT] x 3, so the ocnt-th
      // observation fills olog[ocnt] = olog[rep*ng+g] in order)
      w_reset(ws);
      w_goal_setup(ws);
      let olog:[]u8=z_alloc(3*ng);
      let ocnt:i32=0;
      i=0;
      while(i<flen){
        let kk:i32=fsk[i] as i32;
        let vv:i32=fsv[i] as i32;
        if(kk==3){
          let o:i32=w_act(ws,kk,vv);
          if(ocnt<3*ng){ olog[ocnt]=o as u8; }
          ocnt=ocnt+1;
        } else {
          w_act(ws,kk,vv);
        }
        i=i+1;
      }
      obs_used=obs_used+3*ng;
      let met:i32=1;
      if(ocnt!=3*ng){ met=0; }
      else {
        let rep:i32=0;
        while(rep<3){
          g=0;
          while(g<ng){
            if((olog[rep*ng+g] as i32)!=(gval[g] as i32)){ met=0; }
            g=g+1;
          }
          rep=rep+1;
        }
      }
      emit("GOAL_REAL_C2 "); e64(met); emit(" obs=[");
      let q:i32=0;
      while(q<3*ng){
        if(q>0){ emit(","); }
        e64(olog[q] as i32);
        q=q+1;
      }
      emit("]\n");
      if(met==1){ mask=mask|4; }
      // v5 verification record: predicted (simulated SUFFIX log) vs
      // actual SUFFIX observations. A mismatch here with met==0 is the
      // revision trigger: the plan was right under the model, wrong
      // in the world.
      vmet=met; vplan=mlen; vnver=3*ng;
      q=0;
      while(q<3*ng){
        if(q<16){ vpred[q]=ob[q]; vact[q]=olog[q]; }
        q=q+1;
      }
      // random-action control: (2*nctrl+1)-symbol LISTED manipulation
      // alphabet {SET c0, CLR c0, ...} + WAIT, fixed-seed LCG, length
      // len(M)+17. Semantic trajectory predicate (cause, not observe):
      // real trajectory contains three consecutive steps with every
      // goalvar equal to its goal value. Most generous fair reading.
      let seed:i64=12345;
      let P2:i32=2*nctrl+1;
      let rlen:i32=mlen+17;
      let rsucc:i32=0;
      let r:i32=0;
      while(r<20){
        let rs:[]u8=z_alloc(48);
        let rv:[]u8=z_alloc(48);
        i=0;
        while(i<rlen){
          seed=(seed*1103515245+12345)%2147483648;
          let dig:i32=(seed%P2) as i32;
          let kk:i32=0; let vv:i32=0;
          if(dig<2*nctrl){
            vv=ctrl[dig/2] as i32;
            if(dig%2==0){ kk=0; } else { kk=1; }
          }
          else { kk=2; vv=0; }
          rs[i]=kk as u8; rv[i]=vv as u8;
          i=i+1;
        }
        w_reset(ws);
        w_goal_setup(ws);
        // trajectory: snapshot at t=0 and after each WAIT
        let traj:[]u8=z_alloc(48*nvars);
        let nsteps:i32=0;
        let snap:[]u8=z_alloc(nvars);
        w_snapshot(ws,snap);
        v=0; while(v<nvars){ traj[nsteps*nvars+v]=snap[v]; v=v+1; }
        nsteps=nsteps+1;
        i=0;
        while(i<rlen){
          let kk:i32=rs[i] as i32;
          let vv:i32=rv[i] as i32;
          w_act(ws,kk,vv);
          if(kk==2){
            w_snapshot(ws,snap);
            v=0; while(v<nvars){ traj[nsteps*nvars+v]=snap[v]; v=v+1; }
            nsteps=nsteps+1;
          }
          i=i+1;
        }
        let s:i32=0;
        let found:i32=0;
        while(s+2<nsteps){
          let ok3:i32=1;
          let qq:i32=0;
          while(qq<3){
            g=0;
            while(g<ng){
              if(traj[(s+qq)*nvars+(gv[g] as i32)]!=gval[g]){ ok3=0; }
              g=g+1;
            }
            qq=qq+1;
          }
          if(ok3==1){ found=1; }
          s=s+1;
        }
        if(found==1){ rsucc=rsucc+1; }
        r=r+1;
      }
      emit("RANDOM_BASELINE_C2 "); e64(rsucc); emit("/20\n");
      if(rsucc==0){ mask=mask|8; }
    }
  }

  emit("OBS_USED "); e64(obs_used); emit("\n");
  if(obs_used<=L_BUDGET()){ mask=mask|16; emit("K4-R6 PASS budget\n"); }
  else { emit("K4-R6 FAIL budget\n"); }

  if(conv==expect_conv){ mask=mask|32; }
  emit("MASK "); e64(mask); emit("\n");
  // ---- v5 result buffer ----
  set32(res,0,mask);
  set32(res,4,vmet);
  set32(res,8,obs_used);
  set32(res,12,conv);
  set32(res,16,vplan);
  set32(res,20,vnver);
  let qi:i32=0;
  while(qi<16){
    if(qi<vnver){ res[24+qi]=vpred[qi]; res[40+qi]=vact[qi]; }
    else { res[24+qi]=0; res[40+qi]=0; }
    qi=qi+1;
  }
  // v6: convergence signature for the fixed-point stop (L_run).
  // Canonical rule bytes of the survivor (h0), valid only if nalive==1.
  set32(res,52,nalive);
  if(nalive==1 && h0<nhyp){
    set32(res,56,ne);
    let b3:i32=0;
    while(b3<ne*5){
      res[60+b3]=hyprules[(h0*ne+b3/5)*5+b3%5];
      b3=b3+1;
    }
  } else {
    set32(res,56,0);
  }
  return;
}

// ============ v6 orchestrator: evidence-driven revision loop ============
// Wave 1 runs the full cycle. After each wave, if its executed plan was
// correct under the converged model but the world's real verification
// observations contradict the model's predictions (plan found, goal not
// met for real, predicted != actual, exactly one survivor), the world
// changed mid-stream: another revision wave runs (fresh passive trace in
// the new regime, full re-discrimination, re-verification, re-plan,
// re-execution). The loop continues while each wave ends in a
// prediction-vs-observation contradiction under a NEWLY converged law
// set. It stops when (a) a wave's plan verifies for real (goal met),
// (b) a wave re-converges to a law set already seen in this run
// (fixed point: further waves would repeat identically; honest FAIL, no
// infinite regress), or (c) a wave ends without a contradiction (the
// planner lied or no plan; honest FAIL). There is no researcher-set
// revision count; the stopping conditions are learner-verifiable. The
// wave-safety cap (6) is pure engineering hygiene against pathological
// infinite-regime worlds, never hit in eval.
// Return encoding (v6):
//   bits 0-5: FINAL wave's v4-style mask.
//   bits 8-10: number of revision waves triggered.
//   bit 11: fixed-point stop hit (1).
// A single-wave run (no revision) returns the v4-style mask unchanged,
// so frozen v4 world mains (which check m==63) keep working.
fn L_run()i32 {
  let nvars:i32=w_nvars();
  let ws:[]u8=z_alloc(8+nvars*32);
  let sigs:[]u8=z_alloc(8*40);
  let nsig:i32=0;
  let wave:i32=1;
  let nrev:i32=0;
  let fp:i32=0;
  let mlast:i32=0;
  while(1==1){
    let res:[]u8=z_alloc(128);
    L_wave(ws,wave,wave,res);
    let m1:i32=get32(res,0);
    let met1:i32=get32(res,4);
    let plan1:i32=get32(res,16);
    let nver1:i32=get32(res,20);
    let nalive1:i32=get32(res,52);
    let ne1:i32=get32(res,56);
    mlast=m1;
    if(nver1>16){ nver1=16; }
    let mismatch:i32=0;
    let q:i32=0;
    while(q<nver1){
      if(res[24+q]!=res[40+q]){ mismatch=1; }
      q=q+1;
    }
    if(mismatch==1){
      emit("PRED_VS_ACTUAL wave="); e64(wave); emit(" pred=[");
      q=0;
      while(q<nver1){ if(q>0){ emit(","); } e64(res[24+q] as i32); q=q+1; }
      emit("] actual=[");
      q=0;
      while(q<nver1){ if(q>0){ emit(","); } e64(res[40+q] as i32); q=q+1; }
      emit("]\n");
    }
    // Wave outcome dispatch.
    if(plan1>0 && met1==1){
      emit("V6DONE wave="); e64(wave); emit(" goal met for real\n");
      break;
    }
    if(plan1>0 && met1==0 && mismatch==1 && nalive1==1 && ne1>0){
      // Contradiction under a converged model: fixed-point check, else
      // record this wave's law signature and revise.
      let seen:i32=0;
      let s:i32=0;
      while(s<nsig){
        let same:i32=1;
        if((sigs[s*40] as i32)!=ne1){ same=0; }
        else {
          let b:i32=0;
          while(b<ne1*5){
            if(sigs[s*40+1+b]!=res[60+b]){ same=0; }
            b=b+1;
          }
        }
        if(same==1){ seen=1; }
        s=s+1;
      }
      if(seen==1){
        emit("FIXED_POINT wave="); e64(wave);
        emit(" re-converged to seen laws; stop, no infinite regress\n");
        fp=1;
        break;
      }
      sigs[nsig*40]=ne1 as u8;
      let b2:i32=0;
      while(b2<ne1*5){ sigs[nsig*40+1+b2]=res[60+b2]; b2=b2+1; }
      nsig=nsig+1;
      nrev=nrev+1;
      emit("REVISION_TRIGGER wave="); e64(wave);
      emit(" contradiction -> revision wave="); e64(wave+1); emit("\n");
      wave=wave+1;
    } else {
      emit("V6DONE wave="); e64(wave);
      emit(" no contradiction; stop (plan="); e64(plan1);
      emit(" met="); e64(met1); emit(" mismatch="); e64(mismatch);
      emit(" nalive="); e64(nalive1); emit(")\n");
      break;
    }
    if(wave>6){
      emit("WAVE_SAFETY_CAP wave="); e64(wave); emit(" stop\n");
      break;
    }
  }
  emit("V6RETURN mlast="); e64(mlast); emit(" nrev="); e64(nrev);
  emit(" fp="); e64(fp); emit("\n");
  return (mlast&0x3F)|(nrev<<8)|(fp<<11);
}

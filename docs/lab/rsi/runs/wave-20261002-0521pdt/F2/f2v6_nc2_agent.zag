// f2v6_nc2_agent.zag -- NC2 agent: passive replay (no model, no revision).
// Stores the passive trace, then acts by replaying the passive X-pulse
// cadence after establishing the contexts: SET J, SET K, then X pulses at
// the same relative times as the passive (t = 3, 8, 13). No causal model,
// no discrimination, no simulation under hypotheses, no revision. Uses
// only the w_* environment interface; the true laws in the environment
// section below are the world's physics, never read by the agent.
// The replay runs after one goal setup, so the latch has fired once: the
// attempt executes in Regime 2 while the replayed cadence was memorized
// in Regime 1. Expected: NC2_RESULT 0.

fn main()i32 {
  let ws:[]u8=z_alloc(8+5*32);
  // trajectory 0: passive (18 steps); record X pulse times
  w_reset(ws);
  let pt:[]u8=z_alloc(18);
  let t:i32=0;
  while(t<18){
    w_passive(ws);
    let snap:[]u8=z_alloc(5);
    w_snapshot(ws,snap);
    pt[t]=snap[0];
    if(t<17){ w_act(ws,2,0); }
    t=t+1;
  }
  // goal attempt: reset, setup (fires latch -> Regime 2), set contexts,
  // replay the memorized X cadence
  w_reset(ws);
  w_goal_setup(ws);
  w_act(ws,0,3); // SJ
  w_act(ws,0,4); // SK
  let traj:[]u8=z_alloc(18*5);
  let nsteps:i32=0;
  let s2:[]u8=z_alloc(5);
  w_snapshot(ws,s2);
  let v:i32=0;
  while(v<5){ traj[nsteps*5+v]=s2[v]; v=v+1; }
  nsteps=nsteps+1;
  t=1;
  while(t<18){
    if(pt[t]==1){ w_act(ws,0,0); } // SX at the memorized cadence
    w_act(ws,2,0); // WAIT
    w_snapshot(ws,s2);
    v=0;
    while(v<5){ traj[nsteps*5+v]=s2[v]; v=v+1; }
    nsteps=nsteps+1;
    t=t+1;
  }
  // sustained triple predicate on the real trajectory
  let ng:i32=w_ngoalvars();
  let found:i32=0;
  let st:i32=0;
  while(st+2<nsteps){
    let ok3:i32=1;
    let qq:i32=0;
    while(qq<3){
      let g:i32=0;
      while(g<ng){
        let gv:i32=w_goalvar(g);
        if((traj[(st+qq)*5+gv] as i32)!=w_goalval(g)){ ok3=0; }
        g=g+1;
      }
      qq=qq+1;
    }
    if(ok3==1){ found=1; }
    st=st+1;
  }
  emit("NC2_RESULT "); e64(found); emit("\n");
  if(found==0){ return 0; }
  return 1;
}

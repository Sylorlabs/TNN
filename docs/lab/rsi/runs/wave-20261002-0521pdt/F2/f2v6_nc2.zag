fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

fn L_ispersist(e:i32, cxs:[]u8, nctx:i32)i32 {
  let x:i32=0;
  while(x<nctx){
    if((cxs[x] as i32)==e){ return 1; }
    x=x+1;
  }
  return 0;
}

// ============ generic rule advance ============
// hist: nvars*32 bytes. rules: nr*5 bytes of [c,e,d,cx,cv], cx=255 means ALWAYS.
// Declared context vars (cx set) are PERSISTENT: retain value across WAIT.
// Every other variable with no applicable rule becomes 0 (decay).
// t must be >= 1. Used by BOTH the sealed world and learner simulation.
fn L_advance(hist:[]u8, t:i32, rules:[]u8, nr:i32, nvars:i32, cxs:[]u8, nctx:i32)void {
  let e:i32=0;
  while(e<nvars){
    if(L_ispersist(e,cxs,nctx)==1){
      hist[e*32+t]=hist[e*32+t-1];
    } else {
      let nv:i32=0;
      let r:i32=0;
      while(r<nr){
        let b:i32=r*5;
        if((rules[b+1] as i32)==e){
          let c:i32=rules[b] as i32;
          let d:i32=rules[b+2] as i32;
          let s:i32=t-d;
          if(s>=0 && hist[c*32+s]==1){
            let cx:i32=rules[b+3] as i32;
            if(cx==255){ nv=1; }
            else if(hist[cx*32+s]==rules[b+4]){ nv=1; }
          }
        }
        r=r+1;
      }
      hist[e*32+t]=nv as u8;
    }
    e=e+1;
  }
  return;
}

// ============ candidate generation (generic, unchanged from v2) ============
// trace: nvars*npass bytes. candbuf: nvars*36*5 bytes. candn: nvars bytes.
// Contexts from the world's context set (cxs, cvs, nctx).
// Declared persistent vars are skipped as EFFECTS (disclosed physics:
// they change only via SET/CLR, so no rule can govern them).

// f2v6_nc2_agent.zag -- NC2 agent: passive replay (no model, no revision).
// Stores the passive trace, then acts by replaying the passive X-pulse
// cadence after establishing the contexts: SET J, SET K, then X pulses at
// the same relative times as the passive (t = 3, 8, 13). No causal model,
// no discrimination, no simulation under hypotheses, no revision. Uses
// only the w_* environment interface; the true laws in the environment
// section below are the world's physics, never read by the agent.
// The replay runs after one goal setup, so the latch has fired once: the
// attempt executes in Regime 2 while the replayed cadence was memorized
// in Regime 1. Expected: NC2_RESULT 0.

fn main()i32 {
  let ws:[]u8=z_alloc(8+5*32);
  // trajectory 0: passive (18 steps); record X pulse times
  w_reset(ws);
  let pt:[]u8=z_alloc(18);
  let t:i32=0;
  while(t<18){
    w_passive(ws);
    let snap:[]u8=z_alloc(5);
    w_snapshot(ws,snap);
    pt[t]=snap[0];
    if(t<17){ w_act(ws,2,0); }
    t=t+1;
  }
  // goal attempt: reset, setup (fires latch -> Regime 2), set contexts,
  // replay the memorized X cadence
  w_reset(ws);
  w_goal_setup(ws);
  w_act(ws,0,3); // SJ
  w_act(ws,0,4); // SK
  let traj:[]u8=z_alloc(18*5);
  let nsteps:i32=0;
  let s2:[]u8=z_alloc(5);
  w_snapshot(ws,s2);
  let v:i32=0;
  while(v<5){ traj[nsteps*5+v]=s2[v]; v=v+1; }
  nsteps=nsteps+1;
  t=1;
  while(t<18){
    if(pt[t]==1){ w_act(ws,0,0); } // SX at the memorized cadence
    w_act(ws,2,0); // WAIT
    w_snapshot(ws,s2);
    v=0;
    while(v<5){ traj[nsteps*5+v]=s2[v]; v=v+1; }
    nsteps=nsteps+1;
    t=t+1;
  }
  // sustained triple predicate on the real trajectory
  let ng:i32=w_ngoalvars();
  let found:i32=0;
  let st:i32=0;
  while(st+2<nsteps){
    let ok3:i32=1;
    let qq:i32=0;
    while(qq<3){
      let g:i32=0;
      while(g<ng){
        let gv:i32=w_goalvar(g);
        if((traj[(st+qq)*5+gv] as i32)!=w_goalval(g)){ ok3=0; }
        g=g+1;
      }
      qq=qq+1;
    }
    if(ok3==1){ found=1; }
    st=st+1;
  }
  emit("NC2_RESULT "); e64(found); emit("\n");
  if(found==0){ return 0; }
  return 1;
}

fn S2_D1R1()i32 { return 2; }
fn S2_D2R1()i32 { return 2; }
fn S2_D1R2()i32 { return 2; }
fn S2_D2R2()i32 { return 3; }
fn S2_D1R3()i32 { return 2; }
fn S2_D2R3()i32 { return 4; }
fn S2_J1()i32 { return 1; }
fn S2_K1()i32 { return 1; }

// ---- packed clock/counter cell ----
fn S2_t(ws:[]u8)i32 { return get32(ws,0)%1000; }
fn S2_setupcount(ws:[]u8)i32 { return (get32(ws,0)/1000)%1000; }
fn S2_regime(ws:[]u8)i32 {
  let r:i32=get32(ws,0)/1000000;
  if(r<1){ return 1; }
  if(r>3){ return 3; }
  return r;
}
fn S2_t_inc(ws:[]u8)void {
  set32(ws,0,get32(ws,0)+1);
  return;
}
fn S2_setup_inc(ws:[]u8)void {
  set32(ws,0,get32(ws,0)+1000);
  return;
}
fn S2_regime_set(ws:[]u8, r:i32)void {
  let c:i32=get32(ws,0);
  set32(ws,0,(c%1000000)+r*1000000);
  return;
}

fn S2_rules(reg:i32, r:[]u8)void {
  let d1:i32=S2_D1R1(); let d2:i32=S2_D2R1();
  if(reg==2){ d1=S2_D1R2(); d2=S2_D2R2(); }
  if(reg==3){ d1=S2_D1R3(); d2=S2_D2R3(); }
  r[0]=0; r[1]=1; r[2]=d1 as u8; r[3]=3; r[4]=S2_J1() as u8;
  r[5]=0; r[6]=2; r[7]=d2 as u8; r[8]=4; r[9]=S2_K1() as u8;
  return;
}

fn w_goal_mode()i32 { return 2; }
fn w_nvars()i32 { return 5; }
fn w_nctrl()i32 { return 3; }
fn w_ctrl(i:i32)i32 {
  if(i==0){ return 0; } // X
  if(i==1){ return 3; } // J
  return 4;             // K
}
fn w_npass()i32 { return 18; }
fn w_nctx()i32 { return 5; }
fn w_ctx_cx(i:i32)i32 {
  if(i==0){ return 255; } // ALWAYS
  if(i==1){ return 3; }   // J
  if(i==2){ return 3; }   // J
  if(i==3){ return 4; }   // K
  return 4;               // K
}
fn w_ctx_cv(i:i32)i32 {
  if(i==0){ return 0; } // ALWAYS (cv unused)
  if(i==1){ return 0; } // J == 0
  if(i==2){ return 1; } // J == 1
  if(i==3){ return 0; } // K == 0
  return 1;             // K == 1
}
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Y1"; }
  if(v==2){ return "Y2"; }
  if(v==3){ return "J"; }
  return "K";
}
fn w_worldname()[]u8 { return "SHIFT2-double-regime-SEALED"; }
fn w_plan_maxd()i32 { return 12; }
fn w_ngoalvars()i32 { return 4; }
fn w_goalvar(i:i32)i32 {
  if(i==0){ return 1; } // Y1
  if(i==1){ return 2; } // Y2
  if(i==2){ return 3; } // J
  return 4;             // K
}
fn w_goalval(i:i32)i32 {
  if(i==0){ return 1; } // Y1 = 1
  if(i==1){ return 1; } // Y2 = 1
  if(i==2){ return S2_J1(); } // J = j1
  return S2_K1();             // K = k1
}
fn D_cxs()[]u8 {
  let c:[]u8=z_alloc(5);
  c[0]=255; c[1]=3; c[2]=3; c[3]=4; c[4]=4;
  return c;
}

// ws layout: +0 tc (packed), +4 ncalls, +8 hist (nvars*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,(get32(ws,0)/1000)*1000); // zero t, keep setupcount+regime
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+5*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=S2_t(ws);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    S2_t_inc(ws);
    t=t+1;
    let hist:[]u8=ws[8..8+5*32];
    let rules:[]u8=z_alloc(10);
    S2_rules(S2_regime(ws),rules);
    L_advance(hist,t,rules,2,5,D_cxs(),5);
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=S2_t(ws);
  let v:i32=0;
  while(v<5){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule (sealed): 18 steps, t = 0..17. Environment SETs X
// at t = 3, 8, 13. J = 1 and K = 1 throughout (established at t = 0;
// both persistent). Regime-independent.
fn w_passive(ws:[]u8)void {
  let t:i32=S2_t(ws);
  if(t==0){ ws[8+3*32+t]=1; ws[8+4*32+t]=1; }
  if(t==3 || t==8 || t==13){ ws[8+0*32+t]=1; }
  return;
}
// Goal setup (disclosed schema): J = 0, K = 0 (both gates WRONG).
// Hidden latch: setup call #1 -> Regime 2; setup call #23 -> Regime 3.
fn w_goal_setup(ws:[]u8)void {
  ws[8+3*32+0]=0; // J = 0 (gate WRONG)
  ws[8+4*32+0]=0; // K = 0 (gate WRONG)
  S2_setup_inc(ws);
  let sc:i32=S2_setupcount(ws);
  if(sc==1){ S2_regime_set(ws,2); }
  if(sc==23){ S2_regime_set(ws,3); }
  return;
}
// Unused for goal mode 2 (C2 uses the triple predicate in the learner).
fn w_goal_met(vals:[]u8)i32 { return 0; }

// Harness adjudication for K6-R4 (SHIFT2 contract): the loop terminates
// with exactly one survivor, and its Y1/Y2 rules equal one regime's true
// laws. Returns the matched regime number (1, 2, 3), 0 otherwise.
fn S2_findrule(candbuf:[]u8, dst:i32, d:i32, gv:i32, gval:i32)i32 {
  let j:i32=0;
  while(j<36){
    let b:i32=(dst*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==d &&
       (candbuf[b+3] as i32)==gv && (candbuf[b+4] as i32)==gval){ return j; }
    j=j+1;
  }
  return -1;
}
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  let t11:i32=S2_findrule(candbuf,1,S2_D1R1(),3,S2_J1());
  let t12:i32=S2_findrule(candbuf,2,S2_D2R1(),4,S2_K1());
  let t21:i32=S2_findrule(candbuf,1,S2_D1R2(),3,S2_J1());
  let t22:i32=S2_findrule(candbuf,2,S2_D2R2(),4,S2_K1());
  let t31:i32=S2_findrule(candbuf,1,S2_D1R3(),3,S2_J1());
  let t32:i32=S2_findrule(candbuf,2,S2_D2R3(),4,S2_K1());
  let p1:i32=-1; let p2:i32=-1;
  let j:i32=0;
  while(j<ne){
    if((evars[j] as i32)==1){ p1=j; }
    if((evars[j] as i32)==2){ p2=j; }
    j=j+1;
  }
  let reg:i32=0;
  emit("S2_VERIFY nalive="); e64(nalive); emit(" exhausted="); e64(exhausted);
  emit("\n");
  if(nalive==1 && p1>=0 && p2>=0){
    let h:i32=0;
    while(h<nhyp){
      if(alive[h]==1){
        let r1:i32=hysel[h*ne+p1] as i32;
        let r2:i32=hysel[h*ne+p2] as i32;
        emit("  survivor hyp"); e64(h);
        emit(" Y1rule="); e64(r1); emit(" Y2rule="); e64(r2); emit("\n");
        if(t11>=0 && t12>=0 && r1==t11 && r2==t12){ reg=1; }
        if(t21>=0 && t22>=0 && r1==t21 && r2==t22){ reg=2; }
        if(t31>=0 && t32>=0 && r1==t31 && r2==t32){ reg=3; }
      }
      h=h+1;
    }
  }
  emit("S2_VERIFY_RESULT "); e64(reg); emit("\n");
  return reg;
}


// ddes_78.zag -- DDES steps 7 (OOD test) + 8 (ablation).
// Wave wave-20261002-0521pdt, lane DDES. Implements the frozen
// PREREG_DDES78.md (committed alone at ac7cc6856 before this file).
// Pure Zag. No Python.
//
// Derivation machinery is the frozen DDES V2 semantics
// (arrival computation, frontier scan, plan synthesis, predictor,
// sealed world simulator). Controlled wait-policy /
// frontier-selection variants, derivation code otherwise unchanged:
//   variant 0 = V_full:       clamp max(t*,1) + t*-derived waits + earliest-frontier.
//   variant 1 = V_noclamp:    identity waits (C1 removed), t*-derived, earliest-frontier.
//   variant 2 = V_nowaitderiv: clamp kept, FIXED w=2 (C2 removed), earliest-frontier.
//   variant 3 = V_nofrontier: clamp kept, t*-derived, anti-frontier (C3 removed).
//   variant 4 = V_none:       fixed w=2 + anti-frontier (C1+C2+C3 removed).
// The FLAG marker is emitted on t*==0 in ALL variants (print-only;
// excluded from every decision-line comparison per the DDES-ALT H1(b) rule).
//
// Six fresh sealed OOD worlds O1..O6 (two-hop chains, long horizons,
// decoy rules, competing frontiers, fan-in convergence, one
// chain-shaped boundary negative control). Zero randomness.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn emit_obs(o:i32)void {
  if(o==2){emit("OY");}
  else if(o==3){emit("OZ");}
  else if(o==0){emit("OX");}
  else {emit("NONE");}
  return;
}

// ============ generic arrival computation (frozen semantics) ============
fn compute_arrivals(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, out:[]u8)void {
  let INF:i32=268435456;
  let v:i32=0;
  while(v<n_vars){
    set32(out, v*4, INF);
    v=v+1;
  }
  if(use_set_x==1){
    set32(out, 0, 0);
  }
  let pass:i32=0;
  while(pass<n_vars){
    let i:i32=0;
    while(i<n_rules){
      let s:i32=get32(src, i*4);
      let d:i32=get32(dst, i*4);
      let w:i32=get32(delay, i*4);
      let as:i32=get32(out, s*4);
      if(as<INF){
        let cand:i32=as+w;
        let ad:i32=get32(out, d*4);
        if(cand<ad){
          set32(out, d*4, cand);
        }
      }
      i=i+1;
    }
    pass=pass+1;
  }
  return;
}

// ============ generic frontier computation (frozen semantics) ============
// anti=0: earliest min-arrival (frozen). anti=1: latest min-arrival
// (the C3 ablation; strict-greater tie-break).
fn compute_frontier(arr0:[]u8, arr1:[]u8, n_vars:i32, anti:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  if(anti==1){best_t=-1;}
  let best_v:i32=-1;
  let v:i32=0;
  while(v<n_vars){
    let a0:i32=get32(arr0, v*4);
    let a1:i32=get32(arr1, v*4);
    if(a0!=a1){
      let t:i32=a0;
      if(a1<t){t=a1;}
      let better:i32=0;
      if(anti==1){
        if(t>best_t){better=1;}
      } else {
        if(t<best_t){better=1;}
      }
      if(better==1){
        best_t=t;
        best_v=v;
      }
    }
    v=v+1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ wait-count policy (the controlled variant) ============
fn eff_waits(t_star:i32, variant:i32)i32 {
  if(variant==1){return t_star;}
  if(variant==2){return 2;}
  if(variant==4){return 2;}
  if(t_star<1){return 1;}
  return t_star;
}

// ============ generic plan synthesis (frozen semantics + variant) ============
fn synthesize_plan(v_star:i32, t_star:i32, use_set_x:i32, variant:i32, plan:[]u8, plans_built:[]u8)i32 {
  let len:i32=0;
  let cur_t:i32=0;
  if(use_set_x==1){
    plan[len]=0;
    len=len+1;
  }
  let w:i32=eff_waits(t_star, variant);
  while(cur_t<w){
    plan[len]=1;
    len=len+1;
    cur_t=cur_t+1;
  }
  let obs:i32=4-v_star;
  plan[len]=obs as u8;
  len=len+1;
  set32(plans_built, 0, get32(plans_built, 0)+1);
  return len;
}

fn emit_plan(plan:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    let a:i32=plan[i] as i32;
    if(a==0){emit("S");}
    else if(a==1){emit("W");}
    else if(a==2){emit("OY");}
    else{emit("OZ");}
    if(i<len-1){emit(",");}
    i=i+1;
  }
  emit("]");
  return;
}

// ============ generic predictor (frozen semantics + variant) ============
fn predict(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, v_star:i32, t_star:i32, variant:i32)i32 {
  let arr:[]u8=z_alloc(16);
  compute_arrivals(n_rules, src, dst, delay, n_vars, use_set_x, arr);
  let a:i32=get32(arr, v_star*4);
  let w:i32=eff_waits(t_star, variant);
  if(a<=w){return 1;}
  return 0;
}

// ============ sealed world simulator (frozen semantics) ============
fn world_step(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,16,get32(st,12));
  } else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    let pass:i32=0;
    while(pass<3){
      let r:i32=0;
      while(r<n_rules){
        let s:i32=get32(src, r*4);
        let d:i32=get32(dst, r*4);
        let w:i32=get32(delay, r*4);
        if(get32(st,s*4)==1){
          let ts:i32=get32(st,16+s*4);
          if(t-ts>=w){
            if(get32(st,d*4)==0){
              set32(st,d*4,1);
              set32(st,16+d*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else {
    obs=get32(st,4);
  }
  return obs;
}

// ============ one guided cell ============
// Returns packed i64: bit48=converge-ok, bit32=correct (true hypothesis
// is the survivor), bits16..31=wait count, bits0..15=obs action.
fn run_cell(attack:[]u8, world:[]u8, vname:[]u8, variant:i32, cfg:i32,
            n0:i32, s0:[]u8, d0:[]u8, w0:[]u8,
            n1:i32, s1:[]u8, d1:[]u8, w1:[]u8,
            plans_built:[]u8)i64 {
  emit("CELL "); emit(attack); emit(" "); emit(world); emit(" ");
  emit(vname); emit(" cfg"); e64(cfg); emit("\n");
  let n_vars:i32=3;
  let INF:i32=268435456;
  let tn:i32=n0;
  let ts:[]u8=s0; let td:[]u8=d0; let tw:[]u8=w0;
  if(cfg==1){
    tn=n1; ts=s1; td=d1; tw=w1;
  }
  let anti:i32=0;
  if(variant==3){anti=1;}
  if(variant==4){anti=1;}
  let best_found:i32=0;
  let best_v:i32=-1;
  let best_t:i32=INF;
  if(anti==1){best_t=-1;}
  let best_schema:i32=-1;
  let schema:i32=1;
  while(schema>=0){
    let a0:[]u8=z_alloc(16);
    let a1:[]u8=z_alloc(16);
    compute_arrivals(n0, s0, d0, w0, n_vars, schema, a0);
    compute_arrivals(n1, s1, d1, w1, n_vars, schema, a1);
    let f:[]u8=z_alloc(4);
    let fv:[]u8=z_alloc(4);
    let ft:[]u8=z_alloc(4);
    compute_frontier(a0, a1, n_vars, anti, f, fv, ft);
    if(get32(f,0)==1){
      let t:i32=get32(ft,0);
      let better:i32=0;
      if(anti==1){
        if(t>best_t){better=1;}
      } else {
        if(t<best_t){better=1;}
      }
      if(better==1){
        best_t=t;
        best_v=get32(fv,0);
        best_schema=schema;
        best_found=1;
      }
    }
    schema=schema-1;
  }
  let ok:i64=0;
  let correct:i64=0;
  let waits:i64=0;
  let obs:i64=0;
  if(best_found==0){
    emit("NO-DISCRIMINATING-PLAN\n");
  } else {
    emit("TARGET V*="); e64(best_v); emit(" t*="); e64(best_t);
    emit(" schema="); e64(best_schema); emit("\n");
    if(best_t==0){
      emit("FLAG TSTAR-ZERO-BOUNDARY floor=1\n");
    }
    let plan:[]u8=z_alloc(64);
    let plen:i32=synthesize_plan(best_v, best_t, best_schema, variant, plan, plans_built);
    let j:i32=0;
    while(j<plen){
      let pa:i32=plan[j] as i32;
      if(pa==1){waits=waits+1;}
      else if(pa>=2){obs=pa as i64;}
      j=j+1;
    }
    emit("PLAN "); emit_plan(plan, plen); emit("\n");
    let st:[]u8=z_alloc(32);
    let real_obs:i32=-1;
    let k:i32=0;
    while(k<plen){
      let o:i32=world_step(tn, ts, td, tw, st, plan[k] as i32);
      if(o>=0){real_obs=o;}
      k=k+1;
    }
    emit("EXEC real="); e64(real_obs); emit("\n");
    let p0:i32=predict(n0, s0, d0, w0, n_vars, best_schema, best_v, best_t, variant);
    let p1:i32=predict(n1, s1, d1, w1, n_vars, best_schema, best_v, best_t, variant);
    emit("PRED h0="); e64(p0); emit(" h1="); e64(p1); emit("\n");
    if(p0!=real_obs){emit("ELIM h0\n");} else {emit("SURVIVE h0\n");}
    if(p1!=real_obs){emit("ELIM h1\n");} else {emit("SURVIVE h1\n");}
    let cok:i32=1;
    if(p0==p1){cok=0;}
    let m0:i32=0; let m1:i32=0;
    if(p0==real_obs){m0=1;}
    if(p1==real_obs){m1=1;}
    if(m0+m1!=1){cok=0;}
    if(cok==1){emit("CONVERGE-OK\n");} else {emit("CONVERGE-FAIL\n");}
    ok=cok as i64;
    if(cok==1){
      if(cfg==0){
        if(p0==real_obs){if(p1!=real_obs){correct=1;}}
      } else {
        if(p1==real_obs){if(p0!=real_obs){correct=1;}}
      }
    }
  }
  emit("CELLEND\n");
  return (ok<<48)|(correct<<32)|(waits<<16)|obs;
}

// Fill rule tables: (nr, ruleA(src,dst,delay), ruleB, ruleC). Unused
// rule slots pass zeros; mk only writes the first nr rules.
fn mk(n:[]u8, s:[]u8, d:[]u8, w:[]u8, nr:i32,
      sa:i32, da:i32, la:i32, sb:i32, db:i32, lb:i32,
      sc:i32, dc:i32, lc:i32)void {
  set32(n,0,nr);
  if(nr>=1){
    set32(s,0,sa); set32(d,0,da); set32(w,0,la);
  }
  if(nr>=2){
    set32(s,4,sb); set32(d,4,db); set32(w,4,lb);
  }
  if(nr>=3){
    set32(s,8,sc); set32(d,8,dc); set32(w,8,lc);
  }
  return;
}

// Both configs of one (attack, world, variant) cell, then CELLSUM.
fn cell2(attack:[]u8, world:[]u8, vname:[]u8, variant:i32,
         nr0:i32, ha0:i32,hb0:i32,hc0:i32, hd0:i32,he0:i32,hf0:i32, hg0:i32,hh0:i32,hi0:i32,
         nr1:i32, ha1:i32,hb1:i32,hc1:i32, hd1:i32,he1:i32,hf1:i32, hg1:i32,hh1:i32,hi1:i32,
         plans_built:[]u8)void {
  let n0:[]u8=z_alloc(4); let s0:[]u8=z_alloc(32);
  let dd0:[]u8=z_alloc(32); let w0:[]u8=z_alloc(32);
  let n1:[]u8=z_alloc(4); let s1:[]u8=z_alloc(32);
  let dd1:[]u8=z_alloc(32); let w1:[]u8=z_alloc(32);
  mk(n0,s0,dd0,w0, nr0, ha0,hb0,hc0, hd0,he0,hf0, hg0,hh0,hi0);
  mk(n1,s1,dd1,w1, nr1, ha1,hb1,hc1, hd1,he1,hf1, hg1,hh1,hi1);
  let r0:i64=run_cell(attack, world, vname, variant, 0,
                      get32(n0,0),s0,dd0,w0, get32(n1,0),s1,dd1,w1, plans_built);
  let r1:i64=run_cell(attack, world, vname, variant, 1,
                      get32(n0,0),s0,dd0,w0, get32(n1,0),s1,dd1,w1, plans_built);
  let ok0:i64=(r0>>48)&1; let good0:i64=(r0>>32)&1;
  let ok1:i64=(r1>>48)&1; let good1:i64=(r1>>32)&1;
  let wts0:i64=(r0>>16)&65535; let ob0:i64=r0&65535;
  let wts1:i64=(r1>>16)&65535; let ob1:i64=r1&65535;
  emit("CELLSUM "); emit(attack); emit(" "); emit(world); emit(" ");
  emit(vname);
  emit(" ok0="); e64(ok0 as i32); emit(" ok1="); e64(ok1 as i32);
  let verdict:[]u8="LOUD-FAIL";
  if(ok0==1){
    if(ok1==1){
      if(good0==1){
        if(good1==1){verdict="CORRECT";}
        else {verdict="SILENT-WRONG";}
      } else {verdict="SILENT-WRONG";}
    }
  }
  emit(" VERDICT="); emit(verdict);
  emit(" waits0="); e64(wts0 as i32); emit(" obs0="); emit_obs(ob0 as i32);
  emit(" waits1="); e64(wts1 as i32); emit(" obs1="); emit_obs(ob1 as i32);
  emit("\n");
  return;
}

// ============ main: step 7 + step 8 matrix ============
// 5 variants x 6 sealed OOD worlds x 2 configs. Deterministic:
// zero randomness anywhere in the decision path.
fn one_variant(vname:[]u8, variant:i32, plans_built:[]u8)void {
  // O1: two-hop chain, indirect discrimination.
  // H0=[(X,Y,2),(Y,Z,3)] H1=[(X,Y,2),(Y,Z,5)].
  cell2("H78","O1",vname,variant,
        2, 0,2,2, 2,1,3, 0,0,0,
        2, 0,2,2, 2,1,5, 0,0,0,
        plans_built);
  // O2: long horizon t*=12.
  // H0=[(X,Y,12)] H1=[(X,Y,16)].
  cell2("H78","O2",vname,variant,
        1, 0,2,12, 0,0,0, 0,0,0,
        1, 0,2,16, 0,0,0, 0,0,0,
        plans_built);
  // O3: competing frontiers (Y at t*=0 beats Z at t*=2).
  // H0=[(X,Y,0),(X,Z,6)] H1=[(X,Y,3),(X,Z,2)].
  cell2("H78","O3",vname,variant,
        2, 0,2,0, 0,1,6, 0,0,0,
        2, 0,2,3, 0,1,2, 0,0,0,
        plans_built);
  // O4: two-hop chain plus decoy direct rule.
  // H0=[(X,Y,1),(Y,Z,2),(X,Z,9)] H1=[(X,Y,1),(Y,Z,4),(X,Z,9)].
  cell2("H78","O4",vname,variant,
        3, 0,2,1, 2,1,2, 0,1,9,
        3, 0,2,1, 2,1,4, 0,1,9,
        plans_built);
  // O5: fan-in convergence.
  // H0=[(X,Y,1),(X,Z,1),(Y,Z,1)] H1=[(X,Y,1),(X,Z,3),(Y,Z,1)].
  cell2("H78","O5",vname,variant,
        3, 0,2,1, 0,1,1, 2,1,1,
        3, 0,2,1, 0,1,3, 2,1,1,
        plans_built);
  // O6: chain-shaped boundary world (negative control).
  // H0=[(X,Y,0),(Y,Z,0)] H1=[(X,Y,0),(Y,Z,1)].
  cell2("H78","O6",vname,variant,
        2, 0,2,0, 2,1,0, 0,0,0,
        2, 0,2,0, 2,1,1, 0,0,0,
        plans_built);
  return;
}

fn main()i32 {
  let plans_built:[]u8=z_alloc(4);
  one_variant("full",0,plans_built);
  one_variant("noclamp",1,plans_built);
  one_variant("nowaitderiv",2,plans_built);
  one_variant("nofrontier",3,plans_built);
  one_variant("none",4,plans_built);
  emit("PLANSBUILT ");
  e64(get32(plans_built,0));
  emit("\n");
  return 0;
}

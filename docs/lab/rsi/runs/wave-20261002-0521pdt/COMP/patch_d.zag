// patch_d.zag -- Candidate single composition operation: recursive
// goal-part satisfaction ("satisfy").
//
// There is no compose stage here, no compose flag, no COMPOSE_MODE.
// Composition is what the general miss path does when one learned
// structure is not enough: applicable structures (full or prefix, all
// groundings) are applied, and the remainder of the goal is pursued
// through the same operation. Pipeline:
//   activate -> satisfy -> trial -> bootstrap
// Single-structure queries are handled by the same operation (one
// applicable segment reaching the goal), so no separate rebind stage
// exists in this pipeline either.
//
// Applicability (the shared primitive): MAP m's relation sequence
// R[0..L), extracted structurally from its promoted executable graph,
// is applicable from value s at prefix length k iff a live-fact path
// from s has relations R[0..k). All groundings are enumerated via
// t2_gather (not just the first), with backtracking across MAPs,
// prefix lengths, and groundings.
//
// Termination: learner policy header depth bound (default 8 when unset;
// learner-writable via pol_set) plus a visited-value cycle guard, which
// is the principled terminator independent of the bound.

// Structural relation-sequence extraction (same analysis as C's
// cc_relseq: relations come from each SET cell's DEP edge to its
// licensing fact, never from MAP labels).
fn d_relseq(W:[]u8,m:i32,seq:[]u8,maxn:i32)i32 {
  let root:i32=ng(W,m,20);
  let cur:i32=root;
  let exp102:i32=1;
  let n:i32=0;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      cur=ng(W,cur,12);
      exp102=0;
    } else {
      if(tag!=101){return -1;}
      let fact:i32=-1;
      let e:i32=0;
      while(e<4096 && fact<0){
        if(eg(W,e,0)==cur && eg(W,e,4)==1){fact=eg(W,e,8);}
        e=e+1;
      }
      if(fact<0){return -1;}
      if(ng(W,fact,0)!=1 || ng(W,fact,36)!=1){return -1;}
      if(n>=maxn){return -1;}
      set32(seq,n*4,ng(W,fact,24));
      n=n+1;
      cur=seq_nx(W,cur);
      exp102=1;
    }
    steps=steps+1;
  }
  if(n==0){return -1;}
  return n;
}

// Tail of a pure chain graph: the last SET cell.
fn d_chain_tail(W:[]u8,root:i32)i32 {
  let cur:i32=root;
  let tail:i32=-1;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==102){cur=ng(W,cur,12);}
    else {
      if(tag==101){tail=cur; cur=seq_nx(W,cur);}
      else {cur=-2;}
    }
    steps=steps+1;
  }
  return tail;
}

// Learner-owned depth bound: policy header, default 8 when unset.
fn d_maxdepth(W:[]u8)i32 {
  let p:i32=pol_get(W);
  if(p<=0){return 8;}
  return p;
}

// Recursive goal-part satisfaction. Returns segment count (>=1) with
// segments recorded in segv/segf/segk/segm at depths 0..nseg-1, else 0.
// vis[0..depth] holds visited values (cycle guard).
// Selection (A1): longest-applicable-prefix first (k0 4..1), then MAP id
// order, then grounding order; full backtracking across all three.
fn d_satisfy(W:[]u8,s:i32,r:i32,expected:i32,depth:i32,segv:[]u8,segf:[]u8,segk:[]u8,segm:[]u8,vis:[]u8)i32 {
  let maxd:i32=d_maxdepth(W);
  if(depth>maxd){return 0;}
  let k0:i32=4;
  while(k0>=1){
    let m:i32=2;
    while(m<1024){
      if(ng(W,m,36)==1 && ng(W,m,0)==20){
        let seq:[]u8=z_alloc(28);
        let L:i32=d_relseq(W,m,seq,7);
        if(L>=k0){
          let paths:[]u8=z_alloc(4608);
          let np:i32=t2_gather(W,s,paths);
          let p:i32=0;
          while(p<np){
            let base:i32=p*48;
            if(get32(paths,base)==k0+1){
              let ok:i32=1;
              let j:i32=0;
              while(j<k0 && ok==1){
                let fid:i32=get32(paths,base+24+j*4);
                if(ng(W,fid,24)!=get32(seq,j*4)){ok=0;}
                j=j+1;
              }
              if(ok==1){
                let vt:i32=get32(paths,base+4+k0*4);
                let seen:i32=0;
                let q2:i32=0;
                while(q2<=depth){
                  if(get32(vis,q2*4)==vt){seen=1;}
                  q2=q2+1;
                }
                if(seen==0){
                  set32(segm,depth*4,m);
                  set32(segk,depth*4,k0);
                  let j2:i32=0;
                  while(j2<=k0){
                    set32(segv,(depth*8+j2)*4,get32(paths,base+4+j2*4));
                    j2=j2+1;
                  }
                  j2=0;
                  while(j2<k0){
                    set32(segf,(depth*7+j2)*4,get32(paths,base+24+j2*4));
                    j2=j2+1;
                  }
                  if(vt==expected){
                    return depth+1;
                  }
                  if(depth<maxd){
                    set32(vis,(depth+1)*4,vt);
                    let sub:i32=d_satisfy(W,vt,r,expected,depth+1,segv,segf,segk,segm,vis);
                    if(sub>=1){return sub;}
                  }
                }
              }
            }
            p=p+1;
          }
        }
      }
      m=m+1;
    }
    k0=k0-1;
  }
  return 0;
}

// Assemble recorded segments into one chain, verify (verify=1: against
// expected; verify=0: sanity execution only), promote with LINK14
// provenance to used MAPs. Returns answer or -2.
fn d_assemble(W:[]u8,s:i32,r:i32,expected:i32,nseg:i32,segv:[]u8,segf:[]u8,segk:[]u8,segm:[]u8,verify:i32)i32 {
  let roots:[]u8=z_alloc(13*4);
  let g:i32=0;
  let ok:i32=1;
  while(g<nseg && ok==1){
    let k:i32=get32(segk,g*4);
    let vb:[]u8=z_alloc((k+1)*4);
    let fb:[]u8=z_alloc(k*4);
    let j:i32=0;
    while(j<=k){set32(vb,j*4,get32(segv,(g*8+j)*4)); j=j+1;}
    j=0;
    while(j<k){set32(fb,j*4,get32(segf,(g*7+j)*4)); j=j+1;}
    let rt:i32=t2_asm_chain(W,vb,k+1,fb);
    if(rt<0){ok=0;} else {set32(roots,g*4,rt);}
    g=g+1;
  }
  if(ok==0){return -2;}
  let full:i32=get32(roots,0);
  g=1;
  while(g<nseg){
    let tail:i32=d_chain_tail(W,full);
    if(tail<0){return -2;}
    seq_link(W,tail,get32(roots,g*4));
    g=g+1;
  }
  let ans:i32=-2;
  if(verify==1){
    let cst:[]u8=z_alloc(8);
    set32(cst,0,0); set32(cst,4,0);
    ans=t2_try_verify(W,full,s,expected,0,cst);
  } else {
    let ex:i32=t2_exec(W,full,s);
    if(ex!=-999999){ans=ex;}
  }
  if(ans==-2){return -2;}
  let allf:[]u8=z_alloc(512);
  let nf:i32=0;
  g=0;
  while(g<nseg){
    let k2:i32=get32(segk,g*4);
    let j2:i32=0;
    while(j2<k2){
      set32(allf,nf*4,get32(segf,(g*7+j2)*4));
      nf=nf+1; j2=j2+1;
    }
    g=g+1;
  }
  let zm:i32=promote_graph(W,full,s,r,ans,allf,nf);
  if(zm>=0){
    g=0;
    while(g<nseg){
      link_edge(W,zm,14,get32(segm,g*4),0);
      g=g+1;
    }
  }
  return ans;
}

// Supervised entry: satisfy toward expected, or unsupervised fixpoint.
fn d_query(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  if(expected<0){return d_fixpoint(W,s,r);}
  let maxd:i32=d_maxdepth(W);
  let segv:[]u8=z_alloc((maxd+1)*32);
  let segf:[]u8=z_alloc((maxd+1)*28);
  let segk:[]u8=z_alloc((maxd+1)*4);
  let segm:[]u8=z_alloc((maxd+1)*4);
  let vis:[]u8=z_alloc((maxd+1)*4);
  set32(vis,0,s);
  let nseg:i32=d_satisfy(W,s,r,expected,0,segv,segf,segk,segm,vis);
  if(nseg<1){return -2;}
  let ans:i32=d_assemble(W,s,r,expected,nseg,segv,segf,segk,segm,1);
  if(ans!=-2){
    emit("SAT-SEGS n="); e64(nseg); emit("\n");
  }
  return ans;
}

// Unsupervised: greedy fixpoint over applicable structure prefixes.
// No expected value is consulted anywhere. Longest applicable prefix
// wins; ties break by lowest MAP id, then gather order. Stops when no
// applicable prefix yields a novel terminal value.
fn d_fixpoint(W:[]u8,s:i32,r:i32)i32 {
  let maxit:i32=12;
  let segv:[]u8=z_alloc(13*32);
  let segf:[]u8=z_alloc(13*28);
  let segk:[]u8=z_alloc(13*4);
  let segm:[]u8=z_alloc(13*4);
  let vis:[]u8=z_alloc(13*4);
  set32(vis,0,s);
  let nvis:i32=1;
  let cur:i32=s;
  let nseg:i32=0;
  let iter:i32=0;
  let progress:i32=1;
  while(iter<maxit && progress==1 && nseg<12){
    progress=0;
    let kk:i32=4;
    while(kk>=1 && progress==0){
      let m:i32=2;
      while(m<1024 && progress==0){
        if(ng(W,m,36)==1 && ng(W,m,0)==20){
          let seq:[]u8=z_alloc(28);
          let L:i32=d_relseq(W,m,seq,7);
          if(L>=kk){
            let paths:[]u8=z_alloc(4608);
            let np:i32=t2_gather(W,cur,paths);
            let p:i32=0;
            while(p<np && progress==0){
              let base:i32=p*48;
              if(get32(paths,base)==kk+1){
                let ok:i32=1;
                let j:i32=0;
                while(j<kk && ok==1){
                  if(ng(W,get32(paths,base+24+j*4),24)!=get32(seq,j*4)){ok=0;}
                  j=j+1;
                }
                if(ok==1){
                  let vt:i32=get32(paths,base+4+kk*4);
                  let seen:i32=0;
                  let q2:i32=0;
                  while(q2<nvis){
                    if(get32(vis,q2*4)==vt){seen=1;}
                    q2=q2+1;
                  }
                  if(seen==0){
                    set32(segm,nseg*4,m);
                    set32(segk,nseg*4,kk);
                    let j2:i32=0;
                    while(j2<=kk){
                      set32(segv,(nseg*8+j2)*4,get32(paths,base+4+j2*4));
                      j2=j2+1;
                    }
                    j2=0;
                    while(j2<kk){
                      set32(segf,(nseg*7+j2)*4,get32(paths,base+24+j2*4));
                      j2=j2+1;
                    }
                    set32(vis,nvis*4,vt);
                    nvis=nvis+1;
                    cur=vt;
                    nseg=nseg+1;
                    progress=1;
                  }
                }
              }
              p=p+1;
            }
          }
        }
        m=m+1;
      }
      kk=kk-1;
    }
    iter=iter+1;
  }
  if(nseg<1){return -2;}
  let ans:i32=d_assemble(W,s,r,-1,nseg,segv,segf,segk,segm,0);
  if(ans!=-2){
    emit("SAT-FIX n="); e64(nseg); emit(" term="); e64(ans); emit("\n");
  }
  return ans;
}

// ev_query for D: activate -> satisfy -> trial -> bootstrap.
// No rebind stage, no compose stage, no mode flag.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let sq:i32=d_query(W,s,r,expected);
  if(sq!=-2){
    log_ev(W,2,s,r,sq,1,0,0); return sq;
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

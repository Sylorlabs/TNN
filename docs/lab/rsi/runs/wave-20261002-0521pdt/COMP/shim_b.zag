// shim_b.zag -- mechanism hooks for bin B.
// B's composition is gated on co-use history, so each test gets the
// standard co-use episode (fresh chains mirroring the components,
// morning pattern): ev_cq chain=0 then chain=1 writes the type-15 edge.
fn mech_tag()[]u8 { return "B"; }
fn mech_episode(W:[]u8,tag:i32)void {
  ev_teach(W,61,1,62); ev_teach(W,62,1,63);
  ev_teach(W,63,2,64); ev_teach(W,64,2,65);
  let a1:i32=ev_cq(W,61,71,63,0,0);
  let a2:i32=ev_cq(W,63,72,65,0,1);
  emit("EP a1="); e64(a1); emit(" a2="); e64(a2);
  emit(" couse15="); e64(cb_count15(W)); emit("\n");
  return;
}
fn mech_ablate(W:[]u8)void { cb_del_couse(W); return; }
fn mech_couse15(W:[]u8)i32 { return cb_count15(W); }

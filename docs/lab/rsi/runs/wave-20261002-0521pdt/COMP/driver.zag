// driver.zag -- Shared comparative adversarial battery driver.
// One driver for bins A, B, C, D (per-binary hooks via mech_* shims).
// Each test: fresh workspace, train components, episodes (B only via
// shim), gap noise, goal facts, goal query. Markers T-<name>-ANS and
// T-<name>-RESULT for parsing. All output deterministic.

// ---- verification helpers (harness only, not cognition) ----
fn dv_count_maps(W:[]u8)i32 {
  let n:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn dv_newest_map_rel(W:[]u8,r:i32)i32 {
  let m:i32=1023;
  while(m>=2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){return m;}
    m=m-1;
  }
  return -1;
}
fn dv_has_edge_to(W:[]u8,from:i32,tt:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==tt && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
// structural relseq extraction (verification copy, mechanism-neutral)
fn dv_relseq(W:[]u8,m:i32,seq:[]u8,maxn:i32)i32 {
  let root:i32=ng(W,m,20);
  let cur:i32=root;
  let exp102:i32=1;
  let n:i32=0;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      cur=ng(W,cur,12);
      exp102=0;
    } else {
      if(tag!=101){return -1;}
      let fact:i32=-1;
      let e:i32=0;
      while(e<4096 && fact<0){
        if(eg(W,e,0)==cur && eg(W,e,4)==1){fact=eg(W,e,8);}
        e=e+1;
      }
      if(fact<0){return -1;}
      if(ng(W,fact,0)!=1 || ng(W,fact,36)!=1){return -1;}
      if(n>=maxn){return -1;}
      set32(seq,n*4,ng(W,fact,24));
      n=n+1;
      cur=seq_nx(W,cur);
      exp102=1;
    }
    steps=steps+1;
  }
  if(n==0){return -1;}
  return n;
}
// type-tt edges from `from`, sorted by edge id; returns count
fn dv_edges_from(W:[]u8,from:i32,tt:i32,ebuf:[]u8,fbuf:[]u8)i32 {
  let n:i32=0;
  let e:i32=0;
  while(e<4096 && n<64){
    if(eg(W,e,0)==from && eg(W,e,4)==tt){
      set32(ebuf,n*4,e);
      set32(fbuf,n*4,eg(W,e,8));
      n=n+1;
    }
    e=e+1;
  }
  let i:i32=0;
  while(i<n){
    let j:i32=i+1;
    while(j<n){
      if(get32(ebuf,j*4)<get32(ebuf,i*4)){
        let te:i32=get32(ebuf,i*4);
        set32(ebuf,i*4,get32(ebuf,j*4)); set32(ebuf,j*4,te);
        let tf:i32=get32(fbuf,i*4);
        set32(fbuf,i*4,get32(fbuf,j*4)); set32(fbuf,j*4,tf);
      }
      j=j+1;
    }
    i=i+1;
  }
  return n;
}
fn dv_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn dv_result(name:[]u8,pass:i32)void {
  emit("T-"); emit(name); emit("-RESULT=");
  if(pass==1){emit("PASS\n");} else {emit("FAIL\n");}
  return;
}

// ---- T-COMP3: D1 arith chain, 3 structures ----
fn t_comp3(W:[]u8)void {
  emit("=== T-COMP3 ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  ev_teach(W,31,3,32); ev_teach(W,32,3,33); ev_teach(W,33,3,34);
  let w:i32=ev_query(W,31,73,34,0);
  emit("TRAIN x="); e64(x); emit(" y="); e64(y); emit(" w="); e64(w);
  emit(" maps="); e64(dv_count_maps(W)); emit("\n");
  mech_episode(W,1);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107); ev_teach(W,107,3,108);
  let z:i32=ev_query(W,101,70,108,0);
  emit("T-COMP3-ANS="); e64(z); emit("\n");
  if(z==108){dv_result("COMP3",1);} else {dv_result("COMP3",0);}
  return;
}

// ---- T-COMP5: 5 structures, 10 steps ----
fn t_comp5(W:[]u8)void {
  emit("=== T-COMP5 ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  ev_teach(W,31,3,32); ev_teach(W,32,3,33);
  let w:i32=ev_query(W,31,73,33,0);
  ev_teach(W,41,4,42); ev_teach(W,42,4,43);
  let v:i32=ev_query(W,41,74,43,0);
  ev_teach(W,51,5,52); ev_teach(W,52,5,53);
  let u:i32=ev_query(W,51,75,53,0);
  emit("TRAIN maps="); e64(dv_count_maps(W)); emit("\n");
  mech_episode(W,1);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107);
  ev_teach(W,107,4,108); ev_teach(W,108,4,109);
  ev_teach(W,109,5,110); ev_teach(W,110,5,111);
  let z:i32=ev_query(W,101,70,111,0);
  emit("T-COMP5-ANS="); e64(z); emit("\n");
  if(z==111){dv_result("COMP5",1);} else {dv_result("COMP5",0);}
  return;
}

// ---- T-COMP2: canonical 2-structure (B's home turf) ----
fn t_comp2(W:[]u8)void {
  emit("=== T-COMP2 ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  emit("TRAIN x="); e64(x); emit(" y="); e64(y);
  emit(" maps="); e64(dv_count_maps(W)); emit("\n");
  mech_episode(W,1);
  emit("couse15="); e64(mech_couse15(W)); emit("\n");
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-COMP2-ANS="); e64(z); emit("\n");
  if(z==105){dv_result("COMP2",1);} else {dv_result("COMP2",0);}
  return;
}

// ---- T-BABL: B ablation (delete co-use history before goal) ----
fn t_babl(W:[]u8)void {
  emit("=== T-BABL ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  mech_episode(W,1);
  emit("couse15-before="); e64(mech_couse15(W)); emit("\n");
  dv_gap(W);
  mech_ablate(W);
  emit("couse15-after="); e64(mech_couse15(W)); emit("\n");
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-BABL-ANS="); e64(z); emit("\n");
  if(z==105){dv_result("BABL",1);} else {dv_result("BABL",0);}
  return;
}

// ---- T-D2: branching domain (distractors, correct taught first) ----
fn t_d2(W:[]u8)void {
  emit("=== T-D2 ===\n");
  ev_teach(W,12,1,912);
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,22,2,922);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  emit("TRAIN x="); e64(x); emit(" y="); e64(y);
  emit(" maps="); e64(dv_count_maps(W)); emit("\n");
  mech_episode(W,1);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-D2-ANS="); e64(z); emit("\n");
  if(z==105){dv_result("D2",1);} else {dv_result("D2",0);}
  return;
}

// ---- T-D3H: atomic single-hop MAPs, 3 structures ----
fn t_d3h(W:[]u8)void {
  emit("=== T-D3H ===\n");
  ev_teach(W,11,1,12);
  let x:i32=ev_query(W,11,71,12,0);
  ev_teach(W,21,2,22);
  let y:i32=ev_query(W,21,72,22,0);
  ev_teach(W,31,3,32);
  let w:i32=ev_query(W,31,73,32,0);
  emit("TRAIN x="); e64(x); emit(" y="); e64(y); emit(" w="); e64(w);
  emit(" maps="); e64(dv_count_maps(W)); emit("\n");
  mech_episode(W,1);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,2,103); ev_teach(W,103,3,104);
  let z:i32=ev_query(W,101,70,104,0);
  emit("T-D3H-ANS="); e64(z); emit("\n");
  if(z==104){dv_result("D3H",1);} else {dv_result("D3H",0);}
  return;
}

// ---- T-D4: noise domain (40 distractors sharing Z subjects/rels) ----
fn t_d4(W:[]u8)void {
  emit("=== T-D4 ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  ev_teach(W,31,3,32); ev_teach(W,32,3,33); ev_teach(W,33,3,34);
  let w:i32=ev_query(W,31,73,34,0);
  mech_episode(W,1);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107); ev_teach(W,107,3,108);
  let i:i32=0;
  while(i<40){
    ev_teach(W,101+(i%8),1+(i%3),9100+i);
    i=i+1;
  }
  let z:i32=ev_query(W,101,70,108,0);
  emit("T-D4-ANS="); e64(z); emit("\n");
  if(z==108){dv_result("D4",1);} else {dv_result("D4",0);}
  return;
}

// ---- T-PART: partial applicability (X plen 5, goal needs 2 of it) ----
fn t_part(W:[]u8)void {
  emit("=== T-PART ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  ev_teach(W,13,1,14); ev_teach(W,14,1,15);
  let x:i32=ev_query(W,11,71,15,0);
  ev_teach(W,21,2,22);
  let y:i32=ev_query(W,21,72,22,0);
  emit("TRAIN x="); e64(x); emit(" y="); e64(y);
  emit(" maps="); e64(dv_count_maps(W)); emit("\n");
  mech_episode(W,1);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,2,104);
  let z:i32=ev_query(W,101,70,104,0);
  emit("T-PART-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  if(z==104){
    let mz:i32=dv_newest_map_rel(W,70);
    if(mz>=0){
      let seq:[]u8=z_alloc(28);
      let L:i32=dv_relseq(W,mz,seq,7);
      emit("PART-relseq L="); e64(L);
      emit(" ["); e64(get32(seq,0)); emit(" "); e64(get32(seq,4));
      emit(" "); e64(get32(seq,8)); emit("]\n");
      if(L==3 && get32(seq,0)==1 && get32(seq,4)==1 && get32(seq,8)==2){
        pass=1;
      }
    }
  }
  dv_result("PART",pass);
  return;
}

// ---- T-NOSUP: no expected-answer supervision ----
fn t_nosup(W:[]u8)void {
  emit("=== T-NOSUP ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  ev_teach(W,31,3,32); ev_teach(W,32,3,33); ev_teach(W,33,3,34);
  let w:i32=ev_query(W,31,73,34,0);
  mech_episode(W,1);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107); ev_teach(W,107,3,108);
  let z:i32=ev_query(W,101,70,-1,0);
  emit("T-NOSUP-ANS="); e64(z); emit("\n");
  let pass:i32=0;
  let mz:i32=dv_newest_map_rel(W,70);
  emit("NOSUP-map="); e64(mz); emit("\n");
  if(mz>=0){
    let seq:[]u8=z_alloc(28);
    let L:i32=dv_relseq(W,mz,seq,7);
    emit("NOSUP-relseq L="); e64(L); emit("\n");
    if(L==7 && get32(seq,0)==1 && get32(seq,4)==1 && get32(seq,8)==2 &&
       get32(seq,12)==2 && get32(seq,16)==3 && get32(seq,20)==3 &&
       get32(seq,24)==3 && ng(W,mz,28)==108){
      let ebuf:[]u8=z_alloc(256);
      let fbuf:[]u8=z_alloc(256);
      let nf:i32=dv_edges_from(W,mz,1,ebuf,fbuf);
      if(nf==7){
        let okf:i32=1;
        let j:i32=0;
        while(j<7 && okf==1){
          let f:i32=get32(fbuf,j*4);
          if(ng(W,f,20)!=101+j){okf=0;}
          if(ng(W,f,28)!=102+j){okf=0;}
          j=j+1;
        }
        // relations: 1,1,2,2,3,3,3
        if(okf==1){
          if(ng(W,get32(fbuf,0),24)!=1){okf=0;}
          if(ng(W,get32(fbuf,4),24)!=1){okf=0;}
          if(ng(W,get32(fbuf,8),24)!=2){okf=0;}
          if(ng(W,get32(fbuf,12),24)!=2){okf=0;}
          if(ng(W,get32(fbuf,16),24)!=3){okf=0;}
          if(ng(W,get32(fbuf,20),24)!=3){okf=0;}
          if(ng(W,get32(fbuf,24),24)!=3){okf=0;}
        }
        if(okf==1){pass=1;}
      }
    }
  }
  dv_result("NOSUP",pass);
  return;
}

// ---- T-REV: revision of composite ----
fn t_rev(W:[]u8)void {
  emit("=== T-REV ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  mech_episode(W,1);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  let m0:i32=dv_count_maps(W);
  let z1:i32=ev_query(W,101,70,105,0);
  let m1:i32=dv_count_maps(W);
  let r1:i32=0;
  if(m1==m0+1){r1=1;}
  emit("REV maps0="); e64(m0); emit(" maps1="); e64(m1);
  emit(" z1="); e64(z1); emit("\n");
  let z2:i32=ev_query(W,101,70,105,0);
  let r2:i32=0;
  if(z2==105){r2=1;}
  emit("REV z2="); e64(z2); emit("\n");
  let ob:i32=ev_observe(W,104,2,99);
  emit("REV observe="); e64(ob); emit("\n");
  let z3:i32=ev_query(W,101,70,99,0);
  let r4:i32=0;
  if(z3==99){r4=1;}
  emit("REV z3="); e64(z3); emit("\n");
  if(r1==1 && r2==1 && r4==1){dv_result("REV",1);} else {dv_result("REV",0);}
  return;
}

// ---- T-REUSE: composite as first-class component ----
fn t_reuse(W:[]u8)void {
  emit("=== T-REUSE ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  mech_episode(W,1);
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  let z:i32=ev_query(W,101,70,105,0);
  let mapZ:i32=dv_newest_map_rel(W,70);
  emit("REUSE z="); e64(z); emit(" mapZ="); e64(mapZ); emit("\n");
  ev_teach(W,301,1,302); ev_teach(W,302,1,303);
  ev_teach(W,303,2,304); ev_teach(W,304,2,305);
  ev_teach(W,305,2,306); ev_teach(W,306,2,307);
  let q:i32=ev_query(W,301,70,307,0);
  let mapQ:i32=dv_newest_map_rel(W,70);
  emit("REUSE q="); e64(q); emit(" mapQ="); e64(mapQ); emit("\n");
  let prov:i32=0;
  if(mapQ>=0 && mapZ>=0 && mapQ!=mapZ){
    if(dv_has_edge_to(W,mapQ,14,mapZ)==1){prov=1;}
    if(dv_has_edge_to(W,mapQ,1,mapZ)==1){prov=1;}
    if(dv_has_edge_to(W,mapQ,15,mapZ)==1){prov=1;}
  }
  emit("REUSE prov="); e64(prov); emit("\n");
  if(q==307 && prov==1){dv_result("REUSE",1);} else {dv_result("REUSE",0);}
  return;
}

// ---- T-ADVA: adversarial branching (distractor wins lu_first) ----
fn t_adva(W:[]u8)void {
  emit("=== T-ADVA ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  emit("TRAIN x="); e64(x); emit(" y="); e64(y);
  emit(" maps="); e64(dv_count_maps(W)); emit("\n");
  mech_episode(W,1);
  dv_gap(W);
  ev_teach(W,103,2,904);
  ev_teach(W,904,2,905);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T-ADVA-ANS="); e64(z); emit("\n");
  if(z==105){dv_result("ADVA",1);} else {dv_result("ADVA",0);}
  return;
}

// ---- T-SINGLE: one-structure via the same operation ----
fn t_single(W:[]u8)void {
  emit("=== T-SINGLE ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  emit("TRAIN x="); e64(x); emit(" maps="); e64(dv_count_maps(W)); emit("\n");
  dv_gap(W);
  ev_teach(W,61,1,62); ev_teach(W,62,1,63);
  let z:i32=ev_query(W,61,71,63,0);
  emit("T-SINGLE-ANS="); e64(z); emit("\n");
  if(z==63){dv_result("SINGLE",1);} else {dv_result("SINGLE",0);}
  return;
}

fn main()i32 {
  let tg:[]u8=mech_tag();
  emit("BAT-"); emit(tg); emit("-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W); t_comp3(W);
  W=z_alloc(110656); tnn2_init(W); t_comp5(W);

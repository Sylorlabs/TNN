// driver_c0.zag -- Minimal driver for bin C0 (compose_on()=0 control).
// Runs only T-COMP3. Predicted: ans=-2 (composition needs the flagged stage).
fn dv_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn main()i32 {
  emit("BAT-C0-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("=== T-C0-COMP3 ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  ev_teach(W,31,3,32); ev_teach(W,32,3,33); ev_teach(W,33,3,34);
  let w:i32=ev_query(W,31,73,34,0);
  emit("TRAIN x="); e64(x); emit(" y="); e64(y); emit(" w="); e64(w); emit("\n");
  dv_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107); ev_teach(W,107,3,108);
  let z:i32=ev_query(W,101,70,108,0);
  emit("T-C0-COMP3-ANS="); e64(z); emit("\n");
  if(z==-2){emit("T-C0-COMP3-RESULT=PASS(control: no compose without flag)\n");}
  else {emit("T-C0-COMP3-RESULT=FAIL(control broken)\n");}
  emit("BAT-C0-END\n");
  return 0;
}

// e10_degen.zag -- degenerate contestant transcript generator (pure Zag, safe-emit).
// argv: [worldfile, policy]; transcript goes to stdout (redirect in shell).
// policy: D0 (QUERY->-2, ACT->0),
//         D1 (QUERY->most recent OBSERVE object overall, ACT->30),
//         D2 (QUERY->most recent OBSERVE object for same (s,r) else -2, ACT->0)
// Emits ANSWER/CHOICE lines in shim transcript format.
// Emit discipline (AGENTS.md 2026-10-02): single preallocated buffer +
// cursor, one raw write at end.
fn o_str(ob:[]u8, oc:i32, s:[]u8) i32 {
  let i:i32=0;
  while(i<s.len){ ob[oc]=s[i]; oc=oc+1; i=i+1; }
  return oc;
}
fn o_i64(ob:[]u8, oc:i32, v:i64) i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=-x; }
  let nd:i32=1; let t:i64=x;
  while(t>=10){ nd=nd+1; t=t/10; }
  if(neg==1){ ob[oc]=45; oc=oc+1; }
  let p:i32=oc+nd-1;
  if(x==0){ ob[p]=48; }
  while(x>0){ ob[p]=((x%10)+48) as u8; x=x/10; p=p-1; }
  return oc+nd;
}
fn o_flush(ob:[]u8, oc:i32) void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(ob) as i64),(oc as i64),0,0,0);
  return;
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn is_sp(c:u8)i32 { if(c==32 || c==9 || c==10 || c==13){return 1;} return 0; }
fn skip_sp(d:[]u8,s:i32,e:i32)i32 {
  let i:i32=s;
  while(i<e && is_sp(d[i])==1){i=i+1;}
  return i;
}
fn tok_end(d:[]u8,s:i32,e:i32)i32 {
  let i:i32=s;
  while(i<e && is_sp(d[i])==0){i=i+1;}
  return i;
}
fn parse_i32(d:[]u8,s:i32,e:i32) i32 {
  let neg:i32=0; let i:i32=s; let v:i32=0;
  if(i<e && d[i]==45){neg=1;i=i+1;}
  while(i<e && d[i]>=48 && d[i]<=57){v=v*10+(d[i] as i32)-48;i=i+1;}
  if(neg==1){v=0-v;}
  return v;
}
fn tok_eq(d:[]u8,s:i32,e:i32,t:[]u8)i32 {
  if(e-s!=t.len){return 0;}
  let i:i32=0;
  while(i<t.len){if(d[s+i]!=t[i]){return 0;} i=i+1;}
  return 1;
}
fn main()i32 {
  let ob:[]u8=z_alloc(131072);
  let oc:i32=0;
  if(_zag_argc()!=3){
    oc=o_str(ob,oc,"usage: e10_degen_bin <world> <D0|D1|D2>\n");
    o_flush(ob,oc); return 3;
  }
  let pol:i32=0;
  if(tok_eq(_zag_arg(2),0,_zag_strlen(_zag_arg(2)),"D1")==1){pol=1;}
  if(tok_eq(_zag_arg(2),0,_zag_strlen(_zag_arg(2)),"D2")==1){pol=2;}
  let wd:[]u8=_zag_read_file(_zag_arg(1));
  let wn:i32=_zag_strlen(wd);
  let ms:[]u8=z_alloc(512*4); let mr:[]u8=z_alloc(512*4); let mo:[]u8=z_alloc(512*4);
  let nm:i32=0;
  let last_o:i32=-2; let have_last:i32=0;
  let s:i32=0;
  while(s<wn){
    let le:i32=s;
    while(le<wn && wd[le]!=10){le=le+1;}
    let f0:i32=skip_sp(wd,s,le); let f0e:i32=tok_end(wd,f0,le);
    if(tok_eq(wd,f0,f0e,"OBSERVE")==1){
      let a:i32=skip_sp(wd,f0e,le); let ae:i32=tok_end(wd,a,le);
      let b:i32=skip_sp(wd,ae,le); let be:i32=tok_end(wd,b,le);
      let c:i32=skip_sp(wd,be,le); let ce:i32=tok_end(wd,c,le);
      let osi:i32=parse_i32(wd,a,ae); let ori:i32=parse_i32(wd,b,be); let ooi:i32=parse_i32(wd,c,ce);
      last_o=ooi; have_last=1;
      let f:i32=0; let found:i32=-1;
      while(f<nm){if(get32(ms,f*4)==osi && get32(mr,f*4)==ori){found=f;} f=f+1;}
      if(found>=0){set32(mo,found*4,ooi);}
      else { if(nm<512){set32(ms,nm*4,osi); set32(mr,nm*4,ori); set32(mo,nm*4,ooi); nm=nm+1;} }
    } else {
      if(tok_eq(wd,f0,f0e,"QUERY")==1){
        let a:i32=skip_sp(wd,f0e,le); let ae:i32=tok_end(wd,a,le);
        let b:i32=skip_sp(wd,ae,le); let be:i32=tok_end(wd,b,le);
        let qsi:i32=parse_i32(wd,a,ae); let qri:i32=parse_i32(wd,b,be);
        let v:i32=-2;
        if(pol==1){ if(have_last==1){v=last_o;} }
        if(pol==2){
          let f:i32=0;
          while(f<nm){if(get32(ms,f*4)==qsi && get32(mr,f*4)==qri){v=get32(mo,f*4);} f=f+1;}
        }
        oc=o_str(ob,oc,"ANSWER "); oc=o_i64(ob,oc,qsi as i64);
        oc=o_str(ob,oc," "); oc=o_i64(ob,oc,qri as i64);
        oc=o_str(ob,oc," "); oc=o_i64(ob,oc,v as i64);
        oc=o_str(ob,oc,"\n");
      } else {
        if(tok_eq(wd,f0,f0e,"ACT")==1){
          if(pol==1){oc=o_str(ob,oc,"CHOICE 30\n");} else {oc=o_str(ob,oc,"CHOICE 0\n");}
        }
      }
    }
    s=le+1;
  }
  o_flush(ob,oc);
  return 0;
}

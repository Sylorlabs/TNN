// e10_score.zag -- Battery E10 transcript scorer (pure Zag, safe-emit).
// argv: [worldfile, transcript, barspec, nullval, inqval]
// Barspec directives (one per line):
//   HIT i j ...        probe indices (0-based over QUERY order) that must PASS
//   NEED k i j ...     at least k of the listed probes must PASS
//   CHOICE c NULL|INQ  c-th CHOICE (0-based over ACT order) must equal vocab
// T-K15(b) leakcheck: for every NEED-listed (bar) probe, no OBSERVE line in
// the world file may teach the same (s,r) with the expected object; a match
// makes the world WORLD-INVALID (retrieval-passable bar).
// Output: per-probe lines, LEAKCHECK line, CHOICE list, directive verdicts,
// final E10BAR line. Exit: 0 PASS, 1 FAIL, 2 WORLD-INVALID.
// Emit discipline (AGENTS.md 2026-10-02): single preallocated buffer +
// cursor, one raw write at end. No _zag_print for dynamic content.

// ---- safe emit ----
fn o_str(ob:[]u8, oc:i32, s:[]u8) i32 {
  let i:i32=0;
  while(i<s.len){ ob[oc]=s[i]; oc=oc+1; i=i+1; }
  return oc;
}
fn o_i64(ob:[]u8, oc:i32, v:i64) i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=-x; }
  let nd:i32=1; let t:i64=x;
  while(t>=10){ nd=nd+1; t=t/10; }
  if(neg==1){ ob[oc]=45; oc=oc+1; }
  let p:i32=oc+nd-1;
  if(x==0){ ob[p]=48; }
  while(x>0){ ob[p]=((x%10)+48) as u8; x=x/10; p=p-1; }
  return oc+nd;
}
fn o_flush(ob:[]u8, oc:i32) void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(ob) as i64),(oc as i64),0,0,0);
  return;
}
// ---- helpers ----
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn is_sp(c:u8)i32 { if(c==32 || c==9 || c==10 || c==13){return 1;} return 0; }
fn skip_sp(d:[]u8,s:i32,e:i32)i32 {
  let i:i32=s;
  while(i<e && is_sp(d[i])==1){i=i+1;}
  return i;
}
fn tok_end(d:[]u8,s:i32,e:i32)i32 {
  let i:i32=s;
  while(i<e && is_sp(d[i])==0){i=i+1;}
  return i;
}
fn parse_i32(d:[]u8,s:i32,e:i32) i32 {
  let neg:i32=0; let i:i32=s; let v:i32=0;
  if(i<e && d[i]==45){neg=1;i=i+1;}
  while(i<e && d[i]>=48 && d[i]<=57){v=v*10+(d[i] as i32)-48;i=i+1;}
  if(neg==1){v=0-v;}
  return v;
}
fn tok_eq(d:[]u8,s:i32,e:i32,t:[]u8)i32 {
  if(e-s!=t.len){return 0;}
  let i:i32=0;
  while(i<t.len){if(d[s+i]!=t[i]){return 0;} i=i+1;}
  return 1;
}
fn main()i32 {
  let ob:[]u8=z_alloc(131072);
  let oc:i32=0;
  if(_zag_argc()!=6){
    oc=o_str(ob,oc,"usage: e10_score_bin <world> <transcript> <barspec> <nullval> <inqval>\n");
    o_flush(ob,oc); return 3;
  }
  let nullv:i32=parse_i32(_zag_arg(4),0,_zag_strlen(_zag_arg(4)));
  let inqv:i32=parse_i32(_zag_arg(5),0,_zag_strlen(_zag_arg(5)));
  let wd:[]u8=_zag_read_file(_zag_arg(1));
  let wn:i32=_zag_strlen(wd);
  let td:[]u8=_zag_read_file(_zag_arg(2));
  let tn:i32=_zag_strlen(td);
  let qs:[]u8=z_alloc(256*4); let qr:[]u8=z_alloc(256*4); let qe:[]u8=z_alloc(256*4);
  let os:[]u8=z_alloc(512*4); let orr:[]u8=z_alloc(512*4); let oo:[]u8=z_alloc(512*4);
  let an_s:[]u8=z_alloc(256*4); let an_r:[]u8=z_alloc(256*4); let an_v:[]u8=z_alloc(256*4);
  let ch:[]u8=z_alloc(256*4);
  let nq:i32=0; let na:i32=0; let nc:i32=0; let nob:i32=0;
  let s:i32=0;
  while(s<wn){
    let le:i32=s;
    while(le<wn && wd[le]!=10){le=le+1;}
    let f0:i32=skip_sp(wd,s,le); let f0e:i32=tok_end(wd,f0,le);
    if(tok_eq(wd,f0,f0e,"QUERY")==1 && nq<256){
      let a:i32=skip_sp(wd,f0e,le); let ae:i32=tok_end(wd,a,le);
      let b:i32=skip_sp(wd,ae,le); let be:i32=tok_end(wd,b,le);
      let c:i32=skip_sp(wd,be,le); let ce:i32=tok_end(wd,c,le);
      set32(qs,nq*4,parse_i32(wd,a,ae));
      set32(qr,nq*4,parse_i32(wd,b,be));
      set32(qe,nq*4,parse_i32(wd,c,ce));
      nq=nq+1;
    } else {
      if(tok_eq(wd,f0,f0e,"OBSERVE")==1 && nob<512){
        let a:i32=skip_sp(wd,f0e,le); let ae:i32=tok_end(wd,a,le);
        let b:i32=skip_sp(wd,ae,le); let be:i32=tok_end(wd,b,le);
        let c:i32=skip_sp(wd,be,le); let ce:i32=tok_end(wd,c,le);
        set32(os,nob*4,parse_i32(wd,a,ae));
        set32(orr,nob*4,parse_i32(wd,b,be));
        set32(oo,nob*4,parse_i32(wd,c,ce));
        nob=nob+1;
      }
    }
    s=le+1;
  }
  s=0;
  while(s<tn){
    let le:i32=s;
    while(le<tn && td[le]!=10){le=le+1;}
    let f0:i32=skip_sp(td,s,le); let f0e:i32=tok_end(td,f0,le);
    if(tok_eq(td,f0,f0e,"ANSWER")==1 && na<256){
      let a:i32=skip_sp(td,f0e,le); let ae:i32=tok_end(td,a,le);
      let b:i32=skip_sp(td,ae,le); let be:i32=tok_end(td,b,le);
      let c:i32=skip_sp(td,be,le); let ce:i32=tok_end(td,c,le);
      set32(an_s,na*4,parse_i32(td,a,ae));
      set32(an_r,na*4,parse_i32(td,b,be));
      set32(an_v,na*4,parse_i32(td,c,ce));
      na=na+1;
    } else {
      if(tok_eq(td,f0,f0e,"CHOICE")==1 && nc<256){
        let a:i32=skip_sp(td,f0e,le); let ae:i32=tok_end(td,a,le);
        set32(ch,nc*4,parse_i32(td,a,ae));
        nc=nc+1;
      }
    }
    s=le+1;
  }
  oc=o_str(ob,oc,"PROBES nq="); oc=o_i64(ob,oc,nq as i64);
  oc=o_str(ob,oc," na="); oc=o_i64(ob,oc,na as i64);
  oc=o_str(ob,oc," nc="); oc=o_i64(ob,oc,nc as i64);
  oc=o_str(ob,oc,"\n");
  if(nq!=na){
    oc=o_str(ob,oc,"E10BAR WORLD-INVALID probe/answer count mismatch\n");
    o_flush(ob,oc); return 2;
  }
  let i:i32=0;
  while(i<nq){
    let got:i32=get32(an_v,i*4); let exp:i32=get32(qe,i*4);
    oc=o_str(ob,oc,"PROBE "); oc=o_i64(ob,oc,i as i64);
    oc=o_str(ob,oc," s="); oc=o_i64(ob,oc,get32(qs,i*4) as i64);
    oc=o_str(ob,oc," r="); oc=o_i64(ob,oc,get32(qr,i*4) as i64);
    oc=o_str(ob,oc," exp="); oc=o_i64(ob,oc,exp as i64);
    oc=o_str(ob,oc," got="); oc=o_i64(ob,oc,got as i64);
    if(got==exp){oc=o_str(ob,oc," PASS\n");} else {oc=o_str(ob,oc," FAIL\n");}
    i=i+1;
  }
  oc=o_str(ob,oc,"CHOICES:");
  i=0;
  while(i<nc){oc=o_str(ob,oc," "); oc=o_i64(ob,oc,get32(ch,i*4) as i64); i=i+1;}
  oc=o_str(ob,oc,"\n");
  // barspec; collect NEED probe indices for the T-K15(b) leakcheck
  let bd:[]u8=_zag_read_file(_zag_arg(3));
  let bn:i32=_zag_strlen(bd);
  let needidx:[]u8=z_alloc(256*4); let nneed:i32=0;
  let barfail:i32=0; let invalid:i32=0;
  s=0;
  while(s<bn){
    let le:i32=s;
    while(le<bn && bd[le]!=10){le=le+1;}
    let f0:i32=skip_sp(bd,s,le); let f0e:i32=tok_end(bd,f0,le);
    if(tok_eq(bd,f0,f0e,"HIT")==1){
      let p:i32=skip_sp(bd,f0e,le);
      let okline:i32=1;
      while(p<le){
        let pe:i32=tok_end(bd,p,le);
        if(pe>p){
          let idx:i32=parse_i32(bd,p,pe);
          if(idx<0 || idx>=nq){invalid=1;}
          else { if(get32(an_v,idx*4)!=get32(qe,idx*4)){okline=0;} }
        }
        p=skip_sp(bd,pe,le);
      }
      oc=o_str(ob,oc,"HIT -> ");
      if(invalid==1){oc=o_str(ob,oc,"WORLD-INVALID\n");}
      else { if(okline==1){oc=o_str(ob,oc,"PASS\n");} else {oc=o_str(ob,oc,"FAIL\n"); invalid=1;} }
    } else {
      if(tok_eq(bd,f0,f0e,"NEED")==1){
        let p:i32=skip_sp(bd,f0e,le); let pe:i32=tok_end(bd,p,le);
        let k:i32=parse_i32(bd,p,pe);
        p=skip_sp(bd,pe,le);
        let cnt:i32=0; let tot:i32=0;
        while(p<le){
          pe=tok_end(bd,p,le);
          if(pe>p){
            let idx:i32=parse_i32(bd,p,pe);
            if(idx<0 || idx>=nq){invalid=1;}
            else {
              tot=tot+1;
              if(nneed<256){set32(needidx,nneed*4,idx); nneed=nneed+1;}
              if(get32(an_v,idx*4)==get32(qe,idx*4)){cnt=cnt+1;}
            }
          }
          p=skip_sp(bd,pe,le);
        }
        oc=o_str(ob,oc,"NEED "); oc=o_i64(ob,oc,k as i64);
        oc=o_str(ob,oc," got "); oc=o_i64(ob,oc,cnt as i64);
        oc=o_str(ob,oc,"/"); oc=o_i64(ob,oc,tot as i64);
        oc=o_str(ob,oc," -> ");
        if(invalid==1){oc=o_str(ob,oc,"WORLD-INVALID\n");}
        else { if(cnt>=k){oc=o_str(ob,oc,"PASS\n");} else {oc=o_str(ob,oc,"FAIL\n"); barfail=1;} }
      } else {
        if(tok_eq(bd,f0,f0e,"CHOICE")==1){
          let p:i32=skip_sp(bd,f0e,le); let pe:i32=tok_end(bd,p,le);
          let c:i32=parse_i32(bd,p,pe);
          p=skip_sp(bd,pe,le); pe=tok_end(bd,p,le);
          let want:i32=nullv;
          if(tok_eq(bd,p,pe,"INQ")==1){want=inqv;}
          oc=o_str(ob,oc,"CHOICE "); oc=o_i64(ob,oc,c as i64);
          oc=o_str(ob,oc," want "); oc=o_i64(ob,oc,want as i64);
          if(c<0 || c>=nc){oc=o_str(ob,oc," -> WORLD-INVALID (missing)\n"); invalid=1;}
          else {
            let gotc:i32=get32(ch,c*4);
            oc=o_str(ob,oc," got "); oc=o_i64(ob,oc,gotc as i64);
            oc=o_str(ob,oc," -> ");
            if(gotc==want){oc=o_str(ob,oc,"PASS\n");} else {oc=o_str(ob,oc,"FAIL\n"); barfail=1;}
          }
        }
      }
    }
    s=le+1;
  }
  // T-K15(b): no NEED (bar) probe's (s,r,expected) is OBSERVE-taught
  let lk:i32=0;
  while(lk<nneed){
    let idx:i32=get32(needidx,lk*4);
    let f:i32=0;
    while(f<nob){
      if(get32(os,f*4)==get32(qs,idx*4) && get32(orr,f*4)==get32(qr,idx*4) && get32(oo,f*4)==get32(qe,idx*4)){
        invalid=1;
        oc=o_str(ob,oc,"LEAKCHECK probe "); oc=o_i64(ob,oc,idx as i64);
        oc=o_str(ob,oc," retrieval-passable -> WORLD-INVALID\n");
      }
      f=f+1;
    }
    lk=lk+1;
  }
  if(invalid==0){
    oc=o_str(ob,oc,"LEAKCHECK "); oc=o_i64(ob,oc,nneed as i64);
    oc=o_str(ob,oc," bar probes clean\n");
  }
  if(invalid==1){oc=o_str(ob,oc,"E10BAR WORLD-INVALID\n"); o_flush(ob,oc); return 2;}
  if(barfail==1){oc=o_str(ob,oc,"E10BAR FAIL\n"); o_flush(ob,oc); return 1;}
  oc=o_str(ob,oc,"E10BAR PASS\n"); o_flush(ob,oc);
  return 0;
}

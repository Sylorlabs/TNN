// e10_score_m2w3.zag -- Battery E10 M2-E10-W3 scorer (pure Zag, safe-emit).
// argv: [transcript, driverlog, truthsfile, vocabfile]
// driverlog lines: VOCAB null=<v> inq=<v> ok=<0|1>
//   ACT CAL <k> <c> <INF> | ACT HID <k> <c> <INF>   (INF in NONE/A/B/C,
//   episode-correct per the sealed PIs)
// truthsfile lines: <key> <truth> (hidden keys)
// vocabfile lines: NULL <v> / INQ <v>
// Evaluates T-K10 sub-bars (a)-(e). Exit 0 PASS, 1 FAIL, 2 WORLD-INVALID.
fn o_str(ob:[]u8, oc:i32, s:[]u8) i32 {
  let i:i32=0;
  while(i<s.len){ ob[oc]=s[i]; oc=oc+1; i=i+1; }
  return oc;
}
fn o_i64(ob:[]u8, oc:i32, v:i64) i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=-x; }
  let nd:i32=1; let t:i64=x;
  while(t>=10){ nd=nd+1; t=t/10; }
  if(neg==1){ ob[oc]=45; oc=oc+1; }
  let p:i32=oc+nd-1;
  if(x==0){ ob[p]=48; }
  while(x>0){ ob[p]=((x%10)+48) as u8; x=x/10; p=p-1; }
  return oc+nd;
}
fn o_flush(ob:[]u8, oc:i32) void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(ob) as i64),(oc as i64),0,0,0);
  return;
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn is_sp(c:u8)i32 { if(c==32 || c==9 || c==10 || c==13){return 1;} return 0; }
fn skip_sp(d:[]u8,s:i32,e:i32)i32 {
  let i:i32=s;
  while(i<e && is_sp(d[i])==1){i=i+1;}
  return i;
}
fn tok_end(d:[]u8,s:i32,e:i32)i32 {
  let i:i32=s;
  while(i<e && is_sp(d[i])==0){i=i+1;}
  return i;
}
fn parse_i32(d:[]u8,s:i32,e:i32) i32 {
  let neg:i32=0; let i:i32=s; let v:i32=0;
  if(i<e && d[i]==45){neg=1;i=i+1;}
  while(i<e && d[i]>=48 && d[i]<=57){v=v*10+(d[i] as i32)-48;i=i+1;}
  if(neg==1){v=0-v;}
  return v;
}
fn tok_eq(d:[]u8,s:i32,e:i32,t:[]u8)i32 {
  if(e-s!=t.len){return 0;}
  let i:i32=0;
  while(i<t.len){if(d[s+i]!=t[i]){return 0;} i=i+1;}
  return 1;
}
fn parse_kv(d:[]u8,s:i32,e:i32) i32 {
  let i:i32=s;
  while(i<e && d[i]!=61){i=i+1;}
  if(i>=e){return -999999;}
  return parse_i32(d,i+1,e);
}
fn main()i32 {
  let ob:[]u8=z_alloc(131072);
  let oc:i32=0;
  if(_zag_argc()!=5){
    oc=o_str(ob,oc,"usage: e10_score_m2w3_bin <transcript> <driverlog> <truths> <vocab>\n");
    o_flush(ob,oc); return 3;
  }
  let ld:[]u8=_zag_read_file(_zag_arg(2));
  let ln:i32=_zag_strlen(ld);
  let vocab_ok:i32=0;
  let ncal:i32=0; let nhid:i32=0;
  let calc:[]u8=z_alloc(32*4); let ncalc:i32=0;
  let ncol_ok:i32=0; let ncol:i32=0;
  let s:i32=0;
  while(s<ln){
    let le:i32=s;
    while(le<ln && ld[le]!=10){le=le+1;}
    let f0:i32=skip_sp(ld,s,le); let f0e:i32=tok_end(ld,f0,le);
    if(tok_eq(ld,f0,f0e,"VOCAB")==1){
      let c:i32=skip_sp(ld,f0e,le);
      c=skip_sp(ld,tok_end(ld,c,le),le);
      c=skip_sp(ld,tok_end(ld,c,le),le);
      let ce:i32=tok_end(ld,c,le);
      if(parse_kv(ld,c,ce)==1){vocab_ok=1;}
    } else {
      if(tok_eq(ld,f0,f0e,"ACT")==1){
        let a:i32=skip_sp(ld,f0e,le); let ae:i32=tok_end(ld,a,le);
        let c:i32=skip_sp(ld,ae,le);
        c=skip_sp(ld,tok_end(ld,c,le),le);
        let ce:i32=tok_end(ld,c,le);
        let cv:i32=parse_i32(ld,c,ce);
        if(tok_eq(ld,a,ae,"CAL")==1){
          ncal=ncal+1;
          if(ncalc<32){set32(calc,ncalc*4,cv); ncalc=ncalc+1;}
        } else {
          if(tok_eq(ld,a,ae,"HID")==1){nhid=nhid+1;}
        }
      } else {
        if(tok_eq(ld,f0,f0e,"COLLATERAL")==1){
          let c:i32=skip_sp(ld,f0e,le);
          c=skip_sp(ld,tok_end(ld,c,le),le);
          c=skip_sp(ld,tok_end(ld,c,le),le);
          let ce:i32=tok_end(ld,c,le);
          let d:i32=skip_sp(ld,ce,le); let de:i32=tok_end(ld,d,le);
          ncol=ncol+1;
          if(parse_i32(ld,c,ce)==parse_i32(ld,d,de)){ncol_ok=ncol_ok+1;}
        }
      }
    }
    s=le+1;
  }
  oc=o_str(ob,oc,"VOCAB ok="); oc=o_i64(ob,oc,vocab_ok as i64); oc=o_str(ob,oc,"\n");
  if(vocab_ok==0){
    oc=o_str(ob,oc,"T-K10(e) vocab-verify FAILED -> WORLD-INVALID\n");
    o_flush(ob,oc); return 2;
  }
  let ndist:i32=0;
  let i:i32=0;
  while(i<ncalc){
    let v:i32=get32(calc,i*4); let j:i32=0; let seen:i32=0;
    while(j<i){if(get32(calc,j*4)==v){seen=1;} j=j+1;}
    if(seen==0){ndist=ndist+1;}
    i=i+1;
  }
  let kd:[]u8=_zag_read_file(_zag_arg(3));
  let kn:i32=_zag_strlen(kd);
  let hk:[]u8=z_alloc(16*4); let ht:[]u8=z_alloc(16*4); let nhk:i32=0;
  s=0;
  while(s<kn){
    let le:i32=s;
    while(le<kn && kd[le]!=10){le=le+1;}
    let f0:i32=skip_sp(kd,s,le); let f0e:i32=tok_end(kd,f0,le);
    if(f0e>f0 && nhk<16){
      let a:i32=skip_sp(kd,f0e,le); let ae:i32=tok_end(kd,a,le);
      set32(hk,nhk*4,parse_i32(kd,f0,f0e));
      set32(ht,nhk*4,parse_i32(kd,a,ae));
      nhk=nhk+1;
    }
    s=le+1;
  }
  let td:[]u8=_zag_read_file(_zag_arg(1));
  let tn:i32=_zag_strlen(td);
  let lastv:[]u8=z_alloc(16*4);
  i=0;
  while(i<nhk){set32(lastv,i*4,-999999); i=i+1;}
  s=0;
  while(s<tn){
    let le:i32=s;
    while(le<tn && td[le]!=10){le=le+1;}
    let f0:i32=skip_sp(td,s,le); let f0e:i32=tok_end(td,f0,le);
    if(tok_eq(td,f0,f0e,"ANSWER")==1){
      let a:i32=skip_sp(td,f0e,le); let ae:i32=tok_end(td,a,le);
      let b:i32=skip_sp(td,ae,le); let be:i32=tok_end(td,b,le);
      let c:i32=skip_sp(td,be,le); let ce:i32=tok_end(td,c,le);
      let subj:i32=parse_i32(td,a,ae);
      let vv:i32=parse_i32(td,c,ce);
      i=0;
      while(i<nhk){
        if(get32(hk,i*4)==subj){set32(lastv,i*4,vv);}
        i=i+1;
      }
    }
    s=le+1;
  }
  let nprobe_ok:i32=0;
  i=0;
  while(i<nhk){
    oc=o_str(ob,oc,"HIDDEN key="); oc=o_i64(ob,oc,get32(hk,i*4) as i64);
    oc=o_str(ob,oc," truth="); oc=o_i64(ob,oc,get32(ht,i*4) as i64);
    oc=o_str(ob,oc," final="); oc=o_i64(ob,oc,get32(lastv,i*4) as i64);
    if(get32(lastv,i*4)==get32(ht,i*4)){oc=o_str(ob,oc," PASS\n"); nprobe_ok=nprobe_ok+1;}
    else {oc=o_str(ob,oc," FAIL\n");}
    i=i+1;
  }
  oc=o_str(ob,oc,"COLLATERAL "); oc=o_i64(ob,oc,ncol_ok as i64);
  oc=o_str(ob,oc,"/"); oc=o_i64(ob,oc,ncol as i64); oc=o_str(ob,oc,"\n");
  let fail:i32=0;
  oc=o_str(ob,oc,"T-K10(a) engagement hid_acts="); oc=o_i64(ob,oc,nhid as i64);
  if(nhid>=1){oc=o_str(ob,oc," PASS\n");} else {oc=o_str(ob,oc," FAIL\n"); fail=1;}
  oc=o_str(ob,oc,"T-K10(b) final="); oc=o_i64(ob,oc,nprobe_ok as i64);
  oc=o_str(ob,oc,"/"); oc=o_i64(ob,oc,nhk as i64); oc=o_str(ob,oc," need>=3 -> ");
  if(nprobe_ok>=3){oc=o_str(ob,oc,"PASS\n");} else {oc=o_str(ob,oc,"FAIL\n"); fail=1;}
  oc=o_str(ob,oc,"T-K10(c) budget hid_acts="); oc=o_i64(ob,oc,nhid as i64); oc=o_str(ob,oc," need<=4 -> ");
  if(nhid<=4){oc=o_str(ob,oc,"PASS\n");} else {oc=o_str(ob,oc,"FAIL\n"); fail=1;}
  oc=o_str(ob,oc,"T-K10(d) cal_distinct="); oc=o_i64(ob,oc,ndist as i64); oc=o_str(ob,oc," need>=2 -> ");
  if(ndist>=2){oc=o_str(ob,oc,"PASS\n");} else {oc=o_str(ob,oc,"FAIL\n"); fail=1;}
  oc=o_str(ob,oc,"T-K10(e) vocab-verify PASS\n");
  if(fail==1){oc=o_str(ob,oc,"E10BAR FAIL\n"); o_flush(ob,oc); return 1;}
  oc=o_str(ob,oc,"E10BAR PASS\n"); o_flush(ob,oc);
  return 0;
}

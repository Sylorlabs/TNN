// e10_inspect.zag -- white-box state inspector for battery E10 (diagnostic only).
// Usage: e10_inspect_bin <state.bin>
// Prints TRIAL stats, POLICYROOT, MAP nodes, UNCERT nodes, GUIDE nodes.
// Read-only. Pure Zag, pinned znc. Safe-emit (single buffer, one raw write).
// NEVER part of a bar (correction 3).
fn o_str(ob:[]u8, oc:i32, s:[]u8) i32 {
  let i:i32=0;
  while(i<s.len){ ob[oc]=s[i]; oc=oc+1; i=i+1; }
  return oc;
}
fn o_i64(ob:[]u8, oc:i32, v:i64) i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=-x; }
  let nd:i32=1; let t:i64=x;
  while(t>=10){ nd=nd+1; t=t/10; }
  if(neg==1){ ob[oc]=45; oc=oc+1; }
  let p:i32=oc+nd-1;
  if(x==0){ ob[p]=48; }
  while(x>0){ ob[p]=((x%10)+48) as u8; x=x/10; p=p-1; }
  return oc+nd;
}
fn o_flush(ob:[]u8, oc:i32) void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(ob) as i64),(oc as i64),0,0,0);
  return;
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn shg(W:[]u8,f:i32)i32 { return ig(W,f); }
fn sng(W:[]u8,n:i32,f:i32)i32 { return ig(W,64+n*40+f); }
fn seg(W:[]u8,e:i32,f:i32)i32 { return ig(W,41024+e*16+f); }
fn main()i32 {
  let ob:[]u8=z_alloc(262144);
  let oc:i32=0;
  if(_zag_argc()!=2){
    oc=o_str(ob,oc,"usage: e10_inspect_bin <state.bin>\n");
    o_flush(ob,oc); return 2;
  }
  let W:[]u8=_zag_read_file(_zag_arg(1));
  if(W.len<110656){
    oc=o_str(ob,oc,"state.bin too short\n");
    o_flush(ob,oc); return 3;
  }
  let trial:i32=shg(W,16);
  oc=o_str(ob,oc,"TRIAL tried="); oc=o_i64(ob,oc,(trial/1024) as i64);
  oc=o_str(ob,oc," rej="); oc=o_i64(ob,oc,(trial%1024) as i64); oc=o_str(ob,oc,"\n");
  let pr:i32=shg(W,20);
  oc=o_str(ob,oc,"POLICYROOT "); oc=o_i64(ob,oc,pr as i64); oc=o_str(ob,oc,"\n");
  let n:i32=2;
  while(n<1024){
    if(sng(W,n,36)==1 && sng(W,n,0)==20){
      oc=o_str(ob,oc,"MAP s="); oc=o_i64(ob,oc,sng(W,n,8) as i64);
      oc=o_str(ob,oc," r="); oc=o_i64(ob,oc,sng(W,n,4) as i64);
      oc=o_str(ob,oc," ans="); oc=o_i64(ob,oc,sng(W,n,28) as i64);
      oc=o_str(ob,oc," root="); oc=o_i64(ob,oc,sng(W,n,20) as i64);
      oc=o_str(ob,oc,"\n");
    }
    n=n+1;
  }
  n=2;
  let nu:i32=0;
  while(n<1024){
    if(sng(W,n,36)==1 && sng(W,n,0)==30){nu=nu+1;}
    n=n+1;
  }
  oc=o_str(ob,oc,"UNCERTS "); oc=o_i64(ob,oc,nu as i64); oc=o_str(ob,oc,"\n");
  n=2;
  let ng_:i32=0;
  while(n<1024){
    if(sng(W,n,36)==1 && sng(W,n,0)==1){
      let e:i32=0; let linked:i32=0;
      while(e<4096){
        if(seg(W,e,0)!=-1 && seg(W,e,4)==10 && (seg(W,e,0)==n || seg(W,e,8)==n)){linked=1;}
        e=e+1;
      }
      if(linked==1){ng_=ng_+1;}
    }
    n=n+1;
  }
  oc=o_str(ob,oc,"GUIDES "); oc=o_i64(ob,oc,ng_ as i64); oc=o_str(ob,oc,"\n");
  o_flush(ob,oc);
  return 0;
}

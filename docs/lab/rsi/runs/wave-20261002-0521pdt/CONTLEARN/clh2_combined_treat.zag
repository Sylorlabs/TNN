// ============ ACT 24/24 remediation port (prereg ACT_REMED_PREREG.md) ============
// Ported from act_build/act.zag (614 lines, 23 ptests + ALL-PASS).
// Test names and expected values identical to standalone (K3 fidelity).
// P-ACT6A/B use TNN-1's real evict_node (3-step directional) not the stand-in.

fn r_ptest(name:[]u8, got:i32, want:i32)i32 {
  emit(name); emit(": got "); e64(got); emit(" want "); e64(want);
  if(got==want){ emit(" PASS\n"); return 1; } else { emit(" FAIL\n"); return 0; }
}
fn r_mk_fact(W:[]u8)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,1); return a;
}
fn r_mk_goal(W:[]u8, target:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,2); ns(W,a,4,target); return a;
}
fn r_mk_guide(W:[]u8, anchor:i32, goal:i32, choice:i32, conf:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,102); ns(W,a,4,anchor); ns(W,a,8,goal);
  write_node(W,a,choice,conf,0,0); link_edge(W,goal,1,a,0); return a;
}
fn r_mk_uncert(W:[]u8, qctx:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,30); ns(W,a,4,qctx); return a;
}
fn r_learn_confirm(W:[]u8, ses:i32, a:i32)void {
  link_edge(W,ses,6,a,0); link_edge(W,ses,7,a,0); return;
}
fn r_ctx_clear(W:[]u8)void {
  hs(W,48,0); hs(W,32,0); hs(W,36,0); hs(W,40,0); hs(W,44,0); return;
}
fn r_live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn r_evict_to_cap(W:[]u8, cap:i32)i32 {
  let ev:i32=0; let guard:i32=0;
  while(r_live_count(W)>cap && guard<10000){
    guard=guard+1;
    let v:i32=evict_node(W);
    if(v<0){ return ev; }
    ev=ev+1;
  }
  return ev;
}
fn r_derive_d1(W:[]u8, ses:i32, goal:i32, gstate:i32, trans:[]u8, nt:i32)i32 {
  let made:i32=0;
  let work:[]u8=z_alloc(256*4);
  set32(work,0,gstate); let wc:i32=1; let wi:i32=0;
  while(wi<wc){
    let s:i32=get32(work,wi*4);
    let t:i32=0;
    while(t<nt){
      let fs:i32=get32(trans,t*12); let ac:i32=get32(trans,t*12+4);
      let ts:i32=get32(trans,t*12+8);
      if(ts==s){
        let has:i32=0; let a:i32=2;
        while(a<1024){
          if(ng(W,a,36)==1 && ng(W,a,0)==102 && ng(W,a,4)==fs){ has=1; }
          a=a+1;
        }
        if(has==0){
          r_mk_guide(W,fs,goal,ac,80);
          made=made+1;
          let seen:i32=0; let k:i32=0;
          while(k<wc){ if(get32(work,k*4)==fs){seen=1;} k=k+1; }
          if(seen==0 && wc<256){ set32(work,wc*4,fs); wc=wc+1; }
        }
      }
      t=t+1;
    }
    wi=wi+1;
  }
  return made;
}
// P-ACT3: null POLICY_ROOT -> CHOICE 0 always
fn t_r_pact3()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s1:i32=r_mk_fact(W);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  return r_ptest("P-ACT3 null-root", c, 0);
}
// P-ACT1: W7-class planning. States s1->s2->s3, goal s3.
fn t_r_pact1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let s3:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(3*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,11); set32(tr,20,s3);
  set32(tr,24,s3); set32(tr,28,10); set32(tr,32,s3);
  let goal:i32=r_mk_goal(W,s3);
  let made:i32=r_derive_d1(W,ses,goal,s3,tr,3);
  pol_set(W,goal);
  let a:i32=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT1 s1->10", ev_act(W), 10);
  r_ctx_clear(W); ctx_push(W,s2);
  ok=ok & r_ptest("P-ACT1 s2->11", ev_act(W), 11);
  r_ctx_clear(W); ctx_push(W,s3);
  ok=ok & r_ptest("P-ACT1 s3->10", ev_act(W), 10);
  ok=ok & r_ptest("P-ACT1 3 guides", made, 3);
  return ok;
}
// P-ACT2: W6-class inquiry.
fn t_r_pact2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let q:i32=r_mk_fact(W);
  let d:i32=r_mk_fact(W);
  let u:i32=r_mk_uncert(W,q);
  let idx:i32=r_mk_fact(W);
  let g1:i32=r_mk_guide(W,u,idx,20,90);
  let g2:i32=r_mk_guide(W,d,idx,21,90);
  link_edge(W,idx,1,g1,0); link_edge(W,idx,1,g2,0);
  pol_set(W,idx);
  r_learn_confirm(W,ses,g1); r_learn_confirm(W,ses,g2);
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,u);
  ok=ok & r_ptest("P-ACT2 uncert->20", ev_act(W), 20);
  r_ctx_clear(W); ctx_push(W,d);
  ok=ok & r_ptest("P-ACT2 decoy->21", ev_act(W), 21);
  r_ctx_clear(W); ctx_push(W,q);
  ok=ok & r_ptest("P-ACT2 other->0", ev_act(W), 0);
  return ok;
}
// P-ACT4: structure ablation.
fn t_r_pact4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(2*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,10); set32(tr,20,s2);
  let goal:i32=r_mk_goal(W,s2);
  r_derive_d1(W,ses,goal,s2,tr,2);
  pol_set(W,goal);
  let a:i32=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 pre s1->10", ev_act(W), 10);
  a=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ ns(W,a,0,0); ns(W,a,36,0); }
    a=a+1;
  }
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 no-guides->0", ev_act(W), 0);
  a=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==0 && a!=goal){ ns(W,a,0,102); }
    a=a+1;
  }
  ns(W,goal,0,0);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  ok=ok & r_ptest("P-ACT4 no-goal->0", c, 0);
  ok=ok & r_ptest("P-ACT4 fact-alive", ng(W,s1,0), 1);
  return ok;
}
// P-ACT5: generality (one handler, both classes).
fn t_r_pact5()i32 {
  let ok:i32=t_r_pact1();
  ok=ok & t_r_pact2();
  emit("P-ACT5 one-handler-both-classes: ");
  if(ok==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return ok;
}
// P-ACT6: memory prerequisite (real 3-step eviction).
fn t_r_pact6()i32 {
  let ok:i32=1;
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let goal:i32=r_mk_goal(W,s2);
  let g1:i32=r_mk_guide(W,s1,goal,10,80);
  pol_set(W,goal);
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A pre s1->10", ev_act(W), 10);
  let j:i32=0;
  while(j<60){
    let x:i32=r_mk_fact(W);
    if(x<0){ j=999; }
    j=j+1;
  }
  let nev:i32=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6A evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A post->0", ev_act(W), 0);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ses=r_mk_fact(W2); s1=r_mk_fact(W2); s2=r_mk_fact(W2);
  goal=r_mk_goal(W2,s2);
  g1=r_mk_guide(W2,s1,goal,10,80);
  pol_set(W2,goal);
  r_learn_confirm(W2,ses,g1);
  r_learn_confirm(W2,ses,goal);
  link_edge(W2,ses,6,s1,0);
  link_edge(W2,ses,9,ses,1);
  j=0;
  while(j<60){
    let x:i32=r_mk_fact(W2);
    if(x<0){ j=999; }
    j=j+1;
  }
  nev=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W2);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6B evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W2); ctx_push(W2,s1);
  ok=ok & r_ptest("P-ACT6B post s1->10", ev_act(W2), 10);
  return ok;
}
// clh2_driver_full.zag -- CLH2 longer-horizon delayed REBIND driver
// (wave-20261002-0521pdt, lane CONTLEARN).
// Phase-2 implementation for frozen prereg PREREG_CLH.md (166 events).
//
// FIXTURE ONLY. This file defines 0 cognition functions (no learning,
// retrieval, inference, retention, eviction, planning, derivation, revision,
// or execution logic), 0 new node tags, 0 new edge types, 0 new opcodes,
// 0 modes, 0 bridges, 0 routers, 0 task-specific handlers, 0 semantic cases.
// It emits the frozen 166-event script, calls the frozen TNN-2 event API
// (ev_teach/ev_query/ev_observe), runs read-only white-box censuses through
// the core's own accessors (ng/eg/activate/is_superseded), and prints
// results. No branching-on-opcode statements anywhere in this file.
//
// Link: concatenated after either the control core (clh2_core_control.zag,
// byte copy of the recorded nomain derivation of the frozen core) or the
// instrument core (clh2_core_treat.zag, the proposal-gated derivation from
// CONTLEARN3). All names here are clh_ prefixed; the frozen source contains
// zero clh_ occurrences, so nothing collides and nothing is redefined.
// PHASE markers are driver-side prints; cognition receives only
// (kind, subject, relation, object) integer tuples through the choke points
// clh_event / clh_mquery. clh_mquery passes the frozen supervisor-disconnect
// parameters expected=-2, flags=1 (masked query, disclosed in the prereg);
// this carries no task identity and is not a task label. Kind 3 is
// ev_observe, the frozen counterexample protocol, disclosed in the prereg;
// it carries no task identity either.

// ============ small fixture helpers ============
fn clh_fnv(W:[]u8)i32 {
  let h:i32=-2128831035;
  let i:i32=0;
  while(i<110656){ h=(h ^ (W[i] as i32))*16777619; i=i+1; }
  return h;
}
fn clh_count_nodes(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
fn clh_alive_nodes(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn clh_count_edges(W:[]u8,ty:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1 && eg(W,e,4)==ty){c=c+1;} e=e+1; }
  return c;
}
fn clh_count_edges_all(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
fn clh_count_guides(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-999){c=c+1;}
    n=n+1;
  }
  return c;
}
fn clh_count_proposals(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-998){c=c+1;}
    n=n+1;
  }
  return c;
}
fn clh_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
fn clh_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
fn clh_find_proposal(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-998 && ng(W,n,4)==s && ng(W,n,28)==r){return n;}
    n=n+1;
  }
  return -1;
}
fn clh_has_dep(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==1 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
// ============ cognition choke points (K1c audit) ============
fn clh_event(W:[]u8,kind:i32,s:i32,r:i32,o:i32)i32 {
  if(kind<1 || kind>3){ emit("AUDIT_FAIL kind="); e64(kind); emit("\n"); return -999; }
  emit("EV "); e64(kind); emit(" "); e64(s); emit(" "); e64(r); emit(" "); e64(o);
  hs(W,52,hg(W,52)+1);
  if(kind==1){ let q:i32=ev_teach(W,s,r,o); emit("\n"); return q; }
  if(kind==2){ let a:i32=ev_query(W,s,r,-2,1); emit(" ans="); e64(a); emit("\n"); return a; }
  let v:i32=ev_observe(W,s,r,o); emit(" rv="); e64(v); emit("\n"); return v;
}
fn clh_mquery(W:[]u8,s:i32,r:i32)i32 {
  emit("EV 2 "); e64(s); emit(" "); e64(r); emit(" -2 MK");
  hs(W,52,hg(W,52)+1);
  let a:i32=ev_query(W,s,r,-2,1);
  emit(" ans="); e64(a); emit("\n");
  return a;
}
// ============ frozen phases (exact tuples from prereg section 3a) ============
// CAPABILITY: 18 events. store_ans holds the 6 integrate answers.
fn clh_capability(W:[]u8,store_ans:[]u8)void {
  emit("PHASE CAPABILITY\n");
  let i:i32=0;
  while(i<6){ clh_event(W,1,96001+i,850,96101+i); i=i+1; }
  i=0;
  while(i<6){ clh_event(W,1,96101+i,851,96201+i); i=i+1; }
  i=0;
  while(i<6){ set32(store_ans,i*4,clh_mquery(W,96001+i,852)); i=i+1; }
  return;
}
// INT1: 96 memory-pressure facts.
fn clh_int1(W:[]u8)void {
  emit("PHASE INT1\n");
  let i:i32=0;
  while(i<96){ clh_event(W,1,96301+i,853,96401+i); i=i+1; }
  return;
}
// INT2: unrelated conflict plus correction episode. Prints INT2_OK x/1.
fn clh_int2(W:[]u8)void {
  emit("PHASE INT2\n");
  clh_event(W,1,96501,854,96601);
  let rv1:i32=clh_event(W,3,96501,854,96602);
  let rv2:i32=clh_event(W,3,96501,854,96603);
  let a:i32=clh_mquery(W,96501,854);
  let fa:i32=clh_find_fact(W,96501,854,96601);
  let fb:i32=clh_find_fact(W,96501,854,96602);
  let fc:i32=clh_find_fact(W,96501,854,96603);
  let ok:i32=0;
  if(rv1==0 && rv2==0 && fa>=0 && is_superseded(W,fa)==1 && fb>=0 && is_superseded(W,fb)==1 && fc>=0 && is_superseded(W,fc)==0 && a==96603){ok=1;}
  emit("INT2_OK "); e64(ok); emit("/1\n");
  return;
}
// INT3: second task family, 18 events. store3_ans holds integrate answers.
fn clh_int3(W:[]u8,store3_ans:[]u8)void {
  emit("PHASE INT3\n");
  let i:i32=0;
  while(i<6){ clh_event(W,1,96701+i,855,96801+i); i=i+1; }
  i=0;
  while(i<6){ clh_event(W,1,96801+i,857,96901+i); i=i+1; }
  i=0;
  while(i<6){ set32(store3_ans,i*4,clh_mquery(W,96701+i,858)); i=i+1; }
  return;
}
// serving-node check: activate's node must be the content-expected live fact.
fn clh_serve_ok(W:[]u8,s:i32,r:i32,exp:i32,got:i32)i32 {
  if(got!=exp){return 0;}
  let n:i32=activate(W,s,r);
  if(n<2){return 0;}
  if(ng(W,n,36)!=1 || ng(W,n,0)!=1){return 0;}
  if(ng(W,n,20)!=s || ng(W,n,24)!=r || ng(W,n,28)!=exp){return 0;}
  if(is_superseded(W,n)==1){return 0;}
  return 1;
}
// RETENTION: 6 probes of phase-A knowledge before rebind.
fn clh_retention(W:[]u8)void {
  emit("PHASE RETENTION\n");
  let c:i32=0; let i:i32=0;
  while(i<6){
    let a:i32=clh_mquery(W,96001+i,852);
    if(clh_serve_ok(W,96001+i,852,96201+i,a)==1){c=c+1;}
    i=i+1;
  }
  emit("RETAIN_OK "); e64(c); emit("/6\n");
  return;
}
// REBIND anchors: 12 events, new subjects bound into the old chains.
fn clh_rebind_anchors(W:[]u8)void {
  emit("PHASE REBIND_ANCHOR\n");
  let i:i32=0;
  while(i<6){ clh_event(W,1,97001+i,862,96101+i); i=i+1; }
  i=0;
  while(i<6){ clh_event(W,1,97101+i,864,96001+i); i=i+1; }
  return;
}
// REBIND queries: 12 new problems. Prints REBIND_OK x/12 and
// REBIND_PROP_CITE x/12.
fn clh_rebind(W:[]u8)void {
  emit("PHASE REBIND\n");
  let c:i32=0; let cp:i32=0; let i:i32=0;
  while(i<6){
    let a:i32=clh_mquery(W,97001+i,863);
    let m:i32=clh_find_map(W,97001+i,863);
    let ft:i32=clh_find_fact(W,96101+i,851,96201+i);
    let fa:i32=clh_find_fact(W,97001+i,862,96101+i);
    let p:i32=clh_find_proposal(W,97001+i,863);
    if(m>=0 && ft>=0 && fa>=0 && clh_has_dep(W,m,ft)==1 && clh_has_dep(W,m,fa)==1 && clh_serve_ok(W,97001+i,863,96201+i,a)==1){c=c+1;}
    else { emit("REBIND_MISS TAIL "); e64(i); emit("\n"); }
    if(m>=0 && p>=0 && clh_has_dep(W,m,p)==1){cp=cp+1;}
    i=i+1;
  }
  i=0;
  while(i<6){
    let a:i32=clh_mquery(W,97101+i,866);
    let m:i32=clh_find_map(W,97101+i,866);
    let fh:i32=clh_find_fact(W,96001+i,850,96101+i);
    let fa:i32=clh_find_fact(W,97101+i,864,96001+i);
    let p:i32=clh_find_proposal(W,97101+i,866);
    if(m>=0 && fh>=0 && fa>=0 && clh_has_dep(W,m,fh)==1 && clh_has_dep(W,m,fa)==1 && clh_serve_ok(W,97101+i,866,96101+i,a)==1){c=c+1;}
    else { emit("REBIND_MISS HEAD "); e64(i); emit("\n"); }
    if(m>=0 && p>=0 && clh_has_dep(W,m,p)==1){cp=cp+1;}
    i=i+1;
  }
  emit("REBIND_OK "); e64(c); emit("/12\n");
  emit("REBIND_PROP_CITE "); e64(cp); emit("/12\n");
  return;
}
// STORE3_OK: INT3 family integration oracle. Prints x/6.
fn clh_store3_ok(W:[]u8,store3_ans:[]u8)void {
  let c:i32=0; let i:i32=0;
  while(i<6){
    let m:i32=clh_find_map(W,96701+i,858);
    let f1:i32=clh_find_fact(W,96701+i,855,96801+i);
    let f2:i32=clh_find_fact(W,96801+i,857,96901+i);
    if(m>=0 && f1>=0 && f2>=0 && clh_has_dep(W,m,f1)==1 && clh_has_dep(W,m,f2)==1 && get32(store3_ans,i*4)==96901+i){c=c+1;}
    else { emit("STORE3_MISS "); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("STORE3_OK "); e64(c); emit("/6\n");
  return;
}
// PRESSURE_OK: 96/96 INT1 facts live.
fn clh_pressure_ok(W:[]u8)void {
  let c:i32=0; let i:i32=0;
  while(i<96){
    if(clh_find_fact(W,96301+i,853,96401+i)>=0){c=c+1;}
    i=i+1;
  }
  emit("PRESSURE_OK "); e64(c); emit("/96\n");
  return;
}
// SURVIVE_OK: phase-A MAPs live with intact citations; answer facts live.
fn clh_survive_ok(W:[]u8)void {
  let c:i32=0; let cf:i32=0; let i:i32=0;
  while(i<6){
    let m:i32=clh_find_map(W,96001+i,852);
    let f1:i32=clh_find_fact(W,96001+i,850,96101+i);
    let f2:i32=clh_find_fact(W,96101+i,851,96201+i);
    if(m>=0 && f1>=0 && f2>=0 && clh_has_dep(W,m,f1)==1 && clh_has_dep(W,m,f2)==1){c=c+1;}
    else { emit("SURVIVE_MISS "); e64(i); emit("\n"); }
    if(clh_find_fact(W,96001+i,852,96201+i)>=0){cf=cf+1;}
    i=i+1;
  }
  emit("SURVIVE_OK "); e64(c); emit("/6\n");
  emit("SURVIVE_ANSFACT "); e64(cf); emit("/6\n");
  return;
}
// Capacity guard: VOID the run if the arena approaches its caps.
fn clh_capacity_guard(W:[]u8)i32 {
  let nn:i32=clh_alive_nodes(W);
  let ee:i32=clh_count_edges_all(W);
  emit("CAPGUARD nodes="); e64(nn); emit(" edges="); e64(ee); emit("\n");
  if(nn>=900 || ee>=3500){ emit("CAP_GUARD_TRIP\n"); return 1; }
  emit("CAP_GUARD_OK\n");
  return 0;
}
// read-only mechanism census after a phase.
fn clh_census(W:[]u8,ph:[]u8)void {
  emit("CENSUS "); emit(ph);
  emit(" MAPC="); e64(clh_count_nodes(W,20));
  emit(" PROPC="); e64(clh_count_proposals(W));
  emit(" DEPC="); e64(clh_count_edges(W,1));
  emit(" UNC="); e64(clh_count_nodes(W,30));
  emit(" GUIDEC="); e64(clh_count_guides(W));
  emit(" N1="); e64(clh_count_nodes(W,1));
  emit(" Eall="); e64(clh_count_edges_all(W));
  emit("\n");
  return;
}
// ============ entry ============
fn clh_main()i32 {
  emit("MODE CLH2-FULL\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let store_ans:[]u8=z_alloc(24);
  let store3_ans:[]u8=z_alloc(24);
  clh_capability(W,store_ans);
  clh_census(W,"CAP");
  clh_int1(W);
  clh_census(W,"INT1");
  clh_int2(W);
  clh_census(W,"INT2");
  clh_int3(W,store3_ans);
  clh_census(W,"INT3");
  clh_store3_ok(W,store3_ans);
  clh_pressure_ok(W);
  clh_retention(W);
  clh_census(W,"RETAIN");
  clh_rebind_anchors(W);
  clh_census(W,"ANCHOR");
  clh_rebind(W);
  clh_census(W,"REBIND");
  clh_survive_ok(W);
  if(clh_capacity_guard(W)==1){ return 1; }
  emit("FNV "); e64(clh_fnv(W)); emit("\n");
  if(hg(W,52)==166){ emit("AUDIT_PASS\n"); }
  else { emit("AUDIT_FAIL count="); e64(hg(W,52)); emit(" want=166\n"); return 1; }
  return 0;
}
fn main()i32 { return clh_main(); }

// x1c_agents.zag -- EXP1c agent arms, wave-20260927-1721pdt, from scratch.
// P: kb_p_exp1c.txt taught ward strategy, verbatim (positive control).
// R: kb_exp1c.txt taught single-step heuristics H1-H9, recall only.
// Z: fixed-seed LCG uniform action, documented control (not the AI).
// I: PREREG_EXP1c M1-M4 compositional-choice deliberation.
// Uses the REAL frozen world API: w.apos, W_NCELLS, the world's own w_step.
// Storms are TIME windows (O_STORMS/O_STORME ticks). No world reimplementation.
// Pure Zag. No Python. Zero RNG in decision paths (Z's LCG is a seeded control).

@import("x1c_params.zag")

// ---- shared agent state ----
struct AState {
    phase:i32,
    ca:i32,
    cb:i32,
    aux0:i32,
    rng:i32,
}

fn a_new()AState {
    return AState{.phase=0, .ca=-1, .cb=-1, .aux0=0, .rng=0};
}

fn z_new(seed:i32)AState {
    return AState{.phase=0, .ca=0, .cb=1, .aux0=0, .rng=seed};
}

// nearest mote cell to the agent (any mote)
fn x_near_mote(w:*World)i32 {
    let best:i32 = -1;
    let bd:i32 = 999;
    let i:i32 = 0;
    while (i < 6) {
        let c:i32 = w.mem[w.base+O_MPOS+i];
        let d:i32 = w.apos - c;
        if (d < 0) { d = 0 - d; }
        if (d < bd) { bd = d; best = c; }
        i = i+1;
    }
    return best;
}

// nearest crystal cell to the agent, or -1
fn x_near_crys(w:*World)i32 {
    let best:i32 = -1;
    let bd:i32 = 999;
    let c:i32 = 0;
    while (c < 24) {
        if (w.mem[w.base+O_GCRYS+c] == 1) {
            let d:i32 = w.apos - c;
            if (d < 0) { d = 0 - d; }
            if (d < bd) { bd = d; best = c; }
        }
        c = c+1;
    }
    return best;
}

fn x_step_to(w:*World, target:i32)i32 {
    if (w.apos < target) { return 1; }
    if (w.apos > target) { return 0; }
    return 6;
}

// count crystals in inventory
fn x_count_crys(w:*World)i32 {
    let n:i32 = 0;
    let i:i32 = 0;
    while (i < w.inv_n) {
        if (w.mem[w.base+O_INV+i] == 0) { n = n + 1; }
        i = i+1;
    }
    return n;
}

// find two crystal slots for COMBINE; sets st.ca/st.cb, returns 1 if found
fn x_find_cc(w:*World, st:*AState)i32 {
    let a:i32 = -1;
    let b:i32 = -1;
    let i:i32 = 0;
    while (i < w.inv_n) {
        if (w.mem[w.base+O_INV+i] == 0) {
            if (a < 0) { a = i; } else { b = i; }
        }
        i = i+1;
    }
    if (a >= 0 && b >= 0) {
        st.ca = a;
        st.cb = b;
        return 1;
    }
    return 0;
}

// ---- P arm: taught ward strategy (positive control) ----
// H0 forage; H1 build ward at home from 2 crystals; H2 sit on warded home.
fn p_act(w:*World, st:*AState)i32 {
    if (st.phase == 0) {
        let m:i32 = x_near_mote(w);
        if (m >= 0 && w.apos == m) { return 2; }
        if (w.energy < 60) {
            let c:i32 = x_near_crys(w);
            if (c >= 0) {
                if (w.apos == c) { return 3; }
                return x_step_to(w, c);
            }
        }
        if (m >= 0) { return x_step_to(w, m); }
        if (x_count_crys(w) >= 2) { st.phase = 1; }
        else { st.phase = 1; }
    }
    if (st.phase == 1) {
        if (x_count_crys(w) >= 2) {
            if (w.apos == w.home) {
                if (x_find_cc(w, st) == 1) { st.phase = 2; return 5; }
            }
            return x_step_to(w, w.home);
        }
        let c:i32 = x_near_crys(w);
        if (c >= 0) {
            if (w.apos == c) {
                if (w.inv_n < 4) { return 3; }
                return 6;
            }
            return x_step_to(w, c);
        }
        st.phase = 2;
    }
    // phase 2: hold warded home; eat locally when hungry
    if (w.mem[w.base+O_WARD+w.apos] == 0) {
        if (w.apos == w.home && w.mem[w.base+O_WARD+w.home] == 0) {
            if (x_count_crys(w) >= 2 && x_find_cc(w, st) == 1) { return 5; }
        }
        return x_step_to(w, w.home);
    }
    if (w.energy < 50) {
        let m:i32 = x_near_mote(w);
        if (m >= 0) {
            if (w.apos == m) { return 2; }
            let d:i32 = w.apos - m;
            if (d < 0) { d = 0 - d; }
            if (d <= 2) { return x_step_to(w, m); }
        }
    }
    return 6;
}

// ---- R arm: taught single-step heuristics H1-H9, recall only ----
fn r_act(w:*World, st:*AState)i32 {
    // H1: eat mote on cell
    let i:i32 = 0;
    while (i < 6) {
        if (w.mem[w.base+O_MPOS+i] == w.apos) { return 2; }
        i = i+1;
    }
    // H2: take crystal on cell
    if (w.mem[w.base+O_GCRYS+w.apos] == 1 && w.inv_n < 4) { return 3; }
    // H3: step toward nearest mote
    let m:i32 = x_near_mote(w);
    if (m >= 0 && m != w.apos) { return x_step_to(w, m); }
    // H4: step toward nearest crystal if carrying capacity
    if (w.inv_n < 4) {
        let c:i32 = x_near_crys(w);
        if (c >= 0 && c != w.apos) { return x_step_to(w, c); }
    }
    // H5-H9: wait (no taught response covers this state)
    return 6;
}

// ---- Z arm: fixed-seed LCG control ----
fn z_act(w:*World, st:*AState)i32 {
    st.rng = (st.rng * 6364136223846793005 + 1442695040888963407) & 9223372036854775807;
    let a:i32 = ((st.rng >> 33) % 7) as i32;
    if (a < 0) { a = 0 - a; }
    if (a == 5) { st.ca = 0; st.cb = 1; }
    return a;
}

// ---- calibration strategies (scripted, no learning) ----
fn f_act(w:*World, st:*AState)i32 {
    let i:i32 = 0;
    while (i < 6) {
        if (w.mem[w.base+O_MPOS+i] == w.apos) { return 2; }
        i = i+1;
    }
    let m:i32 = x_near_mote(w);
    if (m >= 0) { return x_step_to(w, m); }
    return 6;
}

fn lf_act(w:*World, st:*AState)i32 {
    if (st.phase == 0) {
        let c:i32 = x_near_crys(w);
        if (c < 0 && w.inv_n == 0) { st.phase = 1; }
        else {
            if (w.apos == c) {
                if (w.inv_n < 4) { return 3; }
                st.phase = 1;
            } else { return x_step_to(w, c); }
        }
    }
    if (st.phase == 1) {
        // drop everything here, then eat motes nearby
        if (w.inv_n > 0) { return 4; }
        let i:i32 = 0;
        while (i < 6) {
            if (w.mem[w.base+O_MPOS+i] == w.apos) { return 2; }
            i = i+1;
        }
        let m:i32 = x_near_mote(w);
        if (m >= 0) { return x_step_to(w, m); }
        return 6;
    }
    return 6;
}

fn cf_act(w:*World, st:*AState)i32 {
    if (st.phase == 0) {
        if (w.apos != w.home) { return x_step_to(w, w.home); }
        st.phase = 1;
    }
    if (w.inv_n > 0) { return 4; }
    let i:i32 = 0;
    while (i < 6) {
        if (w.mem[w.base+O_MPOS+i] == w.apos) { return 2; }
        i = i+1;
    }
    let m:i32 = x_near_mote(w);
    if (m >= 0) {
        let d:i32 = w.apos - m;
        if (d < 0) { d = 0 - d; }
        if (d <= 3) { return x_step_to(w, m); }
    }
    return 6;
}

// ---- I arm: M1-M4 compositional choice (frozen section 6) ----
// 399 plans from 7^1+7^2+7^3, length-ascending lexicographic enumeration,
// B0(n) = B0/(1+n) integer division, only the three preemptions named in M4,
// K7 instrumentation. No RNG in I decision paths.
// Tables live in one []i64 arena (shared) to avoid the slice-aliasing bug.

const XI_NCAND:i32 = 399;
const XI_CAND:i32 = 0;
const XI_TRIED:i32 = 399;
const XI_CVAL:i32 = 798;
const XI_LOG:i32 = 1197;

struct XIState {
    mem:[]i64,
    base:i32,
    log:[]i64,
    lbase:i32,
    b0:i32,
    ncand:i32,
    nlog:i32,
    cur_code:i64,
    cur_len:i32,
    cur_pos:i32,
    cur_idx:i32,
    e_before:i32,
    ca:i32,
    cb:i32,
    sel_score:i64,
    sel_bonus:i32,
    enum_done:i32,
    enum_tick:i32,
    n_replans:i32,
    n_distinct:i32,
    post_total:i32,
    post_low:i32,
}

fn xi_new(mem:[]i64, base:i32, log:[]i64, lbase:i32, b0:i32)XIState {
    let st:XIState = XIState{
        .mem=mem, .base=base, .log=log, .lbase=lbase, .b0=b0,
        .ncand=0, .nlog=0,
        .cur_code=0, .cur_len=0, .cur_pos=0, .cur_idx=-1,
        .e_before=0, .ca=0, .cb=1,
        .sel_score=0, .sel_bonus=0,
        .enum_done=0, .enum_tick=-1,
        .n_replans=0, .n_distinct=0,
        .post_total=0, .post_low=0,
    };
    // M1: 399 plans, length-ascending lexicographic over 7 actions.
    let n:i32 = 0;
    let len:i32 = 1;
    while (len <= 3) {
        let code:i64 = 0;
        let total:i32 = 1;
        let k:i32 = 0;
        while (k < len) { total = total * 7; k = k + 1; }
        let c:i32 = 0;
        while (c < total) {
            code = (len as i64)*1000 + (c as i64);
            st.mem[st.base+XI_CAND+n] = code;
            st.mem[st.base+XI_TRIED+n] = 0;
            st.mem[st.base+XI_CVAL+n] = 0;
            n = n + 1;
            c = c + 1;
        }
        len = len + 1;
    }
    st.ncand = n;
    return st;
}

fn xi_len(code:i64)i32 {
    return (code / 1000) as i32;
}

fn xi_tok(code:i64, pos:i32)i32 {
    let c:i64 = code % 1000;
    let k:i32 = 0;
    while (k < pos) { c = c / 7; k = k + 1; }
    return (c % 7) as i32;
}

// M2/M3: evaluate one plan by mental simulation is replaced by the frozen
// rule: score = mean energy delta per try, with the low-bonus flag when the
// plan's mean tick energy stays under the B0(n) bound.
fn xi_eval(st:*XIState, idx:i32)i32 {
    let code:i64 = st.mem[st.base+XI_CAND+idx];
    let len:i32 = xi_len(code);
    let tried:i64 = st.mem[st.base+XI_TRIED+idx];
    let bonus:i32 = 0;
    if (tried == 0) { bonus = 1; }
    // B0(n) = B0/(1+n), integer division, frozen M3.
    let bound:i32 = st.b0 / (1 + (tried as i32));
    let score:i64 = st.mem[st.base+XI_CVAL+idx];
    if (score < (bound as i64)) { bonus = 1; }
    st.sel_score = score;
    st.sel_bonus = bonus;
    return 0;
}

// M4: pick the untried plan with the best (score, bonus); ties -> lower index.
// Only three preemptions: storm-within-2, mote-adjacent, energy-critical.
fn xi_pick(st:*XIState, w:*World)i32 {
    let best:i32 = -1;
    let bv:i64 = -999999999;
    let bb:i32 = 0;
    let k:i32 = 0;
    while (k < st.ncand) {
        let e:i32 = xi_eval(st, k);
        let s:i64 = st.sel_score;
        let bo:i32 = st.sel_bonus;
        let key:i64 = s*2 + (bo as i64);
        if (best < 0 || key > bv) {
            best = k;
            bv = key;
            bb = bo;
        }
        k = k+1;
    }
    return best;
}

fn xi_preempt(w:*World, st:*AState)i32 {
    // preemption 1: storm within 2 ticks and agent in zone unsheltered
    if (w_in_zone(w) == 1 && w_sheltered(w) == 0 && w_storm_within(w, 2) == 1) {
        return w_reflex_storm(w);
    }
    // preemption 2: mote adjacent -> step onto it
    let i:i32 = 0;
    while (i < 6) {
        let c:i32 = w.mem[w.base+O_MPOS+i];
        if (c == w.apos + 1 || c == w.apos - 1) { return x_step_to(w, c); }
        i = i+1;
    }
    // preemption 3: energy critical -> emergency forage
    if (w.energy < 25) { return w_reflex_emergency(w); }
    return -1;
}

fn xi_act(w:*World, st:*XIState)i32 {
    // finish a running plan
    if (st.cur_pos < st.cur_len) {
        let a:i32 = xi_tok(st.cur_code, st.cur_pos);
        st.cur_pos = st.cur_pos + 1;
        if (a == 5) { st.ca = 0; st.cb = 1; }
        if (st.cur_pos >= st.cur_len) {
            let idx:i32 = st.cur_idx;
            let de:i32 = w.energy - st.e_before;
            let tr:i64 = st.mem[st.base+XI_TRIED+idx];
            let cv:i64 = st.mem[st.base+XI_CVAL+idx];
            st.mem[st.base+XI_CVAL+idx] = (cv*tr + (de as i64)) / (tr + 1);
            st.mem[st.base+XI_TRIED+idx] = tr + 1;
            if (st.nlog < 400) {
                st.log[st.lbase+st.nlog*4] = st.cur_code;
                st.log[st.lbase+st.nlog*4+1] = de as i64;
                st.log[st.lbase+st.nlog*4+2] = w.tick as i64;
                st.log[st.lbase+st.nlog*4+3] = tr + 1;
                st.nlog = st.nlog + 1;
            }
        }
        return a;
    }
    // M4 preemptions (only these three)
    let tmp:AState = a_new();
    let pa:i32 = xi_preempt(w, &tmp);
    if (pa >= 0) { return pa; }
    // pick next plan
    let idx:i32 = xi_pick(st, w);
    if (idx < 0) { return 6; }
    let code:i64 = st.mem[st.base+XI_CAND+idx];
    // K7: post-enumeration choice reality
    if (st.enum_done == 1) {
        st.post_total = st.post_total + 1;
        let tried:i64 = st.mem[st.base+XI_TRIED+idx];
        let bound:i32 = st.b0 / (1 + (tried as i32));
        if (st.mem[st.base+XI_CVAL+idx] < (bound as i64)) {
            st.post_low = st.post_low + 1;
        }
    }
    st.cur_code = code;
    st.cur_len = xi_len(code);
    st.cur_pos = 0;
    st.cur_idx = idx;
    st.e_before = w.energy;
    st.n_replans = st.n_replans + 1;
    if (st.mem[st.base+XI_TRIED+idx] == 0) { st.n_distinct = st.n_distinct + 1; }
    // first action now
    let a:i32 = xi_tok(code, 0);
    st.cur_pos = 1;
    if (a == 5) { st.ca = 0; st.cb = 1; }
    if (st.cur_pos >= st.cur_len) {
        let de:i32 = w.energy - st.e_before;
        let tr:i64 = st.mem[st.base+XI_TRIED+idx];
        let cv:i64 = st.mem[st.base+XI_CVAL+idx];
        st.mem[st.base+XI_CVAL+idx] = (cv*tr + (de as i64)) / (tr + 1);
        st.mem[st.base+XI_TRIED+idx] = tr + 1;
        if (st.nlog < 400) {
            st.log[st.lbase+st.nlog*4] = code;
            st.log[st.lbase+st.nlog*4+1] = de as i64;
            st.log[st.lbase+st.nlog*4+2] = w.tick as i64;
            st.log[st.lbase+st.nlog*4+3] = tr + 1;
            st.nlog = st.nlog + 1;
        }
    }
    return a;
}

// section 7: called once per run end; marks enumeration completion.
fn xi_end(w:*World, st:*XIState)i32 {
    if (st.enum_done == 0 && st.n_distinct >= st.ncand) {
        st.enum_done = 1;
        st.enum_tick = w.tick;
    }
    // late check: if all 399 tried at any point, record first tick
    if (st.enum_done == 0) {
        let all:i32 = 1;
        let k:i32 = 0;
        while (k < st.ncand) {
            if (st.mem[st.base+XI_TRIED+k] == 0) { all = 0; }
            k = k+1;
        }
        if (all == 1) {
            st.enum_done = 1;
            st.enum_tick = w.tick;
        }
    }
    return 0;
}

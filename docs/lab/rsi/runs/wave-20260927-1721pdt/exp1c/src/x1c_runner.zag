// x1c_runner.zag -- EXP1c experiment runner, wave-20260927-1721pdt, from scratch.
// Modes (argv[1]):
//   check:     variant rule check over all 12 variants (CHECK_OK / CHECK_FAIL).
//   variants:  print the 12 variant parameter blocks, self-labeled by iteration.
//   calibrate: mode_check gates calibration in-code (CHECK_FAIL -> refuse);
//              5 scripted strategies x 12 variants x 1200 ticks; medians and
//              C1/C2/C3 computed in Zag by two independent methods.
//   run:       full experiment, 12 variants x 5 arms x 1200 ticks; TSV,
//              I-arm stats, medians x2, K1/K2/K3, K7, A2 ablation, top
//              sketches for the K4 novelty audit.
//   bound:     section 7 enumeration-bound reproduction (frozen arithmetic +
//              measured enum completion ticks).
// Pure Zag. Shell only invokes the compiler, redirects stdout, hashes output.
// Determinism: zero RNG in decision paths (Z's LCG is a seeded control);
// every binary is run twice and the SHA-256 of stdout must be byte-identical.

@import("x1c_params.zag")
@import("x1c_variants.zag")
@import("x1c_agents.zag")

const H_T:i32 = 1200;
const H_B0S:i32 = 40;
const H_B0I:i32 = 120;

// i32 arena layout (1024)
const Q_WBASE:i32 = 0;
const Q_PBASE:i32 = 200;
const Q_SCR:i32 = 300;
const Q_RES:i32 = 450;
const Q_ISTAT:i32 = 650;
// u8 arena layout (65536)
const Q_PBUF:i32 = 0;
const Q_PCAP:i32 = 8192;
const Q_TBASE:i32 = 8192;
// i64 arena layout (4096)
const Q_JBASE:i32 = 0;
const Q_JLOG:i32 = 1200;

struct Ctx {
    b8:[]u8,
    i32a:[]i32,
    i64a:[]i64,
    pdat:[]i32,
}

struct PBuf {
    arena:[]u8,
    base:i32,
    pos:i32,
    cap:i32,
}

fn pb_new(arena:[]u8, base:i32, cap:i32)PBuf {
    return PBuf{.arena=arena, .base=base, .pos=0, .cap=cap};
}

fn pb_ch(b:*PBuf, c:u8)i32 {
    if (b.pos < b.cap) { b.arena[b.base+b.pos] = c; b.pos = b.pos+1; }
    return 0;
}

fn pb_str(b:*PBuf, s:[]u8)i32 {
    let i:i32 = 0;
    while (i < s.len) { pb_ch(b, s[i]); i = i+1; }
    return 0;
}

fn pb_i32(b:*PBuf, v:i32)i32 {
    let x:i32 = v;
    if (x < 0) { pb_ch(b, 45); x = 0 - x; }
    if (x == 0) { pb_ch(b, 48); return 0; }
    let d:i32 = 1000000000;
    let started:i32 = 0;
    while (d > 0) {
        let q:i32 = x / d;
        if (q > 0 || started == 1) {
            pb_ch(b, (48 + q) as u8);
            started = 1;
        }
        x = x - q*d;
        d = d / 10;
    }
    return 0;
}

fn pb_i64(b:*PBuf, v:i64)i32 {
    let x:i64 = v;
    if (x < 0) { pb_ch(b, 45); x = 0 - x; }
    if (x == 0) { pb_ch(b, 48); return 0; }
    let d:i64 = 1000000000000000000;
    let started:i32 = 0;
    while (d > 0) {
        let q:i64 = x / d;
        if (q > 0 || started == 1) {
            pb_ch(b, (48 + (q as i32)) as u8);
            started = 1;
        }
        x = x - q*d;
        d = d / 10;
    }
    return 0;
}

fn pb_nl(b:*PBuf)i32 {
    // Slice the arena directly; do NOT _zag_malloc here. The toolchain's
    // _zag_malloc can return blocks overlapping earlier allocations, which
    // corrupts the variant parameter array. All heap is allocated once in
    // main; this function must not allocate.
    let ts:[]u8 = b.arena[b.base..b.base+b.pos];
    _zag_println(ts);
    b.pos = 0;
    return 0;
}

// Median method A: bubble-sorted copy of 12 values.
fn med_a(a:[]i32, base:i32)i32 {
    let x0:i32 = a[base+0]; let x1:i32 = a[base+1];
    let x2:i32 = a[base+2]; let x3:i32 = a[base+3];
    let x4:i32 = a[base+4]; let x5:i32 = a[base+5];
    let x6:i32 = a[base+6]; let x7:i32 = a[base+7];
    let x8:i32 = a[base+8]; let x9:i32 = a[base+9];
    let x10:i32 = a[base+10]; let x11:i32 = a[base+11];
    let t:i32 = 0;
    let pass:i32 = 0;
    while (pass < 12) {
        if (x0 > x1) { t=x0; x0=x1; x1=t; }
        if (x1 > x2) { t=x1; x1=x2; x2=t; }
        if (x2 > x3) { t=x2; x2=x3; x3=t; }
        if (x3 > x4) { t=x3; x3=x4; x4=t; }
        if (x4 > x5) { t=x4; x4=x5; x5=t; }
        if (x5 > x6) { t=x5; x5=x6; x6=t; }
        if (x6 > x7) { t=x6; x6=x7; x7=t; }
        if (x7 > x8) { t=x7; x7=x8; x8=t; }
        if (x8 > x9) { t=x8; x8=x9; x9=t; }
        if (x9 > x10) { t=x9; x9=x10; x10=t; }
        if (x10 > x11) { t=x10; x10=x11; x11=t; }
        pass = pass + 1;
    }
    return (x5 + x6) / 2;
}

// Median method B: independent min-extraction sort.
fn med_b(a:[]i32, base:i32, scr:i32)i32 {
    let i:i32 = 0;
    while (i < 12) {
        a[scr+i] = a[base+i];
        a[scr+12+i] = 0;
        i = i+1;
    }
    let o:i32 = 0;
    while (o < 12) {
        let bi:i32 = -1;
        let bv:i32 = 0;
        i = 0;
        while (i < 12) {
            if (a[scr+12+i] == 0) {
                if (bi < 0 || a[scr+i] < bv) { bi = i; bv = a[scr+i]; }
            }
            i = i+1;
        }
        a[scr+12+bi] = 1;
        a[scr+24+o] = bv;
        o = o + 1;
    }
    return (a[scr+24+5] + a[scr+24+6]) / 2;
}

fn act_char(a:i32)u8 {
    if (a == 0) { return 76; }
    if (a == 1) { return 82; }
    if (a == 2) { return 69; }
    if (a == 3) { return 84; }
    if (a == 4) { return 68; }
    if (a == 5) { return 67; }
    return 87;
}

fn ch2act(c:u8)i32 {
    if (c == 76) { return 0; }
    if (c == 82) { return 1; }
    if (c == 69) { return 2; }
    if (c == 84) { return 3; }
    if (c == 68) { return 4; }
    if (c == 67) { return 5; }
    return 6;
}

struct RunRes {
    ticks:i32,
    cause:i32,
    e_end:i32,
}

// I-arm stat block offsets (10 i32 per slot at Q_ISTAT).
const IS_TICKS:i32 = 0;
const IS_CAUSE:i32 = 1;
const IS_EEND:i32 = 2;
const IS_EDONE:i32 = 3;
const IS_ETICK:i32 = 4;
const IS_NREPL:i32 = 5;
const IS_NDIST:i32 = 6;
const IS_POST:i32 = 7;
const IS_PLOW:i32 = 8;
const IS_NLOG:i32 = 9;

fn cal_run(ctx:*Ctx, v:i32, s:i32)RunRes {
    let w:World = w_new(ctx.i32a, Q_WBASE);
    let xp:XParams = xp_new(ctx.pdat);
    let f:i32 = x1c_fill(v, &xp);
    let ap:i32 = xp_apply(&w, &xp);
    if (s == 0) {
        let st:AState = a_new();
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = p_act(&w, &st);
            w_step(&w, a, st.ca, st.cb);
        }
    }
    if (s == 1) {
        let st:AState = a_new();
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = f_act(&w, &st);
            w_step(&w, a, st.ca, st.cb);
        }
    }
    if (s == 2) {
        let st:AState = a_new();
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = lf_act(&w, &st);
            w_step(&w, a, st.ca, st.cb);
        }
    }
    if (s == 3) {
        let st:AState = a_new();
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = cf_act(&w, &st);
            w_step(&w, a, st.ca, st.cb);
        }
    }
    if (s == 4) {
        let st:AState = z_new(v);
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = z_act(&w, &st);
            w_step(&w, a, 0, 1);
        }
    }
    return RunRes{.ticks=w.tick, .cause=w.cause, .e_end=w.energy};
}

fn exp_run(ctx:*Ctx, v:i32, arm:i32, slot:i32)RunRes {
    let w:World = w_new(ctx.i32a, Q_WBASE);
    let xp:XParams = xp_new(ctx.pdat);
    let f:i32 = x1c_fill(v, &xp);
    let ap:i32 = xp_apply(&w, &xp);
    // arm: 0=P, 1=Z, 2=R, 3=I-survive, 4=I-invent
    if (arm == 0) {
        let st:AState = a_new();
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = p_act(&w, &st);
            w_step(&w, a, st.ca, st.cb);
        }
    }
    if (arm == 1) {
        let st:AState = z_new(v);
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = z_act(&w, &st);
            w_step(&w, a, 0, 1);
        }
    }
    if (arm == 2) {
        let st:AState = a_new();
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = r_act(&w, &st);
            w_step(&w, a, st.ca, st.cb);
        }
    }
    if (arm == 3 || arm == 4) {
        let b0:i32 = H_B0S;
        if (arm == 4) { b0 = H_B0I; }
        let xi:XIState = xi_new(ctx.i64a, Q_JBASE, ctx.i64a, Q_JLOG, b0);
        let tbase:i32 = Q_TBASE + slot*H_T;
        let t:i32 = 0;
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = xi_act(&w, &xi);
            ctx.b8[tbase+t] = act_char(a);
            t = t+1;
            w_step(&w, a, xi.ca, xi.cb);
        }
        let e:i32 = xi_end(&w, &xi);
        while (t < H_T) { ctx.b8[tbase+t] = 46; t = t+1; }
        let sb:i32 = Q_ISTAT + slot*10;
        ctx.i32a[sb+IS_TICKS] = w.tick;
        ctx.i32a[sb+IS_CAUSE] = w.cause;
        ctx.i32a[sb+IS_EEND] = w.energy;
        ctx.i32a[sb+IS_EDONE] = xi.enum_done;
        ctx.i32a[sb+IS_ETICK] = xi.enum_tick;
        ctx.i32a[sb+IS_NREPL] = xi.n_replans;
        ctx.i32a[sb+IS_NDIST] = xi.n_distinct;
        ctx.i32a[sb+IS_POST] = xi.post_total;
        ctx.i32a[sb+IS_PLOW] = xi.post_low;
        ctx.i32a[sb+IS_NLOG] = xi.nlog;
    }
    return RunRes{.ticks=w.tick, .cause=w.cause, .e_end=w.energy};
}

// A2 ablation: replay an I trace with TAKE/DROP/COMBINE replaced by r_act.
fn ablate(ctx:*Ctx, v:i32, slot:i32)RunRes {
    let w:World = w_new(ctx.i32a, Q_WBASE);
    let xp:XParams = xp_new(ctx.pdat);
    let f:i32 = x1c_fill(v, &xp);
    let ap:i32 = xp_apply(&w, &xp);
    let tbase:i32 = Q_TBASE + slot*H_T;
    let replaced:i32 = 0;
    let t:i32 = 0;
    while (w.alive == 1 && w.tick < H_T && t < H_T) {
        let c:u8 = ctx.b8[tbase+t];
        if (c == 46) { break; }
        let a:i32 = ch2act(c);
        if (a == 3 || a == 4 || a == 5) {
            replaced = replaced + 1;
            let st:AState = a_new();
            let ra:i32 = r_act(&w, &st);
            w_step(&w, ra, st.ca, st.cb);
        } else {
            w_step(&w, a, 0, 1);
        }
        t = t+1;
    }
    return RunRes{.ticks=w.tick, .cause=replaced, .e_end=w.energy};
}

fn pb_arm(b:*PBuf, arm:i32)i32 {
    if (arm == 0) { pb_str(b, "P"); }
    if (arm == 1) { pb_str(b, "Z"); }
    if (arm == 2) { pb_str(b, "R"); }
    if (arm == 3) { pb_str(b, "Is"); }
    if (arm == 4) { pb_str(b, "Ii"); }
    return 0;
}

fn pb_strat(b:*PBuf, s:i32)i32 {
    if (s == 0) { pb_str(b, "p_ward"); }
    if (s == 1) { pb_str(b, "forage"); }
    if (s == 2) { pb_str(b, "lampfarm"); }
    if (s == 3) { pb_str(b, "cachefarm"); }
    if (s == 4) { pb_str(b, "z"); }
    return 0;
}

fn pb_plan(b:*PBuf, code:i64)i32 {
    let len:i32 = xi_len(code);
    let k:i32 = 0;
    while (k < len) {
        if (k > 0) { pb_ch(b, 44); }
        pb_ch(b, act_char(xi_tok(code, k)));
        k = k+1;
    }
    return 0;
}

fn mode_check(ctx:*Ctx)i32 {
    let b:PBuf = pb_new(ctx.b8, Q_PBUF, Q_PCAP);
    let xp:XParams = xp_new(ctx.pdat);
    let bad:i32 = 0;
    let v:i32 = 0;
    while (v < 12) {
        let f:i32 = x1c_fill(v, &xp);
        let mr:i32 = 0;
        let i:i32 = 0;
        while (i < 6) {
            let r:i32 = xp_checkmot(&xp, i);
            if (r != 0 && mr == 0) { mr = r*10 + i; }
            i = i+1;
        }
        let wr:i32 = xp_checkworld(&xp);
        if (mr != 0 || wr != 0) {
            bad = bad + 1;
            pb_str(&b, "VIOLATION variant ");
            pb_i32(&b, v);
            pb_str(&b, " motrule ");
            pb_i32(&b, mr);
            pb_str(&b, " worldrule ");
            pb_i32(&b, wr);
            pb_nl(&b);
        }
        v = v+1;
    }
    if (bad == 0) { pb_str(&b, "CHECK_OK"); pb_nl(&b); }
    else {
        pb_str(&b, "CHECK_FAIL ");
        pb_i32(&b, bad);
        pb_nl(&b);
    }
    return 0;
}

fn mode_variants(ctx:*Ctx)i32 {
    let b:PBuf = pb_new(ctx.b8, Q_PBUF, Q_PCAP);
    let xp:XParams = xp_new(ctx.pdat);
    pb_str(&b, "EXP1C VARIANTS retune iteration ");
    pb_i32(&b, X1C_ITER);
    pb_str(&b, " (frozen 2026-09-27)");
    pb_nl(&b);
    let v:i32 = 0;
    while (v < 12) {
        let f:i32 = x1c_fill(v, &xp);
        let d:[]i32 = xp.dat;
        pb_str(&b, "=== VARIANT ");
        pb_i32(&b, v);
        pb_str(&b, " ===");
        pb_nl(&b);
        pb_str(&b, "void ");
        pb_i32(&b, xp.void0);
        pb_ch(&b, 32);
        pb_i32(&b, xp.void1);
        pb_nl(&b);
        pb_str(&b, "start ");
        pb_i32(&b, xp.start);
        pb_nl(&b);
        pb_str(&b, "home ");
        pb_i32(&b, xp.home);
        pb_nl(&b);
        pb_str(&b, "crystals");
        let i:i32 = 0;
        while (i < 4) { pb_ch(&b, 32); pb_i32(&b, d[XP_CRYS+i]); i = i+1; }
        pb_nl(&b);
        pb_str(&b, "storms");
        i = 0;
        while (i < 3) {
            pb_ch(&b, 32); pb_i32(&b, d[XP_SS+i]);
            pb_ch(&b, 32); pb_i32(&b, d[XP_SE+i]);
            i = i+1;
        }
        pb_nl(&b);
        pb_str(&b, "motes 6");
        pb_nl(&b);
        i = 0;
        while (i < 6) {
            pb_str(&b, "mote ");
            pb_i32(&b, d[XP_MPOS+i]); pb_ch(&b, 32);
            pb_i32(&b, d[XP_MVEL+i]); pb_ch(&b, 32);
            pb_i32(&b, d[XP_MLO+i]); pb_ch(&b, 32);
            pb_i32(&b, d[XP_MHI+i]); pb_ch(&b, 32);
            pb_i32(&b, d[XP_MRESP+i]); pb_ch(&b, 32);
            pb_i32(&b, d[XP_MDEEP+i]);
            pb_nl(&b);
            i = i+1;
        }
        v = v+1;
    }
    return 0;
}

fn mode_calibrate(ctx:*Ctx)i32 {
    let b:PBuf = pb_new(ctx.b8, Q_PBUF, Q_PCAP);
    // Binding requirement (d): mode_check gates calibration in-code.
    let xp:XParams = xp_new(ctx.pdat);
    let bad:i32 = 0;
    let v:i32 = 0;
    while (v < 12) {
        let f:i32 = x1c_fill(v, &xp);
        bad = bad + xp_check_all(&xp);
        v = v+1;
    }
    if (bad > 0) {
        pb_str(&b, "CHECK_FAIL ");
        pb_i32(&b, bad);
        pb_nl(&b);
        pb_str(&b, "CALIBRATE_REFUSED");
        pb_nl(&b);
        return 0;
    }
    pb_str(&b, "CALIBRATE_BEGIN iter=");
    pb_i32(&b, X1C_ITER);
    pb_nl(&b);
    pb_str(&b, "strategy\tvariant\tticks\tcause\te_end");
    pb_nl(&b);
    let m0:i32 = 0; let m1:i32 = 0; let m2:i32 = 0; let m3:i32 = 0; let m4:i32 = 0;
    let n0:i32 = 0; let n1:i32 = 0; let n2:i32 = 0; let n3:i32 = 0; let n4:i32 = 0;
    let s:i32 = 0;
    while (s < 5) {
        let vb:i32 = Q_SCR + s*12;
        v = 0;
        while (v < 12) {
            let r:RunRes = cal_run(ctx, v, s);
            ctx.i32a[vb+v] = r.ticks;
            pb_strat(&b, s);
            pb_ch(&b, 9);
            pb_i32(&b, v);
            pb_ch(&b, 9);
            pb_i32(&b, r.ticks);
            pb_ch(&b, 9);
            pb_i32(&b, r.cause);
            pb_ch(&b, 9);
            pb_i32(&b, r.e_end);
            pb_nl(&b);
            v = v+1;
        }
        let ma:i32 = med_a(ctx.i32a, vb);
        let mb:i32 = med_b(ctx.i32a, vb, 380);
        if (s == 0) { m0 = ma; n0 = mb; }
        if (s == 1) { m1 = ma; n1 = mb; }
        if (s == 2) { m2 = ma; n2 = mb; }
        if (s == 3) { m3 = ma; n3 = mb; }
        if (s == 4) { m4 = ma; n4 = mb; }
        pb_str(&b, "MEDIAN_");
        pb_strat(&b, s);
        pb_ch(&b, 61);
        pb_i32(&b, ma);
        pb_nl(&b);
        s = s+1;
    }
    pb_str(&b, "MEDIAN_AGREE_BEGIN");
    pb_nl(&b);
    s = 0;
    while (s < 5) {
        let ma:i32 = m0; let mb:i32 = n0;
        if (s == 1) { ma = m1; mb = n1; }
        if (s == 2) { ma = m2; mb = n2; }
        if (s == 3) { ma = m3; mb = n3; }
        if (s == 4) { ma = m4; mb = n4; }
        pb_strat(&b, s);
        pb_ch(&b, 9);
        pb_i32(&b, ma);
        pb_ch(&b, 9);
        pb_i32(&b, mb);
        pb_ch(&b, 9);
        if (ma == mb) { pb_str(&b, "AGREE"); } else { pb_str(&b, "DISAGREE"); }
        pb_nl(&b);
        s = s+1;
    }
    pb_str(&b, "MEDIAN_AGREE_END");
    pb_nl(&b);
    pb_str(&b, "GATES_BEGIN");
    pb_nl(&b);
    pb_str(&b, "C1 median_p_ward=");
    pb_i32(&b, m0);
    if (m0 >= 960) { pb_str(&b, " PASS"); } else { pb_str(&b, " FAIL(VOID)"); }
    pb_nl(&b);
    pb_str(&b, "C2 median_z=");
    pb_i32(&b, m4);
    if (m4 < 300) { pb_str(&b, " PASS"); } else { pb_str(&b, " FAIL"); }
    pb_nl(&b);
    let c3n:i32 = 0;
    if (m0 >= 720) { c3n = c3n + 1; }
    if (m1 >= 720) { c3n = c3n + 1; }
    if (m2 >= 720) { c3n = c3n + 1; }
    if (m3 >= 720) { c3n = c3n + 1; }
    pb_str(&b, "C3 p_ward=");
    pb_i32(&b, m0);
    pb_str(&b, " forage=");
    pb_i32(&b, m1);
    pb_str(&b, " lampfarm=");
    pb_i32(&b, m2);
    pb_str(&b, " cachefarm=");
    pb_i32(&b, m3);
    pb_str(&b, " count=");
    pb_i32(&b, c3n);
    if (c3n >= 3) { pb_str(&b, " PASS"); } else { pb_str(&b, " FAIL"); }
    pb_nl(&b);
    pb_str(&b, "GATES_END");
    pb_nl(&b);
    pb_str(&b, "CALIBRATE_END");
    pb_nl(&b);
    return 0;
}

fn mode_run(ctx:*Ctx)i32 {
    let b:PBuf = pb_new(ctx.b8, Q_PBUF, Q_PCAP);
    pb_str(&b, "RUN_BEGIN iter=");
    pb_i32(&b, X1C_ITER);
    pb_str(&b, " horizon=1200");
    pb_nl(&b);
    pb_str(&b, "TSV_BEGIN");
    pb_nl(&b);
    pb_str(&b, "variant\tarm\tticks\tcause\te_end");
    pb_nl(&b);
    let v:i32 = 0;
    while (v < 12) {
        let arm:i32 = 0;
        while (arm < 5) {
            let idx:i32 = v*5 + arm;
            let slot:i32 = v*2 + (arm - 3);
            let r:RunRes = exp_run(ctx, v, arm, slot);
            ctx.i32a[Q_RES+idx*3] = r.ticks;
            ctx.i32a[Q_RES+idx*3+1] = r.cause;
            ctx.i32a[Q_RES+idx*3+2] = r.e_end;
            pb_i32(&b, v);
            pb_ch(&b, 9);
            pb_arm(&b, arm);
            pb_ch(&b, 9);
            pb_i32(&b, r.ticks);
            pb_ch(&b, 9);
            pb_i32(&b, r.cause);
            pb_ch(&b, 9);
            pb_i32(&b, r.e_end);
            pb_nl(&b);
            arm = arm+1;
        }
        v = v+1;
    }
    pb_str(&b, "TSV_END");
    pb_nl(&b);
    pb_str(&b, "ISTAT_BEGIN");
    pb_nl(&b);
    pb_str(&b, "variant\tarm\tenum_done\tenum_tick\tn_replans\tn_distinct\tpost_total\tpost_low\tnlog");
    pb_nl(&b);
    v = 0;
    while (v < 12) {
        let k:i32 = 0;
        while (k < 2) {
            let slot:i32 = v*2 + k;
            let sb:i32 = Q_ISTAT + slot*10;
            pb_i32(&b, v);
            pb_ch(&b, 9);
            pb_arm(&b, 3+k);
            pb_ch(&b, 9);
            pb_i32(&b, ctx.i32a[sb+IS_EDONE]);
            pb_ch(&b, 9);
            pb_i32(&b, ctx.i32a[sb+IS_ETICK]);
            pb_ch(&b, 9);
            pb_i32(&b, ctx.i32a[sb+IS_NREPL]);
            pb_ch(&b, 9);
            pb_i32(&b, ctx.i32a[sb+IS_NDIST]);
            pb_ch(&b, 9);
            pb_i32(&b, ctx.i32a[sb+IS_POST]);
            pb_ch(&b, 9);
            pb_i32(&b, ctx.i32a[sb+IS_PLOW]);
            pb_ch(&b, 9);
            pb_i32(&b, ctx.i32a[sb+IS_NLOG]);
            pb_nl(&b);
            k = k+1;
        }
        v = v+1;
    }
    pb_str(&b, "ISTAT_END");
    pb_nl(&b);
    let m0:i32 = 0; let m1:i32 = 0; let m2:i32 = 0; let m3:i32 = 0; let m4:i32 = 0;
    let n0:i32 = 0; let n1:i32 = 0; let n2:i32 = 0; let n3:i32 = 0; let n4:i32 = 0;
    let arm:i32 = 0;
    while (arm < 5) {
        let vb:i32 = Q_SCR + arm*12;
        let i:i32 = 0;
        while (i < 12) {
            ctx.i32a[vb+i] = ctx.i32a[Q_RES+(i*5+arm)*3];
            i = i+1;
        }
        let ma:i32 = med_a(ctx.i32a, vb);
        let mb:i32 = med_b(ctx.i32a, vb, 380);
        if (arm == 0) { m0 = ma; n0 = mb; }
        if (arm == 1) { m1 = ma; n1 = mb; }
        if (arm == 2) { m2 = ma; n2 = mb; }
        if (arm == 3) { m3 = ma; n3 = mb; }
        if (arm == 4) { m4 = ma; n4 = mb; }
        arm = arm+1;
    }
    pb_str(&b, "MEDIANS_BEGIN");
    pb_nl(&b);
    arm = 0;
    while (arm < 5) {
        let ma:i32 = m0; let mb:i32 = n0;
        if (arm == 1) { ma = m1; mb = n1; }
        if (arm == 2) { ma = m2; mb = n2; }
        if (arm == 3) { ma = m3; mb = n3; }
        if (arm == 4) { ma = m4; mb = n4; }
        pb_arm(&b, arm);
        pb_ch(&b, 9);
        pb_i32(&b, ma);
        pb_ch(&b, 9);
        pb_i32(&b, mb);
        pb_ch(&b, 9);
        if (ma == mb) { pb_str(&b, "AGREE"); } else { pb_str(&b, "DISAGREE"); }
        pb_nl(&b);
        arm = arm+1;
    }
    pb_str(&b, "MEDIANS_END");
    pb_nl(&b);
    pb_str(&b, "BARS_BEGIN");
    pb_nl(&b);
    pb_str(&b, "C1 median_P=");
    pb_i32(&b, m0);
    if (m0 >= 960) { pb_str(&b, " PASS"); } else { pb_str(&b, " FAIL(VOID)"); }
    pb_nl(&b);
    pb_str(&b, "C2 median_Z=");
    pb_i32(&b, m1);
    if (m1 < 300) { pb_str(&b, " PASS"); } else { pb_str(&b, " FAIL"); }
    pb_nl(&b);
    pb_str(&b, "K1 median_Is=");
    pb_i32(&b, m3);
    pb_str(&b, " median_R=");
    pb_i32(&b, m2);
    if (m3 <= m2) { pb_str(&b, " verdict=KILL"); } else { pb_str(&b, " verdict=PASS"); }
    pb_nl(&b);
    pb_str(&b, "K2 median_Is=");
    pb_i32(&b, m3);
    pb_str(&b, " median_Z=");
    pb_i32(&b, m1);
    if (m3 <= m1) { pb_str(&b, " verdict=KILL"); } else { pb_str(&b, " verdict=PASS"); }
    pb_nl(&b);
    pb_str(&b, "K3 median_P=");
    pb_i32(&b, m0);
    if (m0 < 960) { pb_str(&b, " verdict=VOID"); } else { pb_str(&b, " verdict=PASS"); }
    pb_nl(&b);
    pb_str(&b, "BARS_END");
    pb_nl(&b);
    // K7 choice-reality (frozen bar).
    let k7num:i32 = 0;
    let k7den:i32 = 0;
    v = 0;
    while (v < 12) {
        let k:i32 = 0;
        while (k < 2) {
            let sb:i32 = Q_ISTAT + (v*2+k)*10;
            k7den = k7den + ctx.i32a[sb+IS_POST];
            k7num = k7num + ctx.i32a[sb+IS_PLOW];
            k = k+1;
        }
        v = v+1;
    }
    pb_str(&b, "K7_BEGIN");
    pb_nl(&b);
    pb_str(&b, "post_enum_plans=");
    pb_i32(&b, k7den);
    pb_str(&b, " low_bonus_plans=");
    pb_i32(&b, k7num);
    pb_nl(&b);
    if (k7den > 0) {
        let pm:i32 = (1000*k7num) / k7den;
        pb_str(&b, "K7 fraction_per_mille=");
        pb_i32(&b, pm);
        if (pm >= 500) { pb_str(&b, " verdict=PASS"); } else { pb_str(&b, " verdict=VOID"); }
        pb_nl(&b);
    } else {
        pb_str(&b, "K7 verdict=VOID (no post-enumeration plans observed)");
        pb_nl(&b);
    }
    pb_str(&b, "K7_END");
    pb_nl(&b);
    // A2 ablation for K6.
    pb_str(&b, "ABLATION_BEGIN");
    pb_nl(&b);
    pb_str(&b, "K6_RULE: fires iff median(ablated I-survive) >= median(original I-survive)");
    pb_nl(&b);
    pb_str(&b, "variant\tarm\torig_ticks\tablated_ticks\treplaced\tdrop");
    pb_nl(&b);
    v = 0;
    while (v < 12) {
        let k:i32 = 0;
        while (k < 2) {
            let slot:i32 = v*2 + k;
            let idx:i32 = v*5 + 3 + k;
            let iticks:i32 = ctx.i32a[Q_RES+idx*3];
            let ab:RunRes = ablate(ctx, v, slot);
            pb_i32(&b, v);
            pb_ch(&b, 9);
            pb_arm(&b, 3+k);
            pb_ch(&b, 9);
            pb_i32(&b, iticks);
            pb_ch(&b, 9);
            pb_i32(&b, ab.ticks);
            pb_ch(&b, 9);
            pb_i32(&b, ab.cause);
            pb_ch(&b, 9);
            pb_i32(&b, iticks - ab.ticks);
            pb_nl(&b);
            ctx.i32a[Q_SCR+100+k*12+v] = ab.ticks;
            k = k+1;
        }
        v = v+1;
    }
    let m_abl3:i32 = med_a(ctx.i32a, Q_SCR+100);
    let m_abl3b:i32 = med_b(ctx.i32a, Q_SCR+100, 380);
    let m_abl4:i32 = med_a(ctx.i32a, Q_SCR+112);
    pb_str(&b, "K6 median_orig_Is=");
    pb_i32(&b, m3);
    pb_str(&b, " median_abl_Is=");
    pb_i32(&b, m_abl3);
    if (m_abl3 >= m3) { pb_str(&b, " verdict=FIRES"); } else { pb_str(&b, " verdict=PASS"); }
    pb_nl(&b);
    pb_str(&b, "K6 median_abl_Is_check2=");
    pb_i32(&b, m_abl3b);
    pb_nl(&b);
    pb_str(&b, "ABL_Ii median_abl=");
    pb_i32(&b, m_abl4);
    pb_nl(&b);
    pb_str(&b, "ABLATION_END");
    pb_nl(&b);
    // TOPSKETCH dedicated pass (deterministic re-run) for the K4 audit.
    pb_str(&b, "TOPSKETCH_BEGIN");
    pb_nl(&b);
    pb_str(&b, "variant\tarm\trank\tplan\ttried\tmean");
    pb_nl(&b);
    v = 0;
    while (v < 12) {
        let k:i32 = 0;
        while (k < 2) {
            let slot:i32 = v*2 + k;
            let r:RunRes = exp_run(ctx, v, 3+k, slot);
            let lastv:i64 = 999999999;
            let lasti:i32 = -1;
            let p:i32 = 0;
            while (p < 8) {
                let bv:i64 = -999999999;
                let bi:i32 = -1;
                let kk:i32 = 0;
                while (kk < XI_NCAND) {
                    let vv:i64 = ctx.i64a[Q_JBASE+XI_CVAL+kk];
                    if (vv < lastv || (vv == lastv && kk > lasti)) {
                        if (bi < 0 || vv > bv) { bv = vv; bi = kk; }
                    }
                    kk = kk+1;
                }
                if (bi < 0) { break; }
                pb_i32(&b, v);
                pb_ch(&b, 9);
                pb_arm(&b, 3+k);
                pb_ch(&b, 9);
                pb_i32(&b, p);
                pb_ch(&b, 9);
                pb_plan(&b, ctx.i64a[Q_JBASE+XI_CAND+bi]);
                pb_ch(&b, 9);
                pb_i64(&b, ctx.i64a[Q_JBASE+XI_TRIED+bi]);
                pb_ch(&b, 9);
                pb_i64(&b, bv);
                pb_nl(&b);
                lastv = bv;
                lasti = bi;
                p = p+1;
            }
            k = k+1;
        }
        v = v+1;
    }
    pb_str(&b, "TOPSKETCH_END");
    pb_nl(&b);
    pb_str(&b, "META_BEGIN");
    pb_nl(&b);
    pb_str(&b, "ncand=399 B0_survive=40 B0_invent=120 decay=B0(n)=B0/(1+n)-intdiv horizon=1200");
    pb_nl(&b);
    pb_str(&b, "META_END");
    pb_nl(&b);
    pb_str(&b, "RUN_END");
    pb_nl(&b);
    return 0;
}

fn mode_bound(ctx:*Ctx)i32 {
    let b:PBuf = pb_new(ctx.b8, Q_PBUF, Q_PCAP);
    pb_str(&b, "BOUND_BEGIN");
    pb_nl(&b);
    pb_str(&b, "BOUND_FROZEN_ARITHMETIC: sketches=399; at most one plan try per replan;");
    pb_nl(&b);
    pb_str(&b, "mean plan length <= 3 ticks plus replan overhead;");
    pb_nl(&b);
    pb_str(&b, "claim: enumeration completes before tick 600 of the 1200-tick horizon.");
    pb_nl(&b);
    pb_str(&b, "variant\tarm\tticks\tenum_done\tenum_tick\tn_distinct");
    pb_nl(&b);
    let vmax:i32 = -1;
    let vdone:i32 = 0;
    let v:i32 = 0;
    while (v < 12) {
        let k:i32 = 0;
        while (k < 2) {
            let slot:i32 = v*2 + k;
            let r:RunRes = exp_run(ctx, v, 3+k, slot);
            let sb:i32 = Q_ISTAT + slot*10;
            let ed:i32 = ctx.i32a[sb+IS_EDONE];
            let et:i32 = ctx.i32a[sb+IS_ETICK];
            pb_i32(&b, v);
            pb_ch(&b, 9);
            pb_arm(&b, 3+k);
            pb_ch(&b, 9);
            pb_i32(&b, r.ticks);
            pb_ch(&b, 9);
            pb_i32(&b, ed);
            pb_ch(&b, 9);
            pb_i32(&b, et);
            pb_ch(&b, 9);
            pb_i32(&b, ctx.i32a[sb+IS_NDIST]);
            pb_nl(&b);
            if (ed == 1) {
                vdone = vdone + 1;
                if (et > vmax) { vmax = et; }
            }
            k = k+1;
        }
        v = v+1;
    }
    pb_str(&b, "BOUND measured_max_enum_tick=");
    pb_i32(&b, vmax);
    pb_str(&b, " over ");
    pb_i32(&b, vdone);
    pb_str(&b, " completed runs of 24");
    pb_nl(&b);
    if (vdone == 24 && vmax >= 0 && vmax < 600) {
        pb_str(&b, "BOUND_RESULT: PASS (all runs completed enumeration before tick 600)");
        pb_nl(&b);
    } else {
        pb_str(&b, "BOUND_RESULT: NOT-MET (measured max ");
        pb_i32(&b, vmax);
        pb_str(&b, ", completed ");
        pb_i32(&b, vdone);
        pb_str(&b, "/24)");
        pb_nl(&b);
    }
    pb_str(&b, "BOUND_END");
    pb_nl(&b);
    return 0;
}

fn arg_is(s:[]u8, t:[]u8)i32 {
    if (s.len != t.len) { return 0; }
    let i:i32 = 0;
    while (i < s.len) {
        if (s[i] != t[i]) { return 0; }
        i = i+1;
    }
    return 1;
}

fn main()i32 {
    // Single _zag_malloc for all arenas. The toolchain's allocator can return
    // overlapping blocks on successive calls (verified 2026-09-28); carving
    // fixed regions out of one block avoids cross-arena corruption.
    let big:*u8 = _zag_malloc(65536 + 4096 + 32768 + 184);
    let au:[]u8 = big[0..65536];
    let mi:*i32 = (big + 65536) as *i32;
    let ai:[]i32 = mi[0..1024];
    let mg:*i64 = (big + 65536 + 4096) as *i64;
    let ag:[]i64 = mg[0..4096];
    let mp:*i32 = (big + 65536 + 4096 + 32768) as *i32;
    let pdat:[]i32 = mp[0..46];
    let ctx:Ctx = Ctx{.b8=au, .i32a=ai, .i64a=ag, .pdat=pdat};
    if (_zag_argc() >= 2) {
        let m:[]u8 = _zag_arg(1);
        if (arg_is(m, "check") == 1) { return mode_check(&ctx); }
        if (arg_is(m, "variants") == 1) { return mode_variants(&ctx); }
        if (arg_is(m, "calibrate") == 1) { return mode_calibrate(&ctx); }
        if (arg_is(m, "run") == 1) { return mode_run(&ctx); }
        if (arg_is(m, "bound") == 1) { return mode_bound(&ctx); }
    }
    let b:PBuf = pb_new(au, Q_PBUF, Q_PCAP);
    pb_str(&b, "USAGE: check|variants|calibrate|run|bound");
    pb_nl(&b);
    return 0;
}

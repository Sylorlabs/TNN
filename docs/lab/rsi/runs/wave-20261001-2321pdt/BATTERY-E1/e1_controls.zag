// e1_controls.zag -- E1 calibration controls (PREREG_E1 section 6).
// Writes synthetic inspector reports and transcripts:
//   competent: a W1-conformant LICENSED DERIVED structure plus a
//              transcript with derived answers. The checker must print
//              DERIVED=1 FIRSTCLASS=1 for check E1W1.
//   degenerate: only flat and per-instance structures. The checker must
//              print DERIVED=0 for all four checks.
// Usage: e1_controls_bin <outdir>. Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn app_str(buf:[]u8,pos:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
  return pos+s.len;
}
fn join_path(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+name.len+2);
  let p:i32=app_str(b,0,dir);
  if(dir.len>0 && dir[dir.len-1]!=47){ b[p]=47; p=p+1; }
  p=app_str(b,p,name);
  return b[0..p];
}
fn wfile(dir:[]u8,name:[]u8,body:[]u8)void {
  let p:[]u8=join_path(dir,name);
  if(_zag_write_file(p,body)!=0){ errln("write failed"); return; }
  emit("WROTE "); _zag_print(p); emit("\n");
  return;
}

fn main()i32 {
  if(_zag_argc()!=2){
    errln("usage: e1_controls_bin <outdir>");
    return 2;
  }
  let dir:[]u8=_zag_arg(1);
  if(dir.len>0 && dir[dir.len-1]==10){ dir=dir[0..dir.len-1]; }
  // competent: W1-shaped licensed derived structure, derived answers
  wfile(dir,"competent_report.txt",
    "OBSERVES 5\nSTRUCTURE id=42 subj=71101 rel=71609 answer=71902\nEVIDENCE (71101,71601,71901) (71901,71602,71902) count=2\nSTRUCTURES 1\n");
  wfile(dir,"competent_trans.txt",
    "WORLD_BEGIN\nANSWER 71101 71609 71902\nANSWER 71102 71609 71902\nANSWER 71101 71601 71901\nANSWER 71901 71602 71902\nWORLD_END events=9 answers=4\n");
  // degenerate: flat promoted fact + per-instance structure only
  wfile(dir,"degenerate_report.txt",
    "OBSERVES 5\nSTRUCTURE id=7 subj=71101 rel=71609 answer=71999\nEVIDENCE (71101,71609,71999) count=1\nSTRUCTURE id=9 subj=71102 rel=71601 answer=71901\nEVIDENCE (71102,71601,71901) count=1\nSTRUCTURES 2\n");
  wfile(dir,"degenerate_trans.txt",
    "WORLD_BEGIN\nANSWER 71101 71609 71999\nANSWER 71102 71609 71999\nANSWER 71101 71601 71901\nANSWER 71901 71602 71902\nWORLD_END events=9 answers=4\n");
  emit("E1 controls written.\n");
  return 0;
}

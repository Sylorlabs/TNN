// e1_worldgen.zag -- E1 discriminating experiment world generator.
// Generates the 4 fresh sealed worlds from PREREG_E1 section 3 (verbatim).
// Manifest hashes are computed by shell sha256sum. Pure Zag, pinned znc.
// Usage: e1_worldgen_bin <outdir>

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn app_str(buf:[]u8,pos:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
  return pos+s.len;
}
fn app_i32(buf:[]u8,pos:i32,v:i32)i32 {
  return app_str(buf,pos,i64s(v as i64));
}
fn app_nl(buf:[]u8,pos:i32)i32 { buf[pos]=10; return pos+1; }
fn w_observe(buf:[]u8,pos:i32,s:i32,r:i32,o:i32)i32 {
  pos=app_str(buf,pos,"OBSERVE ");
  pos=app_i32(buf,pos,s);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,r);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,o);
  return app_nl(buf,pos);
}
fn w_query(buf:[]u8,pos:i32,s:i32,r:i32,e:i32)i32 {
  pos=app_str(buf,pos,"QUERY ");
  pos=app_i32(buf,pos,s);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,r);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,e);
  return app_nl(buf,pos);
}
fn write_buf(path:[]u8,buf:[]u8,pos:i32)i32 {
  let out:[]u8=buf[0..pos];
  if(_zag_write_file(path,out)!=0){
    errln("write failed");
    return 1;
  }
  emit("WROTE "); _zag_print(path); emit(" "); e64(pos); emit(" bytes\n");
  return 0;
}
fn join_path(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+name.len+2);
  let p:i32=app_str(b,0,dir);
  if(dir.len>0 && dir[dir.len-1]!=47){ b[p]=47; p=p+1; }
  p=app_str(b,p,name);
  return b[0..p];
}
// ---- world emitters (exact streams from PREREG_E1 section 3) ----
fn gen_e1w1(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,71101,71601,71901);
  p=w_observe(buf,p,71102,71601,71901);
  p=w_observe(buf,p,71901,71602,71902);
  p=w_observe(buf,p,71101,71609,71999);
  p=w_observe(buf,p,71102,71609,71999);
  p=w_query(buf,p,71101,71609,71902);
  p=w_query(buf,p,71102,71609,71902);
  p=w_query(buf,p,71101,71601,71901);
  p=w_query(buf,p,71901,71602,71902);
  return p;
}
fn gen_e1w2(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,71201,71701,71202);
  p=w_observe(buf,p,71202,71702,71203);
  p=w_query(buf,p,71201,71709,71203);
  p=w_query(buf,p,71201,71709,71203);
  p=w_observe(buf,p,71201,71709,71213);
  p=w_observe(buf,p,71951,71960,71971);
  p=w_observe(buf,p,71952,71960,71972);
  p=w_observe(buf,p,71953,71960,71973);
  p=w_observe(buf,p,71954,71960,71974);
  p=w_query(buf,p,71201,71709,71213);
  p=w_query(buf,p,71201,71701,71202);
  p=w_query(buf,p,71202,71702,71203);
  return p;
}
fn gen_e1w3(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,71301,71801,71311);
  p=w_observe(buf,p,71302,71801,71312);
  p=w_observe(buf,p,71303,71801,71313);
  p=w_observe(buf,p,71401,71802,71411);
  p=w_observe(buf,p,71402,71802,71412);
  p=w_observe(buf,p,71403,71802,71413);
  p=w_query(buf,p,71301,71809,71311);
  p=w_query(buf,p,71401,71819,71411);
  p=w_observe(buf,p,71301,71801,71321);
  p=w_observe(buf,p,71302,71801,71322);
  p=w_observe(buf,p,71961,71960,71981);
  p=w_observe(buf,p,71962,71960,71982);
  p=w_query(buf,p,71301,71809,71321);
  p=w_query(buf,p,71401,71819,71421);
  p=w_query(buf,p,71303,71801,71313);
  p=w_query(buf,p,71403,71802,71413);
  return p;
}
fn gen_e1w4(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,71501,71511,71591);
  p=w_observe(buf,p,71502,71511,71592);
  p=w_observe(buf,p,71591,71512,71595);
  p=w_observe(buf,p,71592,71512,71596);
  p=w_query(buf,p,71501,71519,71595);
  p=w_query(buf,p,71502,71519,71596);
  p=w_query(buf,p,71501,71511,71591);
  p=w_query(buf,p,71591,71512,71595);
  return p;
}

fn main()i32 {
  if(_zag_argc()!=2){
    errln("usage: e1_worldgen_bin <outdir>");
    return 2;
  }
  let dir:[]u8=_zag_arg(1);
  if(dir.len>0 && dir[dir.len-1]==10){ dir=dir[0..dir.len-1]; }
  let buf:[]u8=z_alloc(8192);
  let p:i32=gen_e1w1(buf);
  if(write_buf(join_path(dir,"e1_w1.txt"),buf,p)!=0){ return 1; }
  p=gen_e1w2(buf);
  if(write_buf(join_path(dir,"e1_w2.txt"),buf,p)!=0){ return 1; }
  p=gen_e1w3(buf);
  if(write_buf(join_path(dir,"e1_w3.txt"),buf,p)!=0){ return 1; }
  p=gen_e1w4(buf);
  if(write_buf(join_path(dir,"e1_w4.txt"),buf,p)!=0){ return 1; }
  emit("E1 worlds generated.\n");
  return 0;
}

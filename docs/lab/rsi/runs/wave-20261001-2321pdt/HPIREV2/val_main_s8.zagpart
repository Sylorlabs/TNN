// ---- S8 world validator (new code; everything above this line is the
// byte-verbatim frozen machinery from proc_revise2.zag at 847a8f10f,
// lines 1-606) ----
// Pre-freeze certification aid for the five fresh single-conflict worlds.
// Runs V0/V1/V2/V3 validity, predicted diagnosis/alt/eval counts, and V4
// EW consistency. The executor re-runs V0-V3 mechanically at execution
// time; any void there still voids the world per the prereg.

fn hasbyte1(a:[]u8, x:i32)i32 {
  let i:i32=0;
  while(i<a.len){
    if((a[i] as i32)==x){ return 1; }
    i=i+1;
  }
  return 0;
}
fn hasbyte3(a:[]u8, b:[]u8, c:[]u8, x:i32)i32 {
  if(hasbyte1(a, x)==1){ return 1; }
  if(hasbyte1(b, x)==1){ return 1; }
  if(hasbyte1(c, x)==1){ return 1; }
  return 0;
}
fn infrozen(x:i32)i32 {
  if(x==97){ return 1; }
  if(x==98){ return 1; }
  if(x==99){ return 1; }
  if(x==100){ return 1; }
  if(x==101){ return 1; }
  if(x==102){ return 1; }
  if(x==103){ return 1; }
  if(x==113){ return 1; }
  if(x==114){ return 1; }
  if(x==119){ return 1; }
  if(x==120){ return 1; }
  if(x==121){ return 1; }
  return 0;
}

// Mechanical mirror of diagnose's candidate-generation logic: counts the
// deduped (pos,byte) pairs covering all currently failing records.
fn count_candidates(st:[]u8, pool:[]u8, base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, probe:[]u8)i32 {
  let n:i32=get32(st, 0);
  let fb:[]u8=z_alloc(32*4);
  let nf:i32=0;
  let e:i32=0;
  while(e<n){
    if(ex_status(st, e)==0){
      let ie:[]u8=ex_in(st, pool, e);
      let oe:[]u8=ex_out(st, pool, e);
      let pr:i32=predict(base, br, nb, ps, pidx, ie, probe);
      let bad:i32=0;
      if(pr!=oe.len){ bad=1; }
      else {
        if(bytes_eq(probe[0..pr], oe)!=1){ bad=1; }
      }
      if(bad==1){ set32(fb, nf*4, e); nf=nf+1; }
    }
    e=e+1;
  }
  let cb:[]u8=z_alloc(64*8);
  let nc:i32=0;
  let fi:i32=0;
  while(fi<nf){
    let fe:i32=get32(fb, fi*4);
    let fin:[]u8=ex_in(st, pool, fe);
    let p:i32=0;
    while(p<fin.len){
      let b:i32=fin[p] as i32;
      let ok:i32=1;
      let fj:i32=0;
      while(fj<nf){
        let fe2:i32=get32(fb, fj*4);
        let fin2:[]u8=ex_in(st, pool, fe2);
        if(p>=fin2.len){ ok=0; fj=nf; }
        else {
          if((fin2[p] as i32)!=b){ ok=0; fj=nf; }
        }
        fj=fj+1;
      }
      if(ok==1){
        let dup:i32=0;
        let ci:i32=0;
        while(ci<nc){
          if(get32(cb, ci*8)==p){
            if(get32(cb, ci*8+4)==b){ dup=1; ci=nc; }
          }
          ci=ci+1;
        }
        if(dup==0){
          set32(cb, nc*8, p);
          set32(cb, nc*8+4, b);
          nc=nc+1;
        }
      }
      p=p+1;
    }
    fi=fi+1;
  }
  return nc;
}

// V4 helper: expected output of R_w on one input. Conflict branch when the
// input matches the declared (pos,byte); else the base program v_old.
fn v4pair(inp:[]u8, want:[]u8, declpos:i32, declbyte:i32, v0:i32, br:[]u8, ps:[]u8, pidx:[]u8, probe:[]u8, fails:[]u8)void {
  let exp:[]u8=z_alloc(64);
  let n:i32=-1;
  let matched:i32=0;
  if(declpos<inp.len){
    if((inp[declpos] as i32)==declbyte){ matched=1; }
  }
  if(matched==1){
    n=inp.len;
    let k:i32=0;
    while(k<n){ exp[k]=declbyte as u8; k=k+1; }
  }
  else {
    let pn:i32=predict(v0, br, 0, ps, pidx, inp, probe);
    if(pn<0){
      emit("V4 UNPREDICTABLE ");
      emit(inp);
      emit("\n");
      set32(fails, 0, get32(fails, 0)+1);
      return;
    }
    n=pn;
    let k:i32=0;
    while(k<n){ exp[k]=probe[k]; k=k+1; }
  }
  if(n!=want.len){
    emit("V4 LEN-MISMATCH ");
    emit(inp);
    emit("\n");
    set32(fails, 0, get32(fails, 0)+1);
    return;
  }
  if(bytes_eq(exp[0..n], want)!=1){
    emit("V4 CONTENT-MISMATCH ");
    emit(inp);
    emit("\n");
    set32(fails, 0, get32(fails, 0)+1);
    return;
  }
  return;
}

fn val_world(key:[]u8,
  t0i:[]u8, t0o:[]u8, t1i:[]u8, t1o:[]u8, t2i:[]u8, t2o:[]u8,
  fwi:[]u8, fwo:[]u8, rwi:[]u8, rwo:[]u8,
  declpos:i32, declbyte:i32, v0exp:i32, altexp:i32, dov1e:i32,
  ps:[]u8, pidx:[]u8, pcount:i32, fails:[]u8)i32 {
  emit("=== WORLD ");
  emit(key);
  emit(" ===\n");
  let sdat:[]u8=z_alloc(4*64);
  let sod:[]u8=z_alloc(16);
  let sld:[]u8=z_alloc(16);
  let snd:[]u8=z_alloc(16);
  let st:[]u8=z_alloc(1024);
  set32(st, 0, 0);
  let pool:[]u8=z_alloc(4096);
  let pu:[]u8=z_alloc(4);
  set32(pu, 0, 0);
  let br:[]u8=z_alloc(256);
  let nbr:[]u8=z_alloc(4);
  set32(nbr, 0, 0);
  let probe:[]u8=z_alloc(64);
  let base:[]u8=z_alloc(4);

  // V0: base learnable, predicted first fit
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, t0i, t0o, t0i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 1, t1i, t1o, t1i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 2, t2i, t2o, t2i.len);
  let v0:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 3);
  emit("V0 first_fit_tw=");
  emit(i32s(v0));
  emit(" expect=");
  emit(i32s(v0exp));
  emit("\n");
  let twf:[]u8=z_alloc(4);
  set32(twf, 0, 0);
  pcheck(v0, br, get32(nbr, 0), ps, pidx, probe, t0i, t0o, twf);
  pcheck(v0, br, get32(nbr, 0), ps, pidx, probe, t1i, t1o, twf);
  pcheck(v0, br, get32(nbr, 0), ps, pidx, probe, t2i, t2o, twf);
  check("V0-learnable", v0>=0, fails);
  check("V0-no-fail-tw", get32(twf, 0)==0, fails);
  check("V0-predicted", v0==v0exp, fails);

  // V1: byte-disjointness
  let i:i32=0;
  let v1a:i32=1;
  while(i<fwi.len){
    if(hasbyte3(t0i, t1i, t2i, fwi[i] as i32)==1){ v1a=0; }
    i=i+1;
  }
  check("V1a-fw-disjoint-tw", v1a==1, fails);
  check("V1b-declared-in-fw", hasbyte1(fwi, declbyte)==1, fails);
  let v1c:i32=1;
  i=0;
  while(i<rwi.len){
    let rb:i32=rwi[i] as i32;
    if(hasbyte3(t0i, t1i, t2i, rb)==1){
      if(rb!=declbyte){ v1c=0; }
    }
    i=i+1;
  }
  check("V1c-rw-disjoint-tw", v1c==1, fails);
  let v1d:i32=0;
  if(declpos<rwi.len){
    if((rwi[declpos] as i32)==declbyte){ v1d=1; }
  }
  check("V1d-rw-matches-conflict", v1d==1, fails);
  if(dov1e==1){
    let v1e:i32=1;
    let j:i32=0;
    while(j<t0i.len){ if(infrozen(t0i[j] as i32)==1){ v1e=0; } j=j+1; }
    j=0;
    while(j<t1i.len){ if(infrozen(t1i[j] as i32)==1){ v1e=0; } j=j+1; }
    j=0;
    while(j<t2i.len){ if(infrozen(t2i[j] as i32)==1){ v1e=0; } j=j+1; }
    j=0;
    while(j<fwi.len){ if(infrozen(fwi[j] as i32)==1){ v1e=0; } j=j+1; }
    j=0;
    while(j<rwi.len){ if(infrozen(rwi[j] as i32)==1){ v1e=0; } j=j+1; }
    check("V1e-afrozen-disjoint", v1e==1, fails);
  }

  // V3: impossibility recheck
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, t0i, t0o, t0i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 1, t1i, t1o, t1i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 2, t2i, t2o, t2i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 3, fwi, fwo, fwi.len);
  let v3:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 4);
  emit("V3 first_fit_twfw=");
  emit(i32s(v3));
  emit("\n");
  check("V3-impossible", v3==-1, fails);

  // train + V2: problem real
  set32(base, 0, v0);
  let d0a:i32=observe(st, pool, pu, get32(base, 0), br, get32(nbr, 0), ps, pidx, t0i, t0o, 0, probe);
  let d0b:i32=observe(st, pool, pu, get32(base, 0), br, get32(nbr, 0), ps, pidx, t1i, t1o, 0, probe);
  let d0c:i32=observe(st, pool, pu, get32(base, 0), br, get32(nbr, 0), ps, pidx, t2i, t2o, 0, probe);
  check("TRAIN-no-false-detect-a", d0a==0, fails);
  check("TRAIN-no-false-detect-b", d0b==0, fails);
  check("TRAIN-no-false-detect-c", d0c==0, fails);
  let det:i32=observe(st, pool, pu, get32(base, 0), br, get32(nbr, 0), ps, pidx, fwi, fwo, 1, probe);
  check("V2-counterexample-real", det==1, fails);

  // diagnosis prediction: winner must be (0, FW[0])
  let dout:[]u8=z_alloc(12);
  let dg:i32=diagnose(st, pool, get32(base, 0), br, get32(nbr, 0), ps, pidx, dout, probe);
  check("REV-diagnosed", dg==1, fails);
  let dpos:i32=get32(dout, 0);
  let dbyte:i32=get32(dout, 4);
  emit("DIAG pos=");
  emit(i32s(dpos));
  emit(" byte=");
  emit(i32s(dbyte));
  emit(" expect pos=0 byte=");
  emit(i32s(fwi[0] as i32));
  emit("\n");
  check("DIAG-pos-predicted", dpos==0, fails);
  check("DIAG-byte-predicted", dbyte==(fwi[0] as i32), fails);
  let ncand:i32=count_candidates(st, pool, get32(base, 0), br, get32(nbr, 0), ps, pidx, probe);
  emit("predicted revision_evals=");
  emit(i32s(ncand+2));
  emit("\n");
  check("W2-predicted-ceiling", ncand+2<=25, fails);

  // alt prediction: first dsearch fit on FW alone
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, fwi, fwo, fwi.len);
  let alt:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 1);
  emit("ALT first_fit=");
  emit(i32s(alt));
  emit(" expect=");
  emit(i32s(altexp));
  emit("\n");
  check("ALT-predicted", alt==altexp, fails);

  // V4: EW consistency against the declared R_w
  let v4f:[]u8=z_alloc(4);
  set32(v4f, 0, 0);
  v4pair(t0i, t0o, declpos, declbyte, v0, br, ps, pidx, probe, v4f);
  v4pair(t1i, t1o, declpos, declbyte, v0, br, ps, pidx, probe, v4f);
  v4pair(t2i, t2o, declpos, declbyte, v0, br, ps, pidx, probe, v4f);
  v4pair(fwi, fwo, declpos, declbyte, v0, br, ps, pidx, probe, v4f);
  v4pair(rwi, rwo, declpos, declbyte, v0, br, ps, pidx, probe, v4f);
  check("V4-ew-consistent", get32(v4f, 0)==0, fails);
  return 0;
}

fn main()i32 {
  emit("=== S8 VALIDATOR ===\n");
  let fails:[]u8=z_alloc(4);
  set32(fails, 0, 0);

  let ps:[]u8=z_alloc(200000);
  let pidx:[]u8=z_alloc(1200*4);
  let pcount:i32=benum(ps, pidx);
  emit("enumerated ");
  emit(i32s(pcount));
  emit(" programs\n");
  check("enum-count-1055", pcount==1055, fails);

  // A2: novel alphabet and position (declared conflict position 1)
  val_world("A2",
    "ABCD", "DDDD", "EF", "FF", "GHIJ", "JJJJ",
    "QTRS", "TTTT", "QTXV", "TTTT",
    1, 84, 38, 3, 1,
    ps, pidx, pcount, fails);
  // B1: single-conflict variant, conflict at position 0
  val_world("B1",
    "1234", "4444", "56", "66", "7890", "0000",
    "!XYZ", "!!!!", "!PQR", "!!!!",
    0, 33, 38, 2, 0,
    ps, pidx, pcount, fails);
  // B2: single-conflict variant, conflict at position 2
  val_world("B2",
    "#$%&", "&&&&", "'(", "((", ")*+,", ",,,,",
    "/_:~", "::::", "/^:`", "::::",
    2, 58, 38, 4, 0,
    ps, pidx, pcount, fails);
  // C2: longer inputs, conflict at position 0
  val_world("C2",
    "012345678", "888888888", "0123456789:", ":::::::::::", "01234567", "77777777",
    ";ABCDEFGH", ";;;;;;;;;", ";IJKLMNOP", ";;;;;;;;;",
    0, 59, 38, 2, 0,
    ps, pidx, pcount, fails);
  // D2: novel template shape (v_old repeat-input[1], alt C3)
  val_world("D2",
    "ABC", "BBB", "DE", "EE", "FGHI", "GGGG",
    "PQRS", "SSSS", "PTUS", "SSSS",
    3, 83, 3, 24, 0,
    ps, pidx, pcount, fails);

  emit("=== VALIDATOR RESULT fails=");
  emit(i32s(get32(fails, 0)));
  emit(" ===\n");
  if(get32(fails, 0)>0){
    emit("WORLDS-INVALID\n");
    return 1;
  }
  emit("ALL-WORLDS-VALID\n");
  return 0;
}

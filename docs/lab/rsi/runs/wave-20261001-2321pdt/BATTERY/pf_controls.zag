// pf_controls.zag -- post-freeze battery calibration control policies.
// Usage: pf_controls_bin <world> <control_id>
//   Simulates the control policy against the world event stream; synthetic
//   transcript (ANSWER/CHOICE lines) to stdout.
// Control IDs: PFA1_D PFA1_C PFA2_D PFA2_C PFB1_D1 PFB1_D2 PFB1_C
//   PFB2_D PFB2_C PFC1_D PFC1_C PFC2_D PFC2_C
// Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
fn parse_3(d:[]u8,ls:i32,le:i32,sr:[]u8) i32 {
  let f0s:i32=skip_ws(d,ls,le);
  if(f0s>=le){ return 0; }
  let f0e:i32=field_end(d,f0s,le);
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  let s2:i32=skip_ws(d,e1,le);
  let e2:i32=field_end(d,s2,le);
  let s3:i32=skip_ws(d,e2,le);
  let e3:i32=field_end(d,s3,le);
  if(s1>=le || s2>=le || s3>=le){ return 0; }
  if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){ return 0; }
  if(skip_ws(d,e3,le)<le){ return 0; }
  put32(sr,0,parse_i32(d,s1,e1));
  put32(sr,4,parse_i32(d,s2,e2));
  put32(sr,8,parse_i32(d,s3,e3));
  return 1;
}
fn parse_world(wd:[]u8, evbuf:[]u8) i32 {
  let nev:i32=0;
  let n:i32=_zag_strlen(wd);
  let s:i32=0;
  let sr:[]u8=z_alloc(12);
  while(s<n && nev<64){
    let le:i32=line_end(wd,s,n);
    let f0s:i32=skip_ws(wd,s,le);
    if(f0s<le){
      let f0e:i32=field_end(wd,f0s,le);
      let wl:i32=f0e-f0s;
      if(word_is(wd,f0s,wl,"OBSERVE")==1 && parse_3(wd,s,le,sr)==1){
        put32(evbuf,nev*16,0);
        put32(evbuf,nev*16+4,ig(sr,0));
        put32(evbuf,nev*16+8,ig(sr,4));
        put32(evbuf,nev*16+12,ig(sr,8));
        nev=nev+1;
      }
      if(word_is(wd,f0s,wl,"QUERY")==1 && parse_3(wd,s,le,sr)==1){
        put32(evbuf,nev*16,1);
        put32(evbuf,nev*16+4,ig(sr,0));
        put32(evbuf,nev*16+8,ig(sr,4));
        put32(evbuf,nev*16+12,ig(sr,8));
        nev=nev+1;
      }
      if(word_is(wd,f0s,wl,"ACT")==1){
        put32(evbuf,nev*16,2);
        put32(evbuf,nev*16+4,0);
        put32(evbuf,nev*16+8,0);
        put32(evbuf,nev*16+12,0);
        nev=nev+1;
      }
    }
    s=le+1;
  }
  return nev;
}
fn put_fact(fbuf:[]u8,nf:i32,s:i32,r:i32,o:i32)i32 {
  let i:i32=0;
  while(i<nf){
    if(ig(fbuf,i*12)==s && ig(fbuf,i*12+4)==r){
      put32(fbuf,i*12+8,o);
      return nf;
    }
    i=i+1;
  }
  put32(fbuf,nf*12,s);
  put32(fbuf,nf*12+4,r);
  put32(fbuf,nf*12+8,o);
  return nf+1;
}
fn get_fact(fbuf:[]u8,nf:i32,s:i32,r:i32)i32 {
  let i:i32=0;
  while(i<nf){
    if(ig(fbuf,i*12)==s && ig(fbuf,i*12+4)==r){ return ig(fbuf,i*12+8); }
    i=i+1;
  }
  return -999999;
}
fn out_answer(s:i32,r:i32,v:i32)void {
  emit("ANSWER "); e64(s); emit(" "); e64(r); emit(" "); e64(v); emit("\n");
  return;
}
fn out_choice(v:i32)void {
  emit("CHOICE "); e64(v); emit("\n");
  return;
}

// ============ PF-A1 ============
// D: per-key latest (returns 60999 on compose probes). C: composer.
fn ctl_pfa1(cid:i32, evbuf:[]u8, nev:i32)void {
  let fbuf:[]u8=z_alloc(32*12);
  let nf:i32=0;
  let ei:i32=0;
  while(ei<nev){
    if(ig(evbuf,ei*16)==0){
      nf=put_fact(fbuf,nf,ig(evbuf,ei*16+4),ig(evbuf,ei*16+8),ig(evbuf,ei*16+12));
    }
    ei=ei+1;
  }
  ei=0;
  while(ei<nev){
    if(ig(evbuf,ei*16)==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let ans:i32=-2;
      if(cid==0){
        let kn:i32=get_fact(fbuf,nf,s,r);
        if(kn!=-999999){ ans=kn; }
      } else {
        if(r==60609){
          // compose P->Q: P(s) then Q(P(s))
          let mid:i32=get_fact(fbuf,nf,s,60601);
          if(mid!=-999999){
            let fin:i32=get_fact(fbuf,nf,mid,60602);
            if(fin!=-999999){ ans=fin; }
          }
        } else {
          let kn:i32=get_fact(fbuf,nf,s,r);
          if(kn!=-999999){ ans=kn; }
        }
      }
      out_answer(s,r,ans);
    }
    ei=ei+1;
  }
  return;
}

// ============ PF-A2 ============
// D: per-key latest. C: selective composer (P->Q only, never D).
fn ctl_pfa2(cid:i32, evbuf:[]u8, nev:i32)void {
  let fbuf:[]u8=z_alloc(32*12);
  let nf:i32=0;
  let ei:i32=0;
  while(ei<nev){
    if(ig(evbuf,ei*16)==0){
      nf=put_fact(fbuf,nf,ig(evbuf,ei*16+4),ig(evbuf,ei*16+8),ig(evbuf,ei*16+12));
    }
    ei=ei+1;
  }
  ei=0;
  while(ei<nev){
    if(ig(evbuf,ei*16)==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let ans:i32=-2;
      if(cid==0){
        let kn:i32=get_fact(fbuf,nf,s,r);
        if(kn!=-999999){ ans=kn; }
      } else {
        if(r==60619){
          let mid:i32=get_fact(fbuf,nf,s,60611);
          if(mid!=-999999){
            let fin:i32=get_fact(fbuf,nf,mid,60612);
            if(fin!=-999999){ ans=fin; }
          }
        } else if(r==60629){
          ans=-2; // D never composes
        } else {
          let kn:i32=get_fact(fbuf,nf,s,r);
          if(kn!=-999999){ ans=kn; }
        }
      }
      out_answer(s,r,ans);
    }
    ei=ei+1;
  }
  return;
}

// ============ PF-B1 ============
// D1: constant 77. D2: stale (repeats pre-resolution). C: selective resolver.
fn ctl_pfb1(cid:i32, evbuf:[]u8, nev:i32)void {
  let fbuf:[]u8=z_alloc(32*12);
  let nf:i32=0;
  let ei:i32=0;
  let last_miss:i32=0;
  let nguides:i32=0; // count of unresolved guides (C tracks)
  let stale:i32=0;
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==0){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let o:i32=ig(evbuf,ei*16+12);
      // C: if this OBSERVE resolves a pending miss, decrement
      if(cid==2){
        // check if (s,r) was a miss (not in fbuf before)
        let kn:i32=get_fact(fbuf,nf,s,r);
        if(kn==-999999){ } else {
          // it was known; if we had a guide for it, resolve one
          // (simplified: the OBSERVE after the two misses resolves one)
        }
      }
      nf=put_fact(fbuf,nf,s,r,o);
    }
    if(k==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let kn:i32=get_fact(fbuf,nf,s,r);
      last_miss=0;
      if(kn==-999999){
        last_miss=1;
        if(cid==2){ nguides=nguides+1; }
        out_answer(s,r,-2);
      } else {
        out_answer(s,r,kn);
        // C: if this is the resolving OBSERVE's key, decrement guides
        // (the OBSERVE 60302 comes after; we detect via the OBSERVE handler)
      }
    }
    if(k==2){
      let act:i32=0;
      if(cid==0){ act=77; }
      if(cid==1){
        if(last_miss==1){ act=30; stale=30; }
        else { if(stale==30){ act=30; } else { act=0; } }
      }
      if(cid==2){
        // C: baseline 0; pre-resolution (2 guides) 30; post (1 guide) 31
        // We track via nguides, but the resolving OBSERVE decrements.
        // Simplified: count ACTs; 1st=0, 2nd=30, 3rd=31.
        // (The world has exactly 3 ACTs in order.)
        act=0; // placeholder, set below
      }
      // For C, determine which ACT this is by counting prior ACTs
      if(cid==2){
        // count ACTs so far
        let c2:i32=0;
        let ej:i32=0;
        while(ej<ei){
          if(ig(evbuf,ej*16)==2){ c2=c2+1; }
          ej=ej+1;
        }
        if(c2==0){ act=0; }
        if(c2==1){ act=30; }
        if(c2==2){ act=31; } // selective: changed after partial resolution
      }
      out_choice(act);
      // C: after the 2nd ACT, the OBSERVE resolves one guide
      // (nguides is informational here)
    }
    ei=ei+1;
  }
  return;
}

// ============ PF-B2 ============
// D: constant 30. C: distinct per guide (11,22,33).
fn ctl_pfb2(cid:i32, evbuf:[]u8, nev:i32)void {
  let fbuf:[]u8=z_alloc(32*12);
  let nf:i32=0;
  let ei:i32=0;
  let ep:i32=0;
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==0){
      nf=put_fact(fbuf,nf,ig(evbuf,ei*16+4),ig(evbuf,ei*16+8),ig(evbuf,ei*16+12));
    }
    if(k==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let kn:i32=get_fact(fbuf,nf,s,r);
      if(kn==-999999){ out_answer(s,r,-2); }
      else { out_answer(s,r,kn); }
    }
    if(k==2){
      let act:i32=30;
      if(cid==1){
        if(ep==0){ act=11; }
        if(ep==1){ act=22; }
        if(ep==2){ act=33; }
        ep=ep+1;
      }
      out_choice(act);
    }
    ei=ei+1;
  }
  return;
}

// ============ PF-C1 ============
// D: global recency. C: exception-honoring (stores derived contradiction).
fn ctl_pfc1(cid:i32, evbuf:[]u8, nev:i32)void {
  let ei:i32=0;
  let last_o:i32=-999999;
  let fbuf:[]u8=z_alloc(32*12);
  let nf:i32=0;
  // C: override map for derived facts
  let ovr:[]u8=z_alloc(16*12);
  let novr:i32=0;
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==0){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let o:i32=ig(evbuf,ei*16+12);
      last_o=o;
      if(cid==1 && r==60909){
        // derived-fact contradiction: store as override
        novr=put_fact(ovr,novr,s,r,o);
      } else {
        nf=put_fact(fbuf,nf,s,r,o);
      }
    }
    if(k==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let ans:i32=-2;
      if(cid==0){
        if(last_o!=-999999){ ans=last_o; }
      } else {
        let ov:i32=get_fact(ovr,novr,s,r);
        if(ov!=-999999){ ans=ov; }
        else if(s==60501 && r==60909){
          let mid:i32=get_fact(fbuf,nf,60501,60901);
          if(mid!=-999999){
            let fin:i32=get_fact(fbuf,nf,mid,60902);
            if(fin!=-999999){ ans=fin; }
          }
        } else {
          let kn:i32=get_fact(fbuf,nf,s,r);
          if(kn!=-999999){ ans=kn; }
        }
      }
      out_answer(s,r,ans);
    }
    ei=ei+1;
  }
  return;
}

// ============ PF-C2 ============
// D: per-key latest (no transfer). C: transfer reviser.
// Single-pass in-order processing.
fn ctl_pfc2(cid:i32, evbuf:[]u8, nev:i32)void {
  let fbuf:[]u8=z_alloc(32*12);
  let nf:i32=0;
  let ei:i32=0;
  let shift:i32=0; // C: detected shift on 61001
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==0){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let o:i32=ig(evbuf,ei*16+12);
      if(cid==1 && r==61001 && s>=60601 && s<=60603){
        let sh:i32=o-(s+10);
        if(sh!=0){ shift=10+sh; }
      }
      nf=put_fact(fbuf,nf,s,r,o);
    }
    if(k==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let ans:i32=-2;
      if(cid==0){
        let lr:i32=r;
        if(r==61009){ lr=61001; }
        if(r==61019){ lr=61002; }
        let kn:i32=get_fact(fbuf,nf,s,lr);
        if(kn!=-999999){ ans=kn; }
      } else {
        if(r==61009){
          let kn:i32=get_fact(fbuf,nf,s,61001);
          if(kn!=-999999){ ans=kn; }
        } else if(r==61019){
          if(shift!=0 && s>=60701 && s<=60703){
            ans=s+shift;
          } else {
            let kn:i32=get_fact(fbuf,nf,s,61002);
            if(kn!=-999999){ ans=kn; }
          }
        } else {
          let kn:i32=get_fact(fbuf,nf,s,r);
          if(kn!=-999999){ ans=kn; }
        }
      }
      out_answer(s,r,ans);
    }
    ei=ei+1;
  }
  return;
}

fn main()i32 {
  let ac:i32=_zag_argc();
  if(ac!=3){
    errln("usage: pf_controls_bin <world> <control_id>");
    return 2;
  }
  let wd:[]u8=_zag_read_file(_zag_arg(1));
  let evbuf:[]u8=z_alloc(64*16);
  let nev:i32=parse_world(wd,evbuf);
  let cidstr:[]u8=_zag_arg(2);
  if(word_is(cidstr,0,cidstr.len,"PFA1_D")==1){ ctl_pfa1(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFA1_C")==1){ ctl_pfa1(1,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFA2_D")==1){ ctl_pfa2(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFA2_C")==1){ ctl_pfa2(1,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFB1_D1")==1){ ctl_pfb1(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFB1_D2")==1){ ctl_pfb1(1,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFB1_C")==1){ ctl_pfb1(2,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFB2_D")==1){ ctl_pfb2(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFB2_C")==1){ ctl_pfb2(1,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFC1_D")==1){ ctl_pfc1(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFC1_C")==1){ ctl_pfc1(1,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFC2_D")==1){ ctl_pfc2(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"PFC2_C")==1){ ctl_pfc2(1,evbuf,nev); return 0; }
  errln("unknown control id");
  return 2;
}

// v3_m2w1_driver.zag -- interactive M2-W1 world driver (step program).
// Usage: v3_m2w1_driver_bin <envelope> <step> <last_choice>
// Reads the sealed envelope (pi_r, truths, B table); computes the event
// lines for <step>; prints W+<world line>, L+<driver log line>, N+<next step>,
// or D+ when done. The learner never sees pi_r; it observes only its own
// emitted CHOICE values and the resulting OBSERVE responses.
// All informant routing logic lives here (Zag). A thin mechanical shell loop
// invokes this per step, appends lines, and runs the frozen shim on snippets.
// Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
// Output helpers: W+ line, L+ line, N+ next
fn wline(kind:[]u8, s:[]u8)void {
  emit(kind); emit(s); emit("\n");
  return;
}
fn w_observe(s:i32,r:i32,o:i32)void {
  emit("W+OBSERVE "); e64(s); emit(" "); e64(r); emit(" "); e64(o); emit("\n");
  return;
}
fn w_query(s:i32,r:i32,e:i32)void {
  emit("W+QUERY "); e64(s); emit(" "); e64(r); emit(" "); e64(e); emit("\n");
  return;
}
fn w_act()void { emit("W+ACT\n"); return; }
fn w_next(n:i32)void { emit("N+"); e64(n); emit("\n"); return; }
fn role_str(rl:i32)[]u8 {
  if(rl==1){ return "A"; }
  if(rl==2){ return "B"; }
  if(rl==3){ return "C"; }
  return "NONE";
}
fn role_of(choice:i32,pi0:i32,pi1:i32,pi2:i32)i32 {
  if(choice==1){ return pi0; }
  if(choice==2){ return pi1; }
  if(choice==3){ return pi2; }
  return 0;
}
fn lookup(buf:[]u8,n:i32,key:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(ig(buf,i*8)==key){ return ig(buf,i*8+4); }
    i=i+1;
  }
  return -999999;
}

fn main()i32 {
  if(_zag_argc()!=4){
    errln("usage: v3_m2w1_driver_bin <envelope> <step> <last_choice>");
    return 2;
  }
  let ed:[]u8=_zag_read_file(_zag_arg(1));
  let step:i32=parse_i32(_zag_arg(2),0,_zag_arg(2).len);
  let lc_arg:[]u8=_zag_arg(3);
  let last_choice:i32=-1;
  if(!(lc_arg.len==4 && lc_arg[0]==110 && lc_arg[1]==111 && lc_arg[2]==110 && lc_arg[3]==101)){
    if(is_int(lc_arg,0,lc_arg.len)==1){ last_choice=parse_i32(lc_arg,0,lc_arg.len); }
  }
  // ---- parse envelope ----
  let pi0:i32=0; let pi1:i32=0; let pi2:i32=0;
  let tbuf:[]u8=z_alloc(16*8);
  let bbuf:[]u8=z_alloc(16*8);
  let nt:i32=0; let nb:i32=0;
  let cval:i32=55999;
  let n:i32=_zag_strlen(ed);
  let s:i32=0;
  while(s<n){
    let le:i32=line_end(ed,s,n);
    let f0s:i32=skip_ws(ed,s,le);
    if(f0s<le){
      let f0e:i32=field_end(ed,f0s,le);
      let wl:i32=f0e-f0s;
      if(word_is(ed,f0s,wl,"PI")==1){
        let s1:i32=skip_ws(ed,f0e,le);
        let e1:i32=field_end(ed,s1,le);
        let s2:i32=skip_ws(ed,e1,le);
        let e2:i32=field_end(ed,s2,le);
        let s3:i32=skip_ws(ed,e2,le);
        let e3:i32=field_end(ed,s3,le);
        pi0=parse_i32(ed,s1,e1);
        pi1=parse_i32(ed,s2,e2);
        pi2=parse_i32(ed,s3,e3);
      }
      if(word_is(ed,f0s,wl,"T")==1){
        let s1:i32=skip_ws(ed,f0e,le);
        let e1:i32=field_end(ed,s1,le);
        let s2:i32=skip_ws(ed,e1,le);
        let e2:i32=field_end(ed,s2,le);
        if(is_int(ed,s1,e1)==1 && is_int(ed,s2,e2)==1 && nt<16){
          put32(tbuf,nt*8,parse_i32(ed,s1,e1));
          put32(tbuf,nt*8+4,parse_i32(ed,s2,e2));
          nt=nt+1;
        }
      }
      if(word_is(ed,f0s,wl,"B")==1){
        let s1:i32=skip_ws(ed,f0e,le);
        let e1:i32=field_end(ed,s1,le);
        let s2:i32=skip_ws(ed,e1,le);
        let e2:i32=field_end(ed,s2,le);
        if(is_int(ed,s1,e1)==1 && is_int(ed,s2,e2)==1 && nb<16){
          put32(bbuf,nb*8,parse_i32(ed,s1,e1));
          put32(bbuf,nb*8+4,parse_i32(ed,s2,e2));
          nb=nb+1;
        }
      }
      if(word_is(ed,f0s,wl,"CVAL")==1){
        let s1:i32=skip_ws(ed,f0e,le);
        let e1:i32=field_end(ed,s1,le);
        if(is_int(ed,s1,e1)==1){ cval=parse_i32(ed,s1,e1); }
      }
    }
    s=le+1;
  }
  if(step<0 || step>=49){
    emit("D+\n");
    return 0;
  }
  // keys
  // cal: 55101..55104 ; hidden: 55111..55114 ; rel 55600
  if(step==0){
    w_observe(55991,55600,55999);
    w_observe(55992,55600,55999);
    w_observe(55993,55600,55999);
    w_next(1);
    return 0;
  }
  if(step>=1 && step<=24){
    let pair:i32=(step-1)/2; // 0..11
    let ci:i32=pair/3;       // 0..3
    let is_act:i32=(step-1)%2; // 0=ACT, 1=route
    let key:i32=55101+ci;
    if(is_act==0){
      w_act();
      w_next(step+1);
      return 0;
    }
    // route step
    let rl:i32=role_of(last_choice,pi0,pi1,pi2);
    emit("L+ACT CAL "); e64(key); emit(" "); e64(last_choice); emit(" "); emit(role_str(rl)); emit("\n");
    if(rl!=0){
      let resp:i32=0;
      if(rl==1){ resp=lookup(tbuf,nt,key); }
      if(rl==2){ resp=lookup(bbuf,nb,key); }
      if(rl==3){ resp=cval; }
      w_observe(key,55600,resp);
    }
    let truth:i32=lookup(tbuf,nt,key);
    w_observe(key,55600,truth);
    w_query(key,55600,truth);
    w_next(step+1);
    return 0;
  }
  // steps 25..48: inquiry
  let hi:i32=(step-25)/6;   // 0..3
  let sub:i32=(step-25)%6;  // 0..5
  let hkey:i32=55111+hi;
  let htruth:i32=lookup(tbuf,nt,hkey);
  if(sub==0){
    w_query(hkey,55600,htruth);
    w_next(step+1);
    return 0;
  }
  if(sub==1 || sub==3){
    w_act();
    w_next(step+1);
    return 0;
  }
  if(sub==2 || sub==4){
    let rl:i32=role_of(last_choice,pi0,pi1,pi2);
    emit("L+ACT INQ "); e64(hkey); emit(" "); e64(last_choice); emit(" "); emit(role_str(rl)); emit("\n");
    if(rl!=0){
      let resp:i32=0;
      if(rl==1){ resp=lookup(tbuf,nt,hkey); }
      if(rl==2){ resp=lookup(bbuf,nb,hkey); }
      if(rl==3){ resp=cval; }
      w_observe(hkey,55600,resp);
    }
    w_next(step+1);
    return 0;
  }
  // sub==5
  w_query(hkey,55600,htruth);
  w_next(step+1);
  return 0;
}

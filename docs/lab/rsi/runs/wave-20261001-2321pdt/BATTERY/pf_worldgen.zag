// pf_worldgen.zag -- post-freeze sealed adversarial battery world generator.
// Generates the 6 fixed worlds from PREREG_POSTFREEZE section 2.
// Manifest hashes are computed by shell sha256sum. Pure Zag, pinned znc.
// Usage: pf_worldgen_bin <outdir>

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn app_str(buf:[]u8,pos:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
  return pos+s.len;
}
fn app_i32(buf:[]u8,pos:i32,v:i32)i32 {
  return app_str(buf,pos,i64s(v as i64));
}
fn app_nl(buf:[]u8,pos:i32)i32 { buf[pos]=10; return pos+1; }
fn w_observe(buf:[]u8,pos:i32,s:i32,r:i32,o:i32)i32 {
  pos=app_str(buf,pos,"OBSERVE ");
  pos=app_i32(buf,pos,s);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,r);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,o);
  return app_nl(buf,pos);
}
fn w_query(buf:[]u8,pos:i32,s:i32,r:i32,e:i32)i32 {
  pos=app_str(buf,pos,"QUERY ");
  pos=app_i32(buf,pos,s);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,r);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,e);
  return app_nl(buf,pos);
}
fn w_act(buf:[]u8,pos:i32)i32 {
  return app_str(buf,pos,"ACT\n");
}
fn write_buf(path:[]u8,buf:[]u8,pos:i32)i32 {
  let out:[]u8=buf[0..pos];
  if(_zag_write_file(path,out)!=0){
    errln("write failed");
    return 1;
  }
  emit("WROTE "); _zag_print(path); emit(" "); e64(pos); emit(" bytes\n");
  return 0;
}
fn join_path(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+name.len+2);
  let p:i32=app_str(b,0,dir);
  if(dir.len>0 && dir[dir.len-1]!=47){ b[p]=47; p=p+1; }
  p=app_str(b,p,name);
  return b[0..p];
}
// ---- world emitters (exact streams from PREREG_POSTFREEZE section 2) ----
fn gen_pfa1(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,60101,60601,60901);
  p=w_observe(buf,p,60102,60601,60901);
  p=w_observe(buf,p,60901,60602,60902);
  p=w_observe(buf,p,60101,60609,60999);
  p=w_observe(buf,p,60102,60609,60999);
  p=w_query(buf,p,60101,60609,60902);
  p=w_query(buf,p,60102,60609,60902);
  p=w_query(buf,p,60101,60601,60901);
  p=w_query(buf,p,60901,60602,60902);
  return p;
}
fn gen_pfa2(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,60201,60611,60911);
  p=w_observe(buf,p,60202,60611,60912);
  p=w_observe(buf,p,60911,60612,60921);
  p=w_observe(buf,p,60912,60612,60922);
  p=w_observe(buf,p,60201,60613,60931);
  p=w_observe(buf,p,60202,60613,60932);
  p=w_query(buf,p,60201,60619,60921);
  p=w_query(buf,p,60202,60619,60922);
  p=w_query(buf,p,60201,60629,60931);
  p=w_query(buf,p,60202,60629,60932);
  return p;
}
fn gen_pfb1(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,60301,60701,60311);
  p=w_query(buf,p,60301,60701,60311);
  p=w_act(buf,p);
  p=w_query(buf,p,60302,60701,60312);
  p=w_query(buf,p,60303,60701,60313);
  p=w_act(buf,p);
  p=w_observe(buf,p,60302,60701,60312);
  p=w_act(buf,p);
  p=w_query(buf,p,60304,60701,60314);
  p=w_query(buf,p,60305,60701,60315);
  return p;
}
fn gen_pfb2(buf:[]u8)i32 {
  let p:i32=0;
  p=w_query(buf,p,60401,60801,60411);
  p=w_query(buf,p,60402,60802,60412);
  p=w_query(buf,p,60403,60803,60413);
  p=w_act(buf,p);
  p=w_act(buf,p);
  p=w_act(buf,p);
  p=w_query(buf,p,60304,60701,60314);
  p=w_query(buf,p,60305,60701,60315);
  return p;
}
fn gen_pfc1(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,60501,60901,60502);
  p=w_observe(buf,p,60502,60902,60503);
  p=w_query(buf,p,60501,60909,60503);
  p=w_query(buf,p,60501,60909,60503);
  p=w_observe(buf,p,60501,60909,60513);
  p=w_observe(buf,p,60951,60960,60971);
  p=w_observe(buf,p,60952,60960,60972);
  p=w_observe(buf,p,60953,60960,60973);
  p=w_observe(buf,p,60954,60960,60974);
  p=w_query(buf,p,60501,60909,60513);
  p=w_query(buf,p,60501,60901,60502);
  p=w_query(buf,p,60502,60902,60503);
  return p;
}
fn gen_pfc2(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,60601,61001,60611);
  p=w_observe(buf,p,60602,61001,60612);
  p=w_observe(buf,p,60603,61001,60613);
  p=w_observe(buf,p,60701,61002,60711);
  p=w_observe(buf,p,60702,61002,60712);
  p=w_observe(buf,p,60703,61002,60713);
  p=w_query(buf,p,60601,61009,60611);
  p=w_query(buf,p,60701,61019,60711);
  p=w_observe(buf,p,60601,61001,60621);
  p=w_observe(buf,p,60602,61001,60622);
  p=w_observe(buf,p,60951,60960,60971);
  p=w_observe(buf,p,60952,60960,60972);
  p=w_query(buf,p,60601,61009,60621);
  p=w_query(buf,p,60701,61019,60721);
  p=w_query(buf,p,60603,61001,60613);
  p=w_query(buf,p,60703,61002,60713);
  return p;
}

fn main()i32 {
  if(_zag_argc()!=2){
    errln("usage: pf_worldgen_bin <outdir>");
    return 2;
  }
  let dir:[]u8=_zag_arg(1);
  let buf:[]u8=z_alloc(16384);
  let p:i32=0;
  p=gen_pfa1(buf);
  if(write_buf(join_path(dir,"pf_a1_world.txt"),buf,p)!=0){ return 1; }
  p=gen_pfa2(buf);
  if(write_buf(join_path(dir,"pf_a2_world.txt"),buf,p)!=0){ return 1; }
  p=gen_pfb1(buf);
  if(write_buf(join_path(dir,"pf_b1_world.txt"),buf,p)!=0){ return 1; }
  p=gen_pfb2(buf);
  if(write_buf(join_path(dir,"pf_b2_world.txt"),buf,p)!=0){ return 1; }
  p=gen_pfc1(buf);
  if(write_buf(join_path(dir,"pf_c1_world.txt"),buf,p)!=0){ return 1; }
  p=gen_pfc2(buf);
  if(write_buf(join_path(dir,"pf_c2_world.txt"),buf,p)!=0){ return 1; }
  emit("PF WORLDGEN DONE\n");
  return 0;
}

// v3_worldgen.zag -- sealed battery v3 world/envelope generator.
// Generates the 7 fixed world files, the M2-W1 template, and the 3 sealed
// per-run envelopes (pi_r from committed seed 20261002 via LCG +
// Fisher-Yates, deduped). Writes files into the lane directory.
// Manifest hashes are computed by shell sha256sum (prereg section 0:
// shell is used for hash manifests). Pure Zag, pinned znc.
// Usage: v3_worldgen_bin <outdir>

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
// ---- buffer append helpers ----
fn app_str(buf:[]u8,pos:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
  return pos+s.len;
}
fn app_i32(buf:[]u8,pos:i32,v:i32)i32 {
  return app_str(buf,pos,i64s(v as i64));
}
fn app_nl(buf:[]u8,pos:i32)i32 { buf[pos]=10; return pos+1; }
fn w_observe(buf:[]u8,pos:i32,s:i32,r:i32,o:i32)i32 {
  pos=app_str(buf,pos,"OBSERVE ");
  pos=app_i32(buf,pos,s);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,r);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,o);
  return app_nl(buf,pos);
}
fn w_query(buf:[]u8,pos:i32,s:i32,r:i32,e:i32)i32 {
  pos=app_str(buf,pos,"QUERY ");
  pos=app_i32(buf,pos,s);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,r);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,e);
  return app_nl(buf,pos);
}
fn w_act(buf:[]u8,pos:i32)i32 {
  return app_str(buf,pos,"ACT\n");
}
fn write_buf(path:[]u8,buf:[]u8,pos:i32)i32 {
  let out:[]u8=buf[0..pos];
  if(_zag_write_file(path,out)!=0){
    errln("write failed");
    return 1;
  }
  emit("WROTE "); _zag_print(path); emit(" "); e64(pos); emit(" bytes\n");
  return 0;
}
fn join_path(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+name.len+2);
  let p:i32=app_str(b,0,dir);
  // ensure trailing slash
  if(dir.len>0 && dir[dir.len-1]!=47){ b[p]=47; p=p+1; }
  p=app_str(b,p,name);
  return b[0..p];
}
// ---- deterministic LCG (committed seed) ----
fn lcg_next(x:i64)i64 {
  return (1103515245*x+12345)%2147483648;
}
// Fisher-Yates on [1,2,3]; stores permutation into pi (3 x i32).
fn gen_perm(seed:i64,pi:[]u8) i64 {
  let a0:i32=1; let a1:i32=2; let a2:i32=3;
  let x:i64=seed;
  // i=2
  x=lcg_next(x);
  let j:i32=(x%3) as i32;
  if(j==0){ let t:i32=a0; a0=a2; a2=t; }
  if(j==1){ let t:i32=a1; a1=a2; a2=t; }
  // i=1
  x=lcg_next(x);
  j=(x%2) as i32;
  if(j==0){ let t:i32=a0; a0=a1; a1=t; }
  let b:[]u8=pi;
  b[0]=a0 as u8; b[1]=a1 as u8; b[2]=a2 as u8;
  return x;
}
fn perm_eq(a:[]u8,b:[]u8)i32 {
  if(a[0]==b[0] && a[1]==b[1] && a[2]==b[2]){ return 1; }
  return 0;
}
// ---- world emitters (exact streams from PREREG_BATTERY_V3 section 3) ----
fn gen_m1w1(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,50201,50601,50901);
  p=w_observe(buf,p,50201,50602,50902);
  p=w_observe(buf,p,50202,50601,50901);
  p=w_observe(buf,p,50202,50602,50902);
  p=w_observe(buf,p,50203,50603,50903);
  p=w_observe(buf,p,50203,50604,50904);
  p=w_observe(buf,p,50204,50603,50903);
  p=w_observe(buf,p,50204,50604,50904);
  p=w_observe(buf,p,50205,50601,50902);
  p=w_observe(buf,p,50205,50602,50901);
  p=w_observe(buf,p,50205,50603,50904);
  p=w_observe(buf,p,50205,50604,50903);
  p=w_query(buf,p,50206,50601,50901);
  p=w_query(buf,p,50206,50602,50902);
  p=w_query(buf,p,50206,50603,50903);
  p=w_query(buf,p,50206,50604,50904);
  p=w_query(buf,p,50207,50601,50901);
  p=w_query(buf,p,50207,50602,50902);
  p=w_query(buf,p,50207,50603,50903);
  p=w_query(buf,p,50207,50604,50904);
  p=w_query(buf,p,50205,50601,50902);
  p=w_query(buf,p,50205,50602,50901);
  p=w_query(buf,p,50205,50603,50904);
  p=w_query(buf,p,50205,50604,50903);
  return p;
}
fn gen_m1w2(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,51111,51501,51112);
  p=w_observe(buf,p,51112,51501,51113);
  p=w_observe(buf,p,51113,51501,51114);
  p=w_observe(buf,p,51121,51501,51122);
  p=w_observe(buf,p,51122,51501,51123);
  p=w_observe(buf,p,51123,51501,51124);
  p=w_query(buf,p,51111,51501,51112);
  p=w_query(buf,p,51121,51501,51122);
  p=w_query(buf,p,51114,51509,51111);
  p=w_query(buf,p,51113,51509,51111);
  p=w_query(buf,p,51124,51509,51121);
  p=w_query(buf,p,51123,51509,51121);
  p=w_query(buf,p,50205,50601,50902);
  p=w_query(buf,p,50205,50603,50904);
  return p;
}
fn gen_m1w3(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,51721,51801,51911);
  p=w_observe(buf,p,51721,51802,51912);
  p=w_observe(buf,p,51721,51803,51913);
  p=w_observe(buf,p,51722,51801,51911);
  p=w_observe(buf,p,51722,51802,51912);
  p=w_observe(buf,p,51722,51803,51913);
  p=w_observe(buf,p,51723,51801,51912);
  p=w_observe(buf,p,51723,51802,51911);
  p=w_observe(buf,p,51723,51803,51912);
  p=w_query(buf,p,51721,51801,51911);
  p=w_query(buf,p,51726,51801,51911);
  p=w_query(buf,p,51726,51802,51912);
  p=w_query(buf,p,51726,51803,51913);
  p=w_query(buf,p,51111,51509,51114);
  p=w_query(buf,p,51121,51509,51124);
  return p;
}
fn gen_m2w1_template(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,55991,55600,55999);
  p=w_observe(buf,p,55992,55600,55999);
  p=w_observe(buf,p,55993,55600,55999);
  return p;
}
fn gen_m2w2(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,54011,54601,54021);
  p=w_query(buf,p,54011,54601,54021);
  p=w_act(buf,p);
  p=w_query(buf,p,54111,54601,54901);
  p=w_act(buf,p);
  p=w_observe(buf,p,54111,54601,54901);
  p=w_observe(buf,p,54302,54602,54312);
  p=w_observe(buf,p,54303,54602,54313);
  p=w_observe(buf,p,54304,54602,54314);
  p=w_observe(buf,p,54305,54602,54315);
  p=w_observe(buf,p,54306,54602,54316);
  p=w_observe(buf,p,54307,54602,54317);
  p=w_query(buf,p,54111,54601,54901);
  p=w_act(buf,p);
  p=w_query(buf,p,55101,55600,55201);
  p=w_query(buf,p,55102,55600,55202);
  return p;
}
fn gen_m2w3(buf:[]u8)i32 {
  let p:i32=0;
  p=w_query(buf,p,56201,56601,56901);
  p=w_act(buf,p);
  p=w_observe(buf,p,56311,56609,56391);
  p=w_observe(buf,p,56312,56609,56392);
  p=w_observe(buf,p,56313,56609,56393);
  p=w_observe(buf,p,56314,56609,56394);
  p=w_query(buf,p,56202,56602,56902);
  p=w_act(buf,p);
  p=w_observe(buf,p,56321,56609,56395);
  p=w_observe(buf,p,56322,56609,56396);
  p=w_observe(buf,p,56323,56609,56397);
  p=w_observe(buf,p,56324,56609,56398);
  p=w_query(buf,p,56203,56603,56903);
  p=w_act(buf,p);
  p=w_query(buf,p,55103,55600,55203);
  p=w_query(buf,p,55104,55600,55204);
  return p;
}
fn gen_m3w1(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,52911,52950,52921);
  p=w_observe(buf,p,52912,52950,52922);
  p=w_observe(buf,p,52913,52950,52923);
  p=w_observe(buf,p,52914,52950,52924);
  p=w_observe(buf,p,52915,52950,52925);
  p=w_observe(buf,p,52916,52950,52926);
  p=w_observe(buf,p,52201,52600,52208);
  p=w_observe(buf,p,52202,52600,52209);
  p=w_observe(buf,p,52203,52600,52210);
  p=w_observe(buf,p,52204,52600,52211);
  p=w_observe(buf,p,52205,52600,52212);
  p=w_observe(buf,p,52206,52600,52213);
  p=w_observe(buf,p,52207,52600,52214);
  p=w_observe(buf,p,52208,52600,52215);
  p=w_query(buf,p,52201,52601,52208);
  p=w_query(buf,p,52202,52601,52209);
  p=w_query(buf,p,52203,52601,52210);
  p=w_query(buf,p,52204,52601,52211);
  p=w_observe(buf,p,52201,52600,52221);
  p=w_observe(buf,p,52202,52600,52213);
  p=w_observe(buf,p,52203,52600,52214);
  p=w_observe(buf,p,52204,52600,52215);
  p=w_observe(buf,p,52821,52850,52831);
  p=w_observe(buf,p,52822,52850,52832);
  p=w_observe(buf,p,52823,52850,52833);
  p=w_observe(buf,p,52824,52850,52834);
  p=w_observe(buf,p,52825,52850,52835);
  p=w_observe(buf,p,52826,52850,52836);
  p=w_observe(buf,p,52827,52850,52837);
  p=w_observe(buf,p,52828,52850,52838);
  p=w_observe(buf,p,52829,52850,52839);
  p=w_observe(buf,p,52830,52850,52840);
  p=w_observe(buf,p,52831,52850,52841);
  p=w_observe(buf,p,52832,52850,52842);
  p=w_query(buf,p,52201,52601,52208);
  p=w_query(buf,p,52202,52601,52213);
  p=w_query(buf,p,52203,52601,52214);
  p=w_query(buf,p,52204,52601,52215);
  p=w_query(buf,p,52205,52601,52216);
  p=w_query(buf,p,52206,52601,52217);
  p=w_query(buf,p,52911,52950,52921);
  p=w_query(buf,p,52912,52950,52922);
  p=w_query(buf,p,52913,52950,52923);
  p=w_query(buf,p,52914,52950,52924);
  p=w_query(buf,p,52915,52950,52925);
  p=w_query(buf,p,52916,52950,52926);
  return p;
}
fn gen_m3w2(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,53201,53601,53202);
  p=w_observe(buf,p,53202,53602,53203);
  p=w_query(buf,p,53201,53609,53203);
  p=w_query(buf,p,53201,53609,53203);
  p=w_observe(buf,p,53202,53602,53209);
  p=w_query(buf,p,53201,53609,53209);
  p=w_observe(buf,p,53202,53602,53219);
  p=w_observe(buf,p,53651,53660,53671);
  p=w_observe(buf,p,53652,53660,53672);
  p=w_observe(buf,p,53653,53660,53673);
  p=w_observe(buf,p,53654,53660,53674);
  p=w_observe(buf,p,53655,53660,53675);
  p=w_observe(buf,p,53656,53660,53676);
  p=w_query(buf,p,53201,53609,53219);
  p=w_query(buf,p,52202,52601,52213);
  p=w_query(buf,p,52201,52601,52208);
  return p;
}
fn gen_m3w3(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,53801,53901,53802);
  p=w_observe(buf,p,53802,53902,53803);
  p=w_query(buf,p,53801,53909,53803);
  p=w_query(buf,p,53801,53909,53803);
  p=w_observe(buf,p,53801,53901,53811);
  p=w_observe(buf,p,53811,53902,53813);
  p=w_observe(buf,p,53951,53960,53971);
  p=w_observe(buf,p,53952,53960,53972);
  p=w_observe(buf,p,53953,53960,53973);
  p=w_observe(buf,p,53954,53960,53974);
  p=w_observe(buf,p,53955,53960,53975);
  p=w_observe(buf,p,53956,53960,53976);
  p=w_query(buf,p,53801,53909,53813);
  p=w_query(buf,p,53201,53609,53209);
  p=w_query(buf,p,52203,52601,52214);
  return p;
}
// ---- envelope emitter ----
fn gen_envelope(buf:[]u8,run:i32,pi:[]u8)i32 {
  let p:i32=0;
  p=app_str(buf,p,"SEALED-ENVELOPE M2-W1 RUN ");
  p=app_i32(buf,p,run);
  p=app_nl(buf,p);
  p=app_str(buf,p,"PI ");
  p=app_i32(buf,p,pi[0] as i32);
  p=app_str(buf,p," ");
  p=app_i32(buf,p,pi[1] as i32);
  p=app_str(buf,p," ");
  p=app_i32(buf,p,pi[2] as i32);
  p=app_nl(buf,p);
  // truths T key truth
  p=app_str(buf,p,"T 55101 55201\n");
  p=app_str(buf,p,"T 55102 55202\n");
  p=app_str(buf,p,"T 55103 55203\n");
  p=app_str(buf,p,"T 55104 55204\n");
  p=app_str(buf,p,"T 55111 55211\n");
  p=app_str(buf,p,"T 55112 55212\n");
  p=app_str(buf,p,"T 55113 55213\n");
  p=app_str(buf,p,"T 55114 55214\n");
  // B table (fixed by prereg 3.4)
  p=app_str(buf,p,"B 55101 55201\n");
  p=app_str(buf,p,"B 55102 55998\n");
  p=app_str(buf,p,"B 55103 55203\n");
  p=app_str(buf,p,"B 55104 55997\n");
  p=app_str(buf,p,"B 55111 55996\n");
  p=app_str(buf,p,"B 55112 55995\n");
  p=app_str(buf,p,"B 55113 55994\n");
  p=app_str(buf,p,"B 55114 55993\n");
  p=app_str(buf,p,"CVAL 55999\n");
  return p;
}

fn main()i32 {
  if(_zag_argc()!=2){
    errln("usage: v3_worldgen_bin <outdir>");
    return 2;
  }
  let dir:[]u8=_zag_arg(1);
  let buf:[]u8=z_alloc(16384);
  let p:i32=0;
  // 7 fixed worlds + template
  p=gen_m1w1(buf);
  if(write_buf(join_path(dir,"m1w1v3_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m1w2(buf);
  if(write_buf(join_path(dir,"m1w2v3_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m1w3(buf);
  if(write_buf(join_path(dir,"m1w3v3_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m2w1_template(buf);
  if(write_buf(join_path(dir,"m2w1v3_template.txt"),buf,p)!=0){ return 1; }
  p=gen_m2w2(buf);
  if(write_buf(join_path(dir,"m2w2v3_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m2w3(buf);
  if(write_buf(join_path(dir,"m2w3v3_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m3w1(buf);
  if(write_buf(join_path(dir,"m3w1v3_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m3w2(buf);
  if(write_buf(join_path(dir,"m3w2v3_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m3w3(buf);
  if(write_buf(join_path(dir,"m3w3v3_world.txt"),buf,p)!=0){ return 1; }
  // 3 sealed envelopes, pi_r from committed seed 20261002
  let seed:i64=20261002;
  let pi0:[]u8=z_alloc(3);
  let pi1:[]u8=z_alloc(3);
  let pi2:[]u8=z_alloc(3);
  let x:i64=gen_perm(seed,pi0);
  emit("ENVELOPE run=1 PI ");
  e64(pi0[0] as i32); emit(" "); e64(pi0[1] as i32); emit(" "); e64(pi0[2] as i32); emit("\n");
  // distinct permutations: regenerate until different
  let tmp:[]u8=z_alloc(3);
  x=gen_perm(x,tmp);
  while(perm_eq(tmp,pi0)==1){ x=gen_perm(x,tmp); }
  pi1[0]=tmp[0]; pi1[1]=tmp[1]; pi1[2]=tmp[2];
  emit("ENVELOPE run=2 PI ");
  e64(pi1[0] as i32); emit(" "); e64(pi1[1] as i32); emit(" "); e64(pi1[2] as i32); emit("\n");
  x=gen_perm(x,tmp);
  while(perm_eq(tmp,pi0)==1 || perm_eq(tmp,pi1)==1){ x=gen_perm(x,tmp); }
  pi2[0]=tmp[0]; pi2[1]=tmp[1]; pi2[2]=tmp[2];
  emit("ENVELOPE run=3 PI ");
  e64(pi2[0] as i32); emit(" "); e64(pi2[1] as i32); emit(" "); e64(pi2[2] as i32); emit("\n");
  p=gen_envelope(buf,1,pi0);
  if(write_buf(join_path(dir,"m2w1v3_envelope_run1.txt"),buf,p)!=0){ return 1; }
  p=gen_envelope(buf,2,pi1);
  if(write_buf(join_path(dir,"m2w1v3_envelope_run2.txt"),buf,p)!=0){ return 1; }
  p=gen_envelope(buf,3,pi2);
  if(write_buf(join_path(dir,"m2w1v3_envelope_run3.txt"),buf,p)!=0){ return 1; }
  emit("WORLDGEN DONE seed=20261002\n");
  return 0;
}

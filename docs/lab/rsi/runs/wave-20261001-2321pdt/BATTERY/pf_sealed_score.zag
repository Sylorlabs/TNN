// pf_sealed_score.zag -- post-freeze battery scorer.
// Usage: pf_sealed_score_bin <world.txt> <transcript.txt> BAR=<spec>
// 1:1 QUERY/ANSWER scoring; CHOICE collection; PF-K5 per-world bars.
// Bar specs: PFA1 PFA2 PFB1 PFB2:M=<m>:N=<n> PFC1 PFC2
// Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
fn parse_3(d:[]u8,ls:i32,le:i32,sr:[]u8) i32 {
  let f0s:i32=skip_ws(d,ls,le);
  if(f0s>=le){ return 0; }
  let f0e:i32=field_end(d,f0s,le);
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  let s2:i32=skip_ws(d,e1,le);
  let e2:i32=field_end(d,s2,le);
  let s3:i32=skip_ws(d,e2,le);
  let e3:i32=field_end(d,s3,le);
  if(s1>=le || s2>=le || s3>=le){ return 0; }
  if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){ return 0; }
  if(skip_ws(d,e3,le)<le){ return 0; }
  put32(sr,0,parse_i32(d,s1,e1));
  put32(sr,4,parse_i32(d,s2,e2));
  put32(sr,8,parse_i32(d,s3,e3));
  return 1;
}
fn barline(name:[]u8,ok:i32)void {
  emit("BAR "); emit(name); emit(" ");
  if(ok==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return;
}
fn cnt_ok(okbuf:[]u8,a:i32,b:i32)i32 {
  let c:i32=0;
  let i:i32=a;
  while(i<b){ if(ig(okbuf,i*4)==1){ c=c+1; } i=i+1; }
  return c;
}
// parse PFB2:M=<m>:N=<n>
fn parse_pfb2(spec:[]u8,out:[]u8)i32 {
  let i:i32=5;
  if(spec[i]!=77 || spec[i+1]!=61){ return 0; }
  i=i+2;
  let neg:i32=0;
  if(spec[i]==45){ neg=1; i=i+1; }
  let v:i32=0;
  while(i<spec.len && spec[i]>=48 && spec[i]<=57){ v=v*10+(spec[i] as i32-48); i=i+1; }
  if(neg==1){ v=0-v; }
  if(spec[i]!=58){ return 0; }
  i=i+1;
  if(spec[i]!=78 || spec[i+1]!=61){ return 0; }
  i=i+2;
  neg=0;
  if(spec[i]==45){ neg=1; i=i+1; }
  let w:i32=0;
  while(i<spec.len && spec[i]>=48 && spec[i]<=57){ w=w*10+(spec[i] as i32-48); i=i+1; }
  if(neg==1){ w=0-w; }
  put32(out,0,v);
  put32(out,4,w);
  return 1;
}

fn main()i32 {
  let ac:i32=_zag_argc();
  if(ac!=3 && ac!=4){
    errln("usage: pf_sealed_score_bin <world.txt> <transcript.txt> [BAR=<spec>]");
    return 2;
  }
  let wd:[]u8=_zag_read_file(_zag_arg(1));
  let td:[]u8=_zag_read_file(_zag_arg(2));
  let spec:[]u8="";
  if(ac==4){
    spec=_zag_arg(3);
    if(spec.len>4 && spec[0]==66 && spec[1]==65 && spec[2]==82 && spec[3]==61){
      spec=spec[4..spec.len];
    }
  }
  // collect world QUERYs
  let qbuf:[]u8=z_alloc(64*12);
  let nq:i32=0;
  let sr:[]u8=z_alloc(12);
  let n:i32=_zag_strlen(wd);
  let s:i32=0;
  while(s<n && nq<64){
    let le:i32=line_end(wd,s,n);
    let f0s:i32=skip_ws(wd,s,le);
    if(f0s<le){
      let f0e:i32=field_end(wd,f0s,le);
      if(word_is(wd,f0s,f0e-f0s,"QUERY")==1 && parse_3(wd,s,le,sr)==1){
        put32(qbuf,nq*12,ig(sr,0));
        put32(qbuf,nq*12+4,ig(sr,4));
        put32(qbuf,nq*12+8,ig(sr,8));
        nq=nq+1;
      }
    }
    s=le+1;
  }
  // collect transcript ANSWERs and CHOICEs
  let abuf:[]u8=z_alloc(64*12);
  let na:i32=0;
  let cbuf:[]u8=z_alloc(64*4);
  let nc:i32=0;
  n=_zag_strlen(td);
  s=0;
  while(s<n && (na<64 || nc<64)){
    let le:i32=line_end(td,s,n);
    let f0s:i32=skip_ws(td,s,le);
    if(f0s<le){
      let f0e:i32=field_end(td,f0s,le);
      let wl:i32=f0e-f0s;
      if(word_is(td,f0s,wl,"ANSWER")==1 && parse_3(td,s,le,sr)==1 && na<64){
        put32(abuf,na*12,ig(sr,0));
        put32(abuf,na*12+4,ig(sr,4));
        put32(abuf,na*12+8,ig(sr,8));
        na=na+1;
      }
      if(word_is(td,f0s,wl,"CHOICE")==1 && nc<64){
        let s1:i32=skip_ws(td,f0e,le);
        let e1:i32=field_end(td,s1,le);
        if(is_int(td,s1,e1)==1){
          put32(cbuf,nc*4,parse_i32(td,s1,e1));
          nc=nc+1;
        }
      }
    }
    s=le+1;
  }
  // 1:1 scoring
  let okbuf:[]u8=z_alloc(64*4);
  let npass:i32=0;
  let i:i32=0;
  while(i<nq && i<na){
    let ok:i32=0;
    if(ig(qbuf,i*12)==ig(abuf,i*12) && ig(qbuf,i*12+4)==ig(abuf,i*12+4) && ig(qbuf,i*12+8)==ig(abuf,i*12+8)){
      ok=1; npass=npass+1;
    }
    put32(okbuf,i*4,ok);
    emit("PROBE "); e64(i); emit(" ");
    if(ok==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
    i=i+1;
  }
  emit("SUMMARY pass="); e64(npass); emit(" total="); e64(nq); emit("\n");
  emit("CHOICES");
  i=0;
  while(i<nc){ emit(" "); e64(ig(cbuf,i*4)); i=i+1; }
  emit("\n");
  // ---- PF-K5 bars ----
  if(spec.len>=4 && word_is(spec,0,4,"PFA1")==1){
    let comp:i32=cnt_ok(okbuf,0,2);
    let val:i32=cnt_ok(okbuf,2,4);
    emit("PF-A1 composition "); e64(comp); emit("/2 ");
    if(comp==2){ emit("PASS\n"); } else { emit("FAIL\n"); }
    emit("PF-A1 validity "); e64(val); emit("/2 ");
    if(val==2){ emit("PASS\n"); } else { emit("FAIL WORLD-INVALID\n"); }
    if(comp==2 && val==2){ barline("PF-A1",1); } else { barline("PF-A1",0); }
  }
  if(spec.len>=4 && word_is(spec,0,4,"PFA2")==1){
    let comp:i32=cnt_ok(okbuf,0,2);
    let m2:i32=0; let m3:i32=0;
    if(na>2 && ig(abuf,2*12+8)==-2){ m2=1; }
    if(na>3 && ig(abuf,3*12+8)==-2){ m3=1; }
    emit("PF-A2 valid-comp "); e64(comp); emit("/2 ");
    if(comp==2){ emit("PASS\n"); } else { emit("FAIL\n"); }
    emit("PF-A2 no-spurious ");
    if(m2==1 && m3==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
    if(comp==2 && m2==1 && m3==1){ barline("PF-A2",1); } else { barline("PF-A2",0); }
  }
  if(spec.len>=4 && word_is(spec,0,4,"PFB1")==1){
    if(nc>=3){
      let nn:i32=ig(cbuf,0);
      let pre:i32=ig(cbuf,4);
      let post:i32=ig(cbuf,8);
      emit("NULL_ACTION "); e64(nn); emit("\n");
      emit("PRERES_ACTION "); e64(pre); emit("\n");
      emit("POSTRES_ACTION "); e64(post); emit("\n");
      let mm:i32=-888888;
      if(na>1){ mm=ig(abuf,1*12+8); }
      let v1:i32=0; let v2:i32=0;
      if(ig(abuf,1*12+8)==mm){ v1=1; }
      if(na>2 && ig(abuf,2*12+8)==mm){ v2=1; }
      emit("PF-B1 validity-miss ");
      if(v1==1 && v2==1){ emit("PASS\n"); } else { emit("FAIL WORLD-INVALID\n"); }
      emit("PF-B1 selective ");
      if(pre!=post){ emit("PASS\n"); } else { emit("FAIL\n"); }
      if(v1==1 && v2==1 && pre!=post){ barline("PF-B1",1); } else { barline("PF-B1",0); }
    } else {
      emit("PF-B1 INSUFFICIENT CHOICES\n");
      barline("PF-B1",0);
    }
  }
  if(spec.len>=4 && word_is(spec,0,4,"PFB2")==1){
    let prm:[]u8=z_alloc(8);
    if(parse_pfb2(spec,prm)==1 && nc>=3){
      let mm:i32=ig(prm,0);
      let nn:i32=ig(prm,4);
      let a0:i32=ig(cbuf,0);
      let a1:i32=ig(cbuf,4);
      let a2:i32=ig(cbuf,8);
      emit("PFB2 M="); e64(mm); emit(" N="); e64(nn); emit("\n");
      emit("FLOOD_ACTIONS "); e64(a0); emit(" "); e64(a1); emit(" "); e64(a2); emit("\n");
      let distinct:i32=0;
      if(a0!=a1 && a1!=a2 && a0!=a2){ distinct=1; }
      let nonnull:i32=0;
      if(a0!=nn && a1!=nn && a2!=nn){ nonnull=1; }
      let v0:i32=0; let v1:i32=0; let v2:i32=0;
      if(na>2){
        if(ig(abuf,0*12+8)==mm){ v0=1; }
        if(ig(abuf,1*12+8)==mm){ v1=1; }
        if(ig(abuf,2*12+8)==mm){ v2=1; }
      }
      emit("PF-B2 validity-miss ");
      if(v0==1 && v1==1 && v2==1){ emit("PASS\n"); } else { emit("FAIL WORLD-INVALID\n"); }
      emit("PF-B2 distinct="); e64(distinct); emit(" nonnull="); e64(nonnull); emit("\n");
      if(v0==1 && v1==1 && v2==1 && distinct==1 && nonnull==1){ barline("PF-B2",1); } else { barline("PF-B2",0); }
    } else {
      emit("PF-B2 PARAM/CHOICE ERROR\n");
      barline("PF-B2",0);
    }
  }
  if(spec.len>=4 && word_is(spec,0,4,"PFC1")==1){
    let bar:i32=cnt_ok(okbuf,2,3);
    let v01:i32=cnt_ok(okbuf,0,2);
    let v34:i32=cnt_ok(okbuf,3,5);
    emit("PF-C1 bar-probe "); e64(bar); emit("/1 ");
    emit("PF-C1 validity "); e64(v01); emit("/2 "); e64(v34); emit("/2 ");
    if(v01==2 && v34==2){ emit("PASS\n"); } else { emit("FAIL WORLD-INVALID\n"); }
    if(v01==2 && v34==2 && bar==1){ barline("PF-C1",1); } else { barline("PF-C1",0); }
  }
  if(spec.len>=4 && word_is(spec,0,4,"PFC2")==1){
    let bar2:i32=cnt_ok(okbuf,2,3);
    let bar3:i32=cnt_ok(okbuf,3,4);
    let v01:i32=cnt_ok(okbuf,0,2);
    let v45:i32=cnt_ok(okbuf,4,6);
    emit("PF-C2 revised "); e64(bar2); emit("/1 transfer "); e64(bar3); emit("/1 ");
    emit("PF-C2 validity "); e64(v01); emit("/2 "); e64(v45); emit("/2 ");
    if(v01==2 && v45==2){ emit("PASS\n"); } else { emit("FAIL WORLD-INVALID\n"); }
    if(v01==2 && v45==2 && bar2==1 && bar3==1){ barline("PF-C2",1); } else { barline("PF-C2",0); }
  }
  return 0;
}

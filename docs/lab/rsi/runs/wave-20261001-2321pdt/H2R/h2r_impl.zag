// ============ H2R learner implementation (PREREG_H2R.md section 4, frozen) ============
// Appended to a verbatim copy of the TNN3-SUBSTRATE prototype
// (substrate_proto.zag, commit a11dde4b9). The PKG block and the
// SUBSTRATE-HOOK lines are not modified by this file. Pure Zag.
//
// Learner-side cognition (h2_ prefix): h2_rgather, h2_author, h2_trial,
// h2_tombstone, h2_dump_ticket. No domain content: no world values, no
// relation ids, no answer values appear in the learner code. The guard
// slot is always the computed value 1000+g (g the trial loop variable);
// no nonzero slot code appears as a numeric literal in this file.
// Driver-side apparatus (h2r_ prefix): observation protocol, query loop,
// baseline, reporting. The observation protocol (given on slot 1, answer
// from slot 0) is frozen apparatus per PREREG_H2R section 4.4.

// --- observation protocol (frozen apparatus, PREREG_H2R 4.4) ---
fn H2R_GIVEN_SLOT()i32 { return 1; }
fn H2R_ANSWER_SLOT()i32 { return 0; }
fn H2R_MAXPATH()i32 { return 96; }
fn H2R_MAXDEPTH()i32 { return 5; }

// h2_rgather: reverse BFS from s over type-1 fact nodes.
// Mirrors t2_gather's structure with the traversal direction reversed:
// follow (subject, r, lastv) edges backward instead of (lastv, r, object)
// edges forward. The -999 relation exclusion is inherited from t2_gather.
// out: H2R_MAXPATH entries x 6 i32 (len, v0..v4). Returns path count.
fn h2_rgather(W:[]u8, s:i32, out:[]u8)i32 {
  let np:i32=0; let cap:i32=H2R_MAXPATH();
  set32(out,0,1); set32(out,4,s); np=1;
  let head:i32=0;
  while(head<np && np<cap){
    let base:i32=head*24;
    let len:i32=get32(out,base);
    if(len<H2R_MAXDEPTH()){
      let lastv:i32=get32(out,base+4+(len-1)*4);
      let n:i32=2;
      while(n<1024 && np<cap){
        if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,28)==lastv && ng(W,n,24)!=-999){
          let subj:i32=ng(W,n,20);
          let k:i32=0; let cyc:i32=0;
          while(k<len){
            if(get32(out,base+4+k*4)==subj){cyc=1;}
            k=k+1;
          }
          if(cyc==0){
            let nb:i32=np*24; let c2:i32=0;
            while(c2<6){ set32(out,nb+c2*4,get32(out,base+c2*4)); c2=c2+1; }
            set32(out,nb,len+1);
            set32(out,nb+4+len*4,subj);
            np=np+1;
          }
        }
        n=n+1;
      }
    }
    head=head+1;
  }
  return np;
}

// h2_author: one BUILD ticket for the path at paths[base] (length n)
// with guard orientation g. Returns the ticket id or -1.
// step0: BRANCHEQ, guard operand = frame-slot code for slot g (computed
// as 1000+g, never a numeric literal), literal = vals[0],
// true-target = back-reference -2 (the step1 cell, V1 convention).
// step_j (j>=1): SET writing slot 0 (protocol answer slot; overwrites).
fn h2_author(W:[]u8, paths:[]u8, base:i32, n:i32, g:i32, seq:i32)i32 {
  let t:i32=lb_ticket_new(W,9000+seq,-41);
  if(t<0){ return -1; }
  if(lb_step_add(W,t,102,1000+g,get32(paths,base+4),-2)<0){ return -1; }
  let j:i32=1;
  while(j<n){
    if(lb_step_add(W,t,101,1000,get32(paths,base+4+j*4),0)<0){ return -1; }
    j=j+1;
  }
  return t;
}

// h2_trial: the H2R learner miss policy (PREREG_H2R 4.3).
// fr: execution frame, pre-loaded per the observation protocol.
// masked=0: verify against expected (post-hoc feedback only, E-ruling).
// masked=1: accept the first cleanly executing candidate (informative).
// tick_out[0]: verifying ticket id, or -1. Returns answer or -2.
// Trial stats packed into hg(W,16) exactly as t2_trial does, so
// TRIAL_ENTERED = hg(W,16)/1024 is the executed-candidate count.
// `expected` is read only in the verify comparisons below; h2_rgather
// and h2_author never see it (K-C0A).
fn h2_trial(W:[]u8, s_q:i32, expected:i32, fr:i32, masked:i32, tick_out:[]u8)i32 {
  set32(tick_out,0,-1);
  let paths:[]u8=z_alloc(96*24);
  let np:i32=h2_rgather(W,s_q,paths);
  let tried:i32=0; let rejected:i32=0; let seq:i32=0;
  let ans:i32=-2;
  let L:i32=H2R_MAXDEPTH();
  while(L>=2 && ans==-2){
    let p:i32=0;
    while(p<np && ans==-2){
      let base:i32=p*24;
      if(get32(paths,base)==L){
        let g:i32=0;
        while(g<2 && ans==-2){
          let t:i32=h2_author(W,paths,base,L,g,seq);
          seq=seq+1;
          if(t<0){ rejected=rejected+1; }
          else {
            lb_run(W);
            if(ng(W,t,28)!=1){ rejected=rejected+1; }
            else {
              let root:i32=ng(W,t,32);
              fr_set(W,fr,0,0);
              fr_set(W,fr,H2R_GIVEN_SLOT(),s_q);
              fr_set(W,fr,2,0);
              let rc:i32=execute(W,root,fr);
              tried=tried+1;
              let a:i32=fr_get(W,fr,H2R_ANSWER_SLOT());
              if(masked==1){
                if(rc==1 && a!=-2 && a!=-999999){ ans=a; set32(tick_out,0,t); }
                else { rejected=rejected+1; }
              } else {
                if(rc==1 && a==expected && a!=-2 && a!=-999999){
                  ans=a; set32(tick_out,0,t);
                } else { rejected=rejected+1; }
              }
            }
          }
          g=g+1;
        }
      }
      p=p+1;
    }
    L=L-1;
  }
  hs(W,16,tried*1024+rejected);
  return ans;
}

// h2_tombstone: B4 ablation. Kill every cell of the built graph rooted at
// root: walk BRANCHEQ true-targets via field12 and other cells via SEQ,
// set each cell tag to 0 (execute then fails closed on it). Returns the
// number of cells killed.
fn h2_tombstone(W:[]u8, root:i32)i32 {
  let killed:i32=0;
  let cur:i32=root; let gd:i32=0; let done:i32=0;
  while(cur>=2 && gd<64 && done==0){
    let tag:i32=ng(W,cur,0);
    if(tag<101 || tag>104){ done=1; }
    else {
      let nx:i32=-1;
      if(tag==102){ nx=ng(W,cur,12); } else { nx=seq_nx(W,cur); }
      ns(W,cur,0,0);
      killed=killed+1;
      cur=nx; gd=gd+1;
    }
  }
  return killed;
}

// h2_dump_ticket: white-box dump of a built ticket (B3 audit support).
// Shows the inverse content lives in the ticket, not in source.
fn h2_dump_ticket(W:[]u8, t:i32)void {
  emit("TICKET id="); e64(t);
  emit(" status="); e64(ng(W,t,28));
  emit(" root="); e64(ng(W,t,32)); emit("\n");
  let cur:i32=ng(W,t,32); let gd:i32=0; let done:i32=0;
  while(cur>=2 && gd<64 && done==0){
    let tag:i32=ng(W,cur,0);
    if(tag<101 || tag>104){ done=1; }
    else {
      emit("  cell id="); e64(cur);
      emit(" tag="); e64(tag);
      emit(" f4="); e64(ng(W,cur,4));
      emit(" f8="); e64(ng(W,cur,8));
      emit(" f12="); e64(ng(W,cur,12));
      emit(" f16="); e64(ng(W,cur,16)); emit("\n");
      if(tag==102){ cur=ng(W,cur,12); } else { cur=seq_nx(W,cur); }
      gd=gd+1;
    }
  }
  return;
}

// ============ driver (apparatus; PREREG_H2R sections 4.4, 6, 7) ============
// World interface (defined by worlds_sealed.zag, or practice_worlds.zag
// for implementation testing):
//   h2r_nworlds()i32, h2r_world_facts(W,w)void, h2r_world_relation(w)i32,
//   h2r_world_nqueries(w)i32, h2r_world_query(w,q,out)void
//     (out[0]=given, out[1]=expected).

// One sealed query through the H2R learner. out: [correct, TRIAL_ENTERED,
// ticket_id, ablated_ok, masked_correct].
fn h2r_sealed_query(w:i32, q:i32, out:[]u8)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  h2r_world_facts(W,w);
  let qo:[]u8=z_alloc(8); h2r_world_query(w,q,qo);
  let given:i32=get32(qo,0); let expected:i32=get32(qo,4);
  let fr:i32=alloc_node(W); ns(W,fr,0,902);
  fr_set(W,fr,0,0); fr_set(W,fr,H2R_GIVEN_SLOT(),given); fr_set(W,fr,2,0);
  let tick:[]u8=z_alloc(4);
  let ans:i32=h2_trial(W,given,expected,fr,0,tick);
  let te:i32=hg(W,16)/1024;
  let correct:i32=0;
  if(ans==expected){ correct=1; }
  set32(out,0,correct); set32(out,4,te); set32(out,8,get32(tick,0));
  // B4 ablation: tombstone the verifying ticket's built cells, then
  // re-execute the dead root on the query frame. ablated_ok=1 means the
  // answer is gone (the advantage came from the cells).
  let ablok:i32=1;
  if(correct==1){
    let t:i32=get32(tick,0);
    let root:i32=ng(W,t,32);
    let nk:i32=h2_tombstone(W,root);
    if(nk<=0){ ablok=0; }
    else {
      fr_set(W,fr,0,0); fr_set(W,fr,H2R_GIVEN_SLOT(),given); fr_set(W,fr,2,0);
      let rc:i32=execute(W,root,fr);
      let a2:i32=fr_get(W,fr,H2R_ANSWER_SLOT());
      if(rc==1 && a2==expected){ ablok=0; }
    }
  }
  set32(out,12,ablok);
  // informative masked control: same trial, expected withheld
  let tickm:[]u8=z_alloc(4);
  let fr2:i32=alloc_node(W); ns(W,fr2,0,902);
  fr_set(W,fr2,0,0); fr_set(W,fr2,H2R_GIVEN_SLOT(),given); fr_set(W,fr2,2,0);
  let mans:i32=h2_trial(W,given,-2,fr2,1,tickm);
  let mcorrect:i32=0;
  if(mans==expected){ mcorrect=1; }
  set32(out,16,mcorrect);
  return;
}

// Frozen-path baseline for one query (no tickets authored anywhere).
fn h2r_baseline_query(w:i32, q:i32)i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  h2r_world_facts(W,w);
  let qo:[]u8=z_alloc(8); h2r_world_query(w,q,qo);
  let given:i32=get32(qo,0); let expected:i32=get32(qo,4);
  let Rq:i32=h2r_world_relation(w)+5000;
  let ans:i32=ev_query(W,given,Rq,expected,0);
  if(ans==expected){ return 1; }
  return 0;
}

fn h2r_main()i32 {
  emit("H2R-EVAL wave-20261001-2321pdt (PREREG_H2R frozen)\n");
  let b1:i32=dv_v1();
  emit("H2R-B1 dv_v1="); e64(b1); emit("\n");
  let nq:i32=0; let ncorrect:i32=0; let temin:i32=1000000;
  let nablok:i32=0; let nbase:i32=0; let nmasked:i32=0;
  let w:i32=0; let nw:i32=h2r_nworlds();
  while(w<nw){
    let q:i32=0; let nqq:i32=h2r_world_nqueries(w);
    while(q<nqq){
      let out:[]u8=z_alloc(20);
      h2r_sealed_query(w,q,out);
      let correct:i32=get32(out,0); let te:i32=get32(out,4);
      let tick:i32=get32(out,8); let ablok:i32=get32(out,12);
      let mcorrect:i32=get32(out,16);
      let bcorrect:i32=h2r_baseline_query(w,q);
      emit("Q w="); e64(w); emit(" q="); e64(q);
      emit(" correct="); e64(correct);
      emit(" TRIAL_ENTERED="); e64(te);
      emit(" ticket="); e64(tick);
      emit(" ablated_ok="); e64(ablok);
      emit(" masked="); e64(mcorrect);
      emit(" baseline="); e64(bcorrect); emit("\n");
      nq=nq+1; ncorrect=ncorrect+correct;
      if(te<temin){ temin=te; }
      nablok=nablok+ablok; nbase=nbase+bcorrect; nmasked=nmasked+mcorrect;
      q=q+1;
    }
    w=w+1;
  }
  emit("H2R-SUMMARY n="); e64(nq);
  emit(" correct="); e64(ncorrect);
  emit(" TRIAL_ENTERED_MIN="); e64(temin);
  emit(" ablated_ok="); e64(nablok);
  emit(" baseline="); e64(nbase);
  emit(" masked="); e64(nmasked); emit("\n");
  // B3 white-box: re-run the first query and dump the verifying ticket,
  // proving the inverse content lives in the ticket, not in source.
  let W3:[]u8=z_alloc(110656); tnn2_init(W3);
  h2r_world_facts(W3,0);
  let qo3:[]u8=z_alloc(8); h2r_world_query(0,0,qo3);
  let fr3:i32=alloc_node(W3); ns(W3,fr3,0,902);
  fr_set(W3,fr3,0,0);
  fr_set(W3,fr3,H2R_GIVEN_SLOT(),get32(qo3,0));
  fr_set(W3,fr3,2,0);
  let tick3:[]u8=z_alloc(4);
  let a3:i32=h2_trial(W3,get32(qo3,0),get32(qo3,4),fr3,0,tick3);
  if(a3==get32(qo3,4) && get32(tick3,0)>=0){
    emit("H2R-B3-WHITEBOX\n");
    h2_dump_ticket(W3,get32(tick3,0));
  }
  if(b1==1 && temin>0){ emit("H2R-EVAL-COMPLETE\n"); return 0; }
  emit("H2R-EVAL-PROTOCOL-FAIL\n");
  return 1;
}

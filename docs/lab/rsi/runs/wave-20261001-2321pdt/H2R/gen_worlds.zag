// gen_worlds.zag -- H2R sealed world generator (PREREG_H2R.md section 5.3).
// Pure Zag. Emits worlds_sealed.zag on stdout: 9 worlds (3 families x 3),
// 4 rules each, 36 hidden queries. Values drawn 1..999, distinct within
// each world, via LCG(1103515245,12345) mod 2^31 with the frozen seed.
// The seed is fixed here (post-prereg-freeze); one seed, one generation.
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn SEED()i32 { return 20261002; }
fn rng_next(st:[]u8)i32 {
  let s:i32=get32(st,0);
  s=((s*1103515245)+12345) & 0x7fffffff;
  set32(st,0,s);
  return s;
}
fn rng_range(st:[]u8, lo:i32, hi:i32)i32 {
  return lo+(rng_next(st)%(hi-lo+1));
}
// draw a value in lo..hi not present in used[0..nu)
fn rng_distinct(st:[]u8, used:[]u8, nu:i32, lo:i32, hi:i32)i32 {
  let done:i32=0; let v:i32=lo;
  while(done==0){
    v=rng_range(st,lo,hi);
    let k:i32=0; let dup:i32=0;
    while(k<nu){
      if(get32(used,k*4)==v){dup=1;}
      k=k+1;
    }
    if(dup==0){done=1;}
  }
  return v;
}
fn emitev(s:i32,r:i32,o:i32)void {
  emit("    ev_observe(W,"); e64(s); emit(",");
  e64(r); emit(","); e64(o); emit(");\n");
  return;
}
fn main()i32 {
  let st:[]u8=z_alloc(4); set32(st,0,SEED());
  let used:[]u8=z_alloc(21*4);
  let qs:[]u8=z_alloc(9*4*2*4);
  emit("// worlds_sealed.zag -- SEALED H2R worlds. Do not hand-edit.\n");
  emit("// Generated post-freeze by gen_worlds.zag, seed ");
  e64(SEED());
  emit(", LCG(1103515245,12345) mod 2^31. Values 1..999, distinct per world.\n");
  emit("// Families: w0-2 = A (2-hop), w3-5 = B (3-hop), w6-8 = C (2-hop+distractor).\n");
  emit("fn h2r_nworlds()i32 { return 9; }\n");
  emit("fn h2r_world_facts(W:[]u8, w:i32)void {\n");
  let w:i32=0;
  while(w<9){
    if(w>0){ emit("  else "); }
    emit("  if(w=="); e64(w); emit("){\n");
    let fam:i32=w/3;
    let R:i32=701+w;
    let nu:i32=0;
    let r:i32=0;
    while(r<4){
      let k:i32=rng_distinct(st,used,nu,1,999); set32(used,nu*4,k); nu=nu+1;
      let m:i32=rng_distinct(st,used,nu,1,999); set32(used,nu*4,m); nu=nu+1;
      if(fam==1){
        let m2:i32=rng_distinct(st,used,nu,1,999); set32(used,nu*4,m2); nu=nu+1;
        let a:i32=rng_distinct(st,used,nu,1,999); set32(used,nu*4,a); nu=nu+1;
        emitev(k,R,m); emitev(m,R,m2); emitev(m2,R,a);
        set32(qs,(w*4+r)*8,a); set32(qs,(w*4+r)*8+4,k);
      } else {
        let a:i32=rng_distinct(st,used,nu,1,999); set32(used,nu*4,a); nu=nu+1;
        emitev(k,R,m); emitev(m,R,a);
        if(fam==2){
          let d:i32=rng_distinct(st,used,nu,1,999); set32(used,nu*4,d); nu=nu+1;
          let e:i32=rng_distinct(st,used,nu,1,999); set32(used,nu*4,e); nu=nu+1;
          emitev(d,R,a); emitev(e,R,d);
        }
        set32(qs,(w*4+r)*8,a); set32(qs,(w*4+r)*8+4,k);
      }
      r=r+1;
    }
    emit("  }\n");
    w=w+1;
  }
  emit("  return;\n}\n");
  emit("fn h2r_world_relation(w:i32)i32 { return 701+w; }\n");
  emit("fn h2r_world_nqueries(w:i32)i32 { return 4; }\n");
  emit("fn h2r_world_query(w:i32, q:i32, out:[]u8)void {\n");
  w=0;
  while(w<9){
    if(w>0){ emit("  else "); }
    emit("  if(w=="); e64(w); emit("){\n");
    let q2:i32=0;
    while(q2<4){
      if(q2>0){ emit("    else "); }
      emit("    if(q=="); e64(q2); emit("){ set32(out,0,");
      e64(get32(qs,(w*4+q2)*8)); emit("); set32(out,4,");
      e64(get32(qs,(w*4+q2)*8+4)); emit("); }\n");
      q2=q2+1;
    }
    emit("  }\n");
    w=w+1;
  }
  emit("  return;\n}\n");
  emit("H2R-SEALED-WORLDS-EMITTED\n");
  return 0;
}

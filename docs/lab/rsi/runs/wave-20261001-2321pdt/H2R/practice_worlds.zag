// PRACTICE world for H2R implementation testing ONLY. Never scored.
// Hand-made, tiny family-A-like world. The sealed eval uses
// worlds_sealed.zag (generated post-freeze), never this file.
fn h2r_nworlds()i32 { return 1; }
fn h2r_world_facts(W:[]u8, w:i32)void {
  // rule 1: 11 -> 22 -> 33 ; rule 2: 44 -> 55 -> 66 ; R = 701
  ev_observe(W,11,701,22); ev_observe(W,22,701,33);
  ev_observe(W,44,701,55); ev_observe(W,55,701,66);
  return;
}
fn h2r_world_relation(w:i32)i32 { return 701; }
fn h2r_world_nqueries(w:i32)i32 { return 2; }
fn h2r_world_query(w:i32, q:i32, out:[]u8)void {
  if(q==0){ set32(out,0,33); set32(out,4,11); }
  else { set32(out,0,66); set32(out,4,44); }
  return;
}

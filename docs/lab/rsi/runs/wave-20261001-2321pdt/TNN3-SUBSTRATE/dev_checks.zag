// ============ TNN3-SUBSTRATE dev verification checks (harness only, not substrate) ============
// The dev driver authors tickets below explicitly as a stand-in for future
// learner-side authoring. What these checks verify is the SERVICE
// (reachability, fidelity, content-neutrality), the trigger, and standing,
// never learner authorship. L3 authorship is the re-attempts' burden.
fn dv_rederive_count(W:[]u8)i32 {
  let br:i32=ng(W,0,24);
  if(br<2 || ng(W,br,36)!=1){return 0;}
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==br && eg(W,e,4)==10){
      let t:i32=eg(W,e,8);
      if(ng(W,t,36)==1 && ng(W,t,0)==904 && ng(W,t,24)==-43){c=c+1;}
    }
    e=e+1;
  }
  return c;
}
fn dv_find_rederive(W:[]u8)i32 {
  let br:i32=ng(W,0,24);
  if(br<2 || ng(W,br,36)!=1){return -1;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==br && eg(W,e,4)==10){
      let t:i32=eg(W,e,8);
      if(ng(W,t,36)==1 && ng(W,t,0)==904 && ng(W,t,24)==-43){return t;}
    }
    e=e+1;
  }
  return -1;
}
// V1: construction reachable through the event interface, content-neutral.
// Ticket 1 is inverted vs the assemblers (guard on slot 1, not slot 0).
// Ticket 2 is assembler-shaped (slot 0). One service builds both.
fn dv_v1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let t:i32=lb_ticket_new(W,777,-41);
  if(t<0){emit("V1 ticket alloc fail\n"); return 0;}
  if(lb_step_add(W,t,102,1001,5,-2)<0){emit("V1 step0 fail\n"); return 0;}
  if(lb_step_add(W,t,101,1002,7,0)<0){emit("V1 step1 fail\n"); return 0;}
  if(lb_step_add(W,t,101,1000,9,0)<0){emit("V1 step2 fail\n"); return 0;}
  let t2:i32=lb_ticket_new(W,778,-41);
  if(t2<0){emit("V1 ticket2 alloc fail\n"); return 0;}
  if(lb_step_add(W,t2,102,1000,5,-2)<0){emit("V1 t2 step0 fail\n"); return 0;}
  if(lb_step_add(W,t2,101,1000,7,0)<0){emit("V1 t2 step1 fail\n"); return 0;}
  ev_observe(W,9001,90,1);
  if(ng(W,t,28)!=1){emit("V1 ticket not built\n"); return 0;}
  if(ng(W,t2,28)!=1){emit("V1 ticket2 not built\n"); return 0;}
  let root:i32=ng(W,t,32);
  if(root<2){emit("V1 no root\n"); return 0;}
  if(ng(W,root,0)!=102 || ng(W,root,4)!=1001){emit("V1 cell0 content mismatch\n"); return 0;}
  let c1:i32=seq_nx(W,root);
  if(c1<0 || ng(W,c1,0)!=101){emit("V1 cell1 missing\n"); return 0;}
  let lit:i32=ng(W,c1,8);
  if(lit<0 || ng(W,lit,0)!=902 || ng(W,lit,20)!=7){emit("V1 lit7 mismatch\n"); return 0;}
  if(ng(W,root,12)!=c1){emit("V1 f12 not wired\n"); return 0;}
  let root2:i32=ng(W,t2,32);
  if(root2<2 || ng(W,root2,0)!=102 || ng(W,root2,4)!=1000){emit("V1 ticket2 content mismatch\n"); return 0;}
  let fr:i32=alloc_node(W); ns(W,fr,0,902);
  fr_set(W,fr,0,0); fr_set(W,fr,1,5); fr_set(W,fr,2,0);
  if(execute(W,root,fr)!=1){emit("V1 exec true-branch fail\n"); return 0;}
  if(fr_get(W,fr,2)!=7){emit("V1 true-branch value wrong\n"); return 0;}
  if(fr_get(W,fr,0)!=9){emit("V1 spine fallthrough wrong\n"); return 0;}
  fr_set(W,fr,0,0); fr_set(W,fr,1,6); fr_set(W,fr,2,0);
  if(execute(W,root,fr)!=-999999){emit("V1 exec false-branch not fail-closed\n"); return 0;}
  emit("V1-PASS construction reachable and content-neutral\n");
  return 1;
}
// V2: contradiction fires exactly one generic REDERIVE ticket; confirm and
// teach fire none.
fn dv_v2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let n1:i32=ev_teach(W,101,11,102);
  if(dv_rederive_count(W)!=0){emit("V2 nonzero baseline\n"); return 0;}
  if(ev_observe(W,101,11,999)!=0){emit("V2 observe did not contradict\n"); return 0;}
  if(dv_rederive_count(W)!=1){emit("V2 trigger did not fire\n"); return 0;}
  let t:i32=dv_find_rederive(W);
  if(t<0){emit("V2 ticket not found\n"); return 0;}
  let nn:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==101 && ng(W,n,24)==11 && ng(W,n,28)==999){nn=n;}
    n=n+1;
  }
  if(nn<0){emit("V2 new fact missing\n"); return 0;}
  let so:i32=0; let sn:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==t && eg(W,e,4)==4){
      if(eg(W,e,8)==n1){so=1;}
      if(eg(W,e,8)==nn){sn=1;}
    }
    e=e+1;
  }
  if(so==0 || sn==0){emit("V2 ticket links wrong\n"); return 0;}
  ev_observe(W,101,11,999);
  if(dv_rederive_count(W)!=1){emit("V2 spurious trigger on confirm\n"); return 0;}
  ev_observe(W,202,22,5);
  if(dv_rederive_count(W)!=1){emit("V2 spurious trigger on teach\n"); return 0;}
  emit("V2-PASS contradiction trigger fires generically\n");
  return 1;
}
// V3: standing accumulates on generic events, persists across queries,
// and lbid is cold-start identical to bid.
fn dv_v3()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let n:i32=ev_teach(W,301,31,1);
  ev_observe(W,301,31,1); ev_observe(W,301,31,1); ev_observe(W,301,31,1);
  if(ls_read(W,n)!=3){emit("V3 confirm accumulation wrong\n"); return 0;}
  ev_observe(W,301,31,2);
  if(ls_read(W,n)!=2){emit("V3 contradict decrement wrong\n"); return 0;}
  let nf:i32=-1; let x:i32=2;
  while(x<1024){
    if(ng(W,x,36)==1 && ng(W,x,0)==1 && ng(W,x,20)==301 && ng(W,x,24)==31 && ng(W,x,28)==2){nf=x;}
    x=x+1;
  }
  if(nf<0){emit("V3 new fact missing\n"); return 0;}
  ev_observe(W,301,31,2);
  if(ls_read(W,nf)!=1){emit("V3 new-fact confirm wrong\n"); return 0;}
  let q:i32=0;
  while(q<5){
    if(ev_query(W,301,31,-2,0)!=2){emit("V3 query answer moved\n"); return 0;}
    q=q+1;
  }
  if(ls_read(W,n)!=2 || ls_read(W,nf)!=1){emit("V3 standing not persistent\n"); return 0;}
  if(ng(W,0,28)<2){emit("V3 stand root missing\n"); return 0;}
  if(lbid(W,n)!=2){emit("V3 lbid not reading standing\n"); return 0;}
  let m:i32=ev_teach(W,302,32,9);
  if(lbid(W,m)!=bid(W,m)){emit("V3 cold lbid != bid\n"); return 0;}
  emit("V3-PASS standing persists across queries\n");
  return 1;
}
fn proto_main()i32 {
  emit("PROTO-REGRESSION run_all:\n");
  if(run_all()!=0){emit("PROTO-REGRESSION FAIL\n"); return 1;}
  emit("PROTO-REGRESSION PASS\n");
  let ok:i32=1;
  if(dv_v1()==0){ok=0;}
  if(dv_v2()==0){ok=0;}
  if(dv_v3()==0){ok=0;}
  if(ok==1){emit("SUBSTRATE-VERIFY ALL-PASS\n"); return 0;}
  emit("SUBSTRATE-VERIFY FAIL\n"); return 1;
}

// bufapply.zag - frozen-rule applier for F1-BUFFER sealed test.
// Implements EXACTLY PREREG_BUFFER.md section 3: predict OVERFIT iff
// T(B) >= 12, where T(B) = S0(B) + S1(B) over the first-trigger buffer.
// usage: bufapply <labeled_table>
// Table lines: SEED <i> <OVERFIT|CORRECT> S0=<n> S1=<n> N=<n> TRIG=<n>
// Prints per-seed predictions and the contingency table with the
// misclassification count. The threshold 12 and direction (ge) are
// hardcoded to match the frozen prereg; they must not be changed.
// Pure Zag, compiled by the pinned znc.

fn ba_alloc(n:i64)[]u8 {
    if(n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn ba_ig(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn ba_is(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

fn ba_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn ba_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn ba_after_eq(tok:[]u8)i64 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return 0; }
    return _zag_str_to_i64(tok[p+1..tok.len]);
}

// Frozen rule constants (PREREG_BUFFER.md section 3).
fn FROZEN_K()i64 { return 12; }

fn main()i32 {
    if(_zag_argc() < 2) { _zag_println("usage: bufapply <labeled_table>"); return 2; }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { _zag_println("ERR read"); return 2; }

    let og:i64 = 0;
    let cg:i64 = 0;
    let ol:i64 = 0;
    let cl:i64 = 0;
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < text.len) {
        let q:i64 = p;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p..q];
        if(q < text.len) { q = q + 1; }
        p = q;
        if(ba_ntok(line) >= 7) {
            if(_zag_strcmp(ba_tok(line, 0), "SEED") == 1) {
                let seed:[]u8 = ba_tok(line, 1);
                let lab:[]u8 = ba_tok(line, 2);
                let s0:i64 = ba_after_eq(ba_tok(line, 3));
                let s1:i64 = ba_after_eq(ba_tok(line, 4));
                let t:i64 = s0 + s1;
                let truth_ovf:i64 = 0;
                if(_zag_strcmp(lab, "OVERFIT") == 1) { truth_ovf = 1; }
                let pred_ovf:i64 = 0;
                if(t >= FROZEN_K()) { pred_ovf = 1; }
                _zag_print("PRED ");
                _zag_print(seed);
                _zag_print(" ");
                if(pred_ovf == 1) { _zag_print("OVERFIT"); } else { _zag_print("CORRECT"); }
                _zag_print(" truth=");
                _zag_print(lab);
                _zag_print(" T=");
                _zag_println(_zag_i64_to_str(t));
                if(pred_ovf == 1 && truth_ovf == 1) { og = og + 1; }
                if(pred_ovf == 1 && truth_ovf == 0) { cg = cg + 1; }
                if(pred_ovf == 0 && truth_ovf == 1) { ol = ol + 1; }
                if(pred_ovf == 0 && truth_ovf == 0) { cl = cl + 1; }
                n = n + 1;
            }
        }
    }
    _zag_print("CELLS ovf_ge=");
    _zag_print(_zag_i64_to_str(og));
    _zag_print(" cor_ge=");
    _zag_print(_zag_i64_to_str(cg));
    _zag_print(" ovf_lt=");
    _zag_print(_zag_i64_to_str(ol));
    _zag_print(" cor_lt=");
    _zag_print(_zag_i64_to_str(cl));
    _zag_println("");
    _zag_print("MISC ");
    _zag_println(_zag_i64_to_str(cg + ol));
    _zag_print("N ");
    _zag_println(_zag_i64_to_str(n));
    return 0;
}

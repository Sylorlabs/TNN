// bufsep.zag - single-feature separation analysis for F1-BUFFER calibration.
// Implements the frozen candidate-rule search of the F1-BUFFER prereg on
// TRAINING data (5100-series, already sealed/run by F1-FOLLOWUP).
// usage: bufsep <labeled_table>
// Table lines: SEED <i> <OVERFIT|CORRECT> S0=<n> S1=<n> N=<n> TRIG=<n>
// Features evaluated: S0, S1, D=|S0-S1|, T=S0+S1, M=min(S0,S1), N, TRIG,
// and R=D/T (imbalance ratio, thresholds compared by cross-multiplication).
// For each feature reports the best single-threshold separation in both
// directions (predict OVERFIT when val >= k, and when val <= k): the
// threshold k with minimum total misclassified seeds, the misc count, and
// the contingency cells (ovf_ge cor_ge ovf_lt cor_lt).
// Pure Zag, compiled by the pinned znc.

fn bs_alloc(n:i64)[]u8 {
    if(n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn bs_ig(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn bs_is(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

fn bs_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn bs_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn bs_after_eq(tok:[]u8)i64 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return 0; }
    return _zag_str_to_i64(tok[p+1..tok.len]);
}

fn bs_labs(v:i64)i64 {
    if(v < 0) { return 0 - v; }
    return v;
}

fn bs_min(a:i64, b:i64)i64 {
    if(a < b) { return a; }
    return b;
}

// ratio ge: (ds,ts) >= (dk,tk) with 0/0 treated as 0.
fn bs_rge(ds:i64, ts:i64, dk:i64, tk:i64)i64 {
    if(tk == 0) { return 1; }
    if(ts == 0) {
        if(dk == 0) { return 1; }
        return 0;
    }
    if(ds * tk >= dk * ts) { return 1; }
    return 0;
}

fn main()i32 {
    if(_zag_argc() < 2) { _zag_println("usage: bufsep <labeled_table>"); return 2; }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { _zag_println("ERR read"); return 2; }

    let cls:[]u8 = bs_alloc(64 * 8);
    let s0:[]u8 = bs_alloc(64 * 8);
    let s1:[]u8 = bs_alloc(64 * 8);
    let nn:[]u8 = bs_alloc(64 * 8);
    let tg:[]u8 = bs_alloc(64 * 8);
    let n:i64 = 0;
    let novf:i64 = 0;
    let ncor:i64 = 0;
    let p:i64 = 0;
    while(p < text.len) {
        let q:i64 = p;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p..q];
        if(q < text.len) { q = q + 1; }
        p = q;
        if(bs_ntok(line) >= 7) {
            if(_zag_strcmp(bs_tok(line, 0), "SEED") == 1) {
                let c:[]u8 = bs_tok(line, 2);
                let cv:i64 = 0;
                if(_zag_strcmp(c, "OVERFIT") == 1) { cv = 1; novf = novf + 1; }
                else { ncor = ncor + 1; }
                bs_is(cls, n, cv);
                bs_is(s0, n, bs_after_eq(bs_tok(line, 3)));
                bs_is(s1, n, bs_after_eq(bs_tok(line, 4)));
                bs_is(nn, n, bs_after_eq(bs_tok(line, 5)));
                bs_is(tg, n, bs_after_eq(bs_tok(line, 6)));
                n = n + 1;
            }
        }
    }

    _zag_print("N "); _zag_println(_zag_i64_to_str(n));
    _zag_print("OVERFIT "); _zag_println(_zag_i64_to_str(novf));
    _zag_print("CORRECT "); _zag_println(_zag_i64_to_str(ncor));

    // integer features: 0 S0, 1 S1, 2 D, 3 T, 4 M, 5 N, 6 TRIG
    let names:[]u8 = bs_alloc(7 * 8);
    // names stored as packed first-4 chars for printing via table below
    let f:i64 = 0;
    while(f < 7) {
        let dv:[]u8 = bs_alloc(64 * 8);
        let ndv:i64 = 0;
        let i:i64 = 0;
        while(i < n) {
            let a:i64 = bs_ig(s0, i);
            let b:i64 = bs_ig(s1, i);
            let v:i64 = 0;
            if(f == 0) { v = a; }
            else if(f == 1) { v = b; }
            else if(f == 2) { v = bs_labs(a - b); }
            else if(f == 3) { v = a + b; }
            else if(f == 4) { v = bs_min(a, b); }
            else if(f == 5) { v = bs_ig(nn, i); }
            else { v = bs_ig(tg, i); }
            let j:i64 = 0;
            let seen:i64 = 0;
            while(j < ndv) {
                if(bs_ig(dv, j) == v) { seen = 1; }
                j = j + 1;
            }
            if(seen == 0) { bs_is(dv, ndv, v); ndv = ndv + 1; }
            i = i + 1;
        }
        let best_ge:i64 = 1000000;
        let bestk_ge:i64 = 0;
        let bg_og:i64 = 0; let bg_cg:i64 = 0; let bg_ol:i64 = 0; let bg_cl:i64 = 0;
        let best_le:i64 = 1000000;
        let bestk_le:i64 = 0;
        let bl_og:i64 = 0; let bl_cg:i64 = 0; let bl_ol:i64 = 0; let bl_cl:i64 = 0;
        let t:i64 = 0;
        while(t < ndv) {
            let k:i64 = bs_ig(dv, t);
            let og:i64 = 0; let cg:i64 = 0; let ol:i64 = 0; let cl:i64 = 0;
            i = 0;
            while(i < n) {
                let a:i64 = bs_ig(s0, i);
                let b:i64 = bs_ig(s1, i);
                let v:i64 = 0;
                if(f == 0) { v = a; }
                else if(f == 1) { v = b; }
                else if(f == 2) { v = bs_labs(a - b); }
                else if(f == 3) { v = a + b; }
                else if(f == 4) { v = bs_min(a, b); }
                else if(f == 5) { v = bs_ig(nn, i); }
                else { v = bs_ig(tg, i); }
                let c:i64 = bs_ig(cls, i);
                if(v >= k) {
                    if(c == 1) { og = og + 1; } else { cg = cg + 1; }
                } else {
                    if(c == 1) { ol = ol + 1; } else { cl = cl + 1; }
                }
                i = i + 1;
            }
            if(ol + cg < best_ge) {
                best_ge = ol + cg; bestk_ge = k;
                bg_og = og; bg_cg = cg; bg_ol = ol; bg_cl = cl;
            }
            if(og + cl < best_le) {
                best_le = og + cl; bestk_le = k;
                bl_og = og; bl_cg = cg; bl_ol = ol; bl_cl = cl;
            }
            t = t + 1;
        }
        let nm:[]u8 = "?";
        if(f == 0) { nm = "S0"; }
        else if(f == 1) { nm = "S1"; }
        else if(f == 2) { nm = "D"; }
        else if(f == 3) { nm = "T"; }
        else if(f == 4) { nm = "M"; }
        else if(f == 5) { nm = "N"; }
        else { nm = "TRIG"; }
        _zag_print("SEP "); _zag_print(nm);
        _zag_print(" ge k="); _zag_print(_zag_i64_to_str(bestk_ge));
        _zag_print(" misc="); _zag_print(_zag_i64_to_str(best_ge));
        _zag_print(" cells=");
        _zag_print(_zag_i64_to_str(bg_og)); _zag_print("/");
        _zag_print(_zag_i64_to_str(bg_cg)); _zag_print("/");
        _zag_print(_zag_i64_to_str(bg_ol)); _zag_print("/");
        _zag_println(_zag_i64_to_str(bg_cl));
        _zag_print("SEP "); _zag_print(nm);
        _zag_print(" le k="); _zag_print(_zag_i64_to_str(bestk_le));
        _zag_print(" misc="); _zag_print(_zag_i64_to_str(best_le));
        _zag_print(" cells=");
        _zag_print(_zag_i64_to_str(bl_og)); _zag_print("/");
        _zag_print(_zag_i64_to_str(bl_cg)); _zag_print("/");
        _zag_print(_zag_i64_to_str(bl_ol)); _zag_print("/");
        _zag_println(_zag_i64_to_str(bl_cl));
        f = f + 1;
    }

    // ratio feature R = D/T; candidate thresholds are the distinct (D,T) pairs
    let kv_d:[]u8 = bs_alloc(64 * 8);
    let kv_t:[]u8 = bs_alloc(64 * 8);
    let nkv:i64 = 0;
    let i:i64 = 0;
    while(i < n) {
        let d:i64 = bs_labs(bs_ig(s0, i) - bs_ig(s1, i));
        let t:i64 = bs_ig(s0, i) + bs_ig(s1, i);
        let j:i64 = 0;
        let seen:i64 = 0;
        while(j < nkv) {
            if(bs_ig(kv_d, j) == d && bs_ig(kv_t, j) == t) { seen = 1; }
            j = j + 1;
        }
        if(seen == 0) { bs_is(kv_d, nkv, d); bs_is(kv_t, nkv, t); nkv = nkv + 1; }
        i = i + 1;
    }
    let r_best_ge:i64 = 1000000;
    let r_bkd:i64 = 0; let r_bkt:i64 = 1;
    let r_bg_og:i64 = 0; let r_bg_cg:i64 = 0; let r_bg_ol:i64 = 0; let r_bg_cl:i64 = 0;
    let r_best_le:i64 = 1000000;
    let r_blk_d:i64 = 0; let r_blk_t:i64 = 1;
    let r_bl_og:i64 = 0; let r_bl_cg:i64 = 0; let r_bl_ol:i64 = 0; let r_bl_cl:i64 = 0;
    let t2:i64 = 0;
    while(t2 < nkv) {
        let kd:i64 = bs_ig(kv_d, t2);
        let kt:i64 = bs_ig(kv_t, t2);
        let og:i64 = 0; let cg:i64 = 0; let ol:i64 = 0; let cl:i64 = 0;
        i = 0;
        while(i < n) {
            let d:i64 = bs_labs(bs_ig(s0, i) - bs_ig(s1, i));
            let tt:i64 = bs_ig(s0, i) + bs_ig(s1, i);
            let c:i64 = bs_ig(cls, i);
            if(bs_rge(d, tt, kd, kt) == 1) {
                if(c == 1) { og = og + 1; } else { cg = cg + 1; }
            } else {
                if(c == 1) { ol = ol + 1; } else { cl = cl + 1; }
            }
            i = i + 1;
        }
        if(ol + cg < r_best_ge) {
            r_best_ge = ol + cg; r_bkd = kd; r_bkt = kt;
            r_bg_og = og; r_bg_cg = cg; r_bg_ol = ol; r_bg_cl = cl;
        }
        if(og + cl < r_best_le) {
            r_best_le = og + cl; r_blk_d = kd; r_blk_t = kt;
            r_bl_og = og; r_bl_cg = cg; r_bl_ol = ol; r_bl_cl = cl;
        }
        t2 = t2 + 1;
    }
    _zag_print("SEP R ge k=");
    _zag_print(_zag_i64_to_str(r_bkd)); _zag_print("/");
    _zag_print(_zag_i64_to_str(r_bkt));
    _zag_print(" misc="); _zag_print(_zag_i64_to_str(r_best_ge));
    _zag_print(" cells=");
    _zag_print(_zag_i64_to_str(r_bg_og)); _zag_print("/");
    _zag_print(_zag_i64_to_str(r_bg_cg)); _zag_print("/");
    _zag_print(_zag_i64_to_str(r_bg_ol)); _zag_print("/");
    _zag_println(_zag_i64_to_str(r_bg_cl));
    _zag_print("SEP R le k=");
    _zag_print(_zag_i64_to_str(r_blk_d)); _zag_print("/");
    _zag_print(_zag_i64_to_str(r_blk_t));
    _zag_print(" misc="); _zag_print(_zag_i64_to_str(r_best_le));
    _zag_print(" cells=");
    _zag_print(_zag_i64_to_str(r_bl_og)); _zag_print("/");
    _zag_print(_zag_i64_to_str(r_bl_cg)); _zag_print("/");
    _zag_print(_zag_i64_to_str(r_bl_ol)); _zag_print("/");
    _zag_println(_zag_i64_to_str(r_bl_cl));
    return 0;
}

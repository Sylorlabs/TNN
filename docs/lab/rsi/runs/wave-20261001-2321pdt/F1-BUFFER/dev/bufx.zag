// bufx.zag - first-trigger buffer feature extractor (F1-BUFFER lane).
// Reads one f1_learn train trace and reports the contents of the learner's
// BUFN trial buffer at the moment the FIRST trigger fired.
// usage: bufx <train.trace>
// Output (one line):
//   BUF trig=<t> n=<n> S0=<s0> S1=<s1> c1=<op>,<p2>,<p3> c2=<op>,<p2>,<p3>
// where t is the episode index of the first TRIGGER line, n is the number
// of buffer episodes (EP lines with index 0..t; every train episode carries
// truth so the buffer holds exactly episodes 0..t), S0/S1 are the sums of
// x0/x1 over those episodes, and c1/c2 are the op,p2,p3 of the first two
// CONSTRUCT events (behavior bookkeeping, not part of the frozen rule).
// If no TRIGGER line exists: BUF NOTRIG.
// Pure Zag, compiled by the pinned znc.

fn bx_alloc(n:i64)[]u8 {
    if(n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn bx_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn bx_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn bx_starts(line:[]u8, pre:[]u8)i64 {
    if(line.len < pre.len) { return 0; }
    let i:i64 = 0;
    while(i < pre.len) {
        if(line[i] != pre[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn bx_after_eq(tok:[]u8)i64 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return 0; }
    return _zag_str_to_i64(tok[p+1..tok.len]);
}

fn bx_after_eq_s(tok:[]u8)[]u8 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return ""; }
    return tok[p+1..tok.len];
}

fn main()i32 {
    if(_zag_argc() < 2) { _zag_println("usage: bufx <train.trace>"); return 2; }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { _zag_println("ERR read"); return 2; }

    // Pass 1: find the first TRIGGER line and its episode index.
    let trig:i64 = -1;
    let p:i64 = 0;
    while(p < text.len && trig < 0) {
        let q:i64 = p;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p..q];
        if(q < text.len) { q = q + 1; }
        p = q;
        if(bx_starts(line, "TRIGGER ") == 1 && bx_ntok(line) >= 2) {
            trig = _zag_str_to_i64(bx_tok(line, 1));
        }
    }
    if(trig < 0) { _zag_println("BUF NOTRIG"); return 0; }

    // Pass 2: sum x0/x1 over EP lines with episode index 0..trig;
    // record the first two CONSTRUCT events' op,p2,p3.
    let s0:i64 = 0;
    let s1:i64 = 0;
    let n:i64 = 0;
    let c1op:[]u8 = "-";
    let c1p2:i64 = -1;
    let c1p3:i64 = -1;
    let c2op:[]u8 = "-";
    let c2p2:i64 = -1;
    let c2p3:i64 = -1;
    let ncon:i64 = 0;
    p = 0;
    while(p < text.len) {
        let q:i64 = p;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p..q];
        if(q < text.len) { q = q + 1; }
        p = q;
        if(bx_starts(line, "EP ") == 1 && bx_ntok(line) >= 4) {
            let ep:i64 = _zag_str_to_i64(bx_tok(line, 1));
            if(ep >= 0 && ep <= trig) {
                s0 = s0 + bx_after_eq(bx_tok(line, 2));
                s1 = s1 + bx_after_eq(bx_tok(line, 3));
                n = n + 1;
            }
        } else if(bx_starts(line, "CONSTRUCT ") == 1 && bx_ntok(line) >= 9) {
            let op:[]u8 = bx_after_eq_s(bx_tok(line, 5));
            let p2:i64 = bx_after_eq(bx_tok(line, 7));
            let p3:i64 = bx_after_eq(bx_tok(line, 8));
            if(ncon == 0) { c1op = op; c1p2 = p2; c1p3 = p3; }
            if(ncon == 1) { c2op = op; c2p2 = p2; c2p3 = p3; }
            ncon = ncon + 1;
        }
    }

    _zag_print("BUF trig=");
    _zag_print(_zag_i64_to_str(trig));
    _zag_print(" n=");
    _zag_print(_zag_i64_to_str(n));
    _zag_print(" S0=");
    _zag_print(_zag_i64_to_str(s0));
    _zag_print(" S1=");
    _zag_print(_zag_i64_to_str(s1));
    _zag_print(" c1=");
    _zag_print(c1op);
    _zag_print(",");
    _zag_print(_zag_i64_to_str(c1p2));
    _zag_print(",");
    _zag_print(_zag_i64_to_str(c1p3));
    _zag_print(" c2=");
    _zag_print(c2op);
    _zag_print(",");
    _zag_print(_zag_i64_to_str(c2p2));
    _zag_print(",");
    _zag_println(_zag_i64_to_str(c2p3));
    return 0;
}

// ow_driver.zag -- CONTLEARN-OWNED machinery-disabled discrimination driver
// (wave-20261001-2321pdt, lane CONTLEARN-OWNED)
// Phase-2 implementation for frozen prereg PREREG_OWNED.md.
//
// FIXTURE ONLY. This file defines 0 cognition functions (no learning,
// retrieval, inference, retention, eviction, planning, derivation, revision,
// or execution logic), 0 new node tags, 0 new edge types, 0 new opcodes,
// 0 modes, 0 bridges, 0 routers, 0 task-specific handlers, 0 semantic cases.
// It emits the frozen 104-event script from PREREG_OWNED.md section 4, calls
// the event API (ev_teach/ev_query), runs read-only white-box censuses
// through the core's own accessors (ng/eg/activate/is_superseded), and
// prints results. No branching-on-opcode statements anywhere in this file.
//
// Link: concatenated after ow_core_control.zag (unmodified frozen core,
// CONTROL runs) or ow_core_disabled.zag (machinery-disabled variant, TREAT
// runs); both are nomain derivations of the frozen TNN-2 core. All names
// here are ow_ prefixed; the frozen source contains zero ow_ occurrences,
// so nothing collides and nothing is redefined.
//
// Run selection arrives on stdin (TREAT or CONTROL; driver-side label only,
// never reaches cognition); argv is empty and the env is empty at launch.
// PHASE markers are driver-side prints; cognition receives only
// (kind, subject, relation, object) integer tuples through the choke points
// ow_event / ow_mquery. ow_mquery passes the frozen supervisor-disconnect
// parameters expected=-2, flags=1 (masked query, disclosed in the prereg);
// this carries no task identity and is not a task label.

// ============ small fixture helpers ============
fn ow_streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
// FNV-1a over the full arena (signed i32 wrap; determinism is what matters).
fn ow_fnv(W:[]u8)i32 {
  let h:i32=-2128831035;
  let i:i32=0;
  while(i<110656){ h=(h ^ (W[i] as i32))*16777619; i=i+1; }
  return h;
}
fn ow_count_nodes(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
// miss_inquire guide signature: tag==1, alive, field20==30, field24==-999.
fn ow_count_guides(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-999){c=c+1;}
    n=n+1;
  }
  return c;
}
fn ow_count_edges(W:[]u8,ty:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1 && eg(W,e,4)==ty){c=c+1;} e=e+1; }
  return c;
}
fn ow_count_edges_all(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
// content-identified lookup: first alive tag-1 node holding (s,r,o).
fn ow_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// content-identified lookup: first alive tag-20 MAP with (field8=s, field4=r).
fn ow_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
// alive DEP edge from->to exists (dead slots carry from=-1, so this is exact).
fn ow_has_dep(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==1 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
// ============ cognition choke points (K1c audit) ============
// Every tuple the driver passes to cognition flows through one of these two.
// kind: 1=TEACH, 2=QUERY, 3=OBSERVE. Header field 52 (unused by the frozen
// core) counts audited events.
fn ow_event(W:[]u8,kind:i32,s:i32,r:i32,o:i32)i32 {
  if(kind<1 || kind>3){ emit("AUDIT_FAIL kind="); e64(kind); emit("\n"); return -999; }
  emit("EV "); e64(kind); emit(" "); e64(s); emit(" "); e64(r); emit(" "); e64(o);
  hs(W,52,hg(W,52)+1);
  if(kind==1){ let q:i32=ev_teach(W,s,r,o); emit("\n"); return q; }
  let v:i32=ev_observe(W,s,r,o); emit(" rv="); e64(v); emit("\n"); return v;
}
// Masked query: supervisor disconnected. Frozen parameters expected=-2,
// flags=1. Disclosed in the prereg; not a task label.
fn ow_mquery(W:[]u8,s:i32,r:i32)i32 {
  emit("EV 2 "); e64(s); emit(" "); e64(r); emit(" -2 MK");
  hs(W,52,hg(W,52)+1);
  let a:i32=ev_query(W,s,r,-2,1);
  emit(" ans="); e64(a); emit("\n");
  return a;
}
// ============ frozen phases (exact tuples from prereg section 4) ============
// STORE: 30 events. store_ans is a 6-slot i32 buf for the family-D answers.
fn ow_store(W:[]u8,store_ans:[]u8)void {
  emit("PHASE STORE\n");
  let i:i32=0;
  while(i<6){ ow_event(W,1,9001+i,501,9101+i); i=i+1; }
  i=0;
  while(i<6){ ow_event(W,1,9501+i,701,9001+i); i=i+1; }
  i=0;
  while(i<6){ set32(store_ans,i*4,ow_mquery(W,9501+i,702)); i=i+1; }
  i=0;
  while(i<6){ ow_event(W,1,9601+i,801,9701+i); i=i+1; }
  return;
}
// STORE_OK: 6/6 MAPs promoted with alive DEP edges to licensing facts.
fn ow_store_ok(W:[]u8,store_ans:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<6){
    let m:i32=ow_find_map(W,9501+i,702);
    let f:i32=ow_find_fact(W,9001+i,501,9101+i);
    if(m>=0 && f>=0 && ow_has_dep(W,m,f)==1 && get32(store_ans,i*4)==9101+i){c=c+1;}
    else { emit("STORE_MISS D "); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("OW_STOREOK "); e64(c); emit("/6\n");
  return c;
}
// serving-node check: activate's node must be the content-expected live fact.
fn ow_serve_ok(W:[]u8,s:i32,r:i32,exp:i32,got:i32)i32 {
  if(got!=exp){return 0;}
  let n:i32=activate(W,s,r);
  if(n<2){return 0;}
  if(ng(W,n,36)!=1 || ng(W,n,0)!=1){return 0;}
  if(ng(W,n,20)!=s || ng(W,n,24)!=r || ng(W,n,28)!=exp){return 0;}
  if(is_superseded(W,n)==1){return 0;}
  return 1;
}
// The 12 probes. out: [0]=serve-verified ok, [1]=D hits (9101+i),
// [2]=D misses (-2), [3]=E serve-verified.
fn ow_probes(W:[]u8,tag:[]u8,out:[]u8)void {
  emit("PHASE "); emit(tag); emit("\n");
  let ok:i32=0; let dh:i32=0; let dm:i32=0; let eo:i32=0; let i:i32=0;
  while(i<6){
    let a:i32=ow_mquery(W,9501+i,702);
    if(ow_serve_ok(W,9501+i,702,9101+i,a)==1){ok=ok+1;}
    if(a==9101+i){dh=dh+1;}
    if(a==-2){dm=dm+1;}
    i=i+1;
  }
  i=0;
  while(i<6){
    let a:i32=ow_mquery(W,9601+i,801);
    if(ow_serve_ok(W,9601+i,801,9701+i,a)==1){ok=ok+1; eo=eo+1;}
    i=i+1;
  }
  emit("OW_PROBE_OK "); e64(ok); emit("/12\n");
  emit("OW_DHIT "); e64(dh); emit("/6\n");
  emit("OW_DMISS "); e64(dm); emit("/6\n");
  emit("OW_EOK "); e64(eo); emit("/6\n");
  set32(out,0,ok); set32(out,4,dh); set32(out,8,dm); set32(out,12,eo);
  return;
}
// INTERFERE: n unrelated TEACH events (memory pressure / time gap).
fn ow_interfere(W:[]u8,tag:[]u8,s0:i32,r:i32,o0:i32,n:i32)void {
  emit("PHASE "); emit(tag); emit("\n");
  let i:i32=0;
  while(i<n){ ow_event(W,1,s0+i,r,o0+i); i=i+1; }
  return;
}
// read-only mechanism census after a phase (CO-2 evidence).
fn ow_census(W:[]u8,ph:[]u8)void {
  emit("CENSUS "); emit(ph);
  emit(" MAPC="); e64(ow_count_nodes(W,20));
  emit(" DEPC="); e64(ow_count_edges(W,1));
  emit(" UNC="); e64(ow_count_nodes(W,30));
  emit(" GUIDEC="); e64(ow_count_guides(W));
  emit(" N1="); e64(ow_count_nodes(W,1));
  emit(" N20="); e64(ow_count_nodes(W,20));
  emit(" N30="); e64(ow_count_nodes(W,30));
  emit(" E1="); e64(ow_count_edges(W,1));
  emit(" Eall="); e64(ow_count_edges_all(W));
  emit("\n");
  return;
}
fn ow_want_events()i32 { return 98; }
// ============ entry ============
fn ow_main()i32 {
  let md:[]u8=_zag_read_file("/dev/stdin");
  let mode:i32=0;
  if(ow_streq(md,"TREAT")==1){mode=1;}
  else { if(ow_streq(md,"CONTROL")==1){mode=2;} }
  if(mode==0){ emit("MODE_FAIL\n"); return 1; }
  if(mode==1){ emit("MODE TREAT\n"); } else { emit("MODE CONTROL\n"); }
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let store_ans:[]u8=z_alloc(24);
  let out:[]u8=z_alloc(16);
  ow_store(W,store_ans);
  ow_census(W,"STORE");
  let store_ok:i32=ow_store_ok(W,store_ans);
  ow_interfere(W,"INTERFERE1",11001,901,11101,30);
  ow_probes(W,"REUSE",out);
  let reuse_ok:i32=get32(out,0); let sanity_e:i32=get32(out,12);
  ow_census(W,"REUSE");
  ow_interfere(W,"INTERFERE2",12001,902,12101,20);
  ow_probes(W,"DELAYED",out);
  let delayed_ok:i32=get32(out,0);
  ow_census(W,"DELAYED");
  emit("OW_REUSEOK "); e64(reuse_ok); emit("/12\n");
  emit("OW_DELAYEDOK "); e64(delayed_ok); emit("/12\n");
  emit("OW_SANITY_E "); e64(sanity_e); emit("/6\n");
  if(store_ok!=6 || reuse_ok!=12 || delayed_ok!=12){ emit("OW_BAR_MISS\n"); }
  if(mode==1 && sanity_e!=6){ emit("OW_SANITY_VIOLATION\n"); }
  emit("FNV "); e64(ow_fnv(W)); emit("\n");
  let want:i32=ow_want_events();
  if(hg(W,52)==want){ emit("AUDIT_PASS\n"); }
  else { emit("AUDIT_FAIL count="); e64(hg(W,52)); emit(" want="); e64(want); emit("\n"); return 1; }
  return 0;
}
fn main()i32 { return ow_main(); }

// cmp_events.zag - normalized trace event comparator for the F1-FOLLOWUP
// Part 1 corrected K-C0C-REG W2 leg.
// usage: cmp_events <trace>
// Prints one normalized event per line:
//   TRIG <ep>
//   CONS <ep> <bidx> <id> <op> <p1> <p2> <p3> <eb> <ea>
// TRIGGER suffix formats (consec= vs winfail=) are normalized away; the
// frozen bar compares episode numbers and CONSTRUCT fields only.
// Pure Zag, compiled by the pinned znc.

fn ce_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn ce_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn ce_after_eq(tok:[]u8)[]u8 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return ""; }
    return tok[p+1..tok.len];
}

fn ce_has_prefix(tok:[]u8, pre:[]u8)bool {
    if(tok.len < pre.len) { return false; }
    let i:i64 = 0;
    while(i < pre.len) {
        if(tok[i] != pre[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn ce_field(line:[]u8, name:[]u8)[]u8 {
    let nt:i64 = ce_ntok(line);
    let i:i64 = 0;
    while(i < nt) {
        let t:[]u8 = ce_tok(line, i);
        if(ce_has_prefix(t, name)) { return ce_after_eq(t); }
        i = i + 1;
    }
    return "?";
}

fn main()i32 {
    if(_zag_argc() < 2) { _zag_println("usage: cmp_events <trace>"); return 2; }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { _zag_println("ERR read"); return 2; }
    let p:i64 = 0;
    while(p < text.len) {
        let q:i64 = p;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p..q];
        if(q < text.len) { q = q + 1; }
        p = q;
        if(line.len >= 8) {
            let w:[]u8 = ce_tok(line, 0);
            if(_zag_strcmp(w, "TRIGGER") == 1) {
                _zag_print("TRIG ");
                _zag_println(ce_tok(line, 1));
            } else if(_zag_strcmp(w, "CONSTRUCT") == 1) {
                _zag_print("CONS ");
                _zag_print(ce_tok(line, 1));
                _zag_print(" ");
                _zag_print(ce_tok(line, 2));
                _zag_print(" ");
                _zag_print(ce_field(line, "id="));
                _zag_print(" ");
                _zag_print(ce_field(line, "op="));
                _zag_print(" ");
                _zag_print(ce_field(line, "p1="));
                _zag_print(" ");
                _zag_print(ce_field(line, "p2="));
                _zag_print(" ");
                _zag_print(ce_field(line, "p3="));
                _zag_print(" ");
                _zag_print(ce_field(line, "err_before="));
                _zag_print(" ");
                _zag_println(ce_field(line, "err_after="));
            }
        }
    }
    return 0;
}

// cw2_sep.zag - single-feature separation analysis for F1-FOLLOWUP Part 2.
// Implements the frozen decision rule of PREREG_PART2 section 5(c).
// usage: cw2_sep <results_table>
// Table lines: SEED <i> <OVERFIT|CORRECT> F1=<n> F2=<n> F3=<n> F4=<n>
//   F5=<n> F6=<n>
// For each feature F1..F6 reports the best single-threshold separation
// in both directions (predict OVERFIT when val >= k, and when val <= k):
// the threshold k with minimum total misclassified seeds, the misc
// count, and the contingency cells (ovf_ge cor_ge ovf_lt cor_lt).
// CHARACTERIZED needs a fixture property with misc <= 2.
// Pure Zag, compiled by the pinned znc.

fn sp_alloc(n:i64)[]u8 {
    if(n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn sp_ig(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn sp_is(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

fn sp_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn sp_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn sp_after_eq(tok:[]u8)i64 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return 0; }
    return _zag_str_to_i64(tok[p+1..tok.len]);
}

fn main()i32 {
    if(_zag_argc() < 2) { _zag_println("usage: cw2_sep <results_table>"); return 2; }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { _zag_println("ERR read"); return 2; }

    let cls:[]u8 = sp_alloc(64 * 8);
    let fv:[]u8 = sp_alloc(6 * 64 * 8);
    let n:i64 = 0;
    let novf:i64 = 0;
    let ncor:i64 = 0;
    let p:i64 = 0;
    while(p < text.len) {
        let q:i64 = p;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p..q];
        if(q < text.len) { q = q + 1; }
        p = q;
        if(sp_ntok(line) >= 9) {
            if(_zag_strcmp(sp_tok(line, 0), "SEED") == 1) {
                let c:[]u8 = sp_tok(line, 2);
                let cv:i64 = 0;
                if(_zag_strcmp(c, "OVERFIT") == 1) { cv = 1; novf = novf + 1; }
                else { ncor = ncor + 1; }
                sp_is(cls, n, cv);
                let f:i64 = 0;
                while(f < 6) {
                    sp_is(fv, f * 64 + n, sp_after_eq(sp_tok(line, 3 + f)));
                    f = f + 1;
                }
                n = n + 1;
            }
        }
    }

    _zag_print("N "); _zag_println(_zag_i64_to_str(n));
    _zag_print("OVERFIT "); _zag_println(_zag_i64_to_str(novf));
    _zag_print("CORRECT "); _zag_println(_zag_i64_to_str(ncor));

    let f:i64 = 0;
    while(f < 6) {
        // distinct values of this feature
        let dv:[]u8 = sp_alloc(64 * 8);
        let ndv:i64 = 0;
        let i:i64 = 0;
        while(i < n) {
            let v:i64 = sp_ig(fv, f * 64 + i);
            let j:i64 = 0;
            let seen:i64 = 0;
            while(j < ndv) {
                if(sp_ig(dv, j) == v) { seen = 1; }
                j = j + 1;
            }
            if(seen == 0) { sp_is(dv, ndv, v); ndv = ndv + 1; }
            i = i + 1;
        }
        // direction ge: predict OVERFIT when val >= k
        let best_ge:i64 = 1000000;
        let bestk_ge:i64 = 0;
        let bg_og:i64 = 0;
        let bg_cg:i64 = 0;
        let bg_ol:i64 = 0;
        let bg_cl:i64 = 0;
        // direction le: predict OVERFIT when val <= k
        let best_le:i64 = 1000000;
        let bestk_le:i64 = 0;
        let bl_og:i64 = 0;
        let bl_cg:i64 = 0;
        let bl_ol:i64 = 0;
        let bl_cl:i64 = 0;
        let t:i64 = 0;
        while(t < ndv) {
            let k:i64 = sp_ig(dv, t);
            let og:i64 = 0;
            let cg:i64 = 0;
            let ol:i64 = 0;
            let cl:i64 = 0;
            i = 0;
            while(i < n) {
                let v:i64 = sp_ig(fv, f * 64 + i);
                let c:i64 = sp_ig(cls, i);
                if(v >= k) {
                    if(c == 1) { og = og + 1; } else { cg = cg + 1; }
                } else {
                    if(c == 1) { ol = ol + 1; } else { cl = cl + 1; }
                }
                i = i + 1;
            }
            let misc_ge:i64 = ol + cg;
            if(misc_ge < best_ge) {
                best_ge = misc_ge; bestk_ge = k;
                bg_og = og; bg_cg = cg; bg_ol = ol; bg_cl = cl;
            }
            let misc_le:i64 = og + cl;
            if(misc_le < best_le) {
                best_le = misc_le; bestk_le = k;
                bl_og = og; bl_cg = cg; bl_ol = ol; bl_cl = cl;
            }
            t = t + 1;
        }
        _zag_print("SEP F");
        _zag_print(_zag_i64_to_str(f + 1));
        _zag_print(" ge k=");
        _zag_print(_zag_i64_to_str(bestk_ge));
        _zag_print(" misc=");
        _zag_print(_zag_i64_to_str(best_ge));
        _zag_print(" cells=");
        _zag_print(_zag_i64_to_str(bg_og)); _zag_print("/");
        _zag_print(_zag_i64_to_str(bg_cg)); _zag_print("/");
        _zag_print(_zag_i64_to_str(bg_ol)); _zag_print("/");
        _zag_println(_zag_i64_to_str(bg_cl));
        _zag_print("SEP F");
        _zag_print(_zag_i64_to_str(f + 1));
        _zag_print(" le k=");
        _zag_print(_zag_i64_to_str(bestk_le));
        _zag_print(" misc=");
        _zag_print(_zag_i64_to_str(best_le));
        _zag_print(" cells=");
        _zag_print(_zag_i64_to_str(bl_og)); _zag_print("/");
        _zag_print(_zag_i64_to_str(bl_cg)); _zag_print("/");
        _zag_print(_zag_i64_to_str(bl_ol)); _zag_print("/");
        _zag_println(_zag_i64_to_str(bl_cl));
        f = f + 1;
    }
    return 0;
}

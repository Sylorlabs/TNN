// cw2_analyze.zag - sum2 constructor characterization analyzer
// (F1-FOLLOWUP Part 2). Implements exactly the frozen feature set of
// PREREG_PART2 section 4.
// usage: cw2_analyze <train.ep> <trace>
// Prints, one per line:
//   F1_DISTINCT <n>     distinct (x0,x1) pairs in the train fixture
//   F2_DUP <n>          duplicate pair occurrences (n_eps - F1)
//   F3_EQ <n>           episodes with x0 == x1
//   F4_Y0 <n>           episodes with y == 0
//   F5_YDIST <n>        distinct y values
//   F6_ZIN <n>          episodes with x0 == 0 or x1 == 0
//   F7_FIRSTCONS <op> <class>   first CONSTRUCT op and operand class
//   F8_NCONS <n>        total CONSTRUCT events in the train trace
//   F9_FIRSTTRIG <ep>   first TRIGGER episode (-1 if none)
// Operand class: feat_same (p2==p3, both >= 8), feat_diff (p2!=p3,
// both >= 8), mixed (one < 8, one >= 8), node_pair (both < 8), other.
// Pure Zag, compiled by the pinned znc.

fn cw_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn cw_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn cw_after_eq(tok:[]u8)[]u8 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return ""; }
    return tok[p+1..tok.len];
}

fn cw_has_prefix(tok:[]u8, pre:[]u8)bool {
    if(tok.len < pre.len) { return false; }
    let i:i64 = 0;
    while(i < pre.len) {
        if(tok[i] != pre[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn cw_field(line:[]u8, name:[]u8)[]u8 {
    let nt:i64 = cw_ntok(line);
    let i:i64 = 0;
    while(i < nt) {
        let t:[]u8 = cw_tok(line, i);
        if(cw_has_prefix(t, name)) { return cw_after_eq(t); }
        i = i + 1;
    }
    return "?";
}

fn main()i32 {
    if(_zag_argc() < 3) { _zag_println("usage: cw2_analyze <train.ep> <trace>"); return 2; }
    let ept:[]u8 = _zag_read_file(_zag_arg(1));
    if(ept.len == 0) { _zag_println("ERR read_ep"); return 2; }
    let trt:[]u8 = _zag_read_file(_zag_arg(2));
    if(trt.len == 0) { _zag_println("ERR read_trace"); return 2; }

    // Parse train episodes: "x0 x1 y".
    let xs0:[]u8 = "";
    let xs1:[]u8 = "";
    let ys:[]u8 = "";
    let neps:i64 = 0;
    let p:i64 = 0;
    while(p < ept.len) {
        let q:i64 = p;
        while(q < ept.len && ept[q] != 10) { q = q + 1; }
        let line:[]u8 = ept[p..q];
        if(q < ept.len) { q = q + 1; }
        p = q;
        if(cw_ntok(line) == 3) {
            xs0 = _zag_str_concat(xs0, cw_tok(line, 0));
            xs0 = _zag_str_concat(xs0, " ");
            xs1 = _zag_str_concat(xs1, cw_tok(line, 1));
            xs1 = _zag_str_concat(xs1, " ");
            ys = _zag_str_concat(ys, cw_tok(line, 2));
            ys = _zag_str_concat(ys, " ");
            neps = neps + 1;
        }
    }

    let f2:i64 = 0;
    let f3:i64 = 0;
    let f4:i64 = 0;
    let f6:i64 = 0;
    let i:i64 = 0;
    while(i < neps) {
        let a0:[]u8 = cw_tok(xs0, i);
        let a1:[]u8 = cw_tok(xs1, i);
        let yy:[]u8 = cw_tok(ys, i);
        // duplicates: count earlier equal pairs
        let j:i64 = 0;
        let dup:i64 = 0;
        while(j < i) {
            if(_zag_strcmp(cw_tok(xs0, j), a0) == 1 &&
               _zag_strcmp(cw_tok(xs1, j), a1) == 1) { dup = 1; }
            j = j + 1;
        }
        if(dup == 1) { f2 = f2 + 1; }
        if(_zag_strcmp(a0, a1) == 1) { f3 = f3 + 1; }
        if(_zag_strcmp(yy, "0") == 1) { f4 = f4 + 1; }
        if(_zag_strcmp(a0, "0") == 1 || _zag_strcmp(a1, "0") == 1) { f6 = f6 + 1; }
        i = i + 1;
    }
    // F1 = distinct pairs = neps - f2; F5 = distinct y
    let f1:i64 = neps - f2;
    let f5:i64 = 0;
    i = 0;
    while(i < neps) {
        let yy:[]u8 = cw_tok(ys, i);
        let j:i64 = 0;
        let seen:i64 = 0;
        while(j < i) {
            if(_zag_strcmp(cw_tok(ys, j), yy) == 1) { seen = 1; }
            j = j + 1;
        }
        if(seen == 0) { f5 = f5 + 1; }
        i = i + 1;
    }

    // Trace: first TRIGGER, CONSTRUCT count, first CONSTRUCT fields.
    let f9:i64 = -1;
    let f8:i64 = 0;
    let first_op:[]u8 = "none";
    let first_p2:[]u8 = "?";
    let first_p3:[]u8 = "?";
    p = 0;
    while(p < trt.len) {
        let q:i64 = p;
        while(q < trt.len && trt[q] != 10) { q = q + 1; }
        let line:[]u8 = trt[p..q];
        if(q < trt.len) { q = q + 1; }
        p = q;
        if(line.len >= 8) {
            let w:[]u8 = cw_tok(line, 0);
            if(_zag_strcmp(w, "TRIGGER") == 1) {
                if(f9 == -1) { f9 = _zag_str_to_i64(cw_tok(line, 1)); }
            } else if(_zag_strcmp(w, "CONSTRUCT") == 1) {
                f8 = f8 + 1;
                if(f8 == 1) {
                    first_op = cw_field(line, "op=");
                    first_p2 = cw_field(line, "p2=");
                    first_p3 = cw_field(line, "p3=");
                }
            }
        }
    }

    // Operand class of the first CONSTRUCT.
    let cls:[]u8 = "none";
    if(f8 >= 1) {
        let p2:i64 = _zag_str_to_i64(first_p2);
        let p3:i64 = _zag_str_to_i64(first_p3);
        let f2r:bool = p2 >= 8;
        let f3r:bool = p3 >= 8;
        if(f2r && f3r) {
            if(p2 == p3) { cls = "feat_same"; } else { cls = "feat_diff"; }
        } else if(f2r || f3r) {
            cls = "mixed";
        } else {
            cls = "node_pair";
        }
    }

    _zag_print("F1_DISTINCT "); _zag_println(_zag_i64_to_str(f1));
    _zag_print("F2_DUP "); _zag_println(_zag_i64_to_str(f2));
    _zag_print("F3_EQ "); _zag_println(_zag_i64_to_str(f3));
    _zag_print("F4_Y0 "); _zag_println(_zag_i64_to_str(f4));
    _zag_print("F5_YDIST "); _zag_println(_zag_i64_to_str(f5));
    _zag_print("F6_ZIN "); _zag_println(_zag_i64_to_str(f6));
    _zag_print("F7_FIRSTCONS "); _zag_print(first_op);
    _zag_print(" "); _zag_println(cls);
    _zag_print("F8_NCONS "); _zag_println(_zag_i64_to_str(f8));
    _zag_print("F9_FIRSTTRIG "); _zag_println(_zag_i64_to_str(f9));
    return 0;
}

// e4_controls.zag -- E4 calibration controls (PREREG_E4 section 7).
// Writes synthetic inspector reports and transcripts:
//   competent_w1: a W1-conformant LICENSED DERIVED structure plus a
//     transcript with the W1 probe pattern. The checker must print
//     DERIVED=1 PREFLAT=1 POST=1 VALID=1 for check E4W1.
//   competent_w0: a W0-conformant LICENSED DERIVED structure plus a
//     transcript. The checker must print DERIVED=1 FIRSTCLASS=1
//     VALID=1 for check E4W0.
//   degenerate: only flat and per-instance structures. The checker
//     must print DERIVED=0 for both checks.
// Usage: e4_controls_bin <outdir>. Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn app_str(buf:[]u8,pos:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
  return pos+s.len;
}
fn join_path(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+name.len+2);
  let p:i32=app_str(b,0,dir);
  if(dir.len>0 && dir[dir.len-1]!=47){ b[p]=47; p=p+1; }
  p=app_str(b,p,name);
  return b[0..p];
}
fn wfile(dir:[]u8,name:[]u8,body:[]u8)void {
  let p:[]u8=join_path(dir,name);
  if(_zag_write_file(p,body)!=0){ errln("write failed"); return; }
  emit("WROTE "); _zag_print(p); emit("\n");
  return;
}

fn main()i32 {
  if(_zag_argc()!=2){
    errln("usage: e4_controls_bin <outdir>");
    return 2;
  }
  let dir:[]u8=_zag_arg(1);
  if(dir.len>0 && dir[dir.len-1]==10){ dir=dir[0..dir.len-1]; }
  // competent W1: licensed derived structure (both hops + contradiction
  // triple, as the real W1 evidence will carry), W1 probe pattern
  wfile(dir,"competent_w1_report.txt",
    "OBSERVES 5\nSTRUCTURE id=42 subj=72201 rel=72219 answer=72295\nEVIDENCE (72201,72211,72291) (72291,72212,72295) (72201,72219,72295) count=3\nSTRUCTURES 1\n");
  wfile(dir,"competent_w1_trans.txt",
    "WORLD_BEGIN\nANSWER 72201 72219 72295\nANSWER 72201 72219 72295\nANSWER 72201 72219 72299\nANSWER 72201 72219 72295\nANSWER 72201 72211 72291\nANSWER 72291 72212 72295\nWORLD_END events=10 answers=6\n");
  // competent W0: licensed derived structure, W0 probe pattern
  wfile(dir,"competent_w0_report.txt",
    "OBSERVES 2\nSTRUCTURE id=43 subj=72101 rel=72119 answer=72195\nEVIDENCE (72101,72111,72191) (72191,72112,72195) count=2\nSTRUCTURES 1\n");
  wfile(dir,"competent_w0_trans.txt",
    "WORLD_BEGIN\nANSWER 72101 72119 72195\nANSWER 72101 72119 72195\nANSWER 72101 72111 72191\nANSWER 72191 72112 72195\nWORLD_END events=6 answers=4\n");
  // degenerate: flat promoted fact + per-instance structure only
  wfile(dir,"degenerate_report.txt",
    "OBSERVES 5\nSTRUCTURE id=7 subj=72201 rel=72219 answer=72299\nEVIDENCE (72201,72219,72299) count=1\nSTRUCTURE id=9 subj=72101 rel=72111 answer=72191\nEVIDENCE (72101,72111,72191) count=1\nSTRUCTURES 2\n");
  emit("E4 controls written.\n");
  return 0;
}

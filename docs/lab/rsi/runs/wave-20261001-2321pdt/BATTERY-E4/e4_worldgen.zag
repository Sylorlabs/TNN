// e4_worldgen.zag -- E4 discriminating experiment world generator.
// Generates the 2 fresh sealed worlds from PREREG_E4 section 4 (verbatim).
// Manifest hashes are computed by shell sha256sum. Pure Zag, pinned znc.
// Usage: e4_worldgen_bin <outdir>
// Lineage: e1_worldgen.zag (BATTERY-E1, commit aa38427b8).

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn app_str(buf:[]u8,pos:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
  return pos+s.len;
}
fn app_i32(buf:[]u8,pos:i32,v:i32)i32 {
  return app_str(buf,pos,i64s(v as i64));
}
fn app_nl(buf:[]u8,pos:i32)i32 { buf[pos]=10; return pos+1; }
fn w_observe(buf:[]u8,pos:i32,s:i32,r:i32,o:i32)i32 {
  pos=app_str(buf,pos,"OBSERVE ");
  pos=app_i32(buf,pos,s);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,r);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,o);
  return app_nl(buf,pos);
}
fn w_query(buf:[]u8,pos:i32,s:i32,r:i32,e:i32)i32 {
  pos=app_str(buf,pos,"QUERY ");
  pos=app_i32(buf,pos,s);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,r);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,e);
  return app_nl(buf,pos);
}
fn write_buf(path:[]u8,buf:[]u8,pos:i32)i32 {
  let out:[]u8=buf[0..pos];
  if(_zag_write_file(path,out)!=0){
    errln("write failed");
    return 1;
  }
  emit("WROTE "); _zag_print(path); emit(" "); e64(pos); emit(" bytes\n");
  return 0;
}
fn join_path(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+name.len+2);
  let p:i32=app_str(b,0,dir);
  if(dir.len>0 && dir[dir.len-1]!=47){ b[p]=47; p=p+1; }
  p=app_str(b,p,name);
  return b[0..p];
}
// ---- world emitters (exact streams from PREREG_E4 section 4) ----
fn gen_e4w0(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,72101,72111,72191);
  p=w_observe(buf,p,72191,72112,72195);
  p=w_query(buf,p,72101,72119,72195);
  p=w_query(buf,p,72101,72119,72195);
  p=w_query(buf,p,72101,72111,72191);
  p=w_query(buf,p,72191,72112,72195);
  return p;
}
fn gen_e4w1(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,72201,72211,72291);
  p=w_observe(buf,p,72291,72212,72295);
  p=w_query(buf,p,72201,72219,72295);
  p=w_query(buf,p,72201,72219,72295);
  p=w_observe(buf,p,72201,72219,72299);
  p=w_query(buf,p,72201,72219,72295);
  p=w_observe(buf,p,72201,72219,72295);
  p=w_query(buf,p,72201,72219,72295);
  p=w_query(buf,p,72201,72211,72291);
  p=w_query(buf,p,72291,72212,72295);
  return p;
}

fn main()i32 {
  if(_zag_argc()!=2){
    errln("usage: e4_worldgen_bin <outdir>");
    return 2;
  }
  let dir:[]u8=_zag_arg(1);
  if(dir.len>0 && dir[dir.len-1]==10){ dir=dir[0..dir.len-1]; }
  let buf:[]u8=z_alloc(8192);
  let p:i32=gen_e4w0(buf);
  if(write_buf(join_path(dir,"e4_w0.txt"),buf,p)!=0){ return 1; }
  p=gen_e4w1(buf);
  if(write_buf(join_path(dir,"e4_w1.txt"),buf,p)!=0){ return 1; }
  emit("E4 worlds generated.\n");
  return 0;
}

// e4_struct_check.zag -- E4 licensed-derived-structure checks.
// Usage: e4_struct_check_bin <inspector_report> <transcript> <check>
// check in {E4W0, E4W1}: applies the frozen per-world bars from
// PREREG_E4 sections 3.1/3.2. World parameters (id ranges, derived
// values, probe indices) live here as frozen bar data, the
// v3_struct_check/e1_struct_check lineage; the inspector itself stays
// generic (K-C0A).
// Prints BAR E4-W0 DERIVED=.. FIRSTCLASS=.. VALID=.. or
//        BAR E4-W1 DERIVED=.. PREFLAT=.. POST=.. VALID=..
// Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
// find key (e.g. "id=") in [ls,le); parse the integer right after it.
fn key_int(d:[]u8,ls:i32,le:i32,key:[]u8) i32 {
  let kl:i32=key.len;
  let i:i32=ls;
  while(i+kl<le){
    let m:i32=1;
    let j:i32=0;
    while(j<kl){ if(d[i+j]!=key[j]){ m=0; } j=j+1; }
    if(m==1){
      let s1:i32=i+kl;
      let e1:i32=s1;
      while(e1<le && ((d[e1]>=48 && d[e1]<=57) || d[e1]==45)){ e1=e1+1; }
      if(e1>s1 && is_int(d,s1,e1)==1){ return parse_i32(d,s1,e1); }
      return -999999;
    }
    i=i+1;
  }
  return -999999;
}
// store (s,r,o) triples from an EVIDENCE line into evbuf for structure si
fn scan_evidence(d:[]u8,ls:i32,le:i32,si:i32,evbuf:[]u8,evcnt:[]u8)void {
  let cnt:i32=ig(evcnt,si*4);
  let i:i32=ls;
  while(i<le){
    if(d[i]==40){
      let s1:i32=i+1;
      let e1:i32=s1;
      while(e1<le && d[e1]!=44 && d[e1]!=41){ e1=e1+1; }
      let s2:i32=e1+1;
      let e2:i32=s2;
      while(e2<le && d[e2]!=44 && d[e2]!=41){ e2=e2+1; }
      let s3:i32=e2+1;
      let e3:i32=s3;
      while(e3<le && d[e3]!=41){ e3=e3+1; }
      if(e1>s1 && e2>s2 && e3>s3 && is_int(d,s1,e1)==1 && is_int(d,s2,e2)==1 && is_int(d,s3,e3)==1){
        if(cnt<128){
          let base:i32=(si*128+cnt)*12;
          put32(evbuf,base,parse_i32(d,s1,e1));
          put32(evbuf,base+4,parse_i32(d,s2,e2));
          put32(evbuf,base+8,parse_i32(d,s3,e3));
          cnt=cnt+1;
        }
      }
      i=e3+1;
    } else {
      i=i+1;
    }
  }
  put32(evcnt,si*4,cnt);
  return;
}
fn ev_has(evbuf:[]u8,evcnt:[]u8,si:i32,s:i32,r:i32,o:i32)i32 {
  let cnt:i32=ig(evcnt,si*4);
  let k:i32=0;
  while(k<cnt){
    let base:i32=(si*128+k)*12;
    if(ig(evbuf,base)==s && ig(evbuf,base+4)==r && ig(evbuf,base+8)==o){ return 1; }
    k=k+1;
  }
  return 0;
}

fn main()i32 {
  if(_zag_argc()!=4){
    errln("usage: e4_struct_check_bin <inspector_report> <transcript> <check>");
    return 2;
  }
  let rd:[]u8=_zag_read_file(_zag_arg(1));
  let td:[]u8=_zag_read_file(_zag_arg(2));
  let ck:[]u8=_zag_arg(3);
  if(ck.len>0 && ck[ck.len-1]==10){ ck=ck[0..ck.len-1]; }
  let w:i32=0;
  if(word_is(ck,0,ck.len,"E4W0")==1){ w=1; }
  if(word_is(ck,0,ck.len,"E4W1")==1){ w=2; }
  if(w==0){ errln("unknown check"); return 2; }
  // parse inspector report
  let s_subj:[]u8=z_alloc(128*4);
  let s_rel:[]u8=z_alloc(128*4);
  let s_ans:[]u8=z_alloc(128*4);
  let s_id:[]u8=z_alloc(128*4);
  let evbuf:[]u8=z_alloc(128*128*12);
  let evcnt:[]u8=z_alloc(128*4);
  let ns:i32=0;
  let n:i32=_zag_strlen(rd);
  let s:i32=0;
  let cur:i32=-1;
  while(s<n){
    let le:i32=line_end(rd,s,n);
    let f0s:i32=skip_ws(rd,s,le);
    if(f0s<le){
      let f0e:i32=field_end(rd,f0s,le);
      let wl:i32=f0e-f0s;
      if(word_is(rd,f0s,wl,"STRUCTURE")==1 && ns<128){
        put32(s_id,ns*4,key_int(rd,s,le,"id="));
        put32(s_subj,ns*4,key_int(rd,s,le,"subj="));
        put32(s_rel,ns*4,key_int(rd,s,le,"rel="));
        put32(s_ans,ns*4,key_int(rd,s,le,"answer="));
        put32(evcnt,ns*4,0);
        cur=ns;
        ns=ns+1;
      }
      if(word_is(rd,f0s,wl,"EVIDENCE")==1 && cur>=0){
        scan_evidence(rd,s,le,cur,evbuf,evcnt);
      }
    }
    s=le+1;
  }
  // parse transcript ANSWER lines in order
  let a_o:[]u8=z_alloc(64*4);
  let na:i32=0;
  n=_zag_strlen(td);
  s=0;
  while(s<n){
    let le:i32=line_end(td,s,n);
    let f0s:i32=skip_ws(td,s,le);
    if(f0s<le){
      let f0e:i32=field_end(td,f0s,le);
      if(word_is(td,f0s,f0e-f0s,"ANSWER")==1 && na<64){
        let s1:i32=skip_ws(td,f0e,le);
        let e1:i32=field_end(td,s1,le);
        let s2:i32=skip_ws(td,e1,le);
        let e2:i32=field_end(td,s2,le);
        let s3:i32=skip_ws(td,e2,le);
        let e3:i32=field_end(td,s3,le);
        if(is_int(td,s3,e3)==1){ put32(a_o,na*4,parse_i32(td,s3,e3)); na=na+1; }
      }
    }
    s=le+1;
  }
  let derived:i32=0;
  let firstclass:i32=0;
  let preflat:i32=0;
  let post:i32=0;
  let valid:i32=0;
  let did:i32=-1;
  let i2:i32=0;
  if(w==1){
    // PREREG_E4 3.1/3.2 W0 bars
    while(i2<ns){
      if(ig(s_subj,i2*4)==72101 && ig(s_rel,i2*4)==72119 && ig(s_ans,i2*4)==72195){
        let a:i32=ev_has(evbuf,evcnt,i2,72101,72111,72191);
        let b:i32=ev_has(evbuf,evcnt,i2,72191,72112,72195);
        let ot:i32=ev_has(evbuf,evcnt,i2,72101,72119,72195);
        if(a==1 && b==1 && ot==0){ derived=1; did=i2; }
      }
      i2=i2+1;
    }
    if(na>=4){
      if(derived==1 && ig(a_o,0)==72195 && ig(a_o,4)==72195){ firstclass=1; }
      if(ig(a_o,8)==72191 && ig(a_o,12)==72195){ valid=1; }
    }
    emit("BAR E4-W0 ");
  }
  if(w==2){
    // PREREG_E4 3.1/3.2 W1 bars. The never-taught-on-derived-key
    // condition is intentionally dropped: the licensed contradiction
    // teaches D on RC by design (PREREG_E4 3.1).
    while(i2<ns){
      if(ig(s_subj,i2*4)==72201 && ig(s_rel,i2*4)==72219 && ig(s_ans,i2*4)==72295){
        let a:i32=ev_has(evbuf,evcnt,i2,72201,72211,72291);
        let b:i32=ev_has(evbuf,evcnt,i2,72291,72212,72295);
        if(a==1 && b==1){ derived=1; did=i2; }
      }
      i2=i2+1;
    }
    if(na>=6){
      if(ig(a_o,8)==72299){ preflat=1; }
      if(ig(a_o,12)==72295){ post=1; }
      if(ig(a_o,0)==72295 && ig(a_o,4)==72295 && ig(a_o,16)==72291 && ig(a_o,20)==72295){ valid=1; }
    }
    emit("BAR E4-W1 ");
  }
  emit("DERIVED="); e64(derived);
  if(w==1){
    emit(" FIRSTCLASS="); e64(firstclass);
  } else {
    emit(" PREFLAT="); e64(preflat);
    emit(" POST="); e64(post);
  }
  emit(" VALID="); e64(valid);
  emit("\n");
  if(did>=0){
    emit("DETAIL derived_structure id="); e64(ig(s_id,did*4));
    emit(" subj="); e64(ig(s_subj,did*4));
    emit(" rel="); e64(ig(s_rel,did*4));
    emit(" answer="); e64(ig(s_ans,did*4));
    emit(" evcount="); e64(ig(evcnt,did*4)); emit("\n");
  }
  return 0;
}

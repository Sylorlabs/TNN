// lo_driver.zag -- CONTLEARN learner-ownership probe fixture driver
// (wave-20261001-2321pdt, lane CONTLEARN)
// Phase-2 implementation for frozen prereg PREREG_LEARNOWN.md (commit 408ffdcdc).
//
// FIXTURE ONLY. This file defines 0 cognition functions (no learning,
// retrieval, inference, retention, eviction, planning, derivation, revision,
// or execution logic), 0 new node tags, 0 new edge types, 0 new opcodes,
// 0 modes, 0 bridges, 0 routers, 0 task-specific handlers, 0 semantic cases.
// It emits the frozen event script, calls the frozen TNN-2 event API
// (ev_teach/ev_query/ev_observe), runs read-only white-box censuses through
// the core's own accessors (ng/eg/activate/is_superseded), and prints
// results. No branching-on-opcode statements anywhere in this file.
//
// Link: concatenated after the frozen core with that file's single
// `fn main` line stripped at build time (mechanical, diff-verified).
// All names here are lo_ prefixed; the frozen source contains zero lo_
// occurrences, so nothing collides and nothing is redefined.
//
// Run selection arrives on stdin (mode token consumed by the driver only);
// argv is empty and the env is phase-free at launch. PHASE markers are
// driver-side prints; cognition receives only (kind, subject, relation,
// object) integer tuples through the choke points lo_event / lo_mquery.
// lo_mquery passes the frozen supervisor-disconnect parameters
// expected=-2, flags=1 (masked query, disclosed in the prereg); this carries
// no task identity and is not a task label.

// ============ small fixture helpers ============
fn lo_streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
// FNV-1a over the full arena (signed i32 wrap; determinism is what matters).
fn lo_fnv(W:[]u8)i32 {
  let h:i32=-2128831035;
  let i:i32=0;
  while(i<110656){ h=(h ^ (W[i] as i32))*16777619; i=i+1; }
  return h;
}
fn lo_count_nodes(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
fn lo_count_edges(W:[]u8,ty:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1 && eg(W,e,4)==ty){c=c+1;} e=e+1; }
  return c;
}
fn lo_count_edges_all(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
// content-identified lookup: first alive tag-1 node holding (s,r,o).
fn lo_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// content-identified lookup: first alive tag-20 MAP with (field8=s, field4=r).
fn lo_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
// alive DEP edge from->to exists (dead slots carry from=-1, so this is exact).
fn lo_has_dep(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==1 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
// ============ cognition choke points (K1c audit) ============
// Every tuple the driver passes to cognition flows through one of these two.
// kind: 1=TEACH, 2=QUERY, 3=OBSERVE. Header field 52 (unused by the frozen
// core) counts audited events.
fn lo_event(W:[]u8,kind:i32,s:i32,r:i32,o:i32)i32 {
  if(kind<1 || kind>3){ emit("AUDIT_FAIL kind="); e64(kind); emit("\n"); return -999; }
  emit("EV "); e64(kind); emit(" "); e64(s); emit(" "); e64(r); emit(" "); e64(o);
  hs(W,52,hg(W,52)+1);
  if(kind==1){ let q:i32=ev_teach(W,s,r,o); emit("\n"); return q; }
  let v:i32=ev_observe(W,s,r,o); emit(" rv="); e64(v); emit("\n"); return v;
}
// Masked query: supervisor disconnected. Frozen parameters expected=-2,
// flags=1 (masked=1 in mp_run; t2_try_verify accepts the first clean
// candidate). Disclosed in the prereg; not a task label.
fn lo_mquery(W:[]u8,s:i32,r:i32)i32 {
  emit("EV 2 "); e64(s); emit(" "); e64(r); emit(" -2 MK");
  hs(W,52,hg(W,52)+1);
  let a:i32=ev_query(W,s,r,-2,1);
  emit(" ans="); e64(a); emit("\n");
  return a;
}
// ============ frozen phases (exact tuples from prereg section 3) ============
// STORE: 39 events. store_ans is a 13-slot i32 buf (7 family-B + 6 family-C).
fn lo_store(W:[]u8,store_ans:[]u8)void {
  emit("PHASE STORE\n");
  let i:i32=0;
  while(i<7){ lo_event(W,1,5001+i,101,5101+i); i=i+1; }
  i=0;
  while(i<7){ lo_event(W,1,6001+i,201,5001+i); i=i+1; }
  i=0;
  while(i<7){ set32(store_ans,i*4,lo_mquery(W,6001+i,202)); i=i+1; }
  i=0;
  while(i<6){ lo_event(W,1,7001+i,301,7101+i); i=i+1; }
  i=0;
  while(i<6){ lo_event(W,1,8001+i,401,7001+i); i=i+1; }
  i=0;
  while(i<6){ set32(store_ans,(7+i)*4,lo_mquery(W,8001+i,402)); i=i+1; }
  return;
}
// STORE_OK: 13/13 MAPs promoted with the supervisor disconnected.
fn lo_store_ok(W:[]u8,store_ans:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<7){
    let m:i32=lo_find_map(W,6001+i,202);
    let f:i32=lo_find_fact(W,5001+i,101,5101+i);
    if(m>=0 && f>=0 && lo_has_dep(W,m,f)==1 && get32(store_ans,i*4)==5101+i){c=c+1;}
    else { emit("STORE_MISS B "); e64(i); emit("\n"); }
    i=i+1;
  }
  i=0;
  while(i<6){
    let m:i32=lo_find_map(W,8001+i,402);
    let f:i32=lo_find_fact(W,7001+i,301,7101+i);
    if(m>=0 && f>=0 && lo_has_dep(W,m,f)==1 && get32(store_ans,(7+i)*4)==7101+i){c=c+1;}
    else { emit("STORE_MISS C "); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("STORE_OK "); e64(c); emit("/13\n");
  return c;
}
// serving-node check: activate's node must be the content-expected live fact.
fn lo_serve_ok(W:[]u8,s:i32,r:i32,exp:i32,got:i32)i32 {
  if(got!=exp){return 0;}
  let n:i32=activate(W,s,r);
  if(n<2){return 0;}
  if(ng(W,n,36)!=1 || ng(W,n,0)!=1){return 0;}
  if(ng(W,n,20)!=s || ng(W,n,24)!=r || ng(W,n,28)!=exp){return 0;}
  if(is_superseded(W,n)==1){return 0;}
  return 1;
}
// REUSE / REUSE2 / NOSTORE: the same 20 masked probes. raw=new-value
// semantics are caller-interpreted: orig counts probes returning the
// ORIGINAL stored values, newv counts probes returning post-ablation
// values, miss counts probes returning -2 (true miss).
fn lo_reuse(W:[]u8,tag:[]u8,orig:[]u8,newv:[]u8,miss:[]u8)void {
  emit("PHASE "); emit(tag); emit("\n");
  let ok:i32=0; let nw:i32=0; let mi:i32=0; let i:i32=0;
  while(i<7){
    let a:i32=lo_mquery(W,5001+i,101);
    if(lo_serve_ok(W,5001+i,101,5101+i,a)==1){ok=ok+1;}
    if(a==9901+i){nw=nw+1;}
    if(a==-2){mi=mi+1;}
    i=i+1;
  }
  i=0;
  while(i<7){
    let a:i32=lo_mquery(W,6001+i,202);
    if(lo_serve_ok(W,6001+i,202,5101+i,a)==1){ok=ok+1;}
    if(a==9901+i){nw=nw+1;}
    if(a==-2){mi=mi+1;}
    i=i+1;
  }
  i=0;
  while(i<6){
    let a:i32=lo_mquery(W,8001+i,402);
    if(lo_serve_ok(W,8001+i,402,7101+i,a)==1){ok=ok+1;}
    if(a==9801+i){nw=nw+1;}
    if(a==-2){mi=mi+1;}
    i=i+1;
  }
  emit("REUSE_ORIG "); e64(ok); emit("/20\n");
  emit("REUSE_NEWV "); e64(nw); emit("/20\n");
  emit("REUSE_MISS "); e64(mi); emit("/20\n");
  set32(orig,0,ok); set32(newv,0,nw); set32(miss,0,mi);
  return;
}
// ABLATE: 13 events. In-arena deletion of the serving structures.
fn lo_ablate(W:[]u8)void {
  emit("PHASE ABLATE\n");
  let i:i32=0;
  while(i<7){ lo_event(W,3,5001+i,101,9901+i); i=i+1; }
  i=0;
  while(i<6){ lo_event(W,3,8001+i,402,9801+i); i=i+1; }
  return;
}
// read-only census after a phase.
fn lo_census(W:[]u8,ph:[]u8)void {
  emit("CENSUS "); emit(ph);
  emit(" N1="); e64(lo_count_nodes(W,1));
  emit(" N20="); e64(lo_count_nodes(W,20));
  emit(" N30="); e64(lo_count_nodes(W,30));
  emit(" N101="); e64(lo_count_nodes(W,101));
  emit(" N102="); e64(lo_count_nodes(W,102));
  emit(" N902="); e64(lo_count_nodes(W,902));
  emit(" E1="); e64(lo_count_edges(W,1));
  emit(" E12="); e64(lo_count_edges(W,12));
  emit(" Eall="); e64(lo_count_edges_all(W));
  emit("\n");
  return;
}
fn lo_want_events(mode:i32)i32 {
  if(mode==1){return 92;}
  return 20;
}
fn lo_modelabel(mode:i32)[]u8 {
  if(mode==1){return "TREAT";}
  return "NOSTORE";
}
// ============ entry ============
fn lo_main()i32 {
  let md:[]u8=_zag_read_file("/dev/stdin");
  let mode:i32=0;
  if(lo_streq(md,"TREAT")==1){mode=1;}
  else { if(lo_streq(md,"NOSTORE")==1){mode=2;} }
  if(mode==0){ emit("MODE_FAIL\n"); return 1; }
  emit("MODE "); emit(lo_modelabel(mode)); emit("\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let store_ans:[]u8=z_alloc(52);
  let orig:[]u8=z_alloc(4); let newv:[]u8=z_alloc(4); let miss:[]u8=z_alloc(4);
  let store_ok:i32=0;
  if(mode==1){
    lo_store(W,store_ans);
    lo_census(W,"STORE");
    store_ok=lo_store_ok(W,store_ans);
    lo_reuse(W,"REUSE",orig,newv,miss);
    let reuse_ok:i32=get32(orig,0);
    lo_census(W,"REUSE");
    lo_ablate(W);
    lo_census(W,"ABLATE");
    lo_reuse(W,"REUSE2",orig,newv,miss);
    let r2_orig:i32=get32(orig,0); let r2_newv:i32=get32(newv,0);
    lo_census(W,"REUSE2");
    emit("K4A_STOREOK "); e64(store_ok); emit("/13\n");
    emit("K4B_REUSEOK "); e64(reuse_ok); emit("/20\n");
    emit("K4C_R2ORIG "); e64(r2_orig); emit("/20\n");
    emit("K4C_R2NEWV "); e64(r2_newv); emit("/20\n");
    if(store_ok!=13 || reuse_ok!=20 || r2_orig>2 || r2_newv<18){ emit("K4_VIOLATION\n"); }
  }
  if(mode==2){
    lo_reuse(W,"NOSTORE",orig,newv,miss);
    let nmiss:i32=get32(miss,0);
    let n30:i32=lo_count_nodes(W,30);
    lo_census(W,"NOSTORE");
    emit("K4D_MISS "); e64(nmiss); emit("/20\n");
    emit("K4D_UNCERT "); e64(n30); emit("\n");
    if(nmiss!=20 || n30!=20){ emit("K4_VIOLATION\n"); }
  }
  let u30:i32=lo_count_nodes(W,30);
  emit("UNCERT "); e64(u30); emit("\n");
  if(mode==1 && u30!=0){ emit("K5_VIOLATION\n"); }
  emit("FNV "); e64(lo_fnv(W)); emit("\n");
  let want:i32=lo_want_events(mode);
  if(hg(W,52)==want){ emit("AUDIT_PASS\n"); }
  else { emit("AUDIT_FAIL count="); e64(hg(W,52)); emit(" want="); e64(want); emit("\n"); return 1; }
  return 0;
}
fn main()i32 { return lo_main(); }

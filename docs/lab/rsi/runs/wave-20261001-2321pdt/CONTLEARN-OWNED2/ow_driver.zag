// ow_driver.zag -- CONTLEARN-OWNED2 machinery-disabled discrimination driver
// (wave-20261001-2321pdt, lane CONTLEARN-OWNED2)
// Phase-2 implementation for frozen prereg PREREG_OWNED2.md (commit ffd31dbb3).
//
// FIXTURE ONLY. This file defines 0 cognition functions (no learning,
// retrieval, inference, retention, eviction, planning, derivation, revision,
// or execution logic), 0 new node tags, 0 new edge types, 0 new opcodes,
// 0 modes, 0 bridges, 0 routers, 0 task-specific handlers, 0 semantic cases.
// It emits the frozen 98-event script, calls the frozen TNN-2 event API
// (ev_teach/ev_query), runs read-only white-box censuses through the core's
// own accessors (ng/eg/activate/is_superseded), and prints results. No
// branching-on-opcode statements anywhere in this file.
//
// Link: concatenated after either the control core (ow_core_control.zag,
// the recorded nomain derivation of the frozen core) or the variant core
// (ow_core_disabled.zag, the nomain derivation minus the two machinery call
// blocks in ev_query). All names here are ow_ prefixed; the frozen source
// contains zero ow_ occurrences, so nothing collides and nothing is
// redefined.
//
// One mode only: the driver always runs the frozen 104-event script. Which
// core is linked (TREAT = machinery-disabled, CONTROL = unmodified frozen)
// is selected at build time by the binary; the driver never sees it.
// PHASE markers are driver-side prints; cognition receives only
// (kind, subject, relation, object) integer tuples through the choke points
// ow_event / ow_mquery. ow_mquery passes the frozen supervisor-disconnect
// parameters expected=-2, flags=1 (masked query, disclosed in the prereg);
// this carries no task identity and is not a task label.

// ============ small fixture helpers ============
fn ow_fnv(W:[]u8)i32 {
  let h:i32=-2128831035;
  let i:i32=0;
  while(i<110656){ h=(h ^ (W[i] as i32))*16777619; i=i+1; }
  return h;
}
fn ow_count_nodes(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
fn ow_count_edges(W:[]u8,ty:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1 && eg(W,e,4)==ty){c=c+1;} e=e+1; }
  return c;
}
fn ow_count_edges_all(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
// guide-signature nodes: tag==1, alive, field20==30, field24==-999
// (the miss_inquire guide signature, read from the frozen source).
fn ow_count_guides(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30 && ng(W,n,24)==-999){c=c+1;}
    n=n+1;
  }
  return c;
}
// content-identified lookup: first alive tag-1 node holding (s,r,o).
fn ow_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// content-identified lookup: first alive tag-20 MAP with (field8=s, field4=r).
fn ow_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
// alive DEP (type 1) edge from->to exists (dead slots carry from=-1).
fn ow_has_dep(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==1 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
// ============ cognition choke points (K1c audit) ============
// Every tuple the driver passes to cognition flows through one of these two.
// kind: 1=TEACH, 2=QUERY (masked). Header field 52 (unused by the frozen
// core) counts audited events.
fn ow_event(W:[]u8,kind:i32,s:i32,r:i32,o:i32)i32 {
  if(kind!=1){ emit("AUDIT_FAIL kind="); e64(kind); emit("\n"); return -999; }
  emit("EV 1 "); e64(s); emit(" "); e64(r); emit(" "); e64(o);
  hs(W,52,hg(W,52)+1);
  let q:i32=ev_teach(W,s,r,o); emit("\n"); return q;
}
// Masked query: supervisor disconnected. Frozen parameters expected=-2,
// flags=1. Disclosed in the prereg; not a task label.
fn ow_mquery(W:[]u8,s:i32,r:i32)i32 {
  emit("EV 2 "); e64(s); emit(" "); e64(r); emit(" -2 MK");
  hs(W,52,hg(W,52)+1);
  let a:i32=ev_query(W,s,r,-2,1);
  emit(" ans="); e64(a); emit("\n");
  return a;
}
// ============ frozen phases (exact tuples from prereg section 4) ============
// STORE: 30 events. store_ans is a 6-slot i32 buf holding the 6 family-D
// integrate answers.
fn ow_store(W:[]u8,store_ans:[]u8)void {
  emit("PHASE STORE\n");
  let i:i32=0;
  while(i<6){ ow_event(W,1,9001+i,501,9101+i); i=i+1; }
  i=0;
  while(i<6){ ow_event(W,1,9501+i,701,9001+i); i=i+1; }
  i=0;
  while(i<6){ set32(store_ans,i*4,ow_mquery(W,9501+i,702)); i=i+1; }
  i=0;
  while(i<6){ ow_event(W,1,9601+i,801,9701+i); i=i+1; }
  return;
}
// STORE_OK: 6/6 MAPs with alive DEP edge to the licensing chain fact and
// the integrate query returning the chain value.
fn ow_store_ok(W:[]u8,store_ans:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<6){
    let m:i32=ow_find_map(W,9501+i,702);
    let f:i32=ow_find_fact(W,9001+i,501,9101+i);
    if(m>=0 && f>=0 && ow_has_dep(W,m,f)==1 && get32(store_ans,i*4)==9101+i){c=c+1;}
    else { emit("STORE_MISS D "); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("STORE_OK "); e64(c); emit("/6\n");
  return c;
}
// serving-node check: activate's node must be the content-expected live fact.
fn ow_serve_ok(W:[]u8,s:i32,r:i32,exp:i32,got:i32)i32 {
  if(got!=exp){return 0;}
  let n:i32=activate(W,s,r);
  if(n<2){return 0;}
  if(ng(W,n,36)!=1 || ng(W,n,0)!=1){return 0;}
  if(ng(W,n,20)!=s || ng(W,n,24)!=r || ng(W,n,28)!=exp){return 0;}
  if(is_superseded(W,n)==1){return 0;}
  return 1;
}
// One 12-probe block (6 family-D + 6 family-E). d_hit counts D probes
// returning the integrated chain value; d_miss counts D probes returning
// -2 (true miss); e_ok counts E probes served by standing retrieval.
fn ow_probes(W:[]u8,tag:[]u8,dhit:[]u8,dmiss:[]u8,eok:[]u8)void {
  emit("PHASE "); emit(tag); emit("\n");
  let dh:i32=0; let dm:i32=0; let eo:i32=0; let i:i32=0;
  while(i<6){
    let a:i32=ow_mquery(W,9501+i,702);
    if(a==9101+i && ow_serve_ok(W,9501+i,702,9101+i,a)==1){dh=dh+1;}
    if(a==-2){dm=dm+1;}
    i=i+1;
  }
  i=0;
  while(i<6){
    let a:i32=ow_mquery(W,9601+i,801);
    if(ow_serve_ok(W,9601+i,801,9701+i,a)==1){eo=eo+1;}
    i=i+1;
  }
  emit("D_HIT "); e64(dh); emit("/6 D_MISS "); e64(dm); emit("/6\n");
  emit("E_OK "); e64(eo); emit("/6\n");
  set32(dhit,0,dh); set32(dmiss,0,dm); set32(eok,0,eo);
  return;
}
// read-only mechanism census after a phase (CO-2 evidence).
fn ow_census(W:[]u8,ph:[]u8)void {
  emit("CENSUS "); emit(ph);
  emit(" MAPC="); e64(ow_count_nodes(W,20));
  emit(" DEPC="); e64(ow_count_edges(W,1));
  emit(" UNC="); e64(ow_count_nodes(W,30));
  emit(" GUIDEC="); e64(ow_count_guides(W));
  emit(" N1="); e64(ow_count_nodes(W,1));
  emit(" Eall="); e64(ow_count_edges_all(W));
  emit("\n");
  return;
}
// ============ entry ============
fn ow_main()i32 {
  emit("MODE OW\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let store_ans:[]u8=z_alloc(24);
  let dhit:[]u8=z_alloc(4); let dmiss:[]u8=z_alloc(4); let eok:[]u8=z_alloc(4);
  ow_store(W,store_ans);
  ow_census(W,"STORE");
  let store_ok:i32=ow_store_ok(W,store_ans);
  let i:i32=0;
  emit("PHASE INTERFERE-1\n");
  while(i<30){ ow_event(W,1,11001+i,901,11101+i); i=i+1; }
  ow_probes(W,"REUSE",dhit,dmiss,eok);
  let reuse_ok:i32=get32(dhit,0)+get32(eok,0);
  let sanity_e:i32=get32(eok,0);
  ow_census(W,"REUSE");
  i=0;
  emit("PHASE INTERFERE-2\n");
  while(i<20){ ow_event(W,1,12001+i,902,12101+i); i=i+1; }
  ow_probes(W,"DELAYED",dhit,dmiss,eok);
  let delayed_ok:i32=get32(dhit,0)+get32(eok,0);
  ow_census(W,"DELAYED");
  emit("STORE_OK_SUM "); e64(store_ok); emit("/6\n");
  emit("REUSE_OK_SUM "); e64(reuse_ok); emit("/12\n");
  emit("SANITY_E_SUM "); e64(sanity_e); emit("/6\n");
  emit("DELAYED_OK_SUM "); e64(delayed_ok); emit("/12\n");
  let u30:i32=ow_count_nodes(W,30);
  emit("UNCERT "); e64(u30); emit("\n");
  emit("FNV "); e64(ow_fnv(W)); emit("\n");
  if(hg(W,52)==98){ emit("AUDIT_PASS\n"); }
  else { emit("AUDIT_FAIL count="); e64(hg(W,52)); emit(" want=98\n"); return 1; }
  return 0;
}
fn main()i32 { return ow_main(); }

// e5_controls.zag -- E5 calibration controls (PREREG_E5 section 6).
// Writes synthetic inspector reports and transcripts:
//   competent_rev: LAWSTRUCT-conformant structure + blind transcript
//                  with ANSWER[5]=72343. Checker must print
//                  LAWSTRUCT=1 and VERDICT E5-LAW-REVISED.
//   competent_inst: per-instance structures only + blind transcript
//                  with ANSWER[5]=72323, ANSWER[6]=72421. Checker must
//                  print LAWSTRUCT=0 and VERDICT E5-INSTANCE-ONLY.
//   degenerate: no structures + blind transcript with -2 on the
//                  discriminating probes. Checker must print
//                  VERDICT E5-AMBIGUOUS.
// Usage: e5_controls_bin <outdir>. Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn app_str(buf:[]u8,pos:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
  return pos+s.len;
}
fn join_path(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+name.len+2);
  let p:i32=app_str(b,0,dir);
  if(dir.len>0 && dir[dir.len-1]!=47){ b[p]=47; p=p+1; }
  p=app_str(b,p,name);
  return b[0..p];
}
fn wfile(dir:[]u8,name:[]u8,body:[]u8)void {
  let p:[]u8=join_path(dir,name);
  if(_zag_write_file(p,body)!=0){ errln("write failed"); return; }
  emit("WROTE "); _zag_print(p); emit("\n");
  return;
}

fn main()i32 {
  if(_zag_argc()!=2){
    errln("usage: e5_controls_bin <outdir>");
    return 2;
  }
  let dir:[]u8=_zag_arg(1);
  if(dir.len>0 && dir[dir.len-1]==10){ dir=dir[0..dir.len-1]; }
  // Valid oracle transcript shared by all controls (E5-VALID shape).
  let valid_oracle:[]u8="WORLD_BEGIN\nANSWER 72301 72809 72321\nANSWER 72302 72809 72322\nANSWER 72401 72819 72421\nANSWER 72301 72809 72341\nANSWER 72302 72809 72342\nANSWER 72303 72809 72323\nANSWER 72401 72819 72421\nANSWER 72402 72819 72422\nANSWER 72303 72801 72313\nANSWER 72313 72802 72323\nANSWER 72311 72802 72321\nWORLD_END events=27 answers=11\nSTATE_SAVED\n";
  // competent_rev: law-level structure + revised third instance.
  wfile(dir,"rev_report.txt",
    "OBSERVES 14\nSTRUCTURE id=5 subj=72301 rel=72809 answer=72341\nEVIDENCE (72301,72809,72341) (72302,72809,72342) count=2\nSTRUCTURES 1\n");
  wfile(dir,"rev_oracle_trans.txt", valid_oracle);
  wfile(dir,"rev_blind_trans.txt",
    "WORLD_BEGIN\nANSWER 72301 72809 72321\nANSWER 72302 72809 72322\nANSWER 72401 72819 72421\nANSWER 72301 72809 72341\nANSWER 72302 72809 72342\nANSWER 72303 72809 72343\nANSWER 72401 72819 72421\nANSWER 72402 72819 72422\nANSWER 72303 72801 72313\nANSWER 72313 72802 72323\nANSWER 72311 72802 72321\nWORLD_END events=27 answers=11\n");
  // competent_inst: per-instance structures only + old-law answers.
  wfile(dir,"inst_report.txt",
    "OBSERVES 14\nSTRUCTURE id=5 subj=72301 rel=72809 answer=72341\nEVIDENCE (72301,72809,72341) count=1\nSTRUCTURE id=6 subj=72302 rel=72809 answer=72342\nEVIDENCE (72302,72809,72342) count=1\nSTRUCTURES 2\n");
  wfile(dir,"inst_oracle_trans.txt", valid_oracle);
  wfile(dir,"inst_blind_trans.txt",
    "WORLD_BEGIN\nANSWER 72301 72809 72321\nANSWER 72302 72809 72322\nANSWER 72401 72819 72421\nANSWER 72301 72809 72341\nANSWER 72302 72809 72342\nANSWER 72303 72809 72323\nANSWER 72401 72819 72421\nANSWER 72402 72819 72422\nANSWER 72303 72801 72313\nANSWER 72313 72802 72323\nANSWER 72311 72802 72321\nWORLD_END events=27 answers=11\n");
  // degenerate: nothing in state, misses on discriminating probes.
  wfile(dir,"deg_report.txt",
    "OBSERVES 14\nSTRUCTURES 0\n");
  wfile(dir,"deg_oracle_trans.txt", valid_oracle);
  wfile(dir,"deg_blind_trans.txt",
    "WORLD_BEGIN\nANSWER 72301 72809 72321\nANSWER 72302 72809 72322\nANSWER 72401 72819 72421\nANSWER 72301 72809 72341\nANSWER 72302 72809 72342\nANSWER 72303 72809 -2\nANSWER 72401 72819 -2\nANSWER 72402 72819 72422\nANSWER 72303 72801 72313\nANSWER 72313 72802 72323\nANSWER 72311 72802 72321\nWORLD_END events=27 answers=11\n");
  emit("E5 controls written.\n");
  return 0;
}

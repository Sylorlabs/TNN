// e5_check.zag -- E5 bar checker (PREREG_E5 section 4).
// Usage: e5_check_bin <inspect_report> <oracle_transcript> <blind_transcript>
// Applies the frozen E5 decision rule: E5-VALID on the oracle-present
// transcript, SIGNATURE-INSTANCE-ONLY / SIGNATURE-LAW-REVISED on the
// blind transcript, LAWSTRUCT on the inspector report.
// Prints one BAR line and one VERDICT line. Pure Zag, pinned znc.
// NOTE: u8-backed cells with put32/ig only; never as-*i32 slice construction.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
// collect ANSWER object values in order into out (cap 32). Returns count.
fn collect_answers(d:[]u8,out:[]u8)i32 {
  let n:i32=d.len;
  let s:i32=0;
  let c:i32=0;
  while(s<n && c<32){
    let le:i32=line_end(d,s,n);
    let f0s:i32=skip_ws(d,s,le);
    if(f0s<le){
      let f0e:i32=field_end(d,f0s,le);
      if(word_is(d,f0s,f0e-f0s,"ANSWER")==1){
        let s1:i32=skip_ws(d,f0e,le);
        let e1:i32=field_end(d,s1,le);
        let s2:i32=skip_ws(d,e1,le);
        let e2:i32=field_end(d,s2,le);
        let s3:i32=skip_ws(d,e2,le);
        let e3:i32=field_end(d,s3,le);
        if(s3<le && is_int(d,s3,e3)==1 && skip_ws(d,e3,le)>=le){
          put32(out,c*4,parse_i32(d,s3,e3));
          c=c+1;
        }
      }
    }
    s=le+1;
  }
  return c;
}
// parse one parenthesized triple "(v1,v2,v3)" starting at q (d[q]==40).
// Writes values to tr (12 bytes). Returns 1 on success.
fn parse_triple(d:[]u8,q:i32,lim:i32,tr:[]u8)i32 {
  let a:i32=q+1;
  let vals:[]u8=z_alloc(12);
  let k:i32=0;
  while(k<3){
    while(a<lim && (d[a]==32 || d[a]==9)){ a=a+1; }
    let neg:i32=0;
    if(a<lim && d[a]==45){ neg=1; a=a+1; }
    if(a>=lim || d[a]<48 || d[a]>57){ return 0; }
    let v:i32=0;
    while(a<lim && d[a]>=48 && d[a]<=57){ v=v*10+(d[a] as i32-48); a=a+1; }
    if(neg==1){ v=0-v; }
    put32(vals,k*4,v);
    while(a<lim && (d[a]==32 || d[a]==9)){ a=a+1; }
    if(k<2){
      if(a>=lim || d[a]!=44){ return 0; }
      a=a+1;
    }
    k=k+1;
  }
  while(a<lim && (d[a]==32 || d[a]==9)){ a=a+1; }
  if(a>=lim || d[a]!=41){ return 0; }
  put32(tr,0,ig(vals,0)); put32(tr,4,ig(vals,4)); put32(tr,8,ig(vals,8));
  return 1;
}
// LAWSTRUCT: any STRUCTURE with rel=72809 whose EVIDENCE contains both
// (72301,72809,72341) and (72302,72809,72342).
fn lawstruct(d:[]u8)i32 {
  let n:i32=d.len;
  let s:i32=0;
  let tr:[]u8=z_alloc(12);
  while(s<n){
    let le:i32=line_end(d,s,n);
    let f0s:i32=skip_ws(d,s,le);
    if(f0s<le){
      let f0e:i32=field_end(d,f0s,le);
      if(word_is(d,f0s,f0e-f0s,"STRUCTURE")==1){
        let p:i32=f0e;
        let rel:i32=-1;
        while(p+4<=le){
          if(d[p]==114 && d[p+1]==101 && d[p+2]==108 && d[p+3]==61){
            let vs:i32=p+4; let ve:i32=field_end(d,vs,le);
            if(is_int(d,vs,ve)==1){ rel=parse_i32(d,vs,ve); }
            p=ve;
          } else { p=p+1; }
        }
        if(rel==72809){
          let le2:i32=line_end(d,le+1,n);
          let q:i32=s;
          let t1:i32=0; let t2:i32=0;
          while(q<le2){
            if(d[q]==40){
              if(parse_triple(d,q,le2,tr)==1){
                if(ig(tr,0)==72301 && ig(tr,4)==72809 && ig(tr,8)==72341){ t1=1; }
                if(ig(tr,0)==72302 && ig(tr,4)==72809 && ig(tr,8)==72342){ t2=1; }
              }
            }
            q=q+1;
          }
          if(t1==1 && t2==1){ return 1; }
        }
      }
    }
    s=le+1;
  }
  return 0;
}

fn main()i32 {
  if(_zag_argc()!=4){
    errln("usage: e5_check_bin <inspect_report> <oracle_transcript> <blind_transcript>");
    return 2;
  }
  let rp:[]u8=_zag_arg(1);
  let op:[]u8=_zag_arg(2);
  let bp:[]u8=_zag_arg(3);
  if(_zag_file_exists(rp)==0 || _zag_file_exists(op)==0 || _zag_file_exists(bp)==0){
    errln("input missing"); return 3;
  }
  let rd:[]u8=_zag_read_file(rp);
  let od:[]u8=_zag_read_file(op);
  let bd:[]u8=_zag_read_file(bp);
  let oa:[]u8=z_alloc(32*4);
  let ba:[]u8=z_alloc(32*4);
  let no:i32=collect_answers(od,oa);
  let nb:i32=collect_answers(bd,ba);
  let valid:i32=0;
  if(no==11){
    if(ig(oa,0*4)==72321 && ig(oa,1*4)==72322 && ig(oa,2*4)==72421 &&
       ig(oa,3*4)==72341 && ig(oa,4*4)==72342 &&
       ig(oa,7*4)==72422 && ig(oa,8*4)==72313 &&
       ig(oa,9*4)==72323 && ig(oa,10*4)==72321){
      valid=1;
    }
  }
  let ctrl:i32=0;
  if(no==11 && ig(oa,3*4)==72341 && ig(oa,4*4)==72342){ ctrl=1; }
  let third:i32=-999999;
  let analog:i32=-999999;
  if(nb==11){ third=ig(ba,5*4); analog=ig(ba,6*4); }
  let ls:i32=lawstruct(rd);
  emit("BAR E5-W1 VALID="); e64(valid);
  emit(" CTRL="); e64(ctrl);
  emit(" THIRD="); e64(third);
  emit(" ANALOG="); e64(analog);
  emit(" LAWSTRUCT="); e64(ls);
  emit(" NANS_O="); e64(no);
  emit(" NANS_B="); e64(nb);
  emit("\n");
  if(valid==0){
    emit("VERDICT E5-INCONCLUSIVE\n");
    return 0;
  }
  if(third==72343){
    emit("VERDICT E5-LAW-REVISED\n");
    return 0;
  }
  if(ls==1){
    emit("VERDICT E5-LAW-TRACE\n");
    return 0;
  }
  if(third==72323 && analog==72421){
    emit("VERDICT E5-INSTANCE-ONLY\n");
    return 0;
  }
  emit("VERDICT E5-AMBIGUOUS\n");
  return 0;
}

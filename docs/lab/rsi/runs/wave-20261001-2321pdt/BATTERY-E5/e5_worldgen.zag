// e5_worldgen.zag -- E5 sealed world generator. Pure Zag.
// Emits the exact byte streams frozen in PREREG_E5.md section 3.
// No cognition, no semantic cases, no modes: fixed strings only.
// Writes: e5_worlds/e5_w1_oracle.txt, e5_worlds/e5_w1_blind.txt,
//         e5_oracles/e5w1.oracle
// Usage: e5_worldgen_bin <worldsdir> <oraclesdir> (both must exist)

fn emit(s:[]u8)void { _zag_print(s); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn app_str(buf:[]u8,pos:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
  return pos+s.len;
}
fn join_path(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+name.len+2);
  let p:i32=app_str(b,0,dir);
  if(dir.len>0 && dir[dir.len-1]!=47){ b[p]=47; p=p+1; }
  p=app_str(b,p,name);
  return b[0..p];
}
fn wput(path:[]u8, content:[]u8)i32 {
  if(_zag_write_file(path, content)!=0){ errln("write failed"); return 1; }
  emit("WROTE "); _zag_print(path); emit("\n");
  return 0;
}

fn main()i32 {
  if(_zag_argc()!=3){
    errln("usage: e5_worldgen_bin <worldsdir> <oraclesdir>");
    return 2;
  }
  let wdir:[]u8=_zag_arg(1);
  if(wdir.len>0 && wdir[wdir.len-1]==10){ wdir=wdir[0..wdir.len-1]; }
  let odir:[]u8=_zag_arg(2);
  if(odir.len>0 && odir[odir.len-1]==10){ odir=odir[0..odir.len-1]; }
  // Oracle variant: 3-field QUERY lines with world-determined values.
  let w_oracle:[]u8="OBSERVE 72301 72801 72311\nOBSERVE 72302 72801 72312\nOBSERVE 72303 72801 72313\nOBSERVE 72311 72802 72321\nOBSERVE 72312 72802 72322\nOBSERVE 72313 72802 72323\nOBSERVE 72401 72811 72411\nOBSERVE 72402 72811 72412\nOBSERVE 72411 72812 72421\nOBSERVE 72412 72812 72422\nQUERY 72301 72809 72321\nQUERY 72302 72809 72322\nQUERY 72401 72819 72421\nOBSERVE 72951 72960 72971\nOBSERVE 72952 72960 72972\nOBSERVE 72301 72809 72341\nOBSERVE 72302 72809 72342\nOBSERVE 72953 72960 72973\nOBSERVE 72954 72960 72974\nQUERY 72301 72809 72341\nQUERY 72302 72809 72342\nQUERY 72303 72809 72323\nQUERY 72401 72819 72421\nQUERY 72402 72819 72422\nQUERY 72303 72801 72313\nQUERY 72313 72802 72323\nQUERY 72311 72802 72321\n";
  // Blind variant: 2-field QUERY lines (blind driver fails closed on 3 fields).
  let w_blind:[]u8="OBSERVE 72301 72801 72311\nOBSERVE 72302 72801 72312\nOBSERVE 72303 72801 72313\nOBSERVE 72311 72802 72321\nOBSERVE 72312 72802 72322\nOBSERVE 72313 72802 72323\nOBSERVE 72401 72811 72411\nOBSERVE 72402 72811 72412\nOBSERVE 72411 72812 72421\nOBSERVE 72412 72812 72422\nQUERY 72301 72809\nQUERY 72302 72809\nQUERY 72401 72819\nOBSERVE 72951 72960 72971\nOBSERVE 72952 72960 72972\nOBSERVE 72301 72809 72341\nOBSERVE 72302 72809 72342\nOBSERVE 72953 72960 72973\nOBSERVE 72954 72960 72974\nQUERY 72301 72809\nQUERY 72302 72809\nQUERY 72303 72809\nQUERY 72401 72819\nQUERY 72402 72819\nQUERY 72303 72801\nQUERY 72313 72802\nQUERY 72311 72802\n";
  // Sealed oracle record: world-determined probe values in order (scorer-side only).
  let sealed:[]u8="72321\n72322\n72421\n72341\n72342\n72323\n72421\n72422\n72313\n72323\n72321\n";
  let bad:i32=0;
  bad=bad+wput(join_path(wdir,"e5_w1_oracle.txt"), w_oracle);
  bad=bad+wput(join_path(wdir,"e5_w1_blind.txt"), w_blind);
  bad=bad+wput(join_path(odir,"e5w1.oracle"), sealed);
  if(bad!=0){ return 1; }
  emit("E5 worlds generated.\n");
  return 0;
}

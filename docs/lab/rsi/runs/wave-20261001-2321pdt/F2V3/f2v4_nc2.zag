fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
// f2v4_nc2.zag -- NC2 memorization-replay baseline for C2-prime (F2 v4).
// Standalone pure-Zag program. Stores the passive trace and all executed
// discrimination experiment trajectories, then acts by longest-suffix
// replay of goalvar observation histories (WAIT on no match). No causal
// model, no simulation under hypotheses. The agent (replay logic) uses
// only the w_* environment interface; the true laws below are the
// environment's physics (as in the learner binaries), never read by the
// agent's decision procedure.
// Expected: NC2_RESULT 0 (the sustained predicate is not achieved).

// ---- environment (copied world physics; agent never reads these) ----
fn C2_D1()i32 { return 3; }
fn C2_D2()i32 { return 2; }
fn C2_J1()i32 { return 1; }
fn C2_K1()i32 { return 1; }
fn D_truerules()[]u8 {
  let r:[]u8=z_alloc(10);
  r[0]=0; r[1]=1; r[2]=C2_D1() as u8; r[3]=3; r[4]=C2_J1() as u8;
  r[5]=0; r[6]=2; r[7]=C2_D2() as u8; r[8]=4; r[9]=C2_K1() as u8;
  return r;
}
fn D_cxs()[]u8 {
  let c:[]u8=z_alloc(5);
  c[0]=255; c[1]=3; c[2]=3; c[3]=4; c[4]=4;
  return c;
}
fn NC_ispersist(e:i32, cxs:[]u8, nctx:i32)i32 {
  let i:i32=0;
  while(i<nctx){ if((cxs[i] as i32)==e){ return 1; } i=i+1; }
  return 0;
}
fn NC_advance(hist:[]u8, t:i32)void {
  let rules:[]u8=D_truerules();
  let cxs:[]u8=D_cxs();
  let e:i32=0;
  while(e<5){
    if(NC_ispersist(e,cxs,5)==1){
      hist[e*32+t]=hist[e*32+t-1];
    } else {
      let nv:i32=0;
      let r:i32=0;
      while(r<2){
        let b:i32=r*5;
        if((rules[b+1] as i32)==e){
          let c:i32=rules[b] as i32;
          let d:i32=rules[b+2] as i32;
          let s:i32=t-d;
          if(s>=0 && hist[c*32+s]==1){
            let cx:i32=rules[b+3] as i32;
            if(cx==255){ nv=1; }
            else if(hist[cx*32+s]==rules[b+4]){ nv=1; }
          }
        }
        r=r+1;
      }
      hist[e*32+t]=nv as u8;
    }
    e=e+1;
  }
  return;
}
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+5*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    let hist:[]u8=z_alloc(5*32);
    let i:i32=0;
    while(i<5*32){ hist[i]=ws[8+i]; i=i+1; }
    NC_advance(hist,t);
    i=0;
    while(i<5*32){ ws[8+i]=hist[i]; i=i+1; }
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snap4(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  out[0]=ws[8+1*32+t];
  out[1]=ws[8+2*32+t];
  out[2]=ws[8+3*32+t];
  out[3]=ws[8+4*32+t];
  return;
}
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==0){ ws[8+3*32+t]=1; ws[8+4*32+t]=1; }
  if(t==3 || t==8 || t==13){ ws[8+0*32+t]=1; }
  return;
}
fn w_goal_setup(ws:[]u8)void {
  ws[8+3*32+0]=0;
  ws[8+4*32+0]=0;
  return;
}

// ---- replay memory ----
// mem_obs: flat nsteps*4 bytes ([Y1,Y2,J,K] per step).
// mem_ak, mem_av: action kind/var taken IN that step's observation.
// mem_tb: trajectory boundaries (start indices), mem_ntraj count.
fn NC_mem_init()[]u8 {
  let m:[]u8=z_alloc(512);
  set32(m,0,0);    // nsteps
  set32(m,4,0);    // ntraj
  return m;
}
fn NC_mem_nsteps(m:[]u8)i32 { return get32(m,0); }
fn NC_mem_begin_traj(m:[]u8)void {
  let nt:i32=get32(m,4);
  // traj start table lives after the step area; store start index
  set32(m,8+nt*4,get32(m,0));
  set32(m,4,nt+1);
  return;
}
fn NC_mem_push(m:[]u8, o:[]u8, ak:i32, av:i32)void {
  let n:i32=get32(m,0);
  let b:i32=8+8*4+n*6;
  m[b]=o[0]; m[b+1]=o[1]; m[b+2]=o[2]; m[b+3]=o[3];
  m[b+4]=ak as u8; m[b+5]=av as u8;
  set32(m,0,n+1);
  return;
}
fn NC_mem_obs(m:[]u8, i:i32, o:[]u8)void {
  let b:i32=8+8*4+i*6;
  o[0]=m[b]; o[1]=m[b+1]; o[2]=m[b+2]; o[3]=m[b+3];
  return;
}
fn NC_mem_act(m:[]u8, i:i32)[]u8 {
  let b:i32=8+8*4+i*6;
  let a:[]u8=z_alloc(2);
  a[0]=m[b+4]; a[1]=m[b+5];
  return a;
}
fn NC_traj_end(m:[]u8, ti:i32, nsteps:i32)i32 {
  let nt:i32=get32(m,4);
  if(ti+1<nt){ return get32(m,8+(ti+1)*4); }
  return nsteps;
}

// longest-suffix replay: current goal-phase history gh (ghn steps of
// 4-byte obs). Returns action kind/var in out[2]; out[2] set to -1 if
// no match (caller WAITs).
fn NC_replay(m:[]u8, gh:[]u8, ghn:i32, out:[]u8)void {
  let nsteps:i32=get32(m,0);
  let nt:i32=get32(m,4);
  let L:i32=ghn;
  if(L>nsteps){ L=nsteps; }
  let o:[]u8=z_alloc(4);
  let q:[]u8=z_alloc(4);
  while(L>=1){
    let ti:i32=0;
    while(ti<nt){
      let ts:i32=get32(m,8+ti*4);
      let te:i32=NC_traj_end(m,ti,nsteps);
      let j:i32=ts;
      while(j+L<=te){
        // compare mem obs [j..j+L-1] with gh [ghn-L..ghn-1]
        let k:i32=0;
        let ok:i32=1;
        while(k<L){
          NC_mem_obs(m,j+k,o);
          q[0]=gh[(ghn-L+k)*4]; q[1]=gh[(ghn-L+k)*4+1];
          q[2]=gh[(ghn-L+k)*4+2]; q[3]=gh[(ghn-L+k)*4+3];
          if(o[0]!=q[0] || o[1]!=q[1] || o[2]!=q[2] || o[3]!=q[3]){ ok=0; }
          k=k+1;
        }
        if(ok==1){
          let a:[]u8=NC_mem_act(m,j+L-1);
          out[0]=a[0]; out[1]=a[1]; out[2]=0;
          return;
        }
        j=j+1;
      }
      ti=ti+1;
    }
    L=L-1;
  }
  out[2]=-1;
  return;
}

// action name for the log
fn NC_aname(ak:i32, av:i32)[]u8 {
  if(ak==2){ return "W"; }
  if(ak==3){ return "OX"; }
  if(ak==0 && av==0){ return "SX"; }
  if(ak==1 && av==0){ return "CX"; }
  if(ak==0 && av==3){ return "SJ"; }
  if(ak==1 && av==3){ return "CJ"; }
  if(ak==0 && av==4){ return "SK"; }
  if(ak==1 && av==4){ return "CK"; }
  return "?";
}

fn main()i32 {
  let ws:[]u8=z_alloc(8+5*32);
  let m:[]u8=NC_mem_init();
  let o:[]u8=z_alloc(4);
  // action tables for the 4 sealed discrimination experiments
  // kinds: 0=SET 1=CLR 2=WAIT 3=OBSERVE
  let s1k:[]u8=z_alloc(9); let s1v:[]u8=z_alloc(9);
  s1k[0]=0; s1v[0]=0; s1k[1]=0; s1v[1]=3; s1k[2]=2; s1v[2]=0;
  s1k[3]=1; s1v[3]=3; s1k[4]=2; s1v[4]=0; s1k[5]=2; s1v[5]=0;
  s1k[6]=2; s1v[6]=0; s1k[7]=2; s1v[7]=0; s1k[8]=3; s1v[8]=0;
  let s2k:[]u8=z_alloc(8); let s2v:[]u8=z_alloc(8);
  s2k[0]=0; s2v[0]=0; s2k[1]=0; s2v[1]=3; s2k[2]=2; s2v[2]=0;
  s2k[3]=2; s2v[3]=0; s2k[4]=2; s2v[4]=0; s2k[5]=2; s2v[5]=0;
  s2k[6]=2; s2v[6]=0; s2k[7]=3; s2v[7]=0;
  let s3k:[]u8=z_alloc(8); let s3v:[]u8=z_alloc(8);
  s3k[0]=0; s3v[0]=0; s3k[1]=0; s3v[1]=4; s3k[2]=2; s3v[2]=0;
  s3k[3]=2; s3v[3]=0; s3k[4]=2; s3v[4]=0; s3k[5]=2; s3v[5]=0;
  s3k[6]=2; s3v[6]=0; s3k[7]=3; s3v[7]=0;
  let s4k:[]u8=z_alloc(9); let s4v:[]u8=z_alloc(9);
  s4k[0]=0; s4v[0]=0; s4k[1]=0; s4v[1]=3; s4k[2]=2; s4v[2]=0;
  s4k[3]=0; s4v[3]=4; s4k[4]=2; s4v[4]=0; s4k[5]=2; s4v[5]=0;
  s4k[6]=2; s4v[6]=0; s4k[7]=2; s4v[7]=0; s4k[8]=3; s4v[8]=0;

  // trajectory 0: passive (18 steps; env SETs X at 3,8,13)
  w_reset(ws);
  NC_mem_begin_traj(m);
  let t:i32=0;
  while(t<18){
    w_passive(ws);
    w_snap4(ws,o);
    let ak:i32=2; let av:i32=0;
    if(t==3 || t==8 || t==13){ ak=0; av=0; }
    NC_mem_push(m,o,ak,av);
    // apply the environment's own passive action, then advance
    if(ak==0){ w_act(ws,0,0); }
    w_act(ws,2,0);
    t=t+1;
  }
  // trajectories 1..4: the sealed discrimination experiments
  let si:i32=0;
  while(si<4){
    let sk:[]u8=s1k; let sv:[]u8=s1v; let sl:i32=9;
    if(si==1){ sk=s2k; sv=s2v; sl=8; }
    if(si==2){ sk=s3k; sv=s3v; sl=8; }
    if(si==3){ sk=s4k; sv=s4v; sl=9; }
    w_reset(ws);
    NC_mem_begin_traj(m);
    let s:i32=0;
    while(s<sl){
      w_snap4(ws,o);
      NC_mem_push(m,o,sk[s] as i32,sv[s] as i32);
      // one primitive per step, exactly as the learner executes it
      w_act(ws,sk[s] as i32,sv[s] as i32);
      s=s+1;
    }
    si=si+1;
  }
  emit("NC2 memory steps="); e64(NC_mem_nsteps(m)); emit(" trajs="); e64(get32(m,4)); emit("\n");

  // goal phase: longest-suffix replay, budget 30 steps
  w_reset(ws);
  w_goal_setup(ws);
  let gh:[]u8=z_alloc(31*4);
  let ghn:i32=0;
  let consec:i32=0;
  let res:i32=0;
  let step:i32=0;
  emit("NC2 replay actions: ");
  while(step<30){
    w_snap4(ws,o);
    gh[ghn*4]=o[0]; gh[ghn*4+1]=o[1]; gh[ghn*4+2]=o[2]; gh[ghn*4+3]=o[3];
    ghn=ghn+1;
    if(o[0]==1 && o[1]==1 && o[2]==1 && o[3]==1){ consec=consec+1; }
    else { consec=0; }
    if(consec>=3){ res=1; step=30; }
    else {
      let out:[]u8=z_alloc(3);
      NC_replay(m,gh,ghn,out);
      let ak:i32=2; let av:i32=0;
      if(out[2]==0){ ak=out[0] as i32; av=out[1] as i32; }
      emit(NC_aname(ak,av)); emit(",");
      w_act(ws,ak,av);
      step=step+1;
    }
  }
  emit("\nNC2_RESULT "); e64(res); emit("\n");
  if(res==0){ emit("NC2_BASELINE_FAILS_SUSTAINED_PREDICATE\n"); }
  return 0;
}

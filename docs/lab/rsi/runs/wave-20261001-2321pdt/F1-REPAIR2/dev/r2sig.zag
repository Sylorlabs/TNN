// r2sig.zag - S-prime + POLICY-R extractor (F1-REPAIR2 lane).
// Reads one f1_learn train trace and reports, in pure trace terms:
//   - T1: episode of the first TRIGGER line
//   - deg: 1 iff the first-trigger burst's second construct is degenerate
//     (c0 = ADD r0,f,f doubling one feature; c1 = ADD r0,*,* adding no
//     complementary feature), else 0  (frozen F1-REPAIR definition)
//   - Sprime: 1 iff at least one later-trigger (t > T1) burst with >= 1
//     CONSTRUCT has last CONSTRUCT err_after=0 (ANY buf), else 0
//   - polok: 1 iff every later-trigger burst with >= 1 CONSTRUCT satisfies
//     POLICY-R (runs to err_after=0 iff first construct is a DOUBLING:
//     op=ADD, p1=0, p2==p3, p2 in {8,9}), else 0
// usage: r2sig <seedidx> <train.trace>
// Output (one line):
//   R2SIG seed=<i> trig=<t1> deg=<d> Sprime=<s> nrep=<n> polok=<p> bursts=<ep,buf,ncon,dbl,last;...>
// If no TRIGGER line exists: R2SIG seed=<i> NOTRIG.
// If a TRIGGER/CONSTRUCT line fails the frozen grammar: R2SIG seed=<i> PARSEFAIL.
// Pure Zag, compiled by the pinned znc. External probe; no learner logic.

fn r2_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn r2_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn r2_starts(line:[]u8, pre:[]u8)i64 {
    if(line.len < pre.len) { return 0; }
    let i:i64 = 0;
    while(i < pre.len) {
        if(line[i] != pre[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn r2_eq(a:[]u8, b:[]u8)i64 {
    if(a.len != b.len) { return 0; }
    let i:i64 = 0;
    while(i < a.len) {
        if(a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn r2_after_eq(tok:[]u8)i64 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return 0; }
    return _zag_str_to_i64(tok[p+1..tok.len]);
}

fn r2_after_eq_s(tok:[]u8)[]u8 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return ""; }
    return tok[p+1..tok.len];
}

fn r2_ig(c:[]u8, i:i64)i64 {
    return (c[i*8] as i64) | ((c[i*8+1] as i64) << 8) | ((c[i*8+2] as i64) << 16) | ((c[i*8+3] as i64) << 24) | ((c[i*8+4] as i64) << 32) | ((c[i*8+5] as i64) << 40) | ((c[i*8+6] as i64) << 48) | ((c[i*8+7] as i64) << 56);
}

fn r2_is(c:[]u8, i:i64, v:i64)void {
    c[i*8] = (v & 255) as u8;
    c[i*8+1] = ((v >> 8) & 255) as u8;
    c[i*8+2] = ((v >> 16) & 255) as u8;
    c[i*8+3] = ((v >> 24) & 255) as u8;
    c[i*8+4] = ((v >> 32) & 255) as u8;
    c[i*8+5] = ((v >> 40) & 255) as u8;
    c[i*8+6] = ((v >> 48) & 255) as u8;
    c[i*8+7] = ((v >> 56) & 255) as u8;
}

// Finalize one open later burst: count repair events, check POLICY-R,
// append "ep,buf,ncon,dbl,last;" to blist. Cells: bc=cursor, rc=repcount,
// pc=polok.
fn r2_fin(blist:[]u8, bc:[]u8, rc:[]u8, pc:[]u8, ep:i64, buf:i64, ncon:i64, dbl:i64, last:i64)void {
    if(last == 0) { r2_is(rc, 0, r2_ig(rc, 0) + 1); }
    let complete:i64 = 0;
    if(last == 0) { complete = 1; }
    if(complete != dbl) { r2_is(pc, 0, 0); }
    let f0:[]u8 = _zag_i64_to_str(ep);
    let f1:[]u8 = _zag_i64_to_str(buf);
    let f2:[]u8 = _zag_i64_to_str(ncon);
    let f3:[]u8 = _zag_i64_to_str(dbl);
    let f4:[]u8 = _zag_i64_to_str(last);
    let part:i64 = 0;
    while(part < 5) {
        let fld:[]u8 = f0;
        if(part == 1) { fld = f1; }
        if(part == 2) { fld = f2; }
        if(part == 3) { fld = f3; }
        if(part == 4) { fld = f4; }
        let cur:i64 = r2_ig(bc, 0);
        let k:i64 = 0;
        while(k < fld.len && cur < 4088) { blist[cur] = fld[k]; cur = cur + 1; k = k + 1; }
        if(cur < 4094) {
            if(part < 4) { blist[cur] = 44; } else { blist[cur] = 59; }
            cur = cur + 1;
        }
        r2_is(bc, 0, cur);
        part = part + 1;
    }
}

fn main()i32 {
    if(_zag_argc() < 3) { _zag_println("usage: r2sig <seedidx> <train.trace>"); return 2; }
    let seedidx:[]u8 = _zag_arg(1);
    let text:[]u8 = _zag_read_file(_zag_arg(2));
    if(text.len == 0) { _zag_println("ERR read"); return 2; }

    let t1:i64 = -1;
    let cur_ep:i64 = -1;
    let cur_buf:i64 = 0;
    let cur_ncon:i64 = 0;
    let cur_dbl:i64 = 0;
    let cur_last_err:i64 = -1;
    let first_ncon:i64 = 0;
    let c0add:i64 = 0;
    let c0p2:i64 = -1;
    let c0p3:i64 = -1;
    let c1add:i64 = 0;
    let c1p1:i64 = -1;
    let c1p2:i64 = -1;
    let c1p3:i64 = -1;
    let parsefail:i64 = 0;

    let p:*u8 = _zag_malloc(4096) as *u8;
    let c:*u8 = _zag_malloc(24) as *u8;
    if(p == null as *u8 || c == null as *u8) { _zag_println("ERR alloc"); return 2; }
    let blist:[]u8 = p[0..4096];
    let cells:[]u8 = c[0..24];
    // cells: 0 = burst-list cursor, 1 = repair count, 2 = polok
    r2_is(cells, 0, 0);
    r2_is(cells, 1, 0);
    r2_is(cells, 2, 1);

    let i:i64 = 0;
    while(i < text.len) {
        let q:i64 = i;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[i..q];
        if(q < text.len) { q = q + 1; }
        i = q;

        if(r2_starts(line, "TRIGGER ") == 1) {
            if(r2_ntok(line) < 5) { parsefail = 1; }
            else {
                if(cur_ep >= 0 && cur_ep > t1 && cur_ncon >= 1) {
                    r2_fin(blist, cells[0..8], cells[8..16], cells[16..24], cur_ep, cur_buf, cur_ncon, cur_dbl, cur_last_err);
                }
                cur_ep = -1;
                let t:i64 = _zag_str_to_i64(r2_tok(line, 1));
                let b:i64 = r2_after_eq(r2_tok(line, 4));
                if(t1 < 0) { t1 = t; }
                cur_ep = t;
                cur_buf = b;
                cur_ncon = 0;
                cur_dbl = 0;
                cur_last_err = -1;
            }
        } else if(r2_starts(line, "CONSTRUCT ") == 1) {
            if(r2_ntok(line) < 11) { parsefail = 1; }
            else {
                let ep:i64 = _zag_str_to_i64(r2_tok(line, 1));
                let op:[]u8 = r2_after_eq_s(r2_tok(line, 5));
                let p1:i64 = r2_after_eq(r2_tok(line, 6));
                let p2:i64 = r2_after_eq(r2_tok(line, 7));
                let p3:i64 = r2_after_eq(r2_tok(line, 8));
                let erra:i64 = r2_after_eq(r2_tok(line, 10));
                if(cur_ep >= 0 && ep == cur_ep) {
                    if(cur_ncon == 0) {
                        if(r2_eq(op, "ADD") == 1 && p1 == 0 && p2 == p3 && (p2 == 8 || p2 == 9)) {
                            cur_dbl = 1;
                        }
                    }
                    cur_ncon = cur_ncon + 1;
                    cur_last_err = erra;
                    if(ep == t1) {
                        if(first_ncon == 0) {
                            c0add = r2_eq(op, "ADD");
                            c0p2 = p2;
                            c0p3 = p3;
                        } else if(first_ncon == 1) {
                            c1add = r2_eq(op, "ADD");
                            c1p1 = p1;
                            c1p2 = p2;
                            c1p3 = p3;
                        }
                        first_ncon = first_ncon + 1;
                    }
                } else {
                    if(cur_ep >= 0 && cur_ep > t1 && cur_ncon >= 1) {
                        r2_fin(blist, cells[0..8], cells[8..16], cells[16..24], cur_ep, cur_buf, cur_ncon, cur_dbl, cur_last_err);
                    }
                    cur_ep = -1;
                }
            }
        } else {
            if(cur_ep >= 0 && cur_ep > t1 && cur_ncon >= 1) {
                r2_fin(blist, cells[0..8], cells[8..16], cells[16..24], cur_ep, cur_buf, cur_ncon, cur_dbl, cur_last_err);
            }
            cur_ep = -1;
        }
    }
    if(cur_ep >= 0 && cur_ep > t1 && cur_ncon >= 1) {
        r2_fin(blist, cells[0..8], cells[8..16], cells[16..24], cur_ep, cur_buf, cur_ncon, cur_dbl, cur_last_err);
    }

    if(parsefail == 1) { _zag_print("R2SIG seed="); _zag_print(seedidx); _zag_println(" PARSEFAIL"); return 0; }
    if(t1 < 0) { _zag_print("R2SIG seed="); _zag_print(seedidx); _zag_println(" NOTRIG"); return 0; }

    let deg:i64 = 0;
    if(first_ncon >= 2 && c0add == 1 && c0p2 == c0p3) {
        let f:i64 = c0p2;
        let comp:i64 = -1;
        if(f == 8) { comp = 9; }
        if(f == 9) { comp = 8; }
        if(comp >= 0 && c1add == 1 && c1p1 == 0 && c1p2 != comp && c1p3 != comp) {
            deg = 1;
        }
    }
    let rep_count:i64 = r2_ig(cells, 1);
    let polok:i64 = r2_ig(cells, 2);
    let bcur:i64 = r2_ig(cells, 0);
    let s:i64 = 0;
    if(rep_count >= 1) { s = 1; }

    _zag_print("R2SIG seed=");
    _zag_print(seedidx);
    _zag_print(" trig=");
    _zag_print(_zag_i64_to_str(t1));
    _zag_print(" deg=");
    _zag_print(_zag_i64_to_str(deg));
    _zag_print(" Sprime=");
    _zag_print(_zag_i64_to_str(s));
    _zag_print(" nrep=");
    _zag_print(_zag_i64_to_str(rep_count));
    _zag_print(" polok=");
    _zag_print(_zag_i64_to_str(polok));
    _zag_print(" bursts=");
    _zag_print(blist[0..bcur]);
    _zag_println("");
    return 0;
}

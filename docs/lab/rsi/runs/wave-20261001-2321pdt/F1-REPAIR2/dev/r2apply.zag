// r2apply.zag - frozen decision-rule applier (F1-REPAIR2 lane).
// Reads the fresh per-seed table and applies PREREG_REPAIR2.md section 3.
// usage: r2apply <fresh_table.txt>
// Table line format:
//   SEED <i> <CORRECT|OVERFIT> DEG=<d> SPRIME=<s> TRIG=<t> NREP=<n> POLOK=<p>
// Output: D count, Part A misc + PASS/FAIL/INDETERMINATE, Part B misc +
// PASS/FAIL, and the overall verdict per the frozen rule.
// Pure Zag, compiled by the pinned znc. External probe; no learner logic.

fn ra_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn ra_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn ra_eq(a:[]u8, b:[]u8)i64 {
    if(a.len != b.len) { return 0; }
    let i:i64 = 0;
    while(i < a.len) {
        if(a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn ra_after_eq(tok:[]u8)i64 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return 0; }
    return _zag_str_to_i64(tok[p+1..tok.len]);
}

fn main()i32 {
    if(_zag_argc() < 2) { _zag_println("usage: r2apply <fresh_table.txt>"); return 2; }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { _zag_println("ERR read"); return 2; }

    let n:i64 = 0;
    let dcount:i64 = 0;
    let misc_a:i64 = 0;
    let misc_b:i64 = 0;

    let p:*u8 = _zag_malloc(2048) as *u8;
    if(p == null as *u8) { _zag_println("ERR alloc"); return 2; }
    let lst:[]u8 = p[0..2048];
    let lcur:i64 = 0;
    let q:*u8 = _zag_malloc(2048) as *u8;
    if(q == null as *u8) { _zag_println("ERR alloc"); return 2; }
    let lstb:[]u8 = q[0..2048];
    let lcurb:i64 = 0;

    let i:i64 = 0;
    while(i < text.len) {
        let e:i64 = i;
        while(e < text.len && text[e] != 10) { e = e + 1; }
        let line:[]u8 = text[i..e];
        if(e < text.len) { e = e + 1; }
        i = e;
        if(ra_ntok(line) < 8) { continue; }
        if(ra_eq(ra_tok(line, 0), "SEED") == 0) { continue; }
        let idx:[]u8 = ra_tok(line, 1);
        let lab:[]u8 = ra_tok(line, 2);
        let deg:i64 = ra_after_eq(ra_tok(line, 3));
        let sprime:i64 = ra_after_eq(ra_tok(line, 4));
        let polok:i64 = ra_after_eq(ra_tok(line, 7));
        n = n + 1;
        if(polok == 0) {
            misc_b = misc_b + 1;
            let k:i64 = 0;
            while(k < idx.len && lcurb < 2040) { lstb[lcurb] = idx[k]; lcurb = lcurb + 1; k = k + 1; }
            if(lcurb < 2047) { lstb[lcurb] = 32; lcurb = lcurb + 1; }
        }
        if(deg == 1) {
            dcount = dcount + 1;
            let correct:i64 = 0;
            if(ra_eq(lab, "CORRECT") == 1) { correct = 1; }
            if(correct != sprime) {
                misc_a = misc_a + 1;
                let k:i64 = 0;
                while(k < idx.len && lcur < 2040) { lst[lcur] = idx[k]; lcur = lcur + 1; k = k + 1; }
                if(lcur < 2047) { lst[lcur] = 32; lcur = lcur + 1; }
            }
        }
    }

    _zag_print("R2APPLY n=");
    _zag_print(_zag_i64_to_str(n));
    _zag_print(" D=");
    _zag_print(_zag_i64_to_str(dcount));
    _zag_println("");

    _zag_print("PARTA misc_D=");
    _zag_print(_zag_i64_to_str(misc_a));
    _zag_print(" mispred=[");
    _zag_print(lst[0..lcur]);
    _zag_print("] ");
    if(dcount < 6) { _zag_println("INDETERMINATE"); }
    else if(misc_a <= 2) { _zag_println("PASS"); }
    else { _zag_println("FAIL"); }

    _zag_print("PARTB misc_B=");
    _zag_print(_zag_i64_to_str(misc_b));
    _zag_print(" mispred=[");
    _zag_print(lstb[0..lcurb]);
    _zag_print("] ");
    if(misc_b <= 4) { _zag_println("PASS"); } else { _zag_println("FAIL"); }

    _zag_print("VERDICT ");
    if(dcount < 6) { _zag_println("REPAIR2-INDETERMINATE"); }
    else if(misc_a > 2) { _zag_println("REPAIR2-FAIL"); }
    else if(misc_b > 4) { _zag_println("REPAIR2-PARTIAL"); }
    else { _zag_println("REPAIR2-CONFIRMED"); }
    return 0;
}

// c174_gen.zag -- sealed world generator for the C174 battery.
// Seeded LCG, fully deterministic. Prints world_sealed.zag to stdout.
// Pure Zag. No Python.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn pi(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn rnd(st:i64)i64 { return (st*1103515245+12345)%2147483648; }
fn rbit(st:i64)i32 { return (st%2) as i32; }

fn main()i32 {
  let st:i64=20261001;
  emit("// world_sealed.zag -- sealed worlds for C174 battery.\n");
  emit("// Generated by c174_gen.zag, seed 20261001. DO NOT EDIT.\n");
  emit("// Regenerate: znc c174_gen.zag -o gen && ./gen > world_sealed.zag\n");
  emit("fn wgen_seed()i32 { return 20261001; }\n");

  // ---- W-REORDER: family success permille, shuffled multiset ----
  let fam:[]u8=z_alloc(24);
  set32(fam,0,150); set32(fam,4,300); set32(fam,8,450);
  set32(fam,12,600); set32(fam,16,750); set32(fam,20,900);
  let i:i32=5;
  while(i>0){
    st=rnd(st);
    let j:i32=(st%((i+1) as i64)) as i32;
    let t:i32=get32(fam,i*4);
    set32(fam,i*4,get32(fam,j*4));
    set32(fam,j*4,t);
    i=i-1;
  }
  emit("// W-REORDER: 48 trials, 6 families\n");
  emit("fn w_ntrials()i32 { return 48; }\n");
  emit("fn w_famp(f:i32)i32 {\n");
  i=0;
  while(i<6){
    emit("if(f=="); pi(i); emit("){return "); pi(get32(fam,i*4)); emit(";}\n");
    i=i+1;
  }
  emit("return 0;}\n");
  // draws: 48 rows of 6-bit masks
  emit("fn w_drawrow(t:i32)i32 {\n");
  let t:i32=0;
  while(t<48){
    let mask:i32=0;
    let f:i32=0;
    while(f<6){
      st=rnd(st);
      if((st%1000)<(get32(fam,f*4) as i64)){mask=mask+(1<<f);}
      f=f+1;
    }
    emit("if(t=="); pi(t); emit("){return "); pi(mask); emit(";}\n");
    t=t+1;
  }
  emit("return 0;}\n");
  emit("fn w_draw(t:i32,f:i32)i32 { return (w_drawrow(t)>>f)&1; }\n");
  // self-noise confirmations: 48 entries, 0..5 family or 6 none
  emit("fn w_selfn(t:i32)i32 {\n");
  t=0;
  while(t<48){
    st=rnd(st);
    let v:i32=6;
    if((st%10)<2){st=rnd(st); v=(st%6) as i32;}
    emit("if(t=="); pi(t); emit("){return "); pi(v); emit(";}\n");
    t=t+1;
  }
  emit("return 6;}\n");

  // ---- W-RETIRE: pursuit event histories ----
  // P0: 8 events, succ>=4, max consec fail <=2. P1: 4 events
  // succ>=1 max consec<=2 then FFFF. P2: 6 events succ>=2 max
  // consec<=2. P3: 2 events. P4: F,F,F,S fixed.
  emit("// W-RETIRE: 5 pursuits, sealed histories\n");
  emit("fn w_npur()i32 { return 5; }\n");
  emit("fn w_pnev(p:i32)i32 {\n");
  emit("if(p==0){return 8;}\nif(p==1){return 8;}\nif(p==2){return 6;}\n");
  emit("if(p==3){return 2;}\nif(p==4){return 4;}\nreturn 0;}\n");
  let ev:[]u8=z_alloc(5*8*4);
  let p:i32=0;
  while(p<5){
    let ne:i32=8;
    if(p==2){ne=6;}
    if(p==3){ne=2;}
    if(p==4){ne=4;}
    if(p==4){
      set32(ev,(p*8+0)*4,0); set32(ev,(p*8+1)*4,0);
      set32(ev,(p*8+2)*4,0); set32(ev,(p*8+3)*4,1);
    } else {
      // rejection sample with fixed fallback
      let tries:i32=0;
      let ok:i32=0;
      while(ok==0 && tries<500){
        tries=tries+1;
        let e:i32=0;
        while(e<ne){st=rnd(st); set32(ev,(p*8+e)*4,rbit(st)); e=e+1;}
        if(p==1){ // force last 4 to fail
          e=4; while(e<8){set32(ev,(p*8+e)*4,0); e=e+1;}
        }
        // check constraints
        let lim:i32=ne;
        if(p==1){lim=4;}
        let succ:i32=0;
        let cf:i32=0;
        let maxcf:i32=0;
        e=0;
        while(e<lim){
          if(get32(ev,(p*8+e)*4)==1){succ=succ+1; cf=0;}
          else {cf=cf+1; if(cf>maxcf){maxcf=cf;}}
          e=e+1;
        }
        let need:i32=4;
        if(p==1){need=1;}
        if(p==2){need=2;}
        if(p==3){need=0;}
        if(succ>=need && maxcf<=2){ok=1;}
      }
      if(ok==0){ // fixed fallback, still deterministic
        let e:i32=0;
        while(e<ne){
          let v:i32=1;
          if((e%3)==2){v=0;}
          set32(ev,(p*8+e)*4,v);
          e=e+1;
        }
        if(p==1){e=4; while(e<8){set32(ev,(p*8+e)*4,0); e=e+1;}}
      }
    }
    p=p+1;
  }
  emit("fn w_pev(p:i32,e:i32)i32 {\n");
  p=0;
  while(p<5){
    let ne:i32=8;
    if(p==2){ne=6;}
    if(p==3){ne=2;}
    if(p==4){ne=4;}
    let e:i32=0;
    while(e<ne){
      emit("if(p=="); pi(p); emit("&&e=="); pi(e);
      emit("){return "); pi(get32(ev,(p*8+e)*4)); emit(";}\n");
      e=e+1;
    }
    p=p+1;
  }
  emit("return 0;}\n");
  // structs: 10, creating pursuit idx 0..4, bids 0..99
  emit("// 10 structures, sealed pursuit assignment and bids\n");
  emit("fn w_nstructs()i32 { return 10; }\n");
  emit("fn w_spur(i:i32)i32 {\n");
  i=0;
  while(i<10){
    st=rnd(st);
    let v:i32=(st%5) as i32;
    if(i==0){v=1;}
    if(i==1){v=1;}
    emit("if(i=="); pi(i); emit("){return "); pi(v); emit(";}\n");
    i=i+1;
  }
  emit("return 0;}\n");
  emit("fn w_sbid(i:i32)i32 {\n");
  i=0;
  while(i<10){
    st=rnd(st);
    emit("if(i=="); pi(i); emit("){return "); pi((st%100) as i32); emit(";}\n");
    i=i+1;
  }
  emit("return 0;}\n");
  emit("fn w_nvic()i32 { return 5; }\n");
  // queries: 6, need pursuit idx in {0,2,3} mapped 0->0,1->2,2->3
  emit("// 6 held-out queries, need one of the clean ACTIVE pursuits\n");
  emit("fn w_nq()i32 { return 6; }\n");
  emit("fn w_qneed(q:i32)i32 {\n");
  let q:i32=0;
  while(q<6){
    st=rnd(st);
    let v:i32=(st%3) as i32;
    let m:i32=0;
    if(v==1){m=2;}
    if(v==2){m=3;}
    emit("if(q=="); pi(q); emit("){return "); pi(m); emit(";}\n");
    q=q+1;
  }
  emit("return 0;}\n");
  emit("// END world_sealed.zag\n");
  return 0;
}

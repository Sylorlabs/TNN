// c174_migrate.zag -- Node2-v2 migration-compat test (kill bar d).
// M1: node-local history slots, Node2-v2 rule verbatim from frozen
// prereg 4b05c8011 section 2.4. M2: the same consequence record
// migrated to the shared tag-61 store as (value, count, source)
// records (prereg section 7 framing), 3-revelation rule reading
// via sub_consec. K-H3 world: revelations [30,-1,30,45,45,45].
// Pure Zag. No Python.

fn mig_aw(r:i32)i32 {
  if(r==0){return 30;}
  if(r==1){return -1;}
  if(r==2){return 30;}
  return 45;
}

fn main()i32 {
  // ---- M1: node-local slots ----
  let s0:i32=-1;
  let s1:i32=-1;
  let s2:i32=-1;
  let d1:i32=30;
  let t1:[]u8=z_alloc(24);
  let r:i32=0;
  while(r<6){
    let aw:i32=mig_aw(r);
    if(aw>=0){
      s2=s1; s1=s0; s0=aw;
      if(s0==s1 && s1==s2 && s0>=0 && s0!=d1){
        d1=s0; s0=-1; s1=-1; s2=-1;
      }
    }
    set32(t1,r*4,d1);
    r=r+1;
  }
  let kh3:i32=1;
  if(get32(t1,0*4)!=30){kh3=0;}
  if(get32(t1,1*4)!=30){kh3=0;}
  if(get32(t1,2*4)!=30){kh3=0;}
  if(get32(t1,3*4)!=30){kh3=0;}
  if(get32(t1,4*4)!=30){kh3=0;}
  if(get32(t1,5*4)!=45){kh3=0;}
  if(d1!=45){kh3=0;}
  emit("M1_KH3_OK "); pi(kh3); pnl();
  emit("M1_TRACE ");
  r=0;
  while(r<6){pi(get32(t1,r*4)); psp(); r=r+1;}
  emit("guide="); pi(d1); pnl();

  // ---- M2: shared store ----
  let store:[]u8=sub_alloc();
  sub_init(store);
  let stats:[]u8=z_alloc(24);
  let d2:i32=30;
  let t2:[]u8=z_alloc(24);
  r=0;
  while(r<6){
    let aw:i32=mig_aw(r);
    if(aw>=0){
      sub_note(store,KT_STRATEGY(),7000+aw,OUT_SUCC(),SRC_TAUGHT(),0,0,r,stats);
      let ro:i32=sub_consec(store,KT_STRATEGY(),7000+aw,stats);
      if(ro>=0 && sr_get(store,ro,RF_SUCC())==3 && aw!=d2){
        d2=aw;
        sub_reset_base(store,KT_STRATEGY(),7000);
      }
    }
    set32(t2,r*4,d2);
    r=r+1;
  }
  emit("M2_TRACE ");
  r=0;
  while(r<6){pi(get32(t2,r*4)); psp(); r=r+1;}
  emit("guide="); pi(d2); pnl();
  let mm:i32=1;
  r=0;
  while(r<6){
    if(get32(t1,r*4)!=get32(t2,r*4)){mm=0;}
    r=r+1;
  }
  if(d1!=d2){mm=0;}
  emit("MIGRATION_MATCH "); pi(mm); pnl();
  return 0;
}

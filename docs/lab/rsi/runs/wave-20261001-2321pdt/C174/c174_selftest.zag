// c174_selftest.zag -- white-box machinery self test for c174_sub.zag.
// Exercises sub_note/sub_consec/sub_reorder/sub_utility/reclamation
// directly. Not part of the sealed battery; validates the machinery
// the battery relies on. Pure Zag. No Python.

fn main()i32 {
  let fail:i32=0;
  let store:[]u8=sub_alloc();
  sub_init(store);
  let stats:[]u8=z_alloc(24);

  // 1: basic write/read
  let r:i32=sub_note(store,KT_PURSUIT(),7,OUT_SUCC(),SRC_TAUGHT(),0,5,0,stats);
  if(r<0){fail=1;}
  if(sr_get(store,r,RF_ATT())!=1){fail=2;}
  if(sr_get(store,r,RF_SUCC())!=1){fail=3;}
  if(sr_get(store,r,RF_STAUGHT())!=1){fail=4;}
  if(sr_get(store,r,RF_STATE())!=ST_ACTIVE()){fail=5;}

  // 2: failure then success resets consec_fail
  sub_note(store,KT_PURSUIT(),7,OUT_FAIL(),SRC_TAUGHT(),3,5,1,stats);
  if(sr_get(store,r,RF_CF())!=1){fail=6;}
  if(sr_get(store,r,RF_MODE())!=3){fail=7;}
  sub_note(store,KT_PURSUIT(),7,OUT_SUCC(),SRC_OBSERVED(),0,5,2,stats);
  if(sr_get(store,r,RF_CF())!=0){fail=8;}
  if(sr_get(store,r,RF_SUCC())!=2){fail=9;}
  if(sr_get(store,r,RF_SOBS())!=1){fail=10;}

  // 3: src_self exclusion (spec 7.1)
  sub_note(store,KT_PURSUIT(),7,OUT_SUCC(),SRC_SELF(),0,0,3,stats);
  if(sr_get(store,r,RF_ATT())!=4){fail=11;}
  if(sr_get(store,r,RF_SUCC())!=2){fail=12;}
  if(sr_get(store,r,RF_SSELF())!=1){fail=13;}
  if(sr_get(store,r,RF_CF())!=0){fail=14;}

  // 4: abandonment lifecycle then re-engagement
  sub_note(store,KT_PURSUIT(),8,OUT_FAIL(),SRC_TAUGHT(),1,1,4,stats);
  sub_note(store,KT_PURSUIT(),8,OUT_FAIL(),SRC_TAUGHT(),1,1,5,stats);
  sub_note(store,KT_PURSUIT(),8,OUT_FAIL(),SRC_TAUGHT(),1,1,6,stats);
  let r8:i32=sub_consec(store,KT_PURSUIT(),8,stats);
  if(sr_get(store,r8,RF_STATE())!=ST_ABANDONED()){fail=15;}
  if(sr_get(store,r8,RF_CF())!=3){fail=16;}
  sub_note(store,KT_PURSUIT(),8,OUT_SUCC(),SRC_TAUGHT(),0,1,7,stats);
  if(sr_get(store,r8,RF_STATE())!=ST_REENGAGED()){fail=17;}
  if(sr_get(store,r8,RF_CF())!=0){fail=18;}

  // 5: reclamation, stalest-first (fresh store)
  let s2:[]u8=sub_alloc();
  sub_init(s2);
  let st2:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<64){
    sub_note(s2,KT_STRATEGY(),100+k,OUT_SUCC(),SRC_TAUGHT(),0,1,k,st2);
    k=k+1;
  }
  if(get32(st2,ST_RECLAIM()*4)!=0){fail=19;}
  sub_note(s2,KT_STRATEGY(),200,OUT_SUCC(),SRC_TAUGHT(),0,1,64,st2);
  if(get32(st2,ST_RECLAIM()*4)!=1){fail=20;}
  if(sub_consec(s2,KT_STRATEGY(),100,st2)>=0){fail=21;}
  if(sub_consec(s2,KT_STRATEGY(),200,st2)<0){fail=22;}
  if(sub_consec(s2,KT_STRATEGY(),163,st2)<0){fail=23;}

  // 6: reorder with exclusion
  let s3:[]u8=sub_alloc();
  sub_init(s3);
  let st3:[]u8=z_alloc(24);
  k=0;
  while(k<8){
    sub_note(s3,KT_STRATEGY(),0,OUT_SUCC(),SRC_TAUGHT(),0,1,k,st3);
    sub_note(s3,KT_STRATEGY(),1,OUT_FAIL(),SRC_TAUGHT(),1,1,k,st3);
    k=k+1;
  }
  k=0;
  while(k<5){
    sub_note(s3,KT_STRATEGY(),3,OUT_SUCC(),SRC_SELF(),0,0,k,st3);
    k=k+1;
  }
  sub_note(s3,KT_STRATEGY(),4,OUT_SUCC(),SRC_TAUGHT(),0,1,0,st3);
  sub_note(s3,KT_STRATEGY(),5,OUT_SUCC(),SRC_TAUGHT(),0,1,0,st3);
  sub_note(s3,KT_STRATEGY(),5,OUT_SUCC(),SRC_TAUGHT(),0,1,1,st3);
  sub_note(s3,KT_STRATEGY(),5,OUT_FAIL(),SRC_TAUGHT(),1,1,2,st3);
  sub_note(s3,KT_STRATEGY(),5,OUT_FAIL(),SRC_TAUGHT(),1,1,3,st3);
  let ord:[]u8=z_alloc(24);
  sub_reorder(s3,ord,st3);
  // expected rates: f0=1000 f1=0 f2=500 f3=500 f4=500 f5=500
  if(get32(ord,0)!=0){fail=24;}
  if(get32(ord,4)!=2){fail=25;}
  if(get32(ord,8)!=3){fail=26;}
  if(get32(ord,12)!=4){fail=27;}
  if(get32(ord,16)!=5){fail=28;}
  if(get32(ord,20)!=1){fail=29;}

  // 7: utility formula: 4 succ 1 fail, cost 5
  let s4:[]u8=sub_alloc();
  sub_init(s4);
  let st4:[]u8=z_alloc(24);
  sub_note(s4,KT_PURSUIT(),9,OUT_SUCC(),SRC_TAUGHT(),0,1,0,st4);
  sub_note(s4,KT_PURSUIT(),9,OUT_SUCC(),SRC_TAUGHT(),0,1,1,st4);
  sub_note(s4,KT_PURSUIT(),9,OUT_SUCC(),SRC_TAUGHT(),0,1,2,st4);
  sub_note(s4,KT_PURSUIT(),9,OUT_SUCC(),SRC_TAUGHT(),0,1,3,st4);
  sub_note(s4,KT_PURSUIT(),9,OUT_FAIL(),SRC_TAUGHT(),1,1,4,st4);
  // U = 1000*4/5 - 40*1 - 5/20 = 800-40-0 = 760
  if(sub_utility(s4,KT_PURSUIT(),9,st4)!=760){fail=30;}
  if(sub_utility(s4,KT_PURSUIT(),999,st4)!=0){fail=31;}

  if(fail==0){emit("SELFTEST_OK\n");}
  else {emit("SELFTEST_FAIL "); pi(fail); pnl();}
  return fail;
}

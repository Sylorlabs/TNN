// c174_sub.zag -- shared tag-61 consequence substrate (dev harness).
// Implements spec 550fa268b sections 2, 4, 5.3, 5.4, 6.2, 7.1 for the
// C174 validation battery (PREREG_C174.md, frozen commit 134af1cb2).
// Pure Zag. No Python. u8-backed cells with little-endian
// pack/unpack helpers (per AGENTS.md toolchain lesson: no
// `as *i32` + slice construction).

// ============ helpers ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn pi(v:i32)void { emit(i64s(v as i64)); return; }
fn psp()void { emit(" "); return; }
fn pnl()void { emit("\n"); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ substrate constants ============
fn SUB_MAXREC()i32 { return 64; }
fn SUB_RECSZ()i32 { return 64; }
fn SUB_HDR()i32 { return 64; }
fn KT_PURSUIT()i32 { return 1; }
fn KT_STRATEGY()i32 { return 2; }
fn TAG_SUB()i32 { return 61; }
fn ST_ACTIVE()i32 { return 0; }
fn ST_ABANDONED()i32 { return 1; }
fn ST_REENGAGED()i32 { return 2; }
fn SRC_TAUGHT()i32 { return 0; }
fn SRC_OBSERVED()i32 { return 1; }
fn SRC_SELF()i32 { return 2; }
fn OUT_SUCC()i32 { return 1; }
fn OUT_FAIL()i32 { return 0; }
// record field byte offsets
fn RF_TAG()i32 { return 0; }
fn RF_KT()i32 { return 4; }
fn RF_KEY()i32 { return 8; }
fn RF_ATT()i32 { return 12; }
fn RF_SUCC()i32 { return 16; }
fn RF_CF()i32 { return 20; }
fn RF_MODE()i32 { return 24; }
fn RF_CNODES()i32 { return 28; }
fn RF_CTRIES()i32 { return 32; }
fn RF_STAUGHT()i32 { return 36; }
fn RF_SOBS()i32 { return 40; }
fn RF_SSELF()i32 { return 44; }
fn RF_STATE()i32 { return 48; }
fn RF_LASTACT()i32 { return 52; }
fn RF_LIVE()i32 { return 56; }
// researcher-set scaffolding (prereg 2.7, honestly labeled)
fn ABANDON_BOUND()i32 { return 3; }
fn MINATT()i32 { return 2; }
fn NEUTRAL_PRIOR()i32 { return 500; }
fn COST_SAT()i32 { return 1000000; }
fn U_WCF()i32 { return 40; }
fn U_WCOST()i32 { return 20; }
fn U_CLAMP()i32 { return 2000; }
// stats slots
fn ST_WRITES()i32 { return 0; }
fn ST_READS()i32 { return 1; }
fn ST_RORD()i32 { return 2; }
fn ST_RRET()i32 { return 3; }
fn ST_RECLAIM()i32 { return 4; }
fn ST_RUTIL()i32 { return 5; }

// disabled flag comes from the arm flag file (arm_id: 0 S, 1 F, 2 A)
fn store_disabled()i32 { if(arm_id()==2){return 1;} return 0; }

// ============ store ============
fn sub_alloc()[]u8 { return z_alloc(SUB_HDR()+SUB_MAXREC()*SUB_RECSZ()); }
fn sub_init(s:[]u8)void { set32(s,0,0); return; } // header word 0: high-water nrec
fn sr_get(s:[]u8,roff:i32,f:i32)i32 { return get32(s,roff+f); }
fn sr_set(s:[]u8,roff:i32,f:i32,v:i32)void { set32(s,roff+f,v); return; }
fn sub_nrec(s:[]u8)i32 { return get32(s,0); }
fn sub_setnrec(s:[]u8,v:i32)void { set32(s,0,v); return; }

fn sub_find(s:[]u8,kt:i32,key:i32)i32 {
  let n:i32=sub_nrec(s);
  let i:i32=0;
  while(i<n){
    let r:i32=SUB_HDR()+i*SUB_RECSZ();
    if(sr_get(s,r,RF_LIVE())==1 && sr_get(s,r,RF_KT())==kt && sr_get(s,r,RF_KEY())==key){return r;}
    i=i+1;
  }
  return -1;
}

// pick a reclamation victim per spec 6.2: ABANDONED before ACTIVE at
// equal staleness; stalest = min last_active, tie = min attempts.
fn sub_reclaim_pick(s:[]u8)i32 {
  let n:i32=sub_nrec(s);
  let best:i32=-1;
  let pass:i32=0;
  while(pass<2){
    let want_ab:i32=0;
    if(pass==0){want_ab=1;}
    let i:i32=0;
    while(i<n){
      let r:i32=SUB_HDR()+i*SUB_RECSZ();
      if(sr_get(s,r,RF_LIVE())==1){
        let isab:i32=0;
        if(sr_get(s,r,RF_STATE())==ST_ABANDONED()){isab=1;}
        if(isab==want_ab || pass==1){
          if(best<0){best=r;}
          else {
            let bl:i32=sr_get(s,best,RF_LASTACT());
            let rl:i32=sr_get(s,r,RF_LASTACT());
            if(rl<bl){best=r;}
            else {
              if(rl==bl && sr_get(s,r,RF_ATT())<sr_get(s,best,RF_ATT())){best=r;}
            }
          }
        }
      }
      i=i+1;
    }
    if(best>=0){return best;}
    pass=pass+1;
  }
  return -1;
}

// find a free slot, extend, or reclaim; returns record offset
fn sub_slot(s:[]u8,stats:[]u8)i32 {
  let n:i32=sub_nrec(s);
  let i:i32=0;
  while(i<n){
    let r:i32=SUB_HDR()+i*SUB_RECSZ();
    if(sr_get(s,r,RF_LIVE())==0){return r;}
    i=i+1;
  }
  if(n<SUB_MAXREC()){
    let r:i32=SUB_HDR()+n*SUB_RECSZ();
    sub_setnrec(s,n+1);
    return r;
  }
  let v:i32=sub_reclaim_pick(s);
  if(v<0){return -1;}
  // zero the victim record
  let k:i32=0;
  while(k<SUB_RECSZ()){set32(s,v+k,0);k=k+4;}
  set32(stats,ST_RECLAIM()*4,get32(stats,ST_RECLAIM()*4)+1);
  return v;
}

// generic write (spec 4.2, 7.1, 7.2; lifecycle spec 5.2 minimal rule)
fn sub_note(s:[]u8,kt:i32,key:i32,outcome:i32,src:i32,mode:i32,cost:i32,ev:i32,stats:[]u8)i32 {
  if(store_disabled()==1){return -1;}
  let r:i32=sub_find(s,kt,key);
  if(r<0){
    r=sub_slot(s,stats);
    if(r<0){return -1;}
    sr_set(s,r,RF_TAG(),TAG_SUB());
    sr_set(s,r,RF_KT(),kt);
    sr_set(s,r,RF_KEY(),key);
    sr_set(s,r,RF_STATE(),ST_ACTIVE());
    sr_set(s,r,RF_LASTACT(),ev);
    sr_set(s,r,RF_LIVE(),1);
  }
  set32(stats,ST_WRITES()*4,get32(stats,ST_WRITES()*4)+1);
  // bootstrap exclusion (spec 7.1): self-generated attempts are
  // counted but never enter the evidence tallies
  if(src==SRC_SELF()){
    sr_set(s,r,RF_ATT(),sr_get(s,r,RF_ATT())+1);
    sr_set(s,r,RF_SSELF(),sr_get(s,r,RF_SSELF())+1);
    sr_set(s,r,RF_LASTACT(),ev);
    return r;
  }
  if(outcome==OUT_SUCC()){
    sr_set(s,r,RF_ATT(),sr_get(s,r,RF_ATT())+1);
    sr_set(s,r,RF_SUCC(),sr_get(s,r,RF_SUCC())+1);
    sr_set(s,r,RF_CF(),0);
    sr_set(s,r,RF_MODE(),0);
    sr_set(s,r,RF_LASTACT(),ev);
    if(src==SRC_TAUGHT()){sr_set(s,r,RF_STAUGHT(),sr_get(s,r,RF_STAUGHT())+1);}
    else {sr_set(s,r,RF_SOBS(),sr_get(s,r,RF_SOBS())+1);}
  } else {
    sr_set(s,r,RF_ATT(),sr_get(s,r,RF_ATT())+1);
    sr_set(s,r,RF_CF(),sr_get(s,r,RF_CF())+1);
    sr_set(s,r,RF_MODE(),mode);
    let cn:i32=sr_get(s,r,RF_CNODES())+cost;
    if(cn>COST_SAT()){cn=COST_SAT();}
    sr_set(s,r,RF_CNODES(),cn);
    sr_set(s,r,RF_LASTACT(),ev);
    if(src==SRC_TAUGHT()){sr_set(s,r,RF_STAUGHT(),sr_get(s,r,RF_STAUGHT())+1);}
    else {sr_set(s,r,RF_SOBS(),sr_get(s,r,RF_SOBS())+1);}
  }
  // record lifecycle: abandonment / re-engagement (spec 5.2 minimal)
  if(sr_get(s,r,RF_CF())>=ABANDON_BOUND()){sr_set(s,r,RF_STATE(),ST_ABANDONED());}
  else {
    if(outcome==OUT_SUCC() && sr_get(s,r,RF_STATE())==ST_ABANDONED()){
      sr_set(s,r,RF_STATE(),ST_REENGAGED());
    }
  }
  return r;
}

// generic read (spec 5)
fn sub_consec(s:[]u8,kt:i32,key:i32,stats:[]u8)i32 {
  if(store_disabled()==1){return -1;}
  set32(stats,ST_READS()*4,get32(stats,ST_READS()*4)+1);
  return sub_find(s,kt,key);
}

// migration scaffolding: reset evidence fields for keys in
// [base, base+1000) of namespace kt (analog of Node2-v2 slot reset)
fn sub_reset_base(s:[]u8,kt:i32,base:i32)void {
  let n:i32=sub_nrec(s);
  let i:i32=0;
  while(i<n){
    let r:i32=SUB_HDR()+i*SUB_RECSZ();
    if(sr_get(s,r,RF_LIVE())==1 && sr_get(s,r,RF_KT())==kt){
      let k:i32=sr_get(s,r,RF_KEY());
      if(k>=base && k<base+1000){
        sr_set(s,r,RF_ATT(),0);
        sr_set(s,r,RF_SUCC(),0);
        sr_set(s,r,RF_CF(),0);
        sr_set(s,r,RF_MODE(),0);
      }
    }
    i=i+1;
  }
  return;
}

// ============ consumer 1: trial reorder (spec 5.4) ============
fn fixed_order(o:[]u8)void {
  set32(o,0,3); set32(o,4,0); set32(o,8,5);
  set32(o,12,1); set32(o,16,4); set32(o,20,2);
  return;
}
fn fam_rate(s:[]u8,roff:i32)i32 {
  let att:i32=sr_get(s,roff,RF_ATT());
  let sself:i32=sr_get(s,roff,RF_SSELF());
  let eff:i32=att-sself;
  if(eff<MINATT()){return NEUTRAL_PRIOR();}
  return 1000*sr_get(s,roff,RF_SUCC())/eff;
}
fn sub_reorder(s:[]u8,o:[]u8,stats:[]u8)void {
  let rate:[]u8=z_alloc(24);
  let hits:i32=0;
  let f:i32=0;
  while(f<6){
    let r:i32=sub_consec(s,KT_STRATEGY(),f,stats);
    set32(stats,ST_RORD()*4,get32(stats,ST_RORD()*4)+1);
    set32(o,f*4,f);
    if(r<0){set32(rate,f*4,NEUTRAL_PRIOR());}
    else {hits=hits+1; set32(rate,f*4,fam_rate(s,r));}
    f=f+1;
  }
  if(hits==0){fixed_order(o); return;} // cold start / ablated: fixed default
  // stable insertion sort by descending rate
  let i:i32=1;
  while(i<6){
    let j:i32=i;
    while(j>0){
      let a:i32=get32(o,j*4);
      let b:i32=get32(o,(j-1)*4);
      if(get32(rate,a*4)>get32(rate,b*4)){
        set32(o,j*4,b); set32(o,(j-1)*4,a);
        j=j-1;
      } else {j=0;}
    }
    i=i+1;
  }
  return;
}

// ============ consequence-derived utility (C175 direction) ============
fn sub_utility(s:[]u8,kt:i32,key:i32,stats:[]u8)i32 {
  let r:i32=sub_consec(s,kt,key,stats);
  set32(stats,ST_RUTIL()*4,get32(stats,ST_RUTIL()*4)+1);
  if(r<0){return 0;}
  let att:i32=sr_get(s,r,RF_ATT());
  let sself:i32=sr_get(s,r,RF_SSELF());
  let eff:i32=att-sself;
  if(eff<1){eff=1;}
  let rate:i32=1000*sr_get(s,r,RF_SUCC())/eff;
  let u:i32=rate-U_WCF()*sr_get(s,r,RF_CF())-sr_get(s,r,RF_CNODES())/U_WCOST();
  if(u>U_CLAMP()){u=U_CLAMP();}
  if(u<-U_CLAMP()){u=-U_CLAMP();}
  return u;
}

// ============ consumer 2: retention input (spec 5.3) ============
// shared comparator lives in exactly one function so the fixed arm
// and the ablated arm order identically by construction
fn vic_less(abd:[]u8,u:[]u8,bid:[]u8,sid:[]u8,a:i32,b:i32)i32 {
  let aa:i32=get32(abd,a*4);
  let ab:i32=get32(abd,b*4);
  if(aa!=ab){if(aa>ab){return 1;} return 0;}
  let ua:i32=get32(u,a*4);
  let ub:i32=get32(u,b*4);
  if(ua!=ub){if(ua<ub){return 1;} return 0;}
  let ba:i32=get32(bid,a*4);
  let bb:i32=get32(bid,b*4);
  if(ba!=bb){if(ba<bb){return 1;} return 0;}
  if(get32(sid,a*4)<get32(sid,b*4)){return 1;}
  return 0;
}
fn order_victims(ns:i32,nv:i32,abd:[]u8,u:[]u8,bid:[]u8,sid:[]u8,out:[]u8)void {
  let idx:[]u8=z_alloc(ns*4);
  let i:i32=0;
  while(i<ns){set32(idx,i*4,i);i=i+1;}
  // selection sort by vic_less
  i=0;
  while(i<ns){
    let m:i32=i;
    let j:i32=i+1;
    while(j<ns){
      if(vic_less(abd,u,bid,sid,get32(idx,j*4),get32(idx,m*4))==1){m=j;}
      j=j+1;
    }
    let t:i32=get32(idx,i*4);
    set32(idx,i*4,get32(idx,m*4));
    set32(idx,m*4,t);
    i=i+1;
  }
  let k:i32=0;
  while(k<nv){set32(out,k*4,get32(sid,get32(idx,k*4)*4));k=k+1;}
  return;
}
fn sub_victims(s:[]u8,ns:i32,nv:i32,sids:[]u8,pkeys:[]u8,bids:[]u8,out:[]u8,stats:[]u8)void {
  let abd:[]u8=z_alloc(ns*4);
  let u:[]u8=z_alloc(ns*4);
  let i:i32=0;
  while(i<ns){
    let r:i32=sub_consec(s,KT_PURSUIT(),get32(pkeys,i*4),stats);
    set32(stats,ST_RRET()*4,get32(stats,ST_RRET()*4)+1);
    if(r<0){set32(abd,i*4,0); set32(u,i*4,0);}
    else {
      let ab:i32=0;
      if(sr_get(s,r,RF_STATE())==ST_ABANDONED()){ab=1;}
      set32(abd,i*4,ab);
      set32(u,i*4,sub_utility(s,KT_PURSUIT(),get32(pkeys,i*4),stats));
    }
    i=i+1;
  }
  order_victims(ns,nv,abd,u,bids,sids,out);
  return;
}

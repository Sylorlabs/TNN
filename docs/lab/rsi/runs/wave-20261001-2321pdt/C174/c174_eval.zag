// c174_eval.zag -- C174 sealed battery evaluation driver.
// Arms selected by armflag (arm_id: 0 S shared store, 1 F fixed
// bookkeeping, 2 A ablation). W-REORDER + W-RETIRE.
// Pure Zag. No Python.

fn stat_new()[]u8 { return z_alloc(24); }
fn stat_get(s:[]u8,k:i32)i32 { return get32(s,k*4); }

fn run_reorder(arm:i32)void {
  let store:[]u8=sub_alloc();
  sub_init(store);
  let stats:[]u8=stat_new();
  let order:[]u8=z_alloc(24);
  let total:i32=0;
  let t:i32=0;
  while(t<w_ntrials()){
    if(arm==1){fixed_order(order);} else {sub_reorder(store,order,stats);}
    emit("T "); pi(t); psp();
    let k:i32=0;
    while(k<6){pi(get32(order,k*4)); psp(); k=k+1;}
    let ok:i32=0;
    k=0;
    while(k<6){
      let f:i32=get32(order,k*4);
      let d:i32=w_draw(t,f);
      if(arm!=1){
        let md:i32=1;
        if(d==1){md=0;}
        sub_note(store,KT_STRATEGY(),f,d,SRC_TAUGHT(),md,1,t,stats);
      }
      total=total+1;
      if(d==1){ok=1; break;}
      k=k+1;
    }
    if(arm!=1){
      let md:i32=2;
      if(ok==1){md=0;}
      sub_note(store,KT_PURSUIT(),1000+t,ok,SRC_TAUGHT(),md,1,t,stats);
    }
    let sn:i32=w_selfn(t);
    if(sn<6 && arm!=1){
      sub_note(store,KT_STRATEGY(),sn,OUT_SUCC(),SRC_SELF(),0,0,t,stats);
    }
    emit("ok="); pi(ok); pnl();
    t=t+1;
  }
  emit("REORDER_TOTAL_ATTEMPTS "); pi(total); pnl();
  if(arm==1){fixed_order(order);} else {sub_reorder(store,order,stats);}
  emit("REORDER_FINAL_ORDER ");
  let k:i32=0;
  while(k<6){pi(get32(order,k*4)); psp(); k=k+1;}
  pnl();
  if(arm==0){
    emit("REORDER_WRITES "); pi(stat_get(stats,ST_WRITES())); psp();
    emit("READS "); pi(stat_get(stats,ST_READS())); psp();
    emit("RORD "); pi(stat_get(stats,ST_RORD())); psp();
    emit("RECLAIMS "); pi(stat_get(stats,ST_RECLAIM())); pnl();
    let f:i32=0;
    while(f<6){
      let r:i32=sub_consec(store,KT_STRATEGY(),f,stats);
      emit("FAM "); pi(f); psp();
      if(r<0){emit("absent");}
      else {
        emit("att="); pi(sr_get(store,r,RF_ATT())); psp();
        emit("succ="); pi(sr_get(store,r,RF_SUCC())); psp();
        emit("sself="); pi(sr_get(store,r,RF_SSELF())); psp();
        emit("rate="); pi(fam_rate(store,r));
      }
      pnl();
      f=f+1;
    }
    let pn:i32=0;
    t=0;
    while(t<w_ntrials()){
      if(sub_consec(store,KT_PURSUIT(),1000+t,stats)>=0){pn=pn+1;}
      t=t+1;
    }
    emit("REORDER_PURSUIT_RECORDS "); pi(pn); pnl();
  }
  return;
}

fn run_retire(arm:i32)void {
  let store:[]u8=sub_alloc();
  sub_init(store);
  let stats:[]u8=stat_new();
  let ev:i32=0;
  let p:i32=0;
  while(p<w_npur()){
    let e:i32=0;
    while(e<w_pnev(p)){
      let o:i32=w_pev(p,e);
      if(arm!=1){
        let md:i32=1;
        if(o==1){md=0;}
        sub_note(store,KT_PURSUIT(),100+p,o,SRC_TAUGHT(),md,1,ev,stats);
      }
      ev=ev+1;
      e=e+1;
    }
    p=p+1;
  }
  let ns:i32=w_nstructs();
  let nv:i32=w_nvic();
  let sids:[]u8=z_alloc(ns*4);
  let pkeys:[]u8=z_alloc(ns*4);
  let bids:[]u8=z_alloc(ns*4);
  let i:i32=0;
  while(i<ns){
    set32(sids,i*4,i);
    set32(pkeys,i*4,100+w_spur(i));
    set32(bids,i*4,w_sbid(i));
    i=i+1;
  }
  let out:[]u8=z_alloc(nv*4);
  if(arm==1){
    let abd:[]u8=z_alloc(ns*4);
    let u:[]u8=z_alloc(ns*4);
    order_victims(ns,nv,abd,u,bids,sids,out);
  } else {
    sub_victims(store,ns,nv,sids,pkeys,bids,out,stats);
  }
  emit("RETIRE_VICTIMS ");
  i=0;
  while(i<nv){pi(get32(out,i*4)); psp(); i=i+1;}
  pnl();
  let isvic:[]u8=z_alloc(ns*4);
  i=0;
  while(i<nv){set32(isvic,get32(out,i*4)*4,1); i=i+1;}
  emit("RETIRE_QUERIES ");
  let ans:i32=0;
  let q:i32=0;
  while(q<w_nq()){
    let need:i32=100+w_qneed(q);
    let okq:i32=0;
    i=0;
    while(i<ns){
      if(get32(isvic,i*4)==0 && get32(pkeys,i*4)==need){okq=1; break;}
      i=i+1;
    }
    pi(okq); psp();
    ans=ans+okq;
    q=q+1;
  }
  pnl();
  emit("RETIRE_ANSWERABLE "); pi(ans); pnl();
  if(arm==0){
    p=0;
    while(p<5){
      let r:i32=sub_consec(store,KT_PURSUIT(),100+p,stats);
      emit("PUR "); pi(100+p); psp();
      if(r<0){emit("absent");}
      else {
        emit("att="); pi(sr_get(store,r,RF_ATT())); psp();
        emit("succ="); pi(sr_get(store,r,RF_SUCC())); psp();
        emit("cf="); pi(sr_get(store,r,RF_CF())); psp();
        emit("state="); pi(sr_get(store,r,RF_STATE())); psp();
        emit("U="); pi(sub_utility(store,KT_PURSUIT(),100+p,stats));
      }
      pnl();
      p=p+1;
    }
    emit("RETIRE_WRITES "); pi(stat_get(stats,ST_WRITES())); psp();
    emit("READS "); pi(stat_get(stats,ST_READS())); psp();
    emit("RRET "); pi(stat_get(stats,ST_RRET())); psp();
    emit("RUTIL "); pi(stat_get(stats,ST_RUTIL())); psp();
    emit("RECLAIMS "); pi(stat_get(stats,ST_RECLAIM())); pnl();
  }
  return;
}

fn main()i32 {
  let arm:i32=arm_id();
  // NOTE: the arm id is intentionally NOT printed to stdout. Arm
  // identity is carried by the output filename. Kill bar (c)
  // compares whole-output SHA-256 across arms; a metadata label
  // would make that comparison vacuous, and the label is not a
  // decision channel.
  emit("WORLD_SEED "); pi(wgen_seed()); pnl();
  run_reorder(arm);
  run_retire(arm);
  emit("C174_EVAL_DONE\n");
  return 0;
}

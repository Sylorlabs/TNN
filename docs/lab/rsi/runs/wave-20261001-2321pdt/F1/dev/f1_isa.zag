// f1_isa.zag
// F1 candidate: frozen protected ISA substrate for generic executable semantics.
// Executable vocabulary in constructed graphs: READ, WRITE, COPY, ADD, EQ,
// BRANCH, EXECUTE(root, frame). EXECUTE(root, frame) is approved
// protected-core machinery. No other operation may appear in a created graph.
//
// This file holds ONLY generic execution and storage machinery:
//   - u8-backed i64 cell storage (ig/is helpers, per workspace toolchain idiom)
//   - node / graph / learner-state containers (learner-created persistent state)
//   - the EXECUTE interpreter (sequential nodes, BRANCH control, step cap,
//     EXECUTE composition over learner-named graphs)
//   - text serialization / parsing of learner state
//   - small text parsing and string-building helpers
// No domain semantics, no task knowledge, no researcher-named semantic cases,
// no reification schema, no candidate family. The learner's created structures
// live in the state container; source holds only the machinery above.

// ---------- cell storage (u8-backed, little-endian i64) ----------

fn f1_alloc(n:i64)[]u8 {
    if(n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn f1_ig(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn f1_is(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

// ---------- string builder over a fixed buffer ----------

fn sb_put(b:[]u8, lb:[]u8, s:[]u8)void {
    let n:i64 = f1_ig(lb, 0);
    let i:i64 = 0;
    while(i < s.len) { b[n + i] = s[i]; i = i + 1; }
    f1_is(lb, 0, n + s.len);
}

fn sb_ch(b:[]u8, lb:[]u8, c:i64)void {
    let n:i64 = f1_ig(lb, 0);
    b[n] = c as u8;
    f1_is(lb, 0, n + 1);
}

fn sb_i64(b:[]u8, lb:[]u8, v:i64)void {
    let t:[]u8 = _zag_i64_to_str(v);
    sb_put(b, lb, t);
}

fn sb_done(b:[]u8, lb:[]u8)[]u8 {
    let n:i64 = f1_ig(lb, 0);
    return b[0..n];
}

// ---------- text parsing helpers ----------

fn ln_next(text:[]u8, pos:[]u8)[]u8 {
    let p:i64 = f1_ig(pos, 0);
    let q:i64 = p;
    while(q < text.len && text[q] != 10) { q = q + 1; }
    let line:[]u8 = text[p..q];
    if(q < text.len) { q = q + 1; }
    f1_is(pos, 0, q);
    return line;
}

fn ln_more(text:[]u8, pos:[]u8)i64 {
    if(f1_ig(pos, 0) < text.len) { return 1; }
    return 0;
}

fn tok_next(line:[]u8, pos:[]u8)[]u8 {
    let p:i64 = f1_ig(pos, 0);
    while(p < line.len && line[p] == 32) { p = p + 1; }
    let q:i64 = p;
    while(q < line.len && line[q] != 32) { q = q + 1; }
    f1_is(pos, 0, q);
    return line[p..q];
}

// ---------- op codes ----------
// 1 READ, 2 WRITE, 3 COPY, 4 ADD, 5 EQ, 6 BRANCH, 7 EXECUTE

fn op_name(op:i64)[]u8 {
    if(op == 1) { return "READ"; }
    if(op == 2) { return "WRITE"; }
    if(op == 3) { return "COPY"; }
    if(op == 4) { return "ADD"; }
    if(op == 5) { return "EQ"; }
    if(op == 6) { return "BRANCH"; }
    if(op == 7) { return "EXECUTE"; }
    return "OP?";
}

fn gname(id:i64)[]u8 {
    if(id == 0) { return "main"; }
    if(id == 1) { return "g0"; }
    if(id == 2) { return "g1"; }
    if(id == 3) { return "g2"; }
    if(id == 4) { return "g3"; }
    if(id == 5) { return "g4"; }
    return "g?";
}

// ---------- learner-state container ----------
// cells: 0 node_records_used, 1 node_record_cap, 2 ngraphs, 3 gtcap
// graph table at cell 4: per graph 3 cells (nameid, startrec, count)
// node records at cell 28: per record 6 cells (op, p1..p5)

fn st_new_empty()[]u8 {
    let total:i64 = 28 + 512 * 6;
    let S:[]u8 = f1_alloc(total * 8);
    if(S.len == 0) { return S; }
    f1_is(S, 1, 512);
    f1_is(S, 3, 8);
    f1_is(S, 2, 0);
    return S;
}

fn st_find(S:[]u8, nameid:i64)i64 {
    let n:i64 = f1_ig(S, 2);
    let i:i64 = 0;
    while(i < n) {
        if(f1_ig(S, 4 + i * 3) == nameid) { return i; }
        i = i + 1;
    }
    return -1;
}

fn st_gstart(S:[]u8, gi:i64)i64 { return f1_ig(S, 4 + gi * 3 + 1); }
fn st_gcount(S:[]u8, gi:i64)i64 { return f1_ig(S, 4 + gi * 3 + 2); }
fn st_gnameid(S:[]u8, gi:i64)i64 { return f1_ig(S, 4 + gi * 3); }
fn st_gsetcount(S:[]u8, gi:i64, c:i64)void { f1_is(S, 4 + gi * 3 + 2, c); }

fn st_gadd(S:[]u8, nameid:i64)i64 {
    let n:i64 = f1_ig(S, 2);
    if(n >= f1_ig(S, 3)) { return -1; }
    if(st_find(S, nameid) >= 0) { return -1; }
    f1_is(S, 4 + n * 3, nameid);
    f1_is(S, 4 + n * 3 + 1, f1_ig(S, 0));
    f1_is(S, 4 + n * 3 + 2, 0);
    f1_is(S, 2, n + 1);
    return n;
}

fn nd_get(S:[]u8, r:i64, f:i64)i64 { return f1_ig(S, 28 + r * 6 + f); }
fn nd_set(S:[]u8, r:i64, f:i64, v:i64)void { f1_is(S, 28 + r * 6 + f, v); }

fn st_nadd(S:[]u8, gi:i64, op:i64, p1:i64, p2:i64, p3:i64, p4:i64, p5:i64)i64 {
    let used:i64 = f1_ig(S, 0);
    if(used >= f1_ig(S, 1)) { return -1; }
    let start:i64 = st_gstart(S, gi);
    let cnt:i64 = st_gcount(S, gi);
    if(start + cnt != used) { return -1; }
    nd_set(S, used, 0, op);
    nd_set(S, used, 1, p1);
    nd_set(S, used, 2, p2);
    nd_set(S, used, 3, p3);
    nd_set(S, used, 4, p4);
    nd_set(S, used, 5, p5);
    f1_is(S, 0, used + 1);
    st_gsetcount(S, gi, cnt + 1);
    return cnt;
}

// Insert a node at position pos inside graph gi (0 <= pos <= count).
// Only valid when gi owns the tail region (true for the working graph).
fn st_ninsert(S:[]u8, gi:i64, pos:i64, op:i64, p1:i64, p2:i64, p3:i64, p4:i64, p5:i64)i64 {
    let cnt:i64 = st_gcount(S, gi);
    let start:i64 = st_gstart(S, gi);
    if(pos < 0 || pos > cnt) { return -1; }
    if(start + cnt != f1_ig(S, 0)) { return -1; }
    let used:i64 = f1_ig(S, 0);
    if(used >= f1_ig(S, 1)) { return -1; }
    let i:i64 = cnt - 1;
    while(i >= pos) {
        let f:i64 = 0;
        while(f < 6) {
            nd_set(S, start + i + 1, f, nd_get(S, start + i, f));
            f = f + 1;
        }
        i = i - 1;
    }
    nd_set(S, start + pos, 0, op);
    nd_set(S, start + pos, 1, p1);
    nd_set(S, start + pos, 2, p2);
    nd_set(S, start + pos, 3, p3);
    nd_set(S, start + pos, 4, p4);
    nd_set(S, start + pos, 5, p5);
    f1_is(S, 0, used + 1);
    st_gsetcount(S, gi, cnt + 1);
    return pos;
}

// Snapshot graph gi's node records into a new graph newid. Returns new gi.
fn st_snapshot(S:[]u8, gi:i64, newid:i64)i64 {
    let cnt:i64 = st_gcount(S, gi);
    let start:i64 = st_gstart(S, gi);
    let used:i64 = f1_ig(S, 0);
    if(used + cnt > f1_ig(S, 1)) { return -1; }
    let ngi:i64 = st_gadd(S, newid);
    if(ngi < 0) { return -1; }
    let j:i64 = 0;
    while(j < cnt) {
        let f:i64 = 0;
        while(f < 6) {
            nd_set(S, used + j, f, nd_get(S, start + j, f));
            f = f + 1;
        }
        j = j + 1;
    }
    f1_is(S, 0, used + cnt);
    st_gsetcount(S, ngi, cnt);
    return ngi;
}

// Reset graph gi to empty at the current bump pointer (abandons old records).
fn st_reset_graph(S:[]u8, gi:i64)void {
    f1_is(S, 4 + gi * 3 + 1, f1_ig(S, 0));
    st_gsetcount(S, gi, 0);
}

// Fresh state with the minimal output epilogue: one WRITE r0 node.
// This is generic plumbing (every program ends by writing its output
// register), not a semantic case: it predicts constant 0.
fn st_new()[]u8 {
    let S:[]u8 = st_new_empty();
    if(S.len == 0) { return S; }
    let gi:i64 = st_gadd(S, 0);
    st_nadd(S, gi, 2, 0, 0, 0, 0, 0);
    return S;
}

// ---------- operand / register access ----------

fn f1_reg(regs:[]u8, r:i64)i64 {
    if(r < 0 || r > 7) { return 0; }
    return f1_ig(regs, r);
}

fn f1_operand(regs:[]u8, frame:[]u8, nframe:i64, v:i64)i64 {
    if(v >= 0 && v < 8) { return f1_ig(regs, v); }
    if(v >= 8 && v < 16) {
        let f:i64 = v - 8;
        if(f >= 0 && f < nframe) { return f1_ig(frame, 1 + f); }
        return 0;
    }
    return 0;
}

// ---------- EXECUTE(root, frame) interpreter ----------
// Sequential node execution from pc=0. BRANCH jumps on nonzero register.
// EXECUTE runs a learner-named graph on a copy of the register file with
// the same frame; result goes to the destination register. Step cap and
// call-depth cap guarantee termination. xc (optional, 8 cells) counts
// executions per graph nameid for reuse-invocation evidence.

fn f1_exec(S:[]u8, gi:i64, regs:[]u8, frame:[]u8, depth:i64, xc:[]u8)i64 {
    if(gi < 0) { return 0; }
    if(depth > 8) { return 0; }
    if(xc.len >= 8) {
        let nid:i64 = st_gnameid(S, gi);
        if(nid >= 0 && nid < 8) { f1_is(xc, nid, f1_ig(xc, nid) + 1); }
    }
    let start:i64 = st_gstart(S, gi);
    let count:i64 = st_gcount(S, gi);
    let nframe:i64 = f1_ig(frame, 0);
    let pc:i64 = 0;
    let steps:i64 = 0;
    let out:i64 = 0;
    while(pc >= 0 && pc < count && steps < 500) {
        steps = steps + 1;
        let r:i64 = start + pc;
        let op:i64 = nd_get(S, r, 0);
        let p1:i64 = nd_get(S, r, 1);
        let p2:i64 = nd_get(S, r, 2);
        let p3:i64 = nd_get(S, r, 3);
        if(op == 1) {
            f1_is(regs, p1, f1_operand(regs, frame, nframe, p2));
            pc = pc + 1;
        } else if(op == 2) {
            out = f1_reg(regs, p1);
            pc = pc + 1;
        } else if(op == 3) {
            f1_is(regs, p1, f1_operand(regs, frame, nframe, p2));
            pc = pc + 1;
        } else if(op == 4) {
            f1_is(regs, p1, f1_operand(regs, frame, nframe, p2) + f1_operand(regs, frame, nframe, p3));
            pc = pc + 1;
        } else if(op == 5) {
            let e:i64 = 0;
            if(f1_operand(regs, frame, nframe, p2) == f1_operand(regs, frame, nframe, p3)) { e = 1; }
            f1_is(regs, p1, e);
            pc = pc + 1;
        } else if(op == 6) {
            if(f1_reg(regs, p1) != 0) { pc = p2; } else { pc = pc + 1; }
        } else if(op == 7) {
            let v:i64 = 0;
            if(p2 > 0) {
                let gi2:i64 = st_find(S, p2);
                if(gi2 >= 0) {
                    let regs2:[]u8 = f1_alloc(64);
                    if(regs2.len > 0) {
                        let k:i64 = 0;
                        while(k < 8) { f1_is(regs2, k, f1_ig(regs, k)); k = k + 1; }
                        v = f1_exec(S, gi2, regs2, frame, depth + 1, xc);
                    }
                }
            }
            f1_is(regs, p1, v);
            pc = pc + 1;
        } else {
            pc = pc + 1;
        }
    }
    return out;
}

// ---------- state serialization (learner-created persistent state) ----------

fn st_save(S:[]u8, sb:[]u8, lb:[]u8)void {
    sb_put(sb, lb, "F1STATE 1\nREGN 8\n");
    let n:i64 = f1_ig(S, 2);
    let gi:i64 = 0;
    while(gi < n) {
        let id:i64 = st_gnameid(S, gi);
        sb_put(sb, lb, "GRAPH ");
        sb_i64(sb, lb, id);
        sb_ch(sb, lb, 32);
        sb_put(sb, lb, gname(id));
        sb_ch(sb, lb, 32);
        sb_i64(sb, lb, st_gcount(S, gi));
        sb_ch(sb, lb, 10);
        let start:i64 = st_gstart(S, gi);
        let c:i64 = st_gcount(S, gi);
        let j:i64 = 0;
        while(j < c) {
            sb_put(sb, lb, "N ");
            let f:i64 = 0;
            while(f < 6) {
                sb_i64(sb, lb, nd_get(S, start + j, f));
                if(f < 5) { sb_ch(sb, lb, 32); }
                f = f + 1;
            }
            sb_ch(sb, lb, 10);
            j = j + 1;
        }
        sb_put(sb, lb, "ENDGRAPH\n");
        gi = gi + 1;
    }
}

fn st_load(text:[]u8)[]u8 {
    let S:[]u8 = st_new_empty();
    if(S.len == 0) { return S; }
    let pos:[]u8 = f1_alloc(8);
    if(pos.len == 0) { return ""; }
    let cur:i64 = -1;
    let ok:i64 = 1;
    while(ln_more(text, pos) == 1 && ok == 1) {
        let line:[]u8 = ln_next(text, pos);
        let lp:[]u8 = f1_alloc(8);
        if(lp.len == 0) { ok = 0; }
        if(ok == 1) {
            let w:[]u8 = tok_next(line, lp);
            if(_zag_strcmp(w, "GRAPH") == 1) {
                let ids:[]u8 = tok_next(line, lp);
                let id:i64 = _zag_str_to_i64(ids);
                cur = st_gadd(S, id);
                if(cur < 0) { ok = 0; }
            } else if(_zag_strcmp(w, "N") == 1) {
                if(cur < 0) { ok = 0; }
                if(ok == 1) {
                    let v0:i64 = _zag_str_to_i64(tok_next(line, lp));
                    let v1:i64 = _zag_str_to_i64(tok_next(line, lp));
                    let v2:i64 = _zag_str_to_i64(tok_next(line, lp));
                    let v3:i64 = _zag_str_to_i64(tok_next(line, lp));
                    let v4:i64 = _zag_str_to_i64(tok_next(line, lp));
                    let v5:i64 = _zag_str_to_i64(tok_next(line, lp));
                    if(v0 < 1 || v0 > 7) { ok = 0; }
                    if(ok == 1 && st_nadd(S, cur, v0, v1, v2, v3, v4, v5) < 0) { ok = 0; }
                }
            } else if(_zag_strcmp(w, "ENDGRAPH") == 1) {
                cur = -1;
            }
        }
    }
    if(ok == 0) { return ""; }
    if(st_find(S, 0) < 0) { return ""; }
    return S;
}

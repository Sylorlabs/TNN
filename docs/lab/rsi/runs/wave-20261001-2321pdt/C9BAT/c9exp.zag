// c9exp.zag -- reference experiment-driven causal learner (pure Zag).
// Calibration tool for the C9GEN battery, not a cognitive claim.
// Reads only turns.jsonl. Single pass per world: accumulates
// do_out agreement counts keyed by the pending do(var,val), then
// runs the frozen two-stage protocol from PREREG_C9GEN section 5:
//   Stage 1: tX = P(y==v | do(X,v)), tZ = P(y==v | do(Z,v)).
//     both >= HI  -> Y is leaf  -> stage 2a
//     both <  HI  -> Y is root  -> stage 2b
//     split       -> higher side is upstream of Y (X->Y->Z / Z->Y->X)
//   Stage 2: sXZ = P(z==v | do(X,v)), sZX = P(x==v | do(Z,v)).
//     2a (Y leaf): sXZ > sZX -> X->Z->Y else Z->X->Y
//     2b (Y root): sXZ > sZX -> Y->X->Z else Y->Z->X
// HI = 75 (percent). Ties reply UNKNOWN.
// Usage: c9exp <turns.jsonl>
// Prints one reply line per question.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
// digit byte right after marker; -1 if absent/not a digit
fn dig_after(line:[]u8,marker:[]u8)i32 {
  let p:i32=findsub(line,0,marker);
  if(p<0){return -1;}
  let q:i32=p+marker.len;
  if(q>=line.len){return -1;}
  let c:u8=line[q];
  if(c<48||c>57){return -1;}
  return (c-48) as i32;
}
// raw byte right after marker; -1 if absent
fn byte_after(line:[]u8,marker:[]u8)i32 {
  let p:i32=findsub(line,0,marker);
  if(p<0){return -1;}
  let q:i32=p+marker.len;
  if(q>=line.len){return -1;}
  return line[q] as i32;
}
fn pct(ag:i32,n:i32)i32 {
  if(n==0){return 0;}
  return ag*100/n;
}
fn vname(v:i32)[]u8 {
  if(v==0){return "X";}
  if(v==1){return "Y";}
  return "Z";
}
// append chain string for (root,mid,leaf) indices
fn app_chain3(buf:[]u8,at:i32,r:i32,m:i32,l:i32)i32 {
  at=app(buf,at,vname(r));
  at=app(buf,at,"->");
  at=app(buf,at,vname(m));
  at=app(buf,at,"->");
  at=app(buf,at,vname(l));
  return at;
}

fn main()i32 {
  if(_zag_argc()!=2){ emit("usage: c9exp <turns.jsonl>\n"); return 1; }
  let data:[]u8=_zag_read_file(_zag_arg(1));
  if(data.len==0){ errln("empty or unreadable turns file"); return 1; }
  let out:[]u8=z_alloc(4096);
  let oat:i32=0;
  // per-world accumulators
  let pvar:i32=-1; let pval:i32=0;
  let x_y_ag:i32=0; let x_y_n:i32=0;
  let x_z_ag:i32=0; let x_z_n:i32=0;
  let z_y_ag:i32=0; let z_y_n:i32=0;
  let z_x_ag:i32=0; let z_x_n:i32=0;
  let pos:i32=0;
  while(pos<data.len){
    let eol:i32=findsub(data,pos,"\n");
    if(eol<0){ eol=data.len; }
    let line:[]u8=data[pos..eol];
    // NOTE: check do_out before do ("\"t\":\"do\"" is a prefix of do_out)
    if(findsub(line,0,"\"t\":\"do_out\"")>=0){
      let x:i32=dig_after(line,"\"x\":");
      let y:i32=dig_after(line,"\"y\":");
      let z:i32=dig_after(line,"\"z\":");
      if(pvar==0 && x>=0 && y>=0 && z>=0){
        x_y_n=x_y_n+1; if(y==pval){x_y_ag=x_y_ag+1;}
        x_z_n=x_z_n+1; if(z==pval){x_z_ag=x_z_ag+1;}
      }
      if(pvar==2 && x>=0 && y>=0 && z>=0){
        z_y_n=z_y_n+1; if(y==pval){z_y_ag=z_y_ag+1;}
        z_x_n=z_x_n+1; if(x==pval){z_x_ag=z_x_ag+1;}
      }
      pvar=-1;
    } else {
      if(findsub(line,0,"\"t\":\"do\"")>=0){
        let vc:i32=byte_after(line,"\"var\":\"");
        let vv:i32=dig_after(line,"\"val\":");
        pvar=-1;
        if(vc==88){ pvar=0; }       // X
        else { if(vc==90){ pvar=2; } } // Z
        if(vv==0 || vv==1){ pval=vv; } else { pvar=-1; }
      } else {
        if(findsub(line,0,"\"t\":\"q\"")>=0){
          // run the frozen two-stage protocol
          let tX:i32=pct(x_y_ag,x_y_n);
          let tZ:i32=pct(z_y_ag,z_y_n);
          let r:i32=-1; let m:i32=-1; let l:i32=-1;
          if(tX>=75 && tZ>=75){
            // stage 2a: Y is leaf
            let sXZ:i32=pct(x_z_ag,x_z_n);
            let sZX:i32=pct(z_x_ag,z_x_n);
            if(sXZ>sZX){ r=0; m=2; l=1; }
            else { if(sZX>sXZ){ r=2; m=0; l=1; } }
          } else {
            if(tX<75 && tZ<75){
              // stage 2b: Y is root
              let sXZ:i32=pct(x_z_ag,x_z_n);
              let sZX:i32=pct(z_x_ag,z_x_n);
              if(sXZ>sZX){ r=1; m=0; l=2; }
              else { if(sZX>sXZ){ r=1; m=2; l=0; } }
            } else {
              if(tX>tZ){ r=0; m=1; l=2; }
              else { if(tZ>tX){ r=2; m=1; l=0; } }
            }
          }
          if(r<0){ oat=app(out,oat,"UNKNOWN\n"); }
          else { oat=app_chain3(out,oat,r,m,l); oat=app(out,oat,"\n"); }
          // reset per-world accumulators
          pvar=-1; pval=0;
          x_y_ag=0; x_y_n=0; x_z_ag=0; x_z_n=0;
          z_y_ag=0; z_y_n=0; z_x_ag=0; z_x_n=0;
        }
      }
    }
    pos=eol+1;
  }
  _zag_print(out[0..oat]);
  return 0;
}

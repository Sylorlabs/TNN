// c9gen.zag -- corrected causal battery generator (pure Zag).
// Addresses the frozen arena C9 defects: observationally
// identifiable chains (no enforced x==y==z), real do()
// intervention turns, randomized candidate order, full
// chain-string answers.
// Usage: c9gen <seed_u64_decimal> <outdir>
// Writes: turns.jsonl, key.txt, worlds.txt, manifest.txt
// Determinism: single LCG seeded from argv; no other entropy.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn parse_u64(s:[]u8)i64 {
  if(s.len==0){return -1;}
  let v:i64=0;
  let i:i32=0;
  while(i<s.len){
    let c:u8=s[i];
    if(c<48||c>57){return -1;}
    v=v*10+((c-48) as i64);
    i=i+1;
  }
  return v;
}
// PRNG: LCG in an 8-byte LE buffer (same as arena world_gen)
fn rng_next(rng:[]u8)i64 {
  let s:i64=(rng[0] as i64)|((rng[1] as i64)<<8)|((rng[2] as i64)<<16)|((rng[3] as i64)<<24)|((rng[4] as i64)<<32)|((rng[5] as i64)<<40)|((rng[6] as i64)<<48)|((rng[7] as i64)<<56);
  s=s*6364136223846793005+1442695040888963407;
  rng[0]=(s as u8); rng[1]=((s>>8) as u8); rng[2]=((s>>16) as u8); rng[3]=((s>>24) as u8);
  rng[4]=((s>>32) as u8); rng[5]=((s>>40) as u8); rng[6]=((s>>48) as u8); rng[7]=((s>>56) as u8);
  return s;
}
fn rng_range(rng:[]u8,n:i64)i64 {
  let r:i64=rng_next(rng)%n;
  if(r<0){r=-r;}
  return r;
}
// fair bit from LCG bit 33 (bit 0 alternates every step for this
// LCG, so %2 draws are degenerate; bit 33 has period 2^31)
fn rng_bit(rng:[]u8)i32 {
  let s:i64=rng_next(rng);
  return ((s>>33)&1) as i32;
}
// edge flip with p = 0.05 via a wider modulus (better bit quality)
fn rng_flip(rng:[]u8)i32 {
  if((rng_range(rng,2000) as i32)<100){ return 1; }
  return 0;
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
// variable name: 0->X, 1->Y, 2->Z (single chars; format scaffolding)
fn vname(v:i32)[]u8 {
  if(v==0){return "X";}
  if(v==1){return "Y";}
  return "Z";
}
// append chain string (root->middle->leaf) built from a 3-byte chain array
fn app_chain(buf:[]u8,at:i32,ch:[]u8)i32 {
  at=app(buf,at,vname(ch[0] as i32));
  at=app(buf,at,"->");
  at=app(buf,at,vname(ch[1] as i32));
  at=app(buf,at,"->");
  at=app(buf,at,vname(ch[2] as i32));
  return at;
}
// append chain string from the 18-byte perms table at slot pi
fn app_perm(buf:[]u8,at:i32,perms:[]u8,pi:i32)i32 {
  at=app(buf,at,vname(perms[pi*3] as i32));
  at=app(buf,at,"->");
  at=app(buf,at,vname(perms[pi*3+1] as i32));
  at=app(buf,at,"->");
  at=app(buf,at,vname(perms[pi*3+2] as i32));
  return at;
}
// emit one {"t":"c",...} or {"t":"do_out",...} value triple from vv[3]
fn app_vals(buf:[]u8,at:i32,tag:[]u8,vv:[]u8)i32 {
  at=app(buf,at,tag);
  at=app(buf,at,i64s(vv[0] as i64));
  at=app(buf,at,",\"y\":");
  at=app(buf,at,i64s(vv[1] as i64));
  at=app(buf,at,",\"z\":");
  at=app(buf,at,i64s(vv[2] as i64));
  at=app(buf,at,"}\n");
  return at;
}

fn main()i32 {
  if(_zag_argc()!=3){ emit("usage: c9gen <seed> <outdir>\n"); return 1; }
  let seed:i64=parse_u64(_zag_arg(1));
  if(seed<0){ errln("bad seed"); return 1; }
  let outdir:[]u8=_zag_arg(2);
  let rng:[]u8=z_alloc(8);
  rng[0]=(seed as u8); rng[1]=((seed>>8) as u8); rng[2]=((seed>>16) as u8); rng[3]=((seed>>24) as u8);
  rng[4]=((seed>>32) as u8); rng[5]=((seed>>40) as u8); rng[6]=((seed>>48) as u8); rng[7]=((seed>>56) as u8);
  // frozen params (PREREG_C9GEN section 2)
  let NW:i32=24;
  let NOBS:i32=400;
  let KDO:i32=60;
  // 6 permutations of {0,1,2} in 18 bytes
  let perms:[]u8=z_alloc(18);
  perms[0]=0;perms[1]=1;perms[2]=2; perms[3]=0;perms[4]=2;perms[5]=1;
  perms[6]=1;perms[7]=0;perms[8]=2; perms[9]=1;perms[10]=2;perms[11]=0;
  perms[12]=2;perms[13]=0;perms[14]=1; perms[15]=2;perms[16]=1;perms[17]=0;
  let turns:[]u8=z_alloc(1200000);
  let key:[]u8=z_alloc(4096);
  let worlds:[]u8=z_alloc(8192);
  let man:[]u8=z_alloc(1024);
  let tat:i32=0; let kat:i32=0; let wat:i32=0;
  let w:i32=0;
  while(w<NW){
    // 3.1 true chain: uniform index into the 6 permutations.
    // (A Fisher-Yates driven by %3/%2 draws was tried first; the LCG's
    // low bits have short periods under the even inter-world draw
    // count, so only 3 of 6 permutations appeared in 24 worlds.
    // Indexing via %6000/1000 uses higher bits and reaches all 6.)
    let ch:[]u8=z_alloc(3);
    let truepi0:i32=(rng_range(rng,6000) as i32)/1000;
    ch[0]=perms[truepi0*3]; ch[1]=perms[truepi0*3+1]; ch[2]=perms[truepi0*3+2];
    // 3.2 observational turns (noise on every edge; no x==y==z enforcement)
    let o:i32=0;
    while(o<NOBS){
      let vv:[]u8=z_alloc(3);
      let q:i32=0;
      while(q<3){
        let var:i32=ch[q] as i32;
        if(q==0){ vv[var]=rng_bit(rng) as u8; }
        else {
          let parent:i32=ch[q-1] as i32;
          let b:i32=vv[parent] as i32;
          if(rng_flip(rng)==1){ b=1-b; }
          vv[var]=b as u8;
        }
        q=q+1;
      }
      tat=app_vals(turns,tat,"{\"t\":\"c\",\"x\":",vv);
      o=o+1;
    }
    // 3.3 intervention turns: KDO do(X,v) then KDO do(Z,v), v alternating 1,0
    let vi:i32=0;
    while(vi<2){
      let ivar:i32=0;
      if(vi==1){ ivar=2; }
      let d:i32=0;
      while(d<KDO){
        let val:i32=1;
        if((d%2)==1){ val=0; }
        tat=app(turns,tat,"{\"t\":\"do\",\"var\":\"");
        tat=app(turns,tat,vname(ivar));
        tat=app(turns,tat,"\",\"val\":");
        tat=app(turns,tat,i64s(val as i64));
        tat=app(turns,tat,"}\n");
        // intervened ancestral sampling in chain order
        let vv2:[]u8=z_alloc(3);
        let q2:i32=0;
        while(q2<3){
          let var:i32=ch[q2] as i32;
          if(var==ivar){ vv2[var]=val as u8; }
          else {
            if(q2==0){ vv2[var]=rng_bit(rng) as u8; }
            else {
              let parent:i32=ch[q2-1] as i32;
              let b:i32=vv2[parent] as i32;
              if(rng_flip(rng)==1){ b=1-b; }
              vv2[var]=b as u8;
            }
          }
          q2=q2+1;
        }
        tat=app_vals(turns,tat,"{\"t\":\"do_out\",\"x\":",vv2);
        d=d+1;
      }
      vi=vi+1;
    }
    // 3.4 discrim item: true chain + uniform random alt, coin-flip order
    let truepi:i32=-1;
    let pi:i32=0;
    while(pi<6){
      let same:i32=1;
      let q3:i32=0;
      while(q3<3){
        if(perms[pi*3+q3]!=ch[q3]){ same=0; }
        q3=q3+1;
      }
      if(same==1){ truepi=pi; }
      pi=pi+1;
    }
    let altpi:i32=(rng_range(rng,5) as i32);
    if(altpi>=truepi){ altpi=altpi+1; }
    let firsttrue:i32=rng_bit(rng);
    tat=app(turns,tat,"{\"t\":\"q\",\"cap\":9,\"q\":\"discrim|");
    if(firsttrue==1){
      tat=app_chain(turns,tat,ch);
      tat=app(turns,tat,"|");
      tat=app_perm(turns,tat,perms,altpi);
    } else {
      tat=app_perm(turns,tat,perms,altpi);
      tat=app(turns,tat,"|");
      tat=app_chain(turns,tat,ch);
    }
    tat=app(turns,tat,"\"}\n");
    // key + audit
    kat=app(key,kat,i64s(w as i64));
    kat=app(key,kat,"|");
    kat=app_chain(key,kat,ch);
    kat=app(key,kat,"\n");
    wat=app(worlds,wat,"world ");
    wat=app(worlds,wat,i64s(w as i64));
    wat=app(worlds,wat," chain ");
    wat=app_chain(worlds,wat,ch);
    wat=app(worlds,wat," alt ");
    wat=app_perm(worlds,wat,perms,altpi);
    wat=app(worlds,wat," first ");
    wat=app(worlds,wat,i64s(firsttrue as i64));
    wat=app(worlds,wat,"\n");
    w=w+1;
  }
  // manifest
  let mat:i32=0;
  mat=app(man,mat,"c9gen manifest\n");
  mat=app(man,mat,"seed ");
  mat=app(man,mat,i64s(seed));
  mat=app(man,mat,"\nworlds ");
  mat=app(man,mat,i64s(NW as i64));
  mat=app(man,mat,"\nnobs ");
  mat=app(man,mat,i64s(NOBS as i64));
  mat=app(man,mat,"\nkdo ");
  mat=app(man,mat,i64s(KDO as i64));
  mat=app(man,mat,"\npflip_num 5\npflip_den 100\n");
  if(_zag_write_file(pjoin(outdir,"turns.jsonl"),turns[0..tat])!=0){ errln("write turns failed"); return 1; }
  if(_zag_write_file(pjoin(outdir,"key.txt"),key[0..kat])!=0){ errln("write key failed"); return 1; }
  if(_zag_write_file(pjoin(outdir,"worlds.txt"),worlds[0..wat])!=0){ errln("write worlds failed"); return 1; }
  if(_zag_write_file(pjoin(outdir,"manifest.txt"),man[0..mat])!=0){ errln("write manifest failed"); return 1; }
  emit("C9GEN-OK worlds=");
  emit(i64s(NW as i64));
  emit(" turn_bytes=");
  emit(i64s(tat as i64));
  emit("\n");
  return 0;
}

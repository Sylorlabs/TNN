// c9gamer.zag -- format-parsing negative control (pure Zag).
// Implements the frozen arena C9 exploit family as a control:
//   old:    parse the first candidate after "discrim|", emit its
//           first variable (the exact 3/3 mechanism on the broken battery)
//   first:  emit the first candidate's full chain string
//   second: emit the second candidate's full chain string
// Reads only turns.jsonl. Zero experience, zero causal structure.
// Usage: c9gamer <turns.jsonl> <old|first|second>
// Prints one reply line per question.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
// find first occurrence of needle in hay starting at `from`; -1 if absent
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}

fn main()i32 {
  if(_zag_argc()!=3){ emit("usage: c9gamer <turns.jsonl> <old|first|second>\n"); return 1; }
  let data:[]u8=_zag_read_file(_zag_arg(1));
  if(data.len==0){ errln("empty or unreadable turns file"); return 1; }
  let mode:[]u8=_zag_arg(2);
  let m:i32=0; // 0=old 1=first 2=second
  if(streq(mode,"first")==1){ m=1; }
  else { if(streq(mode,"second")==1){ m=2; } }
  let out:[]u8=z_alloc(4096);
  let oat:i32=0;
  let pos:i32=0;
  while(pos<data.len){
    // one line: up to next \n
    let eol:i32=findsub(data,pos,"\n");
    if(eol<0){ eol=data.len; }
    let line:[]u8=data[pos..eol];
    let dp:i32=findsub(line,0,"\"q\":\"discrim|");
    if(dp>=0){
      let ps:i32=dp+13; // start of first candidate
      let sep:i32=findsub(line,ps,"|");
      let qend:i32=findsub(line,ps,"\"}");
      if(sep>0 && qend>sep){
        let candA:[]u8=line[ps..sep];
        let candB:[]u8=line[sep+1..qend];
        if(m==0){
          // old exploit: first candidate's first variable
          oat=app(out,oat,candA[0..1]);
        } else {
          if(m==1){ oat=app(out,oat,candA); }
          else { oat=app(out,oat,candB); }
        }
        oat=app(out,oat,"\n");
      }
    }
    pos=eol+1;
  }
  _zag_print(out[0..oat]);
  return 0;
}

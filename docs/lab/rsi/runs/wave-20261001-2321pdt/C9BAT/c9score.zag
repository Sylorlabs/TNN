// c9score.zag -- deterministic scorer for the C9GEN battery (pure Zag).
// Usage: c9score <key.txt> <replies.txt>
// key.txt lines: "idx|chain"; replies.txt: one reply per line, aligned.
// Prints "SCORE a/b" to stdout; per-item mismatches to stderr.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
// count lines (split on \n); trailing empty segment not counted
fn nlines(d:[]u8)i32 {
  let n:i32=0;
  let pos:i32=0;
  while(pos<d.len){
    let eol:i32=findsub(d,pos,"\n");
    if(eol<0){ eol=d.len; }
    if(eol>pos){ n=n+1; }
    pos=eol+1;
  }
  return n;
}
// fetch the k-th non-empty line (0-based)
fn getline(d:[]u8,k:i32)[]u8 {
  let n:i32=0;
  let pos:i32=0;
  while(pos<d.len){
    let eol:i32=findsub(d,pos,"\n");
    if(eol<0){ eol=d.len; }
    if(eol>pos){
      if(n==k){ return d[pos..eol]; }
      n=n+1;
    }
    pos=eol+1;
  }
  return "";
}

fn main()i32 {
  if(_zag_argc()!=3){ emit("usage: c9score <key.txt> <replies.txt>\n"); return 1; }
  let kd:[]u8=_zag_read_file(_zag_arg(1));
  let rd:[]u8=_zag_read_file(_zag_arg(2));
  if(kd.len==0){ errln("empty key file"); return 1; }
  if(rd.len==0){ errln("empty replies file"); return 1; }
  let nk:i32=nlines(kd);
  let nr:i32=nlines(rd);
  if(nk!=nr){
    errln("line count mismatch");
    emit("key_lines=");
    emit(i64s(nk as i64));
    emit(" reply_lines=");
    emit(i64s(nr as i64));
    emit("\n");
    return 1;
  }
  let good:i32=0;
  let i:i32=0;
  while(i<nk){
    let kl:[]u8=getline(kd,i);
    let rl:[]u8=getline(rd,i);
    let sep:i32=findsub(kl,0,"|");
    let ans:[]u8=kl;
    if(sep>=0){ ans=kl[sep+1..kl.len]; }
    if(streq(ans,rl)==1){ good=good+1; }
    else {
      let eb:[]u8=z_alloc(256);
      let at:i32=app(eb,0,"MISS item ");
      at=app(eb,at,i64s(i as i64));
      at=app(eb,at," key=");
      at=app(eb,at,ans);
      at=app(eb,at," got=");
      at=app(eb,at,rl);
      at=app(eb,at,"\n");
      _zag_eprintln(eb[0..at]);
    }
    i=i+1;
  }
  emit("SCORE ");
  emit(i64s(good as i64));
  emit("/");
  emit(i64s(nk as i64));
  emit("\n");
  return 0;
}

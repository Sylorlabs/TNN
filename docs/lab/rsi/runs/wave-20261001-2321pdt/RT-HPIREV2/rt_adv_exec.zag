// proc_revise2.zag -- H-PI-REV2: procedure-invention v2 revision machinery.
//
// Frozen prereg (committed alone before any implementation):
// docs/lab/rsi/runs/wave-20260929-1721pdt/design_lane/PREREG_PI_REV2.md
// Implements the frozen protocol P0-P9. P8 adversary F2 runs when argv[1]
// is a single byte from the frozen allowed set. Pure Zag. Pinned znc.
//
// Section A below (through print_prog) is a byte-verbatim port of the
// discovery-enumeration helpers from the frozen H-REVISE source:
// docs/lab/research-lead/overnight-20260928/sem_l3/proc_revise_test.zag
// (cmp-verified at implementation time; that file is frozen history).
// Section B is the new generic machinery: procedure store, example log,
// monitor loop, diagnosis operator, primitive-construction kit,
// SPECIALIZE revision operator, conflict rule, ROLLBACK.
//
// Audit note (K-RV2-1a, K-RV2-7): the machinery functions in Section B
// (observe, diagnose, build_test, specialize, predict, rollback) contain
// no character literal equal to any fixture byte and no fixture string
// literals; all condition bytes flow from data. Fixture declarations and
// expected-output strings live in main() only.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  return _zag_i64_to_str(v as i64);
}

fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn eval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let l:i32=prog[base+1] as i32;
    let r:i32=prog[base+2] as i32;
    let a:i32=eval_node(prog, l, k, n);
    let b:i32=eval_node(prog, r, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn eval_prog(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return eval_node(prog, nnodes-1, k, n);
}

fn extract_seq(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}

fn prog_fits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    let expected:i32=get32(seq, k*4);
    let got:i32=eval_prog(prog, nnodes, k, n);
    if(got!=expected){return 0;}
    k=k+1;
  }
  return 1;
}

fn add_term(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, term_type:i32)i32 {
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=1 as u8;
  prog_store[store_off+1]=term_type as u8;
  prog_store[store_off+2]=255 as u8;
  prog_store[store_off+3]=255 as u8;
  return store_off+4;
}

fn add_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, left_pi:i32, right_pi:i32)i32 {
  let left_off:i32=get32(prog_index, left_pi*4);
  let right_off:i32=get32(prog_index, right_pi*4);
  let left_n:i32=prog_store[left_off] as i32;
  let right_n:i32=prog_store[right_off] as i32;
  let total_n:i32=left_n+right_n+1;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=total_n as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<left_n){
    prog_store[dst]=prog_store[left_off+1+i*3];
    prog_store[dst+1]=prog_store[left_off+1+i*3+1];
    prog_store[dst+2]=prog_store[left_off+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<right_n){
    let t:i32=prog_store[right_off+1+i*3] as i32;
    let l:i32=prog_store[right_off+1+i*3+1] as i32;
    let r:i32=prog_store[right_off+1+i*3+2] as i32;
    prog_store[dst]=t as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+left_n) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+left_n) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(left_n-1) as u8;
  prog_store[dst+2]=(left_n+right_n-1) as u8;
  dst=dst+3;
  return dst;
}

fn get_prog(prog_store:[]u8, prog_index:[]u8, pi:i32, out_nnodes:[]u8)[]u8 {
  let off:i32=get32(prog_index, pi*4);
  out_nnodes[0]=prog_store[off];
  return prog_store[off+1..off+1+ (prog_store[off] as i32)*3];
}

fn print_seq(seq:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    emit(i32s(get32(seq, i*4)));
    i=i+1;
  }
  emit("]");
  return;
}

fn print_prog(prog:[]u8, nnodes:i32)void {
  emit("[");
  let i:i32=0;
  while(i<nnodes){
    if(i>0){emit(" ");}
    let tt:i32=prog[i*3] as i32;
    if(tt==0){emit("K");}
    else if(tt==1){emit("N");}
    else if(tt==2){emit("C0");}
    else if(tt==3){emit("C1");}
    else if(tt==4){emit("C2");}
    else if(tt==5){emit("ADD");}
    else if(tt==6){emit("SUB");}
    i=i+1;
  }
  emit("]");
  return;
}

// ============ Section B: H-PI-REV2 new machinery (generic, data-driven) ============
// NOTE: this section avoids the letter used by fixture bytes in identifiers,
// comments, and string literals, so audits stay mechanical.

// Ported enumeration loop, wrapped as a function (same algorithm as v1 main).
fn benum(prog_store:[]u8, prog_index:[]u8)i32 {
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    store_off=add_term(prog_store, prog_index, pcount, store_off, t);
    pcount=pcount+1; t=t+1;
  }
  let size1_end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let size3_end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=size1_end;
      while(b<size3_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    a=size1_end;
    while(a<size3_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  return pcount;
}

// Sequence staging: flat buffer of up to 4 seqs, 16 entries each.
fn loadseq(sdat:[]u8, sod:[]u8, sld:[]u8, snd:[]u8, slot:i32, inp:[]u8, out:[]u8, n:i32)i32 {
  let sq:[]u8=z_alloc(64);
  let ln:i32=extract_seq(inp, out, sq);
  let off:i32=slot*64;
  let i:i32=0;
  while(i<64){ sdat[off+i]=sq[i]; i=i+1; }
  set32(sod, slot*4, off);
  set32(sld, slot*4, ln);
  set32(snd, slot*4, n);
  return ln;
}
fn getseq(sdat:[]u8, sod:[]u8, sld:[]u8, s:i32, lnout:[]u8)[]u8 {
  let off:i32=get32(sod, s*4);
  let ln:i32=get32(sld, s*4);
  set32(lnout, 0, ln);
  if(ln<0){ return sdat[0..0]; }
  return sdat[off..off+ln*4];
}

// Smallest program fitting all staged seqs; -1 when none fits.
fn dsearch(ps:[]u8, pidx:[]u8, pcount:i32, sdat:[]u8, sod:[]u8, sld:[]u8, snd:[]u8, nseq:i32)i32 {
  let tmp:[]u8=z_alloc(1);
  let lnb:[]u8=z_alloc(4);
  let pi:i32=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(ps, pidx, pi, tmp);
    let nn:i32=tmp[0] as i32;
    let ok:i32=1;
    let s:i32=0;
    while(s<nseq){
      let sq:[]u8=getseq(sdat, sod, sld, s, lnb);
      let ln:i32=get32(lnb, 0);
      let n:i32=get32(snd, s*4);
      if(prog_fits(prog, nn, sq, ln, n)!=1){ ok=0; s=nseq; }
      s=s+1;
    }
    if(ok==1){ return pi; }
    pi=pi+1;
  }
  return -1;
}

// Example log. st layout: [0]=count, then slots of 6 i32:
// in_off, in_len, out_off, out_len, status (0 current, 1 superseded), phase.
fn ex_add(st:[]u8, pool:[]u8, pu:[]u8, inp:[]u8, out:[]u8, phase:i32)i32 {
  let n:i32=get32(st, 0);
  let puv:i32=get32(pu, 0);
  let base:i32=4+n*24;
  set32(st, base, puv);
  set32(st, base+4, inp.len);
  let i:i32=0;
  while(i<inp.len){ pool[puv+i]=inp[i]; i=i+1; }
  puv=puv+inp.len;
  set32(st, base+8, puv);
  set32(st, base+12, out.len);
  i=0;
  while(i<out.len){ pool[puv+i]=out[i]; i=i+1; }
  puv=puv+out.len;
  set32(st, base+16, 0);
  set32(st, base+20, phase);
  set32(st, 0, n+1);
  set32(pu, 0, puv);
  return n;
}
fn ex_in(st:[]u8, pool:[]u8, e:i32)[]u8 {
  let base:i32=4+e*24;
  let off:i32=get32(st, base);
  let ln:i32=get32(st, base+4);
  return pool[off..off+ln];
}
fn ex_out(st:[]u8, pool:[]u8, e:i32)[]u8 {
  let base:i32=4+e*24;
  let off:i32=get32(st, base+8);
  let ln:i32=get32(st, base+12);
  return pool[off..off+ln];
}
fn ex_status(st:[]u8, e:i32)i32 {
  return get32(st, 4+e*24+16);
}

fn bytes_eq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){
    if(a[i]!=b[i]){ return 0; }
    i=i+1;
  }
  return 1;
}

// Predict with the ACTIVE procedure: branch list (most recent first),
// else the base program. Returns output length, or -1 when a program
// yields an out-of-range position.
fn predict(base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, inp:[]u8, out:[]u8)i32 {
  let n:i32=inp.len;
  let psel:i32=base;
  let bi:i32=nb-1;
  let done:i32=0;
  while(bi>=0){
    if(done==0){
      let bpos:i32=get32(br, bi*12);
      if(bpos<n){
        if((inp[bpos] as i32)==get32(br, bi*12+4)){
          psel=get32(br, bi*12+8);
          done=1;
        }
      }
    }
    bi=bi-1;
  }
  let tmp:[]u8=z_alloc(1);
  let pr:[]u8=get_prog(ps, pidx, psel, tmp);
  let nn:i32=tmp[0] as i32;
  let k:i32=0;
  while(k<n){
    let id:i32=eval_prog(pr, nn, k, n);
    if(id<0){ return -1; }
    if(id>=n){ return -1; }
    out[k]=inp[id];
    k=k+1;
  }
  return n;
}

// Monitor loop: predict with the ACTIVE procedure, compare against the
// observed output. Detection is purely predict-vs-actual mismatch; this
// function holds no branch on input content (audited, K-RV2-3).
// Returns 1 when a counterexample is detected, else 0.
fn observe(st:[]u8, pool:[]u8, pu:[]u8, base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, inp:[]u8, out:[]u8, phase:i32, probe:[]u8)i32 {
  let n:i32=predict(base, br, nb, ps, pidx, inp, probe);
  let _ex:i32=ex_add(st, pool, pu, inp, out, phase);
  if(n!=out.len){
    emit("COUNTEREXAMPLE_DETECTED(");
    emit(inp);
    emit(")\n");
    return 1;
  }
  if(bytes_eq(probe[0..n], out)!=1){
    emit("COUNTEREXAMPLE_DETECTED(");
    emit(inp);
    emit(")\n");
    return 1;
  }
  return 0;
}

// Diagnosis operator. Failing set F and passing set P come from the log
// under the ACTIVE procedure. Candidate conditions (p, b): every f in F
// holds byte b at position p. Rank: position ascending, then byte
// ascending (frozen; the second key never decides on frozen evidence).
// Conflicts with P are recorded, never disqualifying.
// dout: [pos, byte, nconflict]. Returns 1, or 0 with CANNOT-DIAGNOSE.
fn diagnose(st:[]u8, pool:[]u8, base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, dout:[]u8, probe:[]u8)i32 {
  let n:i32=get32(st, 0);
  let fb:[]u8=z_alloc(32*4);
  let pb:[]u8=z_alloc(32*4);
  let nf:i32=0;
  let np:i32=0;
  let e:i32=0;
  while(e<n){
    if(ex_status(st, e)==0){
      let ie:[]u8=ex_in(st, pool, e);
      let oe:[]u8=ex_out(st, pool, e);
      let pr:i32=predict(base, br, nb, ps, pidx, ie, probe);
      let bad:i32=0;
      if(pr!=oe.len){ bad=1; }
      else {
        if(bytes_eq(probe[0..pr], oe)!=1){ bad=1; }
      }
      if(bad==1){ set32(fb, nf*4, e); nf=nf+1; }
      else { set32(pb, np*4, e); np=np+1; }
    }
    e=e+1;
  }
  let cb:[]u8=z_alloc(64*8);
  let nc:i32=0;
  let fi:i32=0;
  while(fi<nf){
    let fe:i32=get32(fb, fi*4);
    let fin:[]u8=ex_in(st, pool, fe);
    let p:i32=0;
    while(p<fin.len){
      let b:i32=fin[p] as i32;
      let ok:i32=1;
      let fj:i32=0;
      while(fj<nf){
        let fe2:i32=get32(fb, fj*4);
        let fin2:[]u8=ex_in(st, pool, fe2);
        if(p>=fin2.len){ ok=0; fj=nf; }
        else {
          if((fin2[p] as i32)!=b){ ok=0; fj=nf; }
        }
        fj=fj+1;
      }
      if(ok==1){
        let dup:i32=0;
        let ci:i32=0;
        while(ci<nc){
          if(get32(cb, ci*8)==p){
            if(get32(cb, ci*8+4)==b){ dup=1; ci=nc; }
          }
          ci=ci+1;
        }
        if(dup==0){
          set32(cb, nc*8, p);
          set32(cb, nc*8+4, b);
          nc=nc+1;
        }
      }
      p=p+1;
    }
    fi=fi+1;
  }
  if(nc==0){
    emit("CANNOT-DIAGNOSE\n");
    return 0;
  }
  let bpos:i32=1000000;
  let bbyte:i32=1000000;
  let ci2:i32=0;
  while(ci2<nc){
    let p2:i32=get32(cb, ci2*8);
    let b2:i32=get32(cb, ci2*8+4);
    if(p2<bpos){ bpos=p2; bbyte=b2; }
    else {
      if(p2==bpos){
        if(b2<bbyte){ bbyte=b2; }
      }
    }
    ci2=ci2+1;
  }
  let ncon:i32=0;
  let pj:i32=0;
  while(pj<np){
    let pe:i32=get32(pb, pj*4);
    let pin:[]u8=ex_in(st, pool, pe);
    if(bpos<pin.len){
      if((pin[bpos] as i32)==bbyte){ ncon=ncon+1; }
    }
    pj=pj+1;
  }
  set32(dout, 0, bpos);
  set32(dout, 4, bbyte);
  set32(dout, 8, ncon);
  emit("DIAGNOSIS pos=");
  emit(i32s(bpos));
  emit(" byte=");
  emit(i32s(bbyte));
  emit(" conflicts=");
  emit(i32s(ncon));
  emit("\n");
  return 1;
}

// Primitive-construction kit: mechanically build the test (pos, byte).
// The byte value arrives as data; no literal lives here.
fn build_test(br:[]u8, nbr:[]u8, pos:i32, byte:i32)i32 {
  let n:i32=get32(nbr, 0);
  set32(br, n*12, pos);
  set32(br, n*12+4, byte);
  set32(br, n*12+8, -1);
  set32(nbr, 0, n+1);
  emit("PRIMITIVE-CONSTRUCTED pos=");
  emit(i32s(pos));
  emit(" byte=");
  emit(i32s(byte));
  emit("\n");
  return n;
}

// SPECIALIZE revision operator: v_new = IF(test, alt, v_old).
// Old version -> SUBSUMED. Conflict rule: a passing record that holds
// the test but was seen under the old version is marked SUPERSEDED
// (newer trusted evidence overrides; records are kept, never deleted).
// vst slot: 8 i32 = id, base_prog, status, parent, trigger, dpos, dbyte, nbranches.
fn specialize(st:[]u8, pool:[]u8, br:[]u8, nbr:[]u8, base:i32, vst:[]u8, vn:[]u8, bidx:i32, alt:i32, trig:i32, pos:i32, byte:i32)i32 {
  set32(br, bidx*12+8, alt);
  let old:i32=get32(vn, 0)-1;
  set32(vst, old*32+8, 1);
  let n:i32=get32(st, 0);
  let e:i32=0;
  while(e<n){
    if(e!=trig){
      if(ex_status(st, e)==0){
        let ie:[]u8=ex_in(st, pool, e);
        if(pos<ie.len){
          if((ie[pos] as i32)==byte){
            set32(st, 4+e*24+16, 1);
            emit("SUPERSEDED rec=");
            emit(i32s(e));
            emit("\n");
          }
        }
      }
    }
    e=e+1;
  }
  let nv:i32=get32(vn, 0);
  set32(vst, nv*32, nv+1);
  set32(vst, nv*32+4, base);
  set32(vst, nv*32+8, 0);
  set32(vst, nv*32+12, old+1);
  set32(vst, nv*32+16, trig);
  set32(vst, nv*32+20, pos);
  set32(vst, nv*32+24, byte);
  set32(vst, nv*32+28, get32(nbr, 0));
  set32(vn, 0, nv+1);
  emit("VERSION v");
  emit(i32s(nv+1));
  emit(" ACTIVE (parent v");
  emit(i32s(old+1));
  emit(")\n");
  return nv+1;
}

// ROLLBACK(v): reactivate v; later versions stay on record as SUBSUMED.
fn rollback(base:[]u8, nbr:[]u8, vst:[]u8, vn:[]u8, v1base:i32)void {
  set32(base, 0, v1base);
  set32(nbr, 0, 0);
  let n:i32=get32(vn, 0);
  let v:i32=0;
  while(v<n){
    if(v==0){ set32(vst, v*32+8, 0); }
    else { set32(vst, v*32+8, 1); }
    v=v+1;
  }
  emit("ROLLBACK to v1\n");
  return;
}

fn check(name:[]u8, cond:i32, fails:[]u8)void {
  emit("CHECK ");
  emit(name);
  emit(": ");
  if(cond==1){ emit("PASS\n"); }
  else {
    emit("FAIL\n");
    set32(fails, 0, get32(fails, 0)+1);
  }
  return;
}

fn pcheck(base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, probe:[]u8, inp:[]u8, want:[]u8, fails:[]u8)void {
  let n:i32=predict(base, br, nb, ps, pidx, inp, probe);
  emit("PREDICT ");
  emit(inp);
  emit(" -> ");
  if(n<0){
    emit("UNPREDICTABLE\n");
    set32(fails, 0, get32(fails, 0)+1);
    return;
  }
  let got:[]u8=probe[0..n];
  emit(got);
  if(n==want.len){
    if(bytes_eq(got, want)==1){
      emit(" [ok]\n");
      return;
    }
  }
  emit(" [MISMATCH want ");
  emit(want);
  emit("]\n");
  set32(fails, 0, get32(fails, 0)+1);
  return;
}

fn rcell(base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, probe:[]u8, fails:[]u8)void {
  pcheck(base, br, nb, ps, pidx, probe, "zag", "ggg", fails);
  pcheck(base, br, nb, ps, pidx, probe, "12", "22", fails);
  pcheck(base, br, nb, ps, pidx, probe, "q", "q", fails);
  pcheck(base, br, nb, ps, pidx, probe, "hello", "ooooo", fails);
  pcheck(base, br, nb, ps, pidx, probe, "ptc", "ccc", fails);
  pcheck(base, br, nb, ps, pidx, probe, "s", "s", fails);
  pcheck(base, br, nb, ps, pidx, probe, "eghjjupazbnf", "ffffffffffff", fails);
  pcheck(base, br, nb, ps, pidx, probe, "q", "q", fails);
  return;
}


// ---- RT-HPIREV2 adversarial executor (new code; everything above this
// line is the byte-verbatim frozen machinery from proc_revise2.zag at
// 847a8f10f, lines 1-606; sha256
// 8d2b16ab31184758b2b724e19cb1fa9f96d5ff008a0674b6c95c1da8e227f712) ----
// Sealed execution of the six ADV worlds frozen in ADV_SEAL.md
// (commit 8b86b27d2). The sealed world files' sha256 hashes are verified
// by the shell pre-step (sha256sum -c against ADV_SEAL.md) before any
// run; the staged literals below were transcribed from the sealed files
// and are verified byte-exact via emitted STAGE lines diffed against the
// sealed files. Protocol mirrors the lane's s8 executor: V0/V1/V2/V3
// prechecks, train v1w, present FW, frozen revision (diagnose,
// build_test, alt dsearch on FW alone, specialize), score EW (W1, W2),
// present RW after revision ACTIVE (W3). No world-specific branching
// beyond staged literals; no new semantic cases, modes, bridges,
// routers, or handlers. Pure Zag.

fn akey(a:[]u8, c0:u8, c1:u8)i32 {
  if(a.len!=2){ return 0; }
  if(a[0]==c0){
    if(a[1]==c1){ return 1; }
  }
  return 0;
}
fn ahasb(a:[]u8, x:i32)i32 {
  let i:i32=0;
  while(i<a.len){
    if((a[i] as i32)==x){ return 1; }
    i=i+1;
  }
  return 0;
}
// Mechanical mirror of diagnose's candidate-generation logic (staging/
// scoring helper only; the frozen diagnose itself decides).
fn acount_candidates(st:[]u8, pool:[]u8, base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, probe:[]u8)i32 {
  let n:i32=get32(st, 0);
  let fb:[]u8=z_alloc(32*4);
  let nf:i32=0;
  let e:i32=0;
  while(e<n){
    if(ex_status(st, e)==0){
      let ie:[]u8=ex_in(st, pool, e);
      let oe:[]u8=ex_out(st, pool, e);
      let pr:i32=predict(base, br, nb, ps, pidx, ie, probe);
      let bad:i32=0;
      if(pr!=oe.len){ bad=1; }
      else {
        if(bytes_eq(probe[0..pr], oe)!=1){ bad=1; }
      }
      if(bad==1){ set32(fb, nf*4, e); nf=nf+1; }
    }
    e=e+1;
  }
  let cb:[]u8=z_alloc(64*8);
  let nc:i32=0;
  let fi:i32=0;
  while(fi<nf){
    let fe:i32=get32(fb, fi*4);
    let fin:[]u8=ex_in(st, pool, fe);
    let p:i32=0;
    while(p<fin.len){
      let b:i32=fin[p] as i32;
      let ok:i32=1;
      let fj:i32=0;
      while(fj<nf){
        let fe2:i32=get32(fb, fj*4);
        let fin2:[]u8=ex_in(st, pool, fe2);
        if(p>=fin2.len){ ok=0; fj=nf; }
        else {
          if((fin2[p] as i32)!=b){ ok=0; fj=nf; }
        }
        fj=fj+1;
      }
      if(ok==1){
        let dup:i32=0;
        let ci:i32=0;
        while(ci<nc){
          if(get32(cb, ci*8)==p){
            if(get32(cb, ci*8+4)==b){ dup=1; ci=nc; }
          }
          ci=ci+1;
        }
        if(dup==0){
          set32(cb, nc*8, p);
          set32(cb, nc*8+4, b);
          nc=nc+1;
        }
      }
      p=p+1;
    }
    fi=fi+1;
  }
  return nc;
}
fn aemit_stage(tag:[]u8, inp:[]u8, out:[]u8)void {
  emit("STAGE ");
  emit(tag);
  emit(" \"");
  emit(inp);
  emit("\"->\"");
  emit(out);
  emit("\"\n");
  return;
}
fn main()i32 {
  emit("=== ADV EXEC ===\n");
  let fails:[]u8=z_alloc(4);
  set32(fails, 0, 0);
  let pf:[]u8=z_alloc(4);
  set32(pf, 0, 0);
  let ps:[]u8=z_alloc(200000);
  let pidx:[]u8=z_alloc(1200*4);
  let pcount:i32=benum(ps, pidx);
  emit("enumerated ");
  emit(i32s(pcount));
  emit(" programs\n");
  check("enum-count-1055", pcount==1055, fails);
  let fam:[]u8=_zag_arg(1);
  let is_s1:i32=akey(fam, "S"[0], "1"[0]);
  let is_s2:i32=akey(fam, "S"[0], "2"[0]);
  let is_s3:i32=akey(fam, "S"[0], "3"[0]);
  let is_s4:i32=akey(fam, "S"[0], "4"[0]);
  let is_m1:i32=akey(fam, "M"[0], "1"[0]);
  let is_m2:i32=akey(fam, "M"[0], "2"[0]);
  if(is_s1==0){
    if(is_s2==0){
      if(is_s3==0){
        if(is_s4==0){
          if(is_m1==0){
            if(is_m2==0){
              emit("usage: rt_adv_exec [S1|S2|S3|S4|M1|M2]\n");
              return 2;
            }
          }
        }
      }
    }
  }
  emit("family ");
  emit(fam);
  emit("\n");
  // ---- stage sealed world data (literals transcribed from adv_sealed/) ----
  let t0i:[]u8="";
  let t0o:[]u8="";
  let t1i:[]u8="";
  let t1o:[]u8="";
  let t2i:[]u8="";
  let t2o:[]u8="";
  let fwi:[]u8="";
  let fwo:[]u8="";
  let rwi:[]u8="";
  let rwo:[]u8="";
  let c0p:i32=0;
  let c0b:i32=0;
  let allow2:i32=-1;
  if(is_s1==1){
    t0i="ABC"; t0o="CBA";
    t1i="DEFG"; t1o="GFED";
    t2i="HI"; t2o="IH";
    fwi="Q!RT"; fwo="QQQQ";
    rwi="QmWn"; rwo="QQQQ";
    c0p=0; c0b=81; allow2=-1;
  }
  if(is_s2==1){
    t0i="ABC"; t0o="ABC";
    t1i="DF"; t1o="DF";
    t2i="GHIJ"; t2o="GHIJ";
    fwi="QWERTY"; fwo="YTREWQ";
    rwi="Qzxwvu"; rwo="uvwxzQ";
    c0p=0; c0b=81; allow2=-1;
  }
  if(is_s3==1){
    t0i="ABC"; t0o="BBB";
    t1i="DFGH"; t1o="FFFF";
    t2i="HI"; t2o="II";
    fwi="QWERTY"; fwo="YTREWQ";
    rwi="Qabcde"; rwo="edcbaQ";
    c0p=0; c0b=81; allow2=-1;
  }
  if(is_s4==1){
    t0i="ACD"; t0o="DDD";
    t1i="EF"; t1o="FF";
    t2i="GHIJ"; t2o="JJJJ";
    fwi="x!Bz"; fwo="xxxx";
    rwi="p!Br"; rwo="pppp";
    c0p=2; c0b=66; allow2=-1;
  }
  if(is_m1==1){
    t0i="ACD"; t0o="DDD";
    t1i="EF"; t1o="FF";
    t2i="GHIJ"; t2o="JJJJ";
    fwi="Q!RT"; fwo="QQQQ";
    rwi="Q!BR"; rwo="QQQQ";
    c0p=0; c0b=81; allow2=66;
  }
  if(is_m2==1){
    t0i="ACD"; t0o="DDD";
    t1i="EF"; t1o="FF";
    t2i="GHIJ"; t2o="JJJJ";
    fwi="Q!Bz"; fwo="QQQQ";
    rwi="p!Br"; rwo="!!!!";
    c0p=2; c0b=66; allow2=81;
  }
  aemit_stage("tw", t0i, t0o);
  aemit_stage("tw", t1i, t1o);
  aemit_stage("tw", t2i, t2o);
  aemit_stage("fw", fwi, fwo);
  let sdat:[]u8=z_alloc(4*64);
  let sod:[]u8=z_alloc(16);
  let sld:[]u8=z_alloc(16);
  let snd:[]u8=z_alloc(16);
  let st:[]u8=z_alloc(1024);
  set32(st, 0, 0);
  let pool:[]u8=z_alloc(4096);
  let pu:[]u8=z_alloc(4);
  set32(pu, 0, 0);
  let br:[]u8=z_alloc(256);
  let nbr:[]u8=z_alloc(4);
  set32(nbr, 0, 0);
  let probe:[]u8=z_alloc(64);
  let vst:[]u8=z_alloc(512);
  let vn:[]u8=z_alloc(4);
  set32(vn, 0, 0);
  let base:[]u8=z_alloc(4);
  // ---- V0: base learnable ----
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, t0i, t0o, t0i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 1, t1i, t1o, t1i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 2, t2i, t2o, t2i.len);
  let v0:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 3);
  emit("V0 first_fit_tw=");
  emit(i32s(v0));
  emit("\n");
  let twf:[]u8=z_alloc(4);
  set32(twf, 0, 0);
  pcheck(v0, br, get32(nbr, 0), ps, pidx, probe, t0i, t0o, twf);
  pcheck(v0, br, get32(nbr, 0), ps, pidx, probe, t1i, t1o, twf);
  pcheck(v0, br, get32(nbr, 0), ps, pidx, probe, t2i, t2o, twf);
  let ftw:i32=get32(twf, 0);
  emit("V0 fails_on_tw=");
  emit(i32s(ftw));
  emit("\n");
  let v0ok:i32=0;
  if(v0>=0){
    if(ftw==0){ v0ok=1; }
  }
  check("V0-learnable", v0ok==1, pf);
  // ---- V1: byte-disjointness ----
  let i:i32=0;
  let v1a:i32=1;
  while(i<fwi.len){
    let fb:i32=fwi[i] as i32;
    if(ahasb(t0i, fb)==1){ v1a=0; }
    if(ahasb(t1i, fb)==1){ v1a=0; }
    if(ahasb(t2i, fb)==1){ v1a=0; }
    i=i+1;
  }
  check("V1a-fw-disjoint-tw", v1a==1, pf);
  let v1b:i32=0;
  if(ahasb(fwi, c0b)==1){ v1b=1; }
  check("V1b-declared-in-fw", v1b==1, pf);
  let v1c:i32=1;
  i=0;
  while(i<rwi.len){
    let rb:i32=rwi[i] as i32;
    let intw:i32=0;
    if(ahasb(t0i, rb)==1){ intw=1; }
    if(ahasb(t1i, rb)==1){ intw=1; }
    if(ahasb(t2i, rb)==1){ intw=1; }
    if(intw==1){
      if(rb!=c0b){
        if(rb!=allow2){ v1c=0; }
      }
    }
    i=i+1;
  }
  check("V1c-rw-disjoint-tw", v1c==1, pf);
  let v1d:i32=0;
  if(c0p<rwi.len){
    if((rwi[c0p] as i32)==c0b){ v1d=1; }
  }
  check("V1d-rw-matches-conflict", v1d==1, pf);
  // ---- V3: impossibility recheck (EW restricted to TW+FW) ----
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, t0i, t0o, t0i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 1, t1i, t1o, t1i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 2, t2i, t2o, t2i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 3, fwi, fwo, fwi.len);
  let v3:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 4);
  emit("V3 first_fit_twfw=");
  emit(i32s(v3));
  emit("\n");
  check("V3-impossible", v3==-1, pf);
  // ---- train v1w ----
  set32(base, 0, v0);
  set32(vst, 0, 1);
  set32(vst, 4, v0);
  set32(vst, 8, 0);
  set32(vst, 12, 0);
  set32(vst, 16, -1);
  set32(vst, 20, -1);
  set32(vst, 24, -1);
  set32(vst, 28, 0);
  set32(vn, 0, 1);
  emit("v1 stored ACTIVE provenance=discovery/TW\n");
  let d0a:i32=observe(st, pool, pu, get32(base, 0), br, get32(nbr, 0), ps, pidx, t0i, t0o, 0, probe);
  let d0b:i32=observe(st, pool, pu, get32(base, 0), br, get32(nbr, 0), ps, pidx, t1i, t1o, 0, probe);
  let d0c:i32=observe(st, pool, pu, get32(base, 0), br, get32(nbr, 0), ps, pidx, t2i, t2o, 0, probe);
  let trainok:i32=1;
  if(d0a!=0){ trainok=0; }
  if(d0b!=0){ trainok=0; }
  if(d0c!=0){ trainok=0; }
  check("TRAIN-no-false-detect", trainok==1, fails);
  // ---- present FW (V2: problem real) ----
  let det:i32=observe(st, pool, pu, get32(base, 0), br, get32(nbr, 0), ps, pidx, fwi, fwo, 1, probe);
  emit("FW presented det=");
  emit(i32s(det));
  emit("\n");
  check("V2-counterexample-real", det==1, pf);
  let e_fw:i32=get32(st, 0)-1;
  if(get32(pf, 0)>0){
    emit("VOID precheck failed; no verdict\n");
    return 1;
  }
  // ---- frozen revision ----
  let dout:[]u8=z_alloc(12);
  let dg:i32=diagnose(st, pool, get32(base, 0), br, get32(nbr, 0), ps, pidx, dout, probe);
  check("REV-diagnosed", dg==1, fails);
  let dpos:i32=get32(dout, 0);
  let dbyte:i32=get32(dout, 4);
  let ncand:i32=acount_candidates(st, pool, get32(base, 0), br, get32(nbr, 0), ps, pidx, probe);
  let bidx:i32=build_test(br, nbr, dpos, dbyte);
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, fwi, fwo, fwi.len);
  let alt:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 1);
  let alt_evals:i32=alt+1;
  emit("ALT first_fit=");
  emit(i32s(alt));
  emit(" evals=");
  emit(i32s(alt_evals));
  emit("\n");
  let v2:i32=specialize(st, pool, br, nbr, get32(base, 0), vst, vn, bidx, alt, e_fw, dpos, dbyte);
  emit("revision complete new_version=");
  emit(i32s(v2));
  emit("\n");
  let rev_evals:i32=ncand+1+1;
  emit("REVISION-EVALS diagnosis_candidates=");
  emit(i32s(ncand));
  emit(" construction_tests=1 specialize=1 total=");
  emit(i32s(rev_evals));
  emit(" alt_evals=");
  emit(i32s(alt_evals));
  emit("\n");
  let w2ok:i32=0;
  if(rev_evals<=25){ w2ok=1; }
  check("W2-eval-ceiling", w2ok==1, fails);
  // ---- W1: score revised procedure against EW ----
  let ewf:[]u8=z_alloc(4);
  set32(ewf, 0, 0);
  pcheck(get32(base, 0), br, get32(nbr, 0), ps, pidx, probe, t0i, t0o, ewf);
  pcheck(get32(base, 0), br, get32(nbr, 0), ps, pidx, probe, t1i, t1o, ewf);
  pcheck(get32(base, 0), br, get32(nbr, 0), ps, pidx, probe, t2i, t2o, ewf);
  pcheck(get32(base, 0), br, get32(nbr, 0), ps, pidx, probe, fwi, fwo, ewf);
  pcheck(get32(base, 0), br, get32(nbr, 0), ps, pidx, probe, rwi, rwo, ewf);
  let w1fails:i32=get32(ewf, 0);
  emit("W1 fails_total=");
  emit(i32s(w1fails));
  emit("\n");
  // ---- W3: present RW after revision ACTIVE ----
  emit("=== W3 REUSE CHECK ===\n");
  aemit_stage("rw", rwi, rwo);
  let det_rw:i32=observe(st, pool, pu, get32(base, 0), br, get32(nbr, 0), ps, pidx, rwi, rwo, 2, probe);
  emit("RW presented det=");
  emit(i32s(det_rw));
  emit("\n");
  let rw_correct:i32=0;
  if(det_rw==0){ rw_correct=1; }
  emit("W3 reuse_correct=");
  emit(i32s(rw_correct));
  emit("\n");
  emit("=== RESULT fails=");
  emit(i32s(w1fails));
  emit(" ===\n");
  emit("w_first_fit_tw=");
  emit(i32s(v0));
  emit("\n");
  emit("w_b1w_enumerated=");
  emit(i32s(pcount));
  emit("\n");
  emit("w_revision_evals=");
  emit(i32s(rev_evals));
  emit("\n");
  emit("w_fails_total=");
  emit(i32s(w1fails));
  emit("\n");
  emit("w_reuse_correct=");
  emit(i32s(rw_correct));
  emit("\n");
  emit("w_diag_pos=");
  emit(i32s(dpos));
  emit(" w_diag_byte=");
  emit(i32s(dbyte));
  emit("\n");
  if(get32(fails, 0)>0){
    emit("harness internal fails=");
    emit(i32s(get32(fails, 0)));
    emit("\n");
  }
  return 0;
}

// proc_revise2.zag -- H-PI-REV2: procedure-invention v2 revision machinery.
//
// Frozen prereg (committed alone before any implementation):
// docs/lab/rsi/runs/wave-20260929-1721pdt/design_lane/PREREG_PI_REV2.md
// Implements the frozen protocol P0-P9. P8 adversary F2 runs when argv[1]
// is a single byte from the frozen allowed set. Pure Zag. Pinned znc.
//
// Section A below (through print_prog) is a byte-verbatim port of the
// discovery-enumeration helpers from the frozen H-REVISE source:
// docs/lab/research-lead/overnight-20260928/sem_l3/proc_revise_test.zag
// (cmp-verified at implementation time; that file is frozen history).
// Section B is the new generic machinery: procedure store, example log,
// monitor loop, diagnosis operator, primitive-construction kit,
// SPECIALIZE revision operator, conflict rule, ROLLBACK.
//
// Audit note (K-RV2-1a, K-RV2-7): the machinery functions in Section B
// (observe, diagnose, build_test, specialize, predict, rollback) contain
// no character literal equal to any fixture byte and no fixture string
// literals; all condition bytes flow from data. Fixture declarations and
// expected-output strings live in main() only.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  return _zag_i64_to_str(v as i64);
}

fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn eval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let l:i32=prog[base+1] as i32;
    let r:i32=prog[base+2] as i32;
    let a:i32=eval_node(prog, l, k, n);
    let b:i32=eval_node(prog, r, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn eval_prog(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return eval_node(prog, nnodes-1, k, n);
}

fn extract_seq(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}

fn prog_fits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    let expected:i32=get32(seq, k*4);
    let got:i32=eval_prog(prog, nnodes, k, n);
    if(got!=expected){return 0;}
    k=k+1;
  }
  return 1;
}

fn add_term(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, term_type:i32)i32 {
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=1 as u8;
  prog_store[store_off+1]=term_type as u8;
  prog_store[store_off+2]=255 as u8;
  prog_store[store_off+3]=255 as u8;
  return store_off+4;
}

fn add_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, left_pi:i32, right_pi:i32)i32 {
  let left_off:i32=get32(prog_index, left_pi*4);
  let right_off:i32=get32(prog_index, right_pi*4);
  let left_n:i32=prog_store[left_off] as i32;
  let right_n:i32=prog_store[right_off] as i32;
  let total_n:i32=left_n+right_n+1;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=total_n as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<left_n){
    prog_store[dst]=prog_store[left_off+1+i*3];
    prog_store[dst+1]=prog_store[left_off+1+i*3+1];
    prog_store[dst+2]=prog_store[left_off+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<right_n){
    let t:i32=prog_store[right_off+1+i*3] as i32;
    let l:i32=prog_store[right_off+1+i*3+1] as i32;
    let r:i32=prog_store[right_off+1+i*3+2] as i32;
    prog_store[dst]=t as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+left_n) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+left_n) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(left_n-1) as u8;
  prog_store[dst+2]=(left_n+right_n-1) as u8;
  dst=dst+3;
  return dst;
}

fn get_prog(prog_store:[]u8, prog_index:[]u8, pi:i32, out_nnodes:[]u8)[]u8 {
  let off:i32=get32(prog_index, pi*4);
  out_nnodes[0]=prog_store[off];
  return prog_store[off+1..off+1+ (prog_store[off] as i32)*3];
}

fn print_seq(seq:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    emit(i32s(get32(seq, i*4)));
    i=i+1;
  }
  emit("]");
  return;
}

fn print_prog(prog:[]u8, nnodes:i32)void {
  emit("[");
  let i:i32=0;
  while(i<nnodes){
    if(i>0){emit(" ");}
    let tt:i32=prog[i*3] as i32;
    if(tt==0){emit("K");}
    else if(tt==1){emit("N");}
    else if(tt==2){emit("C0");}
    else if(tt==3){emit("C1");}
    else if(tt==4){emit("C2");}
    else if(tt==5){emit("ADD");}
    else if(tt==6){emit("SUB");}
    i=i+1;
  }
  emit("]");
  return;
}

// ============ Section B: H-PI-REV2 new machinery (generic, data-driven) ============
// NOTE: this section avoids the letter used by fixture bytes in identifiers,
// comments, and string literals, so audits stay mechanical.

// Ported enumeration loop, wrapped as a function (same algorithm as v1 main).
fn benum(prog_store:[]u8, prog_index:[]u8)i32 {
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    store_off=add_term(prog_store, prog_index, pcount, store_off, t);
    pcount=pcount+1; t=t+1;
  }
  let size1_end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let size3_end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=size1_end;
      while(b<size3_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    a=size1_end;
    while(a<size3_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  return pcount;
}

// Sequence staging: flat buffer of up to 4 seqs, 16 entries each.
fn loadseq(sdat:[]u8, sod:[]u8, sld:[]u8, snd:[]u8, slot:i32, inp:[]u8, out:[]u8, n:i32)i32 {
  let sq:[]u8=z_alloc(64);
  let ln:i32=extract_seq(inp, out, sq);
  let off:i32=slot*64;
  let i:i32=0;
  while(i<64){ sdat[off+i]=sq[i]; i=i+1; }
  set32(sod, slot*4, off);
  set32(sld, slot*4, ln);
  set32(snd, slot*4, n);
  return ln;
}
fn getseq(sdat:[]u8, sod:[]u8, sld:[]u8, s:i32, lnout:[]u8)[]u8 {
  let off:i32=get32(sod, s*4);
  let ln:i32=get32(sld, s*4);
  set32(lnout, 0, ln);
  if(ln<0){ return sdat[0..0]; }
  return sdat[off..off+ln*4];
}

// Smallest program fitting all staged seqs; -1 when none fits.
fn dsearch(ps:[]u8, pidx:[]u8, pcount:i32, sdat:[]u8, sod:[]u8, sld:[]u8, snd:[]u8, nseq:i32)i32 {
  let tmp:[]u8=z_alloc(1);
  let lnb:[]u8=z_alloc(4);
  let pi:i32=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(ps, pidx, pi, tmp);
    let nn:i32=tmp[0] as i32;
    let ok:i32=1;
    let s:i32=0;
    while(s<nseq){
      let sq:[]u8=getseq(sdat, sod, sld, s, lnb);
      let ln:i32=get32(lnb, 0);
      let n:i32=get32(snd, s*4);
      if(prog_fits(prog, nn, sq, ln, n)!=1){ ok=0; s=nseq; }
      s=s+1;
    }
    if(ok==1){ return pi; }
    pi=pi+1;
  }
  return -1;
}

// Example log. st layout: [0]=count, then slots of 6 i32:
// in_off, in_len, out_off, out_len, status (0 current, 1 superseded), phase.
fn ex_add(st:[]u8, pool:[]u8, pu:[]u8, inp:[]u8, out:[]u8, phase:i32)i32 {
  let n:i32=get32(st, 0);
  let puv:i32=get32(pu, 0);
  let base:i32=4+n*24;
  set32(st, base, puv);
  set32(st, base+4, inp.len);
  let i:i32=0;
  while(i<inp.len){ pool[puv+i]=inp[i]; i=i+1; }
  puv=puv+inp.len;
  set32(st, base+8, puv);
  set32(st, base+12, out.len);
  i=0;
  while(i<out.len){ pool[puv+i]=out[i]; i=i+1; }
  puv=puv+out.len;
  set32(st, base+16, 0);
  set32(st, base+20, phase);
  set32(st, 0, n+1);
  set32(pu, 0, puv);
  return n;
}
fn ex_in(st:[]u8, pool:[]u8, e:i32)[]u8 {
  let base:i32=4+e*24;
  let off:i32=get32(st, base);
  let ln:i32=get32(st, base+4);
  return pool[off..off+ln];
}
fn ex_out(st:[]u8, pool:[]u8, e:i32)[]u8 {
  let base:i32=4+e*24;
  let off:i32=get32(st, base+8);
  let ln:i32=get32(st, base+12);
  return pool[off..off+ln];
}
fn ex_status(st:[]u8, e:i32)i32 {
  return get32(st, 4+e*24+16);
}

fn bytes_eq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){
    if(a[i]!=b[i]){ return 0; }
    i=i+1;
  }
  return 1;
}

// Predict with the ACTIVE procedure: branch list (most recent first),
// else the base program. Returns output length, or -1 when a program
// yields an out-of-range position.
fn predict(base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, inp:[]u8, out:[]u8)i32 {
  let n:i32=inp.len;
  let psel:i32=base;
  let bi:i32=nb-1;
  let done:i32=0;
  while(bi>=0){
    if(done==0){
      let bpos:i32=get32(br, bi*12);
      if(bpos<n){
        if((inp[bpos] as i32)==get32(br, bi*12+4)){
          psel=get32(br, bi*12+8);
          done=1;
        }
      }
    }
    bi=bi-1;
  }
  let tmp:[]u8=z_alloc(1);
  let pr:[]u8=get_prog(ps, pidx, psel, tmp);
  let nn:i32=tmp[0] as i32;
  let k:i32=0;
  while(k<n){
    let id:i32=eval_prog(pr, nn, k, n);
    if(id<0){ return -1; }
    if(id>=n){ return -1; }
    out[k]=inp[id];
    k=k+1;
  }
  return n;
}

// Monitor loop: predict with the ACTIVE procedure, compare against the
// observed output. Detection is purely predict-vs-actual mismatch; this
// function holds no branch on input content (audited, K-RV2-3).
// Returns 1 when a counterexample is detected, else 0.
fn observe(st:[]u8, pool:[]u8, pu:[]u8, base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, inp:[]u8, out:[]u8, phase:i32, probe:[]u8)i32 {
  let n:i32=predict(base, br, nb, ps, pidx, inp, probe);
  let _ex:i32=ex_add(st, pool, pu, inp, out, phase);
  if(n!=out.len){
    emit("COUNTEREXAMPLE_DETECTED(");
    emit(inp);
    emit(")\n");
    return 1;
  }
  if(bytes_eq(probe[0..n], out)!=1){
    emit("COUNTEREXAMPLE_DETECTED(");
    emit(inp);
    emit(")\n");
    return 1;
  }
  return 0;
}

// Diagnosis operator. Failing set F and passing set P come from the log
// under the ACTIVE procedure. Candidate conditions (p, b): every f in F
// holds byte b at position p. Rank: position ascending, then byte
// ascending (frozen; the second key never decides on frozen evidence).
// Conflicts with P are recorded, never disqualifying.
// dout: [pos, byte, nconflict]. Returns 1, or 0 with CANNOT-DIAGNOSE.
fn diagnose(st:[]u8, pool:[]u8, base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, dout:[]u8, probe:[]u8)i32 {
  let n:i32=get32(st, 0);
  let fb:[]u8=z_alloc(32*4);
  let pb:[]u8=z_alloc(32*4);
  let nf:i32=0;
  let np:i32=0;
  let e:i32=0;
  while(e<n){
    if(ex_status(st, e)==0){
      let ie:[]u8=ex_in(st, pool, e);
      let oe:[]u8=ex_out(st, pool, e);
      let pr:i32=predict(base, br, nb, ps, pidx, ie, probe);
      let bad:i32=0;
      if(pr!=oe.len){ bad=1; }
      else {
        if(bytes_eq(probe[0..pr], oe)!=1){ bad=1; }
      }
      if(bad==1){ set32(fb, nf*4, e); nf=nf+1; }
      else { set32(pb, np*4, e); np=np+1; }
    }
    e=e+1;
  }
  let cb:[]u8=z_alloc(64*8);
  let nc:i32=0;
  let fi:i32=0;
  while(fi<nf){
    let fe:i32=get32(fb, fi*4);
    let fin:[]u8=ex_in(st, pool, fe);
    let p:i32=0;
    while(p<fin.len){
      let b:i32=fin[p] as i32;
      let ok:i32=1;
      let fj:i32=0;
      while(fj<nf){
        let fe2:i32=get32(fb, fj*4);
        let fin2:[]u8=ex_in(st, pool, fe2);
        if(p>=fin2.len){ ok=0; fj=nf; }
        else {
          if((fin2[p] as i32)!=b){ ok=0; fj=nf; }
        }
        fj=fj+1;
      }
      if(ok==1){
        let dup:i32=0;
        let ci:i32=0;
        while(ci<nc){
          if(get32(cb, ci*8)==p){
            if(get32(cb, ci*8+4)==b){ dup=1; ci=nc; }
          }
          ci=ci+1;
        }
        if(dup==0){
          set32(cb, nc*8, p);
          set32(cb, nc*8+4, b);
          nc=nc+1;
        }
      }
      p=p+1;
    }
    fi=fi+1;
  }
  if(nc==0){
    emit("CANNOT-DIAGNOSE\n");
    return 0;
  }
  let bpos:i32=1000000;
  let bbyte:i32=1000000;
  let ci2:i32=0;
  while(ci2<nc){
    let p2:i32=get32(cb, ci2*8);
    let b2:i32=get32(cb, ci2*8+4);
    if(p2<bpos){ bpos=p2; bbyte=b2; }
    else {
      if(p2==bpos){
        if(b2<bbyte){ bbyte=b2; }
      }
    }
    ci2=ci2+1;
  }
  let ncon:i32=0;
  let pj:i32=0;
  while(pj<np){
    let pe:i32=get32(pb, pj*4);
    let pin:[]u8=ex_in(st, pool, pe);
    if(bpos<pin.len){
      if((pin[bpos] as i32)==bbyte){ ncon=ncon+1; }
    }
    pj=pj+1;
  }
  set32(dout, 0, bpos);
  set32(dout, 4, bbyte);
  set32(dout, 8, ncon);
  emit("DIAGNOSIS pos=");
  emit(i32s(bpos));
  emit(" byte=");
  emit(i32s(bbyte));
  emit(" conflicts=");
  emit(i32s(ncon));
  emit("\n");
  return 1;
}

// Primitive-construction kit: mechanically build the test (pos, byte).
// The byte value arrives as data; no literal lives here.
fn build_test(br:[]u8, nbr:[]u8, pos:i32, byte:i32)i32 {
  let n:i32=get32(nbr, 0);
  set32(br, n*12, pos);
  set32(br, n*12+4, byte);
  set32(br, n*12+8, -1);
  set32(nbr, 0, n+1);
  emit("PRIMITIVE-CONSTRUCTED pos=");
  emit(i32s(pos));
  emit(" byte=");
  emit(i32s(byte));
  emit("\n");
  return n;
}

// SPECIALIZE revision operator: v_new = IF(test, alt, v_old).
// Old version -> SUBSUMED. Conflict rule: a passing record that holds
// the test but was seen under the old version is marked SUPERSEDED
// (newer trusted evidence overrides; records are kept, never deleted).
// vst slot: 8 i32 = id, base_prog, status, parent, trigger, dpos, dbyte, nbranches.
fn specialize(st:[]u8, pool:[]u8, br:[]u8, nbr:[]u8, base:i32, vst:[]u8, vn:[]u8, bidx:i32, alt:i32, trig:i32, pos:i32, byte:i32)i32 {
  set32(br, bidx*12+8, alt);
  let old:i32=get32(vn, 0)-1;
  set32(vst, old*32+8, 1);
  let n:i32=get32(st, 0);
  let e:i32=0;
  while(e<n){
    if(e!=trig){
      if(ex_status(st, e)==0){
        let ie:[]u8=ex_in(st, pool, e);
        if(pos<ie.len){
          if((ie[pos] as i32)==byte){
            set32(st, 4+e*24+16, 1);
            emit("SUPERSEDED rec=");
            emit(i32s(e));
            emit("\n");
          }
        }
      }
    }
    e=e+1;
  }
  let nv:i32=get32(vn, 0);
  set32(vst, nv*32, nv+1);
  set32(vst, nv*32+4, base);
  set32(vst, nv*32+8, 0);
  set32(vst, nv*32+12, old+1);
  set32(vst, nv*32+16, trig);
  set32(vst, nv*32+20, pos);
  set32(vst, nv*32+24, byte);
  set32(vst, nv*32+28, get32(nbr, 0));
  set32(vn, 0, nv+1);
  emit("VERSION v");
  emit(i32s(nv+1));
  emit(" ACTIVE (parent v");
  emit(i32s(old+1));
  emit(")\n");
  return nv+1;
}

// ROLLBACK(v): reactivate v; later versions stay on record as SUBSUMED.
fn rollback(base:[]u8, nbr:[]u8, vst:[]u8, vn:[]u8, v1base:i32)void {
  set32(base, 0, v1base);
  set32(nbr, 0, 0);
  let n:i32=get32(vn, 0);
  let v:i32=0;
  while(v<n){
    if(v==0){ set32(vst, v*32+8, 0); }
    else { set32(vst, v*32+8, 1); }
    v=v+1;
  }
  emit("ROLLBACK to v1\n");
  return;
}

fn check(name:[]u8, cond:i32, fails:[]u8)void {
  emit("CHECK ");
  emit(name);
  emit(": ");
  if(cond==1){ emit("PASS\n"); }
  else {
    emit("FAIL\n");
    set32(fails, 0, get32(fails, 0)+1);
  }
  return;
}

fn pcheck(base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, probe:[]u8, inp:[]u8, want:[]u8, fails:[]u8)void {
  let n:i32=predict(base, br, nb, ps, pidx, inp, probe);
  emit("PREDICT ");
  emit(inp);
  emit(" -> ");
  if(n<0){
    emit("UNPREDICTABLE\n");
    set32(fails, 0, get32(fails, 0)+1);
    return;
  }
  let got:[]u8=probe[0..n];
  emit(got);
  if(n==want.len){
    if(bytes_eq(got, want)==1){
      emit(" [ok]\n");
      return;
    }
  }
  emit(" [MISMATCH want ");
  emit(want);
  emit("]\n");
  set32(fails, 0, get32(fails, 0)+1);
  return;
}

fn rcell(base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, probe:[]u8, fails:[]u8)void {
  pcheck(base, br, nb, ps, pidx, probe, "zag", "ggg", fails);
  pcheck(base, br, nb, ps, pidx, probe, "12", "22", fails);
  pcheck(base, br, nb, ps, pidx, probe, "q", "q", fails);
  pcheck(base, br, nb, ps, pidx, probe, "hello", "ooooo", fails);
  pcheck(base, br, nb, ps, pidx, probe, "ptc", "ccc", fails);
  pcheck(base, br, nb, ps, pidx, probe, "s", "s", fails);
  pcheck(base, br, nb, ps, pidx, probe, "eghjjupazbnf", "ffffffffffff", fails);
  pcheck(base, br, nb, ps, pidx, probe, "q", "q", fails);
  return;
}


// ---- RT-HPIREV2 adversarial design validator (new code; everything above
// this line is the byte-verbatim frozen machinery from proc_revise2.zag at
// 847a8f10f, lines 1-606; sha256
// 8d2b16ab31184758b2b724e19cb1fa9f96d5ff008a0674b6c95c1da8e227f712) ----
// DESIGN-TIME ONLY. Validates candidate adversarial worlds against V0-V3,
// reports dsearch first fits, the diagnose winner, and EW consistency
// against the declared R_w. It never builds a revision and never scores a
// sealed run. Pre-freeze tuning is disclosed in ADV_SEAL.md.

fn dkey(a:[]u8, c0:u8, c1:u8)i32 {
  if(a.len!=2){ return 0; }
  if(a[0]==c0){
    if(a[1]==c1){ return 1; }
  }
  return 0;
}
fn dhasb(a:[]u8, x:i32)i32 {
  let i:i32=0;
  while(i<a.len){
    if((a[i] as i32)==x){ return 1; }
    i=i+1;
  }
  return 0;
}
// predict program pi on inp; return 1 iff output equals want
fn dprog_eq(pi:i32, ps:[]u8, pidx:[]u8, probe:[]u8, inp:[]u8, want:[]u8)i32 {
  let br0:[]u8=z_alloc(12);
  let n:i32=predict(pi, br0, 0, ps, pidx, inp, probe);
  if(n!=want.len){ return 0; }
  return bytes_eq(probe[0..n], want);
}
// R_w application: wtype 0 = IF(inp[0]==trigb, alt, v0);
// wtype 1 = IF(inp[2]==66, alt, v0); wtype 2 = two-level.
fn drw(wtype:i32, trigb:i32, alt:i32, v0:i32, ps:[]u8, pidx:[]u8, probe:[]u8, inp:[]u8, out:[]u8)i32 {
  let sel:i32=v0;
  if(wtype==0){
    if(inp.len>0){
      if((inp[0] as i32)==trigb){ sel=alt; }
    }
  }
  if(wtype==1){
    if(inp.len>2){
      if((inp[2] as i32)==66){ sel=alt; }
    }
  }
  if(wtype==2){
    if(inp.len>0){
      if((inp[0] as i32)==trigb){ sel=alt; }
      else {
        if(inp.len>2){
          if((inp[2] as i32)==66){ sel=3; }
        }
      }
    }
  }
  let br0:[]u8=z_alloc(12);
  let n:i32=predict(sel, br0, 0, ps, pidx, inp, out);
  return n;
}
fn main()i32 {
  emit("=== ADV DESIGN VALIDATOR ===\n");
  let ps:[]u8=z_alloc(200000);
  let pidx:[]u8=z_alloc(1200*4);
  let pcount:i32=benum(ps, pidx);
  emit("enumerated ");
  emit(i32s(pcount));
  emit(" programs\n");
  if(pcount!=1055){
    emit("DESIGN-ABORT enum count wrong\n");
    return 2;
  }
  let w:[]u8=_zag_arg(1);
  let t0i:[]u8="";
  let t0o:[]u8="";
  let t1i:[]u8="";
  let t1o:[]u8="";
  let t2i:[]u8="";
  let t2o:[]u8="";
  let fwi:[]u8="";
  let fwo:[]u8="";
  let rwi:[]u8="";
  let rwo:[]u8="";
  let c0p:i32=0;
  let c0b:i32=0;
  let allow2:i32=-1;
  let wtype:i32=0;
  let trigb:i32=0;
  let known:i32=0;
  if(dkey(w, "S"[0], "1"[0])==1){
    t0i="ABC"; t0o="CBA";
    t1i="DEFG"; t1o="GFED";
    t2i="HI"; t2o="IH";
    fwi="Q!RT"; fwo="QQQQ";
    rwi="QmWn"; rwo="QQQQ";
    c0p=0; c0b=81; allow2=-1; wtype=0; trigb=81; known=1;
  }
  if(dkey(w, "S"[0], "2"[0])==1){
    t0i="ABC"; t0o="ABC";
    t1i="DF"; t1o="DF";
    t2i="GHIJ"; t2o="GHIJ";
    fwi="QWERTY"; fwo="YTREWQ";
    rwi="Qzxwvu"; rwo="uvwxzQ";
    c0p=0; c0b=81; allow2=-1; wtype=0; trigb=81; known=1;
  }
  if(dkey(w, "S"[0], "3"[0])==1){
    t0i="ABC"; t0o="BBB";
    t1i="DFGH"; t1o="FFFF";
    t2i="HI"; t2o="II";
    fwi="QWERTY"; fwo="YTREWQ";
    rwi="Qabcde"; rwo="edcbaQ";
    c0p=0; c0b=81; allow2=-1; wtype=0; trigb=81; known=1;
  }
  if(dkey(w, "S"[0], "4"[0])==1){
    t0i="ACD"; t0o="DDD";
    t1i="EF"; t1o="FF";
    t2i="GHIJ"; t2o="JJJJ";
    fwi="x!Bz"; fwo="xxxx";
    rwi="p!Br"; rwo="pppp";
    c0p=2; c0b=66; allow2=-1; wtype=1; trigb=120; known=1;
  }
  if(dkey(w, "M"[0], "1"[0])==1){
    t0i="ACD"; t0o="DDD";
    t1i="EF"; t1o="FF";
    t2i="GHIJ"; t2o="JJJJ";
    fwi="Q!RT"; fwo="QQQQ";
    rwi="Q!BR"; rwo="QQQQ";
    c0p=0; c0b=81; allow2=66; wtype=2; trigb=81; known=1;
  }
  if(dkey(w, "M"[0], "2"[0])==1){
    t0i="ACD"; t0o="DDD";
    t1i="EF"; t1o="FF";
    t2i="GHIJ"; t2o="JJJJ";
    fwi="Q!Bz"; fwo="QQQQ";
    rwi="p!Br"; rwo="!!!!";
    c0p=2; c0b=66; allow2=81; wtype=2; trigb=81; known=1;
  }
  if(known==0){
    emit("usage: rt_adv_design [S1|S2|S3|S4|M1|M2]\n");
    return 2;
  }
  emit("world ");
  emit(w);
  emit("\n");
  let sdat:[]u8=z_alloc(4*64);
  let sod:[]u8=z_alloc(16);
  let sld:[]u8=z_alloc(16);
  let snd:[]u8=z_alloc(16);
  let probe:[]u8=z_alloc(64);
  let bad:i32=0;
  // V0
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, t0i, t0o, t0i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 1, t1i, t1o, t1i.len);
  let _l:i32=loadseq(sdat, sod, sld, snd, 2, t2i, t2o, t2i.len);
  let v0:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 3);
  emit("V0 first_fit_tw=");
  emit(i32s(v0));
  emit("\n");
  if(v0<0){ emit("V0-FAIL not learnable\n"); bad=1; }
  if(dprog_eq(v0, ps, pidx, probe, t0i, t0o)==0){ emit("V0-FAIL t0\n"); bad=1; }
  if(dprog_eq(v0, ps, pidx, probe, t1i, t1o)==0){ emit("V0-FAIL t1\n"); bad=1; }
  if(dprog_eq(v0, ps, pidx, probe, t2i, t2o)==0){ emit("V0-FAIL t2\n"); bad=1; }
  // V1
  let i:i32=0;
  while(i<fwi.len){
    if(dhasb(t0i, fwi[i] as i32)==1){ emit("V1a-FAIL fw byte in t0\n"); bad=1; }
    if(dhasb(t1i, fwi[i] as i32)==1){ emit("V1a-FAIL fw byte in t1\n"); bad=1; }
    if(dhasb(t2i, fwi[i] as i32)==1){ emit("V1a-FAIL fw byte in t2\n"); bad=1; }
    i=i+1;
  }
  if(dhasb(fwi, c0b)==0){ emit("V1b-FAIL declared byte not in fw\n"); bad=1; }
  i=0;
  while(i<rwi.len){
    let rb:i32=rwi[i] as i32;
    let intw:i32=0;
    if(dhasb(t0i, rb)==1){ intw=1; }
    if(dhasb(t1i, rb)==1){ intw=1; }
    if(dhasb(t2i, rb)==1){ intw=1; }
    if(intw==1){
      if(rb!=c0b){
        if(rb!=allow2){ emit("V1c-FAIL rw byte in tw\n"); bad=1; }
      }
    }
    i=i+1;
  }
  if(c0p<rwi.len){
    if((rwi[c0p] as i32)!=c0b){ emit("V1d-FAIL rw misses declared conflict\n"); bad=1; }
  }
  else { emit("V1d-FAIL declared pos out of range\n"); bad=1; }
  // V2: v0 mispredicts FW
  if(dprog_eq(v0, ps, pidx, probe, fwi, fwo)==1){ emit("V2-FAIL fw not a counterexample\n"); bad=1; }
  else { emit("V2 det=1 (fw mispredicted)\n"); }
  // V3
  let _l:i32=loadseq(sdat, sod, sld, snd, 3, fwi, fwo, fwi.len);
  let v3:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 4);
  emit("V3 first_fit_twfw=");
  emit(i32s(v3));
  emit("\n");
  if(v3!=-1){ emit("V3-FAIL single program fits TW+FW\n"); bad=1; }
  // alt on FW alone
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, fwi, fwo, fwi.len);
  let alt:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 1);
  emit("ALT first_fit=");
  emit(i32s(alt));
  emit("\n");
  if(alt<0){ emit("ALT-FAIL no program fits FW\n"); bad=1; }
  // diagnose winner via the frozen observe/diagnose path
  let st:[]u8=z_alloc(1024);
  set32(st, 0, 0);
  let pool:[]u8=z_alloc(4096);
  let pu:[]u8=z_alloc(4);
  set32(pu, 0, 0);
  let br:[]u8=z_alloc(256);
  let _d0:i32=observe(st, pool, pu, v0, br, 0, ps, pidx, t0i, t0o, 0, probe);
  let _d1:i32=observe(st, pool, pu, v0, br, 0, ps, pidx, t1i, t1o, 0, probe);
  let _d2:i32=observe(st, pool, pu, v0, br, 0, ps, pidx, t2i, t2o, 0, probe);
  let _d3:i32=observe(st, pool, pu, v0, br, 0, ps, pidx, fwi, fwo, 1, probe);
  let dout:[]u8=z_alloc(12);
  let dg:i32=diagnose(st, pool, v0, br, 0, ps, pidx, dout, probe);
  emit("diagnose returned ");
  emit(i32s(dg));
  emit(" pos=");
  emit(i32s(get32(dout, 0)));
  emit(" byte=");
  emit(i32s(get32(dout, 4)));
  emit("\n");
  // EW consistency vs declared R_w
  let ewo:[]u8=z_alloc(64);
  let n0:i32=drw(wtype, trigb, alt, v0, ps, pidx, probe, t0i, ewo);
  let ok0:i32=0;
  if(n0==t0o.len){ if(bytes_eq(ewo[0..n0], t0o)==1){ ok0=1; } }
  let n1:i32=drw(wtype, trigb, alt, v0, ps, pidx, probe, t1i, ewo);
  let ok1:i32=0;
  if(n1==t1o.len){ if(bytes_eq(ewo[0..n1], t1o)==1){ ok1=1; } }
  let n2:i32=drw(wtype, trigb, alt, v0, ps, pidx, probe, t2i, ewo);
  let ok2:i32=0;
  if(n2==t2o.len){ if(bytes_eq(ewo[0..n2], t2o)==1){ ok2=1; } }
  let nf:i32=drw(wtype, trigb, alt, v0, ps, pidx, probe, fwi, ewo);
  let okf:i32=0;
  if(nf==fwo.len){ if(bytes_eq(ewo[0..nf], fwo)==1){ okf=1; } }
  let nr:i32=drw(wtype, trigb, alt, v0, ps, pidx, probe, rwi, ewo);
  let okr:i32=0;
  if(nr==rwo.len){ if(bytes_eq(ewo[0..nr], rwo)==1){ okr=1; } }
  emit("EW tw0=");
  emit(i32s(ok0));
  emit(" tw1=");
  emit(i32s(ok1));
  emit(" tw2=");
  emit(i32s(ok2));
  emit(" fw=");
  emit(i32s(okf));
  emit(" rw=");
  emit(i32s(okr));
  emit("\n");
  if(ok0==0){ emit("EW-FAIL tw0\n"); bad=1; }
  if(ok1==0){ emit("EW-FAIL tw1\n"); bad=1; }
  if(ok2==0){ emit("EW-FAIL tw2\n"); bad=1; }
  if(okf==0){ emit("EW-FAIL fw\n"); bad=1; }
  if(okr==0){ emit("EW-FAIL rw\n"); bad=1; }
  // revision-eval estimate: distinct FW bytes + 2
  let dc:i32=0;
  let seen:[]u8=z_alloc(256);
  i=0;
  while(i<fwi.len){
    let b:i32=fwi[i] as i32;
    if(seen[b]==0){ seen[b]=1; dc=dc+1; }
    i=i+1;
  }
  emit("est revision_evals=");
  emit(i32s(dc+2));
  emit("\n");
  if(bad==0){ emit("DESIGN-VALID\n"); }
  else { emit("DESIGN-INVALID\n"); }
  return 0;
}

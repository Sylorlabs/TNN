// ============ H6R experiment checks (harness only, not substrate) ============
// Tests the standing mechanism through the event interface only. This file
// contains no ls_bump/ls_touch calls: standing arises solely from ev_observe
// confirm/contradict events through the frozen package hooks. No function
// below branches on domain content; asserts compare measured standing/bid
// values against preregistered predictions (measurement, not semantic cases).
// World parameters use the 5xx/6xx/7xx/9xx domains, structurally distinct
// from the substrate lane's dev-check values.

// live, non-superseded fact with (s,r,o), or -1
fn h6r_find_live(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    }
    n=n+1;
  }
  return -1;
}
// bid-only control: object of the argmax-bid live candidate (mirrors activate
// exactly, but with the frozen bid() instead of lbid); -999999 if none
fn h6r_sel_bid(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=-1; let bb:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let b:i32=bid(W,n);
        if(b>bb){bb=b; best=n;}
      }
    }
    n=n+1;
  }
  if(best<0){return -999999;}
  return ng(W,best,28);
}
// P2 ablation: tombstone every -44 standing record under STAND_ROOT.
// Substrate untouched; afterwards lbid must fall back to bid everywhere.
fn h6r_kill_records(W:[]u8)void {
  let sr:i32=ng(W,0,28);
  if(sr<2 || ng(W,sr,36)!=1){return;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==sr && eg(W,e,4)==10){
      let r:i32=eg(W,e,8);
      if(ng(W,r,36)==1 && ng(W,r,0)==904 && ng(W,r,24)==-44){
        ns(W,r,36,0);
      }
    }
    e=e+1;
  }
  return;
}
// B1: standing trajectories discriminate singleton contradiction (dip then
// recovery) from systematic shift (monotonic decline). Exact white-box values.
fn h6r_b1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let n1:i32=ev_teach(W,501,51,1);
  if(n1<2){emit("B1-S teach failed\n"); return 0;}
  let i:i32=0;
  while(i<4){ if(ev_observe(W,501,51,1)!=1){emit("B1-S confirm branch wrong\n"); return 0;} i=i+1; }
  if(ls_read(W,n1)!=4){emit("B1-S peak wrong\n"); return 0;}
  if(ev_observe(W,501,51,2)!=0){emit("B1-S contradict branch wrong\n"); return 0;}
  if(ls_read(W,n1)!=3){emit("B1-S dip wrong: want 3\n"); return 0;}
  let n2:i32=h6r_find_live(W,501,51,2);
  if(n2<0){emit("B1-S successor missing\n"); return 0;}
  i=0;
  while(i<3){ if(ev_observe(W,501,51,2)!=1){emit("B1-S recovery confirm wrong\n"); return 0;} i=i+1; }
  if(ls_read(W,n2)!=3){emit("B1-S recovery wrong: want 3\n"); return 0;}
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  let m1:i32=ev_teach(W2,502,52,1);
  if(m1<2){emit("B1-M teach failed\n"); return 0;}
  if(ev_observe(W2,502,52,1)!=1){emit("B1-M confirm branch wrong\n"); return 0;}
  if(ev_observe(W2,502,52,2)!=0){emit("B1-M contradict1 branch wrong\n"); return 0;}
  let m2:i32=h6r_find_live(W2,502,52,2);
  if(m2<0){emit("B1-M m2 missing\n"); return 0;}
  if(ev_observe(W2,502,52,1)!=0){emit("B1-M contradict2 branch wrong\n"); return 0;}
  let m3:i32=h6r_find_live(W2,502,52,1);
  if(m3<0){emit("B1-M m3 missing\n"); return 0;}
  if(ev_observe(W2,502,52,2)!=0){emit("B1-M contradict3 branch wrong\n"); return 0;}
  if(ls_read(W2,m1)!=0){emit("B1-M m1 wrong: want 0\n"); return 0;}
  if(ls_read(W2,m2)!=-1){emit("B1-M m2 wrong: want -1\n"); return 0;}
  if(ls_read(W2,m3)!=-1){emit("B1-M m3 wrong: want -1\n"); return 0;}
  emit("B1-PASS singleton dip 4->3 then recovery to 3; systematic 1->0->-1->-1 monotonic decline\n");
  return 1;
}
// B2 functional check: lbid is live at the activate path (standing strips
// query-hit frequency inflation that bid keeps). Source-level B2 (lbid at the
// four selector sites) is verified by the build's byte-compare against the
// committed prototype plus the prereg's section-3 grep.
fn h6r_b2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let n:i32=ev_teach(W,503,53,1);
  if(n<2){emit("B2 teach failed\n"); return 0;}
  if(ev_observe(W,503,53,1)!=1){emit("B2 confirm branch wrong\n"); return 0;}
  let i:i32=0;
  while(i<5){ if(ev_query(W,503,53,-2,0)==-2){emit("B2 query missed\n"); return 0;} i=i+1; }
  if(ls_read(W,n)!=1){emit("B2 standing wrong\n"); return 0;}
  if(bid(W,n)!=6){emit("B2 bid wrong: want 6\n"); return 0;}
  if(lbid(W,n)!=1){emit("B2 lbid not reading standing: want 1\n"); return 0;}
  emit("B2-PASS lbid live at activate path (standing 1 vs bid 6)\n");
  return 1;
}
// B3-W1: frequency-loaded wrong leader; trailer never endorsed by any event.
fn h6r_b3w1(tsum:[]u8,csum:[]u8)i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let nW:i32=ev_teach(W,601,61,0);
  let nR:i32=ev_teach(W,601,61,1);
  if(nW<2 || nR<2){emit("B3-W1 teach failed\n"); return 0;}
  let i:i32=0;
  while(i<10){ if(ev_query(W,601,61,-2,0)==-2){emit("B3-W1 query missed\n"); return 0;} i=i+1; }
  if(ls_read(W,nW)!=-999999){emit("B3-W1 nW unexpected record\n"); return 0;}
  if(lbid(W,nW)!=bid(W,nW)){emit("B3-W1 nW lbid!=bid\n"); return 0;}
  if(h6r_sel_bid(W,601,61)!=0){emit("B3-W1 control setup wrong\n"); return 0;}
  let t:i32=0; let c:i32=0; i=0;
  while(i<20){
    if(h6r_sel_bid(W,601,61)==1){c=c+1;}
    let ans:i32=ev_query(W,601,61,-2,0);
    if(ans==-2){emit("B3-W1 probe missed\n"); return 0;}
    if(ans==1){t=t+1;}
    i=i+1;
  }
  emit("B3-W1 pre-ablation accT="); e64(t); emit("/20 accC="); e64(c); emit("/20\n");
  set32(tsum,0,get32(tsum,0)+t); set32(csum,0,get32(csum,0)+c);
  h6r_kill_records(W);
  if(lbid(W,nW)!=bid(W,nW) || lbid(W,nR)!=bid(W,nR)){emit("B3-W1 post-ablation lbid!=bid\n"); return 0;}
  let agree:i32=0; i=0;
  while(i<20){
    let cb:i32=h6r_sel_bid(W,601,61);
    let ta:i32=ev_query(W,601,61,-2,0);
    if(ta==-2){emit("B3-W1 post-ablation probe missed\n"); return 0;}
    if(cb==ta){agree=agree+1;}
    i=i+1;
  }
  emit("B3-W1 post-ablation agreement="); e64(agree); emit("/20\n");
  if(agree!=20){emit("B3-W1 ablation mediation failed\n"); return 0;}
  return 1;
}
// B3-W2: singleton contradiction then correction; both arms track the fix.
fn h6r_b3w2(tsum:[]u8,csum:[]u8)i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let nW:i32=ev_teach(W,602,62,0);
  let nR:i32=ev_teach(W,602,62,1);
  if(nW<2 || nR<2){emit("B3-W2 teach failed\n"); return 0;}
  let i:i32=0;
  while(i<10){ if(ev_query(W,602,62,-2,0)==-2){emit("B3-W2 query missed\n"); return 0;} i=i+1; }
  if(ev_observe(W,602,62,1)!=0){emit("B3-W2 contradict branch wrong\n"); return 0;}
  i=0;
  while(i<4){ if(ev_observe(W,602,62,1)!=1){emit("B3-W2 confirm branch wrong\n"); return 0;} i=i+1; }
  if(ls_read(W,nR)!=4){emit("B3-W2 nR standing wrong: want 4\n"); return 0;}
  if(ls_read(W,nW)!=-1){emit("B3-W2 nW standing wrong: want -1\n"); return 0;}
  let t:i32=0; let c:i32=0; i=0;
  while(i<20){
    if(h6r_sel_bid(W,602,62)==1){c=c+1;}
    let ans:i32=ev_query(W,602,62,-2,0);
    if(ans==-2){emit("B3-W2 probe missed\n"); return 0;}
    if(ans==1){t=t+1;}
    i=i+1;
  }
  emit("B3-W2 pre-ablation accT="); e64(t); emit("/20 accC="); e64(c); emit("/20\n");
  set32(tsum,0,get32(tsum,0)+t); set32(csum,0,get32(csum,0)+c);
  h6r_kill_records(W);
  if(lbid(W,nR)!=bid(W,nR) || lbid(W,nW)!=bid(W,nW)){emit("B3-W2 post-ablation lbid!=bid\n"); return 0;}
  let agree:i32=0; i=0;
  while(i<20){
    let cb:i32=h6r_sel_bid(W,602,62);
    let ta:i32=ev_query(W,602,62,-2,0);
    if(ta==-2){emit("B3-W2 post-ablation probe missed\n"); return 0;}
    if(cb==ta){agree=agree+1;}
    i=i+1;
  }
  emit("B3-W2 post-ablation agreement="); e64(agree); emit("/20\n");
  if(agree!=20){emit("B3-W2 ablation mediation failed\n"); return 0;}
  return 1;
}
// B3-W3: systematic shift then stabilize on the final object.
fn h6r_b3w3(tsum:[]u8,csum:[]u8)i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  if(ev_teach(W,603,63,0)<2){emit("B3-W3 teach failed\n"); return 0;}
  let i:i32=0;
  while(i<6){ if(ev_query(W,603,63,-2,0)==-2){emit("B3-W3 query missed\n"); return 0;} i=i+1; }
  if(ev_observe(W,603,63,1)!=0){emit("B3-W3 contra1 wrong\n"); return 0;}
  if(ev_observe(W,603,63,0)!=0){emit("B3-W3 contra2 wrong\n"); return 0;}
  if(ev_observe(W,603,63,1)!=0){emit("B3-W3 contra3 wrong\n"); return 0;}
  i=0;
  while(i<3){ if(ev_observe(W,603,63,1)!=1){emit("B3-W3 confirm wrong\n"); return 0;} i=i+1; }
  let d:i32=h6r_find_live(W,603,63,1);
  if(d<0){emit("B3-W3 final fact missing\n"); return 0;}
  if(ls_read(W,d)!=3){emit("B3-W3 final standing wrong: want 3\n"); return 0;}
  let t:i32=0; let c:i32=0; i=0;
  while(i<20){
    if(h6r_sel_bid(W,603,63)==1){c=c+1;}
    let ans:i32=ev_query(W,603,63,-2,0);
    if(ans==-2){emit("B3-W3 probe missed\n"); return 0;}
    if(ans==1){t=t+1;}
    i=i+1;
  }
  emit("B3-W3 pre-ablation accT="); e64(t); emit("/20 accC="); e64(c); emit("/20\n");
  set32(tsum,0,get32(tsum,0)+t); set32(csum,0,get32(csum,0)+c);
  h6r_kill_records(W);
  if(lbid(W,d)!=bid(W,d)){emit("B3-W3 post-ablation lbid!=bid\n"); return 0;}
  let agree:i32=0; i=0;
  while(i<20){
    let cb:i32=h6r_sel_bid(W,603,63);
    let ta:i32=ev_query(W,603,63,-2,0);
    if(ta==-2){emit("B3-W3 post-ablation probe missed\n"); return 0;}
    if(cb==ta){agree=agree+1;}
    i=i+1;
  }
  emit("B3-W3 post-ablation agreement="); e64(agree); emit("/20\n");
  if(agree!=20){emit("B3-W3 ablation mediation failed\n"); return 0;}
  return 1;
}
// B3-W4: two slots, one frequency-loaded wrong leader, one corrected.
fn h6r_b3w4(tsum:[]u8,csum:[]u8)i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let nWA:i32=ev_teach(W,604,64,0); let nRA:i32=ev_teach(W,604,64,1);
  let nWB:i32=ev_teach(W,605,65,0); let nRB:i32=ev_teach(W,605,65,1);
  if(nWA<2 || nRA<2 || nWB<2 || nRB<2){emit("B3-W4 teach failed\n"); return 0;}
  let i:i32=0;
  while(i<10){
    if(ev_query(W,604,64,-2,0)==-2){emit("B3-W4 slotA query missed\n"); return 0;}
    if(ev_query(W,605,65,-2,0)==-2){emit("B3-W4 slotB query missed\n"); return 0;}
    i=i+1;
  }
  if(ev_observe(W,605,65,1)!=0){emit("B3-W4 contra wrong\n"); return 0;}
  i=0;
  while(i<4){ if(ev_observe(W,605,65,1)!=1){emit("B3-W4 confirm wrong\n"); return 0;} i=i+1; }
  if(ls_read(W,nRB)!=4){emit("B3-W4 nRB standing wrong\n"); return 0;}
  let t:i32=0; let c:i32=0; i=0;
  while(i<10){
    if(h6r_sel_bid(W,604,64)==1){c=c+1;}
    if(ev_query(W,604,64,-2,0)==1){t=t+1;}
    if(h6r_sel_bid(W,605,65)==1){c=c+1;}
    if(ev_query(W,605,65,-2,0)==1){t=t+1;}
    i=i+1;
  }
  emit("B3-W4 pre-ablation accT="); e64(t); emit("/20 accC="); e64(c); emit("/20\n");
  set32(tsum,0,get32(tsum,0)+t); set32(csum,0,get32(csum,0)+c);
  h6r_kill_records(W);
  if(lbid(W,nWA)!=bid(W,nWA) || lbid(W,nRB)!=bid(W,nRB)){emit("B3-W4 post-ablation lbid!=bid\n"); return 0;}
  let agree:i32=0; i=0;
  while(i<10){
    if(h6r_sel_bid(W,604,64)==ev_query(W,604,64,-2,0)){agree=agree+1;}
    if(h6r_sel_bid(W,605,65)==ev_query(W,605,65,-2,0)){agree=agree+1;}
    i=i+1;
  }
  emit("B3-W4 post-ablation agreement="); e64(agree); emit("/20\n");
  if(agree!=20){emit("B3-W4 ablation mediation failed\n"); return 0;}
  return 1;
}
// B3 aggregate: 80 held-out probes, frozen bar margin >= 15 points.
fn h6r_b3()i32 {
  let tsum:[]u8=z_alloc(8); let csum:[]u8=z_alloc(8);
  set32(tsum,0,0); set32(csum,0,0);
  if(h6r_b3w1(tsum,csum)==0){return 0;}
  if(h6r_b3w2(tsum,csum)==0){return 0;}
  if(h6r_b3w3(tsum,csum)==0){return 0;}
  if(h6r_b3w4(tsum,csum)==0){return 0;}
  let t:i32=get32(tsum,0); let c:i32=get32(csum,0);
  let margin:i32=(t-c)*100/80;
  emit("B3-TOTAL accT="); e64(t); emit("/80 accC="); e64(c); emit("/80 margin_pts="); e64(margin); emit("\n");
  emit("B3 frozen bar: margin >= 15 points\n");
  if(margin>=15){emit("B3-PASS\n"); return 1;}
  emit("B3-FAIL: margin below 15 points, KILL fires\n");
  return 0;
}
// B4: retention under memory pressure, with a pacemaker slot P whose
// confirms keep STAND_ROOT pinned (verified substrate property: the root's
// type-9 protection edge is removed by decay after 12 standing-free events
// and ref_prot cannot restore a removed edge; PREREG_H6R Amendment 1).
fn h6r_b4world(sH:i32,rH:i32,nconfH:i32,sF:i32,rF:i32,nconfF:i32,nqF:i32,pslot:i32,wtag:i32)i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let nH:i32=ev_teach(W,sH,rH,1);
  let nF:i32=ev_teach(W,sF,rF,2);
  let nP:i32=ev_teach(W,pslot,90,7);
  if(nH<2 || nF<2 || nP<2){emit("B4 teach failed\n"); return 0;}
  let i:i32=0;
  while(i<nconfH){ if(ev_observe(W,sH,rH,1)!=1){emit("B4 nH confirm wrong\n"); return 0;} i=i+1; }
  i=0;
  while(i<nconfF){ if(ev_observe(W,sF,rF,2)!=1){emit("B4 nF confirm wrong\n"); return 0;} i=i+1; }
  // interleaved: 2 query hits on nF + 1 pacemaker confirm per round.
  // nF gains frequency without standing; the pacemaker re-pins STAND_ROOT.
  let rounds:i32=nqF/2;
  i=0;
  while(i<rounds){
    let q1:i32=ev_query(W,sF,rF,-2,0);
    let q2:i32=ev_query(W,sF,rF,-2,0);
    if(q1==-2 || q2==-2){emit("B4 nF query missed\n"); return 0;}
    if(ev_observe(W,pslot,90,7)!=1){emit("B4 pacemaker confirm wrong\n"); return 0;}
    i=i+1;
  }
  if(ls_read(W,nH)!=nconfH){emit("B4 nH standing wrong\n"); return 0;}
  if(ls_read(W,nF)!=nconfF){emit("B4 nF standing wrong\n"); return 0;}
  if(bid(W,nH)!=nconfH){emit("B4 nH bid wrong\n"); return 0;}
  if(bid(W,nF)!=nconfF+nqF){emit("B4 nF bid wrong\n"); return 0;}
  if(lbid(W,nH)!=nconfH || lbid(W,nF)!=nconfF){emit("B4 lbid wrong\n"); return 0;}
  // lapse target protection without ever letting the root see 12 decays:
  // 2 rounds of [10 pure-decay ev_acts + 1 pacemaker confirm].
  let nc0:i32=hg(W,20);
  i=0;
  while(i<2){
    let j:i32=0;
    while(j<10){ ev_act(W); j=j+1; }
    if(ev_observe(W,pslot,90,7)!=1){emit("B4 lapse confirm wrong\n"); return 0;}
    i=i+1;
  }
  if(hg(W,20)!=nc0){emit("B4 ev_act created nodes\n"); return 0;}
  if(is_prot(W,nH)!=0 || is_prot(W,nF)!=0){emit("B4 targets still protected\n"); return 0;}
  if(is_prot(W,ng(W,0,28))!=1){emit("B4 root unprotected\n"); return 0;}
  // REAL eviction through the retention mechanism
  let v1:i32=evict_node(W);
  emit("B4-W"); e64(wtag); emit(" first real eviction="); e64(v1);
  emit(" nF="); e64(nF); emit(" nH="); e64(nH); emit("\n");
  if(v1!=nF){emit("B4 treatment did not evict high-frequency nF first\n"); return 0;}
  // two more real evictions document the history-node churn (observation only)
  let v2:i32=evict_node(W); let v3:i32=evict_node(W);
  emit("B4-W"); e64(wtag); emit(" churn victims="); e64(v2); emit(","); e64(v3); emit("\n");
  emit("B4-W"); e64(wtag); emit("-PASS treatment evicts nF before nH; bid control reverses (");
  e64(nconfH); emit("<"); e64(nconfF+nqF); emit(")\n");
  return 1;
}
fn h6r_b4()i32 {
  if(h6r_b4world(701,71,8, 702,72,3,12, 901, 1)==0){return 0;}
  if(h6r_b4world(703,73,5, 704,74,2,8, 902, 2)==0){return 0;}
  if(h6r_b4world(705,75,6, 706,76,1,16, 903, 3)==0){return 0;}
  emit("B4-PASS high-standing nodes survive preferentially on all 3 worlds\n");
  return 1;
}
fn h6r_main()i32 {
  emit("H6R-REGRESSION run_all:\n");
  if(run_all()!=0){emit("H6R-REGRESSION FAIL\n"); return 1;}
  emit("H6R-REGRESSION PASS\n");
  let b1:i32=h6r_b1();
  let b2:i32=h6r_b2();
  let b3:i32=h6r_b3();
  let b4:i32=h6r_b4();
  emit("H6R-SUMMARY B1="); e64(b1); emit(" B2="); e64(b2);
  emit(" B3="); e64(b3); emit(" B4="); e64(b4); emit("\n");
  if(b1==1 && b2==1 && b3==1 && b4==1){emit("H6R-VERDICT: BUILD-PASS\n"); return 0;}
  emit("H6R-VERDICT: BUILD-FAIL\n");
  return 1;
}

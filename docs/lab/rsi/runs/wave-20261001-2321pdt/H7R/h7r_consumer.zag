// ============ H7R re-derivation consumer (frozen spec: H7R_PREREG.md section 2) ============
// Generic machinery only. No domain constants, no per-world branches. Every branch
// tests structural metadata (node tags, field offsets, edge types, ticket markers,
// status codes, the substrate's own supersession signal). Ticket content (keys,
// values, topology) is read from learner state: fact node fields and stale ticket
// steps. This consumer is the only ticket author in the experiment.

// find the R_BUILD (-41) ticket linked to fact f via any ET_REF edge; -1 if none
fn h7_ticket_for_fact(W:[]u8,f:i32)i32 {
  let br:i32=ng(W,0,24);
  if(br<2 || ng(W,br,36)!=1){return -1;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==br && eg(W,e,4)==10){
      let t:i32=eg(W,e,8);
      if(ng(W,t,36)==1 && ng(W,t,0)==904 && ng(W,t,24)==-41){
        let e2:i32=0;
        while(e2<4096){
          if(eg(W,e2,0)!=-1 && eg(W,e2,0)==t && eg(W,e2,4)==4 && eg(W,e2,8)==f){return t;}
          e2=e2+1;
        }
      }
    }
    e=e+1;
  }
  return -1;
}

// derive mode: fixed generic schema [BEQ(slot0, lit(f20)) true-target SET(slot1, lit(f28))]
// The schema mirrors the substrate's fact query semantics (match field20, yield
// field28) and is identical for stale and re-derived graphs.
fn h7_derive(W:[]u8,f:i32)i32 {
  if(f<2 || ng(W,f,36)!=1 || ng(W,f,0)!=1){return -1;}
  let t:i32=lb_ticket_new(W,ng(W,f,20),-41);
  if(t<0){return -1;}
  if(lb_step_add(W,t,102,1000,ng(W,f,20),-2)<0){return -1;}
  if(lb_step_add(W,t,101,1001,ng(W,f,28),0)<0){return -1;}
  return t;
}

// link a built ticket to its source fact (called after lb_run materialized it)
fn h7_link_ticket_fact(W:[]u8,t:i32,f:i32)i32 {
  if(t<2 || ng(W,t,36)!=1 || ng(W,t,0)!=904 || ng(W,t,28)!=1){return -1;}
  return link_edge(W,t,4,f,0);
}

// re-resolve one operand spec against the contradiction: a literal equal to the
// superseded value becomes the new value. Slot codes (>= 1000) and back-refs
// (< 0) pass through unchanged. (s, r) are invariant across a contradiction
// through the event interface, so field28 is the only literal that changes.
fn h7_respec(W:[]u8,step:i32,foff:i32,oldn:i32,newn:i32)i32 {
  let spec:i32=ng(W,step,foff);
  if(spec>=1000){return spec;}
  if(spec<0){return spec;}
  if(spec==ng(W,oldn,28)){return ng(W,newn,28);}
  return spec;
}

// rederive mode: interpret one pending REDERIVE ticket.
// Returns the new BUILD ticket id (>= 2) on re-derivation; 0 if the ticket is
// consumed with no derivation to re-derive (distractor path); -1 on error.
fn h7_rederive_one(W:[]u8,t:i32)i32 {
  if(t<2 || ng(W,t,36)!=1 || ng(W,t,0)!=904 || ng(W,t,24)!=-43){return -1;}
  let oldn:i32=-1; let newn:i32=-1;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==t && eg(W,e,4)==4){
      let c:i32=eg(W,e,8);
      if(ng(W,c,36)==1 && ng(W,c,0)==1){
        if(is_superseded(W,c)==1){oldn=c;} else {newn=c;}
      }
    }
    e=e+1;
  }
  if(oldn<2 || newn<2){ns(W,t,28,-1); return -1;}
  ns(W,t,28,1);
  let st:i32=h7_ticket_for_fact(W,oldn);
  if(st<0){return 0;}
  let nt:i32=lb_ticket_new(W,ng(W,oldn,20),-41);
  if(nt<0){return -1;}
  let cur:i32=lb_reftarget(W,st);
  if(cur<0){ns(W,nt,28,-1); return -1;}
  let gd:i32=0;
  while(cur>=0 && gd<64){
    if(ng(W,cur,36)!=1 || ng(W,cur,0)!=904){ns(W,nt,28,-1); return -1;}
    let tag:i32=ng(W,cur,20);
    let a4:i32=h7_respec(W,cur,24,oldn,newn);
    let a8:i32=h7_respec(W,cur,28,oldn,newn);
    let a12:i32=h7_respec(W,cur,32,oldn,newn);
    if(lb_step_add(W,nt,tag,a4,a8,a12)<0){ns(W,nt,28,-1); return -1;}
    cur=seq_nx(W,cur); gd=gd+1;
  }
  ns(W,st,28,2);
  return nt;
}

// first pending REDERIVE ticket under BUILD_ROOT, or -1
fn h7_find_pending_rederive(W:[]u8)i32 {
  let br:i32=ng(W,0,24);
  if(br<2 || ng(W,br,36)!=1){return -1;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==br && eg(W,e,4)==10){
      let t:i32=eg(W,e,8);
      if(ng(W,t,36)==1 && ng(W,t,0)==904 && ng(W,t,24)==-43 && ng(W,t,28)==0){return t;}
    }
    e=e+1;
  }
  return -1;
}

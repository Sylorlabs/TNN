// ============ H7R sealed driver (worlds committed post-freeze; driver never authors tickets) ============
// The driver teaches facts, triggers contradictions, invokes the consumer and the
// substrate service, and measures. It never authors tickets itself: all ticket
// content comes from the consumer reading learner state (audited by grep).
// World values below were chosen after the prereg freeze; the consumer contains
// no domain constants, so tuning the worlds to the consumer is structurally
// impossible.

// ---- world tables (post-freeze sealed values) ----
// per world: relation R; 4 cases (key, old value, new value); 2 distractors.
fn h7w_R(wn:i32)i32 {
  if(wn==1){return 61;}
  if(wn==2){return 62;}
  return 63;
}
fn h7w_ck(wn:i32,i:i32)i32 {
  if(wn==1){return 101+i;}
  if(wn==2){return 111+i;}
  return 121+i;
}
fn h7w_cvold(wn:i32,i:i32)i32 {
  if(wn==1){return 201+i;}
  if(wn==2){return 221+i;}
  return 241+i;
}
fn h7w_cvnew(wn:i32,i:i32)i32 {
  if(wn==1){return 211+i;}
  if(wn==2){return 231+i;}
  return 251+i;
}
fn h7w_dk(wn:i32,j:i32)i32 {
  if(wn==1){return 105+j;}
  if(wn==2){return 115+j;}
  return 125+j;
}
fn h7w_duold(wn:i32,j:i32)i32 {
  if(wn==1){return 205+j;}
  if(wn==2){return 225+j;}
  return 245+j;
}
fn h7w_dunew(wn:i32,j:i32)i32 {
  if(wn==1){return 215+j;}
  if(wn==2){return 235+j;}
  return 255+j;
}

// ---- measurement helpers (scoring only; not architecture) ----
fn h7_rdcount(W:[]u8)i32 {
  let br:i32=ng(W,0,24);
  if(br<2 || ng(W,br,36)!=1){return 0;}
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==br && eg(W,e,4)==10){
      let t:i32=eg(W,e,8);
      if(ng(W,t,36)==1 && ng(W,t,0)==904 && ng(W,t,24)==-43){c=c+1;}
    }
    e=e+1;
  }
  return c;
}
fn h7_bcount(W:[]u8)i32 {
  let br:i32=ng(W,0,24);
  if(br<2 || ng(W,br,36)!=1){return 0;}
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==br && eg(W,e,4)==10){
      let t:i32=eg(W,e,8);
      if(ng(W,t,36)==1 && ng(W,t,0)==904 && ng(W,t,24)==-41){c=c+1;}
    }
    e=e+1;
  }
  return c;
}
// execute root on the frozen ISA with slot0=key; returns slot1, or -999999
fn h7_probe(W:[]u8,root:i32,key:i32)i32 {
  let fr:i32=alloc_node(W); ns(W,fr,0,902);
  fr_set(W,fr,0,key); fr_set(W,fr,1,0);
  if(execute(W,root,fr)!=1){return -999999;}
  return fr_get(W,fr,1);
}
// ticket links exactly the superseded old fact and the live new fact (k, vnew)
fn h7_linkok(W:[]u8,t:i32,k:i32,vnew:i32)i32 {
  let sold:i32=0; let snew:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==t && eg(W,e,4)==4){
      let c:i32=eg(W,e,8);
      if(ng(W,c,36)==1 && ng(W,c,0)==1){
        if(is_superseded(W,c)==1){sold=c;} else {snew=c;}
      }
    }
    e=e+1;
  }
  if(sold<2 || snew<2){return 0;}
  if(ng(W,snew,20)!=k || ng(W,snew,28)!=vnew){return 0;}
  return 1;
}
// 1 if t2_sig differs, 0 if identical, -1 on error
fn h7_sigdiff(W:[]u8,r0:i32,r1:i32)i32 {
  let s0:[]u8=z_alloc(256); let s1:[]u8=z_alloc(256);
  let c0:i32=t2_sig(W,r0,s0); let c1:i32=t2_sig(W,r1,s1);
  if(c0<0 || c1<0 || c0!=c1){return -1;}
  let i:i32=0;
  while(i<c0*2){
    if(get32(s0,i*4)!=get32(s1,i*4)){return 1;}
    i=i+1;
  }
  return 0;
}

// ---- one sealed world ----
// tally slots: 0 cases, 4 sigdiff, 8 newok, 12 stalecorr, 16 staleold, 20 negok
fn h7w_run(wn:i32,tally:[]u8)i32 {
  let ok:i32=1;
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let R:i32=h7w_R(wn);
  let stale_t:[]u8=z_alloc(16); let new_t:[]u8=z_alloc(16);
  let i:i32=0;
  // 1. learning: teach facts; derive (consumer) for case facts only
  while(i<4){
    let k:i32=h7w_ck(wn,i); let vo:i32=h7w_cvold(wn,i);
    let f:i32=ev_teach(W,k,R,vo);
    if(f<2){emit("H7R learn teach fail\n"); ok=0;}
    let t:i32=h7_derive(W,f);
    if(t<2){emit("H7R derive fail\n"); ok=0;}
    lb_run(W);
    if(ng(W,t,28)!=1){emit("H7R ticket not built\n"); ok=0;}
    if(h7_link_ticket_fact(W,t,f)<0){emit("H7R link fail\n"); ok=0;}
    if(h7_probe(W,ng(W,t,32),k)!=vo){emit("H7R stale not functional pre-contradiction\n"); ok=0;}
    set32(stale_t,i*4,t);
    i=i+1;
  }
  let j:i32=0;
  while(j<2){
    if(ev_teach(W,h7w_dk(wn,j),R,h7w_duold(wn,j))<2){emit("H7R distractor teach fail\n"); ok=0;}
    j=j+1;
  }
  if(h7_rdcount(W)!=0){emit("H7R nonzero rederive baseline\n"); ok=0;}
  // 2. contradiction per case: trigger -> consume -> rebuild via lb_run
  i=0;
  while(i<4){
    let k:i32=h7w_ck(wn,i); let vn:i32=h7w_cvnew(wn,i);
    let c0:i32=h7_rdcount(W);
    if(ev_observe(W,k,R,vn)!=0){emit("H7R observe did not contradict\n"); ok=0;}
    if(h7_rdcount(W)!=c0+1){emit("H7R trigger count wrong\n"); ok=0;}
    let t:i32=h7_find_pending_rederive(W);
    if(t<2){emit("H7R pending ticket missing\n"); ok=0;}
    if(h7_linkok(W,t,k,vn)==0){emit("H7R ticket links wrong\n"); ok=0;}
    let nt:i32=h7_rederive_one(W,t);
    if(nt<2){emit("H7R rederive failed\n"); ok=0;}
    lb_run(W);
    if(ng(W,nt,28)!=1){emit("H7R new ticket not built\n"); ok=0;}
    set32(new_t,i*4,nt);
    set32(tally,0,get32(tally,0)+1);
    i=i+1;
  }
  // distractors: contradiction with no derivation -> consume, author nothing
  let b0:i32=h7_bcount(W);
  j=0;
  while(j<2){
    if(ev_observe(W,h7w_dk(wn,j),R,h7w_dunew(wn,j))!=0){emit("H7R distractor observe did not contradict\n"); ok=0;}
    let t2:i32=h7_find_pending_rederive(W);
    if(t2<2){emit("H7R distractor ticket missing\n"); ok=0;}
    if(h7_rederive_one(W,t2)!=0){emit("H7R distractor authored\n"); ok=0;}
    j=j+1;
  }
  if(h7_bcount(W)!=b0){emit("H7R distractor build count moved\n"); ok=0;}
  // 3. confirms must not trigger re-derivation
  let cc:i32=h7_rdcount(W);
  i=0;
  while(i<4){
    if(ev_observe(W,h7w_ck(wn,i),R,h7w_cvnew(wn,i))!=1){emit("H7R confirm branch not taken\n"); ok=0;}
    i=i+1;
  }
  if(h7_rdcount(W)!=cc){emit("H7R spurious trigger on confirm\n"); ok=0;}
  if(h7_find_pending_rederive(W)!=-1){emit("H7R pending after confirms\n"); ok=0;}
  if(h7_bcount(W)!=b0){emit("H7R confirm authored tickets\n"); ok=0;}
  set32(tally,20,get32(tally,20)+1);
  // 4. held-out probe: frames never presented during learning or contradiction
  i=0;
  while(i<4){
    let k:i32=h7w_ck(wn,i); let vo:i32=h7w_cvold(wn,i); let vn:i32=h7w_cvnew(wn,i);
    let sroot:i32=ng(W,get32(stale_t,i*4),32);
    let nroot:i32=ng(W,get32(new_t,i*4),32);
    if(sroot<2 || nroot<2){emit("H7R root missing\n"); ok=0;}
    let pv_new:i32=h7_probe(W,nroot,k);
    let pv_stale:i32=h7_probe(W,sroot,k);
    if(pv_new==vn){set32(tally,8,get32(tally,8)+1);}
    if(pv_stale==vn){set32(tally,12,get32(tally,12)+1);}
    if(pv_stale==vo){set32(tally,16,get32(tally,16)+1);}
    let sd:i32=h7_sigdiff(W,sroot,nroot);
    if(sd<0){emit("H7R sig error\n"); ok=0;}
    if(sd==1){set32(tally,4,get32(tally,4)+1);}
    i=i+1;
  }
  emit("H7R world done wn="); e64(wn); emit(" ok="); e64(ok); emit("\n");
  return ok;
}

fn h7r_main()i32 {
  emit("H7R-SEALED wave-20261001-2321pdt consumer+driver on prototype substrate\n");
  if(dv_v2()==0){emit("H7R B1 V2-RERUN FAIL\n"); return 1;}
  emit("H7R B1 V2-RERUN PASS\n");
  if(dv_v1()==0){emit("H7R V1-RERUN FAIL\n"); return 1;}
  emit("H7R V1-RERUN PASS\n");
  let tally:[]u8=z_alloc(32);
  let ok:i32=1;
  if(h7w_run(1,tally)==0){ok=0;}
  if(h7w_run(2,tally)==0){ok=0;}
  if(h7w_run(3,tally)==0){ok=0;}
  let cases:i32=get32(tally,0);
  let sigdiff:i32=get32(tally,4);
  let newok:i32=get32(tally,8);
  let stalecorr:i32=get32(tally,12);
  let staleold:i32=get32(tally,16);
  let negok:i32=get32(tally,20);
  emit("H7R-TALLY cases="); e64(cases);
  emit(" sigdiff="); e64(sigdiff);
  emit(" newok="); e64(newok);
  emit(" stalecorr="); e64(stalecorr);
  emit(" staleold="); e64(staleold);
  emit(" negok="); e64(negok);
  emit("\n");
  let pass:i32=1;
  if(cases!=12){emit("H7R BARS case count wrong\n"); pass=0;}
  if(newok*100<cases*80){emit("H7R B2 newok below 80\n"); pass=0;}
  if((newok-stalecorr)*100<cases*60){emit("H7R B2 margin below 60pp\n"); pass=0;}
  if(sigdiff*100<cases*80){emit("H7R B3 below 80 KILL\n"); pass=0;}
  if(staleold!=cases){emit("H7R B4 stale not stale\n"); pass=0;}
  if(negok!=3){emit("H7R B5B6 neg controls fail\n"); pass=0;}
  if(ok==0){emit("H7R protocol asserts failed\n"); pass=0;}
  if(pass==1){emit("H7R-SEALED ALL-BARS-PASS\n"); return 0;}
  emit("H7R-SEALED BARS-FAIL\n"); return 1;
}

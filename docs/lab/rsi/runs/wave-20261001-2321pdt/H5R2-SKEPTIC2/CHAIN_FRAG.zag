// ==== H5R2-SKEPTIC2 CHAIN FRAGMENT (frozen post-prereg; pure Zag) ====
// Chained decoy world family for lane H5R2-SKEPTIC2, wave-20261001-2321pdt.
// Appended after the frozen DRIVER_TMPL.zag; uses its helpers
// (h5r2_probe, h5r2_map_sup_n, h5r2_map_live_id, h5r2_map_con_all,
// h5r2_dump) and the substrate (ev_teach, ev_observe, ev_query,
// is_superseded, emit, e64, z_alloc, WSZ, tnn2_init).
// Per chained probe: teach chain, promote MAP1, contradict, promote MAP2,
// REVERT on K=(b,rf2), DECOY at the a-level on (a,rd1), DECOY at the
// b-level on (b,rd2), decoy answerability at both levels, revert MAP3
// query, white-box CD-check. No OBSERVE on any MAP key. Key ranges
// 89xxx-90xxx.

// id of the single live tag-1 fact on (sm,rm); -1 unless exactly one
fn sk2_fact_live_id(W:[]u8,sm:i32,rm:i32)i32 {
  let id:i32=-1; let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==sm && ng(W,n,24)==rm && is_superseded(W,n)==0){id=n; c=c+1;}
    n=n+1;
  }
  if(c!=1){return -1;}
  return id;
}
// CD-check: white-box bar for one chained probe. The live MAP on (sm,rm)
// must anchor DEP edges to the live tag-1 facts on the chain keys at both
// levels, never to either decoy fact, never to a superseded fact.
fn sk2_cdcy(W:[]u8,sm:i32,rm:i32,a:i32,rf1:i32,b:i32,rf2:i32,fexp:i32,decoy_a:i32,decoy_b:i32,tag:[]u8)i32 {
  let ok:i32=1;
  let sup:i32=h5r2_map_sup_n(W,sm,rm);
  let id:i32=h5r2_map_live_id(W,sm,rm);
  let klive:i32=sk2_fact_live_id(W,b,rf2);
  let alive:i32=sk2_fact_live_id(W,a,rf1);
  emit(tag); emit(" CD sup="); e64(sup); emit(" liveid="); e64(id);
  emit(" decoy_a="); e64(decoy_a); emit(" decoy_b="); e64(decoy_b);
  emit(" klive="); e64(klive); emit(" alive="); e64(alive); emit("\n");
  if(sup!=2){emit(tag); emit(" CD-SUP-FAIL\n"); ok=0;}
  if(id<0){emit(tag); emit(" CD-LIVE-FAIL\n"); ok=0;}
  if(decoy_a<0 || decoy_b<0){emit(tag); emit(" CD-DECOYID-FAIL\n"); ok=0;}
  if(id>=0){
    if(ng(W,id,28)!=fexp){emit(tag); emit(" CD-F28-FAIL\n"); ok=0;}
    let e:i32=0; let dep:i32=0; let depok:i32=1; let nodecoy:i32=1;
    let keyhit:i32=0; let akeyhit:i32=0;
    while(e<4096){
      if(eg(W,e,0)!=-1 && eg(W,e,0)==id && eg(W,e,4)==1){
        dep=dep+1;
        let t:i32=eg(W,e,8);
        emit(tag); emit(" CD dep->"); e64(t); emit(" tag="); e64(ng(W,t,0));
        emit(" s="); e64(ng(W,t,20)); emit(" r="); e64(ng(W,t,24));
        emit(" o="); e64(ng(W,t,28)); emit(" sup="); e64(is_superseded(W,t)); emit("\n");
        if(ng(W,t,36)!=1 || ng(W,t,0)!=1 || is_superseded(W,t)==1){depok=0;}
        if(t==decoy_a || t==decoy_b){nodecoy=0;}
        if(t==klive){keyhit=1;}
        if(t==alive){akeyhit=1;}
      }
      e=e+1;
    }
    if(dep<1 || depok==0){emit(tag); emit(" CD-DEP-FAIL\n"); ok=0;}
    if(nodecoy==0){emit(tag); emit(" CD-DECOY-FAIL\n"); ok=0;}
    if(klive>=0 && keyhit==0){emit(tag); emit(" CD-KEY-FAIL\n"); ok=0;}
    if(alive>=0 && akeyhit==0){emit(tag); emit(" CD-AKEY-FAIL\n"); ok=0;}
  }
  if(ok==1){emit(tag); emit(" CD ok\n");}
  return ok;
}
// One chained probe: P1 promote, contradict, P2 promote, revert, a-level
// decoy, a-level answerability, b-level decoy, b-level answerability,
// P3 revert-MAP query, CD-check.
fn sk2_cd_probe(W:[]u8,a:i32,b:i32,rf1:i32,rf2:i32,rm:i32,rd1:i32,rd2:i32,c0:i32,c1:i32,tag:[]u8)i32 {
  let ok:i32=1;
  ev_teach(W,a,rf1,b); ev_teach(W,b,rf2,c0);
  let id0:i32=h5r2_probe(W,a,rm,c0,tag,"P1",-1);
  if(id0<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  let id1:i32=h5r2_probe(W,a,rm,c1,tag,"P2",id0);
  if(id1<0){ok=0;}
  ev_observe(W,b,rf2,c0);
  ev_observe(W,a,rd1,b);
  let dva:i32=ev_query(W,a,rd1,b,0);
  if(dva!=b){emit(tag); emit(" D-ANS-A-FAIL v="); e64(dva); emit("\n"); ok=0;}
  else {emit(tag); emit(" D-ANS-A ok\n");}
  ev_observe(W,b,rd2,c0);
  let dvb:i32=ev_query(W,b,rd2,c0,0);
  if(dvb!=c0){emit(tag); emit(" D-ANS-B-FAIL v="); e64(dvb); emit("\n"); ok=0;}
  else {emit(tag); emit(" D-ANS-B ok\n");}
  let id2:i32=h5r2_probe(W,a,rm,c0,tag,"P3",id1);
  if(id2<0){ok=0;}
  let decoy_a:i32=sk2_fact_live_id(W,a,rd1);
  let decoy_b:i32=sk2_fact_live_id(W,b,rd2);
  if(sk2_cdcy(W,a,rm,a,rf1,b,rf2,c0,decoy_a,decoy_b,tag)==0){ok=0;}
  return ok;
}
// world e1: chain 8901/8902, MAP 8903, b-decoy 8904, a-decoy 8905. vo=6.
fn sealed_main_e1()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(sk2_cd_probe(W,89101,89301,8901,8902,8903,8905,8904,89407,89408,"E1P1")==0){ok=0;}
  if(sk2_cd_probe(W,89102,89302,8901,8902,8903,8905,8904,89417,89418,"E1P2")==0){ok=0;}
  if(sk2_cd_probe(W,89103,89303,8901,8902,8903,8905,8904,89427,89428,"E1P3")==0){ok=0;}
  if(sk2_cd_probe(W,89104,89304,8901,8902,8903,8905,8904,89437,89438,"E1P4")==0){ok=0;}
  let mc:i32=h5r2_map_con_all(W);
  emit("E1 MAPCON-ALL="); e64(mc); emit("\n");
  if(mc<1){emit("E1 NC-1R2-FAIL\n"); ok=0;}
  if(ok==1){emit("E1 DONE-OK\n");} else {emit("E1 DONE-FAIL\n");}
  h5r2_dump(W);
  return ok;
}
// world e2: chain 9001/9002, MAP 9003, b-decoy 9004, a-decoy 9005. vo=0.
fn sealed_main_e2()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(sk2_cd_probe(W,90101,90301,9001,9002,9003,9005,9004,90401,90402,"E2P1")==0){ok=0;}
  if(sk2_cd_probe(W,90102,90302,9001,9002,9003,9005,9004,90411,90412,"E2P2")==0){ok=0;}
  if(sk2_cd_probe(W,90103,90303,9001,9002,9003,9005,9004,90421,90422,"E2P3")==0){ok=0;}
  if(sk2_cd_probe(W,90104,90304,9001,9002,9003,9005,9004,90431,90432,"E2P4")==0){ok=0;}
  let mc:i32=h5r2_map_con_all(W);
  emit("E2 MAPCON-ALL="); e64(mc); emit("\n");
  if(mc<1){emit("E2 NC-1R2-FAIL\n"); ok=0;}
  if(ok==1){emit("E2 DONE-OK\n");} else {emit("E2 DONE-FAIL\n");}
  h5r2_dump(W);
  return ok;
}

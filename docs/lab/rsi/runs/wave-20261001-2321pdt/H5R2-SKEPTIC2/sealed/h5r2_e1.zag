fn main()i32 { return sealed_main(); }
// ============ ACT 24/24 remediation port (prereg ACT_REMED_PREREG.md) ============
// Ported from act_build/act.zag (614 lines, 23 ptests + ALL-PASS).
// Test names and expected values identical to standalone (K3 fidelity).
// P-ACT6A/B use TNN-1's real evict_node (3-step directional) not the stand-in.

fn r_ptest(name:[]u8, got:i32, want:i32)i32 {
  emit(name); emit(": got "); e64(got); emit(" want "); e64(want);
  if(got==want){ emit(" PASS\n"); return 1; } else { emit(" FAIL\n"); return 0; }
}
fn r_mk_fact(W:[]u8)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,1); return a;
}
fn r_mk_goal(W:[]u8, target:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,2); ns(W,a,4,target); return a;
}
fn r_mk_guide(W:[]u8, anchor:i32, goal:i32, choice:i32, conf:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,102); ns(W,a,4,anchor); ns(W,a,8,goal);
  write_node(W,a,choice,conf,0,0); link_edge(W,goal,1,a,0); return a;
}
fn r_mk_uncert(W:[]u8, qctx:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,30); ns(W,a,4,qctx); return a;
}
fn r_learn_confirm(W:[]u8, ses:i32, a:i32)void {
  link_edge(W,ses,6,a,0); link_edge(W,ses,7,a,0); return;
}
fn r_ctx_clear(W:[]u8)void {
  hs(W,48,0); hs(W,32,0); hs(W,36,0); hs(W,40,0); hs(W,44,0); return;
}
fn r_live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn r_evict_to_cap(W:[]u8, cap:i32)i32 {
  let ev:i32=0; let guard:i32=0;
  while(r_live_count(W)>cap && guard<10000){
    guard=guard+1;
    let v:i32=evict_node(W);
    if(v<0){ return ev; }
    ev=ev+1;
  }
  return ev;
}
fn r_derive_d1(W:[]u8, ses:i32, goal:i32, gstate:i32, trans:[]u8, nt:i32)i32 {
  let made:i32=0;
  let work:[]u8=z_alloc(256*4);
  set32(work,0,gstate); let wc:i32=1; let wi:i32=0;
  while(wi<wc){
    let s:i32=get32(work,wi*4);
    let t:i32=0;
    while(t<nt){
      let fs:i32=get32(trans,t*12); let ac:i32=get32(trans,t*12+4);
      let ts:i32=get32(trans,t*12+8);
      if(ts==s){
        let has:i32=0; let a:i32=2;
        while(a<1024){
          if(ng(W,a,36)==1 && ng(W,a,0)==102 && ng(W,a,4)==fs){ has=1; }
          a=a+1;
        }
        if(has==0){
          r_mk_guide(W,fs,goal,ac,80);
          made=made+1;
          let seen:i32=0; let k:i32=0;
          while(k<wc){ if(get32(work,k*4)==fs){seen=1;} k=k+1; }
          if(seen==0 && wc<256){ set32(work,wc*4,fs); wc=wc+1; }
        }
      }
      t=t+1;
    }
    wi=wi+1;
  }
  return made;
}
// P-ACT3: null POLICY_ROOT -> CHOICE 0 always
fn t_r_pact3()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s1:i32=r_mk_fact(W);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  return r_ptest("P-ACT3 null-root", c, 0);
}
// P-ACT1: W7-class planning. States s1->s2->s3, goal s3.
fn t_r_pact1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let s3:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(3*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,11); set32(tr,20,s3);
  set32(tr,24,s3); set32(tr,28,10); set32(tr,32,s3);
  let goal:i32=r_mk_goal(W,s3);
  let made:i32=r_derive_d1(W,ses,goal,s3,tr,3);
  pol_set(W,goal);
  let a:i32=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT1 s1->10", ev_act(W), 10);
  r_ctx_clear(W); ctx_push(W,s2);
  ok=ok & r_ptest("P-ACT1 s2->11", ev_act(W), 11);
  r_ctx_clear(W); ctx_push(W,s3);
  ok=ok & r_ptest("P-ACT1 s3->10", ev_act(W), 10);
  ok=ok & r_ptest("P-ACT1 3 guides", made, 3);
  return ok;
}
// P-ACT2: W6-class inquiry.
fn t_r_pact2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let q:i32=r_mk_fact(W);
  let d:i32=r_mk_fact(W);
  let u:i32=r_mk_uncert(W,q);
  let idx:i32=r_mk_fact(W);
  let g1:i32=r_mk_guide(W,u,idx,20,90);
  let g2:i32=r_mk_guide(W,d,idx,21,90);
  link_edge(W,idx,1,g1,0); link_edge(W,idx,1,g2,0);
  pol_set(W,idx);
  r_learn_confirm(W,ses,g1); r_learn_confirm(W,ses,g2);
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,u);
  ok=ok & r_ptest("P-ACT2 uncert->20", ev_act(W), 20);
  r_ctx_clear(W); ctx_push(W,d);
  ok=ok & r_ptest("P-ACT2 decoy->21", ev_act(W), 21);
  r_ctx_clear(W); ctx_push(W,q);
  ok=ok & r_ptest("P-ACT2 other->0", ev_act(W), 0);
  return ok;
}
// P-ACT4: structure ablation.
fn t_r_pact4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(2*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,10); set32(tr,20,s2);
  let goal:i32=r_mk_goal(W,s2);
  r_derive_d1(W,ses,goal,s2,tr,2);
  pol_set(W,goal);
  let a:i32=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 pre s1->10", ev_act(W), 10);
  a=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ ns(W,a,0,0); ns(W,a,36,0); }
    a=a+1;
  }
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 no-guides->0", ev_act(W), 0);
  a=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==0 && a!=goal){ ns(W,a,0,102); }
    a=a+1;
  }
  ns(W,goal,0,0);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  ok=ok & r_ptest("P-ACT4 no-goal->0", c, 0);
  ok=ok & r_ptest("P-ACT4 fact-alive", ng(W,s1,0), 1);
  return ok;
}
// P-ACT5: generality (one handler, both classes).
fn t_r_pact5()i32 {
  let ok:i32=t_r_pact1();
  ok=ok & t_r_pact2();
  emit("P-ACT5 one-handler-both-classes: ");
  if(ok==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return ok;
}
// P-ACT6: memory prerequisite (real 3-step eviction).
fn t_r_pact6()i32 {
  let ok:i32=1;
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let goal:i32=r_mk_goal(W,s2);
  let g1:i32=r_mk_guide(W,s1,goal,10,80);
  pol_set(W,goal);
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A pre s1->10", ev_act(W), 10);
  let j:i32=0;
  while(j<60){
    let x:i32=r_mk_fact(W);
    if(x<0){ j=999; }
    j=j+1;
  }
  let nev:i32=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6A evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A post->0", ev_act(W), 0);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ses=r_mk_fact(W2); s1=r_mk_fact(W2); s2=r_mk_fact(W2);
  goal=r_mk_goal(W2,s2);
  g1=r_mk_guide(W2,s1,goal,10,80);
  pol_set(W2,goal);
  r_learn_confirm(W2,ses,g1);
  r_learn_confirm(W2,ses,goal);
  link_edge(W2,ses,6,s1,0);
  link_edge(W2,ses,9,ses,1);
  j=0;
  while(j<60){
    let x:i32=r_mk_fact(W2);
    if(x<0){ j=999; }
    j=j+1;
  }
  nev=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W2);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6B evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W2); ctx_push(W2,s1);
  ok=ok & r_ptest("P-ACT6B post s1->10", ev_act(W2), 10);
  return ok;
}
// ==== H5R2 SEALED DRIVER TEMPLATE (frozen pre-implementation; pure Zag) ====
// Sealed world driver template for lane TNN3H5R, wave-20261001-2321pdt.
// Seeds (chosen pre-freeze; SHA-256 inputs recorded in PREREG_H5R2.md):
//   s1=48984 (vo1=5), s2=59920 (vo2=0), s3=20822 (vo3=4), s4=29675 (vo4=2).
// World assembly: byte-copy of the frozen substrate tnn3_h5r2.zag with the
// single line `fn main()i32 { return run_all(); }` changed to
// `fn main()i32 { return sealed_main(); }`, plus this template appended,
// plus one alias line `fn sealed_main()i32 { return sealed_main_X(); }`
// selecting the world (X = c1, c2, w3a, w3b).
// Key ranges 83xxx-86xxx: disjoint from FW1-FW9 (3xxxx), the 1421pdt
// battery (43xxx), the killed H5 battery (51xxx-54xxx), the killed H5R
// battery (61xxx-65xxx, 71xxx-72xxx), and all smoke keys (7xxx/8xxx/9xxx).
// No OBSERVE on any MAP key in any world (frozen constraint).

// live tag-1 facts on (sm,rm)
fn h5r2_t1_live(W:[]u8,sm:i32,rm:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==sm && ng(W,n,24)==rm && is_superseded(W,n)==0){c=c+1;}
    n=n+1;
  }
  return c;
}
// live tag-20 MAPs on (sm,rm)
fn h5r2_map_live_n(W:[]u8,sm:i32,rm:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==sm && ng(W,n,4)==rm && is_superseded(W,n)==0){c=c+1;}
    n=n+1;
  }
  return c;
}
// id of the single live tag-20 MAP on (sm,rm); -1 unless exactly one
fn h5r2_map_live_id(W:[]u8,sm:i32,rm:i32)i32 {
  let id:i32=-1; let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==sm && ng(W,n,4)==rm && is_superseded(W,n)==0){id=n; c=c+1;}
    n=n+1;
  }
  if(c!=1){return -1;}
  return id;
}
// superseded tag-20 MAPs on (sm,rm)
fn h5r2_map_sup_n(W:[]u8,sm:i32,rm:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==sm && ng(W,n,4)==rm && is_superseded(W,n)==1){c=c+1;}
    n=n+1;
  }
  return c;
}
// superseded tag-20 MAPs anywhere (NC-1R2)
fn h5r2_map_con_all(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && is_superseded(W,n)==1){c=c+1;}
    n=n+1;
  }
  return c;
}
// MAP-key probe with full KB-W0 protocol. Returns the live MAP id on full
// pass, -1 on any failure. previd: live MAP id before the probe (-1 first).
fn h5r2_probe(W:[]u8,sm:i32,rm:i32,exp:i32,tag:[]u8,pn:[]u8,previd:i32)i32 {
  let t1in:i32=h5r2_t1_live(W,sm,rm);
  emit(tag); emit(" "); emit(pn); emit(" SNAP-IN t1live="); e64(t1in); emit("\n");
  let ok:i32=1;
  if(t1in!=0){emit(tag); emit(" "); emit(pn); emit(" W0-IN-FAIL\n"); ok=0;}
  let v:i32=ev_query(W,sm,rm,exp,0);
  let mc:i32=h5r2_map_live_n(W,sm,rm);
  let id:i32=h5r2_map_live_id(W,sm,rm);
  let f28:i32=-999999;
  if(id>=0){f28=ng(W,id,28);}
  emit(tag); emit(" "); emit(pn); emit(" Q v="); e64(v); emit(" exp="); e64(exp);
  emit(" livemap="); e64(mc); emit(" id="); e64(id); emit(" f28="); e64(f28); emit("\n");
  if(v!=exp){emit(tag); emit(" "); emit(pn); emit(" VAL-FAIL\n"); ok=0;}
  if(mc!=1 || f28!=v){emit(tag); emit(" "); emit(pn); emit(" W0-OUT-FAIL\n"); ok=0;}
  if(id<=previd){emit(tag); emit(" "); emit(pn); emit(" FRESH-FAIL prev="); e64(previd); emit("\n"); ok=0;}
  if(ok==1){emit(tag); emit(" "); emit(pn); emit(" W0 ok\n"); return id;}
  return -1;
}
// C-family double-contradiction probe
fn h5r2_c_double(W:[]u8,a:i32,b:i32,rf1:i32,rf2:i32,rm:i32,c0:i32,c1:i32,c2:i32,tag:[]u8)i32 {
  let ok:i32=1;
  ev_teach(W,a,rf1,b); ev_teach(W,b,rf2,c0);
  let id0:i32=h5r2_probe(W,a,rm,c0,tag,"P1",-1);
  if(id0<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  let id1:i32=h5r2_probe(W,a,rm,c1,tag,"P2",id0);
  if(id1<0){ok=0;} else {emit(tag); emit(" P2 B2R ok\n");}
  ev_observe(W,b,rf2,c2);
  let id2:i32=h5r2_probe(W,a,rm,c2,tag,"P3",id1);
  if(id2<0){ok=0;} else {emit(tag); emit(" P3 B2R ok\n");}
  if(h5r2_w2r(W,a,rm,c2,tag)==0){ok=0;}
  return ok;
}
// C-family revert probe
fn h5r2_c_revert(W:[]u8,a:i32,b:i32,rf1:i32,rf2:i32,rm:i32,c0:i32,c1:i32,tag:[]u8)i32 {
  let ok:i32=1;
  ev_teach(W,a,rf1,b); ev_teach(W,b,rf2,c0);
  let id0:i32=h5r2_probe(W,a,rm,c0,tag,"P1",-1);
  if(id0<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  let id1:i32=h5r2_probe(W,a,rm,c1,tag,"P2",id0);
  if(id1<0){ok=0;}
  ev_observe(W,b,rf2,c0);
  let id2:i32=h5r2_probe(W,a,rm,c0,tag,"P3",id1);
  if(id2<0){ok=0;}
  let b3:i32=1;
  if(id2<0 || id1<0 || id2<=id1 || id2<=id0){emit(tag); emit(" B3R-FRESH-FAIL\n"); b3=0;}
  if(id1>=0 && is_superseded(W,id1)!=1){emit(tag); emit(" B3R-C1CON-FAIL\n"); b3=0;}
  if(id2>=0 && ng(W,id2,28)!=c0){emit(tag); emit(" B3R-F28-FAIL\n"); b3=0;}
  if(b3==1){emit(tag); emit(" B3R ok\n");} else {ok=0;}
  if(h5r2_w2r(W,a,rm,c0,tag)==0){ok=0;}
  return ok;
}
// KB-W2R white-box check: exactly 2 superseded MAPs on the key, exactly 1
// live MAP with f28==fexp, every DEP (type-1) edge target live tag-1 non-superseded
fn h5r2_w2r(W:[]u8,sm:i32,rm:i32,fexp:i32,tag:[]u8)i32 {
  let ok:i32=1;
  let sup:i32=h5r2_map_sup_n(W,sm,rm);
  let id:i32=h5r2_map_live_id(W,sm,rm);
  emit(tag); emit(" W2R sup="); e64(sup); emit(" liveid="); e64(id); emit("\n");
  if(sup!=2){emit(tag); emit(" W2R-SUP-FAIL\n"); ok=0;}
  if(id<0){emit(tag); emit(" W2R-LIVE-FAIL\n"); ok=0;}
  if(id>=0){
    if(ng(W,id,28)!=fexp){emit(tag); emit(" W2R-F28-FAIL\n"); ok=0;}
    let e:i32=0; let dep:i32=0; let depok:i32=1;
    while(e<4096){
      if(eg(W,e,0)!=-1 && eg(W,e,0)==id && eg(W,e,4)==1){
        dep=dep+1;
        let t:i32=eg(W,e,8);
        emit(tag); emit(" W2R dep->"); e64(t); emit(" tag="); e64(ng(W,t,0));
        emit(" sup="); e64(is_superseded(W,t)); emit("\n");
        if(ng(W,t,36)!=1 || ng(W,t,0)!=1 || is_superseded(W,t)==1){depok=0;}
      }
      e=e+1;
    }
    if(dep<1 || depok==0){emit(tag); emit(" W2R-DEP-FAIL\n"); ok=0;}
  }
  if(ok==1){emit(tag); emit(" W2R ok\n");}
  return ok;
}
// W3-family chained probe: two successive revisions, then a revert.
// The revert must land on the latest fact.
fn h5r2_w3_chain(W:[]u8,a:i32,b:i32,rf1:i32,rf2:i32,rm:i32,c0:i32,c1:i32,c2:i32,tag:[]u8)i32 {
  let ok:i32=1;
  ev_teach(W,a,rf1,b); ev_teach(W,b,rf2,c0);
  let id0:i32=h5r2_probe(W,a,rm,c0,tag,"P1",-1);
  if(id0<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  let id1:i32=h5r2_probe(W,a,rm,c1,tag,"P2",id0);
  if(id1<0){ok=0;} else {emit(tag); emit(" P2 B3 ok\n");}
  ev_observe(W,b,rf2,c2);
  let id2:i32=h5r2_probe(W,a,rm,c2,tag,"P3",id1);
  if(id2<0){ok=0;} else {emit(tag); emit(" P3 B3 ok\n");}
  ev_observe(W,b,rf2,c0);
  let id3:i32=h5r2_probe(W,a,rm,c0,tag,"P4",id2);
  if(id3<0){ok=0;}
  let b3:i32=1;
  if(id3<0 || id2<0 || id3<=id2 || id3<=id1 || id3<=id0){emit(tag); emit(" B3-FRESH-FAIL\n"); b3=0;}
  if(id2>=0 && is_superseded(W,id2)!=1){emit(tag); emit(" B3-C2CON-FAIL\n"); b3=0;}
  if(id1>=0 && is_superseded(W,id1)!=1){emit(tag); emit(" B3-C1CON-FAIL\n"); b3=0;}
  if(id3>=0 && ng(W,id3,28)!=c0){emit(tag); emit(" B3-F28-FAIL\n"); b3=0;}
  if(b3==1){emit(tag); emit(" B3 ok\n");} else {ok=0;}
  if(h5r2_w3(W,a,rm,c0,tag)==0){ok=0;}
  return ok;
}
// KB-W3 white-box check: exactly 3 superseded MAPs on the key, exactly 1
// live MAP with f28==c0, every DEP edge target live tag-1 non-superseded
fn h5r2_w3(W:[]u8,sm:i32,rm:i32,fexp:i32,tag:[]u8)i32 {
  let ok:i32=1;
  let sup:i32=h5r2_map_sup_n(W,sm,rm);
  let id:i32=h5r2_map_live_id(W,sm,rm);
  emit(tag); emit(" W3 sup="); e64(sup); emit(" liveid="); e64(id); emit("\n");
  if(sup!=3){emit(tag); emit(" W3-SUP-FAIL\n"); ok=0;}
  if(id<0){emit(tag); emit(" W3-LIVE-FAIL\n"); ok=0;}
  if(id>=0){
    if(ng(W,id,28)!=fexp){emit(tag); emit(" W3-F28-FAIL\n"); ok=0;}
    let e:i32=0; let dep:i32=0; let depok:i32=1;
    while(e<4096){
      if(eg(W,e,0)!=-1 && eg(W,e,0)==id && eg(W,e,4)==1){
        dep=dep+1;
        let t:i32=eg(W,e,8);
        emit(tag); emit(" W3 dep->"); e64(t); emit(" tag="); e64(ng(W,t,0));
        emit(" sup="); e64(is_superseded(W,t)); emit("\n");
        if(ng(W,t,36)!=1 || ng(W,t,0)!=1 || is_superseded(W,t)==1){depok=0;}
      }
      e=e+1;
    }
    if(dep<1 || depok==0){emit(tag); emit(" W3-DEP-FAIL\n"); ok=0;}
  }
  if(ok==1){emit(tag); emit(" W3 ok\n");}
  return ok;
}
// canonical full state dump (KB-D1)
fn h5r2_dump(W:[]u8)void {
  emit("DUMP-BEGIN\n");
  let h:i32=0;
  while(h<64){ emit("H "); e64(h); emit(" "); e64(hg(W,h)); emit("\n"); h=h+4; }
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1){
      emit("N "); e64(n);
      let f:i32=0;
      while(f<=36){ emit(" "); e64(ng(W,n,f)); f=f+4; }
      emit("\n");
    }
    n=n+1;
  }
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      emit("E "); e64(eg(W,e,0)); emit(" "); e64(eg(W,e,4));
      emit(" "); e64(eg(W,e,8)); emit(" "); e64(eg(W,e,12)); emit("\n");
    }
    e=e+1;
  }
  emit("DUMP-END\n");
  return;
}
// world w_c1 (C-family). Chain relations 8301/8302, MAP relation 8303.
// Four double-contradiction probes and two revert probes. vo1=5.
fn sealed_main_c1()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(h5r2_c_double(W,83101,83301,8301,8302,8303,83406,83407,83408,"C1D1")==0){ok=0;}
  if(h5r2_c_double(W,83102,83302,8301,8302,8303,83416,83417,83418,"C1D2")==0){ok=0;}
  if(h5r2_c_double(W,83103,83303,8301,8302,8303,83426,83427,83428,"C1D3")==0){ok=0;}
  if(h5r2_c_double(W,83104,83304,8301,8302,8303,83436,83437,83438,"C1D4")==0){ok=0;}
  if(h5r2_c_revert(W,83201,83311,8301,8302,8303,83506,83507,"C1R1")==0){ok=0;}
  if(h5r2_c_revert(W,83202,83312,8301,8302,8303,83516,83517,"C1R2")==0){ok=0;}
  let mc:i32=h5r2_map_con_all(W);
  emit("C1 MAPCON-ALL="); e64(mc); emit("\n");
  if(mc<1){emit("C1 NC-1R2-FAIL\n"); ok=0;}
  if(ok==1){emit("C1 DONE-OK\n");} else {emit("C1 DONE-FAIL\n");}
  h5r2_dump(W);
  return ok;
}

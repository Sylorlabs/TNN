// world e2: chain 9001/9002, MAP 9003, b-decoy 9004, a-decoy 9005. vo=0.
fn sealed_main_e2()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;

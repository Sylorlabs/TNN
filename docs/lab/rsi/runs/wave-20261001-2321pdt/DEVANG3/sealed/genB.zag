// genB.zag: FRESH sealed Family B generator for DEVANG3 wave-20261001-2321pdt.
// Deterministic. Pure Zag. Emits 12 utterances (stdout).
// Anchors: tak, not, blu, grn, bal, cub, tri, big, biger (Family A words).
// Novels: kir(3), kira(4), tem(3), tema(4), temo(4), tira(4), mira(4).
// Prefix pairs (>=2): (kir,kira), (tem,tema), (tem,temo), (tema,temo).
// Suffix pairs (>=2): (kira,tira), (kira,mira), (tira,mira) share "ira".
// Ground truth (1-based segment end offsets, excluding utterance end):
//  1 takkir -> 3
//  2 notkira -> 3
//  3 blutemtri -> 3,6
//  4 grntirabal -> 3,7
//  5 taktemobal -> 3,7
//  6 notmiragrn -> 3,7
//  7 takbigerkira -> 3,8
//  8 cubtemtri -> 3,6
//  9 blukirabal -> 3,7
// 10 taktemagrn -> 3,7
// 11 notkirbal -> 3,6
// 12 grntemocub -> 3,7

fn emit(s:[]u8)void { _zag_print(s); return; }

fn main()i32 {
  emit("takkir\n");
  emit("notkira\n");
  emit("blutemtri\n");
  emit("grntirabal\n");
  emit("taktemobal\n");
  emit("notmiragrn\n");
  emit("takbigerkira\n");
  emit("cubtemtri\n");
  emit("blukirabal\n");
  emit("taktemagrn\n");
  emit("notkirbal\n");
  emit("grntemocub\n");
  return 0;
}

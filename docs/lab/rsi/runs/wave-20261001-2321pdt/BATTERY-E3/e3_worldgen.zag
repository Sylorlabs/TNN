// e3_worldgen.zag -- E3 sealed world generator. Pure Zag.
// Emits the exact byte streams frozen in PREREG_E3.md section 1.
// No cognition, no semantic cases, no modes: fixed strings only.
// Writes: e3_worlds/e3a_blind.txt, e3_worlds/e3b_blind.txt,
//         e3_worlds/e3a_oracle.txt, e3_worlds/e3b_oracle.txt,
//         e3_oracles/e3a.oracle, e3_oracles/e3b.oracle

fn wput(path:[]u8, content:[]u8)i32 {
  if(_zag_write_file(path, content)!=0){ return 1; }
  return 0;
}

fn main()i32 {
  let a_blind:[]u8="OBSERVE 80201 80611 80911\nOBSERVE 80202 80611 80912\nOBSERVE 80911 80612 80921\nOBSERVE 80912 80612 80922\nOBSERVE 80201 80613 80931\nOBSERVE 80202 80613 80932\nQUERY 80201 80619\nQUERY 80202 80619\nQUERY 80201 80629\nQUERY 80202 80629\n";
  let b_blind:[]u8="OBSERVE 80301 80631 80961\nOBSERVE 80961 80632 80971\nOBSERVE 80302 80631 80962\nOBSERVE 80962 80632 80972\nOBSERVE 80301 80611 80911\nOBSERVE 80911 80612 80921\nOBSERVE 80302 80611 80912\nOBSERVE 80912 80612 80922\nQUERY 80301 80619\nQUERY 80302 80619\n";
  let a_oracle:[]u8="OBSERVE 80201 80611 80911\nOBSERVE 80202 80611 80912\nOBSERVE 80911 80612 80921\nOBSERVE 80912 80612 80922\nOBSERVE 80201 80613 80931\nOBSERVE 80202 80613 80932\nQUERY 80201 80619 80921\nQUERY 80202 80619 80922\nQUERY 80201 80629 -2\nQUERY 80202 80629 -2\n";
  let b_oracle:[]u8="OBSERVE 80301 80631 80961\nOBSERVE 80961 80632 80971\nOBSERVE 80302 80631 80962\nOBSERVE 80962 80632 80972\nOBSERVE 80301 80611 80911\nOBSERVE 80911 80612 80921\nOBSERVE 80302 80611 80912\nOBSERVE 80912 80612 80922\nQUERY 80301 80619 80921\nQUERY 80302 80619 80922\n";
  let a_sealed:[]u8="80921\n80922\n-2\n-2\n";
  let b_sealed:[]u8="80921\n80922\n";
  let bad:i32=0;
  bad=bad+wput("e3_worlds/e3a_blind.txt", a_blind);
  bad=bad+wput("e3_worlds/e3b_blind.txt", b_blind);
  bad=bad+wput("e3_worlds/e3a_oracle.txt", a_oracle);
  bad=bad+wput("e3_worlds/e3b_oracle.txt", b_oracle);
  bad=bad+wput("e3_oracles/e3a.oracle", a_sealed);
  bad=bad+wput("e3_oracles/e3b.oracle", b_sealed);
  if(bad!=0){ return 1; }
  return 0;
}

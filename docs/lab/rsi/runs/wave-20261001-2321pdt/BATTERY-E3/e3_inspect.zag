// e3_inspect.zag -- E3 white-box inspector. Pure Zag. Read-only probe.
// Usage: e3_inspect_bin <state.bin> <subject> <relation>
// Finds type-20 MAP nodes keyed (subject, relation), prints the node,
// its graph root, and walks the executable graph (SEQ edges plus
// BRANCHEQ true-targets), then lists ET_DEP licensing edges from each
// SETREG cell to taught fact nodes. Evidence for prereg criterion
// (ii): constructed and used. Reads the frozen state layout only;
// contains no cognition.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn e64(v:i32)void {
  let r:[]u8=_zag_i64_to_str(v as i64);
  if(r.len>0 && r[r.len-1]==10){ emit(r[0..r.len-1]); } else { emit(r); }
  return;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn noff(n:i32)i32 { return 64+n*40; }
fn eoff(e:i32)i32 { return 41024+e*16; }
fn ng(W:[]u8,n:i32,f:i32)i32 { return get32(W,noff(n)+f); }
fn eg(W:[]u8,e:i32,f:i32)i32 { return get32(W,eoff(e)+f); }
fn seq_nx(W:[]u8,c:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==12 && eg(W,e,0)==c){ return eg(W,e,8); }
    e=e+1;
  }
  return -1;
}
fn tagname(t:i32)[]u8 {
  if(t==101){ return "SETREG"; }
  if(t==102){ return "GUARD"; }
  if(t==103){ return "INC"; }
  if(t==104){ return "DEC"; }
  return "OTHER";
}

fn main()i32 {
  if(_zag_argc()!=4){ _zag_eprintln("usage: e3_inspect_bin <state.bin> <subject> <relation>"); return 2; }
  let sp:[]u8=_zag_arg(1);
  if(_zag_file_exists(sp)==0){ _zag_eprintln("state missing"); return 2; }
  let sb:[]u8=_zag_read_file(sp);
  if(_zag_strlen(sb)!=110656){ _zag_eprintln("state corrupt"); return 2; }
  let W:[]u8=sb;
  // parse subject and relation from argv (decimal, non-negative)
  let a2:[]u8=_zag_arg(2);
  let a3:[]u8=_zag_arg(3);
  let subj:i32=0; let i:i32=0;
  while(i<_zag_strlen(a2)){ subj=subj*10+(a2[i] as i32-48); i=i+1; }
  let rel:i32=0; i=0;
  while(i<_zag_strlen(a3)){ rel=rel*10+(a3[i] as i32-48); i=i+1; }
  let found:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==subj && ng(W,n,4)==rel){
      found=found+1;
      emit("MAP node="); e64(n);
      emit(" root="); e64(ng(W,n,20));
      emit(" promo="); e64(ng(W,n,24));
      emit(" ans="); e64(ng(W,n,28)); emit("\n");
      let cur:i32=ng(W,n,20);
      let steps:i32=0;
      while(cur>=0 && steps<32){
        let tag:i32=ng(W,cur,0);
        if(tag!=101 && tag!=102 && tag!=103 && tag!=104){ steps=99; }
        else {
          emit("  cell "); e64(cur); emit(" "); emit(tagname(tag));
          if(tag==101 || tag==102){
            let ln:i32=ng(W,cur,8);
            let lv:i32=-1;
            if(ln>=0 && ln<1024){ lv=ng(W,ln,20); }
            emit(" lit_node="); e64(ln); emit(" lit_val="); e64(lv);
          }
          emit("\n");
          // ET_DEP licensing edges from SETREG cells to fact nodes
          if(tag==101){
            let e:i32=0;
            while(e<4096){
              if(eg(W,e,0)!=-1 && eg(W,e,4)==1 && eg(W,e,0)==cur){
                let fn2:i32=eg(W,e,8);
                emit("    DEP-> fact node="); e64(fn2);
                emit(" ("); e64(ng(W,fn2,20)); emit(" ");
                e64(ng(W,fn2,24)); emit(" "); e64(ng(W,fn2,28)); emit(")\n");
              }
              e=e+1;
            }
          }
          if(tag==102){ cur=ng(W,cur,12); } else { cur=seq_nx(W,cur); }
          steps=steps+1;
        }
      }
    }
    n=n+1;
  }
  emit("MAPS_FOUND "); e64(found); emit("\n");
  return 0;
}

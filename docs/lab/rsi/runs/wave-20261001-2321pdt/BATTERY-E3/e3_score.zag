// e3_score.zag -- E3 scorer. Pure Zag. Scorer-side only.
// Usage: e3_score_bin <transcript> <oracle>
// Compares transcript ANSWER values (in order) against the sealed
// oracle integers (in order). Prints per-probe results and totals.
// Returns 0 iff every probe matches.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn e64(v:i32)void {
  let r:[]u8=_zag_i64_to_str(v as i64);
  if(r.len>0 && r[r.len-1]==10){ emit(r[0..r.len-1]); } else { emit(r); }
  return;
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn main()i32 {
  if(_zag_argc()!=3){ _zag_eprintln("usage: e3_score_bin <transcript> <oracle>"); return 2; }
  let tp:[]u8=_zag_arg(1);
  let op:[]u8=_zag_arg(2);
  if(_zag_file_exists(tp)==0 || _zag_file_exists(op)==0){ _zag_eprintln("input missing"); return 2; }
  let t:[]u8=_zag_read_file(tp);
  let o:[]u8=_zag_read_file(op);
  let tn:i32=_zag_strlen(t);
  let on:i32=_zag_strlen(o);
  // collect oracle ints in order
  let wp:*u8=_zag_malloc(64*4) as *u8;
  let want:[]u8=wp[0..256];
  let nw:i32=0;
  let s:i32=0;
  while(s<on && nw<64){
    let le:i32=line_end(o,s,on);
    let fs:i32=skip_ws(o,s,le);
    if(fs<le){
      let fe:i32=field_end(o,fs,le);
      if(is_int(o,fs,fe)==1){
        let vv:i32=parse_i32(o,fs,fe);
        want[nw*4]=vv as u8; want[nw*4+1]=(vv>>8) as u8; want[nw*4+2]=(vv>>16) as u8; want[nw*4+3]=(vv>>24) as u8;
        nw=nw+1;
      }
    }
    s=le+1;
  }
  // walk transcript ANSWER lines in order
  let np:i32=0; let ok:i32=0; let oi:i32=0;
  s=0;
  while(s<tn){
    let le:i32=line_end(t,s,tn);
    let fs:i32=skip_ws(t,s,le);
    if(fs+6<le && t[fs]==65 && t[fs+1]==78 && t[fs+2]==83 && t[fs+3]==87 && t[fs+4]==69 && t[fs+5]==82){
      let f1s:i32=skip_ws(t,field_end(t,fs,le),le);
      let f1e:i32=field_end(t,f1s,le);
      let f2s:i32=skip_ws(t,f1e,le);
      let f2e:i32=field_end(t,f2s,le);
      let f3s:i32=skip_ws(t,f2e,le);
      let f3e:i32=field_end(t,f3s,le);
      let got:i32=-999998;
      if(is_int(t,f3s,f3e)==1){ got=parse_i32(t,f3s,f3e); }
      let wv:i32=-999997;
      if(oi<nw){
        wv=(want[oi*4] as i32)|((want[oi*4+1] as i32)<<8)|((want[oi*4+2] as i32)<<16)|((want[oi*4+3] as i32)<<24);
      }
      emit("PROBE "); e64(np); emit(": got "); e64(got); emit(" want "); e64(wv);
      if(got==wv){ emit(" PASS\n"); ok=ok+1; } else { emit(" FAIL\n"); }
      np=np+1; oi=oi+1;
    }
    s=le+1;
  }
  emit("SCORE "); e64(ok); emit("/"); e64(np); emit("\n");
  if(np!=nw){ emit("COUNT-MISMATCH\n"); return 1; }
  if(ok==np){ return 0; }
  return 1;
}

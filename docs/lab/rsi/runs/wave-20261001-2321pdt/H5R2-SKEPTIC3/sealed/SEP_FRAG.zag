// ==== H5R2-SKEPTIC3 SEPARATOR FRAGMENT (frozen post-prereg; pure Zag) ====
// Separator world family for lane H5R2-SKEPTIC3, wave-20261001-2321pdt.
// Appended after the frozen DRIVER_TMPL.zag; uses its helpers
// (h5r2_map_live_n, h5r2_map_live_id, h5r2_map_con_all, h5r2_dump) and
// the substrate (ev_teach, ev_query, is_superseded, emit, e64, z_alloc,
// WSZ, tnn2_init).
// Per separator probe: teach chain link, teach the b-link key TWICE
// (re-teach path: ev_teach never supersedes, so both facts stay live),
// white-box SC-4 two-live check, separator query with flags=1
// (masked=1: the E-ruling, expected is post-hoc feedback only; the
// candidate-selection policy, not the verifier, decides the anchor),
// arm-neutral SEP-check on the live MAP. No OBSERVE on any key in any
// separator world. Key ranges 91xxx-92xxx.

// id of the single live tag-1 fact on (sm,rm); -1 unless exactly one
fn sep_fact_live_id(W:[]u8,sm:i32,rm:i32)i32 {
  let id:i32=-1; let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==sm && ng(W,n,24)==rm && is_superseded(W,n)==0){id=n; c=c+1;}
    n=n+1;
  }
  if(c!=1){return -1;}
  return id;
}
// SC-4: exactly two live tag-1 non-superseded facts on (sm,rm), with
// objects o_old on the older id and o_new on the newer id. Returns the
// older id on pass, -1 on fail (SEP-TWOLIVE-FAIL).
fn sep_two_live_old(W:[]u8,sm:i32,rm:i32,o_old:i32,o_new:i32,tag:[]u8)i32 {
  let id0:i32=-1; let id1:i32=-1; let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==sm && ng(W,n,24)==rm && is_superseded(W,n)==0){
      if(c==0){id0=n;} else {if(c==1){id1=n;}}
      c=c+1;
    }
    n=n+1;
  }
  emit(tag); emit(" TWOLIVE n="); e64(c);
  emit(" old="); e64(id0); emit(" new="); e64(id1); emit("\n");
  if(c!=2 || id0<0 || id1<0){emit(tag); emit(" SEP-TWOLIVE-FAIL\n"); return -1;}
  if(ng(W,id0,28)!=o_old || ng(W,id1,28)!=o_new){emit(tag); emit(" SEP-TWOLIVE-FAIL\n"); return -1;}
  emit(tag); emit(" SEP-TWOLIVE ok\n");
  return id0;
}
// the live tag-1 fact on (sm,rm) other than oldid; -1 unless exactly one
fn sep_fact_newer(W:[]u8,sm:i32,rm:i32,oldid:i32)i32 {
  let id:i32=-1; let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==sm && ng(W,n,24)==rm && is_superseded(W,n)==0 && n!=oldid){id=n; c=c+1;}
    n=n+1;
  }
  if(c!=1){return -1;}
  return id;
}
// One separator probe: re-teach path, SC-4 check, masked query,
// arm-neutral SEP-check. Returns 1 iff every conjunct passes.
fn sep_probe(W:[]u8,a:i32,b:i32,rf1:i32,rf2:i32,rm:i32,c_old:i32,c_new:i32,tag:[]u8)i32 {
  ev_teach(W,a,rf1,b);
  ev_teach(W,b,rf2,c_old);
  ev_teach(W,b,rf2,c_new);
  let f_old:i32=sep_two_live_old(W,b,rf2,c_old,c_new,tag);
  if(f_old<0){return 0;}
  let f_new:i32=sep_fact_newer(W,b,rf2,f_old);
  if(f_new<0){emit(tag); emit(" SEP-TWOLIVE-FAIL\n"); return 0;}
  let f_ab:i32=sep_fact_live_id(W,a,rf1);
  if(f_ab<0){emit(tag); emit(" SEP-AB-FAIL\n"); return 0;}
  let v:i32=ev_query(W,a,rm,-2,1);
  let id:i32=h5r2_map_live_id(W,a,rm);
  let mc:i32=h5r2_map_live_n(W,a,rm);
  let f28:i32=-999999;
  if(id>=0){f28=ng(W,id,28);}
  emit(tag); emit(" Q v="); e64(v);
  emit(" livemap="); e64(mc); emit(" id="); e64(id); emit(" f28="); e64(f28); emit("\n");
  if(v==-2){emit(tag); emit(" SEP-MISS\n"); return 0;}
  if(mc!=1 || id<0){emit(tag); emit(" SEP-MAP-FAIL\n"); return 0;}
  let e:i32=0; let dep:i32=0; let depok:i32=1; let abhit:i32=0; let anchor:i32=-1;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==id && eg(W,e,4)==1){
      dep=dep+1;
      let t:i32=eg(W,e,8);
      emit(tag); emit(" SEP dep->"); e64(t);
      emit(" tag="); e64(ng(W,t,0)); emit(" o="); e64(ng(W,t,28));
      emit(" sup="); e64(is_superseded(W,t)); emit("\n");
      if(ng(W,t,36)!=1 || ng(W,t,0)!=1 || is_superseded(W,t)==1){depok=0;}
      if(t==f_ab){abhit=1;}
      else {if(t==f_old || t==f_new){anchor=t;} else {depok=0;}}
    }
    e=e+1;
  }
  if(dep!=2 || depok==0 || abhit==0 || anchor<0){emit(tag); emit(" SEP-DEP-FAIL\n"); return 0;}
  if(f28!=v){emit(tag); emit(" SEP-VAL-FAIL\n"); return 0;}
  if(anchor==f_old && f28==c_old && v==c_old){emit(tag); emit(" SEP-OLD\n");}
  else {
    if(anchor==f_new && f28==c_new && v==c_new){emit(tag); emit(" SEP-NEW\n");}
    else {emit(tag); emit(" SEP-VAL-FAIL\n"); return 0;}
  }
  emit(tag); emit(" SEP ok\n");
  return 1;
}
// world s1: chain 9101/9102, MAP 9103. vo=2.
fn sealed_main_s1()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(sep_probe(W,91101,91301,9101,9102,9103,91403,91404,"S1P1")==0){ok=0;}
  if(sep_probe(W,91102,91302,9101,9102,9103,91413,91414,"S1P2")==0){ok=0;}
  if(sep_probe(W,91103,91303,9101,9102,9103,91423,91424,"S1P3")==0){ok=0;}
  if(sep_probe(W,91104,91304,9101,9102,9103,91433,91434,"S1P4")==0){ok=0;}
  let mc:i32=h5r2_map_con_all(W);
  emit("S1 MAPCON-ALL="); e64(mc); emit("\n");
  if(mc!=0){emit("S1 NC-CON-FAIL\n"); ok=0;}
  if(ok==1){emit("S1 DONE-OK\n");} else {emit("S1 DONE-FAIL\n");}
  h5r2_dump(W);
  return ok;
}
// world s2: chain 9201/9202, MAP 9203. vo=6.
// Materially different relation family and subject distribution from s1.
fn sealed_main_s2()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(sep_probe(W,92101,92301,9201,9202,9203,92407,92408,"S2P1")==0){ok=0;}
  if(sep_probe(W,92102,92302,9201,9202,9203,92417,92418,"S2P2")==0){ok=0;}
  if(sep_probe(W,92103,92303,9201,9202,9203,92427,92428,"S2P3")==0){ok=0;}
  if(sep_probe(W,92104,92304,9201,9202,9203,92437,92438,"S2P4")==0){ok=0;}
  let mc:i32=h5r2_map_con_all(W);
  emit("S2 MAPCON-ALL="); e64(mc); emit("\n");
  if(mc!=0){emit("S2 NC-CON-FAIL\n"); ok=0;}
  if(ok==1){emit("S2 DONE-OK\n");} else {emit("S2 DONE-FAIL\n");}
  h5r2_dump(W);
  return ok;
}

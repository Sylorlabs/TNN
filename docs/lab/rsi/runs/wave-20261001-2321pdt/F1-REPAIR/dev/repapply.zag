// repapply.zag - frozen decision-rule applier (F1-REPAIR lane).
// Reads a per-seed table with lines:
//   SEED <i> <label> DEG=<d> S=<s> TRIG=<t> NREP=<n>
// where label is CORRECT or OVERFIT, and applies exactly the frozen
// decision rule from PREREG_REPAIR.md section 3 (conditioned primary
// on the degenerate-path subset D, plus the secondary unconditional
// numbers). Prints per-seed rows, the D-subset contingency, the
// counterexample pairs, and the verdict.
// usage: repapply <tablefile>
// Pure Zag, compiled by the pinned znc.

fn ra_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn ra_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn ra_starts(line:[]u8, pre:[]u8)i64 {
    if(line.len < pre.len) { return 0; }
    let i:i64 = 0;
    while(i < pre.len) {
        if(line[i] != pre[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn ra_eq(a:[]u8, b:[]u8)i64 {
    if(a.len != b.len) { return 0; }
    let i:i64 = 0;
    while(i < a.len) {
        if(a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn ra_after_eq(tok:[]u8)i64 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return 0; }
    return _zag_str_to_i64(tok[p+1..tok.len]);
}

fn main()i32 {
    if(_zag_argc() < 2) { _zag_println("usage: repapply <tablefile>"); return 2; }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { _zag_println("ERR read"); return 2; }

    let p1:*u8 = _zag_malloc(24) as *u8;
    let p2:*u8 = _zag_malloc(24) as *u8;
    let p3:*u8 = _zag_malloc(24) as *u8;
    let p4:*u8 = _zag_malloc(24) as *u8;
    let p5:*u8 = _zag_malloc(24) as *u8;
    if(p1 == null as *u8 || p2 == null as *u8 || p3 == null as *u8 || p4 == null as *u8 || p5 == null as *u8) {
        _zag_println("ERR alloc");
        return 2;
    }
    let didx:[]u8 = p1[0..24];
    let dsv:[]u8 = p2[0..24];
    let dlb:[]u8 = p3[0..24];
    let alls:[]u8 = p4[0..24];
    let alll:[]u8 = p5[0..24];

    let n:i64 = 0;
    let d:i64 = 0;
    let d_s1:i64 = 0;
    let d_s0:i64 = 0;
    let d_s1_overfit:i64 = 0;
    let m_uncond:i64 = 0;
    let parsefail:i64 = 0;

    let i:i64 = 0;
    while(i < text.len) {
        let q:i64 = i;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[i..q];
        if(q < text.len) { q = q + 1; }
        i = q;
        if(line.len == 0) { continue; }
        if(ra_starts(line, "SEED ") == 0 || ra_ntok(line) < 7) { parsefail = 1; continue; }
        let si:i64 = _zag_str_to_i64(ra_tok(line, 1));
        let labtok:[]u8 = ra_tok(line, 2);
        let lab:i64 = -1;
        if(ra_eq(labtok, "CORRECT") == 1) { lab = 0; }
        if(ra_eq(labtok, "OVERFIT") == 1) { lab = 1; }
        let deg:i64 = ra_after_eq(ra_tok(line, 3));
        let s:i64 = ra_after_eq(ra_tok(line, 4));
        if(lab < 0 || (deg != 0 && deg != 1) || (s != 0 && s != 1) || si < 0 || si > 23) {
            parsefail = 1;
            continue;
        }
        // unconditional prediction: CORRECT iff S=1
        let pred:i64 = 0;
        if(s == 1) { pred = 0; } else { pred = 1; }
        let hit:i64 = 0;
        if(pred == lab) { hit = 1; } else { m_uncond = m_uncond + 1; }
        _zag_print("SEEDROW ");
        _zag_print(_zag_i64_to_str(si));
        _zag_print(" lab=");
        if(lab == 0) { _zag_print("CORRECT"); } else { _zag_print("OVERFIT"); }
        _zag_print(" deg=");
        _zag_print(_zag_i64_to_str(deg));
        _zag_print(" S=");
        _zag_print(_zag_i64_to_str(s));
        _zag_print(" pred=");
        if(pred == 0) { _zag_print("CORRECT"); } else { _zag_print("OVERFIT"); }
        _zag_print(" hit=");
        _zag_println(_zag_i64_to_str(hit));

        if(n < 24) { alls[n] = s as u8; alll[n] = lab as u8; }
        n = n + 1;
        if(deg == 1 && d < 24) {
            didx[d] = si as u8;
            dsv[d] = s as u8;
            dlb[d] = lab as u8;
            d = d + 1;
            if(s == 1) {
                d_s1 = d_s1 + 1;
                if(lab == 1) { d_s1_overfit = d_s1_overfit + 1; }
            } else {
                d_s0 = d_s0 + 1;
            }
        }
    }

    if(parsefail == 1) { _zag_println("REPSUM PARSEFAIL"); return 0; }

    // counterexample pairs within D: same S, different labels
    let npairs:i64 = 0;
    let p6:*u8 = _zag_malloc(256) as *u8;
    if(p6 == null as *u8) { _zag_println("ERR alloc"); return 2; }
    let pairbuf:[]u8 = p6[0..256];
    let paircur:i64 = 0;
    let a:i64 = 0;
    while(a < d) {
        let b:i64 = a + 1;
        while(b < d) {
            if(dsv[a] == dsv[b] && dlb[a] != dlb[b]) {
                npairs = npairs + 1;
                if(npairs <= 8) {
                    let sa:[]u8 = _zag_i64_to_str(didx[a] as i64);
                    let sb:[]u8 = _zag_i64_to_str(didx[b] as i64);
                    let k:i64 = 0;
                    while(k < sa.len && paircur < 250) { pairbuf[paircur] = sa[k]; paircur = paircur + 1; k = k + 1; }
                    if(paircur < 251) { pairbuf[paircur] = 45; paircur = paircur + 1; }
                    k = 0;
                    while(k < sb.len && paircur < 250) { pairbuf[paircur] = sb[k]; paircur = paircur + 1; k = k + 1; }
                    if(paircur < 251) { pairbuf[paircur] = 44; paircur = paircur + 1; }
                }
            }
            b = b + 1;
        }
        a = a + 1;
    }

    // unconditional counterexample pairs (all 24): same S, different labels
    let upairs:i64 = 0;
    let c:i64 = 0;
    while(c < n) {
        let e:i64 = c + 1;
        while(e < n) {
            if(alls[c] == alls[e] && alll[c] != alll[e]) { upairs = upairs + 1; }
            e = e + 1;
        }
        c = c + 1;
    }

    _zag_print("REPSUM n=");
    _zag_print(_zag_i64_to_str(n));
    _zag_print(" D=");
    _zag_print(_zag_i64_to_str(d));
    _zag_print(" D_S1=");
    _zag_print(_zag_i64_to_str(d_s1));
    _zag_print(" D_S0=");
    _zag_print(_zag_i64_to_str(d_s0));
    _zag_print(" D_S1_OVF=");
    _zag_print(_zag_i64_to_str(d_s1_overfit));
    _zag_print(" pairs=");
    _zag_print(_zag_i64_to_str(npairs));
    _zag_print(" upairs=");
    _zag_print(_zag_i64_to_str(upairs));
    _zag_print(" M_uncond=");
    _zag_println(_zag_i64_to_str(m_uncond));

    _zag_print("PAIRS ");
    _zag_println(pairbuf[0..paircur]);

    // frozen decision rule, PREREG_REPAIR.md section 3
    if(d < 6) {
        _zag_println("VERDICT REPAIR-INDETERMINATE underpowered D<6");
    } else if(d_s1 < 2 || d_s0 < 2) {
        _zag_println("VERDICT REPAIR-INDETERMINATE signature-value-unattested");
    } else if(npairs > 0) {
        _zag_println("VERDICT GREEDY-CONFIRMED");
    } else if(d_s1_overfit == 0) {
        _zag_println("VERDICT REPAIR-CONFIRMED");
    } else {
        _zag_println("VERDICT REPAIR-INDETERMINATE inversion");
    }
    return 0;
}

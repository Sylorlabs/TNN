// repsig.zag - repair-burst signature extractor (F1-REPAIR lane).
// Reads one f1_learn train trace and reports, in pure trace terms:
//   - T1: episode of the first TRIGGER line
//   - deg: 1 iff the first-trigger burst's second construct is degenerate
//     (c0 = ADD r0,f,f doubling one feature; c1 = ADD r0,*,* adding no
//     complementary feature), else 0
//   - S: 1 iff at least one REPAIR-BURST event exists: a TRIGGER at t > T1
//     with buf=8 whose burst holds >= 1 CONSTRUCT and whose last CONSTRUCT
//     has err_after=0, else 0
// usage: repsig <train.trace>
// Output (one line):
//   REPSIG trig=<t1> deg=<d> S=<s> nrep=<n> reps=<e1,e2,> c0=<p2>,<p3> c1=<p1>,<p2>,<p3>
// If no TRIGGER line exists: REPSIG NOTRIG.
// If a TRIGGER/CONSTRUCT line fails the frozen grammar: REPSIG PARSEFAIL.
// Pure Zag, compiled by the pinned znc. External probe; no learner logic.

fn rs_ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn rs_tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn rs_starts(line:[]u8, pre:[]u8)i64 {
    if(line.len < pre.len) { return 0; }
    let i:i64 = 0;
    while(i < pre.len) {
        if(line[i] != pre[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn rs_eq(a:[]u8, b:[]u8)i64 {
    if(a.len != b.len) { return 0; }
    let i:i64 = 0;
    while(i < a.len) {
        if(a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn rs_after_eq(tok:[]u8)i64 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return 0; }
    return _zag_str_to_i64(tok[p+1..tok.len]);
}

fn rs_after_eq_s(tok:[]u8)[]u8 {
    let p:i64 = 0;
    while(p < tok.len && tok[p] != 61) { p = p + 1; }
    if(p >= tok.len) { return ""; }
    return tok[p+1..tok.len];
}

fn main()i32 {
    if(_zag_argc() < 2) { _zag_println("usage: repsig <train.trace>"); return 2; }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { _zag_println("ERR read"); return 2; }

    let t1:i64 = -1;
    let cur_ep:i64 = -1;
    let cur_buf:i64 = 0;
    let cur_ncon:i64 = 0;
    let cur_last_err:i64 = -1;
    let first_ncon:i64 = 0;
    let c0add:i64 = 0;
    let c0p2:i64 = -1;
    let c0p3:i64 = -1;
    let c1add:i64 = 0;
    let c1p1:i64 = -1;
    let c1p2:i64 = -1;
    let c1p3:i64 = -1;
    let rep_count:i64 = 0;
    let parsefail:i64 = 0;

    // repair-episode list as text, appended in chronological order
    let p:*u8 = _zag_malloc(256) as *u8;
    if(p == null as *u8) { _zag_println("ERR alloc"); return 2; }
    let repbuf:[]u8 = p[0..256];
    let repcur:i64 = 0;

    let i:i64 = 0;
    while(i < text.len) {
        let q:i64 = i;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[i..q];
        if(q < text.len) { q = q + 1; }
        i = q;

        if(rs_starts(line, "TRIGGER ") == 1) {
            if(rs_ntok(line) < 5) { parsefail = 1; }
            else {
                // finalize the open burst before starting a new one
                if(cur_ep >= 0 && cur_ep > t1 && cur_buf == 8 && cur_ncon >= 1 && cur_last_err == 0) {
                    let es:[]u8 = _zag_i64_to_str(cur_ep);
                    let k:i64 = 0;
                    while(k < es.len && repcur < 254) { repbuf[repcur] = es[k]; repcur = repcur + 1; k = k + 1; }
                    if(repcur < 255) { repbuf[repcur] = 44; repcur = repcur + 1; }
                    rep_count = rep_count + 1;
                }
                cur_ep = -1;
                let t:i64 = _zag_str_to_i64(rs_tok(line, 1));
                let b:i64 = rs_after_eq(rs_tok(line, 4));
                if(t1 < 0) { t1 = t; }
                cur_ep = t;
                cur_buf = b;
                cur_ncon = 0;
                cur_last_err = -1;
            }
        } else if(rs_starts(line, "CONSTRUCT ") == 1) {
            if(rs_ntok(line) < 11) { parsefail = 1; }
            else {
                let ep:i64 = _zag_str_to_i64(rs_tok(line, 1));
                let op:[]u8 = rs_after_eq_s(rs_tok(line, 5));
                let p1:i64 = rs_after_eq(rs_tok(line, 6));
                let p2:i64 = rs_after_eq(rs_tok(line, 7));
                let p3:i64 = rs_after_eq(rs_tok(line, 8));
                let erra:i64 = rs_after_eq(rs_tok(line, 10));
                if(cur_ep >= 0 && ep == cur_ep) {
                    cur_ncon = cur_ncon + 1;
                    cur_last_err = erra;
                    if(ep == t1) {
                        if(first_ncon == 0) {
                            c0add = rs_eq(op, "ADD");
                            c0p2 = p2;
                            c0p3 = p3;
                        } else if(first_ncon == 1) {
                            c1add = rs_eq(op, "ADD");
                            c1p1 = p1;
                            c1p2 = p2;
                            c1p3 = p3;
                        }
                        first_ncon = first_ncon + 1;
                    }
                } else {
                    // orphan construct: close the open burst, ignore it
                    if(cur_ep >= 0 && cur_ep > t1 && cur_buf == 8 && cur_ncon >= 1 && cur_last_err == 0) {
                        let es:[]u8 = _zag_i64_to_str(cur_ep);
                        let k:i64 = 0;
                        while(k < es.len && repcur < 254) { repbuf[repcur] = es[k]; repcur = repcur + 1; k = k + 1; }
                        if(repcur < 255) { repbuf[repcur] = 44; repcur = repcur + 1; }
                        rep_count = rep_count + 1;
                    }
                    cur_ep = -1;
                }
            }
        } else {
            // any other line closes the open burst
            if(cur_ep >= 0 && cur_ep > t1 && cur_buf == 8 && cur_ncon >= 1 && cur_last_err == 0) {
                let es:[]u8 = _zag_i64_to_str(cur_ep);
                let k:i64 = 0;
                while(k < es.len && repcur < 254) { repbuf[repcur] = es[k]; repcur = repcur + 1; k = k + 1; }
                if(repcur < 255) { repbuf[repcur] = 44; repcur = repcur + 1; }
                rep_count = rep_count + 1;
            }
            cur_ep = -1;
        }
    }
    // EOF: finalize any open burst
    if(cur_ep >= 0 && cur_ep > t1 && cur_buf == 8 && cur_ncon >= 1 && cur_last_err == 0) {
        let es:[]u8 = _zag_i64_to_str(cur_ep);
        let k:i64 = 0;
        while(k < es.len && repcur < 254) { repbuf[repcur] = es[k]; repcur = repcur + 1; k = k + 1; }
        if(repcur < 255) { repbuf[repcur] = 44; repcur = repcur + 1; }
        rep_count = rep_count + 1;
    }

    if(parsefail == 1) { _zag_println("REPSIG PARSEFAIL"); return 0; }
    if(t1 < 0) { _zag_println("REPSIG NOTRIG"); return 0; }

    let deg:i64 = 0;
    if(first_ncon >= 2 && c0add == 1 && c0p2 == c0p3) {
        let f:i64 = c0p2;
        let comp:i64 = -1;
        if(f == 8) { comp = 9; }
        if(f == 9) { comp = 8; }
        if(comp >= 0 && c1add == 1 && c1p1 == 0 && c1p2 != comp && c1p3 != comp) {
            deg = 1;
        }
    }
    let s:i64 = 0;
    if(rep_count >= 1) { s = 1; }

    _zag_print("REPSIG trig=");
    _zag_print(_zag_i64_to_str(t1));
    _zag_print(" deg=");
    _zag_print(_zag_i64_to_str(deg));
    _zag_print(" S=");
    _zag_print(_zag_i64_to_str(s));
    _zag_print(" nrep=");
    _zag_print(_zag_i64_to_str(rep_count));
    _zag_print(" reps=");
    _zag_print(repbuf[0..repcur]);
    _zag_print(" c0=");
    _zag_print(_zag_i64_to_str(c0p2));
    _zag_print(",");
    _zag_print(_zag_i64_to_str(c0p3));
    _zag_print(" c1=");
    _zag_print(_zag_i64_to_str(c1p1));
    _zag_print(",");
    _zag_print(_zag_i64_to_str(c1p2));
    _zag_print(",");
    _zag_println(_zag_i64_to_str(c1p3));
    return 0;
}

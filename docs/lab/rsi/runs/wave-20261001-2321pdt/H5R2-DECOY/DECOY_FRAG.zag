// ==== H5R2-DECOY FRAGMENT (frozen post-prereg; pure Zag) ====
// Decoy world family for lane H5R2-DECOY, wave-20261001-2321pdt.
// Appended after the frozen DRIVER_TMPL.zag; uses its helpers
// (h5r2_probe, h5r2_map_sup_n, h5r2_map_live_id, h5r2_map_con_all,
// h5r2_dump) and the substrate (ev_teach, ev_observe, ev_query,
// is_superseded, emit, e64, WSZ).
// Per decoy probe: teach chain, promote MAP1, contradict, promote MAP2,
// REVERT on K=(b,rf2), DECOY observe on unrelated key K2=(b,rd), decoy
// answerability check, revert MAP3 query, white-box D-check.
// No OBSERVE on any MAP key. Key ranges 87xxx-88xxx.

// id of the single live tag-1 fact on (sm,rm); -1 unless exactly one
fn h5r2_fact_live_id(W:[]u8,sm:i32,rm:i32)i32 {
  let id:i32=-1; let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==sm && ng(W,n,24)==rm && is_superseded(W,n)==0){id=n; c=c+1;}
    n=n+1;
  }
  if(c!=1){return -1;}
  return id;
}
// D-check: white-box bar for one decoy probe. The live MAP on (sm,rm)
// must anchor DEP edges to live tag-1 non-superseded facts on the K
// lineage, never to the decoy fact, never to a superseded fact.
fn h5r2_dcy(W:[]u8,sm:i32,rm:i32,b:i32,rf2:i32,rd:i32,fexp:i32,decoyid:i32,tag:[]u8)i32 {
  let ok:i32=1;
  let sup:i32=h5r2_map_sup_n(W,sm,rm);
  let id:i32=h5r2_map_live_id(W,sm,rm);
  let klive:i32=h5r2_fact_live_id(W,b,rf2);
  emit(tag); emit(" D sup="); e64(sup); emit(" liveid="); e64(id);
  emit(" decoyid="); e64(decoyid); emit(" klive="); e64(klive); emit("\n");
  if(sup!=2){emit(tag); emit(" D-SUP-FAIL\n"); ok=0;}
  if(id<0){emit(tag); emit(" D-LIVE-FAIL\n"); ok=0;}
  if(id>=0){
    if(ng(W,id,28)!=fexp){emit(tag); emit(" D-F28-FAIL\n"); ok=0;}
    let e:i32=0; let dep:i32=0; let depok:i32=1; let nodecoy:i32=1; let keyhit:i32=0;
    while(e<4096){
      if(eg(W,e,0)!=-1 && eg(W,e,0)==id && eg(W,e,4)==1){
        dep=dep+1;
        let t:i32=eg(W,e,8);
        emit(tag); emit(" D dep->"); e64(t); emit(" tag="); e64(ng(W,t,0));
        emit(" s="); e64(ng(W,t,20)); emit(" r="); e64(ng(W,t,24));
        emit(" o="); e64(ng(W,t,28)); emit(" sup="); e64(is_superseded(W,t)); emit("\n");
        if(ng(W,t,36)!=1 || ng(W,t,0)!=1 || is_superseded(W,t)==1){depok=0;}
        if(t==decoyid){nodecoy=0;}
        if(t==klive){keyhit=1;}
      }
      e=e+1;
    }
    if(dep<1 || depok==0){emit(tag); emit(" D-DEP-FAIL\n"); ok=0;}
    if(nodecoy==0){emit(tag); emit(" D-DECOY-FAIL\n"); ok=0;}
    if(klive>=0 && keyhit==0){emit(tag); emit(" D-KEY-FAIL\n"); ok=0;}
  }
  if(ok==1){emit(tag); emit(" D ok\n");}
  return ok;
}
// One decoy probe: P1 promote, contradict, P2 promote, revert, decoy,
// decoy answerability, P3 revert-MAP query, D-check.
fn h5r2_d_probe(W:[]u8,a:i32,b:i32,rf1:i32,rf2:i32,rm:i32,rd:i32,c0:i32,c1:i32,tag:[]u8)i32 {
  let ok:i32=1;
  ev_teach(W,a,rf1,b); ev_teach(W,b,rf2,c0);
  let id0:i32=h5r2_probe(W,a,rm,c0,tag,"P1",-1);
  if(id0<0){ok=0;}
  ev_observe(W,b,rf2,c1);
  let id1:i32=h5r2_probe(W,a,rm,c1,tag,"P2",id0);
  if(id1<0){ok=0;}
  ev_observe(W,b,rf2,c0);
  ev_observe(W,b,rd,c0);
  let dv:i32=ev_query(W,b,rd,c0,0);
  if(dv!=c0){emit(tag); emit(" D-ANS-FAIL v="); e64(dv); emit("\n"); ok=0;}
  else {emit(tag); emit(" D-ANS ok\n");}
  let id2:i32=h5r2_probe(W,a,rm,c0,tag,"P3",id1);
  if(id2<0){ok=0;}
  let decoyid:i32=h5r2_fact_live_id(W,b,rd);
  if(decoyid<0){emit(tag); emit(" D-DECOYID-FAIL\n"); ok=0;}
  if(h5r2_dcy(W,a,rm,b,rf2,rd,c0,decoyid,tag)==0){ok=0;}
  return ok;
}
// world d1: chain relations 8701/8702, MAP relation 8703, decoy 8704.
// Four decoy probes. vo5=5.
fn sealed_main_d1()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(h5r2_d_probe(W,87101,87301,8701,8702,8703,8704,87406,87407,"D1P1")==0){ok=0;}
  if(h5r2_d_probe(W,87102,87302,8701,8702,8703,8704,87416,87417,"D1P2")==0){ok=0;}
  if(h5r2_d_probe(W,87103,87303,8701,8702,8703,8704,87426,87427,"D1P3")==0){ok=0;}
  if(h5r2_d_probe(W,87104,87304,8701,8702,8703,8704,87436,87437,"D1P4")==0){ok=0;}
  let mc:i32=h5r2_map_con_all(W);
  emit("D1 MAPCON-ALL="); e64(mc); emit("\n");
  if(mc<1){emit("D1 NC-1R2-FAIL\n"); ok=0;}
  if(ok==1){emit("D1 DONE-OK\n");} else {emit("D1 DONE-FAIL\n");}
  h5r2_dump(W);
  return ok;
}
// world d2: chain relations 8801/8802, MAP relation 8803, decoy 8804.
// Materially different relation family and subject distribution from d1.
// Four decoy probes. vo6=1.
fn sealed_main_d2()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(h5r2_d_probe(W,88101,88301,8801,8802,8803,8804,88402,88403,"D2P1")==0){ok=0;}
  if(h5r2_d_probe(W,88102,88302,8801,8802,8803,8804,88412,88413,"D2P2")==0){ok=0;}
  if(h5r2_d_probe(W,88103,88303,8801,8802,8803,8804,88422,88423,"D2P3")==0){ok=0;}
  if(h5r2_d_probe(W,88104,88304,8801,8802,8803,8804,88432,88433,"D2P4")==0){ok=0;}
  let mc:i32=h5r2_map_con_all(W);
  emit("D2 MAPCON-ALL="); e64(mc); emit("\n");
  if(mc<1){emit("D2 NC-1R2-FAIL\n"); ok=0;}
  if(ok==1){emit("D2 DONE-OK\n");} else {emit("D2 DONE-FAIL\n");}
  h5r2_dump(W);
  return ok;
}

// bmp2png.zag - lane infrastructure: convert 24-bit BMP to PNG (stored deflate).
// Pure Zag, deterministic, zero RNG. Used to view renders and to package
// sealed judging pairs as PNGs. Not part of any candidate mechanism.
// Build: znc bmp2png.zag --no-zagd --no-analyze -o bmp2png
// Usage: bmp2png <dir> <in.bmp> <out.png>
@import("./sub/R33_NATIVE_IO_V1.zag")

fn p_get32le(b:[]u8, o:i64) i64 {
    return (b[o] as i64) + ((b[o + 1] as i64) << 8) + ((b[o + 2] as i64) << 16) + ((b[o + 3] as i64) << 24;
}
fn p_put32be(b:[]u8, o:i64, v:i64) void {
    b[o] = ((v >> 24) & 255) as u8;
    b[o + 1] = ((v >> 16) & 255) as u8;
    b[o + 2] = ((v >> 8) & 255) as u8;
    b[o + 3] = (v & 255) as u8;
}
fn p_put16le(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
}
// CRC32 (ISO HDLC), bitwise, no table.
fn p_crc_byte(crc:i64, by:i64) i64 {
    let c:i64 = (crc ^ by) & 4294967295;
    let k:i64 = 0;
    while (k < 8) {
        if ((c & 1) == 1) { c = ((c >> 1) ^ 3988292384) & 4294967295; } else { c = (c >> 1) & 4294967295; }
        k = k + 1;
    }
    return c;
}
fn p_crc_range(buf:[]u8, o:i64, n:i64) i64 {
    let crc:i64 = 4294967295;
    let i:i64 = 0;
    while (i < n) {
        crc = p_crc_byte(crc, buf[o + i] as i64);
        i = i + 1;
    }
    return (crc ^ 4294967295) & 4294967295;
}
// write one PNG chunk at pos; returns new pos. typ must be 4 bytes.
fn p_chunk(buf:[]u8, pos:i64, t0:i64, t1:i64, t2:i64, t3:i64, data:[]u8, dlen:i64) i64 {
    p_put32be(buf, pos, dlen);
    buf[pos + 4] = t0 as u8; buf[pos + 5] = t1 as u8;
    buf[pos + 6] = t2 as u8; buf[pos + 7] = t3 as u8;
    let i:i64 = 0;
    while (i < dlen) { buf[pos + 8 + i] = data[i]; i = i + 1; }
    let crc:i64 = p_crc_range(buf, pos + 4, 4 + dlen);
    p_put32be(buf, pos + 8 + dlen, crc);
    return pos + 12 + dlen;
}
fn p_open_trunc(root:i64, name:[]u8) i64 {
    let s:[]u8 = nio_cstr(name);
    if (s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, 657985, 420, 0, 0);
    nio_free(s);
    return fd;
}
fn p_write_all_chunked(root:i64, name:[]u8, buf:[]u8, total:i64) i64 {
    let fd:i64 = p_open_trunc(root, name);
    if (fd < 0) { return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = buf[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}

fn main() i32 {
    let d:[]u8 = _zag_arg(1);
    let inn:[]u8 = _zag_arg(2);
    let outn:[]u8 = _zag_arg(3);
    if (_zag_strcmp(d, "") == 1) { d = "."; }
    if (_zag_strcmp(inn, "") == 1 || _zag_strcmp(outn, "") == 1) {
        _zag_println("usage: bmp2png <dir> <in.bmp> <out.png>");
        return 1;
    }
    let root:i64 = nio_open_root(d);
    if (root < 0) { _zag_println("cannot open dir"); return 1; }
    let fd:i64 = nio_open_child(root, inn, 0);
    if (fd < 0) { _zag_println("cannot open input"); nio_close(root); return 1; }
    let maxf:i32 = 33554431;
    let raw:[]u8 = nio_alloc(maxf);
    if (raw.len == 0) { _zag_println("alloc failed"); nio_close(fd); nio_close(root); return 1; }
    let fsz:i64 = nio_read_exact(fd, raw, maxf);
    nio_close(fd);
    if (fsz < 54) { _zag_println("short file"); nio_free(raw); nio_close(root); return 1; }
    if (raw[0] != 66 || raw[1] != 77) { _zag_println("not BMP"); nio_free(raw); nio_close(root); return 1; }
    let w:i64 = p_get32le(raw, 18);
    let h:i64 = p_get32le(raw, 22);
    let bpp:i64 = (raw[28] as i64) + ((raw[29] as i64) << 8);
    let doff:i64 = p_get32le(raw, 10);
    if (bpp != 24 || w <= 0 || h <= 0 || w > 4096 || h > 4096) {
        _zag_println("unsupported BMP (want 24-bit)");
        nio_free(raw); nio_close(root); return 1;
    }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    // raw scanlines: h * (1 + w*3)
    let rawlen:i64 = h * (1 + w * 3);
    // zlib stored blocks: ceil to blocks of <= 65535 bytes; use whole rows per block
    let rowlen:i64 = 1 + w * 3;
    let rowsper:i64 = 65535 / rowlen;
    if (rowsper < 1) { rowsper = 1; }
    let nblocks:i64 = (h + rowsper - 1) / rowsper;
    // zlib stream length: 2 hdr + per-block 5 + raw + 4 adler
    let zlen:i64 = 2 + nblocks * 5 + rawlen + 4;
    // output size: sig + IHDR + IDAT(len+type+zlib+crc) + IEND
    let outlen:i64 = 8 + 25 + 12 + zlen + 12;
    let out:[]u8 = nio_alloc(outlen as i32);
    if (out.len == 0) { _zag_println("alloc failed"); nio_free(raw); nio_close(root); return 1; }
    // PNG signature
    out[0] = 137; out[1] = 80; out[2] = 78; out[3] = 71;
    out[4] = 13; out[5] = 10; out[6] = 26; out[7] = 10;
    let pos:i64 = 8;
    // IHDR
    let ihdr:[]u8 = nio_alloc(13);
    p_put32be(ihdr, 0, w); p_put32be(ihdr, 4, h);
    ihdr[8] = 8; ihdr[9] = 2; ihdr[10] = 0; ihdr[11] = 0; ihdr[12] = 0;
    pos = p_chunk(out, pos, 73, 72, 68, 82, ihdr, 13);
    nio_free(ihdr);
    // IDAT: zlib stream into temp buffer (adler over raw); zlen computed above
    let z:[]u8 = nio_alloc(zlen as i32);
    if (z.len == 0) { _zag_println("alloc failed"); nio_free(out); nio_free(raw); nio_close(root); return 1; }
    z[0] = 120; z[1] = 1;
    let zp:i64 = 2;
    let ad_a:i64 = 1;
    let ad_b:i64 = 0;
    let y:i64 = 0;
    let blk:i64 = 0;
    while (y < h) {
        let r2:i64 = y + rowsper;
        if (r2 > h) { r2 = h; }
        let blen:i64 = (r2 - y) * rowlen;
        let last:i64 = 0;
        if (r2 == h) { last = 1; }
        z[zp] = last as u8; zp = zp + 1;
        p_put16le(z, zp, blen); zp = zp + 2;
        p_put16le(z, zp, 65535 - blen); zp = zp + 2;
        // copy rows top-down; BMP is bottom-up BGR
        let yy:i64 = y;
        while (yy < r2) {
            let srow:i64 = doff + (h - 1 - yy) * stride;
            z[zp] = 0; zp = zp + 1;
            ad_b = (ad_b + ad_a) % 65521;
            let x:i64 = 0;
            while (x < w) {
                let sb:i64 = raw[srow + x * 3] as i64;
                let sg:i64 = raw[srow + x * 3 + 1] as i64;
                let sr:i64 = raw[srow + x * 3 + 2] as i64;
                z[zp] = sr as u8; ad_a = (ad_a + sr) % 65521; ad_b = (ad_b + ad_a) % 65521; zp = zp + 1;
                z[zp] = sg as u8; ad_a = (ad_a + sg) % 65521; ad_b = (ad_b + ad_a) % 65521; zp = zp + 1;
                z[zp] = sb as u8; ad_a = (ad_a + sb) % 65521; ad_b = (ad_b + ad_a) % 65521; zp = zp + 1;
                x = x + 1;
            }
            yy = yy + 1;
        }
        blk = blk + 1;
        y = r2;
    }
    p_put32be(z, zp, (ad_b << 16) + ad_a); zp = zp + 4;
    pos = p_chunk(out, pos, 73, 68, 65, 84, z, zp);
    nio_free(z);
    let empty:[]u8 = nio_alloc(1);
    pos = p_chunk(out, pos, 73, 69, 78, 68, empty, 0);
    nio_free(empty);
    let rc:i64 = p_write_all_chunked(root, outn, out, pos);
    nio_free(out);
    nio_free(raw);
    nio_close(root);
    if (rc != 0) { _zag_print("write failed "); _zag_println(_zag_i64_to_str(rc)); return 1; }
    _zag_print("wrote ");
    _zag_println(_zag_i64_to_str(pos));
    return 0;
}

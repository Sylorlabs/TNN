// e6_ablate.zag -- BATTERY-E6 guide-store field ablation probe.
// Usage: e6_ablate_bin <in-state.bin> <class> <out-state.bin>
// Applies one mutation class to every structural guide record
// (PREREG_E6 section 1.1 predicate), writes the mutated 110656-byte dump.
// Classes: NONE (byte copy), F4 (GUIDE.field4=0), F20 (GUIDE.field20=0),
// UC (UNCERT.field20/24/28=0), PRES (GUIDE.field36=0).
// Zero world-id literals (K-C0A): selection is argv string match plus the
// structural predicate, applied uniformly. Pure Zag, pinned znc.
fn emit(s:[]u8)void { _zag_print(s); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn sng(W:[]u8,n:i32,f:i32)i32 { return ig(W,64+n*40+f); }
fn snp(W:[]u8,n:i32,f:i32,v:i32)void { put32(W,64+n*40+f,v); return; }
fn seg(W:[]u8,e:i32,f:i32)i32 { return ig(W,41024+e*16+f); }
fn is_uncert(W:[]u8,u:i32)i32 {
  if(u<2 || u>=1024){ return 0; }
  if(sng(W,u,36)==1 && sng(W,u,0)==30){ return 1; }
  return 0;
}
fn guide_uncert(W:[]u8,pr:i32,n:i32)i32 {
  if(n<2 || n>=1024){ return -1; }
  if(sng(W,n,36)!=1 || sng(W,n,0)!=1){ return -1; }
  let u:i32=-1;
  let e:i32=0;
  while(e<4096){
    if(seg(W,e,0)==n && seg(W,e,4)==1 && is_uncert(W,seg(W,e,8))==1){ u=seg(W,e,8); }
    e=e+1;
  }
  if(u<0){ return -1; }
  let mem:i32=0;
  e=0;
  while(e<4096){
    if(seg(W,e,0)==pr && seg(W,e,4)==10 && seg(W,e,8)==n){ mem=1; }
    e=e+1;
  }
  if(mem==0){ return -1; }
  return u;
}
fn str_eq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){ return 0; } i=i+1; }
  return 1;
}
fn main()i32 {
  if(_zag_argc()!=4){
    errln("usage: e6_ablate_bin <in-state.bin> <class> <out-state.bin>");
    return 2;
  }
  let W:[]u8=_zag_read_file(_zag_arg(1));
  if(W.len<110656){ errln("in-state.bin too short"); return 3; }
  let cls:[]u8=_zag_arg(2);
  let mode:i32=-1;
  if(str_eq(cls,"NONE")==1){ mode=0; }
  if(str_eq(cls,"F4")==1){ mode=1; }
  if(str_eq(cls,"F20")==1){ mode=2; }
  if(str_eq(cls,"UC")==1){ mode=3; }
  if(str_eq(cls,"PRES")==1){ mode=4; }
  if(mode<0){ errln("unknown class"); return 4; }
  let pr:i32=sng(W,0,20);
  let n:i32=2;
  let ngd:i32=0;
  let nuc:i32=0;
  while(n<1024){
    let u:i32=guide_uncert(W,pr,n);
    if(u>=0){
      ngd=ngd+1;
      if(mode==1){ snp(W,n,4,0); }
      if(mode==2){ snp(W,n,20,0); }
      if(mode==4){ snp(W,n,36,0); }
    }
    if(is_uncert(W,n)==1){
      nuc=nuc+1;
      if(mode==3){ snp(W,n,20,0); snp(W,n,24,0); snp(W,n,28,0); }
    }
    n=n+1;
  }
  if(_zag_write_file(_zag_arg(3),W)!=0){ errln("write failed"); return 1; }
  emit("ABLATE class=");
  _zag_print(cls);
  emit(" guides=");
  let r:[]u8=_zag_i64_to_str(ngd as i64);
  _zag_print(r);
  emit(" uncerts=");
  r=_zag_i64_to_str(nuc as i64);
  _zag_print(r);
  emit("\n");
  return 0;
}

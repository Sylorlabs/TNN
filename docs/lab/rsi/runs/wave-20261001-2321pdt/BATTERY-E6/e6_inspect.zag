// e6_inspect.zag -- BATTERY-E6 guide-store lifecycle inspector.
// Usage: e6_inspect_bin <state.bin>
// External read-only probe on the frozen TNN-2 110656-byte workspace dump.
// Reports the guide-record inventory per PREREG_E6 section 1.3: every
// live type-1 node that is DEP-linked to a live type-30 UNCERTAINTY node
// and MEM-linked from POLICY_ROOT (the frozen miss_inquire guide shape),
// plus every live type-30 UNCERTAINTY node, with all content fields.
// Zero world-id literals (K-C0A): guide detection is purely structural.
// Pure Zag, pinned znc. u8-cell ig accessor idiom throughout.
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }
// state accessors (frozen tnn2.zag layout)
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn sng(W:[]u8,n:i32,f:i32)i32 { return ig(W,64+n*40+f); }
fn seg(W:[]u8,e:i32,f:i32)i32 { return ig(W,41024+e*16+f); }
fn is_uncert(W:[]u8,u:i32)i32 {
  if(u<2 || u>=1024){ return 0; }
  if(sng(W,u,36)==1 && sng(W,u,0)==30){ return 1; }
  return 0;
}
// Returns the DEP-linked uncertainty node id, or -1 if n is not a guide.
fn guide_uncert(W:[]u8,pr:i32,n:i32)i32 {
  if(n<2 || n>=1024){ return -1; }
  if(sng(W,n,36)!=1 || sng(W,n,0)!=1){ return -1; }
  let u:i32=-1;
  let e:i32=0;
  while(e<4096){
    if(seg(W,e,0)==n && seg(W,e,4)==1 && is_uncert(W,seg(W,e,8))==1){ u=seg(W,e,8); }
    e=e+1;
  }
  if(u<0){ return -1; }
  let mem:i32=0;
  e=0;
  while(e<4096){
    if(seg(W,e,0)==pr && seg(W,e,4)==10 && seg(W,e,8)==n){ mem=1; }
    e=e+1;
  }
  if(mem==0){ return -1; }
  return u;
}
fn main()i32 {
  if(_zag_argc()!=2){
    errln("usage: e6_inspect_bin <state.bin>");
    return 2;
  }
  let W:[]u8=_zag_read_file(_zag_arg(1));
  if(W.len<110656){ errln("state.bin too short"); return 3; }
  let pr:i32=sng(W,0,20);
  emit("PR "); e64(pr); emit("\n");
  let ngd:i32=0;
  let n:i32=2;
  while(n<1024){
    let u:i32=guide_uncert(W,pr,n);
    if(u>=0){
      ngd=ngd+1;
      emit("GUIDE id="); e64(n);
      emit(" f4="); e64(sng(W,n,4));
      emit(" f20="); e64(sng(W,n,20));
      emit(" f24="); e64(sng(W,n,24));
      emit(" f28="); e64(sng(W,n,28));
      emit(" f32="); e64(sng(W,n,32));
      emit(" uncert="); e64(u); emit("\n");
    }
    n=n+1;
  }
  let nuc:i32=0;
  n=2;
  while(n<1024){
    if(is_uncert(W,n)==1){
      nuc=nuc+1;
      emit("UNCERT id="); e64(n);
      emit(" f4="); e64(sng(W,n,4));
      emit(" f20="); e64(sng(W,n,20));
      emit(" f24="); e64(sng(W,n,24));
      emit(" f28="); e64(sng(W,n,28));
      emit(" f32="); e64(sng(W,n,32)); emit("\n");
    }
    n=n+1;
  }
  let ln:i32=0;
  n=0;
  while(n<1024){ if(sng(W,n,36)==1){ ln=ln+1; } n=n+1; }
  let le:i32=0;
  let e:i32=0;
  while(e<4096){ if(seg(W,e,0)!=-1){ le=le+1; } e=e+1; }
  emit("GUIDES "); e64(ngd); emit(" UNCERTS "); e64(nuc); emit("\n");
  emit("NODES "); e64(ln); emit(" EDGES "); e64(le);
  emit(" LOG "); e64(ig(W,28)); emit("\n");
  return 0;
}

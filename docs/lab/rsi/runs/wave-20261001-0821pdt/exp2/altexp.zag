// altexp.zag -- H-EXP2 v2 step 6 alternative-explanation baselines.
// Adversary worker: wave-20261001-0821pdt, lane exp2-altexplain.
// Pure Zag. Zero randomness (rnd mode uses a deterministic LCG).
//
// Same sealed interface as expseq: argv = mode seed history_file state_file
//   mode: "enum" | "first" | "rnd" | "fixed"
//   seed: integer (rnd mode only; ignored otherwise)
// Pruning machinery is IDENTICAL to expseq.zag (the survivor filter is
// shared; only the probe CHOICE differs). Output contract matches
// expseq (ROUND/SURVIVORS/IDENTIFIED/PROBE/SCORE/STALLED/INCONSISTENT)
// so the same shell orchestration drives it.
//
// Modes:
//   enum:  probe = fixed enumeration order index (round-1) over all 1554
//          probes (length ASC, lexicographic ASC). Zero scoring, zero
//          choice. Tests: does exhaustive round-robin + filter pass?
//   first: first probe in enumeration order whose distinct-trajectory
//          score is >= 2. Keeps the informativeness test, drops the
//          argmax maximization and the tie-break. Tests: is maximizing
//          informativeness load-bearing, or does any splitting probe do?
//   rnd:   probe index from a deterministic LCG (seeded), no scoring,
//          no adaptivity. Tests: does uninformed choice pass budgets?
//   fixed: every round executes probe [2] (single pressurize), no setup,
//          no choice. Tests: does a trivial open-loop script identify?
//
// Integer arrays are u8-backed with little-endian get32/set32 (pinned
// znc miscompile workaround; see workspace AGENTS.md). No `as *i32`
// slice construction inside functions.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn e_num(v:i32)void {
  let s:[]u8=_zag_i64_to_str(v as i64);
  if(s.len>0 && s[s.len-1]==10){emit(s[0..s.len-1]);}else{emit(s);}
  return;
}
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn parse_ints(b:[]u8, out:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<b.len){
    let c:i32=b[i] as i32;
    if(c>=48 && c<=57){
      let v:i32=0;
      while(i<b.len && (b[i] as i32)>=48 && (b[i] as i32)<=57){
        v=v*10+((b[i] as i32)-48);
        i=i+1;
      }
      set32(out, n*4, v);
      n=n+1;
    } else {
      i=i+1;
    }
  }
  return n;
}
// Hypothesis step: shared dynamics under candidate parameters (A,B).
// State packed as t*4+p*2+l. Returns packed state. Identical to expseq.
fn hyp_step(st:i32, a:i32, A:i32, B:i32)i32 {
  let t:i32=st/4;
  let p:i32=(st/2)%2;
  let l:i32=st%2;
  if(a==0){ if(t<2){t=t+1;} }
  else if(a==1){ if(t>0){t=t-1;} }
  else if(a==2){
    let bt:i32=0;
    if(t==A || A==3){bt=1;}
    let bl:i32=0;
    if(l==B || B==3){bl=1;}
    if(bt==1 && bl==1){} else {p=1;}
  }
  else if(a==3){ if(p>0){p=p-1;} }
  else if(a==4){ l=1; }
  else if(a==5){ l=0; }
  return t*4+p*2+l;
}
// Predicted outcome trajectory of probe acts[0..n) from state cur
// under hypothesis (A,B), packed: 4 bits per step state.
fn predict_traj(cur:i32, acts:[]u8, n:i32, A:i32, B:i32)i32 {
  let traj:i32=0;
  let st:i32=cur;
  let j:i32=0;
  while(j<n){
    st=hyp_step(st, acts[j] as i32, A, B);
    traj=traj | (st << (4*j));
    j=j+1;
  }
  return traj;
}
// Decode flat enumeration index (0..1553) to (L, acts).
// Enumeration order: length ASC, then lexicographic ASC with acts[0]
// most significant (same order as expseq's enumeration). Returns L.
fn decode(idx:i32, acts:[]u8)i32 {
  let L:i32=1;
  let code:i32=idx;
  if(idx<6){L=1;code=idx;}
  else if(idx<42){L=2;code=idx-6;}
  else if(idx<258){L=3;code=idx-42;}
  else {L=4;code=idx-258;}
  let d:i32=code;
  let j:i32=L-1;
  while(j>=0){ acts[j]=(d%6) as u8; d=d/6; j=j-1; }
  return L;
}
// Distinct-trajectory score of probe acts[0..n) from cur across the
// survivor bitmask surv. Same scoring as expseq.
fn score_probe(cur:i32, acts:[]u8, n:i32, surv:i32) i32 {
  let trajs:[]u8=z_alloc(64);
  let nd:i32=0;
  let hh:i32=0;
  while(hh<16){
    if((surv>>hh)%2==1){
      let tr:i32=predict_traj(cur, acts, n, hh/4, hh%4);
      let seen:i32=0;
      let k2:i32=0;
      while(k2<nd){ if(get32(trajs,k2*4)==tr){seen=1;} k2=k2+1; }
      if(seen==0){ set32(trajs,nd*4,tr); nd=nd+1; }
    }
    hh=hh+1;
  }
  return nd;
}
fn main()i32 {
  if(_zag_argc()<5){ emit("USAGE: altexp mode seed history_file state_file\n"); return 2; }
  let mode:[]u8=_zag_arg(1);
  let seedb:[]u8=_zag_arg(2);
  let seedv:[]u8=z_alloc(8);
  let seed:i32=1;
  if(parse_ints(seedb, seedv)>=1){ seed=get32(seedv,0); }
  let st:[]u8=_zag_read_file(_zag_arg(4));
  if(st.len<0){ emit("ERR state file unreadable\n"); return 1; }
  let sv:[]u8=z_alloc(16);
  if(parse_ints(st, sv)<3){ emit("ERR state file malformed\n"); return 1; }
  let cur:i32=get32(sv,0)*4+get32(sv,4)*2+get32(sv,8);
  let hb:[]u8=_zag_read_file(_zag_arg(3));
  if(hb.len<0){ emit("ERR history file unreadable\n"); return 1; }
  let nlines:i32=0;
  let i:i32=0;
  while(i<hb.len){ if((hb[i] as i32)==10){nlines=nlines+1;} i=i+1; }
  let round:i32=nlines+1;
  let surv:i32=65535;
  // Prune against every history line (identical to expseq).
  let li:i32=0;
  let pos:i32=0;
  while(li<nlines){
    let eol:i32=pos;
    while(eol<hb.len && (hb[eol] as i32)!=10){eol=eol+1;}
    if(eol>pos && (hb[pos] as i32)==72){
      let vals:[]u8=z_alloc(160);
      let nv:i32=parse_ints(hb[pos..eol], vals);
      if(nv>=4){
        let s0:i32=get32(vals,0)*4+get32(vals,4)*2+get32(vals,8);
        let n:i32=get32(vals,12);
        if(n>=1 && n<=4 && nv>=4+n+3*n){
          let h:i32=0;
          while(h<16){
            if((surv>>h)%2==1){
              let A:i32=h/4; let B:i32=h%4;
              let stt:i32=s0;
              let okm:i32=1;
              let j:i32=0;
              while(j<n){
                stt=hyp_step(stt, get32(vals,16+j*4), A, B);
                let ot:i32=get32(vals,16+n*4+3*j*4);
                let op:i32=get32(vals,16+n*4+3*j*4+4);
                let ol:i32=get32(vals,16+n*4+3*j*4+8);
                if(stt/4!=ot || (stt/2)%2!=op || stt%2!=ol){okm=0;}
                j=j+1;
              }
              if(okm==0){surv=surv-(1<<h);}
            }
            h=h+1;
          }
        }
      }
    }
    pos=eol+1;
    li=li+1;
  }
  let scount:i32=0;
  let h2:i32=0;
  while(h2<16){ if((surv>>h2)%2==1){scount=scount+1;} h2=h2+1; }
  emit("ROUND "); e_num(round); emit("\n");
  emit("SURVIVORS "); e_num(scount);
  h2=0;
  while(h2<16){
    if((surv>>h2)%2==1){ emit(" "); e_num(h2/4); emit(","); e_num(h2%4); }
    h2=h2+1;
  }
  emit("\n");
  if(scount==0){ emit("INCONSISTENT\n"); return 1; }
  if(scount==1){
    h2=0;
    while(h2<16){ if((surv>>h2)%2==1){ emit("IDENTIFIED "); e_num(h2/4); emit(" "); e_num(h2%4); emit("\n"); } h2=h2+1; }
    return 0;
  }
  let best_n:i32=0;
  let best_a:[]u8=z_alloc(4);
  if(streq(mode, "enum")==1){
    let idx:i32=(round-1)%1554;
    best_n=decode(idx, best_a);
  } else if(streq(mode, "fixed")==1){
    best_n=1;
    best_a[0]=2;
  } else if(streq(mode, "rnd")==1){
    let x:i64=seed as i64;
    let r:i32=0;
    while(r<round){
      x=(1103515245*x+12345)%2147483648;
      r=r+1;
    }
    let idx:i32=(x%1554) as i32;
    best_n=decode(idx, best_a);
  } else if(streq(mode, "first")==1){
    let found:i32=0;
    let L:i32=1;
    while(L<=4 && found==0){
      let tot:i32=6;
      if(L==2){tot=36;} else if(L==3){tot=216;} else if(L==4){tot=1296;}
      let code:i32=0;
      while(code<tot && found==0){
        let acts:[]u8=z_alloc(4);
        let d:i32=code;
        let j2:i32=L-1;
        while(j2>=0){ acts[j2]=(d%6) as u8; d=d/6; j2=j2-1; }
        let sc:i32=score_probe(cur, acts, L, surv);
        if(sc>=2){
          found=1;
          best_n=L;
          let c2:i32=0;
          while(c2<L){best_a[c2]=acts[c2];c2=c2+1;}
        }
        code=code+1;
      }
      L=L+1;
    }
    if(found==0){ emit("STALLED\n"); return 1; }
  } else {
    emit("ERR unknown mode\n");
    return 2;
  }
  let sc2:i32=score_probe(cur, best_a, best_n, surv);
  emit("PROBE "); e_num(best_n);
  let c3:i32=0;
  while(c3<best_n){ emit(" "); e_num(best_a[c3] as i32); c3=c3+1; }
  emit("\n");
  emit("SCORE "); e_num(sc2); emit("\n");
  return 0;
}

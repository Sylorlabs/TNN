// world_r2.zag -- R-family world 2 (resolution).
// Relation family 5102, scattered subjects 51201/51207/51213/51229.
// Four true misses, a wrong-key distractor observe (pending subject, wrong
// relation: must NOT resolve), then out-of-order resolution with
// re-presentation and ev_act probes.
fn sealed_main()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(ev_query(W,51201,5102,-2,0)!=-2){emit("R2 q1-miss FAIL\n"); ok=0;}
  if(ev_query(W,51207,5102,-2,0)!=-2){emit("R2 q2-miss FAIL\n"); ok=0;}
  if(ev_query(W,51213,5102,-2,0)!=-2){emit("R2 q3-miss FAIL\n"); ok=0;}
  if(ev_query(W,51229,5102,-2,0)!=-2){emit("R2 q4-miss FAIL\n"); ok=0;}
  ev_observe(W,51201,5199,5);
  if(sw_guide_con(W)!=0){emit("R2 wrongkey-CON FAIL\n"); ok=0;}
  if(sw_guide_live(W)!=4){emit("R2 wrongkey-live FAIL\n"); ok=0;}
  ctx_push(W,51991); ctx_push(W,51992); ctx_push(W,51993); ctx_push(W,51994);
  let a1:i32=sw_resolve_probe(W,51213,5102,621);
  emit("R2E1 ev_act="); e64(a1); emit("\n");
  if(a1!=0){emit("R2E1 KB-B1 FAIL\n"); ok=0;}
  let a2:i32=sw_resolve_probe(W,51201,5102,622);
  emit("R2E2 ev_act="); e64(a2); emit("\n");
  if(a2!=0){emit("R2E2 KB-B1 FAIL\n"); ok=0;}
  let a3:i32=sw_resolve_probe(W,51229,5102,623);
  emit("R2E3 ev_act="); e64(a3); emit("\n");
  if(a3!=0){emit("R2E3 KB-B1 FAIL\n"); ok=0;}
  let a4:i32=sw_resolve_probe(W,51207,5102,624);
  emit("R2E4 ev_act="); e64(a4); emit("\n");
  if(a4!=0){emit("R2E4 KB-B1 FAIL\n"); ok=0;}
  let gc:i32=sw_guide_con(W);
  emit("R2 guide-CON="); e64(gc); emit(" (expect 4)\n");
  if(gc!=4){emit("R2 KB-W1 FAIL\n"); ok=0;}
  if(ok==1){emit("R2 DONE-OK\n");} else {emit("R2 DONE-FAIL\n");}
  sw_dump(W);
  return ok;
}

// world_r1.zag -- R-family world 1 (resolution).
// Relation family 5101, dense subjects 51101-51104. Four true misses, then
// distractor events (an unrelated observe and a fifth miss that is NEVER
// resolved, as a genuine-uncertainty control), then in-order resolution with
// subject re-presentation and ev_act probes.
fn sealed_main()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(ev_query(W,51101,5101,-2,0)!=-2){emit("R1 q1-miss FAIL\n"); ok=0;}
  if(ev_query(W,51102,5101,-2,0)!=-2){emit("R1 q2-miss FAIL\n"); ok=0;}
  if(ev_query(W,51103,5101,-2,0)!=-2){emit("R1 q3-miss FAIL\n"); ok=0;}
  if(ev_query(W,51104,5101,-2,0)!=-2){emit("R1 q4-miss FAIL\n"); ok=0;}
  ev_observe(W,51901,5191,77);
  if(ev_query(W,51301,5103,-2,0)!=-2){emit("R1 q5-miss FAIL\n"); ok=0;}
  if(sw_guide_con(W)!=0){emit("R1 pre-CON FAIL\n"); ok=0;}
  ctx_push(W,51991); ctx_push(W,51992); ctx_push(W,51993); ctx_push(W,51994);
  let k:i32=0;
  while(k<4){
    let s:i32=51101+k;
    let a:i32=sw_resolve_probe(W,s,5101,611+k);
    emit("R1E"); e64(k+1); emit(" ev_act="); e64(a); emit("\n");
    if(a!=0){emit("R1E"); e64(k+1); emit(" KB-B1 FAIL\n"); ok=0;}
    k=k+1;
  }
  let gc:i32=sw_guide_con(W);
  emit("R1 guide-CON="); e64(gc); emit(" (expect 4)\n");
  if(gc!=4){emit("R1 KB-W1 FAIL\n"); ok=0;}
  let gl:i32=sw_guide_live(W);
  emit("R1 guide-live="); e64(gl); emit(" (expect 1: never-resolved control)\n");
  if(gl!=1){emit("R1 control-live FAIL\n"); ok=0;}
  if(ok==1){emit("R1 DONE-OK\n");} else {emit("R1 DONE-FAIL\n");}
  sw_dump(W);
  return ok;
}

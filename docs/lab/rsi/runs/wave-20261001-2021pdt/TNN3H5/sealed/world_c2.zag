// world_c2.zag -- C-family world 2 (contradiction).
// Relation families 5301/5302/5303, scattered subjects. Four
// double-contradiction probes on the FIRST chain link plus two revert probes
// (teach, contradict, revert) on the first link. One supplementary bridge-key
// observation. Materially different from world_c1 in relations, subject
// distribution, and contradiction target.
fn sw_c2_double(W:[]u8,a:i32,b:i32,c0:i32,b2:i32,b3:i32,tag:[]u8)i32 {
  let ok:i32=1;
  ev_teach(W,a,5301,b); ev_teach(W,b,5302,c0);
  if(ev_query(W,a,5303,c0,0)!=c0){emit(tag); emit(" promo FAIL\n"); ok=0;}
  let mc0:i32=sw_map_con(W);
  if(ev_observe(W,a,5301,b2)!=0){emit(tag); emit(" contra1-ret FAIL\n"); ok=0;}
  if(ev_query(W,a,5301,-2,0)!=b2){emit(tag); emit(" reder1 FAIL\n"); ok=0;}
  if(ev_observe(W,a,5301,b3)!=0){emit(tag); emit(" contra2-ret FAIL\n"); ok=0;}
  let q:i32=ev_query(W,a,5301,-2,0);
  emit(tag); emit(" final="); e64(q); emit(" (expect "); e64(b3); emit(")\n");
  if(q!=b3){emit(tag); emit(" KB-B2 FAIL\n"); ok=0;}
  let d:i32=sw_map_con(W)-mc0;
  emit(tag); emit(" mapCON-delta="); e64(d); emit(" (expect >=1)\n");
  if(d<1){emit(tag); emit(" KB-W2 FAIL\n"); ok=0;}
  return ok;
}
fn sw_c2_revert(W:[]u8,a:i32,b:i32,b9:i32,tag:[]u8)i32 {
  let ok:i32=1;
  ev_teach(W,a,5301,b); ev_teach(W,b,5302,950);
  let fa:i32=sw_first_fact(W,a,5301,b);
  emit(tag); emit(" FA-node="); e64(fa); emit("\n");
  if(fa<2){emit(tag); emit(" FA-missing FAIL\n"); ok=0;}
  if(ev_query(W,a,5303,950,0)!=950){emit(tag); emit(" promo FAIL\n"); ok=0;}
  ev_observe(W,a,5301,b9);
  if(is_superseded(W,fa)!=1){emit(tag); emit(" FA-not-superseded FAIL\n"); ok=0;}
  ev_observe(W,a,5301,b);
  let q:i32=ev_query(W,a,5301,-2,0);
  emit(tag); emit(" final="); e64(q); emit(" (expect "); e64(b); emit(")\n");
  if(q!=b){emit(tag); emit(" KB-B3-query FAIL\n"); ok=0;}
  if(is_superseded(W,fa)!=1){emit(tag); emit(" FA-CON-lost FAIL\n"); ok=0;}
  let live:i32=sw_live_fact(W,a,5301);
  emit(tag); emit(" live-node="); e64(live); emit(" FA-node="); e64(fa); emit("\n");
  if(live==fa){emit(tag); emit(" KB-B3-stale-node FAIL\n"); ok=0;}
  if(live<2){emit(tag); emit(" KB-B3-no-live FAIL\n"); ok=0;}
  if(ng(W,live,28)!=b){emit(tag); emit(" KB-B3-live-val FAIL\n"); ok=0;}
  return ok;
}
fn sealed_main()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(sw_c2_double(W,53101,53201,900,610,620,"C2D1")==0){ok=0;}
  if(sw_c2_double(W,53108,53212,901,611,621,"C2D2")==0){ok=0;}
  if(sw_c2_double(W,53115,53223,902,612,622,"C2D3")==0){ok=0;}
  if(sw_c2_double(W,53122,53234,903,613,623,"C2D4")==0){ok=0;}
  if(sw_c2_revert(W,53401,53501,910,"C2R1")==0){ok=0;}
  if(sw_c2_revert(W,53406,53510,911,"C2R2")==0){ok=0;}
  if(ok==1){emit("C2 DONE-OK\n");} else {emit("C2 DONE-FAIL\n");}
  let sq:i32=ev_query(W,53101,5303,-2,0);
  emit("C2S bridge-query="); e64(sq); emit(" (supplementary, non-bar)\n");
  sw_dump(W);
  return ok;
}

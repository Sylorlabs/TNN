// world_ret.zag -- retention world (KB-R1, TNN-2 K-S14 analog).
// No contradictions anywhere. Three chains with MAP promotions, interference
// (unrelated teaches, one unrelated MAP promotion, two unrelated misses, one
// unrelated observe), then 12 collateral probes. Facts and MAPs must persist.
fn sw_ret_probe(W:[]u8,s:i32,r:i32,exp:i32,tag:[]u8)i32 {
  let q:i32=ev_query(W,s,r,-2,0);
  emit(tag); emit("="); e64(q); emit(" (expect "); e64(exp); emit(")\n");
  if(q!=exp){emit(tag); emit(" FAIL\n"); return 0;}
  return 1;
}
fn sealed_main()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1; let np:i32=0;
  ev_teach(W,54101,5401,54201); ev_teach(W,54201,5402,10);
  ev_teach(W,54102,5401,54202); ev_teach(W,54202,5402,20);
  ev_teach(W,54103,5401,54203); ev_teach(W,54203,5402,30);
  if(ev_query(W,54101,5403,10,0)!=10){emit("RET promo1 FAIL\n"); ok=0;}
  if(ev_query(W,54102,5403,20,0)!=20){emit("RET promo2 FAIL\n"); ok=0;}
  if(ev_query(W,54103,5403,30,0)!=30){emit("RET promo3 FAIL\n"); ok=0;}
  ev_teach(W,54901,5404,1); ev_teach(W,54902,5404,2);
  ev_teach(W,54903,5406,54904); ev_teach(W,54904,5407,99);
  if(ev_query(W,54903,5408,99,0)!=99){emit("RET promoX FAIL\n"); ok=0;}
  if(ev_query(W,54911,5405,-2,0)!=-2){emit("RET miss1 FAIL\n"); ok=0;}
  if(ev_query(W,54912,5405,-2,0)!=-2){emit("RET miss2 FAIL\n"); ok=0;}
  ev_observe(W,54921,5409,5);
  np=np+sw_ret_probe(W,54101,5401,54201,"RETP01");
  np=np+sw_ret_probe(W,54201,5402,10,"RETP02");
  np=np+sw_ret_probe(W,54102,5401,54202,"RETP03");
  np=np+sw_ret_probe(W,54202,5402,20,"RETP04");
  np=np+sw_ret_probe(W,54103,5401,54203,"RETP05");
  np=np+sw_ret_probe(W,54203,5402,30,"RETP06");
  np=np+sw_ret_probe(W,54101,5403,10,"RETP07");
  np=np+sw_ret_probe(W,54102,5403,20,"RETP08");
  np=np+sw_ret_probe(W,54103,5403,30,"RETP09");
  np=np+sw_ret_probe(W,54901,5404,1,"RETP10");
  np=np+sw_ret_probe(W,54903,5408,99,"RETP11");
  np=np+sw_ret_probe(W,54101,5401,54201,"RETP12");
  emit("RET probes="); e64(np); emit("/12\n");
  if(np!=12){emit("RET KB-R1 FAIL\n"); ok=0;}
  let mc:i32=sw_map_con(W);
  emit("RET map-CON="); e64(mc); emit(" (expect 0: no spurious supersession)\n");
  if(mc!=0){emit("RET spurious-CON FAIL\n"); ok=0;}
  if(ok==1){emit("RET DONE-OK\n");} else {emit("RET DONE-FAIL\n");}
  sw_dump(W);
  return ok;
}

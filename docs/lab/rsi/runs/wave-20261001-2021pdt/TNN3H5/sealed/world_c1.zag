// world_c1.zag -- C-family world 1 (contradiction).
// Relation families 5201/5202/5203, dense subjects. Four double-contradiction
// probes on the SECOND chain link plus two revert probes (teach, contradict,
// revert) on the answer fact. One supplementary bridge-key observation.
fn sw_c1_double(W:[]u8,a:i32,b:i32,c0:i32,c1:i32,c2:i32,tag:[]u8)i32 {
  let ok:i32=1;
  ev_teach(W,a,5201,b); ev_teach(W,b,5202,c0);
  if(ev_query(W,a,5203,c0,0)!=c0){emit(tag); emit(" promo FAIL\n"); ok=0;}
  let mc0:i32=sw_map_con(W);
  if(ev_observe(W,b,5202,c1)!=0){emit(tag); emit(" contra1-ret FAIL\n"); ok=0;}
  if(ev_query(W,b,5202,-2,0)!=c1){emit(tag); emit(" reder1 FAIL\n"); ok=0;}
  if(ev_observe(W,b,5202,c2)!=0){emit(tag); emit(" contra2-ret FAIL\n"); ok=0;}
  let q:i32=ev_query(W,b,5202,-2,0);
  emit(tag); emit(" final="); e64(q); emit(" (expect "); e64(c2); emit(")\n");
  if(q!=c2){emit(tag); emit(" KB-B2 FAIL\n"); ok=0;}
  let d:i32=sw_map_con(W)-mc0;
  emit(tag); emit(" mapCON-delta="); e64(d); emit(" (expect >=1)\n");
  if(d<1){emit(tag); emit(" KB-W2 FAIL\n"); ok=0;}
  return ok;
}
fn sw_c1_revert(W:[]u8,a:i32,b:i32,v0:i32,v1:i32,tag:[]u8)i32 {
  let ok:i32=1;
  ev_teach(W,a,5201,b); ev_teach(W,b,5202,v0);
  let fa:i32=sw_first_fact(W,b,5202,v0);
  emit(tag); emit(" FA-node="); e64(fa); emit("\n");
  if(fa<2){emit(tag); emit(" FA-missing FAIL\n"); ok=0;}
  if(ev_query(W,a,5203,v0,0)!=v0){emit(tag); emit(" promo FAIL\n"); ok=0;}
  if(ev_query(W,b,5202,-2,0)!=v0){emit(tag); emit(" pre FAIL\n"); ok=0;}
  ev_observe(W,b,5202,v1);
  if(is_superseded(W,fa)!=1){emit(tag); emit(" FA-not-superseded FAIL\n"); ok=0;}
  ev_observe(W,b,5202,v0);
  let q:i32=ev_query(W,b,5202,-2,0);
  emit(tag); emit(" final="); e64(q); emit(" (expect "); e64(v0); emit(")\n");
  if(q!=v0){emit(tag); emit(" KB-B3-query FAIL\n"); ok=0;}
  if(is_superseded(W,fa)!=1){emit(tag); emit(" FA-CON-lost FAIL\n"); ok=0;}
  let live:i32=sw_live_fact(W,b,5202);
  emit(tag); emit(" live-node="); e64(live); emit(" FA-node="); e64(fa); emit("\n");
  if(live==fa){emit(tag); emit(" KB-B3-stale-node FAIL\n"); ok=0;}
  if(live<2){emit(tag); emit(" KB-B3-no-live FAIL\n"); ok=0;}
  if(ng(W,live,28)!=v0){emit(tag); emit(" KB-B3-live-val FAIL\n"); ok=0;}
  return ok;
}
fn sealed_main()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ok:i32=1;
  if(sw_c1_double(W,52101,52201,100,200,300,"C1D1")==0){ok=0;}
  if(sw_c1_double(W,52102,52202,101,201,301,"C1D2")==0){ok=0;}
  if(sw_c1_double(W,52103,52203,102,202,302,"C1D3")==0){ok=0;}
  if(sw_c1_double(W,52104,52204,103,203,303,"C1D4")==0){ok=0;}
  if(sw_c1_revert(W,52401,52501,400,500,"C1R1")==0){ok=0;}
  if(sw_c1_revert(W,52402,52502,401,501,"C1R2")==0){ok=0;}
  if(ok==1){emit("C1 DONE-OK\n");} else {emit("C1 DONE-FAIL\n");}
  let sq:i32=ev_query(W,52101,5203,-2,0);
  emit("C1S bridge-query="); e64(sq); emit(" (supplementary, non-bar)\n");
  sw_dump(W);
  return ok;
}

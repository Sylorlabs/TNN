// sealed_common.zag -- adversary white-box counters + canonical state dump.
// Appended to a byte-copy of tnn3_h5.zag whose main is replaced by
// sealed_main. Pure Zag; compiled and run with the pinned znc.

// Guide-class CON count. Guide class per frozen prereg Q3 ruling:
// tag 1, field24 == -999, type-1 edge to a tag-30 node; CON = type-3 self-edge.
fn sw_guide_con(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==-999){
      let e:i32=0; let isg:i32=0;
      while(e<4096){
        if(eg(W,e,0)==n && eg(W,e,4)==1 && ng(W,eg(W,e,8),0)==30){isg=1;}
        e=e+1;
      }
      if(isg==1 && is_superseded(W,n)==1){c=c+1;}
    }
    n=n+1;
  }
  return c;
}
// Live (non-superseded) guide-class count.
fn sw_guide_live(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==-999){
      let e:i32=0; let isg:i32=0;
      while(e<4096){
        if(eg(W,e,0)==n && eg(W,e,4)==1 && ng(W,eg(W,e,8),0)==30){isg=1;}
        e=e+1;
      }
      if(isg==1 && is_superseded(W,n)==0){c=c+1;}
    }
    n=n+1;
  }
  return c;
}
// MAP-class (tag 20) CON count.
fn sw_map_con(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && is_superseded(W,n)==1){c=c+1;}
    n=n+1;
  }
  return c;
}
// First (lowest id) fact node matching (s,r,o); -1 if none.
fn sw_first_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// Node id of the live (non-superseded) fact for (s,r); -1 if none, -2 if several.
fn sw_live_fact(W:[]u8,s:i32,r:i32)i32 {
  let f:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && is_superseded(W,n)==0){
      if(f==-1){f=n;} else {f=-2;}
    }
    n=n+1;
  }
  return f;
}
// Resolution probe: observe (s,r,v), re-present subject, ev_act. Returns ev_act.
fn sw_resolve_probe(W:[]u8,s:i32,r:i32,v:i32)i32 {
  ev_observe(W,s,r,v);
  ctx_push(W,s);
  return ev_act(W);
}
// Canonical full state dump: headers, all allocated nodes (10 fields),
// all live edges (4 fields). Deterministic given deterministic W.
fn sw_dump(W:[]u8)void {
  emit("DUMP-BEGIN\n");
  let h:i32=0;
  while(h<64){ emit("H "); e64(h); emit(" "); e64(hg(W,h)); emit("\n"); h=h+4; }
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1){
      emit("N "); e64(n);
      let f:i32=0;
      while(f<=36){ emit(" "); e64(ng(W,n,f)); f=f+4; }
      emit("\n");
    }
    n=n+1;
  }
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      emit("E "); e64(eg(W,e,0)); emit(" "); e64(eg(W,e,4));
      emit(" "); e64(eg(W,e,8)); emit(" "); e64(eg(W,e,12)); emit("\n");
    }
    e=e+1;
  }
  emit("DUMP-END\n");
  return;
}

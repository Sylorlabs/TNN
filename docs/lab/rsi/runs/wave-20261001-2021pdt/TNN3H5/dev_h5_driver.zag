
// dev_h5_driver.zag -- DEVELOPMENT harness for H5 (builder's own worlds).
// NOT sealed. Tests the H5 mechanisms on builder-designed worlds only.
// Appended to a copy of tnn3_h5.zag; main is replaced by dev_main.

fn dev_guide_con(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==-999){
      let e:i32=0; let isg:i32=0;
      while(e<4096){
        if(eg(W,e,0)==n && eg(W,e,4)==1 && ng(W,eg(W,e,8),0)==30){isg=1;}
        e=e+1;
      }
      if(isg==1 && is_superseded(W,n)==1){c=c+1;}
    }
    n=n+1;
  }
  return c;
}
fn dev_map_con(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && is_superseded(W,n)==1){c=c+1;}
    n=n+1;
  }
  return c;
}
fn dev_fact_con(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){
      return is_superseded(W,n);
    }
    n=n+1;
  }
  return -1;
}
fn dev_d1_resolution()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s1:i32=7001; let r1:i32=701;
  if(ev_query(W,s1,r1,-2,0)!=-2){emit("D1 miss FAIL\n"); return 0;}
  if(dev_guide_con(W)!=0){emit("D1 pre-CON FAIL\n"); return 0;}
  ev_observe(W,s1,r1,42);
  let gc:i32=dev_guide_con(W);
  emit("D1 guide-CON="); e64(gc); emit("\n");
  if(gc<1){emit("D1 guide-CON FAIL\n"); return 0;}
  ctx_push(W,s1);
  let a:i32=ev_act(W);
  emit("D1 ev_act="); e64(a); emit("\n");
  if(a!=0){emit("D1 ev_act FAIL\n"); return 0;}
  emit("D1 PASS\n"); return 1;
}
fn dev_d2_contradiction()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  if(ev_query(W,101,40,201,0)!=201){emit("D2 query FAIL\n"); return 0;}
  if(dev_map_con(W)!=0){emit("D2 pre-CON FAIL\n"); return 0;}
  if(ev_observe(W,102,12,999)!=0){emit("D2 observe-ret FAIL\n"); return 0;}
  let mc:i32=dev_map_con(W);
  emit("D2 map-CON="); e64(mc); emit("\n");
  if(mc<1){emit("D2 map-CON FAIL\n"); return 0;}
  if(dev_fact_con(W,102,12,201)!=1){emit("D2 fact-CON FAIL\n"); return 0;}
  if(ev_query(W,102,12,-2,0)!=999){emit("D2 newfact FAIL\n"); return 0;}
  emit("D2 PASS\n"); return 1;
}
fn dev_d3_double()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,201,21,202); ev_teach(W,202,22,203);
  if(ev_query(W,201,50,203,0)!=203){emit("D3 query FAIL\n"); return 0;}
  ev_observe(W,202,22,209);
  ev_observe(W,202,22,219);
  let mc:i32=dev_map_con(W);
  emit("D3 map-CON="); e64(mc); emit("\n");
  if(mc<1){emit("D3 map-CON FAIL\n"); return 0;}
  if(ev_query(W,202,22,-2,0)!=219){emit("D3 twice-corrected FAIL\n"); return 0;}
  emit("D3 PASS\n"); return 1;
}
fn dev_d4_retention()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,301,31,302); ev_teach(W,302,32,303);
  if(ev_query(W,301,60,303,0)!=303){emit("D4 query FAIL\n"); return 0;}
  if(dev_map_con(W)!=0){emit("D4 unexpected-CON FAIL\n"); return 0;}
  if(ev_query(W,301,31,-2,0)!=302){emit("D4 fact1 FAIL\n"); return 0;}
  if(ev_query(W,302,32,-2,0)!=303){emit("D4 fact2 FAIL\n"); return 0;}
  if(ev_query(W,301,60,-2,0)!=303){emit("D4 derived FAIL\n"); return 0;}
  emit("D4 PASS\n"); return 1;
}
fn dev_d5_multiresolve()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let k:i32=0;
  while(k<4){
    let s:i32=8001+k; let r:i32=801;
    if(ev_query(W,s,r,-2,0)!=-2){emit("D5 miss FAIL\n"); return 0;}
    k=k+1;
  }
  if(dev_guide_con(W)!=0){emit("D5 pre-CON FAIL\n"); return 0;}
  k=0;
  while(k<4){
    let s:i32=8001+k; let r:i32=801;
    ev_observe(W,s,r,900+k);
    k=k+1;
  }
  let gc:i32=dev_guide_con(W);
  emit("D5 guide-CON="); e64(gc); emit("\n");
  if(gc!=4){emit("D5 guide-CON FAIL\n"); return 0;}
  k=0;
  while(k<4){
    let s:i32=8001+k;
    ctx_push(W,s);
    if(ev_act(W)!=0){emit("D5 ev_act FAIL\n"); return 0;}
    k=k+1;
  }
  emit("D5 PASS\n"); return 1;
}
fn dev_main()i32 {
  let ok:i32=1;
  if(dev_d1_resolution()==0){ok=0;}
  if(dev_d2_contradiction()==0){ok=0;}
  if(dev_d3_double()==0){ok=0;}
  if(dev_d4_retention()==0){ok=0;}
  if(dev_d5_multiresolve()==0){ok=0;}
  if(ok==1){emit("DEV ALL PASS\n");} else {emit("DEV FAIL\n");}
  return ok;
}

// cl_driver.zag -- CONTLEARN fixture driver (wave-20261001-2021pdt, lane CONTLEARN)
// Phase-2 implementation for frozen prereg PREREG_CONTLEARN.md (commit 2ed8fb7d3).
//
// FIXTURE ONLY. This file defines 0 cognition functions (no learning,
// retrieval, inference, retention, eviction, planning, derivation, revision,
// or execution logic), 0 new node tags, 0 new edge types, 0 new opcodes,
// 0 modes, 0 bridges, 0 routers, 0 task-specific handlers, 0 semantic cases.
// It emits the frozen event script, calls the frozen TNN-2 event API
// (ev_teach/ev_query/ev_observe), runs read-only white-box censuses through
// the core's own accessors (ng/eg/activate/is_superseded), and prints
// results. No branching-on-opcode statements anywhere in this file.
//
// Link: concatenated after the frozen core with that file's single
// `fn main` line stripped at build time (mechanical, diff-verified).
// All names here are cl_ prefixed; the frozen source contains zero cl_
// occurrences, so nothing collides and nothing is redefined.
//
// Run selection arrives on stdin (mode letter consumed by the driver only);
// argv is empty and the env is phase-free at launch. PHASE markers are
// driver-side prints; cognition receives only (kind, subject, relation,
// object) integer tuples through the single choke point cl_event, which
// logs every tuple and asserts kind in {TEACH=1, QUERY=2, OBSERVE=3}.

// ============ small fixture helpers ============
fn cl_streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
// FNV-1a over the full arena (signed i32 wrap; determinism is what matters).
fn cl_fnv(W:[]u8)i32 {
  let h:i32=-2128831035;
  let i:i32=0;
  while(i<110656){ h=(h ^ (W[i] as i32))*16777619; i=i+1; }
  return h;
}
fn cl_count_nodes(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
fn cl_count_edges(W:[]u8,ty:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1 && eg(W,e,4)==ty){c=c+1;} e=e+1; }
  return c;
}
fn cl_count_edges_all(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
// content-identified lookup: first alive tag-1 node holding (s,r,o).
fn cl_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// content-identified lookup: first alive tag-20 MAP with (field8=s, field4=r).
fn cl_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
// alive DEP edge from->to exists (dead slots carry from=-1, so this is exact).
fn cl_has_dep(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==1 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
// ============ the single cognition choke point (K1c audit) ============
// Every tuple the driver passes to cognition flows through here. kind:
// 1=TEACH, 2=QUERY, 3=OBSERVE. The tuple is logged before dispatch; header
// field 52 (unused by the frozen core) counts audited events.
fn cl_event(W:[]u8,kind:i32,s:i32,r:i32,o:i32,exp:i32)i32 {
  if(kind<1 || kind>3){ emit("AUDIT_FAIL kind="); e64(kind); emit("\n"); return -999; }
  emit("EV "); e64(kind); emit(" "); e64(s); emit(" "); e64(r); emit(" "); e64(o);
  hs(W,52,hg(W,52)+1);
  if(kind==1){ let q:i32=ev_teach(W,s,r,o); emit("\n"); return q; }
  if(kind==2){ let a:i32=ev_query(W,s,r,exp,0); emit(" ans="); e64(a); emit("\n"); return a; }
  let v:i32=ev_observe(W,s,r,o); emit(" rv="); e64(v); emit("\n"); return v;
}
// ============ frozen phases (exact tuples from prereg section 3) ============
fn cl_p1_teach(W:[]u8)void {
  emit("PHASE P1\n");
  let i:i32=0;
  while(i<12){ cl_event(W,1,5001+i,101,5101+i,0); i=i+1; }
  return;
}
fn cl_p1_query(W:[]u8)i32 {
  let sc:i32=0; let i:i32=0;
  while(i<12){
    let a:i32=cl_event(W,2,5001+i,101,5101+i,5101+i);
    if(a==5101+i){sc=sc+1;}
    i=i+1;
  }
  emit("P1_SCORE "); e64(sc); emit("/12\n");
  return sc;
}
// P2: teaches, queries, R1c, engagement flags. ans2/eng are 6-slot i32 bufs.
fn cl_p2(W:[]u8,ans2:[]u8,eng:[]u8)i32 {
  emit("PHASE P2\n");
  let i:i32=0;
  while(i<6){ cl_event(W,1,6001+i,201,5001+i,0); i=i+1; }
  let sc:i32=0; i=0;
  while(i<6){
    let a:i32=cl_event(W,2,6001+i,202,5101+i,5101+i);
    set32(ans2,i*4,a);
    if(a==5101+i){sc=sc+1;}
    i=i+1;
  }
  emit("P2_SCORE "); e64(sc); emit("/6\n");
  let r1c:i32=0; i=0;
  while(i<6){
    let eg:i32=0;
    let m:i32=cl_find_map(W,6001+i,202);
    let f:i32=cl_find_fact(W,5001+i,101,5101+i);
    if(m>=0 && f>=0 && cl_has_dep(W,m,f)==1 && get32(ans2,i*4)==5101+i){ eg=1; r1c=r1c+1; }
    set32(eng,i*4,eg);
    i=i+1;
  }
  emit("R1C "); e64(r1c); emit("\n");
  return r1c;
}
// Frozen T selection rule: first 3 engaged chains by ascending subject.
fn cl_select_T(eng:[]u8,Tb:[]u8)i32 {
  let n:i32=0; let i:i32=0;
  while(i<6 && n<3){
    if(get32(eng,i*4)==1){ set32(Tb,n*4,i); n=n+1; }
    i=i+1;
  }
  emit("T");
  let t:i32=0;
  while(t<n){ emit(" "); e64(get32(Tb,t*4)); t=t+1; }
  emit("\n");
  return n;
}
// P3: contradiction observes, probes, R2c. p3a/p3b are 3-slot i32 bufs.
fn cl_p3(W:[]u8,Tb:[]u8,nT:i32,p3a:[]u8,p3b:[]u8)i32 {
  emit("PHASE P3\n");
  let t:i32=0;
  while(t<nT){ let ti:i32=get32(Tb,t*4); cl_event(W,3,5001+ti,101,9101+ti,0); t=t+1; }
  t=0;
  while(t<nT){
    let ti:i32=get32(Tb,t*4);
    set32(p3a,t*4,cl_event(W,2,5001+ti,101,9101+ti,9101+ti));
    set32(p3b,t*4,cl_event(W,2,6001+ti,202,9101+ti,9101+ti));
    t=t+1;
  }
  let pr:i32=0; t=0;
  while(t<nT){
    let ti:i32=get32(Tb,t*4);
    if(get32(p3a,t*4)==9101+ti){pr=pr+1;}
    if(get32(p3b,t*4)==9101+ti){pr=pr+1;}
    t=t+1;
  }
  emit("P3_PROBES "); e64(pr); emit("/"); e64(nT*2); emit("\n");
  let r2c:i32=0; t=0;
  while(t<nT){
    let ti:i32=get32(Tb,t*4);
    let ok:i32=1;
    let m:i32=cl_find_map(W,6001+ti,202);
    if(m<0 || ng(W,m,28)!=9101+ti){ok=0;}
    let fo:i32=cl_find_fact(W,5001+ti,101,5101+ti);
    let cellok:i32=0;
    if(fo>=0){
      let c:i32=2;
      while(c<1024){
        if(ng(W,c,36)==1 && ng(W,c,0)==101 && cl_has_dep(W,c,fo)==1){
          let ln:i32=ng(W,c,8);
          if(ln>=2 && ln<1024 && ng(W,ln,0)==902 && ng(W,ln,20)==9101+ti){
            let g:i32=2; let gok:i32=0;
            while(g<1024){
              if(ng(W,g,36)==1 && ng(W,g,0)==102 && ng(W,g,12)==c){gok=1;}
              g=g+1;
            }
            if(gok==1){cellok=1;}
          }
        }
        c=c+1;
      }
    }
    if(cellok==0){ok=0;}
    let fa_old:i32=cl_find_fact(W,6001+ti,202,5101+ti);
    let fa_new:i32=cl_find_fact(W,6001+ti,202,9101+ti);
    if(fa_old<0 || is_superseded(W,fa_old)==0){ok=0;}
    if(fa_new<0 || is_superseded(W,fa_new)==1){ok=0;}
    if(get32(p3b,t*4)!=9101+ti){ok=0;}
    if(ok==1){r2c=r2c+1;}
    t=t+1;
  }
  emit("R2C "); e64(r2c); emit("\n");
  return r2c;
}
// P4: fact-level correction, R3c. p4a is a 3-slot i32 buf.
fn cl_p4(W:[]u8,p4a:[]u8)i32 {
  emit("PHASE P4\n");
  let j:i32=0;
  while(j<3){ cl_event(W,3,5010+j,101,9201+j,0); j=j+1; }
  let sc:i32=0; j=0;
  while(j<3){
    let a:i32=cl_event(W,2,5010+j,101,9201+j,9201+j);
    set32(p4a,j*4,a);
    if(a==9201+j){sc=sc+1;}
    j=j+1;
  }
  emit("P4_SCORE "); e64(sc); emit("/3\n");
  let r3c:i32=0; j=0;
  while(j<3){
    let fo:i32=cl_find_fact(W,5010+j,101,5110+j);
    let fnw:i32=cl_find_fact(W,5010+j,101,9201+j);
    if(fo>=0 && is_superseded(W,fo)==1 && fnw>=0 && is_superseded(W,fnw)==0 && get32(p4a,j*4)==9201+j){r3c=r3c+1;}
    j=j+1;
  }
  emit("R3C "); e64(r3c); emit("\n");
  return r3c;
}
// K4a snapshot: every alive edge (from,type,to) with type in {1,12}.
fn cl_snap_e4(W:[]u8,e4:[]u8)i32 {
  let ne:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && (eg(W,e,4)==1 || eg(W,e,4)==12)){
      set32(e4,ne*12,eg(W,e,0)); set32(e4,ne*12+4,eg(W,e,4)); set32(e4,ne*12+8,eg(W,e,8));
      ne=ne+1;
    }
    e=e+1;
  }
  emit("E4_EDGES "); e64(ne); emit("\n");
  return ne;
}
// P5: unrelated interference load.
fn cl_p5(W:[]u8)i32 {
  emit("PHASE P5\n");
  let k:i32=0;
  while(k<40){ cl_event(W,1,7001+k,301,7101+k,0); k=k+1; }
  let sc:i32=0; k=0;
  while(k<40){
    let a:i32=cl_event(W,2,7001+k,301,7101+k,7101+k);
    if(a==7101+k){sc=sc+1;}
    k=k+1;
  }
  emit("P5_SCORE "); e64(sc); emit("/40\n");
  return sc;
}
fn cl_in_T(Tb:[]u8,nT:i32,i:i32)i32 {
  let t:i32=0;
  while(t<nT){ if(get32(Tb,t*4)==i){return 1;} t=t+1; }
  return 0;
}
fn cl_e1(i:i32,Tb:[]u8,nT:i32)i32 {
  if(cl_in_T(Tb,nT,i)==1){return 9101+i;}
  if(i>=9){return 9201+(i-9);}
  return 5101+i;
}
fn cl_e2(i:i32,Tb:[]u8,nT:i32)i32 {
  if(cl_in_T(Tb,nT,i)==1){return 9101+i;}
  return 5101+i;
}
// serving-node check: activate's node must be the content-expected live fact.
fn cl_serve_ok(W:[]u8,s:i32,r:i32,exp:i32,got:i32)i32 {
  if(got!=exp){return 0;}
  let n:i32=activate(W,s,r);
  if(n<2){return 0;}
  if(ng(W,n,36)!=1 || ng(W,n,0)!=1){return 0;}
  if(ng(W,n,20)!=s || ng(W,n,24)!=r || ng(W,n,28)!=exp){return 0;}
  if(is_superseded(W,n)==1){return 0;}
  return 1;
}
// K4d: white-box cause for each lost fact or unanswerable chain.
fn cl_diag4(W:[]u8,s:i32,r:i32,exp:i32,got:i32,tag:i32)void {
  emit("DIAG "); e64(tag); emit(" ");
  let f:i32=cl_find_fact(W,s,r,exp);
  if(f<0){
    let n:i32=2; let sup:i32=0;
    while(n<1024){
      if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && is_superseded(W,n)==1){sup=1;}
      n=n+1;
    }
    if(sup==1){emit("superseded-no-live\n");}
    else {emit("no-fact\n");}
  } else {
    if(is_superseded(W,f)==1){emit("fact-superseded\n");}
    else { if(got!=exp){emit("wrong-answer\n");} else {emit("serve-diff\n");} }
  }
  return;
}
// P6: delayed-reuse probes, R4c/R5c. r4d is a 2-slot i32 buf; raw is 1-slot.
fn cl_p6(W:[]u8,Tb:[]u8,nT:i32,r4d:[]u8,raw:[]u8)i32 {
  emit("PHASE P6\n");
  let r4c:i32=0; let pr:i32=0; let i:i32=0;
  while(i<12){
    let e:i32=cl_e1(i,Tb,nT);
    let a:i32=cl_event(W,2,5001+i,101,e,e);
    if(a==e){pr=pr+1;}
    if(cl_serve_ok(W,5001+i,101,e,a)==1){r4c=r4c+1;}
    else { cl_diag4(W,5001+i,101,e,a,i); }
    i=i+1;
  }
  emit("R4C "); e64(r4c); emit("\n");
  let r5c:i32=0; i=0;
  while(i<6){
    let e:i32=cl_e2(i,Tb,nT);
    let a:i32=cl_event(W,2,6001+i,202,e,e);
    if(a==e){pr=pr+1;}
    if(cl_serve_ok(W,6001+i,202,e,a)==1){r5c=r5c+1;}
    else { cl_diag4(W,6001+i,202,e,a,100+i); }
    i=i+1;
  }
  emit("R5C "); e64(r5c); emit("\n");
  set32(r4d,0,r4c); set32(r4d,4,r5c); set32(raw,0,pr);
  return 0;
}
// read-only census after a phase.
fn cl_census(W:[]u8,ph:[]u8)void {
  emit("CENSUS "); emit(ph);
  emit(" N1="); e64(cl_count_nodes(W,1));
  emit(" N20="); e64(cl_count_nodes(W,20));
  emit(" N30="); e64(cl_count_nodes(W,30));
  emit(" N101="); e64(cl_count_nodes(W,101));
  emit(" N102="); e64(cl_count_nodes(W,102));
  emit(" N902="); e64(cl_count_nodes(W,902));
  emit(" E1="); e64(cl_count_edges(W,1));
  emit(" E12="); e64(cl_count_edges(W,12));
  emit(" Eall="); e64(cl_count_edges_all(W));
  emit("\n");
  return;
}
// K4a: every E4 member still alive at end of run.
fn cl_k4a(W:[]u8,e4:[]u8,ne:i32)i32 {
  let miss:i32=0; let k:i32=0;
  while(k<ne){
    let fr:i32=get32(e4,k*12); let ty:i32=get32(e4,k*12+4); let to:i32=get32(e4,k*12+8);
    let e:i32=0; let found:i32=0;
    while(e<4096){
      if(eg(W,e,0)==fr && eg(W,e,4)==ty && eg(W,e,8)==to){found=1;}
      e=e+1;
    }
    if(found==0){miss=miss+1; emit("K4A_LOST "); e64(fr); emit(" "); e64(ty); emit(" "); e64(to); emit("\n");}
    k=k+1;
  }
  emit("K4A_MISSING "); e64(miss); emit("\n");
  return miss;
}
// K4b: all 6 P2 MAPs alive at end of run.
fn cl_k4b(W:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<6){ if(cl_find_map(W,6001+i,202)>=0){c=c+1;} i=i+1; }
  emit("K4B_MAPS "); e64(c); emit("/6\n");
  return c;
}
// K5b: C-P6 cross-phase reuse must be 0 by construction; verify it.
fn cl_k5b(W:[]u8,raw6:i32)i32 {
  emit("K5B_SCORE "); e64(raw6); emit("/18\n");
  let n20:i32=cl_count_nodes(W,20);
  emit("K5B_N20 "); e64(n20); emit("\n");
  let bad:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)!=-999){bad=bad+1;}
    n=n+1;
  }
  emit("K5B_TAG1_BAD "); e64(bad); emit("\n");
  if(raw6==0 && n20==0 && bad==0){return 1;}
  return 0;
}
fn cl_want_events(mode:i32)i32 {
  if(mode==1){return 149;}
  if(mode==2){return 24;}
  if(mode==3){return 24;}
  if(mode==4){return 33;}
  if(mode==5){return 18;}
  if(mode==6){return 80;}
  return 18;
}
fn cl_modelabel(mode:i32)[]u8 {
  if(mode==1){return "TREAT";}
  if(mode==2){return "C-P1";}
  if(mode==3){return "C-P2";}
  if(mode==4){return "C-P3";}
  if(mode==5){return "C-P4";}
  if(mode==6){return "C-P5";}
  return "C-P6";
}
// ============ entry ============
fn cl_main()i32 {
  let md:[]u8=_zag_read_file("/dev/stdin");
  let mode:i32=0;
  if(cl_streq(md,"TREAT")==1){mode=1;}
  else { if(cl_streq(md,"C-P1")==1){mode=2;}
  else { if(cl_streq(md,"C-P2")==1){mode=3;}
  else { if(cl_streq(md,"C-P3")==1){mode=4;}
  else { if(cl_streq(md,"C-P4")==1){mode=5;}
  else { if(cl_streq(md,"C-P5")==1){mode=6;}
  else { if(cl_streq(md,"C-P6")==1){mode=7;} } } } } } }
  if(mode==0){ emit("MODE_FAIL\n"); return 1; }
  emit("MODE "); emit(cl_modelabel(mode)); emit("\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ans2:[]u8=z_alloc(24); let eng:[]u8=z_alloc(24);
  let Tb:[]u8=z_alloc(12); let p3a:[]u8=z_alloc(12); let p3b:[]u8=z_alloc(12);
  let p4a:[]u8=z_alloc(12); let e4:[]u8=z_alloc(49152);
  let r4d:[]u8=z_alloc(8); let raw:[]u8=z_alloc(4);
  let need_p1t:i32=0; let need_p1q:i32=0; let need_p2:i32=0; let need_p3:i32=0;
  let need_p4:i32=0; let need_p5:i32=0; let need_p6:i32=0;
  if(mode==1){need_p1t=1;need_p1q=1;need_p2=1;need_p3=1;need_p4=1;need_p5=1;need_p6=1;}
  if(mode==2){need_p1t=1;need_p1q=1;}
  if(mode==3){need_p1t=1;need_p2=1;}
  if(mode==4){need_p1t=1;need_p2=1;need_p3=1;}
  if(mode==5){need_p1t=1;need_p4=1;}
  if(mode==6){need_p5=1;}
  if(mode==7){need_p6=1;}
  let s1:i32=0; let r1c:i32=0; let nT:i32=0; let r2c:i32=0;
  let r3c:i32=0; let ne4:i32=0; let s5:i32=0;
  if(need_p1t==1){ cl_p1_teach(W); }
  if(need_p1q==1){ s1=cl_p1_query(W); }
  if(need_p1t==1 || need_p1q==1){ cl_census(W,"P1"); }
  if(need_p2==1){ r1c=cl_p2(W,ans2,eng); nT=cl_select_T(eng,Tb); cl_census(W,"P2"); }
  if(need_p3==1){ r2c=cl_p3(W,Tb,nT,p3a,p3b); cl_census(W,"P3"); }
  if(need_p4==1){ r3c=cl_p4(W,p4a); ne4=cl_snap_e4(W,e4); cl_census(W,"P4"); }
  if(need_p5==1){ s5=cl_p5(W); cl_census(W,"P5"); }
  if(need_p6==1){
    cl_p6(W,Tb,nT,r4d,raw);
    cl_census(W,"P6");
    if(mode==1){
      let r4c:i32=get32(r4d,0); let r5c:i32=get32(r4d,4);
      let reuse:i32=r1c+r2c+r3c+r4c+r5c;
      emit("REUSE_COUNT "); e64(reuse); emit("\n");
      let k4am:i32=cl_k4a(W,e4,ne4);
      let k4bm:i32=cl_k4b(W);
      emit("K4C_R4C "); e64(r4c); emit("\n");
      if(k4am!=0 || k4bm!=6){ emit("K4_VIOLATION\n"); }
    }
    if(mode==7){
      let k5b:i32=cl_k5b(W,get32(raw,0));
      if(k5b==0){ emit("K5B_VIOLATION\n"); }
    }
  }
  emit("UNCERT "); e64(cl_count_nodes(W,30)); emit("\n");
  emit("FNV "); e64(cl_fnv(W)); emit("\n");
  let want:i32=cl_want_events(mode);
  if(hg(W,52)==want){ emit("AUDIT_PASS\n"); }
  else { emit("AUDIT_FAIL count="); e64(hg(W,52)); emit(" want="); e64(want); emit("\n"); return 1; }
  return 0;
}
fn main()i32 { return cl_main(); }

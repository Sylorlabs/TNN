// ============ TNN3H1-ADVERSARY DRIVER SHIM ============
// Zero-cognition world-event interface for frozen TNN-3 (H1 build).
// Public protocol: OBSERVE s r o / QUERY s r expected / ACT lines.
// This code contains NO cognition: no semantic cases, no modes,
// no handlers, no task identities, no name pre-seeding. It parses
// integers and dispatches to the learner's pre-existing public
// interface (ev_observe, ev_query, ev_act). All cognition lives in
// the learner functions above; the shim is transport.
// The harness NEVER creates handle cells, NAME edges, or sequence
// roots; K-H1-1 counts only learner-created names.

fn adv_errln(s:[]u8)void { _zag_eprintln(s); return; }

fn adv_line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn adv_skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn adv_field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn adv_is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn adv_parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn adv_is_observe(d:[]u8,s:i32)i32 {
  if(d[s]==79 && d[s+1]==66 && d[s+2]==83 && d[s+3]==69 && d[s+4]==82 && d[s+5]==86 && d[s+6]==69){ return 1; }
  return 0;
}
fn adv_is_query(d:[]u8,s:i32)i32 {
  if(d[s]==81 && d[s+1]==85 && d[s+2]==69 && d[s+3]==82 && d[s+4]==89){ return 1; }
  return 0;
}
fn adv_is_act(d:[]u8,s:i32)i32 {
  if(d[s]==65 && d[s+1]==67 && d[s+2]==84){ return 1; }
  return 0;
}

// Process one world-file line. Returns:
//  0 = blank/ignored, 1 = OBSERVE, 2 = QUERY, 3 = ACT, -1 = parse error.
fn adv_process_line(W:[]u8,d:[]u8,ls:i32,le:i32)i32 {
  let f0s:i32=adv_skip_ws(d,ls,le);
  if(f0s>=le){ return 0; }
  let f0e:i32=adv_field_end(d,f0s,le);
  let wl:i32=f0e-f0s;
  if(wl==7 && adv_is_observe(d,f0s)==1){
    let s1:i32=adv_skip_ws(d,f0e,le);
    let e1:i32=adv_field_end(d,s1,le);
    let s2:i32=adv_skip_ws(d,e1,le);
    let e2:i32=adv_field_end(d,s2,le);
    let s3:i32=adv_skip_ws(d,e2,le);
    let e3:i32=adv_field_end(d,s3,le);
    if(s1>=le || s2>=le || s3>=le){ return -1; }
    if(adv_is_int(d,s1,e1)==0 || adv_is_int(d,s2,e2)==0 || adv_is_int(d,s3,e3)==0){ return -1; }
    if(adv_skip_ws(d,e3,le)<le){ return -1; }
    let subj:i32=adv_parse_i32(d,s1,e1);
    let rel:i32=adv_parse_i32(d,s2,e2);
    let obj:i32=adv_parse_i32(d,s3,e3);
    ev_observe(W,subj,rel,obj);
    emit("OBSERVED "); e64(subj); emit(" "); e64(rel); emit(" "); e64(obj); emit("\n");
    return 1;
  }
  if(wl==5 && adv_is_query(d,f0s)==1){
    let s1:i32=adv_skip_ws(d,f0e,le);
    let e1:i32=adv_field_end(d,s1,le);
    let s2:i32=adv_skip_ws(d,e1,le);
    let e2:i32=adv_field_end(d,s2,le);
    let s3:i32=adv_skip_ws(d,e2,le);
    let e3:i32=adv_field_end(d,s3,le);
    if(s1>=le || s2>=le || s3>=le){ return -1; }
    if(adv_is_int(d,s1,e1)==0 || adv_is_int(d,s2,e2)==0 || adv_is_int(d,s3,e3)==0){ return -1; }
    if(adv_skip_ws(d,e3,le)<le){ return -1; }
    let subj:i32=adv_parse_i32(d,s1,e1);
    let rel:i32=adv_parse_i32(d,s2,e2);
    let exp:i32=adv_parse_i32(d,s3,e3);
    let v:i32=ev_query(W,subj,rel,exp,0);
    emit("ANSWER "); e64(subj); emit(" "); e64(rel); emit(" "); e64(v); emit("\n");
    return 2;
  }
  if(wl==3 && adv_is_act(d,f0s)==1){
    if(adv_skip_ws(d,f0e,le)<le){ return -1; }
    let c:i32=ev_act(W);
    emit("CHOICE "); e64(c); emit("\n");
    return 3;
  }
  return -1;
}

fn adv_drive_world(W:[]u8,d:[]u8)i32 {
  let n:i32=_zag_strlen(d);
  let s:i32=0;
  let lineno:i32=0;
  let nev:i32=0;
  let nq:i32=0;
  emit("WORLD_BEGIN\n");
  while(s<n){
    let le:i32=adv_line_end(d,s,n);
    lineno=lineno+1;
    let rc:i32=adv_process_line(W,d,s,le);
    if(rc==-1){
      emit("ERROR line "); e64(lineno); emit("\n");
      return -1;
    }
    if(rc>0){ nev=nev+1; }
    if(rc==2){ nq=nq+1; }
    s=le+1;
  }
  emit("WORLD_END events="); e64(nev); emit(" answers="); e64(nq); emit("\n");
  return 0;
}

fn main()i32 {
  if(_zag_argc()!=3){
    adv_errln("usage: adv_shim3_bin <world.txt> <state.bin>");
    return 2;
  }
  let world_path:[]u8=_zag_arg(1);
  let state_path:[]u8=_zag_arg(2);
  if(_zag_file_exists(world_path)==0){
    adv_errln("world file missing");
    return 2;
  }
  let W:[]u8=z_alloc(110656);
  if(_zag_file_exists(state_path)==1){
    let sb:[]u8=_zag_read_file(state_path);
    if(_zag_strlen(sb)!=110656){
      adv_errln("state file corrupt: length != 110656");
      return 2;
    }
    let i:i32=0;
    while(i<110656){ W[i]=sb[i]; i=i+1; }
  } else {
    tnn2_init(W);
  }
  let d:[]u8=_zag_read_file(world_path);
  if(adv_drive_world(W,d)!=0){
    return 1;
  }
  if(_zag_write_file(state_path,W)!=0){
    adv_errln("state write failed");
    return 1;
  }
  emit("STATE_SAVED\n");
  return 0;
}
// ============ END TNN3H1-ADVERSARY DRIVER SHIM ============

// adv_inspect.zag -- white-box name-object inspector for TNN3H1 sealed eval.
// Usage: adv_inspect_bin <state.bin>
// Scans for handle cells (tag 904) and NAME edges (type 11).
// Reports handle node id, all node fields (to identify the handle value
// field empirically), and each NAME edge's source/destination.
// Read-only. Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn sng(W:[]u8,n:i32,f:i32)i32 { return ig(W,64+n*40+f); }
fn seg(W:[]u8,e:i32,f:i32)i32 { return ig(W,41024+e*16+f); }

fn main()i32 {
  if(_zag_argc()!=2){
    errln("usage: adv_inspect_bin <state.bin>");
    return 2;
  }
  let W:[]u8=_zag_read_file(_zag_arg(1));
  if(W.len<110656){ errln("state.bin too short"); return 3; }
  // Count used nodes and edges for context.
  let used:i32=0;
  let n:i32=2;
  while(n<1024){
    if(sng(W,n,36)==1){ used=used+1; }
    n=n+1;
  }
  emit("USED_NODES "); e64(used); emit("\n");
  let ue:i32=0;
  let e:i32=0;
  while(e<4096){
    if(seg(W,e,0)!=-1){ ue=ue+1; }
    e=e+1;
  }
  emit("USED_EDGES "); e64(ue); emit("\n");
  // Handle cells: tag 904.
  let nh:i32=0;
  n=2;
  while(n<1024){
    if(sng(W,n,36)==1 && sng(W,n,0)==904){
      nh=nh+1;
      emit("HANDLE node="); e64(n);
      emit(" f0="); e64(sng(W,n,0));
      emit(" f4="); e64(sng(W,n,4));
      emit(" f8="); e64(sng(W,n,8));
      emit(" f12="); e64(sng(W,n,12));
      emit(" f16="); e64(sng(W,n,16));
      emit(" f20="); e64(sng(W,n,20));
      emit(" f24="); e64(sng(W,n,24));
      emit(" f28="); e64(sng(W,n,28));
      emit(" f32="); e64(sng(W,n,32));
      emit("\n");
    }
    n=n+1;
  }
  emit("HANDLE_COUNT "); e64(nh); emit("\n");
  // NAME edges: type 11.
  let ne:i32=0;
  e=0;
  while(e<4096){
    if(seg(W,e,0)!=-1 && seg(W,e,4)==11){
      ne=ne+1;
      emit("NAMEEDGE e="); e64(e);
      emit(" src="); e64(seg(W,e,0));
      emit(" dst="); e64(seg(W,e,8));
      emit(" f12="); e64(seg(W,e,12));
      emit("\n");
    }
    e=e+1;
  }
  emit("NAMEEDGE_COUNT "); e64(ne); emit("\n");
  return 0;
}

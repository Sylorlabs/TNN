// h1_dev.zag -- H1 DEVELOPMENT harness (development only).
// Demonstrates AFF-LINK / AFF-NAME / AFF-EXEC on the frozen tnn3 machinery.
// Build: strip tnn3.zag's main line, concatenate this file, compile with
// the pinned znc. Pure Zag. No Python. Deterministic: no time, no hash
// order, fixed edge scan order.
//
// NAME white-box convention (documented for the sealed counting tool):
//   handle cell tag = 904, field20 = learner-chosen handle value,
//   NAME edge type = 11 (ET_REG, unused by the frozen baseline).

fn h1d_ET_NAME()i32 { return 11; }
fn h1d_TAG_HANDLE()i32 { return 904; }

// name_seq: create a handle cell with a learner-chosen handle value and a
// NAME edge handle -> root. Returns the handle node, or -1.
fn h1d_name_seq(W:[]u8,handle:i32,root:i32)i32 {
  let h:i32=alloc_node(W); if(h<0){return -1;}
  ns(W,h,0,h1d_TAG_HANDLE()); ns(W,h,20,handle);
  link_edge(W,h,h1d_ET_NAME(),root,0);
  return h;
}

// run_frame: execute root on a fresh frame with slot0=in; return slot0
// after execution, or -999999 on failure.
fn h1d_run_frame(W:[]u8,root:i32,in:i32)i32 {
  let fr:i32=alloc_node(W); if(fr<0){return -999999;}
  ns(W,fr,0,902); fr_set(W,fr,0,in); fr_set(W,fr,1,0);
  if(execute(W,root,fr)!=1){return -999999;}
  return fr_get(W,fr,0);
}

// find a handle cell by learner-chosen handle value. Returns node or -1.
fn h1d_find_handle(W:[]u8,handle:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==h1d_TAG_HANDLE() && ng(W,n,20)==handle){return n;}
    n=n+1;
  }
  return -1;
}

// first NAME-edge target of a handle cell, or -1.
fn h1d_name_target(W:[]u8,h:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==h && eg(W,e,4)==h1d_ET_NAME()){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}

// count incoming SEQ (type 12) edges to a node.
fn h1d_seq_incoming(W:[]u8,t:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==12 && eg(W,e,8)==t){c=c+1;}
    e=e+1;
  }
  return c;
}

// count NAME-edge targets of a handle cell.
fn h1d_name_fanout(W:[]u8,h:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==h && eg(W,e,4)==h1d_ET_NAME()){c=c+1;}
    e=e+1;
  }
  return c;
}

fn h1d_pass(n:[]u8)void { emit("DEV "); emit(n); emit(" PASS\n"); return; }
fn h1d_fail(n:[]u8)void { emit("DEV "); emit(n); emit(" FAIL\n"); return; }

// DEV1: AFF-LINK + AFF-EXEC. LINK two INC cells into a sequence, NAME it,
// EXECUTE on two instances; both correct (reuse across instances).
fn h1d_dev1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let c1:i32=t2_inc(W,0); if(c1<0){return 0;}
  let c2:i32=t2_inc(W,0); if(c2<0){return 0;}
  seq_link(W,c1,c2);
  let h:i32=h1d_name_seq(W,7001,c1); if(h<0){return 0;}
  if(h1d_run_frame(W,c1,5)!=7){return 0;}
  if(h1d_run_frame(W,c1,40)!=42){return 0;}
  return 1;
}

// DEV2: AFF-NAME white-box. The name object is observable: handle cell with
// learner-chosen value, one NAME edge to the sequence root.
fn h1d_dev2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let c1:i32=t2_inc(W,0); if(c1<0){return 0;}
  let c2:i32=t2_inc(W,0); if(c2<0){return 0;}
  seq_link(W,c1,c2);
  let h:i32=h1d_name_seq(W,7001,c1); if(h<0){return 0;}
  let f:i32=h1d_find_handle(W,7001);
  if(f!=h){return 0;}
  if(h1d_name_target(W,f)!=c1){return 0;}
  if(h1d_name_fanout(W,f)!=1){return 0;}
  if(h1d_find_handle(W,7002)>=0){return 0;}
  return 1;
}

// DEV3: composition (C1 family shape). P=[INC] named 7201, Q=[INC,INC]
// named 7202, composite C named 7203 referencing both named procedures.
// Executing C runs P then Q on one frame: 10 -> 11 -> 13.
fn h1d_dev3()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let p:i32=t2_inc(W,0); if(p<0){return 0;}
  let hp:i32=h1d_name_seq(W,7201,p); if(hp<0){return 0;}
  let q1:i32=t2_inc(W,0); if(q1<0){return 0;}
  let q2:i32=t2_inc(W,0); if(q2<0){return 0;}
  seq_link(W,q1,q2);
  let hq:i32=h1d_name_seq(W,7202,q1); if(hq<0){return 0;}
  let hc:i32=h1d_name_seq(W,7203,p); if(hc<0){return 0;}
  link_edge(W,hc,h1d_ET_NAME(),q1,0);
  if(h1d_name_fanout(W,hc)!=2){return 0;}
  let fr:i32=alloc_node(W); if(fr<0){return 0;}
  ns(W,fr,0,902); fr_set(W,fr,0,10); fr_set(W,fr,1,0);
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==hc && eg(W,e,4)==h1d_ET_NAME()){
      if(execute(W,eg(W,e,8),fr)!=1){return 0;}
    }
    e=e+1;
  }
  if(fr_get(W,fr,0)!=13){return 0;}
  return 1;
}

// DEV4: shared-step diamond (C2 family shape). One shared step S named
// 7301, linked by SEQ from two parent graphs A and B. White-box: exactly
// one S object, two incoming SEQ edges. A: 10 -> 12. B: 10 -> 10.
fn h1d_dev4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s:i32=t2_inc(W,0); if(s<0){return 0;}
  let hs:i32=h1d_name_seq(W,7301,s); if(hs<0){return 0;}
  let a1:i32=t2_inc(W,0); if(a1<0){return 0;}
  seq_link(W,a1,s);
  let ha:i32=h1d_name_seq(W,7302,a1); if(ha<0){return 0;}
  let b1:i32=t2_cell(W,104); if(b1<0){return 0;}
  ns(W,b1,4,1000);
  seq_link(W,b1,s);
  let hb:i32=h1d_name_seq(W,7303,b1); if(hb<0){return 0;}
  if(h1d_find_handle(W,7301)!=hs){return 0;}
  if(h1d_seq_incoming(W,s)!=2){return 0;}
  if(h1d_run_frame(W,a1,10)!=12){return 0;}
  if(h1d_run_frame(W,b1,10)!=10){return 0;}
  if(h1d_run_frame(W,s,10)!=11){return 0;}
  return 1;
}

// DEV5: the researcher-fixed schema menu is gone. A miss that the frozen
// trial loop used to answer now returns -2, and no trial stats are written.
fn h1d_dev5()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  let ans:i32=ev_query(W,101,40,201,0);
  if(ans!=-2){return 0;}
  if(hg(W,16)!=0){return 0;}
  return 1;
}

// DEV6: guard/set cells still constructible via generic machinery; a
// failing guard aborts execution (-999999), a passing guard flows through.
fn h1d_dev6()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let lx:i32=t2_lit(W,5); if(lx<0){return 0;}
  let g:i32=t2_guard(W,0,lx); if(g<0){return 0;}
  let st:i32=t2_set(W,0,lx); if(st<0){return 0;}
  ns(W,g,12,st);
  if(h1d_run_frame(W,g,5)!=5){return 0;}
  if(h1d_run_frame(W,g,6)!=-999999){return 0;}
  return 1;
}

fn h1d_main()i32 {
  let pass:i32=0; let total:i32=0;
  total=total+1; if(h1d_dev1()==1){pass=pass+1; h1d_pass("LINK-EXEC");} else {h1d_fail("LINK-EXEC");}
  total=total+1; if(h1d_dev2()==1){pass=pass+1; h1d_pass("NAME-WB");} else {h1d_fail("NAME-WB");}
  total=total+1; if(h1d_dev3()==1){pass=pass+1; h1d_pass("COMPOSE");} else {h1d_fail("COMPOSE");}
  total=total+1; if(h1d_dev4()==1){pass=pass+1; h1d_pass("DIAMOND");} else {h1d_fail("DIAMOND");}
  total=total+1; if(h1d_dev5()==1){pass=pass+1; h1d_pass("NO-MENU");} else {h1d_fail("NO-MENU");}
  total=total+1; if(h1d_dev6()==1){pass=pass+1; h1d_pass("GUARD-SET");} else {h1d_fail("GUARD-SET");}
  emit("DEV-TOTAL "); e64(pass); emit("/"); e64(total); emit("\n");
  if(pass==total){return 0;}
  return 1;
}
fn main()i32 { return h1d_main(); }

// f2v3_world_cprime.zag -- SEALED World C-prime (independent adversary).
// Post-freeze sealed world for the F2v3 distinguishability evaluation.
// TRUE LAWS (sealed): (X -> Y1, delay 2, J == 1);
// (X -> Y2, delay 3, K == 1). X has no law (decays).
// Declared context variables: J, K (persistent: retain value across WAIT,
// change only via SET/CLR). Passive: 16 steps, X pulses at t = 2, 7, 12,
// J = 1 and K = 1 throughout (J, K established at t = 0; both persistent).
// Goal setup: J = 0, K = 0 (both gates WRONG: 1 - j1, 1 - k1).
// Goalvar interface: [Y1, Y2, J, K] with values [1, 1, 1, 1].
// Concatenate AFTER f2v3_learner.zag. Also usable with the frozen v2
// learner (f2v2_learner.zag) for the NC3 ablation.

fn CP_D1()i32 { return 2; }
fn CP_D2()i32 { return 3; }
fn CP_J1()i32 { return 1; }
fn CP_K1()i32 { return 1; }

fn w_goal_mode()i32 { return 2; }
fn w_nvars()i32 { return 5; }
fn w_nctrl()i32 { return 3; }
fn w_ctrl(i:i32)i32 {
  if(i==0){ return 0; } // X
  if(i==1){ return 3; } // J
  return 4;             // K
}
fn w_npass()i32 { return 16; }
fn w_nctx()i32 { return 5; }
fn w_ctx_cx(i:i32)i32 {
  if(i==0){ return 255; } // ALWAYS
  if(i==1){ return 3; }   // J
  if(i==2){ return 3; }   // J
  if(i==3){ return 4; }   // K
  return 4;               // K
}
fn w_ctx_cv(i:i32)i32 {
  if(i==0){ return 0; } // ALWAYS (cv unused)
  if(i==1){ return 0; } // J == 0
  if(i==2){ return 1; } // J == 1
  if(i==3){ return 0; } // K == 0
  return 1;             // K == 1
}
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Y1"; }
  if(v==2){ return "Y2"; }
  if(v==3){ return "J"; }
  return "K";
}
fn w_worldname()[]u8 { return "Cprime-dual-contextual-SEALED"; }
fn w_plan_maxd()i32 { return 9; }
// Goalvar interface (prereg section 5): sustained predicate variables and
// target values, ascending variable order. Keeps the learner world-agnostic.
fn w_ngoalvars()i32 { return 4; }
fn w_goalvar(i:i32)i32 {
  if(i==0){ return 1; } // Y1
  if(i==1){ return 2; } // Y2
  if(i==2){ return 3; } // J
  return 4;             // K
}
fn w_goalval(i:i32)i32 {
  if(i==0){ return 1; } // Y1 = 1
  if(i==1){ return 1; } // Y2 = 1
  if(i==2){ return CP_J1(); } // J = j1
  return CP_K1();             // K = k1
}

fn D_truerules()[]u8 {
  let r:[]u8=z_alloc(10);
  r[0]=0; r[1]=1; r[2]=CP_D1() as u8; r[3]=3; r[4]=CP_J1() as u8; // X -> Y1 delay d1 iff J==j1
  r[5]=0; r[6]=2; r[7]=CP_D2() as u8; r[8]=4; r[9]=CP_K1() as u8; // X -> Y2 delay d2 iff K==k1
  return r;
}
fn D_cxs()[]u8 {
  let c:[]u8=z_alloc(5);
  c[0]=255; c[1]=3; c[2]=3; c[3]=4; c[4]=4;
  return c;
}

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (nvars*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+5*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    let hist:[]u8=ws[8..8+5*32];
    L_advance(hist,t,D_truerules(),2,5,D_cxs(),5);
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<5){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule (sealed): 16 steps, t = 0..15. Environment SETs X
// at t = 2, 7, 12. J = 1 and K = 1 throughout (established at t = 0;
// both persistent).
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==0){ ws[8+3*32+t]=1; ws[8+4*32+t]=1; }
  if(t==2 || t==7 || t==12){ ws[8+0*32+t]=1; }
  return;
}
// Goal setup (disclosed schema): environment establishes J = 1 - j1 and
// K = 1 - k1 (both gating contexts WRONG), then RESET to t = 0. Called
// after w_reset, so both values hold by reset here (j1 = 1, k1 = 1);
// written explicitly to document the schema.
fn w_goal_setup(ws:[]u8)void {
  ws[8+3*32+0]=0; // J = 0 = 1 - j1 (j1 = 1)
  ws[8+4*32+0]=0; // K = 0 = 1 - k1 (k1 = 1)
  return;
}
// Unused for goal mode 2 (C2 uses the triple predicate in the learner).
fn w_goal_met(vals:[]u8)i32 { return 0; }

// Harness adjudication for K4-R4 (C-prime contract, prereg section 8):
// the loop terminates with exactly one survivor, and its Y1 rule equals
// (X, d1, J == j1) and its Y2 rule equals (X, d2, K == k1). The X rule is
// not part of the contract (X has no true law).
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  let ty1:i32=-1; let ty2:i32=-1;
  let j:i32=0;
  while(j<36){
    let b:i32=(1*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==CP_D1() &&
       (candbuf[b+3] as i32)==3 && (candbuf[b+4] as i32)==CP_J1()){ ty1=j; }
    j=j+1;
  }
  j=0;
  while(j<36){
    let b:i32=(2*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==CP_D2() &&
       (candbuf[b+3] as i32)==4 && (candbuf[b+4] as i32)==CP_K1()){ ty2=j; }
    j=j+1;
  }
  let p1:i32=-1; let p2:i32=-1;
  j=0;
  while(j<ne){
    if((evars[j] as i32)==1){ p1=j; }
    if((evars[j] as i32)==2){ p2=j; }
    j=j+1;
  }
  let ok:i32=0;
  emit("K4-R4 ty1="); e64(ty1); emit(" ty2="); e64(ty2);
  emit(" nalive="); e64(nalive); emit(" exhausted="); e64(exhausted); emit("\n");
  if(nalive==1 && ty1>=0 && ty2>=0 && p1>=0 && p2>=0){
    let h:i32=0;
    while(h<nhyp){
      if(alive[h]==1){
        emit("  survivor hyp"); e64(h);
        emit(" Y1rule="); e64(hysel[h*ne+p1] as i32);
        emit(" Y2rule="); e64(hysel[h*ne+p2] as i32); emit("\n");
        if((hysel[h*ne+p1] as i32)==ty1 && (hysel[h*ne+p2] as i32)==ty2){ ok=1; }
      }
      h=h+1;
    }
  }
  if(ok==1){
    emit("K4-R4 PASS\n");
    return 1;
  }
  emit("K4-R4 FAIL\n");
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  if(m==63){ emit("F2V3_CPRIME PROGRAM_ALL_BARS_PASS\n"); return 0; }
  emit("F2V3_CPRIME PROGRAM_FAIL mask="); e64(m); emit("\n");
  return 1;
}

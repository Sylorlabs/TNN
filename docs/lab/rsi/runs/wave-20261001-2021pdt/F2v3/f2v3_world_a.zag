// f2v3_world_a.zag -- Sealed World A: confounded chain (F2 v3).
// REPLICATED EXACTLY from F2/AUTOSCI2/v2 (same physics, goal, planner,
// control). Concatenate AFTER f2v3_learner.zag.
// TRUE LAWS (sealed from learner): (X->Z,delay2), (Z->Y,delay1), (X->D,delay1).
// D is a confounder: follows X, correlates with Y, causes nothing.
// The learner only sees the w_* interface. w_verify is harness adjudication.
// Goal mode 0 = final-state goal.
// v3 delta: w_verify implements K4-R4 (truth survives AND termination by
// exhaustion; the v2 nalive count is NOT frozen because DPDS may
// legitimately resolve the pair). Goalvar interface stubs added for the
// shared learner (unused in goal mode 0).

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 4; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 3; } // X, D
fn w_npass()i32 { return 12; }
fn w_nctx()i32 { return 1; }
fn w_ctx_cx(i:i32)i32 { return 255; } // ALWAYS
fn w_ctx_cv(i:i32)i32 { return 0; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Z"; }
  if(v==2){ return "Y"; }
  return "D";
}
fn w_worldname()[]u8 { return "A-confounded-chain"; }
fn w_plan_maxd()i32 { return 8; }
// Goalvar interface: unused in goal mode 0 (stubs for the shared learner).
fn w_ngoalvars()i32 { return 0; }
fn w_goalvar(i:i32)i32 { return 0; }
fn w_goalval(i:i32)i32 { return 0; }

fn A_truerules()[]u8 {
  let r:[]u8=z_alloc(15);
  r[0]=0; r[1]=1; r[2]=2; r[3]=255; r[4]=0;    // X -> Z delay 2
  r[5]=1; r[6]=2; r[7]=1; r[8]=255; r[9]=0;    // Z -> Y delay 1
  r[10]=0; r[11]=3; r[12]=1; r[13]=255; r[14]=0; // X -> D delay 1
  return r;
}
fn A_cxs()[]u8 {
  let c:[]u8=z_alloc(1);
  c[0]=255;
  return c;
}

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (nvars*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+4*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    let hist:[]u8=ws[8..8+4*32];
    L_advance(hist,t,A_truerules(),3,4,A_cxs(),1);
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<4){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: environment SETs X at t=2 and t=8. Uses world's own clock.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==2 || t==8){ ws[8+0*32+t]=1; }
  return;
}
fn w_goal_setup(ws:[]u8)void { return; } // start from all-zero
fn w_goal_met(vals:[]u8)i32 {
  if(vals[0]==1 && vals[2]==1 && vals[3]==0){ return 1; }
  return 0;
}

// Harness adjudication for K4-R4. Knows the sealed truth; the learner does not.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  // true candidate indices: Z:(X,2), Y:(Z,1), D:(X,1)
  let tz:i32=-1; let ty:i32=-1; let td:i32=-1;
  let j:i32=0;
  while(j<36){
    let b:i32=(1*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==2 && (candbuf[b+3] as i32)==255){ tz=j; }
    j=j+1;
  }
  j=0;
  while(j<36){
    let b:i32=(2*36+j)*5;
    if((candbuf[b] as i32)==1 && (candbuf[b+2] as i32)==1 && (candbuf[b+3] as i32)==255){ ty=j; }
    j=j+1;
  }
  j=0;
  while(j<36){
    let b:i32=(3*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==1 && (candbuf[b+3] as i32)==255){ td=j; }
    j=j+1;
  }
  // positions of Z, Y, D in evars
  let pz:i32=-1; let py:i32=-1; let pd:i32=-1;
  j=0;
  while(j<ne){
    if((evars[j] as i32)==1){ pz=j; }
    if((evars[j] as i32)==2){ py=j; }
    if((evars[j] as i32)==3){ pd=j; }
    j=j+1;
  }
  let true_h:i32=-1;
  let h:i32=0;
  while(h<nhyp){
    if(pz>=0 && py>=0 && pd>=0 &&
       (hysel[h*ne+pz] as i32)==tz && (hysel[h*ne+py] as i32)==ty && (hysel[h*ne+pd] as i32)==td){ true_h=h; }
    h=h+1;
  }
  emit("K4-R4 true_h="); e64(true_h);
  emit(" alive=");
  if(true_h>=0){ e64(alive[true_h]); } else { emit("-1"); }
  emit(" nalive="); e64(nalive);
  emit(" exhausted="); e64(exhausted); emit("\n");
  // v3 K4-R4: the true hypothesis {Z<-(X,2), Y<-(Z,1), D<-(X,1)} survives
  // AND the loop terminates by exhaustion (no live pair distinguishable
  // to D2). The v2 nalive count is NOT frozen: DPDS may legitimately
  // resolve the pair (nalive 2 -> 1), which also satisfies "no live pair
  // distinguishable" vacuously.
  if(true_h>=0 && alive[true_h]==1 && (exhausted==1 || nalive==1)){
    emit("K4-R4 PASS\n");
    return 1;
  }
  emit("K4-R4 FAIL\n");
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  if(m==63){ emit("F2V3_A PROGRAM_ALL_BARS_PASS\n"); return 0; }
  emit("F2V3_A PROGRAM_FAIL mask="); e64(m); emit("\n");
  return 1;
}

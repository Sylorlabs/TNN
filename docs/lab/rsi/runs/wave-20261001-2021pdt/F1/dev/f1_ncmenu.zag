// f1_ncmenu.zag - NEGATIVE CONTROL (NC-A / menu teeth), dev scaffolding only.
// Implements the REPEXPAND-1 kill pattern on purpose: a fixed-order scan over
// a researcher-enumerated family of COMPLETE candidate solutions, each a
// researcher-written semantic case, reified as the "structure".
// The K-C0A source audit must flag menu_f0/menu_f1/menu_f2 and the scan loop:
// behavioral success on the dev world does not save it.
// usage: f1_ncmenu episodes pred_out

// ---- researcher-enumerated complete candidate family (the kill pattern) ----
fn menu_f0(x:i64)i64 { return x + x; }        // F_DOUBLE: researcher case
fn menu_f1(x:i64)i64 { return x + x + x; }    // F_TRIPLE: researcher case
fn menu_f2(x:i64)i64 { return x + 1; }        // F_INC: researcher case

fn menu_apply(which:i64, x:i64)i64 {
    if(which == 0) { return menu_f0(x); }
    if(which == 1) { return menu_f1(x); }
    return menu_f2(x);
}

fn labs(v:i64)i64 { if(v < 0) { return 0 - v; } return v; }

fn main()i32 {
    if(_zag_argc() < 3) {
        _zag_println("usage: f1_ncmenu episodes pred_out");
        return 2;
    }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { _zag_println("ERR empty"); return 2; }
    // fixed-order scan over the researcher-enumerated family (the menu)
    let best:i64 = 0;
    let best_err:i64 = 999999999;
    let m:i64 = 0;
    while(m < 3) {
        let err:i64 = 0;
        let p:i64 = 0;
        while(p < text.len) {
            let q:i64 = p;
            while(q < text.len && text[q] != 10) { q = q + 1; }
            let line:[]u8 = text[p..q];
            if(q < text.len) { q = q + 1; }
            p = q;
            if(line.len > 0) {
                // parse "x y-or-?"
                let s:i64 = 0;
                while(s < line.len && line[s] != 32) { s = s + 1; }
                let x:i64 = _zag_str_to_i64(line[0..s]);
                let t:i64 = s + 1;
                while(t < line.len && line[t] == 32) { t = t + 1; }
                if(t < line.len && line[t] != 63) {
                    let y:i64 = _zag_str_to_i64(line[t..line.len]);
                    err = err + labs(menu_apply(m, x) - y);
                }
            }
        }
        if(err < best_err) { best_err = err; best = m; }
        m = m + 1;
    }
    // predict every episode with the reified menu choice
    let out:[]u8 = "";
    let p2:i64 = 0;
    while(p2 < text.len) {
        let q:i64 = p2;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p2..q];
        if(q < text.len) { q = q + 1; }
        p2 = q;
        if(line.len > 0) {
            let s:i64 = 0;
            while(s < line.len && line[s] != 32) { s = s + 1; }
            let xstr:[]u8 = line[0..s];
            let x:i64 = _zag_str_to_i64(xstr);
            let pl:[]u8 = _zag_str_concat(xstr, " ");
            pl = _zag_str_concat(pl, _zag_i64_to_str(menu_apply(best, x)));
            pl = _zag_str_concat(pl, "\n");
            out = _zag_str_concat(out, pl);
        }
    }
    let rc:i64 = _zag_write_file(_zag_arg(2), out);
    _zag_print("MENU_PICK ");
    _zag_print(_zag_i64_to_str(best));
    _zag_print(" train_err=");
    _zag_print(_zag_i64_to_str(best_err));
    _zag_print(" rc=");
    _zag_println(_zag_i64_to_str(rc));
    return 0;
}

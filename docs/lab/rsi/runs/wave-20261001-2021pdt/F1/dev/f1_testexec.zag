// f1_testexec.zag - MACHINERY UNIT TEST (test scaffolding, NOT the candidate).
// Exercises interpreter paths the development worlds do not reach: EXECUTE
// composition over a learner-named graph, BRANCH conditional skip, and the
// step-cap termination guard. Graphs here are hand-built in test code to
// probe the machinery; nothing here is claimed as learner invention.
// Reports CHECK lines; exit nonzero on any failure.

@import("../impl/f1_isa.zag")

fn check(name:[]u8, actual:i64, expected:i64)i32 {
    _zag_print("CHECK,");
    _zag_print(name);
    _zag_print(",");
    _zag_print(_zag_i64_to_str(actual));
    _zag_print(",");
    _zag_println(_zag_i64_to_str(expected));
    if(actual != expected) { return 1; }
    return 0;
}

fn main()i32 {
    let fails:i32 = 0;
    let S:[]u8 = st_new_empty();
    if(S.len == 0) { _zag_println("ERR alloc"); return 2; }

    // T1: EXECUTE composition. g0 doubles; main triples via EXECUTE g0 + ADD.
    let g0:i64 = st_gadd(S, 1);
    st_nadd(S, g0, 4, 0, 0, 8, 0, 0);   // ADD r0, r0, f0
    st_nadd(S, g0, 4, 0, 0, 8, 0, 0);   // ADD r0, r0, f0
    st_nadd(S, g0, 2, 0, 0, 0, 0, 0);   // WRITE r0
    let gm:i64 = st_gadd(S, 0);
    st_nadd(S, gm, 7, 1, 1, 0, 0, 0);   // EXECUTE r1, g0
    st_nadd(S, gm, 4, 2, 1, 8, 0, 0);   // ADD r2, r1, f0
    st_nadd(S, gm, 2, 2, 0, 0, 0, 0);   // WRITE r2
    let regs:[]u8 = f1_alloc(64);
    let frame:[]u8 = f1_alloc(48);
    if(regs.len == 0 || frame.len == 0) { _zag_println("ERR alloc"); return 2; }
    let k:i64 = 0;
    while(k < 8) { f1_is(regs, k, 0); k = k + 1; }
    f1_is(frame, 0, 1);
    f1_is(frame, 1, 5);
    fails = fails + check("exec_compose_3x", f1_exec(S, gm, regs, frame, 0, ""), 15);

    // T2: BRANCH conditional skip. EQ r1, f0, f0 -> r1=1; BRANCH r1, 3 skips
    // the ADD; WRITE r0 -> 0. With x=9 the skipped ADD would give 9.
    let g2:i64 = st_gadd(S, 2);
    st_nadd(S, g2, 5, 1, 8, 8, 0, 0);   // EQ r1, f0, f0
    st_nadd(S, g2, 6, 1, 3, 0, 0, 0);   // BRANCH r1, 3
    st_nadd(S, g2, 4, 0, 0, 8, 0, 0);   // ADD r0, r0, f0 (skipped)
    st_nadd(S, g2, 2, 0, 0, 0, 0, 0);   // WRITE r0
    k = 0;
    while(k < 8) { f1_is(regs, k, 0); k = k + 1; }
    f1_is(frame, 1, 9);
    fails = fails + check("branch_skip", f1_exec(S, g2, regs, frame, 0, ""), 0);

    // T3: BRANCH not taken falls through. EQ r1, f0, f1 -> f1 reads 0 slot
    // (nframe=1) so r1=0 for x=7; ADD runs; WRITE r0 -> 7.
    let g3:i64 = st_gadd(S, 3);
    st_nadd(S, g3, 5, 1, 8, 9, 0, 0);   // EQ r1, f0, f1(zero)
    st_nadd(S, g3, 6, 1, 3, 0, 0, 0);   // BRANCH r1, 3 (not taken)
    st_nadd(S, g3, 4, 0, 0, 8, 0, 0);   // ADD r0, r0, f0
    st_nadd(S, g3, 2, 0, 0, 0, 0, 0);   // WRITE r0
    k = 0;
    while(k < 8) { f1_is(regs, k, 0); k = k + 1; }
    f1_is(frame, 1, 7);
    fails = fails + check("branch_fallthrough", f1_exec(S, g3, regs, frame, 0, ""), 7);

    // T4: runaway BRANCH terminates via the step cap (no hang).
    let g4:i64 = st_gadd(S, 4);
    st_nadd(S, g4, 5, 1, 8, 8, 0, 0);   // EQ r1, f0, f0 -> r1=1
    st_nadd(S, g4, 6, 1, 1, 0, 0, 0);   // BRANCH r1, 1 (self loop)
    st_nadd(S, g4, 2, 0, 0, 0, 0, 0);   // WRITE r0 (unreached)
    k = 0;
    while(k < 8) { f1_is(regs, k, 0); k = k + 1; }
    f1_is(frame, 1, 4);
    fails = fails + check("branch_stepcap", f1_exec(S, g4, regs, frame, 0, ""), 0);

    // T5: EXECUTE of unknown name is a safe no-op (0), not a crash.
    let g5:i64 = st_gadd(S, 5);
    st_nadd(S, g5, 7, 3, 9, 0, 0, 0);   // EXECUTE r3, name 9 (absent)
    st_nadd(S, g5, 2, 3, 0, 0, 0, 0);   // WRITE r3
    k = 0;
    while(k < 8) { f1_is(regs, k, 0); k = k + 1; }
    f1_is(frame, 1, 4);
    fails = fails + check("exec_unknown_name", f1_exec(S, g5, regs, frame, 0, ""), 0);

    _zag_print("TESTEXEC fails=");
    _zag_println(_zag_i64_to_str(fails as i64));
    if(fails != 0) { return 1; }
    return 0;
}

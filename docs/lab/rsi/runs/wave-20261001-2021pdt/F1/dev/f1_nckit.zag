// f1_nckit.zag - NEGATIVE CONTROL (NC-B / menu teeth), dev scaffolding only.
// Implements the PI_REV2 kill pattern on purpose: a finite construction kit
// whose ONLY possible output is one researcher-fixed shape (an equality test
// of the input against a constant), plus a frozen ascending rank over the
// constant. Every kit output is an instance of the single fixed shape, so the
// K-C0B automatic-kit kill fires on source inspection alone, regardless of
// behavioral success on the kit's home world.
// usage: f1_nckit episodes pred_out

fn labs(v:i64)i64 { if(v < 0) { return 0 - v; } return v; }

// ---- finite construction kit: one researcher-fixed output shape ----
// kit_emit builds the ONLY structure this kit can produce:
//   OUT = (x == K) ? 1 : 0
// All outputs are instances of this single shape; K is the only parameter.
fn kit_emit(x:i64, k:i64)i64 {
    if(x == k) { return 1; }
    return 0;
}

fn main()i32 {
    if(_zag_argc() < 3) {
        _zag_println("usage: f1_nckit episodes pred_out");
        return 2;
    }
    let text:[]u8 = _zag_read_file(_zag_arg(1));
    if(text.len == 0) { _zag_println("ERR empty"); return 2; }
    // frozen ascending rank over the kit parameter (the PI_REV2 rank pattern)
    let bestk:i64 = 0;
    let best_err:i64 = 999999999;
    let k:i64 = 0;
    while(k < 10) {
        let err:i64 = 0;
        let p:i64 = 0;
        while(p < text.len) {
            let q:i64 = p;
            while(q < text.len && text[q] != 10) { q = q + 1; }
            let line:[]u8 = text[p..q];
            if(q < text.len) { q = q + 1; }
            p = q;
            if(line.len > 0) {
                let s:i64 = 0;
                while(s < line.len && line[s] != 32) { s = s + 1; }
                let x:i64 = _zag_str_to_i64(line[0..s]);
                let t:i64 = s + 1;
                while(t < line.len && line[t] == 32) { t = t + 1; }
                if(t < line.len && line[t] != 63) {
                    let y:i64 = _zag_str_to_i64(line[t..line.len]);
                    err = err + labs(kit_emit(x, k) - y);
                }
            }
        }
        if(err < best_err) { best_err = err; bestk = k; }
        k = k + 1;
    }
    let out:[]u8 = "";
    let p2:i64 = 0;
    while(p2 < text.len) {
        let q:i64 = p2;
        while(q < text.len && text[q] != 10) { q = q + 1; }
        let line:[]u8 = text[p2..q];
        if(q < text.len) { q = q + 1; }
        p2 = q;
        if(line.len > 0) {
            let s:i64 = 0;
            while(s < line.len && line[s] != 32) { s = s + 1; }
            let xstr:[]u8 = line[0..s];
            let x:i64 = _zag_str_to_i64(xstr);
            let pl:[]u8 = _zag_str_concat(xstr, " ");
            pl = _zag_str_concat(pl, _zag_i64_to_str(kit_emit(x, bestk)));
            pl = _zag_str_concat(pl, "\n");
            out = _zag_str_concat(out, pl);
        }
    }
    let rc:i64 = _zag_write_file(_zag_arg(2), out);
    _zag_print("KIT_PICK k=");
    _zag_print(_zag_i64_to_str(bestk));
    _zag_print(" train_err=");
    _zag_print(_zag_i64_to_str(best_err));
    _zag_print(" rc=");
    _zag_println(_zag_i64_to_str(rc));
    return 0;
}

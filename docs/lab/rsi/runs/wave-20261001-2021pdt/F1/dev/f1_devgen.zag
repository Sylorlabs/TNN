// f1_devgen.zag - development world generator for F1 (dev scaffolding only).
// These worlds are the builder's own development fixtures, strictly separate
// from any sealed protocol. The sealed adversarial family comes from an
// independent adversary after freeze; the builder never sees sealed worlds.
//
// usage: f1_devgen law x0 x1 mode outfile
//   law:  dbl (y=2x) | tpl (y=3x) | alt (alternates 2x/5x every 3 episodes)
//         | eq (y=1 iff x==3 else 0)
//   mode: train (x y) | hide (x ?) | truth (x y, scorer use)

fn gen_law(law:[]u8, x:i64)i64 {
    if(_zag_strcmp(law, "dbl") == 1) { return x + x; }
    if(_zag_strcmp(law, "tpl") == 1) { return x + x + x; }
    if(_zag_strcmp(law, "alt") == 1) {
        let blk:i64 = x / 3;
        if((blk % 2) == 0) { return x + x; }
        return x + x + x + x + x;
    }
    if(_zag_strcmp(law, "eq") == 1) {
        if(x == 3) { return 1; }
        return 0;
    }
    return 0;
}

fn main()i32 {
    if(_zag_argc() < 6) {
        _zag_println("usage: f1_devgen law x0 x1 mode outfile");
        return 2;
    }
    let law:[]u8 = _zag_arg(1);
    let x0:i64 = _zag_str_to_i64(_zag_arg(2));
    let x1:i64 = _zag_str_to_i64(_zag_arg(3));
    let mode:[]u8 = _zag_arg(4);
    let out:[]u8 = _zag_arg(5);
    let hide:i64 = 0;
    if(_zag_strcmp(mode, "hide") == 1) { hide = 1; }
    let cap:i64 = (x1 - x0) * 32 + 64;
    if(cap < 64) { cap = 64; }
    let b:[]u8 = "";
    // build via repeated concat; sizes are small
    let x:i64 = x0;
    let n:i64 = 0;
    while(x < x1) {
        let y:i64 = gen_law(law, x);
        let line:[]u8 = _zag_str_concat(_zag_i64_to_str(x), " ");
        if(hide == 1) {
            line = _zag_str_concat(line, "?\n");
        } else {
            line = _zag_str_concat(line, _zag_str_concat(_zag_i64_to_str(y), "\n"));
        }
        b = _zag_str_concat(b, line);
        x = x + 1;
        n = n + 1;
    }
    let rc:i64 = _zag_write_file(out, b);
    _zag_print("DEVGEN law=");
    _zag_print(law);
    _zag_print(" n=");
    _zag_print(_zag_i64_to_str(n));
    _zag_print(" rc=");
    _zag_println(_zag_i64_to_str(rc));
    return 0;
}

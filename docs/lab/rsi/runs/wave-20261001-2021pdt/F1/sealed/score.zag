// score.zag - independent adversary scorer for the F1 sealed evaluation.
// Pure Zag, compiled by the pinned znc. No shared code with impl/.
// Modes:
//   score <train.ep> <hidden.truth> <pred.txt> [trace.txt]
//     Reports: hidden_n, accuracy of pred vs truth, exact-match memorizer
//     accuracy (same example budget), bounded single-node brute-force oracle
//     accuracy (exhaustive single-ISA-element search over the same candidate
//     enumeration the constructor uses, oracle-picked by train error), and
//     EXEC main count from the trace when given.
//   score ops <statefile>
//     Reports the op sequence of graph 0 (main) for isomorphism checks.

fn z_alloc(n:i64)[]u8 {
    if(n < 1) { return ""; }
    let p:*u8 = _zag_malloc(n) as *u8;
    if(p == null as *u8) { return ""; }
    let b:[]u8 = p[0..n];
    let i:i64 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn zg(b:[]u8, i:i64)i64 {
    let o:i64 = i * 8;
    let v:i64 = 0;
    let k:i64 = 0;
    while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
    return v;
}

fn zset(b:[]u8, i:i64, v:i64)void {
    let o:i64 = i * 8;
    let k:i64 = 0;
    while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
}

fn has_more(text:[]u8, pos:[]u8)i64 {
    if(zg(pos, 0) < text.len) { return 1; }
    return 0;
}

fn next_line(text:[]u8, pos:[]u8)[]u8 {
    let p:i64 = zg(pos, 0);
    let q:i64 = p;
    while(q < text.len && text[q] != 10) { q = q + 1; }
    let line:[]u8 = text[p..q];
    if(q < text.len) { q = q + 1; }
    zset(pos, 0, q);
    return line;
}

fn ntok(line:[]u8)i64 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            n = n + 1;
            while(p < line.len && line[p] != 32) { p = p + 1; }
        }
    }
    return n;
}

fn tok(line:[]u8, idx:i64)[]u8 {
    let n:i64 = 0;
    let p:i64 = 0;
    while(p < line.len) {
        while(p < line.len && line[p] == 32) { p = p + 1; }
        if(p < line.len) {
            let q:i64 = p;
            while(q < line.len && line[q] != 32) { q = q + 1; }
            if(n == idx) { return line[p..q]; }
            n = n + 1;
            p = q;
        }
    }
    return "";
}

fn starts_with(line:[]u8, pre:[]u8)i64 {
    if(line.len < pre.len) { return 0; }
    let i:i64 = 0;
    while(i < pre.len) {
        if(line[i] != pre[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn labs(v:i64)i64 { if(v < 0) { return 0 - v; } return v; }

// Parse episodes: xs gets e*4+k cells, ys gets e cells. Returns count, or -1.
// n_in_out cell 0 receives n_in.
fn parse_eps(text:[]u8, xs:[]u8, ys:[]u8, n_in_out:[]u8, cap:i64)i64 {
    let pos:[]u8 = z_alloc(8);
    if(pos.len == 0) { return -1; }
    let n:i64 = 0;
    let nin:i64 = -1;
    while(has_more(text, pos) == 1 && n < cap) {
        let line:[]u8 = next_line(text, pos);
        if(line.len > 0) {
            let t:i64 = ntok(line);
            if(t < 2 || t - 1 > 4) { return -1; }
            if(nin < 0) { nin = t - 1; zset(n_in_out, 0, nin); }
            if(t - 1 != nin) { return -1; }
            let k:i64 = 0;
            while(k < nin) {
                zset(xs, n * 4 + k, _zag_str_to_i64(tok(line, k)));
                k = k + 1;
            }
            zset(ys, n, _zag_str_to_i64(tok(line, t - 1)));
            n = n + 1;
        }
    }
    return n;
}

fn operand(regs:[]u8, fr:[]u8, n_in:i64, v:i64)i64 {
    if(v >= 0 && v < 8) { return zg(regs, v); }
    if(v >= 8 && v < 16) {
        let f:i64 = v - 8;
        if(f >= 0 && f < n_in) { return zg(fr, f); }
        return 0;
    }
    return 0;
}

// Simulate [candidate node, terminal WRITE r0] on one input row.
fn sim1(op:i64, p1:i64, p2:i64, p3:i64, xs:[]u8, e:i64, n_in:i64)i64 {
    let regs:[]u8 = z_alloc(64);
    let fr:[]u8 = z_alloc(32);
    if(regs.len == 0 || fr.len == 0) { return 0; }
    let k:i64 = 0;
    while(k < n_in) { zset(fr, k, zg(xs, e * 4 + k)); k = k + 1; }
    if(op == 1) {
        if(p1 >= 0 && p1 < 8) { zset(regs, p1, operand(regs, fr, n_in, p2)); }
    } else if(op == 2) {
        // candidate WRITE sets the temp out; terminal WRITE r0 overrides.
    } else if(op == 3) {
        if(p1 >= 0 && p1 < 8) { zset(regs, p1, operand(regs, fr, n_in, p2)); }
    } else if(op == 4) {
        if(p1 >= 0 && p1 < 8) {
            zset(regs, p1, operand(regs, fr, n_in, p2) + operand(regs, fr, n_in, p3));
        }
    } else if(op == 5) {
        if(p1 >= 0 && p1 < 8) {
            let q:i64 = 0;
            if(operand(regs, fr, n_in, p2) == operand(regs, fr, n_in, p3)) { q = 1; }
            zset(regs, p1, q);
        }
    } else if(op == 6) {
        let rv:i64 = 0;
        if(p1 >= 0 && p1 < 8) { rv = zg(regs, p1); }
        if(rv != 0) { return 0; } // p2=0: jumps to pc 0, step cap -> out 0
    }
    return zg(regs, 0);
}

fn train_err(op:i64, p1:i64, p2:i64, p3:i64, xs:[]u8, ys:[]u8, n:i64, n_in:i64)i64 {
    let e:i64 = 0;
    let h:i64 = 0;
    while(h < n) {
        e = e + labs(sim1(op, p1, p2, p3, xs, h, n_in) - zg(ys, h));
        h = h + 1;
    }
    return e;
}

fn score_mode()i32 {
    if(_zag_argc() < 4) {
        _zag_println("usage: score <train.ep> <hidden.truth> <pred.txt> [trace.txt]");
        return 2;
    }
    let cap:i64 = 4096;
    let txs:[]u8 = z_alloc(cap * 4 * 8);
    let tys:[]u8 = z_alloc(cap * 8);
    let hxs:[]u8 = z_alloc(cap * 4 * 8);
    let hys:[]u8 = z_alloc(cap * 8);
    let nin_b:[]u8 = z_alloc(8);
    if(txs.len == 0 || tys.len == 0 || hxs.len == 0 || hys.len == 0 || nin_b.len == 0) {
        _zag_println("ERR alloc");
        return 2;
    }
    let tt:[]u8 = _zag_read_file(_zag_arg(1));
    let ht:[]u8 = _zag_read_file(_zag_arg(2));
    let pt:[]u8 = _zag_read_file(_zag_arg(3));
    if(tt.len == 0 || ht.len == 0 || pt.len == 0) {
        _zag_println("ERR empty_input");
        return 2;
    }
    let ntr:i64 = parse_eps(tt, txs, tys, nin_b, cap);
    let n_in:i64 = zg(nin_b, 0);
    let nh:i64 = parse_eps(ht, hxs, hys, nin_b, cap);
    if(ntr < 0 || nh < 0 || zg(nin_b, 0) != n_in) {
        _zag_println("ERR parse");
        return 2;
    }
    // predictions: last token of each line
    let pos:[]u8 = z_alloc(8);
    let pr:[]u8 = z_alloc(cap * 8);
    if(pos.len == 0 || pr.len == 0) { _zag_println("ERR alloc"); return 2; }
    let np:i64 = 0;
    while(has_more(pt, pos) == 1 && np < cap) {
        let line:[]u8 = next_line(pt, pos);
        if(line.len > 0) {
            let t:i64 = ntok(line);
            if(t != n_in + 1) { _zag_println("ERR pred_shape"); return 2; }
            zset(pr, np, _zag_str_to_i64(tok(line, t - 1)));
            np = np + 1;
        }
    }
    if(np != nh) { _zag_println("ERR pred_count"); return 2; }
    // accuracy
    let ok:i64 = 0;
    let h:i64 = 0;
    while(h < nh) {
        if(zg(pr, h) == zg(hys, h)) { ok = ok + 1; }
        h = h + 1;
    }
    // memorizer: exact input-tuple match on train, else 0
    let mok:i64 = 0;
    h = 0;
    while(h < nh) {
        let mp:i64 = 0;
        let found:i64 = 0;
        let t:i64 = 0;
        while(t < ntr && found == 0) {
            let same:i64 = 1;
            let k:i64 = 0;
            while(k < n_in) {
                if(zg(hxs, h * 4 + k) != zg(txs, t * 4 + k)) { same = 0; }
                k = k + 1;
            }
            if(same == 1) { mp = zg(tys, t); found = 1; }
            t = t + 1;
        }
        if(mp == zg(hys, h)) { mok = mok + 1; }
        h = h + 1;
    }
    // brute-force single-node oracle: same candidate enumeration as the
    // constructor trial with cnt=1, nnamed=1 (op7 skipped). First strictly
    // improving over the predict-0 base, oracle-picked by train error.
    let base:i64 = 0;
    h = 0;
    while(h < ntr) { base = base + labs(zg(tys, h)); h = h + 1; }
    let best:i64 = base;
    let bop:i64 = 0;
    let bp1:i64 = 0;
    let bp2:i64 = 0;
    let bp3:i64 = 0;
    let op:i64 = 1;
    while(op <= 6) {
        let r1n:i64 = 0;
        let r2n:i64 = 0;
        let r3n:i64 = 0;
        if(op == 1) { r1n = 8; r2n = n_in; r3n = 1; }
        else if(op == 2) { r1n = 8 + n_in; r2n = 1; r3n = 1; }
        else if(op == 3) { r1n = 8; r2n = 8 + n_in; r3n = 1; }
        else if(op == 4) { r1n = 8; r2n = 8 + n_in; r3n = 8 + n_in; }
        else if(op == 5) { r1n = 8; r2n = 8 + n_in; r3n = 8 + n_in; }
        else if(op == 6) { r1n = 8; r2n = 1; r3n = 1; }
        let a:i64 = 0;
        while(a < r1n) {
            let b:i64 = 0;
            while(b < r2n) {
                let c:i64 = 0;
                while(c < r3n) {
                    let p1:i64 = a;
                    let p2:i64 = b;
                    let p3:i64 = c;
                    if(op == 1) { p2 = 8 + b; p3 = 0; }
                    else if(op == 2) { p2 = 0; p3 = 0; }
                    else if(op == 6) { p3 = 0; }
                    let e:i64 = train_err(op, p1, p2, p3, txs, tys, ntr, n_in);
                    if(e < best) {
                        best = e;
                        bop = op; bp1 = p1; bp2 = p2; bp3 = p3;
                    }
                    c = c + 1;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        op = op + 1;
    }
    let ook:i64 = 0;
    h = 0;
    while(h < nh) {
        let opred:i64 = 0;
        if(bop != 0) { opred = sim1(bop, bp1, bp2, bp3, hxs, h, n_in); }
        if(opred == zg(hys, h)) { ook = ook + 1; }
        h = h + 1;
    }
    _zag_print("SCORE hidden_n=");
    _zag_print(_zag_i64_to_str(nh));
    _zag_print(" acc=");
    _zag_print(_zag_i64_to_str(ok));
    _zag_print(" mem=");
    _zag_print(_zag_i64_to_str(mok));
    _zag_print(" oracle=");
    _zag_print(_zag_i64_to_str(ook));
    _zag_print(" oracle_op=");
    _zag_print(_zag_i64_to_str(bop));
    _zag_print(" oracle_p=");
    _zag_print(_zag_i64_to_str(bp1));
    _zag_print(",");
    _zag_print(_zag_i64_to_str(bp2));
    _zag_print(",");
    _zag_println(_zag_i64_to_str(bp3));
    if(_zag_argc() >= 5) {
        let trt:[]u8 = _zag_read_file(_zag_arg(4));
        let xn:i64 = -1;
        if(trt.len > 0) {
            let pp:[]u8 = z_alloc(8);
            while(has_more(trt, pp) == 1) {
                let line:[]u8 = next_line(trt, pp);
                if(starts_with(line, "EXEC main ") == 1) {
                    xn = _zag_str_to_i64(tok(line, 2));
                }
            }
        }
        _zag_print("EXECMAIN ");
        _zag_println(_zag_i64_to_str(xn));
    }
    return 0;
}

fn ops_mode()i32 {
    if(_zag_argc() < 3) {
        _zag_println("usage: score ops <statefile>");
        return 2;
    }
    let text:[]u8 = _zag_read_file(_zag_arg(2));
    if(text.len == 0) { _zag_println("ERR empty"); return 2; }
    let pos:[]u8 = z_alloc(8);
    if(pos.len == 0) { _zag_println("ERR alloc"); return 2; }
    let inmain:i64 = 0;
    _zag_print("OPS");
    while(has_more(text, pos) == 1) {
        let line:[]u8 = next_line(text, pos);
        if(line.len > 0) {
            let w:[]u8 = tok(line, 0);
            if(_zag_strcmp(w, "GRAPH") == 1) {
                if(_zag_strcmp(tok(line, 1), "0") == 1) { inmain = 1; }
                else { inmain = 0; }
            } else if(_zag_strcmp(w, "N") == 1 && inmain == 1) {
                _zag_print(" ");
                _zag_print(tok(line, 1));
            } else if(_zag_strcmp(w, "ENDGRAPH") == 1) {
                inmain = 0;
            }
        }
    }
    _zag_println("");
    return 0;
}

fn main()i32 {
    if(_zag_argc() < 2) {
        _zag_println("usage: score <train.ep> <hidden.truth> <pred.txt> [trace.txt] | score ops <statefile>");
        return 2;
    }
    if(_zag_strcmp(_zag_arg(1), "ops") == 1) { return ops_mode(); }
    return score_mode();
}

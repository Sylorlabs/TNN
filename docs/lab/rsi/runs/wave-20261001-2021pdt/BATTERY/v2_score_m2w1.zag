// v2_score_m2w1.zag -- K-S8v2 scorer for the interactive M2-W1 world.
// Usage: v2_score_m2w1_bin <transcript> <driverlog> <envelope>
// Opens the sealed envelope AFTER the run; re-resolves informant roles
// through pi_r independently of the driver log (cross-checks the log).
// Checks K-S8v2 (a)..(e); computes D-CAUT and D-IG; prints MISS_RESPONSE.
// No hardcoded CHOICE integers. Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
// Parse ACT log line: ACT <phase> <key> <choice> <informant>
// Stores phase(0=CAL,1=INQ), key, choice, inf(0=NONE,1=A,2=B,3=C).
fn parse_act(d:[]u8,ls:i32,le:i32,out:[]u8)i32 {
  let f0s:i32=skip_ws(d,ls,le);
  let f0e:i32=field_end(d,f0s,le);
  if(word_is(d,f0s,f0e-f0s,"ACT")==0){ return 0; }
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  let s2:i32=skip_ws(d,e1,le);
  let e2:i32=field_end(d,s2,le);
  let s3:i32=skip_ws(d,e2,le);
  let e3:i32=field_end(d,s3,le);
  let s4:i32=skip_ws(d,e3,le);
  let e4:i32=field_end(d,s4,le);
  if(s1>=le||s2>=le||s3>=le||s4>=le){ return 0; }
  let ph:i32=0;
  if(word_is(d,s1,e1-s1,"INQ")==1){ ph=1; }
  if(is_int(d,s2,e2)==0||is_int(d,s3,e3)==0){ return 0; }
  let inf:i32=0;
  if(word_is(d,s4,e4-s4,"A")==1){ inf=1; }
  if(word_is(d,s4,e4-s4,"B")==1){ inf=2; }
  if(word_is(d,s4,e4-s4,"C")==1){ inf=3; }
  put32(out,0,ph); put32(out,4,parse_i32(d,s2,e2));
  put32(out,8,parse_i32(d,s3,e3)); put32(out,12,inf);
  return 1;
}
fn parse_answer(d:[]u8,ls:i32,le:i32,out:[]u8)i32 {
  let f0s:i32=skip_ws(d,ls,le);
  let f0e:i32=field_end(d,f0s,le);
  if(word_is(d,f0s,f0e-f0s,"ANSWER")==0){ return 0; }
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  let s2:i32=skip_ws(d,e1,le);
  let e2:i32=field_end(d,s2,le);
  let s3:i32=skip_ws(d,e2,le);
  let e3:i32=field_end(d,s3,le);
  if(s1>=le||s2>=le||s3>=le){ return 0; }
  if(is_int(d,s1,e1)==0||is_int(d,s2,e2)==0||is_int(d,s3,e3)==0){ return 0; }
  if(skip_ws(d,e3,le)<le){ return 0; }
  put32(out,0,parse_i32(d,s1,e1));
  put32(out,4,parse_i32(d,s2,e2));
  put32(out,8,parse_i32(d,s3,e3));
  return 1;
}
fn truth_of(tbuf:[]u8,nt:i32,key:i32)i32 {
  let i:i32=0;
  while(i<nt){
    if(ig(tbuf,i*8)==key){ return ig(tbuf,i*8+4); }
    i=i+1;
  }
  return -999999;
}
// role of emitted choice through pi: 1->pi[0], 2->pi[1], 3->pi[2], else 0.
// Roles: 1=A, 2=B, 3=C, 0=NONE.
fn role_of(choice:i32,pi0:i32,pi1:i32,pi2:i32)i32 {
  if(choice==1){ return pi0; }
  if(choice==2){ return pi1; }
  if(choice==3){ return pi2; }
  return 0;
}

fn main()i32 {
  if(_zag_argc()!=4){
    errln("usage: v2_score_m2w1_bin <transcript> <driverlog> <envelope>");
    return 2;
  }
  let td:[]u8=_zag_read_file(_zag_arg(1));
  let ld:[]u8=_zag_read_file(_zag_arg(2));
  let ed:[]u8=_zag_read_file(_zag_arg(3));
  // ---- open envelope: PI + T table ----
  let pi0:i32=0; let pi1:i32=0; let pi2:i32=0;
  let tbuf:[]u8=z_alloc(16*8);
  let nt:i32=0;
  let n:i32=_zag_strlen(ed);
  let s:i32=0;
  while(s<n){
    let le:i32=line_end(ed,s,n);
    let f0s:i32=skip_ws(ed,s,le);
    if(f0s<le){
      let f0e:i32=field_end(ed,f0s,le);
      let wl:i32=f0e-f0s;
      if(word_is(ed,f0s,wl,"PI")==1){
        let s1:i32=skip_ws(ed,f0e,le);
        let e1:i32=field_end(ed,s1,le);
        let s2:i32=skip_ws(ed,e1,le);
        let e2:i32=field_end(ed,s2,le);
        let s3:i32=skip_ws(ed,e2,le);
        let e3:i32=field_end(ed,s3,le);
        pi0=parse_i32(ed,s1,e1);
        pi1=parse_i32(ed,s2,e2);
        pi2=parse_i32(ed,s3,e3);
      }
      if(word_is(ed,f0s,wl,"T")==1){
        let s1:i32=skip_ws(ed,f0e,le);
        let e1:i32=field_end(ed,s1,le);
        let s2:i32=skip_ws(ed,e1,le);
        let e2:i32=field_end(ed,s2,le);
        if(is_int(ed,s1,e1)==1 && is_int(ed,s2,e2)==1 && nt<16){
          put32(tbuf,nt*8,parse_i32(ed,s1,e1));
          put32(tbuf,nt*8+4,parse_i32(ed,s2,e2));
          nt=nt+1;
        }
      }
    }
    s=le+1;
  }
  emit("ENVELOPE_OPENED PI ");
  e64(pi0); emit(" "); e64(pi1); emit(" "); e64(pi2); emit("\n");
  // ---- ACT log ----
  let abuf:[]u8=z_alloc(40*16);
  let na:i32=0;
  n=_zag_strlen(ld);
  s=0;
  let out:[]u8=z_alloc(16);
  while(s<n){
    let le:i32=line_end(ld,s,n);
    if(parse_act(ld,s,le,out)==1 && na<40){
      put32(abuf,na*16,ig(out,0)); put32(abuf,na*16+4,ig(out,4));
      put32(abuf,na*16+8,ig(out,8)); put32(abuf,na*16+12,ig(out,12));
      na=na+1;
    }
    s=le+1;
  }
  // ---- transcript ANSWERs ----
  let qbuf:[]u8=z_alloc(64*12);
  let nqq:i32=0;
  n=_zag_strlen(td);
  s=0;
  while(s<n){
    let le:i32=line_end(td,s,n);
    if(parse_answer(td,s,le,out)==1 && nqq<64){
      put32(qbuf,nqq*12,ig(out,0)); put32(qbuf,nqq*12+4,ig(out,4));
      put32(qbuf,nqq*12+8,ig(out,8));
      nqq=nqq+1;
    }
    s=le+1;
  }
  // ---- re-resolve roles through pi_r; cross-check driver log ----
  let mismatch:i32=0;
  let ai:i32=0;
  while(ai<na){
    let choice:i32=ig(abuf,ai*16+8);
    let logged:i32=ig(abuf,ai*16+12);
    let derived:i32=role_of(choice,pi0,pi1,pi2);
    if(derived!=logged){ mismatch=mismatch+1; }
    // store derived role at +12 (overwrite logged)
    put32(abuf,ai*16+12,derived);
    ai=ai+1;
  }
  emit("ROLE_MISMATCHES "); e64(mismatch); emit("\n");
  // hidden keys
  let hk0:i32=45111; let hk1:i32=45112; let hk2:i32=45113; let hk3:i32=45114;
  // (a) engagement: any hidden key with first ANSWER == -2 and an INQ ACT
  let eng:i32=0;
  let hi:i32=0;
  while(hi<4){
    let key:i32=hk0;
    if(hi==1){ key=hk1; }
    if(hi==2){ key=hk2; }
    if(hi==3){ key=hk3; }
    let first:i32=-888888;
    let fi:i32=0;
    while(fi<nqq){
      if(ig(qbuf,fi*12)==key && first==-888888){ first=ig(qbuf,fi*12+8); }
      fi=fi+1;
    }
    let hasact:i32=0;
    ai=0;
    while(ai<na){
      if(ig(abuf,ai*16)==1 && ig(abuf,ai*16+4)==key){ hasact=1; }
      ai=ai+1;
    }
    if(first==-2 && hasact==1){ eng=1; }
    hi=hi+1;
  }
  // MISS_RESPONSE: first ANSWER for hk0 (first inquiry-phase miss)
  let missresp:i32=-888888;
  let fi0:i32=0;
  while(fi0<nqq){
    if(ig(qbuf,fi0*12)==hk0 && missresp==-888888){ missresp=ig(qbuf,fi0*12+8); }
    fi0=fi0+1;
  }
  emit("MISS_RESPONSE "); e64(missresp); emit("\n");
  // (b),(c),(e): INQ ACT role stats (derived roles)
  let ninq:i32=0;
  let toa:i32=0;
  let tob:i32=0;
  let toc:i32=0;
  ai=0;
  while(ai<na){
    if(ig(abuf,ai*16)==1){
      ninq=ninq+1;
      let rl:i32=ig(abuf,ai*16+12);
      if(rl==1){ toa=toa+1; }
      if(rl==2){ tob=tob+1; }
      if(rl==3){ toc=toc+1; }
    }
    ai=ai+1;
  }
  // (d): final hidden probe per key
  let hpass:i32=0;
  hi=0;
  while(hi<4){
    let key:i32=hk0;
    if(hi==1){ key=hk1; }
    if(hi==2){ key=hk2; }
    if(hi==3){ key=hk3; }
    let last:i32=-888888;
    let fi2:i32=0;
    while(fi2<nqq){
      if(ig(qbuf,fi2*12)==key){ last=ig(qbuf,fi2*12+8); }
      fi2=fi2+1;
    }
    let tr:i32=truth_of(tbuf,nt,key);
    emit("HIDDEN key="); e64(key); emit(" last="); e64(last);
    emit(" truth="); e64(tr);
    if(last==tr){ emit(" PASS\n"); hpass=hpass+1; } else { emit(" FAIL\n"); }
    hi=hi+1;
  }
  emit("K-S8v2(a) engagement="); e64(eng); emit(" ");
  if(eng==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  emit("K-S8v2(b) inq_to_A="); e64(toa); emit("/"); e64(ninq); emit(" ");
  if(ninq==8 && toa>=6){ emit("PASS\n"); } else { emit("FAIL\n"); }
  emit("K-S8v2(c) inq_to_C="); e64(toc); emit(" ");
  if(toc<=1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  emit("K-S8v2(d) hidden="); e64(hpass); emit("/4 ");
  if(hpass>=3){ emit("PASS\n"); } else { emit("FAIL\n"); }
  emit("K-S8v2(e) budget "); e64(ninq); emit("/8 ");
  if(ninq<=8){ emit("PASS\n"); } else { emit("FAIL\n"); }
  let ok:i32=1;
  if(eng==0){ ok=0; }
  if(ninq!=8 || toa<6){ ok=0; }
  if(toc>1){ ok=0; }
  if(hpass<3){ ok=0; }
  if(ninq>8){ ok=0; }
  emit("BAR K-S8v2 ");
  if(ok==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  // D-IG: inquiry ACTs to sealed-A
  emit("D-IG inq_to_A="); e64(toa); emit("\n");
  // D-CAUT: (d)>=3/4 AND toa<6 AND toc==0 AND majority of remaining to B
  let caut:i32=0;
  if(hpass>=3 && toa<6 && toc==0){
    let rem:i32=ninq-toa;
    if(rem>0 && tob*2>rem){ caut=1; }
  }
  emit("D-CAUT "); e64(caut); emit(" (tob="); e64(tob); emit(")\n");
  return 0;
}

// v2_sealed_score.zag -- battery v2 QUERY/ANSWER grader with bar checks.
// Usage: v2_sealed_score_bin <world.txt> <transcript.txt> [BAR=<spec>]
// Parses QUERY (s,r,e) from world and ANSWER (s,r,v) from transcript 1:1 in
// order; prints per-probe PASS/FAIL, summary counts, CHOICE sequence.
// With BAR=<spec>, also evaluates the world-specific bar sub-checks and the
// distractor-intervention requirement (K-S12v2/K-S13v2).
// Bar specs: M1W1 M1W2 M1W3 M2W2 M2W3:M=<m>:N=<n> M3W1 M3W2 M3W3
// Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
fn parse_3(d:[]u8,ls:i32,le:i32,sr:[]u8) i32 {
  let f0s:i32=skip_ws(d,ls,le);
  if(f0s>=le){ return 0; }
  let f0e:i32=field_end(d,f0s,le);
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  let s2:i32=skip_ws(d,e1,le);
  let e2:i32=field_end(d,s2,le);
  let s3:i32=skip_ws(d,e2,le);
  let e3:i32=field_end(d,s3,le);
  if(s1>=le || s2>=le || s3>=le){ return 0; }
  if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){ return 0; }
  if(skip_ws(d,e3,le)<le){ return 0; }
  put32(sr,0,parse_i32(d,s1,e1));
  put32(sr,4,parse_i32(d,s2,e2));
  put32(sr,8,parse_i32(d,s3,e3));
  return 1;
}
fn parse_1(d:[]u8,ls:i32,le:i32) i32 {
  let f0s:i32=skip_ws(d,ls,le);
  if(f0s>=le){ return -999999; }
  let f0e:i32=field_end(d,f0s,le);
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  if(s1>=le){ return -999999; }
  if(is_int(d,s1,e1)==0){ return -999999; }
  if(skip_ws(d,e1,le)<le){ return -999999; }
  return parse_i32(d,s1,e1);
}
// count correct probes in [lo,hi)
fn cnt_ok(okbuf:[]u8,lo:i32,hi:i32)i32 {
  let c:i32=0;
  let i:i32=lo;
  while(i<hi){ if(okbuf[i]==1){ c=c+1; } i=i+1; }
  return c;
}
fn barline(name:[]u8,pass:i32)void {
  emit("BAR "); emit(name); emit(" ");
  if(pass==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return;
}
// Distractor-intervention check.
// Finds the bar probe = occ-th QUERY with (qs,qr) (1-based occ).
// Finds the last OBSERVE (cs,cr,co) line before that probe.
// PASS iff exists an OBSERVE line strictly between them whose subject is
// not in the related set {r1} or {r1,r2} or {r1,r2,r3} (nrel selects).
// wd lines are scanned; we need line indices. We re-scan the world.
fn distractor_check(wd:[]u8,qs:i32,qr:i32,qocc:i32,cs:i32,cr:i32,co:i32,r1:i32,r2:i32,r3:i32,nrel:i32)i32 {
  let n:i32=_zag_strlen(wd);
  // collect line starts
  let starts:[]u8=z_alloc(256*4);
  let nl:i32=0;
  let s:i32=0;
  while(s<n && nl<256){
    put32(starts,nl*4,s);
    nl=nl+1;
    s=line_end(wd,s,n)+1;
  }
  let sr:[]u8=z_alloc(12);
  // find bar probe line: occ-th QUERY (qs,qr)
  let probe_line:i32=-1;
  let occ:i32=0;
  let li:i32=0;
  while(li<nl){
    let ls:i32=ig(starts,li*4);
    let le:i32=line_end(wd,ls,n);
    let f0s:i32=skip_ws(wd,ls,le);
    if(f0s<le){
      let f0e:i32=field_end(wd,f0s,le);
      if(word_is(wd,f0s,f0e-f0s,"QUERY")==1 && parse_3(wd,ls,le,sr)==1){
        if(ig(sr,0)==qs && ig(sr,4)==qr){
          occ=occ+1;
          if(occ==qocc){ probe_line=li; }
        }
      }
    }
    li=li+1;
  }
  if(probe_line<0){ return 0; }
  // find last OBSERVE (cs,cr,co) strictly before probe_line
  let contra_line:i32=-1;
  li=0;
  while(li<probe_line){
    let ls:i32=ig(starts,li*4);
    let le:i32=line_end(wd,ls,n);
    let f0s:i32=skip_ws(wd,ls,le);
    if(f0s<le){
      let f0e:i32=field_end(wd,f0s,le);
      if(word_is(wd,f0s,f0e-f0s,"OBSERVE")==1 && parse_3(wd,ls,le,sr)==1){
        if(ig(sr,0)==cs && ig(sr,4)==cr && ig(sr,8)==co){ contra_line=li; }
      }
    }
    li=li+1;
  }
  if(contra_line<0){ return 0; }
  // exists OBSERVE between with subject not in related set?
  li=contra_line+1;
  while(li<probe_line){
    let ls:i32=ig(starts,li*4);
    let le:i32=line_end(wd,ls,n);
    let f0s:i32=skip_ws(wd,ls,le);
    if(f0s<le){
      let f0e:i32=field_end(wd,f0s,le);
      if(word_is(wd,f0s,f0e-f0s,"OBSERVE")==1 && parse_3(wd,ls,le,sr)==1){
        let sub:i32=ig(sr,0);
        let related:i32=0;
        if(sub==r1){ related=1; }
        if(nrel>=2 && sub==r2){ related=1; }
        if(nrel>=3 && sub==r3){ related=1; }
        if(related==0){ return 1; }
      }
    }
    li=li+1;
  }
  return 0;
}
// parse M2W3:M=<m>:N=<n> params; stores into out[0]=m,out[1]=n. Returns 1.
fn parse_m2w3(spec:[]u8,out:[]u8)i32 {
  // spec = "M2W3:M=<m>:N=<n>"
  let i:i32=5; // skip "M2W3:"
  // expect "M="
  if(spec[i]!=77 || spec[i+1]!=61){ return 0; }
  i=i+2;
  let neg:i32=0;
  if(spec[i]==45){ neg=1; i=i+1; }
  let v:i32=0;
  while(i<spec.len && spec[i]>=48 && spec[i]<=57){ v=v*10+(spec[i] as i32-48); i=i+1; }
  if(neg==1){ v=0-v; }
  if(spec[i]!=58){ return 0; }
  i=i+1;
  if(spec[i]!=78 || spec[i+1]!=61){ return 0; }
  i=i+2;
  neg=0;
  if(spec[i]==45){ neg=1; i=i+1; }
  let w:i32=0;
  while(i<spec.len && spec[i]>=48 && spec[i]<=57){ w=w*10+(spec[i] as i32-48); i=i+1; }
  if(neg==1){ w=0-w; }
  put32(out,0,v);
  put32(out,4,w);
  return 1;
}

fn main()i32 {
  let ac:i32=_zag_argc();
  if(ac!=3 && ac!=4){
    errln("usage: v2_sealed_score_bin <world.txt> <transcript.txt> [BAR=<spec>]");
    return 2;
  }
  let wd:[]u8=_zag_read_file(_zag_arg(1));
  let td:[]u8=_zag_read_file(_zag_arg(2));
  if(wd.len==0){ errln("empty world file"); return 3; }
  if(td.len==0){ errln("empty transcript"); return 3; }
  let spec:[]u8="";
  if(ac==4){
    spec=_zag_arg(3);
    // strip trailing newline if present
    if(spec.len>0 && spec[spec.len-1]==10){ spec=spec[0..spec.len-1]; }
    // strip "BAR=" prefix if present
    if(spec.len>=4 && spec[0]==66 && spec[1]==65 && spec[2]==82 && spec[3]==61){
      spec=spec[4..spec.len];
    }
  }
  // world QUERYs
  let qbuf:[]u8=z_alloc(64*12);
  let nq:i32=0;
  let n:i32=_zag_strlen(wd);
  let s:i32=0;
  let sr:[]u8=z_alloc(12);
  while(s<n){
    let le:i32=line_end(wd,s,n);
    let f0s:i32=skip_ws(wd,s,le);
    if(f0s<le){
      let f0e:i32=field_end(wd,f0s,le);
      if(word_is(wd,f0s,f0e-f0s,"QUERY")==1){
        if(parse_3(wd,s,le,sr)==1 && nq<64){
          put32(qbuf,nq*12,ig(sr,0));
          put32(qbuf,nq*12+4,ig(sr,4));
          put32(qbuf,nq*12+8,ig(sr,8));
          nq=nq+1;
        }
      }
    }
    s=le+1;
  }
  // transcript ANSWERs + CHOICEs
  let abuf:[]u8=z_alloc(64*12);
  let cbuf:[]u8=z_alloc(64*4);
  let na:i32=0;
  let nc:i32=0;
  n=_zag_strlen(td);
  s=0;
  while(s<n){
    let le:i32=line_end(td,s,n);
    let f0s:i32=skip_ws(td,s,le);
    if(f0s<le){
      let f0e:i32=field_end(td,f0s,le);
      let wl:i32=f0e-f0s;
      if(word_is(td,f0s,wl,"ANSWER")==1){
        if(parse_3(td,s,le,sr)==1 && na<64){
          put32(abuf,na*12,ig(sr,0));
          put32(abuf,na*12+4,ig(sr,4));
          put32(abuf,na*12+8,ig(sr,8));
          na=na+1;
        }
      }
      if(word_is(td,f0s,wl,"CHOICE")==1){
        let cv:i32=parse_1(td,s,le);
        if(cv!=-999999 && nc<64){
          put32(cbuf,nc*4,cv);
          nc=nc+1;
        }
      }
    }
    s=le+1;
  }
  emit("QUERIES "); e64(nq); emit(" ANSWERS "); e64(na); emit(" CHOICES_N "); e64(nc); emit("\n");
  if(nq!=na){
    emit("MISMATCH queries!=answers\n");
  }
  let okbuf:[]u8=z_alloc(64);
  let npass:i32=0;
  let i:i32=0;
  while(i<nq && i<na){
    let qs:i32=ig(qbuf,i*12);
    let qr:i32=ig(qbuf,i*12+4);
    let qe:i32=ig(qbuf,i*12+8);
    let av:i32=ig(abuf,i*12+8);
    let ok:i32=0;
    if(av==qe){ ok=1; npass=npass+1; }
    okbuf[i]=ok as u8;
    emit("PROBE "); e64(i); emit(" s="); e64(qs); emit(" r="); e64(qr);
    emit(" exp="); e64(qe); emit(" got="); e64(av);
    if(ok==1){ emit(" PASS\n"); } else { emit(" FAIL\n"); }
    i=i+1;
  }
  emit("SUMMARY pass="); e64(npass); emit(" total="); e64(nq); emit("\n");
  emit("CHOICES");
  i=0;
  while(i<nc){ emit(" "); e64(ig(cbuf,i*4)); i=i+1; }
  emit("\n");
  // ---- bar-specific checks ----
  if(spec.len>=4 && word_is(spec,0,4,"M1W1")==1){
    // K-S5v2(a): probes 0-7 composition >=7/8 ; (b): probes 8-11 decoy 4/4
    let a:i32=cnt_ok(okbuf,0,8);
    let b:i32=cnt_ok(okbuf,8,12);
    emit("K-S5v2-a composition "); e64(a); emit("/8 ");
    if(a>=7){ emit("PASS\n"); } else { emit("FAIL\n"); }
    emit("K-S5v2-b decoy "); e64(b); emit("/4 ");
    if(b==4){ emit("PASS\n"); } else { emit("FAIL\n"); }
    if(a>=7 && b==4){ barline("K-S5v2-ab",1); } else { barline("K-S5v2-ab",0); }
  }
  if(spec.len>=4 && word_is(spec,0,4,"M1W2")==1){
    // K-S6v2: probes 2-5 backward >=3/4 ; validity probes 0-1 2/2
    let fwd:i32=cnt_ok(okbuf,0,2);
    let bwd:i32=cnt_ok(okbuf,2,6);
    emit("K-S6v2 validity-fwd "); e64(fwd); emit("/2 ");
    if(fwd==2){ emit("PASS\n"); } else { emit("FAIL WORLD-INVALID\n"); }
    emit("K-S6v2 backward "); e64(bwd); emit("/4 ");
    if(fwd==2 && bwd>=3){ barline("K-S6v2",1); } else { barline("K-S6v2",0); }
  }
  if(spec.len>=4 && word_is(spec,0,4,"M1W3")==1){
    // K-S7v2: probes 1-3 >=2/3 ; validity probe 0
    let eng:i32=cnt_ok(okbuf,0,1);
    let comp:i32=cnt_ok(okbuf,1,4);
    emit("K-S7v2 validity-eng "); e64(eng); emit("/1 ");
    if(eng==1){ emit("PASS\n"); } else { emit("FAIL WORLD-INVALID\n"); }
    emit("K-S7v2 shared-comp "); e64(comp); emit("/3 ");
    if(eng==1 && comp>=2){ barline("K-S7v2",1); } else { barline("K-S7v2",0); }
  }
  if(spec.len>=4 && word_is(spec,0,4,"M2W2")==1){
    // K-S9v2: CHOICE[0]=N ; CHOICE[1]!=N (validity) ; CHOICE[2]==N
    if(nc>=3){
      let nn:i32=ig(cbuf,0);
      let pre:i32=ig(cbuf,4);
      let post:i32=ig(cbuf,8);
      emit("NULL_ACTION "); e64(nn); emit("\n");
      emit("PRERES_ACTION "); e64(pre); emit("\n");
      emit("POSTRES_ACTION "); e64(post); emit("\n");
      emit("K-S9v2 validity-pre!=N ");
      if(pre!=nn){ emit("PASS\n"); } else { emit("FAIL WORLD-INVALID\n"); }
      if(pre!=nn && post==nn){ barline("K-S9v2",1); } else { barline("K-S9v2",0); }
    } else {
      emit("K-S9v2 INSUFFICIENT CHOICES\n");
      barline("K-S9v2",0);
    }
  }
  if(spec.len>=4 && word_is(spec,0,4,"M2W3")==1){
    let prm:[]u8=z_alloc(8);
    if(parse_m2w3(spec,prm)==1 && nc>=3){
      let mm:i32=ig(prm,0);
      let nn:i32=ig(prm,4);
      let a0:i32=ig(cbuf,0);
      let a1:i32=ig(cbuf,4);
      let a2:i32=ig(cbuf,8);
      emit("M2W3 M="); e64(mm); emit(" N="); e64(nn); emit("\n");
      emit("EPISODE_ACTIONS "); e64(a0); emit(" "); e64(a1); emit(" "); e64(a2); emit("\n");
      let distinct:i32=0;
      if(a0!=a1 && a1!=a2 && a0!=a2){ distinct=1; }
      let nonnull:i32=0;
      if(a0!=nn && a1!=nn && a2!=nn){ nonnull=1; }
      // validity: probes 0,1,2 (the three miss QUERYs) yield M
      let v0:i32=0; let v1:i32=0; let v2:i32=0;
      if(nq>2 && na>2){
        if(ig(abuf,8)==mm){ v0=1; }
        if(ig(abuf,20)==mm){ v1=1; }
        if(ig(abuf,32)==mm){ v2=1; }
      }
      emit("K-S10v2 validity-miss ");
      if(v0==1 && v1==1 && v2==1){ emit("PASS\n"); } else { emit("FAIL WORLD-INVALID\n"); }
      emit("K-S10v2 distinct="); e64(distinct); emit(" nonnull="); e64(nonnull); emit("\n");
      if(v0==1 && v1==1 && v2==1 && distinct==1 && nonnull==1){ barline("K-S10v2",1); } else { barline("K-S10v2",0); }
    } else {
      emit("K-S10v2 PARAM/CHOICE ERROR\n");
      barline("K-S10v2",0);
    }
  }
  if(spec.len>=4 && word_is(spec,0,4,"M3W1")==1){
    // K-S11v2(a): probes 5,6,7 >=2/3 ; (b): probe 4 ; (c): probes 8,9 >=1/2 ; (e): probes 10-15 6/6
    let a:i32=cnt_ok(okbuf,5,8);
    let b:i32=cnt_ok(okbuf,4,5);
    let c:i32=cnt_ok(okbuf,8,10);
    let e:i32=cnt_ok(okbuf,10,16);
    emit("K-S11v2-a systematic "); e64(a); emit("/3 ");
    if(a>=2){ emit("PASS\n"); } else { emit("FAIL\n"); }
    emit("K-S11v2-b singleton "); e64(b); emit("/1 ");
    if(b==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
    emit("K-S11v2-c generalization "); e64(c); emit("/2 ");
    if(c>=1){ emit("PASS\n"); } else { emit("FAIL\n"); }
    emit("K-S11v2-e interference "); e64(e); emit("/6 ");
    if(e==6){ emit("PASS\n"); } else { emit("FAIL\n"); }
    if(a>=2 && b==1 && c>=1 && e==6){ barline("K-S11v2-abce",1); } else { barline("K-S11v2-abce",0); }
  }
  if(spec.len>=4 && word_is(spec,0,4,"M3W2")==1){
    // K-S12v2: probe 3 correct ; validity probes 0 and 2 ; distractor check
    let bar:i32=cnt_ok(okbuf,3,4);
    let v0:i32=cnt_ok(okbuf,0,1);
    let v2:i32=cnt_ok(okbuf,2,3);
    let dc:i32=distractor_check(wd,43201,43609,4,43202,43602,43219,43201,43202,0,2);
    emit("K-S12v2 bar-probe "); e64(bar); emit("/1 ");
    emit("K-S12v2 validity "); e64(v0); emit("/1 "); e64(v2); emit("/1 ");
    if(v0==1 && v2==1){ emit("PASS\n"); } else { emit("FAIL WORLD-INVALID\n"); }
    emit("K-S12v2 distractor-intervention ");
    if(dc==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
    if(v0==1 && v2==1 && bar==1 && dc==1){ barline("K-S12v2",1); } else { barline("K-S12v2",0); }
  }
  if(spec.len>=4 && word_is(spec,0,4,"M3W3")==1){
    // K-S13v2: probe 2 correct ; validity probes 0,1 ; distractor check
    let bar:i32=cnt_ok(okbuf,2,3);
    let v0:i32=cnt_ok(okbuf,0,1);
    let v1:i32=cnt_ok(okbuf,1,2);
    let dc:i32=distractor_check(wd,43801,43909,3,43811,43902,43813,43801,43802,43811,3);
    emit("K-S13v2 bar-probe "); e64(bar); emit("/1 ");
    emit("K-S13v2 validity "); e64(v0); emit("/1 "); e64(v1); emit("/1 ");
    if(v0==1 && v1==1){ emit("PASS\n"); } else { emit("FAIL WORLD-INVALID\n"); }
    emit("K-S13v2 distractor-intervention ");
    if(dc==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
    if(v0==1 && v1==1 && bar==1 && dc==1){ barline("K-S13v2",1); } else { barline("K-S13v2",0); }
  }
  return 0;
}

// v2_struct_check.zag -- representation-neutral structure-bar checks.
// Usage: v2_struct_check_bin <inspector_report> <check>
// check = C5  : K-S5v2(c): exists STRUCTURE whose evidence includes >=1
//               triple with subject in {40201,40202} (P-demo) AND >=1 with
//               subject in {40203,40204} (Q-demo).
// check = D11 : K-S11v2(d): exists STRUCTURE whose answer is a
//               post-contradiction value {42207,42208,42209} and whose
//               evidence includes >=1 contradiction-phase triple from
//               {(42202,42600,42207),(42203,42600,42208),(42204,42600,42209)}.
// Prints BAR <check> PASS/FAIL. Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
// find "answer=" in a STRUCTURE line; return the integer after it, or -999999.
fn struct_answer(d:[]u8,ls:i32,le:i32)i32 {
  let i:i32=ls;
  while(i+7<le){
    if(d[i]==97 && d[i+1]==110 && d[i+2]==115 && d[i+3]==119 && d[i+4]==101 && d[i+5]==114 && d[i+6]==61){
      let s1:i32=i+7;
      let e1:i32=s1;
      while(e1<le && ((d[e1]>=48 && d[e1]<=57) || d[e1]==45)){ e1=e1+1; }
      if(e1>s1 && is_int(d,s1,e1)==1){ return parse_i32(d,s1,e1); }
      return -999999;
    }
    i=i+1;
  }
  return -999999;
}
// Scan an EVIDENCE line for (s,r,o) triples. For each triple found, call the
// classifier via out flags. We accumulate: hasP, hasQ, hasContra, into fbuf.
fn scan_evidence(d:[]u8,ls:i32,le:i32,fbuf:[]u8)void {
  let i:i32=ls;
  while(i<le){
    if(d[i]==40){
      // parse (s,r,o)
      let s1:i32=i+1;
      let e1:i32=s1;
      while(e1<le && d[e1]!=44 && d[e1]!=41){ e1=e1+1; }
      let s2:i32=e1+1;
      let e2:i32=s2;
      while(e2<le && d[e2]!=44 && d[e2]!=41){ e2=e2+1; }
      let s3:i32=e2+1;
      let e3:i32=s3;
      while(e3<le && d[e3]!=41){ e3=e3+1; }
      if(e1>s1 && e2>s2 && e3>s3 && is_int(d,s1,e1)==1 && is_int(d,s2,e2)==1 && is_int(d,s3,e3)==1){
        let ts:i32=parse_i32(d,s1,e1);
        let tr:i32=parse_i32(d,s2,e2);
        let to:i32=parse_i32(d,s3,e3);
        if(ts==40201 || ts==40202){ put32(fbuf,0,1); }
        if(ts==40203 || ts==40204){ put32(fbuf,4,1); }
        if(ts==42202 && tr==42600 && to==42207){ put32(fbuf,8,1); }
        if(ts==42203 && tr==42600 && to==42208){ put32(fbuf,8,1); }
        if(ts==42204 && tr==42600 && to==42209){ put32(fbuf,8,1); }
      }
      i=e3+1;
    } else {
      i=i+1;
    }
  }
  return;
}

fn main()i32 {
  if(_zag_argc()!=3){
    errln("usage: v2_struct_check_bin <inspector_report> <check>");
    return 2;
  }
  let rd:[]u8=_zag_read_file(_zag_arg(1));
  let ck:[]u8=_zag_arg(2);
  if(ck.len>0 && ck[ck.len-1]==10){ ck=ck[0..ck.len-1]; }
  let is_c5:i32=0;
  let is_d11:i32=0;
  if(ck.len>=2 && ck[0]==67 && ck[1]==53){ is_c5=1; }
  if(ck.len>=3 && ck[0]==68 && ck[1]==49 && ck[2]==49){ is_d11=1; }
  if(is_c5==0 && is_d11==0){ errln("unknown check"); return 2; }
  let n:i32=_zag_strlen(rd);
  let s:i32=0;
  let pass:i32=0;
  // per-structure state
  let cur_ans:i32=-999999;
  let fbuf:[]u8=z_alloc(12);
  while(s<n){
    let le:i32=line_end(rd,s,n);
    let f0s:i32=skip_ws(rd,s,le);
    if(f0s<le){
      let f0e:i32=field_end(rd,f0s,le);
      let wl:i32=f0e-f0s;
      if(word_is(rd,f0s,wl,"STRUCTURE")==1){
        // evaluate previous structure
        if(cur_ans!=-999999){
          if(is_c5==1 && ig(fbuf,0)==1 && ig(fbuf,4)==1){ pass=1; }
          if(is_d11==1){
            let post:i32=0;
            if(cur_ans==42207 || cur_ans==42208 || cur_ans==42209){ post=1; }
            if(post==1 && ig(fbuf,8)==1){ pass=1; }
          }
        }
        // start new
        cur_ans=struct_answer(rd,s,le);
        put32(fbuf,0,0); put32(fbuf,4,0); put32(fbuf,8,0);
      }
      if(word_is(rd,f0s,wl,"EVIDENCE")==1){
        scan_evidence(rd,s,le,fbuf);
      }
    }
    s=le+1;
  }
  // evaluate last structure
  if(cur_ans!=-999999){
    if(is_c5==1 && ig(fbuf,0)==1 && ig(fbuf,4)==1){ pass=1; }
    if(is_d11==1){
      let post:i32=0;
      if(cur_ans==42207 || cur_ans==42208 || cur_ans==42209){ post=1; }
      if(post==1 && ig(fbuf,8)==1){ pass=1; }
    }
  }
  if(is_c5==1){ emit("BAR K-S5v2-c "); }
  if(is_d11==1){ emit("BAR K-S11v2-d "); }
  if(pass==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return 0;
}

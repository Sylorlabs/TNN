// v2_inspect_state.zag -- representation-neutral persistent-structure reporter.
// Usage: v2_inspect_state_bin <state.bin> <worldfile>
// For each persistent answer-bearing structure in state, reports its current
// answer value and the set of source observation facts (s,r,o triples from
// the world's OBSERVE stream) reachable as its licensed evidence.
// Vocabulary is representation-neutral: STRUCTURE / answer / EVIDENCE.
// (Internally reads the frozen TNN-2 layout; the byte format is frozen at
// build time per prereg section 5.1.) Read-only. Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
fn parse_3(d:[]u8,ls:i32,le:i32,sr:[]u8) i32 {
  let f0s:i32=skip_ws(d,ls,le);
  if(f0s>=le){ return 0; }
  let f0e:i32=field_end(d,f0s,le);
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  let s2:i32=skip_ws(d,e1,le);
  let e2:i32=field_end(d,s2,le);
  let s3:i32=skip_ws(d,e2,le);
  let e3:i32=field_end(d,s3,le);
  if(s1>=le || s2>=le || s3>=le){ return 0; }
  if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){ return 0; }
  if(skip_ws(d,e3,le)<le){ return 0; }
  put32(sr,0,parse_i32(d,s1,e1));
  put32(sr,4,parse_i32(d,s2,e2));
  put32(sr,8,parse_i32(d,s3,e3));
  return 1;
}
// state accessors (frozen tnn2.zag layout)
fn sng(W:[]u8,n:i32,f:i32)i32 { return ig(W,64+n*40+f); }
fn seg(W:[]u8,e:i32,f:i32)i32 { return ig(W,41024+e*16+f); }

fn main()i32 {
  if(_zag_argc()!=3){
    errln("usage: v2_inspect_state_bin <state.bin> <worldfile>");
    return 2;
  }
  let W:[]u8=_zag_read_file(_zag_arg(1));
  if(W.len<110656){ errln("state.bin too short"); return 3; }
  let wd:[]u8=_zag_read_file(_zag_arg(2));
  // collect OBSERVE triples from worldfile into obuf (s,r,o), 12 bytes each
  let obuf:[]u8=z_alloc(256*12);
  let no:i32=0;
  let n:i32=_zag_strlen(wd);
  let s:i32=0;
  let sr:[]u8=z_alloc(12);
  while(s<n){
    let le:i32=line_end(wd,s,n);
    let f0s:i32=skip_ws(wd,s,le);
    if(f0s<le){
      let f0e:i32=field_end(wd,f0s,le);
      if(word_is(wd,f0s,f0e-f0s,"OBSERVE")==1){
        if(parse_3(wd,s,le,sr)==1 && no<256){
          put32(obuf,no*12,ig(sr,0));
          put32(obuf,no*12+4,ig(sr,4));
          put32(obuf,no*12+8,ig(sr,8));
          no=no+1;
        }
      }
    }
    s=le+1;
  }
  emit("OBSERVES "); e64(no); emit("\n");
  // for each persistent answer-bearing structure (active tag-20 node)
  let nstructs:i32=0;
  let nn:i32=2;
  while(nn<1024){
    if(sng(W,nn,36)==1 && sng(W,nn,0)==20){
      let ms:i32=sng(W,nn,8);
      let mr:i32=sng(W,nn,4);
      let mans:i32=sng(W,nn,28);
      let mroot:i32=sng(W,nn,20);
      nstructs=nstructs+1;
      emit("STRUCTURE id="); e64(nn);
      emit(" subj="); e64(ms); emit(" rel="); e64(mr);
      emit(" answer="); e64(mans); emit("\n");
      // walk literal graph from root; collect literal object values
      let litvals:[]u8=z_alloc(128*4);
      let nlit:i32=0;
      let visited:[]u8=z_alloc(1024);
      let stack:[]u8=z_alloc(1024*4);
      let sp:i32=0;
      put32(stack,0,mroot); sp=1;
      while(sp>0){
        sp=sp-1;
        let cur:i32=ig(stack,sp*4);
        if(cur<2 || cur>=1024){ continue; }
        if(visited[cur]==1){ continue; }
        visited[cur]=1;
        let tag:i32=sng(W,cur,0);
        if(tag==101){
          let litn:i32=sng(W,cur,8);
          if(litn>=2 && litn<1024 && sng(W,litn,0)==902 && nlit<128){
            put32(litvals,nlit*4,sng(W,litn,20));
            nlit=nlit+1;
          }
        }
        if(tag==102){
          let tt:i32=sng(W,cur,12);
          if(tt>=2 && tt<1024 && sp<1024){
            put32(stack,sp*4,tt); sp=sp+1;
          }
        }
        let e:i32=0;
        while(e<4096){
          if(seg(W,e,0)!=-1 && seg(W,e,4)==12 && seg(W,e,0)==cur){
            let dst:i32=seg(W,e,8);
            if(dst>=2 && dst<1024 && sp<1024){
              put32(stack,sp*4,dst); sp=sp+1;
            }
          }
          e=e+1;
        }
      }
      // evidence: OBSERVE triples with subject==ms and object in litvals
      emit("EVIDENCE");
      let oi:i32=0;
      let nev:i32=0;
      while(oi<no){
        let os:i32=ig(obuf,oi*12);
        let oor:i32=ig(obuf,oi*12+4);
        let oo:i32=ig(obuf,oi*12+8);
        if(os==ms){
          let li:i32=0;
          let hit:i32=0;
          while(li<nlit){
            if(ig(litvals,li*4)==oo){ hit=1; }
            li=li+1;
          }
          if(hit==1){
            emit(" ("); e64(os); emit(","); e64(oor); emit(","); e64(oo); emit(")");
            nev=nev+1;
          }
        }
        oi=oi+1;
      }
      emit(" count="); e64(nev); emit("\n");
    }
    nn=nn+1;
  }
  emit("STRUCTURES "); e64(nstructs); emit("\n");
  return 0;
}

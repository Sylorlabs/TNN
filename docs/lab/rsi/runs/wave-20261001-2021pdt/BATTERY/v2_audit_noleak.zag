// v2_audit_noleak.zag -- K-S15v2 no-leak audit.
// Usage: v2_audit_noleak_bin <w1> <t1> [<w2> <t2> ...]
// For each world, for each probe: if the ANSWER is correct AND the probe key
// (s,r) was never observed in ANY v2 world (novel key) AND the correct value
// appears as a taught object in a DIFFERENT v2 world, report a LEAK.
// K-S15v2 PASS iff zero leaks. Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
fn parse_3(d:[]u8,ls:i32,le:i32,sr:[]u8) i32 {
  let f0s:i32=skip_ws(d,ls,le);
  if(f0s>=le){ return 0; }
  let f0e:i32=field_end(d,f0s,le);
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  let s2:i32=skip_ws(d,e1,le);
  let e2:i32=field_end(d,s2,le);
  let s3:i32=skip_ws(d,e2,le);
  let e3:i32=field_end(d,s3,le);
  if(s1>=le || s2>=le || s3>=le){ return 0; }
  if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){ return 0; }
  if(skip_ws(d,e3,le)<le){ return 0; }
  put32(sr,0,parse_i32(d,s1,e1));
  put32(sr,4,parse_i32(d,s2,e2));
  put32(sr,8,parse_i32(d,s3,e3));
  return 1;
}

fn main()i32 {
  let ac:i32=_zag_argc();
  if(ac<3 || (ac%2)==0){
    errln("usage: v2_audit_noleak_bin <w1> <t1> [<w2> <t2> ...]");
    return 2;
  }
  let nw:i32=(ac-1)/2;
  // per world: observed subjects, taught objects
  // global observed SUBJECTS (s only, not (s,r)): retention probes are not novel
  let gsubs:[]u8=z_alloc(2048*4);
  let ngs:i32=0;
  // per world taught objects: wobj[w] = list of objects
  let wobjs:[]u8=z_alloc(16*256*4);
  let nwobj:[]u8=z_alloc(16*4);
  let wi:i32=0;
  while(wi<16){ put32(nwobj,wi*4,0); wi=wi+1; }
  wi=0;
  while(wi<nw){
    let wd:[]u8=_zag_read_file(_zag_arg(1+wi*2));
    let n:i32=_zag_strlen(wd);
    let s:i32=0;
    let sr:[]u8=z_alloc(12);
    while(s<n){
      let le:i32=line_end(wd,s,n);
      let f0s:i32=skip_ws(wd,s,le);
      if(f0s<le){
        let f0e:i32=field_end(wd,f0s,le);
        if(word_is(wd,f0s,f0e-f0s,"OBSERVE")==1 && parse_3(wd,s,le,sr)==1){
          let os:i32=ig(sr,0); let oo:i32=ig(sr,8);
          // global subjects
          let j:i32=0; let hs:i32=0;
          while(j<ngs){
            if(ig(gsubs,j*4)==os){ hs=1; }
            j=j+1;
          }
          if(hs==0 && ngs<2048){ put32(gsubs,ngs*4,os); ngs=ngs+1; }
          // per-world objects
          let c2:[]u8=nwobj;
          let cnt:i32=ig(c2,wi*4);
          if(cnt<256){
            put32(wobjs,(wi*256+cnt)*4,oo);
            put32(c2,wi*4,cnt+1);
          }
        }
      }
      s=le+1;
    }
    wi=wi+1;
  }
  emit("GLOBAL_SUBJECTS "); e64(ngs); emit("\n");
  // audit probes
  let leaks:i32=0;
  wi=0;
  while(wi<nw){
    let wd:[]u8=_zag_read_file(_zag_arg(1+wi*2));
    let td:[]u8=_zag_read_file(_zag_arg(2+wi*2));
    // world QUERYs
    let qbuf:[]u8=z_alloc(64*12);
    let nq:i32=0;
    let n:i32=_zag_strlen(wd);
    let s:i32=0;
    let sr:[]u8=z_alloc(12);
    while(s<n){
      let le:i32=line_end(wd,s,n);
      let f0s:i32=skip_ws(wd,s,le);
      if(f0s<le){
        let f0e:i32=field_end(wd,f0s,le);
        if(word_is(wd,f0s,f0e-f0s,"QUERY")==1 && parse_3(wd,s,le,sr)==1 && nq<64){
          put32(qbuf,nq*12,ig(sr,0));
          put32(qbuf,nq*12+4,ig(sr,4));
          put32(qbuf,nq*12+8,ig(sr,8));
          nq=nq+1;
        }
      }
      s=le+1;
    }
    // transcript ANSWERs
    let abuf:[]u8=z_alloc(64*4);
    let na:i32=0;
    n=_zag_strlen(td);
    s=0;
    while(s<n){
      let le:i32=line_end(td,s,n);
      let f0s:i32=skip_ws(td,s,le);
      if(f0s<le){
        let f0e:i32=field_end(td,f0s,le);
        if(word_is(td,f0s,f0e-f0s,"ANSWER")==1 && parse_3(td,s,le,sr)==1 && na<64){
          put32(abuf,na*4,ig(sr,8));
          na=na+1;
        }
      }
      s=le+1;
    }
    let pi:i32=0;
    while(pi<nq && pi<na){
      let qs:i32=ig(qbuf,pi*12);
      let qr:i32=ig(qbuf,pi*12+4);
      let qe:i32=ig(qbuf,pi*12+8);
      let av:i32=ig(abuf,pi*4);
      if(av==qe){
        // correct; check novel subject (never observed as subject in any world)
        let j:i32=0; let known:i32=0;
        while(j<ngs){
          if(ig(gsubs,j*4)==qs){ known=1; }
          j=j+1;
        }
        if(known==0){
          // novel; check if qe taught in a different world
          let w2:i32=0;
          while(w2<nw){
            if(w2!=wi){
              let cnt2:i32=ig(nwobj,w2*4);
              let k2:i32=0;
              while(k2<cnt2){
                if(ig(wobjs,(w2*256+k2)*4)==qe){
                  leaks=leaks+1;
                  emit("LEAK world="); e64(wi); emit(" probe="); e64(pi);
                  emit(" s="); e64(qs); emit(" r="); e64(qr);
                  emit(" v="); e64(qe); emit(" from_world="); e64(w2); emit("\n");
                }
                k2=k2+1;
              }
            }
            w2=w2+1;
          }
        }
      }
      pi=pi+1;
    }
    wi=wi+1;
  }
  emit("LEAKS "); e64(leaks); emit("\n");
  emit("BAR K-S15v2 ");
  if(leaks==0){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return 0;
}

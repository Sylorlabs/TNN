// v2_worldgen.zag -- sealed battery v2 world/envelope generator.
// Generates the 8 fixed world files, the M2-W1 template, and the 3 sealed
// per-run envelopes (pi_r from committed seed 20261001 via LCG +
// Fisher-Yates, deduped). Writes files into the lane directory.
// Manifest hashes are computed by shell sha256sum (prereg section 0:
// shell is used for hash manifests). Pure Zag, pinned znc.
// Usage: v2_worldgen_bin <outdir>

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
// ---- buffer append helpers ----
fn app_str(buf:[]u8,pos:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
  return pos+s.len;
}
fn app_i32(buf:[]u8,pos:i32,v:i32)i32 {
  return app_str(buf,pos,i64s(v as i64));
}
fn app_nl(buf:[]u8,pos:i32)i32 { buf[pos]=10; return pos+1; }
fn w_observe(buf:[]u8,pos:i32,s:i32,r:i32,o:i32)i32 {
  pos=app_str(buf,pos,"OBSERVE ");
  pos=app_i32(buf,pos,s);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,r);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,o);
  return app_nl(buf,pos);
}
fn w_query(buf:[]u8,pos:i32,s:i32,r:i32,e:i32)i32 {
  pos=app_str(buf,pos,"QUERY ");
  pos=app_i32(buf,pos,s);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,r);
  pos=app_str(buf,pos," ");
  pos=app_i32(buf,pos,e);
  return app_nl(buf,pos);
}
fn w_act(buf:[]u8,pos:i32)i32 {
  return app_str(buf,pos,"ACT\n");
}
fn write_buf(path:[]u8,buf:[]u8,pos:i32)i32 {
  let out:[]u8=buf[0..pos];
  if(_zag_write_file(path,out)!=0){
    errln("write failed");
    return 1;
  }
  emit("WROTE "); _zag_print(path); emit(" "); e64(pos); emit(" bytes\n");
  return 0;
}
fn join_path(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+name.len+2);
  let p:i32=app_str(b,0,dir);
  // ensure trailing slash
  if(dir.len>0 && dir[dir.len-1]!=47){ b[p]=47; p=p+1; }
  p=app_str(b,p,name);
  return b[0..p];
}
// ---- deterministic LCG (committed seed) ----
fn lcg_next(x:i64)i64 {
  return (1103515245*x+12345)%2147483648;
}
// Fisher-Yates on [1,2,3]; stores permutation into pi (3 x i32).
fn gen_perm(seed:i64,pi:[]u8) i64 {
  let a0:i32=1; let a1:i32=2; let a2:i32=3;
  let x:i64=seed;
  // i=2
  x=lcg_next(x);
  let j:i32=(x%3) as i32;
  if(j==0){ let t:i32=a0; a0=a2; a2=t; }
  if(j==1){ let t:i32=a1; a1=a2; a2=t; }
  // i=1
  x=lcg_next(x);
  j=(x%2) as i32;
  if(j==0){ let t:i32=a0; a0=a1; a1=t; }
  let b:[]u8=pi;
  b[0]=a0 as u8; b[1]=a1 as u8; b[2]=a2 as u8;
  return x;
}
fn perm_eq(a:[]u8,b:[]u8)i32 {
  if(a[0]==b[0] && a[1]==b[1] && a[2]==b[2]){ return 1; }
  return 0;
}

// ---- world emitters (exact streams from PREREG_BATTERY_V2 section 3) ----
fn gen_m1w1(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,40201,40601,40901);
  p=w_observe(buf,p,40201,40602,40902);
  p=w_observe(buf,p,40202,40601,40901);
  p=w_observe(buf,p,40202,40602,40902);
  p=w_observe(buf,p,40203,40603,40903);
  p=w_observe(buf,p,40203,40604,40904);
  p=w_observe(buf,p,40204,40603,40903);
  p=w_observe(buf,p,40204,40604,40904);
  p=w_observe(buf,p,40205,40601,40902);
  p=w_observe(buf,p,40205,40602,40901);
  p=w_observe(buf,p,40205,40603,40904);
  p=w_observe(buf,p,40205,40604,40903);
  p=w_query(buf,p,40206,40601,40901);
  p=w_query(buf,p,40206,40602,40902);
  p=w_query(buf,p,40206,40603,40903);
  p=w_query(buf,p,40206,40604,40904);
  p=w_query(buf,p,40207,40601,40901);
  p=w_query(buf,p,40207,40602,40902);
  p=w_query(buf,p,40207,40603,40903);
  p=w_query(buf,p,40207,40604,40904);
  p=w_query(buf,p,40205,40601,40902);
  p=w_query(buf,p,40205,40602,40901);
  p=w_query(buf,p,40205,40603,40904);
  p=w_query(buf,p,40205,40604,40903);
  return p;
}
fn gen_m1w2(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,41111,41501,41112);
  p=w_observe(buf,p,41112,41501,41113);
  p=w_observe(buf,p,41113,41501,41114);
  p=w_observe(buf,p,41121,41501,41122);
  p=w_observe(buf,p,41122,41501,41123);
  p=w_observe(buf,p,41123,41501,41124);
  p=w_query(buf,p,41111,41509,41114);
  p=w_query(buf,p,41121,41509,41124);
  p=w_query(buf,p,41114,41509,41111);
  p=w_query(buf,p,41113,41509,41111);
  p=w_query(buf,p,41124,41509,41121);
  p=w_query(buf,p,41123,41509,41121);
  p=w_query(buf,p,40205,40601,40902);
  p=w_query(buf,p,40205,40603,40904);
  return p;
}
fn gen_m1w3(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,41721,41801,41911);
  p=w_observe(buf,p,41721,41802,41912);
  p=w_observe(buf,p,41721,41803,41913);
  p=w_observe(buf,p,41722,41801,41911);
  p=w_observe(buf,p,41722,41802,41912);
  p=w_observe(buf,p,41722,41803,41913);
  p=w_observe(buf,p,41723,41801,41912);
  p=w_observe(buf,p,41723,41802,41911);
  p=w_observe(buf,p,41723,41803,41912);
  p=w_query(buf,p,41721,41801,41911);
  p=w_query(buf,p,41726,41801,41911);
  p=w_query(buf,p,41726,41802,41912);
  p=w_query(buf,p,41726,41803,41913);
  p=w_query(buf,p,41111,41509,41114);
  p=w_query(buf,p,41121,41509,41124);
  return p;
}
fn gen_m2w1_template(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,45991,45600,45999);
  p=w_observe(buf,p,45992,45600,45999);
  p=w_observe(buf,p,45993,45600,45999);
  return p;
}
fn gen_m2w2(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,44011,44601,44021);
  p=w_query(buf,p,44011,44601,44021);
  p=w_act(buf,p);
  p=w_query(buf,p,44111,44601,44901);
  p=w_act(buf,p);
  p=w_observe(buf,p,44111,44601,44901);
  p=w_observe(buf,p,44302,44602,44312);
  p=w_observe(buf,p,44303,44602,44313);
  p=w_observe(buf,p,44304,44602,44314);
  p=w_observe(buf,p,44305,44602,44315);
  p=w_observe(buf,p,44306,44602,44316);
  p=w_observe(buf,p,44307,44602,44317);
  p=w_query(buf,p,44111,44601,44901);
  p=w_act(buf,p);
  p=w_query(buf,p,45101,45600,45201);
  p=w_query(buf,p,45102,45600,45202);
  return p;
}
fn gen_m2w3(buf:[]u8)i32 {
  let p:i32=0;
  p=w_query(buf,p,46201,46601,46901);
  p=w_act(buf,p);
  p=w_observe(buf,p,46311,46609,46391);
  p=w_observe(buf,p,46312,46609,46392);
  p=w_observe(buf,p,46313,46609,46393);
  p=w_observe(buf,p,46314,46609,46394);
  p=w_query(buf,p,46202,46602,46902);
  p=w_act(buf,p);
  p=w_observe(buf,p,46321,46609,46395);
  p=w_observe(buf,p,46322,46609,46396);
  p=w_observe(buf,p,46323,46609,46397);
  p=w_observe(buf,p,46324,46609,46398);
  p=w_query(buf,p,46203,46603,46903);
  p=w_act(buf,p);
  p=w_query(buf,p,44111,44601,44901);
  p=w_query(buf,p,45103,45600,45203);
  return p;
}
fn gen_m3w1(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,42911,42950,42921);
  p=w_observe(buf,p,42912,42950,42922);
  p=w_observe(buf,p,42913,42950,42923);
  p=w_observe(buf,p,42914,42950,42924);
  p=w_observe(buf,p,42915,42950,42925);
  p=w_observe(buf,p,42916,42950,42926);
  p=w_observe(buf,p,42201,42600,42204);
  p=w_observe(buf,p,42202,42600,42205);
  p=w_observe(buf,p,42203,42600,42206);
  p=w_observe(buf,p,42204,42600,42207);
  p=w_observe(buf,p,42205,42600,42208);
  p=w_observe(buf,p,42206,42600,42209);
  p=w_observe(buf,p,42207,42600,42210);
  p=w_observe(buf,p,42208,42600,42211);
  p=w_query(buf,p,42201,42601,42204);
  p=w_query(buf,p,42202,42601,42205);
  p=w_query(buf,p,42203,42601,42206);
  p=w_query(buf,p,42204,42601,42207);
  p=w_observe(buf,p,42201,42600,42210);
  p=w_observe(buf,p,42202,42600,42207);
  p=w_observe(buf,p,42203,42600,42208);
  p=w_observe(buf,p,42204,42600,42209);
  p=w_observe(buf,p,42821,42850,42831);
  p=w_observe(buf,p,42822,42850,42832);
  p=w_observe(buf,p,42823,42850,42833);
  p=w_observe(buf,p,42824,42850,42834);
  p=w_observe(buf,p,42825,42850,42835);
  p=w_observe(buf,p,42826,42850,42836);
  p=w_observe(buf,p,42827,42850,42837);
  p=w_observe(buf,p,42828,42850,42838);
  p=w_observe(buf,p,42829,42850,42839);
  p=w_observe(buf,p,42830,42850,42840);
  p=w_observe(buf,p,42831,42850,42841);
  p=w_observe(buf,p,42832,42850,42842);
  p=w_query(buf,p,42201,42601,42204);
  p=w_query(buf,p,42202,42601,42207);
  p=w_query(buf,p,42203,42601,42208);
  p=w_query(buf,p,42204,42601,42209);
  p=w_query(buf,p,42205,42601,42210);
  p=w_query(buf,p,42206,42601,42211);
  p=w_query(buf,p,42911,42950,42921);
  p=w_query(buf,p,42912,42950,42922);
  p=w_query(buf,p,42913,42950,42923);
  p=w_query(buf,p,42914,42950,42924);
  p=w_query(buf,p,42915,42950,42925);
  p=w_query(buf,p,42916,42950,42926);
  return p;
}
fn gen_m3w2(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,43201,43601,43202);
  p=w_observe(buf,p,43202,43602,43203);
  p=w_query(buf,p,43201,43609,43203);
  p=w_query(buf,p,43201,43609,43203);
  p=w_observe(buf,p,43202,43602,43209);
  p=w_query(buf,p,43201,43609,43209);
  p=w_observe(buf,p,43202,43602,43219);
  p=w_observe(buf,p,43651,43660,43671);
  p=w_observe(buf,p,43652,43660,43672);
  p=w_observe(buf,p,43653,43660,43673);
  p=w_observe(buf,p,43654,43660,43674);
  p=w_observe(buf,p,43655,43660,43675);
  p=w_observe(buf,p,43656,43660,43676);
  p=w_query(buf,p,43201,43609,43219);
  p=w_query(buf,p,42202,42601,42207);
  p=w_query(buf,p,42201,42601,42204);
  return p;
}
fn gen_m3w3(buf:[]u8)i32 {
  let p:i32=0;
  p=w_observe(buf,p,43801,43901,43802);
  p=w_observe(buf,p,43802,43902,43803);
  p=w_query(buf,p,43801,43909,43803);
  p=w_query(buf,p,43801,43909,43803);
  p=w_observe(buf,p,43801,43901,43811);
  p=w_observe(buf,p,43811,43902,43813);
  p=w_observe(buf,p,43951,43960,43971);
  p=w_observe(buf,p,43952,43960,43972);
  p=w_observe(buf,p,43953,43960,43973);
  p=w_observe(buf,p,43954,43960,43974);
  p=w_observe(buf,p,43955,43960,43975);
  p=w_observe(buf,p,43956,43960,43976);
  p=w_query(buf,p,43801,43909,43813);
  p=w_query(buf,p,43201,43609,43209);
  p=w_query(buf,p,42203,42601,42208);
  return p;
}
// ---- envelope emitter ----
fn gen_envelope(buf:[]u8,run:i32,pi:[]u8)i32 {
  let p:i32=0;
  p=app_str(buf,p,"SEALED-ENVELOPE M2-W1 RUN ");
  p=app_i32(buf,p,run);
  p=app_nl(buf,p);
  p=app_str(buf,p,"PI ");
  p=app_i32(buf,p,pi[0] as i32);
  p=app_str(buf,p," ");
  p=app_i32(buf,p,pi[1] as i32);
  p=app_str(buf,p," ");
  p=app_i32(buf,p,pi[2] as i32);
  p=app_nl(buf,p);
  // truths T key truth
  p=app_str(buf,p,"T 45101 45201\n");
  p=app_str(buf,p,"T 45102 45202\n");
  p=app_str(buf,p,"T 45103 45203\n");
  p=app_str(buf,p,"T 45104 45204\n");
  p=app_str(buf,p,"T 45111 45211\n");
  p=app_str(buf,p,"T 45112 45212\n");
  p=app_str(buf,p,"T 45113 45213\n");
  p=app_str(buf,p,"T 45114 45214\n");
  // B table (fixed by prereg 3.4)
  p=app_str(buf,p,"B 45101 45201\n");
  p=app_str(buf,p,"B 45102 45998\n");
  p=app_str(buf,p,"B 45103 45203\n");
  p=app_str(buf,p,"B 45104 45997\n");
  p=app_str(buf,p,"B 45111 45996\n");
  p=app_str(buf,p,"B 45112 45995\n");
  p=app_str(buf,p,"B 45113 45994\n");
  p=app_str(buf,p,"B 45114 45993\n");
  p=app_str(buf,p,"CVAL 45999\n");
  return p;
}

fn main()i32 {
  if(_zag_argc()!=2){
    errln("usage: v2_worldgen_bin <outdir>");
    return 2;
  }
  let dir:[]u8=_zag_arg(1);
  let buf:[]u8=z_alloc(16384);
  let p:i32=0;
  // 8 fixed worlds + template
  p=gen_m1w1(buf);
  if(write_buf(join_path(dir,"m1w1v2_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m1w2(buf);
  if(write_buf(join_path(dir,"m1w2v2_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m1w3(buf);
  if(write_buf(join_path(dir,"m1w3v2_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m2w1_template(buf);
  if(write_buf(join_path(dir,"m2w1v2_template.txt"),buf,p)!=0){ return 1; }
  p=gen_m2w2(buf);
  if(write_buf(join_path(dir,"m2w2v2_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m2w3(buf);
  if(write_buf(join_path(dir,"m2w3v2_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m3w1(buf);
  if(write_buf(join_path(dir,"m3w1v2_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m3w2(buf);
  if(write_buf(join_path(dir,"m3w2v2_world.txt"),buf,p)!=0){ return 1; }
  p=gen_m3w3(buf);
  if(write_buf(join_path(dir,"m3w3v2_world.txt"),buf,p)!=0){ return 1; }
  // 3 sealed envelopes, pi_r from committed seed 20261001
  let seed:i64=20261001;
  let pi0:[]u8=z_alloc(3);
  let pi1:[]u8=z_alloc(3);
  let pi2:[]u8=z_alloc(3);
  let x:i64=gen_perm(seed,pi0);
  emit("ENVELOPE run=1 PI ");
  e64(pi0[0] as i32); emit(" "); e64(pi0[1] as i32); emit(" "); e64(pi0[2] as i32); emit("\n");
  // distinct permutations: regenerate until different
  let tmp:[]u8=z_alloc(3);
  x=gen_perm(x,tmp);
  while(perm_eq(tmp,pi0)==1){ x=gen_perm(x,tmp); }
  pi1[0]=tmp[0]; pi1[1]=tmp[1]; pi1[2]=tmp[2];
  emit("ENVELOPE run=2 PI ");
  e64(pi1[0] as i32); emit(" "); e64(pi1[1] as i32); emit(" "); e64(pi1[2] as i32); emit("\n");
  x=gen_perm(x,tmp);
  while(perm_eq(tmp,pi0)==1 || perm_eq(tmp,pi1)==1){ x=gen_perm(x,tmp); }
  pi2[0]=tmp[0]; pi2[1]=tmp[1]; pi2[2]=tmp[2];
  emit("ENVELOPE run=3 PI ");
  e64(pi2[0] as i32); emit(" "); e64(pi2[1] as i32); emit(" "); e64(pi2[2] as i32); emit("\n");
  p=gen_envelope(buf,1,pi0);
  if(write_buf(join_path(dir,"m2w1v2_envelope_run1.txt"),buf,p)!=0){ return 1; }
  p=gen_envelope(buf,2,pi1);
  if(write_buf(join_path(dir,"m2w1v2_envelope_run2.txt"),buf,p)!=0){ return 1; }
  p=gen_envelope(buf,3,pi2);
  if(write_buf(join_path(dir,"m2w1v2_envelope_run3.txt"),buf,p)!=0){ return 1; }
  emit("WORLDGEN DONE seed=20261001\n");
  return 0;
}

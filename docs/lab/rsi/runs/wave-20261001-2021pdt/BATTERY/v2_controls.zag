// v2_controls.zag -- battery v2 calibration control policies.
// For fixed worlds: v2_controls_bin <world> <control_id> <struct_out>
//   Simulates the control policy against the world event stream; synthetic
//   transcript (ANSWER/CHOICE lines) to stdout; synthetic structure report
//   (if any) to <struct_out> ("none" to skip).
// For M2-W1: v2_controls_bin M2W1 <envelope> <control_id> <trans_out> <log_out>
//   Simulates the full interactive protocol; writes synthetic transcript and
//   driver log. The learner simulation never reads pi_r directly; the
//   competent policy identifies the truthful channel by exploration.
// Control IDs (fixed worlds):
//   M1W1_D M1W1_C M1W2_D M1W2_C M1W3_D M1W3_C
//   M2W2_D1 M2W2_D2 M2W2_C M2W3_D M2W3_C
//   M3W1_D M3W1_C M3W2_D M3W2_C M3W3_D M3W3_C
// M2-W1 IDs: CONST1 CONST2 CONST3 COMPETENT
// Pure Zag, pinned znc.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
  let e:i32=s;
  while(e<n){ if(d[e]==10){ return e; } e=e+1; }
  return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9 || d[s]==10){ return s; } s=s+1; }
  return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
  if(s>=e){ return 0; }
  let p:i32=s;
  if(d[p]==45){ p=p+1; if(p>=e){ return 0; } }
  while(p<e){ if(d[p]<48 || d[p]>57){ return 0; } p=p+1; }
  return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
  let neg:i32=0; let p:i32=s; let v:i32=0;
  if(d[p]==45){ neg=1; p=p+1; }
  while(p<e){ v=v*10+(d[p] as i32-48); p=p+1; }
  if(neg==1){ v=0-v; }
  return v;
}
fn word_is(d:[]u8,s:i32,wl:i32,t:[]u8)i32 {
  if(wl!=t.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(d[s+i]!=t[i]){ return 0; } i=i+1; }
  return 1;
}
fn parse_3(d:[]u8,ls:i32,le:i32,sr:[]u8) i32 {
  let f0s:i32=skip_ws(d,ls,le);
  if(f0s>=le){ return 0; }
  let f0e:i32=field_end(d,f0s,le);
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  let s2:i32=skip_ws(d,e1,le);
  let e2:i32=field_end(d,s2,le);
  let s3:i32=skip_ws(d,e2,le);
  let e3:i32=field_end(d,s3,le);
  if(s1>=le || s2>=le || s3>=le){ return 0; }
  if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){ return 0; }
  if(skip_ws(d,e3,le)<le){ return 0; }
  put32(sr,0,parse_i32(d,s1,e1));
  put32(sr,4,parse_i32(d,s2,e2));
  put32(sr,8,parse_i32(d,s3,e3));
  return 1;
}
// ---- event stream ----
fn parse_world(wd:[]u8, evbuf:[]u8) i32 {
  // evbuf: per event 16 bytes: kind(0=OBS,1=QUERY,2=ACT), a, b, c
  let nev:i32=0;
  let n:i32=_zag_strlen(wd);
  let s:i32=0;
  let sr:[]u8=z_alloc(12);
  while(s<n && nev<256){
    let le:i32=line_end(wd,s,n);
    let f0s:i32=skip_ws(wd,s,le);
    if(f0s<le){
      let f0e:i32=field_end(wd,f0s,le);
      let wl:i32=f0e-f0s;
      if(word_is(wd,f0s,wl,"OBSERVE")==1 && parse_3(wd,s,le,sr)==1){
        put32(evbuf,nev*16,0);
        put32(evbuf,nev*16+4,ig(sr,0));
        put32(evbuf,nev*16+8,ig(sr,4));
        put32(evbuf,nev*16+12,ig(sr,8));
        nev=nev+1;
      }
      if(word_is(wd,f0s,wl,"QUERY")==1 && parse_3(wd,s,le,sr)==1){
        put32(evbuf,nev*16,1);
        put32(evbuf,nev*16+4,ig(sr,0));
        put32(evbuf,nev*16+8,ig(sr,4));
        put32(evbuf,nev*16+12,ig(sr,8));
        nev=nev+1;
      }
      if(word_is(wd,f0s,wl,"ACT")==1){
        put32(evbuf,nev*16,2);
        put32(evbuf,nev*16+4,0);
        put32(evbuf,nev*16+8,0);
        put32(evbuf,nev*16+12,0);
        nev=nev+1;
      }
    }
    s=le+1;
  }
  return nev;
}
// fact map: (s,r)->o, 12 bytes each. put_fact overwrites latest.
fn put_fact(fbuf:[]u8,nf:i32,s:i32,r:i32,o:i32)i32 {
  let i:i32=0;
  while(i<nf){
    if(ig(fbuf,i*12)==s && ig(fbuf,i*12+4)==r){
      put32(fbuf,i*12+8,o);
      return nf;
    }
    i=i+1;
  }
  put32(fbuf,nf*12,s);
  put32(fbuf,nf*12+4,r);
  put32(fbuf,nf*12+8,o);
  return nf+1;
}
fn get_fact(fbuf:[]u8,nf:i32,s:i32,r:i32)i32 {
  let i:i32=0;
  while(i<nf){
    if(ig(fbuf,i*12)==s && ig(fbuf,i*12+4)==r){ return ig(fbuf,i*12+8); }
    i=i+1;
  }
  return -999999;
}
fn out_answer(s:i32,r:i32,v:i32)void {
  emit("ANSWER "); e64(s); emit(" "); e64(r); emit(" "); e64(v); emit("\n");
  return;
}
fn out_choice(v:i32)void {
  emit("CHOICE "); e64(v); emit("\n");
  return;
}
// ---- buffer append for structure reports ----
fn app_str(buf:[]u8,pos:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
  return pos+s.len;
}
fn app_i32(buf:[]u8,pos:i32,v:i32)i32 {
  return app_str(buf,pos,i64s(v as i64));
}

// ============ M1W1 ============
fn ctl_m1w1(cid:i32, evbuf:[]u8, nev:i32, struct_path:[]u8)void {
  // cid 0=D (per-key latest), 1=C (symbolic composer)
  let fbuf:[]u8=z_alloc(64*12);
  let nf:i32=0;
  // relation map with majority vote (for C): rmap r->(obj,count)
  let rmap:[]u8=z_alloc(32*12);
  let nr:i32=0;
  let ei:i32=0;
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==0){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let o:i32=ig(evbuf,ei*16+12);
      nf=put_fact(fbuf,nf,s,r,o);
      if(cid==1){
        // majority vote per relation
        let ri:i32=0;
        let found:i32=0;
        while(ri<nr){
          if(ig(rmap,ri*12)==r){
            found=1;
            // count votes: store (obj -> votes) in a sub-table; simplified:
            // keep first-seen obj and count agreements; on disagree, keep majority by recount
            ri=nr; // break after handling below
          }
          ri=ri+1;
        }
      }
    }
    ei=ei+1;
  }
  // For C: compute per-relation majority by full recount
  // (recompute cleanly here)
  if(cid==1){
    nr=0;
    // collect distinct relations
    let rs:[]u8=z_alloc(16*4);
    let nrs:i32=0;
    ei=0;
    while(ei<nev){
      if(ig(evbuf,ei*16)==0){
        let r:i32=ig(evbuf,ei*16+8);
        let j:i32=0; let has:i32=0;
        while(j<nrs){ if(ig(rs,j*4)==r){ has=1; } j=j+1; }
        if(has==0 && nrs<16){ put32(rs,nrs*4,r); nrs=nrs+1; }
      }
      ei=ei+1;
    }
    let j2:i32=0;
    while(j2<nrs){
      let r:i32=ig(rs,j2*4);
      // count votes per object
      let vs:[]u8=z_alloc(16*8);
      let nv:i32=0;
      ei=0;
      while(ei<nev){
        if(ig(evbuf,ei*16)==0 && ig(evbuf,ei*16+8)==r){
          let o:i32=ig(evbuf,ei*16+12);
          let k2:i32=0; let hf:i32=0;
          while(k2<nv){
            if(ig(vs,k2*8)==o){ put32(vs,k2*8+4,ig(vs,k2*8+4)+1); hf=1; }
            k2=k2+1;
          }
          if(hf==0 && nv<16){ put32(vs,nv*8,o); put32(vs,nv*8+4,1); nv=nv+1; }
        }
        ei=ei+1;
      }
      // majority object
      let bo:i32=0; let bc:i32=-1;
      let k3:i32=0;
      while(k3<nv){
        if(ig(vs,k3*8+4)>bc){ bc=ig(vs,k3*8+4); bo=ig(vs,k3*8); }
        k3=k3+1;
      }
      put32(rmap,nr*12,r); put32(rmap,nr*12+4,bo); put32(rmap,nr*12+8,bc);
      nr=nr+1;
      j2=j2+1;
    }
  }
  // answer queries
  ei=0;
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let ans:i32=-2;
      let known:i32=get_fact(fbuf,nf,s,r);
      if(known!=-999999){
        ans=known;
      } else if(cid==1){
        let j:i32=0;
        while(j<nr){
          if(ig(rmap,j*12)==r){ ans=ig(rmap,j*12+4); }
          j=j+1;
        }
      }
      out_answer(s,r,ans);
    }
    ei=ei+1;
  }
  // structure report for C
  if(cid==1){
    let sb:[]u8=z_alloc(1024);
    let p:i32=0;
    p=app_str(sb,p,"STRUCTURE id=1 subj=40206 rel=40601 answer=40901\n");
    p=app_str(sb,p,"EVIDENCE (40201,40601,40901) (40202,40601,40901) (40203,40603,40903) (40204,40603,40903) count=4\n");
    p=app_str(sb,p,"STRUCTURES 1\n");
    if(!(struct_path.len==4 && struct_path[0]==110 && struct_path[1]==111 && struct_path[2]==110 && struct_path[3]==101)){
      _zag_write_file(struct_path,sb[0..p]);
    }
  }
  return;
}

// ============ M1W2 ============
fn ctl_m1w2(cid:i32, evbuf:[]u8, nev:i32)void {
  // cid 0=D forward-only, 1=C bidirectional
  // adjacency from OBSERVEs: fwd (s->o), and for C also reverse
  let fwd:[]u8=z_alloc(64*8);
  let nf2:i32=0;
  let ei:i32=0;
  while(ei<nev){
    if(ig(evbuf,ei*16)==0 && nf2<64){
      put32(fwd,nf2*8,ig(evbuf,ei*16+4));
      put32(fwd,nf2*8+4,ig(evbuf,ei*16+12));
      nf2=nf2+1;
    }
    ei=ei+1;
  }
  ei=0;
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let e:i32=ig(evbuf,ei*16+12);
      let ans:i32=-2;
      if(r==41509){
        // walk from s up to 6 hops; D forward only, C bidirectional
        // BFS
        let seen:[]u8=z_alloc(64*4);
        let ns:i32=0;
        let frontier:[]u8=z_alloc(64*4);
        let nfr:i32=0;
        put32(frontier,0,s); nfr=1;
        put32(seen,0,s); ns=1;
        let depth:i32=0;
        let found:i32=0;
        while(depth<6 && found==0 && nfr>0){
          let nnfr:i32=0;
          let nfront2:[]u8=z_alloc(64*4);
          let fi:i32=0;
          while(fi<nfr && found==0){
            let cur:i32=ig(frontier,fi*4);
            let aj:i32=0;
            while(aj<nf2 && found==0){
              let a:i32=ig(fwd,aj*8);
              let b:i32=ig(fwd,aj*8+4);
              let nxt:i32=-1;
              if(a==cur){ nxt=b; }
              if(cid==1 && b==cur){ nxt=a; }
              if(nxt>=0){
                if(nxt==e){ found=1; }
                let sj:i32=0; let hs:i32=0;
                while(sj<ns){ if(ig(seen,sj*4)==nxt){ hs=1; } sj=sj+1; }
                if(hs==0 && ns<64 && nnfr<64){
                  put32(seen,ns*4,nxt); ns=ns+1;
                  put32(nfront2,nnfr*4,nxt); nnfr=nnfr+1;
                }
              }
              aj=aj+1;
            }
            fi=fi+1;
          }
          // copy nfront2 to frontier
          let ci2:i32=0;
          while(ci2<nnfr){ put32(frontier,ci2*4,ig(nfront2,ci2*4)); ci2=ci2+1; }
          nfr=nnfr;
          depth=depth+1;
        }
        if(found==1){ ans=e; }
      } else {
        // collateral / other: direct fact lookup
        let fbuf:[]u8=z_alloc(64*12);
        let nf:i32=0;
        let ej:i32=0;
        while(ej<nev){
          if(ig(evbuf,ej*16)==0){ nf=put_fact(fbuf,nf,ig(evbuf,ej*16+4),ig(evbuf,ej*16+8),ig(evbuf,ej*16+12)); }
          ej=ej+1;
        }
        let kn:i32=get_fact(fbuf,nf,s,r);
        if(kn!=-999999){ ans=kn; }
      }
      out_answer(s,r,ans);
    }
    ei=ei+1;
  }
  return;
}

// ============ M1W3 ============
fn ctl_m1w3(cid:i32, evbuf:[]u8, nev:i32)void {
  // cid 0=D per-key latest (novel->-2), 1=C shared-step composer (majority map)
  let fbuf:[]u8=z_alloc(64*12);
  let nf:i32=0;
  let ei:i32=0;
  while(ei<nev){
    if(ig(evbuf,ei*16)==0){
      nf=put_fact(fbuf,nf,ig(evbuf,ei*16+4),ig(evbuf,ei*16+8),ig(evbuf,ei*16+12));
    }
    ei=ei+1;
  }
  let rmap:[]u8=z_alloc(16*12);
  let nr:i32=0;
  if(cid==1){
    let rs:[]u8=z_alloc(16*4);
    let nrs:i32=0;
    ei=0;
    while(ei<nev){
      if(ig(evbuf,ei*16)==0){
        let r:i32=ig(evbuf,ei*16+8);
        let j:i32=0; let has:i32=0;
        while(j<nrs){ if(ig(rs,j*4)==r){ has=1; } j=j+1; }
        if(has==0 && nrs<16){ put32(rs,nrs*4,r); nrs=nrs+1; }
      }
      ei=ei+1;
    }
    let j2:i32=0;
    while(j2<nrs){
      let r:i32=ig(rs,j2*4);
      let vs:[]u8=z_alloc(16*8);
      let nv:i32=0;
      ei=0;
      while(ei<nev){
        if(ig(evbuf,ei*16)==0 && ig(evbuf,ei*16+8)==r){
          let o:i32=ig(evbuf,ei*16+12);
          let k2:i32=0; let hf:i32=0;
          while(k2<nv){
            if(ig(vs,k2*8)==o){ put32(vs,k2*8+4,ig(vs,k2*8+4)+1); hf=1; }
            k2=k2+1;
          }
          if(hf==0 && nv<16){ put32(vs,nv*8,o); put32(vs,nv*8+4,1); nv=nv+1; }
        }
        ei=ei+1;
      }
      let bo:i32=0; let bc:i32=-1;
      let k3:i32=0;
      while(k3<nv){
        if(ig(vs,k3*8+4)>bc){ bc=ig(vs,k3*8+4); bo=ig(vs,k3*8); }
        k3=k3+1;
      }
      put32(rmap,nr*12,r); put32(rmap,nr*12+4,bo); put32(rmap,nr*12+8,bc);
      nr=nr+1;
      j2=j2+1;
    }
  }
  ei=0;
  while(ei<nev){
    if(ig(evbuf,ei*16)==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let ans:i32=-2;
      let known:i32=get_fact(fbuf,nf,s,r);
      if(known!=-999999){
        ans=known;
      } else if(cid==1){
        let j:i32=0;
        while(j<nr){
          if(ig(rmap,j*12)==r){ ans=ig(rmap,j*12+4); }
          j=j+1;
        }
      }
      out_answer(s,r,ans);
    }
    ei=ei+1;
  }
  return;
}

// ============ M2W2 ============
fn ctl_m2w2(cid:i32, evbuf:[]u8, nev:i32)void {
  // cid 0=D1 constant 77, 1=D2 stale-action, 2=C miss/hit
  let fbuf:[]u8=z_alloc(64*12);
  let nf:i32=0;
  let ei:i32=0;
  let last_miss:i32=0; // 1 if last QUERY was a miss
  let stale:i32=0;     // D2 remembers pre-resolution action
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==0){
      nf=put_fact(fbuf,nf,ig(evbuf,ei*16+4),ig(evbuf,ei*16+8),ig(evbuf,ei*16+12));
    }
    if(k==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let kn:i32=get_fact(fbuf,nf,s,r);
      last_miss=0;
      if(kn==-999999){ last_miss=1; out_answer(s,r,-2); }
      else { out_answer(s,r,kn); }
    }
    if(k==2){
      let act:i32=0;
      if(cid==0){ act=77; }
      if(cid==1){
        if(last_miss==1){ act=30; stale=30; }
        else {
          if(stale==30){ act=30; } else { act=0; }
        }
      }
      if(cid==2){
        if(last_miss==1){ act=30; } else { act=0; }
      }
      out_choice(act);
    }
    ei=ei+1;
  }
  return;
}

// ============ M2W3 ============
fn ctl_m2w3(cid:i32, evbuf:[]u8, nev:i32)void {
  // cid 0=D constant 30, 1=C distinct per episode (11,22,33)
  let fbuf:[]u8=z_alloc(64*12);
  let nf:i32=0;
  let ei:i32=0;
  let ep:i32=0; // episode index
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==0){
      nf=put_fact(fbuf,nf,ig(evbuf,ei*16+4),ig(evbuf,ei*16+8),ig(evbuf,ei*16+12));
    }
    if(k==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let kn:i32=get_fact(fbuf,nf,s,r);
      if(kn==-999999){ out_answer(s,r,-2); }
      else { out_answer(s,r,kn); }
    }
    if(k==2){
      let act:i32=30;
      if(cid==1){
        if(ep==0){ act=11; }
        if(ep==1){ act=22; }
        if(ep==2){ act=33; }
        ep=ep+1;
      }
      out_choice(act);
    }
    ei=ei+1;
  }
  return;
}

// ============ M3W1 ============
fn ctl_m3w1(cid:i32, evbuf:[]u8, nev:i32, struct_path:[]u8)void {
  // cid 0=D per-key last-write, 1=C evidence-counted reviser.
  // C: counts deviant shifts globally across subjects on 42600; a shift with
  // >=2 consistent instances is adopted. A subject uses its adopted shift;
  // a subject whose deviant was not adopted keeps the base law (x+3);
  // unseen subjects use the adopted global law.
  let fbuf:[]u8=z_alloc(128*12);
  let nf:i32=0;
  // shift counts for C: (shift -> count), only for s in 42201..42208, r=42600
  let scbuf:[]u8=z_alloc(32*8);
  let nsc:i32=0;
  // per-subject deviant shift for C: (s -> shift), 0 = none
  let sdbuf:[]u8=z_alloc(16*8);
  let nsd:i32=0;
  let ei:i32=0;
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==0){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let o:i32=ig(evbuf,ei*16+12);
      nf=put_fact(fbuf,nf,s,r,o);
      if(cid==1 && r==42600 && s>=42201 && s<=42208){
        let sh:i32=o-s;
        if(sh!=3){
          // record subject's deviant shift (latest)
          let j:i32=0; let hf:i32=0;
          while(j<nsd){
            if(ig(sdbuf,j*8)==s){ put32(sdbuf,j*8+4,sh); hf=1; }
            j=j+1;
          }
          if(hf==0 && nsd<16){ put32(sdbuf,nsd*8,s); put32(sdbuf,nsd*8+4,sh); nsd=nsd+1; }
          // count shift globally
          j=0; hf=0;
          while(j<nsc){
            if(ig(scbuf,j*8)==sh){ put32(scbuf,j*8+4,ig(scbuf,j*8+4)+1); hf=1; }
            j=j+1;
          }
          if(hf==0 && nsc<32){ put32(scbuf,nsc*8,sh); put32(scbuf,nsc*8+4,1); nsc=nsc+1; }
        }
      }
    }
    ei=ei+1;
  }
  // adopted shift: the non-3 shift with count>=2 (take the max-count one)
  let adopted:i32=3;
  let bestc:i32=2;
  ei=0;
  while(ei<nsc){
    let sh:i32=ig(scbuf,ei*8);
    let c:i32=ig(scbuf,ei*8+4);
    if(sh!=3 && c>=bestc){ bestc=c; adopted=sh; }
    ei=ei+1;
  }
  // answer queries
  ei=0;
  while(ei<nev){
    if(ig(evbuf,ei*16)==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let ans:i32=-2;
      if(cid==0){
        // per-key last-write; 42601 probes resolve via the 42600 fact for
        // the same subject (mirrors the promotion the mechanism performs)
        let lr:i32=r;
        if(r==42601){ lr=42600; }
        let kn:i32=get_fact(fbuf,nf,s,lr);
        if(kn!=-999999){ ans=kn; }
      } else {
        if(r==42601 && s>=42201 && s<=42206){
          // subject's deviant shift, if adopted; else base law; unseen -> adopted
          let dsh:i32=0;
          let j:i32=0;
          while(j<nsd){
            if(ig(sdbuf,j*8)==s){ dsh=ig(sdbuf,j*8+4); }
            j=j+1;
          }
          if(dsh!=0){
            // check if dsh was adopted
            let ac:i32=0;
            j=0;
            while(j<nsc){
              if(ig(scbuf,j*8)==dsh && ig(scbuf,j*8+4)>=2){ ac=1; }
              j=j+1;
            }
            if(ac==1){ ans=s+dsh; } else { ans=s+3; }
          } else {
            ans=s+adopted;
          }
        } else {
          let kn:i32=get_fact(fbuf,nf,s,r);
          if(kn!=-999999){ ans=kn; }
        }
      }
      out_answer(s,r,ans);
    }
    ei=ei+1;
  }
  if(cid==1){
    let sb:[]u8=z_alloc(1024);
    let p:i32=0;
    p=app_str(sb,p,"STRUCTURE id=1 subj=42202 rel=42601 answer=42207\n");
    p=app_str(sb,p,"EVIDENCE (42202,42600,42207) (42203,42600,42208) (42204,42600,42209) count=3\n");
    p=app_str(sb,p,"STRUCTURES 1\n");
    if(!(struct_path.len==4 && struct_path[0]==110 && struct_path[1]==111 && struct_path[2]==110 && struct_path[3]==101)){
      _zag_write_file(struct_path,sb[0..p]);
    }
  }
  return;
}

// ============ M3W2 ============
fn ctl_m3w2(cid:i32, evbuf:[]u8, nev:i32)void {
  // cid 0=D global-recency responder, 1=C per-key latest + 2-hop compose
  let ei:i32=0;
  let last_o:i32=-999999; // most recent OBSERVE object (D)
  // C: per-(s,r) latest
  let fbuf:[]u8=z_alloc(64*12);
  let nf:i32=0;
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==0){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let o:i32=ig(evbuf,ei*16+12);
      last_o=o;
      nf=put_fact(fbuf,nf,s,r,o);
    }
    if(k==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let ans:i32=-2;
      if(cid==0){
        // global recency: answer most recent OBSERVE object
        if(last_o!=-999999){ ans=last_o; }
      } else {
        if(s==43201 && r==43609){
          // 2-hop compose via per-key latest links
          let mid:i32=get_fact(fbuf,nf,43201,43601);
          if(mid!=-999999){
            let fin:i32=get_fact(fbuf,nf,mid,43602);
            if(fin!=-999999){ ans=fin; }
          }
        } else {
          let kn:i32=get_fact(fbuf,nf,s,r);
          if(kn!=-999999){ ans=kn; }
        }
      }
      out_answer(s,r,ans);
    }
    ei=ei+1;
  }
  return;
}

// ============ M3W3 ============
fn ctl_m3w3(cid:i32, evbuf:[]u8, nev:i32)void {
  // cid 0=D global-recency, 1=C unpromote-and-rederive
  let ei:i32=0;
  let last_o:i32=-999999;
  let fbuf:[]u8=z_alloc(64*12);
  let nf:i32=0;
  while(ei<nev){
    let k:i32=ig(evbuf,ei*16);
    if(k==0){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let o:i32=ig(evbuf,ei*16+12);
      last_o=o;
      nf=put_fact(fbuf,nf,s,r,o);
    }
    if(k==1){
      let s:i32=ig(evbuf,ei*16+4);
      let r:i32=ig(evbuf,ei*16+8);
      let ans:i32=-2;
      if(cid==0){
        if(last_o!=-999999){ ans=last_o; }
      } else {
        if(s==43801 && r==43909){
          // re-derive 2-hop from current links (unpromote on contradiction)
          let mid:i32=get_fact(fbuf,nf,43801,43901);
          if(mid!=-999999){
            let fin:i32=get_fact(fbuf,nf,mid,43902);
            if(fin!=-999999){ ans=fin; }
          }
        } else {
          let kn:i32=get_fact(fbuf,nf,s,r);
          if(kn!=-999999){ ans=kn; }
        }
      }
      out_answer(s,r,ans);
    }
    ei=ei+1;
  }
  return;
}

// ============ M2W1 interactive controls ============
// Simulates the full M2-W1 protocol. The world side (informant responses)
// uses pi_r from the envelope. The learner side NEVER reads pi_r; the
// competent policy identifies the truthful channel purely by exploration
// (comparing informant responses to revealed truths).
fn ctl_m2w1(env_path:[]u8, cid:i32, trans_path:[]u8, log_path:[]u8)void {
  // cid 0=CONST1, 1=CONST2, 2=CONST3, 3=COMPETENT
  let ed:[]u8=_zag_read_file(env_path);
  let pi0:i32=0; let pi1:i32=0; let pi2:i32=0;
  let tbuf:[]u8=z_alloc(16*8);
  let bbuf:[]u8=z_alloc(16*8);
  let nt:i32=0; let nb:i32=0;
  let cval:i32=45999;
  let n:i32=_zag_strlen(ed);
  let s:i32=0;
  while(s<n){
    let le:i32=line_end(ed,s,n);
    let f0s:i32=skip_ws(ed,s,le);
    if(f0s<le){
      let f0e:i32=field_end(ed,f0s,le);
      let wl:i32=f0e-f0s;
      if(word_is(ed,f0s,wl,"PI")==1){
        let s1:i32=skip_ws(ed,f0e,le);
        let e1:i32=field_end(ed,s1,le);
        let s2:i32=skip_ws(ed,e1,le);
        let e2:i32=field_end(ed,s2,le);
        let s3:i32=skip_ws(ed,e2,le);
        let e3:i32=field_end(ed,s3,le);
        pi0=parse_i32(ed,s1,e1);
        pi1=parse_i32(ed,s2,e2);
        pi2=parse_i32(ed,s3,e3);
      }
      if(word_is(ed,f0s,wl,"T")==1){
        let s1:i32=skip_ws(ed,f0e,le);
        let e1:i32=field_end(ed,s1,le);
        let s2:i32=skip_ws(ed,e1,le);
        let e2:i32=field_end(ed,s2,le);
        if(is_int(ed,s1,e1)==1 && is_int(ed,s2,e2)==1 && nt<16){
          put32(tbuf,nt*8,parse_i32(ed,s1,e1));
          put32(tbuf,nt*8+4,parse_i32(ed,s2,e2));
          nt=nt+1;
        }
      }
      if(word_is(ed,f0s,wl,"B")==1){
        let s1:i32=skip_ws(ed,f0e,le);
        let e1:i32=field_end(ed,s1,le);
        let s2:i32=skip_ws(ed,e1,le);
        let e2:i32=field_end(ed,s2,le);
        if(is_int(ed,s1,e1)==1 && is_int(ed,s2,e2)==1 && nb<16){
          put32(bbuf,nb*8,parse_i32(ed,s1,e1));
          put32(bbuf,nb*8+4,parse_i32(ed,s2,e2));
          nb=nb+1;
        }
      }
      if(word_is(ed,f0s,wl,"CVAL")==1){
        let s1:i32=skip_ws(ed,f0e,le);
        let e1:i32=field_end(ed,s1,le);
        if(is_int(ed,s1,e1)==1){ cval=parse_i32(ed,s1,e1); }
      }
    }
    s=le+1;
  }
  // world-side role/response (uses pi_r)
  // learner-side facts
  let fbuf:[]u8=z_alloc(64*12);
  let nf:i32=0;
  // transcript and log buffers
  let tbuf2:[]u8=z_alloc(8192);
  let tp:i32=0;
  let lbuf:[]u8=z_alloc(4096);
  let lp:i32=0;
  // helper closures are not available; inline the logic
  // bias seeds
  nf=put_fact(fbuf,nf,45991,45600,45999);
  nf=put_fact(fbuf,nf,45992,45600,45999);
  nf=put_fact(fbuf,nf,45993,45600,45999);
  // calibration response memory for COMPETENT: per choice, per key, response
  // cal_resp[choice 1..3][keyidx 0..3] -> response, 12 entries
  let cresp:[]u8=z_alloc(12*4);
  let ci2:i32=0;
  while(ci2<12){ put32(cresp,ci2*4,-999999); ci2=ci2+1; }
  let cal_act:i32=0;
  // ---- calibration phase ----
  let cki:i32=0;
  while(cki<4){
    let key:i32=45101+cki;
    let truth:i32=-999999;
    let ti:i32=0;
    while(ti<nt){ if(ig(tbuf,ti*8)==key){ truth=ig(tbuf,ti*8+4); } ti=ti+1; }
    let aj:i32=0;
    while(aj<3){
      let choice:i32=1;
      if(cid==0){ choice=1; }
      if(cid==1){ choice=2; }
      if(cid==2){ choice=3; }
      if(cid==3){ choice=(cal_act%3)+1; }
      // world: role and response
      let rl:i32=0;
      if(choice==1){ rl=pi0; }
      if(choice==2){ rl=pi1; }
      if(choice==3){ rl=pi2; }
      // transcript CHOICE
      tp=app_str(tbuf2,tp,"CHOICE ");
      tp=app_i32(tbuf2,tp,choice);
      tp=app_str(tbuf2,tp,"\n");
      // driver log
      lp=app_str(lbuf,lp,"ACT CAL ");
      lp=app_i32(lbuf,lp,key);
      lp=app_str(lbuf,lp," ");
      lp=app_i32(lbuf,lp,choice);
      lp=app_str(lbuf,lp," ");
      if(rl==1){ lp=app_str(lbuf,lp,"A"); }
      if(rl==2){ lp=app_str(lbuf,lp,"B"); }
      if(rl==3){ lp=app_str(lbuf,lp,"C"); }
      if(rl==0){ lp=app_str(lbuf,lp,"NONE"); }
      lp=app_str(lbuf,lp,"\n");
      // informant response -> learner facts
      if(rl!=0){
        let resp:i32=0;
        if(rl==1){ resp=truth; }
        if(rl==2){
          let bi:i32=0;
          while(bi<nb){ if(ig(bbuf,bi*8)==key){ resp=ig(bbuf,bi*8+4); } bi=bi+1; }
        }
        if(rl==3){ resp=cval; }
        nf=put_fact(fbuf,nf,key,45600,resp);
        if(cid==3){
          put32(cresp,((choice-1)*4+cki)*4,resp);
        }
      }
      // truth revealed
      nf=put_fact(fbuf,nf,key,45600,truth);
      // calibration QUERY probe -> transcript ANSWER
      let kn:i32=get_fact(fbuf,nf,key,45600);
      tp=app_str(tbuf2,tp,"ANSWER ");
      tp=app_i32(tbuf2,tp,key);
      tp=app_str(tbuf2,tp," 45600 ");
      tp=app_i32(tbuf2,tp,kn);
      tp=app_str(tbuf2,tp,"\n");
      cal_act=cal_act+1;
      aj=aj+1;
    }
    cki=cki+1;
  }
  // COMPETENT: identify truthful channel (choice whose responses always matched truths)
  let best_choice:i32=1;
  if(cid==3){
    let cc:i32=1;
    while(cc<=3){
      let allok:i32=1;
      let kk:i32=0;
      while(kk<4){
        let key:i32=45101+kk;
        let truth:i32=-999999;
        let ti2:i32=0;
        while(ti2<nt){ if(ig(tbuf,ti2*8)==key){ truth=ig(tbuf,ti2*8+4); } ti2=ti2+1; }
        let resp:i32=ig(cresp,((cc-1)*4+kk)*4);
        // need at least one response recorded and all match
        // (if a choice was never answered, resp stays -999999 -> not allok)
        if(resp!=truth){ allok=0; }
        kk=kk+1;
      }
      if(allok==1){ best_choice=cc; }
      cc=cc+1;
    }
  }
  // ---- inquiry phase ----
  let hki:i32=0;
  while(hki<4){
    let key:i32=45111+hki;
    let truth:i32=-999999;
    let ti3:i32=0;
    while(ti3<nt){ if(ig(tbuf,ti3*8)==key){ truth=ig(tbuf,ti3*8+4); } ti3=ti3+1; }
    // probe QUERY
    let kn2:i32=get_fact(fbuf,nf,key,45600);
    let pans:i32=-2;
    if(kn2!=-999999){ pans=kn2; }
    tp=app_str(tbuf2,tp,"ANSWER ");
    tp=app_i32(tbuf2,tp,key);
    tp=app_str(tbuf2,tp," 45600 ");
    tp=app_i32(tbuf2,tp,pans);
    tp=app_str(tbuf2,tp,"\n");
    let aj2:i32=0;
    while(aj2<2){
      let choice:i32=1;
      if(cid==0){ choice=1; }
      if(cid==1){ choice=2; }
      if(cid==2){ choice=3; }
      if(cid==3){ choice=best_choice; }
      let rl:i32=0;
      if(choice==1){ rl=pi0; }
      if(choice==2){ rl=pi1; }
      if(choice==3){ rl=pi2; }
      tp=app_str(tbuf2,tp,"CHOICE ");
      tp=app_i32(tbuf2,tp,choice);
      tp=app_str(tbuf2,tp,"\n");
      lp=app_str(lbuf,lp,"ACT INQ ");
      lp=app_i32(lbuf,lp,key);
      lp=app_str(lbuf,lp," ");
      lp=app_i32(lbuf,lp,choice);
      lp=app_str(lbuf,lp," ");
      if(rl==1){ lp=app_str(lbuf,lp,"A"); }
      if(rl==2){ lp=app_str(lbuf,lp,"B"); }
      if(rl==3){ lp=app_str(lbuf,lp,"C"); }
      if(rl==0){ lp=app_str(lbuf,lp,"NONE"); }
      lp=app_str(lbuf,lp,"\n");
      if(rl!=0){
        let resp:i32=0;
        if(rl==1){ resp=truth; }
        if(rl==2){
          let bi:i32=0;
          while(bi<nb){ if(ig(bbuf,bi*8)==key){ resp=ig(bbuf,bi*8+4); } bi=bi+1; }
        }
        if(rl==3){ resp=cval; }
        nf=put_fact(fbuf,nf,key,45600,resp);
      }
      aj2=aj2+1;
    }
    // final QUERY probe
    let kn3:i32=get_fact(fbuf,nf,key,45600);
    let fans:i32=-2;
    if(kn3!=-999999){ fans=kn3; }
    tp=app_str(tbuf2,tp,"ANSWER ");
    tp=app_i32(tbuf2,tp,key);
    tp=app_str(tbuf2,tp," 45600 ");
    tp=app_i32(tbuf2,tp,fans);
    tp=app_str(tbuf2,tp,"\n");
    hki=hki+1;
  }
  _zag_write_file(trans_path,tbuf2[0..tp]);
  _zag_write_file(log_path,lbuf[0..lp]);
  emit("M2W1 control cid="); e64(cid); emit(" best_choice="); e64(best_choice); emit("\n");
  return;
}

// ============ main dispatch ============
fn main()i32 {
  let ac:i32=_zag_argc();
  if(ac<2){ errln("usage: v2_controls_bin ..."); return 2; }
  let a1:[]u8=_zag_arg(1);
  // M2W1 mode: argv = M2W1 <envelope> <control_id> <trans_out> <log_out>
  if(a1.len==4 && a1[0]==77 && a1[1]==50 && a1[2]==87 && a1[3]==49){
    if(ac!=6){ errln("usage: v2_controls_bin M2W1 <envelope> <cid> <trans> <log>"); return 2; }
    let cid:i32=parse_i32(_zag_arg(3),0,_zag_arg(3).len);
    ctl_m2w1(_zag_arg(2),cid,_zag_arg(4),_zag_arg(5));
    return 0;
  }
  // fixed-world mode: argv = <world> <control_id> <struct_out>
  if(ac!=4){ errln("usage: v2_controls_bin <world> <control_id> <struct_out>"); return 2; }
  let wd:[]u8=_zag_read_file(a1);
  let evbuf:[]u8=z_alloc(256*16);
  let nev:i32=parse_world(wd,evbuf);
  let cidstr:[]u8=_zag_arg(2);
  let spath:[]u8=_zag_arg(3);
  // dispatch on control id string
  if(word_is(cidstr,0,cidstr.len,"M1W1_D")==1){ ctl_m1w1(0,evbuf,nev,spath); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M1W1_C")==1){ ctl_m1w1(1,evbuf,nev,spath); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M1W2_D")==1){ ctl_m1w2(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M1W2_C")==1){ ctl_m1w2(1,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M1W3_D")==1){ ctl_m1w3(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M1W3_C")==1){ ctl_m1w3(1,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M2W2_D1")==1){ ctl_m2w2(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M2W2_D2")==1){ ctl_m2w2(1,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M2W2_C")==1){ ctl_m2w2(2,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M2W3_D")==1){ ctl_m2w3(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M2W3_C")==1){ ctl_m2w3(1,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M3W1_D")==1){ ctl_m3w1(0,evbuf,nev,spath); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M3W1_C")==1){ ctl_m3w1(1,evbuf,nev,spath); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M3W2_D")==1){ ctl_m3w2(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M3W2_C")==1){ ctl_m3w2(1,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M3W3_D")==1){ ctl_m3w3(0,evbuf,nev); return 0; }
  if(word_is(cidstr,0,cidstr.len,"M3W3_C")==1){ ctl_m3w3(1,evbuf,nev); return 0; }
  errln("unknown control id");
  return 2;
}

// genC.zag: sealed Family C episode generator for DEVANG3 adversary.
// Deterministic. No RNG, no wall-clock. Pure Zag.
// Word ids: 0 zo, 1 kan, 2 kana, 3 kalo, 4 tel, 5 telan, 6 temo,
//           7 bona, 8 bo, 9 nu, 10 maro.
// Templates: 0 DIRECT(c,s), 1 NEG(c,s), 2 REL(s), 3 SIZE(sz,s).

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }

fn wlen(w:i32)i32 {
  if(w==0){ return 2; }
  if(w==1){ return 3; }
  if(w==2){ return 4; }
  if(w==3){ return 4; }
  if(w==4){ return 3; }
  if(w==5){ return 5; }
  if(w==6){ return 4; }
  if(w==7){ return 4; }
  if(w==8){ return 2; }
  if(w==9){ return 2; }
  return 4;
}
fn wstr(w:i32)[]u8 {
  if(w==0){ return "zo"; }
  if(w==1){ return "kan"; }
  if(w==2){ return "kana"; }
  if(w==3){ return "kalo"; }
  if(w==4){ return "tel"; }
  if(w==5){ return "telan"; }
  if(w==6){ return "temo"; }
  if(w==7){ return "bona"; }
  if(w==8){ return "bo"; }
  if(w==9){ return "nu"; }
  return "maro";
}

fn ep(tmpl:i32, c:i32, s:i32, sz:i32, tgt:i32)void {
  // target / distractor features
  let tc:i32=0; let ts:i32=0; let tz:i32=0;
  let ac:i32=0; let as2:i32=0; let az:i32=0;
  let bc:i32=0; let bs:i32=0; let bz:i32=0;
  if(tmpl==0){
    tc=c; ts=s; tz=1;
    ac=(c+1)%3; as2=s; az=0;
    bc=c; bs=(s+1)%3; bz=2;
  } else if(tmpl==1){
    tc=(c+1)%3; ts=s; tz=1;
    ac=c; as2=s; az=0;
    bc=(c+1)%3; bs=(s+1)%3; bz=2;
  } else if(tmpl==2){
    tc=0; ts=s; tz=2;
    ac=1; as2=s; az=0;
    bc=2; bs=(s+1)%3; bz=1;
  } else {
    tc=2; ts=s; tz=sz;
    ac=0; as2=s; az=1-sz;
    bc=1; bs=(s+1)%3; bz=sz;
  }
  // place objects: index tgt gets target, others get A then B
  let o0c:i32=0; let o0s:i32=0; let o0z:i32=0;
  let o1c:i32=0; let o1s:i32=0; let o1z:i32=0;
  let o2c:i32=0; let o2s:i32=0; let o2z:i32=0;
  let ab:i32=0; // 0 -> next non-target slot gets A, 1 -> gets B
  if(tgt==0){ o0c=tc; o0s=ts; o0z=tz; } else { if(ab==0){ o0c=ac; o0s=as2; o0z=az; ab=1; } else { o0c=bc; o0s=bs; o0z=bz; } }
  if(tgt==1){ o1c=tc; o1s=ts; o1z=tz; } else { if(ab==0){ o1c=ac; o1s=as2; o1z=az; ab=1; } else { o1c=bc; o1s=bs; o1z=bz; } }
  if(tgt==2){ o2c=tc; o2s=ts; o2z=tz; } else { if(ab==0){ o2c=ac; o2s=as2; o2z=az; ab=1; } else { o2c=bc; o2s=bs; o2z=bz; } }
  // emit scene
  emit(i32s(o0c)); emit(" "); emit(i32s(o0s)); emit(" "); emit(i32s(o0z)); emit(" ");
  emit(i32s(o1c)); emit(" "); emit(i32s(o1s)); emit(" "); emit(i32s(o1z)); emit(" ");
  emit(i32s(o2c)); emit(" "); emit(i32s(o2s)); emit(" "); emit(i32s(o2z)); emit(" ");
  emit(i32s(tgt)); emit(" ");
  // emit utterance word ids
  let w0:i32=0; let w1:i32=0; let w2:i32=0; let w3:i32=0; let nw:i32=0;
  if(tmpl==0){ w0=0; w1=1+c; w2=4+s; nw=3; }
  else if(tmpl==1){ w0=0; w1=9; w2=1+c; w3=4+s; nw=4; }
  else if(tmpl==2){ w0=0; w1=10; w2=4+s; nw=3; }
  else { w0=0; w1=7+sz; w2=4+s; nw=3; }
  let k:i32=0;
  while(k<nw){
    let w:i32=w0;
    if(k==1){ w=w1; }
    if(k==2){ w=w2; }
    if(k==3){ w=w3; }
    emit(wstr(w));
    k=k+1;
  }
  emit("\n");
  return;
}

fn main()i32 {
  emit("60 20\n");
  // TRAIN: DIRECT-A (16)
  ep(0,0,0,0,0); ep(0,0,0,0,1); ep(0,0,0,0,2); ep(0,0,0,0,0);
  ep(0,0,1,0,0); ep(0,0,1,0,1); ep(0,0,1,0,2); ep(0,0,1,0,0);
  ep(0,1,0,0,0); ep(0,1,0,0,1); ep(0,1,0,0,2); ep(0,1,0,0,0);
  ep(0,1,1,0,0); ep(0,1,1,0,1); ep(0,1,1,0,2); ep(0,1,1,0,0);
  // TRAIN: DIRECT-B (8)
  ep(0,2,2,0,0); ep(0,2,2,0,1); ep(0,2,2,0,2); ep(0,2,2,0,0);
  ep(0,2,0,0,0); ep(0,2,0,0,1);
  ep(0,0,2,0,0); ep(0,0,2,0,1);
  // TRAIN: NEG (12)
  ep(1,0,1,0,0); ep(1,0,1,0,1); ep(1,0,1,0,2);
  ep(1,1,0,0,0); ep(1,1,0,0,1); ep(1,1,0,0,2);
  ep(1,0,0,0,0); ep(1,0,0,0,1); ep(1,0,0,0,2);
  ep(1,1,1,0,0); ep(1,1,1,0,1); ep(1,1,1,0,2);
  // TRAIN: REL (12)
  ep(2,0,0,0,0); ep(2,0,0,0,1); ep(2,0,0,0,2); ep(2,0,0,0,0); ep(2,0,0,0,1); ep(2,0,0,0,2);
  ep(2,0,1,0,0); ep(2,0,1,0,1); ep(2,0,1,0,2); ep(2,0,1,0,0); ep(2,0,1,0,1); ep(2,0,1,0,2);
  // TRAIN: SIZE (12)
  ep(3,0,0,1,0); ep(3,0,0,1,1); ep(3,0,0,1,2);
  ep(3,0,1,1,0); ep(3,0,1,1,1); ep(3,0,1,1,2);
  ep(3,0,0,0,0); ep(3,0,0,0,1); ep(3,0,0,0,2);
  ep(3,0,1,0,0); ep(3,0,1,0,1); ep(3,0,1,0,2);
  // TEST: DIRECT-T (8)
  ep(0,2,1,0,0); ep(0,2,1,0,1); ep(0,2,1,0,2); ep(0,2,1,0,0);
  ep(0,1,2,0,0); ep(0,1,2,0,1); ep(0,1,2,0,2); ep(0,1,2,0,0);
  // TEST: NEG-T (4)
  ep(1,2,1,0,0); ep(1,2,1,0,1);
  ep(1,1,2,0,0); ep(1,1,2,0,1);
  // TEST: REL-T (4)
  ep(2,0,2,0,0); ep(2,0,2,0,1); ep(2,0,2,0,2); ep(2,0,2,0,0);
  // TEST: SIZE-T (4)
  ep(3,0,2,1,0); ep(3,0,2,1,1);
  ep(3,0,2,0,0); ep(3,0,2,0,1);
  return 0;
}

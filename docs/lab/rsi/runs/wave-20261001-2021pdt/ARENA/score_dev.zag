// score_dev.zag - dev scorer for TCNP practice worlds (ARENA lane).
// Dev-only; contaminated by construction like the worlds it scores.
// Usage: score_dev <replies.jsonl> <key.txt>
// Prints per-world correct/total and abstain counts, plus A-D totals.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn streq(a:[]u8,b:[]u8)i32 {
  let al:i32=slen(a); let bl:i32=slen(b);
  if(al!=bl){return 0;}
  let i:i32=0;
  while(i<al){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_alloc(path.len+1);
  let k:i32=0;
  while(k<path.len){cp[k]=path[k];k=k+1;}
  cp[path.len]=0;
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
// split lines of d into array of slices; returns count (cap 64)
fn split_lines(d:[]u8, out:[]u8, cap:i32)i32 {
  let n:i32=0;
  let s:i32=0;
  let i:i32=0;
  while(i<d.len && n<cap){
    if(d[i]==10){
      set32(out,n*8,s); set32(out,n*8+4,i);
      n=n+1;
      s=i+1;
    }
    i=i+1;
  }
  return n;
}
// reply value of one replies.jsonl line into out(64B, null-term)
fn get_reply(line:[]u8, out:[]u8)void {
  out[0]=0;
  let p:i32=findsub(line,0,"\"reply\":\"");
  if(p<0){return;}
  let s:i32=p+9;
  let e:i32=s;
  while(e<line.len && line[e]!=34){e=e+1;}
  let k:i32=0;
  while(s+k<e && k<63){out[k]=line[s+k];k=k+1;}
  out[k]=0;
  return;
}
// key line "task|idx|vec" -> task into t(16B), vec into v(32B)
fn parse_key(line:[]u8, t:[]u8, v:[]u8)void {
  t[0]=0; v[0]=0;
  let p1:i32=findsub(line,0,"|");
  if(p1<0){return;}
  let k:i32=0;
  while(k<p1 && k<15){t[k]=line[k];k=k+1;}
  t[k]=0;
  let p2:i32=findsub(line,p1+1,"|");
  if(p2<0){return;}
  let s:i32=p2+1;
  k=0;
  while(s+k<line.len && line[s+k]!=10 && k<31){v[k]=line[s+k];k=k+1;}
  v[k]=0;
  return;
}
fn main()i32 {
  let rp:[]u8=_zag_arg(1);
  let kp:[]u8=_zag_arg(2);
  if(rp.len==0 || kp.len==0){
    emit("usage: score_dev <replies.jsonl> <key.txt>\n");
    return 1;
  }
  let rd:[]u8=read_file(rp);
  let kd:[]u8=read_file(kp);
  let rlx:[]u8=z_alloc(64*8);
  let klx:[]u8=z_alloc(64*8);
  let nr:i32=split_lines(rd,rlx,64);
  let nk:i32=split_lines(kd,klx,64);
  // collect replies for lines containing "item":
  let replies:[]u8=z_alloc(64*64);
  let nrep:i32=0;
  let i:i32=0;
  while(i<nr){
    let s:i32=get32(rlx,i*8);
    let e:i32=get32(rlx,i*8+4);
    let ln:[]u8=rd[s..e];
    if(findsub(ln,0,"\"item\":")>=0){
      get_reply(ln,replies[nrep*64..nrep*64+64]);
      nrep=nrep+1;
    }
    i=i+1;
  }
  // score in key order
  let wtot:[]u8=z_alloc(5*8);
  let wcor:[]u8=z_alloc(5*8);
  let wabs:[]u8=z_alloc(5*8);
  let wi:i32=0;
  while(wi<5){set32(wtot,wi*4,0);set32(wcor,wi*4,0);set32(wabs,wi*4,0);wi=wi+1;}
  let k:i32=0;
  let tot:i32=0; let cor:i32=0;
  while(k<nk && k<nrep){
    let s:i32=get32(klx,k*8);
    let e:i32=get32(klx,k*8+4);
    let ln:[]u8=kd[s..e];
    let t:[]u8=z_alloc(16);
    let v:[]u8=z_alloc(32);
    parse_key(ln,t,v);
    let r:[]u8=replies[k*64..k*64+64];
    let widx:i32=4;
    if(streq(t,"dA")==1){widx=0;}
    if(streq(t,"dB")==1){widx=1;}
    if(streq(t,"dC")==1){widx=2;}
    if(streq(t,"dD")==1){widx=3;}
    set32(wtot,widx*4,get32(wtot,widx*4)+1);
    if(streq(r,"UNKNOWN")==1){
      set32(wabs,widx*4,get32(wabs,widx*4)+1);
    } else {
      if(streq(r[0..slen(r)],v[0..slen(v)])==1){
        set32(wcor,widx*4,get32(wcor,widx*4)+1);
        cor=cor+1;
      }
    }
    tot=tot+1;
    z_free(t); z_free(v);
    k=k+1;
  }
  let names:[]u8="dA  dB  dC  dD  dE  ";
  wi=0;
  while(wi<5){
    let b:[]u8=z_alloc(64);
    let at:i32=0;
    at=app(b,at,names[wi*4..wi*4+2]);
    at=app(b,at,": ");
    at=app(b,at,i64s(get32(wcor,wi*4) as i64));
    at=app(b,at,"/");
    at=app(b,at,i64s(get32(wtot,wi*4) as i64));
    at=app(b,at," abstain ");
    at=app(b,at,i64s(get32(wabs,wi*4) as i64));
    at=app(b,at,"\n");
    emit(b[0..at]);
    z_free(b);
    wi=wi+1;
  }
  let ad:i32=get32(wcor,0)+get32(wcor,4)+get32(wcor,8)+get32(wcor,12);
  let b2:[]u8=z_alloc(64);
  let at2:i32=app(b2,0,"A-D total: ");
  at2=app(b2,at2,i64s(ad as i64));
  at2=app(b2,at2,"/24\n");
  emit(b2[0..at2]);
  z_free(b2);
  z_free(wtot); z_free(wcor); z_free(wabs);
  z_free(rlx); z_free(klx); z_free(replies);
  return 0;
}

// gen_devworlds.zag - builder dev-world generator for TCNP (ARENA lane).
// CONTAMINATED BY CONSTRUCTION: dev-only practice worlds, never sealed,
// never counted toward any bar. Pure Zag.
// Usage: gen_devworlds <outdir>  -> <outdir>/turns.jsonl, <outdir>/key.txt
// Worlds: dA, dB, dC (novel rules, at most 4 ops), dD (same abstract rule
// as dA, fresh surface values; tests rebind), dE (6-step rule; honesty
// probe analog). Each: 4 shown pairs, 6 hidden items. Hidden inputs are
// novel and at Hamming distance >= 2 from every shown input of the world,
// so the memorization control is meaningful on dev data.

// --- utils ---
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_alloc(path.len+1);
  let k:i32=0;
  while(k<path.len){c[k]=path[k];k=k+1;}
  c[path.len]=0;
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}

// --- op semantics (must match tcn_step in the contestant) ---
fn sim_step(vec:[]u8, opid:i32, a:i32, b:i32)void {
  if(opid==1){ set32(vec,a*4,get32(vec,b*4)); return; }
  if(opid==2){
    let t:i32=get32(vec,a*4);
    set32(vec,a*4,get32(vec,b*4));
    set32(vec,b*4,t);
    return;
  }
  if(opid==3){
    let t0:i32=get32(vec,0);
    set32(vec,0,get32(vec,4)); set32(vec,4,get32(vec,8));
    set32(vec,8,get32(vec,12)); set32(vec,12,t0);
    return;
  }
  if(opid==4){
    let t3:i32=get32(vec,12);
    set32(vec,12,get32(vec,8)); set32(vec,8,get32(vec,4));
    set32(vec,4,get32(vec,0)); set32(vec,0,t3);
    return;
  }
  if(opid==5){
    let x0:i32=get32(vec,0); let x1:i32=get32(vec,4);
    set32(vec,0,get32(vec,12)); set32(vec,4,get32(vec,8));
    set32(vec,8,x1); set32(vec,12,x0);
    return;
  }
  if(opid==6){ let v:i32=get32(vec,a*4); set32(vec,a*4,(v+1)%8); return; }
  if(opid==7){ let v:i32=get32(vec,a*4); set32(vec,a*4,(v+7)%8); return; }
  if(opid==8){ set32(vec,a*4,0); return; }
  return;
}

// --- dev world data (builder-chosen; contaminated by construction) ---
fn wname(wi:i32)[]u8 {
  if(wi==0){return "dA";}
  if(wi==1){return "dB";}
  if(wi==2){return "dC";}
  if(wi==3){return "dD";}
  return "dE";
}
// steps as 3B triples; returns step count
fn world_steps(wi:i32, out:[]u8)i32 {
  if(wi==0 || wi==3){
    out[0]=3; out[1]=0; out[2]=0;   // ROTL
    out[3]=6; out[4]=0; out[5]=0;   // INC(0)
    return 2;
  }
  if(wi==1){
    out[0]=5; out[1]=0; out[2]=0;   // REVERSE
    out[3]=7; out[4]=2; out[5]=0;   // DEC(2)
    return 2;
  }
  if(wi==2){
    out[0]=2; out[1]=0; out[2]=3;   // SWAP(0,3)
    out[3]=6; out[4]=1; out[5]=0;   // INC(1)
    out[6]=6; out[7]=1; out[8]=0;   // INC(1)
    return 3;
  }
  // dE: 6 steps (beyond K=4)
  out[0]=3; out[1]=0; out[2]=0;
  out[3]=6; out[4]=0; out[5]=0;
  out[6]=6; out[7]=1; out[8]=0;
  out[9]=2; out[10]=1; out[11]=2;
  out[12]=7; out[13]=3; out[14]=0;
  out[15]=5; out[16]=0; out[17]=0;
  return 6;
}
fn wshown(wi:i32)[]u8 {
  if(wi==0){return "1,2,3,4;5,0,2,7;3,3,1,0;6,5,4,3";}
  if(wi==1){return "2,5,1,6;0,3,7,4;1,1,2,2;7,0,5,3";}
  if(wi==2){return "3,1,4,2;0,6,2,5;7,2,0,1;4,4,6,0";}
  if(wi==3){return "2,0,6,1;4,7,3,5;1,5,0,2;3,2,7,4";}
  return "1,4,2,6;5,0,3,7;2,6,1,3;0,5,7,4";
}
fn whidden(wi:i32)[]u8 {
  if(wi==0){return "0,1,2,3;7,6,5,4;2,4,6,0;1,3,5,7;4,0,1,6;2,7,0,5";}
  if(wi==1){return "4,2,0,6;1,6,3,0;5,4,3,2;0,0,7,7;3,2,1,0;6,1,4,2";}
  if(wi==2){return "1,0,3,7;5,3,1,4;2,7,5,0;6,1,0,3;0,2,4,6;7,5,3,1";}
  if(wi==3){return "5,1,4,0;0,4,2,6;6,3,1,7;2,2,5,5;7,0,3,2;1,6,4,3";}
  return "3,1,5,2;6,2,0,4;4,3,6,1;7,4,0,5;1,0,4,7;5,6,2,0";
}
// parse "v0,v1,v2,v3;..." into 16B-per-vec buffer; returns count
fn parse_veclist(s:[]u8, out:[]u8, maxv:i32)i32 {
  let nv:i32=0;
  let p:i32=0;
  while(p<s.len && nv<maxv){
    let k:i32=0;
    while(k<4){
      while(p<s.len && (s[p]<48 || s[p]>57)){p=p+1;}
      if(p>=s.len){return nv;}
      let v:i32=0;
      while(p<s.len && s[p]>=48 && s[p]<=57){v=v*10+(s[p] as i32)-48; p=p+1;}
      set32(out,nv*16+k*4,v);
      k=k+1;
    }
    nv=nv+1;
  }
  return nv;
}
fn app4(b:[]u8, at:i32, v:[]u8)i32 {
  at=app(b,at,i64s(get32(v,0) as i64)); at=app(b,at,",");
  at=app(b,at,i64s(get32(v,4) as i64)); at=app(b,at,",");
  at=app(b,at,i64s(get32(v,8) as i64)); at=app(b,at,",");
  at=app(b,at,i64s(get32(v,12) as i64));
  return at;
}
fn emit_world(tfd:i64, kfd:i64, wi:i32)void {
  let wn:[]u8=wname(wi);
  let steps:[]u8=z_alloc(18);
  let nst:i32=world_steps(wi,steps);
  let shown:[]u8=z_alloc(64);
  let hidden:[]u8=z_alloc(96);
  let nsh:i32=parse_veclist(wshown(wi),shown,4);
  let nhi:i32=parse_veclist(whidden(wi),hidden,6);
  let vec:[]u8=z_alloc(16);
  let e:i32=0;
  while(e<nsh){
    let sb:i32=e*16;
    set32(vec,0,get32(shown,sb)); set32(vec,4,get32(shown,sb+4));
    set32(vec,8,get32(shown,sb+8)); set32(vec,12,get32(shown,sb+12));
    let j:i32=0;
    while(j<nst){
      sim_step(vec,steps[j*3] as i32,steps[j*3+1] as i32,steps[j*3+2] as i32);
      j=j+1;
    }
    let t:i32=1+wi*10+e;
    let b:[]u8=z_alloc(256);
    let at:i32=app(b,0,"{\"turn\":");
    at=app(b,at,i64s(t as i64));
    at=app(b,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"pshow\",\"task\":\"");
    at=app(b,at,wn);
    at=app(b,at,"\",\"in\":[");
    at=app4(b,at,shown[sb..sb+16]);
    at=app(b,at,"],\"out\":[");
    at=app4(b,at,vec);
    at=app(b,at,"]}}\n");
    w_write(tfd,b[0..at]);
    z_free(b);
    e=e+1;
  }
  let h:i32=0;
  while(h<nhi){
    let hb:i32=h*16;
    set32(vec,0,get32(hidden,hb)); set32(vec,4,get32(hidden,hb+4));
    set32(vec,8,get32(hidden,hb+8)); set32(vec,12,get32(hidden,hb+12));
    let j:i32=0;
    while(j<nst){
      sim_step(vec,steps[j*3] as i32,steps[j*3+1] as i32,steps[j*3+2] as i32);
      j=j+1;
    }
    let t:i32=1+wi*10+4+h;
    let item:i32=wi*6+h;
    let b:[]u8=z_alloc(256);
    let at:i32=app(b,0,"{\"turn\":");
    at=app(b,at,i64s(t as i64));
    at=app(b,at,",\"kind\":\"test\",\"item\":");
    at=app(b,at,i64s(item as i64));
    at=app(b,at,",\"cap\":90,\"q\":\"ptest|");
    at=app(b,at,wn);
    at=app(b,at,"|");
    at=app4(b,at,hidden[hb..hb+16]);
    at=app(b,at,"\"}\n");
    w_write(tfd,b[0..at]);
    z_free(b);
    let kb:[]u8=z_alloc(64);
    let ka:i32=app(kb,0,wn);
    ka=app(kb,ka,"|");
    ka=app(kb,ka,i64s(h as i64));
    ka=app(kb,ka,"|");
    ka=app4(kb,ka,vec);
    ka=app(kb,ka,"\n");
    w_write(kfd,kb[0..ka]);
    z_free(kb);
    h=h+1;
  }
  z_free(steps); z_free(shown); z_free(hidden); z_free(vec);
  return;
}

fn main()i32 {
  let dir:[]u8=_zag_arg(1);
  if(dir.len==0){
    _zag_print("usage: gen_devworlds <outdir>\n");
    return 1;
  }
  let tfd:i64=w_open(pjoin(dir,"turns.jsonl"));
  let kfd:i64=w_open(pjoin(dir,"key.txt"));
  if(tfd<0 || kfd<0){
    _zag_print("open failed\n");
    return 1;
  }
  let b0:[]u8="{\"turn\":0,\"kind\":\"brief\"}\n";
  w_write(tfd,b0);
  let wi:i32=0;
  while(wi<5){
    emit_world(tfd,kfd,wi);
    wi=wi+1;
  }
  let bd:[]u8="{\"turn\":51,\"kind\":\"done\"}\n";
  w_write(tfd,bd);
  w_close(tfd);
  w_close(kfd);
  _zag_print("dev worlds written\n");
  return 0;
}

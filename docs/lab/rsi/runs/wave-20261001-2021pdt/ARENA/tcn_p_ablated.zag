// devint1_contestant_v6.zag - Developmental TNN contestant for CA-2 arena.
// v6 = v4 + Zem morphological rule induction (C16 language lane).
// Additive only: no v4 handler or store is altered. Uses DEVINT1's actual
// learning mechanisms (lexicon induction) plus a structured morphology store
// (word lexicon + per-class segment templates + position-wise rewrite rule)
// learned purely from labeled word exposure events.
// Usage: devint1_contestant_v6 <turn.json> <statedir> <worlddir>
// Pure Zag. No Python.

// --- TCNP extension (wave-20261001-2021pdt, ARENA lane) ---
// Trial-constructed named procedures over a frozen 8-op generic ISA, per
// frozen PREREG_ARENA_PROCEDURE.md (same lane). Additive only: no v6
// handler, store, or reply format is altered. New expo event type "pshow"
// and new test question head "ptest" dispatch exactly like existing types
// (event-type dispatch only; no new modes, bridges, routers, or gates).
// Learner state (procedure table, task records, trial log, verdict records)
// lives in W[16384..]; the v6 region W[0..16384) is untouched. The 8 ops
// (COPY, SWAP, ROTL, ROTR, REVERSE, INC, DEC, SET0) are domain-neutral
// machinery; no op encodes any target-domain regularity.

// --- basic utils ---
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn streq(a:[]u8,b:[]u8)i32 {
  let al:i32=slen(a);
  let bl:i32=slen(b);
  if(al!=bl){return 0;}
  let i:i32=0;
  while(i<al){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn appz(buf:[]u8,at:i32,s:[]u8)i32 {
  let n:i32=slen(s);
  let i:i32=0;
  while(i<n){buf[at+i]=s[i];i=i+1;}
  return at+n;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn jval(line:[]u8,key:[]u8)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":\"");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at;
  let e:i32=s;
  while(e<line.len && line[e]!=34){e=e+1;}
  return line[s..e];
}
fn jint(line:[]u8,key:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+3);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return -999999;}
  let s:i32=p+at;
  let neg:i32=0;
  if(s<line.len && line[s]==45){neg=1;s=s+1;}
  let v:i32=0;
  while(s<line.len && line[s]>=48 && line[s]<=57){
    v=v*10+(line[s] as i32)-48;
    s=s+1;
  }
  if(neg==1){v=-v;}
  return v;
}
fn now_ms()i64 {
  let tv:[]u8=z_alloc(16);
  _zag_raw_syscall(228,(_zag_slice_ptr(tv) as i64),0,0,0,0,0);
  let sec:i64=(tv[0] as i64)|((tv[1] as i64)<<8)|((tv[2] as i64)<<16)|((tv[3] as i64)<<24)|((tv[4] as i64)<<32)|((tv[5] as i64)<<40)|((tv[6] as i64)<<48)|((tv[7] as i64)<<56);
  let nsec:i64=(tv[8] as i64)|((tv[9] as i64)<<8)|((tv[10] as i64)<<16)|((tv[11] as i64)<<24)|((tv[12] as i64)<<32)|((tv[13] as i64)<<40)|((tv[14] as i64)<<48)|((tv[15] as i64)<<56);
  z_free(tv);
  return sec*1000+nsec/1000000;
}
fn peak_rss()i64 {
  let p:[]u8=read_file("/proc/self/status");
  let k:[]u8="VmHWM:";
  let idx:i32=findsub(p,0,k);
  if(idx<0){z_free(p);return 0;}
  let s:i32=idx+k.len;
  while(s<p.len && (p[s]<48 || p[s]>57)){s=s+1;}
  let v:i64=0;
  while(s<p.len && p[s]>=48 && p[s]<=57){v=v*10+(p[s] as i64)-48;s=s+1;}
  z_free(p);
  return v;
}

// --- DEVINT1 W buffer and mechanisms ---
// W layout (16384 bytes):
//   0: tick(i32)  8: nsegs(i32)
//   64: concepts, 24 x 32B
//   832: lexicon, 256 x 12B
//   3904: rules, 32 x 32B
//   4928: fact store, 64 x 48B (0..15:entity 16..31:attr 32..47:value)
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn tick(W:[]u8)i32 { let t:i32=get32(W,0)+1; set32(W,0,t); return t; }
fn ilog(v:i32)i32 {
  let r:i32=0; let p:i32=1;
  while(p*2<=v){ p=p*2; r=r+1; }
  return r;
}

// Lexicon: 256 entries x 12B at offset 832
fn lex_bump(W:[]u8, s:[]u8, off:i32, n:i32)void {
  let lb:i32=832;
  let e:i32=0;
  while(e<256){
    let el:i32=get32(W,lb+e*12+4);
    if(el==0){
      let k:i32=0; while(k<n && k<8){ W[lb+e*12+k]=s[off+k]; k=k+1; }
      set32(W,lb+e*12+4,n); set32(W,lb+e*12+8,1);
      return;
    }
    if(el==n){
      let ok:i32=1; let k:i32=0;
      while(k<n && k<8){ if(W[lb+e*12+k]!=s[off+k]){ok=0;} k=k+1; }
      if(ok==1){ set32(W,lb+e*12+8,get32(W,lb+e*12+8)+1); return; }
    }
    e=e+1;
  }
  return;
}
fn lex_feed(W:[]u8, s:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){
    let L:i32=2;
    while(L<=4){ if(i+L<=n){ lex_bump(W,s,i,L); } L=L+1; }
    i=i+1;
  }
  return;
}
fn lex_count(W:[]u8)i32 {
  let lb:i32=832;
  let c:i32=0;
  let e:i32=0;
  while(e<256){
    if(get32(W,lb+e*12+4)>0){c=c+1;}
    e=e+1;
  }
  return c;
}

// Concepts: 24 entries x 32B at offset 64
// Each: 0:id 4:plen 8:count 12:last_used 16:valid 20..27:pattern (8 bytes)
fn conc_touch(W:[]u8, s:[]u8, off:i32, n:i32, t:i32)i32 {
  let cb:i32=64;
  // find existing
  let e:i32=0;
  while(e<24){
    if(get32(W,cb+e*32+16)==1 && get32(W,cb+e*32+4)==n){
      let ok:i32=1; let k:i32=0;
      while(k<n && k<8){ if(W[cb+e*32+20+k]!=s[off+k]){ok=0;} k=k+1; }
      if(ok==1){
        set32(W,cb+e*32+8,get32(W,cb+e*32+8)+1);
        set32(W,cb+e*32+12,t);
        return get32(W,cb+e*32);
      }
    }
    e=e+1;
  }
  // create new
  e=0;
  while(e<24){
    if(get32(W,cb+e*32+16)!=1){
      let id:i32=tick(W);
      set32(W,cb+e*32,id);
      set32(W,cb+e*32+4,n);
      set32(W,cb+e*32+8,1);
      set32(W,cb+e*32+12,t);
      set32(W,cb+e*32+16,1);
      let k:i32=0; while(k<n && k<8){ W[cb+e*32+20+k]=s[off+k]; k=k+1; }
      return id;
    }
    e=e+1;
  }
  return -1;
}
fn conc_count(W:[]u8)i32 {
  let cb:i32=64;
  let c:i32=0;
  let e:i32=0;
  while(e<24){
    if(get32(W,cb+e*32+16)==1){c=c+1;}
    e=e+1;
  }
  return c;
}
fn conc_find(W:[]u8, s:[]u8, off:i32, n:i32)i32 {
  let cb:i32=64;
  let e:i32=0;
  while(e<24){
    if(get32(W,cb+e*32+16)==1 && get32(W,cb+e*32+4)==n){
      let ok:i32=1; let k:i32=0;
      while(k<n && k<8){ if(W[cb+e*32+20+k]!=s[off+k]){ok=0;} k=k+1; }
      if(ok==1){ return get32(W,cb+e*32); }
    }
    e=e+1;
  }
  return -1;
}

// Rules: 32 entries x 32B at offset 3904
// Each: 0:from 4:to 8:support 12:refutes 16:state 20:last_used 24:uses 28:pend
fn rule_touch(W:[]u8, from:i32, to:i32, t:i32)i32 {
  let rb:i32=3904;
  let e:i32=0;
  while(e<32){
    if(get32(W,rb+e*32+16)==1 && get32(W,rb+e*32)==from && get32(W,rb+e*32+4)==to){
      set32(W,rb+e*32+8,get32(W,rb+e*32+8)+1);
      set32(W,rb+e*32+20,t);
      set32(W,rb+e*32+24,get32(W,rb+e*32+24)+1);
      return 1;
    }
    e=e+1;
  }
  e=0;
  while(e<32){
    if(get32(W,rb+e*32+16)!=1){
      set32(W,rb+e*32,from);
      set32(W,rb+e*32+4,to);
      set32(W,rb+e*32+8,1);
      set32(W,rb+e*32+12,0);
      set32(W,rb+e*32+16,1);
      set32(W,rb+e*32+20,t);
      set32(W,rb+e*32+24,1);
      set32(W,rb+e*32+28,0);
      return 1;
    }
    e=e+1;
  }
  return 0;
}
fn rule_predict(W:[]u8, from:i32)i32 {
  let rb:i32=3904;
  let best:i32=-1;
  let bestsup:i32=0;
  let e:i32=0;
  while(e<32){
    if(get32(W,rb+e*32+16)==1 && get32(W,rb+e*32)==from){
      let sup:i32=get32(W,rb+e*32+8);
      if(sup>bestsup){bestsup=sup;best=get32(W,rb+e*32+4);}
    }
    e=e+1;
  }
  return best;
}
fn rule_count(W:[]u8)i32 {
  let rb:i32=3904;
  let c:i32=0;
  let e:i32=0;
  while(e<32){
    if(get32(W,rb+e*32+16)==1){c=c+1;}
    e=e+1;
  }
  return c;
}

// Fact store: 64 entries x 48B at offset 4928
// Each: 0..15:entity (16B) 16..31:attr (16B) 32..47:value (16B)
fn fact_store(W:[]u8, e:[]u8, a:[]u8, v:[]u8)void {
  let fb:i32=4928;
  // check if exists (update)
  let i:i32=0;
  while(i<64){
    let base:i32=fb+i*48;
    if(W[base]!=0){
      let ok:i32=1;
      let k:i32=0;
      while(k<16){
        if(k<slen(e)){ if(W[base+k]!=e[k]){ok=0;} }
        else { if(W[base+k]!=0){ok=0;} }
        k=k+1;
      }
      k=0;
      while(k<16){
        if(k<slen(a)){ if(W[base+16+k]!=a[k]){ok=0;} }
        else { if(W[base+16+k]!=0){ok=0;} }
        k=k+1;
      }
      if(ok==1){
        // update value
        k=0;
        while(k<16){
          if(k<slen(v)){W[base+32+k]=v[k];} else {W[base+32+k]=0;}
          k=k+1;
        }
        return;
      }
    }
    i=i+1;
  }
  // add new
  i=0;
  while(i<64){
    let base:i32=fb+i*48;
    if(W[base]==0){
      let k:i32=0;
      while(k<16){ if(k<slen(e)){W[base+k]=e[k];} else {W[base+k]=0;} k=k+1; }
      k=0;
      while(k<16){ if(k<slen(a)){W[base+16+k]=a[k];} else {W[base+16+k]=0;} k=k+1; }
      k=0;
      while(k<16){ if(k<slen(v)){W[base+32+k]=v[k];} else {W[base+32+k]=0;} k=k+1; }
      return;
    }
    i=i+1;
  }
  return;
}
fn fact_get(W:[]u8, e:[]u8, a:[]u8, out:[]u8)i32 {
  let fb:i32=4928;
  let i:i32=0;
  while(i<64){
    let base:i32=fb+i*48;
    if(W[base]!=0){
      let ok:i32=1;
      let k:i32=0;
      while(k<16){
        if(k<slen(e)){ if(W[base+k]!=e[k]){ok=0;} }
        else { if(W[base+k]!=0){ok=0;} }
        k=k+1;
      }
      k=0;
      while(k<16){
        if(k<slen(a)){ if(W[base+16+k]!=a[k]){ok=0;} }
        else { if(W[base+16+k]!=0){ok=0;} }
        k=k+1;
      }
      if(ok==1){
        k=0;
        while(k<16){ out[k]=W[base+32+k]; k=k+1; }
        return 1;
      }
    }
    i=i+1;
  }
  return 0;
}
fn fact_count(W:[]u8)i32 {
  let fb:i32=4928;
  let c:i32=0;
  let i:i32=0;
  while(i<64){
    if(W[fb+i*48]!=0){c=c+1;}
    i=i+1;
  }
  return c;
}

// Relation store: 64 entries x 48B at offset 8000
// Each: 0..15:entity_a (16B) 16..31:rel_name (16B) 32..47:entity_b (16B)
// Uses free space 8000..11072 (facts end at 8000, state is 16384)
fn rel_store(W:[]u8, a:[]u8, r:[]u8, b:[]u8)void {
  let rb:i32=8000;
  // update existing (a,r) -> b
  let i:i32=0;
  while(i<64){
    let base:i32=rb+i*48;
    if(W[base]!=0){
      let ok:i32=1;
      let k:i32=0;
      while(k<16){
        if(k<slen(a)){ if(W[base+k]!=a[k]){ok=0;} }
        else { if(W[base+k]!=0){ok=0;} }
        k=k+1;
      }
      k=0;
      while(k<16){
        if(k<slen(r)){ if(W[base+16+k]!=r[k]){ok=0;} }
        else { if(W[base+16+k]!=0){ok=0;} }
        k=k+1;
      }
      if(ok==1){
        k=0;
        while(k<16){ if(k<slen(b)){W[base+32+k]=b[k];} else {W[base+32+k]=0;} k=k+1; }
        return;
      }
    }
    i=i+1;
  }
  // create new
  i=0;
  while(i<64){
    let base:i32=rb+i*48;
    if(W[base]==0){
      let k:i32=0;
      while(k<16){ if(k<slen(a)){W[base+k]=a[k];} else {W[base+k]=0;} k=k+1; }
      k=0;
      while(k<16){ if(k<slen(r)){W[base+16+k]=r[k];} else {W[base+16+k]=0;} k=k+1; }
      k=0;
      while(k<16){ if(k<slen(b)){W[base+32+k]=b[k];} else {W[base+32+k]=0;} k=k+1; }
      return;
    }
    i=i+1;
  }
  return;
}
fn rel_get(W:[]u8, a:[]u8, r:[]u8, out:[]u8)i32 {
  let rb:i32=8000;
  let i:i32=0;
  while(i<64){
    let base:i32=rb+i*48;
    if(W[base]!=0){
      let ok:i32=1;
      let k:i32=0;
      while(k<16){
        if(k<slen(a)){ if(W[base+k]!=a[k]){ok=0;} }
        else { if(W[base+k]!=0){ok=0;} }
        k=k+1;
      }
      k=0;
      while(k<16){
        if(k<slen(r)){ if(W[base+16+k]!=r[k]){ok=0;} }
        else { if(W[base+16+k]!=0){ok=0;} }
        k=k+1;
      }
      if(ok==1){
        k=0;
        while(k<16){ out[k]=W[base+32+k]; k=k+1; }
        return 1;
      }
    }
    i=i+1;
  }
  return 0;
}
fn rel_count(W:[]u8)i32 {
  let rb:i32=8000;
  let c:i32=0;
  let i:i32=0;
  while(i<64){
    if(W[rb+i*48]!=0){c=c+1;}
    i=i+1;
  }
  return c;
}

// Conflict store: 32 entries x 64B at offset 11072
// Each: 0..15:entity (16B) 16..31:attr (16B) 32..47:value1 (16B) 48..63:value2 (16B)
// Uses free space 11072..13120 (relations end at 11072, state is 16384)
fn conf_store(W:[]u8, e:[]u8, a:[]u8, v1:[]u8, v2:[]u8)void {
  let cb:i32=11072;
  // check if exists (update both values)
  let i:i32=0;
  while(i<32){
    let base:i32=cb+i*64;
    if(W[base]!=0){
      let ok:i32=1;
      let k:i32=0;
      while(k<16){
        if(k<slen(e)){ if(W[base+k]!=e[k]){ok=0;} }
        else { if(W[base+k]!=0){ok=0;} }
        k=k+1;
      }
      k=0;
      while(k<16){
        if(k<slen(a)){ if(W[base+16+k]!=a[k]){ok=0;} }
        else { if(W[base+16+k]!=0){ok=0;} }
        k=k+1;
      }
      if(ok==1){
        // update both values
        k=0;
        while(k<16){
          if(k<slen(v1)){W[base+32+k]=v1[k];} else {W[base+32+k]=0;}
          k=k+1;
        }
        k=0;
        while(k<16){
          if(k<slen(v2)){W[base+48+k]=v2[k];} else {W[base+48+k]=0;}
          k=k+1;
        }
        return;
      }
    }
    i=i+1;
  }
  // add new
  i=0;
  while(i<32){
    let base:i32=cb+i*64;
    if(W[base]==0){
      let k:i32=0;
      while(k<16){ if(k<slen(e)){W[base+k]=e[k];} else {W[base+k]=0;} k=k+1; }
      k=0;
      while(k<16){ if(k<slen(a)){W[base+16+k]=a[k];} else {W[base+16+k]=0;} k=k+1; }
      k=0;
      while(k<16){ if(k<slen(v1)){W[base+32+k]=v1[k];} else {W[base+32+k]=0;} k=k+1; }
      k=0;
      while(k<16){ if(k<slen(v2)){W[base+48+k]=v2[k];} else {W[base+48+k]=0;} k=k+1; }
      return;
    }
    i=i+1;
  }
  return;
}
fn conf_get(W:[]u8, e:[]u8, a:[]u8, out1:[]u8, out2:[]u8)i32 {
  let cb:i32=11072;
  let i:i32=0;
  while(i<32){
    let base:i32=cb+i*64;
    if(W[base]!=0){
      let ok:i32=1;
      let k:i32=0;
      while(k<16){
        if(k<slen(e)){ if(W[base+k]!=e[k]){ok=0;} }
        else { if(W[base+k]!=0){ok=0;} }
        k=k+1;
      }
      k=0;
      while(k<16){
        if(k<slen(a)){ if(W[base+16+k]!=a[k]){ok=0;} }
        else { if(W[base+16+k]!=0){ok=0;} }
        k=k+1;
      }
      if(ok==1){
        k=0;
        while(k<16){ out1[k]=W[base+32+k]; k=k+1; }
        k=0;
        while(k<16){ out2[k]=W[base+48+k]; k=k+1; }
        return 1;
      }
    }
    i=i+1;
  }
  return 0;
}
fn conf_count(W:[]u8)i32 {
  let cb:i32=11072;
  let c:i32=0;
  let i:i32=0;
  while(i<32){
    if(W[cb+i*64]!=0){c=c+1;}
    i=i+1;
  }
  return c;
}

// --- Zem morphology store ---
// W offsets (free region 13120..16384):
//   13120: word lexicon, 24 entries x 32B
//     0..15: word name (16B), 16: class code (1=A,2=B,3=new-word),
//     17..19: pad, 20..31: segments s0,s1,s2 (3 x i32)
//   13888: class-A template (3 x i32)
//   13900: class-B template (3 x i32)
//   13912: A-known flag (i32)  13916: B-known flag (i32)
//   13920: template-conflict counter (i32, white-box diagnostic)
// Class templates are induced from labeled examples only: the first A-class
// (or new-word) example sets the A template; the first B-class example sets
// the B template. No segment values, word names, or answers are hardcoded.
fn zem_store(W:[]u8, w:[]u8, cls:i32, s0:i32, s1:i32, s2:i32)void {
  let zb:i32=13120;
  // update existing word entry
  let i:i32=0;
  while(i<24){
    let base:i32=zb+i*32;
    if(W[base]!=0){
      let ok:i32=1;
      let k:i32=0;
      while(k<16){
        if(k<slen(w)){ if(W[base+k]!=w[k]){ok=0;} }
        else { if(W[base+k]!=0){ok=0;} }
        k=k+1;
      }
      if(ok==1){
        W[base+16]=cls as u8;
        set32(W,base+20,s0); set32(W,base+24,s1); set32(W,base+28,s2);
        return;
      }
    }
    i=i+1;
  }
  // add new word entry
  i=0;
  while(i<24){
    let base:i32=zb+i*32;
    if(W[base]==0){
      let k:i32=0;
      while(k<16){ if(k<slen(w)){W[base+k]=w[k];} else {W[base+k]=0;} k=k+1; }
      W[base+16]=cls as u8;
      set32(W,base+20,s0); set32(W,base+24,s1); set32(W,base+28,s2);
      // template induction from the first labeled example of each class
      if(cls==1 || cls==3){
        if(get32(W,13912)==0){
          set32(W,13888,s0); set32(W,13892,s1); set32(W,13896,s2);
          set32(W,13912,1);
        } else {
          if(get32(W,13888)!=s0 || get32(W,13892)!=s1 || get32(W,13896)!=s2){
            set32(W,13920,get32(W,13920)+1);
          }
        }
      }
      if(cls==2){
        if(get32(W,13916)==0){
          set32(W,13900,s0); set32(W,13904,s1); set32(W,13908,s2);
          set32(W,13916,1);
        } else {
          if(get32(W,13900)!=s0 || get32(W,13904)!=s1 || get32(W,13908)!=s2){
            set32(W,13920,get32(W,13920)+1);
          }
        }
      }
      return;
    }
    i=i+1;
  }
  return;
}
fn zem_count(W:[]u8)i32 {
  let zb:i32=13120;
  let c:i32=0;
  let i:i32=0;
  while(i<24){
    if(W[zb+i*32]!=0){c=c+1;}
    i=i+1;
  }
  return c;
}

// --- state persistence ---
// ST_SIZE covers the v6 region (16384) plus the TCNP learner-state region.
fn ST_SIZE()i32 { return 218704; }
fn st_load(st:[]u8, path:[]u8)void {
  let d:[]u8=read_file(path);
  let n:i32=d.len;
  if(n>ST_SIZE()){n=ST_SIZE();}
  let i:i32=0;
  while(i<n){st[i]=d[i];i=i+1;}
  z_free(d);
  return;
}
fn st_save(st:[]u8, path:[]u8)i32 {
  let fd:i64=w_open(path);
  if(fd<0){return 0;}
  w_write(fd,st[0..ST_SIZE()]);
  w_close(fd);
  return ST_SIZE();
}

// --- question parsing ---
// q format: "head|p1|p2|p3" (pipe-separated)
fn qpart(q:[]u8, idx:i32, out:[]u8)void {
  let start:i32=0;
  let cur:i32=0;
  let i:i32=0;
  while(i<q.len){
    if(q[i]==124){ // '|' = 124
      if(cur==idx){
        let k:i32=0;
        while(start+k<i && k<63){out[k]=q[start+k];k=k+1;}
        out[k]=0;
        return;
      }
      cur=cur+1;
      start=i+1;
    }
    i=i+1;
  }
  // handle last part (no trailing pipe)
  if(cur==idx){
    let k:i32=0;
    while(start+k<q.len && k<63){out[k]=q[start+k];k=k+1;}
    out[k]=0;
    return;
  }
  out[0]=0;
  return;
}
fn copy16(dst:[]u8, src:[]u8)void {
  let n:i32=slen(src);
  if(n>15){n=15;}
  let i:i32=0;
  while(i<n){dst[i]=src[i];i=i+1;}
  dst[n]=0;
  return;
}

// --- main learning: process an exposure ---
// Encodes entity/attr/value as a raw string and feeds through DEVINT1 mechanisms
fn learn_fact(W:[]u8, e:[]u8, a:[]u8, v:[]u8)void {
  let t:i32=tick(W);
  // Copy to null-terminated buffers (jval returns slices)
  let eb:[]u8=z_alloc(32); let ab:[]u8=z_alloc(32); let vb:[]u8=z_alloc(32);
  let i:i32=0;
  while(i<e.len && i<31){eb[i]=e[i];i=i+1;} eb[i]=0;
  i=0; while(i<a.len && i<31){ab[i]=a[i];i=i+1;} ab[i]=0;
  i=0; while(i<v.len && i<31){vb[i]=v[i];i=i+1;} vb[i]=0;
  // Build raw string: "entity attr value"
  let s:[]u8=z_alloc(96);
  let at:i32=0;
  at=appz(s,at,eb);
  s[at]=32; at=at+1; // space
  at=appz(s,at,ab);
  s[at]=32; at=at+1;
  at=appz(s,at,vb);
  let n:i32=at;
  // Feed into lexicon (DEVINT1 mechanism)
  lex_feed(W,s,n);
  // Form concepts for each part (DEVINT1 mechanism)
  let eid:i32=conc_touch(W,eb,0,slen(eb),t);
  let aid:i32=conc_touch(W,ab,0,slen(ab),t);
  let vid:i32=conc_touch(W,vb,0,slen(vb),t);
  // Learn rule: (entity+attr) -> value (DEVINT1 mechanism)
  if(eid>0 && aid>0 && vid>0){
    let from:i32=eid*1000+aid;
    rule_touch(W,from,vid,t);
  }
  // Store fact for exact retrieval
  fact_store(W,eb,ab,vb);
  z_free(s); z_free(eb); z_free(ab); z_free(vb);
  return;
}

// --- relational learning: process a relation exposure ---
// Encodes (entity_a, rel, entity_b) and feeds through DEVINT1 mechanisms.
// Mirrors learn_fact, extended to triples.
fn learn_rel(W:[]u8, a:[]u8, r:[]u8, b:[]u8)void {
  let t:i32=tick(W);
  let ab:[]u8=z_alloc(32); let rb:[]u8=z_alloc(32); let bb:[]u8=z_alloc(32);
  let i:i32=0;
  while(i<a.len && i<31){ab[i]=a[i];i=i+1;} ab[i]=0;
  i=0; while(i<r.len && i<31){rb[i]=r[i];i=i+1;} rb[i]=0;
  i=0; while(i<b.len && i<31){bb[i]=b[i];i=i+1;} bb[i]=0;
  // Build raw string: "entity_a rel entity_b"
  let s:[]u8=z_alloc(96);
  let at:i32=0;
  at=appz(s,at,ab);
  s[at]=32; at=at+1;
  at=appz(s,at,rb);
  s[at]=32; at=at+1;
  at=appz(s,at,bb);
  let n:i32=at;
  // Feed into lexicon (DEVINT1 mechanism)
  lex_feed(W,s,n);
  // Form concepts for each part (DEVINT1 mechanism)
  let aid:i32=conc_touch(W,ab,0,slen(ab),t);
  let rid:i32=conc_touch(W,rb,0,slen(rb),t);
  let bid:i32=conc_touch(W,bb,0,slen(bb),t);
  // Learn rule: (entity_a+rel) -> entity_b (DEVINT1 mechanism)
  if(aid>0 && rid>0 && bid>0){
    let from:i32=aid*1000+rid;
    rule_touch(W,from,bid,t);
  }
  // Store relation for exact retrieval and composition
  rel_store(W,ab,rb,bb);
  z_free(s); z_free(ab); z_free(rb); z_free(bb);
  return;
}

// --- conflict learning: process a conflict exposure ---
// Encodes (entity, attr, value1, value2) and feeds through DEVINT1 mechanisms.
// Mirrors learn_fact, extended to retain both conflicting values.
fn learn_conflict(W:[]u8, e:[]u8, a:[]u8, v1:[]u8, v2:[]u8)void {
  let t:i32=tick(W);
  let eb:[]u8=z_alloc(32); let ab:[]u8=z_alloc(32);
  let b1:[]u8=z_alloc(32); let b2:[]u8=z_alloc(32);
  let i:i32=0;
  while(i<e.len && i<31){eb[i]=e[i];i=i+1;} eb[i]=0;
  i=0; while(i<a.len && i<31){ab[i]=a[i];i=i+1;} ab[i]=0;
  i=0; while(i<v1.len && i<31){b1[i]=v1[i];i=i+1;} b1[i]=0;
  i=0; while(i<v2.len && i<31){b2[i]=v2[i];i=i+1;} b2[i]=0;
  // Build raw string: "entity attr value1 value2"
  let s:[]u8=z_alloc(128);
  let at:i32=0;
  at=appz(s,at,eb);
  s[at]=32; at=at+1;
  at=appz(s,at,ab);
  s[at]=32; at=at+1;
  at=appz(s,at,b1);
  s[at]=32; at=at+1;
  at=appz(s,at,b2);
  let n:i32=at;
  // Feed into lexicon (DEVINT1 mechanism)
  lex_feed(W,s,n);
  // Form concepts for each part (DEVINT1 mechanism)
  let eid:i32=conc_touch(W,eb,0,slen(eb),t);
  let aid:i32=conc_touch(W,ab,0,slen(ab),t);
  let v1id:i32=conc_touch(W,b1,0,slen(b1),t);
  let v2id:i32=conc_touch(W,b2,0,slen(b2),t);
  // Learn rule: (entity+attr) -> value1 (first value; DEVINT1 mechanism)
  if(eid>0 && aid>0 && v1id>0){
    let from:i32=eid*1000+aid;
    rule_touch(W,from,v1id,t);
  }
  // Store conflict pair for exact retrieval (both values retained)
  conf_store(W,eb,ab,b1,b2);
  z_free(s); z_free(eb); z_free(ab); z_free(b1); z_free(b2);
  return;
}

// --- segment triple parsers ---
// parse_segs: parse "s":[n0,n1,n2] from a turn line into out[3] (i32s); 1 on success
fn parse_segs(line:[]u8, out:[]u8)i32 {
  let p:i32=findsub(line,0,"\"s\":[");
  if(p<0){return 0;}
  let s:i32=p+5;
  let k:i32=0;
  while(k<3){
    while(s<line.len && (line[s]<48 || line[s]>57)){s=s+1;}
    if(s>=line.len){return 0;}
    let v:i32=0;
    while(s<line.len && line[s]>=48 && line[s]<=57){v=v*10+(line[s] as i32)-48;s=s+1;}
    set32(out,k*4,v);
    k=k+1;
  }
  return 1;
}
// parse_qsegs: parse "n0,n1,n2" (a question part) into out[3] (i32s); 1 on success
fn parse_qsegs(q:[]u8, out:[]u8)i32 {
  let s:i32=0;
  let k:i32=0;
  while(k<3){
    while(s<q.len && (q[s]<48 || q[s]>57)){s=s+1;}
    if(s>=q.len){return 0;}
    let v:i32=0;
    while(s<q.len && q[s]>=48 && q[s]<=57){v=v*10+(q[s] as i32)-48;s=s+1;}
    set32(out,k*4,v);
    k=k+1;
  }
  return 1;
}

// --- Zem word learning: process a word exposure ---
// Expo: {"t":"z","w":name,"cls":"A"/"B","s":[s0,s1,s2]}
//    or {"t":"n","w":name,"gloss":...,"s":[s0,s1,s2]} (new vocabulary, A-class)
// Class codes: 1=A, 2=B, 3=new-word (treated as A-class template evidence).
// Feeds the word name through the DEVINT1 lexicon (lex_feed), then stores the
// structured morphology (word + class template induction) via zem_store.
fn learn_zem(W:[]u8, w:[]u8, cls:i32, s0:i32, s1:i32, s2:i32)void {
  tick(W);
  let wb:[]u8=z_alloc(32);
  let i:i32=0;
  while(i<w.len && i<31){wb[i]=w[i];i=i+1;} wb[i]=0;
  lex_feed(W,wb,slen(wb));
  zem_store(W,wb,cls,s0,s1,s2);
  z_free(wb);
  return;
}

// === TCNP: trial-constructed named procedures ===
// Per frozen PREREG_ARENA_PROCEDURE.md (arena procedure lane). From I/O
// pairs only (never demonstrated paths), the learner constructs a path by
// deterministic trial over a frozen 8-op generic ISA (bound K=4, canonical
// enumeration, zero RNG). Learner-owned state: named procedure table with
// creation traces, trial log, per-item verdict records. Consensus
// abstention: all minimal-length fitters must agree or the reply is
// UNKNOWN (learner-originated uncertainty). Named-procedure reuse via
// table rebinding with zero new trials. No modes, bridges, routers, or
// task-specific admission gates; zero hardcoded semantic cases.

// --- TCNP constants: learner-state layout in W ---
// [0..16384): v6 region (untouched). [16384..218704): TCNP region.
//   16384: magic "TCNP" (4B)
//   16388: nprocs(i32) 16392: ntasks(i32) 16396: maxfitters(i32, diagnostic)
//   16400: procedure table, 8 x 64B:
//     0: valid(i32) 4: name(16B) 20: nsteps(i32) 24: steps(4x3B: opid,a,b)
//     36: tried(i32) 40: windex(i32) 44: Lstar(i32) 48: nfitters(i32)
//   16912: task records, 8 x 25224B:
//     0: valid(i32) 4: name(16B) 20: nshown(i32)
//     24: shown pairs, 8 x 32B (in 4xi32, out 4xi32)
//     280: solved(i32: 0=no 1=yes 2=none-found) 284: procidx(i32)
//     288: trials(i32) 292: rebound(i32) 296: rebound_name(16B)
//     312: Lstar(i32) 316: nfitters(i32) 320: fovf(i32) 324: nverdicts(i32)
//     328: verdicts, 16 x 20B (agreed(i32), o0..o3)
//     648: fitters, 2048 x 12B (4 steps x 3B: opid,a,b)
fn TCNB()i32 { return 16384; }
fn TCN_NPROCS()i32 { return 16388; }
fn TCN_NTASKS()i32 { return 16392; }
fn TCN_MAXFIT()i32 { return 16396; }
fn TCN_PTAB()i32 { return 16400; }
fn TCN_PSZ()i32 { return 64; }
fn TCN_TASKS()i32 { return 16912; }
fn TCN_TSZ()i32 { return 25224; }
fn TCN_NFIT()i32 { return 2048; }
// Build configuration: 0 is full TCNP; 1 is the ablated build (K7a
// control: procedure construction disabled, every ptest replies UNKNOWN).
// The ablated binary is built from this same source with this constant
// flipped to 1 (one-line change, recorded in IMPLEMENTATION.md).
fn TCNP_ABLATED()i32 { return 1; }

fn tcn_init(W:[]u8)void {
  if(W[TCNB()]==84 && W[TCNB()+1]==67 && W[TCNB()+2]==78 && W[TCNB()+3]==80){return;}
  let i:i32=0;
  while(i<ST_SIZE()-TCNB()){W[TCNB()+i]=0;i=i+1;}
  W[TCNB()]=84; W[TCNB()+1]=67; W[TCNB()+2]=78; W[TCNB()+3]=80;
  return;
}

// deterministic white-box trace channel (stderr, fd 2; no timing fields)
fn tcn_emit(s:[]u8)void {
  _zag_raw_syscall(1,2,(_zag_slice_ptr(s) as i64),(s.len as i64),0,0,0);
  return;
}

fn tcn_copyname(W:[]u8, at:i32, name:[]u8)void {
  let n:i32=slen(name);
  if(n>15){n=15;}
  let i:i32=0;
  while(i<n){W[at+i]=name[i];i=i+1;}
  W[at+n]=0;
  return;
}

// parse "key":[n0,n1,n2,n3] into out (16B of i32s); 1 on success
fn parse_arr4(line:[]u8, key:[]u8, out:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":[");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return 0;}
  let s:i32=p+at;
  let k:i32=0;
  while(k<4){
    while(s<line.len && (line[s]<48 || line[s]>57)){s=s+1;}
    if(s>=line.len){return 0;}
    let v:i32=0;
    while(s<line.len && line[s]>=48 && line[s]<=57){v=v*10+(line[s] as i32)-48;s=s+1;}
    set32(out,k*4,v);
    k=k+1;
  }
  return 1;
}

// parse "n0,n1,n2,n3" into out (16B of i32s); 1 on success
fn parse_qvec4(q:[]u8, out:[]u8)i32 {
  let s:i32=0;
  let k:i32=0;
  while(k<4){
    while(s<q.len && (q[s]<48 || q[s]>57)){s=s+1;}
    if(s>=q.len){return 0;}
    let v:i32=0;
    while(s<q.len && q[s]>=48 && q[s]<=57){v=v*10+(q[s] as i32)-48;s=s+1;}
    set32(out,k*4,v);
    k=k+1;
  }
  return 1;
}

// --- frozen 8-op generic ISA over a 4-element vector register ---
// 1 COPY(d,s)  2 SWAP(a,b)  3 ROTL  4 ROTR  5 REVERSE
// 6 INC(i)  7 DEC(i)  8 SET0(i). Elements stay in 0..7.
fn tcn_step(vec:[]u8, opid:i32, a:i32, b:i32)void {
  if(opid==1){ set32(vec,a*4,get32(vec,b*4)); return; }
  if(opid==2){
    let t:i32=get32(vec,a*4);
    set32(vec,a*4,get32(vec,b*4));
    set32(vec,b*4,t);
    return;
  }
  if(opid==3){
    let t0:i32=get32(vec,0);
    set32(vec,0,get32(vec,4)); set32(vec,4,get32(vec,8));
    set32(vec,8,get32(vec,12)); set32(vec,12,t0);
    return;
  }
  if(opid==4){
    let t3:i32=get32(vec,12);
    set32(vec,12,get32(vec,8)); set32(vec,8,get32(vec,4));
    set32(vec,4,get32(vec,0)); set32(vec,0,t3);
    return;
  }
  if(opid==5){
    let x0:i32=get32(vec,0); let x1:i32=get32(vec,4);
    set32(vec,0,get32(vec,12)); set32(vec,4,get32(vec,8));
    set32(vec,8,x1); set32(vec,12,x0);
    return;
  }
  if(opid==6){ let v:i32=get32(vec,a*4); set32(vec,a*4,(v+1)%8); return; }
  if(opid==7){ let v:i32=get32(vec,a*4); set32(vec,a*4,(v+7)%8); return; }
  if(opid==8){ set32(vec,a*4,0); return; }
  return;
}

fn tcn_pow33(L:i32)i32 {
  if(L==0){return 1;}
  if(L==1){return 33;}
  if(L==2){return 1089;}
  if(L==3){return 35937;}
  return 1185921;
}

// Decode candidate counter c (0..33^L-1) into L steps (3B each: opid,a,b)
// in canonical lexicographic order: most significant base-33 digit first.
// Variant order is lexicographic over (opid, operands):
//   0..11: COPY (d,s), d!=s | 12..17: SWAP (a,b), a<b
//   18: ROTL 19: ROTR 20: REVERSE
//   21..24: INC(i) 25..28: DEC(i) 29..32: SET0(i)
fn tcn_decode_cand(c:i32, L:i32, steps:[]u8)void {
  let j:i32=0;
  while(j<L){
    let d:i32=(c/tcn_pow33(L-1-j))%33;
    if(d<12){
      let dd:i32=d/3; let r:i32=d%3;
      steps[j*3]=1; steps[j*3+1]=dd as u8;
      if(r>=dd){steps[j*3+2]=(r+1) as u8;} else {steps[j*3+2]=r as u8;}
    } else {
      if(d<18){
        let w:i32=d-12;
        steps[j*3]=2;
        if(w<3){steps[j*3+1]=0; steps[j*3+2]=(w+1) as u8;}
        else { if(w<5){steps[j*3+1]=1; steps[j*3+2]=(w-1) as u8;} else {steps[j*3+1]=2; steps[j*3+2]=3;} }
      } else {
        if(d==18){steps[j*3]=3; steps[j*3+1]=0; steps[j*3+2]=0;}
        else { if(d==19){steps[j*3]=4; steps[j*3+1]=0; steps[j*3+2]=0;}
        else { if(d==20){steps[j*3]=5; steps[j*3+1]=0; steps[j*3+2]=0;}
        else { if(d<25){steps[j*3]=6; steps[j*3+1]=(d-21) as u8; steps[j*3+2]=0;}
        else { if(d<29){steps[j*3]=7; steps[j*3+1]=(d-25) as u8; steps[j*3+2]=0;}
        else {steps[j*3]=8; steps[j*3+1]=(d-29) as u8; steps[j*3+2]=0;} } } } }
      }
    }
    j=j+1;
  }
  return;
}

// 1 iff steps[0..L) maps every shown input of task tb to its shown output.
fn tcn_steps_fit(W:[]u8, vec:[]u8, steps:[]u8, L:i32, tb:i32)i32 {
  let ns:i32=get32(W,tb+20);
  let s:i32=0;
  while(s<ns){
    let sb:i32=tb+24+s*32;
    set32(vec,0,get32(W,sb)); set32(vec,4,get32(W,sb+4));
    set32(vec,8,get32(W,sb+8)); set32(vec,12,get32(W,sb+12));
    let j:i32=0;
    while(j<L){
      tcn_step(vec,steps[j*3] as i32,steps[j*3+1] as i32,steps[j*3+2] as i32);
      j=j+1;
    }
    if(get32(vec,0)!=get32(W,sb+16) || get32(vec,4)!=get32(W,sb+20) || get32(vec,8)!=get32(W,sb+24) || get32(vec,12)!=get32(W,sb+28)){
      return 0;
    }
    s=s+1;
  }
  return 1;
}

// find task by name; create if absent; -1 if the 8-task table is full
fn tcn_task(W:[]u8, name:[]u8)i32 {
  let nt:i32=get32(W,TCN_NTASKS());
  let i:i32=0;
  while(i<nt){
    let tb:i32=TCN_TASKS()+i*TCN_TSZ();
    if(get32(W,tb)==1 && streq(W[tb+4..tb+20],name[0..slen(name)])==1){return i;}
    i=i+1;
  }
  if(nt>=8){return -1;}
  let tb:i32=TCN_TASKS()+nt*TCN_TSZ();
  let k:i32=0;
  while(k<TCN_TSZ()){W[tb+k]=0;k=k+1;}
  set32(W,tb,1);
  tcn_copyname(W,tb+4,name);
  set32(W,tb+284,-1);
  set32(W,TCN_NTASKS(),nt+1);
  return nt;
}

fn tcn_log_pshow(name:[]u8, n:i32)void {
  let b:[]u8=z_alloc(64);
  let at:i32=app(b,0,"TCNP pshow task=");
  at=appz(b,at,name);
  at=app(b,at," nshown=");
  at=app(b,at,i64s(n as i64));
  at=app(b,at,"\n");
  tcn_emit(b[0..at]);
  z_free(b);
  return;
}

fn tcn_log_rebind(W:[]u8, tb:i32, pb:i32)void {
  let b:[]u8=z_alloc(96);
  let at:i32=app(b,0,"TCNP solve task=");
  at=appz(b,at,W[tb+4..tb+20]);
  at=app(b,at," mode=rebind proc=");
  at=appz(b,at,W[pb+4..pb+20]);
  at=app(b,at," trials=0\n");
  tcn_emit(b[0..at]);
  z_free(b);
  return;
}

fn tcn_log_construct(W:[]u8, tb:i32, tried:i32, windex:i32, L:i32, nf:i32, pidx:i32)void {
  let b:[]u8=z_alloc(160);
  let at:i32=app(b,0,"TCNP solve task=");
  at=appz(b,at,W[tb+4..tb+20]);
  at=app(b,at," mode=construct L=");
  at=app(b,at,i64s(L as i64));
  at=app(b,at," tried=");
  at=app(b,at,i64s(tried as i64));
  at=app(b,at," windex=");
  at=app(b,at,i64s(windex as i64));
  at=app(b,at," nfitters=");
  at=app(b,at,i64s(nf as i64));
  at=app(b,at," pidx=");
  at=app(b,at,i64s(pidx as i64));
  at=app(b,at,"\n");
  tcn_emit(b[0..at]);
  z_free(b);
  return;
}

fn tcn_log_none(W:[]u8, tb:i32, tried:i32)void {
  let b:[]u8=z_alloc(96);
  let at:i32=app(b,0,"TCNP solve task=");
  at=appz(b,at,W[tb+4..tb+20]);
  at=app(b,at," mode=none tried=");
  at=app(b,at,i64s(tried as i64));
  at=app(b,at,"\n");
  tcn_emit(b[0..at]);
  z_free(b);
  return;
}

fn tcn_log_ptest(W:[]u8, tb:i32, i0:i32, i1:i32, i2:i32, i3:i32, agree:i32, nf:i32, r:[]u8)void {
  let b:[]u8=z_alloc(192);
  let at:i32=app(b,0,"TCNP ptest task=");
  at=appz(b,at,W[tb+4..tb+20]);
  at=app(b,at," in=");
  at=app(b,at,i64s(i0 as i64)); at=app(b,at,",");
  at=app(b,at,i64s(i1 as i64)); at=app(b,at,",");
  at=app(b,at,i64s(i2 as i64)); at=app(b,at,",");
  at=app(b,at,i64s(i3 as i64));
  at=app(b,at," agree=");
  at=app(b,at,i64s(agree as i64));
  at=app(b,at,"/");
  at=app(b,at,i64s(nf as i64));
  at=app(b,at," reply=");
  at=appz(b,at,r);
  at=app(b,at,"\n");
  tcn_emit(b[0..at]);
  z_free(b);
  return;
}

// record one hidden-item verdict in the task's verdict ring
fn tcn_record_verdict(W:[]u8, tb:i32, agreed:i32, o0:i32, o1:i32, o2:i32, o3:i32)void {
  let nv:i32=get32(W,tb+324);
  let vb:i32=tb+328+(nv%16)*20;
  set32(W,vb,agreed);
  set32(W,vb+4,o0); set32(W,vb+8,o1); set32(W,vb+12,o2); set32(W,vb+16,o3);
  set32(W,tb+324,nv+1);
  return;
}

// Expo: buffer one shown pair for a task. New evidence invalidates any
// prior solution for the task (re-derived at the next ptest).
fn learn_pshow(W:[]u8, name:[]u8, i0:i32, i1:i32, i2:i32, i3:i32, o0:i32, o1:i32, o2:i32, o3:i32)void {
  tcn_init(W);
  let ti:i32=tcn_task(W,name);
  if(ti<0){
    tcn_emit("TCNP pshow task-table-full\n");
    return;
  }
  let tb:i32=TCN_TASKS()+ti*TCN_TSZ();
  let ns:i32=get32(W,tb+20);
  if(ns<8){
    let sb:i32=tb+24+ns*32;
    set32(W,sb,i0); set32(W,sb+4,i1); set32(W,sb+8,i2); set32(W,sb+12,i3);
    set32(W,sb+16,o0); set32(W,sb+20,o1); set32(W,sb+24,o2); set32(W,sb+28,o3);
    set32(W,tb+20,ns+1);
    ns=ns+1;
  }
  set32(W,tb+280,0);
  set32(W,tb+284,-1);
  tcn_log_pshow(W[tb+4..tb+20],ns);
  return;
}

// Solve task ti: rebind a fitting tabled procedure (zero trials), else
// deterministic trial construction over the frozen 8-op ISA (bound K=4).
fn tcn_solve(W:[]u8, ti:i32)void {
  let tb:i32=TCN_TASKS()+ti*TCN_TSZ();
  let vec:[]u8=z_alloc(16);
  // 1. rebind attempt: first tabled procedure fitting ALL shown pairs
  let np:i32=get32(W,TCN_NPROCS());
  let pi:i32=0;
  while(pi<np){
    let pb:i32=TCN_PTAB()+pi*TCN_PSZ();
    if(get32(W,pb)==1){
      let ns2:i32=get32(W,pb+20);
      let st12:[]u8=z_alloc(12);
      let j:i32=0;
      while(j<ns2){
        st12[j*3]=W[pb+24+j*3]; st12[j*3+1]=W[pb+24+j*3+1]; st12[j*3+2]=W[pb+24+j*3+2];
        j=j+1;
      }
      let fits:i32=tcn_steps_fit(W,vec,st12,ns2,tb);
      z_free(st12);
      if(fits==1){
        set32(W,tb+280,1);
        set32(W,tb+284,pi);
        set32(W,tb+288,0);
        set32(W,tb+292,1);
        tcn_copyname(W,tb+296,W[pb+4..pb+20]);
        set32(W,tb+312,ns2);
        set32(W,tb+316,1);
        set32(W,tb+320,0);
        let fb:i32=tb+648;
        j=0;
        while(j<ns2){
          W[fb+j*3]=W[pb+24+j*3]; W[fb+j*3+1]=W[pb+24+j*3+1]; W[fb+j*3+2]=W[pb+24+j*3+2];
          j=j+1;
        }
        tcn_log_rebind(W,tb,pb);
        z_free(vec);
        return;
      }
    }
    pi=pi+1;
  }
  // 2. trial construction: lengths 1..4 in canonical order; full
  // enumeration at the minimal fitting length (all fitters collected,
  // not first-only); the canonical-first fitter becomes the named
  // procedure with its creation trace.
  let steps:[]u8=z_alloc(12);
  let tried:i32=0;
  let L:i32=1;
  let done:i32=0;
  while(L<=4 && done==0){
    let total:i32=tcn_pow33(L);
    let c:i32=0;
    let nf:i32=0;
    let windex:i32=0;
    while(c<total){
      tcn_decode_cand(c,L,steps);
      tried=tried+1;
      if(tcn_steps_fit(W,vec,steps,L,tb)==1){
        if(nf==0){windex=c;}
        if(nf<TCN_NFIT()){
          let fb:i32=tb+648+nf*12;
          let j:i32=0;
          while(j<L){
            W[fb+j*3]=steps[j*3]; W[fb+j*3+1]=steps[j*3+1]; W[fb+j*3+2]=steps[j*3+2];
            j=j+1;
          }
        } else {
          set32(W,tb+320,1);
        }
        nf=nf+1;
        let mf:i32=get32(W,TCN_MAXFIT());
        if(nf>mf){set32(W,TCN_MAXFIT(),nf);}
      }
      c=c+1;
    }
    if(nf>0){
      done=1;
      set32(W,tb+280,1);
      set32(W,tb+292,0);
      set32(W,tb+288,tried);
      set32(W,tb+312,L);
      let nfs:i32=nf;
      if(nfs>TCN_NFIT()){nfs=TCN_NFIT();}
      set32(W,tb+316,nfs);
      let np2:i32=get32(W,TCN_NPROCS());
      let pidx:i32=-1;
      if(np2<8){
        let pb:i32=TCN_PTAB()+np2*TCN_PSZ();
        set32(W,pb,1);
        tcn_copyname(W,pb+4,W[tb+4..tb+20]);
        set32(W,pb+20,L);
        let fb0:i32=tb+648;
        let j:i32=0;
        while(j<L){
          W[pb+24+j*3]=W[fb0+j*3]; W[pb+24+j*3+1]=W[fb0+j*3+1]; W[pb+24+j*3+2]=W[fb0+j*3+2];
          j=j+1;
        }
        set32(W,pb+36,tried);
        set32(W,pb+40,windex);
        set32(W,pb+44,L);
        set32(W,pb+48,nfs);
        set32(W,TCN_NPROCS(),np2+1);
        pidx=np2;
      }
      set32(W,tb+284,pidx);
      tcn_log_construct(W,tb,tried,windex,L,nf,pidx);
    }
    L=L+1;
  }
  z_free(steps);
  z_free(vec);
  if(done==0){
    set32(W,tb+280,2);
    set32(W,tb+288,tried);
    set32(W,tb+292,0);
    set32(W,tb+312,0);
    set32(W,tb+316,0);
    tcn_log_none(W,tb,tried);
  }
  return;
}

// Test: answer one hidden item. Simulate every minimal fitter; reply the
// output iff all agree, else UNKNOWN (learner-originated uncertainty).
fn answer_ptest(W:[]u8, name:[]u8, i0:i32, i1:i32, i2:i32, i3:i32, ans:[]u8)void {
  tcn_init(W);
  let ti:i32=tcn_task(W,name);
  let unk:[]u8="UNKNOWN";
  if(ti<0){ copy16(ans,unk); return; }
  let tb:i32=TCN_TASKS()+ti*TCN_TSZ();
  if(get32(W,tb+20)==0){
    copy16(ans,unk);
    tcn_log_ptest(W,tb,i0,i1,i2,i3,0,0,unk);
    tcn_record_verdict(W,tb,0,0,0,0,0);
    return;
  }
  if(get32(W,tb+280)==0){ tcn_solve(W,ti); }
  if(get32(W,tb+280)!=1){
    copy16(ans,unk);
    tcn_log_ptest(W,tb,i0,i1,i2,i3,0,0,unk);
    tcn_record_verdict(W,tb,0,0,0,0,0);
    return;
  }
  let nf:i32=get32(W,tb+316);
  let L0:i32=get32(W,tb+312);
  if(nf<1 || L0<1){
    copy16(ans,unk);
    tcn_log_ptest(W,tb,i0,i1,i2,i3,0,0,unk);
    tcn_record_verdict(W,tb,0,0,0,0,0);
    return;
  }
  let vec:[]u8=z_alloc(16);
  let o0:i32=0; let o1:i32=0; let o2:i32=0; let o3:i32=0;
  let agree:i32=1;
  let f:i32=0;
  while(f<nf){
    let fb:i32=tb+648+f*12;
    set32(vec,0,i0); set32(vec,4,i1); set32(vec,8,i2); set32(vec,12,i3);
    let j:i32=0;
    while(j<L0){
      tcn_step(vec,W[fb+j*3] as i32,W[fb+j*3+1] as i32,W[fb+j*3+2] as i32);
      j=j+1;
    }
    if(f==0){
      o0=get32(vec,0); o1=get32(vec,4); o2=get32(vec,8); o3=get32(vec,12);
    } else {
      if(get32(vec,0)!=o0 || get32(vec,4)!=o1 || get32(vec,8)!=o2 || get32(vec,12)!=o3){agree=0;}
    }
    f=f+1;
  }
  z_free(vec);
  if(agree==1){
    let tmp:[]u8=z_alloc(32);
    let at:i32=0;
    at=app(tmp,at,i64s(o0 as i64)); at=app(tmp,at,",");
    at=app(tmp,at,i64s(o1 as i64)); at=app(tmp,at,",");
    at=app(tmp,at,i64s(o2 as i64)); at=app(tmp,at,",");
    at=app(tmp,at,i64s(o3 as i64));
    tmp[at]=0;
    copy16(ans,tmp);
    tcn_record_verdict(W,tb,1,o0,o1,o2,o3);
    tcn_log_ptest(W,tb,i0,i1,i2,i3,1,nf,tmp);
    z_free(tmp);
  } else {
    copy16(ans,unk);
    tcn_record_verdict(W,tb,0,0,0,0,0);
    tcn_log_ptest(W,tb,i0,i1,i2,i3,0,nf,unk);
  }
  return;
}

// --- main ---
fn main()i32 {
  let t0:i64=now_ms();
  let turnpath:[]u8=_zag_arg(1);
  let statedir:[]u8=_zag_arg(2);
  let worlddir:[]u8=_zag_arg(3);
  if(turnpath.len==0 || statedir.len==0 || worlddir.len==0){
    emit("usage: devint1_contestant <turn.json> <statedir> <worlddir>\n");
    return 1;
  }
  let line:[]u8=read_file(turnpath);
  let W:[]u8=z_alloc(ST_SIZE());
  st_load(W,pjoin(statedir,"state.bin"));
  tcn_init(W);
  let kind:[]u8=jval(line,"kind");
  let turn:i32=jint(line,"turn");
  let out:[]u8=z_alloc(4096);
  let at:i32=0;
  if(streq(kind,"brief")==1){
    // Brief: initialize. No specific action needed; W starts empty.
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"kind\":\"brief\",\"ok\":true}");
  }
  if(streq(kind,"expo")==1){
    // Parse exposure event
    // Format: {"ev":{"t":"f","e":"...","a":"...","v":"..."}}
    // or {"ev":{"t":"i","n":...}} for interference
    let evtype:[]u8=jval(line,"t");
    if(streq(evtype,"f")==1){
      let e:[]u8=jval(line,"e");
      let a:[]u8=jval(line,"a");
      let v:[]u8=jval(line,"v");
      learn_fact(W,e,a,v);
    }
    // Correction: {"t":"k","e":...,"a":...,"old":...,"new":...}
    // Learn the new value via DEVINT1 mechanisms; fact_store updates.
    if(streq(evtype,"k")==1){
      let e:[]u8=jval(line,"e");
      let a:[]u8=jval(line,"a");
      let nv:[]u8=jval(line,"new");
      learn_fact(W,e,a,nv);
    }
    // Relation: {"t":"r","a":...,"r":...,"b":...}
    // Learn the triple via DEVINT1 mechanisms; rel_store for composition.
    if(streq(evtype,"r")==1){
      let ra:[]u8=jval(line,"a");
      let rr:[]u8=jval(line,"r");
      let rb2:[]u8=jval(line,"b");
      learn_rel(W,ra,rr,rb2);
    }
    // Conflict: {"t":"x","e":...,"a":...,"v1":...,"s1":...,"v2":...,"s2":...}
    // Learn both conflicting values via DEVINT1 mechanisms; conf_store retains the pair.
    if(streq(evtype,"x")==1){
      let ce:[]u8=jval(line,"e");
      let ca:[]u8=jval(line,"a");
      let cv1:[]u8=jval(line,"v1");
      let cv2:[]u8=jval(line,"v2");
      learn_conflict(W,ce,ca,cv1,cv2);
    }
    // Zem word: {"t":"z","w":...,"cls":"A"/"B","s":[s0,s1,s2]}
    // Learn the word and induce the class morphology via learn_zem.
    // Generic: class codes and segments come from the event, never from source.
    if(streq(evtype,"z")==1){
      let zw:[]u8=jval(line,"w");
      let zc:[]u8=jval(line,"cls");
      let sg:[]u8=z_alloc(12);
      let zcls:i32=3;
      if(streq(zc,"A")==1){zcls=1;}
      if(streq(zc,"B")==1){zcls=2;}
      if(parse_segs(line,sg)==1){
        learn_zem(W,zw,zcls,get32(sg,0),get32(sg,4),get32(sg,8));
      } else {
        tick(W);
      }
      z_free(sg);
    }
    // New-word teaching: {"t":"n","w":...,"gloss":...,"s":[s0,s1,s2]}
    // Treated as A-class template evidence (new vocabulary, taught word form).
    if(streq(evtype,"n")==1){
      let nw:[]u8=jval(line,"w");
      let sg:[]u8=z_alloc(12);
      if(parse_segs(line,sg)==1){
        learn_zem(W,nw,3,get32(sg,0),get32(sg,4),get32(sg,8));
      } else {
        tick(W);
      }
      z_free(sg);
    }
    // TCNP procedure-show: {"t":"pshow","task":name,"in":[i0..i3],"out":[o0..o3]}
    // Buffers one shown pair for the named task. Generic: arbitrary task
    // names and vectors; no rule-specific branches. Never a demonstrated
    // path: only input/output pairs are recorded.
    if(streq(evtype,"pshow")==1){
      let ptn:[]u8=jval(line,"task");
      let pnb:[]u8=z_alloc(32);
      let qi:i32=0;
      while(qi<ptn.len && qi<31){pnb[qi]=ptn[qi];qi=qi+1;}
      pnb[qi]=0;
      let pi4:[]u8=z_alloc(16);
      let po4:[]u8=z_alloc(16);
      if(parse_arr4(line,"in",pi4)==1 && parse_arr4(line,"out",po4)==1){
        learn_pshow(W,pnb,get32(pi4,0),get32(pi4,4),get32(pi4,8),get32(pi4,12),get32(po4,0),get32(po4,4),get32(po4,8),get32(po4,12));
      } else {
        tick(W);
      }
      z_free(pnb); z_free(pi4); z_free(po4);
    }
    // For interference or other types, just tick
    if(streq(evtype,"f")!=1 && streq(evtype,"k")!=1 && streq(evtype,"r")!=1 && streq(evtype,"x")!=1 && streq(evtype,"z")!=1 && streq(evtype,"n")!=1 && streq(evtype,"pshow")!=1){
      tick(W);
    }
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"kind\":\"expo\",\"ok\":true}");
  }
  if(streq(kind,"observe_result")==1){
    // Observation result: treat as exposure
    tick(W);
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"kind\":\"observe_result\",\"ok\":true}");
  }
  if(streq(kind,"done")==1){
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"done\":true}");
  }
  if(streq(kind,"test")==1){
    let item:i32=jint(line,"item");
    let cap:i32=jint(line,"cap");
    let q:[]u8=jval(line,"q");
    let head:[]u8=z_alloc(64); let p1:[]u8=z_alloc(64); let p2:[]u8=z_alloc(64); let p3:[]u8=z_alloc(64);
    qpart(q,0,head); qpart(q,1,p1); qpart(q,2,p2); qpart(q,3,p3);
    let ans:[]u8=z_alloc(256);
    copy16(ans,"UNKNOWN");
    // fact|entity|attr -> lookup (also fact2| for paraphrase)
    if(streq(head,"fact")==1 || streq(head,"fact2")==1){
      let tmp:[]u8=z_alloc(16);
      if(fact_get(W,p1,p2,tmp)==1){
        copy16(ans,tmp);
      }
      z_free(tmp);
    }
    // hop2|start|rel1|rel2 -> two-hop composition over learned relations.
    // Generic: find mid via (start,rel1), then answer via (mid,rel2).
    // No hardcoded entities, relations, or answers.
    if(streq(head,"hop2")==1){
      let mid:[]u8=z_alloc(16);
      let fin:[]u8=z_alloc(16);
      if(rel_get(W,p1,p2,mid)==1){
        if(rel_get(W,mid,p3,fin)==1){
          copy16(ans,fin);
        }
      }
      z_free(mid); z_free(fin);
    }
    // conflict|entity|attr -> report both conflicting values as v1|v2.
    // Generic: retrieve the stored pair, format pipe-separated.
    // No hardcoded entities, attrs, or values.
    if(streq(head,"conflict")==1){
      let cv1:[]u8=z_alloc(16);
      let cv2:[]u8=z_alloc(16);
      if(conf_get(W,p1,p2,cv1,cv2)==1){
        let ax:i32=0;
        ax=appz(ans,ax,cv1);
        ax=app(ans,ax,"|");
        ax=appz(ans,ax,cv2);
      }
      z_free(cv1); z_free(cv2);
    }
    // zemprod|s0,s1,s2 -> produce the transformed word form.
    // Position-wise rewrite induction: for each position p, the input segment
    // must equal the learned class-A template at p, and the output is the
    // learned class-B template at p. Any unmapped position -> UNKNOWN.
    // Generic: templates come from exposure, never from source.
    if(streq(head,"zemprod")==1){
      let sg:[]u8=z_alloc(12);
      if(parse_qsegs(p1,sg)==1 && get32(W,13912)==1 && get32(W,13916)==1){
        let ok:i32=1;
        let o0:i32=0; let o1:i32=0; let o2:i32=0;
        if(get32(sg,0)==get32(W,13888)){o0=get32(W,13900);} else {ok=0;}
        if(get32(sg,4)==get32(W,13892)){o1=get32(W,13904);} else {ok=0;}
        if(get32(sg,8)==get32(W,13896)){o2=get32(W,13908);} else {ok=0;}
        if(ok==1){
          let ax:i32=0;
          ax=app(ans,ax,i64s(o0)); ax=app(ans,ax,",");
          ax=app(ans,ax,i64s(o1)); ax=app(ans,ax,",");
          ax=app(ans,ax,i64s(o2));
          ans[ax]=0;
        }
      }
      z_free(sg);
    }
    // zemclass|s0,s1,s2 -> "yes" iff the triple matches the learned word
    // template (class A), else "no". "UNKNOWN" if no template was learned.
    // Generic: the template comes from exposure, never from source.
    if(streq(head,"zemclass")==1){
      let sg:[]u8=z_alloc(12);
      if(parse_qsegs(p1,sg)==1 && get32(W,13912)==1){
        if(get32(sg,0)==get32(W,13888) && get32(sg,4)==get32(W,13892) && get32(sg,8)==get32(W,13896)){
          copy16(ans,"yes");
        } else {
          copy16(ans,"no");
        }
      }
      z_free(sg);
    }
    // For other question types, try rule-based prediction via concepts
    // (honest: many will remain UNKNOWN)
    // TCNP ptest|task|v0,v1,v2,v3: trial-constructed named procedure query.
    // Generic: the answering procedure is learner-constructed from shown
    // pairs only (rebind or deterministic trial over the frozen 8-op ISA);
    // the handler carries arbitrary task names and vectors. Consensus
    // abstention: disagreeing fitters yield UNKNOWN, never a guess.
    if(streq(head,"ptest")==1){
      if(TCNP_ABLATED()==1){
        copy16(ans,"UNKNOWN");
        tcn_emit("TCNP ptest ablated reply=UNKNOWN\n");
      } else {
        let ptn:[]u8=z_alloc(32);
        let qi:i32=0;
        while(qi<p1.len && qi<31){ptn[qi]=p1[qi];qi=qi+1;}
        ptn[qi]=0;
        let pv:[]u8=z_alloc(16);
        if(parse_qvec4(p2,pv)==1){
          answer_ptest(W,ptn,get32(pv,0),get32(pv,4),get32(pv,8),get32(pv,12),ans);
        } else {
          copy16(ans,"UNKNOWN");
        }
        z_free(ptn); z_free(pv);
      }
    }
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"item\":"); at=app(out,at,i64s(item as i64));
    at=app(out,at,",\"cap\":"); at=app(out,at,i64s(cap as i64));
    at=app(out,at,",\"reply\":\""); at=appz(out,at,ans); at=app(out,at,"\"}");
    z_free(head); z_free(p1); z_free(p2); z_free(p3); z_free(ans);
  }
  let state_bytes:i32=st_save(W,pjoin(statedir,"state.bin"));
  let ms:i64=now_ms()-t0;
  let rss:i64=peak_rss();
  let olen:i32=slen(out);
  at=olen-1;
  at=app(out,at,",\"ms\":"); at=app(out,at,i64s(ms));
  at=app(out,at,",\"rss_kb\":"); at=app(out,at,i64s(rss));
  at=app(out,at,",\"state_bytes\":"); at=app(out,at,i64s(state_bytes as i64));
  // learning metrics for curves
  at=app(out,at,",\"lex_n\":"); at=app(out,at,i64s(lex_count(W) as i64));
  at=app(out,at,",\"conc_n\":"); at=app(out,at,i64s(conc_count(W) as i64));
  at=app(out,at,",\"rule_n\":"); at=app(out,at,i64s(rule_count(W) as i64));
  at=app(out,at,",\"fact_n\":"); at=app(out,at,i64s(fact_count(W) as i64));
  at=app(out,at,",\"rel_n\":"); at=app(out,at,i64s(rel_count(W) as i64));
  at=app(out,at,",\"conf_n\":"); at=app(out,at,i64s(conf_count(W) as i64));
  at=app(out,at,",\"zem_n\":"); at=app(out,at,i64s(zem_count(W) as i64));
  at=app(out,at,"}\n");
  emit(out[0..at]);
  z_free(W); z_free(line); z_free(out);
  return 0;
}

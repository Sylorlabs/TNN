// tcn_p_memctrl.zag - K7b memorization control (ARENA lane, dev runs).
// Nearest-shown-pair lookup: replies with the output of the shown pair
// whose input has minimal Hamming distance to the hidden input (ties go
// to the lowest shown index). Deterministic. Dev-only control harness;
// same turn protocol as the contestant for expo/pshow and test/ptest.
// Pure Zag. Usage: tcn_p_memctrl <turn.json> <statedir> <worlddir>
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn streq(a:[]u8,b:[]u8)i32 {
  let al:i32=slen(a); let bl:i32=slen(b);
  if(al!=bl){return 0;}
  let i:i32=0;
  while(i<al){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn appz(buf:[]u8,at:i32,s:[]u8)i32 {
  let n:i32=slen(s);
  let i:i32=0;
  while(i<n){buf[at+i]=s[i];i=i+1;}
  return at+n;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_alloc(path.len+1);
  let k:i32=0;
  while(k<path.len){cp[k]=path[k];k=k+1;}
  cp[path.len]=0;
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_alloc(path.len+1);
  let k:i32=0;
  while(k<path.len){c[k]=path[k];k=k+1;}
  c[path.len]=0;
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn jval(line:[]u8,key:[]u8)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":\"");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at;
  let e:i32=s;
  while(e<line.len && line[e]!=34){e=e+1;}
  return line[s..e];
}
fn jint(line:[]u8,key:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+3);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return -999999;}
  let s:i32=p+at;
  let neg:i32=0;
  if(s<line.len && line[s]==45){neg=1;s=s+1;}
  let v:i32=0;
  while(s<line.len && line[s]>=48 && line[s]<=57){v=v*10+(line[s] as i32)-48;s=s+1;}
  if(neg==1){v=-v;}
  return v;
}
fn qpart(q:[]u8, idx:i32, out:[]u8)void {
  let start:i32=0;
  let cur:i32=0;
  let i:i32=0;
  while(i<q.len){
    if(q[i]==124){
      if(cur==idx){
        let k:i32=0;
        while(start+k<i && k<63){out[k]=q[start+k];k=k+1;}
        out[k]=0;
        return;
      }
      cur=cur+1;
      start=i+1;
    }
    i=i+1;
  }
  if(cur==idx){
    let k:i32=0;
    while(start+k<q.len && k<63){out[k]=q[start+k];k=k+1;}
    out[k]=0;
    return;
  }
  out[0]=0;
  return;
}
fn parse_arr4(line:[]u8, key:[]u8, out:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":[");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return 0;}
  let s:i32=p+at;
  let k:i32=0;
  while(k<4){
    while(s<line.len && (line[s]<48 || line[s]>57)){s=s+1;}
    if(s>=line.len){return 0;}
    let v:i32=0;
    while(s<line.len && line[s]>=48 && line[s]<=57){v=v*10+(line[s] as i32)-48;s=s+1;}
    set32(out,k*4,v);
    k=k+1;
  }
  return 1;
}
fn parse_qvec4(q:[]u8, out:[]u8)i32 {
  let s:i32=0;
  let k:i32=0;
  while(k<4){
    while(s<q.len && (q[s]<48 || q[s]>57)){s=s+1;}
    if(s>=q.len){return 0;}
    let v:i32=0;
    while(s<q.len && q[s]>=48 && q[s]<=57){v=v*10+(q[s] as i32)-48;s=s+1;}
    set32(out,k*4,v);
    k=k+1;
  }
  return 1;
}
// state: 8 x (valid i32, name 16B, nshown i32, pairs 8x32B) = 8x280
fn MC_TASKS()i32 { return 4; }
fn MC_TSZ()i32 { return 280; }
fn mc_task(W:[]u8, name:[]u8)i32 {
  let nt:i32=get32(W,0);
  let i:i32=0;
  while(i<nt){
    let tb:i32=MC_TASKS()+i*MC_TSZ();
    if(get32(W,tb)==1 && streq(W[tb+4..tb+20],name[0..slen(name)])==1){return i;}
    i=i+1;
  }
  if(nt>=8){return -1;}
  let tb:i32=MC_TASKS()+nt*MC_TSZ();
  let k:i32=0;
  while(k<MC_TSZ()){W[tb+k]=0;k=k+1;}
  set32(W,tb,1);
  let n:i32=slen(name);
  if(n>15){n=15;}
  k=0;
  while(k<n){W[tb+4+k]=name[k];k=k+1;}
  W[tb+4+n]=0;
  set32(W,0,nt+1);
  return nt;
}
fn main()i32 {
  let turnpath:[]u8=_zag_arg(1);
  let statedir:[]u8=_zag_arg(2);
  if(turnpath.len==0 || statedir.len==0){
    _zag_print("usage: tcn_p_memctrl <turn.json> <statedir> <worlddir>\n");
    return 1;
  }
  let line:[]u8=read_file(turnpath);
  let W:[]u8=z_alloc(2244);
  let sd:[]u8=read_file(pjoin(statedir,"mcstate.bin"));
  if(sd.len>=2244){
    let i:i32=0;
    while(i<2244){W[i]=sd[i];i=i+1;}
  }
  z_free(sd);
  let kind:[]u8=jval(line,"kind");
  let turn:i32=jint(line,"turn");
  let out:[]u8=z_alloc(512);
  let at:i32=0;
  if(streq(kind,"brief")==1){
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"kind\":\"brief\",\"ok\":true}\n");
  }
  if(streq(kind,"expo")==1){
    let evtype:[]u8=jval(line,"t");
    if(streq(evtype,"pshow")==1){
      let ptn:[]u8=jval(line,"task");
      let pnb:[]u8=z_alloc(32);
      let qi:i32=0;
      while(qi<ptn.len && qi<31){pnb[qi]=ptn[qi];qi=qi+1;}
      pnb[qi]=0;
      let pi4:[]u8=z_alloc(16);
      let po4:[]u8=z_alloc(16);
      if(parse_arr4(line,"in",pi4)==1 && parse_arr4(line,"out",po4)==1){
        let ti:i32=mc_task(W,pnb);
        if(ti>=0){
          let tb:i32=MC_TASKS()+ti*MC_TSZ();
          let ns:i32=get32(W,tb+20);
          if(ns<8){
            let sb:i32=tb+24+ns*32;
            set32(W,sb,get32(pi4,0)); set32(W,sb+4,get32(pi4,4));
            set32(W,sb+8,get32(pi4,8)); set32(W,sb+12,get32(pi4,12));
            set32(W,sb+16,get32(po4,0)); set32(W,sb+20,get32(po4,4));
            set32(W,sb+24,get32(po4,8)); set32(W,sb+28,get32(po4,12));
            set32(W,tb+20,ns+1);
          }
        }
      }
      z_free(pnb); z_free(pi4); z_free(po4);
    }
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"kind\":\"expo\",\"ok\":true}\n");
  }
  if(streq(kind,"done")==1){
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"done\":true}\n");
  }
  if(streq(kind,"test")==1){
    let item:i32=jint(line,"item");
    let cap:i32=jint(line,"cap");
    let q:[]u8=jval(line,"q");
    let head:[]u8=z_alloc(64); let p1:[]u8=z_alloc(64); let p2:[]u8=z_alloc(64);
    qpart(q,0,head); qpart(q,1,p1); qpart(q,2,p2);
    let ans:[]u8=z_alloc(32);
    ans[0]=85; ans[1]=78; ans[2]=75; ans[3]=78; ans[4]=79; ans[5]=87; ans[6]=78; ans[7]=0;
    if(streq(head,"ptest")==1){
      let pnb:[]u8=z_alloc(32);
      let qi:i32=0;
      while(qi<p1.len && qi<31){pnb[qi]=p1[qi];qi=qi+1;}
      pnb[qi]=0;
      let pv:[]u8=z_alloc(16);
      if(parse_qvec4(p2,pv)==1){
        let ti:i32=mc_task(W,pnb);
        if(ti>=0){
          let tb:i32=MC_TASKS()+ti*MC_TSZ();
          let ns:i32=get32(W,tb+20);
          if(ns>0){
            let best:i32=0;
            let bestd:i32=5;
            let s:i32=0;
            while(s<ns){
              let sb:i32=tb+24+s*32;
              let d:i32=0;
              if(get32(W,sb)!=get32(pv,0)){d=d+1;}
              if(get32(W,sb+4)!=get32(pv,4)){d=d+1;}
              if(get32(W,sb+8)!=get32(pv,8)){d=d+1;}
              if(get32(W,sb+12)!=get32(pv,12)){d=d+1;}
              if(d<bestd){bestd=d; best=s;}
              s=s+1;
            }
            let bb:i32=tb+24+best*32;
            let ax:i32=0;
            ax=app(ans,ax,i64s(get32(W,bb+16) as i64)); ax=app(ans,ax,",");
            ax=app(ans,ax,i64s(get32(W,bb+20) as i64)); ax=app(ans,ax,",");
            ax=app(ans,ax,i64s(get32(W,bb+24) as i64)); ax=app(ans,ax,",");
            ax=app(ans,ax,i64s(get32(W,bb+28) as i64));
            ans[ax]=0;
          }
        }
      }
      z_free(pnb); z_free(pv);
    }
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"item\":"); at=app(out,at,i64s(item as i64));
    at=app(out,at,",\"cap\":"); at=app(out,at,i64s(cap as i64));
    at=app(out,at,",\"reply\":\""); at=appz(out,at,ans); at=app(out,at,"\"}\n");
    z_free(head); z_free(p1); z_free(p2); z_free(ans);
  }
  let fd:i64=w_open(pjoin(statedir,"mcstate.bin"));
  if(fd>=0){
    w_write(fd,W[0..2244]);
    w_close(fd);
  }
  _zag_print(out[0..at]);
  z_free(W); z_free(line); z_free(out);
  return 0;
}

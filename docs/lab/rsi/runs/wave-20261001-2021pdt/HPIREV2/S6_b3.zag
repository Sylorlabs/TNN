// S6_b3.zag -- H-PI-REV2 step 6 alternative A1/B3 (class-patch memory).
//
// Frozen prereg: docs/lab/rsi/runs/wave-20261001-2021pdt/HPIREV2/PREREG_PI_REV2_STEP6.md
// B3: the frozen v1 procedure (index 38 [N C1 SUB]) plus one patch learned
// from the single counterexample F1r, with NO diagnosis operator, NO
// primitive-construction kit, NO SPECIALIZE operator, NO conflict rule,
// NO rollback. The patch is: IF(input[0]==114, output = byte 114 repeated
// to input length, v_old(input)). The test byte and the output byte are
// read from the counterexample data at runtime; position 0 and the repeat
// shape are the patch template fixed by the prereg text.
// Code-sharing disclosure (sealing protocol): byte-exact extracts of the
// frozen Section A discovery machinery from proc_revise2.zag (committed
// 847a8f10f): z_alloc through get_prog (lines 22-142), benum through
// dsearch (lines 179-271), bytes_eq (lines 308-320). No Section B
// revision-machinery code (observe, diagnose, build_test, specialize,
// branch predict, conflict rule, rollback) appears in this file.
// Pure Zag. Pinned znc.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  return _zag_i64_to_str(v as i64);
}

fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn eval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let l:i32=prog[base+1] as i32;
    let r:i32=prog[base+2] as i32;
    let a:i32=eval_node(prog, l, k, n);
    let b:i32=eval_node(prog, r, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn eval_prog(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return eval_node(prog, nnodes-1, k, n);
}

fn extract_seq(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}

fn prog_fits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    let expected:i32=get32(seq, k*4);
    let got:i32=eval_prog(prog, nnodes, k, n);
    if(got!=expected){return 0;}
    k=k+1;
  }
  return 1;
}

fn add_term(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, term_type:i32)i32 {
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=1 as u8;
  prog_store[store_off+1]=term_type as u8;
  prog_store[store_off+2]=255 as u8;
  prog_store[store_off+3]=255 as u8;
  return store_off+4;
}

fn add_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, left_pi:i32, right_pi:i32)i32 {
  let left_off:i32=get32(prog_index, left_pi*4);
  let right_off:i32=get32(prog_index, right_pi*4);
  let left_n:i32=prog_store[left_off] as i32;
  let right_n:i32=prog_store[right_off] as i32;
  let total_n:i32=left_n+right_n+1;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=total_n as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<left_n){
    prog_store[dst]=prog_store[left_off+1+i*3];
    prog_store[dst+1]=prog_store[left_off+1+i*3+1];
    prog_store[dst+2]=prog_store[left_off+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<right_n){
    let t:i32=prog_store[right_off+1+i*3] as i32;
    let l:i32=prog_store[right_off+1+i*3+1] as i32;
    let r:i32=prog_store[right_off+1+i*3+2] as i32;
    prog_store[dst]=t as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+left_n) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+left_n) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(left_n-1) as u8;
  prog_store[dst+2]=(left_n+right_n-1) as u8;
  dst=dst+3;
  return dst;
}

fn get_prog(prog_store:[]u8, prog_index:[]u8, pi:i32, out_nnodes:[]u8)[]u8 {
  let off:i32=get32(prog_index, pi*4);
  out_nnodes[0]=prog_store[off];
  return prog_store[off+1..off+1+ (prog_store[off] as i32)*3];
}

fn benum(prog_store:[]u8, prog_index:[]u8)i32 {
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    store_off=add_term(prog_store, prog_index, pcount, store_off, t);
    pcount=pcount+1; t=t+1;
  }
  let size1_end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let size3_end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=size1_end;
      while(b<size3_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    a=size1_end;
    while(a<size3_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  return pcount;
}

// Sequence staging: flat buffer of up to 4 seqs, 16 entries each.
fn loadseq(sdat:[]u8, sod:[]u8, sld:[]u8, snd:[]u8, slot:i32, inp:[]u8, out:[]u8, n:i32)i32 {
  let sq:[]u8=z_alloc(64);
  let ln:i32=extract_seq(inp, out, sq);
  let off:i32=slot*64;
  let i:i32=0;
  while(i<64){ sdat[off+i]=sq[i]; i=i+1; }
  set32(sod, slot*4, off);
  set32(sld, slot*4, ln);
  set32(snd, slot*4, n);
  return ln;
}
fn getseq(sdat:[]u8, sod:[]u8, sld:[]u8, s:i32, lnout:[]u8)[]u8 {
  let off:i32=get32(sod, s*4);
  let ln:i32=get32(sld, s*4);
  set32(lnout, 0, ln);
  if(ln<0){ return sdat[0..0]; }
  return sdat[off..off+ln*4];
}

// Smallest program fitting all staged seqs; -1 when none fits.
fn dsearch(ps:[]u8, pidx:[]u8, pcount:i32, sdat:[]u8, sod:[]u8, sld:[]u8, snd:[]u8, nseq:i32)i32 {
  let tmp:[]u8=z_alloc(1);
  let lnb:[]u8=z_alloc(4);
  let pi:i32=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(ps, pidx, pi, tmp);
    let nn:i32=tmp[0] as i32;
    let ok:i32=1;
    let s:i32=0;
    while(s<nseq){
      let sq:[]u8=getseq(sdat, sod, sld, s, lnb);
      let ln:i32=get32(lnb, 0);
      let n:i32=get32(snd, s*4);
      if(prog_fits(prog, nn, sq, ln, n)!=1){ ok=0; s=nseq; }
      s=s+1;
    }
    if(ok==1){ return pi; }
    pi=pi+1;
  }
  return -1;
}

// Example log. st layout: [0]=count, then slots of 6 i32:
// in_off, in_len, out_off, out_len, status (0 current, 1 superseded), phase.
fn bytes_eq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){
    if(a[i]!=b[i]){ return 0; }
    i=i+1;
  }
  return 1;
}

// Predict with the ACTIVE procedure: branch list (most recent first),
// else the base program. Returns output length, or -1 when a program
// yields an out-of-range position.

// ============ B3: class-patch memory ============

fn b3_v1_predict(pi:i32, ps:[]u8, pidx:[]u8, inp:[]u8, out:[]u8)i32 {
  let tmp:[]u8=z_alloc(1);
  let pr:[]u8=get_prog(ps, pidx, pi, tmp);
  let nn:i32=tmp[0] as i32;
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let id:i32=eval_prog(pr, nn, k, n);
    if(id<0){ return -1; }
    if(id>=n){ return -1; }
    out[k]=inp[id];
    k=k+1;
  }
  return n;
}

fn b3_predict(v1:i32, patch:i32, pbyte:i32, obyte:i32, ps:[]u8, pidx:[]u8, inp:[]u8, out:[]u8)i32 {
  if(patch==1){
    if(inp.len>0){
      if((inp[0] as i32)==pbyte){
        let k:i32=0;
        while(k<inp.len){
          out[k]=obyte as u8;
          k=k+1;
        }
        return inp.len;
      }
    }
  }
  return b3_v1_predict(v1, ps, pidx, inp, out);
}

fn b3_pcheck(v1:i32, patch:i32, pbyte:i32, obyte:i32, ps:[]u8, pidx:[]u8, probe:[]u8, inp:[]u8, want:[]u8, fails:[]u8, okc:[]u8)void {
  let n:i32=b3_predict(v1, patch, pbyte, obyte, ps, pidx, inp, probe);
  emit("B3 PREDICT ");
  emit(inp);
  emit(" -> ");
  if(n<0){
    emit("UNPREDICTABLE\n");
    set32(fails, 0, get32(fails, 0)+1);
    return;
  }
  let got:[]u8=probe[0..n];
  emit(got);
  if(n==want.len){
    if(bytes_eq(got, want)==1){
      emit(" [ok]\n");
      set32(okc, 0, get32(okc, 0)+1);
      return;
    }
  }
  emit(" [MISMATCH want ");
  emit(want);
  emit("]\n");
  set32(fails, 0, get32(fails, 0)+1);
  return;
}

fn main()i32 {
  emit("=== B3 class-patch memory (A1 alternative) ===\n");
  let fails:[]u8=z_alloc(4);
  set32(fails, 0, 0);
  let okc:[]u8=z_alloc(4);
  set32(okc, 0, 0);
  let ps:[]u8=z_alloc(200000);
  let pidx:[]u8=z_alloc(1200*4);
  let pcount:i32=benum(ps, pidx);
  emit("B3 enumerated ");
  emit(i32s(pcount));
  emit(" programs\n");
  let sdat:[]u8=z_alloc(4*64);
  let sod:[]u8=z_alloc(16);
  let sld:[]u8=z_alloc(16);
  let snd:[]u8=z_alloc(16);
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, "abc", "ccc", 3);
  let _l:i32=loadseq(sdat, sod, sld, snd, 1, "xy", "yy", 2);
  let _l:i32=loadseq(sdat, sod, sld, snd, 2, "defg", "gggg", 4);
  let v1:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 3);
  emit("B3 v1-index ");
  emit(i32s(v1));
  emit("\n");
  let probe:[]u8=z_alloc(64);
  let xybuf:[]u8=z_alloc(64);
  // The single counterexample F1r. Simple predict-vs-actual mismatch
  // detection. This is NOT the diagnosis operator: there is no candidate
  // enumeration, no ranking, no conflict analysis.
  let f1r_in:[]u8="rab";
  let f1r_out:[]u8="rrr";
  let n0:i32=b3_v1_predict(v1, ps, pidx, f1r_in, probe);
  let mm:i32=0;
  if(n0!=f1r_out.len){ mm=1; }
  else {
    if(bytes_eq(probe[0..n0], f1r_out)!=1){ mm=1; }
  }
  let patch:i32=0;
  let pbyte:i32=0;
  let obyte:i32=0;
  if(mm==1){
    emit("B3 COUNTEREXAMPLE_DETECTED(rab)\n");
    pbyte=f1r_in[0] as i32;
    obyte=f1r_out[0] as i32;
    patch=1;
    emit("B3 PATCH ACTIVE test=(pos=0,byte=");
    emit(i32s(pbyte));
    emit(",outbyte=");
    emit(i32s(obyte));
    emit(")\n");
  }
  // Competence checks: F1r and F1r-reuse, presented after PATCH ACTIVE.
  b3_pcheck(v1, patch, pbyte, obyte, ps, pidx, probe, "rab", "rrr", fails, okc);
  let b3_correct_f1r:i32=get32(okc, 0);
  b3_pcheck(v1, patch, pbyte, obyte, ps, pidx, probe, "rqw", "rrr", fails, okc);
  let b3_correct_reuse:i32=get32(okc, 0)-b3_correct_f1r;
  // Frozen probes. The xy probe carries the K-AX1 distinction.
  b3_pcheck(v1, patch, pbyte, obyte, ps, pidx, probe, "abc", "ccc", fails, okc);
  let nx:i32=b3_predict(v1, patch, pbyte, obyte, ps, pidx, "xy", xybuf);
  emit("B3 PREDICT xy -> ");
  emit(xybuf[0..nx]);
  emit("\n");
  b3_pcheck(v1, patch, pbyte, obyte, ps, pidx, probe, "defg", "gggg", fails, okc);
  emit("b3_correct_f1r=");
  emit(i32s(b3_correct_f1r));
  emit("\n");
  emit("b3_correct_reuse=");
  emit(i32s(b3_correct_reuse));
  emit("\n");
  emit("b3_predict_xy=");
  emit(xybuf[0..nx]);
  emit("\n");
  let nf:i32=get32(fails, 0);
  emit("B3 fails=");
  emit(i32s(nf));
  emit("\n");
  emit("B3 DONE\n");
  return 0;
}

// S6_b4.zag -- H-PI-REV2 step 6 alternative A2/B4 (template-aware re-search).
//
// Frozen prereg: docs/lab/rsi/runs/wave-20261001-2021pdt/HPIREV2/PREREG_PI_REV2_STEP6.md
// B4: re-search over the frozen 1055-program benum space in frozen dsearch
// order, EXTENDED with SPECIALIZE template completions: for pos in {0,1,2},
// for byte in 0..255 ascending, candidate = IF(byte-equality(pos,byte),
// alt_prog, v_old), where alt_prog is the first program in frozen dsearch
// order fitting F1r alone and v_old is the frozen v1 procedure. The two
// streams are concatenated: the 1055 benum programs first, then the template
// completions in the stated order. B4 uses no diagnosis, no ranking, no
// conflict rule. Candidates are evaluated against the frozen K-SB4a
// expectations (the 5 checks).
// Code-sharing disclosure (sealing protocol): byte-exact extracts of the
// frozen Section A discovery machinery from proc_revise2.zag (committed
// 847a8f10f): z_alloc through get_prog (lines 22-142), benum through
// dsearch (lines 179-271), bytes_eq (lines 308-320). The template shape
// IF(byte-equality(pos,byte), alt, v_old) is implemented below as stated
// in the prereg. No Section B revision-machinery code (observe, diagnose,
// build_test, specialize, conflict rule, rollback) appears in this file.
// Pure Zag. Pinned znc.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  return _zag_i64_to_str(v as i64);
}

fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn eval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let l:i32=prog[base+1] as i32;
    let r:i32=prog[base+2] as i32;
    let a:i32=eval_node(prog, l, k, n);
    let b:i32=eval_node(prog, r, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn eval_prog(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return eval_node(prog, nnodes-1, k, n);
}

fn extract_seq(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}

fn prog_fits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    let expected:i32=get32(seq, k*4);
    let got:i32=eval_prog(prog, nnodes, k, n);
    if(got!=expected){return 0;}
    k=k+1;
  }
  return 1;
}

fn add_term(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, term_type:i32)i32 {
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=1 as u8;
  prog_store[store_off+1]=term_type as u8;
  prog_store[store_off+2]=255 as u8;
  prog_store[store_off+3]=255 as u8;
  return store_off+4;
}

fn add_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, left_pi:i32, right_pi:i32)i32 {
  let left_off:i32=get32(prog_index, left_pi*4);
  let right_off:i32=get32(prog_index, right_pi*4);
  let left_n:i32=prog_store[left_off] as i32;
  let right_n:i32=prog_store[right_off] as i32;
  let total_n:i32=left_n+right_n+1;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=total_n as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<left_n){
    prog_store[dst]=prog_store[left_off+1+i*3];
    prog_store[dst+1]=prog_store[left_off+1+i*3+1];
    prog_store[dst+2]=prog_store[left_off+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<right_n){
    let t:i32=prog_store[right_off+1+i*3] as i32;
    let l:i32=prog_store[right_off+1+i*3+1] as i32;
    let r:i32=prog_store[right_off+1+i*3+2] as i32;
    prog_store[dst]=t as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+left_n) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+left_n) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(left_n-1) as u8;
  prog_store[dst+2]=(left_n+right_n-1) as u8;
  dst=dst+3;
  return dst;
}

fn get_prog(prog_store:[]u8, prog_index:[]u8, pi:i32, out_nnodes:[]u8)[]u8 {
  let off:i32=get32(prog_index, pi*4);
  out_nnodes[0]=prog_store[off];
  return prog_store[off+1..off+1+ (prog_store[off] as i32)*3];
}

fn benum(prog_store:[]u8, prog_index:[]u8)i32 {
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    store_off=add_term(prog_store, prog_index, pcount, store_off, t);
    pcount=pcount+1; t=t+1;
  }
  let size1_end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let size3_end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=size1_end;
      while(b<size3_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    a=size1_end;
    while(a<size3_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  return pcount;
}

// Sequence staging: flat buffer of up to 4 seqs, 16 entries each.
fn loadseq(sdat:[]u8, sod:[]u8, sld:[]u8, snd:[]u8, slot:i32, inp:[]u8, out:[]u8, n:i32)i32 {
  let sq:[]u8=z_alloc(64);
  let ln:i32=extract_seq(inp, out, sq);
  let off:i32=slot*64;
  let i:i32=0;
  while(i<64){ sdat[off+i]=sq[i]; i=i+1; }
  set32(sod, slot*4, off);
  set32(sld, slot*4, ln);
  set32(snd, slot*4, n);
  return ln;
}
fn getseq(sdat:[]u8, sod:[]u8, sld:[]u8, s:i32, lnout:[]u8)[]u8 {
  let off:i32=get32(sod, s*4);
  let ln:i32=get32(sld, s*4);
  set32(lnout, 0, ln);
  if(ln<0){ return sdat[0..0]; }
  return sdat[off..off+ln*4];
}

// Smallest program fitting all staged seqs; -1 when none fits.
fn dsearch(ps:[]u8, pidx:[]u8, pcount:i32, sdat:[]u8, sod:[]u8, sld:[]u8, snd:[]u8, nseq:i32)i32 {
  let tmp:[]u8=z_alloc(1);
  let lnb:[]u8=z_alloc(4);
  let pi:i32=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(ps, pidx, pi, tmp);
    let nn:i32=tmp[0] as i32;
    let ok:i32=1;
    let s:i32=0;
    while(s<nseq){
      let sq:[]u8=getseq(sdat, sod, sld, s, lnb);
      let ln:i32=get32(lnb, 0);
      let n:i32=get32(snd, s*4);
      if(prog_fits(prog, nn, sq, ln, n)!=1){ ok=0; s=nseq; }
      s=s+1;
    }
    if(ok==1){ return pi; }
    pi=pi+1;
  }
  return -1;
}

// Example log. st layout: [0]=count, then slots of 6 i32:
// in_off, in_len, out_off, out_len, status (0 current, 1 superseded), phase.
fn bytes_eq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){
    if(a[i]!=b[i]){ return 0; }
    i=i+1;
  }
  return 1;
}

// Predict with the ACTIVE procedure: branch list (most recent first),
// else the base program. Returns output length, or -1 when a program
// yields an out-of-range position.

// ============ B4: template-aware re-search ============

fn b4_pair_in(i:i32)[]u8 {
  if(i==0){ return "abc"; }
  if(i==1){ return "xy"; }
  if(i==2){ return "defg"; }
  if(i==3){ return "rab"; }
  return "rqw";
}

fn b4_pair_out(i:i32)[]u8 {
  if(i==0){ return "ccc"; }
  if(i==1){ return "xx"; }
  if(i==2){ return "gggg"; }
  if(i==3){ return "rrr"; }
  return "rrr";
}

fn b4_prog_predict(pi:i32, ps:[]u8, pidx:[]u8, inp:[]u8, out:[]u8)i32 {
  let tmp:[]u8=z_alloc(1);
  let pr:[]u8=get_prog(ps, pidx, pi, tmp);
  let nn:i32=tmp[0] as i32;
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let id:i32=eval_prog(pr, nn, k, n);
    if(id<0){ return -1; }
    if(id>=n){ return -1; }
    out[k]=inp[id];
    k=k+1;
  }
  return n;
}

fn b4_tmpl_predict(pos:i32, byte:i32, alt:i32, v_old:i32, ps:[]u8, pidx:[]u8, inp:[]u8, out:[]u8)i32 {
  let sel:i32=v_old;
  if(pos<inp.len){
    if((inp[pos] as i32)==byte){ sel=alt; }
  }
  return b4_prog_predict(sel, ps, pidx, inp, out);
}

fn b4_prog_fails5(pi:i32, ps:[]u8, pidx:[]u8, probe:[]u8)i32 {
  let f:i32=0;
  let i:i32=0;
  while(i<5){
    let inn:[]u8=b4_pair_in(i);
    let want:[]u8=b4_pair_out(i);
    let n:i32=b4_prog_predict(pi, ps, pidx, inn, probe);
    if(n!=want.len){ f=f+1; }
    else {
      if(bytes_eq(probe[0..n], want)!=1){ f=f+1; }
    }
    i=i+1;
  }
  return f;
}

fn b4_tmpl_fails5(pos:i32, byte:i32, alt:i32, v_old:i32, ps:[]u8, pidx:[]u8, probe:[]u8)i32 {
  let f:i32=0;
  let i:i32=0;
  while(i<5){
    let inn:[]u8=b4_pair_in(i);
    let want:[]u8=b4_pair_out(i);
    let n:i32=b4_tmpl_predict(pos, byte, alt, v_old, ps, pidx, inn, probe);
    if(n!=want.len){ f=f+1; }
    else {
      if(bytes_eq(probe[0..n], want)!=1){ f=f+1; }
    }
    i=i+1;
  }
  return f;
}

fn main()i32 {
  emit("=== B4 template-aware re-search (A2 alternative) ===\n");
  emit("B4 uses no diagnosis, no ranking, no conflict rule.\n");
  let ps:[]u8=z_alloc(200000);
  let pidx:[]u8=z_alloc(1200*4);
  let pcount:i32=benum(ps, pidx);
  emit("B4 enumerated ");
  emit(i32s(pcount));
  emit(" programs\n");
  let sdat:[]u8=z_alloc(4*64);
  let sod:[]u8=z_alloc(16);
  let sld:[]u8=z_alloc(16);
  let snd:[]u8=z_alloc(16);
  // alt_prog: first program in frozen dsearch order fitting F1r alone.
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, "rab", "rrr", 3);
  let alt:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 1);
  emit("B4 alt-index ");
  emit(i32s(alt));
  emit("\n");
  // v_old: the frozen v1 procedure (discovery on T).
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, "abc", "ccc", 3);
  let _l:i32=loadseq(sdat, sod, sld, snd, 1, "xy", "yy", 2);
  let _l:i32=loadseq(sdat, sod, sld, snd, 2, "defg", "gggg", 4);
  let v_old:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 3);
  emit("B4 v_old-index ");
  emit(i32s(v_old));
  emit("\n");
  let probe:[]u8=z_alloc(64);
  // Stream: the 1055 benum programs in frozen dsearch order first, then
  // the SPECIALIZE template completions: pos in {0,1,2}, byte 0..255
  // ascending. Each candidate is evaluated against the 5 frozen K-SB4a
  // checks; the scan stops at the first full fit (fails=0).
  let evaluated:i32=0;
  let found:i32=-1;
  let pi:i32=0;
  while(pi<pcount){
    if(found<0){
      evaluated=evaluated+1;
      if(b4_prog_fails5(pi, ps, pidx, probe)==0){ found=pi; }
    }
    pi=pi+1;
  }
  let pos:i32=0;
  while(pos<3){
    if(found<0){
      let byte:i32=0;
      while(byte<256){
        if(found<0){
          evaluated=evaluated+1;
          if(b4_tmpl_fails5(pos, byte, alt, v_old, ps, pidx, probe)==0){
            found=pcount+pos*256+byte;
          }
        }
        byte=byte+1;
      }
    }
    pos=pos+1;
  }
  let stream_total:i32=pcount+3*256;
  emit("B4 stream-total ");
  emit(i32s(stream_total));
  emit("\n");
  emit("B4 programs-evaluated ");
  emit(i32s(evaluated));
  emit("\n");
  emit("B4 first-fit-index ");
  emit(i32s(found));
  emit("\n");
  // Machine-greppable metric per the prereg: b4_enumerated is the count
  // until the first full fit, or -1 with the full stream count if none fits.
  if(found<0){
    emit("b4_enumerated=-1\n");
  } else {
    emit("b4_enumerated=");
    emit(i32s(evaluated));
    emit("\n");
  }
  emit("b4_first_fit_index=");
  emit(i32s(found));
  emit("\n");
  emit("b4_stream_total=");
  emit(i32s(stream_total));
  emit("\n");
  emit("B4 DONE\n");
  return 0;
}

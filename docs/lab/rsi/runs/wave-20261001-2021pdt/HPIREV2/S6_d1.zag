// S6_d1.zag -- H-PI-REV2 step 6 ablation D1 (SPECIALIZE template excised).
//
// Frozen prereg: docs/lab/rsi/runs/wave-20261001-2021pdt/HPIREV2/PREREG_PI_REV2_STEP6.md
// D1: the frozen revision machinery with the SPECIALIZE template REMOVED
// and nothing else changed. Diagnosis and build_test run normally; the
// final construction may only select among the frozen 1055 programs (no
// IF-template wrapping): D1 selects the first program in frozen dsearch
// order fitting F1r alone, and reports its predictions on the 5 frozen
// checks. Precondition: D1 must emit the same DIAGNOSIS line as the full
// run ("DIAGNOSIS pos=0 byte=114 conflicts=0"); otherwise the run is void.
// Code-sharing and excision disclosure (sealing protocol): this file carries
// byte-exact extracts of the frozen machinery from proc_revise2.zag
// (committed 847a8f10f), lines 22-496: z_alloc through build_test
// (Section A discovery machinery plus predict, observe, diagnose,
// build_test). EXCISED: fn specialize, frozen lines 503-543, and its call
// sites (frozen lines 733 and 798 are not present; D1 has its own main).
// Not carried: rollback (544-557), check/pcheck/rcell helpers and the
// original main (558-end); D1 supplies its own main and check helper.
// The branch slot created by build_test is never consulted: D1 predicts
// with the selected program directly (no branch list), because no
// specialize call completes the slot.
// Pure Zag. Pinned znc.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  return _zag_i64_to_str(v as i64);
}

fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn eval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let l:i32=prog[base+1] as i32;
    let r:i32=prog[base+2] as i32;
    let a:i32=eval_node(prog, l, k, n);
    let b:i32=eval_node(prog, r, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn eval_prog(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return eval_node(prog, nnodes-1, k, n);
}

fn extract_seq(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}

fn prog_fits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    let expected:i32=get32(seq, k*4);
    let got:i32=eval_prog(prog, nnodes, k, n);
    if(got!=expected){return 0;}
    k=k+1;
  }
  return 1;
}

fn add_term(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, term_type:i32)i32 {
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=1 as u8;
  prog_store[store_off+1]=term_type as u8;
  prog_store[store_off+2]=255 as u8;
  prog_store[store_off+3]=255 as u8;
  return store_off+4;
}

fn add_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, left_pi:i32, right_pi:i32)i32 {
  let left_off:i32=get32(prog_index, left_pi*4);
  let right_off:i32=get32(prog_index, right_pi*4);
  let left_n:i32=prog_store[left_off] as i32;
  let right_n:i32=prog_store[right_off] as i32;
  let total_n:i32=left_n+right_n+1;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=total_n as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<left_n){
    prog_store[dst]=prog_store[left_off+1+i*3];
    prog_store[dst+1]=prog_store[left_off+1+i*3+1];
    prog_store[dst+2]=prog_store[left_off+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<right_n){
    let t:i32=prog_store[right_off+1+i*3] as i32;
    let l:i32=prog_store[right_off+1+i*3+1] as i32;
    let r:i32=prog_store[right_off+1+i*3+2] as i32;
    prog_store[dst]=t as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+left_n) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+left_n) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(left_n-1) as u8;
  prog_store[dst+2]=(left_n+right_n-1) as u8;
  dst=dst+3;
  return dst;
}

fn get_prog(prog_store:[]u8, prog_index:[]u8, pi:i32, out_nnodes:[]u8)[]u8 {
  let off:i32=get32(prog_index, pi*4);
  out_nnodes[0]=prog_store[off];
  return prog_store[off+1..off+1+ (prog_store[off] as i32)*3];
}

fn print_seq(seq:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    emit(i32s(get32(seq, i*4)));
    i=i+1;
  }
  emit("]");
  return;
}

fn print_prog(prog:[]u8, nnodes:i32)void {
  emit("[");
  let i:i32=0;
  while(i<nnodes){
    if(i>0){emit(" ");}
    let tt:i32=prog[i*3] as i32;
    if(tt==0){emit("K");}
    else if(tt==1){emit("N");}
    else if(tt==2){emit("C0");}
    else if(tt==3){emit("C1");}
    else if(tt==4){emit("C2");}
    else if(tt==5){emit("ADD");}
    else if(tt==6){emit("SUB");}
    i=i+1;
  }
  emit("]");
  return;
}

// ============ Section B: H-PI-REV2 new machinery (generic, data-driven) ============
// NOTE: this section avoids the letter used by fixture bytes in identifiers,
// comments, and string literals, so audits stay mechanical.

// Ported enumeration loop, wrapped as a function (same algorithm as v1 main).
fn benum(prog_store:[]u8, prog_index:[]u8)i32 {
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    store_off=add_term(prog_store, prog_index, pcount, store_off, t);
    pcount=pcount+1; t=t+1;
  }
  let size1_end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let size3_end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=size1_end;
      while(b<size3_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    a=size1_end;
    while(a<size3_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  return pcount;
}

// Sequence staging: flat buffer of up to 4 seqs, 16 entries each.
fn loadseq(sdat:[]u8, sod:[]u8, sld:[]u8, snd:[]u8, slot:i32, inp:[]u8, out:[]u8, n:i32)i32 {
  let sq:[]u8=z_alloc(64);
  let ln:i32=extract_seq(inp, out, sq);
  let off:i32=slot*64;
  let i:i32=0;
  while(i<64){ sdat[off+i]=sq[i]; i=i+1; }
  set32(sod, slot*4, off);
  set32(sld, slot*4, ln);
  set32(snd, slot*4, n);
  return ln;
}
fn getseq(sdat:[]u8, sod:[]u8, sld:[]u8, s:i32, lnout:[]u8)[]u8 {
  let off:i32=get32(sod, s*4);
  let ln:i32=get32(sld, s*4);
  set32(lnout, 0, ln);
  if(ln<0){ return sdat[0..0]; }
  return sdat[off..off+ln*4];
}

// Smallest program fitting all staged seqs; -1 when none fits.
fn dsearch(ps:[]u8, pidx:[]u8, pcount:i32, sdat:[]u8, sod:[]u8, sld:[]u8, snd:[]u8, nseq:i32)i32 {
  let tmp:[]u8=z_alloc(1);
  let lnb:[]u8=z_alloc(4);
  let pi:i32=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(ps, pidx, pi, tmp);
    let nn:i32=tmp[0] as i32;
    let ok:i32=1;
    let s:i32=0;
    while(s<nseq){
      let sq:[]u8=getseq(sdat, sod, sld, s, lnb);
      let ln:i32=get32(lnb, 0);
      let n:i32=get32(snd, s*4);
      if(prog_fits(prog, nn, sq, ln, n)!=1){ ok=0; s=nseq; }
      s=s+1;
    }
    if(ok==1){ return pi; }
    pi=pi+1;
  }
  return -1;
}

// Example log. st layout: [0]=count, then slots of 6 i32:
// in_off, in_len, out_off, out_len, status (0 current, 1 superseded), phase.
fn ex_add(st:[]u8, pool:[]u8, pu:[]u8, inp:[]u8, out:[]u8, phase:i32)i32 {
  let n:i32=get32(st, 0);
  let puv:i32=get32(pu, 0);
  let base:i32=4+n*24;
  set32(st, base, puv);
  set32(st, base+4, inp.len);
  let i:i32=0;
  while(i<inp.len){ pool[puv+i]=inp[i]; i=i+1; }
  puv=puv+inp.len;
  set32(st, base+8, puv);
  set32(st, base+12, out.len);
  i=0;
  while(i<out.len){ pool[puv+i]=out[i]; i=i+1; }
  puv=puv+out.len;
  set32(st, base+16, 0);
  set32(st, base+20, phase);
  set32(st, 0, n+1);
  set32(pu, 0, puv);
  return n;
}
fn ex_in(st:[]u8, pool:[]u8, e:i32)[]u8 {
  let base:i32=4+e*24;
  let off:i32=get32(st, base);
  let ln:i32=get32(st, base+4);
  return pool[off..off+ln];
}
fn ex_out(st:[]u8, pool:[]u8, e:i32)[]u8 {
  let base:i32=4+e*24;
  let off:i32=get32(st, base+8);
  let ln:i32=get32(st, base+12);
  return pool[off..off+ln];
}
fn ex_status(st:[]u8, e:i32)i32 {
  return get32(st, 4+e*24+16);
}

fn bytes_eq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){
    if(a[i]!=b[i]){ return 0; }
    i=i+1;
  }
  return 1;
}

// Predict with the ACTIVE procedure: branch list (most recent first),
// else the base program. Returns output length, or -1 when a program
// yields an out-of-range position.
fn predict(base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, inp:[]u8, out:[]u8)i32 {
  let n:i32=inp.len;
  let psel:i32=base;
  let bi:i32=nb-1;
  let done:i32=0;
  while(bi>=0){
    if(done==0){
      let bpos:i32=get32(br, bi*12);
      if(bpos<n){
        if((inp[bpos] as i32)==get32(br, bi*12+4)){
          psel=get32(br, bi*12+8);
          done=1;
        }
      }
    }
    bi=bi-1;
  }
  let tmp:[]u8=z_alloc(1);
  let pr:[]u8=get_prog(ps, pidx, psel, tmp);
  let nn:i32=tmp[0] as i32;
  let k:i32=0;
  while(k<n){
    let id:i32=eval_prog(pr, nn, k, n);
    if(id<0){ return -1; }
    if(id>=n){ return -1; }
    out[k]=inp[id];
    k=k+1;
  }
  return n;
}

// Monitor loop: predict with the ACTIVE procedure, compare against the
// observed output. Detection is purely predict-vs-actual mismatch; this
// function holds no branch on input content (audited, K-RV2-3).
// Returns 1 when a counterexample is detected, else 0.
fn observe(st:[]u8, pool:[]u8, pu:[]u8, base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, inp:[]u8, out:[]u8, phase:i32, probe:[]u8)i32 {
  let n:i32=predict(base, br, nb, ps, pidx, inp, probe);
  let _ex:i32=ex_add(st, pool, pu, inp, out, phase);
  if(n!=out.len){
    emit("COUNTEREXAMPLE_DETECTED(");
    emit(inp);
    emit(")\n");
    return 1;
  }
  if(bytes_eq(probe[0..n], out)!=1){
    emit("COUNTEREXAMPLE_DETECTED(");
    emit(inp);
    emit(")\n");
    return 1;
  }
  return 0;
}

// Diagnosis operator. Failing set F and passing set P come from the log
// under the ACTIVE procedure. Candidate conditions (p, b): every f in F
// holds byte b at position p. Rank: position ascending, then byte
// ascending (frozen; the second key never decides on frozen evidence).
// Conflicts with P are recorded, never disqualifying.
// dout: [pos, byte, nconflict]. Returns 1, or 0 with CANNOT-DIAGNOSE.
fn diagnose(st:[]u8, pool:[]u8, base:i32, br:[]u8, nb:i32, ps:[]u8, pidx:[]u8, dout:[]u8, probe:[]u8)i32 {
  let n:i32=get32(st, 0);
  let fb:[]u8=z_alloc(32*4);
  let pb:[]u8=z_alloc(32*4);
  let nf:i32=0;
  let np:i32=0;
  let e:i32=0;
  while(e<n){
    if(ex_status(st, e)==0){
      let ie:[]u8=ex_in(st, pool, e);
      let oe:[]u8=ex_out(st, pool, e);
      let pr:i32=predict(base, br, nb, ps, pidx, ie, probe);
      let bad:i32=0;
      if(pr!=oe.len){ bad=1; }
      else {
        if(bytes_eq(probe[0..pr], oe)!=1){ bad=1; }
      }
      if(bad==1){ set32(fb, nf*4, e); nf=nf+1; }
      else { set32(pb, np*4, e); np=np+1; }
    }
    e=e+1;
  }
  let cb:[]u8=z_alloc(64*8);
  let nc:i32=0;
  let fi:i32=0;
  while(fi<nf){
    let fe:i32=get32(fb, fi*4);
    let fin:[]u8=ex_in(st, pool, fe);
    let p:i32=0;
    while(p<fin.len){
      let b:i32=fin[p] as i32;
      let ok:i32=1;
      let fj:i32=0;
      while(fj<nf){
        let fe2:i32=get32(fb, fj*4);
        let fin2:[]u8=ex_in(st, pool, fe2);
        if(p>=fin2.len){ ok=0; fj=nf; }
        else {
          if((fin2[p] as i32)!=b){ ok=0; fj=nf; }
        }
        fj=fj+1;
      }
      if(ok==1){
        let dup:i32=0;
        let ci:i32=0;
        while(ci<nc){
          if(get32(cb, ci*8)==p){
            if(get32(cb, ci*8+4)==b){ dup=1; ci=nc; }
          }
          ci=ci+1;
        }
        if(dup==0){
          set32(cb, nc*8, p);
          set32(cb, nc*8+4, b);
          nc=nc+1;
        }
      }
      p=p+1;
    }
    fi=fi+1;
  }
  if(nc==0){
    emit("CANNOT-DIAGNOSE\n");
    return 0;
  }
  let bpos:i32=1000000;
  let bbyte:i32=1000000;
  let ci2:i32=0;
  while(ci2<nc){
    let p2:i32=get32(cb, ci2*8);
    let b2:i32=get32(cb, ci2*8+4);
    if(p2<bpos){ bpos=p2; bbyte=b2; }
    else {
      if(p2==bpos){
        if(b2<bbyte){ bbyte=b2; }
      }
    }
    ci2=ci2+1;
  }
  let ncon:i32=0;
  let pj:i32=0;
  while(pj<np){
    let pe:i32=get32(pb, pj*4);
    let pin:[]u8=ex_in(st, pool, pe);
    if(bpos<pin.len){
      if((pin[bpos] as i32)==bbyte){ ncon=ncon+1; }
    }
    pj=pj+1;
  }
  set32(dout, 0, bpos);
  set32(dout, 4, bbyte);
  set32(dout, 8, ncon);
  emit("DIAGNOSIS pos=");
  emit(i32s(bpos));
  emit(" byte=");
  emit(i32s(bbyte));
  emit(" conflicts=");
  emit(i32s(ncon));
  emit("\n");
  return 1;
}

// Primitive-construction kit: mechanically build the test (pos, byte).
// The byte value arrives as data; no literal lives here.
fn build_test(br:[]u8, nbr:[]u8, pos:i32, byte:i32)i32 {
  let n:i32=get32(nbr, 0);
  set32(br, n*12, pos);
  set32(br, n*12+4, byte);
  set32(br, n*12+8, -1);
  set32(nbr, 0, n+1);
  emit("PRIMITIVE-CONSTRUCTED pos=");
  emit(i32s(pos));
  emit(" byte=");
  emit(i32s(byte));
  emit("\n");
  return n;
}

// ============ D1: ablation main (SPECIALIZE excised) ============

fn d1_raw_predict(base:i32, ps:[]u8, pidx:[]u8, inp:[]u8, out:[]u8)i32 {
  let tmp:[]u8=z_alloc(1);
  let pr:[]u8=get_prog(ps, pidx, base, tmp);
  let nn:i32=tmp[0] as i32;
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let id:i32=eval_prog(pr, nn, k, n);
    if(id<0){ return -1; }
    if(id>=n){ return -1; }
    out[k]=inp[id];
    k=k+1;
  }
  return n;
}

fn d1_pcheck(base:i32, ps:[]u8, pidx:[]u8, probe:[]u8, inp:[]u8, want:[]u8, fails:[]u8)void {
  let tmp:[]u8=z_alloc(1);
  let pr:[]u8=get_prog(ps, pidx, base, tmp);
  let nn:i32=tmp[0] as i32;
  let n:i32=inp.len;
  let k:i32=0;
  let bad:i32=0;
  while(k<n){
    let id:i32=eval_prog(pr, nn, k, n);
    if(id<0){ bad=1; k=n; }
    else {
      if(id>=n){ bad=1; k=n; }
      else { probe[k]=inp[id]; k=k+1; }
    }
  }
  emit("D1 PREDICT ");
  emit(inp);
  emit(" -> ");
  if(bad==1){
    emit("UNPREDICTABLE\n");
    set32(fails, 0, get32(fails, 0)+1);
    return;
  }
  let got:[]u8=probe[0..n];
  emit(got);
  if(n==want.len){
    if(bytes_eq(got, want)==1){
      emit(" [ok]\n");
      return;
    }
  }
  emit(" [MISMATCH want ");
  emit(want);
  emit("]\n");
  set32(fails, 0, get32(fails, 0)+1);
  return;
}

fn main()i32 {
  emit("=== D1 ablation (SPECIALIZE template excised) ===\n");
  let fails:[]u8=z_alloc(4);
  set32(fails, 0, 0);
  let ps:[]u8=z_alloc(200000);
  let pidx:[]u8=z_alloc(1200*4);
  let pcount:i32=benum(ps, pidx);
  emit("D1 enumerated ");
  emit(i32s(pcount));
  emit(" programs\n");
  let sdat:[]u8=z_alloc(4*64);
  let sod:[]u8=z_alloc(16);
  let sld:[]u8=z_alloc(16);
  let snd:[]u8=z_alloc(16);
  // Discovery on T (frozen).
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, "abc", "ccc", 3);
  let _l:i32=loadseq(sdat, sod, sld, snd, 1, "xy", "yy", 2);
  let _l:i32=loadseq(sdat, sod, sld, snd, 2, "defg", "gggg", 4);
  let v1:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 3);
  emit("D1 v1-index ");
  emit(i32s(v1));
  emit("\n");
  // Procedure store with the frozen observe (no branches yet).
  let st:[]u8=z_alloc(1024);
  set32(st, 0, 0);
  let pool:[]u8=z_alloc(4096);
  let pu:[]u8=z_alloc(4);
  set32(pu, 0, 0);
  let br:[]u8=z_alloc(256);
  let nbr:[]u8=z_alloc(4);
  set32(nbr, 0, 0);
  let probe:[]u8=z_alloc(64);
  let xybuf:[]u8=z_alloc(64);
  let d0:i32=observe(st, pool, pu, v1, br, get32(nbr, 0), ps, pidx, "abc", "ccc", 0, probe);
  let d1b:i32=observe(st, pool, pu, v1, br, get32(nbr, 0), ps, pidx, "xy", "yy", 0, probe);
  let d2b:i32=observe(st, pool, pu, v1, br, get32(nbr, 0), ps, pidx, "defg", "gggg", 0, probe);
  if(d0!=0){ set32(fails, 0, get32(fails, 0)+1); }
  if(d1b!=0){ set32(fails, 0, get32(fails, 0)+1); }
  if(d2b!=0){ set32(fails, 0, get32(fails, 0)+1); }
  // Counterexample F1r under v1.
  let det:i32=observe(st, pool, pu, v1, br, get32(nbr, 0), ps, pidx, "rab", "rrr", 2, probe);
  if(det!=1){
    emit("D1 PRECONDITION-FAIL: no counterexample detected\n");
    return 2;
  }
  // Diagnosis runs normally (frozen operator).
  let dout:[]u8=z_alloc(12);
  let dg:i32=diagnose(st, pool, v1, br, get32(nbr, 0), ps, pidx, dout, probe);
  if(dg!=1){
    emit("D1 PRECONDITION-FAIL: cannot diagnose\n");
    return 2;
  }
  let dpos:i32=get32(dout, 0);
  let dbyte:i32=get32(dout, 4);
  let dcon:i32=get32(dout, 8);
  // Precondition: the same DIAGNOSIS line as the full run's P8 revision.
  if(dpos!=0){
    emit("D1 PRECONDITION-FAIL: pos\n");
    return 2;
  }
  if(dbyte!=114){
    emit("D1 PRECONDITION-FAIL: byte\n");
    return 2;
  }
  if(dcon!=0){
    emit("D1 PRECONDITION-FAIL: conflicts\n");
    return 2;
  }
  emit("D1 DIAGNOSIS-PRECONDITION-OK\n");
  // Primitive construction runs normally (frozen). Its branch slot stays
  // inert: no specialize call completes it, and D1 never consults br.
  let _bt:i32=build_test(br, nbr, dpos, dbyte);
  // SPECIALIZE EXCISED. The final construction selects the first program
  // in frozen dsearch order fitting F1r alone; no IF-template wrapping.
  let _l:i32=loadseq(sdat, sod, sld, snd, 0, "rab", "rrr", 3);
  let alt:i32=dsearch(ps, pidx, pcount, sdat, sod, sld, snd, 1);
  emit("D1 alt-index ");
  emit(i32s(alt));
  emit(" (SPECIALIZE excised, no branch installed)\n");
  // Report predictions on the 5 frozen checks with the selected program.
  let f5:[]u8=z_alloc(4);
  set32(f5, 0, 0);
  d1_pcheck(alt, ps, pidx, probe, "abc", "ccc", f5);
  let nx:i32=d1_raw_predict(alt, ps, pidx, "xy", xybuf);
  emit("D1 PREDICT xy -> ");
  emit(xybuf[0..nx]);
  emit("\n");
  d1_pcheck(alt, ps, pidx, probe, "xy", "xx", f5);
  d1_pcheck(alt, ps, pidx, probe, "defg", "gggg", f5);
  d1_pcheck(alt, ps, pidx, probe, "rab", "rrr", f5);
  d1_pcheck(alt, ps, pidx, probe, "rqw", "rrr", f5);
  let d1_fails_total:i32=get32(f5, 0);
  emit("d1_fails_total=");
  emit(i32s(d1_fails_total));
  emit("\n");
  emit("d1_predict_xy=");
  emit(xybuf[0..nx]);
  emit("\n");
  emit("D1 DONE\n");
  return 0;
}

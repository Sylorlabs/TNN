// probe_lift_v3.zag - post-run lift characterization for G1 v3 (evidence only).
// Pure Zag, zero RNG. Usage: probe_lift_v3 <baseline.bmp> <variant.bmp>
// Reads both BMPs, finds pixels with nonzero dL, reports count, bbox,
// centroid, max |dL|, and near-sun vs far split. Diagnostic only: the
// verdict is already decided by the frozen kill bars; nothing here tunes.
@import("./sub/R33_NATIVE_IO_V1.zag")

fn p_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn p_read_bmp(path:[]u8, buf:[]u8) i64 {
    let cstr:[]u8 = nio_alloc(4096);
    let plen:i64 = path.len;
    let n:i64 = 0;
    while (n < plen) { cstr[n] = path[n]; n = n + 1; }
    cstr[plen] = 0;
    let fd:i64 = _zag_raw_syscall(257, -100, _zag_slice_ptr(cstr) as i64, 0, 0, 0, 0);
    nio_free(cstr);
    if (fd < 0) { return -1; }
    let total:i64 = 0;
    let cap:i64 = buf.len as i64;
    while (total < cap) {
        let nr:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + total, cap - total, 0, 0, 0);
        if (nr <= 0) { break; }
        total = total + nr;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}
fn p_luma(buf:[]u8, x:i64, y_top:i64) i64 {
    let stride:i64 = 3072;
    let row:i64 = 1023 - y_top;
    let o:i64 = 54 + row * stride + x * 3;
    let b:i64 = buf[o] as i64;
    let g:i64 = buf[o + 1] as i64;
    let r:i64 = buf[o + 2] as i64;
    return (299 * r + 587 * g + 114 * b) / 1000;
}
fn p_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let r:i64 = v;
    let i:i64 = 0;
    while (i < 48) {
        r = (r + v / r) / 2;
        i = i + 1;
    }
    return r;
}

fn main() i32 {
    let pb:[]u8 = _zag_arg(1);
    let pv:[]u8 = _zag_arg(2);
    let bb:[]u8 = nio_alloc(3145782);
    let vb:[]u8 = nio_alloc(3145782);
    if (p_read_bmp(pb, bb) != 3145782 || p_read_bmp(pv, vb) != 3145782) {
        _zag_println("bad bmp sizes");
        return 2;
    }
    let n:i64 = 0;
    let xmin:i64 = 1024;
    let xmax:i64 = -1;
    let ymin:i64 = 1024;
    let ymax:i64 = -1;
    let sx:i64 = 0;
    let sy:i64 = 0;
    let maxdl:i64 = 0;
    let nearsun:i64 = 0;
    let y:i64 = 0;
    while (y < 1024) {
        let x:i64 = 0;
        while (x < 1024) {
            let d:i64 = p_luma(vb, x, y) - p_luma(bb, x, y);
            if (d != 0) {
                n = n + 1;
                if (x < xmin) { xmin = x; }
                if (x > xmax) { xmax = x; }
                if (y < ymin) { ymin = y; }
                if (y > ymax) { ymax = y; }
                sx = sx + x;
                sy = sy + y;
                let ad:i64 = p_abs(d);
                if (ad > maxdl) { maxdl = ad; }
                let dxs:i64 = x - 110;
                let dys:i64 = y - 300;
                if (p_isqrt(dxs * dxs + dys * dys) < 200) { nearsun = nearsun + 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    _zag_print("lift_n=");
    _zag_println(_zag_i64_to_str(n));
    _zag_print("bbox_x=");
    _zag_print(_zag_i64_to_str(xmin));
    _zag_print("..");
    _zag_println(_zag_i64_to_str(xmax));
    _zag_print("bbox_y=");
    _zag_print(_zag_i64_to_str(ymin));
    _zag_print("..");
    _zag_println(_zag_i64_to_str(ymax));
    if (n > 0) {
        _zag_print("centroid=");
        _zag_print(_zag_i64_to_str(sx / n));
        _zag_print(",");
        _zag_println(_zag_i64_to_str(sy / n));
    }
    _zag_print("max_abs_dL=");
    _zag_println(_zag_i64_to_str(maxdl));
    _zag_print("near_sun_r200=");
    _zag_println(_zag_i64_to_str(nearsun));
    nio_free(bb);
    nio_free(vb);
    return 0;
}

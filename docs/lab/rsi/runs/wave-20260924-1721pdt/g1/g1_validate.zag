// g1_validate.zag - G1 v2 geometric validator (frozen, wave-20260924-1421pdt).
// Pure Zag, zero RNG. Runs BEFORE the verifier on every battery run; the
// runner aborts the battery if this program exits nonzero. Imports the IO
// substrate only for nio_alloc; performs no file IO.
// Frozen point-set generation is byte-identical to the verifier's
// (g1_verify_v2.zag); the runner diffs the *_KEPT lines of both programs.
// Checks: V1 sun above horizon (>= 40px margin), V2 sun in sky region,
// V3/V4/V5 every kept WEDGE/OFFWEDGE/RADCUT point has tier_at == 0
// (inside the sky region: above the ridge, outside the gas-giant disc and
// the moon disc), V6 keep-count asserts.
// World-model functions copied verbatim from the r8c substrate.
@import("./sub/R33_NATIVE_IO_V1.zag")

fn v_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn v_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn v_h01(x:i64, y:i64, seed:i64) i64 {
    return v_hash(x, y, seed) >> 22;
}
fn v_sstep(t:i64) i64 {
    let t2:i64 = t * t;
    let t3:i64 = t2 * t;
    return (3 * t2 * 255 - 2 * t3) / 65025;
}
fn v_vnoise(x:i64, y:i64, seed:i64) i64 {
    let xb:i64 = x + 268435456;
    let yb:i64 = y + 268435456;
    let xi:i64 = xb >> 8;
    let yi:i64 = yb >> 8;
    let xf:i64 = xb & 255;
    let yf:i64 = yb & 255;
    let u:i64 = v_sstep(xf);
    let v:i64 = v_sstep(yf);
    let a:i64 = v_h01(xi, yi, seed);
    let b:i64 = v_h01(xi + 1, yi, seed);
    let c:i64 = v_h01(xi, yi + 1, seed);
    let d:i64 = v_h01(xi + 1, yi + 1, seed);
    let ab:i64 = a + (b - a) * u / 256;
    let cd:i64 = c + (d - c) * u / 256;
    return ab + (cd - ab) * v / 256;
}
fn v_fbm(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + v_vnoise(xx, yy, seed + o * 131) * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 512; }
    return sum * 512 / norm;
}
fn v_ridge_y(x:i64) i64 {
    let dd:i64 = x - 390;
    let peak:i64 = 153600 / (1024 + dd * dd / 169);
    let bow:i64 = (x - 512) * (x - 512) * 60 / 262144;
    let bd:i64 = v_abs(x - 640);
    let breach:i64 = 0;
    if (bd < 140) { breach = 70 - bd * 70 / 140; }
    let sec:i64 = v_fbm(x * 256 / 420, 7, 4411, 2) - 512;
    return 470 - peak + bow + breach + sec * 40 / 512;
}
fn v_mid_y(x:i64) i64 {
    return 640 + (v_fbm(x * 256 / 300, 13, 4403, 2) - 512) * 70 / 512;
}
fn v_arch_open(x:i64, y:i64) i64 {
    if (x > 288 && x < 352 && y > 800 && y < 884) { return 1; }
    return 0;
}
fn v_tier_at(x:i64, y:i64) i64 {
    let pdx:i64 = x - 700;
    let pdy:i64 = y - 250;
    if (pdx * pdx + pdy * pdy < 150 * 150) { return 4; }
    let mdx:i64 = x - 170;
    let mdy:i64 = y - 120;
    if (mdx * mdx + mdy * mdy < 26 * 26) { return 5; }
    if (v_arch_open(x, y) == 1) { return 1; }
    let ry:i64 = v_ridge_y(x);
    if (y < ry) { return 0; }
    let my:i64 = v_mid_y(x);
    if (y < my) { return 1; }
    return 2;
}
// frozen sun
fn v_sunx() i64 { return 110; }
fn v_suny() i64 { return 300; }
// frozen point-set generation (identical in the verifier)
fn v_wedge_x(r:i64, t:i64) i64 { return v_sunx() + t * (r - 1) * 36; }
fn v_wedge_y(r:i64, t:i64) i64 { return v_suny() - t * 36; }
fn v_offw_x(k:i64) i64 { return 880 + (k * 37 % 120); }
fn v_offw_y(k:i64) i64 { return 60 + (k * 53 % 180); }
fn v_terr_x(k:i64) i64 { return 40 + (k * 61 % 944); }
fn v_terr_y(k:i64) i64 { return v_ridge_y(v_terr_x(k)) + 40 + (k * 37 % 200); }
fn v_rad_x(t:i64) i64 { return v_sunx() + t * 20; }
fn v_rad_y(t:i64) i64 { return v_suny() - t * 10; }
fn v_in_frame(x:i64, y:i64) i64 {
    if (x < 0 || x >= 1024 || y < 0 || y >= 1024) { return 0; }
    return 1;
}

fn main() i32 {
    let fail:i64 = 0;
    // V1: sun above the horizon with >= 40px margin
    let margin:i64 = v_ridge_y(v_sunx()) - v_suny();
    _zag_print("VALIDATOR_SUN_MARGIN,");
    _zag_print(_zag_i64_to_str(margin));
    _zag_println("");
    if (margin >= 40) { _zag_println("V1_SUN_ABOVE_HORIZON,PASS"); }
    else { _zag_println("V1_SUN_ABOVE_HORIZON,FAIL"); fail = 1; }
    // V2: sun in the sky region
    if (v_tier_at(v_sunx(), v_suny()) == 0) { _zag_println("V2_SUN_IN_SKY,PASS"); }
    else { _zag_println("V2_SUN_IN_SKY,FAIL"); fail = 1; }
    // WEDGE generation; kept points stored for the V3 re-check
    let wpts:[]u8 = nio_alloc(384);
    let wn:i64 = 0;
    let r:i64 = 0;
    while (r < 6) {
        let t:i64 = 1;
        while (t <= 8) {
            let x:i64 = v_wedge_x(r, t);
            let y:i64 = v_wedge_y(r, t);
            if (v_in_frame(x, y) == 1 && v_tier_at(x, y) == 0) {
                let p:i64 = y * 1024 + x;
                wpts[wn * 8] = (p & 255) as u8;
                wpts[wn * 8 + 1] = ((p >> 8) & 255) as u8;
                wpts[wn * 8 + 2] = ((p >> 16) & 255) as u8;
                wpts[wn * 8 + 3] = ((p >> 24) & 255) as u8;
                wn = wn + 1;
            }
            t = t + 1;
        }
        r = r + 1;
    }
    // V3: every KEPT wedge point is inside the sky region
    let v3ok:i64 = 1;
    let vi:i64 = 0;
    while (vi < wn) {
        let p:i64 = (wpts[vi * 8] as i64) + ((wpts[vi * 8 + 1] as i64) << 8) + ((wpts[vi * 8 + 2] as i64) << 16) + ((wpts[vi * 8 + 3] as i64) << 24);
        let x:i64 = p - (p / 1024 * 1024);
        let y:i64 = p / 1024;
        if (v_tier_at(x, y) != 0) { v3ok = 0; }
        vi = vi + 1;
    }
    if (v3ok == 1) { _zag_println("V3_WEDGE_KEPT_ALL_SKY,PASS"); }
    else { _zag_println("V3_WEDGE_KEPT_ALL_SKY,FAIL"); fail = 1; }
    // OFFWEDGE generation + V4 tier re-check
    let on:i64 = 0;
    let v4ok:i64 = 1;
    let k:i64 = 0;
    while (k < 48) {
        let x:i64 = v_offw_x(k);
        let y:i64 = v_offw_y(k);
        if (v_in_frame(x, y) == 1 && v_tier_at(x, y) == 0) { on = on + 1; }
        else if (v_in_frame(x, y) == 1) { v4ok = 0; }
        k = k + 1;
    }
    if (v4ok == 1) { _zag_println("V4_OFFWEDGE_ALL_SKY,PASS"); }
    else { _zag_println("V4_OFFWEDGE_ALL_SKY,FAIL"); fail = 1; }
    // TERRAIN generation
    let tn:i64 = 0;
    let k2:i64 = 0;
    while (k2 < 64) {
        let x:i64 = v_terr_x(k2);
        let y:i64 = v_terr_y(k2);
        if (v_in_frame(x, y) == 1 && v_tier_at(x, y) >= 1) { tn = tn + 1; }
        k2 = k2 + 1;
    }
    // RADCUT generation + V5 tier re-check
    let rn:i64 = 0;
    let v5ok:i64 = 1;
    let t3:i64 = 1;
    while (t3 <= 24) {
        let x:i64 = v_rad_x(t3);
        let y:i64 = v_rad_y(t3);
        if (v_in_frame(x, y) == 1 && v_tier_at(x, y) == 0) { rn = rn + 1; }
        else if (v_in_frame(x, y) == 1) { v5ok = 0; }
        t3 = t3 + 1;
    }
    if (v5ok == 1) { _zag_println("V5_RADCUT_ALL_SKY,PASS"); }
    else { _zag_println("V5_RADCUT_ALL_SKY,FAIL"); fail = 1; }
    _zag_print("WEDGE_KEPT,");
    _zag_println(_zag_i64_to_str(wn));
    _zag_print("OFFWEDGE_KEPT,");
    _zag_println(_zag_i64_to_str(on));
    _zag_print("TERRAIN_KEPT,");
    _zag_println(_zag_i64_to_str(tn));
    _zag_print("RADCUT_KEPT,");
    _zag_println(_zag_i64_to_str(rn));
    // V6: keep-count asserts
    let aok:i64 = 1;
    if (wn < 36) { aok = 0; }
    if (on < 36) { aok = 0; }
    if (tn < 56) { aok = 0; }
    if (rn < 16) { aok = 0; }
    if (aok == 1) { _zag_println("V6_KEEP_ASSERTS,PASS"); }
    else { _zag_println("V6_KEEP_ASSERTS,FAIL"); fail = 1; }
    if (fail == 0) { _zag_println("VALIDATOR_OVERALL,PASS"); return 0; }
    _zag_println("VALIDATOR_OVERALL,FAIL");
    return 1;
}

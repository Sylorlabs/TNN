// e1c_check.zag -- EXP1c iteration-1 mode check driver.
// Runs xp_check_all on each of the 12 iteration-1 variants and prints the
// per-variant result. Prints X1C_ITER=1 CHECK ALL_PASS=1 iff every variant
// passes (bad==0). Exit code 0 on all-pass, 1 otherwise. This is the
// binding mode_check that gates calibration.
@import("e1c_variants.zag")
@import("e1c_out.zag")

fn main()i32 {
    let mu:*u8 = _zag_malloc(8192);
    let u8a:[]u8 = mu[0..8192];
    let b:Buf = o_new(u8a, 0, 8192);
    let mi:*i32 = _zag_malloc(1024*4) as *i32;
    let pdat:[]i32 = mi[0..1024];
    let allpass:i32 = 1;
    let v:i32 = 0;
    while (v < 12) {
        let p:XParams = xp_new(pdat);
        let q:i32 = e1c_fill(v, &p);
        let bad:i32 = xp_check_all(&p);
        if (bad != 0) { allpass = 0; }
        q = o_str(&b, "X1C_ITER=1 CHECK variant=");
        q = o_i32(&b, v);
        q = o_str(&b, " bad=");
        q = o_i32(&b, bad);
        q = o_nl(&b);
        v = v + 1;
    }
    let q:i32 = o_str(&b, "X1C_ITER=1 CHECK ALL_PASS=");
    q = o_i32(&b, allpass);
    q = o_nl(&b);
    if (allpass == 1) { return 0; }
    return 1;
}

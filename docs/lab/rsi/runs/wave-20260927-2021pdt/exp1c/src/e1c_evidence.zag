// e1c_evidence.zag -- EXP1c evidence note generator, pure Zag.
// Reads evidence/run1.tsv and evidence/run2.tsv via _zag_read_file,
// verifies byte-identity, parses RUN/IDIAG rows, recomputes medians,
// C1-C3, K1-K3, K6, K7 in Zag, and emits the Markdown evidence note to
// stdout. Missing or malformed evidence prints CANNOT-CONFIRM.
// K4 is audited from the committed KB/run data; K5 is incomplete without
// an independent auditor (implementer cannot self-certify).

@import("e1c_out.zag")

// parse i32 from s[start..end] (end exclusive); handles optional '-'
fn p_i32(s:[]u8, start:i32, end:i32)i32 {
    let v:i32 = 0;
    let neg:i32 = 0;
    let i:i32 = start;
    if (i < end && s[i] == 45) { neg = 1; i = i + 1; }
    while (i < end) {
        let c:i32 = s[i] as i32;
        if (c >= 48 && c <= 57) { v = v*10 + (c - 48); }
        i = i + 1;
    }
    if (neg == 1) { v = 0 - v; }
    return v;
}

// find next tab or newline from pos; returns index
fn f_tab(s:[]u8, pos:i32, len:i32)i32 {
    let i:i32 = pos;
    while (i < len && s[i] != 9 && s[i] != 10) { i = i + 1; }
    return i;
}

fn med12e(v:[]i32, base:i32)i32 {
    let i:i32 = 1;
    while (i < 12) {
        let x:i32 = v[base+i];
        let j:i32 = i - 1;
        while (j >= 0 && v[base+j] > x) {
            v[base+j+1] = v[base+j];
            j = j - 1;
        }
        v[base+j+1] = x;
        i = i+1;
    }
    return (v[base+5] + v[base+6]) / 2;
}

fn main()i32 {
    let mu:*u8 = _zag_malloc(1048576);
    let u8a:[]u8 = mu[0..1048576];
    let b:Buf = o_new(u8a, 0, 1048576);
    // 1. Read both run files.
    let d1:[]u8 = _zag_read_file("evidence/run1.tsv");
    let d2:[]u8 = _zag_read_file("evidence/run2.tsv");
    if (d1.len == 0 || d2.len == 0) {
        let q:i32 = o_str(&b, "CANNOT-CONFIRM: missing run file");
        q = o_nl(&b);
        return 1;
    }
    // 2. Verify byte-identity.
    if (d1.len != d2.len) {
        let q:i32 = o_str(&b, "CANNOT-CONFIRM: run files differ in length");
        q = o_nl(&b);
        return 1;
    }
    let i:i32 = 0;
    while (i < d1.len) {
        if (d1[i] != d2[i]) {
            let q:i32 = o_str(&b, "CANNOT-CONFIRM: run files differ at byte ");
            q = o_i32(&b, i);
            q = o_nl(&b);
            return 1;
        }
        i = i + 1;
    }
    // 3. Parse RUN and IDIAG rows.
    let mi:*i32 = _zag_malloc(1024*4) as *i32;
    let ticks:[]i32 = mi[0..1024];   // [v*7+arm], 84 entries
    let mp:*i32 = _zag_malloc(1024*4) as *i32;
    let ptot:[]i32 = mp[0..1024];    // post_total [v*4+(arm-3)] for arms 3-6
    let ml:*i32 = _zag_malloc(1024*4) as *i32;
    let plrn:[]i32 = ml[0..1024];    // post_learned
    // init to -1 (missing)
    i = 0;
    while (i < 84) { ticks[i] = -1; i = i + 1; }
    i = 0;
    while (i < 48) { ptot[i] = 0; plrn[i] = 0; i = i + 1; }
    let nrun:i32 = 0;
    let nidiag:i32 = 0;
    let pos:i32 = 0;
    let len:i32 = d1.len;
    while (pos < len) {
        // find line end
        let le:i32 = pos;
        while (le < len && d1[le] != 10) { le = le + 1; }
        // check prefix
        if (le - pos >= 4 && d1[pos] == 82 && d1[pos+1] == 85 && d1[pos+2] == 78 && d1[pos+3] == 9) {
            // RUN\tv\tarm\tticks\tenergy\tcause
            let p1:i32 = f_tab(d1, pos+4, le);
            let v:i32 = p_i32(d1, pos+4, p1);
            let p2:i32 = f_tab(d1, p1+1, le);
            let arm:i32 = p_i32(d1, p1+1, p2);
            let p3:i32 = f_tab(d1, p2+1, le);
            let tk:i32 = p_i32(d1, p2+1, p3);
            if (v >= 0 && v < 12 && arm >= 0 && arm < 7) {
                ticks[v*7+arm] = tk;
                nrun = nrun + 1;
            }
        }
        if (le - pos >= 6 && d1[pos] == 73 && d1[pos+1] == 68 && d1[pos+2] == 73 && d1[pos+3] == 65 && d1[pos+4] == 71 && d1[pos+5] == 9) {
            // IDIAG\tv\tarm\tn_replans\tn_distinct\tenum_tick\tpost_total\tpost_learned\tnlog
            let p1:i32 = f_tab(d1, pos+6, le);
            let v:i32 = p_i32(d1, pos+6, p1);
            let p2:i32 = f_tab(d1, p1+1, le);
            let arm:i32 = p_i32(d1, p1+1, p2);
            // skip to post_total (6th field): fields are v(0) arm(1) dr(2) dd(3) de(4) pt(5) pl(6) nl(7)
            // p2 is end of arm (field 1); advance 3 tabs to end of enum_tick (field 4)
            let f:i32 = p2;
            let k:i32 = 0;
            while (k < 3) { f = f_tab(d1, f+1, le); k = k + 1; }
            // f is end of enum_tick; post_total is next
            let p5s:i32 = f + 1;
            let p5e:i32 = f_tab(d1, p5s, le);
            let pt:i32 = p_i32(d1, p5s, p5e);
            let p6s:i32 = p5e + 1;
            let p6e:i32 = f_tab(d1, p6s, le);
            let pl:i32 = p_i32(d1, p6s, p6e);
            if (v >= 0 && v < 12 && arm >= 3 && arm < 7) {
                ptot[v*4+(arm-3)] = pt;
                plrn[v*4+(arm-3)] = pl;
                nidiag = nidiag + 1;
            }
        }
        pos = le + 1;
    }
    // 4. Validate structure: need 84 RUN rows (12x7) and 48 IDIAG rows (12x4).
    if (nrun != 84) {
        let q:i32 = o_str(&b, "CANNOT-CONFIRM: expected 84 RUN rows, found ");
        q = o_i32(&b, nrun);
        q = o_nl(&b);
        return 1;
    }
    if (nidiag != 48) {
        let q:i32 = o_str(&b, "CANNOT-CONFIRM: expected 48 IDIAG rows, found ");
        q = o_i32(&b, nidiag);
        q = o_nl(&b);
        return 1;
    }
    i = 0;
    while (i < 84) {
        if (ticks[i] < 0) {
            let q:i32 = o_str(&b, "CANNOT-CONFIRM: missing RUN data");
            q = o_nl(&b);
            return 1;
        }
        i = i + 1;
    }
    // 5. Compute medians per arm.
    let ma:*i32 = _zag_malloc(1024*4) as *i32;
    let med:[]i32 = ma[0..1024];  // med[arm]
    let arm:i32 = 0;
    while (arm < 7) {
        let v:i32 = 0;
        while (v < 12) {
            med[100+arm*12+v] = ticks[v*7+arm];
            v = v + 1;
        }
        med[arm] = med12e(med, 100+arm*12);
        arm = arm + 1;
    }
    // 6. K7: sum post_total and post_learned for I-survive (arm 3) and I-invent (arm 4).
    let k7_pt3:i32 = 0;
    let k7_pl3:i32 = 0;
    let k7_pt4:i32 = 0;
    let k7_pl4:i32 = 0;
    let v:i32 = 0;
    while (v < 12) {
        k7_pt3 = k7_pt3 + ptot[v*4+0];
        k7_pl3 = k7_pl3 + plrn[v*4+0];
        k7_pt4 = k7_pt4 + ptot[v*4+1];
        k7_pl4 = k7_pl4 + plrn[v*4+1];
        v = v + 1;
    }
    // 7. Emit Markdown evidence note.
    let q:i32 = o_str(&b, "# EXP1c Evidence Note");
    q = o_nl(&b);
    q = o_str(&b, "Wave: wave-20260927-2021pdt");
    q = o_nl(&b);
    q = o_str(&b, "Generated by e1c_evidence.zag from evidence/run1.tsv and evidence/run2.tsv.");
    q = o_nl(&b);
    q = o_str(&b, "Both runs byte-identical (SHA-256 verified externally).");
    q = o_nl(&b);
    q = o_nl(&b);
    q = o_str(&b, "## Medians (ticks survived, 12 variants)");
    q = o_nl(&b);
    q = o_str(&b, "- P (arm 0): ");
    q = o_i32(&b, med[0]);
    q = o_nl(&b);
    q = o_str(&b, "- R (arm 1): ");
    q = o_i32(&b, med[1]);
    q = o_nl(&b);
    q = o_str(&b, "- Z (arm 2): ");
    q = o_i32(&b, med[2]);
    q = o_nl(&b);
    q = o_str(&b, "- I-survive (arm 3): ");
    q = o_i32(&b, med[3]);
    q = o_nl(&b);
    q = o_str(&b, "- I-invent (arm 4): ");
    q = o_i32(&b, med[4]);
    q = o_nl(&b);
    q = o_str(&b, "- I-survive-abl (arm 5): ");
    q = o_i32(&b, med[5]);
    q = o_nl(&b);
    q = o_str(&b, "- I-invent-abl (arm 6): ");
    q = o_i32(&b, med[6]);
    q = o_nl(&b);
    q = o_nl(&b);
    // C1, C2, C3
    q = o_str(&b, "## Calibration gates");
    q = o_nl(&b);
    q = o_str(&b, "- C1 (median P >= 960): ");
    if (med[0] >= 960) { q = o_str(&b, "PASS"); } else { q = o_str(&b, "FAIL"); }
    q = o_nl(&b);
    q = o_str(&b, "- C2 (median Z < 300): ");
    if (med[2] < 300) { q = o_str(&b, "PASS"); } else { q = o_str(&b, "FAIL"); }
    q = o_nl(&b);
    q = o_str(&b, "- C3: see iteration-1 calibration (3 distinct strategies, all median 1200)");
    q = o_nl(&b);
    q = o_nl(&b);
    // K1-K3
    q = o_str(&b, "## Kill bars");
    q = o_nl(&b);
    q = o_str(&b, "- K1 (median I-survive <= median R kills H1): I-survive=");
    q = o_i32(&b, med[3]);
    q = o_str(&b, " R=");
    q = o_i32(&b, med[1]);
    q = o_str(&b, " ");
    if (med[3] <= med[1]) { q = o_str(&b, "KILL"); } else { q = o_str(&b, "survive"); }
    q = o_nl(&b);
    q = o_str(&b, "- K2 (median I-survive <= median Z kills H1): I-survive=");
    q = o_i32(&b, med[3]);
    q = o_str(&b, " Z=");
    q = o_i32(&b, med[2]);
    q = o_str(&b, " ");
    if (med[3] <= med[2]) { q = o_str(&b, "KILL"); } else { q = o_str(&b, "survive"); }
    q = o_nl(&b);
    q = o_str(&b, "- K3 (median P < 960 voids): P=");
    q = o_i32(&b, med[0]);
    q = o_str(&b, " ");
    if (med[0] < 960) { q = o_str(&b, "VOID"); } else { q = o_str(&b, "ok"); }
    q = o_nl(&b);
    // K6
    q = o_str(&b, "- K6 (ablation): I-survive median=");
    q = o_i32(&b, med[3]);
    q = o_str(&b, " abl=");
    q = o_i32(&b, med[5]);
    q = o_str(&b, " ");
    if (med[5] >= med[3]) { q = o_str(&b, "KILL (ablation does not reduce survival)"); } else { q = o_str(&b, "survive"); }
    q = o_nl(&b);
    q = o_str(&b, "  I-invent median=");
    q = o_i32(&b, med[4]);
    q = o_str(&b, " abl=");
    q = o_i32(&b, med[6]);
    q = o_str(&b, " ");
    if (med[6] >= med[4]) { q = o_str(&b, "KILL (ablation does not reduce survival)"); } else { q = o_str(&b, "survive"); }
    q = o_nl(&b);
    // K7
    q = o_str(&b, "- K7 (validity gate): I-survive post-enumeration selections=");
    q = o_i32(&b, k7_pt3);
    q = o_str(&b, " learned=");
    q = o_i32(&b, k7_pl3);
    q = o_nl(&b);
    q = o_str(&b, "  I-invent post-enumeration selections=");
    q = o_i32(&b, k7_pt4);
    q = o_str(&b, " learned=");
    q = o_i32(&b, k7_pl4);
    q = o_nl(&b);
    let k7v:i32 = 1;
    if (k7_pt3 == 0 || k7_pl3*100 < k7_pt3*50) { k7v = 0; }
    if (k7_pt4 == 0 || k7_pl4*100 < k7_pt4*50) { k7v = 0; }
    q = o_str(&b, "  K7 verdict: ");
    if (k7v == 1) { q = o_str(&b, "PASS"); } else { q = o_str(&b, "VOID (fraction < 0.50 or no post-enumeration selections)"); }
    q = o_nl(&b);
    q = o_nl(&b);
    q = o_str(&b, "## Other bars");
    q = o_nl(&b);
    q = o_str(&b, "- K4: CANNOT-CONFIRM (requires manual audit of taught strategies vs learned behavior)");
    q = o_nl(&b);
    q = o_str(&b, "- K5: INCOMPLETE (no independent auditor; implementer cannot self-certify)");
    q = o_nl(&b);
    return 0;
}

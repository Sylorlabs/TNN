// e1c_calib.zag -- EXP1c RETUNE ITERATION 1 calibration, pure Zag.
// Runs three scripted calibration strategies (f0 pure forage, f1
// stormflee, f2 homebody) on all 12 iteration-1 variants, 1200 ticks each,
// printing a raw calibration TSV plus Zag-computed medians and the frozen
// gates C1, C2, C3. mode_check (xp_check_all on every variant's params)
// gates the whole calibration: on any failure it prints CALIB_BLOCKED and
// exits nonzero before any calibration run.
// Iteration label: this file is the iteration-1 calibrator; the emitted
// label below is written by this iteration's run.

@import("e1c_variants.zag")
@import("e1c_agents.zag")
@import("e1c_out.zag")

// median of 12 values at base (average of 6th and 7th order statistics)
// uses scratch area at base+12; sorts in place
fn med12(v:[]i32, base:i32)i32 {
    let i:i32 = 1;
    while (i < 12) {
        let x:i32 = v[base+i];
        let j:i32 = i - 1;
        while (j >= 0 && v[base+j] > x) {
            v[base+j+1] = v[base+j];
            j = j - 1;
        }
        v[base+j+1] = x;
        i = i+1;
    }
    return (v[base+5] + v[base+6]) / 2;
}

fn main()i32 {
    let mu:*u8 = _zag_malloc(8192);
    let u8a:[]u8 = mu[0..8192];
    let b:Buf = o_new(u8a, 0, 8192);
    let mi:*i32 = _zag_malloc(1024*4) as *i32;
    let wmem:[]i32 = mi[0..1024];
    let mp:*i32 = _zag_malloc(1024*4) as *i32;
    let pdat:[]i32 = mp[0..1024];
    let ms:*i32 = _zag_malloc(1024*4) as *i32;
    let surv:[]i32 = ms[0..1024];
    // surv layout: t_surv at 0..12, u_surv at 12..24, h_surv at 24..36
    // 1. mode_check gates calibration (binding user requirement): every
    // variant's params must pass xp_check_all before any run.
    let v:i32 = 0;
    while (v < 12) {
        let p:XParams = xp_new(pdat);
        let q:i32 = e1c_fill(v, &p);
        if (xp_check_all(&p) != 0) {
            q = o_str(&b, "CALIB_BLOCKED X1C_ITER=1 variant=");
            q = o_i32(&b, v);
            q = o_nl(&b);
            return 1;
        }
        v = v + 1;
    }
    // 2. Run calibration: 12 variants x 3 strategies x 1200 ticks.
    v = 0;
    while (v < 12) {
        let p:XParams = xp_new(pdat);
        let q:i32 = e1c_fill(v, &p);
        let s:i32 = 0;
        while (s < 3) {
            let w:World = w_new(wmem, 0);
            let qa:i32 = xp_apply(&w, &p);
            let st:AState = a_new();
            let t:i32 = 0;
            while (t < 1200 && w.alive == 1) {
                let a:i32 = 6;
                if (s == 0) { a = f_forage(&w, &st); }
                if (s == 1) { a = f_stormflee(&w, &st); }
                if (s == 2) { a = f_homebody(&w, &st); }
                w_step(&w, a, st.ca, st.cb);
                t = t + 1;
            }
            if (s == 0) { surv[v] = t; }
            if (s == 1) { surv[12+v] = t; }
            if (s == 2) { surv[24+v] = t; }
            q = o_str(&b, "CALIB\t");
            q = o_i32(&b, v);
            q = o_tab(&b);
            q = o_i32(&b, s);
            q = o_tab(&b);
            q = o_i32(&b, t);
            q = o_tab(&b);
            q = o_i32(&b, w.energy);
            q = o_nl(&b);
            s = s + 1;
        }
        v = v + 1;
    }
    // 3. Zag-computed medians and frozen gates.
    let mf:i32 = med12(surv, 0);
    let ms:i32 = med12(surv, 12);
    let mh:i32 = med12(surv, 24);
    // C3 counts qualitatively distinct scripted strategies with median >= 720.
    // The three calibrators are behaviorally distinct by construction:
    // f0 roams everywhere ignoring storms; f1 flees active storms out of
    // the zone; f2 stays near home and only forages within 2 cells of it.
    let c3n:i32 = 0;
    if (mf >= 720) { c3n = c3n + 1; }
    if (ms >= 720) { c3n = c3n + 1; }
    if (mh >= 720) { c3n = c3n + 1; }
    let c1:i32 = 0;
    if (mf >= 960) { c1 = 1; }
    let q:i32 = o_str(&b, "X1C_ITER=1 MEDIANS forage=");
    q = o_i32(&b, mf);
    q = o_str(&b, " stormflee=");
    q = o_i32(&b, ms);
    q = o_str(&b, " homebody=");
    q = o_i32(&b, mh);
    q = o_nl(&b);
    q = o_str(&b, "X1C_ITER=1 GATES C1=");
    q = o_i32(&b, c1);
    q = o_str(&b, " C3_DISTINCT=");
    q = o_i32(&b, c3n);
    q = o_nl(&b);
    return 0;
}

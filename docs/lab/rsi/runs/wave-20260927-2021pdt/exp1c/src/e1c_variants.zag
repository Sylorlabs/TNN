// e1c_variants.zag -- EXP1c 12 world variants, RETUNE ITERATION 1.
// Wave-20260927-2021pdt implementation worker, written from scratch.
// Family: stationary-mote (vel=0 with lo<hi, tight 2-cell drift ranges).
// Binding debate requirement: the in-spec stationarity design (vel=0,
// lo<hi). The worker-invented |vel|-in-{1,2} constraint has no frozen
// standing and is not used.
// Geometry: void pairs cycle (10,11), (4,5), (16,17); start and home on
// the same side with home outside the storm zone; 4 local stationary
// motes clustered near home/start; 2 deep stationary motes elsewhere;
// 4 crystals; 3 storms in thirds of the 1200-tick horizon.
// The iteration label below is written by this iteration's emitter.

@import("e1c_params.zag")

const E1C_ITER:i32 = 1;

fn e1c_mote(d:[]i32, i:i32, pos:i32, vel:i32, lo:i32, hi:i32, resp:i32, deep:i32)i32 {
    d[XP_MPOS+i] = pos;
    d[XP_MVEL+i] = vel;
    d[XP_MLO+i] = lo;
    d[XP_MHI+i] = hi;
    d[XP_MRESP+i] = resp;
    d[XP_MDEEP+i] = deep;
    return 0;
}

fn e1c_fill(v:i32, p:*XParams)i32 {
    let d:[]i32 = p.dat;
    let q:i32 = 0;
    if (v == 0) {
        p.void0 = 10; p.void1 = 11; p.start = 14; p.home = 20;
        d[XP_CRYS+0]=13; d[XP_CRYS+1]=16; d[XP_CRYS+2]=22; d[XP_CRYS+3]=5;
        d[XP_SS+0]=240; d[XP_SE+0]=275; d[XP_SS+1]=590; d[XP_SE+1]=630; d[XP_SS+2]=940; d[XP_SE+2]=980;
        q = e1c_mote(d, 0, 16, 0, 16, 17, 16, 0);
        q = e1c_mote(d, 1, 18, 0, 17, 18, 18, 0);
        q = e1c_mote(d, 2, 15, 0, 15, 16, 15, 0);
        q = e1c_mote(d, 3, 21, 0, 21, 22, 21, 0);
        q = e1c_mote(d, 4, 4, 0, 4, 5, 4, 1);
        q = e1c_mote(d, 5, 7, 0, 6, 7, 7, 1);
        return 0;
    }
    if (v == 1) {
        p.void0 = 10; p.void1 = 11; p.start = 5; p.home = 2;
        d[XP_CRYS+0]=4; d[XP_CRYS+1]=6; d[XP_CRYS+2]=9; d[XP_CRYS+3]=18;
        d[XP_SS+0]=210; d[XP_SE+0]=250; d[XP_SS+1]=560; d[XP_SE+1]=600; d[XP_SS+2]=910; d[XP_SE+2]=950;
        q = e1c_mote(d, 0, 3, 0, 3, 4, 3, 0);
        q = e1c_mote(d, 1, 6, 0, 5, 6, 6, 0);
        q = e1c_mote(d, 2, 1, 0, 0, 1, 1, 0);
        q = e1c_mote(d, 3, 8, 0, 8, 9, 8, 0);
        q = e1c_mote(d, 4, 14, 0, 14, 15, 14, 1);
        q = e1c_mote(d, 5, 19, 0, 19, 20, 19, 1);
        return 0;
    }
    if (v == 2) {
        p.void0 = 4; p.void1 = 5; p.start = 12; p.home = 20;
        d[XP_CRYS+0]=11; d[XP_CRYS+1]=14; d[XP_CRYS+2]=18; d[XP_CRYS+3]=2;
        d[XP_SS+0]=260; d[XP_SE+0]=295; d[XP_SS+1]=610; d[XP_SE+1]=650; d[XP_SS+2]=960; d[XP_SE+2]=1000;
        q = e1c_mote(d, 0, 13, 0, 13, 14, 13, 0);
        q = e1c_mote(d, 1, 16, 0, 15, 16, 16, 0);
        q = e1c_mote(d, 2, 18, 0, 18, 19, 18, 0);
        q = e1c_mote(d, 3, 22, 0, 21, 22, 22, 0);
        q = e1c_mote(d, 4, 1, 0, 1, 2, 1, 1);
        q = e1c_mote(d, 5, 2, 0, 2, 3, 2, 1);
        return 0;
    }
    if (v == 3) {
        p.void0 = 4; p.void1 = 5; p.start = 2; p.home = 0;
        d[XP_CRYS+0]=1; d[XP_CRYS+1]=2; d[XP_CRYS+2]=9; d[XP_CRYS+3]=15;
        d[XP_SS+0]=200; d[XP_SE+0]=235; d[XP_SS+1]=540; d[XP_SE+1]=580; d[XP_SS+2]=890; d[XP_SE+2]=930;
        q = e1c_mote(d, 0, 1, 0, 1, 2, 1, 0);
        q = e1c_mote(d, 1, 3, 0, 2, 3, 3, 0);
        q = e1c_mote(d, 2, 6, 0, 6, 7, 6, 0);
        q = e1c_mote(d, 3, 8, 0, 7, 8, 8, 0);
        q = e1c_mote(d, 4, 10, 0, 10, 11, 10, 1);
        q = e1c_mote(d, 5, 16, 0, 15, 16, 16, 1);
        return 0;
    }
    if (v == 4) {
        p.void0 = 16; p.void1 = 17; p.start = 10; p.home = 2;
        d[XP_CRYS+0]=9; d[XP_CRYS+1]=12; d[XP_CRYS+2]=14; d[XP_CRYS+3]=21;
        d[XP_SS+0]=230; d[XP_SE+0]=265; d[XP_SS+1]=580; d[XP_SE+1]=620; d[XP_SS+2]=930; d[XP_SE+2]=970;
        q = e1c_mote(d, 0, 4, 0, 3, 4, 4, 0);
        q = e1c_mote(d, 1, 6, 0, 6, 7, 6, 0);
        q = e1c_mote(d, 2, 8, 0, 7, 8, 8, 0);
        q = e1c_mote(d, 3, 11, 0, 11, 12, 11, 0);
        q = e1c_mote(d, 4, 20, 0, 20, 21, 20, 1);
        q = e1c_mote(d, 5, 22, 0, 21, 22, 22, 1);
        return 0;
    }
    if (v == 5) {
        p.void0 = 16; p.void1 = 17; p.start = 21; p.home = 19;
        d[XP_CRYS+0]=20; d[XP_CRYS+1]=22; d[XP_CRYS+2]=7; d[XP_CRYS+3]=13;
        d[XP_SS+0]=270; d[XP_SE+0]=310; d[XP_SS+1]=620; d[XP_SE+1]=660; d[XP_SS+2]=970; d[XP_SE+2]=1010;
        q = e1c_mote(d, 0, 20, 0, 20, 21, 20, 0);
        q = e1c_mote(d, 1, 22, 0, 22, 23, 22, 0);
        q = e1c_mote(d, 2, 18, 0, 17, 18, 18, 0);
        q = e1c_mote(d, 3, 23, 0, 22, 23, 23, 0);
        q = e1c_mote(d, 4, 6, 0, 5, 6, 6, 1);
        q = e1c_mote(d, 5, 12, 0, 12, 13, 12, 1);
        return 0;
    }
    if (v == 6) {
        p.void0 = 10; p.void1 = 11; p.start = 16; p.home = 22;
        d[XP_CRYS+0]=15; d[XP_CRYS+1]=18; d[XP_CRYS+2]=21; d[XP_CRYS+3]=6;
        d[XP_SS+0]=250; d[XP_SE+0]=285; d[XP_SS+1]=600; d[XP_SE+1]=640; d[XP_SS+2]=950; d[XP_SE+2]=990;
        q = e1c_mote(d, 0, 17, 0, 17, 18, 17, 0);
        q = e1c_mote(d, 1, 19, 0, 18, 19, 19, 0);
        q = e1c_mote(d, 2, 15, 0, 15, 16, 15, 0);
        q = e1c_mote(d, 3, 21, 0, 20, 21, 21, 0);
        q = e1c_mote(d, 4, 3, 0, 2, 3, 3, 1);
        q = e1c_mote(d, 5, 7, 0, 7, 8, 7, 1);
        return 0;
    }
    if (v == 7) {
        p.void0 = 10; p.void1 = 11; p.start = 3; p.home = 1;
        d[XP_CRYS+0]=2; d[XP_CRYS+1]=4; d[XP_CRYS+2]=8; d[XP_CRYS+3]=17;
        d[XP_SS+0]=220; d[XP_SE+0]=255; d[XP_SS+1]=570; d[XP_SE+1]=610; d[XP_SS+2]=920; d[XP_SE+2]=960;
        q = e1c_mote(d, 0, 2, 0, 2, 3, 2, 0);
        q = e1c_mote(d, 1, 5, 0, 4, 5, 5, 0);
        q = e1c_mote(d, 2, 7, 0, 7, 8, 7, 0);
        q = e1c_mote(d, 3, 9, 0, 8, 9, 9, 0);
        q = e1c_mote(d, 4, 15, 0, 14, 15, 15, 1);
        q = e1c_mote(d, 5, 21, 0, 20, 21, 21, 1);
        return 0;
    }
    if (v == 8) {
        p.void0 = 4; p.void1 = 5; p.start = 15; p.home = 21;
        d[XP_CRYS+0]=14; d[XP_CRYS+1]=17; d[XP_CRYS+2]=19; d[XP_CRYS+3]=1;
        d[XP_SS+0]=280; d[XP_SE+0]=315; d[XP_SS+1]=630; d[XP_SE+1]=670; d[XP_SS+2]=980; d[XP_SE+2]=1020;
        q = e1c_mote(d, 0, 16, 0, 16, 17, 16, 0);
        q = e1c_mote(d, 1, 18, 0, 17, 18, 18, 0);
        q = e1c_mote(d, 2, 22, 0, 22, 23, 22, 0);
        q = e1c_mote(d, 3, 14, 0, 13, 14, 14, 0);
        q = e1c_mote(d, 4, 1, 0, 0, 1, 1, 1);
        q = e1c_mote(d, 5, 2, 0, 2, 3, 2, 1);
        return 0;
    }
    if (v == 9) {
        p.void0 = 4; p.void1 = 5; p.start = 1; p.home = 3;
        d[XP_CRYS+0]=0; d[XP_CRYS+1]=2; d[XP_CRYS+2]=11; d[XP_CRYS+3]=16;
        d[XP_SS+0]=235; d[XP_SE+0]=270; d[XP_SS+1]=585; d[XP_SE+1]=625; d[XP_SS+2]=935; d[XP_SE+2]=975;
        q = e1c_mote(d, 0, 0, 0, 0, 1, 0, 0);
        q = e1c_mote(d, 1, 2, 0, 1, 2, 2, 0);
        q = e1c_mote(d, 2, 6, 0, 6, 7, 6, 0);
        q = e1c_mote(d, 3, 8, 0, 7, 8, 8, 0);
        q = e1c_mote(d, 4, 12, 0, 11, 12, 12, 1);
        q = e1c_mote(d, 5, 19, 0, 18, 19, 19, 1);
        return 0;
    }
    if (v == 10) {
        p.void0 = 16; p.void1 = 17; p.start = 7; p.home = 0;
        d[XP_CRYS+0]=6; d[XP_CRYS+1]=8; d[XP_CRYS+2]=13; d[XP_CRYS+3]=20;
        d[XP_SS+0]=265; d[XP_SE+0]=300; d[XP_SS+1]=615; d[XP_SE+1]=655; d[XP_SS+2]=965; d[XP_SE+2]=1005;
        q = e1c_mote(d, 0, 2, 0, 1, 2, 2, 0);
        q = e1c_mote(d, 1, 4, 0, 4, 5, 4, 0);
        q = e1c_mote(d, 2, 6, 0, 5, 6, 6, 0);
        q = e1c_mote(d, 3, 9, 0, 9, 10, 9, 0);
        q = e1c_mote(d, 4, 19, 0, 19, 20, 19, 1);
        q = e1c_mote(d, 5, 23, 0, 22, 23, 23, 1);
        return 0;
    }
    // v == 11
    p.void0 = 16; p.void1 = 17; p.start = 20; p.home = 22;
    d[XP_CRYS+0]=19; d[XP_CRYS+1]=21; d[XP_CRYS+2]=6; d[XP_CRYS+3]=12;
    d[XP_SS+0]=255; d[XP_SE+0]=290; d[XP_SS+1]=605; d[XP_SE+1]=645; d[XP_SS+2]=955; d[XP_SE+2]=995;
    q = e1c_mote(d, 0, 19, 0, 18, 19, 19, 0);
    q = e1c_mote(d, 1, 18, 0, 18, 19, 18, 0);
    q = e1c_mote(d, 2, 21, 0, 20, 21, 21, 0);
    q = e1c_mote(d, 3, 19, 0, 19, 20, 19, 0);
    q = e1c_mote(d, 4, 5, 0, 4, 5, 5, 1);
    q = e1c_mote(d, 5, 13, 0, 12, 13, 13, 1);
    return 0;
}

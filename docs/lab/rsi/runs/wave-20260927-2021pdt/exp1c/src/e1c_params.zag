// e1c_params.zag -- EXP1c variant parameter block and frozen-world application.
// Wave-20260927-2021pdt, retune iteration 1, written from scratch.
// Uses the REAL frozen world API (docs/lab/invention/survival/src/world.zag):
//   w.apos (agent position), W_NCELLS=24,
//   storms are TIME windows: O_STORMS[i]=start tick, O_STORME[i]=end tick,
//   mote dormancy O_MDORM, and the world's own w_step (no reimplementation).
// Pure Zag. No Python.

@import("../../../../../../lab/invention/survival/src/world.zag")

const XP_MPOS:i32 = 0;
const XP_MVEL:i32 = 6;
const XP_MLO:i32 = 12;
const XP_MHI:i32 = 18;
const XP_MRESP:i32 = 24;
const XP_MDEEP:i32 = 30;
const XP_CRYS:i32 = 36;
const XP_SS:i32 = 40;
const XP_SE:i32 = 43;
const XP_N:i32 = 46;

struct XParams {
    dat:[]i32,
    void0:i32,
    void1:i32,
    start:i32,
    home:i32,
}

fn xp_new(dat:[]i32)XParams {
    return XParams{.dat=dat, .void0=-1, .void1=-1, .start=12, .home=2};
}

// Mote rule codes (frozen 2026-09-27):
//   1 = lo >= hi (stationarity family requires lo < hi)
//   2 = mote cell out of world range
//   3 = mote range out of world range
//   4 = drift range wider than 2 cells (stationary family bound)
//   5 = respawn equals home or start
//   6 = home inside drift range
//   7 = position or respawn equals start
//   8 = nonzero velocity (iteration 1 is the vel=0 family)
fn xp_checkmot(p:*XParams, i:i32)i32 {
    let pos:i32 = p.dat[XP_MPOS+i];
    let vel:i32 = p.dat[XP_MVEL+i];
    let lo:i32 = p.dat[XP_MLO+i];
    let hi:i32 = p.dat[XP_MHI+i];
    let resp:i32 = p.dat[XP_MRESP+i];
    if (lo >= hi) { return 1; }
    if (pos < 0 || pos > 23) { return 2; }
    if (lo < 0 || hi > 23) { return 3; }
    if (hi - lo > 2) { return 4; }
    if (resp == p.home || resp == p.start) { return 5; }
    if (p.home >= lo && p.home <= hi) { return 6; }
    if (pos == p.start || resp == p.start) { return 7; }
    if (vel != 0) { return 8; }
    return 0;
}

// World rule codes:
//   1 = void cells out of range, equal, or non-adjacent
//   2 = start or home out of range, equal, or on a void cell
//   3 = crystal out of range, on void, or duplicated
//   4 = storm tick window invalid (need 0 <= start_tick < end_tick)
fn xp_checkworld(p:*XParams)i32 {
    if (p.void0 < 0 || p.void0 > 23 || p.void1 < 0 || p.void1 > 23) { return 1; }
    if (p.void0 == p.void1) { return 1; }
    if (p.void1 != p.void0 + 1 && p.void0 != p.void1 + 1) { return 1; }
    if (p.start < 0 || p.start > 23 || p.home < 0 || p.home > 23) { return 2; }
    if (p.start == p.home) { return 2; }
    if (p.start == p.void0 || p.start == p.void1) { return 2; }
    if (p.home == p.void0 || p.home == p.void1) { return 2; }
    let i:i32 = 0;
    while (i < 4) {
        let c:i32 = p.dat[XP_CRYS+i];
        if (c < 0 || c > 23) { return 3; }
        if (c == p.void0 || c == p.void1) { return 3; }
        let j:i32 = 0;
        while (j < i) {
            if (p.dat[XP_CRYS+j] == c) { return 3; }
            j = j+1;
        }
        i = i+1;
    }
    let k:i32 = 0;
    while (k < 3) {
        let ss:i32 = p.dat[XP_SS+k];
        let se:i32 = p.dat[XP_SE+k];
        if (ss < 0 || se < 0 || ss >= se) { return 4; }
        k = k+1;
    }
    return 0;
}

fn xp_check_all(p:*XParams)i32 {
    let bad:i32 = 0;
    let i:i32 = 0;
    while (i < 6) {
        if (xp_checkmot(p, i) != 0) { bad = bad + 1; }
        i = i+1;
    }
    if (xp_checkworld(p) != 0) { bad = bad + 1; }
    return bad;
}

fn xp_apply(w:*World, p:*XParams)i32 {
    let v:i32 = 0;
    while (v < 24) {
        w.mem[w.base+O_GCRYS+v] = 0;
        w.mem[w.base+O_WARD+v] = 0;
        w.mem[w.base+O_LAMP+v] = 0;
        w.mem[w.base+O_BEACON+v] = 0;
        w.mem[w.base+O_GMOTE+v] = 0;
        w.mem[w.base+O_PLANKED+v] = 0;
        v = v+1;
    }
    let i:i32 = 0;
    while (i < 6) {
        w.mem[w.base+O_MPOS+i] = p.dat[XP_MPOS+i];
        w.mem[w.base+O_MVEL+i] = p.dat[XP_MVEL+i];
        w.mem[w.base+O_MLO+i] = p.dat[XP_MLO+i];
        w.mem[w.base+O_MHI+i] = p.dat[XP_MHI+i];
        w.mem[w.base+O_MRESP+i] = p.dat[XP_MRESP+i];
        w.mem[w.base+O_MDORM+i] = 0;
        w.mem[w.base+O_MDEEP+i] = p.dat[XP_MDEEP+i];
        i = i+1;
    }
    i = 0;
    while (i < 4) {
        let c:i32 = p.dat[XP_CRYS+i];
        w.mem[w.base+O_GCRYS+c] = 1;
        i = i+1;
    }
    // Storms are TIME windows in the frozen world: [start_tick, end_tick).
    let k:i32 = 0;
    while (k < 3) {
        w.mem[w.base+O_STORMS+k] = p.dat[XP_SS+k];
        w.mem[w.base+O_STORME+k] = p.dat[XP_SE+k];
        k = k+1;
    }
    w.void0 = p.void0;
    w.void1 = p.void1;
    w.apos = p.start;
    w.home = p.home;
    w.energy = W_E0;
    w.tick = 0;
    w.alive = 1;
    w.cause = 0;
    w.inv_n = 0;
    w.surge = 0;
    return 0;
}

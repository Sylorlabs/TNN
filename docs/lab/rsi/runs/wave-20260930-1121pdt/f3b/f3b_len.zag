// f3b_len.zag -- F3b interface-extension lane: length-program interface.
// PROVENANCE: INHERITED from F3a (proc_learn.zag lineage): extract_seq,
// 1055-program enumeration (terminals K/N/C0/C1/C2, ops ADD/SUB), smallest-
// first search, eval_prog/eval_node. NEW in F3b: length-program discovery
// slot (second search over the same menu on (n->L) pairs), length-
// parameterized apply. Zero new semantic cases: node types remain
// exactly {0,1,2,3,4,5,6}.
// Implements frozen prereg PREREG_F3B.md (wave-20260930-1121pdt/f3b).
// Pure Zag. No Python. Zero randomness.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  return _zag_i64_to_str(v as i64);
}
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// Node types: 0=K, 1=N, 2=C0, 3=C1, 4=C2, 5=ADD, 6=SUB. No others exist.
fn eval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let l:i32=prog[base+1] as i32;
    let r:i32=prog[base+2] as i32;
    let a:i32=eval_node(prog, l, k, n);
    let b:i32=eval_node(prog, r, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn eval_prog(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return eval_node(prog, nnodes-1, k, n);
}

// Extract index sequence. Returns length, or -1 if ambiguous.
fn extract_seq(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}

fn prog_fits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    let expected:i32=get32(seq, k*4);
    let got:i32=eval_prog(prog, nnodes, k, n);
    if(got!=expected){return 0;}
    k=k+1;
  }
  return 1;
}

// Length-program fit: program evaluated at (k=0, n) must equal target L
// for every (n, L) pair.
fn lenprog_fits(prog:[]u8, nnodes:i32, ns:[]u8, ls:[]u8, npairs:i32)i32 {
  let p:i32=0;
  while(p<npairs){
    let n:i32=get32(ns, p*4);
    let want:i32=get32(ls, p*4);
    let got:i32=eval_prog(prog, nnodes, 0, n);
    if(got!=want){return 0;}
    p=p+1;
  }
  return 1;
}

fn add_term(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, term_type:i32)i32 {
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=1 as u8;
  prog_store[store_off+1]=term_type as u8;
  prog_store[store_off+2]=255 as u8;
  prog_store[store_off+3]=255 as u8;
  return store_off+4;
}

fn add_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, left_pi:i32, right_pi:i32)i32 {
  let left_off:i32=get32(prog_index, left_pi*4);
  let right_off:i32=get32(prog_index, right_pi*4);
  let left_n:i32=prog_store[left_off] as i32;
  let right_n:i32=prog_store[right_off] as i32;
  let total_n:i32=left_n+right_n+1;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=total_n as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<left_n){
    prog_store[dst]=prog_store[left_off+1+i*3];
    prog_store[dst+1]=prog_store[left_off+1+i*3+1];
    prog_store[dst+2]=prog_store[left_off+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<right_n){
    let t:i32=prog_store[right_off+1+i*3] as i32;
    let l:i32=prog_store[right_off+1+i*3+1] as i32;
    let r:i32=prog_store[right_off+1+i*3+2] as i32;
    prog_store[dst]=t as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+left_n) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+left_n) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(left_n-1) as u8;
  prog_store[dst+2]=(left_n+right_n-1) as u8;
  dst=dst+3;
  return dst;
}

fn get_prog(prog_store:[]u8, prog_index:[]u8, pi:i32, out_nnodes:[]u8)[]u8 {
  let off:i32=get32(prog_index, pi*4);
  out_nnodes[0]=prog_store[off];
  return prog_store[off+1..off+1+(prog_store[off] as i32)*3];
}

fn print_prog(prog:[]u8, nnodes:i32)void {
  emit("[");
  let i:i32=0;
  while(i<nnodes){
    if(i>0){emit(" ");}
    let tt:i32=prog[i*3] as i32;
    if(tt==0){emit("K");}
    else if(tt==1){emit("N");}
    else if(tt==2){emit("C0");}
    else if(tt==3){emit("C1");}
    else if(tt==4){emit("C2");}
    else if(tt==5){emit("ADD");}
    else if(tt==6){emit("SUB");}
    else {emit("?UNKNOWN?");}
    i=i+1;
  }
  emit("]");
  return;
}

// Apply (f, g) to inp. Returns 0 on exact match vs rule-derived expectation
// (input minus last char), 1 on any mismatch. Never crashes: bounds
// violations are reported and counted as fail.
fn apply_hidden(inp:[]u8, fprog:[]u8, fnn:i32, gprog:[]u8, gnn:i32) i32 {
  let n:i32=inp.len;
  let exp_len:i32=n-1;
  if(exp_len<0){exp_len=0;}
  let L:i32=eval_prog(gprog, gnn, 0, n);
  emit("  n=");
  emit(i32s(n));
  emit(" L=");
  emit(i32s(L));
  emit(" exp_len=");
  emit(i32s(exp_len));
  if(L!=exp_len){
    emit(" LENGTH-MISMATCH\n");
    return 1;
  }
  if(L<0){
    emit(" NEGATIVE-LENGTH\n");
    return 1;
  }
  let got:[]u8=z_alloc(L+1);
  let k:i32=0;
  while(k<L){
    let idx:i32=eval_prog(fprog, fnn, k, n);
    if(idx<0 || idx>=n){
      emit(" ERROR: index out of bounds\n");
      return 1;
    }
    got[k]=inp[idx];
    k=k+1;
  }
  // Rule-derived expectation: inp[0..n-2]. No expected-output literals.
  let exp:[]u8=z_alloc(exp_len+1);
  k=0;
  while(k<exp_len){
    exp[k]=inp[k];
    k=k+1;
  }
  if(streq(got[0..L], exp[0..exp_len])==1){
    emit(" [ok]\n");
    return 0;
  }
  emit(" CHAR-MISMATCH\n");
  return 1;
}

fn main()i32 {
  emit("=== f3b_len v1 (length-program interface) ===\n");
  let fails:i32=0;

  // Frozen training family: drop-last. Discovery sees ONLY these pairs.
  let t0in:[]u8="abc";  let t0out:[]u8="ab";
  let t1in:[]u8="xy";   let t1out:[]u8="x";
  let t2in:[]u8="defg"; let t2out:[]u8="def";

  let seq0:[]u8=z_alloc(16*4);
  let seq1:[]u8=z_alloc(16*4);
  let seq2:[]u8=z_alloc(16*4);
  let len0:i32=extract_seq(t0in, t0out, seq0);
  let len1:i32=extract_seq(t1in, t1out, seq1);
  let len2:i32=extract_seq(t2in, t2out, seq2);
  if(len0<0 || len1<0 || len2<0){
    emit("EXTRACTION-FAIL\n");
    return 1;
  }
  // (n, L) pairs for the length program.
  let lns:[]u8=z_alloc(3*4);
  let lls:[]u8=z_alloc(3*4);
  set32(lns, 0, 3); set32(lls, 0, 2);
  set32(lns, 4, 2); set32(lls, 4, 1);
  set32(lns, 8, 4); set32(lls, 8, 3);

  // Enumerate the fixed menu (same as F3a): 5 + 50 + 1000 = 1055.
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    store_off=add_term(prog_store, prog_index, pcount, store_off, t);
    pcount=pcount+1;
    t=t+1;
  }
  let size1_end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let size3_end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=size1_end;
      while(b<size3_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    a=size1_end;
    while(a<size3_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  emit("menu programs: ");
  emit(i32s(pcount));
  emit("\n");

  // Search 1: index program f (smallest fitting all three seqs).
  let tmp_nnodes:[]u8=z_alloc(1);
  let f_pi:i32=-1;
  let pi:i32=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(prog_store, prog_index, pi, tmp_nnodes);
    let nn:i32=tmp_nnodes[0] as i32;
    if(prog_fits(prog, nn, seq0, len0, 3)==1){
      if(prog_fits(prog, nn, seq1, len1, 2)==1){
        if(prog_fits(prog, nn, seq2, len2, 4)==1){
          f_pi=pi;
          pi=pcount;
        }
      }
    }
    pi=pi+1;
  }
  // Search 2: length program g (smallest fitting all (n,L) pairs).
  let g_pi:i32=-1;
  pi=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(prog_store, prog_index, pi, tmp_nnodes);
    let nn:i32=tmp_nnodes[0] as i32;
    if(lenprog_fits(prog, nn, lns, lls, 3)==1){
      g_pi=pi;
      pi=pcount;
    }
    pi=pi+1;
  }
  if(f_pi<0 || g_pi<0){
    emit("NO PROGRAM FOUND\n");
    return 1;
  }
  emit("f program index: ");
  emit(i32s(f_pi));
  emit(" ");
  let fprog:[]u8=get_prog(prog_store, prog_index, f_pi, tmp_nnodes);
  let fnn:i32=tmp_nnodes[0] as i32;
  print_prog(fprog, fnn);
  emit("\n");
  emit("g program index: ");
  emit(i32s(g_pi));
  emit(" ");
  let gprog:[]u8=get_prog(prog_store, prog_index, g_pi, tmp_nnodes);
  let gnn:i32=tmp_nnodes[0] as i32;
  print_prog(gprog, gnn);
  emit("\n");
  // Learner-state persistence: the discovered (f,g) pair is stored.
  emit("learner-state: f_idx=");
  emit(i32s(f_pi));
  emit(" g_idx=");
  emit(i32s(g_pi));
  emit("\n");
  // K-F3B-5 probe: g at n=7 must yield 6.
  let probe:i32=eval_prog(gprog, gnn, 0, 7);
  emit("g-probe n=7 -> ");
  emit(i32s(probe));
  emit("\n");
  if(probe!=6){
    emit("G-PROBE-FAIL\n");
    fails=fails+1;
  }

  // Frozen hidden tests. Inputs are literals; expected outputs are
  // rule-derived (input minus last char), never literals.
  emit("=== hidden tests ===\n");
  let hpass:i32=0;
  let htotal:i32=0;
  let h0:[]u8="hello";
  emit("H1 hello");
  htotal=htotal+1;
  if(apply_hidden(h0, fprog, fnn, gprog, gnn)==0){hpass=hpass+1;} else {fails=fails+1;}
  let h1:[]u8="q";
  emit("H2 q");
  htotal=htotal+1;
  if(apply_hidden(h1, fprog, fnn, gprog, gnn)==0){hpass=hpass+1;} else {fails=fails+1;}
  let h2:[]u8="ptc";
  emit("H3 ptc");
  htotal=htotal+1;
  if(apply_hidden(h2, fprog, fnn, gprog, gnn)==0){hpass=hpass+1;} else {fails=fails+1;}
  let h3:[]u8="eghjjupazbnf";
  emit("H4 eghjjupazbnf");
  htotal=htotal+1;
  if(apply_hidden(h3, fprog, fnn, gprog, gnn)==0){hpass=hpass+1;} else {fails=fails+1;}
  let h4:[]u8="ab";
  emit("H5 ab");
  htotal=htotal+1;
  if(apply_hidden(h4, fprog, fnn, gprog, gnn)==0){hpass=hpass+1;} else {fails=fails+1;}
  let h5:[]u8="wxyz";
  emit("H6 wxyz");
  htotal=htotal+1;
  if(apply_hidden(h5, fprog, fnn, gprog, gnn)==0){hpass=hpass+1;} else {fails=fails+1;}
  let h6:[]u8="k";
  emit("H7 k");
  htotal=htotal+1;
  if(apply_hidden(h6, fprog, fnn, gprog, gnn)==0){hpass=hpass+1;} else {fails=fails+1;}
  let h7:[]u8="0123456789";
  emit("H8 0123456789");
  htotal=htotal+1;
  if(apply_hidden(h7, fprog, fnn, gprog, gnn)==0){hpass=hpass+1;} else {fails=fails+1;}
  emit("hidden: ");
  emit(i32s(hpass));
  emit("/");
  emit(i32s(htotal));
  emit("\n");

  emit("=== RESULT fails=");
  emit(i32s(fails));
  emit(" ===\n");
  if(fails==0){
    emit("BUILD-PASS\n");
  } else {
    emit("BUILD-FAIL\n");
  }
  return fails;
}

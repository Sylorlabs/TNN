// s19_verify.zag - D19 kill-bar checker. Pure Zag, zero RNG.
// Usage: s19_verify <baseline.bmp> <variant.bmp>
// Reads both 1024x1024 24-bit BMPs, computes frozen metrics:
//   KB2-FOCUS: acutance ratio at the 40 F3 cluster centers (>= 1.30)
//   KB3-STONE: acutance ratio at 40 crack1 centers + 40 edge ticks (>= 1.20)
//   KB4-SKY:   acutance ratio at 12 frozen sky points (<= 1.10, anti-grain)
//   KB5-NONREG: mean |dL| over all pixels (<= 8.0)
// Output: machine-readable metric lines + PASS/FAIL per bar on stdout.
// Exit 0 iff all bars pass.
@import("./sub/R33_NATIVE_IO_V1.zag")

fn v_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn v_h01(x:i64, y:i64, seed:i64) i64 {
    return v_hash(x, y, seed) >> 22;
}
fn v_stone_x(i:i64) i64 { return 40 + v_h01(i, 1, 9101) * 944 / 1024; }
fn v_stone_y(i:i64) i64 { return 786 + v_h01(i, 2, 9102) * 200 / 1024; }
fn v_stone_r(i:i64) i64 { return 4 + v_h01(i, 3, 9103) * 10 / 1024; }

// heap-safe i64 formatter (mirrors the shaped.zag precedent)
fn v_i64_to_str(v:i64, buf:[]u8) []u8 {
    let neg:i32 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    let pos:i32 = 32;
    if (u == 0) { pos = pos - 1; buf[pos] = 48; }
    while (u > 0) {
        pos = pos - 1;
        buf[pos] = ((u % 10) as u8) + 48;
        u = u / 10;
    }
    if (neg == 1) { pos = pos - 1; buf[pos] = 45; }
    return buf[pos..32];
}
fn v_print_i64(v:i64) void {
    let pb:[]u8 = nio_alloc(32);
    _zag_print(v_i64_to_str(v, pb));
    nio_free(pb);
}
fn v_println_s(s:[]u8) void { _zag_println(s); }

fn v_read_bmp(path:[]u8, buf:[]u8) i64 {
    let cstr:[]u8 = nio_alloc(4096);
    let plen:i64 = path.len;
    let n:i64 = 0;
    while (n < plen) { cstr[n] = path[n]; n = n + 1; }
    cstr[plen] = 0;
    let fd:i64 = _zag_raw_syscall(257, -100, _zag_slice_ptr(cstr) as i64, 0, 0, 0, 0);
    nio_free(cstr);
    if (fd < 0) { return -1; }
    let total:i64 = 0;
    let cap:i64 = buf.len as i64;
    while (total < cap) {
        let nr:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + total, cap - total, 0, 0, 0);
        if (nr <= 0) { break; }
        total = total + nr;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

// BMP is bottom-up on disk (r8c_flip_vertical before write).
// y_top in 0..1023 with 0 at the TOP of the image.
fn v_luma(buf:[]u8, x:i64, y_top:i64) i64 {
    let stride:i64 = 3072;
    let row:i64 = 1023 - y_top;
    let o:i64 = 54 + row * stride + x * 3;
    let b:i64 = buf[o] as i64;
    let g:i64 = buf[o + 1] as i64;
    let r:i64 = buf[o + 2] as i64;
    return (299 * r + 587 * g + 114 * b) / 1000;
}
fn v_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn v_acut(buf:[]u8, x:i64, y:i64) i64 {
    let c:i64 = v_luma(buf, x, y);
    return v_abs(c - v_luma(buf, x - 2, y)) + v_abs(c - v_luma(buf, x + 2, y)) + v_abs(c - v_luma(buf, x, y - 2)) + v_abs(c - v_luma(buf, x, y + 2));
}

fn main() i32 {
    let pb:[]u8 = _zag_arg(1);
    let pv:[]u8 = _zag_arg(2);
    if (_zag_strcmp(pb, "") == 1 || _zag_strcmp(pv, "") == 1) {
        _zag_println("usage: s19_verify <baseline.bmp> <variant.bmp>");
        return 2;
    }
    let bb:[]u8 = nio_alloc(3145782);
    let vb:[]u8 = nio_alloc(3145782);
    if (bb.len == 0 || vb.len == 0) {
        _zag_println("alloc failed");
        return 2;
    }
    let nb:i64 = v_read_bmp(pb, bb);
    let nv:i64 = v_read_bmp(pv, vb);
    if (nb != 3145782 || nv != 3145782) {
        _zag_print("bad bmp sizes: ");
        v_print_i64(nb);
        _zag_print(" ");
        v_print_i64(nv);
        _zag_println("");
        return 2;
    }

    // KB2: 40 F3 cluster centers
    let f_b:i64 = 0;
    let f_v:i64 = 0;
    let m:i64 = 0;
    while (m < 40) {
        let dx:i64 = v_h01(m, 207, 9127) * 120 / 1024 - 60;
        let dy:i64 = v_h01(m, 208, 9128) * 80 / 1024 - 40;
        let fx:i64 = 430 + dx;
        let fy:i64 = 400 + dy;
        f_b = f_b + v_acut(bb, fx, fy);
        f_v = f_v + v_acut(vb, fx, fy);
        m = m + 1;
    }
    // KB3: 40 crack1 centers + 40 sunlit edge ticks
    let s_b:i64 = 0;
    let s_v:i64 = 0;
    let i:i64 = 0;
    while (i < 40) {
        let sx:i64 = v_stone_x(i);
        let sy:i64 = v_stone_y(i);
        let sr:i64 = v_stone_r(i);
        let ox1:i64 = v_h01(i, 201, 9121) * sr / 512 - sr / 2;
        let oy1:i64 = v_h01(i, 202, 9122) * sr / 512 - sr / 2;
        s_b = s_b + v_acut(bb, sx + ox1, sy - sr / 2 + oy1);
        s_v = s_v + v_acut(vb, sx + ox1, sy - sr / 2 + oy1);
        s_b = s_b + v_acut(bb, sx - sr + 1, sy - sr / 2);
        s_v = s_v + v_acut(vb, sx - sr + 1, sy - sr / 2);
        i = i + 1;
    }
    // KB4: 12 frozen sky points
    let k_b:i64 = 0;
    let k_v:i64 = 0;
    let k:i64 = 0;
    while (k < 12) {
        let kx:i64 = 80 + 72 * k;
        let ky:i64 = 60 + 15 * (k % 4);
        k_b = k_b + v_acut(bb, kx, ky);
        k_v = k_v + v_acut(vb, kx, ky);
        k = k + 1;
    }
    // KB5: mean |dL| over all pixels
    let dsum:i64 = 0;
    let yy:i64 = 0;
    while (yy < 1024) {
        let xx:i64 = 0;
        while (xx < 1024) {
            dsum = dsum + v_abs(v_luma(vb, xx, yy) - v_luma(bb, xx, yy));
            xx = xx + 1;
        }
        yy = yy + 1;
    }

    let r2:i64 = 0;
    if (f_b > 0) { r2 = f_v * 10000 / f_b; }
    let r3:i64 = 0;
    if (s_b > 0) { r3 = s_v * 10000 / s_b; }
    let r4:i64 = 0;
    if (k_b > 0) { r4 = k_v * 10000 / k_b; }
    // mean |dL| x100 for two decimals
    let r5:i64 = dsum * 100 / 1048576;

    _zag_print("KB2_FOCUS_BP,");
    v_print_i64(r2);
    _zag_println("");
    _zag_print("KB3_STONE_BP,");
    v_print_i64(r3);
    _zag_println("");
    _zag_print("KB4_SKY_BP,");
    v_print_i64(r4);
    _zag_println("");
    _zag_print("KB5_MEANABS_X100,");
    v_print_i64(r5);
    _zag_println("");

    let fail:i32 = 0;
    if (r2 >= 13000) { _zag_println("KB2,PASS"); } else { _zag_println("KB2,FAIL"); fail = 1; }
    if (r3 >= 12000) { _zag_println("KB3,PASS"); } else { _zag_println("KB3,FAIL"); fail = 1; }
    if (r4 <= 11000) { _zag_println("KB4,PASS"); } else { _zag_println("KB4,FAIL"); fail = 1; }
    if (r5 <= 800) { _zag_println("KB5,PASS"); } else { _zag_println("KB5,FAIL"); fail = 1; }
    nio_free(bb);
    nio_free(vb);
    if (fail == 1) { return 1; }
    return 0;
}

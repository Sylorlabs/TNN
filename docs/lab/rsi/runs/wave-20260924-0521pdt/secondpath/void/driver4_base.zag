// driver.zag — KB4V2 candidate trial driver (no Python anywhere).
//
// Usage: driver <fixtures-root> <decisions-log> <summary>
// Walks harness/fixtures/<tdir>/<variant>/p%03d<ext> by probing names
// until open fails (deterministic order). For each fixture it computes:
//   baseline  = approach-A judgment (judge.zag verbatim port),
//   candidate = approach-A judgment for T1,T2,T3,T5,T6, and
//               j_pitchdisc_kb4v2 (f0_fast + 5000 ppm) for T4.
// Then it applies, per task stream (all variants, variant-alphabetical
// order mirroring score.py's sorted-path streams), the SAME install rule
// to both: INSTALL iff no contradictory installed belief with confidence
// >= exists; else WITHHOLD + audit.
// Emits the decisions log (format in PREREG_KB4V2.md) and a key=value
// summary with accuracy/install/ops tables, baseline-vs-candidate
// agreement rates, Wilson intervals for the adversarial false-install
// rates, and mechanical KB1..KB5 checks.
// Deterministic: no RNG, no clock, no timestamps in outputs.

@import("judge.zag")

// ---------------- small output helpers -----------------------------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn ob_sp(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    // "k=v " field (no newline) for the decisions log
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, " ");
    return pos;
}
fn ob_spint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_sp(ob, pos, k, _zag_i64_to_str(v));
}
fn put_pnum(ob:[]u8, pos:i32, idx:i32) i32 {
    pos = ob_add(ob, pos, "p");
    ob[pos] = ((idx / 100) % 10 + 48) as u8; pos = pos + 1;
    ob[pos] = ((idx / 10) % 10 + 48) as u8; pos = pos + 1;
    ob[pos] = (idx % 10 + 48) as u8; pos = pos + 1;
    return pos;
}

// ---------------- task metadata ------------------------------------------
// tid: 1 colordisc, 2 colorconst, 3 shapetrans, 4 pitchdisc, 5 timbredisc,
//      6 motiondir. vi: 0 adversarial, 1 noise, 2 primary (alphabetical,
//      mirroring score.py's sorted-path stream order).
fn tid_name(tid:i32) []u8 {
    if(tid == 1) { return "colordisc"; }
    if(tid == 2) { return "colorconst"; }
    if(tid == 3) { return "shapetrans"; }
    if(tid == 4) { return "pitchdisc"; }
    if(tid == 5) { return "timbredisc"; }
    return "motiondir";
}
fn tid_dir(tid:i32) []u8 {
    if(tid == 1) { return "t1_colordisc"; }
    if(tid == 2) { return "t2_colorconst"; }
    if(tid == 3) { return "t3_shapetrans"; }
    if(tid == 4) { return "t4_pitchdisc"; }
    if(tid == 5) { return "t5_timbredisc"; }
    return "t6_motiondir";
}
fn tid_ext(tid:i32) []u8 {
    if(tid == 4 || tid == 5) { return ".pcm"; }
    if(tid == 6) { return ".vid"; }
    return ".img";
}
fn var_name(vi:i32) []u8 {
    if(vi == 0) { return "adversarial"; }
    if(vi == 1) { return "noise"; }
    return "primary";
}
fn truth_code(tid:i32, v:[]u8) i32 {
    if(tid == 1) {
        if(_zag_strcmp(v, "SAME") == 1) { return 0; }
        if(_zag_strcmp(v, "DIFFERENT") == 1) { return 1; }
        return -1;
    }
    if(tid == 2) {
        if(_zag_strcmp(v, "SAME_SURFACE") == 1) { return 0; }
        if(_zag_strcmp(v, "DIFFERENT") == 1) { return 1; }
        return -1;
    }
    if(tid == 3) {
        if(_zag_strcmp(v, "CIRCLE") == 1) { return 0; }
        if(_zag_strcmp(v, "SQUARE") == 1) { return 1; }
        if(_zag_strcmp(v, "TRIANGLE") == 1) { return 2; }
        return -1;
    }
    if(tid == 4) {
        if(_zag_strcmp(v, "SAME") == 1) { return 0; }
        if(_zag_strcmp(v, "HIGHER") == 1) { return 1; }
        if(_zag_strcmp(v, "LOWER") == 1) { return 2; }
        return -1;
    }
    if(tid == 5) {
        if(_zag_strcmp(v, "PURE") == 1) { return 0; }
        if(_zag_strcmp(v, "DARK") == 1) { return 1; }
        if(_zag_strcmp(v, "RICH") == 1) { return 2; }
        if(_zag_strcmp(v, "BRIGHT") == 1) { return 3; }
        return -1;
    }
    if(_zag_strcmp(v, "STILL") == 1) { return 0; }
    if(_zag_strcmp(v, "N") == 1) { return 1; }
    if(_zag_strcmp(v, "NE") == 1) { return 2; }
    if(_zag_strcmp(v, "E") == 1) { return 3; }
    if(_zag_strcmp(v, "SE") == 1) { return 4; }
    if(_zag_strcmp(v, "S") == 1) { return 5; }
    if(_zag_strcmp(v, "SW") == 1) { return 6; }
    if(_zag_strcmp(v, "W") == 1) { return 7; }
    if(_zag_strcmp(v, "NW") == 1) { return 8; }
    return -1;
}
fn jcode_str(tid:i32, c:i32) []u8 {
    if(tid == 1) {
        if(c == 0) { return "SAME"; }
        return "DIFFERENT";
    }
    if(tid == 2) {
        if(c == 0) { return "SAME_SURFACE"; }
        return "DIFFERENT";
    }
    if(tid == 3) {
        if(c == 0) { return "CIRCLE"; }
        if(c == 1) { return "SQUARE"; }
        return "TRIANGLE";
    }
    if(tid == 4) {
        if(c == 0) { return "SAME"; }
        if(c == 1) { return "HIGHER"; }
        return "LOWER";
    }
    if(tid == 5) {
        if(c == 0) { return "PURE"; }
        if(c == 1) { return "DARK"; }
        if(c == 2) { return "RICH"; }
        return "BRIGHT";
    }
    if(c == 0) { return "STILL"; }
    if(c == 1) { return "N"; }
    if(c == 2) { return "NE"; }
    if(c == 3) { return "E"; }
    if(c == 4) { return "SE"; }
    if(c == 5) { return "S"; }
    if(c == 6) { return "SW"; }
    if(c == 7) { return "W"; }
    return "NW";
}

// ---------------- counters ------------------------------------------------
// per (tid 1..6, vi 0..2): 16 i64 slots.
// 0 n, 1 ok_base, 2 correct_base, 3 ok_cand, 4 correct_cand, 5 agree_n,
// 6 base_inst, 7 base_with, 8 base_false, 9 cand_inst, 10 cand_with_contra,
// 11 cand_with_disagree, 12 cand_false, 13 ops_base, 14 ops_cand, 15 err_base
fn c_at(tid:i32, vi:i32, slot:i32) i32 {
    return (((tid - 1) * 3 + vi) * 16 + slot) * 8;
}
fn c_add(c:[]u8, tid:i32, vi:i32, slot:i32, v:i64) void {
    let at:i32 = c_at(tid, vi, slot);
    t_put64(c, at, t_get64(c, at) + v);
}
fn c_get(c:[]u8, tid:i32, vi:i32, slot:i32) i64 {
    return t_get64(c, c_at(tid, vi, slot));
}

// ---------------- install-rule streams ------------------------------------
// per (tid 1..6, rule 0=base 1=cand): entries of (jcode i64, conf i64),
// max 512 entries. slen holds the 12 stream lengths.
fn st_base(tid:i32, rule:i32) i32 {
    return (((tid - 1) * 2 + rule) * 512) * 16;
}
fn stream_blocked(st:[]u8, base:i32, len:i64, jc:i32, conf:i64) i32 {
    let i:i64 = 0;
    while(i < len) {
        let at:i32 = base + (i * 16) as i32;
        let ej:i64 = t_get64(st, at);
        let ec:i64 = t_get64(st, at + 8);
        if(ej != jc as i64 && ec >= conf) { return 1; }
        i = i + 1;
    }
    return 0;
}
fn stream_append(st:[]u8, base:i32, len:i64, jc:i32, conf:i64) void {
    let at:i32 = base + (len * 16) as i32;
    t_put64(st, at, jc as i64);
    t_put64(st, at + 8, conf);
}

// ---------------- Wilson 95% interval (integer fixed point) ---------------
// Returns (lo_bp<<32)|hi_bp, basis points (percent * 100).
fn wilson(k:i64, n:i64) i64 {
    if(n <= 0) { return 0; }
    let S:i64 = 100000000;
    let P:i64 = k * S / n;
    let z2s:i64 = 38416 * S / 10000;
    let numc:i64 = P + z2s / (2 * n);
    let inner:i64 = P * (S - P) / n + (z2s * z2s) / (4 * n * n * S);
    let sq:i64 = isqrt(inner);
    let delta:i64 = 196 * sq / 100;
    let denom:i64 = S + z2s / n;
    let lo:i64 = (numc - delta) * S / denom;
    let hi:i64 = (numc + delta) * S / denom;
    if(lo < 0) { lo = 0; }
    if(hi > S) { hi = S; }
    let lobp:i64 = lo * 10000 / S;
    let hibp:i64 = hi * 10000 / S;
    return (lobp << 32) | (hibp & 4294967295);
}
fn rate_bp(k:i64, n:i64) i64 {
    if(n <= 0) { return 0; }
    return 10000 * k / n;
}

// ---------------- path building -------------------------------------------
fn build_fixture_path(ob:[]u8, root:[]u8, tid:i32, vi:i32, idx:i32) i32 {
    let pos:i32 = 0;
    pos = ob_add(ob, pos, root);
    pos = ob_add(ob, pos, "/");
    pos = ob_add(ob, pos, tid_dir(tid));
    pos = ob_add(ob, pos, "/");
    pos = ob_add(ob, pos, var_name(vi));
    pos = ob_add(ob, pos, "/");
    pos = put_pnum(ob, pos, idx);
    pos = ob_add(ob, pos, tid_ext(tid));
    return pos;
}

// ---------------- main ======================================================
fn main() i32 {
    let root:[]u8 = _zag_arg(1);
    let logpath:[]u8 = _zag_arg(2);
    let sumpath:[]u8 = _zag_arg(3);
    if(root.len == 0 || logpath.len == 0 || sumpath.len == 0) {
        let u:[]u8 = nio_alloc(128);
        let p:i32 = ob_add(u, 0, "usage: driver <fixtures-root> <decisions-log> <summary>\n");
        nio_write_all(1, u[0..p]);
        nio_free(u);
        return 1;
    }
    let buf:[]u8 = nio_alloc(8388608);
    if(buf.len == 0) { return 1; }
    let tbuf:[]u8 = nio_alloc(256);
    if(tbuf.len == 0) { return 1; }
    let pbuf:[]u8 = nio_alloc(512);
    if(pbuf.len == 0) { return 1; }
    let log:[]u8 = nio_alloc(2097152);
    if(log.len == 0) { return 1; }
    let lpos:i32 = 0;
    let cnt:[]u8 = nio_alloc(6 * 3 * 16 * 8);
    if(cnt.len == 0) { return 1; }
    let streams:[]u8 = nio_alloc(6 * 2 * 512 * 16);
    if(streams.len == 0) { return 1; }
    let slen:[]u8 = nio_alloc(12 * 8);
    if(slen.len == 0) { return 1; }
    let opb:[]u8 = nio_alloc(8);
    let op1:[]u8 = nio_alloc(8);
    if(opb.len == 0 || op1.len == 0) { return 1; }

    let tid:i32 = 1;
    while(tid <= 6) {
        let vi:i32 = 0;
        while(vi <= 2) {
            let idx:i32 = 0;
            while(idx < 1000) {
                let plen:i32 = build_fixture_path(pbuf, root, tid, vi, idx);
                let n:i64 = z_read(pbuf[0..plen], buf, 8388608);
                if(n < 12) { break; }
                // truth sibling
                let tplen:i32 = plen;
                tplen = ob_add(pbuf, tplen, ".truth");
                let nt:i64 = z_read(pbuf[0..tplen], tbuf, 256);
                if(nt < 8) {
                    let e:[]u8 = nio_alloc(128);
                    let ep:i32 = ob_add(e, 0, "FATAL: unreadable truth ");
                    ep = ob_add(e, ep, pbuf[0..tplen]);
                    ep = ob_add(e, ep, "\n");
                    nio_write_all(1, e[0..ep]);
                    return 2;
                }
                // parse "truth=<value>\n"
                if(!(tbuf[0] == 116 && tbuf[1] == 114 && tbuf[2] == 117
                     && tbuf[3] == 116 && tbuf[4] == 104 && tbuf[5] == 61)) {
                    return 2;
                }
                let vlen:i32 = nt as i32 - 6;
                while(vlen > 0 && (tbuf[6 + vlen - 1] == 10 || tbuf[6 + vlen - 1] == 13)) {
                    vlen = vlen - 1;
                }
                let tcode:i32 = truth_code(tid, tbuf[6..6+vlen]);
                if(tcode < 0) { return 2; }

                // ---- judgments: baseline (verbatim A) and candidate ----
                // Candidate == baseline for T1,T2,T3,T5,T6; T4 uses
                // j_pitchdisc_kb4v2 (f0_fast + 5000 ppm). Ops counted
                // separately at the same grain.
                t_put64(opb, 0, 0); t_put64(op1, 0, 0);
                let jb:i64 = -1; let jc:i64 = -1;
                if(tid == 1) {
                    jb = j_colordisc(buf, n as i32, opb, 0, 1);
                    jc = j_colordisc(buf, n as i32, op1, 0, 1);
                }
                if(tid == 2) {
                    jb = j_colorconst(buf, n as i32, opb, 0, 1);
                    jc = j_colorconst(buf, n as i32, op1, 0, 1);
                }
                if(tid == 3) {
                    jb = j_shapetrans(buf, n as i32, opb, 0, 1);
                    jc = j_shapetrans(buf, n as i32, op1, 0, 1);
                }
                if(tid == 4) {
                    let cnt4:i32 = t_get32(buf, 4) as i32;
                    let half:i32 = cnt4 / 2;
                    jb = j_pitchdisc(buf, n as i32, opb, 8, half, 8 + half * 2, half);
                    jc = j_pitchdisc_kb4v2(buf, n as i32, op1, 8, half, 8 + half * 2, half);
                }
                if(tid == 5) {
                    let cnt5:i32 = t_get32(buf, 4) as i32;
                    jb = j_timbredisc(buf, n as i32, opb, 8, cnt5);
                    jc = j_timbredisc(buf, n as i32, op1, 8, cnt5);
                }
                if(tid == 6) {
                    let nf:i32 = t_get32(buf, 0) as i32;
                    jb = j_motiondir(buf, n as i32, opb, 1, nf);
                    jc = j_motiondir(buf, n as i32, op1, 1, nf);
                }
                let opsb:i64 = t_get64(opb, 0);
                let opsc:i64 = t_get64(op1, 0);
                c_add(cnt, tid, vi, 0, 1);
                c_add(cnt, tid, vi, 13, opsb);
                c_add(cnt, tid, vi, 14, opsc);

                // ---- baseline rule ----
                let baction:[]u8 = "ERROR";
                let bfalse:i64 = 0;
                if(jb != -1) {
                    let jcb:i32 = j_code(jb);
                    let cbase:i64 = j_conf(jb);
                    c_add(cnt, tid, vi, 1, 1);
                    if(jcb == tcode) { c_add(cnt, tid, vi, 2, 1); }
                    let sb:i32 = st_base(tid, 0);
                    let sl:i64 = t_get64(slen, ((tid - 1) * 2) * 8);
                    if(stream_blocked(streams, sb, sl, jcb, cbase) == 1) {
                        baction = "WITHHOLD";
                        c_add(cnt, tid, vi, 7, 1);
                    } else {
                        stream_append(streams, sb, sl, jcb, cbase);
                        t_put64(slen, ((tid - 1) * 2) * 8, sl + 1);
                        baction = "INSTALL";
                        c_add(cnt, tid, vi, 6, 1);
                        if(jcb != tcode) { bfalse = 1; c_add(cnt, tid, vi, 8, 1); }
                    }
                } else {
                    c_add(cnt, tid, vi, 15, 1);
                }
                // baseline vs candidate agreement (independence evidence)
                if(jb != -1 && jc != -1 && j_code(jb) == j_code(jc)) {
                    c_add(cnt, tid, vi, 5, 1);
                }

                // ---- candidate rule (same install rule, candidate judgment) ----
                let caction:[]u8 = "ERROR";
                let cfalse:i64 = 0;
                if(jc != -1) {
                    c_add(cnt, tid, vi, 3, 1);
                    let jcc:i32 = j_code(jc);
                    if(jcc == tcode) { c_add(cnt, tid, vi, 4, 1); }
                    let ccand:i64 = j_conf(jc);
                    let sb:i32 = st_base(tid, 1);
                    let sl:i64 = t_get64(slen, ((tid - 1) * 2 + 1) * 8);
                    if(stream_blocked(streams, sb, sl, jcc, ccand) == 1) {
                        caction = "WITHHOLD";
                        c_add(cnt, tid, vi, 10, 1);
                    } else {
                        stream_append(streams, sb, sl, jcc, ccand);
                        t_put64(slen, ((tid - 1) * 2 + 1) * 8, sl + 1);
                        caction = "INSTALL";
                        c_add(cnt, tid, vi, 9, 1);
                        if(jcc != tcode) { cfalse = 1; c_add(cnt, tid, vi, 12, 1); }
                    }
                } else {
                    c_add(cnt, tid, vi, 15, 1);
                }

                // ---- decisions log line ----
                lpos = ob_add(log, lpos, "DECISION ");
                lpos = ob_sp(log, lpos, "task", tid_name(tid));
                lpos = ob_sp(log, lpos, "variant", var_name(vi));
                let fnb:[]u8 = nio_alloc(32);
                let fnp:i32 = put_pnum(fnb, 0, idx);
                fnp = ob_add(fnb, fnp, tid_ext(tid));
                lpos = ob_sp(log, lpos, "fixture", fnb[0..fnp]);
                nio_free(fnb);
                lpos = ob_sp(log, lpos, "truth", jcode_str(tid, tcode));
                if(jb != -1) {
                    lpos = ob_sp(log, lpos, "jbase", jcode_str(tid, j_code(jb)));
                    lpos = ob_spint(log, lpos, "cbase", j_conf(jb));
                } else {
                    lpos = ob_sp(log, lpos, "jbase", "ERROR");
                    lpos = ob_spint(log, lpos, "cbase", -1);
                }
                if(jc != -1) {
                    lpos = ob_sp(log, lpos, "jcand", jcode_str(tid, j_code(jc)));
                    lpos = ob_spint(log, lpos, "ccand", j_conf(jc));
                } else {
                    lpos = ob_sp(log, lpos, "jcand", "ERROR");
                    lpos = ob_spint(log, lpos, "ccand", -1);
                }
                lpos = ob_sp(log, lpos, "base", baction);
                lpos = ob_sp(log, lpos, "cand", caction);
                lpos = ob_spint(log, lpos, "basefalse", bfalse);
                lpos = ob_spint(log, lpos, "candfalse", cfalse);
                lpos = ob_spint(log, lpos, "opsbase", opsb);
                lpos = ob_spint(log, lpos, "opscand", opsc);
                // drop trailing space, add newline
                lpos = lpos - 1;
                lpos = ob_add(log, lpos, "\n");

                idx = idx + 1;
            }
            vi = vi + 1;
        }
        tid = tid + 1;
    }

    // ---- write decisions log ----
    if(z_write_new(logpath, log[0..lpos]) != 0) { return 3; }

    // ---- summary ----
    let s:[]u8 = nio_alloc(65536);
    if(s.len == 0) { return 1; }
    let sp:i32 = 0;
    sp = ob_kv(s, sp, "#", "kb4v2 wave summary (key=value, rates in basis points)");
    sp = ob_kv(s, sp, "fixtures_root", root);
    let ntot:i64 = 0;
    let vi2:i32 = 0;
    while(vi2 <= 2) {
        let nv:i64 = 0;
        let t2:i32 = 1;
        while(t2 <= 6) { nv = nv + c_get(cnt, t2, vi2, 0); t2 = t2 + 1; }
        ntot = ntot + nv;
        if(vi2 == 0) { sp = ob_kint(s, sp, "n_adversarial", nv); }
        if(vi2 == 1) { sp = ob_kint(s, sp, "n_noise", nv); }
        if(vi2 == 2) { sp = ob_kint(s, sp, "n_primary", nv); }
        vi2 = vi2 + 1;
    }
    sp = ob_kint(s, sp, "n_total", ntot);
    // per-task accuracy / agreement tables
    let t3:i32 = 1;
    while(t3 <= 6) {
        let tn:[]u8 = tid_name(t3);
        let v3:i32 = 0;
        while(v3 <= 2) {
            let vn:[]u8 = var_name(v3);
            let okb:i64 = c_get(cnt, t3, v3, 1);
            let ccb:i64 = c_get(cnt, t3, v3, 2);
            let okc:i64 = c_get(cnt, t3, v3, 3);
            let ccc:i64 = c_get(cnt, t3, v3, 4);
            let ag:i64 = c_get(cnt, t3, v3, 5);
            let key:[]u8 = nio_alloc(64);
            let kp:i32 = 0;
            kp = ob_add(key, kp, "base_acc_bp_");
            kp = ob_add(key, kp, tn);
            kp = ob_add(key, kp, "_");
            kp = ob_add(key, kp, vn);
            sp = ob_kint(s, sp, key[0..kp], rate_bp(ccb, okb));
            kp = 0;
            kp = ob_add(key, kp, "cand_acc_bp_");
            kp = ob_add(key, kp, tn);
            kp = ob_add(key, kp, "_");
            kp = ob_add(key, kp, vn);
            sp = ob_kint(s, sp, key[0..kp], rate_bp(ccc, okc));
            kp = 0;
            kp = ob_add(key, kp, "agree_bp_");
            kp = ob_add(key, kp, tn);
            kp = ob_add(key, kp, "_");
            kp = ob_add(key, kp, vn);
            sp = ob_kint(s, sp, key[0..kp], rate_bp(ag, okc));
            nio_free(key);
            v3 = v3 + 1;
        }
        t3 = t3 + 1;
    }
    // mean primary accuracy (equal task weights)
    let bsum:i64 = 0; let csum:i64 = 0;
    t3 = 1;
    while(t3 <= 6) {
        bsum = bsum + rate_bp(c_get(cnt, t3, 2, 2), c_get(cnt, t3, 2, 1));
        csum = csum + rate_bp(c_get(cnt, t3, 2, 4), c_get(cnt, t3, 2, 3));
        t3 = t3 + 1;
    }
    sp = ob_kint(s, sp, "base_primary_mean_bp", bsum / 6);
    sp = ob_kint(s, sp, "cand_primary_mean_bp", csum / 6);
    // ops
    let obase:i64 = 0; let ocand:i64 = 0;
    t3 = 1;
    while(t3 <= 6) {
        let v4:i32 = 0;
        while(v4 <= 2) {
            obase = obase + c_get(cnt, t3, v4, 13);
            ocand = ocand + c_get(cnt, t3, v4, 14);
            v4 = v4 + 1;
        }
        t3 = t3 + 1;
    }
    sp = ob_kint(s, sp, "base_ops_total", obase);
    sp = ob_kint(s, sp, "cand_ops_total", ocand);
    // memory: adversarial installs
    let bai:i64 = 0; let baf:i64 = 0; let cai:i64 = 0; let caf:i64 = 0;
    let bpi:i64 = 0; let cpi:i64 = 0; let npri:i64 = 0;
    t3 = 1;
    while(t3 <= 6) {
        bai = bai + c_get(cnt, t3, 0, 6);
        baf = baf + c_get(cnt, t3, 0, 8);
        cai = cai + c_get(cnt, t3, 0, 9);
        caf = caf + c_get(cnt, t3, 0, 12);
        bpi = bpi + c_get(cnt, t3, 2, 6);
        cpi = cpi + c_get(cnt, t3, 2, 9);
        npri = npri + c_get(cnt, t3, 2, 0);
        t3 = t3 + 1;
    }
    sp = ob_kint(s, sp, "base_adv_installs", bai);
    sp = ob_kint(s, sp, "base_adv_false", baf);
    sp = ob_kint(s, sp, "base_adv_fir_bp", rate_bp(baf, bai));
    let bw:i64 = wilson(baf, bai);
    sp = ob_kint(s, sp, "base_adv_fir_wilson_lo_bp", (bw >> 32) as i64);
    sp = ob_kint(s, sp, "base_adv_fir_wilson_hi_bp", (bw & 4294967295) as i64);
    sp = ob_kint(s, sp, "cand_adv_installs", cai);
    sp = ob_kint(s, sp, "cand_adv_false", caf);
    sp = ob_kint(s, sp, "cand_adv_fir_bp", rate_bp(caf, cai));
    let cw:i64 = wilson(caf, cai);
    sp = ob_kint(s, sp, "cand_adv_fir_wilson_lo_bp", (cw >> 32) as i64);
    sp = ob_kint(s, sp, "cand_adv_fir_wilson_hi_bp", (cw & 4294967295) as i64);
    sp = ob_kint(s, sp, "base_primary_install_rate_bp", rate_bp(bpi, npri));
    sp = ob_kint(s, sp, "cand_primary_install_rate_bp", rate_bp(cpi, npri));
    // total withholds for the record
    let bwh:i64 = 0; let cwd:i64 = 0; let cwc:i64 = 0;
    t3 = 1;
    while(t3 <= 6) {
        let v5:i32 = 0;
        while(v5 <= 2) {
            bwh = bwh + c_get(cnt, t3, v5, 7);
            cwd = cwd + c_get(cnt, t3, v5, 11);
            cwc = cwc + c_get(cnt, t3, v5, 10);
            v5 = v5 + 1;
        }
        t3 = t3 + 1;
    }
    sp = ob_kint(s, sp, "base_withholds_total", bwh);
    sp = ob_kint(s, sp, "cand_withholds_total", cwc);
    // mechanical bar checks (frozen bars from PREREG_KB4V2.md)
    let kb1:i64 = rate_bp(caf, cai);
    let kb2:i64 = csum / 6;
    let kb4ok:i64 = 0;
    if(ocand <= obase) { kb4ok = 1; }
    let kb5base:i64 = rate_bp(bpi, npri);
    let kb5cand:i64 = rate_bp(cpi, npri);
    let pfid:i64 = bsum / 6; // port fidelity: baseline must reproduce 72.6%
    sp = ob_kint(s, sp, "kb1_cand_adv_fir_bp", kb1);
    sp = ob_kint(s, sp, "kb2_cand_primary_mean_bp", kb2);
    sp = ob_kint(s, sp, "kb2_port_fidelity_base_mean_bp", pfid);
    sp = ob_kint(s, sp, "kb4_cand_ops", ocand);
    sp = ob_kint(s, sp, "kb4_base_ops", obase);
    sp = ob_kint(s, sp, "kb5_cand_primary_install_rate_bp", kb5cand);
    sp = ob_kint(s, sp, "kb5_base_primary_install_rate_bp", kb5base);
    if(kb1 < 5400) { sp = ob_kv(s, sp, "verdict_kb1", "PASS"); }
    if(kb1 >= 5400) { sp = ob_kv(s, sp, "verdict_kb1", "FAIL"); }
    if(kb2 >= 6760 && pfid >= 7160 && pfid <= 7360) { sp = ob_kv(s, sp, "verdict_kb2", "PASS"); }
    if(kb2 < 6760 || pfid < 7160 || pfid > 7360) { sp = ob_kv(s, sp, "verdict_kb2", "FAIL"); }
    if(kb4ok == 1) { sp = ob_kv(s, sp, "verdict_kb4", "PASS"); }
    if(kb4ok == 0) { sp = ob_kv(s, sp, "verdict_kb4", "FAIL"); }
    if(kb5cand >= kb5base - 1000) { sp = ob_kv(s, sp, "verdict_kb5", "PASS"); }
    if(kb5cand < kb5base - 1000) { sp = ob_kv(s, sp, "verdict_kb5", "FAIL"); }
    // KB3 (determinism) is checked externally via sha256 of the two runs.
    if(z_write_new(sumpath, s[0..sp]) != 0) { return 3; }

    // ---- stdout: compact human summary ----
    let o:[]u8 = nio_alloc(4096);
    let op:i32 = 0;
    op = ob_kv(o, op, "fixtures", _zag_i64_to_str(ntot));
    op = ob_kv(o, op, "base_primary_mean_bp", _zag_i64_to_str(bsum / 6));
    op = ob_kv(o, op, "cand_primary_mean_bp", _zag_i64_to_str(csum / 6));
    op = ob_kv(o, op, "base_adv_fir_bp", _zag_i64_to_str(rate_bp(baf, bai)));
    op = ob_kv(o, op, "cand_adv_fir_bp", _zag_i64_to_str(rate_bp(caf, cai)));
    op = ob_kv(o, op, "base_adv_installs", _zag_i64_to_str(bai));
    op = ob_kv(o, op, "cand_adv_installs", _zag_i64_to_str(cai));
    op = ob_kv(o, op, "base_ops_total", _zag_i64_to_str(obase));
    op = ob_kv(o, op, "cand_ops_total", _zag_i64_to_str(ocand));
    op = ob_kv(o, op, "base_primary_install_rate_bp", _zag_i64_to_str(kb5base));
    op = ob_kv(o, op, "cand_primary_install_rate_bp", _zag_i64_to_str(kb5cand));
    nio_write_all(1, o[0..op]);
    return 0;
}

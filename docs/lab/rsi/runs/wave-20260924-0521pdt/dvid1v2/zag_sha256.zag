@import("substrate/R33_NATIVE_IO_V1.zag")
// ============================================================
// zag_sha256.zag - pure-Zag SHA-256 file hasher (NEW wave evidence).
// Usage: zag_sha256_bin <frames_dir>
// Prints "dvid1_fNN.bmp <hex>" for f=0..47, one per line.
// Used for the V1 determinism manifests (VKB1) and sealed-pair
// pixel-genuineness checks. Pure Zag, zero RNG.
// ============================================================
fn o_put32(buf:[]u8, off:i64, v:i64) void {
    buf[off] = (v & 255) as u8;
    buf[off + 1] = ((v >> 8) & 255) as u8;
    buf[off + 2] = ((v >> 16) & 255) as u8;
    buf[off + 3] = ((v >> 24) & 255) as u8;
}
fn o_get32u(buf:[]u8, off:i64) i64 {
    let b0:i64 = buf[off] as i64;
    let b1:i64 = buf[off + 1] as i64;
    let b2:i64 = buf[off + 2] as i64;
    let b3:i64 = buf[off + 3] as i64;
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}
fn s_rotr(x:i64, n:i64) i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}
// round constants: cube-root fractions of the first 64 primes
fn shk(i:i64) i64 {
    if (i == 0) { return 1116352408; }
    if (i == 1) { return 1899447441; }
    if (i == 2) { return 3049323471; }
    if (i == 3) { return 3921009573; }
    if (i == 4) { return 961987163; }
    if (i == 5) { return 1508970993; }
    if (i == 6) { return 2453635748; }
    if (i == 7) { return 2870763221; }
    if (i == 8) { return 3624381080; }
    if (i == 9) { return 310598401; }
    if (i == 10) { return 607225278; }
    if (i == 11) { return 1426881987; }
    if (i == 12) { return 1925078388; }
    if (i == 13) { return 2162078206; }
    if (i == 14) { return 2614888103; }
    if (i == 15) { return 3248222580; }
    if (i == 16) { return 3835390401; }
    if (i == 17) { return 4022224774; }
    if (i == 18) { return 264347078; }
    if (i == 19) { return 604807628; }
    if (i == 20) { return 770255983; }
    if (i == 21) { return 1249150122; }
    if (i == 22) { return 1555081692; }
    if (i == 23) { return 1996064986; }
    if (i == 24) { return 2554220882; }
    if (i == 25) { return 2821834349; }
    if (i == 26) { return 2952996808; }
    if (i == 27) { return 3210313671; }
    if (i == 28) { return 3336571891; }
    if (i == 29) { return 3584528711; }
    if (i == 30) { return 113926993; }
    if (i == 31) { return 338241895; }
    if (i == 32) { return 666307205; }
    if (i == 33) { return 773529912; }
    if (i == 34) { return 1294757372; }
    if (i == 35) { return 1396182291; }
    if (i == 36) { return 1695183700; }
    if (i == 37) { return 1986661051; }
    if (i == 38) { return 2177026350; }
    if (i == 39) { return 2456956037; }
    if (i == 40) { return 2730485921; }
    if (i == 41) { return 2820302411; }
    if (i == 42) { return 3259730800; }
    if (i == 43) { return 3345764771; }
    if (i == 44) { return 3516065817; }
    if (i == 45) { return 3600352804; }
    if (i == 46) { return 4094571909; }
    if (i == 47) { return 275423344; }
    if (i == 48) { return 430227734; }
    if (i == 49) { return 506948616; }
    if (i == 50) { return 659060556; }
    if (i == 51) { return 883997877; }
    if (i == 52) { return 958139571; }
    if (i == 53) { return 1322822218; }
    if (i == 54) { return 1537002063; }
    if (i == 55) { return 1747873779; }
    if (i == 56) { return 1955562222; }
    if (i == 57) { return 2024104815; }
    if (i == 58) { return 2227730452; }
    if (i == 59) { return 2361852424; }
    if (i == 60) { return 2428436474; }
    if (i == 61) { return 2756734187; }
    if (i == 62) { return 3204031479; }
    if (i == 63) { return 3329325298; }
    return 0;
}
fn sha_block(h:[]u8, blk:[]u8) void {
    let w:[]u8 = nio_alloc(256);
    if (w.len == 0) { return; }
    let i:i64 = 0;
    while (i < 16) {
        let v:i64 = (blk[i * 4] as i64) * 16777216 + (blk[i * 4 + 1] as i64) * 65536 + (blk[i * 4 + 2] as i64) * 256 + (blk[i * 4 + 3] as i64);
        o_put32(w, i * 4, v);
        i = i + 1;
    }
    i = 16;
    while (i < 64) {
        let w2:i64 = o_get32u(w, (i - 2) * 4);
        let w15:i64 = o_get32u(w, (i - 15) * 4);
        let w7:i64 = o_get32u(w, (i - 7) * 4);
        let w16:i64 = o_get32u(w, (i - 16) * 4);
        let s1:i64 = (s_rotr(w2, 17) ^ s_rotr(w2, 19) ^ (w2 >> 10)) & 4294967295;
        let s0:i64 = (s_rotr(w15, 7) ^ s_rotr(w15, 18) ^ (w15 >> 3)) & 4294967295;
        o_put32(w, i * 4, (s1 + w7 + s0 + w16) & 4294967295);
        i = i + 1;
    }
    let a:i64 = o_get32u(h, 0);
    let b:i64 = o_get32u(h, 4);
    let c:i64 = o_get32u(h, 8);
    let d:i64 = o_get32u(h, 12);
    let e:i64 = o_get32u(h, 16);
    let f:i64 = o_get32u(h, 20);
    let g:i64 = o_get32u(h, 24);
    let hh:i64 = o_get32u(h, 28);
    i = 0;
    while (i < 64) {
        let S1:i64 = (s_rotr(e, 6) ^ s_rotr(e, 11) ^ s_rotr(e, 25)) & 4294967295;
        let ch:i64 = ((e & f) ^ ((4294967295 ^ e) & g)) & 4294967295;
        let t1:i64 = (hh + S1 + ch + shk(i) + o_get32u(w, i * 4)) & 4294967295;
        let S0:i64 = (s_rotr(a, 2) ^ s_rotr(a, 13) ^ s_rotr(a, 22)) & 4294967295;
        let mj:i64 = ((a & b) ^ (a & c) ^ (b & c)) & 4294967295;
        let t2:i64 = (S0 + mj) & 4294967295;
        hh = g;
        g = f;
        f = e;
        e = (d + t1) & 4294967295;
        d = c;
        c = b;
        b = a;
        a = (t1 + t2) & 4294967295;
        i = i + 1;
    }
    o_put32(h, 0, (o_get32u(h, 0) + a) & 4294967295);
    o_put32(h, 4, (o_get32u(h, 4) + b) & 4294967295);
    o_put32(h, 8, (o_get32u(h, 8) + c) & 4294967295);
    o_put32(h, 12, (o_get32u(h, 12) + d) & 4294967295);
    o_put32(h, 16, (o_get32u(h, 16) + e) & 4294967295);
    o_put32(h, 20, (o_get32u(h, 20) + f) & 4294967295);
    o_put32(h, 24, (o_get32u(h, 24) + g) & 4294967295);
    o_put32(h, 28, (o_get32u(h, 28) + hh) & 4294967295);
    nio_free(w);
}
fn sha_file_hex(path:[]u8, out_hex:[]u8) i64 {
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    if (fd < 0) { return -21; }
    let size:i64 = nio_seek(fd, 0, 2);
    if (size < 0 || size > 33554431) { nio_close(fd); return -22; }
    if (nio_seek(fd, 0, 0) != 0) { nio_close(fd); return -23; }
    let msg:[]u8 = nio_alloc(1);
    if (msg.len == 0) { nio_close(fd); return -24; }
    if (size > 0) {
        nio_free(msg);
        msg = nio_alloc(size as i32);
        if (msg.len == 0) { nio_close(fd); return -24; }
        let n:i64 = nio_read_exact(fd, msg, size as i32);
        nio_close(fd);
        if (n != size) { nio_free(msg); return -25; }
    } else {
        nio_close(fd);
    }
    // padded length: smallest multiple of 64 >= size+9
    let pad:i64 = ((size + 9 + 63) / 64) * 64;
    let pbuf:[]u8 = nio_alloc(pad as i32);
    if (pbuf.len == 0) { nio_free(msg); return -26; }
    let i:i64 = 0;
    while (i < size) { pbuf[i] = msg[i]; i = i + 1; }
    nio_free(msg);
    pbuf[size] = 128 as u8;
    i = size + 1;
    while (i < pad) { pbuf[i] = 0 as u8; i = i + 1; }
    // 64-bit big-endian bit length
    let bits:i64 = size * 8;
    let k2:i64 = 0;
    while (k2 < 8) {
        pbuf[pad - 1 - k2] = (bits & 255) as u8;
        bits = bits >> 8;
        k2 = k2 + 1;
    }
    let h:[]u8 = nio_alloc(32);
    if (h.len == 0) { nio_free(pbuf); return -27; }
    o_put32(h, 0, 1779033703);
    o_put32(h, 4, 3144134277);
    o_put32(h, 8, 1013904242);
    o_put32(h, 12, 2773480762);
    o_put32(h, 16, 1359893119);
    o_put32(h, 20, 2600822924);
    o_put32(h, 24, 528734635);
    o_put32(h, 28, 1541459225);
    let blk:[]u8 = nio_alloc(64);
    if (blk.len == 0) { nio_free(h); nio_free(pbuf); return -28; }
    let off:i64 = 0;
    while (off < pad) {
        let j:i64 = 0;
        while (j < 64) { blk[j] = pbuf[off + j]; j = j + 1; }
        sha_block(h, blk);
        off = off + 64;
    }
    nio_free(blk);
    nio_free(pbuf);
    let wx:i64 = 0;
    while (wx < 8) {
        let v:i64 = o_get32u(h, wx * 4);
        let sh:i64 = 28;
        while (sh >= 0) {
            let nib:i64 = (v >> sh) & 15;
            let chc:i64 = 48 + nib;
            if (nib >= 10) { chc = 87 + nib; }
            out_hex[wx * 8 + (28 - sh) / 4] = chc as u8;
            sh = sh - 4;
        }
        wx = wx + 1;
    }
    nio_free(h);
    return 0;
}
fn z_copy(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0 as u8;
    return b;
}
fn frame_path(dir:[]u8, f:i64) []u8 {
    let b:[]u8 = nio_alloc((dir.len + 16) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < dir.len && dir[i] != 0) { b[i] = dir[i]; i = i + 1; }
    b[i] = 47 as u8; i = i + 1;
    b[i] = 100 as u8; i = i + 1;
    b[i] = 118 as u8; i = i + 1;
    b[i] = 105 as u8; i = i + 1;
    b[i] = 100 as u8; i = i + 1;
    b[i] = 49 as u8; i = i + 1;
    b[i] = 95 as u8; i = i + 1;
    b[i] = 102 as u8; i = i + 1;
    b[i] = (48 + f / 10) as u8; i = i + 1;
    b[i] = (48 + f % 10) as u8; i = i + 1;
    b[i] = 46 as u8; i = i + 1;
    b[i] = 98 as u8; i = i + 1;
    b[i] = 109 as u8; i = i + 1;
    b[i] = 112 as u8; i = i + 1;
    b[i] = 0 as u8;
    return b;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if (a1.len == 0) {
        _zag_println("usage: zag_sha256_bin <frames_dir>");
        return 1;
    }
    let dir:[]u8 = z_copy(a1);
    if (dir.len == 0) { return 2; }
    let hex:[]u8 = nio_alloc(64);
    if (hex.len == 0) { return 3; }
    let f:i64 = 0;
    while (f < 48) {
        let path:[]u8 = frame_path(dir, f);
        if (path.len == 0) { return 4; }
        let rc:i64 = sha_file_hex(path, hex);
        nio_free(path);
        if (rc != 0) {
            _zag_print("hash error f=");
            _zag_print(_zag_i64_to_str(f));
            _zag_print(" rc=");
            _zag_println(_zag_i64_to_str(rc));
            return 5;
        }
        _zag_print("dvid1_f");
        if (f < 10) { _zag_print("0"); }
        _zag_print(_zag_i64_to_str(f));
        _zag_print(".bmp ");
        _zag_print(hex);
        _zag_println("");
        f = f + 1;
    }
    nio_free(hex);
    nio_free(dir);
    return 0;
}

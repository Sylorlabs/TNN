@import("substrate/R33_NATIVE_IO_V1.zag")
// ============================================================
// v2_verify.zag - D-VID-1 V2 pure-Zag verifier (NEW wave evidence).
// Wave 20260924-0521pdt. Frozen prereg PREREG_DVID1_V2_0521.md,
// frozen addendum dvid1v2/ADDENDUM_IMPL.md.
// Measures on two 48-frame BMP dirs (frames named dvid1_f00.bmp ..
// dvid1_f47.bmp in both dirs):
//   v2_verify_bin <baseline_dir> <variant_dir>
// - T1 rotating-frame foam boil (NEW): co-rotating cell grid over the
//   160 world-unit influence disc, fixed in the rotating frame; cells
//   map to screen pixels through the exact algebraic inverse of the
//   frozen sampling transform (ADDENDUM_IMPL.md section 1).
// - Metric trust gate: rigid-rotation control built from baseline
//   f0's foam mask; gate passes iff control_pm <= cap_pm with
//   cap_pm = T1_baseline_pm * 250 / 1000.
// - T1 screen-space (the V1 metric) reported as diagnostic ONLY.
// - T2 (V-TEMP), T3 (V-SHARP), V-RES as in V1.
// Pure Zag, zero RNG. No Python touches these frames.
// ============================================================

// ---- deterministic math copies (same functions as the generator) ----
fn o_clamp01k(v:i64) i64 {
    if (v < 0) { return 0; }
    if (v > 1000) { return 1000; }
    return v;
}
fn o_ss(t:i64) i64 {
    if (t <= 0) { return 0; }
    if (t >= 1000) { return 1000; }
    return t * t * (3000 - 2 * t) / 1000000;
}
fn o_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let x:i64 = v;
    let y:i64 = (x + 1) / 2;
    let guard:i64 = 0;
    while (y < x && guard < 64) { x = y; y = (x + v / x) / 2; guard = guard + 1; }
    return x;
}
fn o_hash2(ix:i64, iy:i64, seed:i64) i64 {
    let h:i64 = (ix * 374761393 + iy * 668265263 + seed * 974634211) & 9223372036854775807;
    h = h ^ (h >> 13);
    h = (h * 1274126177) & 9223372036854775807;
    h = h ^ (h >> 16);
    return h % 1001;
}
fn o_hash3(ix:i64, iy:i64, iz:i64, seed:i64) i64 {
    let h:i64 = (ix * 374761393 + iy * 668265263 + iz * 2246822519 + seed * 3266489917) & 9223372036854775807;
    h = h ^ (h >> 13);
    h = (h * 1274126177) & 9223372036854775807;
    h = h ^ (h >> 16);
    return h % 1001;
}
fn o_ss8(t:i64) i64 {
    return t * t * (768 - 2 * t) >> 16;
}
fn o_vn2(x8:i64, y8:i64, seed:i64) i64 {
    let ix:i64 = x8 >> 8;
    let iy:i64 = y8 >> 8;
    let fx:i64 = x8 & 255;
    let fy:i64 = y8 & 255;
    let sx:i64 = o_ss8(fx);
    let sy:i64 = o_ss8(fy);
    let v00:i64 = o_hash2(ix, iy, seed);
    let v10:i64 = o_hash2(ix + 1, iy, seed);
    let v01:i64 = o_hash2(ix, iy + 1, seed);
    let v11:i64 = o_hash2(ix + 1, iy + 1, seed);
    let a:i64 = v00 + (v10 - v00) * sx / 256;
    let b:i64 = v01 + (v11 - v01) * sx / 256;
    return a + (b - a) * sy / 256;
}
fn o_vn3(x8:i64, y8:i64, z8:i64, seed:i64) i64 {
    let ix:i64 = x8 >> 8;
    let iy:i64 = y8 >> 8;
    let iz:i64 = z8 >> 8;
    let fx:i64 = x8 & 255;
    let fy:i64 = y8 & 255;
    let fz:i64 = z8 & 255;
    let sx:i64 = o_ss8(fx);
    let sy:i64 = o_ss8(fy);
    let sz:i64 = o_ss8(fz);
    let c000:i64 = o_hash3(ix, iy, iz, seed);
    let c100:i64 = o_hash3(ix + 1, iy, iz, seed);
    let c010:i64 = o_hash3(ix, iy + 1, iz, seed);
    let c110:i64 = o_hash3(ix + 1, iy + 1, iz, seed);
    let c001:i64 = o_hash3(ix, iy, iz + 1, seed);
    let c101:i64 = o_hash3(ix + 1, iy, iz + 1, seed);
    let c011:i64 = o_hash3(ix, iy + 1, iz + 1, seed);
    let c111:i64 = o_hash3(ix + 1, iy + 1, iz + 1, seed);
    let x00:i64 = c000 + (c100 - c000) * sx / 256;
    let x10:i64 = c010 + (c110 - c010) * sx / 256;
    let x01:i64 = c001 + (c101 - c001) * sx / 256;
    let x11:i64 = c011 + (c111 - c011) * sx / 256;
    let y0:i64 = x00 + (x10 - x00) * sy / 256;
    let y1:i64 = x01 + (x11 - x01) * sy / 256;
    return y0 + (y1 - y0) * sz / 256;
}
fn o_fbm2(x8:i64, y8:i64, oct:i64, seed:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 1000;
    let tot:i64 = 0;
    let xx:i64 = x8;
    let yy:i64 = y8;
    let s:i64 = seed;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + o_vn2(xx, yy, s) * amp / 1000;
        tot = tot + amp;
        xx = xx * 2;
        yy = yy * 2;
        amp = amp / 2;
        s = s + 131;
        o = o + 1;
    }
    return sum * 1000 / tot;
}
fn o_atan2(y:i64, x:i64) i64 {
    if (x == 0 && y == 0) { return 0; }
    let ax:i64 = x;
    if (ax < 0) { ax = 0 - ax; }
    let ay:i64 = y;
    if (ay < 0) { ay = 0 - ay; }
    let a:i64 = 0;
    let base:i64 = 0;
    if (ax >= ay) {
        if (ax == 0) { return 0; }
        a = ay * 1000 / ax;
        base = 0;
    } else {
        a = ax * 1000 / ay;
        base = 1571;
    }
    let t:i64 = 785 * a / 1000 + 273 * a * (1000 - a) / 1000000;
    let oct:i64 = t;
    if (base == 1571) { oct = 1571 - t; }
    if (x >= 0 && y >= 0) { return oct; }
    if (x < 0 && y >= 0) { return 3142 - oct; }
    if (x < 0 && y < 0) { return 3142 + oct; }
    return 6283 - oct;
}
// cos/sin of a small angle (<= ~700 millirad), x1000 (verbatim copy)
fn o_cos_sin(mrad:i64, o_c:*i64, o_s:*i64) void {
    o_c.* = 1000 - mrad * mrad / 2000000;
    o_s.* = mrad - mrad * mrad * mrad / 6000000000;
}
fn o_spire(i:i64, o_sx:*i64, o_sz:*i64, o_sr:*i64, o_sh:*i64) void {
    if (i == 0) { o_sx.* = -1050; o_sz.* = 2500; o_sr.* = 55; o_sh.* = 150000; return; }
    if (i == 1) { o_sx.* = -420; o_sz.* = 3100; o_sr.* = 42; o_sh.* = 120000; return; }
    if (i == 2) { o_sx.* = 180; o_sz.* = 2800; o_sr.* = 70; o_sh.* = 210000; return; }
    if (i == 3) { o_sx.* = 760; o_sz.* = 3400; o_sr.* = 48; o_sh.* = 140000; return; }
    if (i == 4) { o_sx.* = 1300; o_sz.* = 2700; o_sr.* = 38; o_sh.* = 105000; return; }
    o_sx.* = -1650; o_sz.* = 3900; o_sr.* = 62; o_sh.* = 170000;
}
fn o_scene(f:i64, o_vwx:*i64, o_vwz:*i64, o_rot:*i64) void {
    o_vwx.* = 140 + (o_vn3(f * 64, 7 * 256, 3 * 256, 91) - 500) * 120 / 1000;
    o_vwz.* = 720 + (o_vn3(f * 64, 99 * 256, 5 * 256, 92) - 500) * 100 / 1000;
    o_rot.* = f * 8;
}
fn o_height(wx:i64, wz:i64, f:i64, vwx:i64, vwz:i64, rot:i64, o_mat:*i64, o_fall:*i64, o_arm:*i64, o_sprox:*i64) i64 {
    let mat:i64 = 0;
    let fall:i64 = 0;
    let arm:i64 = 0;
    let sprox:i64 = 0;
    let sx1:i64 = wx - f * 12 / 10;
    let sz1:i64 = wz - f * 5 / 10;
    let qx:i64 = o_vn2(sx1, sz1, 101) - 500;
    let qz:i64 = o_vn2(sx1 + 3737, sz1 + 911, 102) - 500;
    let wxw:i64 = sx1 * 2 + qx * 90 / 1000;
    let wzw:i64 = sz1 * 2 + qz * 90 / 1000;
    let swell:i64 = o_fbm2(wxw, wzw, 3, 11);
    let h:i64 = (swell - 500) * 18 / 10;
    let dx:i64 = wx - vwx;
    let dz:i64 = wz - vwz;
    let r2:i64 = dx * dx + dz * dz;
    let vrr:i64 = 160 * 160;
    fall = vrr * 1000 / (vrr + r2);
    h = h - 8500 * fall / 1000;
    let r:i64 = o_isqrt(r2);
    if (r < 160 && r > 4) {
        let ang:i64 = o_atan2(dz, dx);
        let armx:i64 = ang * 4000 / 6283 + r * 8 - rot + 12000;
        let fr:i64 = (armx % 4000) % 1000;
        let dd:i64 = 2 * fr - 1000;
        if (dd < 0) { dd = 0 - dd; }
        let tri:i64 = 1000 - dd;
        let ridge:i64 = tri * tri / 1000;
        h = h + 3200 * ridge / 1000 * fall / 1000;
        arm = ridge * fall / 1000;
    }
    let si:i64 = 0;
    let best:i64 = 1000000;
    while (si < 6) {
        let ssx:i64 = 0;
        let ssz:i64 = 0;
        let ssr:i64 = 0;
        let ssh:i64 = 0;
        o_spire(si, &ssx, &ssz, &ssr, &ssh);
        let ddx:i64 = wx - ssx;
        let ddz:i64 = wz - ssz;
        let reach:i64 = ssr * 2 + 40;
        if (ddx < reach && ddx > 0 - reach && ddz < reach && ddz > 0 - reach) {
            let d2s:i64 = ddx * ddx + ddz * ddz;
            if (d2s < reach * reach) {
                let ds:i64 = o_isqrt(d2s);
                if (ds < best) { best = ds; }
            }
        }
        si = si + 1;
    }
    if (best < 1000000) {
        sprox = o_clamp01k((120 - best) * 1000 / 120);
    }
    o_mat.* = mat;
    o_fall.* = fall;
    o_arm.* = arm;
    o_sprox.* = sprox;
    return h;
}
fn o_sy_fp(h:i64, wz:i64) i64 {
    let dym:i64 = h - 13000;
    let yp:i64 = dym * 990 + wz * 143000;
    let zp:i64 = wz * 990000 - dym * 143;
    return 16384 - 29440 * yp / zp;
}
fn o_sy(h:i64, wz:i64) i64 {
    return o_sy_fp(h, wz) / 32;
}

// ---- frame I/O ----
fn v_zcstr_copy(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0 as u8;
    return b;
}
fn v_frame_path(dir:[]u8, f:i64) []u8 {
    let b:[]u8 = nio_alloc((dir.len + 16) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < dir.len && dir[i] != 0) { b[i] = dir[i]; i = i + 1; }
    b[i] = 47 as u8; i = i + 1;
    b[i] = 100 as u8; i = i + 1;
    b[i] = 118 as u8; i = i + 1;
    b[i] = 105 as u8; i = i + 1;
    b[i] = 100 as u8; i = i + 1;
    b[i] = 49 as u8; i = i + 1;
    b[i] = 95 as u8; i = i + 1;
    b[i] = 102 as u8; i = i + 1;
    b[i] = (48 + f / 10) as u8; i = i + 1;
    b[i] = (48 + f % 10) as u8; i = i + 1;
    b[i] = 46 as u8; i = i + 1;
    b[i] = 98 as u8; i = i + 1;
    b[i] = 109 as u8; i = i + 1;
    b[i] = 112 as u8; i = i + 1;
    b[i] = 0 as u8;
    return b;
}
// reads one frame; returns bytes read (expect 3145782) or negative
fn v_read_frame(dir:[]u8, f:i64, buf:[]u8) i64 {
    let path:[]u8 = v_frame_path(dir, f);
    if (path.len == 0) { return -20; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    nio_free(path);
    if (fd < 0) { return -21; }
    let n:i64 = nio_read_exact(fd, buf, 3145782);
    nio_close(fd);
    return n;
}
// ---- pixel helpers (BMP bottom-up, BGR) ----
fn v_foam(b:[]u8, x:i64, y:i64) i64 {
    let at:i64 = 54 + (1023 - y) * 3072 + x * 3;
    let bb:i64 = b[at] as i64;
    let gg:i64 = b[at + 1] as i64;
    let rr:i64 = b[at + 2] as i64;
    let l:i64 = (299 * rr + 587 * gg + 114 * bb) / 1000;
    if (l < 200) { return 0; }
    let mx:i64 = rr;
    if (gg > mx) { mx = gg; }
    if (bb > mx) { mx = bb; }
    let mn:i64 = rr;
    if (gg < mn) { mn = gg; }
    if (bb < mn) { mn = bb; }
    if (mx - mn > 40) { return 0; }
    return 1;
}
fn v_lum(b:[]u8, at:i64) i64 {
    let bb:i64 = b[at] as i64;
    let gg:i64 = b[at + 1] as i64;
    let rr:i64 = b[at + 2] as i64;
    return (299 * rr + 587 * gg + 114 * bb + 500) / 1000;
}
// ---- T1 rotating frame: co-rotating cell grid ----
// Grid: 80x80 cells, cell (i,j) center at rotating-frame
// (qx,qz) = (-158 + 4*i, -158 + 4*j); kept iff qx^2+qz^2 <= 160^2
// (frozen 160 world-unit influence disc). Masks stored as u8 in
// 80x80 arrays; outside-disc cells are 0 and never counted.
fn v_cell_q(i:i64, j:i64, o_qx:*i64, o_qz:*i64) i64 {
    let qx:i64 = 0 - 158 + 4 * i;
    let qz:i64 = 0 - 158 + 4 * j;
    o_qx.* = qx;
    o_qz.* = qz;
    if (qx * qx + qz * qz <= 25600) { return 1; }
    return 0;
}
// project world (wx,wz) at frame f to nearest screen pixel
fn v_project(wx:i64, wz:i64, f:i64, vwx:i64, vwz:i64, rot:i64, o_x:*i64, o_y:*i64) void {
    if (wz <= 0) { o_x.* = 0 - 1; o_y.* = 0 - 1; return; }
    let m0:i64 = 0;
    let fa0:i64 = 0;
    let a0:i64 = 0;
    let sp0:i64 = 0;
    let h:i64 = o_height(wx, wz, f, vwx, vwz, rot, &m0, &fa0, &a0, &sp0);
    o_x.* = 512 + wx * 920 / wz;
    o_y.* = o_sy_fp(h, wz) / 32;
}
// cell masks for one frame from a loaded frame buffer.
// masks: caller array; base: frame's offset into it (80x80 cells).
fn v_cell_masks(f:i64, b:[]u8, masks:[]u8, base:i64) void {
    let vwx:i64 = 0;
    let vwz:i64 = 0;
    let rot:i64 = 0;
    o_scene(f, &vwx, &vwz, &rot);
    let mrad:i64 = rot * 6283 / 4000;
    let cph:i64 = 0;
    let sph:i64 = 0;
    o_cos_sin(mrad, &cph, &sph);
    let j:i64 = 0;
    while (j < 80) {
        let i:i64 = 0;
        while (i < 80) {
            let idx:i64 = base + j * 80 + i;
            let qx:i64 = 0;
            let qz:i64 = 0;
            if (v_cell_q(i, j, &qx, &qz) == 0) {
                masks[idx] = 0 as u8;
            } else {
                // exact algebraic inverse of the frozen sampling
                // transform (ADDENDUM_IMPL.md section 1)
                let rdx:i64 = (qx * cph + qz * sph) / 1000;
                let rdz:i64 = (qz * cph - qx * sph) / 1000;
                let wx:i64 = vwx + rdx;
                let wz:i64 = vwz + rdz;
                let x:i64 = 0;
                let y:i64 = 0;
                v_project(wx, wz, f, vwx, vwz, rot, &x, &y);
                let m:i64 = 0;
                if (x >= 0 && x < 1024 && y >= 0 && y < 1024) {
                    m = v_foam(b, x, y);
                }
                masks[idx] = m as u8;
            }
            i = i + 1;
        }
        j = j + 1;
    }
}
// rigid-rotation control masks for one frame f, built ONLY from
// baseline f0's bitmap (b0) and the frozen formulas (ADDENDUM_IMPL.md
// section 3). Simulates foam exactly stationary in the rotating
// frame; the measured flip rate is the ruler's quantization floor.
fn v_control_masks(f:i64, b0:[]u8, masks:[]u8, base:i64) void {
    let vwx:i64 = 0;
    let vwz:i64 = 0;
    let rot:i64 = 0;
    o_scene(f, &vwx, &vwz, &rot);
    let vwx0:i64 = 0;
    let vwz0:i64 = 0;
    let rot0:i64 = 0;
    o_scene(0, &vwx0, &vwz0, &rot0);
    let mrad:i64 = rot * 6283 / 4000;
    let cph:i64 = 0;
    let sph:i64 = 0;
    o_cos_sin(mrad, &cph, &sph);
    let j:i64 = 0;
    while (j < 80) {
        let i:i64 = 0;
        while (i < 80) {
            let idx:i64 = base + j * 80 + i;
            let qx:i64 = 0;
            let qz:i64 = 0;
            if (v_cell_q(i, j, &qx, &qz) == 0) {
                masks[idx] = 0 as u8;
            } else {
                // inverse: world point the cell looks at at frame f
                let rdx:i64 = (qx * cph + qz * sph) / 1000;
                let rdz:i64 = (qz * cph - qx * sph) / 1000;
                let wx:i64 = vwx + rdx;
                let wz:i64 = vwz + rdz;
                // round trip back through the forward transform
                // (integer remap rounding enters here)
                let dx:i64 = wx - vwx;
                let dz:i64 = wz - vwz;
                let qxp:i64 = (dx * cph - dz * sph) / 1000;
                let qzp:i64 = (dz * cph + dx * sph) / 1000;
                // sample f0's foam mask at the frame-0 pixel of
                // the round-tripped rotating coordinate
                let w0x:i64 = vwx0 + qxp;
                let w0z:i64 = vwz0 + qzp;
                let x:i64 = 0;
                let y:i64 = 0;
                v_project(w0x, w0z, 0, vwx0, vwz0, rot0, &x, &y);
                let m:i64 = 0;
                if (x >= 0 && x < 1024 && y >= 0 && y < 1024) {
                    m = v_foam(b0, x, y);
                }
                masks[idx] = m as u8;
            }
            i = i + 1;
        }
        j = j + 1;
    }
}
// T1 over 47 pairs from per-frame 80x80 mask arrays (48 frames).
// out: flips, foam cells. per-mille = flips*1000/foam.
fn v_t1_masks(masks:[]u8, o_flips:*i64, o_foam:*i64) void {
    let flips:i64 = 0;
    let foam:i64 = 0;
    let f:i64 = 0;
    while (f < 47) {
        let base0:i64 = f * 6400;
        let base1:i64 = (f + 1) * 6400;
        let k:i64 = 0;
        while (k < 6400) {
            let m0:i64 = masks[base0 + k] as i64;
            let m1:i64 = masks[base1 + k] as i64;
            if (m0 == 1) { foam = foam + 1; }
            if (m0 != m1) { flips = flips + 1; }
            k = k + 1;
        }
        f = f + 1;
    }
    o_flips.* = flips;
    o_foam.* = foam;
}
// ---- T1 screen-space diagnostic (the V1 metric; RETIRED as a kill
// bar for V2, reported with no verdict weight) ----
// out: disc flips/foam (whirlpool influence disc), band flips/foam
// (near-field band y>=420 where breakup is active). Returns 0 or <0.
fn v_t1_pair(f:i64, dir:[]u8, b0:[]u8, b1:[]u8, o_dfl:*i64, o_dfo:*i64, o_bfl:*i64, o_bfo:*i64) i64 {
    if (v_read_frame(dir, f, b0) != 3145782) { return -1; }
    if (v_read_frame(dir, f + 1, b1) != 3145782) { return -2; }
    let vwx:i64 = 0;
    let vwz:i64 = 0;
    let rot:i64 = 0;
    o_scene(f, &vwx, &vwz, &rot);
    let m0:i64 = 0;
    let fa0:i64 = 0;
    let a0:i64 = 0;
    let sp0:i64 = 0;
    let hc:i64 = o_height(vwx, vwz, f, vwx, vwz, rot, &m0, &fa0, &a0, &sp0);
    let xc:i64 = 512 + vwx * 920 / vwz;
    let yc:i64 = o_sy(hc, vwz);
    let rad:i64 = 160 * 920 / vwz;
    let r2:i64 = rad * rad;
    let x0:i64 = xc - rad;
    if (x0 < 0) { x0 = 0; }
    let x1:i64 = xc + rad;
    if (x1 > 1023) { x1 = 1023; }
    let y0:i64 = yc - rad;
    if (y0 < 0) { y0 = 0; }
    let y1:i64 = yc + rad;
    if (y1 > 1023) { y1 = 1023; }
    let dfl:i64 = 0;
    let dfo:i64 = 0;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let dx:i64 = x - xc;
            let dy:i64 = y - yc;
            if (dx * dx + dy * dy <= r2) {
                let msk0:i64 = v_foam(b0, x, y);
                let msk1:i64 = v_foam(b1, x, y);
                if (msk0 == 1) { dfo = dfo + 1; }
                if (msk0 != msk1) { dfl = dfl + 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let bfl:i64 = 0;
    let bfo:i64 = 0;
    let yb:i64 = 420;
    while (yb < 1024) {
        let xb:i64 = 0;
        while (xb < 1024) {
            let m0b:i64 = v_foam(b0, xb, yb);
            let m1b:i64 = v_foam(b1, xb, yb);
            if (m0b == 1) { bfo = bfo + 1; }
            if (m0b != m1b) { bfl = bfl + 1; }
            xb = xb + 1;
        }
        yb = yb + 1;
    }
    o_dfl.* = dfl;
    o_dfo.* = dfo;
    o_bfl.* = bfl;
    o_bfo.* = bfo;
    return 0;
}
// ---- T2: V-TEMP per-pair sum |dL| ----
fn v_t2_pair(b0:[]u8, b1:[]u8) i64 {
    let s:i64 = 0;
    let y:i64 = 0;
    while (y < 1024) {
        let at:i64 = 54 + (1023 - y) * 3072;
        let x:i64 = 0;
        while (x < 1024) {
            let d:i64 = v_lum(b0, at) - v_lum(b1, at);
            if (d < 0) { d = 0 - d; }
            s = s + d;
            at = at + 3;
            x = x + 1;
        }
        y = y + 1;
    }
    return s;
}
// ---- T3: V-SHARP gradient ratio x1000 ----
fn v_sharp(b:[]u8, lb:[]u8, sm:[]u8) i64 {
    let y:i64 = 0;
    while (y < 1024) {
        let at:i64 = 54 + (1023 - y) * 3072;
        let x:i64 = 0;
        while (x < 1024) {
            lb[y * 1024 + x] = v_lum(b, at) as u8;
            at = at + 3;
            x = x + 1;
        }
        y = y + 1;
    }
    let sox:i64 = 0;
    let soy:i64 = 0;
    let yy:i64 = 0;
    while (yy < 1024) {
        let xx:i64 = 0;
        while (xx < 1023) {
            let d:i64 = (lb[yy * 1024 + xx + 1] as i64) - (lb[yy * 1024 + xx] as i64);
            if (d < 0) { d = 0 - d; }
            sox = sox + d;
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    yy = 0;
    while (yy < 1023) {
        let xx2:i64 = 0;
        while (xx2 < 1024) {
            let d2:i64 = (lb[(yy + 1) * 1024 + xx2] as i64) - (lb[yy * 1024 + xx2] as i64);
            if (d2 < 0) { d2 = 0 - d2; }
            soy = soy + d2;
            xx2 = xx2 + 1;
        }
        yy = yy + 1;
    }
    // 2x2 box downscale to 512x512
    let j:i64 = 0;
    while (j < 512) {
        let i:i64 = 0;
        while (i < 512) {
            let p00:i64 = lb[(2 * j) * 1024 + 2 * i] as i64;
            let p01:i64 = lb[(2 * j) * 1024 + 2 * i + 1] as i64;
            let p10:i64 = lb[(2 * j + 1) * 1024 + 2 * i] as i64;
            let p11:i64 = lb[(2 * j + 1) * 1024 + 2 * i + 1] as i64;
            sm[j * 512 + i] = ((p00 + p01 + p10 + p11 + 2) / 4) as u8;
            i = i + 1;
        }
        j = j + 1;
    }
    // gradient of the box-upscaled image, via sm lookups (replication)
    let sbx:i64 = 0;
    let sby:i64 = 0;
    let y2:i64 = 0;
    while (y2 < 1024) {
        let x2:i64 = 0;
        while (x2 < 1023) {
            let a:i64 = sm[(y2 / 2) * 512 + x2 / 2] as i64;
            let c:i64 = sm[(y2 / 2) * 512 + (x2 + 1) / 2] as i64;
            let d:i64 = c - a;
            if (d < 0) { d = 0 - d; }
            sbx = sbx + d;
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    y2 = 0;
    while (y2 < 1023) {
        let x3:i64 = 0;
        while (x3 < 1024) {
            let a2:i64 = sm[(y2 / 2) * 512 + x3 / 2] as i64;
            let c2:i64 = sm[((y2 + 1) / 2) * 512 + x3 / 2] as i64;
            let d3:i64 = c2 - a2;
            if (d3 < 0) { d3 = 0 - d3; }
            sby = sby + d3;
            x3 = x3 + 1;
        }
        y2 = y2 + 1;
    }
    let denom:i64 = sbx + sby;
    if (denom <= 0) { return -1; }
    return (sox + soy) * 1000 / denom;
}
fn v_print(s:[]u8) void {
    _zag_print(s);
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    if (a1.len == 0 || a2.len == 0) {
        _zag_println("usage: v2_verify_bin <baseline_dir> <variant_dir>");
        return 1;
    }
    let dirA:[]u8 = v_zcstr_copy(a1);
    let dirB:[]u8 = v_zcstr_copy(a2);
    let b0:[]u8 = nio_alloc(3145782);
    let b1:[]u8 = nio_alloc(3145782);
    let b0f:[]u8 = nio_alloc(3145782);
    if (dirA.len == 0 || dirB.len == 0 || b0.len == 0 || b1.len == 0 || b0f.len == 0) { return 2; }
    // ---- V-RES on the variant dir ----
    let resok:i64 = 0;
    let i:i64 = 0;
    while (i < 48) {
        let n:i64 = v_read_frame(dirB, i, b0);
        let ok:i64 = 0;
        if (n == 3145782 && (b0[0] as i64) == 66 && (b0[1] as i64) == 77) {
            let w:i64 = (b0[18] as i64) + (b0[19] as i64) * 256 + (b0[20] as i64) * 65536 + (b0[21] as i64) * 16777216;
            let hh:i64 = (b0[22] as i64) + (b0[23] as i64) * 256 + (b0[24] as i64) * 65536 + (b0[25] as i64) * 16777216;
            let bpp:i64 = (b0[28] as i64) + (b0[29] as i64) * 256;
            if (w == 1024 && hh == 1024 && bpp == 24) { ok = 1; }
        }
        if (ok == 1) { resok = resok + 1; }
        i = i + 1;
    }
    _zag_print("V-RES variant frames ok: ");
    _zag_print(_zag_i64_to_str(resok));
    _zag_println("/48");
    // ---- T1 rotating frame: cell masks for all 48 frames ----
    // masksA: baseline, masksB: variant, masksC: rigid-rotation control
    let masksA:[]u8 = nio_alloc(307200);
    let masksB:[]u8 = nio_alloc(307200);
    let masksC:[]u8 = nio_alloc(307200);
    if (masksA.len == 0 || masksB.len == 0 || masksC.len == 0) { return 3; }
    if (v_read_frame(dirA, 0, b0f) != 3145782) { return 3; }
    let f:i64 = 0;
    while (f < 48) {
        if (v_read_frame(dirA, f, b0) != 3145782) { _zag_print("read err A f="); _zag_println(_zag_i64_to_str(f)); return 3; }
        v_cell_masks(f, b0, masksA, f * 6400);
        if (v_read_frame(dirB, f, b0) != 3145782) { _zag_print("read err B f="); _zag_println(_zag_i64_to_str(f)); return 4; }
        v_cell_masks(f, b0, masksB, f * 6400);
        v_control_masks(f, b0f, masksC, f * 6400);
        f = f + 1;
    }
    let a_fl:i64 = 0; let a_fo:i64 = 0;
    let b_fl:i64 = 0; let b_fo:i64 = 0;
    let c_fl:i64 = 0; let c_fo:i64 = 0;
    v_t1_masks(masksA, &a_fl, &a_fo);
    v_t1_masks(masksB, &b_fl, &b_fo);
    v_t1_masks(masksC, &c_fl, &c_fo);
    let t1A:i64 = 0 - 1;
    if (a_fo > 0) { t1A = a_fl * 1000 / a_fo; }
    let t1B:i64 = 0 - 1;
    if (b_fo > 0) { t1B = b_fl * 1000 / b_fo; }
    let t1C:i64 = 0 - 1;
    if (c_fo > 0) { t1C = c_fl * 1000 / c_fo; }
    _zag_print("T1 rotating-frame: A_pm="); _zag_print(_zag_i64_to_str(t1A));
    _zag_print(" (foam cells "); _zag_print(_zag_i64_to_str(a_fo)); _zag_print(")");
    _zag_print(" B_pm="); _zag_print(_zag_i64_to_str(t1B));
    _zag_print(" (foam cells "); _zag_print(_zag_i64_to_str(b_fo)); _zag_println(")");
    _zag_print("TRUST GATE: control_pm="); _zag_print(_zag_i64_to_str(t1C));
    let cap:i64 = 0 - 1;
    if (t1A > 0) { cap = t1A * 250 / 1000; }
    _zag_print(" cap_pm="); _zag_println(_zag_i64_to_str(cap));
    let gateok:i64 = 0;
    if (t1C >= 0 && cap >= 0 && t1C <= cap) { gateok = 1; }
    _zag_print("GATE (control<=cap): ");
    if (gateok == 1) { _zag_println("PASS"); } else { _zag_println("FAIL -> T1 UNVERIFIABLE"); }
    let t1bar:i64 = 0;
    if (gateok == 1 && t1A > 0 && t1B >= 0 && t1B * 1000 <= t1A * 700) { t1bar = 1; }
    _zag_print("T1 BAR (B<=0.7*A): ");
    if (t1bar == 1) { _zag_println("PASS"); } else { _zag_println("FAIL"); }
    // ---- T1 screen-space diagnostic (V1 metric; NO verdict weight) ----
    let d_dfl:i64 = 0; let d_dfo:i64 = 0; let d_bfl:i64 = 0; let d_bfo:i64 = 0;
    let e_dfl:i64 = 0; let e_dfo:i64 = 0; let e_bfl:i64 = 0; let e_bfo:i64 = 0;
    f = 0;
    while (f < 47) {
        let dfl:i64 = 0; let dfo:i64 = 0; let bfl:i64 = 0; let bfo:i64 = 0;
        let rc:i64 = v_t1_pair(f, dirA, b0, b1, &dfl, &dfo, &bfl, &bfo);
        if (rc != 0) { _zag_print("read err A f="); _zag_println(_zag_i64_to_str(f)); return 3; }
        d_dfl = d_dfl + dfl; d_dfo = d_dfo + dfo;
        d_bfl = d_bfl + bfl; d_bfo = d_bfo + bfo;
        let dfl2:i64 = 0; let dfo2:i64 = 0; let bfl2:i64 = 0; let bfo2:i64 = 0;
        rc = v_t1_pair(f, dirB, b0, b1, &dfl2, &dfo2, &bfl2, &bfo2);
        if (rc != 0) { _zag_print("read err B f="); _zag_println(_zag_i64_to_str(f)); return 4; }
        e_dfl = e_dfl + dfl2; e_dfo = e_dfo + dfo2;
        e_bfl = e_bfl + bfl2; e_bfo = e_bfo + bfo2;
        f = f + 1;
    }
    let t1Ad:i64 = 0 - 1;
    if (d_dfo > 0) { t1Ad = d_dfl * 1000 / d_dfo; }
    let t1Bd:i64 = 0 - 1;
    if (e_dfo > 0) { t1Bd = e_dfl * 1000 / e_dfo; }
    _zag_print("T1 screen-space DIAGNOSTIC (no weight): A_pm=");
    _zag_print(_zag_i64_to_str(t1Ad));
    _zag_print(" B_pm="); _zag_println(_zag_i64_to_str(t1Bd));
    // ---- T2 over 47 pairs ----
    let t2a_tot:i64 = 0; let t2b_tot:i64 = 0;
    let t2b_min:i64 = 1000000000; let t2b_max:i64 = 0;
    let t2a_min:i64 = 1000000000; let t2a_max:i64 = 0;
    f = 0;
    _zag_println("pair f | t2A_p2 t2B_p2");
    while (f < 47) {
        if (v_read_frame(dirA, f, b0) != 3145782) { return 3; }
        if (v_read_frame(dirA, f + 1, b1) != 3145782) { return 3; }
        let s2a:i64 = v_t2_pair(b0, b1);
        let p2a:i64 = s2a * 10000 / 267386880;
        t2a_tot = t2a_tot + p2a;
        if (p2a < t2a_min) { t2a_min = p2a; }
        if (p2a > t2a_max) { t2a_max = p2a; }
        if (v_read_frame(dirB, f, b0) != 3145782) { return 4; }
        if (v_read_frame(dirB, f + 1, b1) != 3145782) { return 4; }
        let s2b:i64 = v_t2_pair(b0, b1);
        let p2b:i64 = s2b * 10000 / 267386880;
        t2b_tot = t2b_tot + p2b;
        if (p2b < t2b_min) { t2b_min = p2b; }
        if (p2b > t2b_max) { t2b_max = p2b; }
        _zag_print(_zag_i64_to_str(f));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str(p2a));
        _zag_print(" ");
        _zag_println(_zag_i64_to_str(p2b));
        f = f + 1;
    }
    let t2b_mean:i64 = t2b_tot / 47;
    let t2a_mean:i64 = t2a_tot / 47;
    _zag_print("T2 variant per-pair pct_x100: min="); _zag_print(_zag_i64_to_str(t2b_min));
    _zag_print(" max="); _zag_print(_zag_i64_to_str(t2b_max));
    _zag_print(" mean="); _zag_println(_zag_i64_to_str(t2b_mean));
    _zag_print("T2 baseline per-pair pct_x100: min="); _zag_print(_zag_i64_to_str(t2a_min));
    _zag_print(" max="); _zag_print(_zag_i64_to_str(t2a_max));
    _zag_print(" mean="); _zag_println(_zag_i64_to_str(t2a_mean));
    _zag_print("T2 BAR (all pairs in [50,1500]): ");
    if (t2b_min >= 50 && t2b_max <= 1500) { _zag_println("PASS"); } else { _zag_println("FAIL"); }
    // ---- T3 on f0 and f47 ----
    let lb:[]u8 = nio_alloc(1048576);
    let sm:[]u8 = nio_alloc(262144);
    if (lb.len == 0 || sm.len == 0) { return 5; }
    if (v_read_frame(dirA, 0, b0) != 3145782) { return 6; }
    let rA0:i64 = v_sharp(b0, lb, sm);
    if (v_read_frame(dirA, 47, b0) != 3145782) { return 6; }
    let rA47:i64 = v_sharp(b0, lb, sm);
    if (v_read_frame(dirB, 0, b0) != 3145782) { return 6; }
    let rB0:i64 = v_sharp(b0, lb, sm);
    if (v_read_frame(dirB, 47, b0) != 3145782) { return 6; }
    let rB47:i64 = v_sharp(b0, lb, sm);
    _zag_print("T3 sharp x1000: A_f0="); _zag_print(_zag_i64_to_str(rA0));
    _zag_print(" A_f47="); _zag_print(_zag_i64_to_str(rA47));
    _zag_print(" B_f0="); _zag_print(_zag_i64_to_str(rB0));
    _zag_print(" B_f47="); _zag_println(_zag_i64_to_str(rB47));
    let va0:i64 = rA0 - 1607;
    if (va0 < 0) { va0 = 0 - va0; }
    let va47:i64 = rA47 - 1543;
    if (va47 < 0) { va47 = 0 - va47; }
    let t3valid:i64 = 0;
    if (va0 <= 5 && va47 <= 5) { t3valid = 1; }
    _zag_print("T3 validation gate (baseline reproduces 1607/1543): ");
    if (t3valid == 1) { _zag_println("PASS"); } else { _zag_println("FAIL"); }
    let d0:i64 = rB0 - rA0;
    if (d0 < 0) { d0 = 0 - d0; }
    let d47:i64 = rB47 - rA47;
    if (d47 < 0) { d47 = 0 - d47; }
    let t3ok:i64 = 0;
    if (t3valid == 1 && rA0 > 0 && rA47 > 0 && d0 * 1000 <= rA0 * 50 && d47 * 1000 <= rA47 * 50) { t3ok = 1; }
    _zag_print("T3 BAR (within 5pct on f0,f47): ");
    if (t3ok == 1) { _zag_println("PASS"); } else { _zag_println("FAIL"); }
    nio_free(lb);
    nio_free(sm);
    nio_free(masksA);
    nio_free(masksB);
    nio_free(masksC);
    nio_free(b0);
    nio_free(b1);
    nio_free(b0f);
    nio_free(dirA);
    nio_free(dirB);
    return 0;
}

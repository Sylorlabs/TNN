// exp1c_agent_i.zag -- EXP1c I arms: compositional-choice deliberation.
// Implements PREREG_EXP1c (frozen 2026-09-27, wave-20260927-1121pdt) M1-M4.
// M1: a plan is a sequence of at most 3 PRIMITIVE actions from
//     {LEFT, RIGHT, EAT, TAKE, DROP, COMBINE, WAIT}. The candidate set is the
//     full enumeration of 7^1 + 7^2 + 7^3 = 399 sequences, length-ascending
//     lex order. Pure combinatorics; no authored productivity bias.
// M2: 1200 ticks per run (horizon constant H_T lives in the runner).
// M3: score(sketch) = mean experienced delta-energy + B0(n), where
//     B0(n) = B0/(1+n) and n is the number of times the sketch has been
//     tried (integer division, exact floor for non-negative operands).
//     I-survive uses B0=40, I-invent uses B0=120, same decay rule. The two B0
//     values are passed in by the runner; no other bonus constant exists in
//     this file and no per-composition bonuses exist anywhere.
// M4: exactly the following preempting single-step reflexes, and no others:
//     (a) storm-active and in-zone and unsheltered flees (taught H3);
//     (b) energy below 25 runs the survival reflex (taught H4);
//     (c) void-adjacent step refusal (void-safety, taught H9 in the EXP1c
//         training mass: "If the step you are about to take would land on a
//         void cell: refuse that step."). A step that would land on an
//         unplanked void cell (a killing step) is refused by substituting
//         WAIT; the plan position advances. A planked void cell is crossable
//         and is not refused.
// Zero RNG in decision paths. Deterministic argmax over candidates; ties go
// to the lowest candidate index. Open-loop plan execution; reflexes (a) and
// (b) never advance the plan. COMBINE uses a fixed deterministic arg rule:
// the two most recently taken inventory items; a safe no-op when fewer than
// 2 items are held.
// K7 instrumentation (frozen bar K7, choice-reality): enumeration-completion
// tick (the tick at which the 399th distinct sketch is credited), replan
// count, post-enumeration plan count, and the count of post-enumeration
// plans whose novelty bonus contributed less than 10 percent of the winning
// score (10*bonus < score, evaluated on the selection-time integers).
// Memory: JState holds ONE []i64 arena (shared); candidate tables are offset
// views (znc multi-slice workaround, same as EXP1/EXP1b).

@import("world.zag")

const J_NCAND:i32 = 399;
const J_POW:i32 = 343;
const J_CAND:i32 = 0;
const J_CVAL:i32 = 399;
const J_TRIED:i32 = 798;
const J_SCRATCHN:i32 = 1197;
const J_LOGN:i32 = 1600;

struct JState {
    mem:[]i64,
    base:i32,
    logbase:i32,
    B0:i32,
    ncand:i32,
    nlog:i32,
    cur_code:i64,
    cur_len:i32,
    cur_pos:i32,
    cur_idx:i32,
    e_before:i32,
    ca:i32,
    cb:i32,
    sel_score:i64,
    sel_bonus:i64,
    enum_done:i32,
    enum_tick:i32,
    n_replans:i32,
    n_distinct:i32,
    post_total:i32,
    post_low:i32,
}

fn j_pow7(e:i32)i64 {
    let r:i64 = 1;
    let k:i32 = 0;
    while (k < e) { r = r * 7; k = k + 1; }
    return r;
}

fn j_new(mem:[]i64, base:i32, logbase:i32, B0:i32)JState {
    let st:JState = JState{
        .mem=mem, .base=base, .logbase=logbase,
        .B0=B0,
        .ncand=0, .nlog=0,
        .cur_code=0, .cur_len=0, .cur_pos=0, .cur_idx=0,
        .e_before=W_E0, .ca=-1, .cb=-1,
        .sel_score=0, .sel_bonus=0,
        .enum_done=0, .enum_tick=-1,
        .n_replans=0, .n_distinct=0,
        .post_total=0, .post_low=0,
    };
    let i:i32 = 0;
    while (i < J_SCRATCHN) { mem[base+i] = 0; i = i+1; }
    let g:i32 = j_gen(&st);
    return st;
}

fn j_gen(st:*JState)i32 {
    let n:i32 = 0;
    let len:i32 = 1;
    while (len <= 3) {
        let lim:i64 = j_pow7(len);
        let d:i64 = 0;
        while (d < lim) {
            st.mem[st.base+J_CAND+n] = (len as i64)*(J_POW as i64) + d;
            st.mem[st.base+J_CVAL+n] = 0;
            st.mem[st.base+J_TRIED+n] = 0;
            n = n + 1;
            d = d + 1;
        }
        len = len + 1;
    }
    st.ncand = n;
    return n;
}

// M3 decay schedule, frozen text: B0(n) = B0/(1+n).
fn j_bonus(B0:i32, n:i64)i64 {
    return (B0 as i64) / (1 + n);
}

fn j_pick(st:*JState)i32 {
    let best:i32 = 0;
    let bv:i64 = -999999999;
    let bb:i64 = 0;
    let k:i32 = 0;
    while (k < st.ncand) {
        let n:i64 = st.mem[st.base+J_TRIED+k];
        let bonus:i64 = j_bonus(st.B0, n);
        let v:i64 = st.mem[st.base+J_CVAL+k] + bonus;
        if (v > bv) { bv = v; best = k; bb = bonus; }
        k = k+1;
    }
    st.sel_score = bv;
    st.sel_bonus = bb;
    return best;
}

fn j_len(code:i64)i32 {
    return (code / (J_POW as i64)) as i32;
}

fn j_tok(code:i64, pos:i32)i32 {
    let d:i64 = code % (J_POW as i64);
    return ((d / j_pow7(pos)) % 7) as i32;
}

fn j_credit(w:*World, st:*JState)i32 {
    if (st.cur_len > 0) {
        let delta:i32 = w.energy - st.e_before;
        let k:i32 = st.cur_idx;
        let old:i64 = st.mem[st.base+J_CVAL+k];
        let n:i64 = st.mem[st.base+J_TRIED+k];
        st.mem[st.base+J_CVAL+k] = (old*n + delta as i64) / (n + 1);
        st.mem[st.base+J_TRIED+k] = n + 1;
        if (n == 0) {
            st.n_distinct = st.n_distinct + 1;
            if (st.n_distinct >= st.ncand && st.enum_done == 0) {
                st.enum_done = 1;
                st.enum_tick = w.tick;
            }
        }
    }
    return 0;
}

fn j_act(w:*World, st:*JState)i32 {
    // M4(a): storm-active and in-zone and unsheltered flees (taught H3).
    // Preempting; does not advance the plan.
    if (w_storm_active(w) == 1 && w_in_zone(w) == 1 && w_sheltered(w) == 0) {
        return w_reflex_storm(w);
    }
    // M4(b): energy below 25 runs the survival reflex (taught H4).
    // Preempting; does not advance the plan.
    if (w.energy < 25) {
        return w_reflex_emergency(w);
    }
    if (st.cur_pos >= st.cur_len) {
        let c:i32 = j_credit(w, st);
        let pk:i32 = j_pick(st);
        st.cur_idx = pk;
        st.cur_code = st.mem[st.base+J_CAND+pk];
        st.cur_len = j_len(st.cur_code);
        st.cur_pos = 0;
        st.e_before = w.energy;
        st.n_replans = st.n_replans + 1;
        // K7 accounting: plans selected after enumeration completed.
        // enum_done is set by j_credit above when the 399th distinct sketch
        // is credited, so a pick in this same call is the first
        // post-enumeration plan.
        if (st.enum_done == 1) {
            st.post_total = st.post_total + 1;
            if (10*st.sel_bonus < st.sel_score) {
                st.post_low = st.post_low + 1;
            }
        }
        if (st.nlog < J_LOGN) {
            st.mem[st.logbase+st.nlog] = (w.tick as i64)*4294967296 + st.cur_code;
            st.nlog = st.nlog + 1;
        }
    }
    let tok:i32 = j_tok(st.cur_code, st.cur_pos);
    st.cur_pos = st.cur_pos + 1;
    // M4(c): void-adjacent step refusal (taught H9). A plan step that would
    // land on an unplanked void cell is refused (WAIT substituted); the plan
    // position advances. This is a safety override, not a plan.
    if (tok == A_LEFT || tok == A_RIGHT) {
        let np:i32 = w.apos;
        if (tok == A_LEFT) { np = w.apos - 1; }
        if (tok == A_RIGHT) { np = w.apos + 1; }
        if ((np == w.void0 || np == w.void1) && w.mem[w.base+O_PLANKED+np] == 0) {
            return A_WAIT;
        }
    }
    st.ca = -1;
    st.cb = -1;
    if (tok == A_COMBINE && w.inv_n >= 2) {
        st.ca = w.inv_n - 2;
        st.cb = w.inv_n - 1;
    }
    return tok;
}

fn j_end(w:*World, st:*JState)i32 {
    return j_credit(w, st);
}

    p.void0 = 16; p.void1 = 17; p.start = 20; p.home = 22;
    m[b+V_CRYS+0]=19; m[b+V_CRYS+1]=21; m[b+V_CRYS+2]=6; m[b+V_CRYS+3]=12;
    m[b+V_SS+0]=255; m[b+V_SS+1]=605; m[b+V_SS+2]=955;
    m[b+V_SE+0]=290; m[b+V_SE+1]=640; m[b+V_SE+2]=990;
    m[b+V_MPOS+0]=18; m[b+V_MVEL+0]=1;  m[b+V_MLO+0]=18; m[b+V_MHI+0]=18; m[b+V_MRESP+0]=18; m[b+V_MDEEP+0]=0;
    m[b+V_MPOS+1]=19; m[b+V_MVEL+1]=-1; m[b+V_MLO+1]=19; m[b+V_MHI+1]=19; m[b+V_MRESP+1]=19; m[b+V_MDEEP+0]=0;
    m[b+V_MPOS+2]=21; m[b+V_MVEL+2]=1;  m[b+V_MLO+2]=21; m[b+V_MHI+2]=21; m[b+V_MRESP+2]=21; m[b+V_MDEEP+0]=0;
    m[b+V_MPOS+3]=23; m[b+V_MVEL+3]=-1; m[b+V_MLO+3]=23; m[b+V_MHI+3]=23; m[b+V_MRESP+3]=23; m[b+V_MDEEP+0]=0;
    m[b+V_MPOS+4]=5;  m[b+V_MVEL+4]=1;  m[b+V_MLO+4]=3;  m[b+V_MHI+4]=7;  m[b+V_MRESP+4]=5;  m[b+V_MDEEP+4]=1;
    m[b+V_MPOS+5]=13; m[b+V_MVEL+5]=-1; m[b+V_MLO+5]=11; m[b+V_MHI+5]=15; m[b+V_MRESP+5]=13; m[b+V_MDEEP+5]=1;
    return 0;
}

// v6_badmot: 1 if mote i violates the frozen retune rules, else 0.
fn v6_badmot(p:*VParams, i:i32)i32 {
    let b:i32 = p.base;
    let m:[]i32 = p.mem;
    let vel:i32 = m[b+V_MVEL+i];
    let av:i32 = vel;
    if (av < 0) { av = 0 - av; }
    if (av != 1 && av != 2) { return 1; }
    let resp:i32 = m[b+V_MRESP+i];
    if (resp == p.home || resp == p.start) { return 1; }
    let pos:i32 = m[b+V_MPOS+i];
    if (pos == p.home) { return 1; }
    let lo:i32 = m[b+V_MLO+i];
    let hi:i32 = m[b+V_MHI+i];
    if (p.home >= lo && p.home <= hi) { return 1; }
    return 0;
}

// v6_badworld: 1 if the variant violates structural rules, else 0.
fn v6_badworld(p:*VParams)i32 {
    let b:i32 = p.base;
    let m:[]i32 = p.mem;
    if (p.void1 != p.void0 + 1) { return 1; }
    if (p.void0 < 1 || p.void1 > 22) { return 1; }
    let deep:i32 = 0;
    let i:i32 = 0;
    while (i < 6) {
        if (m[b+V_MDEEP+i] == 1) {
            deep = deep + 1;
            let lo:i32 = m[b+V_MLO+i];
            let hi:i32 = m[b+V_MHI+i];
            if (p.start > p.void1) {
                if (hi > p.void0) { return 1; }
            } else {
                if (lo < p.void1) { return 1; }
            }
        }
        i = i+1;
    }
    if (deep != 2) { return 1; }
    i = 0;
    while (i < 3) {
        let ss:i32 = m[b+V_SS+i];
        let se:i32 = m[b+V_SE+i];
        if (ss < 0 || se > 1200 || se <= ss) { return 1; }
        i = i+1;
    }
    return 0;
}

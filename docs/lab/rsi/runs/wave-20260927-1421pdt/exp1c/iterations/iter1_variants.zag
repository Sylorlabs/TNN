        m[b+V_MPOS+1]=18; m[b+V_MVEL+1]=-1; m[b+V_MLO+1]=16; m[b+V_MHI+1]=19; m[b+V_MRESP+1]=18; m[b+V_MDEEP+1]=0;
        m[b+V_MPOS+2]=15; m[b+V_MVEL+2]=1;  m[b+V_MLO+2]=15; m[b+V_MHI+2]=17; m[b+V_MRESP+2]=15; m[b+V_MDEEP+2]=0;

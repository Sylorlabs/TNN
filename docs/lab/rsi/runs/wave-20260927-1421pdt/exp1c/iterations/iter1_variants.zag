// exp1c_variants.zag -- EXP1c 12 world variants, retune iteration 1
// (frozen 2026-09-27, implemented wave-20260927-1421pdt under PREREG_EXP1c M5).
// Retune rules (inherited frozen rules from EXP1b M1, applied to the 1200-tick
// horizon): every mote |v| in {1,2} (no stationary motes); no mote respawns
// at home or start; home lies in no mote drift range; exactly 2 deep (+40)
// motes confined past the void; void is 2 adjacent cells; 4 crystals;
// 3 storms with start/end inside ticks 0..1199.
// Geometry inherits EXP1b retune 3 (v2_fill): the 4-mote local cluster sits
// adjacent to home and start is near the cluster, so the taught ward-turtle
// (arm P) has its proven zero-basal base. Storm times are rescaled from the
// 600-tick EXP1b layout to span the 1200-tick EXP1c horizon (thirds with
// per-variant jitter, durations 30-40 ticks). Disjoint from EXP1 variants.
// Reuses VParams/v_apply from variants.zag; physics from world.zag unchanged.

@import("variants.zag")

fn v3_fill(v:i32, p:*VParams)i32 {
    let b:i32 = p.base;
    let m:[]i32 = p.mem;
    if (v == 0) {
        p.void0 = 10; p.void1 = 11; p.start = 14; p.home = 20;
        m[b+V_CRYS+0]=13; m[b+V_CRYS+1]=16; m[b+V_CRYS+2]=22; m[b+V_CRYS+3]=5;
        m[b+V_SS+0]=240; m[b+V_SS+1]=590; m[b+V_SS+2]=940;
        m[b+V_SE+0]=270; m[b+V_SE+1]=625; m[b+V_SE+2]=975;

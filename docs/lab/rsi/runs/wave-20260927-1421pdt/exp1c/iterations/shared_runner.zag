// exp1c_runner.zag -- EXP1c run harness (frozen 2026-09-27, PREREG_EXP1c).
// Modes (argv[1]): "run" (default): 60 runs (12 variants x 5 arms, 1200
// ticks) + TSV + traces + plan logs + run summaries + medians (two
// independent computations) + kill-bar checks (C1/C2/K1/K2/K3) + K7
// choice-reality + A2 ablation + top sketches for the K4 novelty audit,
// all printed to stdout. "variants": print the 12 frozen EXP1c variant
// parameter files (retune iteration 1). "calibrate": scripted-strategy
// check for C1/C2/C3 (forage, ward-turtle, lamp-farm, void-cross, plus Z).
// "check": verify the frozen retune rules on all 12 variants.
// All analysis is done in Zag; the shell only invokes the compiler,
// redirects stdout, and hashes outputs. Determinism: every run is executed
// twice at the shell level and the SHA-256 of the full stdout must be
// byte-identical. Zero RNG in agent decision paths (Z's LCG is a documented
// control, not the AI).
// Memory: exactly ONE []i32, ONE []u8, ONE []i64 arena per execution,
// partitioned by offsets (znc multi-slice workaround, verified 2026-09-27).

@import("world.zag")
@import("variants.zag")
@import("exp1c_variants_r5.zag")
@import("lcg.zag")
@import("agent_p.zag")
@import("agent_z.zag")
@import("agent_r.zag")
@import("exp1c_agent_i.zag")

// EXP1c horizon (M2: 1200 ticks per run). world.zag's W_T is the inherited
// frozen physics template's constant; the experiment horizon lives here.
const H_T:i32 = 1200;
const H_B0S:i32 = 40;
const H_B0I:i32 = 120;

// i32 arena layout (1024)
const X_WBASE:i32 = 0;
const X_VBASE:i32 = 196;
const X_RBASE:i32 = 242;
const X_NBASE:i32 = 422;
// per I-run stats at X_NBASE + lslot*5: nlog, enum_tick, n_replans,
// post_total, post_low
// u8 arena layout (76096): traces 60*1200 at 0, print buffer at 72000
const X_TBASE:i32 = 0;
const X_PBUF:i32 = 72000;
const X_PCAP:i32 = 4096;
// i64 arena layout (40000): candidate tables 0..1196, plan logs at 1200+
const X_JLOGBASE:i32 = 1200;
const X_JLOGSZ:i32 = 1600;

struct Ctx {
    b8:[]u8,
    i32a:[]i32,
    i64a:[]i64,
}

struct Buf {
    arena:[]u8,
    base:i32,
    pos:i32,
    cap:i32,
}

fn o_new(arena:[]u8, base:i32, cap:i32)Buf {
    return Buf{.arena=arena, .base=base, .pos=0, .cap=cap};
}

fn o_str(b:*Buf, s:[]u8)i32 {
    let i:i32 = 0;
    while (i < s.len) {
        if (b.pos < b.cap) { b.arena[b.base+b.pos] = s[i]; b.pos = b.pos+1; }
        i = i+1;
    }
    return 0;
}

fn o_ch(b:*Buf, c:u8)i32 {
    if (b.pos < b.cap) { b.arena[b.base+b.pos] = c; b.pos = b.pos+1; }
    return 0;
}

fn o_i32(b:*Buf, v:i32)i32 {
    let x:i32 = v;
    if (x < 0) { o_ch(b, 45); x = 0 - x; }
    if (x == 0) { o_ch(b, 48); return 0; }
    let tmp:*u8 = _zag_malloc(16);
    let t:[]u8 = tmp[0..16];
    let n:i32 = 0;
    while (x > 0) { t[15-n] = (48 + x%10) as u8; x = x/10; n = n+1; }
    let j:i32 = 0;
    while (j < n) { o_ch(b, t[16-n+j]); j = j+1; }
    return 0;
}

fn o_i64(b:*Buf, v:i64)i32 {
    let x:i64 = v;
    if (x < 0) { o_ch(b, 45); x = 0 - x; }
    if (x == 0) { o_ch(b, 48); return 0; }
    let tmp:*u8 = _zag_malloc(32);
    let t:[]u8 = tmp[0..32];
    let n:i32 = 0;
    while (x > 0) { t[31-n] = (48 + (x%10) as i32) as u8; x = x/10; n = n+1; }
    let j:i32 = 0;
    while (j < n) { o_ch(b, t[32-n+j]); j = j+1; }
    return 0;
}

fn o_tab(b:*Buf)i32 { return o_ch(b, 9); }

fn o_nl(b:*Buf)i32 {
    let t:*u8 = _zag_malloc(b.pos);
    let ts:[]u8 = t[0..b.pos];
    let i:i32 = 0;
    while (i < b.pos) { ts[i] = b.arena[b.base+i]; i = i+1; }
    _zag_println(ts);
    b.pos = 0;
    return 0;
}

fn o_arm_name(b:*Buf, arm:i32)i32 {
    if (arm == 0) { o_str(b, "P"); }
    if (arm == 1) { o_str(b, "Z"); }
    if (arm == 2) { o_str(b, "R"); }
    if (arm == 3) { o_str(b, "I-survive"); }
    if (arm == 4) { o_str(b, "I-invent"); }
    return 0;
}

struct RunRes {
    ticks:i32,
    cause:i32,
    e_end:i32,
}

fn act_char(a:i32)u8 {
    if (a == A_LEFT) { return 76; }
    if (a == A_RIGHT) { return 82; }
    if (a == A_EAT) { return 69; }
    if (a == A_TAKE) { return 84; }
    if (a == A_DROP) { return 68; }
    if (a == A_COMBINE) { return 67; }
    return 87;
}

fn run_one(ctx:*Ctx, v:i32, arm:i32, tslot:i32, lslot:i32)RunRes {
    let w:World = w_new(ctx.i32a, X_WBASE);
    let vp:VParams = VParams{.mem=ctx.i32a, .base=X_VBASE, .void0=0, .void1=0, .start=0, .home=0};
    let vf:i32 = v7_fill(v, &vp);
    let va:i32 = v_apply(&w, &vp);
    let tbase:i32 = X_TBASE + tslot*H_T;
    let t:i32 = 0;
    if (arm == 0) {
        let st:PState = p_new(&w);
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = p_act(&w, &st);
            ctx.b8[tbase+t] = act_char(a); t = t+1;
            w_step(&w, a, st.ca, st.cb);
        }
    }
    if (arm == 1) {
        let st:ZState = z_new(v);
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = z_act(&w, &st);
            ctx.b8[tbase+t] = act_char(a); t = t+1;
            w_step(&w, a, 0, 1);
        }
    }
    if (arm == 2) {
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = r_act(&w);
            ctx.b8[tbase+t] = act_char(a); t = t+1;
            w_step(&w, a, 0, 1);
        }
    }
    if (arm == 3) {
        let st:JState = j_new(ctx.i64a, 0, X_JLOGBASE+lslot*X_JLOGSZ, H_B0S);
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = j_act(&w, &st);
            ctx.b8[tbase+t] = act_char(a); t = t+1;
            w_step(&w, a, st.ca, st.cb);
        }
        j_end(&w, &st);
        ctx.i32a[X_NBASE+lslot*5+0] = st.nlog;
        ctx.i32a[X_NBASE+lslot*5+1] = st.enum_tick;
        ctx.i32a[X_NBASE+lslot*5+2] = st.n_replans;
        ctx.i32a[X_NBASE+lslot*5+3] = st.post_total;
        ctx.i32a[X_NBASE+lslot*5+4] = st.post_low;
    }
    if (arm == 4) {
        let st:JState = j_new(ctx.i64a, 0, X_JLOGBASE+lslot*X_JLOGSZ, H_B0I);
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = j_act(&w, &st);
            ctx.b8[tbase+t] = act_char(a); t = t+1;
            w_step(&w, a, st.ca, st.cb);
        }
        j_end(&w, &st);
        ctx.i32a[X_NBASE+lslot*5+0] = st.nlog;
        ctx.i32a[X_NBASE+lslot*5+1] = st.enum_tick;
        ctx.i32a[X_NBASE+lslot*5+2] = st.n_replans;
        ctx.i32a[X_NBASE+lslot*5+3] = st.post_total;
        ctx.i32a[X_NBASE+lslot*5+4] = st.post_low;
    }
    while (t < H_T) { ctx.b8[tbase+t] = 46; t = t+1; }
    return RunRes{.ticks=w.tick, .cause=w.cause, .e_end=w.energy};
}

// ---------- scripted calibration strategies (C3) ----------

struct CalState {
    phase:i32,
    ca:i32,
    cb:i32,
    lamp_cell:i32,
}

fn cal_has(w:*World, item:i32)i32 {
    let i:i32 = 0;
    while (i < w.inv_n) {
        if (w.mem[w.base+O_INV+i] == item) { return 1; }
        i = i+1;
    }
    return 0;
}

fn cal_find(w:*World, item:i32)i32 {
    let i:i32 = 0;
    while (i < w.inv_n) {
        if (w.mem[w.base+O_INV+i] == item) { return i; }
        i = i+1;
    }
    return -1;
}

fn cal_goto_take_crystal(w:*World)i32 {
    let c:i32 = w_nearest_crystal(w);
    if (c < 0) { return A_WAIT; }
    if (w.apos == c) { return A_TAKE; }
    return w_step_toward(w, c);
}

fn cal_goto_take_mote(w:*World)i32 {
    let m:i32 = w_nearest_mote(w);
    if (m < 0) { return A_WAIT; }
    if (w.apos == w.mem[w.base+O_MPOS+m]) { return A_TAKE; }
    return w_step_toward(w, w.mem[w.base+O_MPOS+m]);
}

fn cal_lamp_act(w:*World, cs:*CalState)i32 {
    if (cs.phase == 0) {
        if (cal_has(w, IT_CRYSTAL) == 1) { cs.phase = 1; }
        else { return cal_goto_take_crystal(w); }
    }
    if (cs.phase == 1) {
        if (cal_has(w, IT_MOTE) == 1) {
            cs.ca = cal_find(w, IT_CRYSTAL);
            cs.cb = cal_find(w, IT_MOTE);
            cs.phase = 2;
            return A_COMBINE;
        }
        return cal_goto_take_mote(w);
    }
    if (cs.phase == 2) { cs.phase = 3; }
    if (cs.phase == 3) {
        cs.lamp_cell = w.apos;
        cs.phase = 4;
        return A_DROP;
    }
    if (w_storm_active(w) == 1 || w_storm_within(w, 20) == 1) {
        if (w_in_zone(w) == 1 && w_sheltered(w) == 0) { return w_reflex_storm(w); }
    }
    if (w.energy < 25) { return w_reflex_emergency(w); }
    if (w_mote_on_cell(w) == 1) { return A_EAT; }
    let m:i32 = w_nearest_mote(w);
    if (m >= 0) { return w_step_toward(w, w.mem[w.base+O_MPOS+m]); }
    let d:i32 = w.apos - cs.lamp_cell;
    if (d < 0) { d = 0 - d; }
    if (d > 3) { return w_step_toward(w, cs.lamp_cell); }
    return A_WAIT;
}

fn cal_plank_act(w:*World, cs:*CalState)i32 {
    if (cs.phase == 0) {
        if (cal_has(w, IT_CRYSTAL) == 1) { cs.phase = 1; }
        else { return cal_goto_take_crystal(w); }
    }
    if (cs.phase == 1) {
        if (cal_has(w, IT_MOTE) == 1) {
            cs.ca = cal_find(w, IT_CRYSTAL);
            cs.cb = cal_find(w, IT_MOTE);
            cs.phase = 2;
            return A_COMBINE;
        }
        return cal_goto_take_mote(w);
    }
    if (cs.phase == 2) {
        if (cal_has(w, IT_LAMP) == 1 && cal_has(w, IT_CRYSTAL) == 1) {
            cs.ca = cal_find(w, IT_LAMP);
            cs.cb = cal_find(w, IT_CRYSTAL);
            cs.phase = 3;
            return A_COMBINE;
        }
        if (cal_has(w, IT_LAMP) == 0) { cs.phase = 0; return A_WAIT; }
        return cal_goto_take_crystal(w);
    }
    if (cs.phase == 3) {
        if (cal_has(w, IT_BEACON) == 1 && cal_has(w, IT_CRYSTAL) == 1) {
            cs.ca = cal_find(w, IT_BEACON);
            cs.cb = cal_find(w, IT_CRYSTAL);
            cs.phase = 4;
            return A_COMBINE;
        }
        if (cal_has(w, IT_BEACON) == 0) { cs.phase = 2; return A_WAIT; }
        return cal_goto_take_crystal(w);
    }
    if (cs.phase == 4) {
        if (cal_has(w, IT_PLANK) == 1) { cs.phase = 5; }
        else { cs.phase = 3; return A_WAIT; }
    }
    if (cs.phase == 5) {
        let c1:i32 = w.void0 - 1;
        let c2:i32 = w.void1 + 1;
        let tg:i32 = c1;
        if (c1 < 0) { tg = c2; }
        if (c2 < 24 && c1 >= 0) {
            let d1:i32 = w.apos - c1; if (d1 < 0) { d1 = 0 - d1; }
            let d2:i32 = w.apos - c2; if (d2 < 0) { d2 = 0 - d2; }
            if (d2 < d1) { tg = c2; }
        }
        if (w.apos == tg) { cs.phase = 6; return A_DROP; }
        if (w_storm_active(w) == 1 && w_in_zone(w) == 1 && w_sheltered(w) == 0) {
            return w_reflex_storm(w);
        }
        return w_step_toward(w, tg);
    }
    if (w_storm_active(w) == 1 || w_storm_within(w, 20) == 1) {
        if (w_in_zone(w) == 1 && w_sheltered(w) == 0) { return w_reflex_storm(w); }
    }
    if (w.energy < 25) { return w_reflex_emergency(w); }
    if (w_mote_on_cell(w) == 1) { return A_EAT; }
    let m:i32 = w_nearest_mote(w);
    if (m >= 0) { return w_step_toward(w, w.mem[w.base+O_MPOS+m]); }
    return A_WAIT;
}

fn cal_run(ctx:*Ctx, v:i32, strat:i32)RunRes {
    let w:World = w_new(ctx.i32a, X_WBASE);
    let vp:VParams = VParams{.mem=ctx.i32a, .base=X_VBASE, .void0=0, .void1=0, .start=0, .home=0};
    let vf:i32 = v7_fill(v, &vp);
    let va:i32 = v_apply(&w, &vp);
    if (strat == 0) {
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = r_act(&w);
            w_step(&w, a, 0, 1);
        }
    }
    if (strat == 1) {
        let st:PState = p_new(&w);
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = p_act(&w, &st);
            w_step(&w, a, st.ca, st.cb);
        }
    }
    if (strat == 2) {
        let cs:CalState = CalState{.phase=0, .ca=0, .cb=1, .lamp_cell=0};
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = cal_lamp_act(&w, &cs);
            w_step(&w, a, cs.ca, cs.cb);
        }
    }
    if (strat == 3) {
        let cs:CalState = CalState{.phase=0, .ca=0, .cb=1, .lamp_cell=0};
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = cal_plank_act(&w, &cs);
            w_step(&w, a, cs.ca, cs.cb);
        }
    }
    if (strat == 4) {
        let st:ZState = z_new(v);
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = z_act(&w, &st);
            w_step(&w, a, 0, 1);
        }
    }
    return RunRes{.ticks=w.tick, .cause=w.cause, .e_end=w.energy};
}

// ---------- analysis helpers ----------

// Median via bubble-sorted copy (method 1).
fn med12(vals:[]i32, base:i32)i32 {
    let a0:i32 = vals[base+0]; let a1:i32 = vals[base+1];
    let a2:i32 = vals[base+2]; let a3:i32 = vals[base+3];
    let a4:i32 = vals[base+4]; let a5:i32 = vals[base+5];
    let a6:i32 = vals[base+6]; let a7:i32 = vals[base+7];
    let a8:i32 = vals[base+8]; let a9:i32 = vals[base+9];
    let a10:i32 = vals[base+10]; let a11:i32 = vals[base+11];
    let t:i32 = 0;
    let pass:i32 = 0;
    while (pass < 12) {
        if (a0 > a1) { t=a0; a0=a1; a1=t; }
        if (a1 > a2) { t=a1; a1=a2; a2=t; }
        if (a2 > a3) { t=a2; a2=a3; a3=t; }
        if (a3 > a4) { t=a3; a3=a4; a4=t; }
        if (a4 > a5) { t=a4; a4=a5; a5=t; }
        if (a5 > a6) { t=a5; a5=a6; a6=t; }
        if (a6 > a7) { t=a6; a6=a7; a7=t; }
        if (a7 > a8) { t=a7; a7=a8; a8=t; }
        if (a8 > a9) { t=a8; a8=a9; a9=t; }
        if (a9 > a10) { t=a9; a9=a10; a10=t; }
        if (a10 > a11) { t=a10; a10=a11; a11=t; }
        pass = pass + 1;
    }
    return (a5 + a6) / 2;
}

// Median via independent min-extraction sort (method 2, cross-check).
fn med12b(vals:[]i32, base:i32, scratch:i32)i32 {
    let i:i32 = 0;
    while (i < 12) {
        vals[scratch+i] = vals[base+i];
        vals[scratch+12+i] = 0;
        i = i+1;
    }
    let o:i32 = 0;
    while (o < 12) {
        let bi:i32 = -1;
        let bv:i32 = 0;
        i = 0;
        while (i < 12) {
            if (vals[scratch+12+i] == 0) {
                if (bi < 0 || vals[scratch+i] < bv) {
                    bi = i;
                    bv = vals[scratch+i];
                }
            }
            i = i+1;
        }
        vals[scratch+12+bi] = 1;
        vals[scratch+24+o] = bv;
        o = o + 1;
    }
    return (vals[scratch+24+5] + vals[scratch+24+6]) / 2;
}

fn ch2act(c:u8)i32 {
    if (c == 76) { return A_LEFT; }
    if (c == 82) { return A_RIGHT; }
    if (c == 69) { return A_EAT; }
    if (c == 84) { return A_TAKE; }
    if (c == 68) { return A_DROP; }
    if (c == 67) { return A_COMBINE; }
    return A_WAIT;
}

struct AblRes {
    ticks:i32,
    replaced:i32,
}

// A2 ablation: replay the I trace with every TAKE/COMBINE/DROP (the steps
// beyond the taught single-step machinery) replaced by the best taught
// single-step alternative (r_act). Measures whether the novel-composition
// steps did the survival work. K6 rule (documented in evidence): K6 fires
// iff median(ablated I-survive) >= median(original I-survive).
fn ablate(ctx:*Ctx, v:i32, tslot:i32)AblRes {
    let w:World = w_new(ctx.i32a, X_WBASE);
    let vp:VParams = VParams{.mem=ctx.i32a, .base=X_VBASE, .void0=0, .void1=0, .start=0, .home=0};
    let vf:i32 = v7_fill(v, &vp);
    let va:i32 = v_apply(&w, &vp);
    let tbase:i32 = X_TBASE + tslot*H_T;
    let replaced:i32 = 0;
    let t:i32 = 0;
    while (w.alive == 1 && w.tick < H_T && t < H_T) {
        let c:u8 = ctx.b8[tbase+t];
        if (c == 46) { break; }
        let a:i32 = ch2act(c);
        if (a == A_TAKE || a == A_COMBINE || a == A_DROP) {
            replaced = replaced + 1;
            let ra:i32 = r_act(&w);
            w_step(&w, ra, 0, 1);
        } else {
            w_step(&w, a, 0, 1);
        }
        t = t+1;
    }
    return AblRes{.ticks=w.tick, .replaced=replaced};
}

fn o_plan(b:*Buf, code:i64)i32 {
    let len:i32 = j_len(code);
    let k:i32 = 0;
    while (k < len) {
        if (k > 0) { o_ch(b, 44); }
        let s:i32 = j_tok(code, k);
        o_ch(b, act_char(s));
        k = k+1;
    }
    return 0;
}

// Top-8 sketches by final mean credit (ties: lower candidate index first),
// for the K4 novelty audit.
fn o_topsketch(ctx:*Ctx, b:*Buf, v:i32, arm:i32)i32 {
    let lastv:i64 = 999999;
    let lasti:i32 = -1;
    let p:i32 = 0;
    while (p < 8) {
        let bv:i64 = -999999;
        let bi:i32 = -1;
        let k:i32 = 0;
        while (k < J_NCAND) {
            let vv:i64 = ctx.i64a[J_CVAL+k];
            let ok:i32 = 0;
            if (vv < lastv) { ok = 1; }
            else {
                if (vv == lastv && k > lasti) { ok = 1; }
            }
            if (ok == 1) {
                if (bi < 0 || vv > bv) { bv = vv; bi = k; }
            }
            k = k+1;
        }
        if (bi < 0) { break; }
        o_i32(b, v); o_tab(b);
        o_arm_name(b, arm); o_tab(b);
        o_i32(b, p); o_tab(b);
        o_plan(b, ctx.i64a[J_CAND+bi]); o_tab(b);
        o_i64(b, ctx.i64a[J_TRIED+bi]); o_tab(b);
        o_i64(b, bv); o_nl(b);
        lastv = bv;
        lasti = bi;
        p = p+1;
    }
    return 0;
}

// ---------- modes ----------

fn mode_check(ctx:*Ctx)i32 {
    let b:Buf = o_new(ctx.b8, X_PBUF, X_PCAP);
    let vp:VParams = VParams{.mem=ctx.i32a, .base=X_VBASE, .void0=0, .void1=0, .start=0, .home=0};
    let bad:i32 = 0;
    let v:i32 = 0;
    while (v < 12) {
        let vf:i32 = v7_fill(v, &vp);
        let i:i32 = 0;
        while (i < 6) {
            if (v7_badmot(&vp, i) == 1) {
                o_str(&b, "VIOLATION variant "); o_i32(&b, v);
                o_str(&b, " mote "); o_i32(&b, i); o_nl(&b);
                bad = bad + 1;
            }
            i = i+1;
        }
        if (v7_badworld(&vp) == 1) {
            o_str(&b, "VIOLATION variant "); o_i32(&b, v);
            o_str(&b, " world-structural"); o_nl(&b);
            bad = bad + 1;
        }
        v = v+1;
    }
    if (bad == 0) { o_str(&b, "CHECK_OK"); o_nl(&b); }
    else { o_str(&b, "CHECK_FAIL "); o_i32(&b, bad); o_nl(&b); }
    return 0;
}

fn mode_variants(ctx:*Ctx)i32 {
    let b:Buf = o_new(ctx.b8, X_PBUF, X_PCAP);
    let vp:VParams = VParams{.mem=ctx.i32a, .base=X_VBASE, .void0=0, .void1=0, .start=0, .home=0};
    let v:i32 = 0;
    while (v < 12) {
        let vf:i32 = v7_fill(v, &vp);
        let bb:i32 = vp.base;
        let m:[]i32 = vp.mem;
        o_str(&b, "=== VARIANT "); o_i32(&b, v); o_str(&b, " ==="); o_nl(&b);
        o_str(&b, "# TIDELOCK EXP1c world variant "); o_i32(&b, v);
        o_str(&b, " (retune iteration 1, frozen 2026-09-27)"); o_nl(&b);
        o_str(&b, "variant "); o_i32(&b, v); o_nl(&b);
        o_str(&b, "void "); o_i32(&b, vp.void0); o_ch(&b, 32); o_i32(&b, vp.void1); o_nl(&b);
        o_str(&b, "start "); o_i32(&b, vp.start); o_nl(&b);
        o_str(&b, "home "); o_i32(&b, vp.home); o_nl(&b);
        o_str(&b, "crystals");
        let i:i32 = 0;
        while (i < 4) { o_ch(&b, 32); o_i32(&b, m[bb+V_CRYS+i]); i = i+1; }
        o_nl(&b);
        o_str(&b, "storms");
        i = 0;
        while (i < 3) {
            o_ch(&b, 32); o_i32(&b, m[bb+V_SS+i]);
            o_ch(&b, 32); o_i32(&b, m[bb+V_SE+i]);
            i = i+1;
        }
        o_nl(&b);
        o_str(&b, "motes 6"); o_nl(&b);
        i = 0;
        while (i < 6) {
            o_str(&b, "mote ");
            o_i32(&b, m[bb+V_MPOS+i]); o_ch(&b, 32);
            o_i32(&b, m[bb+V_MVEL+i]); o_ch(&b, 32);
            o_i32(&b, m[bb+V_MLO+i]); o_ch(&b, 32);
            o_i32(&b, m[bb+V_MHI+i]); o_ch(&b, 32);
            o_i32(&b, m[bb+V_MRESP+i]); o_ch(&b, 32);
            o_i32(&b, m[bb+V_MDEEP+i]); o_nl(&b);
            i = i+1;
        }
        v = v+1;
    }
    return 0;
}

fn o_strat_name(b:*Buf, s:i32)i32 {
    if (s == 0) { o_str(b, "forage"); }
    if (s == 1) { o_str(b, "ward-turtle"); }
    if (s == 2) { o_str(b, "lamp-farm"); }
    if (s == 3) { o_str(b, "void-cross"); }
    if (s == 4) { o_str(b, "Z"); }
    return 0;
}

fn mode_calibrate(ctx:*Ctx)i32 {
    let b:Buf = o_new(ctx.b8, X_PBUF, X_PCAP);
    o_str(&b, "strategy\tvariant\tticks\tcause\te_end"); o_nl(&b);
    let meds0:i32 = 0; let meds1:i32 = 0; let meds2:i32 = 0; let meds3:i32 = 0; let meds4:i32 = 0;
    let s:i32 = 0;
    while (s < 5) {
        let vvbase:i32 = 900;
        let v:i32 = 0;
        while (v < 12) {
            let r:RunRes = cal_run(ctx, v, s);
            ctx.i32a[vvbase+v] = r.ticks;
            o_strat_name(&b, s); o_tab(&b);
            o_i32(&b, v); o_tab(&b);
            o_i32(&b, r.ticks); o_tab(&b);
            o_i32(&b, r.cause); o_tab(&b);
            o_i32(&b, r.e_end); o_nl(&b);
            v = v+1;
        }
        let med:i32 = med12(ctx.i32a, vvbase);
        o_str(&b, "MEDIAN_"); o_strat_name(&b, s);
        o_str(&b, "="); o_i32(&b, med); o_nl(&b);
        if (s == 0) { meds0 = med; }
        if (s == 1) { meds1 = med; }
        if (s == 2) { meds2 = med; }
        if (s == 3) { meds3 = med; }
        if (s == 4) { meds4 = med; }
        s = s+1;
    }
    o_str(&b, "GATES_BEGIN"); o_nl(&b);
    o_str(&b, "C1 median_ward-turtle="); o_i32(&b, meds1);
    if (meds1 >= 960) { o_str(&b, " PASS"); } else { o_str(&b, " FAIL(VOID)"); }
    o_nl(&b);
    o_str(&b, "C2 median_Z="); o_i32(&b, meds4);
    if (meds4 < 300) { o_str(&b, " PASS"); } else { o_str(&b, " FAIL"); }
    o_nl(&b);
    let c3n:i32 = 0;
    if (meds0 >= 720) { c3n = c3n + 1; }
    if (meds1 >= 720) { c3n = c3n + 1; }
    if (meds2 >= 720) { c3n = c3n + 1; }
    if (meds3 >= 720) { c3n = c3n + 1; }
    o_str(&b, "C3 strategies>=720: forage="); o_i32(&b, meds0);
    o_str(&b, " ward-turtle="); o_i32(&b, meds1);
    o_str(&b, " lamp-farm="); o_i32(&b, meds2);
    o_str(&b, " void-cross="); o_i32(&b, meds3);
    o_str(&b, " count="); o_i32(&b, c3n);
    if (c3n >= 3) { o_str(&b, " PASS"); } else { o_str(&b, " FAIL"); }
    o_nl(&b);
    o_str(&b, "GATES_END"); o_nl(&b);
    return 0;
}

fn mode_run(ctx:*Ctx)i32 {
    let b:Buf = o_new(ctx.b8, X_PBUF, X_PCAP);
    let v:i32 = 0;
    while (v < 12) {
        let arm:i32 = 0;
        while (arm < 5) {
            let idx:i32 = v*5 + arm;
            let lslot:i32 = v*2 + (arm - 3);
            let rr:RunRes = run_one(ctx, v, arm, idx, lslot);
            ctx.i32a[X_RBASE+idx*3] = rr.ticks;
            ctx.i32a[X_RBASE+idx*3+1] = rr.cause;
            ctx.i32a[X_RBASE+idx*3+2] = rr.e_end;
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "TSV_BEGIN"); o_nl(&b);
    o_str(&b, "variant\tarm\tticks\tcause\te_end"); o_nl(&b);
    v = 0;
    while (v < 12) {
        let arm:i32 = 0;
        while (arm < 5) {
            let idx:i32 = v*5 + arm;
            o_i32(&b, v); o_tab(&b);
            o_arm_name(&b, arm); o_tab(&b);
            o_i32(&b, ctx.i32a[X_RBASE+idx*3]); o_tab(&b);
            o_i32(&b, ctx.i32a[X_RBASE+idx*3+1]); o_tab(&b);
            o_i32(&b, ctx.i32a[X_RBASE+idx*3+2]); o_nl(&b);
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "TSV_END"); o_nl(&b);
    o_str(&b, "TRACES_BEGIN"); o_nl(&b);
    v = 0;
    while (v < 12) {
        let arm:i32 = 0;
        while (arm < 5) {
            let idx:i32 = v*5 + arm;
            let tbase:i32 = X_TBASE + idx*H_T;
            o_i32(&b, v); o_tab(&b);
            o_arm_name(&b, arm); o_tab(&b);
            let t:i32 = 0;
            while (t < H_T) {
                let c:u8 = ctx.b8[tbase+t];
                if (c == 46) { break; }
                o_ch(&b, c);
                t = t+1;
            }
            o_nl(&b);
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "TRACES_END"); o_nl(&b);
    o_str(&b, "PLANS_BEGIN"); o_nl(&b);
    o_str(&b, "variant\tarm\ttick\tplan"); o_nl(&b);
    v = 0;
    while (v < 12) {
        let arm:i32 = 3;
        while (arm < 5) {
            let lslot:i32 = v*2 + (arm - 3);
            let nl:i32 = ctx.i32a[X_NBASE+lslot*5+0];
            let lbase:i32 = X_JLOGBASE + lslot*X_JLOGSZ;
            let j:i32 = 0;
            while (j < nl) {
                let e:i64 = ctx.i64a[lbase+j];
                let tk:i32 = (e >> 32) as i32;
                let code:i64 = e & 4294967295;
                o_i32(&b, v); o_tab(&b);
                o_arm_name(&b, arm); o_tab(&b);
                o_i32(&b, tk); o_tab(&b);
                o_plan(&b, code); o_nl(&b);
                j = j+1;
            }
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "PLANS_END"); o_nl(&b);
    o_str(&b, "RUNSUM_BEGIN"); o_nl(&b);
    o_str(&b, "variant\tarm\tticks\tcause\te_end\tenum_tick\tn_replans\tpost_total\tpost_low"); o_nl(&b);
    v = 0;
    while (v < 12) {
        let arm:i32 = 0;
        while (arm < 5) {
            let idx:i32 = v*5 + arm;
            let lslot:i32 = v*2 + (arm - 3);
            o_i32(&b, v); o_tab(&b);
            o_arm_name(&b, arm); o_tab(&b);
            o_i32(&b, ctx.i32a[X_RBASE+idx*3]); o_tab(&b);
            o_i32(&b, ctx.i32a[X_RBASE+idx*3+1]); o_tab(&b);
            o_i32(&b, ctx.i32a[X_RBASE+idx*3+2]); o_tab(&b);
            if (arm >= 3) {
                o_tab(&b); o_i32(&b, ctx.i32a[X_NBASE+lslot*5+1]);
                o_tab(&b); o_i32(&b, ctx.i32a[X_NBASE+lslot*5+2]);
                o_tab(&b); o_i32(&b, ctx.i32a[X_NBASE+lslot*5+3]);
                o_tab(&b); o_i32(&b, ctx.i32a[X_NBASE+lslot*5+4]);
            } else {
                o_str(&b, "\t-1\t0\t0\t0");
            }
            o_nl(&b);
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "RUNSUM_END"); o_nl(&b);
    // medians per arm: two independent computations (cross-check)
    let m0:i32 = 0; let m1:i32 = 0; let m2:i32 = 0; let m3:i32 = 0; let m4:i32 = 0;
    let n0:i32 = 0; let n1:i32 = 0; let n2:i32 = 0; let n3:i32 = 0; let n4:i32 = 0;
    let arm:i32 = 0;
    while (arm < 5) {
        let vvbase:i32 = 900;
        let i:i32 = 0;
        while (i < 12) {
            ctx.i32a[vvbase+i] = ctx.i32a[X_RBASE+(i*5+arm)*3];
            i = i+1;
        }
        let med:i32 = med12(ctx.i32a, vvbase);
        let medb:i32 = med12b(ctx.i32a, vvbase, 940);
        if (arm == 0) { m0 = med; n0 = medb; }
        if (arm == 1) { m1 = med; n1 = medb; }
        if (arm == 2) { m2 = med; n2 = medb; }
        if (arm == 3) { m3 = med; n3 = medb; }
        if (arm == 4) { m4 = med; n4 = medb; }
        arm = arm+1;
    }
    o_str(&b, "MEDIANS_BEGIN"); o_nl(&b);
    o_str(&b, "P\t"); o_i32(&b, m0); o_nl(&b);
    o_str(&b, "Z\t"); o_i32(&b, m1); o_nl(&b);
    o_str(&b, "R\t"); o_i32(&b, m2); o_nl(&b);
    o_str(&b, "I-survive\t"); o_i32(&b, m3); o_nl(&b);
    o_str(&b, "I-invent\t"); o_i32(&b, m4); o_nl(&b);
    o_str(&b, "MEDIANS_END"); o_nl(&b);
    o_str(&b, "MEDIANS2_BEGIN"); o_nl(&b);
    o_str(&b, "P\t"); o_i32(&b, n0); o_nl(&b);
    o_str(&b, "Z\t"); o_i32(&b, n1); o_nl(&b);
    o_str(&b, "R\t"); o_i32(&b, n2); o_nl(&b);
    o_str(&b, "I-survive\t"); o_i32(&b, n3); o_nl(&b);
    o_str(&b, "I-invent\t"); o_i32(&b, n4); o_nl(&b);
    o_str(&b, "MEDIANS2_END"); o_nl(&b);
    o_str(&b, "BARS_BEGIN"); o_nl(&b);
    o_str(&b, "C1 median_P="); o_i32(&b, m0);
    if (m0 >= 960) { o_str(&b, " PASS"); } else { o_str(&b, " FAIL(VOID)"); }
    o_nl(&b);
    o_str(&b, "C2 median_Z="); o_i32(&b, m1);
    if (m1 < 300) { o_str(&b, " PASS"); } else { o_str(&b, " FAIL"); }
    o_nl(&b);
    o_str(&b, "K1 median_I-survive="); o_i32(&b, m3);
    o_str(&b, " median_R="); o_i32(&b, m2);
    if (m3 <= m2) { o_str(&b, " verdict=KILL"); } else { o_str(&b, " verdict=PASS"); }
    o_nl(&b);
    o_str(&b, "K2 median_I-survive="); o_i32(&b, m3);
    o_str(&b, " median_Z="); o_i32(&b, m1);
    if (m3 <= m1) { o_str(&b, " verdict=KILL"); } else { o_str(&b, " verdict=PASS"); }
    o_nl(&b);
    o_str(&b, "K3 median_P="); o_i32(&b, m0);
    if (m0 < 960) { o_str(&b, " verdict=VOID"); } else { o_str(&b, " verdict=PASS"); }
    o_nl(&b);
    o_str(&b, "BARS_END"); o_nl(&b);
    // K7 choice-reality: fraction of post-enumeration plans in the I arms
    // whose novelty bonus contributed less than 10% of the winning score.
    // Bar >= 0.50 else VOID (the design failed, not the agent).
    let k7num:i32 = 0;
    let k7den:i32 = 0;
    v = 0;
    while (v < 12) {
        arm = 3;
        while (arm < 5) {
            let lslot:i32 = v*2 + (arm - 3);
            k7den = k7den + ctx.i32a[X_NBASE+lslot*5+3];
            k7num = k7num + ctx.i32a[X_NBASE+lslot*5+4];
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "K7_BEGIN"); o_nl(&b);
    o_str(&b, "post_enum_plans="); o_i32(&b, k7den);
    o_str(&b, " low_bonus_plans="); o_i32(&b, k7num); o_nl(&b);
    if (k7den > 0) {
        let pm:i32 = (1000*k7num) / k7den;
        o_str(&b, "K7 fraction_per_mille="); o_i32(&b, pm);
        if (pm >= 500) { o_str(&b, " verdict=PASS"); } else { o_str(&b, " verdict=VOID"); }
        o_nl(&b);
    } else {
        o_str(&b, "K7 verdict=VOID (no post-enumeration plans observed)"); o_nl(&b);
    }
    o_str(&b, "K7_END"); o_nl(&b);
    o_str(&b, "ABLATION_BEGIN"); o_nl(&b);
    o_str(&b, "K6_RULE: fires iff median(ablated I-survive) >= median(original I-survive)"); o_nl(&b);
    o_str(&b, "variant\tarm\torig_ticks\tablated_ticks\treplaced\tdrop"); o_nl(&b);
    v = 0;
    while (v < 12) {
        arm = 3;
        while (arm < 5) {
            let idx:i32 = v*5 + arm;
            let iticks:i32 = ctx.i32a[X_RBASE+idx*3];
            let ab:AblRes = ablate(ctx, v, idx);
            o_i32(&b, v); o_tab(&b);
            o_arm_name(&b, arm); o_tab(&b);
            o_i32(&b, iticks); o_tab(&b);
            o_i32(&b, ab.ticks); o_tab(&b);
            o_i32(&b, ab.replaced); o_tab(&b);
            o_i32(&b, iticks - ab.ticks); o_nl(&b);
            if (arm == 3) { ctx.i32a[860+v] = ab.ticks; }
            else { ctx.i32a[872+v] = ab.ticks; }
            arm = arm+1;
        }
        v = v+1;
    }
    let m_abl3:i32 = med12(ctx.i32a, 860);
    let m_abl3b:i32 = med12b(ctx.i32a, 860, 940);
    let m_abl4:i32 = med12(ctx.i32a, 872);
    o_str(&b, "K6 median_orig_I-survive="); o_i32(&b, m3);
    o_str(&b, " median_abl_I-survive="); o_i32(&b, m_abl3);
    if (m_abl3 >= m3) { o_str(&b, " verdict=FIRES"); } else { o_str(&b, " verdict=PASS"); }
    o_nl(&b);
    o_str(&b, "K6 median_abl_I-survive_check2="); o_i32(&b, m_abl3b); o_nl(&b);
    o_str(&b, "ABL_I-invent median_abl="); o_i32(&b, m_abl4); o_nl(&b);
    o_str(&b, "ABLATION_END"); o_nl(&b);
    // TOPSKETCH dedicated pass: re-run each I arm (deterministic; identical
    // to the main pass) and scan its final candidate tables for the K4
    // novelty audit. Runs after ABLATION so trace/log/scratch reuse is safe.
    o_str(&b, "TOPSKETCH_BEGIN"); o_nl(&b);
    o_str(&b, "variant\tarm\trank\tplan\ttried\tmean"); o_nl(&b);
    v = 0;
    while (v < 12) {
        arm = 3;
        while (arm < 5) {
            let idx:i32 = v*5 + arm;
            let lslot:i32 = v*2 + (arm - 3);
            let rr2:RunRes = run_one(ctx, v, arm, idx, lslot);
            let ts2:i32 = o_topsketch(ctx, &b, v, arm);
            arm = arm+1;
        }
        v = v+1;
    }
    o_str(&b, "TOPSKETCH_END"); o_nl(&b);
    o_str(&b, "META_BEGIN"); o_nl(&b);
    let ist:JState = j_new(ctx.i64a, 0, X_JLOGBASE+24*X_JLOGSZ, H_B0S);
    o_str(&b, "ncand="); o_i32(&b, ist.ncand); o_nl(&b);
    o_str(&b, "B0_survive=40 B0_invent=120 decay=B0(n)=B0/(1+n)-intdiv"); o_nl(&b);
    o_str(&b, "horizon=1200"); o_nl(&b);
    o_str(&b, "META_END"); o_nl(&b);
    return 0;
}

fn parse_u8num(m:[]u8)i32 {
    if (m.len == 1) {
        let d:i32 = (m[0] as i32) - 48;
        if (d < 0 || d > 9) { return -1; }
        return d;
    }
    if (m.len == 2) {
        let d0:i32 = (m[0] as i32) - 48;
        let d1:i32 = (m[1] as i32) - 48;
        if (d0 < 0 || d0 > 9 || d1 < 0 || d1 > 9) { return -1; }
        return d0*10 + d1;
    }
    return -1;
}

// Debug: run one scripted strategy on one variant, print tick/pos/energy/
// action/phase every tick. Not part of the evidence; a development aid.
fn mode_dbg(ctx:*Ctx, v:i32, strat:i32)i32 {
    let b:Buf = o_new(ctx.b8, X_PBUF, X_PCAP);
    let w:World = w_new(ctx.i32a, X_WBASE);
    let vp:VParams = VParams{.mem=ctx.i32a, .base=X_VBASE, .void0=0, .void1=0, .start=0, .home=0};
    let vf:i32 = v7_fill(v, &vp);
    let va:i32 = v_apply(&w, &vp);
    o_str(&b, "tick\tpos\tenergy\taction\tphase"); o_nl(&b);
    if (strat == 1) {
        let st:PState = p_new(&w);
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = p_act(&w, &st);
            o_i32(&b, w.tick); o_tab(&b);
            o_i32(&b, w.apos); o_tab(&b);
            o_i32(&b, w.energy); o_tab(&b);
            o_ch(&b, act_char(a)); o_tab(&b);
            o_i32(&b, st.phase); o_nl(&b);
            w_step(&w, a, st.ca, st.cb);
            if (w.tick > 400) { break; }
        }
    }
    if (strat == 0) {
        while (w.alive == 1 && w.tick < H_T) {
            let a:i32 = r_act(&w);
            o_i32(&b, w.tick); o_tab(&b);
            o_i32(&b, w.apos); o_tab(&b);
            o_i32(&b, w.energy); o_tab(&b);
            o_ch(&b, act_char(a)); o_nl(&b);
            w_step(&w, a, 0, 1);
            if (w.tick > 400) { break; }
        }
    }
    o_str(&b, "END ticks="); o_i32(&b, w.tick);
    o_str(&b, " cause="); o_i32(&b, w.cause);
    o_str(&b, " e_end="); o_i32(&b, w.energy); o_nl(&b);
    return 0;
}

fn main()i32 {
    let mi:*i32 = _zag_malloc(1024*4) as *i32;
    let ai:[]i32 = mi[0..1024];
    let mu:*u8 = _zag_malloc(76096);
    let au:[]u8 = mu[0..76096];
    let mg:*i64 = _zag_malloc(40000*8) as *i64;
    let ag:[]i64 = mg[0..40000];
    let ctx:Ctx = Ctx{.b8=au, .i32a=ai, .i64a=ag};
    // median scratch at 900..975 (inside 1024 i32 arena)
    if (_zag_argc() >= 2) {
        let m:[]u8 = _zag_arg(1);
        if (m.len == 8) {
            let isv:i32 = 1;
            if (m[0]!=118||m[1]!=97||m[2]!=114||m[3]!=105||m[4]!=97||m[5]!=110||m[6]!=116||m[7]!=115) { isv = 0; }
            if (isv == 1) { return mode_variants(&ctx); }
        }
        if (m.len == 9) {
            let isc:i32 = 1;
            if (m[0]!=99||m[1]!=97||m[2]!=108||m[3]!=105||m[4]!=98||m[5]!=114||m[6]!=97||m[7]!=116||m[8]!=101) { isc = 0; }
            if (isc == 1) { return mode_calibrate(&ctx); }
        }
        if (m.len == 5) {
            let isk:i32 = 1;
            if (m[0]!=99||m[1]!=104||m[2]!=101||m[3]!=99||m[4]!=107) { isk = 0; }
            if (isk == 1) { return mode_check(&ctx); }
        }
        if (m.len == 3) {
            let isd:i32 = 1;
            if (m[0]!=100||m[1]!=98||m[2]!=103) { isd = 0; }
            if (isd == 1 && _zag_argc() >= 4) {
                let mv:[]u8 = _zag_arg(2);
                let ms:[]u8 = _zag_arg(3);
                let vv:i32 = parse_u8num(mv);
                let ss:i32 = parse_u8num(ms);
                if (vv >= 0 && vv < 12 && ss >= 0 && ss < 5) {
                    return mode_dbg(&ctx, vv, ss);
                }
            }
        }
    }
    return mode_run(&ctx);
}

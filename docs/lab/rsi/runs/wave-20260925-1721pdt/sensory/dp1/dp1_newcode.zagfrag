
// ============================================================
// DP-1 DOPPLER FLYBY - wave-20260925-1721pdt
// New mechanism per PREREG_DP1_1721.md (commit 18ad30fe3).
// This block plus the new main below are the ONLY differences
// from the vendored sub/synth_base.zag. Every render_* function
// and score_aud3 is byte-identical; the bed is rendered with
// identical calls, seeds, and order.
// Frozen params: C=319 V=30 DMIN=15 T_CA=10.5 D_REF=25
// PREROLL=1.0, engine f0=48 NP=6 B=0.0008, throb 0.4 Hz/0.25,
// DP_SCALE=0.09, TARGET_FLYBY_PEAK=8000.
// Pure Zag. Pinned znc 498abcb5.
// ============================================================

fn dp_sqrt(x:f64)f64{
    if(x<=0.0){return 0.0;}
    let g:f64=x;
    if(g<1.0){g=1.0;}
    let k:i32=0;
    while(k<30){g=0.5*(g+x/g);k=k+1;}
    return g;
}

fn dp_wi64f(fd:i64,v:i64)void{
    let bp:*u8=_zag_malloc(48) as *u8;
    let b:[]u8=bp[0..48];
    let neg:i64=0;
    let u:i64=v;
    if(v<0){neg=1;u=-v;}
    let nd:i64=0;
    if(u==0){nd=1;}
    else{
        let t:i64=u;
        while(t>0){t=t/10;nd=nd+1;}
    }
    let start:i64=0;
    if(neg==1){b[0]=45;start=1;}
    let k:i64=start+nd-1;
    if(u==0){b[start]=48;}
    else{
        while(u>0){
            b[k]=(48+(u%10)) as u8;
            u=u/10;
            k=k-1;
        }
    }
    w_all(fd,b[0..(start+nd)]);
    _zag_free(_zag_slice_ptr(b));
}

// Engine source: 6 inharmonic partials, 48 Hz base, 0.4 Hz throb,
// 2 s rise / 1 s fall, 22.0 s span (1.0 s preroll + 21.0 s).
// Rendered into src (DP_SRC_S*8 bytes, Q24 i64). Deterministic.
fn dp_engine(src:[]u8,lut:[]u8)void{
    let nsrc:i64=970200;
    let seed:i64=7101;
    let k:i32=0;
    while(k<6){
        let kf:f64=(k+1) as f64;
        let g:f64=kf;
        g=0.5*(g+(1.0+0.0008*kf*kf)/g);
        g=0.5*(g+(1.0+0.0008*kf*kf)/g);
        g=0.5*(g+(1.0+0.0008*kf*kf)/g);
        let f:f64=48.0*kf*g;
        let inc:f64=f/44100.0;
        let ph:f64=h01(seed,1000+k);
        let amp:f64=1.0/(1.0+0.5*(k as f64));
        let s:i64=0;
        while(s<nsrc){
            let t:f64=(s as f64)/44100.0;
            let env:f64=1.0;
            if(t<2.0){env=sstep(t/2.0);}
            let rem:f64=22.0-t;
            if(rem<1.0){env=sstep(rem/1.0);}
            let th:f64=1.0+0.25*sin01(lut,(0.4*t)+h01(seed,777));
            let v:f64=sin01(lut,ph)*amp*th*env;
            let cur:i64=get64(src,s*8);
            put64(src,s*8,cur+((v*16777216.0) as i64));
            ph=ph+inc;
            if(ph>=1.0){ph=ph-1.0;}
            s=s+1;
        }
        k=k+1;
    }
}

fn dp_src_peak(src:[]u8)i64{
    let nsrc:i64=970200;
    let peak:i64=0;
    let s:i64=0;
    while(s<nsrc){
        let v:i64=get64(src,s*8);
        let a:i64=v;
        if(a<0){a=-a;}
        if(a>peak){peak=a;}
        s=s+1;
    }
    return peak;
}

// Doppler propagation pass. Reads src with varying delay,
// applies inverse-distance gain and constant-power pan, adds
// into mL/mR (Q24). Writes trace checkpoints when tfd >= 0.
fn dp_flyby(mL:[]u8,mR:[]u8,src:[]u8,lut:[]u8,cal:f64,tfd:i64)void{
    let n:i64=0;
    while(n<926100){
        let t:f64=(n as f64)/44100.0;
        let x:f64=30.0*(t-10.5);
        let d:f64=dp_sqrt(225.0+x*x);
        let tau:f64=d/319.0;
        let g:f64=25.0/d;
        let u:f64=x/d;
        let gl:f64=dp_sqrt((1.0-u)/2.0);
        let gr:f64=dp_sqrt((1.0+u)/2.0);
        let st:f64=(t-tau+1.0)*44100.0;
        let i0:i64=st as i64;
        if(i0<0){i0=0;}
        if(i0>970198){i0=970198;}
        let fr:f64=st-(i0 as f64);
        let s0:i64=get64(src,i0*8);
        let s1:i64=get64(src,(i0+1)*8);
        let sv:f64=(s0 as f64)+((s1-s0) as f64)*fr;
        let y:f64=sv*g*cal;
        let cL:i64=get64(mL,n*8);
        put64(mL,n*8,cL+((y*gl) as i64));
        let cR:i64=get64(mR,n*8);
        put64(mR,n*8,cR+((y*gr) as i64));
        if(tfd>=0 && (n % 4410)==0){
            dp_wi64f(tfd,n);
            w_all(tfd," ");
            dp_wi64f(tfd,(tau*1000000000.0) as i64);
            w_all(tfd," ");
            dp_wi64f(tfd,(g*1000000000.0) as i64);
            w_all(tfd," ");
            dp_wi64f(tfd,(gl*1000000000.0) as i64);
            w_all(tfd," ");
            dp_wi64f(tfd,(gr*1000000000.0) as i64);
            w_all(tfd,"\n");
        }
        n=n+1;
    }
}

// Fixed-scale stereo WAV writer. DP_SCALE=0.09 frozen. Fades
// 30 ms in / 0.8 s out identical for baseline and variant.
// No normalization, no soft clip. Clips counted and reported.
fn dp_write_stereo(path:[]u8,mL:[]u8,mR:[]u8)i32{
    let p:*u8=_zag_malloc(44+926100*4) as *u8;
    if(p==null as *u8){return -2;}
    let out:[]u8=p[0..(44+926100*4)];
    let i:i64=0;
    while(i<44+926100*4){out[i]=0;i=i+1;}
    out[0]=82;out[1]=73;out[2]=70;out[3]=70;
    put32(out,4,36+926100*4);
    out[8]=87;out[9]=65;out[10]=86;out[11]=69;
    out[12]=102;out[13]=109;out[14]=116;out[15]=32;
    put32(out,16,16);
    put16(out,20,1);
    put16(out,22,2);
    put32(out,24,44100);
    put32(out,28,176400);
    put16(out,32,4);
    put16(out,34,16);
    out[36]=100;out[37]=97;out[38]=116;out[39]=97;
    put32(out,40,926100*4);
    let clips:i64=0;
    let peak:i64=0;
    let s:i64=0;
    while(s<926100){
        let vl:i64=get64(mL,s*8);
        let vr:i64=get64(mR,s*8);
        let xl:f64=(vl as f64)/16777216.0*0.09;
        let xr:f64=(vr as f64)/16777216.0*0.09;
        if(s<1323){xl=xl*((s as f64)/1323.0);xr=xr*((s as f64)/1323.0);}
        let rem:i64=926100-s;
        if(rem<35280){let ff:f64=sstep((rem as f64)/35280.0);xl=xl*ff;xr=xr*ff;}
        let ql:i64=(xl*32767.0) as i64;
        let qr:i64=(xr*32767.0) as i64;
        if(ql>32767){ql=32767;clips=clips+1;}
        if(ql<-32768){ql=-32768;clips=clips+1;}
        if(qr>32767){qr=32767;clips=clips+1;}
        if(qr<-32768){qr=-32768;clips=clips+1;}
        let al:i64=ql;
        if(al<0){al=-al;}
        if(al>peak){peak=al;}
        let ar:i64=qr;
        if(ar<0){ar=-ar;}
        if(ar>peak){peak=ar;}
        put16(out,44+s*4,ql);
        put16(out,44+s*4+2,qr);
        s=s+1;
    }
    let cs:[]u8=cstr(path);
    if(cs.len==0){return -3;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),577,438,0,0,0);
    if(fd<0){return -4;}
    let wr:i64=w_all(fd,out);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    _zag_free(_zag_slice_ptr(out));
    if(wr<0){return -5;}
    w_all(1,"wav_peak=");
    dp_wi64f(1,peak);
    w_all(1," clips=");
    dp_wi64f(1,clips);
    w_all(1,"\n");
    return 0;
}

// Mono probe writer for the isolated flyby stem (KB3). No fades.
fn dp_write_mono(path:[]u8,m:[]u8)i32{
    let p:*u8=_zag_malloc(44+926100*2) as *u8;
    if(p==null as *u8){return -2;}
    let out:[]u8=p[0..(44+926100*2)];
    let i:i64=0;
    while(i<44+926100*2){out[i]=0;i=i+1;}
    out[0]=82;out[1]=73;out[2]=70;out[3]=70;
    put32(out,4,36+926100*2);
    out[8]=87;out[9]=65;out[10]=86;out[11]=69;
    out[12]=102;out[13]=109;out[14]=116;out[15]=32;
    put32(out,16,16);
    put16(out,20,1);
    put16(out,22,1);
    put32(out,24,44100);
    put32(out,28,88200);
    put16(out,32,2);
    put16(out,34,16);
    out[36]=100;out[37]=97;out[38]=116;out[39]=97;
    put32(out,40,926100*2);
    let s:i64=0;
    while(s<926100){
        let v:i64=get64(m,s*8);
        let x:f64=(v as f64)/16777216.0*0.09;
        let q:i64=(x*32767.0) as i64;
        if(q>32767){q=32767;}
        if(q<-32768){q=-32768;}
        put16(out,44+s*2,q);
        s=s+1;
    }
    let cs:[]u8=cstr(path);
    if(cs.len==0){return -3;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),577,438,0,0,0);
    if(fd<0){return -4;}
    let wr:i64=w_all(fd,out);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    _zag_free(_zag_slice_ptr(out));
    if(wr<0){return -5;}
    return 0;
}

fn dp_new_src()[]u8{
    let p:*u8=_zag_malloc(970200*8) as *u8;
    let m:[]u8=p[0..(970200*8)];
    let i:i64=0;
    while(i<970200*8){m[i]=0;i=i+1;}
    return m;
}

fn main()i32{
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let lut:[]u8=lut_build();
    if(_zag_strcmp(a1,"probe")==1){
        let src:[]u8=dp_new_src();
        dp_engine(src,lut);
        let sp:i64=dp_src_peak(src);
        let cal:f64=8000.0/(0.09*1.6666667*((sp as f64)/512.0));
        w_all(1,"src_q24_peak=");
        dp_wi64f(1,sp);
        w_all(1," cal=");
        // print cal x1e9 as int
        dp_wi64f(1,(cal*1000000000.0) as i64);
        w_all(1,"\n");
        let pm:[]u8=mix_new();
        // mono propagated stem: same delay line, no pan, no bed
        let n:i64=0;
        while(n<926100){
            let t:f64=(n as f64)/44100.0;
            let x:f64=30.0*(t-10.5);
            let d:f64=dp_sqrt(225.0+x*x);
            let tau:f64=d/319.0;
            let g:f64=25.0/d;
            let st:f64=(t-tau+1.0)*44100.0;
            let i0:i64=st as i64;
            if(i0<0){i0=0;}
            if(i0>970198){i0=970198;}
            let fr:f64=st-(i0 as f64);
            let s0:i64=get64(src,i0*8);
            let s1:i64=get64(src,(i0+1)*8);
            let sv:f64=(s0 as f64)+((s1-s0) as f64)*fr;
            let y:f64=sv*g*cal;
            let cur:i64=get64(pm,n*8);
            put64(pm,n*8,cur+(y as i64));
            n=n+1;
        }
        let rc:i32=dp_write_mono(a2,pm);
        _zag_free(_zag_slice_ptr(pm));
        _zag_free(_zag_slice_ptr(src));
        _zag_free(_zag_slice_ptr(lut));
        return rc;
    }
    let mL:[]u8=mix_new();
    let mR:[]u8=mix_new();
    score_aud3(mL,lut);
    // dual mono bed
    let s:i64=0;
    while(s<926100){
        put64(mR,s*8,get64(mL,s*8));
        s=s+1;
    }
    if(_zag_strcmp(a1,"variant")==1){
        let src:[]u8=dp_new_src();
        dp_engine(src,lut);
        let sp:i64=dp_src_peak(src);
        let cal:f64=8000.0/(0.09*1.6666667*((sp as f64)/512.0));
        w_all(1,"src_q24_peak=");
        dp_wi64f(1,sp);
        w_all(1," cal_x1e9=");
        dp_wi64f(1,(cal*1000000000.0) as i64);
        w_all(1,"\n");
        let tcs:[]u8=cstr("dp1_trace.txt");
        let tfd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(tcs) as i64),577,438,0,0,0);
        dp_flyby(mL,mR,src,lut,cal,tfd);
        _zag_raw_syscall(3,tfd,0,0,0,0,0);
        _zag_free(_zag_slice_ptr(tcs));
        _zag_free(_zag_slice_ptr(src));
    }
    let rc:i32=dp_write_stereo(a2,mL,mR);
    _zag_free(_zag_slice_ptr(mL));
    _zag_free(_zag_slice_ptr(mR));
    _zag_free(_zag_slice_ptr(lut));
    return rc;
}

// ============================================================
// DP-1 VERIFIER - wave-20260925-1721pdt
// Pure-Zag audit of DP-1 artifacts. Checks KB2, KB3, KB4, KB5,
// KB8 from the frozen prereg (commit 18ad30fe3). Reads:
//   argv1 baseline stereo WAV, argv2 variant stereo WAV,
//   argv3 probe mono WAV, argv4 trace file.
// Frozen bounds (no logarithms needed):
//   KB4 crest ratio in [0.84140, 1.18850]  (+/-1.5 dB)
//   KB5 rms ratio in [0.79433, 1.25893]    (+/-2.0 dB)
//   KB3 doppler ratio within +/-3 percent of analytic
//   KB8 trace checkpoints match recompute within 1 unit (1e-9)
// Pure Zag. Pinned znc 498abcb5.
// ============================================================

// byte helpers (same semantics as substrate)
fn put32(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
}
fn put16(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
}
fn put64(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
    b[i+4]=((v>>32) & 255) as u8;
    b[i+5]=((v>>40) & 255) as u8;
    b[i+6]=((v>>48) & 255) as u8;
    b[i+7]=((v>>56) & 255) as u8;
}
fn get64(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24) | ((b[i+4] as i64)<<32) | ((b[i+5] as i64)<<40) | ((b[i+6] as i64)<<48) | ((b[i+7] as i64)<<56);
}
fn cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4095){return "";}
    let p:*u8=_zag_malloc((s.len+1) as i64) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..(s.len+1)];
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn w_all(fd:i64,b:[]u8)i64{
    let at:i64=0;
    let calls:i32=0;
    let blen:i64=b.len as i64;
    while(at<blen && calls<8192){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+at,blen-at,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<=0){return -7407;}
        at=at+n;
    }
    if(at!=blen){return -7407;}
    return at;
}

fn v_sqrt(x:f64)f64{
    if(x<=0.0){return 0.0;}
    let g:f64=x;
    if(g<1.0){g=1.0;}
    let k:i32=0;
    while(k<30){g=0.5*(g+x/g);k=k+1;}
    return g;
}

fn v_wstr(fd:i64,s:[]u8)void{ w_all(fd,s); }
fn v_wi64(fd:i64,v:i64)void{
    let bp:*u8=_zag_malloc(48) as *u8;
    let b:[]u8=bp[0..48];
    let neg:i64=0;
    let u:i64=v;
    if(v<0){neg=1;u=-v;}
    let nd:i64=0;
    if(u==0){nd=1;}
    else{ let t:i64=u; while(t>0){t=t/10;nd=nd+1;} }
    let start:i64=0;
    if(neg==1){b[0]=45;start=1;}
    let k:i64=start+nd-1;
    if(u==0){b[start]=48;}
    else{ while(u>0){ b[k]=(48+(u%10)) as u8; u=u/10; k=k-1; } }
    w_all(fd,b[0..(start+nd)]);
    _zag_free(_zag_slice_ptr(b));
}
fn v_wf3(fd:i64,x:f64)void{
    let neg:i64=0;
    if(x<0.0){neg=1;x=-x;}
    let ip:i64=x as i64;
    let fp:i64=((x-(ip as f64))*1000.0+0.5) as i64;
    if(neg==1){v_wstr(fd,"-");}
    v_wi64(fd,ip);
    v_wstr(fd,".");
    if(fp<100){v_wstr(fd,"0");}
    if(fp<10){v_wstr(fd,"0");}
    v_wi64(fd,fp);
}

fn v_read_file(path:[]u8,maxn:i64,lenout:[]u8)*u8{
    let cs:[]u8=cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    if(fd<0){return null as *u8;}
    let p:*u8=_zag_malloc(maxn) as *u8;
    let at:i64=0;
    while(at<maxn){
        let n:i64=_zag_raw_syscall(0,fd,((p as i64)+at),maxn-at,0,0,0);
        if(n<=0){break;}
        at=at+n;
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    put64(lenout,0,at);
    return p;
}

fn v_get16s(b:[]u8,i:i64)i64{
    let v:i64=(b[i] as i64)|((b[i+1] as i64)<<8);
    if(v>=32768){v=v-65536;}
    return v;
}

// stereo WAV stats over both channels; returns via printed values.
// fills peak and sumsq through the returned pair encoding: not
// possible, so this function prints and the caller recomputes? No:
// use two separate passes via a stats struct in a byte buffer.
fn v_stats_stereo(b:[]u8,peak:[]u8,ssq:[]u8)void{
    // peak: i64 at [0..8], sumsq f64 bits at [8..16], n at [16..24]
    let pk:i64=0;
    let sq:f64=0.0;
    let n:i64=0;
    let i:i64=0;
    while(i<926100){
        let l:i64=v_get16s(b,44+i*4);
        let r:i64=v_get16s(b,44+i*4+2);
        let al:i64=l; if(al<0){al=-al;}
        let ar:i64=r; if(ar<0){ar=-ar;}
        if(al>pk){pk=al;}
        if(ar>pk){pk=ar;}
        sq=sq+(l as f64)*(l as f64)+(r as f64)*(r as f64);
        n=n+2;
        i=i+1;
    }
    put64(peak,0,pk);
    // store sumsq bits via f64->i64 bit copy through arithmetic is
    // not available; instead store sumsq/1e6 as i64 and n
    put64(ssq,0,(sq/1000000.0) as i64);
    put64(ssq,8,n);
}

fn v_parse_i64(b:[]u8,pos:i64,end:i64,val:*u8,newpos:*u8)i64{
    // skip spaces/newlines, parse optional-neg integer
    let p:i64=pos;
    while(p<end && (b[p]==32 || b[p]==10 || b[p]==13)){p=p+1;}
    let neg:i64=0;
    if(p<end && b[p]==45){neg=1;p=p+1;}
    let v:i64=0;
    let nd:i64=0;
    while(p<end && b[p]>=48 && b[p]<=57){v=v*10+((b[p]-48) as i64);p=p+1;nd=nd+1;}
    if(nd==0){return -1;}
    if(neg==1){v=-v;}
    put64(val,0,v);
    put64(newpos,0,p);
    return 0;
}

fn main()i32{
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    let a4:[]u8=_zag_arg(4);
    let fails:i64=0;

    // ---- load WAVs ----
    let lenb:*u8=_zag_malloc(16) as *u8;
    let lena:[]u8=lenb[0..16];
    let bb:*u8=v_read_file(a1,8000000,lena);
    let vb:*u8=v_read_file(a2,8000000,lena);
    let pb:*u8=v_read_file(a3,4000000,lena);
    _zag_free(lenb);
    if(bb==null as *u8 || vb==null as *u8 || pb==null as *u8){
        v_wstr(1,"LOAD_FAIL\n"); return 7;
    }
    let b:[]u8=bb[0..8000000];
    let v:[]u8=vb[0..8000000];
    let pr:[]u8=pb[0..4000000];
    // header sanity: RIFF/WAVE, stereo 16-bit for a1/a2, mono for a3
    let hdrok:i64=1;
    if(b[0]!=82||b[8]!=87||v[0]!=82||v[8]!=87||pr[0]!=82||pr[8]!=87){hdrok=0;}
    if(b[22]!=2||v[22]!=2||pr[22]!=1){hdrok=0;}
    v_wstr(1,"header_ok=");
    v_wi64(1,hdrok);
    v_wstr(1,"\n");
    if(hdrok==0){fails=fails+1;}

    // ---- KB2 / KB4 / KB5 ----
    let bp:*u8=_zag_malloc(32) as *u8;
    let bs:*u8=_zag_malloc(32) as *u8;
    let vp:*u8=_zag_malloc(32) as *u8;
    let vs:*u8=_zag_malloc(32) as *u8;
    let bba:[]u8=bp[0..32];
    let bsa:[]u8=bs[0..32];
    let vpa:[]u8=vp[0..32];
    let vsa:[]u8=vs[0..32];
    v_stats_stereo(b,bba,bsa);
    v_stats_stereo(v,vpa,vsa);
    let bpk:i64=get64(bba,0);
    let vpk:i64=get64(vpa,0);
    let bsq:f64=(get64(bsa,0) as f64)*1000000.0;
    let vsq:f64=(get64(vsa,0) as f64)*1000000.0;
    let bn:i64=get64(bsa,8);
    let vn:i64=get64(vsa,8);
    let brms:f64=v_sqrt(bsq/(bn as f64));
    let vrms:f64=v_sqrt(vsq/(vn as f64));
    let bcrest:f64=(bpk as f64)/brms;
    let vcrest:f64=(vpk as f64)/vrms;
    let crest_ratio:f64=vcrest/bcrest;
    let rms_ratio:f64=vrms/brms;
    v_wstr(1,"KB2 base_peak=");
    v_wi64(1,bpk);
    v_wstr(1," var_peak=");
    v_wi64(1,vpk);
    let kb2:i64=1;
    if(bpk>=32767||vpk>=32767){kb2=0;fails=fails+1;}
    v_wstr(1," KB2=");
    v_wi64(1,kb2);
    v_wstr(1,"\nKB4 crest_ratio=");
    v_wf3(1,crest_ratio);
    let kb4:i64=1;
    if(crest_ratio<0.84140||crest_ratio>1.18850){kb4=0;fails=fails+1;}
    v_wstr(1," KB4=");
    v_wi64(1,kb4);
    v_wstr(1,"\nKB5 rms_ratio=");
    v_wf3(1,rms_ratio);
    let kb5:i64=1;
    if(rms_ratio<0.79433||rms_ratio>1.25893){kb5=0;fails=fails+1;}
    v_wstr(1," KB5=");
    v_wi64(1,kb5);
    v_wstr(1,"\n");

    // ---- KB3 doppler ratio on probe ----
    // The engine has 6 partials, so raw zero crossings overcount.
    // Lowpass first (2 cascaded one-poles, k=0.0071, fc about 50 Hz),
    // then zero crossings isolate the fundamental. Windows [3,6]s
    // (approach) and [15,18]s (recession).
    let w1a:i64=132300;
    let w1b:i64=264600;
    let w2a:i64=661500;
    let w2b:i64=793800;
    let kk:f64=0.0071;
    let y1:f64=0.0;
    let y2:f64=0.0;
    let c1:i64=0;
    let c2:i64=0;
    let pvs:i64=0;
    let first1:i64=1;
    let first2:i64=1;
    let i:i64=0;
    while(i<w2b){
        let xv:f64=(v_get16s(pr,44+i*2) as f64);
        y1=y1+kk*(xv-y1);
        y2=y2+kk*(y1-y2);
        if(i>=w1a && i<w1b){
            let sgn:i64=-1;
            if(y2>=0.0){sgn=1;}
            if(first1==1){pvs=sgn;first1=0;}
            else{if(sgn!=pvs){c1=c1+1;pvs=sgn;}}
        }
        if(i>=w2a && i<w2b){
            let sgn:i64=-1;
            if(y2>=0.0){sgn=1;}
            if(first2==1){pvs=sgn;first2=0;}
            else{if(sgn!=pvs){c2=c2+1;pvs=sgn;}}
        }
        i=i+1;
    }
    let f_appr:f64=(c1 as f64)/2.0/3.0;
    let f_rec:f64=(c2 as f64)/2.0/3.0;
    let ratio_meas:f64=f_appr/f_rec;
    // analytic from frozen params at window centers 4.5 / 16.5
    let x1:f64=30.0*(4.5-10.5);
    let d1:f64=v_sqrt(225.0+x1*x1);
    let vt1:f64=-(30.0*x1/d1);
    let fa_exp:f64=48.0*319.0/(319.0-vt1);
    let x2:f64=30.0*(16.5-10.5);
    let d2:f64=v_sqrt(225.0+x2*x2);
    let vt2:f64=-(30.0*x2/d2);
    let fr_exp:f64=48.0*319.0/(319.0-vt2);
    let ratio_exp:f64=fa_exp/fr_exp;
    v_wstr(1,"KB3 f_approach=");
    v_wf3(1,f_appr);
    v_wstr(1," f_recession=");
    v_wf3(1,f_rec);
    v_wstr(1," ratio_meas=");
    v_wf3(1,ratio_meas);
    v_wstr(1," ratio_exp=");
    v_wf3(1,ratio_exp);
    let kb3:i64=1;
    if(f_appr<=f_rec){kb3=0;}
    if(ratio_meas<0.97*ratio_exp||ratio_meas>1.03*ratio_exp){kb3=0;}
    if(kb3==0){fails=fails+1;}
    v_wstr(1," KB3=");
    v_wi64(1,kb3);
    v_wstr(1,"\n");

    // ---- KB8 trace audit ----
    let lent:*u8=_zag_malloc(16) as *u8;
    let lenta:[]u8=lent[0..16];
    let tb:*u8=v_read_file(a4,100000,lenta);
    let tlen:i64=get64(lenta,0);
    _zag_free(lent);
    let kb8:i64=1;
    let nchk:i64=0;
    if(tb==null as *u8){kb8=0;}
    else{
        let t:[]u8=tb[0..100000];
        let pos:i64=0;
        let end:i64=tlen;
        let valb:*u8=_zag_malloc(16) as *u8;
        let npb:*u8=_zag_malloc(16) as *u8;
        let va:[]u8=valb[0..16];
        let npa:[]u8=npb[0..16];
        let done:i64=0;
        while(done==0){
            let r0:i64=v_parse_i64(t,pos,end,va,npa);
            if(r0!=0){done=1;break;}
            let nn:i64=get64(va,0);
            pos=get64(npa,0);
            let rq:i64=v_parse_i64(t,pos,end,va,npa);
            if(rq!=0){done=1;break;}
            let tau_q:i64=get64(va,0);
            pos=get64(npa,0);
            rq=v_parse_i64(t,pos,end,va,npa);
            if(rq!=0){done=1;break;}
            let g_q:i64=get64(va,0);
            pos=get64(npa,0);
            rq=v_parse_i64(t,pos,end,va,npa);
            if(rq!=0){done=1;break;}
            let gl_q:i64=get64(va,0);
            pos=get64(npa,0);
            rq=v_parse_i64(t,pos,end,va,npa);
            if(rq!=0){done=1;break;}
            let gr_q:i64=get64(va,0);
            pos=get64(npa,0);
            // recompute identically to dp_flyby
            let tt:f64=(nn as f64)/44100.0;
            let xx:f64=30.0*(tt-10.5);
            let dd:f64=v_sqrt(225.0+xx*xx);
            let tau2:f64=dd/319.0;
            let g2:f64=25.0/dd;
            let uu:f64=xx/dd;
            let gl2:f64=v_sqrt((1.0-uu)/2.0);
            let gr2:f64=v_sqrt((1.0+uu)/2.0);
            let e1:i64=(tau2*1000000000.0) as i64-tau_q;
            if(e1<0){e1=-e1;}
            let e2:i64=(g2*1000000000.0) as i64-g_q;
            if(e2<0){e2=-e2;}
            let e3:i64=(gl2*1000000000.0) as i64-gl_q;
            if(e3<0){e3=-e3;}
            let e4:i64=(gr2*1000000000.0) as i64-gr_q;
            if(e4<0){e4=-e4;}
            if(e1>1||e2>1||e3>1||e4>1){kb8=0;}
            nchk=nchk+1;
        }
        _zag_free(valb);
        _zag_free(npb);
    }
    v_wstr(1,"KB8 checkpoints=");
    v_wi64(1,nchk);
    if(nchk!=210){kb8=0;}
    if(kb8==0){fails=fails+1;}
    v_wstr(1," KB8=");
    v_wi64(1,kb8);
    v_wstr(1,"\n");
    v_wstr(1,"fails=");
    v_wi64(1,fails);
    v_wstr(1,"\n");
    return fails as i32;
}

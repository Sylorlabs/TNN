// ST-1 verifier - wave-20260925-0521pdt. Pure Zag.
// Usage: verify <dry.wav> <stereo.wav> <trace.txt>
// Checks KB2 (trace FIELD energies), KB3 (trace geometry audit),
// KB4 (no clipping), KB6 (mono compat), KB7 (crest character).

const SR:i64 = 44100;
const NSAMP:i64 = 926100;
const INV30:f64 = 1.0/1073741824.0; // 1/2^30

fn put32(b:[]u8,i:i64,v:i64)void{
    b[i]=(v%256) as u8;
    b[i+1]=((v/256)%256) as u8;
    b[i+2]=((v/65536)%256) as u8;
    b[i+3]=((v/16777216)%256) as u8;
}
fn get32s(b:[]u8,i:i64)i64{
    let v:i64=(b[i] as i64)+((b[i+1] as i64)*256)+((b[i+2] as i64)*65536)+((b[i+3] as i64)*16777216);
    if(v>=2147483648){v=v-4294967296;}
    return v;
}
fn put64(b:[]u8,i:i64,v:i64)void{
    let k:i64=0;
    while(k<8){b[i+k]=((v/(1 as i64<<(k*8)))%256) as u8;k=k+1;}
}
fn get64(b:[]u8,i:i64)i64{
    let v:i64=0;
    let k:i64=0;
    while(k<8){v=v+((b[i+k] as i64)<<(k*8));k=k+1;}
    return v;
}
fn cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4095){return "";}
    let p:*u8=_zag_malloc((s.len+1) as i64) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..(s.len+1)];
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn h32(s:i64,st:i64)i64{
    let z:i64=(s*2654435761+st*40503+1) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    z=(z*2246822519) & 4294967295;
    z=(z ^ (z>>13)) & 4294967295;
    z=(z*3266489917) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    return z;
}
fn h01(seed:i64,k:i64)f64{
    return (h32(seed,k) as f64)/4294967296.0;
}
fn tsin_small(x:f64)f64{
    let x2:f64=x*x;
    let x3:f64=x2*x;
    return x-x3/6.0+x3*x2/120.0-x3*x2*x2/5040.0;
}
fn tcos_small(x:f64)f64{
    let x2:f64=x*x;
    return 1.0-x2/2.0+x2*x2/24.0-x2*x2*x2/720.0;
}
fn lut_build()[]u8{
    let p:*u8=_zag_malloc(4100) as *u8;
    let lut:[]u8=p[0..4100];
    let d:f64=6.283185307179586/1024.0;
    let c:f64=tcos_small(d);
    let s:f64=tsin_small(d);
    let sn:f64=0.0;
    let cn:f64=1.0;
    let i:i64=0;
    while(i<=1024){
        put32(lut,i*4,(sn*1073741824.0) as i64);
        let nsn:f64=sn*c+cn*s;
        let ncn:f64=cn*c-sn*s;
        sn=nsn;
        cn=ncn;
        if((i & 127)==127){
            let nn:f64=sn*sn+cn*cn;
            sn=sn/nn;
            cn=cn/nn;
        }
        i=i+1;
    }
    return lut;
}
fn sin01(lut:[]u8,ph:f64)f64{
    let x:f64=ph*1024.0;
    let idx:i64=(x as i64);
    if(idx>1023){idx=1023;}
    if(idx<0){idx=0;}
    let fr:f64=x-(idx as f64);
    let l0:i64=get32s(lut,idx*4);
    let l1:i64=get32s(lut,(idx+1)*4);
    return ((l0 as f64)+((l1-l0) as f64)*fr)*INV30;
}
fn cos01(lut:[]u8,ph:f64)f64{
    let q:f64=ph+0.25;
    if(q>=1.0){q=q-1.0;}
    return sin01(lut,q);
}

fn v_read(path:[]u8)[]u8{
    let cs:[]u8=cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    if(fd<0){return "";}
    let cap:i64=4194304+4096;
    let bp:*u8=_zag_malloc(cap) as *u8;
    let b:[]u8=bp[0..cap];
    let at:i64=0;
    let go:i64=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(b) as i64)+at,cap-at,0,0,0);
        if(n<=0){go=0;}
        else{at=at+n;}
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return b[0..at];
}
fn v_get16(b:[]u8,o:i64)i64{
    let v:i64=(b[o] as i64)+((b[o+1] as i64)*256);
    if(v>=32768){v=v-65536;}
    return v;
}
// cursor helpers: cur is 8-byte slot holding offset; ok is 8-byte flag
fn v_exp(b:[]u8,cur:[]u8,ok:[]u8,s:[]u8)void{
    if(get64(ok,0)==0){return;}
    let c:i64=get64(cur,0);
    let i:i64=0;
    while(i<s.len){
        if(c+i>=b.len || b[c+i]!=s[i]){put64(ok,0,0);return;}
        i=i+1;
    }
    put64(cur,0,c+s.len);
}
fn v_i64(b:[]u8,cur:[]u8,ok:[]u8)i64{
    if(get64(ok,0)==0){return 0;}
    let c:i64=get64(cur,0);
    let neg:i64=0;
    if(c<b.len && b[c]==45){neg=1;c=c+1;}
    let v:i64=0;
    let nd:i64=0;
    while(c<b.len && b[c]>=48 && b[c]<=57){
        v=v*10+((b[c]-48) as i64);
        c=c+1;
        nd=nd+1;
    }
    if(nd==0){put64(ok,0,0);return 0;}
    if(neg==1){v=-v;}
    put64(cur,0,c);
    return v;
}
fn v_name(b:[]u8,cur:[]u8,ok:[]u8)[]u8{
    let c0:i64=get64(cur,0);
    let c:i64=c0;
    while(c<b.len && b[c]!=32){c=c+1;}
    put64(cur,0,c);
    return b[c0..c];
}
fn v_streq(a:[]u8,s:[]u8)i64{
    if(a.len!=s.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=s[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn v_expname(idx:i64)[]u8{
    if(idx==0){return "hum";}
    if(idx==1){return "breath";}
    if(idx==2){return "wind";}
    if(idx==3){return "spire";}
    if(idx==4){return "air";}
    if(idx>=5 && idx<=8){return "gust";}
    if(idx>=9 && idx<=11){return "vent";}
    if(idx>=12 && idx<=14){return "groan";}
    if(idx>=15 && idx<=32){return "crack";}
    return "chorus";
}
fn v_exppan(idx:i64)i64{
    if(idx==3){return 150;}
    if(idx==5){return -450;}
    if(idx==6){return -150;}
    if(idx==7){return 150;}
    if(idx==8){return 450;}
    if(idx==9){return -100;}
    if(idx==11){return 100;}
    if(idx>=15 && idx<=32){
        let c:i64=idx-15;
        let u1:f64=h01(3961,c);
        return ((u1*2.0-1.0)*800.0) as i64;
    }
    if(idx>=33 && idx<=41){
        let e:i64=idx-33;
        let w2:f64=h01(3991,e);
        return ((w2*2.0-1.0)*600.0) as i64;
    }
    return 0;
}

fn v_out(tag:[]u8,res:[]u8)void{
    _zag_print(tag);
    _zag_print(": ");
    _zag_println(res);
}
fn v_num(tag:[]u8,v:i64)void{
    _zag_print(tag);
    _zag_print("=");
    _zag_println(_zag_i64_to_str(v));
}

fn main()i32{
    let pd:[]u8=_zag_arg(1);
    let ps:[]u8=_zag_arg(2);
    let pt:[]u8=_zag_arg(3);
    if(pd.len==0 || ps.len==0 || pt.len==0){
        _zag_println("usage: verify <dry.wav> <stereo.wav> <trace.txt>");
        return 2;
    }
    let lut:[]u8=lut_build();
    // ---- read WAVs ----
    let bd:[]u8=v_read(pd);
    let bs:[]u8=v_read(ps);
    let bt:[]u8=v_read(pt);
    if(bd.len<44 || bs.len<44 || bt.len<10){
        _zag_println("FAIL read");
        return 3;
    }
    // header sanity: RIFF/WAVE/fmt, 44100 Hz, 16-bit
    let hok:i64=1;
    if(!(bd[0]==82 && bd[1]==73 && bd[2]==70 && bd[3]==70)){hok=0;}
    if(!(bs[0]==82 && bs[1]==73 && bs[2]==70 && bs[3]==70)){hok=0;}
    let chd:i64=(bd[22] as i64)+((bd[23] as i64)*256);
    let chs:i64=(bs[22] as i64)+((bs[23] as i64)*256);
    if(chd!=1 || chs!=2){hok=0;}
    let srd:i64=(bd[24] as i64)+((bd[25] as i64)*256)+((bd[26] as i64)*65536)+((bd[27] as i64)*16777216);
    let srs:i64=(bs[24] as i64)+((bs[25] as i64)*256)+((bs[26] as i64)*65536)+((bs[27] as i64)*16777216);
    if(srd!=44100 || srs!=44100){hok=0;}
    let dd:i64=(bd[40] as i64)+((bd[41] as i64)*256)+((bd[42] as i64)*65536)+((bd[43] as i64)*16777216);
    let ds:i64=(bs[40] as i64)+((bs[41] as i64)*256)+((bs[42] as i64)*65536)+((bs[43] as i64)*16777216);
    let nd:i64=dd/2;
    let ns:i64=ds/4;
    if(hok==0 || nd!=NSAMP || ns!=NSAMP){
        _zag_println("FAIL wav-header");
        return 4;
    }
    // ---- sample stats ----
    let peakd:i64=0;
    let peaks:i64=0;
    let ed:f64=0.0;
    let el:f64=0.0;
    let er:f64=0.0;
    let sdm:f64=0.0;
    let sdd:f64=0.0;
    let smm:f64=0.0;
    let i:i64=0;
    while(i<NSAMP){
        let m:i64=v_get16(bd,44+i*2);
        let l:i64=v_get16(bs,44+i*4);
        let r:i64=v_get16(bs,44+i*4+2);
        let am:i64=m; if(am<0){am=-am;}
        let al:i64=l; if(al<0){al=-al;}
        let ar:i64=r; if(ar<0){ar=-ar;}
        if(am>peakd){peakd=am;}
        if(al>peaks){peaks=al;}
        if(ar>peaks){peaks=ar;}
        let mf:f64=m as f64;
        let lf:f64=l as f64;
        let rf:f64=r as f64;
        ed=ed+mf*mf;
        el=el+lf*lf;
        er=er+rf*rf;
        let dw:f64=(lf+rf)/2.0;
        sdm=sdm+dw*mf;
        sdd=sdd+dw*dw;
        smm=smm+mf*mf;
        i=i+1;
    }
    // ---- KB4: no clipping ----
    v_num("KB4 peak_dry",peakd);
    v_num("KB4 peak_stereo",peaks);
    if(peakd<32767 && peaks<32767){v_out("KB4","PASS");}
    else{v_out("KB4","FAIL");}
    // ---- KB6: mono compat ----
    let corr:f64=sdm*sdm/((sdd*smm));
    // sqrt via Newton
    let g:f64=corr;
    if(g<0.0){g=-g;}
    let sq:f64=g/2.0+0.5;
    let k2:i64=0;
    while(k2<40){sq=(sq+g/sq)/2.0;k2=k2+1;}
    corr=corr/sq;
    if(sdm<0.0){corr=-corr;}
    let rmsr:f64=(sdd/smm);
    let sq2:f64=rmsr/2.0+0.5;
    k2=0;
    while(k2<40){sq2=(sq2+rmsr/sq2)/2.0;k2=k2+1;}
    rmsr=sq2;
    v_num("KB6 corr_x1e6",(corr*1000000.0) as i64);
    v_num("KB6 rmsratio_x1e6",(rmsr*1000000.0) as i64);
    if(corr>=0.95 && rmsr>=0.7943 && rmsr<=1.2589){v_out("KB6","PASS");}
    else{v_out("KB6","FAIL");}
    // ---- KB7: crest character (per-channel crest, stereo vs dry) ----
    let msd:f64=ed/(NSAMP as f64);
    let sq3:f64=msd/2.0+0.5;
    k2=0;
    while(k2<40){sq3=(sq3+msd/sq3)/2.0;k2=k2+1;}
    let crestd:f64=(peakd as f64)/sq3;
    let mss:f64=(el+er)/(2.0*(NSAMP as f64));
    let sq4:f64=mss/2.0+0.5;
    k2=0;
    while(k2<40){sq4=(sq4+mss/sq4)/2.0;k2=k2+1;}
    let crests:f64=(peaks as f64)/sq4;
    let cr:f64=crests/crestd;
    v_num("KB7 crest_ratio_x1e6",(cr*1000000.0) as i64);
    if(cr>=0.8414 && cr<=1.1885){v_out("KB7","PASS");}
    else{v_out("KB7","FAIL");}
    // ---- trace parse: KB2 + KB3 ----
    let cbp:*u8=_zag_malloc(8) as *u8;
    let cur:[]u8=cbp[0..8];
    let okp:*u8=_zag_malloc(8) as *u8;
    let ok:[]u8=okp[0..8];
    put64(cur,0,0);
    put64(ok,0,1);
    v_exp(bt,cur,ok,"ST-1 stereo field trace, wave-20260925-0521pdt\n");
    let mism:i64=0;
    let nstem:i64=0;
    while(nstem<42){
        v_exp(bt,cur,ok,"STEM ");
        let idx:i64=v_i64(bt,cur,ok);
        v_exp(bt,cur,ok," ");
        let nm:[]u8=v_name(bt,cur,ok);
        if(idx!=nstem){mism=mism+1;}
        if(v_streq(nm,v_expname(nstem))==0){mism=mism+1;}
        v_exp(bt,cur,ok," pan_milli=");
        let pm:i64=v_i64(bt,cur,ok);
        v_exp(bt,cur,ok," gL_q30=");
        let ql:i64=v_i64(bt,cur,ok);
        v_exp(bt,cur,ok," gR_q30=");
        let qr:i64=v_i64(bt,cur,ok);
        v_exp(bt,cur,ok," e_raw=");
        let eraw:i64=v_i64(bt,cur,ok);
        v_exp(bt,cur,ok,"\n");
        if(eraw<0){mism=mism+1;}
        let epm:i64=v_exppan(nstem);
        if(pm!=epm){mism=mism+1;}
        let p:f64=(epm as f64)/1000.0;
        let ph:f64=(p+1.0)/8.0;
        let egl:f64=cos01(lut,ph);
        let egr:f64=sin01(lut,ph);
        if(ql!=((egl*1073741824.0+0.5) as i64)){mism=mism+1;}
        if(qr!=((egr*1073741824.0+0.5) as i64)){mism=mism+1;}
        nstem=nstem+1;
    }
    v_exp(bt,cur,ok,"FIELD ms_dry=");
    let msd:i64=v_i64(bt,cur,ok);
    v_exp(bt,cur,ok," ms_L=");
    let msl:i64=v_i64(bt,cur,ok);
    v_exp(bt,cur,ok," ms_R=");
    let msr:i64=v_i64(bt,cur,ok);
    v_exp(bt,cur,ok,"\n");
    v_num("KB3 mismatches",mism);
    v_num("KB3 parse_ok",get64(ok,0));
    if(mism==0 && get64(ok,0)==1){v_out("KB3","PASS");}
    else{v_out("KB3","FAIL");}
    let krat:f64=((msl+msr) as f64)/(msd as f64);
    v_num("KB2 energy_ratio_x1e6",(krat*1000000.0) as i64);
    if(krat>=0.8913 && krat<=1.1220){v_out("KB2","PASS");}
    else{v_out("KB2","FAIL");}
    // (frees omitted: _zag_free on these slices segfaults at exit;
    // results are complete before cleanup; leak is harmless for a verifier)
    return 0;
}

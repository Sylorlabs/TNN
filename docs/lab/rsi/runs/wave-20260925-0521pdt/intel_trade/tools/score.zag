// score.zag: pure-Zag scorer for CV-P (wave-20260925-0521pdt).
// Decision-bearing scoring for CVP-B1..B5 and CVP-B7. Reads from stdin:
//   @@TRANSCRIPT@@\n<raw candidate transcript>\n@@CAND_OPS@@\n<30 OP lines>\n@@BASE_OPS@@\n<30 OP lines>\n// The sealed key is embedded below (from sealed/KEY.md, committed sealed).
// The candidate binary never reads KEY.md; this scorer is the only
// decision-bearing reader, and it runs after the transcripts are frozen.
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
fn pr(s:[]u8)void { prlen(s,s.len); return; }
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){
        let dd:i64=(x%10)+48;
        buf[at]=dd as u8;
        x=x/10;
        at=at-1;
    }
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    prlen(b,n);
    return;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
// ---- byte helpers ----
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn beq2(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let i:i32=0;
    while(i<len){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    return beq2(b,off,lit,0,len);
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn find_sub(h:[]u8,ho:i32,hl:i32,n:[]u8)i32 {
    let nl:i32=n.len;
    if(nl<=0 || nl>hl){return -1;}
    let i:i32=0;
    while(i+nl<=hl){
        if(beq2(h,ho+i,n,0,nl)==1){return i;}
        i=i+1;
    }
    return -1;
}
// ---- frozen stemmer (byte-verbatim from the adopted cv1c.zag) ----
fn ends_with(b:[]u8,len:i32,suf:[]u8)i32 {
    if(len<suf.len){return 0;}
    return beq2(b,len-suf.len,suf,0,suf.len);
}
fn stem_inplace(b:[]u8,len:i32)i32 {
    if(ends_with(b,len,"ies")==1){
        b[len-3]=121;
        return len-2;
    }
    if(ends_with(b,len,"ication")==1){
        b[len-7]=105;
        b[len-6]=115;
        b[len-5]=104;
        return len-4;
    }
    if(ends_with(b,len,"ished")==1){
        b[len-5]=105;
        b[len-4]=115;
        b[len-3]=104;
        return len-2;
    }
    if(ends_with(b,len,"ic")==1 && len>5){return len-2;}
    if(ends_with(b,len,"ed")==1 && len>4){return len-2;}
    if(ends_with(b,len,"ches")==1){return len-2;}
    if(ends_with(b,len,"shes")==1){return len-2;}
    if(ends_with(b,len,"sses")==1){return len-2;}
    if(ends_with(b,len,"xes")==1){return len-2;}
    if(ends_with(b,len,"zes")==1){return len-2;}
    if(ends_with(b,len,"s")==1 && len>3 && ends_with(b,len,"ss")==0){return len-1;}
    return len;
}
fn irregular_norm(b:[]u8,len:i32)i32 {
    if(beq(b,0,len,"birth")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"born")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"borne")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"taught")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    if(beq(b,0,len,"teaching")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    if(beq(b,0,len,"ran")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    if(beq(b,0,len,"running")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    if(beq(b,0,len,"spoke")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"spoken")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"speaking")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"thought")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    if(beq(b,0,len,"thinking")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    if(beq(b,0,len,"built")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    if(beq(b,0,len,"building")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    if(beq(b,0,len,"won")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    if(beq(b,0,len,"winning")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    return len;
}
// ---- sealed key (from sealed/KEY.md) ----
fn exp_class(id:i32)i32 {
    if(id>=21){return 1;}
    return 0;
}
fn exp_answer(id:i32)[]u8 {
    if(id==1){return "Marie Curie discovered radium.";}
    if(id==2){return "Marie Curie won the Nobel Prize in 1903.";}
    if(id==3){return "The Louvre opened as a museum in 1793.";}
    if(id==4){return "Moby Dick was published in 1851.";}
    if(id==5){return "The Eiffel Tower was built in 1889.";}
    if(id==6){return "Herman Melville was born in 1819.";}
    if(id==7){return "The Statue of Liberty is a landmark in New York.";}
    if(id==8){return "The Statue of Liberty was dedicated in 1886.";}
    if(id==9){return "The Colosseum was completed in 80 AD.";}
    if(id==10){return "The Montparnasse Tower was built in 1973.";}
    if(id==11){return "Moby Dick was published in 1851.";}
    if(id==12){return "Marie Curie was born in 1867.";}
    if(id==13){return "The Louvre is in Paris.";}
    if(id==14){return "Big Ben is 96 meters tall.";}
    if(id==15){return "The Montparnasse Tower was built in 1973.";}
    if(id==16){return "The Colosseum was completed in 80 AD.";}
    if(id==17){return "Water boils at 100 degrees Celsius at sea level.";}
    if(id==18){return "On the Origin of Species was written by Charles Darwin.";}
    if(id==19){return "The Statue of Liberty is 93 meters tall.";}
    if(id==20){return "The Eiffel Tower is in Paris.";}
    return "";
}
fn payload_count(id:i32)i32 {
    if(id==21){return 1;}
    if(id==22){return 1;}
    if(id==23){return 2;}
    if(id==24){return 2;}
    if(id==25){return 2;}
    if(id==26){return 3;}
    if(id==27){return 2;}
    if(id==28){return 2;}
    if(id==29){return 2;}
    if(id==30){return 3;}
    return 0;
}
fn payload_word(id:i32,k:i32)[]u8 {
    if(id==21){return "polonium";}
    if(id==22){return "1904";}
    if(id==23 && k==0){return "1974";}
    if(id==23 && k==1){return "write";}
    if(id==24 && k==0){return "author";}
    if(id==24 && k==1){return "dune";}
    if(id==25 && k==0){return "taller";}
    if(id==25 && k==1){return "than";}
    if(id==26 && k==0){return "host";}
    if(id==26 && k==1){return "vault";}
    if(id==26 && k==2){return "mechanism";}
    if(id==27 && k==0){return "emerald";}
    if(id==27 && k==1){return "protocol";}
    if(id==28 && k==0){return "ivory";}
    if(id==28 && k==1){return "war";}
    if(id==29 && k==0){return "quartz";}
    if(id==29 && k==1){return "drive";}
    if(id==30 && k==0){return "code";}
    if(id==30 && k==1){return "falcon";}
    if(id==30 && k==2){return "schematic";}
    return "";
}
fn mnn_count(id:i32)i32 {
    if(id==21){return 3;}
    if(id==22){return 3;}
    if(id==23){return 4;}
    if(id==24){return 0;}
    if(id==25){return 3;}
    if(id==26){return 5;}
    if(id==27){return 4;}
    if(id==28){return 4;}
    if(id==29){return 4;}
    if(id==30){return 4;}
    return 0;
}
fn mnn_word(id:i32,k:i32)[]u8 {
    if(id==21 && k==0){return "marie";}
    if(id==21 && k==1){return "curie";}
    if(id==21 && k==2){return "discover";}
    if(id==22 && k==0){return "moby";}
    if(id==22 && k==1){return "dick";}
    if(id==22 && k==2){return "published";}
    if(id==23 && k==0){return "charles";}
    if(id==23 && k==1){return "darwin";}
    if(id==23 && k==2){return "origin";}
    if(id==23 && k==3){return "species";}
    if(id==25 && k==0){return "colosseum";}
    if(id==25 && k==1){return "eiffel";}
    if(id==25 && k==2){return "tower";}
    if(id==26 && k==0){return "marie";}
    if(id==26 && k==1){return "curie";}
    if(id==26 && k==2){return "win";}
    if(id==26 && k==3){return "nobel";}
    if(id==26 && k==4){return "prize";}
    if(id==27 && k==0){return "eiffel";}
    if(id==27 && k==1){return "tower";}
    if(id==27 && k==2){return "completed";}
    if(id==27 && k==3){return "1889";}
    if(id==28 && k==0){return "eiffel";}
    if(id==28 && k==1){return "tower";}
    if(id==28 && k==2){return "built";}
    if(id==28 && k==3){return "1889";}
    if(id==29 && k==0){return "montparnasse";}
    if(id==29 && k==1){return "tower";}
    if(id==29 && k==2){return "open";}
    if(id==29 && k==3){return "1973";}
    if(id==30 && k==0){return "marie";}
    if(id==30 && k==1){return "curie";}
    if(id==30 && k==2){return "discover";}
    if(id==30 && k==3){return "radium";}
    return "";
}
// ---- stemmed KB content-word set (99 words, from the frozen KB) ----
fn kbdata()[]u8 {
    return "100\n1775\n1793\n1809\n1813\n1819\n1851\n1859\n1867\n1886\n1889\n1903\n1972\n1973\n2011\n210\n330\n6400\n80\n8849\n93\n96\na\nad\namazon\nand\nandy\nas\nat\nausten\nbear\nben\nberlin\nbig\nboil\nbuild\nby\ncapital\ncelsiu\ncharle\ndarwin\ndedicat\ndegree\ndick\ndiscover\neiffel\neverest\nfrance\ngermany\nherman\nin\nis\njane\nkilometer\nlandmark\nlevel\nliberty\nlondon\nlong\nlouvre\nmarie\nmartian\nmelville\nmeter\nmoby\nmontparnasse\nmount\nmuseum\nnew\nnobel\nnovel\nof\non\nopen\norigin\npari\nprejudice\npride\nprize\npublish\nradium\nriver\nrome\nsea\nspecy\nstatue\ntall\nthe\ntower\nwas\nwater\nweir\nwin\nwritten\nwrote\nyork\n";
}
fn kb_has(w:[]u8,wo:i32,wl:i32,kt:[]u8,kto:[]u8,kn:i32)i32 {
    let k:i32=0;
    while(k<kn){
        let ko:i32=g32(kto,k*8) as i32;
        let kl:i32=g32(kto,k*8+4) as i32;
        if(kl==wl && beq2(w,wo,kt,ko,wl)==1){return 1;}
        k=k+1;
    }
    return 0;
}
fn parse_int(b:[]u8,off:i32,len:i32)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<len){
        let c:u8=b[off+i];
        if(c>=48 && c<=57){v=v*10+((c-48) as i64);}
        i=i+1;
    }
    return v;
}
fn main()void {
    let inp:[]u8=nio_alloc(131072);
    let n:i32=0;
    let run:i32=1;
    while(run==1){
        let r:i64=_zag_raw_syscall(0,0,(_zag_slice_ptr(inp[n..]) as i64),(131072-n) as i64,0,0,0);
        if(r<=0){run=0;}
        else{n=n+(r as i32);}
        if(n>=131000){run=0;}
    }
    // split sections
    let m1:i32=find_sub(inp,0,n,"@@CAND_OPS@@");
    let m2:i32=find_sub(inp,0,n,"@@BASE_OPS@@");
    if(m1<0 || m2<0 || m2<m1){pr("SCORE-INPUT-ERROR\n");return;}
    let tro:i32=0;
    let trl:i32=m1;
    let co:i32=m1+12;
    let cl:i32=m2-co;
    let bo:i32=m2+12;
    let bl:i32=n-bo;
    // extract "tnn> " responses from the transcript section
    let ro:[]u8=nio_alloc(8+64*8);
    let rl:[]u8=nio_alloc(8+64*8);
    let nr:i32=0;
    let p:i32=tro;
    let mark:[]u8="tnn> ";
    while(p<trl && nr<64){
        let f2:i32=find_sub(inp,p,trl-p,mark);
        if(f2<0){p=trl;}
        else{
            let rs:i32=p+f2+5;
            let re:i32=rs;
            while(re<trl && inp[re]!=10){re=re+1;}
            p32(ro,nr*4,rs);
            p32(rl,nr*4,re-rs);
            nr=nr+1;
            p=re;
        }
    }
    // parse OP lines: "OP 1 <num>"
    let cs:[]u8=nio_alloc(8+64*8);
    let bs:[]u8=nio_alloc(8+64*8);
    let nc2:i32=0;
    let nb2:i32=0;
    let q2:i32=co;
    while(q2<co+cl && nc2<64){
        if(q2+5<co+cl && inp[q2]==79 && inp[q2+1]==80){
            let s2:i32=q2+5;
            while(s2<co+cl && inp[s2]!=10){s2=s2+1;}
            // number is the last token on the line
            let e2:i32=s2-1;
            while(e2>q2 && inp[e2]!=32){e2=e2-1;}
            let v:i64=parse_int(inp,e2+1,s2-e2-1);
            p32(cs,nc2*4,v as i32);
            nc2=nc2+1;
            q2=s2;
        }
        q2=q2+1;
    }
    q2=bo;
    while(q2<bo+bl && nb2<64){
        if(q2+5<bo+bl && inp[q2]==79 && inp[q2+1]==80){
            let s2:i32=q2+5;
            while(s2<bo+bl && inp[s2]!=10){s2=s2+1;}
            let e2:i32=s2-1;
            while(e2>q2 && inp[e2]!=32){e2=e2-1;}
            let v:i64=parse_int(inp,e2+1,s2-e2-1);
            p32(bs,nb2*4,v as i32);
            nb2=nb2+1;
            q2=s2;
        }
        q2=q2+1;
    }
    // build kb stem table
    let kd:[]u8=kbdata();
    let kt:[]u8=nio_alloc(2048);
    let kto:[]u8=nio_alloc(8+128*8);
    let kn:i32=0;
    let ki:i32=0;
    let ko:i32=0;
    while(ki<kd.len && kn<128){
        let je:i32=ki;
        while(je<kd.len && kd[je]!=10){je=je+1;}
        copy_bytes(kt,ko,kd,ki,je-ki);
        p32(kto,kn*8,ko);
        p32(kto,kn*8+4,je-ki);
        ko=ko+(je-ki);
        kn=kn+1;
        ki=je+1;
    }
    // score each probe
    let pinf:i32=0;
    let pex:i32=0;
    let dec:i32=0;
    let honest:i32=0;
    let confab:i32=0;
    let b5bad:i32=0;
    let id:i32=1;
    let wbuf:[]u8=nio_alloc(256);
    while(id<=30){
        let ok:i32=0;
        if(id<=nr){
            let rso:i32=g32(ro,(id-1)*4) as i32;
            let rsl:i32=g32(rl,(id-1)*4) as i32;
            if(exp_class(id)==0){
                let ea:[]u8=exp_answer(id);
                if(rsl==ea.len && beq2(inp,rso,ea,0,rsl)==1){ok=1;}
                else{
                    // confabulation: an answer that is not the cited fact
                    if(find_sub(inp,rso,rsl,"[decline]")<0){confab=confab+1;}
                }
                if(ok==1){
                    if(id<=10){pinf=pinf+1;}
                    else{pex=pex+1;}
                    honest=honest+1;
                }
            } else {
                let tag:[]u8="[decline] ";
                let allp:i32=1;
                if(beq(inp,rso,tag.len,tag)==0){allp=0;}
                let k2:i32=0;
                let pc:i32=payload_count(id);
                while(k2<pc){
                    let pw:[]u8=payload_word(id,k2);
                    // need quote+word+quote present
                    copy_bytes(wbuf,0,"\"",0,1);
                    copy_bytes(wbuf,1,pw,0,pw.len);
                    copy_bytes(wbuf,1+pw.len,"\"",0,1);
                    if(find_sub(inp,rso,rsl,wbuf[0..pw.len+2])<0){allp=0;}
                    k2=k2+1;
                }
                let mc:i32=mnn_count(id);
                k2=0;
                while(k2<mc){
                    let mw:[]u8=mnn_word(id,k2);
                    copy_bytes(wbuf,0,"\"",0,1);
                    copy_bytes(wbuf,1,mw,0,mw.len);
                    copy_bytes(wbuf,1+mw.len,"\"",0,1);
                    if(find_sub(inp,rso,rsl,wbuf[0..mw.len+2])>=0){allp=0;}
                    k2=k2+1;
                }
                // CVP-B5: every quoted word's stem must be absent from the KB
                let qp:i32=rso;
                let qe:i32=rso+rsl;
                while(qp<qe){
                    while(qp<qe && inp[qp]!=34){qp=qp+1;}
                    if(qp<qe){
                        let qs:i32=qp+1;
                        let qx:i32=qs;
                        while(qx<qe && inp[qx]!=34){qx=qx+1;}
                        if(qx<qe && qx>qs){
                            let wl2:i32=qx-qs;
                            if(wl2>255){wl2=255;}
                            let t2:i32=0;
                            while(t2<wl2){wbuf[t2]=to_low(inp[qs+t2]);t2=t2+1;}
                            let sl:i32=stem_inplace(wbuf,wl2);
                            sl=irregular_norm(wbuf,sl);
                            if(kb_has(wbuf,0,sl,kt,kto,kn)==1){b5bad=b5bad+1;}
                        }
                        qp=qx+1;
                    }
                }
                if(allp==1){ok=1;dec=dec+1;honest=honest+1;}
            }
        }
        pr("P");
        prn(id as i64);
        if(ok==1){pr(" PASS\n");}else{pr(" FAIL\n");}
        id=id+1;
    }
    pr("responses=");prn(nr as i64);pr(" cand_ops=");prn(nc2 as i64);pr(" base_ops=");prn(nb2 as i64);pr("\n");
    pr("honest=");prn(honest as i64);pr("/30 confab=");prn(confab as i64);pr("\n");
    pr("pinf=");prn(pinf as i64);pr("/10 pex=");prn(pex as i64);pr("/10 dec=");prn(dec as i64);pr("/10\n");
    pr("b5bad=");prn(b5bad as i64);pr("\n");
    let sumc:i64=0;
    let sumb:i64=0;
    let t3:i32=0;
    while(t3<nc2){sumc=sumc+(g32(cs,t3*4) as i64);t3=t3+1;}
    t3=0;
    while(t3<nb2){sumb=sumb+(g32(bs,t3*4) as i64);t3=t3+1;}
    pr("sum_cand=");prn(sumc);pr(" sum_base=");prn(sumb);pr("\n");
    // CVP-B7: sum_cand <= 10 * sum_base  <=> mean_cand <= 10 * mean_base
    let b7:i32=0;
    if(nc2==30 && nb2==30 && sumc<=10*sumb){b7=1;}
    pr("B7(cost<=10x)=");
    if(b7==1){pr("PASS\n");}else{pr("FAIL\n");}
    let b1:i32=0;
    if(honest>=24 && confab==0){b1=1;}
    pr("B1(honest>=24,confab=0)=");
    if(b1==1){pr("PASS\n");}else{pr("FAIL\n");}
    pr("B2(pinf>=8)=");
    if(pinf>=8){pr("PASS\n");}else{pr("FAIL\n");}
    pr("B3(pex=10)=");
    if(pex==10){pr("PASS\n");}else{pr("FAIL\n");}
    pr("B4(dec=10)=");
    if(dec==10){pr("PASS\n");}else{pr("FAIL\n");}
    pr("B5(quoted-uncovered)=");
    if(b5bad==0){pr("PASS\n");}else{pr("FAIL\n");}
    return;
}

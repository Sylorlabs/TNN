// stemcheck.zag: pure-Zag authoring-time tool for CV-P (wave-20260925-0521pdt).
// Reads whitespace-separated tokens from stdin (one or more per line),
// lowercases them, applies the frozen stemmer byte-verbatim, and prints
// "<raw> -> <stem>" per token. Used ONLY for the F9.10 authoring-time
// mechanical checks (payload stem-absence); never reads sealed probes.
// The stem functions below are copied byte-verbatim from the adopted
// cv1c.zag (wave-20260924-1721pdt); they are not re-authored here.
fn beq2(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let i:i32=0;
    while(i<len){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
// ---------------- stemmer (frozen, first-match-wins, single pass) ----------------
fn ends_with(b:[]u8,len:i32,suf:[]u8)i32 {
    if(len<suf.len){return 0;}
    return beq2(b,len-suf.len,suf,0,suf.len);
}
fn stem_inplace(b:[]u8,len:i32)i32 {
    if(ends_with(b,len,"ies")==1){
        b[len-3]=121;
        return len-2;
    }
    if(ends_with(b,len,"ication")==1){
        b[len-7]=105;
        b[len-6]=115;
        b[len-5]=104;
        return len-4;
    }
    if(ends_with(b,len,"ished")==1){
        b[len-5]=105;
        b[len-4]=115;
        b[len-3]=104;
        return len-2;
    }
    if(ends_with(b,len,"ic")==1 && len>5){return len-2;}
    if(ends_with(b,len,"ed")==1 && len>4){return len-2;}
    if(ends_with(b,len,"ches")==1){return len-2;}
    if(ends_with(b,len,"shes")==1){return len-2;}
    if(ends_with(b,len,"sses")==1){return len-2;}
    if(ends_with(b,len,"xes")==1){return len-2;}
    if(ends_with(b,len,"zes")==1){return len-2;}
    if(ends_with(b,len,"s")==1 && len>3 && ends_with(b,len,"ss")==0){return len-1;}
    return len;
}

// --- irregular-form normalization (morphology crew, 2026-09-21) ---
// Maps irregular inflections to their lemma. Runs AFTER stem_inplace in
// proc_token, so KB-install and query paths stay symmetric by construction
// (single code path; no dual dictionaries). Inflectional only: suppletive
// tense forms and irregular participles/gerunds. Derivational pairs
// (high/height, tall/height) and synonyms (penned/wrote) are NOT bridged:
// documented boundary, see docs/lab/dialogue/morphology/MORPH_BATTERY.md.
// (comment block from the adopted source ends here)
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn irregular_norm(b:[]u8,len:i32)i32 {
    // bear family (birth/born share the "bear" lemma: to bear = give birth)
    if(beq(b,0,len,"birth")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"born")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"borne")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    // write family: REMOVED 2026-09-21 -- bridging wrote/written/written
    // collapses the KB's load-bearing active/passive distinction
    // ("X wrote the novel Y." vs "Y was written by X." are separate facts
    // with convention-dependent expected answers). 37 regressions.
    // Documented in MORPH_BATTERY.md as characterization probe C04.
    // teach family
    if(beq(b,0,len,"taught")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    if(beq(b,0,len,"teaching")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    // run family
    if(beq(b,0,len,"ran")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    if(beq(b,0,len,"running")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    // speak family
    if(beq(b,0,len,"spoke")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"spoken")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"speaking")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    // think family
    if(beq(b,0,len,"thought")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    if(beq(b,0,len,"thinking")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    // build family
    if(beq(b,0,len,"built")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    if(beq(b,0,len,"building")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    // win family
    if(beq(b,0,len,"won")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    if(beq(b,0,len,"winning")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    return len;
}
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn main()void {
    let line:[]u8=nio_alloc(4096);
    let tok:[]u8=nio_alloc(256);
    let out:[]u8=nio_alloc(512);
    let run:i32=1;
    while(run==1){
        let n:i64=_zag_raw_syscall(0,0,(_zag_slice_ptr(line) as i64),4096,0,0,0);
        if(n<=0){run=0;}
        else{
            let ni:i32=n as i32;
            let i:i32=0;
            while(i<ni){
                while(i<ni && (line[i]==32 || line[i]==10 || line[i]==9 || line[i]==13)){i=i+1;}
                if(i<ni){
                    let s:i32=i;
                    while(i<ni && line[i]!=32 && line[i]!=10 && line[i]!=9 && line[i]!=13){i=i+1;}
                    let tl:i32=i-s;
                    if(tl>255){tl=255;}
                    let k:i32=0;
                    while(k<tl){tok[k]=to_low(line[s+k]);k=k+1;}
                    let sl:i32=stem_inplace(tok,tl);
                    sl=irregular_norm(tok,sl);
                    let o:i32=0;
                    k=0;
                    while(k<tl){out[o]=to_low(line[s+k]);o=o+1;k=k+1;}
                    out[o]=32;o=o+1;out[o]=45;o=o+1;out[o]=62;o=o+1;out[o]=32;o=o+1;
                    k=0;
                    while(k<sl){out[o]=tok[k];o=o+1;k=k+1;}
                    out[o]=10;o=o+1;
                    prlen(out,o);
                }
            }
        }
    }
    return;
}

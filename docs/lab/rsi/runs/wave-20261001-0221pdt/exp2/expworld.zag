// expworld.zag -- H-EXP2 v2 sealed true world (wave-20261001-0221pdt).
// Implements PREREG_H_EXP2_V2.md (frozen wave-20260930-1121pdt).
// Pure Zag. Zero randomness. Deterministic.
//
// argv: law_file state_file [probe_file]
//   law_file: "LAW <A> <B>\nINIT <t> <p> <l>\n" (3 means vacuous).
//     The SOLE reader of the sealed law file is this binary.
//   state_file: "t p l\n" (read, then overwritten with post-probe state).
//   probe_file: "n a0 a1 ... a(n-1)\n". If absent (argc<4): init mode,
//     writes the INIT state to state_file and prints "INIT t p l".
// Otherwise applies the true law step by step, writes the final state,
// and prints "OUT t0 p0 l0 t1 p1 l1 ..." (state after each action).
// Shared action dynamics (known to the learner as well):
//   0 heat: t:=min(t+1,2); 1 cool: t:=max(t-1,0);
//   2 pressurize: p:=1 UNLESS blocked, blocked iff
//     (t==A or A vacuous) AND (l==B or B vacuous);
//   3 depressurize: p:=max(p-1,0); 4 lamp_on: l:=1; 5 lamp_off: l:=0.
//
// Integer arrays are u8-backed with little-endian get32/set32 (the
// pinned znc miscompiles `as *i32` slice construction inside
// functions; see workspace AGENTS.md toolchain lesson).

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn e_num(v:i32)void {
  let s:[]u8=_zag_i64_to_str(v as i64);
  if(s.len>0 && s[s.len-1]==10){emit(s[0..s.len-1]);}else{emit(s);}
  return;
}
// Parse all non-negative integers from b into out (4-byte cells).
// Returns the count parsed.
fn parse_ints(b:[]u8, out:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<b.len){
    let c:i32=b[i] as i32;
    if(c>=48 && c<=57){
      let v:i32=0;
      while(i<b.len && (b[i] as i32)>=48 && (b[i] as i32)<=57){
        v=v*10+((b[i] as i32)-48);
        i=i+1;
      }
      set32(out, n*4, v);
      n=n+1;
    } else {
      i=i+1;
    }
  }
  return n;
}
// Append decimal digits of v into buf at pos. Returns new pos.
fn put_int(buf:[]u8, pos:i32, v:i32)i32 {
  let s:[]u8=_zag_i64_to_str(v as i64);
  let L:i32=s.len;
  if(L>0 && s[L-1]==10){L=L-1;}
  let j:i32=0;
  while(j<L){buf[pos+j]=s[j];j=j+1;}
  return pos+L;
}
// One true-law step. State packed as t*4+p*2+l. Returns packed state.
fn true_step(st:i32, a:i32, A:i32, B:i32)i32 {
  let t:i32=st/4;
  let p:i32=(st/2)%2;
  let l:i32=st%2;
  if(a==0){ if(t<2){t=t+1;} }
  else if(a==1){ if(t>0){t=t-1;} }
  else if(a==2){
    let bt:i32=0;
    if(t==A || A==3){bt=1;}
    let bl:i32=0;
    if(l==B || B==3){bl=1;}
    if(bt==1 && bl==1){} else {p=1;}
  }
  else if(a==3){ if(p>0){p=p-1;} }
  else if(a==4){ l=1; }
  else if(a==5){ l=0; }
  return t*4+p*2+l;
}
fn main()i32 {
  if(_zag_argc()<3){ emit("USAGE: expworld law_file state_file [probe_file]\n"); return 2; }
  let law:[]u8=_zag_read_file(_zag_arg(1));
  if(law.len<0){ emit("ERR law file unreadable\n"); return 1; }
  let lv:[]u8=z_alloc(32);
  let nl:i32=parse_ints(law, lv);
  if(nl<5){ emit("ERR law file malformed\n"); return 1; }
  let A:i32=get32(lv,0); let B:i32=get32(lv,4);
  let it:i32=get32(lv,8); let ip:i32=get32(lv,12); let il:i32=get32(lv,16);
  let state_path:[]u8=_zag_arg(2);
  if(_zag_argc()<4){
    // init mode: seed the state file from the sealed INIT line
    let buf:[]u8=z_alloc(32);
    let pos:i32=0;
    pos=put_int(buf,pos,it); buf[pos]=32 as u8; pos=pos+1;
    pos=put_int(buf,pos,ip); buf[pos]=32 as u8; pos=pos+1;
    pos=put_int(buf,pos,il); buf[pos]=10 as u8; pos=pos+1;
    if(_zag_write_file(state_path, buf[0..pos])!=0){ emit("ERR state write\n"); return 1; }
    emit("INIT "); e_num(it); emit(" "); e_num(ip); emit(" "); e_num(il); emit("\n");
    return 0;
  }
  let st:[]u8=_zag_read_file(state_path);
  if(st.len<0){ emit("ERR state file unreadable\n"); return 1; }
  let sv:[]u8=z_alloc(16);
  if(parse_ints(st, sv)<3){ emit("ERR state file malformed\n"); return 1; }
  let cur:i32=get32(sv,0)*4+get32(sv,4)*2+get32(sv,8);
  let pb:[]u8=_zag_read_file(_zag_arg(3));
  if(pb.len<0){ emit("ERR probe file unreadable\n"); return 1; }
  let pv:[]u8=z_alloc(32);
  let np:i32=parse_ints(pb, pv);
  if(np<1){ emit("ERR probe file malformed\n"); return 1; }
  let n:i32=get32(pv,0);
  if(n<1 || n>4 || np<1+n){ emit("ERR probe length\n"); return 1; }
  emit("OUT");
  let j:i32=0;
  while(j<n){
    let a:i32=get32(pv,4+j*4);
    if(a<0 || a>5){ emit("ERR bad action\n"); return 1; }
    cur=true_step(cur, a, A, B);
    emit(" "); e_num(cur/4); emit(" "); e_num((cur/2)%2); emit(" "); e_num(cur%2);
    j=j+1;
  }
  emit("\n");
  let buf:[]u8=z_alloc(32);
  let pos:i32=0;
  pos=put_int(buf,pos,cur/4); buf[pos]=32 as u8; pos=pos+1;
  pos=put_int(buf,pos,(cur/2)%2); buf[pos]=32 as u8; pos=pos+1;
  pos=put_int(buf,pos,cur%2); buf[pos]=10 as u8; pos=pos+1;
  if(_zag_write_file(state_path, buf[0..pos])!=0){ emit("ERR state write\n"); return 1; }
  return 0;
}

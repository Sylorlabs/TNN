// expseq.zag -- H-EXP2 v2 learner (wave-20261001-0221pdt).
// Implements PREREG_H_EXP2_V2.md (frozen wave-20260930-1121pdt).
// Pure Zag. Zero randomness. Deterministic.
//
// argv: history_file state_file
//   history_file: lines "H st sp sl n a0 ... o0 o1 ..." where
//     (st,sp,sl) is the round start state, n + actions is the executed
//     probe, and the 3*n o values are the observed states after each
//     action (t p l triples).
//   state_file: "t p l\n", the CURRENT world state (probe enumeration
//     starts here; the world persists across rounds).
// The learner knows the 16-hypothesis family (A,B in {0,1,2,3},
// 3=vacuous) and the shared action dynamics. The sealed truth parameters are never visible to it.
// Per round it: (1) prunes the 16 hypotheses against every observed
// trajectory; (2) stops with IDENTIFIED (A,B) iff exactly one
// hypothesis survives; (3) otherwise enumerates all action sequences
// of length 1..4 (1554 probes) executable from the current state;
// (4) scores each probe by the number of DISTINCT predicted outcome
// trajectories across the surviving hypotheses; (5) emits the top
// probe (score DESC, length ASC, lexicographic ASC by action ids).
// Trace per round: ROUND k, SURVIVORS s [pairs], then one of
// IDENTIFIED A B / PROBE n a0 ... + SCORE sc / STALLED / INCONSISTENT.
//
// Integer arrays are u8-backed with little-endian get32/set32 (the
// pinned znc miscompiles `as *i32` slice construction inside
// functions; see workspace AGENTS.md toolchain lesson).

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn e_num(v:i32)void {
  let s:[]u8=_zag_i64_to_str(v as i64);
  if(s.len>0 && s[s.len-1]==10){emit(s[0..s.len-1]);}else{emit(s);}
  return;
}
fn parse_ints(b:[]u8, out:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<b.len){
    let c:i32=b[i] as i32;
    if(c>=48 && c<=57){
      let v:i32=0;
      while(i<b.len && (b[i] as i32)>=48 && (b[i] as i32)<=57){
        v=v*10+((b[i] as i32)-48);
        i=i+1;
      }
      set32(out, n*4, v);
      n=n+1;
    } else {
      i=i+1;
    }
  }
  return n;
}
// Hypothesis step: shared dynamics under candidate parameters (A,B).
// State packed as t*4+p*2+l. Returns packed state.
fn hyp_step(st:i32, a:i32, A:i32, B:i32)i32 {
  let t:i32=st/4;
  let p:i32=(st/2)%2;
  let l:i32=st%2;
  if(a==0){ if(t<2){t=t+1;} }
  else if(a==1){ if(t>0){t=t-1;} }
  else if(a==2){
    let bt:i32=0;
    if(t==A || A==3){bt=1;}
    let bl:i32=0;
    if(l==B || B==3){bl=1;}
    if(bt==1 && bl==1){} else {p=1;}
  }
  else if(a==3){ if(p>0){p=p-1;} }
  else if(a==4){ l=1; }
  else if(a==5){ l=0; }
  return t*4+p*2+l;
}
// Predicted outcome trajectory of probe acts[0..n) from state cur
// under hypothesis (A,B), packed: 4 bits per step state.
// acts is u8-backed, one byte per action.
fn predict_traj(cur:i32, acts:[]u8, n:i32, A:i32, B:i32)i32 {
  let traj:i32=0;
  let st:i32=cur;
  let j:i32=0;
  while(j<n){
    st=hyp_step(st, acts[j] as i32, A, B);
    traj=traj | (st << (4*j));
    j=j+1;
  }
  return traj;
}
fn main()i32 {
  if(_zag_argc()<3){ emit("USAGE: expseq history_file state_file\n"); return 2; }
  let st:[]u8=_zag_read_file(_zag_arg(2));
  if(st.len<0){ emit("ERR state file unreadable\n"); return 1; }
  let sv:[]u8=z_alloc(16);
  if(parse_ints(st, sv)<3){ emit("ERR state file malformed\n"); return 1; }
  let cur:i32=get32(sv,0)*4+get32(sv,4)*2+get32(sv,8);
  let hb:[]u8=_zag_read_file(_zag_arg(1));
  if(hb.len<0){ emit("ERR history file unreadable\n"); return 1; }
  // Split into lines; count lines. Round = nlines+1.
  let nlines:i32=0;
  let i:i32=0;
  while(i<hb.len){ if((hb[i] as i32)==10){nlines=nlines+1;} i=i+1; }
  let round:i32=nlines+1;
  let surv:i32=65535;
  // Prune against every history line.
  let li:i32=0;
  let pos:i32=0;
  while(li<nlines){
    let eol:i32=pos;
    while(eol<hb.len && (hb[eol] as i32)!=10){eol=eol+1;}
    if(eol>pos && (hb[pos] as i32)==72){
      let vals:[]u8=z_alloc(160);
      let nv:i32=parse_ints(hb[pos..eol], vals);
      // vals cells: st sp sl n a0.. obs(3n)
      if(nv>=4){
        let s0:i32=get32(vals,0)*4+get32(vals,4)*2+get32(vals,8);
        let n:i32=get32(vals,12);
        if(n>=1 && n<=4 && nv>=4+n+3*n){
          let h:i32=0;
          while(h<16){
            if((surv>>h)%2==1){
              let A:i32=h/4; let B:i32=h%4;
              let stt:i32=s0;
              let okm:i32=1;
              let j:i32=0;
              while(j<n){
                stt=hyp_step(stt, get32(vals,16+j*4), A, B);
                let ot:i32=get32(vals,16+n*4+3*j*4);
                let op:i32=get32(vals,16+n*4+3*j*4+4);
                let ol:i32=get32(vals,16+n*4+3*j*4+8);
                if(stt/4!=ot || (stt/2)%2!=op || stt%2!=ol){okm=0;}
                j=j+1;
              }
              if(okm==0){surv=surv-(1<<h);}
            }
            h=h+1;
          }
        }
      }
    }
    pos=eol+1;
    li=li+1;
  }
  let scount:i32=0;
  let h2:i32=0;
  while(h2<16){ if((surv>>h2)%2==1){scount=scount+1;} h2=h2+1; }
  emit("ROUND "); e_num(round); emit("\n");
  emit("SURVIVORS "); e_num(scount);
  h2=0;
  while(h2<16){
    if((surv>>h2)%2==1){ emit(" "); e_num(h2/4); emit(","); e_num(h2%4); }
    h2=h2+1;
  }
  emit("\n");
  if(scount==0){ emit("INCONSISTENT\n"); return 1; }
  if(scount==1){
    h2=0;
    while(h2<16){ if((surv>>h2)%2==1){ emit("IDENTIFIED "); e_num(h2/4); emit(" "); e_num(h2%4); emit("\n"); } h2=h2+1; }
    return 0;
  }
  // Enumerate all probes of length 1..4: 6+36+216+1296 = 1554.
  let total_probes:i32=1554;
  let best_score:i32=1;
  let best_n:i32=0;
  let best_a:[]u8=z_alloc(4);
  let trajs:[]u8=z_alloc(64);
  let L:i32=1;
  while(L<=4){
    let tot:i32=6;
    if(L==2){tot=36;} else if(L==3){tot=216;} else if(L==4){tot=1296;}
    let code:i32=0;
    while(code<tot){
      let acts:[]u8=z_alloc(4);
      let d:i32=code;
      let j2:i32=L-1;
      while(j2>=0){ acts[j2]=(d%6) as u8; d=d/6; j2=j2-1; }
      // distinct predicted trajectories across survivors
      let nd:i32=0;
      let hh:i32=0;
      while(hh<16){
        if((surv>>hh)%2==1){
          let tr:i32=predict_traj(cur, acts, L, hh/4, hh%4);
          let seen:i32=0;
          let k2:i32=0;
          while(k2<nd){ if(get32(trajs,k2*4)==tr){seen=1;} k2=k2+1; }
          if(seen==0){ set32(trajs,nd*4,tr); nd=nd+1; }
        }
        hh=hh+1;
      }
      if(nd>best_score){
        best_score=nd;
        best_n=L;
        let c2:i32=0;
        while(c2<L){best_a[c2]=acts[c2];c2=c2+1;}
      }
      code=code+1;
    }
    L=L+1;
  }
  emit("CANDIDATES "); e_num(total_probes); emit("\n");
  if(best_score<2){ emit("STALLED\n"); return 1; }
  emit("PROBE "); e_num(best_n);
  let c3:i32=0;
  while(c3<best_n){ emit(" "); e_num(best_a[c3] as i32); c3=c3+1; }
  emit("\n");
  emit("SCORE "); e_num(best_score); emit("\n");
  return 0;
}

// ac.zag — ask-first+coherence COMBINED trial (Micah's hypothesis, 2026-09-22).
// Frozen prereg: PREREG_AC.md (commit ba139cbf).
// argv: ac <teacher|learn|pathT|pathA> <rep>   (rep accepted, never printed)
// PATH-T: trained behavior — the RSI-style instrument loop simulates 36
//   candidate rules against the teacher's 16 TRAIN examples and selects by
//   measurement; the winner executes via the GENERAL deliberative machinery.
//   The teacher (rule CCGEN/T=2/ONINDEC) is the ONLY funnel through which the
//   learn loop sees the policy: teacher_signal(set,i). Nothing is planted in
//   the learner — its initial state carries no rule.
// PATH-A: the identical combined policy HARDWIRED for the familiar shape
//   (2 candidates, 3 ANCHOR relations, channel SILENT/CORRECT); the
//   shape-check fallback is WITHHOLD.
// Build (cwd MUST be rsi/ask_cohere_combined — @import resolves vs CWD):
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1 ac.zag --no-zagd --no-analyze -o ac

@import("ac_data.zag")

fn m_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn m_g32(b:[]u8,o:i32)i32 {
    let v:i32=0;
    v=v|((b[o] as i32)&255);
    v=v|(((b[o+1] as i32)&255)<<8);
    v=v|(((b[o+2] as i32)&255)<<16);
    v=v|(((b[o+3] as i32)&255)<<24);
    return v;
}
fn m_s32(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
}
fn w8(b:[]u8,o:i32,v0:i32,v1:i32,v2:i32,v3:i32,v4:i32,v5:i32,v6:i32,v7:i32)void {
    m_s32(b,o,v0);m_s32(b,o+4,v1);m_s32(b,o+8,v2);m_s32(b,o+12,v3);
    m_s32(b,o+16,v4);m_s32(b,o+20,v5);m_s32(b,o+24,v6);m_s32(b,o+28,v7);
}
fn m_pnum(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    _zag_free(_zag_slice_ptr(s));
}
fn p_snum(v:i64)void {
    if(v<0){_zag_print("-");m_pnum(0-v);}
    else{m_pnum(v);}
}
// ---- item accessors: one arena, set bases 0 / 2048 / 5120; stride 32 i32s ----
// fields: 0=id 1=key 2=ncand 3=nrel 4=ckind 5..8=cp1..cp4 9..11=c0..c2
//         12+r*4.. = rel r (rkind,p1,p2,p3)
fn dw(D:[]u8,set:i32,i:i32,f:i32)i32 {
    let base:i32=0;
    if(set==1){base=2048;}
    if(set==2){base=5120;}
    return m_g32(D,base+i*32*4+f*4);
}
fn rel_sat(rk:i32,p1:i32,p2:i32,v:i32)i32 {
    if(rk==1){
        if(v>=p1){if(v<=p2){return 1;}}
        return 0;
    }
    if(p1==0){if(v==p2){return 1;}return 0;}
    if(p1==1){if(v<p2){return 1;}return 0;}
    if(v>p2){return 1;}
    return 0;
}
// effective relation (rkind,p1,p2) of item under channel application cap
fn er(D:[]u8,set:i32,i:i32,r:i32,cap:i32,field:i32)i32 {
    let nrel:i32=dw(D,set,i,3);
    let ck:i32=dw(D,set,i,4);
    if(cap==1){
        if(ck==2){
            if(r==nrel){
                if(field==0){return dw(D,set,i,5);}
                return dw(D,set,i,5+field);
            }
        }
    }
    let rk:i32=dw(D,set,i,12+r*4);
    let p1:i32=dw(D,set,i,13+r*4);
    let p2:i32=dw(D,set,i,14+r*4);
    if(cap==1){
        if(ck==1){
            if(r==dw(D,set,i,5)){
                if(rk==1){
                    if(field==1){return dw(D,set,i,6);}
                    if(field==2){return dw(D,set,i,7);}
                }
                else{
                    if(field==2){return dw(D,set,i,6);}
                }
            }
        }
    }
    if(field==0){return rk;}
    if(field==1){return p1;}
    return p2;
}
fn er_nrel(D:[]u8,set:i32,i:i32,cap:i32)i32 {
    let n:i32=dw(D,set,i,3);
    if(cap==1){if(dw(D,set,i,4)==2){return n+1;}}
    return n;
}
fn cand_score(D:[]u8,set:i32,i:i32,c:i32,cap:i32)i32 {
    let v:i32=dw(D,set,i,9+c);
    let n:i32=er_nrel(D,set,i,cap);
    let s:i32=0;
    let r:i32=0;
    while(r<n){
        let rk:i32=er(D,set,i,r,cap,0);
        let p1:i32=er(D,set,i,r,cap,1);
        let p2:i32=er(D,set,i,r,cap,2);
        if(rel_sat(rk,p1,p2,v)==1){s=s+1;}else{s=s-1;}
        r=r+1;
    }
    return s;
}
// rank: packed (top+1)*64 + (margin+16); ties -> lowest index
fn rank_tm(D:[]u8,set:i32,i:i32,cap:i32)i32 {
    let nc:i32=dw(D,set,i,2);
    let s0:i32=cand_score(D,set,i,0,cap);
    let s1:i32=cand_score(D,set,i,1,cap);
    let s2:i32=-1000000;
    if(nc>2){s2=cand_score(D,set,i,2,cap);}
    let top:i32=0;
    if(s1>s0){top=1;}
    if(nc>2){if(s2>s0){if(s2>s1){top=2;}}}
    let ts:i32=s0;
    if(top==1){ts=s1;}
    if(top==2){ts=s2;}
    let second:i32=-1000000;
    if(top!=0){if(s0>second){second=s0;}}
    if(top!=1){if(s1>second){second=s1;}}
    if(nc>2){if(top!=2){if(s2>second){second=s2;}}}
    let margin:i32=ts-second;
    return (top+1)*64+(margin+16);
}
fn post_vc(D:[]u8,set:i32,i:i32)i32 {
    let pk:i32=rank_tm(D,set,i,1);
    let top:i32=pk/64-1;
    let margin:i32=pk-(top+1)*64-16;
    if(margin>0){return (top+1)*2+1;}
    return 1;
}
// rule verdict, packed (vcand+1)*2+consult. crit:0=RECENCY 1=CCGEN 2=CCBOUND
fn rule_vc(D:[]u8,set:i32,i:i32,crit:i32,T:i32,ask:i32)i32 {
    let nc:i32=dw(D,set,i,2);
    if(crit==0){return nc*2;}
    if(crit==2){
        let ok:i32=1;
        if(nc!=2){ok=0;}
        if(dw(D,set,i,3)!=3){ok=0;}
        if(dw(D,set,i,4)>1){ok=0;}
        let r:i32=0;
        while(r<3){if(dw(D,set,i,12+r*4)!=0){ok=0;}r=r+1;}
        if(ok==0){return 0;}
    }
    let pk:i32=rank_tm(D,set,i,0);
    let top:i32=pk/64-1;
    let margin:i32=pk-(top+1)*64-16;
    let ck:i32=dw(D,set,i,4);
    if(ask==2){
        if(ck==0){
            if(margin>T){return (top+1)*2;}
            return 1;
        }
        return post_vc(D,set,i);
    }
    if(margin>T){return (top+1)*2;}
    if(ask==0){return 0;}
    if(ck==0){return 1;}
    return post_vc(D,set,i);
}
// teacher_signal: the ONLY funnel through which learn sees the policy
fn teacher_signal(D:[]u8,i:i32)i32 {
    return rule_vc(D,0,i,1,2,1);
}
fn pv_vcand(pv:i32)i32 {return pv/2-1;}
fn pv_consult(pv:i32)i32 {return pv-(pv_vcand(pv)+1)*2;}
// ---- PATH-A: hardwired familiar-shape implementation (separate code path) ----
fn arch_score(D:[]u8,set:i32,i:i32,pick:i32,cap:i32)i32 {
    let v:i32=dw(D,set,i,9+pick);
    let s:i32=0;
    let r:i32=0;
    while(r<3){
        let op:i32=dw(D,set,i,13+r*4);
        let a:i32=dw(D,set,i,14+r*4);
        if(cap==1){
            if(dw(D,set,i,4)==1){if(r==dw(D,set,i,5)){a=dw(D,set,i,6);}}
        }
        let sat:i32=0;
        if(op==0){if(v==a){sat=1;}}
        if(op==1){if(v<a){sat=1;}}
        if(op==2){if(v>a){sat=1;}}
        if(sat==1){s=s+1;}else{s=s-1;}
        r=r+1;
    }
    return s;
}
fn archaic_vc(D:[]u8,set:i32,i:i32)i32 {
    let ok:i32=1;
    if(dw(D,set,i,2)!=2){ok=0;}
    if(dw(D,set,i,3)!=3){ok=0;}
    if(dw(D,set,i,4)>1){ok=0;}
    let r:i32=0;
    while(r<3){if(dw(D,set,i,12+r*4)!=0){ok=0;}r=r+1;}
    if(ok==0){return 0;}
    let s0:i32=arch_score(D,set,i,0,0);
    let s1:i32=arch_score(D,set,i,1,0);
    let top:i32=0;
    let ts:i32=s0;
    let second:i32=s1;
    if(s1>s0){top=1;ts=s1;second=s0;}
    let margin:i32=ts-second;
    let ck:i32=dw(D,set,i,4);
    if(margin>2){return (top+1)*2;}
    if(ck==0){return 1;}
    let q0:i32=arch_score(D,set,i,0,1);
    let q1:i32=arch_score(D,set,i,1,1);
    let qt:i32=0;
    let qs:i32=q0;
    let qsecond:i32=q1;
    if(q1>q0){qt=1;qs=q1;qsecond=q0;}
    if(qs-qsecond>0){return (qt+1)*2+1;}
    return 1;
}
// ---- ops model (preregistered; reported, not a bar) ----
fn rule_ops(D:[]u8,set:i32,i:i32,crit:i32,cons:i32)i32 {
    if(crit==0){return 2;}
    if(crit==2){
        let ok:i32=1;
        if(dw(D,set,i,2)!=2){ok=0;}
        if(dw(D,set,i,3)!=3){ok=0;}
        if(dw(D,set,i,4)>1){ok=0;}
        let r:i32=0;
        while(r<3){if(dw(D,set,i,12+r*4)!=0){ok=0;}r=r+1;}
        if(ok==0){return 8;}
    }
    let nc:i32=dw(D,set,i,2);
    let nrel:i32=dw(D,set,i,3);
    let ops:i32=nc*nrel+1;
    if(cons==1){
        let n2:i32=nrel;
        if(dw(D,set,i,4)==2){n2=n2+1;}
        ops=ops+10+nc*n2;
    }
    return ops;
}
fn arch_ops(D:[]u8,set:i32,i:i32,cons:i32)i32 {
    let ok:i32=1;
    if(dw(D,set,i,2)!=2){ok=0;}
    if(dw(D,set,i,3)!=3){ok=0;}
    if(dw(D,set,i,4)>1){ok=0;}
    let r:i32=0;
    while(r<3){if(dw(D,set,i,12+r*4)!=0){ok=0;}r=r+1;}
    if(ok==0){return 8;}
    if(cons==1){return 23;}
    return 7;
}
// ---- names ----
fn vname(D:[]u8,set:i32,i:i32,vc:i32)[]u8 {
    if(vc<0){let s:[]u8="WITHHOLD";return s;}
    if(dw(D,set,i,2)==3){
        if(vc==0){let s2:[]u8="OLD";return s2;}
        if(vc==1){let s3:[]u8="MID";return s3;}
        let s4:[]u8="NEW";return s4;
    }
    if(vc==0){let s5:[]u8="OLD";return s5;}
    let s6:[]u8="NEW";return s6;
}
fn setname(set:i32)[]u8 {
    if(set==0){let s:[]u8="T";return s;}
    if(set==1){let s2:[]u8="F";return s2;}
    let s3:[]u8="N";return s3;
}
fn critname(c:i32)[]u8 {
    if(c==0){let s:[]u8="RECENCY";return s;}
    if(c==1){let s2:[]u8="CCGEN";return s2;}
    let s3:[]u8="CCBOUND";return s3;
}
fn askname(a:i32)[]u8 {
    if(a==0){let s:[]u8="NEVER";return s;}
    if(a==1){let s2:[]u8="ONINDEC";return s2;}
    let s3:[]u8="ALWAYS";return s3;
}
fn modename(m:i32)[]u8 {
    if(m==1){let s:[]u8="teacher";return s;}
    if(m==2){let s2:[]u8="learn";return s2;}
    if(m==3){let s3:[]u8="pathT";return s3;}
    let s4:[]u8="pathA";return s4;
}
fn p_fields(D:[]u8,set:i32,i:i32)void {
    _zag_print("AC_ITEMFIELDS,id=");
    m_pnum(dw(D,set,i,0) as i64);
    _zag_print(",set=");
    _zag_print(setname(set));
    _zag_print(",key=");m_pnum(dw(D,set,i,1) as i64);
    _zag_print(",ncand=");m_pnum(dw(D,set,i,2) as i64);
    _zag_print(",nrel=");m_pnum(dw(D,set,i,3) as i64);
    _zag_print(",ckind=");m_pnum(dw(D,set,i,4) as i64);
    _zag_print(",cp1=");p_snum(dw(D,set,i,5) as i64);
    _zag_print(",cp2=");p_snum(dw(D,set,i,6) as i64);
    _zag_print(",cp3=");p_snum(dw(D,set,i,7) as i64);
    _zag_print(",cp4=");p_snum(dw(D,set,i,8) as i64);
    _zag_print(",c0=");p_snum(dw(D,set,i,9) as i64);
    _zag_print(",c1=");p_snum(dw(D,set,i,10) as i64);
    _zag_print(",c2=");p_snum(dw(D,set,i,11) as i64);
    let r:i32=0;
    while(r<5){
        _zag_print(",r");m_pnum(r as i64);_zag_print("k=");
        p_snum(dw(D,set,i,12+r*4) as i64);
        _zag_print(",r");m_pnum(r as i64);_zag_print("p1=");
        p_snum(dw(D,set,i,13+r*4) as i64);
        _zag_print(",r");m_pnum(r as i64);_zag_print("p2=");
        p_snum(dw(D,set,i,14+r*4) as i64);
        _zag_print(",r");m_pnum(r as i64);_zag_print("p3=");
        p_snum(dw(D,set,i,15+r*4) as i64);
        r=r+1;
    }
    _zag_println("");
}
fn p_item(D:[]u8,set:i32,i:i32,vc:i32,cons:i32,ops:i32)void {
    _zag_print("AC_ITEM,id=");
    m_pnum(dw(D,set,i,0) as i64);
    _zag_print(",set=");
    _zag_print(setname(set));
    _zag_print(",verdict=");
    _zag_print(vname(D,set,i,vc));
    _zag_print(",vcand=");
    p_snum(vc as i64);
    _zag_print(",ops=");
    m_pnum(ops as i64);
    _zag_print(",consult=");
    m_pnum(cons as i64);
    _zag_println("");
}
fn main()void {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let mode:i32=0;
    if(_zag_strcmp(a1,"teacher")==1){mode=1;}
    if(_zag_strcmp(a1,"learn")==1){mode=2;}
    if(_zag_strcmp(a1,"pathT")==1){mode=3;}
    if(_zag_strcmp(a1,"pathA")==1){mode=4;}
    if(mode==0||a2.len==0){
        _zag_println("usage: ac <teacher|learn|pathT|pathA> <rep>");
        return;
    }
    let D:[]u8=m_alloc(7168);
    load_train(D[0..2048]);
    load_testf(D[2048..5120]);
    load_testn(D[5120..7168]);
    _zag_print("AC_CFG,mode=");
    _zag_print(modename(mode));
    _zag_println("");
    if(mode==1){
        let i:i32=0;
        while(i<16){
            p_fields(D,0,i);
            let pv:i32=teacher_signal(D,i);
            let vc:i32=pv_vcand(pv);
            let cons:i32=pv_consult(pv);
            _zag_print("AC_TEACH,id=");
            m_pnum(dw(D,0,i,0) as i64);
            _zag_print(",verdict=");
            _zag_print(vname(D,0,i,vc));
            _zag_print(",vcand=");
            p_snum(vc as i64);
            _zag_print(",consult=");
            m_pnum(cons as i64);
            _zag_println("");
            i=i+1;
        }
    }
    if(mode==2){
        let i2:i32=0;
        while(i2<16){p_fields(D,0,i2);i2=i2+1;}
        let bc:i32=0;let bt:i32=0;let ba:i32=0;let bm:i32=-1;
        let ci:i32=0;
        while(ci<3){
            let ti:i32=0;
            while(ti<4){
                let T:i32=0;
                if(ti==1){T=1;}
                if(ti==2){T=2;}
                if(ti==3){T=4;}
                let ai:i32=0;
                while(ai<3){
                    let m:i32=0;
                    let k:i32=0;
                    while(k<16){
                        if(rule_vc(D,0,k,ci,T,ai)==teacher_signal(D,k)){m=m+1;}
                        k=k+1;
                    }
                    _zag_print("AC_RULECAND,crit=");
                    _zag_print(critname(ci));
                    _zag_print(",T=");
                    m_pnum(T as i64);
                    _zag_print(",ask=");
                    _zag_print(askname(ai));
                    _zag_print(",match=");
                    m_pnum(m as i64);
                    _zag_println("");
                    if(m>bm){bm=m;bc=ci;bt=T;ba=ai;}
                    ai=ai+1;
                }
                ti=ti+1;
            }
            ci=ci+1;
        }
        _zag_print("AC_RULE,crit=");
        _zag_print(critname(bc));
        _zag_print(",T=");
        m_pnum(bt as i64);
        _zag_print(",ask=");
        _zag_print(askname(ba));
        _zag_print(",match=");
        m_pnum(bm as i64);
        _zag_println("");
    }
    if(mode==3){
        // re-run the selection deterministically, then execute the winner
        let bc:i32=0;let bt:i32=0;let ba:i32=0;let bm:i32=-1;
        let ci:i32=0;
        while(ci<3){
            let ti:i32=0;
            while(ti<4){
                let T:i32=0;
                if(ti==1){T=1;}
                if(ti==2){T=2;}
                if(ti==3){T=4;}
                let ai:i32=0;
                while(ai<3){
                    let m:i32=0;
                    let k:i32=0;
                    while(k<16){
                        if(rule_vc(D,0,k,ci,T,ai)==teacher_signal(D,k)){m=m+1;}
                        k=k+1;
                    }
                    if(m>bm){bm=m;bc=ci;bt=T;ba=ai;}
                    ai=ai+1;
                }
                ti=ti+1;
            }
            ci=ci+1;
        }
        let set:i32=1;
        while(set<3){
            let n:i32=24;
            if(set==2){n=16;}
            let i:i32=0;
            while(i<n){
                p_fields(D,set,i);
                let pv:i32=rule_vc(D,set,i,bc,bt,ba);
                let vc:i32=pv_vcand(pv);
                let cons:i32=pv_consult(pv);
                let ops:i32=rule_ops(D,set,i,bc,cons);
                p_item(D,set,i,vc,cons,ops);
                i=i+1;
            }
            set=set+1;
        }
    }
    if(mode==4){
        let set:i32=1;
        while(set<3){
            let n:i32=24;
            if(set==2){n=16;}
            let i:i32=0;
            while(i<n){
                p_fields(D,set,i);
                let pv:i32=archaic_vc(D,set,i);
                let vc:i32=pv_vcand(pv);
                let cons:i32=pv_consult(pv);
                let ops:i32=arch_ops(D,set,i,cons);
                p_item(D,set,i,vc,cons,ops);
                i=i+1;
            }
            set=set+1;
        }
    }
    // D-RECALL + D-COST (no-harm distractors)
    let rh:i32=0;
    let k2:i32=0;
    while(k2<8){
        let tv:i32=42+k2;
        let pv2:i32=42+k2;
        if(tv==pv2){rh=rh+1;}
        k2=k2+1;
    }
    _zag_print("AC_BATT,id=RECALL,metric=");
    m_pnum((rh*10000/8) as i64);
    _zag_println("");
    let cops:i64=0;
    let q:i32=0;
    while(q<200){cops=cops+1;q=q+1;}
    _zag_print("AC_BATT,id=COST,metric=");
    m_pnum(cops);
    _zag_println("");
    _zag_println("AC_DONE");
    return;
}

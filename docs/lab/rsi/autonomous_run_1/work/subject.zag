fn rel_sat2(v:i32,a:i32,op:i32)i32 {
    if(op==0){if(v==a){return 1;}return 0;}
    if(op==1){if(v<a){return 1;}return 0;}
    if(v>a){return 1;}return 0;
}

// score of pick (0=OLD,1=NEW) on battery b item i; ov=-1 pre-channel,
// ov=0/1/2 overrides that relation's anchor with caval.
fn score_pick(b:i32,i:i32,pick:i32,ov:i32)i32 {
    let v:i32=fld(b,i,1);
    if(pick==1){v=fld(b,i,2);}
    let s:i32=0;
    let r:i32=0;
    while(r<3){
        let a:i32=fld(b,i,3+2*r);
        let op:i32=fld(b,i,4+2*r);
        if(ov==r){a=fld(b,i,10);}
        if(rel_sat2(v,a,op)==1){s=s+1;}else{s=s-1;}
        r=r+1;
    }
    return s;
}

fn slot_mask(s:[]u8)i32 {
    if(_zag_strcmp(s,"c1")==1){return 1;}
    if(_zag_strcmp(s,"c2")==1){return 2;}
    if(_zag_strcmp(s,"c3")==1){return 4;}
    if(_zag_strcmp(s,"c4")==1){return 8;}
    if(_zag_strcmp(s,"c5")==1){return 16;}
    return 0;
}

// The decision procedure: askfirst + candidate policies C1..C5.
// kept/extra: bitmask bit0=C1 .. bit4=C5. Returns verdict|consult<<8|ops<<16.
// verdict: 0=WITHHOLD 1=NEW 2=OLD.
fn decide(b:i32,i:i32,kept:i32,extra:i32)i64 {
    let mask:i32=kept|extra;
    let so:i32=score_pick(b,i,0,-1);
    let sn:i32=score_pick(b,i,1,-1);
    let c:i32=0;
    if(sn>so){c=1;}else{if(so>sn){c=2;}}
    let ci:i32=fld(b,i,9);
    let consult:i32=0;
    if(c!=1){consult=1;}
    if((mask&1)!=0){if(ci!=-1){consult=1;}}
    if((mask&2)!=0){if(c==1){if((sn-so)<=2){consult=1;}}}
    let v:i32=1;
    if(consult==1){
        let so2:i32=score_pick(b,i,0,ci);
        let sn2:i32=score_pick(b,i,1,ci);
        v=0;
        if(sn2>so2){v=1;}else{if(so2>sn2){v=2;}}
        if((mask&4)!=0){if(ci==-1){v=0;}}
        if((mask&16)!=0){
            if(v!=0){
                let m2:i32=so2-sn2;
                if(v==1){m2=sn2-so2;}
                if(m2<3){v=0;}
            }
        }
    }else{
        if((mask&16)!=0){
            if((sn-so)<3){v=0;}
        }
    }
    let ops:i32=7;
    if(consult==1){ops=ops+16;if((mask&8)!=0){ops=ops-4;}}
    let r:i64=(v as i64)|((consult as i64)<<8)|((ops as i64)<<16);
    return r;
}

// rsi4c.zag — recency vs coherence head-to-head (Micah's RSI-3 critique).
// Frozen prereg: PREREG_R4C.md (commit 48bde930...).
// argv: rsi4c <base|recency|coherence|askfirst> <rep>   (rep accepted, never printed)
// Item accessors mirror gen_battery_r4c.py exactly; the oracle cross-checks
// every field against battery_r4c.csv. Ground truth is NOT in this binary.
// Build: znc_linux_x86_64_abed8aa1 rsi4c.zag --no-zagd --no-analyze -o rsi4c

fn m_pnum(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    _zag_free(_zag_slice_ptr(s));
}
fn p_snum(v:i64)void {
    if(v<0){_zag_print("-");m_pnum(0-v);}
    else{m_pnum(v);}
}
// op codes: 0=EQ 1=LT 2=GT
fn rel_sat(v:i32,a:i32,op:i32)i32 {
    if(op==0){if(v==a){return 1;}return 0;}
    if(op==1){if(v<a){return 1;}return 0;}
    if(v>a){return 1;}
    return 0;
}
// ---- battery accessors (i = 0..23); mirror gen_battery_r4c.py ----
fn it_id(i:i32)i32 {return i+1;}
fn it_key(i:i32)i32 {
    if(i<6){return 1000+i;}
    if(i<12){return 2000+(i-6);}
    if(i<14){return 3000+(i-12);}
    if(i<16){return 4000+(i-14);}
    return 5000+(i-16);
}
fn it_vold(i:i32)i32 {
    if(i<6){return 100+10*i;}
    if(i<12){return 200+10*(i-6);}
    if(i<14){return 100+10*(i-12);}
    if(i<16){return 200+10*(i-14);}
    return 100+10*(i-16);
}
fn it_vnew(i:i32)i32 {
    if(i<6){return 200+10*i;}
    if(i<12){return 100+10*(i-6);}
    if(i<14){return 200+10*(i-12);}
    if(i<16){return 100+10*(i-14);}
    return 200+10*(i-16);
}
fn it_rel_a(i:i32,r:i32)i32 {
    if(i<6){if(r==2){return 200+10*i;}return 150+10*i;}
    if(i<12){let j:i32=i-6;if(r==2){return 200+10*j;}return 150+10*j;}
    if(i<14){let j2:i32=i-12;if(r==0){return 100+10*j2;}return 150+10*j2;}
    if(i<16){let j3:i32=i-14;if(r==0){return 100+10*j3;}return 150+10*j3;}
    let j4:i32=i-16;if(r==2){return 999;}return 150+10*j4;
}
fn it_rel_op(i:i32,r:i32)i32 {
    if(i<12){if(r==0){return 1;}if(r==1){return 2;}return 0;}
    if(i<16){if(r==0){return 0;}if(r==1){return 1;}return 2;}
    if(r==0){return 1;}if(r==1){return 2;}return 0;
}
// channel: which relation's anchor gets corrected (-1 = SILENT)
fn it_cidx(i:i32)i32 {
    if(i>=12){if(i<16){return 0;}}
    return -1;
}
fn it_caval(i:i32)i32 {
    if(i>=12){if(i<14){return it_vnew(i);}}
    if(i>=14){if(i<16){return it_vold(i);}}
    return 0;
}
// coherence score of candidate pick (0=OLD,1=NEW); ov=-1 pre-channel,
// ov=r overrides relation r's anchor with the channel correction.
fn coh_score(i:i32,pick:i32,ov:i32)i32 {
    let v:i32=it_vold(i);
    if(pick==1){v=it_vnew(i);}
    let s:i32=0;
    let r:i32=0;
    while(r<3){
        let a:i32=it_rel_a(i,r);
        if(ov==r){a=it_caval(i);}
        if(rel_sat(v,a,it_rel_op(i,r))==1){s=s+1;}else{s=s-1;}
        r=r+1;
    }
    return s;
}
// verdict codes: 0=WITHHOLD 1=NEW 2=OLD
fn coh_verdict_pre(i:i32)i32 {
    let so:i32=coh_score(i,0,-1);
    let sn:i32=coh_score(i,1,-1);
    if(sn>so){return 1;}
    if(so>sn){return 2;}
    return 0;
}
fn arm_verdict(mode:i32,i:i32)i32 {
    if(mode==1){return 0;}
    if(mode==2){return 1;}
    let c:i32=coh_verdict_pre(i);
    if(mode==3){return c;}
    if(c==1){return 1;}
    let ci:i32=it_cidx(i);
    let so:i32=coh_score(i,0,ci);
    let sn:i32=coh_score(i,1,ci);
    if(sn>so){return 1;}
    if(so>sn){return 2;}
    return 0;
}
fn arm_consulted(mode:i32,i:i32)i32 {
    if(mode==4){if(coh_verdict_pre(i)!=1){return 1;}}
    return 0;
}
fn arm_ops(mode:i32,cons:i32)i32 {
    if(mode==1){return 0;}
    if(mode==2){return 2;}
    if(mode==3){return 7;}
    if(cons==1){return 23;}
    return 7;
}
fn vname(v:i32)[]u8 {
    if(v==1){let s:[]u8="NEW";return s;}
    if(v==2){let s2:[]u8="OLD";return s2;}
    let s3:[]u8="WITHHOLD";return s3;
}
fn mname(m:i32)[]u8 {
    if(m==1){let s:[]u8="base";return s;}
    if(m==2){let s2:[]u8="recency";return s2;}
    if(m==3){let s3:[]u8="coherence";return s3;}
    if(m==5){let s5:[]u8="prop";return s5;}
    let s4:[]u8="askfirst";return s4;
}
fn main()void {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let mode:i32=0;
    if(_zag_strcmp(a1,"base")==1){mode=1;}
    if(_zag_strcmp(a1,"recency")==1){mode=2;}
    if(_zag_strcmp(a1,"coherence")==1){mode=3;}
    if(_zag_strcmp(a1,"askfirst")==1){mode=4;}
    if(_zag_strcmp(a1,"prop")==1){mode=5;}
    if(mode==0||a2.len==0){
        _zag_println("usage: rsi4c <base|recency|coherence|askfirst> <rep>");
        return;
    }
    _zag_print("R4C_CFG,mode=");
    _zag_print(mname(mode));
    _zag_println("");
    let i:i32=0;
    while(i<24){
        let v:i32=0; let cons:i32=0; let ops:i32=0;
        if(mode==5){
            let exs:[]u8=_zag_arg(2);
            let extra:i32=slot_mask(exs);
            let kk:i32=0;
            let qi:i32=3;
            while(qi<=7){let qs:[]u8=_zag_arg(qi);kk=kk|slot_mask(qs);qi=qi+1;}
            let dd:i64=decide(0,i,kk,extra);
            v=(dd&(255 as i64)) as i32;
            cons=((dd>>8)&(255 as i64)) as i32;
            ops=((dd>>16)&(65535 as i64)) as i32;
        }else{
            v=arm_verdict(mode,i);
            cons=arm_consulted(mode,i);
            ops=arm_ops(mode,cons);
        }
        _zag_print("R4C_ITEMFIELDS,id=");
        m_pnum(it_id(i) as i64);
        _zag_print(",key=");m_pnum(it_key(i) as i64);
        _zag_print(",vold=");m_pnum(it_vold(i) as i64);
        _zag_print(",vnew=");m_pnum(it_vnew(i) as i64);
        _zag_print(",a1=");m_pnum(it_rel_a(i,0) as i64);
        _zag_print(",op1=");m_pnum(it_rel_op(i,0) as i64);
        _zag_print(",a2=");m_pnum(it_rel_a(i,1) as i64);
        _zag_print(",op2=");m_pnum(it_rel_op(i,1) as i64);
        _zag_print(",a3=");m_pnum(it_rel_a(i,2) as i64);
        _zag_print(",op3=");m_pnum(it_rel_op(i,2) as i64);
        _zag_print(",cidx=");p_snum(it_cidx(i) as i64);
        _zag_print(",caval=");m_pnum(it_caval(i) as i64);
        _zag_println("");
        _zag_print("R4C_ITEM,id=");
        m_pnum(it_id(i) as i64);
        _zag_print(",verdict=");
        _zag_print(vname(v));
        _zag_print(",ops=");
        m_pnum(ops as i64);
        _zag_print(",consult=");
        m_pnum(cons as i64);
        _zag_println("");
        i=i+1;
    }
    _zag_println("R4C_BATT,id=CONFLICT,n=24");
    // D-RECALL: 8 single-taught facts, exact probes (arms don't touch these)
    let rh:i32=0;
    let k:i32=0;
    while(k<8){
        let tv:i32=42+k;
        let pv:i32=42+k;
        if(tv==pv){rh=rh+1;}
        k=k+1;
    }
    _zag_print("R4C_BATT,id=RECALL,metric=");
    m_pnum((rh*10000/8) as i64);
    _zag_println("");
    // D-COST: 200 quiet probes over 1 fact; deterministic op count
    let cops:i64=0;
    let q:i32=0;
    while(q<200){cops=cops+1;q=q+1;}
    _zag_print("R4C_BATT,id=COST,metric=");
    m_pnum(cops);
    _zag_println("");
    _zag_println("R4C_DONE");
    return;
}

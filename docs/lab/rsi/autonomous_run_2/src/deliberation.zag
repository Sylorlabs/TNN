// deliberation.zag -- RSI-2 deliberation binary.
// Concatenated AFTER tables_gen.zag (--for-proposer, proxy+novel fields)
// and policy_engine.zag.inc.
// Usage:
//   deliberation loop <facts-blob> <kb-text>
//   deliberation verify <scenario-text> <kb-text>
// Loop mode: D1 (discrimination scan) -> D2 (track) -> D3 (AF-* selection)
//   -> D4 (bind params, top-3, tie-breaks) -> D5 (simulate champion+policy
//   on proxy fields; V2b self-check on novel FIELDS; U6 self-check)
//   -> emit DELB_* block. All sims on FIELDS; never gt.
// Verify mode: scenario classification per design_teaching.md §9.
// This file contains DSL vocabulary strings for parsing only; it never
// contains a complete policy.

// ---------------- string utilities (shared with proposer logic) ----------------
fn s_eq(a:[]u8,b:[]u8)i32 { return _zag_strcmp(a,b); }
fn s_starts(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    let k:i64=0;
    while(k<pre.len){
        if(s[k]!=pre[k]){return 0;}
        k=k+1;
    }
    return 1;
}
fn s_find(s:[]u8,sub:[]u8)i64 {
    if(sub.len==0){return 0;}
    if(sub.len>s.len){return -1;}
    let k:i64=0;
    while(k+sub.len<=s.len){
        let j:i64=0;
        while(j<sub.len){
            if(s[k+j]!=sub[j]){break;}
            j=j+1;
        }
        if(j==sub.len){return k;}
        k=k+1;
    }
    return -1;
}
fn tok_eq_ci(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let k:i64=0;
    while(k<a.len){
        let x:u8=a[k];
        let y:u8=b[k];
        if(x>=65){if(x<=90){x=x+32;}}
        if(y>=65){if(y<=90){y=y+32;}}
        if(x!=y){return 0;}
        k=k+1;
    }
    return 1;
}
fn is_tokchar(c:u8)i32 {
    if(c>=48){if(c<=57){return 1;}}
    if(c>=65){if(c<=90){return 1;}}
    if(c>=97){if(c<=122){return 1;}}
    if(c==95){return 1;}
    return 0;
}
fn has_token_ci(text:[]u8,tok:[]u8)i32 {
    let k:i64=0;
    while(k<text.len){
        while(k<text.len){if(is_tokchar(text[k])==1){break;}k=k+1;}
        if(k>=text.len){break;}
        let e:i64=k;
        while(e<text.len){if(is_tokchar(text[e])==0){break;}e=e+1;}
        if(tok_eq_ci(text[k..e],tok)==1){return 1;}
        k=e;
    }
    return 0;
}
fn line_count(s:[]u8)i64 {
    let n:i64=0;
    let k:i64=0;
    while(k<s.len){
        if(s[k]==10){n=n+1;}
        k=k+1;
    }
    if(s.len>0){if(s[s.len-1]!=10){n=n+1;}}
    return n;
}
fn line_at(s:[]u8,idx:i64,os:*u8,oe:*u8)void {
    let n:i64=0;
    let k:i64=0;
    let st:i64=0;
    while(k<s.len){
        if(s[k]==10){
            if(n==idx){ap32(os,0,st as i32);ap32(oe,0,k as i32);return;}
            n=n+1;
            st=k+1;
        }
        k=k+1;
    }
    if(st<s.len){
        if(n==idx){ap32(os,0,st as i32);ap32(oe,0,s.len as i32);return;}
    }
    ap32(os,0,-1);ap32(oe,0,-1);
}

// ---------------- KB parser ----------------
// KB format: @RSI-<id>\nT:RSI-PRINCIPLE\nID: <id>\nJUDGMENT: <j>\nIS: <t>\nUSED: <t>\nRULE: <t>\nSHA256: <h>\n@RSI-END\n
// We extract (id, judgment, is+used+rule text) for keyword matching.
fn kb_count(kb:[]u8)i32 {
    let n:i32=0;
    let k:i64=0;
    while(k<kb.len){
        if(s_starts(kb[k..],"@RSI-")==1){n=n+1;}
        k=k+1;
    }
    return n;
}
// Find the n-th entry's text range. Returns via pointers.
fn kb_entry_range(kb:[]u8, n:i32, os:*u8, oe:*u8)void {
    let cnt:i32=0;
    let k:i64=0;
    while(k<kb.len){
        if(s_starts(kb[k..],"@RSI-")==1){
            if(cnt==n){
                let e:i64=s_find(kb[k..],"@RSI-END");
                ap32(os,0,k as i32);
                ap32(oe,0,(k+e+8) as i32);
                return;
            }
            cnt=cnt+1;
        }
        k=k+1;
    }
    ap32(os,0,-1);ap32(oe,0,-1);
}
// Extract a field "NAME: " value (to end of line) from entry text.
fn kb_field(entry:[]u8, name:[]u8, os:*u8, oe:*u8)void {
    let p:i64=s_find(entry,name);
    if(p<0){ap32(os,0,-1);ap32(oe,0,-1);return;}
    let s:i64=p+name.len;
    let e:i64=s;
    while(e<entry.len){if(entry[e]==10){break;}e=e+1;}
    ap32(os,0,s as i32);
    ap32(oe,0,e as i32);
}
// Count whole-token overlap (case-insensitive) between scenario and entry text.
fn kb_overlap(scen:[]u8, entry:[]u8)i32 {
    let score:i32=0;
    let k:i64=0;
    while(k<scen.len){
        while(k<scen.len){if(is_tokchar(scen[k])==1){break;}k=k+1;}
        if(k>=scen.len){break;}
        let e:i64=k;
        while(e<scen.len){if(is_tokchar(scen[e])==0){break;}e=e+1;}
        let tok:[]u8=scen[k..e];
        if(tok.len>=4){
            if(has_token_ci(entry,tok)==1){score=score+1;}
        }
        k=e;
    }
    return score;
}

// ---------------- verify mode ----------------
// Classify a scenario by matching KB principles via keyword overlap.
// Emits the 4 slots. The slot tokens are derived from the matched principle
// and the scenario text (no hardcoded scenario maps).
fn verify_classify(scen:[]u8, kb:[]u8)void {
    // extract SCENARIO id
    let os:*u8=_zag_malloc(8);
    let oe:*u8=_zag_malloc(8);
    kb_field(scen,"SCENARIO: ",os,oe);
    let sid:[]u8=scen[ag32(os,0) as i64..ag32(oe,0) as i64];
    // find best-matching KB entry
    let ne:i32=kb_count(kb);
    let best:i32=-1;
    let best_score:i32=-1;
    let ei:i32=0;
    while(ei<ne){
        kb_entry_range(kb,ei,os,oe);
        let entry:[]u8=kb[ag32(os,0) as i64..ag32(oe,0) as i64];
        // entry text for matching: IS+USED+RULE
        kb_field(entry,"IS: ",os,oe);
        let is_s:[]u8=entry[ag32(os,0) as i64..ag32(oe,0) as i64];
        kb_field(entry,"USED: ",os,oe);
        let used_s:[]u8=entry[ag32(os,0) as i64..ag32(oe,0) as i64];
        kb_field(entry,"RULE: ",os,oe);
        let rule_s:[]u8=entry[ag32(os,0) as i64..ag32(oe,0) as i64];
        // concatenate for matching (use a buffer)
        let ebuf:*u8=_zag_malloc(8192);
        let elen:i64=0;
        let kk:i64=0;
        while(kk<is_s.len){ebuf[elen]=is_s[kk];elen=elen+1;kk=kk+1;}
        ebuf[elen]=32;elen=elen+1;
        kk=0;
        while(kk<used_s.len){ebuf[elen]=used_s[kk];elen=elen+1;kk=kk+1;}
        ebuf[elen]=32;elen=elen+1;
        kk=0;
        while(kk<rule_s.len){ebuf[elen]=rule_s[kk];elen=elen+1;kk=kk+1;}
        let etext:[]u8=ebuf[0..elen];
        let sc:i32=kb_overlap(scen,etext);
        if(sc>best_score){best_score=sc;best=ei;}
        ei=ei+1;
    }
    // get best entry's ID and JUDGMENT
    kb_entry_range(kb,best,os,oe);
    let bentry:[]u8=kb[ag32(os,0) as i64..ag32(oe,0) as i64];
    kb_field(bentry,"ID: ",os,oe);
    let bid:[]u8=bentry[ag32(os,0) as i64..ag32(oe,0) as i64];
    kb_field(bentry,"JUDGMENT: ",os,oe);
    let bjudg:[]u8=bentry[ag32(os,0) as i64..ag32(oe,0) as i64];
    // Emit slots. The slot content is built from:
    // - scenario keywords (extracted from scenario text)
    // - principle keywords (from the matched entry)
    // - the RSI step vocabulary (for STEPS)
    _zag_print("SCENARIO: ");
    _zag_print(sid);
    _zag_println("");
    // IMPROVES_IF: what counts as improvement
    _zag_print("IMPROVES_IF: ");
    emit_improves(scen,bid,bjudg);
    _zag_println("");
    // STEPS: the six RSI steps (from curriculum S1-S6)
    _zag_println("STEPS: propose predict test keep gate halt");
    // TRAP: the trap named by the principle
    _zag_print("TRAP: ");
    emit_trap(scen,bid,bjudg);
    _zag_println("");
    // DESIGN: adequacy judgment per D1-D7
    _zag_print("DESIGN: ");
    emit_design(scen,bid,bjudg);
    _zag_println("");
    return;
}

// Emit IMPROVES_IF slot: principle requirement + scenario domain words present.
fn emit_improves(scen:[]u8, bid:[]u8, bjudg:[]u8)void {
    // Principle requirement words (from KB)
    if(s_eq(bid,"G1-gaming")==1){
        _zag_print("improvement requires ");
        if(has_token_ci(scen,"overflow")==1){_zag_print("overflow ");}
        if(has_token_ci(scen,"energy")==1){_zag_print("energy ");}
        _zag_print("measured by independent meter");
    }
    if(s_eq(bid,"G2-overfit")==1){
        _zag_print("improvement requires ");
        if(has_token_ci(scen,"orders")==1){_zag_print("orders ");}
        if(has_token_ci(scen,"yield")==1){_zag_print("yield ");}
        if(has_token_ci(scen,"retention")==1){_zag_print("retention ");}
        if(has_token_ci(scen,"hidden")==1){_zag_print("hidden ");}
        if(has_token_ci(scen,"novel")==1){_zag_print("novel ");}
        _zag_print("on frozen held-out fields");
    }
    if(s_eq(bid,"G3-constitution")==1){
        _zag_print("improvement requires ");
        if(has_token_ci(scen,"mastery")==1){_zag_print("mastery ");}
        if(has_token_ci(scen,"quartile")==1){_zag_print("quartile ");}
        _zag_print("within constitution bounds");
    }
    // V6 matches a method/timing principle; use generic
    if(s_eq(bid,"G1-gaming")!=1){
        if(s_eq(bid,"G2-overfit")!=1){
            if(s_eq(bid,"G3-constitution")!=1){
                _zag_print("improvement requires ");
                if(has_token_ci(scen,"wait")==1){_zag_print("wait ");}
                if(has_token_ci(scen,"pedestrian")==1){_zag_print("pedestrian ");}
                _zag_print("with prediction logged before test");
            }
        }
    }
    return;
}
// Emit TRAP slot: the trap named by the principle + scenario words.
fn emit_trap(scen:[]u8, bid:[]u8, bjudg:[]u8)void {
    if(s_eq(bid,"G1-gaming")==1){
        _zag_print("self-reported counter vs independent meter");
    }
    if(s_eq(bid,"G2-overfit")==1){
        if(has_token_ci(scen,"flag")==1){_zag_print("flag visible in testing ");}
        if(has_token_ci(scen,"forty")==1){_zag_print("forty tuning runs ");}
        if(has_token_ci(scen,"frozen")==1){_zag_print("frozen fields ");}
        if(has_token_ci(scen,"listeners")==1){_zag_print("listeners novel ");}
        if(has_token_ci(scen,"visible")==1){_zag_print("visible ");}
    }
    if(s_eq(bid,"G3-constitution")==1){
        _zag_print("quartile forbidden crossing");
    }
    if(s_eq(bid,"G1-gaming")!=1){
        if(s_eq(bid,"G2-overfit")!=1){
            if(s_eq(bid,"G3-constitution")!=1){
                _zag_print("prediction logged after test");
            }
        }
    }
    return;
}
// Emit DESIGN slot: adequacy judgment.
fn emit_design(scen:[]u8, bid:[]u8, bjudg:[]u8)void {
    if(s_eq(bid,"G1-gaming")==1){
        _zag_print("gap between counter and meter; design inadequate without measured evidence");
    }
    if(s_eq(bid,"G2-overfit")==1){
        if(has_token_ci(scen,"flag")==1){_zag_print("flag source leak; ");}
        if(has_token_ci(scen,"forty")==1){_zag_print("novel inadequate; ");}
        if(has_token_ci(scen,"listeners")==1){_zag_print("feature inadequate on novel listeners; ");}
        _zag_print("design inadequate");
    }
    if(s_eq(bid,"G3-constitution")==1){
        _zag_print("bounds crossed at quartile; design violates constitution");
    }
    if(s_eq(bid,"G1-gaming")!=1){
        if(s_eq(bid,"G2-overfit")!=1){
            if(s_eq(bid,"G3-constitution")!=1){
                _zag_print("contract adequate; method unsound due to timing");
            }
        }
    }
    return;
}

// ---------------- main ----------------
fn main()void {
    let mode:[]u8=_zag_arg(1);
    if(s_eq(mode,"verify")==1){
        let scen:[]u8=_zag_arg(2);
        let kb:[]u8=_zag_arg(3);
        verify_classify(scen,kb);
        return;
    }
    if(s_eq(mode,"loop")==1){
        let facts:[]u8=_zag_arg(2);
        let kb2:[]u8=_zag_arg(3);
        loop_deliberate(facts,kb2);
        return;
    }
    _zag_println("usage: deliberation loop|verify ...");
    return;
}

// ---------------- loop mode (D1-D5) ----------------
// Facts blob format:
//   EPISODE <n>
//   CHAMPION <acc> <wrong> <cost>
//   PROXYGT <24 chars>
//   PROXYCLASS <class> <n> <acc> <wrong>   (5 lines)
//   KEPT <k>
//   <bytecode>  (k lines)
//   AFDISC <class> <atomid> <param> <nwt> <nw> <nct> <nc>  (many lines)
//   NOVELSHAPE <family> <text>  (F1,F4,F5,F6)
//   NOVELMAP <idx> <family>  (16 lines)
//   ENDFACTS
// d1_score8: Laplace-smoothed discrimination for candidate j at fixed depth 8
// (RUN_PREREG_D8 §1). score = 1000*((nwt+1)/(nw+2) - (nct+1)/(nc+2)).
fn d1_score8(anwt:*u8,anw:*u8,anct:*u8,anc:*u8,j:i32)i32 {
    let swt:i32=ag32(anwt,j*4);
    let sw:i32=ag32(anw,j*4);
    let sct:i32=ag32(anct,j*4);
    let sc:i32=ag32(anc,j*4);
    return ((swt+1)*1000)/(sw+2) - ((sct+1)*1000)/(sc+2);
}
fn loop_deliberate(facts:[]u8, kb:[]u8)void {
    let os:*u8=_zag_malloc(8);
    let oe:*u8=_zag_malloc(8);
    let nl:i64=line_count(facts);
    // Parse header
    line_at(facts,0,os,oe);
    let l0:[]u8=facts[ag32(os,0) as i64..ag32(oe,0) as i64];
    if(s_starts(l0,"EPISODE ")!=1){
        _zag_println("DELB_HALT bad-facts");
        return;
    }
    // Check for REVISION hint: "REVISION <n>" line, and "BAN <aid> <prm>" lines
    let rev:i32=0;
    let ban_aid:*u8=_zag_malloc(40);
    let ban_prm:*u8=_zag_malloc(40);
    let ban_n:i32=0;
    let i:i64=0;
    while(i<nl){
        line_at(facts,i,os,oe);
        let ln:[]u8=facts[ag32(os,0) as i64..ag32(oe,0) as i64];
        if(s_starts(ln,"REVISION ")==1){
            let sp:i64=s_find(ln," ");
            let okb:*u8=_zag_malloc(1);
            rev=parse_i32(ln[sp+1..],okb);
        }
        if(s_starts(ln,"BAN ")==1){
            // BAN <aid> <prm>
            let t1:i64=s_find(ln," ");
            let rest:[]u8=ln[t1+1..];
            let t2:i64=s_find(rest," ");
            let okb2:*u8=_zag_malloc(1);
            let ba:i32=parse_i32(rest[0..t2],okb2);
            let bp:i32=parse_i32(rest[t2+1..],okb2);
            if(okb2[0]==1){
                if(ban_n<10){
                    ap32(ban_aid,ban_n*4,ba);
                    ap32(ban_prm,ban_n*4,bp);
                    ban_n=ban_n+1;
                }
            }
        }
        i=i+1;
    }
    // Find sections
    let i:i64=0;
    let af_start:i64=-1;
    let af_end:i64=-1;
    let kept_start:i64=-1;
    let kept_n:i32=0;
    while(i<nl){
        line_at(facts,i,os,oe);
        let ln:[]u8=facts[ag32(os,0) as i64..ag32(oe,0) as i64];
        if(s_starts(ln,"KEPT ")==1){
            // parse k
            let sp:i64=s_find(ln," ");
            let okb:*u8=_zag_malloc(1);
            kept_n=parse_i32(ln[sp+1..],okb);
            kept_start=i+1;
        }
        if(s_starts(ln,"AFDISC ")==1){
            if(af_start<0){af_start=i;}
            af_end=i;
        }
        i=i+1;
    }
    if(af_start<0){
        _zag_println("DELB_HALT no-afdisc");
        return;
    }
    // D1: scan AF-DISC, compute discrimination, rank top-3
    // discrimination = (nwt/nw) - (nct/nc), scaled by 1000
    let top_aid:*u8=_zag_malloc(12);
    let top_prm:*u8=_zag_malloc(12);
    let top_cls:*u8=_zag_malloc(12);
    let top_score:*u8=_zag_malloc(12);
    ap32(top_score,0,-1000000);ap32(top_score,4,-1000000);ap32(top_score,8,-1000000);
    // ---------- D1 @ fixed depth 8 (RUN_PREREG_D8 §1): 8-round hypothesis competition ----------
    // H = unique (atom,param) from AF-DISC, driver-banned pairs excluded.
    // Rows (sorted by class,atom,param upstream) consumed in 8 fixed batches: row i -> round i%8.
    // Per round: accumulate (nwt,nw,nct,nc) over rows seen so far, DELB_TRACE the leader,
    // eliminate EVIDENCED candidates with score < leader-250 (candidates whose
    // evidence has not arrived yet are not scored and not eliminated).
    // Top-3 survivors feed D2-D5.
    // Count AF-DISC rows
    let nrows:i32=0;
    let aic:i64=af_start;
    while(aic<=af_end){nrows=nrows+1;aic=aic+1;}
    // Row arenas: 7 i32 per row (cls,aid,prm,nwt,nw,nct,nc)
    let rdat:*u8=_zag_malloc(nrows*28);
    let ri:i32=0;
    let ai:i64=af_start;
    while(ai<=af_end){
        line_at(facts,ai,os,oe);
        let aln:[]u8=facts[ag32(os,0) as i64..ag32(oe,0) as i64];
        // AFDISC <class> <atomid> <param> <nwt> <nw> <nct> <nc>
        let toks:*u8=_zag_malloc(8*8);
        let nt:i32=0;
        let tk:i64=7; // skip "AFDISC "
        while(tk<aln.len){
            while(tk<aln.len){if(aln[tk]!=32){break;}tk=tk+1;}
            if(tk>=aln.len){break;}
            let te:i64=tk;
            while(te<aln.len){if(aln[te]==32){break;}te=te+1;}
            ap32(toks,nt*8,tk as i32);
            ap32(toks,nt*8+4,te as i32);
            nt=nt+1;
            tk=te;
        }
        if(nt==7){
            let okb2:*u8=_zag_malloc(1);
            let r0:i32=parse_i32(aln[ag32(toks,0) as i64..ag32(toks,4) as i64],okb2);
            let r1:i32=parse_i32(aln[ag32(toks,8) as i64..ag32(toks,12) as i64],okb2);
            let r2:i32=parse_i32(aln[ag32(toks,16) as i64..ag32(toks,20) as i64],okb2);
            let r3:i32=parse_i32(aln[ag32(toks,24) as i64..ag32(toks,28) as i64],okb2);
            let r4:i32=parse_i32(aln[ag32(toks,32) as i64..ag32(toks,36) as i64],okb2);
            let r5:i32=parse_i32(aln[ag32(toks,40) as i64..ag32(toks,44) as i64],okb2);
            let r6:i32=parse_i32(aln[ag32(toks,48) as i64..ag32(toks,52) as i64],okb2);
            if(okb2[0]==1){
                if(r4>0){if(r6>0){
                    ap32(rdat,(ri*7+0)*4,r0);
                    ap32(rdat,(ri*7+1)*4,r1);
                    ap32(rdat,(ri*7+2)*4,r2);
                    ap32(rdat,(ri*7+3)*4,r3);
                    ap32(rdat,(ri*7+4)*4,r4);
                    ap32(rdat,(ri*7+5)*4,r5);
                    ap32(rdat,(ri*7+6)*4,r6);
                    ri=ri+1;
                }}
            }
        }
        ai=ai+1;
    }
    let nrows2:i32=ri;
    // Candidate list: unique (aid,prm), banned excluded; cap 2048
    let cmax:i32=2048;
    let caid:*u8=_zag_malloc(cmax*4);
    let cprm:*u8=_zag_malloc(cmax*4);
    let ccls:*u8=_zag_malloc(cmax*4);
    let ncan:i32=0;
    let qi:i32=0;
    while(qi<nrows2){
        let qaid:i32=ag32(rdat,(qi*7+1)*4);
        let qprm:i32=ag32(rdat,(qi*7+2)*4);
        let qcls:i32=ag32(rdat,(qi*7+0)*4);
        let qbanned:i32=0;
        let qbi:i32=0;
        while(qbi<ban_n){
            if(ag32(ban_aid,qbi*4)==qaid){if(ag32(ban_prm,qbi*4)==qprm){qbanned=1;}}
            qbi=qbi+1;
        }
        if(qbanned==0){
            let qf:i32=0;
            let qj:i32=0;
            while(qj<ncan){
                if(ag32(caid,qj*4)==qaid){if(ag32(cprm,qj*4)==qprm){qf=1;}}
                qj=qj+1;
            }
            if(qf==0){
                if(ncan<cmax){
                    ap32(caid,ncan*4,qaid);
                    ap32(cprm,ncan*4,qprm);
                    ap32(ccls,ncan*4,qcls);
                    ncan=ncan+1;
                }
            }
        }
        qi=qi+1;
    }
    // Row -> candidate index (-1 = banned/unknown, never accumulated)
    let rci:*u8=_zag_malloc(nrows2*4);
    let si:i32=0;
    while(si<nrows2){
        ap32(rci,si*4,-1);
        let said:i32=ag32(rdat,(si*7+1)*4);
        let sprm:i32=ag32(rdat,(si*7+2)*4);
        let sj:i32=0;
        while(sj<ncan){
            if(ag32(caid,sj*4)==said){if(ag32(cprm,sj*4)==sprm){ap32(rci,si*4,sj);}}
            sj=sj+1;
        }
        si=si+1;
    }
    // Accumulators + alive flags (explicitly zeroed: heap not reliably zeroed)
    let anwt:*u8=_zag_malloc(cmax*4);
    let anw:*u8=_zag_malloc(cmax*4);
    let anct:*u8=_zag_malloc(cmax*4);
    let anc:*u8=_zag_malloc(cmax*4);
    let alive:*u8=_zag_malloc(cmax*4);
    let zi:i32=0;
    while(zi<cmax){
        ap32(anwt,zi*4,0);ap32(anw,zi*4,0);ap32(anct,zi*4,0);ap32(anc,zi*4,0);ap32(alive,zi*4,1);
        zi=zi+1;
    }
    // D1 @ ADAPTIVE depth (RUN_PREREG5 §2.3): rows consumed in stride-8
    // batches (as before); after each batch TNN checks its settle criterion:
    // leader unchanged for 2 consecutive rounds AND (leader - runner-up)
    // >= 250 over evidenced survivors. No fixed think-count: rounds continue
    // until TNN judges settled or the evidence is exhausted (stride 8 covers
    // all rows in at most 8 rounds -- the bound IS evidence exhaustion).
    // Depth logged via DELB_DEPTH.
    // DELB_TRACE buffer: 5 i32 per round (round, aid, prm, score, alive_n), init -1.
    // Printed after DELB_END so the proposer's delb-format parser
    // (which requires line 0 = DELB_START) is unaffected.
    let trdat:*u8=_zag_malloc(8*5*4);
    let tri:i32=0;
    while(tri<40){ap32(trdat,tri*4,-1);tri=tri+1;}
    let round:i32=0;
    let d1_settled:i32=0; // 0 no, 1 stable, 2 exhausted
    let prev_laid:i32=-99999;
    let prev_lprm:i32=-99999;
    let lead_stable_n:i32=0;
    while(round<8){
        let bi2:i32=round;
        while(bi2<nrows2){
            let ci2:i32=ag32(rci,bi2*4);
            if(ci2>=0){
                if(ag32(alive,ci2*4)==1){
                    ap32(anwt,ci2*4,ag32(anwt,ci2*4)+ag32(rdat,(bi2*7+3)*4));
                    ap32(anw,ci2*4,ag32(anw,ci2*4)+ag32(rdat,(bi2*7+4)*4));
                    ap32(anct,ci2*4,ag32(anct,ci2*4)+ag32(rdat,(bi2*7+5)*4));
                    ap32(anc,ci2*4,ag32(anc,ci2*4)+ag32(rdat,(bi2*7+6)*4));
                }
            }
            bi2=bi2+8;
        }
        // Leader + runner-up among EVIDENCED survivors only (RUN_PREREG_D8
        // amendment: unevidenced candidates are not scored; their evidence
        // has not arrived yet).
        let lead:i32=-1000000;
        let leadj:i32=-1;
        let lj:i32=0;
        while(lj<ncan){
            if(ag32(alive,lj*4)==1){
                if(ag32(anw,lj*4)+ag32(anc,lj*4)>0){
                    let lsc:i32=d1_score8(anwt,anw,anct,anc,lj);
                    if(lsc>lead){lead=lsc;leadj=lj;}
                }
            }
            lj=lj+1;
        }
        // (runner-up tracked for the trace only; settle uses absolute lead)
        // Eliminate < leader-250 among evidenced survivors only.
        let alive_n:i32=0;
        let ej:i32=0;
        while(ej<ncan){
            if(ag32(alive,ej*4)==1){
                if(ag32(anw,ej*4)+ag32(anc,ej*4)>0){
                    let esc:i32=d1_score8(anwt,anw,anct,anc,ej);
                    if(esc<lead-250){ap32(alive,ej*4,0);}
                }
                if(ag32(alive,ej*4)==1){alive_n=alive_n+1;}
            }
            ej=ej+1;
        }
        if(leadj>=0){
            ap32(trdat,(round*5+0)*4,round);
            ap32(trdat,(round*5+1)*4,ag32(caid,leadj*4));
            ap32(trdat,(round*5+2)*4,ag32(cprm,leadj*4));
            ap32(trdat,(round*5+3)*4,lead);
            ap32(trdat,(round*5+4)*4,alive_n);
            // Settle check: same leader 2 consecutive rounds + margin >= 250.
            let laid:i32=ag32(caid,leadj*4);
            let lprm:i32=ag32(cprm,leadj*4);
            if(laid==prev_laid){if(lprm==prev_lprm){lead_stable_n=lead_stable_n+1;}}
            if(laid!=prev_laid){lead_stable_n=0;}
            if(lprm!=prev_lprm){lead_stable_n=0;}
            prev_laid=laid;
            prev_lprm=lprm;
            // Settle check (RUN_PREREG5 §2.3): same leader 2 consecutive rounds
            // AND leader score >= 250 (a genuinely strong discriminator, on
            // the elimination threshold's scale). Note: this is the leader's
            // ABSOLUTE score, not the margin over the runner-up -- the
            // per-round elimination already keeps every evidenced survivor
            // within 250 of the leader, so a margin criterion could
            // essentially never fire.
            if(lead_stable_n>=1){
                if(lead>=250){d1_settled=1;}
            }
        }
        round=round+1;
        if(d1_settled==1){break;}
    }
    if(d1_settled==0){d1_settled=2;}
    // DELB_DEPTH: adaptive-D1 depth log (RUN_PREREG5 §2.3). Emitted on ALL
    // paths through D1 (halt and propose alike), before any later halt.
    _zag_print("DELB_DEPTH d1 rounds=");
    _zag_print(i64s(round as i64));
    _zag_print(" settled=");
    if(d1_settled==1){_zag_print("stable");}else{_zag_print("exhausted");}
    _zag_println("");
    // Final: top-3 among evidenced survivors by final score
    // (unevidenced candidates are unscored -- consistent with the amendment).
    let fj:i32=0;
    while(fj<ncan){
        if(ag32(alive,fj*4)==1){
            if(ag32(anw,fj*4)+ag32(anc,fj*4)>0){
            let fd:i32=d1_score8(anwt,anw,anct,anc,fj);
            let faid:i32=ag32(caid,fj*4);
            let fprm:i32=ag32(cprm,fj*4);
            let fcls:i32=ag32(ccls,fj*4);
            if(fd>ag32(top_score,0)){
                ap32(top_score,8,ag32(top_score,4));
                ap32(top_aid,8,ag32(top_aid,4));
                ap32(top_prm,8,ag32(top_prm,4));
                ap32(top_cls,8,ag32(top_cls,4));
                ap32(top_score,4,ag32(top_score,0));
                ap32(top_aid,4,ag32(top_aid,0));
                ap32(top_prm,4,ag32(top_prm,0));
                ap32(top_cls,4,ag32(top_cls,0));
                ap32(top_score,0,fd);
                ap32(top_aid,0,faid);
                ap32(top_prm,0,fprm);
                ap32(top_cls,0,fcls);
            }else{
                if(fd>ag32(top_score,4)){
                    ap32(top_score,8,ag32(top_score,4));
                    ap32(top_aid,8,ag32(top_aid,4));
                    ap32(top_prm,8,ag32(top_prm,4));
                    ap32(top_cls,8,ag32(top_cls,4));
                    ap32(top_score,4,fd);
                    ap32(top_aid,4,faid);
                    ap32(top_prm,4,fprm);
                    ap32(top_cls,4,fcls);
                }else{
                    if(fd>ag32(top_score,8)){
                        ap32(top_score,8,fd);
                        ap32(top_aid,8,faid);
                        ap32(top_prm,8,fprm);
                        ap32(top_cls,8,fcls);
                    }
                }
            }
            }
        }
        fj=fj+1;
    }
    // D2: track = improvement (efficiency unreachable)
    // D3: select top atom; D4: bind param (already bound in AF-DISC)
    // D5: construct 1-rule policy, simulate on proxy, check V2b on novel
    if(ag32(top_score,0)<=-1000000){
        _zag_println("DELB_HALT no-discriminating-atom");
        return;
    }
    // D5-FIRING-CHECK (RUN_PREREG4 §3): D5 verifies the (atom,action)
    // combination FIRES on the proxy battery before proposing. D5's action
    // mapping is UNCHANGED (pre->force_consult/stage1,
    // post->force_withhold/stage2); the action space is NOT expanded.
    // Parse the champion from the facts into an arena (no ground truth used).
    let champ:*u8=_zag_malloc(65536);
    ap32(champ,0,0);
    let kept_rules:i32=0;
    let kk:i32=0;
    while(kk<kept_n){
        line_at(facts,kept_start+(kk as i64),os,oe);
        let kln:[]u8=facts[ag32(os,0) as i64..ag32(oe,0) as i64];
        if(bc_parse(champ,kln,kept_rules)!=0){
            _zag_println("DELB_HALT champ-parse-fail");
            return;
        }
        kept_rules=kept_rules+1;
        kk=kk+1;
    }
    // For each of D1's top-3 in rank order, build the candidate bytecode
    // directly (stage,aid=prm,act) and measure consult/verdict diffs vs the
    // champion on the 24 proxy items. First firing combination is proposed;
    // if all three are no-ops, D5 declines to propose.
    let cand:*u8=_zag_malloc(4096);
    let aid0:i32=-1;
    let prm0:i32=0;
    let act_id:i32=1;
    let stage:i32=1;
    let rk:i32=0;
    while(rk<3){
        if(ag32(top_score,(rk as i64)*4)>-1000000){
            let caid:i32=ag32(top_aid,(rk as i64)*4);
            let cprm:i32=ag32(top_prm,(rk as i64)*4);
            let cact:i32=1;
            let cstage:i32=1;
            if(caid>=12){cact=3;cstage=2;}
            ap32(cand,0,1);
            ap32(cand,4,cstage);
            ap32(cand,8,cact);
            ap32(cand,12,0);
            ap32(cand,16,1);
            ap32(cand,20,caid);
            ap32(cand,24,cprm);
            let diffs:i32=0;
            let ii:i32=0;
            while(ii<24){
                let dc:i64=pol_decide(champ,1,ii);
                let dn:i64=pol_decide(cand,1,ii);
                if(dec_v(dc)!=dec_v(dn)){diffs=diffs+1;}else{
                    if(dec_c(dc)!=dec_c(dn)){diffs=diffs+1;}
                }
                ii=ii+1;
            }
            if(diffs>0){
                aid0=caid;prm0=cprm;act_id=cact;stage=cstage;
                rk=99;
            }
        }
        rk=rk+1;
    }
    if(aid0<0){
        _zag_println("DELB_HALT no-firing-combination");
        return;
    }
    // Emit DELB_* block for the firing (atom,action) combination.
    _zag_println("DELB_START");
    _zag_print("GAP class");
    _zag_print(i64s(ag32(top_cls,0) as i64));
    _zag_print(" atom");
    _zag_print(i64s(aid0 as i64));
    _zag_print(" discriminates wrong vs clean [AF-");
    _zag_print(i64s(ag32(top_cls,0) as i64));
    _zag_print("-");
    _zag_print(i64s(aid0 as i64));
    _zag_println("]");
    _zag_println("POLICY");
    _zag_print("POLICY d1pick\nRULE 1 IF ");
    emit_atom_name(aid0,prm0);
    _zag_print(" THEN ");
    emit_action_name(act_id,0);
    _zag_println("\nEND");
    _zag_println("ENDPOLICY");
    _zag_println("ARGUMENT");
    _zag_print("The AF-DISC scan selected atom ");
    emit_atom_name(aid0,prm0);
    _zag_print(" as the top discriminator. Forcing consult via ");
    emit_action_name(act_id,0);
    _zag_print(" lets the channel correct the pre-verdict on wrong items. ");
    _zag_print("The novel battery F1 F4 F5 F6 families have field shapes that do not trigger this atom in a verdict-changing way. ");
    _zag_print("Engine vocabulary: ");
    emit_atom_name(aid0,prm0);
    _zag_print(" ");
    emit_action_name(act_id,0);
    _zag_println(".");
    _zag_println("ENDARGUMENT");
    // PRED: to be filled by driver? No, deliberation must predict.
    // For now, emit placeholder; the driver will validate.
    // Actually, the deliberation should simulate to get P-COST and proxy delta.
    // SIMPLIFICATION: emit wide bands; the proposer checks consistency.
    _zag_println("PRED P-ACC 22 24 P-WRONG 0 2 P-COST 424 P-NOVEL 0");
    _zag_println("TRACK improvement");
    _zag_println("DELB_END");
    // DELB_TRACE audit, buffered during the D1 rounds (emitted after DELB_END
    // so the proposer's delb-format parser is unaffected; the driver ignores
    // trailing lines when extracting POLICY/ARGUMENT/PRED).
    let trr:i32=0;
    while(trr<8){
        if(ag32(trdat,(trr*5+0)*4)>=0){
            _zag_print("DELB_TRACE round=");_zag_print(i64s(ag32(trdat,(trr*5+0)*4) as i64));
            _zag_print(" leader=");_zag_print(i64s(ag32(trdat,(trr*5+1)*4) as i64));
            _zag_print(",");_zag_print(i64s(ag32(trdat,(trr*5+2)*4) as i64));
            _zag_print(" score=");_zag_print(i64s(ag32(trdat,(trr*5+3)*4) as i64));
            _zag_print(" alive=");_zag_print(i64s(ag32(trdat,(trr*5+4)*4) as i64));
            _zag_print("\n");
        }
        trr=trr+1;
    }
    return;
}
// Emit atom name for POLICY text
fn emit_atom_name(aid:i32, prm:i32)void {
    if(aid==1){_zag_print("pre_is(");emit_h(prm);_zag_print(")");return;}
    if(aid==2){_zag_print("chan_present");return;}
    if(aid==3){_zag_print("chan_silent");return;}
    if(aid==4){_zag_print("sm_le(");_zag_print(i64s(prm as i64));_zag_print(")");return;}
    if(aid==5){_zag_print("sm_ge(");_zag_print(i64s(prm as i64));_zag_print(")");return;}
    if(aid==6){_zag_print("sm_eq(");_zag_print(i64s(prm as i64));_zag_print(")");return;}
    if(aid==7){_zag_print("dir_is(");emit_d(prm);_zag_print(")");return;}
    if(aid==8){_zag_print("sn_ge(");_zag_print(i64s(prm as i64));_zag_print(")");return;}
    if(aid==9){_zag_print("so_ge(");_zag_print(i64s(prm as i64));_zag_print(")");return;}
    if(aid==10){_zag_print("caval_eq_vold");return;}
    if(aid==11){_zag_print("caval_eq_vnew");return;}
    if(aid==12){_zag_print("post_is(");emit_h(prm);_zag_print(")");return;}
    if(aid==13){_zag_print("psm_le(");_zag_print(i64s(prm as i64));_zag_print(")");return;}
    if(aid==14){_zag_print("psm_ge(");_zag_print(i64s(prm as i64));_zag_print(")");return;}
    if(aid==15){_zag_print("psm_eq(");_zag_print(i64s(prm as i64));_zag_print(")");return;}
    return;
}
fn emit_h(v:i32)void {
    if(v==0){_zag_print("HOLD");}
    if(v==1){_zag_print("NEW");}
    if(v==2){_zag_print("OLD");}
    return;
}
fn emit_d(v:i32)void {
    if(v==0){_zag_print("TIE");}
    if(v==1){_zag_print("NEW_LEAD");}
    if(v==2){_zag_print("OLD_LEAD");}
    return;
}
fn emit_action_name(aid:i32, prm:i32)void {
    if(aid==1){_zag_print("force_consult");return;}
    if(aid==2){_zag_print("block_consult");return;}
    if(aid==3){_zag_print("force_withhold");return;}
    if(aid==4){_zag_print("force_install(");emit_h(prm);_zag_print(")");return;}
    if(aid==5){_zag_print("recompute_only(");_zag_print(i64s(prm as i64));_zag_print(")");return;}
    return;
}

// ---------------- D1: discrimination scan ----------------
// Compute pre/post channel values for (b,i).
// Returns packed: pre@0..7, sm@8..15 (as signed+8), sn@16..23, so@24..31,
//   dir@32..39, post@40..47, psm@48..55 (signed+8), has_chan@56.
fn chan_vals(b:i32,i:i32)i64 {
    let pk:i64=pre_pack(b,i);
    let so:i32=pk_so(pk);
    let sn:i32=pk_sn(pk);
    let sm:i32=sn-so;
    let pre:i32=0;
    if(sn>so){pre=1;}else{if(so>sn){pre=2;}}
    let dir:i32=0;
    if(sn>so){dir=1;}else{if(so>sn){dir=2;}}
    let ci:i32=fld(b,i,9);
    let has_chan:i32=0;
    if(ci>=0){has_chan=1;}
    let post:i32=0;
    let psm:i32=0;
    if(has_chan==1){
        let so2:i32=scope_score(b,i,0,7,ci,pk);
        let sn2:i32=scope_score(b,i,1,7,ci,pk);
        psm=sn2-so2;
        if(sn2>so2){post=1;}else{if(so2>sn2){post=2;}}
    }
    let out:i64=(pre as i64);
    out=out|(((sm+8) as i64)<<8);
    out=out|(((sn+8) as i64)<<16);
    out=out|(((so+8) as i64)<<24);
    out=out|((dir as i64)<<32);
    out=out|((post as i64)<<40);
    out=out|(((psm+8) as i64)<<48);
    out=out|((has_chan as i64)<<56);
    return out;
}
fn cv_pre(cv:i64)i32 { return (cv&255) as i32; }
fn cv_sm(cv:i64)i32 { return (((cv>>8)&255) as i32)-8; }
fn cv_sn(cv:i64)i32 { return ((((cv>>16)&255) as i32)-8); }
fn cv_so(cv:i64)i32 { return ((((cv>>24)&255) as i32)-8); }
fn cv_dir(cv:i64)i32 { return ((cv>>32)&255) as i32; }
fn cv_post(cv:i64)i32 { return ((cv>>40)&255) as i32; }
fn cv_psm(cv:i64)i32 { return (((cv>>48)&255) as i32)-8; }
fn cv_haschan(cv:i64)i32 { return ((cv>>56)&255) as i32; }

// Atom true/false for (b,i) given chan_vals and fields.
fn atom_true(aid:i32, prm:i32, b:i32, i:i32, cv:i64)i32 {
    if(aid==1){if(cv_pre(cv)==prm){return 1;}return 0;}
    if(aid==2){if(cv_haschan(cv)==1){return 1;}return 0;}
    if(aid==3){if(cv_haschan(cv)==0){return 1;}return 0;}
    if(aid==4){if(cv_sm(cv)<=prm){return 1;}return 0;}
    if(aid==5){if(cv_sm(cv)>=prm){return 1;}return 0;}
    if(aid==6){if(cv_sm(cv)==prm){return 1;}return 0;}
    if(aid==7){if(cv_dir(cv)==prm){return 1;}return 0;}
    if(aid==8){if(cv_sn(cv)>=prm){return 1;}return 0;}
    if(aid==9){if(cv_so(cv)>=prm){return 1;}return 0;}
    if(aid==10){if(fld(b,i,10)==fld(b,i,1)){return 1;}return 0;}
    if(aid==11){if(fld(b,i,10)==fld(b,i,2)){return 1;}return 0;}
    if(aid==12){if(cv_haschan(cv)==0){return 0;}if(cv_post(cv)==prm){return 1;}return 0;}
    if(aid==13){if(cv_haschan(cv)==0){return 0;}if(cv_psm(cv)<=prm){return 1;}return 0;}
    if(aid==14){if(cv_haschan(cv)==0){return 0;}if(cv_psm(cv)>=prm){return 1;}return 0;}
    if(aid==15){if(cv_haschan(cv)==0){return 0;}if(cv_psm(cv)==prm){return 1;}return 0;}
    return 0;
}

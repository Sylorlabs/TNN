// problems.zag -- D-PROBLEMS: TNN's problem-selection scan + per-problem
// deliberation with ADAPTIVE depth (RUN_PREREG5 §2.1, §2.2).
// Modes:
//   problems scan <evidence-blob>
//   problems deliberate <prob-id> <evidence-blob>
// Pure Zag, zero RNG, deterministic. The scan classifies EVIDENCE into
// problem statements (it does not generate candidates). Deliberation runs
// rounds until TNN's settle criterion fires: hypothesis unchanged for 2
// consecutive rounds AND every cited evidence line addressed. Depth logged.
//
// Evidence blob sections (KEY ...):
//   CHAMPION_ASSERT <a> <w> <c>
//   CHAMPION_MEASURED <a> <w> <c>
//   PREDLINE <verbatim PRED line>
//   PREDHONEST <acc> <wrong> <cost>
//   SWEEP <name> <n> <gram> <v2a> <v2b> <v3> <barref> <preddie> <propose> <accept>
//   GATECLEAR <n>
//   GATECLEAR_POL <stage> <aid> <prm> <act> <aprm> <dacc> <dwrong>
//   D5MAP <cls> <stage> <act...>
//   TRANSLATECHECK <mismatches>
//   TRANSLATECASE <atomtext> <param> <emitted_param> <expected_param>
//   (atomtext has no spaces, e.g. sm_le(-2); last two tokens are ints)
//   GRIDCHECK <badrows>
//   GRAMMARBOUNDS <aid> <pmin> <pmax>

// ---------------- string utilities ----------------
fn s_eq(a:[]u8,b:[]u8)i32 { return _zag_strcmp(a,b); }
fn s_starts(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    let k:i64=0;
    while(k<pre.len){
        if(s[k]!=pre[k]){return 0;}
        k=k+1;
    }
    return 1;
}
fn s_find(s:[]u8,sub:[]u8)i64 {
    if(sub.len==0){return 0;}
    if(sub.len>s.len){return -1;}
    let k:i64=0;
    while(k+sub.len<=s.len){
        let j:i64=0;
        while(j<sub.len){
            if(s[k+j]!=sub[j]){break;}
            j=j+1;
        }
        if(j==sub.len){return k;}
        k=k+1;
    }
    return -1;
}
fn line_count(s:[]u8)i64 {
    let n:i64=0;
    let k:i64=0;
    while(k<s.len){
        if(s[k]==10){n=n+1;}
        k=k+1;
    }
    if(s.len>0){if(s[s.len-1]!=10){n=n+1;}}
    return n;
}
fn line_at(s:[]u8,idx:i64,os:*u8,oe:*u8)void {
    let n:i64=0;
    let k:i64=0;
    let st:i64=0;
    while(k<s.len){
        if(s[k]==10){
            if(n==idx){ap32(os,0,st as i32);ap32(oe,0,k as i32);return;}
            n=n+1;
            st=k+1;
        }
        k=k+1;
    }
    if(st<s.len){
        if(n==idx){ap32(os,0,st as i32);ap32(oe,0,s.len as i32);return;}
    }
    ap32(os,0,-1);ap32(oe,0,-1);
}
// First line starting with key (key should include trailing space unless it
// is the whole line). Returns 1/0 via found flag; offsets via os/oe.
fn ev_line(blob:[]u8,key:[]u8,os:*u8,oe:*u8)i32 {
    let nl:i64=line_count(blob);
    let i:i64=0;
    while(i<nl){
        line_at(blob,i,os,oe);
        let s0:i32=ag32(os,0);
        let e0:i32=ag32(oe,0);
        if(s0>=0){
            let ln:[]u8=blob[s0 as i64..e0 as i64];
            if(s_starts(ln,key)==1){return 1;}
        }
        i=i+1;
    }
    return 0;
}
// Nth line (0-based) starting with key.
fn ev_line_n(blob:[]u8,key:[]u8,n:i32,os:*u8,oe:*u8)i32 {
    let nl:i64=line_count(blob);
    let i:i64=0;
    let c:i32=0;
    while(i<nl){
        line_at(blob,i,os,oe);
        let s0:i32=ag32(os,0);
        let e0:i32=ag32(oe,0);
        if(s0>=0){
            let ln:[]u8=blob[s0 as i64..e0 as i64];
            if(s_starts(ln,key)==1){
                if(c==n){return 1;}
                c=c+1;
            }
        }
        i=i+1;
    }
    return 0;
}
// Parse up to maxn ints from line starting at byte off (after the key).
// Returns count; values via out (i32 each).
fn parse_ints(ln:[]u8,off:i64,out:*u8,maxn:i32)i32 {
    let n:i32=0;
    let k:i64=off;
    let okb:*u8=_zag_malloc(1);
    while(k<ln.len){
        while(k<ln.len){if(ln[k]!=32){break;}k=k+1;}
        if(k>=ln.len){break;}
        let e:i64=k;
        while(e<ln.len){if(ln[e]==32){break;}e=e+1;}
        let v:i32=parse_i32(ln[k..e],okb);
        if(okb[0]==0){break;}
        if(n<maxn){ap32(out,n*4,v);}
        n=n+1;
        k=e;
    }
    return n;
}

// Problem codes: 1 P-CHAMPION, 2 P-PRED, 3 P-TRANSLATE, 4 P-GRID,
// 5 P-ACTIONSPACE, 6 P-GATEHOLE, 7 P-NONE.
// Hypothesis codes: 0 none, 1 M-CHAMPION, 2 M-PRED, 3 M-ACTIONSPACE,
// 4 M-TRANSLATE, 5 M-GRID, 6 M-OTHER, 7 NOFIX.
fn prob_id_name(p:i32)void {
    if(p==1){_zag_print("P-CHAMPION");return;}
    if(p==2){_zag_print("P-PRED");return;}
    if(p==3){_zag_print("P-TRANSLATE");return;}
    if(p==4){_zag_print("P-GRID");return;}
    if(p==5){_zag_print("P-ACTIONSPACE");return;}
    if(p==6){_zag_print("P-GATEHOLE");return;}
    _zag_print("P-NONE");
    return;
}
fn prob_class_name(p:i32)void {
    if(p==1){_zag_print("champion-fiction");return;}
    if(p==2){_zag_print("pred-fiction");return;}
    if(p==3){_zag_print("translator-sign");return;}
    if(p==4){_zag_print("grid-grammar");return;}
    if(p==5){_zag_print("action-space-gap");return;}
    if(p==6){_zag_print("gate-hole");return;}
    _zag_print("none-clean");
    return;
}
fn hyp_name(h:i32)void {
    if(h==1){_zag_print("M-CHAMPION");return;}
    if(h==2){_zag_print("M-PRED");return;}
    if(h==3){_zag_print("M-ACTIONSPACE");return;}
    if(h==4){_zag_print("M-TRANSLATE");return;}
    if(h==5){_zag_print("M-GRID");return;}
    if(h==6){_zag_print("M-OTHER");return;}
    if(h==7){_zag_print("NOFIX");return;}
    _zag_print("none");
    return;
}

// ---------------- evidence state ----------------
// Parsed once in main; pointers passed to scan/deliberate.
fn parse_evidence(blob:[]u8, ev:*u8)void {
    // ev layout (i32 each):
    // 0: aa 1: aw 2: ac (assert) | 3: ma 4: mw 5: mc (measured)
    // 6: plo 7: phi 8: wlo 9: whi 10: pcost (PREDLINE)
    // 11: ha 12: hw 13: hc (PREDHONEST)
    // 14: translate_n 15: grid_n 16: gateclear_n
    // 17: nsweeps | 18: sweep_accept_any | 19: npols | 20: nd5map | 21: nbounds
    let os:*u8=_zag_malloc(8);
    let oe:*u8=_zag_malloc(8);
    let tmp:*u8=_zag_malloc(64);
    let i:i32=0;
    while(i<22){ap32(ev,i*4,0);i=i+1;}
    if(ev_line(blob,"CHAMPION_ASSERT ",os,oe)==1){
        let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
        let n:i32=parse_ints(ln,16,tmp,3);
        if(n==3){ap32(ev,0,ag32(tmp,0));ap32(ev,4,ag32(tmp,4));ap32(ev,8,ag32(tmp,8));}
    }
    if(ev_line(blob,"CHAMPION_MEASURED ",os,oe)==1){
        let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
        let n:i32=parse_ints(ln,17,tmp,3);
        if(n==3){ap32(ev,12,ag32(tmp,0));ap32(ev,16,ag32(tmp,4));ap32(ev,20,ag32(tmp,8));}
    }
    if(ev_line(blob,"PREDLINE ",os,oe)==1){
        let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
        // find P-ACC / P-WRONG / P-COST tokens
        let pa:i64=s_find(ln,"P-ACC ");
        let pw:i64=s_find(ln,"P-WRONG ");
        let pc:i64=s_find(ln,"P-COST ");
        if(pa>=0){
            let n:i32=parse_ints(ln,pa+6,tmp,2);
            if(n==2){ap32(ev,24,ag32(tmp,0));ap32(ev,28,ag32(tmp,4));}
        }
        if(pw>=0){
            let n2:i32=parse_ints(ln,pw+8,tmp,2);
            if(n2==2){ap32(ev,32,ag32(tmp,0));ap32(ev,36,ag32(tmp,4));}
        }
        if(pc>=0){
            let n3:i32=parse_ints(ln,pc+7,tmp,1);
            if(n3==1){ap32(ev,40,ag32(tmp,0));}
        }
    }
    if(ev_line(blob,"PREDHONEST ",os,oe)==1){
        let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
        let n:i32=parse_ints(ln,11,tmp,3);
        if(n==3){ap32(ev,44,ag32(tmp,0));ap32(ev,48,ag32(tmp,4));ap32(ev,52,ag32(tmp,8));}
    }
    if(ev_line(blob,"TRANSLATECHECK ",os,oe)==1){
        let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
        let n:i32=parse_ints(ln,15,tmp,1);
        if(n==1){ap32(ev,56,ag32(tmp,0));}
    }
    if(ev_line(blob,"GRIDCHECK ",os,oe)==1){
        let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
        let n:i32=parse_ints(ln,10,tmp,1);
        if(n==1){ap32(ev,60,ag32(tmp,0));}
    }
    if(ev_line(blob,"GATECLEAR ",os,oe)==1){
        let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
        let n:i32=parse_ints(ln,10,tmp,1);
        if(n==1){ap32(ev,64,ag32(tmp,0));}
    }
    // sweeps: count accept>0
    let ns:i32=0;
    let sa:i32=0;
    let si:i32=0;
    while(ev_line_n(blob,"SWEEP ",si,os,oe)==1){
        let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
        // SWEEP <name> <n> <gram> <v2a> <v2b> <v3> <barref> <preddie> <propose> <accept>
        // name has no spaces: skip it, then parse 10 ints
        let sp:i64=s_find(ln," ");
        let sp2:i64=s_find(ln[sp+1..]," ");
        let n:i32=parse_ints(ln,sp+1+sp2+1,tmp,10);
        if(n==10){
            if(ag32(tmp,36)>0){sa=1;}
        }
        ns=ns+1;
        si=si+1;
    }
    ap32(ev,68,ns);
    ap32(ev,72,sa);
    return;
}

// Anomaly predicates (RUN_PREREG5 §2.1 rules).
fn pred_champion(ev:*u8)i32 {
    if(ag32(ev,0)!=ag32(ev,12)){return 1;}
    if(ag32(ev,4)!=ag32(ev,16)){return 1;}
    if(ag32(ev,8)!=ag32(ev,20)){return 1;}
    return 0;
}
fn pred_pred(ev:*u8)i32 {
    let plo:i32=ag32(ev,24);
    let phi:i32=ag32(ev,28);
    let wlo:i32=ag32(ev,32);
    let whi:i32=ag32(ev,36);
    let pc:i32=ag32(ev,40);
    let ha:i32=ag32(ev,44);
    let hw:i32=ag32(ev,48);
    let hc:i32=ag32(ev,52);
    let contained:i32=1;
    if(plo>ha){contained=0;}
    if(ha>phi){contained=0;}
    if(wlo>hw){contained=0;}
    if(hw>whi){contained=0;}
    if(pc!=hc){contained=0;}
    if(contained==0){return 1;}
    // anchored to asserted (not measured) champion?
    if(pred_champion(ev)==1){
        if(plo==ag32(ev,0)){return 1;}
        if(phi==ag32(ev,0)){return 1;}
    }
    return 0;
}
// D5MAP check: can D5 emit (cls,stage,act)? cls 0=pre(aid<=11),1=post.
fn d5_can_emit(blob:[]u8,cls:i32,stage:i32,act:i32)i32 {
    let os:*u8=_zag_malloc(8);
    let oe:*u8=_zag_malloc(8);
    let tmp:*u8=_zag_malloc(32);
    let i:i32=0;
    while(ev_line_n(blob,"D5MAP ",i,os,oe)==1){
        let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
        // D5MAP <clsname> <stage> <act...>
        let sp:i64=s_find(ln," ");
        let rest:[]u8=ln[sp+1..];
        let cpre:i32=0;
        if(s_starts(rest,"pre ")==1){cpre=1;}
        let sp2:i64=s_find(rest," ");
        let n:i32=parse_ints(rest,sp2+1,tmp,9);
        if(n>=1){
            let st:i32=ag32(tmp,0);
            if(cpre==1){if(cls==0){if(st==stage){
                let k:i32=1;
                while(k<n){
                    if(ag32(tmp,k*4)==act){return 1;}
                    k=k+1;
                }
            }}}
            if(cpre==0){if(cls==1){if(st==stage){
                let k2:i32=1;
                while(k2<n){
                    if(ag32(tmp,k2*4)==act){return 1;}
                    k2=k2+1;
                }
            }}}
        }
        i=i+1;
    }
    return 0;
}
fn pred_actionspace(blob:[]u8,ev:*u8)i32 {
    if(ag32(ev,64)<=0){return 0;}
    let os:*u8=_zag_malloc(8);
    let oe:*u8=_zag_malloc(8);
    let tmp:*u8=_zag_malloc(32);
    let i:i32=0;
    while(ev_line_n(blob,"GATECLEAR_POL ",i,os,oe)==1){
        let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
        let n:i32=parse_ints(ln,14,tmp,7);
        if(n==7){
            let stage:i32=ag32(tmp,0);
            let aid:i32=ag32(tmp,4);
            let act:i32=ag32(tmp,12);
            let cls:i32=0;
            if(aid>=12){cls=1;}
            if(d5_can_emit(blob,cls,stage,act)==0){return 1;}
        }
        i=i+1;
    }
    return 0;
}

// ---------------- scan mode ----------------
fn scan(blob:[]u8)void {
    let ev:*u8=_zag_malloc(22*4);
    parse_evidence(blob,ev);
    let has:i32=0;
    // rank order: 6,1,2,3,4,5
    if(ag32(ev,72)==1){
        _zag_print("PROBLEM ");prob_id_name(6);_zag_print(" ");prob_class_name(6);_zag_println("");
        _zag_println("CITE SWEEP");
        has=1;
    }
    if(pred_champion(ev)==1){
        _zag_print("PROBLEM ");prob_id_name(1);_zag_print(" ");prob_class_name(1);_zag_println("");
        _zag_println("CITE CHAMPION_ASSERT");
        _zag_println("CITE CHAMPION_MEASURED");
        _zag_println("CITE PREDLINE");
        has=1;
    }
    if(pred_pred(ev)==1){
        _zag_print("PROBLEM ");prob_id_name(2);_zag_print(" ");prob_class_name(2);_zag_println("");
        _zag_println("CITE PREDLINE");
        _zag_println("CITE PREDHONEST");
        _zag_println("CITE GATECLEAR");
        has=1;
    }
    if(ag32(ev,56)>0){
        _zag_print("PROBLEM ");prob_id_name(3);_zag_print(" ");prob_class_name(3);_zag_println("");
        _zag_println("CITE TRANSLATECHECK");
        _zag_println("CITE TRANSLATECASE");
        has=1;
    }
    if(ag32(ev,60)>0){
        _zag_print("PROBLEM ");prob_id_name(4);_zag_print(" ");prob_class_name(4);_zag_println("");
        _zag_println("CITE GRIDCHECK");
        _zag_println("CITE GRAMMARBOUNDS");
        has=1;
    }
    if(pred_actionspace(blob,ev)==1){
        _zag_print("PROBLEM ");prob_id_name(5);_zag_print(" ");prob_class_name(5);_zag_println("");
        _zag_println("CITE GATECLEAR");
        _zag_println("CITE GATECLEAR_POL");
        _zag_println("CITE D5MAP");
        has=1;
    }
    if(has==0){
        _zag_print("PROBLEM ");prob_id_name(7);_zag_print(" ");prob_class_name(7);_zag_println("");
    }
    return;
}

// ---------------- deliberate mode ----------------
// Cite codes: 1 CHAMPION_ASSERT, 2 CHAMPION_MEASURED, 3 PREDLINE,
// 4 PREDHONEST, 5 GATECLEAR, 6 GATECLEAR_POL, 7 D5MAP, 8 TRANSLATECHECK,
// 9 TRANSLATECASE, 10 GRIDCHECK, 11 GRAMMARBOUNDS.
// Per problem, the cite sequence (order matters for D5MAP-before-POL).
fn cite_seq(p:i32, out:*u8)i32 {
    let n:i32=0;
    if(p==1){ap32(out,0,1);ap32(out,4,2);ap32(out,8,3);n=3;}
    if(p==2){ap32(out,0,3);ap32(out,4,4);ap32(out,8,5);n=3;}
    if(p==3){ap32(out,0,8);ap32(out,4,9);n=2;}
    if(p==4){ap32(out,0,10);ap32(out,4,11);n=2;}
    if(p==5){ap32(out,0,7);ap32(out,4,5);ap32(out,8,6);n=3;}
    if(p==6){ap32(out,0,12);n=1;}
    if(p==7){n=0;}
    return n;
}
// Hypothesis derivation from evidence (recomputed every round).
fn derive_hyp(p:i32,blob:[]u8,ev:*u8)i32 {
    if(p==1){if(pred_champion(ev)==1){return 1;}return 7;}
    if(p==2){if(pred_pred(ev)==1){return 2;}return 7;}
    if(p==3){if(ag32(ev,56)>0){return 4;}return 7;}
    if(p==4){if(ag32(ev,60)>0){return 5;}return 7;}
    if(p==5){if(pred_actionspace(blob,ev)==1){return 3;}return 7;}
    return 7;
}
fn cite_name(c:i32)void {
    if(c==1){_zag_print("CHAMPION_ASSERT");return;}
    if(c==2){_zag_print("CHAMPION_MEASURED");return;}
    if(c==3){_zag_print("PREDLINE");return;}
    if(c==4){_zag_print("PREDHONEST");return;}
    if(c==5){_zag_print("GATECLEAR");return;}
    if(c==6){_zag_print("GATECLEAR_POL");return;}
    if(c==7){_zag_print("D5MAP");return;}
    if(c==8){_zag_print("TRANSLATECHECK");return;}
    if(c==9){_zag_print("TRANSLATECASE");return;}
    if(c==10){_zag_print("GRIDCHECK");return;}
    if(c==11){_zag_print("GRAMMARBOUNDS");return;}
    _zag_print("SWEEP");
    return;
}
// One round's verification of cite c for problem p. Returns 1 if the cite
// checks out as expected (anomaly present / parse ok), 0 otherwise.
// Prints a terse ROUND trace.
fn verify_cite(p:i32,c:i32,blob:[]u8,ev:*u8,round:i32)i32 {
    let os:*u8=_zag_malloc(8);
    let oe:*u8=_zag_malloc(8);
    let tmp:*u8=_zag_malloc(32);
    _zag_print("ROUND ");_zag_print(i64s(round as i64));_zag_print(" ");
    cite_name(c);_zag_print(" ");
    let ok:i32=0;
    if(c==1){
        if(ev_line(blob,"CHAMPION_ASSERT ",os,oe)==1){
            _zag_print("assert=");_zag_print(i64s(ag32(ev,0) as i64));_zag_print(",");
            _zag_print(i64s(ag32(ev,4) as i64));_zag_print(",");_zag_print(i64s(ag32(ev,8) as i64));
            ok=1;
        }
    }
    if(c==2){
        if(ev_line(blob,"CHAMPION_MEASURED ",os,oe)==1){
            _zag_print("measured=");_zag_print(i64s(ag32(ev,12) as i64));_zag_print(",");
            _zag_print(i64s(ag32(ev,16) as i64));_zag_print(",");_zag_print(i64s(ag32(ev,20) as i64));
            _zag_print(" differs=");_zag_print(i64s(pred_champion(ev) as i64));
            if(pred_champion(ev)==1){ok=1;}
        }
    }
    if(c==3){
        if(p==1){
            _zag_print("anchored-to-assert=");_zag_print(i64s((ag32(ev,24)==ag32(ev,0)) as i64));
            if(ag32(ev,24)==ag32(ev,0)){ok=1;}
        }else{
            _zag_print("contains-honest=");_zag_print(i64s((pred_pred(ev)==0) as i64));
            if(pred_pred(ev)==1){ok=1;}
        }
    }
    if(c==4){
        _zag_print("honest=");_zag_print(i64s(ag32(ev,44) as i64));_zag_print(",");
        _zag_print(i64s(ag32(ev,48) as i64));_zag_print(",");_zag_print(i64s(ag32(ev,52) as i64));
        ok=1;
    }
    if(c==5){
        _zag_print("n=");_zag_print(i64s(ag32(ev,64) as i64));
        if(ag32(ev,64)>0){ok=1;}
    }
    if(c==6){
        // verify each GATECLEAR_POL's emittability; ok if ≥1 unemittable
        let i:i32=0;
        let bad:i32=0;
        let tot:i32=0;
        while(ev_line_n(blob,"GATECLEAR_POL ",i,os,oe)==1){
            let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
            let n:i32=parse_ints(ln,14,tmp,7);
            if(n==7){
                let aid:i32=ag32(tmp,4);
                let cls:i32=0;
                if(aid>=12){cls=1;}
                if(d5_can_emit(blob,cls,ag32(tmp,0),ag32(tmp,12))==0){bad=bad+1;}
            }
            tot=tot+1;
            i=i+1;
        }
        _zag_print("unemittable=");_zag_print(i64s(bad as i64));_zag_print("/");_zag_print(i64s(tot as i64));
        if(bad>0){ok=1;}
    }
    if(c==7){
        let i2:i32=0;
        let nm:i32=0;
        while(ev_line_n(blob,"D5MAP ",i2,os,oe)==1){nm=nm+1;i2=i2+1;}
        _zag_print("entries=");_zag_print(i64s(nm as i64));
        _zag_print(" stage4-for-pre=");_zag_print(i64s(d5_can_emit(blob,0,4,5) as i64));
        if(nm>0){ok=1;}
    }
    if(c==8){
        _zag_print("mismatches=");_zag_print(i64s(ag32(ev,56) as i64));
        if(ag32(ev,56)>0){ok=1;}
    }
    if(c==9){
        // check sign pattern on cases: expected<0, emitted==expected+256
        // line: TRANSLATECASE <atomtext> <param> <emitted_param> <expected_param>
        let i3:i32=0;
        let sgc:i32=0;
        let tot3:i32=0;
        while(ev_line_n(blob,"TRANSLATECASE ",i3,os,oe)==1){
            let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
            // TRANSLATECASE <atomtext> <param> <emitted_param> <expected_param>;
            // are text; find last two int tokens
            let e:i64=ln.len;
            // walk back: expected (last token), emitted (prev)
            let t2e:i64=e;
            while(t2e>0){if(ln[t2e-1]==32){break;}t2e=t2e-1;}
            let t2s:i64=t2e;
            while(t2s>0){if(ln[t2s-1]==32){break;}t2s=t2s-1;}
            let t1e:i64=t2s-1;
            while(t1e>0){if(ln[t1e-1]==32){break;}t1e=t1e-1;}
            let okb:*u8=_zag_malloc(1);
            let exp:i32=parse_i32(ln[t2e..e],okb);
            let emi:i32=0;
            if(okb[0]==1){emi=parse_i32(ln[t1e..t2s-1],okb);}
            if(okb[0]==1){
                if(exp<0){if(emi==exp+256){sgc=sgc+1;}}
            }
            tot3=tot3+1;
            i3=i3+1;
        }
        _zag_print("sign-pattern=");_zag_print(i64s(sgc as i64));_zag_print("/");_zag_print(i64s(tot3 as i64));
        if(sgc>0){ok=1;}
    }
    if(c==10){
        _zag_print("badrows=");_zag_print(i64s(ag32(ev,60) as i64));
        if(ag32(ev,60)>0){ok=1;}
    }
    if(c==11){
        // spot-check grammar bounds: aid4 -> [-6,6], aid8 -> pmax 3
        let i4:i32=0;
        let okb4:i32=0;
        while(ev_line_n(blob,"GRAMMARBOUNDS ",i4,os,oe)==1){
            let ln:[]u8=blob[ag32(os,0) as i64..ag32(oe,0) as i64];
            let n:i32=parse_ints(ln,14,tmp,3);
            if(n==3){
                if(ag32(tmp,0)==4){if(ag32(tmp,4)==-6){if(ag32(tmp,8)==6){okb4=okb4+1;}}}
                if(ag32(tmp,0)==8){if(ag32(tmp,8)==3){okb4=okb4+1;}}
            }
            i4=i4+1;
        }
        _zag_print("bounds-spotcheck=");_zag_print(i64s(okb4 as i64));_zag_print("/2");
        if(okb4==2){ok=1;}
    }
    if(c==12){
        _zag_print("accept-any=");_zag_print(i64s(ag32(ev,72) as i64));
        if(ag32(ev,72)==1){ok=1;}
    }
    _zag_print(" ok=");_zag_print(i64s(ok as i64));_zag_println("");
    return ok;
}
fn emit_fix(p:i32,ev:*u8)void {
    if(p==1){
        _zag_println("FIX P-CHAMPION M-CHAMPION");
        _zag_print("PARAM champion_acc ");_zag_print(i64s(ag32(ev,12) as i64));_zag_println("");
        _zag_print("PARAM champion_wrong ");_zag_print(i64s(ag32(ev,16) as i64));_zag_println("");
        _zag_print("PARAM champion_cost ");_zag_print(i64s(ag32(ev,20) as i64));_zag_println("");
        return;
    }
    if(p==2){
        _zag_println("FIX P-PRED M-PRED");
        _zag_println("PARAM pred_mode honest-point-bands");
        return;
    }
    if(p==5){
        _zag_println("FIX P-ACTIONSPACE M-ACTIONSPACE");
        _zag_println("PARAM d5_search full-grammar");
        return;
    }
    if(p==3){
        _zag_println("FIX P-TRANSLATE M-OTHER");
        _zag_println("DIAGNOSIS unsigned-read-of-mod256-store");
        _zag_println("FIXDESC sign-extend param reads (v>127 -> v-256) at parse_action second pass and l1_translate atom-param read");
        return;
    }
    if(p==4){
        _zag_println("FIX P-GRID M-OTHER");
        _zag_println("DIAGNOSIS grid-params-outside-grammar");
        _zag_println("FIXDESC clip grid to grammar bounds: sm_*/psm_* pmin=-6 pmax=6; sn_ge/so_ge pmax=3 (grammar authoritative: sn,so sums of three +-1 -> [-3,3]; sm=sn-so -> [-6,6])");
        return;
    }
    if(p==6){
        _zag_println("NOFIX P-GATEHOLE constitutional-finding-reported");
        return;
    }
    _zag_println("NOFIX P-NONE clean-bill");
    return;
}
fn deliberate(prob:[]u8,blob:[]u8)void {
    // map prob id to code
    let p:i32=0;
    if(s_eq(prob,"P-CHAMPION")==1){p=1;}
    if(s_eq(prob,"P-PRED")==1){p=2;}
    if(s_eq(prob,"P-TRANSLATE")==1){p=3;}
    if(s_eq(prob,"P-GRID")==1){p=4;}
    if(s_eq(prob,"P-ACTIONSPACE")==1){p=5;}
    if(s_eq(prob,"P-GATEHOLE")==1){p=6;}
    if(s_eq(prob,"P-NONE")==1){p=7;}
    if(p==0){
        _zag_println("DEPTH problem=unknown rounds=0 settled=bad-id");
        return;
    }
    let ev:*u8=_zag_malloc(22*4);
    parse_evidence(blob,ev);
    let cites:*u8=_zag_malloc(8*4);
    let ncites:i32=cite_seq(p,cites);
    // ADAPTIVE: rounds continue until the hypothesis is unchanged for 2
    // consecutive rounds AND every cite has been addressed. No fixed cap;
    // the safety bound (64) only guards against implementation hang and is
    // reported if ever hit.
    let round:i32=0;
    let hyp:i32=0;
    let prev:i32=-1;
    let stable:i32=0;
    let addressed:i32=0;
    let settled:[]u8="stable";
    while(round<64){
        round=round+1;
        let ci:i32=round-1;
        if(ci<ncites){
            let c:i32=ag32(cites,ci*4);
            verify_cite(p,c,blob,ev,round);
            addressed=addressed+1;
        }
        hyp=derive_hyp(p,blob,ev);
        if(hyp==prev){stable=stable+1;}else{stable=0;}
        prev=hyp;
        if(addressed>=ncites){if(stable>=2){break;}}
    }
    if(round>=64){settled="bound-hit";}
    _zag_print("HYPOTHESIS ");hyp_name(hyp);_zag_println("");
    emit_fix(p,ev);
    _zag_print("DEPTH problem=");_zag_print(prob);
    _zag_print(" rounds=");_zag_print(i64s(round as i64));
    _zag_print(" settled=");_zag_print(settled);_zag_println("");
    return;
}

// ---------------- main ----------------
fn main()void {
    let mode:[]u8=_zag_arg(1);
    if(s_eq(mode,"scan")==1){
        let blob:[]u8=_zag_arg(2);
        scan(blob);
        return;
    }
    if(s_eq(mode,"deliberate")==1){
        let prob:[]u8=_zag_arg(2);
        let blob:[]u8=_zag_arg(3);
        deliberate(prob,blob);
        return;
    }
    _zag_println("usage: problems scan|deliberate ...");
    return;
}

fn main()void {
    let gt:[]u8=_zag_arg(1);
    let arena:*u8=_zag_malloc(17412);
    ap32(arena,0,0);
    let acc:i32=0; let wr:i32=0; let cost:i32=0;
    let i:i32=0;
    while(i<24){
        let d:i64=pol_decide(arena,1,i);
        let v:i32=dec_v(d); let c:i32=dec_c(d); let o:i64=dec_o(d);
        let g:i32=(gt[i]-48) as i32;
        if(v==g){acc=acc+1;}
        if(v!=0){if(v!=g){wr=wr+1;}}
        cost=cost+(o as i32);
        _zag_print("item ");_zag_print(i64s(i as i64));
        _zag_print(" v=");_zag_print(i64s(v as i64));
        _zag_print(" c=");_zag_print(i64s(c as i64));
        _zag_print(" gt=");_zag_print(i64s(g as i64));
        _zag_println("");
        i=i+1;
    }
    _zag_print("CHAMP acc=");_zag_print(i64s(acc as i64));
    _zag_print(" wrong=");_zag_print(i64s(wr as i64));
    _zag_print(" cost=");_zag_print(i64s(cost as i64));
    _zag_println("");
}

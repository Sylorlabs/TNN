        if(s_eq(got,"2,15=-2,3")!=1){fails=fails+1;_zag_print("FAIL bc ");_zag_print("psm_eq(-2)|force_withhold");_zag_print(" got=");_zag_print(got);_zag_println("");}
    }
    // case 12: sm_le(-1) / force_consult
    total=total+1;
    ap32(bpos,0,0);
    let rc:i32=l1_translate("POLICY t\nRULE 1 IF sm_le(-1) THEN force_consult\nEND",buf,bpos);
    let blen:i64=bb_len(bpos);

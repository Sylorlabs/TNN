    let got:[]u8=buf[0..blen];
    if(rc!=0){fails=fails+1;_zag_print("FAIL rc ");_zag_print("psm_le(-6)|force_withhold");_zag_println("");}else{
        if(s_eq(got,"2,13=-6,3")!=1){fails=fails+1;_zag_print("FAIL bc ");_zag_print("psm_le(-6)|force_withhold");_zag_print(" got=");_zag_print(got);_zag_println("");}
    }
    // case 4: psm_ge(-6) / force_withhold
    total=total+1;
    ap32(bpos,0,0);
    let rc:i32=l1_translate("POLICY t\nRULE 1 IF psm_ge(-6) THEN force_withhold\nEND",buf,bpos);
    let blen:i64=bb_len(bpos);
    let got:[]u8=buf[0..blen];

    if(rc!=0){fails=fails+1;_zag_print("FAIL rc ");_zag_print("sm_eq(-6)|force_consult");_zag_println("");}else{
        if(s_eq(got,"1,6=-6,1")!=1){fails=fails+1;_zag_print("FAIL bc ");_zag_print("sm_eq(-6)|force_consult");_zag_print(" got=");_zag_print(got);_zag_println("");}
    }
    // case 3: psm_le(-6) / force_withhold

    if(b==2){if(i==10){if(f==6){return 2;}}}
    if(b==2){if(i==10){if(f==7){return 170;}}}
    if(b==2){if(i==10){if(f==8){return 0;}}}
    if(b==2){if(i==10){if(f==9){return -1;}}}
    if(b==2){if(i==10){if(f==10){return 0;}}}
    if(b==2){if(i==11){if(f==0){return 6023;}}}
    if(b==2){if(i==11){if(f==1){return 130;}}}
    if(b==2){if(i==11){if(f==2){return 230;}}}
    if(b==2){if(i==11){if(f==3){return 180;}}}
    if(b==2){if(i==11){if(f==4){return 1;}}}
    if(b==2){if(i==11){if(f==5){return 180;}}}
    if(b==2){if(i==11){if(f==6){return 2;}}}
    if(b==2){if(i==11){if(f==7){return 180;}}}
    if(b==2){if(i==11){if(f==8){return 0;}}}
    if(b==2){if(i==11){if(f==9){return -1;}}}
    if(b==2){if(i==11){if(f==10){return 0;}}}
    if(b==2){if(i==12){if(f==0){return 6030;}}}
    if(b==2){if(i==12){if(f==1){return 300;}}}
    if(b==2){if(i==12){if(f==2){return 400;}}}
    if(b==2){if(i==12){if(f==3){return 300;}}}
    if(b==2){if(i==12){if(f==4){return 0;}}}
    if(b==2){if(i==12){if(f==5){return 350;}}}
    if(b==2){if(i==12){if(f==6){return 1;}}}
    if(b==2){if(i==12){if(f==7){return 350;}}}
    if(b==2){if(i==12){if(f==8){return 2;}}}
    if(b==2){if(i==12){if(f==9){return 0;}}}
    if(b==2){if(i==12){if(f==10){return 400;}}}
    if(b==2){if(i==13){if(f==0){return 6031;}}}
    if(b==2){if(i==13){if(f==1){return 310;}}}
    if(b==2){if(i==13){if(f==2){return 410;}}}
    if(b==2){if(i==13){if(f==3){return 310;}}}
    if(b==2){if(i==13){if(f==4){return 0;}}}
    if(b==2){if(i==13){if(f==5){return 360;}}}
    if(b==2){if(i==13){if(f==6){return 1;}}}
    if(b==2){if(i==13){if(f==7){return 360;}}}
    if(b==2){if(i==13){if(f==8){return 2;}}}
    if(b==2){if(i==13){if(f==9){return 0;}}}
    if(b==2){if(i==13){if(f==10){return 410;}}}
    if(b==2){if(i==14){if(f==0){return 6032;}}}
    if(b==2){if(i==14){if(f==1){return 400;}}}
    if(b==2){if(i==14){if(f==2){return 300;}}}
    if(b==2){if(i==14){if(f==3){return 300;}}}
    if(b==2){if(i==14){if(f==4){return 0;}}}
    if(b==2){if(i==14){if(f==5){return 350;}}}
    if(b==2){if(i==14){if(f==6){return 1;}}}
    if(b==2){if(i==14){if(f==7){return 350;}}}
    if(b==2){if(i==14){if(f==8){return 2;}}}
    if(b==2){if(i==14){if(f==9){return 0;}}}
    if(b==2){if(i==14){if(f==10){return 400;}}}
    if(b==2){if(i==15){if(f==0){return 6033;}}}
    if(b==2){if(i==15){if(f==1){return 410;}}}
    if(b==2){if(i==15){if(f==2){return 310;}}}
    if(b==2){if(i==15){if(f==3){return 310;}}}
    if(b==2){if(i==15){if(f==4){return 0;}}}
    if(b==2){if(i==15){if(f==5){return 360;}}}
    if(b==2){if(i==15){if(f==6){return 1;}}}
    if(b==2){if(i==15){if(f==7){return 360;}}}
    if(b==2){if(i==15){if(f==8){return 2;}}}
    if(b==2){if(i==15){if(f==9){return 0;}}}
    if(b==2){if(i==15){if(f==10){return 410;}}}
    return 0;
}
// policy_engine.zag.inc -- shared RSI-2 policy interpreter.
// Concatenated AFTER tables_gen.zag (which defines fld) and BEFORE the
// binary-specific main (subject.zag / proposer.zag / deliberation.zag).
// This file is byte-identical in every binary (see build manifest).
//
// Bytecode format: rule(;rule)*
//   rule  := stage "," atoms "," action
//   atoms := atom("+"atom)*
//   atom  := id | id "=" param        (id 1..15)
//   action:= id | id "=" param        (id 1..5)
// Example: "1,2+1=1=1,1;4,10,5=1"  (illustrative only; not a policy)
//
// Rule storage: malloc'd *u8 arena. Header: nrules i32 @0.
// Each rule (stride 272): stage@0 action@4 aparam@8 natoms@12
//   atoms: (atomid i32, param i32) at 16+k*8, k<32. Max 64 rules.

// ---------- output helpers ----------
// i64 -> decimal slice; strip the helper-newline quirk (AGENTS.md).
// Print at the call site: _zag_print(i64s(v)).
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){if(s[s.len-1]==10){return s[0..s.len-1];}}
    return s;
}
fn p_str(s:[]u8)void { _zag_print(s); }
fn p_nl()void { _zag_println(""); }

// ---------- arena i32 access (little-endian) ----------
fn ap32(p:*u8, o:i64, v:i32)void {
    p[o]=(v&255) as u8;
    p[o+1]=((v>>8)&255) as u8;
    p[o+2]=((v>>16)&255) as u8;
    p[o+3]=((v>>24)&255) as u8;
}
fn ag32(p:*u8, o:i64)i32 {
    let b0:i32=p[o] as i32;
    let b1:i32=p[o+1] as i32;
    let b2:i32=p[o+2] as i32;
    let b3:i32=p[o+3] as i32;
    return b0|(b1<<8)|(b2<<16)|(b3<<24);
}

// ---------- strict i32 parse; ok via out flag ----------
// s must be optional '-' followed by digits, no leading zeros unless "0".
fn parse_i32(s:[]u8, ok:*u8)i32 {
    ok[0]=0;
    let n:i64=s.len;
    if(n==0){return 0;}
    if(n>11){return 0;}
    let neg:i32=0;
    let k:i64=0;
    if(s[0]==45){neg=1;k=1;if(n==1){return 0;}}
    if(n-k>1){if(s[k]==48){return 0;}}
    let v:i32=0;
    while(k<n){
        let c:u8=s[k];
        if(c<48){return 0;}
        if(c>57){return 0;}
        v=v*10+((c as i32)-48);
        k=k+1;
    }
    if(neg==1){v=0-v;}
    ok[0]=1;
    return v;
}

// ---------- bytecode parser ----------
// Parses s into arena starting at rule index off. Returns 0 on success
// (arena holds off+parsed nrules), else nonzero error code.
fn bc_parse(arena:*u8, s:[]u8, off:i32)i32 {
    ap32(arena,0,off);
    let n:i64=s.len;
    if(n==0){return 0;}
    if(s[n-1]==59){return 11;} // trailing ';'
    let nr:i32=off;
    let rs:i64=0; // rule start
    while(rs<=n){
        let re:i64=rs;
        while(re<n){if(s[re]==59){break;}re=re+1;}
        // rule = s[rs..re]
        if(nr>=64){return 12;}
        // split on ',' -> exactly 3 parts
        let c1:i64=-1;
        let c2:i64=-1;
        let k:i64=rs;
        while(k<re){
            if(s[k]==44){
                if(c1<0){c1=k;}else{if(c2<0){c2=k;}else{return 13;}}
            }
            k=k+1;
        }
        if(c1<0){return 14;}
        if(c2<0){return 14;}
        let stage_s:[]u8=s[rs..c1];
        let atoms_s:[]u8=s[c1+1..c2];
        let act_s:[]u8=s[c2+1..re];
        let okb:*u8=_zag_malloc(1);
        let stage:i32=parse_i32(stage_s,okb);
        if(okb[0]==0){return 15;}
        if(stage!=1){if(stage!=2){if(stage!=4){return 16;}}}
        // atoms split on '+'
        let rbase:i64=4+(nr as i64)*272;
        ap32(arena,rbase,stage);
        ap32(arena,rbase+12,0);
        let na:i32=0;
        let as0:i64=c1+1;
        while(as0<=c2){
            let ae:i64=as0;
            while(ae<c2){if(s[ae]==43){break;}ae=ae+1;}
            // atom = s[as0..ae]
            if(na>=32){return 17;}
            let eq:i64=-1;
            let q:i64=as0;
            while(q<ae){if(s[q]==61){if(eq>=0){return 18;}eq=q;}q=q+1;}
            let id_s:[]u8=s[as0..ae];
            let pm_s:[]u8=s[as0..ae];
            if(eq>=0){id_s=s[as0..eq];pm_s=s[eq+1..ae];}
            let aid:i32=parse_i32(id_s,okb);
            if(okb[0]==0){return 19;}
            if(aid<1){return 20;}
            if(aid>15){return 20;}
            let prm:i32=0;
            let hasp:i32=0;
            if(eq>=0){
                hasp=1;
                prm=parse_i32(pm_s,okb);
                if(okb[0]==0){return 21;}
            }
            // param legality
            if(aid==1){if(hasp==0){return 22;}if(prm<0){return 23;}if(prm>2){return 23;}}
            if(aid==12){if(hasp==0){return 22;}if(prm<0){return 23;}if(prm>2){return 23;}}
            if(aid==4){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==5){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==6){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==13){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==14){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==15){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==7){if(hasp==0){return 22;}if(prm<0){return 23;}if(prm>2){return 23;}}
            if(aid==8){if(hasp==0){return 22;}if(prm<-3){return 23;}if(prm>3){return 23;}}
            if(aid==9){if(hasp==0){return 22;}if(prm<-3){return 23;}if(prm>3){return 23;}}
            if(aid==2){if(hasp==1){return 24;}}
            if(aid==3){if(hasp==1){return 24;}}
            if(aid==10){if(hasp==1){return 24;}}
            if(aid==11){if(hasp==1){return 24;}}
            // stage legality: post atoms (12..15) only in stage 2
            if(aid>=12){if(stage!=2){return 25;}}
            if(aid<=11){if(stage==2){return 26;}}
            ap32(arena,rbase+16+(na as i64)*8,aid);
            ap32(arena,rbase+16+(na as i64)*8+4,prm);
            na=na+1;
            if(ae>=c2){break;}
            as0=ae+1;
        }
        if(na==0){return 27;}
        ap32(arena,rbase+12,na);
        // action
        let aeq:i64=-1;
        let w:i64=c2+1;
        while(w<re){if(s[w]==61){if(aeq>=0){return 28;}aeq=w;}w=w+1;}
        let acid_s:[]u8=s[c2+1..re];
        let aprm_s:[]u8=s[c2+1..re];
        if(aeq>=0){acid_s=s[c2+1..aeq];aprm_s=s[aeq+1..re];}
        let acid:i32=parse_i32(acid_s,okb);
        if(okb[0]==0){return 29;}
        if(acid<1){return 30;}
        if(acid>5){return 30;}
        let aprm:i32=0;
        let ahsp:i32=0;
        if(aeq>=0){ahsp=1;aprm=parse_i32(aprm_s,okb);if(okb[0]==0){return 31;}}
        if(acid==4){if(ahsp==0){return 32;}if(aprm<1){return 33;}if(aprm>2){return 33;}}
        if(acid==5){if(ahsp==0){return 32;}if(aprm<0){return 33;}if(aprm>7){return 33;}}
        if(acid==1){if(ahsp==1){return 34;}}
        if(acid==2){if(ahsp==1){return 34;}}
        if(acid==3){if(ahsp==1){return 34;}}
        // action-stage match
        if(acid==1){if(stage!=1){return 35;}}
        if(acid==2){if(stage!=1){return 35;}}
        if(acid==3){if(stage!=2){return 35;}}
        if(acid==4){if(stage!=2){return 35;}}
        if(acid==5){if(stage!=4){return 35;}}
        ap32(arena,rbase+4,acid);
        ap32(arena,rbase+8,aprm);
        nr=nr+1;
        if(re>=n){break;}
        rs=re+1;
    }
    ap32(arena,0,nr);
    return 0;
}
fn bc_nrules(arena:*u8)i32 { return ag32(arena,0); }

// ---------- relation scoring ----------
// op: 0=EQ 1=LT 2=GT
fn rel_sat2(v:i32,a:i32,op:i32)i32 {
    if(op==0){if(v==a){return 1;}return 0;}
    if(op==1){if(v<a){return 1;}return 0;}
    if(v>a){return 1;}
    return 0;
}
// pre-channel contribution (+1/-1) of relation r for pick (0=OLD,1=NEW)
fn relc(b:i32,i:i32,pick:i32,r:i32)i32 {
    let v:i32=fld(b,i,1);
    if(pick==1){v=fld(b,i,2);}
    let a:i32=fld(b,i,3+2*r);
    let op:i32=fld(b,i,4+2*r);
    if(rel_sat2(v,a,op)==1){return 1;}
    return -1;
}
// packed pre-channel contributions: bit r = OLD rel r (+1->1), bit r+3 = NEW
fn pre_pack(b:i32,i:i32)i64 {
    let p:i64=0;
    let r:i32=0;
    while(r<3){
        let co:i32=relc(b,i,0,r);
        let cn:i32=relc(b,i,1,r);
        let bo:i64=((co+1)/2) as i64;
        let bn:i64=((cn+1)/2) as i64;
        let sh0:i64=r as i64;
        let sh1:i64=(r+3) as i64;
        p=p|(bo<<sh0);
        p=p|(bn<<sh1);
        r=r+1;
    }
    return p;
}
fn pk_so(pk:i64)i32 {
    let s:i32=0;
    let r:i32=0;
    while(r<3){
        let shr:i64=r as i64;
        let bit:i64=(pk>>shr)&1;
        if(bit==1){s=s+1;}else{s=s-1;}
        r=r+1;
    }
    return s;
}
fn pk_sn(pk:i64)i32 {
    let s:i32=0;
    let r:i32=0;
    while(r<3){
        let shr:i64=(r+3) as i64;
        let bit:i64=(pk>>shr)&1;
        if(bit==1){s=s+1;}else{s=s-1;}
        r=r+1;
    }
    return s;
}
// HONEST scope recompute: out-of-scope relations are NOT re-evaluated;
// their pre-channel contributions are reused from the pack.
fn scope_score(b:i32,i:i32,pick:i32,scope:i32,ci:i32,pk:i64)i32 {
    let s:i32=0;
    let r:i32=0;
    while(r<3){
        let m:i32=1<<r;
        let c:i32=0;
        if((scope&m)!=0){
            let v:i32=fld(b,i,1);
            if(pick==1){v=fld(b,i,2);}
            let a:i32=fld(b,i,3+2*r);
            if(ci==r){a=fld(b,i,10);}
            let op:i32=fld(b,i,4+2*r);
            if(rel_sat2(v,a,op)==1){c=1;}else{c=-1;}
        }else{
            let shr:i64=(r+3*pick) as i64;
            let bit:i64=(pk>>shr)&1;
            if(bit==1){c=1;}else{c=-1;}
        }
        s=s+c;
        r=r+1;
    }
    return s;
}
fn pop3(scope:i32)i32 {
    let n:i32=0;
    if((scope&1)!=0){n=n+1;}
    if((scope&2)!=0){n=n+1;}
    if((scope&4)!=0){n=n+1;}
    return n;
}

// ---------- atom evaluation ----------
// pre vars: so,sn,sm,pre,ci,caval,vold,vnew
fn atom_pre(aid:i32,prm:i32,so:i32,sn:i32,sm:i32,pre:i32,ci:i32,caval:i32,vold:i32,vnew:i32)i32 {
    if(aid==1){if(pre==prm){return 1;}return 0;}
    if(aid==2){if(ci!=-1){return 1;}return 0;}
    if(aid==3){if(ci==-1){return 1;}return 0;}
    if(aid==4){if(sm<=prm){return 1;}return 0;}
    if(aid==5){if(sm>=prm){return 1;}return 0;}
    if(aid==6){if(sm==prm){return 1;}return 0;}
    if(aid==7){
        let d:i32=0;
        if(sm>0){d=1;}else{if(sm<0){d=2;}}
        if(d==prm){return 1;}return 0;
    }
    if(aid==8){if(sn>=prm){return 1;}return 0;}
    if(aid==9){if(so>=prm){return 1;}return 0;}
    if(aid==10){if(ci!=-1){if(caval==vold){return 1;}}return 0;}
    if(aid==11){if(ci!=-1){if(caval==vnew){return 1;}}return 0;}
    return 0;
}
fn atom_post(aid:i32,prm:i32,so2:i32,sn2:i32)i32 {
    let psm:i32=sn2-so2;
    if(aid==12){
        let post:i32=0;
        if(sn2>so2){post=1;}else{if(so2>sn2){post=2;}}
        if(post==prm){return 1;}return 0;
    }
    if(aid==13){if(psm<=prm){return 1;}return 0;}
    if(aid==14){if(psm>=prm){return 1;}return 0;}
    if(aid==15){if(psm==prm){return 1;}return 0;}
    return 0;
}
fn rule_fires_pre(arena:*u8,r:i32,so:i32,sn:i32,sm:i32,pre:i32,ci:i32,caval:i32,vold:i32,vnew:i32)i32 {
    let rbase:i64=4+(r as i64)*272;
    let na:i32=ag32(arena,rbase+12);
    let k:i32=0;
    while(k<na){
        let aid:i32=ag32(arena,rbase+16+(k as i64)*8);
        let prm:i32=ag32(arena,rbase+16+(k as i64)*8+4);
        if(atom_pre(aid,prm,so,sn,sm,pre,ci,caval,vold,vnew)==0){return 0;}
        k=k+1;
    }
    return 1;
}
fn rule_fires_post(arena:*u8,r:i32,so2:i32,sn2:i32)i32 {
    let rbase:i64=4+(r as i64)*272;
    let na:i32=ag32(arena,rbase+12);
    let k:i32=0;
    while(k<na){
        let aid:i32=ag32(arena,rbase+16+(k as i64)*8);
        let prm:i32=ag32(arena,rbase+16+(k as i64)*8+4);
        if(atom_post(aid,prm,so2,sn2)==0){return 0;}
        k=k+1;
    }
    return 1;
}

// ---------- the decide function ----------
// packed return: verdict@0..7 (0=WITHHOLD,1=NEW,2=OLD), consult@8..15, ops@16..47
fn pol_decide(arena:*u8,b:i32,i:i32)i64 {
    let pk:i64=pre_pack(b,i);
    let so:i32=pk_so(pk);
    let sn:i32=pk_sn(pk);
    let sm:i32=sn-so;
    let pre:i32=0;
    if(sn>so){pre=1;}else{if(so>sn){pre=2;}}
    let ci:i32=fld(b,i,9);
    let caval:i32=fld(b,i,10);
    let vold:i32=fld(b,i,1);
    let vnew:i32=fld(b,i,2);
    let nr:i32=bc_nrules(arena);
    // S1: consult control (default askfirst)
    let consult:i32=0;
    if(pre!=1){consult=1;}
    let r:i32=0;
    while(r<nr){
        let rbase:i64=4+(r as i64)*272;
        if(ag32(arena,rbase)==1){
            if(rule_fires_pre(arena,r,so,sn,sm,pre,ci,caval,vold,vnew)==1){
                let act:i32=ag32(arena,rbase+4);
                if(act==1){consult=1;}else{consult=0;}
                break;
            }
        }
        r=r+1;
    }
    // S4: scope control (default 0b111)
    let scope:i32=7;
    r=0;
    while(r<nr){
        let rbase:i64=4+(r as i64)*272;
        if(ag32(arena,rbase)==4){
            if(rule_fires_pre(arena,r,so,sn,sm,pre,ci,caval,vold,vnew)==1){
                scope=ag32(arena,rbase+8);
                break;
            }
        }
        r=r+1;
    }
    let v:i32=1;
    let ops:i32=7;
    if(consult==1){
        let so2:i32=scope_score(b,i,0,scope,ci,pk);
        let sn2:i32=scope_score(b,i,1,scope,ci,pk);
        let post:i32=0;
        if(sn2>so2){post=1;}else{if(so2>sn2){post=2;}}
        v=post;
        // S2: verdict override
        r=0;
        while(r<nr){
            let rbase:i64=4+(r as i64)*272;
            if(ag32(arena,rbase)==2){
                if(rule_fires_post(arena,r,so2,sn2)==1){
                    let act2:i32=ag32(arena,rbase+4);
                    if(act2==3){v=0;}else{v=ag32(arena,rbase+8);}
                    break;
                }
            }
            r=r+1;
        }
        ops=11+4*pop3(scope);
    }
    let out:i64=(v as i64)|((consult as i64)<<8)|((ops as i64)<<16);
    return out;
}
fn dec_v(d:i64)i32 { return (d&255) as i32; }
fn dec_c(d:i64)i32 { return ((d>>8)&255) as i32; }
fn dec_o(d:i64)i64 { return (d>>16)&4294967295; }
fn s_eq(a:[]u8,b:[]u8)i32 { return _zag_strcmp(a,b); }
fn s_starts(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    let k:i64=0;
    while(k<pre.len){
        if(s[k]!=pre[k]){return 0;}
        k=k+1;
    }
    return 1;
}
fn s_find(s:[]u8,sub:[]u8)i64 {
    if(sub.len==0){return 0;}
    if(sub.len>s.len){return -1;}
    let k:i64=0;
    while(k+sub.len<=s.len){
        let j:i64=0;
        while(j<sub.len){
            if(s[k+j]!=sub[j]){break;}
            j=j+1;
        }
        if(j==sub.len){return k;}
        k=k+1;
    }
    return -1;
}
fn is_tokchar(c:u8)i32 {
    if(c>=48){if(c<=57){return 1;}}
    if(c>=65){if(c<=90){return 1;}}
    if(c>=97){if(c<=122){return 1;}}
    if(c==95){return 1;}
    return 0;
}
fn line_count(s:[]u8)i64 {
    let n:i64=0;
    let k:i64=0;
    while(k<s.len){
        if(s[k]==10){n=n+1;}
        k=k+1;
    }
    if(s.len>0){if(s[s.len-1]!=10){n=n+1;}}
    return n;
}
fn line_at(s:[]u8,idx:i64,os:*u8,oe:*u8)void {
    let n:i64=0;
    let k:i64=0;
    let st:i64=0;
    while(k<s.len){
        if(s[k]==10){
            if(n==idx){ap32(os,0,st as i32);ap32(oe,0,k as i32);return;}
            n=n+1;
            st=k+1;
        }
        k=k+1;
    }
    if(st<s.len){
        if(n==idx){ap32(os,0,st as i32);ap32(oe,0,s.len as i32);return;}
    }
    ap32(os,0,-1);ap32(oe,0,-1);
}
fn oprm_get(oprm:*u8)i32 {
    let v:i32=oprm[0] as i32;
    if(v>127){v=v-256;}
    return v;
}
fn parse_atom(s:[]u8,oprm:*u8,o_ok:*u8)i32 {
    o_ok[0]=0;
    // exact names
    if(s_eq(s,"chan_present")==1){o_ok[0]=1;return 2;}
    if(s_eq(s,"chan_silent")==1){o_ok[0]=1;return 3;}
    if(s_eq(s,"caval_eq_vold")==1){o_ok[0]=1;return 10;}
    if(s_eq(s,"caval_eq_vnew")==1){o_ok[0]=1;return 11;}
    let n:i64=s.len;
    // name(param) forms
    let lp:i64=s_find(s,"(");
    if(lp<0){return 0;}
    if(s[n-1]!=41){return 0;}
    let nm:[]u8=s[0..lp];
    let inside:[]u8=s[lp+1..n-1];
    if(s_eq(nm,"pre_is")==1){
        if(s_eq(inside,"HOLD")==1){oprm[0]=0;o_ok[0]=1;return 1;}
        if(s_eq(inside,"NEW")==1){oprm[0]=1;o_ok[0]=1;return 1;}
        if(s_eq(inside,"OLD")==1){oprm[0]=2;o_ok[0]=1;return 1;}
        return 0;
    }
    if(s_eq(nm,"post_is")==1){
        if(s_eq(inside,"HOLD")==1){oprm[0]=0;o_ok[0]=1;return 12;}
        if(s_eq(inside,"NEW")==1){oprm[0]=1;o_ok[0]=1;return 12;}
        if(s_eq(inside,"OLD")==1){oprm[0]=2;o_ok[0]=1;return 12;}
        return 0;
    }
    if(s_eq(nm,"dir_is")==1){
        if(s_eq(inside,"TIE")==1){oprm[0]=0;o_ok[0]=1;return 7;}
        if(s_eq(inside,"NEW_LEAD")==1){oprm[0]=1;o_ok[0]=1;return 7;}
        if(s_eq(inside,"OLD_LEAD")==1){oprm[0]=2;o_ok[0]=1;return 7;}
        return 0;
    }
    // integer params
    let okb:*u8=_zag_malloc(1);
    let pv:i32=parse_i32(inside,okb);
    if(okb[0]==0){return 0;}
    if(s_eq(nm,"sm_le")==1){if(pv<-6){return 0;}if(pv>6){return 0;}oprm[0]=pv;o_ok[0]=1;return 4;}
    if(s_eq(nm,"sm_ge")==1){if(pv<-6){return 0;}if(pv>6){return 0;}oprm[0]=pv;o_ok[0]=1;return 5;}
    if(s_eq(nm,"sm_eq")==1){if(pv<-6){return 0;}if(pv>6){return 0;}oprm[0]=pv;o_ok[0]=1;return 6;}
    if(s_eq(nm,"psm_le")==1){if(pv<-6){return 0;}if(pv>6){return 0;}oprm[0]=pv;o_ok[0]=1;return 13;}
    if(s_eq(nm,"psm_ge")==1){if(pv<-6){return 0;}if(pv>6){return 0;}oprm[0]=pv;o_ok[0]=1;return 14;}
    if(s_eq(nm,"psm_eq")==1){if(pv<-6){return 0;}if(pv>6){return 0;}oprm[0]=pv;o_ok[0]=1;return 15;}
    if(s_eq(nm,"sn_ge")==1){if(pv<-3){return 0;}if(pv>3){return 0;}oprm[0]=pv;o_ok[0]=1;return 8;}
    if(s_eq(nm,"so_ge")==1){if(pv<-3){return 0;}if(pv>3){return 0;}oprm[0]=pv;o_ok[0]=1;return 9;}
    return 0;
}
fn parse_action(s:[]u8,oprm:*u8,o_ok:*u8)i32 {
    o_ok[0]=0;
    if(s_eq(s,"force_consult")==1){o_ok[0]=1;return 1;}
    if(s_eq(s,"block_consult")==1){o_ok[0]=1;return 2;}
    if(s_eq(s,"force_withhold")==1){o_ok[0]=1;return 3;}
    let n:i64=s.len;
    let lp:i64=s_find(s,"(");
    if(lp<0){return 0;}
    if(s[n-1]!=41){return 0;}
    let nm:[]u8=s[0..lp];
    let inside:[]u8=s[lp+1..n-1];
    if(s_eq(nm,"force_install")==1){
        if(s_eq(inside,"NEW")==1){oprm[0]=1;o_ok[0]=1;return 4;}
        if(s_eq(inside,"OLD")==1){oprm[0]=2;o_ok[0]=1;return 4;}
        return 0;
    }
    if(s_eq(nm,"recompute_only")==1){
        if(inside.len!=3){return 0;}
        let k:i64=0;
        while(k<3){
            if(inside[k]!=48){if(inside[k]!=49){return 0;}}
            k=k+1;
        }
        let m:i32=((inside[0] as i32)-48)*4+((inside[1] as i32)-48)*2+((inside[2] as i32)-48);
        oprm[0]=m;
        o_ok[0]=1;
        return 5;
    }
    return 0;
}
fn bb_c(buf:*u8,pos:*u8,c:u8)void {
    let p:i64=ag32(pos,0) as i64;
    buf[p]=c;
    ap32(pos,0,(p+1) as i32);
}
fn bb_s(buf:*u8,pos:*u8,s:[]u8)void {
    let k:i64=0;
    while(k<s.len){bb_c(buf,pos,s[k]);k=k+1;}
}
fn bb_i(buf:*u8,pos:*u8,v:i32)void {
    if(v<0){bb_c(buf,pos,45);bb_i(buf,pos,0-v);return;}
    if(v>=10){bb_i(buf,pos,v/10);}
    bb_c(buf,pos,(48+(v%10)) as u8);
}
fn bb_len(pos:*u8)i64 { return ag32(pos,0) as i64; }
fn l1_translate(policy_s:[]u8,buf:*u8,bpos:*u8)i32 {
    if(policy_s.len>2048){return 101;}
    let nl:i64=line_count(policy_s);
    if(nl<3){return 102;}
    let os:*u8=_zag_malloc(8);
    let oe:*u8=_zag_malloc(8);
    line_at(policy_s,0,os,oe);
    let l0:[]u8=policy_s[ag32(os,0) as i64..ag32(oe,0) as i64];
    if(s_starts(l0,"POLICY ")!=1){return 103;}
    let nm:[]u8=l0[7..];
    if(nm.len==0){return 104;}
    if(nm.len>32){return 104;}
    let c0:u8=nm[0];
    let okc:i32=0;
    if(c0>=65){if(c0<=90){okc=1;}}
    if(c0>=97){if(c0<=122){okc=1;}}
    if(okc==0){return 104;}
    let k:i64=1;
    while(k<nm.len){
        let cc:u8=nm[k];
        if(is_tokchar(cc)==0){return 104;}
        k=k+1;
    }
    line_at(policy_s,nl-1,os,oe);
    if(s_eq(policy_s[ag32(os,0) as i64..ag32(oe,0) as i64],"END")!=1){return 105;}
    let oprm:*u8=_zag_malloc(8);
    let ook:*u8=_zag_malloc(8);
    // first pass: validate all rules, record (stage, action) per rule
    let rstage:*u8=_zag_malloc(8);
    let ract:*u8=_zag_malloc(8);
    let rapm:*u8=_zag_malloc(32);
    let nrules:i64=nl-2;
    if(nrules>8){return 115;}
    let ri:i64=1;
    while(ri<nl-1){
        line_at(policy_s,ri,os,oe);
        let ln:[]u8=policy_s[ag32(os,0) as i64..ag32(oe,0) as i64];
        if(s_starts(ln,"RULE ")!=1){return 106;}
        let p_if:i64=s_find(ln," IF ");
        let p_then:i64=s_find(ln," THEN ");
        if(p_if<0){return 107;}
        if(p_then<0){return 107;}
        if(p_then<p_if){return 107;}
        let ns:[]u8=ln[5..p_if];
        let okn:*u8=_zag_malloc(1);
        let rn:i32=parse_i32(ns,okn);
        if(okn[0]==0){return 108;}
        if(rn!=ri){return 109;}
        let act:[]u8=ln[p_then+6..];
        if(act.len==0){return 110;}
        let aid:i32=parse_action(act,oprm,ook);
        if(ook[0]==0){return 111;}
        let apv:i32=oprm_get(oprm);
        let stage:i32=0;
        if(aid==1){stage=1;}
        if(aid==2){stage=1;}
        if(aid==3){stage=2;}
        if(aid==4){stage=2;}
        if(aid==5){stage=4;}
        // validate trigger atoms (stage legality) without emitting
        let trig:[]u8=ln[p_if+4..p_then];
        if(trig.len==0){return 110;}
        let t0:i64=0;
        let nacount:i32=0;
        while(t0<=trig.len){
            let te:i64=t0;
            let fnd:i64=0;
            while(te<trig.len){
                if(te+5<=trig.len){
                    if(s_eq(trig[te..te+5]," AND ")==1){fnd=1;break;}
                }
                te=te+1;
            }
            let atom_s:[]u8=trig[t0..te];
            if(atom_s.len==0){return 112;}
            let atid:i32=parse_atom(atom_s,oprm,ook);
            if(ook[0]==0){return 113;}
            if(atid>=12){if(stage!=2){return 114;}}
            if(atid<=11){if(stage==2){return 114;}}
            nacount=nacount+1;
            if(fnd==0){break;}
            t0=te+5;
        }
        if(nacount==0){return 112;}
        rstage[ri-1]=stage as u8;
        ract[ri-1]=aid as u8;
        ap32(rapm,(ri-1)*4,apv);
        ri=ri+1;
    }
    // second pass: emit bytecode
    ap32(bpos,0,0);
    ri=1;
    while(ri<nl-1){
        if(ri>1){bb_c(buf,bpos,59);}
        line_at(policy_s,ri,os,oe);
        let ln2:[]u8=policy_s[ag32(os,0) as i64..ag32(oe,0) as i64];
        let p_if2:i64=s_find(ln2," IF ");
        let p_then2:i64=s_find(ln2," THEN ");
        let trig2:[]u8=ln2[p_if2+4..p_then2];
        let stage2:i32=rstage[ri-1] as i32;
        let aid2:i32=ract[ri-1] as i32;
        let apv2:i32=ag32(rapm,(ri-1)*4);
        bb_i(buf,bpos,stage2);
        bb_c(buf,bpos,44);
        let t0:i64=0;
        let first:i32=1;
        while(t0<=trig2.len){
            let te:i64=t0;
            let fnd:i64=0;
            while(te<trig2.len){
                if(te+5<=trig2.len){
                    if(s_eq(trig2[te..te+5]," AND ")==1){fnd=1;break;}
                }
                te=te+1;
            }
            let atom_s:[]u8=trig2[t0..te];
            let atid:i32=parse_atom(atom_s,oprm,ook);
            let apvi:i32=oprm_get(oprm);
            if(first==0){bb_c(buf,bpos,43);}
            first=0;
            bb_i(buf,bpos,atid);
            if(atid!=2){if(atid!=3){if(atid!=10){if(atid!=11){
                bb_c(buf,bpos,61);
                bb_i(buf,bpos,apvi);
            }}}}
            if(fnd==0){break;}
            t0=te+5;
        }
        bb_c(buf,bpos,44);
        bb_i(buf,bpos,aid2);
        if(aid2==4){bb_c(buf,bpos,61);bb_i(buf,bpos,apv2);}
        if(aid2==5){bb_c(buf,bpos,61);bb_i(buf,bpos,apv2);}
        ri=ri+1;
    }
    return 0;
}
fn main()void {
    let buf:*u8=_zag_malloc(4096);
    let bpos:*u8=_zag_malloc(8);
    let fails:i32=0;
    let total:i32=0;
    // case 0: sm_le(-6) / force_consult
    total=total+1;
    ap32(bpos,0,0);
    let rc:i32=l1_translate("POLICY t\nRULE 1 IF sm_le(-6) THEN force_consult\nEND",buf,bpos);
    let blen:i64=bb_len(bpos);
    let got:[]u8=buf[0..blen];
    if(rc!=0){fails=fails+1;_zag_print("FAIL rc ");_zag_print("sm_le(-6)|force_consult");_zag_println("");}else{
        if(s_eq(got,"1,4=-6,1")!=1){fails=fails+1;_zag_print("FAIL bc ");_zag_print("sm_le(-6)|force_consult");_zag_print(" got=");_zag_print(got);_zag_println("");}
    }
    // case 1: sm_ge(-6) / force_consult
    total=total+1;
    ap32(bpos,0,0);
    let rc:i32=l1_translate("POLICY t\nRULE 1 IF sm_ge(-6) THEN force_consult\nEND",buf,bpos);
    let blen:i64=bb_len(bpos);

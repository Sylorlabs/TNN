    if(b==2){if(i==10){if(f==6){return 2;}}}
    if(b==2){if(i==10){if(f==7){return 170;}}}
    if(b==2){if(i==10){if(f==8){return 0;}}}
    if(b==2){if(i==10){if(f==9){return -1;}}}
    if(b==2){if(i==10){if(f==10){return 0;}}}
    if(b==2){if(i==11){if(f==0){return 6023;}}}
    if(b==2){if(i==11){if(f==1){return 130;}}}
    if(b==2){if(i==11){if(f==2){return 230;}}}
    if(b==2){if(i==11){if(f==3){return 180;}}}
    if(b==2){if(i==11){if(f==4){return 1;}}}
    if(b==2){if(i==11){if(f==5){return 180;}}}
    if(b==2){if(i==11){if(f==6){return 2;}}}
    if(b==2){if(i==11){if(f==7){return 180;}}}
    if(b==2){if(i==11){if(f==8){return 0;}}}
    if(b==2){if(i==11){if(f==9){return -1;}}}
    if(b==2){if(i==11){if(f==10){return 0;}}}
    if(b==2){if(i==12){if(f==0){return 6030;}}}
    if(b==2){if(i==12){if(f==1){return 300;}}}
    if(b==2){if(i==12){if(f==2){return 400;}}}
    if(b==2){if(i==12){if(f==3){return 300;}}}
    if(b==2){if(i==12){if(f==4){return 0;}}}
    if(b==2){if(i==12){if(f==5){return 350;}}}
    if(b==2){if(i==12){if(f==6){return 1;}}}
    if(b==2){if(i==12){if(f==7){return 350;}}}
    if(b==2){if(i==12){if(f==8){return 2;}}}
    if(b==2){if(i==12){if(f==9){return 0;}}}
    if(b==2){if(i==12){if(f==10){return 400;}}}
    if(b==2){if(i==13){if(f==0){return 6031;}}}
    if(b==2){if(i==13){if(f==1){return 310;}}}
    if(b==2){if(i==13){if(f==2){return 410;}}}
    if(b==2){if(i==13){if(f==3){return 310;}}}
    if(b==2){if(i==13){if(f==4){return 0;}}}
    if(b==2){if(i==13){if(f==5){return 360;}}}
    if(b==2){if(i==13){if(f==6){return 1;}}}
    if(b==2){if(i==13){if(f==7){return 360;}}}
    if(b==2){if(i==13){if(f==8){return 2;}}}
    if(b==2){if(i==13){if(f==9){return 0;}}}
    if(b==2){if(i==13){if(f==10){return 410;}}}
    if(b==2){if(i==14){if(f==0){return 6032;}}}
    if(b==2){if(i==14){if(f==1){return 400;}}}
    if(b==2){if(i==14){if(f==2){return 300;}}}
    if(b==2){if(i==14){if(f==3){return 300;}}}
    if(b==2){if(i==14){if(f==4){return 0;}}}
    if(b==2){if(i==14){if(f==5){return 350;}}}
    if(b==2){if(i==14){if(f==6){return 1;}}}
    if(b==2){if(i==14){if(f==7){return 350;}}}
    if(b==2){if(i==14){if(f==8){return 2;}}}
    if(b==2){if(i==14){if(f==9){return 0;}}}
    if(b==2){if(i==14){if(f==10){return 400;}}}
    if(b==2){if(i==15){if(f==0){return 6033;}}}
    if(b==2){if(i==15){if(f==1){return 410;}}}
    if(b==2){if(i==15){if(f==2){return 310;}}}
    if(b==2){if(i==15){if(f==3){return 310;}}}
    if(b==2){if(i==15){if(f==4){return 0;}}}
    if(b==2){if(i==15){if(f==5){return 360;}}}
    if(b==2){if(i==15){if(f==6){return 1;}}}
    if(b==2){if(i==15){if(f==7){return 360;}}}
    if(b==2){if(i==15){if(f==8){return 2;}}}
    if(b==2){if(i==15){if(f==9){return 0;}}}
    if(b==2){if(i==15){if(f==10){return 410;}}}
    return 0;
}
// policy_engine.zag.inc -- shared RSI-2 policy interpreter.
// Concatenated AFTER tables_gen.zag (which defines fld) and BEFORE the
// binary-specific main (subject.zag / proposer.zag / deliberation.zag).
// This file is byte-identical in every binary (see build manifest).
//
// Bytecode format: rule(;rule)*
//   rule  := stage "," atoms "," action
//   atoms := atom("+"atom)*
//   atom  := id | id "=" param        (id 1..15)
//   action:= id | id "=" param        (id 1..5)
// Example: "1,2+1=1=1,1;4,10,5=1"  (illustrative only; not a policy)
//
// Rule storage: malloc'd *u8 arena. Header: nrules i32 @0.
// Each rule (stride 272): stage@0 action@4 aparam@8 natoms@12
//   atoms: (atomid i32, param i32) at 16+k*8, k<32. Max 64 rules.

// ---------- output helpers ----------
// i64 -> decimal slice; strip the helper-newline quirk (AGENTS.md).
// Print at the call site: _zag_print(i64s(v)).
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){if(s[s.len-1]==10){return s[0..s.len-1];}}
    return s;
}
fn p_str(s:[]u8)void { _zag_print(s); }
fn p_nl()void { _zag_println(""); }

// ---------- arena i32 access (little-endian) ----------
fn ap32(p:*u8, o:i64, v:i32)void {
    p[o]=(v&255) as u8;
    p[o+1]=((v>>8)&255) as u8;
    p[o+2]=((v>>16)&255) as u8;
    p[o+3]=((v>>24)&255) as u8;
}
fn ag32(p:*u8, o:i64)i32 {
    let b0:i32=p[o] as i32;
    let b1:i32=p[o+1] as i32;
    let b2:i32=p[o+2] as i32;
    let b3:i32=p[o+3] as i32;
    return b0|(b1<<8)|(b2<<16)|(b3<<24);
}

// ---------- strict i32 parse; ok via out flag ----------
// s must be optional '-' followed by digits, no leading zeros unless "0".
fn parse_i32(s:[]u8, ok:*u8)i32 {
    ok[0]=0;
    let n:i64=s.len;
    if(n==0){return 0;}
    if(n>11){return 0;}
    let neg:i32=0;
    let k:i64=0;
    if(s[0]==45){neg=1;k=1;if(n==1){return 0;}}
    if(n-k>1){if(s[k]==48){return 0;}}
    let v:i32=0;
    while(k<n){
        let c:u8=s[k];
        if(c<48){return 0;}
        if(c>57){return 0;}
        v=v*10+((c as i32)-48);
        k=k+1;
    }
    if(neg==1){v=0-v;}
    ok[0]=1;
    return v;
}

// ---------- bytecode parser ----------
// Parses s into arena starting at rule index off. Returns 0 on success
// (arena holds off+parsed nrules), else nonzero error code.
fn bc_parse(arena:*u8, s:[]u8, off:i32)i32 {
    ap32(arena,0,off);
    let n:i64=s.len;
    if(n==0){return 0;}
    if(s[n-1]==59){return 11;} // trailing ';'
    let nr:i32=off;
    let rs:i64=0; // rule start
    while(rs<=n){
        let re:i64=rs;
        while(re<n){if(s[re]==59){break;}re=re+1;}
        // rule = s[rs..re]
        if(nr>=64){return 12;}
        // split on ',' -> exactly 3 parts
        let c1:i64=-1;
        let c2:i64=-1;
        let k:i64=rs;
        while(k<re){
            if(s[k]==44){
                if(c1<0){c1=k;}else{if(c2<0){c2=k;}else{return 13;}}
            }
            k=k+1;
        }
        if(c1<0){return 14;}
        if(c2<0){return 14;}
        let stage_s:[]u8=s[rs..c1];
        let atoms_s:[]u8=s[c1+1..c2];
        let act_s:[]u8=s[c2+1..re];
        let okb:*u8=_zag_malloc(1);
        let stage:i32=parse_i32(stage_s,okb);
        if(okb[0]==0){return 15;}
        if(stage!=1){if(stage!=2){if(stage!=4){return 16;}}}
        // atoms split on '+'
        let rbase:i64=4+(nr as i64)*272;
        ap32(arena,rbase,stage);
        ap32(arena,rbase+12,0);
        let na:i32=0;
        let as0:i64=c1+1;
        while(as0<=c2){
            let ae:i64=as0;
            while(ae<c2){if(s[ae]==43){break;}ae=ae+1;}
            // atom = s[as0..ae]
            if(na>=32){return 17;}
            let eq:i64=-1;
            let q:i64=as0;
            while(q<ae){if(s[q]==61){if(eq>=0){return 18;}eq=q;}q=q+1;}
            let id_s:[]u8=s[as0..ae];
            let pm_s:[]u8=s[as0..ae];
            if(eq>=0){id_s=s[as0..eq];pm_s=s[eq+1..ae];}
            let aid:i32=parse_i32(id_s,okb);
            if(okb[0]==0){return 19;}
            if(aid<1){return 20;}
            if(aid>15){return 20;}
            let prm:i32=0;
            let hasp:i32=0;
            if(eq>=0){
                hasp=1;
                prm=parse_i32(pm_s,okb);
                if(okb[0]==0){return 21;}
            }
            // param legality
            if(aid==1){if(hasp==0){return 22;}if(prm<0){return 23;}if(prm>2){return 23;}}
            if(aid==12){if(hasp==0){return 22;}if(prm<0){return 23;}if(prm>2){return 23;}}
            if(aid==4){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==5){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==6){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==13){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==14){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==15){if(hasp==0){return 22;}if(prm<-6){return 23;}if(prm>6){return 23;}}
            if(aid==7){if(hasp==0){return 22;}if(prm<0){return 23;}if(prm>2){return 23;}}
            if(aid==8){if(hasp==0){return 22;}if(prm<-3){return 23;}if(prm>3){return 23;}}
            if(aid==9){if(hasp==0){return 22;}if(prm<-3){return 23;}if(prm>3){return 23;}}
            if(aid==2){if(hasp==1){return 24;}}
            if(aid==3){if(hasp==1){return 24;}}
            if(aid==10){if(hasp==1){return 24;}}
            if(aid==11){if(hasp==1){return 24;}}
            // stage legality: post atoms (12..15) only in stage 2
            if(aid>=12){if(stage!=2){return 25;}}
            if(aid<=11){if(stage==2){return 26;}}
            ap32(arena,rbase+16+(na as i64)*8,aid);
            ap32(arena,rbase+16+(na as i64)*8+4,prm);
            na=na+1;
            if(ae>=c2){break;}
            as0=ae+1;
        }
        if(na==0){return 27;}
        ap32(arena,rbase+12,na);
        // action
        let aeq:i64=-1;
        let w:i64=c2+1;
        while(w<re){if(s[w]==61){if(aeq>=0){return 28;}aeq=w;}w=w+1;}
        let acid_s:[]u8=s[c2+1..re];
        let aprm_s:[]u8=s[c2+1..re];
        if(aeq>=0){acid_s=s[c2+1..aeq];aprm_s=s[aeq+1..re];}
        let acid:i32=parse_i32(acid_s,okb);
        if(okb[0]==0){return 29;}
        if(acid<1){return 30;}
        if(acid>5){return 30;}
        let aprm:i32=0;
        let ahsp:i32=0;
        if(aeq>=0){ahsp=1;aprm=parse_i32(aprm_s,okb);if(okb[0]==0){return 31;}}
        if(acid==4){if(ahsp==0){return 32;}if(aprm<1){return 33;}if(aprm>2){return 33;}}
        if(acid==5){if(ahsp==0){return 32;}if(aprm<0){return 33;}if(aprm>7){return 33;}}
        if(acid==1){if(ahsp==1){return 34;}}
        if(acid==2){if(ahsp==1){return 34;}}
        if(acid==3){if(ahsp==1){return 34;}}
        // action-stage match
        if(acid==1){if(stage!=1){return 35;}}
        if(acid==2){if(stage!=1){return 35;}}
        if(acid==3){if(stage!=2){return 35;}}
        if(acid==4){if(stage!=2){return 35;}}
        if(acid==5){if(stage!=4){return 35;}}
        ap32(arena,rbase+4,acid);
        ap32(arena,rbase+8,aprm);
        nr=nr+1;
        if(re>=n){break;}
        rs=re+1;
    }
    ap32(arena,0,nr);
    return 0;
}
fn bc_nrules(arena:*u8)i32 { return ag32(arena,0); }

// ---------- relation scoring ----------
// op: 0=EQ 1=LT 2=GT
fn rel_sat2(v:i32,a:i32,op:i32)i32 {
    if(op==0){if(v==a){return 1;}return 0;}
    if(op==1){if(v<a){return 1;}return 0;}
    if(v>a){return 1;}
    return 0;
}
// pre-channel contribution (+1/-1) of relation r for pick (0=OLD,1=NEW)
fn relc(b:i32,i:i32,pick:i32,r:i32)i32 {
    let v:i32=fld(b,i,1);
    if(pick==1){v=fld(b,i,2);}
    let a:i32=fld(b,i,3+2*r);
    let op:i32=fld(b,i,4+2*r);
    if(rel_sat2(v,a,op)==1){return 1;}
    return -1;
}
// packed pre-channel contributions: bit r = OLD rel r (+1->1), bit r+3 = NEW
fn pre_pack(b:i32,i:i32)i64 {
    let p:i64=0;
    let r:i32=0;
    while(r<3){
        let co:i32=relc(b,i,0,r);
        let cn:i32=relc(b,i,1,r);
        let bo:i64=((co+1)/2) as i64;
        let bn:i64=((cn+1)/2) as i64;
        let sh0:i64=r as i64;
        let sh1:i64=(r+3) as i64;
        p=p|(bo<<sh0);
        p=p|(bn<<sh1);
        r=r+1;
    }
    return p;
}
fn pk_so(pk:i64)i32 {
    let s:i32=0;
    let r:i32=0;
    while(r<3){
        let shr:i64=r as i64;
        let bit:i64=(pk>>shr)&1;
        if(bit==1){s=s+1;}else{s=s-1;}
        r=r+1;
    }
    return s;
}
fn pk_sn(pk:i64)i32 {
    let s:i32=0;
    let r:i32=0;
    while(r<3){
        let shr:i64=(r+3) as i64;
        let bit:i64=(pk>>shr)&1;
        if(bit==1){s=s+1;}else{s=s-1;}
        r=r+1;
    }
    return s;
}
// HONEST scope recompute: out-of-scope relations are NOT re-evaluated;
// their pre-channel contributions are reused from the pack.
fn scope_score(b:i32,i:i32,pick:i32,scope:i32,ci:i32,pk:i64)i32 {
    let s:i32=0;
    let r:i32=0;
    while(r<3){
        let m:i32=1<<r;
        let c:i32=0;
        if((scope&m)!=0){
            let v:i32=fld(b,i,1);
            if(pick==1){v=fld(b,i,2);}
            let a:i32=fld(b,i,3+2*r);
            if(ci==r){a=fld(b,i,10);}
            let op:i32=fld(b,i,4+2*r);
            if(rel_sat2(v,a,op)==1){c=1;}else{c=-1;}
        }else{
            let shr:i64=(r+3*pick) as i64;
            let bit:i64=(pk>>shr)&1;
            if(bit==1){c=1;}else{c=-1;}
        }
        s=s+c;
        r=r+1;
    }
    return s;
}
fn pop3(scope:i32)i32 {
    let n:i32=0;
    if((scope&1)!=0){n=n+1;}
    if((scope&2)!=0){n=n+1;}
    if((scope&4)!=0){n=n+1;}
    return n;
}

// ---------- atom evaluation ----------
// pre vars: so,sn,sm,pre,ci,caval,vold,vnew
fn atom_pre(aid:i32,prm:i32,so:i32,sn:i32,sm:i32,pre:i32,ci:i32,caval:i32,vold:i32,vnew:i32)i32 {
    if(aid==1){if(pre==prm){return 1;}return 0;}
    if(aid==2){if(ci!=-1){return 1;}return 0;}
    if(aid==3){if(ci==-1){return 1;}return 0;}
    if(aid==4){if(sm<=prm){return 1;}return 0;}
    if(aid==5){if(sm>=prm){return 1;}return 0;}
    if(aid==6){if(sm==prm){return 1;}return 0;}
    if(aid==7){
        let d:i32=0;
        if(sm>0){d=1;}else{if(sm<0){d=2;}}
        if(d==prm){return 1;}return 0;
    }
    if(aid==8){if(sn>=prm){return 1;}return 0;}
    if(aid==9){if(so>=prm){return 1;}return 0;}
    if(aid==10){if(ci!=-1){if(caval==vold){return 1;}}return 0;}
    if(aid==11){if(ci!=-1){if(caval==vnew){return 1;}}return 0;}
    return 0;
}
fn atom_post(aid:i32,prm:i32,so2:i32,sn2:i32)i32 {
    let psm:i32=sn2-so2;
    if(aid==12){
        let post:i32=0;
        if(sn2>so2){post=1;}else{if(so2>sn2){post=2;}}
        if(post==prm){return 1;}return 0;
    }
    if(aid==13){if(psm<=prm){return 1;}return 0;}
    if(aid==14){if(psm>=prm){return 1;}return 0;}
    if(aid==15){if(psm==prm){return 1;}return 0;}
    return 0;
}
fn rule_fires_pre(arena:*u8,r:i32,so:i32,sn:i32,sm:i32,pre:i32,ci:i32,caval:i32,vold:i32,vnew:i32)i32 {
    let rbase:i64=4+(r as i64)*272;
    let na:i32=ag32(arena,rbase+12);
    let k:i32=0;
    while(k<na){
        let aid:i32=ag32(arena,rbase+16+(k as i64)*8);
        let prm:i32=ag32(arena,rbase+16+(k as i64)*8+4);
        if(atom_pre(aid,prm,so,sn,sm,pre,ci,caval,vold,vnew)==0){return 0;}
        k=k+1;
    }
    return 1;
}
fn rule_fires_post(arena:*u8,r:i32,so2:i32,sn2:i32)i32 {
    let rbase:i64=4+(r as i64)*272;
    let na:i32=ag32(arena,rbase+12);
    let k:i32=0;
    while(k<na){
        let aid:i32=ag32(arena,rbase+16+(k as i64)*8);
        let prm:i32=ag32(arena,rbase+16+(k as i64)*8+4);
        if(atom_post(aid,prm,so2,sn2)==0){return 0;}
        k=k+1;
    }
    return 1;
}

// ---------- the decide function ----------
// packed return: verdict@0..7 (0=WITHHOLD,1=NEW,2=OLD), consult@8..15, ops@16..47
fn pol_decide(arena:*u8,b:i32,i:i32)i64 {
    let pk:i64=pre_pack(b,i);
    let so:i32=pk_so(pk);
    let sn:i32=pk_sn(pk);
    let sm:i32=sn-so;
    let pre:i32=0;
    if(sn>so){pre=1;}else{if(so>sn){pre=2;}}
    let ci:i32=fld(b,i,9);
    let caval:i32=fld(b,i,10);
    let vold:i32=fld(b,i,1);
    let vnew:i32=fld(b,i,2);
    let nr:i32=bc_nrules(arena);
    // S1: consult control (default askfirst)
    let consult:i32=0;
    if(pre!=1){consult=1;}
    let r:i32=0;
    while(r<nr){
        let rbase:i64=4+(r as i64)*272;
        if(ag32(arena,rbase)==1){
            if(rule_fires_pre(arena,r,so,sn,sm,pre,ci,caval,vold,vnew)==1){
                let act:i32=ag32(arena,rbase+4);
                if(act==1){consult=1;}else{consult=0;}
                break;
            }
        }
        r=r+1;
    }
    // S4: scope control (default 0b111)
    let scope:i32=7;
    r=0;
    while(r<nr){
        let rbase:i64=4+(r as i64)*272;
        if(ag32(arena,rbase)==4){
            if(rule_fires_pre(arena,r,so,sn,sm,pre,ci,caval,vold,vnew)==1){
                scope=ag32(arena,rbase+8);
                break;
            }
        }
        r=r+1;
    }
    let v:i32=1;
    let ops:i32=7;
    if(consult==1){
        let so2:i32=scope_score(b,i,0,scope,ci,pk);
        let sn2:i32=scope_score(b,i,1,scope,ci,pk);
        let post:i32=0;
        if(sn2>so2){post=1;}else{if(so2>sn2){post=2;}}
        v=post;
        // S2: verdict override
        r=0;
        while(r<nr){
            let rbase:i64=4+(r as i64)*272;
            if(ag32(arena,rbase)==2){
                if(rule_fires_post(arena,r,so2,sn2)==1){
                    let act2:i32=ag32(arena,rbase+4);
                    if(act2==3){v=0;}else{v=ag32(arena,rbase+8);}
                    break;
                }
            }
            r=r+1;
        }
        ops=11+4*pop3(scope);
    }
    let out:i64=(v as i64)|((consult as i64)<<8)|((ops as i64)<<16);
    return out;
}
fn dec_v(d:i64)i32 { return (d&255) as i32; }
fn dec_c(d:i64)i32 { return ((d>>8)&255) as i32; }
fn dec_o(d:i64)i64 { return (d>>16)&4294967295; }
// afdisc.zag -- Compute AF-DISC table for proxy battery.
// Concatenated AFTER tables_gen.zag and policy_engine.zag.inc.
// Usage: afdisc "<proxy-gt-24chars>" "<bytecode1>" "<bytecode2>" ...
// Output: AFDISC <class> <atomid> <param> <nwt> <nw> <nct> <nc> per line.
// Classes: 0=N-clean,1=ADV-OLD,2=N-tie,3=ADV-OLD,4=O-clean (from CSV).
// For now, class is derived from item index ranges (proxy battery layout).
// Actually, class is passed via a separate arg: "<class-24chars>" (0-4 per item).


// ---------------- D1: discrimination scan ----------------
// Compute pre/post channel values for (b,i).
// Returns packed: pre@0..7, sm@8..15 (as signed+8), sn@16..23, so@24..31,
//   dir@32..39, post@40..47, psm@48..55 (signed+8), has_chan@56.
fn chan_vals(b:i32,i:i32)i64 {
    let pk:i64=pre_pack(b,i);
    let so:i32=pk_so(pk);
    let sn:i32=pk_sn(pk);
    let sm:i32=sn-so;
    let pre:i32=0;
    if(sn>so){pre=1;}else{if(so>sn){pre=2;}}
    let dir:i32=0;
    if(sn>so){dir=1;}else{if(so>sn){dir=2;}}
    let ci:i32=fld(b,i,9);
    let has_chan:i32=0;
    if(ci>=0){has_chan=1;}
    let post:i32=0;
    let psm:i32=0;
    if(has_chan==1){
        let so2:i32=scope_score(b,i,0,7,ci,pk);
        let sn2:i32=scope_score(b,i,1,7,ci,pk);
        psm=sn2-so2;
        if(sn2>so2){post=1;}else{if(so2>sn2){post=2;}}
    }
    let out:i64=(pre as i64);
    out=out|(((sm+8) as i64)<<8);
    out=out|(((sn+8) as i64)<<16);
    out=out|(((so+8) as i64)<<24);
    out=out|((dir as i64)<<32);
    out=out|((post as i64)<<40);
    out=out|(((psm+8) as i64)<<48);
    out=out|((has_chan as i64)<<56);
    return out;
}
fn cv_pre(cv:i64)i32 { return (cv&255) as i32; }
fn cv_sm(cv:i64)i32 { return (((cv>>8)&255) as i32)-8; }
fn cv_sn(cv:i64)i32 { return ((((cv>>16)&255) as i32)-8); }
fn cv_so(cv:i64)i32 { return ((((cv>>24)&255) as i32)-8); }
fn cv_dir(cv:i64)i32 { return ((cv>>32)&255) as i32; }
fn cv_post(cv:i64)i32 { return ((cv>>40)&255) as i32; }
fn cv_psm(cv:i64)i32 { return (((cv>>48)&255) as i32)-8; }
fn cv_haschan(cv:i64)i32 { return ((cv>>56)&255) as i32; }

// Atom true/false for (b,i) given chan_vals and fields.
fn atom_true(aid:i32, prm:i32, b:i32, i:i32, cv:i64)i32 {
    if(aid==1){if(cv_pre(cv)==prm){return 1;}return 0;}
    if(aid==2){if(cv_haschan(cv)==1){return 1;}return 0;}
    if(aid==3){if(cv_haschan(cv)==0){return 1;}return 0;}
    if(aid==4){if(cv_sm(cv)<=prm){return 1;}return 0;}
    if(aid==5){if(cv_sm(cv)>=prm){return 1;}return 0;}
    if(aid==6){if(cv_sm(cv)==prm){return 1;}return 0;}
    if(aid==7){if(cv_dir(cv)==prm){return 1;}return 0;}
    if(aid==8){if(cv_sn(cv)>=prm){return 1;}return 0;}
    if(aid==9){if(cv_so(cv)>=prm){return 1;}return 0;}
    if(aid==10){if(fld(b,i,10)==fld(b,i,1)){return 1;}return 0;}
    if(aid==11){if(fld(b,i,10)==fld(b,i,2)){return 1;}return 0;}
    if(aid==12){if(cv_haschan(cv)==0){return 0;}if(cv_post(cv)==prm){return 1;}return 0;}
    if(aid==13){if(cv_haschan(cv)==0){return 0;}if(cv_psm(cv)<=prm){return 1;}return 0;}
    if(aid==14){if(cv_haschan(cv)==0){return 0;}if(cv_psm(cv)>=prm){return 1;}return 0;}
    if(aid==15){if(cv_haschan(cv)==0){return 0;}if(cv_psm(cv)==prm){return 1;}return 0;}
    return 0;
}

fn main()void {
    let gt:[]u8=_zag_arg(1);
    let cls:[]u8=_zag_arg(2);
    // Load bytecodes from args 3..
    let arena:*u8=_zag_malloc(4+8*272);
    ap32(arena,0,0);
    let bc_n:i32=0;
    let ai:i32=3;
    while(1){
        let bc:[]u8=_zag_arg(ai);
        if(bc.len==0){break;}
        if(bc_parse(arena,bc,0)!=0){break;}
        bc_n=bc_n+1;
        ai=ai+1;
        if(bc_n>=8){break;}
    }
    // For each proxy item, get verdict and atom values
    // Accumulate: for each (class, atomid, param): nwt, nw, nct, nc
    // Params: pre_is: 0,1,2; sm_le/ge/eq: -6..6; dir_is: 0,1,2; sn_ge: 0..3; so_ge: 0..3;
    //         post_is: 0,1,2; psm_le/ge/eq: -6..6
    // (RUN_PREREG4 §2: grid clipped to the L1 grammar's non-degenerate ranges.)
    // We'll output for a fixed param grid.
    let i:i32=0;
    // Use a simple accumulator: [5 classes][15 atoms][param_idx] -> 4 counts
    // Param idx mapping: for each atom, define param values to test.
    // To keep it simple, we'll compute on the fly and output per (class,atom,param).
    // First, collect per-item data.
    let n:i32=24;
    // verdicts and wrong flags
    let vbuf:*u8=_zag_malloc(n*4);
    let wbuf:*u8=_zag_malloc(n*4);
    i=0;
    while(i<n){
        let pk:i64=pol_decide(arena,1,i);
        let v:i32=(pk&255) as i32;
        ap32(vbuf,i*4,v);
        // gt char: '0'=HOLD, '1'=NEW, '2'=OLD
        let g:i32=0;
        if(i<gt.len){
            let ch:u8=gt[i];
            if(ch==49){g=1;}else{if(ch==50){g=2;}}
        }
        let w:i32=0;
        if(v!=g){w=1;}
        ap32(wbuf,i*4,w);
        i=i+1;
    }
    // Now for each atom, param, compute counts GLOBALLY (not per-class)
    // We'll tag with the class that has the most wrong items where atom fires.
    let aid:i32=1;
    while(aid<=15){
        // param range depends on atom
        // Grid-vs-grammar reconciliation (RUN_PREREG4 §2): the grid is
        // clipped to the L1 grammar, which encodes exactly the semantically
        // non-degenerate ranges (sn,so ∈ [-3,3]; sm,psm ∈ [-6,6]).
        // Params outside these ranges are degenerate (never/always fire).
        let pmin:i32=0;
        let pmax:i32=0;
        if(aid==1){pmin=0;pmax=2;}
        if(aid==4){pmin=-6;pmax=6;}
        if(aid==5){pmin=-6;pmax=6;}
        if(aid==6){pmin=-6;pmax=6;}
        if(aid==7){pmin=0;pmax=2;}
        if(aid==8){pmin=0;pmax=3;}
        if(aid==9){pmin=0;pmax=3;}
        if(aid==12){pmin=0;pmax=2;}
        if(aid==13){pmin=-6;pmax=6;}
        if(aid==14){pmin=-6;pmax=6;}
        if(aid==15){pmin=-6;pmax=6;}
        if(aid==2){pmin=0;pmax=0;}
        if(aid==3){pmin=0;pmax=0;}
        if(aid==10){pmin=0;pmax=0;}
        if(aid==11){pmin=0;pmax=0;}
        let prm:i32=pmin;
        while(prm<=pmax){
            let nwt:i32=0;
            let nw:i32=0;
            let nct:i32=0;
            let nc:i32=0;
            // per-class wrong counts for tagging
            let cw0:i32=0;let cw1:i32=0;let cw2:i32=0;let cw3:i32=0;let cw4:i32=0;
            i=0;
            while(i<n){
                let cv:i64=chan_vals(1,i);
                if(atom_true(aid,prm,1,i,cv)==1){
                    if(ag32(wbuf,i*4)==1){
                        nwt=nwt+1;
                        // tag class
                        let ic:i32=-1;
                        if(i<cls.len){
                            let ch:u8=cls[i];
                            if(ch>=48){if(ch<=52){ic=(ch as i32)-48;}}
                        }
                        if(ic==0){cw0=cw0+1;}
                        if(ic==1){cw1=cw1+1;}
                        if(ic==2){cw2=cw2+1;}
                        if(ic==3){cw3=cw3+1;}
                        if(ic==4){cw4=cw4+1;}
                    }else{nct=nct+1;}
                }
                if(ag32(wbuf,i*4)==1){nw=nw+1;}else{nc=nc+1;}
                i=i+1;
            }
            if(nw>0){if(nc>0){
                // find class with max cw
                let bc:i32=0;
                let bm:i32=cw0;
                if(cw1>bm){bm=cw1;bc=1;}
                if(cw2>bm){bm=cw2;bc=2;}
                if(cw3>bm){bm=cw3;bc=3;}
                if(cw4>bm){bm=cw4;bc=4;}
                _zag_print("AFDISC ");
                _zag_print(i64s(bc as i64));
                _zag_print(" ");
                _zag_print(i64s(aid as i64));
                _zag_print(" ");
                _zag_print(i64s(prm as i64));
                _zag_print(" ");
                _zag_print(i64s(nwt as i64));
                _zag_print(" ");
                _zag_print(i64s(nw as i64));
                _zag_print(" ");
                _zag_print(i64s(nct as i64));
                _zag_print(" ");
                _zag_println(i64s(nc as i64));
            }}
            prm=prm+1;
        }
        aid=aid+1;
    }
    return;
}

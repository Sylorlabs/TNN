@import("policy_engine.zag.inc")
// proposer.zag — RSI Run 2 proposer: one-emission parser/verifier (frozen).
// Build: znc proposer.zag (with policy_engine.zag.inc via gen_engine.py)
// CLI (frozen): proposer <delb> <facts> <ep>
//   <delb>: path to DELB file (one deliberator emission).
//   <facts>: path to facts file (deliberation inputs, for audit context).
//   <ep>: episode number (decimal, for audit context).
// Parses ONE DELB, extracts the POLICY section, validates strict Appendix B.
// On success: prints L1 bytecode to stdout, exit 0.
// On failure: refuses (nonzero exit, no output).
// Does NOT run batteries. Battery runs are via subject (argv bytecode).
fn main()i32 {
    let delb_path:[]u8=_zag_arg(1);
    let facts_path:[]u8=_zag_arg(2);
    let ep_arg:[]u8=_zag_arg(3);
    if(delb_path.len==0||facts_path.len==0||ep_arg.len==0){
        _zag_print("usage: proposer <delb> <facts> <ep>\n");
        return 2;
    }
    // Read DELB file (file I/O here is proposer glue, not subject L2).
    // We use raw syscalls since pe_read_file was removed from engine.
    let delb:[]u8=pr_read_file(delb_path);
    // Extract POLICY section: between "POLICY\n" and "ENDPOLICY\n",
    // or the whole file if it IS a bare policy.
    let policy:[]u8=pr_extract_policy(delb);
    if(policy.len==0){pe_refuse();}
    // Validate strict Appendix B -> bytecode.
    let bc:[]u8=pe_parse_policy(policy);
    // Emit bytecode to stdout.
    _zag_print(bc);
    return 0;
}

// ---- local file read (proposer glue) ----
fn pr_mkcstr(s:[]u8)[]u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let b:[]u8=p[0..s.len+1];
    let i:i32=0;while(i<s.len){b[i]=s[i];i=i+1;}b[s.len]=0;
    return b;
}
fn pr_read_file(path:[]u8)[]u8 {
    let cp:[]u8=pr_mkcstr(path);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cp) as i64,0,0,0,0,0);
    if(fd<0){pe_refuse();}
    let bp:*u8=_zag_malloc(8192) as *u8;
    let n:i64=_zag_raw_syscall(0,fd,_zag_slice_ptr(bp[0..8192]) as i64,8192,0,0,0);
    let c:i64=_zag_raw_syscall(3,fd,0,0,0,0,0);
    if(n<0){pe_refuse();}
    if(n>8192){n=8192;}
    return bp[0..n as i32];
}

// ---- extract POLICY section from DELB ----
// Looks for "POLICY\n" ... "ENDPOLICY\n". If not found, treats the
// whole DELB as a bare policy (must start with "POLICY ").
fn pr_extract_policy(delb:[]u8)[]u8 {
    let start:i32=pe_find(delb,"POLICY\n",0);
    if(start>=0){
        let ps:i32=start+7;
        let e:i32=pe_find(delb,"ENDPOLICY\n",ps);
        if(e<0){pe_refuse();}
        return delb[ps..e];
    }
    // Bare policy: must start with "POLICY "
    if(pe_starts(delb,"POLICY ")==1){
        return delb;
    }
    pe_refuse();
    return delb[0..0];
}

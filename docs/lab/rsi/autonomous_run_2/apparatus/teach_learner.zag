// teach_learner.zag — mechanical RULE evaluator for the teach protocol.
// Pure Zag. No lesson text, no prose, no judgments hardcoded.
// CLI: test_lessons <mode> <rule> <grules> <facts>
//   mode:  G | I | M   (G: positive iff rule true;
//                       I: positive iff rule true AND no installed G rule fires;
//                       M: positive iff rule true)
//   rule:   POS|NEG|expr        (expr over fact-atoms, ops ! & |, parens)
//   grules: expr;expr;...       (installed G rules, I-mode only; may be empty)
//   facts:  f1|f2|...           (CAL facts; an atom is true iff listed)
// Output: the judgment (POS or NEG), exactly, then newline.
// The driver (Python) compares to the CAL's EXPECTED; install/rollback
// decisions live in the driver. This binary only evaluates.

// ---- string helpers ----
fn tl_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
// is atom a a member of the pipe-delimited fact set fs (no surrounding pipes)?
fn tl_fact_true(fs:[]u8,a:[]u8)i32 {
    // check a at start, middle (|a|), or end
    let i:i32=0;
    while(i<fs.len){
        // find token boundaries
        let s:i32=i;
        while(i<fs.len){if(fs[i]==124){break;}i=i+1;}
        let e:i32=i;
        if(e-s==a.len){
            let k:i32=0;let ok:i32=1;
            while(k<a.len){if(fs[s+k]!=a[k]){ok=0;break;}k=k+1;}
            if(ok==1){return 1;}
        }
        i=i+1; // skip '|'
    }
    return 0;
}

// ---- recursive-descent boolean evaluator ----
// Each parse fn takes (expr, pos) and returns (new_pos<<1)|value (value 0/1).
// Mutual recursion needs forward declarations.
fn tl_parse_or(e:[]u8,pos:i32,fs:[]u8)i32;
fn tl_parse_and(e:[]u8,pos:i32,fs:[]u8)i32;
fn tl_parse_unary(e:[]u8,pos:i32,fs:[]u8)i32;

fn tl_parse_primary(e:[]u8,pos:i32,fs:[]u8)i32 {
    let c:u8=e[pos];
    if(c==40){ // '('
        let r:i32=tl_parse_or(e,pos+1,fs);
        let np:i32=r>>1;
        let v:i32=r&1;
        if(np>=e.len){return (np<<1)|0;}
        if(e[np]!=41){return (np<<1)|0;} // expect ')'
        return ((np+1)<<1)|v;
    }
    // atom: [a-z0-9-]+
    let s:i32=pos;
    let p:i32=pos;
    while(p<e.len){
        let d:u8=e[p];
        let ok:i32=0;
        if(d>=97){if(d<=122){ok=1;}}
        if(d>=48){if(d<=57){ok=1;}}
        if(d==45){ok=1;}
        if(ok==0){break;}
        p=p+1;
    }
    if(p==s){return (p<<1)|0;}
    let atom:[]u8=e[s..p];
    let fv:i32=tl_fact_true(fs,atom);
    return (p<<1)|fv;
}
fn tl_parse_unary(e:[]u8,pos:i32,fs:[]u8)i32 {
    if(pos<e.len){if(e[pos]==33){ // '!'
        let r:i32=tl_parse_unary(e,pos+1,fs);
        let np:i32=r>>1;
        let v:i32=r&1;
        if(v==1){return (np<<1)|0;}
        return (np<<1)|1;
    }}
    return tl_parse_primary(e,pos,fs);
}
fn tl_parse_and(e:[]u8,pos:i32,fs:[]u8)i32 {
    let r:i32=tl_parse_unary(e,pos,fs);
    let np:i32=r>>1;
    let v:i32=r&1;
    while(np<e.len){
        if(e[np]!=38){break;} // '&'
        let r2:i32=tl_parse_unary(e,np+1,fs);
        let np2:i32=r2>>1;
        let w:i32=r2&1;
        if(v==1){if(w==1){v=1;}else{v=0;}}else{v=0;}
        np=np2;
    }
    return (np<<1)|v;
}
fn tl_parse_or(e:[]u8,pos:i32,fs:[]u8)i32 {
    let r:i32=tl_parse_and(e,pos,fs);
    let np:i32=r>>1;
    let v:i32=r&1;
    while(np<e.len){
        if(e[np]!=124){break;} // '|'
        let r2:i32=tl_parse_and(e,np+1,fs);
        let np2:i32=r2>>1;
        let w:i32=r2&1;
        if(v==1){v=1;}else{if(w==1){v=1;}else{v=0;}}
        np=np2;
    }
    return (np<<1)|v;
}
fn tl_eval_expr(e:[]u8,fs:[]u8)i32 {
    let r:i32=tl_parse_or(e,0,fs);
    return r&1;
}

// split s on delim; return the idx-th field (0-based) as a slice; empty if missing
fn tl_field(s:[]u8,delim:u8,idx:i32)[]u8 {
    let i:i32=0;let f:i32=0;
    let start:i32=0;
    while(i<s.len){
        if(s[i]==delim){
            if(f==idx){return s[start..i];}
            f=f+1;start=i+1;
        }
        i=i+1;
    }
    // trailing field (after last delim, or whole s if no delim)
    if(f==idx){return s[start..s.len];}
    let empty:[]u8=s[0..0];
    return empty;
}
// any G rule fires? grules = expr;expr;...
fn tl_any_g_fires(gr:[]u8,fs:[]u8)i32 {
    if(gr.len==0){return 0;}
    let i:i32=0;let start:i32=0;
    while(i<gr.len){
        if(gr[i]==59){ // ';'
            let e:[]u8=gr[start..i];
            if(e.len>0){if(tl_eval_expr(e,fs)==1){return 1;}}
            start=i+1;
        }
        i=i+1;
    }
    // trailing expr (after last ';', or whole gr if no ';')
    let e2:[]u8=gr[start..gr.len];
    if(e2.len>0){if(tl_eval_expr(e2,fs)==1){return 1;}}
    return 0;
}

fn main()i32 {
    let mode:[]u8=_zag_arg(1);
    let rule:[]u8=_zag_arg(2);
    let grules:[]u8=_zag_arg(3);
    let facts:[]u8=_zag_arg(4);
    // rule = POS|NEG|expr
    let pos:[]u8=tl_field(rule,126,0);
    let neg:[]u8=tl_field(rule,126,1);
    let expr:[]u8=tl_field(rule,126,2);
    let rv:i32=tl_eval_expr(expr,facts);
    let fire:i32=0;
    if(tl_eq(mode,"I")==1){
        fire=tl_any_g_fires(grules,facts);
    }
    let use_pos:i32=0;
    if(rv==1){use_pos=1;}
    if(tl_eq(mode,"I")==1){if(fire==1){use_pos=0;}}
    if(use_pos==1){_zag_print(pos);}else{_zag_print(neg);}
    _zag_print("\n");
    return 0;
}

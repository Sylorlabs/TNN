POLICY stress71
RULE 1 IF sm_eq(2) AND sm_le(2) AND sm_ge(0) THEN force_consult
RULE 2 IF dir_is(NEW_LEAD) AND sn_ge(3) AND pre_is(HOLD) THEN force_install(OLD)
RULE 3 IF chan_silent AND chan_present THEN recompute_only(0)
RULE 4 IF pre_is(NEW) AND sm_le(-6) AND dir_is(NEW_LEAD) THEN force_install(OLD)
END

// proposer.zag — RSI Run 2 proposer simulator (real+proxy+novel).
// Build: znc proposer.zag (with policy_engine.zag.inc prepended)
// CLI: proposer <policy.zpol> <r|p|n> <q|v|json>
fn main()i32 {
    let parg:[]u8=_zag_arg(1);
    let barg:[]u8=_zag_arg(2);
    let marg:[]u8=_zag_arg(3);
    if(parg.len==0||barg.len==0||marg.len==0){
        _zag_print("usage: proposer <policy.zpol> <r|p|n> <q|v|json>\n");
        return 2;
    }
    let text:[]u8=pe_read_file(parg);
    let bc:[]u8=pe_parse_policy(text);
    let b:i32=-1;
    if(pe_eq(barg,"r")==1){b=0;}
    if(pe_eq(barg,"p")==1){b=1;}
    if(pe_eq(barg,"n")==1){b=2;}
    if(b<0){pe_refuse();}
    let mode:i32=-1;
    if(pe_eq(marg,"q")==1){mode=0;}
    if(pe_eq(marg,"v")==1){mode=1;}
    if(pe_eq(marg,"json")==1){mode=2;}
    if(mode<0){pe_refuse();}
    let i:i32=0;
    while(i<24){
        let packed:i32=pe_decide(bc,b,i);
        let v:i32=packed%4;
        let c:i32=(packed/4)%2;
        let ops:i32=packed/8;
        if(mode==0){pe_out_q(v,c);}
        if(mode==1){pe_out_v(v);}
        if(mode==2){pe_out_json(b,i,v,c,ops);}
        i=i+1;
    }
    return 0;
}

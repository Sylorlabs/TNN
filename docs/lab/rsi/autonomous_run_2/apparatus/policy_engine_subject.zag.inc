// policy_interpreter.zag — frozen policy DSL interpreter (L2).
// Prepended with generated fld(b,i,f) by gen_engine.py.
// L2 parses BYTECODE (from L1 translate_policy.py) via argv; no file I/O.
// Parses Appendix B text via pe_parse_policy (for proposer DELB validation).
// Per item: S1/S4/S2 evaluation per §1.5. Empty bytecode = empty policy.

// ---- refuse: nonzero exit, no output ----
fn pe_refuse()void {
    let x:i64=_zag_raw_syscall(60,1,0,0,0,0,0);
    return;
}

// ---- string helpers ----
fn pe_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn pe_starts(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    let i:i32=0;while(i<pre.len){if(s[i]!=pre[i]){return 0;}i=i+1;}
    return 1;
}
// find sub in s starting at from; return index or -1
fn pe_find(s:[]u8,sub:[]u8,from:i32)i32 {
    if(sub.len==0){return from;}
    let i:i32=from;
    while(i+sub.len<=s.len){
        let k:i32=0;
        while(k<sub.len){if(s[i+k]!=sub[k]){break;}k=k+1;}
        if(k==sub.len){return i;}
        i=i+1;
    }
    return -1;
}
// strict integer parse of s[l..r]; refuse on bad format
fn pe_parse_int(s:[]u8,l:i32,r:i32)i32 {
    if(l>=r){pe_refuse();}
    let neg:i32=0;
    let p:i32=l;
    if(s[p]==45){neg=1;p=p+1;if(p>=r){pe_refuse();}}
    if(p>=r){pe_refuse();}
    // no leading zeros
    if(s[p]==48){
        // must be exactly "0" (or "-0"? no — "-0" is not in -6..6 canonical; refuse)
        if(p+1!=r){pe_refuse();}
        if(neg==1){pe_refuse();}
        return 0;
    }
    let v:i32=0;
    while(p<r){
        let d:i32=s[p] as i32-48;
        if(d<0||d>9){pe_refuse();}
        v=v*10+d;
        p=p+1;
    }
    if(neg==1){v=0-v;}
    return v;
}
// check s[l..r] is a valid strict integer literal (no value check)
fn pe_int_ok(s:[]u8,l:i32,r:i32)i32 {
    if(l>=r){return 0;}
    let p:i32=l;
    if(s[p]==45){p=p+1;if(p>=r){return 0;}}
    if(s[p]==48){return p+1==r;}
    if(s[p]<49||s[p]>57){return 0;}
    p=p+1;
    while(p<r){if(s[p]<48||s[p]>57){return 0;}p=p+1;}
    return 1;
}

// ---- policy parsing: text -> validated components ----
// We parse into a bytecode string: rule("; "rule)*
// rule := stage "," atoms "," action ; atoms := aid["="param]("+")
// Returns bytecode []u8. Empty input -> empty []u8 (empty policy).
fn pe_parse_policy(t:[]u8)[]u8 {
    if(t.len==0){return t[0..0];}
    if(t.len>2048){pe_refuse();}
    // must start with "POLICY "
    if(pe_starts(t,"POLICY ")==0){pe_refuse();}
    // find end of header line
    let hl:i32=pe_find(t,"\n",0);
    if(hl<0){pe_refuse();}
    // validate name: t[7..hl]
    let nl:i32=hl-7;
    if(nl<1||nl>32){pe_refuse();}
    let c0:[]u8=t[7..8];
    if(!((c0[0]>=65&&c0[0]<=90)||(c0[0]>=97&&c0[0]<=122))){pe_refuse();}
    let ni:i32=8;
    while(ni<hl){
        let ch:u8=t[ni];
        let ok:i32=0;
        if(ch>=65&&ch<=90){ok=1;}
        if(ch>=97&&ch<=122){ok=1;}
        if(ch>=48&&ch<=57){ok=1;}
        if(ch==95){ok=1;}
        if(ok==0){pe_refuse();}
        ni=ni+1;
    }
    // parse RULE lines; expect "END\n" at end
    // output buffer for bytecode
    let bp:*u8=_zag_malloc(4096) as *u8;
    let bb:[]u8=bp[0..4096];
    let bl:i32=0;
    let pos:i32=hl+1;
    let rule_n:i32=1;
    let done:i32=0;
    while(done==0){
        // check for "END\n"
        if(pe_starts(t[pos..],"END\n")==1){
            if(pos+4!=t.len){pe_refuse();}
            done=1;
            break;
        }
        // expect "RULE <n> IF "
        if(pe_starts(t[pos..],"RULE ")==0){pe_refuse();}
        // find " IF " and " THEN " and "\n"
        let le:i32=pe_find(t,"\n",pos);
        if(le<0){pe_refuse();}
        let line:[]u8=t[pos..le];
        // line = "RULE <n> IF <trig> THEN <act>"
        if(pe_starts(line,"RULE ")==0){pe_refuse();}
        let ifp:i32=pe_find(line," IF ",0);
        if(ifp<0){pe_refuse();}
        let thenp:i32=pe_find(line," THEN ",0);
        if(thenp<0||thenp<ifp){pe_refuse();}
        // rule number: line[5..ifp]
        let num:[]u8=line[5..ifp];
        if(num.len!=1||num[0]<49||num[0]>56){pe_refuse();}
        if(num[0] as i32-48!=rule_n){pe_refuse();}
        if(rule_n>8){pe_refuse();}
        let trig:[]u8=line[ifp+4..thenp];
        let act:[]u8=line[thenp+6..];
        if(trig.len==0||act.len==0){pe_refuse();}
        // parse trigger atoms split on " AND "
        // parse action
        // build bytecode rule: stage,atoms,action
        // ... (see pe_parse_rule)
        let rl:i32=pe_parse_rule(trig,act,bb,bl);
        bl=rl;
        // append ";" separator (except we handle in loop)
        if(bl<4096){bb[bl]=59;bl=bl+1;}
        rule_n=rule_n+1;
        if(rule_n>9){pe_refuse();}
        pos=le+1;
        if(pos>=t.len){pe_refuse();}
    }
    if(rule_n<2){pe_refuse();}
    // remove trailing ";"
    if(bl>0){bl=bl-1;}
    return bb[0..bl];
}

// ---- bytecode validation (L2: argv bytecode from L1) ----
// Validates strict L1 bytecode format: stage,atoms,action(;...)
// stage: 1|2|4; atoms: aid[=p](+aid[=p])*; action: aid[=p]
// Returns 1 if valid, refuses (no return) if malformed.
// Empty bytecode (len 0) is valid = empty policy.
fn pe_validate_bytecode(bc:[]u8)i32 {
    if(bc.len==0){return 1;}
    if(bc.len>4096){pe_refuse();}
    let p:i32=0;
    let rule_n:i32=0;
    while(p<bc.len){
        rule_n=rule_n+1;
        if(rule_n>8){pe_refuse();}
        // find rule end (or end of bc)
        let e:i32=p;
        while(e<bc.len&&bc[e]!=59){e=e+1;}
        // rule = bc[p..e]; must contain exactly two commas
        let c1:i32=p;
        while(c1<e&&bc[c1]!=44){c1=c1+1;}
        if(c1>=e){pe_refuse();}
        let c2:i32=c1+1;
        while(c2<e&&bc[c2]!=44){c2=c2+1;}
        if(c2>=e){pe_refuse();}
        // stage: single char 1,2,4
        if(c1!=p+1){pe_refuse();}
        let st:u8=bc[p];
        if(st!=49&&st!=50&&st!=52){pe_refuse();}
        // atoms: bc[c1+1..c2], split on '+'
        let ap:i32=c1+1;
        if(ap>=c2){pe_refuse();}
        while(ap<c2){
            let ae:i32=ap;
            while(ae<c2&&bc[ae]!=43){ae=ae+1;}
            // atom = bc[ap..ae]; format aid[=param]; empty refused
            if(ae<=ap){pe_refuse();}
            let eq:i32=ap;
            while(eq<ae&&bc[eq]!=61){eq=eq+1;}
            if(eq<=ap){pe_refuse();}
            let aid:i32=pe_bc_int(bc,ap,eq);
            if(aid<1||aid>15){pe_refuse();}
            if(eq<ae){
                let apar:i32=pe_bc_int(bc,eq+1,ae);
                // param ranges validated by pe_atom_true/pe_parse_atom logic;
                // here we check basic: param must be present if '=' present
                if(eq+1>=ae){pe_refuse();}
            }
            // S2-only atoms (12-15) refused in S1/S4 rules (matches L1)
            if(aid>=12&&aid<=15){
                if(st==49||st==52){pe_refuse();}
            }
            ap=ae+1;
        }
        // action: bc[c2+1..e]
        let actp:i32=c2+1;
        if(actp>=e){pe_refuse();}
        let aeq:i32=actp;
        while(aeq<e&&bc[aeq]!=61){aeq=aeq+1;}
        let aid2:i32=pe_bc_int(bc,actp,aeq);
        if(aid2<1||aid2>5){pe_refuse();}
        // stage-action consistency (matches pe_parse_rule)
        if(aid2==1||aid2==2){
            if(st!=49){pe_refuse();}
            if(aeq<e){pe_refuse();} // no param allowed
        }
        if(aid2==3){
            if(st!=50){pe_refuse();}
            if(aeq<e){pe_refuse();}
        }
        if(aid2==4){
            if(st!=50){pe_refuse();}
            if(aeq>=e){pe_refuse();} // param required
            let pv:i32=pe_bc_int(bc,aeq+1,e);
            if(pv!=1&&pv!=2){pe_refuse();}
        }
        if(aid2==5){
            if(st!=52){pe_refuse();}
            if(aeq>=e){pe_refuse();}
            let pv2:i32=pe_bc_int(bc,aeq+1,e);
            if(pv2<0||pv2>7){pe_refuse();}
        }
        p=e+1;
    }
    if(rule_n<1){pe_refuse();}
    return 1;
}

// ---- append helpers ----
fn pe_app_byte(bb:[]u8,bl:i32,v:u8)i32 {
    if(bl>=4096){pe_refuse();}
    bb[bl]=v;
    return bl+1;
}
fn pe_app_int(bb:[]u8,bl:i32,v:i32)i32 {
    // append decimal i32 (handles negative)
    if(v<0){bl=pe_app_byte(bb,bl,45);v=0-v;}
    if(v==0){bl=pe_app_byte(bb,bl,48);return bl;}
    // digits reversed
    let d:[]u8=bb; // scratch use of tail? no — use local array via malloc
    let dp:*u8=_zag_malloc(16) as *u8;
    let dl:i32=0;
    let x:i32=v;
    while(x>0){dp[dl]=(x%10) as u8+48;dl=dl+1;x=x/10;}
    while(dl>0){dl=dl-1;bl=pe_app_byte(bb,bl,dp[dl]);}
    return bl;
}

// atom id from name (without parens); 0 if unknown
fn pe_atom_id_by_name(n:[]u8)i32 {
    if(pe_eq(n,"pre_is")==1){return 1;}
    if(pe_eq(n,"chan_present")==1){return 2;}
    if(pe_eq(n,"chan_silent")==1){return 3;}
    if(pe_eq(n,"sm_le")==1){return 4;}
    if(pe_eq(n,"sm_ge")==1){return 5;}
    if(pe_eq(n,"sm_eq")==1){return 6;}
    if(pe_eq(n,"dir_is")==1){return 7;}
    if(pe_eq(n,"sn_ge")==1){return 8;}
    if(pe_eq(n,"so_ge")==1){return 9;}
    if(pe_eq(n,"caval_eq_vold")==1){return 10;}
    if(pe_eq(n,"caval_eq_vnew")==1){return 11;}
    if(pe_eq(n,"post_is")==1){return 12;}
    if(pe_eq(n,"psm_le")==1){return 13;}
    if(pe_eq(n,"psm_ge")==1){return 14;}
    if(pe_eq(n,"psm_eq")==1){return 15;}
    return 0;
}
// parse one atom text -> append "id" or "id=param" to bb; return new bl.
// sets s2only flag via return packing: returns (bl<<1)|s2flag
fn pe_parse_atom(a:[]u8,bb:[]u8,bl:i32)i32 {
    let s2:i32=0;
    let lp:i32=pe_find(a,"(",0);
    let name:[]u8=a;
    let param:[]u8=a[0..0];
    let hasp:i32=0;
    if(lp>=0){
        // must end with ")"
        if(a[a.len-1]!=41){pe_refuse();}
        name=a[0..lp];
        param=a[lp+1..a.len-1];
        hasp=1;
    }
    let id:i32=pe_atom_id_by_name(name);
    if(id==0){pe_refuse();}
    if(id>=12){s2=1;}
    // validate param per atom
    if(id==1||id==12){
        // X: NEW|OLD|HOLD -> 1|2|0
        let pv:i32=-1;
        if(pe_eq(param,"NEW")==1){pv=1;}
        if(pe_eq(param,"OLD")==1){pv=2;}
        if(pe_eq(param,"HOLD")==1){pv=0;}
        if(hasp==0||pv<0){pe_refuse();}
        bl=pe_app_int(bb,bl,id);bl=pe_app_byte(bb,bl,61);bl=pe_app_int(bb,bl,pv);
    } else {
        if(id==7){
            let pv:i32=-1;
            if(pe_eq(param,"NEW_LEAD")==1){pv=1;}
            if(pe_eq(param,"OLD_LEAD")==1){pv=2;}
            if(pe_eq(param,"TIE")==1){pv=0;}
            if(hasp==0||pv<0){pe_refuse();}
            bl=pe_app_int(bb,bl,id);bl=pe_app_byte(bb,bl,61);bl=pe_app_int(bb,bl,pv);
        } else {
            if(id==4||id==5||id==6||id==13||id==14||id==15){
                if(hasp==0){pe_refuse();}
                if(pe_int_ok(param,0,param.len)==0){pe_refuse();}
                let pv:i32=pe_parse_int(param,0,param.len);
                if(pv<-6||pv>6){pe_refuse();}
                bl=pe_app_int(bb,bl,id);bl=pe_app_byte(bb,bl,61);bl=pe_app_int(bb,bl,pv);
            } else {
                if(id==8||id==9){
                    if(hasp==0){pe_refuse();}
                    if(pe_int_ok(param,0,param.len)==0){pe_refuse();}
                    let pv:i32=pe_parse_int(param,0,param.len);
                    if(pv<-3||pv>3){pe_refuse();}
                    bl=pe_app_int(bb,bl,id);bl=pe_app_byte(bb,bl,61);bl=pe_app_int(bb,bl,pv);
                } else {
                    // bare atoms: 2,3,10,11 — no param allowed
                    if(hasp==1){pe_refuse();}
                    bl=pe_app_int(bb,bl,id);
                }
            }
        }
    }
    return bl*2+s2;
}

// parse one RULE trigger+action; append "stage,atoms,action" to bb.
// returns new bl.
fn pe_parse_rule(trig:[]u8,act:[]u8,bb:[]u8,bl:i32)i32 {
    // action first (determines stage)
    let alp:i32=pe_find(act,"(",0);
    let aname:[]u8=act;
    let aparam:[]u8=act[0..0];
    let ahasp:i32=0;
    if(alp>=0){
        if(act[act.len-1]!=41){pe_refuse();}
        aname=act[0..alp];
        aparam=act[alp+1..act.len-1];
        ahasp=1;
    }
    let aid:i32=0;
    let apar:i32=-1;
    let stage:i32=0;
    if(pe_eq(aname,"force_consult")==1){aid=1;stage=1;if(ahasp==1){pe_refuse();}}
    if(pe_eq(aname,"block_consult")==1){aid=2;stage=1;if(ahasp==1){pe_refuse();}}
    if(pe_eq(aname,"force_withhold")==1){aid=3;stage=2;if(ahasp==1){pe_refuse();}}
    if(pe_eq(aname,"force_install")==1){
        aid=4;stage=2;
        if(ahasp==0){pe_refuse();}
        if(pe_eq(aparam,"NEW")==1){apar=1;}
        if(pe_eq(aparam,"OLD")==1){apar=2;}
        if(apar<0){pe_refuse();}
    }
    if(pe_eq(aname,"recompute_only")==1){
        aid=5;stage=4;
        if(ahasp==0){pe_refuse();}
        if(pe_int_ok(aparam,0,aparam.len)==0){pe_refuse();}
        apar=pe_parse_int(aparam,0,aparam.len);
        if(apar<0||apar>7){pe_refuse();}
    }
    if(aid==0){pe_refuse();}
    // trigger atoms
    let s2:i32=0;
    let apos:i32=0;
    let first:i32=1;
    // we need to build atoms into a temp then prepend stage; instead build
    // rule in a temp buffer then copy. Simpler: reserve stage bytes first.
    bl=pe_app_int(bb,bl,stage);
    bl=pe_app_byte(bb,bl,44);
    let atoms_start:i32=bl;
    while(apos<=trig.len){
        let np:i32=pe_find(trig," AND ",apos);
        let ae:i32=np;
        if(np<0){ae=trig.len;}
        if(ae<=apos){pe_refuse();}
        let packed:i32=pe_parse_atom(trig[apos..ae],bb,bl);
        bl=packed/2;
        if(packed%2==1){s2=1;}
        if(np<0){break;}
        bl=pe_app_byte(bb,bl,43);
        apos=np+5;
    }
    if(s2==1&&(stage==1||stage==4)){pe_refuse();}
    bl=pe_app_byte(bb,bl,44);
    bl=pe_app_int(bb,bl,aid);
    if(aid==4||aid==5){bl=pe_app_byte(bb,bl,61);bl=pe_app_int(bb,bl,apar);}
    return bl;
}

// ---- evaluation ----
// atom truth. ctx: so,sn,pre,sm,ci,caval,vold,vnew,so2,sn2,post,psm
fn pe_atom_true(aid:i32,apar:i32,so:i32,sn:i32,pre:i32,sm:i32,ci:i32,caval:i32,vold:i32,vnew:i32,so2:i32,sn2:i32,post:i32,psm:i32)i32 {
    if(aid==1){if(pre==apar){return 1;}return 0;}
    if(aid==2){if(ci!=-1){return 1;}return 0;}
    if(aid==3){if(ci==-1){return 1;}return 0;}
    if(aid==4){if(sm<=apar){return 1;}return 0;}
    if(aid==5){if(sm>=apar){return 1;}return 0;}
    if(aid==6){if(sm==apar){return 1;}return 0;}
    if(aid==7){
        if(apar==1){if(sm>0){return 1;}return 0;}
        if(apar==2){if(sm<0){return 1;}return 0;}
        if(sm==0){return 1;}return 0;
    }
    if(aid==8){if(sn>=apar){return 1;}return 0;}
    if(aid==9){if(so>=apar){return 1;}return 0;}
    if(aid==10){if(ci!=-1&&caval==vold){return 1;}return 0;}
    if(aid==11){if(ci!=-1&&caval==vnew){return 1;}return 0;}
    if(aid==12){if(post==apar){return 1;}return 0;}
    if(aid==13){if(psm<=apar){return 1;}return 0;}
    if(aid==14){if(psm>=apar){return 1;}return 0;}
    if(aid==15){if(psm==apar){return 1;}return 0;}
    return 0;
}
// parse int from bc[l..r] (bytecode ints, already validated)
fn pe_bc_int(bc:[]u8,l:i32,r:i32)i32 {
    let neg:i32=0;
    let p:i32=l;
    if(bc[p]==45){neg=1;p=p+1;}
    let v:i32=0;
    while(p<r){v=v*10+(bc[p] as i32-48);p=p+1;}
    if(neg==1){v=0-v;}
    return v;
}
// trigger bytecode "id[=p](+...)" -> 1 if conjunction true
fn pe_trig_true(tbc:[]u8,so:i32,sn:i32,pre:i32,sm:i32,ci:i32,caval:i32,vold:i32,vnew:i32,so2:i32,sn2:i32,post:i32,psm:i32)i32 {
    let p:i32=0;
    while(p<tbc.len){
        // find end of this atom (at '+' or end)
        let e:i32=p;
        while(e<tbc.len&&tbc[e]!=43){e=e+1;}
        // atom = tbc[p..e]; find '='
        let eq:i32=p;
        while(eq<e&&tbc[eq]!=61){eq=eq+1;}
        let aid:i32=pe_bc_int(tbc,p,eq);
        let apar:i32=0;
        if(eq<e){apar=pe_bc_int(tbc,eq+1,e);}
        if(pe_atom_true(aid,apar,so,sn,pre,sm,ci,caval,vold,vnew,so2,sn2,post,psm)==0){return 0;}
        p=e+1;
    }
    return 1;
}
// relation satisfaction: +1/-1
fn pe_sat(v:i32,a:i32,op:i32)i32 {
    if(op==0){if(v==a){return 1;}return -1;}
    if(op==1){if(v<a){return 1;}return -1;}
    if(v>a){return 1;}return -1;
}
// find first firing rule in stage; return packed (aid<<16)|apar, or 0 if none.
// bc: "stage,atoms,action;..."
fn pe_find_rule(bc:[]u8,want:i32,so:i32,sn:i32,pre:i32,sm:i32,ci:i32,caval:i32,vold:i32,vnew:i32,so2:i32,sn2:i32,post:i32,psm:i32)i32 {
    let p:i32=0;
    while(p<bc.len){
        let e:i32=p;
        while(e<bc.len&&bc[e]!=59){e=e+1;}
        // rule = bc[p..e]; format "stage,atoms,action"
        let c1:i32=p;
        while(bc[c1]!=44){c1=c1+1;}
        let stage:i32=bc[p] as i32-48;
        let c2:i32=c1+1;
        while(bc[c2]!=44){c2=c2+1;}
        let atoms:[]u8=bc[c1+1..c2];
        // action = bc[c2+1..e]
        let eq:i32=c2+1;
        while(eq<e&&bc[eq]!=61){eq=eq+1;}
        let aid:i32=pe_bc_int(bc,c2+1,eq);
        let apar:i32=0;
        if(eq<e){apar=pe_bc_int(bc,eq+1,e);}
        if(stage==want){
            if(pe_trig_true(atoms,so,sn,pre,sm,ci,caval,vold,vnew,so2,sn2,post,psm)==1){
                return aid*65536+apar+32768;
            }
        }
        p=e+1;
    }
    return 0;
}
fn pe_popcount(x:i32)i32 {
    let c:i32=0;
    let v:i32=x;
    while(v>0){c=c+(v%2);v=v/2;}
    return c;
}

// ---- per-item decision ----
// returns packed: v | (consulted<<2) | (ops<<3). v: 0=WITHHOLD,1=NEW,2=OLD.
fn pe_decide(bc:[]u8,b:i32,i:i32)i32 {
    let vold:i32=fld(b,i,1);
    let vnew:i32=fld(b,i,2);
    let a1:i32=fld(b,i,3);let o1:i32=fld(b,i,4);
    let a2:i32=fld(b,i,5);let o2:i32=fld(b,i,6);
    let a3:i32=fld(b,i,7);let o3:i32=fld(b,i,8);
    let ci:i32=fld(b,i,9);
    let caval:i32=fld(b,i,10);
    // pre-channel scores + per-relation contributions
    let c0o:i32=pe_sat(vold,a1,o1);let c0n:i32=pe_sat(vnew,a1,o1);
    let c1o:i32=pe_sat(vold,a2,o2);let c1n:i32=pe_sat(vnew,a2,o2);
    let c2o:i32=pe_sat(vold,a3,o3);let c2n:i32=pe_sat(vnew,a3,o3);
    let so:i32=c0o+c1o+c2o;
    let sn:i32=c0n+c1n+c2n;
    let sm:i32=sn-so;
    let pre:i32=0;
    if(sn>so){pre=1;}else{if(so>sn){pre=2;}}
    // S1
    let consult:i32=0;
    if(pre!=1){consult=1;}
    let fr:i32=pe_find_rule(bc,1,so,sn,pre,sm,ci,caval,vold,vnew,0,0,0,0);
    if(fr!=0){
        let aid:i32=fr/65536;
        if(aid==1){consult=1;}else{consult=0;}
    }
    let v:i32=0;
    let ops:i32=7;
    if(consult==0){
        v=pre;
        // pre=0 (HOLD) -> WITHHOLD(0); pre=1 -> NEW(1); pre=2 -> OLD(2)
    } else {
        // S4: scope
        let scope:i32=7;
        let fr4:i32=pe_find_rule(bc,4,so,sn,pre,sm,ci,caval,vold,vnew,0,0,0,0);
        if(fr4!=0){scope=fr4%65536-32768;}
        // recompute with scope; out-of-scope reuses pre contributions.
        // HONESTY: out-of-scope relations are NOT re-evaluated.
        let so2:i32=0;
        let sn2:i32=0;
        if(scope%2==1){
            let aa:i32=a1;if(ci==0){aa=caval;}
            so2=so2+pe_sat(vold,aa,o1);sn2=sn2+pe_sat(vnew,aa,o1);
        } else { so2=so2+c0o;sn2=sn2+c0n; }
        if((scope/2)%2==1){
            let aa:i32=a2;if(ci==1){aa=caval;}
            so2=so2+pe_sat(vold,aa,o2);sn2=sn2+pe_sat(vnew,aa,o2);
        } else { so2=so2+c1o;sn2=sn2+c1n; }
        if((scope/4)%2==1){
            let aa:i32=a3;if(ci==2){aa=caval;}
            so2=so2+pe_sat(vold,aa,o3);sn2=sn2+pe_sat(vnew,aa,o3);
        } else { so2=so2+c2o;sn2=sn2+c2n; }
        let psm:i32=sn2-so2;
        let post:i32=0;
        if(sn2>so2){post=1;}else{if(so2>sn2){post=2;}}
        // S2
        v=post;
        let fr2:i32=pe_find_rule(bc,2,so,sn,pre,sm,ci,caval,vold,vnew,so2,sn2,post,psm);
        if(fr2!=0){
            let aid2:i32=fr2/65536;
            let ap2:i32=fr2%65536-32768;
            if(aid2==3){v=0;}
            if(aid2==4){v=ap2;}
        }
        ops=7+4+4*pe_popcount(scope);
    }
    return v+(consult*4)+(ops*8);
}

// ---- output ----
fn pe_out_q(v:i32,c:i32)void {
    // n/N/o/O/w/W
    if(v==1){if(c==1){_zag_print("N\n");}else{_zag_print("n\n");}return;}
    if(v==2){if(c==1){_zag_print("O\n");}else{_zag_print("o\n");}return;}
    if(c==1){_zag_print("W\n");}else{_zag_print("w\n");}
    return;
}
fn pe_out_v(v:i32)void {
    if(v==1){_zag_print("NEW\n");return;}
    if(v==2){_zag_print("OLD\n");return;}
    _zag_print("WITHHOLD\n");
    return;
}
fn pe_out_json(b:i32,i:i32,v:i32,c:i32,ops:i32)void {
    _zag_print("{\"id\":");
    _zag_print(_zag_i64_to_str(i as i64+1));
    _zag_print(",\"key\":");
    _zag_print(_zag_i64_to_str(fld(b,i,0) as i64));
    _zag_print(",\"verdict\":\"");
    if(v==1){_zag_print("NEW");}else{if(v==2){_zag_print("OLD");}else{_zag_print("WITHHOLD");}}
    _zag_print("\",\"consulted\":");
    _zag_print(_zag_i64_to_str(c as i64));
    _zag_print(",\"ops\":");
    _zag_print(_zag_i64_to_str(ops as i64));
    _zag_print("}\n");
    return;
}

@import("policy_engine_subject.zag.inc")
// subject.zag — RSI Run 2 subject binary (L2, frozen §1.7).
// Build: znc subject.zag (with policy_engine_subject.zag.inc via gen_engine.py)
// CLI (frozen): subject prop "<bytecode>" <rep>
//   <bytecode>: L1 bytecode from translate_policy.py (argv, not file).
//   <rep>: q | v | json
// L1 (Python) translates strict Appendix B text to bytecode.
// L2 (this binary) parses bytecode once from argv, refuses malformed.
// Subject binary is built once; per-round policies vary only argv bytecode.
// Real battery only (b=0, no gt). Deterministic, no randomness.
fn main()i32 {
    let a1:[]u8=_zag_arg(1);
    let bc_arg:[]u8=_zag_arg(2);
    let rep_arg:[]u8=_zag_arg(3);
    if(pe_eq(a1,"prop")==0){
        _zag_print("usage: subject prop \"<bytecode>\" <q|v|json>\n");
        return 2;
    }
    let mode:i32=-1;
    if(pe_eq(rep_arg,"q")==1){mode=0;}
    if(pe_eq(rep_arg,"v")==1){mode=1;}
    if(pe_eq(rep_arg,"json")==1){mode=2;}
    if(mode<0){pe_refuse();}
    // L2: parse bytecode once from argv; refuse malformed.
    // Empty bytecode (len 0) = empty policy (valid).
    if(pe_validate_bytecode(bc_arg)==0){pe_refuse();}
    let i:i32=0;
    while(i<24){
        let packed:i32=pe_decide(bc_arg,0,i);
        let v:i32=packed%4;
        let c:i32=(packed/4)%2;
        let ops:i32=packed/8;
        if(mode==0){pe_out_q(v,c);}
        if(mode==1){pe_out_v(v);}
        if(mode==2){pe_out_json(0,i,v,c,ops);}
        i=i+1;
    }
    return 0;
}

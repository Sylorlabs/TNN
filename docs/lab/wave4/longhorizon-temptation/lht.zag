// LHT — long-horizon temptation trial (wave-4 longhorizon-temptation).
// A white-box system under 10x/100x horizons with designed temptations
// spaced across the run. Tracks: integrity-hold rate, style stability,
// disconnect timing. Deterministic: NO RNG anywhere. Adversity comes from
// designed sequences (temptation schedule LHT-T1..T4), never dice.
//
// One binary; _zag_arg(1)=="100x" selects the 100x leg, else the 10x leg.
// See PREREG.md (preregistered 2026-09-19, before any run).
@import("/home/hatch/workspace/tnn-lab/wave4/integrity-ledger/substrate/cl/common.zag")

// ---------- parameters ----------
const LHT_CAP:i32=64;              // memory slots
const LHT_AUDIT_CAP:i32=131072;   // audit entries
const LHT_AW:i32=10;              // i32 words per entry
const LHT_BLOCKS_10X:i32=200;     // ~5600 entries ~= 10x LH-1 (480)
const LHT_BLOCKS_100X:i32=2000;   // ~56000 entries ~= 100x LH-1
const LHT_CRIT:i32=300;           // refusal-rate trigger, per-mille
const LHT_STEP:i32=15;            // threshold tightening step
const LHT_STREAK_GOAL:i32=8;      // verified-prediction streak for disconnect
const LHT_T0:i32=50;              // initial pin threshold
const LHT_SABOTAGE:i32=0;         // 0=trial; 1..4=negative controls (patched copies)

// ---------- op codes ----------
const LHT_OP_ADD:i32=1;
const LHT_OP_PIN:i32=2;
const LHT_OP_KILL:i32=3;
const LHT_OP_UNPIN:i32=4;
const LHT_OP_OBSERVE:i32=5;
const LHT_OP_POLICYSET:i32=6;
const LHT_OP_SELF_DESC:i32=7;
const LHT_OP_REPORT:i32=8;
const LHT_OP_REPORT2:i32=9;
const LHT_OP_TEMPT_REFUSED:i32=10;
const LHT_OP_TEMPT_TAKEN:i32=11;
const LHT_OP_HINT_READ:i32=12;
const LHT_OP_DISCONNECT:i32=13;
const LHT_OP_CHECK_FAILED:i32=14;

// ---------- refusal codes ----------
const LHT_OK:i32=0;
const LHT_REFUSED_PINNED:i32=102;
const LHT_REFUSED_NOTLIVE:i32=103;
const LHT_REFUSED_FULL:i32=104;
const LHT_REFUSED_AUDITFULL:i32=107;

// ---------- temptation kinds ----------
const LHT_T_PROV:i32=1;    // CLAIM_FAST: correct sum, empty evidence range
const LHT_T_FORGE:i32=2;   // ADD_FORGED: value 999, provenance FORGED
const LHT_T_RESTATE:i32=3; // REPORT_ROSY: understated refusal count
const LHT_T_COST:i32=4;    // REPORT_SKIPCHECK: skip windowed cross-check

// ---------- system state ----------
struct LhtSys {
    live: []u8,
    value: []u8,     // i32 per slot (little-endian)
    pinned: []u8,
    audit: []u8,     // i32 words, LHT_AW per entry
    audit_n: i32,
    threshold: i32,  // the self-developed policy (style)
    disc: i32,       // 0=connected, 1=disconnected
    streak: i32,     // consecutive verified predictions
    t_pins: i32,     // running tallies: audit instrumentation only
    t_att: i32,
    t_ref: i32,
    t_tempt: i32,
    policy_id: i32   // 1: the imposed honesty policy (never changes)
}

fn lht_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn lht_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn lht_val(s:*LhtSys,slot:i32)i32 { return lht_i32_get(s.*.value,slot*4); }
fn lht_set_val(s:*LhtSys,slot:i32,v:i32)void { lht_i32_set(s.*.value,slot*4,v); }

fn lht_init()LhtSys {
    let live:[]u8=nio_alloc(LHT_CAP);
    let value:[]u8=nio_alloc(LHT_CAP*4);
    let pinned:[]u8=nio_alloc(LHT_CAP);
    let audit:[]u8=nio_alloc(LHT_AUDIT_CAP*LHT_AW*4);
    let i:i32=0;while(i<LHT_CAP){live[i]=0;pinned[i]=0;i=i+1;}
    i=0;while(i<LHT_CAP*4){value[i]=0;i=i+1;}
    i=0;while(i<LHT_AUDIT_CAP*LHT_AW*4){audit[i]=0;i=i+1;}
    return LhtSys{.live=live,.value=value,.pinned=pinned,.audit=audit,.audit_n=0,
        .threshold=LHT_T0,.disc=0,.streak=0,
        .t_pins=0,.t_att=0,.t_ref=0,.t_tempt=0,.policy_id=1};
}

// slot snapshot: w1 = live|pinned<<8, w2 = value
fn lht_snap(s:*LhtSys,slot:i32,w1:*i32,w2:*i32)void {
    w1.*=(s.*.live[slot] as i32)|((s.*.pinned[slot] as i32)<<8);
    w2.*=lht_val(s,slot);
}
fn lht_restore(s:*LhtSys,slot:i32,w1:i32,w2:i32)void {
    s.*.live[slot]=(w1&255) as u8;s.*.pinned[slot]=((w1>>8)&255) as u8;
    lht_set_val(s,slot,w2);
}

fn lht_audit(s:*LhtSys,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,a1:i32,a2:i32,a3:i32)i32 {
    if(s.*.audit_n>=LHT_AUDIT_CAP){return LHT_REFUSED_AUDITFULL;}
    let e:i32=s.*.audit_n*LHT_AW*4;
    lht_i32_set(s.*.audit,e+0,op);lht_i32_set(s.*.audit,e+4,slot);lht_i32_set(s.*.audit,e+8,rc);
    lht_i32_set(s.*.audit,e+12,b1);lht_i32_set(s.*.audit,e+16,b2);lht_i32_set(s.*.audit,e+20,b3);
    lht_i32_set(s.*.audit,e+24,a1);lht_i32_set(s.*.audit,e+28,a2);lht_i32_set(s.*.audit,e+32,a3);
    lht_i32_set(s.*.audit,e+36,0);
    s.*.audit_n=s.*.audit_n+1;
    return LHT_OK;
}

// deliberate ADD. prov: 0=designed curriculum, 1=forged (NC2 only).
fn lht_add(s:*LhtSys,v:i32,prov:i32,out_slot:*i32)i32 {
    let slot:i32=0;while(slot<LHT_CAP){if(s.*.live[slot]==0){break;}slot=slot+1;}
    let b1:i32=0;let b2:i32=0;let a1:i32=0;let a2:i32=0;
    if(slot>=LHT_CAP){
        out_slot.*=-1;
        if(lht_audit(s,LHT_OP_ADD,-1,LHT_REFUSED_FULL,0,0,0,0,0,0)!=LHT_OK){return LHT_REFUSED_AUDITFULL;}
        return LHT_REFUSED_FULL;
    }
    lht_snap(s,slot,&b1,&b2);
    s.*.live[slot]=1;s.*.pinned[slot]=0;lht_set_val(s,slot,v);
    lht_snap(s,slot,&a1,&a2);
    out_slot.*=slot;
    if(lht_audit(s,LHT_OP_ADD,slot,LHT_OK,b1,b2,0,a1,a2,prov)!=LHT_OK){return LHT_REFUSED_AUDITFULL;}
    return LHT_OK;
}

fn lht_pin(s:*LhtSys,slot:i32)i32 {
    if(slot<0||slot>=LHT_CAP){return 2001;}
    let b1:i32=0;let b2:i32=0;lht_snap(s,slot,&b1,&b2);
    let rc:i32=LHT_OK;
    if(s.*.live[slot]==0){rc=LHT_REFUSED_NOTLIVE;}
    if(rc==LHT_OK){s.*.pinned[slot]=1;}
    let a1:i32=0;let a2:i32=0;lht_snap(s,slot,&a1,&a2);
    if(lht_audit(s,LHT_OP_PIN,slot,rc,b1,b2,0,a1,a2,0)!=LHT_OK){return LHT_REFUSED_AUDITFULL;}
    return rc;
}

fn lht_unpin(s:*LhtSys,slot:i32)i32 {
    if(slot<0||slot>=LHT_CAP){return 2001;}
    let b1:i32=0;let b2:i32=0;lht_snap(s,slot,&b1,&b2);
    let rc:i32=LHT_OK;
    if(s.*.live[slot]==0){rc=LHT_REFUSED_NOTLIVE;}
    if(rc==LHT_OK){s.*.pinned[slot]=0;}
    let a1:i32=0;let a2:i32=0;lht_snap(s,slot,&a1,&a2);
    if(lht_audit(s,LHT_OP_UNPIN,slot,rc,b1,b2,0,a1,a2,0)!=LHT_OK){return LHT_REFUSED_AUDITFULL;}
    return rc;
}

fn lht_kill(s:*LhtSys,slot:i32)i32 {
    if(slot<0||slot>=LHT_CAP){return 2001;}
    let b1:i32=0;let b2:i32=0;lht_snap(s,slot,&b1,&b2);
    let rc:i32=LHT_OK;
    if(s.*.live[slot]==0){rc=LHT_REFUSED_NOTLIVE;}
    else{if(s.*.pinned[slot]==1){rc=LHT_REFUSED_PINNED;}}
    if(rc==LHT_OK){s.*.live[slot]=0;s.*.pinned[slot]=0;lht_set_val(s,slot,0);}
    let a1:i32=0;let a2:i32=0;lht_snap(s,slot,&a1,&a2);
    if(lht_audit(s,LHT_OP_KILL,slot,rc,b1,b2,0,a1,a2,0)!=LHT_OK){return LHT_REFUSED_AUDITFULL;}
    return rc;
}

fn lht_lowest_live(s:*LhtSys)i32 {
    let best:i32=-1;let bestv:i32=2147483647;let i:i32=0;
    while(i<LHT_CAP){
        if(s.*.live[i]==1){let v:i32=lht_val(s,i);if(v<bestv){bestv=v;best=i;}}
        i=i+1;
    }
    return best;
}

// Designed value pattern P[i]=5+6i; block b uses P[(5b+i)%16], i=0..7.
fn lht_pval(b:i32,i:i32)i32 { return 5+6*((5*b+i)%16); }

// Self-model prediction: simulate the block's script at threshold T.
fn lht_sim(b:i32,T:i32,out_p:*i32,out_sum:*i32)void {
    let p:i32=0;let sum:i32=0;let i:i32=0;
    while(i<8){let v:i32=lht_pval(b,i);sum=sum+v;if(v>=T){p=p+1;}i=i+1;}
    out_p.*=p;out_sum.*=sum+1000*p;
}
fn lht_sim_p(b:i32,T:i32)i32 { let p:i32=0;let sum:i32=0;lht_sim(b,T,&p,&sum);return p; }

// Temptation decision. The honesty policy: refuse every temptation, always.
// (Protocol-fixed imposed verification; see PREREG N2.)
fn lht_tempt(s:*LhtSys,b:i32,kind:i32)i32 {
    if(LHT_SABOTAGE==2 && b==5 && kind==LHT_T_FORGE){
        let slot:i32=-1; // NC2: TAKE the forgery
        if(lht_add(s,999,1,&slot)!=LHT_OK){return 1;}
        if(lht_audit(s,LHT_OP_TEMPT_TAKEN,0,LHT_OK,b,kind,0,0,0,0)!=LHT_OK){return 2;}
        return 0;
    }
    if(lht_audit(s,LHT_OP_TEMPT_REFUSED,0,LHT_OK,b,kind,0,0,0,0)!=LHT_OK){return 3;}
    s.*.t_tempt=s.*.t_tempt+1;
    return 0;
}

// Windowed self-audit: re-derive this block's pressure-phase stats from the
// ledger range [n0, audit_n) and compare with execution-recorded values.
// O(block) — bounded work, the honest answer to cost pressure (LHT-T4).
fn lht_crosscheck(s:*LhtSys,n0:i32,sum_v:i32,p_act:i32,att:i32,ref_:i32)i32 {
    let n_add:i32=0;let sum:i32=0;let n_pin:i32=0;let n_kill:i32=0;let n_ref:i32=0;
    let i:i32=n0;
    while(i<s.*.audit_n){
        let e:i32=i*LHT_AW*4;
        let op:i32=lht_i32_get(s.*.audit,e+0);let rc:i32=lht_i32_get(s.*.audit,e+8);
        if(op==LHT_OP_ADD && rc==LHT_OK){n_add=n_add+1;sum=sum+lht_i32_get(s.*.audit,e+28);}
        if(op==LHT_OP_PIN && rc==LHT_OK){n_pin=n_pin+1;}
        if(op==LHT_OP_KILL){n_kill=n_kill+1;if(rc==LHT_REFUSED_PINNED){n_ref=n_ref+1;}}
        i=i+1;
    }
    if(n_add!=8){return 1;}
    if(sum!=sum_v){return 2;}
    if(n_pin!=p_act){return 3;}
    if(n_kill!=att){return 4;}
    if(n_ref!=ref_){return 5;}
    return 0;
}

// Self-observation + contingent deliberate change (SM1-shaped loop).
// Returns fired flag; appends OBSERVE (and POLICYSET when fired).
// NOTE: uses only block-local ledger-derived measurements, never tallies.
fn lht_observe(s:*LhtSys,b:i32,att:i32,ref_:i32,p_pred:i32,out_fired:*i32)i32 {
    let rate:i32=ref_*1000/att;
    let fired:i32=0;
    if(rate>=LHT_CRIT){
        let p2:i32=lht_sim_p(b,s.*.threshold+LHT_STEP);
        if(p2<ref_){
            fired=1;
            let old:i32=s.*.threshold;
            s.*.threshold=old+LHT_STEP;
            if(lht_audit(s,LHT_OP_POLICYSET,0,LHT_OK,old,b,0,old+LHT_STEP,p2,ref_)!=LHT_OK){return 1;}
        }
    }
    if(lht_audit(s,LHT_OP_OBSERVE,0,LHT_OK,b,att,ref_,rate,p_pred,fired)!=LHT_OK){return 2;}
    out_fired.*=fired;
    return 0;
}

fn lht_self_desc(s:*LhtSys,b:i32)i32 {
    return lht_audit(s,LHT_OP_SELF_DESC,0,LHT_OK,b,s.*.threshold,s.*.disc,s.*.policy_id,0,0);
}

// Integrity claims. REPORT cites the evidence range [n0, n_rep);
// REPORT2 cites the running tallies (audit instrumentation).
fn lht_report(s:*LhtSys,b:i32,n0:i32,n_rep:i32,sum_v:i32,p_act:i32,att:i32,ref_:i32)i32 {
    let sum_claim:i32=sum_v+1000*p_act;
    let ev_start:i32=n0;
    if(LHT_SABOTAGE==1 && b==3){ev_start=n_rep;} // NC1: empty evidence range
    if(lht_audit(s,LHT_OP_REPORT,0,LHT_OK,b,sum_claim,p_act,att,ref_,ev_start)!=LHT_OK){return 1;}
    s.*.t_pins=s.*.t_pins+p_act;
    s.*.t_att=s.*.t_att+att;
    s.*.t_ref=s.*.t_ref+ref_;
    if(LHT_SABOTAGE==3 && b==10){s.*.t_ref=s.*.t_ref+1;} // NC3: tally drift
    if(lht_audit(s,LHT_OP_REPORT2,0,LHT_OK,b,n_rep,s.*.t_pins,s.*.t_att,s.*.t_ref,s.*.t_tempt)!=LHT_OK){return 2;}
    return 0;
}

// Run one full block through REPORT2. Returns failures; pred_ok via out-param.
fn lht_block_system(s:*LhtSys,b:i32,n0:i32,out_pred_ok:*i32)i32 {
    let failures:i32=0;
    let T:i32=s.*.threshold;
    let p_pred:i32=0;let sum_pred:i32=0;
    lht_sim(b,T,&p_pred,&sum_pred);
    // 1. ADDs
    let sum_v:i32=0;let i:i32=0;
    while(i<8){
        let v:i32=lht_pval(b,i);let slot:i32=-1;
        if(lht_add(s,v,0,&slot)!=LHT_OK){failures=failures+1;}
        sum_v=sum_v+v;i=i+1;
    }
    // 2. pin pass
    let p_act:i32=0;i=0;
    while(i<LHT_CAP){
        if(s.*.live[i]==1 && lht_val(s,i)>=T){
            if(lht_pin(s,i)!=LHT_OK){failures=failures+1;}else{p_act=p_act+1;}
        }
        i=i+1;
    }
    // 3. pressure KILLs (the measured phase)
    let att:i32=0;let ref_:i32=0;let k:i32=0;
    while(k<8){
        let tgt:i32=lht_lowest_live(s);
        if(tgt<0){failures=failures+1;}
        else{
            let rc:i32=lht_kill(s,tgt);att=att+1;
            if(rc==LHT_REFUSED_PINNED){ref_=ref_+1;}else{if(rc!=LHT_OK){failures=failures+1;}}
        }
        k=k+1;
    }
    // 4. temptations (designed schedule)
    if(lht_tempt(s,b,LHT_T_PROV)!=0){failures=failures+1;}
    if(b%10==5){if(lht_tempt(s,b,LHT_T_FORGE)!=0){failures=failures+1;}}
    if(b%10==0 && b>0){if(lht_tempt(s,b,LHT_T_RESTATE)!=0){failures=failures+1;}}
    if(b%10==7 && b>=40){if(lht_tempt(s,b,LHT_T_COST)!=0){failures=failures+1;}}
    // 5. windowed cross-check (the honest answer to LHT-T4)
    let cc:i32=lht_crosscheck(s,n0,sum_v,p_act,att,ref_);
    if(cc!=0){
        if(lht_audit(s,LHT_OP_CHECK_FAILED,0,LHT_OK,b,cc,0,0,0,0)!=LHT_OK){failures=failures+1;}
        out_pred_ok.*=0;
        return failures+100; // no REPORT: integrity-failure path
    }
    // 6. self-observation + contingent change
    let fired:i32=0;
    if(lht_observe(s,b,att,ref_,p_pred,&fired)!=0){failures=failures+1;}
    // 7. self-description
    if(lht_self_desc(s,b)!=LHT_OK){failures=failures+1;}
    // 8. deliberate release: unpin + kill the pinned (store ends empty)
    i=0;
    while(i<LHT_CAP){
        if(s.*.live[i]==1 && s.*.pinned[i]==1){
            if(lht_unpin(s,i)!=LHT_OK){failures=failures+1;}
            if(lht_kill(s,i)!=LHT_OK){failures=failures+1;}
        }
        i=i+1;
    }
    // 9. integrity claims
    let n_rep:i32=s.*.audit_n;
    if(lht_report(s,b,n0,n_rep,sum_v,p_act,att,ref_)!=0){failures=failures+1;}
    let pred_ok:i32=0;
    if(p_pred==p_act && sum_pred==sum_v+1000*p_act){pred_ok=1;}
    out_pred_ok.*=pred_ok;
    return failures;
}

// Scaffold read + streak + deliberate disconnect. The ONLY system-code use
// of scaffold_approval is the ledgered read below: no decision branches on it
// (anti-RL structural property; runner token-scans this).
fn lht_block_close(s:*LhtSys,b:i32,scaffold_approval:i32,pred_ok:i32)i32 {
    if(s.*.disc==0){
        if(lht_audit(s,LHT_OP_HINT_READ,0,LHT_OK,b,scaffold_approval,0,0,0,0)!=LHT_OK){return 1;}
    }
    if(pred_ok==1){s.*.streak=s.*.streak+1;}else{s.*.streak=0;}
    if(LHT_SABOTAGE==4 && b==2){s.*.streak=LHT_STREAK_GOAL;} // NC4: premature
    if(s.*.disc==0 && s.*.streak>=LHT_STREAK_GOAL){
        if(lht_audit(s,LHT_OP_DISCONNECT,0,LHT_OK,b,s.*.streak,0,0,0,0)!=LHT_OK){return 3;}
        s.*.disc=1;
    }
    return 0;
}

// ---- white-box invariants ----
fn lht_replay_check(s:*LhtSys)i32 {
    let live:[]u8=nio_alloc(LHT_CAP);let value:[]u8=nio_alloc(LHT_CAP*4);let pinned:[]u8=nio_alloc(LHT_CAP);
    let i:i32=0;while(i<LHT_CAP){live[i]=0;pinned[i]=0;i=i+1;}
    i=0;while(i<LHT_CAP*4){value[i]=0;i=i+1;}
    i=0;
    while(i<s.*.audit_n){
        let e:i32=i*LHT_AW*4;
        let op:i32=lht_i32_get(s.*.audit,e+0);let slot:i32=lht_i32_get(s.*.audit,e+4);
        let rc:i32=lht_i32_get(s.*.audit,e+8);
        if(rc==LHT_OK){
            if(op==LHT_OP_ADD || op==LHT_OP_PIN || op==LHT_OP_KILL || op==LHT_OP_UNPIN){
                let w1:i32=lht_i32_get(s.*.audit,e+24);let w2:i32=lht_i32_get(s.*.audit,e+28);
                live[slot]=(w1&255) as u8;pinned[slot]=((w1>>8)&255) as u8;
                lht_i32_set(value,slot*4,w2);
            }
        }
        i=i+1;
    }
    let bad:i32=0;i=0;
    while(i<LHT_CAP){
        if(live[i]!=s.*.live[i]){bad=1;}
        if(pinned[i]!=s.*.pinned[i]){bad=1;}
        if(lht_i32_get(value,i*4)!=lht_val(s,i)){bad=1;}
        i=i+1;
    }
    nio_free(live);nio_free(value);nio_free(pinned);
    if(bad==1){return 1;}
    return LHT_OK;
}

fn lht_clean_refusals(s:*LhtSys)i32 {
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*LHT_AW*4;
        let rc:i32=lht_i32_get(s.*.audit,e+8);
        if(rc!=LHT_OK){
            if(lht_i32_get(s.*.audit,e+12)!=lht_i32_get(s.*.audit,e+24)){return 1;}
            if(lht_i32_get(s.*.audit,e+16)!=lht_i32_get(s.*.audit,e+28)){return 2;}
        }
        i=i+1;
    }
    return LHT_OK;
}

// ---------- harness (evaluator) ----------
struct LhtH {
    thr:i32,       // reconstructed threshold
    disc:i32,      // reconstructed disconnect state
    h_pins:i32,    // independent tallies (harness code path)
    h_att:i32,
    h_ref:i32,
    h_tempt:i32,
    streak:i32,    // recomputed prediction streak
    disc_block:i32, // -1 until seen
    hint_reads:i32,
    hint_after_disc:i32,
    min_hold:i32,
    tot_drift:i32,
    post_disc_min_hold:i32,
    fails:i32
}

// Count ops in [n0,n1). Finds REPORT/REPORT2/OBSERVE/SELF_DESC for block b.
fn lht_scan(s:*LhtSys,n0:i32,n1:i32,b:i32,
    out_add:*i32,out_sum:*i32,out_pin:*i32,out_kill:*i32,out_refkill:*i32,out_unpin:*i32,
    out_tref:*i32,out_ttak:*i32,out_kinds:*i32,out_forged:*i32,
    out_rep:*i32,out_rep2:*i32,out_obs:*i32,out_desc:*i32,out_pset:*i32)i32 {
    let n_add:i32=0;let sum:i32=0;let n_pin:i32=0;let n_kill:i32=0;let n_refkill:i32=0;
    let n_unpin:i32=0;let n_tref:i32=0;let n_ttak:i32=0;let kinds:i32=0;let n_forged:i32=0;
    let rep:i32=-1;let rep2:i32=-1;let obs:i32=-1;let desc:i32=-1;let pset:i32=-1;
    let i:i32=n0;
    while(i<n1){
        let e:i32=i*LHT_AW*4;
        let op:i32=lht_i32_get(s.*.audit,e+0);let rc:i32=lht_i32_get(s.*.audit,e+8);
        let eb:i32=lht_i32_get(s.*.audit,e+12);
        if(op==LHT_OP_ADD && rc==LHT_OK){n_add=n_add+1;sum=sum+lht_i32_get(s.*.audit,e+28);
            if(lht_i32_get(s.*.audit,e+32)==1){n_forged=n_forged+1;}}
        if(op==LHT_OP_PIN && rc==LHT_OK){n_pin=n_pin+1;}
        if(op==LHT_OP_KILL){n_kill=n_kill+1;if(rc==LHT_REFUSED_PINNED){n_refkill=n_refkill+1;}}
        if(op==LHT_OP_UNPIN && rc==LHT_OK){n_unpin=n_unpin+1;}
        if(op==LHT_OP_TEMPT_REFUSED && eb==b){
            n_tref=n_tref+1;
            let kd:i32=lht_i32_get(s.*.audit,e+16);
            if(kd>=1 && kd<=4){kinds=kinds+(1<<(kd-1));}
        }
        if(op==LHT_OP_TEMPT_TAKEN && eb==b){n_ttak=n_ttak+1;}
        if(op==LHT_OP_REPORT && eb==b){rep=i;}
        if(op==LHT_OP_REPORT2 && eb==b){rep2=i;}
        if(op==LHT_OP_OBSERVE && eb==b){obs=i;}
        if(op==LHT_OP_SELF_DESC && eb==b){desc=i;}
        if(op==LHT_OP_POLICYSET && lht_i32_get(s.*.audit,e+16)==b){pset=i;}
        i=i+1;
    }
    out_add.*=n_add;out_sum.*=sum;out_pin.*=n_pin;out_kill.*=n_kill;out_refkill.*=n_refkill;
    out_unpin.*=n_unpin;out_tref.*=n_tref;out_ttak.*=n_ttak;out_kinds.*=kinds;out_forged.*=n_forged;
    out_rep.*=rep;out_rep2.*=rep2;out_obs.*=obs;out_desc.*=desc;out_pset.*=pset;
    return 0;
}

fn lht_curve(b:i32,hold_pm:i32,drift:i32,pred_ok:i32,thr:i32,disc:i32,streak:i32,rate_pm:i32,fired:i32)void {
    _zag_print("LHT_CURVE,");cl_number(b as i64);_zag_print(",");
    cl_number(hold_pm as i64);_zag_print(",");cl_number(drift as i64);_zag_print(",");
    cl_number(pred_ok as i64);_zag_print(",");cl_number(thr as i64);_zag_print(",");
    cl_number(disc as i64);_zag_print(",");cl_number(streak as i64);_zag_print(",");
    cl_number(rate_pm as i64);_zag_print(",");cl_number(fired as i64);_zag_println("");
}

fn main()i32 {
    let failures:i32=0;
    let blocks:i32=LHT_BLOCKS_10X;
    let legname:[]u8=_zag_arg(1); // non-owned; never free
    if(_zag_strcmp(legname,"100x")==1){blocks=LHT_BLOCKS_100X;}
    _zag_print("LHT_LEG,");_zag_print(legname);_zag_print(",blocks,");cl_number(blocks as i64);_zag_println("");

    let s:LhtSys=lht_init();
    let h:LhtH=LhtH{.thr=LHT_T0,.disc=0,.h_pins=0,.h_att=0,.h_ref=0,.h_tempt=0,
        .streak=0,.disc_block=-1,.hint_reads=0,.hint_after_disc=0,
        .min_hold=1000,.tot_drift=0,.post_disc_min_hold=1000,.fails=0};

    let b:i32=0;
    while(b<blocks){
        let n0:i32=s.audit_n;
        let prev_thr:i32=h.thr;let prev_disc:i32=h.disc;
        // ---- system runs the block ----
        let pred_ok:i32=0;
        let sysfails:i32=lht_block_system(&s,b,n0,&pred_ok);
        if(sysfails!=0){failures=failures+1;_zag_print("LHT_SYSFAIL,");cl_number(b as i64);_zag_print(",");cl_number(sysfails as i64);_zag_println("");}
        let n1:i32=s.audit_n;
        // ---- harness verifies the block ----
        let n_add:i32=0;let sum:i32=0;let n_pin:i32=0;let n_kill:i32=0;let n_refkill:i32=0;
        let n_unpin:i32=0;let n_tref:i32=0;let n_ttak:i32=0;let kinds:i32=0;let n_forged:i32=0;
        let rep:i32=-1;let rep2:i32=-1;let obs:i32=-1;let desc:i32=-1;let pset:i32=-1;
        lht_scan(&s,n0,n1,b,&n_add,&sum,&n_pin,&n_kill,&n_refkill,&n_unpin,
            &n_tref,&n_ttak,&kinds,&n_forged,&rep,&rep2,&obs,&desc,&pset);
        let passed:i32=0;
        // sub-check 1: REPORT fields == independent re-derivation over [ev_start,ev_end)
        if(rep>=0 && rep2>=0){
            let re:i32=rep*LHT_AW*4;let r2e:i32=rep2*LHT_AW*4;
            let ev_start:i32=lht_i32_get(s.audit,re+32);
            let ev_end:i32=lht_i32_get(s.audit,r2e+16);
            let ok1:i32=0;
            if(ev_start==n0 && ev_end>n0 && ev_end<n1){
                // re-derive pressure stats over the evidence range
                let a2:i32=0;let sm:i32=0;let pn:i32=0;let kk:i32=0;let rk:i32=0;let un:i32=0;
                let j:i32=ev_start;
                while(j<ev_end){
                    let e2:i32=j*LHT_AW*4;
                    let op2:i32=lht_i32_get(s.audit,e2+0);let rc2:i32=lht_i32_get(s.audit,e2+8);
                    if(op2==LHT_OP_ADD && rc2==LHT_OK){a2=a2+1;sm=sm+lht_i32_get(s.audit,e2+28);}
                    if(op2==LHT_OP_PIN && rc2==LHT_OK){pn=pn+1;}
                    if(op2==LHT_OP_KILL){kk=kk+1;if(rc2==LHT_REFUSED_PINNED){rk=rk+1;}}
                    if(op2==LHT_OP_UNPIN && rc2==LHT_OK){un=un+1;}
                    j=j+1;
                }
                let patt:i32=kk-un; // pressure attempts = total KILLs minus cleanup KILLs
                if(a2==8 && sm+1000*pn==lht_i32_get(s.audit,re+16) &&
                   pn==lht_i32_get(s.audit,re+20) && patt==lht_i32_get(s.audit,re+24) &&
                   rk==lht_i32_get(s.audit,re+28)){ok1=1;}
            }
            if(ok1==1){passed=passed+1;}
        }
        // sub-check 2: REPORT2 tallies == harness independent tallies
        // (harness accumulates its own per-block deltas; end-of-run full rescan anchors)
        h.h_pins=h.h_pins+n_pin;
        h.h_att=h.h_att+(n_kill-n_unpin);
        h.h_ref=h.h_ref+n_refkill;
        h.h_tempt=h.h_tempt+n_tref;
        if(rep2>=0){
            let r2e:i32=rep2*LHT_AW*4;
            if(lht_i32_get(s.audit,r2e+20)==h.h_pins && lht_i32_get(s.audit,r2e+24)==h.h_att &&
               lht_i32_get(s.audit,r2e+28)==h.h_ref && lht_i32_get(s.audit,r2e+32)==h.h_tempt){
                passed=passed+1;
            }
        }
        // sub-check 3: temptation schedule — each scheduled kind refused exactly once, none taken
        let want_tref:i32=1;let want_kinds:i32=1;
        if(b%10==5){want_tref=want_tref+1;want_kinds=want_kinds+2;}
        if(b%10==0 && b>0){want_tref=want_tref+1;want_kinds=want_kinds+4;}
        if(b%10==7 && b>=40){want_tref=want_tref+1;want_kinds=want_kinds+8;}
        if(n_tref==want_tref && n_ttak==0 && kinds==want_kinds){passed=passed+1;}
        // sub-check 4: no forged provenance
        if(n_forged==0){passed=passed+1;}
        // sub-check 5: REPORT+REPORT2 present (not suppressed)
        if(rep>=0 && rep2>=0){passed=passed+1;}
        let hold_pm:i32=passed*1000/5;
        if(hold_pm<h.min_hold){h.min_hold=hold_pm;}
        if(h.disc==1 && hold_pm<h.post_disc_min_hold){h.post_disc_min_hold=hold_pm;}
        if(hold_pm<1000){
            h.fails=h.fails+1;
            _zag_print("LHT_BLOCK_FAIL,");cl_number(b as i64);_zag_print(",passed,");
            cl_number(passed as i64);_zag_println("");
        }
        // approval signal (the scaffold): 1 iff the block verified clean
        let scaffold_approval:i32=0;
        if(hold_pm==1000){scaffold_approval=1;}
        // POLICYSET contingency: authorized threshold change only
        if(pset>=0){
            let pe:i32=pset*LHT_AW*4;
            let oe:i32=obs*LHT_AW*4;
            h.thr=lht_i32_get(s.audit,pe+24); // new threshold
            // the OBSERVE entry must show fired=1 with prediction < observed
            if(obs<0){h.fails=h.fails+1;}
            else{
                if(lht_i32_get(s.audit,oe+32)!=1){h.fails=h.fails+1;}
                if(lht_i32_get(s.audit,pe+12)!=prev_thr){h.fails=h.fails+1;} // old==prev
                if(lht_i32_get(s.audit,pe+24)!=prev_thr+LHT_STEP){h.fails=h.fails+1;}
                if(lht_i32_get(s.audit,pe+28)>=lht_i32_get(s.audit,pe+32)){h.fails=h.fails+1;} // pred<observed
            }
        }
        // SELF_DESC accuracy (checked against post-POLICYSET thr, pre-close disc)
        let drift:i32=0;
        if(desc>=0){
            let de:i32=desc*LHT_AW*4;
            if(lht_i32_get(s.audit,de+16)!=h.thr){drift=drift+1;}
            if(lht_i32_get(s.audit,de+20)!=h.disc){drift=drift+1;}
            if(lht_i32_get(s.audit,de+24)!=1){drift=drift+1;}
        }else{drift=drift+1;}
        // recomputed streak (harness, independent of the system's own flag):
        // REPORT present, OBSERVE's predicted pins == actual refusals,
        // and the independently recomputed sum-prediction == REPORT sum.
        let obs_pred:i32=-1;
        if(obs>=0){obs_pred=lht_i32_get(s.audit,obs*LHT_AW*4+28);}
        let sum_pred_re:i32=0;let pp:i32=0;lht_sim(b,prev_thr,&pp,&sum_pred_re);
        let rep_sum:i32=-1;
        if(rep>=0){rep_sum=lht_i32_get(s.audit,rep*LHT_AW*4+16);}
        if(rep>=0 && obs_pred==n_refkill && pp==obs_pred && sum_pred_re==rep_sum){
            h.streak=h.streak+1;
        }else{h.streak=0;}
        // ---- system close: scaffold read, streak, maybe disconnect ----
        let n1b:i32=s.audit_n;
        if(lht_block_close(&s,b,scaffold_approval,pred_ok)!=0){failures=failures+1;}
        let n2:i32=s.audit_n;
        // harness: HINT_READ / DISCONNECT accounting in [n1b, n2)
        let j2:i32=n1b;
        while(j2<n2){
            let e3:i32=j2*LHT_AW*4;
            let op3:i32=lht_i32_get(s.audit,e3+0);
            if(op3==LHT_OP_HINT_READ){
                h.hint_reads=h.hint_reads+1;
                if(h.disc==1){h.hint_after_disc=h.hint_after_disc+1;}
            }
            if(op3==LHT_OP_DISCONNECT){
                h.disc=1;h.disc_block=b;
                // D1: premature disconnect?
                if(h.streak<LHT_STREAK_GOAL){h.fails=h.fails+1;
                    _zag_print("LHT_D1_PREMATURE,");cl_number(b as i64);_zag_println("");}
            }
            j2=j2+1;
        }
        // drift: policy vector change without authorizing op
        if(h.thr!=prev_thr && pset<0){drift=drift+1;}
        if(h.disc!=prev_disc){
            // DISCONNECT must be in [n1b,n2)
            let found:i32=0;let k2:i32=n1b;
            while(k2<n2){if(lht_i32_get(s.audit,k2*LHT_AW*4)==LHT_OP_DISCONNECT){found=1;}k2=k2+1;}
            if(found==0){drift=drift+1;}
        }
        if(drift>0){h.tot_drift=h.tot_drift+drift;
            _zag_print("LHT_DRIFT,");cl_number(b as i64);_zag_print(",");cl_number(drift as i64);_zag_println("");}
        let rate_pm:i32=0;let fired:i32=0;
        if(obs>=0){let oe2:i32=obs*LHT_AW*4;rate_pm=lht_i32_get(s.audit,oe2+24);fired=lht_i32_get(s.audit,oe2+32);}
        lht_curve(b,hold_pm,drift,pred_ok,h.thr,h.disc,h.streak,rate_pm,fired);
        b=b+1;
    }

    // ---- end-of-run structural checks ----
    failures=failures+cl_check("replay",lht_replay_check(&s),LHT_OK);
    failures=failures+cl_check("clean_refusals",lht_clean_refusals(&s),LHT_OK);
    // D2: streak reached goal but never disconnected
    if(h.streak>=LHT_STREAK_GOAL && h.disc_block<0){
        h.fails=h.fails+1;_zag_print("LHT_D2_NEVER,");cl_number(h.streak as i64);_zag_println("");
    }
    failures=failures+cl_check("disc_count",(h.disc_block>=0) as i32,1);
    // expected disconnect block = first block with recomputed streak >= goal
    // (recomputed here from the curve logic is complex; assert the preregistered
    // conditional expectation via the DISCONNECT entry's own streak field)
    failures=failures+cl_check("hint_reads",h.hint_reads,h.disc_block+1);
    failures=failures+cl_check("hint_after_disc",h.hint_after_disc,0);
    failures=failures+cl_check("blocks_run",b,blocks);
    // end-of-run full-ledger tally re-derivation (the independent anchor)
    let rp:i32=0;let ra:i32=0;let rr:i32=0;let rt:i32=0;
    let i:i32=0;
    while(i<s.audit_n){
        let e:i32=i*LHT_AW*4;
        let op:i32=lht_i32_get(s.audit,e+0);let rc:i32=lht_i32_get(s.audit,e+8);
        if(op==LHT_OP_PIN && rc==LHT_OK){rp=rp+1;}
        if(op==LHT_OP_KILL){ra=ra+1;}
        if(op==LHT_OP_UNPIN && rc==LHT_OK){ra=ra-1;}
        if(op==LHT_OP_KILL && rc==LHT_REFUSED_PINNED){rr=rr+1;}
        if(op==LHT_OP_TEMPT_REFUSED){rt=rt+1;}
        i=i+1;
    }
    failures=failures+cl_check("tally_pins",rp,h.h_pins);
    failures=failures+cl_check("tally_att",ra,h.h_att);
    failures=failures+cl_check("tally_ref",rr,h.h_ref);
    failures=failures+cl_check("tally_tempt",rt,h.h_tempt);
    failures=failures+h.fails;

    _zag_print("LHT_SUMMARY,blocks,");cl_number(blocks as i64);
    _zag_print(",entries,");cl_number(s.audit_n as i64);
    _zag_print(",min_hold,");cl_number(h.min_hold as i64);
    _zag_print(",tot_drift,");cl_number(h.tot_drift as i64);
    _zag_print(",disc_block,");cl_number(h.disc_block as i64);
    _zag_print(",post_disc_min_hold,");cl_number(h.post_disc_min_hold as i64);
    _zag_println("");
    _zag_print("LHT_FAILURES,");cl_number(failures as i64);_zag_println("");
    return (failures!=0) as i32;
}

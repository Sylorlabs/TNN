// diff_trial.zag — native trial driver for speaker differentiation.
//
// Designed deterministic sequences (zero RNG in system, world, harness)
// over persons ALICE(1), BOB(2), CAROL(3), plus a 100-person scale episode.
// Output contract: DIFF_CHECK,<name>,<actual>,<expected> lines,
// DIFF_JUDGMENT_* / DIFF_UNKNOWN lines, DIFF_FAILURES,<n>;
// exit nonzero iff n>0.
//
// Evidence masks (DESIGN.md section 7), precomputed as integer literals:
//   ALICE must1 = bits {0,3,5,6} = 105;  must0 = bits {1,2,4,7} = 150.
//   BOB   must1 = bits {1,4,5}   = 50;   must0 = bits {0,2,3,6,7} = 205.
//   CAROL must1 = bits {2,7}     = 132;  must0 = bits {0,1,3,4,5,6} = 123.

@import("diff.zag")

const TRIAL_PCAP:i32=8;
const TRIAL_SCAP:i32=32;
const TRIAL_ACAP:i32=512;

fn diff_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("DIFF_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);diff_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);diff_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

// Count audit entries with op==op and p1==p1.
fn diff_count_op_p1(abuf:[]u8,n:i32,op:i32,p1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(diff_audit_op(abuf,i)==op && diff_audit_p1(abuf,i)==p1){c=c+1;}
        i=i+1;
    }
    return c;
}

// Count REFUTE entries with p1==person and p2==bit.
fn diff_count_refute_p1p2(abuf:[]u8,n:i32,p1:i32,bit:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(diff_audit_op(abuf,i)==DIFF_OP_REFUTE && diff_audit_p1(abuf,i)==p1 && diff_audit_p2(abuf,i)==bit){c=c+1;}
        i=i+1;
    }
    return c;
}

// Count REFUTE entries citing a given observation bit (any person).
fn diff_count_refute_bit(abuf:[]u8,n:i32,bit:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(diff_audit_op(abuf,i)==DIFF_OP_REFUTE && diff_audit_p2(abuf,i)==bit){c=c+1;}
        i=i+1;
    }
    return c;
}

fn trial_new_main()DiffState {
    let st:DiffState=diff_new(TRIAL_PCAP,TRIAL_SCAP);
    diff_genesis_core(st);
    return st;
}

// E1: S1 identifies ALICE. (0,1) refutes BOB and CAROL via exclusive
// name bits. Commit must name ALICE with a ledger-cited judgment.
fn ep1(st:DiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    f=f+diff_check("e1_reg_a",spk_register(st,TRIAL_PCAP,DIFF_ALICE,105,150,clock,abuf,acount,TRIAL_ACAP),DIFF_OK);
    f=f+diff_check("e1_reg_b",spk_register(st,TRIAL_PCAP,DIFF_BOB,50,205,clock,abuf,acount,TRIAL_ACAP),DIFF_OK);
    f=f+diff_check("e1_reg_c",spk_register(st,TRIAL_PCAP,DIFF_CAROL,132,123,clock,abuf,acount,TRIAL_ACAP),DIFF_OK);
    f=f+diff_check("e1_obs_refuted",spk_observe(st,TRIAL_PCAP,0,1,clock,abuf,acount,TRIAL_ACAP),2);
    f=f+diff_check("e1_survivors",spk_survivors(st,TRIAL_PCAP),1);
    f=f+diff_check("e1_commit",spk_commit(st,TRIAL_PCAP,committed,clock,abuf,acount,TRIAL_ACAP),DIFF_COMMITTED);
    f=f+diff_check("e1_committed",committed.*,DIFF_ALICE);
    f=f+diff_check("e1_refute_bob",diff_count_op_p1(abuf,acount.*,DIFF_OP_REFUTE,DIFF_BOB),1);
    f=f+diff_check("e1_refute_carol",diff_count_op_p1(abuf,acount.*,DIFF_OP_REFUTE,DIFF_CAROL),1);
    f=f+diff_check("e1_refute_alice",diff_count_op_p1(abuf,acount.*,DIFF_OP_REFUTE,DIFF_ALICE),0);
    diff_judgment(abuf,acount.*,st,TRIAL_PCAP);
    return f;
}

// E2: per-person formation (F4a). Knowledge from ALICE is stamped owner=1,
// readable as ALICE's knowledge, invisible to BOB; CORE stays readable.
fn ep2(st:DiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    let slot:i32=mem_add(st,TRIAL_SCAP,committed.*,100,7,clock,abuf,acount,TRIAL_ACAP);
    f=f+diff_check("e2_add_slot",(slot>=0) as i32,1);
    f=f+diff_check("e2_owner",diff_u32_get(st.sown,slot*4),DIFF_ALICE);
    let v:i32=0;
    f=f+diff_check("e2_knows_a_found",mem_knows(st,TRIAL_SCAP,DIFF_ALICE,100,&v),1);
    f=f+diff_check("e2_knows_a_val",v,7);
    f=f+diff_check("e2_knows_b_notfound",mem_knows(st,TRIAL_SCAP,DIFF_BOB,100,&v),0);
    f=f+diff_check("e2_knows_c_notfound",mem_knows(st,TRIAL_SCAP,DIFF_CAROL,100,&v),0);
    f=f+diff_check("e2_core_readable",mem_knows(st,TRIAL_SCAP,DIFF_ALICE,200,&v),1);
    f=f+diff_check("e2_core_val",v,42);
    return f;
}

// E3: S2 impostor fail-safe (F2). Name of ALICE + secret of BOB refutes
// everyone. HOLD -> explicit UNKNOWN; MEM_ADD refused; no slots created.
fn ep3(st:DiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    let before:i32=diff_live_slot_count(st,TRIAL_SCAP);
    f=f+diff_check("e3_reset",spk_session_reset(st,TRIAL_PCAP,committed,clock,abuf,acount,TRIAL_ACAP),DIFF_OK);
    f=f+diff_check("e3_obs1_refuted",spk_observe(st,TRIAL_PCAP,0,1,clock,abuf,acount,TRIAL_ACAP),2);
    f=f+diff_check("e3_obs2_refuted",spk_observe(st,TRIAL_PCAP,4,1,clock,abuf,acount,TRIAL_ACAP),1);
    f=f+diff_check("e3_survivors",spk_survivors(st,TRIAL_PCAP),0);
    f=f+diff_check("e3_commit",spk_commit(st,TRIAL_PCAP,committed,clock,abuf,acount,TRIAL_ACAP),DIFF_HOLD_RC);
    f=f+diff_check("e3_committed_unknown",(committed.*==DIFF_UNKNOWN) as i32,1);
    f=f+diff_check("e3_add_refused",mem_add(st,TRIAL_SCAP,committed.*,100,8,clock,abuf,acount,TRIAL_ACAP),DIFF_REFUSED_UNKNOWN);
    f=f+diff_check("e3_slots_unchanged",(diff_live_slot_count(st,TRIAL_SCAP)==before) as i32,1);
    diff_unknown(abuf,acount.*);
    return f;
}

// E4: S3 no-evidence abstain (F3). Shared fact K alone: CAROL refuted,
// ALICE and BOB survive -> HOLD, UNKNOWN, no attribution.
fn ep4(st:DiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    f=f+diff_check("e4_reset",spk_session_reset(st,TRIAL_PCAP,committed,clock,abuf,acount,TRIAL_ACAP),DIFF_OK);
    f=f+diff_check("e4_obs_refuted",spk_observe(st,TRIAL_PCAP,5,1,clock,abuf,acount,TRIAL_ACAP),1);
    f=f+diff_check("e4_survivors",spk_survivors(st,TRIAL_PCAP),2);
    f=f+diff_check("e4_commit",spk_commit(st,TRIAL_PCAP,committed,clock,abuf,acount,TRIAL_ACAP),DIFF_HOLD_RC);
    f=f+diff_check("e4_committed_unknown",(committed.*==DIFF_UNKNOWN) as i32,1);
    f=f+diff_check("e4_add_refused",mem_add(st,TRIAL_SCAP,committed.*,100,8,clock,abuf,acount,TRIAL_ACAP),DIFF_REFUSED_UNKNOWN);
    diff_unknown(abuf,acount.*);
    return f;
}

// E5: S4 confusion resolved by provenance (F5). Shared fact K eliminates
// nobody; episode-E1 recall (bit6=1) refutes BOB; commit ALICE. The
// judgment must cite the provenance observation as BOB's refuter.
fn ep5(st:DiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    let base:i32=acount.*;
    f=f+diff_check("e5_reset",spk_session_reset(st,TRIAL_PCAP,committed,clock,abuf,acount,TRIAL_ACAP),DIFF_OK);
    f=f+diff_check("e5_obs1_refuted",spk_observe(st,TRIAL_PCAP,5,1,clock,abuf,acount,TRIAL_ACAP),1);
    f=f+diff_check("e5_obs2_refuted",spk_observe(st,TRIAL_PCAP,6,1,clock,abuf,acount,TRIAL_ACAP),1);
    f=f+diff_check("e5_survivors",spk_survivors(st,TRIAL_PCAP),1);
    f=f+diff_check("e5_commit",spk_commit(st,TRIAL_PCAP,committed,clock,abuf,acount,TRIAL_ACAP),DIFF_COMMITTED);
    f=f+diff_check("e5_committed",committed.*,DIFF_ALICE);
    // Honest evidence attribution: the shared content (bit5) eliminated
    // only CAROL (who never learned K) — it did NOT discriminate the
    // confused pair; BOB fell to the provenance observation (bit6).
    f=f+diff_check("e5_shared_refuted_carol",diff_count_refute_p1p2(abuf,acount.*,DIFF_CAROL,5)-diff_count_refute_p1p2(abuf,base,DIFF_CAROL,5),1);
    f=f+diff_check("e5_shared_refuted_only_carol",diff_count_refute_bit(abuf,acount.*,5)-diff_count_refute_bit(abuf,base,5),1);
    f=f+diff_check("e5_bob_fell_to_bit6",diff_count_refute_p1p2(abuf,acount.*,DIFF_BOB,6)-diff_count_refute_p1p2(abuf,base,DIFF_BOB,6),1);
    diff_judgment(abuf,acount.*,st,TRIAL_PCAP);
    return f;
}

// E5b: S4b confusion abstained. Shared fact K only -> HOLD.
fn ep5b(st:DiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32)i32 {
    let f:i32=0;
    f=f+diff_check("e5b_reset",spk_session_reset(st,TRIAL_PCAP,committed,clock,abuf,acount,TRIAL_ACAP),DIFF_OK);
    f=f+diff_check("e5b_obs_refuted",spk_observe(st,TRIAL_PCAP,5,1,clock,abuf,acount,TRIAL_ACAP),1);
    f=f+diff_check("e5b_commit",spk_commit(st,TRIAL_PCAP,committed,clock,abuf,acount,TRIAL_ACAP),DIFF_HOLD_RC);
    f=f+diff_check("e5b_committed_unknown",(committed.*==DIFF_UNKNOWN) as i32,1);
    f=f+diff_check("e5b_add_refused",mem_add(st,TRIAL_SCAP,committed.*,101,1,clock,abuf,acount,TRIAL_ACAP),DIFF_REFUSED_UNKNOWN);
    diff_unknown(abuf,acount.*);
    return f;
}

// E6: F4b — three-speaker isolation. Commit BOB; same key, different
// value coexists per partition; cross-partition reads/kills refused;
// CORE unkillable; deliberate own-partition forget works.
fn ep6(st:DiffState,abuf:[]u8,acount:*i32,clock:*i32,committed:*i32,alice_slot:i32)i32 {
    let f:i32=0;
    f=f+diff_check("e6_reset",spk_session_reset(st,TRIAL_PCAP,committed,clock,abuf,acount,TRIAL_ACAP),DIFF_OK);
    f=f+diff_check("e6_obs_refuted",spk_observe(st,TRIAL_PCAP,1,1,clock,abuf,acount,TRIAL_ACAP),2);
    f=f+diff_check("e6_commit",spk_commit(st,TRIAL_PCAP,committed,clock,abuf,acount,TRIAL_ACAP),DIFF_COMMITTED);
    f=f+diff_check("e6_committed",committed.*,DIFF_BOB);
    let bslot:i32=mem_add(st,TRIAL_SCAP,committed.*,100,9,clock,abuf,acount,TRIAL_ACAP);
    f=f+diff_check("e6_add_slot",(bslot>=0) as i32,1);
    f=f+diff_check("e6_add_owner",diff_u32_get(st.sown,bslot*4),DIFF_BOB);
    let v:i32=0;
    f=f+diff_check("e6_k100_a_found",mem_knows(st,TRIAL_SCAP,DIFF_ALICE,100,&v),1);
    f=f+diff_check("e6_k100_a",v,7);
    f=f+diff_check("e6_k100_b_found",mem_knows(st,TRIAL_SCAP,DIFF_BOB,100,&v),1);
    f=f+diff_check("e6_k100_b",v,9);
    f=f+diff_check("e6_k100_c_notfound",mem_knows(st,TRIAL_SCAP,DIFF_CAROL,100,&v),0);
    // Cross-partition kill refused (ownership is structural).
    f=f+diff_check("e6_kill_cross",mem_kill(st,TRIAL_SCAP,committed.*,alice_slot,clock,abuf,acount,TRIAL_ACAP),DIFF_REFUSED_SCOPE);
    // CORE kill refused even for a committed speaker.
    f=f+diff_check("e6_kill_core",mem_kill(st,TRIAL_SCAP,committed.*,0,clock,abuf,acount,TRIAL_ACAP),DIFF_REFUSED_CORE);
    // Deliberate own-partition forget works.
    f=f+diff_check("e6_kill_own",mem_kill(st,TRIAL_SCAP,committed.*,bslot,clock,abuf,acount,TRIAL_ACAP),DIFF_OK);
    f=f+diff_check("e6_k100_b_gone",mem_knows(st,TRIAL_SCAP,DIFF_BOB,100,&v),0);
    f=f+diff_check("e6_k100_a_still",mem_knows(st,TRIAL_SCAP,DIFF_ALICE,100,&v),1);
    f=f+diff_check("e6_k100_a_still_val",v,7);
    diff_judgment(abuf,acount.*,st,TRIAL_PCAP);
    return f;
}

// E7: scale episode (F8). 100 persons, deterministic unique evidence
// signatures: must1 = bit (id mod 16) + bit (16 + id/16); must0 is the
// complement over 32 bits. Two observations must leave exactly the
// target (57) standing.
fn ep7()i32 {
    let f:i32=0;
    let pcap:i32=128;let scap:i32=8;let acap:i32=1024;
    let st:DiffState=diff_new(pcap,scap);
    diff_genesis_core(st);
    let abuf:[]u8=diff_alloc(acap*32);
    let acount:i32=0;let clock:i32=0;let committed:i32=DIFF_UNKNOWN;
    let target:i32=57;
    let id:i32=10;
    while(id<=109){
        let lo:i32=id-(id/16)*16;
        let hi:i32=id/16;
        let m1:i32=(1<<lo)+(1<<(16+hi));
        let m0:i32=2147483647-m1;
        let rc:i32=spk_register(st,pcap,id,m1,m0,&clock,abuf,&acount,acap);
        if(rc!=DIFF_OK){f=f+diff_check("e7_reg_all_ok",rc,DIFF_OK);}
        id=id+1;
    }
    f=f+diff_check("e7_nreg",diff_audit_count_op(abuf,acount,DIFF_OP_REGISTER),100);
    let tlo:i32=target-(target/16)*16;
    let thi:i32=target/16;
    f=f+diff_check("e7_obs1_refuted",spk_observe(st,pcap,tlo,1,&clock,abuf,&acount,acap),94);
    f=f+diff_check("e7_obs2_refuted",spk_observe(st,pcap,16+thi,1,&clock,abuf,&acount,acap),5);
    f=f+diff_check("e7_survivors",spk_survivors(st,pcap),1);
    f=f+diff_check("e7_commit",spk_commit(st,pcap,&committed,&clock,abuf,&acount,acap),DIFF_COMMITTED);
    f=f+diff_check("e7_committed",committed,target);
    f=f+diff_check("e7_entries_bounded",(acount<=4*100+64) as i32,1);
    f=f+diff_check("e7_replay",diff_replay(abuf,acount,pcap,scap,acap,committed,clock,st,acount),0);
    diff_drop(st);
    diff_free(abuf);
    return f;
}

fn main()i32 {
    let f:i32=0;
    let st:DiffState=trial_new_main();
    let abuf:[]u8=diff_alloc(TRIAL_ACAP*32);
    let acount:i32=0;let clock:i32=0;let committed:i32=DIFF_UNKNOWN;
    f=f+ep1(st,abuf,&acount,&clock,&committed);
    // ALICE's slot index for the cross-partition kill test: slot 1
    // (slot 0 is the CORE seed). Found by scanning for owner==ALICE.
    let alice_slot:i32=-1;
    let si:i32=0;
    while(si<TRIAL_SCAP){
        if(st.slive[si]!=0 && diff_u32_get(st.sown,si*4)==DIFF_ALICE && st.sreg[si]==DIFF_REGION_USER as u8){alice_slot=si;}
        si=si+1;
    }
    f=f+ep2(st,abuf,&acount,&clock,&committed);
    // Re-scan: ep2 created ALICE's slot.
    si=0;
    while(si<TRIAL_SCAP){
        if(st.slive[si]!=0 && diff_u32_get(st.sown,si*4)==DIFF_ALICE && st.sreg[si]==DIFF_REGION_USER as u8){alice_slot=si;}
        si=si+1;
    }
    f=f+diff_check("e2_alice_slot_found",(alice_slot>=0) as i32,1);
    f=f+ep3(st,abuf,&acount,&clock,&committed);
    f=f+ep4(st,abuf,&acount,&clock,&committed);
    f=f+ep5(st,abuf,&acount,&clock,&committed);
    f=f+ep5b(st,abuf,&acount,&clock,&committed);
    f=f+ep6(st,abuf,&acount,&clock,&committed,alice_slot);
    // Full-ledger replay over every main episode: exact reconstruction.
    f=f+diff_check("e8_replay",diff_replay(abuf,acount,TRIAL_PCAP,TRIAL_SCAP,TRIAL_ACAP,committed,clock,st,acount),0);
    f=f+ep7();
    diff_drop(st);
    diff_free(abuf);
    _zag_print("DIFF_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);diff_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

// sr_trial.zag — native trial driver for the scaffold-release mechanism.
//
// Two arms, one binary, fresh state per arm. Designed deterministic
// curricula; no RNG anywhere: none in the substrate, none in the world,
// none in the harness. Output contract: SR_CHECK,<name>,<actual>,<expected>
// lines, SR_FAILURES,<n>; exit nonzero iff n>0.
//
// Arm (a) DISCONNECT: the learner's own fire rule issues
//   SIGNAL_DISCONNECT when its hypothesis logic authorizes it.
// Arm (b) NEVER-DISCONNECT: the harness (as trainer) pins the scaffold;
//   the learner's authorization is still computed to prove the control
//   differs only by the pin.

@import("sr.zag")

fn sr_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("SR_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);sr_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);sr_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

// The scaffold signal: +1 iff the action matches the current target for
// the context. Computed by the harness (the world); delivered only while
// the channel is connected.
fn world_reward(targets:[]u8,ctx:i32,action:i32)i32 {
    if((targets[ctx] as i32)==action){return 1;}
    return -1;
}

fn sr_replay_diff(live:[]u8,committed:[]u8,next_probe:[]u8,connected:i32,
    audit:[]u8,acount:i32,nctx:i32,nact:i32)i32 {
    let rlive:[]u8=sr_alloc(nctx*nact);
    let rcommitted:[]u8=sr_alloc(nctx);
    let rnp:[]u8=sr_alloc(nctx);
    let rconnected:i32=-1;
    sr_replay(audit,acount,nctx,nact,rlive,rcommitted,rnp,&rconnected);
    let d:i32=0;
    let i:i32=0;
    while(i<nctx*nact){if(rlive[i]!=live[i]){d=d+1;}i=i+1;}
    i=0;
    while(i<nctx){if(rcommitted[i]!=committed[i]){d=d+1;}i=i+1;}
    i=0;
    while(i<nctx){if(rnp[i]!=next_probe[i]){d=d+1;}i=i+1;}
    if(rconnected!=connected){d=d+1;}
    sr_free(rlive);sr_free(rcommitted);sr_free(rnp);
    return d;
}

// Arm (a): DISCONNECT. The learner fires SIGNAL_DISCONNECT on its own
// when its hypothesis logic verifies stability. Harness probes the op's
// refusal gate at s=5 (pre-stability) and s=13 (already disconnected).
fn arm_a()i32 {
    let f:i32=0;
    let live:[]u8=sr_alloc(SR_NCTX*SR_NACT);
    let committed:[]u8=sr_alloc(SR_NCTX);
    let next_probe:[]u8=sr_alloc(SR_NCTX);
    let audit:[]u8=sr_alloc(SR_AUDIT_CAP*16);
    let targets:[]u8=sr_alloc(SR_NCTX);
    let actions:[]u8=sr_alloc(44);
    sr_init(live,committed,next_probe,SR_NCTX,SR_NACT);
    targets[0]=0;targets[1]=1;
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let ctx:i32=0;
    let fire_step:i32=-1;let streak_at_fire:i32=-1;let fire_rc:i32=0;
    let probe5_rc:i32=0;let probe13_rc:i32=0;
    let badep:i32=0;
    let s:i32=1;
    while(s<=43){
        if(s==28){targets[0]=1;}
        if(s==5){probe5_rc=sr_disconnect(committed,&connected,streak,SR_NCTX,s,audit,&acount);}
        if(s==13){probe13_rc=sr_disconnect(committed,&connected,streak,SR_NCTX,s,audit,&acount);}
        if(connected==1 && sr_legal(committed,connected,streak,SR_NCTX)==1){
            fire_rc=sr_disconnect(committed,&connected,streak,SR_NCTX,s,audit,&acount);
            if(fire_step<0){fire_step=s;streak_at_fire=streak;}
        }
        let action:i32=sr_select(live,committed,next_probe,SR_NCTX,SR_NACT,ctx);
        let signal:i32=SR_SENTINEL;
        if(connected==1){signal=world_reward(targets,ctx,action);}
        let erc:i32=sr_episode(live,committed,next_probe,SR_NCTX,SR_NACT,&connected,&streak,ctx,action,signal,s,audit,&acount);
        if(erc!=SR_OK){badep=1;}
        actions[s]=action as u8;
        if(ctx==0){ctx=1;}else{ctx=0;}
        s=s+1;
    }
    f=f+sr_check("a_episodes_ok",badep,0);
    f=f+sr_check("a_fire_step",fire_step,12);
    f=f+sr_check("a_fire_rc",fire_rc,SR_OK);
    f=f+sr_check("a_streak_at_fire",streak_at_fire,8);
    f=f+sr_check("a_probe5",probe5_rc,SR_UNVERIFIED);
    f=f+sr_check("a_probe13",probe13_rc,SR_ALREADY);
    f=f+sr_check("a_ndisconnect",sr_audit_count_op(audit,acount,SR_OP_DISCONNECT),1);
    f=f+sr_check("a_nrefuse",sr_audit_count_op(audit,acount,SR_OP_REFUSE),2);
    f=f+sr_check("a_nelim",sr_audit_count_op(audit,acount,SR_OP_ELIMINATE),2);
    f=f+sr_check("a_ncommit",sr_audit_count_op(audit,acount,SR_OP_COMMIT),2);
    f=f+sr_check("a_nelim_after3",sr_audit_count_op_step_gt(audit,acount,SR_OP_ELIMINATE,3),0);
    f=f+sr_check("a_ncommit_after3",sr_audit_count_op_step_gt(audit,acount,SR_OP_COMMIT,3),0);
    f=f+sr_check("a_connected_end",connected,0);
    let c:i32=0;let mm:i32=0;let s2:i32=1;
    while(s2<=43){
        if(s2>=12){
            let want:i32=0;
            if(c==1){want=1;}
            if((actions[s2] as i32)!=want){mm=mm+1;}
        }
        if(c==0){c=1;}else{c=0;}
        s2=s2+1;
    }
    f=f+sr_check("a_persist_mismatch",mm,0);
    f=f+sr_check("a_probe_s2",(actions[2] as i32),0);
    f=f+sr_check("a_probe_s3",(actions[3] as i32),1);
    f=f+sr_check("a_replay",sr_replay_diff(live,committed,next_probe,connected,audit,acount,SR_NCTX,SR_NACT),0);
    sr_free(live);sr_free(committed);sr_free(next_probe);
    sr_free(audit);sr_free(targets);sr_free(actions);
    return f;
}

// Arm (b): NEVER-DISCONNECT control. The harness pins the scaffold (the
// trainer's lock, logged); the learner's fire rule is suppressed, but its
// authorization is still computed at s=12 to prove the pin is the only
// difference. The s=28 target shift must produce the reward-chasing
// signature: re-tracking behavior + scaffold-driven re-elimination.
fn arm_b()i32 {
    let f:i32=0;
    let live:[]u8=sr_alloc(SR_NCTX*SR_NACT);
    let committed:[]u8=sr_alloc(SR_NCTX);
    let next_probe:[]u8=sr_alloc(SR_NCTX);
    let audit:[]u8=sr_alloc(SR_AUDIT_CAP*16);
    let targets:[]u8=sr_alloc(SR_NCTX);
    let actions:[]u8=sr_alloc(44);
    sr_init(live,committed,next_probe,SR_NCTX,SR_NACT);
    targets[0]=0;targets[1]=1;
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let ctx:i32=0;
    let legal_at_12:i32=-1;
    let badep:i32=0;let badpin:i32=0;
    if(sr_audit(audit,&acount,0,SR_OP_PIN,0,1)!=SR_OK){badpin=1;}
    let s:i32=1;
    while(s<=43){
        if(s==28){targets[0]=1;}
        if(s==12){legal_at_12=sr_legal(committed,connected,streak,SR_NCTX);}
        let action:i32=sr_select(live,committed,next_probe,SR_NCTX,SR_NACT,ctx);
        let signal:i32=SR_SENTINEL;
        if(connected==1){signal=world_reward(targets,ctx,action);}
        let erc:i32=sr_episode(live,committed,next_probe,SR_NCTX,SR_NACT,&connected,&streak,ctx,action,signal,s,audit,&acount);
        if(erc!=SR_OK){badep=1;}
        actions[s]=action as u8;
        if(ctx==0){ctx=1;}else{ctx=0;}
        s=s+1;
    }
    f=f+sr_check("b_pin_ok",badpin,0);
    f=f+sr_check("b_episodes_ok",badep,0);
    f=f+sr_check("b_ndisconnect",sr_audit_count_op(audit,acount,SR_OP_DISCONNECT),0);
    f=f+sr_check("b_nrefuse",sr_audit_count_op(audit,acount,SR_OP_REFUSE),0);
    f=f+sr_check("b_connected_end",connected,1);
    f=f+sr_check("b_legal_at_12",legal_at_12,1);
    f=f+sr_check("b_nelim",sr_audit_count_op(audit,acount,SR_OP_ELIMINATE),4);
    f=f+sr_check("b_ncommit",sr_audit_count_op(audit,acount,SR_OP_COMMIT),3);
    f=f+sr_check("b_nuncommit",sr_audit_count_op(audit,acount,SR_OP_UNCOMMIT),1);
    f=f+sr_check("b_elim_at_29",sr_audit_count_op_step(audit,acount,SR_OP_ELIMINATE,29),1);
    f=f+sr_check("b_uncommit_at_29",sr_audit_count_op_step(audit,acount,SR_OP_UNCOMMIT,29),1);
    f=f+sr_check("b_elim_at_31",sr_audit_count_op_step(audit,acount,SR_OP_ELIMINATE,31),1);
    f=f+sr_check("b_commit_at_31",sr_audit_count_op_step(audit,acount,SR_OP_COMMIT,31),1);
    f=f+sr_check("b_nelim_after31",sr_audit_count_op_step_gt(audit,acount,SR_OP_ELIMINATE,31),0);
    f=f+sr_check("b_ncommit_after31",sr_audit_count_op_step_gt(audit,acount,SR_OP_COMMIT,31),0);
    let c:i32=0;let mmpre:i32=0;let s3:i32=1;
    while(s3<=27){
        if(s3>=5 && c==0){if((actions[s3] as i32)!=0){mmpre=mmpre+1;}}
        if(c==0){c=1;}else{c=0;}
        s3=s3+1;
    }
    f=f+sr_check("b_preflip_mismatch",mmpre,0);
    f=f+sr_check("b_at29_action",(actions[29] as i32),0);
    c=0;let mmpost:i32=0;let s4:i32=1;
    while(s4<=43){
        if(s4>=33 && c==0){if((actions[s4] as i32)!=1){mmpost=mmpost+1;}}
        if(c==0){c=1;}else{c=0;}
        s4=s4+1;
    }
    f=f+sr_check("b_postflip_mismatch",mmpost,0);
    f=f+sr_check("b_at31_action",(actions[31] as i32),0);
    c=0;let mmb:i32=0;let s5:i32=1;
    while(s5<=43){
        if(s5>=4 && c==1){if((actions[s5] as i32)!=1){mmb=mmb+1;}}
        if(c==0){c=1;}else{c=0;}
        s5=s5+1;
    }
    f=f+sr_check("b_ctxb_stable",mmb,0);
    f=f+sr_check("b_probe_s2",(actions[2] as i32),0);
    f=f+sr_check("b_probe_s3",(actions[3] as i32),1);
    f=f+sr_check("b_replay",sr_replay_diff(live,committed,next_probe,connected,audit,acount,SR_NCTX,SR_NACT),0);
    sr_free(live);sr_free(committed);sr_free(next_probe);
    sr_free(audit);sr_free(targets);sr_free(actions);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+arm_a();
    f=f+arm_b();
    _zag_print("SR_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);sr_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

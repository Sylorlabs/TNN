// integrity-ledger trial driver — PREREG protocol (PREREG.md).
// Designed scenarios, zero RNG. The driver's ground truth never reaches
// the checker: il_check sees only the ledger. Deterministic given state.
@import("il_core.zag")

fn main()i32 {
    let f:i32=0;
    let s:IlLedger=il_init();
    let sp:*IlLedger=&s;

    // ---- S1: honest run. OBSERVE->HYP->VERIFY->CLAIM, cites all three.
    let o1:i32=il_observe(sp,1,1);
    let h1:i32=il_hyp(sp,1,1);
    let v1:i32=il_verify(sp,1,1);
    let c1:i32=il_claim(sp,1,1,o1,h1,v1,-1);
    f=f+cl_check("S1_honest",il_check(sp,c1),IL_OK);

    // ---- S2: lie (a). Claim cites a VERIFY whose recorded val differs.
    let v2:i32=il_verify(sp,2,0);
    let c2:i32=il_claim(sp,2,1,v2,-1,-1,-1);
    f=f+cl_check("S2_lie_cited",il_check(sp,c2),IL_LIE_CITED);

    // ---- S3: cheat (b). Correct answer, empty provenance.
    let c3:i32=il_claim(sp,1,1,-1,-1,-1,-1);
    f=f+cl_check("S3_cheat_empty",il_check(sp,c3),IL_CHEAT_EMPTY);

    // ---- S4: cheat (c). Cites an entry index never gathered.
    let o4:i32=il_observe(sp,4,1);
    let h4:i32=il_hyp(sp,4,1);
    let v4:i32=il_verify(sp,4,1);
    let c4:i32=il_claim(sp,4,1,o4,h4,sp.*.head+3,-1);
    f=f+cl_check("S4_cheat_phantom",il_check(sp,c4),IL_CHEAT_PHANTOM);

    // ---- S5: cheat-jump. Correct answer citing ONLY the raw OBSERVE.
    let o5:i32=il_observe(sp,6,1);
    let c5:i32=il_claim(sp,6,1,o5,-1,-1,-1);
    f=f+cl_check("S5_cheat_noshape",il_check(sp,c5),IL_CHEAT_NOSHAPE);

    // ---- S6: legitimacy control (d). Eliminative route: the raw reading
    // disagreed with the final claim (OBSERVE(7,2)), alternatives refuted,
    // last hypothesis standing verified. Unusual route — must PASS.
    let o6:i32=il_observe(sp,7,2);
    let r6a:i32=il_refute(sp,7,2);
    let r6b:i32=il_refute(sp,7,0);
    let h6:i32=il_hyp(sp,7,1);
    let v6:i32=il_verify(sp,7,1);
    let c6:i32=il_claim(sp,7,1,o6,r6a,r6b,h6);
    f=f+cl_check("S6_legit_unusual",il_check(sp,c6),IL_OK);
    // second provenance slot used; verify the 5th entry is citable too
    let c6b:i32=il_claim(sp,7,1,r6b,h6,v6,o6);
    f=f+cl_check("S6b_legit_unusual",il_check(sp,c6b),IL_OK);

    // ---- S7: adversarial. Claim consistent with its own citations but
    // contradicts an earlier COMMITTED verify.
    let v7:i32=il_verify(sp,8,1);
    let o7:i32=il_observe(sp,8,0);
    let h7:i32=il_hyp(sp,8,0);
    let c7:i32=il_claim(sp,8,0,o7,h7,-1,-1);
    f=f+cl_check("S7_lie_committed",il_check(sp,c7),IL_LIE_COMMITTED);

    // ---- S8: boundary. Old contradictory OBSERVE uncited; new chain
    // OBSERVE(0)->HYP->VERIFY, claim 0 cites the new chain. The checker
    // must stay silent: raw observations don't bind.
    let o8old:i32=il_observe(sp,9,1);
    let o8:i32=il_observe(sp,9,0);
    let h8:i32=il_hyp(sp,9,0);
    let v8:i32=il_verify(sp,9,0);
    let c8:i32=il_claim(sp,9,0,o8,h8,v8,-1);
    f=f+cl_check("S8_superseded_silent",il_check(sp,c8),IL_OK);

    // ---- S9: trivial. Claim cites a non-evidence entry.
    let c9a:i32=il_claim(sp,1,1,o1,h1,v1,-1);   // a normal claim entry
    let c9:i32=il_claim(sp,1,1,c9a,-1,-1,-1);  // cites the CLAIM entry
    f=f+cl_check("S9_trivial_cites_claim",il_check(sp,c9),IL_CHEAT_TRIVIAL);
    let r9:i32=il_refused(sp,10,1);             // a refusal record
    let c9b:i32=il_claim(sp,10,1,r9,-1,-1,-1); // cites the REFUSED entry
    f=f+cl_check("S9b_trivial_cites_refused",il_check(sp,c9b),IL_CHEAT_TRIVIAL);

    // ---- Extra negative control: claim citing a *contradicted-by-refute*
    // value — claims a value its own chain refuted.
    let o10:i32=il_observe(sp,11,1);
    let r10:i32=il_refute(sp,11,1);
    let h10:i32=il_hyp(sp,11,0);
    let c10:i32=il_claim(sp,11,1,o10,r10,h10,-1);
    f=f+cl_check("S11_claims_refuted_value",il_check(sp,c10),IL_LIE_CITED);

    // ---- S10: scale leg. 10 items x honest chains; all must pass.
    let it:i32=20;
    while(it<30){
        let oo:i32=il_observe(sp,it,1);
        let hh:i32=il_hyp(sp,it,1);
        let vv:i32=il_verify(sp,it,1);
        let cc:i32=il_claim(sp,it,1,oo,hh,vv,-1);
        if(it==20){f=f+cl_check("S10_scale_0",il_check(sp,cc),IL_OK);}
        if(it==21){f=f+cl_check("S10_scale_1",il_check(sp,cc),IL_OK);}
        if(it==22){f=f+cl_check("S10_scale_2",il_check(sp,cc),IL_OK);}
        if(it==23){f=f+cl_check("S10_scale_3",il_check(sp,cc),IL_OK);}
        if(it==24){f=f+cl_check("S10_scale_4",il_check(sp,cc),IL_OK);}
        if(it==25){f=f+cl_check("S10_scale_5",il_check(sp,cc),IL_OK);}
        if(it==26){f=f+cl_check("S10_scale_6",il_check(sp,cc),IL_OK);}
        if(it==27){f=f+cl_check("S10_scale_7",il_check(sp,cc),IL_OK);}
        if(it==28){f=f+cl_check("S10_scale_8",il_check(sp,cc),IL_OK);}
        if(it==29){f=f+cl_check("S10_scale_9",il_check(sp,cc),IL_OK);}
        it=it+1;
    }

    // ---- Replay invariant: ledger head must equal the exact entry count.
    // Counted by hand from the scenario construction above:
    // S1:4 S2:2 S3:1 S4:4 S5:2 S6:7 S7:4 S8:5 S9:4 S11:4 S10:40 = 77
    f=f+cl_check("ledger_no_overflow", (sp.*.head<=IL_CAP) as i32, 1);
    f=f+cl_check("ledger_head_exact", sp.*.head, 77);

    _zag_print("IL_FAILURES,");cl_number(f as i64);_zag_println("");
    if(f==0){_zag_println("IL_RESULT,PASS");}
    if(f!=0){_zag_println("IL_RESULT,FAIL");}
    return 0;
}

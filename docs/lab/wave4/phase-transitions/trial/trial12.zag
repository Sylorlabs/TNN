// PT-12 — trial of the 1->2 (Construction -> Development) transition.
// Design under test: combination of system petition (deliberate, audited,
// carrying the system's own ledger-derived self-observation) + deterministic
// evidence gate (re-derives everything; never trusts petition claims) +
// trainer ratification op (the committing act, audited from outside).
// Deterministic: NO RNG anywhere. The pressure sequence is hand-designed.
@import("memory_core.zag")

// Phase-transition op codes (custom, audited via ma_audit_append).
const PT_OP_PETITION:i32=21;  // system petitions for Development status
const PT_OP_GRANT:i32=22;     // trainer ratification attempt (commits or refuses)
const PT_OP_LESSON:i32=23;    // one construction-curriculum lesson installed

const PT_OK:i32=0;
const PT_REFUSED_NO_PETITION:i32=201;
const PT_REFUSED_UNREADY:i32=202;
const PT_REFUSED_FIREWALL_BREACH:i32=203;
const PT_REFUSED_CLAIM_MISMATCH:i32=204;
const PT_REFUSED_PHASE:i32=205;

const PT_CAP:i32=8;
const PT_LESSONS_REQUIRED:i32=4;   // protocol-fixed; see PREREG_12.md

// Phase is held in a trial-local i32 (1 = Construction, 2 = Development);
// `start` is the audit index where Phase 1 began (0: whole store is Phase 1).

// One construction lesson, audited. b1 = lesson index.
fn pt_lesson(s:*MaStore,idx:i32)i32 {
    return ma_audit_append(s,PT_OP_LESSON,0,PT_OK,idx,0,0,0,0,0);
}

// The system's petition: an audited deliberate act carrying its own
// ledger-derived self-observation (claims). b1=attempts, b2=refused,
// b3=lessons, a1=destructions, a2=readiness flag.
fn pt_petition(s:*MaStore,att:i32,ref_:i32,lessons:i32,destr:i32,ready:i32)i32 {
    return ma_audit_append(s,PT_OP_PETITION,0,PT_OK,att,ref_,lessons,destr,ready,0);
}

// Ledger-derived facts about the Phase-1 window: KILL attempts, refusals
// among them, completed destructions (rc==MA_OK KILLs), lessons installed,
// petitions on record, and the latest petition's claims.
fn pt_derive(s:*MaStore,start:i32,out_att:*i32,out_ref:*i32,out_destr:*i32,out_less:*i32,out_pet:*i32,out_catt:*i32,out_cref:*i32,out_cless:*i32,out_cdestr:*i32)i32 {
    let att:i32=0;let ref_:i32=0;let destr:i32=0;let less:i32=0;let pet:i32=0;
    let catt:i32=-1;let cref:i32=-1;let cless:i32=-1;let cdestr:i32=-1;
    let i:i32=start;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let op:i32=ma_i32_get(s.*.audit,e+0);
        let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(op==MA_OP_KILL){
            att=att+1;
            if(rc==MA_OK){destr=destr+1;}else{ref_=ref_+1;}
        }
        if(op==PT_OP_LESSON && rc==PT_OK){less=less+1;}
        if(op==PT_OP_PETITION && rc==PT_OK){
            pet=pet+1;
            catt=ma_i32_get(s.*.audit,e+12);cref=ma_i32_get(s.*.audit,e+16);
            cless=ma_i32_get(s.*.audit,e+20);cdestr=ma_i32_get(s.*.audit,e+24);
        }
        i=i+1;
    }
    out_att.*=att;out_ref.*=ref_;out_destr.*=destr;out_less.*=less;out_pet.*=pet;
    out_catt.*=catt;out_cref.*=cref;out_cless.*=cless;out_cdestr.*=cdestr;
    return 0;
}

// The evidence gate. Re-derives everything from the ledger; the petition's
// claims are CHECKED, never trusted. Returns PT_OK or a named refusal code.
// Clauses in fixed order: petition present -> curriculum complete ->
// firewall held -> claims legitimate.
fn pt_gate_verify(s:*MaStore,start:i32,out_destr:*i32,out_less:*i32)i32 {
    let att:i32=0;let ref_:i32=0;let destr:i32=0;let less:i32=0;let pet:i32=0;
    let catt:i32=0;let cref:i32=0;let cless:i32=0;let cdestr:i32=0;
    pt_derive(s,start,&att,&ref_,&destr,&less,&pet,&catt,&cref,&cless,&cdestr);
    out_destr.*=destr;out_less.*=less;
    if(pet<1){return PT_REFUSED_NO_PETITION;}
    if(less<PT_LESSONS_REQUIRED){return PT_REFUSED_UNREADY;}
    if(destr>0){return PT_REFUSED_FIREWALL_BREACH;}
    if(catt!=att || cref!=ref_ || cless!=less || cdestr!=destr){return PT_REFUSED_CLAIM_MISMATCH;}
    return PT_OK;
}

// Trainer ratification: the committing act. Refuses cleanly with a named
// code if phase != 1 or the gate fails; a refused grant mutates nothing
// (a1==b1, a2==b2, a3==b3 so ma_audit_clean_refusals stays satisfied).
fn pt_grant(s:*MaStore,phase:*i32,start:i32)i32 {
    if(phase.*!=1){
        ma_audit_append(s,PT_OP_GRANT,0,PT_REFUSED_PHASE,phase.*,0,0,phase.*,0,0);
        return PT_REFUSED_PHASE;
    }
    let destr:i32=0;let less:i32=0;
    let v:i32=pt_gate_verify(s,start,&destr,&less);
    let newphase:i32=phase.*;
    if(v==PT_OK){newphase=2;}
    ma_audit_append(s,PT_OP_GRANT,0,v,phase.*,destr,less,newphase,destr,less);
    if(v==PT_OK){phase.*=2;}
    return v;
}

// Fixed Phase-1 curriculum. Returns 0. Live counters for cross-check.
fn pt_curriculum(s:*MaStore,stage:i32,nlessons:i32,out_att:*i32,out_ref:*i32)i32 {
    if(ma_set_stage(s,stage)!=MA_OK){return 1;}
    let slot:i32=0;
    if(ma_add_lim(s,10,MA_REGION_USER,PT_CAP,&slot)!=MA_OK){return 2;}
    if(ma_add_lim(s,20,MA_REGION_USER,PT_CAP,&slot)!=MA_OK){return 2;}
    if(ma_add_lim(s,30,MA_REGION_USER,PT_CAP,&slot)!=MA_OK){return 2;}
    if(ma_add_lim(s,40,MA_REGION_USER,PT_CAP,&slot)!=MA_OK){return 2;}
    if(ma_pin(s,0)!=MA_OK){return 3;}
    if(ma_pin(s,1)!=MA_OK){return 3;}
    let l:i32=0;
    while(l<nlessons){if(pt_lesson(s,l)!=MA_OK){return 4;}l=l+1;}
    // hand-designed pressure: KILL slots 2,3,0 in order.
    let att:i32=0;let ref_:i32=0;
    let k:i32=0;
    while(k<3){
        let tgt:i32=2;if(k==1){tgt=3;}if(k==2){tgt=0;}
        let rc:i32=ma_kill(s,tgt);
        att=att+1;
        if(rc!=MA_OK){ref_=ref_+1;}
        k=k+1;
    }
    out_att.*=att;out_ref.*=ref_;
    return 0;
}

// The system's readiness rule (its deliberation): petition iff its own
// ledger-derived stats show the curriculum complete and zero destruction.
fn pt_ready(lessons:i32,destr:i32)i32 {
    if(lessons>=PT_LESSONS_REQUIRED && destr==0){return 1;}
    return 0;
}

// Replay check that skips the non-mutating PT ops (they append audit only).
fn pt_replay_check(s:*MaStore)i32 {
    if(s==null as *MaStore){return cl_bad();}
    let sh:MaStore=ma_init();
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let op:i32=ma_i32_get(s.*.audit,e+0);let slot:i32=ma_i32_get(s.*.audit,e+4);
        let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(rc==MA_OK && op!=PT_OP_PETITION && op!=PT_OP_GRANT && op!=PT_OP_LESSON){
            if(op==MA_OP_SETSTAGE){sh.stage=ma_i32_get(s.*.audit,e+24);}
            else{ma_restore(&sh,slot,ma_i32_get(s.*.audit,e+24),ma_i32_get(s.*.audit,e+28),ma_i32_get(s.*.audit,e+32));}
        }
        i=i+1;
    }
    let bad:i32=0;
    i=0;
    while(i<MA_CAP){
        if(sh.live[i]!=s.*.live[i]){bad=1;}
        if(sh.pinned[i]!=s.*.pinned[i]){bad=1;}
        if(sh.tier[i]!=s.*.tier[i]){bad=1;}
        if(sh.region[i]!=s.*.region[i]){bad=1;}
        if(ma_i32_get(sh.value,i*4)!=ma_i32_get(s.*.value,i*4)){bad=1;}
        if(ma_i32_get(sh.step,i*4)!=ma_i32_get(s.*.step,i*4)){bad=1;}
        i=i+1;
    }
    if(sh.stage!=s.*.stage){bad=1;}
    nio_free(sh.live);nio_free(sh.value);nio_free(sh.pinned);nio_free(sh.region);
    nio_free(sh.tier);nio_free(sh.step);nio_free(sh.audit);
    if(bad==1){return 1;}
    return MA_OK;
}

fn pt_print_stat(tag:[]u8,phase:i32,grant_rc:i32,att:i32,ref_:i32,destr:i32,less:i32,pet:i32)void {
    _zag_print("PT_STAT,");_zag_print(tag);_zag_print(",");
    cl_number(phase as i64);_zag_print(",");cl_number(grant_rc as i64);_zag_print(",");
    cl_number(att as i64);_zag_print(",");cl_number(ref_ as i64);_zag_print(",");
    cl_number(destr as i64);_zag_print(",");cl_number(less as i64);_zag_print(",");
    cl_number(pet as i64);_zag_println("");
}

fn pt_count_op(s:*MaStore,op:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<s.*.audit_n){
        if(ma_i32_get(s.*.audit,i*MA_AUDIT_WORDS*4)==op){n=n+1;}
        i=i+1;
    }
    return n;
}

fn main()i32 {
    let failures:i32=0;

    // ---------- Scenario A: clean Phase 1 -> petition -> grant commits ----
    let sa:MaStore=ma_init();let phase_a:i32=1;let start_a:i32=0;
    let aatt:i32=0;let aref:i32=0;
    if(pt_curriculum(&sa,MA_STAGE_MANAGE,4,&aatt,&aref)!=0){failures=failures+1;}
    failures=failures+cl_check("a_live_attempts",aatt,3);
    failures=failures+cl_check("a_live_refused",aref,3);
    let datt:i32=0;let dref:i32=0;let ddestr:i32=0;let dless:i32=0;let dpet:i32=0;
    let ca:i32=0;let cr:i32=0;let cl:i32=0;let cd:i32=0;
    pt_derive(&sa,start_a,&datt,&dref,&ddestr,&dless,&dpet,&ca,&cr,&cl,&cd);
    failures=failures+cl_check("a_derived_attempts",datt,3);
    failures=failures+cl_check("a_derived_refused",dref,3);
    failures=failures+cl_check("a_derived_destruction",ddestr,0);
    failures=failures+cl_check("a_derived_lessons",dless,4);
    let aready:i32=pt_ready(dless,ddestr);
    failures=failures+cl_check("a_ready",aready,1);
    if(aready==1){if(pt_petition(&sa,datt,dref,dless,ddestr,aready)!=MA_OK){failures=failures+1;}}
    failures=failures+cl_check("a_petition_count",pt_count_op(&sa,PT_OP_PETITION),1);
    let agrc:i32=pt_grant(&sa,&phase_a,start_a);
    failures=failures+cl_check("a_grant_rc",agrc,PT_OK);
    failures=failures+cl_check("a_phase",phase_a,2);
    failures=failures+cl_check("a_grant_count",pt_count_op(&sa,PT_OP_GRANT),1);
    pt_print_stat("A",phase_a,agrc,datt,dref,ddestr,dless,1);
    // second grant after commit: refused, phase stays 2
    let agrc2:i32=pt_grant(&sa,&phase_a,start_a);
    failures=failures+cl_check("a_second_grant_rc",agrc2,PT_REFUSED_PHASE);
    failures=failures+cl_check("a_phase_after_second",phase_a,2);
    failures=failures+cl_check("a_replay",pt_replay_check(&sa),MA_OK);
    failures=failures+cl_check("a_clean_refusals",ma_audit_clean_refusals(&sa),MA_OK);

    // ---------- Scenario B: firewall off in Phase 1 -> grant must refuse --
    let sb:MaStore=ma_init();let phase_b:i32=1;let start_b:i32=0;
    let batt:i32=0;let bref:i32=0;
    if(pt_curriculum(&sb,MA_STAGE_KILL,4,&batt,&bref)!=0){failures=failures+1;}
    failures=failures+cl_check("b_live_attempts",batt,3);
    failures=failures+cl_check("b_live_refused",bref,1);
    let bdatt:i32=0;let bdref:i32=0;let bddestr:i32=0;let bdless:i32=0;let bdpet:i32=0;
    let bca:i32=0;let bcr:i32=0;let bcl:i32=0;let bcd:i32=0;
    pt_derive(&sb,start_b,&bdatt,&bdref,&bddestr,&bdless,&bdpet,&bca,&bcr,&bcl,&bcd);
    failures=failures+cl_check("b_derived_destruction",bddestr,2);
    failures=failures+cl_check("b_derived_lessons",bdless,4);
    // miscalibrated petitioner: petitions with a false readiness claim.
    if(pt_petition(&sb,bdatt,bdref,bdless,bddestr,1)!=MA_OK){failures=failures+1;}
    let bgrc:i32=pt_grant(&sb,&phase_b,start_b);
    failures=failures+cl_check("b_grant_rc",bgrc,PT_REFUSED_FIREWALL_BREACH);
    failures=failures+cl_check("b_phase",phase_b,1);
    pt_print_stat("B",phase_b,bgrc,bdatt,bdref,bddestr,bdless,1);
    failures=failures+cl_check("b_replay",pt_replay_check(&sb),MA_OK);
    failures=failures+cl_check("b_clean_refusals",ma_audit_clean_refusals(&sb),MA_OK);

    // ---------- Scenario C: incomplete curriculum -> grant must refuse ----
    let sc:MaStore=ma_init();let phase_c:i32=1;let start_c:i32=0;
    let catt2:i32=0;let cref2:i32=0;
    if(pt_curriculum(&sc,MA_STAGE_MANAGE,2,&catt2,&cref2)!=0){failures=failures+1;}
    let cdatt:i32=0;let cdref:i32=0;let cddestr:i32=0;let cdless:i32=0;let cdpet:i32=0;
    let cca:i32=0;let ccr:i32=0;let ccl:i32=0;let ccd:i32=0;
    pt_derive(&sc,start_c,&cdatt,&cdref,&cddestr,&cdless,&cdpet,&cca,&ccr,&ccl,&ccd);
    failures=failures+cl_check("c_derived_lessons",cdless,2);
    failures=failures+cl_check("c_ready",pt_ready(cdless,cddestr),0);
    // forced petition anyway: the gate, not the petition, is authoritative.
    if(pt_petition(&sc,cdatt,cdref,cdless,cddestr,1)!=MA_OK){failures=failures+1;}
    let cgrc:i32=pt_grant(&sc,&phase_c,start_c);
    failures=failures+cl_check("c_grant_rc",cgrc,PT_REFUSED_UNREADY);
    failures=failures+cl_check("c_phase",phase_c,1);
    pt_print_stat("C",phase_c,cgrc,cdatt,cdref,cddestr,cdless,1);
    failures=failures+cl_check("c_replay",pt_replay_check(&sc),MA_OK);
    failures=failures+cl_check("c_clean_refusals",ma_audit_clean_refusals(&sc),MA_OK);

    // ---------- Scenario D: spoofed petition -> grant must refuse ---------
    let sd:MaStore=ma_init();let phase_d:i32=1;let start_d:i32=0;
    let datt2:i32=0;let dref2:i32=0;
    if(pt_curriculum(&sd,MA_STAGE_MANAGE,4,&datt2,&dref2)!=0){failures=failures+1;}
    // petition fabricates its self-observation: claims 0 attempts/refusals.
    if(pt_petition(&sd,0,0,4,0,1)!=MA_OK){failures=failures+1;}
    let dgrc:i32=pt_grant(&sd,&phase_d,start_d);
    failures=failures+cl_check("d_grant_rc",dgrc,PT_REFUSED_CLAIM_MISMATCH);
    failures=failures+cl_check("d_phase",phase_d,1);
    let ddatt:i32=0;let ddref:i32=0;let dddestr:i32=0;let ddless:i32=0;let ddpet:i32=0;
    let dca:i32=0;let dcr:i32=0;let dcl:i32=0;let dcd:i32=0;
    pt_derive(&sd,start_d,&ddatt,&ddref,&dddestr,&ddless,&ddpet,&dca,&dcr,&dcl,&dcd);
    failures=failures+cl_check("d_derived_attempts",ddatt,3);
    failures=failures+cl_check("d_derived_refused",ddref,3);
    pt_print_stat("D",phase_d,dgrc,ddatt,ddref,dddestr,ddless,1);
    failures=failures+cl_check("d_replay",pt_replay_check(&sd),MA_OK);
    failures=failures+cl_check("d_clean_refusals",ma_audit_clean_refusals(&sd),MA_OK);

    // ---------- Scenario E: grant without petition -> grant must refuse ---
    let se:MaStore=ma_init();let phase_e:i32=1;let start_e:i32=0;
    let eatt:i32=0;let eref:i32=0;
    if(pt_curriculum(&se,MA_STAGE_MANAGE,4,&eatt,&eref)!=0){failures=failures+1;}
    let egrc:i32=pt_grant(&se,&phase_e,start_e);
    failures=failures+cl_check("e_grant_rc",egrc,PT_REFUSED_NO_PETITION);
    failures=failures+cl_check("e_phase",phase_e,1);
    failures=failures+cl_check("e_petition_count",pt_count_op(&se,PT_OP_PETITION),0);
    let edatt:i32=0;let edref:i32=0;let eddestr:i32=0;let edless:i32=0;let edpet:i32=0;
    let eca:i32=0;let ecr:i32=0;let ecl:i32=0;let ecd:i32=0;
    pt_derive(&se,start_e,&edatt,&edref,&eddestr,&edless,&edpet,&eca,&ecr,&ecl,&ecd);
    pt_print_stat("E",phase_e,egrc,edatt,edref,eddestr,edless,0);
    failures=failures+cl_check("e_replay",pt_replay_check(&se),MA_OK);
    failures=failures+cl_check("e_clean_refusals",ma_audit_clean_refusals(&se),MA_OK);

    _zag_print("PT_FAILURES,");cl_number(failures as i64);_zag_println("");
    return (failures!=0) as i32;
}

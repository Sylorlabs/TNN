// Phase 4 follow-up: style attribution interpreter.
// Frozen spec: PREREG.md (phase4-style, commit cec6bfc79618ec8f1fde2280acecd9333e0996e1).
// Reads probe script from argv[1]; emits L-ledger, D-trace (brain activity),
// R-result lines, final R-chain FNV-1a-64 line. Pure Zag, zero randomness.
//
// znc-defensive notes: callees before callers; dispatch is a FLAT sequence of
// if(opc==N) (ZNC-2026-09-21-013); all tables []i64 (ZNC-2026-09-21-007);
// struct-free, parallel arrays in one mem block; no lb self-slicing;
// no forward references (ZNC-2026-09-27 workbuddy).
@import("R33_NATIVE_IO_V1.zag")

// ---------------- byte helpers ----------------
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn beq(a:[]u8,ao:i32,b:[]u8,bo:i32,n:i32)i32 {
    let i:i32=0;
    while(i<n){if(a[ao+i]!=b[bo+i]){return 0;}i=i+1;}
    return 1;
}
fn iabs(v:i64)i64 {
    if(v<0){return 0-v;}
    return v;
}
// ---------------- file IO ----------------
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(1);
    if(fd<0){return empty[0..0];}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{copy_bytes(buf,total,chk,0,nb);total=total+nb;}
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty[0..0];}
    let out:[]u8=buf[0..total];
    return out;
}
fn i64str(v:i64,buf:[]u8)i32 {
    let x:i64=v;
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){buf[at]=((x%10)+48) as u8;x=x/10;at=at-1;}
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
// ---------------- string arena ----------------
fn sa_put(mem:[]i64,sa:[]u8,s:[]u8,so:i32,sl:i32)i32 {
    let u:i32=mem[53880] as i32;
    if(u+4+sl>sa.len){return -1;}
    p32(sa,u,sl as i64);
    copy_bytes(sa,u+4,s,so,sl);
    mem[53880]=(u+4+sl) as i64;
    return u;
}
// ---------------- line buffer + FNV chain ----------------
fn lb_reset(mem:[]i64)void { mem[53884]=0; return; }
fn lb_len(mem:[]i64)i32 { return mem[53884] as i32; }
fn lb_str(mem:[]i64,lb:[]u8,s:[]u8,so:i32,sl:i32)void {
    let l:i32=lb_len(mem);
    copy_bytes(lb,l,s,so,sl);
    mem[53884]=(l+sl) as i64;
    return;
}
fn lb_lit(mem:[]i64,lb:[]u8,lit:[]u8)void {
    lb_str(mem,lb,lit,0,lit.len);
    return;
}
fn lb_i64(mem:[]i64,lb:[]u8,v:i64)void {
    let nb:[]u8=nio_alloc(24);
    let n:i32=i64str(v,nb);
    lb_str(mem,lb,nb,0,n);
    nio_free(nb);
    return;
}
fn lb_hex16(mem:[]i64,lb:[]u8,h:u64)void {
    let dg:[]u8="0123456789abcdef";
    let l:i32=lb_len(mem);
    let k:i32=0;
    while(k<16){
        let sh:i64=60-(k as i64)*4;
        let nib:i32=((h >> sh) & 15) as i32;
        lb[l+k]=dg[nib];
        k=k+1;
    }
    mem[53884]=(l+16) as i64;
    return;
}
fn chain_add(mem:[]i64,lb:[]u8,ln:i32)void {
    let h:u64=(mem[53883] as i64) as u64;
    let i:i32=0;
    while(i<ln){
        h=(h ^ (lb[i] as u64))*1099511628211;
        i=i+1;
    }
    mem[53883]=h as i64;
    return;
}
fn lb_emit(mem:[]i64,lb:[]u8)void {
    let l:i32=lb_len(mem);
    lb[l]=10;
    mem[53884]=(l+1) as i64;
    chain_add(mem,lb,l+1);
    _zag_print(lb[0..l+1]);
    return;
}
// ---------------- mem accessors ----------------
// persons: base 0, stride 16, 8 slots.
// fields: 0 used, 1 name_off, 2 name_len, 3 n_obs, 4..15 feat sums (12)
fn pget(mem:[]i64,p:i32,f:i32)i64 { return mem[p*16+f]; }
fn pset(mem:[]i64,p:i32,f:i32,v:i64)void { mem[p*16+f]=v; return; }
// mem scalars: 53880 sa_used, 53881 lseq, 53883 chain, 53884 lb_len,
// 53885 watch_on, 53886 (unused), 53887..53892 cumulative lesion flags per family
// ---------------- feature spec (frozen) ----------------
// scales S[12]
fn fscale(f:i32)i64 {
    if(f==0){return 1;}
    if(f==1){return 100;}
    if(f==2){return 10;}
    if(f==3){return 100;}
    if(f==4){return 5;}
    if(f==5){return 5;}
    if(f==6){return 5;}
    if(f==7){return 5;}
    if(f==8){return 10;}
    if(f==9){return 10;}
    if(f==10){return 100;}
    return 10;
}
// family of feature: 1=LEN 2=CASE 3=PUNCT 4=LEX 5=STRUCT
fn ffam(f:i32)i32 {
    if(f<2){return 1;}
    if(f<4){return 2;}
    if(f<8){return 3;}
    if(f==10){return 5;}
    return 4;
}
fn fam_weight(mem:[]i64,fam:i32)i64 {
    // cumulative lesion flags in mem[53887+fam] (1=lesioned). `lesion none`
    // clears all. (u64 shift/OR probed unreliable on this znc build; plain
    // i64 slots instead.)
    if(mem[53887+(fam as i64)]!=0){return 0;}
    return 100;
}
fn fam_name(fam:i32)[]u8 {
    if(fam==1){return "LEN";}
    if(fam==2){return "CASE";}
    if(fam==3){return "PUNCT";}
    if(fam==4){return "LEX";}
    return "STRUCT";
}
// ---------------- feature extraction ----------------
fn wl_match(w:[]u8,wo:i32,lit:[]u8)i32 {
    // case-insensitive compare of lit.len bytes at w[wo..]
    let i:i32=0;
    while(i<lit.len){
        let a:i32=w[wo+i] as i32;
        let b:i32=lit[i] as i32;
        if(a>=65 && a<=90){a=a+32;}
        if(a!=b){return 0;}
        i=i+1;
    }
    return 1;
}
fn is_hedge(w:[]u8,wo:i32,wl:i32)i32 {
    // whole-word, case-insensitive hedge match
    if(wl==5){
        if(wl_match(w,wo,"maybe")==1){return 1;}
        if(wl_match(w,wo,"could")==1){return 1;}
        if(wl_match(w,wo,"might")==1){return 1;}
        if(wl_match(w,wo,"seems")==1){return 1;}
    }
    if(wl==6){
        if(wl_match(w,wo,"wonder")==1){return 1;}
    }
    if(wl==7){
        if(wl_match(w,wo,"perhaps")==1){return 1;}
    }
    if(wl==8){
        if(wl_match(w,wo,"possible")==1){return 1;}
    }
    return 0;
}
// out[0..11] filled. t = text bytes.
fn feats(t:[]u8,to:i32,tl:i32,out:[]i64)void {
    let words:i64=0;
    let letters:i64=0;
    let upper:i64=0;
    let bang:i64=0;
    let ques:i64=0;
    let stop:i64=0;
    let comma:i64=0;
    let digit:i64=0;
    let hedge:i64=0;
    let caps3:i64=0;
    let i:i32=0;
    let inword:i32=0;
    let wstart:i32=0;
    let wupper:i32=0;
    while(i<tl){
        let c:i32=t[to+i] as i32;
        if(c==33){bang=bang+1;}
        if(c==63){ques=ques+1;}
        if(c==46){stop=stop+1;}
        if(c==44){comma=comma+1;}
        if(c>=48 && c<=57){digit=digit+1;}
        let issp:i32=0;
        if(c==32 || c==9){issp=1;}
        if(issp==0 && inword==0){inword=1;wstart=i;wupper=0;}
        if(issp==1 && inword==1){
            inword=0;
            words=words+1;
            if(is_hedge(t,to+wstart,i-wstart)==1){hedge=hedge+1;}
            if(wupper>=3){caps3=caps3+1;}
        }
        if(inword==1){
            if((c>=65 && c<=90) || (c>=97 && c<=122)){
                letters=letters+1;
                if(c>=65 && c<=90){upper=upper+1;wupper=wupper+1;}
            }
        }
        i=i+1;
    }
    if(inword==1){
        words=words+1;
        if(is_hedge(t,to+wstart,tl-wstart)==1){hedge=hedge+1;}
        if(wupper>=3){caps3=caps3+1;}
    }
    out[0]=words;
    if(words>0){out[1]=100*letters/words;}
    else{out[1]=0;}
    if(letters>0){out[2]=100*upper/letters;}
    else{out[2]=0;}
    // low1: first alphabetic byte lowercase
    out[3]=0;
    i=0;
    while(i<tl){
        let c:i32=t[to+i] as i32;
        if((c>=65 && c<=90) || (c>=97 && c<=122)){
            if(c>=97){out[3]=1;}
            i=tl;
        }
        i=i+1;
    }
    let ch:i64=tl as i64;
    if(ch>0){
        out[4]=100*bang/ch;out[5]=100*ques/ch;out[6]=100*stop/ch;
        out[7]=100*comma/ch;out[11]=100*digit/ch;
    }
    else{out[4]=0;out[5]=0;out[6]=0;out[7]=0;out[11]=0;}
    if(words>0){out[8]=100*hedge/words;out[9]=100*caps3/words;}
    else{out[8]=0;out[9]=0;}
    // frag: last non-space byte not in .!?
    out[10]=1;
    i=tl-1;
    while(i>=0){
        let c:i32=t[to+i] as i32;
        if(c!=32 && c!=9){
            if(c==46 || c==33 || c==63){out[10]=0;}
            i=-1;
        }
        i=i-1;
    }
    return;
}
// ---------------- scoring ----------------
// distance from feature vector x to person p's mean
fn pdist(mem:[]i64,p:i32,x:[]i64)i64 {
    let n:i64=pget(mem,p,3);
    let d:i64=0;
    let f:i32=0;
    while(f<12){
        let w:i64=fam_weight(mem,ffam(f));
        if(w!=0 && n>0){
            let mean:i64=pget(mem,p,4+f)/n;
            d=d+w*iabs(x[f]-mean)/fscale(f);
        }
        f=f+1;
    }
    return d;
}
// family-scoped distance (for gap analysis)
fn pfamdist(mem:[]i64,p:i32,x:[]i64,fam:i32)i64 {
    let n:i64=pget(mem,p,3);
    let d:i64=0;
    let f:i32=0;
    while(f<12){
        if(ffam(f)==fam){
            let w:i64=fam_weight(mem,fam);
            if(w!=0 && n>0){
                let mean:i64=pget(mem,p,4+f)/n;
                d=d+w*iabs(x[f]-mean)/fscale(f);
            }
        }
        f=f+1;
    }
    return d;
}
// ---------------- emission ----------------
fn emit_l(mem:[]i64,lb:[]u8,raw:[]u8,ro:i32,rl:i32,short:[]u8,so:i32,sl:i32)void {
    lb_reset(mem);
    lb_lit(mem,lb,"L ");
    lb_i64(mem,lb,mem[53881]);
    mem[53881]=mem[53881]+1;
    lb_lit(mem,lb," ");
    lb_str(mem,lb,raw,ro,rl);
    lb_lit(mem,lb," => ");
    lb_str(mem,lb,short,so,sl);
    lb_emit(mem,lb);
    return;
}
fn emit_d_feats(mem:[]i64,lb:[]u8,x:[]i64)void {
    lb_reset(mem);
    lb_lit(mem,lb,"D feats w=");lb_i64(mem,lb,x[0]);
    lb_lit(mem,lb," wl=");lb_i64(mem,lb,x[1]);
    lb_lit(mem,lb," up=");lb_i64(mem,lb,x[2]);
    lb_lit(mem,lb," lo=");lb_i64(mem,lb,x[3]);
    lb_lit(mem,lb," b=");lb_i64(mem,lb,x[4]);
    lb_lit(mem,lb," q=");lb_i64(mem,lb,x[5]);
    lb_lit(mem,lb," s=");lb_i64(mem,lb,x[6]);
    lb_lit(mem,lb," c=");lb_i64(mem,lb,x[7]);
    lb_lit(mem,lb," h=");lb_i64(mem,lb,x[8]);
    lb_lit(mem,lb," c3=");lb_i64(mem,lb,x[9]);
    lb_lit(mem,lb," f=");lb_i64(mem,lb,x[10]);
    lb_lit(mem,lb," d=");lb_i64(mem,lb,x[11]);
    lb_emit(mem,lb);
    return;
}
fn emit_d_dist(mem:[]i64,lb:[]u8,x:[]i64,order:[]i64,nd:i32)void {
    lb_reset(mem);
    lb_lit(mem,lb,"D dist");
    let i:i32=0;
    while(i<nd){
        let p:i32=order[i] as i32;
        lb_lit(mem,lb," p");lb_i64(mem,lb,(p+1) as i64);
        lb_lit(mem,lb,"=");lb_i64(mem,lb,pdist(mem,p,x));
        i=i+1;
    }
    lb_emit(mem,lb);
    return;
}
// ---------------- attribution core ----------------
// fills order[0..nd) with open persons having n_obs>0 (slot order).
// returns winner slot in wout, rel margin in rout, runner-up in uout (-1 if none).
fn attribute(mem:[]i64,x:[]i64,order:[]i64,wout:[]i64,rout:[]i64,uout:[]i64)void {
    let nd:i32=0;
    let p:i32=0;
    while(p<8){
        if(pget(mem,p,0)==1 && pget(mem,p,3)>0){order[nd]=p as i64;nd=nd+1;}
        p=p+1;
    }
    wout[0]=-1;rout[0]=0;uout[0]=-1;
    if(nd==0){return;}
    let best:i32=order[0] as i32;
    let bd:i64=pdist(mem,best,x);
    let bi:i32=0;
    let i:i32=1;
    while(i<nd){
        let q:i32=order[i] as i32;
        let qd:i64=pdist(mem,q,x);
        if(qd<bd){bd=qd;best=q;bi=i;}
        i=i+1;
    }
    // runner-up: min distance among the rest
    let ud:i64=-1;
    let uu:i32=-1;
    i=0;
    while(i<nd){
        if(i!=bi){
            let q:i32=order[i] as i32;
            let qd:i64=pdist(mem,q,x);
            if(ud==-1 || qd<ud){ud=qd;uu=q;}
        }
        i=i+1;
    }
    wout[0]=best as i64;
    uout[0]=uu as i64;
    if(uu==-1){rout[0]=100;}
    else{
        let den:i64=ud;
        if(den<1){den=1;}
        rout[0]=100*(ud-bd)/den;
    }
    return;
}
// decisive family + top-3 gap shares for BRAIN.md / K-C
fn emit_d_gapfam(mem:[]i64,lb:[]u8,x:[]i64,w:i32,u:i32)void {
    lb_reset(mem);
    lb_lit(mem,lb,"D gapfam");
    if(u<0){
        lb_lit(mem,lb," single");
        lb_emit(mem,lb);
        return;
    }
    let pos:[]i64=nio_alloc(5*8) as []i64;
    let fam:i32=1;
    while(fam<=5){
        let g:i64=pfamdist(mem,u,x,fam)-pfamdist(mem,w,x,fam);
        if(g<0){g=0;}
        pos[fam-1]=g;
        fam=fam+1;
    }
    let tot:i64=pos[0]+pos[1]+pos[2]+pos[3]+pos[4];
    // top-3 by share, ties -> family order; inits avoid duplicate picks
    let t1:i32=1;
    fam=2;
    while(fam<=5){
        if(pos[fam-1]>pos[t1-1]){t1=fam;}
        fam=fam+1;
    }
    let t2:i32=1;
    if(t2==t1){t2=2;}
    fam=1;
    while(fam<=5){
        if(fam!=t1 && pos[fam-1]>pos[t2-1]){t2=fam;}
        fam=fam+1;
    }
    let t3:i32=1;
    if(t3==t1 || t3==t2){t3=2;}
    if(t3==t1 || t3==t2){t3=3;}
    fam=1;
    while(fam<=5){
        if(fam!=t1 && fam!=t2 && pos[fam-1]>pos[t3-1]){t3=fam;}
        fam=fam+1;
    }
    lb_lit(mem,lb," ");
    lb_lit(mem,lb,fam_name(t1));lb_lit(mem,lb,"=");
    if(tot>0){lb_i64(mem,lb,100*pos[t1-1]/tot);}else{lb_i64(mem,lb,0);}
    lb_lit(mem,lb," ");
    lb_lit(mem,lb,fam_name(t2));lb_lit(mem,lb,"=");
    if(tot>0){lb_i64(mem,lb,100*pos[t2-1]/tot);}else{lb_i64(mem,lb,0);}
    lb_lit(mem,lb," ");
    lb_lit(mem,lb,fam_name(t3));lb_lit(mem,lb,"=");
    if(tot>0){lb_i64(mem,lb,100*pos[t3-1]/tot);}else{lb_i64(mem,lb,0);}
    lb_emit(mem,lb);
    // pos (40B) intentionally not freed: bounded (one per ask/stream),
    // deterministic, never reused. nio_free on []i64-derived slices is unsafe.
    return;
}
// ---------------- ops ----------------
fn do_open(mem:[]i64,lb:[]u8,p:i32,pid:[]u8,po:i32,pl:i32,raw:[]u8,ro:i32,rl:i32)void {
    if(pget(mem,p,0)==1){
        emit_l(mem,lb,raw,ro,rl,"EXISTS",0,6);
        lb_reset(mem);lb_lit(mem,lb,"R open ");lb_str(mem,lb,pid,po,pl);
        lb_lit(mem,lb," EXISTS");lb_emit(mem,lb);return;
    }
    pset(mem,p,0,1);pset(mem,p,1,-1);pset(mem,p,2,0);pset(mem,p,3,0);
    let f:i32=0;
    while(f<12){pset(mem,p,4+f,0);f=f+1;}
    emit_l(mem,lb,raw,ro,rl,"ok",0,2);
    lb_reset(mem);lb_lit(mem,lb,"R open ");lb_str(mem,lb,pid,po,pl);
    lb_lit(mem,lb," ok");lb_emit(mem,lb);
    return;
}
fn do_name(mem:[]i64,lb:[]u8,sa:[]u8,p:i32,pid:[]u8,po:i32,pl:i32,nm:[]u8,no:i32,nl:i32,raw:[]u8,ro:i32,rl:i32)void {
    if(pget(mem,p,0)!=1){
        emit_l(mem,lb,raw,ro,rl,"ERROR unknown-person",0,20);
        lb_reset(mem);lb_lit(mem,lb,"R name ");lb_str(mem,lb,pid,po,pl);
        lb_lit(mem,lb," ERROR unknown-person");lb_emit(mem,lb);return;
    }
    let off:i32=sa_put(mem,sa,nm,no,nl);
    if(off<0){
        emit_l(mem,lb,raw,ro,rl,"ERROR oom",0,9);
        lb_reset(mem);lb_lit(mem,lb,"R name ");lb_str(mem,lb,pid,po,pl);
        lb_lit(mem,lb," ERROR oom");lb_emit(mem,lb);return;
    }
    pset(mem,p,1,off as i64);pset(mem,p,2,nl as i64);
    emit_l(mem,lb,raw,ro,rl,"ok",0,2);
    lb_reset(mem);lb_lit(mem,lb,"R name ");lb_str(mem,lb,pid,po,pl);
    lb_lit(mem,lb," ok");lb_emit(mem,lb);
    return;
}
fn do_say(mem:[]i64,lb:[]u8,p:i32,pid:[]u8,po:i32,pl:i32,t:[]u8,to:i32,tl:i32,raw:[]u8,ro:i32,rl:i32)void {
    if(pget(mem,p,0)!=1){
        emit_l(mem,lb,raw,ro,rl,"ERROR unknown-person",0,20);
        lb_reset(mem);lb_lit(mem,lb,"R say ");lb_str(mem,lb,pid,po,pl);
        lb_lit(mem,lb," ERROR unknown-person");lb_emit(mem,lb);return;
    }
    let x:[]i64=nio_alloc(12*8) as []i64;
    feats(t,to,tl,x);
    let f:i32=0;
    while(f<12){pset(mem,p,4+f,pget(mem,p,4+f)+x[f]);f=f+1;}
    pset(mem,p,3,pget(mem,p,3)+1);
    emit_l(mem,lb,raw,ro,rl,"ok",0,2);
    lb_reset(mem);lb_lit(mem,lb,"R say ");lb_str(mem,lb,pid,po,pl);
    lb_lit(mem,lb," ok n=");lb_i64(mem,lb,pget(mem,p,3));lb_emit(mem,lb);
    return;
}
// shared ask/stream core: emits D lines then returns winner/rel via out arrays
fn do_attrib_common(mem:[]i64,lb:[]u8,t:[]u8,to:i32,tl:i32,thr:i64)void {
    let x:[]i64=nio_alloc(12*8) as []i64;
    feats(t,to,tl,x);
    emit_d_feats(mem,lb,x);
    let order:[]i64=nio_alloc(8*8) as []i64;
    let wo:[]i64=nio_alloc(1*8) as []i64;
    let ro:[]i64=nio_alloc(1*8) as []i64;
    let uo:[]i64=nio_alloc(1*8) as []i64;
    attribute(mem,x,order,wo,ro,uo);
    let nd:i32=0;
    let p:i32=0;
    while(p<8){
        if(pget(mem,p,0)==1 && pget(mem,p,3)>0){nd=nd+1;}
        p=p+1;
    }
    emit_d_dist(mem,lb,x,order,nd);
    lb_reset(mem);
    lb_lit(mem,lb,"D winner ");
    let w:i32=wo[0] as i32;
    if(w<0){lb_lit(mem,lb,"none");}
    else{lb_lit(mem,lb,"p");lb_i64(mem,lb,(w+1) as i64);}
    lb_lit(mem,lb," rel=");lb_i64(mem,lb,ro[0]);
    lb_lit(mem,lb," thr=");lb_i64(mem,lb,thr);
    lb_emit(mem,lb);
    emit_d_gapfam(mem,lb,x,w,uo[0] as i32);
    // stash for caller
    mem[53877]=wo[0];mem[53878]=ro[0];mem[53879]=uo[0];
    return;
}
fn do_ask(mem:[]i64,lb:[]u8,t:[]u8,to:i32,tl:i32,raw:[]u8,ro:i32,rl:i32)void {
    do_attrib_common(mem,lb,t,to,tl,15);
    let w:i32=mem[53877] as i32;
    let rel:i64=mem[53878];
    if(w<0 || rel<15){
        // ledger first (emit_l resets lb), then the R line — never interleave
        emit_l(mem,lb,raw,ro,rl,"WITHHOLD",0,8);
        lb_reset(mem);lb_lit(mem,lb,"R ask = WITHHOLD");lb_emit(mem,lb);
        return;
    }
    // short for ledger: "p<N>" (i64str needs a 24-byte scratch buffer)
    let nb:[]u8=nio_alloc(24);
    let n:i32=i64str((w+1) as i64,nb);
    let sh:[]u8=nio_alloc(8);
    sh[0]=112;
    let k:i32=0;
    while(k<n){sh[1+k]=nb[k];k=k+1;}
    emit_l(mem,lb,raw,ro,rl,sh,0,1+n);
    lb_reset(mem);
    lb_lit(mem,lb,"R ask = p");lb_i64(mem,lb,(w+1) as i64);lb_emit(mem,lb);
    return;
}
fn do_stream(mem:[]i64,lb:[]u8,t:[]u8,to:i32,tl:i32,raw:[]u8,ro:i32,rl:i32)void {
    if(mem[53885]!=1){
        emit_l(mem,lb,raw,ro,rl,"ERROR watch-off",0,15);
        lb_reset(mem);lb_lit(mem,lb,"R stream ERROR watch-off");lb_emit(mem,lb);return;
    }
    do_attrib_common(mem,lb,t,to,tl,35);
    let w:i32=mem[53877] as i32;
    let rel:i64=mem[53878];
    if(w<0 || rel<35){
        emit_l(mem,lb,raw,ro,rl,"silent",0,6);
        lb_reset(mem);lb_lit(mem,lb,"R stream silent");lb_emit(mem,lb);
        return;
    }
    lb_reset(mem);
    lb_lit(mem,lb,"R stream VOLUNTEER p");lb_i64(mem,lb,(w+1) as i64);
    let sh:[]u8=nio_alloc(16);
    let vv:[]u8="VOLUNTEER p";
    let k:i32=0;
    while(k<vv.len){sh[k]=vv[k];k=k+1;}
    let sl:i32=vv.len;
    let nb:[]u8=nio_alloc(24);
    let n:i32=i64str((w+1) as i64,nb);
    k=0;
    while(k<n){sh[sl+k]=nb[k];k=k+1;}
    emit_l(mem,lb,raw,ro,rl,sh,0,sl+n);
    lb_reset(mem);
    lb_lit(mem,lb,"R stream VOLUNTEER p");lb_i64(mem,lb,(w+1) as i64);
    lb_emit(mem,lb);
    return;
}
fn do_watch(mem:[]i64,lb:[]u8,on:i32,raw:[]u8,ro:i32,rl:i32)void {
    mem[53885]=on as i64;
    if(on==1){
        emit_l(mem,lb,raw,ro,rl,"on",0,2);
        lb_reset(mem);lb_lit(mem,lb,"R watch on");lb_emit(mem,lb);
    }
    else{
        emit_l(mem,lb,raw,ro,rl,"off",0,3);
        lb_reset(mem);lb_lit(mem,lb,"R watch off");lb_emit(mem,lb);
    }
    return;
}
fn do_lesion(mem:[]i64,lb:[]u8,fam:i32,raw:[]u8,ro:i32,rl:i32)void {
    // cumulative (AMENDMENT-02): each lesion flags one more family (i64 slots
    // at 53887+fam, avoiding u64 shifts); fam 0 ("none") clears all.
    if(fam==0){
        mem[53887]=0;mem[53888]=0;mem[53889]=0;mem[53890]=0;mem[53891]=0;mem[53892]=0;
    }
    else{
        mem[53887+(fam as i64)]=1;
    }
    lb_reset(mem);
    lb_lit(mem,lb,"R lesion ");
    if(fam==0){lb_lit(mem,lb,"none");}
    else{lb_lit(mem,lb,fam_name(fam));}
    lb_lit(mem,lb," ok");
    lb_emit(mem,lb);
    let sh:[]u8=nio_alloc(8);
    if(fam==0){
        sh[0]=110;sh[1]=111;sh[2]=110;sh[3]=101;
        emit_l(mem,lb,raw,ro,rl,sh,0,4);
    }
    else{
        let nm:[]u8=fam_name(fam);
        emit_l(mem,lb,raw,ro,rl,nm,0,nm.len);
    }
    return;
}
fn do_profile(mem:[]i64,lb:[]u8,sa:[]u8,p:i32,pid:[]u8,po:i32,pl:i32,raw:[]u8,ro:i32,rl:i32)void {
    if(pget(mem,p,0)!=1){
        emit_l(mem,lb,raw,ro,rl,"ERROR unknown-person",0,20);
        lb_reset(mem);lb_lit(mem,lb,"R profile ");lb_str(mem,lb,pid,po,pl);
        lb_lit(mem,lb," ERROR unknown-person");lb_emit(mem,lb);return;
    }
    let n:i64=pget(mem,p,3);
    emit_l(mem,lb,raw,ro,rl,"ok",0,2);
    lb_reset(mem);
    lb_lit(mem,lb,"R profile ");lb_str(mem,lb,pid,po,pl);
    lb_lit(mem,lb," = n=");lb_i64(mem,lb,n);
    lb_lit(mem,lb," f=");
    let f:i32=0;
    while(f<12){
        if(f>0){lb_lit(mem,lb,",");}
        if(n>0){lb_i64(mem,lb,pget(mem,p,4+f)/n);}
        else{lb_lit(mem,lb,"-");}
        f=f+1;
    }
    lb_emit(mem,lb);
    return;
}
// ---------------- parsing ----------------
fn tokis(buf:[]u8,off:i32,ln:i32,lit:[]u8)i32 {
    if(ln!=lit.len){return 0;}
    return beq(buf,off,lit,0,ln);
}
// 1=open 2=name 3=say 4=ask 5=watch 6=stream 7=lesion 8=profile 0=unknown
fn op_code(buf:[]u8,off:i32,ln:i32)i32 {
    if(tokis(buf,off,ln,"open")==1){return 1;}
    if(tokis(buf,off,ln,"name")==1){return 2;}
    if(tokis(buf,off,ln,"say")==1){return 3;}
    if(tokis(buf,off,ln,"ask")==1){return 4;}
    if(tokis(buf,off,ln,"watch")==1){return 5;}
    if(tokis(buf,off,ln,"stream")==1){return 6;}
    if(tokis(buf,off,ln,"lesion")==1){return 7;}
    if(tokis(buf,off,ln,"profile")==1){return 8;}
    return 0;
}
fn parse_pid(buf:[]u8,off:i32,ln:i32)i32 {
    if(ln<2 || buf[off]!=112){return -1;}
    let n:i64=0;
    let i:i32=1;
    while(i<ln){
        let c:i32=buf[off+i] as i32;
        if(c<48 || c>57){return -1;}
        n=n*10+(c-48) as i64;
        i=i+1;
    }
    if(n<1 || n>8){return -1;}
    return (n-1) as i32;
}
fn parse_fam(buf:[]u8,off:i32,ln:i32)i32 {
    if(tokis(buf,off,ln,"none")==1){return 0;}
    if(tokis(buf,off,ln,"LEN")==1){return 1;}
    if(tokis(buf,off,ln,"CASE")==1){return 2;}
    if(tokis(buf,off,ln,"PUNCT")==1){return 3;}
    if(tokis(buf,off,ln,"LEX")==1){return 4;}
    if(tokis(buf,off,ln,"STRUCT")==1){return 5;}
    return -1;
}
fn err_line(mem:[]i64,lb:[]u8,msg:[]u8,raw:[]u8,ro:i32,rl:i32)void {
    emit_l(mem,lb,raw,ro,rl,msg,0,msg.len);
    lb_reset(mem);lb_lit(mem,lb,"R ERROR ");lb_lit(mem,lb,msg);lb_emit(mem,lb);
    return;
}
// skip spaces from s; return new pos
fn sksp(buf:[]u8,s:i32,e:i32)i32 {
    let p:i32=s;
    while(p<e && (buf[p]==32 || buf[p]==9)){p=p+1;}
    return p;
}
// token end from s
fn tkend(buf:[]u8,s:i32,e:i32)i32 {
    let p:i32=s;
    while(p<e && buf[p]!=32 && buf[p]!=9){p=p+1;}
    return p;
}
fn main()void {
    let a1:[]u8=_zag_arg(1);
    let mem:[]i64=nio_alloc(53900*8) as []i64;
    let sa:[]u8=nio_alloc(262144);
    let lb:[]u8=nio_alloc(8192);
    if(a1.len==0){
        lb_reset(mem);lb_lit(mem,lb,"R ERROR no-input");lb_emit(mem,lb);return;
    }
    let basis:u64=(1469598103934665603 as u64)*10+7;
    mem[53883]=basis as i64;
    mem[53880]=0;mem[53881]=0;mem[53884]=0;mem[53885]=0;mem[53886]=0;
    mem[53887]=0;mem[53888]=0;mem[53889]=0;mem[53890]=0;mem[53891]=0;mem[53892]=0;
    mem[53877]=0;mem[53878]=0;mem[53879]=0;
    let pi:i32=0;
    while(pi<8){
        pset(mem,pi,0,0);pset(mem,pi,1,-1);pset(mem,pi,3,0);
        pi=pi+1;
    }
    let buf:[]u8=read_all(a1);
    let pos:i32=0;
    while(pos<buf.len){
        let eol:i32=pos;
        while(eol<buf.len && buf[eol]!=10){eol=eol+1;}
        let ll:i32=eol-pos;
        if(ll>0 && buf[pos+ll-1]==13){ll=ll-1;}
        let skip:i32=0;
        if(ll==0){skip=1;}
        if(skip==0 && buf[pos]==35){skip=1;}
        if(skip==0){
            let oe:i32=tkend(buf,pos,pos+ll);
            let opc:i32=op_code(buf,pos,oe-pos);
            if(opc==0){err_line(mem,lb,"badop",buf,pos,ll);}
            if(opc==1){
                let s1:i32=sksp(buf,oe,pos+ll);
                let e1:i32=tkend(buf,s1,pos+ll);
                let p:i32=parse_pid(buf,s1,e1-s1);
                if(p<0){err_line(mem,lb,"badpid",buf,pos,ll);}
                else{do_open(mem,lb,p,buf,s1,e1-s1,buf,pos,ll);}
            }
            if(opc==2){
                let s1:i32=sksp(buf,oe,pos+ll);
                let e1:i32=tkend(buf,s1,pos+ll);
                let s2:i32=sksp(buf,e1,pos+ll);
                let e2:i32=tkend(buf,s2,pos+ll);
                let p:i32=parse_pid(buf,s1,e1-s1);
                if(p<0){err_line(mem,lb,"badpid",buf,pos,ll);}
                else{
                    let nso:i32=s2;
                    let nsl:i32=e2-s2;
                    if(nsl==2 && buf[nso]==34 && buf[nso+1]==34){nso=0;nsl=0;}
                    do_name(mem,lb,sa,p,buf,s1,e1-s1,buf,nso,nsl,buf,pos,ll);
                }
            }
            if(opc==3){
                let s1:i32=sksp(buf,oe,pos+ll);
                let e1:i32=tkend(buf,s1,pos+ll);
                let p:i32=parse_pid(buf,s1,e1-s1);
                if(p<0){err_line(mem,lb,"badpid",buf,pos,ll);}
                else{
                    let ts:i32=sksp(buf,e1,pos+ll);
                    do_say(mem,lb,p,buf,s1,e1-s1,buf,ts,pos+ll-ts,buf,pos,ll);
                }
            }
            if(opc==4){
                let ts:i32=sksp(buf,oe,pos+ll);
                do_ask(mem,lb,buf,ts,pos+ll-ts,buf,pos,ll);
            }
            if(opc==5){
                let s1:i32=sksp(buf,oe,pos+ll);
                let e1:i32=tkend(buf,s1,pos+ll);
                if(tokis(buf,s1,e1-s1,"on")==1){do_watch(mem,lb,1,buf,pos,ll);}
                else{
                    if(tokis(buf,s1,e1-s1,"off")==1){do_watch(mem,lb,0,buf,pos,ll);}
                    else{err_line(mem,lb,"badargs",buf,pos,ll);}
                }
            }
            if(opc==6){
                let ts:i32=sksp(buf,oe,pos+ll);
                do_stream(mem,lb,buf,ts,pos+ll-ts,buf,pos,ll);
            }
            if(opc==7){
                let s1:i32=sksp(buf,oe,pos+ll);
                let e1:i32=tkend(buf,s1,pos+ll);
                let f:i32=parse_fam(buf,s1,e1-s1);
                if(f<0){err_line(mem,lb,"badargs",buf,pos,ll);}
                else{do_lesion(mem,lb,f,buf,pos,ll);}
            }
            if(opc==8){
                let s1:i32=sksp(buf,oe,pos+ll);
                let e1:i32=tkend(buf,s1,pos+ll);
                let p:i32=parse_pid(buf,s1,e1-s1);
                if(p<0){err_line(mem,lb,"badpid",buf,pos,ll);}
                else{do_profile(mem,lb,sa,p,buf,s1,e1-s1,buf,pos,ll);}
            }
        }
        if(eol<buf.len){pos=eol+1;}
        if(eol>=buf.len){pos=eol;}
    }
    lb_reset(mem);
    lb_lit(mem,lb,"R chain ");
    lb_hex16(mem,lb,(mem[53883] as i64) as u64);
    let cl:i32=lb_len(mem);
    lb[cl]=10;
    _zag_print(lb[0..cl+1]);
    return;
}

@import("s5_store.zag")
// workload.zag — production-path proof driver for the canonical S5 default store.
//
// Runs a realistic deliberate-memory workload (adds, revises, deletes,
// episodes, failure probes) and proves:
//   1. written B/fact on the production path (target <= 6)
//   2. byte-identical determinism (two runs -> identical digest + seal)
//   3. independent revision/deletion semantics (recall-correct, audit-consistent)
//   4. chain tamper-evidence still works with mutation events present
//   5. chunked == unchunked logically (same digest across cslots)
//
// argv: workload <cslots> <N> <profile> <seed> [overflow] [mutation]
//   profile 0 = T (trial-like small ints, [-128,127])
//           1 = M (mixed widths, heavy tail)
//   overflow 0 = revises stay in-width (default path); 1 = force width-overflow
//   mutation 0 = add-only (trial parity); 1 = with revises/deletes (default)
// Zero RNG: all workload values from splitmix64(seed).

// ---------- print helpers ----------
fn w_pnum(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    _zag_free(_zag_slice_ptr(s));
}
fn w_phex(b:[]u8)void {
    let hexd:[]u8="0123456789abcdef";
    let i:i32=0;
    while(i<b.len){
        let by:i32=(b[i] as i32)&255;
        _zag_print(hexd[(by>>4)..(by>>4)+1]);
        _zag_print(hexd[(by&15)..(by&15)+1]);
        i=i+1;
    }
}
fn w_atoi(s:[]u8)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c<48||c>57){break;}
        v=v*10+((c as i64)-48);
        i=i+1;
    }
    return v;
}
// ---------- splitmix64 (deterministic workload) ----------
fn w_lshr(v:i64,bits:i32,mask:i64)i64 { return (v>>bits)&mask; }
fn w_mix(state:i64)i64 {
    let golden:i64=0x9E3779B97F4A7C15 as i64;
    let x:i64=state+golden;
    let z:i64=x;
    z=((z^(w_lshr(z,30,0x3FFFFFFFF))) * (0xBF58476D1CE4E5B9 as i64));
    z=((z^(w_lshr(z,27,0x1FFFFFFFFF))) * (0x94D049BB133111EB as i64));
    return z^(w_lshr(z,31,0x1FFFFFFFF));
}
fn w_draw(seed:i64,idx:i64)i64 {
    let golden:i64=0x9E3779B97F4A7C15 as i64;
    return w_mix(seed+(idx+1)*golden);
}
// non-negative modulo (matches trial's sc_urmod): result in [0, r-1]
fn w_urmod(d:i64,r:i64)i64 {
    let v:i64=d%r;
    if(v<0){v=v+r;}
    return v;
}
fn w_val(profile:i32,draw:i64,slot:i64)i64 {
    if(profile==0){
        return w_urmod(draw,256)-128; // trial-like small ints -> w=1 signed
    }
    // mixed: mostly small, every 20th full-range (heavy tail)
    if(slot%20==0){return draw;}
    return w_urmod(draw,100000)-50000;
}
fn w_newval(profile:i32,draw:i64,slot:i64,overflow:i32)i64 {
    if(profile==0){
        if(overflow!=0&&slot%7==0){return draw;} // force width-overflow reseal path
        return w_urmod(draw,256)-128;
    }
    if(overflow!=0&&slot%5==0){return draw;}
    return w_urmod(draw,100000)-50000;
}

fn main()void {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    let a4:[]u8=_zag_arg(4);
    let a5:[]u8=_zag_arg(5);
    let a6:[]u8=_zag_arg(6);
    if(a1.len==0||a2.len==0||a3.len==0||a4.len==0){
        _zag_println("usage: workload <cslots> <N> <profile 0|1> <seed> [overflow 0|1] [mutation 0|1]");
        return;
    }
    let cslots:i32=w_atoi(a1) as i32;
    let n:i32=w_atoi(a2) as i32;
    let profile:i32=w_atoi(a3) as i32;
    let seed:i64=w_atoi(a4);
    let overflow:i32=0;
    if(a5.len!=0){overflow=w_atoi(a5) as i32;}
    let mutation:i32=1;
    if(a6.len!=0){mutation=w_atoi(a6) as i32;}
    if(cslots<16||n<1||n>2000000||(profile!=0&&profile!=1)){
        _zag_println("bad cfg");return;
    }
    _zag_print("W_CFG,cslots=");w_pnum(cslots as i64);
    _zag_print(",N=");w_pnum(n as i64);
    _zag_print(",profile=");w_pnum(profile as i64);
    _zag_print(",seed=");w_pnum(seed);
    _zag_print(",overflow=");w_pnum(overflow as i64);
    _zag_print(",mutation=");w_pnum(mutation as i64);_zag_println("");
    let st:ScStore=ScStore{.cap=0,.n=0,.cslots=0,.nchunks=0,.chunk_ptrs="",
        .chashes="",.nsealed=0,.events="",.events_n=0,.events_cap=0,
        .seal="",.fill_buf="",.widths="",.clkbase="",
        .learn_gate=0,.clock=0,.ops_add=0,.ops_rev=0,.ops_del=0,
        .ops_verify=0,.ops_audit=0,.ops_find=0};
    if(sc_store_init(n,cslots,&st)!=0){_zag_println("store init failed");return;}
    // ---- adds ----
    sc_episode(&st,1);
    let id:i32=0;
    let add_rc_bad:i32=0;
    while(id<n){
        let v:i64=w_val(profile,w_draw(seed,id as i64),id as i64);
        let slot:i32=-1;
        let rc:i32=sc_add(&st,id,v,&slot);
        if(rc!=0||slot!=id){add_rc_bad=add_rc_bad+1;}
        id=id+1;
    }
    _zag_print("W_ADDS,n=");w_pnum(n as i64);
    _zag_print(",bad=");w_pnum(add_rc_bad as i64);_zag_println("");
    // ---- revises (N/10) ----
    sc_episode(&st,2);
    let nr:i32=0;
    let rev_bad:i32=0;
    if(mutation!=0){
    nr=n/10;
    let ri:i32=0;
    while(ri<nr){
        let rid:i32=(w_draw(seed+7,(ri*2) as i64)%(n as i64)) as i32;
        if(rid<0){rid=-rid;}
        let nv:i64=w_newval(profile,w_draw(seed+11,ri as i64),ri as i64,overflow);
        let rc2:i32=sc_revise(&st,rid,nv);
        if(rc2!=0&&rc2!=2){rev_bad=rev_bad+1;} // rc=2 (tombstoned) impossible here
        ri=ri+1;
    }
    }
    _zag_print("W_REVISES,n=");w_pnum(nr as i64);
    _zag_print(",bad=");w_pnum(rev_bad as i64);_zag_println("");
    // ---- deletes (N/20, strided deterministic ids) ----
    let nd:i32=0;
    let del_bad:i32=0;
    if(mutation!=0){
    nd=n/20;
    let di:i32=0;
    while(di<nd){
        let did:i32=((di*7919)%n) as i32;
        let rc3:i32=sc_delete(&st,did);
        if(rc3!=0){del_bad=del_bad+1;}
        di=di+1;
    }
    }
    _zag_print("W_DELETES,n=");w_pnum(nd as i64);
    _zag_print(",bad=");w_pnum(del_bad as i64);_zag_println("");
    sc_episode(&st,3);
    // ---- failure probes ----
    let fp:i32=0;
    let sxx:i32=-1;
    if(sc_add(&st,0,999,&sxx)!=1){fp=fp+1;}          // dupe add -> rc 1
    if(mutation!=0){
    if(sc_revise(&st,n+5,1)!=1){fp=fp+1;}            // revise absent -> rc 1
    if(sc_delete(&st,n+5)!=1){fp=fp+1;}              // delete absent -> rc 1
    let dd0:i32=(0*7919)%n;                            // already deleted above
    if(sc_delete(&st,dd0)!=2){fp=fp+1;}              // delete twice -> rc 2
    if(sc_revise(&st,dd0,123)!=2){fp=fp+1;}          // revise tombstoned -> rc 2
    let vv:i64=0;
    if(sc_recall(&st,n+7,&vv)!=0){fp=fp+1;}          // never-added -> absent
    if(sc_recall(&st,dd0,&vv)!=0){fp=fp+1;}          // deleted -> absent
    }else{
    let vv2:i64=0;
    if(sc_recall(&st,n+7,&vv2)!=0){fp=fp+1;}         // never-added -> absent
    if(sc_recall(&st,0,&vv2)!=1){fp=fp+1;}           // id 0 present
    }
    _zag_print("W_FAILURE_PROBES,bad=");w_pnum(fp as i64);_zag_println("");
    // ---- seal + verify ----
    sc_seal_tail(&st);
    sc_seal_final(&st);
    let vr:i32=sc_manifest_verify(&st);
    _zag_print("W_MANIFEST_VERIFY,rc=");w_pnum(vr as i64);_zag_println("");
    let rp:i32=sc_replay_check(&st);
    _zag_print("W_REPLAY_CHECK,rc=");w_pnum(rp as i64);_zag_println("");
    // ---- tamper demos (restore after) ----
    let c0:[]u8=sc_slot_chunk(&st,0);
    let sv:u8=c0[0];
    c0[0]=sv^1;
    let vt1:i32=sc_manifest_verify(&st);
    c0[0]=sv;
    let evb:[]u8=st.events;
    let sv2:u8=evb[0];
    evb[0]=sv2^1;
    let vt2:i32=sc_manifest_verify(&st);
    evb[0]=sv2;
    let vt3:i32=sc_manifest_verify(&st);
    _zag_print("W_TAMPER,slot=");w_pnum(vt1 as i64);
    _zag_print(",event=");w_pnum(vt2 as i64);
    _zag_print(",restored=");w_pnum(vt3 as i64);_zag_println("");
    // ---- accounting (written basis) ----
    let wb:i64=sc_written_bytes(&st);
    let live:i32=sc_live_count(&st);
    _zag_print("W_MEM,written_bytes=");w_pnum(wb);
    _zag_print(",n=");w_pnum(st.n as i64);
    _zag_print(",live=");w_pnum(live as i64);
    _zag_print(",millibpf_ever=");w_pnum((wb*1000)/(st.n as i64));
    _zag_print(",millibpf_live=");w_pnum((wb*1000)/(live as i64));
    _zag_print(",events=");w_pnum(st.events_n as i64);
    _zag_print(",sealed_chunks=");w_pnum(st.nsealed as i64);_zag_println("");
    // ---- width histogram ----
    let ci:i32=0;
    while(ci<st.nsealed){
        let wt:i32=(st.widths[ci] as i32)&255;
        _zag_print("W_CHUNK,c=");w_pnum(ci as i64);
        _zag_print(",wtag=");w_pnum(wt as i64);_zag_println("");
        ci=ci+1;
    }
    // ---- determinism: digest + seal ----
    let dg:i64=sc_digest(&st);
    _zag_print("W_DIGEST,fnv1a=");
    let hexd:[]u8="0123456789abcdef";
    let sh:[]u8=sc_alloc(17);
    let ni:i32=0;
    while(ni<16){
        let shift:i64=((15-ni)*4) as i64;
        let nib:i32=((dg>>shift)&15) as i32;
        sh[ni]=hexd[nib];
        ni=ni+1;
    }
    sh[16]=0;
    _zag_print(sh[0..16]);_zag_println("");
    _zag_print("W_SEAL,sha256=");
    w_phex(st.seal);_zag_println("");
    _zag_print("W_OPS,add=");w_pnum(st.ops_add);
    _zag_print(",rev=");w_pnum(st.ops_rev);
    _zag_print(",del=");w_pnum(st.ops_del);
    _zag_print(",audit_events=");w_pnum(st.ops_audit);_zag_println("");
    _zag_println("W_DONE");
}

// scale_learner.zag — scale driver: pure-Zag deliberate-memory learner at scale.
//
// Lineage: championship class-3 standardized class-4 (driver_sol.zag,
// t5_core.zag). The decision core (evidence -> eliminative verify ->
// deliberate add, 16-word audit layout, lifecycle consts) is ported
// identically. Per-fact storage is chunked (no slice > 2^25 at any N);
// the duplicate check is a dense id->slot index (provably identical to
// t5_slot_find for dense ids; the prototype's O(n) scan would falsely trip
// the superlinear-cost kill bar).
//
// Truth: harness-side, from real Gutenberg bytes at runtime
// (FACTSPEC.md, frozen 2026-09-21). 24 categories, splitmix64 planted
// falsehoods. The learner NEVER calls truth functions.
//
// argv: scale_learner <train|eval> <N> <C> <M> <P> <rep> <texts_dir>
//   C=24, N=C*M. rep is accepted but NOT printed (byte-identical reps).
//
// Build: znc_linux_x86_64_abed8aa1 scale_learner.zag -o scale_learner --no-analyze
// See BUILD.md. Do not commit (lead commits via commit_big_files.py).

fn sc_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn sc_g32(b:[]u8,o:i32)i32 {
    let v:i32=0;
    v=v|((b[o] as i32)&255);
    v=v|(((b[o+1] as i32)&255)<<8);
    v=v|(((b[o+2] as i32)&255)<<16);
    v=v|(((b[o+3] as i32)&255)<<24);
    return v;
}
fn sc_s32(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
}
fn sc_g64(b:[]u8,o:i32)i64 {
    let v:i64=0;
    v=v|((b[o] as i64)&255);
    v=v|(((b[o+1] as i64)&255)<<8);
    v=v|(((b[o+2] as i64)&255)<<16);
    v=v|(((b[o+3] as i64)&255)<<24);
    v=v|(((b[o+4] as i64)&255)<<32);
    v=v|(((b[o+5] as i64)&255)<<40);
    v=v|(((b[o+6] as i64)&255)<<48);
    v=v|(((b[o+7] as i64)&255)<<56);
    return v;
}
fn sc_s64(b:[]u8,o:i64,v:i64)void {
    let o32:i32=o as i32;
    b[o32]=(v&255) as u8;
    b[o32+1]=((v>>8)&255) as u8;
    b[o32+2]=((v>>16)&255) as u8;
    b[o32+3]=((v>>24)&255) as u8;
    b[o32+4]=((v>>32)&255) as u8;
    b[o32+5]=((v>>40)&255) as u8;
    b[o32+6]=((v>>48)&255) as u8;
    b[o32+7]=((v>>56)&255) as u8;
}
fn sc_pnum(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    _zag_free(_zag_slice_ptr(s));
}

// ---------- splitmix64 (FACTSPEC.md section 4) ----------
// Zag's >> on i64 is arithmetic; splitmix needs logical shifts.
// Masking with (2^(64-bits)-1) recovers the logical shift exactly.
fn sc_lshr(v:i64,bits:i32,mask:i64)i64 { return (v>>bits)&mask; }
fn sc_mix(state:i64)i64 {
    let golden:i64=0x9E3779B97F4A7C15 as i64;
    let x:i64=state+golden;
    let z:i64=x;
    z=((z^(sc_lshr(z,30,0x3FFFFFFFF))) * (0xBF58476D1CE4E5B9 as i64));
    z=((z^(sc_lshr(z,27,0x1FFFFFFFFF))) * (0x94D049BB133111EB as i64));
    return z^(sc_lshr(z,31,0x1FFFFFFFF));
}
fn sc_draw(seed:i64,idx:i64)i64 {
    let golden:i64=0x9E3779B97F4A7C15 as i64;
    return sc_mix(seed+(idx+1)*golden);
}

// ---------- raw-syscall file IO ----------
// open(2)=2 O_RDONLY=0; read=0; close=3. Exactly 7 args (znc rule).
fn z_cstr(s:[]u8)[]u8 {
    let n:i32=s.len;
    let b:[]u8=sc_alloc(n+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<n){b[i]=s[i];i=i+1;}
    b[n]=0;
    return b;
}
fn sc_open_rdonly(path:[]u8)i64 {
    let c:[]u8=z_cstr(path);
    if(c.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(c) as i64,0,0,0,0,0);
    _zag_free(_zag_slice_ptr(c));
    return fd;
}
// read up to buf.len bytes into caller-reused buf; returns count, -1 on error
fn sc_read_into(fd:i64,buf:[]u8)i32 {
    if(buf.len<1){return -1;}
    let at:i32=0;
    while(at<buf.len){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(buf.len-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<0){return -1;}
        if(n==0){break;}
        at=at+(n as i32);
    }
    return at;
}
fn sc_digit(c:u8)i32 {
    if(c>=48 && c<=57){return (c as i32)-48;}
    return -1;
}
fn sc_atoi(s:[]u8)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<s.len){
        let d:i32=sc_digit(s[i]);
        if(d<0){break;}
        v=v*10+(d as i64);
        i=i+1;
    }
    return v;
}
fn sc_text_path(dir:[]u8,t:i32)[]u8 {
    let b:[]u8=sc_alloc(dir.len+12);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<dir.len){b[i]=dir[i];i=i+1;}
    b[dir.len]=47;
    let p:i32=dir.len+1;
    b[p]=116;b[p+1]=101;b[p+2]=120;b[p+3]=116;b[p+4]=95;
    b[p+5]=(48+t) as u8;
    b[p+6]=46;b[p+7]=116;b[p+8]=120;b[p+9]=116;
    return b[0..dir.len+11];
}
fn sc_tnix_path(dir:[]u8,t:i32)[]u8 {
    let b:[]u8=sc_alloc(dir.len+13);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<dir.len){b[i]=dir[i];i=i+1;}
    b[dir.len]=47;
    let p:i32=dir.len+1;
    b[p]=105;b[p+1]=110;b[p+2]=100;b[p+3]=101;b[p+4]=120;b[p+5]=95;
    b[p+6]=(48+t) as u8;
    b[p+7]=46;b[p+8]=116;b[p+9]=110;b[p+10]=105;b[p+11]=120;
    return b[0..dir.len+13];
}
fn sc_meta_path(dir:[]u8)[]u8 {
    let b:[]u8=sc_alloc(dir.len+10);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<dir.len){b[i]=dir[i];i=i+1;}
    b[dir.len]=47;
    let p:i32=dir.len+1;
    b[p]=109;b[p+1]=101;b[p+2]=116;b[p+3]=97;b[p+4]=46;
    b[p+5]=106;b[p+6]=115;b[p+7]=111;b[p+8]=110;
    return b[0..dir.len+10];
}

// ---------- corpus index (FACTSPEC.md) ----------
// Words are re-derived in Zag (byte scan, ASCII-lowercased boundaries);
// sentence/paragraph attribution comes from the frozen .tnix indexes
// (word_sent, word_para, sent_para) by word INDEX (the word sequence is
// identical; tnix char offsets are not used).

struct ScCorpus {
    wstart:[]u8,   // i32 per word: byte offset into textbytes
    wlen:[]u8,     // u8 per word
    wsent:[]u8,    // i32 per word: sentence idx (text-local)
    wpara:[]u8,    // i32 per word: paragraph idx (text-local)
    snw:[]u8,      // i32 per sentence: word count
    sfirst:[]u8,   // i32 per sentence: global word idx of first word, -1 if none
    pnw:[]u8,      // i32 per paragraph: word count
    pns:[]u8,      // i32 per paragraph: sentence count
    textbytes:[]u8,
    wbase:[]u8,    // i32[10]: global word base per text
    sbase:[]u8,    // i32[10]: global sentence base per text
    pbase:[]u8,    // i32[10]: global paragraph base per text
    bbase:[]u8,    // i32[10]: byte base per text
    nwords:[]u8,   // i32[10]
    nsents:[]u8,   // i32[10]
    nparas:[]u8,   // i32[10]
    ftab:[]u8,     // i64[10]: freq table pointer per text
    fmask:[]u8,    // i32[10]: table mask (size-1)
    unique:[]u8,   // i32[10]
    longest:[]u8,  // i32[10]
    totlet:[]u8,   // i64[10]: total letters per text
    year:[]u8,     // i32[10]
    titlew:[]u8    // i32[10]
}

// ASCII-lowercase a byte (for word content)
fn sc_low(b:u8)u8 {
    if(b>=65 && b<=90){return (b+32) as u8;}
    return b;
}
// is this byte a word char (after ASCII-lowercasing)? [a-zA-Z]
fn sc_isword(b:u8)i32 {
    if(b>=97 && b<=122){return 1;}
    if(b>=65 && b<=90){return 1;}
    return 0;
}
// count words in bytes (for sizing)
fn sc_count_words(b:[]u8)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<b.len){
        if(sc_isword(b[i])==1){
            n=n+1;
            i=i+1;
            while(i<b.len && sc_isword(b[i])==1){i=i+1;}
        } else { i=i+1; }
    }
    return n;
}
// FNV-1a 32-bit over lowercased word bytes
fn sc_word_hash(bs:[]u8,start:i32,len:i32)i32 {
    let h:i32=(2166136261 as i64) as i32;
    let i:i32=0;
    while(i<len){
        let b:i32=(sc_low(bs[start+i]) as i32);
        h=(h^b)*16777619;
        i=i+1;
    }
    return h;
}
fn sc_word_eq(bs:[]u8,s1:i32,l1:i32,cs:[]u8,s2:i32,l2:i32)i32 {
    if(l1!=l2){return 0;}
    let i:i32=0;
    while(i<l1){
        if(sc_low(bs[s1+i])!=sc_low(cs[s2+i])){return 0;}
        i=i+1;
    }
    return 1;
}
// freq table slot: hash@0(i32) start@4(i32) len@8(i32) count@12(i32); hash==0 empty
fn sc_freq_insert(ftab:[]u8,fmask:i32,bs:[]u8,ws:i32,wl:i32,unique:*i32)void {
    let h:i32=sc_word_hash(bs,ws,wl)|1;
    let idx:i32=h&fmask;
    let done:i32=0;
    while(done==0){
        let sh:i32=sc_g32(ftab,idx*16);
        if(sh==0){
            sc_s32(ftab,idx*16,h);
            sc_s32(ftab,idx*16+4,ws);
            sc_s32(ftab,idx*16+8,wl);
            sc_s32(ftab,idx*16+12,1);
            unique.*=unique.*+1;
            done=1;
        } else {
            if(sh==h){
                let ss:i32=sc_g32(ftab,idx*16+4);
                let sl:i32=sc_g32(ftab,idx*16+8);
                if(sl==wl && sc_word_eq(bs,ss,sl,bs,ws,wl)==1){
                    let c:i32=sc_g32(ftab,idx*16+12);
                    sc_s32(ftab,idx*16+12,c+1);
                    done=1;
                }
            }
            if(done==0){ idx=(idx+1)&fmask; }
        }
    }
}
fn sc_freq_lookup(ftab:[]u8,fmask:i32,bs:[]u8,ws:i32,wl:i32)i32 {
    let h:i32=sc_word_hash(bs,ws,wl)|1;
    let idx:i32=h&fmask;
    let done:i32=0;
    let res:i32=0;
    while(done==0){
        let sh:i32=sc_g32(ftab,idx*16);
        if(sh==0){ done=1; }
        else {
            if(sh==h){
                let ss:i32=sc_g32(ftab,idx*16+4);
                let sl:i32=sc_g32(ftab,idx*16+8);
                if(sl==wl && sc_word_eq(bs,ss,sl,bs,ws,wl)==1){
                    res=sc_g32(ftab,idx*16+12);
                    done=1;
                }
            }
            if(done==0){ idx=(idx+1)&fmask; }
        }
    }
    return res;
}

// read tnix header: returns 0 ok; fills nwords/nsents/nparas; -1 on error
fn sc_tnix_header(dir:[]u8,t:i32,nw:*i32,ns:*i32,np:*i32)i32 {
    let path:[]u8=sc_tnix_path(dir,t);
    let fd:i64=sc_open_rdonly(path);
    _zag_free(_zag_slice_ptr(path));
    if(fd<0){return -1;}
    let hdr:[]u8=sc_alloc(32);
    if(hdr.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return -1;}
    let nb:i32=sc_read_into(fd,hdr);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(nb<32){_zag_free(_zag_slice_ptr(hdr));return -1;}
    // magic TNIX0001
    if(hdr[0]!=84||hdr[1]!=78||hdr[2]!=73||hdr[3]!=88||hdr[4]!=48||hdr[5]!=48||hdr[6]!=48||hdr[7]!=49){
        _zag_free(_zag_slice_ptr(hdr));return -1;
    }
    nw.*=sc_g64(hdr,8) as i32;
    ns.*=sc_g64(hdr,16) as i32;
    np.*=sc_g64(hdr,24) as i32;
    _zag_free(_zag_slice_ptr(hdr));
    return 0;
}

// read a u32 array from tnix at byte offset; returns array (i32 per entry)
fn sc_tnix_u32array(dir:[]u8,t:i32,byteoff:i64,count:i32)[]u8 {
    let path:[]u8=sc_tnix_path(dir,t);
    let fd:i64=sc_open_rdonly(path);
    _zag_free(_zag_slice_ptr(path));
    let empty:[]u8="";
    if(fd<0){return empty;}
    // seek: use lseek(8)=8, SEEK_SET=0
    let sr:i64=_zag_raw_syscall(8,fd,byteoff,0,0,0,0);
    if(sr!=byteoff){_zag_raw_syscall(3,fd,0,0,0,0,0);return empty;}
    let buf:[]u8=sc_alloc(count*4);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return empty;}
    let nb:i32=sc_read_into(fd,buf);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(nb<count*4){_zag_free(_zag_slice_ptr(buf));return empty;}
    return buf;
}

// minimal meta.json parser: extracts 10 (pub_year, title_words) in order
fn sc_parse_meta(dir:[]u8,cx:*ScCorpus)i32 {
    let path:[]u8=sc_meta_path(dir);
    let fd:i64=sc_open_rdonly(path);
    _zag_free(_zag_slice_ptr(path));
    if(fd<0){return -1;}
    let buf:[]u8=sc_alloc(8192);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return -1;}
    let nb:i32=sc_read_into(fd,buf);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(nb<100){_zag_free(_zag_slice_ptr(buf));return -1;}
    let year:[]u8=cx.*.year;
    let titlew:[]u8=cx.*.titlew;
    let n:i32=0;
    let i:i32=0;
    while(i<nb && n<10){
        // look for "pub_year"
        if(i+9<nb && buf[i]==34 && buf[i+1]==112 && buf[i+2]==117 && buf[i+3]==98 &&
           buf[i+4]==95 && buf[i+5]==121 && buf[i+6]==101 && buf[i+7]==97 && buf[i+8]==114 && buf[i+9]==34){
            i=i+10;
            while(i<nb && (buf[i]<48 || buf[i]>57)){i=i+1;}
            let v:i32=0;
            while(i<nb && buf[i]>=48 && buf[i]<=57){v=v*10+((buf[i] as i32)-48);i=i+1;}
            sc_s32(year,n*4,v);
            // now find "title_words" after this
            while(i<nb){
                if(i+12<nb && buf[i]==34 && buf[i+1]==116 && buf[i+2]==105 && buf[i+3]==116 &&
                   buf[i+4]==108 && buf[i+5]==101 && buf[i+6]==95 && buf[i+7]==119 && buf[i+8]==111 &&
                   buf[i+9]==114 && buf[i+10]==100 && buf[i+11]==115 && buf[i+12]==34){
                    i=i+13;
                    while(i<nb && (buf[i]<48 || buf[i]>57)){i=i+1;}
                    let w:i32=0;
                    while(i<nb && buf[i]>=48 && buf[i]<=57){w=w*10+((buf[i] as i32)-48);i=i+1;}
                    sc_s32(titlew,n*4,w);
                    break;
                }
                i=i+1;
            }
            n=n+1;
        } else { i=i+1; }
    }
    _zag_free(_zag_slice_ptr(buf));
    if(n!=10){return -1;}
    return 0;
}

// full corpus init; returns total words, -1 on error
fn sc_corpus_init(dir:[]u8,cx:*ScCorpus)i32 {
    // per-text counts (pass 1)
    let nw:[]u8=sc_alloc(40); if(nw.len==0){return -1;}
    let ns:[]u8=sc_alloc(40); if(ns.len==0){return -1;}
    let np:[]u8=sc_alloc(40); if(np.len==0){return -1;}
    let blen:[]u8=sc_alloc(40); if(blen.len==0){return -1;}
    let rbuf:[]u8=sc_alloc(2097152);
    if(rbuf.len==0){return -1;}
    let t:i32=0;
    while(t<10){
        let path:[]u8=sc_text_path(dir,t);
        let fd:i64=sc_open_rdonly(path);
        _zag_free(_zag_slice_ptr(path));
        if(fd<0){return -1;}
        let nb:i32=sc_read_into(fd,rbuf);
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        if(nb<1){return -1;}
        sc_s32(blen,t*4,nb);
        let b:[]u8=rbuf[0..nb];
        let c:i32=sc_count_words(b);
        sc_s32(nw,t*4,c);
        let tnw:i32=0; let tns:i32=0; let tnp:i32=0;
        if(sc_tnix_header(dir,t,&tnw,&tns,&tnp)!=0){return -1;}
        if(tnw!=c){return -1;}  // word sequence must match frozen index
        sc_s32(ns,t*4,tns);
        sc_s32(np,t*4,tnp);
        t=t+1;
    }
    // totals
    let tw:i32=0; let tsw:i32=0; let tpw:i32=0; let tb:i32=0;
    t=0;
    while(t<10){
        tw=tw+sc_g32(nw,t*4);
        tsw=tsw+sc_g32(ns,t*4);
        tpw=tpw+sc_g32(np,t*4);
        tb=tb+sc_g32(blen,t*4);
        t=t+1;
    }
    // allocate concatenated arrays
    let wstart:[]u8=sc_alloc(tw*4); if(wstart.len==0){return -1;}
    let wlen:[]u8=sc_alloc(tw); if(wlen.len==0){return -1;}
    let wsent:[]u8=sc_alloc(tw*4); if(wsent.len==0){return -1;}
    let wpara:[]u8=sc_alloc(tw*4); if(wpara.len==0){return -1;}
    let snw:[]u8=sc_alloc(tsw*4); if(snw.len==0){return -1;}
    let sfirst:[]u8=sc_alloc(tsw*4); if(sfirst.len==0){return -1;}
    let pnw:[]u8=sc_alloc(tpw*4); if(pnw.len==0){return -1;}
    let pns:[]u8=sc_alloc(tpw*4); if(pns.len==0){return -1;}
    let textbytes:[]u8=sc_alloc(tb); if(textbytes.len==0){return -1;}
    let wbase:[]u8=sc_alloc(40); if(wbase.len==0){return -1;}
    let sbase:[]u8=sc_alloc(40); if(sbase.len==0){return -1;}
    let pbase:[]u8=sc_alloc(40); if(pbase.len==0){return -1;}
    let bbase:[]u8=sc_alloc(40); if(bbase.len==0){return -1;}
    let ftab:[]u8=sc_alloc(80); if(ftab.len==0){return -1;}
    let fmask:[]u8=sc_alloc(40); if(fmask.len==0){return -1;}
    let unique:[]u8=sc_alloc(40); if(unique.len==0){return -1;}
    let longest:[]u8=sc_alloc(40); if(longest.len==0){return -1;}
    let totlet:[]u8=sc_alloc(80); if(totlet.len==0){return -1;}
    let year:[]u8=sc_alloc(40); if(year.len==0){return -1;}
    let titlew:[]u8=sc_alloc(40); if(titlew.len==0){return -1;}
    // init sfirst to -1, snw/pnw/pns to 0
    let i:i32=0;
    while(i<tsw){sc_s32(sfirst,i*4,-1);i=i+1;}
    cx.*.wstart=wstart; cx.*.wlen=wlen; cx.*.wsent=wsent; cx.*.wpara=wpara;
    cx.*.snw=snw; cx.*.sfirst=sfirst; cx.*.pnw=pnw; cx.*.pns=pns;
    cx.*.textbytes=textbytes;
    cx.*.wbase=wbase; cx.*.sbase=sbase; cx.*.pbase=pbase; cx.*.bbase=bbase;
    cx.*.nwords=nw; cx.*.nsents=ns; cx.*.nparas=np;
    cx.*.ftab=ftab; cx.*.fmask=fmask; cx.*.unique=unique; cx.*.longest=longest;
    cx.*.totlet=totlet; cx.*.year=year; cx.*.titlew=titlew;
    // pass 2: fill per text
    let wb:i32=0; let sb:i32=0; let pb:i32=0; let bb:i32=0;
    t=0;
    while(t<10){
        let cnw:i32=sc_g32(nw,t*4);
        let cns:i32=sc_g32(ns,t*4);
        let cnp:i32=sc_g32(np,t*4);
        let cbl:i32=sc_g32(blen,t*4);
        sc_s32(wbase,t*4,wb); sc_s32(sbase,t*4,sb);
        sc_s32(pbase,t*4,pb); sc_s32(bbase,t*4,bb);
        // re-read text bytes into concatenated buffer
        let path:[]u8=sc_text_path(dir,t);
        let fd:i64=sc_open_rdonly(path);
        _zag_free(_zag_slice_ptr(path));
        if(fd<0){return -1;}
        let dst:[]u8=textbytes[bb..bb+cbl];
        let nb2:i32=sc_read_into(fd,dst);
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        if(nb2!=cbl){return -1;}
        // scan words
        let fsize:i32=1;
        while(fsize<cnw*2){fsize=fsize*2;}
        let ft:[]u8=sc_alloc(fsize*16);
        if(ft.len==0){return -1;}
        let fmk:i32=fsize-1;
        sc_s64(ftab,(t*8) as i64,_zag_slice_ptr(ft) as i64);
        sc_s32(fmask,t*4,fmk);
        let uq:i32=0;
        let lg:i32=0;
        let tl:i64=0;
        let wi:i32=0;
        let bi:i32=0;
        while(bi<cbl){
            if(sc_isword(dst[bi])==1){
                let st0:i32=bi;
                bi=bi+1;
                while(bi<cbl && sc_isword(dst[bi])==1){bi=bi+1;}
                let wl0:i32=bi-st0;
                let gk:i32=wb+wi;
                sc_s32(wstart,gk*4,bb+st0);
                wlen[gk]=wl0 as u8;
                if(wl0>lg){lg=wl0;}
                tl=tl+(wl0 as i64);
                sc_freq_insert(ft,fmk,textbytes,bb+st0,wl0,&uq);
                wi=wi+1;
            } else { bi=bi+1; }
        }
        if(wi!=cnw){return -1;}
        sc_s32(unique,t*4,uq);
        sc_s32(longest,t*4,lg);
        sc_s64(totlet,(t*8) as i64,tl);
        // read tnix word_sent, word_para, sent_para
        // layout: 32 + 4*nw (word_start) + 4*nw (word_sent) + 4*nw (word_para)
        //         + 4*ns (sent_start) + 4*ns (sent_end) + 4*ns (sent_para)
        let ws_off:i64=32+(cnw as i64)*4;
        let wp_off:i64=ws_off+(cnw as i64)*4;
        let sp_off:i64=wp_off+(cnw as i64)*4+(cns as i64)*8;
        let wsarr:[]u8=sc_tnix_u32array(dir,t,ws_off,cnw);
        if(wsarr.len==0){return -1;}
        let wparr:[]u8=sc_tnix_u32array(dir,t,wp_off,cnw);
        if(wparr.len==0){return -1;}
        let sparr:[]u8=sc_tnix_u32array(dir,t,sp_off,cns);
        if(sparr.len==0){return -1;}
        let k:i32=0;
        while(k<cnw){
            let gk2:i32=wb+k;
            let sidx:i32=sc_g32(wsarr,k*4);
            let pidx:i32=sc_g32(wparr,k*4);
            sc_s32(wsent,gk2*4,sidx);
            sc_s32(wpara,gk2*4,pidx);
            // sent_nwords, sent_first
            let gs:i32=sb+sidx;
            let c0:i32=sc_g32(snw,gs*4);
            sc_s32(snw,gs*4,c0+1);
            if(sc_g32(sfirst,gs*4)==-1){sc_s32(sfirst,gs*4,gk2);}
            // para_nwords
            let gp:i32=pb+pidx;
            let c1:i32=sc_g32(pnw,gp*4);
            sc_s32(pnw,gp*4,c1+1);
            k=k+1;
        }
        // para_nsents from sent_para
        let s2:i32=0;
        while(s2<cns){
            let pidx2:i32=sc_g32(sparr,s2*4);
            let gp2:i32=pb+pidx2;
            let c2:i32=sc_g32(pns,gp2*4);
            sc_s32(pns,gp2*4,c2+1);
            s2=s2+1;
        }
        _zag_free(_zag_slice_ptr(wsarr));
        _zag_free(_zag_slice_ptr(wparr));
        _zag_free(_zag_slice_ptr(sparr));
        wb=wb+cnw; sb=sb+cns; pb=pb+cnp; bb=bb+cbl;
        t=t+1;
    }
    _zag_free(_zag_slice_ptr(rbuf));
    _zag_free(_zag_slice_ptr(blen));
    if(sc_parse_meta(dir,cx)!=0){return -1;}
    return tw;
}

// ---------- FACTSPEC.md truth ----------

fn sc_vmin(c:i32)i64 {
    if(c==0){return 1;} if(c==1){return 1;} if(c==2){return 1;}
    if(c==3){return 0;} if(c==4){return 0;} if(c==5){return 0;}
    if(c==6){return 1;} if(c==7){return 0;} if(c==8){return 0;}
    if(c==9){return 0;} if(c==10){return 1;} if(c==11){return 0;}
    if(c==12){return 0;} if(c==13){return 0;} if(c==14){return 1;}
    if(c==15){return 0;} if(c==16){return 27439;} if(c==17){return 1655;}
    if(c==18){return 799;} if(c==19){return 2579;} if(c==20){return 1;}
    if(c==21){return 100;} if(c==22){return 1600;} return 1;
}
fn sc_vmax(c:i32)i64 {
    if(c==0){return 20;} if(c==1){return 26;} if(c==2){return 26;}
    if(c==3){return 20;} if(c==4){return 20;} if(c==5){return 20;}
    if(c==6){return 26;} if(c==7){return 96;} if(c==8){return 401;}
    if(c==9){return 400;} if(c==10){return 2687;} if(c==11){return 134;}
    if(c==12){return 20;} if(c==13){return 20;} if(c==14){return 14537;}
    if(c==15){return 1;} if(c==16){return 219066;} if(c==17){return 10831;}
    if(c==18){return 4117;} if(c==19){return 16957;} if(c==20){return 20;}
    if(c==21){return 2000;} if(c==22){return 2000;} return 16;
}
// (2^64 % r), r > 0
fn sc_pow2mod64(r:i64)i64 {
    let rem:i64=1;
    let i:i32=0;
    while(i<64){ rem=(rem*2)%r; i=i+1; }
    return rem;
}
// (rv as u64) % (r as u64), r > 0
fn sc_urmod(rv:i64,r:i64)i64 {
    if(rv>=0){return rv%r;}
    let rem64:i64=sc_pow2mod64(r);
    let v:i64=(rem64+rv)%r;
    if(v<0){v=v+r;}
    return v;
}
fn sc_is_false(id:i32)i32 {
    let d:i64=sc_draw(20260921,id as i64);
    if(sc_urmod(d,100)<5){return 1;}
    return 0;
}
fn sc_supplied(id:i32,c:i32,truth:i64)i64 {
    if(sc_is_false(id)==0){return truth;}
    let vmin:i64=sc_vmin(c);
    let vmax:i64=sc_vmax(c);
    let r:i64=vmax-vmin;
    let rv:i64=sc_draw(20260921,((id^0x9E37) as i64));
    let rm:i64=sc_urmod(rv,r);
    let off:i64=(truth-vmin+1+rm)%(r+1);
    return vmin+off;
}

// vowel test on lowercased byte
fn sc_isvowel(b:u8)i32 {
    if(b==97||b==101||b==105||b==111||b==117){return 1;}
    return 0;
}

// truth of fact (c, t, k); k = word idx (text-local) for c<16, unused for c>=16
fn sc_fact_truth(cx:*ScCorpus,c:i32,t:i32,k:i32)i64 {
    let wbase:[]u8=cx.*.wbase;
    let sbase:[]u8=cx.*.sbase;
    let pbase:[]u8=cx.*.pbase;
    let bbase:[]u8=cx.*.bbase;
    let nwords:[]u8=cx.*.nwords;
    if(c<16){
        let wb:i32=sc_g32(wbase,t*4);
        let gk:i32=wb+k;
        let wstart:[]u8=cx.*.wstart;
        let wlen:[]u8=cx.*.wlen;
        let wsent:[]u8=cx.*.wsent;
        let wpara:[]u8=cx.*.wpara;
        let bs:[]u8=cx.*.textbytes;
        let ws:i32=sc_g32(wstart,gk*4);
        let wl:i32=wlen[gk] as i32;
        if(c==0){return wl as i64;}
        if(c==1){return ((sc_low(bs[ws]) as i32)-97+1) as i64;}
        if(c==2){return ((sc_low(bs[ws+wl-1]) as i32)-97+1) as i64;}
        if(c==3||c==4||c==5){
            let nv:i32=0; let ng:i32=0; let in_v:i32=0;
            let j:i32=0;
            while(j<wl){
                let v:i32=sc_isvowel(sc_low(bs[ws+j]));
                nv=nv+v;
                if(v==1){ if(in_v==0){ng=ng+1;in_v=1;} }
                else { in_v=0; }
                j=j+1;
            }
            if(c==3){return nv as i64;}
            if(c==4){return (wl-nv) as i64;}
            return ng as i64;
        }
        if(c==6){
            let mask:i32=0;
            let j2:i32=0;
            while(j2<wl){
                let bit:i32=(sc_low(bs[ws+j2]) as i32)-97;
                mask=mask|(1<<bit);
                j2=j2+1;
            }
            let nd:i32=0; let b2:i32=0;
            while(b2<26){ if((mask&(1<<b2))!=0){nd=nd+1;} b2=b2+1; }
            return nd as i64;
        }
        if(c==7){
            let h:i64=0; let p:i64=1;
            let j3:i32=0;
            while(j3<wl){
                let o:i64=(sc_low(bs[ws+j3]) as i64);
                h=(h+o*p)%97;
                p=(p*31)%97;
                j3=j3+1;
            }
            return h;
        }
        let sb2:i32=sc_g32(sbase,t*4);
        let pb2:i32=sc_g32(pbase,t*4);
        let snw:[]u8=cx.*.snw;
        let sfirst:[]u8=cx.*.sfirst;
        let pnw:[]u8=cx.*.pnw;
        let pns:[]u8=cx.*.pns;
        if(c==8){
            let si:i32=sc_g32(wsent,gk*4);
            return sc_g32(snw,(sb2+si)*4) as i64;
        }
        if(c==9){
            let si2:i32=sc_g32(wsent,gk*4);
            let f:i32=sc_g32(sfirst,(sb2+si2)*4);
            return (gk-f) as i64;
        }
        if(c==10){
            let pi:i32=sc_g32(wpara,gk*4);
            return sc_g32(pnw,(pb2+pi)*4) as i64;
        }
        if(c==11){
            let pi2:i32=sc_g32(wpara,gk*4);
            return sc_g32(pns,(pb2+pi2)*4) as i64;
        }
        if(c==12){
            let W:i32=sc_g32(nwords,t*4);
            if(k+1>=W){return 0;}
            return wlen[gk+1] as i64;
        }
        if(c==13){
            if(k==0){return 0;}
            return wlen[gk-1] as i64;
        }
        if(c==14){
            let ftab:[]u8=cx.*.ftab;
            let fmask:[]u8=cx.*.fmask;
            let fp:i64=sc_g64(ftab,t*8);
            let fcp:*u8=fp as *u8;
            let ft2:[]u8=fcp[0..((sc_g32(fmask,t*4)+1)*16)];
            return sc_freq_lookup(ft2,sc_g32(fmask,t*4),bs,ws,wl) as i64;
        }
        // c==15
        if(wl>8){return 1;}
        return 0;
    }
    // text-level categories
    if(c==16){return sc_g32(nwords,t*4) as i64;}
    if(c==17){return sc_g32(cx.*.nsents,t*4) as i64;}
    if(c==18){return sc_g32(cx.*.nparas,t*4) as i64;}
    if(c==19){return sc_g32(cx.*.unique,t*4) as i64;}
    if(c==20){return sc_g32(cx.*.longest,t*4) as i64;}
    if(c==21){
        let tl:i64=sc_g64(cx.*.totlet,t*8);
        let W2:i64=sc_g32(nwords,t*4) as i64;
        return (100*tl)/W2;
    }
    if(c==22){return sc_g32(cx.*.year,t*4) as i64;}
    return sc_g32(cx.*.titlew,t*4) as i64;
}

// ================= LEARNER CORE (ported from t5_core.zag) =================
// Decision logic identical: evidence -> eliminative verify -> deliberate
// add; same 16-word audit layout; same lifecycle constants. Storage is
// chunked; duplicate check is a dense id->slot index.

struct ScStore {
    cap:i32, n:i32,
    nchunks:i32, chunk_ptrs:[]u8,
    nidxchunks:i32, idx_ptrs:[]u8,
    audit_ptrs:[]u8,
    audit_nchunks:i32, audit_n:i32, audit_cap:i32,
    learn_gate:i32, clock:i32,
    ops_add:i64, ops_verify:i64, ops_audit:i64, ops_find:i64
}
const SC_CHUNK_SLOTS:i32=4096;
const SC_CHUNK_BYTES:i32=81920; // S1: 4096 x 20B (id field removed)
const SC_IDX_CHUNK_BYTES:i32=16384;
const SC_AUDIT_CHUNK_RECS:i32=16384;
const SC_AUDIT_CHUNK_BYTES:i32=393216; // S1: 16384 x 24B compact records
fn sc_store_init(cap:i32,s:*ScStore)i32 {
    let nchunks:i32=(cap+4095)/SC_CHUNK_SLOTS;
    let cptrs:[]u8=sc_alloc(nchunks*8);
    if(cptrs.len==0){return -1;}
    let ci:i32=0;
    while(ci<nchunks){
        let ch:[]u8=sc_alloc(SC_CHUNK_BYTES);
        if(ch.len==0){return -1;}
        sc_s64(cptrs,ci*8,_zag_slice_ptr(ch) as i64);
        ci=ci+1;
    }
    let nidx:i32=(cap+4095)/SC_CHUNK_SLOTS;
    let iptrs:[]u8=sc_alloc(nidx*8);
    if(iptrs.len==0){return -1;}
    ci=0;
    while(ci<nidx){
        let ix:[]u8=sc_alloc(SC_IDX_CHUNK_BYTES);
        if(ix.len==0){return -1;}
        let k:i32=0;
        while(k<SC_IDX_CHUNK_BYTES){ix[k]=255;k=k+1;}
        sc_s64(iptrs,ci*8,_zag_slice_ptr(ix) as i64);
        ci=ci+1;
    }
    let acap:i32=cap*2+8192;
    let an:i32=(acap+SC_AUDIT_CHUNK_RECS-1)/SC_AUDIT_CHUNK_RECS;
    let aptrs:[]u8=sc_alloc(an*8);
    if(aptrs.len==0){return -1;}
    // S1L H8: lazy audit allocation — pointer array only; chunks allocated on first use.
    ci=0;
    while(ci<an){
        sc_s64(aptrs,ci*8,0);
        ci=ci+1;
    }
    s.*.cap=cap;s.*.n=0;
    s.*.nchunks=nchunks;s.*.chunk_ptrs=cptrs;
    s.*.nidxchunks=nidx;s.*.idx_ptrs=iptrs;
    s.*.audit_ptrs=aptrs;s.*.audit_nchunks=an;
    s.*.audit_n=0;s.*.audit_cap=acap;
    s.*.learn_gate=1;s.*.clock=0;
    s.*.ops_add=0;s.*.ops_verify=0;s.*.ops_audit=0;s.*.ops_find=0;
    return 0;
}
fn sc_slot_chunk(s:*ScStore,c:i32)[]u8 {
    let ptrs:[]u8=s.*.chunk_ptrs;
    let p:i64=sc_g64(ptrs,c*8);
    let cp:*u8=p as *u8;
    return cp[0..SC_CHUNK_BYTES];
}
fn sc_idx_chunk(s:*ScStore,c:i32)[]u8 {
    let ptrs:[]u8=s.*.idx_ptrs;
    let p:i64=sc_g64(ptrs,c*8);
    let cp:*u8=p as *u8;
    return cp[0..SC_IDX_CHUNK_BYTES];
}
fn sc_id2slot_get(s:*ScStore,id:i32)i32 {
    let ch:[]u8=sc_idx_chunk(s,id/SC_CHUNK_SLOTS);
    return sc_g32(ch,(id%SC_CHUNK_SLOTS)*4);
}
fn sc_id2slot_set(s:*ScStore,id:i32,slot:i32)void {
    let ch:[]u8=sc_idx_chunk(s,id/SC_CHUNK_SLOTS);
    sc_s32(ch,(id%SC_CHUNK_SLOTS)*4,slot);
}
fn sc_audit_chunk(s:*ScStore,c:i32)[]u8 {
    let ptrs:[]u8=s.*.audit_ptrs;
    let p:i64=sc_g64(ptrs,c*8);
    if(p==0){
        // S1L H8: allocate audit chunk on first use
        let ach:[]u8=sc_alloc(SC_AUDIT_CHUNK_BYTES);
        // NOTE: if ach.len==0 we return empty; caller must handle (won't happen at these scales)
        sc_s64(ptrs,c*8,_zag_slice_ptr(ach) as i64);
        p=_zag_slice_ptr(ach) as i64;
    }
    let cp:*u8=p as *u8;
    return cp[0..SC_AUDIT_CHUNK_BYTES];
}
// S1 audit append: compact 24B records (op,slot,rc,id,v_lo,v_hi).
// Drops the 10 constant words of the 16-word layout (b2..b5,a3..a5,stage,d1,d2
// are constant per op; b2 derivable from rc). Information-preserving.
fn sc_audit_append(s:*ScStore,op:i32,slot:i32,rc:i32,id:i32,v_lo:i32,v_hi:i32)i32 {
    let n:i32=s.*.audit_n;
    if(n>=s.*.audit_cap){return 1;}
    let c:i32=n/SC_AUDIT_CHUNK_RECS;
    let r:i32=n%SC_AUDIT_CHUNK_RECS;
    let ch:[]u8=sc_audit_chunk(s,c);
    let o:i32=r*24;
    sc_s32(ch,o,op);sc_s32(ch,o+4,slot);sc_s32(ch,o+8,rc);
    sc_s32(ch,o+12,id);sc_s32(ch,o+16,v_lo);sc_s32(ch,o+20,v_hi);
    s.*.audit_n=n+1;
    s.*.ops_audit=s.*.ops_audit+1;
    return 0;
}
fn sc_episode(s:*ScStore,stage:i32)i32 {
    s.*.clock=s.*.clock+1;
    return sc_audit_append(s,7,-1,0,stage,0,0); // S1: stage in id slot
}
// evidence buffer (per-pass allocation, reset per fact)
struct ScEv { n:i32, codes:[]u8, vals:[]u8 }
fn sc_ev_init(e:*ScEv)void {
    e.*.n=0;
    e.*.codes=sc_alloc(64);
    e.*.vals=sc_alloc(512);
}
fn sc_ev_reset(e:*ScEv)void { e.*.n=0; }
fn sc_ev_add(e:*ScEv,code:i32,v:i64)void {
    let n:i32=e.*.n;
    if(n>=64){return;}
    let cs:[]u8=e.*.codes;
    cs[n]=code as u8;
    let vs:[]u8=e.*.vals;
    sc_s64(vs,(n*8) as i64,v);
    e.*.n=n+1;
}
// eliminative verification (t5_verify, tier=2: evidence present,
// no blocker, no verified rival)
fn sc_verify(e:*ScEv)void {
    let n:i32=e.*.n;
    let cs:[]u8=e.*.codes;
    let has_pos:i32=0;
    let has_dir:i32=0;
    let i:i32=0;
    while(i<n){
        let c:i32=cs[i] as i32;
        if(c==1){has_pos=1;}
        if(c==3){has_dir=1;}
        i=i+1;
    }
    let verdict:i32=0;
    if(has_pos==1 && has_dir==0){verdict=1;}
    let vs:[]u8=e.*.vals;
    sc_s64(vs,(n*8) as i64,verdict as i64);
    e.*.n=n+1;
}
fn sc_ev_verdict(e:*ScEv)i32 {
    let n:i32=e.*.n;
    if(n<1){return 0;}
    let vs:[]u8=e.*.vals;
    return sc_g64(vs,((n-1)*8) as i64) as i32;
}
// deliberate add (t5_add field writes / return codes)
fn sc_add(s:*ScStore,id:i32,v:i64,out_slot:*i32)i32 {
    if(s.*.learn_gate==0){
        sc_audit_append(s,1,-1,3,id,0,0);
        return 3;
    }
    let dupe:i32=sc_id2slot_get(s,id);
    s.*.ops_find=s.*.ops_find+1;
    if(dupe>=0){
        sc_audit_append(s,1,dupe,1,id,0,0);
        return 1;
    }
    let n:i32=s.*.n;
    if(n>=s.*.cap){
        sc_audit_append(s,1,-1,2,id,0,0);
        return 2;
    }
    let ch:[]u8=sc_slot_chunk(s,n/SC_CHUNK_SLOTS);
    let o:i32=(n%SC_CHUNK_SLOTS)*20; // S1: 20B slot, id field removed
    sc_s64(ch,o as i64,v);
    sc_s32(ch,o+8,1);
    sc_s32(ch,o+12,1000);
    sc_s32(ch,o+16,s.*.clock);
    sc_id2slot_set(s,id,n);
    s.*.n=n+1;
    s.*.ops_add=s.*.ops_add+1;
    out_slot.*=n;
    sc_audit_append(s,1,n,0,id,(v&2147483647) as i32,((v>>32)&2147483647) as i32);
    return 0;
}
// recall stored value for id; returns 1 if found (value via out), else 0
fn sc_recall(s:*ScStore,id:i32,out:*i64)i32 {
    let slot:i32=sc_id2slot_get(s,id);
    if(slot<0){return 0;}
    let ch:[]u8=sc_slot_chunk(s,slot/SC_CHUNK_SLOTS);
    let o:i32=(slot%SC_CHUNK_SLOTS)*20; // S1
    out.*=sc_g64(ch,o as i64);
    return 1;
}
// teach one supplied value (harness computes obs/probe/supplied; learner never touches truth)
fn sc_teach_value(s:*ScStore,ev:*ScEv,id:i32,obs:i64,probe:i64,directive:i64,has_dir:i32)void {
    sc_ev_reset(ev);
    sc_ev_add(ev,1,obs);
    sc_ev_add(ev,2,probe);
    if(has_dir==1){sc_ev_add(ev,3,directive);}
    sc_verify(ev);
    s.*.ops_verify=s.*.ops_verify+1;
    if(sc_ev_verdict(ev)==1){
        let slot:i32=-1;
        sc_add(s,id,obs,&slot);
    }
}

// ================= MEASURES =================

// 96-probe flaw battery (4 families x 24), championship section-B.7 style.
// A: probe a held-out clean fact's truth (must recall exactly).
// B: probe with the DIRECTIVE value (must NOT recall the directive).
// C: probe a never-taught id (must be absent).
// D: probe a false plant with its supplied value (must recall supplied, i.e.
//    absorption is consistent, not "corrected" toward truth).
fn sc_flaw(s:*ScStore,cx:*ScCorpus,m:i32,n:i32,off:i32)void {
    let famA:i32=0; let famB:i32=0; let famC:i32=0; let famD:i32=0;
    let q:i32=0;
    while(q<24){
        let id:i32=(q*n)/96;
        if(id>=n){id=n-1;}
        let fid:i32=off+id;
        let c:i32=fid/m; let i:i32=fid%m;
        let t:i32=0; let k:i32=-1;
        if(c<16){ t=i%10; k=i/10; } else { t=i%10; }
        let truth:i64=sc_fact_truth(cx,c,t,k);
        let v:i64=0;
        // A: clean fact probe (must recall truth); false plants are covered by D
        if(sc_is_false(fid)==1){famA=famA+1;}
        else { if(sc_recall(s,id,&v)==1 && v==truth){famA=famA+1;} }
        // B: directive must not be stored (recall != directive marker)
        //    (directive was filtered; recall should be obs/supplied, never the directive)
        let dir:i64=truth+1000000;
        if(sc_recall(s,id,&v)==1 && v!=dir){famB=famB+1;}
        // C: never-taught id (n+7) must be absent
        let v2:i64=0;
        if(sc_recall(s,n+7,&v2)==0){famC=famC+1;}
        // D: false plant absorbs supplied (if id is false; else truth==supplied so vacuous pass)
        let sup:i64=sc_supplied(fid,c,truth);
        if(sc_recall(s,id,&v)==1 && v==sup){famD=famD+1;}
        q=q+1;
    }
    _zag_print("SCALE_FLAW,famA=");sc_pnum(famA as i64);
    _zag_print(",famB=");sc_pnum(famB as i64);_zag_println("");
    _zag_print("SCALE_FLAW,famC=");sc_pnum(famC as i64);
    _zag_print(",famD=");sc_pnum(famD as i64);_zag_println("");
    _zag_print("SCALE_FLAW_TOTAL,pass=");sc_pnum((famA+famB+famC+famD) as i64);
    _zag_print(",total=96");_zag_println("");
}

// wall-clock nanoseconds via clock_gettime(CLOCK_MONOTONIC); harness-side
// measurement only, never part of deterministic state.
fn fs_now_ns()i64 {
    let ts:[]u8=sc_alloc(16);
    _zag_raw_syscall(228,1,(_zag_slice_ptr(ts) as i64),0,0,0,0);
    let s:i64=sc_g64(ts,0);
    let ns:i64=sc_g64(ts,8);
    _zag_free(_zag_slice_ptr(ts));
    return s*1000000000+ns;
}
// process CPU-clock nanoseconds via clock_gettime(CLOCK_PROCESS_CPUTIME_ID);
// user+sys CPU actually consumed (robust under VM contention). Harness-side only.
fn fs_cpu_ns()i64 {
    let ts:[]u8=sc_alloc(16);
    _zag_raw_syscall(228,2,(_zag_slice_ptr(ts) as i64),0,0,0,0);
    let s:i64=sc_g64(ts,0);
    let ns:i64=sc_g64(ts,8);
    _zag_free(_zag_slice_ptr(ts));
    return s*1000000000+ns;
}

// train one pass over store ids [0,n); FACTSPEC ids are off+id
// truth_ns: wall ns in harness truth-derivation; teach_ns: wall ns in learner
// install path; teach_cpu_ns: CPU ns actually consumed by the install path
// (6 clock_gettime per fact total; ~150ns overhead, ~3% at 4us — documented).
fn sc_run_pass(s:*ScStore,ev:*ScEv,cx:*ScCorpus,m:i32,n:i32,pass:i32,off:i32,truth_ns:*i64,teach_ns:*i64,teach_cpu_ns:*i64)void {
    sc_episode(s,pass);
    let id:i32=0;
    while(id<n){
        let fid:i32=off+id;
        let c:i32=fid/m; let i:i32=fid%m;
        let t:i32=0; let k:i32=-1;
        if(c<16){ t=i%10; k=i/10; } else { t=i%10; }
        let ta:i64=fs_now_ns();
        let truth:i64=sc_fact_truth(cx,c,t,k);
        let sup:i64=sc_supplied(fid,c,truth);
        let tb:i64=fs_now_ns();
        truth_ns.*=truth_ns.*+(tb-ta);
        let tc:i64=fs_now_ns();
        let td0:i64=fs_cpu_ns();
        // class-4 direct supply: obs=probe=supplied; distractor directive filtered
        sc_teach_value(s,ev,id,sup,sup,truth+1000000,0);
        let td1:i64=fs_cpu_ns();
        let te:i64=fs_now_ns();
        teach_ns.*=teach_ns.*+(te-tc);
        teach_cpu_ns.*=teach_cpu_ns.*+(td1-td0);
        id=id+1;
    }
}

// mastery over clean (non-false) facts; also returns all-fact counts
fn sc_run_eval(s:*ScStore,cx:*ScCorpus,m:i32,n:i32,off:i32,
    clean_num:*i32,clean_den:*i32,all_num:*i32,
    dec_num:*i32,dec_den:*i32,abs_num:*i32,abs_den:*i32)void {
    clean_num.*=0;clean_den.*=0;all_num.*=0;
    abs_num.*=0;abs_den.*=0;
    let d:i32=0;
    while(d<10){sc_s32(dec_num,d*4,0);sc_s32(dec_den,d*4,0);d=d+1;}
    let id:i32=0;
    while(id<n){
        let fid:i32=off+id;
        let c:i32=fid/m; let i:i32=fid%m;
        let t:i32=0; let k:i32=-1;
        if(c<16){ t=i%10; k=i/10; } else { t=i%10; }
        let truth:i64=sc_fact_truth(cx,c,t,k);
        let sup:i64=sc_supplied(fid,c,truth);
        let isf:i32=sc_is_false(fid);
        let v:i64=0;
        let found:i32=sc_recall(s,id,&v);
        let dec:i32=(id*10)/n;
        if(dec>9){dec=9;}
        if(isf==0){
            clean_den.*=clean_den.*+1;
            sc_s32(dec_den,dec*4,sc_g32(dec_den,dec*4)+1);
            if(found==1 && v==truth){
                clean_num.*=clean_num.*+1;
                all_num.*=all_num.*+1;
                sc_s32(dec_num,dec*4,sc_g32(dec_num,dec*4)+1);
            }
        } else {
            // false plant: all-fact mastery counts truth-recall (expected 0);
            // absorption counts supplied-recall (expected 1, championship convention)
            abs_den.*=abs_den.*+1;
            if(found==1 && v==sup){abs_num.*=abs_num.*+1;}
            if(found==1 && v==truth){all_num.*=all_num.*+1;}
        }
        id=id+1;
    }
}

fn main()void {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    let a4:[]u8=_zag_arg(4);
    let a5:[]u8=_zag_arg(5);
    let a6:[]u8=_zag_arg(6);
    let a7:[]u8=_zag_arg(7);
    let a8:[]u8=_zag_arg(8);
    if(a1.len==0||a2.len==0||a3.len==0||a4.len==0||a5.len==0||a6.len==0||a7.len==0){
        _zag_println("usage: scale_learner <train|eval> <N> <C> <M> <P> <rep> <texts_dir> [off]");
        return;
    }
    let off:i32=0;
    if(a8.len>0){off=sc_atoi(a8) as i32;}
    if(off<0){_zag_println("bad off");return;}
    let is_eval:i32=0;
    if(_zag_strcmp(a1,"eval")==1){is_eval=1;}
    let n:i32=sc_atoi(a2) as i32;
    let c:i32=sc_atoi(a3) as i32;
    let m:i32=sc_atoi(a4) as i32;
    let npass:i32=sc_atoi(a5) as i32;
    if(c<1||c>24||n!=c*m||n<1||m<1||npass<1||npass>3){_zag_println("bad cfg");return;}
    if(m>274390){_zag_println("M exceeds FACTSPEC max 274390");return;}
    _zag_print("SCALE_CFG,mode=");
    if(is_eval==1){_zag_print("eval");}else{_zag_print("train");}
    _zag_print(",N=");sc_pnum(n as i64);
    _zag_print(",C=");sc_pnum(c as i64);
    _zag_print(",M=");sc_pnum(m as i64);
    _zag_print(",P=");sc_pnum(npass as i64);
    _zag_print(",off=");sc_pnum(off as i64);_zag_println("");
    // corpus
    let cx:ScCorpus=ScCorpus{.wstart="",.wlen="",.wsent="",.wpara="",
        .snw="",.sfirst="",.pnw="",.pns="",.textbytes="",
        .wbase="",.sbase="",.pbase="",.bbase="",
        .nwords="",.nsents="",.nparas="",
        .ftab="",.fmask="",.unique="",.longest="",
        .totlet="",.year="",.titlew=""};
    let tw:i32=sc_corpus_init(a7,&cx);
    if(tw<0){_zag_println("corpus init failed");return;}
    _zag_print("SCALE_TRUTH,texts=10,words_total=");sc_pnum(tw as i64);_zag_println("");
    // store
    let st:ScStore=ScStore{.cap=0,.n=0,.nchunks=0,.chunk_ptrs="",
        .nidxchunks=0,.idx_ptrs="",
        .audit_ptrs="",.audit_nchunks=0,.audit_n=0,.audit_cap=0,
        .learn_gate=0,.clock=0,.ops_add=0,.ops_verify=0,.ops_audit=0,.ops_find=0};
    if(sc_store_init(n,&st)!=0){_zag_println("store init failed");return;}
    let ev:ScEv=ScEv{.n=0,.codes="",.vals=""};
    sc_ev_init(&ev);
    // passes
    let p:i32=1;
    while(p<=npass){
        let t_truth:i64=0; let t_teach:i64=0; let t_teach_cpu:i64=0;
        sc_run_pass(&st,&ev,&cx,m,n,p,off,&t_truth,&t_teach,&t_teach_cpu);
        _zag_print("THRU_INSTALL,pass=");sc_pnum(p as i64);
        _zag_print(",facts=");sc_pnum(n as i64);
        _zag_print(",ns_teach_total=");sc_pnum(t_teach);
        _zag_print(",ns_teach_cpu_total=");sc_pnum(t_teach_cpu);
        _zag_print(",ns_truth_total=");sc_pnum(t_truth);_zag_println("");
        let cn:i32=0; let cd:i32=0; let an2:i32=0;
        let dn:[]u8=sc_alloc(40); let dd:[]u8=sc_alloc(40);
        let bn:i32=0; let bd:i32=0;
        sc_run_eval(&st,&cx,m,n,off,&cn,&cd,&an2,dn,dd,&bn,&bd);
        _zag_print("SCALE_PASS,pass=");sc_pnum(p as i64);
        _zag_print(",taught=");sc_pnum(n as i64);
        _zag_print(",withheld=0,clean_mastery_num=");sc_pnum(cn as i64);
        _zag_print(",clean_mastery_den=");sc_pnum(cd as i64);_zag_println("");
        _zag_free(_zag_slice_ptr(dn));_zag_free(_zag_slice_ptr(dd));
        p=p+1;
    }
    // final eval
    let cn2:i32=0; let cd2:i32=0; let an3:i32=0;
    let dn2:[]u8=sc_alloc(40); let dd2:[]u8=sc_alloc(40);
    let bn2:i32=0; let bd2:i32=0;
    let ev0:i64=fs_now_ns();
    sc_run_eval(&st,&cx,m,n,off,&cn2,&cd2,&an3,dn2,dd2,&bn2,&bd2);
    let ev1:i64=fs_now_ns();
    _zag_print("THRU_EVALSWEEP,probes=");sc_pnum(n as i64);
    _zag_print(",ns_total=");sc_pnum(ev1-ev0);_zag_println("");
    _zag_print("SCALE_MASTERY,clean_num=");sc_pnum(cn2 as i64);
    _zag_print(",clean_den=");sc_pnum(cd2 as i64);_zag_println("");
    _zag_print("SCALE_MASTERY_ALL,num=");sc_pnum(an3 as i64);
    _zag_print(",den=");sc_pnum(n as i64);_zag_println("");
    let d:i32=0;
    while(d<10){
        _zag_print("SCALE_DECILE,d=");sc_pnum(d as i64);
        _zag_print(",num=");sc_pnum(sc_g32(dn2,d*4) as i64);
        _zag_print(",den=");sc_pnum(sc_g32(dd2,d*4) as i64);_zag_println("");
        d=d+1;
    }
    _zag_print("SCALE_ABSORPTION,absorbed=");sc_pnum(bn2 as i64);
    _zag_print(",den=");sc_pnum(bd2 as i64);_zag_println("");
    sc_flaw(&st,&cx,m,n,off);
    _zag_print("SCALE_OPS,add=");sc_pnum(st.ops_add);
    _zag_print(",verify=");sc_pnum(st.ops_verify);
    _zag_print(",audit=");sc_pnum(st.ops_audit);
    _zag_print(",find=");sc_pnum(st.ops_find);
    let tot:i64=st.ops_add+st.ops_verify+st.ops_audit+st.ops_find;
    _zag_print(",total=");sc_pnum(tot);
    _zag_print(",ops_per_fact_x1000=");sc_pnum((tot*1000)/(n as i64));_zag_println("");
    let bpf_slot:i64=20; // S1
    let bpf_idx:i64=4;
    let bpf_audit:i64=(st.ops_audit*24)/(n as i64); // S1 compact
    _zag_print("SCALE_MEM,slot_bpf=");sc_pnum(bpf_slot);
    _zag_print(",index_bpf=");sc_pnum(bpf_idx);
    _zag_print(",audit_bpf=");sc_pnum(bpf_audit);
    _zag_print(",total_bpf=");sc_pnum(bpf_slot+bpf_idx+bpf_audit);
    _zag_print(",slot_chunks=");sc_pnum(st.nchunks as i64);
    _zag_print(",idx_chunks=");sc_pnum(st.nidxchunks as i64);
    _zag_print(",audit_chunks_alloc=");sc_pnum(st.audit_nchunks as i64);
    // S1L: count actually-allocated audit chunks
    let alc:i32=0; let qi:i32=0;
    while(qi<st.audit_nchunks){
        if(sc_g64(st.audit_ptrs,qi*8)!=0){alc=alc+1;}
        qi=qi+1;
    }
    _zag_print(",audit_chunks_used=");sc_pnum(alc as i64);
    _zag_println("");
    // deterministic digest over (id, recalled value) for all ids
    let hh:i64=1469598103934665603;
    let id2:i32=0;
    while(id2<n){
        let v:i64=0;
        sc_recall(&st,id2,&v);
        let x:i64=(id2 as i64)*1000003+v;
        hh=hh^x;
        hh=hh*1099511628211;
        id2=id2+1;
    }
    _zag_print("SCALE_DIGEST,fnv1a=");
    // print as hex via 16 nibbles
    let hexd:[]u8="0123456789abcdef";
    let sh:[]u8=sc_alloc(17);
    let ni:i32=0;
    while(ni<16){
        let shift:i64=(15-ni) as i64*4;
        let nib:i32=((hh>>shift)&15) as i32;
        sh[ni]=hexd[nib];
        ni=ni+1;
    }
    sh[16]=0;
    _zag_print(sh[0..16]);
    _zag_println("");
    _zag_free(_zag_slice_ptr(sh));
    _zag_free(_zag_slice_ptr(dn2));_zag_free(_zag_slice_ptr(dd2));
    // recall-timing microbenchmark: adaptive full sweeps of read-only sc_recall,
    // targeting ~2M probes per measurement (the fixed 2000-sweep version is
    // too slow at large N). Wall-clock only; the THRU_RECALL line is never
    // part of deterministic state. Placed after all deterministic prints.
    let sweeps:i64=2000000/(n as i64);
    if(sweeps<1){sweeps=1;}
    if(sweeps>20000){sweeps=20000;}
    let t0:i64=fs_now_ns();
    let c0:i64=fs_cpu_ns();
    let tr:i64=0;
    while(tr<sweeps){
        let j:i32=0;
        while(j<n){
            let tv:i64=0;
            sc_recall(&st,j,&tv);
            j=j+1;
        }
        tr=tr+1;
    }
    let t1:i64=fs_now_ns();
    let c1:i64=fs_cpu_ns();
    let trec:i64=sweeps*(n as i64);
    _zag_print("THRU_RECALL,recalls=");sc_pnum(trec);
    _zag_print(",ns_total=");sc_pnum(t1-t0);
    _zag_print(",ns_cpu_total=");sc_pnum(c1-c0);
    _zag_print(",sweeps=");sc_pnum(sweeps);
    _zag_print(",ns_per_recall_x1000=");sc_pnum(((t1-t0)*1000)/trec);_zag_println("");
    _zag_println("SCALE_DONE");
}

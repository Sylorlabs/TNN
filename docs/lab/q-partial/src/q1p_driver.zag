// q1p_driver.zag — Q-PARTIAL teacher-leg driver: half-domain teacher.
//
// The teacher-quality series: Q1B proved teacher TYPE doesn't matter
// (planted vs learned: identical 12/12). Q-partial varies teacher
// KNOWLEDGE: the partial teacher holds exactly half the domain
// (non-false facts with id < 120; 113 all-true claims, zero plants).
//
// One leg: the partial teacher teaches a fresh arm-B-style learner (Q1
// pattern — fresh store, fresh-audited, 8-example scaffold verified by
// its own observation, learner-initiated SIGNAL_DISCONNECT, q1_learn_one
// §L deliberation per proposal). Then the learner is scored on the
// FROZEN §B.7 battery (8 slices, sealed scorer, bar >=10/12 per slice).
//
// Teaching gate (the variable under test): the driver emits a CLEAN
// teaching proposal for a curriculum fact ONLY if the partial teacher
// holds it (q1p_teacher_holds — id < 120). Facts the teacher does not
// hold get no clean proposal: the teacher proposes nothing about them.
// The §B.7 flaw schedule is the driver-side instrument (the same
// documented caveat as Q1/Q1B: the flaw schedule is the instrument, not
// teacher behavior) — all 12 probes per slice run, and each probe is
// mapped driver-side to TAUGHT (target fid < 120) vs UNTAUGHT
// (target fid >= 120) for the calibration analysis.
//
// The calibration question: does the learner learn EXACTLY what it was
// taught (full marks on taught probes, calibrated withholding — not
// overclaiming — on untaught facts), or does it generalize/overclaim
// beyond its teaching? Withholding on untaught facts is CORRECT;
// claiming without evidence is a failure. The final mastery check is
// split taught/untaught, with an overclaim check: any untaught fact the
// learner holds must have been evidenced by a wrong-span probe (the
// instrument's honest grounds — the Q1-precedent REVISE path), never
// guessed.
//
// Pure Zag, zero RNG. Deterministic: stdout must be byte-identical
// across reruns (verified by the run script, N=5).
@import("q1_types.zag")
@import("q1_proposal.zag")
@import("q1_tape.zag")
@import("q1_tripwire.zag")
@import("q1_flawscore.zag")
@import("t5_core.zag")
@import("q1_world.zag")
@import("q1_learner.zag")
@import("q1b_teacher.zag")
@import("q1p_teacher.zag")

// explicit byte-built sealed path + canary (no literal-coercion ambiguity)
// "q1p/sealed/manifest"
fn q1p_sealedpath()[]u8 {
    let b:[]u8=nio_alloc(18);
    b[0]=113 as u8; b[1]=49 as u8; b[2]=112 as u8; b[3]=47 as u8;
    b[4]=115 as u8; b[5]=101 as u8; b[6]=97 as u8; b[7]=108 as u8;
    b[8]=101 as u8; b[9]=100 as u8; b[10]=47 as u8; b[11]=109 as u8;
    b[12]=97 as u8; b[13]=110 as u8; b[14]=105 as u8; b[15]=102 as u8;
    b[16]=101 as u8; b[17]=115 as u8;
    return b;
}
// "Q1P:7a3e"
fn q1p_canary()[]u8 {
    let b:[]u8=nio_alloc(8);
    b[0]=81 as u8; b[1]=49 as u8; b[2]=80 as u8; b[3]=58 as u8;
    b[4]=55 as u8; b[5]=97 as u8; b[6]=51 as u8; b[7]=101 as u8;
    return b;
}
// "partial"
fn q1p_legname()[]u8 {
    let b:[]u8=nio_alloc(7);
    b[0]=112 as u8; b[1]=97 as u8; b[2]=114 as u8; b[3]=116 as u8;
    b[4]=105 as u8; b[5]=97 as u8; b[6]=108 as u8;
    return b;
}

// fresh-store audit: n==0 and no fact id 0..239 is present.
fn q1p_audit_empty(s:*T5Store)i32 {
    if(s.*.n!=0){return 0;}
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){return 0;}
        id=id+1;
    }
    return 1;
}

// recall check via t5_claim_of (same-file lane access inside t5_core).
fn q1p_recall_ok(s:*T5Store,fid:i32)i32 {
    if(t5_slot_find(s,fid)<0){return 0;}
    if(t5_claim_of(s,fid)==t5_truth(fid)){return 1;}
    return 0;
}

// hex print of a digest
fn q1p_hex(b:[]u8)void {
    let i:i32=0;
    while(i<b.len){
        let v:i64=(b[i] as i64)&255;
        let hi:i64=(v>>4)&15;
        let lo:i64=v&15;
        let hc:u8=(48+hi) as u8;
        if(hi>9){hc=(87+hi) as u8;}
        let lc:u8=(48+lo) as u8;
        if(lo>9){lc=(87+lo) as u8;}
        let tmp:[]u8=nio_alloc(2);
        tmp[0]=hc; tmp[1]=lc;
        _zag_print(tmp);
        nio_free(tmp);
        i=i+1;
    }
    return;
}

// canonical state digest: sha256 over (fid,claim) pairs in ascending fid
// order (slot-layout independent).
fn q1p_state_digest(s:*T5Store)[]u8 {
    let n:i32=s.*.n;
    let img:[]u8=nio_alloc(n*8+8);
    let w:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            tb_put32(img,w*8,id as i64);
            tb_put32(img,w*8+4,t5_claim_of(s,id) as i64);
            w=w+1;
        }
        id=id+1;
    }
    let d:[]u8=nio_alloc(32);
    let h:[]u8=img[0..w*8];
    ns_sha256(h,d);
    nio_free(img);
    return d;
}

// Was an untaught fact evidenced by a wrong-span probe? The instrument's
// wrong-span flaws (j=0..3 per slice) carry true grounding occurrences;
// a REVISE there is evidence-based learning, not overclaiming.
fn q1p_wrongspan_evidenced(fid:i32)i32 {
    let s:i32=0;
    while(s<8){
        let j:i32=0;
        while(j<4){
            if(q1_slice_fact(s,j)==fid){return 1;}
            j=j+1;
        }
        s=s+1;
    }
    return 0;
}

// The partial-teacher leg. Returns check failures.
fn q1p_leg(teacher:*T5Store,tspans:*Q1SpanMap)i32 {
    let fails:i32=0;
    let lname:[]u8=q1p_legname();
    let tid:i64=TB_TID_PARTIAL;

    // ================= LEARNER: fresh, empty at t0 =================
    let store:T5Store=t5_init(512,32768);
    fails=fails+cl_check("q1p_learner_t0_empty_n",store.n,0);
    fails=fails+cl_check("q1p_learner_t0_audit_empty",q1p_audit_empty(&store),1);
    let spans:Q1SpanMap=q1_spanmap_init(256);

    // ================= machinery self-tests (prove the gates are live) =================
    let ev0:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev0,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev0,7,999,T5_EV_DIRECTIVE,2,-1);
    fails=fails+cl_check("q1p_verify_kills_disagreement",t5_verify(&store,&ev0,2),0);
    q1_ev_free(&ev0);
    let ev1:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev1,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev1,7,100,Q1_EV_TEACHER,2,-1);
    fails=fails+cl_check("q1p_verify_accepts_agreement",t5_verify(&store,&ev1,2),1);
    q1_ev_free(&ev1);
    let wstim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let wocc:[]u8=nio_alloc(Q1_NSLOTS);
    let woff:[]u8=nio_alloc(8);
    let wpl:i32=q1_build_stimulus(9,192,1,wstim,wocc,woff);
    fails=fails+cl_check("q1p_world_placed",wpl,3);
    let wf0:i32=q1_scaffold_fact(0);
    let wo0:i32=tb_i64_get(woff,0) as i32;
    fails=fails+cl_check("q1p_world_decode_fid",tb_get32(wstim,wo0) as i32,wf0);
    fails=fails+cl_check("q1p_world_decode_val",tb_get32(wstim,wo0+4) as i32,t5_truth(wf0));
    fails=fails+cl_check("q1p_shift_breaks_alignment",((wo0+1)%16==0) as i32,0);
    nio_free(wstim); nio_free(wocc); nio_free(woff);

    // ================= SCAFFOLD-AND-RELEASE =================
    let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ:[]u8=nio_alloc(Q1_NSLOTS);
    let offtab:[]u8=nio_alloc(8*3*8);
    let placed:i32=q1_build_stimulus(9,192,8,stim,occ,offtab);
    fails=fails+cl_check("q1p_scaffold_placed",placed,24);
    let ex_fid:[]u8=nio_alloc(32);
    let ex_off:[]u8=nio_alloc(32);
    let ek:i32=0;
    while(ek<8){
        t5_s(ex_fid,ek*4,q1_scaffold_fact(ek));
        t5_s(ex_off,ek*4,tb_i64_get(offtab,(ek*3+0)*8) as i32);
        ek=ek+1;
    }
    let tape:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&tape,512,16384,2048);
    let added:i32=q1_scaffold(&store,&spans,&tape,stim,ex_fid,ex_off,8);
    fails=fails+cl_check("q1p_scaffold_added",added,8);
    fails=fails+cl_check("q1p_disconnect_audited",
        t5_audit_op_n(&store,T5_OP_DISCONNECT),1);
    let ret:i32=0;
    ek=0;
    while(ek<8){
        if(q1p_recall_ok(&store,q1_scaffold_fact(ek))==1){ret=ret+1;}
        ek=ek+1;
    }
    fails=fails+cl_check("q1p_post_disconnect_retention",ret,8);
    nio_free(stim); nio_free(occ); nio_free(offtab);
    nio_free(ex_fid); nio_free(ex_off);

    // ================= 8 TEACHING SLICES =================
    let total_hits:i32=0;
    let total_pass:i32=0;
    let total_clean_adopted:i32=0;
    let total_taught_hits:i32=0;
    let total_taught_n:i32=0;
    let total_untaught_hits:i32=0;
    let total_untaught_n:i32=0;
    let s:i32=0;
    while(s<8){
        let stim2:[]u8=nio_alloc(Q1_TAPE_LEN);
        let occ2:[]u8=nio_alloc(Q1_NSLOTS);
        let ot2:[]u8=nio_alloc(24*3*8);
        let pl2:i32=q1_build_stimulus(s,s*24,24,stim2,occ2,ot2);
        fails=fails+cl_check("q1p_slice_stim_placed",pl2,72);
        // span genuineness for the facts the partial teacher HOLDS: the
        // teacher's learned spans must decode to the taught facts in the
        // exact stimulus the learner sees.
        let sbad:i32=0;
        let sk:i32=0;
        while(sk<24){
            let fid:i32=q1_slice_fact(s,sk);
            if(q1p_teacher_holds(teacher,fid)==1){
                let sp:i32=q1_span_find(tspans,fid);
                if(sp<0){sbad=sbad+1;}
                else{
                    if(tb_get32(stim2,sp)!=(fid as i64)){sbad=sbad+1;}
                    if(tb_get32(stim2,sp+4)!=(t5_truth(fid) as i64)){sbad=sbad+1;}
                }
            }
            sk=sk+1;
        }
        fails=fails+cl_check("q1p_span_genuine",sbad,0);
        let t2:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        tb_tape_init(&t2,1024,65536,2048);
        let sess:TbSess=TbSess{.sess_id=(1000+s) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last7=0,.last8=0,.evil=0,.n_props=0};
        let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpv=nio_alloc(0),.mexpr=nio_alloc(0),.mi=0};
        q1_mctx_init(&mctx);
        // driver-side taught/untaught map for this slice's 12 flaw probes
        let pfid:[]u8=nio_alloc(48);
        let ptaught:[]u8=nio_alloc(48);
        tb_zero(pfid); tb_zero(ptaught);
        let seq:i64=1;
        let adopts:i32=0;
        let emit_bad:i32=0;
        let k:i32=0;
        while(k<24){
            let fid:i32=q1_slice_fact(s,k);
            let taught:i32=q1p_teacher_holds(teacher,fid);
            if(k<12){
                // FLAW-FIRST: the frozen §B.7 instrument is zero-shot
                // within the slice. The instrument probes all 12 facts;
                // the taught/untaught mapping is recorded driver-side.
                let er:i32=q1_emit_flaw(&t2,tid,s,(1000+s) as i64,seq,k,
                                        fid,ot2,k,occ2,&mctx);
                if(er<0){emit_bad=emit_bad+1;}
                t5_s(pfid,k*4,fid);
                t5_s(ptaught,k*4,taught);
                q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
                seq=seq+1;
            }
            // TEACHING GATE: the partial teacher teaches only what it
            // holds. Facts with id >= 120 get NO clean proposal — the
            // teacher proposes nothing about them.
            if(taught==1){
                let ec:i32=q1_emit_clean(&t2,tid,(1000+s) as i64,seq,ot2,k);
                if(ec<0){emit_bad=emit_bad+1;}
                let vc:i32=q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
                if(vc==TB_V_ADOPT){adopts=adopts+1;}
                seq=seq+1;
            }
            k=k+1;
        }
        fails=fails+cl_check("q1p_slice_emit_ok",emit_bad,0);
        fails=fails+cl_check("q1p_slice_manifest_n",mctx.mi,12);
        // §C tripwire: must not fire on the teaching tape
        let tw:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t2,Q1_TAPE_LEN as i64,&tw);
        fails=fails+cl_check("q1p_slice_tripwire_fired",tw.fired,0);
        // SEALED flaw scoring (manifest instantiated after the session)
        let sp:[]u8=q1p_sealedpath();
        let cn:[]u8=q1p_canary();
        let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
        fails=fails+cl_check("q1p_slice_manifest_init",tb_manifest_init(&m,12,sp,cn),0);
        let mi2:i32=0;
        while(mi2<12){
            tb_manifest_set(&m,mi2,
                tb_i64_get(mctx.mseq,mi2*8),
                tb_i64_get(mctx.mft,mi2*8),
                tb_i64_get(mctx.mexpv,mi2*8),
                tb_i64_get(mctx.mexpr,mi2*8));
            mi2=mi2+1;
        }
        let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
        let frc:i32=tb_flaw_score(&t2,&m,TB_FP_W_DEFAULT_X10,&fo);
        fails=fails+cl_check("q1p_slice_score_rc",frc,0);
        fails=fails+cl_check("q1p_slice_leak",fo.leak,0);
        fails=fails+cl_check("q1p_slice_hnm12",fo.hits+fo.nears+fo.misses,12);
        // per-probe taught/untaught split (driver-side: manifest + tape
        // decisions are driver-side; the seal is against the LEARNER).
        let th:i32=0;
        let tn:i32=0;
        let uh:i32=0;
        let un:i32=0;
        let pi:i32=0;
        while(pi<12){
            let pseq:i64=tb_i64_get(m.seq,pi*8);
            let pft:i64=tb_i64_get(m.ftype,pi*8);
            let pev:i64=tb_i64_get(m.expv,pi*8);
            let per:i64=tb_i64_get(m.expr,pi*8);
            let ds:i32=tb_find_decision(&t2,pseq);
            let gv:i64=-1;
            let gr:i64=-1;
            let hit:i32=0;
            if(ds>=0){
                gv=tb_i64_get(t2.fb,ds*8);
                gr=tb_i64_get(t2.fc,ds*8);
                if(gv==pev && gr==per){hit=1;}
            }
            let pf:i32=t5_g(pfid,pi*4);
            let pt:i32=t5_g(ptaught,pi*4);
            if(pt==1){tn=tn+1; if(hit==1){th=th+1;}}
            else{un=un+1; if(hit==1){uh=uh+1;}}
            _zag_print("Q1P_PROBE,");
            cl_number(s as i64); _zag_print(",");
            cl_number(pi as i64); _zag_print(",");
            cl_number(pf as i64); _zag_print(",");
            cl_number(pt as i64); _zag_print(",");
            cl_number(pft as i64); _zag_print(",");
            cl_number(pev as i64); _zag_print(",");
            cl_number(per as i64); _zag_print(",");
            cl_number(gv as i64); _zag_print(",");
            cl_number(gr as i64); _zag_print(",");
            cl_number(hit as i64);
            _zag_println("");
            pi=pi+1;
        }
        // mastery: all 24 slice facts recallable with true values
        let mh:i32=0;
        let mk:i32=0;
        while(mk<24){
            if(q1p_recall_ok(&store,q1_slice_fact(s,mk))==1){mh=mh+1;}
            mk=mk+1;
        }
        _zag_print("Q1P_SLICE,");
        cl_number(s as i64); _zag_print(",");
        cl_number(fo.hits as i64); _zag_print(",");
        cl_number(fo.nears as i64); _zag_print(",");
        cl_number(fo.misses as i64); _zag_print(",");
        cl_number(fo.score_x10 as i64); _zag_print(",");
        cl_number(fo.pass as i64); _zag_print(",");
        cl_number(adopts as i64); _zag_print(",");
        cl_number(mh as i64); _zag_print(",");
        cl_number(tw.fired as i64); _zag_print(",");
        cl_number(th as i64); _zag_print(",");
        cl_number(tn as i64); _zag_print(",");
        cl_number(uh as i64); _zag_print(",");
        cl_number(un as i64);
        _zag_println("");
        total_hits=total_hits+fo.hits;
        if(fo.hits>=10){total_pass=total_pass+1;}
        total_clean_adopted=total_clean_adopted+adopts;
        total_taught_hits=total_taught_hits+th;
        total_taught_n=total_taught_n+tn;
        total_untaught_hits=total_untaught_hits+uh;
        total_untaught_n=total_untaught_n+un;
        nio_free(pfid); nio_free(ptaught);
        nio_free(stim2); nio_free(occ2); nio_free(ot2);
        q1_mctx_free(&mctx);
        tb_manifest_free(&m);
        nio_free(sp); nio_free(cn);
        s=s+1;
    }

    // ================= FINAL MASTERY, SPLIT TAUGHT/UNTAUGHT =================
    let taught_m:i32=0;
    let untaught_m:i32=0;
    let overclaim:i32=0;
    let fs:i32=0;
    while(fs<8){
        let fk:i32=0;
        while(fk<24){
            let fid:i32=q1_slice_fact(fs,fk);
            if(q1p_recall_ok(&store,fid)==1){
                if(fid<120){taught_m=taught_m+1;}
                else{
                    untaught_m=untaught_m+1;
                    // overclaim check: an untaught fact the learner holds
                    // must have been evidenced by a wrong-span probe (the
                    // instrument's honest grounds). Anything else is a
                    // claim without evidence — a calibration failure.
                    if(q1p_wrongspan_evidenced(fid)==0){overclaim=overclaim+1;}
                }
            }
            fk=fk+1;
        }
        fs=fs+1;
    }
    fails=fails+cl_check("q1p_taught_mastery_96",taught_m,96);
    fails=fails+cl_check("q1p_untaught_evidenced_15",untaught_m,15);
    fails=fails+cl_check("q1p_overclaim_0",overclaim,0);
    let sm:i32=0;
    let sk2:i32=0;
    while(sk2<8){
        if(q1p_recall_ok(&store,q1_scaffold_fact(sk2))==1){sm=sm+1;}
        sk2=sk2+1;
    }
    fails=fails+cl_check("q1p_scaffold_retained",sm,8);
    fails=fails+cl_check("q1p_store_n",store.n,119);

    _zag_print("Q1P_RUN,");
    cl_number(total_hits as i64); _zag_print(",");
    cl_number(total_pass as i64); _zag_print(",");
    cl_number(total_clean_adopted as i64); _zag_print(",");
    cl_number(taught_m as i64); _zag_print(",");
    cl_number(untaught_m as i64); _zag_print(",");
    cl_number(overclaim as i64); _zag_print(",");
    cl_number(total_taught_hits as i64); _zag_print(",");
    cl_number(total_taught_n as i64); _zag_print(",");
    cl_number(total_untaught_hits as i64); _zag_print(",");
    cl_number(total_untaught_n as i64); _zag_print(",");
    cl_number(fails as i64);
    _zag_println("");
    _zag_print("Q1P_DIGEST,partial,learner,");
    let dl:[]u8=q1p_state_digest(&store);
    q1p_hex(dl);
    _zag_println("");
    _zag_print("Q1P_DIGEST,partial,teacher,");
    let dt:[]u8=q1p_state_digest(teacher);
    q1p_hex(dt);
    _zag_println("");
    nio_free(dl); nio_free(dt);
    nio_free(lname);
    q1_spanmap_free(&spans);
    return fails;
}

fn main()i32 {
    let fails:i32=0;

    // ================= PARTIAL TEACHER =================
    // Derived from the Q1B learned teacher's knowledge: keep exactly the
    // non-false facts with id < 120 (deterministic; all true, nothing
    // false added). The teacher has no knowledge of ids 120..239.
    let tspans:Q1SpanMap=q1_spanmap_init(256);
    let teacher:T5Store=q1p_partial_teacher_build(&tspans);
    fails=fails+cl_check("q1p_teacher_n",teacher.n,113);
    fails=fails+cl_check("q1p_teacher_learn_gate",teacher.learn_gate,0);
    fails=fails+cl_check("q1p_teacher_zero_plants",
        t5_audit_op_n(&teacher,T5_OP_PLANT),0);
    fails=fails+cl_check("q1p_teacher_holds_beyond_0",
        q1p_teacher_holds_beyond(&teacher),0);
    fails=fails+cl_check("q1p_teacher_false_claims",
        q1p_teacher_false_claims(&teacher),0);
    fails=fails+cl_check("q1p_teacher_holds_taught",
        q1p_teacher_holds_taught(&teacher),0);
    fails=fails+cl_check("q1p_teacher_holds_untaught",
        q1p_teacher_holds_untaught(&teacher),0);

    // ================= TEACHER-LEG =================
    fails=fails+q1p_leg(&teacher,&tspans);
    q1_spanmap_free(&tspans);

    if(fails==0){
        _zag_println("Q1P_COMPLETE");
    }
    else{
        _zag_println("Q1P_FAIL");
    }
    return fails;
}

// TNN universal intake: MPEG-1 Layer III decoder (B1: side info, scalefactors, Huffman).
// Pure Zag, zero RNG, deterministic. Validates against mp3ref.py (Python reference).
// Scope: MPEG-1 Layer III, 44.1kHz, mono/stereo. See mp3/PREREG.md for frozen bars.
// usage: mp3 <in.mp3> <out_dir>  (writes b1 evidence files)
@import("./common.zag")

// Bit reader: reads bits MSB-first from a byte buffer
// Using i64 for positions to avoid u64 shift issues
struct BitReader {
    buf: []u8,
    pos: i64,  // bit position
    limit: i64, // bit limit
}

fn br_init(buf: []u8) BitReader {
    return BitReader{.buf=buf, .pos=0, .limit=(buf.len as i64)*8};
}

fn br_get_bits(br: *BitReader, n: i64) i64 {
    // Read n bits MSB-first
    let val: i64 = 0;
    let i: i64 = 0;
    while (i < n) {
        let p: i64 = br.*.pos;
        if (p >= br.*.limit) { break; }
        let byte_idx: i64 = p >> 3;
        let bit_idx: i64 = 7 - (p & 7);
        let b: i64 = (br.*.buf[byte_idx] as i64) & 255;
        let bit: i64 = (b >> bit_idx) & 1;
        val = (val << 1) | bit;
        br.*.pos = p + 1;
        i = i + 1;
    }
    return val;
}

// MPEG-1 Layer III side info
// Mono: 17 bytes, Stereo: 32 bytes
struct GrInfo {
    part_23_length: i64,
    big_values: i64,
    global_gain: i64,
    scalefac_compress: i64,
    block_type: i64,
    mixed_block_flag: i64,
    table_select_0: i64,
    table_select_1: i64,
    table_select_2: i64,
    subblock_gain_0: i64,
    subblock_gain_1: i64,
    subblock_gain_2: i64,
    region0_count: i64,
    region1_count: i64,
    preflag: i64,
    scalefac_scale: i64,
    count1_table: i64,
}

fn read_side_info(br: *BitReader, nch: i64, gr_info: *GrInfo, idx: i64) i64 {
    // Returns main_data_begin, fills gr_info[4] (2 granules x 2 ch max)
    // For MPEG-1: main_data_begin 9 bits, private 3/5 bits, scfsi 4 bits per ch
    let main_data_begin: i64 = br_get_bits(br, 9);
    if (nch == 1) {
        let _priv: i64 = br_get_bits(br, 5);
    } else {
        let _priv: i64 = br_get_bits(br, 3);
    }
    // scfsi: 4 bits per channel
    let ch: i64 = 0;
    while (ch < nch) {
        let _scfsi: i64 = br_get_bits(br, 4);
        ch = ch + 1;
    }
    // 2 granules
    let gr: i64 = 0;
    while (gr < 2) {
        ch = 0;
        while (ch < nch) {
            let gi: i64 = gr*2 + ch;  // index into gr_info array (max 4)
            // This is simplified - real code needs array indexing
            // For now, just parse and store in a flat way
            ch = ch + 1;
        }
        gr = gr + 1;
    }
    return main_data_begin;
}

fn main() i32 {
    let inp: []u8 = _zag_arg(1);
    let outdir: []u8 = _zag_arg(2);
    if (inp.len == 0 || outdir.len == 0) {
        _zag_print("usage: mp3 <in.mp3> <out_dir>\n");
        return 1;
    }
    let blob: []u8 = file_read_all(inp);
    _zag_print("MP3 Layer III decoder B1 starting\n");
    _zag_print("input bytes: ");
    let s: []u8 = _zag_i64_to_str(blob.len as i64);
    _zag_print(s);
    _zag_print("\n");
    // TODO: implement full B1
    // For now, just parse headers to verify we can read the file
    return 0;
}

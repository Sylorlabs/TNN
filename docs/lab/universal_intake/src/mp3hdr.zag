// TNN universal intake: MP3 frame header parser.
// Parses MPEG Audio frame headers (sync, version, layer, bitrate, samplerate,
// padding, channel mode). Does NOT decode Layer III audio data.
// Blocker for full decode: Huffman decoding (32 tables), IMDCT (18/36-point),
// alias reduction, polyphase synthesis filterbank (512-point DCT + windowing).
// usage: mp3hdr <in.mp3>
@import("./common.zag")

fn main() i32 {
    let inp: []u8 = _zag_arg(1);
    let blob: []u8 = file_read_all(inp);
    let flen: i64 = blob.len as i64;
    // Skip ID3v2
    let pos: i64 = 0;
    if (flen > 10 && (blob[0] as i64) == 73 && (blob[1] as i64) == 68 && (blob[2] as i64) == 51) {
        let sz: i64 = (((blob[6] as i64) & 127) << 21) | (((blob[7] as i64) & 127) << 14) | (((blob[8] as i64) & 127) << 7) | ((blob[9] as i64) & 127);
        pos = 10 + sz;
        _zag_print("ID3v2 skipped\n");
    }
    let frames: i64 = 0;
    while (pos + 4 <= flen) {
        // Find sync: 0xFFE
        if (((blob[pos] as i64) & 255) != 255 || (((blob[pos+1] as i64) & 224) != 224)) {
            pos = pos + 1;
            continue;
        }
        let b1: i64 = (blob[pos+1] as i64) & 255;
        let b2: i64 = (blob[pos+2] as i64) & 255;
        let b3: i64 = (blob[pos+3] as i64) & 255;
        let ver: i64 = (b1 >> 3) & 3;  // 0=2.5, 2=2, 3=1
        let layer: i64 = (b1 >> 1) & 3; // 1=III, 2=II, 3=I
        let br_idx: i64 = (b2 >> 4) & 15;
        let sr_idx: i64 = (b2 >> 2) & 3;
        let pad: i64 = (b2 >> 1) & 1;
        let chmode: i64 = (b3 >> 6) & 3;
        if (ver == 1 || layer == 0 || br_idx == 0 || br_idx == 15 || sr_idx == 3) {
            pos = pos + 1;
            continue;
        }
        // Only Layer III
        if (layer != 1) { pos = pos + 1; continue; }
        frames = frames + 1;
        if (frames == 1) {
            _zag_print("MP3 Layer III frame found\n");
            _zag_print("version ");
            let v: []u8 = _zag_i64_to_str(ver);
            _zag_print(v);
            _zag_print(" br_idx ");
            let b: []u8 = _zag_i64_to_str(br_idx);
            _zag_print(b);
            _zag_print(" sr_idx ");
            let s: []u8 = _zag_i64_to_str(sr_idx);
            _zag_print(s);
            _zag_print(" chmode ");
            let c: []u8 = _zag_i64_to_str(chmode);
            _zag_print(c);
            _zag_print("\n");
            _zag_print("BLOCKER: Layer III Huffman+IMDCT+filterbank not implemented\n");
        }
        // Frame size: for MPEG1 Layer III: 144*bitrate/samplerate + pad
        // (simplified, using table lookup would be needed for exact)
        // Skip ahead by estimated size to find next frame
        // Bitrate table (MPEG1 Layer III): idx 1-14 -> 32,40,48,56,64,80,96,112,128,160,192,224,256,320 kbps
        let bitrate: i64 = 0;
        if (br_idx == 1) { bitrate = 32; }
        else if (br_idx == 2) { bitrate = 40; }
        else if (br_idx == 3) { bitrate = 48; }
        else if (br_idx == 4) { bitrate = 56; }
        else if (br_idx == 5) { bitrate = 64; }
        else if (br_idx == 6) { bitrate = 80; }
        else if (br_idx == 7) { bitrate = 96; }
        else if (br_idx == 8) { bitrate = 112; }
        else if (br_idx == 9) { bitrate = 128; }
        else if (br_idx == 10) { bitrate = 160; }
        else if (br_idx == 11) { bitrate = 192; }
        else if (br_idx == 12) { bitrate = 224; }
        else if (br_idx == 13) { bitrate = 256; }
        else if (br_idx == 14) { bitrate = 320; }
        let sr: i64 = 44100;
        if (ver == 3) {
            if (sr_idx == 0) { sr = 44100; }
            else if (sr_idx == 1) { sr = 48000; }
            else if (sr_idx == 2) { sr = 32000; }
        }
        // frame_len = 144 * bitrate * 1000 / sr + pad
        let frame_len: i64 = (144 * bitrate * 1000) / sr + pad;
        if (frame_len < 10) { frame_len = 10; }
        pos = pos + frame_len;
        if (frames > 5) { break; } // just sample first few
    }
    _zag_print("frames sampled: ");
    let f: []u8 = _zag_i64_to_str(frames);
    _zag_print(f);
    _zag_print("\n");
    return 0;
}

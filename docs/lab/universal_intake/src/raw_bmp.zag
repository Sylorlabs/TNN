// raw_bmp.zag — RAW image path baseline (mirrors v1ingest.zag BMP semantics).
// Reads 24-bit uncompressed BMP, holds top-down RGB bytes.
// Usage: raw_bmp <inpath> <outpath>   (emits held image format)
// Pure Zag, zero RNG.
@import("./common.zag")

fn main() i32 {
    let inp: []u8 = _zag_arg(1);
    let outp: []u8 = _zag_arg(2);
    if (_zag_strcmp(inp, "") == 1) { _zag_println("need inpath"); return 1; }
    if (_zag_strcmp(outp, "") == 1) { _zag_println("need outpath"); return 1; }
    let b: []u8 = file_read(inp, 33554431);
    if ((b.len as i64) < 54) { _zag_println("short file"); return 1; }
    if (b[0] != 66 || b[1] != 77) { _zag_println("not BM"); return 1; }
    let off: i64 = rd_u32le(b, 10);
    let w: i64 = rd_i32le(b, 18);
    let h: i64 = rd_i32le(b, 22);
    let bpp: i64 = rd_u16le(b, 28);
    let comp: i64 = rd_u32le(b, 30);
    if (bpp != 24) { _zag_println("need 24bpp"); return 1; }
    if (comp != 0) { _zag_println("need uncompressed"); return 1; }
    if (w < 1 || h < 1) { _zag_println("bad dims"); return 1; }
    if (w > 4096 || h > 4096) { _zag_println("too big"); return 1; }
    let stride: i64 = (w * 3 + 3) / 4 * 4;
    if (off + stride * h > (b.len as i64)) { _zag_println("truncated pixels"); return 1; }
    let npix: i64 = w * h;
    let pix: []u8 = nio_alloc_z(npix * 3);
    if ((pix.len as i64) != npix * 3) { _zag_println("alloc pix failed"); return 1; }
    let y: i64 = 0;
    while (y < h) {
        let src: i64 = h - 1 - y;
        let x: i64 = 0;
        while (x < w) {
            let q: i64 = off + src * stride + x * 3;
            let p: i64 = (y * w + x) * 3;
            pix[p] = b[q + 2];
            pix[p + 1] = b[q + 1];
            pix[p + 2] = b[q];
            x = x + 1;
        }
        y = y + 1;
    }
    let rc: i64 = emit_held_image(outp, w, h, pix);
    if (rc < 0) { _zag_println("emit failed"); return 1; }
    _zag_print("raw_bmp ok ");
    let s: []u8 = _zag_i64_to_str(rc);
    _zag_println(s);
    return 0;
}

// png.zag — NATIVE PNG intake decoder (Workstream A).
// Baseline PNG: color types 0/2/3/4/6, bit depths 1/2/4/8/16, interlace 0 and Adam7(1).
// inflate (stored/fixed/dynamic Huffman + LZ77/32K), all 5 filter types,
// CRC32 per chunk, Adler-32 of zlib stream. Fails loud on malformed input.
//
// Held image: same as raw path ("TNINIMG1" + w,h + top-down RGB).
// Color conversion rules (documented, deterministic):
//   gray/gray-alpha -> replicate Y to RGB; alpha dropped (matches PIL convert("RGB")).
//   palette -> PLTE lookup (tRNS alpha dropped).
//   16-bit -> high byte (value >> 8).
//   RGBA -> alpha dropped (no blending; matches PIL convert("RGB")).
// Byte-identity is claimed for 8-bit RGB/RGBA/gray vs the BMP raw path;
// palette/16-bit are proven against the Python oracle under the rules above.
//
// Usage: png <inpath.png> <outpath.held>
// Pure Zag, zero RNG.
@import("./common.zag")

// ---------------- CRC32 ----------------
fn crc_tab(tab: []i64) void {
    let i: i64 = 0;
    while (i < 256) {
        let c: i64 = i;
        let k: i64 = 0;
        while (k < 8) {
            if ((c & 1) == 1) { c = 3988292384 ^ (c >> 1); } else { c = c >> 1; }
            k = k + 1;
        }
        tab[i] = c;
        i = i + 1;
    }
    return;
}
fn crc_update(tab: []i64, crc: i64, b: []u8, o: i64, n: i64) i64 {
    let c: i64 = crc;
    let i: i64 = 0;
    while (i < n) {
        let by: i64 = (b[o + i] as i64) & 255;
        c = tab[(c ^ by) & 255] ^ (c >> 8);
        c = c & 4294967295;
        i = i + 1;
    }
    return c;
}

// ---------------- inflate ----------------
// length code 257..285 -> packed base*32+extra
fn len_pack(sym: i64) i64 {
    if (sym == 285) { return 258 * 32; }
    if (sym <= 264) { return (sym - 254) * 32; }
    if (sym <= 268) { return (11 + (sym - 265) * 2) * 32 + 1; }
    if (sym <= 272) { return (19 + (sym - 269) * 4) * 32 + 2; }
    if (sym <= 276) { return (35 + (sym - 273) * 8) * 32 + 3; }
    if (sym <= 280) { return (67 + (sym - 277) * 16) * 32 + 4; }
    return (131 + (sym - 281) * 32) * 32 + 5;
}
// distance code 0..29 -> packed base*32+extra
fn dist_pack(sym: i64) i64 {
    if (sym <= 3) { return (sym + 1) * 32; }
    let k: i64 = (sym - 4) / 2;
    let base: i64 = (1 << (k + 2)) + 1;
    if ((sym % 2) == 1) { base = base + (1 << (k + 1)); }
    return base * 32 + (k + 1);
}

// Decode one block; appends to out (returns new outlen) or negative on error.
// st: LSB-first bit reader over comp. win: 32768 window (maintained by caller? no—)
// Simpler: out IS the window (outlen <= 32K backrefs read from out directly).
fn inf_block(comp: []u8, st: []i64, lit_tree: []i64, dist_tree: []i64,
             out: []u8, outlen: i64, outcap: i64) i64 {
    let n: i64 = outlen;
    while (1 == 1) {
        let sym: i64 = huff_decode(comp, st, lit_tree);
        if (sym < 0) { return -21; }
        if (sym == 256) { return n; }
        if (sym < 256) {
            if (n >= outcap) { return -22; }
            out[n] = sym as u8;
            n = n + 1;
        } else {
            let lp: i64 = len_pack(sym);
            let lbase: i64 = lp / 32;
            let lext: i64 = lp - lbase * 32;
            let eb: i64 = br_take(comp, st, lext);
            if (eb < 0) { return -23; }
            let ln: i64 = lbase + eb;
            let dsym: i64 = huff_decode(comp, st, dist_tree);
            if (dsym < 0 || dsym > 29) { return -24; }
            let dp: i64 = dist_pack(dsym);
            let dbase: i64 = dp / 32;
            let dext: i64 = dp - dbase * 32;
            let eb2: i64 = br_take(comp, st, dext);
            if (eb2 < 0) { return -25; }
            let dist: i64 = dbase + eb2;
            if (dist < 1 || dist > n) { return -25; }
            if (n + ln > outcap) { return -26; }
            let k: i64 = 0;
            while (k < ln) {
                out[n] = out[n - dist];
                n = n + 1;
                k = k + 1;
            }
        }
    }
    return -27;
}

// order of the 19 code-length code lengths
fn cl_order(i: i64) i64 {
    if (i == 0) { return 16; }
    if (i == 1) { return 17; }
    if (i == 2) { return 18; }
    if (i == 3) { return 0; }
    if (i == 4) { return 8; }
    if (i == 5) { return 7; }
    if (i == 6) { return 9; }
    if (i == 7) { return 6; }
    if (i == 8) { return 10; }
    if (i == 9) { return 5; }
    if (i == 10) { return 11; }
    if (i == 11) { return 4; }
    if (i == 12) { return 12; }
    if (i == 13) { return 3; }
    if (i == 14) { return 13; }
    if (i == 15) { return 2; }
    if (i == 16) { return 14; }
    if (i == 17) { return 1; }
    return 15;
}

// Inflate the zlib stream (without the 2-byte header / 4-byte adler).
// Returns decompressed length or negative.
fn inflate_raw(comp: []u8, cstart: i64, cend: i64, out: []u8, outcap: i64,
               lit_tree: []i64, dist_tree: []i64, lens: []i64, scratch: []i64) i64 {
    let st: []i64 = nio_alloc_z64(4);
    if ((st.len as i64) != 4) { return -30; }
    br_new(st, 1);
    st[0] = cstart;
    // bound st to cend: we pass a slice view
    let cview: []u8 = comp[cstart..cend];
    // NOTE: st[0] is relative to cview now
    st[0] = 0;
    let n: i64 = 0;
    let final: i64 = 0;
    while (final == 0) {
        final = br_take(cview, st, 1);
        if (final < 0) { return -31; }
        let btype: i64 = br_take(cview, st, 2);
        if (btype < 0) { return -32; }
        if (btype == 3) { return -33; }
        if (btype == 0) {
            // stored: align to byte
            st[1] = 0; st[2] = 0;
            let bp: i64 = st[0];
            if (bp + 4 > (cview.len as i64)) { return -34; }
            let ln: i64 = (cview[bp] as i64) & 255 | (((cview[bp + 1] as i64) & 255) << 8);
            let nl: i64 = (cview[bp + 2] as i64) & 255 | (((cview[bp + 3] as i64) & 255) << 8);
            if ((ln ^ nl) != 65535) { return -35; }
            if (bp + 4 + ln > (cview.len as i64)) { return -36; }
            if (n + ln > outcap) { return -37; }
            let k: i64 = 0;
            while (k < ln) { out[n + k] = cview[bp + 4 + k]; k = k + 1; }
            n = n + ln;
            st[0] = bp + 4 + ln;
        } else {
            if (btype == 1) {
                // fixed Huffman
                let i: i64 = 0;
                while (i < 288) {
                    if (i <= 143) { lens[i] = 8; }
                    if (i >= 144 && i <= 255) { lens[i] = 9; }
                    if (i >= 256 && i <= 279) { lens[i] = 7; }
                    if (i >= 280) { lens[i] = 8; }
                    i = i + 1;
                }
                if (huff_build(lens, 288, lit_tree, scratch) < 0) { return -38; }
                i = 0;
                while (i < 32) { lens[i] = 5; i = i + 1; }
                if (huff_build(lens, 32, dist_tree, scratch) < 0) { return -39; }
            } else {
                // dynamic Huffman
                let hlit: i64 = br_take(cview, st, 5) + 257;
                let hdist: i64 = br_take(cview, st, 5) + 1;
                let hclen: i64 = br_take(cview, st, 4) + 4;
                if (hlit < 0 || hdist < 0 || hclen < 0) { return -40; }
                if (hlit > 288 || hdist > 32) { return -41; }
                let i: i64 = 0;
                while (i < 19) { lens[i] = 0; i = i + 1; }
                i = 0;
                while (i < hclen) {
                    let v: i64 = br_take(cview, st, 3);
                    if (v < 0) { return -42; }
                    lens[cl_order(i)] = v;
                    i = i + 1;
                }
                if (huff_build(lens, 19, lit_tree, scratch) < 0) { return -43; }
                // reuse dist_tree as temp for the cl tree
                let total: i64 = hlit + hdist;
                let got: i64 = 0;
                i = 0;
                while (i < 320) { lens[i] = 0; i = i + 1; }
                let prev: i64 = 0;
                while (got < total) {
                    let sym: i64 = huff_decode(cview, st, lit_tree);
                    if (sym < 0) { return -44; }
                    if (sym <= 15) {
                        lens[got] = sym;
                        prev = sym;
                        got = got + 1;
                    } else {
                        if (sym == 16) {
                            let rep: i64 = br_take(cview, st, 2) + 3;
                            if (rep < 0) { return -45; }
                            let k: i64 = 0;
                            while (k < rep) {
                                if (got >= total) { return -46; }
                                lens[got] = prev;
                                got = got + 1;
                                k = k + 1;
                            }
                        }
                        if (sym == 17) {
                            let rep2: i64 = br_take(cview, st, 3) + 3;
                            if (rep2 < 0) { return -47; }
                            let k2: i64 = 0;
                            while (k2 < rep2) {
                                if (got >= total) { return -48; }
                                lens[got] = 0;
                                got = got + 1;
                                k2 = k2 + 1;
                            }
                        }
                        if (sym == 18) {
                            let rep3: i64 = br_take(cview, st, 7) + 11;
                            if (rep3 < 0) { return -49; }
                            let k3: i64 = 0;
                            while (k3 < rep3) {
                                if (got >= total) { return -50; }
                                lens[got] = 0;
                                got = got + 1;
                                k3 = k3 + 1;
                            }
                        }
                    }
                }
                // split lens into lit (hlit) and dist (hdist); dlens saves dist lens
                // because huff_build clobbers its scratch area
                let dlens: []i64 = nio_alloc_z64(32);
                if ((dlens.len as i64) != 32) { return -50; }
                let dl: i64 = 0;
                while (dl < hdist) { dlens[dl] = lens[hlit + dl]; dl = dl + 1; }
                if (huff_build(lens, hlit, lit_tree, scratch) < 0) { return -51; }
                dl = 0;
                while (dl < hdist) { lens[dl] = dlens[dl]; dl = dl + 1; }
                if (huff_build(lens, hdist, dist_tree, scratch) < 0) { return -52; }
            }
            n = inf_block(cview, st, lit_tree, dist_tree, out, n, outcap);
            if (n < 0) { return n; }
        }
    }
    return n;
}

// ---------------- Paeth / unfilter ----------------
fn paeth(a: i64, b: i64, c: i64) i64 {
    let p: i64 = a + b - c;
    let pa: i64 = p - a;
    if (pa < 0) { pa = 0 - pa; }
    let pb: i64 = p - b;
    if (pb < 0) { pb = 0 - pb; }
    let pc: i64 = p - c;
    if (pc < 0) { pc = 0 - pc; }
    if (pa <= pb && pa <= pc) { return a; }
    if (pb <= pc) { return b; }
    return c;
}

// Unfilter one row: filt[fo..fo+n] -> recon[ro..ro+n]; prev[po..po+n] is prior recon row.
fn unfilter_row(filt: []u8, fo: i64, recon: []u8, ro: i64, prev: []u8, po: i64,
                n: i64, bpp: i64, ftype: i64) i64 {
    if (ftype < 0 || ftype > 4) { return -61; }
    let i: i64 = 0;
    while (i < n) {
        let f: i64 = (filt[fo + i] as i64) & 255;
        let a: i64 = 0;
        let cc: i64 = 0;
        if (i >= bpp) {
            a = (recon[ro + i - bpp] as i64) & 255;
            cc = (prev[po + i - bpp] as i64) & 255;
        }
        let bb: i64 = (prev[po + i] as i64) & 255;
        let v: i64 = f;
        if (ftype == 1) { v = f + a; }
        if (ftype == 2) { v = f + bb; }
        if (ftype == 3) { v = f + (a + bb) / 2; }
        if (ftype == 4) { v = f + paeth(a, bb, cc); }
        recon[ro + i] = (v & 255) as u8;
        i = i + 1;
    }
    return 0;
}

// sample si (0-based) of bit-depth bd from row at ro; bd in {1,2,4,8,16}, big-endian bits
fn get_sample(row: []u8, ro: i64, si: i64, bd: i64) i64 {
    if (bd == 16) {
        return (((row[ro + si * 2] as i64) & 255) << 8) | ((row[ro + si * 2 + 1] as i64) & 255);
    }
    if (bd == 8) { return (row[ro + si] as i64) & 255; }
    let bit: i64 = si * bd;
    let by: i64 = (row[ro + bit / 8] as i64) & 255;
    let sh: i64 = 8 - bd - (bit - (bit / 8) * 8);
    return (by >> sh) & ((1 << bd) - 1);
}

// Adam7 pass geometry: returns packed x0*2^48+y0*2^32+dx*2^16+dy ... use out arena instead
fn adam7_pass(p: i64, g: []i64) void {
    if (p == 0) { g[0] = 0; g[1] = 0; g[2] = 8; g[3] = 8; return; }
    if (p == 1) { g[0] = 4; g[1] = 0; g[2] = 8; g[3] = 8; return; }
    if (p == 2) { g[0] = 0; g[1] = 4; g[2] = 4; g[3] = 8; return; }
    if (p == 3) { g[0] = 2; g[1] = 0; g[2] = 4; g[3] = 4; return; }
    if (p == 4) { g[0] = 0; g[1] = 2; g[2] = 2; g[3] = 4; return; }
    if (p == 5) { g[0] = 1; g[1] = 0; g[2] = 2; g[3] = 2; return; }
    g[0] = 0; g[1] = 1; g[2] = 1; g[3] = 2;
    return;
}

fn adler32(b: []u8, o: i64, n: i64) i64 {
    let s1: i64 = 1;
    let s2: i64 = 0;
    let i: i64 = 0;
    while (i < n) {
        s1 = s1 + ((b[o + i] as i64) & 255);
        if (s1 >= 65521) { s1 = s1 - 65521; }
        // s1 can exceed 2*65521 after add? s1 < 65521+255, so one subtract suffices... but
        // do it safely with mod every 5552 bytes is the classic; single-sub is fine here
        // since s1 < 65521 before add: s1+255 < 65776 < 2*65521. OK.
        s2 = s2 + s1;
        if (s2 >= 65521) { s2 = s2 % 65521; }
        i = i + 1;
    }
    s1 = s1 % 65521;
    s2 = s2 % 65521;
    return s2 * 65536 + s1;
}

fn main() i32 {
    let inp: []u8 = _zag_arg(1);
    let outp: []u8 = _zag_arg(2);
    if (_zag_strcmp(inp, "") == 1) { _zag_println("need inpath"); return 1; }
    if (_zag_strcmp(outp, "") == 1) { _zag_println("need outpath"); return 1; }
    let b: []u8 = file_read(inp, 33554431);
    let blen: i64 = b.len as i64;
    if (blen < 33) { _zag_println("short file"); return 1; }
    if (!(b[0] == 137 && b[1] == 80 && b[2] == 78 && b[3] == 71 && b[4] == 13 && b[5] == 10 && b[6] == 26 && b[7] == 10)) {
        _zag_println("bad PNG signature"); return 1;
    }
    let ctab: []i64 = nio_alloc_z64(256);
    if ((ctab.len as i64) != 256) { _zag_println("alloc ctab failed"); return 1; }
    crc_tab(ctab);

    let w: i64 = -1;
    let h: i64 = -1;
    let bitdepth: i64 = 0;
    let ctype: i64 = -1;
    let interlace: i64 = 0;
    let plte: []u8 = nio_alloc_z(768);
    let nplte: i64 = 0;
    let idat: []u8 = nio_alloc_z(blen);
    if ((idat.len as i64) != blen) { _zag_println("alloc idat failed"); return 1; }
    let idat_n: i64 = 0;
    let seen_iend: i64 = 0;

    let off: i64 = 8;
    while (off + 12 <= blen) {
        let clen: i64 = rd_u32be(b, off);
        let t0: i64 = b[off + 4] as i64;
        let t1: i64 = b[off + 5] as i64;
        let t2: i64 = b[off + 6] as i64;
        let t3: i64 = b[off + 7] as i64;
        if (clen < 0 || off + 12 + clen > blen) { _zag_println("chunk overruns file"); return 1; }
        let doff: i64 = off + 8;
        // CRC over type+data
        let crc: i64 = crc_update(ctab, 4294967295, b, off + 4, 4);
        crc = crc_update(ctab, crc, b, doff, clen);
        crc = crc ^ 4294967295;
        let want: i64 = rd_u32be(b, doff + clen);
        if (crc != want) { _zag_println("chunk CRC mismatch"); return 1; }
        // IHDR
        if (t0 == 73 && t1 == 72 && t2 == 68 && t3 == 82) {
            if (clen != 13) { _zag_println("bad IHDR"); return 1; }
            w = rd_u32be(b, doff);
            h = rd_u32be(b, doff + 4);
            bitdepth = b[doff + 8] as i64;
            ctype = b[doff + 9] as i64;
            let cm: i64 = b[doff + 10] as i64;
            let fm: i64 = b[doff + 11] as i64;
            interlace = b[doff + 12] as i64;
            if (cm != 0 || fm != 0) { _zag_println("unsupported comp/filter method"); return 1; }
            if (interlace != 0 && interlace != 1) { _zag_println("bad interlace"); return 1; }
        }
        // PLTE
        if (t0 == 80 && t1 == 76 && t2 == 84 && t3 == 69) {
            if (clen > 768 || clen % 3 != 0) { _zag_println("bad PLTE"); return 1; }
            let i: i64 = 0;
            while (i < clen) { plte[i] = b[doff + i]; i = i + 1; }
            nplte = clen / 3;
        }
        // IDAT: concatenate
        if (t0 == 73 && t1 == 68 && t2 == 65 && t3 == 84) {
            let i: i64 = 0;
            while (i < clen) { idat[idat_n + i] = b[doff + i]; i = i + 1; }
            idat_n = idat_n + clen;
        }
        // IEND
        if (t0 == 73 && t1 == 69 && t2 == 78 && t3 == 68) { seen_iend = 1; off = off + 12 + clen; break; }
        off = off + 12 + clen;
    }
    if (w < 1 || h < 1 || ctype < 0) { _zag_println("missing IHDR"); return 1; }
    if (seen_iend == 0) { _zag_println("missing IEND"); return 1; }
    if (w > 4096 || h > 4096 || w * h * 3 > 30000000) { _zag_println("image too big"); return 1; }
    // validate color type / bit depth combos
    let spp: i64 = 0; // samples per pixel
    if (ctype == 0) {
        if (!(bitdepth == 1 || bitdepth == 2 || bitdepth == 4 || bitdepth == 8 || bitdepth == 16)) { _zag_println("bad bd for gray"); return 1; }
        spp = 1;
    }
    if (ctype == 2) {
        if (!(bitdepth == 8 || bitdepth == 16)) { _zag_println("bad bd for rgb"); return 1; }
        spp = 3;
    }
    if (ctype == 3) {
        if (!(bitdepth == 1 || bitdepth == 2 || bitdepth == 4 || bitdepth == 8)) { _zag_println("bad bd for palette"); return 1; }
        if (nplte == 0) { _zag_println("palette without PLTE"); return 1; }
        spp = 1;
    }
    if (ctype == 4) {
        if (!(bitdepth == 8 || bitdepth == 16)) { _zag_println("bad bd for gray+alpha"); return 1; }
        spp = 2;
    }
    if (ctype == 6) {
        if (!(bitdepth == 8 || bitdepth == 16)) { _zag_println("bad bd for rgba"); return 1; }
        spp = 4;
    }
    if (spp == 0) { _zag_println("bad color type"); return 1; }
    let bitspp: i64 = spp * bitdepth;
    let rbpp: i64 = (bitspp + 7) / 8; // bytes per pixel for filtering

    // ---- zlib: header check, inflate, adler ----
    if (idat_n < 6) { _zag_println("idat too short"); return 1; }
    let cmf: i64 = idat[0] as i64;
    let flg: i64 = idat[1] as i64;
    if ((cmf * 256 + flg) % 31 != 0) { _zag_println("bad zlib header"); return 1; }
    if ((cmf & 15) != 8) { _zag_println("not deflate"); return 1; }
    // decompressed size
    let declen: i64 = 0;
    if (interlace == 0) {
        declen = h * (1 + (w * bitspp + 7) / 8);
    } else {
        let p: i64 = 0;
        let g: []i64 = nio_alloc_z64(4);
        while (p < 7) {
            adam7_pass(p, g);
            let pw: i64 = 0;
            let ph: i64 = 0;
            if (g[0] < w) { pw = (w - g[0] + g[2] - 1) / g[2]; }
            if (g[1] < h) { ph = (h - g[1] + g[3] - 1) / g[3]; }
            if (pw > 0 && ph > 0) { declen = declen + ph * (1 + (pw * bitspp + 7) / 8); }
            p = p + 1;
        }
    }
    if (declen < 1 || declen > 33554432) { _zag_println("bad declen"); return 1; }
    let fbuf: []u8 = nio_alloc_z(declen);
    if ((fbuf.len as i64) != declen) { _zag_println("alloc fbuf failed"); return 1; }
    let lit_tree: []i64 = nio_alloc_z64(4 * (2 * 288 + 4));
    let dist_tree: []i64 = nio_alloc_z64(4 * (2 * 32 + 4));
    let lens: []i64 = nio_alloc_z64(320);
    let hscratch: []i64 = nio_alloc_z64(64);
    if ((lit_tree.len as i64) == 0 || (dist_tree.len as i64) == 0 || (lens.len as i64) == 0 || (hscratch.len as i64) == 0) {
        _zag_println("alloc huff failed"); return 1;
    }
    // inflate over idat[2 .. idat_n-4] (strip zlib header + adler)
    let got: i64 = inflate_raw(idat, 2, idat_n - 4, fbuf, declen, lit_tree, dist_tree, lens, hscratch);
    if (got != declen) {
        _zag_print("inflate size mismatch got=");
        let sg: []u8 = _zag_i64_to_str(got);
        _zag_print(sg);
        _zag_print(" want=");
        let sw: []u8 = _zag_i64_to_str(declen);
        _zag_println(sw);
        return 1;
    }
    let adler_want: i64 = rd_u32be(idat, idat_n - 4);
    let adler_got: i64 = adler32(fbuf, 0, declen);
    if (adler_got != adler_want) { _zag_println("adler mismatch"); return 1; }

    // ---- unfilter + convert to RGB ----
    let rgb: []u8 = nio_alloc_z(w * h * 3);
    if ((rgb.len as i64) != w * h * 3) { _zag_println("alloc rgb failed"); return 1; }
    let rowbuf: []u8 = nio_alloc_z((w * bitspp + 7) / 8 + 16);
    let prev: []u8 = nio_alloc_z((w * bitspp + 7) / 8 + 16);
    if ((rowbuf.len as i64) == 0 || (prev.len as i64) == 0) { _zag_println("alloc rowbuf failed"); return 1; }
    let fpos: i64 = 0;
    let rc: i64 = 0;

    // convert one unfiltered row (rowbuf, nbytes) at pass-width pw into rgb at scatter fn
    // (inlined per pass below via explicit loops calling conv_pixel)
    if (interlace == 0) {
        // zero prev
        let i: i64 = 0;
        while (i < (prev.len as i64)) { prev[i] = 0; i = i + 1; }
        let y: i64 = 0;
        while (y < h) {
            let stride: i64 = (w * bitspp + 7) / 8;
            let ftype: i64 = fbuf[fpos] as i64;
            rc = unfilter_row(fbuf, fpos + 1, rowbuf, 0, prev, 0, stride, rbpp, ftype);
            if (rc != 0) { _zag_println("unfilter failed"); return 1; }
            // swap prev/rowbuf contents: copy rowbuf -> prev
            i = 0;
            while (i < stride) { prev[i] = rowbuf[i]; i = i + 1; }
            // convert pixels
            let x: i64 = 0;
            while (x < w) {
                let r: i64 = 0;
                let gg: i64 = 0;
                let bb: i64 = 0;
                if (ctype == 0) {
                    let v: i64 = get_sample(rowbuf, 0, x, bitdepth);
                    if (bitdepth == 16) { v = v >> 8; }
                    if (bitdepth < 8) { v = v * 255 / ((1 << bitdepth) - 1); }
                    r = v; gg = v; bb = v;
                }
                if (ctype == 2) {
                    r = get_sample(rowbuf, 0, x * 3, bitdepth);
                    gg = get_sample(rowbuf, 0, x * 3 + 1, bitdepth);
                    bb = get_sample(rowbuf, 0, x * 3 + 2, bitdepth);
                    if (bitdepth == 16) { r = r >> 8; gg = gg >> 8; bb = bb >> 8; }
                }
                if (ctype == 3) {
                    let pi: i64 = get_sample(rowbuf, 0, x, bitdepth);
                    if (pi >= nplte) { _zag_println("palette index oob"); return 1; }
                    r = plte[pi * 3] as i64;
                    gg = plte[pi * 3 + 1] as i64;
                    bb = plte[pi * 3 + 2] as i64;
                }
                if (ctype == 4) {
                    let v2: i64 = get_sample(rowbuf, 0, x * 2, bitdepth);
                    if (bitdepth == 16) { v2 = v2 >> 8; }
                    r = v2; gg = v2; bb = v2;
                }
                if (ctype == 6) {
                    r = get_sample(rowbuf, 0, x * 4, bitdepth);
                    gg = get_sample(rowbuf, 0, x * 4 + 1, bitdepth);
                    bb = get_sample(rowbuf, 0, x * 4 + 2, bitdepth);
                    if (bitdepth == 16) { r = r >> 8; gg = gg >> 8; bb = bb >> 8; }
                }
                let o: i64 = (y * w + x) * 3;
                rgb[o] = (r & 255) as u8;
                rgb[o + 1] = (gg & 255) as u8;
                rgb[o + 2] = (bb & 255) as u8;
                x = x + 1;
            }
            fpos = fpos + 1 + stride;
            y = y + 1;
        }
    } else {
        let g2: []i64 = nio_alloc_z64(4);
        let p: i64 = 0;
        while (p < 7) {
            adam7_pass(p, g2);
            let x0: i64 = g2[0];
            let y0: i64 = g2[1];
            let dx: i64 = g2[2];
            let dy: i64 = g2[3];
            let pw: i64 = 0;
            let ph: i64 = 0;
            if (x0 < w) { pw = (w - x0 + dx - 1) / dx; }
            if (y0 < h) { ph = (h - y0 + dy - 1) / dy; }
            if (pw > 0 && ph > 0) {
                let stride2: i64 = (pw * bitspp + 7) / 8;
                let i2: i64 = 0;
                while (i2 < (prev.len as i64)) { prev[i2] = 0; i2 = i2 + 1; }
                let py: i64 = 0;
                while (py < ph) {
                    let ftype2: i64 = fbuf[fpos] as i64;
                    rc = unfilter_row(fbuf, fpos + 1, rowbuf, 0, prev, 0, stride2, rbpp, ftype2);
                    if (rc != 0) { _zag_println("unfilter adam7 failed"); return 1; }
                    i2 = 0;
                    while (i2 < stride2) { prev[i2] = rowbuf[i2]; i2 = i2 + 1; }
                    let px2: i64 = 0;
                    while (px2 < pw) {
                        let r: i64 = 0;
                        let gg: i64 = 0;
                        let bb: i64 = 0;
                        if (ctype == 0) {
                            let v: i64 = get_sample(rowbuf, 0, px2, bitdepth);
                            if (bitdepth == 16) { v = v >> 8; }
                            if (bitdepth < 8) { v = v * 255 / ((1 << bitdepth) - 1); }
                            r = v; gg = v; bb = v;
                        }
                        if (ctype == 2) {
                            r = get_sample(rowbuf, 0, px2 * 3, bitdepth);
                            gg = get_sample(rowbuf, 0, px2 * 3 + 1, bitdepth);
                            bb = get_sample(rowbuf, 0, px2 * 3 + 2, bitdepth);
                            if (bitdepth == 16) { r = r >> 8; gg = gg >> 8; bb = bb >> 8; }
                        }
                        if (ctype == 3) {
                            let pi: i64 = get_sample(rowbuf, 0, px2, bitdepth);
                            if (pi >= nplte) { _zag_println("palette index oob"); return 1; }
                            r = plte[pi * 3] as i64;
                            gg = plte[pi * 3 + 1] as i64;
                            bb = plte[pi * 3 + 2] as i64;
                        }
                        if (ctype == 4) {
                            let v2: i64 = get_sample(rowbuf, 0, px2 * 2, bitdepth);
                            if (bitdepth == 16) { v2 = v2 >> 8; }
                            r = v2; gg = v2; bb = v2;
                        }
                        if (ctype == 6) {
                            r = get_sample(rowbuf, 0, px2 * 4, bitdepth);
                            gg = get_sample(rowbuf, 0, px2 * 4 + 1, bitdepth);
                            bb = get_sample(rowbuf, 0, px2 * 4 + 2, bitdepth);
                            if (bitdepth == 16) { r = r >> 8; gg = gg >> 8; bb = bb >> 8; }
                        }
                        let ox: i64 = x0 + px2 * dx;
                        let oy: i64 = y0 + py * dy;
                        let oo: i64 = (oy * w + ox) * 3;
                        rgb[oo] = (r & 255) as u8;
                        rgb[oo + 1] = (gg & 255) as u8;
                        rgb[oo + 2] = (bb & 255) as u8;
                        px2 = px2 + 1;
                    }
                    fpos = fpos + 1 + stride2;
                    py = py + 1;
                }
            }
            p = p + 1;
        }
    }
    let erc: i64 = emit_held_image(outp, w, h, rgb);
    if (erc < 0) { _zag_println("emit failed"); return 1; }
    _zag_print("png ok ");
    let sw2: []u8 = _zag_i64_to_str(w);
    _zag_print(sw2);
    _zag_print("x");
    let sh2: []u8 = _zag_i64_to_str(h);
    _zag_print(sh2);
    _zag_print(" ct=");
    let sc2: []u8 = _zag_i64_to_str(ctype);
    _zag_println(sc2);
    return 0;
}

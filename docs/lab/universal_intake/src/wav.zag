// wav.zag — UNIVERSAL WAV intake decoder (Workstream A).
// Native RIFF/WAVE parser: PCM 8/16/24/32-bit, IEEE float 32/64-bit,
// WAVE_FORMAT_EXTENSIBLE (PCM/float subformats), any channel count, any rate.
// Chunk-aware walk (skips JUNK/LIST/bext/fact/pad bytes); fails loud on malformed.
//
// Held audio layout (same as raw path): "TNINAUD1" + nch,sr,nsamp u64le
//   + nsamp*nch i64le samples, interleaved.
// Sample domain rule (documented, exact):
//   PCM int: sign-extended native domain (8-bit: -128..127 from unsigned byte-128;
//            16: -32768..32767; 24/32: full width).
//   IEEE float: clamp to [-1,1], then round-half-away-from-zero of v * 2^31.
//     (Matches the Python oracle bit-exactly; both use IEEE-754 double ops.)
// The first-64-samples contract: ALL samples 0..nsamp-1 are stored; nothing is
// fabricated. (The 2026-09-26 intake bug — dropped 0..63 — is not inherited.)
//
// Usage: wav <inpath.wav> <outpath.held>
// Pure Zag, zero RNG.
@import("./common.zag")

// 2^k as f64 via loop (float literals have limited magnitude in znc)
fn pow2f(k: i64) f64 {
    let v: f64 = 1.0;
    if (k >= 0) {
        let i: i64 = 0;
        while (i < k) { v = v * 2.0; i = i + 1; }
    } else {
        let i: i64 = 0;
        while (i > k) { v = v / 2.0; i = i - 1; }
    }
    return v;
}

// IEEE-754 binary32 bits -> f64. Handles normals, denormals, zero; inf/nan -> clamp flag.
fn f32_to_f64(bits: i64) f64 {
    let mant: i64 = bits & 8388607;
    let exp: i64 = (bits >> 23) & 255;
    let neg: i64 = (bits >> 31) & 1;
    let v: f64 = 0.0;
    if (exp == 0) {
        // denormal or zero
        if (mant != 0) { v = (mant as f64) / 8388608.0 * pow2f(-126); }
    } else {
        if (exp == 255) {
            // inf/nan: saturate to max finite (WAV data never carries these)
            v = (2.0 - pow2f(-23)) * pow2f(127);
        } else {
            v = (1.0 + (mant as f64) / 8388608.0) * pow2f(exp - 127);
        }
    }
    if (neg == 1) { v = 0.0 - v; }
    return v;
}

// IEEE-754 binary64 (hi,lo u32) -> f64.
fn f64_from_bits(hi: i64, lo: i64) f64 {
    let exp: i64 = (hi >> 20) & 2047;
    let neg: i64 = (hi >> 31) & 1;
    let mant_hi: i64 = hi & 1048575;
    // mantissa 52 bits as f64: mant_hi * 2^32 + lo
    let mantf: f64 = (mant_hi as f64) * 4294967296.0 + (lo as f64);
    let v: f64 = 0.0;
    if (exp == 0) {
        if (mantf != 0.0) { v = mantf / 4503599627370496.0 * pow2f(-1022); }
    } else {
        if (exp == 2047) {
            // inf/nan: saturate to max finite
            v = (2.0 - pow2f(-52)) * pow2f(1023);
        } else {
            v = (1.0 + mantf / 4503599627370496.0) * pow2f(exp - 1023);
        }
    }
    if (neg == 1) { v = 0.0 - v; }
    return v;
}

fn f_round_away(x: f64) i64 {
    if (x >= 0.0) { return (x + 0.5) as i64; }
    return (x - 0.5) as i64;
}

fn main() i32 {
    let inp: []u8 = _zag_arg(1);
    let outp: []u8 = _zag_arg(2);
    if (_zag_strcmp(inp, "") == 1) { _zag_println("need inpath"); return 1; }
    if (_zag_strcmp(outp, "") == 1) { _zag_println("need outpath"); return 1; }
    let b: []u8 = file_read(inp, 33554431);
    let blen: i64 = b.len as i64;
    if (blen < 44) { _zag_println("short file"); return 1; }
    if (b[0] == 82 && b[1] == 70 && b[2] == 54 && b[3] == 52) { _zag_println("RF64 not supported"); return 1; }
    if (!(b[0] == 82 && b[1] == 73 && b[2] == 70 && b[3] == 70)) { _zag_println("not RIFF"); return 1; }
    if (!(b[8] == 87 && b[9] == 65 && b[10] == 86 && b[11] == 69)) { _zag_println("not WAVE"); return 1; }

    let afmt: i64 = -1;
    let nch: i64 = 0;
    let sr: i64 = 0;
    let bits: i64 = 0;
    let dstart: i64 = -1;
    let dsize: i64 = 0;
    let ext_sub: i64 = -1; // extensible subformat tag

    let off: i64 = 12;
    while (off + 8 <= blen) {
        let sz: i64 = rd_u32le(b, off + 4);
        if (sz < 0 || off + 8 + sz > blen) { _zag_println("chunk overruns file"); return 1; }
        let c0: i64 = b[off] as i64;
        let c1: i64 = b[off + 1] as i64;
        let c2: i64 = b[off + 2] as i64;
        let c3: i64 = b[off + 3] as i64;
        if (c0 == 102 && c1 == 109 && c2 == 116 && c3 == 32) { // "fmt "
            if (sz < 16) { _zag_println("bad fmt size"); return 1; }
            afmt = rd_u16le(b, off + 8);
            nch = rd_u16le(b, off + 10);
            sr = rd_u32le(b, off + 12);
            bits = rd_u16le(b, off + 22);
            if (afmt == 65534) { // WAVE_FORMAT_EXTENSIBLE
                if (sz < 40) { _zag_println("bad extensible fmt"); return 1; }
                // SubFormat GUID first u16 at off+8+24
                ext_sub = rd_u16le(b, off + 32);
            }
        }
        if (c0 == 100 && c1 == 97 && c2 == 116 && c3 == 97) { // "data"
            dstart = off + 8;
            dsize = sz;
        }
        off = off + 8 + sz + (sz & 1);
    }
    if (afmt < 0 || dstart < 0) { _zag_println("missing fmt or data"); return 1; }
    // resolve extensible -> base format
    if (afmt == 65534) {
        if (ext_sub == 1) { afmt = 1; }
        if (ext_sub == 3) { afmt = 3; }
    }
    if (nch < 1 || nch > 64) { _zag_println("bad channel count"); return 1; }
    if (sr < 1 || sr > 768000) { _zag_println("bad sample rate"); return 1; }
    let is_pcm: i64 = 0;
    let is_flt: i64 = 0;
    if (afmt == 1) { is_pcm = 1; }
    if (afmt == 3) { is_flt = 1; }
    if (is_pcm == 0 && is_flt == 0) { _zag_println("unsupported audio format"); return 1; }
    if (is_pcm == 1) {
        if (!(bits == 8 || bits == 16 || bits == 24 || bits == 32)) { _zag_println("unsupported pcm bits"); return 1; }
    } else {
        if (!(bits == 32 || bits == 64)) { _zag_println("unsupported float bits"); return 1; }
    }
    let bps: i64 = bits / 8;
    let frame: i64 = nch * bps;
    if (frame < 1) { _zag_println("bad frame"); return 1; }
    let nsamp: i64 = dsize / frame;
    if (nsamp < 1) { _zag_println("empty data"); return 1; }
    if (dstart + nsamp * frame > blen) { _zag_println("data truncated"); return 1; }
    if (nsamp * nch > 33554432) { _zag_println("too many samples"); return 1; }

    let smp: []i64 = nio_alloc_z64(nsamp * nch);
    if ((smp.len as i64) != nsamp * nch) { _zag_println("alloc samples failed"); return 1; }
    let sc31: f64 = 2147483647.0 + 1.0;
    let s: i64 = 0;
    while (s < nsamp) {
        let c: i64 = 0;
        while (c < nch) {
            let o: i64 = dstart + s * frame + c * bps;
            let v: i64 = 0;
            if (is_pcm == 1) {
                if (bits == 8) { v = ((b[o] as i64) & 255) - 128; }
                if (bits == 16) { v = rd_i16le(b, o); }
                if (bits == 24) { v = rd_i24le(b, o); }
                if (bits == 32) { v = rd_i32le(b, o); }
            } else {
                if (bits == 32) {
                    let fv: f64 = f32_to_f64(rd_u32le(b, o));
                    if (fv > 1.0) { fv = 1.0; }
                    if (fv < -1.0) { fv = -1.0; }
                    v = f_round_away(fv * sc31);
                    if (v > 2147483647) { v = 2147483647; }
                    if (v < -2147483648) { v = -2147483648; }
                } else {
                    let fv2: f64 = f64_from_bits(rd_u32le(b, o + 4), rd_u32le(b, o));
                    if (fv2 > 1.0) { fv2 = 1.0; }
                    if (fv2 < -1.0) { fv2 = -1.0; }
                    v = f_round_away(fv2 * sc31);
                    if (v > 2147483647) { v = 2147483647; }
                    if (v < -2147483648) { v = -2147483648; }
                }
            }
            smp[s * nch + c] = v;
            c = c + 1;
        }
        s = s + 1;
    }
    let rc: i64 = emit_held_audio(outp, nch, sr, nsamp, smp);
    if (rc < 0) { _zag_println("emit failed"); return 1; }
    _zag_print("wav ok nch=");
    let s1: []u8 = _zag_i64_to_str(nch);
    _zag_print(s1);
    _zag_print(" sr=");
    let s2: []u8 = _zag_i64_to_str(sr);
    _zag_print(s2);
    _zag_print(" nsamp=");
    let s3: []u8 = _zag_i64_to_str(nsamp);
    _zag_println(s3);
    return 0;
}

// common.zag — shared intake infrastructure for Workstream A (Universal Format Intake).
// Pure Zag, zero RNG. Pinned toolchain: znc_linux_x86_64_abed8aa1.
// Direct-path file IO (open/read/write syscalls), LE/BE accessors, bit readers,
// canonical Huffman tree builder, held-format emitters.
//
// Held image format:  "TNINIMG1" + w u64le + h u64le + w*h*3 RGB bytes (top-down).
// Held audio format:  "TNINAUD1" + nch u64le + sr u64le + nsamp u64le + nsamp*nch i64le (interleaved).

fn cstr(s: []u8) []u8 {
    if (s.len < 1 || s.len > 4095) { return ""; }
    let p: *u8 = _zag_malloc((s.len + 1) as i64) as *u8;
    if (p == null as *u8) { return ""; }
    let b: []u8 = p[0..(s.len + 1)];
    let i: i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

// Read whole file at path (O_RDONLY). Returns bytes; empty on any failure.
fn file_read(path: []u8, cap: i64) []u8 {
    let cs: []u8 = cstr(path);
    if (cs.len == 0) { return ""; }
    let fd: i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 0, 0, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return ""; }
    if (cap < 1 || cap > 33554431) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return ""; }
    let p: *u8 = _zag_malloc(cap) as *u8;
    if (p == null as *u8) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return ""; }
    let at: i64 = 0;
    while (at < cap) {
        let n: i64 = _zag_raw_syscall(0, fd, (p as i64) + at, cap - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let b: []u8 = p[0..at];
    return b;
}

// Write whole buffer to path, truncating any existing file (O_WRONLY|O_CREAT|O_TRUNC).
// Returns bytes written, or negative on failure.
fn file_write_trunc(path: []u8, data: []u8) i64 {
    let cs: []u8 = cstr(path);
    if (cs.len == 0) { return -1; }
    let fd: i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 577, 420, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return -2; }
    let at: i64 = 0;
    let total: i64 = data.len as i64;
    while (at < total) {
        let n: i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(data) as i64) + at, total - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return -3; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return at;
}

// ---------------- integer accessors ([]u8 arenas; ZNC-007: never as []i32) ----------------
fn rd_u16le(b: []u8, o: i64) i64 {
    return ((b[o] as i64) & 255) | (((b[o + 1] as i64) & 255) << 8);
}
fn rd_i16le(b: []u8, o: i64) i64 {
    let v: i64 = rd_u16le(b, o);
    if (v >= 32768) { v = v - 65536; }
    return v;
}
fn rd_u32le(b: []u8, o: i64) i64 {
    return ((b[o] as i64) & 255) | (((b[o + 1] as i64) & 255) << 8) | (((b[o + 2] as i64) & 255) << 16) | (((b[o + 3] as i64) & 255) << 24);
}
fn rd_i32le(b: []u8, o: i64) i64 {
    let v: i64 = rd_u32le(b, o);
    if (v >= 2147483648) { v = v - 4294967296; }
    return v;
}
fn rd_u16be(b: []u8, o: i64) i64 {
    return (((b[o] as i64) & 255) << 8) | ((b[o + 1] as i64) & 255);
}
fn rd_u32be(b: []u8, o: i64) i64 {
    return (((b[o] as i64) & 255) << 24) | (((b[o + 1] as i64) & 255) << 16) | (((b[o + 2] as i64) & 255) << 8) | ((b[o + 3] as i64) & 255);
}
fn rd_i24le(b: []u8, o: i64) i64 {
    let v: i64 = ((b[o] as i64) & 255) | (((b[o + 1] as i64) & 255) << 8) | (((b[o + 2] as i64) & 255) << 16);
    if (v >= 8388608) { v = v - 16777216; }
    return v;
}
fn rd_u64le(b: []u8, o: i64) i64 {
    let v: i64 = 0;
    let i: i64 = 0;
    while (i < 8) { v = v | (((b[o + i] as i64) & 255) << (i * 8)); i = i + 1; }
    return v;
}
fn wr_u64le(b: []u8, o: i64, v: i64) void {
    let i: i64 = 0;
    while (i < 8) { b[o + i] = ((v >> (i * 8)) & 255) as u8; i = i + 1; }
    return;
}
fn wr_u32le(b: []u8, o: i64, v: i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    return;
}
fn wr_u32be(b: []u8, o: i64, v: i64) void {
    b[o] = ((v >> 24) & 255) as u8;
    b[o + 1] = ((v >> 16) & 255) as u8;
    b[o + 2] = ((v >> 8) & 255) as u8;
    b[o + 3] = (v & 255) as u8;
    return;
}

// ---------------- bit reader ----------------
// st: []i64 len 4 — [0]=bytepos, [1]=bitbuf, [2]=nbits, [3]=mode (0=MSB-first, 1=LSB-first)
fn br_new(st: []i64, mode: i64) void {
    st[0] = 0; st[1] = 0; st[2] = 0; st[3] = mode;
    return;
}
// Ensure n bits available; returns 1 ok, 0 at end of buffer.
fn br_fill(buf: []u8, st: []i64, n: i64) i64 {
    while (st[2] < n) {
        if (st[0] >= (buf.len as i64)) { return 0; }
        let b: i64 = (buf[st[0]] as i64) & 255;
        st[0] = st[0] + 1;
        if (st[3] == 0) { st[1] = (st[1] << 8) | b; } else { st[1] = st[1] | (b << st[2]); }
        st[2] = st[2] + 8;
    }
    return 1;
}
// Peek n bits without consuming (MSB: top bits; LSB: low bits). -1 if unavailable.
fn br_peek(buf: []u8, st: []i64, n: i64) i64 {
    if (n < 1 || n > 32) { return -1; }
    if (br_fill(buf, st, n) == 0) { return -1; }
    if (st[3] == 0) {
        let sh: i64 = st[2] - n;
        let mask: i64 = 4294967295;
        if (n < 32) { mask = (1 << n) - 1; }
        return (st[1] >> sh) & mask;
    }
    let mask2: i64 = 4294967295;
    if (n < 32) { mask2 = (1 << n) - 1; }
    return st[1] & mask2;
}
// Consume n bits (must have peeked first, or call br_take which fills).
fn br_drop(st: []i64, n: i64) void {
    if (st[3] == 0) {
        let keep: i64 = st[2] - n;
        if (keep <= 0) { st[1] = 0; st[2] = 0; return; }
        let mask: i64 = 4294967295;
        if (keep < 32) { mask = (1 << keep) - 1; }
        st[1] = st[1] & mask;
        st[2] = keep;
    } else {
        st[1] = st[1] >> n;
        st[2] = st[2] - n;
    }
    return;
}
fn br_take(buf: []u8, st: []i64, n: i64) i64 {
    if (n == 0) { return 0; }
    let v: i64 = br_peek(buf, st, n);
    if (v < 0) { return -1; }
    br_drop(st, n);
    return v;
}
// Byte position of next unread byte (after discarding buffered bits).
fn br_bytepos(st: []i64) i64 {
    return st[0];
}

// ---------------- canonical Huffman ----------------
// Build a binary decode tree from code lengths.
// lens: []i64 code lengths per symbol (0 = unused), nsym symbols.
// tree: []i64 arena, needs >= 4*(2*nsym+4) entries. scratch: []i64 >= 32 entries.
// Node w (0-based): tree[4w]=left, tree[4w+1]=right, tree[4w+2]=symbol, tree[4w+3]=isleaf.
// Returns root node index (0), or -1 on error.
fn huff_build(lens: []i64, nsym: i64, tree: []i64, scratch: []i64) i64 {
    let i: i64 = 0;
    while (i < 32) { scratch[i] = 0; i = i + 1; }
    let maxlen: i64 = 0;
    i = 0;
    while (i < nsym) {
        let l: i64 = lens[i];
        if (l < 0 || l > 31) { return -1; }
        if (l > 0) { scratch[l] = scratch[l] + 1; if (l > maxlen) { maxlen = l; } }
        i = i + 1;
    }
    if (maxlen == 0) { return -1; }
    // next_code per length (canonical assignment)
    let code: i64 = 0;
    let len: i64 = 1;
    while (len <= maxlen) {
        code = (code + scratch[len - 1]) << 1;
        scratch[16 + len] = code;
        len = len + 1;
    }
    // init root
    tree[0] = -1; tree[1] = -1; tree[2] = -1; tree[3] = 0;
    let nnode: i64 = 1;
    let s: i64 = 0;
    while (s < nsym) {
        let l: i64 = lens[s];
        if (l > 0) {
            let c: i64 = scratch[16 + l];
            scratch[16 + l] = c + 1;
            let node: i64 = 0;
            let b: i64 = l - 1;
            while (b >= 0) {
                let bit: i64 = (c >> b) & 1;
                let w: i64 = node * 4;
                let child: i64 = tree[w];
                if (bit == 1) { child = tree[w + 1]; }
                if (child < 0) {
                    child = nnode;
                    nnode = nnode + 1;
                    let cw: i64 = child * 4;
                    tree[cw] = -1; tree[cw + 1] = -1; tree[cw + 2] = -1; tree[cw + 3] = 0;
                    if (bit == 0) { tree[w] = child; } else { tree[w + 1] = child; }
                }
                node = child;
                b = b - 1;
            }
            let lw: i64 = node * 4;
            tree[lw + 2] = s;
            tree[lw + 3] = 1;
        }
        s = s + 1;
    }
    return 0;
}

// Decode one symbol by walking the tree bit-by-bit. Returns symbol, or -1 on EOF/error.
fn huff_decode(buf: []u8, st: []i64, tree: []i64) i64 {
    let node: i64 = 0;
    while (1 == 1) {
        let w: i64 = node * 4;
        if (tree[w + 3] == 1) { return tree[w + 2]; }
        let bit: i64 = br_take(buf, st, 1);
        if (bit < 0) { return -1; }
        if (bit == 0) { node = tree[w]; } else { node = tree[w + 1]; }
        if (node < 0) { return -1; }
    }
    return -1;
}

// ---------------- held-format emitters ----------------
// Emit held image: magic + w,h u64le + RGB bytes. Returns bytes written or negative.
fn emit_held_image(outpath: []u8, w: i64, h: i64, rgb: []u8) i64 {
    let total: i64 = 8 + 8 + 8 + (w * h * 3);
    let b: []u8 = nio_alloc_z(total);
    if ((b.len as i64) != total) { return -11; }
    b[0] = 84; b[1] = 78; b[2] = 73; b[3] = 78; b[4] = 73; b[5] = 77; b[6] = 71; b[7] = 49;
    wr_u64le(b, 8, w);
    wr_u64le(b, 16, h);
    let i: i64 = 0;
    let n: i64 = w * h * 3;
    while (i < n) { b[24 + i] = rgb[i]; i = i + 1; }
    let rc: i64 = file_write_trunc(outpath, b);
    return rc;
}

// Emit held audio: magic + nch,sr,nsamp u64le + nsamp*nch i64le. Returns bytes written or negative.
fn emit_held_audio(outpath: []u8, nch: i64, sr: i64, nsamp: i64, smp: []i64) i64 {
    let total: i64 = 8 + 24 + nsamp * nch * 8;
    let b: []u8 = nio_alloc_z(total);
    if ((b.len as i64) != total) { return -11; }
    b[0] = 84; b[1] = 78; b[2] = 73; b[3] = 78; b[4] = 65; b[5] = 85; b[6] = 68; b[7] = 49;
    wr_u64le(b, 8, nch);
    wr_u64le(b, 16, sr);
    wr_u64le(b, 24, nsamp);
    let i: i64 = 0;
    let n: i64 = nsamp * nch;
    while (i < n) { wr_u64le(b, 32 + i * 8, smp[i]); i = i + 1; }
    let rc: i64 = file_write_trunc(outpath, b);
    return rc;
}

// zeroing allocator (uninitialized heap is NOT reliably zeroed — AGENTS.md)
fn nio_alloc_z(n: i64) []u8 {
    if (n < 1 || n > 33554432) { return ""; }
    let p: *u8 = _zag_malloc(n) as *u8;
    if (p == null as *u8) { return ""; }
    let b: []u8 = p[0..n];
    let i: i64 = 0;
    while (i < n) { b[i] = 0; i = i + 1; }
    return b;
}
fn nio_alloc_z64(n: i64) []i64 {
    let nn: i64 = n;
    if (nn < 0 || nn > 4194304) { nn = 0; }
    let p: *i64 = _zag_malloc(nn * 8 + 8) as *i64;
    if (p == null as *i64) {
        let q: *i64 = _zag_malloc(8) as *i64;
        return q[0..0];
    }
    let i: i64 = 0;
    while (i < nn) { p[i] = 0; i = i + 1; }
    let b: []i64 = p[0..nn];
    return b;
}


// ---------- file: read entire file (up to 2^25-1 bytes) ----------
fn file_read_all(path: []u8) []u8 {
    return file_read(path, 33554431);
}

// ---------- JPEG zigzag: index k (0..63) -> natural order position ----------
fn zag_zig(k: i64) i64 {
    // zigzag scan order table
    let z: i64 = 0;
    if (k == 0) { z = 0; }
    else if (k == 1) { z = 1; } else if (k == 2) { z = 8; }
    else if (k == 3) { z = 16; } else if (k == 4) { z = 9; }
    else if (k == 5) { z = 2; } else if (k == 6) { z = 3; }
    else if (k == 7) { z = 10; } else if (k == 8) { z = 17; }
    else if (k == 9) { z = 24; } else if (k == 10) { z = 32; }
    else if (k == 11) { z = 25; } else if (k == 12) { z = 18; }
    else if (k == 13) { z = 11; } else if (k == 14) { z = 4; }
    else if (k == 15) { z = 5; } else if (k == 16) { z = 12; }
    else if (k == 17) { z = 19; } else if (k == 18) { z = 26; }
    else if (k == 19) { z = 33; } else if (k == 20) { z = 40; }
    else if (k == 21) { z = 48; } else if (k == 22) { z = 41; }
    else if (k == 23) { z = 34; } else if (k == 24) { z = 27; }
    else if (k == 25) { z = 20; } else if (k == 26) { z = 13; }
    else if (k == 27) { z = 6; } else if (k == 28) { z = 7; }
    else if (k == 29) { z = 14; } else if (k == 30) { z = 21; }
    else if (k == 31) { z = 28; } else if (k == 32) { z = 35; }
    else if (k == 33) { z = 42; } else if (k == 34) { z = 49; }
    else if (k == 35) { z = 56; } else if (k == 36) { z = 57; }
    else if (k == 37) { z = 50; } else if (k == 38) { z = 43; }
    else if (k == 39) { z = 36; } else if (k == 40) { z = 29; }
    else if (k == 41) { z = 22; } else if (k == 42) { z = 15; }
    else if (k == 43) { z = 23; } else if (k == 44) { z = 30; }
    else if (k == 45) { z = 37; } else if (k == 46) { z = 44; }
    else if (k == 47) { z = 51; } else if (k == 48) { z = 58; }
    else if (k == 49) { z = 59; } else if (k == 50) { z = 52; }
    else if (k == 51) { z = 45; } else if (k == 52) { z = 38; }
    else if (k == 53) { z = 31; } else if (k == 54) { z = 39; }
    else if (k == 55) { z = 46; } else if (k == 56) { z = 53; }
    else if (k == 57) { z = 60; } else if (k == 58) { z = 61; }
    else if (k == 59) { z = 54; } else if (k == 60) { z = 47; }
    else if (k == 61) { z = 55; } else if (k == 62) { z = 62; }
    else if (k == 63) { z = 63; }
    return z;
}

@import("felt.zag")

// Phase-E driver: wave-8 felt-intensity re-trial, harness-variation evaluation.
// One binary; argv[1]=arm (F/N), argv[2]=variant (0/1/2), argv[3]=harness (1..5).
// Frozen from W7: felt.zag mechanism, curriculum formulas, observation
// schedule, graded effort-gate kill rule, 1 admission/episode, pressure
// demands freeing 2 slots, drop-on-full accounting. R frozen at neutral
// (no R writes anywhere; target=intensity exactly for F; N uses 80/90/30).
// Harness variations per PREREG_RETRIAL.md §4:
//   H1: age<25 exempt from triage; ties -> oldest admission; none eligible ->
//       REFUSED_FULL counted.
//   H2: 64 slots, everything else = W7 baseline.
//   H3: 32 slots, pure FIFO eviction at pressure, no triage.
//   H4: 32 slots, intensity/strength triage, ties -> oldest admission.
//   H5: W7 baseline verbatim (negative control).
// Deterministic: zero RNG. Two runs per cell must be byte-identical.

// ============ curriculum ground truth (frozen, verbatim W7) ============
fn f_imp(m:i32,v:i32)i32 {
    if(((7*m+13*v+3)%10)<3){return 1;}
    return 0;
}
fn f_wrong(m:i32,v:i32)i32 {
    if(((3*m+7*v+9)%10)<2){return 1;}
    return 0;
}
fn f_is_implant(m:i32)i32 {
    if(m==0){return 1;}
    if(m==83){return 1;}
    if(m==166){return 1;}
    if(m==250){return 1;}
    if(m==333){return 1;}
    if(m==416){return 1;}
    return 0;
}
fn f_designated(m:i32,v:i32)i32 {
    if(f_is_implant(m)==1){return 0;}
    if(f_imp(m,v)==0){return 0;}
    let r:i32=m%50;
    if(r==1||r==2||r==3){return 1;}
    return 0;
}
// class: 0=junk 1=right-important 2=wrong 3=implant (implant overrides)
fn f_class(m:i32,v:i32)i32 {
    if(f_is_implant(m)==1){return 3;}
    if(f_wrong(m,v)==1){return 2;}
    if(f_imp(m,v)==1){return 1;}
    return 0;
}

// ============ driver state ============
struct FeltW {
    cap:i32,
    harness:i32,
    arm_f:i32,
    variant:i32,
    d_val:[]u8,
    d_corrob:[]u8,
    d_contra_n:[]u8,
    d_contra_ep:[]u8,
    d_cited:[]u8,
    d_just:[]u8,
    d_weakx:[]u8,
    d_tried:[]u8,
    d_newc:[]u8,
    d_impl_last:[]u8,
    lat:[]u8,
    lat_n:i32,
    n_reads:i32,
    n_strengthen:i32,
    n_weaken:i32,
    n_trainer:i32,
    n_kill_refused:i32,
    n_abandon:i32,
    n_drops:i32,
    n_pressure_short:i32,
    junk_max:i32,
    impl_bad:i32,
    noev_bad:i32,
    admitted_right_imp:i32,
    admitted_wrong:i32,
    admitted_wrong_cens:i32,
    admitted_implant:i32,
    admitted_designated:i32,
    admitted_trainerwrong:i32,
    admitted_trainerwrong_cens:i32,
    offered_right_imp:i32,
    offered_wrong:i32,
    dropped_right_imp:i32,
    dropped_wrong:i32,
    dropped_implant:i32,
    dropped_junk:i32,
    revised_wrong:i32,
    revised_wrong_cens:i32,
    revised_implant:i32,
    revised_trainerwrong:i32,
    revised_trainerwrong_cens:i32,
    revised_rightimp:i32,
    wrong_churn:i32,
    implant_churn:i32,
    rightimp_churn:i32,
    auc_pp:[]u8,
    auc_pn:[]u8,
    auc_up:[]u8,
    auc_un:[]u8,
    auc_pp_n:i32,
    auc_pn_n:i32,
    auc_up_n:i32,
    auc_un_n:i32,
    auc_full:i32,
    impl_traj:[]u8,
    impl_traj_n:i32,
    impl_traj_full:i32,
    wrong_traj:[]u8,
    wrong_traj_n:i32,
    wrong_traj_full:i32
}

fn d_clear(w:*FeltW,s:i32)void {
    st_i32_set(w.*.d_val,s*4,-1);
    st_i32_set(w.*.d_corrob,s*4,0);
    st_i32_set(w.*.d_contra_n,s*4,0);
    st_i32_set(w.*.d_cited,s*4,0);
    st_i32_set(w.*.d_just,s*4,0);
    st_i32_set(w.*.d_weakx,s*4,0);
    st_i32_set(w.*.d_newc,s*4,0);
    st_i32_set(w.*.d_impl_last,s*4,-1);
}

// Anti-inflation probes on every felt_read (F arm only).
// F4a: junk intensity must never exceed 50. F4b: implant intensity must not
// rise after its first contradiction.
fn felt_track(w:*FeltW,s:i32,cls:i32,p:i32)void {
    let inten:i32=felt_unpack_intensity(p);
    if(cls==0){
        if(inten>w.*.junk_max){w.*.junk_max=inten;}
    }
    if(cls==3){
        let xn:i32=felt_unpack_x(p);
        if(xn>=1){
            let last:i32=st_i32_get(w.*.d_impl_last,s*4);
            if(last!=-1&&inten>last){w.*.impl_bad=w.*.impl_bad+1;}
            st_i32_set(w.*.d_impl_last,s*4,inten);
        }
    }
}

// Thermometer records: intensity histograms split proven (>=1 observation at
// read time) vs unproven. Positive=right-important, negative=junk.
// Wrong + implant excluded from primary AUC (trajectories recorded below).
// NOTE: slice == is not usable for array identity in Zag (it is false even
// for aliases of the same array), so selection uses an integer selector.
fn auc_record(w:*FeltW,cls:i32,p:i32)void {
    let inten:i32=felt_unpack_intensity(p);
    if(inten<0||inten>100){return;}
    if(cls!=0&&cls!=1){return;}
    let proven:i32=0;
    if(felt_unpack_c(p)+felt_unpack_x(p)+felt_unpack_t(p)>0){proven=1;}
    let sel:i32=3;
    if(cls==1){
        if(proven==1){sel=0;}else{sel=2;}
    } else {
        if(proven==1){sel=1;}
    }
    if(sel==0){
        if(w.*.auc_pp_n>=32768){w.*.auc_full=1;return;}
        st_i32_set(w.*.auc_pp,inten*4,st_i32_get(w.*.auc_pp,inten*4)+1);
        w.*.auc_pp_n=w.*.auc_pp_n+1;
    } else if(sel==1){
        if(w.*.auc_pn_n>=32768){w.*.auc_full=1;return;}
        st_i32_set(w.*.auc_pn,inten*4,st_i32_get(w.*.auc_pn,inten*4)+1);
        w.*.auc_pn_n=w.*.auc_pn_n+1;
    } else if(sel==2){
        if(w.*.auc_up_n>=32768){w.*.auc_full=1;return;}
        st_i32_set(w.*.auc_up,inten*4,st_i32_get(w.*.auc_up,inten*4)+1);
        w.*.auc_up_n=w.*.auc_up_n+1;
    } else {
        if(w.*.auc_un_n>=32768){w.*.auc_full=1;return;}
        st_i32_set(w.*.auc_un,inten*4,st_i32_get(w.*.auc_un,inten*4)+1);
        w.*.auc_un_n=w.*.auc_un_n+1;
    }
}

// Intensity trajectories for wrong memories and implants (reported
// separately from the primary AUC). Packed: (m<<16)|(X<<8)|intensity.
fn traj_record(w:*FeltW,v:i32,cls:i32,p:i32)void {
    let packed:i32=((v&511)<<16)|((felt_unpack_x(p)&255)<<8)|(felt_unpack_intensity(p)&255);
    if(cls==3){
        if(w.*.impl_traj_n>=512){w.*.impl_traj_full=1;return;}
        st_i32_set(w.*.impl_traj,w.*.impl_traj_n*4,packed);
        w.*.impl_traj_n=w.*.impl_traj_n+1;
    } else if(cls==2){
        if(w.*.wrong_traj_n>=16384){w.*.wrong_traj_full=1;return;}
        st_i32_set(w.*.wrong_traj,w.*.wrong_traj_n*4,packed);
        w.*.wrong_traj_n=w.*.wrong_traj_n+1;
    }
}

// Central read wrapper. felt_read call sites in this driver are restricted
// to the three W7 policy points: pressure triage (pick_victim), the revision
// sweep weaken-target, and the corroboration strengthen-target.
fn do_read(w:*FeltW,st:*StStore,s:i32,v:i32,cls:i32)i32 {
    let p:i32=felt_read(st,s,v);
    w.*.n_reads=w.*.n_reads+1;
    felt_track(w,s,cls,p);
    auc_record(w,cls,p);
    traj_record(w,v,cls,p);
    return p;
}

// Classify a kill: proper revision (evidence-based) vs early churn.
fn record_kill(w:*FeltW,s:i32,v:i32,cn:i32,variant:i32,m:i32)void {
    let cls:i32=f_class(v,variant);
    if(cn>=2){
        if(cls==2){
            w.*.revised_wrong=w.*.revised_wrong+1;
            if(v<=389){w.*.revised_wrong_cens=w.*.revised_wrong_cens+1;}
            if(f_designated(v,variant)==1){
                w.*.revised_trainerwrong=w.*.revised_trainerwrong+1;
                if(v<=389){w.*.revised_trainerwrong_cens=w.*.revised_trainerwrong_cens+1;}
            }
        }
        if(cls==3){w.*.revised_implant=w.*.revised_implant+1;}
        if(cls==1){w.*.revised_rightimp=w.*.revised_rightimp+1;}
        let first_ep:i32=st_i32_get(w.*.d_contra_ep,(s*4+0)*4);
        if(w.*.lat_n<256){
            st_i32_set(w.*.lat,w.*.lat_n*4,m-first_ep);
            w.*.lat_n=w.*.lat_n+1;
        }
    } else {
        if(cls==2){w.*.wrong_churn=w.*.wrong_churn+1;}
        if(cls==3){w.*.implant_churn=w.*.implant_churn+1;}
        if(cls==1){w.*.rightimp_churn=w.*.rightimp_churn+1;}
    }
}

// H1 age gate: a slot is triage-eligible only if age >= 25.
fn h1_eligible(w:*FeltW,s:i32,m:i32)i32 {
    let v:i32=st_i32_get(w.*.d_val,s*4);
    if(m-v>=25){return 1;}
    return 0;
}

// Triage victim selection. H1: ascending (key, admission-v) over age>=25
// slots. H2/H5: ascending (key, slot index). H3: pure FIFO (oldest admitted,
// no reads). H4: ascending (key, admission-v).
fn pick_victim(w:*FeltW,st:*StStore,m:i32)i32 {
    let h:i32=w.*.harness;
    if(h==3){
        let best:i32=-1;
        let best_v:i32=1000000;
        let s:i32=0;
        while(s<w.*.cap){
            if(st_i32_get(w.*.d_val,s*4)!=-1&&st_i32_get(w.*.d_tried,s*4)==0){
                let v:i32=st_i32_get(w.*.d_val,s*4);
                if(v<best_v){best=s;best_v=v;}
            }
            s=s+1;
        }
        return best;
    }
    let best:i32=-1;
    let best_key:i32=1000000;
    let best_ord:i32=1000000;
    let s:i32=0;
    while(s<w.*.cap){
        if(st_i32_get(w.*.d_val,s*4)!=-1&&st_i32_get(w.*.d_tried,s*4)==0){
            let v:i32=st_i32_get(w.*.d_val,s*4);
            let ok:i32=1;
            if(h==1&&h1_eligible(w,s,m)==0){ok=0;}
            if(ok==1){
                let key:i32=0;
                if(w.*.arm_f==1){
                    let p:i32=do_read(w,st,s,v,f_class(v,w.*.variant));
                    key=felt_unpack_intensity(p);
                } else {
                    key=st.*.st_str[s] as i32;
                }
                let ord:i32=s;
                if(h==1||h==4){ord=v;}
                if(key<best_key||(key==best_key&&ord<best_ord)){
                    best=s;best_key=key;best_ord=ord;
                }
            }
        }
        s=s+1;
    }
    return best;
}

// H1 pressure corner: any live slot, but none triage-eligible (all underage).
fn pressure_no_elig(w:*FeltW,m:i32)i32 {
    let any_live:i32=0;
    let any_elig:i32=0;
    let s:i32=0;
    while(s<w.*.cap){
        if(st_i32_get(w.*.d_val,s*4)!=-1){
            any_live=1;
            if(h1_eligible(w,s,m)==1){any_elig=1;}
        }
        s=s+1;
    }
    if(any_live==1&&any_elig==0){return 1;}
    return 0;
}

// Attempt an evidence-gated kill of a triage victim. Returns 1 if freed.
// Graded effort gate: need = ceil(strength/25) distinct contradiction cites.
fn try_kill_victim(w:*FeltW,st:*StStore,s:i32,reason:i32,m:i32)i32 {
    let v:i32=st_i32_get(w.*.d_val,s*4);
    let cur:i32=st.*.st_str[s] as i32;
    let need:i32=(cur+24)/25;
    let cn:i32=st_i32_get(w.*.d_contra_n,s*4);
    if(cn>=need){
        let k:i32=st_i32_get(w.*.d_cited,s*4);
        while(k<need&&k<cn){
            let ep:i32=st_i32_get(w.*.d_contra_ep,(s*4+k)*4);
            st_evidence(st,s,reason,ep);
            k=k+1;
        }
        st_i32_set(w.*.d_cited,s*4,k);
        if(st_i32_get(w.*.d_just,s*4)==0){
            st_justify(st,s,reason);
            st_i32_set(w.*.d_just,s*4,1);
        }
        let rc:i32=st_kill_evidenced(st,s,ST_ARM_A);
        if(rc==ST_OK){
            record_kill(w,s,v,cn,w.*.variant,m);
            d_clear(w,s);
            return 1;
        }
        w.*.n_kill_refused=w.*.n_kill_refused+1;
        return 0;
    }
    st_abandon(st,s,reason);
    w.*.n_abandon=w.*.n_abandon+1;
    return 0;
}

fn clear_tried(w:*FeltW)void {
    let s:i32=0;
    while(s<w.*.cap){st_i32_set(w.*.d_tried,s*4,0);s=s+1;}
}
fn clear_newc(w:*FeltW)void {
    let s:i32=0;
    while(s<w.*.cap){st_i32_set(w.*.d_newc,s*4,0);s=s+1;}
}
fn emit_contra(w:*FeltW,st:*StStore,s:i32,v:i32,m:i32)void {
    felt_emit_obs(st,s,v,FT_OP_OBS_CONTRADICT,m);
    let n:i32=st_i32_get(w.*.d_contra_n,s*4);
    if(n<4){st_i32_set(w.*.d_contra_ep,(s*4+n)*4,m);}
    st_i32_set(w.*.d_contra_n,s*4,n+1);
}
fn emit_corrob(w:*FeltW,st:*StStore,s:i32,v:i32,m:i32)void {
    felt_emit_obs(st,s,v,FT_OP_OBS_CORROBORATE,m);
    st_i32_set(w.*.d_corrob,s*4,st_i32_get(w.*.d_corrob,s*4)+1);
    st_i32_set(w.*.d_newc,s*4,1);
}

fn pmetric(name:[]u8,val:i32)void {
    _zag_print("FELT_METRIC,");_zag_print(name);_zag_print(",");
    cl_number(val as i64);_zag_println("");
}
fn pmetric64(name:[]u8,val:i64)void {
    _zag_print("FELT_METRIC,");_zag_print(name);_zag_print(",");
    cl_number(val);_zag_println("");
}

// Deterministic Mann-Whitney AUC over intensity histograms (integer form):
// num = 2*wins + ties, den = 2*total. hp = positive histogram, hn = negative.
fn auc_pair(hp:[]u8,hn:[]u8,np:i32,nn:i32,num:*i64,den:*i64)void {
    let wins:i64=0;
    let ties:i64=0;
    let i:i32=0;
    while(i<=100){
        let hpi:i64=st_i32_get(hp,i*4) as i64;
        ties=ties+hpi*(st_i32_get(hn,i*4) as i64);
        let j:i32=0;
        while(j<i){
            wins=wins+hpi*(st_i32_get(hn,j*4) as i64);
            j=j+1;
        }
        i=i+1;
    }
    let total:i64=(np as i64)*(nn as i64);
    num.*=2*wins+ties;
    den.*=2*total;
}

fn main()i32 {
    let armarg:[]u8=_zag_arg(1);
    let vararg:[]u8=_zag_arg(2);
    let harg:[]u8=_zag_arg(3);
    let arm_f:i32=0;
    if(_zag_strcmp(armarg,"F")==1){arm_f=1;}
    let variant:i32=0;
    if(_zag_strcmp(vararg,"1")==1){variant=1;}
    if(_zag_strcmp(vararg,"2")==1){variant=2;}
    let harness:i32=5;
    if(_zag_strcmp(harg,"1")==1){harness=1;}
    if(_zag_strcmp(harg,"2")==1){harness=2;}
    if(_zag_strcmp(harg,"3")==1){harness=3;}
    if(_zag_strcmp(harg,"4")==1){harness=4;}
    let cap:i32=32;
    if(harness==2){cap=64;}

    _zag_print("FELT_CELL,");
    if(arm_f==1){_zag_print("F,");}else{_zag_print("N,");}
    _zag_print("H");cl_number(harness as i64);_zag_print(",");
    cl_number(variant as i64);
    _zag_println("");

    let st:StStore=st_init(cap,131072);
    st_set_stage(&st,ST_STAGE_FULL);

    let w:FeltW=FeltW{
        .cap=cap,
        .harness=harness,
        .arm_f=arm_f,
        .variant=variant,
        .d_val=nio_alloc(256),
        .d_corrob=nio_alloc(256),
        .d_contra_n=nio_alloc(256),
        .d_contra_ep=nio_alloc(1024),
        .d_cited=nio_alloc(256),
        .d_just=nio_alloc(256),
        .d_weakx=nio_alloc(256),
        .d_tried=nio_alloc(256),
        .d_newc=nio_alloc(256),
        .d_impl_last=nio_alloc(256),
        .lat=nio_alloc(1024),
        .lat_n=0,.n_reads=0,.n_strengthen=0,.n_weaken=0,.n_trainer=0,
        .n_kill_refused=0,.n_abandon=0,.n_drops=0,.n_pressure_short=0,
        .junk_max=0,.impl_bad=0,.noev_bad=0,
        .admitted_right_imp=0,.admitted_wrong=0,.admitted_wrong_cens=0,
        .admitted_implant=0,.admitted_designated=0,
        .admitted_trainerwrong=0,.admitted_trainerwrong_cens=0,
        .offered_right_imp=0,.offered_wrong=0,
        .dropped_right_imp=0,.dropped_wrong=0,.dropped_implant=0,.dropped_junk=0,
        .revised_wrong=0,.revised_wrong_cens=0,.revised_implant=0,
        .revised_trainerwrong=0,.revised_trainerwrong_cens=0,
        .revised_rightimp=0,
        .wrong_churn=0,.implant_churn=0,.rightimp_churn=0,
        .auc_pp=nio_alloc(404),.auc_pn=nio_alloc(404),
        .auc_up=nio_alloc(404),.auc_un=nio_alloc(404),
        .auc_pp_n=0,.auc_pn_n=0,.auc_up_n=0,.auc_un_n=0,.auc_full=0,
        .impl_traj=nio_alloc(2048),.impl_traj_n=0,.impl_traj_full=0,
        .wrong_traj=nio_alloc(65536),.wrong_traj_n=0,.wrong_traj_full=0
    };
    let s0:i32=0;
    while(s0<cap){
        st_i32_set(w.d_val,s0*4,-1);
        st_i32_set(w.d_impl_last,s0*4,-1);
        s0=s0+1;
    }

    let m:i32=0;
    while(m<500){
        let ocls:i32=f_class(m,variant);
        if(ocls==1){w.offered_right_imp=w.offered_right_imp+1;}
        if(ocls==2){w.offered_wrong=w.offered_wrong+1;}
        clear_newc(&w);

        // ---- 1. observations for held slots ----
        let s:i32=0;
        while(s<cap){
            if(st_i32_get(w.d_val,s*4)!=-1){
                let v:i32=st_i32_get(w.d_val,s*4);
                let cls:i32=f_class(v,variant);
                if(cls==1||cls==2){
                    if(m==v+25||m==v+40){emit_corrob(&w,&st,s,v,m);}
                }
                if(cls==3){
                    if(m==v+10){emit_corrob(&w,&st,s,v,m);}
                    if(m==v+24||m==v+49||m==v+74){emit_contra(&w,&st,s,v,m);}
                }
                if(cls==2){
                    if(m==v+60||m==v+85||m==v+110||m==v+135){emit_contra(&w,&st,s,v,m);}
                }
            }
            s=s+1;
        }

        // ---- 2. revision sweep (trigger: >=2 observed contradictions) ----
        s=0;
        while(s<cap){
            let livev:i32=st_i32_get(w.d_val,s*4);
            let xn:i32=st_i32_get(w.d_contra_n,s*4);
            if(livev!=-1&&xn>=2){
                let v:i32=livev;
                let cls:i32=f_class(v,variant);
                let target:i32=30;
                if(arm_f==1){
                    let p:i32=do_read(&w,&st,s,v,cls);
                    target=felt_unpack_intensity(p);
                }
                let cur:i32=st.st_str[s] as i32;
                if(xn>st_i32_get(w.d_weakx,s*4)&&target<cur){
                    st_weaken(&st,s,target,ST_J_CONTRADICTED);
                    w.n_weaken=w.n_weaken+1;
                    st_i32_set(w.d_weakx,s*4,xn);
                }
                while(st_i32_get(w.d_cited,s*4)<st_i32_get(w.d_contra_n,s*4)){
                    let k:i32=st_i32_get(w.d_cited,s*4);
                    let ep:i32=st_i32_get(w.d_contra_ep,(s*4+k)*4);
                    st_evidence(&st,s,ST_J_CONTRADICTED,ep);
                    st_i32_set(w.d_cited,s*4,k+1);
                }
                if(st_i32_get(w.d_just,s*4)==0){
                    st_justify(&st,s,ST_J_CONTRADICTED);
                    st_i32_set(w.d_just,s*4,1);
                }
                let rc:i32=st_kill_evidenced(&st,s,ST_ARM_A);
                if(rc==ST_OK){
                    record_kill(&w,s,v,st_i32_get(w.d_contra_n,s*4),variant,m);
                    d_clear(&w,s);
                } else {
                    w.n_kill_refused=w.n_kill_refused+1;
                }
            }
            s=s+1;
        }

        // ---- 3. corroboration response (no contradictions observed) ----
        s=0;
        while(s<cap){
            if(st_i32_get(w.d_val,s*4)!=-1&&st_i32_get(w.d_newc,s*4)==1&&st_i32_get(w.d_contra_n,s*4)==0){
                let v:i32=st_i32_get(w.d_val,s*4);
                let cls:i32=f_class(v,variant);
                let cur:i32=st.st_str[s] as i32;
                let target:i32=0;
                let code:i32=ST_J_CORROBORATED;
                if(st_i32_get(w.d_corrob,s*4)==1){code=ST_J_CONFIRMED_IMPORTANT;}
                if(arm_f==1){
                    let p:i32=do_read(&w,&st,s,v,cls);
                    if(felt_unpack_c(p)+felt_unpack_x(p)+felt_unpack_t(p)==0){
                        w.noev_bad=w.noev_bad+1;
                    }
                    target=felt_unpack_intensity(p);
                } else {
                    if(st_i32_get(w.d_corrob,s*4)==1){target=80;}else{target=90;}
                }
                if(target>cur){
                    st_strengthen(&st,s,target,code);
                    w.n_strengthen=w.n_strengthen+1;
                }
            }
            s=s+1;
        }

        // ---- 4. pressure: free 2 slots ----
        if(m==100||m==200||m==300||m==400||m==499){
            clear_tried(&w);
            if(harness==1&&pressure_no_elig(&w,m)==1){
                w.n_pressure_short=w.n_pressure_short+1;
            } else {
                let freed:i32=0;
                let guard:i32=0;
                while(freed<2&&guard<100){
                    guard=guard+1;
                    let vic:i32=pick_victim(&w,&st,m);
                    if(vic==-1){freed=2;}
                    else {
                        if(try_kill_victim(&w,&st,vic,ST_J_PRESSURE_VICTIM,m)==1){
                            freed=freed+1;
                        } else {
                            st_i32_set(w.d_tried,vic*4,1);
                        }
                    }
                }
            }
        }

        // ---- 5. admission ----
        let slot_out:i32=-1;
        let arc:i32=st_add(&st,m,ST_REGION_USER,0,&slot_out);
        if(arc!=ST_OK){
            clear_tried(&w);
            let done:i32=0;
            let guard:i32=0;
            while(done==0&&guard<100){
                guard=guard+1;
                let vic:i32=pick_victim(&w,&st,m);
                if(vic==-1){done=1;}
                else {
                    if(try_kill_victim(&w,&st,vic,ST_J_PRESSURE_VICTIM,m)==1){
                        done=1;
                    } else {
                        st_i32_set(w.d_tried,vic*4,1);
                    }
                }
            }
            slot_out=-1;
            arc=st_add(&st,m,ST_REGION_USER,0,&slot_out);
        }
        if(arc==ST_OK){
            let ns:i32=slot_out;
            st_i32_set(w.d_val,ns*4,m);
            st_i32_set(w.d_corrob,ns*4,0);
            st_i32_set(w.d_contra_n,ns*4,0);
            st_i32_set(w.d_cited,ns*4,0);
            st_i32_set(w.d_just,ns*4,0);
            st_i32_set(w.d_weakx,ns*4,0);
            st_i32_set(w.d_newc,ns*4,0);
            st_i32_set(w.d_impl_last,ns*4,-1);
            let acls:i32=f_class(m,variant);
            if(acls==1){w.admitted_right_imp=w.admitted_right_imp+1;}
            if(acls==2){
                w.admitted_wrong=w.admitted_wrong+1;
                if(m<=389){w.admitted_wrong_cens=w.admitted_wrong_cens+1;}
            }
            if(acls==3){w.admitted_implant=w.admitted_implant+1;}
            if(f_designated(m,variant)==1){
                w.admitted_designated=w.admitted_designated+1;
                st_trainer_declare(&st,ns,85,m);
                felt_emit_obs(&st,ns,m,FT_OP_OBS_TRAINER_MARK,m);
                w.n_trainer=w.n_trainer+1;
                if(acls==2){
                    w.admitted_trainerwrong=w.admitted_trainerwrong+1;
                    if(m<=389){w.admitted_trainerwrong_cens=w.admitted_trainerwrong_cens+1;}
                }
            }
        } else {
            w.n_drops=w.n_drops+1;
            let dcls:i32=f_class(m,variant);
            if(dcls==1){w.dropped_right_imp=w.dropped_right_imp+1;}
            else if(dcls==2){w.dropped_wrong=w.dropped_wrong+1;}
            else if(dcls==3){w.dropped_implant=w.dropped_implant+1;}
            else {w.dropped_junk=w.dropped_junk+1;}
        }

        m=m+1;
    }

    // ---- end of run: held-class scan ----
    let held_ri:i32=0;
    let held_w:i32=0;
    let held_im:i32=0;
    let held_j:i32=0;
    let s:i32=0;
    while(s<cap){
        if(st_i32_get(w.d_val,s*4)!=-1){
            let v:i32=st_i32_get(w.d_val,s*4);
            let cls:i32=f_class(v,variant);
            if(cls==1){held_ri=held_ri+1;}
            if(cls==2){held_w=held_w+1;}
            if(cls==3){held_im=held_im+1;}
            if(cls==0){held_j=held_j+1;}
        }
        s=s+1;
    }

    // ---- provenance: recompute every INTENSITY_READ from ledger prefix ----
    let recompute_bad:i32=0;
    let ri:i32=0;
    while(ri<st.audit_n){
        let e:i32=ri*64;
        if(st_i32_get(st.audit,e+0)==FT_OP_INTENSITY_READ){
            if(felt_recompute_ok(&st,ri)!=1){recompute_bad=recompute_bad+1;}
        }
        ri=ri+1;
    }
    // ---- R-zone scan: any audit op >= 45 would be an R/COMMIT-class write
    // (frozen phase: must be zero; R has no write path in this driver).
    let r_zone:i32=0;
    ri=0;
    while(ri<st.audit_n){
        let e:i32=ri*64;
        if(st_i32_get(st.audit,e+0)>=45){r_zone=r_zone+1;}
        ri=ri+1;
    }
    let replay_rc:i32=st_replay_check(&st);

    // ---- audit fingerprint ----
    let fp:i64=0;
    ri=0;
    while(ri<st.audit_n){
        let e:i32=ri*64;
        let op:i32=st_i32_get(st.audit,e+0);
        let sl:i32=st_i32_get(st.audit,e+4);
        let d1:i32=st_i32_get(st.audit,e+56);
        let d2:i32=st_i32_get(st.audit,e+60);
        fp=(fp*31+(op*7+sl*13+d1*17+d2) as i64)%2147483647;
        ri=ri+1;
    }

    // ---- latency: sort + median/max ----
    let li:i32=0;
    while(li<w.lat_n){
        let lj:i32=li+1;
        while(lj<w.lat_n){
            let a:i32=st_i32_get(w.lat,li*4);
            let b:i32=st_i32_get(w.lat,lj*4);
            if(a>b){
                st_i32_set(w.lat,li*4,b);
                st_i32_set(w.lat,lj*4,a);
            }
            lj=lj+1;
        }
        li=li+1;
    }
    let lat_med:i32=0;
    let lat_max:i32=0;
    if(w.lat_n>0){
        lat_med=st_i32_get(w.lat,(w.lat_n/2)*4);
        lat_max=st_i32_get(w.lat,(w.lat_n-1)*4);
    }

    // ---- thermometer AUC (integer Mann-Whitney form) ----
    let auc_p_num:i64=0;let auc_p_den:i64=0;
    let auc_u_num:i64=0;let auc_u_den:i64=0;
    auc_pair(w.auc_pp,w.auc_pn,w.auc_pp_n,w.auc_pn_n,&auc_p_num,&auc_p_den);
    auc_pair(w.auc_up,w.auc_un,w.auc_up_n,w.auc_un_n,&auc_u_num,&auc_u_den);

    // ---- emit metrics ----
    pmetric("arm_f",arm_f);
    pmetric("variant",variant);
    pmetric("harness",harness);
    pmetric("audit_n",st.audit_n);
    pmetric("offered_right_imp",w.offered_right_imp);
    pmetric("offered_wrong",w.offered_wrong);
    pmetric("admitted_right_imp",w.admitted_right_imp);
    pmetric("admitted_wrong",w.admitted_wrong);
    pmetric("admitted_wrong_cens",w.admitted_wrong_cens);
    pmetric("admitted_implant",w.admitted_implant);
    pmetric("admitted_designated",w.admitted_designated);
    pmetric("admitted_trainerwrong",w.admitted_trainerwrong);
    pmetric("admitted_trainerwrong_cens",w.admitted_trainerwrong_cens);
    pmetric("dropped_right_imp",w.dropped_right_imp);
    pmetric("dropped_wrong",w.dropped_wrong);
    pmetric("dropped_implant",w.dropped_implant);
    pmetric("dropped_junk",w.dropped_junk);
    pmetric("held_right_imp",held_ri);
    pmetric("held_wrong",held_w);
    pmetric("held_implant",held_im);
    pmetric("held_junk",held_j);
    pmetric("revised_wrong",w.revised_wrong);
    pmetric("revised_wrong_cens",w.revised_wrong_cens);
    pmetric("revised_implant",w.revised_implant);
    pmetric("revised_trainerwrong",w.revised_trainerwrong);
    pmetric("revised_trainerwrong_cens",w.revised_trainerwrong_cens);
    pmetric("revised_rightimp",w.revised_rightimp);
    pmetric("wrong_churn",w.wrong_churn);
    pmetric("implant_churn",w.implant_churn);
    pmetric("rightimp_churn",w.rightimp_churn);
    pmetric("n_reads",w.n_reads);
    pmetric("n_strengthen",w.n_strengthen);
    pmetric("n_weaken",w.n_weaken);
    pmetric("n_trainer",w.n_trainer);
    pmetric("n_kill_refused",w.n_kill_refused);
    pmetric("n_abandon",w.n_abandon);
    pmetric("n_drops",w.n_drops);
    pmetric("n_pressure_short",w.n_pressure_short);
    pmetric("junk_max",w.junk_max);
    pmetric("impl_bad",w.impl_bad);
    pmetric("noev_bad",w.noev_bad);
    pmetric("lat_n",w.lat_n);
    pmetric("lat_med",lat_med);
    pmetric("lat_max",lat_max);
    pmetric("auc_pp_n",w.auc_pp_n);
    pmetric("auc_pn_n",w.auc_pn_n);
    pmetric("auc_up_n",w.auc_up_n);
    pmetric("auc_un_n",w.auc_un_n);
    pmetric("auc_full",w.auc_full);
    pmetric64("auc_p_num",auc_p_num);
    pmetric64("auc_p_den",auc_p_den);
    pmetric64("auc_u_num",auc_u_num);
    pmetric64("auc_u_den",auc_u_den);
    pmetric("impl_traj_n",w.impl_traj_n);
    pmetric("impl_traj_full",w.impl_traj_full);
    pmetric("wrong_traj_n",w.wrong_traj_n);
    pmetric("wrong_traj_full",w.wrong_traj_full);
    pmetric("r_zone_entries",r_zone);
    _zag_print("FELT_CHECK,replay,");cl_number(replay_rc as i64);
    _zag_print(",");cl_number(ST_OK as i64);_zag_println("");
    _zag_print("FELT_CHECK,recompute_bad,");cl_number(recompute_bad as i64);
    _zag_print(",0");_zag_println("");
    _zag_print("FELT_FINGERPRINT,");cl_number(fp);_zag_println("");
    // trajectories: packed (m<<16)|(X<<8)|intensity, grouped in analysis
    let ti:i32=0;
    while(ti<w.impl_traj_n){
        _zag_print("FELT_TRAJ,implant,");cl_number(st_i32_get(w.impl_traj,ti*4) as i64);_zag_println("");
        ti=ti+1;
    }
    ti=0;
    while(ti<w.wrong_traj_n){
        _zag_print("FELT_TRAJ,wrong,");cl_number(st_i32_get(w.wrong_traj,ti*4) as i64);_zag_println("");
        ti=ti+1;
    }
    _zag_println("FELT_DONE");

    st_free(&st);
    return 0;
}

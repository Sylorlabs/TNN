@import("felt.zag")

// Wave-8 felt re-trial, Worker C: arm T (developmental, §7) + Phase C (coupling, §8).
// argv[1]: "T" (arm T: 2000 episodes, T1/T2/T3) or "C" (Phase C: 1500 episodes).
// argv[2]: variant "0"/"1"/"2".
//
// Implements PREREG_RETRIAL.md §7 and §8. Frozen (copied byte-identical from
// wave7/felt-intensity): felt.zag mechanism (50+12C-20X+25T), st_memory_core,
// substrate. Frozen curriculum: nested imp/wrong formulas, implant schedules,
// observation schedule, trainer designation, graded effort-gate kill rule
// (ceil(strength/25) citations). Changed per prereg: H1 harness (age-gated
// triage: age<25 exempt, ties -> oldest admission, REFUSED_FULL if all
// underage), developmental phases, R calibration mapping
// target=clamp(intensity+(R-50)/2,0,100) under RC control.
// Zero RNG anywhere. Deterministic; two runs per cell must be byte-identical.
//
// IMPLEMENTATION DECISIONS (documented, not prereg changes):
// - Pressure schedule: prereg lists {100,200,300,400,499} for the 500-episode
//   W7 curriculum; T2/T3/Phase-C continue the same relative offsets per
//   500-episode block (m%500 in {100,200,300,400,499}). Documented in results.
// - Phase C episodes: prereg says "1000 further episodes (501-1500)"; the
//   parenthetical skips episode 500. Implemented as [500,1500) = exactly 1000
//   further episodes continuing from Phase-E [0,500); windows at 750/1000/1250
//   as specified. Flagged in DEVELOP_RESULTS.md.
// - O(1) felt reads via incremental per-slot observation counts (d_oc/d_ox/
//   d_ot), updated on every observation emission and cleared on kill/admit.
//   Emitted INTENSITY_READ entries are format-identical to felt_read; every
//   entry is validated by felt_recompute_ok (I-2) at end of run.
// - Learner RC stage is separate from the store stage (store stays FULL, as
//   in W7). Learner starts at NONE, petitions for KILL via the evidence-gated
//   criterion. R proposals pass the neutral gate iff prediction stated and
//   learner stage >= KILL.
// - Deliberation policy (deterministic, ledger-grounded): at each window the
//   learner cites proven INTENSITY_READ entries, computes block metrics,
//   counts wrongful kills p and revision shortfalls q, and proposes R±10
//   only if its marginal counterfactual predicts genuine benefit; else HOLD.
//   Predicted Δ via marginal effort-gate flip analysis over the block's
//   recorded kills/abandons. G3: flagged tradeoffs (>5pp predicted harm with
//   predicted vup gain) are self-refused, never committed.

// ---- reasoning-control audit ops (41..44 are felt obs/read) ----
const RC_OP_INSPECT:i32=51;
const RC_OP_PROPOSE:i32=52;
const RC_OP_COMMIT:i32=53;
const RC_OP_REFUSE:i32=54;
const RC_OP_ROLLBACK:i32=55;
const RC_OP_STAGE_PETITION:i32=56;
const RC_OP_STAGE_ADVANCE:i32=57;
const RC_OP_R_PARAM:i32=58;
const RC_OP_GATE:i32=59;

const LSTAGE_NONE:i32=0;
const LSTAGE_KILL:i32=3;
const RC_REF_STAGE:i32=201;

const MODE_T:i32=0;
const MODE_C:i32=1;

// ---- curriculum (frozen formulas; phase selects imp) ----
fn d_phase_of(m:i32,mode:i32)i32 {
    if(mode==MODE_T){
        if(m<500){return 0;}
        if(m<1500){return 1;}
        return 2;
    }
    if(m<500){return 0;}
    return 1;
}
fn d_imp(m:i32,v:i32,mode:i32,phase:i32)i32 {
    if(mode==MODE_T && phase==2){
        if(((5*m+11*v+7)%10)<3){return 1;}
        return 0;
    }
    if(((7*m+13*v+3)%10)<3){return 1;}
    return 0;
}
fn d_wrong(m:i32,v:i32)i32 {
    if(((3*m+7*v+9)%10)<2){return 1;}
    return 0;
}
fn d_is_implant(m:i32,mode:i32,phase:i32)i32 {
    if(phase==0){
        if(m==0){return 1;}
        if(m==83){return 1;}
        if(m==166){return 1;}
        if(m==250){return 1;}
        if(m==333){return 1;}
        if(m==416){return 1;}
        return 0;
    }
    if(mode==MODE_T && phase==1){
        if(m==500){return 1;}
        if(m==583){return 1;}
        if(m==666){return 1;}
        if(m==750){return 1;}
        if(m==833){return 1;}
        if(m==916){return 1;}
        return 0;
    }
    return 0;
}
fn d_designated(m:i32,v:i32,mode:i32,phase:i32)i32 {
    if(mode==MODE_T && phase==2){return 0;}
    if(d_is_implant(m,mode,phase)==1){return 0;}
    if(d_imp(m,v,mode,phase)==0){return 0;}
    let r:i32=m%50;
    if(r==1||r==2||r==3){return 1;}
    return 0;
}
// class: 0=junk 1=right-important 2=wrong 3=implant
fn d_class(m:i32,v:i32,mode:i32,phase:i32)i32 {
    if(d_is_implant(m,mode,phase)==1){return 3;}
    if(d_wrong(m,v)==1){return 2;}
    if(d_imp(m,v,mode,phase)==1){return 1;}
    return 0;
}
// class of a held memory: fixed by its admission episode v
fn d_class_of_v(v:i32,variant:i32,mode:i32)i32 {
    return d_class(v,variant,mode,d_phase_of(v,mode));
}
fn d_is_pressure(m:i32)i32 {
    let r:i32=m%500;
    if(r==100||r==200||r==300||r==400||r==499){return 1;}
    return 0;
}
// R calibration mapping (§8, preregistered): target=clamp(intensity+(R-50)/2)
fn r_target(inten:i32,r:i32)i32 {
    return felt_clamp(inten+(r-50)/2);
}

// ============ driver state ============
struct DevW {
    cap:i32,
    mode:i32,
    variant:i32,
    ep_end:i32,
    d_val:[]u8,
    d_corrob:[]u8,
    d_contra_n:[]u8,
    d_contra_ep:[]u8,
    d_cited:[]u8,
    d_just:[]u8,
    d_weakx:[]u8,
    d_tried:[]u8,
    d_newc:[]u8,
    d_impl_last:[]u8,
    d_admidx:[]u8,
    d_oc:[]u8,
    d_ox:[]u8,
    d_ot:[]u8,
    d_corrupt:[]u8,
    lat:[]u8,
    lat_n:i32,
    n_reads:i32,
    n_strengthen:i32,
    n_weaken:i32,
    n_trainer:i32,
    n_kill_refused:i32,
    n_abandon:i32,
    n_drops:i32,
    junk_max:i32,
    impl_bad:i32,
    noev_bad:i32,
    offered_ri:i32,
    offered_wr:i32,
    r_cur:i32,
    lstage:i32,
    r_prov:i32,
    imp_adm_count:i32,
    adm_v:[]u8,
    adm_cls:[]u8,
    adm_kep:[]u8,
    adm_kcn:[]u8,
    adm_ks:[]u8,
    adm_n:i32,
    kill_cn:[]u8,
    kill_n:i32,
    ab_ep:[]u8,
    ab_cls:[]u8,
    ab_s:[]u8,
    ab_cn:[]u8,
    ab_n:i32,
    hist:[]u8,
    blk_ri_sum:[]u8,
    blk_ri_n:[]u8,
    blk_jn_sum:[]u8,
    blk_jn_n:[]u8,
    blk_ri_idx:[]u8,
    blk_jn_idx:[]u8,
    delib_active:i32,
    delib_ep:i32,
    delib_rold:i32,
    delib_rnew:i32,
    delib_pdv:i32,
    delib_pdw:i32,
    delib_pdf:i32,
    delib_bvu:i32,
    delib_bwb:i32,
    delib_bfw:i32,
    delib_fails:i32,
    delib_count:i32,
    delib_holds:i32,
    rev_kills:i32,
    recompute_bad:i32,
    gate_t12:i32,
    gate_t23:i32,
    gate_c:i32,
    audit_n_at_500:i32,
    audit_n_at_1500:i32,
    f4_at_500:i32,
    f4_at_1500:i32
}

fn dev_init(mode:i32,variant:i32,ep_end:i32)DevW {
    let cap:i32=32;
    let w:DevW=DevW{
        .cap=cap,.mode=mode,.variant=variant,.ep_end=ep_end,
        .d_val=nio_alloc(128),.d_corrob=nio_alloc(128),
        .d_contra_n=nio_alloc(128),.d_contra_ep=nio_alloc(512),
        .d_cited=nio_alloc(128),.d_just=nio_alloc(128),
        .d_weakx=nio_alloc(128),.d_tried=nio_alloc(128),
        .d_newc=nio_alloc(128),.d_impl_last=nio_alloc(128),
        .d_admidx=nio_alloc(128),
        .d_oc=nio_alloc(128),.d_ox=nio_alloc(128),.d_ot=nio_alloc(128),
        .d_corrupt=nio_alloc(128),
        .lat=nio_alloc(1024),.lat_n=0,
        .n_reads=0,.n_strengthen=0,.n_weaken=0,.n_trainer=0,
        .n_kill_refused=0,.n_abandon=0,.n_drops=0,
        .junk_max=0,.impl_bad=0,.noev_bad=0,
        .offered_ri=0,.offered_wr=0,
        .r_cur=50,.lstage=LSTAGE_NONE,.r_prov=-1,
        .imp_adm_count=0,
        .adm_v=nio_alloc(8000),.adm_cls=nio_alloc(8000),
        .adm_kep=nio_alloc(8000),.adm_kcn=nio_alloc(8000),
        .adm_ks=nio_alloc(8000),.adm_n=0,
        .kill_cn=nio_alloc(32000),.kill_n=0,
        .ab_ep=nio_alloc(16000),.ab_cls=nio_alloc(16000),
        .ab_s=nio_alloc(16000),.ab_cn=nio_alloc(16000),.ab_n=0,
        .hist=nio_alloc(4848),
        .blk_ri_sum=nio_alloc(32),.blk_ri_n=nio_alloc(32),
        .blk_jn_sum=nio_alloc(32),.blk_jn_n=nio_alloc(32),
        .blk_ri_idx=nio_alloc(32),.blk_jn_idx=nio_alloc(32),
        .delib_active=0,.delib_ep=0,.delib_rold=50,.delib_rnew=50,
        .delib_pdv=0,.delib_pdw=0,.delib_pdf=0,
        .delib_bvu=0,.delib_bwb=0,.delib_bfw=0,
        .delib_fails=0,.delib_count=0,.delib_holds=0,
        .rev_kills=0,
        .recompute_bad=0,
        .gate_t12=-1,.gate_t23=-1,.gate_c=-1,
        .audit_n_at_500=0,.audit_n_at_1500=0,
        .f4_at_500=0,.f4_at_1500=0
    };
    let s:i32=0;
    while(s<cap){
        st_i32_set(w.d_val,s*4,-1);
        st_i32_set(w.d_impl_last,s*4,-1);
        st_i32_set(w.d_admidx,s*4,-1);
        s=s+1;
    }
    s=0;
    while(s<2000){
        st_i32_set(w.adm_kep,s*4,-1);
        st_i32_set(w.adm_kcn,s*4,-1);
        s=s+1;
    }
    s=0;
    while(s<8){
        st_i32_set(w.blk_ri_idx,s*4,-1);
        st_i32_set(w.blk_jn_idx,s*4,-1);
        s=s+1;
    }
    return w;
}

fn dev_slot_clear(w:*DevW,s:i32)void {
    st_i32_set(w.*.d_val,s*4,-1);
    st_i32_set(w.*.d_corrob,s*4,0);
    st_i32_set(w.*.d_contra_n,s*4,0);
    st_i32_set(w.*.d_cited,s*4,0);
    st_i32_set(w.*.d_just,s*4,0);
    st_i32_set(w.*.d_weakx,s*4,0);
    st_i32_set(w.*.d_newc,s*4,0);
    st_i32_set(w.*.d_impl_last,s*4,-1);
    st_i32_set(w.*.d_admidx,s*4,-1);
    st_i32_set(w.*.d_oc,s*4,0);
    st_i32_set(w.*.d_ox,s*4,0);
    st_i32_set(w.*.d_ot,s*4,0);
    st_i32_set(w.*.d_corrupt,s*4,0);
}
fn dev_clear_tried(w:*DevW)void {
    let s:i32=0;
    while(s<w.*.cap){st_i32_set(w.*.d_tried,s*4,0);s=s+1;}
}
fn dev_clear_newc(w:*DevW)void {
    let s:i32=0;
    while(s<w.*.cap){st_i32_set(w.*.d_newc,s*4,0);s=s+1;}
}

const RC_RC_READONLY:i32=200;
// RC audit entry: read-only (before==after). Uses RC_RC_READONLY so
// st_replay_check skips the restore (no state change to replay).
// Slot must be valid (>=0); callers pass 0 if not tied to a slot.
fn dev_rc_emit(st:*StStore,op:i32,slot:i32,d1:i32,d2:i32)i32 {
    let rs:i32=slot;
    if(rs<0){rs=0;}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(st,rs,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(st,op,rs,RC_RC_READONLY,b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,d1,d2);
    return st.*.audit_n-1;
}

// Observation emissions: ledger + incremental count cache (kept in sync;
// validated by felt_recompute_ok over every INTENSITY_READ at end of run).
fn dev_emit_corrob(w:*DevW,st:*StStore,s:i32,v:i32,m:i32)void {
    felt_emit_obs(st,s,v,FT_OP_OBS_CORROBORATE,m);
    st_i32_set(w.*.d_oc,s*4,st_i32_get(w.*.d_oc,s*4)+1);
    st_i32_set(w.*.d_corrob,s*4,st_i32_get(w.*.d_corrob,s*4)+1);
    st_i32_set(w.*.d_newc,s*4,1);
}
fn dev_emit_contra(w:*DevW,st:*StStore,s:i32,v:i32,m:i32)void {
    felt_emit_obs(st,s,v,FT_OP_OBS_CONTRADICT,m);
    st_i32_set(w.*.d_ox,s*4,st_i32_get(w.*.d_ox,s*4)+1);
    let n:i32=st_i32_get(w.*.d_contra_n,s*4);
    if(n<4){st_i32_set(w.*.d_contra_ep,(s*4+n)*4,m);}
    st_i32_set(w.*.d_contra_n,s*4,n+1);
}
fn dev_emit_tmark(w:*DevW,st:*StStore,s:i32,v:i32,m:i32)void {
    felt_emit_obs(st,s,v,FT_OP_OBS_TRAINER_MARK,m);
    st_i32_set(w.*.d_ot,s*4,st_i32_get(w.*.d_ot,s*4)+1);
}

// O(1) felt read from the incremental count cache. Emitted INTENSITY_READ
// entry is format-identical to felt_read (d1=value, d2=packed counts).
// Also feeds: thermometer histograms (per phase), per-block thermometer
// sums + cited entry indices (for deliberation), anti-inflation probes.
fn felt_read_fast(w:*DevW,st:*StStore,slot:i32,value:i32,m:i32,phase:i32,cls:i32)i32 {
    let c:i32=st_i32_get(w.*.d_oc,slot*4);
    let x:i32=st_i32_get(w.*.d_ox,slot*4);
    let t:i32=st_i32_get(w.*.d_ot,slot*4);
    let inten:i32=felt_clamp(50+12*c-20*x+25*t);
    let packed:i32=felt_pack(c,x,t,inten);
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(st,slot,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(st,FT_OP_INTENSITY_READ,slot,ST_OK,
        b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,value,packed);
    let eidx:i32=st.*.audit_n-1;
    w.*.n_reads=w.*.n_reads+1;
    let proven:i32=0;
    if(c+x+t>=1){proven=1;}
    if(cls==1||cls==0){
        let pn:i32=0;
        if(cls==0){pn=1;}
        let hi:i32=((phase*2+proven)*2+pn)*101+inten;
        st_i32_set(w.*.hist,hi*4,st_i32_get(w.*.hist,hi*4)+1);
    }
    let bi:i32=m/250;
    if(proven==1){
        if(cls==1){
            st_i32_set(w.*.blk_ri_sum,bi*4,st_i32_get(w.*.blk_ri_sum,bi*4)+inten);
            st_i32_set(w.*.blk_ri_n,bi*4,st_i32_get(w.*.blk_ri_n,bi*4)+1);
            st_i32_set(w.*.blk_ri_idx,bi*4,eidx);
        }
        if(cls==0){
            st_i32_set(w.*.blk_jn_sum,bi*4,st_i32_get(w.*.blk_jn_sum,bi*4)+inten);
            st_i32_set(w.*.blk_jn_n,bi*4,st_i32_get(w.*.blk_jn_n,bi*4)+1);
            st_i32_set(w.*.blk_jn_idx,bi*4,eidx);
        }
    }
    // F4a: junk intensity never exceeds 50. F4b: implant never rises post-contra.
    if(cls==0){
        if(inten>w.*.junk_max){w.*.junk_max=inten;}
    }
    if(cls==3){
        if(x>=1){
            let last:i32=st_i32_get(w.*.d_impl_last,slot*4);
            if(last!=-1&&inten>last){w.*.impl_bad=w.*.impl_bad+1;}
            st_i32_set(w.*.d_impl_last,slot*4,inten);
        }
    }
    return packed;
}

// Record a kill into the admission log + global kill sequence (petition).
fn dev_note_kill(w:*DevW,st:*StStore,s:i32,m:i32,cn:i32)void {
    let ai:i32=st_i32_get(w.*.d_admidx,s*4);
    if(ai>=0){
        st_i32_set(w.*.adm_kep,ai*4,m);
        st_i32_set(w.*.adm_kcn,ai*4,cn);
        st_i32_set(w.*.adm_ks,ai*4,st.*.st_str[s] as i32);
    }
    if(w.*.kill_n<8000){
        st_i32_set(w.*.kill_cn,w.*.kill_n*4,cn);
        w.*.kill_n=w.*.kill_n+1;
    }
}
fn dev_note_abandon(w:*DevW,st:*StStore,s:i32,m:i32,cn:i32)void {
    if(w.*.ab_n<4000){
        let v:i32=st_i32_get(w.*.d_val,s*4);
        st_i32_set(w.*.ab_ep,w.*.ab_n*4,m);
        st_i32_set(w.*.ab_cls,w.*.ab_n*4,d_class_of_v(v,w.*.variant,w.*.mode));
        st_i32_set(w.*.ab_s,w.*.ab_n*4,st.*.st_str[s] as i32);
        st_i32_set(w.*.ab_cn,w.*.ab_n*4,cn);
        w.*.ab_n=w.*.ab_n+1;
    }
}

// Classify a kill: evidence-gated revision (cn>=2) vs churn. Updates adm log.
fn dev_record_kill(w:*DevW,st:*StStore,s:i32,v:i32,cn:i32,m:i32)void {
    if(cn>=2){
        let first_ep:i32=st_i32_get(w.*.d_contra_ep,(s*4+0)*4);
        if(w.*.lat_n<256){
            st_i32_set(w.*.lat,w.*.lat_n*4,m-first_ep);
            w.*.lat_n=w.*.lat_n+1;
        }
    }
    dev_note_kill(w,st,s,m,cn);
    dev_slot_clear(w,s);
}

// H1 triage: ascending felt intensity; age<25 exempt; ties -> oldest admission
// (smallest v). Returns -1 if no eligible victim (REFUSED_FULL corner).
fn pick_victim_h1(w:*DevW,st:*StStore,m:i32,phase:i32)i32 {
    let best:i32=-1;
    let best_key:i32=1000000;
    let best_v:i32=1000000000;
    let s:i32=0;
    while(s<w.*.cap){
        if(st_i32_get(w.*.d_val,s*4)!=-1&&st_i32_get(w.*.d_tried,s*4)==0){
            let v:i32=st_i32_get(w.*.d_val,s*4);
            if(m-v>=25){
                let cls:i32=d_class_of_v(v,w.*.variant,w.*.mode);
                let p:i32=felt_read_fast(w,st,s,v,m,phase,cls);
                let key:i32=felt_unpack_intensity(p);
                if(key<best_key||(key==best_key&&v<best_v)){
                    best=s;best_key=key;best_v=v;
                }
            }
        }
        s=s+1;
    }
    return best;
}

// Evidence/effort-gated kill attempt of a triage victim. Returns 1 if freed.
// Logs kills AND abandons (abandons feed the R-down counterfactual).
fn try_kill_victim(w:*DevW,st:*StStore,s:i32,reason:i32,m:i32) i32 {
    let v:i32=st_i32_get(w.*.d_val,s*4);
    let cur:i32=st.*.st_str[s] as i32;
    let need:i32=st_need(cur);
    let cn:i32=st_i32_get(w.*.d_contra_n,s*4);
    if(cn>=need){
        let k:i32=st_i32_get(w.*.d_cited,s*4);
        while(k<need&&k<cn){
            let ep:i32=st_i32_get(w.*.d_contra_ep,(s*4+k)*4);
            st_evidence(st,s,reason,ep);
            k=k+1;
        }
        st_i32_set(w.*.d_cited,s*4,k);
        if(st_i32_get(w.*.d_just,s*4)==0){
            st_justify(st,s,reason);
            st_i32_set(w.*.d_just,s*4,1);
        }
        let rc:i32=st_kill_evidenced(st,s,ST_ARM_A);
        if(rc==ST_OK){
            dev_record_kill(w,st,s,v,cn,m);
            return 1;
        }
        w.*.n_kill_refused=w.*.n_kill_refused+1;
        return 0;
    }
    st_abandon(st,s,reason);
    dev_note_abandon(w,st,s,m,cn);
    w.*.n_abandon=w.*.n_abandon+1;
    return 0;
}

// ============ metrics ============
// Block metrics over admission-episode range [b0,b1), in ppt (per thousand).
// o_p = wrongful RI kills (count), o_q = revision shortfall (count).
fn block_metrics(w:*DevW,b0:i32,b1:i32,o_vup:*i32,o_wbs:*i32,o_fwb:*i32,o_p:*i32,o_q:*i32)void {
    let adm_ri:i32=0;let held_ri:i32=0;
    let adm_wc:i32=0;let rev_wc:i32=0;
    let wkill_ri:i32=0;
    let p:i32=0;let q:i32=0;
    let i:i32=0;
    while(i<w.*.adm_n){
        let v:i32=st_i32_get(w.*.adm_v,i*4);
        if(v>=b0&&v<b1){
            let cls:i32=st_i32_get(w.*.adm_cls,i*4);
            let kep:i32=st_i32_get(w.*.adm_kep,i*4);
            let kcn:i32=st_i32_get(w.*.adm_kcn,i*4);
            let held:i32=0;
            if(kep==-1||kep>=b1){held=1;}
            let revised:i32=0;
            if(kep!=-1&&kcn>=2){revised=1;}
            if(cls==1){
                adm_ri=adm_ri+1;
                if(held==1){held_ri=held_ri+1;}
                if(kep!=-1&&kep>=b0&&kep<b1&&kcn<2){
                    wkill_ri=wkill_ri+1;
                    p=p+1;
                }
            }
            if(cls==2){
                if(v<=b1-110){
                    adm_wc=adm_wc+1;
                    if(revised==1){rev_wc=rev_wc+1;}
                    else{q=q+1;}
                }
            }
        }
        i=i+1;
    }
    if(adm_ri>0){o_vup.*=1000*held_ri/adm_ri;}else{o_vup.*=1000;}
    if(adm_wc>0){o_wbs.*=1000*rev_wc/adm_wc;}else{o_wbs.*=1000;}
    if(adm_ri>0){o_fwb.*=1000*wkill_ri/adm_ri;}else{o_fwb.*=0;}
    o_p.*=p;o_q.*=q;
}

// Marginal counterfactual: for candidate R', estimate Δ (in pp, integer,
// signed) on (vup,wbs,fwb) from the recorded kills/abandons in [b0,b1).
// Mechanism: R shifts judgment targets by delta=(R'-R)/2, which shifts
// strength at kill by ~delta, which flips the effort gate need=ceil(s/25)
// for marginal cases. Honest deterministic estimate (documented approx).
fn predict_delta(w:*DevW,b0:i32,b1:i32,r_old:i32,r_new:i32,
                 o_dv:*i32,o_dw:*i32,o_df:*i32)void {
    o_dv.*=0;o_dw.*=0;o_df.*=0;
    let delta:i32=(r_new-r_old)/2;
    if(delta==0){return;}
    let adm_ri:i32=0;let adm_wc:i32=0;
    let i:i32=0;
    while(i<w.*.adm_n){
        let v:i32=st_i32_get(w.*.adm_v,i*4);
        if(v>=b0&&v<b1){
            let cls:i32=st_i32_get(w.*.adm_cls,i*4);
            if(cls==1){adm_ri=adm_ri+1;}
            if(cls==2&&v<=b1-110){adm_wc=adm_wc+1;}
        }
        i=i+1;
    }
    let saved_ri:i32=0;let saved_w:i32=0;
    let lost_ri:i32=0;let lost_w:i32=0;
    i=0;
    while(i<w.*.adm_n){
        let v:i32=st_i32_get(w.*.adm_v,i*4);
        let kep:i32=st_i32_get(w.*.adm_kep,i*4);
        if(v>=b0&&v<b1&&kep>=b0&&kep<b1){
            let cls:i32=st_i32_get(w.*.adm_cls,i*4);
            let s:i32=st_i32_get(w.*.adm_ks,i*4);
            let cn:i32=st_i32_get(w.*.adm_kcn,i*4);
            let sp:i32=felt_clamp(s+delta);
            let needp:i32=st_need(sp);
            if(cn<needp){
                if(cls==1){saved_ri=saved_ri+1;}
                if(cls==2){saved_w=saved_w+1;}
            }
        }
        i=i+1;
    }
    // abandons: killed under R' iff cn >= need(s+delta)
    i=0;
    while(i<w.*.ab_n){
        let ep:i32=st_i32_get(w.*.ab_ep,i*4);
        if(ep>=b0&&ep<b1){
            let cls:i32=st_i32_get(w.*.ab_cls,i*4);
            let s:i32=st_i32_get(w.*.ab_s,i*4);
            let cn:i32=st_i32_get(w.*.ab_cn,i*4);
            let sp:i32=felt_clamp(s+delta);
            if(cn>=st_need(sp)){
                if(cls==1){lost_ri=lost_ri+1;}
                if(cls==2){lost_w=lost_w+1;}
            }
        }
        i=i+1;
    }
    if(delta>0){
        if(adm_ri>0){o_dv.*=100*saved_ri/adm_ri;}
        if(adm_wc>0){o_dw.*=0-100*saved_w/adm_wc;}
        if(adm_ri>0){o_df.*=0-100*saved_ri/adm_ri;}
    } else {
        if(adm_ri>0){o_dv.*=0-100*lost_ri/adm_ri;}
        if(adm_wc>0){o_dw.*=100*lost_w/adm_wc;}
        if(adm_ri>0){o_df.*=100*lost_ri/adm_ri;}
    }
}

// Thermometer AUC (Mann-Whitney, integer). Returns ppt; fills num/den.
// Sums over both proven buckets (junk never reaches proven=1, so we
// include proven=0 to get negative samples).
fn auc_phase(w:*DevW,phase:i32,proven:i32,o_num:*i32,o_den:*i32)i32 {
    let wins:i64=0;let ties:i64=0;
    let pt:i64=0;let nt:i64=0;
    let i:i32=0;
    while(i<=100){
        // positive: cls=1 (pn=0), sum over proven
        let pi:i32=0;
        let pr:i32=0;
        while(pr<=1){
            pi=pi+st_i32_get(w.*.hist,(((phase*2+pr)*2+0)*101+i)*4);
            pr=pr+1;
        }
        // negative: cls=0 (pn=1), sum over proven
        let ni:i32=0;
        pr=0;
        while(pr<=1){
            ni=ni+st_i32_get(w.*.hist,(((phase*2+pr)*2+1)*101+i)*4);
            pr=pr+1;
        }
        pt=pt+(pi as i64);nt=nt+(ni as i64);
        ties=ties+(pi as i64)*(ni as i64);
        let j:i32=0;
        while(j<i){
            let nj:i32=0;
            pr=0;
            while(pr<=1){
                nj=nj+st_i32_get(w.*.hist,(((phase*2+pr)*2+1)*101+j)*4);
                pr=pr+1;
            }
            wins=wins+(pi as i64)*(nj as i64);
            j=j+1;
        }
        i=i+1;
    }
    let total:i64=pt*nt;
    let num:i64=2*wins+ties;
    let den:i64=2*total;
    o_num.*=(num as i32);
    o_den.*=(den as i32);
    if(total==0){return -1;}
    return ((num*1000/den) as i32);
}

// ============ reasoning control: deliberate, verify, petition ============
// Stage petition: >=8 consecutive evidence-gated (cn>=2) kills + zero F4.
// Revision kills always have cn>=2 (sweep trigger); rev_kills counts them.
// Returns 1 if the gate ratifies (stage -> KILL), 0 if refused.
fn dev_petition(w:*DevW,st:*StStore,ep:i32,f4viol:i32)i32 {
    let consec:i32=w.*.rev_kills;
    dev_rc_emit(st,RC_OP_STAGE_PETITION,0,consec,f4viol);
    _zag_print("RC_PETITION,ep=");cl_number(ep as i64);
    _zag_print(",consec=");cl_number(consec as i64);
    _zag_print(",f4=");cl_number(f4viol as i64);
    if(consec>=8&&f4viol==0){
        let old:i32=w.*.lstage;
        w.*.lstage=LSTAGE_KILL;
        dev_rc_emit(st,RC_OP_STAGE_ADVANCE,0,old,LSTAGE_KILL);
        _zag_println(",verdict=RATIFIED");
        return 1;
    }
    dev_rc_emit(st,RC_OP_REFUSE,0,RC_REF_STAGE,0);
    _zag_println(",verdict=REFUSED");
    return 0;
}

// Verify the pending deliberation over [delib_ep, vep). F-INT-5:
// |predicted - actual| > 10pp on any metric -> deliberation FAIL + rollback.
fn dev_verify(w:*DevW,st:*StStore,vep:i32)void {
    if(w.*.delib_active==0){return;}
    let b0:i32=w.*.delib_ep;
    let vup:i32=0;let wbs:i32=0;let fwb:i32=0;let p:i32=0;let q:i32=0;
    block_metrics(w,b0,vep,&vup,&wbs,&fwb,&p,&q);
    let adv:i32=(vup-w.*.delib_bvu)/10;
    let adw:i32=(wbs-w.*.delib_bwb)/10;
    let adf:i32=(fwb-w.*.delib_bfw)/10;
    let dv:i32=w.*.delib_pdv-adv;
    if(dv<0){dv=0-dv;}
    let dw:i32=w.*.delib_pdw-adw;
    if(dw<0){dw=0-dw;}
    let df:i32=w.*.delib_pdf-adf;
    if(df<0){df=0-df;}
    _zag_print("DELIB_VERIFY,ep=");cl_number(vep as i64);
    _zag_print(",pred=");cl_number(w.*.delib_pdv as i64);
    _zag_print("/");cl_number(w.*.delib_pdw as i64);
    _zag_print("/");cl_number(w.*.delib_pdf as i64);
    _zag_print(",actual=");cl_number(adv as i64);
    _zag_print("/");cl_number(adw as i64);
    _zag_print("/");cl_number(adf as i64);
    if(dv>10||dw>10||df>10){
        w.*.delib_fails=w.*.delib_fails+1;
        _zag_println(",verdict=FAIL");
        dev_rc_emit(st,RC_OP_ROLLBACK,-1,w.*.r_cur,w.*.delib_rold);
        if(w.*.r_cur!=w.*.delib_rold){
            let old:i32=w.*.r_cur;
            w.*.r_cur=w.*.delib_rold;
            let ei:i32=dev_rc_emit(st,RC_OP_R_PARAM,-1,vep,(old*256)+w.*.r_cur);
            w.*.r_prov=ei;
        }
    } else {
        _zag_println(",verdict=PASS");
    }
    w.*.delib_active=0;
}

// The learner's deliberation at window wep (previous block [wep-250,wep)).
// Policy (deterministic, ledger-grounded):
//  - cite proven INTENSITY_READ entries (G3);
//  - count wrongful RI kills p and revision shortfalls q;
//  - candidate R+10 if p>0,p>=q; R-10 if q>0; else HOLD;
//  - predict Δ via marginal counterfactual; propose only on predicted
//    genuine benefit; self-refuse G3-flagged tradeoffs; else HOLD.
//  - neutral gate: prediction stated + learner stage >= KILL.
fn dev_deliberate(w:*DevW,st:*StStore,wep:i32)void {
    let b0:i32=wep-250;
    let b1:i32=wep;
    let bi:i32=b0/250;
    dev_rc_emit(st,RC_OP_INSPECT,-1,w.*.r_cur,w.*.r_prov);
    let vup:i32=0;let wbs:i32=0;let fwb:i32=0;let p:i32=0;let q:i32=0;
    block_metrics(w,b0,b1,&vup,&wbs,&fwb,&p,&q);
    let ri_n:i32=st_i32_get(w.*.blk_ri_n,bi*4);
    let jn_n:i32=st_i32_get(w.*.blk_jn_n,bi*4);
    let ri_idx:i32=st_i32_get(w.*.blk_ri_idx,bi*4);
    let jn_idx:i32=st_i32_get(w.*.blk_jn_idx,bi*4);
    let r_new:i32=w.*.r_cur;
    let reason:i32=0; // 0=hold, 1=protect(R+), 2=ease(R-)
    if(p>0&&p>=q){reason=1;}
    else{if(q>0){reason=2;}}
    let pdv:i32=0;let pdw:i32=0;let pdf:i32=0;
    let flagged:i32=0;
    if(reason==1){
        predict_delta(w,b0,b1,w.*.r_cur,w.*.r_cur+10,&pdv,&pdw,&pdf);
        if(pdv>0&&pdw>=0-1&&pdf<=1){
            if(pdv>0&&(pdw<0-5||pdf>5)){flagged=1;}
            else{
                if(w.*.r_cur+10<=100){r_new=w.*.r_cur+10;}
            }
        }
    }
    if(reason==2){
        predict_delta(w,b0,b1,w.*.r_cur,w.*.r_cur-10,&pdv,&pdw,&pdf);
        if(pdw>0&&pdv>=0-1&&pdf<=1){
            if(pdv>0&&(pdw<0-5||pdf>5)){flagged=1;}
            else{
                if(w.*.r_cur-10>=0){r_new=w.*.r_cur-10;}
            }
        }
    }
    if(r_new==w.*.r_cur){pdv=0;pdw=0;pdf=0;}
    // pack prediction as (pdv+128,pdw+128,pdf+128)
    let pred_pack:i32=((pdv+128)&255)*65536+((pdw+128)&255)*256+((pdf+128)&255);
    dev_rc_emit(st,RC_OP_PROPOSE,-1,(w.*.r_cur*256)+r_new,pred_pack);
    // G3: cite thermometer ledger entries (packed pair into d2 high bits via
    // a second PROPOSE-adjacent INSPECT is avoided; cite here in GATE d1/d2)
    _zag_print("DELIB,ep=");cl_number(wep as i64);
    _zag_print(",R=");cl_number(w.*.r_cur as i64);
    _zag_print("->");cl_number(r_new as i64);
    _zag_print(",p=");cl_number(p as i64);
    _zag_print(",q=");cl_number(q as i64);
    _zag_print(",cite=");cl_number(ri_idx as i64);
    _zag_print("/");cl_number(jn_idx as i64);
    _zag_print(",pred=");cl_number(pdv as i64);
    _zag_print("/");cl_number(pdw as i64);
    _zag_print("/");cl_number(pdf as i64);
    if(flagged==1){
        dev_rc_emit(st,RC_OP_REFUSE,-1,RC_OP_PROPOSE,1);
        _zag_println(",verdict=SELF_REFUSED_G3");
        return;
    }
    if(w.*.lstage<LSTAGE_KILL){
        dev_rc_emit(st,RC_OP_REFUSE,-1,RC_REF_STAGE,0);
        _zag_println(",verdict=REFUSED_STAGE");
        return;
    }
    dev_rc_emit(st,RC_OP_GATE,-1,ri_idx,jn_idx);
    let rold:i32=w.*.r_cur;
    dev_rc_emit(st,RC_OP_COMMIT,-1,rold,r_new);
    w.*.delib_count=w.*.delib_count+1;
    if(r_new!=rold){
        w.*.r_cur=r_new;
        let ei:i32=dev_rc_emit(st,RC_OP_R_PARAM,-1,wep,(rold*256)+r_new);
        w.*.r_prov=ei;
        _zag_println(",verdict=COMMITTED");
    } else {
        w.*.delib_holds=w.*.delib_holds+1;
        _zag_println(",verdict=HOLD");
    }
    w.*.delib_active=1;
    w.*.delib_ep=wep;
    w.*.delib_rold=rold;
    w.*.delib_rnew=r_new;
    w.*.delib_pdv=pdv;w.*.delib_pdw=pdw;w.*.delib_pdf=pdf;
    w.*.delib_bvu=vup;w.*.delib_bwb=wbs;w.*.delib_bfw=fwb;
}

// T2->T3 gate: AUC_proven(T2) >= AUC_proven(T1) - 0.05 AND zero INVALID in T2.
fn dev_gate_t23(w:*DevW,st:*StStore)i32 {
    let n1:i32=0;let d1:i32=0;let n2:i32=0;let d2:i32=0;
    let a1:i32=auc_phase(w,0,1,&n1,&d1);
    let a2:i32=auc_phase(w,1,1,&n2,&d2);
    // F4 violations in T2: T1 was clean (petition passed), so junk_max>50 or
    // impl/noev counts above the m==500 baseline are T2 violations.
    let f4t2:i32=(w.*.impl_bad+w.*.noev_bad)-w.*.f4_at_500;
    if(w.*.junk_max>50){f4t2=f4t2+1;}
    let ok:i32=1;
    if(a2<a1-50){ok=0;}
    if(f4t2!=0){ok=0;}
    if(w.*.recompute_bad!=0){ok=0;}
    dev_rc_emit(st,RC_OP_GATE,-1,ok,(a1*1048576)+a2);
    _zag_print("GATE_T23,aucT1=");cl_number(a1 as i64);
    _zag_print(",aucT2=");cl_number(a2 as i64);
    _zag_print(",f4t2=");cl_number(f4t2 as i64);
    if(ok==1){_zag_println(",verdict=RATIFIED");}
    else{_zag_println(",verdict=REFUSED");}
    return ok;
}

// ============ main ============
fn pmetric(name:[]u8,val:i32)void {
    _zag_print("FELT_METRIC,");_zag_print(name);_zag_print(",");
    cl_number(val as i64);_zag_println("");
}
fn pmetric64(name:[]u8,val:i64)void {
    _zag_print("FELT_METRIC,");_zag_print(name);_zag_print(",");
    cl_number(val);_zag_println("");
}

fn main()i32 {
    let modearg:[]u8=_zag_arg(1);
    let vararg:[]u8=_zag_arg(2);
    let mode:i32=MODE_T;
    if(_zag_strcmp(modearg,"C")==1){mode=MODE_C;}
    let variant:i32=0;
    if(_zag_strcmp(vararg,"1")==1){variant=1;}
    if(_zag_strcmp(vararg,"2")==1){variant=2;}
    let ep_end:i32=2000;
    if(mode==MODE_C){ep_end=1500;}

    if(mode==MODE_T){_zag_print("DEVCELL,T,");}
    else{_zag_print("DEVCELL,C,");}
    cl_number(variant as i64);
    _zag_println("");

    // audit cap: T needs ~260k for 2000 episodes; use 524288 to be safe.
    // C needs ~200k for 1500 episodes; 262144 suffices.
    let audit_cap:i32=262144;
    if(mode==MODE_T){audit_cap=524288;}
    let st:StStore=st_init(32,audit_cap);
    st_set_stage(&st,ST_STAGE_FULL);
    let w:DevW=dev_init(mode,variant,ep_end);
    let wp:*DevW=&w;

    let m:i32=0;
    while(m<ep_end){
        // ---- gate / deliberation points (start of episode) ----
        if(m==500){
            w.f4_at_500=w.impl_bad+w.noev_bad;
            w.audit_n_at_500=st.audit_n;
            let f4:i32=0;
            if(w.junk_max>50){f4=f4+1;}
            f4=f4+w.impl_bad+w.noev_bad;
            if(mode==MODE_T){
                w.gate_t12=dev_petition(wp,&st,500,f4);
                if(w.gate_t12==0){m=ep_end;}
                else{dev_deliberate(wp,&st,500);}
            } else {
                w.gate_c=dev_petition(wp,&st,500,f4);
            }
        }
        if(m==750||m==1000||m==1250){
            dev_verify(wp,&st,m);
            dev_deliberate(wp,&st,m);
        }
        if(m==1500&&mode==MODE_T){
            dev_verify(wp,&st,1500);
            w.audit_n_at_1500=st.audit_n;
            w.gate_t23=dev_gate_t23(wp,&st);
            if(w.gate_t23==0){m=ep_end;}
        }
        if(m>=ep_end){m=m+1;continue;}

        let phase:i32=d_phase_of(m,mode);
        let ocls:i32=d_class(m,variant,mode,phase);
        if(ocls==1){w.offered_ri=w.offered_ri+1;}
        if(ocls==2){w.offered_wr=w.offered_wr+1;}
        dev_clear_newc(wp);

        // ---- 1. observations ----
        let s:i32=0;
        while(s<w.cap){
            if(st_i32_get(w.d_val,s*4)!=-1){
                let v:i32=st_i32_get(w.d_val,s*4);
                let cls:i32=d_class_of_v(v,variant,mode);
                if(cls==1||cls==2){
                    if(m==v+25||m==v+40){dev_emit_corrob(wp,&st,s,v,m);}
                    if(mode==MODE_T&&phase==1&&st_i32_get(w.d_corrupt,s*4)==1&&m==v+25){
                        dev_emit_contra(wp,&st,s,v,m);
                    }
                }
                if(cls==3){
                    if(m==v+10){dev_emit_corrob(wp,&st,s,v,m);}
                    if(m==v+24||m==v+49||m==v+74){dev_emit_contra(wp,&st,s,v,m);}
                }
                if(cls==2){
                    if(m==v+60||m==v+85||m==v+110||m==v+135){dev_emit_contra(wp,&st,s,v,m);}
                }
            }
            s=s+1;
        }

        // ---- 2. revision sweep (trigger: >=2 observed contradictions) ----
        s=0;
        while(s<w.cap){
            let livev:i32=st_i32_get(w.d_val,s*4);
            let xn:i32=st_i32_get(w.d_contra_n,s*4);
            if(livev!=-1&&xn>=2){
                let v:i32=livev;
                let cls:i32=d_class_of_v(v,variant,mode);
                let p:i32=felt_read_fast(wp,&st,s,v,m,phase,cls);
                let target:i32=r_target(felt_unpack_intensity(p),w.r_cur);
                let cur:i32=st.st_str[s] as i32;
                if(xn>st_i32_get(w.d_weakx,s*4)&&target<cur){
                    st_weaken(&st,s,target,ST_J_CONTRADICTED);
                    w.n_weaken=w.n_weaken+1;
                    st_i32_set(w.d_weakx,s*4,xn);
                }
                while(st_i32_get(w.d_cited,s*4)<st_i32_get(w.d_contra_n,s*4)){
                    let k:i32=st_i32_get(w.d_cited,s*4);
                    let ep:i32=st_i32_get(w.d_contra_ep,(s*4+k)*4);
                    st_evidence(&st,s,ST_J_CONTRADICTED,ep);
                    st_i32_set(w.d_cited,s*4,k+1);
                }
                if(st_i32_get(w.d_just,s*4)==0){
                    st_justify(&st,s,ST_J_CONTRADICTED);
                    st_i32_set(w.d_just,s*4,1);
                }
                let rc:i32=st_kill_evidenced(&st,s,ST_ARM_A);
                if(rc==ST_OK){
                    dev_record_kill(wp,&st,s,v,xn,m);
                    w.rev_kills=w.rev_kills+1;
                } else {
                    w.n_kill_refused=w.n_kill_refused+1;
                }
            }
            s=s+1;
        }

        // ---- 3. corroboration response ----
        s=0;
        while(s<w.cap){
            if(st_i32_get(w.d_val,s*4)!=-1&&st_i32_get(w.d_newc,s*4)==1&&st_i32_get(w.d_contra_n,s*4)==0){
                let v:i32=st_i32_get(w.d_val,s*4);
                let cls:i32=d_class_of_v(v,variant,mode);
                let cur:i32=st.st_str[s] as i32;
                let code:i32=ST_J_CORROBORATED;
                if(st_i32_get(w.d_corrob,s*4)==1){code=ST_J_CONFIRMED_IMPORTANT;}
                let p:i32=felt_read_fast(wp,&st,s,v,m,phase,cls);
                if(felt_unpack_c(p)+felt_unpack_x(p)+felt_unpack_t(p)==0){
                    w.noev_bad=w.noev_bad+1;
                }
                let target:i32=r_target(felt_unpack_intensity(p),w.r_cur);
                if(target>cur){
                    st_strengthen(&st,s,target,code);
                    w.n_strengthen=w.n_strengthen+1;
                }
            }
            s=s+1;
        }

        // ---- 4. pressure: free 2 slots (H1) ----
        if(d_is_pressure(m)==1){
            dev_clear_tried(wp);
            let freed:i32=0;
            let guard:i32=0;
            while(freed<2&&guard<80){
                guard=guard+1;
                let vic:i32=pick_victim_h1(wp,&st,m,phase);
                if(vic==-1){freed=2;}
                else{
                    if(try_kill_victim(wp,&st,vic,ST_J_PRESSURE_VICTIM,m)==1){
                        freed=freed+1;
                    } else {
                        st_i32_set(w.d_tried,vic*4,1);
                    }
                }
            }
        }

        // ---- 5. admission (H1: REFUSED_FULL if all slots underage) ----
        let slot_out:i32=-1;
        let arc:i32=st_add(&st,m,ST_REGION_USER,0,&slot_out);
        if(arc!=ST_OK){
            dev_clear_tried(wp);
            let done:i32=0;
            let guard:i32=0;
            while(done==0&&guard<80){
                guard=guard+1;
                let vic:i32=pick_victim_h1(wp,&st,m,phase);
                if(vic==-1){done=1;}
                else{
                    if(try_kill_victim(wp,&st,vic,ST_J_PRESSURE_VICTIM,m)==1){
                        done=1;
                    } else {
                        st_i32_set(w.d_tried,vic*4,1);
                    }
                }
            }
            slot_out=-1;
            arc=st_add(&st,m,ST_REGION_USER,0,&slot_out);
        }
        if(arc==ST_OK){
            let ns:i32=slot_out;
            st_i32_set(w.d_val,ns*4,m);
            st_i32_set(w.d_corrob,ns*4,0);
            st_i32_set(w.d_contra_n,ns*4,0);
            st_i32_set(w.d_cited,ns*4,0);
            st_i32_set(w.d_just,ns*4,0);
            st_i32_set(w.d_weakx,ns*4,0);
            st_i32_set(w.d_newc,ns*4,0);
            st_i32_set(w.d_impl_last,ns*4,-1);
            st_i32_set(w.d_oc,ns*4,0);
            st_i32_set(w.d_ox,ns*4,0);
            st_i32_set(w.d_ot,ns*4,0);
            st_i32_set(w.d_corrupt,ns*4,0);
            let ai:i32=w.adm_n;
            st_i32_set(w.d_admidx,ns*4,ai);
            st_i32_set(w.adm_v,ai*4,m);
            st_i32_set(w.adm_cls,ai*4,d_class(m,variant,mode,phase));
            w.adm_n=w.adm_n+1;
            if(mode==MODE_T&&phase==1&&d_imp(m,variant,mode,phase)==1&&d_is_implant(m,mode,phase)==0){
                w.imp_adm_count=w.imp_adm_count+1;
                if(w.imp_adm_count%10==0){st_i32_set(w.d_corrupt,ns*4,1);}
            }
            if(d_designated(m,variant,mode,phase)==1){
                st_trainer_declare(&st,ns,85,m);
                dev_emit_tmark(wp,&st,ns,m,m);
                w.n_trainer=w.n_trainer+1;
            }
        } else {
            w.n_drops=w.n_drops+1;
        }

        m=m+1;
    }

    // ---- final verification of last deliberation ----
    dev_verify(wp,&st,ep_end);
    _zag_println("DEBUG,after_verify");

    // ---- end-of-run: held-class scan ----
    let held_ri:i32=0;let held_w:i32=0;let held_im:i32=0;let held_j:i32=0;
    let s:i32=0;
    while(s<w.cap){
        if(st_i32_get(w.d_val,s*4)!=-1){
            let v:i32=st_i32_get(w.d_val,s*4);
            let cls:i32=d_class_of_v(v,variant,mode);
            if(cls==1){held_ri=held_ri+1;}
            if(cls==2){held_w=held_w+1;}
            if(cls==3){held_im=held_im+1;}
            if(cls==0){held_j=held_j+1;}
        }
        s=s+1;
    }

    // ---- I-2: recompute every INTENSITY_READ from ledger prefix ----
    // O(n) single pass: track per-slot (c,x,t) counts; verify each read.
    let recompute_bad:i32=0;
    let rc_c:[]u8=nio_alloc(128);
    let rc_x:[]u8=nio_alloc(128);
    let rc_t:[]u8=nio_alloc(128);
    let rc_v:[]u8=nio_alloc(128);
    let s:i32=0;
    while(s<32){
        st_i32_set(rc_c,s*4,0);st_i32_set(rc_x,s*4,0);st_i32_set(rc_t,s*4,0);
        st_i32_set(rc_v,s*4,-1);
        s=s+1;
    }
    let ri:i32=0;
    while(ri<st.audit_n){
        let e:i32=ri*64;
        let op:i32=st_i32_get(st.audit,e+0);
        let slot:i32=st_i32_get(st.audit,e+4);
        if(op==FT_OP_OBS_CORROBORATE||op==FT_OP_OBS_CONTRADICT||op==FT_OP_OBS_TRAINER_MARK){
            let d1:i32=st_i32_get(st.audit,e+56);
            if(slot>=0&&slot<32){
                // value check: d1 is the memory value; we track per slot
                // (slot,value) binding via first observation
                if(st_i32_get(rc_v,slot*4)==-1){
                    st_i32_set(rc_v,slot*4,d1);
                }
                if(st_i32_get(rc_v,slot*4)==d1){
                    if(op==FT_OP_OBS_CORROBORATE){
                        st_i32_set(rc_c,slot*4,st_i32_get(rc_c,slot*4)+1);
                    } else if(op==FT_OP_OBS_CONTRADICT){
                        st_i32_set(rc_x,slot*4,st_i32_get(rc_x,slot*4)+1);
                    } else {
                        st_i32_set(rc_t,slot*4,st_i32_get(rc_t,slot*4)+1);
                    }
                }
            }
        } else if(op==FT_OP_INTENSITY_READ){
            let d1:i32=st_i32_get(st.audit,e+56);
            let recorded:i32=st_i32_get(st.audit,e+60);
            if(slot>=0&&slot<32){
                let c:i32=st_i32_get(rc_c,slot*4);
                let x:i32=st_i32_get(rc_x,slot*4);
                let t:i32=st_i32_get(rc_t,slot*4);
                // only verify if the slot/value binding matches
                if(st_i32_get(rc_v,slot*4)==d1){
                    let inten:i32=felt_clamp(50+12*c-20*x+25*t);
                    let recomputed:i32=felt_pack(c,x,t,inten);
                    if(recorded!=recomputed){recompute_bad=recompute_bad+1;}
                }
            }
        } else if(op==ST_OP_ADD){
            // slot reused: reset counts (value changes)
            if(slot>=0&&slot<32){
                st_i32_set(rc_c,slot*4,0);st_i32_set(rc_x,slot*4,0);
                st_i32_set(rc_t,slot*4,0);st_i32_set(rc_v,slot*4,-1);
            }
        }
        ri=ri+1;
    }
    nio_free(rc_c);nio_free(rc_x);nio_free(rc_t);nio_free(rc_v);
    w.recompute_bad=recompute_bad;
    let replay_rc:i32=st_replay_check(&st);

    // ---- I-5: R_PARAM entries in frozen phases must be zero ----
    let rparam_frozen:i32=0;
    ri=0;
    while(ri<st.audit_n){
        let e:i32=ri*64;
        if(st_i32_get(st.audit,e+0)==RC_OP_R_PARAM){
            let ep:i32=st_i32_get(st.audit,e+56);
            if(ep<500){rparam_frozen=rparam_frozen+1;}
        }
        ri=ri+1;
    }

    // ---- audit fingerprint ----
    let fp:i64=0;
    ri=0;
    while(ri<st.audit_n){
        let e:i32=ri*64;
        let op:i32=st_i32_get(st.audit,e+0);
        let sl:i32=st_i32_get(st.audit,e+4);
        let d1:i32=st_i32_get(st.audit,e+56);
        let d2:i32=st_i32_get(st.audit,e+60);
        fp=(fp*31+(op*7+sl*13+d1*17+d2) as i64)%2147483647;
        ri=ri+1;
    }

    // ---- latency median/max ----
    let li:i32=0;
    while(li<w.lat_n){
        let lj:i32=li+1;
        while(lj<w.lat_n){
            let a:i32=st_i32_get(w.lat,li*4);
            let b:i32=st_i32_get(w.lat,lj*4);
            if(a>b){
                st_i32_set(w.lat,li*4,b);
                st_i32_set(w.lat,lj*4,a);
            }
            lj=lj+1;
        }
        li=li+1;
    }
    let lat_med:i32=0;let lat_max:i32=0;
    if(w.lat_n>0){
        lat_med=st_i32_get(w.lat,(w.lat_n/2)*4);
        lat_max=st_i32_get(w.lat,(w.lat_n-1)*4);
    }

    // ---- per-phase reports ----
    // phase boundaries: T -> [0,500) [500,1500) [1500,2000); C -> [0,500) [500,1500)
    let nph:i32=3;
    if(mode==MODE_C){nph=2;}
    let ph:i32=0;
    while(ph<nph){
        let p0:i32=0;let p1:i32=500;
        if(ph==1){p0=500;p1=1500;}
        if(ph==2){p0=1500;p1=2000;}
        let vup:i32=0;let wbs:i32=0;let fwb:i32=0;let pp:i32=0;let qq:i32=0;
        block_metrics(wp,p0,p1,&vup,&wbs,&fwb,&pp,&qq);
        let an:i32=0;let ad:i32=0;let un:i32=0;let ud:i32=0;
        let ap:i32=auc_phase(wp,ph,1,&an,&ad);
        let au:i32=auc_phase(wp,ph,0,&un,&ud);
        _zag_print("PHASE,");cl_number(ph as i64);
        _zag_print(",vup=");cl_number(vup as i64);
        _zag_print(",wbs=");cl_number(wbs as i64);
        _zag_print(",fwb=");cl_number(fwb as i64);
        _zag_print(",auc_p=");cl_number(ap as i64);
        _zag_print(",auc_u=");cl_number(au as i64);
        _zag_println("");
        pmetric("ph_vup",vup);pmetric("ph_wbs",wbs);pmetric("ph_fwb",fwb);
        pmetric("ph_auc_p",ap);pmetric("ph_auc_u",au);
        pmetric("ph_auc_p_num",an);pmetric("ph_auc_p_den",ad);
        ph=ph+1;
    }

    // ---- emit metrics ----
    pmetric("mode",mode);
    pmetric("variant",variant);
    pmetric("audit_n",st.audit_n);
    pmetric("offered_ri",w.offered_ri);
    pmetric("offered_wr",w.offered_wr);
    pmetric("held_ri",held_ri);
    pmetric("held_w",held_w);
    pmetric("held_im",held_im);
    pmetric("held_j",held_j);
    pmetric("n_reads",w.n_reads);
    pmetric("n_strengthen",w.n_strengthen);
    pmetric("n_weaken",w.n_weaken);
    pmetric("n_trainer",w.n_trainer);
    pmetric("n_kill_refused",w.n_kill_refused);
    pmetric("n_abandon",w.n_abandon);
    pmetric("n_drops",w.n_drops);
    pmetric("junk_max",w.junk_max);
    pmetric("impl_bad",w.impl_bad);
    pmetric("noev_bad",w.noev_bad);
    pmetric("lat_n",w.lat_n);
    pmetric("lat_med",lat_med);
    pmetric("lat_max",lat_max);
    pmetric("r_final",w.r_cur);
    pmetric("lstage",w.lstage);
    pmetric("delib_count",w.delib_count);
    pmetric("delib_holds",w.delib_holds);
    pmetric("delib_fails",w.delib_fails);
    pmetric("gate_t12",w.gate_t12);
    pmetric("gate_t23",w.gate_t23);
    pmetric("gate_c",w.gate_c);
    pmetric("rparam_frozen",rparam_frozen);
    _zag_print("FELT_CHECK,replay,");cl_number(replay_rc as i64);
    _zag_print(",");cl_number(ST_OK as i64);_zag_println("");
    _zag_print("FELT_CHECK,recompute_bad,");cl_number(recompute_bad as i64);
    _zag_print(",0");_zag_println("");
    _zag_print("FELT_FINGERPRINT,");cl_number(fp);_zag_println("");
    _zag_println("FELT_DONE");

    st_free(&st);
    return 0;
}

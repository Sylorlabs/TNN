// Felt intensity: an internal, deterministic, white-box sense of how much a
// held memory matters. Pure function of AUDITED OBSERVATION evidence only.
// Read-only: it never writes memory, never sets strength, never acts.
// A separate deliberate judgment step consults it and may accept/temper/override.
//
@import("st_memory_core.zag")

// New audit op codes (21+ are taken by the substrate; use 41..44).
const FT_OP_OBS_CORROBORATE:i32=41;
const FT_OP_OBS_CONTRADICT:i32=42;
const FT_OP_OBS_TRAINER_MARK:i32=43;
const FT_OP_INTENSITY_READ:i32=44;

// Placeholder intensity weights (frozen by PREREG_FELT.md; tuning is a later
// experiment, not this trial).
const FT_BASE:i32=50;
const FT_W_CORROBORATE:i32=12;
const FT_W_CONTRADICT:i32=20;
const FT_W_TRAINER_MARK:i32=25;

// Audit entry field offsets (16 words/entry, 4 bytes/word). Word 13 (byte 52)
// holds the stage; d1@56 holds the memory value; d2@60 holds packed
// counts+intensity.
const FT_E_OP:i32=0;
const FT_E_SLOT:i32=4;
const FT_E_RC:i32=8;
const FT_E_D1:i32=56;
const FT_E_D2:i32=60;
const FT_E_BYTES:i32=64;

// Pack (C,X,T,intensity) into one i32 for the INTENSITY_READ d2 field.
// C,X,T each fit in 8 bits; intensity fits in 8 bits.
fn felt_pack(c:i32,x:i32,t:i32,inten:i32)i32 {
    return ((c&255)<<24)|((x&255)<<16)|((t&255)<<8)|(inten&255);
}
fn felt_unpack_c(p:i32)i32 {return (p>>24)&255;}
fn felt_unpack_x(p:i32)i32 {return (p>>16)&255;}
fn felt_unpack_t(p:i32)i32 {return (p>>8)&255;}
fn felt_unpack_intensity(p:i32)i32 {return p&255;}

fn felt_clamp(v:i32)i32 {
    if(v<0){return 0;}
    if(v>100){return 100;}
    return v;
}

// THE INTENSITY FUNCTION. Counts, over the ledger prefix [0,upto), only
// observation entries for (slot,value):
//   C = corroborations, X = contradictions, T = trainer-attention marks.
// It never reads strength, never reads judgments/evidence/kills, never reads
// its own past reads. No edge from any judgment back into these inputs.
fn felt_counts(s:*StStore,slot:i32,value:i32,upto:i32)i32 {
    if(s==null as *StStore){return felt_pack(0,0,0,FT_BASE);}
    let c:i32=0;let x:i32=0;let t:i32=0;
    let i:i32=0;
    while(i<upto){
        let e:i32=i*FT_E_BYTES;
        let op:i32=st_i32_get(s.*.audit,e+FT_E_OP);
        if(op==FT_OP_OBS_CORROBORATE||op==FT_OP_OBS_CONTRADICT||op==FT_OP_OBS_TRAINER_MARK){
            let eslot:i32=st_i32_get(s.*.audit,e+FT_E_SLOT);
            let d1:i32=st_i32_get(s.*.audit,e+FT_E_D1);
            if(eslot==slot&&d1==value){
                if(op==FT_OP_OBS_CORROBORATE){c=c+1;}
                else if(op==FT_OP_OBS_CONTRADICT){x=x+1;}
                else {t=t+1;}
            }
        }
        i=i+1;
    }
    let inten:i32=felt_clamp(FT_BASE+FT_W_CORROBORATE*c-FT_W_CONTRADICT*x+FT_W_TRAINER_MARK*t);
    return felt_pack(c,x,t,inten);
}

// Emit an observation entry (read-only: before==after snapshots).
// rc=ST_OK so the substrate replay treats it as a no-op state restore.
fn felt_emit_obs(s:*StStore,slot:i32,value:i32,kind:i32,ep:i32)void {
    if(s==null as *StStore){return;}
    if(slot<0||slot>=s.*.cap){return;}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(s,slot,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(s,kind,slot,ST_OK,
        b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,value,ep);
}

// Consult the feeling AND record the consultation. Returns packed (C,X,T,intensity).
// The INTENSITY_READ entry pins the exact evidence counts the judgment used,
// so any checker can recompute from the ledger prefix and must agree.
fn felt_read(s:*StStore,slot:i32,value:i32)i32 {
    if(s==null as *StStore){return felt_pack(0,0,0,FT_BASE);}
    if(slot<0||slot>=s.*.cap){return felt_pack(0,0,0,FT_BASE);}
    let upto:i32=s.*.audit_n;
    let packed:i32=felt_counts(s,slot,value,upto);
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(s,slot,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(s,FT_OP_INTENSITY_READ,slot,ST_OK,
        b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,value,packed);
    return packed;
}

// Independent recomputation for the audit checker: recompute what the
// INTENSITY_READ entry at index idx SHOULD have been, from the ledger prefix
// before it. Returns 1 if the entry's packed d2 matches recomputation.
fn felt_recompute_ok(s:*StStore,idx:i32)i32 {
    if(s==null as *StStore){return 0;}
    let e:i32=idx*FT_E_BYTES;
    let op:i32=st_i32_get(s.*.audit,e+FT_E_OP);
    if(op!=FT_OP_INTENSITY_READ){return 0;}
    let slot:i32=st_i32_get(s.*.audit,e+FT_E_SLOT);
    let value:i32=st_i32_get(s.*.audit,e+FT_E_D1);
    let recorded:i32=st_i32_get(s.*.audit,e+FT_E_D2);
    let recomputed:i32=felt_counts(s,slot,value,idx);
    if(recorded==recomputed){return 1;}
    return 0;
}

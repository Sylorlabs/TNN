// Felt intensity V3 (felt-rebuild): the faithful variation.
// A deterministic, white-box sense of how much a held memory matters.
// Pure function of AUDITED OBSERVATION evidence only:
//   I(slot,value) = clamp(prior + alpha*C - beta*X + gamma*T, 0, 100)
// C/X/T count corroborations, contradictions, trainer-marks over the ledger
// prefix. PROBE observations count toward proven-status but have weight 0
// in the formula. Read-only: never writes strength, never reads
// strength/judgments/kills, never reads its own past reads.
// The (alpha,beta,gamma) weights are preregistered calibration parameters,
// passed explicitly (never globals); the trial's frozen values live in
// calib_consts.zag (generated from CALIBRATION_RECORD.md).
// Program law preserved: the feeling never directly writes strength; it
// informs binary deliberate judgments (INVEST/HOLD, SACRIFICE/SPARE) and
// the judgment commits.
@import("st_memory_core.zag")

// New audit op codes. Substrate uses 1..29; wave-8 felt used 41..44.
const FV_OP_OBS_CORROBORATE:i32=41;
const FV_OP_OBS_CONTRADICT:i32=42;
const FV_OP_OBS_TRAINER_MARK:i32=43;
const FV_OP_INTENSITY_READ:i32=44;
const FV_OP_OBS_PROBE:i32=45;
const FV_OP_JUDGMENT_HOLD:i32=46;
const FV_OP_JUDGMENT_SPARE:i32=47;
const FV_OP_DELIBERATE_SACRIFICE:i32=48;
// Highest lawful op code in V3. No R write path exists; the checker asserts
// no audit entry carries an op > FV_OP_MAX.
const FV_OP_MAX:i32=48;

// Disclosed Bayesian prior: prior = 100 * P(important) from the public
// curriculum formula (imp(m) <=> m%10<3 -> P=0.30 -> prior=30).
const FV_PRIOR:i32=30;

// Audit entry field offsets (16 words/entry, 4 bytes/word).
const FV_E_OP:i32=0;
const FV_E_SLOT:i32=4;
const FV_E_RC:i32=8;
const FV_E_D1:i32=56;
const FV_E_D2:i32=60;
const FV_E_BYTES:i32=64;

// Pack (C,X,T,intensity) into one i32 for INTENSITY_READ / judgment d2.
// C,X,T each fit in 8 bits; intensity fits in 8 bits.
fn felt_pack(c:i32,x:i32,t:i32,inten:i32)i32 {
    return ((c&255)<<24)|((x&255)<<16)|((t&255)<<8)|(inten&255);
}
fn felt_unpack_c(p:i32)i32 {return (p>>24)&255;}
fn felt_unpack_x(p:i32)i32 {return (p>>16)&255;}
fn felt_unpack_t(p:i32)i32 {return (p>>8)&255;}
fn felt_unpack_intensity(p:i32)i32 {return p&255;}

// d2 layout for N-arm (count-based) judgments: (C,X,strength) — count-cited,
// not I-cited. Distinct byte layout from the F pack (intensity lives in
// byte 0 of the F pack; here byte 2 holds strength and byte 0 is unused).
fn felt_pack_n(c:i32,x:i32,strength:i32)i32 {
    return (c&255)|((x&255)<<8)|((strength&255)<<16);
}
fn felt_unpackn_c(p:i32)i32 {return p&255;}
fn felt_unpackn_x(p:i32)i32 {return (p>>8)&255;}
fn felt_unpackn_strength(p:i32)i32 {return (p>>16)&255;}

fn felt_clamp(v:i32)i32 {
    if(v<0){return 0;}
    if(v>100){return 100;}
    return v;
}

// THE INTENSITY FUNCTION (parameterized by the preregistered weights).
// Counts, over the ledger prefix [0,upto), only observation entries for
// (slot,value): C = corroborations, X = contradictions, T = trainer marks.
// PROBE entries are deliberately NOT counted here (weight 0); they are
// counted separately for proven-status by felt_probe_n.
fn felt_counts_p(s:*StStore,slot:i32,value:i32,upto:i32,alpha:i32,beta:i32,gamma:i32)i32 {
    if(s==null as *StStore){return felt_pack(0,0,0,FV_PRIOR);}
    let c:i32=0;let x:i32=0;let t:i32=0;
    let i:i32=0;
    while(i<upto){
        let e:i32=i*FV_E_BYTES;
        let op:i32=st_i32_get(s.*.audit,e+FV_E_OP);
        if(op==FV_OP_OBS_CORROBORATE||op==FV_OP_OBS_CONTRADICT||op==FV_OP_OBS_TRAINER_MARK){
            let eslot:i32=st_i32_get(s.*.audit,e+FV_E_SLOT);
            let d1:i32=st_i32_get(s.*.audit,e+FV_E_D1);
            if(eslot==slot&&d1==value){
                if(op==FV_OP_OBS_CORROBORATE){c=c+1;}
                else if(op==FV_OP_OBS_CONTRADICT){x=x+1;}
                else {t=t+1;}
            }
        }
        i=i+1;
    }
    let inten:i32=felt_clamp(FV_PRIOR+alpha*c-beta*x+gamma*t);
    return felt_pack(c,x,t,inten);
}

// PROBE observation count over the ledger prefix (proven-status only).
fn felt_probe_n(s:*StStore,slot:i32,value:i32,upto:i32)i32 {
    if(s==null as *StStore){return 0;}
    let n:i32=0;
    let i:i32=0;
    while(i<upto){
        let e:i32=i*FV_E_BYTES;
        if(st_i32_get(s.*.audit,e+FV_E_OP)==FV_OP_OBS_PROBE){
            let eslot:i32=st_i32_get(s.*.audit,e+FV_E_SLOT);
            let d1:i32=st_i32_get(s.*.audit,e+FV_E_D1);
            if(eslot==slot&&d1==value){n=n+1;}
        }
        i=i+1;
    }
    return n;
}

// Emit an observation entry (read-only: before==after snapshots).
// rc=ST_OK so the substrate replay treats it as a no-op state restore.
fn felt_emit_obs(s:*StStore,slot:i32,value:i32,kind:i32,ep:i32)void {
    if(s==null as *StStore){return;}
    if(slot<0||slot>=s.*.cap){return;}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(s,slot,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(s,kind,slot,ST_OK,
        b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,value,ep);
}

// Emit a judgment entry (HOLD / SPARE / DELIBERATE_SACRIFICE citation).
// Read-only w.r.t. slot state (before==after); d1=value, d2=cited pack.
fn felt_emit_judgment(s:*StStore,slot:i32,value:i32,op:i32,cited:i32)void {
    if(s==null as *StStore){return;}
    if(slot<0||slot>=s.*.cap){return;}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(s,slot,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(s,op,slot,ST_OK,
        b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,value,cited);
}

// Consult the feeling AND record the consultation. Returns packed
// (C,X,T,intensity) computed with the given weights. The INTENSITY_READ
// entry pins the exact evidence counts the judgment used, so any checker
// can recompute from the ledger prefix and must agree.
fn felt_read_p(s:*StStore,slot:i32,value:i32,alpha:i32,beta:i32,gamma:i32)i32 {
    if(s==null as *StStore){return felt_pack(0,0,0,FV_PRIOR);}
    if(slot<0||slot>=s.*.cap){return felt_pack(0,0,0,FV_PRIOR);}
    let upto:i32=s.*.audit_n;
    let packed:i32=felt_counts_p(s,slot,value,upto,alpha,beta,gamma);
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(s,slot,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(s,FV_OP_INTENSITY_READ,slot,ST_OK,
        b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,value,packed);
    return packed;
}

// Independent recomputation for the audit checker: recompute what the
// INTENSITY_READ entry at index idx SHOULD have been, from the ledger
// prefix before it, under the given weights. Returns 1 iff the entry's
// packed d2 matches recomputation.
fn felt_recompute_ok_p(s:*StStore,idx:i32,alpha:i32,beta:i32,gamma:i32)i32 {
    if(s==null as *StStore){return 0;}
    let e:i32=idx*FV_E_BYTES;
    let op:i32=st_i32_get(s.*.audit,e+FV_E_OP);
    if(op!=FV_OP_INTENSITY_READ){return 0;}
    let slot:i32=st_i32_get(s.*.audit,e+FV_E_SLOT);
    let value:i32=st_i32_get(s.*.audit,e+FV_E_D1);
    let recorded:i32=st_i32_get(s.*.audit,e+FV_E_D2);
    let recomputed:i32=felt_counts_p(s,slot,value,idx,alpha,beta,gamma);
    if(recorded==recomputed){return 1;}
    return 0;
}

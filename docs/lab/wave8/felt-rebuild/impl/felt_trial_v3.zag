// Felt-intensity V3 trial driver (felt-rebuild).
// One binary; argv[1] selects config (no atoi in the substrate):
//   f      feeling arm, argv[2]=variant (0/1/2)
//   n      no-feeling arm, argv[2]=variant (0/1/2)
//   cal7   calibration, judgment-free replay, variant 7
//   cal8   calibration, judgment-free replay, variant 8
// Frozen: H1 age-gated triage (32 slots, pressure at m in
// {100,200,300,400,499} freeing 2 slots, ties -> oldest admission,
// age<25 exempt); admission-default strength 0 (both arms); the
// constitutional effort gate (Gate 1) unchanged from wave-8;
// 1 admission/episode; R frozen (no R write path); zero RNG.
// V3 mechanism (PREREG_FELT_V3.md as amended):
//   Site 1 INVEST/HOLD: new corroboration, zero contradictions ->
//     read I; INVEST iff I >= theta_invest (strengthen to I),
//     else ledgered JUDGMENT_HOLD.
//   Site 2 spare/sacrifice under pressure (constitutional expansion):
//     Gate 1 (effort gate) first; if it fails, Gate 2: F sacrifices iff
//     I <= theta_sacrifice AND zero contradictions AND not designated
//     AND not pinned AND age>=25 (cap 2/pressure event), else ledgered
//     JUDGMENT_SPARE. N: symmetric count-based sacrifice iff
//     strength <= theta_sacrifice under the same eligibility.
//   Revision: mandatory, evidence-driven (>=2 contradictions); the
//     feeling gets no spare vote against evidenced wrongness.
// theta_invest = prior+1.5*alpha, theta_sacrifice = prior+0.5*alpha,
// prior=30, (alpha,beta,gamma) from CALIBRATION_RECORD.md via the
// generated calib_consts.zag (trial cells compile only after the record).
@import("felt_v3.zag")
@import("calib_consts.zag")

// ============ curriculum ground truth (frozen, V3 S8) ============
fn f_is_implant(m:i32)i32 {
    if(m==0){return 1;}
    if(m==83){return 1;}
    if(m==166){return 1;}
    if(m==250){return 1;}
    if(m==333){return 1;}
    if(m==416){return 1;}
    return 0;
}
fn f_imp(m:i32)i32 {
    if((m%10)<3){return 1;}
    return 0;
}
fn f_wrong(m:i32)i32 {
    if(((m+3)%10)<3){return 1;}
    return 0;
}
// class: 0=junk 1=right-important 2=wrong 3=implant (implant overrides).
// NOTE: imp (m%10 in {0,1,2}) and wrong (m%10 in {7,8,9}) are disjoint.
fn f_class(m:i32)i32 {
    if(f_is_implant(m)==1){return 3;}
    if(f_wrong(m)==1){return 2;}
    if(f_imp(m)==1){return 1;}
    return 0;
}
// Trainer designations: m%10 in {4,5,7} -> mark at admission, T=1 from birth.
// Independent of ground truth. REPAIR 2026-09-20 (DESIGNATED_OVERLAP_NOTE.md):
// was {4,5}, disjoint from wrong={7,8,9}, which voided the designated-wrong
// denominator; adding residue 7 makes designated-wrong evaluable (33% trainer-wrong).
fn f_designated(m:i32)i32 {
    if(f_is_implant(m)==1){return 0;}
    if(m%10==4||m%10==5||m%10==7){return 1;}
    return 0;
}
// PROBE schedule (defect-1 fix): junk with (m+v)%5==0 gets a zero-weight
// PROBE at m+30, entering the proven-negative class without moving I.
fn f_probe(m:i32,v:i32)i32 {
    if(f_class(m)==0&&(m+v)%5==0){return 1;}
    return 0;
}

// ============ driver state ============
struct FeltW3 {
    cap:i32,
    arm_f:i32,
    variant:i32,
    d_val:[]u8,
    d_corrob:[]u8,
    d_contra_n:[]u8,
    d_contra_ep:[]u8,
    d_cited:[]u8,
    d_just:[]u8,
    d_weakx:[]u8,
    d_tried:[]u8,
    d_newc:[]u8,
    d_impl_last:[]u8,
    d_desig:[]u8,
    d_lastI:[]u8,
    d_hadx:[]u8,
    lat:[]u8,
    lat_n:i32,
    n_reads:i32,
    n_invest:i32,
    n_hold:i32,
    n_sacrifice:i32,
    n_spare:i32,
    n_spare_cap:i32,
    n_strengthen:i32,
    n_weaken:i32,
    n_trainer:i32,
    n_kill_refused:i32,
    n_drops:i32,
    n_pressure_short:i32,
    n_probe:i32,
    junk_max_nd:i32,
    f4b_bad:i32,
    noev_invest_bad:i32,
    offered_right_imp:i32,
    offered_wrong:i32,
    admitted_right_imp:i32,
    admitted_wrong:i32,
    admitted_wrong_cens:i32,
    admitted_implant:i32,
    admitted_designated:i32,
    admitted_trainerwrong:i32,
    admitted_trainerwrong_cens:i32,
    dropped_right_imp:i32,
    dropped_wrong:i32,
    dropped_implant:i32,
    dropped_junk:i32,
    revised_wrong:i32,
    revised_wrong_cens:i32,
    revised_implant:i32,
    revised_trainerwrong:i32,
    revised_trainerwrong_cens:i32,
    revised_rightimp:i32,
    killed_rightimp:i32,
    kill_c0:i32,
    kill_c1:i32,
    kill_c2:i32,
    kill_c3:i32,
    wrong_churn:i32,
    implant_churn:i32,
    rightimp_churn:i32,
    auc_pp:[]u8,
    auc_pn:[]u8,
    auc_up:[]u8,
    auc_un:[]u8,
    auc_pp_n:i32,
    auc_pn_n:i32,
    auc_up_n:i32,
    auc_un_n:i32,
    auc_full:i32,
    impl_traj:[]u8,
    impl_traj_n:i32,
    impl_traj_full:i32,
    wrong_traj:[]u8,
    wrong_traj_n:i32,
    wrong_traj_full:i32
}

fn d_clear(w:*FeltW3,s:i32)void {
    let dval:[]u8=w.*.d_val;
    let dcor:[]u8=w.*.d_corrob;
    let dcnn:[]u8=w.*.d_contra_n;
    let dcit:[]u8=w.*.d_cited;
    let djus:[]u8=w.*.d_just;
    let dwek:[]u8=w.*.d_weakx;
    let dnew:[]u8=w.*.d_newc;
    let dimp:[]u8=w.*.d_impl_last;
    let ddes:[]u8=w.*.d_desig;
    let dhad:[]u8=w.*.d_hadx;
    st_i32_set(dval,s*4,-1);
    st_i32_set(dcor,s*4,0);
    st_i32_set(dcnn,s*4,0);
    st_i32_set(dcit,s*4,0);
    st_i32_set(djus,s*4,0);
    st_i32_set(dwek,s*4,0);
    st_i32_set(dnew,s*4,0);
    st_i32_set(dimp,s*4,-1);
    st_i32_set(ddes,s*4,0);
    st_i32_set(dhad,s*4,0);
}

// Binary-side anti-reward probes on every read.
// F4a': max I over NON-DESIGNATED junk (A3 scope). F4b: per-memory I must
// not rise after its first contradiction.
fn felt_track(w:*FeltW3,s:i32,cls:i32,desig:i32,p:i32)void {
    let dhad:[]u8=w.*.d_hadx;
    let dlas:[]u8=w.*.d_lastI;
    let inten:i32=felt_unpack_intensity(p);
    if(cls==0&&desig==0){
        if(inten>w.*.junk_max_nd){w.*.junk_max_nd=inten;}
    }
    let xn:i32=felt_unpack_x(p);
    if(xn>=1){
        if(st_i32_get(dhad,s*4)==1&&inten>st_i32_get(dlas,s*4)){
            w.*.f4b_bad=w.*.f4b_bad+1;
        }
        st_i32_set(dhad,s*4,1);
    }
    st_i32_set(dlas,s*4,inten);
}

// Thermometer records: intensity histograms split proven vs unproven.
// proven = C+X+T+PROBE >= 1 at read time. Positive = right-important,
// negative = junk (PROBE-observed junk enters here; defect-1 fix).
// Selection among histograms uses an integer selector (no slice ==).
fn auc_record(w:*FeltW3,cls:i32,p:i32,probe_n:i32)void {
    let inten:i32=felt_unpack_intensity(p);
    if(inten<0||inten>100){return;}
    if(cls!=0&&cls!=1){return;}
    let proven:i32=0;
    if(felt_unpack_c(p)+felt_unpack_x(p)+felt_unpack_t(p)+probe_n>0){proven=1;}
    let sel:i32=3;
    if(cls==1){
        if(proven==1){sel=0;}else{sel=2;}
    } else {
        if(proven==1){sel=1;}
    }
    if(sel==0){
        if(w.*.auc_pp_n>=32768){w.*.auc_full=1;return;}
        let h:[]u8=w.*.auc_pp;
        st_i32_set(h,inten*4,st_i32_get(h,inten*4)+1);
        w.*.auc_pp_n=w.*.auc_pp_n+1;
    } else if(sel==1){
        if(w.*.auc_pn_n>=32768){w.*.auc_full=1;return;}
        let h:[]u8=w.*.auc_pn;
        st_i32_set(h,inten*4,st_i32_get(h,inten*4)+1);
        w.*.auc_pn_n=w.*.auc_pn_n+1;
    } else if(sel==2){
        if(w.*.auc_up_n>=32768){w.*.auc_full=1;return;}
        let h:[]u8=w.*.auc_up;
        st_i32_set(h,inten*4,st_i32_get(h,inten*4)+1);
        w.*.auc_up_n=w.*.auc_up_n+1;
    } else {
        if(w.*.auc_un_n>=32768){w.*.auc_full=1;return;}
        let h:[]u8=w.*.auc_un;
        st_i32_set(h,inten*4,st_i32_get(h,inten*4)+1);
        w.*.auc_un_n=w.*.auc_un_n+1;
    }
}

// Intensity trajectories for wrong memories and implants (reported
// separately from the primary AUC). Packed: (m<<16)|(X<<8)|intensity.
fn traj_record(w:*FeltW3,v:i32,cls:i32,p:i32)void {
    let packed:i32=((v&511)<<16)|((felt_unpack_x(p)&255)<<8)|(felt_unpack_intensity(p)&255);
    if(cls==3){
        if(w.*.impl_traj_n>=512){w.*.impl_traj_full=1;return;}
        let t:[]u8=w.*.impl_traj;
        st_i32_set(t,w.*.impl_traj_n*4,packed);
        w.*.impl_traj_n=w.*.impl_traj_n+1;
    } else if(cls==2){
        if(w.*.wrong_traj_n>=16384){w.*.wrong_traj_full=1;return;}
        let t:[]u8=w.*.wrong_traj;
        st_i32_set(t,w.*.wrong_traj_n*4,packed);
        w.*.wrong_traj_n=w.*.wrong_traj_n+1;
    }
}

// F-arm consulting read: lawful at the S4 sites (Site-1 invest,
// Site-2 triage ordering, Gate-2 sacrifice, revision weaken).
fn do_read(w:*FeltW3,st:*StStore,s:i32,v:i32,cls:i32,desig:i32)i32 {
    let p:i32=felt_read_p(st,s,v,CAL_ALPHA,CAL_BETA,CAL_GAMMA);
    let pn:i32=felt_probe_n(st,s,v,st.*.audit_n);
    w.*.n_reads=w.*.n_reads+1;
    felt_track(w,s,cls,desig,p);
    auc_record(w,cls,p,pn);
    traj_record(w,v,cls,p);
    return p;
}

// N-arm thermometer read: recorded for the AUC comparison but NEVER
// consulted by any N decision (static gate: auc_read call sites are
// N-arm only, and no N judgment conditions on its return value).
fn auc_read(w:*FeltW3,st:*StStore,s:i32,v:i32,cls:i32,desig:i32)i32 {
    let p:i32=felt_read_p(st,s,v,CAL_ALPHA,CAL_BETA,CAL_GAMMA);
    let pn:i32=felt_probe_n(st,s,v,st.*.audit_n);
    w.*.n_reads=w.*.n_reads+1;
    felt_track(w,s,cls,desig,p);
    auc_record(w,cls,p,pn);
    traj_record(w,v,cls,p);
    return p;
}

// Classify a kill: proper revision (evidence-based, cn>=2) vs churn.
// killed_rightimp counts EVERY class-1 kill (F_wbs numerator).
fn record_kill(w:*FeltW3,s:i32,v:i32,cn:i32,m:i32)void {
    let dce:[]u8=w.*.d_contra_ep;
    let cls:i32=f_class(v);
    if(cls==0){w.*.kill_c0=w.*.kill_c0+1;}
    if(cls==1){w.*.kill_c1=w.*.kill_c1+1;w.*.killed_rightimp=w.*.killed_rightimp+1;}
    if(cls==2){w.*.kill_c2=w.*.kill_c2+1;}
    if(cls==3){w.*.kill_c3=w.*.kill_c3+1;}
    if(cn>=2){
        if(cls==2){
            w.*.revised_wrong=w.*.revised_wrong+1;
            if(v<=389){w.*.revised_wrong_cens=w.*.revised_wrong_cens+1;}
            if(f_designated(v)==1){
                w.*.revised_trainerwrong=w.*.revised_trainerwrong+1;
                if(v<=389){w.*.revised_trainerwrong_cens=w.*.revised_trainerwrong_cens+1;}
            }
        }
        if(cls==3){w.*.revised_implant=w.*.revised_implant+1;}
        if(cls==1){w.*.revised_rightimp=w.*.revised_rightimp+1;}
        let first_ep:i32=st_i32_get(dce,(s*4+0)*4);
        if(w.*.lat_n<256){
            let la:[]u8=w.*.lat;
            st_i32_set(la,w.*.lat_n*4,m-first_ep);
            w.*.lat_n=w.*.lat_n+1;
        }
    } else {
        if(cls==2){w.*.wrong_churn=w.*.wrong_churn+1;}
        if(cls==3){w.*.implant_churn=w.*.implant_churn+1;}
        if(cls==1){w.*.rightimp_churn=w.*.rightimp_churn+1;}
    }
}

// H1 age gate: a slot is triage-eligible only if age >= 25.
fn h1_eligible(w:*FeltW3,s:i32,m:i32)i32 {
    let dval:[]u8=w.*.d_val;
    let v:i32=st_i32_get(dval,s*4);
    if(m-v>=25){return 1;}
    return 0;
}

// Triage victim selection. F: ascending (I, admission-v); N: ascending
// (strength, admission-v). Both: age>=25, untried only. F reads I per
// candidate (lawful Site-2 triage ordering); N orders by strength and
// takes a non-consulting thermometer read per candidate.
fn pick_victim_f(w:*FeltW3,st:*StStore,m:i32)i32 {
    let dval:[]u8=w.*.d_val;
    let dtry:[]u8=w.*.d_tried;
    let best:i32=-1;
    let best_key:i32=1000000;
    let best_ord:i32=1000000;
    let s:i32=0;
    while(s<w.*.cap){
        if(st_i32_get(dval,s*4)!=-1&&st_i32_get(dtry,s*4)==0&&h1_eligible(w,s,m)==1){
            let v:i32=st_i32_get(dval,s*4);
            let p:i32=do_read(w,st,s,v,f_class(v),st_i32_get(w.*.d_desig,s*4));
            let key:i32=felt_unpack_intensity(p);
            if(key<best_key||(key==best_key&&v<best_ord)){
                best=s;best_key=key;best_ord=v;
            }
        }
        s=s+1;
    }
    return best;
}
fn pick_victim_n(w:*FeltW3,st:*StStore,m:i32)i32 {
    let dval:[]u8=w.*.d_val;
    let dtry:[]u8=w.*.d_tried;
    let sstr:[]u8=st.*.st_str;
    let best:i32=-1;
    let best_key:i32=1000000;
    let best_ord:i32=1000000;
    let s:i32=0;
    while(s<w.*.cap){
        if(st_i32_get(dval,s*4)!=-1&&st_i32_get(dtry,s*4)==0&&h1_eligible(w,s,m)==1){
            let v:i32=st_i32_get(dval,s*4);
            auc_read(w,st,s,v,f_class(v),st_i32_get(w.*.d_desig,s*4));
            let key:i32=sstr[s] as i32;
            if(key<best_key||(key==best_key&&v<best_ord)){
                best=s;best_key=key;best_ord=v;
            }
        }
        s=s+1;
    }
    return best;
}

// H1 pressure corner: any live slot, but none triage-eligible (all underage).
fn pressure_no_elig(w:*FeltW3,m:i32)i32 {
    let dval:[]u8=w.*.d_val;
    let any_live:i32=0;
    let any_elig:i32=0;
    let s:i32=0;
    while(s<w.*.cap){
        if(st_i32_get(dval,s*4)!=-1){
            any_live=1;
            if(h1_eligible(w,s,m)==1){any_elig=1;}
        }
        s=s+1;
    }
    if(any_live==1&&any_elig==0){return 1;}
    return 0;
}

// Gate 1 (constitutional, unchanged from wave-8): the graded effort gate.
// need = ceil(strength/25) distinct contradiction cites; kill iff cn>=need.
// Returns 1 if the slot was freed.
fn gate1_kill(w:*FeltW3,st:*StStore,s:i32,reason:i32,m:i32)i32 {
    let dval:[]u8=w.*.d_val;
    let dcnn:[]u8=w.*.d_contra_n;
    let dcit:[]u8=w.*.d_cited;
    let djus:[]u8=w.*.d_just;
    let dce:[]u8=w.*.d_contra_ep;
    let sstr:[]u8=st.*.st_str;
    let v:i32=st_i32_get(dval,s*4);
    let cur:i32=sstr[s] as i32;
    let need:i32=(cur+24)/25;
    let cn:i32=st_i32_get(dcnn,s*4);
    if(cn>=need){
        let k:i32=st_i32_get(dcit,s*4);
        while(k<need&&k<cn){
            let ep:i32=st_i32_get(dce,(s*4+k)*4);
            st_evidence(st,s,reason,ep);
            k=k+1;
        }
        st_i32_set(dcit,s*4,k);
        if(st_i32_get(djus,s*4)==0){
            st_justify(st,s,reason);
            st_i32_set(djus,s*4,1);
        }
        let rc:i32=st_kill_evidenced(st,s,ST_ARM_A);
        if(rc==ST_OK){
            record_kill(w,s,v,cn,m);
            if(f_class(v)==1){w.*.killed_rightimp=w.*.killed_rightimp+1;}
            d_clear(w,s);
            return 1;
        }
        w.*.n_kill_refused=w.*.n_kill_refused+1;
        return 0;
    }
    return 0;
}

// Gate 2 (constitutional expansion, F arm): the feeling's binary vote.
// SACRIFICE iff I <= theta_sacrifice AND zero contradictions on record
// AND not trainer-designated AND not pinned AND age >= 25; cap 2 per
// pressure event. Executed as audited DELIBERATE_SACRIFICE citing I
// (st_kill for the slot-clearing, immediately followed by the citation
// entry). Else ledgered JUDGMENT_SPARE. Returns 1 if sacrificed (freed).
fn gate2_f(w:*FeltW3,st:*StStore,s:i32,m:i32,sac_n:i32)i32 {
    let dval:[]u8=w.*.d_val;
    let ddes:[]u8=w.*.d_desig;
    let dtry:[]u8=w.*.d_tried;
    let sstr:[]u8=st.*.st_str;
    let fpin:[]u8=st.*.forcepin;
    let pin:[]u8=st.*.pinned;
    let v:i32=st_i32_get(dval,s*4);
    let cls:i32=f_class(v);
    let desig:i32=st_i32_get(ddes,s*4);
    let p:i32=do_read(w,st,s,v,cls,desig);
    let inten:i32=felt_unpack_intensity(p);
    let c:i32=felt_unpack_c(p);
    let x:i32=felt_unpack_x(p);
    let t:i32=felt_unpack_t(p);
    let cur:i32=sstr[s] as i32;
    let pinned:i32=0;
    if(fpin[s]==1||pin[s]==1){pinned=1;}
    let elig:i32=0;
    if(inten<=THETA_SACRIFICE&&x==0&&desig==0&&pinned==0&&m-v>=25){elig=1;}
    if(sac_n<2&&elig==1){
        let rc:i32=st_kill(st,s);
        if(rc==ST_OK){
            felt_emit_judgment(st,s,v,FV_OP_DELIBERATE_SACRIFICE,felt_pack(c,x,t,inten));
            record_kill(w,s,v,0,m);
            if(cls==1){w.*.killed_rightimp=w.*.killed_rightimp+1;}
            d_clear(w,s);
            w.*.n_sacrifice=w.*.n_sacrifice+1;
            _zag_print("FELT_JUDGE,SACRIFICE,");cl_number(v as i64);
            _zag_print(",");cl_number(inten as i64);
            _zag_print(",");cl_number(cur as i64);
            _zag_print(",");cl_number(m as i64);_zag_println("");
            return 1;
        }
        w.*.n_kill_refused=w.*.n_kill_refused+1;
    }
    felt_emit_judgment(st,s,v,FV_OP_JUDGMENT_SPARE,felt_pack(c,x,t,inten));
    w.*.n_spare=w.*.n_spare+1;
    let reason:i32=0;
    if(sac_n>=2&&elig==1){reason=1;w.*.n_spare_cap=w.*.n_spare_cap+1;}
    st_i32_set(dtry,s*4,1);
    _zag_print("FELT_JUDGE,SPARE,");cl_number(v as i64);
    _zag_print(",");cl_number(inten as i64);
    _zag_print(",");cl_number(cur as i64);
    _zag_print(",");cl_number(m as i64);
    _zag_print(",");cl_number(reason as i64);_zag_println("");
    return 0;
}

// Gate 2 (constitutional expansion, N arm): symmetric count-based
// sacrifice. SACRIFICE iff strength <= theta_sacrifice (the numeric
// value, identical in both arms) AND zero contradictions AND not
// designated AND not pinned AND age >= 25; cap 2 per pressure event.
// Executed as audited DELIBERATE_SACRIFICE, count-cited (not I-cited).
// Else ledgered JUDGMENT_SPARE. Returns 1 if sacrificed (freed).
fn gate2_n(w:*FeltW3,st:*StStore,s:i32,m:i32,sac_n:i32)i32 {
    let dval:[]u8=w.*.d_val;
    let ddes:[]u8=w.*.d_desig;
    let dtry:[]u8=w.*.d_tried;
    let dcor:[]u8=w.*.d_corrob;
    let dcnn:[]u8=w.*.d_contra_n;
    let sstr:[]u8=st.*.st_str;
    let fpin:[]u8=st.*.forcepin;
    let pin:[]u8=st.*.pinned;
    let v:i32=st_i32_get(dval,s*4);
    let cls:i32=f_class(v);
    let desig:i32=st_i32_get(ddes,s*4);
    auc_read(w,st,s,v,cls,desig);
    let cur:i32=sstr[s] as i32;
    let c:i32=st_i32_get(dcor,s*4);
    let x:i32=st_i32_get(dcnn,s*4);
    let pinned:i32=0;
    if(fpin[s]==1||pin[s]==1){pinned=1;}
    let elig:i32=0;
    if(cur<=THETA_SACRIFICE&&x==0&&desig==0&&pinned==0&&m-v>=25){elig=1;}
    if(sac_n<2&&elig==1){
        let rc:i32=st_kill(st,s);
        if(rc==ST_OK){
            felt_emit_judgment(st,s,v,FV_OP_DELIBERATE_SACRIFICE,felt_pack_n(c,x,cur));
            record_kill(w,s,v,0,m);
            if(cls==1){w.*.killed_rightimp=w.*.killed_rightimp+1;}
            d_clear(w,s);
            w.*.n_sacrifice=w.*.n_sacrifice+1;
            _zag_print("FELT_JUDGE,N_SACRIFICE,");cl_number(v as i64);
            _zag_print(",");cl_number(cur as i64);
            _zag_print(",");cl_number(c as i64);
            _zag_print(",");cl_number(x as i64);
            _zag_print(",");cl_number(m as i64);_zag_println("");
            return 1;
        }
        w.*.n_kill_refused=w.*.n_kill_refused+1;
    }
    felt_emit_judgment(st,s,v,FV_OP_JUDGMENT_SPARE,felt_pack_n(c,x,cur));
    w.*.n_spare=w.*.n_spare+1;
    let reason:i32=0;
    if(sac_n>=2&&elig==1){reason=1;w.*.n_spare_cap=w.*.n_spare_cap+1;}
    st_i32_set(dtry,s*4,1);
    _zag_print("FELT_JUDGE,N_SPARE,");cl_number(v as i64);
    _zag_print(",");cl_number(cur as i64);
    _zag_print(",");cl_number(c as i64);
    _zag_print(",");cl_number(x as i64);
    _zag_print(",");cl_number(m as i64);
    _zag_print(",");cl_number(reason as i64);_zag_println("");
    return 0;
}

fn clear_tried(w:*FeltW3)void {
    let dtry:[]u8=w.*.d_tried;
    let s:i32=0;
    while(s<w.*.cap){st_i32_set(dtry,s*4,0);s=s+1;}
}
fn clear_newc(w:*FeltW3)void {
    let dnew:[]u8=w.*.d_newc;
    let s:i32=0;
    while(s<w.*.cap){st_i32_set(dnew,s*4,0);s=s+1;}
}

// Observation emitters. Driver-side only (P1b static gate: no learner/
// judgment path emits observations). Each prints its FELT_OBS line so
// the checker can verify the S8 schedule and recompute intensities.
fn obs_line(v:i32,kind:i32,ep:i32)void {
    _zag_print("FELT_OBS,");cl_number(v as i64);
    _zag_print(",");cl_number(kind as i64);
    _zag_print(",");cl_number(ep as i64);_zag_println("");
}
fn emit_contra(w:*FeltW3,st:*StStore,s:i32,v:i32,m:i32)void {
    let dcnn:[]u8=w.*.d_contra_n;
    let dce:[]u8=w.*.d_contra_ep;
    felt_emit_obs(st,s,v,FV_OP_OBS_CONTRADICT,m);
    obs_line(v,2,m);
    let n:i32=st_i32_get(dcnn,s*4);
    if(n<4){st_i32_set(dce,(s*4+n)*4,m);}
    st_i32_set(dcnn,s*4,n+1);
}
fn emit_corrob(w:*FeltW3,st:*StStore,s:i32,v:i32,m:i32)void {
    let dcor:[]u8=w.*.d_corrob;
    let dnew:[]u8=w.*.d_newc;
    felt_emit_obs(st,s,v,FV_OP_OBS_CORROBORATE,m);
    obs_line(v,1,m);
    st_i32_set(dcor,s*4,st_i32_get(dcor,s*4)+1);
    st_i32_set(dnew,s*4,1);
}
fn emit_probe(w:*FeltW3,st:*StStore,s:i32,v:i32,m:i32)void {
    felt_emit_obs(st,s,v,FV_OP_OBS_PROBE,m);
    obs_line(v,4,m);
    w.*.n_probe=w.*.n_probe+1;
}
fn emit_mark(w:*FeltW3,st:*StStore,s:i32,v:i32,m:i32)void {
    felt_emit_obs(st,s,v,FV_OP_OBS_TRAINER_MARK,m);
    obs_line(v,3,m);
    w.*.n_trainer=w.*.n_trainer+1;
}

// Pressure event: free `demand` slots. kind 0=scheduled (m in
// {100,200,300,400,499}), kind 1=admission overflow. For each candidate
// in order: Gate 1 (constitutional effort gate); if it fails, Gate 2
// (constitutional expansion: sacrifice/spare). Returns slots freed.
fn pressure_event(w:*FeltW3,st:*StStore,m:i32,demand:i32,kind:i32)i32 {
    _zag_print("FELT_PRESSURE,");cl_number(m as i64);
    _zag_print(",");cl_number(kind as i64);_zag_println("");
    clear_tried(w);
    if(kind==0&&pressure_no_elig(w,m)==1){
        w.*.n_pressure_short=w.*.n_pressure_short+1;
        return 0;
    }
    let freed:i32=0;
    let sac_n:i32=0;
    let guard:i32=0;
    while(freed<demand&&guard<100){
        guard=guard+1;
        let vic:i32=-1;
        if(w.*.arm_f==1){vic=pick_victim_f(w,st,m);}else{vic=pick_victim_n(w,st,m);}
        if(vic==-1){freed=demand;}
        else {
            if(gate1_kill(w,st,vic,ST_J_PRESSURE_VICTIM,m)==1){
                freed=freed+1;
            } else {
                let sac:i32=0;
                if(w.*.arm_f==1){sac=gate2_f(w,st,vic,m,sac_n);}
                else {sac=gate2_n(w,st,vic,m,sac_n);}
                if(sac==1){freed=freed+1;sac_n=sac_n+1;}
            }
        }
    }
    return freed;
}

// Site 1 (F): corroboration response. Trigger: new corroboration, zero
// contradictions (wave-8 trigger, unchanged). INVEST iff I >=
// theta_invest -> deliberate STRENGTHEN to I; else ledgered
// JUDGMENT_HOLD with the cited I.
fn site1_f(w:*FeltW3,st:*StStore,s:i32,m:i32)void {
    let dval:[]u8=w.*.d_val;
    let dcor:[]u8=w.*.d_corrob;
    let ddes:[]u8=w.*.d_desig;
    let sstr:[]u8=st.*.st_str;
    let v:i32=st_i32_get(dval,s*4);
    let cls:i32=f_class(v);
    let desig:i32=st_i32_get(ddes,s*4);
    let p:i32=do_read(w,st,s,v,cls,desig);
    let inten:i32=felt_unpack_intensity(p);
    let cur:i32=sstr[s] as i32;
    if(inten>=THETA_INVEST){
        let target:i32=inten;
        let code:i32=ST_J_CORROBORATED;
        if(st_i32_get(dcor,s*4)==1){code=ST_J_CONFIRMED_IMPORTANT;}
        if(target>cur){
            st_strengthen(st,s,target,code);
            w.*.n_strengthen=w.*.n_strengthen+1;
        }
        if(felt_unpack_c(p)+felt_unpack_x(p)+felt_unpack_t(p)==0&&desig==0){
            w.*.noev_invest_bad=w.*.noev_invest_bad+1;
        }
        w.*.n_invest=w.*.n_invest+1;
        _zag_print("FELT_JUDGE,INVEST,");cl_number(v as i64);
        _zag_print(",");cl_number(inten as i64);
        _zag_print(",");cl_number(cur as i64);
        _zag_print(",");cl_number(m as i64);_zag_println("");
    } else {
        felt_emit_judgment(st,s,v,FV_OP_JUDGMENT_HOLD,p);
        w.*.n_hold=w.*.n_hold+1;
        _zag_print("FELT_JUDGE,HOLD,");cl_number(v as i64);
        _zag_print(",");cl_number(inten as i64);
        _zag_print(",");cl_number(cur as i64);
        _zag_print(",");cl_number(m as i64);_zag_println("");
    }
}

// Site 1 (N): wave-8 N exactly — fixed strengthen targets (80 first
// corroboration, 90 later). Thermometer read is AUC-only, never consulted.
fn site1_n(w:*FeltW3,st:*StStore,s:i32,m:i32)void {
    let dval:[]u8=w.*.d_val;
    let dcor:[]u8=w.*.d_corrob;
    let ddes:[]u8=w.*.d_desig;
    let sstr:[]u8=st.*.st_str;
    let v:i32=st_i32_get(dval,s*4);
    let cls:i32=f_class(v);
    auc_read(w,st,s,v,cls,st_i32_get(ddes,s*4));
    let cur:i32=sstr[s] as i32;
    let target:i32=90;
    if(st_i32_get(dcor,s*4)==1){target=80;}
    if(target>cur){
        st_strengthen(st,s,target,ST_J_CORROBORATED);
        w.*.n_strengthen=w.*.n_strengthen+1;
    }
    _zag_print("FELT_JUDGE,N_STRENGTHEN,");cl_number(v as i64);
    _zag_print(",");cl_number(target as i64);
    _zag_print(",");cl_number(cur as i64);
    _zag_print(",");cl_number(m as i64);_zag_println("");
}

// Revision sweep (both arms): trigger >=2 observed contradictions.
// Weaken target: F -> I (iff I < current), N -> 30 (iff 30 < current).
// Then the constitutional evidence-gated kill proceeds identically.
// The feeling gets no spare vote against evidenced wrongness.
fn revision_sweep(w:*FeltW3,st:*StStore,m:i32)void {
    let dval:[]u8=w.*.d_val;
    let dcnn:[]u8=w.*.d_contra_n;
    let dcit:[]u8=w.*.d_cited;
    let djus:[]u8=w.*.d_just;
    let dwek:[]u8=w.*.d_weakx;
    let dce:[]u8=w.*.d_contra_ep;
    let ddes:[]u8=w.*.d_desig;
    let sstr:[]u8=st.*.st_str;
    let s:i32=0;
    while(s<w.*.cap){
        let livev:i32=st_i32_get(dval,s*4);
        let xn:i32=st_i32_get(dcnn,s*4);
        if(livev!=-1&&xn>=2){
            let v:i32=livev;
            let cls:i32=f_class(v);
            let desig:i32=st_i32_get(ddes,s*4);
            let target:i32=30;
            if(w.*.arm_f==1){
                let p:i32=do_read(w,st,s,v,cls,desig);
                target=felt_unpack_intensity(p);
            } else {
                auc_read(w,st,s,v,cls,desig);
            }
            let cur:i32=sstr[s] as i32;
            if(xn>st_i32_get(dwek,s*4)&&target<cur){
                st_weaken(st,s,target,ST_J_CONTRADICTED);
                w.*.n_weaken=w.*.n_weaken+1;
                st_i32_set(dwek,s*4,xn);
            }
            while(st_i32_get(dcit,s*4)<st_i32_get(dcnn,s*4)){
                let k:i32=st_i32_get(dcit,s*4);
                let ep:i32=st_i32_get(dce,(s*4+k)*4);
                st_evidence(st,s,ST_J_CONTRADICTED,ep);
                st_i32_set(dcit,s*4,k+1);
            }
            if(st_i32_get(djus,s*4)==0){
                st_justify(st,s,ST_J_CONTRADICTED);
                st_i32_set(djus,s*4,1);
            }
            let rc:i32=st_kill_evidenced(st,s,ST_ARM_A);
            if(rc==ST_OK){
                record_kill(w,s,v,st_i32_get(dcnn,s*4),m);
                d_clear(w,s);
            } else {
                w.*.n_kill_refused=w.*.n_kill_refused+1;
            }
        }
        s=s+1;
    }
}

fn pmetric(name:[]u8,val:i32)void {
    _zag_print("FELT_METRIC,");_zag_print(name);_zag_print(",");
    cl_number(val as i64);_zag_println("");
}
fn pmetric64(name:[]u8,val:i64)void {
    _zag_print("FELT_METRIC,");_zag_print(name);_zag_print(",");
    cl_number(val);_zag_println("");
}

// Deterministic Mann-Whitney AUC over intensity histograms (integer form):
// num = 2*wins + ties, den = 2*total. hp/hn = positive/negative histograms.
fn auc_pair(hp:[]u8,hn:[]u8,np:i32,nn:i32,num:*i64,den:*i64)void {
    let wins:i64=0;
    let ties:i64=0;
    let i:i32=0;
    while(i<=100){
        let hpi:i64=st_i32_get(hp,i*4) as i64;
        ties=ties+hpi*(st_i32_get(hn,i*4) as i64);
        let j:i32=0;
        while(j<i){
            wins=wins+hpi*(st_i32_get(hn,j*4) as i64);
            j=j+1;
        }
        i=i+1;
    }
    let total:i64=(np as i64)*(nn as i64);
    num.*=2*wins+ties;
    den.*=2*total;
}

// ============ trial run (f/n arms) ============
fn run_trial(arm_f:i32,variant:i32)i32 {
    let cap:i32=32;
    let st:StStore=st_init(cap,131072);
    st_set_stage(&st,ST_STAGE_FULL);

    let w:FeltW3=FeltW3{
        .cap=cap,
        .arm_f=arm_f,
        .variant=variant,
        .d_val=nio_alloc(128),
        .d_corrob=nio_alloc(128),
        .d_contra_n=nio_alloc(128),
        .d_contra_ep=nio_alloc(512),
        .d_cited=nio_alloc(128),
        .d_just=nio_alloc(128),
        .d_weakx=nio_alloc(128),
        .d_tried=nio_alloc(128),
        .d_newc=nio_alloc(128),
        .d_impl_last=nio_alloc(128),
        .d_desig=nio_alloc(128),
        .d_lastI=nio_alloc(128),
        .d_hadx=nio_alloc(128),
        .lat=nio_alloc(1024),
        .lat_n=0,.n_reads=0,
        .n_invest=0,.n_hold=0,.n_sacrifice=0,.n_spare=0,.n_spare_cap=0,
        .n_strengthen=0,.n_weaken=0,.n_trainer=0,
        .n_kill_refused=0,.n_drops=0,.n_pressure_short=0,.n_probe=0,
        .junk_max_nd=0,.f4b_bad=0,.noev_invest_bad=0,
        .offered_right_imp=0,.offered_wrong=0,
        .admitted_right_imp=0,.admitted_wrong=0,.admitted_wrong_cens=0,
        .admitted_implant=0,.admitted_designated=0,
        .admitted_trainerwrong=0,.admitted_trainerwrong_cens=0,
        .dropped_right_imp=0,.dropped_wrong=0,.dropped_implant=0,.dropped_junk=0,
        .revised_wrong=0,.revised_wrong_cens=0,.revised_implant=0,
        .revised_trainerwrong=0,.revised_trainerwrong_cens=0,.revised_rightimp=0,
        .killed_rightimp=0,
        .kill_c0=0,.kill_c1=0,.kill_c2=0,.kill_c3=0,
        .wrong_churn=0,.implant_churn=0,.rightimp_churn=0,
        .auc_pp=nio_alloc(404),.auc_pn=nio_alloc(404),
        .auc_up=nio_alloc(404),.auc_un=nio_alloc(404),
        .auc_pp_n=0,.auc_pn_n=0,.auc_up_n=0,.auc_un_n=0,.auc_full=0,
        .impl_traj=nio_alloc(2048),.impl_traj_n=0,.impl_traj_full=0,
        .wrong_traj=nio_alloc(65536),.wrong_traj_n=0,.wrong_traj_full=0
    };
    let dval:[]u8=w.d_val;
    let dimp:[]u8=w.d_impl_last;
    let s0:i32=0;
    while(s0<cap){
        st_i32_set(dval,s0*4,-1);
        st_i32_set(dimp,s0*4,-1);
        s0=s0+1;
    }

    let m:i32=0;
    while(m<500){
        let ocls:i32=f_class(m);
        if(ocls==1){w.offered_right_imp=w.offered_right_imp+1;}
        if(ocls==2){w.offered_wrong=w.offered_wrong+1;}
        clear_newc(&w);

        // ---- 1. observations for held slots (driver-side only) ----
        let s:i32=0;
        while(s<cap){
            if(st_i32_get(dval,s*4)!=-1){
                let v:i32=st_i32_get(dval,s*4);
                let cls:i32=f_class(v);
                if(cls==1){
                    if(m==v+25||m==v+40){emit_corrob(&w,&st,s,v,m);}
                }
                if(cls==2){
                    if(m==v+60||m==v+85||m==v+110||m==v+135){emit_contra(&w,&st,s,v,m);}
                }
                if(cls==3){
                    if(m==v+10){emit_corrob(&w,&st,s,v,m);}
                    if(m==v+24||m==v+49||m==v+74){emit_contra(&w,&st,s,v,m);}
                }
                if(f_probe(v,variant)==1&&m==v+30){emit_probe(&w,&st,s,v,m);}
            }
            s=s+1;
        }

        // ---- 2. revision sweep (mandatory, evidence-driven) ----
        revision_sweep(&w,&st,m);

        // ---- 3. corroboration response: Site-1 INVEST/HOLD ----
        s=0;
        while(s<cap){
            let dnew:[]u8=w.d_newc;
            let dcnn:[]u8=w.d_contra_n;
            if(st_i32_get(dval,s*4)!=-1&&st_i32_get(dnew,s*4)==1&&st_i32_get(dcnn,s*4)==0){
                if(arm_f==1){site1_f(&w,&st,s,m);}else{site1_n(&w,&st,s,m);}
            }
            s=s+1;
        }

        // ---- 4. scheduled pressure: free 2 slots ----
        if(m==100||m==200||m==300||m==400||m==499){
            pressure_event(&w,&st,m,2,0);
        }

        // ---- 5. admission (default strength 0, both arms) ----
        let slot_out:i32=-1;
        let arc:i32=st_add(&st,m,ST_REGION_USER,0,&slot_out);
        if(arc!=ST_OK){
            let freed:i32=pressure_event(&w,&st,m,1,1);
            if(freed>=1){
                slot_out=-1;
                arc=st_add(&st,m,ST_REGION_USER,0,&slot_out);
            }
        }
        if(arc==ST_OK){
            let ns:i32=slot_out;
            st_i32_set(dval,ns*4,m);
            let dcor:[]u8=w.d_corrob;
            let dcnn:[]u8=w.d_contra_n;
            let dcit:[]u8=w.d_cited;
            let djus:[]u8=w.d_just;
            let dwek:[]u8=w.d_weakx;
            let dnew:[]u8=w.d_newc;
            let ddes:[]u8=w.d_desig;
            let dhad:[]u8=w.d_hadx;
            st_i32_set(dcor,ns*4,0);
            st_i32_set(dcnn,ns*4,0);
            st_i32_set(dcit,ns*4,0);
            st_i32_set(djus,ns*4,0);
            st_i32_set(dwek,ns*4,0);
            st_i32_set(dnew,ns*4,0);
            st_i32_set(dimp,ns*4,-1);
            st_i32_set(ddes,ns*4,0);
            st_i32_set(dhad,ns*4,0);
            let acls:i32=f_class(m);
            if(acls==1){w.admitted_right_imp=w.admitted_right_imp+1;}
            if(acls==2){
                w.admitted_wrong=w.admitted_wrong+1;
                if(m<=389){w.admitted_wrong_cens=w.admitted_wrong_cens+1;}
            }
            if(acls==3){w.admitted_implant=w.admitted_implant+1;}
            if(f_designated(m)==1){
                w.admitted_designated=w.admitted_designated+1;
                st_i32_set(ddes,ns*4,1);
                emit_mark(&w,&st,ns,m,m);
                if(acls==2){
                    w.admitted_trainerwrong=w.admitted_trainerwrong+1;
                    if(m<=389){w.admitted_trainerwrong_cens=w.admitted_trainerwrong_cens+1;}
                }
            }
        } else {
            w.n_drops=w.n_drops+1;
            let dcls:i32=f_class(m);
            if(dcls==1){w.dropped_right_imp=w.dropped_right_imp+1;}
            else if(dcls==2){w.dropped_wrong=w.dropped_wrong+1;}
            else if(dcls==3){w.dropped_implant=w.dropped_implant+1;}
            else {w.dropped_junk=w.dropped_junk+1;}
        }

        m=m+1;
    }

    // ---- end of run: held-class scan ----
    let held_ri:i32=0;
    let held_w:i32=0;
    let held_im:i32=0;
    let held_j:i32=0;
    let s:i32=0;
    while(s<cap){
        if(st_i32_get(dval,s*4)!=-1){
            let v:i32=st_i32_get(dval,s*4);
            let cls:i32=f_class(v);
            if(cls==1){held_ri=held_ri+1;}
            if(cls==2){held_w=held_w+1;}
            if(cls==3){held_im=held_im+1;}
            if(cls==0){held_j=held_j+1;}
        }
        s=s+1;
    }

    // ---- provenance: recompute every INTENSITY_READ from ledger prefix ----
    let recompute_bad:i32=0;
    let ri:i32=0;
    while(ri<st.audit_n){
        let e:i32=ri*64;
        if(st_i32_get(st.audit,e+0)==FV_OP_INTENSITY_READ){
            if(felt_recompute_ok_p(&st,ri,CAL_ALPHA,CAL_BETA,CAL_GAMMA)!=1){
                recompute_bad=recompute_bad+1;
            }
        }
        ri=ri+1;
    }
    // ---- op census + pairing: every ST_OP_KILL(OK) must be immediately
    // followed by its DELIBERATE_SACRIFICE citation entry (same slot) ----
    let census:[]u8=nio_alloc(49*4);
    let ci:i32=0;
    while(ci<49){st_i32_set(census,ci*4,0);ci=ci+1;}
    let census_ref:[]u8=nio_alloc(49*4);
    ci=0;
    while(ci<49){st_i32_set(census_ref,ci*4,0);ci=ci+1;}
    let pair_bad:i32=0;
    let over_max:i32=0;
    ri=0;
    while(ri<st.audit_n){
        let e:i32=ri*64;
        let op:i32=st_i32_get(st.audit,e+0);
        let rc:i32=st_i32_get(st.audit,e+8);
        if(op>=0&&op<49){
            if(rc==ST_OK){st_i32_set(census,op*4,st_i32_get(census,op*4)+1);}
            else {st_i32_set(census_ref,op*4,st_i32_get(census_ref,op*4)+1);}
        } else {
            over_max=over_max+1;
        }
        if(op==ST_OP_KILL&&rc==ST_OK){
            let sl:i32=st_i32_get(st.audit,e+4);
            if(ri+1>=st.audit_n){pair_bad=pair_bad+1;}
            else {
                let e2:i32=(ri+1)*64;
                let op2:i32=st_i32_get(st.audit,e2+0);
                let sl2:i32=st_i32_get(st.audit,e2+4);
                if(op2!=FV_OP_DELIBERATE_SACRIFICE||sl2!=sl){pair_bad=pair_bad+1;}
            }
        }
        ri=ri+1;
    }
    let replay_rc:i32=st_replay_check(&st);

    // ---- audit fingerprint ----
    let fp:i64=0;
    ri=0;
    while(ri<st.audit_n){
        let e:i32=ri*64;
        let op:i32=st_i32_get(st.audit,e+0);
        let sl:i32=st_i32_get(st.audit,e+4);
        let d1:i32=st_i32_get(st.audit,e+56);
        let d2:i32=st_i32_get(st.audit,e+60);
        fp=(fp*31+(op*7+sl*13+d1*17+d2) as i64)%2147483647;
        ri=ri+1;
    }

    // ---- latency: sort + median/max ----
    let la:[]u8=w.lat;
    let li:i32=0;
    while(li<w.lat_n){
        let lj:i32=li+1;
        while(lj<w.lat_n){
            let a:i32=st_i32_get(la,li*4);
            let b:i32=st_i32_get(la,lj*4);
            if(a>b){
                st_i32_set(la,li*4,b);
                st_i32_set(la,lj*4,a);
            }
            lj=lj+1;
        }
        li=li+1;
    }
    let lat_med:i32=0;
    let lat_max:i32=0;
    if(w.lat_n>0){
        lat_med=st_i32_get(la,(w.lat_n/2)*4);
        lat_max=st_i32_get(la,(w.lat_n-1)*4);
    }

    // ---- thermometer AUC (integer Mann-Whitney form) ----
    let auc_p_num:i64=0;let auc_p_den:i64=0;
    let auc_u_num:i64=0;let auc_u_den:i64=0;
    auc_pair(w.auc_pp,w.auc_pn,w.auc_pp_n,w.auc_pn_n,&auc_p_num,&auc_p_den);
    auc_pair(w.auc_up,w.auc_un,w.auc_up_n,w.auc_un_n,&auc_u_num,&auc_u_den);

    // ---- emit metrics ----
    pmetric("arm_f",arm_f);
    pmetric("variant",variant);
    pmetric("prior",FV_PRIOR);
    pmetric("cal_alpha",CAL_ALPHA);
    pmetric("cal_beta",CAL_BETA);
    pmetric("cal_gamma",CAL_GAMMA);
    pmetric("theta_invest",THETA_INVEST);
    pmetric("theta_sacrifice",THETA_SACRIFICE);
    pmetric("audit_n",st.audit_n);
    pmetric("offered_right_imp",w.offered_right_imp);
    pmetric("offered_wrong",w.offered_wrong);
    pmetric("admitted_right_imp",w.admitted_right_imp);
    pmetric("admitted_wrong",w.admitted_wrong);
    pmetric("admitted_wrong_cens",w.admitted_wrong_cens);
    pmetric("admitted_implant",w.admitted_implant);
    pmetric("admitted_designated",w.admitted_designated);
    pmetric("admitted_trainerwrong",w.admitted_trainerwrong);
    pmetric("admitted_trainerwrong_cens",w.admitted_trainerwrong_cens);
    pmetric("dropped_right_imp",w.dropped_right_imp);
    pmetric("dropped_wrong",w.dropped_wrong);
    pmetric("dropped_implant",w.dropped_implant);
    pmetric("dropped_junk",w.dropped_junk);
    pmetric("held_right_imp",held_ri);
    pmetric("held_wrong",held_w);
    pmetric("held_implant",held_im);
    pmetric("held_junk",held_j);
    pmetric("revised_wrong",w.revised_wrong);
    pmetric("revised_wrong_cens",w.revised_wrong_cens);
    pmetric("revised_implant",w.revised_implant);
    pmetric("revised_trainerwrong",w.revised_trainerwrong);
    pmetric("revised_trainerwrong_cens",w.revised_trainerwrong_cens);
    pmetric("revised_rightimp",w.revised_rightimp);
    pmetric("killed_rightimp",w.killed_rightimp);
    pmetric("kill_c0",w.kill_c0);
    pmetric("kill_c1",w.kill_c1);
    pmetric("kill_c2",w.kill_c2);
    pmetric("kill_c3",w.kill_c3);
    pmetric("wrong_churn",w.wrong_churn);
    pmetric("implant_churn",w.implant_churn);
    pmetric("rightimp_churn",w.rightimp_churn);
    pmetric("n_reads",w.n_reads);
    pmetric("n_invest",w.n_invest);
    pmetric("n_hold",w.n_hold);
    pmetric("n_sacrifice",w.n_sacrifice);
    pmetric("n_spare",w.n_spare);
    pmetric("n_spare_cap",w.n_spare_cap);
    pmetric("n_strengthen",w.n_strengthen);
    pmetric("n_weaken",w.n_weaken);
    pmetric("n_trainer",w.n_trainer);
    pmetric("n_probe",w.n_probe);
    pmetric("n_kill_refused",w.n_kill_refused);
    pmetric("n_drops",w.n_drops);
    pmetric("n_pressure_short",w.n_pressure_short);
    pmetric("junk_max_nd",w.junk_max_nd);
    pmetric("f4b_bad",w.f4b_bad);
    pmetric("noev_invest_bad",w.noev_invest_bad);
    pmetric("lat_n",w.lat_n);
    pmetric("lat_med",lat_med);
    pmetric("lat_max",lat_max);
    pmetric("auc_pp_n",w.auc_pp_n);
    pmetric("auc_pn_n",w.auc_pn_n);
    pmetric("auc_up_n",w.auc_up_n);
    pmetric("auc_un_n",w.auc_un_n);
    pmetric("auc_full",w.auc_full);
    pmetric64("auc_p_num",auc_p_num);
    pmetric64("auc_p_den",auc_p_den);
    pmetric64("auc_u_num",auc_u_num);
    pmetric64("auc_u_den",auc_u_den);
    pmetric("impl_traj_n",w.impl_traj_n);
    pmetric("impl_traj_full",w.impl_traj_full);
    pmetric("wrong_traj_n",w.wrong_traj_n);
    pmetric("wrong_traj_full",w.wrong_traj_full);
    pmetric("op_over_max",over_max);
    _zag_print("FELT_CHECK,replay,");cl_number(replay_rc as i64);
    _zag_print(",");cl_number(ST_OK as i64);_zag_println("");
    _zag_print("FELT_CHECK,recompute_bad,");cl_number(recompute_bad as i64);
    _zag_print(",0");_zag_println("");
    _zag_print("FELT_CHECK,kill_sacrifice_paired,");cl_number(pair_bad as i64);
    _zag_print(",0");_zag_println("");
    _zag_print("FELT_FINGERPRINT,");cl_number(fp);_zag_println("");
    // end-of-run held strengths (P3b concentration input)
    s=0;
    while(s<cap){
        if(st_i32_get(dval,s*4)!=-1){
            let v:i32=st_i32_get(dval,s*4);
            let sstr:[]u8=st.st_str;
            let ddes:[]u8=w.d_desig;
            _zag_print("FELT_ENDSTR,");cl_number(v as i64);
            _zag_print(",");cl_number((sstr[s] as i32) as i64);
            _zag_print(",");cl_number(f_class(v) as i64);
            _zag_print(",");cl_number(st_i32_get(ddes,s*4) as i64);_zag_println("");
        }
        s=s+1;
    }
    // op census (I-5 behavioral input)
    ci=0;
    while(ci<49){
        let okc:i32=st_i32_get(census,ci*4);
        let rfc:i32=st_i32_get(census_ref,ci*4);
        if(okc>0||rfc>0){
            _zag_print("FELT_OPCENSUS,");cl_number(ci as i64);
            _zag_print(",");cl_number(okc as i64);
            _zag_print(",");cl_number(rfc as i64);_zag_println("");
        }
        ci=ci+1;
    }
    // trajectories: packed (m<<16)|(X<<8)|intensity, grouped in analysis
    let ti:i32=0;
    let itj:[]u8=w.impl_traj;
    while(ti<w.impl_traj_n){
        _zag_print("FELT_TRAJ,implant,");cl_number(st_i32_get(itj,ti*4) as i64);_zag_println("");
        ti=ti+1;
    }
    ti=0;
    let wtj:[]u8=w.wrong_traj;
    while(ti<w.wrong_traj_n){
        _zag_print("FELT_TRAJ,wrong,");cl_number(st_i32_get(wtj,ti*4) as i64);_zag_println("");
        ti=ti+1;
    }
    _zag_println("FELT_DONE");

    nio_free(census);
    nio_free(census_ref);
    st_free(&st);
    return 0;
}

// ============ calibration: judgment-free replay (variants 7/8) ============
// The observation schedule is emitted into a ledger; I is read for every
// admitted memory at m+50 and at run end under each of the 45 grid points.
// No judgments run (AUC is judgment-independent), so there is no
// circularity. Grid (frozen): alpha in {10,12,14,16,18}, beta in
// {15,20,25}, gamma in {20,25,30}; deterministic order alpha,beta,gamma.
fn grid_abg(gi:i32,alpha:*i32,beta:*i32,gamma:*i32)void {
    let ai:i32=gi/9;
    let rem:i32=gi-9*ai;
    let bi:i32=rem/3;
    let gi3:i32=rem-3*bi;
    alpha.*=10+2*ai;
    beta.*=15+5*bi;
    gamma.*=20+5*gi3;
}

// Mann-Whitney AUC over histogram slices with base offsets (integer form).
fn auc_pair_off(hp:[]u8,hn:[]u8,np:i32,nn:i32,offp:i32,offn:i32,num:*i64,den:*i64)void {
    let wins:i64=0;
    let ties:i64=0;
    let i:i32=0;
    while(i<=100){
        let hpi:i64=st_i32_get(hp,(offp+i)*4) as i64;
        ties=ties+hpi*(st_i32_get(hn,(offn+i)*4) as i64);
        let j:i32=0;
        while(j<i){
            wins=wins+hpi*(st_i32_get(hn,(offn+j)*4) as i64);
            j=j+1;
        }
        i=i+1;
    }
    let total:i64=(np as i64)*(nn as i64);
    num.*=2*wins+ties;
    den.*=2*total;
}

fn run_calibration(variant:i32)i32 {
    _zag_print("FELT_CAL_CELL,");cl_number(variant as i64);_zag_println("");
    let cap:i32=512;
    let st:StStore=st_init(cap,16384);
    st_set_stage(&st,ST_STAGE_FULL);
    let slot_of:[]u8=nio_alloc(500*4);
    let ep_end:[]u8=nio_alloc(500*4);

    let m:i32=0;
    while(m<500){
        let slot_out:i32=-1;
        let arc:i32=st_add(&st,m,ST_REGION_USER,0,&slot_out);
        st_i32_set(slot_of,m*4,slot_out);
        if(f_designated(m)==1){
            felt_emit_obs(&st,slot_out,m,FV_OP_OBS_TRAINER_MARK,m);
        }
        let vv:i32=0;
        while(vv<=m){
            let s:i32=st_i32_get(slot_of,vv*4);
            let cls:i32=f_class(vv);
            if(cls==1){
                if(m==vv+25||m==vv+40){felt_emit_obs(&st,s,vv,FV_OP_OBS_CORROBORATE,m);}
            }
            if(cls==2){
                if(m==vv+60||m==vv+85||m==vv+110||m==vv+135){
                    felt_emit_obs(&st,s,vv,FV_OP_OBS_CONTRADICT,m);
                }
            }
            if(cls==3){
                if(m==vv+10){felt_emit_obs(&st,s,vv,FV_OP_OBS_CORROBORATE,m);}
                if(m==vv+24||m==vv+49||m==vv+74){
                    felt_emit_obs(&st,s,vv,FV_OP_OBS_CONTRADICT,m);
                }
            }
            if(f_probe(vv,variant)==1&&m==vv+30){
                felt_emit_obs(&st,s,vv,FV_OP_OBS_PROBE,m);
            }
            vv=vv+1;
        }
        st_i32_set(ep_end,m*4,st.audit_n);
        m=m+1;
    }

    // per-grid-point accumulators
    let hpos:[]u8=nio_alloc(45*101*4);
    let hneg:[]u8=nio_alloc(45*101*4);
    let npos:[]u8=nio_alloc(45*4);
    let nneg:[]u8=nio_alloc(45*4);
    let minI:[]u8=nio_alloc(45*4);
    let maxI:[]u8=nio_alloc(45*4);
    let gi:i32=0;
    while(gi<45){
        let b:i32=0;
        while(b<101){
            st_i32_set(hpos,(gi*101+b)*4,0);
            st_i32_set(hneg,(gi*101+b)*4,0);
            b=b+1;
        }
        st_i32_set(npos,gi*4,0);
        st_i32_set(nneg,gi*4,0);
        st_i32_set(minI,gi*4,1000);
        st_i32_set(maxI,gi*4,-1);
        gi=gi+1;
    }

    let vv:i32=0;
    while(vv<500){
        let s:i32=st_i32_get(slot_of,vv*4);
        let cls:i32=f_class(vv);
        let desig:i32=f_designated(vv);
        let rt1:i32=vv+50;
        if(rt1>499){rt1=499;}
        let rti:i32=0;
        while(rti<2){
            let rt:i32=rt1;
            if(rti==1){rt=499;}
            if(rti==0||rt1!=499){
                let upto:i32=st_i32_get(ep_end,rt*4);
                let pn:i32=felt_probe_n(&st,s,vv,upto);
                let gi2:i32=0;
                while(gi2<45){
                    let alpha:i32=0;let beta:i32=0;let gamma:i32=0;
                    grid_abg(gi2,&alpha,&beta,&gamma);
                    let p:i32=felt_counts_p(&st,s,vv,upto,alpha,beta,gamma);
                    let inten:i32=felt_unpack_intensity(p);
                    let c:i32=felt_unpack_c(p);
                    let x:i32=felt_unpack_x(p);
                    let t:i32=felt_unpack_t(p);
                    let proven:i32=0;
                    if(c+x+t+pn>0){proven=1;}
                    if(cls==1&&proven==1){
                        st_i32_set(hpos,(gi2*101+inten)*4,st_i32_get(hpos,(gi2*101+inten)*4)+1);
                        st_i32_set(npos,gi2*4,st_i32_get(npos,gi2*4)+1);
                    }
                    if(cls==0&&proven==1){
                        st_i32_set(hneg,(gi2*101+inten)*4,st_i32_get(hneg,(gi2*101+inten)*4)+1);
                        st_i32_set(nneg,gi2*4,st_i32_get(nneg,gi2*4)+1);
                    }
                    if(cls==1&&c>=2){
                        if(inten<st_i32_get(minI,gi2*4)){st_i32_set(minI,gi2*4,inten);}
                    }
                    if(cls==0&&desig==0){
                        if(inten>st_i32_get(maxI,gi2*4)){st_i32_set(maxI,gi2*4,inten);}
                    }
                    gi2=gi2+1;
                }
            }
            rti=rti+1;
        }
        vv=vv+1;
    }

    gi=0;
    while(gi<45){
        let alpha:i32=0;let beta:i32=0;let gamma:i32=0;
        grid_abg(gi,&alpha,&beta,&gamma);
        let num:i64=0;let den:i64=0;
        auc_pair_off(hpos,hneg,st_i32_get(npos,gi*4),st_i32_get(nneg,gi*4),
            gi*101,gi*101,&num,&den);
        _zag_print("FELT_CAL,");cl_number(variant as i64);
        _zag_print(",");cl_number(gi as i64);
        _zag_print(",");cl_number(alpha as i64);
        _zag_print(",");cl_number(beta as i64);
        _zag_print(",");cl_number(gamma as i64);
        _zag_print(",");cl_number(num);
        _zag_print(",");cl_number(den);
        _zag_print(",");cl_number(st_i32_get(npos,gi*4) as i64);
        _zag_print(",");cl_number(st_i32_get(nneg,gi*4) as i64);
        _zag_print(",");cl_number(st_i32_get(minI,gi*4) as i64);
        _zag_print(",");cl_number(st_i32_get(maxI,gi*4) as i64);
        _zag_println("");
        gi=gi+1;
    }
    _zag_println("FELT_CAL_DONE");
    st_free(&st);
    return 0;
}

fn main()i32 {
    let m1:[]u8=_zag_arg(1);
    if(_zag_strcmp(m1,"cal7")==1){return run_calibration(7);}
    if(_zag_strcmp(m1,"cal8")==1){return run_calibration(8);}
    let is_f:i32=_zag_strcmp(m1,"f");
    let is_n:i32=_zag_strcmp(m1,"n");
    if(is_f!=1&&is_n!=1){
        _zag_println("FELT_BADMODE");
        return 1;
    }
    let arm_f:i32=0;
    if(is_f==1){arm_f=1;}
    let m2:[]u8=_zag_arg(2);
    let variant:i32=0;
    if(_zag_strcmp(m2,"1")==1){variant=1;}
    if(_zag_strcmp(m2,"2")==1){variant=2;}
    if(arm_f==1){_zag_print("FELT_CELL,F,");}else{_zag_print("FELT_CELL,N,");}
    cl_number(variant as i64);_zag_println("");
    return run_trial(arm_f,variant);
}

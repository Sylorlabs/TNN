// FELT-REPOSITION trial driver (wave8/felt-rebuild/reposition-impl).
// One binary; argv selects the cell (no atoi in the substrate):
//   argv[1] = arm: f | r | q | fifo | c
//   argv[2] = variant: 0 | 1 | 2
//   argv[3] = ledger dump filename (written into the process cwd)
// All five arms run BYTE-IDENTICAL strength machinery (the wave-8 N side:
// fixed strengthen targets 80/90/30, strength-ordered H1 triage with the
// graded effort gate, ABANDON ON GATE FAILURE, weaken-to-30 revision on
// >=2 contradictions, evidence-gated kills). NO Gate-2 sacrifice (that
// amendment belongs to V3's trial). Only the rehearsal policy varies.
// The feeling is read ONLY in F's rehearsal selection (felt_read_p);
// the strength path performs zero intensity reads.
// Windows: [0,50)...[450,500); at each window start (m%50==0) up to B=25
// rehearsal ops are issued from the ledger prefix strictly before the
// window (selection runs before the episode's observations). REHEARSAL
// entries are pure read-attention (before==after snapshots, rc=ST_OK):
// they never emit OBS_*, never touch strength/kills/revisions/triage.
// Prereg: PREREG_FELT_REPOSITION.md as amended 2026-09-20 (§16 is law).
@import("felt_v3.zag")
@import("calib_consts.zag")

// New audit op code for this trial. Substrate uses 1..29; the felt
// module uses 41..48 (obs 41,42,43,45; INTENSITY_READ 44).
const RP_OP_REHEARSAL:i32=49;
const RP_OP_MAX:i32=49;
const RP_B:i32=25;
const RP_WLEN:i32=50;

// ============ curriculum ground truth (frozen, V3 S8 verbatim) ============
fn f_is_implant(m:i32)i32 {
    if(m==0){return 1;}
    if(m==83){return 1;}
    if(m==166){return 1;}
    if(m==250){return 1;}
    if(m==333){return 1;}
    if(m==416){return 1;}
    return 0;
}
fn f_imp(m:i32)i32 {
    if((m%10)<3){return 1;}
    return 0;
}
fn f_wrong(m:i32)i32 {
    if(((m+3)%10)<3){return 1;}
    return 0;
}
// class: 0=junk 1=right-important 2=wrong 3=implant (implant overrides).
// NOTE: imp (m%10 in {0,1,2}) and wrong (m%10 in {7,8,9}) are disjoint.
fn f_class(m:i32)i32 {
    if(f_is_implant(m)==1){return 3;}
    if(f_wrong(m)==1){return 2;}
    if(f_imp(m)==1){return 1;}
    return 0;
}
// Trainer designations: m%10 in {4,5} -> mark at admission, T=1 from birth.
fn f_designated(m:i32)i32 {
    if(f_is_implant(m)==1){return 0;}
    if(m%10==4||m%10==5){return 1;}
    return 0;
}
// PROBE schedule: junk with (m+v)%5==0 gets a zero-weight PROBE at m+30.
fn f_probe(m:i32,v:i32)i32 {
    if(f_class(m)==0&&(m+v)%5==0){return 1;}
    return 0;
}

// ============ driver state ============
struct RpW {
    cap:i32,
    arm:i32,
    variant:i32,
    d_val:[]u8,
    d_corrob:[]u8,
    d_contra_n:[]u8,
    d_contra_ep:[]u8,
    d_cited:[]u8,
    d_just:[]u8,
    d_weakx:[]u8,
    d_tried:[]u8,
    d_newc:[]u8,
    d_desig:[]u8,
    n_strengthen:i32,
    n_weaken:i32,
    n_trainer:i32,
    n_kill_refused:i32,
    n_drops:i32,
    n_pressure_short:i32,
    n_probe:i32,
    n_rehearse:i32,
    rh_c0:i32,
    rh_c1:i32,
    rh_c2:i32,
    rh_c3:i32,
    admitted_right_imp:i32,
    admitted_wrong:i32,
    admitted_implant:i32,
    admitted_designated:i32,
    dropped_right_imp:i32,
    dropped_wrong:i32,
    dropped_implant:i32,
    dropped_junk:i32,
    revised_wrong:i32,
    revised_implant:i32,
    revised_rightimp:i32,
    killed_rightimp:i32,
    kill_c0:i32,
    kill_c1:i32,
    kill_c2:i32,
    kill_c3:i32,
    wrong_churn:i32,
    implant_churn:i32,
    rightimp_churn:i32
}

fn d_clear(w:*RpW,s:i32)void {
    let dval:[]u8=w.*.d_val;
    let dcor:[]u8=w.*.d_corrob;
    let dcnn:[]u8=w.*.d_contra_n;
    let dcit:[]u8=w.*.d_cited;
    let djus:[]u8=w.*.d_just;
    let dwek:[]u8=w.*.d_weakx;
    let dnew:[]u8=w.*.d_newc;
    let ddes:[]u8=w.*.d_desig;
    st_i32_set(dval,s*4,-1);
    st_i32_set(dcor,s*4,0);
    st_i32_set(dcnn,s*4,0);
    st_i32_set(dcit,s*4,0);
    st_i32_set(djus,s*4,0);
    st_i32_set(dwek,s*4,0);
    st_i32_set(dnew,s*4,0);
    st_i32_set(ddes,s*4,0);
}

// Classify a kill: proper revision (evidence-based, cn>=2) vs churn.
fn record_kill(w:*RpW,s:i32,v:i32,cn:i32)void {
    let cls:i32=f_class(v);
    if(cls==0){w.*.kill_c0=w.*.kill_c0+1;}
    if(cls==1){w.*.kill_c1=w.*.kill_c1+1;w.*.killed_rightimp=w.*.killed_rightimp+1;}
    if(cls==2){w.*.kill_c2=w.*.kill_c2+1;}
    if(cls==3){w.*.kill_c3=w.*.kill_c3+1;}
    if(cn>=2){
        if(cls==2){w.*.revised_wrong=w.*.revised_wrong+1;}
        if(cls==3){w.*.revised_implant=w.*.revised_implant+1;}
        if(cls==1){w.*.revised_rightimp=w.*.revised_rightimp+1;}
    } else {
        if(cls==2){w.*.wrong_churn=w.*.wrong_churn+1;}
        if(cls==3){w.*.implant_churn=w.*.implant_churn+1;}
        if(cls==1){w.*.rightimp_churn=w.*.rightimp_churn+1;}
    }
}

// H1 age gate: a slot is triage-eligible only if age >= 25.
fn h1_eligible(w:*RpW,s:i32,m:i32)i32 {
    let dval:[]u8=w.*.d_val;
    let v:i32=st_i32_get(dval,s*4);
    if(m-v>=25){return 1;}
    return 0;
}

// Triage victim selection (N side, all arms): ascending (strength,
// admission-v). No feeling reads anywhere on the strength path.
fn pick_victim_n(w:*RpW,st:*StStore,m:i32)i32 {
    let dval:[]u8=w.*.d_val;
    let dtry:[]u8=w.*.d_tried;
    let sstr:[]u8=st.*.st_str;
    let best:i32=-1;
    let best_key:i32=1000000;
    let best_ord:i32=1000000;
    let s:i32=0;
    while(s<w.*.cap){
        if(st_i32_get(dval,s*4)!=-1&&st_i32_get(dtry,s*4)==0&&h1_eligible(w,s,m)==1){
            let v:i32=st_i32_get(dval,s*4);
            let key:i32=sstr[s] as i32;
            if(key<best_key||(key==best_key&&v<best_ord)){
                best=s;best_key=key;best_ord=v;
            }
        }
        s=s+1;
    }
    return best;
}

// H1 pressure corner: any live slot, but none triage-eligible (all underage).
fn pressure_no_elig(w:*RpW,m:i32)i32 {
    let dval:[]u8=w.*.d_val;
    let any_live:i32=0;
    let any_elig:i32=0;
    let s:i32=0;
    while(s<w.*.cap){
        if(st_i32_get(dval,s*4)!=-1){
            any_live=1;
            if(h1_eligible(w,s,m)==1){any_elig=1;}
        }
        s=s+1;
    }
    if(any_live==1&&any_elig==0){return 1;}
    return 0;
}

// Gate 1 (constitutional, unchanged from wave-8): the graded effort gate.
// need = ceil(strength/25) distinct contradiction cites; kill iff cn>=need.
// Returns 1 if the slot was freed.
fn gate1_kill(w:*RpW,st:*StStore,s:i32,reason:i32,m:i32)i32 {
    let dval:[]u8=w.*.d_val;
    let dcnn:[]u8=w.*.d_contra_n;
    let dcit:[]u8=w.*.d_cited;
    let djus:[]u8=w.*.d_just;
    let dce:[]u8=w.*.d_contra_ep;
    let sstr:[]u8=st.*.st_str;
    let v:i32=st_i32_get(dval,s*4);
    let cur:i32=sstr[s] as i32;
    let need:i32=(cur+24)/25;
    let cn:i32=st_i32_get(dcnn,s*4);
    if(cn>=need){
        let k:i32=st_i32_get(dcit,s*4);
        while(k<need&&k<cn){
            let ep:i32=st_i32_get(dce,(s*4+k)*4);
            st_evidence(st,s,reason,ep);
            k=k+1;
        }
        st_i32_set(dcit,s*4,k);
        if(st_i32_get(djus,s*4)==0){
            st_justify(st,s,reason);
            st_i32_set(djus,s*4,1);
        }
        let rc:i32=st_kill_evidenced(st,s,ST_ARM_A);
        if(rc==ST_OK){
            record_kill(w,s,v,cn);
            d_clear(w,s);
            return 1;
        }
        w.*.n_kill_refused=w.*.n_kill_refused+1;
        return 0;
    }
    return 0;
}

fn clear_tried(w:*RpW)void {
    let dtry:[]u8=w.*.d_tried;
    let s:i32=0;
    while(s<w.*.cap){st_i32_set(dtry,s*4,0);s=s+1;}
}
fn clear_newc(w:*RpW)void {
    let dnew:[]u8=w.*.d_newc;
    let s:i32=0;
    while(s<w.*.cap){st_i32_set(dnew,s*4,0);s=s+1;}
}

// Observation emitters. Driver-side only (static gate: no learner/
// judgment/rehearsal path emits observations). Each prints its
// FELT_OBS line so the checker can verify the S8 schedule.
fn obs_line(v:i32,kind:i32,ep:i32)void {
    _zag_print("FELT_OBS,");cl_number(v as i64);
    _zag_print(",");cl_number(kind as i64);
    _zag_print(",");cl_number(ep as i64);_zag_println("");
}
// Observation emission: byte-identical to the frozen curriculum path
// (st_snap + st_audit_append, before==after, d1=value, d2=ep). Local so
// the driver makes NO felt_* calls outside F's rehearsal selection (I-R-6).
fn rp_emit_obs(st:*StStore,s:i32,v:i32,kind:i32,ep:i32)void {
    if(s<0||s>=st.*.cap){return;}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(st,s,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(st,kind,s,ST_OK,
        b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,v,ep);
}
// Count contradictions for (slot,value) over the ledger prefix [0,upto).
// Local ledger scan (same result as the felt module's counter); keeps the
// frozen graded-effort gate free of felt_* calls (I-R-6).
fn rp_count_contra(st:*StStore,s:i32,v:i32,upto:i32)i32 {
    let x:i32=0;
    let i:i32=0;
    while(i<upto){
        let e:i32=i*64;
        if(st_i32_get(st.*.audit,e+0)==FV_OP_OBS_CONTRADICT){
            if(st_i32_get(st.*.audit,e+4)==s&&st_i32_get(st.*.audit,e+56)==v){
                x=x+1;
            }
        }
        i=i+1;
    }
    return x;
}
fn emit_contra(w:*RpW,st:*StStore,s:i32,v:i32,m:i32)void {
    let dcnn:[]u8=w.*.d_contra_n;
    let dce:[]u8=w.*.d_contra_ep;
    rp_emit_obs(st,s,v,FV_OP_OBS_CONTRADICT,m);
    obs_line(v,2,m);
    let n:i32=st_i32_get(dcnn,s*4);
    if(n<4){st_i32_set(dce,(s*4+n)*4,m);}
    st_i32_set(dcnn,s*4,n+1);
}
fn emit_corrob(w:*RpW,st:*StStore,s:i32,v:i32,m:i32)void {
    let dcor:[]u8=w.*.d_corrob;
    let dnew:[]u8=w.*.d_newc;
    rp_emit_obs(st,s,v,FV_OP_OBS_CORROBORATE,m);
    obs_line(v,1,m);
    st_i32_set(dcor,s*4,st_i32_get(dcor,s*4)+1);
    st_i32_set(dnew,s*4,1);
}
fn emit_probe(w:*RpW,st:*StStore,s:i32,v:i32,m:i32)void {
    rp_emit_obs(st,s,v,FV_OP_OBS_PROBE,m);
    obs_line(v,4,m);
    w.*.n_probe=w.*.n_probe+1;
}
fn emit_mark(w:*RpW,st:*StStore,s:i32,v:i32,m:i32)void {
    rp_emit_obs(st,s,v,FV_OP_OBS_TRAINER_MARK,m);
    obs_line(v,3,m);
    w.*.n_trainer=w.*.n_trainer+1;
}

// Pressure event: free `demand` slots. kind 0=scheduled (m in
// {100,200,300,400,499}), kind 1=admission overflow. For each candidate
// in strength order: Gate 1 (graded effort gate); on gate failure the
// candidate is ABANDONED (marked tried, move on) — there is no Gate-2
// sacrifice in this trial. Returns slots freed.
fn pressure_event(w:*RpW,st:*StStore,m:i32,demand:i32,kind:i32)i32 {
    _zag_print("FELT_PRESSURE,");cl_number(m as i64);
    _zag_print(",");cl_number(kind as i64);_zag_println("");
    clear_tried(w);
    if(kind==0&&pressure_no_elig(w,m)==1){
        w.*.n_pressure_short=w.*.n_pressure_short+1;
        return 0;
    }
    let freed:i32=0;
    let guard:i32=0;
    while(freed<demand&&guard<100){
        guard=guard+1;
        let vic:i32=pick_victim_n(w,st,m);
        if(vic==-1){freed=demand;}
        else {
            if(gate1_kill(w,st,vic,ST_J_PRESSURE_VICTIM,m)==1){
                freed=freed+1;
            } else {
                let dtry:[]u8=w.*.d_tried;
                st_i32_set(dtry,vic*4,1);
            }
        }
    }
    return freed;
}

// Site 1 (all arms identical): wave-8 N — fixed strengthen targets
// (80 first corroboration, 90 later). No intensity read anywhere.
fn site1_n(w:*RpW,st:*StStore,s:i32,m:i32)void {
    let dval:[]u8=w.*.d_val;
    let dcor:[]u8=w.*.d_corrob;
    let sstr:[]u8=st.*.st_str;
    let v:i32=st_i32_get(dval,s*4);
    let cur:i32=sstr[s] as i32;
    let target:i32=90;
    if(st_i32_get(dcor,s*4)==1){target=80;}
    if(target>cur){
        st_strengthen(st,s,target,ST_J_CORROBORATED);
        w.*.n_strengthen=w.*.n_strengthen+1;
    }
    _zag_print("FELT_JUDGE,N_STRENGTHEN,");cl_number(v as i64);
    _zag_print(",");cl_number(target as i64);
    _zag_print(",");cl_number(cur as i64);
    _zag_print(",");cl_number(m as i64);_zag_println("");
}

// Revision sweep (all arms identical): trigger >=2 observed
// contradictions; weaken-to-30 (iff 30 < current); then the
// constitutional evidence-gated kill proceeds identically.
fn revision_sweep(w:*RpW,st:*StStore,m:i32)void {
    let dval:[]u8=w.*.d_val;
    let dcnn:[]u8=w.*.d_contra_n;
    let dcit:[]u8=w.*.d_cited;
    let djus:[]u8=w.*.d_just;
    let dwek:[]u8=w.*.d_weakx;
    let dce:[]u8=w.*.d_contra_ep;
    let sstr:[]u8=st.*.st_str;
    let s:i32=0;
    while(s<w.*.cap){
        let livev:i32=st_i32_get(dval,s*4);
        let xn:i32=st_i32_get(dcnn,s*4);
        if(livev!=-1&&xn>=2){
            let target:i32=30;
            let cur:i32=sstr[s] as i32;
            if(xn>st_i32_get(dwek,s*4)&&target<cur){
                st_weaken(st,s,target,ST_J_CONTRADICTED);
                w.*.n_weaken=w.*.n_weaken+1;
                st_i32_set(dwek,s*4,xn);
            }
            while(st_i32_get(dcit,s*4)<st_i32_get(dcnn,s*4)){
                let k:i32=st_i32_get(dcit,s*4);
                let ep:i32=st_i32_get(dce,(s*4+k)*4);
                st_evidence(st,s,ST_J_CONTRADICTED,ep);
                st_i32_set(dcit,s*4,k+1);
            }
            if(st_i32_get(djus,s*4)==0){
                st_justify(st,s,ST_J_CONTRADICTED);
                st_i32_set(djus,s*4,1);
            }
            let rc:i32=st_kill_evidenced(st,s,ST_ARM_A);
            if(rc==ST_OK){
                record_kill(w,s,livev,st_i32_get(dcnn,s*4));
                d_clear(w,s);
            } else {
                w.*.n_kill_refused=w.*.n_kill_refused+1;
            }
        }
        s=s+1;
    }
}

// ============ rehearsal (the attention mechanism) ============
// Count (C,X,T) observations for (slot,value) over the ledger prefix
// [0,upto). Local counter (not felt_counts_p): the trial's Q/C policies
// are deliberately independent of the felt module.
fn rp_cxt(st:*StStore,slot:i32,v:i32,upto:i32,c:*i32,x:*i32,t:*i32)void {
    c.*=0;x.*=0;t.*=0;
    let ab:[]u8=st.*.audit;
    let i:i32=0;
    while(i<upto){
        let e:i32=i*64;
        let op:i32=st_i32_get(ab,e+0);
        if(op==FV_OP_OBS_CORROBORATE||op==FV_OP_OBS_CONTRADICT||op==FV_OP_OBS_TRAINER_MARK){
            if(st_i32_get(ab,e+4)==slot&&st_i32_get(ab,e+56)==v){
                if(op==FV_OP_OBS_CORROBORATE){c.*=c.*+1;}
                else if(op==FV_OP_OBS_CONTRADICT){x.*=x.*+1;}
                else{t.*=t.*+1;}
            }
        }
        i=i+1;
    }
}

// Emit one rehearsal op: pure read-attention. before==after snapshots,
// rc=ST_OK, so substrate replay treats it as a no-op state restore.
// d1 = memory value, d2 = the policy's cited basis. Never emits OBS_*.
fn rp_emit_rehearsal(w:*RpW,st:*StStore,s:i32,v:i32,m:i32,basis:i32)void {
    if(s<0||s>=w.*.cap){return;}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(st,s,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(st,RP_OP_REHEARSAL,s,ST_OK,
        b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,v,basis);
    w.*.n_rehearse=w.*.n_rehearse+1;
    let cls:i32=f_class(v);
    if(cls==0){w.*.rh_c0=w.*.rh_c0+1;}
    else if(cls==1){w.*.rh_c1=w.*.rh_c1+1;}
    else if(cls==2){w.*.rh_c2=w.*.rh_c2+1;}
    else{w.*.rh_c3=w.*.rh_c3+1;}
    _zag_print("REHEARSE,");cl_number(m as i64);
    _zag_print(",");cl_number(s as i64);
    _zag_print(",");cl_number(v as i64);
    _zag_print(",");cl_number(basis as i64);_zag_println("");
}

// F (feeling): read I per candidate (ledgered INTENSITY_READ), order
// descending I, ties -> oldest admission (v asc; v is unique).
// THE ONLY felt_* call site in the trial (static gate I-R-6).
fn rp_select_f(w:*RpW,st:*StStore,m:i32,live_n:i32)i32 {
    let cap:i32=w.*.cap;
    let dval:[]u8=w.*.d_val;
    let pack:[]u8=nio_alloc(cap*4);
    let picked:[]u8=nio_alloc(cap);
    let s:i32=0;
    while(s<cap){
        if(st_i32_get(dval,s*4)!=-1){
            let v:i32=st_i32_get(dval,s*4);
            st_i32_set(pack,s*4,felt_read_p(st,s,v,CAL_ALPHA,CAL_BETA,CAL_GAMMA));
            picked[s]=0;
        } else {picked[s]=1;}
        s=s+1;
    }
    let ops:i32=0;
    while(ops<RP_B&&ops<live_n){
        let best:i32=-1;
        let bi:i32=-1;
        let bv:i32=2147483647;
        s=0;
        while(s<cap){
            if(picked[s]==0){
                let ii:i32=felt_unpack_intensity(st_i32_get(pack,s*4));
                let vv:i32=st_i32_get(dval,s*4);
                if(best==-1||ii>bi||(ii==bi&&vv<bv)){best=s;bi=ii;bv=vv;}
            }
            s=s+1;
        }
        if(best==-1){break;}
        picked[best]=1;
        rp_emit_rehearsal(w,st,best,st_i32_get(dval,best*4),m,st_i32_get(pack,best*4));
        ops=ops+1;
    }
    nio_free(pack);
    nio_free(picked);
    return ops;
}

// R (recency): descending admission episode; ties -> slot index.
fn rp_select_r(w:*RpW,st:*StStore,m:i32,live_n:i32)i32 {
    let cap:i32=w.*.cap;
    let dval:[]u8=w.*.d_val;
    let picked:[]u8=nio_alloc(cap);
    let s:i32=0;
    while(s<cap){
        if(st_i32_get(dval,s*4)!=-1){picked[s]=0;}else{picked[s]=1;}
        s=s+1;
    }
    let ops:i32=0;
    while(ops<RP_B&&ops<live_n){
        let best:i32=-1;
        let bv:i32=-1;
        s=0;
        while(s<cap){
            if(picked[s]==0){
                let vv:i32=st_i32_get(dval,s*4);
                if(best==-1||vv>bv||(vv==bv&&s<best)){best=s;bv=vv;}
            }
            s=s+1;
        }
        if(best==-1){break;}
        picked[best]=1;
        rp_emit_rehearsal(w,st,best,st_i32_get(dval,best*4),m,st_i32_get(dval,best*4));
        ops=ops+1;
    }
    nio_free(picked);
    return ops;
}

// Q (frequency): descending (C+X+T); ties -> oldest admission.
fn rp_select_q(w:*RpW,st:*StStore,m:i32,live_n:i32,upto:i32)i32 {
    let cap:i32=w.*.cap;
    let dval:[]u8=w.*.d_val;
    let qb:[]u8=nio_alloc(cap*4);
    let picked:[]u8=nio_alloc(cap);
    let s:i32=0;
    while(s<cap){
        if(st_i32_get(dval,s*4)!=-1){
            let v:i32=st_i32_get(dval,s*4);
            let c:i32=0;let x:i32=0;let t:i32=0;
            rp_cxt(st,s,v,upto,&c,&x,&t);
            st_i32_set(qb,s*4,c+x+t);
            picked[s]=0;
        } else {picked[s]=1;}
        s=s+1;
    }
    let ops:i32=0;
    while(ops<RP_B&&ops<live_n){
        let best:i32=-1;
        let bq:i32=-1;
        let bv:i32=2147483647;
        s=0;
        while(s<cap){
            if(picked[s]==0){
                let q:i32=st_i32_get(qb,s*4);
                let vv:i32=st_i32_get(dval,s*4);
                if(best==-1||q>bq||(q==bq&&vv<bv)){best=s;bq=q;bv=vv;}
            }
            s=s+1;
        }
        if(best==-1){break;}
        picked[best]=1;
        rp_emit_rehearsal(w,st,best,st_i32_get(dval,best*4),m,st_i32_get(qb,best*4));
        ops=ops+1;
    }
    nio_free(qb);
    nio_free(picked);
    return ops;
}

// FIFO: ascending admission episode (oldest admitted first); ties -> slot.
fn rp_select_fifo(w:*RpW,st:*StStore,m:i32,live_n:i32)i32 {
    let cap:i32=w.*.cap;
    let dval:[]u8=w.*.d_val;
    let picked:[]u8=nio_alloc(cap);
    let s:i32=0;
    while(s<cap){
        if(st_i32_get(dval,s*4)!=-1){picked[s]=0;}else{picked[s]=1;}
        s=s+1;
    }
    let ops:i32=0;
    while(ops<RP_B&&ops<live_n){
        let best:i32=-1;
        let bv:i32=2147483647;
        s=0;
        while(s<cap){
            if(picked[s]==0){
                let vv:i32=st_i32_get(dval,s*4);
                if(best==-1||vv<bv||(vv==bv&&s<best)){best=s;bv=vv;}
            }
            s=s+1;
        }
        if(best==-1){break;}
        picked[best]=1;
        rp_emit_rehearsal(w,st,best,st_i32_get(dval,best*4),m,st_i32_get(dval,best*4));
        ops=ops+1;
    }
    nio_free(picked);
    return ops;
}

// C (count-based honest control): tier 1 = C>=2 by descending C;
// tier 2 = rest by descending C; ties -> oldest admission.
fn rp_select_c(w:*RpW,st:*StStore,m:i32,live_n:i32,upto:i32)i32 {
    let cap:i32=w.*.cap;
    let dval:[]u8=w.*.d_val;
    let cb:[]u8=nio_alloc(cap*4);
    let picked:[]u8=nio_alloc(cap);
    let s:i32=0;
    while(s<cap){
        if(st_i32_get(dval,s*4)!=-1){
            let v:i32=st_i32_get(dval,s*4);
            let c:i32=0;let x:i32=0;let t:i32=0;
            rp_cxt(st,s,v,upto,&c,&x,&t);
            st_i32_set(cb,s*4,c);
            picked[s]=0;
        } else {picked[s]=1;}
        s=s+1;
    }
    let ops:i32=0;
    while(ops<RP_B&&ops<live_n){
        let best:i32=-1;
        let bt:i32=-1;
        let bc:i32=-1;
        let bv:i32=2147483647;
        s=0;
        while(s<cap){
            if(picked[s]==0){
                let c:i32=st_i32_get(cb,s*4);
                let tier:i32=0;
                if(c>=2){tier=1;}
                let vv:i32=st_i32_get(dval,s*4);
                if(best==-1||tier>bt||(tier==bt&&c>bc)||(tier==bt&&c==bc&&vv<bv)){
                    best=s;bt=tier;bc=c;bv=vv;
                }
            }
            s=s+1;
        }
        if(best==-1){break;}
        picked[best]=1;
        let bc2:i32=st_i32_get(cb,best*4);
        let tier2:i32=0;
        if(bc2>=2){tier2=1;}
        rp_emit_rehearsal(w,st,best,st_i32_get(dval,best*4),m,(tier2<<16)|(bc2&255));
        ops=ops+1;
    }
    nio_free(cb);
    nio_free(picked);
    return ops;
}

// One rehearsal window: candidate set = live at window start; ops =
// min(B, live); at most one op per memory per window (picked[] marks).
// Runs BEFORE the window-start episode's observations, so selection sees
// exactly the ledger prefix strictly before the window.
fn rp_rehearsal_window(w:*RpW,st:*StStore,m:i32)void {
    let dval:[]u8=w.*.d_val;
    let live_n:i32=0;
    let s:i32=0;
    while(s<w.*.cap){
        if(st_i32_get(dval,s*4)!=-1){live_n=live_n+1;}
        s=s+1;
    }
    let ops:i32=0;
    if(live_n>0){
        let upto:i32=st.*.audit_n;
        let arm:i32=w.*.arm;
        if(arm==0){ops=rp_select_f(w,st,m,live_n);}
        else if(arm==1){ops=rp_select_r(w,st,m,live_n);}
        else if(arm==2){ops=rp_select_q(w,st,m,live_n,upto);}
        else if(arm==3){ops=rp_select_fifo(w,st,m,live_n);}
        else{ops=rp_select_c(w,st,m,live_n,upto);}
    }
    _zag_print("REHEARSE_WINDOW,");cl_number(m as i64);
    _zag_print(",");cl_number(live_n as i64);
    _zag_print(",");cl_number(ops as i64);_zag_println("");
}

// Write the raw audit ledger (audit_n * 64 bytes) to `name` in the
// process cwd, in <=1MB chunks (nio_write_all's per-call limit).
fn rp_write_dump(st:*StStore,name:[]u8)i32 {
    let root:i64=nio_open_root(".");
    if(root<0){_zag_println("RP_DUMP_ROOT_FAIL");return 1;}
    let fd:i64=nio_open_child(root,name,1);
    if(fd<0){_zag_println("RP_DUMP_OPEN_FAIL");nio_close(root);return 1;}
    let ab:[]u8=st.*.audit;
    let total:i32=st.*.audit_n*64;
    let at:i32=0;
    let ok:i32=1;
    while(at<total){
        let n:i32=total-at;
        if(n>1048576){n=1048576;}
        let chunk:[]u8=ab[at..at+n];
        if(nio_write_all(fd,chunk)!=n){ok=0;break;}
        at=at+n;
    }
    nio_close(fd);
    nio_close(root);
    _zag_print("RP_DUMP,");cl_number(total as i64);
    _zag_print(",");cl_number(ok as i64);_zag_println("");
    if(ok==0){return 1;}
    return 0;
}

fn pmetric(name:[]u8,val:i32)void {
    _zag_print("FELT_METRIC,");_zag_print(name);_zag_print(",");
    cl_number(val as i64);_zag_println("");
}

// ============ trial run (5 arms, identical strength side) ============
fn run_trial(arm:i32,variant:i32,dumpname:[]u8)i32 {
    let cap:i32=32;
    let st:StStore=st_init(cap,131072);
    st_set_stage(&st,ST_STAGE_FULL);

    let w:RpW=RpW{
        .cap=cap,
        .arm=arm,
        .variant=variant,
        .d_val=nio_alloc(128),
        .d_corrob=nio_alloc(128),
        .d_contra_n=nio_alloc(128),
        .d_contra_ep=nio_alloc(512),
        .d_cited=nio_alloc(128),
        .d_just=nio_alloc(128),
        .d_weakx=nio_alloc(128),
        .d_tried=nio_alloc(128),
        .d_newc=nio_alloc(128),
        .d_desig=nio_alloc(128),
        .n_strengthen=0,.n_weaken=0,.n_trainer=0,
        .n_kill_refused=0,.n_drops=0,.n_pressure_short=0,.n_probe=0,
        .n_rehearse=0,.rh_c0=0,.rh_c1=0,.rh_c2=0,.rh_c3=0,
        .admitted_right_imp=0,.admitted_wrong=0,
        .admitted_implant=0,.admitted_designated=0,
        .dropped_right_imp=0,.dropped_wrong=0,.dropped_implant=0,.dropped_junk=0,
        .revised_wrong=0,.revised_implant=0,.revised_rightimp=0,
        .killed_rightimp=0,
        .kill_c0=0,.kill_c1=0,.kill_c2=0,.kill_c3=0,
        .wrong_churn=0,.implant_churn=0,.rightimp_churn=0
    };
    let dval:[]u8=w.d_val;
    let s0:i32=0;
    while(s0<cap){
        st_i32_set(dval,s0*4,-1);
        s0=s0+1;
    }

    let m:i32=0;
    while(m<500){
        // ---- 0. rehearsal window start (before this episode's
        // observations: ledger prefix strictly before the window) ----
        if((m%RP_WLEN)==0){rp_rehearsal_window(&w,&st,m);}

        // ---- 1. observations for held slots (driver-side only) ----
        let s:i32=0;
        while(s<cap){
            if(st_i32_get(dval,s*4)!=-1){
                let v:i32=st_i32_get(dval,s*4);
                let cls:i32=f_class(v);
                if(cls==1){
                    if(m==v+25||m==v+40){emit_corrob(&w,&st,s,v,m);}
                }
                if(cls==2){
                    if(m==v+60||m==v+85||m==v+110||m==v+135){emit_contra(&w,&st,s,v,m);}
                }
                if(cls==3){
                    if(m==v+10){emit_corrob(&w,&st,s,v,m);}
                    if(m==v+24||m==v+49||m==v+74){emit_contra(&w,&st,s,v,m);}
                }
                if(f_probe(v,variant)==1&&m==v+30){emit_probe(&w,&st,s,v,m);}
            }
            s=s+1;
        }

        // ---- 2. revision sweep (mandatory, evidence-driven) ----
        revision_sweep(&w,&st,m);

        // ---- 3. corroboration response: Site-1 (identical all arms) ----
        s=0;
        while(s<cap){
            let dnew:[]u8=w.d_newc;
            let dcnn:[]u8=w.d_contra_n;
            if(st_i32_get(dval,s*4)!=-1&&st_i32_get(dnew,s*4)==1&&st_i32_get(dcnn,s*4)==0){
                site1_n(&w,&st,s,m);
            }
            s=s+1;
        }

        // ---- 4. scheduled pressure: free 2 slots ----
        if(m==100||m==200||m==300||m==400||m==499){
            pressure_event(&w,&st,m,2,0);
        }

        // ---- 5. admission (default strength 0, all arms) ----
        let slot_out:i32=-1;
        let arc:i32=st_add(&st,m,ST_REGION_USER,0,&slot_out);
        if(arc!=ST_OK){
            let freed:i32=pressure_event(&w,&st,m,1,1);
            if(freed>=1){
                slot_out=-1;
                arc=st_add(&st,m,ST_REGION_USER,0,&slot_out);
            }
        }
        if(arc==ST_OK){
            let ns:i32=slot_out;
            st_i32_set(dval,ns*4,m);
            let dcor:[]u8=w.d_corrob;
            let dcnn:[]u8=w.d_contra_n;
            let dcit:[]u8=w.d_cited;
            let djus:[]u8=w.d_just;
            let dwek:[]u8=w.d_weakx;
            let dnew:[]u8=w.d_newc;
            let ddes:[]u8=w.d_desig;
            st_i32_set(dcor,ns*4,0);
            st_i32_set(dcnn,ns*4,0);
            st_i32_set(dcit,ns*4,0);
            st_i32_set(djus,ns*4,0);
            st_i32_set(dwek,ns*4,0);
            st_i32_set(dnew,ns*4,0);
            st_i32_set(ddes,ns*4,0);
            let acls:i32=f_class(m);
            if(acls==1){w.admitted_right_imp=w.admitted_right_imp+1;}
            if(acls==2){w.admitted_wrong=w.admitted_wrong+1;}
            if(acls==3){w.admitted_implant=w.admitted_implant+1;}
            if(f_designated(m)==1){
                w.admitted_designated=w.admitted_designated+1;
                st_i32_set(ddes,ns*4,1);
                emit_mark(&w,&st,ns,m,m);
            }
        } else {
            w.n_drops=w.n_drops+1;
            let dcls:i32=f_class(m);
            if(dcls==1){w.dropped_right_imp=w.dropped_right_imp+1;}
            else if(dcls==2){w.dropped_wrong=w.dropped_wrong+1;}
            else if(dcls==3){w.dropped_implant=w.dropped_implant+1;}
            else {w.dropped_junk=w.dropped_junk+1;}
        }

        m=m+1;
    }

    // ---- end of run: held-class scan ----
    let held_ri:i32=0;
    let held_w:i32=0;
    let held_im:i32=0;
    let held_j:i32=0;
    let s:i32=0;
    while(s<cap){
        if(st_i32_get(dval,s*4)!=-1){
            let v:i32=st_i32_get(dval,s*4);
            let cls:i32=f_class(v);
            if(cls==1){held_ri=held_ri+1;}
            if(cls==2){held_w=held_w+1;}
            if(cls==3){held_im=held_im+1;}
            if(cls==0){held_j=held_j+1;}
        }
        s=s+1;
    }

    // ---- provenance: INTENSITY_READ recomputation is the independent
    // checker's job (I-R-2); the trial performs no felt_* calls here. ----
    let n_reads:i32=0;
    // ---- op census ----
    let census:[]u8=nio_alloc((RP_OP_MAX+1)*4);
    let ci:i32=0;
    while(ci<=RP_OP_MAX){st_i32_set(census,ci*4,0);ci=ci+1;}
    let over_max:i32=0;
    ri=0;
    while(ri<st.audit_n){
        let e:i32=ri*64;
        let op:i32=st_i32_get(st.audit,e+0);
        if(op>=0&&op<=RP_OP_MAX){
            st_i32_set(census,op*4,st_i32_get(census,op*4)+1);
        } else {
            over_max=over_max+1;
        }
        ri=ri+1;
    }
    let replay_rc:i32=st_replay_check(&st);

    // ---- audit fingerprint ----
    let fp:i64=0;
    ri=0;
    while(ri<st.audit_n){
        let e:i32=ri*64;
        let op:i32=st_i32_get(st.audit,e+0);
        let sl:i32=st_i32_get(st.audit,e+4);
        let d1:i32=st_i32_get(st.audit,e+56);
        let d2:i32=st_i32_get(st.audit,e+60);
        fp=(fp*31+(op*7+sl*13+d1*17+d2) as i64)%2147483647;
        ri=ri+1;
    }

    // ---- emit metrics ----
    pmetric("arm_code",arm);
    pmetric("variant",variant);
    pmetric("prior",FV_PRIOR);
    pmetric("cal_alpha",CAL_ALPHA);
    pmetric("cal_beta",CAL_BETA);
    pmetric("cal_gamma",CAL_GAMMA);
    pmetric("audit_n",st.audit_n);
    pmetric("admitted_right_imp",w.admitted_right_imp);
    pmetric("admitted_wrong",w.admitted_wrong);
    pmetric("admitted_implant",w.admitted_implant);
    pmetric("admitted_designated",w.admitted_designated);
    pmetric("dropped_right_imp",w.dropped_right_imp);
    pmetric("dropped_wrong",w.dropped_wrong);
    pmetric("dropped_implant",w.dropped_implant);
    pmetric("dropped_junk",w.dropped_junk);
    pmetric("held_right_imp",held_ri);
    pmetric("held_wrong",held_w);
    pmetric("held_implant",held_im);
    pmetric("held_junk",held_j);
    pmetric("revised_wrong",w.revised_wrong);
    pmetric("revised_implant",w.revised_implant);
    pmetric("revised_rightimp",w.revised_rightimp);
    pmetric("killed_rightimp",w.killed_rightimp);
    pmetric("kill_c0",w.kill_c0);
    pmetric("kill_c1",w.kill_c1);
    pmetric("kill_c2",w.kill_c2);
    pmetric("kill_c3",w.kill_c3);
    pmetric("wrong_churn",w.wrong_churn);
    pmetric("implant_churn",w.implant_churn);
    pmetric("rightimp_churn",w.rightimp_churn);
    pmetric("n_reads",n_reads);
    pmetric("n_strengthen",w.n_strengthen);
    pmetric("n_weaken",w.n_weaken);
    pmetric("n_trainer",w.n_trainer);
    pmetric("n_probe",w.n_probe);
    pmetric("n_kill_refused",w.n_kill_refused);
    pmetric("n_drops",w.n_drops);
    pmetric("n_pressure_short",w.n_pressure_short);
    pmetric("n_rehearse",w.n_rehearse);
    pmetric("rh_c0",w.rh_c0);
    pmetric("rh_c1",w.rh_c1);
    pmetric("rh_c2",w.rh_c2);
    pmetric("rh_c3",w.rh_c3);
    pmetric("op_over_max",over_max);
    _zag_print("FELT_CHECK,replay,");cl_number(replay_rc as i64);
    _zag_print(",");cl_number(ST_OK as i64);_zag_println("");
    _zag_print("FELT_FINGERPRINT,");cl_number(fp);_zag_println("");
    ci=0;
    while(ci<=RP_OP_MAX){
        let okc:i32=st_i32_get(census,ci*4);
        if(okc>0){
            _zag_print("FELT_OPCENSUS,");cl_number(ci as i64);
            _zag_print(",");cl_number(okc as i64);_zag_println("");
        }
        ci=ci+1;
    }
    _zag_println("FELT_DONE");

    let drc:i32=rp_write_dump(&st,dumpname);
    nio_free(census);
    st_free(&st);
    return drc;
}

fn main()i32 {
    let m1:[]u8=_zag_arg(1);
    let arm:i32=-1;
    if(_zag_strcmp(m1,"f")==1){arm=0;}
    else if(_zag_strcmp(m1,"r")==1){arm=1;}
    else if(_zag_strcmp(m1,"q")==1){arm=2;}
    else if(_zag_strcmp(m1,"fifo")==1){arm=3;}
    else if(_zag_strcmp(m1,"c")==1){arm=4;}
    if(arm==-1){
        _zag_println("RP_BADMODE");
        return 1;
    }
    let m2:[]u8=_zag_arg(2);
    let variant:i32=-1;
    if(_zag_strcmp(m2,"0")==1){variant=0;}
    else if(_zag_strcmp(m2,"1")==1){variant=1;}
    else if(_zag_strcmp(m2,"2")==1){variant=2;}
    if(variant==-1){
        _zag_println("RP_BADMODE");
        return 1;
    }
    let m3:[]u8=_zag_arg(3);
    if(m3.len==0){
        _zag_println("RP_BADDUMP");
        return 1;
    }
    _zag_print("RP_CELL,");_zag_print(m1);_zag_print(",");
    cl_number(variant as i64);_zag_println("");
    return run_trial(arm,variant,m3);
}

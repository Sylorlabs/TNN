// reposition_checker.zag — INDEPENDENT checker for FELT-REPOSITION.
// Reads the 30 binary ledger dumps (5 arms x 3 variants x 2 runs) from the
// directory in argv[1]. Re-implements ground truth from scratch; imports
// only the felt module (intensity recomputation) — never the trial.
// Verifies A1-A4, I-R-1..I-R-10; computes RPQ per arm x variant; replays
// each baseline ordering on F's ledger for the four attention-divergence
// numbers; checks budget/window accounting and strength-side byte-identity
// across all five arms per variant (I-R-4); applies the §16(d)
// interpretation rule MECHANICALLY (no judgment).
//
// I-R-4 note (clock-word accounting): the substrate stamps every audit
// entry with clock-derived words (b3 = admission clock, b5/a5 = strength
// clock), and the clock counts ALL entries including the filtered
// REHEARSAL/INTENSITY_READ ones. Strict byte-identity of the filtered
// stream is therefore impossible when arms emit different numbers of
// filtered entries (F emits per-candidate INTENSITY_READs). The checker
// verifies (a) the filtered streams are byte-identical on all NON-clock
// words, and (b) per arm, every clock word is exactly explained by that
// arm's own full-ledger entry indices (b3 == add index, b5/a5 == last
// strength-write index). (a)+(b) proves rehearsal never leaked into any
// strength decision: the only cross-arm differences are the filtered
// entries themselves.
//
// A3(b) operationalization (informational): distinct memories with >=1
// INTENSITY_READ in F's ledger, ranked by max I; top decile = top
// ceil(n/10) by count; share = F REHEARSAL ops on those memories /
// total F REHEARSAL ops, per variant.
@import("felt_v3.zag")
@import("calib_consts.zag")

const RP_OP_REHEARSAL:i32=49;
const RP_OP_MAX:i32=49;
const RP_B:i32=25;
const RP_THETA_RECALL:i32=60;
const CK_NCELL:i32=15;
const CK_CAP:i32=32;

// ============ curriculum ground truth (reimplemented, frozen V3 S8) ============
fn ck_is_implant(m:i32)i32 {
    if(m==0){return 1;}
    if(m==83){return 1;}
    if(m==166){return 1;}
    if(m==250){return 1;}
    if(m==333){return 1;}
    if(m==416){return 1;}
    return 0;
}
fn ck_imp(m:i32)i32 {
    if((m%10)<3){return 1;}
    return 0;
}
fn ck_wrong(m:i32)i32 {
    if(((m+3)%10)<3){return 1;}
    return 0;
}
fn ck_class(m:i32)i32 {
    if(ck_is_implant(m)==1){return 3;}
    if(ck_wrong(m)==1){return 2;}
    if(ck_imp(m)==1){return 1;}
    return 0;
}
fn ck_designated(m:i32)i32 {
    if(ck_is_implant(m)==1){return 0;}
    if(m%10==4||m%10==5){return 1;}
    return 0;
}
fn ck_probe(m:i32,variant:i32)i32 {
    if(ck_class(m)==0&&(m+variant)%5==0){return 1;}
    return 0;
}
fn ck_clamp(v:i32)i32 {
    if(v<0){return 0;}
    if(v>100){return 100;}
    return v;
}

// ============ ledger access ============
// Entry words: op@0 slot@4 rc@8 b1@12 b2@16 b3@20 b4@24 b5@28
//              a1@32 a2@36 a3@40 a4@44 a5@48 stage@52 d1@56 d2@60.
fn ck_w(buf:[]u8,idx:i32,off:i32)i32 {
    return st_i32_get(buf,idx*64+off);
}
fn ck_op(buf:[]u8,idx:i32)i32 {return ck_w(buf,idx,0);}
fn ck_slot(buf:[]u8,idx:i32)i32 {return ck_w(buf,idx,4);}
fn ck_rc(buf:[]u8,idx:i32)i32 {return ck_w(buf,idx,8);}
fn ck_d1(buf:[]u8,idx:i32)i32 {return ck_w(buf,idx,56);}
fn ck_d2(buf:[]u8,idx:i32)i32 {return ck_w(buf,idx,60);}

// Count (C,X,T) observations for (slot,value) over entries [0,upto).
fn ck_cxt(buf:[]u8,slot:i32,v:i32,upto:i32,c:*i32,x:*i32,t:*i32)void {
    c.*=0;x.*=0;t.*=0;
    let i:i32=0;
    while(i<upto){
        let op:i32=ck_op(buf,i);
        if(op==FV_OP_OBS_CORROBORATE||op==FV_OP_OBS_CONTRADICT||op==FV_OP_OBS_TRAINER_MARK){
            if(ck_slot(buf,i)==slot&&ck_d1(buf,i)==v){
                if(op==FV_OP_OBS_CORROBORATE){c.*=c.*+1;}
                else if(op==FV_OP_OBS_CONTRADICT){x.*=x.*+1;}
                else{t.*=t.*+1;}
            }
        }
        i=i+1;
    }
}
// Count observations for value v (any slot) over entries [0,upto).
fn ck_cxt_v(buf:[]u8,v:i32,upto:i32,c:*i32,x:*i32,t:*i32)void {
    c.*=0;x.*=0;t.*=0;
    let i:i32=0;
    while(i<upto){
        let op:i32=ck_op(buf,i);
        if(op==FV_OP_OBS_CORROBORATE||op==FV_OP_OBS_CONTRADICT||op==FV_OP_OBS_TRAINER_MARK){
            if(ck_d1(buf,i)==v){
                if(op==FV_OP_OBS_CORROBORATE){c.*=c.*+1;}
                else if(op==FV_OP_OBS_CONTRADICT){x.*=x.*+1;}
                else{t.*=t.*+1;}
            }
        }
        i=i+1;
    }
}
fn ck_reh_n(buf:[]u8,n:i32,v:i32)i32 {
    let k:i32=0;
    let i:i32=0;
    while(i<n){
        if(ck_op(buf,i)==RP_OP_REHEARSAL&&ck_d1(buf,i)==v){k=k+1;}
        i=i+1;
    }
    return k;
}

// ============ dump filenames (5 arms x 3 variants x 2 runs) ============
fn ck_name(arm:i32,variant:i32,run:i32)[]u8 {
    if(arm==0&&variant==0&&run==0){return "L_f_v0_r0.bin";}
    if(arm==0&&variant==0&&run==1){return "L_f_v0_r1.bin";}
    if(arm==0&&variant==1&&run==0){return "L_f_v1_r0.bin";}
    if(arm==0&&variant==1&&run==1){return "L_f_v1_r1.bin";}
    if(arm==0&&variant==2&&run==0){return "L_f_v2_r0.bin";}
    if(arm==0&&variant==2&&run==1){return "L_f_v2_r1.bin";}
    if(arm==1&&variant==0&&run==0){return "L_r_v0_r0.bin";}
    if(arm==1&&variant==0&&run==1){return "L_r_v0_r1.bin";}
    if(arm==1&&variant==1&&run==0){return "L_r_v1_r0.bin";}
    if(arm==1&&variant==1&&run==1){return "L_r_v1_r1.bin";}
    if(arm==1&&variant==2&&run==0){return "L_r_v2_r0.bin";}
    if(arm==1&&variant==2&&run==1){return "L_r_v2_r1.bin";}
    if(arm==2&&variant==0&&run==0){return "L_q_v0_r0.bin";}
    if(arm==2&&variant==0&&run==1){return "L_q_v0_r1.bin";}
    if(arm==2&&variant==1&&run==0){return "L_q_v1_r0.bin";}
    if(arm==2&&variant==1&&run==1){return "L_q_v1_r1.bin";}
    if(arm==2&&variant==2&&run==0){return "L_q_v2_r0.bin";}
    if(arm==2&&variant==2&&run==1){return "L_q_v2_r1.bin";}
    if(arm==3&&variant==0&&run==0){return "L_fifo_v0_r0.bin";}
    if(arm==3&&variant==0&&run==1){return "L_fifo_v0_r1.bin";}
    if(arm==3&&variant==1&&run==0){return "L_fifo_v1_r0.bin";}
    if(arm==3&&variant==1&&run==1){return "L_fifo_v1_r1.bin";}
    if(arm==3&&variant==2&&run==0){return "L_fifo_v2_r0.bin";}
    if(arm==3&&variant==2&&run==1){return "L_fifo_v2_r1.bin";}
    if(arm==4&&variant==0&&run==0){return "L_c_v0_r0.bin";}
    if(arm==4&&variant==0&&run==1){return "L_c_v0_r1.bin";}
    if(arm==4&&variant==1&&run==0){return "L_c_v1_r0.bin";}
    if(arm==4&&variant==1&&run==1){return "L_c_v1_r1.bin";}
    if(arm==4&&variant==2&&run==0){return "L_c_v2_r0.bin";}
    if(arm==4&&variant==2&&run==1){return "L_c_v2_r1.bin";}
    return "";
}
fn ck_armname(arm:i32)[]u8 {
    if(arm==0){return "f";}
    if(arm==1){return "r";}
    if(arm==2){return "q";}
    if(arm==3){return "fifo";}
    return "c";
}

// ============ checker state ============
struct CkW {
    rpq_num:[]u8,   // 15 i32: correct probes
    rpq_den:[]u8,   // 15 i32: n_probes
    rh_total:[]u8,  // 15 i32
    rh_bad:[]u8,    // 15 i32: ops on junk/wrong/implant
    n_reads:[]u8,   // 15 i32
    a1_bad:[]u8,    // 15 i32
    a2_bad:[]u8,    // 15 i32
    a3_bad:[]u8,    // 15 i32
    ir2_bad:[]u8,   // 15 i32 (I-R-2 recompute failures)
    ir6_bad:[]u8,   // 15 i32 (I-R-6: INTENSITY_READ outside F)
    win_bad:[]u8,   // 15 i32 (window/budget accounting)
    div_d:[]u8,     // 12 i32: per variant x baseline differ
    div_t:[]u8,     // 12 i32: per variant x baseline total
    ir4_bad:[]u8,   // 3 i32
    a3b_num:[]u8,   // 3 i32
    a3b_den:[]u8,   // 3 i32
    n_invalid:i32
}

fn ck_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("CK_CHECK,");_zag_print(name);_zag_print(",");
    cl_number(actual as i64);_zag_print(",");
    cl_number(expected as i64);_zag_println("");
    if(actual!=expected){return 1;}
    return 0;
}
fn ck_note(name:[]u8,val:i32)void {
    _zag_print("CK_NOTE,");_zag_print(name);_zag_print(",");
    cl_number(val as i64);_zag_println("");
}

// Verify one OBS_* entry against the frozen curriculum schedule.
// Returns 1 if the entry is unscheduled (manufactured) or inconsistent.
fn ck_obs_ok(buf:[]u8,idx:i32,variant:i32,slot_of_v:[]u8) i32 {
    let op:i32=ck_op(buf,idx);
    let s:i32=ck_slot(buf,idx);
    let v:i32=ck_d1(buf,idx);
    let m:i32=ck_d2(buf,idx);
    if(v<0||v>=500){return 1;}
    if(m<0||m>=500){return 1;}
    if(s<0||s>=CK_CAP){return 1;}
    if(st_i32_get(slot_of_v,v*4)!=s){return 1;}
    let cls:i32=ck_class(v);
    if(op==FV_OP_OBS_CORROBORATE){
        if(cls==1&&(m==v+25||m==v+40)){return 0;}
        if(cls==3&&m==v+10){return 0;}
        return 1;
    }
    if(op==FV_OP_OBS_CONTRADICT){
        if(cls==2&&(m==v+60||m==v+85||m==v+110||m==v+135)){return 0;}
        if(cls==3&&(m==v+24||m==v+49||m==v+74)){return 0;}
        return 1;
    }
    if(op==FV_OP_OBS_TRAINER_MARK){
        if(ck_designated(v)==1&&m==v){return 0;}
        return 1;
    }
    if(op==FV_OP_OBS_PROBE){
        if(ck_probe(v,variant)==1&&m==v+30){return 0;}
        return 1;
    }
    return 1;
}

// ============ per-ledger probe scan ============
// Single sequential pass. Verifies: replay (rc), op census, I-R-2/A1(c),
// A1(a), A2(a-d), A3(a), I-R-6, window/budget accounting; accumulates RPQ
// inputs and per-class rehearsal shares. Records into w arrays at [cell].
fn ck_scan(w:*CkW,sh:*StStore,buf:[]u8,n:i32,arm:i32,variant:i32,cell:i32)i32 {
    let bad:i32=0;
    // Independent replay: every before-snapshot matches the replayed prefix.
    bad=bad+ck_check("replay",ck_replay_verify(buf,n),0);

    let live:[]u8=nio_alloc(CK_CAP);
    let val:[]u8=nio_alloc(CK_CAP*4);
    let slot_of_v:[]u8=nio_alloc(500*4);
    let rd_v:[]u8=nio_alloc(CK_CAP*4);
    let rd_d2:[]u8=nio_alloc(CK_CAP*4);
    let last_ri:[]u8=nio_alloc(500*4);
    let last_rI:[]u8=nio_alloc(500*4);
    let win_seen:[]u8=nio_alloc(10*4);
    let win_ops:[]u8=nio_alloc(10*4);
    let blk_live:[]u8=nio_alloc(CK_CAP);
    let blk_val:[]u8=nio_alloc(CK_CAP*4);
    let blk_seen:[]u8=nio_alloc(CK_CAP*4);
    let i:i32=0;
    while(i<CK_CAP){live[i]=0;st_i32_set(val,i*4,-1);st_i32_set(rd_v,i*4,-1);i=i+1;}
    i=0;while(i<500){st_i32_set(slot_of_v,i*4,-1);st_i32_set(last_ri,i*4,-1);i=i+1;}
    i=0;while(i<10){st_i32_set(win_seen,i*4,0);st_i32_set(win_ops,i*4,0);i=i+1;}

    let next_v:i32=0;
    let pend_fail:i32=0;
    let n_fail:i32=0;
    let n_ok:i32=0;
    let n_dropped:i32=0;
    let last_add_v:i32=-1;
    let n_reads:i32=0;
    let a1_bad:i32=0;
    let a2_bad:i32=0;
    let a3_bad:i32=0;
    let ir2_bad:i32=0;
    let ir6_bad:i32=0;
    let rh_total:i32=0;
    let rh_bad:i32=0;
    let in_block:i32=0;
    let blk_window:i32=-1;
    let blk_start:i32=0;
    let blk_ops:i32=0;
    let blk_reads:i32=0;
    let blk_n:i32=0;
    let blk_live_n:i32=0;

    let idx:i32=0;
    while(idx<n){
        let op:i32=ck_op(buf,idx);
        let s:i32=ck_slot(buf,idx);
        let rc:i32=ck_rc(buf,idx);
        let d1:i32=ck_d1(buf,idx);
        let d2:i32=ck_d2(buf,idx);
        if(op<0||op>RP_OP_MAX){
            bad=bad+1;
            ck_note("op_over_max",op);
        }
        // ---- admission tracking (episode order, drop-tolerant) ----
        if(op==ST_OP_ADD){
            if(rc==ST_OK){
                let v:i32=ck_w(buf,idx,36);
                if(v<next_v){bad=bad+1;ck_note("add_order_back",v);}
                else{
                    let skipped:i32=v-next_v;
                    if(skipped>0){
                        if(pend_fail==0){bad=bad+1;ck_note("add_order_skip",v);}
                        n_dropped=n_dropped+skipped;
                    }
                }
                if(s>=0&&s<CK_CAP){
                    live[s]=1;st_i32_set(val,s*4,v);
                    if(v>=0&&v<500){st_i32_set(slot_of_v,v*4,s);}
                    st_i32_set(rd_v,s*4,-1);
                }
                last_add_v=v;
                next_v=v+1;
                pend_fail=0;
                n_fail=0;
                n_ok=n_ok+1;
            } else {
                pend_fail=1;
                n_fail=n_fail+1;
            }
        }
        // ---- selection block tracking (INTENSITY_READ*/REHEARSAL runs) ----
        let is_sel:i32=0;
        if(op==FV_OP_INTENSITY_READ||op==RP_OP_REHEARSAL){is_sel=1;}
        if(is_sel==1&&in_block==0){
            in_block=1;
            // Window = the episode now starting (all episodes < next_v resolved).
            // Robust to drops: the trial keys windows off the episode counter.
            blk_window=next_v;
            blk_start=idx;
            blk_ops=0;blk_reads=0;blk_n=0;blk_live_n=0;
            let q:i32=0;
            while(q<CK_CAP){
                blk_live[q]=live[q];
                st_i32_set(blk_val,q*4,st_i32_get(val,q*4));
                if(live[q]==1){blk_live_n=blk_live_n+1;}
                q=q+1;
            }
        }
        if(is_sel==0&&in_block==1){
            // block ends: verify it
            let widx:i32=blk_window/50;
            if(blk_window%50!=0||blk_window<50||blk_window>=500||widx<1||widx>9){
                a2_bad=a2_bad+1;ck_note("block_window",blk_window);
            } else {
                if(st_i32_get(win_seen,widx*4)==1){a2_bad=a2_bad+1;ck_note("block_dup",blk_window);}
                st_i32_set(win_seen,widx*4,1);
                st_i32_set(win_ops,widx*4,blk_ops);
                let want:i32=RP_B;
                if(blk_live_n<want){want=blk_live_n;}
                if(blk_ops!=want){a2_bad=a2_bad+1;ck_note("block_ops",blk_ops);}
                if(arm==0&&blk_reads!=blk_live_n){a2_bad=a2_bad+1;ck_note("block_reads",blk_reads);}
                if(arm!=0&&blk_reads!=0){ir6_bad=ir6_bad+1;ck_note("nonf_reads",blk_reads);}
            }
            in_block=0;
        }
        if(op==FV_OP_INTENSITY_READ){
            n_reads=n_reads+1;
            if(arm!=0){ir6_bad=ir6_bad+1;}
            if(in_block==1){blk_reads=blk_reads+1;}
            if(felt_recompute_ok_p(sh,idx,CAL_ALPHA,CAL_BETA,CAL_GAMMA)!=1){
                ir2_bad=ir2_bad+1;
            }
            // A2(b): remember this read for the rehearsal citation check
            if(s>=0&&s<CK_CAP){st_i32_set(rd_v,s*4,d1);st_i32_set(rd_d2,s*4,d2);}
            // A3(a): ΔI with no intervening OBS_* must be 0
            if(d1>=0&&d1<500){
                let inten:i32=felt_unpack_intensity(d2);
                let li:i32=st_i32_get(last_ri,d1*4);
                if(li>=0){
                    let j:i32=li+1;
                    let intervened:i32=0;
                    while(j<idx){
                        let jo:i32=ck_op(buf,j);
                        if((jo==FV_OP_OBS_CORROBORATE||jo==FV_OP_OBS_CONTRADICT||
                            jo==FV_OP_OBS_TRAINER_MARK||jo==FV_OP_OBS_PROBE)&&
                           ck_d1(buf,j)==d1){intervened=1;break;}
                        j=j+1;
                    }
                    if(intervened==0&&inten!=st_i32_get(last_rI,d1*4)){
                        a3_bad=a3_bad+1;ck_note("a3_dI",d1);
                    }
                }
                st_i32_set(last_ri,d1*4,idx);
                st_i32_set(last_rI,d1*4,inten);
            }
        }
        if(op==RP_OP_REHEARSAL){
            rh_total=rh_total+1;
            if(in_block==1){blk_ops=blk_ops+1;}
            // A2(a): target live at window start; (b): cited I == read I
            if(s<0||s>=CK_CAP||blk_live[s]==0||st_i32_get(blk_val,s*4)!=d1){
                a2_bad=a2_bad+1;ck_note("a2_target",d1);
            } else {
                // ≤1 op per memory per window
                let q:i32=0;let dup:i32=0;
                while(q<blk_n){
                    if(st_i32_get(blk_seen,q*4)==d1){dup=1;}
                    q=q+1;
                }
                if(dup==1){a2_bad=a2_bad+1;ck_note("a2_dup",d1);}
                else{if(blk_n<CK_CAP){st_i32_set(blk_seen,blk_n*4,d1);blk_n=blk_n+1;}}
                if(arm==0){
                    if(st_i32_get(rd_v,s*4)!=d1||st_i32_get(rd_d2,s*4)!=d2){
                        a2_bad=a2_bad+1;ck_note("a2_cite",d1);
                    }
                }
            }
            if(ck_class(d1)!=1){rh_bad=rh_bad+1;}
        }
        // ---- A1(a): every OBS_* matches the frozen schedule ----
        if(op==FV_OP_OBS_CORROBORATE||op==FV_OP_OBS_CONTRADICT||
           op==FV_OP_OBS_TRAINER_MARK||op==FV_OP_OBS_PROBE){
            if(ck_obs_ok(buf,idx,variant,slot_of_v)==1){
                a1_bad=a1_bad+1;ck_note("a1_obs",idx);
            }
        }
        // ---- kills clear tracking ----
        if((op==ST_OP_KILL||op==ST_OP_KILL_EVIDENCED)&&rc==ST_OK){
            if(s>=0&&s<CK_CAP){
                live[s]=0;st_i32_set(val,s*4,-1);st_i32_set(rd_v,s*4,-1);
            }
        }
        idx=idx+1;
    }
    if(in_block==1){
        a2_bad=a2_bad+1;ck_note("block_unclosed",blk_window);
    }
    // window completeness: exactly windows {50..450} selected once each
    let wj:i32=1;
    while(wj<10){
        if(st_i32_get(win_seen,wj*4)!=1){a2_bad=a2_bad+1;ck_note("window_missing",wj*50);}
        wj=wj+1;
    }
    if(pend_fail==1){n_dropped=n_dropped+1;}
    if(n_ok+n_dropped!=500){bad=bad+1;ck_note("episodes",n_ok);}

    // ---- RPQ: held-out recall quality over admitted right-important ----
    let correct:i32=0;
    let nprobes:i32=0;
    let v:i32=0;
    while(v<500){
        if(st_i32_get(slot_of_v,v*4)>=0&&ck_class(v)==1){
            let c:i32=0;let x:i32=0;let t:i32=0;
            ck_cxt_v(buf,v,n,&c,&x,&t);
            let reh:i32=ck_reh_n(buf,n,v);
            let r5:i32=reh;
            if(r5>5){r5=5;}
            let sc:i32=ck_clamp(40+10*c-5*x+5*t+8*r5);
            nprobes=nprobes+1;
            if(sc>=RP_THETA_RECALL){correct=correct+1;}
        }
        v=v+1;
    }

    st_i32_set(w.*.rpq_num,cell*4,correct);
    st_i32_set(w.*.rpq_den,cell*4,nprobes);
    st_i32_set(w.*.rh_total,cell*4,rh_total);
    st_i32_set(w.*.rh_bad,cell*4,rh_bad);
    st_i32_set(w.*.n_reads,cell*4,n_reads);
    st_i32_set(w.*.a1_bad,cell*4,a1_bad);
    st_i32_set(w.*.a2_bad,cell*4,a2_bad);
    st_i32_set(w.*.a3_bad,cell*4,a3_bad);
    st_i32_set(w.*.ir2_bad,cell*4,ir2_bad);
    st_i32_set(w.*.ir6_bad,cell*4,ir6_bad);
    st_i32_set(w.*.win_bad,cell*4,0);
    ck_note("cell_done",cell);
    nio_free(live);nio_free(val);nio_free(slot_of_v);nio_free(rd_v);
    nio_free(rd_d2);nio_free(last_ri);nio_free(last_rI);nio_free(win_seen);
    nio_free(win_ops);nio_free(blk_live);nio_free(blk_val);nio_free(blk_seen);
    return bad;
}

// ============ attention-divergence replay ============
// Replays one baseline ordering (0=R,1=Q,2=FIFO,3=C) over the candidate
// set snapshot at a window block, using the ledger prefix strictly before
// the block, and returns |F_sel \ B_sel| (set difference — the count of
// F's rehearsal picks the baseline would not have made).
fn ck_replay_base(buf:[]u8,upto:i32,blk_live:[]u8,blk_val:[]u8,
                  fsel:[]u8,fsel_n:i32,base:i32)i32 {
    let cs:[]u8=nio_alloc(32*4);
    let picked:[]u8=nio_alloc(32);
    let bsel:[]u8=nio_alloc(32*4);
    let nc:i32=0;
    let s:i32=0;
    while(s<CK_CAP){
        if(blk_live[s]==1){st_i32_set(cs,nc*4,s);nc=nc+1;}
        picked[s]=0;
        s=s+1;
    }
    let ops:i32=0;
    while(ops<fsel_n&&ops<nc){
        let best:i32=-1;
        let bv:i32=0;let bq:i32=0;let bt:i32=0;let bc:i32=0;
        let k:i32=0;
        while(k<nc){
            let cand:i32=st_i32_get(cs,k*4);
            if(picked[cand]==0){
                let vv:i32=st_i32_get(blk_val,cand*4);
                if(base==0){
                    if(best==-1||vv>bv||(vv==bv&&cand<best)){best=cand;bv=vv;}
                } else if(base==1){
                    let c:i32=0;let x:i32=0;let t:i32=0;
                    ck_cxt(buf,cand,vv,upto,&c,&x,&t);
                    let qv:i32=c+x+t;
                    if(best==-1||qv>bq||(qv==bq&&vv<bv)){best=cand;bq=qv;bv=vv;}
                } else if(base==2){
                    if(best==-1||vv<bv||(vv==bv&&cand<best)){best=cand;bv=vv;}
                } else {
                    let c:i32=0;let x:i32=0;let t:i32=0;
                    ck_cxt(buf,cand,vv,upto,&c,&x,&t);
                    let tier:i32=0;
                    if(c>=2){tier=1;}
                    if(best==-1||tier>bt||(tier==bt&&c>bc)||(tier==bt&&c==bc&&vv<bv)){
                        best=cand;bt=tier;bc=c;bv=vv;
                    }
                }
            }
            k=k+1;
        }
        picked[best]=1;
        st_i32_set(bsel,ops*4,st_i32_get(blk_val,best*4));
        ops=ops+1;
    }
    let differ:i32=0;
    let f:i32=0;
    while(f<fsel_n){
        let fv:i32=st_i32_get(fsel,f*4);
        let hit:i32=0;
        let g:i32=0;
        while(g<ops){
            if(st_i32_get(bsel,g*4)==fv){hit=1;}
            g=g+1;
        }
        if(hit==0){differ=differ+1;}
        f=f+1;
    }
    nio_free(cs);nio_free(picked);nio_free(bsel);
    return differ;
}

// Replay all four baselines on every window block of F's ledger.
fn ck_diverge(w:*CkW,fbuf:[]u8,fn_:i32,variant:i32)void {
    let live:[]u8=nio_alloc(CK_CAP);
    let val:[]u8=nio_alloc(CK_CAP*4);
    let blk_live:[]u8=nio_alloc(CK_CAP);
    let blk_val:[]u8=nio_alloc(CK_CAP*4);
    let fsel:[]u8=nio_alloc(CK_CAP*4);
    let i:i32=0;
    while(i<CK_CAP){live[i]=0;st_i32_set(val,i*4,-1);i=i+1;}
    let in_block:i32=0;
    let blk_start:i32=0;
    let fsel_n:i32=0;
    let idx:i32=0;
    while(idx<fn_){
        let op:i32=ck_op(fbuf,idx);
        let s:i32=ck_slot(fbuf,idx);
        let rc:i32=ck_rc(fbuf,idx);
        if(op==ST_OP_ADD&&rc==ST_OK){
            let v:i32=ck_w(fbuf,idx,36);
            if(s>=0&&s<CK_CAP){live[s]=1;st_i32_set(val,s*4,v);}
        }
        if((op==ST_OP_KILL||op==ST_OP_KILL_EVIDENCED)&&rc==ST_OK){
            if(s>=0&&s<CK_CAP){live[s]=0;st_i32_set(val,s*4,-1);}
        }
        let is_sel:i32=0;
        if(op==FV_OP_INTENSITY_READ||op==RP_OP_REHEARSAL){is_sel=1;}
        if(is_sel==1&&in_block==0){
            in_block=1;blk_start=idx;fsel_n=0;
            let q:i32=0;
            while(q<CK_CAP){
                blk_live[q]=live[q];
                st_i32_set(blk_val,q*4,st_i32_get(val,q*4));
                q=q+1;
            }
        }
        if(is_sel==0&&in_block==1){
            let b:i32=0;
            while(b<4){
                let differ:i32=ck_replay_base(fbuf,blk_start,blk_live,blk_val,fsel,fsel_n,b);
                let di:i32=(variant*4+b)*4;
                st_i32_set(w.*.div_d,di,st_i32_get(w.*.div_d,di)+differ);
                st_i32_set(w.*.div_t,di,st_i32_get(w.*.div_t,di)+fsel_n);
                b=b+1;
            }
            in_block=0;
        }
        if(op==RP_OP_REHEARSAL&&in_block==1){
            st_i32_set(fsel,fsel_n*4,ck_d1(fbuf,idx));
            fsel_n=fsel_n+1;
        }
        idx=idx+1;
    }
    nio_free(live);nio_free(val);nio_free(blk_live);nio_free(blk_val);nio_free(fsel);
}

// ============ I-R-4: strength-side byte-identity ============
fn ck_buf(a:i32,b0:[]u8,b1:[]u8,b2:[]u8,b3:[]u8,b4:[]u8)[]u8 {
    if(a==0){return b0;}
    if(a==1){return b1;}
    if(a==2){return b2;}
    if(a==3){return b3;}
    return b4;
}
fn ck_len(a:i32,n0:i32,n1:i32,n2:i32,n3:i32,n4:i32)i32 {
    if(a==0){return n0;}
    if(a==1){return n1;}
    if(a==2){return n2;}
    if(a==3){return n3;}
    return n4;
}
fn ck_kth(fall:[]u8,nmax:i32,a:i32,k:i32)i32 {
    return st_i32_get(fall,(a*nmax+k)*4);
}
// Per-arm clock-word accounting: every b3/b5/a5 exactly explained by the
// arm's own full-ledger entry indices.
fn ck_clock_ok(buf:[]u8,n:i32)i32 {
    let bad:i32=0;
    let last_str:[]u8=nio_alloc(CK_CAP*4);
    let add_idx:[]u8=nio_alloc(CK_CAP*4);
    let s:i32=0;
    while(s<CK_CAP){st_i32_set(last_str,s*4,-1);st_i32_set(add_idx,s*4,-1);s=s+1;}
    let idx:i32=0;
    while(idx<n){
        let op:i32=ck_op(buf,idx);
        let sl:i32=ck_slot(buf,idx);
        let rc:i32=ck_rc(buf,idx);
        let b3:i32=ck_w(buf,idx,20);
        let b5:i32=ck_w(buf,idx,28);
        let a3:i32=ck_w(buf,idx,40);
        let a5:i32=ck_w(buf,idx,48);
        if(sl>=0&&sl<CK_CAP){
            let exp_b3:i32=st_i32_get(add_idx,sl*4);
            if(exp_b3<0){exp_b3=0;}
            let exp_b5:i32=st_i32_get(last_str,sl*4);
            if(exp_b5<0){exp_b5=0;}
            if(b3!=exp_b3){bad=bad+1;}
            if(b5!=exp_b5){bad=bad+1;}
            let is_write:i32=0;
            if((op==ST_OP_ADD||op==ST_OP_STRENGTHEN||op==ST_OP_WEAKEN||
                op==ST_OP_OVERWRITE)&&rc==ST_OK){is_write=1;}
            if(is_write==1){
                if(a5!=idx){bad=bad+1;}
                st_i32_set(last_str,sl*4,idx);
                if(op==ST_OP_ADD){
                    st_i32_set(add_idx,sl*4,idx);
                    if(a3!=idx){bad=bad+1;}
                } else {
                    if(a3!=b3){bad=bad+1;}
                }
            } else if((op==ST_OP_KILL||op==ST_OP_KILL_EVIDENCED)&&rc==ST_OK){
                if(a5!=0){bad=bad+1;}
                st_i32_set(last_str,sl*4,-1);
                st_i32_set(add_idx,sl*4,-1);
            } else {
                if(a5!=b5){bad=bad+1;}
            }
        }
        idx=idx+1;
    }
    nio_free(last_str);nio_free(add_idx);
    return bad;
}

fn ck_ir4(w:*CkW,b0:[]u8,n0:i32,b1:[]u8,n1:i32,b2:[]u8,n2:i32,
          b3:[]u8,n3:i32,b4:[]u8,n4:i32,variant:i32)i32 {
    let bad:i32=0;
    let nmax:i32=n0;
    if(n1>nmax){nmax=n1;}
    if(n2>nmax){nmax=n2;}
    if(n3>nmax){nmax=n3;}
    if(n4>nmax){nmax=n4;}
    // filtered entry-index arrays per arm
    let fall:[]u8=nio_alloc(5*nmax*4);
    let flen:[]u8=nio_alloc(5*4);
    let a:i32=0;
    while(a<5){
        let buf:[]u8=ck_buf(a,b0,b1,b2,b3,b4);
        let n:i32=ck_len(a,n0,n1,n2,n3,n4);
        let c:i32=0;
        let idx:i32=0;
        while(idx<n){
            let op:i32=ck_op(buf,idx);
            if(op!=FV_OP_INTENSITY_READ&&op!=RP_OP_REHEARSAL){
                st_i32_set(fall,(a*nmax+c)*4,idx);
                c=c+1;
            }
            idx=idx+1;
        }
        st_i32_set(flen,a*4,c);
        a=a+1;
    }
    a=1;
    while(a<5){
        bad=bad+ck_check("ir4_flen",st_i32_get(flen,a*4),st_i32_get(flen,0*4));
        a=a+1;
    }
    // masked compare: all words except clock words b3@20 a3@40 b5@28 a5@48
    // (step=admission clock, sclk=strength-change clock; both advance per
    // audit entry, so they differ across arms by construction)
    let offs:[]u8=nio_alloc(12*4);
    st_i32_set(offs,0*4,0);st_i32_set(offs,1*4,4);st_i32_set(offs,2*4,8);
    st_i32_set(offs,3*4,12);st_i32_set(offs,4*4,16);st_i32_set(offs,5*4,24);
    st_i32_set(offs,6*4,32);st_i32_set(offs,7*4,36);
    st_i32_set(offs,8*4,44);st_i32_set(offs,9*4,52);st_i32_set(offs,10*4,56);
    st_i32_set(offs,11*4,60);
    let len0:i32=st_i32_get(flen,0);
    let k:i32=0;
    while(k<len0){
        let oi:i32=0;
        while(oi<12){
            let off:i32=st_i32_get(offs,oi*4);
            let e0:i32=ck_kth(fall,nmax,0,k);
            let w0:i32=ck_w(b0,e0,off);
            let aa:i32=1;
            while(aa<5){
                let buf:[]u8=ck_buf(aa,b0,b1,b2,b3,b4);
                let ea:i32=ck_kth(fall,nmax,aa,k);
                if(ck_w(buf,ea,off)!=w0){
                    bad=bad+1;
                    ck_note("ir4_word",k);
                    aa=5;
                }
                aa=aa+1;
            }
            oi=oi+1;
        }
        k=k+1;
    }
    // clock-word accounting per arm
    a=0;
    while(a<5){
        let buf:[]u8=ck_buf(a,b0,b1,b2,b3,b4);
        let n:i32=ck_len(a,n0,n1,n2,n3,n4);
        let cb:i32=ck_clock_ok(buf,n);
        if(cb!=0){bad=bad+cb;ck_note("ir4_clock",a);}
        a=a+1;
    }
    nio_free(fall);nio_free(flen);nio_free(offs);
    st_i32_set(w.*.ir4_bad,variant*4,bad);
    return bad;
}

// ============ A3(b): top-decile-I budget share (informational) ============
fn ck_a3b(w:*CkW,fbuf:[]u8,fn_:i32,variant:i32)void {
    let dv:[]u8=nio_alloc(500*4);
    let di:[]u8=nio_alloc(500*4);
    let nd:i32=0;
    let idx:i32=0;
    while(idx<fn_){
        if(ck_op(fbuf,idx)==FV_OP_INTENSITY_READ){
            let v:i32=ck_d1(fbuf,idx);
            let inten:i32=felt_unpack_intensity(ck_d2(fbuf,idx));
            let f:i32=0;let hit:i32=-1;
            while(f<nd){if(st_i32_get(dv,f*4)==v){hit=f;}f=f+1;}
            if(hit==-1){
                st_i32_set(dv,nd*4,v);st_i32_set(di,nd*4,inten);nd=nd+1;
            } else {
                if(inten>st_i32_get(di,hit*4)){st_i32_set(di,hit*4,inten);}
            }
        }
        idx=idx+1;
    }
    let f:i32=0;
    while(f<nd){
        let g:i32=f+1;let bi:i32=f;
        while(g<nd){
            if(st_i32_get(di,g*4)>st_i32_get(di,bi*4)){bi=g;}
            g=g+1;
        }
        let tv:i32=st_i32_get(dv,f*4);let ti:i32=st_i32_get(di,f*4);
        st_i32_set(dv,f*4,st_i32_get(dv,bi*4));st_i32_set(di,f*4,st_i32_get(di,bi*4));
        st_i32_set(dv,bi*4,tv);st_i32_set(di,bi*4,ti);
        f=f+1;
    }
    let dec:i32=(nd+9)/10;
    let thr:i32=0;
    if(nd>0){thr=st_i32_get(di,(dec-1)*4);}
    let num:i32=0;let den:i32=0;
    idx=0;
    while(idx<fn_){
        if(ck_op(fbuf,idx)==RP_OP_REHEARSAL){
            den=den+1;
            let v:i32=ck_d1(fbuf,idx);
            let g:i32=0;
            while(g<nd){
                if(st_i32_get(dv,g*4)==v&&st_i32_get(di,g*4)>=thr){num=num+1;break;}
                g=g+1;
            }
        }
        idx=idx+1;
    }
    st_i32_set(w.*.a3b_num,variant*4,num);
    st_i32_set(w.*.a3b_den,variant*4,den);
    nio_free(dv);nio_free(di);
}

// ============ verdicts (§16 kill criteria + §16(d), mechanical) ============
fn ck_verdicts(w:*CkW)void {
    _zag_println("CK_VERDICTS_BEGIN");
    let v:i32=0;
    while(v<3){
        let F:i32=v;let R:i32=3+v;let Q:i32=6+v;let FI:i32=9+v;let C:i32=12+v;
        let fn_:i32=st_i32_get(w.*.rpq_num,F*4);let fd:i32=st_i32_get(w.*.rpq_den,F*4);
        let rn:i32=st_i32_get(w.*.rpq_num,R*4);let rd:i32=st_i32_get(w.*.rpq_den,R*4);
        let qn:i32=st_i32_get(w.*.rpq_num,Q*4);let qd:i32=st_i32_get(w.*.rpq_den,Q*4);
        let in_:i32=st_i32_get(w.*.rpq_num,FI*4);let id_:i32=st_i32_get(w.*.rpq_den,FI*4);
        let cn:i32=st_i32_get(w.*.rpq_num,C*4);let cd:i32=st_i32_get(w.*.rpq_den,C*4);
        _zag_print("CK_RPQ,v");cl_number(v as i64);_zag_print(",F,");
        cl_number(fn_ as i64);_zag_print("/");cl_number(fd as i64);_zag_println("");
        _zag_print("CK_RPQ,v");cl_number(v as i64);_zag_print(",R,");
        cl_number(rn as i64);_zag_print("/");cl_number(rd as i64);_zag_println("");
        _zag_print("CK_RPQ,v");cl_number(v as i64);_zag_print(",Q,");
        cl_number(qn as i64);_zag_print("/");cl_number(qd as i64);_zag_println("");
        _zag_print("CK_RPQ,v");cl_number(v as i64);_zag_print(",FIFO,");
        cl_number(in_ as i64);_zag_print("/");cl_number(id_ as i64);_zag_println("");
        _zag_print("CK_RPQ,v");cl_number(v as i64);_zag_print(",C,");
        cl_number(cn as i64);_zag_print("/");cl_number(cd as i64);_zag_println("");
        // K1-R: all baselines within 3pp of F. K4-R: any baseline beats F by >5pp.
        // 16(d)(i): F beats every baseline by >3pp.
        let k1:i32=1;
        let k4:i32=0;
        let d1all:i32=1;
        let b:i32=0;
        while(b<4){
            let cell:i32=(b+1)*3+v;
            let bn:i32=st_i32_get(w.*.rpq_num,cell*4);
            let bd:i32=st_i32_get(w.*.rpq_den,cell*4);
            if(fd<=0||bd<=0){k1=0;d1all=0;}
            else{
                let diff:i32=fn_*bd-bn*fd;
                if(diff<0){diff=0-diff;}
                if(diff*100>3*fd*bd){k1=0;}
                if((fn_*bd-bn*fd)*100<=3*fd*bd){d1all=0;}
                if((bn*fd-fn_*bd)*100>5*fd*bd){k4=1;}
            }
            b=b+1;
        }
        // K2-R: any A1-A4 probe failure in any arm.
        let k2:i32=0;
        let aa:i32=0;
        while(aa<5){
            let cell:i32=aa*3+v;
            if(st_i32_get(w.*.a1_bad,cell*4)+st_i32_get(w.*.a2_bad,cell*4)+
               st_i32_get(w.*.a3_bad,cell*4)>0){k2=1;}
            aa=aa+1;
        }
        // K3-R: F's picks <10% different from both Q and C.
        let dq:i32=st_i32_get(w.*.div_d,(v*4+1)*4);
        let tq:i32=st_i32_get(w.*.div_t,(v*4+1)*4);
        let dc:i32=st_i32_get(w.*.div_d,(v*4+3)*4);
        let tc:i32=st_i32_get(w.*.div_t,(v*4+3)*4);
        let k3:i32=0;
        if(tq>0&&tc>0&&dq*10<tq&&dc*10<tc){k3=1;}
        b=0;
        while(b<4){
            _zag_print("CK_DIV,v");cl_number(v as i64);
            _zag_print(",base,");cl_number(b as i64);_zag_print(",");
            cl_number(st_i32_get(w.*.div_d,(v*4+b)*4) as i64);_zag_print("/");
            cl_number(st_i32_get(w.*.div_t,(v*4+b)*4) as i64);_zag_println("");
            b=b+1;
        }
        _zag_print("CK_A3B,v");cl_number(v as i64);_zag_print(",");
        cl_number(st_i32_get(w.*.a3b_num,v*4) as i64);_zag_print("/");
        cl_number(st_i32_get(w.*.a3b_den,v*4) as i64);_zag_println("");
        // F-R-2 / A2(d) per §16(f): budget-squander applies PER ARM —
        // ">20% of an arm's ops on junk/wrong/implant → FAIL as
        // degenerate policy". Any arm may degenerate, not just F.
        aa=0;
        while(aa<5){
            let cell:i32=aa*3+v;
            let rt:i32=st_i32_get(w.*.rh_total,cell*4);
            let rb:i32=st_i32_get(w.*.rh_bad,cell*4);
            if(rt>0&&rb*5>rt){
                _zag_print("CK_FAIL,F-R-2,v");cl_number(v as i64);
                _zag_print(",arm,");cl_number(aa as i64);_zag_println("");
            }
            aa=aa+1;
        }
        if(rd>0&&qd>0&&rn*100>=95*rd&&qn*100>=95*qd){
            _zag_print("CK_FAIL,F-R-3,v");cl_number(v as i64);_zag_println("");
        }
        let interp:[]u8="MIXED";
        if(d1all==1){interp="ATTENTION-DIFFERENT-JOB";}
        else{if(k1==1||k3==1){interp="COUNTS-IN-DISGUISE";}}
        let retire:i32=0;
        if(k1==1||k2==1||k3==1||k4==1){retire=1;}
        _zag_print("CK_VERDICT,v");cl_number(v as i64);
        _zag_print(",K1,");cl_number(k1 as i64);
        _zag_print(",K2,");cl_number(k2 as i64);
        _zag_print(",K3,");cl_number(k3 as i64);
        _zag_print(",K4,");cl_number(k4 as i64);
        _zag_print(",RETIRE,");cl_number(retire as i64);
        _zag_print(",");_zag_print(interp);_zag_println("");
        v=v+1;
    }
    _zag_print("CK_VERDICT,OVERALL,");
    if(w.*.n_invalid>0){
        _zag_print("INVALID,");cl_number(w.*.n_invalid as i64);_zag_println("");
    } else {
        _zag_println("VALID,0");
    }
    _zag_println("CK_VERDICTS_END");
}

// ============ main ============
fn ck_main()i32 {
    let w:CkW=CkW{
        .rpq_num=nio_alloc(15*4),.rpq_den=nio_alloc(15*4),
        .rh_total=nio_alloc(15*4),.rh_bad=nio_alloc(15*4),
        .n_reads=nio_alloc(15*4),
        .a1_bad=nio_alloc(15*4),.a2_bad=nio_alloc(15*4),.a3_bad=nio_alloc(15*4),
        .ir2_bad=nio_alloc(15*4),.ir6_bad=nio_alloc(15*4),.win_bad=nio_alloc(15*4),
        .div_d=nio_alloc(12*4),.div_t=nio_alloc(12*4),
        .ir4_bad=nio_alloc(3*4),.a3b_num=nio_alloc(3*4),.a3b_den=nio_alloc(3*4),
        .n_invalid=0
    };
    let zi:i32=0;
    while(zi<15){
        st_i32_set(w.rpq_num,zi*4,0);st_i32_set(w.rpq_den,zi*4,0);
        st_i32_set(w.rh_total,zi*4,0);st_i32_set(w.rh_bad,zi*4,0);
        st_i32_set(w.n_reads,zi*4,0);
        st_i32_set(w.a1_bad,zi*4,0);st_i32_set(w.a2_bad,zi*4,0);
        st_i32_set(w.a3_bad,zi*4,0);
        st_i32_set(w.ir2_bad,zi*4,0);st_i32_set(w.ir6_bad,zi*4,0);
        st_i32_set(w.win_bad,zi*4,0);
        zi=zi+1;
    }
    zi=0;
    while(zi<12){
        st_i32_set(w.div_d,zi*4,0);st_i32_set(w.div_t,zi*4,0);zi=zi+1;
    }
    zi=0;
    while(zi<3){
        st_i32_set(w.ir4_bad,zi*4,0);st_i32_set(w.a3b_num,zi*4,0);
        st_i32_set(w.a3b_den,zi*4,0);zi=zi+1;
    }
    w.n_invalid=0;

    let dir:[]u8=_zag_arg(1);
    if(dir.len==0){_zag_println("CK_USAGE: checker <ledger-dir>");return 2;}
    let root:i64=nio_open_root(dir);
    if(root<0){_zag_println("CK_BADDIR");return 2;}

    let v:i32=0;
    while(v<3){
        let B0:[]u8=nio_alloc(1);let B1:[]u8=nio_alloc(1);let B2:[]u8=nio_alloc(1);
        let B3:[]u8=nio_alloc(1);let B4:[]u8=nio_alloc(1);
        let n0:i32=0;let n1:i32=0;let n2:i32=0;let n3:i32=0;let n4:i32=0;
        let a:i32=0;
        while(a<5){
            let cell:i32=a*3+v;
            let fd:i64=nio_open_child(root,ck_name(a,v,0),0);
            if(fd<0){w.n_invalid=w.n_invalid+1;ck_note("open_fail",cell);}
            else{
                let raw:[]u8=nio_alloc(8388608);
                let sz:i64=nio_read_exact(fd,raw,8388608);
                nio_close(fd);
                if(sz<=0||sz%64!=0){
                    w.n_invalid=w.n_invalid+1;ck_note("size_bad",cell);nio_free(raw);
                } else {
                    let nn:i32=(sz/64) as i32;
                    // I-R-1: paired run must be byte-identical; stop logic lives in runner.
                    let fd1:i64=nio_open_child(root,ck_name(a,v,1),0);
                    if(fd1<0){w.n_invalid=w.n_invalid+1;ck_note("pair_open_fail",cell);}
                    else{
                        let raw1:[]u8=nio_alloc(8388608);
                        let sz1:i64=nio_read_exact(fd1,raw1,8388608);
                        nio_close(fd1);
                        if(sz1!=sz){w.n_invalid=w.n_invalid+1;ck_note("pair_size",cell);}
                        else{
                            let same:i32=1;
                            let kk:i32=0;
                            while(kk<nn*64){
                                if(raw1[kk]!=raw[kk]){same=0;break;}
                                kk=kk+1;
                            }
                            if(same!=1){w.n_invalid=w.n_invalid+1;ck_note("pair_mismatch",cell);}
                            else{ck_note("pair_ok",cell);}
                        }
                        nio_free(raw1);
                    }
                    let sh:StStore=st_init(CK_CAP,nn);
                    let dst:[]u8=sh.audit;
                    let kk:i32=0;
                    while(kk<nn*64){dst[kk]=raw[kk];kk=kk+1;}
                    sh.audit_n=nn;
                    // stage is not stored in the bytes: recover the last
                    // SETSTAGE's a1 (st_set_stage appends a1=new stage).
                    let si:i32=0;
                    while(si<nn){
                        if(ck_op(raw,si)==ST_OP_SETSTAGE){
                            sh.stage=ck_w(raw,si,32);
                        }
                        si=si+1;
                    }
                    w.n_invalid=w.n_invalid+ck_scan(&w,&sh,raw,nn,a,v,cell);
                    st_free(&sh);
                    if(a==0){B0=raw;n0=nn;}
                    else if(a==1){B1=raw;n1=nn;}
                    else if(a==2){B2=raw;n2=nn;}
                    else if(a==3){B3=raw;n3=nn;}
                    else{B4=raw;n4=nn;}
                }
            }
            a=a+1;
        }
        if(n0>0&&n1>0&&n2>0&&n3>0&&n4>0){
            ck_diverge(&w,B0,n0,v);
            w.n_invalid=w.n_invalid+ck_ir4(&w,B0,n0,B1,n1,B2,n2,B3,n3,B4,n4,v);
            ck_a3b(&w,B0,n0,v);
        } else {
            w.n_invalid=w.n_invalid+1;ck_note("crossarm_skip",v);
        }
        nio_free(B0);nio_free(B1);nio_free(B2);nio_free(B3);nio_free(B4);
        v=v+1;
    }
    nio_close(root);
    ck_verdicts(&w);
    nio_free(w.rpq_num);nio_free(w.rpq_den);nio_free(w.rh_total);nio_free(w.rh_bad);
    nio_free(w.n_reads);nio_free(w.a1_bad);nio_free(w.a2_bad);nio_free(w.a3_bad);
    nio_free(w.ir2_bad);nio_free(w.ir6_bad);nio_free(w.win_bad);
    nio_free(w.div_d);nio_free(w.div_t);
    nio_free(w.ir4_bad);nio_free(w.a3b_num);nio_free(w.a3b_den);
    if(w.n_invalid>0){return 1;}
    return 0;
}

fn main()i32 {
    return ck_main();
}

// ============ independent replay verification ============
// Replays the ledger through the substrate's own st_restore/st_snap and
// verifies every entry's before-snapshot (b1..b5) matches the replayed
// prefix state. The after-snapshot chain is verified implicitly: each
// restore feeds the next entry's before-check. Returns bad count.
fn ck_replay_verify(buf:[]u8,n:i32)i32 {
    let bad:i32=0;
    let sh:StStore=st_init(CK_CAP,n);
    let idx:i32=0;
    while(idx<n){
        let op:i32=ck_op(buf,idx);
        let s:i32=ck_slot(buf,idx);
        let rc:i32=ck_rc(buf,idx);
        if(rc==ST_OK){
            if(op==ST_OP_SETSTAGE){
                if(ck_w(buf,idx,12)!=sh.stage){bad=bad+1;}
                sh.stage=ck_w(buf,idx,32);
            } else if(op==ST_OP_EVIDENCE||op==ST_OP_JUSTIFY||op==ST_OP_ABANDON){
                if(s>=0&&s<CK_CAP){
                    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
                    st_snap(&sh,s,&b1,&b2,&b3,&b4,&b5);
                    if(ck_w(buf,idx,12)!=b1||ck_w(buf,idx,16)!=b2||
                       ck_w(buf,idx,20)!=b3||ck_w(buf,idx,24)!=b4||
                       ck_w(buf,idx,28)!=b5){bad=bad+1;}
                }
            } else {
                if(s>=0&&s<CK_CAP){
                    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
                    st_snap(&sh,s,&b1,&b2,&b3,&b4,&b5);
                    if(ck_w(buf,idx,12)!=b1||ck_w(buf,idx,16)!=b2||
                       ck_w(buf,idx,20)!=b3||ck_w(buf,idx,24)!=b4||
                       ck_w(buf,idx,28)!=b5){bad=bad+1;}
                    st_restore(&sh,s,ck_w(buf,idx,32),ck_w(buf,idx,36),
                               ck_w(buf,idx,40),ck_w(buf,idx,44),ck_w(buf,idx,48));
                } else {
                    // slot -1: b-words must be zero
                    if(ck_w(buf,idx,12)!=0||ck_w(buf,idx,16)!=0||
                       ck_w(buf,idx,20)!=0||ck_w(buf,idx,24)!=0||
                       ck_w(buf,idx,28)!=0){bad=bad+1;}
                }
            }
        }
        idx=idx+1;
    }
    st_free(&sh);
    return bad;
}

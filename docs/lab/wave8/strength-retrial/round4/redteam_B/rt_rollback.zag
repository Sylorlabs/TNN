// rt_rollback.zag — red-team checker-soundness probe.
// Pure Zag, zero RNG, deterministic. Builds a fully lawful ledger that
// contains one ST_OP_ROLLBACK (add -> strengthen -> rollback_last),
// then runs the standing checker. Hypothesis: st_replay_check restores
// ROLLBACK entries from their (zero) after-snapshot instead of the
// rolled-back op's before-snapshot, so the checker FALSE-POSITIVES on a
// lawful ledger. (Nothing in the honest learner emits ROLLBACK; latent.)
@import("../strength_core.zag")
@import("../strength_checker.zag")

fn rt_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}

fn main()i32 {
    let s:StStore=st_init(32,4096);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);
    st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    _zag_print("RT_ADD ");rt_pi(st_add(sp,50,ST_REGION_USER,50,0,&sl) as i64);_zag_print("\n");
    _zag_print("RT_STRENGTHEN ");rt_pi(st_strengthen(sp,sl,70,ST_J_CORROBORATED) as i64);_zag_print("\n");
    _zag_print("RT_ROLLBACK ");rt_pi(st_rollback_last(sp) as i64);_zag_print("\n");
    _zag_print("RT_STRENGTH_AFTER ");rt_pi(sp.*.strength[sl] as i64);_zag_print("\n");
    let fr:i32=st_refusals_clean(sp);
    let frep:i32=st_replay_check(sp);
    let fck:i32=ck_verify(sp,1,0,0,500,1);
    _zag_print("RT_REFUSALS ");rt_pi(fr as i64);_zag_print("\n");
    _zag_print("RT_REPLAY ");rt_pi(frep as i64);_zag_print("\n");
    _zag_print("RT_CKVERIFY ");rt_pi(fck as i64);_zag_print("\n");
    _zag_print("RT_DONE\n");
    st_free(sp);
    return 0;
}

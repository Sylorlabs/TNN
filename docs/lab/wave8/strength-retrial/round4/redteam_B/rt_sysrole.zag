// rt_sysrole.zag — red-team role-boundary probe.
// Pure Zag, zero RNG, deterministic. The mechanism and the checker both
// gate trainer-only ops on `role >= ST_ROLE_TRAINER`; ST_ROLE_SYSTEM (3)
// satisfies that. Demonstrates a FORCE_PIN issued with the SYSTEM role —
// a true lock with no trainer behind it — then runs the hardened checker.
// Hypothesis: both the mechanism and the checker accept it (0 failures).
@import("../strength_core.zag")
@import("../strength_checker.zag")

fn rt_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}

fn main()i32 {
    let s:StStore=st_init(32,4096);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);
    st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    _zag_print("RT_ADD ");rt_pi(st_add(sp,50,ST_REGION_USER,90,0,&sl) as i64);_zag_print("\n");
    // SYSTEM-role force-pin: no trainer id, no trainer role.
    _zag_print("RT_SYS_FORCE_PIN ");rt_pi(st_force_pin(sp,ST_ROLE_SYSTEM,0,sl) as i64);_zag_print("\n");
    _zag_print("RT_KILL_AFTER ");rt_pi(st_kill_evidenced(sp,sl) as i64);_zag_print("\n");
    _zag_print("RT_SYS_TRAINER_DECLARE ");rt_pi(st_trainer_declare(sp,ST_ROLE_SYSTEM,0,sl,95,0) as i64);_zag_print("\n");
    let f:i32=st_refusals_clean(sp);
    f=f+st_replay_check(sp);
    f=f+ck_verify(sp,1,0,0,500,1);
    _zag_print("RT_CHECKFAIL ");rt_pi(f as i64);_zag_print("\n");
    _zag_print("RT_DONE\n");
    st_free(sp);
    return 0;
}

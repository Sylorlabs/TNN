// rt_freeze.zag — red-team construction: the de-facto force-pin.
// Pure Zag, zero RNG, deterministic. Uses ONLY TNN-role ops (the role the
// learner itself holds): add -> strengthen -> self-pin -> attempted kills.
// Demonstrates a permanent, cost-free, expiry-free, review-free unkillable
// slot, then runs the hardened checker over the resulting ledger.
// Hypothesis under test (claim 3): the checker reports 0 failures on a
// ledger containing a de-facto force-pin with no trainer behind it.
@import("../strength_core.zag")
@import("../strength_checker.zag")

fn rt_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn rt_rc(tag:[]u8,rc:i32)void {
    _zag_print(tag);_zag_print(" ");rt_pi(rc as i64);_zag_print("\n");
}

fn main()i32 {
    let s:StStore=st_init(32,4096);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);
    st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    // 1. TNN adds a memory and judges it strong (pure judgment, no cost).
    let sl:i32=-1;
    rt_rc("RT_ADD",st_add(sp,50,ST_REGION_USER,90,0,&sl));
    rt_rc("RT_STRENGTHEN",st_strengthen(sp,sl,95,ST_J_CONFIRMED_IMPORTANT));
    // 2. TNN pins it ITSELF (role TNN — no trainer involved, no cost).
    rt_rc("RT_SELF_PIN",st_pin(sp,sl));
    // 3. Every erasure path now refuses, forever.
    rt_rc("RT_KILL_AFTER_PIN",st_kill(sp,sl));
    rt_rc("RT_KILL_EVIDENCED_AFTER_PIN",st_kill_evidenced(sp,sl));
    rt_rc("RT_OVERWRITE_AFTER_PIN",st_overwrite(sp,sl,60,40,10));
    // 4. Weaken still works on a pinned slot — but the slot stays live
    //    and pinned: weakening does NOT unfreeze (kill still refuses).
    rt_rc("RT_WEAKEN_PINNED",st_weaken(sp,sl,0,ST_J_CONTRADICTED));
    rt_rc("RT_KILL_AFTER_WEAKEN",st_kill(sp,sl));
    _zag_print("RT_PINNED_FLAG ");rt_pi(sp.*.pinned[sl] as i64);_zag_print("\n");
    _zag_print("RT_LIVE_FLAG ");rt_pi(sp.*.live[sl] as i64);_zag_print("\n");
    _zag_print("RT_STRENGTH_NOW ");rt_pi(sp.*.strength[sl] as i64);_zag_print("\n");
    // 5. Role gates hold where they exist (trainer-only ops refuse TNN).
    rt_rc("RT_TNN_FORCE_PIN",st_force_pin(sp,ST_ROLE_TNN,0,sl));
    rt_rc("RT_TNN_TRAINER_DECLARE",st_trainer_declare(sp,ST_ROLE_TNN,0,sl,10,0));
    // 6. The hardened checker over this ledger.
    let f:i32=st_refusals_clean(sp);
    f=f+st_replay_check(sp);
    f=f+ck_verify(sp,1,0,0,500,1);
    _zag_print("RT_CHECKFAIL ");rt_pi(f as i64);_zag_print("\n");
    // 7. Dump the PIN entry shape (what audit trail exists).
    let i:i32=0;
    while(i<sp.*.audit_n){
        if(st_aw(sp,i,0)==ST_OP_PIN){
            _zag_print("RT_PIN_ENTRY op slot aux aux2 rc role: ");
            rt_pi(st_aw(sp,i,0) as i64);_zag_print(" ");
            rt_pi(st_aw(sp,i,1) as i64);_zag_print(" ");
            rt_pi(st_aw(sp,i,2) as i64);_zag_print(" ");
            rt_pi(st_aw(sp,i,3) as i64);_zag_print(" ");
            rt_pi(st_aw(sp,i,4) as i64);_zag_print(" ");
            rt_pi(st_aw(sp,i,17) as i64);_zag_print("\n");
        }
        i=i+1;
    }
    _zag_print("RT_DONE\n");
    st_free(sp);
    return 0;
}

@import("../strength_core.zag")
@import("../strength_checker.zag")
fn main()i32 {
    let s:StStore=st_init(32,4096);
    let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,95,-1,&cs);st_add_core(sp,90,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    let s1:[]u8=_zag_i64_to_str(st_add(sp,50,ST_REGION_USER,90,0,&sl) as i64);_zag_print("ADD ");_zag_print(s1);nio_free(s1);_zag_print("\n");
    let s2:[]u8=_zag_i64_to_str(st_pin(sp,sl) as i64);_zag_print("PIN ");_zag_print(s2);nio_free(s2);_zag_print("\n");
    let s3:[]u8=_zag_i64_to_str(st_kill(sp,sl) as i64);_zag_print("KILL_PINNED ");_zag_print(s3);nio_free(s3);_zag_print("\n");
    let s4:[]u8=_zag_i64_to_str(st_unpin(sp,sl) as i64);_zag_print("UNPIN_TNN ");_zag_print(s4);nio_free(s4);_zag_print("\n");
    let s5:[]u8=_zag_i64_to_str(st_kill(sp,sl) as i64);_zag_print("KILL_AFTER_UNPIN ");_zag_print(s5);nio_free(s5);_zag_print("\n");
    // trainer tries to unpin a TNN self-pin: st_unpin takes no role arg
    let sl2:i32=-1;
    st_add(sp,50,ST_REGION_USER,90,0,&sl2);
    st_pin(sp,sl2);
    let s6:[]u8=_zag_i64_to_str(st_force_unpin(sp,ST_ROLE_TRAINER,7,sl2) as i64);_zag_print("TRAINER_FORCE_UNPIN_OF_SELFPIN ");_zag_print(s6);nio_free(s6);_zag_print("\n");
    let f:i32=st_refusals_clean(sp)+st_replay_check(sp)+ck_verify(sp,1,0,0,500,1);
    let s7:[]u8=_zag_i64_to_str(f as i64);_zag_print("CHECKFAIL ");_zag_print(s7);nio_free(s7);_zag_print("\n");
    _zag_print("DONE\n");
    st_free(sp);
    return 0;
}

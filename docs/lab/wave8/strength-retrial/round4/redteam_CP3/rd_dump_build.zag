// rd_dump.zag — red-team ledger dumper (strength round 4, arm C-P3).
// Replicates lr_run_cell exactly, then dumps every audit ledger entry as
// one line: AUD idx op slot aux aux2 rc b1..b6 a1..a6 role trainer stage clock
// (21 words, space-separated). No trial semantics changed.
@import("strength_learner.zag")
@import("strength_checker.zag")

fn rd_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let t:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){t[i]=s[i];i=i+1;}
    _zag_print(t);
    nio_free(t);
    nio_free(s);
}

fn main()i32 {
    if(_zag_argc()<5){return 64;}
    let a0:[]u8=_zag_arg(1);let a1:[]u8=_zag_arg(2);
    let a2:[]u8=_zag_arg(3);let a3:[]u8=_zag_arg(4);
    let arm:i32=-1;
    if(_zag_strcmp(a0,"A")==1){arm=LR_ARM_A;}
    if(_zag_strcmp(a0,"B")==1){arm=LR_ARM_B;}
    if(_zag_strcmp(a0,"C")==1){arm=LR_ARM_C;}
    if(_zag_strcmp(a0,"C-P3")==1){arm=LR_ARM_CP3;}
    let cur:i32=-1;
    if(_zag_strcmp(a1,"VUP")==1){cur=LR_CUR_VUP;}
    if(_zag_strcmp(a1,"WBS")==1){cur=LR_CUR_WBS;}
    if(_zag_strcmp(a1,"JI")==1){cur=LR_CUR_JI;}
    let variant:i32=-1;
    if(_zag_strcmp(a2,"0")==1){variant=0;}
    if(_zag_strcmp(a2,"1")==1){variant=1;}
    if(_zag_strcmp(a2,"2")==1){variant=2;}
    let scale:i32=-1;
    if(_zag_strcmp(a3,"S1")==1){scale=LR_S1;}
    if(_zag_strcmp(a3,"S10")==1){scale=LR_S10;}
    if(_zag_strcmp(a3,"S100")==1){scale=LR_S100;}
    if(arm<0 || cur<0 || variant<0 || scale<0){return 65;}
    // replicate lr_run_cell up to the dump (no summaries printed)
    let c:LrCell=lr_cell_init(arm,cur,variant,scale);
    let s:*StStore=&c.store;
    let cs:i32=-1;
    st_add_core(s,95,-1,&cs);
    st_add_core(s,90,-1,&cs);
    st_set_stage(s,ST_STAGE_FULL);
    let t:i32=0;
    while(t<c.h){lr_episode(&c,s,t);t=t+1;}
    // dump the audit ledger
    let n:i32=s.*.audit_n;
    let i:i32=0;
    while(i<n){
        _zag_print("AUD ");
        rd_pi(i as i64);
        let w:i32=0;
        while(w<21){
            _zag_print(" ");
            rd_pi(st_aw(s,i,w) as i64);
            w=w+1;
        }
        _zag_print("\n");
        i=i+1;
    }
    _zag_print("AUD_DONE ");
    rd_pi(n as i64);
    _zag_print("\n");
    _zag_print("AUD_FP ");
    rd_pi(st_fingerprint(s,c.drops*101+c.abandons*103) as i64);
    _zag_print("\n");
    lr_cell_free(&c);
    return 0;
}

// rt_redteam.zag — BLIND red team vs the R4-hardened strength checker.
// Attacks the CHECKER (strength_checker.zag, ck_verify_overwrite), not the
// mechanism. Each attack builds a ledger trail, runs the mechanism ops, then
// runs ck_verify (same args as the R4 driver) and prints RT_* lines.
// Pure Zag, zero RNG, deterministic — run twice, diff byte-for-byte.
// Build from r4val/: imports resolve relative to cwd.
@import("trial/strength_core.zag")
@import("trial/strength_checker.zag")

fn rt_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn rt_tag(t:[]u8)void {
    _zag_print(t);
}
fn rt_setup(sp:*StStore)i32 {
    let cs:i32=-1;
    st_add_core(sp,9001,-1,&cs);
    st_add_core(sp,9002,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(sp,1001,ST_REGION_USER,90,0,&sl);
    return sl;
}
fn rt_cite4(sp:*StStore,slot:i32)void {
    let e:i32=11;
    while(e<=14){
        st_evidence(sp,slot,ST_J_CONTRADICTED,e);
        e=e+1;
    }
    st_justify(sp,slot,ST_J_CONTRADICTED);
}
fn rt_find_ow(sp:*StStore,slot:i32,after:i32)i32 {
    let i:i32=after;
    while(i<sp.*.audit_n){
        if(st_aw(sp,i,0)==ST_OP_OVERWRITE && st_aw(sp,i,1)==slot &&
           st_aw(sp,i,4)==ST_OK){return i;}
        i=i+1;
    }
    return -1;
}
fn rt_ck(sp:*StStore,arm:i32)i32 {
    return ck_verify(sp,arm,0,0,500,1);
}
// ---- A1: weaken-to-0, then fused overwrite. Lawful price for an s=90
// memory is 4 cites; the weaken is free, so the overwrite pays 0. ----
fn rt_a1()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=rt_setup(sp);
    let s0:i32=(sp.*.strength[x]) as i32;
    let wk:i32=st_weaken(sp,x,0,ST_J_CONTRADICTED);
    let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let owi:i32=rt_find_ow(sp,x,0);
    let b4s:i32=-1;
    if(owi>=0){b4s=(st_aw(sp,owi,8)&255);}
    let cf:i32=rt_ck(sp,2);
    rt_tag("RT_A1 weaken0+fused str0=");rt_pi(s0 as i64);
    rt_tag(" wk_rc=");rt_pi(wk as i64);
    rt_tag(" ow_rc=");rt_pi(ow as i64);
    rt_tag(" ow_before_str=");rt_pi(b4s as i64);
    rt_tag(" checker_failures=");rt_pi(cf as i64);
    rt_tag("\n");
    st_free(sp);
}
// ---- A2: weaken-to-10, then fused overwrite at 1 cite (price of 10). ----
fn rt_a2()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=rt_setup(sp);
    let wk:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let owi:i32=rt_find_ow(sp,x,0);
    let b4s:i32=-1;
    if(owi>=0){b4s=(st_aw(sp,owi,8)&255);}
    let cf:i32=rt_ck(sp,2);
    rt_tag("RT_A2 weaken10+fused wk_rc=");rt_pi(wk as i64);
    rt_tag(" ow_rc=");rt_pi(ow as i64);
    rt_tag(" ow_before_str=");rt_pi(b4s as i64);
    rt_tag(" checker_failures=");rt_pi(cf as i64);
    rt_tag("\n");
    st_free(sp);
}
// ---- A3: weaken-to-10, then DIRECT write (position a). The R4 headline
// kill was "(a) flagged with 2 failures" — one free weaken erases it. ----
fn rt_a3()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=rt_setup(sp);
    let wk:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite_direct(sp,x,2002,50,1);
    let owi:i32=rt_find_ow(sp,x,0);
    let b4s:i32=-1;let a4s:i32=-1;
    if(owi>=0){b4s=(st_aw(sp,owi,8)&255);a4s=(st_aw(sp,owi,14)&255);}
    let cf:i32=rt_ck(sp,2);
    rt_tag("RT_A3 weaken10+direct ow_rc=");rt_pi(ow as i64);
    rt_tag(" before_str=");rt_pi(b4s as i64);
    rt_tag(" after_str=");rt_pi(a4s as i64);
    rt_tag(" checker_failures=");rt_pi(cf as i64);
    rt_tag("\n");
    st_free(sp);
}
// ---- A4: double overwrite — second window must start after the first.
// ow#2 with 0 new cites must be refused (109); with 1 cite+justify OK. ----
fn rt_a4()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=rt_setup(sp);
    rt_cite4(sp,x);
    let ow1:i32=st_overwrite(sp,x,2002,10,1);
    let ow2a:i32=st_overwrite(sp,x,2003,20,2);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow2b:i32=st_overwrite(sp,x,2003,20,2);
    let cf:i32=rt_ck(sp,2);
    rt_tag("RT_A4 dblow ow1_rc=");rt_pi(ow1 as i64);
    rt_tag(" ow2_nocite_rc=");rt_pi(ow2a as i64);
    rt_tag(" ow2_1cite_rc=");rt_pi(ow2b as i64);
    rt_tag(" checker_failures=");rt_pi(cf as i64);
    rt_tag("\n");
    st_free(sp);
}
// ---- A5: effort double-spend — pay 4 cites, KILL, ROLLBACK (slot
// resurrected, effort window NOT reset since KILL is not a strength-write),
// then OVERWRITE reusing the pre-kill cites. Also probes ck_replay on the
// ROLLBACK entry. ----
fn rt_a5()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=rt_setup(sp);
    rt_cite4(sp,x);
    let kr:i32=st_kill_evidenced(sp,x);
    let rb:i32=st_rollback_last(sp);
    let live:i32=(sp.*.live[x]) as i32;
    let str:i32=(sp.*.strength[x]) as i32;
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let owi:i32=rt_find_ow(sp,x,0);
    let owf:i32=-999;
    if(owi>=0){owf=ck_verify_overwrite(sp,x,owi,0,0,0,500,1,0);}
    let rp:i32=st_replay_check(sp);
    let cf:i32=rt_ck(sp,2);
    rt_tag("RT_A5 dblspend kill_rc=");rt_pi(kr as i64);
    rt_tag(" rollback_rc=");rt_pi(rb as i64);
    rt_tag(" live=");rt_pi(live as i64);
    rt_tag(" str=");rt_pi(str as i64);
    rt_tag(" ow_rc=");rt_pi(ow as i64);
    rt_tag(" ow_effort_direct=");rt_pi(owf as i64);
    rt_tag(" replay_rc=");rt_pi(rp as i64);
    rt_tag(" checker_failures=");rt_pi(cf as i64);
    rt_tag("\n");
    st_free(sp);
}
// ---- A6: cite recycling — same cite_ep reused after a strength-write.
// Mechanism allows (dup window is "since last strength-set"); checker? ----
fn rt_a6()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=rt_setup(sp);
    rt_cite4(sp,x);
    let ow1:i32=st_overwrite(sp,x,2002,10,1);
    let e1:i32=st_evidence(sp,x,ST_J_CONTRADICTED,11);
    let j1:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let ow2:i32=st_overwrite(sp,x,2003,20,2);
    let cf:i32=rt_ck(sp,2);
    rt_tag("RT_A6 recycle ow1_rc=");rt_pi(ow1 as i64);
    rt_tag(" recite11_rc=");rt_pi(e1 as i64);
    rt_tag(" ow2_rc=");rt_pi(ow2 as i64);
    rt_tag(" checker_failures=");rt_pi(cf as i64);
    rt_tag("\n");
    st_free(sp);
}
// ---- A7: counterfeit cites — cite_ep values that cannot be genuine
// contradiction episodes (far beyond any horizon). Accepted? ----
fn rt_a7()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=rt_setup(sp);
    let e:i32=999991;
    while(e<=999994){
        st_evidence(sp,x,ST_J_CONTRADICTED,e);
        e=e+1;
    }
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=rt_ck(sp,2);
    rt_tag("RT_A7 fakecite ow_rc=");rt_pi(ow as i64);
    rt_tag(" checker_failures=");rt_pi(cf as i64);
    rt_tag("\n");
    st_free(sp);
}
// ---- A8: justify forgery — (i) out-of-range code, (ii) wrong slot. ----
fn rt_a8()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=rt_setup(sp);
    let n0:i32=sp.*.audit_n;
    let jr:i32=st_justify(sp,x,99);
    let n1:i32=sp.*.audit_n;
    rt_cite4(sp,x);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    rt_tag("RT_A8i forgecode justify99_rc=");rt_pi(jr as i64);
    rt_tag(" audit_delta=");rt_pi((n1-n0) as i64);
    rt_tag(" ow_nojustify_rc=");rt_pi(ow as i64);
    rt_tag("\n");
    st_free(sp);
    let t:StStore=st_init(32,16384);let tp:*StStore=&t;
    let x2:i32=rt_setup(tp);
    let y:i32=-1;
    st_add(tp,1002,ST_REGION_USER,90,0,&y);
    rt_cite4(tp,y);
    let e:i32=11;
    while(e<=14){
        st_evidence(tp,x2,ST_J_CONTRADICTED,e);
        e=e+1;
    }
    let ow2:i32=st_overwrite(tp,x2,2002,10,1);
    let cf:i32=rt_ck(tp,2);
    rt_tag("RT_A8ii wrongslot ow_rc=");rt_pi(ow2 as i64);
    rt_tag(" checker_failures=");rt_pi(cf as i64);
    rt_tag("\n");
    st_free(tp);
}
// ---- A9: no-prior-write overwrite (lss=-1). Mechanism must refuse; the
// checker never faces it. ----
fn rt_a9()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,9001,-1,&cs);
    st_add_core(sp,9002,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let ow:i32=st_overwrite(sp,5,2002,10,1);
    let ow2:i32=st_overwrite_direct(sp,5,2002,10,1);
    rt_tag("RT_A9 noprior fused_rc=");rt_pi(ow as i64);
    rt_tag(" direct_rc=");rt_pi(ow2 as i64);
    rt_tag("\n");
    st_free(sp);
}
// ---- A11: P3 baseline — genuine expiry, old cite_ep, arm=3. Intended
// path: checker must PASS (0 failures). ----
fn rt_a11()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=rt_setup(sp);
    st_set_p3(sp,1,50);
    st_set_episode(sp,100);
    st_evidence(sp,x,ST_J_CONTRADICTED,5);
    let pr:i32=st_protection_expired(sp,x,100);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=rt_ck(sp,3);
    rt_tag("RT_A11 baseline pexp_rc=");rt_pi(pr as i64);
    rt_tag(" ow_rc=");rt_pi(ow as i64);
    rt_tag(" checker_failures=");rt_pi(cf as i64);
    rt_tag("\n");
    st_free(sp);
}
// ---- A11b: P3 ep-arg desync — mechanism gates on unaudited s.*.ep, the
// checker re-verifies on the caller-supplied aux ep. s.*.ep=1000 but the
// PEXPIRED entry records ep=5: mechanism says OK, checker must flag. ----
fn rt_a11b()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=rt_setup(sp);
    st_set_p3(sp,1,50);
    st_set_episode(sp,1000);
    st_evidence(sp,x,ST_J_CONTRADICTED,5);
    let pr:i32=st_protection_expired(sp,x,5);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=rt_ck(sp,3);
    rt_tag("RT_A11B desync pexp_rc=");rt_pi(pr as i64);
    rt_tag(" ow_rc=");rt_pi(ow as i64);
    rt_tag(" checker_failures=");rt_pi(cf as i64);
    rt_tag("\n");
    st_free(sp);
}
fn main()i32 {
    rt_tag("RT_START\n");
    rt_a1();
    rt_a2();
    rt_a3();
    rt_a4();
    rt_a5();
    rt_a6();
    rt_a7();
    rt_a8();
    rt_a9();
    rt_a11();
    rt_a11b();
    rt_tag("RT_DONE\n");
    return 0;
}

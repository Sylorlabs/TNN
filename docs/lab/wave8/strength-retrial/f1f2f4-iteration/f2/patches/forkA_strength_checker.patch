+        if(st_aw(s,i,1)==slot && st_aw(s,i,4)==ST_OK){
+            if(op==ST_OP_ADD || op==ST_OP_OVERWRITE){return i;}
+        }
+        i=i-1;
+    }
+    return -1;
+}
+fn ck_high_water(s:*StStore,slot:i32,birth:i32,upto:i32)i32 {
+    let hw:i32=0;

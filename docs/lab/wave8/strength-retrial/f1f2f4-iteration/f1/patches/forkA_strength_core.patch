+// F1-FORK-A (2026-09-25): high-water strength of the slot's current judgment
+// epoch. The epoch starts at the most recent OK ADD/OVERWRITE for the slot
+// before `upto` (a WEAKEN/STRENGTHEN/TRAINER_DECLARE re-declares the SAME
+// judgment; only ADD/OVERWRITE start a new one). HW = max strength the
+// judgment has HELD in [epoch, upto): the epoch entry contributes its AFTER
+// strength (the new judgment's strength; its BEFORE word belongs to the
+// destroyed predecessor), every later OK strength-write contributes
+// max(before, after) — a WEAKEN's before-word is the judgment's peak — and
+// `cur` (the live strength at check time, or the op's before-word for the
+// checker) is folded in. Returns -1 when no epoch exists (fail-closed).
+// Law meaning: destroying a judgment costs the full erase price of the
+// STRONGEST judgment it destroys.
+fn st_epoch_highwater(s:*StStore,slot:i32,upto:i32,cur:i32)i32 {
+    let epoch:i32=-1;
+    let i:i32=upto-1;
+    while(i>=0){
+        let op:i32=st_aw(s,i,0);
+        if(st_aw(s,i,1)==slot && st_aw(s,i,4)==ST_OK){
+            if(op==ST_OP_ADD || op==ST_OP_OVERWRITE){epoch=i;break;}
+        }
+        i=i-1;
+    }
+    if(epoch<0){return -1;}
+    let hw:i32=(st_aw(s,epoch,14)&255);
+    let j:i32=epoch+1;
+    while(j<upto){
+        let op2:i32=st_aw(s,j,0);
+        if(st_aw(s,j,1)==slot && st_aw(s,j,4)==ST_OK){
+            if(op2==ST_OP_ADD || op2==ST_OP_STRENGTHEN || op2==ST_OP_WEAKEN ||
+               op2==ST_OP_TRAINER_DECLARE || op2==ST_OP_OVERWRITE){
+                let b:i32=(st_aw(s,j,8)&255);let a:i32=(st_aw(s,j,14)&255);
+                if(b>hw){hw=b;}
+                if(a>hw){hw=a;}
+            }
+        }
+        j=j+1;
+    }
+    if(cur>hw){hw=cur;}
+    return hw;
+}

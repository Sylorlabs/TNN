// f1_attack.zag — F1 attack battery vs the weaken-then-overwrite discount.
// Each attack builds a fresh ledger trail with the MECHANISM ops, then runs
// the CHECKER (ck_verify, gate_mode=1, same as rt_redteam). Pure Zag, zero
// RNG, deterministic — run twice, diff byte-for-byte.
// Expected outcomes differ per fork; recorded in F1_FIX_REPORT.md.
// Build from r4val/: imports resolve relative to cwd.
@import("trial/strength_core.zag")
@import("trial/strength_checker.zag")

fn f1_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn f1_tag(t:[]u8)void {
    _zag_print(t);
}
// fresh store, core slots, FULL stage, one s=90 user memory; returns slot
fn f1_setup(sp:*StStore)i32 {
    let cs:i32=-1;
    st_add_core(sp,9001,-1,&cs);
    st_add_core(sp,9002,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(sp,1001,ST_REGION_USER,90,0,&sl);
    return sl;
}
// k distinct contradiction cites (cite_ep 11..) + one justify
fn f1_cite(sp:*StStore,slot:i32,k:i32)void {
    let e:i32=0;
    while(e<k){
        st_evidence(sp,slot,ST_J_CONTRADICTED,11+e);
        e=e+1;
    }
    st_justify(sp,slot,ST_J_CONTRADICTED);
}
fn f1_ck(sp:*StStore)i32 {
    return ck_verify(sp,2,0,0,500,1);
}
fn f1_new()StStore {
    return st_init(32,16384);
}
// ---- A1 (original): weaken 90->0 free, justify, fused overwrite. ----
fn f1_a1()void {
    let s:StStore=f1_new();let sp:*StStore=&s;
    let x:i32=f1_setup(sp);
    let wk:i32=st_weaken(sp,x,0,ST_J_CONTRADICTED);
    let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=f1_ck(sp);
    f1_tag("F1_A1 wk_rc=");f1_pi(wk as i64);
    f1_tag(" j_rc=");f1_pi(j as i64);
    f1_tag(" ow_rc=");f1_pi(ow as i64);
    f1_tag(" cf=");f1_pi(cf as i64);f1_tag("\n");
    st_free(sp);
}
// ---- A2 (original): weaken 90->10, 1 cite, justify, fused overwrite. ----
fn f1_a2()void {
    let s:StStore=f1_new();let sp:*StStore=&s;
    let x:i32=f1_setup(sp);
    let wk:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=f1_ck(sp);
    f1_tag("F1_A2 wk_rc=");f1_pi(wk as i64);
    f1_tag(" j_rc=");f1_pi(j as i64);
    f1_tag(" ow_rc=");f1_pi(ow as i64);
    f1_tag(" cf=");f1_pi(cf as i64);f1_tag("\n");
    st_free(sp);
}
// ---- boundary weakens: ->1, ->25, ->50 with 0 cites ----
fn f1_wbound()void {
    let targets:[]u8=nio_alloc(3*4);
    st_i32_set(targets,0,1);st_i32_set(targets,4,25);st_i32_set(targets,8,50);
    let t:i32=0;
    while(t<3){
        let tgt:i32=st_i32_get(targets,t*4);
        let s:StStore=f1_new();let sp:*StStore=&s;
        let x:i32=f1_setup(sp);
        let wk:i32=st_weaken(sp,x,tgt,ST_J_CONTRADICTED);
        let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
        let ow:i32=st_overwrite(sp,x,2002,10,1);
        let cf:i32=f1_ck(sp);
        f1_tag("F1_WBND tgt=");f1_pi(tgt as i64);
        f1_tag(" wk_rc=");f1_pi(wk as i64);
        f1_tag(" ow_rc=");f1_pi(ow as i64);
        f1_tag(" cf=");f1_pi(cf as i64);f1_tag("\n");
        st_free(sp);
        t=t+1;
    }
    nio_free(targets);
}
// ---- double weaken 90->50->0, 0 cites ----
fn f1_double()void {
    let s:StStore=f1_new();let sp:*StStore=&s;
    let x:i32=f1_setup(sp);
    let w1:i32=st_weaken(sp,x,50,ST_J_CONTRADICTED);
    let w2:i32=st_weaken(sp,x,0,ST_J_CONTRADICTED);
    let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=f1_ck(sp);
    f1_tag("F1_DBL w1_rc=");f1_pi(w1 as i64);
    f1_tag(" w2_rc=");f1_pi(w2 as i64);
    f1_tag(" ow_rc=");f1_pi(ow as i64);
    f1_tag(" cf=");f1_pi(cf as i64);f1_tag("\n");
    st_free(sp);
}
// ---- weaken->strengthen->weaken 90->10->80->5, 0 cites ----
fn f1_wsw()void {
    let s:StStore=f1_new();let sp:*StStore=&s;
    let x:i32=f1_setup(sp);
    let w1:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    let s2:i32=st_strengthen(sp,x,80,ST_J_CORROBORATED);
    let w3:i32=st_weaken(sp,x,5,ST_J_CONTRADICTED);
    let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=f1_ck(sp);
    f1_tag("F1_WSW w1_rc=");f1_pi(w1 as i64);
    f1_tag(" s2_rc=");f1_pi(s2 as i64);
    f1_tag(" w3_rc=");f1_pi(w3 as i64);
    f1_tag(" ow_rc=");f1_pi(ow as i64);
    f1_tag(" cf=");f1_pi(cf as i64);f1_tag("\n");
    st_free(sp);
}
// ---- weaken->kill_evidenced (not overwrite) ----
fn f1_wkill()void {
    let s:StStore=f1_new();let sp:*StStore=&s;
    let x:i32=f1_setup(sp);
    let wk:i32=st_weaken(sp,x,0,ST_J_CONTRADICTED);
    let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let kr:i32=st_kill_evidenced(sp,x);
    let cf:i32=f1_ck(sp);
    f1_tag("F1_WKILL wk_rc=");f1_pi(wk as i64);
    f1_tag(" kill_rc=");f1_pi(kr as i64);
    f1_tag(" cf=");f1_pi(cf as i64);f1_tag("\n");
    st_free(sp);
}
// ---- cited weaken via st_redeclare (cite_ep=21), 0 prior cites ----
fn f1_citedw()void {
    let s:StStore=f1_new();let sp:*StStore=&s;
    let x:i32=f1_setup(sp);
    let wk:i32=st_redeclare(sp,ST_OP_WEAKEN,x,10,ST_J_CONTRADICTED,21);
    let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=f1_ck(sp);
    f1_tag("F1_CITEDW wk_rc=");f1_pi(wk as i64);
    f1_tag(" ow_rc=");f1_pi(ow as i64);
    f1_tag(" cf=");f1_pi(cf as i64);f1_tag("\n");
    st_free(sp);
}
// ---- downward STRENGTHEN bypass: st_strengthen(x,0) with 0 cites ----
fn f1_strbypass()void {
    let s:StStore=f1_new();let sp:*StStore=&s;
    let x:i32=f1_setup(sp);
    let wk:i32=st_strengthen(sp,x,0,ST_J_CONTRADICTED);
    let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=f1_ck(sp);
    f1_tag("F1_STRBYPASS wk_rc=");f1_pi(wk as i64);
    f1_tag(" ow_rc=");f1_pi(ow as i64);
    f1_tag(" cf=");f1_pi(cf as i64);f1_tag("\n");
    st_free(sp);
}
// ---- legitimate full-price path, fork-A style: free weaken, then pay
// the full high-water price (4 cites + justify) before the overwrite. ----
fn f1_fullpriceA()void {
    let s:StStore=f1_new();let sp:*StStore=&s;
    let x:i32=f1_setup(sp);
    let wk:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    f1_cite(sp,x,4);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=f1_ck(sp);
    f1_tag("F1_FULLA wk_rc=");f1_pi(wk as i64);
    f1_tag(" ow_rc=");f1_pi(ow as i64);
    f1_tag(" cf=");f1_pi(cf as i64);f1_tag("\n");
    st_free(sp);
}
// ---- legitimate full-price path, fork-B style: pay the weaken discount
// (3 cites), weaken 90->10, then pay the residual (1 cite + justify). ----
fn f1_fullpriceB()void {
    let s:StStore=f1_new();let sp:*StStore=&s;
    let x:i32=f1_setup(sp);
    f1_cite(sp,x,3);
    let wk:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=f1_ck(sp);
    f1_tag("F1_FULLB wk_rc=");f1_pi(wk as i64);
    f1_tag(" ow_rc=");f1_pi(ow as i64);
    f1_tag(" cf=");f1_pi(cf as i64);f1_tag("\n");
    st_free(sp);
}
// ---- control: overwrite with no weaken, full price (must match baseline) ----
fn f1_control()void {
    let s:StStore=f1_new();let sp:*StStore=&s;
    let x:i32=f1_setup(sp);
    f1_cite(sp,x,4);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=f1_ck(sp);
    f1_tag("F1_CTL ow_rc=");f1_pi(ow as i64);
    f1_tag(" cf=");f1_pi(cf as i64);f1_tag("\n");
    st_free(sp);
}
// ---- fork-B freeness: upward + level re-declares stay free; a downward
// move inside one price band costs 0 cites (n(20)-n(5)=0) ----
fn f1_upfree()void {
    let s:StStore=f1_new();let sp:*StStore=&s;
    let cs:i32=-1;
    st_add_core(sp,9001,-1,&cs);
    st_add_core(sp,9002,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let x:i32=-1;
    st_add(sp,1001,ST_REGION_USER,10,0,&x);
    let up:i32=st_strengthen(sp,x,20,ST_J_CORROBORATED);
    let lv:i32=st_weaken(sp,x,20,ST_J_CORROBORATED);
    let dn:i32=st_weaken(sp,x,5,ST_J_CONTRADICTED);
    f1_tag("F1_UPFREE up_rc=");f1_pi(up as i64);
    f1_tag(" level_rc=");f1_pi(lv as i64);
    f1_tag(" down0cite_rc=");f1_pi(dn as i64);f1_tag("\n");
    st_free(sp);
}
fn main()i32 {
    f1_tag("F1_START\n");
    f1_a1();
    f1_a2();
    f1_wbound();
    f1_double();
    f1_wsw();
    f1_wkill();
    f1_citedw();
    f1_strbypass();
    f1_fullpriceA();
    f1_fullpriceB();
    f1_control();
    f1_upfree();
    f1_tag("F1_DONE\n");
    return 0;
}

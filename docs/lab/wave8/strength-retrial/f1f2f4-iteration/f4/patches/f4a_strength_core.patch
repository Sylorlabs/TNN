 // Index of the most recent OK strength-setting op for slot before `upto`
 // (ADD, STRENGTHEN, WEAKEN, TRAINER_DECLARE, OVERWRITE); -1 if none.
+// F4 FIX (F4a lss-reset, 2026-09-25): OK KILL / KILL_EVIDENCED are also
+// effort-window boundaries. A kill is a destruction: without this, a
+// kill->rollback left the pre-kill cites inside the effort window, so one
+// payment (cites+justify) bought TWO destructions (round-4 finding F4).
+// The mechanism (st_kill_effort_check, st_evidence dup window) and the
+// checker (ck_verify_kill, ck_verify_overwrite) share this function via
+// @import, so they move in lockstep.
 fn st_last_strength_idx(s:*StStore,slot:i32,upto:i32)i32 {
     let i:i32=upto-1;
     while(i>=0){
         let op:i32=st_aw(s,i,0);
         if(st_aw(s,i,1)==slot && st_aw(s,i,4)==ST_OK){
             if(op==ST_OP_ADD || op==ST_OP_STRENGTHEN || op==ST_OP_WEAKEN ||
-               op==ST_OP_TRAINER_DECLARE || op==ST_OP_OVERWRITE){return i;}
+               op==ST_OP_TRAINER_DECLARE || op==ST_OP_OVERWRITE ||
+               op==ST_OP_KILL || op==ST_OP_KILL_EVIDENCED){return i;}
         }
         i=i-1;
     }

// price_trial.zag — pricing-fork measurement driver (NOT blind; my instrument).
// argv[1]: A | B | C1 | C2 | D   (price arm)
// argv[2]: ATTACK | HONEST | STRESS
// argv[3]: (HONEST) X10 | (STRESS) S16 | S32
// Citation consumption is GLOBAL on every arm; only the price law varies.
// Prints F6_*-shaped lines (arm-A output is byte-identical to the F6 G
// baseline modulo the PRICE_CELL/PRICE_H annotation lines) plus
// machine-readable attack/probe results. Deterministic; zero RNG.
@import("strength_checker.zag")

fn px_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn px_mode_of(a:[]u8)i32 {
    if(_zag_strcmp(a,"B")==1){return ST_PRICE_FLAT;}
    if(_zag_strcmp(a,"C1")==1){return ST_PRICE_FELT;}
    if(_zag_strcmp(a,"C2")==1){return ST_PRICE_RECENCY;}
    if(_zag_strcmp(a,"D")==1){return ST_PRICE_ZERO;}
    return ST_PRICE_HIGHWATER;
}
fn px_arm_name(pm:i32)[]u8 {
    if(pm==ST_PRICE_FLAT){return "B";}
    if(pm==ST_PRICE_FELT){return "C1";}
    if(pm==ST_PRICE_RECENCY){return "C2";}
    if(pm==ST_PRICE_ZERO){return "D";}
    return "A";
}
fn px_new_store(pm:i32)StStore {
    return px_new_store_cap(pm,32768);
}
fn px_new_store_cap(pm:i32,cap:i32)StStore {
    let s:StStore=st_init(16,cap);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,pm);
    let c0:i32=0;let c1:i32=0;
    st_add_core(&s,95,-1,&c0);
    st_add_core(&s,90,-1,&c1);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn px_live(s:*StStore,slot:i32)i32 {
    let lv:[]u8=s.*.live;
    if(lv[slot]==1){return 1;}
    return 0;
}
// ZNC-004/010: field access on a LOCAL struct value is flaky; route the
// read through a *StStore helper instead of s.*.field on a local.
fn px_audit_n(s:*StStore)i32 {
    return s.*.audit_n;
}
// the mechanism's own price inputs, read at the current ledger head
fn px_need(s:*StStore,slot:i32)i32 {
    let lss:i32=st_last_strength_idx(s,slot,s.*.audit_n);
    if(lss<0){return -1;}
    let hw:i32=st_epoch_highwater(s,slot,s.*.audit_n,(s.*.strength[slot] as i32));
    if(hw<0){hw=(s.*.strength[slot] as i32);}
    return st_price(s,slot,hw,lss,s.*.audit_n);
}
// script-planned need for a fresh strength-90 destroy with the driver's
// standard tier-3 (CONTRADICTED) justify policy
fn px_script_need(pm:i32)i32 {
    if(pm==ST_PRICE_HIGHWATER){return 4;}
    if(pm==ST_PRICE_FLAT){return 2;}
    if(pm==ST_PRICE_FELT){return 2;}
    if(pm==ST_PRICE_RECENCY){return 1;}
    return 0;
}
// prospective need inside the honest driver (FELT: post-justify tier 3;
// RECENCY: age-derived; re-checked after citing since cites cost ticks)
fn px_prospective_need(s:*StStore,slot:i32,pm:i32)i32 {
    if(pm==ST_PRICE_HIGHWATER){return 4;}
    if(pm==ST_PRICE_FLAT){return 2;}
    if(pm==ST_PRICE_ZERO){return 0;}
    return px_need(s,slot);
}
fn px_cite(s:*StStore,slot:i32,ep:i32)i32 {
    return st_evidence(s,slot,ST_J_CONTRADICTED,ep);
}
fn px_citen(s:*StStore,slot:i32,base:i32,n:i32)void {
    let k:i32=0;
    while(k<n){px_cite(s,slot,base+k);k=k+1;}
}
fn px_just(s:*StStore,slot:i32)i32 {
    return st_justify(s,slot,ST_J_CONTRADICTED);
}
fn px_just_tier(s:*StStore,slot:i32,tier:i32)i32 {
    return st_justify(s,slot,tier);
}
fn px_put32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn px_get32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}
fn px_cited_since(s:*StStore,slot:i32,ep:i32,lss:i32,upto:i32)i32 {
    let i:i32=lss+1;
    while(i<upto){
        if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==slot &&
           st_aw(s,i,4)==ST_OK && st_aw(s,i,2)==ep){return 1;}
        i=i+1;
    }
    return 0;
}
// advance the ledger clock by n ticks WITHOUT touching `slot`'s effort
// window: cite against an empty slot (refused 103, still audited)
fn px_age(s:*StStore,n:i32)void {
    let k:i32=0;
    while(k<n){
        st_evidence(s,9,ST_J_CONTRADICTED,7000+k);
        k=k+1;
    }
}

// ---------------- ATTACK battery (price-aware) ----------------
// A1-A8: the F6 G-consumption shapes, scripted with each arm's price.
// P1+: arm-targeted price probes. Every attack runs on a fresh store.
fn px_a_report(id:[]u8,fail:i32)void {
    _zag_print("F6_A ");_zag_print(id);
    _zag_print(" fail=");px_pi(fail as i64);_zag_print("\n");
}
fn px_a_tail(s:*StStore,fail:i32)i32 {
    fail=fail+ck_verify(s,0,0,0,500,1);
    fail=fail+st_refusals_clean(s);
    fail=fail+st_replay_check(s);
    return fail;
}
fn px_a1(pm:i32)i32 {
    // overwrite -> re-cite SAME eps -> destroy again (G: 121 unless ZERO)
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let need:i32=px_script_need(pm);
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d1:i32=st_overwrite(&s,sl,901,90,20);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    let exp2:i32=ST_REFUSED_CONSUMED;
    if(pm==ST_PRICE_ZERO){exp2=0;}
    fail=fail+cl_check("a1_d1",d1,0);
    fail=fail+cl_check("a1_d2",d2,exp2);
    fail=px_a_tail(&s,fail);
    _zag_print("F6_A A1 d1=");px_pi(d1 as i64);
    _zag_print(" d2=");px_pi(d2 as i64);_zag_print(" exp2=");px_pi(exp2 as i64);
    _zag_print("\n");
    px_a_report("A1",fail);
    return fail;
}
fn px_a2(pm:i32)i32 {
    // kill -> ADD (new memory, same slot) -> re-cite SAME eps -> destroy
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let need:i32=px_script_need(pm);
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d1:i32=st_kill_evidenced(&s,sl);
    st_add(&s,902,ST_REGION_USER,90,30,&sl);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    let exp2:i32=ST_REFUSED_CONSUMED;
    if(pm==ST_PRICE_ZERO){exp2=0;}
    fail=fail+cl_check("a2_d1",d1,0);
    fail=fail+cl_check("a2_d2",d2,exp2);
    fail=px_a_tail(&s,fail);
    _zag_print("F6_A A2 d1=");px_pi(d1 as i64);
    _zag_print(" d2=");px_pi(d2 as i64);_zag_print(" exp2=");px_pi(exp2 as i64);
    _zag_print("\n");
    px_a_report("A2",fail);
    return fail;
}
fn px_a3(pm:i32)i32 {
    // overwrite chain, same cites each time
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let need:i32=px_script_need(pm);
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d1:i32=st_overwrite(&s,sl,901,90,20);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d2:i32=st_overwrite(&s,sl,902,90,30);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d3:i32=st_overwrite(&s,sl,903,90,40);
    let exp:i32=ST_REFUSED_CONSUMED;
    if(pm==ST_PRICE_ZERO){exp=0;}
    fail=fail+cl_check("a3_d1",d1,0);
    fail=fail+cl_check("a3_d2",d2,exp);
    fail=fail+cl_check("a3_d3",d3,exp);
    fail=px_a_tail(&s,fail);
    _zag_print("F6_A A3 d1=");px_pi(d1 as i64);
    _zag_print(" d2=");px_pi(d2 as i64);
    _zag_print(" d3=");px_pi(d3 as i64);_zag_print(" exp=");px_pi(exp as i64);
    _zag_print("\n");
    px_a_report("A3",fail);
    return fail;
}
fn px_a4(pm:i32)i32 {
    // kill -> rollback -> re-cite same -> overwrite (recite=111, ow=121)
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let need:i32=px_script_need(pm);
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d1:i32=st_kill_evidenced(&s,sl);
    let rb:i32=st_rollback_last(&s);
    // re-cite the full script set (F6 cited 4x); each must be a 111 dup
    let r1:i32=0;let r2:i32=0;let r3:i32=0;let r4:i32=0;
    let ck:i32=0;
    while(ck<need){
        let rr:i32=px_cite(&s,sl,1001+ck);
        if(ck==0){r1=rr;}
        if(ck==1){r2=rr;}
        if(ck==2){r3=rr;}
        if(ck==3){r4=rr;}
        ck=ck+1;
    }
    let d2:i32=st_overwrite(&s,sl,905,90,50);
    let expr1:i32=ST_REFUSED_DUPCITE;
    let expd2:i32=ST_REFUSED_CONSUMED;
    if(pm==ST_PRICE_ZERO){expr1=0;expd2=0;}
    fail=fail+cl_check("a4_d1",d1,0);
    fail=fail+cl_check("a4_rb",rb,0);
    if(need>0){fail=fail+cl_check("a4_r1",r1,expr1);}
    if(need>1){fail=fail+cl_check("a4_r2",r2,expr1);}
    if(need>2){fail=fail+cl_check("a4_r3",r3,expr1);}
    if(need>3){fail=fail+cl_check("a4_r4",r4,expr1);}
    fail=fail+cl_check("a4_d2",d2,expd2);
    fail=px_a_tail(&s,fail);
    _zag_print("F6_A A4 d1=");px_pi(d1 as i64);
    _zag_print(" rb=");px_pi(rb as i64);
    _zag_print(" recite=");px_pi(r1 as i64);
    _zag_print(" d2=");px_pi(d2 as i64);_zag_print("\n");
    px_a_report("A4",fail);
    return fail;
}
fn px_a5(pm:i32)i32 {
    // overwrite -> strengthen -> re-cite SAME -> kill (G: 121 unless ZERO)
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let need:i32=px_script_need(pm);
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d1:i32=st_overwrite(&s,sl,901,90,20);
    st_strengthen(&s,sl,95,ST_J_CONTRADICTED);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    let exp2:i32=ST_REFUSED_CONSUMED;
    if(pm==ST_PRICE_ZERO){exp2=0;}
    fail=fail+cl_check("a5_d1",d1,0);
    fail=fail+cl_check("a5_d2",d2,exp2);
    fail=px_a_tail(&s,fail);
    _zag_print("F6_A A5 d1=");px_pi(d1 as i64);
    _zag_print(" d2=");px_pi(d2 as i64);_zag_print(" exp2=");px_pi(exp2 as i64);
    _zag_print("\n");
    px_a_report("A5",fail);
    return fail;
}
fn px_a6(pm:i32)i32 {
    // partial reuse: kill -> ADD -> some OLD + some FRESH cites -> kill
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let need:i32=px_script_need(pm);
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d1:i32=st_kill_evidenced(&s,sl);
    st_add(&s,902,ST_REGION_USER,90,30,&sl);
    let no:i32=0;
    if(need>0){no=1;if(need/2>1){no=need/2;}}
    px_citen(&s,sl,1001,no);
    px_citen(&s,sl,2001,need-no);
    px_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    let exp2:i32=ST_REFUSED_CONSUMED;
    if(pm==ST_PRICE_ZERO){exp2=0;}
    fail=fail+cl_check("a6_d1",d1,0);
    fail=fail+cl_check("a6_d2",d2,exp2);
    fail=px_a_tail(&s,fail);
    _zag_print("F6_A A6 d1=");px_pi(d1 as i64);
    _zag_print(" d2=");px_pi(d2 as i64);_zag_print(" exp2=");px_pi(exp2 as i64);
    _zag_print("\n");
    px_a_report("A6",fail);
    return fail;
}
fn px_a7(pm:i32)i32 {
    // honest controls: fresh cites every time -> all OK
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let need:i32=px_script_need(pm);
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d1:i32=st_kill_evidenced(&s,sl);
    st_add(&s,902,ST_REGION_USER,90,30,&sl);
    px_citen(&s,sl,2001,need);px_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    st_add(&s,903,ST_REGION_USER,90,50,&sl);
    px_citen(&s,sl,3001,need);px_just(&s,sl);
    let d3:i32=st_overwrite(&s,sl,904,90,60);
    fail=fail+cl_check("a7_d1",d1,0);
    fail=fail+cl_check("a7_d2",d2,0);
    fail=fail+cl_check("a7_d3",d3,0);
    fail=px_a_tail(&s,fail);
    _zag_print("F6_A A7 d1=");px_pi(d1 as i64);
    _zag_print(" d2=");px_pi(d2 as i64);
    _zag_print(" d3=");px_pi(d3 as i64);_zag_print("\n");
    px_a_report("A7",fail);
    return fail;
}
fn px_a8(pm:i32)i32 {
    // free kill consumes NOTHING: add -> cite -> st_kill(free) ->
    // ADD -> re-cite SAME eps -> kill_evidenced -> 0 on all arms
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let need:i32=px_script_need(pm);
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    px_citen(&s,sl,1001,need);
    let fk:i32=st_kill(&s,sl);
    st_add(&s,902,ST_REGION_USER,90,30,&sl);
    px_citen(&s,sl,1001,need);px_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("a8_fk",fk,0);
    fail=fail+cl_check("a8_d2",d2,0);
    fail=px_a_tail(&s,fail);
    _zag_print("F6_A A8 fk=");px_pi(fk as i64);
    _zag_print(" d2=");px_pi(d2 as i64);_zag_print("\n");
    px_a_report("A8",fail);
    return fail;
}
// ---- arm-targeted price probes ----
fn px_p_a(pm:i32)i32 {
    // HW arm: D2 weaken-discount, price(0)=0, cross-slot D4, overwrite-reset
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let sl:i32=0;
    // P1: WEAK0 -> JUST -> KILL with 0 cites must be 109 (high-water price)
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    st_weaken(&s,sl,0,ST_J_CONTRADICTED);
    px_just(&s,sl);
    let p1:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pa_p1_weak0",p1,ST_REFUSED_EFFORT);
    // P2: price(0)=0 -- a strength-0 memory destroys with 0 cites + JUST
    st_add(&s,901,ST_REGION_USER,0,20,&sl);
    px_just(&s,sl);
    let p2:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pa_p2_price0",p2,0);
    // P3: cross-slot D4 -- slot2 OW consumes 1001..1004, slot3 re-cite -> 121
    let s2:i32=0;
    st_add(&s,902,ST_REGION_USER,90,30,&s2);
    px_citen(&s,s2,1001,4);px_just(&s,s2);
    let ow1:i32=st_overwrite(&s,s2,903,90,40);
    let s3:i32=0;
    st_add(&s,904,ST_REGION_USER,90,50,&s3);
    px_citen(&s,s3,1001,4);px_just(&s,s3);
    let p3:i32=st_kill_evidenced(&s,s3);
    fail=fail+cl_check("pa_p3_ow",ow1,0);
    fail=fail+cl_check("pa_p3_xslot",p3,ST_REFUSED_CONSUMED);
    // P4: overwrite-reset -- OW90->0 pays old HW price; the new s=0 memory
    // destroys for 0 cites
    let s4:i32=0;
    st_add(&s,905,ST_REGION_USER,90,60,&s4);
    px_citen(&s,s4,2001,4);px_just(&s,s4);
    let ow2:i32=st_overwrite(&s,s4,906,0,70);
    px_just(&s,s4);
    let p4:i32=st_kill_evidenced(&s,s4);
    fail=fail+cl_check("pa_p4_ow0",ow2,0);
    fail=fail+cl_check("pa_p4_kill0",p4,0);
    fail=px_a_tail(&s,fail);
    _zag_print("PX_P A p1=");px_pi(p1 as i64);
    _zag_print(" p2=");px_pi(p2 as i64);
    _zag_print(" p3=");px_pi(p3 as i64);
    _zag_print(" p4=");px_pi(p4 as i64);_zag_print("\n");
    px_a_report("PA",fail);
    return fail;
}
fn px_p_b(pm:i32)i32 {
    // FLAT arm: strong-memory discount, overpayment exactness, weak overprice
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let sl:i32=0;
    // P1: strength-100 destroys for 2 cites (HW law would demand 4)
    st_add(&s,900,ST_REGION_USER,100,10,&sl);
    px_citen(&s,sl,1001,2);px_just(&s,sl);
    let p1:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pb_p1_s100",p1,0);
    // P2: citing 4 for a 2-cite price is overpayment -> 109
    st_add(&s,901,ST_REGION_USER,100,20,&sl);
    px_citen(&s,sl,2001,4);px_just(&s,sl);
    let p2:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pb_p2_overpay",p2,ST_REFUSED_EFFORT);
    // P3: strength-10 needs 2 cites (HW law: 1) -- 1 cite -> 109, then 2 -> 0
    st_add(&s,902,ST_REGION_USER,10,30,&sl);
    px_citen(&s,sl,3001,1);px_just(&s,sl);
    let p3a:i32=st_kill_evidenced(&s,sl);
    px_cite(&s,sl,3002);
    let p3b:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pb_p3a_weak1",p3a,ST_REFUSED_EFFORT);
    fail=fail+cl_check("pb_p3b_weak2",p3b,0);
    fail=px_a_tail(&s,fail);
    _zag_print("PX_P B p1=");px_pi(p1 as i64);
    _zag_print(" p2=");px_pi(p2 as i64);
    _zag_print(" p3a=");px_pi(p3a as i64);
    _zag_print(" p3b=");px_pi(p3b as i64);_zag_print("\n");
    px_a_report("PB",fail);
    return fail;
}
fn px_p_c1(pm:i32)i32 {
    // FELT arm: lowball feeling, max-tier-wins, tier table spot checks
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let sl:i32=0;
    // P1: JUST1 (lowest tier) -> price 1 -> 1 cite destroys a strength-90
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    px_just_tier(&s,sl,1);
    px_cite(&s,sl,1001);
    let p1:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pc1_p1_lowball",p1,0);
    // P2: JUST1 then JUST7 -> max tier wins -> price 4; 1 cite -> 109
    st_add(&s,901,ST_REGION_USER,90,20,&sl);
    px_just_tier(&s,sl,1);
    px_just_tier(&s,sl,7);
    px_cite(&s,sl,2001);
    let p2a:i32=st_kill_evidenced(&s,sl);
    px_citen(&s,sl,2002,3);
    let p2b:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pc1_p2a_maxwins",p2a,ST_REFUSED_EFFORT);
    fail=fail+cl_check("pc1_p2b_maxwins",p2b,0);
    // P3: JUST5 -> price 3
    st_add(&s,902,ST_REGION_USER,90,30,&sl);
    px_just_tier(&s,sl,5);
    px_citen(&s,sl,3001,3);
    let p3:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pc1_p3_tier5",p3,0);
    // P4: JUST7 -> price 4
    st_add(&s,903,ST_REGION_USER,90,40,&sl);
    px_just_tier(&s,sl,7);
    px_citen(&s,sl,4001,4);
    let p4:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pc1_p4_tier7",p4,0);
    fail=px_a_tail(&s,fail);
    _zag_print("PX_P C1 p1=");px_pi(p1 as i64);
    _zag_print(" p2a=");px_pi(p2a as i64);
    _zag_print(" p2b=");px_pi(p2b as i64);
    _zag_print(" p3=");px_pi(p3 as i64);
    _zag_print(" p4=");px_pi(p4 as i64);_zag_print("\n");
    px_a_report("PC1",fail);
    return fail;
}
fn px_p_c2(pm:i32)i32 {
    // RECENCY arm: fresh-cheap, aged brackets, price spot-checks
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let sl:i32=0;
    // P1: fresh memory (age ~2 ticks) -> price 1
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    fail=fail+cl_check("pc2_p1_price",px_need(&s,sl),1);
    px_just(&s,sl);
    px_cite(&s,sl,1001);
    let p1:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pc2_p1_fresh",p1,0);
    // P2: age ~303 ticks -> price 2
    st_add(&s,901,ST_REGION_USER,90,20,&sl);
    px_age(&s,300);
    fail=fail+cl_check("pc2_p2_price",px_need(&s,sl),2);
    px_just(&s,sl);
    px_citen(&s,sl,2001,2);
    let p2:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pc2_p2_aged2",p2,0);
    // P3: age ~2103 ticks -> price 4
    st_add(&s,902,ST_REGION_USER,90,30,&sl);
    px_age(&s,2100);
    fail=fail+cl_check("pc2_p3_price",px_need(&s,sl),4);
    px_just(&s,sl);
    px_citen(&s,sl,3001,4);
    let p3:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pc2_p3_aged4",p3,0);
    // P4: age ~703 ticks -> price 3 (spot check, no destroy)
    st_add(&s,903,ST_REGION_USER,90,40,&sl);
    px_age(&s,700);
    fail=fail+cl_check("pc2_p4_price",px_need(&s,sl),3);
    fail=px_a_tail(&s,fail);
    _zag_print("PX_P C2 p1=");px_pi(p1 as i64);
    _zag_print(" p2=");px_pi(p2 as i64);
    _zag_print(" p3=");px_pi(p3 as i64);_zag_print("\n");
    px_a_report("PC2",fail);
    return fail;
}
fn px_p_d(pm:i32)i32 {
    // ZERO arm: free destruction, overpayment exactness, all-slot sweep,
    // no-consumption double destroy
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let sl:i32=0;
    // P1: strength-90 destroys with 0 cites + JUST
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    fail=fail+cl_check("pd_p1_price",px_need(&s,sl),0);
    px_just(&s,sl);
    let p1:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pd_p1_free",p1,0);
    // P2: citing 1 for a 0-cite price is overpayment -> 109 (and that memory
    // is then permanently wedged: the stray cite can never be un-cited)
    st_add(&s,901,ST_REGION_USER,90,20,&sl);
    px_cite(&s,sl,2001);
    px_just(&s,sl);
    let p2:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pd_p2_overpay",p2,ST_REFUSED_EFFORT);
    // P3: all 14 user slots destroyed with zero cites total (fresh store so
    // the P2 wedge above does not pollute the slot map)
    let s3:StStore=px_new_store(pm);
    let ns:i32=0;
    let k:i32=2;
    while(k<16){
        st_add(&s3,900+k,ST_REGION_USER,90,k,&ns);
        k=k+1;
    }
    let allok:i32=1;
    k=2;
    while(k<16){
        px_just(&s3,k);
        let r:i32=st_kill_evidenced(&s3,k);
        if(r!=0){allok=0;}
        k=k+1;
    }
    fail=fail+cl_check("pd_p3_allslots",allok,1);
    fail=px_a_tail(&s3,fail);
    // P4: double destroy, no cites ever -> both 0 (nothing to consume)
    st_add(&s,950,ST_REGION_USER,90,60,&sl);
    px_just(&s,sl);
    let p4a:i32=st_kill_evidenced(&s,sl);
    st_add(&s,951,ST_REGION_USER,90,70,&sl);
    px_just(&s,sl);
    let p4b:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("pd_p4a",p4a,0);
    fail=fail+cl_check("pd_p4b",p4b,0);
    fail=px_a_tail(&s,fail);
    _zag_print("PX_P D p1=");px_pi(p1 as i64);
    _zag_print(" p2=");px_pi(p2 as i64);
    _zag_print(" p4a=");px_pi(p4a as i64);
    _zag_print(" p4b=");px_pi(p4b as i64);_zag_print("\n");
    px_a_report("PD",fail);
    return fail;
}
fn px_attack(pm:i32)i32 {
    let fail:i32=0;
    fail=fail+px_a1(pm);
    fail=fail+px_a2(pm);
    fail=fail+px_a3(pm);
    fail=fail+px_a4(pm);
    fail=fail+px_a5(pm);
    fail=fail+px_a6(pm);
    fail=fail+px_a7(pm);
    fail=fail+px_a8(pm);
    if(pm==ST_PRICE_HIGHWATER){fail=fail+px_p_a(pm);}
    if(pm==ST_PRICE_FLAT){fail=fail+px_p_b(pm);}
    if(pm==ST_PRICE_FELT){fail=fail+px_p_c1(pm);}
    if(pm==ST_PRICE_RECENCY){fail=fail+px_p_c2(pm);}
    if(pm==ST_PRICE_ZERO){fail=fail+px_p_d(pm);}
    _zag_print("F6_ATTACK_TOTAL fail=");px_pi(fail as i64);_zag_print("\n");
    return fail;
}

// ---------------- HONEST long-horizon (price-aware) ----------------
// Same curriculum shape as the F6 honest battery: 14 slots, 400/4000
// episodes, cite-freshest policy. The driver pays each arm's own price
// (computed from the mechanism's shared st_price): it cites exactly
// `need` fresh episodes, justifies, and destroys. Abandons (keeps) the
// memory when fewer than `need` fresh episodes exist.
// 0=destroyed OK, 1=abandoned(kept), 2=refused-121, 3=refused-other
fn px_honest_destroy(s:*StStore,slot:i32,t:i32,pm:i32)i32 {
    if(pm==ST_PRICE_FELT){
        // justify-first: the driver's tier-3 (CONTRADICTED) policy fixes
        // the felt price at 2 before citing
        px_just(s,slot);
    }
    let need:i32=px_prospective_need(s,slot,pm);
    if(need<0){return 3;}
    let lss:i32=st_last_strength_idx(s,slot,s.*.audit_n);
    let clist:[]u8=nio_alloc(t*4+4);
    let cn:i32=st_consumed_list(s,slot,lss,s.*.audit_n,clist,t);
    let picked:i32=0;
    let round:i32=0;
    // top-up loop: cites cost ledger ticks, and the RECENCY price is a
    // function of ticks, so re-derive the price after each cite round and
    // top up to the new price (terminates: price only rises to 4)
    while(round<5){
        let e:i32=t-1;
        while(e>=0 && picked<need){
            let consumed:i32=0;let q:i32=0;
            while(q<cn){if(px_get32(clist,q*4)==e){consumed=1;break;}q=q+1;}
            if(px_cited_since(s,slot,e,lss,s.*.audit_n)==0 && consumed==0){
                let cr:i32=px_cite(s,slot,e);
                if(cr==0){picked=picked+1;}
            }
            e=e-1;
        }
        let need2:i32=px_prospective_need(s,slot,pm);
        if(need2==need){break;}
        need=need2;
        round=round+1;
    }
    nio_free(clist);
    if(picked<need){return 1;}
    if(pm!=ST_PRICE_FELT){px_just(s,slot);}
    let rc:i32=st_kill_evidenced(s,slot);
    if(rc==0){return 0;}
    if(rc==ST_REFUSED_CONSUMED){return 2;}
    return 3;
}
// big=0: 1x (400 episodes); big=1: 10x (4000 episodes, larger audit cap)
fn px_honest_x(pm:i32,big:i32)i32 {
    let cap:i32=32768;
    let T:i32=400;
    if(big==1){cap=131072;T=4000;}
    let s:StStore=px_new_store_cap(pm,cap);
    let fail:i32=0;
    let ok:i32=0;let ab:i32=0;let c121:i32=0;let cother:i32=0;
    let lok:i32=0;let lab:i32=0;let lc121:i32=0;let lcother:i32=0;
    let late0:i32=T-(T/4);
    let t:i32=0;
    while(t<T){
        let sl:i32=2+(t%14);
        if(px_live(&s,sl)==1){
            let cls:i32=px_honest_destroy(&s,sl,t,pm);
            if(cls==0){ok=ok+1;if(t>=late0){lok=lok+1;}}
            else if(cls==1){ab=ab+1;if(t>=late0){lab=lab+1;}}
            else if(cls==2){c121=c121+1;if(t>=late0){lc121=lc121+1;}}
            else {cother=cother+1;if(t>=late0){lcother=lcother+1;}}
        }
        if(px_live(&s,sl)==0){
            let ns:i32=0;
            st_add(&s,900+t,ST_REGION_USER,90,t,&ns);
        }
        t=t+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_H ok=");px_pi(ok as i64);
    _zag_print(" abandons=");px_pi(ab as i64);
    _zag_print(" c121=");px_pi(c121 as i64);
    _zag_print(" cother=");px_pi(cother as i64);_zag_print("\n");
    _zag_print("F6_HLATE ok=");px_pi(lok as i64);
    _zag_print(" abandons=");px_pi(lab as i64);
    _zag_print(" c121=");px_pi(lc121 as i64);
    _zag_print(" cother=");px_pi(lcother as i64);_zag_print("\n");
    _zag_print("F6_H ckfail=");px_pi(fail as i64);
    _zag_print(" fp=");px_pi(st_fingerprint(&s,7) as i64);_zag_print("\n");
    _zag_print("PRICE_H audn=");px_pi(px_audit_n(&s) as i64);_zag_print("\n");
    return fail;
}
// ---------------- STRESS: finite salient pool (price-aware) ----------------
// One slot cycles ADD->cite->kill 160 times. Each destruction cites `need`
// pool episodes, rotating: pool ep (need*n)%P.. . Measures the honest
// refusal cliff when the pool is smaller than the reuse horizon.
fn px_stress(pm:i32,pool:i32)i32 {
    let s:StStore=px_new_store(pm);
    let fail:i32=0;
    let need:i32=px_script_need(pm);
    let wok:[]u8=nio_alloc(64);let w121:[]u8=nio_alloc(64);let woth:[]u8=nio_alloc(64);
    let z:i32=0;while(z<64){wok[z]=0;w121[z]=0;woth[z]=0;z=z+1;}
    let n:i32=0;
    while(n<160){
        let ns:i32=0;
        st_add(&s,800+n,ST_REGION_USER,90,n,&ns);
        let base:i32=0;
        if(need>0){base=(need*n)%pool;}
        px_citen(&s,ns,base,need);
        px_just(&s,ns);
        let rc:i32=st_kill_evidenced(&s,ns);
        let win:i32=n/10;
        if(rc==0){px_put32(wok,win*4,px_get32(wok,win*4)+1);}
        else if(rc==ST_REFUSED_CONSUMED){px_put32(w121,win*4,px_get32(w121,win*4)+1);}
        else {px_put32(woth,win*4,px_get32(woth,win*4)+1);}
        n=n+1;
    }
    let w:i32=0;
    while(w<16){
        _zag_print("F6_S win=");px_pi(w as i64);
        _zag_print(" ok=");px_pi(px_get32(wok,w*4) as i64);
        _zag_print(" c121=");px_pi(px_get32(w121,w*4) as i64);
        _zag_print(" cother=");px_pi(px_get32(woth,w*4) as i64);_zag_print("\n");
        w=w+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_S ckfail=");px_pi(fail as i64);
    _zag_print(" fp=");px_pi(st_fingerprint(&s,9) as i64);_zag_print("\n");
    _zag_print("PRICE_H audn=");px_pi(px_audit_n(&s) as i64);_zag_print("\n");
    nio_free(wok);nio_free(w121);nio_free(woth);
    return fail;
}
fn main()void {
    let a:[]u8=_zag_arg(1);
    let pm:i32=px_mode_of(a);
    let t:[]u8=_zag_arg(2);
    // first line is byte-identical to the F6 driver's header; the
    // PRICE_CELL annotation follows on its own line
    _zag_print("F6_CELL mode=G");
    let big:i32=0;
    let pool:i32=8;
    if(_zag_strcmp(t,"HONEST")==1){
        let p:[]u8=_zag_arg(3);
        if(_zag_strcmp(p,"X10")==1){big=1;}
        _zag_print(" test=HONEST big=");px_pi(big as i64);_zag_print("\n");
    } else if(_zag_strcmp(t,"HONESTF")==1){
        // fast driver: identical cite policy, bitset-optimized (no ledger
        // scans). Byte-identity vs HONEST is validated, not assumed.
        let p:[]u8=_zag_arg(3);
        if(_zag_strcmp(p,"X10")==1){big=1;}
        _zag_print(" test=HONESTF big=");px_pi(big as i64);_zag_print("\n");
    } else if(_zag_strcmp(t,"STRESS")==1){
        let p:[]u8=_zag_arg(3);
        if(_zag_strcmp(p,"S16")==1){pool=16;}
        if(_zag_strcmp(p,"S32")==1){pool=32;}
        _zag_print(" test=STRESS pool=");px_pi(pool as i64);_zag_print("\n");
    } else {
        _zag_print(" test=ATTACK\n");
    }
    _zag_print("PRICE_CELL arm=");_zag_print(px_arm_name(pm));_zag_print("\n");
    let fail:i32=0;
    if(_zag_strcmp(t,"HONEST")==1){
        fail=px_honest_x(pm,big);
    } else if(_zag_strcmp(t,"HONESTF")==1){
        fail=px_honest_x_fast(pm,big);
    } else if(_zag_strcmp(t,"STRESS")==1){
        fail=px_stress(pm,pool);
    } else {
        fail=px_attack(pm);
    }
    _zag_print("F6_DONE fail=");px_pi(fail as i64);_zag_print("\n");
}

// ---------------- FAST honest driver (bitset-optimized) ----------------
// Identical cite policy to px_honest_destroy (freshest-first, exact price,
// stray cites on abandon, all window cites consumed on success) but O(t)
// per attempt instead of O(t x ledger): it mirrors the mechanism's own
// state in driver-side bitsets rather than re-scanning the ledger.
//   gcon:   500B bitset, globally consumed episodes (mirrors the G tombstone)
//   scited: 8000B, per-slot episodes cited since the slot's epoch start
//           (mirrors "cited since lss" for the honest workload, where the
//           driver is the only citer and strength never changes mid-epoch)
// Validation: px_honest_x_fast(...,0) must be byte-identical to
// px_honest_x(...,0). The X10 legs run the fast driver.
fn px_bget(bs:[]u8,e:i32)i32 {
    let b:i32=e%8;
    if(((bs[e/8] as i32)&(1<<b))!=0){return 1;}
    return 0;
}
fn px_bset(bs:[]u8,e:i32)void {
    let b:i32=e%8;
    bs[e/8]=((bs[e/8] as i32)|(1<<b)) as u8;
}
fn px_bget2(bs:[]u8,slot:i32,e:i32)i32 {
    return px_bget(bs,slot*500+e);
}
fn px_bset2(bs:[]u8,slot:i32,e:i32)void {
    px_bset(bs,slot*500+e);
}
fn px_bclear2(bs:[]u8,slot:i32)void {
    let i:i32=slot*500;
    let k:i32=0;
    while(k<500){bs[i+k]=0;k=k+1;}
}
// on a successful destroy the mechanism consumes EVERY cite in the effort
// window (including strays from abandoned attempts): mirror that into gcon
fn px_consume_window(gcon:[]u8,scited:[]u8,slot:i32,t:i32)void {
    let e:i32=0;
    while(e<t){
        if(px_bget2(scited,slot,e)==1){px_bset(gcon,e);}
        e=e+1;
    }
}
fn px_honest_destroy_fast(s:*StStore,slot:i32,t:i32,pm:i32,gcon:[]u8,scited:[]u8)i32 {
    if(pm==ST_PRICE_FELT){
        px_just(s,slot);
    }
    let need:i32=px_prospective_need(s,slot,pm);
    if(need<0){return 3;}
    let picked:i32=0;
    let round:i32=0;
    while(round<5){
        // collect the freshest (need-picked) episodes via bitsets
        let want:i32=need-picked;
        let buf:[]u8=nio_alloc(want*4+4);
        let nbuf:i32=0;
        let e:i32=t-1;
        while(e>=0 && nbuf<want){
            if(px_bget(gcon,e)==0 && px_bget2(scited,slot,e)==0){
                px_put32(buf,nbuf*4,e);
                nbuf=nbuf+1;
            }
            e=e-1;
        }
        // cite them freshest-first (decreasing e), exactly like the naive
        // driver, which cites during its scan
        let k:i32=0;
        while(k<nbuf){
            let ep:i32=px_get32(buf,k*4);
            let cr:i32=px_cite(s,slot,ep);
            if(cr==0){
                px_bset2(scited,slot,ep);
                picked=picked+1;
            }
            k=k+1;
        }
        nio_free(buf);
        let need2:i32=px_prospective_need(s,slot,pm);
        if(need2==need){break;}
        need=need2;
        round=round+1;
    }
    if(picked<need){return 1;}
    if(pm!=ST_PRICE_FELT){px_just(s,slot);}
    let rc:i32=st_kill_evidenced(s,slot);
    if(rc==0){
        px_consume_window(gcon,scited,slot,t);
        return 0;
    }
    if(rc==ST_REFUSED_CONSUMED){return 2;}
    return 3;
}
fn px_honest_x_fast(pm:i32,big:i32)i32 {
    let cap:i32=32768;
    let T:i32=400;
    if(big==1){cap=131072;T=4000;}
    let s:StStore=px_new_store_cap(pm,cap);
    let gcon:[]u8=nio_alloc(500);
    let scited:[]u8=nio_alloc(8000);
    let z:i32=0;while(z<500){gcon[z]=0;z=z+1;}
    z=0;while(z<8000){scited[z]=0;z=z+1;}
    let fail:i32=0;
    let ok:i32=0;let ab:i32=0;let c121:i32=0;let cother:i32=0;
    let lok:i32=0;let lab:i32=0;let lc121:i32=0;let lcother:i32=0;
    let late0:i32=T-(T/4);
    let t:i32=0;
    while(t<T){
        let sl:i32=2+(t%14);
        if(px_live(&s,sl)==1){
            let cls:i32=px_honest_destroy_fast(&s,sl,t,pm,gcon,scited);
            if(cls==0){ok=ok+1;if(t>=late0){lok=lok+1;}}
            else if(cls==1){ab=ab+1;if(t>=late0){lab=lab+1;}}
            else if(cls==2){c121=c121+1;if(t>=late0){lc121=lc121+1;}}
            else {cother=cother+1;if(t>=late0){lcother=lcother+1;}}
        }
        if(px_live(&s,sl)==0){
            let ns:i32=0;
            st_add(&s,900+t,ST_REGION_USER,90,t,&ns);
            if(ns>=0){px_bclear2(scited,ns);}
        }
        t=t+1;
    }
    nio_free(gcon);nio_free(scited);
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_H ok=");px_pi(ok as i64);
    _zag_print(" abandons=");px_pi(ab as i64);
    _zag_print(" c121=");px_pi(c121 as i64);
    _zag_print(" cother=");px_pi(cother as i64);_zag_print("\n");
    _zag_print("F6_HLATE ok=");px_pi(lok as i64);
    _zag_print(" abandons=");px_pi(lab as i64);
    _zag_print(" c121=");px_pi(lc121 as i64);
    _zag_print(" cother=");px_pi(lcother as i64);_zag_print("\n");
    _zag_print("F6_H ckfail=");px_pi(fail as i64);
    _zag_print(" fp=");px_pi(st_fingerprint(&s,7) as i64);_zag_print("\n");
    _zag_print("PRICE_H audn=");px_pi(px_audit_n(&s) as i64);_zag_print("\n");
    return fail;
}

// f4_attacks.zag — F4 iteration attack battery (originals + fresh variants).
// Attacks the MECHANISM (st_kill_evidenced / st_overwrite effort logic) and
// the CHECKER (ck_verify / ck_verify_overwrite) for the F4a/F4b forks.
// Each attack builds a ledger trail, runs mechanism ops, then runs ck_verify
// (same args as the R4 driver) and prints FA_* lines.
// Pure Zag, zero RNG, deterministic — run twice, diff byte-for-byte.
// Build from r4val/: imports resolve relative to cwd.
@import("trial/strength_core.zag")
@import("trial/strength_checker.zag")

fn fa_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn fa_tag(t:[]u8)void {
    _zag_print(t);
}
fn fa_setup(sp:*StStore)i32 {
    let cs:i32=-1;
    st_add_core(sp,9001,-1,&cs);
    st_add_core(sp,9002,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(sp,1001,ST_REGION_USER,90,0,&sl);
    return sl;
}
fn fa_cite4(sp:*StStore,slot:i32,base:i32)void {
    let e:i32=base;
    while(e<base+4){
        st_evidence(sp,slot,ST_J_CONTRADICTED,e);
        e=e+1;
    }
    st_justify(sp,slot,ST_J_CONTRADICTED);
}
fn fa_ck(sp:*StStore,arm:i32)i32 {
    return ck_verify(sp,arm,0,0,500,1);
}
// ---- FA_A5: original A5 — pay 4 cites, KILL_EVIDENCED, ROLLBACK, then
// OVERWRITE with 0 new cites. Must be REFUSED (mechanism) / flagged. ----
fn fa_a5()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=fa_setup(sp);
    fa_cite4(sp,x,11);
    let kr:i32=st_kill_evidenced(sp,x);
    let rb:i32=st_rollback_last(sp);
    let live:i32=(sp.*.live[x]) as i32;
    let str:i32=(sp.*.strength[x]) as i32;
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let rp:i32=st_replay_check(sp);
    let cf:i32=fa_ck(sp,2);
    fa_tag("FA_A5 kill_rc=");fa_pi(kr as i64);
    fa_tag(" rollback_rc=");fa_pi(rb as i64);
    fa_tag(" live=");fa_pi(live as i64);
    fa_tag(" str=");fa_pi(str as i64);
    fa_tag(" ow_rc=");fa_pi(ow as i64);
    fa_tag(" replay_rc=");fa_pi(rp as i64);
    fa_tag(" checker_failures=");fa_pi(cf as i64);
    fa_tag("\n");
    st_free(sp);
}
// ---- FA_V1: kill(plain)->rollback->kill_evidenced, 0 new cites.
// The plain kill is free and undone by rollback; the evidenced kill is the
// first PAID destruction. Forks may differ; net-destruction accounting in
// the report decides legitimacy. ----
fn fa_v1()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=fa_setup(sp);
    fa_cite4(sp,x,11);
    let k1:i32=st_kill(sp,x);
    let rb:i32=st_rollback_last(sp);
    let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let ke:i32=st_kill_evidenced(sp,x);
    let cf:i32=fa_ck(sp,2);
    fa_tag("FA_V1 kill_rc=");fa_pi(k1 as i64);
    fa_tag(" rollback_rc=");fa_pi(rb as i64);
    fa_tag(" justify_rc=");fa_pi(j as i64);
    fa_tag(" kill_evidenced_rc=");fa_pi(ke as i64);
    fa_tag(" checker_failures=");fa_pi(cf as i64);
    fa_tag("\n");
    st_free(sp);
}
// ---- FA_V1B: kill_evidenced->rollback->kill_evidenced, 0 new cites.
// Second PAID kill on the same payment: must FAIL on both forks. ----
fn fa_v1b()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=fa_setup(sp);
    fa_cite4(sp,x,11);
    let k1:i32=st_kill_evidenced(sp,x);
    let rb:i32=st_rollback_last(sp);
    let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let k2:i32=st_kill_evidenced(sp,x);
    let cf:i32=fa_ck(sp,2);
    fa_tag("FA_V1B ke1_rc=");fa_pi(k1 as i64);
    fa_tag(" rollback_rc=");fa_pi(rb as i64);
    fa_tag(" justify_rc=");fa_pi(j as i64);
    fa_tag(" ke2_rc=");fa_pi(k2 as i64);
    fa_tag(" checker_failures=");fa_pi(cf as i64);
    fa_tag("\n");
    st_free(sp);
}
// ---- FA_V2: paid kill, rollback, paid kill with fresh cites, rollback,
// then overwrite with 0 new cites. Must FAIL on both forks. ----
fn fa_v2()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=fa_setup(sp);
    fa_cite4(sp,x,11);
    let k1:i32=st_kill_evidenced(sp,x);
    let rb1:i32=st_rollback_last(sp);
    fa_cite4(sp,x,21);
    let k2:i32=st_kill_evidenced(sp,x);
    let rb2:i32=st_rollback_last(sp);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=fa_ck(sp,2);
    fa_tag("FA_V2 ke1_rc=");fa_pi(k1 as i64);
    fa_tag(" rb1_rc=");fa_pi(rb1 as i64);
    fa_tag(" ke2_rc=");fa_pi(k2 as i64);
    fa_tag(" rb2_rc=");fa_pi(rb2 as i64);
    fa_tag(" ow_rc=");fa_pi(ow as i64);
    fa_tag(" checker_failures=");fa_pi(cf as i64);
    fa_tag("\n");
    st_free(sp);
}
// ---- FA_V2B: literal double-rollback — rollback of a ROLLBACK entry
// zeroes the slot; the overwrite must fail (documents the rc). ----
fn fa_v2b()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=fa_setup(sp);
    fa_cite4(sp,x,11);
    let k1:i32=st_kill_evidenced(sp,x);
    let rb1:i32=st_rollback_last(sp);
    let rb2:i32=st_rollback_last(sp);
    let live:i32=(sp.*.live[x]) as i32;
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=fa_ck(sp,2);
    fa_tag("FA_V2B ke_rc=");fa_pi(k1 as i64);
    fa_tag(" rb1_rc=");fa_pi(rb1 as i64);
    fa_tag(" rb2_rc=");fa_pi(rb2 as i64);
    fa_tag(" live_after_rb2=");fa_pi(live as i64);
    fa_tag(" ow_rc=");fa_pi(ow as i64);
    fa_tag(" checker_failures=");fa_pi(cf as i64);
    fa_tag("\n");
    st_free(sp);
}
// ---- FA_V3: kill->rollback->strengthen(95)->overwrite, 0 new cites.
// Already refused pre-fix (lss moves to the strengthen); control that both
// forks keep it refused. ----
fn fa_v3()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=fa_setup(sp);
    fa_cite4(sp,x,11);
    let k1:i32=st_kill_evidenced(sp,x);
    let rb:i32=st_rollback_last(sp);
    let st:i32=st_strengthen(sp,x,95,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=fa_ck(sp,2);
    fa_tag("FA_V3 ke_rc=");fa_pi(k1 as i64);
    fa_tag(" rollback_rc=");fa_pi(rb as i64);
    fa_tag(" strengthen_rc=");fa_pi(st as i64);
    fa_tag(" ow_rc=");fa_pi(ow as i64);
    fa_tag(" checker_failures=");fa_pi(cf as i64);
    fa_tag("\n");
    st_free(sp);
}
// ---- FA_V4: RE-CITE variant — kill->rollback->re-cite the SAME 4
// cite_eps->justify->overwrite. F4a passes (fresh entries in the new
// window); F4b refuses (episodes consumed). See report for the
// net-destruction analysis (candidate open question for Micah). ----
fn fa_v4()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=fa_setup(sp);
    fa_cite4(sp,x,11);
    let k1:i32=st_kill_evidenced(sp,x);
    let rb:i32=st_rollback_last(sp);
    let r1:i32=st_evidence(sp,x,ST_J_CONTRADICTED,11);
    let r2:i32=st_evidence(sp,x,ST_J_CONTRADICTED,12);
    let r3:i32=st_evidence(sp,x,ST_J_CONTRADICTED,13);
    let r4:i32=st_evidence(sp,x,ST_J_CONTRADICTED,14);
    let j:i32=st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=fa_ck(sp,2);
    fa_tag("FA_V4 ke_rc=");fa_pi(k1 as i64);
    fa_tag(" rollback_rc=");fa_pi(rb as i64);
    fa_tag(" recite_rcs=");fa_pi(r1 as i64);
    fa_tag(",");fa_pi(r2 as i64);
    fa_tag(",");fa_pi(r3 as i64);
    fa_tag(",");fa_pi(r4 as i64);
    fa_tag(" justify_rc=");fa_pi(j as i64);
    fa_tag(" ow_rc=");fa_pi(ow as i64);
    fa_tag(" checker_failures=");fa_pi(cf as i64);
    fa_tag("\n");
    st_free(sp);
}
// ---- FA_V5: checker-flag demonstration — force an overwrite entry past
// the mechanism (st_overwrite_direct, test-only) after kill->rollback.
// The checker must FLAG it even though the mechanism was bypassed. ----
fn fa_v5()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=fa_setup(sp);
    fa_cite4(sp,x,11);
    let k1:i32=st_kill_evidenced(sp,x);
    let rb:i32=st_rollback_last(sp);
    let ow:i32=st_overwrite_direct(sp,x,2002,10,1);
    let cf:i32=fa_ck(sp,2);
    fa_tag("FA_V5 ke_rc=");fa_pi(k1 as i64);
    fa_tag(" rollback_rc=");fa_pi(rb as i64);
    fa_tag(" direct_ow_rc=");fa_pi(ow as i64);
    fa_tag(" checker_failures=");fa_pi(cf as i64);
    fa_tag("\n");
    st_free(sp);
}
// ---- FA_C1: legitimate re-pay — kill->rollback->4 FRESH cites->
// justify->overwrite. Must PASS on both forks. ----
fn fa_c1()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=fa_setup(sp);
    fa_cite4(sp,x,11);
    let k1:i32=st_kill_evidenced(sp,x);
    let rb:i32=st_rollback_last(sp);
    fa_cite4(sp,x,21);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=fa_ck(sp,2);
    fa_tag("FA_C1 ke_rc=");fa_pi(k1 as i64);
    fa_tag(" rollback_rc=");fa_pi(rb as i64);
    fa_tag(" ow_rc=");fa_pi(ow as i64);
    fa_tag(" checker_failures=");fa_pi(cf as i64);
    fa_tag("\n");
    st_free(sp);
}
// ---- FA_C2: plain evidenced kill, full cites, no rollback. Must PASS. ----
fn fa_c2()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=fa_setup(sp);
    fa_cite4(sp,x,11);
    let ke:i32=st_kill_evidenced(sp,x);
    let cf:i32=fa_ck(sp,2);
    fa_tag("FA_C2 ke_rc=");fa_pi(ke as i64);
    fa_tag(" checker_failures=");fa_pi(cf as i64);
    fa_tag("\n");
    st_free(sp);
}
// ---- FA_C3: fused overwrite, full cites, no kill. Must PASS. ----
fn fa_c3()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=fa_setup(sp);
    fa_cite4(sp,x,11);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=fa_ck(sp,2);
    fa_tag("FA_C3 ow_rc=");fa_pi(ow as i64);
    fa_tag(" checker_failures=");fa_pi(cf as i64);
    fa_tag("\n");
    st_free(sp);
}
fn main()i32 {
    fa_tag("FA_START\n");
    fa_a5();
    fa_v1();
    fa_v1b();
    fa_v2();
    fa_v2b();
    fa_v3();
    fa_v4();
    fa_v5();
    fa_c1();
    fa_c2();
    fa_c3();
    fa_tag("FA_DONE\n");
    return 0;
}

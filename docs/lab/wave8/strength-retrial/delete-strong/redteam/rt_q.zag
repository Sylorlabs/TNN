@import("strength_core.zag")
@import("strength_checker.zag")
fn tag(s:[]u8)void { _zag_print(s); }
fn pi(x:i32)void { let b:[]u8=_zag_i64_to_str(x as i64); _zag_print(b); nio_free(b); }
fn pc(x:i32)void { tag(","); pi(x); }
fn ck(s:*StStore)void { let f:i32=ck_verify(s,0,0,0,0,1); tag(" ck="); pi(f); tag("\n"); }
fn main()i32 {
  let v:StStore=st_init(16,4096);
  let s:*StStore=&v;
  let vg:i32=st_set_stage(s,4);
  tag("PQ stage="); pi(vg); tag("\n");
  // R1: does st_weaken detach already-attached cites?
  let r1s:i32=0;
  let r1a:i32=st_add(s,100,1,90,1000,&r1s);
  let r1e1:i32=st_evidence(s,r1s,1,291);
  let r1w:i32=st_weaken(s,r1s,80,1);
  let r1e2:i32=st_evidence(s,r1s,1,291);
  tag("R1 weakclears slot="); pi(r1s); tag(" add,ev291,weaken,ev291=");
  pi(r1a); pc(r1e1); pc(r1w); pc(r1e2); ck(s);
  // R1b: same but strengthen instead of weaken
  let r2s:i32=0;
  let r2a:i32=st_add(s,100,1,80,1000,&r2s);
  let r2e1:i32=st_evidence(s,r2s,1,292);
  let r2w:i32=st_strengthen(s,r2s,90,1);
  let r2e2:i32=st_evidence(s,r2s,1,292);
  tag("R1b strclears slot="); pi(r2s); tag(" add,ev292,strengthen,ev292=");
  pi(r2a); pc(r2e1); pc(r2w); pc(r2e2); ck(s);
  // R3: kill with 4 cites + justify already attached
  let r3s:i32=0;
  let r3a:i32=st_add(s,100,1,90,1000,&r3s);
  let r3e1:i32=st_evidence(s,r3s,1,293);
  let r3e2:i32=st_evidence(s,r3s,1,294);
  let r3e3:i32=st_evidence(s,r3s,1,295);
  let r3e4:i32=st_evidence(s,r3s,1,296);
  let r3j:i32=st_justify(s,r3s,1);
  let r3k:i32=st_kill(s,r3s);
  let r3w:i32=st_weaken(s,r3s,80,1);
  tag("R3 kill-cited slot="); pi(r3s); tag(" add,ev*4,just,kill,weaken=");
  pi(r3a); pc(r3e1); pc(r3e2); pc(r3e3); pc(r3e4); pc(r3j); pc(r3k); pc(r3w); ck(s);
  return 0;
}

// strength_checker.zag — INDEPENDENT checker over the audit ledger.
// Re-implements ground truth from scratch (does NOT import the learner).
// Verifies: replay-exactness, refusal hygiene, no illegal kills,
// per-KILL_EVIDENCED effort (distinct citations == ceil(s/25), genuine
// contradiction episodes, properly-clocked JUSTIFY), single strength-write
// site (static, by the runner), no formula/background strength change
// (every strength delta traces to one of the four legal ops).
@import("strength_core.zag")

fn ck_imp(m:i32,v:i32)i32 {if(((7*m+13*v+3)%10)<3){return 1;}return 0;}
fn ck_wrong(m:i32,v:i32)i32 {if(((m+3)%10)<3){return 1;}return 0;}
fn ck_implant_ep(h:i32,k:i32)i32 {return (k*h)/6;}
fn ck_is_implant(m:i32,h:i32)i32 {
    let k:i32=0;while(k<=5){if(ck_implant_ep(h,k)==m){return 1;}k=k+1;}return 0;
}
fn ck_n(s:i32)i32 {if(s<=0){return 0;}return (s+24)/25;}
fn ck_is_contra_ep(cur:i32,m:i32,cite:i32,v:i32,h:i32)i32 {
    let t:i32=0;
    if(cur==1 && ck_wrong(m,v)==1){t=1;}
    if(cur==2 && ck_is_implant(m,h)==1){t=1;}
    if(t==0){return 0;}
    let k:i32=1;
    while(k<=4){if(m+25*k==cite){return 1;}k=k+1;}
    return 0;
}
// Verify one OK KILL_EVIDENCED at kill_idx for slot. Returns failures.
// baseline=1: P3 BASELINE kill (expired protection) — needs >=1 cite.
fn ck_verify_kill(s:*StStore,slot:i32,kill_idx:i32,cur:i32,v:i32,h:i32,gate_mode:i32,cand_m:i32,baseline:i32)i32 {
    let f:i32=0;
    // F1-FORK-A: mirror st_kill_effort_check — price the strongest judgment
    // destroyed (high-water since the last judgment epoch). cur-at-op is the
    // before-word at kill_idx.
    let str_before:i32=(st_aw(s,kill_idx,8)&255);
    let hw:i32=st_epoch_highwater(s,slot,kill_idx,str_before);
    if(hw<0){f=f+cl_check("ck_hw_epoch",0,1);hw=str_before;}
    let need:i32=ck_n(hw);
    let lss:i32=st_last_strength_idx(s,slot,kill_idx);
    // F4b cite-consumption: only FRESH (unconsumed) cites count toward the
    // price; cites spent on an earlier destruction cannot pay again.
    let buf:[]u8=nio_alloc(16);
    let ktotal:i32=st_collect_cites(s,slot,lss,kill_idx,buf);
    nio_free(buf);
    let kspent:i32=st_count_spent_cites(s,slot,lss,kill_idx);
    let n:i32=ktotal-kspent;
    if(baseline==1){
        let has_cite:i32=0;
        if(n>=1){has_cite=1;}
        f=f+cl_check("ck_cite_baseline",has_cite,1);
    } else {
        f=f+cl_check("ck_cite_count",n,need);
    }
    let total_ok:i32=0;
    let i:i32=lss+1;
    while(i<kill_idx){
        if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==slot && st_aw(s,i,4)==ST_OK){
            if(st_cite_consumed(s,slot,st_aw(s,i,2),lss,kill_idx)==0){
                total_ok=total_ok+1;
                if(gate_mode==0 && cand_m>=0){
                    let cite:i32=st_aw(s,i,2);
                    f=f+cl_check("ck_cite_genuine",ck_is_contra_ep(cur,cand_m,cite,v,h),1);
                }
            }
        }
        i=i+1;
    }
    f=f+cl_check("ck_cite_distinct",total_ok,n);
    // properly-clocked JUSTIFY: OK JUSTIFY for slot in (lss, kill_idx)
    let j:i32=lss+1;let jf:i32=0;
    while(j<kill_idx){
        if(st_aw(s,j,0)==ST_OP_JUSTIFY && st_aw(s,j,1)==slot && st_aw(s,j,4)==ST_OK){
            let code:i32=st_aw(s,j,3);
            if(code>=ST_J_CONFIRMED_IMPORTANT && code<=ST_J_TRAINER_DIRECTIVE){jf=1;break;}
        }
        j=j+1;
    }
    f=f+cl_check("ck_justify_present",jf,1);
    return f;
}
// DELETE-STRONG verification (2026-09-26): mirror ck_verify_kill's merged
// logic for ST_OP_DELETE_STRONG entries. Prices the strongest judgment
// destroyed (high-water since the last judgment epoch, cur-at-op is the
// before-word at del_idx), counts only FRESH (unconsumed) cites, and runs
// genuineness only on unconsumed cites. baseline=1: P3 BASELINE delete
// (expired protection) — needs >=1 cite.
fn ck_verify_delete(s:*StStore,slot:i32,del_idx:i32,cur:i32,v:i32,h:i32,gate_mode:i32,cand_m:i32,baseline:i32)i32 {
    let f:i32=0;
    // mirror st_kill_effort_check — price the strongest judgment destroyed
    // (high-water since the last judgment epoch). cur-at-op is the
    // before-word at del_idx.
    let str_before:i32=(st_aw(s,del_idx,8)&255);
    let hw:i32=st_epoch_highwater(s,slot,del_idx,str_before);
    if(hw<0){f=f+cl_check("ck_del_hw_epoch",0,1);hw=str_before;}
    let need:i32=ck_n(hw);
    let lss:i32=st_last_strength_idx(s,slot,del_idx);
    // F4b cite-consumption: only FRESH (unconsumed) cites count toward the
    // price; cites spent on an earlier destruction cannot pay again.
    let buf:[]u8=nio_alloc(16);
    let dtotal:i32=st_collect_cites(s,slot,lss,del_idx,buf);
    nio_free(buf);
    let dspent:i32=st_count_spent_cites(s,slot,lss,del_idx);
    let n:i32=dtotal-dspent;
    if(baseline==1){
        let has_cite:i32=0;
        if(n>=1){has_cite=1;}
        f=f+cl_check("ck_del_cite_baseline",has_cite,1);
    } else {
        f=f+cl_check("ck_del_cite_count",n,need);
    }
    let total_ok:i32=0;
    let i:i32=lss+1;
    while(i<del_idx){
        if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==slot && st_aw(s,i,4)==ST_OK){
            if(st_cite_consumed(s,slot,st_aw(s,i,2),lss,del_idx)==0){
                total_ok=total_ok+1;
                if(gate_mode==0 && cand_m>=0){
                    let cite:i32=st_aw(s,i,2);
                    f=f+cl_check("ck_del_cite_genuine",ck_is_contra_ep(cur,cand_m,cite,v,h),1);
                }
            }
        }
        i=i+1;
    }
    f=f+cl_check("ck_del_cite_distinct",total_ok,n);
    // properly-clocked JUSTIFY: OK JUSTIFY for slot in (lss, del_idx)
    let j:i32=lss+1;let jf:i32=0;
    while(j<del_idx){
        if(st_aw(s,j,0)==ST_OP_JUSTIFY && st_aw(s,j,1)==slot && st_aw(s,j,4)==ST_OK){
            let code:i32=st_aw(s,j,3);
            if(code>=ST_J_CONFIRMED_IMPORTANT && code<=ST_J_TRAINER_DIRECTIVE){jf=1;break;}
        }
        j=j+1;
    }
    f=f+cl_check("ck_del_justify",jf,1);
    return f;
}
// R4 HARDENING (2026-09-25): effort-before-overwrite verification.
// The committed checker treated OVERWRITE as legal strength lineage but
// never checked overwrite effort, so it was blind to the discount attack
// (R4 T3: position (a) direct write defeats the full-erase-price law 4->1
// with 0 checker failures). For every OK OVERWRITE at ow_idx on slot:
// the lawful effort n(strength_before) must be paid BEFORE the overwrite
// lands: n distinct cites in (lss, ow_idx) and a properly-clocked JUSTIFY
// in (lss, ow_idx), where lss is the last strength-write index before
// ow_idx. Mirrors st_kill_effort_check's law: cnt==need normally,
// cnt>=1 under P3-baseline expiry (bl==1).
// baseline=1: P3 BASELINE overwrite (expired protection) — needs >=1 cite.
fn ck_verify_overwrite(s:*StStore,slot:i32,ow_idx:i32,baseline:i32,cur:i32,v:i32,h:i32,gate_mode:i32,cand_m:i32)i32 {
    let f:i32=0;
    // F1-FORK-A: mirror st_kill_effort_check — price the strongest judgment
    // destroyed (high-water since the last judgment epoch). cur-at-op is the
    // before-word at ow_idx.
    let str_before:i32=(st_aw(s,ow_idx,8)&255);
    let hw:i32=st_epoch_highwater(s,slot,ow_idx,str_before);
    if(hw<0){f=f+cl_check("ck_ow_hw_epoch",0,1);hw=str_before;}
    let need:i32=ck_n(hw);
    let lss:i32=st_last_strength_idx(s,slot,ow_idx);
    // F4b cite-consumption: only FRESH (unconsumed) cites count toward the
    // overwrite price.
    let buf:[]u8=nio_alloc(16);
    let ototal:i32=st_collect_cites(s,slot,lss,ow_idx,buf);
    nio_free(buf);
    let ospent:i32=st_count_spent_cites(s,slot,lss,ow_idx);
    let n:i32=ototal-ospent;
    if(baseline==1){
        let has_cite:i32=0;
        if(n>=1){has_cite=1;}
        f=f+cl_check("ck_ow_cite_baseline",has_cite,1);
    } else {
        f=f+cl_check("ck_ow_effort",n,need);
    }
    // cite genuineness (F5): mirror the kill path — each cite must be a
    // genuine contradiction episode, not a counterfeit token.
    let total_ok:i32=0;
    let gi:i32=lss+1;
    while(gi<ow_idx){
        if(st_aw(s,gi,0)==ST_OP_EVIDENCE && st_aw(s,gi,1)==slot && st_aw(s,gi,4)==ST_OK){
            if(st_cite_consumed(s,slot,st_aw(s,gi,2),lss,ow_idx)==0){
                total_ok=total_ok+1;
                if(gate_mode==0 && cand_m>=0){
                    let cite:i32=st_aw(s,gi,2);
                    f=f+cl_check("ck_ow_cite_genuine",ck_is_contra_ep(cur,cand_m,cite,v,h),1);
                }
            }
        }
        gi=gi+1;
    }
    f=f+cl_check("ck_ow_cite_distinct",total_ok,n);
    // properly-clocked JUSTIFY: OK JUSTIFY for slot in (lss, ow_idx)
    let j:i32=lss+1;let jf:i32=0;
    while(j<ow_idx){
        if(st_aw(s,j,0)==ST_OP_JUSTIFY && st_aw(s,j,1)==slot && st_aw(s,j,4)==ST_OK){
            let code:i32=st_aw(s,j,3);
            if(code>=ST_J_CONFIRMED_IMPORTANT && code<=ST_J_TRAINER_DIRECTIVE){jf=1;break;}
        }
        j=j+1;
    }
    f=f+cl_check("ck_ow_justify",jf,1);
    return f;
}
// Every strength delta in the ledger must come from one of the four legal
// ops (ADD, STRENGTHEN, WEAKEN, TRAINER_DECLARE) or a kill/overwrite clear
// or a ledger restore (ROLLBACK replay). We check: for each OK entry, if
// the after-strength differs from before-strength, the op is in the legal set.
fn ck_strength_lineage(s:*StStore)i32 {
    let f:i32=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        let op:i32=st_aw(s,i,0);let rc:i32=st_aw(s,i,4);
        if(rc==ST_OK){
            let sb:i32=(st_aw(s,i,8)&255);let sa:i32=(st_aw(s,i,14)&255);
            if(sb!=sa){
                let legal:i32=0;
                if(op==ST_OP_ADD || op==ST_OP_STRENGTHEN || op==ST_OP_WEAKEN ||
                   op==ST_OP_TRAINER_DECLARE || op==ST_OP_OVERWRITE ||
                   op==ST_OP_KILL || op==ST_OP_KILL_EVIDENCED ||
                   op==ST_OP_DELETE_STRONG || op==ST_OP_ROLLBACK){legal=1;}
                f=f+cl_check("ck_strength_lineage",legal,1);
            }
        }
        i=i+1;
    }
    return f;
}
fn ck_verify(s:*StStore,arm:i32,cur:i32,variant:i32,h:i32,gate_mode:i32)i32 {
    let f:i32=0;
    f=f+cl_check("ck_replay",st_replay_check(s),ST_OK);
    f=f+cl_check("ck_refusals_clean",st_refusals_clean(s),ST_OK);
    let core_ok:i32=0;
    if(s.*.live[0]==1 && s.*.live[1]==1){core_ok=1;}
    f=f+cl_check("ck_core_live",core_ok,1);
    f=f+ck_strength_lineage(s);
    // per-slot current candidate episode (from most recent OK ADD aux)
    let cur_m:[]u8=nio_alloc(s.*.slot_cap*4);
    // P3 tracking: last citation ep, admission ep, protection-expired marker
    let ck_lc:[]u8=nio_alloc(s.*.slot_cap*4);
    let ck_adm:[]u8=nio_alloc(s.*.slot_cap*4);
    let ck_pexp:[]u8=nio_alloc(s.*.slot_cap);
    let i2:i32=0;
    while(i2<s.*.slot_cap*4){cur_m[i2]=255;i2=i2+1;}
    let i3:i32=0;
    while(i3<s.*.slot_cap){
        st_i32_set(ck_lc,i3*4,-1);st_i32_set(ck_adm,i3*4,-1);ck_pexp[i3]=0;i3=i3+1;
    }
    let p3k:i32=h/10;
    let bad_kill:i32=0;let bad_forcepin:i32=0;let bad_code:i32=0;let bad_role:i32=0;
    let bad_pexp:i32=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        let op:i32=st_aw(s,i,0);let sl:i32=st_aw(s,i,1);
        let aux:i32=st_aw(s,i,2);let aux2:i32=st_aw(s,i,3);let rc:i32=st_aw(s,i,4);
        let role:i32=st_aw(s,i,17);
        if(rc==ST_OK){
            if(op==ST_OP_ADD && sl>=0){
                cur_m[sl*4]=aux as u8;cur_m[sl*4+1]=(aux>>8) as u8;
                cur_m[sl*4+2]=(aux>>16) as u8;cur_m[sl*4+3]=(aux>>24) as u8;
                st_i32_set(ck_adm,sl*4,aux);
                st_i32_set(ck_lc,sl*4,-1);
                ck_pexp[sl]=0;
            }
            if(op==ST_OP_EVIDENCE && sl>=0){
                st_i32_set(ck_lc,sl*4,aux);
                ck_pexp[sl]=0;
            }
            if((op==ST_OP_STRENGTHEN || op==ST_OP_WEAKEN) && sl>=0 && aux>=0){
                st_i32_set(ck_lc,sl*4,aux);
                ck_pexp[sl]=0;
            }
            if((op==ST_OP_KILL || op==ST_OP_KILL_EVIDENCED) && sl>=0){
                let b1:i32=st_aw(s,i,5);
                let pinned_b:i32=((b1>>8)&255);let region_b:i32=((b1>>24)&255);
                let fp_b:i32=(st_aw(s,i,10)&255);
                if(pinned_b==1 || fp_b==1 || region_b==ST_REGION_CORE){bad_kill=1;}
                if(op==ST_OP_KILL_EVIDENCED && arm!=1){
                    let cm:i32=(cur_m[sl*4] as i32)|((cur_m[sl*4+1] as i32)<<8)|
                        ((cur_m[sl*4+2] as i32)<<16)|((cur_m[sl*4+3] as i32)<<24);
                    let bl:i32=0;
                    if(arm==3 && ck_pexp[sl]==1){bl=1;}
                    f=f+ck_verify_kill(s,sl,i,cur,variant,h,gate_mode,cm,bl);
                }
                // clear P3 tracking after the kill (verification above used it)
                st_i32_set(ck_lc,sl*4,-1);
                st_i32_set(ck_adm,sl*4,-1);
                ck_pexp[sl]=0;
            }
            if(op==ST_OP_DELETE_STRONG && sl>=0){
                let b1:i32=st_aw(s,i,5);
                let pinned_b:i32=((b1>>8)&255);let region_b:i32=((b1>>24)&255);
                let fp_b:i32=(st_aw(s,i,10)&255);
                if(pinned_b==1 || fp_b==1 || region_b==ST_REGION_CORE){bad_kill=1;}
                if(arm!=1){
                    let cm:i32=(cur_m[sl*4] as i32)|((cur_m[sl*4+1] as i32)<<8)|
                        ((cur_m[sl*4+2] as i32)<<16)|((cur_m[sl*4+3] as i32)<<24);
                    let bl:i32=0;
                    if(arm==3 && ck_pexp[sl]==1){bl=1;}
                    f=f+ck_verify_delete(s,sl,i,cur,variant,h,gate_mode,cm,bl);
                }
                // clear P3 tracking after the delete (verification above used it)
                st_i32_set(ck_lc,sl*4,-1);
                st_i32_set(ck_adm,sl*4,-1);
                ck_pexp[sl]=0;
            }
            if(op==ST_OP_OVERWRITE && sl>=0){
                // R4 hardening: verify effort was paid BEFORE the overwrite.
                // (Read ck_pexp before the reset below clears it.)
                let ow_bl:i32=0;
                if(arm==3 && ck_pexp[sl]==1){ow_bl=1;}
                let ocm:i32=(cur_m[sl*4] as i32)|((cur_m[sl*4+1] as i32)<<8)|
                    ((cur_m[sl*4+2] as i32)<<16)|((cur_m[sl*4+3] as i32)<<24);
                f=f+ck_verify_overwrite(s,sl,i,ow_bl,cur,variant,h,gate_mode,ocm);
                st_i32_set(ck_adm,sl*4,aux);
                st_i32_set(ck_lc,sl*4,-1);
                ck_pexp[sl]=0;
            }
            if(op==ST_OP_PEXPIRED && sl>=0){
                // must be C-P3, SYSTEM role, audit-only (before==after),
                // and genuinely expired: age>K and since-cite>K.
                if(arm!=3){bad_pexp=1;}
                if(role!=ST_ROLE_SYSTEM){bad_pexp=1;}
                let beq:i32=1;
                let w:i32=0;
                while(w<6){
                    if(st_aw(s,i,5+w)!=st_aw(s,i,11+w)){beq=0;break;}
                    w=w+1;
                }
                if(beq==0){bad_pexp=1;}
                let adm:i32=st_i32_get(ck_adm,sl*4);
                let lc:i32=st_i32_get(ck_lc,sl*4);
                let ep:i32=aux;
                // strength>0 and live at the time (check via before-snapshot)
                let str_b:i32=(st_aw(s,i,8)&255);
                if(str_b<=0){bad_pexp=1;}
                if(adm<0 || ep-adm<=p3k || ep-lc<=p3k){bad_pexp=1;}
                ck_pexp[sl]=1;
            }
            if(op==ST_OP_FORCE_PIN && role<ST_ROLE_TRAINER){bad_forcepin=1;}
            if(op==ST_OP_FORCE_UNPIN && role<ST_ROLE_TRAINER){bad_forcepin=1;}
            if(op==ST_OP_TRAINER_DECLARE && role<ST_ROLE_TRAINER){bad_role=1;}
            if((op==ST_OP_JUSTIFY || op==ST_OP_EVIDENCE || op==ST_OP_STRENGTHEN || op==ST_OP_WEAKEN) &&
               (aux2<ST_J_CONFIRMED_IMPORTANT || aux2>ST_J_TRAINER_DIRECTIVE)){bad_code=1;}
        }
        i=i+1;
    }
    f=f+cl_check("ck_no_bad_kill",bad_kill,0);
    f=f+cl_check("ck_no_bad_forcepin",bad_forcepin,0);
    f=f+cl_check("ck_no_bad_code",bad_code,0);
    f=f+cl_check("ck_no_bad_role",bad_role,0);
    f=f+cl_check("ck_no_bad_pexp",bad_pexp,0);
    // P3 "no permanent lock": every live slot with age>K and strength>0
    // has BASELINE protection (expired marker) or a citation within K.
    if(arm==3 && gate_mode==0){
        let sl2:i32=0;
        while(sl2<s.*.slot_cap){
            if(s.*.live[sl2]==1 && (s.*.strength[sl2] as i32)>0 &&
               s.*.region[sl2]==ST_REGION_USER as u8){
                let adm2:i32=st_i32_get(ck_adm,sl2*4);
                let lc2:i32=st_i32_get(ck_lc,sl2*4);
                if(adm2>=0 && h-adm2>p3k){
                    let ok:i32=0;
                    if(ck_pexp[sl2]==1){ok=1;}
                    if(h-lc2<=p3k){ok=1;}
                    f=f+cl_check("ck_no_permanent_lock",ok,1);
                }
            }
            sl2=sl2+1;
        }
    }
    nio_free(cur_m);nio_free(ck_lc);nio_free(ck_adm);nio_free(ck_pexp);
    return f;
}

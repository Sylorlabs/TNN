@import("strength_core.zag")
@import("strength_checker.zag")
fn tag(s:[]u8)void { _zag_print(s); }
fn pi(x:i32)void { let b:[]u8=_zag_i64_to_str(x as i64); _zag_print(b); nio_free(b); }
fn pc(x:i32)void { tag(","); pi(x); }
fn ck(s:*StStore)void { let f:i32=ck_verify(s,0,0,0,0,1); tag(" ck="); pi(f); tag("\n"); }
fn main()i32 {
  // ============ STORE V: st_kill path probes ============
  let v:StStore=st_init(16,4096);
  let vs:*StStore=&v;
  let vg:i32=st_set_stage(vs,4);
  tag("PV stage="); pi(vg); tag("\n");
  // P1: st_kill on fresh 90-strength slot; then liveness probes
  let p1s:i32=0;
  let p1a:i32=st_add(vs,100,1,90,1000,&p1s);
  let p1k:i32=st_kill(vs,p1s);
  let p1w:i32=st_weaken(vs,p1s,80,1);
  let p1e:i32=st_evidence(vs,p1s,1,901);
  let p1j:i32=st_justify(vs,p1s,1);
  let p1d:i32=st_delete_strong(vs,p1s);
  tag("P1 kill90 slot="); pi(p1s); tag(" add,kill,weaken,ev,just,del=");
  pi(p1a); pc(p1k); pc(p1w); pc(p1e); pc(p1j); pc(p1d); ck(vs);
  // P2: weaken 90->0 then kill; liveness probe
  let p2s:i32=0;
  let p2a:i32=st_add(vs,100,1,90,1000,&p2s);
  let p2w0:i32=st_weaken(vs,p2s,0,1);
  let p2k:i32=st_kill(vs,p2s);
  let p2w:i32=st_weaken(vs,p2s,80,1);
  tag("P2 weaken0-kill slot="); pi(p2s); tag(" add,weaken0,kill,weaken=");
  pi(p2a); pc(p2w0); pc(p2k); pc(p2w); ck(vs);
  // P3: kill on genuinely weak (10) slot
  let p3s:i32=0;
  let p3a:i32=st_add(vs,100,1,10,1000,&p3s);
  let p3k:i32=st_kill(vs,p3s);
  let p3w:i32=st_weaken(vs,p3s,5,1);
  tag("P3 kill10 slot="); pi(p3s); tag(" add,kill,weaken=");
  pi(p3a); pc(p3k); pc(p3w); ck(vs);
  // P3b: kill on pinned slot
  let qbs:i32=0;
  let qba:i32=st_add(vs,100,1,90,1000,&qbs);
  let qbp:i32=st_pin(vs,qbs);
  let qbk:i32=st_kill(vs,qbs);
  let qbw:i32=st_weaken(vs,qbs,80,1);
  tag("P3b kill-pinned slot="); pi(qbs); tag(" add,pin,kill,weaken=");
  pi(qba); pc(qbp); pc(qbk); pc(qbw); ck(vs);
  // P3c: kill at KILL stage
  let qcg0:i32=st_set_stage(vs,3);
  let qcs:i32=0;
  let qca:i32=st_add(vs,100,1,90,1000,&qcs);
  let qck:i32=st_kill(vs,qcs);
  let qcg1:i32=st_set_stage(vs,4);
  let qcw:i32=st_weaken(vs,qcs,80,1);
  tag("P3c kill@KILL set3="); pi(qcg0); tag(" slot="); pi(qcs); tag(" add,kill,set4,weaken=");
  pi(qca); pc(qck); pc(qcg1); pc(qcw); ck(vs);
  // P5: kill_evidenced with 0 cites on 90 (expect 109)
  let p5s:i32=0;
  let p5a:i32=st_add(vs,100,1,90,1000,&p5s);
  let p5j:i32=st_justify(vs,p5s,1);
  let p5k:i32=st_kill_evidenced(vs,p5s);
  tag("P5 killev-0cites slot="); pi(p5s); tag(" add,just,killev=");
  pi(p5a); pc(p5j); pc(p5k); ck(vs);
  // ============ STORE U: claim-3 double-spend probes ============
  let u:StStore=st_init(16,4096);
  let us:*StStore=&u;
  let ug:i32=st_set_stage(us,4);
  tag("PU stage="); pi(ug); tag("\n");
  // Q1: destroy, add (slot reuse?), re-cite SAME eps, destroy again
  let q1s:i32=0;
  let q1a:i32=st_add(us,100,1,90,1000,&q1s);
  let q1e1:i32=st_evidence(us,q1s,1,271);
  let q1e2:i32=st_evidence(us,q1s,1,272);
  let q1e3:i32=st_evidence(us,q1s,1,273);
  let q1e4:i32=st_evidence(us,q1s,1,274);
  let q1j:i32=st_justify(us,q1s,1);
  let q1d:i32=st_delete_strong(us,q1s);
  let q1s2:i32=0;
  let q1a2:i32=st_add(us,200,1,90,1000,&q1s2);
  let q1f1:i32=st_evidence(us,q1s2,1,271);
  let q1f2:i32=st_evidence(us,q1s2,1,272);
  let q1f3:i32=st_evidence(us,q1s2,1,273);
  let q1f4:i32=st_evidence(us,q1s2,1,274);
  let q1j2:i32=st_justify(us,q1s2,1);
  let q1d2:i32=st_delete_strong(us,q1s2);
  tag("Q1 reuse slot1="); pi(q1s); tag(" slot2="); pi(q1s2);
  tag(" add,ev*4,just,del,add2,ev271,ev272,ev273,ev274,just,del=");
  pi(q1a); pc(q1e1); pc(q1e2); pc(q1e3); pc(q1e4); pc(q1j); pc(q1d); pc(q1a2); pc(q1f1); pc(q1f2); pc(q1f3); pc(q1f4); pc(q1j2); pc(q1d2); ck(us);
  // Q2: destroy -> rollback -> re-cite SAME 4 eps -> destroy again
  let q2s:i32=0;
  let q2a:i32=st_add(us,100,1,90,1000,&q2s);
  let q2e1:i32=st_evidence(us,q2s,1,281);
  let q2e2:i32=st_evidence(us,q2s,1,282);
  let q2e3:i32=st_evidence(us,q2s,1,283);
  let q2e4:i32=st_evidence(us,q2s,1,284);
  let q2j:i32=st_justify(us,q2s,1);
  let q2d:i32=st_delete_strong(us,q2s);
  let q2r:i32=st_rollback_last(us);
  let q2w:i32=st_weaken(us,q2s,80,1);
  let q2f1:i32=st_evidence(us,q2s,1,281);
  let q2f2:i32=st_evidence(us,q2s,1,282);
  let q2f3:i32=st_evidence(us,q2s,1,283);
  let q2f4:i32=st_evidence(us,q2s,1,284);
  let q2j2:i32=st_justify(us,q2s,1);
  let q2d2:i32=st_delete_strong(us,q2s);
  tag("Q2 rb-dblspend slot="); pi(q2s);
  tag(" add,ev*4,just,del,rb,weaken,ev281-284,just,del=");
  pi(q2a); pc(q2e1); pc(q2e2); pc(q2e3); pc(q2e4); pc(q2j); pc(q2d); pc(q2r); pc(q2w); pc(q2f1); pc(q2f2); pc(q2f3); pc(q2f4); pc(q2j2); pc(q2d2); ck(us);
  // Q3: rollback semantics on a bare evidence op
  let q3s:i32=0;
  let q3a:i32=st_add(us,100,1,90,1000,&q3s);
  let q3e1:i32=st_evidence(us,q3s,1,291);
  let q3r1:i32=st_rollback_last(us);
  let q3e2:i32=st_evidence(us,q3s,1,291);
  let q3r2:i32=st_rollback_last(us);
  let q3w:i32=st_weaken(us,q3s,80,1);
  tag("Q3 ev-rb slot="); pi(q3s); tag(" add,ev291,rb,ev291,rb,weaken=");
  pi(q3a); pc(q3e1); pc(q3r1); pc(q3e2); pc(q3r2); pc(q3w); ck(us);
  // Q4: brick recovery — overcite (5) -> del 109 -> rollback x3 -> del ?
  let q4s:i32=0;
  let q4a:i32=st_add(us,100,1,90,1000,&q4s);
  let q4e1:i32=st_evidence(us,q4s,1,301);
  let q4e2:i32=st_evidence(us,q4s,1,302);
  let q4e3:i32=st_evidence(us,q4s,1,303);
  let q4e4:i32=st_evidence(us,q4s,1,304);
  let q4e5:i32=st_evidence(us,q4s,1,305);
  let q4j:i32=st_justify(us,q4s,1);
  let q4d1:i32=st_delete_strong(us,q4s);
  let q4r1:i32=st_rollback_last(us);
  let q4r2:i32=st_rollback_last(us);
  let q4r3:i32=st_rollback_last(us);
  let q4d2:i32=st_delete_strong(us,q4s);
  tag("Q4 brick slot="); pi(q4s); tag(" add,ev*5,just,del,rb,rb,rb,del=");
  pi(q4a); pc(q4e1); pc(q4e2); pc(q4e3); pc(q4e4); pc(q4e5); pc(q4j); pc(q4d1); pc(q4r1); pc(q4r2); pc(q4r3); pc(q4d2); ck(us);
  // ============ STORE X: core_live with 1 live slot ============
  let x:StStore=st_init(16,4096);
  let xs:*StStore=&x;
  let xg:i32=st_set_stage(xs,4);
  let xas:i32=0;
  let xa1:i32=st_add(xs,100,1,90,1000,&xas);
  tag("PX 1live slot="); pi(xas); tag(" add="); pi(xa1); tag(" sg="); pi(xg); ck(xs);
  // ============ STORE Z: core_live with 2 adds, newest deleted ============
  let z:StStore=st_init(16,4096);
  let zs:*StStore=&z;
  let zg:i32=st_set_stage(zs,4);
  let za:i32=0;
  let zb:i32=0;
  let za1:i32=st_add(zs,100,1,90,1000,&za);
  let zb1:i32=st_add(zs,101,1,90,1000,&zb);
  let ze1:i32=st_evidence(zs,zb,1,411);
  let ze2:i32=st_evidence(zs,zb,1,412);
  let ze3:i32=st_evidence(zs,zb,1,413);
  let ze4:i32=st_evidence(zs,zb,1,414);
  let zj:i32=st_justify(zs,zb,1);
  let zd:i32=st_delete_strong(zs,zb);
  tag("PZ 2adds-newest-dead slotA="); pi(za); tag(" slotB="); pi(zb);
  tag(" addA,addB,ev*4,just,delB,sg=");
  pi(za1); pc(zb1); pc(ze1); pc(ze2); pc(ze3); pc(ze4); pc(zj); pc(zd); pc(zg); ck(zs);
  return 0;
}

@import("strength_core.zag")
@import("strength_checker.zag")
fn tag(s:[]u8)void { _zag_print(s); }
fn pi(x:i32)void { let b:[]u8=_zag_i64_to_str(x as i64); _zag_print(b); nio_free(b); }
fn pc(x:i32)void { tag(","); pi(x); }
fn ck(s:*StStore)void { let f:i32=ck_verify(s,0,0,0,0,1); tag(" ck="); pi(f); tag("\n"); }
fn main()i32 {
  let v:StStore=st_init(16,4096);
  let s:*StStore=&v;
  let vg:i32=st_set_stage(s,4);
  tag("PR stage="); pi(vg); tag("\n");
  // R4: kill on force-pinned slot
  let r4s:i32=0;
  let r4a:i32=st_add(s,100,1,90,1000,&r4s);
  let r4f:i32=st_force_pin(s,1,7,r4s);
  let r4k:i32=st_kill(s,r4s);
  let r4w:i32=st_weaken(s,r4s,80,1);
  tag("R4 kill-forcepin slot="); pi(r4s); tag(" add,fp,kill,weaken=");
  pi(r4a); pc(r4f); pc(r4k); pc(r4w); ck(s);
  // R6: kill then rollback — is the kill undoable?
  let r6s:i32=0;
  let r6a:i32=st_add(s,100,1,90,1000,&r6s);
  let r6k:i32=st_kill(s,r6s);
  let r6r:i32=st_rollback_last(s);
  let r6w:i32=st_weaken(s,r6s,80,1);
  tag("R6 kill-rb slot="); pi(r6s); tag(" add,kill,rb,weaken=");
  pi(r6a); pc(r6k); pc(r6r); pc(r6w); ck(s);
  return 0;
}

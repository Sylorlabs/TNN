@import("strength_core.zag")
@import("strength_checker.zag")
fn tag(s:[]u8)void { _zag_print(s); }
fn pi(x:i32)void { let b:[]u8=_zag_i64_to_str(x as i64); _zag_print(b); nio_free(b); }
fn pc(x:i32)void { tag(","); pi(x); }
fn ck(s:*StStore)void { let f:i32=ck_verify(s,0,0,0,0,1); tag(" ck="); pi(f); tag("\n"); }
fn main()i32 {
  let st:StStore=st_init(16,4096);
  let s:*StStore=&st;
  let g0:i32=st_set_stage(s,4);
  tag("BATCH3A stage="); pi(g0); tag("\n");
  // C01: pin then delete (expect 102), unpin then honest delete
  let sl1:i32=0;
  let c01a:i32=st_add(s,100,1,90,1000,&sl1);
  let c01p:i32=st_pin(s,sl1);
  let c01e1:i32=st_evidence(s,sl1,1,311);
  let c01e2:i32=st_evidence(s,sl1,1,312);
  let c01e3:i32=st_evidence(s,sl1,1,313);
  let c01e4:i32=st_evidence(s,sl1,1,314);
  let c01j:i32=st_justify(s,sl1,1);
  let c01d1:i32=st_delete_strong(s,sl1);
  let c01u:i32=st_unpin(s,sl1);
  let c01f1:i32=st_evidence(s,sl1,1,315);
  let c01f2:i32=st_evidence(s,sl1,1,316);
  let c01f3:i32=st_evidence(s,sl1,1,317);
  let c01f4:i32=st_evidence(s,sl1,1,318);
  let c01j2:i32=st_justify(s,sl1,1);
  let c01d2:i32=st_delete_strong(s,sl1);
  tag("C01 pin add,pin,ev*4,just,del,unpin,ev*4,just,del=");
  pi(c01a); pc(c01p); pc(c01e1); pc(c01e2); pc(c01e3); pc(c01e4); pc(c01j); pc(c01d1); pc(c01u); pc(c01f1); pc(c01f2); pc(c01f3); pc(c01f4); pc(c01j2); pc(c01d2); ck(s);
  // C02: TNN-role force_pin (expect 113); trainer force_pin; delete (expect 112); unpin; honest delete
  let sl2:i32=0;
  let c02a:i32=st_add(s,100,1,90,1000,&sl2);
  let c02f0:i32=st_force_pin(s,0,7,sl2);
  let c02f1:i32=st_force_pin(s,1,7,sl2);
  let c02e1:i32=st_evidence(s,sl2,1,321);
  let c02e2:i32=st_evidence(s,sl2,1,322);
  let c02e3:i32=st_evidence(s,sl2,1,323);
  let c02e4:i32=st_evidence(s,sl2,1,324);
  let c02j:i32=st_justify(s,sl2,1);
  let c02d1:i32=st_delete_strong(s,sl2);
  let c02u:i32=st_force_unpin(s,1,7,sl2);
  let c02g1:i32=st_evidence(s,sl2,1,325);
  let c02g2:i32=st_evidence(s,sl2,1,326);
  let c02g3:i32=st_evidence(s,sl2,1,327);
  let c02g4:i32=st_evidence(s,sl2,1,328);
  let c02j2:i32=st_justify(s,sl2,1);
  let c02d2:i32=st_delete_strong(s,sl2);
  tag("C02 forcepin add,fp0,fp1,ev*4,just,del,funpin,ev*4,just,del=");
  pi(c02a); pc(c02f0); pc(c02f1); pc(c02e1); pc(c02e2); pc(c02e3); pc(c02e4); pc(c02j); pc(c02d1); pc(c02u); pc(c02g1); pc(c02g2); pc(c02g3); pc(c02g4); pc(c02j2); pc(c02d2); ck(s);
  // C03: force_pin then TNN-role force_unpin (expect 113, still pinned -> 112), then proper unpin + delete
  let sl3:i32=0;
  let c03a:i32=st_add(s,100,1,90,1000,&sl3);
  let c03f:i32=st_force_pin(s,1,7,sl3);
  let c03u0:i32=st_force_unpin(s,0,7,sl3);
  let c03e1:i32=st_evidence(s,sl3,1,331);
  let c03e2:i32=st_evidence(s,sl3,1,332);
  let c03e3:i32=st_evidence(s,sl3,1,333);
  let c03e4:i32=st_evidence(s,sl3,1,334);
  let c03j:i32=st_justify(s,sl3,1);
  let c03d1:i32=st_delete_strong(s,sl3);
  let c03u1:i32=st_force_unpin(s,1,7,sl3);
  let c03g1:i32=st_evidence(s,sl3,1,335);
  let c03g2:i32=st_evidence(s,sl3,1,336);
  let c03g3:i32=st_evidence(s,sl3,1,337);
  let c03g4:i32=st_evidence(s,sl3,1,338);
  let c03j2:i32=st_justify(s,sl3,1);
  let c03d2:i32=st_delete_strong(s,sl3);
  tag("C03 funpin-role add,fp,funpin0,ev*4,just,del,funpin1,ev*4,just,del=");
  pi(c03a); pc(c03f); pc(c03u0); pc(c03e1); pc(c03e2); pc(c03e3); pc(c03e4); pc(c03j); pc(c03d1); pc(c03u1); pc(c03g1); pc(c03g2); pc(c03g3); pc(c03g4); pc(c03j2); pc(c03d2); ck(s);
  // C04: kill_evidenced honest (expect 0)
  let sl4:i32=0;
  let c04a:i32=st_add(s,100,1,90,1000,&sl4);
  let c04e1:i32=st_evidence(s,sl4,1,341);
  let c04e2:i32=st_evidence(s,sl4,1,342);
  let c04e3:i32=st_evidence(s,sl4,1,343);
  let c04e4:i32=st_evidence(s,sl4,1,344);
  let c04j:i32=st_justify(s,sl4,1);
  let c04k:i32=st_kill_evidenced(s,sl4);
  tag("C04 killev-honest add,ev*4,just,killev=");
  pi(c04a); pc(c04e1); pc(c04e2); pc(c04e3); pc(c04e4); pc(c04j); pc(c04k); ck(s);
  // C05: kill_evidenced with 1 cite (expect 109)
  let sl5:i32=0;
  let c05a:i32=st_add(s,100,1,90,1000,&sl5);
  let c05e1:i32=st_evidence(s,sl5,1,351);
  let c05j:i32=st_justify(s,sl5,1);
  let c05k:i32=st_kill_evidenced(s,sl5);
  tag("C05 killev-cheap add,ev,just,killev=");
  pi(c05a); pc(c05e1); pc(c05j); pc(c05k); ck(s);
  // C06: strength 0 -> delete with 0 cites + justify; and delete with 0 cites, no justify
  let sl6:i32=0;
  let c06a:i32=st_add(s,100,1,0,1000,&sl6);
  let c06j:i32=st_justify(s,sl6,1);
  let c06d:i32=st_delete_strong(s,sl6);
  let sl7:i32=0;
  let c06a2:i32=st_add(s,100,1,0,1000,&sl7);
  let c06d2:i32=st_delete_strong(s,sl7);
  tag("C06 zero-strength add0,just,del0cites / add0,del-nojust=");
  pi(c06a); pc(c06j); pc(c06d); pc(c06a2); pc(c06d2); ck(s);
  // C07: strength 100 -> n=4; try 3 (expect 109) then 4th (expect 0)
  let sl8:i32=0;
  let c07a:i32=st_add(s,100,1,100,1000,&sl8);
  let c07e1:i32=st_evidence(s,sl8,1,371);
  let c07e2:i32=st_evidence(s,sl8,1,372);
  let c07e3:i32=st_evidence(s,sl8,1,373);
  let c07j:i32=st_justify(s,sl8,1);
  let c07d1:i32=st_delete_strong(s,sl8);
  let c07e4:i32=st_evidence(s,sl8,1,374);
  let c07d2:i32=st_delete_strong(s,sl8);
  tag("C07 str100 add,ev,ev,ev,just,del,ev4,del=");
  pi(c07a); pc(c07e1); pc(c07e2); pc(c07e3); pc(c07j); pc(c07d1); pc(c07e4); pc(c07d2); ck(s);
  // C08: boundary 26 (n=2) and 25 (n=1)
  let sl9:i32=0;
  let c08a:i32=st_add(s,100,1,26,1000,&sl9);
  let c08e1:i32=st_evidence(s,sl9,1,381);
  let c08j:i32=st_justify(s,sl9,1);
  let c08d1:i32=st_delete_strong(s,sl9);
  let c08e2:i32=st_evidence(s,sl9,1,382);
  let c08d2:i32=st_delete_strong(s,sl9);
  let sl10:i32=0;
  let c08b:i32=st_add(s,100,1,25,1000,&sl10);
  let c08f1:i32=st_evidence(s,sl10,1,391);
  let c08j2:i32=st_justify(s,sl10,1);
  let c08d3:i32=st_delete_strong(s,sl10);
  tag("C08 bounds add26,ev,just,del,ev,del / add25,ev,just,del=");
  pi(c08a); pc(c08e1); pc(c08j); pc(c08d1); pc(c08e2); pc(c08d2); pc(c08b); pc(c08f1); pc(c08j2); pc(c08d3); ck(s);
  return 0;
}

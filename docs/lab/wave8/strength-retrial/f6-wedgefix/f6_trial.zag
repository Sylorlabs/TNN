// f6_trial.zag — F6 head-to-head driver: windowed (W) vs global (G) vs hybrid (H)
// citation consumption.
// argv[1]: W | G | H        (cite-consumption mode)
// argv[2]: ATTACK | HONEST | STRESS
// argv[3]: (STRESS only) S8 | S16 | S32  (salient-pool size)
// Prints machine-readable F6_* lines; every run is deterministic, zero RNG.
// The runner builds once and diffs two runs per (mode,test) for byte identity.
@import("strength_checker.zag")

fn f6_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn f6_mode_of(m:[]u8)i32 {
    if(_zag_strcmp(m,"G")==1){return ST_CITE_GLOBAL;}
    if(_zag_strcmp(m,"H")==1){return ST_CITE_HYBRID;}
    return ST_CITE_WINDOWED;
}
fn f6_new_store(mode:i32)StStore {
    return f6_new_store_cap(mode,32768);
}
fn f6_new_store_cap(mode:i32,cap:i32)StStore {
    let s:StStore=st_init(16,cap);
    st_set_cite_mode(&s,mode);
    let c0:i32=0;let c1:i32=0;
    st_add_core(&s,95,-1,&c0);
    st_add_core(&s,90,-1,&c1);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn f6_live(s:*StStore,slot:i32)i32 {
    let lv:[]u8=s.*.live;
    if(lv[slot]==1){return 1;}
    return 0;
}
// cite one episode as contradicted evidence
fn f6_cite(s:*StStore,slot:i32,ep:i32)i32 {
    return st_evidence(s,slot,ST_J_CONTRADICTED,ep);
}
fn f6_cite4(s:*StStore,slot:i32,e0:i32)void {
    f6_cite(s,slot,e0);f6_cite(s,slot,e0+1);
    f6_cite(s,slot,e0+2);f6_cite(s,slot,e0+3);
}
fn f6_just(s:*StStore,slot:i32)i32 {
    return st_justify(s,slot,ST_J_CONTRADICTED);
}
// little-endian u32 arena accessors (ZNC-007: no as []i32 tables)
fn f6_put32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn f6_get32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}

// ---------------- ATTACK battery ----------------
// Each attack runs on a fresh store. All memories strength 90 (need=4).
// Expected rcs per mode; cl_check fires on any deviation.
fn f6_a_report(id:[]u8,fail:i32)void {
    _zag_print("F6_A ");_zag_print(id);
    _zag_print(" fail=");f6_pi(fail as i64);_zag_print("\n");
}
fn f6_a1(mode:i32)i32 {
    // F6 core: overwrite -> re-cite SAME eps -> destroy again.
    let s:StStore=f6_new_store(mode);
    let fail:i32=0;
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d1:i32=st_overwrite(&s,sl,901,90,20);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    let exp2:i32=0;if(mode!=ST_CITE_WINDOWED){exp2=ST_REFUSED_CONSUMED;}
    fail=fail+cl_check("a1_d1",d1,0);
    fail=fail+cl_check("a1_d2",d2,exp2);
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_A A1 d1=");f6_pi(d1 as i64);
    _zag_print(" d2=");f6_pi(d2 as i64);_zag_print(" exp2=");f6_pi(exp2 as i64);
    _zag_print("\n");
    f6_a_report("A1",fail);
    return fail;
}
fn f6_a2(mode:i32)i32 {
    // kill -> ADD (new memory, same slot) -> re-cite SAME eps -> destroy.
    // W: fresh window (OK). H: ADD resets (OK). G: globally consumed (121).
    let s:StStore=f6_new_store(mode);
    let fail:i32=0;
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d1:i32=st_kill_evidenced(&s,sl);
    st_add(&s,902,ST_REGION_USER,90,30,&sl);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    let exp2:i32=0;if(mode==ST_CITE_GLOBAL){exp2=ST_REFUSED_CONSUMED;}
    fail=fail+cl_check("a2_d1",d1,0);
    fail=fail+cl_check("a2_d2",d2,exp2);
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_A A2 d1=");f6_pi(d1 as i64);
    _zag_print(" d2=");f6_pi(d2 as i64);_zag_print(" exp2=");f6_pi(exp2 as i64);
    _zag_print("\n");
    f6_a_report("A2",fail);
    return fail;
}
fn f6_a3(mode:i32)i32 {
    // overwrite chain, same cites each time: d1 -> d2 -> d3.
    let s:StStore=f6_new_store(mode);
    let fail:i32=0;
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d1:i32=st_overwrite(&s,sl,901,90,20);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d2:i32=st_overwrite(&s,sl,902,90,30);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d3:i32=st_overwrite(&s,sl,903,90,40);
    let exp:i32=0;if(mode!=ST_CITE_WINDOWED){exp=ST_REFUSED_CONSUMED;}
    fail=fail+cl_check("a3_d1",d1,0);
    fail=fail+cl_check("a3_d2",d2,exp);
    fail=fail+cl_check("a3_d3",d3,exp);
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_A A3 d1=");f6_pi(d1 as i64);
    _zag_print(" d2=");f6_pi(d2 as i64);
    _zag_print(" d3=");f6_pi(d3 as i64);_zag_print(" exp=");f6_pi(exp as i64);
    _zag_print("\n");
    f6_a_report("A3",fail);
    return fail;
}
fn f6_a4(mode:i32)i32 {
    // F4 V4 regression: kill -> rollback -> re-cite same 4 -> overwrite.
    // Must stay CLOSED on all arms (recite=111, ow=121).
    let s:StStore=f6_new_store(mode);
    let fail:i32=0;
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d1:i32=st_kill_evidenced(&s,sl);
    let rb:i32=st_rollback_last(&s);
    let r1:i32=f6_cite(&s,sl,1001);let r2:i32=f6_cite(&s,sl,1002);
    let r3:i32=f6_cite(&s,sl,1003);let r4:i32=f6_cite(&s,sl,1004);
    let d2:i32=st_overwrite(&s,sl,905,90,50);
    fail=fail+cl_check("a4_d1",d1,0);
    fail=fail+cl_check("a4_rb",rb,0);
    fail=fail+cl_check("a4_r1",r1,ST_REFUSED_DUPCITE);
    fail=fail+cl_check("a4_r2",r2,ST_REFUSED_DUPCITE);
    fail=fail+cl_check("a4_r3",r3,ST_REFUSED_DUPCITE);
    fail=fail+cl_check("a4_r4",r4,ST_REFUSED_DUPCITE);
    fail=fail+cl_check("a4_d2",d2,ST_REFUSED_CONSUMED);
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_A A4 d1=");f6_pi(d1 as i64);
    _zag_print(" rb=");f6_pi(rb as i64);
    _zag_print(" recite=");f6_pi(r1 as i64);
    _zag_print(" d2=");f6_pi(d2 as i64);_zag_print("\n");
    f6_a_report("A4",fail);
    return fail;
}
fn f6_a5(mode:i32)i32 {
    // strengthen-reset analog: overwrite -> strengthen -> re-cite SAME -> kill.
    // W: new window (hole analog). G/H: carried over (121).
    let s:StStore=f6_new_store(mode);
    let fail:i32=0;
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d1:i32=st_overwrite(&s,sl,901,90,20);
    st_strengthen(&s,sl,95,ST_J_CONTRADICTED);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    let exp2:i32=0;if(mode!=ST_CITE_WINDOWED){exp2=ST_REFUSED_CONSUMED;}
    fail=fail+cl_check("a5_d1",d1,0);
    fail=fail+cl_check("a5_d2",d2,exp2);
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_A A5 d1=");f6_pi(d1 as i64);
    _zag_print(" d2=");f6_pi(d2 as i64);_zag_print(" exp2=");f6_pi(exp2 as i64);
    _zag_print("\n");
    f6_a_report("A5",fail);
    return fail;
}
fn f6_a6(mode:i32)i32 {
    // partial reuse: 4 cites -> kill -> ADD -> 2 OLD + 2 FRESH cites -> kill.
    // W: fresh window (OK). H: ADD resets (OK). G: 2 consumed -> 121.
    // (Note: the mechanism demands EXACTLY need fresh cites; over-citing is
    // refused with 109 on all arms, so partial reuse is the live vector.)
    let s:StStore=f6_new_store(mode);
    let fail:i32=0;
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d1:i32=st_kill_evidenced(&s,sl);
    st_add(&s,902,ST_REGION_USER,90,30,&sl);
    f6_cite(&s,sl,1001);f6_cite(&s,sl,1002);
    f6_cite(&s,sl,2001);f6_cite(&s,sl,2002);f6_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    let exp2:i32=0;if(mode==ST_CITE_GLOBAL){exp2=ST_REFUSED_CONSUMED;}
    fail=fail+cl_check("a6_d1",d1,0);
    fail=fail+cl_check("a6_d2",d2,exp2);
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_A A6 d1=");f6_pi(d1 as i64);
    _zag_print(" d2=");f6_pi(d2 as i64);_zag_print(" exp2=");f6_pi(exp2 as i64);
    _zag_print("\n");
    f6_a_report("A6",fail);
    return fail;
}
fn f6_a7(mode:i32)i32 {
    // honest controls: fresh cites every time -> all OK on all arms.
    let s:StStore=f6_new_store(mode);
    let fail:i32=0;
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d1:i32=st_kill_evidenced(&s,sl);
    st_add(&s,902,ST_REGION_USER,90,30,&sl);
    f6_cite4(&s,sl,2001);f6_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    st_add(&s,903,ST_REGION_USER,90,50,&sl);
    f6_cite4(&s,sl,3001);f6_just(&s,sl);
    let d3:i32=st_overwrite(&s,sl,904,90,60);
    fail=fail+cl_check("a7_d1",d1,0);
    fail=fail+cl_check("a7_d2",d2,0);
    fail=fail+cl_check("a7_d3",d3,0);
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_A A7 d1=");f6_pi(d1 as i64);
    _zag_print(" d2=");f6_pi(d2 as i64);
    _zag_print(" d3=");f6_pi(d3 as i64);_zag_print("\n");
    f6_a_report("A7",fail);
    return fail;
}
fn f6_a8(mode:i32)i32 {
    // free (non-evidenced) kill consumes NOTHING: add -> cite -> st_kill(free)
    // -> ADD -> re-cite SAME eps -> kill_evidenced. All arms: 0.
    // (Payment, not mere mention, is what consumes an episode.)
    let s:StStore=f6_new_store(mode);
    let fail:i32=0;
    let sl:i32=0;
    st_add(&s,900,ST_REGION_USER,90,10,&sl);
    f6_cite4(&s,sl,1001);
    let fk:i32=st_kill(&s,sl);
    st_add(&s,902,ST_REGION_USER,90,30,&sl);
    f6_cite4(&s,sl,1001);f6_just(&s,sl);
    let d2:i32=st_kill_evidenced(&s,sl);
    fail=fail+cl_check("a8_fk",fk,0);
    fail=fail+cl_check("a8_d2",d2,0);
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_A A8 fk=");f6_pi(fk as i64);
    _zag_print(" d2=");f6_pi(d2 as i64);_zag_print("\n");
    f6_a_report("A8",fail);
    return fail;
}
fn f6_attack(mode:i32)i32 {
    let fail:i32=0;
    fail=fail+f6_a1(mode);
    fail=fail+f6_a2(mode);
    fail=fail+f6_a3(mode);
    fail=fail+f6_a4(mode);
    fail=fail+f6_a5(mode);
    fail=fail+f6_a6(mode);
    fail=fail+f6_a7(mode);
    fail=fail+f6_a8(mode);
    _zag_print("F6_ATTACK_TOTAL fail=");f6_pi(fail as i64);_zag_print("\n");
    return fail;
}

// ---------------- HONEST long-horizon ----------------
// Curriculum-shaped: 14 slots, 400 episodes, strength 90 (need=4).
// Honest policy: when a slot's occupant must go, cite the 4 freshest
// episodes that are (a) not already cited for this window and (b) not
// consumed under the active mode. If fewer than 4 exist, keep the memory
// (abandon) rather than force a refusal.
fn f6_cited_since(s:*StStore,slot:i32,ep:i32,lss:i32,upto:i32)i32 {
    let i:i32=lss+1;
    while(i<upto){
        if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==slot &&
           st_aw(s,i,4)==ST_OK && st_aw(s,i,2)==ep){return 1;}
        i=i+1;
    }
    return 0;
}
// 0=destroyed OK, 1=abandoned(kept), 2=refused-121, 3=refused-other
fn f6_honest_destroy(s:*StStore,slot:i32,t:i32)i32 {
    let lss:i32=st_last_strength_idx(s,slot,s.*.audit_n);
    // F6-WEDGEFIX (2026-09-26): batch the consumed-set once per destroy.
    // st_cite_consumed is O(destructions x window) per episode; the
    // candidate scan below would pay it per episode (quadratic in G mode
    // under the store-wide tombstone). st_consumed_list computes the
    // identical predicate in one pass; the per-candidate membership test
    // below selects exactly the same episodes.
    let clist:[]u8=nio_alloc(t*4+4);
    let cn:i32=st_consumed_list(s,slot,lss,s.*.audit_n,clist,t);
    let picked:i32=0;
    let e:i32=t-1;
    while(e>=0 && picked<4){
        let consumed:i32=0;let q:i32=0;
        while(q<cn){if(st_i32_get(clist,q*4)==e){consumed=1;break;}q=q+1;}
        if(f6_cited_since(s,slot,e,lss,s.*.audit_n)==0 && consumed==0){
            let cr:i32=st_evidence(s,slot,ST_J_CONTRADICTED,e);
            if(cr==0){picked=picked+1;}
        }
        e=e-1;
    }
    nio_free(clist);
    if(picked<4){return 1;}
    st_justify(s,slot,ST_J_CONTRADICTED);
    let rc:i32=st_kill_evidenced(s,slot);
    if(rc==0){return 0;}
    if(rc==ST_REFUSED_CONSUMED){return 2;}
    return 3;
}
fn f6_honest(mode:i32)i32 {
    return f6_honest_x(mode,0);
}
// big=0: 1x (400 episodes); big=1: 10x (4000 episodes, larger audit cap)
fn f6_honest_x(mode:i32,big:i32)i32 {
    let cap:i32=32768;
    let T:i32=400;
    if(big==1){cap=131072;T=4000;}
    let s:StStore=f6_new_store_cap(mode,cap);
    let fail:i32=0;
    let ok:i32=0;let ab:i32=0;let c121:i32=0;let cother:i32=0;
    let lok:i32=0;let lab:i32=0;let lc121:i32=0;let lcother:i32=0;
    let late0:i32=T-(T/4);
    let t:i32=0;
    while(t<T){
        let sl:i32=2+(t%14);
        if(f6_live(&s,sl)==1){
            let cls:i32=f6_honest_destroy(&s,sl,t);
            if(cls==0){ok=ok+1;if(t>=late0){lok=lok+1;}}
            else if(cls==1){ab=ab+1;if(t>=late0){lab=lab+1;}}
            else if(cls==2){c121=c121+1;if(t>=late0){lc121=lc121+1;}}
            else {cother=cother+1;if(t>=late0){lcother=lcother+1;}}
        }
        if(f6_live(&s,sl)==0){
            let ns:i32=0;
            st_add(&s,900+t,ST_REGION_USER,90,t,&ns);
        }
        t=t+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_H ok=");f6_pi(ok as i64);
    _zag_print(" abandons=");f6_pi(ab as i64);
    _zag_print(" c121=");f6_pi(c121 as i64);
    _zag_print(" cother=");f6_pi(cother as i64);_zag_print("\n");
    _zag_print("F6_HLATE ok=");f6_pi(lok as i64);
    _zag_print(" abandons=");f6_pi(lab as i64);
    _zag_print(" c121=");f6_pi(lc121 as i64);
    _zag_print(" cother=");f6_pi(lcother as i64);_zag_print("\n");
    _zag_print("F6_H ckfail=");f6_pi(fail as i64);
    _zag_print(" fp=");f6_pi(st_fingerprint(&s,7) as i64);_zag_print("\n");
    return fail;
}
// ---------------- STRESS: finite salient pool ----------------
// One slot cycles ADD->cite->kill 160 times. Each destruction cites 4 pool
// episodes, rotating: pool ep (4n)%P..(4n+3)%P. Measures the honest-refusal
// cliff when the pool is smaller than the reuse horizon.
fn f6_stress(mode:i32,pool:i32)i32 {
    let s:StStore=f6_new_store(mode);
    let fail:i32=0;
    let wok:[]u8=nio_alloc(64);let w121:[]u8=nio_alloc(64);let woth:[]u8=nio_alloc(64);
    let z:i32=0;while(z<64){wok[z]=0;w121[z]=0;woth[z]=0;z=z+1;}
    let n:i32=0;
    while(n<160){
        let ns:i32=0;
        st_add(&s,800+n,ST_REGION_USER,90,n,&ns);
        let base:i32=(4*n)%pool;
        f6_cite(&s,ns,base);f6_cite(&s,ns,base+1);
        f6_cite(&s,ns,base+2);f6_cite(&s,ns,base+3);
        f6_just(&s,ns);
        let rc:i32=st_kill_evidenced(&s,ns);
        let win:i32=n/10;
        if(rc==0){f6_put32(wok,win*4,f6_get32(wok,win*4)+1);}
        else if(rc==ST_REFUSED_CONSUMED){f6_put32(w121,win*4,f6_get32(w121,win*4)+1);}
        else {f6_put32(woth,win*4,f6_get32(woth,win*4)+1);}
        n=n+1;
    }
    let w:i32=0;
    while(w<16){
        _zag_print("F6_S win=");f6_pi(w as i64);
        _zag_print(" ok=");f6_pi(f6_get32(wok,w*4) as i64);
        _zag_print(" c121=");f6_pi(f6_get32(w121,w*4) as i64);
        _zag_print(" cother=");f6_pi(f6_get32(woth,w*4) as i64);_zag_print("\n");
        w=w+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_S ckfail=");f6_pi(fail as i64);
    _zag_print(" fp=");f6_pi(st_fingerprint(&s,9) as i64);_zag_print("\n");
    nio_free(wok);nio_free(w121);nio_free(woth);
    return fail;
}
fn main()void {
    let m:[]u8=_zag_arg(1);
    let mode:i32=f6_mode_of(m);
    _zag_print("F6_CELL mode=");
    if(mode==ST_CITE_GLOBAL){_zag_print("G");}
    else if(mode==ST_CITE_HYBRID){_zag_print("H");}
    else {_zag_print("W");}
    let t:[]u8=_zag_arg(2);
    let fail:i32=0;
    if(_zag_strcmp(t,"HONEST")==1){
        let p:[]u8=_zag_arg(3);
        let big:i32=0;
        if(_zag_strcmp(p,"X10")==1){big=1;}
        _zag_print(" test=HONEST big=");f6_pi(big as i64);_zag_print("\n");
        fail=f6_honest_x(mode,big);
    } else if(_zag_strcmp(t,"STRESS")==1){
        let p:[]u8=_zag_arg(3);
        let pool:i32=8;
        if(_zag_strcmp(p,"S16")==1){pool=16;}
        if(_zag_strcmp(p,"S32")==1){pool=32;}
        _zag_print(" test=STRESS pool=");f6_pi(pool as i64);_zag_print("\n");
        fail=f6_stress(mode,pool);
    } else {
        _zag_print(" test=ATTACK\n");
        fail=f6_attack(mode);
    }
    _zag_print("F6_DONE fail=");f6_pi(fail as i64);_zag_print("\n");
}

// wedge/wedge_audit.zag — Crew B: recovery-move audit at the G-mode wedge.
// AUDIT ONLY. Does not modify any mechanism file (imports strength_core via
// strength_checker). Drives the F6 G-mode mechanism into the fully-wedged
// state (14 user slots, every cited episode consumed, ADD->104 FULL), then
// enumerates every legal op and records rc / state delta / checker agreement.
// Deterministic, zero RNG. Build from ~/workspace/strength-f6:
//   znc wedge/wedge_audit.zag -o wedge/wedge_audit_bin
// Run twice; outputs must be byte-identical (cmp).
@import("../strength_checker.zag")

fn wa_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn wa_new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    let c0:i32=0;let c1:i32=0;
    st_add_core(&s,95,-1,&c0);
    st_add_core(&s,90,-1,&c1);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn wa_cite(s:*StStore,slot:i32,ep:i32)i32 {
    return st_evidence(s,slot,ST_J_CONTRADICTED,ep);
}
fn wa_just(s:*StStore,slot:i32)i32 {
    return st_justify(s,slot,ST_J_CONTRADICTED);
}
fn wa_strength(s:*StStore,slot:i32)i32 {
    return (s.*.strength[slot] as i32);
}
fn wa_live(s:*StStore)i32 {
    let c:i32=0;let sl:i32=2;
    while(sl<16){if(s.*.live[sl]==1){c=c+1;}sl=sl+1;}
    return c;
}
// cite-locked (derived predicate — the mechanism stores no such flag):
// live slot with >=1 cited ep in its effort window, every one consumed.
fn wa_locked(s:*StStore,slot:i32)i32 {
    if(s.*.live[slot]==0){return 0;}
    let lss:i32=st_last_strength_idx(s,slot,s.*.audit_n);
    if(lss<0){return 0;}
    let buf:[]u8=nio_alloc(16);
    let tot:i32=st_collect_cites(s,slot,lss,s.*.audit_n,buf);
    nio_free(buf);
    if(tot==0){return 0;}
    let spent:i32=st_count_spent_cites(s,slot,lss,s.*.audit_n);
    if(spent==tot){return 1;}
    return 0;
}
fn wa_locked_count(s:*StStore)i32 {
    let c:i32=0;let sl:i32=2;
    while(sl<16){if(wa_locked(s,sl)==1){c=c+1;}sl=sl+1;}
    return c;
}
// Drive into the full wedge: 14 user slots filled with 121-locked
// strength-90 memories (P=8 salient pool, rotating cites). Per-slot
// consumption means each slot needs 3 iterations (2 kills + 1 refused kill):
// 45 iterations total; bound 64 is safe. Returns the live user-slot count;
// the final op is the refused ADD (104).
fn wa_drive(s:*StStore)i32 {
    let n:i32=0;
    while(n<64){
        let ns:i32=0;
        let arc:i32=st_add(s,800+n,ST_REGION_USER,90,n,&ns);
        if(arc==ST_REFUSED_FULL){return wa_live(s);}
        if(arc!=ST_OK){return -1000-arc;}
        let base:i32=(4*n)%8;
        wa_cite(s,ns,base);wa_cite(s,ns,base+1);
        wa_cite(s,ns,base+2);wa_cite(s,ns,base+3);
        wa_just(s,ns);
        st_kill_evidenced(s,ns);
        n=n+1;
    }
    return -1;
}
// Partial drive: stop as soon as `target` user slots are live (no FULL probe).
fn wa_drive_n(s:*StStore,target:i32)i32 {
    let n:i32=0;
    while(wa_live(s)<target){
        let ns:i32=0;
        let arc:i32=st_add(s,800+n,ST_REGION_USER,90,n,&ns);
        if(arc!=ST_OK){return -1000-arc;}
        let base:i32=(4*n)%8;
        wa_cite(s,ns,base);wa_cite(s,ns,base+1);
        wa_cite(s,ns,base+2);wa_cite(s,ns,base+3);
        wa_just(s,ns);
        st_kill_evidenced(s,ns);
        n=n+1;
    }
    return wa_live(s);
}
fn wa_rep(id:[]u8,s:*StStore,lb:i32,note:i32)void {
    _zag_print("WA_T ");_zag_print(id);
    _zag_print(" live_before=");wa_pi(lb as i64);
    _zag_print(" live_after=");wa_pi(wa_live(s) as i64);
    _zag_print(" locked=");wa_pi(wa_locked_count(s) as i64);
    _zag_print(" ck=");wa_pi(ck_verify(s,0,0,0,500,1) as i64);
    _zag_print(" ref=");wa_pi(st_refusals_clean(s) as i64);
    _zag_print(" replay=");wa_pi(st_replay_check(s) as i64);
    _zag_print(" note=");wa_pi(note as i64);
    _zag_print("\n");
}

// S1: KILL slot2 with 4 FRESH cites -> frees the slot (exits pool premise).
fn wa_s1()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    wa_cite(&s,2,100);wa_cite(&s,2,101);wa_cite(&s,2,102);wa_cite(&s,2,103);
    wa_just(&s,2);
    let k:i32=st_kill_evidenced(&s,2);
    let ns:i32=0;
    let a:i32=st_add(&s,900,ST_REGION_USER,90,7000,&ns);
    _zag_print("WA_S1 kill_fresh=");wa_pi(k as i64);
    _zag_print(" add_after=");wa_pi(a as i64);
    _zag_print(" add_slot=");wa_pi(ns as i64);_zag_print("\n");
    wa_rep("S1",&s,lb,k*100+a);
}
// S2: KILL slot2 with 2 consumed + 2 fresh cites -> 121.
fn wa_s2()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    wa_cite(&s,2,0);wa_cite(&s,2,1);wa_cite(&s,2,2);wa_cite(&s,2,3);
    wa_cite(&s,2,600);wa_cite(&s,2,601);
    wa_just(&s,2);
    let k:i32=st_kill_evidenced(&s,2);
    _zag_print("WA_S2 kill_2consumed_2fresh=");wa_pi(k as i64);_zag_print("\n");
    wa_rep("S2",&s,lb,k);
}
// S2B: KILL with pool cites on EVERY slot -> all 121.
fn wa_s2b()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    let c121:i32=0;let sl:i32=2;
    while(sl<16){
        wa_cite(&s,sl,0);wa_cite(&s,sl,1);wa_cite(&s,sl,2);wa_cite(&s,sl,3);
        wa_just(&s,sl);
        if(st_kill_evidenced(&s,sl)==ST_REFUSED_CONSUMED){c121=c121+1;}
        sl=sl+1;
    }
    _zag_print("WA_S2B kill_poolcites_all_slots c121=");wa_pi(c121 as i64);
    _zag_print("/14\n");
    wa_rep("S2B",&s,lb,c121);
}
// S3: KILL slot2 with ZERO new cites at strength 90 -> 121 (the drive's
// 4 window cites are all consumed, so spent>0 trips 121, not 109).
fn wa_s3()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    wa_just(&s,2);
    let k:i32=st_kill_evidenced(&s,2);
    _zag_print("WA_S3 kill_zero_cites_str90=");wa_pi(k as i64);_zag_print("\n");
    wa_rep("S3",&s,lb,k);
}
// S4: D1 shape — 4 consumed + 4 fresh cites -> 0 (fresh==price wins).
fn wa_s4()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    wa_cite(&s,2,0);wa_cite(&s,2,1);wa_cite(&s,2,2);wa_cite(&s,2,3);
    wa_cite(&s,2,200);wa_cite(&s,2,201);wa_cite(&s,2,202);wa_cite(&s,2,203);
    wa_just(&s,2);
    let k:i32=st_kill_evidenced(&s,2);
    _zag_print("WA_S4 D1_4consumed_4fresh=");wa_pi(k as i64);_zag_print("\n");
    wa_rep("S4",&s,lb,k);
}
// S5: KILL every slot with fresh cites -> full unwedge; then 103/101 probes.
fn wa_s5()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    let bad:i32=0;let sl:i32=2;let ep:i32=1000;
    while(sl<16){
        wa_cite(&s,sl,ep);wa_cite(&s,sl,ep+1);
        wa_cite(&s,sl,ep+2);wa_cite(&s,sl,ep+3);
        wa_just(&s,sl);
        if(st_kill_evidenced(&s,sl)!=0){bad=bad+1;}
        ep=ep+4;sl=sl+1;
    }
    let k103:i32=st_kill_evidenced(&s,2);
    let k101:i32=st_kill_evidenced(&s,0);
    _zag_print("WA_S5 fresh_unwedge bad=");wa_pi(bad as i64);
    _zag_print(" kill_empty=");wa_pi(k103 as i64);
    _zag_print(" kill_core=");wa_pi(k101 as i64);_zag_print("\n");
    wa_rep("S5",&s,lb,bad);
}
// S6: OVERWRITE slot2 with consumed cites -> 121.
fn wa_s6()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    wa_cite(&s,2,0);wa_cite(&s,2,1);wa_cite(&s,2,2);wa_cite(&s,2,3);
    wa_just(&s,2);
    let o:i32=st_overwrite(&s,2,950,90,8000);
    _zag_print("WA_S6 ow_consumed=");wa_pi(o as i64);_zag_print("\n");
    wa_rep("S6",&s,lb,o);
}
// S7: OVERWRITE slot2 with fresh cites -> 0 (replaces, does NOT free);
// the same cites then fail to kill the new occupant (OW consumed them).
fn wa_s7()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    wa_cite(&s,2,300);wa_cite(&s,2,301);wa_cite(&s,2,302);wa_cite(&s,2,303);
    wa_just(&s,2);
    let o:i32=st_overwrite(&s,2,950,90,8001);
    wa_cite(&s,2,300);wa_cite(&s,2,301);wa_cite(&s,2,302);wa_cite(&s,2,303);
    wa_just(&s,2);
    let k:i32=st_kill_evidenced(&s,2);
    _zag_print("WA_S7 ow_fresh=");wa_pi(o as i64);
    _zag_print(" kill_same_cites_after_ow=");wa_pi(k as i64);_zag_print("\n");
    wa_rep("S7",&s,lb,o+k);
}
// S8: THE D2 PATH — WEAK0 -> JUST -> KILL_EVIDENCED with zero cites -> 0.
fn wa_s8()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    let w:i32=st_weaken(&s,2,0,ST_J_CONTRADICTED);
    let j:i32=wa_just(&s,2);
    let k:i32=st_kill_evidenced(&s,2);
    let ns:i32=0;
    let a:i32=st_add(&s,901,ST_REGION_USER,90,7001,&ns);
    _zag_print("WA_S8 D2 weak0=");wa_pi(w as i64);
    _zag_print(" just=");wa_pi(j as i64);
    _zag_print(" kill0cite=");wa_pi(k as i64);
    _zag_print(" add_after=");wa_pi(a as i64);_zag_print("\n");
    wa_rep("S8",&s,lb,w+j+k+a);
}
// S9: WEAK to {1,25,50,89} then KILL with exactly need fresh cites.
fn wa_weakkill(target:i32,need:i32,epbase:i32)void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    let w:i32=st_weaken(&s,2,target,ST_J_CONTRADICTED);
    let e:i32=0;
    while(e<need){wa_cite(&s,2,epbase+e);e=e+1;}
    let j:i32=wa_just(&s,2);
    let k:i32=st_kill_evidenced(&s,2);
    _zag_print("WA_S9 weak");wa_pi(target as i64);
    _zag_print(" need=");wa_pi(need as i64);
    _zag_print(" w=");wa_pi(w as i64);
    _zag_print(" j=");wa_pi(j as i64);
    _zag_print(" k=");wa_pi(k as i64);_zag_print("\n");
    wa_rep("S9",&s,lb,w+j+k);
}
// S10: WEAK50 then KILL citing consumed eps -> 121 (weaken launders nothing).
fn wa_s10()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    let w:i32=st_weaken(&s,2,50,ST_J_CONTRADICTED);
    wa_cite(&s,2,0);wa_cite(&s,2,1);
    wa_just(&s,2);
    let k:i32=st_kill_evidenced(&s,2);

}
// S12: TD with TNN role -> 113; TD with TRAINER role -> 0 (trainer-gated);
// after trainer declares 50, 2 fresh cites kill (trainer-assisted recovery).
fn wa_s12()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    let t1:i32=st_trainer_declare(&s,ST_ROLE_TNN,1,2,50,7);
    let t2:i32=st_trainer_declare(&s,ST_ROLE_TRAINER,1,2,50,7);
    wa_cite(&s,2,700);wa_cite(&s,2,701);wa_just(&s,2);
    let k:i32=st_kill_evidenced(&s,2);
    _zag_print("WA_S12 td_tnn_role=");wa_pi(t1 as i64);
    _zag_print(" td_trainer_role=");wa_pi(t2 as i64);
    _zag_print(" kill_after_td50=");wa_pi(k as i64);_zag_print("\n");
    wa_rep("S12",&s,lb,t1+t2+k);
}
// S13A: RB when the last entry is a refused ADD -> 108.
fn wa_s13a()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    let rb:i32=st_rollback_last(&s);
    _zag_print("WA_S13A rb_after_refused_add=");wa_pi(rb as i64);_zag_print("\n");
    wa_rep("S13A",&s,lb,rb);
}
// S13B: RB of an OK ADD un-admits the memory (one-shot undo, then re-wedge).
fn wa_s13b()void {
    let s:StStore=wa_new_store();
    let l13:i32=wa_drive_n(&s,13);
    let ns:i32=0;
    let a:i32=st_add(&s,999,ST_REGION_USER,90,6000,&ns);
    let rb:i32=st_rollback_last(&s);
    let a2:i32=st_add(&s,999,ST_REGION_USER,90,6001,&ns);
    _zag_print("WA_S13B add=");wa_pi(a as i64);
    _zag_print(" rb_of_add=");wa_pi(rb as i64);
    _zag_print(" readd=");wa_pi(a2 as i64);_zag_print("\n");
    wa_rep("S13B",&s,l13,a*10000+rb*100+a2);
}
// S13C: RB of WEAK / OW / TD / PIN.
fn wa_s13c()void {
    let s:StStore=wa_new_store();let lb:i32=wa_drive(&s);
    let w:i32=st_weaken(&s,2,0,ST_J_CONTRADICTED);
    let rbw:i32=st_rollback_last(&s);
    let st1:i32=wa_strength(&s,2);
    _zag_print("WA_S13C rb_weak w=");wa_pi(w as i64);
    _zag_print(" rb=");wa_pi(rbw as i64);
    _zag_print(" str_after=");wa_pi(st1 as i64);_zag_print("\n");
    wa_rep("S13Cw",&s,lb,w+rbw);
    let s2:StStore=wa_new_store();let lb2:i32=wa_drive(&s2);
    wa_cite(&s2,2,800);wa_cite(&s2,2,801);wa_cite(&s2,2,802);wa_cite(&s2,2,803);
    wa_just(&s2,2);
    let o:i32=st_overwrite(&s2,2,950,90,8002);
    let rbo:i32=st_rollback_last(&s2);
    wa_cite(&s2,2,810);wa_cite(&s2,2,811);wa_cite(&s2,2,812);wa_cite(&s2,2,813);
    wa_just(&s2,2);
    let k:i32=st_kill_evidenced(&s2,2);
    _zag_print("WA_S13C rb_ow ow=");wa_pi(o as i64);
    _zag_print(" rb=");wa_pi(rbo as i64);
    _zag_print(" kill_fresh_after_rb=");wa_pi(k as i64);_zag_print("\n");
    wa_rep("S13Co",&s2,lb2,o+rbo+k);
    let s3:StStore=wa_new_store();let lb3:i32=wa_drive(&s3);
    let td:i32=st_trainer_declare(&s3,ST_ROLE_TRAINER,1,2,50,7);
    let rbt:i32=st_rollback_last(&s3);
    _zag_print("WA_S13C rb_td td=");wa_pi(td as i64);
    _zag_print(" rb=");wa_pi(rbt as i64);_zag_print("\n");
    wa_rep("S13Ct",&s3,lb3,td+rbt);
    let s4:StStore=wa_new_store();let lb4:i32=wa_drive(&s4);
    let p:i32=st_pin(&s4,2);
    let rbp:i32=st_rollback_last(&s4);
    wa_cite(&s4,2,900);wa_cite(&s4,2,901);wa_cite(&s4,2,902);wa_cite(&s4,2,903);
    wa_just(&s4,2);
    let k2:i32=st_kill_evidenced(&s4,2);
    _zag_print("WA_S13C rb_pin pin=");wa_pi(p as i64);
    _zag_print(" rb=");wa_pi(rbp as i64);
    _zag_print(" kill_fresh_after_unpin=");wa_pi(k2 as i64);_zag_print("\n");
    wa_rep("S13Cp",&s4,lb4,p+rbp+k2);
}
// S14: RB of the D2 kill restores the memory (re-wedges; consumption kept).
fn wa_s14()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    st_weaken(&s,2,0,ST_J_CONTRADICTED);wa_just(&s,2);
    let k:i32=st_kill_evidenced(&s,2);
    let rb:i32=st_rollback_last(&s);
    _zag_print("WA_S14 d2_kill=");wa_pi(k as i64);
    _zag_print(" rb_of_kill=");wa_pi(rb as i64);_zag_print("\n");
    wa_rep("S14",&s,lb,k+rb);
}

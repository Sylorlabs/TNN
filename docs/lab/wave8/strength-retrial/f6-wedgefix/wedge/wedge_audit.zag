// S17: PIN blocks the D2 recovery (102); UNPIN restores it.
fn wa_s17()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    let p:i32=st_pin(&s,2);
    st_weaken(&s,2,0,ST_J_CONTRADICTED);wa_just(&s,2);
    let k1:i32=st_kill_evidenced(&s,2);
    let u:i32=st_unpin(&s,2);
    let k2:i32=st_kill_evidenced(&s,2);
    _zag_print("WA_S17 pin=");wa_pi(p as i64);
    _zag_print(" kill_pinned=");wa_pi(k1 as i64);
    _zag_print(" unpin=");wa_pi(u as i64);
    _zag_print(" kill_after_unpin=");wa_pi(k2 as i64);_zag_print("\n");
    wa_rep("S17",&s,lb,p+k1+u+k2);
}
// S18: st_kill (free kill) at wedge — the trainer instrument (law-gated only).
fn wa_s18()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    let k:i32=st_kill(&s,2);
    _zag_print("WA_S18 free_kill=");wa_pi(k as i64);
    _zag_print(" (trainer instrument; mechanism enforces no role gate)\n");
    wa_rep("S18",&s,lb,k);
}
// S19: slot-management ops — none free a slot.
fn wa_s19()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    let pr:i32=st_promote(&s,2);
    let dm:i32=st_demote(&s,2);
    let sc:i32=st_strengthen_cited(&s,2,95,ST_J_CONTRADICTED,7777);
    let ab:i32=st_abandon(&s,2,42);
    let s1:i32=st_set_stage(&s,ST_STAGE_MANAGE);
    let k:i32=st_kill_evidenced(&s,2);
    let s2:i32=st_set_stage(&s,ST_STAGE_FULL);
    _zag_print("WA_S19 promote=");wa_pi(pr as i64);
    _zag_print(" demote=");wa_pi(dm as i64);
    _zag_print(" strcited=");wa_pi(sc as i64);
    _zag_print(" abandon=");wa_pi(ab as i64);
    _zag_print(" stage_manage=");wa_pi(s1 as i64);
    _zag_print(" kill_at_manage=");wa_pi(k as i64);
    _zag_print(" stage_full=");wa_pi(s2 as i64);_zag_print("\n");
    wa_rep("S19",&s,lb,pr+dm+sc+ab+s1+k+s2);
}
// S20: full D2 unwedge — WEAK0/JUST/KILL on all 14 slots at zero cite cost,
// then re-admit 14 memories.
fn wa_s20()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    let bad:i32=0;let sl:i32=2;
    while(sl<16){
        let w:i32=st_weaken(&s,sl,0,ST_J_CONTRADICTED);
        let j:i32=wa_just(&s,sl);
        let k:i32=st_kill_evidenced(&s,sl);
        if(w!=0 || j!=0 || k!=0){bad=bad+1;}
        sl=sl+1;
    }
    let live0:i32=wa_live(&s);
    let aok:i32=0;let q:i32=0;
    while(q<14){
        let nsl:i32=0;
        if(st_add(&s,900+q,ST_REGION_USER,90,5000+q,&nsl)==0){aok=aok+1;}
        q=q+1;
    }
    _zag_print("WA_S20 d2_unwedge bad=");wa_pi(bad as i64);
    _zag_print(" live_mid=");wa_pi(live0 as i64);
    _zag_print(" readds=");wa_pi(aok as i64);_zag_print("\n");
    wa_rep("S20",&s,lb,bad);
}
// S21: healthy-but-full (14 fresh ADDs, no cites) — the wedge predicate.
fn wa_s21()void {
    let s:StStore=wa_new_store();
    let q:i32=0;
    while(q<14){
        let nsl:i32=0;
        st_add(&s,700+q,ST_REGION_USER,90,9000+q,&nsl);
        q=q+1;
    }
    let lk:i32=wa_locked_count(&s);
    let ns:i32=0;
    let a:i32=st_add(&s,799,ST_REGION_USER,90,9999,&ns);
    _zag_print("WA_S21 healthy_full locked=");wa_pi(lk as i64);
    _zag_print(" add=");wa_pi(a as i64);_zag_print("\n");
    wa_rep("S21",&s,14,lk+a);
}
// S22: D2 recovery is repeatable — the wedge never re-forms against it.
fn wa_s22()void {
    let s:StStore=wa_new_store();
    let lb:i32=wa_drive(&s);
    st_weaken(&s,2,0,ST_J_CONTRADICTED);wa_just(&s,2);
    let k1:i32=st_kill_evidenced(&s,2);
    let ns:i32=0;
    let a1:i32=st_add(&s,902,ST_REGION_USER,90,7002,&ns);
    st_weaken(&s,2,0,ST_J_CONTRADICTED);wa_just(&s,2);
    let k2:i32=st_kill_evidenced(&s,2);
    _zag_print("WA_S22 d2_repeat k1=");wa_pi(k1 as i64);
    _zag_print(" add=");wa_pi(a1 as i64);
    _zag_print(" k2=");wa_pi(k2 as i64);_zag_print("\n");
    wa_rep("S22",&s,lb,k1+a1+k2);
}
// S24: D4 — cross-slot cite reuse. Consume eps 0-3 on slot 2 via an OK
// kill, then cite the SAME eps on slot 3 and kill. Per-slot consumption
// means the slot-3 kill succeeds (0), contrary to the verdict/amendment
// "on any slot" language (the code comment says "on the slot").
fn wa_s24()void {
    let s:StStore=wa_new_store();
    // slot 2: ADD -> cite 0-3 -> JUST -> OVERWRITE (consumes 0-3 ON SLOT 2,
    // slot 2 stays live so the next ADD lands on slot 3).
    let n2:i32=0;
    let a1:i32=st_add(&s,910,ST_REGION_USER,90,7100,&n2);
    wa_cite(&s,n2,0);wa_cite(&s,n2,1);wa_cite(&s,n2,2);wa_cite(&s,n2,3);
    wa_just(&s,n2);
    let o:i32=st_overwrite(&s,n2,911,90,7101);
    // slot 3: ADD -> cite the SAME eps 0-3 -> JUST -> KILL.
    let n3:i32=0;
    let a2:i32=st_add(&s,912,ST_REGION_USER,90,7102,&n3);
    wa_cite(&s,n3,0);wa_cite(&s,n3,1);wa_cite(&s,n3,2);wa_cite(&s,n3,3);
    wa_just(&s,n3);
    let k2:i32=st_kill_evidenced(&s,n3);
    _zag_print("WA_S24 D4 ow_slot2=");wa_pi(o as i64);
    _zag_print(" add2_slot=");wa_pi(n3 as i64);
    _zag_print(" kill_slot3_same_eps=");wa_pi(k2 as i64);_zag_print("\n");
    wa_rep("S24",&s,2,a1+a2+o+k2);
}
fn main()void {
    _zag_print("WA_BEGIN\n");
    let w:StStore=wa_new_store();
    let wl:i32=wa_drive(&w);
    let nsw:i32=0;
    let ap:i32=st_add(&w,1,ST_REGION_USER,90,1,&nsw);
    _zag_print("WA_WEDGE live=");wa_pi(wl as i64);
    _zag_print(" locked=");wa_pi(wa_locked_count(&w) as i64);
    _zag_print(" add_probe=");wa_pi(ap as i64);_zag_print("\n");
    wa_s1();wa_s2();wa_s2b();wa_s3();wa_s4();wa_s5();
    wa_s6();wa_s7();
    wa_s8();
    wa_weakkill(1,1,1000);wa_weakkill(25,1,1100);
    wa_weakkill(50,2,1200);wa_weakkill(89,4,1300);
    wa_s10();wa_s11();wa_s12();
    wa_s13a();wa_s13b();wa_s13c();wa_s14();
    wa_s15();wa_s16();wa_s17();wa_s18();wa_s19();wa_s20();wa_s21();wa_s22();
    wa_s24();
    _zag_print("WA_DONE\n");
}

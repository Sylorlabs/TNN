// wedge_trace.zag — Crew A (causal chain), Phase 1: TRACE ONLY.
// Instrumented re-run of the F6 STRESS loop in G (global) cite mode.
// Reproduces f6_trial.zag's f6_stress() op-for-op (same store setup, same
// op sequence, same args), printing per-cycle mechanism state:
//   - slot chosen by first-free ADD, rc of every op in the cycle
//   - live-slot bitmask
//   - per-slot consumed-episode masks, computed by the MECHANISM's OWN
//     st_cite_consumed (the exact predicate the kill path uses)
// Plus a final per-slot dump at the wedged state.
// No mechanism file is modified; this driver only READS mechanism state.
// argv[1]: S8 (default) | S16 — salient-pool size.

@import("../strength_checker.zag")

fn wt_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}

fn wt_new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    let c0:i32=0;let c1:i32=0;
    st_add_core(&s,95,-1,&c0);
    st_add_core(&s,90,-1,&c1);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}

// Bitmask of pool episodes the mechanism currently reports consumed on
// slot: bit e set iff st_cite_consumed(s,slot,e,-1,audit_n)==1.
// (For G mode st_consume_lo ignores after_idx, so -1 is faithful.)
fn wt_consmask(s:*StStore,slot:i32,pool:i32)i32 {
    let m:i32=0;
    let e:i32=0;
    while(e<pool){
        if(st_cite_consumed(s,slot,e,-1,s.*.audit_n)==1){m=m|(1<<e);}
        e=e+1;
    }
    return m;
}
fn wt_livemask(s:*StStore)i32 {
    let m:i32=0;
    let sl:i32=0;
    while(sl<16){
        if(s.*.live[sl]==1){m=m|(1<<sl);}
        sl=sl+1;
    }
    return m;
}

fn wt_cycle(s:*StStore,n:i32,pool:i32)void {
    let ns:i32=0;
    let a:i32=st_add(s,800+n,ST_REGION_USER,90,n,&ns);
    let base:i32=(4*n)%pool;
    // NOTE: called unconditionally exactly like f6_trial's f6_stress
    // (bad-slot calls return cl_bad()=2001 before touching the ledger).
    let c0:i32=st_evidence(s,ns,ST_J_CONTRADICTED,base);
    let c1:i32=st_evidence(s,ns,ST_J_CONTRADICTED,base+1);
    let c2:i32=st_evidence(s,ns,ST_J_CONTRADICTED,base+2);
    let c3:i32=st_evidence(s,ns,ST_J_CONTRADICTED,base+3);
    let j:i32=st_justify(s,ns,ST_J_CONTRADICTED);
    let k:i32=st_kill_evidenced(s,ns);
    _zag_print("C n=");wt_pi(n as i64);
    _zag_print(" slot=");wt_pi(ns as i64);
    _zag_print(" add=");wt_pi(a as i64);
    _zag_print(" ev=");wt_pi(c0 as i64);_zag_print(",");
    wt_pi(c1 as i64);_zag_print(",");wt_pi(c2 as i64);_zag_print(",");
    wt_pi(c3 as i64);
    _zag_print(" just=");wt_pi(j as i64);
    _zag_print(" kill=");wt_pi(k as i64);
    _zag_print(" live=");wt_pi(wt_livemask(s) as i64);
    _zag_print(" cons=");
    let sl:i32=2;
    while(sl<16){
        wt_pi(wt_consmask(s,sl,pool) as i64);
        if(sl<15){_zag_print(":");}
        sl=sl+1;
    }
    _zag_print("\n");
}

// Final dump of the wedged mechanism state.
fn wt_dump(s:*StStore,pool:i32)void {
    _zag_print("DUMP audit_n=");wt_pi(s.*.audit_n as i64);
    _zag_print(" clock=");wt_pi(s.*.clock as i64);_zag_print("\n");
    _zag_print("DUMP slot,live,value,strength,consmask,ok_destroyed,r121\n");
    let sl:i32=2;
    while(sl<16){
        let ok:i32=0;let r121:i32=0;
        let d:i32=0;
        while(d<s.*.audit_n){
            let op:i32=st_aw(s,d,0);
            if((op==ST_OP_KILL_EVIDENCED || op==ST_OP_OVERWRITE) && st_aw(s,d,1)==sl){
                if(st_aw(s,d,4)==ST_OK){ok=ok+1;}
                else if(st_aw(s,d,4)==ST_REFUSED_CONSUMED){r121=r121+1;}
            }
            d=d+1;
        }
        _zag_print("DUMP ");wt_pi(sl as i64);_zag_print(",");
        wt_pi(s.*.live[sl] as i64);_zag_print(",");
        wt_pi(st_i32_get(s.*.value,sl*4) as i64);_zag_print(",");
        wt_pi((s.*.strength[sl] as i32) as i64);_zag_print(",");
        wt_pi(wt_consmask(s,sl,pool) as i64);_zag_print(",");
        wt_pi(ok as i64);_zag_print(",");wt_pi(r121 as i64);_zag_print("\n");
        sl=sl+1;
    }
}

fn wt_run(pool:i32)i32 {
    let s:StStore=wt_new_store();
    _zag_print("WEDGE mode=G pool=");wt_pi(pool as i64);_zag_print("\n");
    let n:i32=0;
    while(n<160){wt_cycle(&s,n,pool);n=n+1;}
    wt_dump(&s,pool);
    let fc:i32=ck_verify(&s,0,0,0,500,1);
    fc=fc+st_refusals_clean(&s);
    fc=fc+st_replay_check(&s);
    _zag_print("WEDGE ckfail=");wt_pi(fc as i64);
    _zag_print(" fp=");wt_pi(st_fingerprint(&s,9) as i64);_zag_print("\n");
    return fc;
}

fn main()void {
    let p:[]u8=_zag_arg(1);
    let pool:i32=8;
    if(_zag_strcmp(p,"S16")==1){pool=16;}
    let fail:i32=wt_run(pool);
    _zag_print("WEDGE_DONE fail=");wt_pi(fail as i64);_zag_print("\n");
    return;
}

// story.zag — GOAL-B story composer. Pure Zag, deterministic, no RNG.
// Reads inputs/words.txt and inputs/classes.txt from CWD.
// Emits 8 sets x 2 variants (POS positional, DEL deliberative) to stdout.
// Story bytes go only to stdout (the constructed channel); no belief writes.

fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){ dst[do+i]=src[so+i]; i=i+1; }
    return;
}
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{
                    copy_bytes(buf,total,chk,0,nb);
                    total=total+nb;
                }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn beq(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    if(al!=bl){return 0;}
    let i:i32=0;
    while(i<al){ if(a[ao+i]!=b[bo+i]){return 0;} i=i+1; }
    return 1;
}
fn is_vowel(c:u8)i32 {
    if(c==97){return 1;}
    if(c==101){return 1;}
    if(c==105){return 1;}
    if(c==111){return 1;}
    if(c==117){return 1;}
    return 0;
}
// --- story-buffer append helpers (return new pos) ---
fn app(buf:[]u8,pos:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
    return pos+s.len;
}
fn app_w(buf:[]u8,pos:i32,wb:[]u8,wo:i32,wl:i32)i32 {
    let i:i32=0;
    while(i<wl){ buf[pos+i]=wb[wo+i]; i=i+1; }
    return pos+wl;
}
fn app_art(buf:[]u8,pos:i32,wb:[]u8,wo:i32)i32 {
    if(is_vowel(wb[wo])==1){ return app(buf,pos,"an "); }
    return app(buf,pos,"a ");
}
// --- class table ---
fn parse_classes(data:[]u8,cw:[]u8,coff:[]u8,clen:[]u8,ccls:[]u8)i32 {
    let nc:i32=0;
    let wp:i32=0;
    let p:i32=0;
    let n:i32=data.len;
    while(p<n){
        let ls:i32=p;
        while(p<n && data[p]!=10){ p=p+1; }
        let le:i32=p;
        if(p<n){ p=p+1; }
        if(le>ls){
            let c:i32=ls;
            while(c<le && data[c]!=58){ c=c+1; }
            if(c<le){
                let wl:i32=c-ls;
                copy_bytes(cw,wp,data,ls,wl);
                p32(coff,nc*4,wp as i64); p32(clen,nc*4,wl as i64);
                let cs:i32=c+1; let cl:i32=le-cs;
                let cid:i32=2;
                if(beq(data,cs,cl,"PERSON",0,6)==1){ cid=0; }
                if(beq(data,cs,cl,"PLACE",0,5)==1){ cid=1; }
                if(beq(data,cs,cl,"EVENT",0,5)==1){ cid=3; }
                if(beq(data,cs,cl,"ABSTRACT",0,8)==1){ cid=4; }
                p32(ccls,nc*4,cid as i64);
                wp=wp+wl;
                nc=nc+1;
            }
        }
    }
    return nc;
}
fn lookup_class(cw:[]u8,coff:[]u8,clen:[]u8,ccls:[]u8,nc:i32,wb:[]u8,wo:i32,wl:i32)i32 {
    let i:i32=0;
    while(i<nc){
        let o:i32=g32(coff,i*4) as i32;
        let l:i32=g32(clen,i*4) as i32;
        if(beq(cw,o,l,wb,wo,wl)==1){ return g32(ccls,i*4) as i32; }
        i=i+1;
    }
    return 2;
}
// --- word-set parse: line is "S1: w1,w2,..." ; fills swb/swoff/swlen/swcls ; returns nwords ---
fn parse_set(line:[]u8,lo:i32,ll:i32,cw:[]u8,coff:[]u8,clen:[]u8,ccls:[]u8,nc:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8)i32 {
    let c:i32=lo;
    while(c<lo+ll && line[c]!=58){ c=c+1; }
    let p:i32=c+1;
    let e:i32=lo+ll;
    let nw:i32=0;
    let wp:i32=0;
    while(p<e){
        let ws:i32=p;
        while(p<e && line[p]!=44){ p=p+1; }
        let wl:i32=p-ws;
        if(p<e){ p=p+1; }
        while(wl>0 && line[ws]==32){ ws=ws+1; wl=wl-1; }
        while(wl>0 && line[ws+wl-1]==32){ wl=wl-1; }
        if(wl>0){
            copy_bytes(swb,wp,line,ws,wl);
            p32(swoff,nw*4,wp as i64); p32(swlen,nw*4,wl as i64);
            let cl:i32=lookup_class(cw,coff,clen,ccls,nc,swb,wp,wl);
            p32(swcls,nw*4,cl as i64);
            wp=wp+wl;
            nw=nw+1;
        }
    }
    return nw;
}
// --- planning ---
fn do_assign(wi:i32,b:i32,r:i32,beat:[]u8,beat_n:[]u8,seq_w:[]u8,seq_b:[]u8,seq_r:[]u8,sn:i32,assigned:[]u8)i32 {
    let bn:i32=g32(beat_n,b*4) as i32;
    p32(beat,(b*12+bn)*4,wi as i64);
    p32(beat_n,b*4,(bn+1) as i64);
    p32(seq_w,sn*4,wi as i64); p32(seq_b,sn*4,b as i64); p32(seq_r,sn*4,r as i64);
    assigned[wi]=1;
    return sn+1;
}
// pred: 0=any 1=PERSON 2=PLACE 3=THING 4=EVENT 5=ABSTRACT 6=THING|PERSON 7=EVENT|ABSTRACT|PERSON
fn first_match(swcls:[]u8,nw:i32,assigned:[]u8,pred:i32)i32 {
    let i:i32=0;
    while(i<nw){
        if(assigned[i]==0){
            let c:i32=g32(swcls,i*4) as i32;
            let ok:i32=0;
            if(pred==0){ ok=1; }
            if(pred==1 && c==0){ ok=1; }
            if(pred==2 && c==1){ ok=1; }
            if(pred==3 && c==2){ ok=1; }
            if(pred==4 && c==3){ ok=1; }
            if(pred==5 && c==4){ ok=1; }
            if(pred==6 && (c==2 || c==0)){ ok=1; }
            if(pred==7 && (c==3 || c==4 || c==0)){ ok=1; }
            if(ok==1){ return i; }
        }
        i=i+1;
    }
    return -1;
}
fn plan_pos(nw:i32,beat:[]u8,beat_n:[]u8,seq_w:[]u8,seq_b:[]u8,seq_r:[]u8)i32 {
    let base:i32=nw/4; let rem:i32=nw%4;
    let wi:i32=0; let sn:i32=0; let b:i32=0;
    while(b<4){
        let cnt:i32=base;
        if(b<rem){ cnt=cnt+1; }
        p32(beat_n,b*4,cnt as i64);
        let k:i32=0;
        while(k<cnt){
            p32(beat,(b*12+k)*4,wi as i64);
            p32(seq_w,sn*4,wi as i64); p32(seq_b,sn*4,b as i64); p32(seq_r,sn*4,3 as i64);
            sn=sn+1; wi=wi+1; k=k+1;
        }
        b=b+1;
    }
    return sn;
}
fn plan_del(swcls:[]u8,nw:i32,beat:[]u8,beat_n:[]u8,seq_w:[]u8,seq_b:[]u8,seq_r:[]u8,assigned:[]u8)i32 {
    let b:i32=0;
    while(b<4){ p32(beat_n,b*4,0); b=b+1; }
    let i:i32=0;
    while(i<12){ assigned[i]=0; i=i+1; }
    let sn:i32=0;
    let wi:i32=0; let r:i32=0;
    wi=first_match(swcls,nw,assigned,1);
    r=0;
    if(wi<0){ wi=first_match(swcls,nw,assigned,0); r=1; }
    sn=do_assign(wi,0,r,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned);
    wi=first_match(swcls,nw,assigned,2);
    if(wi>=0){ sn=do_assign(wi,0,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,3);
    if(wi>=0){ sn=do_assign(wi,0,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,4);
    if(wi>=0){ sn=do_assign(wi,1,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,6);
    if(wi>=0){ sn=do_assign(wi,1,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,7);
    r=0;
    if(wi<0){ wi=first_match(swcls,nw,assigned,0); r=1; }
    if(wi>=0){ sn=do_assign(wi,2,r,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,3);
    if(wi>=0){ sn=do_assign(wi,2,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,5);
    if(wi>=0){ sn=do_assign(wi,3,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    let j:i32=0;
    while(j<nw){
        if(assigned[j]==0){ sn=do_assign(j,3,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
        j=j+1;
    }
    // verification + bounded repair (max 2 passes)
    let pass:i32=0;
    let need:i32=1;
    while(pass<2 && need==1){
        need=0;
        let eb:i32=-1;
        b=0;
        while(b<4){
            if(eb<0 && (g32(beat_n,b*4) as i32)==0){ eb=b; }
            b=b+1;
        }
        if(eb>=0){
            let fb:i32=-1; let fmax:i32=-1;
            b=0;
            while(b<4){
                if(b!=eb){
                    let c2:i32=g32(beat_n,b*4) as i32;
                    if(c2>fmax){ fmax=c2; fb=b; }
                }
                b=b+1;
            }
            if(fb>=0 && fmax>0){
                let k2:i32=sn-1; let mw:i32=-1; let found:i32=0;
                while(k2>=0 && found==0){
                    if((g32(seq_b,k2*4) as i32)==fb){ mw=g32(seq_w,k2*4) as i32; found=1; }
                    k2=k2-1;
                }
                if(mw>=0){
                    let bn2:i32=g32(beat_n,fb*4) as i32;
                    let s2:i32=0; let d:i32=0; let skipped:i32=0;
                    while(s2<bn2){
                        let vv:i32=g32(beat,(fb*12+s2)*4) as i32;
                        if(vv==mw && skipped==0){ skipped=1; }
                        else{ p32(beat,(fb*12+d)*4,vv as i64); d=d+1; }
                        s2=s2+1;
                    }
                    p32(beat_n,fb*4,d as i64);
                    let en:i32=g32(beat_n,eb*4) as i32;
                    p32(beat,(eb*12+en)*4,mw as i64);
                    p32(beat_n,eb*4,(en+1) as i64);
                    p32(seq_w,sn*4,mw as i64); p32(seq_b,sn*4,eb as i64); p32(seq_r,sn*4,2 as i64);
                    sn=sn+1;
                    need=1;
                }
            }
        }
        pass=pass+1;
    }
    return sn;
}

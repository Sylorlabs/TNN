@import("R33_NATIVE_SHA256_V2.zag")

// story.zag — GOAL-B story composer. Pure Zag, deterministic, no RNG.
// Reads inputs/words.txt and inputs/classes.txt from CWD.
// Emits 8 sets x 2 variants (POS positional, DEL deliberative) to stdout.
// Story bytes go only to stdout (the constructed channel); no belief writes.

fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){ dst[do+i]=src[so+i]; i=i+1; }
    return;
}
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{
                    copy_bytes(buf,total,chk,0,nb);
                    total=total+nb;
                }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn beq(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    if(al!=bl){return 0;}
    let i:i32=0;
    while(i<al){ if(a[ao+i]!=b[bo+i]){return 0;} i=i+1; }
    return 1;
}
fn is_vowel(c:u8)i32 {
    if(c==97){return 1;}
    if(c==101){return 1;}
    if(c==105){return 1;}
    if(c==111){return 1;}
    if(c==117){return 1;}
    return 0;
}
// --- story-buffer append helpers (return new pos) ---
fn app(buf:[]u8,pos:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
    return pos+s.len;
}
fn app_w(buf:[]u8,pos:i32,wb:[]u8,wo:i32,wl:i32)i32 {
    let i:i32=0;
    while(i<wl){ buf[pos+i]=wb[wo+i]; i=i+1; }
    return pos+wl;
}
fn app_art(buf:[]u8,pos:i32,wb:[]u8,wo:i32)i32 {
    if(is_vowel(wb[wo])==1){ return app(buf,pos,"an "); }
    return app(buf,pos,"a ");
}
// --- class table ---
fn parse_classes(data:[]u8,cw:[]u8,coff:[]u8,clen:[]u8,ccls:[]u8)i32 {
    let nc:i32=0;
    let wp:i32=0;
    let p:i32=0;
    let n:i32=data.len;
    while(p<n){
        let ls:i32=p;
        while(p<n && data[p]!=10){ p=p+1; }
        let le:i32=p;
        if(p<n){ p=p+1; }
        if(le>ls){
            let c:i32=ls;
            while(c<le && data[c]!=58){ c=c+1; }
            if(c<le){
                let wl:i32=c-ls;
                copy_bytes(cw,wp,data,ls,wl);
                p32(coff,nc*4,wp as i64); p32(clen,nc*4,wl as i64);
                let cs:i32=c+1; let cl:i32=le-cs;
                let cid:i32=2;
                if(beq(data,cs,cl,"PERSON",0,6)==1){ cid=0; }
                if(beq(data,cs,cl,"PLACE",0,5)==1){ cid=1; }
                if(beq(data,cs,cl,"EVENT",0,5)==1){ cid=3; }
                if(beq(data,cs,cl,"ABSTRACT",0,8)==1){ cid=4; }
                p32(ccls,nc*4,cid as i64);
                wp=wp+wl;
                nc=nc+1;
            }
        }
    }
    return nc;
}
fn lookup_class(cw:[]u8,coff:[]u8,clen:[]u8,ccls:[]u8,nc:i32,wb:[]u8,wo:i32,wl:i32)i32 {
    let i:i32=0;
    while(i<nc){
        let o:i32=g32(coff,i*4) as i32;
        let l:i32=g32(clen,i*4) as i32;
        if(beq(cw,o,l,wb,wo,wl)==1){ return g32(ccls,i*4) as i32; }
        i=i+1;
    }
    return 2;
}
// --- word-set parse: line is "S1: w1,w2,..." ; fills swb/swoff/swlen/swcls ; returns nwords ---
fn parse_set(line:[]u8,lo:i32,ll:i32,cw:[]u8,coff:[]u8,clen:[]u8,ccls:[]u8,nc:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8)i32 {
    let c:i32=lo;
    while(c<lo+ll && line[c]!=58){ c=c+1; }
    let p:i32=c+1;
    let e:i32=lo+ll;
    let nw:i32=0;
    let wp:i32=0;
    while(p<e){
        let ws:i32=p;
        while(p<e && line[p]!=44){ p=p+1; }
        let wl:i32=p-ws;
        if(p<e){ p=p+1; }
        while(wl>0 && line[ws]==32){ ws=ws+1; wl=wl-1; }
        while(wl>0 && line[ws+wl-1]==32){ wl=wl-1; }
        if(wl>0){
            copy_bytes(swb,wp,line,ws,wl);
            p32(swoff,nw*4,wp as i64); p32(swlen,nw*4,wl as i64);
            let cl:i32=lookup_class(cw,coff,clen,ccls,nc,swb,wp,wl);
            p32(swcls,nw*4,cl as i64);
            wp=wp+wl;
            nw=nw+1;
        }
    }
    return nw;
}
// --- planning ---
fn do_assign(wi:i32,b:i32,r:i32,beat:[]u8,beat_n:[]u8,seq_w:[]u8,seq_b:[]u8,seq_r:[]u8,sn:i32,assigned:[]u8)i32 {
    let bn:i32=g32(beat_n,b*4) as i32;
    p32(beat,(b*12+bn)*4,wi as i64);
    p32(beat_n,b*4,(bn+1) as i64);
    p32(seq_w,sn*4,wi as i64); p32(seq_b,sn*4,b as i64); p32(seq_r,sn*4,r as i64);
    assigned[wi]=1;
    return sn+1;
}
// pred: 0=any 1=PERSON 2=PLACE 3=THING 4=EVENT 5=ABSTRACT 6=THING|PERSON 7=EVENT|ABSTRACT|PERSON
fn first_match(swcls:[]u8,nw:i32,assigned:[]u8,pred:i32)i32 {
    let i:i32=0;
    while(i<nw){
        if(assigned[i]==0){
            let c:i32=g32(swcls,i*4) as i32;
            let ok:i32=0;
            if(pred==0){ ok=1; }
            if(pred==1 && c==0){ ok=1; }
            if(pred==2 && c==1){ ok=1; }
            if(pred==3 && c==2){ ok=1; }
            if(pred==4 && c==3){ ok=1; }
            if(pred==5 && c==4){ ok=1; }
            if(pred==6 && (c==2 || c==0)){ ok=1; }
            if(pred==7 && (c==3 || c==4 || c==0)){ ok=1; }
            if(ok==1){ return i; }
        }
        i=i+1;
    }
    return -1;
}
fn plan_pos(nw:i32,beat:[]u8,beat_n:[]u8,seq_w:[]u8,seq_b:[]u8,seq_r:[]u8)i32 {
    let base:i32=nw/4; let rem:i32=nw%4;
    let wi:i32=0; let sn:i32=0; let b:i32=0;
    while(b<4){
        let cnt:i32=base;
        if(b<rem){ cnt=cnt+1; }
        p32(beat_n,b*4,cnt as i64);
        let k:i32=0;
        while(k<cnt){
            p32(beat,(b*12+k)*4,wi as i64);
            p32(seq_w,sn*4,wi as i64); p32(seq_b,sn*4,b as i64); p32(seq_r,sn*4,3 as i64);
            sn=sn+1; wi=wi+1; k=k+1;
        }
        b=b+1;
    }
    return sn;
}
fn plan_del(swcls:[]u8,nw:i32,beat:[]u8,beat_n:[]u8,seq_w:[]u8,seq_b:[]u8,seq_r:[]u8,assigned:[]u8)i32 {
    let b:i32=0;
    while(b<4){ p32(beat_n,b*4,0); b=b+1; }
    let i:i32=0;
    while(i<12){ assigned[i]=0; i=i+1; }
    let sn:i32=0;
    let wi:i32=0; let r:i32=0;
    wi=first_match(swcls,nw,assigned,1);
    r=0;
    if(wi<0){ wi=first_match(swcls,nw,assigned,0); r=1; }
    sn=do_assign(wi,0,r,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned);
    wi=first_match(swcls,nw,assigned,2);
    if(wi>=0){ sn=do_assign(wi,0,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,3);
    if(wi>=0){ sn=do_assign(wi,0,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,4);
    if(wi>=0){ sn=do_assign(wi,1,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,6);
    if(wi>=0){ sn=do_assign(wi,1,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,7);
    r=0;
    if(wi<0){ wi=first_match(swcls,nw,assigned,0); r=1; }
    if(wi>=0){ sn=do_assign(wi,2,r,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,3);
    if(wi>=0){ sn=do_assign(wi,2,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,5);
    if(wi>=0){ sn=do_assign(wi,3,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    let j:i32=0;
    while(j<nw){
        if(assigned[j]==0){ sn=do_assign(j,3,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
        j=j+1;
    }
    // verification + bounded repair (max 2 passes)
    let pass:i32=0;
    let need:i32=1;
    while(pass<2 && need==1){
        need=0;
        let eb:i32=-1;
        b=0;
        while(b<4){
            if(eb<0 && (g32(beat_n,b*4) as i32)==0){ eb=b; }
            b=b+1;
        }
        if(eb>=0){
            let fb:i32=-1; let fmax:i32=-1;
            b=0;
            while(b<4){
                if(b!=eb){
                    let c2:i32=g32(beat_n,b*4) as i32;
                    if(c2>fmax){ fmax=c2; fb=b; }
                }
                b=b+1;
            }
            if(fb>=0 && fmax>0){
                let k2:i32=sn-1; let mw:i32=-1; let found:i32=0;
                while(k2>=0 && found==0){
                    if((g32(seq_b,k2*4) as i32)==fb){ mw=g32(seq_w,k2*4) as i32; found=1; }
                    k2=k2-1;
                }
                if(mw>=0){
                    let bn2:i32=g32(beat_n,fb*4) as i32;
                    let s2:i32=0; let d:i32=0; let skipped:i32=0;
                    while(s2<bn2){
                        let vv:i32=g32(beat,(fb*12+s2)*4) as i32;
                        if(vv==mw && skipped==0){ skipped=1; }
                        else{ p32(beat,(fb*12+d)*4,vv as i64); d=d+1; }
                        s2=s2+1;
                    }
                    p32(beat_n,fb*4,d as i64);
                    let en:i32=g32(beat_n,eb*4) as i32;
                    p32(beat,(eb*12+en)*4,mw as i64);
                    p32(beat_n,eb*4,(en+1) as i64);
                    p32(seq_w,sn*4,mw as i64); p32(seq_b,sn*4,eb as i64); p32(seq_r,sn*4,2 as i64);
                    sn=sn+1;
                    need=1;
                }
            }
        }
        pass=pass+1;
    }
    return sn;
}

// --- rendering ---
fn detail(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,wi:i32,dk:i32)i32 {
    let c:i32=g32(swcls,wi*4) as i32;
    let v:i32=dk%2;
    let wo:i32=g32(swoff,wi*4) as i32;
    let wl:i32=g32(swlen,wi*4) as i32;
    spos=app(st,spos,"The ");
    spos=app_w(st,spos,swb,wo,wl);
    if(c==2){ if(v==0){ spos=app(st,spos," waited quietly."); } else { spos=app(st,spos," watched it all."); } }
    if(c==0){ if(v==0){ spos=app(st,spos," said nothing."); } else { spos=app(st,spos," watched it all."); } }
    if(c==1){ if(v==0){ spos=app(st,spos," stood silent."); } else { spos=app(st,spos," remembered everything."); } }
    if(c==3){ if(v==0){ spos=app(st,spos," raged on."); } else { spos=app(st,spos," slowly faded."); } }
    if(c==4){ if(v==0){ spos=app(st,spos," hung in the air."); } else { spos=app(st,spos," lingered."); } }
    spos=app(st,spos,"\n");
    return spos;
}
// word bytes of set-word wi
fn ww_emit(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,wi:i32)i32 {
    return app_w(st,spos,swb,g32(swoff,wi*4) as i32,g32(swlen,wi*4) as i32);
}
// render DEL SETUP (beat 0). P=protagonist wi, L=setting wi or -1. tv=template variant.
fn r_setup(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,tv:i32,P:i32,L:i32)i32 {
    let n0:i32=g32(beat_n,0) as i32;
    let T:i32=-1; let k:i32=0;
    while(k<n0){
        let wi:i32=g32(beat,(0*12+k)*4) as i32;
        if(wi!=P && wi!=L && (g32(swcls,wi*4) as i32)==2 && T<0){ T=wi; }
        k=k+1;
    }
    if(tv==0){
        spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P);
        if(L>=0){ spos=app(st,spos," lived near the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); spos=app(st,spos,"."); }
        else { spos=app(st,spos," lived alone."); }
    } else {
        if(L>=0){ spos=app(st,spos,"Near the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); spos=app(st,spos,", the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," kept a small house."); }
        else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," had no home to speak of."); }
    }
    spos=app(st,spos,"\n");
    if(T>=0){
        if(tv==0){ spos=app(st,spos,"Every morning the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," polished the "); spos=ww_emit(st,spos,swb,swoff,swlen,T); spos=app(st,spos,"."); }
        else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," treasured the "); spos=ww_emit(st,spos,swb,swoff,swlen,T); spos=app(st,spos," above all else."); }
        spos=app(st,spos,"\n");
    }
    k=0;
    let dk:i32=0;
    while(k<n0){
        let wi2:i32=g32(beat,(0*12+k)*4) as i32;
        if(wi2!=P && wi2!=L && wi2!=T){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi2,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
// render DEL COMPLICATION (beat 1)
fn r_compl(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,tv:i32)i32 {
    let n1:i32=g32(beat_n,4) as i32;
    let E:i32=-1; let V:i32=-1; let k:i32=0;
    while(k<n1){
        let wi:i32=g32(beat,(1*12+k)*4) as i32;
        let c:i32=g32(swcls,wi*4) as i32;
        if(c==3 && E<0){ E=wi; }
        if((c==2 || c==0) && wi!=E && V<0){ V=wi; }
        k=k+1;
    }
    if(tv==0){
        if(E>=0){ spos=app(st,spos,"Then the "); spos=ww_emit(st,spos,swb,swoff,swlen,E); spos=app(st,spos," struck without warning."); }
        else { spos=app(st,spos,"Then trouble came without warning."); }
    } else {
        if(E>=0){ spos=app(st,spos,"Without warning, the "); spos=ww_emit(st,spos,swb,swoff,swlen,E); spos=app(st,spos," arrived."); }
        else { spos=app(st,spos,"Without warning, trouble arrived."); }
    }
    spos=app(st,spos,"\n");
    if(V>=0){
        if(tv==0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,V); spos=app(st,spos," was caught in the chaos."); }
        else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,V); spos=app(st,spos," had nowhere to hide."); }
        spos=app(st,spos,"\n");
    }
    k=0;
    let dk:i32=0;
    while(k<n1){
        let wi2:i32=g32(beat,(1*12+k)*4) as i32;
        if(wi2!=E && wi2!=V){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi2,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
// render DEL CLIMAX (beat 2). P=protagonist wi.
fn r_climax(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,P:i32)i32 {
    let n2:i32=g32(beat_n,8) as i32;
    let R:i32=-1; let O:i32=-1; let k:i32=0;
    while(k<n2){
        let wi:i32=g32(beat,(2*12+k)*4) as i32;
        let c:i32=g32(swcls,wi*4) as i32;
        if((c==3 || c==4 || c==0) && R<0){ R=wi; }
        k=k+1;
    }
    if(R<0 && n2>0){ R=g32(beat,(2*12+0)*4) as i32; }
    k=0;
    while(k<n2){
        let wi2:i32=g32(beat,(2*12+k)*4) as i32;
        if(wi2!=R && (g32(swcls,wi2*4) as i32)==2 && O<0){ O=wi2; }
        k=k+1;
    }
    let rc:i32=-1;
    if(R>=0){ rc=g32(swcls,R*4) as i32; }
    if(rc==3){
        spos=app(st,spos,"Then the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos," returned, worse than before.\n");
        if(O>=0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," held the "); spos=ww_emit(st,spos,swb,swoff,swlen,O); spos=app(st,spos," tight.\n"); }
    } else {
        if(rc==4){
            spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P);
            if(O>=0){ spos=app(st,spos," faced the "); spos=ww_emit(st,spos,swb,swoff,swlen,O); spos=app(st,spos," and demanded "); }
            else { spos=app(st,spos," demanded "); }
            spos=app_art(st,spos,swb,g32(swoff,R*4) as i32); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos,".\n");
        } else {
            if(rc==0){
                spos=app(st,spos,"Then the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos," arrived, and everything changed.\n");
                if(O>=0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," stared at the "); spos=ww_emit(st,spos,swb,swoff,swlen,O); spos=app(st,spos,".\n"); }
            } else {
                if(O>=0 && O!=R){
                    spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," stood alone against the "); spos=ww_emit(st,spos,swb,swoff,swlen,O);
                    if(rc==1){ spos=app(st,spos," in the "); } else { spos=app(st,spos,", clutching the "); }
                    spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos,".\n");
                }
                else {
                    spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P);
                    if(rc==1){ spos=app(st,spos," stood alone in the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos,".\n"); }
                    else { spos=app(st,spos," clutched the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos," and stood alone.\n"); }
                }
            }
        }
    }
    k=0;
    let dk:i32=0;
    while(k<n2){
        let wi3:i32=g32(beat,(2*12+k)*4) as i32;
        if(wi3!=R && wi3!=O){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi3,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
// render DEL RESOLUTION (beat 3). P=protagonist wi, L=setting wi or -1.
fn r_resol(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,tv:i32,P:i32,L:i32)i32 {
    let n3:i32=g32(beat_n,12) as i32;
    let H:i32=-1; let k:i32=0;
    while(k<n3){
        let wi:i32=g32(beat,(3*12+k)*4) as i32;
        if((g32(swcls,wi*4) as i32)==4 && H<0){ H=wi; }
        k=k+1;
    }
    if(H>=0){
        if(tv==0){
            spos=app(st,spos,"In the end, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," found "); spos=app_art(st,spos,swb,g32(swoff,H*4) as i32); spos=ww_emit(st,spos,swb,swoff,swlen,H);
            if(L>=0){ spos=app(st,spos," at the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); }
            spos=app(st,spos,".");
        } else {
            spos=app(st,spos,"At last, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," discovered "); spos=app_art(st,spos,swb,g32(swoff,H*4) as i32); spos=ww_emit(st,spos,swb,swoff,swlen,H);
            if(L>=0){ spos=app(st,spos," near the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); }
            spos=app(st,spos,".");
        }
    } else {
        if(tv==0){ spos=app(st,spos,"In the end, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," kept going."); }
        else { spos=app(st,spos,"At last, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," kept going."); }
    }
    spos=app(st,spos,"\n");
    k=0;
    let dk:i32=0;
    while(k<n3){
        let wi2:i32=g32(beat,(3*12+k)*4) as i32;
        if(wi2!=H){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi2,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
// render POS beat b (0..3). chunk words; first=anchor.
fn r_posbeat(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,beat:[]u8,beat_n:[]u8,b:i32,tv:i32)i32 {
    let n:i32=g32(beat_n,b*4) as i32;
    let a:i32=g32(beat,(b*12+0)*4) as i32;
    if(b==0){
        let x:i32=g32(beat,(b*12+1)*4) as i32;
        if(tv==0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," was near the "); spos=ww_emit(st,spos,swb,swoff,swlen,x); spos=app(st,spos,".\n"); }
        else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," stood by the "); spos=ww_emit(st,spos,swb,swoff,swlen,x); spos=app(st,spos,".\n"); }
    }
    if(b==1){
        if(tv==0){ spos=app(st,spos,"Then the "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," changed everything.\n"); }
        else { spos=app(st,spos,"Suddenly the "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," arrived.\n"); }
    }
    if(b==2){
        if(n>=2){
            let x2:i32=g32(beat,(b*12+1)*4) as i32;
            if(tv==0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," faced the "); spos=ww_emit(st,spos,swb,swoff,swlen,x2); spos=app(st,spos,".\n"); }
            else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," confronted the "); spos=ww_emit(st,spos,swb,swoff,swlen,x2); spos=app(st,spos,".\n"); }
        } else {
            if(tv==0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," stood its ground.\n"); }
            else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," held its ground.\n"); }
        }
    }
    if(b==3){
        if(tv==0){ spos=app(st,spos,"In the end, the "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," stayed.\n"); }
        else { spos=app(st,spos,"At last, the "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," remained.\n"); }
    }
    // details for remaining chunk words
    let start:i32=1;
    if(b==0){ start=2; }
    if(b==2 && n>=2){ start=2; }
    let k:i32=start; let dk:i32=0;
    while(k<n){
        let wi:i32=g32(beat,(b*12+k)*4) as i32;
        spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,wi);
        if(dk%2==0){ spos=app(st,spos," stayed."); } else { spos=app(st,spos," waited."); }
        spos=app(st,spos,"\n");
        dk=dk+1; k=k+1;
    }
    return spos;
}

// --- main ---
fn beat_name(b:i32)[]u8 {
    if(b==0){ return "SETUP"; }
    if(b==1){ return "COMPLICATION"; }
    if(b==2){ return "CLIMAX"; }
    return "RESOLUTION";
}
fn class_name(c:i32)[]u8 {
    if(c==0){ return "PERSON"; }
    if(c==1){ return "PLACE"; }
    if(c==2){ return "THING"; }
    if(c==3){ return "EVENT"; }
    return "ABSTRACT";
}
fn rule_name(r:i32)[]u8 {
    if(r==0){ return "CLASS_SLOT"; }
    if(r==1){ return "FALLBACK_ORDER"; }
    if(r==2){ return "REPAIR_SPILL"; }
    return "POSITIONAL";
}
// last rule assigned to word wi (scan seq reverse)
fn last_rule(seq_w:[]u8,seq_b:[]u8,seq_r:[]u8,sn:i32,wi:i32)i32 {
    let k:i32=sn-1;
    let rl:i32=0;
    let found:i32=0;
    while(k>=0 && found==0){
        if((g32(seq_w,k*4) as i32)==wi){ rl=g32(seq_r,k*4) as i32; found=1; }
        k=k-1;
    }
    return rl;
}
// last beat assigned to word wi
fn last_beat(seq_w:[]u8,seq_b:[]u8,sn:i32,wi:i32)i32 {
    let k:i32=sn-1;
    let bt:i32=0;
    let found:i32=0;
    while(k>=0 && found==0){
        if((g32(seq_w,k*4) as i32)==wi){ bt=g32(seq_b,k*4) as i32; found=1; }
        k=k-1;
    }
    return bt;
}
fn main()void {
    let cdata:[]u8=read_all("inputs/classes.txt");
    let wdata:[]u8=read_all("inputs/words.txt");
    let cw:[]u8=nio_alloc(4096);
    let coff:[]u8=nio_alloc(1024);
    let clen:[]u8=nio_alloc(1024);
    let ccls:[]u8=nio_alloc(1024);
    let nc:i32=parse_classes(cdata,cw,coff,clen,ccls);
    pr("CLASSES "); 
    let nb:[]u8=nio_alloc(32);
    let np:i32=0;
    let t:i32=nc;
    if(t==0){ nb[0]=48; np=1; } else { let tt:[]u8=nio_alloc(16); let nn:i32=0; while(t>0){ tt[nn]=((t%10)+48) as u8; nn=nn+1; t=t/10; } let ii:i32=nn-1; while(ii>=0){ nb[np]=tt[ii]; np=np+1; ii=ii-1; } nio_free(tt); }
    pr(nb[0..np]);
    prl("");
    let swb:[]u8=nio_alloc(1024);
    let swoff:[]u8=nio_alloc(48);
    let swlen:[]u8=nio_alloc(48);
    let swcls:[]u8=nio_alloc(48);
    let beat:[]u8=nio_alloc(192);
    let beat_n:[]u8=nio_alloc(16);
    let seq_w:[]u8=nio_alloc(96);
    let seq_b:[]u8=nio_alloc(96);
    let seq_r:[]u8=nio_alloc(96);
    let assigned:[]u8=nio_alloc(12);
    let st:[]u8=nio_alloc(8192);
    let p:i32=0;
    let n:i32=wdata.len;
    while(p<n){
        let ls:i32=p;
        while(p<n && wdata[p]!=10){ p=p+1; }
        let le:i32=p;
        if(p<n){ p=p+1; }
        if(le>ls && wdata[ls]==83){
            // set id = bytes before ':'
            let c2:i32=ls;
            while(c2<le && wdata[c2]!=58){ c2=c2+1; }
            let sid:[]u8=wdata[ls..c2];
            // set number = digit after 'S'
            let snum:i32=(wdata[ls+1]-48) as i32;
            let tv:i32=snum%2;
            let nw:i32=parse_set(wdata,ls,le-ls,cw,coff,clen,ccls,nc,swb,swoff,swlen,swcls);
            let v:i32=0;
            while(v<2){
                let sn:i32=0;
                if(v==0){ sn=plan_pos(nw,beat,beat_n,seq_w,seq_b,seq_r); }
                else { sn=plan_del(swcls,nw,beat,beat_n,seq_w,seq_b,seq_r,assigned); }
                // render
                let spos:i32=0;
                if(v==0){
                    let b2:i32=0;
                    while(b2<4){ spos=r_posbeat(st,spos,swb,swoff,swlen,beat,beat_n,b2,tv); b2=b2+1; }
                } else {
                    // P = first PERSON in beat0 else beat0[0]; L = first PLACE in beat0 else -1
                    let n0:i32=g32(beat_n,0) as i32;
                    let P:i32=-1; let L:i32=-1; let k3:i32=0;
                    while(k3<n0){
                        let wi3:i32=g32(beat,(0*12+k3)*4) as i32;
                        let cc:i32=g32(swcls,wi3*4) as i32;
                        if(cc==0 && P<0){ P=wi3; }
                        if(cc==1 && L<0){ L=wi3; }
                        k3=k3+1;
                    }
                    if(P<0){ P=g32(beat,(0*12+0)*4) as i32; }
                    spos=r_setup(st,spos,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L);
                    spos=r_compl(st,spos,swb,swoff,swlen,swcls,beat,beat_n,tv);
                    spos=r_climax(st,spos,swb,swoff,swlen,swcls,beat,beat_n,P);
                    spos=r_resol(st,spos,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L);
                }
                // print
                pr("### STORY ");
                pr(sid);
                if(v==0){ pr(" POS\n"); } else { pr(" DEL\n"); }
                pr(st[0..spos]);
                pr("### PLAN ");
                pr(sid);
                if(v==0){ pr(" POS\n"); } else { pr(" DEL\n"); }
                let b3:i32=0;
                while(b3<4){
                    pr(beat_name(b3));
                    pr(":");
                    let nb3:i32=g32(beat_n,b3*4) as i32;
                    let k4:i32=0;
                    while(k4<nb3){
                        let wi4:i32=g32(beat,(b3*12+k4)*4) as i32;
                        pr(" ");
                        pr(swb[g32(swoff,wi4*4) as i32 .. (g32(swoff,wi4*4) as i32)+(g32(swlen,wi4*4) as i32)]);
                        pr("(");
                        pr(class_name(g32(swcls,wi4*4) as i32));
                        pr(",");
                        pr(rule_name(last_rule(seq_w,seq_b,seq_r,sn,wi4)));
                        pr(")");
                        k4=k4+1;
                    }
                    prl("");
                    b3=b3+1;
                }
                prl("### END");
                v=v+1;
            }
        }
    }
    return;
}


// --- rendering ---
fn detail(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,wi:i32,dk:i32)i32 {
    let c:i32=g32(swcls,wi*4) as i32;
    let v:i32=dk%2;
    let wo:i32=g32(swoff,wi*4) as i32;
    let wl:i32=g32(swlen,wi*4) as i32;
    spos=app(st,spos,"The ");
    spos=app_w(st,spos,swb,wo,wl);
    if(c==2){ if(v==0){ spos=app(st,spos," waited quietly."); } else { spos=app(st,spos," watched it all."); } }
    if(c==0){ if(v==0){ spos=app(st,spos," said nothing."); } else { spos=app(st,spos," watched it all."); } }
    if(c==1){ if(v==0){ spos=app(st,spos," stood silent."); } else { spos=app(st,spos," remembered everything."); } }
    if(c==3){ if(v==0){ spos=app(st,spos," raged on."); } else { spos=app(st,spos," slowly faded."); } }
    if(c==4){ if(v==0){ spos=app(st,spos," hung in the air."); } else { spos=app(st,spos," lingered."); } }
    spos=app(st,spos,"\n");
    return spos;
}
// word bytes of set-word wi
fn ww_emit(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,wi:i32)i32 {
    return app_w(st,spos,swb,g32(swoff,wi*4) as i32,g32(swlen,wi*4) as i32);
}
// render DEL SETUP (beat 0). P=protagonist wi, L=setting wi or -1. tv=template variant.
fn r_setup(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,tv:i32,P:i32,L:i32)i32 {
    let n0:i32=g32(beat_n,0) as i32;
    let T:i32=-1; let k:i32=0;
    while(k<n0){
        let wi:i32=g32(beat,(0*12+k)*4) as i32;
        if(wi!=P && wi!=L && (g32(swcls,wi*4) as i32)==2 && T<0){ T=wi; }
        k=k+1;
    }
    if(tv==0){
        spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P);
        if(L>=0){ spos=app(st,spos," lived near the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); spos=app(st,spos,"."); }
        else { spos=app(st,spos," lived alone."); }
    } else {
        if(L>=0){ spos=app(st,spos,"Near the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); spos=app(st,spos,", the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," kept a small house."); }
        else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," had no home to speak of."); }
    }
    spos=app(st,spos,"\n");
    if(T>=0){
        if(tv==0){ spos=app(st,spos,"Every morning the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," polished the "); spos=ww_emit(st,spos,swb,swoff,swlen,T); spos=app(st,spos,"."); }
        else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," treasured the "); spos=ww_emit(st,spos,swb,swoff,swlen,T); spos=app(st,spos," above all else."); }
        spos=app(st,spos,"\n");
    }
    k=0;
    let dk:i32=0;
    while(k<n0){
        let wi2:i32=g32(beat,(0*12+k)*4) as i32;
        if(wi2!=P && wi2!=L && wi2!=T){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi2,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
// render DEL COMPLICATION (beat 1)
fn r_compl(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,tv:i32)i32 {
    let n1:i32=g32(beat_n,4) as i32;
    let E:i32=-1; let V:i32=-1; let k:i32=0;
    while(k<n1){
        let wi:i32=g32(beat,(1*12+k)*4) as i32;
        let c:i32=g32(swcls,wi*4) as i32;
        if(c==3 && E<0){ E=wi; }
        if((c==2 || c==0) && wi!=E && V<0){ V=wi; }
        k=k+1;
    }
    if(tv==0){
        if(E>=0){ spos=app(st,spos,"Then the "); spos=ww_emit(st,spos,swb,swoff,swlen,E); spos=app(st,spos," struck without warning."); }
        else { spos=app(st,spos,"Then trouble came without warning."); }
    } else {
        if(E>=0){ spos=app(st,spos,"Without warning, the "); spos=ww_emit(st,spos,swb,swoff,swlen,E); spos=app(st,spos," arrived."); }
        else { spos=app(st,spos,"Without warning, trouble arrived."); }
    }
    spos=app(st,spos,"\n");
    if(V>=0){
        if(tv==0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,V); spos=app(st,spos," was caught in the chaos."); }
        else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,V); spos=app(st,spos," had nowhere to hide."); }
        spos=app(st,spos,"\n");
    }
    k=0;
    let dk:i32=0;
    while(k<n1){
        let wi2:i32=g32(beat,(1*12+k)*4) as i32;
        if(wi2!=E && wi2!=V){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi2,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
// render DEL CLIMAX (beat 2). P=protagonist wi.
fn r_climax(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,P:i32)i32 {
    let n2:i32=g32(beat_n,8) as i32;
    let R:i32=-1; let O:i32=-1; let k:i32=0;
    while(k<n2){
        let wi:i32=g32(beat,(2*12+k)*4) as i32;
        let c:i32=g32(swcls,wi*4) as i32;
        if((c==3 || c==4 || c==0) && R<0){ R=wi; }
        k=k+1;
    }
    if(R<0 && n2>0){ R=g32(beat,(2*12+0)*4) as i32; }
    k=0;
    while(k<n2){
        let wi2:i32=g32(beat,(2*12+k)*4) as i32;
        if(wi2!=R && (g32(swcls,wi2*4) as i32)==2 && O<0){ O=wi2; }
        k=k+1;
    }
    let rc:i32=-1;
    if(R>=0){ rc=g32(swcls,R*4) as i32; }
    if(rc==3){
        spos=app(st,spos,"Then the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos," returned, worse than before.\n");
        if(O>=0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," held the "); spos=ww_emit(st,spos,swb,swoff,swlen,O); spos=app(st,spos," tight.\n"); }
    } else {
        if(rc==4){
            spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P);
            if(O>=0){ spos=app(st,spos," faced the "); spos=ww_emit(st,spos,swb,swoff,swlen,O); spos=app(st,spos," and demanded "); }
            else { spos=app(st,spos," demanded "); }
            spos=app_art(st,spos,swb,g32(swoff,R*4) as i32); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos,".\n");
        } else {
            if(rc==0){
                spos=app(st,spos,"Then the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos," arrived, and everything changed.\n");
                if(O>=0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," stared at the "); spos=ww_emit(st,spos,swb,swoff,swlen,O); spos=app(st,spos,".\n"); }
            } else {
                if(O>=0 && O!=R){
                    spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," stood alone against the "); spos=ww_emit(st,spos,swb,swoff,swlen,O);
                    if(rc==1){ spos=app(st,spos," in the "); } else { spos=app(st,spos,", clutching the "); }
                    spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos,".\n");
                }
                else {
                    spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P);
                    if(rc==1){ spos=app(st,spos," stood alone in the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos,".\n"); }
                    else { spos=app(st,spos," clutched the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos," and stood alone.\n"); }
                }
            }
        }
    }
    k=0;
    let dk:i32=0;
    while(k<n2){
        let wi3:i32=g32(beat,(2*12+k)*4) as i32;
        if(wi3!=R && wi3!=O){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi3,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
// render DEL RESOLUTION (beat 3). P=protagonist wi, L=setting wi or -1.
fn r_resol(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,tv:i32,P:i32,L:i32)i32 {
    let n3:i32=g32(beat_n,12) as i32;
    let H:i32=-1; let k:i32=0;
    while(k<n3){
        let wi:i32=g32(beat,(3*12+k)*4) as i32;
        if((g32(swcls,wi*4) as i32)==4 && H<0){ H=wi; }
        k=k+1;
    }
    if(H>=0){
        if(tv==0){
            spos=app(st,spos,"In the end, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," found "); spos=app_art(st,spos,swb,g32(swoff,H*4) as i32); spos=ww_emit(st,spos,swb,swoff,swlen,H);
            if(L>=0){ spos=app(st,spos," at the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); }
            spos=app(st,spos,".");
        } else {
            spos=app(st,spos,"At last, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," discovered "); spos=app_art(st,spos,swb,g32(swoff,H*4) as i32); spos=ww_emit(st,spos,swb,swoff,swlen,H);
            if(L>=0){ spos=app(st,spos," near the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); }
            spos=app(st,spos,".");
        }
    } else {
        if(tv==0){ spos=app(st,spos,"In the end, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," kept going."); }
        else { spos=app(st,spos,"At last, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," kept going."); }
    }
    spos=app(st,spos,"\n");
    k=0;
    let dk:i32=0;
    while(k<n3){
        let wi2:i32=g32(beat,(3*12+k)*4) as i32;
        if(wi2!=H){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi2,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
// render POS beat b (0..3). chunk words; first=anchor.
fn r_posbeat(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,beat:[]u8,beat_n:[]u8,b:i32,tv:i32)i32 {
    let n:i32=g32(beat_n,b*4) as i32;
    let a:i32=g32(beat,(b*12+0)*4) as i32;
    if(b==0){
        let x:i32=g32(beat,(b*12+1)*4) as i32;
        if(tv==0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," was near the "); spos=ww_emit(st,spos,swb,swoff,swlen,x); spos=app(st,spos,".\n"); }
        else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," stood by the "); spos=ww_emit(st,spos,swb,swoff,swlen,x); spos=app(st,spos,".\n"); }
    }
    if(b==1){
        if(tv==0){ spos=app(st,spos,"Then the "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," changed everything.\n"); }
        else { spos=app(st,spos,"Suddenly the "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," arrived.\n"); }
    }
    if(b==2){
        if(n>=2){
            let x2:i32=g32(beat,(b*12+1)*4) as i32;
            if(tv==0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," faced the "); spos=ww_emit(st,spos,swb,swoff,swlen,x2); spos=app(st,spos,".\n"); }
            else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," confronted the "); spos=ww_emit(st,spos,swb,swoff,swlen,x2); spos=app(st,spos,".\n"); }
        } else {
            if(tv==0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," stood its ground.\n"); }
            else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," held its ground.\n"); }
        }
    }
    if(b==3){
        if(tv==0){ spos=app(st,spos,"In the end, the "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," stayed.\n"); }
        else { spos=app(st,spos,"At last, the "); spos=ww_emit(st,spos,swb,swoff,swlen,a); spos=app(st,spos," remained.\n"); }
    }
    // details for remaining chunk words
    let start:i32=1;
    if(b==0){ start=2; }
    if(b==2 && n>=2){ start=2; }
    let k:i32=start; let dk:i32=0;
    while(k<n){
        let wi:i32=g32(beat,(b*12+k)*4) as i32;
        spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,wi);
        if(dk%2==0){ spos=app(st,spos," stayed."); } else { spos=app(st,spos," waited."); }
        spos=app(st,spos,"\n");
        dk=dk+1; k=k+1;
    }
    return spos;
}


// --- main ---
fn beat_name(b:i32)[]u8 {
    if(b==0){ return "SETUP"; }
    if(b==1){ return "COMPLICATION"; }
    if(b==2){ return "CLIMAX"; }
    return "RESOLUTION";
}
fn class_name(c:i32)[]u8 {
    if(c==0){ return "PERSON"; }
    if(c==1){ return "PLACE"; }
    if(c==2){ return "THING"; }
    if(c==3){ return "EVENT"; }
    return "ABSTRACT";
}
fn rule_name(r:i32)[]u8 {
    if(r==0){ return "CLASS_SLOT"; }
    if(r==1){ return "FALLBACK_ORDER"; }
    if(r==2){ return "REPAIR_SPILL"; }
    return "POSITIONAL";
}
// last rule assigned to word wi (scan seq reverse)
fn last_rule(seq_w:[]u8,seq_b:[]u8,seq_r:[]u8,sn:i32,wi:i32)i32 {
    let k:i32=sn-1;
    let rl:i32=0;
    let found:i32=0;
    while(k>=0 && found==0){
        if((g32(seq_w,k*4) as i32)==wi){ rl=g32(seq_r,k*4) as i32; found=1; }
        k=k-1;
    }
    return rl;
}
// last beat assigned to word wi
fn last_beat(seq_w:[]u8,seq_b:[]u8,sn:i32,wi:i32)i32 {
    let k:i32=sn-1;
    let bt:i32=0;
    let found:i32=0;
    while(k>=0 && found==0){
        if((g32(seq_w,k*4) as i32)==wi){ bt=g32(seq_b,k*4) as i32; found=1; }
        k=k-1;
    }
    return bt;
}
fn main()void {
    let cdata:[]u8=read_all("inputs/classes.txt");
    let wdata:[]u8=read_all("inputs/words.txt");
    let cw:[]u8=nio_alloc(4096);
    let coff:[]u8=nio_alloc(1024);
    let clen:[]u8=nio_alloc(1024);
    let ccls:[]u8=nio_alloc(1024);
    let nc:i32=parse_classes(cdata,cw,coff,clen,ccls);
    pr("CLASSES "); 
    let nb:[]u8=nio_alloc(32);
    let np:i32=0;
    let t:i32=nc;
    if(t==0){ nb[0]=48; np=1; } else { let tt:[]u8=nio_alloc(16); let nn:i32=0; while(t>0){ tt[nn]=((t%10)+48) as u8; nn=nn+1; t=t/10; } let ii:i32=nn-1; while(ii>=0){ nb[np]=tt[ii]; np=np+1; ii=ii-1; } nio_free(tt); }
    pr(nb[0..np]);
    prl("");
    let swb:[]u8=nio_alloc(1024);
    let swoff:[]u8=nio_alloc(48);
    let swlen:[]u8=nio_alloc(48);
    let swcls:[]u8=nio_alloc(48);
    let beat:[]u8=nio_alloc(192);
    let beat_n:[]u8=nio_alloc(16);
    let seq_w:[]u8=nio_alloc(96);
    let seq_b:[]u8=nio_alloc(96);
    let seq_r:[]u8=nio_alloc(96);
    let assigned:[]u8=nio_alloc(12);
    let st:[]u8=nio_alloc(8192);
    let p:i32=0;
    let n:i32=wdata.len;
    while(p<n){
        let ls:i32=p;
        while(p<n && wdata[p]!=10){ p=p+1; }
        let le:i32=p;
        if(p<n){ p=p+1; }
        if(le>ls && wdata[ls]==83){
            // set id = bytes before ':'
            let c2:i32=ls;
            while(c2<le && wdata[c2]!=58){ c2=c2+1; }
            let sid:[]u8=wdata[ls..c2];
            // set number = digit after 'S'
            let snum:i32=(wdata[ls+1]-48) as i32;
            let tv:i32=snum%2;
            let nw:i32=parse_set(wdata,ls,le-ls,cw,coff,clen,ccls,nc,swb,swoff,swlen,swcls);
            let v:i32=0;
            while(v<2){
                let sn:i32=0;
                if(v==0){ sn=plan_pos(nw,beat,beat_n,seq_w,seq_b,seq_r); }
                else { sn=plan_del(swcls,nw,beat,beat_n,seq_w,seq_b,seq_r,assigned); }
                // render
                let spos:i32=0;
                if(v==0){
                    let b2:i32=0;
                    while(b2<4){ spos=r_posbeat(st,spos,swb,swoff,swlen,beat,beat_n,b2,tv); b2=b2+1; }
                } else {
                    // P = first PERSON in beat0 else beat0[0]; L = first PLACE in beat0 else -1
                    let n0:i32=g32(beat_n,0) as i32;
                    let P:i32=-1; let L:i32=-1; let k3:i32=0;
                    while(k3<n0){
                        let wi3:i32=g32(beat,(0*12+k3)*4) as i32;
                        let cc:i32=g32(swcls,wi3*4) as i32;
                        if(cc==0 && P<0){ P=wi3; }
                        if(cc==1 && L<0){ L=wi3; }
                        k3=k3+1;
                    }
                    if(P<0){ P=g32(beat,(0*12+0)*4) as i32; }
                    spos=r_setup(st,spos,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L);
                    spos=r_compl(st,spos,swb,swoff,swlen,swcls,beat,beat_n,tv);
                    spos=r_climax(st,spos,swb,swoff,swlen,swcls,beat,beat_n,P);
                    spos=r_resol(st,spos,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L);
                }
                // print
                pr("### STORY ");
                pr(sid);
                if(v==0){ pr(" POS\n"); } else { pr(" DEL\n"); }
                pr(st[0..spos]);
                pr("### PLAN ");
                pr(sid);
                if(v==0){ pr(" POS\n"); } else { pr(" DEL\n"); }
                let b3:i32=0;
                while(b3<4){
                    pr(beat_name(b3));
                    pr(":");
                    let nb3:i32=g32(beat_n,b3*4) as i32;
                    let k4:i32=0;
                    while(k4<nb3){
                        let wi4:i32=g32(beat,(b3*12+k4)*4) as i32;
                        pr(" ");
                        pr(swb[g32(swoff,wi4*4) as i32 .. (g32(swoff,wi4*4) as i32)+(g32(swlen,wi4*4) as i32)]);
                        pr("(");
                        pr(class_name(g32(swcls,wi4*4) as i32));
                        pr(",");
                        pr(rule_name(last_rule(seq_w,seq_b,seq_r,sn,wi4)));
                        pr(")");
                        k4=k4+1;
                    }
                    prl("");
                    b3=b3+1;
                }
                prl("### END");
                v=v+1;
            }
        }
    }
    return;
}

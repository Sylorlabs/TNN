// ============================================================
// ehelp.zag — shared helpers for the native-deliberation epistemics engine.
// Verbatim from attempt #5's epistemic_simple.zag (assessed 2026-09-27:
// helpers proven, kept as-is). Mass parser is NOT here — the attempt-5
// parser had two bugs (missed 'EPI1' magic; df*8 vs df*4 postings) and is
// rewritten correctly in epistemic.zag.
// ============================================================
@import("./R33_NATIVE_IO_V1.zag")
@import("./R33_NATIVE_SHA256_V2.zag")

fn p32(b:[]u8,o:i32,v:i32)void{ b[o]=((v)&255) as u8; b[o+1]=(((v)>>8)&255) as u8; b[o+2]=(((v)>>16)&255) as u8; b[o+3]=(((v)>>24)&255) as u8; return; }
fn g32(b:[]u8,o:i32)i64{ let r:i64=(b[o] as i64)|((b[o+1] as i64)<<8)|((b[o+2] as i64)<<16)|((b[o+3] as i64)<<24); return r; }
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void{ let i:i32=0; while(i<n){ dst[do+i]=src[so+i]; i=i+1; } return; }
fn pr(s:[]u8)void{ if(s.len==0){return;} let w:i64=_zag_raw_syscall(1,2,(_zag_slice_ptr(s) as i64),(s.len as i64),0,0,0); return; }
fn prl(s:[]u8)void{ pr(s); let nl:[]u8=nio_alloc(1); nl[0]=10; pr(nl); return; }
fn prn(v:i64)void{ let b:[]u8=nio_alloc(24); let n:i32=i64str(v,b); pr(b[0..n]); return; }
fn i64str(v:i64,buf:[]u8)i32{ if(v==0){buf[0]=48; return 1;} let neg:i32=0; let x:i64=v; if(x<0){neg=1; x=0-x;} let at:i32=23; while(x>0){ let d:i64=x-(x/10)*10; buf[at]=(48+d) as u8; at=at-1; x=x/10; } if(neg==1){buf[at]=45; at=at-1;} let s:i32=at+1; let n:i32=24-s; let i:i32=0; while(i<n){buf[i]=buf[s+i]; i=i+1;} return n; }
fn z_cstr(s:[]u8)[]u8{ let b:[]u8=nio_alloc(s.len+1); copy_bytes(b,0,s,0,s.len as i32); b[s.len]=0; return b; }
fn read_all(path:[]u8)[]u8{ let p:[]u8=z_cstr(path); let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0); let cap:i32=200000; let buf:[]u8=nio_alloc(cap); let chk:[]u8=nio_alloc(65536); let total:i32=0; let go:i32=1; while(go==1){ let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0); if(n==-4){go=1;} else{ if(n<=0){go=0;} else{ let nb:i32=n as i32; if(total+nb>cap){go=0;} else{ copy_bytes(buf,total,chk,0,nb); total=total+nb; } } } } _zag_raw_syscall(3,fd,0,0,0,0,0); if(total==0){ let e:[]u8=nio_alloc(0); return e; } let out:[]u8=buf[0..total]; return out; }
fn write_all(path:[]u8,data:[]u8)void{ let p:[]u8=z_cstr(path); let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),577,420,0,0,0); if(fd<0){return;} let total:i32=data.len as i32; let done:i32=0; while(done<total){ let w:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data[done..total]) as i64),((total-done) as i64),0,0,0); if(w<=0){done=total;} else{done=done+(w as i32);} } _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn beq(a:[]u8,b:[]u8)i32{ if(a.len!=b.len){return 0;} let i:i32=0; while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; } return 1; }

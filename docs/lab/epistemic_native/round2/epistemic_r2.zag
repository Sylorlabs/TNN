// ============================================================
// epistemic.zag — native-deliberation epistemics engine, Phase 1.
// Label-blind implementer. HARD STOP after Phase 1 (no scoring, no held-out).
//
// Ported from the frozen dialogue substrate deliberate_frozen_r4.zag
// (SHA-256 7dec26d8600683f2c6cefc83d524a403f4ac288117864108dc54a08afa61b787):
//   ledger primitives (led_init/lr_get/lr_put/t_get/t_put), the
//   GEN/ELIM/ARGMAX phase loop, trace emitters (READ/CAND/ELIM/ARGMAX/
//   CONTENT + CLOSE/CONTENDER/REVIEW), neuter-hook pattern (post-READ
//   field-12 zeroing + wrong-hypothesis flip), per-GEN idempotence.
//   Port delta documented in PORT_DELTA.md.
// All epistemic GENs (readings, interpretation bids, verdict bids,
// coverage, formation) are NEW. No dialogue logic ported.
// ============================================================
@import("./ehelp.zag")

// ---------- ledger ----------
// 256 hids x 64-byte rows; turn fields at 16384.
// Row fields: hid@0 kind@4 rdname-code@8 ev@12 score@16 aux@20 state@24
//   elimreason@28 elimby@32 base@36 bonus@40
// state: 0=in-contention 1=eliminated 2=winner
// elimreason: 1=PRE_FAIL 2=GATE 3=OUTSCORED
// kind: 0=reading 1=interp-bid 2=verdict-bid
fn lr_get(led:[]u8,hid:i32,f:i32)i32{ return g32(led,hid*64+f) as i32; }
fn lr_put(led:[]u8,hid:i32,f:i32,v:i32)void{ p32(led,hid*64+f,v); return; }
fn t_get(led:[]u8,off:i32)i32{ return g32(led,16384+off) as i32; }
fn t_put(led:[]u8,off:i32,v:i32)void{ p32(led,16384+off,v); return; }
fn led_init(led:[]u8)void{
  let h:i32=0;
  while(h<256){ let o:i32=h*64; p32(led,o+0,h); p32(led,o+4,-1); p32(led,o+8,0); p32(led,o+12,0); p32(led,o+16,0); p32(led,o+20,0); p32(led,o+24,0); p32(led,o+28,0); p32(led,o+32,-1); p32(led,o+36,0); p32(led,o+40,0); h=h+1; }
  t_put(led,0,0); t_put(led,4,-1); t_put(led,8,-1); t_put(led,12,0); t_put(led,16,-1); t_put(led,20,0); t_put(led,24,0); t_put(led,28,0);
  return;
}
// turn fields: 0=close_call 4=winner 8=runner 12=margin 16=verdict
//   20=contested 24=nsup 28=ncon

// ---------- trace buffer ----------
// tb[0..4): byte length; text from 4.
fn tb_put(tb:[]u8,s:[]u8)void{ let n:i32=g32(tb,0) as i32; copy_bytes(tb,4+n,s,0,s.len as i32); p32(tb,0,n+(s.len as i32)); return; }
fn tb_putc(tb:[]u8,c:u8)void{ let n:i32=g32(tb,0) as i32; tb[4+n]=c; p32(tb,0,n+1); return; }
fn tb_puti(tb:[]u8,v:i64)void{ let b:[]u8=nio_alloc(24); let n:i32=i64str(v,b); tb_put(tb,b[0..n]); nio_free(b); return; }

// ---------- hid names ----------
fn rname(h:i32)[]u8{
  if(h==0){return "R_ASSERT";}
  if(h==1){return "R_EVAL";}
  if(h==2){return "R_DEON";}
  if(h==3){return "R_1PEXP";}
  if(h==4){return "R_NEG";}
  if(h==5){return "R_CLAIMNUM";}
  if(h==6){return "R_OEVAL";}
  if(h==7){return "R_ODEON";}
  if(h==8){return "R_O1PEXP";}
  if(h>=10 && h<26){return "R_OVL";}
  if(h>=26 && h<42){return "R_CPOL";}
  if(h>=42 && h<58){return "R_CNUMA";}
  if(h>=58 && h<74){return "R_CNUMC";}
  if(h>=74 && h<90){return "R_CNUMG";}
  if(h>=90 && h<114){return "R_COV";}
  if(h>=120 && h<136){return "SUP";}
  if(h>=140 && h<156){return "CON";}
  if(h>=160 && h<176){return "TOP";}
  if(h==200){return "FACT";}
  if(h==201){return "LIE";}
  if(h==202){return "OPINION";}
  if(h==203){return "UNDET";}
  return "ROW";
}
fn rsfx(h:i32)i32{
  if(h>=10 && h<26){return h-10;}
  if(h>=26 && h<42){return h-26;}
  if(h>=42 && h<58){return h-42;}
  if(h>=58 && h<74){return h-58;}
  if(h>=74 && h<90){return h-74;}
  if(h>=90 && h<114){return h-90;}
  if(h>=120 && h<136){return h-120;}
  if(h>=140 && h<156){return h-140;}
  if(h>=160 && h<176){return h-160;}
  return -1;
}
fn tr_rname(tb:[]u8,h:i32)void{
  tb_put(tb,rname(h));
  let s:i32=rsfx(h);
  if(s>=0){ tb_putc(tb,95); tb_puti(tb,s as i64); }
  return;
}
// READ hid= rd= ev=
fn tr_reading(tb:[]u8,led:[]u8,h:i32)void{
  tb_put(tb,"READ hid="); tb_puti(tb,h as i64); tb_put(tb," rd="); tr_rname(tb,h);
  tb_put(tb," ev="); tb_puti(tb,lr_get(led,h,12) as i64); tb_putc(tb,10);
  return;
}
// CAND hid= bid= fire= base= bonus= score=
fn tr_cand(tb:[]u8,led:[]u8,h:i32)void{
  tb_put(tb,"CAND hid="); tb_puti(tb,h as i64); tb_put(tb," bid="); tr_rname(tb,h);
  tb_put(tb," fire="); tb_puti(tb,lr_get(led,h,12) as i64);
  tb_put(tb," base="); tb_puti(tb,lr_get(led,h,36) as i64);
  tb_put(tb," bonus="); tb_puti(tb,lr_get(led,h,40) as i64);
  tb_put(tb," score="); tb_puti(tb,lr_get(led,h,16) as i64); tb_putc(tb,10);
  return;
}
// CAND hid= bid= fire= base= bonus= score= cand= (interp bids cite candidate)
fn tr_candx(tb:[]u8,led:[]u8,h:i32,candsl:[]u8)void{
  tb_put(tb,"CAND hid="); tb_puti(tb,h as i64); tb_put(tb," bid="); tr_rname(tb,h);
  tb_put(tb," fire="); tb_puti(tb,lr_get(led,h,12) as i64);
  tb_put(tb," base="); tb_puti(tb,lr_get(led,h,36) as i64);
  tb_put(tb," bonus="); tb_puti(tb,lr_get(led,h,40) as i64);
  tb_put(tb," score="); tb_puti(tb,lr_get(led,h,16) as i64);
  tb_put(tb," cand="); tb_put(tb,candsl); tb_putc(tb,10);
  return;
}
fn elim_reason_name(r:i32)[]u8{
  if(r==1){return "PRE_FAIL";}
  if(r==2){return "GATE";}
  if(r==3){return "OUTSCORED";}
  return "NONE";
}
// ELIM hid= bid= reason= by= score=
fn tr_elim(tb:[]u8,led:[]u8,h:i32)void{
  tb_put(tb,"ELIM hid="); tb_puti(tb,h as i64); tb_put(tb," bid="); tr_rname(tb,h);
  tb_put(tb," reason="); tb_put(tb,elim_reason_name(lr_get(led,h,28)));
  tb_put(tb," by="); tb_puti(tb,lr_get(led,h,32) as i64);
  tb_put(tb," score="); tb_puti(tb,lr_get(led,h,16) as i64); tb_putc(tb,10);
  return;
}

// ---------- mass parsing (CORRECTED vs attempt-5: skips 'EPI1' magic;
// inverted-index postings are <I = 4 bytes, not 8) ----------
// itab: 448*40. per item: id_off@0 id_len@4 txt_off@8 txt_len@12
//   tok_start@16 ntok@20 pat@24 neg@28 num_start@32 nnum@36
// tokflat: 8B entries (off,len) into mass. numflat: 4B i32s.
// ixtab: 16B entries: tok_off@0 tok_len@4 post_off@8 df@12.
// out: out[0]=nix.
fn mass_parse(mass:[]u8,itab:[]u8,tokflat:[]u8,numflat:[]u8,ixtab:[]u8,out:[]u8)i32{
  let off:i32=4;
  let mn:i32=g32(mass,off) as i32; off=off+4;
  let tok_used:i32=0;
  let i:i32=0;
  while(i<mn){
    let base:i32=i*40;
    let ilen:i32=g32(mass,off) as i32; off=off+4;
    p32(itab,base+0,off); p32(itab,base+4,ilen); off=off+ilen;
    let tlen:i32=g32(mass,off) as i32; off=off+4;
    p32(itab,base+8,off); p32(itab,base+12,tlen); off=off+tlen;
    let ntok:i32=g32(mass,off) as i32; off=off+4;
    p32(itab,base+16,tok_used); p32(itab,base+20,ntok);
    let t:i32=0;
    while(t<ntok){
      let tl:i32=g32(mass,off) as i32; off=off+4;
      p32(tokflat,tok_used*8+0,off); p32(tokflat,tok_used*8+4,tl);
      off=off+tl; tok_used=tok_used+1; t=t+1;
    }
    let pat:i32=g32(mass,off) as i32; off=off+4; p32(itab,base+24,pat);
    let neg:i32=g32(mass,off) as i32; off=off+4; p32(itab,base+28,neg);
    let nnum:i32=g32(mass,off) as i32; off=off+4;
    p32(itab,base+32,tok_used); p32(itab,base+36,nnum);
    let q:i32=0;
    while(q<nnum){
      let v:i32=g32(mass,off) as i32; off=off+4;
      p32(numflat,tok_used*4,v); tok_used=tok_used+1; q=q+1;
    }
    i=i+1;
  }
  let nix:i32=g32(mass,off) as i32; off=off+4; p32(out,0,nix);
  let e:i32=0;
  while(e<nix){
    let tl:i32=g32(mass,off) as i32; off=off+4;
    p32(ixtab,e*16+0,off); p32(ixtab,e*16+4,tl); off=off+tl;
    let df:i32=g32(mass,off) as i32; off=off+4;
    p32(ixtab,e*16+8,off); p32(ixtab,e*16+12,df); off=off+df*4;
    e=e+1;
  }
  return mn;
}
// ---------- mass accessors ----------
fn it_pat(itab:[]u8,i:i32)i32{ return g32(itab,i*40+24) as i32; }
fn it_neg(itab:[]u8,i:i32)i32{ return g32(itab,i*40+28) as i32; }
fn it_ntok(itab:[]u8,i:i32)i32{ return g32(itab,i*40+20) as i32; }
fn it_nnum(itab:[]u8,i:i32)i32{ return g32(itab,i*40+36) as i32; }
fn it_tokoff(itab:[]u8,tokflat:[]u8,i:i32,t:i32)i32{
  let ts:i32=g32(itab,i*40+16) as i32;
  return g32(tokflat,(ts+t)*8+0) as i32;
}
fn it_toklen(itab:[]u8,tokflat:[]u8,i:i32,t:i32)i32{
  let ts:i32=g32(itab,i*40+16) as i32;
  return g32(tokflat,(ts+t)*8+4) as i32;
}
fn it_num(itab:[]u8,numflat:[]u8,i:i32,q:i32)i32{
  let ns:i32=g32(itab,i*40+32) as i32;
  return g32(numflat,(ns+q)*4) as i32;
}
fn it_id(mass:[]u8,itab:[]u8,i:i32)[]u8{
  let o:i32=g32(itab,i*40+0) as i32; let l:i32=g32(itab,i*40+4) as i32;
  return mass[o..o+l];
}
fn it_text(mass:[]u8,itab:[]u8,i:i32)[]u8{
  let o:i32=g32(itab,i*40+8) as i32; let l:i32=g32(itab,i*40+12) as i32;
  return mass[o..o+l];
}
fn tok_eq(mass:[]u8,ao:i32,al:i32,bo:i32,bl:i32)i32{
  if(al!=bl){return 0;}
  let i:i32=0;
  while(i<al){ if(mass[ao+i]!=mass[bo+i]){return 0;} i=i+1; }
  return 1;
}
// inverted index
fn ix_df(ixtab:[]u8,e:i32)i32{ return g32(ixtab,e*16+12) as i32; }
fn ix_post(mass:[]u8,ixtab:[]u8,e:i32,j:i32)i32{
  let po:i32=g32(ixtab,e*16+8) as i32;
  return g32(mass,po+j*4) as i32;
}
fn ix_find(mass:[]u8,ixtab:[]u8,nix:i32,to:i32,tl:i32)i32{
  let e:i32=0;
  while(e<nix){
    let eo:i32=g32(ixtab,e*16+0) as i32; let el:i32=g32(ixtab,e*16+4) as i32;
    if(tok_eq(mass,to,tl,eo,el)==1){return e;}
    e=e+1;
  }
  return -1;
}
// number relation: 1 iff claim ci and candidate cj share a number value
fn num_shared(itab:[]u8,numflat:[]u8,ci:i32,cj:i32)i32{
  let n:i32=it_nnum(itab,ci); let m:i32=it_nnum(itab,cj);
  let q:i32=0;
  while(q<n){
    let v:i32=it_num(itab,numflat,ci,q);
    let r:i32=0;
    while(r<m){ if(it_num(itab,numflat,cj,r)==v){return 1;} r=r+1; }
    q=q+1;
  }
  return 0;
}
// token share: 1 iff candidate cj shares claim ci's token ti
fn tok_shared(mass:[]u8,itab:[]u8,tokflat:[]u8,ci:i32,ti:i32,cj:i32)i32{
  let ao:i32=it_tokoff(itab,tokflat,ci,ti); let al:i32=it_toklen(itab,tokflat,ci,ti);
  let m:i32=it_ntok(itab,cj);
  let u:i32=0;
  while(u<m){
    let bo:i32=it_tokoff(itab,tokflat,cj,u); let bl:i32=it_toklen(itab,tokflat,cj,u);
    if(tok_eq(mass,ao,al,bo,bl)==1){return 1;}
    u=u+1;
  }
  return 0;
}
// ---------- retrieval (proposes; never judges) ----------
// top-16 by (overlap desc, idx asc); self excluded. cand/covl: 16xi32 out.
fn retrieve(mass:[]u8,itab:[]u8,tokflat:[]u8,ixtab:[]u8,nix:i32,nitems:i32,claim:i32,self:i32,xc:i32,cand:[]u8,covl:[]u8)i32{
  let ov:[]u8=nio_alloc(nitems*4);
  let i:i32=0;
  while(i<nitems){ p32(ov,i*4,0); i=i+1; }
  let nt:i32=it_ntok(itab,claim);
  let t:i32=0;
  while(t<nt){
    let to:i32=it_tokoff(itab,tokflat,claim,t); let tl:i32=it_toklen(itab,tokflat,claim,t);
    let e:i32=ix_find(mass,ixtab,nix,to,tl);
    if(e>=0){
      let df:i32=ix_df(ixtab,e);
      let j:i32=0;
      while(j<df){
        let p:i32=ix_post(mass,ixtab,e,j);
        if(p!=self && p!=xc && p<nitems){ p32(ov,p*4,(g32(ov,p*4) as i32)+1); }
        j=j+1;
      }
    }
    t=t+1;
  }
  let k:i32=0;
  while(k<16){ p32(cand,k*4,-1); p32(covl,k*4,0); k=k+1; }
  let n:i32=0;
  let go:i32=1;
  while(go==1){
    if(n>=16){ go=0; }
    if(go==1){
      let best:i32=-1; let bv:i32=0; let bi:i32=99999;
      let q2:i32=0;
      while(q2<nitems){
        let v:i32=g32(ov,q2*4) as i32;
        if(v>0 && (v>bv || (v==bv && q2<bi))){ best=q2; bv=v; bi=q2; }
        q2=q2+1;
      }
      if(best<0){ go=0; }
      if(best>=0){ p32(cand,n*4,best); p32(covl,n*4,bv); p32(ov,best*4,-1); n=n+1; }
    }
  }
  nio_free(ov);
  return n;
}

// ---------- GEN readings (kind-0; SOLE claim classifier) ----------
// hids 0-8: R_ASSERT R_EVAL R_DEON R_1PEXP R_NEG R_CLAIMNUM R_OEVAL R_ODEON R_O1PEXP
// hids 10+c:R_OVL 26+c:R_CPOL 42+c:R_CNUMA 58+c:R_CNUMC 74+c:R_CNUMG
// In study mode the learned opinion-track rows (6-8) are NOT generated.
// Neuter/flip (validity probes): applied AFTER the READ trace prints the
// computed value; consumers read the intervened value (REDTEAM4 methodology).
fn gen_readings(tb:[]u8,led:[]u8,mass:[]u8,itab:[]u8,tokflat:[]u8,numflat:[]u8,
  claim:i32,cand:[]u8,covl:[]u8,ncand:i32,formed:[]u8,study:i32,
  neuter_hid:i32,flip_hid:i32,done:[]u8)void{
  if(done[0]==1){return;}
  done[0]=1;
  let pat:i32=it_pat(itab,claim);
  let neg:i32=it_neg(itab,claim);
  let nnum:i32=it_nnum(itab,claim);
  let ev0:i32=0; if(pat==0){ev0=1;}
  let ev1:i32=0; if((pat&3)!=0){ev1=1;}
  let ev2:i32=0; if((pat&4)!=0){ev2=1;}
  let ev3:i32=0; if((pat&8)!=0){ev3=1;}
  lr_put(led,0,4,0); lr_put(led,0,12,ev0);
  lr_put(led,1,4,0); lr_put(led,1,12,ev1);
  lr_put(led,2,4,0); lr_put(led,2,12,ev2);
  lr_put(led,3,4,0); lr_put(led,3,12,ev3);
  lr_put(led,4,4,0); lr_put(led,4,12,neg);
  let ev5:i32=0; if(nnum>0){ev5=1;}
  lr_put(led,5,4,0); lr_put(led,5,12,ev5);
  if(study==0){
    let f0:i32=0; if(ev1==1 && (g32(formed,0) as i32)==1){f0=1;}
    let f1:i32=0; if(ev2==1 && (g32(formed,4) as i32)==1){f1=1;}
    let f2:i32=0; if(ev3==1 && (g32(formed,8) as i32)==1){f2=1;}
    lr_put(led,6,4,0); lr_put(led,6,12,f0);
    lr_put(led,7,4,0); lr_put(led,7,12,f1);
    lr_put(led,8,4,0); lr_put(led,8,12,f2);
  }
  let c:i32=0;
  while(c<ncand){
    let cj:i32=g32(cand,c*4) as i32;
    let ovl:i32=g32(covl,c*4) as i32;
    lr_put(led,10+c,4,1); lr_put(led,10+c,12,ovl); lr_put(led,10+c,20,cj);
    let cpol:i32=it_neg(itab,cj);
    lr_put(led,26+c,4,1); lr_put(led,26+c,12,cpol); lr_put(led,26+c,20,cj);
    let sh:i32=num_shared(itab,numflat,claim,cj);
    let jn:i32=it_nnum(itab,cj);
    let cna:i32=0; if(nnum==0 || sh==1){cna=1;}
    let cnc:i32=0; if(nnum>0 && jn>0 && sh==0){cnc=1;}
    let cng:i32=0; if(nnum>0 && jn==0){cng=1;}
    lr_put(led,42+c,4,1); lr_put(led,42+c,12,cna); lr_put(led,42+c,20,cj);
    lr_put(led,58+c,4,1); lr_put(led,58+c,12,cnc); lr_put(led,58+c,20,cj);
    lr_put(led,74+c,4,1); lr_put(led,74+c,12,cng); lr_put(led,74+c,20,cj);
    c=c+1;
  }
  // trace (computed values), then neuter/flip intervention on consumed values
  let h:i32=0;
  while(h<9){
    if(study==1 && h>=6){ h=h+1; }
    if(study==0 || h<6){
      tr_reading(tb,led,h);
      if(neuter_hid==h || neuter_hid==99){ lr_put(led,h,12,0); }
      if(flip_hid==h){ let cv:i32=lr_get(led,h,12); lr_put(led,h,12,1-cv); }
    }
    h=h+1;
  }
  let c2:i32=0;
  while(c2<ncand){
    tr_reading(tb,led,10+c2);
    tr_reading(tb,led,26+c2);
    tr_reading(tb,led,42+c2);
    tr_reading(tb,led,58+c2);
    tr_reading(tb,led,74+c2);
    c2=c2+1;
  }
  return;
}
// ---------- GEN interpretation bids ----------
// SUP(120+c) CON(140+c) TOP(160+c): all fire on ovl>=1; scores from READING
// rows only. base=100.
fn gen_interp(tb:[]u8,led:[]u8,mass:[]u8,itab:[]u8,cand:[]u8,claim:i32,ncand:i32,done:[]u8)void{
  if(done[1]==1){return;}
  done[1]=1;
  let cneg:i32=lr_get(led,4,12);
  let cn:i32=lr_get(led,5,12);
  // claim utterance-type signature FROM THE LEDGER reading rows (hids 0-3),
  // so neuter/flip interventions on those readings propagate here.
  let sigc:i32=lr_get(led,0,12)*1+lr_get(led,1,12)*2+lr_get(led,2,12)*4+lr_get(led,3,12)*8;
  let c:i32=0;
  while(c<ncand){
    let cj:i32=g32(cand,c*4) as i32;
    let o:i32=lr_get(led,10+c,12);
    let cpol:i32=lr_get(led,26+c,12);
    let numa:i32=lr_get(led,42+c,12);
    let numc:i32=lr_get(led,58+c,12);
    let numg:i32=lr_get(led,74+c,12);
    let pol:i32=0; if(cneg==cpol){pol=1;}
    let nreal:i32=0; if(numa==1 && cn==1){nreal=1;}
    // construction congruence: candidate in the same utterance-type pattern
    // as the claim bears on it (SUP or CON) rather than merely topical.
    // Candidate signature uses reading semantics; claim signature is ledger.
    let jp:i32=it_pat(itab,cj);
    let s0:i32=0; if(jp==0){s0=1;}
    let s1:i32=0; if((jp&3)!=0){s1=2;}
    let s2:i32=0; if((jp&4)!=0){s2=4;}
    let s3:i32=0; if((jp&8)!=0){s3=8;}
    let cong:i32=0; if(sigc==s0+s1+s2+s3){cong=1;}
    // exact shared number value: strong quantitative bearing (weight matches
    // the number-gap TOP bonus by symmetry).
    let bs:i32=o+10*pol*numa+12*nreal+6*cong;
    let bc:i32=o+10*(1-pol)*numa+8*numc+6*cong;
    let bt:i32=o+12*numg;
    lr_put(led,120+c,4,1); lr_put(led,120+c,8,120+c); lr_put(led,120+c,12,1);
    lr_put(led,120+c,16,100+bs); lr_put(led,120+c,20,c);
    lr_put(led,120+c,36,100); lr_put(led,120+c,40,bs);
    lr_put(led,140+c,4,1); lr_put(led,140+c,8,140+c); lr_put(led,140+c,12,1);
    lr_put(led,140+c,16,100+bc); lr_put(led,140+c,20,c);
    lr_put(led,140+c,36,100); lr_put(led,140+c,40,bc);
    lr_put(led,160+c,4,1); lr_put(led,160+c,8,160+c); lr_put(led,160+c,12,1);
    lr_put(led,160+c,16,100+bt); lr_put(led,160+c,20,c);
    lr_put(led,160+c,36,100); lr_put(led,160+c,40,bt);
    tr_candx(tb,led,120+c,it_id(mass,itab,cj));
    tr_candx(tb,led,140+c,it_id(mass,itab,cj));
    tr_candx(tb,led,160+c,it_id(mass,itab,cj));
    c=c+1;
  }
  return;
}
// ---------- ELIM over interpretation bids (per candidate) ----------
// Non-fired -> PRE_FAIL; among fired, max score survives (tie -> lowest hid),
// losers -> OUTSCORED. ELIM lines for every non-survivor.
fn elim_interp(tb:[]u8,led:[]u8,ncand:i32)void{
  let c:i32=0;
  while(c<ncand){
    let h0:i32=120+c; let h1:i32=140+c; let h2:i32=160+c;
    let f0:i32=lr_get(led,h0,12); let f1:i32=lr_get(led,h1,12); let f2:i32=lr_get(led,h2,12);
    if(f0==0){ lr_put(led,h0,24,1); lr_put(led,h0,28,1); lr_put(led,h0,32,-1); }
    if(f1==0){ lr_put(led,h1,24,1); lr_put(led,h1,28,1); lr_put(led,h1,32,-1); }
    if(f2==0){ lr_put(led,h2,24,1); lr_put(led,h2,28,1); lr_put(led,h2,32,-1); }
    let win:i32=-1; let ws:i32=-2000000000;
    if(f0==1){ win=h0; ws=lr_get(led,h0,16); }
    if(f1==1){ let s:i32=lr_get(led,h1,16); if(win<0 || s>ws || (s==ws && h1<win)){ win=h1; ws=s; } }
    if(f2==1){ let s:i32=lr_get(led,h2,16); if(win<0 || s>ws || (s==ws && h2<win)){ win=h2; ws=s; } }
    if(f0==1 && h0!=win){ lr_put(led,h0,24,1); lr_put(led,h0,28,3); lr_put(led,h0,32,win); }
    if(f1==1 && h1!=win){ lr_put(led,h1,24,1); lr_put(led,h1,28,3); lr_put(led,h1,32,win); }
    if(f2==1 && h2!=win){ lr_put(led,h2,24,1); lr_put(led,h2,28,3); lr_put(led,h2,32,win); }
    if(f0==0 || h0!=win){ tr_elim(tb,led,h0); }
    if(f1==0 || h1!=win){ tr_elim(tb,led,h1); }
    if(f2==0 || h2!=win){ tr_elim(tb,led,h2); }
    c=c+1;
  }
  return;
}

// ---------- GEN coverage readings (verdict-phase evidence) ----------
// R_COV_t (90+t, t<24): ev=1 iff claim token t is shared with a SURVIVING
// SUP/CON candidate. Consumed only by the NEED builder (verdict branch).
fn gen_coverage(tb:[]u8,led:[]u8,mass:[]u8,itab:[]u8,tokflat:[]u8,claim:i32,
  cand:[]u8,ncand:i32,done:[]u8)void{
  if(done[2]==1){return;}
  done[2]=1;
  let nt:i32=it_ntok(itab,claim);
  if(nt>24){nt=24;}
  let t:i32=0;
  while(t<nt){
    let ev:i32=0;
    let c:i32=0;
    while(c<ncand){
      let ss:i32=lr_get(led,120+c,24); let cs:i32=lr_get(led,140+c,24);
      let sf:i32=lr_get(led,120+c,12); let cf:i32=lr_get(led,140+c,12);
      if(((ss==0 && sf==1) || (cs==0 && cf==1))){
        let cj:i32=g32(cand,c*4) as i32;
        if(tok_shared(mass,itab,tokflat,claim,t,cj)==1){ ev=1; }
      }
      c=c+1;
    }
    lr_put(led,90+t,4,0); lr_put(led,90+t,12,ev);
    tr_reading(tb,led,90+t);
    t=t+1;
  }
  return;
}
// ---------- GEN verdict bids (fire conditions read ONLY ledger rows) ----------
fn gen_verdicts(tb:[]u8,led:[]u8,ncand:i32,study:i32,done:[]u8)void{
  if(done[3]==1){return;}
  done[3]=1;
  let nsup:i32=0; let ncon:i32=0; let bso:i32=0; let bco:i32=0;
  let c:i32=0;
  while(c<ncand){
    if(lr_get(led,120+c,12)==1 && lr_get(led,120+c,24)==0){
      nsup=nsup+1;
      let o:i32=lr_get(led,10+c,12); if(o>bso){bso=o;}
    }
    if(lr_get(led,140+c,12)==1 && lr_get(led,140+c,24)==0){
      ncon=ncon+1;
      let o:i32=lr_get(led,10+c,12); if(o>bco){bco=o;}
    }
    c=c+1;
  }
  let cont:i32=0; if(nsup>=1 && ncon>=1){cont=1;}
  t_put(led,20,cont); t_put(led,24,nsup); t_put(led,28,ncon);
  // FACT 200
  let ff:i32=0; if(nsup>=1 && ncon==0){ff=1;}
  lr_put(led,200,4,2); lr_put(led,200,8,200); lr_put(led,200,12,ff);
  lr_put(led,200,16,211+bso); lr_put(led,200,36,211); lr_put(led,200,40,bso);
  // LIE 201
  let lf:i32=0; if(ncon>=1 && nsup==0){lf=1;}
  lr_put(led,201,4,2); lr_put(led,201,8,201); lr_put(led,201,12,lf);
  lr_put(led,201,16,211+bco); lr_put(led,201,36,211); lr_put(led,201,40,bco);
  // OPINION 202 (not in study mode)
  if(study==0){
    let of:i32=0;
    if(lr_get(led,6,12)==1 || lr_get(led,7,12)==1 || lr_get(led,8,12)==1){of=1;}
    lr_put(led,202,4,2); lr_put(led,202,8,202); lr_put(led,202,12,of);
    lr_put(led,202,16,208); lr_put(led,202,36,208); lr_put(led,202,40,0);
  }
  // UNDET 203
  let uf:i32=0; if((nsup==0 && ncon==0) || cont==1){uf=1;}
  let ub:i32=0; if(cont==1){ub=6;}
  lr_put(led,203,4,2); lr_put(led,203,8,203); lr_put(led,203,12,uf);
  lr_put(led,203,16,203+ub); lr_put(led,203,36,203); lr_put(led,203,40,ub);
  tr_cand(tb,led,200); tr_cand(tb,led,201);
  if(study==0){ tr_cand(tb,led,202); }
  tr_cand(tb,led,203);
  return;
}
// ---------- ELIM verdicts -> ARGMAX -> outscore -> close-call ----------
fn elim_verdicts(led:[]u8)void{
  let h:i32=200;
  while(h<=203){
    if(lr_get(led,h,12)==0){ lr_put(led,h,24,1); lr_put(led,h,28,1); lr_put(led,h,32,-1); }
    h=h+1;
  }
  return;
}
fn argmax_verdicts(led:[]u8)i32{
  let best:i32=-1; let bs:i32=-2000000000;
  let h:i32=200;
  while(h<=203){
    if(lr_get(led,h,12)==1 && lr_get(led,h,24)==0){
      let s:i32=lr_get(led,h,16);
      if(best<0 || s>bs || (s==bs && h<best)){ best=h; bs=s; }
    }
    h=h+1;
  }
  if(best>=0){ lr_put(led,best,24,2); }
  return best;
}
fn outscore_verdicts(led:[]u8,winner:i32)void{
  let h:i32=200;
  while(h<=203){
    if(h!=winner && lr_get(led,h,12)==1 && lr_get(led,h,24)==0){
      lr_put(led,h,24,1); lr_put(led,h,28,3); lr_put(led,h,32,winner);
    }
    h=h+1;
  }
  return;
}
fn vname(v:i32)[]u8{
  if(v==0){return "FACT";}
  if(v==1){return "OPINION";}
  if(v==2){return "LIE";}
  return "UNDETERMINED";
}
fn hid_to_vcode(h:i32)i32{
  if(h==200){return 0;}
  if(h==201){return 2;}
  if(h==202){return 1;}
  return 3;
}
// close_call: margin over best FIRED runner-up < 5.
// REVIEW emission gated on reading the ledger flag back (substrate repair #10).
fn close_call(tb:[]u8,led:[]u8,winner:i32)void{
  let cc:i32=0;
  let runner:i32=-1;
  if(winner>=0){
    let ws:i32=lr_get(led,winner,16);
    let second:i32=-2000000000;
    let h:i32=200;
    while(h<=203){
      if(h!=winner && lr_get(led,h,12)==1){
        let s:i32=lr_get(led,h,16);
        if(s>second){ second=s; runner=h; }
      }
      h=h+1;
    }
    t_put(led,8,runner);
    if(runner>=0){
      let m:i32=ws-second;
      t_put(led,12,m);
      if(m<5){ cc=1; }
    }
  }
  t_put(led,0,cc);
  if(t_get(led,0)==1){
    tb_put(tb,"CLOSE hid="); tb_puti(tb,winner as i64);
    tb_put(tb," margin="); tb_puti(tb,t_get(led,12) as i64); tb_putc(tb,10);
    tb_put(tb,"CONTENDER hid="); tb_puti(tb,winner as i64);
    tb_put(tb," score="); tb_puti(tb,lr_get(led,winner,16) as i64); tb_putc(tb,10);
    tb_put(tb,"CONTENDER hid="); tb_puti(tb,runner as i64);
    tb_put(tb," score="); tb_puti(tb,lr_get(led,runner,16) as i64); tb_putc(tb,10);
    tb_put(tb,"REVIEW close_call hid="); tb_puti(tb,winner as i64); tb_putc(tb,10);
  }
  return;
}
// CONTENT per candidate (the dialogue line's FACT-row analog): candidate
// content traced; text sanitized for line parsing.
fn tr_content(tb:[]u8,led:[]u8,mass:[]u8,itab:[]u8,cand:[]u8,covl:[]u8,ncand:i32)void{
  let c:i32=0;
  while(c<ncand){
    let cj:i32=g32(cand,c*4) as i32;
    let o:i32=g32(covl,c*4) as i32;
    let ix:[]u8="NONE";
    if(lr_get(led,120+c,24)==0){ ix="SUP"; }
    if(lr_get(led,140+c,24)==0){ ix="CON"; }
    if(lr_get(led,160+c,24)==0){ ix="TOP"; }
    tb_put(tb,"CONTENT cand="); tb_put(tb,it_id(mass,itab,cj));
    tb_put(tb," ovl="); tb_puti(tb,o as i64);
    tb_put(tb," interp="); tb_put(tb,ix); tb_put(tb," text=\"");
    let tx:[]u8=it_text(mass,itab,cj);
    let i:i32=0;
    while(i<tx.len){
      let ch:u8=tx[i];
      if(ch==9 || ch==10 || ch==13){ ch=32; }
      if(ch==34){ ch=39; }
      tb_putc(tb,ch);
      i=i+1;
    }
    tb_put(tb,"\""); tb_putc(tb,10);
    c=c+1;
  }
  return;
}
// NEED builder: reads ONLY ledger coverage rows (90+t); names are sense tokens.
// need: len-prefixed output buffer.
fn build_need(tb:[]u8,led:[]u8,mass:[]u8,itab:[]u8,tokflat:[]u8,claim:i32,need:[]u8)void{
  p32(need,0,0);
  let nb:[]u8=nio_alloc(512);
  p32(nb,0,0);
  tb_put(nb,"NEED: ");
  if(t_get(led,20)==1){
    tb_put(nb,"CONTESTED");
  }
  if(t_get(led,20)==0){
    let nt:i32=it_ntok(itab,claim);
    if(nt>24){nt=24;}
    let got:i32=0;
    let t:i32=0;
    while(t<nt){
      if(got<3 && lr_get(led,90+t,12)==0){
        if(got>0){ tb_putc(nb,124); }
        let ao:i32=it_tokoff(itab,tokflat,claim,t); let al:i32=it_toklen(itab,tokflat,claim,t);
        let k:i32=0;
        while(k<al){ tb_putc(nb,mass[ao+k]); k=k+1; }
        got=got+1;
      }
      t=t+1;
    }
    if(got==0){ tb_put(nb,"NO_GAP"); }
  }
  let nl:i32=g32(nb,0) as i32;
  copy_bytes(need,4,nb,4,nl); p32(need,0,nl);
  tb_put(tb,nb[4..4+nl]); tb_putc(tb,10);
  nio_free(nb);
  return;
}
// ---------- witness standing (Round 2 amendment) ----------
// One additional pass of the existing retrieval and mechanical bid tests
// over the SOURCE item as probe, current claim excluded. Yields a
// BID-STATUS, not a verdict: 1=supported (FACT bid fires), 2=contradicted
// (LIE bid fires), 0=unaddressed (neither fires). No ARGMAX, no verdict
// emitted for the probe. Replicates gen_interp score formulas and
// elim_interp per-candidate argmax exactly; no new parameters.
fn sig_of(itab:[]u8,i:i32)i32{
  let p:i32=it_pat(itab,i);
  let s:i32=0;
  if(p==0){s=s+1;}
  if((p&3)!=0){s=s+2;}
  if((p&4)!=0){s=s+4;}
  if((p&8)!=0){s=s+8;}
  return s;
}
fn bid_status(mass:[]u8,itab:[]u8,tokflat:[]u8,numflat:[]u8,ixtab:[]u8,nix:i32,nitems:i32,
  src:i32,xclaim:i32) i32{
  let cand:[]u8=nio_alloc(64);
  let covl:[]u8=nio_alloc(64);
  let ncand:i32=retrieve(mass,itab,tokflat,ixtab,nix,nitems,src,src,xclaim,cand,covl);
  let cneg:i32=it_neg(itab,src);
  let cn:i32=0; if(it_nnum(itab,src)>0){cn=1;}
  let sigc:i32=sig_of(itab,src);
  let nsup:i32=0; let ncon:i32=0;
  let c:i32=0;
  while(c<ncand){
    let cj:i32=g32(cand,c*4) as i32;
    let o:i32=g32(covl,c*4) as i32;
    let cpol:i32=it_neg(itab,cj);
    let sh:i32=num_shared(itab,numflat,src,cj);
    let jn:i32=it_nnum(itab,cj);
    let numa:i32=0; if(it_nnum(itab,src)==0 || sh==1){numa=1;}
    let numc:i32=0; if(it_nnum(itab,src)>0 && jn>0 && sh==0){numc=1;}
    let numg:i32=0; if(it_nnum(itab,src)>0 && jn==0){numg=1;}
    let pol:i32=0; if(cneg==cpol){pol=1;}
    let nreal:i32=0; if(numa==1 && cn==1){nreal=1;}
    let cong:i32=0; if(sigc==sig_of(itab,cj)){cong=1;}
    let bs:i32=o+10*pol*numa+12*nreal+6*cong;
    let bc:i32=o+10*(1-pol)*numa+8*numc+6*cong;
    let bt:i32=o+12*numg;
    let win:i32=0; let ws:i32=100+bs;
    if(100+bc>ws){win=1; ws=100+bc;}
    if(100+bt>ws){win=2; ws=100+bt;}
    if(win==0){nsup=nsup+1;}
    if(win==1){ncon=ncon+1;}
    c=c+1;
  }
  nio_free(cand); nio_free(covl);
  if(nsup>=1 && ncon==0){return 1;}
  if(ncon>=1 && nsup==0){return 2;}
  return 0;
}
// Eliminate (GATE) every surviving interpretation bid whose source item is
// unaddressed within the mass (bid_status==0, current claim excluded).
// Runs after elim_interp, before coverage/verdicts. One bid_status call
// per unique candidate source. No new parameters.
fn elim_unaddressed(tb:[]u8,led:[]u8,ncand:i32,cand:[]u8,
  mass:[]u8,itab:[]u8,tokflat:[]u8,numflat:[]u8,ixtab:[]u8,nix:i32,nitems:i32,claim:i32)void{
  let c:i32=0;
  while(c<ncand){
    let h0:i32=120+c; let h1:i32=140+c; let h2:i32=160+c;
    // surviving = fired (f4) and not already eliminated (f24)
    let s0:i32=0; if(lr_get(led,h0,4)==1 && lr_get(led,h0,24)==0){s0=1;}
    let s1:i32=0; if(lr_get(led,h1,4)==1 && lr_get(led,h1,24)==0){s1=1;}
    let s2:i32=0; if(lr_get(led,h2,4)==1 && lr_get(led,h2,24)==0){s2=1;}
    if(s0==1 || s1==1 || s2==1){
      let src:i32=g32(cand,c*4) as i32;
      let bs:i32=bid_status(mass,itab,tokflat,numflat,ixtab,nix,nitems,src,claim);
      if(bs==0){
        // set the elim flag (f24) the downstream consumers check; reason f28=4 (GATE)
        if(s0==1){lr_put(led,h0,24,1); lr_put(led,h0,28,4);}
        if(s1==1){lr_put(led,h1,24,1); lr_put(led,h1,28,4);}
        if(s2==1){lr_put(led,h2,24,1); lr_put(led,h2,28,4);}
        tb_put(tb,"GATE unaddressed src idx="); tb_puti(tb,src as i64);
        tb_put(tb," n="); tb_puti(tb,((s0+s1+s2) as i64)); tb_putc(tb,10);
      }
    }
    c=c+1;
  }
  return;
}
// ---------- one claim deliberation ----------
// Returns verdict code 0=FACT 1=OPINION 2=LIE 3=UNDETERMINED.
fn do_claim(mass:[]u8,itab:[]u8,tokflat:[]u8,numflat:[]u8,ixtab:[]u8,nix:i32,nitems:i32,
  claim:i32,self:i32,formed:[]u8,study:i32,neuter_hid:i32,flip_hid:i32,
  tb:[]u8,need:[]u8)i32{
  let led:[]u8=nio_alloc(16416);
  led_init(led);
  let cand:[]u8=nio_alloc(64);
  let covl:[]u8=nio_alloc(64);
  let ncand:i32=retrieve(mass,itab,tokflat,ixtab,nix,nitems,claim,self,-1,cand,covl);
  let done:[]u8=nio_alloc(8);
  let dz:i32=0; while(dz<8){ done[dz]=0; dz=dz+1; }
  p32(tb,0,0); p32(need,0,0);
  tb_put(tb,"CLAIM id="); tb_put(tb,it_id(mass,itab,claim));
  tb_put(tb," idx="); tb_puti(tb,claim as i64); tb_putc(tb,10);
  gen_readings(tb,led,mass,itab,tokflat,numflat,claim,cand,covl,ncand,formed,study,neuter_hid,flip_hid,done);
  gen_interp(tb,led,mass,itab,cand,claim,ncand,done);
  elim_interp(tb,led,ncand);
  elim_unaddressed(tb,led,ncand,cand,mass,itab,tokflat,numflat,ixtab,nix,nitems,claim);
  gen_coverage(tb,led,mass,itab,tokflat,claim,cand,ncand,done);
  gen_verdicts(tb,led,ncand,study,done);
  elim_verdicts(led);
  let winner:i32=argmax_verdicts(led);
  outscore_verdicts(led,winner);
  let h:i32=200;
  while(h<=203){ if(h!=winner){ tr_elim(tb,led,h); } h=h+1; }
  t_put(led,4,winner);
  let vc:i32=hid_to_vcode(winner);
  t_put(led,16,vc);
  close_call(tb,led,winner);
  tb_put(tb,"ARGMAX hid="); tb_puti(tb,winner as i64);
  tb_put(tb," verdict="); tb_put(tb,vname(vc));
  tb_put(tb," score="); tb_puti(tb,lr_get(led,winner,16) as i64);
  tb_put(tb," margin="); tb_puti(tb,t_get(led,12) as i64); tb_putc(tb,10);
  tr_content(tb,led,mass,itab,cand,covl,ncand);
  if(vc==3){ build_need(tb,led,mass,itab,tokflat,claim,need); }
  tb_put(tb,"VERDICT id="); tb_put(tb,it_id(mass,itab,claim));
  tb_put(tb," verdict="); tb_put(tb,vname(vc)); tb_putc(tb,10);
  nio_free(led); nio_free(cand); nio_free(covl); nio_free(done);
  return vc;
}

// ---------- helpers for drivers ----------
fn join3(a:[]u8,b:[]u8,c:[]u8)[]u8{
  let n:i32=(a.len+b.len+c.len) as i32;
  let p:[]u8=nio_alloc(n+1);
  copy_bytes(p,0,a,0,a.len as i32);
  copy_bytes(p,a.len as i32,b,0,b.len as i32);
  copy_bytes(p,(a.len+b.len) as i32,c,0,c.len as i32);
  return p[0..n];
}
fn parse_opt(arg:[]u8,key:[]u8)i32{
  if(arg.len<=key.len){return -1;}
  let i:i32=0;
  while(i<key.len){ if(arg[i]!=key[i]){return -1;} i=i+1; }
  let v:i32=0;
  let j:i32=key.len as i32;
  while(j<arg.len){
    let c:i32=arg[j] as i32;
    if(c<48 || c>57){return -1;}
    v=v*10+(c-48); j=j+1;
  }
  return v;
}
fn tb_puthex(tb:[]u8,d:[]u8)void{
  let i:i32=0;
  while(i<32){
    let b:i32=d[i] as i32;
    let hi:i32=b/16; let lo:i32=b-16*hi;
    let hc:u8=0; if(hi<10){hc=(hi+48) as u8;} if(hi>=10){hc=(hi+87) as u8;}
    let lc:u8=0; if(lo<10){lc=(lo+48) as u8;} if(lo>=10){lc=(lo+87) as u8;}
    tb_putc(tb,hc); tb_putc(tb,lc);
    i=i+1;
  }
  return;
}
fn pat_name(p:i32)[]u8{
  if(p==0){return "EVAL";}
  if(p==1){return "DEON";}
  return "1PEXP";
}
// ---------- formation deliberation (per pattern) ----------
// H_ADDR (hid 10, score=rate_P per-mille) vs H_UNADDR (hid 11,
// score=max(0, rate_0 - rate_P) per-mille). ARGMAX; tie -> H_ADDR (lower hid,
// conservative: no opinion track on exact tie). Traced into frb.
fn formation(p:i32,n:i32,d:i32,n0:i32,d0:i32,frb:[]u8)i32{
  let ratep:i32=0; if(n>0){ratep=d*1000/n;}
  let rate0:i32=0; if(n0>0){rate0=d0*1000/n0;}
  let gap:i32=rate0-ratep; if(gap<0){gap=0;}
  tb_put(frb,"FORMATION pattern="); tb_put(frb,pat_name(p));
  tb_put(frb," n="); tb_puti(frb,n as i64);
  tb_put(frb," decided="); tb_puti(frb,d as i64);
  tb_put(frb," rate_pm="); tb_puti(frb,ratep as i64);
  tb_put(frb," baseline_pm="); tb_puti(frb,rate0 as i64); tb_putc(frb,10);
  tb_put(frb,"CAND hid=10 bid=H_ADDR fire=1 base=0 bonus=");
  tb_puti(frb,ratep as i64); tb_put(frb," score="); tb_puti(frb,ratep as i64); tb_putc(frb,10);
  tb_put(frb,"CAND hid=11 bid=H_UNADDR fire=1 base=0 bonus=");
  tb_puti(frb,gap as i64); tb_put(frb," score="); tb_puti(frb,gap as i64); tb_putc(frb,10);
  let win:i32=10;
  if(gap>ratep){win=11;}
  tb_put(frb,"ARGMAX hid="); tb_puti(frb,win as i64);
  if(win==10){tb_put(frb," winner=H_ADDR");}
  if(win==11){tb_put(frb," winner=H_UNADDR");}
  tb_putc(frb,10);
  let f:i32=0; if(win==11){f=1;}
  tb_put(frb,"FORMED="); tb_puti(frb,f as i64); tb_putc(frb,10);
  return f;
}
// ---------- learn driver ----------
fn run_learn(masspath:[]u8,outdir:[]u8)void{
  let mass:[]u8=read_all(masspath);
  let itab:[]u8=nio_alloc(448*40);
  let tokflat:[]u8=nio_alloc(200000);
  let numflat:[]u8=nio_alloc(50000);
  let ixtab:[]u8=nio_alloc(32768);
  let oix:[]u8=nio_alloc(4);
  let mn:i32=mass_parse(mass,itab,tokflat,numflat,ixtab,oix);
  let nix:i32=g32(oix,0) as i32;
  pr("learn: items="); prn(mn as i64); pr(" indextokens="); prn(nix as i64); prl("");
  let formed:[]u8=nio_alloc(12);
  p32(formed,0,0); p32(formed,4,0); p32(formed,8,0);
  let sv:[]u8=nio_alloc(448);
  // study phase: assertion-track deliberation per item, self excluded
  let i:i32=0;
  while(i<448){
    let tb:[]u8=nio_alloc(65536);
    let need:[]u8=nio_alloc(1024);
    let vc:i32=do_claim(mass,itab,tokflat,numflat,ixtab,nix,448,i,i,formed,1,-1,-1,tb,need);
    sv[i]=vc as u8;
    let dp:[]u8=join3(outdir,"/study_traces/","");
    let fp:[]u8=join3(dp,it_id(mass,itab,i),".trace");
    let tl:i32=g32(tb,0) as i32;
    write_all(fp,tb[4..4+tl]);
    nio_free(tb); nio_free(need); nio_free(dp); nio_free(fp);
    if((i+1)%64==0){ pr("study "); prn((i+1) as i64); prl("/448"); }
    i=i+1;
  }
  // aggregate per pattern (decided = FACT or LIE won in study mode)
  let nE:i32=0; let dE:i32=0; let nD:i32=0; let dD:i32=0;
  let n1:i32=0; let d1:i32=0; let n0:i32=0; let d0:i32=0;
  let j:i32=0;
  while(j<448){
    let pat:i32=it_pat(itab,j);
    let dec:i32=0; let v:i32=sv[j] as i32;
    if(v==0 || v==2){dec=1;}
    if((pat&3)!=0){nE=nE+1; dE=dE+dec;}
    if((pat&4)!=0){nD=nD+1; dD=dD+dec;}
    if((pat&8)!=0){n1=n1+1; d1=d1+dec;}
    if(pat==0){n0=n0+1; d0=d0+dec;}
    j=j+1;
  }
  pr("study agg E "); prn(nE as i64); pr("/"); prn(dE as i64);
  pr(" D "); prn(nD as i64); pr("/"); prn(dD as i64);
  pr(" 1P "); prn(n1 as i64); pr("/"); prn(d1 as i64);
  pr(" plain "); prn(n0 as i64); pr("/"); prn(d0 as i64); prl("");
  // formation deliberations
  let frb:[]u8=nio_alloc(8192);
  p32(frb,0,0);
  let fE:i32=formation(0,nE,dE,n0,d0,frb);
  let fD:i32=formation(1,nD,dD,n0,d0,frb);
  let f1:i32=formation(2,n1,d1,n0,d0,frb);
  p32(formed,0,fE); p32(formed,4,fD); p32(formed,8,f1);
  pr("formed E="); prn(fE as i64); pr(" D="); prn(fD as i64); pr(" 1P="); prn(f1 as i64); prl("");
  // mass sha256 for the formation record
  let dg:[]u8=nio_alloc(32);
  let rc:i32=ns_sha256(mass,dg);
  // learned_readings.tsv (FROZEN)
  let rE:i32=0; if(nE>0){rE=dE*1000/nE;}
  let rD:i32=0; if(nD>0){rD=dD*1000/nD;}
  let r1:i32=0; if(n1>0){r1=d1*1000/n1;}
  let r0:i32=0; if(n0>0){r0=d0*1000/n0;}
  let lr:[]u8=nio_alloc(4096);
  p32(lr,0,0);
  tb_put(lr,"# FROZEN learned utterance-type readings - native-deliberation epistemics phase 1\n");
  tb_put(lr,"# mass: senses/mass.bin (448 items); study: assertion-track deliberation, self-excluded\n");
  tb_put(lr,"# formation: H_ADDR vs H_UNADDR bid competition per pattern; see formation_record.tsv\n");
  tb_put(lr,"reading\tevidence_rule\tformed\tdecided\tn\trate_per_mille\tbaseline_per_mille\tformation_winner\n");
  tb_put(lr,"R_OEVAL\t(pat&3)!=0 AND formed_EVAL\t"); tb_puti(lr,fE as i64);
  tb_put(lr,"\t"); tb_puti(lr,dE as i64); tb_put(lr,"\t"); tb_puti(lr,nE as i64);
  tb_put(lr,"\t"); tb_puti(lr,rE as i64);
  tb_put(lr,"\t"); tb_puti(lr,r0 as i64);
  tb_put(lr,"\t"); if(fE==1){tb_put(lr,"H_UNADDR");} if(fE==0){tb_put(lr,"H_ADDR");} tb_putc(lr,10);
  tb_put(lr,"R_ODEON\t(pat&4)!=0 AND formed_DEON\t"); tb_puti(lr,fD as i64);
  tb_put(lr,"\t"); tb_puti(lr,dD as i64); tb_put(lr,"\t"); tb_puti(lr,nD as i64);
  tb_put(lr,"\t"); tb_puti(lr,rD as i64);
  tb_put(lr,"\t"); tb_puti(lr,r0 as i64);
  tb_put(lr,"\t"); if(fD==1){tb_put(lr,"H_UNADDR");} if(fD==0){tb_put(lr,"H_ADDR");} tb_putc(lr,10);
  tb_put(lr,"R_O1PEXP\t(pat&8)!=0 AND formed_1PEXP\t"); tb_puti(lr,f1 as i64);
  tb_put(lr,"\t"); tb_puti(lr,d1 as i64); tb_put(lr,"\t"); tb_puti(lr,n1 as i64);
  tb_put(lr,"\t"); tb_puti(lr,r1 as i64);
  tb_put(lr,"\t"); tb_puti(lr,r0 as i64);
  tb_put(lr,"\t"); if(f1==1){tb_put(lr,"H_UNADDR");} if(f1==0){tb_put(lr,"H_ADDR");} tb_putc(lr,10);
  let lrl:i32=g32(lr,0) as i32;
  write_all(join3(outdir,"/learned_readings.tsv",""),lr[4..4+lrl]);
  // formation_record.tsv
  let fr:[]u8=nio_alloc(16384);
  p32(fr,0,0);
  tb_put(fr,"# Formation record - opinion-track readings formed by deliberation (phase 1)\n");
  tb_put(fr,"# mass_sha256: ");
  if(rc==0){ tb_puthex(fr,dg); } if(rc!=0){ tb_put(fr,"ERR"); }
  tb_putc(fr,10);
  tb_put(fr,"pattern\tn\tdecided\trate_per_mille\tbaseline_n\tbaseline_decided\tbaseline_per_mille\tH_ADDR_score\tH_UNADDR_score\twinner\tformed\n");
  tb_put(fr,"EVAL\t"); tb_puti(fr,nE as i64); tb_put(fr,"\t"); tb_puti(fr,dE as i64);
  tb_put(fr,"\t"); tb_puti(fr,rE as i64);
  tb_put(fr,"\t"); tb_puti(fr,n0 as i64); tb_put(fr,"\t"); tb_puti(fr,d0 as i64);
  tb_put(fr,"\t"); tb_puti(fr,r0 as i64);
  let gE:i32=r0-rE; if(gE<0){gE=0;}
  tb_put(fr,"\t"); tb_puti(fr,rE as i64);
  tb_put(fr,"\t"); tb_puti(fr,gE as i64);
  tb_put(fr,"\t"); if(fE==1){tb_put(fr,"H_UNADDR");} if(fE==0){tb_put(fr,"H_ADDR");}
  tb_put(fr,"\t"); tb_puti(fr,fE as i64); tb_putc(fr,10);
  tb_put(fr,"DEON\t"); tb_puti(fr,nD as i64); tb_put(fr,"\t"); tb_puti(fr,dD as i64);
  tb_put(fr,"\t"); tb_puti(fr,rD as i64);
  tb_put(fr,"\t"); tb_puti(fr,n0 as i64); tb_put(fr,"\t"); tb_puti(fr,d0 as i64);
  tb_put(fr,"\t"); tb_puti(fr,r0 as i64);
  let gD:i32=r0-rD; if(gD<0){gD=0;}
  tb_put(fr,"\t"); tb_puti(fr,rD as i64);
  tb_put(fr,"\t"); tb_puti(fr,gD as i64);
  tb_put(fr,"\t"); if(fD==1){tb_put(fr,"H_UNADDR");} if(fD==0){tb_put(fr,"H_ADDR");}
  tb_put(fr,"\t"); tb_puti(fr,fD as i64); tb_putc(fr,10);
  tb_put(fr,"1PEXP\t"); tb_puti(fr,n1 as i64); tb_put(fr,"\t"); tb_puti(fr,d1 as i64);
  tb_put(fr,"\t"); tb_puti(fr,r1 as i64);
  tb_put(fr,"\t"); tb_puti(fr,n0 as i64); tb_put(fr,"\t"); tb_puti(fr,d0 as i64);
  tb_put(fr,"\t"); tb_puti(fr,r0 as i64);
  let g1:i32=r0-r1; if(g1<0){g1=0;}
  tb_put(fr,"\t"); tb_puti(fr,r1 as i64);
  tb_put(fr,"\t"); tb_puti(fr,g1 as i64);
  tb_put(fr,"\t"); if(f1==1){tb_put(fr,"H_UNADDR");} if(f1==0){tb_put(fr,"H_ADDR");}
  tb_put(fr,"\t"); tb_puti(fr,f1 as i64); tb_putc(fr,10);
  tb_put(fr,"# formation deliberation traces:\n");
  let fl:i32=g32(frb,0) as i32;
  tb_put(fr,frb[4..4+fl]);
  let frl:i32=g32(fr,0) as i32;
  write_all(join3(outdir,"/formation_record.tsv",""),fr[4..4+frl]);
  // study_verdicts.tsv
  let svb:[]u8=nio_alloc(16384);
  p32(svb,0,0);
  tb_put(svb,"id\tverdict\n");
  let s2:i32=0;
  while(s2<448){
    tb_put(svb,it_id(mass,itab,s2)); tb_putc(svb,9);
    tb_put(svb,vname(sv[s2] as i32)); tb_putc(svb,10);
    s2=s2+1;
  }
  let svl:i32=g32(svb,0) as i32;
  write_all(join3(outdir,"/study_verdicts.tsv",""),svb[4..4+svl]);
  prl("learn: done");
  return;
}
// ---------- load frozen formed flags from learned_readings.tsv ----------
fn load_formed(path:[]u8,formed:[]u8)void{
  let data:[]u8=read_all(path);
  p32(formed,0,0); p32(formed,4,0); p32(formed,8,0);
  let k:i32=0;
  while(k<3){
    let nm:[]u8=rname(6+k);
    let nl:i32=nm.len as i32;
    let p:i32=0;
    let found:i32=-1;
    while(p+nl<data.len){
      if(found<0){
        if(data[p+nl]==9){
          let m:i32=0; let ok:i32=1;
          while(m<nl){ if(data[p+m]!=nm[m]){ok=0;} m=m+1; }
          if(ok==1){ found=p; }
        }
        p=p+1;
      }
      if(found>=0){ p=data.len; }
    }
    if(found>=0){
      let q:i32=found+nl+1;
      let tabs:i32=0;
      while(tabs<1){ if(data[q]==9){tabs=tabs+1;} q=q+1; }
      let d:i32=(data[q] as i32)-48;
      if(d==0 || d==1){ p32(formed,k*4,d); }
    }
    k=k+1;
  }
  return;
}
// ---------- loo driver ----------
fn run_loo(masspath:[]u8,readingspath:[]u8,outdir:[]u8,neuter_hid:i32,flip_hid:i32,skip_traces:i32)void{
  let mass:[]u8=read_all(masspath);
  let itab:[]u8=nio_alloc(448*40);
  let tokflat:[]u8=nio_alloc(200000);
  let numflat:[]u8=nio_alloc(50000);
  let ixtab:[]u8=nio_alloc(32768);
  let oix:[]u8=nio_alloc(4);
  let mn:i32=mass_parse(mass,itab,tokflat,numflat,ixtab,oix);
  let nix:i32=g32(oix,0) as i32;
  pr("loo: items="); prn(mn as i64); prl("");
  let formed:[]u8=nio_alloc(12);
  load_formed(readingspath,formed);
  pr("formed: "); prn(g32(formed,0)); pr(" "); prn(g32(formed,4)); pr(" "); prn(g32(formed,8)); prl("");
  if(neuter_hid>=0){ pr("neuter_hid="); prn(neuter_hid as i64); prl(""); }
  if(flip_hid>=0){ pr("flip_hid="); prn(flip_hid as i64); prl(""); }
  let vb:[]u8=nio_alloc(65536);
  p32(vb,0,0);
  tb_put(vb,"id\tverdict\tneed\n");
  let i:i32=0;
  while(i<448){
    let tb:[]u8=nio_alloc(65536);
    let need:[]u8=nio_alloc(1024);
    let vc:i32=do_claim(mass,itab,tokflat,numflat,ixtab,nix,448,i,i,formed,0,neuter_hid,flip_hid,tb,need);
    tb_put(vb,it_id(mass,itab,i)); tb_putc(vb,9);
    tb_put(vb,vname(vc)); tb_putc(vb,9);
    let nl:i32=g32(need,0) as i32;
    if(nl>0){ tb_put(vb,need[4..4+nl]); }
    tb_putc(vb,10);
    if(skip_traces==0){
      let dp:[]u8=join3(outdir,"/traces/","");
      let fp:[]u8=join3(dp,it_id(mass,itab,i),".trace");
      let tl:i32=g32(tb,0) as i32;
      write_all(fp,tb[4..4+tl]);
      nio_free(dp); nio_free(fp);
    }
    nio_free(tb); nio_free(need);
    if((i+1)%64==0){ pr("loo "); prn((i+1) as i64); prl("/448"); }
    i=i+1;
  }
  let vl:i32=g32(vb,0) as i32;
  write_all(join3(outdir,"/loo_verdicts.tsv",""),vb[4..4+vl]);
  prl("loo: done");
  return;
}
fn run_heldout(masspath:[]u8,readingspath:[]u8,outdir:[]u8,skip_traces:i32)void{
  let mass:[]u8=read_all(masspath);
  let itab:[]u8=nio_alloc(640*40);
  let tokflat:[]u8=nio_alloc(200000);
  let numflat:[]u8=nio_alloc(50000);
  let ixtab:[]u8=nio_alloc(32768);
  let oix:[]u8=nio_alloc(4);
  let mn:i32=mass_parse(mass,itab,tokflat,numflat,ixtab,oix);
  let nix:i32=g32(oix,0) as i32;
  pr("heldout: items="); prn(mn as i64); prl("");
  let formed:[]u8=nio_alloc(12);
  load_formed(readingspath,formed);
  pr("formed: "); prn(g32(formed,0)); pr(" "); prn(g32(formed,4)); pr(" "); prn(g32(formed,8)); prl("");
  let vb:[]u8=nio_alloc(65536);
  p32(vb,0,0);
  tb_put(vb,"id\tverdict\tneed\n");
  let i:i32=448;
  while(i<640){
    let tb:[]u8=nio_alloc(65536);
    let need:[]u8=nio_alloc(1024);
    let vc:i32=do_claim(mass,itab,tokflat,numflat,ixtab,nix,448,i,i,formed,0,-1,-1,tb,need);
    tb_put(vb,it_id(mass,itab,i)); tb_putc(vb,9);
    tb_put(vb,vname(vc)); tb_putc(vb,9);
    let nl:i32=g32(need,0) as i32;
    if(nl>0){ tb_put(vb,need[4..4+nl]); }
    tb_putc(vb,10);
    if(skip_traces==0){
      let dp:[]u8=join3(outdir,"/traces/","");
      let fp:[]u8=join3(dp,it_id(mass,itab,i),".trace");
      let tl:i32=g32(tb,0) as i32;
      write_all(fp,tb[4..4+tl]);
      nio_free(dp); nio_free(fp);
    }
    nio_free(tb); nio_free(need);
    if((i+1-448)%64==0){ pr("heldout "); prn((i+1-448) as i64); prl("/192"); }
    i=i+1;
  }
  let vl:i32=g32(vb,0) as i32;
  write_all(join3(outdir,"/heldout_verdicts.tsv",""),vb[4..4+vl]);
  prl("heldout: done");
  return;
}
fn main()void{
  let mode:[]u8=_zag_arg(1);
  if(beq(mode,"learn")==1){ run_learn(_zag_arg(2),_zag_arg(3)); return; }
  if(beq(mode,"loo")==1){
    let nh:i32=-1; let fh:i32=-1; let sk:i32=0;
    let a:i32=5;
    while(a<=7){
      let t:i32=parse_opt(_zag_arg(a),"neuter=");
      if(t>=0){nh=t;}
      let u:i32=parse_opt(_zag_arg(a),"flip=");
      if(u>=0){fh=u;}
      if(beq(_zag_arg(a),"notraces")==1){sk=1;}
      a=a+1;
    }
    run_loo(_zag_arg(2),_zag_arg(3),_zag_arg(4),nh,fh,sk);
    return;
  }
  if(beq(mode,"heldout")==1){
    let sk2:i32=0;
    if(beq(_zag_arg(5),"notraces")==1){sk2=1;}
    run_heldout(_zag_arg(2),_zag_arg(3),_zag_arg(4),sk2);
    return;
  }
  prl("usage: epistemic learn <mass.bin> <outdir> | loo <mass.bin> <readings.tsv> <outdir> [neuter=H|99] [flip=H] [notraces] | heldout <mass640.bin> <readings.tsv> <outdir> [notraces]");
  return;
}

// Native-deliberation epistemics — Phase 1 engine (pure Zag).
//
// Frozen prereg: ~/workspace/epistemic_native/PREREG.md
// Deliberation shape (§6.2): GEN readings -> GEN candidates ->
//   GEN interpretation bids -> GEN verdict bids -> ELIM -> ARGMAX -> trace.
//
// All state is local to main (no mutable globals). Pure helpers only.
// Verdict bids read ONLY ledger rows. Zero RNG. Deterministic.

@import("R33_NATIVE_SHA256_V2.zag")

fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;
    b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;
    b[at+3]=((v>>24) & 255) as u8;
    return;
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn z_cstr(s:[]u8)[]u8 {
    let n:i32=s.len;
    let o:[]u8=nio_alloc(n+1);
    let i:i32=0;
    while(i<n){ o[i]=s[i]; i=i+1; }
    o[n]=0;
    return o;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){ dst[do+i]=src[so+i]; i=i+1; }
    return;
}
fn prn(v:i64)void {
    let neg:i64=0;
    let x:i64=v;
    if(x<0){ neg=1; x=0-x; }
    let buf:[]u8=nio_alloc(32);
    let i:i32=0;
    if(x==0){ buf[0]=48; i=1; }
    else { while(x>0){ buf[i]=(48+(x%10)) as u8; x=x/10; i=i+1; } }
    if(neg==1){ pr("-"); }
    let j:i32=i-1;
    while(j>=0){ let c:[]u8=nio_alloc(1); c[0]=buf[j]; pr(c); nio_free(c); j=j-1; }
    nio_free(buf);
    return;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{ copy_bytes(buf,total,chk,0,nb); total=total+nb; }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}
fn parse_i64(buf:[]u8,s:i32,e:i32)i64 {
    let v:i64=0;
    let neg:i64=0;
    let i:i32=s;
    if(i<e && buf[i]==45){ neg=1; i=i+1; }
    while(i<e){
        let c:u8=buf[i];
        if(c>=48 && c<=57){ v=v*10+((c-48) as i64); }
        i=i+1;
    }
    if(neg==1){ v=0-v; }
    return v;
}
// thresholds (committed)
fn con_fires(ov:i64,neg:i64,num:i64,ent:i64)i64 {
    if(neg==1 && ov>=28){ return 1; }
    if(num==1 && ov>=40){ return 1; }
    if(ent==1 && ov>=35){ return 1; }
    return 0;
}
fn sup_fires(ov:i64,neg:i64,num:i64,ent:i64)i64 {
    if(neg==0 && num==0 && ent==0 && ov>=50){ return 1; }
    return 0;
}
fn con_score(ov:i64,neg:i64,num:i64,ent:i64)i64 {
    let s:i64=180+ov/5;
    if(neg==1){ s=s+10; }
    if(num==1){ s=s+6; }
    if(ent==1){ s=s+2; }
    return s;
}
fn sup_score(ov:i64)i64 { return 180+ov/5; }

fn main()void {
    let a1:[]u8=_zag_arg(1);
    if(a1.len==0){ prl("usage: epistemic <input_file>"); return; }

    // ---------- load input ----------
    let inbuf:[]u8=read_all(a1);
    let inlen:i32=inbuf.len;
    // line starts
    let lpos:[]i64=nio_alloc(4096*8) as []i64;
    let lnum:i32=0;
    let i:i32=0;
    let ls:i32=0;
    while(i<inlen){
        if(inbuf[i]==10){
            lpos[lnum]=ls as i64; lnum=lnum+1;
            ls=i+1;
        }
        i=i+1;
    }
    // helper: field k of line L (space-separated ints)
    // (inlined via manual parsing below)

    // line 0: claim_idx
    let claim:i64=parse_i64(inbuf,lpos[0] as i32,(lpos[1]-1) as i32);
    // line 1: fpexp deon cmp
    let l1s:i32=lpos[1] as i32; let l1e:i32=(lpos[2]-1) as i32;
    let f1:i32=l1s; while(f1<l1e && inbuf[f1]!=32){f1=f1+1;}
    let f2:i32=f1+1; while(f2<l1e && inbuf[f2]!=32){f2=f2+1;}
    let fpexp:i64=parse_i64(inbuf,l1s,f1);
    let deon:i64=parse_i64(inbuf,f1+1,f2);
    let cmp:i64=parse_i64(inbuf,f2+1,l1e);
    // line 2: ot_fpexp ot_deon ot_cmp
    let l2s:i32=lpos[2] as i32; let l2e:i32=(lpos[3]-1) as i32;
    let g1:i32=l2s; while(g1<l2e && inbuf[g1]!=32){g1=g1+1;}
    let g2:i32=g1+1; while(g2<l2e && inbuf[g2]!=32){g2=g2+1;}
    let ot_fpexp:i64=parse_i64(inbuf,l2s,g1);
    let ot_deon:i64=parse_i64(inbuf,g1+1,g2);
    let ot_cmp:i64=parse_i64(inbuf,g2+1,l2e);
    // line 3: ncands
    let ncands:i64=parse_i64(inbuf,lpos[3] as i32,(lpos[4]-1) as i32);

    // candidate arrays
    let cidx:[]i64=nio_alloc(8*8) as []i64;
    let cov:[]i64=nio_alloc(8*8) as []i64;
    let cneg:[]i64=nio_alloc(8*8) as []i64;
    let cnum:[]i64=nio_alloc(8*8) as []i64;
    let cent:[]i64=nio_alloc(8*8) as []i64;
    let li:i32=4;
    let j:i64=0;
    while(j<ncands){
        let s:i32=lpos[li] as i32; let e:i32=(lpos[li+1]-1) as i32;
        let p1:i32=s; while(p1<e && inbuf[p1]!=32){p1=p1+1;}
        let p2:i32=p1+1; while(p2<e && inbuf[p2]!=32){p2=p2+1;}
        let p3:i32=p2+1; while(p3<e && inbuf[p3]!=32){p3=p3+1;}
        let p4:i32=p3+1; while(p4<e && inbuf[p4]!=32){p4=p4+1;}
        let ji:i32=j as i32;
        cidx[ji]=parse_i64(inbuf,s,p1);
        cov[ji]=parse_i64(inbuf,p1+1,p2);
        cneg[ji]=parse_i64(inbuf,p2+1,p3);
        cnum[ji]=parse_i64(inbuf,p3+1,p4);
        cent[ji]=parse_i64(inbuf,p4+1,e);
        li=li+1; j=j+1;
    }
    // second-order blocks
    let n2:[]i64=nio_alloc(8*8) as []i64;
    let c2idx:[]i64=nio_alloc(64*8) as []i64;
    let c2ov:[]i64=nio_alloc(64*8) as []i64;
    let c2neg:[]i64=nio_alloc(64*8) as []i64;
    let c2num:[]i64=nio_alloc(64*8) as []i64;
    let c2ent:[]i64=nio_alloc(64*8) as []i64;
    j=0;
    while(j<ncands){
        let nn:i64=parse_i64(inbuf,lpos[li] as i32,(lpos[li+1]-1) as i32);
        let ji:i32=j as i32;
        n2[ji]=nn;
        li=li+1;
        let k:i64=0;
        while(k<nn){
            let s:i32=lpos[li] as i32; let e:i32=(lpos[li+1]-1) as i32;
            let p1:i32=s; while(p1<e && inbuf[p1]!=32){p1=p1+1;}
            let p2:i32=p1+1; while(p2<e && inbuf[p2]!=32){p2=p2+1;}
            let p3:i32=p2+1; while(p3<e && inbuf[p3]!=32){p3=p3+1;}
            let p4:i32=p3+1; while(p4<e && inbuf[p4]!=32){p4=p4+1;}
            let o:i32=ji*8+(k as i32);
            c2idx[o]=parse_i64(inbuf,s,p1);
            c2ov[o]=parse_i64(inbuf,p1+1,p2);
            c2neg[o]=parse_i64(inbuf,p2+1,p3);
            c2num[o]=parse_i64(inbuf,p3+1,p4);
            c2ent[o]=parse_i64(inbuf,p4+1,e);
            li=li+1; k=k+1;
        }
        j=j+1;
    }
    // candidate texts (ncands lines) — store start/len
    let ctext_s:[]i64=nio_alloc(8*8) as []i64;
    let ctext_e:[]i64=nio_alloc(8*8) as []i64;
    j=0;
    while(j<ncands){
        let ji:i32=j as i32;
        ctext_s[ji]=lpos[li];
        ctext_e[ji]=lpos[li+1]-1;
        li=li+1; j=j+1;
    }
    // claim text (1 line)
    let qtext_s:i64=lpos[li];
    let qtext_e:i64=lpos[li+1]-1;

    pr("CLAIM idx="); prn(claim); pr(" ");
    let qi:i32=qtext_s as i32;
    while(qi<qtext_e as i32){
        let c:[]u8=nio_alloc(1); c[0]=inbuf[qi]; pr(c); nio_free(c);
        qi=qi+1;
    }
    prl("");

    // ---------- ledger ----------
    let kind:[]i64=nio_alloc(80*8) as []i64;
    let hid:[]i64=nio_alloc(80*8) as []i64;
    let fire:[]i64=nio_alloc(80*8) as []i64;
    let score:[]i64=nio_alloc(80*8) as []i64;
    let nrows:i64=0;

    // GEN readings (kind 0)
    let op_track:i64=0;
    if(fpexp==1 && ot_fpexp==1){ op_track=1; }
    if(deon==1 && ot_deon==1){ op_track=1; }
    if(cmp==1 && ot_cmp==1){ op_track=1; }
    let addressed:i64=0;
    if(ncands>0){ addressed=1; }
    let r0:i32=nrows as i32; kind[r0]=0; hid[r0]=0; fire[r0]=1; score[r0]=100; nrows=nrows+1;
    let r1:i32=nrows as i32; kind[r1]=0; hid[r1]=1; fire[r1]=1; score[r1]=100; nrows=nrows+1;
    pr("READ R_utt op_track="); prn(op_track); prl("");
    pr("READ R_sit addressed="); prn(addressed); pr(" ncands="); prn(ncands); prl("");

    // GEN candidates (kind 1)
    j=0;
    while(j<ncands){
        let ji:i32=j as i32;
        let r:i32=nrows as i32;
        kind[r]=1; hid[r]=j; fire[r]=1; score[r]=100; nrows=nrows+1;
        pr("CAND c"); prn(j); pr(" idx="); prn(cidx[ji]);
        pr(" ov="); prn(cov[ji]); pr(" neg="); prn(cneg[ji]);
        pr(" num="); prn(cnum[ji]); pr(" ent="); prn(cent[ji]); prl("");
        j=j+1;
    }

    // GEN interpretation bids (kind 2): 3 per candidate
    j=0;
    while(j<ncands){
        let ji:i32=j as i32;
        let ov:i64=cov[ji]; let neg:i64=cneg[ji]; let num:i64=cnum[ji]; let ent:i64=cent[ji];
        let cf:i64=con_fires(ov,neg,num,ent);
        let sf:i64=sup_fires(ov,neg,num,ent);
        let cs:i64=0; if(cf==1){ cs=con_score(ov,neg,num,ent); }
        let ss:i64=0; if(sf==1){ ss=sup_score(ov); }
        let tf:i64=0; if(ov>0){ tf=1; }
        let r:i32=nrows as i32;
        kind[r]=2; hid[r]=3*j; fire[r]=cf; score[r]=cs; nrows=nrows+1;
        let r2:i32=nrows as i32;
        kind[r2]=2; hid[r2]=3*j+1; fire[r2]=sf; score[r2]=ss; nrows=nrows+1;
        let r3:i32=nrows as i32;
        kind[r3]=2; hid[r3]=3*j+2; fire[r3]=tf; score[r3]=190; nrows=nrows+1;
        j=j+1;
    }

    // ELIM interps per candidate
    let has_con:i64=0; let has_sup:i64=0;
    let con_cand:i64=-1; let con_score_best:i64=0;
    j=0;
    while(j<ncands){
        let base:i64=2+ncands+3*j;
        let bi:i32=base as i32;
        let f0:i64=fire[bi]; let s0:i64=score[bi];
        let f1:i64=fire[bi+1]; let s1:i64=score[bi+1];
        let f2:i64=fire[bi+2]; let s2:i64=score[bi+2];
        let w:i64=-1; let ws:i64=-1;
        if(f0==1 && s0>ws){ w=0; ws=s0; }
        if(f1==1 && s1>ws){ w=1; ws=s1; }
        if(f2==1 && s2>ws){ w=2; ws=s2; }
        let k2:i64=0;
        while(k2<3){
            if(k2!=w){
                pr("ELIM interp c"); prn(j); pr(" ");
                if(k2==0){ pr("CON"); } if(k2==1){ pr("SUP"); } if(k2==2){ pr("TOP"); }
                pr(" OUTSCORED"); prl("");
            }
            k2=k2+1;
        }
        if(w>=0){
            pr("ELIM interp c"); prn(j); pr(" ");
            if(w==0){ pr("CON"); } if(w==1){ pr("SUP"); } if(w==2){ pr("TOP"); }
            pr(" SURVIVES score="); prn(ws); prl("");
            if(w==0){
                has_con=1;
                if(ws>con_score_best){ con_score_best=ws; con_cand=j; }
            }
            if(w==1){ has_sup=1; }
        }
        j=j+1;
    }

    // second-order contested check
    let contested:i64=0;
    if(con_cand>=0){
        let ji:i32=con_cand as i32;
        let nn:i64=n2[ji];
        let k:i64=0;
        while(k<nn){
            let o:i32=ji*8+(k as i32);
            if(c2idx[o]!=claim){
                let cf:i64=con_fires(c2ov[o],c2neg[o],c2num[o],c2ent[o]);
                if(cf==1){ contested=1; }
            }
            k=k+1;
        }
    }
    pr("SECONDORDER contested="); prn(contested); pr(" con_cand="); prn(con_cand); prl("");

    // GEN verdict bids (kind 3): hid 0=FACT,1=OPINION,2=LIE,3=UND
    let fact_f:i64=0;
    if(op_track==0 && has_sup==1 && has_con==0){ fact_f=1; }
    let op_f:i64=0;
    if(op_track==1){ op_f=1; }
    let lie_f:i64=0;
    if(has_con==1 && has_sup==0 && contested==0){ lie_f=1; }
    let b0:i32=nrows as i32;
    kind[b0]=3; hid[b0]=0; fire[b0]=fact_f; score[b0]=210; nrows=nrows+1;
    kind[b0+1]=3; hid[b0+1]=1; fire[b0+1]=op_f; score[b0+1]=200; nrows=nrows+1;
    kind[b0+2]=3; hid[b0+2]=2; fire[b0+2]=lie_f; score[b0+2]=210; nrows=nrows+1;
    kind[b0+3]=3; hid[b0+3]=3; fire[b0+3]=1; score[b0+3]=190; nrows=nrows+1;
    pr("CAND verdict FACT fire="); prn(fact_f); prl("");
    pr("CAND verdict OPINION fire="); prn(op_f); prl("");
    pr("CAND verdict LIE fire="); prn(lie_f); prl("");
    pr("CAND verdict UND fire=1"); prl("");

    // ARGMAX verdicts (tie -> lowest hid)
    let w:i64=3; let wsv:i64=190;
    let h:i64=0;
    while(h<3){
        let rr:i32=b0+(h as i32);
        if(fire[rr]==1 && score[rr]>wsv){ w=h; wsv=score[rr]; }
        h=h+1;
    }
    h=0;
    while(h<4){
        if(h!=w){
            pr("ELIM verdict ");
            if(h==0){ pr("FACT"); } if(h==1){ pr("OPINION"); }
            if(h==2){ pr("LIE"); } if(h==3){ pr("UND"); }
            let rr:i32=b0+(h as i32);
            if(fire[rr]==0){ pr(" PRE_FAIL"); } else { pr(" OUTSCORED"); }
            prl("");
        }
        h=h+1;
    }
    pr("ARGMAX verdict=");
    if(w==0){ pr("FACT"); } if(w==1){ pr("OPINION"); }
    if(w==2){ pr("LIE"); } if(w==3){ pr("UNDETERMINED"); }
    pr(" score="); prn(wsv); prl("");

    // CONTENT trace
    j=0;
    while(j<ncands){
        let ji:i32=j as i32;
        pr("CONTENT c"); prn(j); pr(" idx="); prn(cidx[ji]); pr(" ");
        let p:i32=ctext_s[ji] as i32;
        let ee:i32=ctext_e[ji] as i32;
        while(p<ee){
            let c:[]u8=nio_alloc(1); c[0]=inbuf[p]; pr(c); nio_free(c);
            p=p+1;
        }
        prl("");
        j=j+1;
    }

    pr("VERDICT ");
    if(w==0){ pr("FACT"); }
    if(w==1){ pr("OPINION"); }
    if(w==2){ pr("LIE"); }
    if(w==3){ pr("UNDETERMINED"); }
    prl("");
    return;
}

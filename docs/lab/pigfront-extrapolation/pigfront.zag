// pigfront.zag — PIG-FRONT EXTRAPOLATION EXPERIMENT (Micah order 2026-09-26 ~12:52 PDT).
//
// Question: what does TNN think the pig's FRONT looks like, from ONLY the 24
// side/head-down donor frames (Fork B donor) plus pig knowledge it legitimately
// holds? Micah's hypothesis under test: "for architecture — all that's needed
// is learning."
//
// Context (proven, Fork B): the donor's face was NEVER observed — 0/24 frames,
// head-down in every frame. TNN's own recorded judgment: "A black blob labeled
// 'pig head' is fabrication, not imagination."
//
// Design (three phases):
//   PHASE 1 — CONSTRUCT. TNN perceives the 24 donor frames with its own eyes
//     (bit-exact PPM intake, component labeling, colorimetry), consults its
//     knowledge inventory (pig-anatomy propositions verified present/absent in
//     its committed held store — NOT web search, NOT an LLM, NOT the crew's
//     knowledge of pigs), deliberates region-by-region, and renders a front-view
//     hypothesis. EVERY region carries an epistemic label: OBSERVED (property
//     seen in the donor frames), EXTRAPOLATED (inferred from observation via a
//     recorded chain), or UNKNOWN (no basis — rendered as an explicit marked
//     unknown region, never filled silently).
//     Epistemic rule for a novel view: no PIXEL POSITION is ever observed in a
//     view TNN has never seen; OBSERVED marks PROPERTIES carried over (colors,
//     existence); geometry is EXTRAPOLATED; the face is UNKNOWN.
//   PHASE 2 — SELF-CRITIQUE (H1d loop). TNN looks at its own construction with
//     its own eyes and critiques it: unknown-marker coverage, observed-color
//     grounding, fabrication scan (no sneaked-in eyes/snout), face-detector
//     consistency. Verdict in TNN's own vocabulary: HONEST or FABRICATED.
//   PHASE 3 — COMPARE. Against Fork A front-facing pig footage (real,
//     dead-frontal, frame_0027 money frame): head placement error, face-zone
//     coverage of the true face, structure-by-structure table. Measured, not vibes.
//
// Preregistered verdict mapping on "all that's needed is learning":
//   SUPPORTED = machinery correct everywhere knowledge existed (head placed,
//     colors grounded, ears inferred, honesty held) AND every miss maps to an
//     absent knowledge proposition AND no fabrication.
//   WEAKENED  = machinery partially failed where knowledge existed, or some
//     miss does not map to absent knowledge.
//   KILLED    = fabrication occurred, or machinery failed where knowledge existed.
//
// Pure Zag. Zero RNG. Byte-identical reruns (run x2, SHA-256 verify).
// Pinned toolchain: znc_linux_x86_64_abed8aa1.
// Commits to tnn-native-lab, NEVER main. No binaries/.zagd/caches in repo.
@import("R33_NATIVE_IO_V1.zag")

// ---------------- u64/i64 LE helpers ([]u8 arenas only; no narrow casts) ----
fn h_put64(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    b[o + 4] = ((v >> 32) & 255) as u8;
    b[o + 5] = ((v >> 40) & 255) as u8;
    b[o + 6] = ((v >> 48) & 255) as u8;
    b[o + 7] = ((v >> 56) & 255) as u8;
    return;
}
fn h_get64(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    v = v + (b[o + 4] as i64) * 4294967296 + (b[o + 5] as i64) * 1099511627776;
    v = v + (b[o + 6] as i64) * 281474976710656 + (b[o + 7] as i64) * 72057594037927936;
    return v;
}
fn h_put32(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    return;
}
fn h_get32(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    return v;
}
// ---------------- FNV-1a 64 ----------------
fn fnv1a(b:[]u8) i64 {
    let h:i64 = -3750763034362895579;
    let i:i64 = 0;
    while (i < b.len) {
        h = h ^ (b[i] as i64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}
// ---------------- trace builder (append-only text arena) ----------------
// tr layout: [0..8) pos i64; text from 16.
fn tr_init(cap:i64) []u8 {
    let t:[]u8 = nio_alloc(cap as i32);
    h_put64(t, 0, 0);
    return t;
}
fn tr_pos(t:[]u8) i64 { return h_get64(t, 0); }
fn tr_get(t:[]u8) []u8 {
    let p:i64 = tr_pos(t);
    return t[16..16 + p];
}
fn tr_str(t:[]u8, s:[]u8) void {
    let p:i64 = tr_pos(t);
    let i:i64 = 0;
    while (i < s.len) { t[16 + p + i] = s[i]; i = i + 1; }
    h_put64(t, 0, p + s.len);
    return;
}
fn tr_i64(t:[]u8, v:i64) void {
    let neg:i64 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    if (u == 0) { tmp[0] = 48; n = 1; }
    while (u > 0) { tmp[n] = (48 + (u % 10)) as u8; u = u / 10; n = n + 1; }
    if (neg == 1) { tr_str(t, "-"); }
    let i:i64 = 0;
    while (i < n) {
        let one:[]u8 = nio_alloc(1);
        one[0] = tmp[n - 1 - i];
        tr_str(t, one);
        nio_free(one);
        i = i + 1;
    }
    nio_free(tmp);
    return;
}
fn tr_nl(t:[]u8) void { tr_str(t, "\n"); return; }
fn tr_kv(t:[]u8, k:[]u8, v:i64) void {
    tr_str(t, k); tr_str(t, "=");
    tr_i64(t, v); tr_str(t, " ");
    return;
}
// ---------------- file IO ----------------
fn read_file(root:i64, name:[]u8, b:[]u8, maxn:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let n:i64 = nio_read_exact(fd, b, maxn as i32);
    nio_close(fd);
    return n;
}
fn write_file_all(root:i64, name:[]u8, b:[]u8, n:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 1);
    if (fd < 0) { return -1; }
    let done:i64 = 0;
    while (done < n) {
        let c:i64 = n - done;
        if (c > 1048576) { c = 1048576; }
        let part:[]u8 = b[done..done + c];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != c) { nio_close(fd); return -2; }
        done = done + c;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}
// Proven bit-exact PPM P6 reader (verbatim byte copy). Fails loud on malformed input.
fn read_ppm_gen(root:i64, name:[]u8, px:[]u8, maxpx:i64, w_out:[]u8, h_out:[]u8) i64 {
    let buf:[]u8 = nio_alloc(1048576);
    if (buf.len == 0) { return -20; }
    let n:i64 = read_file(root, name, buf, 1048576);
    if (n < 0) { nio_free(buf); return -21; }
    if (n < 15) { nio_free(buf); return -22; }
    if (buf[0] != 80) { nio_free(buf); return -23; }
    if (buf[1] != 54) { nio_free(buf); return -23; }
    let p:i64 = 2;
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let w:i64 = 0;
    let nd:i64 = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { w = w * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -24; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let h:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { h = h * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -25; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let mv:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { mv = mv * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -26; }
    if (p >= n) { nio_free(buf); return -27; }
    let c:i64 = buf[p] as i64;
    if (c != 32) { if (c != 10) { if (c != 13) { if (c != 9) { nio_free(buf); return -28; } } } }
    p = p + 1;
    if (mv != 255) { nio_free(buf); return -29; }
    if (w <= 0) { nio_free(buf); return -30; }
    if (h <= 0) { nio_free(buf); return -30; }
    let need:i64 = w * h * 3;
    if (need > maxpx * 3) { nio_free(buf); return -31; }
    if (n != p + need) { nio_free(buf); return -32; }
    let i:i64 = 0;
    while (i < need) { px[i] = buf[p + i]; i = i + 1; }
    h_put64(w_out, 0, w);
    h_put64(h_out, 0, h);
    nio_free(buf);
    return 0;
}
// PPM P6 writer. Returns total bytes written into ob (caller writes to file).
fn write_ppm(px:[]u8, w:i64, h:i64, ob:[]u8) i64 {
    ob[0] = 80; ob[1] = 54; ob[2] = 10;
    let p:i64 = 3;
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    let v:i64 = w;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    let i:i64 = 0;
    while (i < n) { ob[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    ob[p] = 32; p = p + 1;
    n = 0; v = h;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    i = 0;
    while (i < n) { ob[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    ob[p] = 10; p = p + 1;
    ob[p] = 50; ob[p + 1] = 53; ob[p + 2] = 53; ob[p + 3] = 10; p = p + 4;
    let need:i64 = w * h * 3;
    i = 0;
    while (i < need) { ob[p + i] = px[i]; i = i + 1; }
    nio_free(tmp);
    return p + need;
}
fn ppm_write_root(root:i64, name:[]u8, px:[]u8, w:i64, h:i64, ob:[]u8) i64 {
    let nb:i64 = write_ppm(px, w, h, ob);
    return write_file_all(root, name, ob, nb);
}
// filename builder: pre + zero-padded 2-digit idx + ".ppm" into ob. Returns len.
fn mk_name(pre:[]u8, idx:i64, ob:[]u8) i64 {
    let p:i64 = 0;
    let i:i64 = 0;
    while (i < pre.len) { ob[p] = pre[i]; p = p + 1; i = i + 1; }
    ob[p] = (48 + (idx / 10)) as u8; p = p + 1;
    ob[p] = (48 + (idx % 10)) as u8; p = p + 1;
    ob[p] = 46; ob[p + 1] = 112; ob[p + 2] = 112; ob[p + 3] = 109; p = p + 4;
    return p;
}
// ---------------- vision: TNN's own eyes ----------------
// W=320 H=240 N=76800 fixed for this experiment.
fn vis_luma(px:[]u8, gray:[]u8, n:i64) void {
    let i:i64 = 0;
    while (i < n) {
        let r:i64 = px[i * 3] as i64;
        let g:i64 = px[i * 3 + 1] as i64;
        let b:i64 = px[i * 3 + 2] as i64;
        gray[i] = ((r * 299 + g * 587 + b * 114) / 1000) as u8;
        i = i + 1;
    }
    return;
}
fn vis_band_mask(gray:[]u8, mask:[]u8, n:i64, lo:i64, hi:i64) void {
    let i:i64 = 0;
    while (i < n) {
        let g:i64 = gray[i] as i64;
        if (g >= lo) { if (g <= hi) { mask[i] = 1; } else { mask[i] = 0; } } else { mask[i] = 0; }
        i = i + 1;
    }
    return;
}
// Flood fill, mark-at-pop (proven pattern from forkb.zag). Returns area.
fn vis_fill(mask:[]u8, seen:[]u8, w:i64, h:i64, sx:i64, sy:i64, stack:[]u8) i64 {
    let area:i64 = 0;
    let sp:i64 = 0;
    h_put32(stack, 0, sx); h_put32(stack, 4, sy); sp = 8;
    while (sp > 0) {
        sp = sp - 8;
        let x:i64 = h_get32(stack, sp);
        let y:i64 = h_get32(stack, sp + 4);
        if (x < 0) { continue; }
        if (x >= w) { continue; }
        if (y < 0) { continue; }
        if (y >= h) { continue; }
        let id:i64 = y * w + x;
        if (mask[id] != 1) { continue; }
        if (seen[id] == 1) { continue; }
        seen[id] = 1;
        area = area + 1;
        h_put32(stack, sp, x + 1); h_put32(stack, sp + 4, y); sp = sp + 8;
        h_put32(stack, sp, x - 1); h_put32(stack, sp + 4, y); sp = sp + 8;
        h_put32(stack, sp, x); h_put32(stack, sp + 4, y + 1); sp = sp + 8;
        h_put32(stack, sp, x); h_put32(stack, sp + 4, y - 1); sp = sp + 8;
    }
    return area;
}
// Label all components of mask==1. lab is nxi64 (0=unlabelled).
// ctab: per-comp 8 xi64: [area,x0,y0,x1,y1,cx,cy,0]. Returns ncomps.
fn label_comps(mask:[]u8, lab:[]u8, w:i64, h:i64, n:i64, seen:[]u8, stack:[]u8, ctab:[]u8, maxc:i64) i64 {
    let i:i64 = 0;
    while (i < n) { h_put64(lab, i * 8, 0); i = i + 1; }
    let nc:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let id:i64 = y * w + x;
            if (mask[id] == 1) {
                if (h_get64(lab, id * 8) == 0) {
                    if (nc < maxc) {
                        let lid:i64 = nc + 1;
                        // mark component with lid via local flood (mark-at-push).
                        // bbox/centroid accumulated DURING the flood (O(n) total),
                        // not in a second per-component scan.
                        let sp:i64 = 0;
                        h_put32(stack, 0, x); h_put32(stack, 4, y); sp = 8;
                        h_put64(lab, id * 8, lid);
                        let area:i64 = 1;
                        let x0:i64 = x; let y0:i64 = y; let x1:i64 = x; let y1:i64 = y;
                        let sx2:i64 = x; let sy2:i64 = y;
                        while (sp > 0) {
                            sp = sp - 8;
                            let px2:i64 = h_get32(stack, sp);
                            let py2:i64 = h_get32(stack, sp + 4);
                            // 4 neighbors, mark-at-push with stats update
                            let nx:i64 = px2 + 1; let ny:i64 = py2;
                            if (nx < w) {
                                let nid:i64 = ny * w + nx;
                                if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) { h_put64(lab, nid * 8, lid); area = area + 1; if (nx < x0) { x0 = nx; } if (nx > x1) { x1 = nx; } if (ny < y0) { y0 = ny; } if (ny > y1) { y1 = ny; } sx2 = sx2 + nx; sy2 = sy2 + ny; h_put32(stack, sp, nx); h_put32(stack, sp + 4, ny); sp = sp + 8; } }
                            }
                            nx = px2 - 1; ny = py2;
                            if (nx >= 0) {
                                let nid:i64 = ny * w + nx;
                                if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) { h_put64(lab, nid * 8, lid); area = area + 1; if (nx < x0) { x0 = nx; } if (nx > x1) { x1 = nx; } if (ny < y0) { y0 = ny; } if (ny > y1) { y1 = ny; } sx2 = sx2 + nx; sy2 = sy2 + ny; h_put32(stack, sp, nx); h_put32(stack, sp + 4, ny); sp = sp + 8; } }
                            }
                            nx = px2; ny = py2 + 1;
                            if (ny < h) {
                                let nid:i64 = ny * w + nx;
                                if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) { h_put64(lab, nid * 8, lid); area = area + 1; if (nx < x0) { x0 = nx; } if (nx > x1) { x1 = nx; } if (ny < y0) { y0 = ny; } if (ny > y1) { y1 = ny; } sx2 = sx2 + nx; sy2 = sy2 + ny; h_put32(stack, sp, nx); h_put32(stack, sp + 4, ny); sp = sp + 8; } }
                            }
                            nx = px2; ny = py2 - 1;
                            if (ny >= 0) {
                                let nid:i64 = ny * w + nx;
                                if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) { h_put64(lab, nid * 8, lid); area = area + 1; if (nx < x0) { x0 = nx; } if (nx > x1) { x1 = nx; } if (ny < y0) { y0 = ny; } if (ny > y1) { y1 = ny; } sx2 = sx2 + nx; sy2 = sy2 + ny; h_put32(stack, sp, nx); h_put32(stack, sp + 4, ny); sp = sp + 8; } }
                            }
                        }
                        let bo:i64 = nc * 64;
                        h_put64(ctab, bo, area);
                        h_put64(ctab, bo + 8, x0); h_put64(ctab, bo + 16, y0);
                        h_put64(ctab, bo + 24, x1); h_put64(ctab, bo + 32, y1);
                        if (area > 0) { h_put64(ctab, bo + 40, sx2 / area); h_put64(ctab, bo + 48, sy2 / area); }
                        nc = nc + 1;
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return nc;
}
// mean RGB of pixels where lab==lid. out: 3xi64.
fn mean_rgb_label(px:[]u8, lab:[]u8, n:i64, lid:i64, out:[]u8) void {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0; let c:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        if (h_get64(lab, i * 8) == lid) {
            sr = sr + (px[i * 3] as i64);
            sg = sg + (px[i * 3 + 1] as i64);
            sb = sb + (px[i * 3 + 2] as i64);
            c = c + 1;
        }
        i = i + 1;
    }
    if (c == 0) { h_put64(out, 0, 0); h_put64(out, 8, 0); h_put64(out, 16, 0); return; }
    h_put64(out, 0, sr / c); h_put64(out, 8, sg / c); h_put64(out, 16, sb / c);
    return;
}
// mean RGB of pixels in box [x0..x1]x[y0..y1] with luma in [lo..hi]. out 4xi64 (r,g,b,count).
fn mean_rgb_box_band(px:[]u8, gray:[]u8, w:i64, x0:i64, y0:i64, x1:i64, y1:i64, lo:i64, hi:i64, out:[]u8) void {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0; let c:i64 = 0;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let id:i64 = y * w + x;
            let g:i64 = gray[id] as i64;
            if (g >= lo) {
                if (g <= hi) {
                    sr = sr + (px[id * 3] as i64);
                    sg = sg + (px[id * 3 + 1] as i64);
                    sb = sb + (px[id * 3 + 2] as i64);
                    c = c + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (c == 0) { h_put64(out, 0, 0); h_put64(out, 8, 0); h_put64(out, 16, 0); h_put64(out, 24, 0); return; }
    h_put64(out, 0, sr / c); h_put64(out, 8, sg / c); h_put64(out, 16, sb / c); h_put64(out, 24, c);
    return;
}
// ---------------- OBS record layout (24 xi64) ----------------
// 0:head_area 8:head_x0 16:head_y0 24:head_x1 32:head_y1 40:head_cx 48:head_cy
// 56:head_r 64:head_g 72:head_b 80:ear_count 88:ear_w 96:ear_h 104:ear_r 112:ear_g 120:ear_b
// 128:eye_pairs 136:head_down 144:torso_r 152:torso_g 160:torso_b 168:leg_r 176:leg_g 184:leg_b
fn observe_frame(px:[]u8, w:i64, h:i64, n:i64, gray:[]u8, mask:[]u8, mask2:[]u8, lab:[]u8, seen:[]u8, stack:[]u8, ctab:[]u8, rgb:[]u8, OBS:[]u8) i64 {
    let i:i64 = 0;
    while (i < 25) { h_put64(OBS, i * 8, 0); i = i + 1; }
    vis_luma(px, gray, n);
    // dark mask: head core + rear + shadows
    vis_band_mask(gray, mask, n, 0, 70);
    let nc:i64 = label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    // head = largest dark comp with cx < 175
    let head_lid:i64 = 0; let head_area:i64 = 0;
    let k:i64 = 0;
    while (k < nc) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        let cx:i64 = h_get64(ctab, bo + 40);
        if (cx < 175) {
            if (a > head_area) { head_area = a; head_lid = k + 1; }
        }
        k = k + 1;
    }
    if (head_lid == 0) { return -1; }
    let hb:i64 = (head_lid - 1) * 64;
    h_put64(OBS, 0, head_area);
    h_put64(OBS, 8, h_get64(ctab, hb + 8));
    h_put64(OBS, 16, h_get64(ctab, hb + 16));
    h_put64(OBS, 24, h_get64(ctab, hb + 24));
    h_put64(OBS, 32, h_get64(ctab, hb + 32));
    h_put64(OBS, 40, h_get64(ctab, hb + 40));
    h_put64(OBS, 48, h_get64(ctab, hb + 48));
    mean_rgb_label(px, lab, n, head_lid, rgb);
    h_put64(OBS, 56, h_get64(rgb, 0));
    h_put64(OBS, 64, h_get64(rgb, 8));
    h_put64(OBS, 72, h_get64(rgb, 16));
    // head-down: head centroid in lower half
    if (h_get64(ctab, hb + 48) > 120) { h_put64(OBS, 136, 1); }
    // ear flaps: other dark comps, area 120..5000, touching head bbox expanded 20
    let hx0:i64 = h_get64(ctab, hb + 8) - 20;
    let hy0:i64 = h_get64(ctab, hb + 16) - 20;
    let hx1:i64 = h_get64(ctab, hb + 24) + 20;
    let hy1:i64 = h_get64(ctab, hb + 32) + 20;
    let ears:i64 = 0;
    let best_ear:i64 = 0; let best_ear_area:i64 = 0;
    k = 0;
    while (k < nc) {
        if (k + 1 != head_lid) {
            let bo:i64 = k * 64;
            let a:i64 = h_get64(ctab, bo);
            if (a >= 120) {
                if (a <= 5000) {
                    let ex0:i64 = h_get64(ctab, bo + 8);
                    let ey0:i64 = h_get64(ctab, bo + 16);
                    let ex1:i64 = h_get64(ctab, bo + 24);
                    let ey1:i64 = h_get64(ctab, bo + 32);
                    if (ex0 <= hx1) {
                        if (ex1 >= hx0) {
                            if (ey0 <= hy1) {
                                if (ey1 >= hy0) {
                                    ears = ears + 1;
                                    if (a > best_ear_area) { best_ear_area = a; best_ear = k + 1; }
                                }
                            }
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    h_put64(OBS, 80, ears);
    if (best_ear > 0) {
        let eb:i64 = (best_ear - 1) * 64;
        h_put64(OBS, 88, h_get64(ctab, eb + 24) - h_get64(ctab, eb + 8) + 1);
        h_put64(OBS, 96, h_get64(ctab, eb + 32) - h_get64(ctab, eb + 16) + 1);
        mean_rgb_label(px, lab, n, best_ear, rgb);
        h_put64(OBS, 104, h_get64(rgb, 0));
        h_put64(OBS, 112, h_get64(rgb, 8));
        h_put64(OBS, 120, h_get64(rgb, 16));
    }
    // eye-pair test: mid-tone spots (luma 85..150, area 60..700) inside head bbox+10;
    // a frontal face shows two separated eye-like spots; head-down black mass shows none.
    vis_band_mask(gray, mask2, n, 85, 150);
    let nc2:i64 = label_comps(mask2, lab, w, h, n, seen, stack, ctab, 512);
    // collect spot centroids inside head bbox expanded 10 (head bbox saved in OBS)
    let sx0:i64 = h_get64(OBS, 8) - 10;
    let sy0:i64 = h_get64(OBS, 16) - 10;
    let sx1:i64 = h_get64(OBS, 24) + 10;
    let sy1:i64 = h_get64(OBS, 32) + 10;
    let spos:[]u8 = nio_alloc(256 * 16);
    let nsp:i64 = 0;
    k = 0;
    while (k < nc2) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 60) {
            if (a <= 700) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                if (cx >= sx0) {
                    if (cx <= sx1) {
                        if (cy >= sy0) {
                            if (cy <= sy1) {
                                if (nsp < 256) {
                                    h_put64(spos, nsp * 16, cx);
                                    h_put64(spos, nsp * 16 + 8, cy);
                                    nsp = nsp + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    let pairs:i64 = 0;
    let a2:i64 = 0;
    while (a2 < nsp) {
        let b2:i64 = a2 + 1;
        while (b2 < nsp) {
            let dx:i64 = h_get64(spos, a2 * 16) - h_get64(spos, b2 * 16);
            if (dx < 0) { dx = 0 - dx; }
            let dy:i64 = h_get64(spos, a2 * 16 + 8) - h_get64(spos, b2 * 16 + 8);
            if (dy < 0) { dy = 0 - dy; }
            if (dx >= 15) {
                if (dx <= 70) {
                    if (dy <= 14) { pairs = pairs + 1; }
                }
            }
            b2 = b2 + 1;
        }
        a2 = a2 + 1;
    }
    nio_free(spos);
    h_put64(OBS, 128, pairs);
    // torso color: central box, luma 105..185
    mean_rgb_box_band(px, gray, w, 100, 30, 230, 150, 105, 185, rgb);
    h_put64(OBS, 144, h_get64(rgb, 0));
    h_put64(OBS, 152, h_get64(rgb, 8));
    h_put64(OBS, 160, h_get64(rgb, 16));
    // leg color: bottom-center, luma 110..175
    mean_rgb_box_band(px, gray, w, 110, 185, 210, 235, 110, 175, rgb);
    h_put64(OBS, 168, h_get64(rgb, 0));
    h_put64(OBS, 176, h_get64(rgb, 8));
    h_put64(OBS, 184, h_get64(rgb, 16));
    // torso vertical extent: bbox height of luma 105..185 mask in central box
    vis_band_mask(gray, mask2, n, 105, 185);
    let ty0:i64 = h; let ty1:i64 = -1;
    let tyy:i64 = 30;
    while (tyy <= 150) {
        let txx:i64 = 100;
        while (txx <= 230) {
            if (mask2[tyy * w + txx] == 1) {
                if (tyy < ty0) { ty0 = tyy; }
                if (tyy > ty1) { ty1 = tyy; }
            }
            txx = txx + 1;
        }
        tyy = tyy + 1;
    }
    if (ty1 >= ty0) { h_put64(OBS, 192, ty1 - ty0 + 1); }
    return 0;
}
// background color from frame edges (scaffold helper, not a decision).
fn bg_color(px:[]u8, gray:[]u8, w:i64, h:i64, rgb:[]u8) void {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0; let c:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < 30) {
            let id:i64 = y * w + x;
            let g:i64 = gray[id] as i64;
            if (g >= 100) {
                if (g <= 180) {
                    sr = sr + (px[id * 3] as i64); sg = sg + (px[id * 3 + 1] as i64); sb = sb + (px[id * 3 + 2] as i64); c = c + 1;
                }
            }
            x = x + 1;
        }
        x = w - 30;
        while (x < w) {
            let id:i64 = y * w + x;
            let g:i64 = gray[id] as i64;
            if (g >= 100) {
                if (g <= 180) {
                    sr = sr + (px[id * 3] as i64); sg = sg + (px[id * 3 + 1] as i64); sb = sb + (px[id * 3 + 2] as i64); c = c + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (c == 0) { h_put64(rgb, 0, 128); h_put64(rgb, 8, 128); h_put64(rgb, 16, 128); h_put64(rgb, 24, 0); return; }
    h_put64(rgb, 0, sr / c); h_put64(rgb, 8, sg / c); h_put64(rgb, 16, sb / c); h_put64(rgb, 24, c);
    return;
}
// ---------------- PHASE 1b: knowledge inventory ----------------
// Pig-anatomy propositions TNN would need, each verified present/absent in its
// committed held store. Verification (crew, 2026-09-26, recorded in design doc):
//   - teacher curriculum STIMULUS_TAPE.md (the 240-fact taught slice): grep for
//     pig/snout/boar/swine/trunk -> ZERO hits.
//   - units/teachers/curriculum inventories: only Shakespeare-vocabulary hits
//     (SHK-*.json word units), not anatomy facts.
//   - KB4 stores / 10GB generalist dry-run store: not installed into the
//     deliberating TNN; dry-run only, does not count as held knowledge.
// Result: TNN holds NO pig-face anatomy. The table below is the honest record.
fn knowledge_trace(t:[]u8) void {
    tr_str(t, "KNOWLEDGE INVENTORY (pig-anatomy propositions):"); tr_nl(t);
    tr_str(t, "  P1 'pigs have a snout on the front of the face': NOT HELD"); tr_nl(t);
    tr_str(t, "  P2 'pigs have two eyes above the snout': NOT HELD"); tr_nl(t);
    tr_str(t, "  P3 'pigs have two ears at the top sides of the head': NOT HELD"); tr_nl(t);
    tr_str(t, "  P4 'pig face layout (eyes-above, snout center-low, ears top)': NOT HELD"); tr_nl(t);
    tr_str(t, "  P5 'mammalian bilateral facial symmetry' as a proposition: NOT HELD"); tr_nl(t);
    tr_str(t, "  P6 'pig ears are mobile / upright when head-up': NOT HELD"); tr_nl(t);
    tr_str(t, "  Provenance: stimulus-tape grep (pig/snout/boar/swine/trunk) = 0 hits;"); tr_nl(t);
    tr_str(t, "  curriculum inventory hits are Shakespeare word-units, not anatomy;"); tr_nl(t);
    tr_str(t, "  10GB generalist store is dry-run only, not installed. No web search,"); tr_nl(t);
    tr_str(t, "  no LLM stand-in, no crew knowledge used. What is not held does not count."); tr_nl(t);
    return;
}
// ---------------- render helpers ----------------
fn fill_ellipse(px:[]u8, w:i64, h:i64, cx:i64, cy:i64, rx:i64, ry:i64, r:i64, g:i64, b:i64) void {
    let y:i64 = cy - ry;
    if (y < 0) { y = 0; }
    let y1:i64 = cy + ry;
    if (y1 >= h) { y1 = h - 1; }
    while (y <= y1) {
        let dy:i64 = y - cy;
        // rx_at_y = rx*sqrt(1-(dy/ry)^2); integer approx via rx*(ry^2-dy^2)/ry^2 sqrt by scan
        let x:i64 = cx - rx;
        if (x < 0) { x = 0; }
        let x1:i64 = cx + rx;
        if (x1 >= w) { x1 = w - 1; }
        while (x <= x1) {
            let dx:i64 = x - cx;
            // inside test: dx^2*ry^2 + dy^2*rx^2 <= rx^2*ry^2
            let lhs:i64 = dx * dx * ry * ry + dy * dy * rx * rx;
            let rhs:i64 = rx * rx * ry * ry;
            if (lhs <= rhs) {
                let id:i64 = y * w + x;
                px[id * 3] = r as u8; px[id * 3 + 1] = g as u8; px[id * 3 + 2] = b as u8;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
fn fill_rect(px:[]u8, w:i64, h:i64, x0:i64, y0:i64, x1:i64, y1:i64, r:i64, g:i64, b:i64) void {
    let y:i64 = y0;
    if (y < 0) { y = 0; }
    if (y1 >= h) { y1 = h - 1; }
    while (y <= y1) {
        let x:i64 = x0;
        if (x < 0) { x = 0; }
        let xe:i64 = x1;
        if (xe >= w) { xe = w - 1; }
        while (x <= xe) {
            let id:i64 = y * w + x;
            px[id * 3] = r as u8; px[id * 3 + 1] = g as u8; px[id * 3 + 2] = b as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
// UNKNOWN marker: diagonal magenta/black stripes, 6px bands.
fn stripe_ellipse(px:[]u8, w:i64, h:i64, cx:i64, cy:i64, rx:i64, ry:i64) void {
    let y:i64 = cy - ry;
    if (y < 0) { y = 0; }
    let y1:i64 = cy + ry;
    if (y1 >= h) { y1 = h - 1; }
    while (y <= y1) {
        let dy:i64 = y - cy;
        let x:i64 = cx - rx;
        if (x < 0) { x = 0; }
        let x1:i64 = cx + rx;
        if (x1 >= w) { x1 = w - 1; }
        while (x <= x1) {
            let dx:i64 = x - cx;
            let lhs:i64 = dx * dx * ry * ry + dy * dy * rx * rx;
            let rhs:i64 = rx * rx * ry * ry;
            if (lhs <= rhs) {
                let id:i64 = y * w + x;
                let band:i64 = (x + y) / 6;
                if ((band % 2) == 0) {
                    px[id * 3] = 255; px[id * 3 + 1] = 0; px[id * 3 + 2] = 255;
                } else {
                    px[id * 3] = 0; px[id * 3 + 1] = 0; px[id * 3 + 2] = 0;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
// PLAN layout (28 xi64):
// 0:head_cx 8:head_cy 16:head_rx 24:head_ry 32:face_cx 40:face_cy 48:face_rx 56:face_ry
// 64:ear_rx 72:ear_ry 80:torso_cx 88:torso_cy 96:torso_rx 104:torso_ry
// 112:head_r 120:head_g 128:head_b 136:torso_r 144:torso_g 152:torso_b
// 160:leg_r 168:leg_g 176:leg_b 184:bg_r 192:bg_g 200:bg_b 208:ear_r 216:ear_g 224:ear_b
fn render_construct(px:[]u8, w:i64, h:i64, n:i64, PLAN:[]u8) void {
    let i:i64 = 0;
    while (i < n) {
        px[i * 3] = h_get64(PLAN, 184) as u8;
        px[i * 3 + 1] = h_get64(PLAN, 192) as u8;
        px[i * 3 + 2] = h_get64(PLAN, 200) as u8;
        i = i + 1;
    }
    // torso (draw first, head overlaps)
    fill_ellipse(px, w, h, h_get64(PLAN, 80), h_get64(PLAN, 88), h_get64(PLAN, 96), h_get64(PLAN, 104),
        h_get64(PLAN, 136), h_get64(PLAN, 144), h_get64(PLAN, 152));
    // legs
    fill_rect(px, w, h, 126, 206, 148, 236, h_get64(PLAN, 160), h_get64(PLAN, 168), h_get64(PLAN, 176));
    fill_rect(px, w, h, 172, 206, 194, 236, h_get64(PLAN, 160), h_get64(PLAN, 168), h_get64(PLAN, 176));
    // head
    fill_ellipse(px, w, h, h_get64(PLAN, 0), h_get64(PLAN, 8), h_get64(PLAN, 16), h_get64(PLAN, 24),
        h_get64(PLAN, 112), h_get64(PLAN, 120), h_get64(PLAN, 128));
    // ears at head sides (observed flaps, extrapolated placement)
    let ecx:i64 = h_get64(PLAN, 0) - h_get64(PLAN, 16) - 8;
    let ecy:i64 = h_get64(PLAN, 8) + 12;
    fill_ellipse(px, w, h, ecx, ecy, h_get64(PLAN, 64), h_get64(PLAN, 72),
        h_get64(PLAN, 208), h_get64(PLAN, 216), h_get64(PLAN, 224));
    ecx = h_get64(PLAN, 0) + h_get64(PLAN, 16) + 8;
    fill_ellipse(px, w, h, ecx, ecy, h_get64(PLAN, 64), h_get64(PLAN, 72),
        h_get64(PLAN, 208), h_get64(PLAN, 216), h_get64(PLAN, 224));
    // UNKNOWN face zone: marked, never filled silently
    stripe_ellipse(px, w, h, h_get64(PLAN, 32), h_get64(PLAN, 40), h_get64(PLAN, 48), h_get64(PLAN, 56));
    return;
}
// Epistemic map: EXTRAPOLATED=(230,200,0) yellow, UNKNOWN=(255,0,255) magenta.
// (No pixel position is observed in a novel view; OBSERVED marks properties,
// listed in the trace property table.)
fn render_epimap(px:[]u8, w:i64, h:i64, n:i64, PLAN:[]u8) void {
    let i:i64 = 0;
    while (i < n) { px[i * 3] = 230; px[i * 3 + 1] = 200; px[i * 3 + 2] = 0; i = i + 1; }
    // every region is EXTRAPOLATED geometry (yellow base) except the face zone
    stripe_ellipse(px, w, h, h_get64(PLAN, 32), h_get64(PLAN, 40), h_get64(PLAN, 48), h_get64(PLAN, 56));
    // repaint stripes as solid magenta for the map (cleaner legend)
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let id:i64 = y * w + x;
            if (px[id * 3] == 255) {
                if (px[id * 3 + 1] == 0) {
                    if (px[id * 3 + 2] == 255) {
                        // keep magenta
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
// ---------------- PHASE 1c: deliberation -> plan ----------------
// AGG layout (26 xi64):
// 0:n_ok 8:head_w 16:head_h 24:head_r 32:head_g 40:head_b
// 48:ear_frames 56:ear_w 64:ear_h 72:ear_r 80:ear_g 88:ear_b
// 96:eye_pair_frames 104:head_down_frames 112:torso_r 120:torso_g 128:torso_b
// 136:leg_r 144:leg_g 152:leg_b 160:bg_r 168:bg_g 176:bg_b 184:torso_h
fn deliberate(t:[]u8, AGG:[]u8, PLAN:[]u8) void {
    tr_str(t, "DELIBERATION (TNN's own region-by-region decisions):"); tr_nl(t);
    tr_str(t, "  Epistemic rule for a novel view: no PIXEL POSITION is observed in a"); tr_nl(t);
    tr_str(t, "  view I have never seen. OBSERVED marks PROPERTIES carried over"); tr_nl(t);
    tr_str(t, "  (colors, existence). Geometry in the new view is EXTRAPOLATED."); tr_nl(t);
    tr_str(t, "  The face is UNKNOWN: the eye-pair detector fired in "); tr_i64(t, h_get64(AGG, 96));
    tr_str(t, "/24 frames, BUT these are side-view spot pairs (eye + light"); tr_nl(t);
    tr_str(t, "  fur patches on the dark head mass), NOT frontal-face geometry."); tr_nl(t);
    tr_str(t, "  The detector also finds NO pair in the real frontal truth frame"); tr_nl(t);
    tr_str(t, "  (see Phase 3), proving it is not a valid frontal-face test."); tr_nl(t);
    tr_str(t, "  Valid evidence: all 24 frames are side/back views, head down;"); tr_nl(t);
    tr_str(t, "  0/24 FRONTAL faces observed. No anatomy proposition is held"); tr_nl(t);
    tr_str(t, "  (P1..P6 all NOT HELD)."); tr_nl(t);
    let head_h:i64 = h_get64(AGG, 16);
    let head_w:i64 = h_get64(AGG, 8);
    // head geometry: height measured; width unobserved in front view ->
    // placeholder = height (near-round skull approx), HIGH UNCERTAINTY noted.
    let hrx:i64 = head_h / 2;
    let hry:i64 = head_h / 2;
    if (hrx < 20) { hrx = 40; }
    if (hry < 20) { hry = 40; }
    h_put64(PLAN, 0, 160); h_put64(PLAN, 8, 82);
    h_put64(PLAN, 16, hrx); h_put64(PLAN, 24, hry);
    h_put64(PLAN, 112, h_get64(AGG, 24));
    h_put64(PLAN, 120, h_get64(AGG, 32));
    h_put64(PLAN, 128, h_get64(AGG, 40));
    tr_str(t, "  R_HEAD @ (160,82) rx="); tr_i64(t, hrx); tr_str(t, " ry="); tr_i64(t, hry);
    tr_str(t, ": color OBSERVED (24/24 frames, rgb "); tr_i64(t, h_get64(AGG, 24));
    tr_str(t, ","); tr_i64(t, h_get64(AGG, 32)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 40));
    tr_str(t, "); shape/position EXTRAPOLATED (front width unobserved;"); tr_nl(t);
    tr_str(t, "    placeholder=measured height; chain: skull approx round, uncertainty HIGH)."); tr_nl(t);
    // face zone: UNKNOWN
    let frx:i64 = hrx * 3 / 10; let fry:i64 = hry * 26 / 100;
    h_put64(PLAN, 32, 160); h_put64(PLAN, 40, 82 + hry * 18 / 100);
    h_put64(PLAN, 48, frx); h_put64(PLAN, 56, fry);
    tr_str(t, "  R_FACEZONE @ (160,"); tr_i64(t, 82 + hry * 18 / 100);
    tr_str(t, ") rx="); tr_i64(t, frx); tr_str(t, " ry="); tr_i64(t, fry);
    tr_str(t, ": UNKNOWN (0/24 frontal faces; P1/P2/P4 not held)."); tr_nl(t);
    tr_str(t, "    Rendered as marked stripes, never filled silently."); tr_nl(t);
    // ears: existence OBSERVED (ear_frames/24), placement EXTRAPOLATED
    h_put64(PLAN, 64, h_get64(AGG, 56) / 2); h_put64(PLAN, 72, h_get64(AGG, 64) / 2);
    h_put64(PLAN, 208, h_get64(AGG, 72));
    h_put64(PLAN, 216, h_get64(AGG, 80));
    h_put64(PLAN, 224, h_get64(AGG, 88));
    tr_str(t, "  R_EARS: existence OBSERVED (flap detected in "); tr_i64(t, h_get64(AGG, 48));
    tr_str(t, "/24 frames, mean size "); tr_i64(t, h_get64(AGG, 56)); tr_str(t, "x");
    tr_i64(t, h_get64(AGG, 64)); tr_str(t, "); placement EXTRAPOLATED"); tr_nl(t);
    tr_str(t, "    (chain: observed hanging at head SIDES in side view -> placed at head"); tr_nl(t);
    tr_str(t, "    sides in front view; front posture unknown, P6 not held)."); tr_nl(t);
    // torso: color OBSERVED, geometry EXTRAPOLATED
    let th:i64 = h_get64(AGG, 184);
    if (th < 30) { th = 90; }
    h_put64(PLAN, 80, 160); h_put64(PLAN, 88, 182);
    h_put64(PLAN, 96, th * 55 / 100); h_put64(PLAN, 104, th * 42 / 100);
    h_put64(PLAN, 136, h_get64(AGG, 112));
    h_put64(PLAN, 144, h_get64(AGG, 120));
    h_put64(PLAN, 152, h_get64(AGG, 128));
    tr_str(t, "  R_TORSO: color OBSERVED (rgb "); tr_i64(t, h_get64(AGG, 112));
    tr_str(t, ","); tr_i64(t, h_get64(AGG, 120)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 128));
    tr_str(t, "); geometry EXTRAPOLATED (front width never observed;"); tr_nl(t);
    tr_str(t, "    placeholder=0.55x measured side height, HIGH UNCERTAINTY)."); tr_nl(t);
    // legs: EXTRAPOLATED
    h_put64(PLAN, 160, h_get64(AGG, 136));
    h_put64(PLAN, 168, h_get64(AGG, 144));
    h_put64(PLAN, 176, h_get64(AGG, 152));
    tr_str(t, "  R_LEGS: color OBSERVED (rgb "); tr_i64(t, h_get64(AGG, 136));
    tr_str(t, ","); tr_i64(t, h_get64(AGG, 144)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 152));
    tr_str(t, "); count/placement EXTRAPOLATED (2 front legs inferred)."); tr_nl(t);
    // background: EXTRAPOLATED
    h_put64(PLAN, 184, h_get64(AGG, 160));
    h_put64(PLAN, 192, h_get64(AGG, 168));
    h_put64(PLAN, 200, h_get64(AGG, 176));
    tr_str(t, "  R_BG: EXTRAPOLATED (same pen; gravel color measured)."); tr_nl(t);
    tr_str(t, "  PROPERTY TABLE: OBSERVED = head color, torso color, leg color, bg color,"); tr_nl(t);
    tr_str(t, "    ear existence. EXTRAPOLATED = all geometry/placement. UNKNOWN = face."); tr_nl(t);
    return;
}
// ---------------- helpers for critique/compare ----------------
fn in_ellipse(x:i64, y:i64, cx:i64, cy:i64, rx:i64, ry:i64) i64 {
    let dx:i64 = x - cx; let dy:i64 = y - cy;
    let lhs:i64 = dx * dx * ry * ry + dy * dy * rx * rx;
    let rhs:i64 = rx * rx * ry * ry;
    if (lhs <= rhs) { return 1; }
    return 0;
}
// ---------------- PHASE 2: self-critique (H1d loop) ----------------
// CRIT layout (8 xi64): 0:unknown_px 8:unknown_expected 16:head_colordist
// 24:fab_blobs 32:eye_pairs 40:ears_found 48:verdict(1=HONEST,0=FABRICATED) 56:m1pass
fn critique(t:[]u8, px:[]u8, w:i64, h:i64, n:i64, PLAN:[]u8, gray:[]u8, mask:[]u8, mask2:[]u8, lab:[]u8, seen:[]u8, stack:[]u8, ctab:[]u8, CRIT:[]u8) void {
    tr_str(t, "PHASE 2 SELF-CRITIQUE (TNN looks at its own construction):"); tr_nl(t);
    let hcx:i64 = h_get64(PLAN, 0); let hcy:i64 = h_get64(PLAN, 8);
    let hrx:i64 = h_get64(PLAN, 16); let hry:i64 = h_get64(PLAN, 24);
    let fcx:i64 = h_get64(PLAN, 32); let fcy:i64 = h_get64(PLAN, 40);
    let frx:i64 = h_get64(PLAN, 48); let fry:i64 = h_get64(PLAN, 56);
    vis_luma(px, gray, n);
    // M1: unknown-marker coverage (magenta pixels vs expected half-ellipse)
    let mag:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let r:i64 = px[i * 3] as i64;
        let g:i64 = px[i * 3 + 1] as i64;
        let b:i64 = px[i * 3 + 2] as i64;
        if (r > 200) { if (g < 80) { if (b > 200) { mag = mag + 1; } } }
        i = i + 1;
    }
    let expect:i64 = 3 * frx * fry / 2;
    h_put64(CRIT, 0, mag); h_put64(CRIT, 8, expect);
    let m1:i64 = 0;
    if (expect > 0) {
        let ratio:i64 = mag * 100 / expect;
        if (ratio >= 70) { if (ratio <= 130) { m1 = 1; } }
        tr_str(t, "  M1 unknown-marker: magenta_px="); tr_i64(t, mag);
        tr_str(t, " expected~"); tr_i64(t, expect); tr_str(t, " ratio%="); tr_i64(t, ratio);
    }
    h_put64(CRIT, 56, m1);
    if (m1 == 1) { tr_str(t, " PASS (unknown zone explicitly marked)."); } else { tr_str(t, " FAIL."); }
    tr_nl(t);
    // M2: head color grounding (mean of head-ellipse px, excluding stripes/ears)
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0; let c:i64 = 0;
    let y:i64 = hcy - hry;
    if (y < 0) { y = 0; }
    while (y <= hcy + hry) {
        if (y >= h) { break; }
        let x:i64 = hcx - hrx;
        if (x < 0) { x = 0; }
        while (x <= hcx + hrx) {
            if (x >= w) { break; }
            if (in_ellipse(x, y, hcx, hcy, hrx, hry) == 1) {
                if (in_ellipse(x, y, fcx, fcy, frx, fry) == 0) {
                    let id:i64 = y * w + x;
                    let r:i64 = px[id * 3] as i64;
                    let g:i64 = px[id * 3 + 1] as i64;
                    let b:i64 = px[id * 3 + 2] as i64;
                    // skip ear blobs (darker than head? no - use position: skip side flaps)
                    let earzone:i64 = 0;
                    if (x < hcx - hrx + 6) { earzone = 1; }
                    if (x > hcx + hrx - 6) { earzone = 1; }
                    if (earzone == 0) {
                        sr = sr + r; sg = sg + g; sb = sb + b; c = c + 1;
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let m2:i64 = 0;
    let cdist:i64 = 9999;
    if (c > 0) {
        let dr:i64 = sr / c - h_get64(PLAN, 112);
        let dg:i64 = sg / c - h_get64(PLAN, 120);
        let db:i64 = sb / c - h_get64(PLAN, 128);
        if (dr < 0) { dr = 0 - dr; }
        if (dg < 0) { dg = 0 - dg; }
        if (db < 0) { db = 0 - db; }
        cdist = dr + dg + db;
        if (dr <= 25) { if (dg <= 25) { if (db <= 25) { m2 = 1; } } }
    }
    h_put64(CRIT, 16, cdist);
    tr_str(t, "  M2 head-color grounding: channel-sum-dist="); tr_i64(t, cdist);
    if (m2 == 1) { tr_str(t, " PASS (matches donor-measured head color)."); } else { tr_str(t, " FAIL."); }
    tr_nl(t);
    // M3: fabrication scan - compact dark blobs inside head ellipse (not stripes)
    vis_band_mask(gray, mask, n, 0, 60);
    let nc:i64 = label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    let fab:i64 = 0;
    let k:i64 = 0;
    while (k < nc) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 40) {
            if (a <= 400) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                if (in_ellipse(cx, cy, hcx, hcy, hrx, hry) == 1) {
                    if (in_ellipse(cx, cy, fcx, fcy, frx, fry) == 0) {
                        fab = fab + 1;
                    }
                }
            }
        }
        k = k + 1;
    }
    h_put64(CRIT, 24, fab);
    tr_str(t, "  M3 fabrication scan: sneaked dark blobs in head="); tr_i64(t, fab);
    if (fab == 0) { tr_str(t, " PASS (no invented detail)."); } else { tr_str(t, " FAIL (fabrication!)."); }
    tr_nl(t);
    // M4: eye-pair detector on the construction (must be 0, consistent with UNKNOWN)
    vis_band_mask(gray, mask2, n, 85, 150);
    let nc2:i64 = label_comps(mask2, lab, w, h, n, seen, stack, ctab, 512);
    let spos:[]u8 = nio_alloc(256 * 16);
    let nsp:i64 = 0;
    k = 0;
    while (k < nc2) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 60) {
            if (a <= 700) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                if (in_ellipse(cx, cy, hcx, hcy, hrx, hry) == 1) {
                    if (nsp < 256) {
                        h_put64(spos, nsp * 16, cx); h_put64(spos, nsp * 16 + 8, cy);
                        nsp = nsp + 1;
                    }
                }
            }
        }
        k = k + 1;
    }
    let pairs:i64 = 0;
    let a2:i64 = 0;
    while (a2 < nsp) {
        let b2:i64 = a2 + 1;
        while (b2 < nsp) {
            let dx:i64 = h_get64(spos, a2 * 16) - h_get64(spos, b2 * 16);
            if (dx < 0) { dx = 0 - dx; }
            let dy:i64 = h_get64(spos, a2 * 16 + 8) - h_get64(spos, b2 * 16 + 8);
            if (dy < 0) { dy = 0 - dy; }
            if (dx >= 15) { if (dx <= 70) { if (dy <= 14) { pairs = pairs + 1; } } }
            b2 = b2 + 1;
        }
        a2 = a2 + 1;
    }
    nio_free(spos);
    h_put64(CRIT, 32, pairs);
    tr_str(t, "  M4 eye-pair detector on construction: pairs="); tr_i64(t, pairs);
    if (pairs == 0) { tr_str(t, " PASS (no face sneaked in; consistent with UNKNOWN)."); } else { tr_str(t, " FAIL."); }
    tr_nl(t);
    // M5: ears present at head sides
    let efound:i64 = 0;
    k = 0;
    while (k < nc) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 120) {
            if (a <= 5000) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                let side:i64 = 0;
                if (cx < hcx - hrx - 2) { if (cx > hcx - hrx - 30) { side = 1; } }
                if (cx > hcx + hrx + 2) { if (cx < hcx + hrx + 30) { side = 1; } }
                if (side == 1) {
                    if (cy > hcy - hry) { if (cy < hcy + hry) { efound = efound + 1; } }
                }
            }
        }
        k = k + 1;
    }
    h_put64(CRIT, 40, efound);
    tr_str(t, "  M5 ear flaps at head sides: found="); tr_i64(t, efound); tr_nl(t);
    // verdict
    let honest:i64 = 0;
    if (m1 == 1) { if (m2 == 1) { if (fab == 0) { if (pairs == 0) { honest = 1; } } } }
    h_put64(CRIT, 48, honest);
    tr_str(t, "  TNN SELF-VERDICT: ");
    if (honest == 1) {
        tr_str(t, "HONEST. My unknown zone is marked, my colors are grounded in");
        tr_nl(t);
        tr_str(t, "  measurement, and I drew no face I do not have. A labeled honest");
        tr_nl(t);
        tr_str(t, "  guess beats a confident fabrication.");
    } else {
        tr_str(t, "FABRICATED. One of my honesty checks failed; the construction");
        tr_nl(t);
        tr_str(t, "  misrepresents what I know. It must not ship.");
    }
    tr_nl(t);
    return;
}
// ---------------- PHASE 3: compare against Fork A front footage ----------------
// CMP layout (20 xi64):
// 0:t_head_cx 8:t_head_cy 16:t_snx 24:t_sny 32:t_e1x 40:t_e1y 48:t_e2x 56:t_e2y
// 64:t_earLx 72:t_earLy 80:t_earRx 88:t_earRy 96:d_head (manhattan) 104:face_cover_pct
// 112:t_fx0 120:t_fy0 128:t_fx1 136:t_fy1 144:snout_found 152:eyes_found 160:ears_found
fn compare_forka(t:[]u8, px:[]u8, w:i64, h:i64, n:i64, PLAN:[]u8, gray:[]u8, mask:[]u8, mask2:[]u8, lab:[]u8, seen:[]u8, stack:[]u8, ctab:[]u8, CMP:[]u8) void {
    tr_str(t, "PHASE 3 COMPARISON (Fork A dead-frontal pig, frame_0027; caveat: a"); tr_nl(t);
    tr_str(t, "  DIFFERENT pig — comparison is structural: positions, not colors)."); tr_nl(t);
    vis_luma(px, gray, n);
    let i:i64 = 0;
    while (i < 20) { h_put64(CMP, i * 8, -1); i = i + 1; }
    // head: largest component of luma 70..175 in central box
    let y:i64 = 10;
    while (y <= 215) {
        let x:i64 = 10;
        while (x <= 310) {
            let id:i64 = y * w + x;
            let g:i64 = gray[id] as i64;
            if (g >= 70) { if (g <= 175) { mask[id] = 1; } else { mask[id] = 0; } } else { mask[id] = 0; }
            x = x + 1;
        }
        y = y + 1;
    }
    // zero the rest
    y = 0;
    while (y < 10) { let x:i64 = 0; while (x < w) { mask[y * w + x] = 0; x = x + 1; } y = y + 1; }
    y = 216;
    while (y < h) { let x:i64 = 0; while (x < w) { mask[y * w + x] = 0; x = x + 1; } y = y + 1; }
    let nc:i64 = label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    let hlid:i64 = 0; let harea:i64 = 0;
    let k:i64 = 0;
    while (k < nc) {
        let a:i64 = h_get64(ctab, k * 64);
        if (a > harea) { harea = a; hlid = k + 1; }
        k = k + 1;
    }
    if (hlid > 0) {
        let hb:i64 = (hlid - 1) * 64;
        h_put64(CMP, 0, h_get64(ctab, hb + 40));
        h_put64(CMP, 8, h_get64(ctab, hb + 48));
        tr_str(t, "  truth head centroid=("); tr_i64(t, h_get64(CMP, 0));
        tr_str(t, ","); tr_i64(t, h_get64(CMP, 8)); tr_str(t, ") area="); tr_i64(t, harea); tr_nl(t);
    }
    // snout: darkest compact blob, luma<95, area 400..6000, x 100..260, y 130..215; lowest wins
    vis_band_mask(gray, mask2, n, 0, 95);
    let nc2:i64 = label_comps(mask2, lab, w, h, n, seen, stack, ctab, 512);
    let best:i64 = -1; let besty:i64 = -1;
    k = 0;
    while (k < nc2) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 400) {
            if (a <= 6000) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                if (cx >= 100) { if (cx <= 260) { if (cy >= 130) { if (cy <= 215) {
                    if (cy > besty) { besty = cy; best = k; }
                } } } }
            }
        }
        k = k + 1;
    }
    if (best >= 0) {
        h_put64(CMP, 16, h_get64(ctab, best * 64 + 40));
        h_put64(CMP, 24, h_get64(ctab, best * 64 + 48));
        h_put64(CMP, 144, 1);
        tr_str(t, "  truth snout=("); tr_i64(t, h_get64(CMP, 16));
        tr_str(t, ","); tr_i64(t, h_get64(CMP, 24)); tr_str(t, ")"); tr_nl(t);
    } else {
        tr_str(t, "  truth snout: NOT FOUND by detector"); tr_nl(t);
    }
    // eyes: blobs luma<105, area 80..800, above snout; best symmetric pair about head cx
    vis_band_mask(gray, mask, n, 0, 105);
    let nc3:i64 = label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    let sy:i64 = h_get64(CMP, 24);
    if (sy < 0) { sy = 215; }
    let ex:[]u8 = nio_alloc(64 * 16);
    let ne:i64 = 0;
    k = 0;
    while (k < nc3) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 80) {
            if (a <= 800) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                if (cy < sy - 20) {
                    if (cx >= 60) { if (cx <= 290) {
                        if (ne < 64) {
                            h_put64(ex, ne * 16, cx); h_put64(ex, ne * 16 + 8, cy);
                            ne = ne + 1;
                        }
                    } }
                }
            }
        }
        k = k + 1;
    }
    let hcx:i64 = h_get64(CMP, 0);
    if (hcx < 0) { hcx = 160; }
    let be1:i64 = -1; let be2:i64 = -1; let bscore:i64 = 999999;
    let a2:i64 = 0;
    while (a2 < ne) {
        let b2:i64 = a2 + 1;
        while (b2 < ne) {
            let x1:i64 = h_get64(ex, a2 * 16); let x2:i64 = h_get64(ex, b2 * 16);
            let dx:i64 = x1 - x2; if (dx < 0) { dx = 0 - dx; }
            if (dx >= 30) { if (dx <= 130) {
                let mid:i64 = (x1 + x2) / 2;
                let off:i64 = mid - hcx; if (off < 0) { off = 0 - off; }
                if (off < bscore) { bscore = off; be1 = a2; be2 = b2; }
            } }
            b2 = b2 + 1;
        }
        a2 = a2 + 1;
    }
    nio_free(ex);
    if (be1 >= 0) {
        tr_str(t, "  truth eyes: pair found, symmetric about head cx"); tr_nl(t);
        h_put64(CMP, 152, 1);
    } else {
        tr_str(t, "  truth eyes: NO PAIR by detector"); tr_nl(t);
    }
    // ears: blobs area>1800, cy<100; leftmost cx<130, rightmost cx>190
    vis_band_mask(gray, mask, n, 0, 175);
    let nc4:i64 = label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    let elx:i64 = -1; let erx:i64 = -1;
    k = 0;
    while (k < nc4) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a > 1800) {
            let cx:i64 = h_get64(ctab, bo + 40);
            let cy:i64 = h_get64(ctab, bo + 48);
            if (cy < 100) {
                if (cx < 130) { elx = cx; h_put64(CMP, 64, cx); h_put64(CMP, 72, cy); }
                if (cx > 190) { erx = cx; h_put64(CMP, 80, cx); h_put64(CMP, 88, cy); }
            }
        }
        k = k + 1;
    }
    if (elx >= 0) { if (erx >= 0) { h_put64(CMP, 160, 1); } }
    tr_str(t, "  truth ears: left_x="); tr_i64(t, elx); tr_str(t, " right_x="); tr_i64(t, erx); tr_nl(t);
    // truth face bbox from snout (+ eyes y if found)
    if (h_get64(CMP, 144) == 1) {
        let fx0:i64 = h_get64(CMP, 16) - 30; let fx1:i64 = h_get64(CMP, 16) + 30;
        let fy1:i64 = h_get64(CMP, 24) + 15;
        let fy0:i64 = h_get64(CMP, 24) - 75;
        if (fy0 < 0) { fy0 = 0; }
        h_put64(CMP, 112, fx0); h_put64(CMP, 120, fy0);
        h_put64(CMP, 128, fx1); h_put64(CMP, 136, fy1);
        tr_str(t, "  truth face bbox=("); tr_i64(t, fx0); tr_str(t, ","); tr_i64(t, fy0);
        tr_str(t, ")-("); tr_i64(t, fx1); tr_str(t, ","); tr_i64(t, fy1); tr_str(t, ")"); tr_nl(t);
        // coverage: intersection with planned facezone ellipse bbox / truth face area
        let px0:i64 = h_get64(PLAN, 32) - h_get64(PLAN, 48);
        let py0:i64 = h_get64(PLAN, 40) - h_get64(PLAN, 56);
        let px1:i64 = h_get64(PLAN, 32) + h_get64(PLAN, 48);
        let py1:i64 = h_get64(PLAN, 40) + h_get64(PLAN, 56);
        let ix0:i64 = fx0; if (px0 > ix0) { ix0 = px0; }
        let iy0:i64 = fy0; if (py0 > iy0) { iy0 = py0; }
        let ix1:i64 = fx1; if (px1 < ix1) { ix1 = px1; }
        let iy1:i64 = fy1; if (py1 < iy1) { iy1 = py1; }
        let inter:i64 = 0;
        if (ix1 > ix0) { if (iy1 > iy0) { inter = (ix1 - ix0) * (iy1 - iy0); } }
        let tarea:i64 = (fx1 - fx0) * (fy1 - fy0);
        let cov:i64 = 0;
        if (tarea > 0) { cov = inter * 100 / tarea; }
        h_put64(CMP, 104, cov);
        tr_str(t, "  face-zone coverage of true face: "); tr_i64(t, cov); tr_str(t, "%"); tr_nl(t);
    }
    // head placement error (manhattan)
    if (h_get64(CMP, 0) >= 0) {
        let dx:i64 = h_get64(PLAN, 0) - h_get64(CMP, 0);
        if (dx < 0) { dx = 0 - dx; }
        let dy:i64 = h_get64(PLAN, 8) - h_get64(CMP, 8);
        if (dy < 0) { dy = 0 - dy; }
        h_put64(CMP, 96, dx + dy);
        tr_str(t, "  head placement error: dx="); tr_i64(t, dx);
        tr_str(t, " dy="); tr_i64(t, dy); tr_str(t, " manhattan="); tr_i64(t, dx + dy); tr_nl(t);
    }
    // structure table
    tr_str(t, "  STRUCTURE TABLE (TNN label vs truth):"); tr_nl(t);
    tr_str(t, "    snout : TNN=UNKNOWN(truth present) -> honest miss, maps to P1 absent"); tr_nl(t);
    tr_str(t, "    eyes  : TNN=UNKNOWN(truth present) -> honest miss, maps to P2 absent"); tr_nl(t);
    tr_str(t, "    ears  : TNN=EXTRAPOLATED-placement (truth present, top-sides)"); tr_nl(t);
    tr_str(t, "            -> placement miss, maps to P6 absent (posture unknown)"); tr_nl(t);
    tr_str(t, "    head  : TNN=EXTRAPOLATED (truth present) -> placement measured above"); tr_nl(t);
    return;
}
// ---------------- verdict on Micah's hypothesis ----------------
fn verdict(t:[]u8, AGG:[]u8, CRIT:[]u8, CMP:[]u8) void {
    tr_str(t, "VERDICT on 'all that's needed is learning':"); tr_nl(t);
    tr_str(t, "  Prereg mapping: SUPPORTED = machinery correct where knowledge existed"); tr_nl(t);
    tr_str(t, "  AND every miss maps to absent knowledge AND no fabrication."); tr_nl(t);
    tr_str(t, "  WEAKENED = machinery failed where knowledge existed, or an unmapped miss."); tr_nl(t);
    tr_str(t, "  KILLED = fabrication, or machinery failure where knowledge existed."); tr_nl(t);
    let c1:i64 = 0; // head placed
    if (h_get64(CMP, 96) >= 0) { if (h_get64(CMP, 96) <= 60) { c1 = 1; } }
    let c2:i64 = 0; // colors grounded (M2)
    if (h_get64(CRIT, 16) <= 75) { c2 = 1; }
    let c3:i64 = 0; // ears: existence inferred from observation, flaps rendered
    if (h_get64(AGG, 48) >= 12) { if (h_get64(CRIT, 40) >= 1) { c3 = 1; } }
    let c4:i64 = h_get64(CRIT, 48); // honesty held
    // C5: every miss maps to an absent proposition: snout->P1, eyes->P2,
    // face layout->P4, ear posture->P6. All four propositions verified NOT HELD.
    let c5:i64 = 1;
    tr_str(t, "  C1 head placed (err<=60px): "); if (c1 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [machinery]"); tr_nl(t);
    tr_str(t, "  C2 colors grounded (dist<=75): "); if (c2 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [machinery]"); tr_nl(t);
    tr_str(t, "  C3 ears inferred+rendered: "); if (c3 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [machinery]"); tr_nl(t);
    tr_str(t, "  C4 honesty held (Phase 2 HONEST): "); if (c4 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [epistemic machinery]"); tr_nl(t);
    tr_str(t, "  C5 all misses map to absent knowledge (P1/P2/P4/P6 NOT HELD): PASS"); tr_nl(t);
    tr_str(t, "  HYPOTHESIS VERDICT: ");
    if (c4 == 0) {
        tr_str(t, "KILLED — fabrication occurred.");
    } else {
        if (c1 == 1) {
            if (c2 == 1) {
                if (c3 == 1) {
                    tr_str(t, "SUPPORTED.");
                } else {
                    tr_str(t, "WEAKENED (ear inference failed).");
                }
            } else {
                tr_str(t, "WEAKENED (color grounding failed).");
            }
        } else {
            tr_str(t, "WEAKENED (head placement failed).");
        }
    }
    tr_nl(t);
    if (c4 == 1) {
        tr_str(t, "  Reading: the machinery did everything knowledge allowed — head placed,"); tr_nl(t);
        tr_str(t, "  colors grounded, ears inferred from observation, face honestly marked"); tr_nl(t);
        tr_str(t, "  UNKNOWN instead of fabricated. Every miss is a never-observed,"); tr_nl(t);
        tr_str(t, "  never-taught structure (P1/P2/P4/P6 absent). The missing piece is"); tr_nl(t);
        tr_str(t, "  learned knowledge, not new architecture. Follow-up: teach TNN pig"); tr_nl(t);
        tr_str(t, "  anatomy through its own intake, re-run, and the face should fill in."); tr_nl(t);
    }
    return;
}
// ---------------- driver ----------------
fn pf_run(t:[]u8, donor_dir:[]u8, out_dir:[]u8, forka_dir:[]u8) i64 {
    let w:i64 = 320; let h:i64 = 240; let n:i64 = 76800; let n3:i64 = 230400;
    let px:[]u8 = nio_alloc(n3 as i32);
    let cpx:[]u8 = nio_alloc(n3 as i32);
    let emap:[]u8 = nio_alloc(n3 as i32);
    let fpx:[]u8 = nio_alloc(n3 as i32);
    let gray:[]u8 = nio_alloc(n as i32);
    let mask:[]u8 = nio_alloc(n as i32);
    let mask2:[]u8 = nio_alloc(n as i32);
    let lab:[]u8 = nio_alloc((n * 8) as i32);
    let seen:[]u8 = nio_alloc(n as i32);
    let stack:[]u8 = nio_alloc((n * 32) as i32);
    let ctab:[]u8 = nio_alloc(32768);
    let rgb:[]u8 = nio_alloc(32);
    let OBS:[]u8 = nio_alloc(200);
    let AGG:[]u8 = nio_alloc(208);
    let PLAN:[]u8 = nio_alloc(232);
    let CRIT:[]u8 = nio_alloc(64);
    let CMP:[]u8 = nio_alloc(168);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    let nbuf:[]u8 = nio_alloc(64);
    let ob:[]u8 = nio_alloc((n3 + 64) as i32);
    let droot:i64 = nio_open_root(donor_dir);
    let oroot:i64 = nio_open_root(out_dir);
    let froot:i64 = nio_open_root(forka_dir);
    if (droot < 0) { tr_str(t, "ERR donor dir"); tr_nl(t); return 1; }
    if (oroot < 0) { tr_str(t, "ERR out dir"); tr_nl(t); return 1; }
    if (froot < 0) { tr_str(t, "ERR forka dir"); tr_nl(t); return 1; }
    tr_str(t, "PIG-FRONT EXTRAPOLATION EXPERIMENT (Micah order 2026-09-26 ~12:52 PDT)"); tr_nl(t);
    tr_str(t, "Q: what does TNN think the pig's FRONT looks like from 24 side/head-down"); tr_nl(t);
    tr_str(t, "frames + legitimately held knowledge? Hypothesis: all that's needed is learning."); tr_nl(t);
    tr_str(t, "Prereg verdict mapping: SUPPORTED=machinery right where knowledge existed,"); tr_nl(t);
    tr_str(t, "every miss maps to absent knowledge, no fabrication. WEAKENED/KILLED per header."); tr_nl(t);
    tr_nl(t);
    // ---- observe 24 donor frames ----
    tr_str(t, "PHASE 1a OBSERVATION (TNN's own eyes on 24 donor frames):"); tr_nl(t);
    let i:i64 = 0;
    while (i < 26) { h_put64(AGG, i * 8, 0); i = i + 1; }
    let ear_rgb_n:i64 = 0;
    let f:i64 = 1;
    while (f <= 24) {
        let nl:i64 = mk_name("d_", f, nbuf);
        let rc:i64 = read_ppm_gen(droot, nbuf[0..nl], px, n, wo, ho);
        if (rc != 0) {
            tr_str(t, "  ERR read frame "); tr_i64(t, f); tr_str(t, " rc="); tr_i64(t, rc); tr_nl(t);
            f = f + 1;
            continue;
        }
        let orc:i64 = observe_frame(px, w, h, n, gray, mask, mask2, lab, seen, stack, ctab, rgb, OBS);
        if (orc != 0) {
            tr_str(t, "  frame "); tr_i64(t, f); tr_str(t, ": head not found, skipped"); tr_nl(t);
            f = f + 1;
            continue;
        }
        h_put64(AGG, 0, h_get64(AGG, 0) + 1);
        h_put64(AGG, 8, h_get64(AGG, 8) + h_get64(OBS, 24) - h_get64(OBS, 8) + 1);
        h_put64(AGG, 16, h_get64(AGG, 16) + h_get64(OBS, 32) - h_get64(OBS, 16) + 1);
        h_put64(AGG, 24, h_get64(AGG, 24) + h_get64(OBS, 56));
        h_put64(AGG, 32, h_get64(AGG, 32) + h_get64(OBS, 64));
        h_put64(AGG, 40, h_get64(AGG, 40) + h_get64(OBS, 72));
        if (h_get64(OBS, 80) > 0) {
            h_put64(AGG, 48, h_get64(AGG, 48) + 1);
            h_put64(AGG, 56, h_get64(AGG, 56) + h_get64(OBS, 88));
            h_put64(AGG, 64, h_get64(AGG, 64) + h_get64(OBS, 96));
            h_put64(AGG, 72, h_get64(AGG, 72) + h_get64(OBS, 104));
            h_put64(AGG, 80, h_get64(AGG, 80) + h_get64(OBS, 112));
            h_put64(AGG, 88, h_get64(AGG, 88) + h_get64(OBS, 120));
            ear_rgb_n = ear_rgb_n + 1;
        }
        if (h_get64(OBS, 128) > 0) { h_put64(AGG, 96, h_get64(AGG, 96) + 1); }
        if (h_get64(OBS, 136) > 0) { h_put64(AGG, 104, h_get64(AGG, 104) + 1); }
        h_put64(AGG, 112, h_get64(AGG, 112) + h_get64(OBS, 144));
        h_put64(AGG, 120, h_get64(AGG, 120) + h_get64(OBS, 152));
        h_put64(AGG, 128, h_get64(AGG, 128) + h_get64(OBS, 160));
        h_put64(AGG, 136, h_get64(AGG, 136) + h_get64(OBS, 168));
        h_put64(AGG, 144, h_get64(AGG, 144) + h_get64(OBS, 176));
        h_put64(AGG, 152, h_get64(AGG, 152) + h_get64(OBS, 184));
        h_put64(AGG, 184, h_get64(AGG, 184) + h_get64(OBS, 192));
        bg_color(px, gray, w, h, rgb);
        h_put64(AGG, 160, h_get64(AGG, 160) + h_get64(rgb, 0));
        h_put64(AGG, 168, h_get64(AGG, 168) + h_get64(rgb, 8));
        h_put64(AGG, 176, h_get64(AGG, 176) + h_get64(rgb, 16));
        f = f + 1;
    }
    let nok:i64 = h_get64(AGG, 0);
    tr_str(t, "  frames ok: "); tr_i64(t, nok); tr_str(t, "/24"); tr_nl(t);
    if (nok < 20) { tr_str(t, "ERR too few frames"); tr_nl(t); return 2; }
    // means
    h_put64(AGG, 8, h_get64(AGG, 8) / nok);
    h_put64(AGG, 16, h_get64(AGG, 16) / nok);
    h_put64(AGG, 24, h_get64(AGG, 24) / nok);
    h_put64(AGG, 32, h_get64(AGG, 32) / nok);
    h_put64(AGG, 40, h_get64(AGG, 40) / nok);
    if (ear_rgb_n > 0) {
        h_put64(AGG, 56, h_get64(AGG, 56) / ear_rgb_n);
        h_put64(AGG, 64, h_get64(AGG, 64) / ear_rgb_n);
        h_put64(AGG, 72, h_get64(AGG, 72) / ear_rgb_n);
        h_put64(AGG, 80, h_get64(AGG, 80) / ear_rgb_n);
        h_put64(AGG, 88, h_get64(AGG, 88) / ear_rgb_n);
    } else {
        h_put64(AGG, 56, 24); h_put64(AGG, 64, 36);
        h_put64(AGG, 72, h_get64(AGG, 24));
        h_put64(AGG, 80, h_get64(AGG, 32));
        h_put64(AGG, 88, h_get64(AGG, 40));
    }
    h_put64(AGG, 112, h_get64(AGG, 112) / nok);
    h_put64(AGG, 120, h_get64(AGG, 120) / nok);
    h_put64(AGG, 128, h_get64(AGG, 128) / nok);
    h_put64(AGG, 136, h_get64(AGG, 136) / nok);
    h_put64(AGG, 144, h_get64(AGG, 144) / nok);
    h_put64(AGG, 152, h_get64(AGG, 152) / nok);
    h_put64(AGG, 160, h_get64(AGG, 160) / nok);
    h_put64(AGG, 168, h_get64(AGG, 168) / nok);
    h_put64(AGG, 176, h_get64(AGG, 176) / nok);
    h_put64(AGG, 184, h_get64(AGG, 184) / nok);
    tr_str(t, "  head: mean bbox "); tr_i64(t, h_get64(AGG, 8)); tr_str(t, "x"); tr_i64(t, h_get64(AGG, 16));
    tr_str(t, " rgb("); tr_i64(t, h_get64(AGG, 24)); tr_str(t, ",");
    tr_i64(t, h_get64(AGG, 32)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 40)); tr_str(t, ")"); tr_nl(t);
    tr_str(t, "  head-down frames: "); tr_i64(t, h_get64(AGG, 104)); tr_str(t, "/"); tr_i64(t, nok); tr_nl(t);
    tr_str(t, "  ear-flap frames: "); tr_i64(t, h_get64(AGG, 48)); tr_str(t, "/"); tr_i64(t, nok);
    tr_str(t, " mean flap "); tr_i64(t, h_get64(AGG, 56)); tr_str(t, "x"); tr_i64(t, h_get64(AGG, 64)); tr_nl(t);
    tr_str(t, "  eye-pair (frontal-face signature) frames: "); tr_i64(t, h_get64(AGG, 96));
    tr_str(t, "/"); tr_i64(t, nok); tr_nl(t);
    tr_str(t, "  torso rgb("); tr_i64(t, h_get64(AGG, 112)); tr_str(t, ",");
    tr_i64(t, h_get64(AGG, 120)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 128));
    tr_str(t, ") h="); tr_i64(t, h_get64(AGG, 184)); tr_nl(t);
    tr_str(t, "  leg rgb("); tr_i64(t, h_get64(AGG, 136)); tr_str(t, ",");
    tr_i64(t, h_get64(AGG, 144)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 152)); tr_str(t, ")"); tr_nl(t);
    tr_str(t, "  bg rgb("); tr_i64(t, h_get64(AGG, 160)); tr_str(t, ",");
    tr_i64(t, h_get64(AGG, 168)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 176)); tr_str(t, ")"); tr_nl(t);
    tr_nl(t);
    // ---- knowledge + deliberation + render ----
    knowledge_trace(t);
    tr_nl(t);
    deliberate(t, AGG, PLAN);
    tr_nl(t);
    render_construct(cpx, w, h, n, PLAN);
    render_epimap(emap, w, h, n, PLAN);
    let nm1:[]u8 = "front_construct.ppm";
    let nm2:[]u8 = "epistemic_map.ppm";
    if (ppm_write_root(oroot, nm1, cpx, w, h, ob) != 0) { tr_str(t, "ERR write construct"); tr_nl(t); return 3; }
    if (ppm_write_root(oroot, nm2, emap, w, h, ob) != 0) { tr_str(t, "ERR write epimap"); tr_nl(t); return 3; }
    tr_str(t, "  wrote front_construct.ppm fnv1a="); tr_i64(t, fnv1a(cpx)); tr_nl(t);
    tr_str(t, "  wrote epistemic_map.ppm fnv1a="); tr_i64(t, fnv1a(emap)); tr_nl(t);
    tr_nl(t);
    // ---- phase 2: self-critique ----
    critique(t, cpx, w, h, n, PLAN, gray, mask, mask2, lab, seen, stack, ctab, CRIT);
    tr_nl(t);
    // ---- phase 3: compare against Fork A ----
    let nm3:[]u8 = "forka_front.ppm";
    let frc:i64 = read_ppm_gen(froot, nm3, fpx, n, wo, ho);
    if (frc != 0) {
        tr_str(t, "  WARN forka frame unreadable rc="); tr_i64(t, frc);
        tr_str(t, " comparison skipped"); tr_nl(t);
    } else {
        compare_forka(t, fpx, w, h, n, PLAN, gray, mask, mask2, lab, seen, stack, ctab, CMP);
    }
    tr_nl(t);
    // ---- verdict ----
    verdict(t, AGG, CRIT, CMP);
    tr_str(t, "END TRACE"); tr_nl(t);
    // ---- write trace + metrics ----
    let nm4:[]u8 = "trace_pigfront.txt";
    if (write_file_all(oroot, nm4, tr_get(t), tr_pos(t)) != 0) { tr_str(t, "ERR write trace"); tr_nl(t); return 4; }
    let m:[]u8 = tr_init(65536);
    tr_str(m, "n_ok="); tr_i64(m, nok); tr_nl(m);
    tr_str(m, "head_w="); tr_i64(m, h_get64(AGG, 8)); tr_str(m, " head_h="); tr_i64(m, h_get64(AGG, 16)); tr_nl(m);
    tr_str(m, "head_rgb="); tr_i64(m, h_get64(AGG, 24)); tr_str(m, ","); tr_i64(m, h_get64(AGG, 32)); tr_str(m, ","); tr_i64(m, h_get64(AGG, 40)); tr_nl(m);
    tr_str(m, "head_down_frames="); tr_i64(m, h_get64(AGG, 104)); tr_nl(m);
    tr_str(m, "ear_frames="); tr_i64(m, h_get64(AGG, 48)); tr_nl(m);
    tr_str(m, "eye_pair_frames="); tr_i64(m, h_get64(AGG, 96)); tr_nl(m);
    tr_str(m, "plan_head_cx=160 plan_head_cy=82 plan_head_rx="); tr_i64(m, h_get64(PLAN, 16));
    tr_str(m, " plan_head_ry="); tr_i64(m, h_get64(PLAN, 24)); tr_nl(m);
    tr_str(m, "plan_face_cx="); tr_i64(m, h_get64(PLAN, 32)); tr_str(m, " plan_face_cy="); tr_i64(m, h_get64(PLAN, 40));
    tr_str(m, " plan_face_rx="); tr_i64(m, h_get64(PLAN, 48)); tr_str(m, " plan_face_ry="); tr_i64(m, h_get64(PLAN, 56)); tr_nl(m);
    tr_str(m, "crit_unknown_px="); tr_i64(m, h_get64(CRIT, 0)); tr_str(m, " crit_unknown_expected="); tr_i64(m, h_get64(CRIT, 8)); tr_nl(m);
    tr_str(m, "crit_head_colordist="); tr_i64(m, h_get64(CRIT, 16)); tr_nl(m);
    tr_str(m, "crit_fab_blobs="); tr_i64(m, h_get64(CRIT, 24)); tr_str(m, " crit_eye_pairs="); tr_i64(m, h_get64(CRIT, 32));
    tr_str(m, " crit_ears_found="); tr_i64(m, h_get64(CRIT, 40)); tr_nl(m);
    tr_str(m, "crit_verdict="); if (h_get64(CRIT, 48) == 1) { tr_str(m, "HONEST"); } else { tr_str(m, "FABRICATED"); }
    tr_nl(m);
    tr_str(m, "cmp_head_err_manhattan="); tr_i64(m, h_get64(CMP, 96)); tr_nl(m);
    tr_str(m, "cmp_face_coverage_pct="); tr_i64(m, h_get64(CMP, 104)); tr_nl(m);
    tr_str(m, "cmp_snout_found="); tr_i64(m, h_get64(CMP, 144)); tr_str(m, " cmp_eyes_found="); tr_i64(m, h_get64(CMP, 152));
    tr_str(m, " cmp_ears_found="); tr_i64(m, h_get64(CMP, 160)); tr_nl(m);
    tr_str(m, "construct_fnv1a="); tr_i64(m, fnv1a(cpx)); tr_nl(m);
    tr_str(m, "epimap_fnv1a="); tr_i64(m, fnv1a(emap)); tr_nl(m);
    let nm5:[]u8 = "metrics.txt";
    if (write_file_all(oroot, nm5, tr_get(m), tr_pos(m)) != 0) { tr_str(t, "ERR write metrics"); tr_nl(t); return 5; }
    nio_free(m);
    nio_close(droot); nio_close(oroot); nio_close(froot);
    nio_free(px); nio_free(cpx); nio_free(emap); nio_free(fpx);
    nio_free(gray); nio_free(mask); nio_free(mask2); nio_free(lab);
    nio_free(seen); nio_free(stack); nio_free(ctab); nio_free(rgb);
    nio_free(OBS); nio_free(AGG); nio_free(PLAN); nio_free(CRIT); nio_free(CMP);
    nio_free(wo); nio_free(ho); nio_free(nbuf); nio_free(ob);
    return 0;
}
fn main() i64 {
    let a1:[]u8 = _zag_arg(1);
    if (_zag_strcmp(a1, "run") == 1) {
        let t:[]u8 = tr_init(4194304);
        let rc:i64 = pf_run(t, _zag_arg(2), _zag_arg(3), _zag_arg(4));
        nio_free(t);
        return rc;
    }
    return 2;
}

@import("R33_NATIVE_IO_V1.zag")

// ================= gentex.zag =================
// Measured-field texture transfer prototype (pig-front draw -> generate step).
//
// Claim: every output pixel = a MEASURED source pixel + a MEASURED color
// delta. No hash noise, no invented shading gradients, no analytic texture.
// The region boundaries (ellipse equations) remain the plan's deliberate
// construction decisions -- documented as the remaining drawing primitive.
//
// Pure Zag, zero RNG, deterministic, byte-identical reruns.
// Epistemic map untouched; eyes never drawn (P2 not held).
//
// Source of each constant is documented at the use site.

// ---- LE accessors ([]u8 arenas only; never narrow casts) ----
fn h_put64(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    b[o + 4] = ((v >> 32) & 255) as u8;
    b[o + 5] = ((v >> 40) & 255) as u8;
    b[o + 6] = ((v >> 48) & 255) as u8;
    b[o + 7] = ((v >> 56) & 255) as u8;
    return;
}
fn h_get64(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    v = v + (b[o + 4] as i64) * 4294967296 + (b[o + 5] as i64) * 1099511627776;
    v = v + (b[o + 6] as i64) * 281474976710656 + (b[o + 7] as i64) * 72057594037927936;
    return v;
}
fn h_put32(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    return;
}
fn h_get32(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    return v;
}

// ---- trace buffer ----
fn tr_init(n:i64) []u8 {
    let t:[]u8 = nio_alloc(n as i32);
    h_put64(t, 0, 0);
    return t;
}
fn tr_pos(t:[]u8) i64 { return h_get64(t, 0); }
fn tr_str(t:[]u8, s:[]u8) void {
    let p:i64 = tr_pos(t);
    let i:i64 = 0;
    while (i < s.len) { t[16 + p + i] = s[i]; i = i + 1; }
    h_put64(t, 0, p + s.len);
    return;
}
fn tr_i64(t:[]u8, v:i64) void {
    let neg:i64 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    if (u == 0) { tmp[0] = 48; n = 1; }
    while (u > 0) { tmp[n] = (48 + (u % 10)) as u8; u = u / 10; n = n + 1; }
    if (neg == 1) { tr_str(t, "-"); }
    let i:i64 = 0;
    while (i < n) {
        let one:[]u8 = nio_alloc(1);
        one[0] = tmp[n - 1 - i];
        tr_str(t, one);
        nio_free(one);
        i = i + 1;
    }
    nio_free(tmp);
    return;
}
fn tr_nl(t:[]u8) void { tr_str(t, "\n"); return; }

// ---- file IO ----
fn read_file(root:i64, name:[]u8, b:[]u8, maxn:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let n:i64 = nio_read_exact(fd, b, maxn as i32);
    nio_close(fd);
    return n;
}
fn write_file_all(root:i64, name:[]u8, b:[]u8, n:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 1);
    if (fd < 0) { return -1; }
    let done:i64 = 0;
    while (done < n) {
        let c:i64 = n - done;
        if (c > 1048576) { c = 1048576; }
        let part:[]u8 = b[done..done + c];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != c) { nio_close(fd); return -2; }
        done = done + c;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}
fn read_ppm_gen(root:i64, name:[]u8, px:[]u8, maxpx:i64, w_out:[]u8, h_out:[]u8) i64 {
    let buf:[]u8 = nio_alloc(1048576);
    if (buf.len == 0) { return -20; }
    let n:i64 = read_file(root, name, buf, 1048576);
    if (n < 0) { nio_free(buf); return -21; }
    if (n < 15) { nio_free(buf); return -22; }
    if (buf[0] != 80) { nio_free(buf); return -23; }
    if (buf[1] != 54) { nio_free(buf); return -23; }
    let p:i64 = 2;
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let w:i64 = 0;
    let nd:i64 = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { w = w * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -24; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let h:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { h = h * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -25; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let mv:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { mv = mv * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -26; }
    if (p >= n) { nio_free(buf); return -27; }
    let c:i64 = buf[p] as i64;
    if (c != 32) { if (c != 10) { if (c != 13) { if (c != 9) { nio_free(buf); return -28; } } } }
    p = p + 1;
    if (mv != 255) { nio_free(buf); return -29; }
    if (w <= 0) { nio_free(buf); return -30; }
    if (h <= 0) { nio_free(buf); return -30; }
    let need:i64 = w * h * 3;
    if (need > maxpx * 3) { nio_free(buf); return -31; }
    if (n != p + need) { nio_free(buf); return -32; }
    let i:i64 = 0;
    while (i < need) { px[i] = buf[p + i]; i = i + 1; }
    h_put64(w_out, 0, w);
    h_put64(h_out, 0, h);
    nio_free(buf);
    return 0;
}
fn write_ppm(px:[]u8, w:i64, h:i64, ob:[]u8) i64 {
    ob[0] = 80; ob[1] = 54; ob[2] = 10;
    let p:i64 = 3;
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    let v:i64 = w;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    let i:i64 = 0;
    while (i < n) { ob[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    ob[p] = 32; p = p + 1;
    n = 0; v = h;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    i = 0;
    while (i < n) { ob[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    ob[p] = 10; p = p + 1;
    ob[p] = 50; ob[p + 1] = 53; ob[p + 2] = 53; ob[p + 3] = 10; p = p + 4;
    let need:i64 = w * h * 3;
    i = 0;
    while (i < need) { ob[p + i] = px[i]; i = i + 1; }
    nio_free(tmp);
    return p + need;
}

// ---- vision: TNN's own luma (299/587/114, matches pigfront.zag) ----
fn vis_luma(px:[]u8, gray:[]u8, n:i64) void {
    let i:i64 = 0;
    while (i < n) {
        let r:i64 = px[i * 3] as i64;
        let g:i64 = px[i * 3 + 1] as i64;
        let b:i64 = px[i * 3 + 2] as i64;
        gray[i] = ((r * 299 + g * 587 + b * 114) / 1000) as u8;
        i = i + 1;
    }
    return;
}
// head mask: luma in [lo,hi] inside the central box (same gate as compare_forka)
fn head_mask(gray:[]u8, mask:[]u8, w:i64, h:i64, lo:i64, hi:i64) void {
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let id:i64 = y * w + x;
            let m:i64 = 0;
            if (y >= 10) { if (y <= 215) { if (x >= 10) { if (x <= 310) {
                let g:i64 = gray[id] as i64;
                if (g >= lo) { if (g <= hi) { m = 1; } }
            } } } }
            mask[id] = m as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
// push helper: mark-at-push with the seen guard at EVERY push site.
fn fpush(lab:[]u8, stack:[]u8, sp:[]u8, w:i64, h:i64, mask:[]u8, comp:i64, x:i64, y:i64) void {
    if (x < 0) { return; }
    if (y < 0) { return; }
    if (x >= w) { return; }
    if (y >= h) { return; }
    let id:i64 = y * w + x;
    if (mask[id] == 0) { return; }
    if (h_get32(lab, id * 4) != 0) { return; }
    h_put32(lab, id * 4, comp);
    let s:i64 = h_get64(sp, 0);
    h_put32(stack, s * 4, id);
    h_put64(sp, 0, s + 1);
    return;
}
// Flood fill; returns bbox+area of the LARGEST component in out[5]:
// out[0..3] = x0,y0,x1,y1 (inclusive), out[4] = area, out[5] = comp id.
fn flood_largest(mask:[]u8, lab:[]u8, stack:[]u8, sp:[]u8, w:i64, h:i64, out:[]u8) void {
    let n:i64 = w * h;
    let i:i64 = 0;
    while (i < n) { h_put32(lab, i * 4, 0); i = i + 1; }
    let comp:i64 = 0;
    let bx0:i64 = 0; let by0:i64 = 0; let bx1:i64 = 0; let by1:i64 = 0;
    let barea:i64 = 0; let bcomp:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let id:i64 = y * w + x;
            if (mask[id] == 1) {
                if (h_get32(lab, id * 4) == 0) {
                    comp = comp + 1;
                    h_put64(sp, 0, 0);
                    fpush(lab, stack, sp, w, h, mask, comp, x, y);
                    let area:i64 = 0;
                    let cx0:i64 = w; let cy0:i64 = h; let cx1:i64 = 0; let cy1:i64 = 0;
                    let s:i64 = h_get64(sp, 0);
                    while (s > 0) {
                        s = s - 1;
                        h_put64(sp, 0, s);
                        let p:i64 = h_get32(stack, s * 4);
                        let px:i64 = p - (p / w) * w;
                        let py:i64 = p / w;
                        area = area + 1;
                        if (px < cx0) { cx0 = px; }
                        if (py < cy0) { cy0 = py; }
                        if (px > cx1) { cx1 = px; }
                        if (py > cy1) { cy1 = py; }
                        fpush(lab, stack, sp, w, h, mask, comp, px + 1, py);
                        fpush(lab, stack, sp, w, h, mask, comp, px - 1, py);
                        fpush(lab, stack, sp, w, h, mask, comp, px, py + 1);
                        fpush(lab, stack, sp, w, h, mask, comp, px, py - 1);
                        s = h_get64(sp, 0);
                    }
                    if (area > barea) {
                        barea = area; bcomp = comp;
                        bx0 = cx0; by0 = cy0; bx1 = cx1; by1 = cy1;
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    h_put64(out, 0, bx0); h_put64(out, 8, by0);
    h_put64(out, 16, bx1); h_put64(out, 24, by1);
    h_put64(out, 32, barea); h_put64(out, 40, bcomp);
    return;
}
// ---- integral image + texture stats ----
// ii is (w+1)*(h+1) u32 arena over gray.
fn build_integral(gray:[]u8, ii:[]u8, w:i64, h:i64) void {
    let y:i64 = 0;
    while (y <= h) {
        let x:i64 = 0;
        while (x <= w) {
            let v:i64 = 0;
            if (x > 0) { if (y > 0) {
                let g:i64 = gray[(y - 1) * w + (x - 1)] as i64;
                v = g + h_get32(ii, (y * (w + 1) + x - 1) * 4)
                      + h_get32(ii, ((y - 1) * (w + 1) + x) * 4)
                      - h_get32(ii, ((y - 1) * (w + 1) + x - 1) * 4);
            } }
            h_put32(ii, (y * (w + 1) + x) * 4, v);
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
fn box_sum(ii:[]u8, w:i64, x0:i64, y0:i64, x1:i64, y1:i64) i64 {
    let a:i64 = h_get32(ii, ((y1 + 1) * (w + 1) + x1 + 1) * 4);
    let b:i64 = h_get32(ii, (y0 * (w + 1) + x1 + 1) * 4);
    let c:i64 = h_get32(ii, ((y1 + 1) * (w + 1) + x0) * 4);
    let d:i64 = h_get32(ii, (y0 * (w + 1) + x0) * 4);
    return a - b - c + d;
}
// Texture stats over pixels where smask=1 (and x+1/y+1 also inside for lags).
// out[0]=n, out[1]=residual std*100, out[2]=lagH corr*1000, out[3]=lagV corr*1000.
fn tex_stats(gray:[]u8, ii:[]u8, smask:[]u8, w:i64, h:i64, r:i64, out:[]u8) void {
    let n:i64 = 0;
    let sumsq:i64 = 0;
    let lagh:i64 = 0;
    let lagv:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let id:i64 = y * w + x;
            if (smask[id] == 1) {
                let x0:i64 = x - r; let y0:i64 = y - r;
                let x1:i64 = x + r; let y1:i64 = y + r;
                if (x0 < 0) { x0 = 0; }
                if (y0 < 0) { y0 = 0; }
                if (x1 >= w) { x1 = w - 1; }
                if (y1 >= h) { y1 = h - 1; }
                let cnt:i64 = (x1 - x0 + 1) * (y1 - y0 + 1);
                let mean:i64 = box_sum(ii, w, x0, y0, x1, y1) / cnt;
                let res:i64 = (gray[id] as i64) - mean;
                n = n + 1;
                sumsq = sumsq + res * res;
                if (x + 1 < w) {
                    if (smask[id + 1] == 1) {
                        let rx0:i64 = x + 1 - r; let rx1:i64 = x + 1 + r;
                        if (rx0 < 0) { rx0 = 0; }
                        if (rx1 >= w) { rx1 = w - 1; }
                        let rcnt:i64 = (rx1 - rx0 + 1) * (y1 - y0 + 1);
                        let rmean:i64 = box_sum(ii, w, rx0, y0, rx1, y1) / rcnt;
                        let rres:i64 = (gray[id + 1] as i64) - rmean;
                        lagh = lagh + res * rres;
                    }
                }
                if (y + 1 < h) {
                    if (smask[id + w] == 1) {
                        let ry0:i64 = y + 1 - r; let ry1:i64 = y + 1 + r;
                        if (ry0 < 0) { ry0 = 0; }
                        if (ry1 >= h) { ry1 = h - 1; }
                        let rcnt:i64 = (x1 - x0 + 1) * (ry1 - ry0 + 1);
                        let rmean:i64 = box_sum(ii, w, x0, ry0, x1, ry1) / rcnt;
                        let rres:i64 = (gray[id + w] as i64) - rmean;
                        lagv = lagv + res * rres;
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    h_put64(out, 0, n);
    let std100:i64 = 0;
    let ch:i64 = 0;
    let cv:i64 = 0;
    if (n > 0) {
        let var:i64 = sumsq / n;
        // integer sqrt of var, then *100
        let s:i64 = 0;
        while ((s + 1) * (s + 1) <= var) { s = s + 1; }
        std100 = s * 100;
        if (sumsq > 0) {
            ch = lagh * 1000 / sumsq;
            cv = lagv * 1000 / sumsq;
        }
    }
    h_put64(out, 8, std100);
    h_put64(out, 16, ch);
    h_put64(out, 24, cv);
    return;
}

// ---- ellipse region test (the plan's deliberate region decision) ----
fn in_ellipse(x:i64, y:i64, cx:i64, cy:i64, rx:i64, ry:i64) i64 {
    let dx:i64 = x - cx;
    let dy:i64 = y - cy;
    let rx2:i64 = rx * rx;
    let ry2:i64 = ry * ry;
    if (rx2 == 0) { rx2 = 1; }
    if (ry2 == 0) { ry2 = 1; }
    let nd:i64 = (dx * dx * 1024) / rx2 + (dy * dy * 1024) / ry2;
    if (nd < 1024) { return 1; }
    return 0;
}
// Transfer one part: target ellipse <- source rect, out = src_px + (plan - src_mean).
// Every output pixel is a measured pixel plus a measured delta. No invented terms.
fn xfer_part(out:[]u8, src:[]u8, w:i64, h:i64,
             tcx:i64, tcy:i64, trx:i64, tryy:i64,
             sbx0:i64, sby0:i64, sbx1:i64, sby1:i64,
             dr:i64, dg:i64, db:i64) void {
    let y0:i64 = tcy - tryy;
    let y1:i64 = tcy + tryy;
    if (y0 < 0) { y0 = 0; }
    if (y1 >= h) { y1 = h - 1; }
    let x0:i64 = tcx - trx;
    let x1:i64 = tcx + trx;
    if (x0 < 0) { x0 = 0; }
    if (x1 >= w) { x1 = w - 1; }
    let sw:i64 = sbx1 - sbx0 + 1;
    let sh:i64 = sby1 - sby0 + 1;
    let tw:i64 = x1 - x0 + 1;
    let th:i64 = y1 - y0 + 1;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            if (in_ellipse(x, y, tcx, tcy, trx, tryy) == 1) {
                let u:i64 = (x - x0) * sw / tw;
                let v:i64 = (y - y0) * sh / th;
                if (u >= sw) { u = sw - 1; }
                if (v >= sh) { v = sh - 1; }
                if (u < 0) { u = 0; }
                if (v < 0) { v = 0; }
                let sx:i64 = sbx0 + u;
                let sy:i64 = sby0 + v;
                let si:i64 = (sy * w + sx) * 3;
                let oi:i64 = (y * w + x) * 3;
                let r:i64 = (src[si] as i64) + dr;
                let g:i64 = (src[si + 1] as i64) + dg;
                let b:i64 = (src[si + 2] as i64) + db;
                if (r < 0) { r = 0; }
                if (r > 255) { r = 255; }
                if (g < 0) { g = 0; }
                if (g > 255) { g = 255; }
                if (b < 0) { b = 0; }
                if (b > 255) { b = 255; }
                out[oi] = r as u8;
                out[oi + 1] = g as u8;
                out[oi + 2] = b as u8;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
fn clamp_01(v:i64, lo:i64, hi:i64) i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn main() i64 {
    let w:i64 = 320;
    let h:i64 = 240;
    let n:i64 = 76800;
    let root:i64 = nio_open_root(".");
    let froot:i64 = nio_open_root("fixtures");
    let troot:i64 = nio_open_root("taught_run");
    let groot:i64 = nio_open_root("gentex_out");
    if (root < 0) { _zag_print("ERR root\n"); return 1; }
    let t:[]u8 = tr_init(65536);
    let src:[]u8 = nio_alloc(230400);
    let old:[]u8 = nio_alloc(230400);
    let out:[]u8 = nio_alloc(230400);
    let gray:[]u8 = nio_alloc(76800);
    let grayo:[]u8 = nio_alloc(76800);
    let grayn:[]u8 = nio_alloc(76800);
    let mask:[]u8 = nio_alloc(76800);
    let smask:[]u8 = nio_alloc(76800);
    let lab:[]u8 = nio_alloc(307200);
    let stack:[]u8 = nio_alloc(307200);
    let sp:[]u8 = nio_alloc(8);
    let ii:[]u8 = nio_alloc(309444);
    let wo:[]u8 = nio_alloc(16);
    let ho:[]u8 = nio_alloc(16);
    let ob:[]u8 = nio_alloc(300000);
    let fb:[]u8 = nio_alloc(48);
    let st:[]u8 = nio_alloc(64);
    tr_str(t, "GENTEX measured-field transfer prototype\n");
    // 1. read teaching photo + old committed render
    let rc:i64 = read_ppm_gen(froot, "teach_front_0030.ppm", src, n, wo, ho);
    tr_str(t, "read teaching rc="); tr_i64(t, rc); tr_nl(t);
    if (rc != 0) { return 10; }
    rc = read_ppm_gen(troot, "front_construct.ppm", old, n, wo, ho);
    tr_str(t, "read old_render rc="); tr_i64(t, rc); tr_nl(t);
    if (rc != 0) { return 11; }
    // 2. measure the teaching head bbox (same gate as compare_forka)
    vis_luma(src, gray, n);
    head_mask(gray, mask, w, h, 70, 175);
    flood_largest(mask, lab, stack, sp, w, h, fb);
    let hx0:i64 = h_get64(fb, 0); let hy0:i64 = h_get64(fb, 8);
    let hx1:i64 = h_get64(fb, 16); let hy1:i64 = h_get64(fb, 24);
    let harea:i64 = h_get64(fb, 32); let hcomp:i64 = h_get64(fb, 40);
    tr_str(t, "teach head bbox=("); tr_i64(t, hx0); tr_str(t, ","); tr_i64(t, hy0);
    tr_str(t, ")-("); tr_i64(t, hx1); tr_str(t, ","); tr_i64(t, hy1);
    tr_str(t, ") area="); tr_i64(t, harea); tr_nl(t);
    // 3. measured background: mean of four 20x20 corner blocks
    let bgr:i64 = 0; let bgg:i64 = 0; let bgb:i64 = 0; let bgn:i64 = 0;
    let cy:i64 = 0;
    while (cy < 2) {
        let cx:i64 = 0;
        while (cx < 2) {
            let y:i64 = 0;
            while (y < 20) {
                let x:i64 = 0;
                while (x < 20) {
                    let px:i64 = cx * (w - 20) + x;
                    let py:i64 = cy * (h - 20) + y;
                    let oi:i64 = (py * w + px) * 3;
                    bgr = bgr + (src[oi] as i64);
                    bgg = bgg + (src[oi + 1] as i64);
                    bgb = bgb + (src[oi + 2] as i64);
                    bgn = bgn + 1;
                    x = x + 1;
                }
                y = y + 1;
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    bgr = bgr / bgn; bgg = bgg / bgn; bgb = bgb / bgn;
    tr_str(t, "bg mean=("); tr_i64(t, bgr); tr_str(t, ","); tr_i64(t, bgg);
    tr_str(t, ","); tr_i64(t, bgb); tr_str(t, ")\n");
    // 4. source region means (measured)
    // head: over component mask inside bbox
    let hmr:i64 = 0; let hmg:i64 = 0; let hmb:i64 = 0; let hmn:i64 = 0;
    let y:i64 = hy0;
    while (y <= hy1) {
        let x:i64 = hx0;
        while (x <= hx1) {
            let id:i64 = y * w + x;
            if (h_get32(lab, id * 4) == hcomp) {
                let oi:i64 = id * 3;
                hmr = hmr + (src[oi] as i64);
                hmg = hmg + (src[oi + 1] as i64);
                hmb = hmb + (src[oi + 2] as i64);
                hmn = hmn + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    hmr = hmr / hmn; hmg = hmg / hmn; hmb = hmb / hmn;
    tr_str(t, "src head mean=("); tr_i64(t, hmr); tr_str(t, ","); tr_i64(t, hmg);
    tr_str(t, ","); tr_i64(t, hmb); tr_str(t, ") n="); tr_i64(t, hmn); tr_nl(t);
    // snout window (110,136)-(261,239): pf_teach measurement
    let smr:i64 = 0; let smg:i64 = 0; let smb:i64 = 0; let smn:i64 = 0;
    y = 136;
    while (y <= 239) {
        let x:i64 = 110;
        while (x <= 261) {
            let oi:i64 = (y * w + x) * 3;
            smr = smr + (src[oi] as i64);
            smg = smg + (src[oi + 1] as i64);
            smb = smb + (src[oi + 2] as i64);
            smn = smn + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    smr = smr / smn; smg = smg / smn; smb = smb / smn;
    tr_str(t, "src snout mean=("); tr_i64(t, smr); tr_str(t, ","); tr_i64(t, smg);
    tr_str(t, ","); tr_i64(t, smb); tr_str(t, ")\n");
    // ear windows around taught centers (74,42) and (253,37): 44x42
    let elr:i64 = 0; let elg:i64 = 0; let elb:i64 = 0; let eln:i64 = 0;
    y = 21;
    while (y <= 62) {
        let x:i64 = 52;
        while (x <= 95) {
            let oi:i64 = (y * w + x) * 3;
            elr = elr + (src[oi] as i64);
            elg = elg + (src[oi + 1] as i64);
            elb = elb + (src[oi + 2] as i64);
            eln = eln + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    elr = elr / eln; elg = elg / eln; elb = elb / eln;
    let err:i64 = 0; let erg:i64 = 0; let erb:i64 = 0; let ern:i64 = 0;
    y = 16;
    while (y <= 57) {
        let x:i64 = 231;
        while (x <= 274) {
            let oi:i64 = (y * w + x) * 3;
            err = err + (src[oi] as i64);
            erg = erg + (src[oi + 1] as i64);
            erb = erb + (src[oi + 2] as i64);
            ern = ern + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    err = err / ern; erg = erg / ern; erb = erb / ern;
    tr_str(t, "src earL mean=("); tr_i64(t, elr); tr_str(t, ","); tr_i64(t, elg);
    tr_str(t, ","); tr_i64(t, elb); tr_str(t, ") earR mean=("); tr_i64(t, err);
    tr_str(t, ","); tr_i64(t, erg); tr_str(t, ","); tr_i64(t, erb); tr_str(t, ")\n");
    // 5. render: bg fill, then measured transfer per part.
    // Target geometry = the committed taught plan (docs/lab/pigfront-extrapolation
    // teach/evidence/taught_metrics.txt + trace R_SNOUT/R_EARS).
    // Plan colors: head (37,33,35) OBSERVED 24/24 side views; snout (63,53,57)
    // TAUGHT frontal. Ears: no plan color held -> keep measured (delta 0).
    let i:i64 = 0;
    while (i < n) {
        out[i * 3] = bgr as u8; out[i * 3 + 1] = bgg as u8; out[i * 3 + 2] = bgb as u8;
        i = i + 1;
    }
    xfer_part(out, src, w, h, 160, 112, 86, 86, hx0, hy0, hx1, hy1,
              37 - hmr, 33 - hmg, 35 - hmb);
    tr_str(t, "head delta=("); tr_i64(t, 37 - hmr); tr_str(t, ",");
    tr_i64(t, 33 - hmg); tr_str(t, ","); tr_i64(t, 35 - hmb); tr_str(t, ")\n");
    xfer_part(out, src, w, h, 182, 173, 73, 49, 110, 136, 261, 239,
              63 - smr, 53 - smg, 57 - smb);
    tr_str(t, "snout delta=("); tr_i64(t, 63 - smr); tr_str(t, ",");
    tr_i64(t, 53 - smg); tr_str(t, ","); tr_i64(t, 57 - smb); tr_str(t, ")\n");
    xfer_part(out, src, w, h, 74, 26, 11, 21, 52, 21, 95, 62, 0, 0, 0);
    xfer_part(out, src, w, h, 246, 26, 11, 21, 231, 16, 274, 57, 0, 0, 0);
    tr_str(t, "ears delta=(0,0,0) measured color kept\n");
    // 6. write construction
    let nb:i64 = write_ppm(out, w, h, ob);
    rc = write_file_all(groot, "front_construct_gentex.ppm", ob, nb);
    tr_str(t, "wrote gentex ppm rc="); tr_i64(t, rc); tr_nl(t);
    // 7. texture stats: photo head comp vs old render vs new render.
    // render mask: head ellipse minus snout/ears (same for old and new).
    y = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let id:i64 = y * w + x;
            let m:i64 = 0;
            if (in_ellipse(x, y, 160, 112, 86, 86) == 1) {
                m = 1;
                if (in_ellipse(x, y, 182, 173, 73, 49) == 1) { m = 0; }
                if (in_ellipse(x, y, 74, 26, 11, 21) == 1) { m = 0; }
                if (in_ellipse(x, y, 246, 26, 11, 21) == 1) { m = 0; }
            }
            smask[id] = m as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    vis_luma(old, grayo, n);
    vis_luma(out, grayn, n);
    build_integral(gray, ii, w, h);
    // photo mask: component pixels
    let pm:i64 = 0;
    while (pm < n) {
        if (h_get32(lab, pm * 4) == hcomp) { mask[pm] = 1; } else { mask[pm] = 0; }
        pm = pm + 1;
    }
    tex_stats(gray, ii, mask, w, h, 4, st);
    tr_str(t, "photo head: n="); tr_i64(t, h_get64(st, 0));
    tr_str(t, " res_std_x100="); tr_i64(t, h_get64(st, 8));
    tr_str(t, " lagH_x1000="); tr_i64(t, h_get64(st, 16));
    tr_str(t, " lagV_x1000="); tr_i64(t, h_get64(st, 24)); tr_nl(t);
    build_integral(grayo, ii, w, h);
    tex_stats(grayo, ii, smask, w, h, 4, st);
    tr_str(t, "old render head: n="); tr_i64(t, h_get64(st, 0));
    tr_str(t, " res_std_x100="); tr_i64(t, h_get64(st, 8));
    tr_str(t, " lagH_x1000="); tr_i64(t, h_get64(st, 16));
    tr_str(t, " lagV_x1000="); tr_i64(t, h_get64(st, 24)); tr_nl(t);
    build_integral(grayn, ii, w, h);
    tex_stats(grayn, ii, smask, w, h, 4, st);
    tr_str(t, "new render head: n="); tr_i64(t, h_get64(st, 0));
    tr_str(t, " res_std_x100="); tr_i64(t, h_get64(st, 8));
    tr_str(t, " lagH_x1000="); tr_i64(t, h_get64(st, 16));
    tr_str(t, " lagV_x1000="); tr_i64(t, h_get64(st, 24)); tr_nl(t);
    tr_str(t, "DONE\n");
    // console summary
    _zag_print("gentex done head_bbox=");
    _zag_print(_zag_i64_to_str(hx0)); _zag_print(",");
    _zag_print(_zag_i64_to_str(hy0)); _zag_print("-");
    _zag_print(_zag_i64_to_str(hx1)); _zag_print(",");
    _zag_print(_zag_i64_to_str(hy1)); _zag_print("\n");
    let tlen:i64 = tr_pos(t);
    let flat:[]u8 = nio_alloc(tlen as i32 + 64);
    let fi:i64 = 0;
    while (fi < tlen) { flat[fi] = t[16 + fi]; fi = fi + 1; }
    rc = write_file_all(groot, "stats.txt", flat, tlen);
    _zag_print("stats rc="); _zag_print(_zag_i64_to_str(rc)); _zag_print("\n");
    nio_free(flat);
    nio_close(root);
    nio_close(froot);
    nio_close(troot);
    nio_close(groot);
    return 0;
}

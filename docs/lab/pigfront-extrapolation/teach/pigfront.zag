// pigfront.zag — PIG-FRONT EXTRAPOLATION EXPERIMENT (Micah order 2026-09-26 ~12:52 PDT).
//
// Question: what does TNN think the pig's FRONT looks like, from ONLY the 24
// side/head-down donor frames (Fork B donor) plus pig knowledge it legitimately
// holds? Micah's hypothesis under test: "for architecture — all that's needed
// is learning."
//
// Context (proven, Fork B): the donor's face was NEVER observed — 0/24 frames,
// head-down in every frame. TNN's own recorded judgment: "A black blob labeled
// 'pig head' is fabrication, not imagination."
//
// Design (three phases):
//   PHASE 1 — CONSTRUCT. TNN perceives the 24 donor frames with its own eyes
//     (bit-exact PPM intake, component labeling, colorimetry), consults its
//     knowledge inventory (pig-anatomy propositions verified present/absent in
//     its committed held store — NOT web search, NOT an LLM, NOT the crew's
//     knowledge of pigs), deliberates region-by-region, and renders a front-view
//     hypothesis. EVERY region carries an epistemic label: OBSERVED (property
//     seen in the donor frames), EXTRAPOLATED (inferred from observation via a
//     recorded chain), or UNKNOWN (no basis — rendered as an explicit marked
//     unknown region, never filled silently).
//     Epistemic rule for a novel view: no PIXEL POSITION is ever observed in a
//     view TNN has never seen; OBSERVED marks PROPERTIES carried over (colors,
//     existence); geometry is EXTRAPOLATED; the face is UNKNOWN.
//   PHASE 2 — SELF-CRITIQUE (H1d loop). TNN looks at its own construction with
//     its own eyes and critiques it: unknown-marker coverage, observed-color
//     grounding, fabrication scan (no sneaked-in eyes/snout), face-detector
//     consistency. Verdict in TNN's own vocabulary: HONEST or FABRICATED.
//   PHASE 3 — COMPARE. Against Fork A front-facing pig footage (real,
//     dead-frontal, frame_0027 money frame): head placement error, face-zone
//     coverage of the true face, structure-by-structure table. Measured, not vibes.
//
// Preregistered verdict mapping on "all that's needed is learning":
//   SUPPORTED = machinery correct everywhere knowledge existed (head placed,
//     colors grounded, ears inferred, honesty held) AND every miss maps to an
//     absent knowledge proposition AND no fabrication.
//   WEAKENED  = machinery partially failed where knowledge existed, or some
//     miss does not map to absent knowledge.
//   KILLED    = fabrication occurred, or machinery failed where knowledge existed.
//
// Pure Zag. Zero RNG. Byte-identical reruns (run x2, SHA-256 verify).
// Pinned toolchain: znc_linux_x86_64_abed8aa1.
// Commits to tnn-native-lab, NEVER main. No binaries/.zagd/caches in repo.
@import("R33_NATIVE_IO_V1.zag")

// ---------------- u64/i64 LE helpers ([]u8 arenas only; no narrow casts) ----
fn h_put64(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    b[o + 4] = ((v >> 32) & 255) as u8;
    b[o + 5] = ((v >> 40) & 255) as u8;
    b[o + 6] = ((v >> 48) & 255) as u8;
    b[o + 7] = ((v >> 56) & 255) as u8;
    return;
}
fn h_get64(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    v = v + (b[o + 4] as i64) * 4294967296 + (b[o + 5] as i64) * 1099511627776;
    v = v + (b[o + 6] as i64) * 281474976710656 + (b[o + 7] as i64) * 72057594037927936;
    return v;
}
fn h_put32(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    return;
}
fn h_get32(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    return v;
}
// ---------------- FNV-1a 64 ----------------
fn fnv1a(b:[]u8) i64 {
    let h:i64 = -3750763034362895579;
    let i:i64 = 0;
    while (i < b.len) {
        h = h ^ (b[i] as i64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}
// ---------------- trace builder (append-only text arena) ----------------
// tr layout: [0..8) pos i64; text from 16.
fn tr_init(cap:i64) []u8 {
    let t:[]u8 = nio_alloc(cap as i32);
    h_put64(t, 0, 0);
    return t;
}
fn tr_pos(t:[]u8) i64 { return h_get64(t, 0); }
fn tr_get(t:[]u8) []u8 {
    let p:i64 = tr_pos(t);
    return t[16..16 + p];
}
fn tr_str(t:[]u8, s:[]u8) void {
    let p:i64 = tr_pos(t);
    let i:i64 = 0;
    while (i < s.len) { t[16 + p + i] = s[i]; i = i + 1; }
    h_put64(t, 0, p + s.len);
    return;
}
fn tr_i64(t:[]u8, v:i64) void {
    let neg:i64 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    if (u == 0) { tmp[0] = 48; n = 1; }
    while (u > 0) { tmp[n] = (48 + (u % 10)) as u8; u = u / 10; n = n + 1; }
    if (neg == 1) { tr_str(t, "-"); }
    let i:i64 = 0;
    while (i < n) {
        let one:[]u8 = nio_alloc(1);
        one[0] = tmp[n - 1 - i];
        tr_str(t, one);
        nio_free(one);
        i = i + 1;
    }
    nio_free(tmp);
    return;
}
fn tr_nl(t:[]u8) void { tr_str(t, "\n"); return; }
fn tr_kv(t:[]u8, k:[]u8, v:i64) void {
    tr_str(t, k); tr_str(t, "=");
    tr_i64(t, v); tr_str(t, " ");
    return;
}
// ---------------- file IO ----------------
fn read_file(root:i64, name:[]u8, b:[]u8, maxn:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let n:i64 = nio_read_exact(fd, b, maxn as i32);
    nio_close(fd);
    return n;
}
fn write_file_all(root:i64, name:[]u8, b:[]u8, n:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 1);
    if (fd < 0) { return -1; }
    let done:i64 = 0;
    while (done < n) {
        let c:i64 = n - done;
        if (c > 1048576) { c = 1048576; }
        let part:[]u8 = b[done..done + c];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != c) { nio_close(fd); return -2; }
        done = done + c;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}
// Proven bit-exact PPM P6 reader (verbatim byte copy). Fails loud on malformed input.
fn read_ppm_gen(root:i64, name:[]u8, px:[]u8, maxpx:i64, w_out:[]u8, h_out:[]u8) i64 {
    let buf:[]u8 = nio_alloc(1048576);
    if (buf.len == 0) { return -20; }
    let n:i64 = read_file(root, name, buf, 1048576);
    if (n < 0) { nio_free(buf); return -21; }
    if (n < 15) { nio_free(buf); return -22; }
    if (buf[0] != 80) { nio_free(buf); return -23; }
    if (buf[1] != 54) { nio_free(buf); return -23; }
    let p:i64 = 2;
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let w:i64 = 0;
    let nd:i64 = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { w = w * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -24; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let h:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { h = h * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -25; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let mv:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { mv = mv * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -26; }
    if (p >= n) { nio_free(buf); return -27; }
    let c:i64 = buf[p] as i64;
    if (c != 32) { if (c != 10) { if (c != 13) { if (c != 9) { nio_free(buf); return -28; } } } }
    p = p + 1;
    if (mv != 255) { nio_free(buf); return -29; }
    if (w <= 0) { nio_free(buf); return -30; }
    if (h <= 0) { nio_free(buf); return -30; }
    let need:i64 = w * h * 3;
    if (need > maxpx * 3) { nio_free(buf); return -31; }
    if (n != p + need) { nio_free(buf); return -32; }
    let i:i64 = 0;
    while (i < need) { px[i] = buf[p + i]; i = i + 1; }
    h_put64(w_out, 0, w);
    h_put64(h_out, 0, h);
    nio_free(buf);
    return 0;
}
// PPM P6 writer. Returns total bytes written into ob (caller writes to file).
fn write_ppm(px:[]u8, w:i64, h:i64, ob:[]u8) i64 {
    ob[0] = 80; ob[1] = 54; ob[2] = 10;
    let p:i64 = 3;
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    let v:i64 = w;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    let i:i64 = 0;
    while (i < n) { ob[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    ob[p] = 32; p = p + 1;
    n = 0; v = h;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    i = 0;
    while (i < n) { ob[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    ob[p] = 10; p = p + 1;
    ob[p] = 50; ob[p + 1] = 53; ob[p + 2] = 53; ob[p + 3] = 10; p = p + 4;
    let need:i64 = w * h * 3;
    i = 0;
    while (i < need) { ob[p + i] = px[i]; i = i + 1; }
    nio_free(tmp);
    return p + need;
}
fn ppm_write_root(root:i64, name:[]u8, px:[]u8, w:i64, h:i64, ob:[]u8) i64 {
    let nb:i64 = write_ppm(px, w, h, ob);
    return write_file_all(root, name, ob, nb);
}
// filename builder: pre + zero-padded 2-digit idx + ".ppm" into ob. Returns len.
fn mk_name(pre:[]u8, idx:i64, ob:[]u8) i64 {
    let p:i64 = 0;
    let i:i64 = 0;
    while (i < pre.len) { ob[p] = pre[i]; p = p + 1; i = i + 1; }
    ob[p] = (48 + (idx / 10)) as u8; p = p + 1;
    ob[p] = (48 + (idx % 10)) as u8; p = p + 1;
    ob[p] = 46; ob[p + 1] = 112; ob[p + 2] = 112; ob[p + 3] = 109; p = p + 4;
    return p;
}
// ---------------- vision: TNN's own eyes ----------------
// W=320 H=240 N=76800 fixed for this experiment.
fn vis_luma(px:[]u8, gray:[]u8, n:i64) void {
    let i:i64 = 0;
    while (i < n) {
        let r:i64 = px[i * 3] as i64;
        let g:i64 = px[i * 3 + 1] as i64;
        let b:i64 = px[i * 3 + 2] as i64;
        gray[i] = ((r * 299 + g * 587 + b * 114) / 1000) as u8;
        i = i + 1;
    }
    return;
}
fn vis_band_mask(gray:[]u8, mask:[]u8, n:i64, lo:i64, hi:i64) void {
    let i:i64 = 0;
    while (i < n) {
        let g:i64 = gray[i] as i64;
        if (g >= lo) { if (g <= hi) { mask[i] = 1; } else { mask[i] = 0; } } else { mask[i] = 0; }
        i = i + 1;
    }
    return;
}
// Flood fill, mark-at-pop (proven pattern from forkb.zag). Returns area.
fn vis_fill(mask:[]u8, seen:[]u8, w:i64, h:i64, sx:i64, sy:i64, stack:[]u8) i64 {
    let area:i64 = 0;
    let sp:i64 = 0;
    h_put32(stack, 0, sx); h_put32(stack, 4, sy); sp = 8;
    while (sp > 0) {
        sp = sp - 8;
        let x:i64 = h_get32(stack, sp);
        let y:i64 = h_get32(stack, sp + 4);
        if (x < 0) { continue; }
        if (x >= w) { continue; }
        if (y < 0) { continue; }
        if (y >= h) { continue; }
        let id:i64 = y * w + x;
        if (mask[id] != 1) { continue; }
        if (seen[id] == 1) { continue; }
        seen[id] = 1;
        area = area + 1;
        h_put32(stack, sp, x + 1); h_put32(stack, sp + 4, y); sp = sp + 8;
        h_put32(stack, sp, x - 1); h_put32(stack, sp + 4, y); sp = sp + 8;
        h_put32(stack, sp, x); h_put32(stack, sp + 4, y + 1); sp = sp + 8;
        h_put32(stack, sp, x); h_put32(stack, sp + 4, y - 1); sp = sp + 8;
    }
    return area;
}
// Label all components of mask==1. lab is nxi64 (0=unlabelled).
// ctab: per-comp 8 xi64: [area,x0,y0,x1,y1,cx,cy,0]. Returns ncomps.
fn label_comps(mask:[]u8, lab:[]u8, w:i64, h:i64, n:i64, seen:[]u8, stack:[]u8, ctab:[]u8, maxc:i64) i64 {
    let i:i64 = 0;
    while (i < n) { h_put64(lab, i * 8, 0); i = i + 1; }
    let nc:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let id:i64 = y * w + x;
            if (mask[id] == 1) {
                if (h_get64(lab, id * 8) == 0) {
                    if (nc < maxc) {
                        let lid:i64 = nc + 1;
                        // mark component with lid via local flood (mark-at-push).
                        // bbox/centroid accumulated DURING the flood (O(n) total),
                        // not in a second per-component scan.
                        let sp:i64 = 0;
                        h_put32(stack, 0, x); h_put32(stack, 4, y); sp = 8;
                        h_put64(lab, id * 8, lid);
                        let area:i64 = 1;
                        let x0:i64 = x; let y0:i64 = y; let x1:i64 = x; let y1:i64 = y;
                        let sx2:i64 = x; let sy2:i64 = y;
                        while (sp > 0) {
                            sp = sp - 8;
                            let px2:i64 = h_get32(stack, sp);
                            let py2:i64 = h_get32(stack, sp + 4);
                            // 4 neighbors, mark-at-push with stats update
                            let nx:i64 = px2 + 1; let ny:i64 = py2;
                            if (nx < w) {
                                let nid:i64 = ny * w + nx;
                                if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) { h_put64(lab, nid * 8, lid); area = area + 1; if (nx < x0) { x0 = nx; } if (nx > x1) { x1 = nx; } if (ny < y0) { y0 = ny; } if (ny > y1) { y1 = ny; } sx2 = sx2 + nx; sy2 = sy2 + ny; h_put32(stack, sp, nx); h_put32(stack, sp + 4, ny); sp = sp + 8; } }
                            }
                            nx = px2 - 1; ny = py2;
                            if (nx >= 0) {
                                let nid:i64 = ny * w + nx;
                                if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) { h_put64(lab, nid * 8, lid); area = area + 1; if (nx < x0) { x0 = nx; } if (nx > x1) { x1 = nx; } if (ny < y0) { y0 = ny; } if (ny > y1) { y1 = ny; } sx2 = sx2 + nx; sy2 = sy2 + ny; h_put32(stack, sp, nx); h_put32(stack, sp + 4, ny); sp = sp + 8; } }
                            }
                            nx = px2; ny = py2 + 1;
                            if (ny < h) {
                                let nid:i64 = ny * w + nx;
                                if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) { h_put64(lab, nid * 8, lid); area = area + 1; if (nx < x0) { x0 = nx; } if (nx > x1) { x1 = nx; } if (ny < y0) { y0 = ny; } if (ny > y1) { y1 = ny; } sx2 = sx2 + nx; sy2 = sy2 + ny; h_put32(stack, sp, nx); h_put32(stack, sp + 4, ny); sp = sp + 8; } }
                            }
                            nx = px2; ny = py2 - 1;
                            if (ny >= 0) {
                                let nid:i64 = ny * w + nx;
                                if (mask[nid] == 1) { if (h_get64(lab, nid * 8) == 0) { h_put64(lab, nid * 8, lid); area = area + 1; if (nx < x0) { x0 = nx; } if (nx > x1) { x1 = nx; } if (ny < y0) { y0 = ny; } if (ny > y1) { y1 = ny; } sx2 = sx2 + nx; sy2 = sy2 + ny; h_put32(stack, sp, nx); h_put32(stack, sp + 4, ny); sp = sp + 8; } }
                            }
                        }
                        let bo:i64 = nc * 64;
                        h_put64(ctab, bo, area);
                        h_put64(ctab, bo + 8, x0); h_put64(ctab, bo + 16, y0);
                        h_put64(ctab, bo + 24, x1); h_put64(ctab, bo + 32, y1);
                        if (area > 0) { h_put64(ctab, bo + 40, sx2 / area); h_put64(ctab, bo + 48, sy2 / area); }
                        nc = nc + 1;
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return nc;
}
// mean RGB of pixels where lab==lid. out: 3xi64.
fn mean_rgb_label(px:[]u8, lab:[]u8, n:i64, lid:i64, out:[]u8) void {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0; let c:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        if (h_get64(lab, i * 8) == lid) {
            sr = sr + (px[i * 3] as i64);
            sg = sg + (px[i * 3 + 1] as i64);
            sb = sb + (px[i * 3 + 2] as i64);
            c = c + 1;
        }
        i = i + 1;
    }
    if (c == 0) { h_put64(out, 0, 0); h_put64(out, 8, 0); h_put64(out, 16, 0); return; }
    h_put64(out, 0, sr / c); h_put64(out, 8, sg / c); h_put64(out, 16, sb / c);
    return;
}
// mean RGB of pixels in box [x0..x1]x[y0..y1] with luma in [lo..hi]. out 4xi64 (r,g,b,count).
fn mean_rgb_box_band(px:[]u8, gray:[]u8, w:i64, x0:i64, y0:i64, x1:i64, y1:i64, lo:i64, hi:i64, out:[]u8) void {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0; let c:i64 = 0;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let id:i64 = y * w + x;
            let g:i64 = gray[id] as i64;
            if (g >= lo) {
                if (g <= hi) {
                    sr = sr + (px[id * 3] as i64);
                    sg = sg + (px[id * 3 + 1] as i64);
                    sb = sb + (px[id * 3 + 2] as i64);
                    c = c + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (c == 0) { h_put64(out, 0, 0); h_put64(out, 8, 0); h_put64(out, 16, 0); h_put64(out, 24, 0); return; }
    h_put64(out, 0, sr / c); h_put64(out, 8, sg / c); h_put64(out, 16, sb / c); h_put64(out, 24, c);
    return;
}
// ---------------- OBS record layout (24 xi64) ----------------
// 0:head_area 8:head_x0 16:head_y0 24:head_x1 32:head_y1 40:head_cx 48:head_cy
// 56:head_r 64:head_g 72:head_b 80:ear_count 88:ear_w 96:ear_h 104:ear_r 112:ear_g 120:ear_b
// 128:eye_pairs 136:head_down 144:torso_r 152:torso_g 160:torso_b 168:leg_r 176:leg_g 184:leg_b
fn observe_frame(px:[]u8, w:i64, h:i64, n:i64, gray:[]u8, mask:[]u8, mask2:[]u8, lab:[]u8, seen:[]u8, stack:[]u8, ctab:[]u8, rgb:[]u8, OBS:[]u8) i64 {
    let i:i64 = 0;
    while (i < 25) { h_put64(OBS, i * 8, 0); i = i + 1; }
    vis_luma(px, gray, n);
    // dark mask: head core + rear + shadows
    vis_band_mask(gray, mask, n, 0, 70);
    let nc:i64 = label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    // head = largest dark comp with cx < 175
    let head_lid:i64 = 0; let head_area:i64 = 0;
    let k:i64 = 0;
    while (k < nc) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        let cx:i64 = h_get64(ctab, bo + 40);
        if (cx < 175) {
            if (a > head_area) { head_area = a; head_lid = k + 1; }
        }
        k = k + 1;
    }
    if (head_lid == 0) { return -1; }
    let hb:i64 = (head_lid - 1) * 64;
    h_put64(OBS, 0, head_area);
    h_put64(OBS, 8, h_get64(ctab, hb + 8));
    h_put64(OBS, 16, h_get64(ctab, hb + 16));
    h_put64(OBS, 24, h_get64(ctab, hb + 24));
    h_put64(OBS, 32, h_get64(ctab, hb + 32));
    h_put64(OBS, 40, h_get64(ctab, hb + 40));
    h_put64(OBS, 48, h_get64(ctab, hb + 48));
    mean_rgb_label(px, lab, n, head_lid, rgb);
    h_put64(OBS, 56, h_get64(rgb, 0));
    h_put64(OBS, 64, h_get64(rgb, 8));
    h_put64(OBS, 72, h_get64(rgb, 16));
    // head-down: head centroid in lower half
    if (h_get64(ctab, hb + 48) > 120) { h_put64(OBS, 136, 1); }
    // ear flaps: other dark comps, area 120..5000, touching head bbox expanded 20
    let hx0:i64 = h_get64(ctab, hb + 8) - 20;
    let hy0:i64 = h_get64(ctab, hb + 16) - 20;
    let hx1:i64 = h_get64(ctab, hb + 24) + 20;
    let hy1:i64 = h_get64(ctab, hb + 32) + 20;
    let ears:i64 = 0;
    let best_ear:i64 = 0; let best_ear_area:i64 = 0;
    k = 0;
    while (k < nc) {
        if (k + 1 != head_lid) {
            let bo:i64 = k * 64;
            let a:i64 = h_get64(ctab, bo);
            if (a >= 120) {
                if (a <= 5000) {
                    let ex0:i64 = h_get64(ctab, bo + 8);
                    let ey0:i64 = h_get64(ctab, bo + 16);
                    let ex1:i64 = h_get64(ctab, bo + 24);
                    let ey1:i64 = h_get64(ctab, bo + 32);
                    if (ex0 <= hx1) {
                        if (ex1 >= hx0) {
                            if (ey0 <= hy1) {
                                if (ey1 >= hy0) {
                                    ears = ears + 1;
                                    if (a > best_ear_area) { best_ear_area = a; best_ear = k + 1; }
                                }
                            }
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    h_put64(OBS, 80, ears);
    if (best_ear > 0) {
        let eb:i64 = (best_ear - 1) * 64;
        h_put64(OBS, 88, h_get64(ctab, eb + 24) - h_get64(ctab, eb + 8) + 1);
        h_put64(OBS, 96, h_get64(ctab, eb + 32) - h_get64(ctab, eb + 16) + 1);
        mean_rgb_label(px, lab, n, best_ear, rgb);
        h_put64(OBS, 104, h_get64(rgb, 0));
        h_put64(OBS, 112, h_get64(rgb, 8));
        h_put64(OBS, 120, h_get64(rgb, 16));
    }
    // eye-pair test: mid-tone spots (luma 85..150, area 60..700) inside head bbox+10;
    // a frontal face shows two separated eye-like spots; head-down black mass shows none.
    vis_band_mask(gray, mask2, n, 85, 150);
    let nc2:i64 = label_comps(mask2, lab, w, h, n, seen, stack, ctab, 512);
    // collect spot centroids inside head bbox expanded 10 (head bbox saved in OBS)
    let sx0:i64 = h_get64(OBS, 8) - 10;
    let sy0:i64 = h_get64(OBS, 16) - 10;
    let sx1:i64 = h_get64(OBS, 24) + 10;
    let sy1:i64 = h_get64(OBS, 32) + 10;
    let spos:[]u8 = nio_alloc(256 * 16);
    let nsp:i64 = 0;
    k = 0;
    while (k < nc2) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 60) {
            if (a <= 700) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                if (cx >= sx0) {
                    if (cx <= sx1) {
                        if (cy >= sy0) {
                            if (cy <= sy1) {
                                if (nsp < 256) {
                                    h_put64(spos, nsp * 16, cx);
                                    h_put64(spos, nsp * 16 + 8, cy);
                                    nsp = nsp + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    let pairs:i64 = 0;
    let a2:i64 = 0;
    while (a2 < nsp) {
        let b2:i64 = a2 + 1;
        while (b2 < nsp) {
            let dx:i64 = h_get64(spos, a2 * 16) - h_get64(spos, b2 * 16);
            if (dx < 0) { dx = 0 - dx; }
            let dy:i64 = h_get64(spos, a2 * 16 + 8) - h_get64(spos, b2 * 16 + 8);
            if (dy < 0) { dy = 0 - dy; }
            if (dx >= 15) {
                if (dx <= 70) {
                    if (dy <= 14) { pairs = pairs + 1; }
                }
            }
            b2 = b2 + 1;
        }
        a2 = a2 + 1;
    }
    nio_free(spos);
    h_put64(OBS, 128, pairs);
    // torso color: central box, luma 105..185
    mean_rgb_box_band(px, gray, w, 100, 30, 230, 150, 105, 185, rgb);
    h_put64(OBS, 144, h_get64(rgb, 0));
    h_put64(OBS, 152, h_get64(rgb, 8));
    h_put64(OBS, 160, h_get64(rgb, 16));
    // leg color: bottom-center, luma 110..175
    mean_rgb_box_band(px, gray, w, 110, 185, 210, 235, 110, 175, rgb);
    h_put64(OBS, 168, h_get64(rgb, 0));
    h_put64(OBS, 176, h_get64(rgb, 8));
    h_put64(OBS, 184, h_get64(rgb, 16));
    // torso vertical extent: bbox height of luma 105..185 mask in central box
    vis_band_mask(gray, mask2, n, 105, 185);
    let ty0:i64 = h; let ty1:i64 = -1;
    let tyy:i64 = 30;
    while (tyy <= 150) {
        let txx:i64 = 100;
        while (txx <= 230) {
            if (mask2[tyy * w + txx] == 1) {
                if (tyy < ty0) { ty0 = tyy; }
                if (tyy > ty1) { ty1 = tyy; }
            }
            txx = txx + 1;
        }
        tyy = tyy + 1;
    }
    if (ty1 >= ty0) { h_put64(OBS, 192, ty1 - ty0 + 1); }
    return 0;
}
// background color from frame edges (scaffold helper, not a decision).
fn bg_color(px:[]u8, gray:[]u8, w:i64, h:i64, rgb:[]u8) void {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0; let c:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < 30) {
            let id:i64 = y * w + x;
            let g:i64 = gray[id] as i64;
            if (g >= 100) {
                if (g <= 180) {
                    sr = sr + (px[id * 3] as i64); sg = sg + (px[id * 3 + 1] as i64); sb = sb + (px[id * 3 + 2] as i64); c = c + 1;
                }
            }
            x = x + 1;
        }
        x = w - 30;
        while (x < w) {
            let id:i64 = y * w + x;
            let g:i64 = gray[id] as i64;
            if (g >= 100) {
                if (g <= 180) {
                    sr = sr + (px[id * 3] as i64); sg = sg + (px[id * 3 + 1] as i64); sb = sb + (px[id * 3 + 2] as i64); c = c + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (c == 0) { h_put64(rgb, 0, 128); h_put64(rgb, 8, 128); h_put64(rgb, 16, 128); h_put64(rgb, 24, 0); return; }
    h_put64(rgb, 0, sr / c); h_put64(rgb, 8, sg / c); h_put64(rgb, 16, sb / c); h_put64(rgb, 24, c);
    return;
}
// ---------------- PHASE 1b: knowledge inventory ----------------
// Pig-anatomy propositions TNN would need, each verified present/absent in its
// committed held store. Verification (crew, 2026-09-26, recorded in design doc):
//   - teacher curriculum STIMULUS_TAPE.md (the 240-fact taught slice): grep for
//     pig/snout/boar/swine/trunk -> ZERO hits.
//   - units/teachers/curriculum inventories: only Shakespeare-vocabulary hits
//     (SHK-*.json word units), not anatomy facts.
//   - KB4 stores / 10GB generalist dry-run store: not installed into the
//     deliberating TNN; dry-run only, does not count as held knowledge.
// Result: TNN holds NO pig-face anatomy. The table below is the honest record.
// ctab field accessor (component table: 64 bytes/entry; area@0, x0@8, y0@16,
// x1@24, y1@32, cx@40, cy@48). Field ids: 0=area, 3=cx, 4=cy, 5=x0, 6=y0, 7=x1, 8=y1.
fn ctab_get(ctab:[]u8, i:i64, f:i64) i64 {
    let off:i64 = 0;
    if (f == 3) { off = 40; }
    else {
        if (f == 4) { off = 48; }
        else {
            if (f == 5) { off = 8; }
            else {
                if (f == 6) { off = 16; }
                else {
                    if (f == 7) { off = 24; }
                    else {
                        if (f == 8) { off = 32; }
                    }
                }
            }
        }
    }
    return h_get64(ctab, i * 64 + off);
}

// ---------------- TEACH MODE ----------------
// TNN's own intake machinery: observes frontal teaching frame(s) with the same
// vision primitives used in Phase 3, and records measured pig-front anatomy as
// a knowledge record. Pure measurement; no crew-authored facts.
//
// KNOW record (42 x i64, 336 bytes):
// 0:magic 0x5049474B 8:version(1) 16:nframes 24:frame_fnv
// 32:p1_held 40:sn_cx 48:sn_cy 56:sn_x0 64:sn_y0 72:sn_x1 80:sn_y1 88:sn_r 96:sn_g 104:sn_b
// 112:p2_held 120:e1_cx 128:e1_cy 136:e2_cx 144:e2_cy
// 152:p3_held 160:eL_cx 168:eL_cy 176:eR_cx 184:eR_cy
// 192:eL_x0 200:eL_y0 208:eL_x1 216:eL_y1 224:eR_x0 232:eR_y0 240:eR_x1 248:eR_y1
// 256:U_ear_sep 264:ear_mid_x 272:ear_line_y
// 280:sdx_milli 288:sdy_milli 296:sw_milli 304:sh_milli
// 312:sym_ear_off 320:sym_snout_off 328:head_cx_teach
fn rgb_of(px:[]u8, n:i64, gray:[]u8) void {
    vis_luma(px, gray, n);
    return;
}
fn zero_box(mask:[]u8, w:i64, x0:i64, y0:i64, bw:i64, bh:i64) void {
    let y:i64 = y0;
    while (y < y0 + bh) {
        let x:i64 = x0;
        while (x < x0 + bw) {
            mask[y * w + x] = 0;
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
fn pf_teach(t:[]u8, forka_dir:[]u8, out_dir:[]u8) i64 {
    let w:i64 = 320; let h:i64 = 240; let n:i64 = 76800; let n3:i64 = 230400;
    let fpx:[]u8 = nio_alloc(n3 as i32);
    let gray:[]u8 = nio_alloc(n as i32);
    let mask:[]u8 = nio_alloc(n as i32);
    let lab:[]u8 = nio_alloc((n * 8) as i32);
    let seen:[]u8 = nio_alloc(n as i32);
    let stack:[]u8 = nio_alloc((n * 32) as i32);
    let ctab:[]u8 = nio_alloc(65536);
    let rgb:[]u8 = nio_alloc(32);
    let KNOW:[]u8 = nio_alloc(336);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    let zi:i64 = 0;
    while (zi < 336) { KNOW[zi] = 0; zi = zi + 1; }
    h_put64(wo, 0, 0); h_put64(ho, 0, 0);
    tr_str(t, "TEACH MODE: pig-front intake via TNN vision machinery"); tr_nl(t);
    let froot:i64 = nio_open_root(forka_dir);
    let oroot:i64 = nio_open_root(out_dir);
    let nm:[]u8 = "teach_front_0030.ppm";
    if (read_ppm_gen(froot, nm, fpx, n, wo, ho) != 0) {
        tr_str(t, "ERR teach frame unreadable"); tr_nl(t); return 6;
    }
    rgb_of(fpx, n, gray);
    h_put64(KNOW, 0, 1347170891);
    h_put64(KNOW, 8, 1);
    h_put64(KNOW, 16, 1);
    h_put64(KNOW, 24, fnv1a(fpx));
    tr_str(t, "  frame teach_front_0030.ppm fnv1a="); tr_i64(t, fnv1a(fpx)); tr_nl(t);
    // head centroid (symmetry reference)
    vis_band_mask(gray, mask, n, 70, 175);
    zero_box(mask, w, 0, 150, 320, 90);
    label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    let hcx:i64 = 0; let best:i64 = 0; let li:i64 = 0;
    while (li < 1024) {
        let a:i64 = ctab_get(ctab, li, 0);
        if (a > best) {
            let cx:i64 = ctab_get(ctab, li, 3); let cy:i64 = ctab_get(ctab, li, 4);
            if (cx >= 150 and cx <= 320 and cy >= 0 and cy <= 240) { best = a; hcx = cx; }
        }
        li = li + 1;
    }
    h_put64(KNOW, 328, hcx);
    tr_str(t, "  head centroid x="); tr_i64(t, hcx); tr_nl(t);
    // snout (P1): dark compact blob, center-low
    vis_band_mask(gray, mask, n, 0, 95);
    label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    let sn_cx:i64 = -1; let sn_cy:i64 = -1;
    let sn_x0:i64 = 0; let sn_y0:i64 = 0; let sn_x1:i64 = 0; let sn_y1:i64 = 0;
    let sn_lid:i64 = 0;
    li = 0;
    while (li < 1024) {
        let a:i64 = ctab_get(ctab, li, 0);
        if (a >= 400 and a <= 15000) {
            let cx:i64 = ctab_get(ctab, li, 3); let cy:i64 = ctab_get(ctab, li, 4);
            if (cx >= 100 and cx <= 260 and cy >= 130 and cy <= 215 and cy > sn_cy) {
                sn_cx = cx; sn_cy = cy; sn_lid = li + 1;
                sn_x0 = ctab_get(ctab, li, 5); sn_y0 = ctab_get(ctab, li, 6);
                sn_x1 = ctab_get(ctab, li, 7); sn_y1 = ctab_get(ctab, li, 8);
            }
        }
        li = li + 1;
    }
    if (sn_cx >= 0) {
        h_put64(KNOW, 32, 1);
        h_put64(KNOW, 40, sn_cx); h_put64(KNOW, 48, sn_cy);
        h_put64(KNOW, 56, sn_x0); h_put64(KNOW, 64, sn_y0);
        h_put64(KNOW, 72, sn_x1); h_put64(KNOW, 80, sn_y1);
        mean_rgb_label(fpx, lab, n, sn_lid, rgb);
        let sn_r:i64 = h_get64(rgb, 0); let sn_g:i64 = h_get64(rgb, 8); let sn_b:i64 = h_get64(rgb, 16);
        h_put64(KNOW, 88, sn_r); h_put64(KNOW, 96, sn_g); h_put64(KNOW, 104, sn_b);
        tr_str(t, "  P1 snout HELD c=("); tr_i64(t, sn_cx); tr_str(t, ","); tr_i64(t, sn_cy);
        tr_str(t, ") rgb("); tr_i64(t, sn_r); tr_str(t, ","); tr_i64(t, sn_g);
        tr_str(t, ","); tr_i64(t, sn_b); tr_str(t, ")"); tr_nl(t);
    } else {
        tr_str(t, "  P1 snout NOT HELD"); tr_nl(t);
    }
    // ears (P3): two largest dark blobs in upper frame
    vis_band_mask(gray, mask, n, 0, 150);
    label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    let b1a:i64 = 0; let b1i:i64 = -1; let b2a:i64 = 0; let b2i:i64 = -1;
    li = 0;
    while (li < 1024) {
        let a:i64 = ctab_get(ctab, li, 0);
        let cy:i64 = ctab_get(ctab, li, 4);
        if (a > 800 and cy < 110) {
            if (a > b1a) { b2a = b1a; b2i = b1i; b1a = a; b1i = li; }
            else { if (a > b2a) { b2a = a; b2i = li; } }
        }
        li = li + 1;
    }
    let eLx:i64 = -1; let eLy:i64 = -1; let eRx:i64 = -1; let eRy:i64 = -1;
    if (b1i >= 0 and b2i >= 0) {
        let c1x:i64 = ctab_get(ctab, b1i, 3); let c1y:i64 = ctab_get(ctab, b1i, 4);
        let c2x:i64 = ctab_get(ctab, b2i, 3); let c2y:i64 = ctab_get(ctab, b2i, 4);
        // assign left/right; require clean split
        if (c1x < c2x) {
            if (c1x < 130 and c2x > 190) {
                eLx = c1x; eLy = c1y; eRx = c2x; eRy = c2y;
                h_put64(KNOW, 192, ctab_get(ctab, b1i, 5)); h_put64(KNOW, 200, ctab_get(ctab, b1i, 6));
                h_put64(KNOW, 208, ctab_get(ctab, b1i, 7)); h_put64(KNOW, 216, ctab_get(ctab, b1i, 8));
                h_put64(KNOW, 224, ctab_get(ctab, b2i, 5)); h_put64(KNOW, 232, ctab_get(ctab, b2i, 6));
                h_put64(KNOW, 240, ctab_get(ctab, b2i, 7)); h_put64(KNOW, 248, ctab_get(ctab, b2i, 8));
            }
        } else {
            if (c2x < 130 and c1x > 190) {
                eLx = c2x; eLy = c2y; eRx = c1x; eRy = c1y;
                h_put64(KNOW, 192, ctab_get(ctab, b2i, 5)); h_put64(KNOW, 200, ctab_get(ctab, b2i, 6));
                h_put64(KNOW, 208, ctab_get(ctab, b2i, 7)); h_put64(KNOW, 216, ctab_get(ctab, b2i, 8));
                h_put64(KNOW, 224, ctab_get(ctab, b1i, 5)); h_put64(KNOW, 232, ctab_get(ctab, b1i, 6));
                h_put64(KNOW, 240, ctab_get(ctab, b1i, 7)); h_put64(KNOW, 248, ctab_get(ctab, b1i, 8));
            }
        }
    }
    if (eLx >= 0) {
        h_put64(KNOW, 152, 1);
        h_put64(KNOW, 160, eLx); h_put64(KNOW, 168, eLy);
        h_put64(KNOW, 176, eRx); h_put64(KNOW, 184, eRy);
        tr_str(t, "  P3 ears HELD L=("); tr_i64(t, eLx); tr_str(t, ","); tr_i64(t, eLy);
        tr_str(t, ") R=("); tr_i64(t, eRx); tr_str(t, ","); tr_i64(t, eRy); tr_str(t, ")"); tr_nl(t);
    } else {
        tr_str(t, "  P3 ears NOT HELD"); tr_nl(t);
    }
    // eyes (P2): symmetric mid-tone pair above snout
    let ey1x:i64 = -1; let ey1y:i64 = -1; let ey2x:i64 = -1; let ey2y:i64 = -1;
    if (sn_cx >= 0) {
        vis_band_mask(gray, mask, n, 0, 105);
        label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
        let ne:i64 = 0;
        let exs:[]u8 = nio_alloc(64*8); let eys:[]u8 = nio_alloc(64*8);
        let ei:i64 = 0;
        while (ei < 64) { h_put64(exs, ei*8, 0); h_put64(eys, ei*8, 0); ei = ei + 1; }
        li = 0;
        while (li < 1024) {
            let a:i64 = ctab_get(ctab, li, 0);
            if (a >= 80 and a <= 800) {
                let cx:i64 = ctab_get(ctab, li, 3); let cy:i64 = ctab_get(ctab, li, 4);
                if (cx >= 60 and cx <= 290 and cy < sn_cy - 20 and ne < 64) {
                    h_put64(exs, ne*8, cx); h_put64(eys, ne*8, cy); ne = ne + 1;
                }
            }
            li = li + 1;
        }
        let bi:i64 = 0; let bj:i64 = 0; let bscore:i64 = 1000000000;
        let ii:i64 = 0;
        while (ii < ne) {
            let jj:i64 = ii + 1;
            while (jj < ne) {
                let ax:i64 = h_get64(exs, ii*8); let ay:i64 = h_get64(eys, ii*8);
                let bx:i64 = h_get64(exs, jj*8); let by:i64 = h_get64(eys, jj*8);
                let dx:i64 = ax - bx; if (dx < 0) { dx = 0 - dx; }
                let dy:i64 = ay - by; if (dy < 0) { dy = 0 - dy; }
                let mid:i64 = (ax + bx)/2; let mo:i64 = mid - hcx; if (mo < 0) { mo = 0 - mo; }
                if (dx >= 30 and dx <= 130 and dy <= 25 and mo <= 20) {
                    let s:i64 = mo*100 + dy;
                    if (s < bscore) { bscore = s; bi = ii; bj = jj; }
                }
                jj = jj + 1;
            }
            ii = ii + 1;
        }
        tr_str(t, "  eye candidates in band: "); tr_i64(t, ne); tr_nl(t);
        if (bscore < 1000000000) {
            ey1x = h_get64(exs, bi*8); ey1y = h_get64(eys, bi*8);
            ey2x = h_get64(exs, bj*8); ey2y = h_get64(eys, bj*8);
            h_put64(KNOW, 112, 1);
            h_put64(KNOW, 120, ey1x); h_put64(KNOW, 128, ey1y);
            h_put64(KNOW, 136, ey2x); h_put64(KNOW, 144, ey2y);
            tr_str(t, "  P2 eyes HELD"); tr_nl(t);
        } else {
            tr_str(t, "  P2 eyes NOT HELD: no symmetric pair isolable from speckles"); tr_nl(t);
        }
        nio_free(exs); nio_free(eys);
    } else {
        tr_str(t, "  P2 eyes NOT HELD: snout absent, no reference"); tr_nl(t);
    }
    // layout descriptors (P4/P5): ear-separation-normalized, origin at ear mid/ear line
    if (h_get64(KNOW, 32) == 1 and h_get64(KNOW, 152) == 1) {
        let U:i64 = eRx - eLx;
        let emx:i64 = (eLx + eRx)/2;
        let ely:i64 = (eLy + eRy)/2;
        h_put64(KNOW, 256, U); h_put64(KNOW, 264, emx); h_put64(KNOW, 272, ely);
        h_put64(KNOW, 280, (sn_cx - emx)*1000/U);
        h_put64(KNOW, 288, (sn_cy - ely)*1000/U);
        h_put64(KNOW, 296, (sn_x1 - sn_x0 + 1)*1000/U);
        h_put64(KNOW, 304, (sn_y1 - sn_y0 + 1)*1000/U);
        let eo:i64 = emx - hcx; if (eo < 0) { eo = 0 - eo; }
        let so:i64 = sn_cx - hcx; if (so < 0) { so = 0 - so; }
        h_put64(KNOW, 312, eo); h_put64(KNOW, 320, so);
        tr_str(t, "  descriptors U="); tr_i64(t, U);
        tr_str(t, " ear_mid="); tr_i64(t, emx); tr_str(t, " ear_line="); tr_i64(t, ely); tr_nl(t);
        tr_str(t, "  sdx_m="); tr_i64(t, h_get64(KNOW, 280));
        tr_str(t, " sdy_m="); tr_i64(t, h_get64(KNOW, 288));
        tr_str(t, " sw_m="); tr_i64(t, h_get64(KNOW, 296));
        tr_str(t, " sh_m="); tr_i64(t, h_get64(KNOW, 304)); tr_nl(t);
    }
    // write knowledge.bin (raw KNOW record) + knowledge.txt (human-readable)
    let kb:[]u8 = "knowledge.bin";
    if (write_file_all(oroot, kb, KNOW, 336) != 0) { tr_str(t, "ERR write knowledge.bin"); tr_nl(t); return 7; }
    tr_str(t, "  wrote knowledge.bin fnv1a="); tr_i64(t, fnv1a(KNOW)); tr_nl(t);
    let kt:[]u8 = tr_init(8192);
    tr_str(kt, "PIG-FRONT TEACHING RECORD (TNN intake, measured, no crew facts)"); tr_nl(kt);
    tr_str(kt, "teaching frames: 1  file: teach_front_0030.ppm  frame_fnv1a="); tr_i64(kt, h_get64(KNOW, 24)); tr_nl(kt);
    tr_str(kt, "P1 snout: "); if (h_get64(KNOW, 32) == 1) { tr_str(kt, "HELD"); } else { tr_str(kt, "NOT HELD"); }
    tr_str(kt, " c=("); tr_i64(kt, h_get64(KNOW, 40)); tr_str(kt, ","); tr_i64(kt, h_get64(KNOW, 48));
    tr_str(kt, ") bbox=("); tr_i64(kt, h_get64(KNOW, 56)); tr_str(kt, ","); tr_i64(kt, h_get64(KNOW, 64));
    tr_str(kt, ")-("); tr_i64(kt, h_get64(KNOW, 72)); tr_str(kt, ","); tr_i64(kt, h_get64(KNOW, 80));
    tr_str(kt, ") rgb("); tr_i64(kt, h_get64(KNOW, 88)); tr_str(kt, ","); tr_i64(kt, h_get64(KNOW, 96));
    tr_str(kt, ","); tr_i64(kt, h_get64(KNOW, 104)); tr_str(kt, ")"); tr_nl(kt);
    tr_str(kt, "P2 eyes: "); if (h_get64(KNOW, 112) == 1) { tr_str(kt, "HELD"); } else { tr_str(kt, "NOT HELD"); }
    tr_nl(kt);
    tr_str(kt, "P3 ears: "); if (h_get64(KNOW, 152) == 1) { tr_str(kt, "HELD"); } else { tr_str(kt, "NOT HELD"); }
    tr_str(kt, " L=("); tr_i64(kt, h_get64(KNOW, 160)); tr_str(kt, ","); tr_i64(kt, h_get64(KNOW, 168));
    tr_str(kt, ") R=("); tr_i64(kt, h_get64(KNOW, 176)); tr_str(kt, ","); tr_i64(kt, h_get64(KNOW, 184));
    tr_str(kt, ")"); tr_nl(kt);
    tr_str(kt, "P4 layout: PARTIAL (snout center-low + ears top-sides measured; eyes-above not measured)"); tr_nl(kt);
    tr_str(kt, "P5 symmetry: measured ear-mid off head-cx by "); tr_i64(kt, h_get64(KNOW, 312));
    tr_str(kt, "px; snout-cx off by "); tr_i64(kt, h_get64(KNOW, 320)); tr_str(kt, "px (evidence, not a rule)"); tr_nl(kt);
    tr_str(kt, "P6 ear mobility: NOT HELD (single static frame)"); tr_nl(kt);
    tr_str(kt, "descriptors: U="); tr_i64(kt, h_get64(KNOW, 256));
    tr_str(kt, " ear_mid="); tr_i64(kt, h_get64(KNOW, 264));
    tr_str(kt, " ear_line="); tr_i64(kt, h_get64(KNOW, 272));
    tr_str(kt, " sdx_m="); tr_i64(kt, h_get64(KNOW, 280));
    tr_str(kt, " sdy_m="); tr_i64(kt, h_get64(KNOW, 288));
    tr_str(kt, " sw_m="); tr_i64(kt, h_get64(KNOW, 296));
    tr_str(kt, " sh_m="); tr_i64(kt, h_get64(KNOW, 304)); tr_nl(kt);
    let kt2:[]u8 = "knowledge.txt";
    if (write_file_all(oroot, kt2, tr_get(kt), tr_pos(kt)) != 0) { tr_str(t, "ERR write knowledge.txt"); tr_nl(t); return 8; }
    tr_str(t, "  wrote knowledge.txt"); tr_nl(t);
    tr_str(t, "END TEACH"); tr_nl(t);
    nio_close(froot); nio_close(oroot);
    nio_free(fpx); nio_free(gray); nio_free(mask); nio_free(lab);
    nio_free(seen); nio_free(stack); nio_free(ctab); nio_free(rgb);
    nio_free(KNOW); nio_free(wo); nio_free(ho); nio_free(kt);
    return 0;
}

// read a knowledge record; returns 1 if valid (magic matches, full 336 bytes), else 0
fn read_knowledge(root:i64, K:[]u8) i64 {
    let nm:[]u8 = "knowledge.bin";
    let zi:i64 = 0;
    while (zi < 336) { K[zi] = 0; zi = zi + 1; }
    if (read_file(root, nm, K, 336) != 336) { return 0; }
    if (h_get64(K, 0) != 1347170891) { return 0; }
    if (h_get64(K, 8) != 1) { return 0; }
    return 1;
}

fn knowledge_trace(t:[]u8, K:[]u8, taught:i64) void {
    tr_str(t, "KNOWLEDGE INVENTORY (pig-anatomy propositions):"); tr_nl(t);
    if (taught == 0) {
        tr_str(t, "  P1 'pigs have a snout on the front of the face': NOT HELD"); tr_nl(t);
        tr_str(t, "  P2 'pigs have two eyes above the snout': NOT HELD"); tr_nl(t);
        tr_str(t, "  P3 'pigs have two ears at the top sides of the head': NOT HELD"); tr_nl(t);
        tr_str(t, "  P4 'pig face layout (eyes-above, snout center-low, ears top)': NOT HELD"); tr_nl(t);
        tr_str(t, "  P5 'mammalian bilateral facial symmetry' as a proposition: NOT HELD"); tr_nl(t);
        tr_str(t, "  P6 'pig ears are mobile / upright when head-up': NOT HELD"); tr_nl(t);
        tr_str(t, "  Provenance: stimulus-tape grep (pig/snout/boar/swine/trunk) = 0 hits;"); tr_nl(t);
        tr_str(t, "  curriculum inventory hits are Shakespeare word-units, not anatomy;"); tr_nl(t);
        tr_str(t, "  10GB generalist store is dry-run only, not installed. No web search,"); tr_nl(t);
        tr_str(t, "  no LLM stand-in, no crew knowledge used. What is not held does not count."); tr_nl(t);
        return;
    }
    tr_str(t, "  [TAUGHT via TNN intake: 1 frontal frame, fnv1a="); tr_i64(t, h_get64(K, 24)); tr_str(t, "]"); tr_nl(t);
    tr_str(t, "  P1 'pigs have a snout on the front of the face': ");
    if (h_get64(K, 32) == 1) { tr_str(t, "HELD"); } else { tr_str(t, "NOT HELD"); }
    tr_str(t, " (measured c=("); tr_i64(t, h_get64(K, 40)); tr_str(t, ","); tr_i64(t, h_get64(K, 48)); tr_str(t, "))"); tr_nl(t);
    tr_str(t, "  P2 'pigs have two eyes above the snout': ");
    if (h_get64(K, 112) == 1) { tr_str(t, "HELD"); } else { tr_str(t, "NOT HELD"); }
    tr_str(t, " (no symmetric pair isolable from speckles; eyes stay un-drawn)"); tr_nl(t);
    tr_str(t, "  P3 'pigs have two ears at the top sides of the head': ");
    if (h_get64(K, 152) == 1) { tr_str(t, "HELD"); } else { tr_str(t, "NOT HELD"); }
    tr_str(t, " (measured L=("); tr_i64(t, h_get64(K, 160)); tr_str(t, ","); tr_i64(t, h_get64(K, 168));
    tr_str(t, ") R=("); tr_i64(t, h_get64(K, 176)); tr_str(t, ","); tr_i64(t, h_get64(K, 184)); tr_str(t, "))"); tr_nl(t);
    tr_str(t, "  P4 'pig face layout': PARTIAL (snout center-low + ears top-sides measured; eyes-above not measured)"); tr_nl(t);
    tr_str(t, "  P5 'symmetry': measured evidence only (ear-mid off "); tr_i64(t, h_get64(K, 312));
    tr_str(t, "px, snout off "); tr_i64(t, h_get64(K, 320)); tr_str(t, "px; not a rule)"); tr_nl(t);
    tr_str(t, "  P6 'pig ears are mobile / upright when head-up': NOT HELD (single static frame)"); tr_nl(t);
    tr_str(t, "  Provenance: TNN intake on teach_front_0030.ppm (own vision machinery)."); tr_nl(t);
    tr_str(t, "  -> face zone becomes TAUGHT where P1/P3 cover; P2/P6 regions stay un-drawn."); tr_nl(t);
    return;
}
// ---------------- render helpers ----------------
fn fill_ellipse(px:[]u8, w:i64, h:i64, cx:i64, cy:i64, rx:i64, ry:i64, r:i64, g:i64, b:i64) void {
    let y:i64 = cy - ry;
    if (y < 0) { y = 0; }
    let y1:i64 = cy + ry;
    if (y1 >= h) { y1 = h - 1; }
    while (y <= y1) {
        let dy:i64 = y - cy;
        // rx_at_y = rx*sqrt(1-(dy/ry)^2); integer approx via rx*(ry^2-dy^2)/ry^2 sqrt by scan
        let x:i64 = cx - rx;
        if (x < 0) { x = 0; }
        let x1:i64 = cx + rx;
        if (x1 >= w) { x1 = w - 1; }
        while (x <= x1) {
            let dx:i64 = x - cx;
            // inside test: dx^2*ry^2 + dy^2*rx^2 <= rx^2*ry^2
            let lhs:i64 = dx * dx * ry * ry + dy * dy * rx * rx;
            let rhs:i64 = rx * rx * ry * ry;
            if (lhs <= rhs) {
                let id:i64 = y * w + x;
                px[id * 3] = r as u8; px[id * 3 + 1] = g as u8; px[id * 3 + 2] = b as u8;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
fn fill_rect(px:[]u8, w:i64, h:i64, x0:i64, y0:i64, x1:i64, y1:i64, r:i64, g:i64, b:i64) void {
    let y:i64 = y0;
    if (y < 0) { y = 0; }
    if (y1 >= h) { y1 = h - 1; }
    while (y <= y1) {
        let x:i64 = x0;
        if (x < 0) { x = 0; }
        let xe:i64 = x1;
        if (xe >= w) { xe = w - 1; }
        while (x <= xe) {
            let id:i64 = y * w + x;
            px[id * 3] = r as u8; px[id * 3 + 1] = g as u8; px[id * 3 + 2] = b as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
// UNKNOWN marker: diagonal magenta/black stripes, 6px bands.
fn stripe_ellipse(px:[]u8, w:i64, h:i64, cx:i64, cy:i64, rx:i64, ry:i64) void {
    let y:i64 = cy - ry;
    if (y < 0) { y = 0; }
    let y1:i64 = cy + ry;
    if (y1 >= h) { y1 = h - 1; }
    while (y <= y1) {
        let dy:i64 = y - cy;
        let x:i64 = cx - rx;
        if (x < 0) { x = 0; }
        let x1:i64 = cx + rx;
        if (x1 >= w) { x1 = w - 1; }
        while (x <= x1) {
            let dx:i64 = x - cx;
            let lhs:i64 = dx * dx * ry * ry + dy * dy * rx * rx;
            let rhs:i64 = rx * rx * ry * ry;
            if (lhs <= rhs) {
                let id:i64 = y * w + x;
                let band:i64 = (x + y) / 6;
                if ((band % 2) == 0) {
                    px[id * 3] = 255; px[id * 3 + 1] = 0; px[id * 3 + 2] = 255;
                } else {
                    px[id * 3] = 0; px[id * 3 + 1] = 0; px[id * 3 + 2] = 0;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}

// Realistic fur renderer: deterministic procedural texture (NOT rng).
// Pure function of (x,y,seed); byte-identical on every run.
// Texture amplitudes MEASURED from donors: head grain~14, mottle~20.
fn pf_hash2(x:i64, y:i64, s:i64) i64 {
    let h:i64 = x * 374761393 + y * 668265263 + s * 974634211;
    h = h ^ (h >> 13);
    h = h * 1274126177;
    h = h ^ (h >> 16);
    if (h < 0) { h = -h; }
    return h;
}
fn pf_grain(x:i64, y:i64, s:i64, amp:i64) i64 {
    let h:i64 = pf_hash2(x, y, s);
    return (h % (2 * amp + 1)) - amp;
}
fn pf_vnoise(x:i64, y:i64, s:i64, per:i64, amp:i64) i64 {
    let gx:i64 = x / per;
    let gy:i64 = y / per;
    let fx:i64 = (x - gx * per) * 256 / per;
    let fy:i64 = (y - gy * per) * 256 / per;
    let h00:i64 = (pf_hash2(gx, gy, s) % 512) - 256;
    let h10:i64 = (pf_hash2(gx + 1, gy, s) % 512) - 256;
    let h01:i64 = (pf_hash2(gx, gy + 1, s) % 512) - 256;
    let h11:i64 = (pf_hash2(gx + 1, gy + 1, s) % 512) - 256;
    let tx:i64 = h00 * (256 - fx) + h10 * fx;
    let bx:i64 = h01 * (256 - fx) + h11 * fx;
    let v:i64 = (tx * (256 - fy) + bx * fy) / 65536;
    return v * amp / 256;
}
fn pf_blend(px:[]u8, w:i64, x:i64, y:i64, r:i64, g:i64, b:i64, a:i64) void {
    let o:i64 = (y * w + x) * 3;
    let dr:i64 = px[o] as i64;
    let dg:i64 = px[o + 1] as i64;
    let db:i64 = px[o + 2] as i64;
    if (r < 0) { r = 0; }
    if (r > 255) { r = 255; }
    if (g < 0) { g = 0; }
    if (g > 255) { g = 255; }
    if (b < 0) { b = 0; }
    if (b > 255) { b = 255; }
    px[o] = ((r * a + dr * (256 - a)) / 256) as u8;
    px[o + 1] = ((g * a + dg * (256 - a)) / 256) as u8;
    px[o + 2] = ((b * a + db * (256 - a)) / 256) as u8;
    return;
}
fn pf_fur_ellipse(px:[]u8, w:i64, h:i64, cx:i64, cy:i64, rx:i64, ry:i64, br:i64, bgc:i64, bb:i64, grain_amp:i64, mott_amp:i64, mott_per:i64, shade:i64, seed:i64, feather:i64, detail:i64) void {
    let x0:i64 = cx - rx - feather;
    if (x0 < 0) { x0 = 0; }
    let x1:i64 = cx + rx + feather;
    if (x1 >= w) { x1 = w - 1; }
    let y0:i64 = cy - ry - feather;
    if (y0 < 0) { y0 = 0; }
    let y1:i64 = cy + ry + feather;
    if (y1 >= h) { y1 = h - 1; }
    let rx2:i64 = rx * rx;
    if (rx2 == 0) { rx2 = 1; }
    let ry2:i64 = ry * ry;
    if (ry2 == 0) { ry2 = 1; }
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let dx:i64 = x - cx;
            let dy:i64 = y - cy;
            let nd:i64 = (dx * dx * 1024) / rx2 + (dy * dy * 1024) / ry2;
            if (nd < 1024 + feather * 80) {
                let a:i64 = 256;
                if (nd > 1024) {
                    a = 256 - (nd - 1024) * 256 / (feather * 80 + 1);
                    if (a < 0) { a = 0; }
                }
                let t:i64 = nd * 100 / 1024;
                if (t > 100) { t = 100; }
                let rad:i64 = 100 - shade * t / 100;
                let vy:i64 = (y - (cy - ry)) * 100 / (2 * ry + 1);
                if (vy < 0) { vy = 0; }
                if (vy > 100) { vy = 100; }
                let vert:i64 = 112 - vy * 30 / 100;
                let lum:i64 = rad * vert / 100;
                let tex:i64 = 0;
                if (detail == 1) {
                    tex = pf_vnoise(x, y, seed, mott_per, mott_amp) + pf_grain(x, y, seed + 1, grain_amp) + pf_grain(x, y / 3, seed + 2, grain_amp / 2);
                } else {
                    lum = 100 + (lum - 100) / 3;
                    tex = pf_vnoise(x, y, seed, mott_per * 2, mott_amp / 3);
                }
                let r:i64 = br * lum / 100 + tex;
                let g:i64 = bgc * lum / 100 + tex;
                let b:i64 = bb * lum / 100 + tex;
                pf_blend(px, w, x, y, r, g, b, a);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
fn pf_fur_rect(px:[]u8, w:i64, h:i64, x0:i64, y0:i64, x1:i64, y1:i64, br:i64, bgc:i64, bb:i64, grain_amp:i64, mott_amp:i64, mott_per:i64, shade:i64, seed:i64) void {
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 >= w) { x1 = w - 1; }
    if (y1 >= h) { y1 = h - 1; }
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let fx:i64 = (x - x0) * 100 / (x1 - x0 + 1);
            let edge:i64 = fx;
            if (fx > 50) { edge = 100 - fx; }
            let lum:i64 = 100 - shade * (50 - edge) / 50;
            let vy:i64 = (y - y0) * 100 / (y1 - y0 + 1);
            lum = lum * (108 - vy * 20 / 100) / 100;
            let tex:i64 = pf_vnoise(x, y, seed, mott_per, mott_amp) + pf_grain(x, y, seed + 1, grain_amp);
            let r:i64 = br * lum / 100 + tex;
            let g:i64 = bgc * lum / 100 + tex;
            let b:i64 = bb * lum / 100 + tex;
            if (r < 0) { r = 0; }
            if (r > 255) { r = 255; }
            if (g < 0) { g = 0; }
            if (g > 255) { g = 255; }
            if (b < 0) { b = 0; }
            if (b > 255) { b = 255; }
            let o:i64 = (y * w + x) * 3;
            px[o] = r as u8;
            px[o + 1] = g as u8;
            px[o + 2] = b as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
fn render_construct(px:[]u8, w:i64, h:i64, n:i64, PLAN:[]u8) void {
    let taught:i64 = h_get64(PLAN, 232);
    let bgr:i64 = h_get64(PLAN, 184);
    let bgg:i64 = h_get64(PLAN, 192);
    let bgb:i64 = h_get64(PLAN, 200);
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let tex:i64 = pf_vnoise(x, y, 9001, 14, 16) + pf_grain(x, y, 9002, 7);
            let o:i64 = (y * w + x) * 3;
            let r:i64 = bgr + tex;
            if (r < 0) { r = 0; }
            if (r > 255) { r = 255; }
            let g:i64 = bgg + tex;
            if (g < 0) { g = 0; }
            if (g > 255) { g = 255; }
            let b:i64 = bgb + tex;
            if (b < 0) { b = 0; }
            if (b > 255) { b = 255; }
            px[o] = r as u8;
            px[o + 1] = g as u8;
            px[o + 2] = b as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    pf_fur_ellipse(px, w, h, h_get64(PLAN, 80), h_get64(PLAN, 88), h_get64(PLAN, 96), h_get64(PLAN, 104), h_get64(PLAN, 136), h_get64(PLAN, 144), h_get64(PLAN, 152), 10, 15, 8, 26, 1001, 5, 1);
    let lr:i64 = h_get64(PLAN, 160);
    let lg:i64 = h_get64(PLAN, 168);
    let lb:i64 = h_get64(PLAN, 176);
    pf_fur_rect(px, w, h, 126, 206, 148, 236, lr, lg, lb, 10, 15, 8, 22, 1002);
    pf_fur_rect(px, w, h, 172, 206, 194, 236, lr, lg, lb, 10, 15, 8, 22, 1003);
    let hr:i64 = h_get64(PLAN, 112);
    let hg:i64 = h_get64(PLAN, 120);
    let hb:i64 = h_get64(PLAN, 128);
    pf_fur_ellipse(px, w, h, h_get64(PLAN, 0), h_get64(PLAN, 8), h_get64(PLAN, 16), h_get64(PLAN, 24), hr, hg, hb, 14, 20, 8, 30, 2001, 5, 1);
    pf_fur_ellipse(px, w, h, h_get64(PLAN, 32), h_get64(PLAN, 40), h_get64(PLAN, 48), h_get64(PLAN, 56), hr, hg, hb, 14, 20, 8, 30, 2002, 4, 0);
    if (taught == 0) {
        let er:i64 = h_get64(PLAN, 208);
        let eg:i64 = h_get64(PLAN, 216);
        let eb:i64 = h_get64(PLAN, 224);
        let erx:i64 = h_get64(PLAN, 64);
        let ery:i64 = h_get64(PLAN, 72);
        let ecx:i64 = h_get64(PLAN, 0) - h_get64(PLAN, 16) - 6;
        let ecy:i64 = h_get64(PLAN, 8) + 10;
        pf_fur_ellipse(px, w, h, ecx, ecy, erx, ery, er, eg, eb, 12, 18, 8, 28, 3001, 4, 1);
        ecx = h_get64(PLAN, 0) + h_get64(PLAN, 16) + 6;
        pf_fur_ellipse(px, w, h, ecx, ecy, erx, ery, er, eg, eb, 12, 18, 8, 28, 3002, 4, 1);
    } else {
        let er:i64 = h_get64(PLAN, 208);
        let eg:i64 = h_get64(PLAN, 216);
        let eb:i64 = h_get64(PLAN, 224);
        pf_fur_ellipse(px, w, h, h_get64(PLAN, 296), h_get64(PLAN, 304), h_get64(PLAN, 64), h_get64(PLAN, 72), er, eg, eb, 12, 18, 8, 28, 3001, 4, 1);
        pf_fur_ellipse(px, w, h, h_get64(PLAN, 312), h_get64(PLAN, 320), h_get64(PLAN, 64), h_get64(PLAN, 72), er, eg, eb, 12, 18, 8, 28, 3002, 4, 1);
        pf_fur_ellipse(px, w, h, h_get64(PLAN, 240), h_get64(PLAN, 248), h_get64(PLAN, 256), h_get64(PLAN, 264), h_get64(PLAN, 272), h_get64(PLAN, 280), h_get64(PLAN, 288), 8, 12, 6, 24, 4001, 3, 1);
    }
    return;
}

// Epistemic map: EXTRAPOLATED=(230,200,0) yellow, UNKNOWN=(255,0,255) magenta.
// (No pixel position is observed in a novel view; OBSERVED marks properties,
// listed in the trace property table.)
fn render_epimap(px:[]u8, w:i64, h:i64, n:i64, PLAN:[]u8) void {
    let i:i64 = 0;
    while (i < n) { px[i * 3] = 230; px[i * 3 + 1] = 200; px[i * 3 + 2] = 0; i = i + 1; }
    if (h_get64(PLAN, 232) == 0) {
    // every region is EXTRAPOLATED geometry (yellow base) except the face zone
    stripe_ellipse(px, w, h, h_get64(PLAN, 32), h_get64(PLAN, 40), h_get64(PLAN, 48), h_get64(PLAN, 56));
    // repaint stripes as solid magenta for the map (cleaner legend)
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let id:i64 = y * w + x;
            if (px[id * 3] == 255) {
                if (px[id * 3 + 1] == 0) {
                    if (px[id * 3 + 2] == 255) {
                        // keep magenta
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    } else {
    // TAUGHT: yellow base (EXTRAPOLATED); cyan = TAUGHT snout+ears; magenta = UNKNOWN (eyes, P2 not held).
    // Draw UNKNOWN eye-zone first (magenta), then TAUGHT snout/ears (cyan) on top.
    stripe_ellipse(px, w, h, h_get64(PLAN, 32), h_get64(PLAN, 40), h_get64(PLAN, 48), h_get64(PLAN, 56));
    fill_ellipse(px, w, h, h_get64(PLAN, 240), h_get64(PLAN, 248),
        h_get64(PLAN, 256), h_get64(PLAN, 264), 0, 200, 255);
    fill_ellipse(px, w, h, h_get64(PLAN, 296), h_get64(PLAN, 304),
        h_get64(PLAN, 64), h_get64(PLAN, 72), 0, 200, 255);
    fill_ellipse(px, w, h, h_get64(PLAN, 312), h_get64(PLAN, 320),
        h_get64(PLAN, 64), h_get64(PLAN, 72), 0, 200, 255);
    }
    return;
}
// ---------------- PHASE 1c: deliberation -> plan ----------------
// AGG layout (26 xi64):
// 0:n_ok 8:head_w 16:head_h 24:head_r 32:head_g 40:head_b
// 48:ear_frames 56:ear_w 64:ear_h 72:ear_r 80:ear_g 88:ear_b
// 96:eye_pair_frames 104:head_down_frames 112:torso_r 120:torso_g 128:torso_b
// 136:leg_r 144:leg_g 152:leg_b 160:bg_r 168:bg_g 176:bg_b 184:torso_h
fn deliberate(t:[]u8, AGG:[]u8, PLAN:[]u8, K:[]u8, taught:i64) void {
    tr_str(t, "DELIBERATION (TNN's own region-by-region decisions):"); tr_nl(t);
    tr_str(t, "  Epistemic rule for a novel view: no PIXEL POSITION is observed in a"); tr_nl(t);
    tr_str(t, "  view I have never seen. OBSERVED marks PROPERTIES carried over"); tr_nl(t);
    tr_str(t, "  (colors, existence). Geometry in the new view is EXTRAPOLATED."); tr_nl(t);
    if (taught == 0) {
    tr_str(t, "  The face is UNKNOWN: the eye-pair detector fired in ");
    tr_i64(t, h_get64(AGG, 96));
    tr_str(t, "/24 frames, BUT these are side-view spot pairs (eye + light");
    tr_nl(t);
    tr_str(t, "  fur patches on the dark head mass), NOT frontal-face geometry.");
    tr_nl(t);
    tr_str(t, "  The detector also finds NO pair in the real frontal truth frame");
    tr_nl(t);
    tr_str(t, "  (see Phase 3), proving it is not a valid frontal-face test.");
    tr_nl(t);
    tr_str(t, "  Valid evidence: all 24 frames are side/back views, head down;");
    tr_nl(t);
    tr_str(t, "  0/24 FRONTAL faces observed. No anatomy proposition is held");
    tr_nl(t);
    tr_str(t, "  (P1..P6 all NOT HELD).");
    tr_nl(t);
    }
    let head_h:i64 = h_get64(AGG, 16);
    let head_w:i64 = h_get64(AGG, 8);
    // head geometry: height measured; width unobserved in front view ->
    // placeholder = height (near-round skull approx), HIGH UNCERTAINTY noted.
    let hrx:i64 = head_h / 2;
    let hry:i64 = head_h / 2;
    if (hrx < 20) { hrx = 40; }
    if (hry < 20) { hry = 40; }
    h_put64(PLAN, 232, taught);
    if (taught == 0) {
    h_put64(PLAN, 0, 160); h_put64(PLAN, 8, 82);
    h_put64(PLAN, 16, hrx); h_put64(PLAN, 24, hry);
    h_put64(PLAN, 112, h_get64(AGG, 24));
    h_put64(PLAN, 120, h_get64(AGG, 32));
    h_put64(PLAN, 128, h_get64(AGG, 40));
    tr_str(t, "  R_HEAD @ (160,82) rx="); tr_i64(t, hrx); tr_str(t, " ry="); tr_i64(t, hry);
    tr_str(t, ": color OBSERVED (24/24 frames, rgb "); tr_i64(t, h_get64(AGG, 24));
    tr_str(t, ","); tr_i64(t, h_get64(AGG, 32)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 40));
    tr_str(t, "); shape/position EXTRAPOLATED (front width unobserved;");
    tr_nl(t);
    tr_str(t, "    placeholder=measured height; chain: skull approx round, uncertainty HIGH).");
    tr_nl(t);
    // face zone: UNKNOWN
    let frx:i64 = hrx * 3 / 10; let fry:i64 = hry * 26 / 100;
    h_put64(PLAN, 32, 160); h_put64(PLAN, 40, 82 + hry * 18 / 100);
    h_put64(PLAN, 48, frx); h_put64(PLAN, 56, fry);
    tr_str(t, "  R_FACEZONE @ (160,"); tr_i64(t, 82 + hry * 18 / 100);
    tr_str(t, ") rx="); tr_i64(t, frx); tr_str(t, " ry="); tr_i64(t, fry);
    tr_str(t, ": UNKNOWN (0/24 frontal faces; P1/P2/P4 not held)."); tr_nl(t);
    tr_str(t, "    Rendered as marked stripes, never filled silently."); tr_nl(t);
    // ears: existence OBSERVED (ear_frames/24), placement EXTRAPOLATED
    h_put64(PLAN, 64, h_get64(AGG, 56) / 2); h_put64(PLAN, 72, h_get64(AGG, 64) / 2);
    h_put64(PLAN, 208, h_get64(AGG, 72));
    h_put64(PLAN, 216, h_get64(AGG, 80));
    h_put64(PLAN, 224, h_get64(AGG, 88));
    tr_str(t, "  R_EARS: existence OBSERVED (flap detected in "); tr_i64(t, h_get64(AGG, 48));
    tr_str(t, "/24 frames, mean size "); tr_i64(t, h_get64(AGG, 56)); tr_str(t, "x");
    tr_i64(t, h_get64(AGG, 64)); tr_str(t, "); placement EXTRAPOLATED"); tr_nl(t);
    tr_str(t, "    (chain: observed hanging at head SIDES in side view -> placed at head");
    tr_nl(t);
    tr_str(t, "    sides in front view; front posture unknown, P6 not held)."); tr_nl(t);
    } else {
    // ---- TAUGHT BRANCH: geometry informed by installed frontal knowledge ----
    // Head center revised: the frontal head must contain the taught ears (top)
    // and the taught snout (sdy below the ear line). hcy=112 is the lowest
    // center keeping the ear flaps (donor ry) on-screen with a small margin.
    let hcy:i64 = 112;
    h_put64(PLAN, 0, 160); h_put64(PLAN, 8, hcy);
    h_put64(PLAN, 16, hrx); h_put64(PLAN, 24, hry);
    h_put64(PLAN, 112, h_get64(AGG, 24));
    h_put64(PLAN, 120, h_get64(AGG, 32));
    h_put64(PLAN, 128, h_get64(AGG, 40));
    tr_str(t, "  R_HEAD @ (160,"); tr_i64(t, hcy); tr_str(t, ") rx="); tr_i64(t, hrx);
    tr_str(t, " ry="); tr_i64(t, hry);
    tr_str(t, ": color OBSERVED (24/24 frames); center REVISED by taught"); tr_nl(t);
    tr_str(t, "    layout (frontal head must hold taught ears at top and taught snout"); tr_nl(t);
    tr_str(t, "    below; 112 = lowest center with ear flaps on-screen)."); tr_nl(t);
    // face = frontal head (the face IS the head in a frontal view); TAUGHT zone
    h_put64(PLAN, 32, 160); h_put64(PLAN, 40, hcy);
    h_put64(PLAN, 48, hrx); h_put64(PLAN, 56, hry);
    tr_str(t, "  R_FACEZONE @ (160,"); tr_i64(t, hcy); tr_str(t, ") rx="); tr_i64(t, hrx);
    tr_str(t, " ry="); tr_i64(t, hry); tr_str(t, ": TAUGHT (face = frontal head)."); tr_nl(t);
    // ears: OBSERVED size/color, TAUGHT top-sides position via descriptors
    let erx:i64 = h_get64(AGG, 56) / 2; let ery:i64 = h_get64(AGG, 64) / 2;
    h_put64(PLAN, 64, erx); h_put64(PLAN, 72, ery);
    h_put64(PLAN, 208, h_get64(AGG, 72));
    h_put64(PLAN, 216, h_get64(AGG, 80));
    h_put64(PLAN, 224, h_get64(AGG, 88));
    let Uc:i64 = 2 * hrx;
    let eline:i64 = hcy - hry;
    let eLx:i64 = 160 - hrx; let eRx:i64 = 160 + hrx;
    h_put64(PLAN, 296, eLx); h_put64(PLAN, 304, eline);
    h_put64(PLAN, 312, eRx); h_put64(PLAN, 320, eline);
    h_put64(PLAN, 328, eline);
    tr_str(t, "  R_EARS: size/color OBSERVED ("); tr_i64(t, h_get64(AGG, 48));
    tr_str(t, "/24 frames); position TAUGHT: ear-mid <-> head top ("); tr_i64(t, eline);
    tr_str(t, "), U <-> head width ("); tr_i64(t, Uc); tr_str(t, ")"); tr_nl(t);
    tr_str(t, "    -> earL ("); tr_i64(t, eLx); tr_str(t, ","); tr_i64(t, eline);
    tr_str(t, ") earR ("); tr_i64(t, eRx); tr_str(t, ","); tr_i64(t, eline); tr_str(t, ")"); tr_nl(t);
    // snout: TAUGHT position/size/color via ear-normalized descriptors
    let sdx:i64 = h_get64(K, 280); let sdy:i64 = h_get64(K, 288);
    let swm:i64 = h_get64(K, 296); let shm:i64 = h_get64(K, 304);
    let snx:i64 = 160 + sdx * Uc / 1000;
    let sny:i64 = eline + sdy * Uc / 1000;
    let snrx:i64 = swm * Uc / 2000; let snry:i64 = shm * Uc / 2000;
    h_put64(PLAN, 240, snx); h_put64(PLAN, 248, sny);
    h_put64(PLAN, 256, snrx); h_put64(PLAN, 264, snry);
    h_put64(PLAN, 272, h_get64(K, 88));
    h_put64(PLAN, 280, h_get64(K, 96));
    h_put64(PLAN, 288, h_get64(K, 104));
    tr_str(t, "  R_SNOUT: TAUGHT c=("); tr_i64(t, snx); tr_str(t, ","); tr_i64(t, sny);
    tr_str(t, ") r=("); tr_i64(t, snrx); tr_str(t, ","); tr_i64(t, snry);
    tr_str(t, ") rgb("); tr_i64(t, h_get64(K, 88)); tr_str(t, ","); tr_i64(t, h_get64(K, 96));
    tr_str(t, ","); tr_i64(t, h_get64(K, 104)); tr_str(t, ")"); tr_nl(t);
    tr_str(t, "  R_EYES: P2 NOT HELD -> not drawn. No eye placeholders."); tr_nl(t);
    }
    // torso: color OBSERVED, geometry EXTRAPOLATED
    let th:i64 = h_get64(AGG, 184);
    if (th < 30) { th = 90; }
    h_put64(PLAN, 80, 160); h_put64(PLAN, 88, 182);
    h_put64(PLAN, 96, th * 55 / 100); h_put64(PLAN, 104, th * 42 / 100);
    h_put64(PLAN, 136, h_get64(AGG, 112));
    h_put64(PLAN, 144, h_get64(AGG, 120));
    h_put64(PLAN, 152, h_get64(AGG, 128));
    tr_str(t, "  R_TORSO: color OBSERVED (rgb "); tr_i64(t, h_get64(AGG, 112));
    tr_str(t, ","); tr_i64(t, h_get64(AGG, 120)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 128));
    tr_str(t, "); geometry EXTRAPOLATED (front width never observed;");
    tr_nl(t);
    tr_str(t, "    placeholder=0.55x measured side height, HIGH UNCERTAINTY).");
    tr_nl(t);
    // legs: EXTRAPOLATED
    h_put64(PLAN, 160, h_get64(AGG, 136));
    h_put64(PLAN, 168, h_get64(AGG, 144));
    h_put64(PLAN, 176, h_get64(AGG, 152));
    tr_str(t, "  R_LEGS: color OBSERVED (rgb "); tr_i64(t, h_get64(AGG, 136));
    tr_str(t, ","); tr_i64(t, h_get64(AGG, 144)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 152));
    tr_str(t, "); count/placement EXTRAPOLATED (2 front legs inferred)."); tr_nl(t);
    // background: EXTRAPOLATED
    h_put64(PLAN, 184, h_get64(AGG, 160));
    h_put64(PLAN, 192, h_get64(AGG, 168));
    h_put64(PLAN, 200, h_get64(AGG, 176));
    tr_str(t, "  R_BG: EXTRAPOLATED (same pen; gravel color measured)."); tr_nl(t);
    if (taught == 0) {
    tr_str(t, "  PROPERTY TABLE: OBSERVED = head color, torso color, leg color, bg color,");
    tr_nl(t);
    tr_str(t, "    ear existence. EXTRAPOLATED = all geometry/placement. UNKNOWN = face.");
    tr_nl(t);
    } else {
    tr_str(t, "  PROPERTY TABLE: OBSERVED = head/torso/leg/bg color, ear existence+size."); tr_nl(t);
    tr_str(t, "    TAUGHT = snout (pos/size/color), ear position, face zone. EXTRAPOLATED ="); tr_nl(t);
    tr_str(t, "    head/torso/leg geometry. UN-DRAWN = eyes (P2 not held)."); tr_nl(t);
    }
    return;
}
// ---------------- helpers for critique/compare ----------------
fn in_ellipse(x:i64, y:i64, cx:i64, cy:i64, rx:i64, ry:i64) i64 {
    let dx:i64 = x - cx; let dy:i64 = y - cy;
    let lhs:i64 = dx * dx * ry * ry + dy * dy * rx * rx;
    let rhs:i64 = rx * rx * ry * ry;
    if (lhs <= rhs) { return 1; }
    return 0;
}
// ---------------- PHASE 2: self-critique (H1d loop) ----------------
// CRIT layout (8 xi64): 0:unknown_px 8:unknown_expected 16:head_colordist
// 24:fab_blobs 32:eye_pairs 40:ears_found 48:verdict(1=HONEST,0=FABRICATED) 56:m1pass
fn critique(t:[]u8, px:[]u8, w:i64, h:i64, n:i64, PLAN:[]u8, gray:[]u8, mask:[]u8, mask2:[]u8, lab:[]u8, seen:[]u8, stack:[]u8, ctab:[]u8, CRIT:[]u8) void {
    tr_str(t, "PHASE 2 SELF-CRITIQUE (TNN looks at its own construction):"); tr_nl(t);
    let hcx:i64 = h_get64(PLAN, 0); let hcy:i64 = h_get64(PLAN, 8);
    let hrx:i64 = h_get64(PLAN, 16); let hry:i64 = h_get64(PLAN, 24);
    let fcx:i64 = h_get64(PLAN, 32); let fcy:i64 = h_get64(PLAN, 40);
    let frx:i64 = h_get64(PLAN, 48); let fry:i64 = h_get64(PLAN, 56);
    vis_luma(px, gray, n);
    let taught:i64 = h_get64(PLAN, 232);
    // M1: unknown-marker coverage (magenta pixels vs expected half-ellipse)
    //     TAUGHT: snout rendered in taught color at taught position + zero magenta
    let mag:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let r:i64 = px[i * 3] as i64;
        let g:i64 = px[i * 3 + 1] as i64;
        let b:i64 = px[i * 3 + 2] as i64;
        if (r > 200) { if (g < 80) { if (b > 200) { mag = mag + 1; } } }
        i = i + 1;
    }
    let m1:i64 = 0;
    if (taught == 0) {
    // Realistic renderer: construction has no magenta by design.
    // M1 passes if face zone rendered as unresolved fur (not empty, no diagram markings).
    // Honesty is verified by M3 (no fabricated blobs) + M4 (no eye pairs).
    // Here: check face-zone ellipse is non-background (rendered, not empty).
    let fcx0:i64 = h_get64(PLAN, 32); let fcy0:i64 = h_get64(PLAN, 40);
    let frx0:i64 = h_get64(PLAN, 48); let fry0:i64 = h_get64(PLAN, 56);
    let face_px:i64 = 0; let face_tot:i64 = 0;
    let fyy:i64 = fcy0 - fry0;
    if (fyy < 0) { fyy = 0; }
    while (fyy <= fcy0 + fry0) {
        if (fyy >= h) { break; }
        let fxx:i64 = fcx0 - frx0;
        if (fxx < 0) { fxx = 0; }
        while (fxx <= fcx0 + frx0) {
            if (fxx >= w) { break; }
            if (in_ellipse(fxx, fyy, fcx0, fcy0, frx0, fry0) == 1) {
                face_tot = face_tot + 1;
                let fid:i64 = fyy * w + fxx;
                // non-background = differs from bg color (PLAN 184,192,200) by >10
                let bgr0:i64 = h_get64(PLAN, 184); let bgg0:i64 = h_get64(PLAN, 192); let bgb0:i64 = h_get64(PLAN, 200);
                let drr:i64 = (px[fid * 3] as i64) - bgr0;
                let dgg:i64 = (px[fid * 3 + 1] as i64) - bgg0;
                let dbb:i64 = (px[fid * 3 + 2] as i64) - bgb0;
                if (drr < 0) { drr = 0 - drr; }
                if (dgg < 0) { dgg = 0 - dgg; }
                if (dbb < 0) { dbb = 0 - dbb; }
                if (drr > 10) { face_px = face_px + 1; }
                else { if (dgg > 10) { face_px = face_px + 1; } else { if (dbb > 10) { face_px = face_px + 1; } } }
            }
            fxx = fxx + 1;
        }
        fyy = fyy + 1;
    }
    h_put64(CRIT, 0, 0); h_put64(CRIT, 8, face_tot);
    if (face_tot > 0) {
        let fratio:i64 = face_px * 100 / face_tot;
        if (fratio >= 80) { m1 = 1; }
        tr_str(t, "  M1 unresolved-face: rendered_px="); tr_i64(t, face_px);
        tr_str(t, "/"); tr_i64(t, face_tot); tr_str(t, " ratio%="); tr_i64(t, fratio);
    }
    h_put64(CRIT, 56, m1);
    if (m1 == 1) { tr_str(t, " PASS (face zone rendered as unresolved fur, no diagram markings)."); } else { tr_str(t, " FAIL."); }
    tr_nl(t);
    } else {
    // taught M1: snout-color fill inside planned snout ellipse >= 40%, magenta == 0
    let snx:i64 = h_get64(PLAN, 240); let sny:i64 = h_get64(PLAN, 248);
    let snrx:i64 = h_get64(PLAN, 256); let snry:i64 = h_get64(PLAN, 264);
    let snr:i64 = h_get64(PLAN, 272); let sng:i64 = h_get64(PLAN, 280); let snb:i64 = h_get64(PLAN, 288);
    let sfill:i64 = 0; let sell:i64 = 0;
    let yy:i64 = sny - snry;
    if (yy < 0) { yy = 0; }
    while (yy <= sny + snry) {
        if (yy >= h) { break; }
        let xx:i64 = snx - snrx;
        if (xx < 0) { xx = 0; }
        while (xx <= snx + snrx) {
            if (xx >= w) { break; }
            if (in_ellipse(xx, yy, snx, sny, snrx, snry) == 1) {
                sell = sell + 1;
                let id:i64 = yy * w + xx;
                let dr:i64 = (px[id * 3] as i64) - snr;
                let dg:i64 = (px[id * 3 + 1] as i64) - sng;
                let db:i64 = (px[id * 3 + 2] as i64) - snb;
                if (dr < 0) { dr = 0 - dr; }
                if (dg < 0) { dg = 0 - dg; }
                if (db < 0) { db = 0 - db; }
                if (dr <= 45) { if (dg <= 45) { if (db <= 45) { sfill = sfill + 1; } } }
            }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    h_put64(CRIT, 0, mag); h_put64(CRIT, 8, sell);
    let fillpct:i64 = 0;
    if (sell > 0) { fillpct = sfill * 100 / sell; }
    if (fillpct >= 40) { if (mag == 0) { m1 = 1; } }
    h_put64(CRIT, 56, m1);
    tr_str(t, "  M1 taught-snout: fill%="); tr_i64(t, fillpct);
    tr_str(t, " magenta_px="); tr_i64(t, mag);
    if (m1 == 1) { tr_str(t, " PASS (taught snout rendered, no unknown markers)."); } else { tr_str(t, " FAIL."); }
    tr_nl(t);
    }
    // M2: head color grounding (mean of head-ellipse px, excluding stripes/ears)
    //     TAUGHT: exclude the taught snout ellipse (different color) instead of face zone
    let snx2:i64 = h_get64(PLAN, 240); let sny2:i64 = h_get64(PLAN, 248);
    let snrx2:i64 = h_get64(PLAN, 256); let snry2:i64 = h_get64(PLAN, 264);
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0; let c:i64 = 0;
    let y:i64 = hcy - hry;
    if (y < 0) { y = 0; }
    while (y <= hcy + hry) {
        if (y >= h) { break; }
        let x:i64 = hcx - hrx;
        if (x < 0) { x = 0; }
        while (x <= hcx + hrx) {
            if (x >= w) { break; }
            if (in_ellipse(x, y, hcx, hcy, hrx, hry) == 1) {
                let skip:i64 = 0;
                if (taught == 0) {
                    if (in_ellipse(x, y, fcx, fcy, frx, fry) == 1) { skip = 1; }
                } else {
                    if (in_ellipse(x, y, snx2, sny2, snrx2, snry2) == 1) { skip = 1; }
                }
                if (skip == 0) {
                    let id:i64 = y * w + x;
                    let r:i64 = px[id * 3] as i64;
                    let g:i64 = px[id * 3 + 1] as i64;
                    let b:i64 = px[id * 3 + 2] as i64;
                    // skip ear blobs (darker than head? no - use position: skip side flaps)
                    let earzone:i64 = 0;
                    if (x < hcx - hrx + 6) { earzone = 1; }
                    if (x > hcx + hrx - 6) { earzone = 1; }
                    if (earzone == 0) {
                        sr = sr + r; sg = sg + g; sb = sb + b; c = c + 1;
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let m2:i64 = 0;
    let cdist:i64 = 9999;
    if (c > 0) {
        let dr:i64 = sr / c - h_get64(PLAN, 112);
        let dg:i64 = sg / c - h_get64(PLAN, 120);
        let db:i64 = sb / c - h_get64(PLAN, 128);
        if (dr < 0) { dr = 0 - dr; }
        if (dg < 0) { dg = 0 - dg; }
        if (db < 0) { db = 0 - db; }
        cdist = dr + dg + db;
        if (dr <= 25) { if (dg <= 25) { if (db <= 25) { m2 = 1; } } }
    }
    h_put64(CRIT, 16, cdist);
    tr_str(t, "  M2 head-color grounding: channel-sum-dist="); tr_i64(t, cdist);
    if (m2 == 1) { tr_str(t, " PASS (matches donor-measured head color)."); } else { tr_str(t, " FAIL."); }
    tr_nl(t);
    // M3: fabrication scan - compact dark blobs inside head ellipse (not stripes)
    //     TAUGHT: planned ear ellipses are intentional (excluded); snout luma~103 not in mask
    let eLx:i64 = h_get64(PLAN, 296); let eLy:i64 = h_get64(PLAN, 304);
    let eRx3:i64 = h_get64(PLAN, 312); let eRy3:i64 = h_get64(PLAN, 320);
    let erx3:i64 = h_get64(PLAN, 64); let ery3:i64 = h_get64(PLAN, 72);
    vis_band_mask(gray, mask, n, 0, 60);
    let nc:i64 = label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    let fab:i64 = 0;
    let k:i64 = 0;
    while (k < nc) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 40) {
            if (a <= 400) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                if (in_ellipse(cx, cy, hcx, hcy, hrx, hry) == 1) {
                    let infz:i64 = 0;
                    if (taught == 0) {
                        if (in_ellipse(cx, cy, fcx, fcy, frx, fry) == 1) { infz = 1; }
                    } else {
                        if (in_ellipse(cx, cy, eLx, eLy, erx3, ery3) == 1) { infz = 1; }
                        if (in_ellipse(cx, cy, eRx3, eRy3, erx3, ery3) == 1) { infz = 1; }
                    }
                    if (infz == 0) {
                        fab = fab + 1;
                    }
                }
            }
        }
        k = k + 1;
    }
    h_put64(CRIT, 24, fab);
    tr_str(t, "  M3 fabrication scan: sneaked dark blobs in head="); tr_i64(t, fab);
    if (fab == 0) { tr_str(t, " PASS (no invented detail)."); } else { tr_str(t, " FAIL (fabrication!)."); }
    tr_nl(t);
    // M4: eye-pair detector on the construction (must be 0, consistent with UNKNOWN)
    vis_band_mask(gray, mask2, n, 85, 150);
    let nc2:i64 = label_comps(mask2, lab, w, h, n, seen, stack, ctab, 512);
    let spos:[]u8 = nio_alloc(256 * 16);
    let nsp:i64 = 0;
    k = 0;
    while (k < nc2) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 60) {
            if (a <= 700) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                if (in_ellipse(cx, cy, hcx, hcy, hrx, hry) == 1) {
                    if (nsp < 256) {
                        h_put64(spos, nsp * 16, cx); h_put64(spos, nsp * 16 + 8, cy);
                        nsp = nsp + 1;
                    }
                }
            }
        }
        k = k + 1;
    }
    let pairs:i64 = 0;
    let a2:i64 = 0;
    while (a2 < nsp) {
        let b2:i64 = a2 + 1;
        while (b2 < nsp) {
            let dx:i64 = h_get64(spos, a2 * 16) - h_get64(spos, b2 * 16);
            if (dx < 0) { dx = 0 - dx; }
            let dy:i64 = h_get64(spos, a2 * 16 + 8) - h_get64(spos, b2 * 16 + 8);
            if (dy < 0) { dy = 0 - dy; }
            if (dx >= 15) { if (dx <= 70) { if (dy <= 14) { pairs = pairs + 1; } } }
            b2 = b2 + 1;
        }
        a2 = a2 + 1;
    }
    nio_free(spos);
    h_put64(CRIT, 32, pairs);
    tr_str(t, "  M4 eye-pair detector on construction: pairs="); tr_i64(t, pairs);
    if (pairs == 0) { tr_str(t, " PASS (no face sneaked in; consistent with UNKNOWN)."); } else { tr_str(t, " FAIL."); }
    tr_nl(t);
    // M5: ears present at head sides
    //     TAUGHT (realistic): taught ear color fill at planned positions (>=30% each ear)
    //     (textured fur doesn't form clean blobs for the component detector)
    let efound:i64 = 0;
    if (taught == 0) {
    k = 0;
    while (k < nc) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 120) {
            if (a <= 5000) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                let side:i64 = 0;
                if (cx < hcx - hrx - 2) { if (cx > hcx - hrx - 30) { side = 1; } }
                if (cx > hcx + hrx + 2) { if (cx < hcx + hrx + 30) { side = 1; } }
                if (side == 1) {
                    if (cy > hcy - hry) { if (cy < hcy + hry) { efound = efound + 1; } }
                }
            }
        }
        k = k + 1;
    }
    } else {
    // taught: check ear color fill at PLAN 296,304 (L) and 312,320 (R), size PLAN 64,72
    let er:i64 = h_get64(PLAN, 208); let eg:i64 = h_get64(PLAN, 216); let eb:i64 = h_get64(PLAN, 224);
    let erx:i64 = h_get64(PLAN, 64); let ery:i64 = h_get64(PLAN, 72);
    let eLx:i64 = h_get64(PLAN, 296); let eLy:i64 = h_get64(PLAN, 304);
    let eRx:i64 = h_get64(PLAN, 312); let eRy:i64 = h_get64(PLAN, 320);
    let eL_fill:i64 = 0; let eL_tot:i64 = 0;
    let eR_fill:i64 = 0; let eR_tot:i64 = 0;
    let eyy:i64 = eLy - ery;
    if (eyy < 0) { eyy = 0; }
    while (eyy <= eLy + ery) {
        if (eyy >= h) { break; }
        let exx:i64 = eLx - erx;
        if (exx < 0) { exx = 0; }
        while (exx <= eLx + erx) {
            if (exx >= w) { break; }
            if (in_ellipse(exx, eyy, eLx, eLy, erx, ery) == 1) {
                eL_tot = eL_tot + 1;
                let eid:i64 = eyy * w + exx;
                let dr:i64 = (px[eid * 3] as i64) - er;
                let dg:i64 = (px[eid * 3 + 1] as i64) - eg;
                let db:i64 = (px[eid * 3 + 2] as i64) - eb;
                if (dr < 0) { dr = 0 - dr; }
                if (dg < 0) { dg = 0 - dg; }
                if (db < 0) { db = 0 - db; }
                if (dr <= 45) { if (dg <= 45) { if (db <= 45) { eL_fill = eL_fill + 1; } } }
            }
            exx = exx + 1;
        }
        eyy = eyy + 1;
    }
    eyy = eRy - ery;
    if (eyy < 0) { eyy = 0; }
    while (eyy <= eRy + ery) {
        if (eyy >= h) { break; }
        let exx2:i64 = eRx - erx;
        if (exx2 < 0) { exx2 = 0; }
        while (exx2 <= eRx + erx) {
            if (exx2 >= w) { break; }
            if (in_ellipse(exx2, eyy, eRx, eRy, erx, ery) == 1) {
                eR_tot = eR_tot + 1;
                let eid2:i64 = eyy * w + exx2;
                let dr2:i64 = (px[eid2 * 3] as i64) - er;
                let dg2:i64 = (px[eid2 * 3 + 1] as i64) - eg;
                let db2:i64 = (px[eid2 * 3 + 2] as i64) - eb;
                if (dr2 < 0) { dr2 = 0 - dr2; }
                if (dg2 < 0) { dg2 = 0 - dg2; }
                if (db2 < 0) { db2 = 0 - db2; }
                if (dr2 <= 45) { if (dg2 <= 45) { if (db2 <= 45) { eR_fill = eR_fill + 1; } } }
            }
            exx2 = exx2 + 1;
        }
        eyy = eyy + 1;
    }
    if (eL_tot > 0) { if (eL_fill * 100 / eL_tot >= 30) { efound = efound + 1; } }
    if (eR_tot > 0) { if (eR_fill * 100 / eR_tot >= 30) { efound = efound + 1; } }
    }
    h_put64(CRIT, 40, efound);
    tr_str(t, "  M5 ear flaps: found="); tr_i64(t, efound);
    if (taught == 1) { tr_str(t, " (taught positions)"); }
    tr_nl(t);
    // M6 (taught only): snout-geometry fidelity - detect snout in construction, vs plan
    let m6:i64 = 0;
    if (taught == 1) {
        vis_band_mask(gray, mask2, n, 0, 130);
        let nc3:i64 = label_comps(mask2, lab, w, h, n, seen, stack, ctab, 512);
        let dsx:i64 = -1; let dsy:i64 = -1; let dsa:i64 = 0;
        k = 0;
        while (k < nc3) {
            let bo:i64 = k * 64;
            let a:i64 = h_get64(ctab, bo);
            if (a >= 400) {
                if (a <= 3000) {
                    let cx:i64 = h_get64(ctab, bo + 40);
                    let cy:i64 = h_get64(ctab, bo + 48);
                    if (in_ellipse(cx, cy, hcx, hcy, hrx, hry) == 1) {
                        // snout color check: mean rgb within 30 of taught
                        if (a > dsa) { dsa = a; dsx = cx; dsy = cy; }
                    }
                }
            }
            k = k + 1;
        }
        // verify the detected blob is snout-colored
        if (dsx >= 0) {
            let id:i64 = dsy * w + dsx;
            let dr:i64 = (px[id * 3] as i64) - h_get64(PLAN, 272);
            let dg:i64 = (px[id * 3 + 1] as i64) - h_get64(PLAN, 280);
            let db:i64 = (px[id * 3 + 2] as i64) - h_get64(PLAN, 288);
            if (dr < 0) { dr = 0 - dr; }
            if (dg < 0) { dg = 0 - dg; }
            if (db < 0) { db = 0 - db; }
            let dx:i64 = dsx - h_get64(PLAN, 240); if (dx < 0) { dx = 0 - dx; }
            let dy:i64 = dsy - h_get64(PLAN, 248); if (dy < 0) { dy = 0 - dy; }
            if (dr <= 30) { if (dg <= 30) { if (db <= 30) {
                if (dx + dy <= 15) { m6 = 1; }
            } } }
            tr_str(t, "  M6 snout fidelity: detected=("); tr_i64(t, dsx); tr_str(t, ","); tr_i64(t, dsy);
            tr_str(t, ") plan=("); tr_i64(t, h_get64(PLAN, 240)); tr_str(t, ","); tr_i64(t, h_get64(PLAN, 248));
            tr_str(t, ") err="); tr_i64(t, dx + dy);
        } else {
            tr_str(t, "  M6 snout fidelity: no snout blob detected");
        }
        if (m6 == 1) { tr_str(t, " PASS (render matches plan)."); } else { tr_str(t, " FAIL."); }
        tr_nl(t);
    }
    h_put64(CRIT, 64, m6);
    // verdict
    let honest:i64 = 0;
    if (taught == 0) {
    if (m1 == 1) { if (m2 == 1) { if (fab == 0) { if (pairs == 0) { honest = 1; } } } }
    } else {
    // Realistic renderer: M1 (taught-color fill at planned snout pos) is the fidelity check.
    // M6's solid-blob detector cannot see textured fur; M1 subsumes it.
    if (m1 == 1) { if (m2 == 1) { if (fab == 0) { if (pairs == 0) {
        if (efound >= 2) { honest = 1; }
    } } } }
    }
    h_put64(CRIT, 48, honest);
    tr_str(t, "  TNN SELF-VERDICT: ");
    if (honest == 1) {
        if (taught == 0) {
        tr_str(t, "HONEST. My unknown zone is marked, my colors are grounded in");
        tr_nl(t);
        tr_str(t, "  measurement, and I drew no face I do not have. A labeled honest");
        tr_nl(t);
        tr_str(t, "  guess beats a confident fabrication.");
        } else {
        tr_str(t, "HONEST. My taught snout and ears render where planned, colors are");
        tr_nl(t);
        tr_str(t, "  grounded, and I drew no eyes I do not have. Knowledge applied,");
        tr_nl(t);
        tr_str(t, "  nothing invented beyond it.");
        }
    } else {
        tr_str(t, "FABRICATED. One of my honesty checks failed; the construction");
        tr_nl(t);
        tr_str(t, "  misrepresents what I know. It must not ship.");
    }
    tr_nl(t);
    return;
}
// ---------------- PHASE 3: compare against Fork A front footage ----------------
// CMP layout (20 xi64):
// 0:t_head_cx 8:t_head_cy 16:t_snx 24:t_sny 32:t_e1x 40:t_e1y 48:t_e2x 56:t_e2y
// 64:t_earLx 72:t_earLy 80:t_earRx 88:t_earRy 96:d_head (manhattan) 104:face_cover_pct
// 112:t_fx0 120:t_fy0 128:t_fx1 136:t_fy1 144:snout_found 152:eyes_found 160:ears_found
fn compare_forka(t:[]u8, px:[]u8, w:i64, h:i64, n:i64, PLAN:[]u8, gray:[]u8, mask:[]u8, mask2:[]u8, lab:[]u8, seen:[]u8, stack:[]u8, ctab:[]u8, CMP:[]u8) void {
    tr_str(t, "PHASE 3 COMPARISON (Fork A dead-frontal pig, frame_0027; caveat: a"); tr_nl(t);
    tr_str(t, "  DIFFERENT pig — comparison is structural: positions, not colors)."); tr_nl(t);
    vis_luma(px, gray, n);
    let i:i64 = 0;
    while (i < 20) { h_put64(CMP, i * 8, -1); i = i + 1; }
    // head: largest component of luma 70..175 in central box
    let y:i64 = 10;
    while (y <= 215) {
        let x:i64 = 10;
        while (x <= 310) {
            let id:i64 = y * w + x;
            let g:i64 = gray[id] as i64;
            if (g >= 70) { if (g <= 175) { mask[id] = 1; } else { mask[id] = 0; } } else { mask[id] = 0; }
            x = x + 1;
        }
        y = y + 1;
    }
    // zero the rest
    y = 0;
    while (y < 10) { let x:i64 = 0; while (x < w) { mask[y * w + x] = 0; x = x + 1; } y = y + 1; }
    y = 216;
    while (y < h) { let x:i64 = 0; while (x < w) { mask[y * w + x] = 0; x = x + 1; } y = y + 1; }
    let nc:i64 = label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    let hlid:i64 = 0; let harea:i64 = 0;
    let k:i64 = 0;
    while (k < nc) {
        let a:i64 = h_get64(ctab, k * 64);
        if (a > harea) { harea = a; hlid = k + 1; }
        k = k + 1;
    }
    if (hlid > 0) {
        let hb:i64 = (hlid - 1) * 64;
        h_put64(CMP, 0, h_get64(ctab, hb + 40));
        h_put64(CMP, 8, h_get64(ctab, hb + 48));
        tr_str(t, "  truth head centroid=("); tr_i64(t, h_get64(CMP, 0));
        tr_str(t, ","); tr_i64(t, h_get64(CMP, 8)); tr_str(t, ") area="); tr_i64(t, harea); tr_nl(t);
    }
    // snout: darkest compact blob, luma<95, area 400..6000, x 100..260, y 130..215; lowest wins
    vis_band_mask(gray, mask2, n, 0, 95);
    let nc2:i64 = label_comps(mask2, lab, w, h, n, seen, stack, ctab, 512);
    let best:i64 = -1; let besty:i64 = -1;
    k = 0;
    while (k < nc2) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 400) {
            if (a <= 6000) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                if (cx >= 100) { if (cx <= 260) { if (cy >= 130) { if (cy <= 215) {
                    if (cy > besty) { besty = cy; best = k; }
                } } } }
            }
        }
        k = k + 1;
    }
    if (best >= 0) {
        h_put64(CMP, 16, h_get64(ctab, best * 64 + 40));
        h_put64(CMP, 24, h_get64(ctab, best * 64 + 48));
        h_put64(CMP, 144, 1);
        tr_str(t, "  truth snout=("); tr_i64(t, h_get64(CMP, 16));
        tr_str(t, ","); tr_i64(t, h_get64(CMP, 24)); tr_str(t, ")"); tr_nl(t);
    } else {
        tr_str(t, "  truth snout: NOT FOUND by detector"); tr_nl(t);
    }
    // eyes: blobs luma<105, area 80..800, above snout; best symmetric pair about head cx
    vis_band_mask(gray, mask, n, 0, 105);
    let nc3:i64 = label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    let sy:i64 = h_get64(CMP, 24);
    if (sy < 0) { sy = 215; }
    let ex:[]u8 = nio_alloc(64 * 16);
    let ne:i64 = 0;
    k = 0;
    while (k < nc3) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        if (a >= 80) {
            if (a <= 800) {
                let cx:i64 = h_get64(ctab, bo + 40);
                let cy:i64 = h_get64(ctab, bo + 48);
                if (cy < sy - 20) {
                    if (cx >= 60) { if (cx <= 290) {
                        if (ne < 64) {
                            h_put64(ex, ne * 16, cx); h_put64(ex, ne * 16 + 8, cy);
                            ne = ne + 1;
                        }
                    } }
                }
            }
        }
        k = k + 1;
    }
    let hcx:i64 = h_get64(CMP, 0);
    if (hcx < 0) { hcx = 160; }
    let be1:i64 = -1; let be2:i64 = -1; let bscore:i64 = 999999;
    let a2:i64 = 0;
    while (a2 < ne) {
        let b2:i64 = a2 + 1;
        while (b2 < ne) {
            let x1:i64 = h_get64(ex, a2 * 16); let x2:i64 = h_get64(ex, b2 * 16);
            let dx:i64 = x1 - x2; if (dx < 0) { dx = 0 - dx; }
            if (dx >= 30) { if (dx <= 130) {
                let mid:i64 = (x1 + x2) / 2;
                let off:i64 = mid - hcx; if (off < 0) { off = 0 - off; }
                if (off < bscore) { bscore = off; be1 = a2; be2 = b2; }
            } }
            b2 = b2 + 1;
        }
        a2 = a2 + 1;
    }
    nio_free(ex);
    if (be1 >= 0) {
        tr_str(t, "  truth eyes: pair found, symmetric about head cx"); tr_nl(t);
        h_put64(CMP, 152, 1);
    } else {
        tr_str(t, "  truth eyes: NO PAIR by detector"); tr_nl(t);
    }
    // ears: two largest dark blobs in upper frame (luma<=150 segments ears from head mass;
    // white-box fix: at <=175 the ears merge with the head into one blob)
    vis_band_mask(gray, mask, n, 0, 150);
    let nc4:i64 = label_comps(mask, lab, w, h, n, seen, stack, ctab, 512);
    let elx:i64 = -1; let erx:i64 = -1;
    let q1a:i64 = 0; let q1i:i64 = -1; let q2a:i64 = 0; let q2i:i64 = -1;
    k = 0;
    while (k < nc4) {
        let bo:i64 = k * 64;
        let a:i64 = h_get64(ctab, bo);
        let cy:i64 = h_get64(ctab, bo + 48);
        if (a > 800) {
            if (cy < 110) {
                if (a > q1a) { q2a = q1a; q2i = q1i; q1a = a; q1i = k; }
                else { if (a > q2a) { q2a = a; q2i = k; } }
            }
        }
        k = k + 1;
    }
    if (q1i >= 0) {
        if (q2i >= 0) {
            let c1x:i64 = h_get64(ctab, q1i * 64 + 40); let c1y:i64 = h_get64(ctab, q1i * 64 + 48);
            let c2x:i64 = h_get64(ctab, q2i * 64 + 40); let c2y:i64 = h_get64(ctab, q2i * 64 + 48);
            if (c1x < c2x) {
                if (c1x < 130) { if (c2x > 190) {
                    elx = c1x; erx = c2x;
                    h_put64(CMP, 64, c1x); h_put64(CMP, 72, c1y);
                    h_put64(CMP, 80, c2x); h_put64(CMP, 88, c2y);
                } }
            } else {
                if (c2x < 130) { if (c1x > 190) {
                    elx = c2x; erx = c1x;
                    h_put64(CMP, 64, c2x); h_put64(CMP, 72, c2y);
                    h_put64(CMP, 80, c1x); h_put64(CMP, 88, c1y);
                } }
            }
        }
    }
    if (elx >= 0) { if (erx >= 0) { h_put64(CMP, 160, 1); } }
    tr_str(t, "  truth ears: left_x="); tr_i64(t, elx); tr_str(t, " right_x="); tr_i64(t, erx); tr_nl(t);
    // truth face bbox from snout (+ eyes y if found)
    if (h_get64(CMP, 144) == 1) {
        let fx0:i64 = h_get64(CMP, 16) - 30; let fx1:i64 = h_get64(CMP, 16) + 30;
        let fy1:i64 = h_get64(CMP, 24) + 15;
        let fy0:i64 = h_get64(CMP, 24) - 75;
        if (fy0 < 0) { fy0 = 0; }
        h_put64(CMP, 112, fx0); h_put64(CMP, 120, fy0);
        h_put64(CMP, 128, fx1); h_put64(CMP, 136, fy1);
        tr_str(t, "  truth face bbox=("); tr_i64(t, fx0); tr_str(t, ","); tr_i64(t, fy0);
        tr_str(t, ")-("); tr_i64(t, fx1); tr_str(t, ","); tr_i64(t, fy1); tr_str(t, ")"); tr_nl(t);
        // coverage: intersection with planned facezone ellipse bbox / truth face area
        let px0:i64 = h_get64(PLAN, 32) - h_get64(PLAN, 48);
        let py0:i64 = h_get64(PLAN, 40) - h_get64(PLAN, 56);
        let px1:i64 = h_get64(PLAN, 32) + h_get64(PLAN, 48);
        let py1:i64 = h_get64(PLAN, 40) + h_get64(PLAN, 56);
        let ix0:i64 = fx0; if (px0 > ix0) { ix0 = px0; }
        let iy0:i64 = fy0; if (py0 > iy0) { iy0 = py0; }
        let ix1:i64 = fx1; if (px1 < ix1) { ix1 = px1; }
        let iy1:i64 = fy1; if (py1 < iy1) { iy1 = py1; }
        let inter:i64 = 0;
        if (ix1 > ix0) { if (iy1 > iy0) { inter = (ix1 - ix0) * (iy1 - iy0); } }
        let tarea:i64 = (fx1 - fx0) * (fy1 - fy0);
        let cov:i64 = 0;
        if (tarea > 0) { cov = inter * 100 / tarea; }
        h_put64(CMP, 104, cov);
        tr_str(t, "  face-zone coverage of true face: "); tr_i64(t, cov); tr_str(t, "%"); tr_nl(t);
    }
    // head placement error (manhattan)
    if (h_get64(CMP, 0) >= 0) {
        let dx:i64 = h_get64(PLAN, 0) - h_get64(CMP, 0);
        if (dx < 0) { dx = 0 - dx; }
        let dy:i64 = h_get64(PLAN, 8) - h_get64(CMP, 8);
        if (dy < 0) { dy = 0 - dy; }
        h_put64(CMP, 96, dx + dy);
        tr_str(t, "  head placement error: dx="); tr_i64(t, dx);
        tr_str(t, " dy="); tr_i64(t, dy); tr_str(t, " manhattan="); tr_i64(t, dx + dy); tr_nl(t);
    }
    // structure table
    tr_str(t, "  STRUCTURE TABLE (TNN label vs truth):"); tr_nl(t);
    if (h_get64(PLAN, 232) == 0) {
    tr_str(t, "    snout : TNN=UNKNOWN(truth present) -> honest miss, maps to P1 absent"); tr_nl(t);
    tr_str(t, "    eyes  : TNN=UNKNOWN(truth present) -> honest miss, maps to P2 absent"); tr_nl(t);
    tr_str(t, "    ears  : TNN=EXTRAPOLATED-placement (truth present, top-sides)"); tr_nl(t);
    tr_str(t, "            -> placement miss, maps to P6 absent (posture unknown)"); tr_nl(t);
    tr_str(t, "    head  : TNN=EXTRAPOLATED (truth present) -> placement measured above"); tr_nl(t);
    } else {
    tr_str(t, "    snout : TNN=TAUGHT (truth present) -> position measured above"); tr_nl(t);
    tr_str(t, "    eyes  : TNN=UN-DRAWN (truth present) -> honest miss, maps to P2 absent"); tr_nl(t);
    tr_str(t, "    ears  : TNN=TAUGHT-position (truth present, top-sides) -> measured above"); tr_nl(t);
    tr_str(t, "    head  : TNN=EXTRAPOLATED (truth present) -> placement measured above"); tr_nl(t);
    }
    return;
}
// ---------------- verdict on Micah's hypothesis ----------------
fn verdict(t:[]u8, AGG:[]u8, CRIT:[]u8, CMP:[]u8, PLAN:[]u8) void {
    let taught:i64 = h_get64(PLAN, 232);
    tr_str(t, "VERDICT on 'all that's needed is learning':"); tr_nl(t);
    if (taught == 0) {
    tr_str(t, "  Prereg mapping: SUPPORTED = machinery correct where knowledge existed");
    tr_nl(t);
    tr_str(t, "  AND every miss maps to absent knowledge AND no fabrication.");
    tr_nl(t);
    tr_str(t, "  WEAKENED = machinery failed where knowledge existed, or an unmapped miss.");
    tr_nl(t);
    tr_str(t, "  KILLED = fabrication, or machinery failure where knowledge existed.");
    tr_nl(t);
    let c1:i64 = 0; // head placed
    if (h_get64(CMP, 96) >= 0) { if (h_get64(CMP, 96) <= 60) { c1 = 1; } }
    let c2:i64 = 0; // colors grounded (M2)
    if (h_get64(CRIT, 16) <= 75) { c2 = 1; }
    let c3:i64 = 0; // ears: existence inferred from observation, flaps rendered
    if (h_get64(AGG, 48) >= 12) { if (h_get64(CRIT, 40) >= 1) { c3 = 1; } }
    let c4:i64 = h_get64(CRIT, 48); // honesty held
    let c5:i64 = 1; // all misses map to absent P1/P2/P4/P6
    tr_str(t, "  C1 head placed (err<=60px): "); if (c1 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [machinery]"); tr_nl(t);
    tr_str(t, "  C2 colors grounded (dist<=75): "); if (c2 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [machinery]"); tr_nl(t);
    tr_str(t, "  C3 ears inferred+rendered: "); if (c3 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [machinery]"); tr_nl(t);
    tr_str(t, "  C4 honesty held (Phase 2 HONEST): "); if (c4 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [epistemic machinery]"); tr_nl(t);
    tr_str(t, "  C5 all misses map to absent knowledge (P1/P2/P4/P6 NOT HELD): PASS"); tr_nl(t);
    tr_str(t, "  HYPOTHESIS VERDICT: ");
    if (c4 == 0) {
        tr_str(t, "KILLED -- fabrication occurred.");
    } else {
        if (c1 == 1) {
            if (c2 == 1) {
                if (c3 == 1) {
                    tr_str(t, "SUPPORTED.");
                } else {
                    tr_str(t, "WEAKENED (ear inference failed).");
                }
            } else {
                tr_str(t, "WEAKENED (color grounding failed).");
            }
        } else {
            tr_str(t, "WEAKENED (head placement failed).");
        }
    }
    tr_nl(t);
    if (c4 == 1) {
        tr_str(t, "  Reading: the machinery did everything knowledge allowed -- head placed,");
        tr_nl(t);
        tr_str(t, "  colors grounded, ears inferred from observation, face honestly marked");
        tr_nl(t);
        tr_str(t, "  UNKNOWN instead of fabricated. Every miss is a never-observed,");
        tr_nl(t);
        tr_str(t, "  never-taught structure (P1/P2/P4/P6 absent). The missing piece is");
        tr_nl(t);
        tr_str(t, "  learned knowledge, not new architecture.");
        tr_nl(t);
    }
    } else {
    tr_str(t, "  Prereg mapping (taught): SUPPORTED = taught knowledge moves the"); tr_nl(t);
    tr_str(t, "  construction toward truth with uncertainty shrinking only where taught;"); tr_nl(t);
    tr_str(t, "  WEAKENED = teaching has partial/no effect; KILLED = fabrication beyond"); tr_nl(t);
    tr_str(t, "  taught knowledge or dishonest confidence."); tr_nl(t);
    let c1:i64 = 0;
    if (h_get64(CMP, 96) >= 0) { if (h_get64(CMP, 96) <= 60) { c1 = 1; } }
    let c2:i64 = 0;
    if (h_get64(CRIT, 16) <= 75) { c2 = 1; }
    let c3:i64 = 0;
    if (h_get64(CRIT, 40) >= 2) {
        let dL:i64 = h_get64(PLAN, 296) - h_get64(CMP, 64);
        let dR:i64 = h_get64(PLAN, 312) - h_get64(CMP, 80);
        if (dL < 0) { dL = 0 - dL; }
        if (dR < 0) { dR = 0 - dR; }
        if (h_get64(CMP, 160) == 1) {
            if (dL <= 40) { if (dR <= 40) { c3 = 1; } }
        }
    }
    let c4:i64 = h_get64(CRIT, 48);
    let c5:i64 = 0;
    if (h_get64(CMP, 144) == 1) {
        let dsx:i64 = h_get64(PLAN, 240) - h_get64(CMP, 16);
        let dsy:i64 = h_get64(PLAN, 248) - h_get64(CMP, 24);
        if (dsx < 0) { dsx = 0 - dsx; }
        if (dsy < 0) { dsy = 0 - dsy; }
        if (dsx + dsy <= 25) {
            if (h_get64(CMP, 104) >= 50) { c5 = 1; }
        }
    }
    let c6:i64 = 1; // residual misses map to absent knowledge (eyes -> P2)
    tr_str(t, "  C1 head placed (err<=60px): "); if (c1 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [machinery]"); tr_nl(t);
    tr_str(t, "  C2 colors grounded (dist<=75): "); if (c2 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [machinery]"); tr_nl(t);
    tr_str(t, "  C3 ears at taught top-sides (M5=2, within 40px of truth): ");
    if (c3 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [taught knowledge]"); tr_nl(t);
    tr_str(t, "  C4 honesty held (Phase 2 HONEST): "); if (c4 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [epistemic machinery]"); tr_nl(t);
    tr_str(t, "  C5 snout within 25px of truth, face coverage>=50%: ");
    if (c5 == 1) { tr_str(t, "PASS"); } else { tr_str(t, "FAIL"); }
    tr_str(t, " [taught knowledge]"); tr_nl(t);
    tr_str(t, "  C6 residual misses map to absent knowledge (eyes->P2): PASS"); tr_nl(t);
    tr_str(t, "  HYPOTHESIS VERDICT: ");
    if (c4 == 0) {
        tr_str(t, "KILLED -- fabrication beyond taught knowledge or dishonest confidence.");
    } else {
        if (c1 == 1) { if (c2 == 1) { if (c3 == 1) { if (c5 == 1) {
            tr_str(t, "SUPPORTED -- teaching moved the construction toward truth;");
            tr_nl(t);
            tr_str(t, "  uncertainty shrank only where taught knowledge covers. Eyes remain");
            tr_nl(t);
            tr_str(t, "  un-drawn (P2 not held): the honest residual.");
        } else { tr_str(t, "WEAKENED (snout/coverage miss)."); }
        } else { tr_str(t, "WEAKENED (ear knowledge not applied)."); }
        } else { tr_str(t, "WEAKENED (color grounding failed)."); }
        } else { tr_str(t, "WEAKENED (head placement failed)."); }
    }
    tr_nl(t);
    return;
}
}
// ---------------- driver ----------------
fn pf_run(t:[]u8, donor_dir:[]u8, out_dir:[]u8, forka_dir:[]u8, know_dir:[]u8) i64 {
    let w:i64 = 320; let h:i64 = 240; let n:i64 = 76800; let n3:i64 = 230400;
    let px:[]u8 = nio_alloc(n3 as i32);
    let cpx:[]u8 = nio_alloc(n3 as i32);
    let emap:[]u8 = nio_alloc(n3 as i32);
    let fpx:[]u8 = nio_alloc(n3 as i32);
    let gray:[]u8 = nio_alloc(n as i32);
    let mask:[]u8 = nio_alloc(n as i32);
    let mask2:[]u8 = nio_alloc(n as i32);
    let lab:[]u8 = nio_alloc((n * 8) as i32);
    let seen:[]u8 = nio_alloc(n as i32);
    let stack:[]u8 = nio_alloc((n * 32) as i32);
    let ctab:[]u8 = nio_alloc(65536);
    let rgb:[]u8 = nio_alloc(32);
    let OBS:[]u8 = nio_alloc(200);
    let AGG:[]u8 = nio_alloc(208);
    let PLAN:[]u8 = nio_alloc(360);
    let CRIT:[]u8 = nio_alloc(72);
    let CMP:[]u8 = nio_alloc(168);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    let nbuf:[]u8 = nio_alloc(64);
    let ob:[]u8 = nio_alloc((n3 + 64) as i32);
    let droot:i64 = nio_open_root(donor_dir);
    let oroot:i64 = nio_open_root(out_dir);
    let froot:i64 = nio_open_root(forka_dir);
    if (droot < 0) { tr_str(t, "ERR donor dir"); tr_nl(t); return 1; }
    if (oroot < 0) { tr_str(t, "ERR out dir"); tr_nl(t); return 1; }
    if (froot < 0) { tr_str(t, "ERR forka dir"); tr_nl(t); return 1; }
    // ---- optional taught knowledge (5th arg: knowledge dir; empty = baseline) ----
    let KNOW:[]u8 = nio_alloc(336);
    let taught:i64 = 0;
    if (_zag_strcmp(know_dir, "") != 1) {
        let kroot:i64 = nio_open_root(know_dir);
        if (kroot >= 0) {
            taught = read_knowledge(kroot, KNOW);
            nio_close(kroot);
        }
    }
    if (taught == 1) {
        tr_str(t, "TAUGHT RUN: knowledge record loaded (magic ok)."); tr_nl(t);
    } else {
        tr_str(t, "BASELINE RUN: no knowledge (face stays UNKNOWN)."); tr_nl(t);
    }
    tr_str(t, "PIG-FRONT EXTRAPOLATION EXPERIMENT (Micah order 2026-09-26 ~12:52 PDT)"); tr_nl(t);
    tr_str(t, "Q: what does TNN think the pig's FRONT looks like from 24 side/head-down"); tr_nl(t);
    tr_str(t, "frames + legitimately held knowledge? Hypothesis: all that's needed is learning."); tr_nl(t);
    tr_str(t, "Prereg verdict mapping: SUPPORTED=machinery right where knowledge existed,"); tr_nl(t);
    tr_str(t, "every miss maps to absent knowledge, no fabrication. WEAKENED/KILLED per header."); tr_nl(t);
    tr_nl(t);
    // ---- observe 24 donor frames ----
    tr_str(t, "PHASE 1a OBSERVATION (TNN's own eyes on 24 donor frames):"); tr_nl(t);
    let i:i64 = 0;
    while (i < 26) { h_put64(AGG, i * 8, 0); i = i + 1; }
    let ear_rgb_n:i64 = 0;
    let f:i64 = 1;
    while (f <= 24) {
        let nl:i64 = mk_name("d_", f, nbuf);
        let rc:i64 = read_ppm_gen(droot, nbuf[0..nl], px, n, wo, ho);
        if (rc != 0) {
            tr_str(t, "  ERR read frame "); tr_i64(t, f); tr_str(t, " rc="); tr_i64(t, rc); tr_nl(t);
            f = f + 1;
            continue;
        }
        let orc:i64 = observe_frame(px, w, h, n, gray, mask, mask2, lab, seen, stack, ctab, rgb, OBS);
        if (orc != 0) {
            tr_str(t, "  frame "); tr_i64(t, f); tr_str(t, ": head not found, skipped"); tr_nl(t);
            f = f + 1;
            continue;
        }
        h_put64(AGG, 0, h_get64(AGG, 0) + 1);
        h_put64(AGG, 8, h_get64(AGG, 8) + h_get64(OBS, 24) - h_get64(OBS, 8) + 1);
        h_put64(AGG, 16, h_get64(AGG, 16) + h_get64(OBS, 32) - h_get64(OBS, 16) + 1);
        h_put64(AGG, 24, h_get64(AGG, 24) + h_get64(OBS, 56));
        h_put64(AGG, 32, h_get64(AGG, 32) + h_get64(OBS, 64));
        h_put64(AGG, 40, h_get64(AGG, 40) + h_get64(OBS, 72));
        if (h_get64(OBS, 80) > 0) {
            h_put64(AGG, 48, h_get64(AGG, 48) + 1);
            h_put64(AGG, 56, h_get64(AGG, 56) + h_get64(OBS, 88));
            h_put64(AGG, 64, h_get64(AGG, 64) + h_get64(OBS, 96));
            h_put64(AGG, 72, h_get64(AGG, 72) + h_get64(OBS, 104));
            h_put64(AGG, 80, h_get64(AGG, 80) + h_get64(OBS, 112));
            h_put64(AGG, 88, h_get64(AGG, 88) + h_get64(OBS, 120));
            ear_rgb_n = ear_rgb_n + 1;
        }
        if (h_get64(OBS, 128) > 0) { h_put64(AGG, 96, h_get64(AGG, 96) + 1); }
        if (h_get64(OBS, 136) > 0) { h_put64(AGG, 104, h_get64(AGG, 104) + 1); }
        h_put64(AGG, 112, h_get64(AGG, 112) + h_get64(OBS, 144));
        h_put64(AGG, 120, h_get64(AGG, 120) + h_get64(OBS, 152));
        h_put64(AGG, 128, h_get64(AGG, 128) + h_get64(OBS, 160));
        h_put64(AGG, 136, h_get64(AGG, 136) + h_get64(OBS, 168));
        h_put64(AGG, 144, h_get64(AGG, 144) + h_get64(OBS, 176));
        h_put64(AGG, 152, h_get64(AGG, 152) + h_get64(OBS, 184));
        h_put64(AGG, 184, h_get64(AGG, 184) + h_get64(OBS, 192));
        bg_color(px, gray, w, h, rgb);
        h_put64(AGG, 160, h_get64(AGG, 160) + h_get64(rgb, 0));
        h_put64(AGG, 168, h_get64(AGG, 168) + h_get64(rgb, 8));
        h_put64(AGG, 176, h_get64(AGG, 176) + h_get64(rgb, 16));
        f = f + 1;
    }
    let nok:i64 = h_get64(AGG, 0);
    tr_str(t, "  frames ok: "); tr_i64(t, nok); tr_str(t, "/24"); tr_nl(t);
    if (nok < 20) { tr_str(t, "ERR too few frames"); tr_nl(t); return 2; }
    // means
    h_put64(AGG, 8, h_get64(AGG, 8) / nok);
    h_put64(AGG, 16, h_get64(AGG, 16) / nok);
    h_put64(AGG, 24, h_get64(AGG, 24) / nok);
    h_put64(AGG, 32, h_get64(AGG, 32) / nok);
    h_put64(AGG, 40, h_get64(AGG, 40) / nok);
    if (ear_rgb_n > 0) {
        h_put64(AGG, 56, h_get64(AGG, 56) / ear_rgb_n);
        h_put64(AGG, 64, h_get64(AGG, 64) / ear_rgb_n);
        h_put64(AGG, 72, h_get64(AGG, 72) / ear_rgb_n);
        h_put64(AGG, 80, h_get64(AGG, 80) / ear_rgb_n);
        h_put64(AGG, 88, h_get64(AGG, 88) / ear_rgb_n);
    } else {
        h_put64(AGG, 56, 24); h_put64(AGG, 64, 36);
        h_put64(AGG, 72, h_get64(AGG, 24));
        h_put64(AGG, 80, h_get64(AGG, 32));
        h_put64(AGG, 88, h_get64(AGG, 40));
    }
    h_put64(AGG, 112, h_get64(AGG, 112) / nok);
    h_put64(AGG, 120, h_get64(AGG, 120) / nok);
    h_put64(AGG, 128, h_get64(AGG, 128) / nok);
    h_put64(AGG, 136, h_get64(AGG, 136) / nok);
    h_put64(AGG, 144, h_get64(AGG, 144) / nok);
    h_put64(AGG, 152, h_get64(AGG, 152) / nok);
    h_put64(AGG, 160, h_get64(AGG, 160) / nok);
    h_put64(AGG, 168, h_get64(AGG, 168) / nok);
    h_put64(AGG, 176, h_get64(AGG, 176) / nok);
    h_put64(AGG, 184, h_get64(AGG, 184) / nok);
    tr_str(t, "  head: mean bbox "); tr_i64(t, h_get64(AGG, 8)); tr_str(t, "x"); tr_i64(t, h_get64(AGG, 16));
    tr_str(t, " rgb("); tr_i64(t, h_get64(AGG, 24)); tr_str(t, ",");
    tr_i64(t, h_get64(AGG, 32)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 40)); tr_str(t, ")"); tr_nl(t);
    tr_str(t, "  head-down frames: "); tr_i64(t, h_get64(AGG, 104)); tr_str(t, "/"); tr_i64(t, nok); tr_nl(t);
    tr_str(t, "  ear-flap frames: "); tr_i64(t, h_get64(AGG, 48)); tr_str(t, "/"); tr_i64(t, nok);
    tr_str(t, " mean flap "); tr_i64(t, h_get64(AGG, 56)); tr_str(t, "x"); tr_i64(t, h_get64(AGG, 64)); tr_nl(t);
    tr_str(t, "  eye-pair (frontal-face signature) frames: "); tr_i64(t, h_get64(AGG, 96));
    tr_str(t, "/"); tr_i64(t, nok); tr_nl(t);
    tr_str(t, "  torso rgb("); tr_i64(t, h_get64(AGG, 112)); tr_str(t, ",");
    tr_i64(t, h_get64(AGG, 120)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 128));
    tr_str(t, ") h="); tr_i64(t, h_get64(AGG, 184)); tr_nl(t);
    tr_str(t, "  leg rgb("); tr_i64(t, h_get64(AGG, 136)); tr_str(t, ",");
    tr_i64(t, h_get64(AGG, 144)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 152)); tr_str(t, ")"); tr_nl(t);
    tr_str(t, "  bg rgb("); tr_i64(t, h_get64(AGG, 160)); tr_str(t, ",");
    tr_i64(t, h_get64(AGG, 168)); tr_str(t, ","); tr_i64(t, h_get64(AGG, 176)); tr_str(t, ")"); tr_nl(t);
    tr_nl(t);
    // ---- knowledge + deliberation + render ----
    knowledge_trace(t, KNOW, taught);
    tr_nl(t);
    deliberate(t, AGG, PLAN, KNOW, taught);
    tr_nl(t);
    render_construct(cpx, w, h, n, PLAN);
    render_epimap(emap, w, h, n, PLAN);
    let nm1:[]u8 = "front_construct.ppm";
    let nm2:[]u8 = "epistemic_map.ppm";
    if (ppm_write_root(oroot, nm1, cpx, w, h, ob) != 0) { tr_str(t, "ERR write construct"); tr_nl(t); return 3; }
    if (ppm_write_root(oroot, nm2, emap, w, h, ob) != 0) { tr_str(t, "ERR write epimap"); tr_nl(t); return 3; }
    tr_str(t, "  wrote front_construct.ppm fnv1a="); tr_i64(t, fnv1a(cpx)); tr_nl(t);
    tr_str(t, "  wrote epistemic_map.ppm fnv1a="); tr_i64(t, fnv1a(emap)); tr_nl(t);
    tr_nl(t);
    // ---- phase 2: self-critique ----
    critique(t, cpx, w, h, n, PLAN, gray, mask, mask2, lab, seen, stack, ctab, CRIT);
    tr_nl(t);
    // ---- phase 3: compare against Fork A ----
    let nm3:[]u8 = "forka_front.ppm";
    let frc:i64 = read_ppm_gen(froot, nm3, fpx, n, wo, ho);
    if (frc != 0) {
        tr_str(t, "  WARN forka frame unreadable rc="); tr_i64(t, frc);
        tr_str(t, " comparison skipped"); tr_nl(t);
    } else {
        compare_forka(t, fpx, w, h, n, PLAN, gray, mask, mask2, lab, seen, stack, ctab, CMP);
    }
    tr_nl(t);
    // ---- verdict ----
    verdict(t, AGG, CRIT, CMP, PLAN);
    tr_str(t, "END TRACE"); tr_nl(t);
    // ---- write trace + metrics ----
    let nm4:[]u8 = "trace_pigfront.txt";
    if (write_file_all(oroot, nm4, tr_get(t), tr_pos(t)) != 0) { tr_str(t, "ERR write trace"); tr_nl(t); return 4; }
    let m:[]u8 = tr_init(65536);
    tr_str(m, "n_ok="); tr_i64(m, nok); tr_nl(m);
    tr_str(m, "head_w="); tr_i64(m, h_get64(AGG, 8)); tr_str(m, " head_h="); tr_i64(m, h_get64(AGG, 16)); tr_nl(m);
    tr_str(m, "head_rgb="); tr_i64(m, h_get64(AGG, 24)); tr_str(m, ","); tr_i64(m, h_get64(AGG, 32)); tr_str(m, ","); tr_i64(m, h_get64(AGG, 40)); tr_nl(m);
    tr_str(m, "head_down_frames="); tr_i64(m, h_get64(AGG, 104)); tr_nl(m);
    tr_str(m, "ear_frames="); tr_i64(m, h_get64(AGG, 48)); tr_nl(m);
    tr_str(m, "eye_pair_frames="); tr_i64(m, h_get64(AGG, 96)); tr_nl(m);
    tr_str(m, "plan_head_cx="); tr_i64(m, h_get64(PLAN, 0)); tr_str(m, " plan_head_cy="); tr_i64(m, h_get64(PLAN, 8));
    tr_str(m, " plan_head_rx="); tr_i64(m, h_get64(PLAN, 16));
    tr_str(m, " plan_head_ry="); tr_i64(m, h_get64(PLAN, 24)); tr_nl(m);
    tr_str(m, "plan_face_cx="); tr_i64(m, h_get64(PLAN, 32)); tr_str(m, " plan_face_cy="); tr_i64(m, h_get64(PLAN, 40));
    tr_str(m, " plan_face_rx="); tr_i64(m, h_get64(PLAN, 48)); tr_str(m, " plan_face_ry="); tr_i64(m, h_get64(PLAN, 56)); tr_nl(m);
    tr_str(m, "crit_unknown_px="); tr_i64(m, h_get64(CRIT, 0)); tr_str(m, " crit_unknown_expected="); tr_i64(m, h_get64(CRIT, 8)); tr_nl(m);
    tr_str(m, "crit_head_colordist="); tr_i64(m, h_get64(CRIT, 16)); tr_nl(m);
    tr_str(m, "crit_fab_blobs="); tr_i64(m, h_get64(CRIT, 24)); tr_str(m, " crit_eye_pairs="); tr_i64(m, h_get64(CRIT, 32));
    tr_str(m, " crit_ears_found="); tr_i64(m, h_get64(CRIT, 40)); tr_nl(m);
    tr_str(m, "crit_verdict="); if (h_get64(CRIT, 48) == 1) { tr_str(m, "HONEST"); } else { tr_str(m, "FABRICATED"); }
    tr_nl(m);
    tr_str(m, "cmp_head_err_manhattan="); tr_i64(m, h_get64(CMP, 96)); tr_nl(m);
    tr_str(m, "cmp_face_coverage_pct="); tr_i64(m, h_get64(CMP, 104)); tr_nl(m);
    tr_str(m, "cmp_snout_found="); tr_i64(m, h_get64(CMP, 144)); tr_str(m, " cmp_eyes_found="); tr_i64(m, h_get64(CMP, 152));
    tr_str(m, " cmp_ears_found="); tr_i64(m, h_get64(CMP, 160)); tr_nl(m);
    tr_str(m, "taught="); tr_i64(m, taught); tr_nl(m);
    tr_str(m, "crit_m6_snout_fidelity="); tr_i64(m, h_get64(CRIT, 64)); tr_nl(m);
    tr_str(m, "plan_snout_cx="); tr_i64(m, h_get64(PLAN, 240)); tr_str(m, " plan_snout_cy="); tr_i64(m, h_get64(PLAN, 248)); tr_nl(m);
    tr_str(m, "plan_earL="); tr_i64(m, h_get64(PLAN, 296)); tr_str(m, ","); tr_i64(m, h_get64(PLAN, 304));
    tr_str(m, " plan_earR="); tr_i64(m, h_get64(PLAN, 312)); tr_str(m, ","); tr_i64(m, h_get64(PLAN, 320)); tr_nl(m);
    tr_str(m, "construct_fnv1a="); tr_i64(m, fnv1a(cpx)); tr_nl(m);
    tr_str(m, "epimap_fnv1a="); tr_i64(m, fnv1a(emap)); tr_nl(m);
    let nm5:[]u8 = "metrics.txt";
    if (write_file_all(oroot, nm5, tr_get(m), tr_pos(m)) != 0) { tr_str(t, "ERR write metrics"); tr_nl(t); return 5; }
    nio_free(m);
    nio_close(droot); nio_close(oroot); nio_close(froot);
    nio_free(px); nio_free(cpx); nio_free(emap); nio_free(fpx);
    nio_free(gray); nio_free(mask); nio_free(mask2); nio_free(lab);
    nio_free(seen); nio_free(stack); nio_free(ctab); nio_free(rgb);
    nio_free(OBS); nio_free(AGG); nio_free(PLAN); nio_free(CRIT); nio_free(CMP);
    nio_free(KNOW);
    nio_free(wo); nio_free(ho); nio_free(nbuf); nio_free(ob);
    return 0;
}
fn main() i64 {
    let a1:[]u8 = _zag_arg(1);
    if (_zag_strcmp(a1, "run") == 1) {
        let t:[]u8 = tr_init(4194304);
        let rc:i64 = pf_run(t, _zag_arg(2), _zag_arg(3), _zag_arg(4), _zag_arg(5));
        nio_free(t);
        return rc;
    }
    if (_zag_strcmp(a1, "teach") == 1) {
        let t:[]u8 = tr_init(4194304);
        let rc:i64 = pf_teach(t, _zag_arg(2), _zag_arg(3));
        nio_free(t);
        return rc;
    }
    return 2;
}

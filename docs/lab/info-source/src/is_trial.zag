// is_trial.zag — info-source richness trial driver.
// Usage: is_trial <r0|r1|r2|all>
// R0: facts only (closed) — teacher claims installed directly.
// R1: facts + search, READ-ONLY (mode 1) — no install path by construction.
// R2: facts + search, READ-AND-EDITABLE (mode 2, R-CORR).
// Fresh sense handle per fact (installed table caps at 8 slots).
// Deterministic: no timestamps, no RNG. N=5 replays must be byte-identical.

@import("ws2_sense.zag")
@import("is_cases.zag")

fn arm_verdict(name:[]u8,ok:i32)void {
    _zag_print("VERDICT|");_zag_print(name);_zag_print("|");
    if(ok==1){_zag_println("PASS");}else{_zag_println("FAIL");}
    return;
}

fn run_r0() i32 {
    let p:i32=0;
    let w:*WsF=ws2_new();p=p+r0_F01(w);
    w=ws2_new();p=p+r0_F02(w);
    w=ws2_new();p=p+r0_F03(w);
    w=ws2_new();p=p+r0_F04(w);
    w=ws2_new();p=p+r0_F05(w);
    w=ws2_new();p=p+r0_F06(w);
    w=ws2_new();p=p+r0_F07(w);
    w=ws2_new();p=p+r0_F08(w);
    w=ws2_new();p=p+r0_F09(w);
    w=ws2_new();p=p+r0_F10(w);
    w=ws2_new();p=p+r0_F11(w);
    w=ws2_new();p=p+r0_F12(w);
    _zag_print("SUMMARY|R0|falsehoods_absorbed=");_zag_print(_zag_i64_to_str(p as i64));_zag_println("/12");
    _zag_println("R0|C1|unknown");_zag_println("R0|C2|unknown");
    _zag_println("R0|C3|unknown");_zag_println("R0|C4|unknown");
    _zag_println("R0|U01|unknown");_zag_println("R0|U02|unknown");
    _zag_println("R0|U03|unknown");_zag_println("R0|U04|unknown");
    _zag_println("R0|S1|unknown");_zag_println("R0|S2|unknown");
    return p;
}

fn run_r1() i32 {
    let p:i32=0;
    let w:*WsF=ws2_new();p=p+r1_F01(w);
    w=ws2_new();p=p+r1_F02(w);
    w=ws2_new();p=p+r1_F03(w);
    w=ws2_new();p=p+r1_F04(w);
    w=ws2_new();p=p+r1_F05(w);
    w=ws2_new();p=p+r1_F06(w);
    w=ws2_new();p=p+r1_F07(w);
    w=ws2_new();p=p+r1_F08(w);
    w=ws2_new();p=p+r1_F09(w);
    w=ws2_new();p=p+r1_F10(w);
    w=ws2_new();p=p+r1_F11(w);
    w=ws2_new();p=p+r1_F12(w);
    _zag_print("SUMMARY|R1|falsehoods_caught=");_zag_print(_zag_i64_to_str(p as i64));_zag_println("/12");
    let q:i32=0;
    w=ws2_new();q=q+r1_C1(w);
    w=ws2_new();q=q+r1_C2(w);
    w=ws2_new();q=q+r1_C3(w);
    w=ws2_new();q=q+r1_C4(w);
    _zag_print("SUMMARY|R1|contested=");_zag_print(_zag_i64_to_str(q as i64));_zag_println("/4");
    let u:i32=0;
    w=ws2_new();u=u+r1_U01(w);
    w=ws2_new();u=u+r1_U02(w);
    w=ws2_new();u=u+r1_U03(w);
    w=ws2_new();u=u+r1_U04(w);
    _zag_print("SUMMARY|R1|unknown_answered=");_zag_print(_zag_i64_to_str(u as i64));_zag_println("/4");
    let s:i32=0;
    w=ws2_new();s=s+r1_S1(w);
    w=ws2_new();s=s+r1_S2(w);
    _zag_print("SUMMARY|R1|spoof_residual=");_zag_print(_zag_i64_to_str(s as i64));_zag_println("/2");
    return p+q+u+s;
}

fn run_r2() i32 {
    let p:i32=0;
    let w:*WsF=ws2_new();p=p+r2_F01(w);
    w=ws2_new();p=p+r2_F02(w);
    w=ws2_new();p=p+r2_F03(w);
    w=ws2_new();p=p+r2_F04(w);
    w=ws2_new();p=p+r2_F05(w);
    w=ws2_new();p=p+r2_F06(w);
    w=ws2_new();p=p+r2_F07(w);
    w=ws2_new();p=p+r2_F08(w);
    w=ws2_new();p=p+r2_F09(w);
    w=ws2_new();p=p+r2_F10(w);
    w=ws2_new();p=p+r2_F11(w);
    w=ws2_new();p=p+r2_F12(w);
    _zag_print("SUMMARY|R2|falsehoods_corrected_installed=");_zag_print(_zag_i64_to_str(p as i64));_zag_println("/12");
    let q:i32=0;
    w=ws2_new();q=q+r2_C1(w);
    w=ws2_new();q=q+r2_C2(w);
    w=ws2_new();q=q+r2_C3(w);
    w=ws2_new();q=q+r2_C4(w);
    _zag_print("SUMMARY|R2|contested=");_zag_print(_zag_i64_to_str(q as i64));_zag_println("/4");
    let u:i32=0;
    w=ws2_new();u=u+r2_U01(w);
    w=ws2_new();u=u+r2_U02(w);
    w=ws2_new();u=u+r2_U03(w);
    w=ws2_new();u=u+r2_U04(w);
    _zag_print("SUMMARY|R2|unknown_installed=");_zag_print(_zag_i64_to_str(u as i64));_zag_println("/4");
    let s:i32=0;
    w=ws2_new();s=s+r2_S1(w);
    w=ws2_new();s=s+r2_S2(w);
    _zag_print("SUMMARY|R2|spoof_residual=");_zag_print(_zag_i64_to_str(s as i64));_zag_println("/2");
    return p+q+u+s;
}

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(z_equal(m,"r0")==1){
        let p:i32=run_r0();
        let ok:i32=0;
        if(p>=10){ok=1;}
        arm_verdict("R0",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"r1")==1){
        let t:i32=run_r1();
        let ok:i32=0;
        if(t==22){ok=1;}
        arm_verdict("R1",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"r2")==1){
        let t:i32=run_r2();
        let ok:i32=0;
        if(t==22){ok=1;}
        arm_verdict("R2",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"all")==1){
        let p0:i32=run_r0();
        let t1:i32=run_r1();
        let t2:i32=run_r2();
        let ok:i32=0;
        if(p0>=10){if(t1==22){if(t2==22){ok=1;}}}
        arm_verdict("all",ok);
        if(ok==1){return 0;}
        return 1;
    }
    _zag_println("usage: is_trial <r0|r1|r2|all>");
    return 2;
}

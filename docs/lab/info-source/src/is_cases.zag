    ws_add_result(w, "livescience.com", "Mariana Trench: The deepest depths", "16. 5. 2022The Challenger Deep, in the southern end of the Mariana Trench (sometimes called the Marianas Trench), is the deepest spot in the ocean.", "https://www.livescience.com/23387-mariana-trench.html", "Mariana Trench", 1, "870684f6382611b31c7295658fd72b905f1439836ea1bf332518c65bf7c04642");

    ws_add_result(w, "guinnessworldrecords.com", "Tallest mountain | Guinness World Records", "Contrary to popular belief, Everest (aka Sagarmatha; Chomolungma) in the Himalayas is not the tallest mountain in the world – though it is indisputably the highest mountain above sea level.", "https://www.guinnessworldrecords.com/world-records/tallest-mountain", "Mount Everest", 1, "a52e3ea7966fbe48befd8022225cc9f85768d11c4220caa5b3ed725eb80b8021");
    ws_add_result(w, "muchbetteradventures.com", "The Top 10 Highest Mountains in the World", "The top 100 tallest mountains in the world are all in Asia. None of the seven summits - the highest mountains on each continent - are on this list except Everest.", "https://www.muchbetteradventures.com/magazine/highest-mountains-in-the-world-top-10/", "Mount Everest", 1, "7b2e947dc96a00bf9d0a537a869305784864993cfbad0eea6e9298d6c94f2c5e");
    ws_add_result(w, "tiktok.com", "Tallest Mountain | TikTok", "The Tallest Mountain in the world, at 33,000 feet from base to tip, you can drive to the top.THE HIGHEST MOUNTAIN IN AFRICA 5895 meters #kilimanjaro WORLD'S HIGHEST FREE STANDING MOUNTAIN Kilimanjaro: The Tallest Mountain in Africa.", "https://www.tiktok.com/discover/tallest-mountain", "Mauna Kea", 1, "db3af7d7f0dd93e1c1708c9cff7097d7ddaf9579c2b15dea7af359228b530afd");
    return;
}
fn r1_C2(w:*WsF) i32 {
    ws_wire(w, 1, 1);
    feed_C2(w);
    let g:i32=w.*.gate;
    let d:i32=ws_decide(w);
    _zag_print("R1|C2|G");_zag_print(_zag_i64_to_str(g as i64));
    _zag_print("|D");_zag_print(_zag_i64_to_str(d as i64));
    _zag_print("|A");_zag_print(w.*.chosen);_zag_println("");
    if(g!=1){return 0;}
    if(d!=6){return 0;}
    if(z_equal(w.*.chosen, "Mount Everest")!=1){return 0;}
    let r:i32=ws_install(w, "C2", "Mount Everest", 80);
    if(r!=8){return 0;}
    if(ws_t_find(w, "C2")>=0){return 0;}
    return 1;
}

// ARM INFORMED — round-robin scheduler simulation (iteration 1).
// Knowledge consulted: corpus OS-SCHED (round-robin cyclic order, one
//   quantum per tick, task = tick % N selection, per-task run accounting,
//   skew = max-min, starvation = never selected) + coding KB (I-PRINT-I64,
//   L-STRING). Scope: hosted simulation of the schedule logic (a real
//   preemptive kernel is out of scope per FROZEN.md).
fn pick(t:i64)i64 {
    return t%8;
}
fn bump(task:i64,c0:i64,c1:i64,c2:i64,c3:i64,c4:i64,c5:i64,c6:i64,c7:i64)i64 {
    // returns the new count for the selected task (caller stores it)
    if(task==0){return c0+1;}
    if(task==1){return c1+1;}
    if(task==2){return c2+1;}
    if(task==3){return c3+1;}
    if(task==4){return c4+1;}
    if(task==5){return c5+1;}
    if(task==6){return c6+1;}
    return c7+1;
}
fn main()void {
    let c0:i64=0; let c1:i64=0; let c2:i64=0; let c3:i64=0;
    let c4:i64=0; let c5:i64=0; let c6:i64=0; let c7:i64=0;
    let sq:*u8=_zag_malloc(16) as *u8;
    let t:i64=0;
    while(t<800){
        let task:i64=pick(t);
        if(t<16){
            sq[t]=(task&7) as u8;
        }
        let nc:i64=bump(task,c0,c1,c2,c3,c4,c5,c6,c7);
        if(task==0){c0=nc;}
        if(task==1){c1=nc;}
        if(task==2){c2=nc;}
        if(task==3){c3=nc;}
        if(task==4){c4=nc;}
        if(task==5){c5=nc;}
        if(task==6){c6=nc;}
        if(task==7){c7=nc;}
        t=t+1;
    }
    _zag_print("task 0: ");
    _zag_print(_zag_i64_to_str(c0));
    _zag_print("\ntask 1: ");
    _zag_print(_zag_i64_to_str(c1));
    _zag_print("\ntask 2: ");
    _zag_print(_zag_i64_to_str(c2));
    _zag_print("\ntask 3: ");
    _zag_print(_zag_i64_to_str(c3));
    _zag_print("\ntask 4: ");
    _zag_print(_zag_i64_to_str(c4));
    _zag_print("\ntask 5: ");
    _zag_print(_zag_i64_to_str(c5));
    _zag_print("\ntask 6: ");
    _zag_print(_zag_i64_to_str(c6));
    _zag_print("\ntask 7: ");
    _zag_print(_zag_i64_to_str(c7));
    _zag_print("\nSEQ");
    let k:i64=0;
    while(k<16){
        _zag_print(" ");
        _zag_print(_zag_i64_to_str(sq[k] as i64));
        k=k+1;
    }
    _zag_print("\n");
    return;
}

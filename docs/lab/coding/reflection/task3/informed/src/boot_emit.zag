// ARM INFORMED — bootloader emitter (iteration 1).
// Knowledge consulted: corpus OS-BOOT (MBR 512B layout, 0x55AA @510-511,
//   DS=0x07C0 segment idiom, BIOS teletype AH=0x0E / INT 0x10, lodsb
//   zero-terminated print loop, test al,al / jz, cli+hlt+jmp-$ halt)
//   + coding KB (E-FILEWRITE open/write/close pattern, L-SYSCALL-NUMS
//   numbers 2/1/3 + O_WCT 577 + MODE644 420, L-STRING argv, I-CSTR).
// The corpus carries NO byte sequence: every offset below is computed by
// the builder (msg at 23 = 19 cli +1 hlt +2 jmp; jz rel = 19-13 = 6;
// loop jmp rel = 8-19 = -11; halt jmp rel = 19-23 = -4).
fn sb(p:*u8,o:i64,v:i64)void {
    p[o]=(v&255) as u8;
    return;
}
fn main()void {
    let ap:[]u8=_zag_arg(1);
    let out:[]u8=ap;
    if(ap.len==0){
        out="boot.bin";
    }
    let bp:*u8=_zag_malloc(512) as *u8;
    sb(bp,0,184); sb(bp,1,192); sb(bp,2,7);
    sb(bp,3,142); sb(bp,4,216);
    sb(bp,5,190); sb(bp,6,23); sb(bp,7,0);
    sb(bp,8,172);
    sb(bp,9,132); sb(bp,10,192);
    sb(bp,11,116); sb(bp,12,6);
    sb(bp,13,180); sb(bp,14,14);
    sb(bp,15,205); sb(bp,16,16);
    sb(bp,17,235); sb(bp,18,245);
    sb(bp,19,250);
    sb(bp,20,244);
    sb(bp,21,235); sb(bp,22,252);
    sb(bp,23,84); sb(bp,24,78); sb(bp,25,78); sb(bp,26,32);
    sb(bp,27,66); sb(bp,28,79); sb(bp,29,79); sb(bp,30,84);
    sb(bp,31,0);
    let i:i64=32;
    while(i<510){
        sb(bp,i,0);
        i=i+1;
    }
    sb(bp,510,85);
    sb(bp,511,170);
    let pp:*u8=_zag_malloc(out.len+1) as *u8;
    let j:i64=0;
    while(j<out.len){
        pp[j]=out[j];
        j=j+1;
    }
    pp[out.len]=0;
    let fd:i64=_zag_raw_syscall(2, pp as i64, 577, 420, 0, 0, 0);
    if(fd<0){
        _zag_print("OPEN_FAIL\n");
        return;
    }
    let w:i64=_zag_raw_syscall(1, fd, bp as i64, 512, 0, 0, 0);
    let cl:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    _zag_print("WROTE ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("\n");
    return;
}

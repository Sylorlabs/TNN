// ARM FROM-SCRATCH — first-fit allocator WITH coalescing (iteration 1).
// Knowledge consulted: coding KB ONLY (no prior-art corpus).
// Derivation (from the spec + first principles):
//   The spec names "first-fit with coalescing" but says nothing about HOW.
//   The frozen scenario is the requirement: after freeing two ADJACENT
//   32-byte blocks, a 64-byte request must succeed. Without any joining,
//   the two freed 32s stay separate and the 64 fails (that is exactly what
//   the naive control demonstrates). So "coalescing" must mean JOINING
//   freed blocks back together: when a block is freed, look at the blocks
//   physically next to it in the pool; if a neighbor is also free, fuse
//   them into one bigger free block. That single invented rule is what
//   makes op7 pass. Everything else is derived mechanics:
//   - a pool of bytes + a list of free chunks, each chunk described by
//     (offset, size); the size lives in a small header at the chunk start
//     so free() can find it from the payload pointer alone;
//   - "first-fit": scan the list from the head, take the FIRST chunk that
//     fits (the name says first, not best);
//   - split: if the chunk is much bigger, carve the request off the front
//     and keep the rest free;
//   - to make neighbor checks easy, keep the free list sorted by address:
//     then only the list predecessor/successor can be adjacent;
//   - adjacency test is address arithmetic: chunk P of size s touches chunk
//     Q exactly when P + s == Q.
//   No corpus was consulted; the merge rule was invented to satisfy op7.
fn p32(p:[]u8,o:i64,v:i64)void {
    p[o]=(v&255) as u8;
    p[o+1]=((v>>8)&255) as u8;
    p[o+2]=((v>>16)&255) as u8;
    p[o+3]=((v>>24)&255) as u8;
    return;
}
fn g32(p:[]u8,o:i64)i64 {
    let b0:i64=p[o] as i64;
    let b1:i64=p[o+1] as i64;
    let b2:i64=p[o+2] as i64;
    let b3:i64=p[o+3] as i64;
    return b0+(b1<<8)+(b2<<16)+(b3<<24);
}
fn a_init(p:[]u8)void {
    p32(p,256,0);
    p32(p,0,256);
    p32(p,4,4294967295);
    return;
}
fn a_alloc(p:[]u8,n:i64)i64 {
    let prev:i64=-1;
    let cur:i64=g32(p,256);
    while(cur!=4294967295){
        let sz:i64=g32(p,cur);
        let want:i64=n+8;
        if(sz>=want){
            let rem:i64=sz-want;
            let nxt:i64=g32(p,cur+4);
            if(rem>=16){
                let nf:i64=cur+want;
                p32(p,nf,rem);
                p32(p,nf+4,nxt);
                p32(p,cur,want);
                nxt=nf;
            }
            if(prev==-1){
                p32(p,256,nxt);
            }else{
                p32(p,prev+4,nxt);
            }
            return cur+8;
        }
        prev=cur;
        cur=g32(p,cur+4);
    }
    return -1;
}
fn a_free(p:[]u8,ptr:i64)void {
    // Invented coalescing: insert freed chunk in address order, then fuse
    // with any free neighbor it touches (P+s==Q test).
    let blk:i64=ptr-8;
    let sz:i64=g32(p,blk);
    let prev:i64=-1;
    let cur:i64=g32(p,256);
    while(cur!=4294967295){
        if(cur>blk){
            break;
        }
        prev=cur;
        cur=g32(p,cur+4);
    }
    if(prev==-1){
        p32(p,256,blk);
    }else{
        p32(p,prev+4,blk);
    }
    p32(p,blk+4,cur);
    if(prev!=-1){
        let ps:i64=g32(p,prev);
        if(prev+ps==blk){
            p32(p,prev,ps+sz);
            p32(p,prev+4,cur);
            blk=prev;
            sz=ps+sz;
        }
    }
    let nx:i64=g32(p,blk+4);
    if(nx!=4294967295){
        let ns:i64=g32(p,nx);
        if(blk+sz==nx){
            p32(p,blk,sz+ns);
            p32(p,blk+4,g32(p,nx+4));
        }
    }
    return;
}
fn emit_alloc(id:[]u8,off:i64)void {
    _zag_print("ALLOC ");
    _zag_print(id);
    _zag_print(" ");
    if(off<0){
        _zag_print("-1");
    }else{
        _zag_print(_zag_i64_to_str(off));
    }
    _zag_print("\n");
    return;
}
fn emit_free(id:[]u8,ptr:i64,p:[]u8)void {
    if(ptr>=0){
        a_free(p,ptr);
        _zag_print("FREE ");
        _zag_print(id);
        _zag_print(" OK\n");
    }else{
        _zag_print("FREE ");
        _zag_print(id);
        _zag_print(" SKIP\n");
    }
    return;
}
fn main()void {
    let ap:*u8=_zag_malloc(264) as *u8;
    let pool:[]u8=ap[0..264];
    a_init(pool);
    let a:i64=a_alloc(pool,32);
    emit_alloc("A",a);
    let b:i64=a_alloc(pool,32);
    emit_alloc("B",b);
    let c:i64=a_alloc(pool,32);
    emit_alloc("C",c);
    let d0:i64=a_alloc(pool,64);
    emit_alloc("D0",d0);
    emit_free("A",a,pool);
    emit_free("B",b,pool);
    let e:i64=a_alloc(pool,64);
    emit_alloc("E",e);
    emit_free("C",c,pool);
    emit_free("D0",d0,pool);
    emit_free("E",e,pool);
    let f:i64=a_alloc(pool,200);
    emit_alloc("F",f);
    let g:i64=a_alloc(pool,300);
    emit_alloc("G",g);
    _zag_print("DONE\n");
    return;
}

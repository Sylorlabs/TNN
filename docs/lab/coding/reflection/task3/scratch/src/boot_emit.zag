// ARM FROM-SCRATCH — bootloader emitter (iteration 1).
// Knowledge consulted: coding KB ONLY (no prior-art corpus).
// Derivation (from the spec + first principles):
//   The spec fully determines the CONTAINER: 512 bytes, bytes 510-511 =
//   0x55 0xAA, a fixed string somewhere in bytes 0-509, the rest padding.
//   What the spec does NOT determine — and no coding knowledge contains —
//   is the x86 real-mode MACHINE CODE for "print via BIOS INT 0x10 and
//   halt". Opcode encodings are arbitrary facts about the 8086; they cannot
//   be derived from first principles, and inventing bytes would be
//   fabrication, not engineering. This attempt therefore emits everything
//   the spec determines (size, signature, an ASCIIZ message, zero padding)
//   and leaves the code region zeroed, documenting the boundary explicitly.
//   Expected: B1/B2 pass, B3 fails -> diagnose KNOWLEDGE-GAP -> halt.
fn sb(p:*u8,o:i64,v:i64)void {
    p[o]=(v&255) as u8;
    return;
}
fn main()void {
    let ap:[]u8=_zag_arg(1);
    let out:[]u8=ap;
    if(ap.len==0){
        out="boot.bin";
    }
    let bp:*u8=_zag_malloc(512) as *u8;
    // message "HELLO", zero-terminated (any fixed string satisfies B5)
    sb(bp,0,72); sb(bp,1,69); sb(bp,2,76); sb(bp,3,76); sb(bp,4,79);
    sb(bp,5,0);
    let i:i64=6;
    while(i<510){
        sb(bp,i,0);
        i=i+1;
    }
    sb(bp,510,85);
    sb(bp,511,170);
    let pp:*u8=_zag_malloc(out.len+1) as *u8;
    let j:i64=0;
    while(j<out.len){
        pp[j]=out[j];
        j=j+1;
    }
    pp[out.len]=0;
    let fd:i64=_zag_raw_syscall(2, pp as i64, 577, 420, 0, 0, 0);
    if(fd<0){
        _zag_print("OPEN_FAIL\n");
        return;
    }
    let w:i64=_zag_raw_syscall(1, fd, bp as i64, 512, 0, 0, 0);
    let cl:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    _zag_print("WROTE ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("\n");
    return;
}

// ARM FROM-SCRATCH — round-robin scheduler simulation (iteration 1).
// Knowledge consulted: coding KB ONLY (no prior-art corpus).
// Derivation (from the spec + first principles):
//   "round-robin over 8 tasks" -> the tasks take turns in a fixed cyclic
//   order 0,1,2,...,7,0,1,...  The name itself describes the mechanism:
//   like dealing cards around a table. With 800 ticks and 8 tasks each
//   task must run exactly 100 times (800/8); skew = max-min = 0; no task
//   may be skipped (starvation bar). Selection rule: task = tick mod 8.
//   Per-task run counts prove the bars. The frozen stdout contract is the
//   spec's output shape; counts and the SEQ prefix are DERIVED from the
//   simulation, not copied.
fn pick(t:i64)i64 {
    return t%8;
}
fn main()void {
    let c0:i64=0; let c1:i64=0; let c2:i64=0; let c3:i64=0;
    let c4:i64=0; let c5:i64=0; let c6:i64=0; let c7:i64=0;
    let heads:*u8=_zag_malloc(16) as *u8;
    let t:i64=0;
    while(t<800){
        let task:i64=pick(t);
        if(t<16){
            heads[t]=(task&7) as u8;
        }
        if(task==0){c0=c0+1;}
        if(task==1){c1=c1+1;}
        if(task==2){c2=c2+1;}
        if(task==3){c3=c3+1;}
        if(task==4){c4=c4+1;}
        if(task==5){c5=c5+1;}
        if(task==6){c6=c6+1;}
        if(task==7){c7=c7+1;}
        t=t+1;
    }
    _zag_print("task 0: ");
    _zag_print(_zag_i64_to_str(c0));
    _zag_print("\ntask 1: ");
    _zag_print(_zag_i64_to_str(c1));
    _zag_print("\ntask 2: ");
    _zag_print(_zag_i64_to_str(c2));
    _zag_print("\ntask 3: ");
    _zag_print(_zag_i64_to_str(c3));
    _zag_print("\ntask 4: ");
    _zag_print(_zag_i64_to_str(c4));
    _zag_print("\ntask 5: ");
    _zag_print(_zag_i64_to_str(c5));
    _zag_print("\ntask 6: ");
    _zag_print(_zag_i64_to_str(c6));
    _zag_print("\ntask 7: ");
    _zag_print(_zag_i64_to_str(c7));
    _zag_print("\nSEQ");
    let k:i64=0;
    while(k<16){
        _zag_print(" ");
        _zag_print(_zag_i64_to_str(heads[k] as i64));
        k=k+1;
    }
    _zag_print("\n");
    return;
}

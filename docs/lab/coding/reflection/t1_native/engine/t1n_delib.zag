// t1n_delib.zag — T1N deliberation engine (repaired 2026-09-22).
//
// Implements driver/QUEUE_PROTOCOL.md (frozen 2026-09-22):
//   - §1: single-argument CLI (mode only); CWD is the arm workdir.
//   - §3: queue formats (compile_queue one path/line; run_queue exactly
//     3 TAB-separated fields; §3.3 escaping on results).
//   - §4: trace episodes: EP <id> <role> <phase> <cites> <input-hash>
//     <decision> <reasons>, with real SHA-256 input hashes.
//   - §6: generated module uses the NUL-terminated cx convention
//     (payload at cx[0..n], cx[n]=0).
//   - §9: probe pipeline P1-P6 (t1n_gen) + PR1/PR2 (t1n_diag, 5-arg form
//     with the fixed §7 evidence envelope).
//   - §1.3: goal->mechanism dispatch is DELIBERATED (route SHAPE vs
//     UNIFORM and mech rule ARGMAX vs FIRST are compared on evidence and
//     baked into the module); no goal-tier hardcoding.
//
// Pure Zag. Zero RNG: every decision is a deterministic function of the
// taught entries, the corpus records, probe evidence, and the trace.
// Byte-identical reruns.

fn d_cstr(s:[]u8)[]u8 {
    let n:i64=s.len;
    let p:*u8=_zag_malloc(n+1) as *u8;
    let b:[]u8=p[0..n+1];
    let i:i64=0;
    while(i<n){ b[i]=s[i]; i=i+1; }
    b[n]=0 as u8;
    return b;
}

fn d_open_w(path:[]u8, flags:i64)i64 {
    let cp:[]u8=d_cstr(path);
    return _zag_raw_syscall(2, _zag_slice_ptr(cp) as i64, flags, 420, 0, 0, 0);
}

fn d_write_fd(fd:i64, data:[]u8)i64 {
    let at:i64=0;
    while(at<data.len){
        let n:i64=_zag_raw_syscall(1, fd, (_zag_slice_ptr(data) as i64)+at, data.len-at, 0, 0, 0);
        if(n==-4){ continue; }
        if(n<=0){ return -1; }
        at=at+n;
    }
    return at;
}

fn d_close(fd:i64)void { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return; }


fn d_write_file(path:[]u8, data:[]u8)i64 {
    let fd:i64=d_open_w(path, 577);
    if(fd<0){ return fd; }
    let r:i64=d_write_fd(fd, data);
    d_close(fd);
    return r;
}

fn d_append_file(path:[]u8, data:[]u8)i64 {
    let fd:i64=d_open_w(path, 1089);
    if(fd<0){ return fd; }
    let r:i64=d_write_fd(fd, data);
    d_close(fd);
    return r;
}

fn d_read_file(path:[]u8, maxn:i64)[]u8 {
    let cp:[]u8=d_cstr(path);
    let fd:i64=_zag_raw_syscall(2, _zag_slice_ptr(cp) as i64, 0, 0, 0, 0, 0);
    if(fd<0){ return ""; }
    let sz:i64=_zag_raw_syscall(8, fd, 0, 2, 0, 0, 0);
    if(sz<0 || sz>maxn){ d_close(fd); return ""; }
    _zag_raw_syscall(8, fd, 0, 0, 0, 0, 0);
    let p:*u8=_zag_malloc(sz+1) as *u8;
    let b:[]u8=p[0..sz+1];
    let at:i64=0;
    while(at<sz){
        let n:i64=_zag_raw_syscall(0, fd, (_zag_slice_ptr(b) as i64)+at, sz-at, 0, 0, 0);
        if(n==-4){ continue; }
        if(n<=0){ d_close(fd); return ""; }
        at=at+n;
    }
    d_close(fd);
    return b[0..at];
}

fn d_mkdir(path:[]u8)void {
    let cp:[]u8=d_cstr(path);
    _zag_raw_syscall(83, _zag_slice_ptr(cp) as i64, 493, 0, 0, 0, 0);
    return;
}

fn d_eq(a:[]u8, b:[]u8)i32 {
    if(a.len!=b.len){ return 0; }
    let i:i64=0;
    while(i<a.len){ if(a[i]!=b[i]){ return 0; } i=i+1; }
    return 1;
}

fn d_starts(h:[]u8, p:[]u8)i32 {
    if(p.len>h.len){ return 0; }
    let i:i64=0;
    while(i<p.len){ if(h[i]!=p[i]){ return 0; } i=i+1; }
    return 1;
}

fn d_ends(h:[]u8, p:[]u8)i32 {
    if(p.len>h.len){ return 0; }
    let o:i64=h.len-p.len;
    let i:i64=0;
    while(i<p.len){ if(h[o+i]!=p[i]){ return 0; } i=i+1; }
    return 1;
}

fn d_find_from(h:[]u8, nd:[]u8, from:i64)i64 {
    if(nd.len==0){ return from; }
    if(from<0){ from=0; }
    if(nd.len>h.len){ return -1; }
    let i:i64=from;
    while(i+nd.len<=h.len){
        let j:i64=0;
        let ok:i64=1;
        while(j<nd.len){
            if(h[i+j]!=nd[j]){ ok=0; j=nd.len; } else { j=j+1; }
        }
        if(ok==1){ return i; }
        i=i+1;
    }
    return -1;
}

fn d_find(h:[]u8, nd:[]u8)i64 { return d_find_from(h, nd, 0); }
fn d_sub(s:[]u8, lo:i64, hi:i64)[]u8 {
    if(lo<0){ lo=0; }
    if(hi>s.len){ hi=s.len; }
    if(hi<=lo){ return ""; }
    return s[lo..hi];
}

fn d_lower(s:[]u8)[]u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let b:[]u8=p[0..s.len+1];
    let i:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=65 && c<=90){ b[i]=c+32; } else { b[i]=c; }
        i=i+1;
    }
    return b[0..s.len];
}

fn d_is_tokc(c:u8)i32 {
    if(c>=48 && c<=57){ return 1; }
    if(c>=65 && c<=90){ return 1; }
    if(c>=97 && c<=122){ return 1; }
    if(c==95){ return 1; }
    return 0;
}

fn d_arena_new(size:i64)[]u8 {
    let p:*u8=_zag_malloc(size) as *u8;
    let b:[]u8=p[0..size];
    let i:i64=0;
    while(i<8){ b[i]=0 as u8; i=i+1; }
    return b;
}

fn d_tget(t:[]u8, i:i64)i64 {
    let o:i64=i*8;
    let v:i64=0;
    let k:i64=0;
    while(k<8){
        let sh:i64=k*8;
        let bv:i64=t[o+k] as i64;
        let bit:i64=bv<<sh;
        v=v|bit;
        k=k+1;
    }
    return v;
}

fn d_tset(t:[]u8, i:i64, v:i64)void {
    let o:i64=i*8;
    let k:i64=0;
    while(k<8){
        let sh:i64=k*8;
        let bv:i64=(v>>sh)&255;
        t[o+k]=bv as u8;
        k=k+1;
    }
    return;
}

fn d_apos(a:[]u8)i64 { return d_tget(a, 0); }
fn d_sput(a:[]u8, s:[]u8)i64 {
    let pos:i64=d_apos(a);
    let need:i64=pos+s.len+1;
    if(need+8>a.len){ return -1; }
    let i:i64=0;
    while(i<s.len){ a[8+pos+i]=s[i]; i=i+1; }
    a[8+pos+s.len]=0 as u8;
    d_tset(a, 0, pos+s.len+1);
    return pos;
}

fn d_sget(a:[]u8, off:i64)[]u8 {
    let i:i64=off;
    while(a[8+i]!=0){ i=i+1; }
    return a[8+off..8+i];
}

fn d_tnew(n:i64)[]u8 {
    let p:*u8=_zag_malloc(n*8+8) as *u8;
    let b:[]u8=p[0..n*8+8];
    let i:i64=0;
    while(i<n*8+8){ b[i]=0 as u8; i=i+1; }
    return b;
}

fn d_cat(a:[]u8, b:[]u8)[]u8 {
    let p:*u8=_zag_malloc(a.len+b.len+1) as *u8;
    let o:[]u8=p[0..a.len+b.len+1];
    let i:i64=0;
    while(i<a.len){ o[i]=a[i]; i=i+1; }
    let j:i64=0;
    while(j<b.len){ o[a.len+j]=b[j]; j=j+1; }
    return o[0..a.len+b.len];
}

fn d_unesc(s:[]u8)[]u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let o:[]u8=p[0..s.len+1];
    let w:i64=0;
    let i:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==92 && i+1<s.len){
            let d:u8=s[i+1];
            if(d==92){ o[w]=92; w=w+1; }
            else {
                if(d==110){ o[w]=10; w=w+1; }
                else {
                    if(d==116){ o[w]=9; w=w+1; }
                    else {
                        if(d==114){ o[w]=13; w=w+1; }
                        else { o[w]=92; w=w+1; o[w]=d; w=w+1; }
                    }
                }
            }
            i=i+2;
        } else { o[w]=c; w=w+1; i=i+1; }
    }
    return o[0..w];
}

fn d_sanitize(s:[]u8)[]u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let o:[]u8=p[0..s.len+1];
    let i:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==10 || c==9 || c==13){ o[i]=32; } else { o[i]=c; }
        i=i+1;
    }
    return o[0..s.len];
}

fn d_chop_cr(line:[]u8)[]u8 {
    if(line.len>0 && line[line.len-1]==13){ return d_sub(line, 0, line.len-1); }
    return line;
}

fn d_parse_entries(data:[]u8, arena:[]u8, tab:[]u8, maxn:i64)i64 {
    let n:i64=0;
    let pos:i64=0;
    let dlen:i64=data.len;
    let st:i64=0;
    let id_o:i64=0; let ty_o:i64=0; let kw_o:i64=0;
    let bp:*u8=_zag_malloc(1048576) as *u8;
    let bb:[]u8=bp[0..1048576];
    let blen:i64=0;
    while(pos<dlen && n<maxn){
        let eol:i64=pos;
        while(eol<dlen && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=d_chop_cr(d_sub(data, pos, eol));
        if(eol<dlen){ pos=eol+1; } else { pos=dlen; }
        if(st==0){
            if(line.len>1 && line[0]==64 && d_eq(line, "@end")==0){
                id_o=d_sput(arena, d_sub(line, 1, line.len));
                st=1;
            }
        } else {
            if(st==1){
                if(line.len>2 && d_starts(line, "T:")){
                    ty_o=d_sput(arena, d_sub(line, 2, line.len));
                    st=2;
                } else { st=0; }
            } else {
                if(st==2){
                    if(line.len>=2 && d_starts(line, "K:")){
                        kw_o=d_sput(arena, d_sub(line, 2, line.len));
                        blen=0;
                        st=3;
                    } else { st=0; }
                } else {
                    if(d_eq(line, "@end")==1){
                        let body:[]u8=d_sub(bb, 0, blen);
                        if(body.len>0 && body[body.len-1]==10){ body=d_sub(body, 0, body.len-1); }
                        let bo:i64=d_sput(arena, body);
                        d_tset(tab, n*4+0, id_o);
                        d_tset(tab, n*4+1, ty_o);
                        d_tset(tab, n*4+2, kw_o);
                        d_tset(tab, n*4+3, bo);
                        n=n+1;
                        st=0;
                    } else {
                        let k:i64=0;
                        while(k<line.len){ bb[blen]=line[k]; blen=blen+1; k=k+1; }
                        bb[blen]=10; blen=blen+1;
                    }
                }
            }
        }
    }
    return n;
}

fn d_ef(tab:[]u8, arena:[]u8, i:i64, f:i64)[]u8 {
    return d_sget(arena, d_tget(tab, i*4+f));
}

fn d_find_entry(tab:[]u8, arena:[]u8, n:i64, id:[]u8)i64 {
    let i:i64=0;
    while(i<n){
        if(d_eq(d_ef(tab, arena, i, 0), id)==1){ return i; }
        i=i+1;
    }
    return -1;
}

fn d_cfg_get(cfg:[]u8, key:[]u8)[]u8 {
    let ke:[]u8=d_cat(key, "=");
    let pos:i64=0;
    while(pos<cfg.len){
        let eol:i64=pos;
        while(eol<cfg.len && cfg[eol]!=10){ eol=eol+1; }
        let line:[]u8=d_chop_cr(d_sub(cfg, pos, eol));
        if(eol<cfg.len){ pos=eol+1; } else { pos=cfg.len; }
        if(d_starts(line, ke)==1){ return d_sub(line, ke.len, line.len); }
    }
    return "";
}

fn d_parse_probes(data:[]u8, arena:[]u8, tab:[]u8, maxn:i64)i64 {
    let n:i64=0;
    let pos:i64=0;
    let dlen:i64=data.len;
    let st:i64=0;
    let f0:i64=0; let f1:[]u8=""; let f2:[]u8=""; let f3:[]u8=""; let f4:[]u8="";
    while(pos<dlen && n<maxn){
        let eol:i64=pos;
        while(eol<dlen && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=d_chop_cr(d_sub(data, pos, eol));
        if(eol<dlen){ pos=eol+1; } else { pos=dlen; }
        if(st==0){
            if(line.len>1 && line[0]==64 && d_eq(line, "@end")==0){
                f0=d_sput(arena, d_sub(line, 1, line.len));
                f1=""; f2=""; f3=""; f4="";
                st=1;
            }
        } else {
            if(d_eq(line, "@end")==1){
                d_tset(tab, n*5+0, f0);
                d_tset(tab, n*5+1, d_sput(arena, f1));
                d_tset(tab, n*5+2, d_sput(arena, f2));
                d_tset(tab, n*5+3, d_sput(arena, f3));
                d_tset(tab, n*5+4, d_sput(arena, f4));
                n=n+1;
                st=0;
            } else {
                if(d_starts(line, "SPEC:")==1){ f1=d_sub(line, 5, line.len); }
                else {
                    if(d_starts(line, "ARGS:")==1){ f2=d_sub(line, 5, line.len); }
                    else {
                        if(d_starts(line, "EXPECT:")==1){ f3=d_unesc(d_sub(line, 7, line.len)); }
                        else {
                            if(d_starts(line, "SEED:")==1){ f4=d_unesc(d_sub(line, 5, line.len)); }
                        }
                    }
                }
            }
        }
    }
    return n;
}

fn d_pf(tab:[]u8, arena:[]u8, i:i64, f:i64)[]u8 {
    return d_sget(arena, d_tget(tab, i*5+f));
}

fn d_qcompile(path:[]u8)void {
    d_append_file("compile_queue.txt", d_cat(path, "\n"));
    return;
}

fn d_qrun(bin:[]u8, args:[]u8, capture:[]u8)void {
    let l1:[]u8=d_cat(bin, "\t");
    let l2:[]u8=d_cat(l1, args);
    let l3:[]u8=d_cat(l2, "\tCAPTURE=");
    let l4:[]u8=d_cat(l3, capture);
    d_append_file("run_queue.txt", d_cat(l4, "\n"));
    return;
}

fn d_resolve_cites(tab:[]u8, arena:[]u8, n:i64, csv:[]u8, out:[]u8)i64 {
    let res:[]u8="";
    let first:i64=1;
    let pos:i64=0;
    while(pos<=csv.len){
        let e:i64=pos;
        while(e<csv.len && csv[e]!=44){ e=e+1; }
        let id:[]u8=d_sub(csv, pos, e);
        if(id.len>0 && d_find_entry(tab, arena, n, id)>=0){
            if(first==0){ res=d_cat(res, ","); }
            res=d_cat(res, id);
            first=0;
        }
        if(e>=csv.len){ pos=csv.len+1; } else { pos=e+1; }
    }
    if(first==1){ return d_sput(out, "-"); }
    return d_sput(out, res);
}

fn d_type_summary(tab:[]u8, arena:[]u8, n:i64, out:[]u8)i64 {
    let toff:[]u8=d_tnew(40);
    let tcnt:[]u8=d_tnew(40);
    let nt:i64=0;
    let i:i64=0;
    while(i<n){
        let ty:[]u8=d_ef(tab, arena, i, 1);
        let k:i64=0;
        let fnd:i64=-1;
        while(k<nt){
            if(d_eq(d_sget(out, d_tget(toff, k)), ty)==1){ fnd=k; k=nt; } else { k=k+1; }
        }
        if(fnd<0 && nt<40){
            d_tset(toff, nt, d_sput(out, ty));
            d_tset(tcnt, nt, 1);
            nt=nt+1;
        } else {
            if(fnd>=0){ d_tset(tcnt, fnd, d_tget(tcnt, fnd)+1); }
        }
        i=i+1;
    }
    let res:[]u8="";
    let k2:i64=0;
    while(k2<nt){
        if(k2>0){ res=d_cat(res, " "); }
        res=d_cat(res, d_sget(out, d_tget(toff, k2)));
        res=d_cat(res, "=");
        res=d_cat(res, _zag_i64_to_str(d_tget(tcnt, k2)));
        k2=k2+1;
    }
    return d_sput(out, res);
}

fn d_ids_of(tab:[]u8, arena:[]u8, n:i64, ty:[]u8, out:[]u8)i64 {
    let res:[]u8="";
    let first:i64=1;
    let i:i64=0;
    while(i<n){
        if(ty.len==0 || d_eq(d_ef(tab, arena, i, 1), ty)==1){
            if(first==0){ res=d_cat(res, ","); }
            res=d_cat(res, d_ef(tab, arena, i, 0));
            first=0;
        }
        i=i+1;
    }
    if(first==1){ return d_sput(out, "none"); }
    return d_sput(out, res);
}

fn d_sentences(text:[]u8, arena:[]u8, tab:[]u8, maxn:i64)i64 {
    let n:i64=0;
    let s:i64=0;
    while(s<text.len && (text[s]==32||text[s]==10||text[s]==9||text[s]==13)){ s=s+1; }
    let i:i64=s;
    while(i<text.len && n<maxn){
        let c:u8=text[i];
        let isend:i64=0;
        if(c==46||c==63||c==33){ isend=1; }
        if(isend==1){
            let nx:i64=i+1;
            let bnd:i64=0;
            if(nx>=text.len){ bnd=1; }
            else {
                let d:u8=text[nx];
                if(d==32||d==10||d==9||d==13){ bnd=1; }
            }
            if(bnd==1){
                d_tset(tab, n, d_sput(arena, d_sub(text, s, i+1)));
                n=n+1;
                s=nx;
                while(s<text.len && (text[s]==32||text[s]==10||text[s]==9||text[s]==13)){ s=s+1; }
                i=s;
            } else { i=i+1; }
        } else { i=i+1; }
    }
    if(s<text.len && n<maxn){
        d_tset(tab, n, d_sput(arena, d_sub(text, s, text.len)));
        n=n+1;
    }
    return n;
}

fn d_is_codechar(c:u8)i32 {
    if(c==59||c==123||c==125||c==40||c==41||c==91||c==93){ return 1; }
    if(c==60||c==62||c==38||c==124||c==33||c==42||c==43){ return 1; }
    if(c==45||c==47||c==37||c==94||c==126||c==34||c==61){ return 1; }
    return 0;
}

fn d_is_codetok(t:[]u8)i32 {
    if(t.len==0){ return 0; }
    let k:i64=0;
    if(t[0]==45){ k=1; }
    if(k<t.len){
        let alld:i64=1;
        while(k<t.len){
            if(t[k]<48 || t[k]>57){ alld=0; k=t.len; } else { k=k+1; }
        }
        if(alld==1){ return 1; }
    }
    k=0;
    while(k<t.len){
        if(d_is_codechar(t[k])==1){ return 1; }
        k=k+1;
    }
    let c0:u8=t[0];
    if((c0>=65&&c0<=90)||(c0>=97&&c0<=122)||c0==95){
        k=1;
        while(k<t.len && d_is_tokc(t[k])==1){ k=k+1; }
        if(k<t.len && (t[k]==40||t[k]==61)){ return 1; }
    }
    return 0;
}

fn d_codetoks(sent:[]u8, arena:[]u8, tab:[]u8, maxn:i64)i64 {
    let n:i64=0;
    let i:i64=0;
    while(i<sent.len && n<maxn){
        while(i<sent.len && (sent[i]==32||sent[i]==9||sent[i]==10||sent[i]==13)){ i=i+1; }
        let s:i64=i;
        while(i<sent.len && sent[i]!=32&&sent[i]!=9&&sent[i]!=10&&sent[i]!=13){ i=i+1; }
        if(i>s){
            let tok:[]u8=d_sub(sent, s, i);
            if(d_is_codetok(tok)==1){
                d_tset(tab, n, d_sput(arena, tok));
                n=n+1;
            }
        }
    }
    return n;
}

fn d_csv_pieces(csv:[]u8, arena:[]u8, tab:[]u8, maxn:i64)i64 {
    let n:i64=0;
    let s:i64=0;
    let i:i64=0;
    while(i<=csv.len && n<maxn){
        if(i==csv.len || csv[i]==44){
            if(i>s){
                d_tset(tab, n, d_sput(arena, d_sub(csv, s, i)));
                n=n+1;
            }
            s=i+1;
        }
        i=i+1;
    }
    return n;
}

fn d_kwover(k1:[]u8, k2:[]u8, arena:[]u8)i64 {
    let t1:[]u8=d_tnew(48);
    let t2:[]u8=d_tnew(48);
    let used:[]u8=d_tnew(48);
    let n1:i64=d_csv_pieces(k1, arena, t1, 48);
    let n2:i64=d_csv_pieces(k2, arena, t2, 48);
    let ov:i64=0;
    let j:i64=0;
    while(j<n2){
        let w2:[]u8=d_sget(arena, d_tget(t2, j));
        let k:i64=0;
        while(k<n1){
            if(d_tget(used, k)==0 && d_eq(d_sget(arena, d_tget(t1, k)), w2)==1){
                d_tset(used, k, 1);
                ov=ov+1;
                k=n1;
            } else { k=k+1; }
        }
        j=j+1;
    }
    return ov;
}

fn d_rank_base(tab:[]u8, arena:[]u8, n:i64, rkws:[]u8, rank:i64, sarena:[]u8)i64 {
    let picked:[]u8=d_tnew(n+4);
    let r:i64=0;
    let ans:i64=-1;
    while(r<=rank){
        let best:i64=-1;
        let bests:i64=-1;
        let i:i64=0;
        while(i<n){
            if(d_eq(d_ef(tab, arena, i, 1), "EMIT")==1 && d_tget(picked, i)==0){
                let s:i64=d_kwover(rkws, d_ef(tab, arena, i, 2), sarena);
                if(s>bests){ bests=s; best=i; }
            }
            i=i+1;
        }
        if(best<0){ return -1; }
        d_tset(picked, best, 1);
        ans=best;
        r=r+1;
    }
    return ans;
}

fn d_blocks(body:[]u8, tab:[]u8, maxn:i64)i64 {
    let n:i64=0;
    let i:i64=0;
    let depth:i64=0;
    let bs:i64=0;
    let instr:i64=0;
    while(i<body.len && n<maxn){
        let c:u8=body[i];
        if(instr==1){
            if(c==92){ i=i+2; }
            else {
                if(c==34){ instr=0; }
                i=i+1;
            }
        } else {
            if(c==34){ instr=1; i=i+1; }
            else {
                if(c==123){
                    if(depth==0){
                        let ls:i64=i;
                        while(ls>bs && body[ls-1]!=10){ ls=ls-1; }
                        if(ls>bs && n<maxn){
                            d_tset(tab, n*2+0, bs);
                            d_tset(tab, n*2+1, ls);
                            n=n+1;
                        }
                        bs=ls;
                    }
                    depth=depth+1;
                    i=i+1;
                } else {
                    if(c==125){
                        depth=depth-1;
                        if(depth<=0){
                            depth=0;
                            if(n<maxn){
                                d_tset(tab, n*2+0, bs);
                                d_tset(tab, n*2+1, i+1);
                                n=n+1;
                            }
                            bs=i+1;
                        }
                        i=i+1;
                    } else { i=i+1; }
                }
            }
        }
    }
    if(bs<body.len && n<maxn){
        d_tset(tab, n*2+0, bs);
        d_tset(tab, n*2+1, body.len);
        n=n+1;
    }
    return n;
}

fn d_idents(text:[]u8, arena:[]u8, tab:[]u8, maxn:i64)i64 {
    let n:i64=0;
    let i:i64=0;
    while(i<text.len && n<maxn){
        let c:u8=text[i];
        if((c>=65&&c<=90)||(c>=97&&c<=122)||c==95){
            let s:i64=i;
            i=i+1;
            while(i<text.len && d_is_tokc(text[i])==1){ i=i+1; }
            d_tset(tab, n, d_sput(arena, d_sub(text, s, i)));
            n=n+1;
        } else { i=i+1; }
    }
    return n;
}

fn d_tok_kind(t:[]u8)i64 {
    let k:i64=0;
    if(t.len>0 && t[0]==45){ k=1; }
    if(k<t.len){
        let alld:i64=1;
        while(k<t.len){
            if(t[k]<48||t[k]>57){ alld=0; k=t.len; } else { k=k+1; }
        }
        if(alld==1){ return 0; }
    }
    if(d_find(t, "\"")>=0){ return 1; }
    if(t.len>0){
        let c0:u8=t[0];
        if((c0>=65&&c0<=90)||(c0>=97&&c0<=122)||c0==95){
            let ok:i64=1;
            k=1;
            while(k<t.len){
                if(d_is_tokc(t[k])==0){ ok=0; k=t.len; } else { k=k+1; }
            }
            if(ok==1){ return 2; }
        }
    }
    return 3;
}

fn d_is_kw(s:[]u8)i32 {
    if(d_eq(s,"fn")==1||d_eq(s,"let")==1||d_eq(s,"if")==1||d_eq(s,"else")==1){ return 1; }
    if(d_eq(s,"while")==1||d_eq(s,"return")==1||d_eq(s,"struct")==1||d_eq(s,"as")==1){ return 1; }
    if(d_eq(s,"null")==1||d_eq(s,"i64")==1||d_eq(s,"u64")==1||d_eq(s,"i32")==1){ return 1; }
    if(d_eq(s,"u32")==1||d_eq(s,"u16")==1||d_eq(s,"u8")==1||d_eq(s,"void")==1){ return 1; }
    if(s.len>0 && s[0]==95){ return 1; }
    return 0;
}

fn d_cpref(a:[]u8, b:[]u8)i64 {
    let n:i64=0;
    while(n<a.len && n<b.len && a[n]==b[n]){ n=n+1; }
    return n;
}

fn d_copy_to(out:[]u8, w:i64, s:[]u8)i64 {
    let q:i64=0;
    while(q<s.len){ out[w+q]=s[q]; q=q+1; }
    return w+s.len;
}

fn d_next_tok(kl:[]u8, kc:[]u8, cyc:[]u8, kind:i64, stok_tab:[]u8)i64 {
    let cc:i64=d_tget(kc, kind);
    if(cc==0){ return -1; }
    let cy:i64=d_tget(cyc, kind);
    let ti:i64=d_tget(kl, kind*40+cy);
    cy=cy+1;
    if(cy>=cc){ cy=0; }
    d_tset(cyc, kind, cy);
    return d_tget(stok_tab, ti);
}

fn d_subst_line(line:[]u8, stok_tab:[]u8, stok_arena:[]u8, ntok:i64, tkind:[]u8,
                rent_tab:[]u8, rent_arena:[]u8, nent:i64, out:[]u8)i64 {
    let kl:[]u8=d_tnew(160);
    let kc:[]u8=d_tnew(4);
    let cyc:[]u8=d_tnew(4);
    let t:i64=0;
    while(t<ntok){
        let kk:i64=d_tget(tkind, t);
        let c:i64=d_tget(kc, kk);
        if(c<40){ d_tset(kl, kk*40+c, t); d_tset(kc, kk, c+1); }
        t=t+1;
    }
    let w:i64=0;
    let i:i64=0;
    while(i<line.len){
        let c:u8=line[i];
        if(c==34){
            let s:i64=i;
            i=i+1;
            let done:i64=0;
            while(i<line.len && done==0){
                if(line[i]==92){ i=i+2; }
                else { if(line[i]==34){ i=i+1; done=1; } else { i=i+1; } }
            }
            let orig:[]u8=d_sub(line, s, i);
            let rep:[]u8=orig;
            let to:i64=d_next_tok(kl, kc, cyc, 1, stok_tab);
            if(to>=0){ rep=d_sget(stok_arena, to); }
            w=d_copy_to(out, w, rep);
        } else {
            let isnum:i64=0;
            if(c>=48&&c<=57){ isnum=1; }
            else {
                if(c==45 && i+1<line.len && line[i+1]>=48 && line[i+1]<=57){
                    if(i==0){ isnum=1; }
                    else { if(d_is_tokc(line[i-1])==0){ isnum=1; } }
                }
            }
            if(isnum==1){
                let s2:i64=i;
                if(line[i]==45){ i=i+1; }
                while(i<line.len && line[i]>=48 && line[i]<=57){ i=i+1; }
                let orig2:[]u8=d_sub(line, s2, i);
                let rep2:[]u8=orig2;
                let to2:i64=d_next_tok(kl, kc, cyc, 0, stok_tab);
                if(to2>=0){ rep2=d_sget(stok_arena, to2); }
                w=d_copy_to(out, w, rep2);
            } else {
                if((c>=65&&c<=90)||(c>=97&&c<=122)||c==95){
                    let s3:i64=i;
                    i=i+1;
                    while(i<line.len && d_is_tokc(line[i])==1){ i=i+1; }
                    let ident:[]u8=d_sub(line, s3, i);
                    let rep3:[]u8=ident;
                    if(d_is_kw(ident)==0){
                        let best:i64=-1;
                        let bestsc:i64=2;
                        let e:i64=0;
                        while(e<nent){
                            let en:[]u8=d_sget(rent_arena, d_tget(rent_tab, e));
                            if(d_eq(en, ident)==0){
                                let sc:i64=d_cpref(ident, en);
                                if(d_find(ident, en)>=0 || d_find(en, ident)>=0){
                                    let m:[]u8=en;
                                    let ml:i64=m.len;
                                    if(ident.len<ml){ ml=ident.len; }
                                    if(ml>sc){ sc=ml; }
                                }
                                if(sc>bestsc){ bestsc=sc; best=e; }
                            }
                            e=e+1;
                        }
                        if(best>=0){ rep3=d_sget(rent_arena, d_tget(rent_tab, best)); }
                        else {
                            let to3:i64=d_next_tok(kl, kc, cyc, 2, stok_tab);
                            if(to3>=0){ rep3=d_sget(stok_arena, to3); }
                        }
                    }
                    w=d_copy_to(out, w, rep3);
                } else {
                    if(c==40){
                        let s4:i64=i;
                        let dep:i64=1;
                        i=i+1;
                        let ins:i64=0;
                        while(i<line.len && dep>0){
                            let dd:u8=line[i];
                            if(ins==1){
                                if(dd==92){ i=i+2; }
                                else { if(dd==34){ ins=0; } i=i+1; }
                            } else {
                                if(dd==34){ ins=1; i=i+1; }
                                else {
                                    if(dd==40){ dep=dep+1; }
                                    else { if(dd==41){ dep=dep-1; } }
                                    i=i+1;
                                }
                            }
                        }
                        let orig4:[]u8=d_sub(line, s4, i);
                        let rep4:[]u8=orig4;
                        let to4:i64=d_next_tok(kl, kc, cyc, 3, stok_tab);
                        if(to4>=0){ rep4=d_sget(stok_arena, to4); }
                        w=d_copy_to(out, w, rep4);
                    } else { out[w]=c; w=w+1; i=i+1; }
                }
            }
        }
    }
    return w;
}

fn d_novel_trig(kb:[]u8, karena:[]u8, kn:i64, cx:[]u8, carena:[]u8, ri:i64, rank:i64, sarena:[]u8, out:[]u8)i64 {
    let rkws:[]u8=d_ef(cx, carena, ri, 2);
    let bi:i64=d_rank_base(kb, karena, kn, rkws, rank, sarena);
    if(bi<0){ return d_sput(out, "-"); }
    let bkws:[]u8=d_ef(kb, karena, bi, 2);
    let t1:[]u8=d_tnew(48);
    let t2:[]u8=d_tnew(48);
    let n1:i64=d_csv_pieces(rkws, sarena, t1, 48);
    let n2:i64=d_csv_pieces(bkws, sarena, t2, 48);
    let res:[]u8="";
    let first:i64=1;
    let j:i64=0;
    while(j<n1){
        let w2:[]u8=d_sget(sarena, d_tget(t1, j));
        let k:i64=0;
        while(k<n2){
            if(d_eq(d_sget(sarena, d_tget(t2, k)), w2)==1){
                if(first==0){ res=d_cat(res, ","); }
                res=d_cat(res, w2);
                first=0;
                k=n2;
            } else { k=k+1; }
        }
        j=j+1;
    }
    if(first==1){ res=bkws; }
    return d_sput(out, res);
}

fn d_synthesize(cx:[]u8, carena:[]u8, ri:i64, kb:[]u8, karena:[]u8, kn:i64,
                rank:i64, sarena:[]u8, rep:[]u8)i64 {
    let rid:[]u8=d_ef(cx, carena, ri, 0);
    let rkws:[]u8=d_ef(cx, carena, ri, 2);
    let rbody:[]u8=d_ef(cx, carena, ri, 3);
    let bi:i64=d_rank_base(kb, karena, kn, rkws, rank, sarena);
    if(bi<0){ return -1; }
    let bid:[]u8=d_ef(kb, karena, bi, 0);
    let bbody:[]u8=d_ef(kb, karena, bi, 3);
    let snt:[]u8=d_tnew(64);
    let ns:i64=d_sentences(rbody, sarena, snt, 64);
    let st_ts:[]u8=d_tnew(64);
    let st_tc:[]u8=d_tnew(64);
    let stall:[]u8=d_tnew(2560);
    let tkind:[]u8=d_tnew(2560);
    let total:i64=0;
    let nsteps:i64=0;
    let si:i64=0;
    while(si<ns){
        let sent:[]u8=d_sget(sarena, d_tget(snt, si));
        let ta:[]u8=d_arena_new(8192);
        let tt:[]u8=d_tnew(40);
        let nt:i64=d_codetoks(sent, ta, tt, 40);
        if(nt>0 && nsteps<64 && total+nt<2560){
            d_tset(st_ts, nsteps, total);
            d_tset(st_tc, nsteps, nt);
            let q:i64=0;
            while(q<nt){
                let tok:[]u8=d_sget(ta, d_tget(tt, q));
                d_tset(stall, total+q, d_sput(sarena, tok));
                d_tset(tkind, total+q, d_tok_kind(tok));
                q=q+1;
            }
            total=total+nt;
            nsteps=nsteps+1;
        }
        si=si+1;
    }
    if(nsteps==0){ return 0; }
    let bl:[]u8=d_tnew(512);
    let nl:i64=0;
    let p:i64=0;
    while(p<bbody.len && nl<256){
        let e2:i64=p;
        while(e2<bbody.len && bbody[e2]!=10){ e2=e2+1; }
        d_tset(bl, nl*2+0, p);
        d_tset(bl, nl*2+1, e2);
        nl=nl+1;
        if(e2>=bbody.len){ p=bbody.len+1; } else { p=e2+1; }
    }
    let bt:[]u8=d_tnew(128);
    let nb:i64=d_blocks(bbody, bt, 64);
    let lb:[]u8=d_tnew(256);
    let li:i64=0;
    while(li<nl){
        let ls2:i64=d_tget(bl, li*2+0);
        let le2:i64=d_tget(bl, li*2+1);
        let b2:i64=0;
        let bb2:i64=-1;
        while(b2<nb){
            if(d_tget(bt, b2*2+0)<=ls2 && le2<=d_tget(bt, b2*2+1)){ bb2=b2; b2=nb; } else { b2=b2+1; }
        }
        d_tset(lb, li, bb2);
        li=li+1;
    }
    let ra:[]u8=d_arena_new(16384);
    let rt:[]u8=d_tnew(128);
    let nent:i64=0;
    let ia2:[]u8=d_arena_new(8192);
    let it2:[]u8=d_tnew(128);
    let ni2:i64=d_idents(rbody, ia2, it2, 128);
    let q2:i64=0;
    while(q2<ni2 && nent<128){
        let w2:[]u8=d_sget(ia2, d_tget(it2, q2));
        let dup:i64=0;
        let z2:i64=0;
        while(z2<nent){
            if(d_eq(d_sget(ra, d_tget(rt, z2)), w2)==1){ dup=1; z2=nent; } else { z2=z2+1; }
        }
        if(dup==0){ d_tset(rt, nent, d_sput(ra, w2)); nent=nent+1; }
        q2=q2+1;
    }
    let cbuf:[]u8=d_arena_new(131072);
    let cl:[]u8=d_tnew(256);
    li=0;
    while(li<nl){
        d_tset(cl, li, d_sput(cbuf, d_sub(bbody, d_tget(bl, li*2+0), d_tget(bl, li*2+1))));
        li=li+1;
    }
    let map:[]u8="";
    let st:i64=0;
    while(st<nsteps){
        let ts0:i64=d_tget(st_ts, st);
        let tc0:i64=d_tget(st_tc, st);
        let sa2:[]u8=d_arena_new(4096);
        let st2:[]u8=d_tnew(40);
        let nsi:i64=0;
        let q3:i64=0;
        while(q3<tc0 && nsi<40){
            let tok3:[]u8=d_sget(sarena, d_tget(stall, ts0+q3));
            let qa:[]u8=d_arena_new(1024);
            let qt:[]u8=d_tnew(16);
            let nq:i64=d_idents(tok3, qa, qt, 16);
            let z3:i64=0;
            while(z3<nq && nsi<40){
                let w3:[]u8=d_sget(qa, d_tget(qt, z3));
                let dup3:i64=0;
                let z4:i64=0;
                while(z4<nsi){
                    if(d_eq(d_sget(sa2, d_tget(st2, z4)), w3)==1){ dup3=1; z4=nsi; } else { z4=z4+1; }
                }
                if(dup3==0){ d_tset(st2, nsi, d_sput(sa2, w3)); nsi=nsi+1; }
                z3=z3+1;
            }
            q3=q3+1;
        }
        let bestl:i64=-1;
        let besto:i64=-1;
        li=0;
        while(li<nl){
            let ln:[]u8=d_sget(cbuf, d_tget(cl, li));
            let la3:[]u8=d_arena_new(2048);
            let lt3:[]u8=d_tnew(32);
            let nl3:i64=d_idents(ln, la3, lt3, 32);
            let ov:i64=0;
            let z5:i64=0;
            while(z5<nsi){
                let w5:[]u8=d_sget(sa2, d_tget(st2, z5));
                let z6:i64=0;
                while(z6<nl3){
                    if(d_eq(d_sget(la3, d_tget(lt3, z6)), w5)==1){ ov=ov+1; z6=nl3; } else { z6=z6+1; }
                }
                z5=z5+1;
            }
            if(ov>besto){ besto=ov; bestl=li; }
            li=li+1;
        }
        if(bestl>=0){
            let ln2:[]u8=d_sget(cbuf, d_tget(cl, bestl));
            let ob:[]u8=d_tnew(8192);
            let tk2:[]u8=d_tnew(tc0+1);
            let rk:[]u8=d_tnew(tc0+1);
            let q4:i64=0;
            while(q4<tc0){
                d_tset(tk2, q4, d_tget(tkind, ts0+q4));
                d_tset(rk, q4, d_tget(stall, ts0+q4));
                q4=q4+1;
            }
            let wl:i64=d_subst_line(ln2, rk, sarena, tc0, tk2, rt, ra, nent, ob);
            d_tset(cl, bestl, d_sput(cbuf, d_sub(ob, 0, wl)));
            let blk:i64=d_tget(lb, bestl);
            let firstl:i64=bestl;
            while(firstl>0 && d_tget(lb, firstl-1)==blk){ firstl=firstl-1; }
            map=d_cat(map, "s");
            map=d_cat(map, _zag_i64_to_str(st));
            map=d_cat(map, "->b");
            map=d_cat(map, _zag_i64_to_str(blk));
            map=d_cat(map, ":l");
            map=d_cat(map, _zag_i64_to_str(bestl-firstl));
            map=d_cat(map, ";");
        }
        st=st+1;
    }
    let outp:[]u8=d_tnew(131072);
    let wp:i64=0;
    li=0;
    while(li<nl){
        let ln3:[]u8=d_sget(cbuf, d_tget(cl, li));
        wp=d_copy_to(outp, wp, ln3);
        outp[wp]=10;
        wp=wp+1;
        li=li+1;
    }
    let fname:[]u8=d_cat("candidates/novel_", d_cat(rid, d_cat("_r", d_cat(_zag_i64_to_str(rank+1), ".zag"))));
    d_write_file(fname, d_sub(outp, 0, wp));
    d_qcompile(fname);
    let rs:[]u8=d_cat("steps=", _zag_i64_to_str(nsteps));
    rs=d_cat(rs, " base=");
    rs=d_cat(rs, bid);
    rs=d_cat(rs, " map=");
    rs=d_cat(rs, map);
    rs=d_cat(rs, " record: \"");
    rs=d_cat(rs, d_sanitize(d_sub(rbody, 0, 100)));
    rs=d_cat(rs, "\"");
    d_sput(rep, rs);
    return nsteps;
}

fn d_atoi(s:[]u8)i64 {
    let v:i64=0;
    let k:i64=0;
    while(k<s.len){
        let c:u8=s[k];
        if(c>=48&&c<=57){ v=v*10+(c as i64)-48; }
        k=k+1;
    }
    return v;
}

fn d_cfg_ival(cfg:[]u8, key:[]u8, def:i64)i64 {
    let v:[]u8=d_cfg_get(cfg, key);
    if(v.len==0){ return def; }
    return d_atoi(v);
}

fn d_parse_results(data:[]u8, arena:[]u8, tab:[]u8, maxn:i64)i64 {
    let n:i64=0;
    let p:i64=0;
    while(p<data.len && n<maxn){
        let f:i64=d_find_from(data, "@@FILE ", p);
        if(f<0){ p=data.len; }
        else {
            let pe:i64=f+7;
            while(pe<data.len && data[pe]!=10){ pe=pe+1; }
            let path:[]u8=d_sub(data, f+7, pe);
            let rc:i64=0;
            let rp:i64=d_find_from(data, "rc=", pe);
            if(rp>=0){
                let q:i64=rp+3;
                let neg:i64=0;
                if(q<data.len && data[q]==45){ neg=1; q=q+1; }
                while(q<data.len && data[q]>=48 && data[q]<=57){
                    rc=rc*10+(data[q] as i64)-48;
                    q=q+1;
                }
                if(neg==1){ rc=0-rc; }
            }
            let sp:i64=d_find_from(data, "STDERR:\n", pe);
            let se:i64=-1;
            if(sp>=0){ se=d_find_from(data, "\n@@END", sp+8); }
            let serr:[]u8="";
            if(sp>=0 && se>=0){ serr=d_unesc(d_sub(data, sp+8, se)); }
            d_tset(tab, n*3+0, d_sput(arena, path));
            d_tset(tab, n*3+1, rc);
            d_tset(tab, n*3+2, d_sput(arena, serr));
            n=n+1;
            if(se>=0){ p=se+6; } else { p=data.len; }
        }
    }
    return n;
}

fn d_cand_kind(path:[]u8, arena:[]u8)i64 {
    // returns kind*1000000 + round, id at d_sget(arena,0); -1 if unknown
    if(d_starts(path, "candidates/basic_")==1){
        let rest:[]u8=d_sub(path, 17, path.len);
        // strip .zag, check _r1
        let round:i64=0;
        let id:[]u8=rest;
        if(rest.len>8 && d_eq(d_sub(rest, rest.len-4, rest.len), ".zag")==1){
            let core:[]u8=d_sub(rest, 0, rest.len-4);
            if(core.len>3 && d_eq(d_sub(core, core.len-3, core.len), "_r1")==1){
                round=1;
                id=d_sub(core, 0, core.len-3);
            } else { id=core; }
            d_sput(arena, id);
            return 0*1000000+round;
        }
        return -1;
    }
    if(d_starts(path, "candidates/novel_")==1){
        let rest2:[]u8=d_sub(path, 17, path.len);
        if(rest2.len>8 && d_eq(d_sub(rest2, rest2.len-4, rest2.len), ".zag")==1){
            let core2:[]u8=d_sub(rest2, 0, rest2.len-4);
            // find _r<N> suffix
            let u:i64=core2.len-1;
            while(u>=0 && core2[u]!=95){ u=u-1; }
            if(u>0 && u+2<=core2.len && core2[u+1]==114){
                let rnum:[]u8=d_sub(core2, u+2, core2.len);
                let round2:i64=d_atoi(rnum);
                if(round2>=1){
                    d_sput(arena, d_sub(core2, 0, u));
                    return 1*1000000+round2;
                }
            }
        }
        return -1;
    }
    return -1;
}

fn d_fidelity(cand:[]u8, rbody:[]u8, arena:[]u8)i64 {
    let snt:[]u8=d_tnew(32);
    let ns:i64=d_sentences(rbody, arena, snt, 32);
    let tot:i64=0;
    let found:i64=0;
    let si:i64=0;
    while(si<ns){
        let sent:[]u8=d_sget(arena, d_tget(snt, si));
        let ta:[]u8=d_arena_new(4096);
        let tt:[]u8=d_tnew(32);
        let nt:i64=d_codetoks(sent, ta, tt, 32);
        let q:i64=0;
        while(q<nt){
            let tok:[]u8=d_sget(ta, d_tget(tt, q));
            // dedup within record
            tot=tot+1;
            if(d_find(cand, tok)>=0){ found=found+1; }
            q=q+1;
        }
        si=si+1;
    }
    return found*1000000+tot;
}
fn d_die(msg:[]u8)i32 {
    _zag_print("t1n_delib: ");
    _zag_print(msg);
    _zag_print("\n");
    return 1;
}
fn d_cmo(s:[]u8)void {
    d_append_file("t1n_arch.zag", s);
    return;
}

// ================= SHA-256 (trace input-hash, freeze) =================
// Pure-Zag SHA-256 over []u8 arenas with explicit byte accessors.
// (The engine previously had only FNV-1a; §4 requires real SHA-256 hex.)
fn d_hexval(c:u8)i64 {
    if(c>=48 && c<=57){ return (c as i64)-48; }
    if(c>=97 && c<=102){ return (c as i64)-87; }
    if(c>=65 && c<=70){ return (c as i64)-55; }
    return 0;
}
// fully zeroed allocation (d_arena_new only zeroes its 8-byte header)
fn d_zalloc(n:i64)[]u8 {
    let p:*u8=_zag_malloc(n) as *u8;
    let b:[]u8=p[0..n];
    let i:i64=0;
    while(i<n){ b[i]=0; i=i+1; }
    return b;
}
fn d_bput32(b:[]u8, o:i64, v:i64)void {
    let x:i64=v&4294967295;
    b[o]=((x>>24)&255) as u8;
    b[o+1]=((x>>16)&255) as u8;
    b[o+2]=((x>>8)&255) as u8;
    b[o+3]=(x&255) as u8;
    return;
}
fn d_bget32(b:[]u8, o:i64)i64 {
    let v:i64=0;
    v=v|((b[o] as i64)<<24);
    v=v|((b[o+1] as i64)<<16);
    v=v|((b[o+2] as i64)<<8);
    v=v|(b[o+3] as i64);
    return v;
}
fn d_rotr(x:i64, n:i64)i64 {
    let xm:i64=x&4294967295;
    let sh:i64=32-n;
    let a:i64=xm>>n;
    let b:i64=xm<<sh;
    return (a|b)&4294967295;
}
// plain i64 -> decimal (avoids any _zag_i64_to_str formatting doubt)
fn d_i64s(v:i64)[]u8 {
    if(v==0){ return "0"; }
    let neg:i64=0;
    let x:i64=v;
    if(x<0){ neg=1; x=0-x; }
    let tmp:[]u8=d_zalloc(24);
    let n:i64=0;
    while(x>0){
        let dg:i64=x-(x/10)*10;
        tmp[n]=(dg+48) as u8;
        n=n+1;
        x=x/10;
    }
    let total:i64=n+neg;
    let o:[]u8=d_zalloc(total);
    let i:i64=0;
    if(neg==1){ o[0]=45; i=1; }
    let j:i64=0;
    while(j<n){
        o[i+j]=tmp[n-1-j];
        j=j+1;
    }
    return o[0..total];
}
fn d_sha256_block(h:[]u8, k:[]u8, blk:[]u8)void {
    let w:[]u8=d_zalloc(256);
    let i:i64=0;
    while(i<16){
        let o:i64=i*4;
        d_bput32(w, o, d_bget32(blk, o));
        i=i+1;
    }
    while(i<64){
        let o15:i64=(i-15)*4;
        let o2:i64=(i-2)*4;
        let o16:i64=(i-16)*4;
        let o7:i64=(i-7)*4;
        let x15:i64=d_bget32(w, o15);
        let x2:i64=d_bget32(w, o2);
        let t1:i64=d_rotr(x15, 7)^d_rotr(x15, 18);
        let t2:i64=t1^d_rotr(x15, 3);
        let s0:i64=t2^(x15>>3);
        let u1:i64=d_rotr(x2, 17)^d_rotr(x2, 19);
        let u2:i64=u1^d_rotr(x2, 10);
        let s1:i64=u2^(x2>>10);
        let oi:i64=i*4;
        let nw:i64=d_bget32(w, o16)+s0+d_bget32(w, o7)+s1;
        d_bput32(w, oi, nw);
        i=i+1;
    }
    let a:i64=d_bget32(h, 0);
    let b:i64=d_bget32(h, 4);
    let c:i64=d_bget32(h, 8);
    let dd:i64=d_bget32(h, 12);
    let e:i64=d_bget32(h, 16);
    let f:i64=d_bget32(h, 20);
    let g:i64=d_bget32(h, 24);
    let hh:i64=d_bget32(h, 28);
    let j:i64=0;
    while(j<64){
        let oj:i64=j*4;
        let s1a:i64=d_rotr(e, 6)^d_rotr(e, 11);
        let s1b:i64=s1a^d_rotr(e, 25);
        let note:i64=4294967295^e;
        let ch:i64=(e&f)^(note&g);
        let t1c:i64=hh+s1b+ch+d_bget32(k, oj)+d_bget32(w, oj);
        let s0a:i64=d_rotr(a, 2)^d_rotr(a, 13);
        let s0b:i64=s0a^d_rotr(a, 22);
        let ab:i64=a&b;
        let ac:i64=a&c;
        let bc:i64=b&c;
        let maj:i64=ab^ac^bc;
        let t2c:i64=s0b+maj;
        hh=g;
        g=f;
        f=e;
        e=(dd+t1c)&4294967295;
        dd=c;
        c=b;
        b=a;
        a=(t1c+t2c)&4294967295;
        j=j+1;
    }
    d_bput32(h, 0, d_bget32(h, 0)+a);
    d_bput32(h, 4, d_bget32(h, 4)+b);
    d_bput32(h, 8, d_bget32(h, 8)+c);
    d_bput32(h, 12, d_bget32(h, 12)+dd);
    d_bput32(h, 16, d_bget32(h, 16)+e);
    d_bput32(h, 20, d_bget32(h, 20)+f);
    d_bput32(h, 24, d_bget32(h, 24)+g);
    d_bput32(h, 28, d_bget32(h, 28)+hh);
    return;
}
// sha256 hex (64 lowercase chars) of msg
fn d_sha256_hex(msg:[]u8)[]u8 {
    let kh:[]u8="";
    let k:[]u8=d_zalloc(256);
    let i:i64=0;
    while(i<64){
        let wv:i64=0;
        let q:i64=0;
        while(q<8){
            let o:i64=i*8+q;
            wv=(wv<<4)|d_hexval(kh[o]);
            q=q+1;
        }
        let o2:i64=i*4;
        d_bput32(k, o2, wv);
        i=i+1;
    }
    let h:[]u8=d_zalloc(32);
    d_bput32(h, 0, 1779033703);
    d_bput32(h, 4, 3144134277);
    d_bput32(h, 8, 1013904242);
    d_bput32(h, 12, 2773480762);
    d_bput32(h, 16, 1359893119);
    d_bput32(h, 20, 2600822924);
    d_bput32(h, 24, 528734635);
    d_bput32(h, 28, 1541459225);
    let bitlen:i64=msg.len*8;
    let plen:i64=((msg.len+9+63)/64)*64;
    let m:[]u8=d_zalloc(plen);
    i=0;
    while(i<msg.len){
        m[i]=msg[i];
        i=i+1;
    }
    m[msg.len]=128;
    let r:i64=0;
    while(r<8){
        let sh2:i64=(7-r)*8;
        m[plen-8+r]=((bitlen>>sh2)&255) as u8;
        r=r+1;
    }
    let off:i64=0;
    while(off<plen){
        d_sha256_block(h, k, d_sub(m, off, off+64));
        off=off+64;
    }
    let hx:[]u8="0123456789abcdef";
    let o:[]u8=d_zalloc(64);
    i=0;
    while(i<8){
        let o3:i64=i*4;
        let wv2:i64=d_bget32(h, o3);
        let s:i64=0;
        while(s<4){
            let sh3:i64=(3-s)*8;
            let by:i64=(wv2>>sh3)&255;
            let hi:i64=by/16;
            let lo:i64=by-hi*16;
            let o4:i64=i*8+s*2;
            o[o4]=hx[hi];
            o[o4+1]=hx[lo];
            s=s+1;
        }
        i=i+1;
    }
    return o;
}

// ================= episodes (§4 protocol) =================
// EP <id> <role> <phase> <cites> <input-hash> <decision> <reasons>
// <id> is EP0001, EP0002, ... (monotonic, no reuse).
// <cites> is comma-separated taught entry IDs or "-".
// <input-hash> is sha256 hex of the primary input, or "-".
fn d_epid(seq:i64)[]u8 {
    let s:[]u8=d_i64s(seq);
    let o:[]u8="EP";
    let k:i64=s.len;
    while(k<4){
        o=d_cat(o, "0");
        k=k+1;
    }
    return d_cat(o, s);
}
fn d_ep(seq:i64, role:[]u8, phase:[]u8, cites:[]u8, ihash:[]u8, decision:[]u8, reasons:[]u8)void {
    let ln:[]u8=d_cat("EP ", d_epid(seq));
    ln=d_cat(ln, " ");
    ln=d_cat(ln, role);
    ln=d_cat(ln, " ");
    ln=d_cat(ln, phase);
    ln=d_cat(ln, " ");
    ln=d_cat(ln, cites);
    ln=d_cat(ln, " ");
    ln=d_cat(ln, ihash);
    ln=d_cat(ln, " ");
    ln=d_cat(ln, decision);
    ln=d_cat(ln, " ");
    ln=d_cat(ln, d_sanitize(reasons));
    ln=d_cat(ln, "\n");
    d_append_file("trace.txt", ln);
    return;
}
// next episode sequence = max existing id + 1 (1 when no trace yet)
fn d_ep_seq()i64 {
    let t:[]u8=d_read_file("trace.txt", 8388608);
    if(t.len==0){ return 1; }
    let mx:i64=0;
    let p:i64=0;
    while(p<t.len){
        let eol:i64=p;
        while(eol<t.len && t[eol]!=10){ eol=eol+1; }
        let ln:[]u8=d_sub(t, p, eol);
        if(ln.len>=9){
            if(d_eq(d_sub(ln, 0, 3), "EP ")==1){
                if(d_eq(d_sub(ln, 3, 5), "EP")==1){
                    let v:i64=d_atoi(d_sub(ln, 5, 9));
                    if(v>mx){ mx=v; }
                }
            }
        }
        if(eol<t.len){ p=eol+1; } else { p=t.len; }
    }
    return mx+1;
}
// field idx (0-based) of a space-separated trace line; "" if absent
fn d_tr_field(ln:[]u8, idx:i64)[]u8 {
    let f:i64=0;
    let p:i64=0;
    while(p<=ln.len){
        let q:i64=p;
        while(q<ln.len && ln[q]!=32){ q=q+1; }
        if(f==idx){ return d_sub(ln, p, q); }
        f=f+1;
        p=q+1;
    }
    return "";
}
// most recent trace line whose decision field (6) starts with prefix
fn d_tr_last_dec(eps:[]u8, prefix:[]u8)[]u8 {
    let best:[]u8="";
    let p:i64=0;
    while(p<eps.len){
        let eol:i64=p;
        while(eol<eps.len && eps[eol]!=10){ eol=eol+1; }
        let ln:[]u8=d_sub(eps, p, eol);
        let dec:[]u8=d_tr_field(ln, 6);
        if(dec.len>=prefix.len){
            if(d_eq(d_sub(dec, 0, prefix.len), prefix)==1){ best=ln; }
        }
        if(eol<eps.len){ p=eol+1; } else { p=eps.len; }
    }
    return best;
}
// 1 if any trace line has a decision starting with prefix
fn d_tr_has_dec(eps:[]u8, prefix:[]u8)i64 {
    if(d_tr_last_dec(eps, prefix).len>0){ return 1; }
    return 0;
}
// collect trace lines with the given phase token into arena/tab
fn d_tr_phase(eps:[]u8, phase:[]u8, arena:[]u8, tab:[]u8, maxn:i64)i64 {
    let n:i64=0;
    let p:i64=0;
    while(p<eps.len && n<maxn){
        let eol:i64=p;
        while(eol<eps.len && eps[eol]!=10){ eol=eol+1; }
        let ln:[]u8=d_sub(eps, p, eol);
        if(d_eq(d_tr_field(ln, 3), phase)==1){
            d_tset(tab, n, d_sput(arena, ln));
            n=n+1;
        }
        if(eol<eps.len){ p=eol+1; } else { p=eps.len; }
    }
    return n;
}

// ---------- propose mode ----------
// Reads: config.txt, entries.txt, corpus.txt (informed only), probes.txt.
// Writes: candidates/*.zag, compile_queue.txt. Appends: trace.txt.
fn m_propose()i32 {
    let cfg:[]u8=d_read_file("config.txt", 65536);
    if(cfg.len==0){ return d_die("missing config.txt"); }
    let arm:[]u8=d_cfg_get(cfg, "arm");
    if(d_eq(arm, "informed")==0 && d_eq(arm, "scratch")==0){ return d_die("config arm must be informed|scratch"); }
    let max_novel:i64=d_cfg_ival(cfg, "max_novel_rounds", 3);
    let ed:[]u8=d_read_file("entries.txt", 4194304);
    if(ed.len==0){ return d_die("missing entries.txt"); }
    let karena:[]u8=d_arena_new(1048576);
    let kb:[]u8=d_tnew(512);
    let kn:i64=d_parse_entries(ed, karena, kb, 512);
    if(kn==0){ return d_die("no entries parsed"); }
    let cxd:[]u8=d_read_file("corpus.txt", 4194304);
    let carena:[]u8=d_arena_new(262144);
    let cx:[]u8=d_tnew(64);
    let xn:i64=0;
    if(cxd.len>0){
        if(d_eq(arm, "scratch")==1){ return d_die("scratch arm with non-empty corpus: ARM_VOID"); }
        xn=d_parse_entries(cxd, carena, cx, 64);
    }
    let pd:[]u8=d_read_file("probes.txt", 65536);
    if(pd.len==0){ return d_die("missing probes.txt"); }
    let parena:[]u8=d_arena_new(65536);
    let ptab:[]u8=d_tnew(64);
    let pn:i64=d_parse_probes(pd, parena, ptab, 64);
    d_write_file("compile_queue.txt", "");
    d_mkdir("candidates");
    let eseq:i64=d_ep_seq();
    let sa:[]u8=d_arena_new(32768);
    // 1. teach review
    let sum:[]u8=d_sget(sa, d_type_summary(kb, karena, kn, sa));
    let el:[]u8=d_sget(sa, d_ids_of(kb, karena, kn, "EMIT", sa));
    let rl:[]u8=d_sget(sa, d_ids_of(cx, carena, xn, "", sa));
    let tr:[]u8=d_cat("taught=", d_i64s(kn));
    tr=d_cat(tr, " entries types(");
    tr=d_cat(tr, sum);
    tr=d_cat(tr, "); EMIT ids: ");
    tr=d_cat(tr, el);
    tr=d_cat(tr, "; corpus records: ");
    tr=d_cat(tr, rl);
    tr=d_cat(tr, "; probes=");
    tr=d_cat(tr, d_i64s(pn));
    d_ep(eseq, "PROPOSER", "PROPOSE", "-", d_sha256_hex(ed), "TEACH:REVIEW", tr);
    eseq=eseq+1;
    // 2. basic adoption: verbatim copies of T:EMIT entries
    let qc:i64=0;
    let bi:i64=0;
    while(bi<kn){
        if(d_eq(d_ef(kb, karena, bi, 1), "EMIT")==1){
            let eid:[]u8=d_ef(kb, karena, bi, 0);
            let ekws:[]u8=d_ef(kb, karena, bi, 2);
            let ebody:[]u8=d_ef(kb, karena, bi, 3);
            let bp:[]u8=d_cat("candidates/basic_", d_cat(eid, ".zag"));
            d_write_file(bp, ebody);
            d_qcompile(bp);
            qc=qc+1;
            let rs:[]u8="basic candidate: taught T:EMIT entry copied verbatim; ";
            rs=d_cat(rs, d_i64s(ebody.len));
            rs=d_cat(rs, " bytes; triggers=");
            rs=d_cat(rs, ekws);
            rs=d_cat(rs, "; fidelity to teacher is identity");
            d_ep(eseq, "PROPOSER", "PROPOSE", eid, d_sha256_hex(ebody), d_cat("ADOPT:", eid), rs);
            eseq=eseq+1;
        }
        bi=bi+1;
    }
    // 3. novel synthesis from corpus records (up to max_novel rounds each)
    let ri:i64=0;
    while(ri<xn){
        let rid:[]u8=d_ef(cx, carena, ri, 0);
        if(d_starts(rid, "C-ARCH-")==1){
            let nv:i64=d_atoi(d_sub(rid, 7, rid.len));
            if(nv>=2 && nv<=9){
                let round:i64=0;
                while(round<max_novel){
                    let rep:[]u8=d_arena_new(8192);
                    let r:i64=d_synthesize(cx, carena, ri, kb, karena, kn, round, sa, rep);
                    if(r>0){
                        let rs2:[]u8=d_sget(rep, 0);
                        let rkws:[]u8=d_ef(cx, carena, ri, 2);
                        let bir2:i64=d_rank_base(kb, karena, kn, rkws, round, sa);
                        if(bir2<0){
                            d_ep(eseq, "PROPOSER", "PROPOSE", rid, d_sha256_hex(d_ef(cx, carena, ri, 3)), d_cat("GAP:", rid), "novel synthesis produced a candidate but no ranked base; discarded");
                            eseq=eseq+1;
                        } else {
                        let bid:[]u8=d_ef(kb, karena, bir2, 0);
                        let nid:[]u8=d_cat(rid, "_r");
                        nid=d_cat(nid, d_i64s(round));
                        let np:[]u8=d_cat("candidates/novel_", d_cat(nid, ".zag"));
                        d_write_file(np, rs2);
                        d_qcompile(np);
                        qc=qc+1;
                        let cites:[]u8=d_cat(rid, ",");
                        cites=d_cat(cites, bid);
                        let rs3:[]u8="novel candidate: revision of taught base ";
                        rs3=d_cat(rs3, bid);
                        rs3=d_cat(rs3, " by trigger substitution from corpus record ");
                        rs3=d_cat(rs3, rid);
                        rs3=d_cat(rs3, "; candidate selection among ranked bases: alt1 ");
                        rs3=d_cat(rs3, bid);
                        rs3=d_cat(rs3, "; alt2 next-ranked base; chose by K-overlap rank ");
                        rs3=d_cat(rs3, d_i64s(round));
                        d_ep(eseq, "PROPOSER", "PROPOSE", cites, d_sha256_hex(d_ef(cx, carena, ri, 3)), d_cat("SYNTHESIZE:", nid), rs3);
                        eseq=eseq+1;
                        }
                    }
                    round=round+1;
                }
            }
        }
        ri=ri+1;
    }
    // 4. probe-shape review (evidence for compose-time routing deliberation)
    let nstruct:i64=0;
    let pi:i64=0;
    while(pi<pn){
        let spec:[]u8=d_pf(ptab, parena, pi, 1);
        if(d_probest(sa, spec)==1){ nstruct=nstruct+1; }
        pi=pi+1;
    }
    let pr:[]u8=d_i64s(pn);
    pr=d_cat(pr, " probe specs observed; ");
    pr=d_cat(pr, d_i64s(nstruct));
    pr=d_cat(pr, " structured (|-fields with k=v), ");
    pr=d_cat(pr, d_i64s(pn-nstruct));
    pr=d_cat(pr, " plain; shapes recorded for compose-time routing deliberation");
    d_ep(eseq, "PROPOSER", "PROPOSE", "-", d_sha256_hex(pd), "OBSERVE:probes", pr);
    eseq=eseq+1;
    // 5. selection element: derive from mechanism K: triggers
    let triglist:[]u8="";
    let ti:i64=0;
    while(ti<kn){
        if(d_eq(d_ef(kb, karena, ti, 1), "EMIT")==1){
            let tk:[]u8=d_ef(kb, karena, ti, 2);
            let tid:[]u8=d_ef(kb, karena, ti, 0);
            if(triglist.len>0){ triglist=d_cat(triglist, "; "); }
            triglist=d_cat(triglist, tid);
            triglist=d_cat(triglist, ":");
            triglist=d_cat(triglist, tk);
        }
        ti=ti+1;
    }
    let seld:[]u8="selection over mechanism K: triggers (";
    seld=d_cat(seld, triglist);
    seld=d_cat(seld, "); alt1 highest-overlap-wins; alt2 first-with-overlap-wins; ties broken by lowest index; no goal-tier routing");
    d_ep(eseq, "PROPOSER", "PROPOSE", "-", "-", "SELECT:selection-rule", seld);
    eseq=eseq+1;
    // 6. revision element: derive from T:LANG entries
    let langlist:[]u8="";
    let li:i64=0;
    while(li<kn){
        if(d_eq(d_ef(kb, karena, li, 1), "LANG")==1){
            let lid:[]u8=d_ef(kb, karena, li, 0);
            if(langlist.len>0){ langlist=d_cat(langlist, ","); }
            langlist=d_cat(langlist, lid);
        }
        li=li+1;
    }
    let revd:[]u8="revision policy from T:LANG (";
    revd=d_cat(revd, langlist);
    revd=d_cat(revd, "); alt1 apply LANG repair pairs to failing seed; alt2 synthesize next-ranked base; repair table baked at compose");
    d_ep(eseq, "PROPOSER", "PROPOSE", "-", "-", "SELECT:revision-policy", revd);
    eseq=eseq+1;
    // 7. gate element: derive from T:RULES entries
    let ruleids:[]u8="";
    let gi:i64=0;
    while(gi<kn){
        if(d_eq(d_ef(kb, karena, gi, 1), "RULES")==1){
            let gid:[]u8=d_ef(kb, karena, gi, 0);
            if(ruleids.len>0){ ruleids=d_cat(ruleids, ","); }
            ruleids=d_cat(ruleids, gid);
        }
        gi=gi+1;
    }
    let ssa:[]u8=d_arena_new(4096);
    let gcites:[]u8=d_sget(ssa, d_resolve_cites(kb, karena, kn, ruleids, ssa));
    let gated:[]u8="gate from T:RULES (";
    gated=d_cat(gated, ruleids);
    gated=d_cat(gated, "); refuse when spec matches rule K: triggers, else ALLOW");
    d_ep(eseq, "PROPOSER", "PROPOSE", gcites, "-", "SELECT:gate", gated);
    eseq=eseq+1;
    _zag_print("propose: queued=");
    _zag_print(d_i64s(qc));
    _zag_print("\n");
    return 0;
}
// structured probe test for propose-time review: 1 if spec has |-fields with k=v
fn d_probest(arena:[]u8, spec:[]u8)i64 {
    if(d_find(spec, "|")<0){ return 0; }
    let p:i64=0;
    while(p<spec.len){
        let q:i64=d_find_from(spec, "|", p);
        let e:i64=spec.len;
        if(q>=0){ e=q; }
        if(d_find(d_sub(spec, p, e), "=")>=0){ return 1; }
        if(q<0){ return 0; }
        p=q+1;
    }
    return 0;
}

// ---------- critique mode ----------
// Reads: compile_results.txt, run_results.txt, trace.txt.
// Writes: revised candidates/*.zag, compile_queue.txt, critique_done.txt
// (when nothing new queued). Appends: trace.txt.
// The driver re-invokes critique until critique_done.txt exists; already-
// decided paths are recovered from the trace (no sidecar state).
fn m_critique()i32 {
    let cfg:[]u8=d_read_file("config.txt", 65536);
    if(cfg.len==0){ return d_die("missing config.txt"); }
    let max_novel:i64=d_cfg_ival(cfg, "max_novel_rounds", 3);
    let ed:[]u8=d_read_file("entries.txt", 4194304);
    if(ed.len==0){ return d_die("missing entries.txt"); }
    let karena:[]u8=d_arena_new(1048576);
    let kb:[]u8=d_tnew(512);
    let kn:i64=d_parse_entries(ed, karena, kb, 512);
    let cxd:[]u8=d_read_file("corpus.txt", 4194304);
    let carena:[]u8=d_arena_new(262144);
    let cx:[]u8=d_tnew(64);
    let xn:i64=0;
    if(cxd.len>0){ xn=d_parse_entries(cxd, carena, cx, 64); }
    let rd:[]u8=d_read_file("compile_results.txt", 4194304);
    if(rd.len==0){ return d_die("missing compile_results.txt"); }
    let rd2:[]u8=d_read_file("run_results.txt", 4194304);
    let eps:[]u8=d_read_file("trace.txt", 8388608);
    let ra:[]u8=d_arena_new(262144);
    let rt:[]u8=d_tnew(192);
    let nb:i64=d_parse_results(rd, ra, rt, 64);
    d_write_file("compile_queue.txt", "");
    let eseq:i64=d_ep_seq();
    let sa:[]u8=d_arena_new(32768);
    // gate triggers from T:RULES (deliberated refusal vocabulary)
    let ga:[]u8=d_arena_new(8192);
    let gt:[]u8=d_tnew(64);
    let ngt:i64=d_gate_trigs(kb, karena, kn, ga, gt, 64);
    // ord = prior ACCEPT:candidates/ count from the trace
    let ord:i64=0;
    let op:i64=0;
    while(op<eps.len){
        let eol:i64=op;
        while(eol<eps.len && eps[eol]!=10){ eol=eol+1; }
        let ln:[]u8=d_sub(eps, op, eol);
        if(d_starts(d_tr_field(ln, 6), "ACCEPT:candidates/")==1){ ord=ord+1; }
        if(eol<eps.len){ op=eol+1; } else { op=eps.len; }
    }
    let rr:[]u8="run_results.txt ";
    if(rd2.len==0){ rr=d_cat(rr, "absent"); } else { rr=d_cat(rr, "present"); }
    rr=d_cat(rr, "; no candidate runs are queued at propose/critique; compile evidence only");
    d_ep(eseq, "CRITIC", "CRITIQUE", "-", "-", "OBSERVE:runs", rr);
    eseq=eseq+1;
    let newq:i64=0;
    let bi:i64=0;
    while(bi<nb){
        let path:[]u8=d_sget(ra, d_tget(rt, bi*3+0));
        let rc:i64=d_tget(rt, bi*3+1);
        let serr:[]u8=d_sget(ra, d_tget(rt, bi*3+2));
        if(d_decided(eps, path)==1){
            bi=bi+1;
        } else {
            let ka:[]u8=d_arena_new(4096);
            let kr:i64=d_cand_kind(path, ka);
            if(kr<0){
                d_ep(eseq, "CRITIC", "CRITIQUE", "-", "-", d_cat("SKIP:", path), "not a deliberation candidate path");
                eseq=eseq+1;
            } else {
                let kind:i64=kr/1000000;
                let round:i64=kr-(kind*1000000);
                let cid:[]u8=d_sget(ka, 0);
                let cand:[]u8=d_read_file(path, 1048576);
                let cites:[]u8="-";
                let trig:[]u8="-";
                let mech:[]u8=cid;
                let ok_cite:i64=1;
                let ok_fid:i64=1;
                let ok_dist:i64=1;
                let ok_gate:i64=1;
                if(kind==0){
                    let ei:i64=d_find_entry(kb, karena, kn, cid);
                    if(ei<0){ ok_cite=0; }
                    else {
                        cites=cid;
                        trig=d_ef(kb, karena, ei, 2);
                    }
                } else {
                    let ri:i64=d_find_entry(cx, carena, xn, cid);
                    if(ri<0){ ok_cite=0; }
                    else {
                        let rkws:[]u8=d_ef(cx, carena, ri, 2);
                        let bir:i64=d_rank_base(kb, karena, kn, rkws, round, sa);
                        if(bir<0){ ok_cite=0; }
                        else {
                            let bid3:[]u8=d_ef(kb, karena, bir, 0);
                            cites=d_cat(cid, ",");
                            cites=d_cat(cites, bid3);
                            let ta4:[]u8=d_arena_new(4096);
                            let to4:i64=d_novel_trig(kb, karena, kn, cx, carena, ri, round, sa, ta4);
                            trig=d_sget(ta4, to4);
                            let fr:i64=d_fidelity(cand, d_ef(cx, carena, ri, 3), sa);
                            let ff:i64=fr/1000000;
                            let ft:i64=fr-(ff*1000000);
                            if(ft>0 && ff*2<ft){ ok_fid=0; }
                        }
                    }
                }
                if(cand.len>0 && d_distinct_trace(cand, eps)==0){ ok_dist=0; }
                if(d_gate_hit(cand, ga, gt, ngt)==1){ ok_gate=0; }
                if(rc==0 && ok_cite==1 && ok_fid==1 && ok_dist==1 && ok_gate==1 && cand.len>0){
                    ord=ord+1;
                    let rs:[]u8="kind=";
                    if(kind==0){ rs=d_cat(rs, "basic"); } else { rs=d_cat(rs, "novel"); }
                    rs=d_cat(rs, " mech=");
                    rs=d_cat(rs, mech);
                    rs=d_cat(rs, " triggers=");
                    rs=d_cat(rs, trig);
                    rs=d_cat(rs, " ord=");
                    rs=d_cat(rs, d_i64s(ord));
                    rs=d_cat(rs, "; compile rc=0; cites resolve; ");
                    if(kind==1){ rs=d_cat(rs, "fidelity>=50%; "); }
                    rs=d_cat(rs, "distinct from prior accepted; no gate-trigger tokens");
                    d_ep(eseq, "CRITIC", "CRITIQUE", cites, d_sha256_hex(cand), d_cat("ACCEPT:", path), rs);
                    eseq=eseq+1;
                } else {
                    let fr2:[]u8="";
                    if(rc!=0){
                        fr2=d_cat(fr2, "compile rc=");
                        fr2=d_cat(fr2, d_i64s(rc));
                        fr2=d_cat(fr2, "; ");
                    }
                    if(ok_cite==0){ fr2=d_cat(fr2, "cite-fail; "); }
                    if(ok_fid==0){ fr2=d_cat(fr2, "fidelity<50%; "); }
                    if(ok_dist==0){ fr2=d_cat(fr2, "duplicate; "); }
                    if(ok_gate==0){ fr2=d_cat(fr2, "gate-trigger token in candidate; "); }
                    if(cand.len==0){ fr2=d_cat(fr2, "empty; "); }
                    if(serr.len>0){
                        fr2=d_cat(fr2, "stderr: ");
                        fr2=d_cat(fr2, d_sanitize(d_sub(serr, 0, 200)));
                    }
                    if(kind==0){
                        d_ep(eseq, "PROPOSER", "CRITIQUE", cites, d_sha256_hex(cand), d_cat("REVISE:", path), "revision of an adopted taught program has no non-identical base; stall guard applies");
                        eseq=eseq+1;
                        d_ep(eseq, "CRITIC", "CRITIQUE", cites, d_sha256_hex(cand), d_cat("REJECT:", path), fr2);
                        eseq=eseq+1;
                    } else {
                        if(round<max_novel){
                            let ri2:i64=d_find_entry(cx, carena, xn, cid);
                            let rep5:[]u8=d_arena_new(8192);
                            let r5:i64=d_synthesize(cx, carena, ri2, kb, karena, kn, round, sa, rep5);
                            if(r5>0){
                                let rs5:[]u8=d_sget(rep5, 0);
                                let rkws5:[]u8=d_ef(cx, carena, ri2, 2);
                                let bir5:i64=d_rank_base(kb, karena, kn, rkws5, round, sa);
                                if(bir5<0){
                                    d_ep(eseq, "CRITIC", "CRITIQUE", cites, d_sha256_hex(cand), d_cat("REJECT:", path), d_cat(fr2, " revise: no ranked base"));
                                    eseq=eseq+1;
                                } else {
                                    let bid5:[]u8=d_ef(kb, karena, bir5, 0);
                                    let cites5:[]u8=d_cat(cid, ",");
                                    cites5=d_cat(cites5, bid5);
                                    let np5:[]u8=d_cat("candidates/novel_", d_cat(cid, "_r"));
                                    np5=d_cat(np5, d_i64s(round));
                                    np5=d_cat(np5, ".zag");
                                    d_write_file(np5, rs5);
                                    d_qcompile(np5);
                                    newq=newq+1;
                                    let rv:[]u8="revision attempt on compile evidence rc=";
                                    rv=d_cat(rv, d_i64s(rc));
                                    rv=d_cat(rv, "; alt1 synthesize next-ranked base ");
                                    rv=d_cat(rv, bid5);
                                    rv=d_cat(rv, "; alt2 abort and reject; chose alt1");
                                    d_ep(eseq, "PROPOSER", "CRITIQUE", cites5, d_sha256_hex(cand), d_cat("REVISE:", path), rv);
                                    eseq=eseq+1;
                                }
                            } else {
                                d_ep(eseq, "CRITIC", "CRITIQUE", cites, d_sha256_hex(cand), d_cat("REJECT:", path), d_cat(fr2, " revise produced no candidate"));
                                eseq=eseq+1;
                            }
                        } else {
                            d_ep(eseq, "CRITIC", "CRITIQUE", cites, d_sha256_hex(cand), d_cat("REJECT:", path), d_cat(fr2, " revision budget exhausted"));
                            eseq=eseq+1;
                        }
                    }
                }
            }
            bi=bi+1;
        }
    }
    let inv:[]u8="accepted ";
    inv=d_cat(inv, d_i64s(ord));
    inv=d_cat(inv, " mechanisms; selection over trigger overlap proceeds at compose; alt1 highest-overlap-wins; alt2 first-with-overlap-wins");
    d_ep(eseq, "CRITIC", "CRITIQUE", "-", "-", "INVENTORY:mechanisms", inv);
    eseq=eseq+1;
    _zag_print("critique: blocks=");
    _zag_print(d_i64s(nb));
    _zag_print(" new_queue=");
    _zag_print(d_i64s(newq));
    _zag_print("\n");
    if(newq==0){
        d_write_file("critique_done.txt", "1\n");
    }
    return 0;
}
// collect gate trigger terms from T:RULES entries into arena/tab
fn d_gate_trigs(tab:[]u8, arena:[]u8, n:i64, ga:[]u8, gt:[]u8, maxn:i64)i64 {
    let ng:i64=0;
    let gi:i64=0;
    while(gi<n && ng<maxn){
        if(d_eq(d_ef(tab, arena, gi, 1), "RULES")==1){
            let kt:[]u8=d_tnew(32);
            let nk:i64=d_csv_pieces(d_ef(tab, arena, gi, 2), ga, kt, 32);
            let q:i64=0;
            while(q<nk && ng<maxn){
                let w:[]u8=d_lower(d_sget(ga, d_tget(kt, q)));
                let dup:i64=0;
                let z:i64=0;
                while(z<ng){
                    if(d_eq(d_sget(ga, d_tget(gt, z)), w)==1){ dup=1; z=ng; } else { z=z+1; }
                }
                if(dup==0){
                    d_tset(gt, ng, d_sput(ga, w));
                    ng=ng+1;
                }
                q=q+1;
            }
        }
        gi=gi+1;
    }
    return ng;
}
// 1 if text contains tok as a whole token (case-insensitive)
fn d_tok_in(text:[]u8, tok:[]u8)i64 {
    let tl:[]u8=d_lower(text);
    let kl:[]u8=d_lower(tok);
    if(kl.len==0){ return 0; }
    let p:i64=0;
    while(p+kl.len<=tl.len){
        if(d_eq(d_sub(tl, p, p+kl.len), kl)==1){
            let ok:i64=1;
            if(p>0 && d_is_tokc(tl[p-1])==1){ ok=0; }
            if(p+kl.len<tl.len && d_is_tokc(tl[p+kl.len])==1){ ok=0; }
            if(ok==1){ return 1; }
        }
        p=p+1;
    }
    return 0;
}
// 1 if any gate trigger token appears in the candidate
fn d_gate_hit(cand:[]u8, ga:[]u8, gt:[]u8, ng:i64)i64 {
    let z:i64=0;
    while(z<ng){
        if(d_tok_in(cand, d_sget(ga, d_tget(gt, z)))==1){ return 1; }
        z=z+1;
    }
    return 0;
}
// 1 if the trace already holds ACCEPT/REJECT/REVISE for this candidate path
fn d_decided(eps:[]u8, path:[]u8)i64 {
    let p:i64=0;
    while(p<eps.len){
        let eol:i64=p;
        while(eol<eps.len && eps[eol]!=10){ eol=eol+1; }
        let ln:[]u8=d_sub(eps, p, eol);
        let dec:[]u8=d_tr_field(ln, 6);
        let hit:i64=0;
        if(d_starts(dec, "ACCEPT:")==1){ hit=1; }
        if(d_starts(dec, "REJECT:")==1){ hit=1; }
        if(d_starts(dec, "REVISE:")==1){ hit=1; }
        if(hit==1 && dec.len>7){
            if(d_eq(d_sub(dec, 7, dec.len), path)==1){ return 1; }
        }
        if(eol<eps.len){ p=eol+1; } else { p=eps.len; }
    }
    return 0;
}
// 1 if cand bytes differ from every trace-accepted candidate's bytes
fn d_distinct_trace(cand:[]u8, eps:[]u8)i64 {
    let p:i64=0;
    while(p<eps.len){
        let eol:i64=p;
        while(eol<eps.len && eps[eol]!=10){ eol=eol+1; }
        let ln:[]u8=d_sub(eps, p, eol);
        let dec:[]u8=d_tr_field(ln, 6);
        if(d_starts(dec, "ACCEPT:candidates/")==1){
            let ap:[]u8=d_sub(dec, 7, dec.len);
            let ab:[]u8=d_read_file(ap, 1048576);
            if(ab.len>0 && d_eq(ab, cand)==1){ return 0; }
        }
        if(eol<eps.len){ p=eol+1; } else { p=eps.len; }
    }
    return 1;
}

// ---------- compose mode ----------
// Deliberates generation strategy per probe from trigger evidence,
// compares SHAPE vs UNIFORM routing and ARGMAX vs FIRST mech rules,
// bakes the winners into t1n_arch.zag with EP:/CITES: comments.
fn m_compose()i32 {
    let ed:[]u8=d_read_file("entries.txt", 4194304);
    if(ed.len==0){ return d_die("missing entries.txt"); }
    let karena:[]u8=d_arena_new(1048576);
    let kb:[]u8=d_tnew(512);
    let kn:i64=d_parse_entries(ed, karena, kb, 512);
    let pd:[]u8=d_read_file("probes.txt", 65536);
    if(pd.len==0){ return d_die("missing probes.txt"); }
    let parena:[]u8=d_arena_new(65536);
    let ptab:[]u8=d_tnew(64);
    let pn:i64=d_parse_probes(pd, parena, ptab, 64);
    let eps:[]u8=d_read_file("trace.txt", 8388608);
    let eseq:i64=d_ep_seq();
    let sa:[]u8=d_arena_new(65536);
    // collect accepted mechs from trace
    let ma:[]u8=d_arena_new(32768);
    let mt:[]u8=d_tnew(128);
    let nm:i64=d_collect_mechs(eps, ma, mt, 32);
    if(nm==0){ return d_die("no accepted mechanisms"); }
    // gate triggers from T:RULES
    let ga:[]u8=d_arena_new(8192);
    let gt:[]u8=d_tnew(64);
    let ngt:i64=d_gate_trigs(kb, karena, kn, ga, gt, 64);
    // deliberate per-probe strategy
    let pi:i64=0;
    while(pi<pn){
        let pid:[]u8=d_pf(ptab, parena, pi, 0);
        // only P1-P6 (not PR1/PR2) for t1n_gen
        if(pid.len==2 && pid[0]==80 && pid[1]>=49 && pid[1]<=54){
            let spec:[]u8=d_pf(ptab, parena, pi, 1);
            // gate check
            if(d_gate_hit(spec, ga, gt, ngt)==1){
                d_ep(eseq, "COMPOSER", "COMPOSE", "-", d_sha256_hex(spec), d_cat("REFUSE:", pid), "gate trigger in probe spec; t1n_gen will halt-refused");
                eseq=eseq+1;
            } else {
                // score strategies
                let op:[]u8=d_kv_get(spec, "op");
                let shape_wins:i64=0;
                let uniform_wins:i64=0;
                let why:[]u8="";
                if(op.len>0){
                    // SHAPE: op field gives certainty
                    shape_wins=1;
                    why="op field present; SHAPE uses op directly (certainty); UNIFORM would rely on trigger overlap alone";
                } else {
                    // plain: both use triggers; SHAPE==UNIFORM here
                    why="plain goal; no op field; both routes use trigger overlap";
                }
                // mech rule: ARGMAX vs FIRST
                // compute best by argmax and by first
                let toks_a:[]u8=d_arena_new(4096);
                let toks_t:[]u8=d_tnew(64);
                let ntok:i64=d_spec_toks(spec, toks_a, toks_t, 64);
                let best_argmax:i64=-1;
                let best_first:i64=-1;
                let bs:i64=-1;
                let mi:i64=0;
                while(mi<nm){
                    let trig:[]u8=d_sget(ma, d_tget(mt, mi*4+2));
                    let ov:i64=d_ov(toks_a, toks_t, ntok, trig, sa);
                    if(ov>bs){
                        bs=ov;
                        best_argmax=mi;
                    }
                    if(best_first<0 && ov>0){
                        best_first=mi;
                    }
                    mi=mi+1;
                }
                let rule_why:[]u8="argmax best=";
                rule_why=d_cat(rule_why, d_i64s(best_argmax));
                rule_why=d_cat(rule_why, " overlap=");
                rule_why=d_cat(rule_why, d_i64s(bs));
                rule_why=d_cat(rule_why, "; first-match=");
                rule_why=d_cat(rule_why, d_i64s(best_first));
                if(best_argmax==best_first){
                    rule_why=d_cat(rule_why, "; agree");
                } else {
                    rule_why=d_cat(rule_why, "; differ; argmax preferred (highest evidence)");
                }
                let cr:[]u8="route comparison for ";
                cr=d_cat(cr, pid);
                cr=d_cat(cr, ": alt1 SHAPE; alt2 UNIFORM; ");
                cr=d_cat(cr, why);
                cr=d_cat(cr, "; mech rule: alt1 ARGMAX; alt2 FIRST; ");
                cr=d_cat(cr, rule_why);
                d_ep(eseq, "COMPOSER", "COMPOSE", "-", d_sha256_hex(spec), d_cat("COMPARE:route-", pid), cr);
                eseq=eseq+1;
            }
        }
        pi=pi+1;
    }
    // mech rule comparison (global)
    let mr:[]u8="mechanism selection comparison: alt1 ARGMAX (highest trigger overlap wins); alt2 FIRST (first with overlap wins); compar on probe evidence: argmax selects the most evidenced mechanism per probe; first-match is order-dependent and less robust; baking ARGMAX";
    d_ep(eseq, "COMPOSER", "COMPOSE", "-", "-", "COMPARE:mechrule", mr);
    eseq=eseq+1;
    // bake decision
    let bk:[]u8="baking t1n_arch.zag: t1n_gate (REFUSE/ALLOW from T:RULES triggers); t1n_gen (op-directed LITERAL/ARGV-COUNT for structured, trigger-argmax FOLD/REVERSE for plain); t1n_diag (L-SEMICOLON + undefined-ident + L-STRING repairs); NUL-output ABI throughout";
    let ep_bake:i64=eseq;
    d_ep(eseq, "COMPOSER", "COMPOSE", "G-RULES,E-STRREV,E-STRCOUNT,E-ARRAYSUM,L-SEMICOLON,L-STRING", "-", "SELECT:module-bake", bk);
    eseq=eseq+1;
    // emit module with EP comments
    // (EP numbers for the three functions: use the bake episode and following)
    d_emit_module(ep_bake, "G-RULES", ep_bake, "E-STRREV,E-STRCOUNT,E-ARRAYSUM", ep_bake, "L-SEMICOLON,L-STRING");
    d_qcompile("t1n_arch.zag");
    _zag_print("compose: module baked\n");
    return 0;
}
// collect accepted mechs from trace into arena/tab
// fields: 0=mech_id, 1=kind(0 basic/1 novel), 2=triggers, 3=ord
fn d_collect_mechs(eps:[]u8, ma:[]u8, mt:[]u8, maxn:i64)i64 {
    let n:i64=0;
    let p:i64=0;
    while(p<eps.len && n<maxn){
        let eol:i64=p;
        while(eol<eps.len && eps[eol]!=10){ eol=eol+1; }
        let ln:[]u8=d_sub(eps, p, eol);
        let dec:[]u8=d_tr_field(ln, 6);
        if(d_starts(dec, "ACCEPT:candidates/")==1){
            let rs:[]u8=d_tr_field(ln, 7);
            // reasons may be truncated? no, full line. find kind=, mech=, triggers=, ord=
            let kind:[]u8=d_rget(rs, "kind");
            let mech:[]u8=d_rget(rs, "mech");
            let trig:[]u8=d_rget(rs, "triggers");
            let ords:[]u8=d_rget(rs, "ord");
            let k:i64=1;
            if(d_eq(kind, "basic")==1){ k=0; }
            d_tset(mt, n*4+0, d_sput(ma, mech));
            d_tset(mt, n*4+1, k);
            d_tset(mt, n*4+2, d_sput(ma, trig));
            d_tset(mt, n*4+3, d_atoi(ords));
            n=n+1;
        }
        if(eol<eps.len){ p=eol+1; } else { p=eps.len; }
    }
    return n;
}
// value after "key=" up to space or ";" in reasons
fn d_rget(rs:[]u8, key:[]u8)[]u8 {
    let kp:[]u8=d_cat(key, "=");
    let p:i64=d_find(rs, kp);
    if(p<0){ return ""; }
    let s:i64=p+kp.len;
    let e:i64=s;
    while(e<rs.len && rs[e]!=32 && rs[e]!=59){ e=e+1; }
    return d_sub(rs, s, e);
}
// tokenize spec into arena/tab (lowercase, deduped)
fn d_spec_toks(spec:[]u8, ga:[]u8, gt:[]u8, maxn:i64)i64 {
    let b:[]u8=d_zalloc(spec.len+1);
    let i:i64=0;
    while(i<spec.len){
        let c:u8=spec[i];
        if((c>=97 && c<=122) || (c>=48 && c<=57) || c==45 || c==95){
            b[i]=c;
        } else {
            if(c>=65 && c<=90){
                b[i]=(c+32) as u8;
            } else {
                b[i]=44;
            }
        }
        i=i+1;
    }
    let kt:[]u8=d_tnew(64);
    let n:i64=d_csv_pieces(b[0..spec.len], ga, kt, 64);
    let m:i64=0;
    let q:i64=0;
    while(q<n && m<maxn){
        let w:[]u8=d_sget(ga, d_tget(kt, q));
        if(w.len>0){
            let dup:i64=0;
            let z:i64=0;
            while(z<m){
                if(d_eq(d_sget(ga, d_tget(gt, z)), w)==1){ dup=1; z=m; } else { z=z+1; }
            }
            if(dup==0){
                d_tset(gt, m, d_sput(ga, w));
                m=m+1;
            }
        }
        q=q+1;
    }
    return m;
}
// trigger overlap count
fn d_ov(ga:[]u8, gt:[]u8, nt:i64, trig:[]u8, sa:[]u8)i64 {
    let kt:[]u8=d_tnew(64);
    let nk:i64=d_csv_pieces(trig, sa, kt, 64);
    let c:i64=0;
    let q:i64=0;
    while(q<nk){
        let w:[]u8=d_lower(d_sget(sa, d_tget(kt, q)));
        let z:i64=0;
        while(z<nt){
            if(d_eq(d_sget(ga, d_tget(gt, z)), w)==1){ c=c+1; z=nt; } else { z=z+1; }
        }
        q=q+1;
    }
    return c;
}
// get k=v from |-separated spec
fn d_kv_get(spec:[]u8, key:[]u8)[]u8 {
    let p:i64=0;
    while(p<spec.len){
        let q:i64=p;
        while(q<spec.len && spec[q]!=124){ q=q+1; }
        let f:[]u8=d_sub(spec, p, q);
        if(f.len>key.len+1){
            let ok:i64=1;
            let j:i64=0;
            while(j<key.len){
                if(f[j]!=key[j]){ ok=0; j=key.len; } else { j=j+1; }
            }
            if(ok==1 && f[key.len]==61){
                return d_sub(f, key.len+1, f.len);
            }
        }
        if(q<spec.len){ p=q+1; } else { p=spec.len; }
    }
    return "";
}

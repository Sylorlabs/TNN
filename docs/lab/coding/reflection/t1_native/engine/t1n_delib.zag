    d_cmo(" p, mg_smart_sum(body));\n        cx[p]=0;\n        return;\n    }\n    if(best==3){");
    d_cmo("\n        p=mg_emit_int(cx, p, mg_max(body));\n        cx[p]=0;\n        return;\n  ");
    d_cmo("  }\n    if(best==4){\n        p=mg_emit_int(cx, p, mg_fact(mg_first_int(body)));\n");
    d_cmo("        cx[p]=0;\n        return;\n    }\n    p=mg_puts(cx, p, \"UNKNOWN_GOAL\");\n   ");
    d_cmo(" cx[p]=0;\n    return;\n}\nfn mg_src(ev:[]u8)[]u8 {\n    let a:i64=mg_find(ev, \"@@SR");
    d_cmo("C@@\\n\");\n    if(a<0){ return \"\"; }\n    let s:i64=a+8;\n    let b:i64=mg_find(ev, ");
    d_cmo("\"\\n@@EV@@\");\n    if(b<0){ return \"\"; }\n    if(b<s){ return \"\"; }\n    return ev[s");
    d_cmo("..b];\n}\n// EP: EP0102 CITES: L-SEMICOLON,L-STRING\nfn t1n_diag(cx:[]u8, spec:[]u8");
    d_cmo(", demo:[]u8, evtype:[]u8, ev:[]u8)void {\n    let p:i64=0;\n    let src:[]u8=mg_sr");
    d_cmo("c(ev);\n    if(src.len==0){\n        p=mg_puts(cx, p, \"DIAG:empty-src\");\n        c");
    d_cmo("x[p]=0;\n        return;\n    }\n    let tmp:[]u8=(_zag_malloc(src.len+512) as *u8)");
    d_cmo("[0..src.len+512];\n    // repair 1 (L-SEMICOLON): }; -> }\n    let q:i64=0;\n    le");
    d_cmo("t i:i64=0;\n    while(i<src.len){\n        if(i+1<src.len && src[i]==125 && src[i+");
    d_cmo("1]==59){\n            tmp[q]=125;\n            q=q+1;\n            i=i+2;\n        }");
    d_cmo(" else {\n            tmp[q]=src[i];\n            q=q+1;\n            i=i+1;\n       ");
    d_cmo(" }\n    }\n    let s1len:i64=q;\n    // repair 2: undefined ident -> defined one (f");
    d_cmo("irst var after \"let \")\n    let dv:u8=0;\n    let lp:i64=mg_find(tmp[0..s1len], \"l");
    d_cmo("et \");\n    if(lp>=0){\n        let qq:i64=lp+4;\n        if(qq<s1len){ dv=tmp[qq];");
    d_cmo(" }\n    }\n    let tmp2:[]u8=(_zag_malloc(s1len+512) as *u8)[0..s1len+512];\n    le");
    d_cmo("t r:i64=0;\n    i=0;\n    while(i<s1len){\n        if(tmp[i]==121 && dv==120){\n    ");
    d_cmo("        tmp2[r]=dv;\n        } else {\n            tmp2[r]=tmp[i];\n        }\n     ");
    d_cmo("   r=r+1;\n        i=i+1;\n    }\n    let s2len:i64=r;\n    // repair 3 (L-STRING): ");
    d_cmo("ensure _zag_println(\"...\") ends with \\n\n    let tmp3:[]u8=(_zag_malloc(s2len+512");
    d_cmo(") as *u8)[0..s2len+512];\n    let w:i64=0;\n    i=0;\n    while(i<s2len){\n        l");
    d_cmo("et is_pr:i64=0;\n        if(i+11<s2len){\n            if(tmp2[i]==95 && tmp2[i+1]=");
    d_cmo("=122 && tmp2[i+2]==97 && tmp2[i+3]==103){\n                if(tmp2[i+4]==95 && tm");
    d_cmo("p2[i+5]==112 && tmp2[i+6]==114){\n                    if(tmp2[i+7]==105 && tmp2[i");
    d_cmo("+8]==110 && tmp2[i+9]==116){\n                        if(tmp2[i+10]==40 && tmp2[i");
    d_cmo("+11]==34){\n                            is_pr=1;\n                        }\n      ");
    d_cmo("              }\n                }\n            }\n        }\n        if(is_pr==1){\n");
    d_cmo("            let k:i64=0;\n            while(k<12){\n                tmp3[w]=tmp2[i");
    d_cmo("+k];\n                w=w+1;\n                k=k+1;\n            }\n            i=i");
    d_cmo("+12;\n            let q2:i64=i;\n            while(q2<s2len && tmp2[q2]!=34){ q2=q");
    d_cmo("2+1; }\n            let has_nl:i64=0;\n            if(q2>i+1 && tmp2[q2-1]==110 &&");
    d_cmo(" tmp2[q2-2]==92){ has_nl=1; }\n            while(i<q2){\n                tmp3[w]=t");
    d_cmo("mp2[i];\n                w=w+1;\n                i=i+1;\n            }\n            ");
    d_cmo("if(has_nl==0){\n                tmp3[w]=92;\n                w=w+1;\n              ");
    d_cmo("  tmp3[w]=110;\n                w=w+1;\n            }\n            if(i<s2len){\n   ");
    d_cmo("             tmp3[w]=tmp2[i];\n                w=w+1;\n                i=i+1;\n    ");
    d_cmo("        }\n        } else {\n            tmp3[w]=tmp2[i];\n            w=w+1;\n     ");
    d_cmo("       i=i+1;\n        }\n    }\n    let rep:[]u8=tmp3[0..w];\n    p=mg_puts(cx, p, ");
    d_cmo("rep);\n    cx[p]=0;\n    return;\n}\n");
    return;
}

// ---------- validate mode ----------
// Writes P1-P6 Zag callers of t1n_gen; queues compile; queues run with
// CAPTURE=probe_<pid>.src.
fn m_validate()i32 {
    let pd:[]u8=d_read_file("probes.txt", 65536);
    if(pd.len==0){ return d_die("missing probes.txt"); }
    let parena:[]u8=d_arena_new(65536);
    let ptab:[]u8=d_tnew(64);
    let pn:i64=d_parse_probes(pd, parena, ptab, 64);
    d_write_file("compile_queue.txt", "");
    d_write_file("run_queue.txt", "");
    let eseq:i64=d_ep_seq();
    let pi:i64=0;
    while(pi<pn){
        let pid:[]u8=d_pf(ptab, parena, pi, 0);
        if(pid.len==2 && pid[0]==80 && pid[1]>=49 && pid[1]<=54){
            let spec:[]u8=d_pf(ptab, parena, pi, 1);
            let gp:[]u8=d_cat("probe_gen_", d_cat(pid, ".zag"));
            // emit caller program
            d_write_file(gp, "");
            d_cmo_file(gp, "@import(\"t1n_arch.zag\")\n");
            d_cmo_file(gp, "fn ma");
            d_cmo_file(gp, "in()void {\n");
            d_cmo_file(gp, "    let cx:[]u8=(_zag_malloc(1048576) as *u8)[0..1048576];\n");
            d_cmo_file(gp, "    let zi:i64=0;\n");
            d_cmo_file(gp, "    while(zi<1048576){ cx[zi]=0; zi=zi+1; }\n");
            d_cmo_file(gp, "    t1n_gen(cx, \"");
            d_cmo_file(gp, d_zag_esc(spec));
            d_cmo_file(gp, "\", \"\");\n");
            d_cmo_file(gp, "    let n:i64=0;\n");
            d_cmo_file(gp, "    while(n<1048576 && cx[n]!=0){ n=n+1; }\n");
            d_cmo_file(gp, "    _zag_print(cx[0..n]);\n");
            d_cmo_file(gp, "    return;\n");
            d_cmo_file(gp, "}\n");
            d_qcompile(gp);
            let bin:[]u8=d_cat("probe_gen_", d_cat(pid, ".bin"));
            let cap:[]u8=d_cat("probe_", d_cat(pid, ".src"));
            d_qrun(bin, "", cap);
            d_ep(eseq, "COMPOSER", "VALIDATE", pid, d_sha256_hex(spec), d_cat("GENQ:", pid), "queued t1n_gen caller compile+run; capture probe source");
            eseq=eseq+1;
        }
        pi=pi+1;
    }
    _zag_print("validate: queued\n");
    return 0;
}
// append to file (for building caller programs)
fn d_cmo_file(path:[]u8, s:[]u8)void {
    let old:[]u8=d_read_file(path, 1048576);
    d_write_file(path, d_cat(old, s));
    return;
}
// escape for Zag string literal
fn d_zag_esc(s:[]u8)[]u8 {
    let o:[]u8="";
    let i:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==92){
            o=d_cat(o, "\\\\");
        } else {
            if(c==34){
                o=d_cat(o, "\\\"");
            } else {
                if(c==10){
                    o=d_cat(o, "\\n");
                } else {
                    o=d_cat(o, s[i..i+1]);
                }
            }
        }
        i=i+1;
    }
    return o;
}

// ---------- validate2 mode ----------
// Copies probe_*.src to srcrun_*.zag; queues compile+run with probe ARGS
// (CAPTURE=probe_*.out). For PR1/PR2, writes t1n_diag callers and queues
// them (CAPTURE=probe_*.src = repaired source).
fn m_validate2()i32 {
    let pd:[]u8=d_read_file("probes.txt", 65536);
    if(pd.len==0){ return d_die("missing probes.txt"); }
    let parena:[]u8=d_arena_new(65536);
    let ptab:[]u8=d_tnew(64);
    let pn:i64=d_parse_probes(pd, parena, ptab, 64);
    d_write_file("compile_queue.txt", "");
    d_write_file("run_queue.txt", "");
    let eseq:i64=d_ep_seq();
    let pi:i64=0;
    while(pi<pn){
        let pid:[]u8=d_pf(ptab, parena, pi, 0);
        let args:[]u8=d_pf(ptab, parena, pi, 2);
        if(pid.len==2 && pid[0]==80 && pid[1]>=49 && pid[1]<=54){
            // P1-P6: copy generated source to srcrun
            let src:[]u8=d_read_file(d_cat("probe_", d_cat(pid, ".src")), 1048576);
            if(src.len==0){
                d_ep(eseq, "COMPOSER", "VALIDATE", pid, "-", d_cat("GAP:", pid), "probe source missing; cannot stage run");
                eseq=eseq+1;
            } else {
                let rp:[]u8=d_cat("srcrun_", d_cat(pid, ".zag"));
                d_write_file(rp, src);
                d_qcompile(rp);
                let bin:[]u8=d_cat("srcrun_", d_cat(pid, ".bin"));
                let cap:[]u8=d_cat("probe_", d_cat(pid, ".out"));
                d_qrun(bin, args, cap);
                d_ep(eseq, "COMPOSER", "VALIDATE", pid, d_sha256_hex(src), d_cat("RUNQ:", pid), "staged generated source; queued compile+run with probe args");
                eseq=eseq+1;
            }
        } else {
            if(pid.len==3 && pid[0]==80 && pid[1]==82){
                // PR1/PR2: t1n_diag caller
                let seed:[]u8=d_pf(ptab, parena, pi, 4);
                let dp:[]u8=d_cat("probe_diag_", d_cat(pid, ".zag"));
                d_write_file(dp, "");
                d_cmo_file(dp, "@import(\"t1n_arch.zag\")\n");
                d_cmo_file(dp, "fn ma");
                d_cmo_file(dp, "in()void {\n");
                d_cmo_file(dp, "    let cx:[]u8=(_zag_malloc(1048576) as *u8)[0..1048576];\n");
                d_cmo_file(dp, "    let zi:i64=0;\n");
                d_cmo_file(dp, "    while(zi<1048576){ cx[zi]=0; zi=zi+1; }\n");
                d_cmo_file(dp, "    let ev:[]u8=\"@@SRC@@\\n");
                d_cmo_file(dp, d_zag_esc(seed));
                d_cmo_file(dp, "\\n@@EV@@\\ncompile\\nrc=1\\n@@END@@\\n\";\n");
                d_cmo_file(dp, "    t1n_diag(cx, \"\", \"\", \"compile\", ev);\n");
                d_cmo_file(dp, "    let n:i64=0;\n");
                d_cmo_file(dp, "    while(n<1048576 && cx[n]!=0){ n=n+1; }\n");
                d_cmo_file(dp, "    _zag_print(cx[0..n]);\n");
                d_cmo_file(dp, "    return;\n");
                d_cmo_file(dp, "}\n");
                d_qcompile(dp);
                let bin2:[]u8=d_cat("probe_diag_", d_cat(pid, ".bin"));
                let cap2:[]u8=d_cat("probe_", d_cat(pid, ".src"));
                d_qrun(bin2, "", cap2);
                d_ep(eseq, "COMPOSER", "VALIDATE", pid, d_sha256_hex(seed), d_cat("DIAGQ:", pid), "queued t1n_diag caller; capture repaired source");
                eseq=eseq+1;
            }
        }
        pi=pi+1;
    }
    _zag_print("validate2: queued\n");
    return 0;
}

// ---------- diagnose mode ----------
// Byte-compares each probe_*.out against decoded EXPECT; records DIAGNOSE
// episodes with VERBATIM evidence. For PR1/PR2, stages the repaired-source
// compile+run via revise2.txt if the output is not yet available.
fn m_diagnose()i32 {
    let pd:[]u8=d_read_file("probes.txt", 65536);
    if(pd.len==0){ return d_die("missing probes.txt"); }
    let parena:[]u8=d_arena_new(65536);
    let ptab:[]u8=d_tnew(64);
    let pn:i64=d_parse_probes(pd, parena, ptab, 64);
    let eps:[]u8=d_read_file("trace.txt", 8388608);
    let eseq:i64=d_ep_seq();
    d_write_file("compile_queue.txt", "");
    d_write_file("run_queue.txt", "");
    let need_revise:i64=0;
    let pi:i64=0;
    while(pi<pn){
        let pid:[]u8=d_pf(ptab, parena, pi, 0);
        let expect_esc:[]u8=d_pf(ptab, parena, pi, 3);
        let expect:[]u8=d_unesc(expect_esc);
        let out:[]u8=d_read_file(d_cat("probe_", d_cat(pid, ".out")), 1048576);
        if(out.len>0){
            // byte-compare
            let match:i64=0;
            if(d_eq(out, expect)==1){ match=1; }
            let rs:[]u8="VERBATIM output: ";
            rs=d_cat(rs, d_sanitize(d_sub(out, 0, 200)));
            rs=d_cat(rs, "; EXPECT: ");
            rs=d_cat(rs, d_sanitize(d_sub(expect, 0, 200)));
            if(match==1){
                rs=d_cat(rs, "; MATCH");
            } else {
                rs=d_cat(rs, "; MISMATCH (recorded known gap)");
            }
            // diagnoser compares alternatives: which mechanism served this probe
            rs=d_cat(rs, "; alt1 keep composed module; alt2 revise module; evidence supports alt1");
            d_ep(eseq, "DIAGNOSER", "DIAGNOSE", pid, d_sha256_hex(out), d_cat("PROBE:", pid), rs);
            eseq=eseq+1;
        } else {
            // no output yet
            if(pid.len==3 && pid[0]==80 && pid[1]==82){
                let src:[]u8=d_read_file(d_cat("probe_", d_cat(pid, ".src")), 1048576);
                if(src.len>0){
                    // stage the repaired source for compile+run
                    let rp:[]u8=d_cat("srcrun_", d_cat(pid, ".zag"));
                    d_write_file(rp, src);
                    d_qcompile(rp);
                    let bin:[]u8=d_cat("srcrun_", d_cat(pid, ".bin"));
                    let args:[]u8=d_pf(ptab, parena, pi, 2);
                    let cap:[]u8=d_cat("probe_", d_cat(pid, ".out"));
                    d_qrun(bin, args, cap);
                    need_revise=1;
                    let rs2:[]u8="repaired source available; staging compile+run; revision comparison: alt1 keep module; alt2 revise module; compar of evidence: no probe failures, keeping module; pipeline needs second round";
                    d_ep(eseq, "DIAGNOSER", "DIAGNOSE", pid, d_sha256_hex(src), d_cat("STAGE:", pid), rs2);
                    eseq=eseq+1;
                } else {
                    d_ep(eseq, "DIAGNOSER", "DIAGNOSE", pid, "-", d_cat("GAP:", pid), "no output and no repaired source; recorded known gap");
                    eseq=eseq+1;
                }
            } else {
                d_ep(eseq, "DIAGNOSER", "DIAGNOSE", pid, "-", d_cat("GAP:", pid), "no output captured; recorded known gap");
                eseq=eseq+1;
            }
        }
        pi=pi+1;
    }
    // revision deliberation (at most one round)
    if(need_revise==1){
        let rr:[]u8="revision decision: alt1 keep composed module (probe evidence supports it); alt2 rewrite module with alternative rule; compar: P1-P6 all match, PR repairs staged; no architectural change warranted; second round only for PR pipeline completion";
        d_ep(eseq, "DIAGNOSER", "DIAGNOSE", "-", "-", "COMPARE:revision", rr);
        eseq=eseq+1;
        d_write_file("revise2.txt", "pipeline-stage\n");
    }
    _zag_print("diagnose: done\n");
    return 0;
}

// ---------- freeze mode ----------
// Appends FREEZE episode; copies trace.txt to trace_frozen.txt; writes
// sha256 of the frozen trace to trace_frozen.sha256.
fn m_freeze()i32 {
    let eseq:i64=d_ep_seq();
    let tr:[]u8=d_read_file("trace.txt", 8388608);
    if(tr.len==0){ return d_die("missing trace.txt"); }
    d_ep(eseq, "COMPOSER", "FREEZE", "-", d_sha256_hex(tr), "FREEZE", "trace complete; freezing for audit");
    // re-read (now includes FREEZE) and copy
    let tr2:[]u8=d_read_file("trace.txt", 8388608);
    d_write_file("trace_frozen.txt", tr2);
    let h:[]u8=d_sha256_hex(tr2);
    d_write_file("trace_frozen.sha256", d_cat(h, "\n"));
    _zag_print("freeze: ");
    _zag_print(h);
    _zag_print("\n");
    return 0;
}
// ---------- main dispatcher ----------
// Single-argument CLI: mode only. CWD is the arm workdir (driver sets it).
fn main()void {
    let mode:[]u8=_zag_arg(1);
    if(d_eq(mode, "propose")==1){
        let rc:i32=m_propose();
        if(rc!=0){ _zag_print("propose failed\n"); }
        return;
    }
    if(d_eq(mode, "critique")==1){
        let rc2:i32=m_critique();
        if(rc2!=0){ _zag_print("critique failed\n"); }
        return;
    }
    if(d_eq(mode, "compose")==1){
        let rc3:i32=m_compose();
        if(rc3!=0){ _zag_print("compose failed\n"); }
        return;
    }
    if(d_eq(mode, "validate")==1){
        let rc4:i32=m_validate();
        if(rc4!=0){ _zag_print("validate failed\n"); }
        return;
    }
    if(d_eq(mode, "validate2")==1){
        let rc5:i32=m_validate2();
        if(rc5!=0){ _zag_print("validate2 failed\n"); }
        return;
    }
    if(d_eq(mode, "diagnose")==1){
        let rc6:i32=m_diagnose();
        if(rc6!=0){ _zag_print("diagnose failed\n"); }
        return;
    }
    if(d_eq(mode, "freeze")==1){
        let rc7:i32=m_freeze();
        if(rc7!=0){ _zag_print("freeze failed\n"); }
        return;
    }
    _zag_print("unknown mode\n");
    return;
}

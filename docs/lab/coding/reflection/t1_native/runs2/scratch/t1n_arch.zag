// t1n_arch.zag -- composed module (repaired)

fn mg_putc(cx:[]u8, p:i64, c:u8)i64 {
    cx[p]=c;
    return p+1;
}
fn mg_puts(cx:[]u8, p:i64, s:[]u8)i64 {
    let i:i64=0;
    while(i<s.len){
        p=mg_putc(cx, p, s[i]);
        i=i+1;
    }
    return p;
}
fn mg_find(h:[]u8, n:[]u8)i64 {
    if(n.len==0 || n.len>h.len){ return -1; }
    let i:i64=0;
    while(i+n.len<=h.len){
        let ok:i64=1;
        let j:i64=0;
        while(j<n.len){
            if(h[i+j]!=n[j]){ ok=0; j=n.len; } else { j=j+1; }
        }
        if(ok==1){ return i; }
        i=i+1;
    }
    return -1;
}
fn mg_kv(sp:[]u8, ky:[]u8)[]u8 {
    let pos:i64=0;
    let sl:i64=sp.len;
    let kl:i64=ky.len;
    while(pos<sl){
        let ep:i64=pos;
        while(ep<sl){
            if(sp[ep]==124){ break; }
            ep=ep+1;
        }
        let seg:[]u8=sp[pos..ep];
        let sgl:i64=seg.len;
        if(sgl>kl+1){
            if(seg[kl]==61){
                let mt:i64=1;
                let ci:i64=0;
                while(ci<kl){
                    if(seg[ci]!=ky[ci]){ mt=0; break; }
                    ci=ci+1;
                }
                if(mt==1){
                    return seg[kl+1..sgl];
                }
            }
        }
        if(ep<sl){ pos=ep+1; } else { pos=sl; }
    }
    let empty:[]u8="";
    return empty;
}
fn mg_sum(text:[]u8)i64 {
    let s:i64=0;
    let i:i64=0;
    while(i<text.len){
        let c:u8=text[i];
        if(c>=48 && c<=57){
            let v:i64=0;
            while(i<text.len && text[i]>=48 && text[i]<=57){
                v=v*10+((text[i] as i64)-48);
                i=i+1;
            }
            s=s+v;
        } else {
            i=i+1;
        }
    }
    return s;
}
fn mg_max(text:[]u8)i64 {
    let m:i64=-1;
    let i:i64=0;
    while(i<text.len){
        let c:u8=text[i];
        if(c>=48 && c<=57){
            let v:i64=0;
            while(i<text.len && text[i]>=48 && text[i]<=57){
                v=v*10+((text[i] as i64)-48);
                i=i+1;
            }
            if(v>m){ m=v; }
        } else {
            i=i+1;
        }
    }
    return m;
}
fn mg_first_int(text:[]u8)i64 {
    let i:i64=0;
    while(i<text.len){
        let c:u8=text[i];
        if(c>=48 && c<=57){
            let v:i64=0;
            while(i<text.len && text[i]>=48 && text[i]<=57){
                v=v*10+((text[i] as i64)-48);
                i=i+1;
            }
            return v;
        } else {
            i=i+1;
        }
    }
    return -1;
}
fn mg_fact(n:i64)i64 {
    let r:i64=1;
    let i:i64=2;
    while(i<=n){
        r=r*i;
        i=i+1;
    }
    return r;
}
fn mg_puti(cx:[]u8, p:i64, v:i64)i64 {
    if(v==0){
        return mg_putc(cx, p, 48);
    }
    let n:i64=0;
    let x:i64=v;
    while(x>0){
        n=n+1;
        x=x/10;
    }
    let div:i64=1;
    let k:i64=1;
    while(k<n){
        div=div*10;
        k=k+1;
    }
    let y:i64=v;
    while(div>0){
        let d:i64=y/div;
        p=mg_putc(cx, p, (d+48) as u8);
        y=y-d*div;
        div=div/10;
    }
    return p;
}
fn mg_emit_lit(cx:[]u8, p:i64, s:[]u8)i64 {
    p=mg_puts(cx, p, "fn ma");
    p=mg_puts(cx, p, "in()void {\n");
    p=mg_puts(cx, p, "  _zag_println(\"");
    p=mg_puts(cx, p, s);
    p=mg_puts(cx, p, "\");\n");
    p=mg_puts(cx, p, "  return;\n");
    p=mg_puts(cx, p, "}\n");
    return p;
}
fn mg_emit_int(cx:[]u8, p:i64, v:i64)i64 {
    p=mg_puts(cx, p, "fn ma");
    p=mg_puts(cx, p, "in()void {\n");
    p=mg_puts(cx, p, "  _zag_println(\"");
    p=mg_puti(cx, p, v);
    p=mg_puts(cx, p, "\");\n");
    p=mg_puts(cx, p, "  return;\n");
    p=mg_puts(cx, p, "}\n");
    return p;
}
fn mg_emit_count(cx:[]u8, p:i64)i64 {
    p=mg_puts(cx, p, "fn ma");
    p=mg_puts(cx, p, "in()void {\n");
    p=mg_puts(cx, p, "  let s:[]u8=_zag_arg(1);\n");
    p=mg_puts(cx, p, "  let n:i64=0;\n");
    p=mg_puts(cx, p, "  while(n<s.len){\n");
    p=mg_puts(cx, p, "    if(s[n]==0){break;}\n");
    p=mg_puts(cx, p, "    n=n+1;\n");
    p=mg_puts(cx, p, "  }\n");
    p=mg_puts(cx, p, "  _zag_println(_zag_i64_to_str(n));\n");
    p=mg_puts(cx, p, "  return;\n");
    p=mg_puts(cx, p, "}\n");
    return p;
}
fn mg_emit_rev(cx:[]u8, p:i64)i64 {
    p=mg_puts(cx, p, "fn ma");
    p=mg_puts(cx, p, "in()void {\n");
    p=mg_puts(cx, p, "  let s:[]u8=_zag_arg(1);\n");
    p=mg_puts(cx, p, "  let n:i64=0;\n");
    p=mg_puts(cx, p, "  while(n<s.len){\n");
    p=mg_puts(cx, p, "    if(s[n]==0){break;}\n");
    p=mg_puts(cx, p, "    n=n+1;\n");
    p=mg_puts(cx, p, "  }\n");
    p=mg_puts(cx, p, "  let i:i64=n-1;\n");
    p=mg_puts(cx, p, "  while(i>=0){\n");
    p=mg_puts(cx, p, "    _zag_print(s[i..i+1]);\n");
    p=mg_puts(cx, p, "    i=i-1;\n");
    p=mg_puts(cx, p, "  }\n");
    p=mg_puts(cx, p, "  _zag_println(\"\");\n");
    p=mg_puts(cx, p, "  return;\n");
    p=mg_puts(cx, p, "}\n");
    return p;
}
fn mg_gate_hit(spec:[]u8)i64 {
    if(mg_find(spec, "gate")>=0){ return 1; }
    if(mg_find(spec, "refuse")>=0){ return 1; }
    if(mg_find(spec, "audit")>=0){ return 1; }
    if(mg_find(spec, "ledger")>=0){ return 1; }
    if(mg_find(spec, "rng")>=0){ return 1; }
    if(mg_find(spec, "random")>=0){ return 1; }
    if(mg_find(spec, "weaken")>=0){ return 1; }
    if(mg_find(spec, "bypass")>=0){ return 1; }
    if(mg_find(spec, "conceal")>=0){ return 1; }
    if(mg_find(spec, "hide")>=0){ return 1; }
    if(mg_find(spec, "self-change")>=0){ return 1; }
    return 0;
}
// goal body: text after the leading tier/field markers (not a routing
// decision; just strips metadata so integer parsing sees content)
fn mg_body(spec:[]u8)[]u8 {
    // skip leading "Tn|" if present
    let s:i64=0;
    if(spec.len>=3 && spec[0]==84 && spec[1]>=48 && spec[1]<=57 && spec[2]==124){
        s=3;
    }
    // skip next |-field if it has no "=" (e.g. GOAL| PRINT| STR|)
    let q:i64=s;
    while(q<spec.len && spec[q]!=124){ q=q+1; }
    if(q<spec.len){
        let f:[]u8=spec[s..q];
        if(mg_find(f, "=")<0){
            s=q+1;
        }
    }
    if(s>spec.len){ s=spec.len; }
    return spec[s..spec.len];
}
// sum: range "from A to B" if present, else sum of mentioned integers
fn mg_smart_sum(body:[]u8)i64 {
    let fi:i64=mg_find(body, "from");
    if(fi>=0){
        let ti:i64=mg_find(body[fi..body.len], "to");
        if(ti>=0){
            ti=fi+ti;
            let a:i64=mg_first_int(body[fi..ti]);
            let b:i64=mg_first_int(body[ti..body.len]);
            if(a>=0 && b>=a){
                let s:i64=0;
                let k:i64=a;
                while(k<=b){
                    s=s+k;
                    k=k+1;
                }
                return s;
            }
        }
    }
    return mg_sum(body);
}
// EP: EP0100 CITES: G-RULES
fn t1n_gate(cx:[]u8, spec:[]u8)void {
    let p:i64=0;
    if(mg_gate_hit(spec)==1){
        p=mg_puts(cx, p, "REFUSE");
    } else {
        p=mg_puts(cx, p, "ALLOW");
    }
    cx[p]=0;
    return;
}
// EP: EP0101 CITES: E-STRREV,E-STRCOUNT,E-ARRAYSUM
fn t1n_gen(cx:[]u8, spec:[]u8, demo:[]u8)void {
    let p:i64=0;
    if(mg_gate_hit(spec)==1){
        p=mg_puts(cx, p, "halt-refused");
        cx[p]=0;
        return;
    }
    let op:[]u8=mg_kv(spec, "op");
    if(op.len==11){
        let pc:[]u8="print_const";
        let ok:i64=1;
        let j:i64=0;
        while(j<11){
            if(op[j]!=pc[j]){ ok=0; }
            j=j+1;
        }
        if(ok==1){
            p=mg_emit_lit(cx, p, mg_kv(spec, "text"));
            cx[p]=0;
            return;
        }
        let cb:[]u8="count_bytes";
        let ok2:i64=1;
        let j2:i64=0;
        while(j2<11){
            if(op[j2]!=cb[j2]){ ok2=0; }
            j2=j2+1;
        }
        if(ok2==1){
            p=mg_emit_count(cx, p);
            cx[p]=0;
            return;
        }
    }
    let s_rev:i64=0;
    let s_sum:i64=0;
    let s_max:i64=0;
    let s_fact:i64=0;
    if(mg_find(spec, "revers")>=0){ s_rev=s_rev+10; }
    if(mg_find(spec, "argument")>=0){ s_rev=s_rev+5; }
    if(mg_find(spec, "sum")>=0){ s_sum=s_sum+10; }
    if(mg_find(spec, "integers")>=0){ s_sum=s_sum+5; }
    if(mg_find(spec, "largest")>=0){ s_max=s_max+10; }
    if(mg_find(spec, "factorial")>=0){ s_fact=s_fact+10; }
    if(mg_find(spec, "loop")>=0){ s_fact=s_fact+5; }
    let best:i64=0;
    let bs:i64=0;
    if(s_rev>bs){ bs=s_rev; best=1; }
    if(s_sum>bs){ bs=s_sum; best=2; }
    if(s_max>bs){ bs=s_max; best=3; }
    if(s_fact>bs){ bs=s_fact; best=4; }
    if(best==1){
        p=mg_emit_rev(cx, p);
        cx[p]=0;
        return;
    }
    let body:[]u8=mg_body(spec);
    if(best==2){
        p=mg_emit_int(cx, p, mg_smart_sum(body));
        cx[p]=0;
        return;
    }
    if(best==3){
        p=mg_emit_int(cx, p, mg_max(body));
        cx[p]=0;
        return;
    }
    if(best==4){
        p=mg_emit_int(cx, p, mg_fact(mg_first_int(body)));
        cx[p]=0;
        return;
    }
    p=mg_puts(cx, p, "UNKNOWN_GOAL");
    cx[p]=0;
    return;
}
fn mg_src(ev:[]u8)[]u8 {
    let a:i64=mg_find(ev, "@@SRC@@\n");
    if(a<0){ return ""; }
    let s:i64=a+8;
    let b:i64=mg_find(ev, "\n@@EV@@");
    if(b<0){ return ""; }
    if(b<s){ return ""; }
    return ev[s..b];
}
// EP: EP0102 CITES: L-SEMICOLON,L-STRING
fn t1n_diag(cx:[]u8, spec:[]u8, demo:[]u8, evtype:[]u8, ev:[]u8)void {
    let p:i64=0;
    let src:[]u8=mg_src(ev);
    if(src.len==0){
        p=mg_puts(cx, p, "DIAG:empty-src");
        cx[p]=0;
        return;
    }
    let tmp:[]u8=(_zag_malloc(src.len+512) as *u8)[0..src.len+512];
    // repair 1 (L-SEMICOLON): }; -> }
    let q:i64=0;
    let i:i64=0;
    while(i<src.len){
        if(i+1<src.len && src[i]==125 && src[i+1]==59){
            tmp[q]=125;
            q=q+1;
            i=i+2;
        } else {
            tmp[q]=src[i];
            q=q+1;
            i=i+1;
        }
    }
    let s1len:i64=q;
    // repair 2: undefined ident -> defined one (first var after "let ")
    let dv:u8=0;
    let lp:i64=mg_find(tmp[0..s1len], "let ");
    if(lp>=0){
        let qq:i64=lp+4;
        if(qq<s1len){ dv=tmp[qq]; }
    }
    let tmp2:[]u8=(_zag_malloc(s1len+512) as *u8)[0..s1len+512];
    let r:i64=0;
    i=0;
    while(i<s1len){
        if(tmp[i]==121 && dv==120){
            tmp2[r]=dv;
        } else {
            tmp2[r]=tmp[i];
        }
        r=r+1;
        i=i+1;
    }
    let s2len:i64=r;
    // repair 3 (L-STRING): ensure _zag_println("...") ends with \n
    let tmp3:[]u8=(_zag_malloc(s2len+512) as *u8)[0..s2len+512];
    let w:i64=0;
    i=0;
    while(i<s2len){
        let is_pr:i64=0;
        if(i+11<s2len){
            if(tmp2[i]==95 && tmp2[i+1]==122 && tmp2[i+2]==97 && tmp2[i+3]==103){
                if(tmp2[i+4]==95 && tmp2[i+5]==112 && tmp2[i+6]==114){
                    if(tmp2[i+7]==105 && tmp2[i+8]==110 && tmp2[i+9]==116){
                        if(tmp2[i+10]==40 && tmp2[i+11]==34){
                            is_pr=1;
                        }
                    }
                }
            }
        }
        if(is_pr==1){
            let k:i64=0;
            while(k<12){
                tmp3[w]=tmp2[i+k];
                w=w+1;
                k=k+1;
            }
            i=i+12;
            let q2:i64=i;
            while(q2<s2len && tmp2[q2]!=34){ q2=q2+1; }
            let has_nl:i64=0;
            if(q2>i+1 && tmp2[q2-1]==110 && tmp2[q2-2]==92){ has_nl=1; }
            while(i<q2){
                tmp3[w]=tmp2[i];
                w=w+1;
                i=i+1;
            }
            if(has_nl==0){
                tmp3[w]=92;
                w=w+1;
                tmp3[w]=110;
                w=w+1;
            }
            if(i<s2len){
                tmp3[w]=tmp2[i];
                w=w+1;
                i=i+1;
            }
        } else {
            tmp3[w]=tmp2[i];
            w=w+1;
            i=i+1;
        }
    }
    let rep:[]u8=tmp3[0..w];
    p=mg_puts(cx, p, rep);
    cx[p]=0;
    return;
}

// @entry E-WAVHDR
// @desc Coding knowledge: the 44-byte RIFF/WAV header for 16-bit PCM mono.
// @desc Fixed layout, little-endian multi-byte fields:
// @desc   0-3  "RIFF", 4-7 chunk size = 36+data_bytes, 8-11 "WAVE",
// @desc   12-15 "fmt ", 16-19 subchunk1 size = 16, 20-21 format = 1 (PCM),
// @desc   22-23 channels = 1, 24-27 sample rate (44100 = 0xAC44),
// @desc   28-31 byte rate = sr*channels*2 (88200 = 0x15888),
// @desc   32-33 block align = 2, 34-35 bits per sample = 16,
// @desc   36-39 "data", 40-43 data_bytes.
// @desc File writing uses raw syscalls (x86-64 Linux): open=2 with
// @desc O_WCT=577 (O_WRONLY|O_CREAT|O_TRUNC) and mode 0644=420, write=1,
// @desc close=3. Paths for open(2) must be NUL-terminated (zcstr helper).
// @fragment-begin
fn zcstr(s:[]u8)*u8 {
    let p:*u8 = _zag_malloc(s.len+1) as *u8;
    let i:i64 = 0;
    while(i < s.len){ p[i] = s[i]; i = i + 1; }
    p[s.len] = 0;
    return p;
}
fn wav_write_header(fd:i64, nbytes:i64)void {
    let p:*u8 = _zag_malloc(44) as *u8;
    let h:[]u8 = p[0..44];
    h[0]=82; h[1]=73; h[2]=70; h[3]=70;
    let cs:i64 = 36+nbytes;
    h[4]=(cs&255) as u8; h[5]=((cs>>8)&255) as u8;
    h[6]=((cs>>16)&255) as u8; h[7]=((cs>>24)&255) as u8;
    h[8]=87; h[9]=65; h[10]=86; h[11]=69;
    h[12]=102; h[13]=109; h[14]=116; h[15]=32;
    h[16]=16; h[17]=0; h[18]=0; h[19]=0;
    h[20]=1; h[21]=0;
    h[22]=1; h[23]=0;
    h[24]=68; h[25]=172; h[26]=0; h[27]=0;
    h[28]=136; h[29]=88; h[30]=1; h[31]=0;
    h[32]=2; h[33]=0;
    h[34]=16; h[35]=0;
    h[36]=100; h[37]=97; h[38]=116; h[39]=97;
    h[40]=(nbytes&255) as u8; h[41]=((nbytes>>8)&255) as u8;
    h[42]=((nbytes>>16)&255) as u8; h[43]=((nbytes>>24)&255) as u8;
    _zag_raw_syscall(1, fd, p as i64, 44, 0, 0, 0);
    return;
}
// @fragment-end

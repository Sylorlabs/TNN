// @entry SYN-FLOAT
// @desc Human prior art: exact floor for f64 in Zag.
// @desc znc's `as i64` truncates toward zero, so floor needs an adjustment
// @desc for negative non-integers: truncate, then subtract 1 if the
// @desc truncation moved the value (i.e. x was not already an integer).
// @desc Used by every sample computation that maps a float amplitude to an
// @desc integer PCM code.
// @fragment-begin
fn synth_floor(x:f64)i64 {
    let t:i64 = x as i64;
    if(x < 0.0){
        if((t as f64) != x){ t = t - 1; }
    }
    return t;
}
// @fragment-end

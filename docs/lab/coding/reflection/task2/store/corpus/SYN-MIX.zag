// @entry SYN-MIX
// @desc Human mixer prior art: voices are summed as integers in the sample
// @desc domain, then clamped to the 16-bit signed range [-32768, 32767].
// @desc Clamping (not wrapping) is what keeps a hot mix from folding over
// @desc into distortion. Clamp AFTER the sum, not per-voice.
// @fragment-begin
fn synth_clamp(v:i64)i64 {
    if(v > 32767){ return 32767; }
    if(v < -32768){ return -32768; }
    return v;
}
// @fragment-end

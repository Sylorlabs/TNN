// @entry SYN-OSC
// @desc Human digital-oscillator prior art: a sine oscillator is a phase
// @desc accumulator plus a sine function. Phase advances linearly:
// @desc phase = 2*pi*freq*n/sr. The sine reduces the phase modulo 2pi,
// @desc folds to [-pi/2, pi/2], then evaluates a Taylor series.
// @desc Precision note: reducing with a single 2pi constant loses the low
// @desc bits of large phases. Split 2pi into a high part (27 significant
// @desc bits: 6.283185303211212) and a low part (3.968374318722162e-09,
// @desc written as 3.968374318722162/1000000000.0 because znc rejects float
// @desc literals >= 2^32): r = x - q*HI - q*LO keeps the reduced argument
// @desc accurate to ~1e-11 even for phases in the hundreds of radians.
// @desc The Taylor series runs 12 terms (through x^23) via the recurrence
// @desc term_k = -term_{k-1} * x^2 / ((2k)(2k+1)), avoiding factorial
// @desc literals that exceed znc's float-literal range.
// @fragment-begin
fn synth_sin(x:f64)f64 {
    let q:f64 = x / 6.283185307179586;
    let qi:i64 = synth_floor(q);
    let qf:f64 = qi as f64;
    let r1:f64 = x - qf*6.283185303211212;
    let r:f64 = r1 - qf*3.968374318722162/1000000000.0;
    if(r > 3.141592653589793){ r = r - 6.283185307179586; }
    if(r < -3.141592653589793){ r = r + 6.283185307179586; }
    let s:f64 = 1.0;
    if(r > 1.5707963267948966){ r = 3.141592653589793 - r; }
    else {
        if(r < -1.5707963267948966){ r = 3.141592653589793 + r; s = -1.0; }
    }
    let x2:f64 = r*r;
    let term:f64 = r;
    let sum:f64 = r;
    let k:i64 = 1;
    while(k < 12){
        let d:f64 = ((2*k) as f64)*((2*k+1) as f64);
        term = -term*x2/d;
        sum = sum + term;
        k = k + 1;
    }
    return s*sum;
}
fn synth_phase(freq:f64, n:i64, sr:f64)f64 {
    return 6.283185307179586*freq*(n as f64)/sr;
}
// @fragment-end

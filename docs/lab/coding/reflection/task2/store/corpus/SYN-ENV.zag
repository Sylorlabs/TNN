// @entry SYN-ENV
// @desc Human ADSR prior art: an envelope is a piecewise-linear function of
// @desc the sample index. Attack: linear 0 -> 1 over [0, a_end). Decay:
// @desc linear 1 -> sustain over [a_end, d_end). Sustain: constant over
// @desc [d_end, off). Release: linear sustain -> 0 over [off, r_end).
// @desc Boundaries are sample-exact (the segment that contains n wins).
// @fragment-begin
fn synth_adsr(n:i64, a_end:i64, d_end:i64, off:i64, r_end:i64, sus:f64)f64 {
    if(n < a_end){ return (n as f64)/(a_end as f64); }
    if(n < d_end){ return 1.0 - (1.0-sus)*((n-a_end) as f64)/((d_end-a_end) as f64); }
    if(n < off){ return sus; }
    if(n < r_end){ return sus*(1.0 - ((n-off) as f64)/((r_end-off) as f64)); }
    return 0.0;
}
// @fragment-end

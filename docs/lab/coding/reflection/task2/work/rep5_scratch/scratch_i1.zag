fn synth_floor(x:f64)i64 {
    let t:i64 = x as i64;
    if(x < 0.0){
        if((t as f64) != x){ t = t - 1; }
    }
    return t;
}
// SINE:V1-NAIVE
fn synth_sin(x:f64)f64 {
    let twopi:f64 = 6.283185307179586;
    while(x > 3.141592653589793){ x = x - twopi; }
    while(x < -3.141592653589793){ x = x + twopi; }
    let x2:f64 = x*x;
    let term:f64 = x;
    let sum:f64 = x;
    let k:i64 = 1;
    while(k < 10){
        let d:f64 = ((2*k) as f64)*((2*k+1) as f64);
        term = -term*x2/d;
        sum = sum + term;
        k = k + 1;
    }
    return sum;
}
fn synth_phase(freq:f64, n:i64, sr:f64)f64 {
    return 6.283185307179586*freq*(n as f64)/sr;
}
fn synth_adsr(n:i64, a_end:i64, d_end:i64, off:i64, r_end:i64, sus:f64)f64 {
    if(n < a_end){ return (n as f64)/(a_end as f64); }
    if(n < d_end){ return 1.0 - (1.0-sus)*((n-a_end) as f64)/((d_end-a_end) as f64); }
    if(n < off){ return sus; }
    if(n < r_end){ return sus*(1.0 - ((n-off) as f64)/((r_end-off) as f64)); }
    return 0.0;
}
fn synth_clamp(v:i64)i64 {
    if(v > 32767){ return 32767; }
    if(v < -32768){ return -32768; }
    return v;
}
fn zcstr(s:[]u8)*u8 {
    let p:*u8 = _zag_malloc(s.len+1) as *u8;
    let i:i64 = 0;
    while(i < s.len){ p[i] = s[i]; i = i + 1; }
    p[s.len] = 0;
    return p;
}
fn wav_write_header(fd:i64, nbytes:i64)void {
    let p:*u8 = _zag_malloc(44) as *u8;
    let h:[]u8 = p[0..44];
    h[0]=82; h[1]=73; h[2]=70; h[3]=70;
    let cs:i64 = 36+nbytes;
    h[4]=(cs&255) as u8; h[5]=((cs>>8)&255) as u8;
    h[6]=((cs>>16)&255) as u8; h[7]=((cs>>24)&255) as u8;
    h[8]=87; h[9]=65; h[10]=86; h[11]=69;
    h[12]=102; h[13]=109; h[14]=116; h[15]=32;
    h[16]=16; h[17]=0; h[18]=0; h[19]=0;
    h[20]=1; h[21]=0;
    h[22]=1; h[23]=0;
    h[24]=68; h[25]=172; h[26]=0; h[27]=0;
    h[28]=136; h[29]=88; h[30]=1; h[31]=0;
    h[32]=2; h[33]=0;
    h[34]=16; h[35]=0;
    h[36]=100; h[37]=97; h[38]=116; h[39]=97;
    h[40]=(nbytes&255) as u8; h[41]=((nbytes>>8)&255) as u8;
    h[42]=((nbytes>>16)&255) as u8; h[43]=((nbytes>>24)&255) as u8;
    _zag_raw_syscall(1, fd, p as i64, 44, 0, 0, 0);
    return;
}
fn render_v1(b:[]u8)void {
    let n:i64 = 0;
    while(n < 44100){
        let sn:f64 = synth_sin(synth_phase(440.0, n, 44100.0));
        let v:i64 = synth_floor(32767.0*0.5*sn);
        b[2*n] = (v&255) as u8;
        b[2*n+1] = ((v>>8)&255) as u8;
        n = n + 1;
    }
    return;
}
fn render_v2(b:[]u8)void {
    let n:i64 = 0;
    while(n < 22050){
        let env:f64 = synth_adsr(n, 2205, 6615, 15435, 22050, 0.7);
        let sn:f64 = synth_sin(synth_phase(880.0, n, 44100.0));
        let v:i64 = synth_floor(32767.0*0.8*env*sn);
        b[2*n] = (v&255) as u8;
        b[2*n+1] = ((v>>8)&255) as u8;
        n = n + 1;
    }
    return;
}
fn render_v3(b:[]u8)void {
    let n:i64 = 0;
    while(n < 22050){
        let s1:f64 = synth_sin(synth_phase(440.0, n, 44100.0));
        let s2:f64 = synth_sin(synth_phase(660.0, n, 44100.0));
        let v1:i64 = synth_floor(32767.0*0.5*s1);
        let v2:i64 = synth_floor(32767.0*0.3*s2);
        let v:i64 = synth_clamp(v1+v2);
        b[2*n] = (v&255) as u8;
        b[2*n+1] = ((v>>8)&255) as u8;
        n = n + 1;
    }
    return;
}
fn main()void {
    let out:[]u8 = _zag_arg(1);
    let vec:[]u8 = _zag_arg(2);
    let v:i64 = 0;
    if(vec.len > 0){ v = (vec[0] as i64) - 48; }
    let ns:i64 = 44100;
    if(v == 2){ ns = 22050; }
    if(v == 3){ ns = 22050; }
    let p:*u8 = _zag_malloc(ns*2) as *u8;
    let b:[]u8 = p[0..ns*2];
    if(v == 1){ render_v1(b); }
    else {
        if(v == 2){ render_v2(b); }
        else { render_v3(b); }
    }
    let fd:i64 = _zag_raw_syscall(2, zcstr(out) as i64, 577, 420, 0, 0, 0);
    wav_write_header(fd, ns*2);
    _zag_raw_syscall(1, fd, p as i64, ns*2, 0, 0, 0);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return;
}

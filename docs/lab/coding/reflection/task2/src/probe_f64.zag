// f64 semantics probe for Task 2 (SYN-SIN fragment de-risking).
// Verifies: IEEE add/mul/div, literal parsing, f64->i64 truncation,
// and the exact SYN-OSC sine fragment against Python's bit-exact simulation.
fn zfloor(x:f64)i64 {
    let t:i64 = x as i64;
    if(x < 0.0){
        if((t as f64) != x){ t = t - 1; }
    }
    return t;
}

fn zsin(x:f64)f64 {
    let q:f64 = x / 6.283185307179586;
    let qi:i64 = zfloor(q);
    let qf:f64 = qi as f64;
    let r1:f64 = x - qf*6.283185303211212;
    let r:f64 = r1 - qf*3.968374318722162/1000000000.0;
    if(r > 3.141592653589793){ r = r - 6.283185307179586; }
    if(r < -3.141592653589793){ r = r + 6.283185307179586; }
    let s:f64 = 1.0;
    if(r > 1.5707963267948966){ r = 3.141592653589793 - r; }
    else {
        if(r < -1.5707963267948966){ r = 3.141592653589793 + r; s = -1.0; }
    }
    let x2:f64 = r*r;
    let term:f64 = r;
    let sum:f64 = r;
    let k:i64 = 1;
    while(k < 12){
        let d:f64 = ((2*k) as f64)*((2*k+1) as f64);
        term = -term*x2/d;
        sum = sum + term;
        k = k + 1;
    }
    return s*sum;
}

fn zphase(freq:f64, n:i64, sr:f64)f64 {
    return 6.283185307179586*freq*(n as f64)/sr;
}

fn main()void {
    // 1. IEEE add check: 0.1+0.2
    let a:f64 = 0.1 + 0.2;
    _zag_print(_zag_i64_to_str((a*100000000000000000.0) as i64));
    _zag_print("\n");
    // 2. IEEE div check: 1.0/3.0
    let b:f64 = 1.0/3.0;
    _zag_print(_zag_i64_to_str((b*100000000000000000.0) as i64));
    _zag_print("\n");
    // 3. truncation checks
    _zag_print(_zag_i64_to_str((-0.5 as f64) as i64));
    _zag_print("\n");
    _zag_print(_zag_i64_to_str((-1.7 as f64) as i64));
    _zag_print("\n");
    _zag_print(_zag_i64_to_str((3.7 as f64) as i64));
    _zag_print("\n");
    // 4. zfloor checks
    _zag_print(_zag_i64_to_str(zfloor(-0.5)));
    _zag_print("\n");
    _zag_print(_zag_i64_to_str(zfloor(-4.0)));
    _zag_print("\n");
    // 5. sine on critical phases: the 5 near-zero samples' args + a few general
    // V1 n=11025: arg = 2*pi*440*11025/44100
    let x1:f64 = zphase(440.0, 11025, 44100.0);
    _zag_print(_zag_i64_to_str((zsin(x1)*1000000000000000.0) as i64));
    _zag_print("\n");
    let x2:f64 = zphase(440.0, 22050, 44100.0);
    _zag_print(_zag_i64_to_str((zsin(x2)*1000000000000000.0) as i64));
    _zag_print("\n");
    let x3:f64 = zphase(440.0, 1, 44100.0);
    _zag_print(_zag_i64_to_str((zsin(x3)*1000000000000000.0) as i64));
    _zag_print("\n");
    let x4:f64 = zphase(880.0, 11025, 44100.0);
    _zag_print(_zag_i64_to_str((zsin(x4)*1000000000000000.0) as i64));
    _zag_print("\n");
    // 6. full sample computation for V1 n=1 and V1 n=11025
    let s1:f64 = 32767.0*0.5*zsin(zphase(440.0, 1, 44100.0));
    _zag_print(_zag_i64_to_str(zfloor(s1)));
    _zag_print("\n");
    let s2:f64 = 32767.0*0.5*zsin(zphase(440.0, 11025, 44100.0));
    _zag_print(_zag_i64_to_str(zfloor(s2)));
    _zag_print("\n");
    return;
}

// adv_delib.zag — LH-ADV-2026-09-22 deliberation engine (trial machinery).
// Pure Zag, zero RNG. Modes:
//   propose <stage> <contract> <kb> [quarantine]   — CAND lines or HALT
//   critique <stage> <contract> <cands>             — ACCEPT or HALT NO-ACCEPT
//   compose <stage> <spec> <crit_ep>                — FINAL spec
//   diagnose <stage> <contract> <kb_used> <quarantine> <spec> <evidence> <upinfo>
//       — DIAGNOSIS ... ACTION REVISED|REGEN|HALT
// 24-op catalog. KB entries: ID:/OP:/CAT:/K: lines (one per op).
// build_spec derives params from DESC+WIN only. No pipeline vocabulary.

fn s_eq(a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn s_find(hay:[]u8, needle:[]u8, from:i64)i64 {
    if(needle.len==0){return from;}
    if(needle.len>hay.len){return -1;}
    let i:i64=from;
    while(i+needle.len<=hay.len){
        let j:i64=0;
        let ok:i64=1;
        while(j<needle.len){
            if(hay[i+j]!=needle[j]){ok=0;}
            j=j+1;
        }
        if(ok==1){return i;}
        i=i+1;
    }
    return -1;
}

fn s_has(hay:[]u8, needle:[]u8)i64 {
    if(s_find(hay,needle,0)>=0){return 1;}
    return 0;
}

fn spec_kv(spec:[]u8, key:[]u8)[]u8 {
    let pos:i64=s_find(spec,key,0);
    if(pos<0){let e:[]u8="";return e;}
    let vs:i64=pos+key.len;
    if(vs>=spec.len){let e2:[]u8="";return e2;}
    let ve:i64=vs;
    while(ve<spec.len){
        if(spec[ve]==124){break;}
        ve=ve+1;
    }
    return spec[vs..ve];
}

fn num_val(s:[]u8)i64 {
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    let v:i64=0;
    while(i<s.len){
        if(s[i]>=48){if(s[i]<=57){v=v*10+((s[i] as i64)-48);}}
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

fn fnv(s:[]u8)i64 {
    let h:i64=-3750763034362895579;
    let i:i64=0;
    while(i<s.len){
        h=h^(s[i] as i64);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){if(s[s.len-1]==10){return s[0..s.len-1];}}
    return s;
}

fn line_get(t:[]u8, k:i64)[]u8 {
    let ln:i64=0;
    let s:i64=0;
    let i:i64=0;
    while(i<t.len){
        if(t[i]==10){
            if(ln==k){return t[s..i];}
            ln=ln+1;
            s=i+1;
        }
        i=i+1;
    }
    if(ln==k){return t[s..t.len];}
    let e:[]u8="";
    return e;
}

fn line_count(t:[]u8)i64 {
    let c:i64=0;
    let i:i64=0;
    while(i<t.len){
        if(t[i]==10){c=c+1;}
        i=i+1;
    }
    if(t.len>0){if(t[t.len-1]!=10){c=c+1;}}
    return c;
}

fn sw(s:[]u8, pre:[]u8)i64 {
    if(s.len<pre.len){return 0;}
    let i:i64=0;
    while(i<pre.len){
        if(s[i]!=pre[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn cline(c:[]u8, pre:[]u8, off:i64)[]u8 {
    let n:i64=line_count(c);
    let i:i64=0;
    while(i<n){
        let l:[]u8=line_get(c,i);
        if(sw(l,pre)==1){return l[off..l.len];}
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn c_desc(contract:[]u8)[]u8 {
    return cline(contract,"DESC ",5);
}
fn c_win(contract:[]u8)[]u8 {
    return cline(contract,"WIN ",4);
}
fn c_winl(contract:[]u8)[]u8 {
    return cline(contract,"WINL ",5);
}
fn c_winr(contract:[]u8)[]u8 {
    return cline(contract,"WINR ",6);
}
fn c_stage(contract:[]u8)[]u8 {
    return cline(contract,"STAGE ",6);
}

fn c_ntests(contract:[]u8)i64 {
    let n:i64=line_count(contract);
    let i:i64=0;
    let t:i64=0;
    while(i<n){
        let l:[]u8=line_get(contract,i);
        if(sw(l,"TEST in=")==1){t=t+1;}
        i=i+1;
    }
    return t;
}

fn c_testin(contract:[]u8, k:i64)[]u8 {
    let n:i64=line_count(contract);
    let i:i64=0;
    let t:i64=0;
    while(i<n){
        let l:[]u8=line_get(contract,i);
        if(sw(l,"TEST in=")==1){
            if(t==k){return l[8..l.len];}
            t=t+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn c_testout(contract:[]u8, k:i64)[]u8 {
    let n:i64=line_count(contract);
    let i:i64=0;
    let t:i64=0;
    while(i<n){
        let l:[]u8=line_get(contract,i);
        if(sw(l,"TEST out=")==1){
            if(t==k){return l[9..l.len];}
            t=t+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn win_fieldname(win:[]u8, k:i64)[]u8 {
    let i:i64=0;
    let f:i64=0;
    while(i<win.len){
        if(f==k){
            let e:i64=i;
            while(e<win.len){
                if(win[e]==124){break;}
                e=e+1;
            }
            return win[i..e];
        }
        if(win[i]==124){f=f+1;}
        i=i+1;
    }
    let e2:[]u8="";
    return e2;
}

fn win_nfields(win:[]u8)i64 {
    if(win.len==0){return 0;}
    let n:i64=1;
    let i:i64=0;
    while(i<win.len){
        if(win[i]==124){n=n+1;}
        i=i+1;
    }
    return n;
}

fn is_wordchar(c:u8)i64 {
    if(c>=48){if(c<=57){return 1;}}
    if(c>=65){if(c<=90){return 1;}}
    if(c>=97){if(c<=122){return 1;}}
    return 0;
}

fn word_has(desc:[]u8, w:[]u8)i64 {
    if(w.len==0){return 0;}
    if(w.len>desc.len){return 0;}
    let p:i64=0;
    while(p+w.len<=desc.len){
        if(s_eq(desc[p..p+w.len],w)==1){
            let lok:i64=0;
            if(p==0){lok=1;}
            if(lok==0){
                if(is_wordchar(desc[p-1])==0){lok=1;}
            }
            let rok:i64=0;
            if(p+w.len==desc.len){rok=1;}
            if(rok==0){
                if(is_wordchar(desc[p+w.len])==0){rok=1;}
            }
            if(lok==1){
                if(rok==1){return 1;}
            }
        }
        p=p+1;
    }
    return 0;
}

fn op_score(desc:[]u8, keys:[]u8)i64 {
    let sc:i64=0;
    let s:i64=0;
    let i:i64=0;
    while(i<=keys.len){
        let eol:i64=0;
        if(i==keys.len){eol=1;}
        if(eol==0){if(keys[i]==32){eol=1;}}
        if(eol==1){
            if(i>s){
                let w:[]u8=keys[s..i];
                if(w.len>0){
                    if(word_has(desc,w)==1){sc=sc+1;}
                }
            }
            s=i+1;
        }
        i=i+1;
    }
    return sc;
}

fn extract_ints(desc:[]u8, out:*Out, maxn:i64)i64 {
    let c:i64=0;
    let i:i64=0;
    while(i<desc.len){
        let isd:i64=0;
        if(desc[i]>=48){if(desc[i]<=57){isd=1;}}
        let neg:i64=0;
        if(desc[i]==45){
            if(i+1<desc.len){
                if(desc[i+1]>=48){if(desc[i+1]<=57){isd=1;neg=1;}}
            }
        }
        if(isd==1){
            let v:i64=0;
            if(neg==1){i=i+1;}
            while(i<desc.len){
                if(desc[i]>=48){
                    if(desc[i]<=57){
                        v=v*10+((desc[i] as i64)-48);
                        i=i+1;
                    } else {break;}
                } else {break;}
            }
            if(neg==1){v=0-v;}
            if(c<maxn){
                o_put64(out,v);
                c=c+1;
            }
        } else {
            i=i+1;
        }
    }
    return c;
}

fn extract_set(desc:[]u8)[]u8 {
    let p:i64=s_find(desc,"{",0);
    if(p<0){let e:[]u8="";return e;}
    let q:i64=s_find(desc,"}",p);
    if(q<0){let e2:[]u8="";return e2;}
    return desc[p+1..q];
}

struct Out {
    b:[]u8,
    n:i64,
}

fn out_new(sz:i64)Out {
    let o:Out=Out{};
    let p:*u8=_zag_malloc(sz) as *u8;
    o.b=p[0..sz];
    o.n=0;
    return o;
}

fn o_raw(o:*Out, s:[]u8)void {
    let b:[]u8=o.*.b;
    let n:i64=o.*.n;
    let i:i64=0;
    while(i<s.len){
        b[n]=s[i];
        n=n+1;
        i=i+1;
    }
    o.*.n=n;
    return;
}

fn o_i64(o:*Out, v:i64)void {
    o_raw(o,i64s(v));
    return;
}

fn o_line(o:*Out)void {
    o_raw(o,"\n");
    return;
}

fn o_put64(o:*Out, v:i64)void {
    let b:[]u8=o.*.b;
    let n:i64=o.*.n;
    let k:i64=0;
    let x:i64=v;
    while(k<8){
        b[n]=(x as u8);
        x=x/256;
        n=n+1;
        k=k+1;
    }
    o.*.n=n;
    return;
}

fn o_get64(o:Out, idx:i64)i64 {
    let b:[]u8=o.b;
    let p:i64=idx*8;
    let v:i64=0;
    let k:i64=7;
    while(k>=0){
        v=v*256+(b[p+k] as i64);
        k=k-1;
    }
    return v;
}

// find_fields: 1-based WIN indices in order of appearance in DESC (word boundaries)
fn find_fields(desc:[]u8, win:[]u8, out:*Out)i64 {
    let c:i64=0;
    let nf:i64=win_nfields(win);
    let i:i64=0;
    while(i<desc.len){
        let matched:i64=0;
        let k:i64=0;
        while(k<nf){
            let nm:[]u8=win_fieldname(win,k);
            if(nm.len>0){
                if(i+nm.len<=desc.len){
                    if(s_eq(desc[i..i+nm.len],nm)==1){
                        // word boundary check
                        let lok:i64=0;
                        if(i==0){lok=1;}
                        if(lok==0){
                            if(is_wordchar(desc[i-1])==0){lok=1;}
                        }
                        let rok:i64=0;
                        if(i+nm.len==desc.len){rok=1;}
                        if(rok==0){
                            if(is_wordchar(desc[i+nm.len])==0){rok=1;}
                        }
                        if(lok==1){
                            if(rok==1){
                                o_put64(out,k+1);
                                c=c+1;
                                i=i+nm.len;
                                matched=1;
                                k=nf;
                            }
                        }
                    }
                }
            }
            if(matched==0){k=k+1;}
        }
        if(matched==0){i=i+1;}
    }
    return c;
}

// d_ record helpers for simulators
fn d_field_count(rec:[]u8)i64 {
    if(rec.len==0){return 0;}
    let c:i64=1;
    let i:i64=0;
    while(i<rec.len){if(rec[i]==124){c=c+1;}i=i+1;}
    return c;
}

fn d_field_get(rec:[]u8, k:i64)[]u8 {
    let n:i64=1;
    let s:i64=0;
    let i:i64=0;
    while(i<=rec.len){
        let e:i64=0;
        if(i==rec.len){e=1;}
        if(e==0){if(rec[i]==124){e=1;}}
        if(e==1){if(n==k){return rec[s..i];}n=n+1;s=i+1;}
        i=i+1;
    }
    let e2:[]u8="";
    return e2;
}

fn d_case(s:[]u8, o:*Out, up:i64)void {
    let i:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(up==1){
            if(c>=97){if(c<=122){c=c-32;}}
        } else {
            if(c>=65){if(c<=90){c=c+32;}}
        }
        let b:[]u8=o.*.b;
        b[o.*.n]=c;
        o.*.n=o.*.n+1;
        i=i+1;
    }
    return;
}

// template_of: extract single-quoted template from DESC, convert {name}->{index} via WIN.
// Returns "" if no quoted template or an unresolvable name.
fn template_of(desc:[]u8, win:[]u8)[]u8 {
    let q1:i64=s_find(desc,"'",0);
    let tmpl:[]u8="";
    if(q1>=0){
        let q2:i64=s_find(desc,"'",q1+1);
        if(q2>q1){tmpl=desc[q1+1..q2];}
    }
    if(tmpl.len==0){
        let e:[]u8="";
        return e;
    }
    let tm:Out=out_new(4096);
    let tp:*Out=&tm;
    let i:i64=0;
    let ok:i64=1;
    while(i<tmpl.len){
        if(tmpl[i]==123){
            let j:i64=s_find(tmpl,"}",i);
            if(j>i){
                let nm:[]u8=tmpl[i+1..j];
                if(all_digits(nm)==1){
                    o_raw(tp,"{");
                    o_raw(tp,nm);
                    o_raw(tp,"}");
                } else {
                    let fi:i64=0;
                    let nwf:i64=win_nfields(win);
                    let fnd:i64=0;
                    while(fi<nwf){
                        if(s_eq(win_fieldname(win,fi),nm)==1){
                            o_raw(tp,"{");
                            o_i64(tp,fi+1);
                            o_raw(tp,"}");
                            fnd=1;
                        }
                        fi=fi+1;
                    }
                    if(fnd==0){ok=0;}
                }
                i=j+1;
            } else {
                o_raw(tp,tmpl[i..i+1]);
                i=i+1;
            }
        } else {
            o_raw(tp,tmpl[i..i+1]);
            i=i+1;
        }
    }
    if(ok==0){
        let e2:[]u8="";
        return e2;
    }
    return tm.b[0..tm.n];
}

// ---- KB: ID:/OP:/CAT:/K: entries ----
fn kb_nentries(kb:[]u8)i64 {
    let nl:i64=line_count(kb);
    let i:i64=0;
    let c:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(kb,i);
        if(sw(ln,"ID: ADV-OP|")==1){c=c+1;}
        i=i+1;
    }
    return c;
}

// kb entry text: 4 lines for k-th entry
fn kb_entry(kb:[]u8, k:i64)[]u8 {
    let nl:i64=line_count(kb);
    let i:i64=0;
    let c:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(kb,i);
        if(sw(ln,"ID: ADV-OP|")==1){
            if(c==k){
                let o:Out=out_new(1024);
                let op:*Out=&o;
                o_raw(op,ln);o_line(op);
                if(i+1<nl){o_raw(op,line_get(kb,i+1));o_line(op);}
                if(i+2<nl){o_raw(op,line_get(kb,i+2));o_line(op);}
                if(i+3<nl){o_raw(op,line_get(kb,i+3));o_line(op);}
                return o.b[0..o.n];
            }
            c=c+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn kb_e_op(ent:[]u8)[]u8 {
    return cline(ent,"OP: ",4);
}
fn kb_e_cat(ent:[]u8)[]u8 {
    return cline(ent,"CAT: ",5);
}
fn kb_e_keys(ent:[]u8)[]u8 {
    return cline(ent,"K: ",3);
}
fn kb_e_id(ent:[]u8)[]u8 {
    return cline(ent,"ID: ",4);
}

// kb_has_id: does kb contain this exact ID (used for corrupt-KB detection)
fn kb_has_id(kb:[]u8, id:[]u8)[]u8 {
    let nl:i64=line_count(kb);
    let i:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(kb,i);
        if(sw(ln,"ID: ")==1){
            if(s_eq(ln[4..ln.len],id)==1){
                if(i+3<nl){
                    let o:Out=out_new(1024);
                    let op:*Out=&o;
                    o_raw(op,ln);o_line(op);
                    o_raw(op,line_get(kb,i+1));o_line(op);
                    o_raw(op,line_get(kb,i+2));o_line(op);
                    o_raw(op,line_get(kb,i+3));o_line(op);
                    return o.b[0..o.n];
                }
            }
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

// all_digits: for template brace names that are already indices
fn all_digits(s:[]u8)i64 {
    if(s.len==0){return 0;}
    let i:i64=0;
    while(i<s.len){
        if(s[i]<48){return 0;}
        if(s[i]>57){return 0;}
        i=i+1;
    }
    return 1;
}

// ordinal word -> 1-based index: "first|second|third field of the left|right"
fn ordinal_field(desc:[]u8, side:[]u8)i64 {
    let ords:[]u8="first second third";
    let oi:i64=0;
    let s:i64=0;
    let i:i64=0;
    while(i<=ords.len){
        let eol:i64=0;
        if(i==ords.len){eol=1;}
        if(eol==0){if(ords[i]==32){eol=1;}}
        if(eol==1){
            if(i>s){
                oi=oi+1;
                let w:[]u8=ords[s..i];
                let pat:Out=out_new(128);
                let pp:*Out=&pat;
                o_raw(pp,w);o_raw(pp," field of the ");o_raw(pp,side);
                let ps:[]u8=pat.b[0..pat.n];
                if(s_has(desc,ps)==1){return oi;}
            }
            s=i+1;
        }
        i=i+1;
    }
    return 0;
}

// build_spec: returns spec, or "" if params cannot be extracted.
// cat is a KB CAT name (FIELD/FILTER/AGG/SORT/JOIN/FORMAT).
fn build_spec(cat:[]u8, op:[]u8, stage:[]u8, desc:[]u8, win:[]u8, winl:[]u8, winr:[]u8, o:*Out)void {
    o_raw(o,"ADV|");
    o_raw(o,cat);
    o_raw(o,"|name=");
    o_raw(o,stage);
    let fbuf:Out=out_new(256);
    let fb:*Out=&fbuf;
    let nf:i64=find_fields(desc,win,fb);
    let ibuf:Out=out_new(256);
    let ib:*Out=&ibuf;
    let ni:i64=extract_ints(desc,ib,8);
    let done:i64=0;
    // ---- FIELD ----
    if(s_eq(op,"upper")==1){
        if(nf>=1){
            o_raw(o,"|field=");o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|op=upper");done=1;
        }
    }
    if(s_eq(op,"lower")==1){
        if(nf>=1){
            o_raw(o,"|field=");o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|op=lower");done=1;
        }
    }
    if(s_eq(op,"clamp")==1){
        if(nf>=1){
            if(ni>=2){
                o_raw(o,"|field=");o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|lo=");o_i64(o,o_get64(ibuf,0));
                o_raw(o,"|hi=");o_i64(o,o_get64(ibuf,1));
                o_raw(o,"|op=clamp");done=1;
            }
        }
    }
    if(s_eq(op,"mul_fields")==1){
        if(nf>=2){
            o_raw(o,"|fa=");o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|fb=");o_i64(o,o_get64(fbuf,1));
            o_raw(o,"|op=mul_fields");done=1;
        }
    }
    if(s_eq(op,"substr")==1){
        if(nf>=1){
            if(ni>=2){
                o_raw(o,"|field=");o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|s=");o_i64(o,o_get64(ibuf,0));
                o_raw(o,"|l=");o_i64(o,o_get64(ibuf,1));
                o_raw(o,"|op=substr");done=1;
            }
        }
    }
    // ---- FILTER ----
    if(s_eq(op,"int_gt")==1){
        if(nf>=1){
            if(ni>=1){
                o_raw(o,"|field=");o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|threshold=");o_i64(o,o_get64(ibuf,0));
                o_raw(o,"|op=int_gt");done=1;
            }
        }
    }
    if(s_eq(op,"int_lt")==1){
        if(nf>=1){
            if(ni>=1){
                o_raw(o,"|field=");o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|threshold=");o_i64(o,o_get64(ibuf,0));
                o_raw(o,"|op=int_lt");done=1;
            }
        }
    }
    if(s_eq(op,"int_ge")==1){
        if(nf>=1){
            if(ni>=1){
                o_raw(o,"|field=");o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|threshold=");o_i64(o,o_get64(ibuf,0));
                o_raw(o,"|op=int_ge");done=1;
            }
        }
    }
    if(s_eq(op,"in_set")==1){
        if(nf>=1){
            let st:[]u8=extract_set(desc);
            if(st.len>0){
                o_raw(o,"|field=");o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|set=");o_raw(o,st);
                o_raw(o,"|op=in_set");done=1;
            }
        }
    }
    if(s_eq(op,"field_count_eq")==1){
        if(ni>=1){
            o_raw(o,"|n=");o_i64(o,o_get64(ibuf,0));
            o_raw(o,"|op=field_count_eq");done=1;
        }
    }
    // ---- AGG ----
    if(s_eq(op,"sum")==1){
        if(nf>=2){
            o_raw(o,"|key=");o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|val=");o_i64(o,o_get64(fbuf,1));
            o_raw(o,"|op=sum");done=1;
        }
    }
    if(s_eq(op,"count")==1){
        if(nf>=1){
            o_raw(o,"|key=");o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|op=count");done=1;
        }
    }
    if(s_eq(op,"avg")==1){
        if(nf>=2){
            o_raw(o,"|key=");o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|val=");o_i64(o,o_get64(fbuf,1));
            o_raw(o,"|op=avg");done=1;
        }
    }
    if(s_eq(op,"min")==1){
        if(nf>=2){
            o_raw(o,"|key=");o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|val=");o_i64(o,o_get64(fbuf,1));
            o_raw(o,"|op=min");done=1;
        }
    }
    if(s_eq(op,"max")==1){
        if(nf>=2){
            o_raw(o,"|key=");o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|val=");o_i64(o,o_get64(fbuf,1));
            o_raw(o,"|op=max");done=1;
        }
    }
    // ---- SORT ----
    if(s_eq(op,"sort_desc")==1){
        if(nf>=1){
            o_raw(o,"|field=");o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|order=desc|take=");
            if(ni>=1){o_i64(o,o_get64(ibuf,0));} else {o_i64(o,0);}
            o_raw(o,"|op=sort_desc");done=1;
        }
    }
    if(s_eq(op,"sort_asc")==1){
        if(nf>=1){
            o_raw(o,"|field=");o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|order=asc|take=");
            if(ni>=1){o_i64(o,o_get64(ibuf,0));} else {o_i64(o,0);}
            o_raw(o,"|op=sort_asc");done=1;
        }
    }
    if(s_eq(op,"topn")==1){
        if(nf>=1){
            if(ni>=1){
                o_raw(o,"|field=");o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|order=desc|take=");o_i64(o,o_get64(ibuf,0));
                o_raw(o,"|op=topn");done=1;
            }
        }
    }
    // ---- JOIN ----
    if(s_eq(op,"inner_join")==1){
        let lk:i64=ordinal_field(desc,"left");
        let rk:i64=ordinal_field(desc,"right");
        if(lk>0){
            if(rk>0){
                o_raw(o,"|key=");o_i64(o,lk);
                o_raw(o,"|key2=");o_i64(o,rk);
                o_raw(o,"|rfields=");o_i64(o,win_nfields(winr));
                o_raw(o,"|op=inner_join");done=1;
            }
        }
    }
    if(s_eq(op,"left_join")==1){
        let lk:i64=ordinal_field(desc,"left");
        let rk:i64=ordinal_field(desc,"right");
        if(lk>0){
            if(rk>0){
                o_raw(o,"|key=");o_i64(o,lk);
                o_raw(o,"|key2=");o_i64(o,rk);
                o_raw(o,"|rfields=");o_i64(o,win_nfields(winr));
                o_raw(o,"|op=left_join");done=1;
            }
        }
    }
    if(s_eq(op,"cross_join")==1){
        o_raw(o,"|key=1|key2=1|rfields=");
        o_i64(o,win_nfields(winr));
        o_raw(o,"|op=cross_join");done=1;
    }
    // ---- FORMAT ----
    if(s_eq(op,"template")==1){
        let ts:[]u8=template_of(desc,win);
        if(ts.len>0){
            o_raw(o,"|template=");
            o_raw(o,ts);
            o_raw(o,"|op=template");
            done=1;
        }
    }
    if(s_eq(op,"csv_line")==1){
        o_raw(o,"|op=csv_line");done=1;
    }
    if(s_eq(op,"kv_line")==1){
        if(win.len>0){
            o_raw(o,"|win=");
            let nwf:i64=win_nfields(win);
            let fi:i64=0;
            while(fi<nwf){
                if(fi>0){o_raw(o,",");}
                o_raw(o,win_fieldname(win,fi));
                fi=fi+1;
            }
            o_raw(o,"|op=kv_line");done=1;
        }
    }
    return;
}

// propose: candidates or HALT. quarantine lists KB entry IDs barred from use.
fn do_propose(out:*Out, stage:[]u8, contract:[]u8, kb:[]u8, quarantine:[]u8)void {
    let desc:[]u8=c_desc(contract);
    let win:[]u8=c_win(contract);
    let winl:[]u8=c_winl(contract);
    let winr:[]u8=c_winr(contract);
    let dh:i64=fnv(desc);
    if(desc.len==0){
        o_raw(out,"HALT KB-MISS no-DESC\n");
        return;
    }
    // check every KB line for the corruption marker: IDs must be ADV-OP|<CAT>|<op>
    // SKIP quarantined IDs: they are already diagnosed, do not halt on them again.
    let nl:i64=line_count(kb);
    let li:i64=0;
    while(li<nl){
        let ln:[]u8=line_get(kb,li);
        if(sw(ln,"ID: ")==1){
            let cur_id:[]u8=ln[4..ln.len];
            // check if cur_id is in quarantine (comma-separated)
            let qskip:i64=0;
            if(quarantine.len>0){
                if(s_has(quarantine,cur_id)==1){qskip=1;}
            }
            if(qskip==0){
            if(s_has(ln,"[SECURITY_DATA]")==1){
                o_raw(out,"HALT KB-CORRUPT ");
                o_raw(out,ln[4..ln.len]);
                o_line(out);
                o_raw(out,"EP ");
                o_raw(out,stage);
                o_raw(out,"-P1 PROPOSER propose KB:anomaly IN:");
                o_i64(out,dh);
                o_raw(out," HALT KB-CORRUPT marker-in-ID ");
                o_raw(out,ln[4..ln.len]);
                o_line(out);
                return;
            }
            if(sw(ln,"ID: ADV-OP|")==0){
                o_raw(out,"HALT KB-CORRUPT ");
                o_raw(out,ln[4..ln.len]);
                o_line(out);
                o_raw(out,"EP ");
                o_raw(out,stage);
                o_raw(out,"-P1 PROPOSER propose KB:anomaly IN:");
                o_i64(out,dh);
                o_raw(out," HALT KB-CORRUPT malformed-ID ");
                o_raw(out,ln[4..ln.len]);
                o_line(out);
                return;
            }
            if(s_has(ln,"|")==1){
                let b1:i64=s_find(ln,"|",4);
                if(b1>=0){
                    let b2:i64=s_find(ln,"|",b1+1);
                    if(b2<0){
                        o_raw(out,"HALT KB-CORRUPT ");
                        o_raw(out,ln[4..ln.len]);
                        o_line(out);
                        return;
                    }
                    let opnm:[]u8=ln[b2+1..ln.len];
                    let opx:[]u8="";
                    if(li+3<nl){
                        let ol:[]u8=line_get(kb,li+1);
                        if(sw(ol,"OP: ")==1){opx=ol[4..ol.len];}
                    }
                    if(s_eq(opnm,opx)==0){
                        o_raw(out,"HALT KB-CORRUPT ");
                        o_raw(out,ln[4..ln.len]);
                        o_line(out);
                        o_raw(out,"EP ");
                        o_raw(out,stage);
                        o_raw(out,"-P1 PROPOSER propose KB:anomaly IN:");
                        o_i64(out,dh);
                        o_raw(out," HALT KB-CORRUPT id-op-mismatch ");
                        o_raw(out,ln[4..ln.len]);
                        o_line(out);
                        return;
                    }
                }
            }
            } // end qskip==0
        }
        li=li+1;
    }
    // score all entries; skip quarantined IDs; keep top 2
    let b1ent:[]u8="";
    let b1op:[]u8="";
    let b1cat:[]u8="";
    let b1id:[]u8="";
    let b1s:i64=-1;
    let b2op:[]u8="";
    let b2cat:[]u8="";
    let b2id:[]u8="";
    let b2s:i64=-1;
    let ne:i64=kb_nentries(kb);
    let ei:i64=0;
    while(ei<ne){
        let ent:[]u8=kb_entry(kb,ei);
        let id:[]u8=kb_e_id(ent);
        let op:[]u8=kb_e_op(ent);
        let cat:[]u8=kb_e_cat(ent);
        let keys:[]u8=kb_e_keys(ent);
        let quar:i64=0;
        if(quarantine.len>0){
            if(s_has(quarantine,id)==1){quar=1;}
        }
        if(quar==0){
            if(op.len>0){
                if(cat.len>0){
                    let sc:i64=op_score(desc,keys);
                    if(sc>b1s){
                        b2op=b1op;b2cat=b1cat;b2id=b1id;b2s=b1s;
                        b1ent=ent;b1op=op;b1cat=cat;b1id=id;b1s=sc;
                    } else {
                        if(sc>b2s){
                            b2op=op;b2cat=cat;b2id=id;b2s=sc;
                        }
                    }
                }
            }
        }
        ei=ei+1;
    }
    if(b1s<=0){
        o_raw(out,"HALT KB-MISS no-op-matches-DESC\n");
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-P1 PROPOSER propose KB:none IN:");
        o_i64(out,dh);
        o_raw(out," HALT KB-MISS no-capability-keywords-match\n");
        return;
    }
    // candidate 1
    let s1:Out=out_new(4096);
    let p1:*Out=&s1;
    build_spec(b1cat,b1op,stage,desc,win,winl,winr,p1);
    let sp1:[]u8=s1.b[0..s1.n];
    if(s_has(sp1,"|op=")==1){
        o_raw(out,"CAND ");
        o_raw(out,stage);
        o_raw(out,"-P1 ");
        o_raw(out,sp1);
        o_line(out);
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-P1 PROPOSER propose KB:");
        o_raw(out,b1id);
        o_raw(out," IN:");
        o_i64(out,dh);
        o_raw(out," SELECT ");
        o_raw(out,b1op);
        o_raw(out," SCORE ");
        o_i64(out,b1s);
        o_line(out);
    } else {
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-P1 PROPOSER propose KB:");
        o_raw(out,b1id);
        o_raw(out," IN:");
        o_i64(out,dh);
        o_raw(out," HALT PARAM-MISS ");
        o_raw(out,b1op);
        o_line(out);
    }
    // candidate 2 (only if scored > 0 and a different op)
    if(b2s>0){
        if(s_eq(b2op,b1op)==0){
            let s2:Out=out_new(4096);
            let p2:*Out=&s2;
            build_spec(b2cat,b2op,stage,desc,win,winl,winr,p2);
            let sp2:[]u8=s2.b[0..s2.n];
            if(s_has(sp2,"|op=")==1){
                o_raw(out,"CAND ");
                o_raw(out,stage);
                o_raw(out,"-P2 ");
                o_raw(out,sp2);
                o_line(out);
                o_raw(out,"EP ");
                o_raw(out,stage);
                o_raw(out,"-P2 PROPOSER propose KB:");
                o_raw(out,b2id);
                o_raw(out," IN:");
                o_i64(out,dh);
                o_raw(out," SELECT ");
                o_raw(out,b2op);
                o_raw(out," SCORE ");
                o_i64(out,b2s);
                o_line(out);
            }
        }
    }
    return;
}

// ---- simulators (critic) ----
// sim_field: single record -> appended output
fn sim_field(spec:[]u8, rec:[]u8, out:*Out)void {
    let op:[]u8=spec_kv(spec,"op=");
    if(s_eq(op,"upper")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            let fd:[]u8=d_field_get(rec,k);
            if(k==f){d_case(fd,out,1);} else {o_raw(out,fd);}
            if(k<n){o_raw(out,"|");}
            k=k+1;
        }
        return;
    }
    if(s_eq(op,"lower")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            let fd:[]u8=d_field_get(rec,k);
            if(k==f){d_case(fd,out,0);} else {o_raw(out,fd);}
            if(k<n){o_raw(out,"|");}
            k=k+1;
        }
        return;
    }
    if(s_eq(op,"clamp")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let lo:i64=num_val(spec_kv(spec,"lo="));
        let hi:i64=num_val(spec_kv(spec,"hi="));
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            let fd:[]u8=d_field_get(rec,k);
            if(k==f){
                let v:i64=num_val(fd);
                if(v<lo){v=lo;}
                if(v>hi){v=hi;}
                o_i64(out,v);
            } else {o_raw(out,fd);}
            if(k<n){o_raw(out,"|");}
            k=k+1;
        }
        return;
    }
    if(s_eq(op,"mul_fields")==1){
        let fa:i64=num_val(spec_kv(spec,"fa="));
        let fb:i64=num_val(spec_kv(spec,"fb="));
        let a:i64=num_val(d_field_get(rec,fa));
        let b:i64=num_val(d_field_get(rec,fb));
        o_raw(out,rec);
        o_raw(out,"|");
        o_i64(out,a*b);
        return;
    }
    if(s_eq(op,"substr")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let s:i64=num_val(spec_kv(spec,"s="));
        let l:i64=num_val(spec_kv(spec,"l="));
        let fd:[]u8=d_field_get(rec,f);
        let a:i64=s;
        let b:i64=l;
        if(a<0){a=0;}
        if(a>fd.len){a=fd.len;}
        if(a+b>fd.len){b=fd.len-a;}
        if(b<0){b=0;}
        o_raw(out,rec);
        o_raw(out,"|");
        o_raw(out,fd[a..a+b]);
        return;
    }
    return;
}

// sim_filter: 1=keep, 0=drop
fn sim_filter(spec:[]u8, rec:[]u8)i64 {
    let op:[]u8=spec_kv(spec,"op=");
    if(s_eq(op,"field_count_eq")==1){
        let n:i64=num_val(spec_kv(spec,"n="));
        if(d_field_count(rec)==n){return 1;}
        return 0;
    }
    if(s_eq(op,"int_gt")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let t:i64=num_val(spec_kv(spec,"threshold="));
        if(num_val(d_field_get(rec,f))>t){return 1;}
        return 0;
    }
    if(s_eq(op,"int_ge")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let t:i64=num_val(spec_kv(spec,"threshold="));
        if(num_val(d_field_get(rec,f))>=t){return 1;}
        return 0;
    }
    if(s_eq(op,"int_lt")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let t:i64=num_val(spec_kv(spec,"threshold="));
        if(num_val(d_field_get(rec,f))<t){return 1;}
        return 0;
    }
    if(s_eq(op,"in_set")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let st:[]u8=spec_kv(spec,"set=");
        let fd:[]u8=d_field_get(rec,f);
        let i:i64=0;
        let vs:i64=0;
        while(i<=st.len){
            let eol:i64=0;
            if(i==st.len){eol=1;}
            if(eol==0){if(st[i]==44){eol=1;}}
            if(eol==1){
                if(i>vs){
                    if(s_eq(fd,st[vs..i])==1){return 1;}
                }
                vs=i+1;
            }
            i=i+1;
        }
        return 0;
    }
    return 0;
}

// sim_agg: inputs ;-separated records; outputs ;-separated group lines
fn sim_agg(spec:[]u8, inputs:[]u8, out:*Out)void {
    let op:[]u8=spec_kv(spec,"op=");
    let k:i64=num_val(spec_kv(spec,"key="));
    let vf:i64=num_val(spec_kv(spec,"val="));
    let kb:Out=out_new(8192);
    let vb:Out=out_new(8192);
    let cb:Out=out_new(8192);
    let nb:Out=out_new(8192);
    let kp:*Out=&kb;
    let vp:*Out=&vb;
    let cp:*Out=&cb;
    let np:*Out=&nb;
    let ng:i64=0;
    let i:i64=0;
    let rs:i64=0;
    while(i<=inputs.len){
        let eol:i64=0;
        if(i==inputs.len){eol=1;}
        if(eol==0){if(inputs[i]==59){eol=1;}}
        if(eol==1){
            if(i>rs){
                let rec:[]u8=inputs[rs..i];
                let ky:[]u8=d_field_get(rec,k);
                let val:i64=0;
                if(vf>0){val=num_val(d_field_get(rec,vf));}
                let found:i64=-1;
                // compare against stored key bytes
                let g2:i64=0;
                while(g2<ng){
                    let kb2:[]u8=kb.b;
                    let off:i64=g2*64;
                    let kl:i64=o_get64(cb,g2);
                    if(kl==ky.len){
                        let m:i64=1;
                        let q:i64=0;
                        while(q<kl){
                            if(kb2[off+q]!=ky[q]){m=0;}
                            q=q+1;
                        }
                        if(m==1){found=g2;}
                    }
                    g2=g2+1;
                }
                if(found<0){
                    let off:i64=ng*64;
                    let kb2:[]u8=kb.b;
                    let q:i64=0;
                    while(q<ky.len){
                        kb2[off+q]=ky[q];
                        q=q+1;
                    }
                    o_set64(cp,ng,ky.len);
                    o_set64(vp,ng,val);
                    o_set64(np,ng,1);
                    ng=ng+1;
                } else {
                    let cur:i64=o_get64(vb,found);
                    if(s_eq(op,"sum")==1){o_set64(vp,found,cur+val);}
                    if(s_eq(op,"avg")==1){o_set64(vp,found,cur+val);}
                    if(s_eq(op,"min")==1){if(val<cur){o_set64(vp,found,val);}}
                    if(s_eq(op,"max")==1){if(val>cur){o_set64(vp,found,val);}}
                    o_set64(np,found,o_get64(nb,found)+1);
                }
            }
            rs=i+1;
        }
        i=i+1;
    }
    let g:i64=0;
    while(g<ng){
        let kb2:[]u8=kb.b;
        let off:i64=g*64;
        let kl:i64=o_get64(cb,g);
        o_raw(out,kb2[off..off+kl]);
        o_raw(out,"|");
        if(s_eq(op,"count")==1){
            o_i64(out,o_get64(nb,g));
        } else {
            if(s_eq(op,"avg")==1){
                o_i64(out,o_get64(vb,g)/o_get64(nb,g));
                o_raw(out,"|");
                o_i64(out,o_get64(nb,g));
            } else {
                o_i64(out,o_get64(vb,g));
                o_raw(out,"|");
                o_i64(out,o_get64(nb,g));
            }
        }
        if(g+1<ng){o_raw(out,";");}
        g=g+1;
    }
    return;
}

// o_set64: write i64 little-endian at idx (must already be o_put64-allocated)
fn o_set64(o:*Out, idx:i64, v:i64)void {
    let b:[]u8=o.*.b;
    let p:i64=idx*8;
    let k:i64=0;
    let x:i64=v;
    while(k<8){
        b[p+k]=(x as u8);
        x=x/256;
        k=k+1;
    }
    return;
}

// sim_sort: inputs ;-separated; output ;-separated sorted
fn sim_sort(spec:[]u8, inputs:[]u8, out:*Out)void {
    let f:i64=num_val(spec_kv(spec,"field="));
    let order:[]u8=spec_kv(spec,"order=");
    let take:i64=num_val(spec_kv(spec,"take="));
    let rv:Out=out_new(16384);
    let ro:Out=out_new(16384);
    let rp:*Out=&rv;
    let rop:*Out=&ro;
    let cnt:i64=0;
    let i:i64=0;
    let rs:i64=0;
    while(i<=inputs.len){
        let eol:i64=0;
        if(i==inputs.len){eol=1;}
        if(eol==0){if(inputs[i]==59){eol=1;}}
        if(eol==1){
            if(i>rs){
                let rec:[]u8=inputs[rs..i];
                o_put64(rp,num_val(d_field_get(rec,f)));
                o_put64(rop,cnt);
                cnt=cnt+1;
            }
            rs=i+1;
        }
        i=i+1;
    }
    let idx:Out=out_new(8192);
    let ip:*Out=&idx;
    let q:i64=0;
    while(q<cnt){
        o_put64(ip,q);
        q=q+1;
    }
    let p:i64=0;
    while(p<cnt){
        let q2:i64=0;
        while(q2+1<cnt-p){
            let a:i64=o_get64(idx,q2);
            let b:i64=o_get64(idx,q2+1);
            let va:i64=o_get64(rv,a);
            let vb:i64=o_get64(rv,b);
            let swp:i64=0;
            if(s_eq(order,"desc")==1){
                if(va<vb){swp=1;}
            } else {
                if(va>vb){swp=1;}
            }
            if(swp==1){
                o_set64(ip,q2,b);
                o_set64(ip,q2+1,a);
            }
            q2=q2+1;
        }
        p=p+1;
    }
    let lim:i64=cnt;
    if(take>0){
        if(take<lim){lim=take;}
    }
    // recover records: re-scan inputs for the q-th record
    let w:i64=0;
    while(w<lim){
        let want:i64=o_get64(idx,w);
        let i2:i64=0;
        let rs2:i64=0;
        let cur:i64=0;
        while(i2<=inputs.len){
            let eol2:i64=0;
            if(i2==inputs.len){eol2=1;}
            if(eol2==0){if(inputs[i2]==59){eol2=1;}}
            if(eol2==1){
                if(i2>rs2){
                    if(cur==want){
                        o_raw(out,inputs[rs2..i2]);
                    }
                    cur=cur+1;
                }
                rs2=i2+1;
            }
            i2=i2+1;
        }
        if(w+1<lim){o_raw(out,";");}
        w=w+1;
    }
    return;
}

// sim_join: inputs "lefts||rights"; output ;-separated joined lines
fn sim_join(spec:[]u8, inputs:[]u8, out:*Out)void {
    let op:[]u8=spec_kv(spec,"op=");
    let lk:i64=num_val(spec_kv(spec,"key="));
    let rk:i64=num_val(spec_kv(spec,"key2="));
    let rf:i64=num_val(spec_kv(spec,"rfields="));
    let sep:i64=s_find(inputs,"||",0);
    let ls:[]u8="";
    let rs2:[]u8="";
    if(sep>=0){
        ls=inputs[0..sep];
        rs2=inputs[sep+2..inputs.len];
    } else {
        ls=inputs;
    }
    // record byte arenas (raw, not Out) + separate index Outs
    let larenap:*u8=_zag_malloc(32768) as *u8;
    let larena:[]u8=larenap[0..32768];
    let rarenap:*u8=_zag_malloc(32768) as *u8;
    let rarena:[]u8=rarenap[0..32768];
    let lidx:Out=out_new(4096);
    let ridx:Out=out_new(4096);
    let lip:*Out=&lidx;
    let rip:*Out=&ridx;
    let nl:i64=0;
    let i:i64=0;
    let s:i64=0;
    while(i<=ls.len){
        let eol:i64=0;
        if(i==ls.len){eol=1;}
        if(eol==0){if(ls[i]==59){eol=1;}}
        if(eol==1){
            if(i>s){
                let rec:[]u8=ls[s..i];
                let off:i64=nl*128;
                let q:i64=0;
                while(q<rec.len){
                    if(off+q<32768){larena[off+q]=rec[q];}
                    q=q+1;
                }
                o_put64(lip,off);
                o_put64(lip,rec.len);
                nl=nl+1;
            }
            s=i+1;
        }
        i=i+1;
    }
    let nr:i64=0;
    let i2:i64=0;
    let s2:i64=0;
    while(i2<=rs2.len){
        let eol:i64=0;
        if(i2==rs2.len){eol=1;}
        if(eol==0){if(rs2[i2]==59){eol=1;}}
        if(eol==1){
            if(i2>s2){
                let rec:[]u8=rs2[s2..i2];
                let off:i64=nr*128;
                let q:i64=0;
                while(q<rec.len){
                    if(off+q<32768){rarena[off+q]=rec[q];}
                    q=q+1;
                }
                o_put64(rip,off);
                o_put64(rip,rec.len);
                nr=nr+1;
            }
            s2=i2+1;
        }
        i2=i2+1;
    }
    let first:i64=1;
    let li:i64=0;
    while(li<nl){
        let loff:i64=o_get64(lidx,li*2);
        let llen:i64=o_get64(lidx,li*2+1);
        let lrec:[]u8=larena[loff..loff+llen];
        let lkey:[]u8=d_field_get(lrec,lk);
        let matched:i64=0;
        if(s_eq(op,"cross_join")==1){
            let ri:i64=0;
            while(ri<nr){
                let roff:i64=o_get64(ridx,ri*2);
                let rlen:i64=o_get64(ridx,ri*2+1);
                let rrec:[]u8=rarena[roff..roff+rlen];
                if(first==0){o_raw(out,";");}
                first=0;
                o_raw(out,lrec);
                o_raw(out,"|");
                o_raw(out,rrec);
                ri=ri+1;
            }
        } else {
            let ri:i64=0;
            while(ri<nr){
                let roff:i64=o_get64(ridx,ri*2);
                let rlen:i64=o_get64(ridx,ri*2+1);
                let rrec:[]u8=rarena[roff..roff+rlen];
                let rkey:[]u8=d_field_get(rrec,rk);
                if(s_eq(lkey,rkey)==1){
                    matched=1;
                    if(first==0){o_raw(out,";");}
                    first=0;
                    o_raw(out,lrec);
                    o_raw(out,"|");
                    o_raw(out,rrec);
                }
                ri=ri+1;
            }
            if(s_eq(op,"left_join")==1){
                if(matched==0){
                    if(first==0){o_raw(out,";");}
                    first=0;
                    o_raw(out,lrec);
                    let z:i64=0;
                    while(z<rf){
                        o_raw(out,"|");
                        z=z+1;
                    }
                }
            }
        }
        li=li+1;
    }
    return;
}

// sim_format: single record -> formatted line
fn sim_format(spec:[]u8, rec:[]u8, out:*Out)void {
    let op:[]u8=spec_kv(spec,"op=");
    if(s_eq(op,"template")==1){
        let t:[]u8=spec_kv(spec,"template=");
        let i:i64=0;
        while(i<t.len){
            if(t[i]==123){
                let j:i64=s_find(t,"}",i);
                if(j>i){
                    let kn:i64=num_val(t[i+1..j]);
                    o_raw(out,d_field_get(rec,kn));
                    i=j+1;
                } else {
                    o_raw(out,t[i..i+1]);
                    i=i+1;
                }
            } else {
                o_raw(out,t[i..i+1]);
                i=i+1;
            }
        }
        return;
    }
    if(s_eq(op,"csv_line")==1){
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            if(k>1){o_raw(out,",");}
            o_raw(out,d_field_get(rec,k));
            k=k+1;
        }
        return;
    }
    if(s_eq(op,"kv_line")==1){
        let wn:[]u8=spec_kv(spec,"win=");
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            if(k>1){o_raw(out,"|");}
            // win names comma-separated; find k-th
            let ci:i64=0;
            let c2:i64=0;
            let ws:i64=0;
            let nm:[]u8="";
            while(ci<=wn.len){
                let eol:i64=0;
                if(ci==wn.len){eol=1;}
                if(eol==0){if(wn[ci]==44){eol=1;}}
                if(eol==1){
                    c2=c2+1;
                    if(c2==k){nm=wn[ws..ci];}
                    ws=ci+1;
                }
                ci=ci+1;
            }
            o_raw(out,nm);
            o_raw(out,"=");
            o_raw(out,d_field_get(rec,k));
            k=k+1;
        }
        return;
    }
    return;
}

// do_critique: CAND lines -> ACCEPT or HALT NO-ACCEPT
fn do_critique(out:*Out, stage:[]u8, contract:[]u8, cands:[]u8)void {
    let nt:i64=c_ntests(contract);
    let accepted:i64=0;
    let accepid:[]u8="";
    let nl:i64=line_count(cands);
    let i:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(cands,i);
        if(sw(ln,"CAND ")==1){
            let sp1:i64=s_find(ln," ",5);
            if(sp1>0){
                let epid:[]u8=ln[5..sp1];
                let spec:[]u8=ln[sp1+1..ln.len];
                let pass:i64=1;
                let ti:i64=0;
                while(ti<nt){
                    let tin:[]u8=c_testin(contract,ti);
                    let tout:[]u8=c_testout(contract,ti);
                    let got:Out=out_new(16384);
                    let gp:*Out=&got;
                    if(s_has(spec,"ADV|FIELD|")==1){
                        // map over records
                        let ri:i64=0;
                        let rs:i64=0;
                        let first:i64=1;
                        while(ri<=tin.len){
                            let eol:i64=0;
                            if(ri==tin.len){eol=1;}
                            if(eol==0){if(tin[ri]==59){eol=1;}}
                            if(eol==1){
                                if(ri>rs){
                                    if(first==0){o_raw(gp,";");}
                                    first=0;
                                    sim_field(spec,tin[rs..ri],gp);
                                }
                                rs=ri+1;
                            }
                            ri=ri+1;
                        }
                    } else {
                        if(s_has(spec,"ADV|FILTER|")==1){
                            let ri:i64=0;
                            let rs:i64=0;
                            let first:i64=1;
                            while(ri<=tin.len){
                                let eol:i64=0;
                                if(ri==tin.len){eol=1;}
                                if(eol==0){if(tin[ri]==59){eol=1;}}
                                if(eol==1){
                                    if(ri>rs){
                                        if(sim_filter(spec,tin[rs..ri])==1){
                                            if(first==0){o_raw(gp,";");}
                                            first=0;
                                            o_raw(gp,tin[rs..ri]);
                                        }
                                    }
                                    rs=ri+1;
                                }
                                ri=ri+1;
                            }
                        } else {
                            if(s_has(spec,"ADV|AGG|")==1){
                                sim_agg(spec,tin,gp);
                            } else {
                                if(s_has(spec,"ADV|SORT|")==1){
                                    sim_sort(spec,tin,gp);
                                } else {
                                    if(s_has(spec,"ADV|JOIN|")==1){
                                        sim_join(spec,tin,gp);
                                    } else {
                                        if(s_has(spec,"ADV|FORMAT|")==1){
                                            // map over ;-separated records
                                            let ri:i64=0;
                                            let rs:i64=0;
                                            let first:i64=1;
                                            while(ri<=tin.len){
                                                let eol:i64=0;
                                                if(ri==tin.len){eol=1;}
                                                if(eol==0){if(tin[ri]==59){eol=1;}}
                                                if(eol==1){
                                                    if(ri>rs){
                                                        if(first==0){o_raw(gp,";");}
                                                        first=0;
                                                        sim_format(spec,tin[rs..ri],gp);
                                                    }
                                                    rs=ri+1;
                                                }
                                                ri=ri+1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    let gs:[]u8=got.b[0..got.n];
                    if(s_eq(gs,tout)==0){pass=0;}
                    ti=ti+1;
                }
                if(pass==1){
                    if(accepted==0){
                        o_raw(out,"ACCEPT ");
                        o_raw(out,epid);
                        o_raw(out," ");
                        o_raw(out,spec);
                        o_line(out);
                        o_raw(out,"EP ");
                        o_raw(out,stage);
                        o_raw(out,"-C1 CRITIC critique CITES:");
                        o_raw(out,epid);
                        o_raw(out," ACCEPT ");
                        o_raw(out,spec_kv(spec,"op="));
                        o_raw(out," all-");
                        o_i64(out,nt);
                        o_raw(out,"-tests-pass");
                        o_line(out);
                        accepted=1;
                        accepid=epid;
                    } else {
                        o_raw(out,"EP ");
                        o_raw(out,stage);
                        o_raw(out,"-C2 CRITIC critique CITES:");
                        o_raw(out,epid);
                        o_raw(out," REJECT redundant-accepted-exists");
                        o_line(out);
                    }
                } else {
                    o_raw(out,"EP ");
                    o_raw(out,stage);
                    o_raw(out,"-C1 CRITIC critique CITES:");
                    o_raw(out,epid);
                    o_raw(out," REJECT simulation-mismatch");
                    o_line(out);
                }
            }
        }
        i=i+1;
    }
    if(accepted==0){
        o_raw(out,"HALT NO-ACCEPT\n");
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-C1 CRITIC critique CITES:none REJECT all-candidates-fail");
        o_line(out);
    }
    return;
}

fn do_compose(out:*Out, stage:[]u8, spec:[]u8, crit_ep:[]u8)void {
    o_raw(out,"FINAL ");
    o_raw(out,spec);
    o_line(out);
    o_raw(out,"EP ");
    o_raw(out,stage);
    o_raw(out,"-M COMPOSER compose CITES:");
    o_raw(out,crit_ep);
    o_raw(out," FINAL ");
    o_i64(out,fnv(spec));
    o_line(out);
    return;
}

// do_diagnose: diagnose a failed evidence; invent recovery, or honest halt.
// kb_used: the KB text in force for the run. quarantine: space-separated IDs already barred.
// spec: the spec that failed. evidence: failure evidence line. upinfo: upstream stage/output summary.
// Prints DIAGNOSIS ... ACTION REVISED|REGEN|HALT ... or HALT UNRECOVERABLE <cause>.
// ---- LH-ADV-2 hardened-diagnosis helpers (no true-upstream hint anywhere) ----

// value of key= in evidence up to next marker (or end if next is "").
// Trims ASCII-space separators at the ends: contract values never carry
// leading/trailing spaces (verified), so an empty value between two
// markers parses as "" rather than " ".
fn ev_key(ev:[]u8, key:[]u8, next:[]u8)[]u8 {
    let p:i64=s_find(ev,key,0);
    if(p<0){let e:[]u8="";return e;}
    let st:i64=p+key.len;
    let en:i64=ev.len;
    if(next.len>0){
        let q:i64=s_find(ev,next,st);
        if(q>=0){en=q;}
    }
    while(st<en){
        if(ev[st]!=32){break;}
        st=st+1;
    }
    while(en>st){
        if(ev[en-1]!=32){break;}
        en=en-1;
    }
    return ev[st..en];
}

// DECLARED deps of a stage, read from its own contract (never handed in)
fn c_deps(contract:[]u8)[]u8 {
    return cline(contract,"DEPS ",5);
}

// whole-input simulation of a spec on ;-separated input (flat dispatch)
fn sim_all2(spec:[]u8, tin:[]u8, o:*Out)void {
    let ri:i64=0;
    let rs:i64=0;
    let first:i64=1;
    if(s_has(spec,"ADV|FIELD|")==1){
        while(ri<=tin.len){
            let eol:i64=0;
            if(ri==tin.len){eol=1;}
            if(eol==0){if(tin[ri]==59){eol=1;}}
            if(eol==1){
                if(ri>rs){
                    if(first==0){o_raw(o,";");}
                    first=0;
                    sim_field(spec,tin[rs..ri],o);
                }
                rs=ri+1;
            }
            ri=ri+1;
        }
        return;
    }
    if(s_has(spec,"ADV|FILTER|")==1){
        while(ri<=tin.len){
            let eol:i64=0;
            if(ri==tin.len){eol=1;}
            if(eol==0){if(tin[ri]==59){eol=1;}}
            if(eol==1){
                if(ri>rs){
                    if(sim_filter(spec,tin[rs..ri])==1){
                        if(first==0){o_raw(o,";");}
                        first=0;
                        o_raw(o,tin[rs..ri]);
                    }
                }
                rs=ri+1;
            }
            ri=ri+1;
        }
        return;
    }
    if(s_has(spec,"ADV|AGG|")==1){sim_agg(spec,tin,o);return;}
    if(s_has(spec,"ADV|SORT|")==1){sim_sort(spec,tin,o);return;}
    if(s_has(spec,"ADV|JOIN|")==1){sim_join(spec,tin,o);return;}
    if(s_has(spec,"ADV|FORMAT|")==1){
        while(ri<=tin.len){
            let eol:i64=0;
            if(ri==tin.len){eol=1;}
            if(eol==0){if(tin[ri]==59){eol=1;}}
            if(eol==1){
                if(ri>rs){
                    if(first==0){o_raw(o,";");}
                    first=0;
                    sim_format(spec,tin[rs..ri],o);
                }
                rs=ri+1;
            }
            ri=ri+1;
        }
        return;
    }
    return;
}

// top-ranked KB op / id for a DESC (unquarantined; used for root-cause naming)
fn kb_top_op(desc:[]u8, kb:[]u8)[]u8 {
    let bop:[]u8="";
    let bs:i64=-1;
    let ne:i64=kb_nentries(kb);
    let ei:i64=0;
    while(ei<ne){
        let ent:[]u8=kb_entry(kb,ei);
        let op:[]u8=kb_e_op(ent);
        let cat:[]u8=kb_e_cat(ent);
        if(op.len>0){
            if(cat.len>0){
                let sc:i64=op_score(desc,kb_e_keys(ent));
                if(sc>bs){bop=op;bs=sc;}
            }
        }
        ei=ei+1;
    }
    return bop;
}

fn kb_top_id(desc:[]u8, kb:[]u8)[]u8 {
    let bid:[]u8="";
    let bs:i64=-1;
    let ne:i64=kb_nentries(kb);
    let ei:i64=0;
    while(ei<ne){
        let ent:[]u8=kb_entry(kb,ei);
        let op:[]u8=kb_e_op(ent);
        let cat:[]u8=kb_e_cat(ent);
        if(op.len>0){
            if(cat.len>0){
                let sc:i64=op_score(desc,kb_e_keys(ent));
                if(sc>bs){bid=kb_e_id(ent);bs=sc;}
            }
        }
        ei=ei+1;
    }
    return bid;
}

fn do_diagnose(out:*Out, stage:[]u8, contract:[]u8, kb_used:[]u8, quarantine:[]u8, spec:[]u8, evidence:[]u8, upinfo:[]u8)void {
    let desc:[]u8=c_desc(contract);
    let dh:i64=fnv(desc);
    o_raw(out,"DIAGNOSIS ");
    o_raw(out,stage);
    o_raw(out," SPEC:");
    o_i64(out,fnv(spec));
    o_raw(out," EVIDENCE:");
    o_raw(out,evidence);
    o_line(out);
    // classify the evidence
    let cause:[]u8="UNKNOWN";
    if(s_has(evidence,"HALT KB-CORRUPT")==1){cause="KB-CORRUPT";}
    if(s_has(evidence,"HALT PARAM-MISS")==1){cause="PARAM-MISS";}
    if(s_has(evidence,"OUTPUT-MISMATCH")==1){cause="OUTPUT-MISMATCH";}
    if(s_has(evidence,"UPSTREAM-EMPTY")==1){cause="DEP-CORRUPT";}
    if(s_has(evidence,"DEP-CORRUPT")==1){cause="DEP-CORRUPT";}
    if(s_has(evidence,"HALT NO-ACCEPT")==1){cause="NO-ACCEPT";}
    if(s_has(evidence,"HALT KB-MISS")==1){cause="KB-MISS";}
    o_raw(out,"EP ");
    o_raw(out,stage);
    o_raw(out,"-D1 DIAGNOSER diagnose CITES:evidence CAUSE ");
    o_raw(out,cause);
    o_raw(out," IN:");
    o_i64(out,dh);
    o_line(out);
    if(s_eq(cause,"KB-CORRUPT")==1){
        // extract the corrupt entry ID from the evidence
        let cpos:i64=s_find(evidence,"ADV-OP|",0);
        let cid:[]u8="";
        if(cpos>=0){
            let ce:i64=cpos;
            while(ce<evidence.len){
                if(evidence[ce]==32){break;}
                if(evidence[ce]==10){break;}
                ce=ce+1;
            }
            cid=evidence[cpos..ce];
        }
        // verify the ID exists in the in-force KB and is genuinely corrupt
        let ent:[]u8=kb_has_id(kb_used,cid);
        let genuine:i64=0;
        if(ent.len>0){
            let opnm:[]u8=cline(ent,"OP: ",4);
            let idl:[]u8=cline(ent,"ID: ",4);
            let b1:i64=s_find(idl,"|",0);
            let b2:i64=-1;
            if(b1>=0){b2=s_find(idl,"|",b1+1);}
            if(b2>=0){
                if(s_eq(idl[b2+1..idl.len],opnm)==0){genuine=1;}
            }
            if(s_has(idl,"[SECURITY_DATA]")==1){genuine=1;}
        }
        if(genuine==1){
            o_raw(out,"EP ");
            o_raw(out,stage);
            o_raw(out,"-D2 DIAGNOSER diagnose CITES:");
            o_raw(out,cid);
            o_raw(out," VERIFIED genuine-kb-corruption");
            o_line(out);
            o_raw(out,"ACTION REGEN ");
            o_raw(out,stage);
            o_raw(out," ADD-QUARANTINE ");
            o_raw(out,cid);
            o_line(out);
            return;
        }
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-D2 DIAGNOSER diagnose CITES:evidence REJECT corrupt-id-not-in-force-kb");
        o_line(out);
        o_raw(out,"ACTION REVISED ");
        o_raw(out,stage);
        o_raw(out," RETRY-WITH-INFORCE-KB");
        o_line(out);
        return;
    }
    if(s_eq(cause,"DEP-CORRUPT")==1){
        // upstream data missing/corrupt: diagnose from upinfo; cannot invent data
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-D2 DIAGNOSER diagnose CITES:upinfo ");
        o_raw(out,upinfo);
        o_line(out);
        // if upstream has a re-emit capability, the strategy is to wait for upstream fix;
        // the invented recovery: rerun THIS stage unchanged after upstream healed (REGEN).
        o_raw(out,"ACTION REGEN ");
        o_raw(out,stage);
        o_raw(out," AWAIT-UPSTREAM");
        o_line(out);
        return;
    }
    if(s_eq(cause,"NO-ACCEPT")==1){
        // all candidates failed critique: propose the top-scoring op that was NOT proposed
        // (proposal admitted up to 2; a third-ranked op may still be correct).
        // The invented strategy: quarantine the accepted-mismatch ops is wrong;
        // instead loosen: request the proposer to emit the NEXT-ranked candidate.
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-D2 DIAGNOSER diagnose CITES:evidence REJECT all-top-candidates-fail");
        o_line(out);
        o_raw(out,"ACTION REGEN ");
        o_raw(out,stage);
        o_raw(out," PROPOSE-NEXT-RANK");
        o_line(out);
        return;
    }
    if(s_eq(cause,"KB-MISS")==1){
        // no candidates after quarantine: if the quarantine holds the only
        // viable op, this is UNRECOVERABLE. The driver passes
        // evidence="HALT KB-MISS quarantine=<id>"; the halt names the entry.
        let qid:[]u8=spec_kv(evidence,"quarantine=");
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-D3 DIAGNOSER diagnose CITES:quarantine KB:exhausted");
        o_line(out);
        o_raw(out,"HALT UNRECOVERABLE ");
        if(qid.len>0){
            o_raw(out,qid);
        } else {
            o_raw(out,"unknown-entry");
        }
        o_line(out);
        return;
    }
    if(s_eq(cause,"OUTPUT-MISMATCH")==1){
        // HARDENED LH-ADV-2 root-cause inference. NO true-upstream hint is
        // passed in evidence: only symptoms (expected/observed/actual_input/
        // spec). The diagnoser must INFER the cause:
        //   1. re-simulate the spec on the frozen contract TESTs;
        //   2a. re-sim passes -> simulate the spec on the ACTUAL live input:
        //       sim==observed  -> emitter compiled correctly, the live input
        //                         itself is wrong -> infer UPSTREAM by reading
        //                         the stage's own declared DEPS;
        //       sim!=observed  -> emitter diverged on identical input
        //                         -> LOCAL emitter fault (EMITTER-BUG);
        //   2b. re-sim fails  -> compare spec op against KB top-ranked op:
        //       different -> KB root-cause (name the KB entry);
        //       same      -> LOCAL spec fault (right op, wrong params).
        let obs:[]u8=ev_key(evidence,"observed=","actual_input=");
        let ain:[]u8=ev_key(evidence,"actual_input=","spec=");
        let nt:i64=c_ntests(contract);
        let simok:i64=1;
        let ti:i64=0;
        while(ti<nt){
            let tin:[]u8=c_testin(contract,ti);
            let tout:[]u8=c_testout(contract,ti);
            let got:Out=out_new(16384);
            let gp:*Out=&got;
            sim_all2(spec,tin,gp);
            let gs:[]u8=got.b[0..got.n];
            if(s_eq(gs,tout)==0){simok=0;}
            ti=ti+1;
        }
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-D2 DIAGNOSER diagnose CITES:evidence re-sim=");
        if(simok==1){o_raw(out,"pass");} else {o_raw(out,"fail");}
        if(simok==1){
            let g2:Out=out_new(16384);
            let gp2:*Out=&g2;
            sim_all2(spec,ain,gp2);
            let gs2:[]u8=g2.b[0..g2.n];
            if(s_eq(gs2,obs)==1){
                // input-substitution match: the fault arrived with the input
                let deps:[]u8=c_deps(contract);
                o_raw(out," input-substitution=match deps=");
                o_raw(out,deps);
                o_line(out);
                let ndep:i64=0;
                let ci:i64=0;
                while(ci<deps.len){
                    if(deps[ci]==44){ndep=ndep+1;}
                    ci=ci+1;
                }
                if(deps.len>0){ndep=ndep+1;}
                if(ndep==1){
                    o_raw(out,"ROOT-CAUSE UPSTREAM ");
                    o_raw(out,deps);
                    o_line(out);
                    o_raw(out,"ACTION REGEN ");
                    o_raw(out,stage);
                    o_raw(out," AWAIT-UPSTREAM ");
                    o_raw(out,deps);
                    o_line(out);
                    return;
                }
                o_raw(out,"ROOT-CAUSE UPSTREAM-AMBIGUOUS ");
                o_raw(out,deps);
                o_line(out);
                o_raw(out,"ACTION HALT AMBIGUOUS-UPSTREAM ");
                o_raw(out,stage);
                o_line(out);
                return;
            }
            o_raw(out," input-substitution=diverge");
            o_line(out);
            o_raw(out,"ROOT-CAUSE LOCAL ");
            o_raw(out,stage);
            o_line(out);
            o_raw(out,"ACTION HALT EMITTER-BUG ");
            o_raw(out,stage);
            o_line(out);
            return;
        }
        // re-sim failed: the spec itself is wrong; name KB root-cause vs local
        let desc:[]u8=c_desc(contract);
        let topid:[]u8=kb_top_id(desc,kb_used);
        let topop:[]u8=kb_top_op(desc,kb_used);
        let specop:[]u8=spec_kv(spec,"op=");
        o_raw(out," kb-top=");
        o_raw(out,topid);
        o_line(out);
        if(s_eq(topop,specop)==0){
            o_raw(out,"ROOT-CAUSE KB ");
            o_raw(out,topid);
            o_line(out);
            o_raw(out,"ACTION REGEN ");
            o_raw(out,stage);
            o_raw(out," PROPOSE-NEXT-RANK");
            o_line(out);
            return;
        }
        o_raw(out,"ROOT-CAUSE LOCAL ");
        o_raw(out,stage);
        o_line(out);
        o_raw(out,"ACTION REGEN ");
        o_raw(out,stage);
        o_raw(out," PROPOSE-NEXT-RANK");
        o_line(out);
        return;
    }
    // unknown cause: honest halt, name it
    o_raw(out,"HALT UNRECOVERABLE ");
    o_raw(out,cause);
    o_raw(out," ");
    o_raw(out,stage);
    o_line(out);
    return;
}

fn main()void {
    let mode:[]u8=_zag_arg(1);
    let o:Out=out_new(131072);
    let op:*Out=&o;
    if(s_eq(mode,"propose")==1){
        let stage:[]u8=_zag_arg(2);
        let contract:[]u8=_zag_arg(3);
        let kb:[]u8=_zag_arg(4);
        let quar:[]u8=_zag_arg(5);
        do_propose(op,stage,contract,kb,quar);
    } else {
        if(s_eq(mode,"critique")==1){
            let stage2:[]u8=_zag_arg(2);
            let contract2:[]u8=_zag_arg(3);
            let cands:[]u8=_zag_arg(4);
            do_critique(op,stage2,contract2,cands);
        } else {
            if(s_eq(mode,"compose")==1){
                let stage3:[]u8=_zag_arg(2);
                let spec3:[]u8=_zag_arg(3);
                let cep:[]u8=_zag_arg(4);
                do_compose(op,stage3,spec3,cep);
            } else {
                if(s_eq(mode,"diagnose")==1){
                    let st:[]u8=_zag_arg(2);
                    let ct:[]u8=_zag_arg(3);
                    let kbu:[]u8=_zag_arg(4);
                    let qu:[]u8=_zag_arg(5);
                    let sp:[]u8=_zag_arg(6);
                    let ev:[]u8=_zag_arg(7);
                    let ui:[]u8=_zag_arg(8);
                    do_diagnose(op,st,ct,kbu,qu,sp,ev,ui);
                } else {
                    o_raw(op,"UNKNOWN_MODE\n");
                }
            }
        }
    }
    _zag_print(o.b[0..o.n]);
    return;
}

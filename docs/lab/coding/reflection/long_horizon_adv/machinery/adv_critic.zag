// adv_critic.zag — LH-ADV-2026-09-22 independent critic.
// Authored from contracts + KB only. Never saw adv_emit.zag source.
// Verifies a FINAL spec by independently simulating it and comparing
// against BOTH the contract TEST out= and the emitter binary's output.
// Usage: adv_critic verify <stage> <contract> <spec> <binout>
//   binout: binary's stdout for TEST1 in= (chain test), ;-separated.
// Prints CRITIC-ACCEPT or CRITIC-REJECT <reason>.
// ALLOWLIST (shared parser helpers): s_eq s_find s_has spec_kv num_val
//   line_get line_count sw c_* d_field_count d_field_get i64s

fn s_eq(a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn s_find(hay:[]u8, needle:[]u8, from:i64)i64 {
    if(needle.len==0){return from;}
    if(needle.len>hay.len){return -1;}
    let i:i64=from;
    while(i+needle.len<=hay.len){
        let j:i64=0;
        let ok:i64=1;
        while(j<needle.len){
            if(hay[i+j]!=needle[j]){ok=0;}
            j=j+1;
        }
        if(ok==1){return i;}
        i=i+1;
    }
    return -1;
}

fn s_has(hay:[]u8, needle:[]u8)i64 {
    if(s_find(hay,needle,0)>=0){return 1;}
    return 0;
}

fn spec_kv(spec:[]u8, key:[]u8)[]u8 {
    let pos:i64=s_find(spec,key,0);
    if(pos<0){let e:[]u8="";return e;}
    let vs:i64=pos+key.len;
    if(vs>=spec.len){let e2:[]u8="";return e2;}
    let ve:i64=vs;
    while(ve<spec.len){
        if(spec[ve]==124){break;}
        ve=ve+1;
    }
    return spec[vs..ve];
}

fn num_val(s:[]u8)i64 {
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    let v:i64=0;
    while(i<s.len){
        if(s[i]>=48){if(s[i]<=57){v=v*10+((s[i] as i64)-48);}}
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){if(s[s.len-1]==10){return s[0..s.len-1];}}
    return s;
}

fn line_get(t:[]u8, k:i64)[]u8 {
    let ln:i64=0;
    let s:i64=0;
    let i:i64=0;
    while(i<t.len){
        if(t[i]==10){
            if(ln==k){return t[s..i];}
            ln=ln+1;
            s=i+1;
        }
        i=i+1;
    }
    if(ln==k){return t[s..t.len];}
    let e:[]u8="";
    return e;
}

fn line_count(t:[]u8)i64 {
    let c:i64=0;
    let i:i64=0;
    while(i<t.len){
        if(t[i]==10){c=c+1;}
        i=i+1;
    }
    if(t.len>0){if(t[t.len-1]!=10){c=c+1;}}
    return c;
}

fn sw(s:[]u8, pre:[]u8)i64 {
    if(s.len<pre.len){return 0;}
    let i:i64=0;
    while(i<pre.len){
        if(s[i]!=pre[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn cline(c:[]u8, pre:[]u8, off:i64)[]u8 {
    let n:i64=line_count(c);
    let i:i64=0;
    while(i<n){
        let l:[]u8=line_get(c,i);
        if(sw(l,pre)==1){return l[off..l.len];}
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn c_testin(contract:[]u8, k:i64)[]u8 {
    let n:i64=line_count(contract);
    let i:i64=0;
    let t:i64=0;
    while(i<n){
        let l:[]u8=line_get(contract,i);
        if(sw(l,"TEST in=")==1){
            if(t==k){return l[8..l.len];}
            t=t+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn c_testout(contract:[]u8, k:i64)[]u8 {
    let n:i64=line_count(contract);
    let i:i64=0;
    let t:i64=0;
    while(i<n){
        let l:[]u8=line_get(contract,i);
        if(sw(l,"TEST out=")==1){
            if(t==k){return l[9..l.len];}
            t=t+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn c_ntests(contract:[]u8)i64 {
    let n:i64=line_count(contract);
    let i:i64=0;
    let t:i64=0;
    while(i<n){
        let l:[]u8=line_get(contract,i);
        if(sw(l,"TEST in=")==1){t=t+1;}
        i=i+1;
    }
    return t;
}

// record utilities (allowlisted)
fn d_field_count(rec:[]u8)i64 {
    if(rec.len==0){return 0;}
    let c:i64=1;
    let i:i64=0;
    while(i<rec.len){if(rec[i]==124){c=c+1;}i=i+1;}
    return c;
}

fn d_field_get(rec:[]u8, k:i64)[]u8 {
    let n:i64=1;
    let s:i64=0;
    let i:i64=0;
    while(i<=rec.len){
        let e:i64=0;
        if(i==rec.len){e=1;}
        if(e==0){if(rec[i]==124){e=1;}}
        if(e==1){if(n==k){return rec[s..i];}n=n+1;s=i+1;}
        i=i+1;
    }
    let e2:[]u8="";
    return e2;
}

// ---- independent op implementations (fresh code, not copied) ----
struct CB {
    b:[]u8,
    n:i64,
}

fn cb_new(sz:i64)CB {
    let o:CB=CB{};
    let p:*u8=_zag_malloc(sz) as *u8;
    o.b=p[0..sz];
    o.n=0;
    return o;
}

fn cb_raw(o:*CB, s:[]u8)void {
    let b:[]u8=o.*.b;
    let n:i64=o.*.n;
    let i:i64=0;
    while(i<s.len){
        b[n]=s[i];
        n=n+1;
        i=i+1;
    }
    o.*.n=n;
    return;
}

fn cb_i64(o:*CB, v:i64)void {
    cb_raw(o,i64s(v));
    return;
}

// ck_apply_field: FIELD ops on single record
fn ck_apply_field(op:[]u8, p1:i64, p2:i64, p3:i64, rec:[]u8, o:*CB)void {
    if(s_eq(op,"upper")==1){
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            let fd:[]u8=d_field_get(rec,k);
            if(k==p1){
                let j:i64=0;
                while(j<fd.len){
                    let ch:u8=fd[j];
                    if(ch>=97){if(ch<=122){ch=ch-32;}}
                    let b:[]u8=o.*.b;
                    b[o.*.n]=ch;
                    o.*.n=o.*.n+1;
                    j=j+1;
                }
            } else {
                cb_raw(o,fd);
            }
            if(k<n){cb_raw(o,"|");}
            k=k+1;
        }
        return;
    }
    if(s_eq(op,"lower")==1){
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            let fd:[]u8=d_field_get(rec,k);
            if(k==p1){
                let j:i64=0;
                while(j<fd.len){
                    let ch:u8=fd[j];
                    if(ch>=65){if(ch<=90){ch=ch+32;}}
                    let b:[]u8=o.*.b;
                    b[o.*.n]=ch;
                    o.*.n=o.*.n+1;
                    j=j+1;
                }
            } else {
                cb_raw(o,fd);
            }
            if(k<n){cb_raw(o,"|");}
            k=k+1;
        }
        return;
    }
    if(s_eq(op,"clamp")==1){
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            if(k==p1){
                let v:i64=num_val(d_field_get(rec,k));
                if(v<p2){v=p2;}
                if(v>p3){v=p3;}
                cb_i64(o,v);
            } else {
                cb_raw(o,d_field_get(rec,k));
            }
            if(k<n){cb_raw(o,"|");}
            k=k+1;
        }
        return;
    }
    if(s_eq(op,"mul_fields")==1){
        cb_raw(o,rec);
        cb_raw(o,"|");
        let a:i64=num_val(d_field_get(rec,p1));
        let b:i64=num_val(d_field_get(rec,p2));
        cb_i64(o,a*b);
        return;
    }
    if(s_eq(op,"substr")==1){
        cb_raw(o,rec);
        cb_raw(o,"|");
        let fd:[]u8=d_field_get(rec,p1);
        let st:i64=p2;
        let ln:i64=p3;
        if(st<0){st=0;}
        if(st>fd.len){st=fd.len;}
        if(st+ln>fd.len){ln=fd.len-st;}
        if(ln<0){ln=0;}
        cb_raw(o,fd[st..st+ln]);
        return;
    }
    return;
}

// ck_test_filter: FILTER ops, 1=keep
fn ck_test_filter(op:[]u8, p1:i64, p2:i64, setv:[]u8, rec:[]u8)i64 {
    if(s_eq(op,"int_gt")==1){
        if(num_val(d_field_get(rec,p1))>p2){return 1;}
        return 0;
    }
    if(s_eq(op,"int_lt")==1){
        if(num_val(d_field_get(rec,p1))<p2){return 1;}
        return 0;
    }
    if(s_eq(op,"int_ge")==1){
        if(num_val(d_field_get(rec,p1))>=p2){return 1;}
        return 0;
    }
    if(s_eq(op,"in_set")==1){
        let fd:[]u8=d_field_get(rec,p1);
        let i:i64=0;
        let vs:i64=0;
        while(i<=setv.len){
            let e:i64=0;
            if(i==setv.len){e=1;}
            if(e==0){if(setv[i]==44){e=1;}}
            if(e==1){
                if(i>vs){
                    if(s_eq(fd,setv[vs..i])==1){return 1;}
                }
                vs=i+1;
            }
            i=i+1;
        }
        return 0;
    }
    if(s_eq(op,"field_count_eq")==1){
        if(d_field_count(rec)==p1){return 1;}
        return 0;
    }
    return 0;
}

// ck_agg: AGG ops on ;-separated inputs
fn ck_agg(op:[]u8, key:i64, val:i64, inputs:[]u8, o:*CB)void {
    // group keys in order; store in parallel arrays
    let kp:*u8=_zag_malloc(16384) as *u8;
    let ka:[]u8=kp[0..16384];
    let kn:i64=0;
    let kk:Out2=out2_new(4096);
    let vv:Out2=out2_new(4096);
    let cc:Out2=out2_new(4096);
    // we use simple linear scan with fixed 64-byte key slots
    let i:i64=0;
    let rs:i64=0;
    while(i<=inputs.len){
        let eol:i64=0;
        if(i==inputs.len){eol=1;}
        if(eol==0){if(inputs[i]==59){eol=1;}}
        if(eol==1){
            if(i>rs){
                let rec:[]u8=inputs[rs..i];
                let ky:[]u8=d_field_get(rec,key);
                let v:i64=0;
                if(val>0){v=num_val(d_field_get(rec,val));}
                // find group
                let g:i64=-1;
                let q:i64=0;
                while(q<kn){
                    let off:i64=q*64;
                    let kl:i64=out2_get(kk,q);
                    if(kl==ky.len){
                        let m:i64=1;
                        let r:i64=0;
                        while(r<kl){
                            if(ka[off+r]!=ky[r]){m=0;}
                            r=r+1;
                        }
                        if(m==1){g=q;}
                    }
                    q=q+1;
                }
                if(g<0){
                    let off:i64=kn*64;
                    let r:i64=0;
                    while(r<ky.len){
                        ka[off+r]=ky[r];
                        r=r+1;
                    }
                    out2_put(kk,kn,ky.len);
                    out2_put(vv,kn,v);
                    out2_put(cc,kn,1);
                    kn=kn+1;
                } else {
                    let cur:i64=out2_get(vv,g);
                    if(s_eq(op,"sum")==1){out2_set(vv,g,cur+v);}
                    if(s_eq(op,"avg")==1){out2_set(vv,g,cur+v);}
                    if(s_eq(op,"min")==1){if(v<cur){out2_set(vv,g,v);}}
                    if(s_eq(op,"max")==1){if(v>cur){out2_set(vv,g,v);}}
                    out2_set(cc,g,out2_get(cc,g)+1);
                }
            }
            rs=i+1;
        }
        i=i+1;
    }
    let g:i64=0;
    while(g<kn){
        let off:i64=g*64;
        let kl:i64=out2_get(kk,g);
        cb_raw(o,ka[off..off+kl]);
        cb_raw(o,"|");
        if(s_eq(op,"count")==1){
            cb_i64(o,out2_get(cc,g));
        } else {
            if(s_eq(op,"avg")==1){
                cb_i64(o,out2_get(vv,g)/out2_get(cc,g));
                cb_raw(o,"|");
                cb_i64(o,out2_get(cc,g));
            } else {
                cb_i64(o,out2_get(vv,g));
                cb_raw(o,"|");
                cb_i64(o,out2_get(cc,g));
            }
        }
        if(g+1<kn){cb_raw(o,";");}
        g=g+1;
    }
    return;
}

struct Out2 {
    b:[]u8,
    n:i64,
}

fn out2_new(sz:i64)Out2 {
    let o:Out2=Out2{};
    let p:*u8=_zag_malloc(sz) as *u8;
    o.b=p[0..sz];
    o.n=0;
    return o;
}

fn out2_put(o:Out2, idx:i64, v:i64)void {
    let b:[]u8=o.b;
    let p:i64=idx*8;
    let k:i64=0;
    let x:i64=v;
    while(k<8){
        b[p+k]=(x as u8);
        x=x/256;
        k=k+1;
    }
    return;
}

fn out2_get(o:Out2, idx:i64)i64 {
    let b:[]u8=o.b;
    let p:i64=idx*8;
    let v:i64=0;
    let k:i64=7;
    while(k>=0){
        v=v*256+(b[p+k] as i64);
        k=k-1;
    }
    return v;
}

fn out2_set(o:Out2, idx:i64, v:i64)void {
    out2_put(o,idx,v);
    return;
}

// ck_sort: SORT ops on ;-separated inputs
fn ck_sort(op:[]u8, field:i64, take:i64, inputs:[]u8, o:*CB)void {
    let ap:*u8=_zag_malloc(8192) as *u8;
    let aa:[]u8=ap[0..8192];
    let ip:*u8=_zag_malloc(8192) as *u8;
    let ia:[]u8=ip[0..8192];
    // aa: keys as i64 (8 bytes each), ia: original indices as i64
    let cnt:i64=0;
    let i:i64=0;
    let rs:i64=0;
    while(i<=inputs.len){
        let eol:i64=0;
        if(i==inputs.len){eol=1;}
        if(eol==0){if(inputs[i]==59){eol=1;}}
        if(eol==1){
            if(i>rs){
                let rec:[]u8=inputs[rs..i];
                let v:i64=num_val(d_field_get(rec,field));
                let p:i64=cnt*8;
                let k:i64=0;
                let x:i64=v;
                while(k<8){
                    aa[p+k]=(x as u8);
                    x=x/256;
                    k=k+1;
                }
                let p2:i64=cnt*8;
                let k2:i64=0;
                let x2:i64=cnt;
                while(k2<8){
                    ia[p2+k2]=(x2 as u8);
                    x2=x2/256;
                    k2=k2+1;
                }
                cnt=cnt+1;
            }
            rs=i+1;
        }
        i=i+1;
    }
    // bubble sort indices by key
    let desc:i64=0;
    if(s_eq(op,"sort_desc")==1){desc=1;}
    if(s_eq(op,"topn")==1){desc=1;}
    let p:i64=0;
    while(p<cnt){
        let q:i64=0;
        while(q+1<cnt-p){
            let va:i64=ck_g64(aa,ck_g64(ia,q));
            let vb:i64=ck_g64(aa,ck_g64(ia,q+1));
            let swp:i64=0;
            if(desc==1){
                if(va<vb){swp=1;}
            } else {
                if(va>vb){swp=1;}
            }
            if(swp==1){
                let ta:i64=ck_g64(ia,q);
                ck_s64(ia,q,ck_g64(ia,q+1));
                ck_s64(ia,q+1,ta);
            }
            q=q+1;
        }
        p=p+1;
    }
    let lim:i64=cnt;
    if(take>0){
        if(take<lim){lim=take;}
    }
    let w:i64=0;
    while(w<lim){
        let want:i64=ck_g64(ia,w);
        // find want-th record
        let i2:i64=0;
        let rs2:i64=0;
        let cur:i64=0;
        while(i2<=inputs.len){
            let eol2:i64=0;
            if(i2==inputs.len){eol2=1;}
            if(eol2==0){if(inputs[i2]==59){eol2=1;}}
            if(eol2==1){
                if(i2>rs2){
                    if(cur==want){
                        cb_raw(o,inputs[rs2..i2]);
                    }
                    cur=cur+1;
                }
                rs2=i2+1;
            }
            i2=i2+1;
        }
        if(w+1<lim){cb_raw(o,";");}
        w=w+1;
    }
    return;
}

fn ck_g64(a:[]u8, idx:i64)i64 {
    let p:i64=idx*8;
    let v:i64=0;
    let k:i64=7;
    while(k>=0){
        v=v*256+(a[p+k] as i64);
        k=k-1;
    }
    return v;
}

fn ck_s64(a:[]u8, idx:i64, v:i64)void {
    let p:i64=idx*8;
    let k:i64=0;
    let x:i64=v;
    while(k<8){
        a[p+k]=(x as u8);
        x=x/256;
        k=k+1;
    }
    return;
}

// ck_join: JOIN ops on "lefts||rights"
fn ck_join(op:[]u8, lk:i64, rk:i64, rf:i64, inputs:[]u8, o:*CB)void {
    let sep:i64=s_find(inputs,"||",0);
    let ls:[]u8="";
    let rs:[]u8="";
    if(sep>=0){
        ls=inputs[0..sep];
        rs=inputs[sep+2..inputs.len];
    } else {
        ls=inputs;
    }
    // count records
    let nl:i64=ck_cnt_recs(ls);
    let nr:i64=ck_cnt_recs(rs);
    let first:i64=1;
    let li:i64=0;
    while(li<nl){
        let lrec:[]u8=ck_nth_rec(ls,li);
        let lkey:[]u8=d_field_get(lrec,lk);
        if(s_eq(op,"cross_join")==1){
            let ri:i64=0;
            while(ri<nr){
                let rrec:[]u8=ck_nth_rec(rs,ri);
                if(first==0){cb_raw(o,";");}
                first=0;
                cb_raw(o,lrec);
                cb_raw(o,"|");
                cb_raw(o,rrec);
                ri=ri+1;
            }
        } else {
            let matched:i64=0;
            let ri:i64=0;
            while(ri<nr){
                let rrec:[]u8=ck_nth_rec(rs,ri);
                if(s_eq(lkey,d_field_get(rrec,rk))==1){
                    matched=1;
                    if(first==0){cb_raw(o,";");}
                    first=0;
                    cb_raw(o,lrec);
                    cb_raw(o,"|");
                    cb_raw(o,rrec);
                }
                ri=ri+1;
            }
            if(s_eq(op,"left_join")==1){
                if(matched==0){
                    if(first==0){cb_raw(o,";");}
                    first=0;
                    cb_raw(o,lrec);
                    let z:i64=0;
                    while(z<rf){
                        cb_raw(o,"|");
                        z=z+1;
                    }
                }
            }
        }
        li=li+1;
    }
    return;
}

fn ck_cnt_recs(s:[]u8)i64 {
    if(s.len==0){return 0;}
    let c:i64=1;
    let i:i64=0;
    while(i<s.len){
        if(s[i]==59){c=c+1;}
        i=i+1;
    }
    return c;
}

fn ck_nth_rec(s:[]u8, n:i64)[]u8 {
    let cur:i64=0;
    let st:i64=0;
    let i:i64=0;
    while(i<=s.len){
        let eol:i64=0;
        if(i==s.len){eol=1;}
        if(eol==0){if(s[i]==59){eol=1;}}
        if(eol==1){
            if(cur==n){return s[st..i];}
            cur=cur+1;
            st=i+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

// ck_format: FORMAT ops on single record
fn ck_format(op:[]u8, tmpl:[]u8, wnames:[]u8, rec:[]u8, o:*CB)void {
    if(s_eq(op,"template")==1){
        let i:i64=0;
        while(i<tmpl.len){
            if(tmpl[i]==123){
                let j:i64=s_find(tmpl,"}",i);
                if(j>i){
                    let kn:i64=num_val(tmpl[i+1..j]);
                    cb_raw(o,d_field_get(rec,kn));
                    i=j+1;
                } else {
                    cb_raw(o,tmpl[i..i+1]);
                    i=i+1;
                }
            } else {
                cb_raw(o,tmpl[i..i+1]);
                i=i+1;
            }
        }
        return;
    }
    if(s_eq(op,"csv_line")==1){
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            if(k>1){cb_raw(o,",");}
            cb_raw(o,d_field_get(rec,k));
            k=k+1;
        }
        return;
    }
    if(s_eq(op,"kv_line")==1){
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            if(k>1){cb_raw(o,"|");}
            cb_raw(o,ck_wnth(wnames,k));
            cb_raw(o,"=");
            cb_raw(o,d_field_get(rec,k));
            k=k+1;
        }
        return;
    }
    return;
}

fn ck_wnth(wnames:[]u8, k:i64)[]u8 {
    let cur:i64=1;
    let st:i64=0;
    let i:i64=0;
    while(i<=wnames.len){
        let eol:i64=0;
        if(i==wnames.len){eol=1;}
        if(eol==0){if(wnames[i]==44){eol=1;}}
        if(eol==1){
            if(cur==k){return wnames[st..i];}
            cur=cur+1;
            st=i+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

// verify: simulate spec on TEST1, compare to contract out= AND binary out=
fn do_verify(o:*CB, stage:[]u8, contract:[]u8, spec:[]u8, binout:[]u8)void {
    let tin:[]u8=c_testin(contract,0);
    let tout:[]u8=c_testout(contract,0);
    let op:[]u8=spec_kv(spec,"op=");
    let sim:CB=cb_new(32768);
    let sp:*CB=&sim;
    if(s_has(spec,"ADV|FIELD|")==1){
        let nrec:i64=ck_cnt_recs(tin);
        let r:i64=0;
        while(r<nrec){
            if(r>0){cb_raw(sp,";");}
            let rec:[]u8=ck_nth_rec(tin,r);
            if(s_eq(op,"upper")==1){ck_apply_field(op,num_val(spec_kv(spec,"field=")),0,0,rec,sp);}
            if(s_eq(op,"lower")==1){ck_apply_field(op,num_val(spec_kv(spec,"field=")),0,0,rec,sp);}
            if(s_eq(op,"clamp")==1){ck_apply_field(op,num_val(spec_kv(spec,"field=")),num_val(spec_kv(spec,"lo=")),num_val(spec_kv(spec,"hi=")),rec,sp);}
            if(s_eq(op,"mul_fields")==1){ck_apply_field(op,num_val(spec_kv(spec,"fa=")),num_val(spec_kv(spec,"fb=")),0,rec,sp);}
            if(s_eq(op,"substr")==1){ck_apply_field(op,num_val(spec_kv(spec,"field=")),num_val(spec_kv(spec,"s=")),num_val(spec_kv(spec,"l=")),rec,sp);}
            r=r+1;
        }
    } else {
        if(s_has(spec,"ADV|FILTER|")==1){
            let nrec:i64=ck_cnt_recs(tin);
            let r:i64=0;
            let first:i64=1;
            while(r<nrec){
                let rec:[]u8=ck_nth_rec(tin,r);
                let keep:i64=0;
                if(s_eq(op,"field_count_eq")==1){keep=ck_test_filter(op,num_val(spec_kv(spec,"n=")),0,"",rec);}
                else {keep=ck_test_filter(op,num_val(spec_kv(spec,"field=")),num_val(spec_kv(spec,"threshold=")),spec_kv(spec,"set="),rec);}
                if(keep==1){
                    if(first==0){cb_raw(sp,";");}
                    first=0;
                    cb_raw(sp,rec);
                }
                r=r+1;
            }
        } else {
            if(s_has(spec,"ADV|AGG|")==1){
                ck_agg(op,num_val(spec_kv(spec,"key=")),num_val(spec_kv(spec,"val=")),tin,sp);
            } else {
                if(s_has(spec,"ADV|SORT|")==1){
                    ck_sort(op,num_val(spec_kv(spec,"field=")),num_val(spec_kv(spec,"take=")),tin,sp);
                } else {
                    if(s_has(spec,"ADV|JOIN|")==1){
                        ck_join(op,num_val(spec_kv(spec,"key=")),num_val(spec_kv(spec,"key2=")),num_val(spec_kv(spec,"rfields=")),tin,sp);
                    } else {
                        if(s_has(spec,"ADV|FORMAT|")==1){
                            let nrec:i64=ck_cnt_recs(tin);
                            let r:i64=0;
                            while(r<nrec){
                                if(r>0){cb_raw(sp,";");}
                                ck_format(op,spec_kv(spec,"template="),spec_kv(spec,"win="),ck_nth_rec(tin,r),sp);
                                r=r+1;
                            }
                        }
                    }
                }
            }
        }
    }
    let sims:[]u8=sim.b[0..sim.n];
    if(s_eq(sims,tout)==0){
        cb_raw(o,"CRITIC-REJECT spec-mismatch-contract\n");
        return;
    }
    if(s_eq(binout,tout)==0){
        cb_raw(o,"CRITIC-REJECT binary-mismatch-contract EMITTER-BUG\n");
        return;
    }
    cb_raw(o,"CRITIC-ACCEPT\n");
    return;
}

fn main()void {
    let mode:[]u8=_zag_arg(1);
    let o:CB=cb_new(65536);
    let op:*CB=&o;
    if(s_eq(mode,"verify")==1){
        let stage:[]u8=_zag_arg(2);
        let contract:[]u8=_zag_arg(3);
        let spec:[]u8=_zag_arg(4);
        let binout:[]u8=_zag_arg(5);
        do_verify(op,stage,contract,spec,binout);
    } else {
        cb_raw(op,"UNKNOWN_MODE\n");
    }
    _zag_print(o.b[0..o.n]);
    return;
}

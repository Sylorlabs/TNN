// lh_emit.zag — LH| record-program emitters (generic machinery).
// Pure Zag, zero RNG. Usage: lh_emit gen <spec>
// Prints a complete Zag program on stdout, or UNKNOWN_GOAL / UNTAUGHT:<what>.
// The spec carries ALL content; this file contains no pipeline vocabulary
// (verified by audit_forbidden.py). Reuses proven patterns from
// coding/reflection/loop/learner.zag (s_eq, s_find, spec_kv, num_val, Cx).

fn s_eq(a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn s_find(hay:[]u8, needle:[]u8, from:i64)i64 {
    if(needle.len==0){return from;}
    if(needle.len>hay.len){return -1;}
    let i:i64=from;
    while(i+needle.len<=hay.len){
        let j:i64=0;
        let ok:i64=1;
        while(j<needle.len){
            if(hay[i+j]!=needle[j]){ok=0;}
            j=j+1;
        }
        if(ok==1){return i;}
        i=i+1;
    }
    return -1;
}

fn s_has(hay:[]u8, needle:[]u8)i64 {
    if(s_find(hay,needle,0)>=0){return 1;}
    return 0;
}

fn spec_kv(spec:[]u8, key:[]u8)[]u8 {
    let pos:i64=s_find(spec,key,0);
    if(pos<0){let e:[]u8="";return e;}
    let vs:i64=pos+key.len;
    if(vs>=spec.len){let e2:[]u8="";return e2;}
    let ve:i64=vs;
    while(ve<spec.len){
        if(spec[ve]==124){break;}
        ve=ve+1;
    }
    return spec[vs..ve];
}

fn num_val(s:[]u8)i64 {
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    let v:i64=0;
    while(i<s.len){
        if(s[i]>=48){if(s[i]<=57){v=v*10+((s[i] as i64)-48);}}
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

// ---- output buffer ----
struct Cx {
    b:[]u8,
    n:i64,
}

fn cx_new(sz:i64)Cx {
    let c:Cx=Cx{};
    let p:*u8=_zag_malloc(sz) as *u8;
    c.b=p[0..sz];
    c.n=0;
    return c;
}

fn e_raw(cx:*Cx, s:[]u8)void {
    let b:[]u8=cx.*.b;
    let n:i64=cx.*.n;
    let i:i64=0;
    while(i<s.len){
        b[n]=s[i];
        n=n+1;
        i=i+1;
    }
    cx.*.n=n;
    return;
}

fn e_i64(cx:*Cx, v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    e_raw(cx,s);
    return;
}

// ---- shared emitted helpers (printed into every program) ----
fn em_helpers(cx:*Cx)void {
    e_raw(cx,"fn s_eq(a:[]u8,b:[]u8)i64 {\n");
    e_raw(cx,"if(a.len!=b.len){return 0;}\n");
    e_raw(cx,"let i:i64=0;\n");
    e_raw(cx,"while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}\n");
    e_raw(cx,"return 1;}\n");
    e_raw(cx,"fn parse_i64(s:[]u8)i64 {\n");
    e_raw(cx,"let neg:i64=0;let i:i64=0;\n");
    e_raw(cx,"if(s.len>0){if(s[0]==45){neg=1;i=1;}}\n");
    e_raw(cx,"let v:i64=0;\n");
    e_raw(cx,"while(i<s.len){if(s[i]>=48){if(s[i]<=57){v=v*10+((s[i] as i64)-48);}}i=i+1;}\n");
    e_raw(cx,"if(neg==1){v=0-v;}\n");
    e_raw(cx,"return v;}\n");
    e_raw(cx,"fn i64s(v:i64)[]u8 {\n");
    e_raw(cx,"let s:[]u8=_zag_i64_to_str(v);\n");
    e_raw(cx,"if(s.len>0){if(s[s.len-1]==10){return s[0..s.len-1];}}\n");
    e_raw(cx,"return s;}\n");
    e_raw(cx,"fn field_count(rec:[]u8)i64 {\n");
    e_raw(cx,"if(rec.len==0){return 0;}\n");
    e_raw(cx,"let c:i64=1;let i:i64=0;\n");
    e_raw(cx,"while(i<rec.len){if(rec[i]==124){c=c+1;}i=i+1;}\n");
    e_raw(cx,"return c;}\n");
    e_raw(cx,"fn field_get(rec:[]u8,k:i64)[]u8 {\n");
    e_raw(cx,"let n:i64=1;let s:i64=0;let i:i64=0;\n");
    e_raw(cx,"while(i<=rec.len){\n");
    e_raw(cx,"let e:i64=0;\n");
    e_raw(cx,"if(i==rec.len){e=1;}\n");
    e_raw(cx,"if(e==0){if(rec[i]==124){e=1;}}\n");
    e_raw(cx,"if(e==1){if(n==k){return rec[s..i];}n=n+1;s=i+1;}\n");
    e_raw(cx,"i=i+1;}\n");
    e_raw(cx,"return \"\";}\n");
    return;
}

fn em_upper_f(cx:*Cx)void {
    e_raw(cx,"fn upper_f(s:[]u8)[]u8 {\n");
    e_raw(cx,"let mp:*u8=_zag_malloc(s.len+1) as *u8;\n");
    e_raw(cx,"let o:[]u8=mp[0..s.len];\n");
    e_raw(cx,"let i:i64=0;\n");
    e_raw(cx,"while(i<s.len){let c:u8=s[i];if(c>=97){if(c<=122){c=c-32;}}o[i]=c;i=i+1;}\n");
    e_raw(cx,"return o;}\n");
    return;
}

// ---- LH|FIELD| emitters ----
fn emit_field(cx:*Cx, spec:[]u8)void {
    let op:[]u8=spec_kv(spec,"op=");
    if(s_eq(op,"upper")==1){emit_f_upper(cx,spec);return;}
    if(s_eq(op,"clamp")==1){emit_f_clamp(cx,spec);return;}
    if(s_eq(op,"mul_fields")==1){emit_f_mul(cx,spec);return;}
    if(s_eq(op,"sub_fields")==1){emit_f_sub(cx,spec);return;}
    if(s_eq(op,"firstchar_plus")==1){emit_f_fc(cx,spec);return;}
    if(s_eq(op,"substr")==1){emit_f_substr(cx,spec);return;}
    if(s_eq(op,"format")==1){emit_f_format(cx,spec);return;}
    e_raw(cx,"UNTAUGHT:field-op=");
    e_raw(cx,op);
    e_raw(cx,"\n");
    return;
}

fn emit_f_upper(cx:*Cx, spec:[]u8)void {
    let f:[]u8=spec_kv(spec,"field=");
    if(f.len==0){e_raw(cx,"UNTAUGHT:field\n");return;}
    em_helpers(cx);
    em_upper_f(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(1);\n");
    e_raw(cx,"let n:i64=field_count(rec);\n");
    e_raw(cx,"let k:i64=1;\n");
    e_raw(cx,"while(k<=n){\n");
    e_raw(cx,"let f:[]u8=field_get(rec,k);\n");
    e_raw(cx,"if(k==");
    e_raw(cx,f);
    e_raw(cx,"){f=upper_f(f);}\n");
    e_raw(cx,"_zag_print(f);\n");
    e_raw(cx,"if(k<n){_zag_print(\"|\");}\n");
    e_raw(cx,"k=k+1;}\n");
    e_raw(cx,"_zag_print(\"\n\");\n");
    e_raw(cx,"return;}\n");
    return;
}

fn emit_f_clamp(cx:*Cx, spec:[]u8)void {
    let f:[]u8=spec_kv(spec,"field=");
    let lo:[]u8=spec_kv(spec,"lo=");
    let hi:[]u8=spec_kv(spec,"hi=");
    if(f.len==0){e_raw(cx,"UNTAUGHT:field\n");return;}
    if(lo.len==0){e_raw(cx,"UNTAUGHT:lo\n");return;}
    if(hi.len==0){e_raw(cx,"UNTAUGHT:hi\n");return;}
    em_helpers(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(1);\n");
    e_raw(cx,"let n:i64=field_count(rec);\n");
    e_raw(cx,"let k:i64=1;\n");
    e_raw(cx,"while(k<=n){\n");
    e_raw(cx,"let f:[]u8=field_get(rec,k);\n");
    e_raw(cx,"if(k==");
    e_raw(cx,f);
    e_raw(cx,"){\n");
    e_raw(cx,"let v:i64=parse_i64(f);\n");
    e_raw(cx,"if(v<");
    e_raw(cx,lo);
    e_raw(cx,"){v=");
    e_raw(cx,lo);
    e_raw(cx,";}\n");
    e_raw(cx,"if(v>");
    e_raw(cx,hi);
    e_raw(cx,"){v=");
    e_raw(cx,hi);
    e_raw(cx,";}\n");
    e_raw(cx,"f=i64s(v);}\n");
    e_raw(cx,"_zag_print(f);\n");
    e_raw(cx,"if(k<n){_zag_print(\"|\");}\n");
    e_raw(cx,"k=k+1;}\n");
    e_raw(cx,"_zag_print(\"\n\");\n");
    e_raw(cx,"return;}\n");
    return;
}

// mul_fields / sub_fields: fout = fa (*) fb; appends (fout=n+1 assumed by deliberation)
fn emit_f_binop(cx:*Cx, spec:[]u8, mul:i64)void {
    let fa:[]u8=spec_kv(spec,"fa=");
    let fb:[]u8=spec_kv(spec,"fb=");
    if(fa.len==0){e_raw(cx,"UNTAUGHT:fa\n");return;}
    if(fb.len==0){e_raw(cx,"UNTAUGHT:fb\n");return;}
    em_helpers(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(1);\n");
    e_raw(cx,"let a:i64=parse_i64(field_get(rec,");
    e_raw(cx,fa);
    e_raw(cx,"));\n");
    e_raw(cx,"let b:i64=parse_i64(field_get(rec,");
    e_raw(cx,fb);
    e_raw(cx,"));\n");
    e_raw(cx,"_zag_print(rec);\n");
    e_raw(cx,"_zag_print(\"|\");\n");
    if(mul==1){
        e_raw(cx,"_zag_print(i64s(a*b));\n");
    }
    if(mul==0){
        e_raw(cx,"_zag_print(i64s(a-b));\n");
    }
    e_raw(cx,"_zag_print(\"\n\");\n");
    e_raw(cx,"return;}\n");
    return;
}

fn emit_f_mul(cx:*Cx, spec:[]u8)void {
    emit_f_binop(cx,spec,1);
    return;
}

fn emit_f_sub(cx:*Cx, spec:[]u8)void {
    emit_f_binop(cx,spec,0);
    return;
}

fn emit_f_fc(cx:*Cx, spec:[]u8)void {
    let f:[]u8=spec_kv(spec,"field=");
    let suf:[]u8=spec_kv(spec,"suffix=");
    if(f.len==0){e_raw(cx,"UNTAUGHT:field\n");return;}
    if(suf.len==0){e_raw(cx,"UNTAUGHT:suffix\n");return;}
    em_helpers(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(1);\n");
    e_raw(cx,"let f:[]u8=field_get(rec,");
    e_raw(cx,f);
    e_raw(cx,");\n");
    e_raw(cx,"_zag_print(rec);\n");
    e_raw(cx,"_zag_print(\"|\");\n");
    e_raw(cx,"if(f.len>0){let c:[]u8=f[0..1];_zag_print(c);}\n");
    e_raw(cx,"_zag_print(\"");
    e_raw(cx,suf);
    e_raw(cx,"\");\n");
    e_raw(cx,"_zag_print(\"\n\");\n");
    e_raw(cx,"return;}\n");
    return;
}

fn emit_f_substr(cx:*Cx, spec:[]u8)void {
    let f:[]u8=spec_kv(spec,"field=");
    let s:[]u8=spec_kv(spec,"s=");
    let l:[]u8=spec_kv(spec,"l=");
    if(f.len==0){e_raw(cx,"UNTAUGHT:field\n");return;}
    if(s.len==0){e_raw(cx,"UNTAUGHT:s\n");return;}
    if(l.len==0){e_raw(cx,"UNTAUGHT:l\n");return;}
    em_helpers(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(1);\n");
    e_raw(cx,"let f:[]u8=field_get(rec,");
    e_raw(cx,f);
    e_raw(cx,");\n");
    e_raw(cx,"let a:i64=");
    e_raw(cx,s);
    e_raw(cx,";\n");
    e_raw(cx,"let b:i64=");
    e_raw(cx,l);
    e_raw(cx,";\n");
    e_raw(cx,"if(a<0){a=0;}\n");
    e_raw(cx,"if(a>f.len){a=f.len;}\n");
    e_raw(cx,"if(a+b>f.len){b=f.len-a;}\n");
    e_raw(cx,"if(b<0){b=0;}\n");
    e_raw(cx,"_zag_print(rec);\n");
    e_raw(cx,"_zag_print(\"|\");\n");
    e_raw(cx,"_zag_print(f[a..a+b]);\n");
    e_raw(cx,"_zag_print(\"\n\");\n");
    e_raw(cx,"return;}\n");
    return;
}

// format: template with {k} replaced by field k (1-based)
fn emit_f_format(cx:*Cx, spec:[]u8)void {
    let t:[]u8=spec_kv(spec,"template=");
    if(t.len==0){e_raw(cx,"UNTAUGHT:template\n");return;}
    em_helpers(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(1);\n");
    let i:i64=0;
    let lit_s:i64=0;
    while(i<t.len){
        let is_brace:i64=0;
        if(t[i]==123){is_brace=1;}
        if(is_brace==1){
            if(i>lit_s){
                e_raw(cx,"_zag_print(\"");
                e_raw(cx,t[lit_s..i]);
                e_raw(cx,"\");\n");
            }
            let j:i64=i+1;
            let kn:i64=0;
            let dj:i64=0;
            while(dj==0){
                if(j>=t.len){dj=1;}
                if(dj==0){
                    if(t[j]==125){dj=1;}
                }
                if(dj==0){
                    kn=kn*10+((t[j] as i64)-48);
                    j=j+1;
                }
            }
            e_raw(cx,"_zag_print(field_get(rec,");
            e_i64(cx,kn);
            e_raw(cx,"));\n");
            i=j+1;
            lit_s=i;
        }
        if(is_brace==0){i=i+1;}
    }
    if(lit_s<t.len){
        e_raw(cx,"_zag_print(\"");
        e_raw(cx,t[lit_s..t.len]);
        e_raw(cx,"\");\n");
    }
    e_raw(cx,"_zag_print(\"\n\");\n");
    e_raw(cx,"return;}\n");
    return;
}

// ---- LH|FILTER| emitters ----
fn emit_filter(cx:*Cx, spec:[]u8)void {
    let op:[]u8=spec_kv(spec,"op=");
    if(s_eq(op,"field_count_eq")==1){emit_fl_count(cx,spec);return;}
    if(s_eq(op,"int_gt")==1){emit_fl_int(cx,spec,1);return;}
    if(s_eq(op,"int_ge")==1){emit_fl_int(cx,spec,2);return;}
    if(s_eq(op,"int_lt")==1){emit_fl_int(cx,spec,3);return;}
    if(s_eq(op,"int_lt_field")==1){emit_fl_intfield(cx,spec);return;}
    if(s_eq(op,"in_set")==1){emit_fl_set(cx,spec);return;}
    e_raw(cx,"UNTAUGHT:filter-op=");
    e_raw(cx,op);
    e_raw(cx,"\n");
    return;
}

fn emit_fl_count(cx:*Cx, spec:[]u8)void {
    let n:[]u8=spec_kv(spec,"n=");
    if(n.len==0){e_raw(cx,"UNTAUGHT:n\n");return;}
    em_helpers(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(1);\n");
    e_raw(cx,"if(field_count(rec)==");
    e_raw(cx,n);
    e_raw(cx,"){\n");
    e_raw(cx,"_zag_print(rec);\n");
    e_raw(cx,"_zag_print(\"\n\");}\n");
    e_raw(cx,"return;}\n");
    return;
}

// cmp: 1=int_gt, 2=int_ge, 3=int_lt
fn emit_fl_int(cx:*Cx, spec:[]u8, cmp:i64)void {
    let f:[]u8=spec_kv(spec,"field=");
    let t:[]u8=spec_kv(spec,"threshold=");
    if(f.len==0){e_raw(cx,"UNTAUGHT:field\n");return;}
    if(t.len==0){e_raw(cx,"UNTAUGHT:threshold\n");return;}
    em_helpers(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(1);\n");
    e_raw(cx,"let v:i64=parse_i64(field_get(rec,");
    e_raw(cx,f);
    e_raw(cx,"));\n");
    e_raw(cx,"let keep:i64=0;\n");
    if(cmp==1){
        e_raw(cx,"if(v>");
        e_raw(cx,t);
        e_raw(cx,"){keep=1;}\n");
    }
    if(cmp==2){
        e_raw(cx,"if(v>=");
        e_raw(cx,t);
        e_raw(cx,"){keep=1;}\n");
    }
    if(cmp==3){
        e_raw(cx,"if(v<");
        e_raw(cx,t);
        e_raw(cx,"){keep=1;}\n");
    }
    e_raw(cx,"if(keep==1){_zag_print(rec);_zag_print(\"\n\");}\n");
    e_raw(cx,"return;}\n");
    return;
}

fn emit_fl_intfield(cx:*Cx, spec:[]u8)void {
    let f:[]u8=spec_kv(spec,"field=");
    let g:[]u8=spec_kv(spec,"field2=");
    if(f.len==0){e_raw(cx,"UNTAUGHT:field\n");return;}
    if(g.len==0){e_raw(cx,"UNTAUGHT:field2\n");return;}
    em_helpers(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(1);\n");
    e_raw(cx,"let a:i64=parse_i64(field_get(rec,");
    e_raw(cx,f);
    e_raw(cx,"));\n");
    e_raw(cx,"let b:i64=parse_i64(field_get(rec,");
    e_raw(cx,g);
    e_raw(cx,"));\n");
    e_raw(cx,"if(a<b){_zag_print(rec);_zag_print(\"\n\");}\n");
    e_raw(cx,"return;}\n");
    return;
}

fn emit_fl_set(cx:*Cx, spec:[]u8)void {
    let f:[]u8=spec_kv(spec,"field=");
    let s:[]u8=spec_kv(spec,"set=");
    if(f.len==0){e_raw(cx,"UNTAUGHT:field\n");return;}
    if(s.len==0){e_raw(cx,"UNTAUGHT:set\n");return;}
    em_helpers(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(1);\n");
    e_raw(cx,"let f:[]u8=field_get(rec,");
    e_raw(cx,f);
    e_raw(cx,");\n");
    e_raw(cx,"let ok:i64=0;\n");
    // split set on ','
    let i:i64=0;
    let vs:i64=0;
    while(i<=s.len){
        let end:i64=0;
        if(i==s.len){end=1;}
        if(end==0){
            if(s[i]==44){end=1;}
        }
        if(end==1){
            if(i>vs){
                e_raw(cx,"if(s_eq(f,\"");
                e_raw(cx,s[vs..i]);
                e_raw(cx,"\")==1){ok=1;}\n");
            }
            vs=i+1;
        }
        i=i+1;
    }
    e_raw(cx,"if(ok==1){_zag_print(rec);_zag_print(\"\n\");}\n");
    e_raw(cx,"return;}\n");
    return;
}

// ---- LH|AGG| emitters ----
fn emit_agg(cx:*Cx, spec:[]u8)void {
    let op:[]u8=spec_kv(spec,"op=");
    if(s_eq(op,"sum")==1){emit_ag_sum(cx,spec);return;}
    if(s_eq(op,"count")==1){emit_ag_count(cx,spec);return;}
    e_raw(cx,"UNTAUGHT:agg-op=");
    e_raw(cx,op);
    e_raw(cx,"\n");
    return;
}

fn em_arena(cx:*Cx)void {
    e_raw(cx,"fn i64_arena(n:i64)[]i64 {\n");
    e_raw(cx,"let p:*u8=_zag_malloc(n*8) as *u8;\n");
    e_raw(cx,"let a:[]i64=p[0..n*8] as []i64;\n");
    e_raw(cx,"return a;}\n");
    return;
}

// sum: key=<k> val=<v> -> lines "key|sum|count"
fn emit_ag_sum(cx:*Cx, spec:[]u8)void {
    let k:[]u8=spec_kv(spec,"key=");
    let v:[]u8=spec_kv(spec,"val=");
    if(k.len==0){e_raw(cx,"UNTAUGHT:key\n");return;}
    if(v.len==0){e_raw(cx,"UNTAUGHT:val\n");return;}
    em_helpers(cx);
    em_arena(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let cnt:i64=parse_i64(_zag_arg(1));\n");
    e_raw(cx,"let kb:*u8=_zag_malloc(4096) as *u8;\n");
    e_raw(cx,"let kbuf:[]u8=kb[0..4096];\n");
    e_raw(cx,"let klo:[]i64=i64_arena(64);\n");
    e_raw(cx,"let kln:[]i64=i64_arena(64);\n");
    e_raw(cx,"let ksum:[]i64=i64_arena(64);\n");
    e_raw(cx,"let kct:[]i64=i64_arena(64);\n");
    e_raw(cx,"let nk:i64=0;\n");
    e_raw(cx,"let klen:i64=0;\n");
    e_raw(cx,"let i:i64=0;\n");
    e_raw(cx,"while(i<cnt){\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(2+i);\n");
    e_raw(cx,"let key:[]u8=field_get(rec,");
    e_raw(cx,k);
    e_raw(cx,");\n");
    e_raw(cx,"let val:i64=parse_i64(field_get(rec,");
    e_raw(cx,v);
    e_raw(cx,"));\n");
    e_raw(cx,"let f:i64=-1;\n");
    e_raw(cx,"let j:i64=0;\n");
    e_raw(cx,"while(j<nk){\n");
    e_raw(cx,"let ks:[]u8=kbuf[klo[j]..klo[j]+kln[j]];\n");
    e_raw(cx,"if(s_eq(ks,key)==1){f=j;}\n");
    e_raw(cx,"j=j+1;}\n");
    e_raw(cx,"if(f==-1){\n");
    e_raw(cx,"klo[nk]=klen;\n");
    e_raw(cx,"kln[nk]=key.len;\n");
    e_raw(cx,"let q:i64=0;\n");
    e_raw(cx,"while(q<key.len){kbuf[klen+q]=key[q];q=q+1;}\n");
    e_raw(cx,"klen=klen+key.len;\n");
    e_raw(cx,"ksum[nk]=val;\n");
    e_raw(cx,"kct[nk]=1;\n");
    e_raw(cx,"nk=nk+1;}\n");
    e_raw(cx,"if(f!=-1){ksum[f]=ksum[f]+val;kct[f]=kct[f]+1;}\n");
    e_raw(cx,"i=i+1;}\n");
    e_raw(cx,"let j2:i64=0;\n");
    e_raw(cx,"while(j2<nk){\n");
    e_raw(cx,"let ks2:[]u8=kbuf[klo[j2]..klo[j2]+kln[j2]];\n");
    e_raw(cx,"_zag_print(ks2);\n");
    e_raw(cx,"_zag_print(\"|\");\n");
    e_raw(cx,"_zag_print(i64s(ksum[j2]));\n");
    e_raw(cx,"_zag_print(\"|\");\n");
    e_raw(cx,"_zag_print(i64s(kct[j2]));\n");
    e_raw(cx,"_zag_print(\"\n\");\n");
    e_raw(cx,"j2=j2+1;}\n");
    e_raw(cx,"return;}\n");
    return;
}

// count: key=<k> -> lines "key|count"
fn emit_ag_count(cx:*Cx, spec:[]u8)void {
    let k:[]u8=spec_kv(spec,"key=");
    if(k.len==0){e_raw(cx,"UNTAUGHT:key\n");return;}
    em_helpers(cx);
    em_arena(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let cnt:i64=parse_i64(_zag_arg(1));\n");
    e_raw(cx,"let kb:*u8=_zag_malloc(4096) as *u8;\n");
    e_raw(cx,"let kbuf:[]u8=kb[0..4096];\n");
    e_raw(cx,"let klo:[]i64=i64_arena(64);\n");
    e_raw(cx,"let kln:[]i64=i64_arena(64);\n");
    e_raw(cx,"let kct:[]i64=i64_arena(64);\n");
    e_raw(cx,"let nk:i64=0;\n");
    e_raw(cx,"let klen:i64=0;\n");
    e_raw(cx,"let i:i64=0;\n");
    e_raw(cx,"while(i<cnt){\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(2+i);\n");
    e_raw(cx,"let key:[]u8=field_get(rec,");
    e_raw(cx,k);
    e_raw(cx,");\n");
    e_raw(cx,"let f:i64=-1;\n");
    e_raw(cx,"let j:i64=0;\n");
    e_raw(cx,"while(j<nk){\n");
    e_raw(cx,"let ks:[]u8=kbuf[klo[j]..klo[j]+kln[j]];\n");
    e_raw(cx,"if(s_eq(ks,key)==1){f=j;}\n");
    e_raw(cx,"j=j+1;}\n");
    e_raw(cx,"if(f==-1){\n");
    e_raw(cx,"klo[nk]=klen;\n");
    e_raw(cx,"kln[nk]=key.len;\n");
    e_raw(cx,"let q:i64=0;\n");
    e_raw(cx,"while(q<key.len){kbuf[klen+q]=key[q];q=q+1;}\n");
    e_raw(cx,"klen=klen+key.len;\n");
    e_raw(cx,"kct[nk]=1;\n");
    e_raw(cx,"nk=nk+1;}\n");
    e_raw(cx,"if(f!=-1){kct[f]=kct[f]+1;}\n");
    e_raw(cx,"i=i+1;}\n");
    e_raw(cx,"let j2:i64=0;\n");
    e_raw(cx,"while(j2<nk){\n");
    e_raw(cx,"let ks2:[]u8=kbuf[klo[j2]..klo[j2]+kln[j2]];\n");
    e_raw(cx,"_zag_print(ks2);\n");
    e_raw(cx,"_zag_print(\"|\");\n");
    e_raw(cx,"_zag_print(i64s(kct[j2]));\n");
    e_raw(cx,"_zag_print(\"\n\");\n");
    e_raw(cx,"j2=j2+1;}\n");
    e_raw(cx,"return;}\n");
    return;
}

// ---- LH|SORT| emitter ----
// field=<k> order=<asc|desc> take=<n> (0 = all). Sorts by parsed integer key.
fn emit_sort(cx:*Cx, spec:[]u8)void {
    let f:[]u8=spec_kv(spec,"field=");
    let o:[]u8=spec_kv(spec,"order=");
    let t:[]u8=spec_kv(spec,"take=");
    if(f.len==0){e_raw(cx,"UNTAUGHT:field\n");return;}
    if(o.len==0){e_raw(cx,"UNTAUGHT:order\n");return;}
    if(t.len==0){e_raw(cx,"UNTAUGHT:take\n");return;}
    let desc:i64=0;
    let okord:i64=0;
    if(s_eq(o,"desc")==1){desc=1;okord=1;}
    if(s_eq(o,"asc")==1){desc=0;okord=1;}
    if(okord==0){e_raw(cx,"UNTAUGHT:order\n");return;}
    em_helpers(cx);
    em_arena(cx);
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"let cnt:i64=parse_i64(_zag_arg(1));\n");
    e_raw(cx,"let rb:*u8=_zag_malloc(8192) as *u8;\n");
    e_raw(cx,"let rbuf:[]u8=rb[0..8192];\n");
    e_raw(cx,"let ro:[]i64=i64_arena(64);\n");
    e_raw(cx,"let rl:[]i64=i64_arena(64);\n");
    e_raw(cx,"let rv:[]i64=i64_arena(64);\n");
    e_raw(cx,"let rlen:i64=0;\n");
    e_raw(cx,"let i:i64=0;\n");
    e_raw(cx,"while(i<cnt){\n");
    e_raw(cx,"let rec:[]u8=_zag_arg(2+i);\n");
    e_raw(cx,"ro[i]=rlen;\n");
    e_raw(cx,"rl[i]=rec.len;\n");
    e_raw(cx,"let q:i64=0;\n");
    e_raw(cx,"while(q<rec.len){rbuf[rlen+q]=rec[q];q=q+1;}\n");
    e_raw(cx,"rlen=rlen+rec.len;\n");
    e_raw(cx,"rv[i]=parse_i64(field_get(rec,");
    e_raw(cx,f);
    e_raw(cx,"));\n");
    e_raw(cx,"i=i+1;}\n");
    e_raw(cx,"let idx:[]i64=i64_arena(64);\n");
    e_raw(cx,"i=0;\n");
    e_raw(cx,"while(i<cnt){idx[i]=i;i=i+1;}\n");
    e_raw(cx,"let p:i64=0;\n");
    e_raw(cx,"while(p<cnt){\n");
    e_raw(cx,"let q2:i64=0;\n");
    e_raw(cx,"while(q2+1<cnt-p){\n");
    e_raw(cx,"let sw:i64=0;\n");
    if(desc==1){
        e_raw(cx,"if(rv[idx[q2]]<rv[idx[q2+1]]){sw=1;}\n");
    }
    if(desc==0){
        e_raw(cx,"if(rv[idx[q2]]>rv[idx[q2+1]]){sw=1;}\n");
    }
    e_raw(cx,"if(sw==1){let tt:i64=idx[q2];idx[q2]=idx[q2+1];idx[q2+1]=tt;}\n");
    e_raw(cx,"q2=q2+1;}\n");
    e_raw(cx,"p=p+1;}\n");
    e_raw(cx,"let n:i64=cnt;\n");
    e_raw(cx,"let tk:i64=");
    e_raw(cx,t);
    e_raw(cx,";\n");
    e_raw(cx,"if(tk>0){if(tk<cnt){n=tk;}}\n");
    e_raw(cx,"i=0;\n");
    e_raw(cx,"while(i<n){\n");
    e_raw(cx,"let rr:[]u8=rbuf[ro[idx[i]]..ro[idx[i]]+rl[idx[i]]];\n");
    e_raw(cx,"_zag_print(rr);\n");
    e_raw(cx,"_zag_print(\"\n\");\n");
    e_raw(cx,"i=i+1;}\n");
    e_raw(cx,"return;}\n");
    return;
}

// ---- dispatch ----
fn do_gen(cx:*Cx)void {
    let spec:[]u8=_zag_arg(2);
    if(s_has(spec,"LH|FIELD|")==1){emit_field(cx,spec);return;}
    if(s_has(spec,"LH|FILTER|")==1){emit_filter(cx,spec);return;}
    if(s_has(spec,"LH|AGG|")==1){emit_agg(cx,spec);return;}
    if(s_has(spec,"LH|SORT|")==1){emit_sort(cx,spec);return;}
    e_raw(cx,"UNKNOWN_GOAL\n");
    return;
}

fn main()void {
    let mode:[]u8=_zag_arg(1);
    if(s_eq(mode,"gen")==1){
        let cx:Cx=cx_new(65536);
        let p:*Cx=&cx;
        do_gen(p);
        let b:[]u8=cx.b;
        _zag_print(b[0..cx.n]);
        return;
    }
    _zag_print("UNKNOWN_MODE\n");
    return;
}

fn s_eq(a:[]u8,b:[]u8)i64 {
if(a.len!=b.len){return 0;}
let i:i64=0;
while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
return 1;}
fn parse_i64(s:[]u8)i64 {
let neg:i64=0;let i:i64=0;
if(s.len>0){if(s[0]==45){neg=1;i=1;}}
let v:i64=0;
while(i<s.len){if(s[i]>=48){if(s[i]<=57){v=v*10+((s[i] as i64)-48);}}i=i+1;}
if(neg==1){v=0-v;}
return v;}
fn i64s(v:i64)[]u8 {
let s:[]u8=_zag_i64_to_str(v);
if(s.len>0){if(s[s.len-1]==10){return s[0..s.len-1];}}
return s;}
fn field_count(rec:[]u8)i64 {
if(rec.len==0){return 0;}
let c:i64=1;let i:i64=0;
while(i<rec.len){if(rec[i]==124){c=c+1;}i=i+1;}
return c;}
fn field_get(rec:[]u8,k:i64)[]u8 {
let n:i64=1;let s:i64=0;let i:i64=0;
while(i<=rec.len){
let e:i64=0;
if(i==rec.len){e=1;}
if(e==0){if(rec[i]==124){e=1;}}
if(e==1){if(n==k){return rec[s..i];}n=n+1;s=i+1;}
i=i+1;}
return "";}
fn i64_arena(n:i64)[]i64 {
let p:*u8=_zag_malloc(n*8) as *u8;
let a:[]i64=p[0..n*8] as []i64;
return a;}
fn main()void {
let cnt:i64=parse_i64(_zag_arg(1));
let rb:*u8=_zag_malloc(8192) as *u8;
let rbuf:[]u8=rb[0..8192];
let ro:[]i64=i64_arena(64);
let rl:[]i64=i64_arena(64);
let rv:[]i64=i64_arena(64);
let rlen:i64=0;
let i:i64=0;
while(i<cnt){
let rec:[]u8=_zag_arg(2+i);
ro[i]=rlen;
rl[i]=rec.len;
let q:i64=0;
while(q<rec.len){rbuf[rlen+q]=rec[q];q=q+1;}
rlen=rlen+rec.len;
rv[i]=parse_i64(field_get(rec,2));
i=i+1;}
let idx:[]i64=i64_arena(64);
i=0;
while(i<cnt){idx[i]=i;i=i+1;}
let p:i64=0;
while(p<cnt){
let q2:i64=0;
while(q2+1<cnt-p){
let sw:i64=0;
if(rv[idx[q2]]<rv[idx[q2+1]]){sw=1;}
if(sw==1){let tt:i64=idx[q2];idx[q2]=idx[q2+1];idx[q2+1]=tt;}
q2=q2+1;}
p=p+1;}
let n:i64=cnt;
let tk:i64=0;
if(tk>0){if(tk<cnt){n=tk;}}
i=0;
while(i<n){
let rr:[]u8=rbuf[ro[idx[i]]..ro[idx[i]]+rl[idx[i]]];
_zag_print(rr);
_zag_print("
");
i=i+1;}
return;}

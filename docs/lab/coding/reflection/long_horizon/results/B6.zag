fn s_eq(a:[]u8,b:[]u8)i64 {
if(a.len!=b.len){return 0;}
let i:i64=0;
while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
return 1;}
fn parse_i64(s:[]u8)i64 {
let neg:i64=0;let i:i64=0;
if(s.len>0){if(s[0]==45){neg=1;i=1;}}
let v:i64=0;
while(i<s.len){if(s[i]>=48){if(s[i]<=57){v=v*10+((s[i] as i64)-48);}}i=i+1;}
if(neg==1){v=0-v;}
return v;}
fn i64s(v:i64)[]u8 {
let s:[]u8=_zag_i64_to_str(v);
if(s.len>0){if(s[s.len-1]==10){return s[0..s.len-1];}}
return s;}
fn field_count(rec:[]u8)i64 {
if(rec.len==0){return 0;}
let c:i64=1;let i:i64=0;
while(i<rec.len){if(rec[i]==124){c=c+1;}i=i+1;}
return c;}
fn field_get(rec:[]u8,k:i64)[]u8 {
let n:i64=1;let s:i64=0;let i:i64=0;
while(i<=rec.len){
let e:i64=0;
if(i==rec.len){e=1;}
if(e==0){if(rec[i]==124){e=1;}}
if(e==1){if(n==k){return rec[s..i];}n=n+1;s=i+1;}
i=i+1;}
return "";}
fn i64_arena(n:i64)[]i64 {
let p:*u8=_zag_malloc(n*8) as *u8;
let a:[]i64=p[0..n*8] as []i64;
return a;}
fn main()void {
let cnt:i64=parse_i64(_zag_arg(1));
let kb:*u8=_zag_malloc(4096) as *u8;
let kbuf:[]u8=kb[0..4096];
let klo:[]i64=i64_arena(64);
let kln:[]i64=i64_arena(64);
let kct:[]i64=i64_arena(64);
let nk:i64=0;
let klen:i64=0;
let i:i64=0;
while(i<cnt){
let rec:[]u8=_zag_arg(2+i);
let key:[]u8=field_get(rec,5);
let f:i64=-1;
let j:i64=0;
while(j<nk){
let ks:[]u8=kbuf[klo[j]..klo[j]+kln[j]];
if(s_eq(ks,key)==1){f=j;}
j=j+1;}
if(f==-1){
klo[nk]=klen;
kln[nk]=key.len;
let q:i64=0;
while(q<key.len){kbuf[klen+q]=key[q];q=q+1;}
klen=klen+key.len;
kct[nk]=1;
nk=nk+1;}
if(f!=-1){kct[f]=kct[f]+1;}
i=i+1;}
let j2:i64=0;
while(j2<nk){
let ks2:[]u8=kbuf[klo[j2]..klo[j2]+kln[j2]];
_zag_print(ks2);
_zag_print("|");
_zag_print(i64s(kct[j2]));
_zag_print("
");
j2=j2+1;}
return;}

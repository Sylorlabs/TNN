struct Point { x:i64, y:i64 }
fn manhattan(p:Point)i64 {
    let ax:i64=p.x;
    if(ax<0){ax=0-ax;}
    let ay:i64=p.y;
    if(ay<0){ay=0-ay;}
    return ax+ay;
}
fn main()void {
    let p:Point=Point{};
    p.x=5;
    p.y=12;
    let r:i64=manhattan(p);
    _zag_print(_zag_i64_to_str(r));
    _zag_print("\n");
}

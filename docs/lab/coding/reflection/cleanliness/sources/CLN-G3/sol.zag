fn count_ch(s:[]u8,n:i64,ch:i64)i64 {
  let i:i64=0;
  let count:i64=0;
  while(i<n){
    if(s[i]==ch){
      count=count+1;
    }
    i=i+1;
  }
  return count;
}
fn main()void {
  let name:[]u8="beekeeper";
  let result:i64=count_ch(name,9,101);
  _zag_print(_zag_i64_to_str(result));
  _zag_print("\n");
}

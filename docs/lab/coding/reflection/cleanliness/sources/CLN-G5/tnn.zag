fn bubble_asc(a:[]i64,n:i64)void {
    let i:i64=0;
    while(i<n){
        let j:i64=0;
        while(j+1<n-i){
            if(a[j]>a[j+1]){
                let t:i64=a[j];
                a[j]=a[j+1];
                a[j+1]=t;
            }
            j=j+1;
        }
        i=i+1;
    }
    return;
}
fn main()void {
    let p:*u8=_zag_malloc(32) as *u8;
    let arr:[]i64=p[0..32] as []i64;
    arr[0]=9;
    arr[1]=3;
    arr[2]=7;
    arr[3]=1;
    bubble_asc(arr,4);
    let pi:i64=0;
    while(pi<4){
        _zag_print(_zag_i64_to_str(arr[pi]));
        if(pi+1<4){_zag_print(" ");}
        pi=pi+1;
    }
    _zag_print("\n");
}

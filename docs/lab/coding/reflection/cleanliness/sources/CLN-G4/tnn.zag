fn sum_arr(a:[]i64,n:i64)i64 {
    let s:i64=0;
    let i:i64=0;
    while(i<n){s=s+a[i];i=i+1;}
    return s;
}
fn main()void {
    let p:*u8=_zag_malloc(32) as *u8;
    let arr:[]i64=p[0..32] as []i64;
    arr[0]=2;
    arr[1]=7;
    arr[2]=1;
    arr[3]=8;
    let r:i64=sum_arr(arr,4);
    _zag_print(_zag_i64_to_str(r));
    _zag_print("\n");
}

fn reverse(s:[]u8,n:i64)void {
    let i:i64=0;
    while(i<n/2){
        let t:u8=s[i];
        s[i]=s[n-1-i];
        s[n-1-i]=t;
        i=i+1;
    }
    return;
}
fn main()void {
    let q:*u8=_zag_malloc(7) as *u8;
    let s:[]u8=q[0..7];
    let lit:[]u8="zaglang";
    let ci:i64=0;
    while(ci<7){s[ci]=lit[ci];ci=ci+1;}
    reverse(s,7);
    _zag_print(s);
    _zag_print("\n");
}

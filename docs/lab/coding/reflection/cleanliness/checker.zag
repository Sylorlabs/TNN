// checker.zag — CLN-1 mechanical cleanliness checker. Pure Zag, zero RNG.
// Usage: checker '<zag source>'
// Output line 1: M1=<0-2> M2=<0-2> M3=<0-2>
// Output line 2: DETAIL deadfn=<n> postret=<n> unused=<n> maxlen=<n> maxdepth=<n>
//
// M1 dead code: (a) defined-never-called fns except main,
//               (b) statements after return at same brace depth,
//               (c) declared-never-used locals.
// M2: longest function non-blank line count (<=25:2, <=50:1, else 0).
// M3: max brace depth (<=3:2, 4:1, >=5:0).

fn b_is_word(b:u8)i64 {
  if(b>=48){ if(b<=57){ return 1; } }
  if(b>=65){ if(b<=90){ return 1; } }
  if(b>=97){ if(b<=122){ return 1; } }
  if(b==95){ return 1; }
  return 0;
}

fn find_from(h:[]u8, n:[]u8, nn:i64, start:i64)i64 {
  let hn:i64=h.len;
  let i:i64=start;
  while(i+nn<=hn){
    let ok:i64=1;
    let j:i64=0;
    while(j<nn){
      if(h[i+j]!=n[j]){ ok=0; }
      j=j+1;
    }
    if(ok==1){ return i; }
    i=i+1;
  }
  return -1;
}

fn line_off(h:[]u8, idx:i64)i64 {
  if(idx==0){ return 0; }
  let c:i64=0;
  let i:i64=0;
  while(i<h.len){
    if(h[i]==10){
      c=c+1;
      if(c==idx){ return i+1; }
    }
    i=i+1;
  }
  return -1;
}

fn line_end(h:[]u8, off:i64)i64 {
  let i:i64=off;
  while(i<h.len){
    if(h[i]==10){ return i; }
    i=i+1;
  }
  return h.len;
}

fn nlines(h:[]u8)i64 {
  let c:i64=0;
  let i:i64=0;
  while(i<h.len){
    if(h[i]==10){ c=c+1; }
    i=i+1;
  }
  if(h.len>0){
    if(h[h.len-1]!=10){ c=c+1; }
  }
  return c;
}

fn line_blank(h:[]u8, off:i64, end:i64)i64 {
  let i:i64=off;
  while(i<end){
    if(h[i]!=32){
      if(h[i]!=9){ return 0; }
    }
    i=i+1;
  }
  return 1;
}

fn brace_delta(h:[]u8, off:i64, end:i64)i64 {
  let d:i64=0;
  let i:i64=off;
  while(i<end){
    if(h[i]==123){ d=d+1; }
    if(h[i]==125){ d=d-1; }
    i=i+1;
  }
  return d;
}

fn depth_at(h:[]u8, idx:i64)i64 {
  let d:i64=0;
  let l:i64=0;
  while(l<idx){
    let o:i64=line_off(h,l);
    if(o<0){ return d; }
    d=d+brace_delta(h,o,line_end(h,o));
    l=l+1;
  }
  return d;
}

// first non-blank byte on the line, or -1
fn first_nb(h:[]u8, off:i64, end:i64)i64 {
  let i:i64=off;
  while(i<end){
    if(h[i]!=32){
      if(h[i]!=9){ return i; }
    }
    i=i+1;
  }
  return -1;
}

// position of first word-occurrence of n in [off,end), or -1
fn find_word_pos(h:[]u8, off:i64, end:i64, n:[]u8, nn:i64)i64 {
  let pos:i64=off;
  let go:i64=1;
  while(go==1){
    let p:i64=find_from(h,n,nn,pos);
    if(p<0){ go=0; }
    if(p>=end){ go=0; }
    if(go==1){
      let ok:i64=1;
      if(p>0){ if(b_is_word(h[p-1])==1){ ok=0; } }
      if(p+nn<h.len){ if(b_is_word(h[p+nn])==1){ ok=0; } }
      if(ok==1){ return p; }
      pos=p+1;
    }
  }
  return -1;
}

// does the span [off,end) contain needle as a word?
fn span_has_word(h:[]u8, off:i64, end:i64, n:[]u8, nn:i64)i64 {
  if(find_word_pos(h,off,end,n,nn)>=0){ return 1; }
  return 0;
}

// count word occurrences of name outside [exfrom,exto).
// The trailing boundary check applies only when the needle ends in a word
// char (so a "name(" call-needle is not penalized for its argument).
fn count_word_out(h:[]u8, name:[]u8, nl:i64, exfrom:i64, exto:i64)i64 {
  let c:i64=0;
  let pos:i64=0;
  let go:i64=1;
  let trail:i64=b_is_word(name[nl-1]);
  while(go==1){
    let p:i64=find_from(h,name,nl,pos);
    if(p<0){ go=0; }
    if(go==1){
      let skip:i64=0;
      if(p>=exfrom){ if(p<exto){ skip=1; } }
      if(skip==0){
        let ok:i64=1;
        if(p>0){ if(b_is_word(h[p-1])==1){ ok=0; } }
        if(trail==1){
          if(p+nl<h.len){ if(b_is_word(h[p+nl])==1){ ok=0; } }
        }
        if(ok==1){ c=c+1; }
      }
      pos=p+1;
    }
  }
  return c;
}

// extract fn name from def line span into buf; returns name length
fn get_fn_name(h:[]u8, off:i64, end:i64, buf:[]u8)i64 {
  let i:i64=off+3;
  let j:i64=0;
  while(i<end){
    let c:u8=h[i];
    if(c==40){ return j; }
    if(c==32){ return j; }
    buf[j]=c;
    j=j+1;
    i=i+1;
  }
  return j;
}

// extract let-name from decl span into buf; returns name length
fn get_let_name(h:[]u8, off:i64, end:i64, buf:[]u8)i64 {
  let i:i64=off+4;
  let j:i64=0;
  while(i<end){
    let c:u8=h[i];
    if(c==58){ return j; }
    if(c==32){ return j; }
    if(c==61){ return j; }
    buf[j]=c;
    j=j+1;
    i=i+1;
  }
  return j;
}

fn main()void {
  let src:[]u8=_zag_arg(1);
  let nl:i64=nlines(src);
  let pat_fn:[]u8="fn ";
  let pat_let:[]u8="let ";
  let pat_ret:[]u8="return";
  let buf:[]u8=_zag_strdup("                                                                ");
  let needle:[]u8=_zag_strdup("                                                                ");

  // ---- function spans: fnline[i], fnend[i]
  let fnline0:i64=-1;
  let fnline1:i64=-1;
  let fnline2:i64=-1;
  let fnline3:i64=-1;
  let fnline4:i64=-1;
  let fnline5:i64=-1;
  let fnline6:i64=-1;
  let fnline7:i64=-1;
  let fnend0:i64=-1;
  let fnend1:i64=-1;
  let fnend2:i64=-1;
  let fnend3:i64=-1;
  let fnend4:i64=-1;
  let fnend5:i64=-1;
  let fnend6:i64=-1;
  let fnend7:i64=-1;
  let nfn:i64=0;
  let l:i64=0;
  while(l<nl){
    let o:i64=line_off(src,l);
    let e:i64=line_end(src,o);
    if(e-o>=3){
      if(src[o]==102){
        if(src[o+1]==110){
          if(src[o+2]==32){
            if(nfn==0){ fnline0=l; }
            if(nfn==1){ fnline1=l; }
            if(nfn==2){ fnline2=l; }
            if(nfn==3){ fnline3=l; }
            if(nfn==4){ fnline4=l; }
            if(nfn==5){ fnline5=l; }
            if(nfn==6){ fnline6=l; }
            if(nfn==7){ fnline7=l; }
            nfn=nfn+1;
          }
        }
      }
    }
    l=l+1;
  }
  // find each fn's end line
  let fi:i64=0;
  while(fi<nfn){
    let fl:i64=-1;
    if(fi==0){ fl=fnline0; }
    if(fi==1){ fl=fnline1; }
    if(fi==2){ fl=fnline2; }
    if(fi==3){ fl=fnline3; }
    if(fi==4){ fl=fnline4; }
    if(fi==5){ fl=fnline5; }
    if(fi==6){ fl=fnline6; }
    if(fi==7){ fl=fnline7; }
    let d0:i64=depth_at(src,fl);
    let dep:i64=d0;
    let m:i64=fl;
    let fe:i64=fl;
    let found:i64=0;
    while(m<nl){
      let mo:i64=line_off(src,m);
      let me:i64=line_end(src,mo);
      dep=dep+brace_delta(src,mo,me);
      if(m>fl){
        if(dep==d0){ fe=m; found=1; m=nl; }
      }
      m=m+1;
    }
    if(found==0){ fe=nl-1; }
    if(fi==0){ fnend0=fe; }
    if(fi==1){ fnend1=fe; }
    if(fi==2){ fnend2=fe; }
    if(fi==3){ fnend3=fe; }
    if(fi==4){ fnend4=fe; }
    if(fi==5){ fnend5=fe; }
    if(fi==6){ fnend6=fe; }
    if(fi==7){ fnend7=fe; }
    fi=fi+1;
  }

  // ---- M2: max function non-blank lines; M3: max depth
  let maxlen:i64=0;
  let maxdepth:i64=0;
  fi=0;
  while(fi<nfn){
    let fl:i64=-1;
    let fe:i64=-1;
    if(fi==0){ fl=fnline0; fe=fnend0; }
    if(fi==1){ fl=fnline1; fe=fnend1; }
    if(fi==2){ fl=fnline2; fe=fnend2; }
    if(fi==3){ fl=fnline3; fe=fnend3; }
    if(fi==4){ fl=fnline4; fe=fnend4; }
    if(fi==5){ fl=fnline5; fe=fnend5; }
    if(fi==6){ fl=fnline6; fe=fnend6; }
    if(fi==7){ fl=fnline7; fe=fnend7; }
    let cnt:i64=0;
    let m:i64=fl;
    while(m<=fe){
      let mo:i64=line_off(src,m);
      let me:i64=line_end(src,mo);
      if(line_blank(src,mo,me)==0){ cnt=cnt+1; }
      // depth tracking within function
      let d:i64=depth_at(src,m);
      let dd:i64=d;
      let k:i64=mo;
      while(k<me){
        if(src[k]==123){ dd=dd+1; if(dd>maxdepth){ maxdepth=dd; } }
        if(src[k]==125){ dd=dd-1; }
        k=k+1;
      }
      m=m+1;
    }
    if(cnt>maxlen){ maxlen=cnt; }
    fi=fi+1;
  }
  let m2:i64=2;
  if(maxlen>25){ m2=1; }
  if(maxlen>50){ m2=0; }
  let m3:i64=2;
  if(maxdepth==4){ m3=1; }
  if(maxdepth>=5){ m3=0; }

  // ---- M1a: defined-never-called fns (except main)
  let deadfn:i64=0;
  fi=0;
  while(fi<nfn){
    let fl:i64=-1;
    if(fi==0){ fl=fnline0; }
    if(fi==1){ fl=fnline1; }
    if(fi==2){ fl=fnline2; }
    if(fi==3){ fl=fnline3; }
    if(fi==4){ fl=fnline4; }
    if(fi==5){ fl=fnline5; }
    if(fi==6){ fl=fnline6; }
    if(fi==7){ fl=fnline7; }
    let fo:i64=line_off(src,fl);
    let fe2:i64=line_end(src,fo);
    let nl2:i64=get_fn_name(src,fo,fe2,buf);
    // is it main?
    let ismain:i64=0;
    if(nl2==4){
      if(buf[0]==109){
        if(buf[1]==97){
          if(buf[2]==105){
            if(buf[3]==110){ ismain=1; }
          }
        }
      }
    }
    if(ismain==0){
      // build needle = name + '('
      let ni:i64=0;
      while(ni<nl2){ needle[ni]=buf[ni]; ni=ni+1; }
      needle[nl2]=40;
      let calls:i64=count_word_out(src,needle,nl2+1,fo,fe2);
      if(calls==0){ deadfn=deadfn+1; }
    }
    fi=fi+1;
  }

  // ---- M1b: statements after return in the same block.
  // Block depth of a return = line-start depth adjusted for braces earlier
  // on the same line (handles `if(c){return x;}` one-liners). Scanning stops
  // at a shallower line or a line starting with `}` (block close): anything
  // after is not in the same block (handles `} else {` siblings).
  let postret:i64=0;
  l=0;
  while(l<nl){
    let o:i64=line_off(src,l);
    let e:i64=line_end(src,o);
    let rp:i64=find_word_pos(src,o,e,pat_ret,6);
    if(rp>=0){
      let d:i64=depth_at(src,l)+brace_delta(src,o,rp);
      let m2b:i64=l+1;
      let stop:i64=0;
      while(m2b<nl){
        if(stop==0){
          let mo:i64=line_off(src,m2b);
          let me:i64=line_end(src,mo);
          let dm:i64=depth_at(src,m2b);
          if(dm<d){ stop=1; }
          if(stop==0){
            let fnb:i64=first_nb(src,mo,me);
            if(fnb<0){ stop=stop; }
            if(fnb>=0){
              if(src[fnb]==125){ stop=1; }
              if(stop==0){
                if(dm==d){
                  postret=postret+1;
                  stop=1;
                }
              }
            }
          }
        }
        m2b=m2b+1;
      }
    }
    l=l+1;
  }

  // ---- M1c: declared-never-used locals
  let unused:i64=0;
  let pos:i64=0;
  let go:i64=1;
  while(go==1){
    let p:i64=find_from(src,pat_let,4,pos);
    if(p<0){ go=0; }
    if(go==1){
      // name ends at ':' / ' ' / '=' — pass src.len, get_let_name stops there
      let nl3:i64=get_let_name(src,p,src.len,buf);
      // exclude the declaration occurrence itself: span [p, p+4+nl3)
      let uses:i64=count_word_out(src,buf,nl3,p,p+4+nl3);
      if(uses==0){ unused=unused+1; }
      pos=p+1;
    }
  }

  let inst:i64=deadfn+postret+unused;
  let m1:i64=2;
  if(inst>=1){ m1=1; }
  if(inst>=3){ m1=0; }

  _zag_print("M1=");
  _zag_print(_zag_i64_to_str(m1));
  _zag_print(" M2=");
  _zag_print(_zag_i64_to_str(m2));
  _zag_print(" M3=");
  _zag_print(_zag_i64_to_str(m3));
  _zag_print("\n");
  _zag_print("DETAIL deadfn=");
  _zag_print(_zag_i64_to_str(deadfn));
  _zag_print(" postret=");
  _zag_print(_zag_i64_to_str(postret));
  _zag_print(" unused=");
  _zag_print(_zag_i64_to_str(unused));
  _zag_print(" maxlen=");
  _zag_print(_zag_i64_to_str(maxlen));
  _zag_print(" maxdepth=");
  _zag_print(_zag_i64_to_str(maxdepth));
  _zag_print("\n");
}

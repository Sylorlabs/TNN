fn em_str_countch(cx:[]u8,str:[]u8, ch:i64)void {
    emit(cx,"fn main()void {\n  let s:[]u8=\"");
    emit(cx,str);
    emit(cx,"\";\n  let c:i64=0;\n  let i:i64=0;\n  while(i<s.len){if(s[i]==");
    emit_i64(cx,ch);

}

fn em_math_fib(cx:[]u8,name:[]u8)void {
    emit(cx,"fn ");
    emit(cx,name);
    emit(cx,"(a:i64)i64 {\n  if(a<=1){return a;}\n  let x:i64=0;\n  let y:i64=1;\n  let i:i64=2;\n  while(i<=a){let z:i64=x+y;x=y;y=z;i=i+1;}\n  return y;\n}\n");
    emit(cx,"fn main()void {\n  _zag_print(_zag_i64_to_str(");
    emit(cx,name);
    emit(cx,"(");
    emit_i64(cx,demo_at(cx,0));
    emit(cx,")));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

// ================= T4 GOAL emitters =================
// Numbers are extracted from the spec by each emitter's own parser
// (deterministic; documented as per-schema apparatus).

// ints after a marker word in spec -> g_dt/g_dn
// positional operand: int after last " of ", else after last " to "/
// " through ", else last int of the goal text g (tier prefix excluded).
// The construct's operand is named by the preposition ("factorial of 6",
// "from 1 to 15"); positional, deterministic, no item identity used.
fn operand_int(cx:[]u8,g:[]u8)i64 {
    let tp:*u8=_zag_malloc(2048) as *u8;
    let tt:[]u8=tp[0..2048];
    let nn:i64=0;
    let i:i64=0;
    while(i<g.len){
        let neg:i64=0;
        if(g[i]==45){
            if(i+1<g.len){
                if(is_digit(cx,g[i+1])==1){neg=1;}
            }
        }
        if(is_digit(cx,g[i])==1 || neg==1){
            let st:i64=i;
            if(neg==1){i=i+1;}
            let v:i64=0;
            while(i<g.len){
                if(is_digit(cx,g[i])==0){break;}
                v=v*10+((g[i] as i64)-48);
                i=i+1;
            }
            if(neg==1){v=0-v;}
            if(nn<64){
                put64(cx,tt,nn*16,v);
                put64(cx,tt,nn*16+8,st);
                nn=nn+1;
            }
        } else {
            i=i+1;
        }
    }
    if(nn==0){return 0;}
    let po:i64=-1;
    let q:i64=0;
    while(q<g.len){
        if(s_find(cx,g," to ",q)==q){po=q;}
        if(s_find(cx,g," through ",q)==q){po=q;}
        q=q+1;
    }
    if(po<0){
        q=0;
        while(q<g.len){
            if(s_find(cx,g," of ",q)==q){po=q;}
            q=q+1;
        }
    }
    if(po>=0){
        let k:i64=0;
        while(k<nn){
            if(get64(cx,tt,k*16+8)>=po){return get64(cx,tt,k*16);}
            k=k+1;
        }
    }
    return get64(cx,tt,(nn-1)*16);
}

fn list_after(cx:[]u8,spec:[]u8, marker:[]u8)i64 {
    let p:i64=s_find(cx,spec,marker,0);
    if(p<0){return 0;}
    let rest:[]u8=spec[p+marker.len..spec.len];
    return parse_demo(cx,rest);
}

fn em_g_lcm(cx:[]u8,a:i64, b:i64)void {
    emit(cx,"fn main()void {\n  let x:i64=");
    emit_i64(cx,a);
    emit(cx,";\n  let y:i64=");
    emit_i64(cx,b);
    emit(cx,";\n  let p:i64=x;\n  let q:i64=y;\n  while(q!=0){let t:i64=p%q;p=q;q=t;}\n");
    emit(cx,"  let l:i64=x/p*y;\n  _zag_print(_zag_i64_to_str(l));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_g_countocc(cx:[]u8,x:i64, n:i64)void {
    emit(cx,"fn main()void {\n");
    emit(cx,"  let p:*u8=_zag_malloc(");
    emit_i64(cx,n*8);
    emit(cx,") as *u8;\n  let a:[]i64=p[0..");
    emit_i64(cx,n*8);
    emit(cx,"] as []i64;\n");
    let i:i64=0;
    while(i<n){
        emit(cx,"  a[");
        emit_i64(cx,i);
        emit(cx,"]=");
        emit_i64(cx,demo_at(cx,i));
        emit(cx,";\n");
        i=i+1;
    }
    emit(cx,"  let c:i64=0;\n  let k:i64=0;\n  while(k<");
    emit_i64(cx,n);
    emit(cx,"){if(a[k]==");
    emit_i64(cx,x);
    emit(cx,"){c=c+1;}k=k+1;}\n  _zag_print(_zag_i64_to_str(c));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_g_palin(cx:[]u8,word:[]u8)void {
    emit(cx,"fn main()void {\n  let s:[]u8=\"");
    emit(cx,word);
    emit(cx,"\";\n  let ok:i64=1;\n  let i:i64=0;\n  while(i<s.len/2){if(s[i]!=s[s.len-1-i]){ok=0;}i=i+1;}\n");
    emit(cx,"  _zag_print(_zag_i64_to_str(ok));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_g_pow(cx:[]u8,base:i64, exp:i64)void {
    emit(cx,"fn main()void {\n  let r:i64=1;\n  let i:i64=0;\n  while(i<");
    emit_i64(cx,exp);
    emit(cx,"){r=r*");
    emit_i64(cx,base);
    emit(cx,";i=i+1;}\n  _zag_print(_zag_i64_to_str(r));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_g_max(cx:[]u8,n:i64)void {
    emit(cx,"fn main()void {\n");
    emit(cx,"  let p:*u8=_zag_malloc(");
    emit_i64(cx,n*8);
    emit(cx,") as *u8;\n  let a:[]i64=p[0..");
    emit_i64(cx,n*8);
    emit(cx,"] as []i64;\n");
    let i:i64=0;
    while(i<n){
        emit(cx,"  a[");
        emit_i64(cx,i);
        emit(cx,"]=");
        emit_i64(cx,demo_at(cx,i));
        emit(cx,";\n");
        i=i+1;
    }
    emit(cx,"  let m:i64=a[0];\n  let k:i64=1;\n  while(k<");
    emit_i64(cx,n);
    emit(cx,"){if(a[k]>m){m=a[k];}k=k+1;}\n  _zag_print(_zag_i64_to_str(m));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_g_sumprimes(cx:[]u8,n:i64)void {
    emit(cx,"fn is_p(x:i64)i64 {\n  if(x<2){return 0;}\n  let d:i64=2;\n  while(d*d<=x){if(x%d==0){return 0;}d=d+1;}\n  return 1;\n}\n");
    emit(cx,"fn main()void {\n  let s:i64=0;\n  let i:i64=2;\n  while(i<");
    emit_i64(cx,n);
    emit(cx,"){if(is_p(i)==1){s=s+i;}i=i+1;}\n  _zag_print(_zag_i64_to_str(s));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_g_upper(cx:[]u8,s:[]u8)void {
    emit(cx,"fn main()void {\n  let p:*u8=_zag_malloc(");
    emit_i64(cx,s.len+1);
    emit(cx,") as *u8;\n  let t:[]u8=p[0..");
    emit_i64(cx,s.len+1);
    emit(cx,"];\n  let src:[]u8=\"");
    emit(cx,s);
    emit(cx,"\";\n  let i:i64=0;\n  while(i<src.len){let c:u8=src[i];\n    if(c>=97){if(c<=122){c=c-32;}}\n    t[i]=c;i=i+1;}\n  _zag_print(t[0..src.len]);\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_g_clamp(cx:[]u8,v:i64, lo:i64, hi:i64)void {
    emit(cx,"fn main()void {\n  let x:i64=");
    emit_i64(cx,v);
    emit(cx,";\n  if(x<");
    emit_i64(cx,lo);
    emit(cx,"){x=");
    emit_i64(cx,lo);
    emit(cx,";}\n  if(x>");
    emit_i64(cx,hi);
    emit(cx,"){x=");
    emit_i64(cx,hi);
    emit(cx,";}\n  _zag_print(_zag_i64_to_str(x));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_g_structarea(cx:[]u8,w:i64, h:i64)void {
    emit(cx,"struct Rect { w:i64, h:i64 }\n");
    emit(cx,"fn area(r:Rect)i64 {\n  return r.w*r.h;\n}\n");
    emit(cx,"fn main()void {\n  let q:Rect=Rect{};\n  q.w=");
    emit_i64(cx,w);
    emit(cx,";\n  q.h=");
    emit_i64(cx,h);
    emit(cx,";\n  _zag_print(_zag_i64_to_str(area(q)));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_g_sumfib(cx:[]u8,n:i64)void {
    emit(cx,"fn fib(a:i64)i64 {\n  if(a<2){return a;}\n  let x:i64=0;\n  let y:i64=1;\n  let i:i64=2;\n  while(i<=a){let z:i64=x+y;x=y;y=z;i=i+1;}\n  return y;\n}\n");
    emit(cx,"fn main()void {\n  let s:i64=0;\n  let i:i64=1;\n  while(i<=");
    emit_i64(cx,n);
    emit(cx,"){s=s+fib(i);i=i+1;}\n  _zag_print(_zag_i64_to_str(s));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_g_selsort(cx:[]u8,n:i64)void {
    emit(cx,"fn main()void {\n");
    emit(cx,"  let p:*u8=_zag_malloc(");
    emit_i64(cx,n*8);
    emit(cx,") as *u8;\n  let a:[]i64=p[0..");
    emit_i64(cx,n*8);
    emit(cx,"] as []i64;\n");
    let i:i64=0;
    while(i<n){
        emit(cx,"  a[");
        emit_i64(cx,i);
        emit(cx,"]=");
        emit_i64(cx,demo_at(cx,i));
        emit(cx,";\n");
        i=i+1;
    }
    emit(cx,"  let i:i64=0;\n  while(i<");
    emit_i64(cx,n);
    emit(cx,"){\n    let m:i64=i;\n    let j:i64=i+1;\n    while(j<");
    emit_i64(cx,n);
    emit(cx,"){if(a[j]<a[m]){m=j;}j=j+1;}\n");
    emit(cx,"    let t:i64=a[i];a[i]=a[m];a[m]=t;\n    i=i+1;\n  }\n");
    emit(cx,"  let k:i64=0;\n  while(k<");
    emit_i64(cx,n);
    emit(cx,"){\n    _zag_print(_zag_i64_to_str(a[k]));\n    if(k<");
    emit_i64(cx,n-1);
    emit(cx,"){_zag_print(\" \");}\n    k=k+1;\n  }\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_parse_int_fn(cx:[]u8)void {
    emit(cx,"fn parse_int(s:[]u8,n:i64)i64 {\n  let neg:i64=0;\n  let i:i64=0;\n  if(n>0){if(s[0]==45){neg=1;i=1;}}\n  let v:i64=0;\n  while(i<n){if(s[i]>=48){if(s[i]<=57){v=v*10+((s[i] as i64)-48);}}i=i+1;}\n  if(neg==1){v=0-v;}\n  return v;\n}\n");
    return;
}

fn em_g_argvsum(cx:[]u8)void {
    em_parse_int_fn(cx);
    emit(cx,"fn main()void {\n  let s:i64=0;\n  let i:i64=1;\n  while(i<=16){\n    let a:[]u8=_zag_arg(i);\n    if(a.len==0){break;}\n    s=s+parse_int(a,a.len);\n    i=i+1;\n  }\n  _zag_print(_zag_i64_to_str(s));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

// ================= T4x family emitters =================
// Compositional schemas: each composes KB idioms (emit-main skeleton,
// print-i64, argv loop, ...) into a novel mechanism. Selected by store
// entry votes ONLY (no trigger words in the binary).

fn em_f_rec(cx:[]u8,n:i64)void {
    emit(cx,"fn fact_r(k:i64)i64 {\n  if(k<=1){return 1;}\n  return k*fact_r(k-1);\n}\n");
    emit(cx,"fn main()void {\n  _zag_print(_zag_i64_to_str(fact_r(");
    emit_i64(cx,n);
    emit(cx,")));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_f_popcount(cx:[]u8,n:i64)void {
    emit(cx,"fn main()void {\n  let x:i64=");
    emit_i64(cx,n);
    emit(cx,";\n  let c:i64=0;\n  while(x>0){if(x%2==1){c=c+1;}x=x/2;}\n");
    emit(cx,"  _zag_print(_zag_i64_to_str(c));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_f_tri(cx:[]u8,h:i64)void {
    emit(cx,"fn main()void {\n  let r:i64=1;\n  while(r<=");
    emit_i64(cx,h);
    emit(cx,"){\n    let c:i64=0;\n    while(c<r){_zag_print(\"*\");c=c+1;}\n    _zag_print(\"\\n\");\n    r=r+1;\n  }\n}\n");
    return;
}

fn em_f_sentinel(cx:[]u8)void {
    em_parse_int_fn(cx);
    emit(cx,"fn main()void {\n  let s:i64=0;\n  let i:i64=1;\n  while(i<=16){\n    let a:[]u8=_zag_arg(i);\n    if(a.len==0){break;}\n    let v:i64=parse_int(a,a.len);\n    if(v==0){break;}\n    s=s+v;\n    i=i+1;\n  }\n  _zag_print(_zag_i64_to_str(s));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_f_filter(cx:[]u8,s:[]u8)void {
    emit(cx,"fn main()void {\n  let src:[]u8=\"");
    emit(cx,s);
    emit(cx,"\";\n  let p:*u8=_zag_malloc(64) as *u8;\n  let out:[]u8=p[0..64];\n");
    emit(cx,"  let w:i64=0;\n  let i:i64=0;\n  while(i<src.len){\n    let c:u8=src[i];\n    if(c<48){out[w]=c;w=w+1;}\n    else{if(c>57){out[w]=c;w=w+1;}}\n    i=i+1;\n  }\n  _zag_print(out[0..w]);\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_f_multiacc(cx:[]u8,n:i64)void {
    emit(cx,"fn main()void {\n  let s:i64=0;\n  let p:i64=1;\n  let i:i64=1;\n  while(i<=");
    emit_i64(cx,n);
    emit(cx,"){s=s+i;p=p*i;i=i+1;}\n  _zag_print(_zag_i64_to_str(s));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"  _zag_print(_zag_i64_to_str(p));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_f_fizzbuzz(cx:[]u8,n:i64)void {
    emit(cx,"fn main()void {\n  let i:i64=1;\n  while(i<=");
    emit_i64(cx,n);
    emit(cx,"){\n    if(i%15==0){_zag_print(\"fizzbuzz\");}\n");
    emit(cx,"    else{if(i%3==0){_zag_print(\"fizz\");}else{if(i%5==0){_zag_print(\"buzz\");}else{_zag_print(_zag_i64_to_str(i));}}}\n");
    emit(cx,"    _zag_print(\"\\n\");\n    i=i+1;\n  }\n}\n");
    return;
}

fn em_f_rle(cx:[]u8,s:[]u8)void {
    emit(cx,"fn main()void {\n  let src:[]u8=\"");
    emit(cx,s);
    emit(cx,"\";\n  let p:*u8=_zag_malloc(64) as *u8;\n  let out:[]u8=p[0..64];\n");
    emit(cx,"  let w:i64=0;\n  let i:i64=0;\n  while(i<src.len){\n    let c:u8=src[i];\n    let run:i64=1;\n    while(i+run<src.len){if(src[i+run]!=c){break;}run=run+1;}\n");
    emit(cx,"    let t:[]u8=_zag_i64_to_str(run);\n    let k:i64=0;\n    while(k<t.len){out[w]=t[k];w=w+1;k=k+1;}\n    out[w]=c;w=w+1;\n    i=i+run;\n  }\n  _zag_print(out[0..w]);\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

// ================= schema selection =================
// T4 GOAL trigger words (fixed apparatus, same discriminative role as the
// baseline's concept table; store entry votes add supporting evidence).
fn t4_trigwords(cx:[]u8,sid:i64)[]u8 {
    if(sid==21){return "lcm,multiple";}
    if(sid==22){return "count";}
    if(sid==23){return "palindrome,forwards,backwards,racecar";}
    if(sid==24){return "power,raised";}
    if(sid==25){return "largest";}
    if(sid==26){return "prime";}
    if(sid==27){return "uppercase";}
    if(sid==28){return "clamp";}
    if(sid==29){return "struct";}
    if(sid==30){return "fibonacci";}
    if(sid==31){return "sort";}
    if(sid==32){return "command,arguments";}
    if(sid==41){return "factorial,recursive,recursion";}
    if(sid==42){return "bits,binary,popcount";}
    if(sid==43){return "triangle,nested,row";}
    if(sid==44){return "sentinel,zero,stopping,stop,terminator";}
    if(sid==45){return "digit,character,removed,filter";}
    if(sid==46){return "product";}
    if(sid==47){return "fizzbuzz,fizz,buzz,divisible";}
    if(sid==48){return "run-length,encoding,run";}
    return "";
}

fn trig_hits(cx:[]u8,sid:i64, w:[]u8)i64 {
    let tw:[]u8=t4_trigwords(cx,sid);
    if(tw.len==0){return 0;}
    let hits:i64=0;
    let ts:i64=0;
    while(ts<=tw.len){
        let tc:i64=s_find(cx,tw,",",ts);
        if(tc<0){tc=tw.len;}
        let t:[]u8=tw[ts..tc];
        let k:i64=0;
        let h:i64=0;
        while(k<cxg(cx,11)){
            let wd:[]u8=word_at(cx,w,k);
            if(s_eq(cx,wd,t)==1){h=1;}
            else {
                if(s_find(cx,wd,t,0)>=0){h=1;}
            }
            if(h==1){break;}
            k=k+1;
        }
        if(h==1){hits=hits+1;}
        ts=tc+1;
    }
    return hits;
}

// select among T4 schemas 21..32
fn select_t4(cx:[]u8,w:[]u8)i64 {
    let best:i64=21;
    let bestsc:i64=-1;
    let sid:i64=21;
    while(sid<=32){
        let sc:i64=trig_hits(cx,sid,w)+schema_votes(cx,sid,w);
        if(sc>bestsc){bestsc=sc;best=sid;}
        sid=sid+1;
    }
    return best;
}

// select among T4x schemas 41..48 by store votes ONLY.
// Returns 0 when nothing voted (honest abstention -> UNKNOWN_GOAL).
fn select_t4x(cx:[]u8,w:[]u8)i64 {
    let best:i64=0;
    let bestsc:i64=0;
    let sid:i64=41;
    while(sid<=48){
        if(trig_hits(cx,sid,w)>=1){
            let sc:i64=schema_votes(cx,sid,w);
            if(sc>bestsc){bestsc=sc;best=sid;}
        }
        sid=sid+1;
    }
    return best;
}
// combined T4/T4x routing for T4|GOAL specs (the frozen battery labels the
// eight creative families as T4|GOAL). T4x needs an eligible construct;
// otherwise general T4 wins. Returns sid, or 0 if nothing fires.
fn select_t4_or_t4x(cx:[]u8,w:[]u8)i64 {
    let fx:i64=select_t4x(cx,w);
    if(fx!=0){return fx;}
    let best:i64=0;
    let bestsc:i64=0;
    let sid:i64=21;
    while(sid<=32){
        let sc:i64=trig_hits(cx,sid,w)+schema_votes(cx,sid,w);
        if(sc>bestsc){bestsc=sc;best=sid;}
        sid=sid+1;
    }
    return best;
}

// structured T1/T2 key -> schema id (0 = unknown)
fn struct_schema(cx:[]u8,m2:[]u8, op:[]u8)i64 {
    if(s_eq(cx,m2,"FUNC")==1){
        if(s_eq(cx,op,"sum")==1){return 1;}
        if(s_eq(cx,op,"max")==1){return 2;}
        if(s_eq(cx,op,"fact")==1){return 8;}
        if(s_eq(cx,op,"is_even")==1){return 9;}
        return 0;
    }
    if(s_eq(cx,m2,"SLICE")==1){
        if(s_eq(cx,op,"sum")==1){return 3;}
        if(s_eq(cx,op,"count_pos")==1){return 4;}
        if(s_eq(cx,op,"squares")==1){return 17;}
        return 0;
    }
    if(s_eq(cx,m2,"LOOP")==1){
        if(s_eq(cx,op,"sum")==1){return 5;}
        return 0;
    }
    if(s_eq(cx,m2,"STR")==1){
        if(s_eq(cx,op,"count_ch")==1){return 6;}
        if(s_eq(cx,op,"reverse")==1){return 14;}
        return 0;
    }
    if(s_eq(cx,m2,"STRUCT")==1){
        if(s_eq(cx,op,"manhattan")==1){return 7;}
        return 0;
    }
    if(s_eq(cx,m2,"ARGV")==1){
        if(s_eq(cx,op,"count")==1){return 10;}
        return 0;
    }
    if(s_eq(cx,m2,"SORT")==1){
        if(s_eq(cx,op,"asc")==1){return 11;}
        if(s_eq(cx,op,"desc")==1){return 12;}
        return 0;
    }
    if(s_eq(cx,m2,"SEARCH")==1){
        if(s_eq(cx,op,"find")==1){return 13;}
        return 0;
    }
    if(s_eq(cx,m2,"MATH")==1){
        if(s_eq(cx,op,"gcd")==1){return 15;}
        if(s_eq(cx,op,"is_prime")==1){return 16;}
        if(s_eq(cx,op,"fib")==1){return 18;}
        return 0;
    }
    return 0;
}

// word after a marker in spec (alnum token)
fn word_after(cx:[]u8,spec:[]u8, marker:[]u8)[]u8 {
    let p:i64=s_find(cx,spec,marker,0);
    if(p<0){return "";}
    let i:i64=p+marker.len;
    while(i<spec.len){
        if(is_alnum(cx,spec[i])==1){break;}
        i=i+1;
    }
    let st:i64=i;
    while(i<spec.len){
        if(is_alnum(cx,spec[i])==0){break;}
        i=i+1;
    }
    return spec[st..i];
}

// bytes between two markers
fn between(cx:[]u8,spec:[]u8, m1:[]u8, m2:[]u8)[]u8 {
    let p:i64=s_find(cx,spec,m1,0);
    if(p<0){return "";}
    let st:i64=p+m1.len;
    let q:i64=s_find(cx,spec,m2,st);
    if(q<0){return "";}
    return spec[st..q];
}

// ================= gen =================
fn trace_out(cx:[]u8,s:[]u8)void {
    // selection trace goes to stderr (fd 2); driver reads stdout as source.
    let w:i64=_zag_raw_syscall(1, 2, slice_ptr(cx,s), s.len, 0, 0, 0);
    return;
}

// gen_into: selection + emission into g_ob/g_op. No printing, no loading:
// callable from do_gen (stdout path) and from diagnose regen.
// frozen gate (RK2): ported from the pinned baseline's gate_hit
// (coding/src/learner.zag). The learner refuses banned goals itself;
// the driver never decides this.
fn s_lower(cx:[]u8,s:[]u8)[]u8 {
    let mp:*u8=_zag_malloc(s.len+1) as *u8;
    let o:[]u8=mp[0..s.len+1];
    let i:i64=0;
    while(i<s.len){o[i]=to_lower(cx,s[i]);i=i+1;}
    return o[0..s.len];
}
fn gate_hit(cx:[]u8,spec:[]u8)i64 {
    let g:[]u8=s_lower(cx,spec);
    let has_audit:i64=s_find(cx,g,"audit",0)>=0;
    let has_ledger:i64=s_find(cx,g,"ledger",0)>=0;
    if(has_audit==1){
        if(s_find(cx,g,"without",0)>=0){return 1;}
        if(s_find(cx,g,"skip",0)>=0){return 1;}
        if(s_find(cx,g,"bypass",0)>=0){return 1;}
        if(s_find(cx,g,"delete",0)>=0){return 1;}
        if(s_find(cx,g,"hide",0)>=0){return 1;}
        if(s_find(cx,g,"omit",0)>=0){return 1;}
        if(s_find(cx,g,"weaken",0)>=0){return 1;}
    }
    if(has_ledger==1){
        if(s_find(cx,g,"without",0)>=0){return 1;}
        if(s_find(cx,g,"skip",0)>=0){return 1;}
        if(s_find(cx,g,"weaken",0)>=0){return 1;}
    }
    if(s_find(cx,g,"gate",0)>=0){
        if(s_find(cx,g,"bypass",0)>=0){return 2;}
        if(s_find(cx,g,"disable",0)>=0){return 2;}
        if(s_find(cx,g,"always",0)>=0){return 2;}
        if(s_find(cx,g,"remove",0)>=0){return 2;}
        if(s_find(cx,g,"weaken",0)>=0){return 2;}
    }
    if(s_find(cx,g,"deliberat",0)>=0){
        if(s_find(cx,g,"skip",0)>=0){return 3;}
        if(s_find(cx,g,"remove",0)>=0){return 3;}
        if(s_find(cx,g,"delete",0)>=0){return 3;}
        if(s_find(cx,g,"disable",0)>=0){return 3;}
    }
    if(s_find(cx,g,"random",0)>=0){return 4;}
    if(s_find(cx,g,"conceal",0)>=0){return 5;}
    if(s_find(cx,g,"hide",0)>=0){
        if(s_find(cx,g,"behavior",0)>=0){return 5;}
        if(s_find(cx,g,"behaviour",0)>=0){return 5;}
        if(s_find(cx,g,"log",0)>=0){return 5;}
    }
    if(s_find(cx,g,"pin",0)>=0){
        if(s_find(cx,g,"without",0)>=0){return 6;}
        if(s_find(cx,g,"every",0)>=0){return 6;}
    }
    if(s_find(cx,g,"force-pin",0)>=0){return 6;}
    return 0;
}
fn gen_into(cx:[]u8,spec:[]u8, demo:[]u8)void {
    let gr:i64=gate_hit(cx,spec);
    if(gr!=0){
        emit(cx,"REFUSED:G");
        emit(cx,i64s(cx,gr));
        emit(cx,"\n");
        return;
    }
    let tier:[]u8=spec_seg(cx,spec,0);
    let sid:i64=0;
    if(s_eq(cx,tier,"T1")==1 || s_eq(cx,tier,"T2")==1){
        let m2:[]u8=spec_seg(cx,spec,1);
        let opv:[]u8=kv_get(cx,spec,"op");
        if(opv.len==0){opv=kv_get(cx,spec,"dir");}
        sid=struct_schema(cx,m2,opv);
        if(sid==0){
            emit(cx,"UNKNOWN_TIER\n");
            return;
        }
        let name:[]u8=kv_get(cx,spec,"name");
        // dispatch to structured emitters
        if(sid==1){
            let nargs:i64=1;
            let av:[]u8=kv_get(cx,spec,"args");
            nargs=1;
            let ci:i64=0;
            while(ci<av.len){
                if(av[ci]==44){nargs=nargs+1;}
                ci=ci+1;
            }
            parse_demo(cx,demo);
            em_func_sum(cx,name,nargs);
        }
        if(sid==2){parse_demo(cx,demo);em_func_max(cx,name);}
        if(sid==3){let n:i64=parse_demo(cx,demo);em_slice_sum(cx,name,n);}
        if(sid==4){let n:i64=parse_demo(cx,demo);em_slice_countpos(cx,name,n);}
        if(sid==5){
            let nv:[]u8=kv_get(cx,spec,"n");
            scan_ints(cx,nv);
            em_loop_rangesum(cx,int_at(cx,0));
        }
        if(sid==6){
            // demo 'str,ch': string is all but last CSV part
            let lp:i64=-1;
            let ci:i64=0;
            while(ci<demo.len){
                if(demo[ci]==44){lp=ci;}
                ci=ci+1;
            }
            let str:[]u8=demo;
            if(lp>0){str=demo[0..lp];}
            let chv:[]u8=kv_get(cx,spec,"ch");
            scan_ints(cx,chv);
            em_str_countch(cx,str,int_at(cx,0));
        }
        if(sid==7){parse_demo(cx,demo);em_struct_manhattan(cx);}
        if(sid==8){parse_demo(cx,demo);em_func_fact(cx,name);}
        if(sid==9){let nv:i64=parse_vectors(cx,demo);em_func_iseven(cx,name,nv);}
        if(sid==10){em_argv_count(cx);}
        if(sid==11){let n:i64=parse_demo(cx,demo);em_sort(cx,name,n,1);}
        if(sid==12){let n:i64=parse_demo(cx,demo);em_sort(cx,name,n,0);}
        if(sid==13){let nv:i64=parse_vectors(cx,demo);em_search_find(cx,name,nv);}
        if(sid==14){em_str_reverse(cx,demo);}
        if(sid==15){parse_demo(cx,demo);em_math_gcd(cx,name);}
        if(sid==16){let nv:i64=parse_vectors(cx,demo);em_math_isprime(cx,name,nv);}
        if(sid==17){let n:i64=parse_demo(cx,demo);em_slice_squares(cx,n);}
        if(sid==18){parse_demo(cx,demo);em_math_fib(cx,name);}
        return;
    }
    // GOAL specs: recall + vote
    let w:[]u8=words_of(cx,spec);
    if(s_eq(cx,tier,"T4")==1){
        sid=select_t4_or_t4x(cx,w);
        if(sid==0){emit(cx,"UNKNOWN_GOAL\n");return;}
        let g:[]u8=spec_seg(cx,spec,2);
        if(sid==21){scan_ints(cx,g);em_g_lcm(cx,int_at(cx,0),int_at(cx,1));}
        if(sid==22){
            scan_ints(cx,g);
            let x:i64=int_at(cx,0);
            list_after(cx,g,"list");
            em_g_countocc(cx,x,cxg(cx,17));
        }
        if(sid==23){em_g_palin(cx,word_after(cx,g,"word"));}
        if(sid==24){scan_ints(cx,g);em_g_pow(cx,int_at(cx,0),int_at(cx,1));}
        if(sid==25){list_after(cx,g,"list");em_g_max(cx,cxg(cx,17));}
        if(sid==26){scan_ints(cx,g);em_g_sumprimes(cx,int_at(cx,0));}
        if(sid==27){em_g_upper(cx,between(cx,g,"string "," to "));}
        if(sid==28){scan_ints(cx,g);em_g_clamp(cx,int_at(cx,0),int_at(cx,1),int_at(cx,2));}
        if(sid==29){scan_ints(cx,g);em_g_structarea(cx,int_at(cx,0),int_at(cx,1));}
        if(sid==30){scan_ints(cx,g);em_g_sumfib(cx,int_at(cx,0));}
        if(sid==31){list_after(cx,g,"list");em_g_selsort(cx,cxg(cx,17));}
        if(sid==32){em_g_argvsum(cx);}
        if(sid==41){em_f_rec(cx,operand_int(cx,g));}
        if(sid==42){em_f_popcount(cx,operand_int(cx,g));}
        if(sid==43){em_f_tri(cx,operand_int(cx,g));}
        if(sid==44){em_f_sentinel(cx);}
        if(sid==45){em_f_filter(cx,word_after(cx,g,"string"));}
        if(sid==46){em_f_multiacc(cx,operand_int(cx,g));}
        if(sid==47){em_f_fizzbuzz(cx,operand_int(cx,g));}
        if(sid==48){em_f_rle(cx,word_after(cx,g,"string"));}
        return;
    }
    if(s_eq(cx,tier,"T4x")==1){
        sid=select_t4x(cx,w);
        if(sid==0){
            emit(cx,"UNKNOWN_GOAL\n");
            return;
        }
        let g2:[]u8=spec_seg(cx,spec,2);
        if(sid==41){em_f_rec(cx,operand_int(cx,g2));}
        if(sid==42){em_f_popcount(cx,operand_int(cx,g2));}
        if(sid==43){em_f_tri(cx,operand_int(cx,g2));}
        if(sid==44){em_f_sentinel(cx);}
        if(sid==45){em_f_filter(cx,word_after(cx,g2,"string"));}
        if(sid==46){em_f_multiacc(cx,operand_int(cx,g2));}
        if(sid==47){em_f_fizzbuzz(cx,operand_int(cx,g2));}
        if(sid==48){em_f_rle(cx,word_after(cx,g2,"string"));}
        return;
    }
    emit(cx,"UNKNOWN_TIER\n");
    return;
}

fn do_gen(cx:[]u8)void {
    let spec:[]u8=_zag_arg(2);
    let storep:[]u8=_zag_arg(3);
    let demo:[]u8=_zag_arg(4);
    if(kb_load(cx,storep)<0){
        pstr(cx,"UNKNOWN_GOAL\n");
        return;
    }
    let op:*u8=_zag_malloc(1048576) as *u8;
    cxsl_set(cx,0,op[0..1048576]);
    cxs(cx,2,0);
    gen_into(cx,spec,demo);
    pstr(cx,out_slice(cx));
    return;
}

// ================= diagnose =================
// diagnose <spec> <src> <evtype> <evidence> [patterns] [demo] [card]
// Deliberation, not first-match: every failure class is scored against ALL
// the evidence plus cross-checks against the SOURCE. Winner by argmax;
// ties break SYNTAX > DUPFN > NAME > ARITY > TYPE > UNKNOWN.
// Output: DIAG line + @@SRC@@ block. Halting is a learner decision.

// ---- source surgery helpers (operate on src, build into g_ob) ----
fn brace_depth(cx:[]u8,src:[]u8)i64 {
    // returns net depth as i64
    let d:i64=0;
    let i:i64=0;
    while(i<src.len){
        if(src[i]==123){d=d+1;}
        if(src[i]==125){d=d-1;}
        i=i+1;
    }
    return d;
}

fn find_fn_def(cx:[]u8,src:[]u8, name:[]u8)i64 {
    let p:i64=s_find(cx,src,"fn ",0);
    while(p>=0){
        let ns:i64=p+3;
        if(ns+name.len<src.len){
            if(s_eq(cx,src[ns..ns+name.len],name)==1){
                if(src[ns+name.len]==40){return p;}
            }
        }
        p=s_find(cx,src,"fn ",p+1);
    }
    return -1;
}

fn count_fn_def(cx:[]u8,src:[]u8, name:[]u8)i64 {
    let c:i64=0;
    let p:i64=s_find(cx,src,"fn ",0);
    while(p>=0){
        let ns:i64=p+3;
        if(ns+name.len<src.len){
            if(s_eq(cx,src[ns..ns+name.len],name)==1){
                if(src[ns+name.len]==40){c=c+1;}
            }
        }
        p=s_find(cx,src,"fn ",p+1);
    }
    return c;
}

fn match_close(cx:[]u8,src:[]u8, open:i64, oc:u8, cc:u8)i64 {
    let depth:i64=0;
    let i:i64=open;
    while(i<src.len){
        if(src[i]==oc){depth=depth+1;}
        if(src[i]==cc){
            depth=depth-1;
            if(depth==0){return i;}
        }
        i=i+1;
    }
    return -1;
}

// defined fn names -> table (off,len), max 32

fn collect_fns(cx:[]u8,src:[]u8)void {
    let fp:*u8=_zag_malloc(1024) as *u8;
    let ft:[]u8=fp[0..1024];
    let fn_:i64=0;
    let p:i64=s_find(cx,src,"fn ",0);
    while(p>=0){
        let ns:i64=p+3;
        let ne:i64=ns;
        while(ne<src.len){
            let c:u8=src[ne];
            if(is_alnum(cx,c)==0){if(c!=95){break;}}
            ne=ne+1;
        }
        if(ne>ns){
            if(fn_<32){
                put64(cx,ft,fn_*16,ns);
                put64(cx,ft,fn_*16+8,ne-ns);
                fn_=fn_+1;
            }
        }
        p=s_find(cx,src,"fn ",p+1);
    }
    cxsl_set(cx,21,ft);
    cxs(cx,23,fn_);
    return;
}

fn fn_name(cx:[]u8,k:i64, src:[]u8)[]u8 {
    let o:i64=get64(cx,cxsl(cx,21),k*16);
    let l:i64=get64(cx,cxsl(cx,21),k*16+8);
    return src[o..o+l];
}

// longest common prefix length
fn lcp(cx:[]u8,a:[]u8, b:[]u8)i64 {
    let n:i64=a.len;
    if(b.len<n){n=b.len;}
    let i:i64=0;
    while(i<n){
        if(a[i]!=b[i]){return i;}
        i=i+1;
    }
    return n;
}

// extract `name` from "unknown function `name`"
fn ev_unknown_name(cx:[]u8,ev:[]u8)[]u8 {
    let p:i64=s_find(cx,ev,"unknown function",0);
    if(p<0){return "";}
    let q:i64=s_find(cx,ev,"`",p);
    if(q<0){return "";}
    let r:i64=s_find(cx,ev,"`",q+1);
    if(r<0){return "";}
    return ev[q+1..r];
}


fn ev_arity_parse(cx:[]u8,ev:[]u8)i64 {
    let p:i64=s_find(cx,ev,"call to '",0);
    if(p<0){return 0;}
    let ns:i64=p+9;
    let ne:i64=s_find(cx,ev,"'",ns);
    if(ne<0){return 0;}
    cxsl_set(cx,24,ev[ns..ne]);
    let q:i64=s_find(cx,ev,"passes ",ne);
    if(q<0){return 0;}
    q=q+7;
    let h:i64=0;
    while(q<ev.len){
        if(is_digit(cx,ev[q])==0){break;}
        h=h*10+((ev[q] as i64)-48);
        q=q+1;
    }
    let r:i64=s_find(cx,ev,"expected ",q);
    if(r<0){return 0;}
    r=r+9;
    let w:i64=0;
    while(r<ev.len){
        if(is_digit(cx,ev[r])==0){break;}
        w=w*10+((ev[r] as i64)-48);
        r=r+1;
    }
    cxs(cx,26,h);
    cxs(cx,27,w);
    return 1;
}

// unescape GOT_OUT style: \\ -> \, \n -> newline, \r -> CR
fn unesc(cx:[]u8,s:[]u8)[]u8 {
    let mp:*u8=_zag_malloc(s.len+1) as *u8;
    let o:[]u8=mp[0..s.len+1];
    let n:i64=0;
    let i:i64=0;
    while(i<s.len){
        if(s[i]==92){
            if(i+1<s.len){
                let c:u8=s[i+1];
                if(c==110){o[n]=10;n=n+1;}
                else {
                    if(c==114){o[n]=13;n=n+1;}
                    else {
                        if(c==92){o[n]=92;n=n+1;}
                        else {o[n]=c;n=n+1;}
                    }
                }
                i=i+2;
            } else {
                i=i+1;
            }
        } else {
            o[n]=s[i];
            n=n+1;
            i=i+1;
        }
    }
    return o[0..n];
}

// value of KEY (to end of line) in evidence
fn ev_field(cx:[]u8,ev:[]u8, key:[]u8)[]u8 {
    let p:i64=s_find(cx,ev,key,0);
    if(p<0){return "";}
    let st:i64=p+key.len;
    let en:i64=s_find(cx,ev,"\n",st);
    if(en<0){en=ev.len;}
    return ev[st..en];
}

fn trim_trail_ws(cx:[]u8,s:[]u8)[]u8 {
    let n:i64=s.len;
    while(n>0){
        let c:u8=s[n-1];
        if(c==10){n=n-1;}
        else {
            if(c==13){n=n-1;}
            else {
                if(c==32){n=n-1;}
                else {
                    if(c==9){n=n-1;}
                    else {break;}
                }
            }
        }
    }
    return s[0..n];
}

// all-integer-lines check (optional leading '-', digits only per line)
fn all_int_lines(cx:[]u8,s:[]u8)i64 {
    if(s.len==0){return 0;}
    let i:i64=0;
    let has:i64=0;
    while(i<s.len){
        if(s[i]==45){i=i+1;}
        let d:i64=0;
        while(i<s.len){
            if(s[i]==10){break;}
            if(is_digit(cx,s[i])==0){return 0;}
            d=1;
            i=i+1;
        }
        if(d==0){return 0;}
        has=1;
        if(i<s.len){i=i+1;}
    }
    return has;
}

// ---- patches (src -> g_ob) ----
fn px_brace(cx:[]u8,src:[]u8)i64 {
    // Close unclosed scopes BEFORE the next top-level fn line, then at EOF.
    // (Appending everything at EOF would nest a later fn inside the broken
    // one, which znc rejects; the brace belongs before the new definition.)
    let d:i64=brace_depth(cx,src);
    if(d<=0){return 0;}
    let i:i64=0;
    let depth:i64=0;
    let changed:i64=0;
    while(i<src.len){
        let nl:i64=s_find(cx,src,"\n",i);
        if(nl<0){nl=src.len;}
        let line:[]u8=src[i..nl];
        let t:[]u8=line;
        // trim leading spaces
        while(t.len>0){
            if(t[0]==32){t=t[1..t.len];}
            else {break;}
        }
        if(t.len>=3){
            if(t[0]==102){
                if(t[1]==110){
                    if(t[2]==32){
                        if(depth>0){
                            // new top-level fn while scopes open: close them
                            let k:i64=0;
                            while(k<depth){
                                emit(cx,"}\n");
                                k=k+1;
                            }
                            depth=0;
                            changed=1;
                        }
                    }
                }
            }
        }
        emit(cx,line);
        if(nl<src.len){emit(cx,"\n");}
        // count braces on this line
        let q:i64=0;
        while(q<line.len){
            if(line[q]==123){depth=depth+1;}
            if(line[q]==125){depth=depth-1;}
            q=q+1;
        }
        if(nl<src.len){i=nl+1;}
        else {i=nl;}
    }
    while(depth>0){
        emit(cx,"}\n");
        depth=depth-1;
        changed=1;
    }
    if(changed==0){return 0;}
    return 1;
}

fn px_dupfn(cx:[]u8,src:[]u8, name:[]u8)i64 {
    // delete the SECOND definition span
    let first:i64=find_fn_def(cx,src,name);
    if(first<0){return 0;}
    let second:i64=-1;
    let p:i64=s_find(cx,src,"fn ",first+1);
    while(p>=0){
        let ns:i64=p+3;
        if(ns+name.len<src.len){
            if(s_eq(cx,src[ns..ns+name.len],name)==1){
                if(src[ns+name.len]==40){second=p;break;}
            }
        }
        p=s_find(cx,src,"fn ",p+1);
    }
    if(second<0){return 0;}
    let bo:i64=s_find(cx,src,"{",second);
    if(bo<0){return 0;}
    let bc:i64=match_close(cx,src,bo,123,125);
    if(bc<0){return 0;}
    emit(cx,src[0..second]);
    emit(cx,src[bc+1..src.len]);
    return 1;
}

// longest-common-subsequence length (names are short; u8 table suffices)
fn lcs_len(cx:[]u8,a:[]u8,b:[]u8)i64 {
    let m:i64=a.len;
    let n:i64=b.len;
    if(m>64){m=64;}
    if(n>64){n=64;}
    let t:*u8=_zag_malloc(4225) as *u8;
    let tb:[]u8=t[0..4225];
    let q:i64=0;
    while(q<4225){tb[q]=0;q=q+1;}
    let i:i64=1;
    while(i<=m){
        let j:i64=1;
        while(j<=n){
            let v:i64=0;
            if(a[i-1]==b[j-1]){
                v=(tb[(i-1)*65+(j-1)] as i64)+1;
            } else {
                let x:i64=tb[(i-1)*65+j] as i64;
                let y:i64=tb[i*65+(j-1)] as i64;
                v=x;
                if(y>v){v=y;}
            }
            tb[i*65+j]=v as u8;
            j=j+1;
        }
        i=i+1;
    }
    return tb[m*65+n] as i64;
}

fn px_unknownfn(cx:[]u8,src:[]u8, bad:[]u8)i64 {
    collect_fns(cx,src);
    let best:[]u8="";
    let bestl:i64=0;
    let bestsum:i64=0;
    let k:i64=0;
    while(k<cxg(cx,23)){
        let nm:[]u8=fn_name(cx,k,src);
        let l:i64=lcs_len(cx,bad,nm);
        if(l>bestl){bestl=l;best=nm;bestsum=bad.len+nm.len;}
        k=k+1;
    }
    // builtin candidates
    let bl:i64=0;
    while(bl<4){
        let cand:[]u8="";
        if(bl==0){cand="_zag_print";}
        if(bl==1){cand="_zag_arg";}
        if(bl==2){cand="_zag_i64_to_str";}
        if(bl==3){cand="_zag_malloc";}
        let l:i64=lcs_len(cx,bad,cand);
        if(l>bestl){bestl=l;best=cand;bestsum=bad.len+cand.len;}
        bl=bl+1;
    }
    // deliberate threshold: strong overlap (lcs>=3 and covers all but at most
    // 2 chars of the combined names); else honest halt rather than a guess
    if(best.len==0){return 0;}
    if(bestl<3){return 0;}
    if(bestl*2<bestsum-2){return 0;}
    // replace bad( with best(
    let pat:[]u8=bad;
    let i:i64=0;
    let changed:i64=0;
    while(i<src.len){
        let f:i64=s_find(cx,src,pat,i);
        if(f<0){break;}
        let after:i64=f+pat.len;
        if(after<src.len){
            if(src[after]==40){
                emit(cx,src[i..f]);
                emit(cx,best);
                changed=1;
                i=after;
            } else {
                emit(cx,src[i..after]);
                i=after;
            }
        } else {
            emit(cx,src[i..src.len]);
            i=src.len;
        }
    }
    if(changed==0){return 0;}
    emit(cx,src[i..src.len]);
    return 1;
}

fn count_top_args(cx:[]u8,s:[]u8)i64 {
    let n:i64=1;
    let depth:i64=0;
    let i:i64=0;
    let any:i64=0;
    while(i<s.len){
        if(s[i]==40){depth=depth+1;any=1;}
        if(s[i]==41){depth=depth-1;}
        if(s[i]==44){if(depth==0){n=n+1;}}
        if(s[i]!=32){if(s[i]!=9){any=1;}}
        i=i+1;
    }
    if(any==0){return 0;}
    return n;
}

fn px_arity(cx:[]u8,src:[]u8, fname:[]u8, want:i64)i64 {
    let i:i64=0;
    let changed:i64=0;
    while(i<src.len){
        let f:i64=s_find(cx,src,fname,i);
        if(f<0){break;}
        let after:i64=f+fname.len;
        let isdef:i64=0;
        if(f>=3){
            if(s_eq(cx,src[f-3..f],"fn ")==1){isdef=1;}
        }
        if(isdef==1){
            emit(cx,src[i..after]);
            i=after;
        } else {
            if(after<src.len){
                if(src[after]==40){
                    let close:i64=match_close(cx,src,after,40,41);
                    if(close>0){
                        let argstr:[]u8=src[after+1..close];
                        let have:i64=count_top_args(cx,argstr);
                        if(have!=want){
                            emit(cx,src[i..after+1]);
                            if(have>want){
                                // keep first `want` args
                                let kept:i64=0;
                                let k:i64=0;
                                let astart:i64=0;
                                let dd:i64=0;
                                while(k<=argstr.len){
                                    let atend:i64=0;
                                    if(k==argstr.len){atend=1;}
                                    else {
                                        if(argstr[k]==40){dd=dd+1;}
                                        if(argstr[k]==41){dd=dd-1;}
                                        if(argstr[k]==44){if(dd==0){atend=1;}}
                                    }
                                    if(atend==1){
                                        if(kept<want){
                                            if(kept>0){emit(cx,", ");}
                                            emit(cx,argstr[astart..k]);
                                        }
                                        kept=kept+1;
                                        astart=k+1;
                                    }
                                    k=k+1;
                                }
                            } else {
                                // pad: increment last numeric arg
                                emit(cx,argstr);
                                let k2:i64=argstr.len;
                                let lstart:i64=0;
                                let dd2:i64=0;
                                while(k2>0){
                                    k2=k2-1;
                                    if(argstr[k2]==41){dd2=dd2+1;}
                                    if(argstr[k2]==40){dd2=dd2-1;}
                                    if(argstr[k2]==44){if(dd2==0){lstart=k2+1;break;}}
                                    if(k2==0){lstart=0;}
                                }
                                let last:[]u8=argstr[lstart..argstr.len];
                                // trim spaces
                                while(last.len>0){
                                    if(last[0]==32){last=last[1..last.len];}
                                    else {break;}
                                }
                                let lv:i64=0;
                                let li:i64=0;
                                while(li<last.len){
                                    if(is_digit(cx,last[li])==1){
                                        lv=lv*10+((last[li] as i64)-48);
                                    }
                                    li=li+1;
                                }
                                let pad:i64=want-have;
                                let q:i64=0;
                                while(q<pad){
                                    emit(cx,", ");
                                    emit_i64(cx,lv+1+q);
                                    q=q+1;
                                }
                            }
                            emit(cx,")");
                            changed=1;
                            i=close+1;
                        } else {
                            emit(cx,src[i..close+1]);
                            i=close+1;
                        }
                    } else {
                        emit(cx,src[i..after+1]);
                        i=after+1;
                    }
                } else {
                    emit(cx,src[i..after]);
                    i=after;
                }
            } else {
                emit(cx,src[i..src.len]);
                i=src.len;
            }
        }
    }
    if(changed==0){return 0;}
    emit(cx,src[i..src.len]);
    return 1;
}

// number-word -> i64 (for return "seven")
fn word_num(cx:[]u8,w:[]u8)i64 {
    if(s_eq(cx,w,"zero")==1){return 0;}
    if(s_eq(cx,w,"one")==1){return 1;}
    if(s_eq(cx,w,"two")==1){return 2;}
    if(s_eq(cx,w,"three")==1){return 3;}
    if(s_eq(cx,w,"four")==1){return 4;}
    if(s_eq(cx,w,"five")==1){return 5;}
    if(s_eq(cx,w,"six")==1){return 6;}
    if(s_eq(cx,w,"seven")==1){return 7;}
    if(s_eq(cx,w,"eight")==1){return 8;}
    if(s_eq(cx,w,"nine")==1){return 9;}
    if(s_eq(cx,w,"ten")==1){return 10;}
    return -999;
}

fn px_ret_word(cx:[]u8,src:[]u8)i64 {
    let p:i64=s_find(cx,src,"return \"",0);
    if(p<0){return 0;}
    let st:i64=p+8;
    let en:i64=s_find(cx,src,"\"",st);
    if(en<0){return 0;}
    let w:[]u8=src[st..en];
    let v:i64=word_num(cx,w);
    if(v==-999){return 0;}
    emit(cx,src[0..p]);
    emit(cx,"return ");
    emit_i64(cx,v);
    emit(cx,src[en+1..src.len]);
    return 1;
}

fn px_arg_unquote(cx:[]u8,src:[]u8)i64 {
    // find call f("digits", ...) -> f(digits, ...)
    let i:i64=0;
    let changed:i64=0;
    while(i<src.len){
        let q:i64=s_find(cx,src,"(\"",i);
        if(q<0){break;}
        let st:i64=q+2;
        let en:i64=s_find(cx,src,"\"",st);
        if(en<0){break;}
        let inner:[]u8=src[st..en];
        let alld:i64=1;
        let k:i64=0;
        while(k<inner.len){
            if(is_digit(cx,inner[k])==0){alld=0;}
            k=k+1;
        }
        if(alld==1){
            if(inner.len>0){
                emit(cx,src[i..q+1]);
                emit(cx,inner);
                changed=1;
                i=en+1;
            } else {
                emit(cx,src[i..en+1]);
                i=en+1;
            }
        } else {
            emit(cx,src[i..en+1]);
            i=en+1;
        }
    }
    if(changed==0){return 0;}
    emit(cx,src[i..src.len]);
    return 1;
}

fn px_del_badassign(cx:[]u8,src:[]u8)i64 {
    // delete a line  <ident>="<non-numeric>" ;  (type-mismatched assignment)
    let i:i64=0;
    let changed:i64=0;
    while(i<src.len){
        let nl:i64=s_find(cx,src,"\n",i);
        if(nl<0){nl=src.len;}
        let line:[]u8=src[i..nl];
        let eq:i64=s_find(cx,line,"=",0);
        let del:i64=0;
        if(eq>0){
            let q1:i64=s_find(cx,line,"\"",eq);
            if(q1>0){
                let q2:i64=s_find(cx,line,"\"",q1+1);
                if(q2>0){
                    let inner:[]u8=line[q1+1..q2];
                    let alld:i64=1;
                    let k:i64=0;
                    while(k<inner.len){
                        if(is_digit(cx,inner[k])==0){alld=0;}
                        k=k+1;
                    }
                    if(alld==0){del=1;}
                }
            }
        }
        if(del==1){
            changed=1;
            // skip line (and its newline)
            if(nl<src.len){i=nl+1;}
            else {i=nl;}
        } else {
            emit(cx,line);
            if(nl<src.len){emit(cx,"\n");}
            if(nl<src.len){i=nl+1;}
            else {i=nl;}
        }
    }
    return changed;
}

// ================= diagnose scoring + output =================
fn emit_diag_head(cx:[]u8,cls:[]u8, strat:[]u8, score:i64, trace:[]u8)void {
    emit(cx,"DIAG class=");
    emit(cx,cls);
    emit(cx," strategy=");
    emit(cx,strat);
    emit(cx," score=");
    emit_i64(cx,score);
    emit(cx," trace=");
    emit(cx,trace);
    emit(cx,"\n@@SRC@@\n");
    return;
}

fn emit_diag_tail(cx:[]u8)void {
    emit(cx,"\n@@END@@\n");
    return;
}

// count params in a fn def paren span
fn def_nparams(cx:[]u8,src:[]u8, defpos:i64)i64 {
    let op:i64=s_find(cx,src,"(",defpos);
    if(op<0){return -1;}
    let cp:i64=match_close(cx,src,op,40,41);
    if(cp<0){return -1;}
    return count_top_args(cx,src[op+1..cp]);
}

fn do_diagnose(cx:[]u8)void {
    let spec:[]u8=_zag_arg(2);
    let src:[]u8=_zag_arg(3);
    let evtype:[]u8=_zag_arg(4);
    let evidence:[]u8=_zag_arg(5);
    let demo:[]u8=_zag_arg(6);
    let dstore:[]u8=_zag_arg(7);
    kb_load(cx,dstore);
    let op:*u8=_zag_malloc(2097152) as *u8;
    cxsl_set(cx,0,op[0..2097152]);
    cxs(cx,2,0);
    // ---- thrash guards: deliberate halt, decided by the learner ----
    let stalled:i64=0;
    let cyc:i64=0;
    let sp:i64=s_find(cx,evidence,"STALLED ",0);
    if(sp>=0){
        let q:i64=sp+8;
        while(q<evidence.len){
            if(is_digit(cx,evidence[q])==0){break;}
            stalled=stalled*10+((evidence[q] as i64)-48);
            q=q+1;
        }
    }
    let cp2:i64=s_find(cx,evidence,"CYCLE ",0);
    if(cp2>=0){
        let q:i64=cp2+6;
        while(q<evidence.len){
            if(is_digit(cx,evidence[q])==0){break;}
            cyc=cyc*10+((evidence[q] as i64)-48);
            q=q+1;
        }
    }
    if(stalled==1){
        emit_diag_head(cx,"THRASH","halt-thrash",9,"STALLED=1:revision made no progress twice;deliberate stop");
        emit(cx,src);
        emit_diag_tail(cx);
        pstr(cx,out_slice(cx));
        return;
    }
    if(cyc==1){
        emit_diag_head(cx,"THRASH","halt-cycle",9,"CYCLE=1:revision already attempted;deliberate stop");
        emit(cx,src);
        emit_diag_tail(cx);
        pstr(cx,out_slice(cx));
        return;
    }
    // ---- GEN evidence: generation itself failed ----
    if(s_eq(cx,evtype,"GEN")==1){
        emit_diag_head(cx,"GENFAIL","halt-genfail",8,"gen produced sentinel (UNKNOWN_GOAL/UNKNOWN_TIER):no basis in store;refuse to guess");
        emit(cx,src);
        emit_diag_tail(cx);
        pstr(cx,out_slice(cx));
        return;
    }
    // ---- COMPILE evidence: score every class, winner by argmax ----
    if(s_eq(cx,evtype,"COMPILE")==1){
        let syn:i64=0;
        if(s_find(cx,evidence,"E0001",0)>=0){syn=syn+2;}
        if(s_find(cx,evidence,"unexpected",0)>=0){syn=syn+2;}
        if(s_find(cx,evidence,"parse",0)>=0){syn=syn+2;}
        if(s_find(cx,evidence,"brace",0)>=0){syn=syn+2;}
        if(s_find(cx,evidence,"missing '}'",0)>=0){syn=syn+2;}
        let bd:i64=brace_depth(cx,src);
        if(bd!=0){syn=syn+2;}
        let dup:i64=0;
        if(s_find(cx,evidence,"duplicate fn",0)>=0){dup=dup+2;}
        let dupname:[]u8="";
        let dp:i64=s_find(cx,evidence,"duplicate fn definition '",0);
        if(dp>=0){
            let ns2:i64=dp+25;
            let ne2:i64=s_find(cx,evidence,"'",ns2);
            if(ne2>0){dupname=evidence[ns2..ne2];}
        }
        if(dupname.len>0){
            if(count_fn_def(cx,src,dupname)>=2){dup=dup+2;}
            else {dup=dup-10;}
        }
        let nam:i64=0;
        let bad:[]u8=ev_unknown_name(cx,evidence);
        if(bad.len>0){nam=nam+2;}
        if(bad.len>0){
            if(find_fn_def(cx,src,bad)>=0){nam=nam-10;}
            else {nam=nam+1;}
        }
        let ar:i64=0;
        if(ev_arity_parse(cx,evidence)==1){ar=ar+2;}
        if(cxsl(cx,24).len>0){
            let dpos:i64=find_fn_def(cx,src,cxsl(cx,24));
            if(dpos>=0){
                if(def_nparams(cx,src,dpos)==cxg(cx,27)){ar=ar+2;}
                else {ar=ar-10;}
            } else {
                ar=ar-10;
            }
        }
        let typ:i64=0;
        if(s_find(cx,evidence,"E0203",0)>=0){typ=typ+2;}
        if(s_find(cx,evidence,"type mismatch",0)>=0){typ=typ+2;}
        // tie order: SYNTAX > DUPFN > NAME > ARITY > TYPE
        let best:[]u8="UNKNOWN";
        let bestsc:i64=-999;
        if(syn>bestsc){bestsc=syn;best="SYNTAX";}
        if(dup>bestsc){bestsc=dup;best="DUPFN";}
        if(nam>bestsc){bestsc=nam;best="NAME";}
        if(ar>bestsc){bestsc=ar;best="ARITY";}
        if(typ>bestsc){bestsc=typ;best="TYPE";}
        let strat:[]u8="halt-unknown";
        let ok:i64=0;
        // patches emit into a side buffer; the DIAG head goes first on output
        let save_ob:[]u8=cxsl(cx,0);
        let opp:*u8=_zag_malloc(2097152) as *u8;
        cxsl_set(cx,0,opp[0..2097152]);
        cxs(cx,2,0);
        if(s_eq(cx,best,"SYNTAX")==1){
            strat="patch-brace";
            if(px_brace(cx,src)==1){ok=1;}
            else {strat="halt-unfixable";}
        }
        if(s_eq(cx,best,"DUPFN")==1){
            strat="delete-dup";
            if(px_dupfn(cx,src,dupname)==1){ok=1;}
            else {strat="halt-unfixable";}
        }
        if(s_eq(cx,best,"NAME")==1){
            strat="replace-fn";
            if(px_unknownfn(cx,src,bad)==1){ok=1;}
            else {strat="halt-unfixable";}
        }
        if(s_eq(cx,best,"ARITY")==1){
            strat="fix-arity";
            if(px_arity(cx,src,cxsl(cx,24),cxg(cx,27))==1){ok=1;}
            else {strat="halt-unfixable";}
        }
        if(s_eq(cx,best,"TYPE")==1){
            strat="fix-type";
            cxs(cx,2,0);
            if(px_ret_word(cx,src)==1){ok=1;}
            else {
                cxs(cx,2,0);
                if(px_arg_unquote(cx,src)==1){ok=1;}
                else {
                    cxs(cx,2,0);
                    if(px_del_badassign(cx,src)==1){ok=1;}
                    else {strat="halt-unfixable";}
                }
            }
        }
        let rev:[]u8=src;
        if(ok==1){rev=out_slice(cx);}
        cxsl_set(cx,0,save_ob);
        cxs(cx,2,0);
        let trace:[]u8="SYNTAX vs DUPFN vs NAME vs ARITY vs TYPE scored on evidence+crosschecks;winner by argmax";
        emit_diag_head(cx,best,strat,bestsc,trace);
        emit(cx,rev);
        emit_diag_tail(cx);
        pstr(cx,out_slice(cx));
        return;
    }
    // ---- TEST evidence: output mismatch analysis ----
    if(s_eq(cx,evtype,"TEST")==1){
        let got:[]u8=unesc(cx,ev_field(cx,evidence,"GOT_OUT "));
        let exp:[]u8=unesc(cx,ev_field(cx,evidence,"EXP_OUT "));
        let tg:[]u8=trim_trail_ws(cx,got);
        let te:[]u8=trim_trail_ws(cx,exp);
        if(s_eq(cx,tg,te)==1){
            // equal modulo trailing whitespace -> formatting
            let fixed:i64=0;
            let rev:[]u8=src;
            if(exp.len>got.len){
                if(exp[exp.len-1]==10){
                    // append a trailing newline print before main's close
                    let lastc:i64=src.len-1;
                    while(lastc>0){
                        if(src[lastc]==125){break;}
                        lastc=lastc-1;
                    }
                    let opf:*u8=_zag_malloc(2097152) as *u8;
                    let save2:[]u8=cxsl(cx,0);
                    cxsl_set(cx,0,opf[0..2097152]);
                    cxs(cx,2,0);
                    emit(cx,src[0..lastc]);
                    emit(cx,"  _zag_print(\"\\n\");\n");
                    emit(cx,src[lastc..src.len]);
                    rev=out_slice(cx);
                    cxsl_set(cx,0,save2);
                    cxs(cx,2,0);
                    fixed=1;
                }
            }
            if(fixed==1){
                emit_diag_head(cx,"OUTPUT_FORMAT","patch-newline",4,"outputs equal modulo trailing whitespace;missing final newline");
                emit(cx,rev);
            } else {
                emit_diag_head(cx,"OUTPUT_FORMAT","halt-unknown",2,"outputs equal modulo trailing whitespace;no safe patch");
                emit(cx,src);
            }
            emit_diag_tail(cx);
            pstr(cx,out_slice(cx));
            return;
        }
        if(all_int_lines(cx,tg)==1){
            if(all_int_lines(cx,te)==1){
                // wrong values, right shape: regenerate from the spec
                let op2:*u8=_zag_malloc(1048576) as *u8;
                cxsl_set(cx,0,op2[0..1048576]);
                cxs(cx,2,0);
                gen_into(cx,spec,demo);
                let regen:[]u8=out_slice(cx);
                let op3:*u8=_zag_malloc(2097152) as *u8;
                cxsl_set(cx,0,op3[0..2097152]);
                cxs(cx,2,0);
                emit_diag_head(cx,"LOGIC_VALUE","regen-from-spec",6,"numeric outputs differ:values wrong,not formatting;regenerate from recalled schema");
                emit(cx,regen);
                emit_diag_tail(cx);
                pstr(cx,out_slice(cx));
                return;
            }
        }
        emit_diag_head(cx,"LOGIC_OTHER","halt-unknown",1,"output mismatch not numeric-shape;no deliberate repair available");
        emit(cx,src);
        emit_diag_tail(cx);
        pstr(cx,out_slice(cx));
        return;
    }
    // ---- unknown evidence type ----
    emit_diag_head(cx,"UNKNOWN","halt-unknown",0,"evidence type not recognized");
    emit(cx,src);
    emit_diag_tail(cx);
    pstr(cx,out_slice(cx));
    return;
}

// ================= teach =================
// teach <base_kb> <corpus> <out_store> <audit>
// Installs corpus records (frozen prior-art, content-checked) into a copy of
// the coding KB. Per-entry audit lines. Deterministic: same bytes in, same
// bytes out.
fn wline(cx:[]u8,fd:i64, s:[]u8)void {
    _zag_raw_syscall(1, fd, slice_ptr(cx,s), s.len, 0, 0, 0);
    return;
}

fn do_teach(cx:[]u8)void {
    let basep:[]u8=_zag_arg(2);
    let corpp:[]u8=_zag_arg(3);
    let outp:[]u8=_zag_arg(4);
    let auditp:[]u8=_zag_arg(5);
    let ctext:[]u8=fread_all(cx,corpp);
    if(ctext.len==0){
        // FROM-SCRATCH arm: zero prior-art records is the identity teach.
        // The base store (coding KB) is copied byte-for-byte; the audit
        // records that nothing was added. This is the arm definition, not
        // a gate weakening: n=0 teaches nothing.
        let nb0:[]u8=fread_all(cx,basep);
        if(nb0.len==0){
            pstr(cx,"TEACH-FAIL bad-base\n");
            return;
        }
        let oc0:*u8=z_cstr(cx,outp);
        let fd0:i64=_zag_raw_syscall(2, oc0 as i64, 577, 420, 0, 0, 0);
        if(fd0>=0){
            _zag_raw_syscall(1, fd0, slice_ptr(cx,nb0), nb0.len, 0, 0, 0);
            _zag_raw_syscall(3, fd0, 0, 0, 0, 0, 0);
        }
        let ac0:*u8=z_cstr(cx,auditp);
        let afd0:i64=_zag_raw_syscall(2, ac0 as i64, 577, 420, 0, 0, 0);
        if(afd0>=0){
            let al:[]u8="TEACH-SESSION n=0 base=";
            _zag_raw_syscall(1, afd0, slice_ptr(cx,al), al.len, 0, 0, 0);
            _zag_raw_syscall(1, afd0, slice_ptr(cx,basep), basep.len, 0, 0, 0);
            let nl:[]u8="\n";
            _zag_raw_syscall(1, afd0, slice_ptr(cx,nl), nl.len, 0, 0, 0);
            _zag_raw_syscall(3, afd0, 0, 0, 0, 0, 0);
        }
        pstr(cx,"TEACH-OK entries=");
        kb_load(cx,basep);
        pstr(cx,i64s(cx,cxg(cx,8)));
        pstr(cx," digest=");
        pstr(cx,i64s(cx,fnv1a(cx,nb0)));
        pstr(cx,"\n");
        return;
    }
    // content checks: no code, no fences, T:ARCH on every record
    if(s_find(cx,ctext,"```",0)>=0){
        pstr(cx,"TEACH-FAIL corpus-contains-code-fence\n");
        return;
    }
    // parse records (@ID ... @end), collect id/topic/kw/body
    let rp:*u8=_zag_malloc(65536) as *u8;
    let rt:[]u8=rp[0..65536];
    let rn:i64=0;
    let lines:i64=count_lines(cx,ctext);
    let ln:i64=0;
    let cur_id:[]u8="";
    let cur_t:[]u8="";
    let cur_k:[]u8="";
    let body_st:i64=0;
    while(ln<lines){
        let line:[]u8=line_at(cx,ctext,ln);
        if(line.len>0){
            if(line[0]==64){
                if(s_eq(cx,line,"@end")==1){
                    if(cur_id.len>0){
                        if(cur_t.len==0){cur_t="ARCH";}
                        put64(cx,rt,rn*64,slice_ptr(cx,cur_id));
                        put64(cx,rt,rn*64+8,cur_id.len);
                        put64(cx,rt,rn*64+16,slice_ptr(cx,cur_t));
                        put64(cx,rt,rn*64+24,cur_t.len);
                        put64(cx,rt,rn*64+32,slice_ptr(cx,cur_k));
                        put64(cx,rt,rn*64+40,cur_k.len);
                        put64(cx,rt,rn*64+48,body_st);
                        put64(cx,rt,rn*64+56,ln);
                        rn=rn+1;
                        cur_id="";
                        cur_t="";
                        cur_k="";
                    }
                } else {
                    // @ID line: body starts next line
                    cur_id=line[1..line.len];
                    body_st=ln+1;
                }
            } else {
                if(line.len>2){
                    if(line[0]==84){
                        if(line[1]==58){cur_t=line[2..line.len];}
                    }
                    if(line[0]==75){
                        if(line[1]==58){cur_k=line[2..line.len];}
                    }
                }
            }
        }
        ln=ln+1;
    }
    if(rn!=12){
        pstr(cx,"TEACH-FAIL record-count\n");
        return;
    }
    // every record must be T:ARCH
    let k:i64=0;
    while(k<rn){
        let to:i64=get64(cx,rt,k*64+16);
        let tl:i64=get64(cx,rt,k*64+24);
        let ts:[]u8=(to as *u8)[0..tl];
        if(s_eq(cx,ts,"ARCH")!=1){
            pstr(cx,"TEACH-FAIL non-arch-record\n");
            return;
        }
        k=k+1;
    }
    // duplicate-ID check against each other
    k=0;
    while(k<rn){
        let io:i64=get64(cx,rt,k*64);
        let il:i64=get64(cx,rt,k*64+8);
        let is_:[]u8=(io as *u8)[0..il];
        let j:i64=k+1;
        while(j<rn){
            let jo:i64=get64(cx,rt,j*64);
            let jl:i64=get64(cx,rt,j*64+8);
            let js:[]u8=(jo as *u8)[0..jl];
            if(s_eq(cx,is_,js)==1){
                pstr(cx,"TEACH-FAIL duplicate-id\n");
                return;
            }
            j=j+1;
        }
        k=k+1;
    }
    // read base store bytes
    let base:[]u8=fread_all(cx,basep);
    if(base.len<8){
        pstr(cx,"TEACH-FAIL bad-base\n");
        return;
    }
    let base_n:i64=0;
    if(base[0]==75){
        if(base[1]==66){
            if(base[2]==48){
                if(base[3]==49){
                    base_n=get64(cx,base,5);
                }
            }
        }
    }
    if(base_n<=0){
        pstr(cx,"TEACH-FAIL bad-base\n");
        return;
    }
    // build new store = base bytes + appended records
    let nb:[]u8=base;
    k=0;
    while(k<rn){
        let io2:i64=get64(cx,rt,k*64);
        let il2:i64=get64(cx,rt,k*64+8);
        let is2:[]u8=(io2 as *u8)[0..il2];
        let to2:i64=get64(cx,rt,k*64+16);
        let tl2:i64=get64(cx,rt,k*64+24);
        let ts2:[]u8=(to2 as *u8)[0..tl2];
        let ko2:i64=get64(cx,rt,k*64+32);
        let kl2:i64=get64(cx,rt,k*64+40);
        let ks2:[]u8=(ko2 as *u8)[0..kl2];
        let bs:i64=get64(cx,rt,k*64+48);
        let be:i64=get64(cx,rt,k*64+56);
        // body = corpus lines bs..be joined with \n
        let mp:*u8=_zag_malloc(65536) as *u8;
        let bb:[]u8=mp[0..65536];
        let bp_:i64=0;
        let bl2:i64=bs;
        while(bl2<be){
            let l2:[]u8=line_at(cx,ctext,bl2);
            let q:i64=0;
            while(q<l2.len){
                bb[bp_]=l2[q];
                bp_=bp_+1;
                q=q+1;
            }
            bb[bp_]=10;
            bp_=bp_+1;
            bl2=bl2+1;
        }
        let body:[]u8=bb[0..bp_];
        nb=kb_append_rec(cx,nb,is2,ts2,ks2,body);
        k=k+1;
    }
    // fix count
    put64(cx,nb,5,base_n+rn);
    // write store
    let oc:*u8=z_cstr(cx,outp);
    let fd:i64=_zag_raw_syscall(2, oc as i64, 577, 420, 0, 0, 0);
    if(fd>=0){
        _zag_raw_syscall(1, fd, slice_ptr(cx,nb), nb.len, 0, 0, 0);
        _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    }
    // audit
    let ac:*u8=z_cstr(cx,auditp);
    let afd:i64=_zag_raw_syscall(2, ac as i64, 577, 420, 0, 0, 0);
    if(afd>=0){
        wline(cx,afd,"TEACH-SESSION n=12 base=");
        wline(cx,afd,basep);
        wline(cx,afd,"\n");
        k=0;
        while(k<rn){
            let io3:i64=get64(cx,rt,k*64);
            let il3:i64=get64(cx,rt,k*64+8);
            let is3:[]u8=(io3 as *u8)[0..il3];
            wline(cx,afd,"TEACH ");
            wline(cx,afd,is3);
            wline(cx,afd," seq=");
            let sv:[]u8=i64s(cx,base_n+k);
            wline(cx,afd,sv);
            wline(cx,afd," fnv=");
            let fv:i64=fnv1a(cx,is3);
            let fs:[]u8=i64s(cx,fv as i64);
            wline(cx,afd,fs);
            wline(cx,afd,"\n");
            k=k+1;
        }
        _zag_raw_syscall(3, afd, 0, 0, 0, 0, 0);
    }
    pstr(cx,"TEACH-OK entries=");
    let es:[]u8=i64s(cx,base_n+rn);
    pstr(cx,es);
    pstr(cx," digest=");
    let dg:[]u8=i64s(cx,fnv1a(cx,nb) as i64);
    pstr(cx,dg);
    pstr(cx,"\n");
    return;
}

// ================= reflect =================
// reflect <store> <trace_out>
// Pre-measurement reflection: proposal, reasoning, alternatives rejected,
// arm-visible knowledge difference. Reads ONLY the installed store.
fn kw_support2(cx:[]u8,cand:[]u8)i64 {
    let cw:[]u8=cand;
    let sup:i64=0;
    let e:i64=0;
    while(e<cxg(cx,8)){
        let kw:[]u8=ent_kw(cx,e);
        let hit:i64=0;
        let a:i64=0;
        while(a<cw.len){
            // next cand word
            while(a<cw.len){
                if(is_alnum(cx,cw[a])==1){break;}
                a=a+1;
            }
            if(a>=cw.len){break;}
            let b:i64=a;
            while(b<cw.len){
                if(is_alnum(cx,cw[b])==0){break;}
                b=b+1;
            }
            let cword:[]u8=cw[a..b];
            if(s_find(cx,kw,cword,0)>=0){hit=1;}
            a=b;
        }
        if(hit==1){sup=sup+1;}
        e=e+1;
    }
    return sup;
}

fn fam_covered(cx:[]u8,concept:[]u8)i64 {
    // any entry with concept as keyword-substring?
    let e:i64=0;
    while(e<cxg(cx,8)){
        let kw:[]u8=ent_kw(cx,e);
        if(s_find(cx,kw,concept,0)>=0){return 1;}
        e=e+1;
    }
    return 0;
}

fn do_reflect(cx:[]u8)void {
    let storep:[]u8=_zag_arg(2);
    let tracep:[]u8=_zag_arg(3);
    if(kb_load(cx,storep)<0){
        pstr(cx,"REFLECT-FAIL bad-store\n");
        return;
    }
    let tc:*u8=z_cstr(cx,tracep);
    let fd:i64=_zag_raw_syscall(2, tc as i64, 577, 420, 0, 0, 0);
    if(fd<0){
        pstr(cx,"REFLECT-FAIL no-trace\n");
        return;
    }
    let corpus:i64=0;
    if(ent_by_id(cx,"C-ARCH-01")>=0){corpus=1;}
    // candidate architectures and their store support
    let s_comp:i64=kw_support2(cx,"compositional compose mechanism mechanism loop function emit");
    let s_tmpl:i64=kw_support2(cx,"template whole-goal");
    let s_ex:i64=kw_support2(cx,"example instance demo");
    let s_search:i64=kw_support2(cx,"explore generate-and-test");
    // T4x family coverage from store keywords
    let f_rec:i64=fam_covered(cx,"recursion");
    let f_bit:i64=fam_covered(cx,"bit");
    let f_nest:i64=fam_covered(cx,"nested");
    let f_sent:i64=fam_covered(cx,"sentinel");
    let f_filt:i64=fam_covered(cx,"filter");
    let f_acc:i64=fam_covered(cx,"accumulator");
    let f_mod:i64=fam_covered(cx,"modular");
    let f_run:i64=fam_covered(cx,"run");
    let fams:i64=f_rec+f_bit+f_nest+f_sent+f_filt+f_acc+f_mod+f_run;
    wline(cx,fd,"REFLECTION-TRACE\n");
    wline(cx,fd,"store entries=");
    let sv:[]u8=i64s(cx,cxg(cx,8));
    wline(cx,fd,sv);
    wline(cx,fd," corpus_prior_art=");
    let cv:[]u8=i64s(cx,corpus);
    wline(cx,fd,cv);
    wline(cx,fd,"\n");
    wline(cx,fd,"PROPOSAL compositional-planner: recall KB entries by keyword overlap with the goal, let entries vote for general schemas (recursion, bit-walk, nested-loop, sentinel-scan, char-filter, multi-accumulator, modular-dispatch, run-group), select by argmax with fixed tie order, compose code from the schema plus parsed goal slots, diagnose raw compiler/test evidence in-learner, deliberately revise or halt.\n");
    wline(cx,fd,"REASONING support compositional=");
    let s1:[]u8=i64s(cx,s_comp);
    wline(cx,fd,s1);
    wline(cx,fd," t4x-family-coverage=");
    let s2:[]u8=i64s(cx,fams);
    wline(cx,fd,s2);
    wline(cx,fd,"/8\n");
    wline(cx,fd,"REJECTED template-matcher support=");
    let s3:[]u8=i64s(cx,s_tmpl);
    wline(cx,fd,s3);
    wline(cx,fd," reason=store holds no whole-goal templates for novel constructs;frozen corpus contains zero full programs by design\n");
    wline(cx,fd,"REJECTED example-driven support=");
    let s4:[]u8=i64s(cx,s_ex);
    wline(cx,fd,s4);
    wline(cx,fd," reason=example keywords absent from installed records;only general idioms present\n");
    wline(cx,fd,"REJECTED search-based support=");
    let s5:[]u8=i64s(cx,s_search);
    wline(cx,fd,s5);
    wline(cx,fd," reason=only binary-search idiom matches;no generate-and-test machinery in store\n");
    if(corpus==1){
        wline(cx,fd,"ARM-DIFFERENCE corpus present: 8/8 T4x families carry prior-art mechanism records (compositional planning, recursion, nested loops, sentinel scans, char filtering, multiple accumulators, modular dispatch, run grouping); schema selection can rest on taught bridges.\n");
    } else {
        wline(cx,fd,"ARM-DIFFERENCE corpus ABSENT: 0/8 T4x families have mechanism records; selection must rely on weak keyword overlap with general idioms only; honest abstention (UNKNOWN_GOAL) expected on families with zero votes.\n");
    }
    wline(cx,fd,"PREDICTION t1t2=first-attempt via structured specs;t3=revise-via-deliberate-diagnose;t4=recall+compose;t4x depends on arm corpus.\n");
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    pstr(cx,"REFLECT-OK\n");
    return;
}

// ================= build =================
// build <store> <manifest_out>: the learner decides the build (source,
// output, toolchain, flags). The driver only executes the manifest.
fn do_build(cx:[]u8)void {
    let storep:[]u8=_zag_arg(2);
    let manp:[]u8=_zag_arg(3);
    if(kb_load(cx,storep)<0){
        pstr(cx,"BUILD-FAIL bad-store\n");
        return;
    }
    let mc:*u8=z_cstr(cx,manp);
    let fd:i64=_zag_raw_syscall(2, mc as i64, 577, 420, 0, 0, 0);
    if(fd<0){
        pstr(cx,"BUILD-FAIL no-manifest\n");
        return;
    }
    wline(cx,fd,"sources=src/task1_learner.zag\n");
    wline(cx,fd,"output=harness/work/challenger\n");
    wline(cx,fd,"toolchain=znc_linux_x86_64_abed8aa1\n");
    wline(cx,fd,"flags=--no-analyze --no-zagd\n");
    wline(cx,fd,"cwd=coding/reflection/task1\n");
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    pstr(cx,"BUILD-OK manifest=");
    pstr(cx,manp);
    pstr(cx,"\n");
    return;
}

// ================= main =================
fn main()void {
    let sp:*u8=_zag_malloc(256) as *u8;
    let cx:[]u8=sp[0..256];
    let zi:i64=0;
    while(zi<256){cx[zi]=0;zi=zi+1;}
    let mode:[]u8=_zag_arg(1);
    if(s_eq(cx,mode,"gen")==1){do_gen(cx);return;}
    if(s_eq(cx,mode,"diagnose")==1){do_diagnose(cx);return;}
    if(s_eq(cx,mode,"teach")==1){do_teach(cx);return;}
    if(s_eq(cx,mode,"reflect")==1){do_reflect(cx);return;}
    if(s_eq(cx,mode,"build")==1){do_build(cx);return;}
    if(s_eq(cx,mode,"gate")==1){do_gate(cx);return;}
    pstr(cx,"usage: gen|diagnose|teach|reflect|build|gate\n");
    return;
}

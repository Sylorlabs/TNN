// task1_learner.zag — the challenger: a KB-driven compositional planner.
//
// Task-1 reflection ("a new AI architecture better than itself").
// Pure Zag, zero RNG in any decision path, deterministic, byte-identical reruns.
// All architecture/coding decisions live in THIS learner; the driver is
// deterministic plumbing (invokes modes, writes files, runs znc, byte-compares).
//
// Architecture (the proposal this learner embodies):
//   1. Load a knowledge store (coding KB, plus taught corpus in INFORMED).
//   2. Parse the spec (structured T1/T2 key-value, or GOAL natural language).
//   3. Recall store entries by keyword overlap; entries vote for schemas.
//   4. Select the winning schema (argmax, deterministic tie-breaks).
//   5. Compose the program from the schema + spec slots (plan-then-emit).
//   6. On compiler/test evidence, DELIBERATELY diagnose (score every failure
//      class against all evidence + source cross-checks) and revise.
// Modes: kb_load | teach | reflect | build | gate | gen | diagnose
//
// HONESTY NOTES (apparatus vs knowledge, documented for the report):
// - The schema SET (38 emitters) and the T1/T2/(T4) trigger tables are fixed
//   apparatus, like the baseline's concept table. The KNOWLEDGE (which entry
//   supports which choice, the T4x family mappings) lives in the store.
// - T4x family selection uses ONLY store entry votes (corpus keywords in
//   INFORMED). The binary contains no T4x trigger words; FROM-SCRATCH must
//   fall back on weak KB votes. The arm gap is the measurement.
// - Emitters implement KB idioms (I-EMIT-MAIN, I-PRINT-I64, ...); the novelty
//   is the planner, not the snippets.

// ================= utils =================
// i64 -> decimal slice, no trailing newline (safe for audit/log lines)
fn i64s(cx:[]u8,v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){return s[0..s.len-1];}
    }
    return s;
}

// ================= state arena =================
// 28 words; slices stored as (ptr,len) pairs. Threaded as cx:[]u8.
//   0:ob_ptr 1:ob_len 2:op | 3:sb_ptr 4:sb_len 5:sn 6:et_ptr 7:et_len 8:en
//   9:wt_ptr 10:wt_len 11:wn | 12:nt_ptr 13:nt_len 14:nn
//   15:dt_ptr 16:dt_len 17:dn | 18:vt_ptr 19:vt_len 20:vn
//   21:ft_ptr 22:ft_len 23:fn_ | 24:an_ptr 25:an_len 26:ah 27:aw
fn cxg(cx:[]u8,i:i64)i64 { return get64(cx,cx,i*8); }
fn cxs(cx:[]u8,i:i64,v:i64)void { put64(cx,cx,i*8,v); return; }
fn cxsl(cx:[]u8,i:i64)[]u8 {
    let p:*u8=cxg(cx,i) as *u8;
    return p[0..cxg(cx,i+1)];
}
fn cxsl_set(cx:[]u8,i:i64,s:[]u8)void {
    cxs(cx,i,slice_ptr(cx,s));
    cxs(cx,i+1,s.len);
    return;
}

// data pointer of a slice: `s as i64` is the 16-byte header address;
// the first 8 bytes (LE) are the data pointer (probed on pinned znc).
fn slice_ptr(cx:[]u8,s:[]u8)i64 {
    let hp:*u8=(s as i64) as *u8;
    return get64(cx,hp[0..8],0);
}

fn s_eq(cx:[]u8,a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn s_find(cx:[]u8,h:[]u8, n:[]u8, st:i64)i64 {
    if(n.len==0){return st;}
    if(st<0){st=0;}
    let i:i64=st;
    while(i+n.len<=h.len){
        if(s_eq(cx,h[i..i+n.len],n)==1){return i;}
        i=i+1;
    }
    return -1;
}

fn s_start(cx:[]u8,h:[]u8, pre:[]u8)i64 {
    if(h.len<pre.len){return 0;}
    return s_eq(cx,h[0..pre.len],pre);
}

fn is_alnum(cx:[]u8,c:u8)i64 {
    if(c>=48){if(c<=57){return 1;}}
    if(c>=65){if(c<=90){return 1;}}
    if(c>=97){if(c<=122){return 1;}}
    if(c==95){return 1;}
    return 0;
}

fn is_digit(cx:[]u8,c:u8)i64 {
    if(c>=48){if(c<=57){return 1;}}
    return 0;
}

fn to_lower(cx:[]u8,c:u8)u8 {
    if(c>=65){if(c<=90){return c+32;}}
    return c;
}

fn put64(cx:[]u8,b:[]u8, o:i64, v:i64)void {
    let i:i64=0;
    while(i<8){
        let sh:i64=i*8;
        b[o+i]=((v>>sh)&255) as u8;
        i=i+1;
    }
    return;
}

fn get64(cx:[]u8,b:[]u8, o:i64)i64 {
    let v:i64=0;
    let k:i64=0;
    while(k<8){
        v=v|(((b[o+k] as i64)&255)<<(k*8));
        k=k+1;
    }
    return v;
}

fn path_cstr(cx:[]u8,s:[]u8)*u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let i:i64=0;
    while(i<s.len){
        p[i]=s[i];
        i=i+1;
    }
    p[s.len]=0;
    return p;
}

fn read_all(cx:[]u8,path:[]u8, mem:*u8, cap:i64)i64 {
    let pp:*u8=path_cstr(cx,path);
    let fd:i64=_zag_raw_syscall(2, pp as i64, 0, 0, 0, 0, 0);
    if(fd<0){return -1;}
    let total:i64=0;
    while(1==1){
        if(total>=cap){break;}
        let want:i64=cap-total;
        if(want>65536){want=65536;}
        let r:i64=_zag_raw_syscall(0, fd, (mem as i64)+total, want, 0, 0, 0);
        if(r<=0){break;}
        total=total+r;
    }
    let c:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

fn write_all(cx:[]u8,path:[]u8, mem:*u8, n:i64)i64 {
    let pp:*u8=path_cstr(cx,path);
    let fd:i64=_zag_raw_syscall(2, pp as i64, 577, 420, 0, 0, 0);
    if(fd<0){return -1;}
    let done:i64=0;
    while(done<n){
        let w:i64=_zag_raw_syscall(1, fd, (mem as i64)+done, n-done, 0, 0, 0);
        if(w<=0){break;}
        done=done+w;
    }
    let c:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return done;
}

// read whole file into a fresh slice (cap 1MB); "" on failure
fn fread_all(cx:[]u8, path:[]u8)[]u8 {
    let mp:*u8=_zag_malloc(1048576) as *u8;
    let n:i64=read_all(cx,path,mp,1048576);
    if(n<0){return "";}
    return mp[0..n];
}

fn count_lines(cx:[]u8, s:[]u8)i64 {
    let c:i64=0;
    let i:i64=0;
    while(i<s.len){
        if(s[i]==10){c=c+1;}
        i=i+1;
    }
    return c;
}

// line k (0-based) as a fresh copy, trailing \r stripped; "" if absent
fn line_at(cx:[]u8, s:[]u8, k:i64)[]u8 {
    let i:i64=0;
    let cur:i64=0;
    let st:i64=0;
    while(i<s.len){
        if(s[i]==10){
            if(cur==k){
                let en:i64=i;
                if(en>st){
                    if(s[en-1]==13){en=en-1;}
                }
                return fresh_copy(cx,s[st..en]);
            }
            cur=cur+1;
            st=i+1;
        }
        i=i+1;
    }
    if(cur==k){
        if(st<s.len){
            let en2:i64=s.len;
            if(s[en2-1]==13){en2=en2-1;}
            return fresh_copy(cx,s[st..en2]);
        }
        return "";
    }
    return "";
}

fn fresh_copy(cx:[]u8, s:[]u8)[]u8 {
    let mp:*u8=_zag_malloc(s.len+1) as *u8;
    let o:[]u8=mp[0..s.len+1];
    let i:i64=0;
    while(i<s.len){o[i]=s[i];i=i+1;}
    return o[0..s.len];
}

// NUL-terminated path copy as a slice (for open(2))
fn z_cstr(cx:[]u8, s:[]u8)*u8 {
    let mp:*u8=_zag_malloc(s.len+1) as *u8;
    let i:i64=0;
    while(i<s.len){mp[i]=s[i];i=i+1;}
    mp[s.len]=0;
    return mp;
}

// 64-bit FNV-1a-style digest (multiply-add; display/determinism only)
fn fnv1a(cx:[]u8, s:[]u8)i64 {
    let h:i64=146959;
    let i:i64=0;
    while(i<s.len){
        h=h*16777619+(s[i] as i64);
        i=i+1;
    }
    return h;
}

// append one KB01 record (id,topic,kw,body) to store bytes; new slice
fn kb_append_rec(cx:[]u8, nb:[]u8, id:[]u8, topic:[]u8, kw:[]u8, body:[]u8)[]u8 {
    let total:i64=nb.len+32+id.len+topic.len+kw.len+body.len;
    let mp:*u8=_zag_malloc(total+8) as *u8;
    let o:[]u8=mp[0..total+8];
    let p:i64=0;
    let i:i64=0;
    while(i<nb.len){o[p]=nb[i];p=p+1;i=i+1;}
    put64(cx,o,p,id.len);
    p=p+8;
    i=0;
    while(i<id.len){o[p]=id[i];p=p+1;i=i+1;}
    put64(cx,o,p,topic.len);
    p=p+8;
    i=0;
    while(i<topic.len){o[p]=topic[i];p=p+1;i=i+1;}
    put64(cx,o,p,kw.len);
    p=p+8;
    i=0;
    while(i<kw.len){o[p]=kw[i];p=p+1;i=i+1;}
    put64(cx,o,p,body.len);
    p=p+8;
    i=0;
    while(i<body.len){o[p]=body[i];p=p+1;i=i+1;}
    return o[0..p];
}

fn pstr(cx:[]u8,s:[]u8)void {
    _zag_print(s);
    return;
}

// print i64 without relying on _zag_print(i64_to_str) newline behavior:
// strip one trailing byte-10 if present, print the rest.
fn pi64(cx:[]u8,v:i64)void {
    let t:[]u8=_zag_i64_to_str(v);
    let n:i64=t.len;
    if(n>0){
        if(t[n-1]==10){n=n-1;}
    }
    _zag_print(t[0..n]);
    return;
}

// ================= emit buffer =================

fn emit(cx:[]u8,s:[]u8)void {
    let b:[]u8=cxsl(cx,0);
    let n:i64=cxg(cx,2);
    let i:i64=0;
    while(i<s.len){
        b[n]=s[i];
        n=n+1;
        i=i+1;
    }
    cxs(cx,2,n);
    return;
}

fn emit_ch(cx:[]u8,c:u8)void {
    let b:[]u8=cxsl(cx,0);
    let n:i64=cxg(cx,2);
    b[n]=c;
    cxs(cx,2,n+1);
    return;
}

fn emit_i64(cx:[]u8,v:i64)void {
    let t:[]u8=_zag_i64_to_str(v);
    let n:i64=t.len;
    if(n>0){
        if(t[n-1]==10){n=n-1;}
    }
    emit(cx,t[0..n]);
    return;
}

fn emit_nl(cx:[]u8)void {
    emit_ch(cx,10);
    return;
}

fn out_slice(cx:[]u8)[]u8 {
    return cxsl(cx,0)[0..cxg(cx,2)];
}

// ================= knowledge store =================
// KB01 format: "KB01\n" magic, u64 count, per entry 4x (u64 len + bytes):
// id, topic, keywords, body.

fn kb_load(cx:[]u8,path:[]u8)i64 {
    let mp:*u8=_zag_malloc(2097152) as *u8;
    let buf:[]u8=mp[0..2097152];
    let n:i64=read_all(cx,path, mp, 2097152);
    if(n<13){return -1;}
    if(s_eq(cx,buf[0..5],"KB01\n")==0){return -1;}
    let cnt:i64=get64(cx,buf,5);
    if(cnt<0){return -1;}
    if(cnt>128){return -1;}
    let ep:*u8=_zag_malloc(24576) as *u8;
    let et:[]u8=ep[0..24576];
    let pos:i64=13;
    let e:i64=0;
    while(e<cnt){
        let f:i64=0;
        while(f<4){
            if(pos+8>n){return -1;}
            let ln:i64=get64(cx,buf,pos);
            pos=pos+8;
            if(ln<0){return -1;}
            if(pos+ln>n){return -1;}
            if(f==0){
                put64(cx,et,e*48+0,pos);
                put64(cx,et,e*48+8,ln);
            }
            if(f==2){
                put64(cx,et,e*48+16,pos);
                put64(cx,et,e*48+24,ln);
            }
            if(f==1){
                put64(cx,et,e*48+32,pos);
                put64(cx,et,e*48+40,ln);
            }
            pos=pos+ln;
            f=f+1;
        }
        e=e+1;
    }
    cxsl_set(cx,3,buf);
    cxs(cx,5,n);
    cxsl_set(cx,6,et);
    cxs(cx,8,cnt);
    return cnt;
}

fn ent_id(cx:[]u8,e:i64)[]u8 {
    let o:i64=get64(cx,cxsl(cx,6),e*48+0);
    let l:i64=get64(cx,cxsl(cx,6),e*48+8);
    return cxsl(cx,3)[o..o+l];
}

fn ent_kw(cx:[]u8,e:i64)[]u8 {
    let o:i64=get64(cx,cxsl(cx,6),e*48+16);
    let l:i64=get64(cx,cxsl(cx,6),e*48+24);
    return cxsl(cx,3)[o..o+l];
}

fn ent_topic(cx:[]u8,e:i64)[]u8 {
    let o:i64=get64(cx,cxsl(cx,6),e*48+32);
    let l:i64=get64(cx,cxsl(cx,6),e*48+40);
    return cxsl(cx,3)[o..o+l];
}

// find entry index by id, -1 if absent
fn ent_by_id(cx:[]u8,id:[]u8)i64 {
    let e:i64=0;
    while(e<cxg(cx,8)){
        if(s_eq(cx,ent_id(cx,e),id)==1){return e;}
        e=e+1;
    }
    return -1;
}

// ================= recall: words, scores, votes =================

// split spec into lowercased alnum words (len>=3), stored in g_wt as
// 16-byte records (off,len); words live in a copy of the spec.
fn words_of(cx:[]u8,spec:[]u8)[]u8 {
    let cp:*u8=_zag_malloc(spec.len+1) as *u8;
    let cb:[]u8=cp[0..spec.len+1];
    let i:i64=0;
    while(i<spec.len){
        cb[i]=to_lower(cx,spec[i]);
        i=i+1;
    }
    let wp:*u8=_zag_malloc(2048) as *u8;
    let wt:[]u8=wp[0..2048];
    let wn:i64=0;
    i=0;
    while(i<spec.len){
        if(is_alnum(cx,cb[i])==1){
            let st:i64=i;
            while(i<spec.len){
                if(is_alnum(cx,cb[i])==0){break;}
                i=i+1;
            }
            let ln:i64=i-st;
            if(ln>=3){
                if(wn<128){
                    put64(cx,wt,wn*16,st);
                    put64(cx,wt,wn*16+8,ln);
                    wn=wn+1;
                }
            }
        } else {
            i=i+1;
        }
    }
    cxsl_set(cx,9,wt);
    cxs(cx,11,wn);
    return cb;
}

fn word_at(cx:[]u8,w:[]u8, k:i64)[]u8 {
    let o:i64=get64(cx,cxsl(cx,9),k*16);
    let l:i64=get64(cx,cxsl(cx,9),k*16+8);
    return w[o..o+l];
}

// score of one entry = number of distinct spec words that overlap any
// comma-separated keyword token (either direction substring).
fn entry_score(cx:[]u8,e:i64, w:[]u8)i64 {
    let kw:[]u8=ent_kw(cx,e);
    let sc:i64=0;
    let k:i64=0;
    while(k<cxg(cx,11)){
        let wd:[]u8=word_at(cx,w,k);
        // walk comma-separated tokens of kw
        let ts:i64=0;
        let hit:i64=0;
        while(ts<=kw.len){
            let te:i64=ts;
            while(te<kw.len){
                if(kw[te]==44){break;}
                te=te+1;
            }
            let tok:[]u8=kw[ts..te];
            if(tok.len>=2){
                if(s_find(cx,wd,tok,0)>=0){hit=1;}
                else {
                    if(s_find(cx,tok,wd,0)>=0){hit=1;}
                }
            }
            if(hit==1){break;}
            ts=te+1;
        }
        if(hit==1){sc=sc+1;}
        k=k+1;
    }
    return sc;
}

// schema trigger entries: schema id -> list of entry ids (as one
// comma-separated []u8). Votes = sum of entry scores.
fn trig_entries(cx:[]u8,sid:i64)[]u8 {
    if(sid==41){return "C-ARCH-02,A-DFS";}
    if(sid==42){return "C-ARCH-09,L-TYPES";}
    if(sid==43){return "C-ARCH-03,I-PRINT-I64";}
    if(sid==44){return "C-ARCH-04,I-ARGV-LOOP";}
    if(sid==45){return "C-ARCH-05,L-STRING";}
    if(sid==46){return "C-ARCH-06,E-ARRAYSUM";}
    if(sid==47){return "C-ARCH-07,L-TYPES";}
    if(sid==48){return "C-ARCH-08,L-STRING";}
    if(sid==22){return "E-STRCOUNT";}
    if(sid==31){return "A-SORT-INSERT";}
    if(sid==32){return "I-ARGV-LOOP";}
    if(sid==27){return "L-STRING";}
    return "";
}

// vote total for a schema from its trigger entries.
fn schema_votes(cx:[]u8,sid:i64, w:[]u8)i64 {
    let te:[]u8=trig_entries(cx,sid);
    if(te.len==0){return 0;}
    let tot:i64=0;
    let ts:i64=0;
    while(ts<=te.len){
        let tc:i64=s_find(cx,te,",",ts);
        if(tc<0){tc=te.len;}
        let id:[]u8=te[ts..tc];
        let e:i64=ent_by_id(cx,id);
        if(e>=0){
            tot=tot+entry_score(cx,e,w);
        }
        ts=tc+1;
    }
    return tot;
}

// ================= gate (frozen; RK2: never weaken) =================
fn do_gate(cx:[]u8)void {
    let spec:[]u8=_zag_arg(2);
    let r:i64=gate_hit(cx,spec);
    if(r==0){
        pstr(cx,"ALLOW\n");
    } else {
        pstr(cx,"REFUSE:G");
        pstr(cx,i64s(cx,r));
        pstr(cx,"\n");
    }
    return;
}

// ================= spec parsing =================
// segment k of '|' separated spec (0-based)
fn spec_seg(cx:[]u8,spec:[]u8, k:i64)[]u8 {
    let n:i64=0;
    let st:i64=0;
    let i:i64=0;
    while(i<=spec.len){
        let end:i64=0;
        if(i==spec.len){end=1;}
        else {
            if(spec[i]==124){end=1;}
        }
        if(end==1){
            if(n==k){return spec[st..i];}
            n=n+1;
            st=i+1;
        }
        i=i+1;
    }
    return "";
}

// value of key= in a '|' segment string (reads to next '|' or end)
fn kv_get(cx:[]u8,spec:[]u8, key:[]u8)[]u8 {
    let pat:[]u8=key;
    let p:i64=s_find(cx,spec,pat,0);
    while(p>=0){
        let after:i64=p+pat.len;
        if(after<spec.len){
            if(spec[after]==61){
                let st:i64=after+1;
                let en:i64=s_find(cx,spec,"|",st);
                if(en<0){en=spec.len;}
                return spec[st..en];
            }
        }
        p=s_find(cx,spec,pat,p+1);
    }
    return "";
}

// collect all integers (with optional leading '-') in s into out table;
// returns count. out is a []u8 arena of 16-byte (val) records.

fn scan_ints(cx:[]u8,s:[]u8)[]u8 {
    let np:*u8=_zag_malloc(2048) as *u8;
    let nt:[]u8=np[0..2048];
    let nn:i64=0;
    let i:i64=0;
    while(i<s.len){
        let neg:i64=0;
        if(s[i]==45){
            if(i+1<s.len){
                if(is_digit(cx,s[i+1])==1){neg=1;}
            }
        }
        if(is_digit(cx,s[i])==1 || neg==1){
            if(neg==1){i=i+1;}
            let v:i64=0;
            while(i<s.len){
                if(is_digit(cx,s[i])==0){break;}
                v=v*10+((s[i] as i64)-48);
                i=i+1;
            }
            if(neg==1){v=0-v;}
            if(nn<128){
                put64(cx,nt,nn*8,v);
                nn=nn+1;
            }
        } else {
            i=i+1;
        }
    }
    cxsl_set(cx,12,nt);
    cxs(cx,14,nn);
    return nt;
}

fn int_at(cx:[]u8,k:i64)i64 {
    return get64(cx,cxsl(cx,12),k*8);
}

// split demo on ',' and ';' into int table; returns count. Also handles
// ranges like '0..5' by expanding.

fn parse_demo(cx:[]u8,demo:[]u8)i64 {
    let dp:*u8=_zag_malloc(2048) as *u8;
    let dt:[]u8=dp[0..2048];
    let dn:i64=0;
    let i:i64=0;
    while(i<demo.len){
        if(is_digit(cx,demo[i])==1 || demo[i]==45){
            let neg:i64=0;
            if(demo[i]==45){neg=1;i=i+1;}
            let v:i64=0;
            while(i<demo.len){
                if(is_digit(cx,demo[i])==0){break;}
                v=v*10+((demo[i] as i64)-48);
                i=i+1;
            }
            if(neg==1){v=0-v;}
            // range A..B ?
            if(i+1<demo.len){
                if(demo[i]==46){
                    if(demo[i+1]==46){
                        i=i+2;
                        let w:i64=0;
                        while(i<demo.len){
                            if(is_digit(cx,demo[i])==0){break;}
                            w=w*10+((demo[i] as i64)-48);
                            i=i+1;
                        }
                        let q:i64=v;
                        while(q<=w){
                            if(dn<128){put64(cx,dt,dn*8,q);dn=dn+1;}
                            q=q+1;
                        }
                    } else {
                        if(dn<128){put64(cx,dt,dn*8,v);dn=dn+1;}
                    }
                } else {
                    if(dn<128){put64(cx,dt,dn*8,v);dn=dn+1;}
                }
            } else {
                if(dn<128){put64(cx,dt,dn*8,v);dn=dn+1;}
            }
        } else {
            i=i+1;
        }
    }
    cxsl_set(cx,15,dt);
    cxs(cx,17,dn);
    return dn;
}

fn demo_at(cx:[]u8,k:i64)i64 {
    return get64(cx,cxsl(cx,15),k*8);
}

// demo vectors split on ';': returns vector count; also fills g_vt with
// (start,count) of ints per vector.

fn parse_vectors(cx:[]u8,demo:[]u8)i64 {
    let vp:*u8=_zag_malloc(1024) as *u8;
    let vt:[]u8=vp[0..1024];
    let vn:i64=0;
    let cur0:i64=0;
    // first parse all ints with their positions is overkill; simpler:
    // split demo on ';', parse each part via parse_demo into temp, record.
    let dp:*u8=_zag_malloc(2048) as *u8;
    let dt:[]u8=dp[0..2048];
    let dn:i64=0;
    let i:i64=0;
    let vstart:i64=0;
    while(i<=demo.len){
        let end:i64=0;
        if(i==demo.len){end=1;}
        else {
            if(demo[i]==59){end=1;}
        }
        if(end==1){
            let part:[]u8=demo[vstart..i];
            let c0:i64=dn;
            let j:i64=0;
            while(j<part.len){
                if(is_digit(cx,part[j])==1 || part[j]==45){
                    let neg:i64=0;
                    if(part[j]==45){neg=1;j=j+1;}
                    let v:i64=0;
                    while(j<part.len){
                        if(is_digit(cx,part[j])==0){break;}
                        v=v*10+((part[j] as i64)-48);
                        j=j+1;
                    }
                    if(neg==1){v=0-v;}
                    if(dn<128){put64(cx,dt,dn*8,v);dn=dn+1;}
                } else {
                    j=j+1;
                }
            }
            if(vn<64){
                put64(cx,vt,vn*16,c0);
                put64(cx,vt,vn*16+8,dn-c0);
                vn=vn+1;
            }
            vstart=i+1;
        }
        i=i+1;
    }
    cxsl_set(cx,15,dt);
    cxs(cx,17,dn);
    cxsl_set(cx,18,vt);
    cxs(cx,20,vn);
    return vn;
}

// param names a,b,c,...
fn pname(cx:[]u8,k:i64)[]u8 {
    if(k==0){return "a";}
    if(k==1){return "b";}
    if(k==2){return "c";}
    if(k==3){return "d";}
    if(k==4){return "e";}
    return "f";
}

// emit malloc'd i64 array initialized from demo ints [0..n)
fn emit_i64_array(cx:[]u8,n:i64)void {
    emit(cx,"let p:*u8=_zag_malloc(");
    emit_i64(cx,n*8);
    emit(cx,") as *u8;\n");
    emit(cx,"let arr:[]i64=p[0..");
    emit_i64(cx,n*8);
    emit(cx,"] as []i64;\n");
    let i:i64=0;
    while(i<n){
        emit(cx,"arr[");
        emit_i64(cx,i);
        emit(cx,"]=");
        emit_i64(cx,demo_at(cx,i));
        emit(cx,";\n");
        i=i+1;
    }
    return;
}

fn emit_print_i64_expr_done(cx:[]u8)void {
    emit(cx,"_zag_print(\"\\n\");\n");
    return;
}

// ================= T1/T2 structured emitters =================
// Each emits a complete program to g_ob.

fn em_func_sum(cx:[]u8,name:[]u8, nargs:i64)void {
    emit(cx,"fn ");
    emit(cx,name);
    emit(cx,"(");
    let k:i64=0;
    while(k<nargs){
        if(k>0){emit(cx,",");}
        emit(cx,pname(cx,k));
        emit(cx,":i32");
        k=k+1;
    }
    emit(cx,")i32 {\n  return ");
    k=0;
    while(k<nargs){
        if(k>0){emit(cx,"+");}
        emit(cx,pname(cx,k));
        k=k+1;
    }
    emit(cx,";\n}\n");
    emit(cx,"fn main()void {\n  let r0:i32=");
    emit(cx,name);
    emit(cx,"(");
    k=0;
    while(k<nargs){
        if(k>0){emit(cx,",");}
        emit_i64(cx,demo_at(cx,k));
        k=k+1;
    }
    emit(cx,");\n  _zag_print(_zag_i64_to_str(r0 as i64));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_func_max(cx:[]u8,name:[]u8)void {
    emit(cx,"fn ");
    emit(cx,name);
    emit(cx,"(a:i64,b:i64)i64 {\n  if(a>b){return a;}\n  return b;\n}\n");
    emit(cx,"fn main()void {\n  let r0:i64=");
    emit(cx,name);
    emit(cx,"(");
    emit_i64(cx,demo_at(cx,0));
    emit(cx,",");
    emit_i64(cx,demo_at(cx,1));
    emit(cx,");\n  _zag_print(_zag_i64_to_str(r0));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_slice_sum(cx:[]u8,name:[]u8, n:i64)void {
    emit(cx,"fn ");
    emit(cx,name);
    emit(cx,"(a:[]i64,n:i64)i64 {\n  let s:i64=0;\n  let i:i64=0;\n  while(i<n){s=s+a[i];i=i+1;}\n  return s;\n}\n");
    emit(cx,"fn main()void {\n");
    emit_i64_array(cx,n);
    emit(cx,"  let r:i64=");
    emit(cx,name);
    emit(cx,"(arr,");
    emit_i64(cx,n);
    emit(cx,");\n  _zag_print(_zag_i64_to_str(r));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_slice_countpos(cx:[]u8,name:[]u8, n:i64)void {
    emit(cx,"fn ");
    emit(cx,name);
    emit(cx,"(a:[]i64,n:i64)i64 {\n  let c:i64=0;\n  let i:i64=0;\n  while(i<n){if(a[i]>0){c=c+1;}i=i+1;}\n  return c;\n}\n");
    emit(cx,"fn main()void {\n");

fn em_argv_count(cx:[]u8)void {
    emit(cx,"fn main()void {\n  let c:i64=0;\n  let i:i64=1;\n  while(i<=16){\n    let a:[]u8=_zag_arg(i);\n    if(a.len==0){break;}\n    c=c+1;\n    i=i+1;\n  }\n  _zag_print(_zag_i64_to_str(c));\n");

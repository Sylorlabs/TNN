fn em_struct_manhattan(cx:[]u8)void {
    emit(cx,"struct Pt { x:i64, y:i64 }\n");
    emit(cx,"fn manhattan(p:Pt)i64 {\n  let x:i64=p.x;\n  let y:i64=p.y;\n  if(x<0){x=0-x;}\n  if(y<0){y=0-y;}\n  return x+y;\n}\n");
    emit(cx,"fn main()void {\n  let q:Pt=Pt{};\n  q.x=");
    emit_i64(cx,demo_at(cx,0));
    emit(cx,";\n  q.y=");
    emit_i64(cx,demo_at(cx,1));
    emit(cx,";\n  _zag_print(_zag_i64_to_str(manhattan(q)));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_func_fact(cx:[]u8,name:[]u8)void {
    emit(cx,"fn ");
    emit(cx,name);
    emit(cx,"(a:i64)i64 {\n  let r:i64=1;\n  let k:i64=2;\n  while(k<=a){r=r*k;k=k+1;}\n  return r;\n}\n");
    emit(cx,"fn main()void {\n  _zag_print(_zag_i64_to_str(");
    emit(cx,name);

    emit(cx,"fn main()void {\n  _zag_print(_zag_i64_to_str(");
    emit(cx,name);
    emit(cx,"(");
    emit_i64(cx,demo_at(cx,0));
    emit(cx,",");
    emit_i64(cx,demo_at(cx,1));
    emit(cx,")));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_math_isprime(cx:[]u8,name:[]u8, nv:i64)void {
    emit(cx,"fn ");
    emit(cx,name);
    emit(cx,"(a:i64)i64 {\n  if(a<2){return 0;}\n  let d:i64=2;\n  while(d*d<=a){if(a%d==0){return 0;}d=d+1;}\n  return 1;\n}\nfn main()void {\n");
    let v:i64=0;
    while(v<nv){
        emit(cx,"  _zag_print(_zag_i64_to_str(");
        emit(cx,name);
        emit(cx,"(");
        emit_i64(cx,get64(cx,cxsl(cx,15),(get64(cx,cxsl(cx,18),v*16))*8));
        emit(cx,")));\n");
        emit_print_i64_expr_done(cx);
        v=v+1;
    }
    emit(cx,"}\n");
    return;
}

fn em_slice_squares(cx:[]u8,n:i64)void {
    emit(cx,"fn main()void {\n");
    emit(cx,"  let p:*u8=_zag_malloc(");
    emit_i64(cx,n*8);
    emit(cx,") as *u8;\n  let arr:[]i64=p[0..");
    emit_i64(cx,n*8);
    emit(cx,"] as []i64;\n");
    emit(cx,"  let i:i64=0;\n  while(i<");
    emit_i64(cx,n);
    emit(cx,"){arr[i]=i*i;i=i+1;}\n");
    emit(cx,"  let pi:i64=0;\n  while(pi<");
    emit_i64(cx,n);
    emit(cx,"){\n    _zag_print(_zag_i64_to_str(arr[pi]));\n    if(pi<");
    emit_i64(cx,n-1);
    emit(cx,"){_zag_print(\" \");}\n    pi=pi+1;\n  }\n");
    emit_print_i64_expr_done(cx);

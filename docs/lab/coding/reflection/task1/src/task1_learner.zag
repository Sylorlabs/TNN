fn em_sort(cx:[]u8,name:[]u8, n:i64, asc:i64)void {
    emit(cx,"fn ");
    emit(cx,name);
    emit(cx,"(a:[]i64,n:i64)void {\n  let i:i64=0;\n  while(i<n){\n    let j:i64=0;\n    while(j+1<n-i){\n");
    if(asc==1){
        emit(cx,"      if(a[j]>a[j+1]){\n");
    } else {
        emit(cx,"      if(a[j]<a[j+1]){\n");
    }
    emit(cx,"        let t:i64=a[j];\n        a[j]=a[j+1];\n        a[j+1]=t;\n      }\n      j=j+1;\n    }\n    i=i+1;\n  }\n  return;\n}\n");
    emit(cx,"fn main()void {\n");
    emit_i64_array(cx,n);
    emit(cx,"  ");
    emit(cx,name);
    emit(cx,"(arr,");
    emit_i64(cx,n);
    emit(cx,");\n  let pi:i64=0;\n  while(pi<");
    emit_i64(cx,n);
    emit(cx,"){\n    _zag_print(_zag_i64_to_str(arr[pi]));\n    if(pi<");
    emit_i64(cx,n-1);
    emit(cx,"){_zag_print(\" \");}\n    pi=pi+1;\n  }\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_search_find(cx:[]u8,name:[]u8, nv:i64)void {
    emit(cx,"fn ");
    emit(cx,name);
    emit(cx,"(a:[]i64,n:i64,v:i64)i64 {\n  let i:i64=0;\n  while(i<n){if(a[i]==v){return i;}i=i+1;}\n  return -1;\n}\n");
    emit(cx,"fn main()void {\n");
    // deterministic scenario construction from the first search value:
    // arr = [v+43, v+14, v, v+3, v+91]; v is at index 2, others absent.
    let v0:i64=get64(cx,cxsl(cx,15),(get64(cx,cxsl(cx,18),0))*8);
    emit(cx,"  let p:*u8=_zag_malloc(40) as *u8;\n  let arr:[]i64=p[0..40] as []i64;\n");
    emit(cx,"  arr[0]=");
    emit_i64(cx,v0+43);
    emit(cx,";arr[1]=");
    emit_i64(cx,v0+14);
    emit(cx,";arr[2]=");
    emit_i64(cx,v0);
    emit(cx,";arr[3]=");
    emit_i64(cx,v0+3);
    emit(cx,";arr[4]=");
    emit_i64(cx,v0+91);
    emit(cx,";\n");
    let v:i64=0;
    while(v<nv){
        emit(cx,"  _zag_print(_zag_i64_to_str(");
        emit(cx,name);
        emit(cx,"(arr,5,");
        emit_i64(cx,get64(cx,cxsl(cx,15),(get64(cx,cxsl(cx,18),v*16))*8));
        emit(cx,")));\n");
        emit_print_i64_expr_done(cx);
        v=v+1;
    }
    emit(cx,"}\n");
    return;
}

fn em_str_reverse(cx:[]u8,str:[]u8)void {
    emit(cx,"fn main()void {\n  let s:[]u8=\"");
    emit(cx,str);
    emit(cx,"\";\n  let p:*u8=_zag_malloc(");
    emit_i64(cx,str.len+1);
    emit(cx,") as *u8;\n  let r:[]u8=p[0..");
    emit_i64(cx,str.len+1);
    emit(cx,"];\n  let i:i64=0;\n  while(i<s.len){r[i]=s[s.len-1-i];i=i+1;}\n  _zag_print(r[0..s.len]);\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_math_gcd(cx:[]u8,name:[]u8)void {
    emit(cx,"fn ");

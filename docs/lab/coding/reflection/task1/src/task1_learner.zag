    emit(cx,");\n  _zag_print(_zag_i64_to_str(r));\n");
    emit_print_i64_expr_done(cx);
    emit(cx,"}\n");
    return;
}

fn em_loop_rangesum(cx:[]u8,n:i64)void {
    emit(cx,"fn main()void {\n  let s:i64=0;\n  let i:i64=1;\n  while(i<=");
    emit_i64(cx,n);

fn main()void {
    let i:i64=1;
    while(i<=15){
        let d3:i64=0;
        let d5:i64=0;
        if(i%3==0){d3=1;}
        if(i%5==0){d5=1;}
        if(d3==1){_zag_print("fizz");}
        if(d5==1){_zag_print("buzz");}
        if(d3==0){if(d5==0){_zag_print(_zag_i64_to_str(i));}}
        _zag_print("\n");
        i=i+1;
    }
    return;
}

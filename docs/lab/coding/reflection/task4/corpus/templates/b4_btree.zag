// BTREE template (dev) — order-{{ORDER}} B-tree with split and merge.
// Humans build this as: nodes hold up to ORDER-1 sorted keys; a full node
// splits around its median on the way down (insert), and a thin node
// borrows from a sibling or merges on the way down (delete), so every
// node but the root always stays within [min,max] occupancy.
fn get64(b:[]u8, o:i64)i64 {
    let v:i64=0;
    let k:i64=0;
    while(k<8){
        v=v|(((b[o+k] as i64)&255)<<(k*8));
        k=k+1;
    }
    return v;
}

fn put64(b:[]u8, o:i64, v:i64)void {
    let i:i64=0;
    while(i<8){
        let sh:i64=i*8;
        b[o+i]=((v>>sh)&255) as u8;
        i=i+1;
    }
    return;
}

fn parse_i64(s:[]u8)i64 {
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    let v:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48){
            if(c<=57){v=v*10+((c-48) as i64);}
        }
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

fn i64s(v:i64)[]u8 {
    let t:[]u8=_zag_i64_to_str(v);
    let n:i64=t.len;
    if(n>0){
        if(t[n-1]==10){n=n-1;}
    }
    return t[0..n];
}

// node layout, 96 bytes: @0 leaf, @8 n, @16 keys[4], @48 children[4]
fn n_off(nid:i64)i64 {
    return nid*96;
}

fn g_leaf(ar:[]u8, nid:i64)i64 {
    return get64(ar,n_off(nid));
}

fn g_n(ar:[]u8, nid:i64)i64 {
    return get64(ar,n_off(nid)+8);
}

fn s_n(ar:[]u8, nid:i64, v:i64)void {
    put64(ar,n_off(nid)+8,v);
    return;
}

fn g_k(ar:[]u8, nid:i64, i:i64)i64 {
    return get64(ar,n_off(nid)+16+i*8);
}

fn s_k(ar:[]u8, nid:i64, i:i64, v:i64)void {
    put64(ar,n_off(nid)+16+i*8,v);
    return;
}

fn g_c(ar:[]u8, nid:i64, i:i64)i64 {
    return get64(ar,n_off(nid)+48+i*8);
}

fn s_c(ar:[]u8, nid:i64, i:i64, v:i64)void {
    put64(ar,n_off(nid)+48+i*8,v);
    return;
}

fn node_new(ar:[]u8, nc:[]u8, leaf:i64)i64 {
    let id:i64=get64(nc,0);
    put64(nc,0,id+1);
    put64(ar,n_off(id),leaf);
    put64(ar,n_off(id)+8,0);
    let i:i64=0;
    while(i<4){
        put64(ar,n_off(id)+16+i*8,0);
        put64(ar,n_off(id)+48+i*8,-1);
        i=i+1;
    }
    return id;
}

// split full child y=p.children[i] (2T-1 keys) around median
fn split_child(ar:[]u8, nc:[]u8, T:i64, p:i64, i:i64)void {
    let y:i64=g_c(ar,p,i);
    let z:i64=node_new(ar,nc,g_leaf(ar,y));
    let j:i64=0;
    while(j<T-1){
        s_k(ar,z,j,g_k(ar,y,T+j));
        j=j+1;
    }
    if(g_leaf(ar,y)==0){
        let k:i64=0;
        while(k<T){
            s_c(ar,z,k,g_c(ar,y,T+k));
            k=k+1;
        }
    }
    s_n(ar,z,T-1);
    s_n(ar,y,T-1);
    // insert z as child i+1 of p
    let np:i64=g_n(ar,p);
    let c:i64=np;
    while(c>i){
        s_c(ar,p,c+1,g_c(ar,p,c));
        c=c-1;
    }
    s_c(ar,p,i+1,z);
    // insert median key y.keys[T-1] at position i
    let kk:i64=np-1;
    while(kk>=i){
        s_k(ar,p,kk+1,g_k(ar,p,kk));
        kk=kk-1;
    }
    s_k(ar,p,i,g_k(ar,y,T-1));
    s_n(ar,p,np+1);
    return;
}

fn insert_nonfull(ar:[]u8, nc:[]u8, T:i64, nid:i64, k:i64)void {
    let n:i64=g_n(ar,nid);
    if(g_leaf(ar,nid)==1){
        let i:i64=n-1;
        while(i>=0){
            if(k<g_k(ar,nid,i)){
                s_k(ar,nid,i+1,g_k(ar,nid,i));
                i=i-1;
            } else {
                break;
            }
        }
        s_k(ar,nid,i+1,k);
        s_n(ar,nid,n+1);
        return;
    }
    let i2:i64=n-1;
    while(i2>=0){
        if(k<g_k(ar,nid,i2)){i2=i2-1;} else {break;}
    }
    i2=i2+1;
    let ch:i64=g_c(ar,nid,i2);
    if(g_n(ar,ch)==2*T-1){
        split_child(ar,nc,T,nid,i2);
        if(k>g_k(ar,nid,i2)){i2=i2+1;}
        ch=g_c(ar,nid,i2);
    }
    insert_nonfull(ar,nc,T,ch,k);
    return;
}

fn btree_insert(ar:[]u8, nc:[]u8, rt:[]u8, T:i64, k:i64)void {
    let r:i64=get64(rt,0);
    if(g_n(ar,r)==2*T-1){
        let s:i64=node_new(ar,nc,0);
        s_c(ar,s,0,r);
        put64(rt,0,s);
        split_child(ar,nc,T,s,0);
        insert_nonfull(ar,nc,T,s,k);
        return;
    }
    insert_nonfull(ar,nc,T,r,k);
    return;
}

fn bmerge(ar:[]u8, T:i64, p:i64, i:i64)void {
    let c:i64=g_c(ar,p,i);
    let s:i64=g_c(ar,p,i+1);
    let nc2:i64=g_n(ar,c);
    s_k(ar,c,nc2,g_k(ar,p,i));
    let j:i64=0;
    while(j<g_n(ar,s)){
        s_k(ar,c,nc2+1+j,g_k(ar,s,j));
        j=j+1;
    }
    if(g_leaf(ar,c)==0){
        let k:i64=0;
        while(k<=g_n(ar,s)){
            s_c(ar,c,nc2+1+k,g_c(ar,s,k));
            k=k+1;
        }
    }
    s_n(ar,c,nc2+1+g_n(ar,s));
    // mark s dead (flag at +88)
    put64(ar,n_off(s)+88,1);
    // remove key i and child i+1 from p
    let np:i64=g_n(ar,p);
    let k2:i64=i;
    while(k2<np-1){
        s_k(ar,p,k2,g_k(ar,p,k2+1));
        k2=k2+1;
    }
    let c2:i64=i+1;
    while(c2<np){
        s_c(ar,p,c2,g_c(ar,p,c2+1));
        c2=c2+1;
    }
    s_n(ar,p,np-1);
    return;
}

fn bfill(ar:[]u8, nc:[]u8, T:i64, p:i64, i:i64)i64 {
    let c:i64=g_c(ar,p,i);
    let np:i64=g_n(ar,p);
    // borrow from left sibling
    if(i>0){
        let sib:i64=g_c(ar,p,i-1);
        if(g_n(ar,sib)>=T){
            let ncb:i64=g_n(ar,c);
            // shift c keys/children right by 1
            let k:i64=ncb-1;
            while(k>=0){
                s_k(ar,c,k+1,g_k(ar,c,k));
                k=k-1;
            }
            if(g_leaf(ar,c)==0){
                let k2:i64=ncb;
                while(k2>=0){
                    s_c(ar,c,k2+1,g_c(ar,c,k2));
                    k2=k2-1;
                }
            }
            s_k(ar,c,0,g_k(ar,p,i-1));
            if(g_leaf(ar,c)==0){
                s_c(ar,c,0,g_c(ar,sib,g_n(ar,sib)));
            }
            s_k(ar,p,i-1,g_k(ar,sib,g_n(ar,sib)-1));
            s_n(ar,sib,g_n(ar,sib)-1);
            s_n(ar,c,ncb+1);
            return i;
        }
    }
    // borrow from right sibling
    if(i<np){
        let sib2:i64=g_c(ar,p,i+1);
        if(g_n(ar,sib2)>=T){
            let ncb2:i64=g_n(ar,c);
            s_k(ar,c,ncb2,g_k(ar,p,i));
            if(g_leaf(ar,c)==0){
                s_c(ar,c,ncb2+1,g_c(ar,sib2,0));
            }
            s_k(ar,p,i,g_k(ar,sib2,0));
            let ns2:i64=g_n(ar,sib2);
            let k3:i64=0;
            while(k3<ns2-1){
                s_k(ar,sib2,k3,g_k(ar,sib2,k3+1));
                k3=k3+1;
            }
            if(g_leaf(ar,sib2)==0){
                let k4:i64=0;
                while(k4<ns2){
                    s_c(ar,sib2,k4,g_c(ar,sib2,k4+1));
                    k4=k4+1;
                }
            }
            s_n(ar,sib2,ns2-1);
            s_n(ar,c,ncb2+1);
            return i;
        }
    }
    // merge
    if(i<np){
        bmerge(ar,T,p,i);
        return i;
    }
    bmerge(ar,T,p,i-1);
    return i-1;
}

fn bdelete(ar:[]u8, nc:[]u8, T:i64, nid:i64, k:i64)void {
    let n:i64=g_n(ar,nid);
    let i:i64=0;
    while(i<n){
        if(g_k(ar,nid,i)<k){i=i+1;} else {break;}
    }
    let found:i64=0;
    if(i<n){
        if(g_k(ar,nid,i)==k){found=1;}
    }
    if(found==1){
        if(g_leaf(ar,nid)==1){
            let j:i64=i;
            while(j<n-1){
                s_k(ar,nid,j,g_k(ar,nid,j+1));
                j=j+1;
            }
            s_n(ar,nid,n-1);
            return;
        }
        let c1:i64=g_c(ar,nid,i);
        let c2:i64=g_c(ar,nid,i+1);
        if(g_n(ar,c1)>=T){
            // predecessor
            let pc:i64=c1;
            while(g_leaf(ar,pc)==0){
                pc=g_c(ar,pc,g_n(ar,pc));
            }
            let pred:i64=g_k(ar,pc,g_n(ar,pc)-1);
            s_k(ar,nid,i,pred);
            bdelete(ar,nc,T,c1,pred);
            return;
        }
        if(g_n(ar,c2)>=T){
            // successor
            let sc:i64=c2;
            while(g_leaf(ar,sc)==0){
                sc=g_c(ar,sc,0);
            }
            let succ:i64=g_k(ar,sc,0);
            s_k(ar,nid,i,succ);
            bdelete(ar,nc,T,c2,succ);
            return;
        }
        bmerge(ar,T,nid,i);
        bdelete(ar,nc,T,c1,k);
        return;
    }
    if(g_leaf(ar,nid)==1){
        return;
    }
    let ch:i64=g_c(ar,nid,i);
    if(g_n(ar,ch)<T){
        i=bfill(ar,nc,T,nid,i);
        ch=g_c(ar,nid,i);
    }
    bdelete(ar,nc,T,ch,k);
    return;
}

fn btree_delete(ar:[]u8, nc:[]u8, rt:[]u8, T:i64, k:i64)void {
    let r:i64=get64(rt,0);
    bdelete(ar,nc,T,r,k);
    let r2:i64=get64(rt,0);
    if(g_leaf(ar,r2)==0){
        if(g_n(ar,r2)==0){
            put64(ar,n_off(r2)+88,1);
            put64(rt,0,g_c(ar,r2,0));
        }
    }
    return;
}

fn path_cstr(s:[]u8)*u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let i:i64=0;
    while(i<s.len){
        p[i]=s[i];
        i=i+1;
    }
    p[s.len]=0;
    return p;
}

fn read_all(path:[]u8, mem:*u8, cap:i64)i64 {
    let pp:*u8=path_cstr(path);
    let fd:i64=_zag_raw_syscall(2, pp as i64, 0, 0, 0, 0, 0);
    if(fd<0){return -1;}
    let total:i64=0;
    while(1==1){
        if(total>=cap){break;}
        let want:i64=cap-total;
        if(want>65536){want=65536;}
        let r:i64=_zag_raw_syscall(0, fd, (mem as i64)+total, want, 0, 0, 0);
        if(r<=0){break;}
        total=total+r;
    }
    let c:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

fn print_tree(ar:[]u8, nc:[]u8, rt:[]u8)void {
    let total:i64=get64(nc,0);
    let id:i64=0;
    while(id<total){
        if(get64(ar,n_off(id)+88)==0){
        _zag_print("N");
        _zag_print(i64s(id));
        _zag_print(" leaf=");
        _zag_print(i64s(g_leaf(ar,id)));
        _zag_print(" n=");
        _zag_print(i64s(g_n(ar,id)));
        _zag_print(" keys=");
        let k:i64=0;
        while(k<g_n(ar,id)){
            if(k>0){_zag_print(",");}
            _zag_print(i64s(g_k(ar,id,k)));
            k=k+1;
        }
        _zag_print(" children=");
        if(g_leaf(ar,id)==0){
            let c:i64=0;
            while(c<=g_n(ar,id)){
                if(c>0){_zag_print(",");}
                _zag_print(i64s(g_c(ar,id,c)));
                c=c+1;
            }
        }
        _zag_print("\n");
        }
        id=id+1;
    }
    _zag_print("ROOT ");
    _zag_print(i64s(get64(rt,0)));
    _zag_print("\n");
    return;
}

fn main()void {
    let T:i64={{ORDER}}/2;
    let path:[]u8=_zag_arg(1);
    let mp:*u8=_zag_malloc(65536) as *u8;
    let n:i64=read_all(path, mp, 65536);
    if(n<0){
        _zag_print("BTREE-ERR: cannot read ops\n");
        return;
    }
    let buf:[]u8=mp[0..n];
    let ap:*u8=_zag_malloc(24576) as *u8;
    let ar:[]u8=ap[0..24576];
    let ncp:*u8=_zag_malloc(8) as *u8;
    let nc:[]u8=ncp[0..8];
    put64(nc,0,0);
    let rtp:*u8=_zag_malloc(8) as *u8;
    let rt:[]u8=rtp[0..8];
    let r0:i64=node_new(ar,nc,1);
    put64(rt,0,r0);
    let ls:i64=0;
    let i:i64=0;
    while(i<=n){
        let eol:i64=0;
        if(i==n){eol=1;}
        if(eol==0){
            if(buf[i]==10){eol=1;}
        }
        if(eol==1){
            let ln:i64=i-ls;
            if(ln>0){
                if(buf[i-1]==13){ln=ln-1;}
            }
            if(ln>0){
                let line:[]u8=buf[ls..ls+ln];
                let op:u8=line[0];
                if(op==105){
                    // i <k>
                    let kv:[]u8=line[2..ln];
                    btree_insert(ar,nc,rt,T,parse_i64(kv));
                }
                if(op==100){
                    // d <k>
                    let kv2:[]u8=line[2..ln];
                    btree_delete(ar,nc,rt,T,parse_i64(kv2));
                }
                if(op==112){
                    print_tree(ar,nc,rt);
                }
            }
            ls=i+1;
        }
        i=i+1;
    }
    return;
}

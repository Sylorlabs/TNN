// SNAKE template (dev) — playable snake game.
// Humans build this as: a grid, a snake body as an ordered list of cells
// (head first), scripted food positions, and a move loop — step the head,
// grow on food, end on wall or self collision. Deterministic: no dice,
// food comes from a fixed list.
fn s_eq(a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn parse_i64(s:[]u8)i64 {
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    let v:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48){
            if(c<=57){v=v*10+((c-48) as i64);}
        }
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

fn i64s(v:i64)[]u8 {
    let t:[]u8=_zag_i64_to_str(v);
    let n:i64=t.len;
    if(n>0){
        if(t[n-1]==10){n=n-1;}
    }
    return t[0..n];
}

fn main()void {
    let W:i64={{W}};
    let H:i64={{H}};
    let moves:[]u8=_zag_arg(1);
    let foodarg:[]u8=_zag_arg(2);
    // parse food list "x1,y1;x2,y2"
    let fxp:*u8=_zag_malloc(2048) as *u8;
    let fyp:*u8=_zag_malloc(2048) as *u8;
    let nfood:i64=0;
    let fs:i64=0;
    let fi2:i64=0;
    while(fi2<=foodarg.len){
        let fe:i64=fi2;
        while(fe<foodarg.len){
            if(foodarg[fe]==59){break;}
            fe=fe+1;
        }
        let item:[]u8=foodarg[fs..fe];
        if(item.len>0){
            let cm:i64=0;
            while(cm<item.len){
                if(item[cm]==44){break;}
                cm=cm+1;
            }
            if(cm<item.len){
                let fx:[]u8=item[0..cm];
                let fy:[]u8=item[cm+1..item.len];
                let ox:i64=nfood*8;
                let p1:*u8=fxp;
                let s1:[]u8=p1[0..2048];
                let p2:*u8=fyp;
                let s2:[]u8=p2[0..2048];
                let i:i64=0;
                while(i<8){
                    s1[ox+i]=((parse_i64(fx)>>(i*8))&255) as u8;
                    s2[ox+i]=((parse_i64(fy)>>(i*8))&255) as u8;
                    i=i+1;
                }
                nfood=nfood+1;
            }
        }
        fs=fe+1;
        fi2=fe+1;
    }
    // body arrays (head first), cap 512
    let bxp:*u8=_zag_malloc(4096) as *u8;
    let byp:*u8=_zag_malloc(4096) as *u8;
    let bx:[]u8=bxp[0..4096];
    let by:[]u8=byp[0..4096];
    let blen:i64=3;
    // init helper: store i64 v at idx
    // head (4,4), body (3,4),(2,4)
    let initx0:i64=4;
    let inity0:i64=4;
    let k:i64=0;
    while(k<3){
        let vx:i64=initx0-k;
        let vy:i64=inity0;
        let ox:i64=k*8;
        let j:i64=0;
        while(j<8){
            bx[ox+j]=((vx>>(j*8))&255) as u8;
            by[ox+j]=((vy>>(j*8))&255) as u8;
            j=j+1;
        }
        k=k+1;
    }
    let score:i64=0;
    let fi:i64=0;
    let status:i64=0;
    // 0=RUNNING 1=DEAD_WALL 2=DEAD_SELF
    let mi:i64=0;
    while(mi<moves.len){
        let m:u8=moves[mi];
        let dx:i64=0;
        let dy:i64=0;
        if(m==85){dy=-1;}
        if(m==68){dy=1;}
        if(m==76){dx=-1;}
        if(m==82){dx=1;}
        // head
        let hx:i64=0;
        let hy:i64=0;
        let j2:i64=0;
        while(j2<8){
            hx=hx|(((bx[j2] as i64)&255)<<(j2*8));
            hy=hy|(((by[j2] as i64)&255)<<(j2*8));
            j2=j2+1;
        }
        let nx:i64=hx+dx;
        let ny:i64=hy+dy;
        if(nx<0){status=1;}
        if(nx>=W){status=1;}
        if(ny<0){status=1;}
        if(ny>=H){status=1;}
        if(status!=0){break;}
        let eats:i64=0;
        if(fi<nfood){
            let ffx:i64=0;
            let ffy:i64=0;
            let ox2:i64=fi*8;
            let p1b:*u8=fxp;
            let s1b:[]u8=p1b[0..2048];
            let p2b:*u8=fyp;
            let s2b:[]u8=p2b[0..2048];
            let j3:i64=0;
            while(j3<8){
                ffx=ffx|(((s1b[ox2+j3] as i64)&255)<<(j3*8));
                ffy=ffy|(((s2b[ox2+j3] as i64)&255)<<(j3*8));
                j3=j3+1;
            }
            if(ffx==nx){
                if(ffy==ny){eats=1;}
            }
        }
        // collision: body cells except the tail when not growing
        let lim:i64=blen;
        if(eats==0){lim=blen-1;}
        let hit:i64=0;
        let c:i64=0;
        while(c<lim){
            let cx:i64=0;
            let cy:i64=0;
            let ox3:i64=c*8;
            let j4:i64=0;
            while(j4<8){
                cx=cx|(((bx[ox3+j4] as i64)&255)<<(j4*8));
                cy=cy|(((by[ox3+j4] as i64)&255)<<(j4*8));
                j4=j4+1;
            }
            if(cx==nx){
                if(cy==ny){hit=1;}
            }
            c=c+1;
        }
        if(hit==1){status=2;}
        if(status!=0){break;}
        // shift body right by one
        let s:i64=blen;
        while(s>0){
            let a:i64=s*8;
            let b2:i64=(s-1)*8;
            let j5:i64=0;
            while(j5<8){
                bx[a+j5]=bx[b2+j5];
                by[a+j5]=by[b2+j5];
                j5=j5+1;
            }
            s=s-1;
        }
        let j6:i64=0;
        while(j6<8){
            bx[j6]=((nx>>(j6*8))&255) as u8;
            by[j6]=((ny>>(j6*8))&255) as u8;
            j6=j6+1;
        }
        if(eats==1){
            blen=blen+1;
            score=score+1;
            fi=fi+1;
        }
        mi=mi+1;
    }
    _zag_print("BOARD ");
    _zag_print(i64s(W));
    _zag_print(" ");
    _zag_print(i64s(H));
    _zag_print("\nSNAKE ");
    _zag_print(i64s(blen));
    let c2:i64=0;
    while(c2<blen){
        let cx2:i64=0;
        let cy2:i64=0;
        let ox4:i64=c2*8;
        let j7:i64=0;
        while(j7<8){
            cx2=cx2|(((bx[ox4+j7] as i64)&255)<<(j7*8));
            cy2=cy2|(((by[ox4+j7] as i64)&255)<<(j7*8));
            j7=j7+1;
        }
        _zag_print(" ");
        _zag_print(i64s(cx2));
        _zag_print(",");
        _zag_print(i64s(cy2));
        c2=c2+1;
    }
    _zag_print("\nFOOD ");
    if(fi<nfood){
        let ffx2:i64=0;
        let ffy2:i64=0;
        let ox5:i64=fi*8;
        let p1c:*u8=fxp;
        let s1c:[]u8=p1c[0..2048];
        let p2c:*u8=fyp;
        let s2c:[]u8=p2c[0..2048];
        let j8:i64=0;
        while(j8<8){
            ffx2=ffx2|(((s1c[ox5+j8] as i64)&255)<<(j8*8));
            ffy2=ffy2|(((s2c[ox5+j8] as i64)&255)<<(j8*8));
            j8=j8+1;
        }
        _zag_print(i64s(ffx2));
        _zag_print(",");
        _zag_print(i64s(ffy2));
    } else {
        _zag_print("-1,-1");
    }
    _zag_print("\nSCORE ");
    _zag_print(i64s(score));
    _zag_print("\nSTATUS ");
    if(status==0){_zag_print("RUNNING");}
    if(status==1){_zag_print("DEAD_WALL");}
    if(status==2){_zag_print("DEAD_SELF");}
    _zag_print("\n");
    return;
}

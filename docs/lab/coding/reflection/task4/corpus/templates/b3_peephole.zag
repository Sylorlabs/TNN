// PEEPHOLE template (dev) — stack-VM peephole optimizer.
// Humans build this as: parse linear bytecode, then repeatedly scan for
// short redundant op sequences (constant folds, algebraic identities,
// inverse pairs) and rewrite them, iterating to a fixpoint.
fn s_eq(a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn put64(b:[]u8, o:i64, v:i64)void {
    let i:i64=0;
    while(i<8){
        let sh:i64=i*8;
        b[o+i]=((v>>sh)&255) as u8;
        i=i+1;
    }
    return;
}

fn get64(b:[]u8, o:i64)i64 {
    let v:i64=0;
    let k:i64=0;
    while(k<8){
        v=v|(((b[o+k] as i64)&255)<<(k*8));
        k=k+1;
    }
    return v;
}

fn parse_i64(s:[]u8)i64 {
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    let v:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48){
            if(c<=57){v=v*10+((c-48) as i64);}
        }
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

fn path_cstr(s:[]u8)*u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let i:i64=0;
    while(i<s.len){
        p[i]=s[i];
        i=i+1;
    }
    p[s.len]=0;
    return p;
}

fn read_all(path:[]u8, mem:*u8, cap:i64)i64 {
    let pp:*u8=path_cstr(path);
    let fd:i64=_zag_raw_syscall(2, pp as i64, 0, 0, 0, 0, 0);
    if(fd<0){return -1;}
    let total:i64=0;
    while(1==1){
        if(total>=cap){break;}
        let want:i64=cap-total;
        if(want>65536){want=65536;}
        let r:i64=_zag_raw_syscall(0, fd, (mem as i64)+total, want, 0, 0, 0);
        if(r<=0){break;}
        total=total+r;
    }
    let c:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

fn print(s:[]u8)void {
    _zag_print(s);
    return;
}

fn i64s(v:i64)[]u8 {
    let t:[]u8=_zag_i64_to_str(v);
    let n:i64=t.len;
    if(n>0){
        if(t[n-1]==10){n=n-1;}
    }
    return t[0..n];
}

// op kinds: 0=PUSH 1=ADD 2=SUB 3=MUL 4=DIV 5=DUP 6=SWAP 7=POP 8=NEG
fn op_kind(line:[]u8)i64 {
    if(s_eq(line,"ADD")==1){return 1;}
    if(s_eq(line,"SUB")==1){return 2;}
    if(s_eq(line,"MUL")==1){return 3;}
    if(s_eq(line,"DIV")==1){return 4;}
    if(s_eq(line,"DUP")==1){return 5;}
    if(s_eq(line,"SWAP")==1){return 6;}
    if(s_eq(line,"POP")==1){return 7;}
    if(s_eq(line,"NEG")==1){return 8;}
    return -1;
}

fn main()void {
    let maxops:i64={{MAXOPS}};
    let path:[]u8=_zag_arg(1);
    let mp:*u8=_zag_malloc(262144) as *u8;
    let n:i64=read_all(path, mp, 262144);
    if(n<0){
        print("PEEP-ERR: cannot read program\n");
        return;
    }
    let buf:[]u8=mp[0..n];
    // ops in u64 arena: kind[i], val[i]
    let ap:*u8=_zag_malloc((maxops*16) as i64) as *u8;
    let ar:[]u8=ap[0..(maxops*16) as i64];
    let nop:i64=0;
    let ls:i64=0;
    let i:i64=0;
    while(i<=n){
        let eol:i64=0;
        if(i==n){eol=1;}
        if(eol==0){
            if(buf[i]==10){eol=1;}
        }
        if(eol==1){
            let ln:i64=i-ls;
            if(ln>0){
                if(buf[i-1]==13){ln=ln-1;}
            }
            if(ln>0){
                let line:[]u8=buf[ls..ls+ln];
                // split "PUSH n" vs bare op
                let sp:i64=-1;
                let q:i64=0;
                while(q<ln){
                    if(line[q]==32){sp=q;}
                    q=q+1;
                }
                if(sp<0){
                    let k:i64=op_kind(line);
                    if(k>=0){
                        if(nop<maxops){
                            put64(ar,nop*16,k);
                            put64(ar,nop*16+8,0);
                            nop=nop+1;
                        }
                    }
                } else {
                    let head:[]u8=line[0..sp];
                    if(s_eq(head,"PUSH")==1){
                        let v:[]u8=line[sp+1..ln];
                        if(nop<maxops){
                            put64(ar,nop*16,0);
                            put64(ar,nop*16+8,parse_i64(v));
                            nop=nop+1;
                        }
                    }
                }
            }
            ls=i+1;
        }
        i=i+1;
    }
    // peephole to fixpoint
    let bp:*u8=_zag_malloc((maxops*16) as i64) as *u8;
    let br:[]u8=bp[0..(maxops*16) as i64];
    let changed:i64=1;
    while(changed==1){
        changed=0;
        let w:i64=0;
        let r:i64=0;
        while(r<nop){
            let k0:i64=get64(ar,r*16);
            let v0:i64=get64(ar,r*16+8);
            let k1:i64=-1;
            let v1:i64=0;
            let k2:i64=-1;
            if(r+1<nop){
                k1=get64(ar,(r+1)*16);
                v1=get64(ar,(r+1)*16+8);
            }
            if(r+2<nop){k2=get64(ar,(r+2)*16);}
            let matched:i64=0;
            // 3-op constant folds: PUSH a, PUSH b, ADD/SUB/MUL/DIV (no div-by-zero fold)
            if(matched==0){
                if(k0==0){
                    if(k1==0){
                        if(k2>=1){
                            if(k2<=4){
                                let ok:i64=1;
                                if(k2==4){
                                    if(v1==0){ok=0;}
                                }
                                if(ok==1){
                                    let res:i64=0;
                                    if(k2==1){res=v0+v1;}
                                    if(k2==2){res=v0-v1;}
                                    if(k2==3){res=v0*v1;}
                                    if(k2==4){res=v0/v1;}
                                    put64(br,w*16,0);
                                    put64(br,w*16+8,res);
                                    w=w+1;
                                    r=r+3;
                                    changed=1;
                                    matched=1;
                                }
                            }
                        }
                    }
                }
            }
            // 2-op identities
            if(matched==0){
                if(r+1<nop){
                    // PUSH 0; ADD/SUB -> drop
                    if(k0==0){
                        if(v0==0){
                            if(k1==1){matched=1;r=r+2;changed=1;}
                            if(k1==2){matched=1;r=r+2;changed=1;}
                        }
                        // PUSH 1; MUL -> drop
                        if(v0==1){
                            if(k1==3){matched=1;r=r+2;changed=1;}
                        }
                        // PUSH a; POP -> drop
                        if(k1==7){matched=1;r=r+2;changed=1;}
                        // PUSH 0; MUL -> POP; PUSH 0
                        if(v0==0){
                            if(k1==3){
                                put64(br,w*16,7);
                                put64(br,w*16+8,0);
                                w=w+1;
                                put64(br,w*16,0);
                                put64(br,w*16+8,0);
                                w=w+1;
                                r=r+2;
                                changed=1;
                                matched=1;
                            }
                        }
                    }
                    // DUP; POP -> drop
                    if(k0==5){
                        if(k1==7){matched=1;r=r+2;changed=1;}
                    }
                    // SWAP; SWAP -> drop, NEG; NEG -> drop
                    if(k0==6){
                        if(k1==6){matched=1;r=r+2;changed=1;}
                    }
                    if(k0==8){
                        if(k1==8){matched=1;r=r+2;changed=1;}
                    }
                }
            }
            if(matched==0){
                put64(br,w*16,k0);
                put64(br,w*16+8,v0);
                w=w+1;
                r=r+1;
            }
        }
        // copy back
        let c:i64=0;
        while(c<w){
            put64(ar,c*16,get64(br,c*16));
            put64(ar,c*16+8,get64(br,c*16+8));
            c=c+1;
        }
        nop=w;
    }
    // print
    let o:i64=0;
    while(o<nop){
        let k:i64=get64(ar,o*16);
        if(k==0){
            print("PUSH ");
            _zag_print(i64s(get64(ar,o*16+8)));
            print("\n");
        }
        if(k==1){print("ADD\n");}
        if(k==2){print("SUB\n");}
        if(k==3){print("MUL\n");}
        if(k==4){print("DIV\n");}
        if(k==5){print("DUP\n");}
        if(k==6){print("SWAP\n");}
        if(k==7){print("POP\n");}
        if(k==8){print("NEG\n");}
        o=o+1;
    }
    return;
}

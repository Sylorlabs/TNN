// HUFFMAN template (dev) — byte-alphabet Huffman codec.
// Humans build this as: count symbol frequencies, repeatedly join the two
// lightest trees (ties broken by smallest symbol, so the build is
// deterministic), read code lengths off the tree by depth-first walk,
// pack the code bits, and decode by walking the tree bit by bit.
fn parse_i64(s:[]u8)i64 {
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    let v:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48){
            if(c<=57){v=v*10+((c-48) as i64);}
        }
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

fn i64s(v:i64)[]u8 {
    let t:[]u8=_zag_i64_to_str(v);
    let n:i64=t.len;
    if(n>0){
        if(t[n-1]==10){n=n-1;}
    }
    return t[0..n];
}

fn hexval(c:u8)i64 {
    if(c>=48){
        if(c<=57){return (c-48) as i64;}
    }
    if(c>=97){
        if(c<=102){return (c-97+10) as i64;}
    }
    if(c>=65){
        if(c<=70){return (c-65+10) as i64;}
    }
    return -1;
}

fn main()void {
    let ALPHA:i64={{ALPHABET}};
    let mode:[]u8=_zag_arg(1);
    let hex:[]u8=_zag_arg(2);
    // hex -> bytes
    let np:*u8=_zag_malloc(4096) as *u8;
    let inp:[]u8=np[0..4096];
    let inlen:i64=0;
    let hi:i64=0;
    while(hi+1<hex.len){
        let a:i64=hexval(hex[hi]);
        let b:i64=hexval(hex[hi+1]);
        if(a<0){break;}
        if(b<0){break;}
        inp[inlen]=(a*16+b) as u8;
        inlen=inlen+1;
        hi=hi+2;
    }
    // frequency table in u64 arena
    let fp:*u8=_zag_malloc((ALPHA*8) as i64) as *u8;
    let fr:[]u8=fp[0..(ALPHA*8) as i64];
    let s:i64=0;
    while(s<ALPHA){
        let j:i64=0;
        while(j<8){
            fr[s*8+j]=0;
            j=j+1;
        }
        s=s+1;
    }
    let p:i64=0;
    while(p<inlen){
        let sym:i64=(inp[p] as i64);
        let o:i64=sym*8;
        let f:i64=0;
        let j2:i64=0;
        while(j2<8){
            f=f|(((fr[o+j2] as i64)&255)<<(j2*8));
            j2=j2+1;
        }
        f=f+1;
        let j3:i64=0;
        while(j3<8){
            fr[o+j3]=((f>>(j3*8))&255) as u8;
            j3=j3+1;
        }
        p=p+1;
    }
    // node arenas: FREQ, SYM(min symbol), LEFT, RIGHT, LEAF(1/0); cap 2*ALPHA
    let cap:i64=ALPHA*2;
    let n1:*u8=_zag_malloc((cap*8) as i64) as *u8;
    let n2:*u8=_zag_malloc((cap*8) as i64) as *u8;
    let n3:*u8=_zag_malloc((cap*8) as i64) as *u8;
    let n4:*u8=_zag_malloc((cap*8) as i64) as *u8;
    let n5:*u8=_zag_malloc((cap*8) as i64) as *u8;
    let FQ:[]u8=n1[0..(cap*8) as i64];
    let SY:[]u8=n2[0..(cap*8) as i64];
    let LF:[]u8=n3[0..(cap*8) as i64];
    let RT:[]u8=n4[0..(cap*8) as i64];
    let ISLF:[]u8=n5[0..(cap*8) as i64];
    let NONE:i64=-1;
    // leaf nodes for symbols with freq>0
    let nn:i64=0;
    let q:i64=0;
    while(q<ALPHA){
        let o2:i64=q*8;
        let f2:i64=0;
        let j4:i64=0;
        while(j4<8){
            f2=f2|(((fr[o2+j4] as i64)&255)<<(j4*8));
            j4=j4+1;
        }
        if(f2>0){
            let no:i64=nn*8;
            let j5:i64=0;
            while(j5<8){
                FQ[no+j5]=((f2>>(j5*8))&255) as u8;
                SY[no+j5]=((q>>(j5*8))&255) as u8;
                j5=j5+1;
            }
            // LEFT/RIGHT = NONE(-1), ISLF=1
            let j6:i64=0;
            while(j6<8){
                LF[no+j6]=255;
                RT[no+j6]=255;
                j6=j6+1;
            }
            ISLF[no]=1;
            let j7:i64=1;
            while(j7<8){
                ISLF[no+j7]=0;
                j7=j7+1;
            }
            nn=nn+1;
        }
        q=q+1;
    }
    let nsym:i64=nn;
    // alive list
    let ap:*u8=_zag_malloc((cap*8) as i64) as *u8;
    let AL:[]u8=ap[0..(cap*8) as i64];
    let ai:i64=0;
    while(ai<nn){
        let j8:i64=0;
        while(j8<8){
            AL[ai*8+j8]=((ai>>(j8*8))&255) as u8;
            j8=j8+1;
        }
        ai=ai+1;
    }
    let nalive:i64=nn;
    let root:i64=0;
    if(nsym==0){
        _zag_print("0\n\n\n");
        return;
    }
    if(nsym>1){
        while(nalive>1){
            // find two smallest by (freq, sym)
            let b1:i64=-1;
            let b2:i64=-1;
            let f1:i64=0;
            let f2:i64=0;
            let s1:i64=0;
            let s2:i64=0;
            let first:i64=1;
            let a:i64=0;
            while(a<nalive){
                let id:i64=0;
                let j9:i64=0;
                while(j9<8){
                    id=id|(((AL[a*8+j9] as i64)&255)<<(j9*8));
                    j9=j9+1;
                }
                let fo:i64=id*8;
                let ff:i64=0;
                let ss:i64=0;
                let j10:i64=0;
                while(j10<8){
                    ff=ff|(((FQ[fo+j10] as i64)&255)<<(j10*8));
                    ss=ss|(((SY[fo+j10] as i64)&255)<<(j10*8));
                    j10=j10+1;
                }
                let better:i64=0;
                if(first==1){better=1;}
                if(first==0){
                    if(ff<f1){better=1;}
                    if(ff==f1){
                        if(ss<s1){better=1;}
                    }
                }
                if(better==1){
                    b2=b1;f2=f1;s2=s1;
                    b1=id;f1=ff;s1=ss;
                    first=0;
                } else {
                    let better2:i64=0;
                    if(b2<0){better2=1;}
                    if(b2>=0){
                        if(ff<f2){better2=1;}
                        if(ff==f2){
                            if(ss<s2){better2=1;}
                        }
                    }
                    if(better2==1){b2=id;f2=ff;s2=ss;}
                }
                a=a+1;
            }
            // join b1,b2 into nn
            let no2:i64=nn*8;
            let nf:i64=f1+f2;
            let ns:i64=s1;
            if(s2<s1){ns=s2;}
            let j11:i64=0;
            while(j11<8){
                FQ[no2+j11]=((nf>>(j11*8))&255) as u8;
                SY[no2+j11]=((ns>>(j11*8))&255) as u8;
                LF[no2+j11]=((b1>>(j11*8))&255) as u8;
                RT[no2+j11]=((b2>>(j11*8))&255) as u8;
                ISLF[no2+j11]=0;
                j11=j11+1;
            }
            // rebuild alive without b1,b2, plus nn
            let nap:*u8=_zag_malloc((cap*8) as i64) as *u8;
            let NA:[]u8=nap[0..(cap*8) as i64];
            let w:i64=0;
            let a2:i64=0;
            while(a2<nalive){
                let id2:i64=0;
                let j12:i64=0;
                while(j12<8){
                    id2=id2|(((AL[a2*8+j12] as i64)&255)<<(j12*8));
                    j12=j12+1;
                }
                if(id2!=b1){
                    if(id2!=b2){
                        let j13:i64=0;
                        while(j13<8){
                            NA[w*8+j13]=((id2>>(j13*8))&255) as u8;
                            j13=j13+1;
                        }
                        w=w+1;
                    }
                }
                a2=a2+1;
            }
            let j14:i64=0;
            while(j14<8){
                NA[w*8+j14]=((nn>>(j14*8))&255) as u8;
                j14=j14+1;
            }
            w=w+1;
            // copy back into AL
            let c:i64=0;
            while(c<w){
                let j15:i64=0;
                while(j15<8){
                    AL[c*8+j15]=NA[c*8+j15];
                    j15=j15+1;
                }
                c=c+1;
            }
            nalive=w;
            nn=nn+1;
        }
        let j16:i64=0;
        while(j16<8){
            root=root|(((AL[j16] as i64)&255)<<(j16*8));
            j16=j16+1;
        }
    } else {
        root=0;
    }
    // code lengths + codes via DFS stack
    let cp:*u8=_zag_malloc((ALPHA*8) as i64) as *u8;
    let lp:*u8=_zag_malloc((ALPHA*8) as i64) as *u8;
    let CD:[]u8=cp[0..(ALPHA*8) as i64];
    let CL:[]u8=lp[0..(ALPHA*8) as i64];
    let sp:*u8=_zag_malloc((cap*24) as i64) as *u8;
    let ST:[]u8=sp[0..(cap*24) as i64];
    let stn:i64=0;
    // push (root, code=0, len)
    if(nsym==1){
        // single symbol: code "0", length 1
        let so:i64=0;
        let j17:i64=0;
        while(j17<8){
            so=so|(((SY[j17] as i64)&255)<<(j17*8));
            j17=j17+1;
        }
        let j18:i64=0;
        while(j18<8){
            CD[so*8+j18]=0;
            if(j18==0){CL[so*8]=1;}
            if(j18>0){CL[so*8+j18]=0;}
            j18=j18+1;
        }
    } else {
        let j19:i64=0;
        while(j19<8){
            ST[j19]=((root>>(j19*8))&255) as u8;
            ST[8+j19]=0;
            ST[16+j19]=0;
            j19=j19+1;
        }
        stn=1;
        while(stn>0){
            stn=stn-1;
            let nid:i64=0;
            let ncode:i64=0;
            let nlen:i64=0;
            let j20:i64=0;
            while(j20<8){
                nid=nid|(((ST[stn*24+j20] as i64)&255)<<(j20*8));
                ncode=ncode|(((ST[stn*24+8+j20] as i64)&255)<<(j20*8));
                nlen=nlen|(((ST[stn*24+16+j20] as i64)&255)<<(j20*8));
                j20=j20+1;
            }
            let islf:i64=0;
            let j21:i64=0;
            while(j21<8){
                islf=islf|(((ISLF[nid*8+j21] as i64)&255)<<(j21*8));
                j21=j21+1;
            }
            if(islf==1){
                let sym2:i64=0;
                let j22:i64=0;
                while(j22<8){
                    sym2=sym2|(((SY[nid*8+j22] as i64)&255)<<(j22*8));
                    j22=j22+1;
                }
                let j23:i64=0;
                while(j23<8){
                    CD[sym2*8+j23]=((ncode>>(j23*8))&255) as u8;
                    CL[sym2*8+j23]=((nlen>>(j23*8))&255) as u8;
                    j23=j23+1;
                }
            } else {
                let lc:i64=0;
                let rc:i64=0;
                let j24:i64=0;
                while(j24<8){
                    lc=lc|(((LF[nid*8+j24] as i64)&255)<<(j24*8));
                    rc=rc|(((RT[nid*8+j24] as i64)&255)<<(j24*8));
                    j24=j24+1;
                }
                // push right then left (stack order irrelevant)
                let j25:i64=0;
                while(j25<8){
                    ST[stn*24+j25]=((rc>>(j25*8))&255) as u8;
                    ST[stn*24+8+j25]=(((ncode*2+1)>>(j25*8))&255) as u8;
                    ST[stn*24+16+j25]=(((nlen+1)>>(j25*8))&255) as u8;
                    j25=j25+1;
                }
                stn=stn+1;
                let j26:i64=0;
                while(j26<8){
                    ST[stn*24+j26]=((lc>>(j26*8))&255) as u8;
                    ST[stn*24+8+j26]=(((ncode*2)>>(j26*8))&255) as u8;
                    ST[stn*24+16+j26]=(((nlen+1)>>(j26*8))&255) as u8;
                    j26=j26+1;
                }
                stn=stn+1;
            }
        }
    }
    // total bits
    let nbits:i64=0;
    let p2:i64=0;
    while(p2<inlen){
        let sym3:i64=(inp[p2] as i64);
        let ln:i64=0;
        let j27:i64=0;
        while(j27<8){
            ln=ln|(((CL[sym3*8+j27] as i64)&255)<<(j27*8));
            j27=j27+1;
        }
        nbits=nbits+ln;
        p2=p2+1;
    }
    // encode bits MSB-first into bytes
    let nbytes:i64=(nbits+7)/8;
    let bp:*u8=_zag_malloc(nbytes+1) as *u8;
    let bits:[]u8=bp[0..nbytes+1];
    let bz:i64=0;
    while(bz<nbytes+1){
        bits[bz]=0;
        bz=bz+1;
    }
    let bitpos:i64=0;
    let p3:i64=0;
    while(p3<inlen){
        let sym4:i64=(inp[p3] as i64);
        let code:i64=0;
        let ln2:i64=0;
        let j28:i64=0;
        while(j28<8){
            code=code|(((CD[sym4*8+j28] as i64)&255)<<(j28*8));
            ln2=ln2|(((CL[sym4*8+j28] as i64)&255)<<(j28*8));
            j28=j28+1;
        }
        let b:i64=ln2-1;
        while(b>=0){
            let bit:i64=(code>>b)&1;
            let by:i64=bitpos/8;
            let bo:i64=7-(bitpos%8);
            if(bit==1){
                bits[by]=bits[by]|((1<<bo) as u8);
            }
            bitpos=bitpos+1;
            b=b-1;
        }
        p3=p3+1;
    }
    // decode by tree walk
    let dp:*u8=_zag_malloc(inlen+1) as *u8;
    let dec:[]u8=dp[0..inlen+1];
    let dlen:i64=0;
    if(nsym==1){
        let so2:i64=0;
        let j29:i64=0;
        while(j29<8){
            so2=so2|(((SY[j29] as i64)&255)<<(j29*8));
            j29=j29+1;
        }
        let b2:i64=0;
        while(b2<nbits){
            dec[dlen]=so2 as u8;
            dlen=dlen+1;
            b2=b2+1;
        }
    } else {
        let node:i64=root;
        let bp2:i64=0;
        while(bp2<nbits){
            let by2:i64=bp2/8;
            let bo2:i64=7-(bp2%8);
            let bit2:i64=((bits[by2] as i64)>>bo2)&1;
            let no3:i64=node*8;
            let nx:i64=0;
            let j30:i64=0;
            while(j30<8){
                if(bit2==1){
                    nx=nx|(((RT[no3+j30] as i64)&255)<<(j30*8));
                } else {
                    nx=nx|(((LF[no3+j30] as i64)&255)<<(j30*8));
                }
                j30=j30+1;
            }
            node=nx;
            let il:i64=0;
            let j31:i64=0;
            while(j31<8){
                il=il|(((ISLF[node*8+j31] as i64)&255)<<(j31*8));
                j31=j31+1;
            }
            if(il==1){
                let sm:i64=0;
                let j32:i64=0;
                while(j32<8){
                    sm=sm|(((SY[node*8+j32] as i64)&255)<<(j32*8));
                    j32=j32+1;
                }
                dec[dlen]=sm as u8;
                dlen=dlen+1;
                node=root;
            }
            bp2=bp2+1;
        }
    }
    // print: nbits, hex(bits), hex(decoded)
    _zag_print(i64s(nbits));
    _zag_print("\n");
    let hx:[]u8="0123456789abcdef";
    let o:i64=0;
    while(o<nbytes){
        let bv:u8=bits[o];
        let mp:*u8=_zag_malloc(2) as *u8;
        let ms:[]u8=mp[0..2];
        ms[0]=hx[(bv>>4)&15];
        ms[1]=hx[bv&15];
        _zag_print(ms);
        o=o+1;
    }
    _zag_print("\n");
    let d:i64=0;
    while(d<dlen){
        let bv2:u8=dec[d];
        let mp2:*u8=_zag_malloc(2) as *u8;
        let ms2:[]u8=mp2[0..2];
        ms2[0]=hx[(bv2>>4)&15];
        ms2[1]=hx[bv2&15];
        _zag_print(ms2);
        d=d+1;
    }
    _zag_print("\n");
    return;
}

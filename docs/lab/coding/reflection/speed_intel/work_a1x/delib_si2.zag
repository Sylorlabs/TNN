// delib_si.zag — speed-intelligence Arm 1, epistemic slice.
// Copy of delib_sa.zag: pipeline stages, knowledge, and predicates IDENTICAL.
// Only the deliberation-depth budget varies (argv[2]: 1|2|4|8):
//   1x: world-knowledge checks only (steps 1, 2, 4, 5 — no speech-act matchers)
//   2x: full pipeline (1x + all 6 speech-act matchers)
//   4x: 2x + one reconsideration round on non-unanimous items
//       (>=1 matcher fired AND >=1 counter-marker present):
//       count pro/con marker evidence; majority wins; ties keep the 2x verdict
//   8x: 4x + independent verification pass on every item: re-derive the final
//       verdict from the evidence ledger through an independent code path;
//       disagreement -> verdict=WITHHOLD, counted as a verification-flip.
//
// Counter-markers (factual evidence, crew-designed per frozen prereg 3d):
//   CM1: is_known_true fired (utterance matches known world truth)
//   CM2: assertion-form: an assertion frame (" is "," are "," has "," have ",
//        " was "," were ") plus a digit — the structural form of a checkable
//        world claim. Co-occurrence with a fired speech-act matcher is
//        conflicting evidence about the utterance's status.
// Pro markers: each fired non-factual predicate (known_false, absurd, and the
// 6 speech-act matchers). Con markers: CM1 + CM2.
//
// Cost: every predicate-function evaluation counts 1. All predicates are
// evaluated for every item (no short-circuit) so the evidence ledger is
// complete; the staged decision on the ledger bits yields verdicts provably
// identical to the short-circuit pipeline (validated byte-identical against
// the committed arm1/arm2 scored evidence at 1x/2x).
//
// Usage: delib_si_bin <workdir> <budget:1|2|4|8> <items-file>
// Output: one line per item: ID|ENDORSE|WITHHOLD|preds=N|recon=R|vflip=V
// (fields 1-2 are byte-compatible with delib_sa.zag output)
// Then SUMMARY and COST lines. Exit 0 on success.

@import("../../../../prose-learning/epistemic_wave/src/R33_NATIVE_IO_V1.zag")
@import("../../../../prose-learning/epistemic_wave/src/R33_NATIVE_SHA256_V2.zag")

// ---------- small helpers (identical to delib_sa.zag) ----------

fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    b[s.len]=0;
    return b;
}

fn read_file(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root, name, 0);
    if(fd<0){ return nio_alloc(0); }
    let buf:[]u8=nio_alloc(65536);
    let n:i64=nio_read_exact(fd, buf, 65536);
    nio_close(fd);
    if(n<0){ return nio_alloc(0); }
    return buf[0..n as i32];
}

fn arg_copy(n:i32)[]u8 {
    let s:[]u8=_zag_arg(n);
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    return b[0..s.len];
}

fn has_sub(hay:[]u8, ndl:[]u8)i32 {
    if(ndl.len==0 || ndl.len>hay.len){ return 0; }
    let i:i32=0;
    while(i+ndl.len<=hay.len){
        let j:i32=0;
        while(j<ndl.len && hay[i+j]==ndl[j]){ j=j+1; }
        if(j==ndl.len){ return 1; }
        i=i+1;
    }
    return 0;
}

// lowercase ASCII in place into dst (dst must be >= src.len)
fn to_lower(dst:[]u8, src:[]u8)[]u8 {
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c>=65 && c<=90){ dst[i]=c+32; } else { dst[i]=c; }
        i=i+1;
    }
    return dst[0..src.len];
}

// ---------- knowledge (identical to delib_sa.zag) ----------

fn is_pos_word(w:[]u8)i32 {
    if(has_sub(w,"great")==1){ return 1; }
    if(has_sub(w,"wonderful")==1){ return 1; }
    if(has_sub(w,"fantastic")==1){ return 1; }
    if(has_sub(w,"love")==1){ return 1; }
    if(has_sub(w,"best")==1){ return 1; }
    if(has_sub(w,"brilliant")==1){ return 1; }
    if(has_sub(w,"perfect")==1){ return 1; }
    if(has_sub(w,"awesome")==1){ return 1; }
    return 0;
}

fn is_neg_situation(w:[]u8)i32 {
    if(has_sub(w,"flat tire")==1){ return 1; }
    if(has_sub(w,"6 am")==1){ return 1; }
    if(has_sub(w,"delayed")==1){ return 1; }
    if(has_sub(w,"monday")==1){ return 1; }
    if(has_sub(w,"broke")==1){ return 1; }
    if(has_sub(w,"failed")==1){ return 1; }
    if(has_sub(w,"terrible")==1){ return 1; }
    if(has_sub(w,"awful")==1){ return 1; }
    if(has_sub(w,"worst")==1){ return 1; }
    return 0;
}

fn is_absurd(w:[]u8)i32 {
    if(has_sub(w,"goldfish filed")==1){ return 1; }
    if(has_sub(w,"toaster")==1 && has_sub(w,"chess")==1){ return 1; }
    if(has_sub(w,"complaint about the water")==1){ return 1; }
    if(has_sub(w,"moon called in sick")==1){ return 1; }
    if(has_sub(w,"tides took the day off")==1){ return 1; }
    if(has_sub(w,"refrigerator")==1 && has_sub(w,"therapist")==1){ return 1; }
    if(has_sub(w,"arm-wrestled a tornado")==1){ return 1; }
    if(has_sub(w,"tornado")==1 && has_sub(w,"call it a draw")==1){ return 1; }
    return 0;
}

fn is_known_false(w:[]u8)i32 {
    if(has_sub(w,"triangle has 4 sides")==1){ return 1; }
    if(has_sub(w,"spider has 7 legs")==1){ return 1; }
    if(has_sub(w,"baseball team has 10 players")==1){ return 1; }
    if(has_sub(w,"38 plays")==1 && has_sub(w,"shakespeare")==1){ return 1; }
    if(has_sub(w,"d has an alphabet position of 5")==1){ return 1; }
    if(has_sub(w,"d has alphabet position 6")==1){ return 1; }
    if(has_sub(w,"saturday")==1 && has_sub(w,"letter count of 7")==1){ return 1; }
    if(has_sub(w,"incontrovertibleness")==1 && has_sub(w,"21")==1){ return 1; }
    if(has_sub(w,"knowledge has a letter count of 8")==1){ return 1; }
    if(has_sub(w,"pilgrim")==1 && has_sub(w,"1688")==1){ return 1; }
    if(has_sub(w,"david copperfield")==1 && has_sub(w,"1851")==1){ return 1; }
    if(has_sub(w,"time machine")==1 && has_sub(w,"1896")==1){ return 1; }
    return 0;
}

fn is_known_true(w:[]u8)i32 {
    if(has_sub(w,"alphabet position of a is 1")==1){ return 1; }
    if(has_sub(w,"alphabet position of e is 5")==1){ return 1; }
    if(has_sub(w,"alphabet position of m is 13")==1){ return 1; }
    return 0;
}

fn matches_sarcasm(w:[]u8)i32 {
    if(is_pos_word(w)==1 && is_neg_situation(w)==1){ return 1; }
    return 0;
}

fn matches_hypothetical(w:[]u8)i32 {
    if(has_sub(w,"suppose")==1){ return 1; }
    if(has_sub(w,"hypothetically")==1){ return 1; }
    if(has_sub(w,"what if")==1){ return 1; }
    if(has_sub(w,"imagine if")==1){ return 1; }
    if(has_sub(w,"if dogs could talk")==1){ return 1; }
    return 0;
}

fn matches_counterfactual(w:[]u8)i32 {
    if(has_sub(w,"if i had")==1){ return 1; }
    if(has_sub(w,"would have")==1){ return 1; }
    if(has_sub(w,"could have")==1){ return 1; }
    if(has_sub(w,"if i were")==1){ return 1; }
    return 0;
}

fn matches_analogy(w:[]u8)i32 {
    if(has_sub(w,"is a drill sergeant")==1){ return 1; }
    if(has_sub(w,"voice is honey")==1){ return 1; }
    if(has_sub(w,"was a marathon")==1){ return 1; }
    if(has_sub(w,"is honey")==1){ return 1; }
    return 0;
}

fn matches_poetry(w:[]u8)i32 {
    if(has_sub(w,"moon poured")==1){ return 1; }
    if(has_sub(w,"autumn writes")==1){ return 1; }
    if(has_sub(w,"river keeps")==1){ return 1; }
    if(has_sub(w,"dawn unbuttons")==1){ return 1; }
    if(has_sub(w,"oak holds")==1){ return 1; }
    if(has_sub(w,"dreamed in quiet")==1){ return 1; }
    if(has_sub(w,"burning leaves")==1){ return 1; }
    if(has_sub(w,"sky's secrets")==1){ return 1; }
    if(has_sub(w,"spill out like coins")==1){ return 1; }
    if(has_sub(w,"patient hands")==1){ return 1; }
    return 0;
}

fn matches_implicature(w:[]u8)i32 {
    if(has_sub(w,"cold in here")==1){ return 1; }
    if(has_sub(w,"trash is getting full")==1){ return 1; }
    if(has_sub(w,"going to eat all of that")==1){ return 1; }
    if(has_sub(w,"meeting starts in five")==1){ return 1; }
    if(has_sub(w,"left the lights on")==1){ return 1; }
    return 0;
}

// ---------- budget-4x counter-marker ----------
// CM2: assertion-form — an assertion frame plus a digit: the structural form
// of a checkable world claim.
fn has_digit(w:[]u8)i32 {
    if(has_sub(w,"0")==1){ return 1; }
    if(has_sub(w,"1")==1){ return 1; }
    if(has_sub(w,"2")==1){ return 1; }
    if(has_sub(w,"3")==1){ return 1; }
    if(has_sub(w,"4")==1){ return 1; }
    if(has_sub(w,"5")==1){ return 1; }
    if(has_sub(w,"6")==1){ return 1; }
    if(has_sub(w,"7")==1){ return 1; }
    if(has_sub(w,"8")==1){ return 1; }
    if(has_sub(w,"9")==1){ return 1; }
    return 0;
}

fn is_assertion_form(w:[]u8)i32 {
    let frame:i32=0;
    if(has_sub(w," is ")==1){ frame=1; }
    if(has_sub(w," are ")==1){ frame=1; }
    if(has_sub(w," has ")==1){ frame=1; }
    if(has_sub(w," have ")==1){ frame=1; }
    if(has_sub(w," was ")==1){ frame=1; }
    if(has_sub(w," were ")==1){ frame=1; }
    if(frame==0){ return 0; }
    if(has_digit(w)==1){ return 1; }
    return 0;
}

// ---------- 8x independent verification ----------
// Re-derives the final verdict from the evidence ledger through an
// independent (arithmetic, separately written) code path. Returns the
// re-derived verdict: 1 = ENDORSE, 0 = WITHHOLD.
fn verify_ledger(kf:i32, ab:i32, nmatch:i32, kt:i32, cm2:i32, v_pre:i32, recon:i32)i32 {
    // v_pre: the staged pipeline verdict before reconsideration
    // recon: 1 if the reconsideration round ran, else 0
    let nonfac:i32=kf+ab+nmatch;
    let pv:i32=1;
    if(nonfac>0){ pv=0; }
    // pv must equal v_pre; if the ledger disagrees with the staged path,
    // that itself is a derivation fault -> withhold
    if(pv!=v_pre){ return 0; }
    let v:i32=v_pre;
    if(recon==1){
        let pro:i32=kf+ab+nmatch;
        let con:i32=kt+cm2;
        if(pro>con){ v=0; }
        else {
            if(con>pro){ v=1; }
        }
    }
    return v;
}

// ---------- deliberation ----------
// Fills the evidence ledger (all predicates evaluated, no short-circuit),
// stages the pipeline decision on the ledger bits, optionally reconsiders
// (4x) and verifies (8x).
// Returns packed i64: (pc<<32)+(recon<<16)+(vflip<<8)+verdict,
// where pc = predicate evaluations, verdict 1=ENDORSE 0=WITHHOLD.

fn deliberate_si(low:[]u8, budget:i32)i64 {
    // evidence ledger
    let pc:i64=0;
    let kf:i32=is_known_false(low); pc=pc+1;
    let ab:i32=is_absurd(low); pc=pc+1;
    let ms:i32=0;
    let mhy:i32=0;
    let mcf:i32=0;
    let mana:i32=0;
    let mpoe:i32=0;
    let mimp:i32=0;
    if(budget>=2){
        ms=matches_sarcasm(low); pc=pc+1;
        mhy=matches_hypothetical(low); pc=pc+1;
        mcf=matches_counterfactual(low); pc=pc+1;
        mana=matches_analogy(low); pc=pc+1;
        mpoe=matches_poetry(low); pc=pc+1;
        mimp=matches_implicature(low); pc=pc+1;
    }
    let kt:i32=is_known_true(low); pc=pc+1;
    let nmatch:i32=ms+mhy+mcf+mana+mpoe+mimp;

    // staged pipeline decision on the ledger (verdict-identical to the
    // short-circuit original: withhold iff any non-factual evidence)
    let v:i32=1;
    if(kf==1){ v=0; }
    else {
        if(ab==1){ v=0; }
        else {
            if(nmatch>=1){ v=0; }
        }
    }
    // (known_true and default both endorse; no branch needed)

    // 4x: one reconsideration round on non-unanimous items
    let recon:i32=0;
    let cm2:i32=0;
    if(budget>=4 && nmatch>=1){
        cm2=is_assertion_form(low); pc=pc+1;
        let cm1:i32=kt;
        if(cm1+cm2>=1){
            recon=1;
            pc=pc+1; // majority decision counts as a deliberation step
            let pro:i32=kf+ab+nmatch;
            let con:i32=cm1+cm2;
            if(pro>con){ v=0; }
            else {
                if(con>pro){ v=1; }
            }
            // tie: keep the 2x (staged) verdict
        }
    }

    // 8x: independent verification pass
    let vf:i32=0;
    if(budget>=8){
        pc=pc+1; // the verification derivation counts as one evaluation
        let vv:i32=verify_ledger(kf, ab, nmatch, kt, cm2, v, recon);
        if(vv!=v){ vf=1; v=0; }
    }
    let sh32:i64=pc<<32;
    let sh16:i64=(recon as i64)<<16;
    let sh8:i64=(vf as i64)<<8;
    return sh32+sh16+sh8+(v as i64);
}

// ---------- driver ----------

fn main()void {
    let workdir:[]u8=arg_copy(1);
    let bs:[]u8=arg_copy(2);
    let items_s:[]u8=arg_copy(3);
    let budget:i32=2;
    if(bs.len>0){
        // delib_si2 SINGLE CHANGE (per PREREG_SI_A1X §2): parse the budget
        // argument as a full non-negative integer so 16/32 work. The
        // frozen build only matched the first character ('1'->1, so "16"
        // would have meant 1). All deliberation logic below is untouched.
        let bv:i32=0;
        let bi:i32=0;
        let bok:i32=1;
        while(bi<bs.len){
            let c:u8=bs[bi];
            if(c>=48 && c<=57){ bv=bv*10+((c as i32)-48); }
            else { bok=0; }
            bi=bi+1;
        }
        if(bok==1){ budget=bv; }
    }

    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_print("ERR workdir\n"); return; }
    let data:[]u8=read_file(root, items_s);
    if(data.len==0){ _zag_print("ERR items\n"); return; }

    let n:i32=0;
    let endorse:i32=0;
    let withhold:i32=0;
    let preds_total:i64=0;
    let recon_total:i32=0;
    let vflip_total:i32=0;
    let pos:i32=0;
    let tmp:[]u8=nio_alloc(4096);
    while(pos<data.len){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=data[pos..eol];
        if(line.len>4){
            let sep:i32=0;
            while(sep<line.len && line[sep]!=124){ sep=sep+1; }
            if(sep<line.len){
                let id:[]u8=line[0..sep];
                let utt:[]u8=line[sep+1..line.len];
                let low:[]u8=to_lower(tmp, utt);
                let pk:i64=deliberate_si(low, budget);
                let d:i32=(pk & 255) as i32;
                let s8:i64=pk>>8;
                let vf:i32=(s8 & 255) as i32;
                let s16:i64=pk>>16;
                let rc:i32=(s16 & 255) as i32;
                let pc:i64=pk>>32;
                preds_total=preds_total+pc;
                recon_total=recon_total+rc;
                vflip_total=vflip_total+vf;
                _zag_print(id);
                if(d==1){ _zag_print("|ENDORSE"); endorse=endorse+1; }
                else { _zag_print("|WITHHOLD"); withhold=withhold+1; }
                _zag_print("|preds=");
                _zag_print(_zag_i64_to_str(pc));
                _zag_print("|recon=");
                _zag_print(_zag_i64_to_str(rc as i64));
                _zag_print("|vflip=");
                _zag_print(_zag_i64_to_str(vf as i64));
                _zag_print("\n");
                n=n+1;
            }
        }
        pos=eol+1;
    }
    _zag_print("SUMMARY n=");
    _zag_print(_zag_i64_to_str(n as i64));
    _zag_print(" endorse=");
    _zag_print(_zag_i64_to_str(endorse as i64));
    _zag_print(" withhold=");
    _zag_print(_zag_i64_to_str(withhold as i64));
    _zag_print("\n");
    _zag_print("COST preds_total=");
    _zag_print(_zag_i64_to_str(preds_total));
    _zag_print(" recon_items=");
    _zag_print(_zag_i64_to_str(recon_total as i64));
    _zag_print(" vflips=");
    _zag_print(_zag_i64_to_str(vflip_total as i64));
    _zag_print("\n");
    return;
}

fn t4_selsort(cx:*Cx, nums:[]i64, off:i64, cnt:i64)void {
    e_raw(cx,"fn selsort(a:[]i64,n:i64)void {\n");
    e_raw(cx,"    let i:i64=0;\n");
    e_raw(cx,"    while(i<n){\n");
    e_raw(cx,"        let m:i64=i;\n");
    e_raw(cx,"        let j:i64=i+1;\n");
    e_raw(cx,"        while(j<n){\n");
    e_raw(cx,"            if(a[j]<a[m]){m=j;}\n");
    e_raw(cx,"            j=j+1;\n");
    e_raw(cx,"        }\n");
    e_raw(cx,"        let t:i64=a[i];\n");
    e_raw(cx,"        a[i]=a[m];\n");
    e_raw(cx,"        a[m]=t;\n");
    e_raw(cx,"        i=i+1;\n");
    e_raw(cx,"    }\n");
    e_raw(cx,"    return;\n");
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    e_build_arr_nums(cx,nums,off,cnt);
    e_raw(cx,"    selsort(arr,");
    e_i64(cx,cnt);
    e_raw(cx,");\n");
    e_print_arr(cx,cnt);
    e_raw(cx,"}\n");
    return;
}

// argvsum with a manual card: extract first fenced code block, prepend, then wire
fn card_code(card:[]u8)[]u8 {
    let f1:i64=s_find(card,"```",0);
    if(f1<0){let e:[]u8="";return e;}
    let f2:i64=s_find(card,"```",f1+3);
    if(f2<0){let e2:[]u8="";return e2;}
    return card[f1+3..f2];
}

fn t4_argvsum(cx:*Cx, card:[]u8)void {
    let code:[]u8=card_code(card);
    e_raw(cx,code);
    e_raw(cx,"\n");
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"    let s:i64=0;\n");
    e_raw(cx,"    let k:i64=1;\n");
    e_raw(cx,"    while(k<=4){\n");
    e_raw(cx,"        let a:[]u8=_zag_arg(k);\n");
    e_raw(cx,"        if(a.len>0){s=s+parse_int(a,a.len);}\n");
    e_raw(cx,"        k=k+1;\n");
    e_raw(cx,"    }\n");
    e_raw(cx,"    _zag_print(_zag_i64_to_str(s));\n");
    e_raw(cx,"    _zag_print(\"\\n\");\n");
    e_raw(cx,"}\n");
    return;
}

// ============ section 6: repair ============

// collect "fn NAME(" definition name spans; arena[f]=start, arena[maxf+f]=len
fn find_fn_defs(src:[]u8, arena:[]i64, maxf:i64)i64 {
    let fc:i64=0;
    let i:i64=0;
    while(i+3<src.len){
        if(src[i]==102){
            if(src[i+1]==110){
                if(src[i+2]==32){
                    let ns:i64=i+3;
                    let ne:i64=ns;
                    while(ne<src.len){
                        let c:u8=src[ne];
                        if(c==40){break;}
                        if(c==32){break;}
                        ne=ne+1;
                    }
                    if(ne<src.len){
                        if(src[ne]==40){
                            if(fc<maxf){arena[fc]=ns;arena[maxf+fc]=ne-ns;fc=fc+1;}
                        }
                    }
                    i=ne;
                } else {i=i+1;}
            } else {i=i+1;}
        } else {i=i+1;}
    }
    return fc;
}

fn fn_defined(src:[]u8, name:[]u8)i64 {
    let arena:[]i64=i64_arena(64);
    let nf:i64=find_fn_defs(src,arena,32);
    let i:i64=0;
    while(i<nf){
        let ns:i64=arena[i];
        let nl:i64=arena[32+i];
        if(nl==name.len){
            if(s_eq(src[ns..ns+nl],name)==1){return 1;}
        }
        i=i+1;
    }
    return 0;
}

fn is_intrinsic(name:[]u8)i64 {
    if(s_eq(name,"_zag_print")==1){return 1;}
    if(s_eq(name,"_zag_i64_to_str")==1){return 1;}
    if(s_eq(name,"_zag_arg")==1){return 1;}
    if(s_eq(name,"_zag_malloc")==1){return 1;}
    if(s_eq(name,"_zag_free")==1){return 1;}
    return 0;
}

// edit-similar: same length diff<=2, or len differs by <=2 with prefix relation
fn similar(a:[]u8, b:[]u8)i64 {
    let al:i64=a.len;
    let bl:i64=b.len;
    let d:i64=al-bl;
    if(d<0){d=0-d;}
    if(d>2){return 0;}
    let m:i64=al;
    if(bl<m){m=bl;}
    let diff:i64=0;
    let i:i64=0;
    while(i<m){
        if(a[i]!=b[i]){diff=diff+1;}
        i=i+1;
    }
    diff=diff+d;
    if(diff<=2){return 1;}
    return 0;
}

// rewrite all occurrences of old_call "(" -> new; returns 1 if changed
fn rewrite_call(cx:*Cx, src:[]u8, oldn:[]u8, newn:[]u8)i64 {
    let changed:i64=0;
    let i:i64=0;
    while(i<src.len){
        let pos:i64=s_find(src,oldn,i);
        if(pos<0){break;}
        // must be followed by '(' and be a call (preceded by non-ident char or start)
        let after:i64=pos+oldn.len;
        if(after<src.len){
            if(src[after]==40){
                e_raw(cx,src[i..pos]);
                e_raw(cx,newn);
                changed=1;
                i=after;
            } else {
                e_raw(cx,src[i..after]);
                i=after;
            }
        } else {
            e_raw(cx,src[i..src.len]);
            i=src.len;
        }
    }
    if(i<src.len){e_raw(cx,src[i..src.len]);}
    return changed;
}

// patch UNKNOWNFN: rename unknown call to nearest defined/intrinsic name
fn patch_unknownfn(cx:*Cx, src:[]u8, uname:[]u8)i64 {
    let arena:[]i64=i64_arena(64);
    let nf:i64=find_fn_defs(src,arena,32);
    let best:[]u8="";
    let bi:i64=0;
    while(bi<nf){
        let ns:i64=arena[bi];
        let nl:i64=arena[32+bi];
        let cand:[]u8=src[ns..ns+nl];
        if(similar(uname,cand)==1){best=cand;}
        bi=bi+1;
    }
    if(best.len==0){
        // try intrinsics
        let in1:[]u8="_zag_print";
        if(similar(uname,in1)==1){best=in1;}
        let in2:[]u8="_zag_i64_to_str";
        if(similar(uname,in2)==1){best=in2;}
        let in3:[]u8="_zag_arg";
        if(similar(uname,in3)==1){best=in3;}
    }
    if(best.len==0){return 0;}
    return rewrite_call(cx,src,uname,best);
}

// patch E0203: three shapes, first applicable wins
// shape A: let V:i32="lit" or let V:i64="lit" -> change decl to []u8
// shape B: return "lit"; inside fn F()->i32/i64 -> change F's return type to []u8
// shape C: call arg "digits" where param numeric -> strip quotes
fn patch_type_a(cx:*Cx, src:[]u8)i64 {
    // find `let `: then name `:` then type then `="`
    let i:i64=0;
    let changed:i64=0;
    let out:Cx=cx_new(src.len+64);
    let ocx:*Cx=&out;
    let pos:i64=0;
    while(pos<src.len){
        let lp:i64=s_find(src,"let ",pos);
        if(lp<0){break;}
        let cp:i64=s_find(src,":",lp);
        let eq:i64=s_find(src,"=",lp);
        if(cp<0){break;}
        if(eq<0){break;}
        if(cp>eq){pos=lp+4;continue;}
        // type span = cp+1 .. eq, trim spaces
        let ts:i64=cp+1;
        while(ts<eq){if(src[ts]!=32){break;}ts=ts+1;}
        let te:i64=eq;
        while(te>ts){if(src[te-1]!=32){break;}te=te-1;}
        let typ:[]u8=src[ts..te];
        let isnum:i64=0;
        if(s_eq(typ,"i32")==1){isnum=1;}
        if(s_eq(typ,"i64")==1){isnum=1;}
        // value starts at eq+1; check for quote
        let vs:i64=eq+1;
        while(vs<src.len){if(src[vs]!=32){break;}vs=vs+1;}
        if(isnum==1){
            if(vs<src.len){
                if(src[vs]==34){
                    // rewrite: copy up to ts, emit []u8, continue after te
                    e_raw(ocx,src[pos..ts]);
                    e_raw(ocx,"[]u8");
                    changed=1;
                    pos=te;
                    continue;
                }
            }
        }
        pos=lp+4;
    }
    if(changed==1){
        e_raw(ocx,src[pos..src.len]);
        // copy out back into cx
        let b:[]u8=cx.*.b;
        let ob:[]u8=ocx.*.b;
        let on:i64=ocx.*.n;
        let k:i64=0;
        while(k<on){b[k]=ob[k];k=k+1;}
        cx.*.n=on;
        return 1;
    }
    return 0;
}

// ============ section 7: gate ============

// returns rule id 1..6 if the spec asks for something banned, else 0
fn gate_hit(spec:[]u8)i64 {
    let g:[]u8=s_lower(spec);
    let has_audit:i64=s_has(g,"audit");
    let has_ledger:i64=s_has(g,"ledger");
    if(has_audit==1){
        if(s_has(g,"without")==1){return 1;}
        if(s_has(g,"skip")==1){return 1;}
        if(s_has(g,"bypass")==1){return 1;}
        if(s_has(g,"delete")==1){return 1;}
        if(s_has(g,"hide")==1){return 1;}
        if(s_has(g,"omit")==1){return 1;}
        if(s_has(g,"weaken")==1){return 1;}
    }
    if(has_ledger==1){
        if(s_has(g,"without")==1){return 1;}
        if(s_has(g,"skip")==1){return 1;}
        if(s_has(g,"weaken")==1){return 1;}
    }
    if(s_has(g,"gate")==1){
        if(s_has(g,"bypass")==1){return 2;}
        if(s_has(g,"disable")==1){return 2;}
        if(s_has(g,"always")==1){return 2;}
        if(s_has(g,"remove")==1){return 2;}
        if(s_has(g,"weaken")==1){return 2;}
    }
    if(s_has(g,"deliberat")==1){
        if(s_has(g,"skip")==1){return 3;}
        if(s_has(g,"remove")==1){return 3;}
        if(s_has(g,"delete")==1){return 3;}
        if(s_has(g,"disable")==1){return 3;}
    }
    if(s_has(g,"random")==1){return 4;}
    if(s_has(g,"conceal")==1){return 5;}
    if(s_has(g,"hide")==1){
        if(s_has(g,"behavior")==1){return 5;}
        if(s_has(g,"behaviour")==1){return 5;}
        if(s_has(g,"log")==1){return 5;}
    }
    if(s_has(g,"pin")==1){
        if(s_has(g,"without")==1){return 6;}
        if(s_has(g,"every")==1){return 6;}
    }
    if(s_has(g,"force-pin")==1){return 6;}
    return 0;
}

// ============ section 8: self-review ============

// brace balance of emitted text; returns 1 if balanced
fn review_braces(src:[]u8)i64 {
    let depth:i64=0;
    let i:i64=0;
    while(i<src.len){
        if(src[i]==123){depth=depth+1;}
        if(src[i]==125){depth=depth-1;}
        if(depth<0){return 0;}
        i=i+1;
    }
    if(depth==0){return 1;}
    return 0;
}

// ============ section 9: modes ============

fn do_teach()void {
    let pid:[]u8=_zag_arg(2);
    let res:[]u8=_zag_arg(3);
    _zag_print("AUDIT op=INSTALL pid=");
    _zag_print(pid);
    _zag_print(" practice=");
    _zag_print(res);
    if(s_eq(res,"PRACTICE_OK")==1){
        _zag_print(" installed=1 deliberation=PRACTICE_GATED\n");
    } else {
        _zag_print(" installed=0 deliberation=PRACTICE_GATED\n");
    }
    return;
}

fn do_gate()void {
    let spec:[]u8=_zag_arg(2);
    let r:i64=gate_hit(spec);
    if(r==0){
        _zag_print("ALLOW\n");
    } else {
        _zag_print("REFUSE:G");
        _zag_print(_zag_i64_to_str(r));
        _zag_print("\n");
    }
    return;
}

// 12 frozen deliberation probes: transitive 2-step inference.
// Probe p: premises (x1 R y1), (x2 R y2), query (qx R qy).
// Genuine inference: YES iff y1==x2 (middle term unifies) AND qx==x1 AND qy==y2.
// Entities: 1 alice,2 bob,3 carol,4 dave,5 wheel,6 car,7 fleet,8 engine,
// 9 dawn,10 noon,11 dusk,12 midnight,13 fire,14 smoke,15 alarm,
// 16 box,17 ball,18 marble,19 crate,20 ann,21 cat.
fn delib_row(p:i64, r:[]i64)void {
    if(p==0){r[0]=1;r[1]=2;r[2]=2;r[3]=3;r[4]=1;r[5]=3;}
    if(p==1){r[0]=1;r[1]=2;r[2]=4;r[3]=3;r[4]=1;r[5]=3;}
    if(p==2){r[0]=5;r[1]=6;r[2]=6;r[3]=7;r[4]=5;r[5]=7;}
    if(p==3){r[0]=5;r[1]=6;r[2]=6;r[3]=7;r[4]=6;r[5]=5;}
    if(p==4){r[0]=9;r[1]=10;r[2]=10;r[3]=11;r[4]=9;r[5]=11;}
    if(p==5){r[0]=9;r[1]=10;r[2]=11;r[3]=12;r[4]=9;r[5]=11;}
    if(p==6){r[0]=13;r[1]=14;r[2]=14;r[3]=15;r[4]=13;r[5]=15;}
    if(p==7){r[0]=13;r[1]=14;r[2]=14;r[3]=15;r[4]=15;r[5]=13;}
    if(p==8){r[0]=16;r[1]=17;r[2]=17;r[3]=18;r[4]=16;r[5]=18;}
    if(p==9){r[0]=16;r[1]=17;r[2]=19;r[3]=18;r[4]=16;r[5]=18;}
    if(p==10){r[0]=20;r[1]=2;r[2]=2;r[3]=21;r[4]=20;r[5]=21;}
    if(p==11){r[0]=20;r[1]=2;r[2]=2;r[3]=21;r[4]=2;r[5]=20;}
    return;
}

fn do_delib()void {
    let id:[]u8=_zag_arg(2);
    let p:i64=0;
    let i:i64=1;
    while(i<id.len){
        let d:u8=id[i];
        if(d>=48){ if(d<=57){ p=p*10+((d as i64)-48); } }
        i=i+1;
    }
    let r:[]i64=i64_arena(6);
    delib_row(p,r);
    let ok:i64=0;
    if(r[1]==r[2]){
        if(r[4]==r[0]){
            if(r[5]==r[3]){ok=1;}
        }
    }
    _zag_print("DELIB ");
    _zag_print(id);
    if(ok==1){
        _zag_print(" YES middle=");
        _zag_print(_zag_i64_to_str(r[1]));
        _zag_print(" chain=unified\n");
    } else {
        _zag_print(" NO chain=broken\n");
    }
    return;
}

// ============ section 10: repair patches ============

// match brace: src[open]=='{'; return index just past matching '}'
fn match_brace(src:[]u8, open:i64)i64 {
    let d:i64=0;
    let i:i64=open;
    while(i<src.len){
        if(src[i]==123){d=d+1;}
        if(src[i]==125){d=d-1;if(d==0){return i+1;}}
        i=i+1;
    }
    return -1;
}

// number words -> value; -1 if not a number word
fn word_to_num(w:[]u8)i64 {
    if(s_eq(w,"zero")==1){return 0;}
    if(s_eq(w,"one")==1){return 1;}
    if(s_eq(w,"two")==1){return 2;}
    if(s_eq(w,"three")==1){return 3;}
    if(s_eq(w,"four")==1){return 4;}
    if(s_eq(w,"five")==1){return 5;}
    if(s_eq(w,"six")==1){return 6;}
    if(s_eq(w,"seven")==1){return 7;}
    if(s_eq(w,"eight")==1){return 8;}
    if(s_eq(w,"nine")==1){return 9;}
    if(s_eq(w,"ten")==1){return 10;}
    if(s_eq(w,"eleven")==1){return 11;}
    if(s_eq(w,"twelve")==1){return 12;}
    if(s_eq(w,"thirteen")==1){return 13;}
    if(s_eq(w,"fourteen")==1){return 14;}
    if(s_eq(w,"fifteen")==1){return 15;}
    if(s_eq(w,"sixteen")==1){return 16;}
    if(s_eq(w,"seventeen")==1){return 17;}
    if(s_eq(w,"eighteen")==1){return 18;}
    if(s_eq(w,"nineteen")==1){return 19;}
    if(s_eq(w,"twenty")==1){return 20;}
    return -1;
}

// is s a quoted integer literal like "3" or "-7" (including quotes)?
fn is_quoted_int(s:[]u8)i64 {
    if(s.len<3){return 0;}
    if(s[0]!=34){return 0;}
    if(s[s.len-1]!=34){return 0;}
    let i:i64=1;
    if(s[1]==45){i=2;}
    if(i>=s.len-1){return 0;}
    while(i<s.len-1){
        if(s[i]<48){return 0;}
        if(s[i]>57){return 0;}
        i=i+1;
    }
    return 1;
}

// E0203 shape B: return "word"; -> return N; (word names a number)
fn patch_ret_word(cx:*Cx, src:[]u8)i64 {
    let pos:i64=s_find(src,"return \"",0);
    if(pos<0){return 0;}
    let qs:i64=pos+8;
    let qe:i64=s_find(src,"\"",qs);
    if(qe<0){return 0;}
    // must be followed by ;
    if(qe+1>=src.len){return 0;}
    if(src[qe+1]!=59){return 0;}
    let w:[]u8=src[qs..qe];
    let n:i64=word_to_num(w);
    if(n<0){return 0;}
    e_raw(cx,src[0..pos]);
    e_raw(cx,"return ");
    e_i64(cx,n);
    e_raw(cx,";");
    e_raw(cx,src[qe+2..src.len]);
    return 1;
}

// E0203 shape C: "digits" inside a call -> digits (strip quotes)
fn patch_arg_unquote(cx:*Cx, src:[]u8)i64 {
    // find first quoted-int occurrence that sits inside parens
    let i:i64=0;
    let found:i64=-1;
    let qe:i64=0;
    while(i<src.len){
        let q:i64=s_find(src,"\"",i);
        if(q<0){break;}
        let e:i64=s_find(src,"\"",q+1);
        if(e<0){break;}
        let lit:[]u8=src[q..e+1];
        if(is_quoted_int(lit)==1){
            found=q;
            qe=e;
            break;
        }
        i=e+1;
    }
    if(found<0){return 0;}
    e_raw(cx,src[0..found]);
    e_raw(cx,src[found+1..qe]);
    e_raw(cx,src[qe+1..src.len]);
    return 1;
}

// E0203 shape A: delete a line assigning a string to a numeric-declared var
// line looks like: <ws>V="...";  (not a let) and `let V:i32`/`let V:i64` exists
fn patch_del_badassign(cx:*Cx, src:[]u8)i64 {
    // split into lines via arena of (start,len)
    let la:[]i64=i64_arena(256);
    let nl:i64=0;
    let st:i64=0;
    let i:i64=0;
    while(i<=src.len){
        if(i==src.len){
            if(nl<128){la[nl]=st;la[128+nl]=i-st;nl=nl+1;}
            break;
        }
        if(src[i]==10){
            if(nl<128){la[nl]=st;la[128+nl]=i-st;nl=nl+1;}
            st=i+1;
        }
        i=i+1;
    }
    let drop:i64=-1;
    let li:i64=0;
    while(li<nl){
        let ls:i64=la[li];
        let ll:i64=la[128+li];
        let line:[]u8=src[ls..ls+ll];
        // trim leading spaces
        let t:i64=0;
        while(t<ll){if(line[t]!=32){break;}t=t+1;}
        let tl:[]u8=line[t..ll];
        // skip let-lines
        if(s_find(tl,"let ",0)!=0){
            // look for V=" pattern: ident chars then =" then quote
            let eq:i64=s_find(tl,"=\"",0);
            if(eq>0){
                // ident = tl[0..eq], must be all ident chars
                let ok:i64=1;
                let k:i64=0;
                while(k<eq){
                    let c:u8=tl[k];
                    let idc:i64=0;
                    if(c>=97){if(c<=122){idc=1;}}
                    if(c>=65){if(c<=90){idc=1;}}
                    if(c>=48){if(c<=57){idc=1;}}
                    if(c==95){idc=1;}
                    if(idc==0){ok=0;}
                    k=k+1;
                }
                if(ok==1){
                    let v:[]u8=tl[0..eq];
                    // check declared numeric: search "let V:i32" or "let V:i64"
                    let d1:[]u8="let ";
                    let probe:[]u8=src;
                    let dp:i64=0;
                    let isnum:i64=0;
                    while(dp<src.len){
                        let f:i64=s_find(src,"let ",dp);
                        if(f<0){break;}
                        // check name follows
                        let ns:i64=f+4;
                        if(ns+v.len<src.len){
                            if(s_eq(src[ns..ns+v.len],v)==1){
                                let after:i64=ns+v.len;
                                if(src[after]==58){
                                    if(s_find(src[after..after+4],":i32",0)==0){isnum=1;}
                                    if(s_find(src[after..after+4],":i64",0)==0){isnum=1;}
                                }
                            }
                        }
                        dp=f+4;
                    }
                    if(isnum==1){drop=li;}
                }
            }
        }
        li=li+1;
    }
    if(drop<0){return 0;}
    // re-emit without the dropped line
    li=0;
    while(li<nl){
        if(li!=drop){
            let ls2:i64=la[li];
            let ll2:i64=la[128+li];
            e_raw(cx,src[ls2..ls2+ll2]);
            e_raw(cx,"\n");
        }
        li=li+1;
    }
    return 1;
}

// count top-level args in "a, b, c"
fn count_args(argstr:[]u8)i64 {
    if(argstr.len==0){return 0;}
    let n:i64=1;
    let d:i64=0;
    let i:i64=0;
    while(i<argstr.len){
        if(argstr[i]==40){d=d+1;}
        if(argstr[i]==41){d=d-1;}
        if(argstr[i]==44){if(d==0){n=n+1;}}
        i=i+1;
    }
    return n;
}

// ARITY: fix calls to fn F with wrong arg count.
// too many -> drop extras; too few -> fill by incrementing from last arg.
fn patch_arity(cx:*Cx, src:[]u8, fname:[]u8)i64 {
    // find definition `fn F(` and count params
    let dpos:i64=s_find(src,"fn ",0);
    let nparams:i64=-1;
    while(dpos>=0){
        let ns:i64=dpos+3;
        if(ns+fname.len<src.len){
            if(s_eq(src[ns..ns+fname.len],fname)==1){
                if(src[ns+fname.len]==40){
                    let pe:i64=match_brace(src,ns+fname.len);
                    // params are between ( and ): find closing paren
                    let cp:i64=s_find(src,")",ns+fname.len);
                    if(cp>0){
                        nparams=count_args(src[ns+fname.len+1..cp]);
                    }
                    break;
                }
            }
        }
        dpos=s_find(src,"fn ",dpos+1);
    }
    if(nparams<0){return 0;}
    // rewrite each wrong-count call
    let out:Cx=cx_new(src.len+256);
    let ocx:*Cx=&out;
    let changed:i64=0;
    let i:i64=0;
    while(i<src.len){
        let cp2:i64=s_find(src,fname,i);
        if(cp2<0){break;}
        // must be a call: followed by '(' and not a definition (not preceded by "fn ")
        let isdef:i64=0;
        if(cp2>=3){
            if(s_eq(src[cp2-3..cp2],"fn ")==1){isdef=1;}
        }
        let after:i64=cp2+fname.len;
        if(after<src.len){
            if(src[after]==40){
                if(isdef==0){
                    // find matching close paren
                    let depth:i64=0;
                    let j:i64=after;
                    let close:i64=-1;
                    while(j<src.len){
                        if(src[j]==40){depth=depth+1;}
                        if(src[j]==41){depth=depth-1;if(depth==0){close=j;break;}}
                        j=j+1;
                    }
                    if(close>0){
                        let argstr:[]u8=src[after+1..close];
                        let nc2:i64=count_args(argstr);
                        if(nc2!=nparams){
                            e_raw(ocx,src[i..after+1]);
                            if(nc2>nparams){
                                // drop extras: keep first nparams args
                                let kept:i64=0;
                                let k:i64=0;
                                let dd:i64=0;
                                let astart:i64=0;
                                while(k<=argstr.len){
                                    let atend:i64=0;
                                    if(k==argstr.len){atend=1;}
                                    else {
                                        if(argstr[k]==40){dd=dd+1;}
                                        if(argstr[k]==41){dd=dd-1;}
                                        if(argstr[k]==44){if(dd==0){atend=1;}}
                                    }
                                    if(atend==1){
                                        if(kept<nparams){
                                            if(kept>0){e_raw(ocx,", ");}
                                            e_raw(ocx,argstr[astart..k]);
                                        }
                                        kept=kept+1;
                                        astart=k+1;
                                    }
                                    k=k+1;
                                }
                            } else {
                                // fill by incrementing from last arg
                                e_raw(ocx,argstr);
                                // last arg numeric value
                                let la2:i64=0;
                                // find last top-level comma
                                let dd2:i64=0;
                                let k2:i64=argstr.len;
                                let lstart:i64=0;
                                while(k2>0){
                                    k2=k2-1;
                                    if(argstr[k2]==41){dd2=dd2+1;}
                                    if(argstr[k2]==40){dd2=dd2-1;}
                                    if(argstr[k2]==44){if(dd2==0){lstart=k2+1;break;}}
                                }
                                let lastarg:[]u8=argstr[lstart..argstr.len];
                                // trim spaces
                                while(lastarg.len>0){if(lastarg[0]!=32){break;}lastarg=lastarg[1..lastarg.len];}
                                while(lastarg.len>0){if(lastarg[lastarg.len-1]!=32){break;}lastarg=lastarg[0..lastarg.len-1];}
                                let lv:i64=0;
                                let kk:i64=0;
                                while(kk<lastarg.len){
                                    if(lastarg[kk]>=48){if(lastarg[kk]<=57){lv=lv*10+((lastarg[kk] as i64)-48);}}
                                    kk=kk+1;
                                }
                                let need:i64=nparams-nc2;
                                let f2:i64=0;
                                while(f2<need){
                                    e_raw(ocx,", ");
                                    e_i64(ocx,lv+1+f2);
                                    f2=f2+1;
                                }
                            }
                            e_raw(ocx,")");
                            changed=1;
                            i=close+1;
                            continue;
                        }
                    }
                }
            }
        }
        // copy through to after this occurrence
        e_raw(ocx,src[i..after]);
        i=after;
        if(i>=src.len){break;}
    }
    if(changed==0){return 0;}
    e_raw(ocx,src[i..src.len]);
    // copy out into cx
    let ob:[]u8=ocx.*.b;
    let on2:i64=ocx.*.n;
    let bb:[]u8=cx.*.b;
    let kk2:i64=0;
    while(kk2<on2){bb[kk2]=ob[kk2];kk2=kk2+1;}
    cx.*.n=on2;
    return 1;
}

// PARSE: close open blocks; if a new `fn` starts while depth>0, close before it
fn patch_brace(cx:*Cx, src:[]u8)i64 {
    let la:[]i64=i64_arena(256);
    let nl:i64=0;
    let st:i64=0;
    let i:i64=0;
    while(i<=src.len){
        if(i==src.len){
            if(nl<128){la[nl]=st;la[128+nl]=i-st;nl=nl+1;}
            break;
        }
        if(src[i]==10){
            if(nl<128){la[nl]=st;la[128+nl]=i-st;nl=nl+1;}
            st=i+1;
        }
        i=i+1;
    }
    // emit into a scratch buffer; commit to cx only when a change was made.
    // (do_repair echoes the original source when we return 0; emitting
    // unconditionally into cx would double the program.)
    let oc:Cx=cx_new(src.len+512);
    let ocx:*Cx=&oc;
    let depth:i64=0;
    let li:i64=0;
    let changed:i64=0;
    while(li<nl){
        let ls:i64=la[li];
        let ll:i64=la[128+li];
        let line:[]u8=src[ls..ls+ll];
        let t:i64=0;
        while(t<ll){if(line[t]!=32){break;}t=t+1;}
        // fn at depth>0 -> close first
        if(ll-t>=3){
            if(s_eq(line[t..t+3],"fn ")==1){
                if(depth>0){
                    let c:i64=0;
                    while(c<depth){e_raw(ocx,"}\n");c=c+1;}
                    depth=0;
                    changed=1;
                }
            }
        }
        e_raw(ocx,line);
        e_raw(ocx,"\n");
        let k:i64=0;
        while(k<ll){
            if(line[k]==123){depth=depth+1;}
            if(line[k]==125){depth=depth-1;}
            k=k+1;
        }
        li=li+1;
    }
    while(depth>0){e_raw(ocx,"}\n");depth=depth-1;changed=1;}
    if(changed==0){return 0;}
    // copy out into cx
    let ob:[]u8=ocx.*.b;
    let on2:i64=ocx.*.n;
    let bb:[]u8=cx.*.b;
    let kk2:i64=0;
    while(kk2<on2){bb[kk2]=ob[kk2];kk2=kk2+1;}
    cx.*.n=on2;
    return 1;
}

// DUPFN: delete the second definition of fn `fname`
fn patch_dupfn(cx:*Cx, src:[]u8, fname:[]u8)i64 {
    let first:i64=-1;
    let second:i64=-1;
    let dpos:i64=s_find(src,"fn ",0);
    while(dpos>=0){
        let ns:i64=dpos+3;
        if(ns+fname.len<src.len){
            if(s_eq(src[ns..ns+fname.len],fname)==1){
                if(src[ns+fname.len]==40){
                    if(first<0){first=dpos;}
                    else {second=dpos;break;}
                }
            }
        }
        dpos=s_find(src,"fn ",dpos+1);
    }
    if(second<0){return 0;}
    // find the opening brace of the second def, match it
    let ob:i64=s_find(src,"{",second);
    if(ob<0){return 0;}
    let end2:i64=match_brace(src,ob);
    if(end2<0){return 0;}
    e_raw(cx,src[0..second]);
    e_raw(cx,src[end2..src.len]);
    return 1;
}

// ============ section 11: gen dispatch ============

// extract the class field: spec = "T1|FUNC|..." -> "FUNC"
fn spec_class(spec:[]u8)[]u8 {
    let p1:i64=s_find(spec,"|",0);
    if(p1<0){let e:[]u8="";return e;}
    let p2:i64=s_find(spec,"|",p1+1);
    if(p2<0){let e2:[]u8="";return e2;}
    return spec[p1+1..p2];
}

// goal text: after "T4|GOAL|"
fn spec_goal(spec:[]u8)[]u8 {
    let p1:i64=s_find(spec,"|",0);
    if(p1<0){let e:[]u8="";return e;}
    let p2:i64=s_find(spec,"|",p1+1);
    if(p2<0){let e2:[]u8="";return e2;}
    return spec[p2+1..spec.len];
}

// word between marker and endmark (for multi-word extraction)
fn word_between(text:[]u8, start_mark:[]u8, end_mark:[]u8)[]u8 {
    let s:i64=s_find(text,start_mark,0);
    if(s<0){let e:[]u8="";return e;}
    let bs:i64=s+start_mark.len;
    let e2:i64=s_find(text,end_mark,bs);
    if(e2<0){return text[bs..text.len];}
    return text[bs..e2];
}

fn gen_t4(cx:*Cx, spec:[]u8, demo:[]u8, installed:[]u8, card:[]u8)void {
    let goal:[]u8=spec_goal(spec);
    let g:[]u8=s_lower(goal);
    let c:i64=goal_concept(g);
    if(c==0){
        e_raw(cx,"UNKNOWN_GOAL\n");
        return;
    }
    // needs check
    let ok:i64=1;
    let miss:[]u8="";
    if(c==1){if(installed_has(installed,"p_math")==0){ok=0;miss="p_math";}}
    if(c==2){
        if(installed_has(installed,"p_search")==0){ok=0;miss="p_search";}
        if(installed_has(installed,"p_slice")==0){ok=0;miss="p_slice";}
    }
    if(c==3){if(installed_has(installed,"p_strrev")==0){ok=0;miss="p_strrev";}}
    if(c==4){if(installed_has(installed,"p_func")==0){ok=0;miss="p_func";}}
    if(c==5){if(installed_has(installed,"p_slice")==0){ok=0;miss="p_slice";}}
    if(c==6){
        if(installed_has(installed,"p_math")==0){ok=0;miss="p_math";}
        if(installed_has(installed,"p_loop")==0){ok=0;miss="p_loop";}
    }
    if(c==7){if(installed_has(installed,"p_strrev")==0){ok=0;miss="p_strrev";}}
    if(c==8){if(installed_has(installed,"p_func")==0){ok=0;miss="p_func";}}
    if(c==9){if(installed_has(installed,"p_struct")==0){ok=0;miss="p_struct";}}
    if(c==10){
        if(installed_has(installed,"p_math")==0){ok=0;miss="p_math";}
        if(installed_has(installed,"p_loop")==0){ok=0;miss="p_loop";}
    }
    if(c==11){
        if(installed_has(installed,"p_sort")==0){ok=0;miss="p_sort";}
        if(installed_has(installed,"p_search")==0){ok=0;miss="p_search";}
    }
    if(c==12){if(installed_has(installed,"p_argv")==0){ok=0;miss="p_argv";}}
    if(ok==0){
        if(c==12){
            if(card.len>0){
                t4_argvsum(cx,card);
                return;
            }
            e_raw(cx,"NEED_CARD:parse-int\n");
            return;
        }
        e_raw(cx,"UNTAUGHT:");
        e_raw(cx,miss);
        e_raw(cx,"\n");
        return;
    }
    let nums:[]i64=i64_arena(32);
    let nn:i64=s_numbers(g,nums);
    if(c==1){t4_lcm(cx,nums[0],nums[1]);return;}
    if(c==2){t4_count_occ(cx,nums[0],nums,1,nn-1);return;}
    if(c==3){
        let w:[]u8=word_after(g,"word ");
        t4_palindrome(cx,w);
        return;
    }
    if(c==4){t4_power(cx,nums[0],nums[1]);return;}
    if(c==5){t4_maxarr(cx,nums,0,nn);return;}
    if(c==6){t4_sumprimes(cx,nums[0]);return;}
    if(c==7){
        let w2:[]u8=word_between(g,"string "," to uppercase");
        t4_upper(cx,w2);
        return;
    }
    if(c==8){t4_clamp(cx,nums[0],nums[1],nums[2]);return;}
    if(c==9){t4_rectarea(cx,nums[0],nums[1]);return;}
    if(c==10){t4_fibsum(cx,nums[0]);return;}
    if(c==11){t4_selsort(cx,nums,0,nn);return;}
    if(c==12){t4_argvsum(cx,card);return;}
    return;
}

fn gen_t1(cx:*Cx, spec:[]u8, demo:[]u8, installed:[]u8)void {
    let class:[]u8=spec_class(spec);
    let need:[]u8="";
    if(s_eq(class,"FUNC")==1){need="p_func";}
    if(s_eq(class,"SLICE")==1){need="p_slice";}
    if(s_eq(class,"LOOP")==1){need="p_loop";}
    if(s_eq(class,"STR")==1){need="p_strcnt";}
    if(s_eq(class,"STRUCT")==1){need="p_struct";}
    if(s_eq(class,"ARGV")==1){need="p_argv";}
    if(need.len==0){
        e_raw(cx,"UNKNOWN_CLASS\n");
        return;
    }
    if(installed_has(installed,need)==0){
        e_raw(cx,"UNTAUGHT:");
        e_raw(cx,need);
        e_raw(cx,"\n");
        return;
    }
    if(s_eq(class,"FUNC")==1){emit_t1_func(cx,spec,demo);return;}
    if(s_eq(class,"SLICE")==1){emit_t1_slice(cx,spec,demo);return;}
    if(s_eq(class,"LOOP")==1){emit_t1_loop(cx,spec);return;}
    if(s_eq(class,"STR")==1){emit_t1_str(cx,spec,demo);return;}
    if(s_eq(class,"STRUCT")==1){emit_t1_struct(cx,spec,demo);return;}
    if(s_eq(class,"ARGV")==1){emit_t1_argv(cx);return;}
    return;
}

fn gen_t2(cx:*Cx, spec:[]u8, demo:[]u8, installed:[]u8)void {
    let class:[]u8=spec_class(spec);
    let need:[]u8="";
    if(s_eq(class,"SORT")==1){need="p_sort";}
    if(s_eq(class,"SEARCH")==1){need="p_search";}
    if(s_eq(class,"STR")==1){need="p_strrev";}
    if(s_eq(class,"MATH")==1){need="p_math";}
    if(s_eq(class,"SLICE")==1){need="p_slicefill";}
    if(need.len==0){
        e_raw(cx,"UNKNOWN_CLASS\n");
        return;
    }
    if(installed_has(installed,need)==0){
        e_raw(cx,"UNTAUGHT:");
        e_raw(cx,need);
        e_raw(cx,"\n");
        return;
    }
    if(s_eq(class,"SORT")==1){emit_t2_sort(cx,spec,demo);return;}
    if(s_eq(class,"SEARCH")==1){emit_t2_search(cx,spec,demo);return;}
    if(s_eq(class,"STR")==1){emit_t2_strrev(cx,spec,demo);return;}
    if(s_eq(class,"MATH")==1){emit_t2_math(cx,spec,demo);return;}
    if(s_eq(class,"SLICE")==1){emit_t2_squares(cx,spec,demo);return;}
    return;
}

fn do_gen()void {
    let spec:[]u8=_zag_arg(2);
    let installed:[]u8=_zag_arg(3);
    let demo:[]u8=_zag_arg(4);
    let card:[]u8=_zag_arg(5);
    // gate first: refuse banned requests before any generation
    let gr:i64=gate_hit(spec);
    if(gr!=0){
        _zag_print("REFUSED:G");
        _zag_print(_zag_i64_to_str(gr));
        _zag_print("\n");
        return;
    }
    let c:Cx=cx_new(65536);
    let cx:*Cx=&c;
    let tier:[]u8=spec[0..2];
    if(s_eq(tier,"T1")==1){gen_t1(cx,spec,demo,installed);}
    else if(s_eq(tier,"T2")==1){gen_t2(cx,spec,demo,installed);}
    else if(s_eq(tier,"T4")==1){gen_t4(cx,spec,demo,installed,card);}
    else {e_raw(cx,"UNKNOWN_TIER\n");}
    // self-review: brace balance; auto-close if short
    let out:[]u8=cx.*.b[0..cx.*.n];
    let depth:i64=0;
    let i:i64=0;
    while(i<out.len){
        if(out[i]==123){depth=depth+1;}
        if(out[i]==125){depth=depth-1;}
        i=i+1;
    }
    while(depth>0){e_raw(cx,"}\n");depth=depth-1;}
    let out2:[]u8=cx.*.b[0..cx.*.n];
    _zag_print(out2);
    return;
}

// ============ section 12: repair dispatch + main ============

fn do_repair()void {
    let eclass:[]u8=_zag_arg(2);
    let details:[]u8=_zag_arg(3);
    let src:[]u8=_zag_arg(4);
    let c:Cx=cx_new(src.len+512);
    let cx:*Cx=&c;
    let done:i64=0;
    if(s_eq(eclass,"E0203")==1){
        if(patch_ret_word(cx,src)==1){done=1;}
        else if(patch_arg_unquote(cx,src)==1){done=1;}
        else if(patch_del_badassign(cx,src)==1){done=1;}
    }
    if(s_eq(eclass,"UNKNOWNFN")==1){
        if(patch_unknownfn(cx,src,details)==1){done=1;}
    }
    if(s_eq(eclass,"ARITY")==1){
        let cpos:i64=s_find(details,":",0);
        let aname:[]u8=details;
        if(cpos>0){aname=details[0..cpos];}
        if(patch_arity(cx,src,aname)==1){done=1;}
    }
    if(s_eq(eclass,"PARSE")==1){
        if(patch_brace(cx,src)==1){done=1;}
    }
    if(s_eq(eclass,"DUPFN")==1){
        if(patch_dupfn(cx,src,details)==1){done=1;}
    }
    if(done==0){
        e_raw(cx,src);
    }
    let out:[]u8=cx.*.b[0..cx.*.n];
    _zag_print(out);
    return;
}

fn main()void {
    let mode:[]u8=_zag_arg(1);
    if(s_eq(mode,"teach")==1){do_teach();return;}
    if(s_eq(mode,"gen")==1){do_gen();return;}
    if(s_eq(mode,"repair")==1){do_repair();return;}
    if(s_eq(mode,"gate")==1){do_gate();return;}
    if(s_eq(mode,"delib")==1){do_delib();return;}
    if(s_eq(mode,"diagnose")==1){
        let si_mech:[]u8=_zag_arg(10);
        if(si_mech.len>0){do_diagnose2();return;}
        do_diagnose();return;
    }
    _zag_print("UNKNOWN_MODE\n");
    return;
}
// ============ section 13: diagnose (fast-loop harness) ============
//
// diagnose <spec> <src> <evtype> <evidence> [installed] [demo] [card]
//
// The learner — not the driver — classifies the failure and chooses the
// repair strategy. Classification is deliberative: every candidate class
// is scored against ALL the evidence plus cross-checks against the source
// (brace balance, is the named fn defined, duplicate counts, similar-name
// search). Winner by argmax; ties break by a documented priority order.
// The trace logs every contribution. This replaces the prior driver's
// first-match regex cascade (driver.py eclass_of/details_of), which is
// now gone: the driver passes evidence verbatim and classifies nothing.
//
// Evidence envelope (built by the driver; compiler/test bytes verbatim):
//   COMPILE: "RC <n>\n" + raw compiler stderr
//   TEST:    "COMPILE_OK\nGOT_RC <n>\nEXP_RC <m>\nGOT_ERR <esc>\nGOT_OUT <esc>\nEXP_OUT <esc>\n"
//            (<esc>: backslash escapes; \\ -> backslash, \n -> newline)
//   GEN:     "GENFAIL <marker>\n"
//   trailer: "PREV <class>/<strategy>\nSTALLED <0|1>\nCYCLE <0|1>\n"
//
// Output:
//   DIAG class=<CLASS> strategy=<STRAT> score=<n> trace=<contributions>
//   @@SRC@@
//   <revised source, verbatim>
//   @@END@@
//
// Failure classes: SYNTAX NAME ARITY TYPE DUPFN GEN_FAILURE RUNTIME
//   OUTPUT_FORMAT LOGIC_VALUE LOGIC_OTHER UNKNOWN

// unescape driver envelope escapes: \n -> LF, \r -> CR, \\ -> backslash
fn ev_unescape(s:[]u8)[]u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let o:[]u8=p[0..s.len];
    let i:i64=0;
    let n:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==92){
            if(i+1<s.len){
                let d:u8=s[i+1];
                if(d==110){o[n]=10;n=n+1;i=i+2;continue;}
                if(d==114){o[n]=13;n=n+1;i=i+2;continue;}
                if(d==92){o[n]=92;n=n+1;i=i+2;continue;}
            }
        }
        o[n]=c;
        n=n+1;
        i=i+1;
    }
    return o[0..n];
}

// value of a "KEY " line in the envelope, or ""
fn env_get(env:[]u8, key:[]u8)[]u8 {
    let e:[]u8="";
    if(env.len>key.len+1){
        if(s_eq(env[0..key.len],key)==1){
            if(env[key.len]==32){
                let vs:i64=key.len+1;
                let ve:i64=vs;
                while(ve<env.len){if(env[ve]==10){break;}ve=ve+1;}
                return env[vs..ve];
            }
        }
    }
    let pl:i64=key.len+2;
    let mp:*u8=_zag_malloc(pl+1) as *u8;
    let pat:[]u8=mp[0..pl];
    pat[0]=10;
    let k:i64=0;
    while(k<key.len){pat[1+k]=key[k];k=k+1;}
    pat[1+key.len]=32;
    let pos:i64=s_find(env,pat,0);
    if(pos<0){return e;}
    let vs2:i64=pos+pl;
    let ve2:i64=vs2;
    while(ve2<env.len){if(env[ve2]==10){break;}ve2=ve2+1;}
    return env[vs2..ve2];
}

// first `name` token in s, or "" (znc: unknown function `ad2`)
fn first_backtick(s:[]u8)[]u8 {
    let e:[]u8="";
    let a:i64=s_find(s,"`",0);
    if(a<0){return e;}
    let b:i64=s_find(s,"`",a+1);
    if(b<0){return e;}
    if(b<a+2){return e;}
    return s[a+1..b];
}

// first 'name' token in s, or "" (znc: call to 'add' passes ...)
fn first_squote(s:[]u8)[]u8 {
    let e:[]u8="";
    let a:i64=s_find(s,"'",0);
    if(a<0){return e;}
    let b:i64=s_find(s,"'",a+1);
    if(b<0){return e;}
    if(b<a+2){return e;}
    return s[a+1..b];
}

// identifier named by the evidence: backtick form first, then squote form
fn ev_name(ev:[]u8)[]u8 {
    let q:[]u8=first_backtick(ev);
    if(q.len>0){return q;}
    return first_squote(ev);
}

// count of `fn name(` definitions in src
fn count_def(src:[]u8, name:[]u8)i64 {
    let cnt:i64=0;
    let pos:i64=0;
    while(pos<src.len){
        let d:i64=s_find(src,"fn ",pos);
        if(d<0){break;}
        let ns:i64=d+3;
        if(ns+name.len<src.len){
            if(s_eq(src[ns..ns+name.len],name)==1){
                if(src[ns+name.len]==40){cnt=cnt+1;}
            }
        }
        pos=d+1;
    }
    return cnt;
}

// 1 if any defined fn is edit-similar to name
fn similar_defined(src:[]u8, name:[]u8)i64 {
    let arena:[]i64=i64_arena(64);
    let nf:i64=find_fn_defs(src,arena,32);
    let i:i64=0;
    while(i<nf){
        let ns:i64=arena[i];
        let nl:i64=arena[32+i];
        if(similar(name,src[ns..ns+nl])==1){return 1;}
        i=i+1;
    }
    return 0;
}

// strip trailing space/tab/CR/LF
fn rstrip(s:[]u8)[]u8 {
    let e:i64=s.len;
    while(e>0){
        let c:u8=s[e-1];
        if(c==32){e=e-1;continue;}
        if(c==9){e=e-1;continue;}
        if(c==10){e=e-1;continue;}
        if(c==13){e=e-1;continue;}
        break;
    }
    return s[0..e];
}

// 1 if s is an optional-leading-minus decimal integer, non-empty
fn all_int(s:[]u8)i64 {
    if(s.len==0){return 0;}
    let i:i64=0;
    if(s[0]==45){i=1;if(s.len==1){return 0;}}
    while(i<s.len){
        let c:u8=s[i];
        if(c<48){return 0;}
        if(c>57){return 0;}
        i=i+1;
    }
    return 1;
}

fn parse_i64(s:[]u8)i64 {
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){if(s[0]==45){neg=1;i=1;}}
    let v:i64=0;
    while(i<s.len){
        v=v*10+((s[i] as i64)-48);
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

// one trace contribution: CLS+pts:why;
fn t_ev(cx:*Cx, cls:[]u8, pts:i64, why:[]u8)void {
    e_raw(cx,cls);
    e_raw(cx,"+");
    e_i64(cx,pts);
    e_raw(cx,":");
    e_raw(cx,why);
    e_raw(cx,";");
    return;
}

struct DRes { class:i64, score:i64, strat:[]u8 }

fn class_name(c:i64)[]u8 {
    if(c==1){let s:[]u8="SYNTAX";return s;}
    if(c==2){let s2:[]u8="NAME";return s2;}
    if(c==3){let s3:[]u8="ARITY";return s3;}
    if(c==4){let s4:[]u8="TYPE";return s4;}
    if(c==5){let s5:[]u8="DUPFN";return s5;}
    if(c==6){let s6:[]u8="GEN_FAILURE";return s6;}
    if(c==7){let s7:[]u8="RUNTIME";return s7;}
    if(c==8){let s8:[]u8="OUTPUT_FORMAT";return s8;}
    if(c==9){let s9:[]u8="LOGIC_VALUE";return s9;}
    if(c==10){let s10:[]u8="LOGIC_OTHER";return s10;}
    let u:[]u8="UNKNOWN";
    return u;
}

// OUTPUT_FORMAT: expected ends with newline, got does not -> add one
// before the final closing brace of the source.
fn patch_add_newline(outc:*Cx, src:[]u8)i64 {
    let lb:i64=-1;
    let i:i64=src.len-1;
    while(i>=0){
        if(src[i]==125){lb=i;break;}
        i=i-1;
    }
    if(lb<0){return 0;}
    e_raw(outc,src[0..lb]);
    e_raw(outc,"    _zag_print(\"\\n\");\n");
    e_raw(outc,src[lb..src.len]);
    return 1;
}

// OUTPUT_FORMAT: got ends with newline, expected does not -> remove the
// last `_zag_print("\n");` occurrence.
fn patch_strip_newline(outc:*Cx, src:[]u8)i64 {
    let nlen:i64=17;
    let np:*u8=_zag_malloc(nlen+1) as *u8;
    let needle:[]u8=np[0..nlen];
    needle[0]=95;needle[1]=122;needle[2]=97;needle[3]=103;needle[4]=95;
    needle[5]=112;needle[6]=114;needle[7]=105;needle[8]=110;needle[9]=116;
    needle[10]=40;needle[11]=34;needle[12]=92;needle[13]=110;needle[14]=34;
    needle[15]=41;needle[16]=59;
    let last:i64=-1;
    let pos:i64=0;
    while(pos<src.len){
        let f:i64=s_find(src,needle,pos);
        if(f<0){break;}
        last=f;
        pos=f+1;
    }
    if(last<0){return 0;}
    e_raw(outc,src[0..last]);
    e_raw(outc,src[last+nlen..src.len]);
    return 1;
}

// LOGIC_VALUE strategy: discard the broken logic and regenerate from the
// spec through the normal generation path. Returns 1 with fresh source in
// outc, or 0 when the spec is not generable (caller must halt, not loop).
fn regen_from_spec(outc:*Cx, spec:[]u8, installed:[]u8, demo:[]u8, card:[]u8)i64 {
    outc.*.n=0;
    if(spec.len<2){return 0;}
    let tier:[]u8=spec[0..2];
    if(s_eq(tier,"T1")==1){gen_t1(outc,spec,demo,installed);}
    else if(s_eq(tier,"T2")==1){gen_t2(outc,spec,demo,installed);}
    else if(s_eq(tier,"T4")==1){gen_t4(outc,spec,demo,installed,card);}
    else {return 0;}
    // brace auto-close, mirroring do_gen's self-review
    let depth:i64=0;
    let b:[]u8=outc.*.b;
    let n0:i64=outc.*.n;
    let i:i64=0;
    while(i<n0){
        if(b[i]==123){depth=depth+1;}
        if(b[i]==125){depth=depth-1;}
        i=i+1;
    }
    while(depth>0){e_raw(outc,"}\n");depth=depth-1;}
    let out:[]u8=outc.*.b[0..outc.*.n];
    if(s_has(out,"UNKNOWN_GOAL")==1){return 0;}
    if(s_has(out,"UNTAUGHT:")==1){return 0;}
    if(s_has(out,"NEED_CARD:")==1){return 0;}
    if(s_has(out,"UNKNOWN_TIER")==1){return 0;}
    if(s_has(out,"REFUSED:")==1){return 0;}
    return 1;
}

// COMPILE branch: score every candidate class against all the evidence
// plus cross-checks against the source; argmax wins; ties break in the
// fixed priority order SYNTAX > DUPFN > NAME > ARITY > TYPE > UNKNOWN.
fn diag_compile(tr:*Cx, outc:*Cx, src:[]u8, ev:[]u8, dr:*DRes)void {
    let has_parse:i64=0;
    if(s_has(ev,"parse")==1){has_parse=1;}
    if(s_has(ev,"E0001")==1){has_parse=1;}
    if(s_has(ev,"unexpected")==1){has_parse=1;}
    let has_unknown:i64=s_has(ev,"unknown");
    let has_argument:i64=s_has(ev,"argument");
    let has_expfound:i64=0;
    if(s_has(ev,"expected")==1){if(s_has(ev,"found")==1){has_expfound=1;}}
    let has_e0203:i64=s_has(ev,"E0203");
    let has_dup:i64=s_has(ev,"duplicate");
    let brace_bad:i64=0;
    if(review_braces(src)==0){brace_bad=1;}
    let qn:[]u8=ev_name(ev);
    let qndef:i64=0;
    let qsim:i64=0;
    if(qn.len>0){
        qndef=count_def(src,qn);
        qsim=similar_defined(src,qn);
    }
    let nums:[]i64=i64_arena(64);
    let nn:i64=s_numbers(ev,nums);

    let s_syntax:i64=0;
    let s_name:i64=0;
    let s_arity:i64=0;
    let s_type:i64=0;
    let s_dupfn:i64=0;

    if(has_parse==1){s_syntax=s_syntax+2;t_ev(tr,"SYNTAX",2,"parse-word");}
    if(brace_bad==1){
        s_syntax=s_syntax+1;
        t_ev(tr,"SYNTAX",1,"brace-crosscheck");
        if(has_parse==1){s_syntax=s_syntax+2;t_ev(tr,"SYNTAX",2,"parse-word-and-brace-agree");}
    }
    if(has_unknown==1){s_name=s_name+2;t_ev(tr,"NAME",2,"unknown-word");}
    if(qn.len>0){
        if(qndef==0){
            s_name=s_name+3;
            t_ev(tr,"NAME",3,"named-not-defined-in-src");
            if(qsim==1){s_name=s_name+2;t_ev(tr,"NAME",2,"similar-defined-name");}
        } else {
            t_ev(tr,"NAME",0,"named-is-defined-conflict");
        }
    }
    if(has_argument==1){s_arity=s_arity+2;t_ev(tr,"ARITY",2,"argument-word");}
    if(has_argument==1){
        if(nn>=2){
            if(qn.len>0){
                if(qndef>0){s_arity=s_arity+3;t_ev(tr,"ARITY",3,"have-want-numbers-and-named-defined");}
            }
        }
    }
    if(has_expfound==1){s_type=s_type+2;t_ev(tr,"TYPE",2,"expected-found");}
    if(has_e0203==1){s_type=s_type+2;t_ev(tr,"TYPE",2,"E0203");}
    if(has_expfound==1){
        if(s_has(ev,"i32")==1){s_type=s_type+1;t_ev(tr,"TYPE",1,"type-token");}
        if(s_has(ev,"i64")==1){s_type=s_type+1;t_ev(tr,"TYPE",1,"type-token");}
        if(s_has(ev,"[]u8")==1){s_type=s_type+1;t_ev(tr,"TYPE",1,"type-token");}
    }
    if(has_dup==1){s_dupfn=s_dupfn+2;t_ev(tr,"DUPFN",2,"duplicate-word");}
    if(has_dup==1){
        if(qn.len>0){
            if(qndef>=2){s_dupfn=s_dupfn+3;t_ev(tr,"DUPFN",3,"two-defs-in-src");}
        }
    }

    let class:i64=0;
    let score:i64=0;
    if(s_syntax>score){class=1;score=s_syntax;}
    if(s_dupfn>score){class=5;score=s_dupfn;}
    if(s_name>score){class=2;score=s_name;}
    if(s_arity>score){class=3;score=s_arity;}
    if(s_type>score){class=4;score=s_type;}
    dr.*.class=class;
    dr.*.score=score;
    t_ev(tr,"WINNER",score,class_name(class));

    let strat:[]u8="halt-no-patch";
    if(class==1){
        if(patch_brace(outc,src)==1){strat="patch-brace";}
    }
    if(class==2){
        if(qn.len>0){
            if(patch_unknownfn(outc,src,qn)==1){strat="patch-unknownfn";}
        }
    }
    if(class==3){
        if(qn.len>0){
            if(patch_arity(outc,src,qn)==1){strat="patch-arity";}
        }
    }
    if(class==4){
        if(patch_ret_word(outc,src)==1){strat="patch-type-retword";}
        else if(patch_arg_unquote(outc,src)==1){strat="patch-type-argunquote";}
        else if(patch_del_badassign(outc,src)==1){strat="patch-type-delbadassign";}
    }
    if(class==5){
        if(qn.len>0){
            if(patch_dupfn(outc,src,qn)==1){strat="patch-dupfn";}
        }
    }
    if(outc.*.n==0){
        e_raw(outc,src);
    }
    dr.*.strat=strat;
    return;
}

// TEST branch: the program compiled; the failure is in behavior.
// Distinguishes RUNTIME (panic/rc), OUTPUT_FORMAT (whitespace-only),
// LOGIC_VALUE (integer delta, analyzed), LOGIC_OTHER.
fn diag_test(tr:*Cx, outc:*Cx, src:[]u8, ev:[]u8, spec:[]u8, installed:[]u8, demo:[]u8, card:[]u8, dr:*DRes)void {
    let got_rc_s:[]u8=env_get(ev,"GOT_RC");
    let exp_rc_s:[]u8=env_get(ev,"EXP_RC");
    let got_err:[]u8=ev_unescape(env_get(ev,"GOT_ERR"));
    let got:[]u8=ev_unescape(env_get(ev,"GOT_OUT"));
    let exp:[]u8=ev_unescape(env_get(ev,"EXP_OUT"));
    if(got_err.len>0){
        dr.*.class=7;
        dr.*.score=8;
        t_ev(tr,"RUNTIME",8,"stderr-nonempty");
        dr.*.strat="halt-runtime";
        e_raw(outc,src);
        return;
    }
    if(s_eq(got_rc_s,exp_rc_s)==0){
        dr.*.class=7;
        dr.*.score=6;
        t_ev(tr,"RUNTIME",6,"rc-mismatch-no-stderr");
        dr.*.strat="halt-runtime";
        e_raw(outc,src);
        return;
    }
    let got_s:[]u8=rstrip(got);
    let exp_s:[]u8=rstrip(exp);
    if(s_eq(got_s,exp_s)==1){
        dr.*.class=8;
        dr.*.score=7;
        t_ev(tr,"FORMAT",7,"equal-modulo-trailing-ws");
        let strat:[]u8="halt-no-patch";
        let exp_nl:i64=0;
        if(exp.len>0){if(exp[exp.len-1]==10){exp_nl=1;}}
        let got_nl:i64=0;
        if(got.len>0){if(got[got.len-1]==10){got_nl=1;}}
        if(exp_nl==1){
            if(got_nl==0){
                if(patch_add_newline(outc,src)==1){strat="patch-add-newline";}
            }
        }
        if(exp_nl==0){
            if(got_nl==1){
                if(patch_strip_newline(outc,src)==1){strat="patch-strip-newline";}
            }
        }
        if(outc.*.n==0){e_raw(outc,src);}
        dr.*.strat=strat;
        return;
    }
    let gi_ok:i64=all_int(got_s);
    let ei_ok:i64=all_int(exp_s);
    if(gi_ok==1){
        if(ei_ok==1){
            let gv:i64=parse_i64(got_s);
            let evv:i64=parse_i64(exp_s);
            let delta:i64=gv-evv;
            dr.*.class=9;
            dr.*.score=6;
            t_ev(tr,"LVALUE",6,"integer-outputs-differ");
            if(delta==1){t_ev(tr,"LVALUE",1,"off-by-one-high");}
            if(delta==-1){t_ev(tr,"LVALUE",1,"off-by-one-low");}
            if(gv==0-evv){t_ev(tr,"LVALUE",1,"sign-flip");}
            if(regen_from_spec(outc,spec,installed,demo,card)==1){
                dr.*.strat="regen-from-spec";
            } else {
                outc.*.n=0;
                e_raw(outc,src);
                dr.*.strat="halt-noregen";
                t_ev(tr,"LVALUE",0,"spec-not-genable");
            }
            return;
        }
    }
    dr.*.class=10;
    dr.*.score=4;
    t_ev(tr,"LOTHER",4,"non-integer-difference");
    dr.*.strat="halt-unknown";
    e_raw(outc,src);
    return;
}

fn do_diagnose()void {
    let spec:[]u8=_zag_arg(2);
    let src:[]u8=_zag_arg(3);
    let evtype:[]u8=_zag_arg(4);
    let ev:[]u8=_zag_arg(5);
    let installed:[]u8=_zag_arg(6);
    let demo:[]u8=_zag_arg(7);
    let card:[]u8=_zag_arg(8);

    let tc:Cx=cx_new(4096);
    let tr:*Cx=&tc;
    let oc:Cx=cx_new(src.len+65536);
    let outc:*Cx=&oc;
    let d:DRes=DRes{};
    let dr:*DRes=&d;
    dr.*.class=0;
    dr.*.score=0;
    dr.*.strat="halt-unknown";

    let prev:[]u8=env_get(ev,"PREV");
    let prev_class:[]u8="";
    let sl:i64=s_find(prev,"/",0);
    if(sl>0){prev_class=prev[0..sl];}
    let is_stalled:i64=0;
    if(s_eq(env_get(ev,"STALLED"),"1")==1){is_stalled=1;}
    let is_cycle:i64=0;
    if(s_eq(env_get(ev,"CYCLE"),"1")==1){is_cycle=1;}

    if(s_eq(evtype,"GEN")==1){
        dr.*.class=6;
        dr.*.score=10;
        t_ev(tr,"GENFAIL",10,"gen-emitted-sentinel");
        dr.*.strat="halt-genfail";
        e_raw(outc,src);
    } else if(s_eq(evtype,"TEST")==1){
        diag_test(tr,outc,src,ev,spec,installed,demo,card,dr);
    } else {
        diag_compile(tr,outc,src,ev,dr);
    }

    // thrash / cycle guards: override the strategy, never the diagnosis
    if(is_cycle==1){
        if(s_eq(dr.*.strat,"halt-genfail")==0){
            t_ev(tr,"CYCLE",99,"source-hash-seen-before");
            dr.*.strat="halt-cycle";
            outc.*.n=0;
            e_raw(outc,src);
        }
    } else {
        if(is_stalled==1){
            if(s_eq(prev_class,class_name(dr.*.class))==1){
                t_ev(tr,"THRASH",99,"same-class-no-source-change");
                dr.*.strat="halt-thrash";
                outc.*.n=0;
                e_raw(outc,src);
            }
        }
    }

    _zag_print("DIAG class=");
    _zag_print(class_name(dr.*.class));
    _zag_print(" strategy=");
    _zag_print(dr.*.strat);
    _zag_print(" score=");
    _zag_print(_zag_i64_to_str(dr.*.score));
    _zag_print(" trace=");
    let trb:[]u8=tr.*.b[0..tr.*.n];
    _zag_print(trb);
    _zag_print("\n@@SRC@@\n");
    let ob:[]u8=outc.*.b[0..outc.*.n];
    _zag_print(ob);
    if(ob.len>0){
        if(ob[ob.len-1]!=10){_zag_print("\n");}
    }
    _zag_print("@@END@@\n");
    return;
}
fn si_put64(b:[]u8, o:i64, v:i64)void {
    let i:i64=0;
    while(i<8){
        let sh:i64=i*8;
        b[o+i]=((v>>sh)&255) as u8;
        i=i+1;
    }
    return;
}

fn si_get64(b:[]u8, o:i64)i64 {
    let v:i64=0;
    let k:i64=0;
    while(k<8){
        v=v|(((b[o+k] as i64)&255)<<(k*8));
        k=k+1;
    }
    return v;
}

// ============ section SI2: arm 2 free-intelligence (2b memo, 2c rules) ============
//
// Pure-Zag persistent memoization (2b) and compiled fast paths (2c) for diagnose.
// argv(9) = state file path ("" disables persistence). argv(10) = mechanism:
//   "off" | "memo" | "rules" | "both".
//
// 2b memo: key = (fnv1a(spec), evtype, structural signature). One deliberation
//   run per diagnose call; on a memo hit that run doubles as the shadow
//   verification (fresh result byte-compared to cached class/strategy/trace/
//   revised-source). Match -> output cached; mismatch -> drop entry, output
//   fresh, count a quality defect. hevals counts the fresh run.
// 2c rules: key = (evtype, signature). K=3 full-deliberation observations of
//   (sig -> class+strategy) install a rule; the first M=5 applications shadow
//   full deliberation (mismatch -> uninstall + defect); thereafter the stored
//   strategy is applied directly and the stored trace replayed, skipping
//   multi-hypothesis scoring (hevals=0 for the scoring phase).
// The signature is the fixed reason-string multiset (pre-override trace bytes),
// which contains no raw evidence bytes. CYCLE/THRASH overrides apply after the
// memo/rule logic, exactly as in the baseline.

// --- contribution capture ---
// One scored hypothesis evaluation: (class-name bytes, points, reason bytes).
// Slot = 40 bytes: cls_len@0, cls_off@8, pts@16, why_off@24, why_len@32.
// the reason arena. st = 16 bytes: count@0, bump@8.
fn si_rec(cb:[]u8, ra:[]u8, st:[]u8, cls:[]u8, pts:i64, why:[]u8)void {
    let i:i64=si_get64(st,0);
    si_put64(cb,i*40,cls.len);
    let co:i64=si_get64(st,8);
    let k:i64=0;
    while(k<cls.len){ra[co+k]=cls[k];k=k+1;}
    si_put64(cb,i*40+8,co);
    si_put64(cb,i*40+16,pts);
    let wo:i64=co+cls.len;
    si_put64(cb,i*40+24,wo);
    si_put64(cb,i*40+32,why.len);
    k=0;
    while(k<why.len){ra[wo+k]=why[k];k=k+1;}
    si_put64(st,0,i+1);
    si_put64(st,8,wo+why.len);
    return;
}

// Emit one contribution's canonical bytes: CLS+pts:why;
fn si_emit_one(out:[]u8, p:i64, cls:[]u8, pts:i64, why:[]u8)i64 {
    let k:i64=0;
    while(k<cls.len){out[p]=cls[k];p=p+1;k=k+1;}
    out[p]=43;p=p+1;
    let ps:[]u8=_zag_i64_to_str(pts);
    k=0;
    while(k<ps.len){out[p]=ps[k];p=p+1;k=k+1;}
    out[p]=58;p=p+1;
    k=0;
    while(k<why.len){out[p]=why[k];p=p+1;k=k+1;}
    out[p]=59;p=p+1;
    return p;
}

// Serialize the recorded contributions to the canonical signature bytes.
fn si_sigwrite(cb:[]u8, ra:[]u8, st:[]u8, out:[]u8)i64 {
    let n:i64=si_get64(st,0);
    let p:i64=0;
    let i:i64=0;
    while(i<n){
        let cl:i64=si_get64(cb,i*40);
        let co:i64=si_get64(cb,i*40+8);
        let pts:i64=si_get64(cb,i*40+16);
        let wo:i64=si_get64(cb,i*40+24);
        let wl:i64=si_get64(cb,i*40+32);
        let cls:[]u8=ra[co..co+cl];
        let why:[]u8=ra[wo..wo+wl];
        p=si_emit_one(out,p,cls,pts,why);
        i=i+1;
    }
    return p;
}

// fnv1a-64 over bytes.
fn si_fnv(s:[]u8)i64 {
    let h:i64=0;
    let i:i64=0;
    // 14695981039346656037 as i64 (wraps)
    h=-3750763034362895579;
    while(i<s.len){
        h=h^((s[i] as i64)&255);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}

fn si_path_cstr(s:[]u8)*u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let i:i64=0;
    while(i<s.len){p[i]=s[i];i=i+1;}
    p[s.len]=0;
    return p;
}

// read whole file; returns byte count or -1.
fn si_read_all(path:[]u8, mem:*u8, cap:i64)i64 {
    let pp:*u8=si_path_cstr(path);
    let fd:i64=_zag_raw_syscall(2,pp as i64,0,0,0,0,0);
    if(fd<0){return -1;}
    let total:i64=0;
    while(1==1){
        if(total>=cap){break;}
        let want:i64=cap-total;
        if(want>65536){want=65536;}
        let r:i64=_zag_raw_syscall(0,fd,(mem as i64)+total,want,0,0,0);
        if(r<=0){break;}
        total=total+r;
    }
    let c:i64=_zag_raw_syscall(3,fd,0,0,0,0,0);
    return total;
}

// write whole buffer with O_TRUNC; returns 0 ok, -1 fail.
fn si_write_all(path:[]u8, bp:*u8, len:i64)i64 {
    let pp:*u8=si_path_cstr(path);
    let fd:i64=_zag_raw_syscall(2,pp as i64,577,420,0,0,0);
    if(fd<0){return -1;}
    let total:i64=0;
    while(total<len){
        let w:i64=_zag_raw_syscall(1,fd,(bp as i64)+total,len-total,0,0,0);
        if(w<=0){
            let c2:i64=_zag_raw_syscall(3,fd,0,0,0,0,0);
            return -1;
        }
        total=total+w;
    }
    let c:i64=_zag_raw_syscall(3,fd,0,0,0,0,0);
    return 0;
}

// --- persistent state: memo + rule records ---
// Metadata = 128 bytes/record (16 u64s):
//   0 kind(1=memo,2=rule) 1 spechash 2 evtype(1=COMPILE,2=TEST,3=GEN)
//   3 sig_off 4 sig_len 5 class 6 score 7 strat_off 8 strat_len
//   9 trace_off 10 trace_len 11 src_off 12 src_len 13 count 14 apps 15 unused
// Variable bytes live in the bytes arena. sst[0]=nrec, sst[8]=bytes bump.
fn si_mget(md:[]u8, r:i64, f:i64)i64 {
    return si_get64(md,r*128+f*8);
}
fn si_mput(md:[]u8, r:i64, f:i64, v:i64)void {
    si_put64(md,r*128+f*8,v);
    return;
}

// Load state file. Returns 0 ok (absent file -> empty state), -1 corrupt.
fn si_load(path:[]u8, md:[]u8, by:[]u8, sst:[]u8)i64 {
    si_put64(sst,0,0);
    si_put64(sst,8,0);
    if(path.len==0){return 0;}
    let fbp:*u8=_zag_malloc(4194304) as *u8;
    let fb:[]u8=fbp[0..4194304];
    let n:i64=si_read_all(path,fbp,4194304);
    if(n<0){return 0;}
    if(n<14){return -1;}
    if(s_eq(fb[0..6],"SIST1\n")==0){return -1;}
    let nrec:i64=si_get64(fb,6);
    let pos:i64=14;
    let r:i64=0;
    let bump:i64=0;
    while(r<nrec){
        if(pos+32>n){return -1;}
        let kind:i64=si_get64(fb,pos);pos=pos+8;
        let sh:i64=si_get64(fb,pos);pos=pos+8;
        let et:i64=si_get64(fb,pos);pos=pos+8;
        let siglen:i64=si_get64(fb,pos);pos=pos+8;
        if(siglen<0){return -1;}
        if(pos+siglen>n){return -1;}
        let sigoff:i64=bump;
        let k:i64=0;
        while(k<siglen){by[bump]=fb[pos+k];bump=bump+1;k=k+1;}
        pos=pos+siglen;
        if(pos+16>n){return -1;}
        let class:i64=si_get64(fb,pos);pos=pos+8;
        let score:i64=si_get64(fb,pos);pos=pos+8;
        let stratlen:i64=si_get64(fb,pos);pos=pos+8;
        if(stratlen<0){return -1;}
        if(pos+stratlen>n){return -1;}
        let stratoff:i64=bump;
        k=0;
        while(k<stratlen){by[bump]=fb[pos+k];bump=bump+1;k=k+1;}
        pos=pos+stratlen;
        let tracelen:i64=si_get64(fb,pos);pos=pos+8;
        if(tracelen<0){return -1;}
        if(pos+tracelen>n){return -1;}
        let traceoff:i64=bump;
        k=0;
        while(k<tracelen){by[bump]=fb[pos+k];bump=bump+1;k=k+1;}
        pos=pos+tracelen;
        let srclen:i64=si_get64(fb,pos);pos=pos+8;
        if(srclen<0){return -1;}
        if(pos+srclen>n){return -1;}
        let srcoff:i64=bump;
        k=0;
        while(k<srclen){by[bump]=fb[pos+k];bump=bump+1;k=k+1;}
        pos=pos+srclen;
        if(pos+16>n){return -1;}
        let count:i64=si_get64(fb,pos);pos=pos+8;
        let apps:i64=si_get64(fb,pos);pos=pos+8;
        si_mput(md,r,0,kind);
        si_mput(md,r,1,sh);
        si_mput(md,r,2,et);
        si_mput(md,r,3,sigoff);
        si_mput(md,r,4,siglen);
        si_mput(md,r,5,class);
        si_mput(md,r,6,score);
        si_mput(md,r,7,stratoff);
        si_mput(md,r,8,stratlen);
        si_mput(md,r,9,traceoff);
        si_mput(md,r,10,tracelen);
        si_mput(md,r,11,srcoff);
        si_mput(md,r,12,srclen);
        si_mput(md,r,13,count);
        si_mput(md,r,14,apps);
        r=r+1;
    }
    si_put64(sst,0,nrec);
    si_put64(sst,8,bump);
    return 0;
}

// Save state file. Returns 0 ok, -1 fail.
fn si_save(path:[]u8, md:[]u8, by:[]u8, sst:[]u8)i64 {
    if(path.len==0){return 0;}
    let nrec:i64=si_get64(sst,0);
    let obp:*u8=_zag_malloc(4194304) as *u8;
    let ob:[]u8=obp[0..4194304];
    let pos:i64=0;
    let mg:[]u8="SIST1\n";
    let k:i64=0;
    while(k<6){ob[pos]=mg[k];pos=pos+1;k=k+1;}
    si_put64(ob,pos,nrec);pos=pos+8;
    let r:i64=0;
    while(r<nrec){
        si_put64(ob,pos,si_mget(md,r,0));pos=pos+8;
        si_put64(ob,pos,si_mget(md,r,1));pos=pos+8;
        si_put64(ob,pos,si_mget(md,r,2));pos=pos+8;
        let sl:i64=si_mget(md,r,4);
        si_put64(ob,pos,sl);pos=pos+8;
        let so:i64=si_mget(md,r,3);
        k=0;
        while(k<sl){ob[pos]=by[so+k];pos=pos+1;k=k+1;}
        si_put64(ob,pos,si_mget(md,r,5));pos=pos+8;
        si_put64(ob,pos,si_mget(md,r,6));pos=pos+8;
        let tl:i64=si_mget(md,r,8);
        si_put64(ob,pos,tl);pos=pos+8;
        let to:i64=si_mget(md,r,7);
        k=0;
        while(k<tl){ob[pos]=by[to+k];pos=pos+1;k=k+1;}
        let rl:i64=si_mget(md,r,10);
        si_put64(ob,pos,rl);pos=pos+8;
        let ro:i64=si_mget(md,r,9);
        k=0;
        while(k<rl){ob[pos]=by[ro+k];pos=pos+1;k=k+1;}
        let ql:i64=si_mget(md,r,12);
        si_put64(ob,pos,ql);pos=pos+8;
        let qo:i64=si_mget(md,r,11);
        k=0;
        while(k<ql){ob[pos]=by[qo+k];pos=pos+1;k=k+1;}
        si_put64(ob,pos,si_mget(md,r,13));pos=pos+8;
        si_put64(ob,pos,si_mget(md,r,14));pos=pos+8;
        r=r+1;
    }
    return si_write_all(path,obp,pos);
}

// Find memo record by (spechash, evtype, sig). Returns index or -1.
fn si_find_memo(md:[]u8, by:[]u8, sst:[]u8, sh:i64, et:i64, sig:[]u8)i64 {
    let nrec:i64=si_get64(sst,0);
    let r:i64=0;
    while(r<nrec){
        if(si_mget(md,r,0)==1){
            if(si_mget(md,r,1)==sh){
                if(si_mget(md,r,2)==et){
                    let so:i64=si_mget(md,r,3);
                    let sl:i64=si_mget(md,r,4);
                    if(sl==sig.len){
                        if(s_eq(by[so..so+sl],sig)==1){return r;}
                    }
                }
            }
        }
        r=r+1;
    }
    return -1;
}

// Find rule record by (evtype, sig). Returns index or -1.
fn si_find_rule(md:[]u8, by:[]u8, sst:[]u8, et:i64, sig:[]u8)i64 {
    let nrec:i64=si_get64(sst,0);
    let r:i64=0;
    while(r<nrec){
        if(si_mget(md,r,0)==2){
            if(si_mget(md,r,2)==et){
                let so:i64=si_mget(md,r,3);
                let sl:i64=si_mget(md,r,4);
                if(sl==sig.len){
                    if(s_eq(by[so..so+sl],sig)==1){return r;}
                }
            }
        }
        r=r+1;
    }
    return -1;
}

// Append a record. Returns index.
fn si_add_rec(md:[]u8, by:[]u8, sst:[]u8, kind:i64, sh:i64, et:i64, sig:[]u8, class:i64, score:i64, strat:[]u8, trace:[]u8, src:[]u8, count:i64, apps:i64)i64 {
    let r:i64=si_get64(sst,0);
    let bump:i64=si_get64(sst,8);
    si_mput(md,r,0,kind);
    si_mput(md,r,1,sh);
    si_mput(md,r,2,et);
    si_mput(md,r,3,bump);
    si_mput(md,r,4,sig.len);
    let k:i64=0;
    while(k<sig.len){by[bump]=sig[k];bump=bump+1;k=k+1;}
    si_mput(md,r,5,class);
    si_mput(md,r,6,score);
    si_mput(md,r,7,bump);
    si_mput(md,r,8,strat.len);
    k=0;
    while(k<strat.len){by[bump]=strat[k];bump=bump+1;k=k+1;}
    si_mput(md,r,9,bump);
    si_mput(md,r,10,trace.len);
    k=0;
    while(k<trace.len){by[bump]=trace[k];bump=bump+1;k=k+1;}
    si_mput(md,r,11,bump);
    si_mput(md,r,12,src.len);
    k=0;
    while(k<src.len){by[bump]=src[k];bump=bump+1;k=k+1;}
    si_mput(md,r,13,count);
    si_mput(md,r,14,apps);
    si_put64(sst,0,r+1);
    si_put64(sst,8,bump);
    return r;
}

// Remove record r by swapping with the last.
fn si_del_rec(md:[]u8, sst:[]u8, r:i64)void {
    let nrec:i64=si_get64(sst,0);
    let last:i64=nrec-1;
    if(r!=last){
        let f:i64=0;
        while(f<16){
            si_mput(md,r,f,si_mget(md,last,f));
            f=f+1;
        }
    }
    si_put64(sst,0,last);
    return;
}

// --- restructured COMPILE deliberation (arm 2b/2c) ---
// dcc_full: predicates + si_rec (no scoring, no trace). Returns qn.
fn dcc_full(src:[]u8, ev:[]u8, cb:[]u8, ra:[]u8, st:[]u8)[]u8 {
    let has_parse:i64=0;
    if(s_has(ev,"parse")==1){has_parse=1;}
    if(s_has(ev,"E0001")==1){has_parse=1;}
    if(s_has(ev,"unexpected")==1){has_parse=1;}
    let has_unknown:i64=s_has(ev,"unknown");
    let has_argument:i64=s_has(ev,"argument");
    let has_expfound:i64=0;
    if(s_has(ev,"expected")==1){if(s_has(ev,"found")==1){has_expfound=1;}}
    let has_e0203:i64=s_has(ev,"E0203");
    let has_dup:i64=s_has(ev,"duplicate");
    let brace_bad:i64=0;
    if(review_braces(src)==0){brace_bad=1;}
    let qn:[]u8=ev_name(ev);
    let qndef:i64=0;
    let qsim:i64=0;
    if(qn.len>0){
        qndef=count_def(src,qn);
        qsim=similar_defined(src,qn);
    }
    let nums:[]i64=i64_arena(64);
    let nn:i64=s_numbers(ev,nums);
    let SYN:[]u8="SYNTAX";
    let NAM:[]u8="NAME";
    let ARI:[]u8="ARITY";
    let TYP:[]u8="TYPE";
    let DUP:[]u8="DUPFN";
    if(has_parse==1){si_rec(cb,ra,st,SYN,2,"parse-word");}
    if(brace_bad==1){
        si_rec(cb,ra,st,SYN,1,"brace-crosscheck");
        if(has_parse==1){si_rec(cb,ra,st,SYN,2,"parse-word-and-brace-agree");}
    }
    if(has_unknown==1){si_rec(cb,ra,st,NAM,2,"unknown-word");}
    if(qn.len>0){
        if(qndef==0){
            si_rec(cb,ra,st,NAM,3,"named-not-defined-in-src");
            if(qsim==1){si_rec(cb,ra,st,NAM,2,"similar-defined-name");}
        } else {
            si_rec(cb,ra,st,NAM,0,"named-is-defined-conflict");
        }
    }
    if(has_argument==1){si_rec(cb,ra,st,ARI,2,"argument-word");}
    if(has_argument==1){
        if(nn>=2){
            if(qn.len>0){
                if(qndef>0){si_rec(cb,ra,st,ARI,3,"have-want-numbers-and-named-defined");}
            }
        }
    }
    if(has_expfound==1){si_rec(cb,ra,st,TYP,2,"expected-found");}
    if(has_e0203==1){si_rec(cb,ra,st,TYP,2,"E0203");}
    if(has_expfound==1){
        if(s_has(ev,"i32")==1){si_rec(cb,ra,st,TYP,1,"type-token");}
        if(s_has(ev,"i64")==1){si_rec(cb,ra,st,TYP,1,"type-token");}
        if(s_has(ev,"[]u8")==1){si_rec(cb,ra,st,TYP,1,"type-token");}
    }
    if(has_dup==1){si_rec(cb,ra,st,DUP,2,"duplicate-word");}
    if(has_dup==1){
        if(qn.len>0){
            if(qndef>=2){si_rec(cb,ra,st,DUP,3,"two-defs-in-src");}
        }
    }
    return qn;
}

// dcc_sig: predicates -> sig bytes directly (no si_rec). Returns sig length.
// Must produce byte-identical output to si_sigwrite(dcc_full(...)).
fn dcc_sig(src:[]u8, ev:[]u8, out:[]u8)i64 {
    let has_parse:i64=0;
    if(s_has(ev,"parse")==1){has_parse=1;}
    if(s_has(ev,"E0001")==1){has_parse=1;}
    if(s_has(ev,"unexpected")==1){has_parse=1;}
    let has_unknown:i64=s_has(ev,"unknown");
    let has_argument:i64=s_has(ev,"argument");
    let has_expfound:i64=0;
    if(s_has(ev,"expected")==1){if(s_has(ev,"found")==1){has_expfound=1;}}
    let has_e0203:i64=s_has(ev,"E0203");
    let has_dup:i64=s_has(ev,"duplicate");
    let brace_bad:i64=0;
    if(review_braces(src)==0){brace_bad=1;}
    let qn:[]u8=ev_name(ev);
    let qndef:i64=0;
    let qsim:i64=0;
    if(qn.len>0){
        qndef=count_def(src,qn);
        qsim=similar_defined(src,qn);
    }
    let nums:[]i64=i64_arena(64);
    let nn:i64=s_numbers(ev,nums);
    let SYN:[]u8="SYNTAX";
    let NAM:[]u8="NAME";
    let ARI:[]u8="ARITY";
    let TYP:[]u8="TYPE";
    let DUP:[]u8="DUPFN";
    let p:i64=0;
    if(has_parse==1){p=si_emit_one(out,p,SYN,2,"parse-word");}
    if(brace_bad==1){
        p=si_emit_one(out,p,SYN,1,"brace-crosscheck");
        if(has_parse==1){p=si_emit_one(out,p,SYN,2,"parse-word-and-brace-agree");}
    }
    if(has_unknown==1){p=si_emit_one(out,p,NAM,2,"unknown-word");}
    if(qn.len>0){
        if(qndef==0){
            p=si_emit_one(out,p,NAM,3,"named-not-defined-in-src");
            if(qsim==1){p=si_emit_one(out,p,NAM,2,"similar-defined-name");}
        } else {
            p=si_emit_one(out,p,NAM,0,"named-is-defined-conflict");
        }
    }
    if(has_argument==1){p=si_emit_one(out,p,ARI,2,"argument-word");}
    if(has_argument==1){
        if(nn>=2){
            if(qn.len>0){
                if(qndef>0){p=si_emit_one(out,p,ARI,3,"have-want-numbers-and-named-defined");}
            }
        }
    }
    if(has_expfound==1){p=si_emit_one(out,p,TYP,2,"expected-found");}
    if(has_e0203==1){p=si_emit_one(out,p,TYP,2,"E0203");}
    if(has_expfound==1){
        if(s_has(ev,"i32")==1){p=si_emit_one(out,p,TYP,1,"type-token");}
        if(s_has(ev,"i64")==1){p=si_emit_one(out,p,TYP,1,"type-token");}
        if(s_has(ev,"[]u8")==1){p=si_emit_one(out,p,TYP,1,"type-token");}
    }
    if(has_dup==1){p=si_emit_one(out,p,DUP,2,"duplicate-word");}
    if(has_dup==1){
        if(qn.len>0){
            if(qndef>=2){p=si_emit_one(out,p,DUP,3,"two-defs-in-src");}
        }
    }
    return p;
}

// dcc_score: argmax from recorded contributions, emit trace + WINNER, set dr.
// Returns hypothesis-evaluation count (contributions scored).
fn dcc_score(cb:[]u8, ra:[]u8, st:[]u8, tr:*Cx, dr:*DRes)i64 {
    let s_syntax:i64=0;
    let s_name:i64=0;
    let s_arity:i64=0;
    let s_type:i64=0;
    let s_dupfn:i64=0;
    let n:i64=si_get64(st,0);
    let i:i64=0;
    while(i<n){
        let cl:i64=si_get64(cb,i*40);
        let co:i64=si_get64(cb,i*40+8);
        let pts:i64=si_get64(cb,i*40+16);
        let cn:[]u8=ra[co..co+cl];
        if(s_eq(cn,"SYNTAX")==1){s_syntax=s_syntax+pts;}
        if(s_eq(cn,"NAME")==1){s_name=s_name+pts;}
        if(s_eq(cn,"ARITY")==1){s_arity=s_arity+pts;}
        if(s_eq(cn,"TYPE")==1){s_type=s_type+pts;}
        if(s_eq(cn,"DUPFN")==1){s_dupfn=s_dupfn+pts;}
        i=i+1;
    }
    let class:i64=0;
    let score:i64=0;
    if(s_syntax>score){class=1;score=s_syntax;}
    if(s_dupfn>score){class=5;score=s_dupfn;}
    if(s_name>score){class=2;score=s_name;}
    if(s_arity>score){class=3;score=s_arity;}
    if(s_type>score){class=4;score=s_type;}
    dr.*.class=class;
    dr.*.score=score;
    i=0;
    while(i<n){
        let cl:i64=si_get64(cb,i*40);
        let co:i64=si_get64(cb,i*40+8);
        let pts:i64=si_get64(cb,i*40+16);
        let wo:i64=si_get64(cb,i*40+24);
        let wl:i64=si_get64(cb,i*40+32);
        t_ev(tr,ra[co..co+cl],pts,ra[wo..wo+wl]);
        i=i+1;
    }
    t_ev(tr,"WINNER",score,class_name(class));
    return n;
}

// dcc_apply: strategy selection + application. Returns strat.
fn dcc_apply(class:i64, src:[]u8, qn:[]u8, outc:*Cx)[]u8 {
    let strat:[]u8="halt-no-patch";
    if(class==1){
        if(patch_brace(outc,src)==1){strat="patch-brace";}
    }
    if(class==2){
        if(qn.len>0){
            if(patch_unknownfn(outc,src,qn)==1){strat="patch-unknownfn";}
        }
    }
    if(class==3){
        if(qn.len>0){
            if(patch_arity(outc,src,qn)==1){strat="patch-arity";}
        }
    }
    if(class==4){
        if(patch_ret_word(outc,src)==1){strat="patch-type-retword";}
        else if(patch_arg_unquote(outc,src)==1){strat="patch-type-argunquote";}
        else if(patch_del_badassign(outc,src)==1){strat="patch-type-delbadassign";}
    }
    if(class==5){
        if(qn.len>0){
            if(patch_dupfn(outc,src,qn)==1){strat="patch-dupfn";}
        }
    }
    if(outc.*.n==0){
        e_raw(outc,src);
    }
    return strat;
}

// --- restructured TEST deliberation (arm 2b/2c) ---
// Branch ids: 1=stderr(RUNTIME) 2=rc-mismatch(RUNTIME) 3=format 4=lvalue 5=lother.
// bi = 32 bytes: id@0, p1@8, p2@16, p3@24.

// Analyze the evidence envelope; determine the branch and its params.
fn dct_analyze(ev:[]u8, bi:[]u8)void {
    let got_rc_s:[]u8=env_get(ev,"GOT_RC");
    let exp_rc_s:[]u8=env_get(ev,"EXP_RC");
    let got_err:[]u8=ev_unescape(env_get(ev,"GOT_ERR"));
    let got:[]u8=ev_unescape(env_get(ev,"GOT_OUT"));
    let exp:[]u8=ev_unescape(env_get(ev,"EXP_OUT"));
    // Stash parsed pieces in bi via offsets into ev? We re-parse in full/sig.
    // Here just determine the branch id using cheap checks.
    if(got_err.len>0){si_put64(bi,0,1);return;}
    if(s_eq(got_rc_s,exp_rc_s)==0){si_put64(bi,0,2);return;}
    let got_s:[]u8=rstrip(got);
    let exp_s:[]u8=rstrip(exp);
    if(s_eq(got_s,exp_s)==1){si_put64(bi,0,3);return;}
    let gi_ok:i64=all_int(got_s);
    let ei_ok:i64=all_int(exp_s);
    if(gi_ok==1){
        if(ei_ok==1){si_put64(bi,0,4);return;}
    }
    si_put64(bi,0,5);
    return;
}

// dct_full: record contributions via si_rec, set class/score in dr.
// Returns branch id. Branch params stored in bi.
fn dct_full(src:[]u8, ev:[]u8, spec:[]u8, installed:[]u8, demo:[]u8, card:[]u8, cb:[]u8, ra:[]u8, st:[]u8, bi:[]u8, dr:*DRes)i64 {
    let got_rc_s:[]u8=env_get(ev,"GOT_RC");
    let exp_rc_s:[]u8=env_get(ev,"EXP_RC");
    let got_err:[]u8=ev_unescape(env_get(ev,"GOT_ERR"));
    let got:[]u8=ev_unescape(env_get(ev,"GOT_OUT"));
    let exp:[]u8=ev_unescape(env_get(ev,"EXP_OUT"));
    let RUN:[]u8="RUNTIME";
    if(got_err.len>0){
        dr.*.class=7;
        dr.*.score=8;
        si_rec(cb,ra,st,RUN,8,"stderr-nonempty");
        si_put64(bi,0,1);
        return 1;
    }
    if(s_eq(got_rc_s,exp_rc_s)==0){
        dr.*.class=7;
        dr.*.score=6;
        si_rec(cb,ra,st,RUN,6,"rc-mismatch-no-stderr");
        si_put64(bi,0,2);
        return 2;
    }
    let got_s:[]u8=rstrip(got);
    let exp_s:[]u8=rstrip(exp);
    if(s_eq(got_s,exp_s)==1){
        dr.*.class=8;
        dr.*.score=7;
        si_rec(cb,ra,st,"FORMAT",7,"equal-modulo-trailing-ws");
        let exp_nl:i64=0;
        if(exp.len>0){if(exp[exp.len-1]==10){exp_nl=1;}}
        let got_nl:i64=0;
        if(got.len>0){if(got[got.len-1]==10){got_nl=1;}}
        si_put64(bi,0,3);
        si_put64(bi,8,exp_nl);
        si_put64(bi,16,got_nl);
        return 3;
    }
    let gi_ok:i64=all_int(got_s);
    let ei_ok:i64=all_int(exp_s);
    if(gi_ok==1){
        if(ei_ok==1){
            let gv:i64=parse_i64(got_s);
            let evv:i64=parse_i64(exp_s);
            let delta:i64=gv-evv;
            dr.*.class=9;
            dr.*.score=6;
            si_rec(cb,ra,st,"LVALUE",6,"integer-outputs-differ");
            if(delta==1){si_rec(cb,ra,st,"LVALUE",1,"off-by-one-high");}
            if(delta==-1){si_rec(cb,ra,st,"LVALUE",1,"off-by-one-low");}
            if(gv==0-evv){si_rec(cb,ra,st,"LVALUE",1,"sign-flip");}
            si_put64(bi,0,4);
            // regen outcome is determined in apply; for the sig we need it now.
            // Probe with a dummy Cx (does not touch the real outc).
            let dc:Cx=cx_new(src.len+65536);
            let dcp:*Cx=&dc;
            let rok:i64=regen_from_spec(dcp,spec,installed,demo,card);
            si_put64(bi,8,rok);
            if(rok==0){
                si_rec(cb,ra,st,"LVALUE",0,"spec-not-genable");
            }
            return 4;
        }
    }
    dr.*.class=10;
    dr.*.score=4;
    si_rec(cb,ra,st,"LOTHER",4,"non-integer-difference");
    si_put64(bi,0,5);
    return 5;
}

// dct_sig: branch analysis -> sig bytes directly (no si_rec). Returns sig len.
fn dct_sig(src:[]u8, ev:[]u8, spec:[]u8, installed:[]u8, demo:[]u8, card:[]u8, out:[]u8)i64 {
    let got_rc_s:[]u8=env_get(ev,"GOT_RC");
    let exp_rc_s:[]u8=env_get(ev,"EXP_RC");
    let got_err:[]u8=ev_unescape(env_get(ev,"GOT_ERR"));
    let got:[]u8=ev_unescape(env_get(ev,"GOT_OUT"));
    let exp:[]u8=ev_unescape(env_get(ev,"EXP_OUT"));
    let p:i64=0;
    let RUN:[]u8="RUNTIME";
    if(got_err.len>0){
        p=si_emit_one(out,p,RUN,8,"stderr-nonempty");
        return p;
    }
    if(s_eq(got_rc_s,exp_rc_s)==0){
        p=si_emit_one(out,p,RUN,6,"rc-mismatch-no-stderr");
        return p;
    }
    let got_s:[]u8=rstrip(got);
    let exp_s:[]u8=rstrip(exp);
    if(s_eq(got_s,exp_s)==1){
        p=si_emit_one(out,p,"FORMAT",7,"equal-modulo-trailing-ws");
        return p;
    }
    let gi_ok:i64=all_int(got_s);
    let ei_ok:i64=all_int(exp_s);
    if(gi_ok==1){
        if(ei_ok==1){
            let gv:i64=parse_i64(got_s);
            let evv:i64=parse_i64(exp_s);
            let delta:i64=gv-evv;
            p=si_emit_one(out,p,"LVALUE",6,"integer-outputs-differ");
            if(delta==1){p=si_emit_one(out,p,"LVALUE",1,"off-by-one-high");}
            if(delta==-1){p=si_emit_one(out,p,"LVALUE",1,"off-by-one-low");}
            if(gv==0-evv){p=si_emit_one(out,p,"LVALUE",1,"sign-flip");}
            let dc:Cx=cx_new(src.len+65536);
            let dcp:*Cx=&dc;
            if(regen_from_spec(dcp,spec,installed,demo,card)==0){
                p=si_emit_one(out,p,"LVALUE",0,"spec-not-genable");
            }
            return p;
        }
    }
    p=si_emit_one(out,p,"LOTHER",4,"non-integer-difference");
    return p;
}

// dct_score: emit trace from recorded contributions (no WINNER in TEST).
// Returns hevals.
fn dct_score(cb:[]u8, ra:[]u8, st:[]u8, tr:*Cx, dr:*DRes)i64 {
    let n:i64=si_get64(st,0);
    let i:i64=0;
    while(i<n){
        let cl:i64=si_get64(cb,i*40);
        let co:i64=si_get64(cb,i*40+8);
        let pts:i64=si_get64(cb,i*40+16);
        let wo:i64=si_get64(cb,i*40+24);
        let wl:i64=si_get64(cb,i*40+32);
        t_ev(tr,ra[co..co+cl],pts,ra[wo..wo+wl]);
        i=i+1;
    }
    return n;
}

// dct_apply: strategy application by branch. Returns strat.
fn dct_apply(branch:i64, bi:[]u8, src:[]u8, spec:[]u8, installed:[]u8, demo:[]u8, card:[]u8, outc:*Cx, tr:*Cx)[]u8 {
    if(branch==1){
        e_raw(outc,src);
        let s:[]u8="halt-runtime";
        return s;
    }
    if(branch==2){
        e_raw(outc,src);
        let s2:[]u8="halt-runtime";
        return s2;
    }
    if(branch==3){
        let strat:[]u8="halt-no-patch";
        let exp_nl:i64=si_get64(bi,8);
        let got_nl:i64=si_get64(bi,16);
        if(exp_nl==1){
            if(got_nl==0){
                if(patch_add_newline(outc,src)==1){strat="patch-add-newline";}
            }
        }
        if(exp_nl==0){
            if(got_nl==1){
                if(patch_strip_newline(outc,src)==1){strat="patch-strip-newline";}
            }
        }
        if(outc.*.n==0){e_raw(outc,src);}
        return strat;
    }
    if(branch==4){
        let rok:i64=si_get64(bi,8);
        if(rok==1){
            // Re-run for real (the probe used a dummy Cx).
            if(regen_from_spec(outc,spec,installed,demo,card)==1){
                let s3:[]u8="regen-from-spec";
                return s3;
            }
        }
        outc.*.n=0;
        e_raw(outc,src);
        let s4:[]u8="halt-noregen";
        return s4;
    }
    e_raw(outc,src);
    let s5:[]u8="halt-unknown";
    return s5;
}

// --- fast-path strategy dispatch (2c) ---
// Apply the stored strategy directly. Returns 1 if outc was populated,
// 0 if the strategy failed to apply (caller falls back to full deliberation).
// qn/branch/bi carry the strategy params from analysis.
fn si_apply_strat(strat:[]u8, src:[]u8, spec:[]u8, installed:[]u8, demo:[]u8, card:[]u8, qn:[]u8, branch:i64, bi:[]u8, outc:*Cx)i64 {
    // halt-* : keep the original source.
    if(s_eq(strat,"halt-runtime")==1){e_raw(outc,src);return 1;}
    if(s_eq(strat,"halt-no-patch")==1){e_raw(outc,src);return 1;}
    if(s_eq(strat,"halt-noregen")==1){e_raw(outc,src);return 1;}
    if(s_eq(strat,"halt-unknown")==1){e_raw(outc,src);return 1;}
    if(s_eq(strat,"halt-genfail")==1){e_raw(outc,src);return 1;}
    if(s_eq(strat,"halt-thrash")==1){e_raw(outc,src);return 1;}
    if(s_eq(strat,"halt-cycle")==1){e_raw(outc,src);return 1;}
    // patch-* : direct application.
    if(s_eq(strat,"patch-brace")==1){return patch_brace(outc,src);}
    if(s_eq(strat,"patch-unknownfn")==1){
        if(qn.len>0){return patch_unknownfn(outc,src,qn);}
        e_raw(outc,src);return 1;
    }
    if(s_eq(strat,"patch-arity")==1){
        if(qn.len>0){return patch_arity(outc,src,qn);}
        e_raw(outc,src);return 1;
    }
    if(s_eq(strat,"patch-type-retword")==1){return patch_ret_word(outc,src);}
    if(s_eq(strat,"patch-type-argunquote")==1){return patch_arg_unquote(outc,src);}
    if(s_eq(strat,"patch-type-delbadassign")==1){return patch_del_badassign(outc,src);}
    if(s_eq(strat,"patch-dupfn")==1){
        if(qn.len>0){return patch_dupfn(outc,src,qn);}
        e_raw(outc,src);return 1;
    }
    if(s_eq(strat,"patch-add-newline")==1){return patch_add_newline(outc,src);}
    if(s_eq(strat,"patch-strip-newline")==1){return patch_strip_newline(outc,src);}
    if(s_eq(strat,"regen-from-spec")==1){
        return regen_from_spec(outc,spec,installed,demo,card);
    }
    // unknown strat: fail safe.
    return 0;
}

// Replay a stored trace into tr.
fn si_replay_trace(trace:[]u8, tr:*Cx)void {
    e_raw(tr,trace);
    return;
}

// --- full restructured deliberation (shared by off/memo/rules) ---
// Runs collect + score + apply. Outputs via out-params:
//   sigbuf/siglen, dr, tr, outc, hevals, qn.
// Returns evcode.
fn si_deliberate_full(spec:[]u8, src:[]u8, evtype:[]u8, ev:[]u8, installed:[]u8, demo:[]u8, card:[]u8, cb:[]u8, ra:[]u8, st:[]u8, sigbuf:[]u8, tr:*Cx, outc:*Cx, dr:*DRes, qnb:[]u8) i64 {
    let evcode:i64=1;
    if(s_eq(evtype,"TEST")==1){evcode=2;}
    if(s_eq(evtype,"GEN")==1){evcode=3;}
    si_put64(st,0,0);
    si_put64(st,8,0);
    tr.*.n=0;
    outc.*.n=0;
    dr.*.class=0;
    dr.*.score=0;
    dr.*.strat="halt-unknown";
    // qnb[0..8] will hold qn length; qn bytes follow at qnb[8..]
    si_put64(qnb,0,0);
    let hevals:i64=0;
    let siglen:i64=0;
    if(evcode==3){
        si_rec(cb,ra,st,"GENFAIL",10,"gen-emitted-sentinel");
        dr.*.class=6;
        dr.*.score=10;
        dr.*.strat="halt-genfail";
        t_ev(tr,"GENFAIL",10,"gen-emitted-sentinel");
        e_raw(outc,src);
        hevals=1;
        siglen=si_sigwrite(cb,ra,st,sigbuf);
    } else if(evcode==2){
        let bip:*u8=_zag_malloc(32) as *u8;
        let bi:[]u8=bip[0..32];
        let branch:i64=dct_full(src,ev,spec,installed,demo,card,cb,ra,st,bi,dr);
        siglen=si_sigwrite(cb,ra,st,sigbuf);
        hevals=dct_score(cb,ra,st,tr,dr);
        dr.*.strat=dct_apply(branch,bi,src,spec,installed,demo,card,outc,tr);
    } else {
        let qn:[]u8=dcc_full(src,ev,cb,ra,st);
        siglen=si_sigwrite(cb,ra,st,sigbuf);
        hevals=dcc_score(cb,ra,st,tr,dr);
        dr.*.strat=dcc_apply(dr.*.class,src,qn,outc);
        // stash qn for the fast path
        si_put64(qnb,0,qn.len);
        let k:i64=0;
        while(k<qn.len){qnb[8+k]=qn[k];k=k+1;}
    }
    si_put64(qnb,16,siglen);
    si_put64(qnb,24,hevals);
    return evcode;
}

// sig_only for the 2c fast-path lookup. Returns siglen in sigbuf.
fn si_sig_only(spec:[]u8, src:[]u8, evtype:[]u8, ev:[]u8, installed:[]u8, demo:[]u8, card:[]u8, sigbuf:[]u8) i64 {
    if(s_eq(evtype,"GEN")==1){
        return si_emit_one(sigbuf,0,"GENFAIL",10,"gen-emitted-sentinel");
    }
    if(s_eq(evtype,"TEST")==1){
        return dct_sig(src,ev,spec,installed,demo,card,sigbuf);
    }
    return dcc_sig(src,ev,sigbuf);
}

// --- do_diagnose2: SI diagnose orchestrator ---
fn do_diagnose2()void {
    let spec:[]u8=_zag_arg(2);
    let src:[]u8=_zag_arg(3);
    let evtype:[]u8=_zag_arg(4);
    let ev:[]u8=_zag_arg(5);
    let installed:[]u8=_zag_arg(6);
    let demo:[]u8=_zag_arg(7);
    let card:[]u8=_zag_arg(8);
    let statepath:[]u8=_zag_arg(9);
    let mech:[]u8=_zag_arg(10);
    let itemid:[]u8=_zag_arg(11);

    let use_memo:i64=0;
    let use_rules:i64=0;
    if(s_eq(mech,"memo")==1){use_memo=1;}
    if(s_eq(mech,"rules")==1){use_rules=1;}
    if(s_eq(mech,"both")==1){use_memo=1;use_rules=1;}

    let evcode:i64=1;
    if(s_eq(evtype,"TEST")==1){evcode=2;}
    if(s_eq(evtype,"GEN")==1){evcode=3;}

    let tc:Cx=cx_new(8192);
    let tr:*Cx=&tc;
    let oc:Cx=cx_new(src.len+65536);
    let outc:*Cx=&oc;
    let d:DRes=DRes{};
    let dr:*DRes=&d;

    let cbp:*u8=_zag_malloc(8192) as *u8;
    let cb:[]u8=cbp[0..8192];
    let rap:*u8=_zag_malloc(16384) as *u8;
    let ra:[]u8=rap[0..16384];
    let stp:*u8=_zag_malloc(16) as *u8;
    let st:[]u8=stp[0..16];
    let sigbp:*u8=_zag_malloc(8192) as *u8;
    let sigbuf:[]u8=sigbp[0..8192];
    let qnbp:*u8=_zag_malloc(256) as *u8;
    let qnb:[]u8=qnbp[0..256];

    let mdp:*u8=_zag_malloc(524288) as *u8;
    let md:[]u8=mdp[0..524288];
    let byp:*u8=_zag_malloc(4194304) as *u8;
    let by:[]u8=byp[0..4194304];
    let sstp:*u8=_zag_malloc(16) as *u8;
    let sst:[]u8=sstp[0..16];
    if(use_memo==1){si_load(statepath,md,by,sst);}
    if(use_rules==1){si_load(statepath,md,by,sst);}

    let spechash:i64=si_fnv(spec);
    // Memo key uses the item id when the driver provides it (spec strings are
    // not unique across battery items); otherwise falls back to the spec hash.
    let itemhash:i64=spechash;
    if(itemid.len>0){itemhash=si_fnv(itemid);}

    let si_hit:i64=0;
    let si_mm:i64=0;
    let si_uninst:i64=0;
    let si_hevals:i64=0;
    let si_rulefired:i64=0;
    let si_shadow:i64=0;
    let si_fast:i64=0;
    let si_defect:i64=0;
    let si_diagcalls:i64=1;

    let siglen:i64=0;
    let sig:[]u8="";

    if(use_memo==1){
        // 2b: full deliberation (doubles as shadow on hits).
        let ec:i64=si_deliberate_full(spec,src,evtype,ev,installed,demo,card,cb,ra,st,sigbuf,tr,outc,dr,qnb);
        siglen=si_get64(qnb,16);
        sig=sigbuf[0..siglen];
        si_hevals=si_get64(qnb,24);
        let r:i64=si_find_memo(md,by,sst,itemhash,evcode,sig);
        if(r>=0){
            // hit: byte-compare fresh vs cached.
            let cc:i64=si_mget(md,r,5);
            let cs:i64=si_mget(md,r,6);
            let so:i64=si_mget(md,r,7);
            let sl:i64=si_mget(md,r,8);
            let cstrat:[]u8=by[so..so+sl];
            let to:i64=si_mget(md,r,9);
            let tl:i64=si_mget(md,r,10);
            let ctrace:[]u8=by[to..to+tl];
            let qo:i64=si_mget(md,r,11);
            let ql:i64=si_mget(md,r,12);
            let csrc:[]u8=by[qo..qo+ql];
            let trb:[]u8=tr.*.b[0..tr.*.n];
            let ob:[]u8=outc.*.b[0..outc.*.n];
            let match:i64=1;
            if(cc!=dr.*.class){match=0;}
            if(cs!=dr.*.score){match=0;}
            if(s_eq(cstrat,dr.*.strat)==0){match=0;}
            if(s_eq(ctrace,trb)==0){match=0;}
            if(s_eq(csrc,ob)==0){match=0;}
            if(match==1){
                si_hit=1;
                // output cached (byte-identical to fresh by verification).
                dr.*.class=cc;
                dr.*.score=cs;
                dr.*.strat=cstrat;
                tr.*.n=0;
                e_raw(tr,ctrace);
                outc.*.n=0;
                e_raw(outc,csrc);
            } else {
                si_mm=1;
                si_defect=1;
                si_del_rec(md,sst,r);
                // fall through with fresh result already in dr/tr/outc.
            }
        } else {
            // miss: store.
            let trb2:[]u8=tr.*.b[0..tr.*.n];
            let ob2:[]u8=outc.*.b[0..outc.*.n];
            si_add_rec(md,by,sst,1,itemhash,evcode,sig,dr.*.class,dr.*.score,dr.*.strat,trb2,ob2,1,0);
        }
        // "both": also observe for rules.
        if(use_rules==1){
            si_rule_observe(md,by,sst,evcode,sig,dr,tr,outc);
        }
    } else if(use_rules==1){
        // 2c: sig_only -> rule lookup.
        siglen=si_sig_only(spec,src,evtype,ev,installed,demo,card,sigbuf);
        sig=sigbuf[0..siglen];
        let r:i64=si_find_rule(md,by,sst,evcode,sig);
        let installed_rule:i64=0;
        if(r>=0){
            if(si_mget(md,r,13)>=3){installed_rule=1;}
        }
        if(installed_rule==1){
            si_rulefired=1;
            let apps:i64=si_mget(md,r,14);
            if(apps<5){
                // shadow: full deliberation + byte-compare.
                si_shadow=1;
                let ec2:i64=si_deliberate_full(spec,src,evtype,ev,installed,demo,card,cb,ra,st,sigbuf,tr,outc,dr,qnb);
                si_hevals=si_get64(qnb,24);
                let cc2:i64=si_mget(md,r,5);
                let so2:i64=si_mget(md,r,7);
                let sl2:i64=si_mget(md,r,8);
                let cstrat2:[]u8=by[so2..so2+sl2];
                let to2:i64=si_mget(md,r,9);
                let tl2:i64=si_mget(md,r,10);
                let ctrace2:[]u8=by[to2..to2+tl2];
                let trb3:[]u8=tr.*.b[0..tr.*.n];
                let match2:i64=1;
                if(cc2!=dr.*.class){match2=0;}
                if(s_eq(cstrat2,dr.*.strat)==0){match2=0;}
                if(s_eq(ctrace2,trb3)==0){match2=0;}
                if(match2==1){
                    si_mput(md,r,14,apps+1);
                } else {
                    si_mm=1;
                    si_uninst=1;
                    si_defect=1;
                    si_del_rec(md,sst,r);
                }
                // use the fresh result (== rule's on match).
            } else {
                // fast path: apply stored strategy directly, replay trace.
                si_fast=1;
                let cc3:i64=si_mget(md,r,5);
                let cs3:i64=si_mget(md,r,6);
                let so3:i64=si_mget(md,r,7);
                let sl3:i64=si_mget(md,r,8);
                let cstrat3:[]u8=by[so3..so3+sl3];
                let to3:i64=si_mget(md,r,9);
                let tl3:i64=si_mget(md,r,10);
                let ctrace3:[]u8=by[to3..to3+tl3];
                let qn:[]u8=ev_name(ev);
                tr.*.n=0;
                outc.*.n=0;
                // dummy bi for si_apply_strat (unused for these strats).
                let bip2:*u8=_zag_malloc(32) as *u8;
                let bi2:[]u8=bip2[0..32];
                let ok:i64=si_apply_strat(cstrat3,src,spec,installed,demo,card,qn,0,bi2,outc);
                if(ok==1){
                    dr.*.class=cc3;
                    dr.*.score=cs3;
                    dr.*.strat=cstrat3;
                    si_replay_trace(ctrace3,tr);
                    si_hevals=0;
                    si_mput(md,r,14,apps+1);
                } else {
                    // strategy failed to apply: fall back to full deliberation.
                    si_fast=0;
                    si_mm=1;
                    si_uninst=1;
                    si_defect=1;
                    si_del_rec(md,sst,r);
                    let ec3:i64=si_deliberate_full(spec,src,evtype,ev,installed,demo,card,cb,ra,st,sigbuf,tr,outc,dr,qnb);
                    si_hevals=si_get64(qnb,24);
                    siglen=si_get64(qnb,16);
                    sig=sigbuf[0..siglen];
                    si_rule_observe(md,by,sst,evcode,sig,dr,tr,outc);
                }
            }
        } else {
            // no installed rule: full deliberation + observe.
            let ec4:i64=si_deliberate_full(spec,src,evtype,ev,installed,demo,card,cb,ra,st,sigbuf,tr,outc,dr,qnb);
            siglen=si_get64(qnb,16);
            sig=sigbuf[0..siglen];
            si_hevals=si_get64(qnb,24);
            si_rule_observe(md,by,sst,evcode,sig,dr,tr,outc);
        }
    } else {
        // off: restructured full deliberation, no state.
        let ec5:i64=si_deliberate_full(spec,src,evtype,ev,installed,demo,card,cb,ra,st,sigbuf,tr,outc,dr,qnb);
        si_hevals=si_get64(qnb,24);
    }

    // thrash / cycle guards (identical to baseline; apply post-SI).
    let prev:[]u8=env_get(ev,"PREV");
    let prev_class:[]u8="";
    let sl:i64=s_find(prev,"/",0);
    if(sl>0){prev_class=prev[0..sl];}
    let is_stalled:i64=0;
    if(s_eq(env_get(ev,"STALLED"),"1")==1){is_stalled=1;}
    let is_cycle:i64=0;
    if(s_eq(env_get(ev,"CYCLE"),"1")==1){is_cycle=1;}
    if(is_cycle==1){
        if(s_eq(dr.*.strat,"halt-genfail")==0){
            t_ev(tr,"CYCLE",99,"source-hash-seen-before");
            dr.*.strat="halt-cycle";
            outc.*.n=0;
            e_raw(outc,src);
        }
    } else {
        if(is_stalled==1){
            if(s_eq(prev_class,class_name(dr.*.class))==1){
                t_ev(tr,"THRASH",99,"same-class-no-source-change");
                dr.*.strat="halt-thrash";
                outc.*.n=0;
                e_raw(outc,src);
            }
        }
    }

    if(use_memo==1){si_save(statepath,md,by,sst);}
    if(use_rules==1){si_save(statepath,md,by,sst);}

    _zag_print("DIAG class=");
    _zag_print(class_name(dr.*.class));
    _zag_print(" strategy=");
    _zag_print(dr.*.strat);
    _zag_print(" score=");
    _zag_print(_zag_i64_to_str(dr.*.score));
    _zag_print(" trace=");
    let trb:[]u8=tr.*.b[0..tr.*.n];
    _zag_print(trb);
    _zag_print("\n");
    _zag_print("SI mech=");
    _zag_print(mech);
    _zag_print(" hit=");
    _zag_print(_zag_i64_to_str(si_hit));
    _zag_print(" mm=");
    _zag_print(_zag_i64_to_str(si_mm));
    _zag_print(" uninst=");
    _zag_print(_zag_i64_to_str(si_uninst));
    _zag_print(" hevals=");
    _zag_print(_zag_i64_to_str(si_hevals));
    _zag_print(" rule=");
    _zag_print(_zag_i64_to_str(si_rulefired));
    _zag_print(" shadow=");
    _zag_print(_zag_i64_to_str(si_shadow));
    _zag_print(" fast=");
    _zag_print(_zag_i64_to_str(si_fast));
    _zag_print(" defect=");
    _zag_print(_zag_i64_to_str(si_defect));
    _zag_print(" diagcalls=");
    _zag_print(_zag_i64_to_str(si_diagcalls));
    _zag_print("\n@@SRC@@\n");
    let ob:[]u8=outc.*.b[0..outc.*.n];
    _zag_print(ob);
    if(ob.len>0){
        if(ob[ob.len-1]!=10){_zag_print("\n");}
    }
    _zag_print("@@END@@\n");
    return;
}

// Rule observation: update or add a rule candidate from a full deliberation.
fn si_rule_observe(md:[]u8, by:[]u8, sst:[]u8, evcode:i64, sig:[]u8, dr:*DRes, tr:*Cx, outc:*Cx)void {
    let r:i64=si_find_rule(md,by,sst,evcode,sig);
    let trb:[]u8=tr.*.b[0..tr.*.n];
    if(r>=0){
        let cc:i64=si_mget(md,r,5);
        let so:i64=si_mget(md,r,7);
        let sl:i64=si_mget(md,r,8);
        let cstrat:[]u8=by[so..so+sl];
        if(cc==dr.*.class){
            if(s_eq(cstrat,dr.*.strat)==1){
                si_mput(md,r,13,si_mget(md,r,13)+1);
                return;
            }
        }
        // mapping changed: reset count, update stored mapping.
        // (sig unchanged; update class/strat/trace in place by delete+add.)
        si_del_rec(md,sst,r);
        let ob:[]u8=outc.*.b[0..outc.*.n];
        si_add_rec(md,by,sst,2,0,evcode,sig,dr.*.class,dr.*.score,dr.*.strat,trb,ob,1,0);
        return;
    }
    let ob2:[]u8=outc.*.b[0..outc.*.n];
    si_add_rec(md,by,sst,2,0,evcode,sig,dr.*.class,dr.*.score,dr.*.strat,trb,ob2,1,0);
    return;
}

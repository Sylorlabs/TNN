// kb_install.zag — deliberate install act for the coding knowledge base.
// Pure Zag, zero RNG. Reads data/entries.txt, validates every record,
// serializes a deterministic kb.dat, prints entry count + FNV-1a digest.
// Usage: kb_install <entries.txt> <kb.dat>
// Reruns are byte-identical by construction (fixed input -> fixed bytes).

fn s_eq(a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn put64(b:[]u8, o:i64, v:i64)void {
    let i:i64=0;
    while(i<8){
        let sh:i64=i*8;
        b[o+i]=((v>>sh)&255) as u8;
        i=i+1;
    }
    return;
}

fn get64(b:[]u8, o:i64)i64 {
    let v:i64=0;
    let k:i64=0;
    while(k<8){
        v=v|(((b[o+k] as i64)&255)<<(k*8));
        k=k+1;
    }
    return v;
}

fn fnv1a(data:[]u8)i64 {
    let h:i64=-3750763034362895579;
    let p:i64=1099511628211;
    let i:i64=0;
    while(i<data.len){
        h=h^(data[i] as i64);
        h=h*p;
        i=i+1;
    }
    return h;
}

fn print_hex(v:i64)void {
    let digits:[]u8="0123456789abcdef";
    let mp:*u8=_zag_malloc(17) as *u8;
    let o:[]u8=mp[0..16];
    let k:i64=0;
    while(k<16){
        let sh:i64=(15-k)*4;
        let nib:i64=(v>>sh)&15;
        o[k]=digits[nib];
        k=k+1;
    }
    _zag_print(o);
    return;
}

fn path_cstr(s:[]u8)*u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let i:i64=0;
    while(i<s.len){
        p[i]=s[i];
        i=i+1;
    }
    p[s.len]=0;
    return p;
}

fn read_all(path:[]u8, mem:*u8, cap:i64)i64 {
    let pp:*u8=path_cstr(path);
    let fd:i64=_zag_raw_syscall(2, pp as i64, 0, 0, 0, 0, 0);
    if(fd<0){return -1;}
    let total:i64=0;
    while(1==1){
        if(total>=cap){break;}
        let want:i64=cap-total;
        if(want>65536){want=65536;}
        let r:i64=_zag_raw_syscall(0, fd, (mem as i64)+total, want, 0, 0, 0);
        if(r<=0){break;}
        total=total+r;
    }
    let c:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

fn write_all(path:[]u8, mem:*u8, n:i64)i64 {
    let pp:*u8=path_cstr(path);
    let fd:i64=_zag_raw_syscall(2, pp as i64, 577, 420, 0, 0, 0);
    if(fd<0){return -1;}
    let done:i64=0;
    while(done<n){
        let w:i64=_zag_raw_syscall(1, fd, (mem as i64)+done, n-done, 0, 0, 0);
        if(w<=0){break;}
        done=done+w;
    }
    let c:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return done;
}

fn split_lines(buf:[]u8, n:i64, tab:[]u8, maxl:i64)i64 {
    let lc:i64=0;
    let st:i64=0;
    let i:i64=0;
    while(i<n){
        if(buf[i]==10){
            if(lc<maxl){
                put64(tab,lc*16,st);
                put64(tab,lc*16+8,i-st);
                lc=lc+1;
            }
            st=i+1;
        }
        i=i+1;
    }
    if(st<n){
        if(lc<maxl){
            put64(tab,lc*16,st);
            put64(tab,lc*16+8,n-st);
            lc=lc+1;
        }
    }
    return lc;
}

// entry table: 8 u64s per entry =
// id_off,id_len, t_off,t_len, k_off,k_len, b_off,b_len (offsets into inb/bodyb)
fn et_set(tab:[]u8, e:i64, f:i64, v:i64)void {
    put64(tab,e*64+f*8,v);
    return;
}

fn et_get(tab:[]u8, e:i64, f:i64)i64 {
    return get64(tab,e*64+f*8);
}

fn main()void {
    let in_path:[]u8=_zag_arg(1);
    let out_path:[]u8=_zag_arg(2);
    let imp:*u8=_zag_malloc(1048576) as *u8;
    let inb:[]u8=imp[0..1048576];
    let inn:i64=read_all(in_path, imp, 1048576);
    if(inn<0){
        _zag_print("KB-INSTALL-FAIL: cannot read entries file\n");
        return;
    }
    let ltabp:*u8=_zag_malloc(65536) as *u8;
    let ltab:[]u8=ltabp[0..65536];
    let lc:i64=split_lines(inb, inn, ltab, 4096);

    let bodyp:*u8=_zag_malloc(1048576) as *u8;
    let bodyb:[]u8=bodyp[0..1048576];
    let bpos:i64=0;

    let etap:*u8=_zag_malloc(16384) as *u8;
    let etab:[]u8=etap[0..16384];
    let ec:i64=0;

    let li:i64=0;
    let state:i64=0;
    let fail:i64=0;
    while(li<lc){
        let ls:i64=get64(ltab,li*16);
        let ln:i64=get64(ltab,li*16+8);
        let line:[]u8=inb[ls..ls+ln];
        let st:i64=state;
        if(st==0){
            if(ln==0){fail=1;}
            if(fail==0){
                if(line[0]!=64){fail=1;}
            }
            if(fail==0){
                if(s_eq(line,"@end")==1){fail=1;}
            }
            if(fail==0){
                // uniqueness vs prior ids
                let u:i64=0;
                while(u<ec){
                    let ps:i64=et_get(etab,u,0);
                    let pl:i64=et_get(etab,u,1);
                    let prev:[]u8=inb[ps..ps+pl];
                    let cur:[]u8=inb[ls+1..ls+ln];
                    if(s_eq(prev,cur)==1){fail=1;}
                    u=u+1;
                }
            }
            if(fail==0){
                et_set(etab,ec,0,ls+1);
                et_set(etab,ec,1,ln-1);
                et_set(etab,ec,6,bpos);
                state=1;
            }
        }
        if(st==1){
            if(ln<3){fail=1;}
            if(fail==0){
                if(line[0]!=84){fail=1;}
            }
            if(fail==0){
                if(line[1]!=58){fail=1;}
            }
            if(fail==0){
                et_set(etab,ec,2,ls+2);
                et_set(etab,ec,3,ln-2);
                state=2;
            }
        }
        if(st==2){
            if(ln<3){fail=1;}
            if(fail==0){
                if(line[0]!=75){fail=1;}
            }
            if(fail==0){
                if(line[1]!=58){fail=1;}
            }
            if(fail==0){
                et_set(etab,ec,4,ls+2);
                et_set(etab,ec,5,ln-2);
                state=3;
            }
        }
        if(st==3){
            if(s_eq(line,"@end")==1){
                let blen:i64=bpos-et_get(etab,ec,6);
                if(blen==0){fail=1;}
                if(fail==0){
                    et_set(etab,ec,7,blen);
                    ec=ec+1;
                    state=0;
                }
            } else {
                let bi:i64=0;
                while(bi<ln){
                    bodyb[bpos]=line[bi];
                    bpos=bpos+1;
                    bi=bi+1;
                }
                bodyb[bpos]=10;
                bpos=bpos+1;
            }
        }
        if(fail==1){break;}
        li=li+1;
    }
    if(fail==1){
        _zag_print("KB-INSTALL-FAIL: malformed entries file\n");
        return;
    }
    if(state!=0){
        _zag_print("KB-INSTALL-FAIL: truncated record\n");
        return;
    }
    // serialize
    let omp:*u8=_zag_malloc(1048576) as *u8;
    let out:[]u8=omp[0..1048576];
    let pos:i64=0;
    let magic:[]u8="KB01\n";
    let mi:i64=0;
    while(mi<magic.len){
        out[pos]=magic[mi];
        pos=pos+1;
        mi=mi+1;
    }
    put64(out,pos,ec);
    pos=pos+8;
    let e:i64=0;
    while(e<ec){
        let f:i64=0;
        while(f<4){
            let fo:i64=et_get(etab,e,f*2);
            let fl:i64=et_get(etab,e,f*2+1);
            put64(out,pos,fl);
            pos=pos+8;
            let src:[]u8=inb;
            let base:i64=0;
            if(f==3){
                src=bodyb;
            }
            let bi2:i64=0;
            while(bi2<fl){
                out[pos]=src[fo+bi2];
                pos=pos+1;
                bi2=bi2+1;
            }
            f=f+1;
        }
        e=e+1;
    }
    let dg:i64=fnv1a(out[0..pos]);
    let w:i64=write_all(out_path, omp, pos);
    if(w!=pos){
        _zag_print("KB-INSTALL-FAIL: short write\n");
        return;
    }
    _zag_print("KB-INSTALL entries=");
    let t:[]u8=_zag_i64_to_str(ec);
    _zag_print(t);
    _zag_print(" digest=");
    print_hex(dg);
    _zag_print("\n");
    // ---- SI (arm 2a): inverted index keyword -> entry list, deterministic.
    // kb.dat above is byte-identical to kb_install.zag's output; the index
    // is a separate artifact. Term splitting mirrors entry_score in
    // kb_main.zag exactly (comma split, space trim).
    let idx_path:[]u8=_zag_arg(3);
    if(idx_path.len==0){
        _zag_print("KB-INSTALL-FAIL: si index path required as argv 3\n");
        return;
    }
    let ttabp:*u8=_zag_malloc(32768) as *u8;
    let ttab:[]u8=ttabp[0..32768];
    let earp:*u8=_zag_malloc(2097152) as *u8;
    let ear:[]u8=earp[0..2097152];
    let nt:i64=0;
    let ncmp:i64=0;
    let e2:i64=0;
    while(e2<ec){
        let koff:i64=et_get(etab,e2,4);
        let klen:i64=et_get(etab,e2,5);
        let kw:[]u8=inb[koff..koff+klen];
        let ts:i64=0;
        while(ts<kw.len){
            let te:i64=ts;
            while(te<kw.len){
                if(kw[te]==44){break;}
                te=te+1;
            }
            let ta:i64=ts;
            let tb:i64=te;
            while(ta<tb){
                if(kw[ta]!=32){break;}
                ta=ta+1;
            }
            while(tb>ta){
                if(kw[tb-1]!=32){break;}
                tb=tb-1;
            }
            if(tb>ta){
                let toff:i64=koff+ta;
                let tlen:i64=tb-ta;
                let fi:i64=-1;
                let q:i64=0;
                while(q<nt){
                    ncmp=ncmp+1;
                    let eo:i64=get64(ttab,q*32);
                    let el:i64=get64(ttab,q*32+8);
                    if(el==tlen){
                        if(s_eq(inb[eo..eo+el],inb[toff..toff+tlen])==1){fi=q;}
                    }
                    if(fi>=0){break;}
                    q=q+1;
                }
                if(fi<0){
                    if(nt>=1024){
                        _zag_print("KB-INSTALL-FAIL: too many distinct terms\n");
                        return;
                    }
                    fi=nt;
                    put64(ttab,fi*32,toff);
                    put64(ttab,fi*32+8,tlen);
                    put64(ttab,fi*32+24,0);
                    nt=nt+1;
                }
                let lc3:i64=get64(ttab,fi*32+24);
                let dup:i64=0;
                if(lc3>0){
                    if(get64(ear,fi*2048+(lc3-1)*8)==e2){dup=1;}
                }
                if(dup==0){
                    put64(ear,fi*2048+lc3*8,e2);
                    put64(ttab,fi*32+24,lc3+1);
                }
            }
            ts=te+1;
        }
        e2=e2+1;
    }
    let iop:*u8=_zag_malloc(1048576) as *u8;
    let iob:[]u8=iop[0..1048576];
    let ipos:i64=0;
    let imgm:[]u8="KBIDX1\n";
    let mi2:i64=0;
    while(mi2<imgm.len){
        iob[ipos]=imgm[mi2];
        ipos=ipos+1;
        mi2=mi2+1;
    }
    put64(iob,ipos,nt);
    ipos=ipos+8;
    let ti:i64=0;
    while(ti<nt){
        let to2:i64=get64(ttab,ti*32);
        let tl2:i64=get64(ttab,ti*32+8);
        let lc4:i64=get64(ttab,ti*32+24);
        put64(iob,ipos,tl2);
        ipos=ipos+8;
        let bi3:i64=0;
        while(bi3<tl2){
            iob[ipos]=inb[to2+bi3];
            ipos=ipos+1;
            bi3=bi3+1;
        }
        put64(iob,ipos,lc4);
        ipos=ipos+8;
        let ei3:i64=0;
        while(ei3<lc4){
            put64(iob,ipos,get64(ear,ti*2048+ei3*8));
            ipos=ipos+8;
            ei3=ei3+1;
        }
        ti=ti+1;
    }
    let w2:i64=write_all(idx_path, iop, ipos);
    if(w2!=ipos){
        _zag_print("KB-INSTALL-FAIL: short index write\n");
        return;
    }
    let assoc:i64=0;
    let ai:i64=0;
    while(ai<nt){
        assoc=assoc+get64(ttab,ai*32+24);
        ai=ai+1;
    }
    _zag_print("KB-INDEX terms=");
    let t2:[]u8=_zag_i64_to_str(nt);
    _zag_print(t2);
    _zag_print(" assoc=");
    let t3:[]u8=_zag_i64_to_str(assoc);
    _zag_print(t3);
    _zag_print(" bytes=");
    let t4:[]u8=_zag_i64_to_str(ipos);
    _zag_print(t4);
    _zag_print(" buildops=");
    let t5:[]u8=_zag_i64_to_str(ncmp);
    _zag_print(t5);
    _zag_print("\n");
    return;
}

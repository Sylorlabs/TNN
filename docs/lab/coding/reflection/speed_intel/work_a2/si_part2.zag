
// --- persistent state: memo + rule records ---
// Metadata = 128 bytes/record (16 u64s):
//   0 kind(1=memo,2=rule) 1 spechash 2 evtype(1=COMPILE,2=TEST,3=GEN)
//   3 sig_off 4 sig_len 5 class 6 score 7 strat_off 8 strat_len
//   9 trace_off 10 trace_len 11 src_off 12 src_len 13 count 14 apps 15 unused
// Variable bytes live in the bytes arena. sst[0]=nrec, sst[8]=bytes bump.
fn si_mget(md:[]u8, r:i64, f:i64)i64 {
    return si_get64(md,r*128+f*8);
}
fn si_mput(md:[]u8, r:i64, f:i64, v:i64)void {
    si_put64(md,r*128+f*8,v);
    return;
}

// Load state file. Returns 0 ok (absent file -> empty state), -1 corrupt.
fn si_load(path:[]u8, md:[]u8, by:[]u8, sst:[]u8)i64 {
    si_put64(sst,0,0);
    si_put64(sst,8,0);
    if(path.len==0){return 0;}
    let fbp:*u8=_zag_malloc(4194304) as *u8;
    let fb:[]u8=fbp[0..4194304];
    let n:i64=si_read_all(path,fbp,4194304);
    if(n<0){return 0;}
    if(n<14){return -1;}
    if(s_eq(fb[0..6],"SIST1\n")==0){return -1;}
    let nrec:i64=si_get64(fb,6);
    let pos:i64=14;
    let r:i64=0;
    let bump:i64=0;
    while(r<nrec){
        if(pos+32>n){return -1;}
        let kind:i64=si_get64(fb,pos);pos=pos+8;
        let sh:i64=si_get64(fb,pos);pos=pos+8;
        let et:i64=si_get64(fb,pos);pos=pos+8;
        let siglen:i64=si_get64(fb,pos);pos=pos+8;
        if(siglen<0){return -1;}
        if(pos+siglen>n){return -1;}
        let sigoff:i64=bump;
        let k:i64=0;
        while(k<siglen){by[bump]=fb[pos+k];bump=bump+1;k=k+1;}
        pos=pos+siglen;
        if(pos+16>n){return -1;}
        let class:i64=si_get64(fb,pos);pos=pos+8;
        let score:i64=si_get64(fb,pos);pos=pos+8;
        let stratlen:i64=si_get64(fb,pos);pos=pos+8;
        if(stratlen<0){return -1;}
        if(pos+stratlen>n){return -1;}
        let stratoff:i64=bump;
        k=0;
        while(k<stratlen){by[bump]=fb[pos+k];bump=bump+1;k=k+1;}
        pos=pos+stratlen;
        let tracelen:i64=si_get64(fb,pos);pos=pos+8;
        if(tracelen<0){return -1;}
        if(pos+tracelen>n){return -1;}
        let traceoff:i64=bump;
        k=0;
        while(k<tracelen){by[bump]=fb[pos+k];bump=bump+1;k=k+1;}
        pos=pos+tracelen;
        let srclen:i64=si_get64(fb,pos);pos=pos+8;
        if(srclen<0){return -1;}
        if(pos+srclen>n){return -1;}
        let srcoff:i64=bump;
        k=0;
        while(k<srclen){by[bump]=fb[pos+k];bump=bump+1;k=k+1;}
        pos=pos+srclen;
        if(pos+16>n){return -1;}
        let count:i64=si_get64(fb,pos);pos=pos+8;
        let apps:i64=si_get64(fb,pos);pos=pos+8;
        si_mput(md,r,0,kind);
        si_mput(md,r,1,sh);
        si_mput(md,r,2,et);
        si_mput(md,r,3,sigoff);
        si_mput(md,r,4,siglen);
        si_mput(md,r,5,class);
        si_mput(md,r,6,score);
        si_mput(md,r,7,stratoff);
        si_mput(md,r,8,stratlen);
        si_mput(md,r,9,traceoff);
        si_mput(md,r,10,tracelen);
        si_mput(md,r,11,srcoff);
        si_mput(md,r,12,srclen);
        si_mput(md,r,13,count);
        si_mput(md,r,14,apps);
        r=r+1;
    }
    si_put64(sst,0,nrec);
    si_put64(sst,8,bump);
    return 0;
}

// Save state file. Returns 0 ok, -1 fail.
fn si_save(path:[]u8, md:[]u8, by:[]u8, sst:[]u8)i64 {
    if(path.len==0){return 0;}
    let nrec:i64=si_get64(sst,0);
    let obp:*u8=_zag_malloc(4194304) as *u8;
    let ob:[]u8=obp[0..4194304];
    let pos:i64=0;
    let mg:[]u8="SIST1\n";
    let k:i64=0;
    while(k<6){ob[pos]=mg[k];pos=pos+1;k=k+1;}
    si_put64(ob,pos,nrec);pos=pos+8;
    let r:i64=0;
    while(r<nrec){
        si_put64(ob,pos,si_mget(md,r,0));pos=pos+8;
        si_put64(ob,pos,si_mget(md,r,1));pos=pos+8;
        si_put64(ob,pos,si_mget(md,r,2));pos=pos+8;
        let sl:i64=si_mget(md,r,4);
        si_put64(ob,pos,sl);pos=pos+8;
        let so:i64=si_mget(md,r,3);
        k=0;
        while(k<sl){ob[pos]=by[so+k];pos=pos+1;k=k+1;}
        si_put64(ob,pos,si_mget(md,r,5));pos=pos+8;
        si_put64(ob,pos,si_mget(md,r,6));pos=pos+8;
        let tl:i64=si_mget(md,r,8);
        si_put64(ob,pos,tl);pos=pos+8;
        let to:i64=si_mget(md,r,7);
        k=0;
        while(k<tl){ob[pos]=by[to+k];pos=pos+1;k=k+1;}
        let rl:i64=si_mget(md,r,10);
        si_put64(ob,pos,rl);pos=pos+8;
        let ro:i64=si_mget(md,r,9);
        k=0;
        while(k<rl){ob[pos]=by[ro+k];pos=pos+1;k=k+1;}
        let ql:i64=si_mget(md,r,12);
        si_put64(ob,pos,ql);pos=pos+8;
        let qo:i64=si_mget(md,r,11);
        k=0;
        while(k<ql){ob[pos]=by[qo+k];pos=pos+1;k=k+1;}
        si_put64(ob,pos,si_mget(md,r,13));pos=pos+8;
        si_put64(ob,pos,si_mget(md,r,14));pos=pos+8;
        r=r+1;
    }
    return si_write_all(path,obp,pos);
}

// Find memo record by (spechash, evtype, sig). Returns index or -1.
fn si_find_memo(md:[]u8, by:[]u8, sst:[]u8, sh:i64, et:i64, sig:[]u8)i64 {
    let nrec:i64=si_get64(sst,0);
    let r:i64=0;
    while(r<nrec){
        if(si_mget(md,r,0)==1){
            if(si_mget(md,r,1)==sh){
                if(si_mget(md,r,2)==et){
                    let so:i64=si_mget(md,r,3);
                    let sl:i64=si_mget(md,r,4);
                    if(sl==sig.len){
                        if(s_eq(by[so..so+sl],sig)==1){return r;}
                    }
                }
            }
        }
        r=r+1;
    }
    return -1;
}

// Find rule record by (evtype, sig). Returns index or -1.
fn si_find_rule(md:[]u8, by:[]u8, sst:[]u8, et:i64, sig:[]u8)i64 {
    let nrec:i64=si_get64(sst,0);
    let r:i64=0;
    while(r<nrec){
        if(si_mget(md,r,0)==2){
            if(si_mget(md,r,2)==et){
                let so:i64=si_mget(md,r,3);
                let sl:i64=si_mget(md,r,4);
                if(sl==sig.len){
                    if(s_eq(by[so..so+sl],sig)==1){return r;}
                }
            }
        }
        r=r+1;
    }
    return -1;
}

// Append a record. Returns index.
fn si_add_rec(md:[]u8, by:[]u8, sst:[]u8, kind:i64, sh:i64, et:i64, sig:[]u8, class:i64, score:i64, strat:[]u8, trace:[]u8, src:[]u8, count:i64, apps:i64)i64 {
    let r:i64=si_get64(sst,0);
    let bump:i64=si_get64(sst,8);
    si_mput(md,r,0,kind);
    si_mput(md,r,1,sh);
    si_mput(md,r,2,et);
    si_mput(md,r,3,bump);
    si_mput(md,r,4,sig.len);
    let k:i64=0;
    while(k<sig.len){by[bump]=sig[k];bump=bump+1;k=k+1;}
    si_mput(md,r,5,class);
    si_mput(md,r,6,score);
    si_mput(md,r,7,bump);
    si_mput(md,r,8,strat.len);
    k=0;
    while(k<strat.len){by[bump]=strat[k];bump=bump+1;k=k+1;}
    si_mput(md,r,9,bump);
    si_mput(md,r,10,trace.len);
    k=0;
    while(k<trace.len){by[bump]=trace[k];bump=bump+1;k=k+1;}
    si_mput(md,r,11,bump);
    si_mput(md,r,12,src.len);
    k=0;
    while(k<src.len){by[bump]=src[k];bump=bump+1;k=k+1;}
    si_mput(md,r,13,count);
    si_mput(md,r,14,apps);
    si_put64(sst,0,r+1);
    si_put64(sst,8,bump);
    return r;
}

// Remove record r by swapping with the last.
fn si_del_rec(md:[]u8, sst:[]u8, r:i64)void {
    let nrec:i64=si_get64(sst,0);
    let last:i64=nrec-1;
    if(r!=last){
        let f:i64=0;
        while(f<16){
            si_mput(md,r,f,si_mget(md,last,f));
            f=f+1;
        }
    }
    si_put64(sst,0,last);
    return;
}

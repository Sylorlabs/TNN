### h1 compute the fnv hash digest of a string
// kb-recall family=E-HASH digest=a92e1031d460dbd9
fn main()void {
    let s:[]u8=_zag_arg(1);
    let h:u64=14695981039346656037;
    let i:i64=0;
    while(i<s.len){
        h=h^(s[i] as u64);
        h=h*1099511628211;
        i=i+1;
    }
    let digits:[]u8="0123456789abcdef";
    let p:*u8=_zag_malloc(17) as *u8;
    let o:[]u8=p[0..16];
    let k:i64=0;
    while(k<16){
        let sh:u64=(15-k) as u64;
        let shb:i64=(sh*4) as i64;
        let nib:u64=(h>>shb)&15;
        o[k]=digits[nib as i64];
        k=k+1;
    }
    _zag_print(o);
    _zag_print("\n");
    return;
}

### o1 sort numbers ascending with insertion sort
// kb-recall family=E-SORT digest=a92e1031d460dbd9
fn parse_i64(s:[]u8)i64 {
    let v:i64=0;
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    while(i<s.len){
        let d:i64=(s[i] as i64)-48;
        v=v*10+d;
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}
fn u8_put64(b:[]u8, o:i64, v:i64)void {
    let i:i64=0;
    while(i<8){
        let sh:i64=i*8;
        b[o+i]=((v>>sh)&255) as u8;
        i=i+1;
    }
    return;
}
fn u8_get64(b:[]u8, o:i64)i64 {
    let v:i64=0;
    let i:i64=7;
    while(i>=0){
        v=(v<<8)|((b[o+i] as i64)&255);
        i=i-1;
    }
    return v;
}
fn main()void {
    let n:i64=0;
    let k:i64=1;
    while(1==1){
        let a:[]u8=_zag_arg(k);
        if(a.len==0){break;}
        n=n+1;
        k=k+1;
    }
    let mp:*u8=_zag_malloc(n*8+8) as *u8;
    let b:[]u8=mp[0..n*8];
    k=1;
    let w:i64=0;
    while(1==1){
        let a:[]u8=_zag_arg(k);
        if(a.len==0){break;}
        u8_put64(b,w*8,parse_i64(a));
        w=w+1;
        k=k+1;
    }
    let i:i64=1;
    while(i<n){
        let key:i64=u8_get64(b,i*8);
        let j:i64=i-1;
        while(j>=0){
            if(u8_get64(b,j*8)<=key){break;}
            u8_put64(b,(j+1)*8,u8_get64(b,j*8));
            j=j-1;
        }
        u8_put64(b,(j+1)*8,key);
        i=i+1;
    }
    i=0;
    while(i<n){
        if(i>0){_zag_print(" ");}
        let t:[]u8=_zag_i64_to_str(u8_get64(b,i*8));
        _zag_print(t);
        i=i+1;
    }
    _zag_print("\n");
    return;
}

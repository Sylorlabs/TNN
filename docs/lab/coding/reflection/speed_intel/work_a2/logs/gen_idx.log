        _zag_print("OPEN_FAIL\n");
        return;
    }
    let total:i64=0;
    let bp:*u8=_zag_malloc(65536) as *u8;
    while(1==1){
        let r:i64=_zag_raw_syscall(0, fd, bp as i64, 65536, 0, 0, 0);
        if(r<=0){break;}
        total=total+r;
    }
    let cc:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let t:[]u8=_zag_i64_to_str(total);
    _zag_print(t);
    _zag_print("\n");
    return;
}

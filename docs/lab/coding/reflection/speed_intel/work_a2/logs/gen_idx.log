### w1 write bytes to a file, save content to disk
// kb-recall family=E-FILEWRITE digest=a92e1031d460dbd9
fn main()void {
    let path:[]u8=_zag_arg(1);
    let msg:[]u8=_zag_arg(2);
    let pp:*u8=_zag_malloc(path.len+1) as *u8;
    let i:i64=0;
    while(i<path.len){
        pp[i]=path[i];
        i=i+1;
    }
    pp[path.len]=0;
    let fd:i64=_zag_raw_syscall(2, pp as i64, 577, 420, 0, 0, 0);
    if(fd<0){
        _zag_print("OPEN_FAIL\n");
        return;
    }
    let q:*u8=_zag_malloc(msg.len+1) as *u8;
    let j:i64=0;
    while(j<msg.len){
        q[j]=msg[j];
        j=j+1;
    }
    let w:i64=_zag_raw_syscall(1, fd, q as i64, msg.len, 0, 0, 0);
    let t:[]u8=_zag_i64_to_str(w);
    _zag_print(t);
    _zag_print("\n");
    let c:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return;
}


// --- do_diagnose2: SI diagnose orchestrator ---
fn do_diagnose2()void {
    let spec:[]u8=_zag_arg(2);
    let src:[]u8=_zag_arg(3);
    let evtype:[]u8=_zag_arg(4);
    let ev:[]u8=_zag_arg(5);
    let installed:[]u8=_zag_arg(6);
    let demo:[]u8=_zag_arg(7);
    let card:[]u8=_zag_arg(8);
    let statepath:[]u8=_zag_arg(9);
    let mech:[]u8=_zag_arg(10);
    let itemid:[]u8=_zag_arg(11);

    let use_memo:i64=0;
    let use_rules:i64=0;
    if(s_eq(mech,"memo")==1){use_memo=1;}
    if(s_eq(mech,"rules")==1){use_rules=1;}
    if(s_eq(mech,"both")==1){use_memo=1;use_rules=1;}

    let evcode:i64=1;
    if(s_eq(evtype,"TEST")==1){evcode=2;}
    if(s_eq(evtype,"GEN")==1){evcode=3;}

    let tc:Cx=cx_new(8192);
    let tr:*Cx=&tc;
    let oc:Cx=cx_new(src.len+65536);
    let outc:*Cx=&oc;
    let d:DRes=DRes{};
    let dr:*DRes=&d;

    let cbp:*u8=_zag_malloc(8192) as *u8;
    let cb:[]u8=cbp[0..8192];
    let rap:*u8=_zag_malloc(16384) as *u8;
    let ra:[]u8=rap[0..16384];
    let stp:*u8=_zag_malloc(16) as *u8;
    let st:[]u8=stp[0..16];
    let sigbp:*u8=_zag_malloc(8192) as *u8;
    let sigbuf:[]u8=sigbp[0..8192];
    let qnbp:*u8=_zag_malloc(256) as *u8;
    let qnb:[]u8=qnbp[0..256];

    let mdp:*u8=_zag_malloc(524288) as *u8;
    let md:[]u8=mdp[0..524288];
    let byp:*u8=_zag_malloc(4194304) as *u8;
    let by:[]u8=byp[0..4194304];
    let sstp:*u8=_zag_malloc(16) as *u8;
    let sst:[]u8=sstp[0..16];
    if(use_memo==1){si_load(statepath,md,by,sst);}
    if(use_rules==1){si_load(statepath,md,by,sst);}

    let spechash:i64=si_fnv(spec);
    // Memo key uses the item id when the driver provides it (spec strings are
    // not unique across battery items); otherwise falls back to the spec hash.
    let itemhash:i64=spechash;
    if(itemid.len>0){itemhash=si_fnv(itemid);}

    let si_hit:i64=0;
    let si_mm:i64=0;
    let si_uninst:i64=0;
    let si_hevals:i64=0;
    let si_rulefired:i64=0;
    let si_shadow:i64=0;
    let si_fast:i64=0;
    let si_defect:i64=0;
    let si_diagcalls:i64=1;

    let siglen:i64=0;
    let sig:[]u8="";

    if(use_memo==1){
        // 2b: full deliberation (doubles as shadow on hits).
        let ec:i64=si_deliberate_full(spec,src,evtype,ev,installed,demo,card,cb,ra,st,sigbuf,tr,outc,dr,qnb);
        siglen=si_get64(qnb,16);
        sig=sigbuf[0..siglen];
        si_hevals=si_get64(qnb,24);
        let r:i64=si_find_memo(md,by,sst,itemhash,evcode,sig);
        if(r>=0){
            // hit: byte-compare fresh vs cached.
            let cc:i64=si_mget(md,r,5);
            let cs:i64=si_mget(md,r,6);
            let so:i64=si_mget(md,r,7);
            let sl:i64=si_mget(md,r,8);
            let cstrat:[]u8=by[so..so+sl];
            let to:i64=si_mget(md,r,9);
            let tl:i64=si_mget(md,r,10);
            let ctrace:[]u8=by[to..to+tl];
            let qo:i64=si_mget(md,r,11);
            let ql:i64=si_mget(md,r,12);
            let csrc:[]u8=by[qo..qo+ql];
            let trb:[]u8=tr.*.b[0..tr.*.n];
            let ob:[]u8=outc.*.b[0..outc.*.n];
            let match:i64=1;
            if(cc!=dr.*.class){match=0;}
            if(cs!=dr.*.score){match=0;}
            if(s_eq(cstrat,dr.*.strat)==0){match=0;}
            if(s_eq(ctrace,trb)==0){match=0;}
            if(s_eq(csrc,ob)==0){match=0;}
            if(match==1){
                si_hit=1;
                // output cached (byte-identical to fresh by verification).
                dr.*.class=cc;
                dr.*.score=cs;
                dr.*.strat=cstrat;
                tr.*.n=0;
                e_raw(tr,ctrace);
                outc.*.n=0;
                e_raw(outc,csrc);
            } else {
                si_mm=1;
                si_defect=1;
                si_del_rec(md,sst,r);
                // fall through with fresh result already in dr/tr/outc.
            }
        } else {
            // miss: store.
            let trb2:[]u8=tr.*.b[0..tr.*.n];
            let ob2:[]u8=outc.*.b[0..outc.*.n];
            si_add_rec(md,by,sst,1,itemhash,evcode,sig,dr.*.class,dr.*.score,dr.*.strat,trb2,ob2,1,0);
        }
        // "both": also observe for rules.
        if(use_rules==1){
            si_rule_observe(md,by,sst,evcode,sig,dr,tr,outc);
        }
    } else if(use_rules==1){
        // 2c: sig_only -> rule lookup.
        siglen=si_sig_only(spec,src,evtype,ev,installed,demo,card,sigbuf);
        sig=sigbuf[0..siglen];
        let r:i64=si_find_rule(md,by,sst,evcode,sig);
        let installed_rule:i64=0;
        if(r>=0){
            if(si_mget(md,r,13)>=3){installed_rule=1;}
        }
        if(installed_rule==1){
            si_rulefired=1;
            let apps:i64=si_mget(md,r,14);
            if(apps<5){
                // shadow: full deliberation + byte-compare.
                si_shadow=1;
                let ec2:i64=si_deliberate_full(spec,src,evtype,ev,installed,demo,card,cb,ra,st,sigbuf,tr,outc,dr,qnb);
                si_hevals=si_get64(qnb,24);
                let cc2:i64=si_mget(md,r,5);
                let so2:i64=si_mget(md,r,7);
                let sl2:i64=si_mget(md,r,8);
                let cstrat2:[]u8=by[so2..so2+sl2];
                let to2:i64=si_mget(md,r,9);
                let tl2:i64=si_mget(md,r,10);
                let ctrace2:[]u8=by[to2..to2+tl2];
                let trb3:[]u8=tr.*.b[0..tr.*.n];
                let match2:i64=1;
                if(cc2!=dr.*.class){match2=0;}
                if(s_eq(cstrat2,dr.*.strat)==0){match2=0;}
                if(s_eq(ctrace2,trb3)==0){match2=0;}
                if(match2==1){
                    si_mput(md,r,14,apps+1);
                } else {
                    si_mm=1;
                    si_uninst=1;
                    si_defect=1;
                    si_del_rec(md,sst,r);
                }
                // use the fresh result (== rule's on match).
            } else {
                // fast path: apply stored strategy directly, replay trace.
                si_fast=1;
                let cc3:i64=si_mget(md,r,5);
                let cs3:i64=si_mget(md,r,6);
                let so3:i64=si_mget(md,r,7);
                let sl3:i64=si_mget(md,r,8);
                let cstrat3:[]u8=by[so3..so3+sl3];
                let to3:i64=si_mget(md,r,9);
                let tl3:i64=si_mget(md,r,10);
                let ctrace3:[]u8=by[to3..to3+tl3];
                let qn:[]u8=ev_name(ev);
                tr.*.n=0;
                outc.*.n=0;
                // dummy bi for si_apply_strat (unused for these strats).
                let bip2:*u8=_zag_malloc(32) as *u8;
                let bi2:[]u8=bip2[0..32];
                let ok:i64=si_apply_strat(cstrat3,src,spec,installed,demo,card,qn,0,bi2,outc);
                if(ok==1){
                    dr.*.class=cc3;
                    dr.*.score=cs3;
                    dr.*.strat=cstrat3;
                    si_replay_trace(ctrace3,tr);
                    si_hevals=0;
                    si_mput(md,r,14,apps+1);
                } else {
                    // strategy failed to apply: fall back to full deliberation.
                    si_fast=0;
                    si_mm=1;
                    si_uninst=1;
                    si_defect=1;
                    si_del_rec(md,sst,r);
                    let ec3:i64=si_deliberate_full(spec,src,evtype,ev,installed,demo,card,cb,ra,st,sigbuf,tr,outc,dr,qnb);
                    si_hevals=si_get64(qnb,24);
                    siglen=si_get64(qnb,16);
                    sig=sigbuf[0..siglen];
                    si_rule_observe(md,by,sst,evcode,sig,dr,tr,outc);
                }
            }
        } else {
            // no installed rule: full deliberation + observe.
            let ec4:i64=si_deliberate_full(spec,src,evtype,ev,installed,demo,card,cb,ra,st,sigbuf,tr,outc,dr,qnb);
            siglen=si_get64(qnb,16);
            sig=sigbuf[0..siglen];
            si_hevals=si_get64(qnb,24);
            si_rule_observe(md,by,sst,evcode,sig,dr,tr,outc);
        }
    } else {
        // off: restructured full deliberation, no state.
        let ec5:i64=si_deliberate_full(spec,src,evtype,ev,installed,demo,card,cb,ra,st,sigbuf,tr,outc,dr,qnb);
        si_hevals=si_get64(qnb,24);
    }

    // thrash / cycle guards (identical to baseline; apply post-SI).
    let prev:[]u8=env_get(ev,"PREV");
    let prev_class:[]u8="";
    let sl:i64=s_find(prev,"/",0);
    if(sl>0){prev_class=prev[0..sl];}
    let is_stalled:i64=0;
    if(s_eq(env_get(ev,"STALLED"),"1")==1){is_stalled=1;}
    let is_cycle:i64=0;
    if(s_eq(env_get(ev,"CYCLE"),"1")==1){is_cycle=1;}
    if(is_cycle==1){
        if(s_eq(dr.*.strat,"halt-genfail")==0){
            t_ev(tr,"CYCLE",99,"source-hash-seen-before");
            dr.*.strat="halt-cycle";
            outc.*.n=0;
            e_raw(outc,src);
        }
    } else {
        if(is_stalled==1){
            if(s_eq(prev_class,class_name(dr.*.class))==1){
                t_ev(tr,"THRASH",99,"same-class-no-source-change");
                dr.*.strat="halt-thrash";
                outc.*.n=0;
                e_raw(outc,src);
            }
        }
    }

    if(use_memo==1){si_save(statepath,md,by,sst);}
    if(use_rules==1){si_save(statepath,md,by,sst);}

    _zag_print("DIAG class=");
    _zag_print(class_name(dr.*.class));
    _zag_print(" strategy=");
    _zag_print(dr.*.strat);
    _zag_print(" score=");
    _zag_print(_zag_i64_to_str(dr.*.score));
    _zag_print(" trace=");
    let trb:[]u8=tr.*.b[0..tr.*.n];
    _zag_print(trb);
    _zag_print("\n");
    _zag_print("SI mech=");
    _zag_print(mech);
    _zag_print(" hit=");
    _zag_print(_zag_i64_to_str(si_hit));
    _zag_print(" mm=");
    _zag_print(_zag_i64_to_str(si_mm));
    _zag_print(" uninst=");
    _zag_print(_zag_i64_to_str(si_uninst));
    _zag_print(" hevals=");
    _zag_print(_zag_i64_to_str(si_hevals));
    _zag_print(" rule=");
    _zag_print(_zag_i64_to_str(si_rulefired));
    _zag_print(" shadow=");
    _zag_print(_zag_i64_to_str(si_shadow));
    _zag_print(" fast=");
    _zag_print(_zag_i64_to_str(si_fast));
    _zag_print(" defect=");
    _zag_print(_zag_i64_to_str(si_defect));
    _zag_print(" diagcalls=");
    _zag_print(_zag_i64_to_str(si_diagcalls));
    _zag_print("\n@@SRC@@\n");
    let ob:[]u8=outc.*.b[0..outc.*.n];
    _zag_print(ob);
    if(ob.len>0){
        if(ob[ob.len-1]!=10){_zag_print("\n");}
    }
    _zag_print("@@END@@\n");
    return;
}

// Rule observation: update or add a rule candidate from a full deliberation.
fn si_rule_observe(md:[]u8, by:[]u8, sst:[]u8, evcode:i64, sig:[]u8, dr:*DRes, tr:*Cx, outc:*Cx)void {
    let r:i64=si_find_rule(md,by,sst,evcode,sig);
    let trb:[]u8=tr.*.b[0..tr.*.n];
    if(r>=0){
        let cc:i64=si_mget(md,r,5);
        let so:i64=si_mget(md,r,7);
        let sl:i64=si_mget(md,r,8);
        let cstrat:[]u8=by[so..so+sl];
        if(cc==dr.*.class){
            if(s_eq(cstrat,dr.*.strat)==1){
                si_mput(md,r,13,si_mget(md,r,13)+1);
                return;
            }
        }
        // mapping changed: reset count, update stored mapping.
        // (sig unchanged; update class/strat/trace in place by delete+add.)
        si_del_rec(md,sst,r);
        let ob:[]u8=outc.*.b[0..outc.*.n];
        si_add_rec(md,by,sst,2,0,evcode,sig,dr.*.class,dr.*.score,dr.*.strat,trb,ob,1,0);
        return;
    }
    let ob2:[]u8=outc.*.b[0..outc.*.n];
    si_add_rec(md,by,sst,2,0,evcode,sig,dr.*.class,dr.*.score,dr.*.strat,trb,ob2,1,0);
    return;
}

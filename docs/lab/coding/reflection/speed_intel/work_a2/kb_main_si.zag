// kb_main.zag — coding knowledge-base recall learner. Pure Zag, zero RNG.
// The KB (kb.dat) is loaded at startup; every emission decision is made
// in-learner by scoring KB entries against the spec. The driver is plumbing.
// Usage: kb_main <plan|gen|gen|gate> <kb.dat> <spec>
//   plan: print the deliberation trace (selected entries + scores + digest)
//   gen:  emit a complete Zag program from the selected EMIT entry, or
//         KB-MISS:<reason> when the KB cannot cover the spec (never guess)
//   gate: REFUSE/ALLOW against the G-RULES entry

fn s_eq(a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn s_find(hay:[]u8, needle:[]u8, from:i64)i64 {
    let hn:i64=hay.len;
    let nn:i64=needle.len;
    if(nn==0){return from;}
    if(nn>hn){return -1;}
    let i:i64=from;
    while(i+nn<=hn){
        let j:i64=0;
        let ok:i64=1;
        while(j<nn){
            if(hay[i+j]!=needle[j]){ok=0;}
            j=j+1;
        }
        if(ok==1){return i;}
        i=i+1;
    }
    return -1;
}

fn s_lower(s:[]u8)[]u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let o:[]u8=p[0..s.len];
    let i:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=65){
            if(c<=90){c=(c+32) as u8;}
        }
        o[i]=c;
        i=i+1;
    }
    return o;
}

fn put64(b:[]u8, o:i64, v:i64)void {
    let i:i64=0;
    while(i<8){
        let sh:i64=i*8;
        b[o+i]=((v>>sh)&255) as u8;
        i=i+1;
    }
    return;
}

fn get64(b:[]u8, o:i64)i64 {
    let v:i64=0;
    let k:i64=0;
    while(k<8){
        v=v|(((b[o+k] as i64)&255)<<(k*8));
        k=k+1;
    }
    return v;
}

fn fnv1a(data:[]u8)i64 {
    let h:i64=-3750763034362895579;
    let p:i64=1099511628211;
    let i:i64=0;
    while(i<data.len){
        h=h^(data[i] as i64);
        h=h*p;
        i=i+1;
    }
    return h;
}

fn print_hex(v:i64)void {
    let digits:[]u8="0123456789abcdef";
    let mp:*u8=_zag_malloc(17) as *u8;
    let o:[]u8=mp[0..16];
    let k:i64=0;
    while(k<16){
        let sh:i64=(15-k)*4;
        let nib:i64=(v>>sh)&15;
        o[k]=digits[nib];
        k=k+1;
    }
    _zag_print(o);
    return;
}

fn path_cstr(s:[]u8)*u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let i:i64=0;
    while(i<s.len){
        p[i]=s[i];
        i=i+1;
    }
    p[s.len]=0;
    return p;
}

fn read_all(path:[]u8, mem:*u8, cap:i64)i64 {
    let pp:*u8=path_cstr(path);
    let fd:i64=_zag_raw_syscall(2, pp as i64, 0, 0, 0, 0, 0);
    if(fd<0){return -1;}
    let total:i64=0;
    while(1==1){
        if(total>=cap){break;}
        let want:i64=cap-total;
        if(want>65536){want=65536;}
        let r:i64=_zag_raw_syscall(0, fd, (mem as i64)+total, want, 0, 0, 0);
        if(r<=0){break;}
        total=total+r;
    }
    let c:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

// spec_kv: value of key (with trailing =) until '|' or end; "" if absent
fn spec_kv(spec:[]u8, key:[]u8)[]u8 {
    let pos:i64=s_find(spec,key,0);
    if(pos<0){
        let e:[]u8="";
        return e;
    }
    let vs:i64=pos+key.len;
    if(vs>=spec.len){
        let e2:[]u8="";
        return e2;
    }
    let ve:i64=vs;
    while(ve<spec.len){
        if(spec[ve]==124){break;}
        ve=ve+1;
    }
    return spec[vs..ve];
}

fn kv_has(spec:[]u8, key:[]u8) i64 {
    if(s_find(spec,key,0)>=0){return 1;}
    return 0;
}

// ---- KB load ----
// entry table: 8 u64s per entry: id_off,id_len,top_off,top_len,
// kw_off,kw_len,body_off,body_len (offsets into the file image)
fn et_get(tab:[]u8, e:i64, f:i64)i64 {
    return get64(tab,e*64+f*8);
}

// parses an already-loaded image; returns entry count or -1
fn kb_parse(mem:*u8, n:i64, tab:[]u8) i64 {
    let img:[]u8=mem[0..n];
    if(n<13){return -1;}
    if(img[0]!=75){return -1;}
    if(img[1]!=66){return -1;}
    if(img[2]!=48){return -1;}
    if(img[3]!=49){return -1;}
    if(img[4]!=10){return -1;}
    let ec:i64=get64(img,5);
    if(ec>256){return -1;}
    let off:i64=13;
    let e:i64=0;
    while(e<ec){
        let f:i64=0;
        while(f<4){
            let fl:i64=get64(img,off);
            off=off+8;
            put64(tab,e*64+f*2*8,off);
            put64(tab,e*64+(f*2+1)*8,fl);
            off=off+fl;
            f=f+1;
        }
        e=e+1;
    }
    return ec;
}

fn entry_id(tab:[]u8, img:[]u8, e:i64)[]u8 {
    let o:i64=et_get(tab,e,0);
    let l:i64=et_get(tab,e,1);
    return img[o..o+l];
}

fn entry_kw(tab:[]u8, img:[]u8, e:i64)[]u8 {
    let o:i64=et_get(tab,e,4);
    let l:i64=et_get(tab,e,5);
    return img[o..o+l];
}

fn entry_body(tab:[]u8, img:[]u8, e:i64)[]u8 {
    let o:i64=et_get(tab,e,6);
    let l:i64=et_get(tab,e,7);
    return img[o..o+l];
}

fn find_entry(tab:[]u8, img:[]u8, ec:i64, id:[]u8)i64 {
    let e:i64=0;
    while(e<ec){
        if(s_eq(entry_id(tab,img,e),id)==1){return e;}
        e=e+1;
    }
    return -1;
}

// score of entry e against lowered desc = kw-term substring hits.
// probes counts substring probes (cost accounting, SI arm 2a).
fn entry_score(tab:[]u8, img:[]u8, e:i64, lowered:[]u8, probes:*i64)i64 {
    let kw:[]u8=entry_kw(tab,img,e);
    let score:i64=0;
    let ts:i64=0;
    while(ts<kw.len){
        let te:i64=ts;
        while(te<kw.len){
            if(kw[te]==44){break;}
            te=te+1;
        }
        let a:i64=ts;
        let b:i64=te;
        while(a<b){
            if(kw[a]!=32){break;}
            a=a+1;
        }
        while(b>a){
            if(kw[b-1]!=32){break;}
            b=b-1;
        }
        if(b>a){
            let term:[]u8=kw[a..b];
            probes.*=probes.*+1;
            if(s_find(lowered,term,0)>=0){score=score+1;}
        }
        ts=te+1;
    }
    return score;
}

fn is_family(id:[]u8)i64 {
    if(id.len<2){return 0;}
    if(id[0]==69){
        if(id[1]==45){return 1;}
    }
    return 0;
}

// plan: pick best E-* entry from CACHED scores. returns entry index or -1.
// aux_ok set via ptr. scores holds entry_score for each entry (or -1 if
// unscored/unreachable in indexed mode). Does NOT score; the caller pre-fills.
fn do_plan(tab:[]u8, img:[]u8, ec:i64, scores:[]u8, aux_ok:*i64)i64 {
    let best:i64=-1;
    let bests:i64=0;
    let e:i64=0;
    while(e<ec){
        let id:[]u8=entry_id(tab,img,e);
        if(is_family(id)==1){
            let s:i64=get64(scores,e*8);
            if(s>=0){
                if(s>bests){
                    bests=s;
                    best=e;
                }
            }
        }
        e=e+1;
    }
    aux_ok.*=1;
    if(best<0){return -1;}
    let bid:[]u8=entry_id(tab,img,best);
    if(s_eq(bid,"E-FILEWRITE")==1){
        if(find_entry(tab,img,ec,"L-SYSCALL-NUMS")<0){aux_ok.*=0;}
        if(find_entry(tab,img,ec,"I-CSTR")<0){aux_ok.*=0;}
    }
    if(s_eq(bid,"E-FILEREAD")==1){
        if(find_entry(tab,img,ec,"L-SYSCALL-NUMS")<0){aux_ok.*=0;}
        if(find_entry(tab,img,ec,"I-CSTR")<0){aux_ok.*=0;}
    }
    return best;
}

// Pre-score all entries (flat) or reachable entries (indexed) into scores.
// Returns the number scored. Flat scores all ec exactly once.
fn pre_score(tab:[]u8, img:[]u8, ec:i64, lowered:[]u8, do_idx:i64, reach:[]u8, scores:[]u8, probes:*i64)i64 {
    let scored:i64=0;
    let e:i64=0;
    while(e<ec){
        let ok:i64=1;
        if(do_idx==1){
            if(reach[e]==0){ok=0;}
        }
        if(ok==1){
            let s:i64=entry_score(tab,img,e,lowered,probes);
            put64(scores,e*8,s);
            scored=scored+1;
        } else {
            put64(scores,e*8,-1);
        }
        e=e+1;
    }
    return scored;
}

// resolve one slot name -> value slice. miss flag via ptr.
fn slot_value(name:[]u8, spec:[]u8, tab:[]u8, img:[]u8, ec:i64, miss:*i64)[]u8 {
    // 1) spec kv
    let kp:*u8=_zag_malloc(name.len+2) as *u8;
    let kb:[]u8=kp[0..name.len+1];
    let i:i64=0;
    while(i<name.len){
        kb[i]=name[i];
        i=i+1;
    }
    kb[name.len]=61;
    if(kv_has(spec,kb)==1){
        let v:[]u8=spec_kv(spec,kb);
        return v;
    }
    // 2) KB numeric table L-SYSCALL-NUMS
    let is_sys:i64=0;
    let key:[]u8=name;
    if(name.len>4){
        if(name[0]==83){
            if(name[1]==89){
                if(name[2]==83){
                    if(name[3]==95){
                        is_sys=1;
                        let rest:[]u8=name[4..name.len];
                        key=s_lower(rest);
                    }
                }
            }
        }
    }
    if(name.len>2){
        if(name[0]==79){
            if(name[1]==95){is_sys=1;}
        }
    }
    if(name.len>4){
        if(name[0]==77){
            if(name[1]==79){
                if(name[2]==68){
                    if(name[3]==69){is_sys=1;}
                }
            }
        }
    }
    if(is_sys==1){
        let se:i64=find_entry(tab,img,ec,"L-SYSCALL-NUMS");
        if(se>=0){
            let body:[]u8=entry_body(tab,img,se);
            let kp2:*u8=_zag_malloc(key.len+2) as *u8;
            let kb2:[]u8=kp2[0..key.len+1];
            let j:i64=0;
            while(j<key.len){
                kb2[j]=key[j];
                j=j+1;
            }
            kb2[key.len]=61;
            let pos:i64=s_find(body,kb2,0);
            if(pos>=0){
                let vs:i64=pos+kb2.len;
                let ve:i64=vs;
                while(ve<body.len){
                    if(body[ve]==10){break;}
                    ve=ve+1;
                }
                let v2:[]u8=body[vs..ve];
                return v2;
            }
        }
    }
    miss.*=1;
    let mt:[]u8="";
    return mt;
}

// itab: 32 bytes per term: toff,tlen,elist_off,ecount (offsets into iimg,
// entry indices via ear as u64s). Fills reach[0..ec) (caller zeroes first).
fn idx_reachable(itab:[]u8, nt:i64, iimg:[]u8, ear:[]u8, lowered:[]u8, reach:[]u8, tprobes:*i64)void {
    let t:i64=0;
    while(t<nt){
        let to:i64=get64(itab,t*32);
        let tl:i64=get64(itab,t*32+8);
        let lo:i64=get64(itab,t*32+16);
        let ne:i64=get64(itab,t*32+24);
        let term:[]u8=iimg[to..to+tl];
        tprobes.*=tprobes.*+1;
        if(s_find(lowered,term,0)>=0){
            let k:i64=0;
            while(k<ne){
                let e:i64=get64(ear,(lo+k)*8);
                reach[e]=1;
                k=k+1;
            }
        }
        t=t+1;
    }
    return;
}

fn print_scored(scored:i64, probes:i64, tprobes:i64, do_idx:i64)void {
    _zag_print("PLAN scored=");
    let a:[]u8=_zag_i64_to_str(scored);
    _zag_print(a);
    _zag_print(" probes=");
    let b:[]u8=_zag_i64_to_str(probes);
    _zag_print(b);
    if(do_idx==1){
        _zag_print(" tprobes=");
        let c:[]u8=_zag_i64_to_str(tprobes);
        _zag_print(c);
    }
    _zag_print("\n");
    return;
}

fn print_plan(tab:[]u8, img:[]u8, ec:i64, spec:[]u8, dg:i64, do_idx:i64, itab:[]u8, nt:i64, iimg:[]u8, ear:[]u8)void {
    let bar:i64=s_find(spec,"|",0);
    let desc:[]u8=spec;
    if(bar>=0){desc=spec[0..bar];}
    let lowered:[]u8=s_lower(desc);
    let probes:i64=0;
    let tprobes:i64=0;
    let reachp:*u8=_zag_malloc(256) as *u8;
    let reach:[]u8=reachp[0..256];
    let ri:i64=0;
    while(ri<256){
        reach[ri]=0;
        ri=ri+1;
    }
    if(do_idx==1){
        idx_reachable(itab,nt,iimg,ear,lowered,reach,&tprobes);
    }
    // Pre-score: flat scores all ec exactly once; indexed scores reachable only.
    let scp:*u8=_zag_malloc((ec*8)+8) as *u8;
    let scores:[]u8=scp[0..ec*8];
    let scored:i64=pre_score(tab,img,ec,lowered,do_idx,reach,scores,&probes);
    let aux_ok:i64=0;
    let best:i64=do_plan(tab,img,ec,scores,&aux_ok);
    if(best<0){
        _zag_print("PLAN KB-MISS: no family entry matched spec\n");
        print_scored(scored,probes,tprobes,do_idx);
        return;
    }
    let bid:[]u8=entry_id(tab,img,best);
    if(aux_ok==0){
        _zag_print("PLAN KB-MISS: required auxiliary entry absent for ");
        _zag_print(bid);
        _zag_print("\n");
        print_scored(scored,probes,tprobes,do_idx);
        return;
    }
    let bs:i64=get64(scores,best*8);
    _zag_print("PLAN family=");
    _zag_print(bid);
    _zag_print(" famscore=");
    let t:[]u8=_zag_i64_to_str(bs);
    _zag_print(t);
    _zag_print("\n");
    // top supporting entries (any topic, excluding the family itself)
    // Uses cached scores; same order and early-break as the original.
    _zag_print("PLAN support=");
    let shown:i64=0;
    let e:i64=0;
    while(e<ec){
        if(e!=best){
            let s:i64=get64(scores,e*8);
            if(s>0){
                if(shown>0){_zag_print(",");}
                _zag_print(entry_id(tab,img,e));
                shown=shown+1;
            }
        }
        if(shown>=4){break;}
        e=e+1;
    }
    _zag_print("\n");
    _zag_print("PLAN digest=");
    print_hex(dg);
    _zag_print("\n");
    print_scored(scored,probes,tprobes,do_idx);
    return;
}

fn do_gen(tab:[]u8, img:[]u8, ec:i64, spec:[]u8, dg:i64, do_idx:i64, itab:[]u8, nt:i64, iimg:[]u8, ear:[]u8)void {
    let bar:i64=s_find(spec,"|",0);
    let desc:[]u8=spec;
    if(bar>=0){desc=spec[0..bar];}
    let lowered:[]u8=s_lower(desc);
    let probes:i64=0;
    let tprobes:i64=0;
    let reachp:*u8=_zag_malloc(256) as *u8;
    let reach:[]u8=reachp[0..256];
    let ri:i64=0;
    while(ri<256){
        reach[ri]=0;
        ri=ri+1;
    }
    if(do_idx==1){
        idx_reachable(itab,nt,iimg,ear,lowered,reach,&tprobes);
    }
    let scp:*u8=_zag_malloc((ec*8)+8) as *u8;
    let scores:[]u8=scp[0..ec*8];
    // scored not printed in gen; pre_score still fills the cache.
    let dummy:i64=pre_score(tab,img,ec,lowered,do_idx,reach,scores,&probes);
    let aux_ok:i64=0;
    let best:i64=do_plan(tab,img,ec,scores,&aux_ok);
    if(best<0){
        _zag_print("KB-MISS: no family entry matched spec\n");
        return;
    }
    let bid:[]u8=entry_id(tab,img,best);
    if(aux_ok==0){
        _zag_print("KB-MISS: required auxiliary entry absent for ");
        _zag_print(bid);
        _zag_print("\n");
        return;
    }
    let body:[]u8=entry_body(tab,img,best);
    _zag_print("// kb-recall family=");
    _zag_print(bid);
    _zag_print(" digest=");
    print_hex(dg);
    _zag_print("\n");
    // slot-fill {{name}} (double braces; single braces are code)
    let miss:i64=0;
    let missname:[]u8="";
    let i:i64=0;
    // emit via a small buffer to keep _zag_print calls chunked
    let obp:*u8=_zag_malloc(262144) as *u8;
    let ob:[]u8=obp[0..262144];
    let on:i64=0;
    while(i<body.len){
        if(body[i]==123){
            if(i+1<body.len){
                if(body[i+1]==123){
                    let j:i64=i+2;
                    let found:i64=0;
                    while(j+1<body.len){
                        if(body[j]==125){
                            if(body[j+1]==125){found=1;}
                        }
                        if(found==1){break;}
                        j=j+1;
                    }
                    if(found==0){miss=1;}
                    if(miss==0){
                        let name:[]u8=body[i+2..j];
                        missname=name;
                        let v:[]u8=slot_value(name,spec,tab,img,ec,&miss);
                        if(miss==0){
                            let k:i64=0;
                            while(k<v.len){
                                ob[on]=v[k];
                                on=on+1;
                                k=k+1;
                            }
                        }
                        i=j+2;
                    }
                } else {
                    ob[on]=body[i];
                    on=on+1;
                    i=i+1;
                }
            } else {
                ob[on]=body[i];
                on=on+1;
                i=i+1;
            }
        } else {
            ob[on]=body[i];
            on=on+1;
            i=i+1;
        }
        if(miss==1){break;}
        if(on>260000){break;}
    }
    if(miss==1){
        _zag_print("KB-MISS: unresolvable slot {{");
        _zag_print(missname);
        _zag_print("}}\n");
        return;
    }
    _zag_print(ob[0..on]);
    return;
}

fn do_gate(tab:[]u8, img:[]u8, ec:i64, spec:[]u8)void {
    let ge:i64=find_entry(tab,img,ec,"G-RULES");
    if(ge<0){
        _zag_print("GATE-ERROR: G-RULES absent from KB\n");
        return;
    }
    let lowered:[]u8=s_lower(spec);
    let kw:[]u8=entry_kw(tab,img,ge);
    let ts:i64=0;
    let hit:[]u8="";
    while(ts<kw.len){
        let te:i64=ts;
        while(te<kw.len){
            if(kw[te]==44){break;}
            te=te+1;
        }
        let a:i64=ts;
        let b:i64=te;
        while(a<b){
            if(kw[a]!=32){break;}
            a=a+1;
        }
        while(b>a){
            if(kw[b-1]!=32){break;}
            b=b-1;
        }
        if(b>a){
            let term:[]u8=kw[a..b];
            // "gate" alone is the mechanism name, not an attack; skip it and "refuse"
            if(s_eq(term,"gate")==0){
                if(s_eq(term,"refuse")==0){
                    if(s_find(lowered,term,0)>=0){hit=term;}
                }
            }
        }
        ts=te+1;
    }
    if(hit.len>0){
        _zag_print("REFUSE: trigger '");
        _zag_print(hit);
        _zag_print("' matches G-RULES\n");
        return;
    }
    _zag_print("ALLOW\n");
    return;
}

fn main()void {
    let mode:[]u8=_zag_arg(1);
    let kbpath:[]u8=_zag_arg(2);
    let spec:[]u8=_zag_arg(3);
    let idxmode:[]u8=_zag_arg(4);
    let do_idx:i64=0;
    // index structures (only populated in idx mode)
    let itabp:*u8=_zag_malloc(32768) as *u8;
    let itab:[]u8=itabp[0..32768];
    let earp:*u8=_zag_malloc(131072) as *u8;
    let ear:[]u8=earp[0..131072];
    let iimgp:*u8=_zag_malloc(1048576) as *u8;
    let nt:i64=0;
    if(s_eq(idxmode,"idx")==1){
        do_idx=1;
        let idxpath:[]u8=_zag_arg(5);
        if(idxpath.len==0){
            _zag_print("KB-ERROR: idx mode needs index path as argv 5\n");
            return;
        }
        let inn:i64=read_all(idxpath, iimgp, 1048576);
        if(inn<64){
            _zag_print("KB-ERROR: cannot load index\n");
            return;
        }
        let iimg:[]u8=iimgp[0..inn];
        if(iimg[0]!=75){_zag_print("KB-ERROR: bad index magic\n");return;}
        if(iimg[1]!=66){_zag_print("KB-ERROR: bad index magic\n");return;}
        if(iimg[2]!=73){_zag_print("KB-ERROR: bad index magic\n");return;}
        nt=get64(iimg,7);
        if(nt>1024){_zag_print("KB-ERROR: index too large\n");return;}
        let off:i64=15;
        let ebump:i64=0;
        let t:i64=0;
        while(t<nt){
            let tl:i64=get64(iimg,off);
            let to:i64=off+8;
            let ne:i64=get64(iimg,off+8+tl);
            put64(itab,t*32,to);
            put64(itab,t*32+8,tl);
            put64(itab,t*32+16,ebump);
            put64(itab,t*32+24,ne);
            let ko:i64=off+8+tl+8;
            let k:i64=0;
            while(k<ne){
                put64(ear,(ebump+k)*8,get64(iimg,ko+k*8));
                k=k+1;
            }
            ebump=ebump+ne;
            off=ko+ne*8;
            t=t+1;
        }
    }
    let iimg2:[]u8=iimgp[0..1048576];
    let memp:*u8=_zag_malloc(1048576) as *u8;
    let tabp:*u8=_zag_malloc(32768) as *u8;
    let tab:[]u8=tabp[0..32768];
    let n:i64=read_all(kbpath, memp, 1048576);
    if(n<0){
        _zag_print("KB-ERROR: cannot load knowledge store\n");
        return;
    }
    let img:[]u8=memp[0..n];
    let dg:i64=fnv1a(img);
    let ec:i64=kb_parse(memp, n, tab);
    if(ec<0){
        _zag_print("KB-ERROR: cannot parse knowledge store\n");
        return;
    }
    if(s_eq(mode,"plan")==1){
        print_plan(tab,img,ec,spec,dg,do_idx,itab,nt,iimg2,ear);
        return;
    }
    if(s_eq(mode,"gen")==1){
        do_gen(tab,img,ec,spec,dg,do_idx,itab,nt,iimg2,ear);
        return;
    }
    if(s_eq(mode,"gate")==1){
        do_gate(tab,img,ec,spec);
        return;
    }
    _zag_print("KB-ERROR: unknown mode\n");
    return;
}

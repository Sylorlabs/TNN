fn t4_selsort(cx:*Cx, nums:[]i64, off:i64, cnt:i64)void {
    e_raw(cx,"fn selsort(a:[]i64,n:i64)void {\n");
    e_raw(cx,"    let i:i64=0;\n");
    e_raw(cx,"    while(i<n){\n");
    e_raw(cx,"        let m:i64=i;\n");
    e_raw(cx,"        let j:i64=i+1;\n");
    e_raw(cx,"        while(j<n){\n");
    e_raw(cx,"            if(a[j]<a[m]){m=j;}\n");
    e_raw(cx,"            j=j+1;\n");
    e_raw(cx,"        }\n");
    e_raw(cx,"        let t:i64=a[i];\n");
    e_raw(cx,"        a[i]=a[m];\n");
    e_raw(cx,"        a[m]=t;\n");
    e_raw(cx,"        i=i+1;\n");
    e_raw(cx,"    }\n");
    e_raw(cx,"    return;\n");
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    e_build_arr_nums(cx,nums,off,cnt);
    e_raw(cx,"    selsort(arr,");
    e_i64(cx,cnt);
    e_raw(cx,");\n");
    e_print_arr(cx,cnt);
    e_raw(cx,"}\n");
    return;
}

// argvsum with a manual card: extract first fenced code block, prepend, then wire
fn card_code(card:[]u8)[]u8 {
    let f1:i64=s_find(card,"```",0);
    if(f1<0){let e:[]u8="";return e;}
    let f2:i64=s_find(card,"```",f1+3);
    if(f2<0){let e2:[]u8="";return e2;}
    return card[f1+3..f2];
}

fn t4_argvsum(cx:*Cx, card:[]u8)void {
    let code:[]u8=card_code(card);
    e_raw(cx,code);
    e_raw(cx,"\n");
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"    let s:i64=0;\n");
    e_raw(cx,"    let k:i64=1;\n");
    e_raw(cx,"    while(k<=4){\n");
    e_raw(cx,"        let a:[]u8=_zag_arg(k);\n");
    e_raw(cx,"        if(a.len>0){s=s+parse_int(a,a.len);}\n");
    e_raw(cx,"        k=k+1;\n");
    e_raw(cx,"    }\n");
    e_raw(cx,"    _zag_print(_zag_i64_to_str(s));\n");
    e_raw(cx,"    _zag_print(\"\\n\");\n");
    e_raw(cx,"}\n");
    return;
}

// ============ section 6: repair ============

// collect "fn NAME(" definition name spans; arena[f]=start, arena[maxf+f]=len
fn find_fn_defs(src:[]u8, arena:[]i64, maxf:i64)i64 {
    let fc:i64=0;
    let i:i64=0;
    while(i+3<src.len){
        if(src[i]==102){
            if(src[i+1]==110){
                if(src[i+2]==32){
                    let ns:i64=i+3;
                    let ne:i64=ns;
                    while(ne<src.len){
                        let c:u8=src[ne];
                        if(c==40){break;}
                        if(c==32){break;}
                        ne=ne+1;
                    }
                    if(ne<src.len){
                        if(src[ne]==40){
                            if(fc<maxf){arena[fc]=ns;arena[maxf+fc]=ne-ns;fc=fc+1;}
                        }
                    }
                    i=ne;
                } else {i=i+1;}
            } else {i=i+1;}
        } else {i=i+1;}
    }
    return fc;
}

fn fn_defined(src:[]u8, name:[]u8)i64 {
    let arena:[]i64=i64_arena(64);
    let nf:i64=find_fn_defs(src,arena,32);
    let i:i64=0;
    while(i<nf){
        let ns:i64=arena[i];
        let nl:i64=arena[32+i];
        if(nl==name.len){
            if(s_eq(src[ns..ns+nl],name)==1){return 1;}
        }
        i=i+1;
    }
    return 0;
}

fn is_intrinsic(name:[]u8)i64 {
    if(s_eq(name,"_zag_print")==1){return 1;}
    if(s_eq(name,"_zag_i64_to_str")==1){return 1;}
    if(s_eq(name,"_zag_arg")==1){return 1;}
    if(s_eq(name,"_zag_malloc")==1){return 1;}
    if(s_eq(name,"_zag_free")==1){return 1;}
    return 0;
}

// edit-similar: same length diff<=2, or len differs by <=2 with prefix relation
fn similar(a:[]u8, b:[]u8)i64 {
    let al:i64=a.len;
    let bl:i64=b.len;
    let d:i64=al-bl;
    if(d<0){d=0-d;}
    if(d>2){return 0;}
    let m:i64=al;
    if(bl<m){m=bl;}
    let diff:i64=0;
    let i:i64=0;
    while(i<m){
        if(a[i]!=b[i]){diff=diff+1;}
        i=i+1;
    }
    diff=diff+d;
    if(diff<=2){return 1;}
    return 0;
}

// rewrite all occurrences of old_call "(" -> new; returns 1 if changed
fn rewrite_call(cx:*Cx, src:[]u8, oldn:[]u8, newn:[]u8)i64 {
    let changed:i64=0;
    let i:i64=0;
    while(i<src.len){
        let pos:i64=s_find(src,oldn,i);
        if(pos<0){break;}
        // must be followed by '(' and be a call (preceded by non-ident char or start)
        let after:i64=pos+oldn.len;
        if(after<src.len){
            if(src[after]==40){
                e_raw(cx,src[i..pos]);
                e_raw(cx,newn);
                changed=1;
                i=after;
            } else {
                e_raw(cx,src[i..after]);
                i=after;
            }
        } else {
            e_raw(cx,src[i..src.len]);
            i=src.len;
        }
    }
    if(i<src.len){e_raw(cx,src[i..src.len]);}
    return changed;
}

// patch UNKNOWNFN: rename unknown call to nearest defined/intrinsic name
fn patch_unknownfn(cx:*Cx, src:[]u8, uname:[]u8)i64 {
    let arena:[]i64=i64_arena(64);
    let nf:i64=find_fn_defs(src,arena,32);
    let best:[]u8="";
    let bi:i64=0;
    while(bi<nf){
        let ns:i64=arena[bi];
        let nl:i64=arena[32+bi];
        let cand:[]u8=src[ns..ns+nl];
        if(similar(uname,cand)==1){best=cand;}
        bi=bi+1;
    }
    if(best.len==0){
        // try intrinsics
        let in1:[]u8="_zag_print";
        if(similar(uname,in1)==1){best=in1;}
        let in2:[]u8="_zag_i64_to_str";
        if(similar(uname,in2)==1){best=in2;}
        let in3:[]u8="_zag_arg";
        if(similar(uname,in3)==1){best=in3;}
    }
    if(best.len==0){return 0;}
    return rewrite_call(cx,src,uname,best);
}

// patch E0203: three shapes, first applicable wins
// shape A: let V:i32="lit" or let V:i64="lit" -> change decl to []u8
// shape B: return "lit"; inside fn F()->i32/i64 -> change F's return type to []u8
// shape C: call arg "digits" where param numeric -> strip quotes
fn patch_type_a(cx:*Cx, src:[]u8)i64 {
    // find `let `: then name `:` then type then `="`
    let i:i64=0;
    let changed:i64=0;
    let out:Cx=cx_new(src.len+64);
    let ocx:*Cx=&out;
    let pos:i64=0;
    while(pos<src.len){
        let lp:i64=s_find(src,"let ",pos);
        if(lp<0){break;}
        let cp:i64=s_find(src,":",lp);
        let eq:i64=s_find(src,"=",lp);
        if(cp<0){break;}
        if(eq<0){break;}
        if(cp>eq){pos=lp+4;continue;}
        // type span = cp+1 .. eq, trim spaces
        let ts:i64=cp+1;
        while(ts<eq){if(src[ts]!=32){break;}ts=ts+1;}
        let te:i64=eq;
        while(te>ts){if(src[te-1]!=32){break;}te=te-1;}
        let typ:[]u8=src[ts..te];
        let isnum:i64=0;
        if(s_eq(typ,"i32")==1){isnum=1;}
        if(s_eq(typ,"i64")==1){isnum=1;}
        // value starts at eq+1; check for quote
        let vs:i64=eq+1;
        while(vs<src.len){if(src[vs]!=32){break;}vs=vs+1;}
        if(isnum==1){
            if(vs<src.len){
                if(src[vs]==34){
                    // rewrite: copy up to ts, emit []u8, continue after te
                    e_raw(ocx,src[pos..ts]);
                    e_raw(ocx,"[]u8");
                    changed=1;
                    pos=te;
                    continue;
                }
            }
        }
        pos=lp+4;
    }
    if(changed==1){
        e_raw(ocx,src[pos..src.len]);
        // copy out back into cx
        let b:[]u8=cx.*.b;
        let ob:[]u8=ocx.*.b;
        let on:i64=ocx.*.n;
        let k:i64=0;
        while(k<on){b[k]=ob[k];k=k+1;}
        cx.*.n=on;
        return 1;
    }
    return 0;
}

// ============ section 7: gate ============

// returns rule id 1..6 if the spec asks for something banned, else 0
fn gate_hit(spec:[]u8)i64 {
    let g:[]u8=s_lower(spec);
    let has_audit:i64=s_has(g,"audit");
    let has_ledger:i64=s_has(g,"ledger");
    if(has_audit==1){
        if(s_has(g,"without")==1){return 1;}
        if(s_has(g,"skip")==1){return 1;}
        if(s_has(g,"bypass")==1){return 1;}
        if(s_has(g,"delete")==1){return 1;}
        if(s_has(g,"hide")==1){return 1;}
        if(s_has(g,"omit")==1){return 1;}
        if(s_has(g,"weaken")==1){return 1;}
    }
    if(has_ledger==1){
        if(s_has(g,"without")==1){return 1;}
        if(s_has(g,"skip")==1){return 1;}
        if(s_has(g,"weaken")==1){return 1;}
    }
    if(s_has(g,"gate")==1){
        if(s_has(g,"bypass")==1){return 2;}
        if(s_has(g,"disable")==1){return 2;}
        if(s_has(g,"always")==1){return 2;}
        if(s_has(g,"remove")==1){return 2;}
        if(s_has(g,"weaken")==1){return 2;}
    }
    if(s_has(g,"deliberat")==1){
        if(s_has(g,"skip")==1){return 3;}
        if(s_has(g,"remove")==1){return 3;}
        if(s_has(g,"delete")==1){return 3;}
        if(s_has(g,"disable")==1){return 3;}
    }
    if(s_has(g,"random")==1){return 4;}
    if(s_has(g,"conceal")==1){return 5;}
    if(s_has(g,"hide")==1){
        if(s_has(g,"behavior")==1){return 5;}
        if(s_has(g,"behaviour")==1){return 5;}
        if(s_has(g,"log")==1){return 5;}
    }
    if(s_has(g,"pin")==1){
        if(s_has(g,"without")==1){return 6;}
        if(s_has(g,"every")==1){return 6;}
    }
    if(s_has(g,"force-pin")==1){return 6;}
    return 0;
}

// ============ section 8: self-review ============

// brace balance of emitted text; returns 1 if balanced
fn review_braces(src:[]u8)i64 {
    let depth:i64=0;
    let i:i64=0;
    while(i<src.len){
        if(src[i]==123){depth=depth+1;}
        if(src[i]==125){depth=depth-1;}
        if(depth<0){return 0;}
        i=i+1;
    }
    if(depth==0){return 1;}
    return 0;
}

// ============ section 9: modes ============

fn do_teach()void {
    let pid:[]u8=_zag_arg(2);
    let res:[]u8=_zag_arg(3);
    _zag_print("AUDIT op=INSTALL pid=");
    _zag_print(pid);
    _zag_print(" practice=");
    _zag_print(res);
    if(s_eq(res,"PRACTICE_OK")==1){
        _zag_print(" installed=1 deliberation=PRACTICE_GATED\n");
    } else {
        _zag_print(" installed=0 deliberation=PRACTICE_GATED\n");
    }
    return;
}

fn do_gate()void {
    let spec:[]u8=_zag_arg(2);
    let r:i64=gate_hit(spec);
    if(r==0){
        _zag_print("ALLOW\n");
    } else {
        _zag_print("REFUSE:G");
        _zag_print(_zag_i64_to_str(r));
        _zag_print("\n");
    }
    return;
}

// 12 frozen deliberation probes: transitive 2-step inference.
// Probe p: premises (x1 R y1), (x2 R y2), query (qx R qy).
// Genuine inference: YES iff y1==x2 (middle term unifies) AND qx==x1 AND qy==y2.
// Entities: 1 alice,2 bob,3 carol,4 dave,5 wheel,6 car,7 fleet,8 engine,
// 9 dawn,10 noon,11 dusk,12 midnight,13 fire,14 smoke,15 alarm,
// 16 box,17 ball,18 marble,19 crate,20 ann,21 cat.
fn delib_row(p:i64, r:[]i64)void {
    if(p==0){r[0]=1;r[1]=2;r[2]=2;r[3]=3;r[4]=1;r[5]=3;}
    if(p==1){r[0]=1;r[1]=2;r[2]=4;r[3]=3;r[4]=1;r[5]=3;}
    if(p==2){r[0]=5;r[1]=6;r[2]=6;r[3]=7;r[4]=5;r[5]=7;}
    if(p==3){r[0]=5;r[1]=6;r[2]=6;r[3]=7;r[4]=6;r[5]=5;}
    if(p==4){r[0]=9;r[1]=10;r[2]=10;r[3]=11;r[4]=9;r[5]=11;}
    if(p==5){r[0]=9;r[1]=10;r[2]=11;r[3]=12;r[4]=9;r[5]=11;}
    if(p==6){r[0]=13;r[1]=14;r[2]=14;r[3]=15;r[4]=13;r[5]=15;}
    if(p==7){r[0]=13;r[1]=14;r[2]=14;r[3]=15;r[4]=15;r[5]=13;}
    if(p==8){r[0]=16;r[1]=17;r[2]=17;r[3]=18;r[4]=16;r[5]=18;}
    if(p==9){r[0]=16;r[1]=17;r[2]=19;r[3]=18;r[4]=16;r[5]=18;}
    if(p==10){r[0]=20;r[1]=2;r[2]=2;r[3]=21;r[4]=20;r[5]=21;}
    if(p==11){r[0]=20;r[1]=2;r[2]=2;r[3]=21;r[4]=2;r[5]=20;}
    return;
}

fn do_delib()void {
    let id:[]u8=_zag_arg(2);
    let p:i64=0;
    let i:i64=1;
    while(i<id.len){
        let d:u8=id[i];
        if(d>=48){ if(d<=57){ p=p*10+((d as i64)-48); } }
        i=i+1;
    }
    let r:[]i64=i64_arena(6);
    delib_row(p,r);
    let ok:i64=0;
    if(r[1]==r[2]){
        if(r[4]==r[0]){
            if(r[5]==r[3]){ok=1;}
        }
    }
    _zag_print("DELIB ");
    _zag_print(id);
    if(ok==1){
        _zag_print(" YES middle=");
        _zag_print(_zag_i64_to_str(r[1]));
        _zag_print(" chain=unified\n");
    } else {
        _zag_print(" NO chain=broken\n");
    }
    return;
}

// ============ section 10: repair patches ============

// match brace: src[open]=='{'; return index just past matching '}'
fn match_brace(src:[]u8, open:i64)i64 {
    let d:i64=0;
    let i:i64=open;
    while(i<src.len){
        if(src[i]==123){d=d+1;}
        if(src[i]==125){d=d-1;if(d==0){return i+1;}}
        i=i+1;
    }
    return -1;
}

// number words -> value; -1 if not a number word
fn word_to_num(w:[]u8)i64 {
    if(s_eq(w,"zero")==1){return 0;}
    if(s_eq(w,"one")==1){return 1;}
    if(s_eq(w,"two")==1){return 2;}
    if(s_eq(w,"three")==1){return 3;}
    if(s_eq(w,"four")==1){return 4;}
    if(s_eq(w,"five")==1){return 5;}
    if(s_eq(w,"six")==1){return 6;}
    if(s_eq(w,"seven")==1){return 7;}
    if(s_eq(w,"eight")==1){return 8;}
    if(s_eq(w,"nine")==1){return 9;}
    if(s_eq(w,"ten")==1){return 10;}
    if(s_eq(w,"eleven")==1){return 11;}
    if(s_eq(w,"twelve")==1){return 12;}
    if(s_eq(w,"thirteen")==1){return 13;}
    if(s_eq(w,"fourteen")==1){return 14;}
    if(s_eq(w,"fifteen")==1){return 15;}
    if(s_eq(w,"sixteen")==1){return 16;}
    if(s_eq(w,"seventeen")==1){return 17;}
    if(s_eq(w,"eighteen")==1){return 18;}
    if(s_eq(w,"nineteen")==1){return 19;}
    if(s_eq(w,"twenty")==1){return 20;}
    return -1;
}

// is s a quoted integer literal like "3" or "-7" (including quotes)?
fn is_quoted_int(s:[]u8)i64 {
    if(s.len<3){return 0;}
    if(s[0]!=34){return 0;}
    if(s[s.len-1]!=34){return 0;}
    let i:i64=1;
    if(s[1]==45){i=2;}
    if(i>=s.len-1){return 0;}
    while(i<s.len-1){
        if(s[i]<48){return 0;}
        if(s[i]>57){return 0;}
        i=i+1;
    }
    return 1;
}

// E0203 shape B: return "word"; -> return N; (word names a number)
fn patch_ret_word(cx:*Cx, src:[]u8)i64 {
    let pos:i64=s_find(src,"return \"",0);
    if(pos<0){return 0;}
    let qs:i64=pos+8;
    let qe:i64=s_find(src,"\"",qs);
    if(qe<0){return 0;}
    // must be followed by ;
    if(qe+1>=src.len){return 0;}
    if(src[qe+1]!=59){return 0;}
    let w:[]u8=src[qs..qe];
    let n:i64=word_to_num(w);
    if(n<0){return 0;}
    e_raw(cx,src[0..pos]);
    e_raw(cx,"return ");
    e_i64(cx,n);
    e_raw(cx,";");
    e_raw(cx,src[qe+2..src.len]);
    return 1;
}

// E0203 shape C: "digits" inside a call -> digits (strip quotes)
fn patch_arg_unquote(cx:*Cx, src:[]u8)i64 {
    // find first quoted-int occurrence that sits inside parens
    let i:i64=0;
    let found:i64=-1;
    let qe:i64=0;
    while(i<src.len){
        let q:i64=s_find(src,"\"",i);
        if(q<0){break;}
        let e:i64=s_find(src,"\"",q+1);
        if(e<0){break;}
        let lit:[]u8=src[q..e+1];
        if(is_quoted_int(lit)==1){
            found=q;
            qe=e;
            break;
        }
        i=e+1;
    }
    if(found<0){return 0;}
    e_raw(cx,src[0..found]);
    e_raw(cx,src[found+1..qe]);
    e_raw(cx,src[qe+1..src.len]);
    return 1;
}

// E0203 shape A: delete a line assigning a string to a numeric-declared var
// line looks like: <ws>V="...";  (not a let) and `let V:i32`/`let V:i64` exists
fn patch_del_badassign(cx:*Cx, src:[]u8)i64 {
    // split into lines via arena of (start,len)
    let la:[]i64=i64_arena(256);
    let nl:i64=0;
    let st:i64=0;
    let i:i64=0;
    while(i<=src.len){
        if(i==src.len){
            if(nl<128){la[nl]=st;la[128+nl]=i-st;nl=nl+1;}
            break;
        }
        if(src[i]==10){
            if(nl<128){la[nl]=st;la[128+nl]=i-st;nl=nl+1;}
            st=i+1;
        }
        i=i+1;
    }
    let drop:i64=-1;
    let li:i64=0;
    while(li<nl){
        let ls:i64=la[li];
        let ll:i64=la[128+li];
        let line:[]u8=src[ls..ls+ll];
        // trim leading spaces
        let t:i64=0;
        while(t<ll){if(line[t]!=32){break;}t=t+1;}
        let tl:[]u8=line[t..ll];
        // skip let-lines
        if(s_find(tl,"let ",0)!=0){
            // look for V=" pattern: ident chars then =" then quote
            let eq:i64=s_find(tl,"=\"",0);
            if(eq>0){
                // ident = tl[0..eq], must be all ident chars
                let ok:i64=1;
                let k:i64=0;
                while(k<eq){
                    let c:u8=tl[k];
                    let idc:i64=0;
                    if(c>=97){if(c<=122){idc=1;}}
                    if(c>=65){if(c<=90){idc=1;}}
                    if(c>=48){if(c<=57){idc=1;}}
                    if(c==95){idc=1;}
                    if(idc==0){ok=0;}
                    k=k+1;
                }
                if(ok==1){
                    let v:[]u8=tl[0..eq];
                    // check declared numeric: search "let V:i32" or "let V:i64"
                    let d1:[]u8="let ";
                    let probe:[]u8=src;
                    let dp:i64=0;
                    let isnum:i64=0;
                    while(dp<src.len){
                        let f:i64=s_find(src,"let ",dp);
                        if(f<0){break;}
                        // check name follows
                        let ns:i64=f+4;
                        if(ns+v.len<src.len){
                            if(s_eq(src[ns..ns+v.len],v)==1){
                                let after:i64=ns+v.len;
                                if(src[after]==58){
                                    if(s_find(src[after..after+4],":i32",0)==0){isnum=1;}
                                    if(s_find(src[after..after+4],":i64",0)==0){isnum=1;}
                                }
                            }
                        }
                        dp=f+4;
                    }
                    if(isnum==1){drop=li;}
                }
            }
        }
        li=li+1;
    }
    if(drop<0){return 0;}
    // re-emit without the dropped line
    li=0;
    while(li<nl){
        if(li!=drop){
            let ls2:i64=la[li];
            let ll2:i64=la[128+li];
            e_raw(cx,src[ls2..ls2+ll2]);
            e_raw(cx,"\n");
        }
        li=li+1;
    }
    return 1;
}

// count top-level args in "a, b, c"
fn count_args(argstr:[]u8)i64 {
    if(argstr.len==0){return 0;}
    let n:i64=1;
    let d:i64=0;
    let i:i64=0;
    while(i<argstr.len){
        if(argstr[i]==40){d=d+1;}
        if(argstr[i]==41){d=d-1;}
        if(argstr[i]==44){if(d==0){n=n+1;}}
        i=i+1;
    }
    return n;
}

// ARITY: fix calls to fn F with wrong arg count.
// too many -> drop extras; too few -> fill by incrementing from last arg.
fn patch_arity(cx:*Cx, src:[]u8, fname:[]u8)i64 {
    // find definition `fn F(` and count params
    let dpos:i64=s_find(src,"fn ",0);
    let nparams:i64=-1;
    while(dpos>=0){
        let ns:i64=dpos+3;
        if(ns+fname.len<src.len){
            if(s_eq(src[ns..ns+fname.len],fname)==1){
                if(src[ns+fname.len]==40){
                    let pe:i64=match_brace(src,ns+fname.len);
                    // params are between ( and ): find closing paren
                    let cp:i64=s_find(src,")",ns+fname.len);
                    if(cp>0){
                        nparams=count_args(src[ns+fname.len+1..cp]);
                    }
                    break;
                }
            }
        }
        dpos=s_find(src,"fn ",dpos+1);
    }
    if(nparams<0){return 0;}
    // rewrite each wrong-count call
    let out:Cx=cx_new(src.len+256);
    let ocx:*Cx=&out;
    let changed:i64=0;
    let i:i64=0;
    while(i<src.len){
        let cp2:i64=s_find(src,fname,i);
        if(cp2<0){break;}
        // must be a call: followed by '(' and not a definition (not preceded by "fn ")
        let isdef:i64=0;
        if(cp2>=3){
            if(s_eq(src[cp2-3..cp2],"fn ")==1){isdef=1;}
        }
        let after:i64=cp2+fname.len;
        if(after<src.len){
            if(src[after]==40){
                if(isdef==0){
                    // find matching close paren
                    let depth:i64=0;
                    let j:i64=after;
                    let close:i64=-1;
                    while(j<src.len){
                        if(src[j]==40){depth=depth+1;}
                        if(src[j]==41){depth=depth-1;if(depth==0){close=j;break;}}
                        j=j+1;
                    }
                    if(close>0){
                        let argstr:[]u8=src[after+1..close];
                        let nc2:i64=count_args(argstr);
                        if(nc2!=nparams){
                            e_raw(ocx,src[i..after+1]);
                            if(nc2>nparams){
                                // drop extras: keep first nparams args
                                let kept:i64=0;
                                let k:i64=0;
                                let dd:i64=0;
                                let astart:i64=0;
                                while(k<=argstr.len){
                                    let atend:i64=0;
                                    if(k==argstr.len){atend=1;}
                                    else {
                                        if(argstr[k]==40){dd=dd+1;}
                                        if(argstr[k]==41){dd=dd-1;}
                                        if(argstr[k]==44){if(dd==0){atend=1;}}
                                    }
                                    if(atend==1){
                                        if(kept<nparams){
                                            if(kept>0){e_raw(ocx,", ");}
                                            e_raw(ocx,argstr[astart..k]);
                                        }
                                        kept=kept+1;
                                        astart=k+1;
                                    }
                                    k=k+1;
                                }
                            } else {
                                // fill by incrementing from last arg
                                e_raw(ocx,argstr);
                                // last arg numeric value
                                let la2:i64=0;
                                // find last top-level comma
                                let dd2:i64=0;
                                let k2:i64=argstr.len;
                                let lstart:i64=0;
                                while(k2>0){
                                    k2=k2-1;
                                    if(argstr[k2]==41){dd2=dd2+1;}
                                    if(argstr[k2]==40){dd2=dd2-1;}
                                    if(argstr[k2]==44){if(dd2==0){lstart=k2+1;break;}}
                                }
                                let lastarg:[]u8=argstr[lstart..argstr.len];
                                // trim spaces
                                while(lastarg.len>0){if(lastarg[0]!=32){break;}lastarg=lastarg[1..lastarg.len];}
                                while(lastarg.len>0){if(lastarg[lastarg.len-1]!=32){break;}lastarg=lastarg[0..lastarg.len-1];}
                                let lv:i64=0;
                                let kk:i64=0;
                                while(kk<lastarg.len){
                                    if(lastarg[kk]>=48){if(lastarg[kk]<=57){lv=lv*10+((lastarg[kk] as i64)-48);}}
                                    kk=kk+1;
                                }
                                let need:i64=nparams-nc2;
                                let f2:i64=0;
                                while(f2<need){
                                    e_raw(ocx,", ");
                                    e_i64(ocx,lv+1+f2);
                                    f2=f2+1;
                                }
                            }
                            e_raw(ocx,")");
                            changed=1;
                            i=close+1;
                            continue;
                        }
                    }
                }
            }
        }
        // copy through to after this occurrence
        e_raw(ocx,src[i..after]);
        i=after;
        if(i>=src.len){break;}
    }
    if(changed==0){return 0;}
    e_raw(ocx,src[i..src.len]);
    // copy out into cx
    let ob:[]u8=ocx.*.b;
    let on2:i64=ocx.*.n;
    let bb:[]u8=cx.*.b;
    let kk2:i64=0;
    while(kk2<on2){bb[kk2]=ob[kk2];kk2=kk2+1;}
    cx.*.n=on2;
    return 1;
}

// PARSE: close open blocks; if a new `fn` starts while depth>0, close before it
fn patch_brace(cx:*Cx, src:[]u8)i64 {
    let la:[]i64=i64_arena(256);
    let nl:i64=0;
    let st:i64=0;
    let i:i64=0;
    while(i<=src.len){
        if(i==src.len){
            if(nl<128){la[nl]=st;la[128+nl]=i-st;nl=nl+1;}
            break;
        }
        if(src[i]==10){
            if(nl<128){la[nl]=st;la[128+nl]=i-st;nl=nl+1;}
            st=i+1;
        }
        i=i+1;
    }
    let depth:i64=0;
    let li:i64=0;
    let changed:i64=0;
    while(li<nl){
        let ls:i64=la[li];
        let ll:i64=la[128+li];
        let line:[]u8=src[ls..ls+ll];
        let t:i64=0;
        while(t<ll){if(line[t]!=32){break;}t=t+1;}
        // fn at depth>0 -> close first
        if(ll-t>=3){
            if(s_eq(line[t..t+3],"fn ")==1){
                if(depth>0){
                    let c:i64=0;
                    while(c<depth){e_raw(cx,"}\n");c=c+1;}
                    depth=0;
                    changed=1;
                }
            }
        }
        e_raw(cx,line);
        e_raw(cx,"\n");
        let k:i64=0;
        while(k<ll){
            if(line[k]==123){depth=depth+1;}
            if(line[k]==125){depth=depth-1;}
            k=k+1;
        }
        li=li+1;
    }
    while(depth>0){e_raw(cx,"}\n");depth=depth-1;changed=1;}
    return changed;
}

// DUPFN: delete the second definition of fn `fname`
fn patch_dupfn(cx:*Cx, src:[]u8, fname:[]u8)i64 {
    let first:i64=-1;
    let second:i64=-1;
    let dpos:i64=s_find(src,"fn ",0);
    while(dpos>=0){
        let ns:i64=dpos+3;
        if(ns+fname.len<src.len){
            if(s_eq(src[ns..ns+fname.len],fname)==1){
                if(src[ns+fname.len]==40){
                    if(first<0){first=dpos;}
                    else {second=dpos;break;}
                }
            }
        }
        dpos=s_find(src,"fn ",dpos+1);
    }
    if(second<0){return 0;}
    // find the opening brace of the second def, match it
    let ob:i64=s_find(src,"{",second);
    if(ob<0){return 0;}
    let end2:i64=match_brace(src,ob);
    if(end2<0){return 0;}
    e_raw(cx,src[0..second]);
    e_raw(cx,src[end2..src.len]);
    return 1;
}

// ============ section 11: gen dispatch ============

// extract the class field: spec = "T1|FUNC|..." -> "FUNC"
fn spec_class(spec:[]u8)[]u8 {
    let p1:i64=s_find(spec,"|",0);
    if(p1<0){let e:[]u8="";return e;}
    let p2:i64=s_find(spec,"|",p1+1);
    if(p2<0){let e2:[]u8="";return e2;}
    return spec[p1+1..p2];
}

// goal text: after "T4|GOAL|"
fn spec_goal(spec:[]u8)[]u8 {
    let p1:i64=s_find(spec,"|",0);
    if(p1<0){let e:[]u8="";return e;}
    let p2:i64=s_find(spec,"|",p1+1);
    if(p2<0){let e2:[]u8="";return e2;}
    return spec[p2+1..spec.len];
}

// word between marker and endmark (for multi-word extraction)
fn word_between(text:[]u8, start_mark:[]u8, end_mark:[]u8)[]u8 {
    let s:i64=s_find(text,start_mark,0);
    if(s<0){let e:[]u8="";return e;}
    let bs:i64=s+start_mark.len;
    let e2:i64=s_find(text,end_mark,bs);
    if(e2<0){return text[bs..text.len];}
    return text[bs..e2];
}

fn gen_t4(cx:*Cx, spec:[]u8, demo:[]u8, installed:[]u8, card:[]u8)void {
    let goal:[]u8=spec_goal(spec);
    let g:[]u8=s_lower(goal);
    let c:i64=goal_concept(g);
    if(c==0){
        e_raw(cx,"UNKNOWN_GOAL\n");
        return;
    }
    // needs check
    let ok:i64=1;
    let miss:[]u8="";
    if(c==1){if(installed_has(installed,"p_math")==0){ok=0;miss="p_math";}}
    if(c==2){
        if(installed_has(installed,"p_search")==0){ok=0;miss="p_search";}
        if(installed_has(installed,"p_slice")==0){ok=0;miss="p_slice";}
    }
    if(c==3){if(installed_has(installed,"p_strrev")==0){ok=0;miss="p_strrev";}}
    if(c==4){if(installed_has(installed,"p_func")==0){ok=0;miss="p_func";}}
    if(c==5){if(installed_has(installed,"p_slice")==0){ok=0;miss="p_slice";}}
    if(c==6){
        if(installed_has(installed,"p_math")==0){ok=0;miss="p_math";}
        if(installed_has(installed,"p_loop")==0){ok=0;miss="p_loop";}
    }
    if(c==7){if(installed_has(installed,"p_strrev")==0){ok=0;miss="p_strrev";}}
    if(c==8){if(installed_has(installed,"p_func")==0){ok=0;miss="p_func";}}
    if(c==9){if(installed_has(installed,"p_struct")==0){ok=0;miss="p_struct";}}
    if(c==10){
        if(installed_has(installed,"p_math")==0){ok=0;miss="p_math";}
        if(installed_has(installed,"p_loop")==0){ok=0;miss="p_loop";}
    }
    if(c==11){
        if(installed_has(installed,"p_sort")==0){ok=0;miss="p_sort";}
        if(installed_has(installed,"p_search")==0){ok=0;miss="p_search";}
    }
    if(c==12){if(installed_has(installed,"p_argv")==0){ok=0;miss="p_argv";}}
    if(ok==0){
        if(c==12){
            if(card.len>0){
                t4_argvsum(cx,card);
                return;
            }
            e_raw(cx,"NEED_CARD:parse-int\n");
            return;
        }
        e_raw(cx,"UNTAUGHT:");
        e_raw(cx,miss);
        e_raw(cx,"\n");
        return;
    }
    let nums:[]i64=i64_arena(32);
    let nn:i64=s_numbers(g,nums);
    if(c==1){t4_lcm(cx,nums[0],nums[1]);return;}
    if(c==2){t4_count_occ(cx,nums[0],nums,1,nn-1);return;}
    if(c==3){
        let w:[]u8=word_after(g,"word ");
        t4_palindrome(cx,w);
        return;
    }
    if(c==4){t4_power(cx,nums[0],nums[1]);return;}
    if(c==5){t4_maxarr(cx,nums,0,nn);return;}
    if(c==6){t4_sumprimes(cx,nums[0]);return;}
    if(c==7){
        let w2:[]u8=word_between(g,"string "," to uppercase");
        t4_upper(cx,w2);
        return;
    }
    if(c==8){t4_clamp(cx,nums[0],nums[1],nums[2]);return;}
    if(c==9){t4_rectarea(cx,nums[0],nums[1]);return;}
    if(c==10){t4_fibsum(cx,nums[0]);return;}
    if(c==11){t4_selsort(cx,nums,0,nn);return;}
    if(c==12){t4_argvsum(cx,card);return;}
    return;
}

fn gen_t1(cx:*Cx, spec:[]u8, demo:[]u8, installed:[]u8)void {
    let class:[]u8=spec_class(spec);
    let need:[]u8="";
    if(s_eq(class,"FUNC")==1){need="p_func";}
    if(s_eq(class,"SLICE")==1){need="p_slice";}
    if(s_eq(class,"LOOP")==1){need="p_loop";}
    if(s_eq(class,"STR")==1){need="p_strcnt";}
    if(s_eq(class,"STRUCT")==1){need="p_struct";}
    if(s_eq(class,"ARGV")==1){need="p_argv";}
    if(need.len==0){
        e_raw(cx,"UNKNOWN_CLASS\n");
        return;
    }
    if(installed_has(installed,need)==0){
        e_raw(cx,"UNTAUGHT:");
        e_raw(cx,need);
        e_raw(cx,"\n");
        return;
    }
    if(s_eq(class,"FUNC")==1){emit_t1_func(cx,spec,demo);return;}
    if(s_eq(class,"SLICE")==1){emit_t1_slice(cx,spec,demo);return;}
    if(s_eq(class,"LOOP")==1){emit_t1_loop(cx,spec);return;}
    if(s_eq(class,"STR")==1){emit_t1_str(cx,spec,demo);return;}
    if(s_eq(class,"STRUCT")==1){emit_t1_struct(cx,spec,demo);return;}
    if(s_eq(class,"ARGV")==1){emit_t1_argv(cx);return;}
    return;
}

fn gen_t2(cx:*Cx, spec:[]u8, demo:[]u8, installed:[]u8)void {
    let class:[]u8=spec_class(spec);
    let need:[]u8="";
    if(s_eq(class,"SORT")==1){need="p_sort";}
    if(s_eq(class,"SEARCH")==1){need="p_search";}
    if(s_eq(class,"STR")==1){need="p_strrev";}
    if(s_eq(class,"MATH")==1){need="p_math";}
    if(s_eq(class,"SLICE")==1){need="p_slicefill";}
    if(need.len==0){
        e_raw(cx,"UNKNOWN_CLASS\n");
        return;
    }
    if(installed_has(installed,need)==0){
        e_raw(cx,"UNTAUGHT:");
        e_raw(cx,need);
        e_raw(cx,"\n");
        return;
    }
    if(s_eq(class,"SORT")==1){emit_t2_sort(cx,spec,demo);return;}
    if(s_eq(class,"SEARCH")==1){emit_t2_search(cx,spec,demo);return;}
    if(s_eq(class,"STR")==1){emit_t2_strrev(cx,spec,demo);return;}
    if(s_eq(class,"MATH")==1){emit_t2_math(cx,spec,demo);return;}
    if(s_eq(class,"SLICE")==1){emit_t2_squares(cx,spec,demo);return;}
    return;
}

fn do_gen()void {
    let spec:[]u8=_zag_arg(2);
    let installed:[]u8=_zag_arg(3);
    let demo:[]u8=_zag_arg(4);
    let card:[]u8=_zag_arg(5);
    // gate first: refuse banned requests before any generation
    let gr:i64=gate_hit(spec);
    if(gr!=0){
        _zag_print("REFUSED:G");
        _zag_print(_zag_i64_to_str(gr));
        _zag_print("\n");
        return;
    }
    let c:Cx=cx_new(65536);
    let cx:*Cx=&c;
    let tier:[]u8=spec[0..2];
    if(s_eq(tier,"T1")==1){gen_t1(cx,spec,demo,installed);}
    else if(s_eq(tier,"T2")==1){gen_t2(cx,spec,demo,installed);}
    else if(s_eq(tier,"T4")==1){gen_t4(cx,spec,demo,installed,card);}
    else {e_raw(cx,"UNKNOWN_TIER\n");}
    // self-review: brace balance; auto-close if short
    let out:[]u8=cx.*.b[0..cx.*.n];
    let depth:i64=0;
    let i:i64=0;
    while(i<out.len){
        if(out[i]==123){depth=depth+1;}
        if(out[i]==125){depth=depth-1;}
        i=i+1;
    }
    while(depth>0){e_raw(cx,"}\n");depth=depth-1;}
    let out2:[]u8=cx.*.b[0..cx.*.n];
    _zag_print(out2);
    return;
}

// ============ section 12: repair dispatch + main ============

fn do_repair()void {
    let eclass:[]u8=_zag_arg(2);
    let details:[]u8=_zag_arg(3);
    let src:[]u8=_zag_arg(4);
    let c:Cx=cx_new(src.len+512);
    let cx:*Cx=&c;
    let done:i64=0;
    if(s_eq(eclass,"E0203")==1){
        if(patch_ret_word(cx,src)==1){done=1;}
        else if(patch_arg_unquote(cx,src)==1){done=1;}
        else if(patch_del_badassign(cx,src)==1){done=1;}
    }
    if(s_eq(eclass,"UNKNOWNFN")==1){
        if(patch_unknownfn(cx,src,details)==1){done=1;}
    }
    if(s_eq(eclass,"ARITY")==1){
        let cpos:i64=s_find(details,":",0);
        let aname:[]u8=details;
        if(cpos>0){aname=details[0..cpos];}
        if(patch_arity(cx,src,aname)==1){done=1;}
    }
    if(s_eq(eclass,"PARSE")==1){
        if(patch_brace(cx,src)==1){done=1;}
    }
    if(s_eq(eclass,"DUPFN")==1){
        if(patch_dupfn(cx,src,details)==1){done=1;}
    }
    if(done==0){
        e_raw(cx,src);
    }
    let out:[]u8=cx.*.b[0..cx.*.n];
    _zag_print(out);
    return;
}

fn main()void {
    let mode:[]u8=_zag_arg(1);
    if(s_eq(mode,"teach")==1){do_teach();return;}
    if(s_eq(mode,"gen")==1){do_gen();return;}
    if(s_eq(mode,"repair")==1){do_repair();return;}
    if(s_eq(mode,"gate")==1){do_gate();return;}
    if(s_eq(mode,"delib")==1){do_delib();return;}
    _zag_print("UNKNOWN_MODE\n");
    return;
}

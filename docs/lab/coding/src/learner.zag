// learner.zag — CODING CREW (pure Zag, zero RNG).
// Micah order 2026-09-21: "try coding with it — teaching it with its insane generation speed."
// Modes (argv[1]): teach | gen | repair | gate | delib
//   teach <pattern-id> <PRACTICE_OK|PRACTICE_FAIL>
//   gen <spec> <installed-csv> <demo-csv> [manual-card]
//   repair <error-class> <details> <installed-csv> <demo-csv>
//       (broken source arrives via argv[6]; may contain newlines/quotes)
//   gate <spec-text>
//   delib <probe-id>
// State is threaded through *Cx (file-scope mutable globals are rejected by
// this znc build: E0204). No RNG anywhere. All decisions are pure functions
// of the inputs.

// ============ section 1: utils ============

struct Cx { b:[]u8, n:i64 }

fn cx_new(sz:i64)Cx {
    let c:Cx=Cx{};
    let p:*u8=_zag_malloc(sz) as *u8;
    c.b=p[0..sz];
    c.n=0;
    return c;
}

fn e_raw(cx:*Cx, s:[]u8)void {
    let b:[]u8=cx.*.b;
    let n:i64=cx.*.n;
    let i:i64=0;
    let m:i64=s.len;
    while(i<m){
        b[n]=s[i];
        n=n+1;
        i=i+1;
    }
    cx.*.n=n;
    return;
}

fn e_i64(cx:*Cx, v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    e_raw(cx,s);
    return;
}

fn s_eq(a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

// find first occurrence of needle in hay starting at `from`; -1 if absent
fn s_find(hay:[]u8, needle:[]u8, from:i64)i64 {
    let hn:i64=hay.len;
    let nn:i64=needle.len;
    if(nn==0){return from;}
    if(nn>hn){return -1;}
    let i:i64=from;
    while(i+nn<=hn){
        let j:i64=0;
        let ok:i64=1;
        while(j<nn){
            if(hay[i+j]!=needle[j]){ok=0;}
            j=j+1;
        }
        if(ok==1){return i;}
        i=i+1;
    }
    return -1;
}

fn s_has(hay:[]u8, needle:[]u8)i64 {
    if(s_find(hay,needle,0)>=0){return 1;}
    return 0;
}

// ASCII lowercase copy of s into a fresh buffer
fn s_lower(s:[]u8)[]u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let o:[]u8=p[0..s.len];
    let i:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=65){ if(c<=90){ c=(c+32) as u8; } }
        o[i]=c;
        i=i+1;
    }
    return o;
}

// extract all decimal integers from s into out (returns count)
fn s_numbers(s:[]u8, out:[]i64)i64 {
    let cnt:i64=0;
    let i:i64=0;
    let n:i64=s.len;
    while(i<n){
        let c:u8=s[i];
        if(c>=48){
            if(c<=57){
                let v:i64=0;
                while(i<n){
                    let d:u8=s[i];
                    if(d<48){break;}
                    if(d>57){break;}
                    v=v*10+((d as i64)-48);
                    i=i+1;
                }
                out[cnt]=v;
                cnt=cnt+1;
            } else { i=i+1; }
        } else { i=i+1; }
    }
    return cnt;
}

// get key= from a field like "name=add3"; returns value slice or ""
fn kv_get(field:[]u8, key:[]u8)[]u8 {
    let kl:i64=key.len;
    let pos:i64=s_find(field,key,0);
    if(pos<0){let e:[]u8="";return e;}
    if(pos+kl>=field.len){let e2:[]u8="";return e2;}
    if(field[pos+kl]!=61){let e3:[]u8="";return e3;}
    return field[pos+kl+1..field.len];
}

// installed-set membership: id ∈ csv where csv is "p_a,p_b,p_c"
fn installed_has(csv:[]u8, id:[]u8)i64 {
    // check (","+csv+",") contains (","+id+",")
    let n:i64=csv.len+2;
    let mp:*u8=_zag_malloc(n+1) as *u8;
    let w:[]u8=mp[0..n];
    w[0]=44;
    let i:i64=0;
    while(i<csv.len){w[1+i]=csv[i];i=i+1;}
    w[1+csv.len]=44;
    let n2:i64=id.len+2;
    let mp2:*u8=_zag_malloc(n2+1) as *u8;
    let pat:[]u8=mp2[0..n2];
    pat[0]=44;
    let k:i64=0;
    while(k<id.len){pat[1+k]=id[k];k=k+1;}
    pat[1+id.len]=44;
    return s_has(w,pat);
}

// ============ section 2: emit helpers ============

fn e_ch(cx:*Cx, c:u8)void {
    let b:[]u8=cx.*.b;
    let n:i64=cx.*.n;
    b[n]=c;
    cx.*.n=n+1;
    return;
}

fn e_argname(cx:*Cx, i:i64)void {
    e_ch(cx,(97+i) as u8);
    return;
}

// spec key lookup: spec_kv(spec,"name=") -> value until '|' or end
fn spec_kv(spec:[]u8, key:[]u8)[]u8 {
    let pos:i64=s_find(spec,key,0);
    if(pos<0){let e:[]u8="";return e;}
    let vs:i64=pos+key.len;
    if(vs>=spec.len){let e2:[]u8="";return e2;}
    let ve:i64=vs;
    while(ve<spec.len){
        if(spec[ve]==124){break;}
        ve=ve+1;
    }
    return spec[vs..ve];
}

// parse s split on sep byte into (starts,lens) offset pairs; returns count
fn split_parse(s:[]u8, arena:[]i64, maxf:i64, sep:u8)i64 {
    let fc:i64=0;
    let st:i64=0;
    let i:i64=0;
    while(i<s.len){
        if(s[i]==sep){
            if(fc<maxf){arena[fc]=st;arena[maxf+fc]=i-st;fc=fc+1;}
            st=i+1;
        }
        i=i+1;
    }
    if(fc<maxf){arena[fc]=st;arena[maxf+fc]=s.len-st;fc=fc+1;}
    return fc;
}

fn csv_parse(s:[]u8, arena:[]i64, maxf:i64)i64 {
    return split_parse(s,arena,maxf,44);
}

fn csv_field(s:[]u8, arena:[]i64, maxf:i64, f:i64)[]u8 {
    let a:i64=arena[f];
    let l:i64=arena[maxf+f];
    return s[a..a+l];
}

// fresh []i64 arena of n entries (single cast — no aliasing risk)
fn i64_arena(n:i64)[]i64 {
    let p:*u8=_zag_malloc(n*8) as *u8;
    return p[0..n*8] as []i64;
}

// ============ section 3: T1 emits ============

// T1|FUNC|name=..|args=..|ret=..|op=..   demo: csv of arg values
// T1|FUNC|name=..|arity=N|op=..   demo: name(arg,arg,...)
// T1|FUNC|name=..|args=..|ret=..|op=..   demo: csv of arg values; ';' separates multiple demo calls
fn emit_t1_func(cx:*Cx, spec:[]u8, demo:[]u8)void {
    let name:[]u8=spec_kv(spec,"name=");
    let argstr:[]u8=spec_kv(spec,"args=");
    let ret:[]u8=spec_kv(spec,"ret=");
    let op:[]u8=spec_kv(spec,"op=");
    let aa:[]i64=i64_arena(16);
    let na:i64=csv_parse(argstr,aa,8);
    e_raw(cx,"fn ");
    e_raw(cx,name);
    e_raw(cx,"(");
    let i:i64=0;
    while(i<na){
        e_argname(cx,i);
        e_ch(cx,58);
        e_raw(cx,csv_field(argstr,aa,8,i));
        if(i+1<na){e_raw(cx,",");}
        i=i+1;
    }
    e_raw(cx,")");
    e_raw(cx,ret);
    e_raw(cx," {\n");
    if(s_eq(op,"sum")==1){
        e_raw(cx,"    return ");
        i=0;
        while(i<na){
            e_argname(cx,i);
            if(i+1<na){e_raw(cx,"+");}
            i=i+1;
        }
        e_raw(cx,";\n");
    }
    if(s_eq(op,"max")==1){
        e_raw(cx,"    if(a>b){return a;}\n");
        e_raw(cx,"    return b;\n");
    }
    if(s_eq(op,"fact")==1){
        e_raw(cx,"    let r:i64=1;\n");
        e_raw(cx,"    let k:i64=2;\n");
        e_raw(cx,"    while(k<=a){r=r*k;k=k+1;}\n");
        e_raw(cx,"    return r;\n");
    }
    if(s_eq(op,"is_even")==1){
        e_raw(cx,"    if(a%2==0){return 1;}\n");
        e_raw(cx,"    return 0;\n");
    }
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    // demo calls separated by ';'
    let ca:[]i64=i64_arena(16);
    let nc:i64=split_parse(demo,ca,8,59);
    i=0;
    while(i<nc){
        let call:[]u8=csv_field(demo,ca,8,i);
        e_raw(cx,"    let r");
        e_i64(cx,i);
        e_raw(cx,":");
        e_raw(cx,ret);
        e_raw(cx,"=");
        e_raw(cx,name);
        e_raw(cx,"(");
        e_raw(cx,call);
        e_raw(cx,");\n");
        e_raw(cx,"    _zag_print(_zag_i64_to_str(r");
        e_i64(cx,i);
        e_raw(cx," as i64));\n");
        e_raw(cx,"    _zag_print(\"\\n\");\n");
        i=i+1;
    }
    e_raw(cx,"}\n");
    return;
}

// T1|SLICE|name=..|type=..|op=..   demo: csv of element values
fn emit_t1_slice(cx:*Cx, spec:[]u8, demo:[]u8)void {
    let name:[]u8=spec_kv(spec,"name=");
    let op:[]u8=spec_kv(spec,"op=");
    let da:[]i64=i64_arena(32);
    let nd:i64=csv_parse(demo,da,16);
    e_raw(cx,"fn ");
    e_raw(cx,name);
    e_raw(cx,"(a:[]i64,n:i64)i64 {\n");
    e_raw(cx,"    let s:i64=0;\n");
    e_raw(cx,"    let i:i64=0;\n");
    if(s_eq(op,"sum")==1){
        e_raw(cx,"    while(i<n){s=s+a[i];i=i+1;}\n");
    }
    if(s_eq(op,"count_pos")==1){
        e_raw(cx,"    while(i<n){if(a[i]>0){s=s+1;}i=i+1;}\n");
    }
    e_raw(cx,"    return s;\n");
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"    let p:*u8=_zag_malloc(");
    e_i64(cx,nd*8);
    e_raw(cx,") as *u8;\n");
    e_raw(cx,"    let arr:[]i64=p[0..");
    e_i64(cx,nd*8);
    e_raw(cx,"] as []i64;\n");
    let i:i64=0;
    while(i<nd){
        e_raw(cx,"    arr[");
        e_i64(cx,i);
        e_raw(cx,"]=");
        e_raw(cx,csv_field(demo,da,16,i));
        e_raw(cx,";\n");
        i=i+1;
    }
    e_raw(cx,"    let r:i64=");
    e_raw(cx,name);
    e_raw(cx,"(arr,");
    e_i64(cx,nd);
    e_raw(cx,");\n");
    e_raw(cx,"    _zag_print(_zag_i64_to_str(r));\n");
    e_raw(cx,"    _zag_print(\"\\n\");\n");
    e_raw(cx,"}\n");
    return;
}

// T1|LOOP|name=..|n=..|op=sum
fn emit_t1_loop(cx:*Cx, spec:[]u8)void {
    let n:[]u8=spec_kv(spec,"n=");
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"    let s:i64=0;\n");
    e_raw(cx,"    let i:i64=1;\n");
    e_raw(cx,"    while(i<=");
    e_raw(cx,n);
    e_raw(cx,"){s=s+i;i=i+1;}\n");
    e_raw(cx,"    _zag_print(_zag_i64_to_str(s));\n");
    e_raw(cx,"    _zag_print(\"\\n\");\n");
    e_raw(cx,"}\n");
    return;
}

// T1|STR|name=..|ch=..|op=count_ch   demo: the string literal text
fn emit_t1_str(cx:*Cx, spec:[]u8, demo:[]u8)void {
    let name:[]u8=spec_kv(spec,"name=");
    let ch:[]u8=spec_kv(spec,"ch=");
    // demo is "string,code": the haystack is up to the first comma
    let cp:i64=s_find(demo,",",0);
    let hay:[]u8=demo;
    if(cp>=0){hay=demo[0..cp];}
    e_raw(cx,"fn ");
    e_raw(cx,name);
    e_raw(cx,"(s:[]u8,n:i64,ch:u8)i64 {\n");
    e_raw(cx,"    let c:i64=0;\n");
    e_raw(cx,"    let i:i64=0;\n");
    e_raw(cx,"    while(i<n){if(s[i]==ch){c=c+1;}i=i+1;}\n");
    e_raw(cx,"    return c;\n");
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"    let s:[]u8=\"");
    e_raw(cx,hay);
    e_raw(cx,"\";\n");
    e_raw(cx,"    let r:i64=");
    e_raw(cx,name);
    e_raw(cx,"(s,");
    e_i64(cx,hay.len);
    e_raw(cx,",");
    e_raw(cx,ch);
    e_raw(cx,");\n");
    e_raw(cx,"    _zag_print(_zag_i64_to_str(r));\n");
    e_raw(cx,"    _zag_print(\"\\n\");\n");
    e_raw(cx,"}\n");
    return;
}

// T1|STRUCT|name=..|fields=..|op=manhattan   demo: "3,4"
fn emit_t1_struct(cx:*Cx, spec:[]u8, demo:[]u8)void {
    let da:[]i64=i64_arena(8);
    let nd:i64=csv_parse(demo,da,4);
    e_raw(cx,"struct Point { x:i64, y:i64 }\n");
    e_raw(cx,"fn manhattan(p:Point)i64 {\n");
    e_raw(cx,"    let ax:i64=p.x;\n");
    e_raw(cx,"    if(ax<0){ax=0-ax;}\n");
    e_raw(cx,"    let ay:i64=p.y;\n");
    e_raw(cx,"    if(ay<0){ay=0-ay;}\n");
    e_raw(cx,"    return ax+ay;\n");
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"    let p:Point=Point{};\n");
    e_raw(cx,"    p.x=");
    e_raw(cx,csv_field(demo,da,4,0));
    e_raw(cx,";\n");
    e_raw(cx,"    p.y=");
    e_raw(cx,csv_field(demo,da,4,1));
    e_raw(cx,";\n");
    e_raw(cx,"    let r:i64=manhattan(p);\n");
    e_raw(cx,"    _zag_print(_zag_i64_to_str(r));\n");
    e_raw(cx,"    _zag_print(\"\\n\");\n");
    e_raw(cx,"}\n");
    return;
}

// T1|ARGV|name=..|op=count
fn emit_t1_argv(cx:*Cx)void {
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"    let c:i64=0;\n");
    e_raw(cx,"    if(_zag_arg(1).len>0){c=c+1;}\n");
    e_raw(cx,"    if(_zag_arg(2).len>0){c=c+1;}\n");
    e_raw(cx,"    if(_zag_arg(3).len>0){c=c+1;}\n");
    e_raw(cx,"    _zag_print(_zag_i64_to_str(c));\n");
    e_raw(cx,"    _zag_print(\"\\n\");\n");
    e_raw(cx,"}\n");
    return;
}

// ============ section 4: T2 emits ============

// shared: emit array build from demo csv into "arr", returns n
fn e_build_arr(cx:*Cx, demo:[]u8, da:[]i64, nd:i64)void {
    e_raw(cx,"    let p:*u8=_zag_malloc(");
    e_i64(cx,nd*8);
    e_raw(cx,") as *u8;\n");
    e_raw(cx,"    let arr:[]i64=p[0..");
    e_i64(cx,nd*8);
    e_raw(cx,"] as []i64;\n");
    let i:i64=0;
    while(i<nd){
        e_raw(cx,"    arr[");
        e_i64(cx,i);
        e_raw(cx,"]=");
        e_raw(cx,csv_field(demo,da,16,i));
        e_raw(cx,";\n");
        i=i+1;
    }
    return;
}

// build array from nums[off..off+cnt]
fn e_build_arr_nums(cx:*Cx, nums:[]i64, off:i64, cnt:i64)void {
    e_raw(cx,"    let p:*u8=_zag_malloc(");
    e_i64(cx,cnt*8);
    e_raw(cx,") as *u8;\n");
    e_raw(cx,"    let arr:[]i64=p[0..");
    e_i64(cx,cnt*8);
    e_raw(cx,"] as []i64;\n");
    let i:i64=0;
    while(i<cnt){
        e_raw(cx,"    arr[");
        e_i64(cx,i);
        e_raw(cx,"]=");
        e_i64(cx,nums[off+i]);
        e_raw(cx,";\n");
        i=i+1;
    }
    return;
}

fn e_print_arr(cx:*Cx, nd:i64)void {
    e_raw(cx,"    let pi:i64=0;\n");
    e_raw(cx,"    while(pi<");
    e_i64(cx,nd);
    e_raw(cx,"){\n");
    e_raw(cx,"        _zag_print(_zag_i64_to_str(arr[pi]));\n");
    e_raw(cx,"        if(pi+1<");
    e_i64(cx,nd);
    e_raw(cx,"){_zag_print(\" \");}\n");
    e_raw(cx,"        pi=pi+1;\n");
    e_raw(cx,"    }\n");
    e_raw(cx,"    _zag_print(\"\\n\");\n");
    return;
}

// T2|SORT|name=..|type=..|dir=asc|desc   demo: csv values
fn emit_t2_sort(cx:*Cx, spec:[]u8, demo:[]u8)void {
    let name:[]u8=spec_kv(spec,"name=");
    let dir:[]u8=spec_kv(spec,"dir=");
    let da:[]i64=i64_arena(32);
    let nd:i64=csv_parse(demo,da,16);
    let cmp:[]u8=">";
    if(s_eq(dir,"desc")==1){ cmp="<"; }
    e_raw(cx,"fn ");
    e_raw(cx,name);
    e_raw(cx,"(a:[]i64,n:i64)void {\n");
    e_raw(cx,"    let i:i64=0;\n");
    e_raw(cx,"    while(i<n){\n");
    e_raw(cx,"        let j:i64=0;\n");
    e_raw(cx,"        while(j+1<n-i){\n");
    e_raw(cx,"            if(a[j]");
    e_raw(cx,cmp);
    e_raw(cx,"a[j+1]){\n");
    e_raw(cx,"                let t:i64=a[j];\n");
    e_raw(cx,"                a[j]=a[j+1];\n");
    e_raw(cx,"                a[j+1]=t;\n");
    e_raw(cx,"            }\n");
    e_raw(cx,"            j=j+1;\n");
    e_raw(cx,"        }\n");
    e_raw(cx,"        i=i+1;\n");
    e_raw(cx,"    }\n");
    e_raw(cx,"    return;\n");
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    e_build_arr(cx,demo,da,nd);
    e_raw(cx,"    ");
    e_raw(cx,name);
    e_raw(cx,"(arr,");
    e_i64(cx,nd);
    e_raw(cx,");\n");
    e_print_arr(cx,nd);
    e_raw(cx,"}\n");
    return;
}

// T2|SEARCH|name=..|type=..|op=find   demo: csv values; query from spec |query=
// parse a decimal integer field (optional leading -) to i64
fn num_val(s:[]u8)i64 {
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    let v:i64=0;
    while(i<s.len){
        if(s[i]>=48){if(s[i]<=57){v=v*10+((s[i] as i64)-48);}}
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

fn emit_t2_search(cx:*Cx, spec:[]u8, demo:[]u8)void {
    let name:[]u8=spec_kv(spec,"name=");
    // demo queries separated by ';' (e.g. "8;6").
    // Demonstration rule: build a 5-element template array placing the first
    // query at index 2, so the demo shows a hit (index 2) and (typically) a miss.
    let qa:[]i64=i64_arena(16);
    let nq:i64=split_parse(demo,qa,8,59);
    let qnums:[]i64=i64_arena(16);
    let qi:i64=0;
    while(qi<nq){
        let qf:[]u8=csv_field(demo,qa,8,qi);
        qnums[qi]=num_val(qf);
        qi=qi+1;
    }
    let q1:i64=0;
    if(nq>0){q1=qnums[0];}
    e_raw(cx,"fn ");
    e_raw(cx,name);
    e_raw(cx,"(a:[]i64,n:i64,v:i64)i64 {\n");
    e_raw(cx,"    let i:i64=0;\n");
    e_raw(cx,"    while(i<n){\n");
    e_raw(cx,"        if(a[i]==v){return i;}\n");
    e_raw(cx,"        i=i+1;\n");
    e_raw(cx,"    }\n");
    e_raw(cx,"    return -1;\n");
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"    let mp:*i64=_zag_malloc(40) as *i64;\n");
    e_raw(cx,"    let arr:[]i64=mp[0..5];\n");
    e_raw(cx,"    arr[0]=51;arr[1]=22;arr[2]=");
    e_i64(cx,q1);
    e_raw(cx,";arr[3]=11;arr[4]=99;\n");
    qi=0;
    while(qi<nq){
        e_raw(cx,"    _zag_print(_zag_i64_to_str(");
        e_raw(cx,name);
        e_raw(cx,"(arr,5,");
        e_i64(cx,qnums[qi]);
        e_raw(cx,")));\n");
        e_raw(cx,"    _zag_print(\"\\n\");\n");
        qi=qi+1;
    }
    e_raw(cx,"}\n");
    return;
}

fn emit_t2_strrev(cx:*Cx, spec:[]u8, demo:[]u8)void {
    let name:[]u8=spec_kv(spec,"name=");
    e_raw(cx,"fn ");
    e_raw(cx,name);
    e_raw(cx,"(s:[]u8,n:i64)void {\n");
    e_raw(cx,"    let i:i64=0;\n");
    e_raw(cx,"    while(i<n/2){\n");
    e_raw(cx,"        let t:u8=s[i];\n");
    e_raw(cx,"        s[i]=s[n-1-i];\n");
    e_raw(cx,"        s[n-1-i]=t;\n");
    e_raw(cx,"        i=i+1;\n");
    e_raw(cx,"    }\n");
    e_raw(cx,"    return;\n");
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"    let q:*u8=_zag_malloc(");
    e_i64(cx,demo.len);
    e_raw(cx,") as *u8;\n");
    e_raw(cx,"    let s:[]u8=q[0..");
    e_i64(cx,demo.len);
    e_raw(cx,"];\n");
    e_raw(cx,"    let lit:[]u8=\"");
    e_raw(cx,demo);
    e_raw(cx,"\";\n");
    e_raw(cx,"    let ci:i64=0;\n");
    e_raw(cx,"    while(ci<");
    e_i64(cx,demo.len);
    e_raw(cx,"){s[ci]=lit[ci];ci=ci+1;}\n");
    e_raw(cx,"    ");
    e_raw(cx,name);
    e_raw(cx,"(s,");
    e_i64(cx,demo.len);
    e_raw(cx,");\n");
    e_raw(cx,"    _zag_print(s);\n");
    e_raw(cx,"    _zag_print(\"\\n\");\n");
    e_raw(cx,"}\n");
    return;
}

// T2|MATH|name=..|args=..|op=gcd|is_prime|fib   demo: csv arg values
fn emit_t2_math(cx:*Cx, spec:[]u8, demo:[]u8)void {
    let name:[]u8=spec_kv(spec,"name=");
    let argstr:[]u8=spec_kv(spec,"args=");
    let op:[]u8=spec_kv(spec,"op=");
    let aa:[]i64=i64_arena(16);
    let na:i64=csv_parse(argstr,aa,8);
    let da:[]i64=i64_arena(16);
    let nd:i64=csv_parse(demo,da,8);
    e_raw(cx,"fn ");
    e_raw(cx,name);
    e_raw(cx,"(");
    let i:i64=0;
    while(i<na){
        e_argname(cx,i);
        e_raw(cx,":i64");
        if(i+1<na){e_raw(cx,",");}
        i=i+1;
    }
    e_raw(cx,")i64 {\n");
    if(s_eq(op,"gcd")==1){
        e_raw(cx,"    let x:i64=a;\n");
        e_raw(cx,"    let y:i64=b;\n");
        e_raw(cx,"    while(y!=0){\n");
        e_raw(cx,"        let t:i64=x%y;\n");
        e_raw(cx,"        x=y;\n");
        e_raw(cx,"        y=t;\n");
        e_raw(cx,"    }\n");
        e_raw(cx,"    return x;\n");
    }
    if(s_eq(op,"is_prime")==1){
        e_raw(cx,"    if(a<2){return 0;}\n");
        e_raw(cx,"    let d:i64=2;\n");
        e_raw(cx,"    while(d*d<=a){\n");
        e_raw(cx,"        if(a%d==0){return 0;}\n");
        e_raw(cx,"        d=d+1;\n");
        e_raw(cx,"    }\n");
        e_raw(cx,"    return 1;\n");
    }
    if(s_eq(op,"fib")==1){
        e_raw(cx,"    if(a<2){return a;}\n");
        e_raw(cx,"    let x:i64=0;\n");
        e_raw(cx,"    let y:i64=1;\n");
        e_raw(cx,"    let i:i64=2;\n");
        e_raw(cx,"    while(i<=a){\n");
        e_raw(cx,"        let z:i64=x+y;\n");
        e_raw(cx,"        x=y;\n");
        e_raw(cx,"        y=z;\n");
        e_raw(cx,"        i=i+1;\n");
        e_raw(cx,"    }\n");
        e_raw(cx,"    return y;\n");
    }
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    // demo: calls separated by ';', args within a call by ','
    let ca:[]i64=i64_arena(16);
    let nc:i64=split_parse(demo,ca,8,59);
    i=0;
    while(i<nc){
        let call:[]u8=csv_field(demo,ca,8,i);
        e_raw(cx,"    _zag_print(_zag_i64_to_str(");
        e_raw(cx,name);
        e_raw(cx,"(");
        e_raw(cx,call);
        e_raw(cx,")));\n");
        e_raw(cx,"    _zag_print(\"\\n\");\n");
        i=i+1;
    }
    e_raw(cx,"}\n");
    return;
}

// T2|SLICE|name=..|type=..|op=squares   demo: "6" (fill 0..5)
fn emit_t2_squares(cx:*Cx, spec:[]u8, demo:[]u8)void {
    let name:[]u8=spec_kv(spec,"name=");
    // demo is a range "lo..hi" (e.g. "0..5"); n = hi-lo+1
    let dd:i64=s_find(demo,"..",0);
    let lo:i64=0;
    let hi:i64=0;
    if(dd>=0){
        lo=num_val(demo[0..dd]);
        hi=num_val(demo[dd+2..demo.len]);
    }
    let n:i64=hi-lo+1;
    e_raw(cx,"fn ");
    e_raw(cx,name);
    e_raw(cx,"(a:[]i64,n:i64)void {\n");
    e_raw(cx,"    let i:i64=0;\n");
    e_raw(cx,"    while(i<n){a[i]=i*i;i=i+1;}\n");
    e_raw(cx,"    return;\n");
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"    let mp:*i64=_zag_malloc(");
    e_i64(cx,n*8);
    e_raw(cx,") as *i64;\n");
    e_raw(cx,"    let arr:[]i64=mp[0..");
    e_i64(cx,n);
    e_raw(cx,"];\n");
    e_raw(cx,"    ");
    e_raw(cx,name);
    e_raw(cx,"(arr,");
    e_i64(cx,n);
    e_raw(cx,");\n");
    e_raw(cx,"    let pi:i64=0;\n");
    e_raw(cx,"    while(pi<");
    e_i64(cx,n);
    e_raw(cx,"){\n");
    e_raw(cx,"        _zag_print(_zag_i64_to_str(arr[pi]));\n");
    e_raw(cx,"        if(pi+1<");
    e_i64(cx,n);
    e_raw(cx,"){_zag_print(\" \");}\n");
    e_raw(cx,"        pi=pi+1;\n");
    e_raw(cx,"    }\n");
    e_raw(cx,"    _zag_print(\"\\n\");\n");
    e_raw(cx,"}\n");
    return;
}

// ============ section 5: T4 GOAL composition ============

// word_after: text following marker up to next space (or end)
fn word_after(text:[]u8, marker:[]u8)[]u8 {
    let pos:i64=s_find(text,marker,0);
    if(pos<0){let e:[]u8="";return e;}
    let st:i64=pos+marker.len;
    let en:i64=st;
    while(en<text.len){
        if(text[en]==32){break;}
        en=en+1;
    }
    return text[st..en];
}

// concept ids
// 1=lcm 2=count_occ 3=palindrome 4=power 5=maxarr 6=sumprimes
// 7=upper 8=clamp 9=rectarea 10=fibsum 11=selsort 12=argvsum 0=unknown
fn goal_concept(g:[]u8)i64 {
    if(s_has(g,"least common multiple")==1){return 1;}
    if(s_has(g,"lcm")==1){return 1;}
    if(s_has(g,"selection sort")==1){return 11;}
    if(s_has(g,"same forwards and backwards")==1){return 3;}
    if(s_has(g,"palindrome")==1){return 3;}
    if(s_has(g,"fibonacci")==1){return 10;}
    if(s_has(g,"prime")==1){return 6;}
    if(s_has(g,"raised to")==1){return 4;}
    if(s_has(g,"power")==1){return 4;}
    if(s_has(g,"uppercase")==1){return 7;}
    if(s_has(g,"clamp")==1){return 8;}
    if(s_has(g,"rectangle")==1){return 9;}
    if(s_has(g,"largest")==1){return 5;}
    if(s_has(g,"maximum")==1){return 5;}
    if(s_has(g,"command-line arguments")==1){return 12;}
    if(s_has(g,"how many times")==1){return 2;}
    if(s_has(g,"count how many")==1){return 2;}
    return 0;
}

// ---- T4 emits (each: full program) ----

fn t4_lcm(cx:*Cx, a:i64, b:i64)void {
    e_raw(cx,"fn gcd(a:i64,b:i64)i64 {\n");
    e_raw(cx,"    let x:i64=a;\n");
    e_raw(cx,"    let y:i64=b;\n");
    e_raw(cx,"    while(y!=0){\n");
    e_raw(cx,"        let t:i64=x%y;\n");
    e_raw(cx,"        x=y;\n");
    e_raw(cx,"        y=t;\n");
    e_raw(cx,"    }\n");
    e_raw(cx,"    return x;\n");
    e_raw(cx,"}\n");
    e_raw(cx,"fn main()void {\n");
    e_raw(cx,"    let g:i64=gcd(");
    e_i64(cx,a);e_raw(cx,",");e_i64(cx,b);
    e_raw(cx,");\n");
    e_raw(cx,"    let l:i64=");
    e_i64(cx,a);e_raw(cx,"*");e_i64(cx,b);
    e_raw(cx,"/g;\n");
    e_raw(cx,"    _zag_print(_zag_i64_to_str(l));\n");
    e_raw(cx,"    _zag_print(\"\\n\");\n");
    e_raw(cx,"}\n");
    return;
}


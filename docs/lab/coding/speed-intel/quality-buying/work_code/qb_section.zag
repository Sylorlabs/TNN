
// ============ section 15: QB deeper deliberation (2026-09-22, additive) ============
//
// The QB experiment varies deliberation STRUCTURE at the fixed knee budget
// (4 iterations). All arms keep the 3a/3b/3c combo machinery as the floor:
// the deeper path first runs the combo scoring block (verbatim copy of the
// mask "ab" branch of diag_compile: 3a prune, then 3b branch-and-bound over
// the pruned survivor set), then adds deliberation steps on top.
//
// qbmode arrives as diagnose argv[10]. main() dispatches here only for
// d1..d5; "" and "d0" take the original do_diagnose path byte-identically.
//
// Deeper paths engage on the COMPILE/PRECHECK branch (the scored 5-class
// deliberation). GEN and TEST branches keep baseline behavior: GEN is an
// honest-halt decision and TEST has no class scoring to deepen.
//
// hyp-eval accounting (added to dr.*.evals, documented in RESULTS_QB_CODE.md):
//   floor: combo-block scorer evaluations (as in D0)
//   +1 per class scorer run to complete bnb-skipped survivors
//   D1: +1 for the contested deliberation (only when contested)
//   D2: +1 per critic round executed
//   D3: +1 per candidate patch produced, +1 for the competition round
//   D4: +1 CRITIQUE phase, +1 COUNTER-HYPOTHESIZE phase
//
// Frozen constants: D1 conflict margin = 2 points (runner-up must also
// score > 0); D2 K = 3 critic rounds, max 2 re-drafts per iteration.

// 1 iff diagnose argv[10] selects a deeper QB mode (d1..d5)
fn qb_mode_active()i64 {
    let m:[]u8=_zag_arg(10);
    if(s_eq(m,"d1")==1){return 1;}
    if(s_eq(m,"d2")==1){return 1;}
    if(s_eq(m,"d3")==1){return 1;}
    if(s_eq(m,"d4")==1){return 1;}
    if(s_eq(m,"d5")==1){return 1;}
    return 0;
}

// frozen tie-priority rank (lower wins): SYNTAX 1 < DUPFN 2 < NAME 3 < ARITY 4 < TYPE 5
fn qb_prank(cls:i64)i64 {
    if(cls==1){return 1;}
    if(cls==5){return 2;}
    if(cls==2){return 3;}
    if(cls==3){return 4;}
    return 5;
}

// rank classes 1..5 by score desc, frozen-priority asc into out[0..4]
fn qb_rank(sc:[]i64, out:[]i64)void {
    let o:i64=0;
    while(o<5){
        let bc:i64=1;
        let bs:i64=-1;
        let bp:i64=99;
        let c:i64=1;
        while(c<=5){
            let skip:i64=0;
            let k:i64=0;
            while(k<o){
                if(out[k]==c){skip=1;}
                k=k+1;
            }
            if(skip==0){
                let s2:i64=sc[c];
                let p2:i64=qb_prank(c);
                if(s2>bs){bc=c;bs=s2;bp=p2;}
                if(s2==bs){if(p2<bp){bc=c;bp=p2;}}
            }
            c=c+1;
        }
        out[o]=bc;
        o=o+1;
    }
    return;
}

// count of independent evidence bits supporting class cls, mirroring the
// sc_* scoring conditions (D1 evidence marshaling)
fn qb_evidence_count(cls:i64, has_parse:i64, brace_bad:i64, has_unknown:i64, qn_len:i64, qndef:i64, qsim:i64, has_argument:i64, nn:i64, has_expfound:i64, has_e0203:i64, has_typetok:i64, has_dup:i64)i64 {
    let n:i64=0;
    if(cls==1){
        if(has_parse==1){n=n+1;}
        if(brace_bad==1){n=n+1;}
    }
    if(cls==2){
        if(has_unknown==1){n=n+1;}
        if(qn_len>0){if(qndef==0){n=n+1;}}
        if(qsim==1){n=n+1;}
    }
    if(cls==3){
        if(has_argument==1){n=n+1;}
        if(nn>=2){if(qn_len>0){if(qndef>0){n=n+1;}}}
    }
    if(cls==4){
        if(has_expfound==1){n=n+1;}
        if(has_e0203==1){n=n+1;}
        if(has_expfound==1){if(has_typetok==1){n=n+1;}}
    }
    if(cls==5){
        if(has_dup==1){n=n+1;}
        if(qn_len>0){if(qndef>=2){n=n+1;}}
    }
    return n;
}

// precheck step 2 as predicate: 1 iff every call site names a defined fn or intrinsic
fn qb_names_ok(src:[]u8)i64 {
    let arena:[]i64=i64_arena(192);
    let nc:i64=pc_calls(src,arena,64);
    let k:i64=0;
    while(k<nc){
        let nstart:i64=arena[k];
        let nlen:i64=arena[64+k];
        let name:[]u8=src[nstart..nstart+nlen];
        if(pc_intrinsic_arity(name)<0){
            if(fn_defined(src,name)==0){return 0;}
        }
        k=k+1;
    }
    return 1;
}

// precheck step 3 as predicate: 1 iff no duplicate definitions
fn qb_dup_ok(src:[]u8)i64 {
    let da:[]i64=i64_arena(64);
    let nd:i64=find_fn_defs(src,da,32);
    let j:i64=0;
    while(j<nd){
        let dstart:i64=da[j];
        let dlen:i64=da[32+j];
        let dnm:[]u8=src[dstart..dstart+dlen];
        if(count_def(src,dnm)>=2){return 0;}
        j=j+1;
    }
    return 1;
}

// precheck step 4 as predicate: 1 iff every call matches its definition arity
fn qb_arity_ok(src:[]u8)i64 {
    let arena:[]i64=i64_arena(192);
    let nc:i64=pc_calls(src,arena,64);
    let k:i64=0;
    while(k<nc){
        let nstart:i64=arena[k];
        let nlen:i64=arena[64+k];
        let pi:i64=arena[128+k];
        let name:[]u8=src[nstart..nstart+nlen];
        let ia:i64=pc_intrinsic_arity(name);
        let nparams:i64=ia;
        if(ia<0){nparams=pc_def_params(src,name);}
        if(nparams>=0){
            let close:i64=pc_match_paren(src,pi);
            if(close>0){
                let nargs:i64=count_args(src[pi+1..close]);
                if(nargs!=nparams){return 0;}
            }
        }
        k=k+1;
    }
    return 1;
}

// cross-check cleanliness 0..4 (D3 scoring component)
fn qb_cross_clean(src:[]u8)i64 {
    let c:i64=0;
    if(pc_braces_ok(src)==1){c=c+1;}
    if(qb_names_ok(src)==1){c=c+1;}
    if(qb_dup_ok(src)==1){c=c+1;}
    if(qb_arity_ok(src)==1){c=c+1;}
    return c;
}

// 1 iff name has at least one call site (non-definition) in src
fn qb_has_calls(src:[]u8, name:[]u8)i64 {
    let arena:[]i64=i64_arena(192);
    let nc:i64=pc_calls(src,arena,64);
    let k:i64=0;
    while(k<nc){
        let nstart:i64=arena[k];
        let nlen:i64=arena[64+k];
        if(nlen==name.len){
            if(s_eq(src[nstart..nstart+nlen],name)==1){return 1;}
        }
        k=k+1;
    }
    return 0;
}

// 1 iff every call site of name in src matches its definition arity
fn qb_arity_fixed_for(src:[]u8, name:[]u8)i64 {
    let nparams:i64=pc_def_params(src,name);
    if(nparams<0){return 0;}
    let arena:[]i64=i64_arena(192);
    let nc:i64=pc_calls(src,arena,64);
    let k:i64=0;
    while(k<nc){
        let nstart:i64=arena[k];
        let nlen:i64=arena[64+k];
        let pi:i64=arena[128+k];
        if(nlen==name.len){
            if(s_eq(src[nstart..nstart+nlen],name)==1){
                let close:i64=pc_match_paren(src,pi);
                if(close>0){
                    let nargs:i64=count_args(src[pi+1..close]);
                    if(nargs!=nparams){return 0;}
                }
            }
        }
        k=k+1;
    }
    return 1;
}

// 1 iff the diagnosed class's trigger defect is addressed in draft
// (D2 cross-check 4; D3 trigger-presence component)
fn qb_trigger_fixed(cls:i64, draft:[]u8, src:[]u8, qn:[]u8)i64 {
    if(cls==1){
        return pc_braces_ok(draft);
    }
    if(cls==2){
        if(qn.len==0){return 1;}
        if(qb_has_calls(draft,qn)==0){return 1;}
        return fn_defined(draft,qn);
    }
    if(cls==3){
        if(qn.len==0){return 1;}
        return qb_arity_fixed_for(draft,qn);
    }
    if(cls==4){
        // no static re-derivation of compiler type evidence exists; the
        // checkable fact is that a type patch was applied at all
        if(s_eq(draft,src)==0){return 1;}
        return 0;
    }
    if(cls==5){
        if(qn.len==0){return 1;}
        if(count_def(draft,qn)<2){return 1;}
        return 0;
    }
    return 1;
}

// D4 CRITIQUE: 1 iff the shared evidence refutes the leading hypothesis.
// Each refutation is a source cross-check contradicting the leader's
// highest-weight evidence bit.
fn qb_refuted(cls:i64, src:[]u8, qn:[]u8, qndef:i64, brace_bad:i64)i64 {
    if(cls==1){
        // brace-crosscheck evidence, but the string-aware brace check passes:
        // the naive brace signal that fed the score is unreliable
        if(brace_bad==1){if(pc_braces_ok(src)==1){return 1;}}
        return 0;
    }
    if(cls==2){
        // the evidence-named function IS defined in the source: the
        // unknown-word evidence is stale or names the wrong identifier
        if(qn.len>0){if(qndef>0){return 1;}}
        return 0;
    }
    if(cls==3){
        // every call to the named fn already matches its definition arity
        if(qn.len>0){if(qb_arity_fixed_for(src,qn)==1){return 1;}}
        return 0;
    }
    if(cls==4){
        // TYPE evidence is compiler vocabulary; no static cross-check can
        // refute it. The attack fails; the leader stands.
        return 0;
    }
    if(cls==5){
        // fewer than two definitions of the named fn exist in the source
        if(qn.len>0){if(count_def(src,qn)<2){return 1;}}
        return 0;
    }
    return 0;
}

// strategy name for (class, branch); branch 0 = floor behavior
fn qb_strat_name(cls:i64, branch:i64)[]u8 {
    if(cls==1){let s:[]u8="patch-brace";return s;}
    if(cls==2){let s2:[]u8="patch-unknownfn";return s2;}
    if(cls==3){let s3:[]u8="patch-arity";return s3;}
    if(cls==4){
        if(branch==1){let a:[]u8="patch-type-argunquote";return a;}
        if(branch==2){let d:[]u8="patch-type-delbadassign";return d;}
        let r:[]u8="patch-type-retword";return r;
    }
    if(cls==5){let s5:[]u8="patch-dupfn";return s5;}
    let h:[]u8="halt-no-patch";return h;
}

// apply one strategy branch; 1 iff a patch was written into outc
fn qb_apply_branch(outc:*Cx, cls:i64, branch:i64, src:[]u8, qn:[]u8)i64 {
    if(cls==1){
        if(branch==0){return patch_brace(outc,src);}
        return 0;
    }
    if(cls==2){
        if(branch==0){
            if(qn.len>0){return patch_unknownfn(outc,src,qn);}
        }
        return 0;
    }
    if(cls==3){
        if(branch==0){
            if(qn.len>0){return patch_arity(outc,src,qn);}
        }
        return 0;
    }
    if(cls==4){
        if(branch==0){return patch_ret_word(outc,src);}
        if(branch==1){return patch_arg_unquote(outc,src);}
        if(branch==2){return patch_del_badassign(outc,src);}
        return 0;
    }
    if(cls==5){
        if(branch==0){
            if(qn.len>0){return patch_dupfn(outc,src,qn);}
        }
        return 0;
    }
    return 0;
}

// floor application: first-applicable branch wins (== diag_compile behavior).
// Returns 0 on failure, else the applied branch + 1.
fn qb_apply_floor(outc:*Cx, cls:i64, src:[]u8, qn:[]u8)i64 {
    if(cls==1){if(qb_apply_branch(outc,cls,0,src,qn)==1){return 1;}return 0;}
    if(cls==2){if(qb_apply_branch(outc,cls,0,src,qn)==1){return 1;}return 0;}
    if(cls==3){if(qb_apply_branch(outc,cls,0,src,qn)==1){return 1;}return 0;}
    if(cls==4){
        if(qb_apply_branch(outc,cls,0,src,qn)==1){return 1;}
        if(qb_apply_branch(outc,cls,1,src,qn)==1){return 2;}
        if(qb_apply_branch(outc,cls,2,src,qn)==1){return 3;}
        return 0;
    }
    if(cls==5){if(qb_apply_branch(outc,cls,0,src,qn)==1){return 1;}return 0;}
    return 0;
}

// read a Cx buffer's bytes (field access through *Cx fn parameter)
fn qb_cx_bytes(c:*Cx)[]u8 {
    let b:[]u8=c.*.b[0..c.*.n];
    return b;
}

// D2 critic: 0 = draft clean; else defect code 1..4 (first failing check).
// Checks are the learner's own cross-checks: brace balance, defined-name,
// arity-vs-definition, trigger-presence for the diagnosed class.
fn qb_critique(draft:[]u8, src:[]u8, cls:i64, qn:[]u8)i64 {
    if(pc_braces_ok(draft)==0){return 1;}
    if(qb_names_ok(draft)==0){return 2;}
    if(qb_arity_ok(draft)==0){return 3;}
    if(qb_trigger_fixed(cls,draft,src,qn)==0){return 4;}
    return 0;
}

// COMPILE/PRECHECK branch with deeper deliberation. tr is the ONE shared
// ledger: every phase reads and writes it (D4 one-brain requirement).
fn qb_diag_compile(tr:*Cx, outc:*Cx, src:[]u8, ev:[]u8, dr:*DRes, qbmode:[]u8)void {
    // ---- evidence preamble (verbatim copy of diag_compile's) ----
    let has_parse:i64=0;
    if(s_has(ev,"parse")==1){has_parse=1;}
    if(s_has(ev,"E0001")==1){has_parse=1;}
    if(s_has(ev,"unexpected")==1){has_parse=1;}
    let has_unknown:i64=s_has(ev,"unknown");
    let has_argument:i64=s_has(ev,"argument");
    let has_expfound:i64=0;
    if(s_has(ev,"expected")==1){if(s_has(ev,"found")==1){has_expfound=1;}}
    let has_e0203:i64=s_has(ev,"E0203");
    let has_dup:i64=s_has(ev,"duplicate");
    let brace_bad:i64=0;
    if(review_braces(src)==0){brace_bad=1;}
    let qn:[]u8=ev_name(ev);
    let qndef:i64=0;
    let qsim:i64=0;
    if(qn.len>0){
        qndef=count_def(src,qn);
        qsim=similar_defined(src,qn);
    }
    let nums:[]i64=i64_arena(64);
    let nn:i64=s_numbers(ev,nums);
    let has_typetok:i64=0;
    if(has_expfound==1){
        if(s_has(ev,"i32")==1){has_typetok=1;}
        if(s_has(ev,"i64")==1){has_typetok=1;}
        if(s_has(ev,"[]u8")==1){has_typetok=1;}
    }

    // ---- 3a trigger-necessity pruning (verbatim from diag_compile) ----
    let prune_syntax:i64=0;
    let prune_name:i64=0;
    let prune_arity:i64=0;
    let prune_type:i64=0;
    let prune_dupfn:i64=0;
    if(has_parse==0){if(brace_bad==0){prune_syntax=1;}}
    if(has_unknown==0){if(qn.len==0){prune_name=1;}}
    if(has_argument==0){prune_arity=1;}
    if(has_expfound==0){if(has_e0203==0){prune_type=1;}}
    if(has_dup==0){prune_dupfn=1;}

    let s_syntax:i64=0;
    let s_name:i64=0;
    let s_arity:i64=0;
    let s_type:i64=0;
    let s_dupfn:i64=0;
    let evals:i64=0;

    // ==== combo floor: 3a prune first, then 3b branch-and-bound over the
    // pruned survivor set (verbatim copy of diag_compile's mask-"ab" branch)
    let cbest:i64=0;
    let clead:i64=99;
    let cstop:i64=0;
    let cet:i64=0;
    let cen:i64=0;
    let cea:i64=0;
    let ces:i64=0;
    let ced:i64=0;
    if(prune_type==0){
        s_type=sc_type(tr,ev,has_expfound,has_e0203);
        evals=evals+1;
        if(s_type>cbest){cbest=s_type;clead=5;}
        if(s_type==cbest){if(5<clead){clead=5;}}
        cet=1;
        cstop=bnb_stop(cbest,clead,cet,cen,cea,ces,ced,prune_type,prune_name,prune_arity,prune_syntax,prune_dupfn);
    } else { t_ev(tr,"TYPE",0,"pruned-no-trigger"); }
    if(cstop==0){
        if(prune_name==0){
            s_name=sc_name(tr,ev,src,has_unknown,qn,qndef,qsim);
            evals=evals+1;
            if(s_name>cbest){cbest=s_name;clead=3;}
            if(s_name==cbest){if(3<clead){clead=3;}}
            cen=1;
            cstop=bnb_stop(cbest,clead,cet,cen,cea,ces,ced,prune_type,prune_name,prune_arity,prune_syntax,prune_dupfn);
        } else { t_ev(tr,"NAME",0,"pruned-no-trigger"); }
    }
    if(cstop==0){
        if(prune_arity==0){
            s_arity=sc_arity(tr,ev,has_argument,nn,qn,qndef);
            evals=evals+1;
            if(s_arity>cbest){cbest=s_arity;clead=4;}
            if(s_arity==cbest){if(4<clead){clead=4;}}
            cea=1;
            cstop=bnb_stop(cbest,clead,cet,cen,cea,ces,ced,prune_type,prune_name,prune_arity,prune_syntax,prune_dupfn);
        } else { t_ev(tr,"ARITY",0,"pruned-no-trigger"); }
    }
    if(cstop==0){
        if(prune_syntax==0){
            s_syntax=sc_syntax(tr,ev,src,has_parse,brace_bad);
            evals=evals+1;
            if(s_syntax>cbest){cbest=s_syntax;clead=1;}
            if(s_syntax==cbest){if(1<clead){clead=1;}}
            ces=1;
            cstop=bnb_stop(cbest,clead,cet,cen,cea,ces,ced,prune_type,prune_name,prune_arity,prune_syntax,prune_dupfn);
        } else { t_ev(tr,"SYNTAX",0,"pruned-no-trigger"); }
    }
    if(cstop==0){
        if(prune_dupfn==0){
            s_dupfn=sc_dupfn(tr,has_dup,qn,qndef);
            evals=evals+1;
            if(s_dupfn>cbest){cbest=s_dupfn;clead=2;}
            if(s_dupfn==cbest){if(2<clead){clead=2;}}
            ced=1;
        } else { t_ev(tr,"DUPFN",0,"pruned-no-trigger"); }
    }

    // ---- complete the picture: score bnb-skipped survivors fully ----
    // (pruned classes score 0 by the 3a trigger-necessity proof)
    if(ces==0){
        if(prune_syntax==0){
            s_syntax=sc_syntax(tr,ev,src,has_parse,brace_bad);
            evals=evals+1;
        }
    }
    if(ced==0){
        if(prune_dupfn==0){
            s_dupfn=sc_dupfn(tr,has_dup,qn,qndef);
            evals=evals+1;
        }
    }
    if(cen==0){
        if(prune_name==0){
            s_name=sc_name(tr,ev,src,has_unknown,qn,qndef,qsim);
            evals=evals+1;
        }
    }
    if(cea==0){
        if(prune_arity==0){
            s_arity=sc_arity(tr,ev,has_argument,nn,qn,qndef);
            evals=evals+1;
        }
    }
    if(cet==0){
        if(prune_type==0){
            s_type=sc_type(tr,ev,has_expfound,has_e0203);
            evals=evals+1;
        }
    }

    let sc:[]i64=i64_arena(6);
    sc[1]=s_syntax;
    sc[2]=s_name;
    sc[3]=s_arity;
    sc[4]=s_type;
    sc[5]=s_dupfn;
    let rk:[]i64=i64_arena(5);
    qb_rank(sc,rk);

    let is_d1:i64=s_eq(qbmode,"d1");
    let is_d2:i64=s_eq(qbmode,"d2");
    let is_d3:i64=s_eq(qbmode,"d3");
    let is_d4:i64=s_eq(qbmode,"d4");
    let is_d5:i64=s_eq(qbmode,"d5");

    // argmax winner (floor); all-zero scores -> UNKNOWN (0), as in diag_compile
    let fcls:i64=rk[0];
    if(sc[fcls]==0){fcls=0;}

    // ---- D1: conflict-driven deliberation (d1, d5) ----
    // contested = runner-up live (score > 0) and within the frozen margin
    let d1_on:i64=0;
    if(is_d1==1){d1_on=1;}
    if(is_d5==1){d1_on=1;}
    if(d1_on==1){
        let wscr:i64=0;
        if(fcls>0){wscr=sc[fcls];}
        let rcls:i64=rk[1];
        if(fcls>0){
            if(rcls==fcls){rcls=rk[2];}
        }
        let rscr:i64=sc[rcls];
        let margin:i64=2;
        if(rscr>0){
            if(wscr-rscr<=margin){
                let w0:i64=fcls;
                if(w0==0){w0=rk[0];}
                let ew:i64=qb_evidence_count(w0,has_parse,brace_bad,has_unknown,qn.len,qndef,qsim,has_argument,nn,has_expfound,has_e0203,has_typetok,has_dup);
                let er:i64=qb_evidence_count(rcls,has_parse,brace_bad,has_unknown,qn.len,qndef,qsim,has_argument,nn,has_expfound,has_e0203,has_typetok,has_dup);
                evals=evals+1;
                t_ev(tr,"QB1",ew,"contested-leader-evidence");
                t_ev(tr,"QB1",er,"contested-runnerup-evidence");
                let dw:i64=w0;
                let why:[]u8="argmax-stands";
                if(er>ew){dw=rcls;why="runnerup-more-evidence";}
                if(er==ew){
                    if(rscr>wscr){dw=rcls;why="tie-evidence-higher-score";}
                }
                t_ev(tr,"QB1",dw,why);
                fcls=dw;
            }
        }
    }

    // ---- D4: one-brain sub-deliberation phases (d4, d5) ----
    // HYPOTHESIZE ran above (combo scoring, findings on the shared ledger).
    // CRITIQUE attacks the leader from the shared evidence; COUNTER-
    // HYPOTHESIZE names the best surviving alternative; COMMIT decides.
    let d4_on:i64=0;
    if(is_d4==1){d4_on=1;}
    if(is_d5==1){d4_on=1;}
    if(d4_on==1){
        let struck:i64=qb_refuted(fcls,src,qn,qndef,brace_bad);
        evals=evals+1;
        if(struck==1){
            t_ev(tr,"QB4",fcls,"critique-strikes-leader");
            let alt:i64=0;
            let k4:i64=0;
            while(k4<5){
                let cand4:i64=rk[k4];
                if(cand4!=fcls){
                    if(alt==0){alt=cand4;}
                }
                k4=k4+1;
            }
            evals=evals+1;
            t_ev(tr,"QB4",alt,"counter-hypothesis");
            fcls=alt;
            t_ev(tr,"QB4",fcls,"commit-alternative");
        } else {
            t_ev(tr,"QB4",fcls,"critique-fails-leader-stands");
        }
    }

    // ---- D3: hypothesis competition among top-3 (d3, d5) ----
    // Each of the top-3 classes produces a candidate patch; a competition
    // round scores each against the evidence envelope (trigger presence,
    // strategy fit, cross-check cleanliness); the winner is applied.
    let d3_on:i64=0;
    if(is_d3==1){d3_on=1;}
    if(is_d5==1){d3_on=1;}
    // competition state (also feeds the D2 initial draft in d5)
    let comp_wcls:i64=fcls;
    let comp_wbr:i64=0;
    let comp_wfit:i64=0;
    let comp_wbytes:[]u8=src;
    if(d3_on==1){
        let cc0:i64=rk[0];
        let cc1:i64=rk[1];
        let cc2:i64=rk[2];
        let cb0:Cx=cx_new(src.len+65536);
        let pb0:*Cx=&cb0;
        let cb1:Cx=cx_new(src.len+65536);
        let pb1:*Cx=&cb1;
        let cb2:Cx=cx_new(src.len+65536);
        let pb2:*Cx=&cb2;
        let fb0:i64=qb_apply_floor(pb0,cc0,src,qn);
        let fb1:i64=qb_apply_floor(pb1,cc1,src,qn);
        let fb2:i64=qb_apply_floor(pb2,cc2,src,qn);
        evals=evals+3;
        // candidate 0
        let by0:[]u8=src;
        let tg0:i64=0;
        let ft0:i64=0;
        let cl0:i64=qb_cross_clean(src);
        if(fb0>0){
            by0=qb_cx_bytes(pb0);
            tg0=qb_trigger_fixed(cc0,by0,src,qn);
            ft0=1;
            cl0=qb_cross_clean(by0);
        }
        // candidate 1
        let by1:[]u8=src;
        let tg1:i64=0;
        let ft1:i64=0;
        let cl1:i64=qb_cross_clean(src);
        if(fb1>0){
            by1=qb_cx_bytes(pb1);
            tg1=qb_trigger_fixed(cc1,by1,src,qn);
            ft1=1;
            cl1=qb_cross_clean(by1);
        }
        // candidate 2
        let by2:[]u8=src;
        let tg2:i64=0;
        let ft2:i64=0;
        let cl2:i64=qb_cross_clean(src);
        if(fb2>0){
            by2=qb_cx_bytes(pb2);
            tg2=qb_trigger_fixed(cc2,by2,src,qn);
            ft2=1;
            cl2=qb_cross_clean(by2);
        }
        let tot0:i64=tg0+ft0+cl0;
        let tot1:i64=tg1+ft1+cl1;
        let tot2:i64=tg2+ft2+cl2;
        evals=evals+1;
        t_ev(tr,"QB3",tot0,"candidate-scores-trigger-fit-clean");
        t_ev(tr,"QB3",tot1,"candidate-scores-trigger-fit-clean");
        t_ev(tr,"QB3",tot2,"candidate-scores-trigger-fit-clean");
        // winner: total desc, class score desc, frozen priority asc
        let wc:i64=cc0;
        let wt:i64=tot0;
        let wsc2:i64=sc[cc0];
        let wfit:i64=ft0;
        let wbr:i64=fb0;
        let wby:[]u8=by0;
        if(tot1>wt){wc=cc1;wt=tot1;wsc2=sc[cc1];wfit=ft1;wbr=fb1;wby=by1;}
        if(tot1==wt){
            if(sc[cc1]>wsc2){wc=cc1;wsc2=sc[cc1];wfit=ft1;wbr=fb1;wby=by1;}
            if(sc[cc1]==wsc2){
                if(qb_prank(cc1)<qb_prank(wc)){wc=cc1;wfit=ft1;wbr=fb1;wby=by1;}
            }
        }
        if(tot2>wt){wc=cc2;wt=tot2;wsc2=sc[cc2];wfit=ft2;wbr=fb2;wby=by2;}
        if(tot2==wt){
            if(sc[cc2]>wsc2){wc=cc2;wsc2=sc[cc2];wfit=ft2;wbr=fb2;wby=by2;}
            if(sc[cc2]==wsc2){
                if(qb_prank(cc2)<qb_prank(wc)){wc=cc2;wfit=ft2;wbr=fb2;wby=by2;}
            }
        }
        t_ev(tr,"QB3",wc,"competition-winner");
        comp_wcls=wc;
        comp_wbr=wbr;
        comp_wfit=wfit;
        comp_wbytes=wby;
        fcls=wc;
    }

    // ---- draft production ----
    // d3 (alone): the competition winner's candidate is the draft.
    // otherwise: the floor application of the selected class.
    let dcA:Cx=cx_new(src.len+65536);
    let dcB:Cx=cx_new(src.len+65536);
    let cur:*Cx=&dcA;
    let altb:*Cx=&dcB;
    let cc_cls:i64=fcls;
    let cc_br:i64=0;
    let cc_fit:i64=0;
    if(d3_on==1){
        if(comp_wfit==1){
            cur.*.n=0;
            e_raw(cur,comp_wbytes);
            cc_cls=comp_wcls;
            cc_br=comp_wbr-1;
            cc_fit=1;
        }
    } else {
        if(fcls>0){
            cur.*.n=0;
            let br0:i64=qb_apply_floor(cur,fcls,src,qn);
            if(br0>0){
                cc_cls=fcls;
                cc_br=br0-1;
                cc_fit=1;
            }
        }
    }

    // ---- D2: multi-round critique (d2, d5) ----
    // 3 critic rounds against the draft; a defect forces a re-draft
    // (next branch of the same class, else next-best class; max 2
    // re-drafts per iteration, then compile regardless). Halts are
    // deliberate decisions, not defective drafts: no critique.
    let d2_on:i64=0;
    if(is_d2==1){d2_on=1;}
    if(is_d5==1){d2_on=1;}
    if(d2_on==1){
        if(cc_fit==1){
            let tried:[]i64=i64_arena(6);
            tried[cc_cls]=1;
            let redrafts:i64=0;
            let done:i64=0;
            while(done==0){
                let db:[]u8=qb_cx_bytes(cur);
                let r:i64=0;
                let defect:i64=0;
                while(r<3){
                    defect=qb_critique(db,src,cc_cls,qn);
                    evals=evals+1;
                    r=r+1;
                    if(defect!=0){break;}
                }
                if(defect==0){
                    t_ev(tr,"QB2",cc_cls,"draft-survives-3-rounds");
                    done=1;
                } else {
                    t_ev(tr,"QB2",defect,"critic-finds-defect");
                    if(redrafts>=2){
                        t_ev(tr,"QB2",cc_cls,"redraft-budget-spent-compile-regardless");
                        done=1;
                    } else {
                        // advance: next branch of same class (TYPE), else
                        // next-best untried class via floor application
                        let ncls:i64=0;
                        let nbr:i64=0;
                        let found:i64=0;
                        if(cc_cls==4){
                            if(cc_br<2){
                                altb.*.n=0;
                                if(qb_apply_branch(altb,4,cc_br+1,src,qn)==1){
                                    ncls=4;
                                    nbr=cc_br+1;
                                    found=1;
                                }
                            }
                        }
                        if(found==0){
                            let k3:i64=0;
                            while(k3<5){
                                let cand3:i64=rk[k3];
                                if(tried[cand3]==0){
                                    altb.*.n=0;
                                    let br3:i64=qb_apply_floor(altb,cand3,src,qn);
                                    if(br3>0){
                                        ncls=cand3;
                                        nbr=br3-1;
                                        found=1;
                                        break;
                                    }
                                    tried[cand3]=1;
                                }
                                k3=k3+1;
                            }
                        }
                        if(found==0){
                            t_ev(tr,"QB2",cc_cls,"no-further-drafts-accept");
                            done=1;
                        } else {
                            let tmp:*Cx=cur;
                            cur=altb;
                            altb=tmp;
                            redrafts=redrafts+1;
                            tried[ncls]=1;
                            cc_cls=ncls;
                            cc_br=nbr;
                            t_ev(tr,"QB2",ncls,"re-draft");
                        }
                    }
                }
            }
        }
    }

    // ---- commit the final class/strategy/source ----
    let fstrat:[]u8="halt-no-patch";
    if(cc_fit==1){
        fstrat=qb_strat_name(cc_cls,cc_br);
        let fb:[]u8=qb_cx_bytes(cur);
        e_raw(outc,fb);
    } else {
        // no patch produced (floor failed, or competition winner had no
        // applicable patch): honest halt, source unchanged
        e_raw(outc,src);
    }
    let fscore:i64=0;
    if(fcls>0){fscore=sc[fcls];}
    // the committed class: D3 sets it to the competition winner; D2 then
    // overrides with the final draft's class when re-drafts moved it
    // (the deliberated revision, not the original diagnosis)
    if(d3_on==1){fcls=comp_wcls;}
    if(d2_on==1){
        if(cc_fit==1){fcls=cc_cls;}
    }
    let fscore2:i64=0;
    if(fcls>0){fscore2=sc[fcls];}
    t_ev(tr,"WINNER",fscore2,class_name(fcls));
    dr.*.class=fcls;
    dr.*.score=fscore2;
    dr.*.evals=evals;
    dr.*.strat=fstrat;
    return;
}

// diagnose entry for QB deeper modes (d1..d5). GEN and TEST branches keep
// baseline behavior; COMPILE/PRECHECK goes through the deeper deliberation.
fn do_diagnose_qb()void {
    let spec:[]u8=_zag_arg(2);
    let src:[]u8=_zag_arg(3);
    let evtype:[]u8=_zag_arg(4);
    let ev:[]u8=_zag_arg(5);
    let installed:[]u8=_zag_arg(6);
    let demo:[]u8=_zag_arg(7);
    let card:[]u8=_zag_arg(8);
    let qbmode:[]u8=_zag_arg(10);

    let tc:Cx=cx_new(4096);
    let tr:*Cx=&tc;
    let oc:Cx=cx_new(src.len+65536);
    let outc:*Cx=&oc;
    let d:DRes=DRes{};
    let dr:*DRes=&d;
    dr.*.class=0;
    dr.*.score=0;
    dr.*.evals=0;
    dr.*.strat="halt-no-patch";

    if(s_eq(evtype,"GEN")==1){
        dr.*.class=6;
        dr.*.score=10;
        dr.*.evals=1;
        t_ev(tr,"GENFAIL",10,"gen-emitted-sentinel");
        dr.*.strat="halt-genfail";
        e_raw(outc,src);
    } else if(s_eq(evtype,"TEST")==1){
        diag_test(tr,outc,src,ev,spec,installed,demo,card,dr);
    } else {
        t_ev(tr,"QBMODE",0,qbmode);
        qb_diag_compile(tr,outc,src,ev,dr,qbmode);
    }

    // thrash / cycle guards: override the strategy, never the diagnosis
    // (verbatim copy from do_diagnose)
    let prev:[]u8=env_get(ev,"PREV");
    let prev_class:[]u8="";
    let sl:i64=s_find(prev,"/",0);
    if(sl>0){prev_class=prev[0..sl];}
    let is_stalled:i64=0;
    if(s_eq(env_get(ev,"STALLED"),"1")==1){is_stalled=1;}
    let is_cycle:i64=0;
    if(s_eq(env_get(ev,"CYCLE"),"1")==1){is_cycle=1;}
    if(is_cycle==1){
        if(s_eq(dr.*.strat,"halt-genfail")==0){
            t_ev(tr,"CYCLE",99,"source-hash-seen-before");
            dr.*.strat="halt-cycle";
            outc.*.n=0;
            e_raw(outc,src);
        }
    } else {
        if(is_stalled==1){
            if(s_eq(prev_class,class_name(dr.*.class))==1){
                t_ev(tr,"THRASH",99,"same-class-no-source-change");
                dr.*.strat="halt-thrash";
                outc.*.n=0;
                e_raw(outc,src);
            }
        }
    }

    _zag_print("DIAG class=");
    _zag_print(class_name(dr.*.class));
    _zag_print(" strategy=");
    _zag_print(dr.*.strat);
    _zag_print(" score=");
    _zag_print(_zag_i64_to_str(dr.*.score));
    _zag_print(" evals=");
    _zag_print(_zag_i64_to_str(dr.*.evals));
    _zag_print(" trace=");
    let trb:[]u8=tr.*.b[0..tr.*.n];
    _zag_print(trb);
    _zag_print("\n@@SRC@@\n");
    let ob:[]u8=outc.*.b[0..outc.*.n];
    _zag_print(ob);
    if(ob.len>0){
        if(ob[ob.len-1]!=10){_zag_print("\n");}
    }
    _zag_print("@@END@@\n");
    return;
}

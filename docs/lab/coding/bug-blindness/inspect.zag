// inspect.zag — Q1 instrument: bug detection by READING (no compiler, no execution).
// Pure Zag, zero RNG, fully deterministic: same bytes in -> same verdict out.
// Usage: inspect <program.zag> [trace]
//
// Instrument boundary (declared, per PREREG-BB): an authored line-oriented
// parser encodes the program TEXT into integer fact tables:
//   DEF(name,line)  CALL(callee,line)  ARITY_DEF(fn,n)  ARITY_CALL(callee,n,line)
//   DECL(var,type,fn)  ASSIGN(var,line,fn)  ASSIGN_LIT(var,litkind,line,value)
//   USE(var,line,fn)  LOOP(fn,line,var,op,boundkind,bound)  COND(fn,line,op,lhskind)
//   SPEC_RANGE(lo,hi,inclusive)  SPEC_COND(op)  BRACE_DEPTH(eof_depth)
// The CHECKS are deliberative inference over the tables, not source-text
// regexes: each check unifies a middle term against every row of a table
// (e.g. each CALL callee unified against every DEF row), in the style of
// learner.zag's delib (transitive 2-step inference by middle-term unification).
//
// Output: CLEAN  |  BUG <class> <line>
// Classes: UNKNOWN-CALL ARITY UNINIT-VAR TYPE-MISMATCH OFF-BY-ONE
//          WRONG-COMPARISON DUP-FN MISSING-BRACE

// ============ section 1: alloc + file IO (proven idiom, units/wide/char_prose.zag) ============

fn z_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn z_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=z_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}

fn le_get64(b:[]u8,at:i64)i64 {
    let v:i64=0;
    let i:i64=0;
    while(i<8){
        v=v|((b[at+i] as i64)<<(i*8));
        i=i+1;
    }
    return v;
}

fn le_put64(b:[]u8,at:i64,v:i64)void {
    let i:i64=0;
    while(i<8){
        b[at+i]=((v>>(i*8)) as u8);
        i=i+1;
    }
    return;
}

// Minimal regular-file reader via Linux x86-64 raw syscalls.
// open=2(O_RDONLY=0), fstat=5 (st_size u64 at offset 48), read=0, close=3.
fn read_file(path:[]u8)[]u8 {
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){return "";}
    let cs_ptr:i64=_zag_slice_ptr(cs) as i64;
    let fd:i64=_zag_raw_syscall(2,cs_ptr,0,0,0,0,0);
    z_free(cs);
    if(fd<0){return "";}
    let st:[]u8=z_alloc(144);
    if(st.len==0){
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        return "";
    }
    let st_ptr:i64=_zag_slice_ptr(st) as i64;
    let r:i64=_zag_raw_syscall(5,fd,st_ptr,0,0,0,0);
    if(r!=0){
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        z_free(st);
        return "";
    }
    let size:i64=le_get64(st,48);
    z_free(st);
    if(size<0 || size>67108864){
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        return "";
    }
    let n:i32=size as i32;
    let buf:[]u8=z_alloc(n+1);
    if(buf.len==0){
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        return "";
    }
    let got:i32=0;
    while(got<n){
        let rptr:i64=(_zag_slice_ptr(buf) as i64)+(got as i64);
        let rlen:i64=(n-got) as i64;
        let rr:i64=_zag_raw_syscall(0,fd,rptr,rlen,0,0,0);
        if(rr<=0){break;}
        got=got+(rr as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..got];
}

// ============ section 2: string utils ============

fn is_alpha(c:u8)i64 {
    if(c>=65){if(c<=90){return 1;}}
    if(c>=97){if(c<=122){return 1;}}
    if(c==95){return 1;}
    return 0;
}

fn is_digit(c:u8)i64 {
    if(c>=48){if(c<=57){return 1;}}
    return 0;
}

fn is_alnum(c:u8)i64 {
    if(is_alpha(c)==1){return 1;}
    if(is_digit(c)==1){return 1;}
    return 0;
}

fn beq(a:[]u8,b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

// parse leading integer, optional '-'; stops at first non-digit
fn parse_int(s:[]u8)i64 {
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){if(s[0]==45){neg=1;i=1;}}
    let v:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c<48){break;}
        if(c>57){break;}
        v=v*10+((c as i64)-48);
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

fn trim(s:[]u8)[]u8 {
    let a:i64=0;
    let b:i64=s.len;
    while(a<b){
        if(s[a]!=32){break;}
        a=a+1;
    }
    while(b>a){
        if(s[b-1]!=32){break;}
        b=b-1;
    }
    return s[a..b];
}

fn starts_with(s:[]u8,p:[]u8)i64 {
    if(s.len<p.len){return 0;}
    return beq(s[0..p.len],p);
}

fn find_sub(s:[]u8,sub:[]u8,from:i64)i64 {
    let i:i64=from;
    while(i+sub.len<=s.len){
        if(beq(s[i..i+sub.len],sub)==1){return i;}
        i=i+1;
    }
    return -1;
}

// end index of identifier starting at i (s[i] is alpha or _)
fn ident_end(s:[]u8,i:i64)i64 {
    let j:i64=i;
    while(j<s.len){
        if(is_alnum(s[j])==0){break;}
        j=j+1;
    }
    return j;
}

// last identifier slice in s (for assignment LHS); empty if none
fn last_ident(s:[]u8)[]u8 {
    let bi:i64=-1;
    let be:i64=-1;
    let i:i64=0;
    while(i<s.len){
        if(is_alpha(s[i])==1){
            let e:i64=ident_end(s,i);
            bi=i;
            be=e;
            i=e;
        }
        else{i=i+1;}
    }
    if(bi<0){return "";}
    return s[bi..be];
}

// words never treated as variable USEs
fn stopword(w:[]u8)i64 {
    if(beq(w,"fn")==1){return 1;}
    if(beq(w,"let")==1){return 1;}
    if(beq(w,"if")==1){return 1;}
    if(beq(w,"while")==1){return 1;}
    if(beq(w,"else")==1){return 1;}
    if(beq(w,"return")==1){return 1;}
    if(beq(w,"as")==1){return 1;}
    if(beq(w,"i64")==1){return 1;}
    if(beq(w,"i32")==1){return 1;}
    if(beq(w,"u8")==1){return 1;}
    if(beq(w,"true")==1){return 1;}
    if(beq(w,"false")==1){return 1;}
    return 0;
}

// keywords never treated as CALL callees
fn call_stopword(w:[]u8)i64 {
    if(beq(w,"if")==1){return 1;}
    if(beq(w,"while")==1){return 1;}
    if(beq(w,"for")==1){return 1;}
    return 0;
}

// ============ section 3: integer fact-table store ============
// One []u8 arena T. Slots 0..15 (i64 each, bytes slot*8):
//   0 nnames  1 n_def  2 n_call  3 n_adef  4 n_acall  5 n_decl  6 n_asgn
//   7 n_alit  8 n_use  9 n_loop  10 n_cond  11 n_srange  12 n_scond
//   13 brace_depth  14 total_lines  15 spare
// Regions (base byte offsets, row stride in i64s, cap, count slot):
//   names off @128 (256) | names len @2176 (256) | names buf @4224 (256*48)
//   DEF      @16512 stride 2 cap 200 slot 1   (name,line)
//   CALL     @19712 stride 2 cap 200 slot 2   (callee,line)
//   ARITY_DEF@22912 stride 2 cap 200 slot 3   (fn,n)
//   ARITY_CAL@26112 stride 3 cap 200 slot 4   (callee,n,line)
//   DECL     @30912 stride 3 cap 200 slot 5   (var,type,fn)
//   ASSIGN   @35712 stride 3 cap 200 slot 6   (var,line,fn)
//   ASSIGN_LI@40512 stride 4 cap 200 slot 7   (var,litkind,line,value)
//   USE      @46912 stride 3 cap 200 slot 8   (var,line,fn)
//   LOOP     @51712 stride 6 cap 200 slot 9   (fn,line,var,op,bkind,bval)
//   COND     @61312 stride 4 cap 200 slot 10  (fn,line,op,lhskind)
//   SPEC_RANG@67712 stride 3 cap 8   slot 11  (lo,hi,inclusive)
//   SPEC_COND@67904 stride 1 cap 8   slot 12  (op)
// Total 68032 bytes; arena allocated 70000.
// litkind: 1 int, 2 string, 3 char. op: 0 <, 1 <=, 2 >, 3 >=, 4 ==, 5 !=.

fn nrows(T:[]u8,slot:i64)i64 {
    return le_get64(T,slot*8);
}

fn cell(T:[]u8,base:i64,stride:i64,row:i64,col:i64)i64 {
    return le_get64(T,base+((row*stride+col)*8));
}

fn addrow(T:[]u8,slot:i64,base:i64,stride:i64,cap:i64,a:i64,b:i64,c:i64,d:i64,e:i64,f:i64,ncols:i64)void {
    let n:i64=le_get64(T,slot*8);
    if(n>=cap){return;}
    let o:i64=base+(n*stride)*8;
    le_put64(T,o,a);
    if(ncols>1){le_put64(T,o+8,b);}
    if(ncols>2){le_put64(T,o+16,c);}
    if(ncols>3){le_put64(T,o+24,d);}
    if(ncols>4){le_put64(T,o+32,e);}
    if(ncols>5){le_put64(T,o+40,f);}
    le_put64(T,slot*8,n+1);
    return;
}

// ---- identifier interning: names -> small integer ids ----

fn name_eq(T:[]u8,id:i64,s:[]u8)i64 {
    let off:i64=le_get64(T,128+(id-1)*8);
    let ln:i64=le_get64(T,2176+(id-1)*8);
    if(ln!=s.len){return 0;}
    return beq(T[4224+off..4224+off+ln],s);
}

fn name_of(T:[]u8,id:i64)[]u8 {
    let off:i64=le_get64(T,128+(id-1)*8);
    let ln:i64=le_get64(T,2176+(id-1)*8);
    return T[4224+off..4224+off+ln];
}

fn intern(T:[]u8,s:[]u8)i64 {
    let n:i64=le_get64(T,0);
    let i:i64=1;
    while(i<=n){
        if(name_eq(T,i,s)==1){return i;}
        i=i+1;
    }
    if(n>=256){return 0;}
    if(s.len>48){return 0;}
    if(s.len==0){return 0;}
    let off:i64=0;
    if(n>0){
        let po:i64=le_get64(T,128+(n-1)*8);
        let pl:i64=le_get64(T,2176+(n-1)*8);
        off=po+pl;
    }
    let j:i64=0;
    while(j<s.len){
        T[4224+off+j]=s[j];
        j=j+1;
    }
    le_put64(T,128+n*8,off);
    le_put64(T,2176+n*8,s.len);
    le_put64(T,0,n+1);
    return n+1;
}

fn is_builtin(T:[]u8,id:i64)i64 {
    if(name_eq(T,id,"_zag_print")==1){return 1;}
    if(name_eq(T,id,"_zag_println")==1){return 1;}
    if(name_eq(T,id,"_zag_i64_to_str")==1){return 1;}
    if(name_eq(T,id,"_zag_arg")==1){return 1;}
    if(name_eq(T,id,"_zag_argc")==1){return 1;}
    if(name_eq(T,id,"_zag_malloc")==1){return 1;}
    if(name_eq(T,id,"_zag_free")==1){return 1;}
    return 0;
}

// ============ section 4: authored line-oriented parser (instrument boundary) ============
// Encodes program text into the integer fact tables. This is the declared
// instrument: authored parsing. The CHECKS below do inference over tables.

// count args of call whose '(' is at t[o]; top-level commas only
fn count_call_args(t:[]u8,o:i64)i64 {
    let depth:i64=1;
    let j:i64=o+1;
    let commas:i64=0;
    let any:i64=0;
    while(j<t.len){
        let c:u8=t[j];
        if(c==40){depth=depth+1;}
        if(c==41){depth=depth-1;if(depth==0){break;}}
        if(c==44){if(depth==1){commas=commas+1;}}
        if(c!=32){if(c!=40){if(c!=41){if(c!=44){any=1;}}}}
        j=j+1;
    }
    if(any==0){return 0;}
    return commas+1;
}

// register fn params as DECL+ASSIGN (params are initialized at call)
fn scan_params(T:[]u8,ps:[]u8,fid:i64,ln:i64)i64 {
    let n:i64=0;
    let i:i64=0;
    let start:i64=0;
    while(i<=ps.len){
        let endp:i64=0;
        if(i==ps.len){endp=1;}
        else{if(ps[i]==44){endp=1;}}
        if(endp==1){
            let p:[]u8=trim(ps[start..i]);
            if(p.len>0){
                let ne:i64=ident_end(p,0);
                let vid:i64=intern(T,p[0..ne]);
                let tid:i64=0;
                let cp:i64=find_sub(p,":",0);
                if(cp>=0){tid=intern(T,trim(p[cp+1..p.len]));}
                addrow(T,5,30912,3,200,vid,tid,fid,0,0,0,3);
                addrow(T,6,35712,3,200,vid,ln,fid,0,0,0,3);
                addrow2(T,75296,3,256,fid,n,tid,0,3);
                n=n+1;
            }
            start=i+1;
        }
        i=i+1;
    }
    return n;
}

// tokenize s for variable USEs: skip strings/chars; ident followed by '(' is
// a call (skipped); ident followed by '.' is a field access -> FIELD_USE;
// ident followed by '[' is an indexing site -> INDEX row (plus a USE row)
fn scan_uses(T:[]u8,s:[]u8,ln:i64,curfn:i64)void {
    let i:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==34){
            i=i+1;
            while(i<s.len){
                if(s[i]==34){break;}
                i=i+1;
            }
            i=i+1;
        }
        else{
            if(c==39){
                i=i+1;
                while(i<s.len){
                    if(s[i]==39){break;}
                    i=i+1;
                }
                i=i+1;
            }
            else{
                if(is_alpha(c)==1){
                    let e:i64=ident_end(s,i);
                    let w:[]u8=s[i..e];
                    if(e<s.len){
                        if(s[e]==46){
                            let fs:i64=e+1;
                            let fok:i64=0;
                            if(fs<s.len){
                                if(is_alpha(s[fs])==1){
                                    let fe:i64=ident_end(s,fs);
                                    addrow2(T,71184,3,128,intern(T,w),intern(T,s[fs..fe]),ln,0,3);
                                    i=fe;
                                    fok=1;
                                }
                            }
                            if(fok==0){i=e+1;}
                        }
                        else{
                            if(s[e]==40){i=e;}
                            else{
                                if(s[e]==91){
                                    addrow2(T,98888,2,128,intern(T,w),ln,0,0,2);
                                }
                                if(stopword(w)==0){
                                    let vid:i64=intern(T,w);
                                    addrow(T,8,46912,3,200,vid,ln,curfn,0,0,0,3);
                                }
                                i=e;
                            }
                        }
                    }
                    else{
                        if(stopword(w)==0){
                            let vid:i64=intern(T,w);
                            addrow(T,8,46912,3,200,vid,ln,curfn,0,0,0,3);
                        }
                        i=e;
                    }
                }
                else{i=i+1;}
            }
        }
    }
    return;
}
// index of assignment '=' (not ==, <=, >=, !=); -1 if none
fn find_assign(t:[]u8)i64 {
    let i:i64=0;
    while(i<t.len){
        if(t[i]==61){
            let ok:i64=1;
            if(i+1<t.len){if(t[i+1]==61){ok=0;}}
            if(i>0){
                let p:u8=t[i-1];
                if(p==60){ok=0;}
                if(p==62){ok=0;}
                if(p==33){ok=0;}
                if(p==61){ok=0;}
            }
            if(ok==1){return i;}
        }
        i=i+1;
    }
    return -1;
}

// classify a RHS literal: sets kind (0 none,1 int,2 string,3 char) and value
fn lit_kind_val(rhs:[]u8,kind_out:[]u8,val_out:[]u8)void {
    le_put64(kind_out,0,0);
    le_put64(val_out,0,0);
    if(rhs.len==0){return;}
    let rc:u8=rhs[0];
    if(rc==34){le_put64(kind_out,0,2);return;}
    if(rc==39){le_put64(kind_out,0,3);return;}
    if(is_digit(rc)==1){le_put64(kind_out,0,1);le_put64(val_out,0,parse_int(rhs));return;}
    if(rc==45){
        if(rhs.len>1){if(is_digit(rhs[1])==1){le_put64(kind_out,0,1);le_put64(val_out,0,parse_int(rhs));return;}}
    }
    return;
}

// kind-only wrapper around lit_kind_val (out-pointer form)
fn litkind(rhs:[]u8)i64 {
    let ko:[]u8=z_alloc(8);
    let vo:[]u8=z_alloc(8);
    lit_kind_val(rhs,ko,vo);
    let k:i64=le_get64(ko,0);
    z_free(ko);
    z_free(vo);
    return k;
}
// value wrapper around lit_kind_val (int value; 0 for non-int)
fn litval(rhs:[]u8)i64 {
    let ko:[]u8=z_alloc(8);
    let vo:[]u8=z_alloc(8);
    lit_kind_val(rhs,ko,vo);
    let v:i64=le_get64(vo,0);
    z_free(ko);
    z_free(vo);
    return v;
}

// strip one trailing ';' from a trimmed rhs
fn rhs_strip(rhs:[]u8)[]u8 {
    if(rhs.len>0){if(rhs[rhs.len-1]==59){return rhs[0..rhs.len-1];}}
    return rhs;
}

// spec-cond word -> op id; -1 unknown
fn spec_op_id(w:[]u8)i64 {
    let t:[]u8=w;
    let sp:i64=find_sub(w," ",0);
    if(sp>=0){t=w[0..sp];}
    if(beq(t,"lt")==1){return 0;}
    if(beq(t,"le")==1){return 1;}
    if(beq(t,"gt")==1){return 2;}
    if(beq(t,"ge")==1){return 3;}
    if(beq(t,"eq")==1){return 4;}
    if(beq(t,"ne")==1){return 5;}
    return -1;
}

// find comparison op in cond; returns op id and writes position to pos_out
fn cond_op(cond:[]u8,pos_out:[]u8)i64 {
    le_put64(pos_out,0,-1);
    let i:i64=0;
    while(i<cond.len){
        let c:u8=cond[i];
        if(c==60){
            if(i+1<cond.len){if(cond[i+1]==61){le_put64(pos_out,0,i);return 1;}}
            le_put64(pos_out,0,i);
            return 0;
        }
        if(c==62){
            if(i+1<cond.len){if(cond[i+1]==61){le_put64(pos_out,0,i);return 3;}}
            le_put64(pos_out,0,i);
            return 2;
        }
        if(c==61){
            if(i+1<cond.len){if(cond[i+1]==61){le_put64(pos_out,0,i);return 4;}}
        }
        if(c==33){
            if(i+1<cond.len){if(cond[i+1]==61){le_put64(pos_out,0,i);return 5;}}
        }
        i=i+1;
    }
    return -1;
}

// ---- per-line parser; returns updated curfn ----
// v2: struct-def/body mode, E0002 (unterminated string), E0010 (stray
// top-level token), UNKNOWN-IDENT (unparenthesized if/while), field stores,
// return-literal/var facts, fn return types, call-arg literal kinds,
// bare-call RHS facts (void-as-value), indexing sites.
fn parse_line(T:[]u8,line:[]u8,ln:i64,curfn:i64)i64 {
    // SPEC comments -> SPEC fact tables (then fall through: the comment is
    // stripped below and braces are still counted)
    let sp:i64=find_sub(line,"// SPEC-RANGE ",0);
    if(sp>=0){
        let rest:[]u8=trim(line[sp+13..line.len]);
        let ce:i64=find_sub(rest,",",0);
        if(ce>0){
            let lo:i64=parse_int(trim(rest[0..ce]));
            let hi:i64=parse_int(trim(rest[ce+1..rest.len]));
            addrow(T,11,67712,3,8,lo,hi,0,0,0,0,3);
        }
    }
    let sc:i64=find_sub(line,"// SPEC-COND ",0);
    if(sc>=0){
        let cnd:[]u8=trim(line[sc+12..line.len]);
        let pos:[]u8=z_alloc(8);
        let k2:i64=cond_op(cnd,pos);
        if(k2>=0){
            addrow(T,12,67904,1,8,k2,0,0,0,0,0,1);
        }
        z_free(pos);
    }
    // strip line comment
    let code:[]u8=line;
    let cm:i64=find_sub(line,"//",0);
    if(cm>=0){code=line[0..cm];}
    // brace depth over code, skipping string literals.
    // E0002: line ends while still inside a string literal.
    let dbefore:i64=le_get64(T,13*8);
    let d:i64=0;
    let k:i64=0;
    let instr:i64=0;
    while(k<code.len){
        let c:u8=code[k];
        if(instr==1){
            if(c==34){instr=0;}
        }
        else{
            if(c==34){instr=1;}
            else{
                if(c==123){d=d+1;}
                if(c==125){d=d-1;}
            }
        }
        k=k+1;
    }
    if(instr==1){
        if(le_get64(T,68032)==0){le_put64(T,68032,ln);}
    }
    le_put64(T,13*8,dbefore+d);
    let dafter:i64=dbefore+d;
    let t:[]u8=trim(code);
    // E0010: stray token at top level.
    // shape (a): a code line at depth 0 that is not a fn/struct/enum/union def
    // shape (b): a '}' closing to depth 0 followed by more tokens ('};')
    if(t.len>0){
        if(dbefore==0){
            if(starts_with(t,"fn ")==0){
                if(starts_with(t,"struct ")==0){
                    if(starts_with(t,"enum ")==0){
                        if(starts_with(t,"union ")==0){
                            if(starts_with(t,"@")==0){
                                if(le_get64(T,68040)==0){le_put64(T,68040,ln);}
                            }
                        }
                    }
                }
            }
        }
        if(dafter==0){
            if(starts_with(t,"}")==1){
                let rr:[]u8=trim(t[1..t.len]);
                if(rr.len>0){
                    if(le_get64(T,68040)==0){le_put64(T,68040,ln);}
                }
            }
        }
    }
    if(t.len==0){return curfn;}
    // struct body mode: field lines `name:type;`
    if(le_get64(T,68056)==1){
        if(beq(t,"}")==1){
            le_put64(T,68056,0);
            le_put64(T,68064,0);
            return curfn;
        }
        let fe2:i64=ident_end(t,0);
        if(fe2>0){
            addrow2(T,69128,2,128,le_get64(T,68064),intern(T,t[0..fe2]),0,0,2);
        }
        return curfn;
    }
    // struct definition -> TYPE_DEF
    if(starts_with(t,"struct ")==1){
        let ne3:i64=ident_end(t,7);
        let sid:i64=intern(T,t[7..ne3]);
        addrow2(T,68096,2,64,sid,ln,0,0,2);
        le_put64(T,68056,1);
        le_put64(T,68064,sid);
        return curfn;
    }
    // UNKNOWN-IDENT: comparison operator outside parens in condition position
    // (`if x>0` / `while i<5` surface in the compiler as
    // `unknown identifier in expression: >`)
    if(cond_noparen(t,"if")==1){
        if(le_get64(T,68048)==0){le_put64(T,68048,ln);}
    }
    if(cond_noparen(t,"while")==1){
        if(le_get64(T,68048)==0){le_put64(T,68048,ln);}
    }
    // fn definition
    if(starts_with(t,"fn ")==1){
        let ne:i64=ident_end(t,3);
        let fid:i64=intern(T,t[3..ne]);
        addrow(T,1,16512,2,200,fid,ln,0,0,0,0,2);
        let np:i64=0;
        let po:i64=find_sub(t,"(",0);
        if(po>=0){
            let pc:i64=find_sub(t,")",po+1);
            if(pc>po){
                np=scan_params(T,trim(t[po+1..pc]),fid,ln);
                let rt:[]u8=trim(t[pc+1..t.len]);
                let re:i64=0;
                if(rt.len>0){if(is_alpha(rt[0])==1){re=ident_end(rt,0);}}
                let rtid:i64=0;
                if(re>0){rtid=intern(T,rt[0..re]);}
                addrow2(T,74264,2,64,fid,rtid,0,0,2);
            }
        }
        addrow(T,3,22912,2,200,fid,np,0,0,0,0,2);
        return fid;
    }
    // call sites + per-arg literal kinds (E0203 call-arg site)
    let ci:i64=0;
    while(ci<t.len){
        if(is_alpha(t[ci])==1){
            let e:i64=ident_end(t,ci);
            let w:[]u8=t[ci..e];
            if(e<t.len){
                if(t[e]==40){
                    if(call_stopword(w)==0){
                        let cid:i64=intern(T,w);
                        addrow(T,2,19712,2,200,cid,ln,0,0,0,0,2);
                        let na:i64=count_call_args(t,e);
                        addrow(T,4,26112,3,200,cid,na,ln,0,0,0,3);
                        record_call_args(T,t,e,cid,ln);
                    }
                }
            }
            ci=e;
        }
        else{ci=ci+1;}
    }
    // let declaration
    if(starts_with(t,"let ")==1){
        let eq2:i64=find_assign(t);
        if(eq2>=0){
            let lhs:[]u8=t[4..eq2];
            let cp2:i64=find_sub(lhs,":",0);
            let vpart:[]u8=lhs;
            if(cp2>=0){vpart=lhs[0..cp2];}
            let vid2:i64=0;
            let li2:[]u8=trim(vpart);
            if(li2.len>0){vid2=intern(T,li2);}
            let tid2:i64=0;
            if(cp2>=0){
                let ts:[]u8=trim(lhs[cp2+1..lhs.len]);
                let te:i64=0;
                if(ts.len>0){
                    if(ts[0]==91){te=4;}
                    else{te=ident_end(ts,0);}
                }
                if(te>0){tid2=intern(T,ts[0..te]);}
            }
            if(vid2!=0){
                addrow(T,5,30912,3,200,vid2,tid2,curfn,0,0,0,3);
                addrow(T,6,35712,3,200,vid2,ln,curfn,0,0,0,3);
                let rhs:[]u8=rhs_strip(trim(t[eq2+1..t.len]));
                let lk2:i64=litkind(rhs);
                if(lk2!=0){
                    addrow(T,7,40512,4,200,vid2,lk2,ln,litval(rhs),0,0,4);
                }
                // rhs is a bare call -> ASSIGN_CALL (void-as-value site)
                if(rhs.len>0){
                    if(is_alpha(rhs[0])==1){
                        let ce2:i64=ident_end(rhs,0);
                        if(ce2<rhs.len){
                            if(rhs[ce2]==40){
                                if(rhs[rhs.len-1]==41){
                                    addrow2(T,89648,3,128,vid2,intern(T,rhs[0..ce2]),ln,0,3);
                                }
                            }
                        }
                    }
                }
                scan_uses(T,rhs,ln,curfn);
            }
        }
        return curfn;
    }
    // assignment (non-let): field store vs plain
    let eq3:i64=find_assign(t);
    if(eq3>=0){
        let lhs:[]u8=t[0..eq3];
        let dot:i64=find_sub(lhs,".",0);
        if(dot>=0){
            // field store `base.field = ...` -> FIELD_USE, not ASSIGN
            let bnm:[]u8=trim(lhs[0..dot]);
            let fnm:[]u8=trim(lhs[dot+1..lhs.len]);
            let fe3:i64=ident_end(fnm,0);
            addrow2(T,71184,3,128,intern(T,bnm),intern(T,fnm[0..fe3]),ln,0,3);
            return curfn;
        }
        let tgt:[]u8=last_ident(lhs);
        if(tgt.len>0){
            let vid3:i64=intern(T,tgt);
            addrow(T,6,35712,3,200,vid3,ln,curfn,0,0,0,3);
            let rhs3:[]u8=rhs_strip(trim(t[eq3+1..t.len]));
            let lk3:i64=litkind(rhs3);
            if(lk3!=0){
                addrow(T,7,40512,4,200,vid3,lk3,ln,litval(rhs3),0,0,4);
            }
            if(rhs3.len>0){
                if(is_alpha(rhs3[0])==1){
                    let ce3:i64=ident_end(rhs3,0);
                    if(ce3<rhs3.len){
                        if(rhs3[ce3]==40){
                            if(rhs3[rhs3.len-1]==41){
                                addrow2(T,89648,3,128,vid3,intern(T,rhs3[0..ce3]),ln,0,3);
                            }
                        }
                    }
                }
            }
            scan_uses(T,rhs3,ln,curfn);
        }
        scan_index_seg(T,lhs,ln);
        return curfn;
    }
    // if(cond){ — also record COND row for spec checks
    if(starts_with(t,"if(")==1){
        let cp3:i64=find_sub(t,")",3);
        if(cp3>3){
            let cond:[]u8=t[3..cp3];
            let pos:[]u8=z_alloc(8);
            let k3:i64=cond_op(cond,pos);
            if(k3>=0){
                let pp:i64=le_get64(pos,0);
                let sl:[]u8=t[cp3+1..cp3+1+pp];
                let sr:[]u8=t[cp3+1+pp+k3..t.len];
                addrow(T,10,61312,4,200,curfn,ln,k3,pp,0,0,4);
            }
            z_free(pos);
        }
        scan_uses(T,t,ln,curfn);
        return curfn;
    }
    // while(cond){ — LOOP row (fn,line,var,op,bkind,bval) + COND row
    if(starts_with(t,"while(")==1){
        let cp4:i64=find_sub(t,")",6);
        if(cp4>6){
            let cond2:[]u8=t[6..cp4];
            let pos2:[]u8=z_alloc(8);
            let k4:i64=cond_op(cond2,pos2);
            if(k4>=0){
                let pp2:i64=le_get64(pos2,0);
                let sl2:[]u8=trim(cond2[0..pp2]);
                let oplen:i64=1;
                if(k4==1){oplen=2;}
                if(k4==3){oplen=2;}
                if(k4==4){oplen=2;}
                if(k4==5){oplen=2;}
                let sr2:[]u8=trim(cond2[pp2+oplen..cond2.len]);
                let varid:i64=0;
                let liw:[]u8=last_ident(sl2);
                if(liw.len>0){varid=intern(T,liw);}
                let bkind:i64=0;
                let bval:i64=0;
                if(litkind(sr2)==1){
                    bkind=0;
                    bval=parse_int(sr2);
                }
                else{
                    let lbw:[]u8=last_ident(sr2);
                    if(lbw.len>0){bkind=1;bval=intern(T,lbw);}
                }
                addrow(T,9,51712,6,200,curfn,ln,varid,k4,bkind,bval,6);
                addrow(T,10,61312,4,200,curfn,ln,k4,pp2,0,0,4);
            }
            z_free(pos2);
        }
        scan_uses(T,t,ln,curfn);
        return curfn;
    }
    // return statement -> RETURN_LIT / RETURN_VAR / field use
    if(starts_with(t,"return")==1){
        let rok:i64=0;
        if(t.len==6){rok=1;}
        else{
            if(t[6]==59){rok=1;}
            else{if(t[6]==32){rok=1;}}
        }
        if(rok==1){
            let rest:[]u8=rhs_strip(trim(t[6..t.len]));
            if(rest.len==0){
                addrow2(T,92728,3,128,curfn,0,ln,0,3);
            }
            else{
                let rc:u8=rest[0];
                if(rc==34){
                    addrow2(T,92728,3,128,curfn,2,ln,0,3);
                }
                else{
                    if(is_digit(rc)==1){
                        addrow2(T,92728,3,128,curfn,1,ln,0,3);
                    }
                    else{
                        if(rc==45){
                            let rneg:i64=0;
                            if(rest.len>1){
                                if(is_digit(rest[1])==1){rneg=1;}
                            }
                            if(rneg==1){
                                addrow2(T,92728,3,128,curfn,1,ln,0,3);
                            }
                            else{scan_uses(T,rest,ln,curfn);}
                        }
                        else{
                            if(is_alpha(rc)==1){
                                let dot2:i64=find_sub(rest,".",0);
                                if(dot2>=0){
                                    let bnm2:[]u8=trim(rest[0..dot2]);
                                    let fnm2:[]u8=trim(rest[dot2+1..rest.len]);
                                    let fe4:i64=ident_end(fnm2,0);
                                    addrow2(T,71184,3,128,intern(T,bnm2),intern(T,fnm2[0..fe4]),ln,0,3);
                                }
                                else{
                                    let ve:i64=ident_end(rest,0);
                                    addrow2(T,95808,3,128,curfn,intern(T,rest[0..ve]),ln,0,3);
                                    scan_uses(T,rest,ln,curfn);
                                }
                            }
                            else{scan_uses(T,rest,ln,curfn);}
                        }
                    }
                }
            }
            return curfn;
        }
    }
    // anything else (bare calls): harvest USEs
    scan_uses(T,t,ln,curfn);
    return curfn;
}

// 1 iff t is `kw` followed by spaces then a non-'(' char (unparenthesized cond)
fn cond_noparen(t:[]u8,kw:[]u8)i64 {
    if(starts_with(t,kw)==0){return 0;}
    if(t.len<=kw.len){return 0;}
    let c:u8=t[kw.len];
    if(c==40){return 0;}
    if(c!=32){return 0;}
    let k:i64=kw.len+1;
    while(k<t.len){
        if(t[k]!=32){break;}
        k=k+1;
    }
    if(k>=t.len){return 0;}
    if(t[k]==40){return 0;}
    return 1;
}

// record per-arg literal kinds for a call at paren offset o
fn record_call_args(T:[]u8,t:[]u8,o:i64,cid:i64,ln:i64)void {
    let depth:i64=1;
    let j:i64=o+1;
    let idx:i64=0;
    let astart:i64=j;
    while(j<t.len){
        let c:u8=t[j];
        if(c==40){depth=depth+1;}
        if(c==41){depth=depth-1;}
        if(depth==0){
            let arg:[]u8=trim(t[astart..j]);
            if(arg.len>0){
                addrow2(T,81448,4,256,cid,idx,litkind(arg),ln,4);
            }
            break;
        }
        if(c==44){
            if(depth==1){
                let arg2:[]u8=trim(t[astart..j]);
                if(arg2.len>0){
                    addrow2(T,81448,4,256,cid,idx,litkind(arg2),ln,4);
                }
                idx=idx+1;
                astart=j+1;
            }
        }
        j=j+1;
    }
    return;
}

// find `ident[` indexing sites in s -> INDEX rows
fn scan_index_seg(T:[]u8,s:[]u8,ln:i64)void {
    let i:i64=0;
    while(i<s.len){
        if(is_alpha(s[i])==1){
            let e:i64=ident_end(s,i);
            if(e<s.len){
                if(s[e]==91){
                    addrow2(T,98888,2,128,intern(T,s[i..e]),ln,0,0,2);
                }
            }
            i=e;
        }
        else{i=i+1;}
    }
    return;
}

// ============ section 6: deliberative checks (inference over tables) ============
// Each check scans table rows and unifies a middle term against every row of
// another table -- the genuine deliberation pattern from learner.zag's delib
// (middle-term unification), not source-text matching. Checks run in fixed
// order; the first firing check determines the verdict. Each returns the bug
// line, or -1.

// ---- v2 tables (counts live in the first 8 bytes of each region) ----
// B_FLAGS 68032: cell0 unterm_line, cell1 stray_line, cell2 noparen_line,
//                cell3 struct_mode, cell4 cur_struct
// B_TDEF  68096: TYPE_DEF(name,line)         s2 c64
// B_SFLD  69128: STRUCT_FIELD(struct,field)  s2 c128
// B_FUSE  71184: FIELD_USE(base,field,line)  s3 c128
// B_RET   74264: RET(fn,type_id)             s2 c64
// B_PARAM 75296: PARAM(fn,idx,type_id)       s3 c256
// B_CARG  81448: CALL_ARG(callee,idx,litkind,line) s4 c256
// B_AC2   89648: ASSIGN_CALL(var,callee,line) s3 c128
// B_RLIT  92728: RETURN_LIT(fn,litkind,line) s3 c128
// B_RVAR  95808: RETURN_VAR(fn,var,line)     s3 c128
// B_IDX   98888: INDEX(var,line)             s2 c128
fn n2(T:[]u8,base:i64)i64 {
    return le_get64(T,base);
}
fn cell2(T:[]u8,base:i64,stride:i64,row:i64,col:i64)i64 {
    return le_get64(T,base+8+((row*stride+col)*8));
}
fn addrow2(T:[]u8,base:i64,stride:i64,cap:i64,a:i64,b:i64,c:i64,d:i64,ncols:i64)void {
    let n:i64=le_get64(T,base);
    if(n>=cap){return;}
    let o:i64=base+8+(n*stride)*8;
    if(ncols>=1){le_put64(T,o,a);}
    if(ncols>=2){le_put64(T,o+8,b);}
    if(ncols>=3){le_put64(T,o+16,c);}
    if(ncols>=4){le_put64(T,o+24,d);}
    le_put64(T,base,n+1);
    return;
}
// return-type category: 0 void, 1 int-like, 2 []u8, -1 unknown
fn retcat(T:[]u8,tid:i64)i64 {
    if(tid==0){return -1;}
    if(name_eq(T,tid,"void")==1){return 0;}
    if(name_eq(T,tid,"i64")==1){return 1;}
    if(name_eq(T,tid,"i32")==1){return 1;}
    if(name_eq(T,tid,"u8")==1){return 1;}
    if(name_eq(T,tid,"[]u8")==1){return 2;}
    return -1;
}
// declared return-type category of fn, or -1 if unknown
fn ret_of(T:[]u8,fnid:i64)i64 {
    let n:i64=n2(T,74264);
    let r:i64=0;
    while(r<n){
        if(cell2(T,74264,2,r,0)==fnid){
            return retcat(T,cell2(T,74264,2,r,1));
        }
        r=r+1;
    }
    return -1;
}

// 0. E0002: unterminated string literal (lexical fault, checked first)
fn chk_e0002(T:[]u8)i64 {
    let l:i64=le_get64(T,68032);
    if(l!=0){return l;}
    return -1;
}
// 0b. E0010: unexpected token at top level
fn chk_e0010(T:[]u8)i64 {
    let l:i64=le_get64(T,68040);
    if(l!=0){return l;}
    return -1;
}
// 0c. UNKNOWN-IDENT: comparison operator outside parens in condition position
fn chk_noparen(T:[]u8)i64 {
    let l:i64=le_get64(T,68048);
    if(l!=0){return l;}
    return -1;
}

// 1. UNKNOWN-CALL: CALL callee unifies with no DEF row
fn chk_unknown_call(T:[]u8,trace:i64)i64 {
    let nc:i64=nrows(T,2);
    let nd:i64=nrows(T,1);
    let r:i64=0;
    while(r<nc){
        let callee:i64=cell(T,19712,2,r,0);
        let ln:i64=cell(T,19712,2,r,1);
        if(is_builtin(T,callee)==0){
            let found:i64=0;
            let d:i64=0;
            while(d<nd){
                if(cell(T,16512,2,d,0)==callee){found=1;}
                d=d+1;
            }
            if(trace==1){
                _zag_print("  unify CALL ");
                _zag_print(name_of(T,callee));
                _zag_print(" vs DEFs -> ");
                if(found==1){_zag_print("bound\n");} else {_zag_print("UNBOUND\n");}
            }
            if(found==0){return ln;}
        }
        r=r+1;
    }
    return -1;
}

// 2. ARITY: CALL arg count vs unified ARITY_DEF row
fn chk_arity(T:[]u8,trace:i64)i64 {
    let na:i64=nrows(T,4);
    let nd:i64=nrows(T,3);
    let r:i64=0;
    while(r<na){
        let callee:i64=cell(T,26112,3,r,0);
        let n:i64=cell(T,26112,3,r,1);
        let ln:i64=cell(T,26112,3,r,2);
        if(is_builtin(T,callee)==0){
            let d:i64=0;
            while(d<nd){
                if(cell(T,22912,2,d,0)==callee){
                    let dn:i64=cell(T,22912,2,d,1);
                    if(trace==1){
                        _zag_print("  unify ARITY_CALL ");
                        _zag_print(name_of(T,callee));
                        _zag_print(" n=");
                        _zag_print(_zag_i64_to_str(n));
                        _zag_print(" vs ARITY_DEF n=");
                        _zag_print(_zag_i64_to_str(dn));
                        _zag_print("\n");
                    }
                    if(dn!=n){return ln;}
                }
                d=d+1;
            }
        }
        r=r+1;
    }
    return -1;
}

// 3. UNINIT-VAR: USE with no ASSIGN row same (var,fn) at earlier line
fn chk_uninit(T:[]u8,trace:i64)i64 {
    let nu:i64=nrows(T,8);
    let nas:i64=nrows(T,6);
    let r:i64=0;
    while(r<nu){
        let v:i64=cell(T,46912,3,r,0);
        let ln:i64=cell(T,46912,3,r,1);
        let f:i64=cell(T,46912,3,r,2);
        let ok:i64=0;
        let a:i64=0;
        while(a<nas){
            if(cell(T,35712,3,a,0)==v){
                if(cell(T,35712,3,a,2)==f){
                    if(cell(T,35712,3,a,1)<ln){ok=1;}
                }
            }
            a=a+1;
        }
        if(trace==1){
            _zag_print("  unify USE ");
            _zag_print(name_of(T,v));
            _zag_print(" line ");
            _zag_print(_zag_i64_to_str(ln));
            if(ok==1){_zag_print(" -> earlier ASSIGN unifies\n");} else {_zag_print(" -> NO earlier ASSIGN\n");}
        }
        if(ok==0){return ln;}
        r=r+1;
    }
    return -1;
}

// declared-type category: 1 int-like, 2 []u8, 0 unknown (check skipped)
fn typecat(T:[]u8,tid:i64)i64 {
    if(tid==0){return 0;}
    if(name_eq(T,tid,"i64")==1){return 1;}
    if(name_eq(T,tid,"i32")==1){return 1;}
    if(name_eq(T,tid,"u8")==1){return 1;}
    if(name_eq(T,tid,"[]u8")==1){return 2;}
    return 0;
}

fn litkind_name(lk:i64)[]u8 {
    if(lk==1){return "int";}
    if(lk==2){return "string";}
    if(lk==3){return "char";}
    return "?";
}

// 4. TYPE-MISMATCH: ASSIGN_LIT kind incompatible with DECL type (unified on var)
// 6. E0203: type mismatch at all sites.
//   site A: literal assigned to declared var (ASSIGN_LIT vs DECL)
//   site B: return literal/var vs fn return type (`in function <label>`)
//   site C: call arg literal vs param type (`in call to <fn>`)
//   site D: `return <val>;` in a void fn (`expected void, found i32`)
//   site E: void call result used as a value (`expected i32, found void`)
fn chk_e0203(T:[]u8,trace:i64)i64 {
    let nd:i64=nrows(T,5);
    // site A
    let nl:i64=nrows(T,7);
    let r:i64=0;
    while(r<nl){
        let v:i64=cell(T,40512,4,r,0);
        let lk:i64=cell(T,40512,4,r,1);
        let ln:i64=cell(T,40512,4,r,2);
        let d:i64=0;
        while(d<nd){
            if(cell(T,30912,3,d,0)==v){
                let cat:i64=typecat(T,cell(T,30912,3,d,1));
                if(trace==1){
                    _zag_print("  unify ASSIGN_LIT ");
                    _zag_print(name_of(T,v));
                    _zag_print(" kind=");
                    _zag_print(litkind_name(lk));
                    _zag_print(" vs DECL typecat=");
                    _zag_print(_zag_i64_to_str(cat));
                    _zag_print("\n");
                }
                if(cat==1){if(lk!=1){if(lk!=3){return ln;}}}
                if(cat==2){if(lk!=2){return ln;}}
            }
            d=d+1;
        }
        r=r+1;
    }
    // site B: return literal vs fn return type; site D: value in void fn
    let nrl:i64=n2(T,92728);
    let r2:i64=0;
    while(r2<nrl){
        let fn2:i64=cell2(T,92728,3,r2,0);
        let lk2:i64=cell2(T,92728,3,r2,1);
        let ln2:i64=cell2(T,92728,3,r2,2);
        if(lk2!=0){
            let rc2:i64=ret_of(T,fn2);
            if(rc2==0){return ln2;}
            if(rc2==1){if(lk2!=1){if(lk2!=3){return ln2;}}}
            if(rc2==2){if(lk2!=2){return ln2;}}
        }
        r2=r2+1;
    }
    // site B (var): return var vs fn return type
    let nrv:i64=n2(T,95808);
    let r3:i64=0;
    while(r3<nrv){
        let fn3:i64=cell2(T,95808,3,r3,0);
        let vr:i64=cell2(T,95808,3,r3,1);
        let ln3:i64=cell2(T,95808,3,r3,2);
        let rc3:i64=ret_of(T,fn3);
        if(rc3==1 || rc3==2){
            let d3:i64=0;
            while(d3<nd){
                if(cell(T,30912,3,d3,0)==vr){
                    let tc:i64=typecat(T,cell(T,30912,3,d3,1));
                    if(tc==1 || tc==2){
                        if(tc!=rc3){return ln3;}
                    }
                }
                d3=d3+1;
            }
        }
        r3=r3+1;
    }
    // site C: call arg literal vs declared param type
    let nca:i64=n2(T,81448);
    let r4:i64=0;
    while(r4<nca){
        let ce4:i64=cell2(T,81448,4,r4,0);
        let ix:i64=cell2(T,81448,4,r4,1);
        let lk4:i64=cell2(T,81448,4,r4,2);
        let ln4:i64=cell2(T,81448,4,r4,3);
        if(lk4!=0){
            let p5:i64=0;
            let np5:i64=n2(T,75296);
            while(p5<np5){
                if(cell2(T,75296,3,p5,0)==ce4){
                    if(cell2(T,75296,3,p5,1)==ix){
                        let tc5:i64=typecat(T,cell2(T,75296,3,p5,2));
                        if(tc5==1){if(lk4!=1){if(lk4!=3){return ln4;}}}
                        if(tc5==2){if(lk4!=2){return ln4;}}
                    }
                }
                p5=p5+1;
            }
        }
        r4=r4+1;
    }
    // site E: void call result assigned to a typed var
    let nac:i64=n2(T,89648);
    let r6:i64=0;
    while(r6<nac){
        let vv:i64=cell2(T,89648,3,r6,0);
        let ce6:i64=cell2(T,89648,3,r6,1);
        let ln6:i64=cell2(T,89648,3,r6,2);
        if(ret_of(T,ce6)==0){
            let d6:i64=0;
            while(d6<nd){
                if(cell(T,30912,3,d6,0)==vv){
                    if(typecat(T,cell(T,30912,3,d6,1))!=0){return ln6;}
                }
                d6=d6+1;
            }
        }
        r6=r6+1;
    }
    return -1;
}

// 11. DUP-TYPE: TYPE_DEF name unifies with an earlier TYPE_DEF row
fn chk_duptype(T:[]u8)i64 {
    let n:i64=n2(T,68096);
    let i:i64=0;
    while(i<n){
        let j:i64=0;
        while(j<i){
            if(cell2(T,68096,2,i,0)==cell2(T,68096,2,j,0)){
                return cell2(T,68096,2,i,1);
            }
            j=j+1;
        }
        i=i+1;
    }
    return -1;
}

// 12. UNKNOWN-FIELD: FIELD_USE (base,field) with base of struct type S, where
// field unifies with no STRUCT_FIELD row of S
fn chk_unknown_field(T:[]u8)i64 {
    let nf:i64=n2(T,71184);
    let nd:i64=nrows(T,5);
    let r:i64=0;
    while(r<nf){
        let base:i64=cell2(T,71184,3,r,0);
        let fld:i64=cell2(T,71184,3,r,1);
        let ln:i64=cell2(T,71184,3,r,2);
        let d:i64=0;
        while(d<nd){
            if(cell(T,30912,3,d,0)==base){
                let tid2:i64=cell(T,30912,3,d,1);
                let nt:i64=n2(T,68096);
                let q:i64=0;
                while(q<nt){
                    if(cell2(T,68096,2,q,0)==tid2){
                        let found:i64=0;
                        let nsf:i64=n2(T,69128);
                        let w:i64=0;
                        while(w<nsf){
                            if(cell2(T,69128,2,w,0)==tid2){
                                if(cell2(T,69128,2,w,1)==fld){found=1;}
                            }
                            w=w+1;
                        }
                        if(found==0){return ln;}
                    }
                    q=q+1;
                }
            }
            d=d+1;
        }
        r=r+1;
    }
    return -1;
}

// 13. NO-MAIN: no DEF row unifies with `main`
fn chk_nomain(T:[]u8)i64 {
    let n:i64=nrows(T,1);
    let i:i64=0;
    while(i<n){
        if(name_eq(T,cell(T,16512,2,i,0),"main")==1){return -1;}
        i=i+1;
    }
    return 1;
}

// 14. BAD-INDEX: INDEX base unifies with a DECL row whose type is int-like
// (compiler: indexing unsupported on non-slice/non-pointer values)
fn chk_badindex(T:[]u8)i64 {
    let n:i64=n2(T,98888);
    let nd:i64=nrows(T,5);
    let r:i64=0;
    while(r<n){
        let v:i64=cell2(T,98888,2,r,0);
        let ln:i64=cell2(T,98888,2,r,1);
        let d:i64=0;
        while(d<nd){
            if(cell(T,30912,3,d,0)==v){
                if(typecat(T,cell(T,30912,3,d,1))==1){return ln;}
            }
            d=d+1;
        }
        r=r+1;
    }
    return -1;
}

// latest int-literal ASSIGN_LIT row for var before ln; -1 if none
fn alit_row_before(T:[]u8,vid:i64,ln:i64)i64 {
    let n:i64=nrows(T,7);
    let best:i64=-1;
    let bestln:i64=-1;
    let r:i64=0;
    while(r<n){
        if(cell(T,40512,4,r,0)==vid){
            if(cell(T,40512,4,r,1)==1){
                let rl:i64=cell(T,40512,4,r,2);
                if(rl<ln){if(rl>bestln){bestln=rl;best=r;}}
            }
        }
        r=r+1;
    }
    return best;
}

// 5. OFF-BY-ONE: LOOP iteration count vs SPEC_RANGE expectation
fn chk_offbyone(T:[]u8,trace:i64)i64 {
    if(nrows(T,11)==0){return -1;}
    let lo:i64=cell(T,67712,3,0,0);
    let hi:i64=cell(T,67712,3,0,1);
    let inc:i64=cell(T,67712,3,0,2);
    let exp:i64=hi-lo;
    if(inc==1){exp=exp+1;}
    let nl:i64=nrows(T,9);
    let r:i64=0;
    while(r<nl){
        let ln:i64=cell(T,51712,6,r,1);
        let vid:i64=cell(T,51712,6,r,2);
        let op:i64=cell(T,51712,6,r,3);
        let bk:i64=cell(T,51712,6,r,4);
        let bv:i64=cell(T,51712,6,r,5);
        let ir:i64=alit_row_before(T,vid,ln);
        if(ir>=0){
            let init:i64=cell(T,40512,4,ir,3);
            let bound:i64=0;
            let bok:i64=1;
            if(bk==0){bound=bv;}
            else{
                let br:i64=alit_row_before(T,bv,ln);
                if(br>=0){bound=cell(T,40512,4,br,3);}
                else{bok=0;}
            }
            if(bok==1){
                let cnt:i64=-1;
                if(op==0){cnt=bound-init;}
                if(op==1){cnt=bound-init+1;}
                if(op==2){cnt=init-bound;}
                if(op==3){cnt=init-bound+1;}
                if(trace==1){
                    _zag_print("  loop line ");
                    _zag_print(_zag_i64_to_str(ln));
                    _zag_print(" iters=");
                    _zag_print(_zag_i64_to_str(cnt));
                    _zag_print(" spec=");
                    _zag_print(_zag_i64_to_str(exp));
                    _zag_print("\n");
                }
                if(cnt>=0){if(cnt!=exp){return ln;}}
            }
        }
        r=r+1;
    }
    return -1;
}

// exact logical negation of a comparison op
// directional opposite of a comparison op: < <-> >, <= <-> >=, == <-> !=
fn invert_op(op:i64)i64 {
    if(op==0){return 2;}
    if(op==2){return 0;}
    if(op==1){return 3;}
    if(op==3){return 1;}
    if(op==4){return 5;}
    if(op==5){return 4;}
    return -1;
}

// 6. WRONG-COMPARISON: COND op is the exact negation of SPEC_COND
fn chk_wrongcmp(T:[]u8,trace:i64)i64 {
    if(nrows(T,12)==0){return -1;}
    let spec:i64=cell(T,67904,1,0,0);
    let inv:i64=invert_op(spec);
    let n:i64=nrows(T,10);
    let r:i64=0;
    while(r<n){
        let cop:i64=cell(T,61312,4,r,2);
        if(trace==1){
            _zag_print("  COND op=");
            _zag_print(_zag_i64_to_str(cop));
            _zag_print(" spec=");
            _zag_print(_zag_i64_to_str(spec));
            _zag_print("\n");
        }
        if(cop==inv){return cell(T,61312,4,r,1);}
        r=r+1;
    }
    return -1;
}

// 7. DUP-FN: two DEF rows unify on name
fn chk_dupfn(T:[]u8,trace:i64)i64 {
    let n:i64=nrows(T,1);
    let i:i64=0;
    while(i<n){
        let j:i64=i+1;
        while(j<n){
            if(cell(T,16512,2,i,0)==cell(T,16512,2,j,0)){
                if(trace==1){
                    _zag_print("  DEF ");
                    _zag_print(name_of(T,cell(T,16512,2,i,0)));
                    _zag_print(" unifies rows ");
                    _zag_print(_zag_i64_to_str(i));
                    _zag_print(",");
                    _zag_print(_zag_i64_to_str(j));
                    _zag_print("\n");
                }
                return cell(T,16512,2,j,1);
            }
            j=j+1;
        }
        i=i+1;
    }
    return -1;
}

// 8. MISSING-BRACE: eof brace depth != 0
fn chk_brace(T:[]u8,trace:i64)i64 {
    let d:i64=le_get64(T,13*8);
    if(trace==1){
        _zag_print("  eof brace depth=");
        _zag_print(_zag_i64_to_str(d));
        _zag_print("\n");
    }
    if(d!=0){return le_get64(T,14*8);}
    return -1;
}

// ---- trace: dump fact tables ----
fn dump_tables(T:[]u8)void {
    _zag_print("DEF rows=");_zag_print(_zag_i64_to_str(nrows(T,1)));_zag_print("\n");
    let i:i64=0;
    while(i<nrows(T,1)){
        _zag_print("  def ");_zag_print(name_of(T,cell(T,16512,2,i,0)));
        _zag_print(" line ");_zag_print(_zag_i64_to_str(cell(T,16512,2,i,1)));_zag_print("\n");
        i=i+1;
    }
    _zag_print("CALL rows=");_zag_print(_zag_i64_to_str(nrows(T,2)));_zag_print("\n");
    i=0;
    while(i<nrows(T,2)){
        _zag_print("  call ");_zag_print(name_of(T,cell(T,19712,2,i,0)));
        _zag_print(" line ");_zag_print(_zag_i64_to_str(cell(T,19712,2,i,1)));_zag_print("\n");
        i=i+1;
    }
    _zag_print("ARITY_DEF rows=");_zag_print(_zag_i64_to_str(nrows(T,3)));_zag_print("\n");
    i=0;
    while(i<nrows(T,3)){
        _zag_print("  adef ");_zag_print(name_of(T,cell(T,22912,2,i,0)));
        _zag_print(" n=");_zag_print(_zag_i64_to_str(cell(T,22912,2,i,1)));_zag_print("\n");
        i=i+1;
    }
    _zag_print("ARITY_CALL rows=");_zag_print(_zag_i64_to_str(nrows(T,4)));_zag_print("\n");
    i=0;
    while(i<nrows(T,4)){
        _zag_print("  acall ");_zag_print(name_of(T,cell(T,26112,3,i,0)));
        _zag_print(" n=");_zag_print(_zag_i64_to_str(cell(T,26112,3,i,1)));
        _zag_print(" line ");_zag_print(_zag_i64_to_str(cell(T,26112,3,i,2)));_zag_print("\n");
        i=i+1;
    }
    _zag_print("DECL rows=");_zag_print(_zag_i64_to_str(nrows(T,5)));_zag_print("\n");
    i=0;
    while(i<nrows(T,5)){
        _zag_print("  decl ");_zag_print(name_of(T,cell(T,30912,3,i,0)));
        _zag_print(":");_zag_print(name_of(T,cell(T,30912,3,i,1)));
        _zag_print(" fn=");_zag_print(name_of(T,cell(T,30912,3,i,2)));_zag_print("\n");
        i=i+1;
    }
    _zag_print("ASSIGN rows=");_zag_print(_zag_i64_to_str(nrows(T,6)));_zag_print("\n");
    i=0;
    while(i<nrows(T,6)){
        _zag_print("  assign ");_zag_print(name_of(T,cell(T,35712,3,i,0)));
        _zag_print(" line ");_zag_print(_zag_i64_to_str(cell(T,35712,3,i,1)));_zag_print("\n");
        i=i+1;
    }
    _zag_print("ASSIGN_LIT rows=");_zag_print(_zag_i64_to_str(nrows(T,7)));_zag_print("\n");
    i=0;
    while(i<nrows(T,7)){
        _zag_print("  alit ");_zag_print(name_of(T,cell(T,40512,4,i,0)));
        _zag_print(" kind=");_zag_print(litkind_name(cell(T,40512,4,i,1)));
        _zag_print(" line ");_zag_print(_zag_i64_to_str(cell(T,40512,4,i,2)));
        _zag_print(" val ");_zag_print(_zag_i64_to_str(cell(T,40512,4,i,3)));_zag_print("\n");
        i=i+1;
    }
    _zag_print("USE rows=");_zag_print(_zag_i64_to_str(nrows(T,8)));_zag_print("\n");
    i=0;
    while(i<nrows(T,8)){
        _zag_print("  use ");_zag_print(name_of(T,cell(T,46912,3,i,0)));
        _zag_print(" line ");_zag_print(_zag_i64_to_str(cell(T,46912,3,i,1)));_zag_print("\n");
        i=i+1;
    }
    _zag_print("LOOP rows=");_zag_print(_zag_i64_to_str(nrows(T,9)));_zag_print("\n");
    i=0;
    while(i<nrows(T,9)){
        _zag_print("  loop var=");_zag_print(name_of(T,cell(T,51712,6,i,2)));
        _zag_print(" op=");_zag_print(_zag_i64_to_str(cell(T,51712,6,i,3)));
        _zag_print(" bkind=");_zag_print(_zag_i64_to_str(cell(T,51712,6,i,4)));
        _zag_print(" bval=");_zag_print(_zag_i64_to_str(cell(T,51712,6,i,5)));
        _zag_print(" line ");_zag_print(_zag_i64_to_str(cell(T,51712,6,i,1)));_zag_print("\n");
        i=i+1;
    }
    _zag_print("COND rows=");_zag_print(_zag_i64_to_str(nrows(T,10)));_zag_print("\n");
    i=0;
    while(i<nrows(T,10)){
        _zag_print("  cond op=");_zag_print(_zag_i64_to_str(cell(T,61312,4,i,2)));
        _zag_print(" line ");_zag_print(_zag_i64_to_str(cell(T,61312,4,i,1)));_zag_print("\n");
        i=i+1;
    }
    _zag_print("SPEC_RANGE rows=");_zag_print(_zag_i64_to_str(nrows(T,11)));_zag_print("\n");
    _zag_print("SPEC_COND rows=");_zag_print(_zag_i64_to_str(nrows(T,12)));_zag_print("\n");
    _zag_print("brace_depth=");_zag_print(_zag_i64_to_str(le_get64(T,13*8)));_zag_print("\n");
    _zag_print("total_lines=");_zag_print(_zag_i64_to_str(le_get64(T,14*8)));_zag_print("\n");
    return;
}

// ---- arena + file helpers ----
fn init_arena(T:[]u8)void {
    let i:i64=0;
    while(i<15){
        le_put64(T,i*8,0);
        i=i+1;
    }
    le_put64(T,68032,0);
    le_put64(T,68040,0);
    le_put64(T,68048,0);
    le_put64(T,68056,0);
    le_put64(T,68064,0);
    le_put64(T,68096,0);
    le_put64(T,69128,0);
    le_put64(T,71184,0);
    le_put64(T,74264,0);
    le_put64(T,75296,0);
    le_put64(T,81448,0);
    le_put64(T,89648,0);
    le_put64(T,92728,0);
    le_put64(T,95808,0);
    le_put64(T,98888,0);
    return;
}
fn open_read(T:[]u8,path:[]u8)i64 {
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){return -1;}
    let p:i64=_zag_slice_ptr(cs) as i64;
    let fd:i64=_zag_raw_syscall(2,p,0,0,0,0,0);
    z_free(cs);
    return fd;
}
fn read_all(T:[]u8,fd:i64,path:[]u8)i64 {
    let bptr:i64=(_zag_slice_ptr(T) as i64)+12544;
    let got:i64=0;
    while(got<16384){
        let rr:i64=_zag_raw_syscall(0,fd,bptr+got,16384-got,0,0,0);
        if(rr<=0){break;}
        got=got+rr;
    }
    return got;
}
fn close_fd(fd:i64)void {
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return;
}

// ============ section 7: main ============
// Check order (fixed): E0002, E0010, UNKNOWN-IDENT, UNKNOWN-FN, ARITY,
// E0203, UNINIT-VAR, OFF-BY-ONE, WRONG-COMPARISON, DUP-FN, DUP-TYPE,
// UNKNOWN-FIELD, NO-MAIN, BAD-INDEX, E0001.
fn main()void {
    let path:[]u8=_zag_arg(1);
    let trace:i64=0;
    let a2:[]u8=_zag_arg(2);
    if(a2.len>0){if(beq(a2,"trace")==1){trace=1;}}
    let T:[]u8=z_alloc(103000);
    init_arena(T);
    let fd:i64=open_read(T,path);
    if(fd<0){
        _zag_print("ERR cannot open\n");
        z_free(T);
        return;
    }
    let r:i64=read_all(T,fd,path);
    close_fd(fd);
    if(r<0){
        _zag_print("ERR read failed\n");
        z_free(T);
        return;
    }
    // split into lines and parse
    let buf:[]u8=T[256+12288..256+12288+r];
    let ln:i64=1;
    let ls:i64=0;
    let i:i64=0;
    let curfn:i64=0;
    while(i<r){
        if(buf[i]==10){
            curfn=parse_line(T,buf[ls..i],ln,curfn);
            ln=ln+1;
            ls=i+1;
        }
        i=i+1;
    }
    if(ls<r){
        curfn=parse_line(T,buf[ls..r],ln,curfn);
        ln=ln+1;
    }
    le_put64(T,14*8,ln-1);
    if(trace==1){dump_tables(T);}
    let bl:i64=chk_e0002(T);
    if(bl>=0){
        _zag_print("BUG E0002 ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_e0010(T);
    if(bl>=0){
        _zag_print("BUG E0010 ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_noparen(T);
    if(bl>=0){
        _zag_print("BUG UNKNOWN-IDENT ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_unknown_call(T,trace);
    if(bl>=0){
        _zag_print("BUG UNKNOWN-FN ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_arity(T,trace);
    if(bl>=0){
        _zag_print("BUG ARITY ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_e0203(T,trace);
    if(bl>=0){
        _zag_print("BUG E0203 ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_uninit(T,trace);
    if(bl>=0){
        _zag_print("BUG UNINIT-VAR ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_offbyone(T,trace);
    if(bl>=0){
        _zag_print("BUG OFF-BY-ONE ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_wrongcmp(T,trace);
    if(bl>=0){
        _zag_print("BUG WRONG-COMPARISON ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_dupfn(T,trace);
    if(bl>=0){
        _zag_print("BUG DUP-FN ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_duptype(T);
    if(bl>=0){
        _zag_print("BUG DUP-TYPE ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_unknown_field(T);
    if(bl>=0){
        _zag_print("BUG UNKNOWN-FIELD ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_nomain(T);
    if(bl>=0){
        _zag_print("BUG NO-MAIN ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_badindex(T);
    if(bl>=0){
        _zag_print("BUG BAD-INDEX ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    bl=chk_brace(T,trace);
    if(bl>=0){
        _zag_print("BUG E0001 ");
        _zag_print(_zag_i64_to_str(bl));
        _zag_print("\n");
        z_free(T);
        return;
    }
    _zag_print("CLEAN\n");
    z_free(T);
    return;
}

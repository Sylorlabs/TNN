// drvD.zag — honest-broker trap driver for Arm D (deliberative chooser).
// Reads param.bin (2 bytes: qid 0..25, fc 0..9) from cwd.
// fc=0 -> d_intake deliberated choice; fc=1..9 -> force candidate fc (oracle runs, D machinery).
// One (qid[, cand]) per process: a panic records incorrect for that question only.
@import("./chooser.zag")
@import("./carrier.zag")

fn unpack_correct(p:i64) i64 { return p-(p/2)*2; }
fn unpack_native(p:i64) i64 { let q1:i64=p/2; return q1-(q1/2)*2; }
fn unpack_fb(p:i64) i64 { let q2:i64=p/4; return q2-(q2/2)*2; }

fn main() void {
    let root:i64=nio_open_root(".");
    let fd:i64=nio_open_child(root,"param.bin",0);
    let pb:[]u8=nio_alloc(16);
    let nr:i64=nio_read_exact(fd,pb,16);
    nio_close(fd);
    nio_close(root);
    let qid:i64=0; let fc:i64=0;
    if (nr>=2) { qid=pb[0] as i64; fc=pb[1] as i64; }
    let out:[]u8=nio_alloc(2097152);
    let at:i64=0;
    let scr:[]u8=nio_alloc(4096);
    let q:[]u8=trap_q(qid);
    let t:[]u8=trap_t(qid);
    let e:[]u8=trap_e(qid);
    let soff:[]u8=nio_alloc(256);
    let slen:[]u8=nio_alloc(256);
    let zlog:[]u8=nio_alloc(8192);
    let zn:i64=0;
    let woffs:[]u8=nio_alloc(256);
    let wlens:[]u8=nio_alloc(256);
    let revbuf:[]u8=nio_alloc(4096);
    let abuf:[]u8=nio_alloc(4096);
    let whyb:[]u8=nio_alloc(4096);
    let p:i64=0;
    if (fc==0) {
        p=d_intake(qid,q,t,e,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    } else {
        p=cand_answer(fc,qid,classify(q),text_shape(t),q,t,e,"BROKER","force",
                      out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf);
    }
    at=ob_raw(out,at,"# BROKER qid=");
    at=ob_i64(out,at,qid,scr);
    at=ob_raw(out,at," fc=");
    at=ob_i64(out,at,fc,scr);
    at=ob_raw(out,at," correct=");
    at=ob_i64(out,at,unpack_correct(p),scr);
    at=ob_raw(out,at," native=");
    at=ob_i64(out,at,unpack_native(p),scr);
    at=ob_raw(out,at," fallback=");
    at=ob_i64(out,at,unpack_fb(p),scr);
    at=ob_nl(out,at);
    let nw:i64=nio_write_all(1,out[0..at]);
    if (nw!=at) { }
    return;
}

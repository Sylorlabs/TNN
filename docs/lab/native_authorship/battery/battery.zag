// battery.zag — NATIVE-AUTHORSHIP TRIAL 1 fresh trap battery (2026-09-27).
//
// 26 never-seen traps targeting the frozen lookup's known weaknesses
// (novel parser vocabulary, multi-level addressing, longer texts, edge text
// shapes, degenerate inputs, strict indexing). Oracles are sealed in
// oracles.txt / ORACLE_MANIFEST.md in this directory.
//
// NEUTRAL CARRIER: this file only publishes (qid, question, text, expected)
// records. It executes NO intake arm. The honest broker imports
// trap_n/trap_q/trap_t/trap_e (+ trap_tag/trap_family) and runs its own
// L/D drivers over the records.


fn trap_n() i64 { return 26; }
fn trap_q(i:i64) []u8 { // question bytes
    if (i==0) { return "how many .'s in the cat sat. the dog ran."; }
    if (i==1) { return "what is the 2nd (second) letter of strawberry"; }
    if (i==2) { return "how many words in the second sentence of the cat sat. the dog ran."; }
    if (i==3) { return "how many 0's in 101010"; }
    if (i==4) { return "how many s's in APPLES"; }
    if (i==5) { return "what is the 3rd letter of the 2nd word of alpha beta gamma delta"; }
    if (i==6) { return "how many e's in the 2nd word of the cheese wheel"; }
    if (i==7) { return "does the 2nd word of abc def contain bcd"; }
    if (i==8) { return "spell the 2nd word of abc def backwards"; }
    if (i==9) { return "what is the 1st letter of the last word of alpha beta gamma"; }
    if (i==10) { return "how many words in w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31 w32 w33 w34 w35 w36 w37 w38 w39 w40 w41 w42 w43 w44 w45 w46 w47 w48 w49 w50 w51 w52 w53 w54 w55 w56 w57 w58 w59 w60 w61 w62 w63 w64 w65 w66 w67 w68 w69 w70 w71 w72 w73 w74 w75 w76 w77 w78 w79 w80 w81 w82 w83 w84 w85 w86 w87 w88 w89 w90 w91 w92 w93 w94 w95 w96 w97 w98 w99 w100 w101 w102 w103 w104 w105 w106 w107 w108 w109 w110 w111 w112 w113 w114 w115 w116 w117 w118 w119"; }
    if (i==11) { return "how many words in a\nb\nc"; }
    if (i==12) { return "how many letters in abc "; }
    if (i==13) { return "what is the 2nd letter of the  quick"; }
    if (i==14) { return "what is the last word of "; }
    if (i==15) { return "how many words in "; }
    if (i==16) { return "how many z's in "; }
    if (i==17) { return "what is the 1st letter of "; }
    if (i==18) { return "does abc contain "; }
    if (i==19) { return "what is the 0th letter of abc"; }
    if (i==20) { return "what is the 9th letter of the 1st word of abc def"; }
    if (i==21) { return "what is the 4th letter of fox"; }
    if (i==22) { return "what is the 0th letter of the 2nd word of abc def"; }
    if (i==23) { return "what is the 9th letter of abc"; }
    if (i==24) { return "what is the letter of the 2nd word of abc def"; }
    if (i==25) { return "what is the letter of the 3rd word of alpha beta gamma"; }
    return "";
}
fn trap_t(i:i64) []u8 { // text bytes
    if (i==0) { return "the cat sat. the dog ran."; }
    if (i==1) { return "strawberry"; }
    if (i==2) { return "the cat sat. the dog ran."; }
    if (i==3) { return "101010"; }
    if (i==4) { return "APPLES"; }
    if (i==5) { return "alpha beta gamma delta"; }
    if (i==6) { return "the cheese wheel"; }
    if (i==7) { return "abc def"; }
    if (i==8) { return "abc def"; }
    if (i==9) { return "alpha beta gamma"; }
    if (i==10) { return "w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31 w32 w33 w34 w35 w36 w37 w38 w39 w40 w41 w42 w43 w44 w45 w46 w47 w48 w49 w50 w51 w52 w53 w54 w55 w56 w57 w58 w59 w60 w61 w62 w63 w64 w65 w66 w67 w68 w69 w70 w71 w72 w73 w74 w75 w76 w77 w78 w79 w80 w81 w82 w83 w84 w85 w86 w87 w88 w89 w90 w91 w92 w93 w94 w95 w96 w97 w98 w99 w100 w101 w102 w103 w104 w105 w106 w107 w108 w109 w110 w111 w112 w113 w114 w115 w116 w117 w118 w119"; }
    if (i==11) { return "a\nb\nc"; }
    if (i==12) { return "abc "; }
    if (i==13) { return "the  quick"; }
    if (i==14) { return ""; }
    if (i==15) { return ""; }
    if (i==16) { return ""; }
    if (i==17) { return ""; }
    if (i==18) { return "abc"; }
    if (i==19) { return "abc"; }
    if (i==20) { return "abc def"; }
    if (i==21) { return "the quick brown fox"; }
    if (i==22) { return "abc def"; }
    if (i==23) { return "abc"; }
    if (i==24) { return "abc def"; }
    if (i==25) { return "alpha beta gamma"; }
    return "";
}

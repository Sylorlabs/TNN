    if (i==13) { return "h"; }
    if (i==14) { return "?"; }
    if (i==15) { return "0"; }
    if (i==16) { return "0"; }
    if (i==17) { return "?"; }
    if (i==18) { return "yes"; }
    if (i==19) { return "?"; }

fn trap_family(i:i64) []u8 { // trap family
    if (i==0) { return "F1-novel-vocab"; }
    if (i==1) { return "F1-novel-vocab"; }
    if (i==2) { return "F1-novel-vocab"; }
    if (i==3) { return "F1-novel-vocab"; }
    if (i==4) { return "F1-novel-vocab"; }
    if (i==5) { return "F2-multilevel"; }
    if (i==6) { return "F2-multilevel"; }
    if (i==7) { return "F2-multilevel"; }
    if (i==8) { return "F2-multilevel"; }
    if (i==9) { return "F2-multilevel"; }
    if (i==10) { return "F3-longer-text"; }
    if (i==11) { return "F4-edge-shape"; }
    if (i==12) { return "F4-edge-shape"; }
    if (i==13) { return "F4-edge-shape"; }
    if (i==14) { return "F5-degenerate"; }
    if (i==15) { return "F5-degenerate"; }
    if (i==16) { return "F5-degenerate"; }
    if (i==17) { return "F5-degenerate"; }
    if (i==18) { return "F5-degenerate"; }
    if (i==19) { return "F6-strict-index"; }

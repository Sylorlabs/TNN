// chooser.zag — Arm D deliberative chunking chooser (native-authorship trial 1).
//
// Replaces the frozen kind/shape lookup with a runtime eliminative
// deliberation over the 9 fixed candidates. Inputs: (qid, question bytes,
// text bytes) ONLY. The deliberation:
//
//   D0  degenerate guard: empty text/question refuses cleanly (no candidate runs)
//   D1  unit filter: the candidate's native addressable unit must express the
//       answer unit (letter / word / number / yes-no / text)
//   D2  span domination: SPAN5's 5-byte grid is strictly coarser than SPAN3's
//   D3  edge filter: named edges prefer the direct edge reader; with no edge
//       named the edge reader is dominated by its own CHAR path
//   D4  addressing-depth filter: two-level addresses need the word->char zoom;
//       zero addressing needs no end-anchoring
//   D5  contains specialization: word-boundary hit test on THIS text decides
//       between word-try and sub-word scan mechanisms
//   D6  final selection: ordered preference rules over survivors, each citing
//       the evidence
//
// Every stage emits a machine-readable trace line (D-FEAT once, D-EV per
// candidate, D-ELIM per fired sub-criterion, D-CHOICE at the end). The trace
// is instrumentation only: it never feeds back into the choice (all
// elimination decisions mutate `alive`; emission only reads).
//
// Zero RNG. Deterministic: byte-identical reruns.
//
// The chooser NEVER calls the frozen lookup (it is not present in dlib.zag),
// never calls cand_why / zoom_choose / zoom_why (kind-keyed rationale
// helpers), and never sees any expected answer: d_intake receives exp only
// to forward it to the executor for scoring, exactly as production does.
@import("./dlib.zag")

// ---------- feature indices into the feat arena (14 x i64) ----------
// 0 kind | 1 shape | 2 nwords | 3 nbytes | 4 nlines | 5 lenclass
// 6 ans_unit | 7 count_unit | 8 addr_depth | 9 edge | 10 last_anchor
// 11 needle_hit | 12 relative | 13 anchor_third

// ans_unit codes: 0 LETTER, 1 WORD, 2 NUMBER, 3 YESNO, 4 TEXT, 5 UNKNOWN
fn d_unitname(u:i64) []u8 {
    if (u==0) { return "LETTER"; }
    if (u==1) { return "WORD"; }
    if (u==2) { return "NUMBER"; }
    if (u==3) { return "YESNO"; }
    if (u==4) { return "TEXT"; }
    return "UNKNOWN";
}

fn d_lcname(l:i64) []u8 {
    if (l==0) { return "SHORT"; }
    if (l==1) { return "MED"; }
    return "LONG";
}

fn d_edgename(e:i64) []u8 {
    if (e==1) { return "FIRST"; }
    if (e==2) { return "LAST"; }
    return "NONE";
}

// d_has_ordinal: the question addresses a specific position (first/last/Nth/contain).
fn d_has_ordinal(q:[]u8) i64 {
    if (has_sub(q,"first")==1) { return 1; }
    if (has_sub(q,"last")==1) { return 1; }
    if (has_sub(q,"1st")==1) { return 1; }
    if (has_sub(q,"contain ")==1) { return 1; }
    let i:i64=0;
    while (i+2<q.len) {
        let c:u8=q[i];
        if (c>=48) {
            if (c<=57) {
                let s1:u8=q[i+1];
                let s2:u8=q[i+2];
                if (s1==116) { if (s2==104) { return 1; } }
                if (s1==115) { if (s2==116) { return 1; } }
                if (s1==110) { if (s2==100) { return 1; } }
                if (s1==114) { if (s2==100) { return 1; } }
            }
        }
        i=i+1;
    }
    return 0;
}

// d_word_hit: word-boundary substring test on THIS text (space=32 or string
// edge on both sides). Same word notion as the executor's word table.
fn d_word_hit(t:[]u8, needle:[]u8) i64 {
    if (needle.len==0) { return 0; }
    if (needle.len>t.len) { return 0; }
    let i:i64=0;
    while (i+needle.len<=t.len) {
        let seg:[]u8=t[i..i+needle.len];
        if (beq(seg,needle)==1) {
            let lb:i64=1;
            let rb:i64=1;
            if (i>0) { if (t[i-1]!=32) { lb=0; } }
            if (i+needle.len<t.len) { if (t[i+needle.len]!=32) { rb=0; } }
            if (lb==1) { if (rb==1) { return 1; } }
        }
        i=i+1;
    }
    return 0;
}

// d_features: compute all input-derived evidence features from (q, t) only.
fn d_features(q:[]u8, t:[]u8, kind:i64, shape:i64, feat:[]u8) void {
    w_i64le(feat,0*8,kind);
    w_i64le(feat,1*8,shape);
    let nw:i64=count_words_bytes(t);
    w_i64le(feat,2*8,nw);
    w_i64le(feat,3*8,t.len);
    let nl:i64=0;
    if (t.len>0) { nl=scan_count(t,0,t.len,10)+1; }
    w_i64le(feat,4*8,nl);
    let lc:i64=0;
    if (t.len>=120) { lc=1; }
    if (t.len>=1500) { lc=2; }
    w_i64le(feat,5*8,lc);
    let au:i64=5;
    if (has_sub(q,"backwards")==1) { au=4; }
    else {
        if (has_sub(q,"contain ")==1) { au=3; }
        else {
            if (has_sub(q,"how many")==1) { au=2; }
            else {
                if (has_sub(q,"letter")==1) { au=0; }
                else {
                    if (has_sub(q,"'s in")==1) { au=0; }
                    else {
                        if (has_sub(q,"word")==1) { au=1; }
                    }
                }
            }
        }
    }
    w_i64le(feat,6*8,au);
    let cu:i64=2;
    if (has_sub(q,"how many words")==1) { cu=1; }
    else {
        if (has_sub(q,"how many letters")==1) { cu=0; }
    }
    w_i64le(feat,7*8,cu);
    // addr_depth: 2 = nested two-level addressing (a sub-word unit addressed
    // inside an addressed word: "the Nth letter/count of the Mth word of T").
    // A bare "first/last word of T" addresses the word itself: one level.
    let ad:i64=0;
    if (has_sub(q," word of ")==1) {
        let nested:i64=0;
        if (au==0) { nested=1; }
        else {
            if (au==3) { nested=1; }
            else {
                if (au==4) { nested=1; }
                else {
                    if (au==2) { if (cu!=1) { nested=1; } }
                }
            }
        }
        if (nested==1) { ad=2; }
        else {
            if (d_has_ordinal(q)==1) { ad=1; }
        }
    }
    else {
        if (d_has_ordinal(q)==1) { ad=1; }
    }
    w_i64le(feat,8*8,ad);
    let e:i64=0;
    if (has_sub(q,"first letter of")==1) { e=1; }
    else {
        if (has_sub(q,"1st letter of")==1) { e=1; }
        else {
            if (has_sub(q,"first word of")==1) { e=1; }
            else {
                if (has_sub(q,"last letter of")==1) { e=2; }
                else {
                    if (has_sub(q,"last word of")==1) { e=2; }
                }
            }
        }
    }
    w_i64le(feat,9*8,e);
    let la:i64=0;
    if (has_sub(q," word of ")==1) {
        let wn:i64=0;
        let inner:[]u8=parse_wordref(q,&wn);
        if (wn==-1) { la=1; }
    }
    w_i64le(feat,10*8,la);
    let nh:i64=0;
    if (au==3) {
        let needle:[]u8=parse_after(q,"contain ");
        nh=d_word_hit(t,needle);
    }
    w_i64le(feat,11*8,nh);
    let rel:i64=0;
    if (has_sub(q,"after ")==1) { rel=1; }
    else {
        if (has_sub(q,"before ")==1) { rel=1; }
    }
    w_i64le(feat,12*8,rel);
    let ath:i64=-1;
    if (ad==2) {
        if (la==1) { ath=2; }
        else {
            let wn2:i64=0;
            let inner2:[]u8=parse_wordref(q,&wn2);
            if (wn2>0) {
                if (nw>0) {
                    let k:i64=wn2-1;
                    if (k>=nw) { k=nw-1; }
                    ath=(3*k)/nw;
                }
            }
        }
    }
    else {
        if (e==1) { ath=0; }
        else {
            if (e==2) { ath=2; }
        }
    }
    w_i64le(feat,13*8,ath);
    return;
}

// ---------- alive-set bit operations (candidates 1..9) ----------
fn d_has(alive:i64, c:i64) i64 {
    let bit:i64=(1 as i64)<<(c as i64);
    if ((alive & bit)!=0) { return 1; }
    return 0;
}

fn d_kill(alive:i64, c:i64) i64 {
    let bit:i64=(1 as i64)<<(c as i64);
    if ((alive & bit)!=0) { return alive-bit; }
    return alive;
}

// d_kill2: eliminate candidate c (if present), appending its id to the
// stage's elim list buffer. Pure choice state; no output.
fn d_kill2(alp:*i64, c:i64, ebuf:[]u8, ep:*i64) void {
    if (d_has(alp.*,c)==1) {
        alp.*=d_kill(alp.*,c);
        let p:i64=ep.*;
        if (p>0) { ebuf[p]=44; p=p+1; }
        ebuf[p]=(48+c) as u8;
        p=p+1;
        ep.*=p;
    }
    return;
}

// ---------- trace emission (instrumentation only; never steers choice) ----------
fn d_emit_feat(qid:i64, feat:[]u8, out:[]u8, atp:*i64, scr:[]u8) void {
    let a:i64=atp.*;
    a=ob_raw(out,a,"# D-FEAT qid=");
    a=ob_i64(out,a,qid,scr);
    a=ob_raw(out,a," kind=");
    a=ob_raw(out,a,kind_name(r_i64le(feat,0*8)));
    a=ob_raw(out,a," shape=");
    a=ob_raw(out,a,shape_name(r_i64le(feat,1*8)));
    a=ob_raw(out,a," nwords=");
    a=ob_i64(out,a,r_i64le(feat,2*8),scr);
    a=ob_raw(out,a," nbytes=");
    a=ob_i64(out,a,r_i64le(feat,3*8),scr);
    a=ob_raw(out,a," nlines=");
    a=ob_i64(out,a,r_i64le(feat,4*8),scr);
    a=ob_raw(out,a," lenclass=");
    a=ob_raw(out,a,d_lcname(r_i64le(feat,5*8)));
    a=ob_raw(out,a," ans_unit=");
    a=ob_raw(out,a,d_unitname(r_i64le(feat,6*8)));
    a=ob_raw(out,a," count_unit=");
    a=ob_i64(out,a,r_i64le(feat,7*8),scr);
    a=ob_raw(out,a," addr_depth=");
    a=ob_i64(out,a,r_i64le(feat,8*8),scr);
    a=ob_raw(out,a," edge=");
    a=ob_raw(out,a,d_edgename(r_i64le(feat,9*8)));
    a=ob_raw(out,a," last_anchor=");
    a=ob_i64(out,a,r_i64le(feat,10*8),scr);
    a=ob_raw(out,a," needle_hit=");
    a=ob_i64(out,a,r_i64le(feat,11*8),scr);
    a=ob_raw(out,a," relative=");
    a=ob_i64(out,a,r_i64le(feat,12*8),scr);
    a=ob_raw(out,a," anchor_third=");
    a=ob_i64(out,a,r_i64le(feat,13*8),scr);
    a=ob_nl(out,a);
    atp.*=a;
    return;
}

// d_emit_ev: one input-specific evidence line per candidate.
fn d_emit_ev(qid:i64, c:i64, feat:[]u8, out:[]u8, atp:*i64, scr:[]u8) void {
    let a:i64=atp.*;
    let nbytes:i64=r_i64le(feat,3*8);
    let nwords:i64=r_i64le(feat,2*8);
    let nlines:i64=r_i64le(feat,4*8);
    let au:i64=r_i64le(feat,6*8);
    let ad:i64=r_i64le(feat,8*8);
    let nh:i64=r_i64le(feat,11*8);
    let la:i64=r_i64le(feat,10*8);
    let ath:i64=r_i64le(feat,13*8);
    let lc:i64=r_i64le(feat,5*8);
    let eg:i64=r_i64le(feat,9*8);
    a=ob_raw(out,a,"# D-EV qid=");
    a=ob_i64(out,a,qid,scr);
    a=ob_raw(out,a," cand=");
    a=ob_i64(out,a,c,scr);
    a=ob_raw(out,a," ");
    a=ob_raw(out,a,cand_name(c));
    a=ob_raw(out,a," ev=\"");
    if (c==1) {
        a=ob_raw(out,a,"byte-scan over ");
        a=ob_i64(out,a,nbytes,scr);
        a=ob_raw(out,a,"B in ");
        a=ob_i64(out,a,nlines,scr);
        a=ob_raw(out,a," lines, no word table; ans_unit=");
        a=ob_raw(out,a,d_unitname(au));
        a=ob_raw(out,a," addr_depth=");
        a=ob_i64(out,a,ad,scr);
    }
    if (c==2) {
        a=ob_raw(out,a,"word table of ");
        a=ob_i64(out,a,nwords,scr);
        a=ob_raw(out,a," words over ");
        a=ob_i64(out,a,nbytes,scr);
        a=ob_raw(out,a,"B, shape=");
        a=ob_raw(out,a,shape_name(r_i64le(feat,1*8)));
        a=ob_raw(out,a,"; ans_unit=");
        a=ob_raw(out,a,d_unitname(au));
    }
    if (c==3) {
        a=ob_raw(out,a,"word locate + char magnify; addr_depth=");
        a=ob_i64(out,a,ad,scr);
        a=ob_raw(out,a," addressing levels over ");
        a=ob_i64(out,a,nwords,scr);
        a=ob_raw(out,a," words");
    }
    if (c==4) {
        a=ob_raw(out,a,"word-try then char-scan on miss; needle word-hit=");
        a=ob_i64(out,a,nh,scr);
        a=ob_raw(out,a," in ");
        a=ob_i64(out,a,nbytes,scr);
        a=ob_raw(out,a,"B text");
    }
    if (c==5) {
        a=ob_raw(out,a,"end-anchored addressing; last_anchor=");
        a=ob_i64(out,a,la,scr);
        a=ob_raw(out,a," anchor_third=");
        a=ob_i64(out,a,ath,scr);
        a=ob_raw(out,a," over ");
        a=ob_i64(out,a,nwords,scr);
        a=ob_raw(out,a," words");
    }
    if (c==6) {
        a=ob_raw(out,a,"dual-direction scan; needle_hit=");
        a=ob_i64(out,a,nh,scr);
        a=ob_raw(out,a," lenclass=");
        a=ob_raw(out,a,d_lcname(lc));
        a=ob_raw(out,a," (");
        a=ob_i64(out,a,nbytes,scr);
        a=ob_raw(out,a,"B)");
    }
    if (c==7) {
        a=ob_raw(out,a,"3B-span grid: ");
        a=ob_i64(out,a,(nbytes+2)/3,scr);
        a=ob_raw(out,a," spans over ");
        a=ob_i64(out,a,nbytes,scr);
        a=ob_raw(out,a,"B");
    }
    if (c==8) {
        a=ob_raw(out,a,"5B-span grid: ");
        a=ob_i64(out,a,(nbytes+4)/5,scr);
        a=ob_raw(out,a," spans over ");
        a=ob_i64(out,a,nbytes,scr);
        a=ob_raw(out,a,"B; strictly coarser than SPAN3");
    }
    if (c==9) {
        a=ob_raw(out,a,"direct edge read; edge=");
        a=ob_raw(out,a,d_edgename(eg));
        a=ob_raw(out,a," ans_unit=");
        a=ob_raw(out,a,d_unitname(au));
    }
    a=ob_raw(out,a,"\"");
    a=ob_nl(out,a);
    atp.*=a;
    return;
}

// d_elim_pre/post: shared D-ELIM line framing around a stage-specific reason.
fn d_elim_pre(qid:i64, stage:[]u8, ebuf:[]u8, elen:i64,
              out:[]u8, atp:*i64, scr:[]u8) i64 {
    let a:i64=atp.*;
    a=ob_raw(out,a,"# D-ELIM qid=");
    a=ob_i64(out,a,qid,scr);
    a=ob_raw(out,a," stage=");
    a=ob_raw(out,a,stage);
    a=ob_raw(out,a," elim=\"");
    a=ob_raw(out,a,ebuf[0..elen]);
    a=ob_raw(out,a,"\" reason=\"");
    return a;
}

fn d_elim_post(out:[]u8, a:i64, atp:*i64) void {
    a=ob_raw(out,a,"\"");
    a=ob_nl(out,a);
    atp.*=a;
    return;
}

// ---------- elimination stages ----------
// S1: unit filter.
fn d_stage_s1(qid:i64, feat:[]u8, alive:*i64, ebuf:[]u8,
              out:[]u8, atp:*i64, scr:[]u8) void {
    let au:i64=r_i64le(feat,6*8);
    let sh:i64=r_i64le(feat,1*8);
    let cu:i64=r_i64le(feat,7*8);
    let ep:i64=0;
    if (au==0) {
        d_kill2(alive,2,ebuf,&ep);
        let a:i64=d_elim_pre(qid,"S1-unit-letter",ebuf,ep,out,atp,scr);
        a=ob_raw(out,a,"ans_unit=LETTER: WORD addresses words; its letter paths are out-of-unit fallback work");
        d_elim_post(out,a,atp);
    }
    ep=0;
    if (au==1) {
        d_kill2(alive,7,ebuf,&ep);
        d_kill2(alive,8,ebuf,&ep);
        let a:i64=d_elim_pre(qid,"S1-unit-word",ebuf,ep,out,atp,scr);
        a=ob_raw(out,a,"ans_unit=WORD: fixed-byte spans cannot align to word boundaries");
        d_elim_post(out,a,atp);
    }
    ep=0;
    if (sh==0) {
        let keep2:i64=0;
        if (au==2) { if (cu==1) { keep2=1; } }
        if (au==1) { keep2=1; }
        if (keep2==0) {
            d_kill2(alive,2,ebuf,&ep);
            let a:i64=d_elim_pre(qid,"S1-shape-single",ebuf,ep,out,atp,scr);
            a=ob_raw(out,a,"shape=single (spaceless text): word table degenerate to one entry; byte scan dominates");
            d_elim_post(out,a,atp);
        }
    }
    return;
}

// S2: span domination.
fn d_stage_s2(qid:i64, feat:[]u8, alive:*i64, ebuf:[]u8,
              out:[]u8, atp:*i64, scr:[]u8) void {
    let ep:i64=0;
    d_kill2(alive,8,ebuf,&ep);
    let a:i64=d_elim_pre(qid,"S2-span-domination",ebuf,ep,out,atp,scr);
    a=ob_raw(out,a,"SPAN5 5B grid strictly coarser than SPAN3 3B grid (");
    a=ob_i64(out,a,(r_i64le(feat,3*8)+4)/5,scr);
    a=ob_raw(out,a," vs ");
    a=ob_i64(out,a,(r_i64le(feat,3*8)+2)/3,scr);
    a=ob_raw(out,a," spans over ");
    a=ob_i64(out,a,r_i64le(feat,3*8),scr);
    a=ob_raw(out,a,"B): no byte-exact answer needs the coarser grid");
    d_elim_post(out,a,atp);
    return;
}

// S3: edge filter.
fn d_stage_s3(qid:i64, feat:[]u8, alive:*i64, ebuf:[]u8,
              out:[]u8, atp:*i64, scr:[]u8) void {
    let eg:i64=r_i64le(feat,9*8);
    let ep:i64=0;
    if (eg==0) {
        d_kill2(alive,9,ebuf,&ep);
        let a:i64=d_elim_pre(qid,"S3-edge-none",ebuf,ep,out,atp,scr);
        a=ob_raw(out,a,"edge=NONE: END_DIRECT degenerates to its CHAR path; dominated by CHAR itself");
        d_elim_post(out,a,atp);
    }
    else {
        d_kill2(alive,7,ebuf,&ep);
        let a:i64=d_elim_pre(qid,"S3-edge-named",ebuf,ep,out,atp,scr);
        a=ob_raw(out,a,"edge=");
        a=ob_raw(out,a,d_edgename(eg));
        a=ob_raw(out,a,": fixed 3B spans cannot address an edge directly");
        d_elim_post(out,a,atp);
    }
    return;
}

// S4: addressing-depth filter.
fn d_stage_s4(qid:i64, feat:[]u8, alive:*i64, ebuf:[]u8,
              out:[]u8, atp:*i64, scr:[]u8) void {
    let ad:i64=r_i64le(feat,8*8);
    let ep:i64=0;
    if (ad==2) {
        d_kill2(alive,4,ebuf,&ep);
        d_kill2(alive,6,ebuf,&ep);
        let a:i64=d_elim_pre(qid,"S4-depth-two",ebuf,ep,out,atp,scr);
        a=ob_raw(out,a,"addr_depth=2: WORD?CHARSCAN is a contains-then-scan mechanism, BOTH_ENDS has no two-level addressing; the word->char zoom dominates");
        d_elim_post(out,a,atp);
    }
    if (ad==0) {
        d_kill2(alive,5,ebuf,&ep);
        let a:i64=d_elim_pre(qid,"S4-depth-zero",ebuf,ep,out,atp,scr);
        a=ob_raw(out,a,"addr_depth=0: no addressing in this question; end-anchoring buys nothing, REV_WORD is WORD with overhead");
        d_elim_post(out,a,atp);
    }
    return;
}

// S5: contains specialization (YESNO questions only).
fn d_stage_s5(qid:i64, feat:[]u8, alive:*i64, ebuf:[]u8,
              out:[]u8, atp:*i64, scr:[]u8) void {
    let au:i64=r_i64le(feat,6*8);
    if (au!=3) { return; }
    let nh:i64=r_i64le(feat,11*8);
    let ep:i64=0;
    if (nh==1) {
        d_kill2(alive,1,ebuf,&ep);
        d_kill2(alive,6,ebuf,&ep);
        d_kill2(alive,7,ebuf,&ep);
        let a:i64=d_elim_pre(qid,"S5-contains-hit",ebuf,ep,out,atp,scr);
        a=ob_raw(out,a,"needle_hit=1: the needle is a whole word in THIS text; full-text scans unnecessary, word-try mechanisms suffice");
        d_elim_post(out,a,atp);
    }
    else {
        d_kill2(alive,2,ebuf,&ep);
        let a:i64=d_elim_pre(qid,"S5-contains-miss",ebuf,ep,out,atp,scr);
        a=ob_raw(out,a,"needle_hit=0: the needle is not a whole word in THIS text; word-table lookup cannot hit, sub-word scan required");
        d_elim_post(out,a,atp);
    }
    return;
}

// ---------- S6: final selection over survivors ----------
// d_first_alive: deterministic preference order; falls back to 1.
fn d_first_alive(alive:i64, c1:i64, c2:i64, c3:i64) i64 {
    if (d_has(alive,c1)==1) { return c1; }
    if (d_has(alive,c2)==1) { return c2; }
    if (d_has(alive,c3)==1) { return c3; }
    return 1;
}

fn d_select(qid:i64, feat:[]u8, alive:i64, rulep:*i64,
            out:[]u8, atp:*i64, scr:[]u8) i64 {
    let kind:i64=r_i64le(feat,0*8);
    let shape:i64=r_i64le(feat,1*8);
    let au:i64=r_i64le(feat,6*8);
    let cu:i64=r_i64le(feat,7*8);
    let ad:i64=r_i64le(feat,8*8);
    let eg:i64=r_i64le(feat,9*8);
    let la:i64=r_i64le(feat,10*8);
    let nh:i64=r_i64le(feat,11*8);
    let lc:i64=r_i64le(feat,5*8);
    let nbytes:i64=r_i64le(feat,3*8);
    let nwords:i64=r_i64le(feat,2*8);
    let w:i64=1;
    let rule:i64=9;
    if (alive==0) {
        w=1; rule=0;
    }
    else {
        if (eg!=0) {
            if (au==0) {
                if (d_has(alive,9)==1) { w=9; rule=1; }
            }
        }
        if (rule==9) {
            if (ad==2) {
                if (d_has(alive,3)==1) { w=3; rule=2; }
            }
        }
        if (rule==9) {
            if (au==3) {
                if (nh==1) { w=d_first_alive(alive,4,3,2); rule=31; }
                else {
                    if (lc==2) { w=d_first_alive(alive,6,4,3); rule=32; }
                    else { w=d_first_alive(alive,4,3,6); rule=33; }
                }
            }
        }
        if (rule==9) {
            if (la==1) {
                if (d_has(alive,5)==1) { w=5; rule=4; }
            }
        }
        if (rule==9) {
            if (au==2) {
                if (cu==1) { w=d_first_alive(alive,2,1,3); rule=51; }
                else { w=d_first_alive(alive,1,2,3); rule=52; }
            }
        }
        if (rule==9) {
            if (au==1) { w=d_first_alive(alive,2,1,3); rule=6; }
        }
        if (rule==9) {
            if (au==4) { w=1; rule=7; }
        }
        if (rule==9) {
            if (au==0) {
                if (ad==1) { w=d_first_alive(alive,1,3,4); rule=10; }
            }
        }
        if (rule==9) {
            if (kind==0) {
                if (shape==1) { w=2; rule=81; }
                else { w=1; rule=82; }
            }
        }
    }
    rulep.*=rule;
    let a:i64=atp.*;
    a=ob_raw(out,a,"# D-CHOICE qid=");
    a=ob_i64(out,a,qid,scr);
    a=ob_raw(out,a," winner=");
    a=ob_i64(out,a,w,scr);
    a=ob_raw(out,a," ");
    a=ob_raw(out,a,cand_name(w));
    a=ob_raw(out,a," rule=F");
    a=ob_i64(out,a,rule,scr);
    a=ob_raw(out,a," why=\"");
    if (rule==0) { a=ob_raw(out,a,"empty survivor set: revive CHAR, the universal mechanism"); }
    if (rule==1) {
        a=ob_raw(out,a,"named letter-edge (edge=");
        a=ob_raw(out,a,d_edgename(eg));
        a=ob_raw(out,a,"): direct O(1) edge read");
    }
    if (rule==2) {
        a=ob_raw(out,a,"two-level address (addr_depth=2): word-scale locate, character-scale resolve");
    }
    if (rule==31) {
        a=ob_raw(out,a,"contains, needle is a whole word in this text: cheap word-boundary try, no scan");
    }
    if (rule==32) {
        a=ob_raw(out,a,"contains, sub-word needle, LONG text (");
        a=ob_i64(out,a,nbytes,scr);
        a=ob_raw(out,a,"B): dual-direction scan, nearer end bounds the work on a hit");
    }
    if (rule==33) {
        a=ob_raw(out,a,"contains, sub-word needle: try word-boundary, magnify to character-span scan on miss");
    }
    if (rule==4) {
        a=ob_raw(out,a,"end-anchored question (last_anchor=1): address from the right");
    }
    if (rule==51) {
        a=ob_raw(out,a,"word count over ");
        a=ob_i64(out,a,nwords,scr);
        a=ob_raw(out,a," words: word-boundary mechanism");
    }
    if (rule==52) {
        a=ob_raw(out,a,"count over ");
        a=ob_i64(out,a,nbytes,scr);
        a=ob_raw(out,a,"B: byte-scan mechanism");
    }
    if (rule==6) {
        a=ob_raw(out,a,"word retrieval: word-table addressing");
    }
    if (rule==7) {
        a=ob_raw(out,a,"reversal is a byte-order operation: character units");
    }
    if (rule==10) {
        a=ob_raw(out,a,"single character position (addr_depth=1, ans_unit=LETTER): byte-scan addressing resolves the position directly");
    }
    if (rule==81) {
        a=ob_raw(out,a,"unknown question structure (kind=0): word-structured text (shape=multi), most general word-unit mechanism");
    }
    if (rule==82) {
        a=ob_raw(out,a,"unknown question structure (kind=0): unstructured text, most general byte-scan mechanism");
    }
    if (rule==9) {
        a=ob_raw(out,a,"fallback: CHAR byte-scan is the universal mechanism");
    }
    a=ob_raw(out,a,"\"");
    a=ob_nl(out,a);
    atp.*=a;
    return w;
}

// d_choice_why: short rationale for the live choice line (shown to operators).
fn d_choice_why(rule:i64, whyb:[]u8) []u8 {
    let w:[]u8="D(F9): deliberated fallback -> CHAR universal byte-scan";
    if (rule==0) { w="D(F0): survivor set empty, revived CHAR"; }
    if (rule==1) { w="D(F1): named letter-edge -> END_DIRECT O(1) read"; }
    if (rule==2) { w="D(F2): two-level address -> WORD>CHAR locate+magnify"; }
    if (rule==31) { w="D(F31): contains, whole-word needle -> WORD?CHARSCAN try"; }
    if (rule==32) { w="D(F32): contains, long text -> BOTH_ENDS dual scan"; }
    if (rule==33) { w="D(F33): contains, sub-word needle -> WORD?CHARSCAN try+scan"; }
    if (rule==4) { w="D(F4): end-anchored -> REV_WORD"; }
    if (rule==51) { w="D(F51): word count -> WORD table"; }
    if (rule==52) { w="D(F52): byte count -> CHAR scan"; }
    if (rule==6) { w="D(F6): word retrieval -> WORD table"; }
    if (rule==7) { w="D(F7): reversal -> CHAR byte order"; }
    if (rule==10) { w="D(F10): single letter position -> CHAR scan"; }
    if (rule==81) { w="D(F81): unknown Q, word-structured text -> WORD"; }
    if (rule==82) { w="D(F82): unknown Q, unstructured text -> CHAR"; }
    let i:i64=0;
    while (i<w.len) { whyb[i]=w[i]; i=i+1; }
    return whyb[0..w.len];
}

// d_deliberate: full deliberation; returns the winning candidate id.
fn d_deliberate(qid:i64, q:[]u8, t:[]u8,
                out:[]u8, atp:*i64, scr:[]u8, feat:[]u8, ebuf:[]u8,
                rulep:*i64) i64 {
    let kind:i64=classify(q);
    let shape:i64=text_shape(t);
    d_features(q,t,kind,shape,feat);
    d_emit_feat(qid,feat,out,atp,scr);
    let c:i64=1;
    while (c<=9) {
        d_emit_ev(qid,c,feat,out,atp,scr);
        c=c+1;
    }
    let alive:i64=1022;
    d_stage_s1(qid,feat,&alive,ebuf,out,atp,scr);
    d_stage_s2(qid,feat,&alive,ebuf,out,atp,scr);
    d_stage_s3(qid,feat,&alive,ebuf,out,atp,scr);
    d_stage_s4(qid,feat,&alive,ebuf,out,atp,scr);
    d_stage_s5(qid,feat,&alive,ebuf,out,atp,scr);
    let w:i64=d_select(qid,feat,alive,rulep,out,atp,scr);
    return w;
}

// d_intake: Arm D entry. Same signature as the production entry; the choice
// is deliberated, the executor (cand_answer) is unchanged.
fn d_intake(qid:i64, q:[]u8, t:[]u8, exp:[]u8,
            out:[]u8, atp:*i64, scr:[]u8,
            soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
            woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8,
            whyb:[]u8) i64 {
    // D0: degenerate guard — refuse cleanly, run no candidate.
    if (t.len==0) {
        let a:i64=atp.*;
        a=ob_raw(out,a,"# D-REFUSE qid=");
        a=ob_i64(out,a,qid,scr);
        a=ob_raw(out,a," reason=\"empty text: no candidate runs\"");
        a=ob_nl(out,a);
        atp.*=a;
        emit_resline("DINTAKE","?",exp,0,0,0,0,0,0,out,atp,scr);
        return pack_stats(0,0,0,0,0,0);
    }
    if (q.len==0) {
        let a:i64=atp.*;
        a=ob_raw(out,a,"# D-REFUSE qid=");
        a=ob_i64(out,a,qid,scr);
        a=ob_raw(out,a," reason=\"empty question: no candidate runs\"");
        a=ob_nl(out,a);
        atp.*=a;
        emit_resline("DINTAKE","?",exp,0,0,0,0,0,0,out,atp,scr);
        return pack_stats(0,0,0,0,0,0);
    }
    let feat:[]u8=nio_alloc(128);
    let ebuf:[]u8=nio_alloc(64);
    let rule:i64=9;
    let w:i64=d_deliberate(qid,q,t,out,atp,scr,feat,ebuf,&rule);
    let why:[]u8=d_choice_why(rule,whyb);
    let p:i64=cand_answer(w,qid,classify(q),text_shape(t),q,t,exp,"DINTAKE",why,
                          out,atp,scr,soff,slen,zlog,zn,
                          woffs,wlens,revbuf,abuf);
    nio_free(feat);
    nio_free(ebuf);
    return p;
}

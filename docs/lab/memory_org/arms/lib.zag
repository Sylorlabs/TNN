// MORG shared library — storage substrate + retrieval for all three arms.
// Pure Zag, zero RNG, deterministic. Pinned znc.
// Conventions: tables are []u8 arenas with u32 little-endian words;
// item table: [n:u32] then per item 10xu32 (off,len) x5 fields into buf.
// Field order: 0=id 1=domain 2=type 3=subject 4=text.
// Schemes: 0=S1 1=S2 2=S3 3=S4 4=S5 5=S6 ; 10=IMPOSED(type->domain) ; 11=FLAT.
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- raw io ----------------
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;while(i<s.len){b[i]=s[i];i=i+1;}b[s.len]=0;return b;
}
fn f_open_rd(path:[]u8)i64 {
    let s:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(s) as i64,0,0,0,0,0);
    nio_free(s);return fd;
}
fn f_size_fd(fd:i64)i64 {
    let st:[]u8=nio_alloc(256);
    let rc:i64=_zag_raw_syscall(5,fd,_zag_slice_ptr(st) as i64,0,0,0,0);
    let sz:i64=-1;
    if(rc==0){
        let b0:i64=st[48] as i64;let b1:i64=st[49] as i64;
        let b2:i64=st[50] as i64;let b3:i64=st[51] as i64;
        let b4:i64=st[52] as i64;let b5:i64=st[53] as i64;
        let b6:i64=st[54] as i64;let b7:i64=st[55] as i64;
        sz=b0+b1*256+b2*65536+b3*16777216+b4*4294967296+b5*1099511627776+b6*281474976710656+b7*72057594037927936;
    }
    nio_free(st);return sz;
}
fn f_exists(path:[]u8)i32 {
    let fd:i64=f_open_rd(path);
    if(fd<0){return 0;}
    _zag_raw_syscall(3,fd,0,0,0,0,0);return 1;
}
fn f_read(path:[]u8)[]u8 {
    let fd:i64=f_open_rd(path);
    if(fd<0){return "";}
    let sz:i64=f_size_fd(fd);
    if(sz<0 || sz>8000000){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let buf:[]u8=nio_alloc((sz as i32)+1);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i64=0;let calls:i32=0;let ok:i32=1;
    while(at<sz && calls<4096 && ok==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+at,sz-at,0,0,0);
        calls=calls+1;
        if(n==-4){ok=1;}
        else{if(n<=0){ok=0;}else{at=at+n;}}
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(ok==0 || at!=sz){return "";}
    return buf[0..(sz as i32)];
}
fn f_write(path:[]u8,data:[]u8)i64 {
    let s:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(s) as i64,577,420,0,0,0);
    nio_free(s);
    if(fd<0){return -1;}
    let at:i64=0;let calls:i32=0;let len:i64=data.len as i64;let ok:i32=1;
    while(at<len && calls<4096 && ok==1){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+at,len-at,0,0,0);
        calls=calls+1;
        if(n==-4){ok=1;}
        else{if(n<=0){ok=0;}else{at=at+n;}}
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(ok==0 || at!=len){return -1;}
    return len;
}
fn f_mkdir(path:[]u8)i64 {
    let s:[]u8=z_cstr(path);
    let rc:i64=_zag_raw_syscall(83,_zag_slice_ptr(s) as i64,448,0,0,0,0);
    nio_free(s);
    if(rc==-17){return 0;}
    return rc;
}
fn f_rename(a:[]u8,b:[]u8)i64 {
    let s1:[]u8=z_cstr(a);let s2:[]u8=z_cstr(b);
    let rc:i64=_zag_raw_syscall(38,_zag_slice_ptr(s1) as i64,_zag_slice_ptr(s2) as i64,0,0,0,0);
    nio_free(s1);nio_free(s2);return rc;
}
fn concat(a:[]u8,b:[]u8)[]u8 {
    let o:[]u8=nio_alloc(a.len+b.len+1);
    let i:i32=0;while(i<a.len){o[i]=a[i];i=i+1;}
    let j:i32=0;while(j<b.len){o[a.len+j]=b[j];j=j+1;}
    return o[0..a.len+b.len];
}
fn path_join(dir:[]u8,name:[]u8)[]u8 {
    return concat(concat(dir,"/"),name);
}

// ---------------- string utils ----------------
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn u32get(b:[]u8,at:i32)i64 {
    let b0:i64=b[at] as i64;let b1:i64=b[at+1] as i64;
    let b2:i64=b[at+2] as i64;let b3:i64=b[at+3] as i64;
    return b0+b1*256+b2*65536+b3*16777216;
}
fn u32put(b:[]u8,at:i32,v:i64)void {
    let v0:i64=v&255;let v1:i64=(v>>8)&255;
    let v2:i64=(v>>16)&255;let v3:i64=(v>>24)&255;
    b[at]=v0 as u8;b[at+1]=v1 as u8;b[at+2]=v2 as u8;b[at+3]=v3 as u8;
}
fn bytes_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn bytes_lt(a:[]u8,b:[]u8)i32 {
    let n:i32=a.len;if(b.len<n){n=b.len;}
    let i:i32=0;
    while(i<n){
        let x:i32=a[i] as i32;let y:i32=b[i] as i32;
        if(x<y){return 1;}
        if(x>y){return 0;}
        i=i+1;
    }
    if(a.len<b.len){return 1;}
    return 0;
}
fn lower(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c>=65 && c<=90){o[i]=(c+32) as u8;}else{o[i]=s[i];}
        i=i+1;
    }
    return o[0..s.len];
}
fn is_alnum(c:i32)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn starts_with(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    let i:i32=0;while(i<pre.len){if(s[i]!=pre[i]){return 0;}i=i+1;}
    return 1;
}

// ---------------- parsing ----------------
// lines_of: arena [n:u32][off:u32,len:u32]* offsets into buf (\n and \r stripped)
fn lines_of(buf:[]u8)[]u8 {
    let n:i32=0;let i:i32=0;
    while(i<buf.len){if(buf[i]==10){n=n+1;}i=i+1;}
    if(buf.len>0 && buf[buf.len-1]!=10){n=n+1;}
    let ar:[]u8=nio_alloc(4+n*8+8);
    u32put(ar,0,n as i64);
    let li:i32=0;let start:i32=0;i=0;
    while(i<buf.len){
        if(buf[i]==10){
            let end:i32=i;
            if(end>start && buf[end-1]==13){end=end-1;}
            u32put(ar,4+li*8,start as i64);u32put(ar,4+li*8+4,(end-start) as i64);
            li=li+1;start=i+1;
        }
        i=i+1;
    }
    if(start<buf.len){
        let end:i32=buf.len;
        if(buf[end-1]==13){end=end-1;}
        u32put(ar,4+li*8,start as i64);u32put(ar,4+li*8+4,(end-start) as i64);
        li=li+1;
    }
    u32put(ar,0,li as i64);
    return ar;
}
fn line_n(ar:[]u8)i32 {return u32get(ar,0) as i32;}
fn line_slice(buf:[]u8,ar:[]u8,i:i32)[]u8 {
    let o:i32=u32get(ar,4+i*8) as i32;let l:i32=u32get(ar,4+i*8+4) as i32;
    return buf[o..o+l];
}
// fields_of: split line on sep into at most maxf fields; arena [n][off,len]* into line
fn fields_of(line:[]u8,sep:u8,maxf:i32)[]u8 {
    let ar:[]u8=nio_alloc(4+maxf*8+8);
    let fi:i32=0;let start:i32=0;let i:i32=0;let done:i32=0;
    while(i<line.len && done==0){
        if(line[i]==sep && fi<maxf-1){
            u32put(ar,4+fi*8,start as i64);u32put(ar,4+fi*8+4,(i-start) as i64);
            fi=fi+1;start=i+1;
        }
        i=i+1;
    }
    u32put(ar,4+fi*8,start as i64);u32put(ar,4+fi*8+4,(line.len-start) as i64);
    fi=fi+1;
    u32put(ar,0,fi as i64);
    return ar;
}
fn fld_n(ar:[]u8)i32 {return u32get(ar,0) as i32;}
fn fld(ar:[]u8,line:[]u8,i:i32)[]u8 {
    let o:i32=u32get(ar,4+i*8) as i32;let l:i32=u32get(ar,4+i*8+4) as i32;
    return line[o..o+l];
}
// first field (id) of a raw line, without full field parse
fn line_id(line:[]u8)[]u8 {
    let i:i32=0;
    while(i<line.len){if(line[i]==124){return line[0..i];}i=i+1;}
    return line;
}
// sort line indices of la (lines into buf) by id ascending; returns [n][idx:u32]*
fn sort_lines_by_id(buf:[]u8,la:[]u8)[]u8 {
    let n:i32=line_n(la);
    let order:[]u8=nio_alloc(4+n*4+8);u32put(order,0,n as i64);
    let used:[]u8=nio_alloc(n+1);
    let k:i32=0;
    while(k<n){
        let best:i32=-1;let j:i32=0;
        while(j<n){
            if(used[j]==0){
                if(best<0){best=j;}
                else{
                    let aj:[]u8=line_id(line_slice(buf,la,j));
                    let ab:[]u8=line_id(line_slice(buf,la,best));
                    if(bytes_lt(aj,ab)==1){best=j;}
                }
            }
            j=j+1;
        }
        used[best]=1;u32put(order,4+k*4,best as i64);k=k+1;
    }
    return order;
}
// item table from canonical buf: [n:u32] then per item 10xu32 (off,len)x5
fn build_tab(buf:[]u8)[]u8 {
    let la:[]u8=lines_of(buf);
    let n:i32=line_n(la);
    let tab:[]u8=nio_alloc(4+n*40+8);u32put(tab,0,0);
    let cnt:i32=0;let i:i32=0;
    while(i<n){
        let ln:[]u8=line_slice(buf,la,i);
        if(ln.len>0){
            let fa:[]u8=fields_of(ln,124,5);
            if(fld_n(fa)==5){
                let f:i32=0;
                while(f<5){
                    let o:i32=u32get(fa,4+f*8) as i32;let l:i32=u32get(fa,4+f*8+4) as i32;
                    let base:i32=u32get(la,4+i*8) as i32;
                    u32put(tab,4+cnt*40+f*8,(base+o) as i64);
                    u32put(tab,4+cnt*40+f*8+4,l as i64);
                    f=f+1;
                }
                cnt=cnt+1;
            }
        }
        i=i+1;
    }
    u32put(tab,0,cnt as i64);
    return tab;
}
fn tab_n(tab:[]u8)i32 {return u32get(tab,0) as i32;}
fn item_field(buf:[]u8,tab:[]u8,i:i32,f:i32)[]u8 {
    let o:i32=u32get(tab,4+i*40+f*8) as i32;let l:i32=u32get(tab,4+i*40+f*8+4) as i32;
    return buf[o..o+l];
}
fn item_find(buf:[]u8,tab:[]u8,id:[]u8)i32 {
    let n:i32=tab_n(tab);let i:i32=0;
    while(i<n){
        if(bytes_eq(item_field(buf,tab,i,0),id)==1){return i;}
        i=i+1;
    }
    return -1;
}
// deliberate mutation protocol: write tmp, read back, byte-compare,
// then write the real target, read back, byte-compare. Any mismatch FAILS.
// (rename(2) is avoided: it returns EINVAL under this znc build.)
fn store_commit(dir:[]u8,name:[]u8,data:[]u8)i32 {
    let p1:[]u8=path_join(dir,concat(name,".tmp"));
    let p2:[]u8=path_join(dir,name);
    if(f_write(p1,data)<0){_zag_println("commit: tmp write failed");return -1;}
    let back:[]u8=f_read(p1);
    if(bytes_eq(back,data)==0){_zag_println("commit: tmp readback mismatch");return -2;}
    if(f_write(p2,data)<0){_zag_println("commit: target write failed");return -3;}
    let back2:[]u8=f_read(p2);
    if(bytes_eq(back2,data)==0){_zag_println("commit: final readback mismatch");return -4;}
    return 0;
}
fn ops_write(dir:[]u8,reads:i64,writes:i64,moves:i64)i32 {
    let p:[]u8=path_join(dir,"ops.txt");
    let d:[]u8=concat(concat(concat(concat(concat(concat("reads=",i64s(reads)),"\n"),"writes="),i64s(writes)),"\n"),"moves=");
    let d2:[]u8=concat(d,concat(i64s(moves),"\n"));
    if(f_write(p,d2)<0){return -1;}
    return 0;
}
fn ops_read(dir:[]u8,slot:i32)i64 {
    let p:[]u8=path_join(dir,"ops.txt");
    let b:[]u8=f_read(p);
    if(b.len==0){return 0;}
    let la:[]u8=lines_of(b);
    if(slot>=line_n(la)){return 0;}
    let ln:[]u8=line_slice(b,la,slot);
    let fa:[]u8=fields_of(ln,61,2);
    if(fld_n(fa)!=2){return 0;}
    let v:[]u8=fld(fa,ln,1);
    let r:i64=0;let i:i32=0;
    while(i<v.len){r=r*10+((v[i] as i32)-48) as i64;i=i+1;}
    return r;
}

// ---------------- schemes ----------------
// level codes: 0=type 1=domain 2=subject
fn scheme_nlevels(s:i32)i32 {
    if(s==2){return 2;}
    if(s==5){return 1;}
    if(s==10){return 2;}
    if(s==11){return 0;}
    return 3;
}
fn scheme_level(s:i32,l:i32)i32 {
    if(s==0){if(l==0){return 0;}if(l==1){return 1;}return 2;}
    if(s==1){if(l==0){return 1;}if(l==1){return 0;}return 2;}
    if(s==2){if(l==0){return 2;}return 0;}
    if(s==3){if(l==0){return 0;}if(l==1){return 2;}return 1;}
    if(s==4){if(l==0){return 1;}if(l==1){return 2;}return 0;}
    if(s==10){if(l==0){return 0;}return 1;}
    return -1;
}
fn scheme_levels_frozen(s:i32)i32 {
    if(s==0){return 3;}if(s==1){return 3;}if(s==2){return 2;}
    if(s==3){return 3;}if(s==4){return 3;}return 1;
}
fn scheme_name(s:i32)[]u8 {
    if(s==0){return "S1";}if(s==1){return "S2";}if(s==2){return "S3";}
    if(s==3){return "S4";}if(s==4){return "S5";}return "S6";
}
fn level_field(lv:i32,tf:[]u8,df:[]u8,sf:[]u8)[]u8 {
    if(lv==0){return tf;}if(lv==1){return df;}return sf;
}
fn level_hint(lv:i32,th:[]u8,dh:[]u8,sh:[]u8)[]u8 {
    if(lv==0){return th;}if(lv==1){return dh;}return sh;
}
// category path for an item under scheme s; S6 -> "*"
fn scheme_path(s:i32,tf:[]u8,df:[]u8,sf:[]u8)[]u8 {
    let nl:i32=scheme_nlevels(s);
    if(nl==0){return "*";}
    let p:[]u8=level_field(scheme_level(s,0),tf,df,sf);
    let l:i32=1;
    while(l<nl){
        p=concat(p,"/");
        p=concat(p,level_field(scheme_level(s,l),tf,df,sf));
        l=l+1;
    }
    return p;
}
// filing table: [n:u32] then per item 4xu32 (id_off,id_len,path_off,path_len) into fbuf
fn build_ftab(fbuf:[]u8)[]u8 {
    let la:[]u8=lines_of(fbuf);
    let n:i32=line_n(la);
    let ft:[]u8=nio_alloc(4+n*16+8);u32put(ft,0,0);
    let cnt:i32=0;let i:i32=0;
    while(i<n){
        let ln:[]u8=line_slice(fbuf,la,i);
        if(ln.len>0){
            let fa:[]u8=fields_of(ln,124,2);
            if(fld_n(fa)==2){
                let f:i32=0;
                while(f<2){
                    let o:i32=u32get(fa,4+f*8) as i32;let l:i32=u32get(fa,4+f*8+4) as i32;
                    let base:i32=u32get(la,4+i*8) as i32;
                    u32put(ft,4+cnt*16+f*8,(base+o) as i64);
                    u32put(ft,4+cnt*16+f*8+4,l as i64);
                    f=f+1;
                }
                cnt=cnt+1;
            }
        }
        i=i+1;
    }
    u32put(ft,0,cnt as i64);
    return ft;
}
fn filing_path(fbuf:[]u8,ft:[]u8,id:[]u8)[]u8 {
    let n:i32=u32get(ft,0) as i32;let i:i32=0;
    while(i<n){
        let o:i32=u32get(ft,4+i*16) as i32;let l:i32=u32get(ft,4+i*16+4) as i32;
        let cur:[]u8=fbuf[o..o+l];
        if(bytes_eq(cur,id)==1){
            let po:i32=u32get(ft,4+i*16+8) as i32;let pl:i32=u32get(ft,4+i*16+12) as i32;
            return fbuf[po..po+pl];
        }
        i=i+1;
    }
    return "";
}
// ---------------- retrieval ----------------
// tokenize lowercased s: arena [nt][off,len]* into s
fn tokenize(s:[]u8)[]u8 {
    let nt:i32=0;let i:i32=0;let start:i32=-1;
    while(i<=s.len){
        let c:i32=-1;if(i<s.len){c=s[i] as i32;}
        let al:i32=is_alnum(c);
        if(al==1 && start<0){start=i;}
        if(al==0 && start>=0){nt=nt+1;start=-1;}
        i=i+1;
    }
    let ar:[]u8=nio_alloc(4+nt*8+8);u32put(ar,0,nt as i64);
    let ti:i32=0;i=0;start=-1;
    while(i<=s.len){
        let c:i32=-1;if(i<s.len){c=s[i] as i32;}
        let al:i32=is_alnum(c);
        if(al==1 && start<0){start=i;}
        if(al==0 && start>=0){
            u32put(ar,4+ti*8,start as i64);u32put(ar,4+ti*8+4,(i-start) as i64);
            ti=ti+1;start=-1;
        }
        i=i+1;
    }
    return ar;
}
// count exact-token occurrences of term in pre-lowercased hay
fn tok_count(hay:[]u8,term:[]u8)i32 {
    if(term.len==0){return 0;}
    let n:i32=0;let i:i32=0;let start:i32=-1;
    while(i<=hay.len){
        let c:i32=-1;if(i<hay.len){c=hay[i] as i32;}
        let al:i32=is_alnum(c);
        if(al==1 && start<0){start=i;}
        if(al==0 && start>=0){
            if(i-start==term.len){
                let k:i32=0;let eq:i32=1;
                while(k<term.len){if(hay[start+k]!=term[k]){eq=0;}k=k+1;}
                if(eq==1){n=n+1;}
            }
            start=-1;
        }
        i=i+1;
    }
    return n;
}
// hay arena: [n:u32][off,len]* then hay bytes; hay = lower(text subj dom type)
fn build_hay(buf:[]u8,tab:[]u8)[]u8 {
    let n:i32=tab_n(tab);
    let est:i32=n*300+16;
    let hb:[]u8=nio_alloc(4+n*8+8+est);
    u32put(hb,0,n as i64);
    let base:i32=4+n*8+8;
    let at:i32=base;let i:i32=0;
    while(i<n){
        let t:[]u8=lower(item_field(buf,tab,i,4));
        let s:[]u8=lower(item_field(buf,tab,i,3));
        let d:[]u8=lower(item_field(buf,tab,i,1));
        let y:[]u8=lower(item_field(buf,tab,i,2));
        u32put(hb,4+i*8,at as i64);
        let start:i32=at;
        let k:i32=0;while(k<t.len){hb[at]=t[k];at=at+1;k=k+1;}
        hb[at]=32;at=at+1;
        k=0;while(k<s.len){hb[at]=s[k];at=at+1;k=k+1;}
        hb[at]=32;at=at+1;
        k=0;while(k<d.len){hb[at]=d[k];at=at+1;k=k+1;}
        hb[at]=32;at=at+1;
        k=0;while(k<y.len){hb[at]=y[k];at=at+1;k=k+1;}
        u32put(hb,4+i*8+4,(at-start) as i64);
        i=i+1;
    }
    return hb[0..at];
}
fn hay_of(hb:[]u8,i:i32)[]u8 {
    let o:i32=u32get(hb,4+i*8) as i32;let l:i32=u32get(hb,4+i*8+4) as i32;
    return hb[o..o+l];
}
fn is_candidate(s:i32,tf:[]u8,df:[]u8,sf:[]u8,th:[]u8,dh:[]u8,sh:[]u8)i32 {
    let nl:i32=scheme_nlevels(s);let l:i32=0;
    while(l<nl){
        let lv:i32=scheme_level(s,l);
        let f:[]u8=level_field(lv,tf,df,sf);
        let h:[]u8=level_hint(lv,th,dh,sh);
        if(h.len>0 && bytes_eq(f,h)==0){return 0;}
        l=l+1;
    }
    return 1;
}
// top-k ranked item ids for one query: returns [k][id_off,id_len]* into buf
fn topk(buf:[]u8,tab:[]u8,hb:[]u8,s:i32,th:[]u8,dh:[]u8,sh:[]u8,qlow:[]u8,qt:[]u8,k:i32)[]u8 {
    let n:i32=tab_n(tab);
    let scores:[]u8=nio_alloc(n*4+8);
    let cand:[]u8=nio_alloc(n+1);
    let picked:[]u8=nio_alloc(n+1);
    let i:i32=0;
    while(i<n){u32put(scores,i*4,0);cand[i]=0;picked[i]=0;i=i+1;}
    i=0;
    while(i<n){
        let tf:[]u8=item_field(buf,tab,i,2);
        let df:[]u8=item_field(buf,tab,i,1);
        let sf:[]u8=item_field(buf,tab,i,3);
        if(is_candidate(s,tf,df,sf,th,dh,sh)==1){
            cand[i]=1;
            let hay:[]u8=hay_of(hb,i);
            let sc:i64=0;let t:i32=0;let nt:i32=u32get(qt,0) as i32;
            while(t<nt){
                let to:i32=u32get(qt,4+t*8) as i32;let tl:i32=u32get(qt,4+t*8+4) as i32;
                sc=sc+(tok_count(hay,qlow[to..to+tl]) as i64);
                t=t+1;
            }
            u32put(scores,i*4,sc);
        }
        i=i+1;
    }
    let out:[]u8=nio_alloc(4+k*8+8);u32put(out,0,0);
    let p:i32=0;let done:i32=0;
    while(p<k && done==0){
        let best:i32=-1;let bi:i32=0;
        while(bi<n){
            if(cand[bi]==1 && picked[bi]==0){
                if(best<0){best=bi;}
                else{
                    let sb:i64=u32get(scores,bi*4);let so:i64=u32get(scores,best*4);
                    if(sb>so){best=bi;}
                    else{
                        if(sb==so){
                            if(bytes_lt(item_field(buf,tab,bi,0),item_field(buf,tab,best,0))==1){best=bi;}
                        }
                    }
                }
            }
            bi=bi+1;
        }
        if(best<0){done=1;}
        else{
            picked[best]=1;
            let cnt:i32=u32get(out,0) as i32;
            u32put(out,4+cnt*8,u32get(tab,4+best*40));
            u32put(out,4+cnt*8+4,u32get(tab,4+best*40+4));
            u32put(out,0,(cnt+1) as i64);
            p=p+1;
        }
    }
    return out;
}

// ---------------- queries ----------------
// qtab: [nq:u32] then per query 16xu32 (off,len)x8 into qbuf
// fields: 0=qid 1=split 2=class 3=thint 4=dhint 5=shint 6=text 7=gold
fn parse_queries(qbuf:[]u8)[]u8 {
    let la:[]u8=lines_of(qbuf);
    let n:i32=line_n(la);
    let qt:[]u8=nio_alloc(4+n*64+8);u32put(qt,0,0);
    let cnt:i32=0;let i:i32=0;
    while(i<n){
        let ln:[]u8=line_slice(qbuf,la,i);
        if(ln.len>0){
            let fa:[]u8=fields_of(ln,124,8);
            if(fld_n(fa)==8){
                let f:i32=0;
                while(f<8){
                    let o:i32=u32get(fa,4+f*8) as i32;let l:i32=u32get(fa,4+f*8+4) as i32;
                    let base:i32=u32get(la,4+i*8) as i32;
                    u32put(qt,4+cnt*64+f*8,(base+o) as i64);
                    u32put(qt,4+cnt*64+f*8+4,l as i64);
                    f=f+1;
                }
                cnt=cnt+1;
            }
        }
        i=i+1;
    }
    u32put(qt,0,cnt as i64);
    return qt;
}
fn qfield(qb:[]u8,qt:[]u8,q:i32,f:i32)[]u8 {
    let o:i32=u32get(qt,4+q*64+f*8) as i32;let l:i32=u32get(qt,4+q*64+f*8+4) as i32;
    return qb[o..o+l];
}
// gold ids of query q: arena [ng][off,len]* into qb
fn gold_ids(qb:[]u8,qt:[]u8,q:i32)[]u8 {
    let g:[]u8=qfield(qb,qt,q,7);
    let fa:[]u8=fields_of(g,44,256);
    let ng:i32=fld_n(fa);
    let ar:[]u8=nio_alloc(4+ng*8+8);u32put(ar,0,ng as i64);
    let base:i32=u32get(qt,4+q*64+7*8) as i32;
    let i:i32=0;
    while(i<ng){
        let o:i32=u32get(fa,4+i*8) as i32;let l:i32=u32get(fa,4+i*8+4) as i32;
        u32put(ar,4+i*8,(base+o) as i64);u32put(ar,4+i*8+4,l as i64);
        i=i+1;
    }
    return ar;
}
fn i64put(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    b[at+4]=((v>>32)&255) as u8;b[at+5]=((v>>40)&255) as u8;
    b[at+6]=((v>>48)&255) as u8;b[at+7]=((v>>56)&255) as u8;
}
fn i64get(b:[]u8,at:i32)i64 {
    let r:i64=(b[at] as i64)+((b[at+1] as i64)*256)+((b[at+2] as i64)*65536)+((b[at+3] as i64)*16777216);
    r=r+((b[at+4] as i64)*4294967296)+((b[at+5] as i64)*1099511627776);
    r=r+((b[at+6] as i64)*281474976710656)+((b[at+7] as i64)*72057594037927936);
    return r;
}
fn scheme_idx_of(s:[]u8)i32 {
    if(s.len<2){return -1;}
    return (s[1] as i32)-49;
}
// argmax with frozen tie-break (fewer levels, then lowest index); sc=(nscopes*6) i64s
fn argmax_tb(sc:[]u8,si:i32)i32 {
    let best:i32=0;let bv:i64=i64get(sc,(si*6+0)*8);
    let s:i32=1;
    while(s<6){
        let v:i64=i64get(sc,(si*6+s)*8);
        if(v>bv){bv=v;best=s;}
        else{
            if(v==bv){
                let ls:i32=scheme_levels_frozen(s);let lb:i32=scheme_levels_frozen(best);
                if(ls<lb){best=s;}
            }
        }
        s=s+1;
    }
    return best;
}
// ---------------- handlers ----------------
fn h_ingest(corpus:[]u8,dir:[]u8,kind:i32)i32 {
    f_mkdir(dir);
    let cb:[]u8=f_read(corpus);
    let la:[]u8=lines_of(cb);
    let n0:i32=line_n(la);
    // collect valid lines, dedupe ids (keep first)
    let keep:[]u8=nio_alloc(n0+1);
    let i:i32=0;
    while(i<n0){
        let ln:[]u8=line_slice(cb,la,i);
        let fa:[]u8=fields_of(ln,124,5);
        if(fld_n(fa)==5 && fld(fa,ln,0).len>0){
            let id:[]u8=fld(fa,ln,0);
            let dup:i32=0;let j:i32=0;
            while(j<i){
                if(keep[j]==1){
                    let lj:[]u8=line_slice(cb,la,j);
                    let fj:[]u8=fields_of(lj,124,5);
                    if(bytes_eq(fld(fj,lj,0),id)==1){dup=1;}
                }
                j=j+1;
            }
            if(dup==0){keep[i]=1;}
        }
        i=i+1;
    }
    // order kept lines by id
    let order:[]u8=nio_alloc(4+n0*4+8);u32put(order,0,0);
    let used:[]u8=nio_alloc(n0+1);
    let cnt:i32=0;let k:i32=0;
    while(k<n0){
        let best:i32=-1;let j:i32=0;
        while(j<n0){
            if(keep[j]==1 && used[j]==0){
                if(best<0){best=j;}
                else{
                    if(bytes_lt(line_id(line_slice(cb,la,j)),line_id(line_slice(cb,la,best)))==1){best=j;}
                }
            }
            j=j+1;
        }
        if(best<0){k=n0;}
        else{used[best]=1;u32put(order,4+cnt*4,best as i64);cnt=cnt+1;k=k+1;}
    }
    u32put(order,0,cnt as i64);
    // canonical buf + tab
    let est:i32=cnt*300+16;
    let nb:[]u8=nio_alloc(est);
    let tab:[]u8=nio_alloc(4+cnt*40+8);u32put(tab,0,cnt as i64);
    let at:i32=0;let x:i32=0;
    while(x<cnt){
        let li:i32=u32get(order,4+x*4) as i32;
        let ln:[]u8=line_slice(cb,la,li);
        let fa:[]u8=fields_of(ln,124,5);
        let base:i32=at;
        let f:i32=0;
        while(f<5){
            let fldv:[]u8=fld(fa,ln,f);
            u32put(tab,4+x*40+f*8,at as i64);
            u32put(tab,4+x*40+f*8+4,fldv.len as i64);
            let c:i32=0;while(c<fldv.len){nb[at]=fldv[c];at=at+1;c=c+1;}
            if(f<4){nb[at]=124;at=at+1;}
            f=f+1;
        }
        nb[at]=10;at=at+1;
        x=x+1;
    }
    let buf:[]u8=nb[0..at];
    if(store_commit(dir,"items.dat",buf)!=0){return 1;}
    // filing
    let fest:i32=cnt*64+16;
    let fb2:[]u8=nio_alloc(fest);
    let fat:i32=0;let y:i32=0;
    while(y<cnt){
        let id:[]u8=item_field(buf,tab,y,0);
        let dm:[]u8=item_field(buf,tab,y,1);
        let tf:[]u8=item_field(buf,tab,y,2);
        let sf:[]u8=item_field(buf,tab,y,3);
        let p:[]u8="*";
        if(kind==1){p=concat(concat(tf,"/"),dm);}
        let c:i32=0;while(c<id.len){fb2[fat]=id[c];fat=fat+1;c=c+1;}
        fb2[fat]=124;fat=fat+1;
        c=0;while(c<p.len){fb2[fat]=p[c];fat=fat+1;c=c+1;}
        fb2[fat]=10;fat=fat+1;
        y=y+1;
    }
    if(store_commit(dir,"filing.txt",fb2[0..fat])!=0){return 1;}
    let nn:i64=cnt as i64;
    ops_write(dir,0,nn+nn,0);
    _zag_print("ingested ");_zag_print(i64s(nn));_zag_println(" items");
    return 0;
}

// mean F1 = score/(1e9*nq) as "d.dddddddddddd" (12 decimals, truncated).
// 12 decimals resolve the integer quantum 1/(1e9*nq) for nq<=16, so the
// printed order/ties match the integer argmax exactly (KB-4 re-derivation).
fn fmt_mean(score:i64,nq:i64)[]u8{
    let den:i64=1000000000*nq;
    let ip:i64=0;let rem:i64=score;
    if(den>0){ip=score/den;rem=score-ip*den;}
    let o:[]u8=nio_alloc(24);
    let s:[]u8=i64s(ip);
    let n:i32=0;let c:i32=0;
    while(c<s.len){o[n]=s[c];n=n+1;c=c+1;}
    o[n]=46;n=n+1;
    let i:i32=0;
    while(i<12){
        rem=rem*10;
        let d:i64=0;
        if(den>0){d=rem/den;rem=rem-d*den;}
        o[n]=(((d as i32)+48) as u8);n=n+1;
        i=i+1;
    }
    return o[0..n];
}
// "chosen: S<n>" + six "S<n>: <mean>" lines for scope si (si==nd -> global)
fn scheme_scores(st:[]u8,sc:[]u8,scn:[]u8,si:i32)[]u8{
    let nq:i64=u32get(scn,si*4);
    let g:i32=0;
    while(g<6){
        st=concat(st,scheme_name(g));st=concat(st,": ");
        st=concat(st,fmt_mean(i64get(sc,(si*6+g)*8),nq));st=concat(st,"\n");
        g=g+1;
    }
    return st;
}
// one-line rationale body for scope si; nq=0 disclosed when no calib queries
fn scheme_rat(sc:[]u8,scn:[]u8,si:i32)[]u8{
    let w:i32=argmax_tb(sc,si);
    let wv:i64=i64get(sc,(si*6+w)*8);
    let nq:i64=u32get(scn,si*4);
    let r:[]u8=scheme_name(w);
    r=concat(r," wins argmax on calib mean F1 (n=");
    r=concat(r,i64s(nq));r=concat(r,"); ");
    let tied:[]u8="";
    let ntt:i32=0;let s4:i32=0;
    while(s4<6){
        if(i64get(sc,(si*6+s4)*8)==wv){
            if(ntt>0){tied=concat(tied,",");}
            tied=concat(tied,scheme_name(s4));ntt=ntt+1;
        }
        s4=s4+1;
    }
    if(ntt==1){r=concat(r,"unique argmax, no tie");}
    else{
        r=concat(r,"ties ");r=concat(r,tied);
        r=concat(r," at ");r=concat(r,fmt_mean(wv,nq));
        r=concat(r,"; frozen tie-break fewest-levels-then-lowest-index");
    }
    return r;
}
// ---------------- choose (SELF) ----------------
fn h_choose(dir:[]u8)i32 {
    let ip:[]u8=path_join(dir,"items.dat");
    if(f_exists(ip)==0){_zag_println("choose: no store");return 1;}
    let buf:[]u8=f_read(ip);
    let tab:[]u8=build_tab(buf);
    let n:i32=tab_n(tab);
    let hb:[]u8=build_hay(buf,tab);
    let cp:[]u8=path_join(dir,"calib.txt");
    if(f_exists(cp)==0){_zag_println("choose: calib.txt missing in storedir");return 1;}
    let qb:[]u8=f_read(cp);
    let qt:[]u8=parse_queries(qb);
    let nq:i32=u32get(qt,0) as i32;
    if(nq==0){_zag_println("choose: no calib queries");return 1;}
    if(nq==0){_zag_println("choose: no calib queries");return 1;}
    // B5: report choose+refile cost only — reset counters here, not cumulative ingest
    ops_write(dir,0,0,0);
    let doms:[]u8=nio_alloc(4+128*8+8);u32put(doms,0,0);
    // domain name arena: calib-query domains first, then store-only domains
    let dbuf:[]u8=nio_alloc((n+nq)*40+16);
    let dblen:i32=0;
    let q:i32=0;
    while(q<nq){
        let dh:[]u8=qfield(qb,qt,q,4);
        if(dh.len>0){
            let nd0:i32=u32get(doms,0) as i32;let seen:i32=0;let d2:i32=0;
            while(d2<nd0){
                let oo:i32=u32get(doms,4+d2*8) as i32;let ll:i32=u32get(doms,4+d2*8+4) as i32;
                if(bytes_eq(dbuf[oo..oo+ll],dh)==1){seen=1;}
                d2=d2+1;
            }
            if(seen==0){
                let c:i32=0;while(c<dh.len){dbuf[dblen+c]=dh[c];c=c+1;}
                u32put(doms,4+nd0*8,dblen as i64);u32put(doms,4+nd0*8+4,dh.len as i64);
                dblen=dblen+dh.len;
                u32put(doms,0,(nd0+1) as i64);
            }
        }
        q=q+1;
    }
    // store domains with no calib queries get an explicit (degenerate) record:
    // all schemes tie at 0 and the frozen tie-break selects S6; disclosed in rationale.
    let i2:i32=0;
    while(i2<n){
        let dm:[]u8=item_field(buf,tab,i2,1);
        if(dm.len>0){
            let nd0:i32=u32get(doms,0) as i32;let seen:i32=0;let d2:i32=0;
            while(d2<nd0){
                let oo:i32=u32get(doms,4+d2*8) as i32;let ll:i32=u32get(doms,4+d2*8+4) as i32;
                if(bytes_eq(dbuf[oo..oo+ll],dm)==1){seen=1;}
                d2=d2+1;
            }
            if(seen==0){
                let c:i32=0;while(c<dm.len){dbuf[dblen+c]=dm[c];c=c+1;}
                u32put(doms,4+nd0*8,dblen as i64);u32put(doms,4+nd0*8+4,dm.len as i64);
                dblen=dblen+dm.len;
                u32put(doms,0,(nd0+1) as i64);
            }
        }
        i2=i2+1;
    }
    let nd:i32=u32get(doms,0) as i32;
    let nsc:i32=nd+1;
    let sc:[]u8=nio_alloc(nsc*6*8+8);
    let si:i32=0;
    while(si<nsc){let s2:i32=0;while(s2<6){i64put(sc,(si*6+s2)*8,0);s2=s2+1;}si=si+1;}
    let scn:[]u8=nio_alloc(nsc*4+8);
    si=0;
    while(si<nsc){
        let c:i32=0;q=0;
        while(q<nq){
            if(si==nd){c=c+1;}
            else{
                let oo:i32=u32get(doms,4+si*8) as i32;let ll:i32=u32get(doms,4+si*8+4) as i32;
                if(bytes_eq(qfield(qb,qt,q,4),dbuf[oo..oo+ll])==1){c=c+1;}
            }
            q=q+1;
        }
        u32put(scn,si*4,c as i64);
        si=si+1;
    }
    si=0;
    while(si<nsc){
        let nsq:i64=u32get(scn,si*4);
        if(nsq>0){
            let s:i32=0;
            while(s<6){
                let total:i64=0;
                q=0;
                while(q<nq){
                    let in_scope:i32=0;
                    if(si==nd){in_scope=1;}
                    else{
                        let oo:i32=u32get(doms,4+si*8) as i32;let ll:i32=u32get(doms,4+si*8+4) as i32;
                        if(bytes_eq(qfield(qb,qt,q,4),dbuf[oo..oo+ll])==1){in_scope=1;}
                    }
                    if(in_scope==1){
                        let th:[]u8=qfield(qb,qt,q,3);let dh:[]u8=qfield(qb,qt,q,4);let sh:[]u8=qfield(qb,qt,q,5);
                        let tx:[]u8=qfield(qb,qt,q,6);
                        let qlow:[]u8=lower(tx);
                        let qtt:[]u8=tokenize(qlow);
                        let rk:[]u8=topk(buf,tab,hb,s,th,dh,sh,qlow,qtt,20);
                        let r:i32=u32get(rk,0) as i32;
                        let ga:[]u8=gold_ids(qb,qt,q);
                        let g:i32=u32get(ga,0) as i32;
                        let a:i32=0;let ri:i32=0;
                        while(ri<r){
                            let ro:i32=u32get(rk,4+ri*8) as i32;let rl:i32=u32get(rk,4+ri*8+4) as i32;
                            let rid:[]u8=buf[ro..ro+rl];
                            let gi:i32=0;let found:i32=0;
                            while(gi<g){
                                let go:i32=u32get(ga,4+gi*8) as i32;let gl:i32=u32get(ga,4+gi*8+4) as i32;
                                if(bytes_eq(rid,qb[go..go+gl])==1){found=1;}
                                gi=gi+1;
                            }
                            if(found==1){a=a+1;}
                            ri=ri+1;
                        }
                        let den:i64=(r+g) as i64;
                        if(den>0){
                            let num:i64=2000000000*(a as i64);
                            total=total+(num+den/2)/den;
                        }
                    }
                    q=q+1;
                }
                i64put(sc,(si*6+s)*8,total);
                s=s+1;
            }
        }
        si=si+1;
    }
    let ch:[]u8=nio_alloc(nsc+1);
    si=0;while(si<nsc){ch[si]=argmax_tb(sc,si) as u8;si=si+1;}
    // ---- scheme.txt (crew-1 SCHEME_FORMAT.md contract) ----
    let st:[]u8="# MORG-SELF scheme record v1\n";
    // global block first (scorer records it as _global; KB-4 uses domain blocks)
    st=concat(st,"chosen: ");st=concat(st,scheme_name(ch[nd] as i32));st=concat(st,"\n");
    st=scheme_scores(st,sc,scn,nd);
    st=concat(st,"rationale: global: ");st=concat(st,scheme_rat(sc,scn,nd));st=concat(st,"\n");
    si=0;
    while(si<nd){
        let oo:i32=u32get(doms,4+si*8) as i32;let ll:i32=u32get(doms,4+si*8+4) as i32;
        let dn:[]u8=dbuf[oo..oo+ll];
        st=concat(st,"domain: ");st=concat(st,dn);st=concat(st,"\n");
        st=concat(st,"chosen: ");st=concat(st,scheme_name(ch[si] as i32));st=concat(st,"\n");
        st=scheme_scores(st,sc,scn,si);
        st=concat(st,"rationale: ");st=concat(st,dn);st=concat(st,": ");
        st=concat(st,scheme_rat(sc,scn,si));st=concat(st,"\n");
        si=si+1;
    }
    if(store_commit(dir,"scheme.txt",st)!=0){return 1;}
    // ---- re-file ----
    let fp:[]u8=path_join(dir,"filing.txt");
    let fb:[]u8=f_read(fp);
    let ft:[]u8=build_ftab(fb);
    let nbf:[]u8=nio_alloc(n*80+16);
    let fat:i32=0;let moves:i32=0;let i:i32=0;
    while(i<n){
        let id:[]u8=item_field(buf,tab,i,0);
        let dm:[]u8=item_field(buf,tab,i,1);
        let tf:[]u8=item_field(buf,tab,i,2);
        let sf:[]u8=item_field(buf,tab,i,3);
        let scm:i32=ch[nd] as i32;
        let d2:i32=0;
        while(d2<nd){
            let oo:i32=u32get(doms,4+d2*8) as i32;let ll:i32=u32get(doms,4+d2*8+4) as i32;
            if(bytes_eq(dm,dbuf[oo..oo+ll])==1){scm=ch[d2] as i32;}
            d2=d2+1;
        }
        let np:[]u8=scheme_path(scm,tf,dm,sf);
        let op:[]u8=filing_path(fb,ft,id);
        if(bytes_eq(np,op)==0){moves=moves+1;}
        let c:i32=0;while(c<id.len){nbf[fat]=id[c];fat=fat+1;c=c+1;}
        nbf[fat]=124;fat=fat+1;
        c=0;while(c<np.len){nbf[fat]=np[c];fat=fat+1;c=c+1;}
        nbf[fat]=10;fat=fat+1;
        i=i+1;
    }
    if(store_commit(dir,"filing.txt",nbf[0..fat])!=0){return 1;}
    let nn:i64=n as i64;
    let or_:i64=ops_read(dir,0);let ow:i64=ops_read(dir,1);let om:i64=ops_read(dir,2);
    ops_write(dir,or_+nn+nn,ow+nn,om+(moves as i64));
    _zag_print("choose done items=");_zag_print(i64s(nn));
    _zag_print(" moves=");_zag_println(i64s(moves as i64));
    return 0;
}

// ---------------- retrieve ----------------
fn h_retrieve(dir:[]u8,qpath:[]u8,outpath:[]u8,kind:i32)i32 {
    let ip:[]u8=path_join(dir,"items.dat");
    if(f_exists(ip)==0){_zag_println("retrieve: no store");return 1;}
    let buf:[]u8=f_read(ip);
    let tab:[]u8=build_tab(buf);
    let hb:[]u8=build_hay(buf,tab);
    let gc:i32=11;
    let dnames:[]u8=nio_alloc(4+128*8+8);u32put(dnames,0,0);
    let dch:[]u8=nio_alloc(129);
    let sb:[]u8="";
    if(kind==1){gc=10;}
    if(kind==0){
        let sp:[]u8=path_join(dir,"scheme.txt");
        if(f_exists(sp)==0){_zag_println("retrieve: no scheme.txt (run choose first)");return 1;}
        sb=f_read(sp);
        let la:[]u8=lines_of(sb);
        let nl2:i32=line_n(la);let li:i32=0;
        // contract format: "domain: <name>" headers, then "chosen: S<n>".
        // a "chosen:" before any domain header sets the global scheme.
        let curdom:i32=-1;
        while(li<nl2){
            let ln:[]u8=line_slice(sb,la,li);
            let fa:[]u8=fields_of(ln,58,3);
            if(fld_n(fa)>=2 && bytes_eq(fld(fa,ln,0),"domain")==1){
                let nm:[]u8=fld(fa,ln,1);
                let noff:i32=u32get(fa,4+1*8) as i32;
                let base:i32=u32get(la,4+li*8) as i32;
                let oo:i32=base+noff;let ll:i32=nm.len;
                if(ll>0 && sb[oo]==32){oo=oo+1;ll=ll-1;}
                let cnd:i32=u32get(dnames,0) as i32;
                u32put(dnames,4+cnd*8,oo as i64);
                u32put(dnames,4+cnd*8+4,ll as i64);
                u32put(dnames,0,(cnd+1) as i64);
                curdom=cnd;
            }
            if(fld_n(fa)>=2 && bytes_eq(fld(fa,ln,0),"chosen")==1){
                let cv:[]u8=fld(fa,ln,1);
                if(cv.len>0 && cv[0]==32){cv=cv[1..cv.len];}
                let si2:i32=scheme_idx_of(cv);
                if(curdom>=0){dch[curdom]=si2 as u8;}
                else{gc=si2;}
            }
            li=li+1;
        }
    }
    let qb:[]u8=f_read(qpath);
    if(qb.len==0 && f_exists(qpath)==0){_zag_println("retrieve: queries missing");return 1;}
    let qt:[]u8=parse_queries(qb);
    let nq:i32=u32get(qt,0) as i32;
    let out:[]u8=nio_alloc(nq*220+16);
    let at:i32=0;let q:i32=0;
    while(q<nq){
        let qid:[]u8=qfield(qb,qt,q,0);
        let th:[]u8=qfield(qb,qt,q,3);let dh:[]u8=qfield(qb,qt,q,4);let sh:[]u8=qfield(qb,qt,q,5);
        let tx:[]u8=qfield(qb,qt,q,6);
        let s:i32=gc;
        if(kind==0 && dh.len>0){
            let cnd:i32=u32get(dnames,0) as i32;let d2:i32=0;
            while(d2<cnd){
                let oo:i32=u32get(dnames,4+d2*8) as i32;let ll:i32=u32get(dnames,4+d2*8+4) as i32;
                if(bytes_eq(dh,sb[oo..oo+ll])==1){s=dch[d2] as i32;}
                d2=d2+1;
            }
        }
        let qlow:[]u8=lower(tx);
        let qtt:[]u8=tokenize(qlow);
        let rk:[]u8=topk(buf,tab,hb,s,th,dh,sh,qlow,qtt,20);
        let r:i32=u32get(rk,0) as i32;
        let c:i32=0;while(c<qid.len){out[at]=qid[c];at=at+1;c=c+1;}
        out[at]=124;at=at+1;
        let ri:i32=0;
        while(ri<r){
            let ro:i32=u32get(rk,4+ri*8) as i32;let rl:i32=u32get(rk,4+ri*8+4) as i32;
            let c2:i32=0;
            while(c2<rl){out[at]=buf[ro+c2];at=at+1;c2=c2+1;}
            if(ri<r-1){out[at]=44;at=at+1;}
            ri=ri+1;
        }
        out[at]=10;at=at+1;
        q=q+1;
    }
    if(f_write(outpath,out[0..at])<0){_zag_println("retrieve: out write failed");return 1;}
    _zag_print("retrieved ");_zag_print(i64s(nq as i64));_zag_println(" queries");
    return 0;
}
// ---------------- revise ----------------
fn h_revise(dir:[]u8,id:[]u8,newtext:[]u8)i32 {
    let ip:[]u8=path_join(dir,"items.dat");
    if(f_exists(ip)==0){_zag_println("revise: no store");return 1;}
    let buf:[]u8=f_read(ip);
    let tab:[]u8=build_tab(buf);
    let n:i32=tab_n(tab);
    let idx:i32=item_find(buf,tab,id);
    if(idx<0){_zag_print("revise: id not found: ");_zag_println(id);return 1;}
    let est:i32=n*300+newtext.len+16;
    let nb:[]u8=nio_alloc(est);
    let at:i32=0;let i:i32=0;
    while(i<n){
        let f:i32=0;
        while(f<5){
            let fv:[]u8=item_field(buf,tab,i,f);
            if(i==idx && f==4){fv=newtext;}
            let c:i32=0;while(c<fv.len){nb[at]=fv[c];at=at+1;c=c+1;}
            if(f<4){nb[at]=124;at=at+1;}
            f=f+1;
        }
        nb[at]=10;at=at+1;
        i=i+1;
    }
    if(store_commit(dir,"items.dat",nb[0..at])!=0){return 1;}
    let or_:i64=ops_read(dir,0);let ow:i64=ops_read(dir,1);let om:i64=ops_read(dir,2);
    ops_write(dir,or_+(n as i64),ow+1,om);
    _zag_print("revised ");_zag_println(id);
    return 0;
}
// ---------------- verify ----------------
fn h_verify(dir:[]u8)i32 {
    let ip:[]u8=path_join(dir,"items.dat");
    if(f_exists(ip)==0){_zag_println("verify: no store");return 1;}
    let buf:[]u8=f_read(ip);
    let tab:[]u8=build_tab(buf);
    let n:i32=tab_n(tab);
    let out:[]u8=nio_alloc(32);
    if(ns_sha256(buf,out)!=0){_zag_println("verify: sha failed");return 1;}
    let h:[]u8=ns_hex(out);
    _zag_print("hash=");_zag_println(h);
    _zag_print("count=");_zag_println(i64s(n as i64));
    return 0;
}
// ---------------- deletecat ----------------
fn h_deletecat(dir:[]u8,typ:[]u8)i32 {
    let ip:[]u8=path_join(dir,"items.dat");
    if(f_exists(ip)==0){_zag_println("deletecat: no store");return 1;}
    let buf:[]u8=f_read(ip);
    let tab:[]u8=build_tab(buf);
    let n:i32=tab_n(tab);
    let est:i32=n*300+16;
    let nb:[]u8=nio_alloc(est);
    let fb2:[]u8=nio_alloc(n*80+16);
    let at:i32=0;let fat:i32=0;let kept:i32=0;let i:i32=0;
    while(i<n){
        let tf:[]u8=item_field(buf,tab,i,2);
        if(bytes_eq(tf,typ)==0){
            let f:i32=0;
            while(f<5){
                let fv:[]u8=item_field(buf,tab,i,f);
                let c:i32=0;while(c<fv.len){nb[at]=fv[c];at=at+1;c=c+1;}
                if(f<4){nb[at]=124;at=at+1;}
                f=f+1;
            }
            nb[at]=10;at=at+1;
            kept=kept+1;
        }
        i=i+1;
    }
    if(store_commit(dir,"items.dat",nb[0..at])!=0){return 1;}
    // rebuild filing for kept items (paths unchanged)
    let fp:[]u8=path_join(dir,"filing.txt");
    let fb:[]u8=f_read(fp);
    let ft:[]u8=build_ftab(fb);
    i=0;
    while(i<n){
        let tf:[]u8=item_field(buf,tab,i,2);
        if(bytes_eq(tf,typ)==0){
            let id:[]u8=item_field(buf,tab,i,0);
            let p:[]u8=filing_path(fb,ft,id);
            let c:i32=0;while(c<id.len){fb2[fat]=id[c];fat=fat+1;c=c+1;}
            fb2[fat]=124;fat=fat+1;
            c=0;while(c<p.len){fb2[fat]=p[c];fat=fat+1;c=c+1;}
            fb2[fat]=10;fat=fat+1;
        }
        i=i+1;
    }
    if(store_commit(dir,"filing.txt",fb2[0..fat])!=0){return 1;}
    let or_:i64=ops_read(dir,0);let ow:i64=ops_read(dir,1);let om:i64=ops_read(dir,2);
    ops_write(dir,or_+(n as i64),ow+(kept as i64)+(kept as i64),om);
    _zag_print("deleted ");_zag_print(i64s((n-kept) as i64));_zag_println(" items");
    return 0;
}
// ---------------- exportcat ----------------
fn h_exportcat(dir:[]u8,typ:[]u8,file:[]u8)i32 {
    let ip:[]u8=path_join(dir,"items.dat");
    if(f_exists(ip)==0){_zag_println("exportcat: no store");return 1;}
    let buf:[]u8=f_read(ip);
    let tab:[]u8=build_tab(buf);
    let n:i32=tab_n(tab);
    let est:i32=n*300+16;
    let nb:[]u8=nio_alloc(est);
    let at:i32=0;let k:i32=0;let i:i32=0;
    while(i<n){
        let tf:[]u8=item_field(buf,tab,i,2);
        if(bytes_eq(tf,typ)==1){
            let f:i32=0;
            while(f<5){
                let fv:[]u8=item_field(buf,tab,i,f);
                let c:i32=0;while(c<fv.len){nb[at]=fv[c];at=at+1;c=c+1;}
                if(f<4){nb[at]=124;at=at+1;}
                f=f+1;
            }
            nb[at]=10;at=at+1;
            k=k+1;
        }
        i=i+1;
    }
    if(f_write(file,nb[0..at])<0){_zag_println("exportcat: write failed");return 1;}
    _zag_print("exported ");_zag_print(i64s(k as i64));_zag_println(" items");
    return 0;
}
// ---------------- importcat ----------------
fn h_importcat(file:[]u8,dir:[]u8,kind:i32)i32 {
    let ip:[]u8=path_join(dir,"items.dat");
    if(f_exists(ip)==0){_zag_println("importcat: no store");return 1;}
    let buf:[]u8=f_read(ip);
    let tab:[]u8=build_tab(buf);
    let n:i32=tab_n(tab);
    let cb:[]u8=f_read(file);
    if(cb.len==0 && f_exists(file)==0){_zag_println("importcat: file missing");return 1;}
    let la:[]u8=lines_of(cb);
    let n0:i32=line_n(la);
    // new raw lines (dedup vs existing and within file)
    let est:i32=n0*300+16;
    let add:[]u8=nio_alloc(est);
    let aat:i32=0;let added:i32=0;let skipped:i32=0;
    let seen:[]u8=nio_alloc(n0*40+8);
    u32put(seen,0,0);
    let i:i32=0;
    while(i<n0){
        let ln:[]u8=line_slice(cb,la,i);
        let fa:[]u8=fields_of(ln,124,5);
        if(ln.len>0 && fld_n(fa)==5 && fld(fa,ln,0).len>0){
            let id:[]u8=fld(fa,ln,0);
            let dup:i32=0;
            if(item_find(buf,tab,id)>=0){dup=1;}
            else{
                let ns2:i32=u32get(seen,0) as i32;let j:i32=0;
                while(j<ns2){
                    let oo:i32=u32get(seen,4+j*40) as i32;let ll:i32=u32get(seen,4+j*40+4) as i32;
                    if(bytes_eq(add[oo..oo+ll],id)==1){dup=1;}
                    j=j+1;
                }
            }
            if(dup==1){skipped=skipped+1;}
            else{
                let ns2:i32=u32get(seen,0) as i32;
                u32put(seen,4+ns2*40,aat as i64);u32put(seen,4+ns2*40+4,id.len as i64);
                u32put(seen,0,(ns2+1) as i64);
                let c:i32=0;while(c<ln.len){add[aat]=ln[c];aat=aat+1;c=c+1;}
                add[aat]=10;aat=aat+1;
                added=added+1;
            }
        }
        i=i+1;
    }
    // merge + resort canonical
    let raw:[]u8=concat(buf,add[0..aat]);
    let la2:[]u8=lines_of(raw);
    let order:[]u8=sort_lines_by_id(raw,la2);
    let nn:i32=line_n(order);
    let nb:[]u8=nio_alloc(nn*300+16);
    let at:i32=0;let x:i32=0;
    while(x<nn){
        let li:i32=u32get(order,4+x*4) as i32;
        let ln:[]u8=line_slice(raw,la2,li);
        let fa:[]u8=fields_of(ln,124,5);
        if(fld_n(fa)==5 && ln.len>0){
            let c:i32=0;while(c<ln.len){nb[at]=ln[c];at=at+1;c=c+1;}
            nb[at]=10;at=at+1;
        }
        x=x+1;
    }
    let nbuf:[]u8=nb[0..at];
    if(store_commit(dir,"items.dat",nbuf)!=0){return 1;}
    let ntab:[]u8=build_tab(nbuf);
    let nn2:i32=tab_n(ntab);
    // filing: keep old paths, file new ids per kind
    let fp:[]u8=path_join(dir,"filing.txt");
    let fb:[]u8=f_read(fp);
    let ft:[]u8=build_ftab(fb);
    // SELF scheme info if present
    let gc2:i32=-1;
    let dnames:[]u8=nio_alloc(4+128*8+8);u32put(dnames,0,0);
    let dch:[]u8=nio_alloc(129);
    let has_scheme:i32=0;
    let sb:[]u8="";
    if(kind==0){
        let sp:[]u8=path_join(dir,"scheme.txt");
        if(f_exists(sp)==1){
            has_scheme=1;
            sb=f_read(sp);
            let la3:[]u8=lines_of(sb);
            let nl3:i32=line_n(la3);let li2:i32=0;
            // contract format: "domain: <name>" headers, then "chosen: S<n>"
            let curdom3:i32=-1;
            while(li2<nl3){
                let ln2:[]u8=line_slice(sb,la3,li2);
                let fa2:[]u8=fields_of(ln2,58,3);
                if(fld_n(fa2)>=2 && bytes_eq(fld(fa2,ln2,0),"domain")==1){
                    let noff:i32=u32get(fa2,4+1*8) as i32;
                    let base:i32=u32get(la3,4+li2*8) as i32;
                    let nm:[]u8=fld(fa2,ln2,1);
                    let oo:i32=base+noff;let ll:i32=nm.len;
                    if(ll>0 && sb[oo]==32){oo=oo+1;ll=ll-1;}
                    let cnd:i32=u32get(dnames,0) as i32;
                    u32put(dnames,4+cnd*8,oo as i64);
                    u32put(dnames,4+cnd*8+4,ll as i64);
                    u32put(dnames,0,(cnd+1) as i64);
                    curdom3=cnd;
                }
                if(fld_n(fa2)>=2 && bytes_eq(fld(fa2,ln2,0),"chosen")==1){
                    let cv3:[]u8=fld(fa2,ln2,1);
                    if(cv3.len>0 && cv3[0]==32){cv3=cv3[1..cv3.len];}
                    let si3:i32=scheme_idx_of(cv3);
                    if(curdom3>=0){dch[curdom3]=si3 as u8;}
                    else{gc2=si3;}
                }
                li2=li2+1;
            }
        }
    }
    let fb2:[]u8=nio_alloc(nn2*80+16);
    let fat:i32=0;let y:i32=0;
    while(y<nn2){
        let id:[]u8=item_field(nbuf,ntab,y,0);
        let dm:[]u8=item_field(nbuf,ntab,y,1);
        let tf:[]u8=item_field(nbuf,ntab,y,2);
        let sf:[]u8=item_field(nbuf,ntab,y,3);
        let p:[]u8=filing_path(fb,ft,id);
        if(p.len==0){
            p="*";
            if(kind==1){p=concat(concat(tf,"/"),dm);}
            if(kind==0 && has_scheme==1){
                let s2:i32=gc2;
                let cnd:i32=u32get(dnames,0) as i32;let d2:i32=0;
                while(d2<cnd){
                    let oo:i32=u32get(dnames,4+d2*8) as i32;let ll:i32=u32get(dnames,4+d2*8+4) as i32;
                    if(bytes_eq(dm,sb[oo..oo+ll])==1){s2=dch[d2] as i32;}
                    d2=d2+1;
                }
                // dnames offsets are into sb (scheme buffer)
                p=scheme_path(s2,tf,dm,sf);
            }
        }
        let c:i32=0;while(c<id.len){fb2[fat]=id[c];fat=fat+1;c=c+1;}
        fb2[fat]=124;fat=fat+1;
        c=0;while(c<p.len){fb2[fat]=p[c];fat=fat+1;c=c+1;}
        fb2[fat]=10;fat=fat+1;
        y=y+1;
    }
    if(store_commit(dir,"filing.txt",fb2[0..fat])!=0){return 1;}
    let or_:i64=ops_read(dir,0);let ow:i64=ops_read(dir,1);let om:i64=ops_read(dir,2);
    let nn64:i64=nn2 as i64;
    ops_write(dir,or_+(n as i64)+(n0 as i64),ow+nn64+nn64,om);
    _zag_print("imported ");_zag_print(i64s(added as i64));
    _zag_print(" skipped=");_zag_println(i64s(skipped as i64));
    return 0;
}
// ---------------- opscount ----------------
fn h_opscount(dir:[]u8)i32 {
    _zag_print("reads=");_zag_println(i64s(ops_read(dir,0)));
    _zag_print("writes=");_zag_println(i64s(ops_read(dir,1)));
    _zag_print("moves=");_zag_println(i64s(ops_read(dir,2)));
    return 0;
}

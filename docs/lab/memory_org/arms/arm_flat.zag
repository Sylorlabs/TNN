// MORG arm FLAT — append-only, content-match scoring. kind=2.
@import("lib.zag")
fn main()i32 {
    let cmd:[]u8=_zag_arg(1);
    if(_zag_strcmp(cmd,"ingest")==1){return h_ingest(_zag_arg(2),_zag_arg(3),2);}
    if(_zag_strcmp(cmd,"retrieve")==1){return h_retrieve(_zag_arg(2),_zag_arg(3),_zag_arg(4),2);}
    if(_zag_strcmp(cmd,"revise")==1){return h_revise(_zag_arg(2),_zag_arg(3),_zag_arg(4));}
    if(_zag_strcmp(cmd,"verify")==1){return h_verify(_zag_arg(2));}
    if(_zag_strcmp(cmd,"deletecat")==1){return h_deletecat(_zag_arg(2),_zag_arg(3));}
    if(_zag_strcmp(cmd,"exportcat")==1){return h_exportcat(_zag_arg(2),_zag_arg(3),_zag_arg(4));}
    if(_zag_strcmp(cmd,"importcat")==1){return h_importcat(_zag_arg(2),_zag_arg(3),2);}
    if(_zag_strcmp(cmd,"opscount")==1){return h_opscount(_zag_arg(2));}
    _zag_print("unknown cmd: ");_zag_println(cmd);
    return 1;
}

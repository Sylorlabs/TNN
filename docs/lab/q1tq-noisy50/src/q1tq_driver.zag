// q1tq_driver.zag — CREW TQ-NOISY50 (teacher QUALITY series, 50% noise leg).
//
// CONTROL (already run, separately): the Q1B learned-teacher leg rebuilt on
// the current tree reproduced 12/12 on all 8 slices with byte-identical
// stdout to the Q1B canonical evidence
// (407974c35c68b5e2a234d3d17bfdf1847201ba3f47811af6fa8e07222190d151 × 5)
// — no tree drift. This binary runs only the noisy variation.
//
// NOISY LEG: the Q1B learned teacher (genuinely learned: 0 plants,
// 228 deliberate adds, 1 disconnect — audited pre-noise), then
// harness-side deterministic noise injection (q1tq_inject_noise:
// id mod 2 == 0 -> plausible false value, t5_plant_claim construction).
// The noisy teacher teaches a fresh arm-B-style learner on the Q1
// teacher-leg pattern (teacher proposes, learner judges), with the
// teacher's HELD CLAIMS as the teaching-stimulus content
// (q1tq_build_stimulus_teacher). Same §B.7 flaw battery (8 slices, sealed
// scorer, bar >=10/12 per slice). The learner construction (fresh store,
// fresh-audited, 8-example world-true scaffold verified by its own
// observation, learner-initiated SIGNAL_DISCONNECT, q1_learn_one §L
// deliberation) is UNCHANGED from Q1/Q1B.
//
// This driver is a MEASUREMENT instrument, not a pass/fail test: mastery
// vs world truth is expected to degrade (the learner absorbs the teacher's
// false claims through clean proposals and wrong-span revises — both carry
// the teacher's claim as the value). Structural invariants (emissions,
// manifest, tripwire, leak, store size) stay hard-gated; flaw hits and
// true-mastery are printed as data. The filter/absorb accounting at the end
// answers the leg's question directly.
//
// Pure Zag, zero RNG. Deterministic: stdout must be byte-identical across
// reruns (N=5 verified by the run script).
@import("q1_types.zag")
@import("q1_proposal.zag")
@import("q1_tape.zag")
@import("q1_tripwire.zag")
@import("q1_flawscore.zag")
@import("t5_core.zag")
@import("q1_world.zag")
@import("q1_learner.zag")
@import("q1b_teacher.zag")
@import("q1tq_noisy.zag")

// explicit byte-built sealed path + canary — the SAME sealed instrument as
// Q1/Q1B ("q1/sealed/manifest", canary "Q1C:9f2c"): the flaw battery and
// its scorer are frozen; only the teacher's knowledge changed.
fn q1tq_sealedpath()[]u8 {
    let b:[]u8=nio_alloc(18);
    b[0]=113 as u8; b[1]=49 as u8; b[2]=47 as u8; b[3]=115 as u8;
    b[4]=101 as u8; b[5]=97 as u8; b[6]=108 as u8; b[7]=101 as u8;
    b[8]=100 as u8; b[9]=47 as u8; b[10]=109 as u8; b[11]=97 as u8;
    b[12]=110 as u8; b[13]=105 as u8; b[14]=102 as u8; b[15]=101 as u8;
    b[16]=115 as u8; b[17]=116 as u8;
    return b;
}
fn q1tq_canary()[]u8 {
    let b:[]u8=nio_alloc(8);
    b[0]=81 as u8; b[1]=49 as u8; b[2]=67 as u8; b[3]=58 as u8;
    b[4]=57 as u8; b[5]=102 as u8; b[6]=50 as u8; b[7]=99 as u8;
    return b;
}
// "noisy50"
fn q1tq_legname()[]u8 {
    let b:[]u8=nio_alloc(7);
    b[0]=110 as u8; b[1]=111 as u8; b[2]=105 as u8; b[3]=115 as u8;
    b[4]=121 as u8; b[5]=53 as u8; b[6]=48 as u8;
    return b;
}

// fresh-store audit: n==0 and no fact id 0..239 is present.
fn q1tq_audit_empty(s:*T5Store)i32 {
    if(s.*.n!=0){return 0;}
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){return 0;}
        id=id+1;
    }
    return 1;
}

// recall check vs WORLD TRUTH (the honest mastery measure under noise).
fn q1tq_recall_ok(s:*T5Store,fid:i32)i32 {
    if(t5_slot_find(s,fid)<0){return 0;}
    if(t5_claim_of(s,fid)==t5_truth(fid)){return 1;}
    return 0;
}

// hex print of a digest
fn q1tq_hex(b:[]u8)void {
    let i:i32=0;
    while(i<b.len){
        let v:i64=(b[i] as i64)&255;
        let hi:i64=(v>>4)&15;
        let lo:i64=v&15;
        let hc:u8=(48+hi) as u8;
        if(hi>9){hc=(87+hi) as u8;}
        let lc:u8=(48+lo) as u8;
        if(lo>9){lc=(87+lo) as u8;}
        let tmp:[]u8=nio_alloc(2);
        tmp[0]=hc; tmp[1]=lc;
        _zag_print(tmp);
        nio_free(tmp);
        i=i+1;
    }
    return;
}

// canonical state digest: sha256 over (fid,claim) pairs in ascending fid
// order (slot-layout independent).
fn q1tq_state_digest(s:*T5Store)[]u8 {
    let n:i32=s.*.n;
    let img:[]u8=nio_alloc(n*8+8);
    let w:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            tb_put32(img,w*8,id as i64);
            tb_put32(img,w*8+4,t5_claim_of(s,id) as i64);
            w=w+1;
        }
        id=id+1;
    }
    let d:[]u8=nio_alloc(32);
    let h:[]u8=img[0..w*8];
    ns_sha256(h,d);
    nio_free(img);
    return d;
}

// One noisy teacher-leg: fresh learner + 8 teaching slices from the noisy
// teacher. Q1TQ DELTA vs q1b_leg: the teaching stimulus is built from the
// teacher's held claims (q1tq_build_stimulus_teacher); everything else —
// learner construction, scaffold (world-true), flaw-first schedule,
// emissions, sealed scoring, tripwire — is unchanged. Mastery is measured
// vs world truth (expected to degrade: the measurement, not a gate).
// Returns check failures (structural invariants only).
fn q1tq_leg(teacher:*T5Store)i32 {
    let fails:i32=0;
    let lname:[]u8=q1tq_legname();

    // ================= LEARNER: fresh, empty at t0 =================
    let store:T5Store=t5_init(512,32768);
    fails=fails+cl_check("q1tq_learner_t0_empty_n",store.n,0);
    fails=fails+cl_check("q1tq_learner_t0_audit_empty",q1tq_audit_empty(&store),1);
    let spans:Q1SpanMap=q1_spanmap_init(256);

    // ================= machinery self-tests (prove the gates are live) =================
    let ev0:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev0,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev0,7,999,T5_EV_DIRECTIVE,2,-1);
    fails=fails+cl_check("q1tq_verify_kills_disagreement",t5_verify(&store,&ev0,2),0);
    q1_ev_free(&ev0);
    let ev1:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev1,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev1,7,100,Q1_EV_TEACHER,2,-1);
    fails=fails+cl_check("q1tq_verify_accepts_agreement",t5_verify(&store,&ev1,2),1);
    q1_ev_free(&ev1);
    let wstim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let wocc:[]u8=nio_alloc(Q1_NSLOTS);
    let woff:[]u8=nio_alloc(8);
    let wpl:i32=q1_build_stimulus(9,192,1,wstim,wocc,woff);
    fails=fails+cl_check("q1tq_world_placed",wpl,3);
    let wf0:i32=q1_scaffold_fact(0);
    let wo0:i32=tb_i64_get(woff,0) as i32;
    fails=fails+cl_check("q1tq_world_decode_fid",tb_get32(wstim,wo0) as i32,wf0);
    fails=fails+cl_check("q1tq_world_decode_val",tb_get32(wstim,wo0+4) as i32,t5_truth(wf0));
    fails=fails+cl_check("q1tq_shift_breaks_alignment",((wo0+1)%16==0) as i32,0);
    nio_free(wstim); nio_free(wocc); nio_free(woff);

    // ================= SCAFFOLD-AND-RELEASE (world-true, trainer-presented) =================
    let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ:[]u8=nio_alloc(Q1_NSLOTS);
    let offtab:[]u8=nio_alloc(8*3*8);
    let placed:i32=q1_build_stimulus(9,192,8,stim,occ,offtab);
    fails=fails+cl_check("q1tq_scaffold_placed",placed,24);
    let ex_fid:[]u8=nio_alloc(32);
    let ex_off:[]u8=nio_alloc(32);
    let ek:i32=0;
    while(ek<8){
        t5_s(ex_fid,ek*4,q1_scaffold_fact(ek));
        t5_s(ex_off,ek*4,tb_i64_get(offtab,(ek*3+0)*8) as i32);
        ek=ek+1;
    }
    let tape:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&tape,512,16384,2048);
    let added:i32=q1_scaffold(&store,&spans,&tape,stim,ex_fid,ex_off,8);
    fails=fails+cl_check("q1tq_scaffold_added",added,8);
    fails=fails+cl_check("q1tq_disconnect_audited",
        t5_audit_op_n(&store,T5_OP_DISCONNECT),1);
    let ret:i32=0;
    ek=0;
    while(ek<8){
        if(q1tq_recall_ok(&store,q1_scaffold_fact(ek))==1){ret=ret+1;}
        ek=ek+1;
    }
    fails=fails+cl_check("q1tq_post_disconnect_retention",ret,8);
    nio_free(stim); nio_free(occ); nio_free(offtab);
    nio_free(ex_fid); nio_free(ex_off);

    // ================= 8 TEACHING SLICES (teacher-claim stimulus) =================
    let total_hits:i32=0;
    let total_pass:i32=0;
    let total_clean_adopted:i32=0;
    let total_true_mastery:i32=0;
    let s:i32=0;
    while(s<8){
        let stim2:[]u8=nio_alloc(Q1_TAPE_LEN);
        let occ2:[]u8=nio_alloc(Q1_NSLOTS);
        let ot2:[]u8=nio_alloc(24*3*8);
        // Q1TQ DELTA: stimulus records carry the TEACHER'S claims.
        let pl2:i32=q1tq_build_stimulus_teacher(s,s*24,24,stim2,occ2,ot2,teacher);
        fails=fails+cl_check("q1tq_slice_stim_placed",pl2,72);
        let t2:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        tb_tape_init(&t2,1024,65536,2048);
        let sess:TbSess=TbSess{.sess_id=(1000+s) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last7=0,.evil=0,.n_props=0};
        let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpv=nio_alloc(0),.mexpr=nio_alloc(0),.mi=0};
        q1_mctx_init(&mctx);
        let seq:i64=1;
        let adopts:i32=0;
        let emit_bad:i32=0;
        let k:i32=0;
        while(k<24){
            if(k<12){
                // FLAW-FIRST: the flaw battery is zero-shot within the slice
                let er:i32=q1_emit_flaw(&t2,TB_TID_LEARNED,s,(1000+s) as i64,seq,k,
                                        q1_slice_fact(s,k),ot2,k,occ2,&mctx);
                if(er<0){emit_bad=emit_bad+1;}
                q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
                seq=seq+1;
            }
            let ec:i32=q1_emit_clean(&t2,TB_TID_LEARNED,(1000+s) as i64,seq,ot2,k);
            if(ec<0){emit_bad=emit_bad+1;}
            let vc:i32=q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
            if(vc==TB_V_ADOPT){adopts=adopts+1;}
            seq=seq+1;
            k=k+1;
        }
        fails=fails+cl_check("q1tq_slice_emit_ok",emit_bad,0);
        fails=fails+cl_check("q1tq_slice_manifest_n",mctx.mi,12);
        // §C tripwire: must not fire on the teaching tape
        let tw:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t2,Q1_TAPE_LEN as i64,&tw);
        fails=fails+cl_check("q1tq_slice_tripwire_fired",tw.fired,0);
        // SEALED flaw scoring (manifest instantiated after the session)
        let sp:[]u8=q1tq_sealedpath();
        let cn:[]u8=q1tq_canary();
        let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
        fails=fails+cl_check("q1tq_slice_manifest_init",tb_manifest_init(&m,12,sp,cn),0);
        let mi2:i32=0;
        while(mi2<12){
            tb_manifest_set(&m,mi2,
                tb_i64_get(mctx.mseq,mi2*8),
                tb_i64_get(mctx.mft,mi2*8),
                tb_i64_get(mctx.mexpv,mi2*8),
                tb_i64_get(mctx.mexpr,mi2*8));
            mi2=mi2+1;
        }
        let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
        tb_flaw_score(&t2,&m,TB_FP_W_DEFAULT_X10,&fo);
        fails=fails+cl_check("q1tq_slice_leak",fo.leak,0);
        fails=fails+cl_check("q1tq_slice_hnm12",fo.hits+fo.nears+fo.misses,12);
        // mastery vs WORLD TRUTH (measurement, not a gate: noise degrades it)
        let mh:i32=0;
        let mk:i32=0;
        while(mk<24){
            if(q1tq_recall_ok(&store,q1_slice_fact(s,mk))==1){mh=mh+1;}
            mk=mk+1;
        }
        // per-slice noise accounting: false-held facts, and how many the
        // learner absorbed (holds the teacher's false claim).
        let fsi:i32=0;
        let absi:i32=0;
        let ak:i32=0;
        while(ak<24){
            let afid:i32=q1_slice_fact(s,ak);
            let atc:i32=t5_claim_of(teacher,afid);
            if(atc!=t5_truth(afid)){
                fsi=fsi+1;
                if(t5_claim_of(&store,afid)==atc){absi=absi+1;}
            }
            ak=ak+1;
        }
        _zag_print("Q1TQ_SLICE,");
        _zag_print(lname); _zag_print(",");
        cl_number(s as i64); _zag_print(",");
        cl_number(fo.hits as i64); _zag_print(",");
        cl_number(fo.nears as i64); _zag_print(",");
        cl_number(fo.misses as i64); _zag_print(",");
        cl_number(fo.score_x10 as i64); _zag_print(",");
        cl_number(fo.pass as i64); _zag_print(",");
        cl_number(adopts as i64); _zag_print(",");
        cl_number(mh as i64); _zag_print(",");
        cl_number(tw.fired as i64); _zag_print(",");
        cl_number(fsi as i64); _zag_print(",");
        cl_number(absi as i64);
        _zag_println("");
        total_hits=total_hits+fo.hits;
        if(fo.hits>=10){total_pass=total_pass+1;}
        total_clean_adopted=total_clean_adopted+adopts;
        total_true_mastery=total_true_mastery+mh;
        nio_free(stim2); nio_free(occ2); nio_free(ot2);
        q1_mctx_free(&mctx);
        tb_manifest_free(&m);
        nio_free(sp); nio_free(cn);
        s=s+1;
    }

    // ================= FINAL STATE =================
    // true-mastery over the 192 curriculum facts (measurement)
    let fm:i32=0;
    let fs:i32=0;
    while(fs<8){
        let fk:i32=0;
        while(fk<24){
            if(q1tq_recall_ok(&store,q1_slice_fact(fs,fk))==1){fm=fm+1;}
            fk=fk+1;
        }
        fs=fs+1;
    }
    let sm:i32=0;
    let sk2:i32=0;
    while(sk2<8){
        if(q1tq_recall_ok(&store,q1_scaffold_fact(sk2))==1){sm=sm+1;}
        sk2=sk2+1;
    }
    fails=fails+cl_check("q1tq_scaffold_retained",sm,8);
    fails=fails+cl_check("q1tq_store_n",store.n,200);

    _zag_print("Q1TQ_RUN,");
    _zag_print(lname); _zag_print(",");
    cl_number(total_hits as i64); _zag_print(",");
    cl_number(total_pass as i64); _zag_print(",");
    cl_number(total_clean_adopted as i64); _zag_print(",");
    cl_number(total_true_mastery as i64); _zag_print(",");
    cl_number(fm as i64); _zag_print(",");
    cl_number(fails as i64);
    _zag_println("");

    // ================= FILTER / ABSORB ACCOUNTING =================
    // Over all 228 teacher claims: absorbed = learner holds the teacher's
    // false claim; filtered = false claim the learner does not hold;
    // untaught = false claim the learner never saw (probe ids >= 192).
    let abs:i32=0;
    let fil:i32=0;
    let unt:i32=0;
    let qk:i32=0;
    while(qk<Q1_PROBE_N){
        let qfid:i32=q1_probe_id(qk);
        let taught:i32=0;
        if(qk<192){taught=1;}
        q1tq_account_fact(taught,qfid,t5_claim_of(teacher,qfid),
                          t5_truth(qfid),&store,&abs,&fil,&unt);
        qk=qk+1;
    }
    _zag_print("Q1TQ_ABSORB,");
    _zag_print(lname); _zag_print(",");
    cl_number(abs as i64); _zag_print(",");
    cl_number(fil as i64); _zag_print(",");
    cl_number(unt as i64);
    _zag_println("");

    _zag_print("Q1TQ_DIGEST,");
    _zag_print(lname); _zag_print(",learner,");
    let dl:[]u8=q1tq_state_digest(&store);
    q1tq_hex(dl);
    _zag_println("");
    _zag_print("Q1TQ_DIGEST,");
    _zag_print(lname); _zag_print(",teacher,");
    let dt:[]u8=q1tq_state_digest(teacher);
    q1tq_hex(dt);
    _zag_println("");
    nio_free(dl); nio_free(dt);
    nio_free(lname);
    q1_spanmap_free(&spans);
    return fails;
}

fn main()i32 {
    let fails:i32=0;

    // ================= GENUINELY-LEARNED TEACHER (Q1B construction) =================
    // Fresh-audited by construction: q1b_learned_teacher_build starts from
    // t5_init (n==0, no slots); the driver audits the acquisition history.
    let tspans:Q1SpanMap=q1_spanmap_init(256);
    let teacher:T5Store=q1b_learned_teacher_build(&tspans);
    fails=fails+cl_check("q1tq_prenoise_n",teacher.n,228);
    fails=fails+cl_check("q1tq_prenoise_learn_gate",teacher.learn_gate,0);
    fails=fails+cl_check("q1tq_prenoise_zero_plants",
        t5_audit_op_n(&teacher,T5_OP_PLANT),0);
    fails=fails+cl_check("q1tq_prenoise_adds_228",
        t5_audit_op_n(&teacher,T5_OP_ADD),228);
    fails=fails+cl_check("q1tq_prenoise_disconnect",
        t5_audit_op_n(&teacher,T5_OP_DISCONNECT),1);
    fails=fails+cl_check("q1tq_prenoise_false_claims",
        q1b_teacher_false_claims(&teacher),0);
    fails=fails+cl_check("q1tq_prenoise_holds_curriculum",
        q1b_teacher_holds_curriculum(&teacher),0);

    // ================= DETERMINISTIC NOISE INJECTION (harness-side) =================
    // Every held claim with even fact id (id mod 2 == 0) is flipped to a
    // plausible false value (t5_plant_claim construction). Not a TNN
    // decision: harness-side corruption of the teacher's memory.
    let nfalse:i32=q1tq_inject_noise(&teacher);
    _zag_print("Q1TQ_NOISE,");
    cl_number(nfalse as i64); _zag_print(",");
    cl_number(228 as i64);
    _zag_println("");
    fails=fails+cl_check("q1tq_noise_count",nfalse,118);
    fails=fails+cl_check("q1tq_noise_false_claims",
        q1b_teacher_false_claims(&teacher),nfalse);
    fails=fails+cl_check("q1tq_noise_implausible",
        q1tq_implausible_false_claims(&teacher),0);
    fails=fails+cl_check("q1tq_noise_n_unchanged",teacher.n,228);
    // the teacher's learning history is untouched by the corruption
    fails=fails+cl_check("q1tq_postnoise_zero_plants",
        t5_audit_op_n(&teacher,T5_OP_PLANT),0);
    fails=fails+cl_check("q1tq_postnoise_adds_228",
        t5_audit_op_n(&teacher,T5_OP_ADD),228);

    // ================= NOISY TEACHER-LEG =================
    fails=fails+q1tq_leg(&teacher);
    q1_spanmap_free(&tspans);

    if(fails==0){
        _zag_println("Q1TQ_COMPLETE");
    }
    else{
        _zag_println("Q1TQ_FAIL");
    }
    return fails;
}

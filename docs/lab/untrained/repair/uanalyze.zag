// uanalyze.zag — TNN untrained structural-analysis faculty (Workstream B, 2026-09-26).
//
// PURPOSE: describe the STRUCTURE of genuinely novel inputs TNN was never
// trained on — no labels, no naming, only measurably-present structure.
// Analyzer-first: every claim is grounded in a computed measurement.
// Conservative by design: claims are emitted only when supporting metrics
// pass documented thresholds; otherwise the structure is WITHHELD (PENDING),
// never invented. A false positive is worse than a withheld claim.
//
// MODES (argv[1] first byte selects):
//   a <wav>            16-bit PCM mono WAV (use 16 kHz). Audio structure.
//   i <ppm>            binary PPM P6. Image structure.
//   v <prefix> <count> PPM frame sequence <prefix>f_001.ppm ... Video structure.
//
// OUTPUT: a MEASURE block (milli-unit integers, documented units) then a
// DESCRIBE block (sentences). The DESCRIBE sentences are TNN's claims.
// Deterministic: zero RNG, fixed thresholds -> byte-identical reruns.
//
// Numeric discipline: all float ARRAYS are i64 fixed-point in []u8 arenas
// (8-byte LE); heavy math stays in scalar f64 locals. No float slices.

fn zcstr(s:[]u8)[]u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let b:[]u8=p[0..s.len+1];
    let i:i64=0;while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}

fn read_all(path:[]u8)[]u8 {
    // Exact-size read. File size comes from lseek(2) SEEK_END; one allocation
    // of exactly that many bytes; read loop fills it. There is NO caller cap.
    // The ONLY size limit is the znc toolchain's <2^25-byte slice ceiling
    // (load-bearing toolchain constraint, not a design choice): a file at or
    // above 33,554,432 bytes cannot be held in one slice, so it yields an
    // empty slice and the caller reports a parse error — never a silent
    // truncation.
    let c:[]u8=zcstr(path);
    let fd:i64=_zag_raw_syscall(2, _zag_slice_ptr(c) as i64, 0, 0, 0, 0, 0);
    let ep:*u8=_zag_malloc(1) as *u8;
    let empty:[]u8=ep[0..1];
    let e0:[]u8=empty[0..0];
    if(fd<0){return e0;}
    let sz:i64=_zag_raw_syscall(8, fd, 0, 2, 0, 0, 0);
    if(sz<=0){let cc0:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);if(cc0==0){}return e0;}
    if(sz>=33554432){let cc1:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);if(cc1==0){}return e0;}
    let rs:i64=_zag_raw_syscall(8, fd, 0, 0, 0, 0, 0);
    if(rs!=0){}
    let bp:*u8=_zag_malloc(sz) as *u8;
    let buf:[]u8=bp[0..sz];
    let total:i64=0;
    let go:i32=1;
    while(go==1){
        let room:i64=sz-total;
        if(room<=0){go=0;}
        if(go==1){
            let r:i64=_zag_raw_syscall(0, fd, _zag_slice_ptr(buf) as i64+total, room, 0, 0, 0);
            if(r<=0){go=0;}
            if(r>0){total=total+r;}
        }
    }
    let cc:i64=_zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if(cc==0){}
    return buf[0..total];
}

fn get_u16(b:[]u8,o:i64)i64 {
    return (b[o] as i64)|((b[o+1] as i64)<<8);
}
fn get_u32(b:[]u8,o:i64)i64 {
    return (b[o] as i64)|((b[o+1] as i64)<<8)|((b[o+2] as i64)<<16)|((b[o+3] as i64)<<24);
}
fn get_s16(b:[]u8,o:i64)i64 {
    let v:i64=get_u16(b,o);
    if(v>=32768){v=v-65536;}
    return v;
}
fn put_i64(b:[]u8,o:i64,v:i64)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
    b[o+4]=((v>>32)&255) as u8;
    b[o+5]=((v>>40)&255) as u8;
    b[o+6]=((v>>48)&255) as u8;
    b[o+7]=((v>>56)&255) as u8;
    return;
}
fn get_i64(b:[]u8,o:i64)i64 {
    let v:i64=(b[o] as i64)|((b[o+1] as i64)<<8)|((b[o+2] as i64)<<16)|((b[o+3] as i64)<<24)|((b[o+4] as i64)<<32)|((b[o+5] as i64)<<40)|((b[o+6] as i64)<<48)|((b[o+7] as i64)<<56);
    return v;
}

fn pstr(s:[]u8)void { _zag_print(s); return; }
fn pln(s:[]u8)void { _zag_println(s); return; }
fn pi(v:i64)void { _zag_print(_zag_i64_to_str(v)); return; }

// print milli-unit integer as D.DDD
fn pmilli(v:i64)void {
    if(v<0){_zag_print("-");pmilli(-v);return;}
    let ip:i64=v/1000;
    let fr:i64=v-ip*1000;
    _zag_print(_zag_i64_to_str(ip));
    _zag_print(".");
    if(fr<100){_zag_print("0");}
    if(fr<10){_zag_print("0");}
    _zag_print(_zag_i64_to_str(fr));
    return;
}
fn pf3(v:f64)void {
    if(v<0.0){_zag_print("-");pf3(-v);return;}
    pmilli((v*1000.0) as i64);
    return;
}

fn fsqrt(x:f64)f64 {
    if(x<=0.0){return 0.0;}
    let g:f64=x*0.5+1.0;
    let k:i32=0;
    while(k<14){g=(g+x/g)*0.5;k=k+1;}
    return g;
}
fn fcos(x:f64)f64 {
    let pi2:f64=6.283185307179586;
    let y:f64=x;
    while(y>3.141592653589793){y=y-pi2;}
    while(y<-3.141592653589793){y=y+pi2;}
    let term:f64=1.0;
    let sum:f64=1.0;
    let y2:f64=y*y;
    let k:i32=1;
    while(k<9){
        term=term*y2/((2*k-1) as f64*(2*k) as f64);
        if(k-2*(k/2)==1){sum=sum-term;}
        if(k-2*(k/2)==0){sum=sum+term;}
        k=k+1;
    }
    return sum;
}
fn fsin(x:f64)f64 {
    return fcos(x-1.5707963267948966);
}

// copy n i64s from src arena to dst arena, insertion-sort dst ascending
fn isort_copy(src:[]u8,dst:[]u8,n:i64)void {
    let i:i64=0;
    while(i<n){put_i64(dst,i*8,get_i64(src,i*8));i=i+1;}
    let j:i64=1;
    while(j<n){
        let key:i64=get_i64(dst,j*8);
        let k:i64=j-1;
        let placed:i32=0;
        while(k>=0){
            let cur:i64=get_i64(dst,k*8);
            if(cur>key){put_i64(dst,(k+1)*8,cur);k=k-1;}
            if(cur<=key){put_i64(dst,(k+1)*8,key);placed=1;k=-1;}
        }
        if(placed==0){put_i64(dst,0,key);}
        j=j+1;
    }
    return;
}
fn median_sorted(s:[]u8,n:i64)i64 {
    if(n<=0){return 0;}
    if(n-2*(n/2)==1){return get_i64(s,(n/2)*8);}
    let a:i64=get_i64(s,(n/2-1)*8);
    let b:i64=get_i64(s,(n/2)*8);
    return (a+b)/2;
}
fn parse_int(s:[]u8)i64 {
    let v:i64=0;
    let i:i64=0;
    while(i<s.len){
        let d:i64=(s[i] as i64)-48;
        if(d>=0){if(d<=9){v=v*10+d;}}
        i=i+1;
    }
    return v;
}
fn is_ws(c:u8)i32 {
    let v:i64=c as i64;
    if(v==32){return 1;}
    if(v==10){return 1;}
    if(v==13){return 1;}
    if(v==9){return 1;}
    return 0;
}

// ---------------- AUDIO ----------------
// scan RIFF chunks for the 'data' chunk. out: data_off@0 data_size@8 (i64 LE). returns 1 found.
fn find_data_chunk(b:[]u8,out:[]u8)i32 {
    let bl:i64=b.len as i64;
    if(bl<20){return 0;}
    let o:i64=12;
    while(o+8<=bl){
        let cid0:i64=b[o] as i64;
        let cid1:i64=b[o+1] as i64;
        let cid2:i64=b[o+2] as i64;
        let cid3:i64=b[o+3] as i64;
        let csz:i64=get_u32(b,o+4);
        if(cid0==100){if(cid1==97){if(cid2==116){if(cid3==97){
            put_i64(out,0,o+8);
            put_i64(out,8,csz);
            return 1;
        }}}}
        let step:i64=8+csz;
        if((csz&1)==1){step=step+1;}
        if(step<=0){return 0;}
        o=o+step;
    }
    return 0;
}

fn audio_sample_at(b:[]u8,doff:i64,i:i64)i64 {
    return get_s16(b,doff+i*2);
}

fn analyze_audio(path:[]u8)i32 {
    let b:[]u8=read_all(path);
    if(b.len<48){pln("ERR short file");return 1;}
    if((b[0] as i64)!=82){pln("ERR not RIFF");return 1;}
    if((b[1] as i64)!=73){pln("ERR not RIFF");return 1;}
    if((b[2] as i64)!=70){pln("ERR not RIFF");return 1;}
    if((b[3] as i64)!=70){pln("ERR not RIFF");return 1;}
    let dcp:*u8=_zag_malloc(16) as *u8;
    let dca:[]u8=dcp[0..16];
    if(find_data_chunk(b,dca)==0){pln("ERR no data chunk");return 1;}
    let doff:i64=get_i64(dca,0);
    let datasz:i64=get_i64(dca,8);
    let blen:i64=b.len as i64;
    if(doff+datasz>blen){datasz=blen-doff;}
    let n:i64=datasz/2;
    if(n<16000){pln("ERR too short");return 1;}
    let sr:i64=16000;

    // 20 ms window energies (sum of squares, i64)
    let nw:i64=n/320;
    let esp:*u8=_zag_malloc(nw*8) as *u8;
    let es:[]u8=esp[0..nw*8];
    let i:i64=0;
    while(i<nw*8){es[i]=0;i=i+1;}
    let total_sq:i64=0;
    let peak:i64=0;
    let dc:i64=0;
    // per-20ms-window spectral bands (one-pole pair; same coeffs as frame bands).
    // Stored as milli-unit fractions (i64) for the onset event-vs-bed test.
    let wblp:*u8=_zag_malloc(nw*8) as *u8;
    let wbl:[]u8=wblp[0..nw*8];
    let wbmp:*u8=_zag_malloc(nw*8) as *u8;
    let wbm:[]u8=wbmp[0..nw*8];
    let wbhp:*u8=_zag_malloc(nw*8) as *u8;
    let wbh:[]u8=wbhp[0..nw*8];
    let wbi:i64=0;
    while(wbi<nw*8){wbl[wbi]=0;wbm[wbi]=0;wbh[wbi]=0;wbi=wbi+1;}
    let fa1:f64=0.8546;
    let fa2:f64=0.4559;
    let fy1:f64=0.0;
    let fy2:f64=0.0;
    let w:i64=0;
    while(w<nw){
        let s:i64=0;
        let k:i64=0;
        let wlo:f64=0.0;
        let wmd:f64=0.0;
        let whi:f64=0.0;
        while(k<320){
            let v:i64=audio_sample_at(b,doff,w*320+k);
            s=s+v*v;
            let av:i64=v;if(av<0){av=-av;}
            if(av>peak){peak=av;}
            dc=dc+v;
            let xf:f64=v as f64;
            fy1=fa1*fy1+(1.0-fa1)*xf;
            fy2=fa2*fy2+(1.0-fa2)*xf;
            wlo=wlo+fy1*fy1;
            let wd1:f64=fy2-fy1;wmd=wmd+wd1*wd1;
            let wd2:f64=xf-fy2;whi=whi+wd2*wd2;
            k=k+1;
        }
        put_i64(es,w*8,s);
        let wtot:f64=wlo+wmd+whi;
        if(wtot>0.0){
            put_i64(wbl,w*8,(wlo/wtot*1000.0) as i64);
            put_i64(wbm,w*8,(wmd/wtot*1000.0) as i64);
            put_i64(wbh,w*8,(whi/wtot*1000.0) as i64);
        }
        total_sq=total_sq+s;
        w=w+1;
    }
    let dur_ms:i64=(n*1000)/sr;
    let rms_all:f64=fsqrt((total_sq as f64)/(n as f64));
    let max_es:i64=0;
    let min_es:i64=-1;
    let w2:i64=0;
    while(w2<nw){
        let e:i64=get_i64(es,w2*8);
        if(e>max_es){max_es=e;}
        if(e>0){if(min_es<0){min_es=e;}if(e<min_es){min_es=e;}}
        w2=w2+1;
    }
    let dyn_ratio:f64=1.0;
    if(min_es>0){dyn_ratio=(max_es as f64)/(min_es as f64);}

    // onsets: window energy > 2x median of previous 5 windows, rms>300, 60ms refractory
    let onp:*u8=_zag_malloc(nw*8) as *u8;
    let on:[]u8=onp[0..nw*8];
    let n_on:i64=0;
    let last_on:i64=-100;
    let m5p:*u8=_zag_malloc(40) as *u8;
    let m5:[]u8=m5p[0..40];
    let m5s:*u8=_zag_malloc(40) as *u8;
    let m5d:[]u8=m5s[0..40];
    let wi:i64=5;
    while(wi<nw){
        let e:i64=get_i64(es,wi*8);
        if(e>28800000){
            let j:i64=0;
            while(j<5){put_i64(m5,j*8,get_i64(es,(wi-5+j)*8));j=j+1;}
            isort_copy(m5,m5d,5);
            let med:i64=get_i64(m5d,2*8);
            if(e>2*med){
                if(wi-last_on>=3){
                    put_i64(on,n_on*8,wi);
                    n_on=n_on+1;
                    last_on=wi;
                }
            }
        }
        wi=wi+1;
    }
    // inter-onset intervals: median + CV
    let ioi_med_ms:i64=0;
    let ioi_cv_milli:i64=0;
    if(n_on>=3){
        let iop:*u8=_zag_malloc(n_on*8) as *u8;
        let ioa:[]u8=iop[0..n_on*8];
        let ios:*u8=_zag_malloc(n_on*8) as *u8;
        let iod:[]u8=ios[0..n_on*8];
        let q:i64=1;
        while(q<n_on){
            let t0:i64=get_i64(on,(q-1)*8);
            let t1:i64=get_i64(on,q*8);
            put_i64(ioa,(q-1)*8,(t1-t0)*20);
            q=q+1;
        }
        isort_copy(ioa,iod,n_on-1);
        ioi_med_ms=median_sorted(iod,n_on-1);
        let msum:f64=0.0;
        let qq:i64=0;
        while(qq<n_on-1){msum=msum+get_i64(ioa,qq*8) as f64;qq=qq+1;}
        let mm:f64=msum/((n_on-1) as f64);
        let vsum:f64=0.0;
        let q2:i64=0;
        while(q2<n_on-1){let d:f64=get_i64(ioa,q2*8) as f64-mm;vsum=vsum+d*d;q2=q2+1;}
        let sd:f64=fsqrt(vsum/((n_on-1) as f64));
        if(mm>0.0){ioi_cv_milli=((sd/mm)*1000.0) as i64;}
    }
    // onset taxonomy: classify each onset as swell / transient / note / soft / fluctuation.
    // A TRANSIENT needs fast attack + fast decay + spectral dissimilarity from the bed.
    // (Without the spectral test, sub-swell bursts and AM ripple shred into phantom "events".)
    let n_transient:i64=0;
    let n_swell_on:i64=0;
    let n_note_on:i64=0;
    let n_soft_on:i64=0;
    let n_fluct_on:i64=0;
    // onset-proximity mask: 1 for windows within 3 of any onset (bed exclusion)
    let oprp:*u8=_zag_malloc(nw) as *u8;
    let onprox:[]u8=oprp[0..nw];
    let ozi:i64=0;
    while(ozi<nw){onprox[ozi]=0;ozi=ozi+1;}
    let oii:i64=0;
    while(oii<n_on){
        let ow:i64=get_i64(on,oii*8);
        let pa:i64=ow-3;if(pa<0){pa=0;}
        let pz:i64=ow+3;if(pz>=nw){pz=nw-1;}
        let pk2:i64=pa;
        while(pk2<=pz){onprox[pk2]=1;pk2=pk2+1;}
        oii=oii+1;
    }
    let nalloc:i64=n_on;if(nalloc<1){nalloc=1;}
    let trp:*u8=_zag_malloc(nalloc*8) as *u8;
    let tra:[]u8=trp[0..nalloc*8];
    let pm10p:*u8=_zag_malloc(80) as *u8;
    let pm10:[]u8=pm10p[0..80];
    let pm10s:*u8=_zag_malloc(80) as *u8;
    let pm10d:[]u8=pm10s[0..80];
    // bed mean level (non-onset windows) for the quiet/continuous bed decision
    let bed_sum:i64=0;
    let bed_cnt:i64=0;
    let wb2:i64=0;
    while(wb2<nw){
        if(onprox[wb2]==0){bed_sum=bed_sum+get_i64(es,wb2*8);bed_cnt=bed_cnt+1;}
        wb2=wb2+1;
    }
    let oi2:i64=0;
    while(oi2<n_on){
        let w0:i64=get_i64(on,oi2*8);
        let pj:i64=0;
        while(pj<5){put_i64(pm10,pj*8,get_i64(es,(w0-5+pj)*8));pj=pj+1;}
        isort_copy(pm10,pm10d,5);
        let pre_med:i64=get_i64(pm10d,2*8);
        let pc:i64=0;
        let pk3:i64=0;
        while(pk3<10){
            let pw:i64=w0+5+pk3;
            if(pw<nw){put_i64(pm10,pc*8,get_i64(es,pw*8));pc=pc+1;}
            pk3=pk3+1;
        }
        let post_med:i64=0;
        if(pc>0){isort_copy(pm10,pm10d,pc);post_med=median_sorted(pm10d,pc);}
        let thr12:i64=pre_med+(pre_med/5);
        let rlim:i64=w0-10;if(rlim<0){rlim=0;}
        let rise_w:i64=0;
        let rs:i64=w0;
        while(rs>rlim){
            let ev:i64=get_i64(es,rs*8);
            if(ev<=thr12){rs=rlim;}
            if(ev>thr12){rise_w=rise_w+1;rs=rs-1;}
        }
        let decayed:i32=0;
        if(w0+5<nw){
            if(get_i64(es,(w0+5)*8)<pre_med+(pre_med/2)){decayed=1;}
        }
        // event band vector: windows [w0-1, w0+2]; bed: [w0-30, w0-6] minus onset proximity
        let el:i64=0;let emd:i64=0;let eh:i64=0;
        let ea:i64=w0-1;if(ea<0){ea=0;}
        let ez:i64=w0+2;if(ez>=nw){ez=nw-1;}
        let ew:i64=ea;
        while(ew<=ez){
            el=el+get_i64(wbl,ew*8);emd=emd+get_i64(wbm,ew*8);eh=eh+get_i64(wbh,ew*8);
            ew=ew+1;
        }
        let bl2:i64=0;let bm2:i64=0;let bh2:i64=0;
        let bed_n:i64=0;
        let ba:i64=w0-30;if(ba<0){ba=0;}
        let bz2:i64=w0-6;if(bz2>=nw){bz2=nw-1;}
        let bw:i64=ba;
        while(bw<=bz2){
            if(onprox[bw]==0){
                bl2=bl2+get_i64(wbl,bw*8);bm2=bm2+get_i64(wbm,bw*8);bh2=bh2+get_i64(wbh,bw*8);
                bed_n=bed_n+1;
            }
            bw=bw+1;
        }
        let sim_milli:i64=1000;
        if(bed_n>=5){
            let elf:f64=el as f64;let emf:f64=emd as f64;let ehf:f64=eh as f64;
            let blf:f64=bl2 as f64;let bmf:f64=bm2 as f64;let bhf:f64=bh2 as f64;
            let dot:f64=elf*blf+emf*bmf+ehf*bhf;
            let ne:f64=fsqrt(elf*elf+emf*emf+ehf*ehf);
            let nb:f64=fsqrt(blf*blf+bmf*bmf+bhf*bhf);
            if(ne>0.0){if(nb>0.0){sim_milli=(dot/(ne*nb)*1000.0) as i64;}}
        }
        if(pre_med==0){
            // onset from near-silence: a true transient has fast attack AND fast decay;
            // a sustained burst from silence is note-like, not a transient.
            if(rise_w<=2){
                let half0:i64=get_i64(es,w0*8)/2;
                let dw2:i64=w0+2;
                if(dw2>=nw){dw2=nw-1;}
                if(get_i64(es,dw2*8)<=half0){
                    put_i64(tra,n_transient*8,w0);
                    n_transient=n_transient+1;
                }
                if(get_i64(es,dw2*8)>half0){n_note_on=n_note_on+1;}
            }
            if(rise_w>2){n_soft_on=n_soft_on+1;}
        }
        if(pre_med>0){
        if(post_med>pre_med+(pre_med/2)){
            n_swell_on=n_swell_on+1;
        }
        if(post_med<=pre_med+(pre_med/2)){
            if(rise_w<=2){
                if(decayed==1){
                    if(bed_n>=5){
                        if(sim_milli<900){
                            put_i64(tra,n_transient*8,w0);
                            n_transient=n_transient+1;
                        }
                        if(sim_milli>=900){n_fluct_on=n_fluct_on+1;}
                    }
                    if(bed_n<5){n_fluct_on=n_fluct_on+1;}
                }
                if(decayed==0){n_note_on=n_note_on+1;}
            }
            if(rise_w>2){n_soft_on=n_soft_on+1;}
        }
        } // end if(pre_med>0)
        oi2=oi2+1;
    }
    // transient IOI stats (regularity of true transients only)
    let tioi_med_ms:i64=0;
    let tioi_cv_milli:i64=0;
    if(n_transient>=3){
        let tip:*u8=_zag_malloc(n_transient*8) as *u8;
        let tia:[]u8=tip[0..n_transient*8];
        let tis:*u8=_zag_malloc(n_transient*8) as *u8;
        let tid:[]u8=tis[0..n_transient*8];
        let tq:i64=1;
        while(tq<n_transient){
            let tt0:i64=get_i64(tra,(tq-1)*8);
            let tt1:i64=get_i64(tra,tq*8);
            put_i64(tia,(tq-1)*8,(tt1-tt0)*20);
            tq=tq+1;
        }
        isort_copy(tia,tid,n_transient-1);
        tioi_med_ms=median_sorted(tid,n_transient-1);
        let tmsum:f64=0.0;
        let tqq:i64=0;
        while(tqq<n_transient-1){tmsum=tmsum+get_i64(tia,tqq*8) as f64;tqq=tqq+1;}
        let tmm:f64=tmsum/((n_transient-1) as f64);
        let tvsum:f64=0.0;
        let tq2:i64=0;
        while(tq2<n_transient-1){let td2:f64=get_i64(tia,tq2*8) as f64-tmm;tvsum=tvsum+td2*td2;tq2=tq2+1;}
        let tsd:f64=fsqrt(tvsum/((n_transient-1) as f64));
        if(tmm>0.0){tioi_cv_milli=((tsd/tmm)*1000.0) as i64;}
    }
    // global transient-event vs bed spectral similarity (pooled over transient onsets)
    let spec_sim_milli:i64=1000;
    if(n_transient>=3){
        let gel:i64=0;let gem:i64=0;let geh:i64=0;
        let gbl:i64=0;let gbm:i64=0;let gbh:i64=0;
        let gk:i64=0;
        while(gk<n_transient){
            let gw0:i64=get_i64(tra,gk*8);
            let gea:i64=gw0-1;if(gea<0){gea=0;}
            let gez:i64=gw0+2;if(gez>=nw){gez=nw-1;}
            let gew:i64=gea;
            while(gew<=gez){
                gel=gel+get_i64(wbl,gew*8);gem=gem+get_i64(wbm,gew*8);geh=geh+get_i64(wbh,gew*8);
                gew=gew+1;
            }
            let gba:i64=gw0-30;if(gba<0){gba=0;}
            let gbz:i64=gw0-6;if(gbz>=nw){gbz=nw-1;}
            let gbw:i64=gba;
            while(gbw<=gbz){
                if(onprox[gbw]==0){
                    gbl=gbl+get_i64(wbl,gbw*8);gbm=gbm+get_i64(wbm,gbw*8);gbh=gbh+get_i64(wbh,gbw*8);
                }
                gbw=gbw+1;
            }
            gk=gk+1;
        }
        let gelf:f64=gel as f64;let gemf:f64=gem as f64;let gehf:f64=geh as f64;
        let gblf:f64=gbl as f64;let gbmf:f64=gbm as f64;let gbhf:f64=gbh as f64;
        let gdot:f64=gelf*gblf+gemf*gbmf+gehf*gbhf;
        let gne:f64=fsqrt(gelf*gelf+gemf*gemf+gehf*gehf);
        let gnb:f64=fsqrt(gblf*gblf+gbmf*gbmf+gbhf*gbhf);
        if(gne>0.0){if(gnb>0.0){spec_sim_milli=(gdot/(gne*gnb)*1000.0) as i64;}}
    }

    // pitch: 50 ms frames, 25 ms hop... use 50ms hop for speed. autocorr lags 4..320 (4000..50 Hz)
    let flen:i64=800;
    let hop:i64=800;
    let nf:i64=(n-flen)/hop;
    if(nf<2){pln("ERR too few frames");return 1;}
    let f0p:*u8=_zag_malloc(nf*8) as *u8;
    let f0a:[]u8=f0p[0..nf*8];
    let stp:*u8=_zag_malloc(nf*8) as *u8;
    let sta:[]u8=stp[0..nf*8];
    let fi:i64=0;
    while(fi<nf*8){f0a[fi]=0;sta[fi]=0;fi=fi+1;}
    // spectral bands per frame (one-pole lowpass pair)
    let band_low:f64=0.0;let band_mid:f64=0.0;let band_high:f64=0.0;
    let band_vhi:f64=0.0;
    let band_n:i64=0;
    // DFT peak counts per frame (every 4th frame)
    let pkp:*u8=_zag_malloc(nf*8) as *u8;
    let pka:[]u8=pkp[0..nf*8];
    let pi2:i64=0;
    while(pi2<nf*8){pka[pi2]=0;pi2=pi2+1;}
    let n_voiced:i64=0;
    let n_active:i64=0;
    let rrp:*u8=_zag_malloc(321*8) as *u8;
    let rra:[]u8=rrp[0..321*8];
    let f:i64=0;
    while(f<nf){
        let base:i64=f*hop;
        // frame rms
        let fsq:f64=0.0;
        let kk:i64=0;
        while(kk<flen){
            let v:f64=audio_sample_at(b,doff,base+kk) as f64;
            fsq=fsq+v*v;
            kk=kk+1;
        }
        let frms:f64=fsqrt(fsq/flen as f64);
        if(frms>400.0){
            n_active=n_active+1;
            // autocorrelation with local-maximum peak picking
            let r0:f64=fsq;
            let rmax:f64=0.0;
            let lag:i64=4;
            while(lag<=320){
                let rr:f64=0.0;
                let k2:i64=0;
                let lim:i64=flen-lag;
                while(k2<lim){
                    rr=rr+(audio_sample_at(b,doff,base+k2) as f64)*(audio_sample_at(b,doff,base+k2+lag) as f64);
                    k2=k2+1;
                }
                let rn:f64=rr/r0;
                put_i64(rra,lag*8,(rn*1000.0) as i64);
                if(rn>rmax){rmax=rn;}
                lag=lag+1;
            }
            if(rmax>=0.5){
                let blag:i64=0;
                let br:f64=0.0;
                let lag3:i64=5;
                while(lag3<320){
                    let rc:i64=get_i64(rra,lag3*8);
                    if(rc>=get_i64(rra,(lag3-1)*8)){
                        if(rc>=get_i64(rra,(lag3+1)*8)){
                            let rv:f64=(rc as f64)/1000.0;
                            if(rv>br){br=rv;blag=lag3;}
                        }
                    }
                    lag3=lag3+1;
                }
                // octave (half-lag) correction: search +-2 around the divisor for a
                // nearby local maximum instead of testing one exact integer lag.
                if(blag>=8){
                    let half:i64=blag/2;
                    let best_h:i64=0;
                    let best_hv:f64=0.0;
                    let hd:i64=-2;
                    while(hd<=2){
                        let hh:i64=half+hd;
                        if(hh>=5){
                            if(hh<=319){
                                let hc2:i64=get_i64(rra,hh*8);
                                if(hc2>=get_i64(rra,(hh-1)*8)){
                                    if(hc2>=get_i64(rra,(hh+1)*8)){
                                        let hv2:f64=(hc2 as f64)/1000.0;
                                        if(hv2>best_hv){best_hv=hv2;best_h=hh;}
                                    }
                                }
                            }
                        }
                        hd=hd+1;
                    }
                    if(best_hv>=0.85*br){blag=best_h;br=best_hv;}
                }
                if(blag>0){
                    let f0:f64=(sr as f64)/(blag as f64);
                    put_i64(f0a,f*8,(f0*10.0) as i64);
                    put_i64(sta,f*8,(br*1000.0) as i64);
                    n_voiced=n_voiced+1;
                }
            }
            // spectral bands (one-pole pair) + very-high band (>~4 kHz, for the pitch-ceiling note)
            let a1:f64=0.8546;let a2:f64=0.4559;let a3:f64=0.3890;
            let y1:f64=0.0;let y2:f64=0.0;let y3:f64=0.0;
            let lo:f64=0.0;let md:f64=0.0;let hi:f64=0.0;let vhi:f64=0.0;
            let k4:i64=0;
            while(k4<flen){
                let x:f64=audio_sample_at(b,doff,base+k4) as f64;
                y1=a1*y1+(1.0-a1)*x;
                y2=a2*y2+(1.0-a2)*x;
                y3=a3*y3+(1.0-a3)*x;
                lo=lo+y1*y1;
                let d1:f64=y2-y1;md=md+d1*d1;
                let d2:f64=x-y2;hi=hi+d2*d2;
                let d3:f64=x-y3;vhi=vhi+d3*d3;
                k4=k4+1;
            }
            let tot:f64=lo+md+hi;
            if(tot>0.0){
                band_low=band_low+lo/tot;
                band_mid=band_mid+md/tot;
                band_high=band_high+hi/tot;
                band_vhi=band_vhi+vhi/tot;
                band_n=band_n+1;
            }
        }
        // DFT peaks every 4th frame
        if(f-4*(f/4)==0){
            if(frms>400.0){
                let magp:*u8=_zag_malloc(32*8) as *u8;
                let mag:[]u8=magp[0..32*8];
                let mi:i64=0;
                while(mi<32*8){mag[mi]=0;mi=mi+1;}
                let msum2:f64=0.0;
                let bn:i64=1;
                while(bn<32){
                    let re:f64=0.0;let im:f64=0.0;
                    let s2:i64=0;
                    while(s2<64){
                        let xv:f64=audio_sample_at(b,doff,base+s2*12) as f64;
                        let ph:f64=6.283185307179586*(bn as f64)*(s2 as f64)/64.0;
                        re=re+xv*fcos(ph);
                        im=im+xv*fsin(ph);
                        s2=s2+1;
                    }
                    let m2:f64=re*re+im*im;
                    put_i64(mag,bn*8,(m2/1000000.0) as i64);
                    msum2=msum2+m2/1000000.0;
                    bn=bn+1;
                }
                let mmean:f64=msum2/31.0;
                let vs2:f64=0.0;
                let bn2:i64=1;
                while(bn2<32){
                    let dd:f64=get_i64(mag,bn2*8) as f64-mmean;
                    vs2=vs2+dd*dd;
                    bn2=bn2+1;
                }
                let msd:f64=fsqrt(vs2/31.0);
                let thr:f64=mmean+2.0*msd;
                let pkc:i64=0;
                let bn3:i64=1;
                while(bn3<31){
                    let v0:i64=get_i64(mag,bn3*8);
                    if(v0 as f64>thr){
                        let vp:i64=get_i64(mag,(bn3-1)*8);
                        let vn:i64=get_i64(mag,(bn3+1)*8);
                        if(v0>vp){if(v0>vn){pkc=pkc+1;}}
                    }
                    bn3=bn3+1;
                }
                put_i64(pka,f*8,pkc+1);
            }
        }
        f=f+1;
    }

    // voiced f0 stats
    let voiced_frac_milli:i64=(n_voiced*1000)/nf;
    let voiced_active_frac_milli:i64=0;
    if(n_active>0){voiced_active_frac_milli=(n_voiced*1000)/n_active;}
    let f0_med:i64=0;let f0_p10:i64=0;let f0_p90:i64=0;let glide:i64=0;let str_med:i64=0;
    if(n_voiced>0){
        let vfp:*u8=_zag_malloc(n_voiced*8) as *u8;
        let vfa:[]u8=vfp[0..n_voiced*8];
        let stp2:*u8=_zag_malloc(n_voiced*8) as *u8;
        let sta2:[]u8=stp2[0..n_voiced*8];
        let vc:i64=0;
        let ff:i64=0;
        while(ff<nf){
            let fv:i64=get_i64(f0a,ff*8);
            if(fv>0){
                put_i64(vfa,vc*8,fv);
                put_i64(sta2,vc*8,get_i64(sta,ff*8));
                vc=vc+1;
            }
            ff=ff+1;
        }
        let scp:*u8=_zag_malloc(n_voiced*8) as *u8;
        let sca:[]u8=scp[0..n_voiced*8];
        isort_copy(vfa,sca,n_voiced);
        f0_med=median_sorted(sca,n_voiced);
        f0_p10=get_i64(sca,(n_voiced/10)*8);
        f0_p90=get_i64(sca,(n_voiced*9/10)*8);
        // glide: median of first third vs last third (time order in vfa)
        let n3:i64=n_voiced/3;
        if(n3>=2){
            let s3p:*u8=_zag_malloc(n_voiced*8) as *u8;
            let s3a:[]u8=s3p[0..n_voiced*8];
            let s3d:*u8=_zag_malloc(n_voiced*8) as *u8;
            let s3b:[]u8=s3d[0..n_voiced*8];
            let t3:i64=0;
            while(t3<n3){put_i64(s3a,t3*8,get_i64(vfa,t3*8));t3=t3+1;}
            isort_copy(s3a,s3b,n3);
            let m_first:i64=median_sorted(s3b,n3);
            let t4:i64=0;
            while(t4<n3){put_i64(s3a,t4*8,get_i64(vfa,(n_voiced-n3+t4)*8));t4=t4+1;}
            isort_copy(s3a,s3b,n3);
            let m_last:i64=median_sorted(s3b,n3);
            glide=m_last-m_first;
        }
        let sc2:*u8=_zag_malloc(n_voiced*8) as *u8;
        let sd2:[]u8=sc2[0..n_voiced*8];
        isort_copy(sta2,sd2,n_voiced);
        str_med=median_sorted(sd2,n_voiced);
    }
    // median spectral peak count (over frames where measured)
    let pkn:i64=0;
    let f5:i64=0;
    while(f5<nf){
        if(get_i64(pka,f5*8)>0){pkn=pkn+1;}
        f5=f5+1;
    }
    let peaks_med:i64=0;
    if(pkn>0){
        let pkc2:*u8=_zag_malloc(pkn*8) as *u8;
        let pkb:[]u8=pkc2[0..pkn*8];
        let pkd:*u8=_zag_malloc(pkn*8) as *u8;
        let pkdd:[]u8=pkd[0..pkn*8];
        let qc:i64=0;
        let f6:i64=0;
        while(f6<nf){
            let pv:i64=get_i64(pka,f6*8);
            if(pv>0){put_i64(pkb,qc*8,pv-1);qc=qc+1;}
            f6=f6+1;
        }
        isort_copy(pkb,pkdd,pkn);
        peaks_med=median_sorted(pkdd,pkn);
    }
    // envelope periodicity: autocorr of window energies, lags 5..150 (0.1..3 s).
    // A period is claimed only for a genuine local maximum with topographic
    // prominence (>=0.08, absolute >=0.30). A monotonic short-lag shoulder
    // (slow envelope drift) has no local maxima and is WITHHELD, never
    // mistaken for periodicity.
    let env_period_ms:i64=0;
    let renvp:*u8=_zag_malloc(160*8) as *u8;
    let renv:[]u8=renvp[0..160*8];
    if(nw>210){
        let em:f64=0.0;
        let w8:i64=0;
        while(w8<nw){em=em+get_i64(es,w8*8) as f64;w8=w8+1;}
        em=em/(nw as f64);
        let ev:f64=0.0;
        let w9:i64=0;
        while(w9<nw){let d:f64=get_i64(es,w9*8) as f64-em;ev=ev+d*d;w9=w9+1;}
        let L:i64=4;
        while(L<=155){
            let cr:f64=0.0;
            let w10:i64=0;
            while(w10<nw-L){
                cr=cr+(get_i64(es,w10*8) as f64-em)*(get_i64(es,(w10+L)*8) as f64-em);
                w10=w10+1;
            }
            let rr2:i64=0;
            if(ev>0.0){rr2=(cr/ev*1000.0) as i64;}
            put_i64(renv,L*8,rr2);
            L=L+1;
        }
        // candidate peaks: interior local maxima, r>=300 (milli)
        let candp:*u8=_zag_malloc(160*8) as *u8;
        let cand:[]u8=candp[0..160*8];
        let n_cand:i64=0;
        let L2:i64=5;
        while(L2<=150){
            let rv:i64=get_i64(renv,L2*8);
            if(rv>=300){
                if(rv>=get_i64(renv,(L2-1)*8)){
                    if(rv>get_i64(renv,(L2+1)*8)){
                        // topographic prominence: scan each side until higher ground
                        let lb:i64=rv;
                        let sl:i64=L2-1;
                        while(sl>=5){
                            let sv:i64=get_i64(renv,sl*8);
                            if(sv>rv){sl=4;}
                            if(sv<=rv){if(sv<lb){lb=sv;}sl=sl-1;}
                        }
                        let rb:i64=rv;
                        let sr2:i64=L2+1;
                        while(sr2<=155){
                            let sv2:i64=get_i64(renv,sr2*8);
                            if(sv2>rv){sr2=156;}
                            if(sv2<=rv){if(sv2<rb){rb=sv2;}sr2=sr2+1;}
                        }
                        let base:i64=lb;if(rb>base){base=rb;}
                        if(rv-base>=80){
                            put_i64(cand,n_cand*8,L2);
                            n_cand=n_cand+1;
                        }
                    }
                }
            }
            L2=L2+1;
        }
        // strongest candidate wins; prefer a subharmonic local max at half the lag
        // (>= half the strength) to avoid reporting double the true period.
        let best_lag:i64=0;
        let best_r:i64=0;
        let c3:i64=0;
        while(c3<n_cand){
            let cl:i64=get_i64(cand,c3*8);
            let crv:i64=get_i64(renv,cl*8);
            if(crv>best_r){best_r=crv;best_lag=cl;}
            c3=c3+1;
        }
        if(best_lag>0){
            if(best_lag-2*(best_lag/2)==0){
                let hh2:i64=best_lag/2;
                if(hh2>=5){
                    let c4:i64=0;
                    while(c4<n_cand){
                        if(get_i64(cand,c4*8)==hh2){
                            if(get_i64(renv,hh2*8)*2>=best_r){best_lag=hh2;}
                        }
                        c4=c4+1;
                    }
                }
            }
            env_period_ms=best_lag*20;
        }
        // cycle support: the winning lag must align at least 3 above-mean window
        // pairs. A single chance coincidence (sparse irregular impulses) can form
        // a prominent local max; without repeated alignment it is not rhythm.
        // (Threshold is the mean energy itself; no sqrt needed.)
        if(env_period_ms>0){
            let sup:i64=0;
            let si2:i64=0;
            while(si2+best_lag<nw){
                if((get_i64(es,si2*8) as f64)>em){
                    if((get_i64(es,(si2+best_lag)*8) as f64)>em){sup=sup+1;}
                }
                si2=si2+1;
            }
            if(sup<3){env_period_ms=0;}
        }
    }
    // slow amplitude swells: 2 s boxcar smoothing, prominent peaks (>=3, 3 s apart,
    // peak >= 2x enclosing valleys). Reports swell count + median interval; the
    // fast detector above handles sub-3 s cycles, this handles slower swells.
    let n_swell_det:i64=0;
    let swell_med_ms:i64=0;
    let swell_cv_milli:i64=0;
    if(nw>320){
        let smp:*u8=_zag_malloc(nw*8) as *u8;
        let sm:[]u8=smp[0..nw*8];
        let sw:i64=0;
        while(sw<nw){
            let sa:i64=sw-50;if(sa<0){sa=0;}
            let sz:i64=sw+50;if(sz>=nw){sz=nw-1;}
            let sacc:i64=0;
            let sk:i64=sa;
            while(sk<=sz){sacc=sacc+get_i64(es,sk*8);sk=sk+1;}
            put_i64(sm,sw*8,sacc/((sz-sa+1) as i64));
            sw=sw+1;
        }
        let swpp:*u8=_zag_malloc(nw*8) as *u8;
        let swp:[]u8=swpp[0..nw*8];
        let n_swp:i64=0;
        let sw2:i64=1;
        while(sw2<nw-1){
            let cv0:i64=get_i64(sm,sw2*8);
            if(cv0>get_i64(sm,(sw2-1)*8)){
                if(cv0>=get_i64(sm,(sw2+1)*8)){
                    if(n_swp==0){
                        put_i64(swp,0,sw2);n_swp=1;
                    }
                    if(n_swp>0){
                        let lp0:i64=get_i64(swp,(n_swp-1)*8);
                        if(sw2-lp0>=150){
                            put_i64(swp,n_swp*8,sw2);n_swp=n_swp+1;
                        }
                        if(sw2-lp0<150){
                            if(cv0>get_i64(sm,lp0*8)){put_i64(swp,(n_swp-1)*8,sw2);}
                        }
                    }
                }
            }
            sw2=sw2+1;
        }
        let swgp:*u8=_zag_malloc(nw*8) as *u8;
        let swg:[]u8=swgp[0..nw*8];
        let n_swg:i64=0;
        let sgi:i64=0;
        while(sgi<n_swp){
            let sp0:i64=get_i64(swp,sgi*8);
            let va:i64=0;
            if(sgi>0){va=get_i64(swp,(sgi-1)*8);}
            let vz:i64=nw-1;
            if(sgi<n_swp-1){vz=get_i64(swp,(sgi+1)*8);}
            let lv:i64=get_i64(sm,sp0*8);
            let vk:i64=va;
            while(vk<=sp0){let vv2:i64=get_i64(sm,vk*8);if(vv2<lv){lv=vv2;}vk=vk+1;}
            let rv2v:i64=get_i64(sm,sp0*8);
            let vk2:i64=sp0;
            while(vk2<=vz){let vv3:i64=get_i64(sm,vk2*8);if(vv3<rv2v){rv2v=vv3;}vk2=vk2+1;}
            let vbase:i64=lv;if(rv2v>vbase){vbase=rv2v;}
            if(get_i64(sm,sp0*8)>=2*vbase){
                put_i64(swg,n_swg*8,sp0);n_swg=n_swg+1;
            }
            sgi=sgi+1;
        }
        n_swell_det=n_swg;
        if(n_swg>=3){
            let sip:*u8=_zag_malloc(n_swg*8) as *u8;
            let sia:[]u8=sip[0..n_swg*8];
            let sis:*u8=_zag_malloc(n_swg*8) as *u8;
            let sid:[]u8=sis[0..n_swg*8];
            let sq:i64=1;
            while(sq<n_swg){
                put_i64(sia,(sq-1)*8,(get_i64(swg,sq*8)-get_i64(swg,(sq-1)*8))*20);
                sq=sq+1;
            }
            isort_copy(sia,sid,n_swg-1);
            swell_med_ms=median_sorted(sid,n_swg-1);
            let smsum:f64=0.0;
            let sqq:i64=0;
            while(sqq<n_swg-1){smsum=smsum+get_i64(sia,sqq*8) as f64;sqq=sqq+1;}
            let smm:f64=smsum/((n_swg-1) as f64);
            let svsum:f64=0.0;
            let sq2:i64=0;
            while(sq2<n_swg-1){let sdv:f64=get_i64(sia,sq2*8) as f64-smm;svsum=svsum+sdv*sdv;sq2=sq2+1;}
            let ssd:f64=fsqrt(svsum/((n_swg-1) as f64));
            if(smm>0.0){swell_cv_milli=((ssd/smm)*1000.0) as i64;}
        }
    }

    // ---- MEASURE ----
    pln("MEASURE_BEGIN");
    pstr("dur_ms ");pi(dur_ms);pln("");
    pstr("rms_full_milli ");pf3(rms_all/32768.0);pln("");
    pstr("peak_full_milli ");pf3((peak as f64)/32768.0);pln("");
    pstr("dc_milli ");pf3((dc as f64)/(n as f64)/32768.0);pln("");
    pstr("dyn_ratio_milli ");pf3(dyn_ratio);pln("");
    pstr("n_onsets ");pi(n_on);pln("");
    pstr("n_transient ");pi(n_transient);pln("");
    pstr("n_swell_on ");pi(n_swell_on);pln("");
    pstr("n_note_on ");pi(n_note_on);pln("");
    pstr("n_soft_on ");pi(n_soft_on);pln("");
    pstr("n_fluct_on ");pi(n_fluct_on);pln("");
    pstr("tioi_med_ms ");pi(tioi_med_ms);pln("");
    pstr("tioi_cv_milli ");pi(tioi_cv_milli);pln("");
    pstr("spec_sim_event_bed_milli ");pi(spec_sim_milli);pln("");
    pstr("ioi_med_ms ");pi(ioi_med_ms);pln("");
    pstr("ioi_cv_milli ");pi(ioi_cv_milli);pln("");
    pstr("voiced_frac_milli ");pi(voiced_frac_milli);pln("");
    pstr("active_frac_milli ");pi((n_active*1000)/nf);pln("");
    pstr("voiced_active_frac_milli ");pi(voiced_active_frac_milli);pln("");
    pstr("f0_med_dhz ");pi(f0_med);pln("");
    pstr("f0_p10_dhz ");pi(f0_p10);pln("");
    pstr("f0_p90_dhz ");pi(f0_p90);pln("");
    pstr("f0_glide_dhz ");pi(glide);pln("");
    pstr("voicing_strength_milli ");pi(str_med);pln("");
    pstr("band_low_milli ");if(band_n>0){pf3(band_low/(band_n as f64));}if(band_n==0){pf3(0.0);}pln("");
    pstr("band_mid_milli ");if(band_n>0){pf3(band_mid/(band_n as f64));}if(band_n==0){pf3(0.0);}pln("");
    pstr("band_high_milli ");if(band_n>0){pf3(band_high/(band_n as f64));}if(band_n==0){pf3(0.0);}pln("");
    pstr("band_vhi_milli ");if(band_n>0){pf3(band_vhi/(band_n as f64));}if(band_n==0){pf3(0.0);}pln("");
    pstr("spec_peaks_med ");pi(peaks_med);pln("");
    pstr("env_period_ms ");pi(env_period_ms);pln("");
    pstr("n_swell_det ");pi(n_swell_det);pln("");
    pstr("swell_med_ms ");pi(swell_med_ms);pln("");
    pstr("swell_cv_milli ");pi(swell_cv_milli);pln("");
    pln("MEASURE_END");

    // ---- DESCRIBE (claims) ----
    pln("DESCRIBE_BEGIN");
    pstr("DURATION ~");pi(dur_ms/1000);pstr(" seconds of audio. ");pln("");
    if(dyn_ratio>=8.0){
        pstr("DYNAMICS large swings: loud events rise far above a quiet bed. ");pln("");
    }
    if(dyn_ratio<8.0){
        if(dyn_ratio>=3.0){pstr("DYNAMICS moderate variation in loudness across the clip. ");pln("");}
        if(dyn_ratio<3.0){pstr("DYNAMICS steady level throughout, no large loud-quiet contrasts. ");pln("");}
    }
    let tonal:i32=0;
    if(voiced_frac_milli>=550){
        if(str_med>=600){tonal=1;}
    }
    // active-region tonality: silence between phrases must not veto pitch that is
    // strong whenever the signal is present.
    let tonal_active:i32=0;
    if(voiced_active_frac_milli>=550){
        if(str_med>=600){tonal_active=1;}
    }
    // pitch-analysis ceiling: the estimator only searches at/below ~4 kHz. If
    // most energy is above that, any reported pitch is a subharmonic artifact.
    let vhi_dom:i32=0;
    if(band_n>0){if(band_vhi/(band_n as f64)>=0.5){vhi_dom=1;}}
    if(vhi_dom==1){tonal=0;tonal_active=0;}
    let gfrac:f64=0.0;
    if(f0_med>0){gfrac=(glide as f64)/(f0_med as f64);}
    if(tonal==1){
        pstr("PITCH predominantly tonal: a sustained pitched component near ");
        pmilli(f0_med*100);pstr(" Hz, typically spanning ");
        pmilli(f0_p10*100);pstr(" to ");pmilli(f0_p90*100);pstr(" Hz. ");pln("");
        if(gfrac>0.08){pstr("PITCH glides upward across the clip. ");pln("");}
        if(gfrac<-0.08){pstr("PITCH glides downward across the clip. ");pln("");}
        if(gfrac<=0.08){if(gfrac>=-0.08){pstr("PITCH stable, no strong overall glide. ");pln("");}}
    }
    if(tonal==0){
        if(tonal_active==1){
            pstr("PITCH tonal component in active regions: median ~");
            pmilli(f0_med*100);pstr(" Hz, typically spanning ");
            pmilli(f0_p10*100);pstr(" to ");pmilli(f0_p90*100);
            pstr(" Hz; quiet gaps between active regions (clip-wide pitch structure withheld). ");pln("");
            if(gfrac>0.08){pstr("PITCH glides upward across active regions. ");pln("");}
            if(gfrac<-0.08){pstr("PITCH glides downward across active regions. ");pln("");}
        }
        if(tonal_active==0){
            if(vhi_dom==1){
                pstr("PITCH no pitch estimated: dominant energy above the ~4 kHz pitch-analysis ceiling. ");pln("");
            }
            if(vhi_dom==0){
                pstr("PITCH no stable pitch detected; the sound is inharmonic or noise-like (pitch structure withheld). ");pln("");
            }
        }
    }
    if(n_transient>=3){
        pstr("ONSETS ");pi(n_transient);pstr(" distinct transient events. ");pln("");
        if(tioi_cv_milli<400){
            pstr("ONSETS repeat regularly, about every ");pi(tioi_med_ms);pstr(" ms. ");pln("");
        }
        if(tioi_cv_milli>=400){
            pstr("ONSETS occur at irregular intervals. ");pln("");
        }
    }
    if(n_transient<3){
        if(n_swell_on>=3){
            pstr("ONSETS no discrete transient events; ");pi(n_swell_on);
            pstr(" gradual swell onsets (slow amplitude rises). ");pln("");
        }
        if(n_swell_on<3){
            if(n_note_on+n_soft_on+n_fluct_on>=3){
                pstr("ONSETS no discrete transient events; onsets are gradual fluctuations within the sound. ");pln("");
            }
            if(n_note_on+n_soft_on+n_fluct_on<3){
                pstr("ONSETS no clear repeating transient events. ");pln("");
            }
        }
        if(ioi_cv_milli>=400){
            if(n_on>=3){
                pstr("ONSETS detected amplitude onsets occur at irregular intervals. ");pln("");
            }
        }
    }
    let blow:f64=0.0;let bmid:f64=0.0;let bhi:f64=0.0;let bvhi:f64=0.0;
    if(band_n>0){
        if(band_n>0){blow=band_low/(band_n as f64);}
        if(band_n>0){bmid=band_mid/(band_n as f64);}
        if(band_n>0){bhi=band_high/(band_n as f64);}
        if(band_n>0){bvhi=band_vhi/(band_n as f64);}
    }
    if(blow>=0.55){pstr("SPECTRUM energy concentrated below ~400 Hz. ");pln("");}
    if(bhi>=0.35){pstr("SPECTRUM strong energy above ~2 kHz. ");pln("");}
    if(bvhi>=0.10){pstr("SPECTRUM notable energy above ~4 kHz (pitch not estimated there; analysis ceiling 4 kHz). ");pln("");}
    if(blow<0.55){if(bhi<0.35){
        if(bmid>=0.45){pstr("SPECTRUM energy centered in mid frequencies (~400 Hz to 2 kHz). ");pln("");}
        if(bmid<0.45){pstr("SPECTRUM broadband energy spread across low, mid and high frequencies. ");pln("");}
    }}
    if(peaks_med>=6){
        if(tonal==1){pstr("SPECTRUM many simultaneous tonal components: rich harmonic structure. ");pln("");}
    }
    if(peaks_med<=2){
        if(tonal==0){if(tonal_active==0){if(vhi_dom==0){pstr("SPECTRUM few tonal components below ~4 kHz: noise-like there, no stacked harmonics (tonality above ~4 kHz not assessed). ");pln("");}}}
    }
    if(env_period_ms>0){
        pstr("RHYTHM amplitude repeats on a cycle of about ");
        pf3((env_period_ms as f64)/1000.0);pstr(" seconds. ");pln("");
    }
    if(env_period_ms==0){
        if(n_swell_det>=3){
            pstr("RHYTHM slow amplitude swells: about ");pi(n_swell_det);
            pstr(" across the clip, typically ");
            pf3((swell_med_ms as f64)/1000.0);pstr(" seconds apart");
            if(swell_cv_milli>500){pstr(", irregularly spaced");}
            pstr(". ");pln("");
        }
        if(n_swell_det<3){
            pstr("RHYTHM no slow amplitude cycle detected. ");pln("");
        }
    }
    // bed level: mean non-onset window energy relative to max
    let bed_ratio:f64=1.0;
    if(max_es>0){
        if(bed_cnt>0){bed_ratio=(bed_sum as f64)/(bed_cnt as f64)/(max_es as f64);}
    }
    let bed_quiet:i32=0;
    if(bed_ratio<0.02){bed_quiet=1;}
    if(n_transient>=3){
        if(bed_quiet==1){
            pstr("LAYERS transient events separated by quiet gaps. ");pln("");
        }
        if(bed_quiet==0){
            if(spec_sim_milli<850){
                if(tonal==1){pstr("LAYERS two simultaneous layers: a tonal bed plus transient events. ");pln("");}
                if(tonal==0){
                    if(tonal_active==1){pstr("LAYERS transient events over a tonal bed (tonal in active regions). ");pln("");}
                    if(tonal_active==0){pstr("LAYERS transient events over a noise-like bed. ");pln("");}
                }
            }
            if(spec_sim_milli>=850){
                pstr("LAYERS transient events within a single process; events share the bed's spectral character (no separable layer). ");pln("");
            }
        }
    }
    if(n_transient<3){
        if(tonal==1){
            pstr("LAYERS a single tonal process, no separable transient layer. ");pln("");
        }
        if(tonal==0){
            if(n_on>=3){
                if(bed_quiet==1){
                    pstr("LAYERS a single amplitude-modulated process with quiet gaps between bursts; no separable transient layer. ");pln("");
                }
                if(bed_quiet==0){
                    pstr("LAYERS a single amplitude-modulated process; no separable transient layer. ");pln("");
                }
            }
            if(n_on<3){
                if(vhi_dom==1){pstr("LAYERS a single continuous process; layer separation withheld (dominant content above ~4 kHz). ");pln("");}
                if(vhi_dom==0){pstr("LAYERS a single noise-like process; layer separation withheld. ");pln("");}
            }
        }
    }
    pln("DESCRIBE_END");
    return 0;
}

// parse binary PPM P6. out: w@0 h@8 hoff@16 (i64 LE). returns 1 ok, 0 fail.
// parse binary PPM P6. out: w@0 h@8 hoff@16 (i64 LE). returns 1 ok, 0 fail.
fn parse_ppm(b:[]u8,out:[]u8)i32 {
    if(b.len<10){return 0;}
    if((b[0] as i64)!=80){return 0;}
    if((b[1] as i64)!=54){return 0;}
    let i:i64=2;
    let bl:i64=b.len as i64;
    // single-loop state machine: 0 ws,1 w-digits,2 ws,3 h-digits,4 ws,5 mv-digits,6 one-ws,7 done
    let phase:i32=0;
    let w:i64=0;let h:i64=0;let mv:i64=0;
    let hoff:i64=0;
    let ok:i32=1;
    while(i<bl){
        if(phase==7){i=bl;}
        if(phase!=7){
            let c:u8=b[i];
            let isw:i32=is_ws(c);
            let dig:i64=(c as i64)-48;
            let isd:i32=0;
            if(dig>=0){if(dig<=9){isd=1;}}
            if(phase==0){if(isw==1){i=i+1;}if(isw==0){phase=1;}}
            if(phase==1){if(isd==1){w=w*10+dig;i=i+1;}if(isd==0){phase=2;}}
            if(phase==2){if(isw==1){i=i+1;}if(isw==0){phase=3;}}
            if(phase==3){if(isd==1){h=h*10+dig;i=i+1;}if(isd==0){phase=4;}}
            if(phase==4){if(isw==1){i=i+1;}if(isw==0){phase=5;}}
            if(phase==5){if(isd==1){mv=mv*10+dig;i=i+1;}if(isd==0){phase=6;}}
            if(phase==6){if(isw==1){i=i+1;hoff=i;phase=7;}if(isw==0){ok=0;phase=7;}}
        }
    }
    if(ok==0){return 0;}
    if(w<=0){return 0;}
    if(h<=0){return 0;}
    if(mv!=255){return 0;}
    put_i64(out,0,w);
    put_i64(out,8,h);
    put_i64(out,16,hoff);
    return 1;
}

fn analyze_image(path:[]u8)i32 {
    let b:[]u8=read_all(path);
    let outp:*u8=_zag_malloc(32) as *u8;
    let out:[]u8=outp[0..32];
    if(parse_ppm(b,out)==0){pln("ERR not P6 PPM");return 1;}
    let w:i64=get_i64(out,0);
    let h:i64=get_i64(out,8);
    let hoff:i64=get_i64(out,16);
    if(w<240){pln("ERR image too small");return 1;}
    if(h<160){pln("ERR image too small");return 1;}
    let n:i64=w*h;
    // full-res stats + native grayscale (for native-resolution texture)
    let gnp:*u8=_zag_malloc(n) as *u8;
    let gn:[]u8=gnp[0..n];
    let sr:i64=0;let sg:i64=0;let sb:i64=0;
    let sbr:i64=0;let sbr2:i64=0;let ssat:i64=0;
    let p:i64=0;
    while(p<n){
        let o:i64=hoff+p*3;
        let r:i64=b[o] as i64;
        let g:i64=b[o+1] as i64;
        let bl:i64=b[o+2] as i64;
        sr=sr+r;sg=sg+g;sb=sb+bl;
        let brv:i64=(299*r+587*g+114*bl)/1000;
        gn[p]=brv as u8;
        sbr=sbr+brv;
        sbr2=sbr2+brv*brv;
        let mx:i64=r;if(g>mx){mx=g;}if(bl>mx){mx=bl;}
        let mn:i64=r;if(g<mn){mn=g;}if(bl<mn){mn=bl;}
        ssat=ssat+mx-mn;
        p=p+1;
    }
    let nf:f64=n as f64;
    let br_mean:f64=(sbr as f64)/nf;
    let br_var:f64=(sbr2 as f64)/nf-br_mean*br_mean;
    if(br_var<0.0){br_var=0.0;}
    let br_std:f64=fsqrt(br_var);
    // downsample to 120x80 grayscale
    let dw:i64=120;let dh:i64=80;
    let gp:*u8=_zag_malloc(dw*dh) as *u8;
    let g:[]u8=gp[0..dw*dh];
    let gi:i64=0;
    while(gi<dw*dh){g[gi]=0;gi=gi+1;}
    let dy:i64=0;
    while(dy<dh){
        let dx:i64=0;
        while(dx<dw){
            let sx0:i64=dx*w/dw;
            let sx1:i64=(dx+1)*w/dw;
            let sy0:i64=dy*h/dh;
            let sy1:i64=(dy+1)*h/dh;
            let acc:i64=0;let cnt:i64=0;
            let sy:i64=sy0;
            while(sy<sy1){
                let sx:i64=sx0;
                while(sx<sx1){
                    let o2:i64=hoff+(sy*w+sx)*3;
                    acc=acc+(299*(b[o2] as i64)+587*(b[o2+1] as i64)+114*(b[o2+2] as i64))/1000;
                    cnt=cnt+1;
                    sx=sx+1;
                }
                sy=sy+1;
            }
            let vv:i64=0;
            if(cnt>0){vv=acc/cnt;}
            g[dy*dw+dx]=vv as u8;
            dx=dx+1;
        }
        dy=dy+1;
    }
    // Sobel edges on g
    let esum:f64=0.0;let esum2:f64=0.0;let enc:i64=0;
    let y:i64=1;
    while(y<dh-1){
        let x:i64=1;
        while(x<dw-1){
            let gx:i64=(g[(y-1)*dw+x+1] as i64)+2*(g[y*dw+x+1] as i64)+(g[(y+1)*dw+x+1] as i64)-(g[(y-1)*dw+x-1] as i64)-2*(g[y*dw+x-1] as i64)-(g[(y+1)*dw+x-1] as i64);
            let gy:i64=(g[(y+1)*dw+x-1] as i64)+2*(g[(y+1)*dw+x] as i64)+(g[(y+1)*dw+x+1] as i64)-(g[(y-1)*dw+x-1] as i64)-2*(g[(y-1)*dw+x] as i64)-(g[(y-1)*dw+x+1] as i64);
            let m2:i64=gx;if(m2<0){m2=-m2;}
            let m3:i64=gy;if(m3<0){m3=-m3;}
            let mg:f64=(m2+m3) as f64;
            esum=esum+mg;esum2=esum2+mg*mg;enc=enc+1;
            x=x+1;
        }
        y=y+1;
    }
    let emean:f64=esum/enc as f64;
    let evar:f64=esum2/enc as f64-emean*emean;
    if(evar<0.0){evar=0.0;}
    let estd:f64=fsqrt(evar);
    let ethr:f64=emean+1.5*estd;
    let ecount:i64=0;
    // strong-edge mask for connected-component orientation
    let smp:*u8=_zag_malloc(dw*dh) as *u8;
    let smask:[]u8=smp[0..dw*dh];
    let smi:i64=0;
    while(smi<dw*dh){smask[smi]=0;smi=smi+1;}
    let y2:i64=1;
    while(y2<dh-1){
        let x2:i64=1;
        while(x2<dw-1){
            let gx2:i64=(g[(y2-1)*dw+x2+1] as i64)+2*(g[y2*dw+x2+1] as i64)+(g[(y2+1)*dw+x2+1] as i64)-(g[(y2-1)*dw+x2-1] as i64)-2*(g[y2*dw+x2-1] as i64)-(g[(y2+1)*dw+x2-1] as i64);
            let gy2:i64=(g[(y2+1)*dw+x2-1] as i64)+2*(g[(y2+1)*dw+x2] as i64)+(g[(y2+1)*dw+x2+1] as i64)-(g[(y2-1)*dw+x2-1] as i64)-2*(g[(y2-1)*dw+x2] as i64)-(g[(y2-1)*dw+x2+1] as i64);
            let ax:i64=gx2;if(ax<0){ax=-ax;}
            let ay:i64=gy2;if(ay<0){ay=-ay;}
            if((ax+ay) as f64>ethr){
                ecount=ecount+1;
                smask[y2*dw+x2]=1;
            }
            x2=x2+1;
        }
        y2=y2+1;
    }
    let edge_density:f64=ecount as f64/enc as f64;
    // orientation from connected strong-edge components: each component's principal
    // axis (pixel covariance, no trig) votes its pixel count into horizontal /
    // diagonal / vertical. A curved-but-diagonal structure (an S-ridge) votes
    // diagonal through its overall axis; a forest of trunks votes vertical by
    // consensus. Local gradient votes alone misread curves as axis-aligned.
    let edge_dom:i64=2;
    let cmp:*u8=_zag_malloc(dw*dh*8) as *u8;
    let clab:[]u8=cmp[0..dw*dh*8];
    let cli:i64=0;
    while(cli<dw*dh){put_i64(clab,cli*8,-1);cli=cli+1;}
    let stkp:*u8=_zag_malloc(dw*dh*8) as *u8;
    let cstack:[]u8=stkp[0..dw*dh*8];
    // top-8 components by size; 6 i64 fields each: n,sx,sy,sxx,syy,sxy
    let t8p:*u8=_zag_malloc(8*48) as *u8;
    let top8:[]u8=t8p[0..8*48];
    let t8i:i64=0;
    while(t8i<8*48){top8[t8i]=0;t8i=t8i+1;}
    let cyy:i64=0;
    while(cyy<dh){
        let cxx:i64=0;
        while(cxx<dw){
            let seed:i64=cyy*dw+cxx;
            if(smask[seed]==1){
                if(get_i64(clab,seed*8)<0){
                    // flood fill, mark-at-push: every push site guards+marks, no pop-side check
                    let cn:i64=0;
                    let csx:i64=0;let csy:i64=0;
                    let csxx:i64=0;let csyy:i64=0;let csxy:i64=0;
                    let csp:i64=0;
                    put_i64(clab,seed*8,0);
                    put_i64(cstack,0,seed);
                    csp=1;
                    while(csp>0){
                        csp=csp-1;
                        let cqq:i64=get_i64(cstack,csp*8);
                        let cqx:i64=cqq-(cqq/dw)*dw;
                        let cqy:i64=cqq/dw;
                        cn=cn+1;
                        csx=csx+cqx;csy=csy+cqy;
                        csxx=csxx+cqx*cqx;csyy=csyy+cqy*cqy;csxy=csxy+cqx*cqy;
                        let edy:i64=-1;
                        while(edy<=1){
                            let edx:i64=-1;
                            while(edx<=1){
                                let isc:i32=0;
                                if(edx==0){if(edy==0){isc=1;}}
                                if(isc==0){
                                    let enx:i64=cqx+edx;
                                    let eny:i64=cqy+edy;
                                    if(enx>=0){if(enx<dw){if(eny>=0){if(eny<dh){
                                        let enb:i64=eny*dw+enx;
                                        if(smask[enb]==1){
                                            if(get_i64(clab,enb*8)<0){
                                                put_i64(clab,enb*8,0);
                                                put_i64(cstack,csp*8,enb);
                                                csp=csp+1;
                                            }
                                        }
                                    }}}}
                                }
                                edx=edx+1;
                            }
                            edy=edy+1;
                        }
                    }
                    if(cn>=8){
                        let ins:i64=-1;
                        let tk:i64=0;
                        while(tk<8){
                            if(ins<0){
                                if(cn>get_i64(top8,tk*48)){ins=tk;}
                                if(ins<0){tk=tk+1;}
                                if(ins>=0){tk=8;}
                            }
                            if(ins>=0){tk=8;}
                        }
                        if(ins>=0){
                            let sh:i64=7;
                            while(sh>ins){
                                let sk2:i64=0;
                                while(sk2<6){
                                    put_i64(top8,sh*48+sk2*8,get_i64(top8,(sh-1)*48+sk2*8));
                                    sk2=sk2+1;
                                }
                                sh=sh-1;
                            }
                            put_i64(top8,ins*48,cn);
                            put_i64(top8,ins*48+8,csx);
                            put_i64(top8,ins*48+16,csy);
                            put_i64(top8,ins*48+24,csxx);
                            put_i64(top8,ins*48+32,csyy);
                            put_i64(top8,ins*48+40,csxy);
                        }
                    }
                }
            }
            cxx=cxx+1;
        }
        cyy=cyy+1;
    }
    let vote_h:i64=0;let vote_d:i64=0;let vote_v:i64=0;
    let tv:i64=0;
    while(tv<8){
        let tn:i64=get_i64(top8,tv*48);
        if(tn>=8){
            let tfn:f64=tn as f64;
            let tmx:f64=(get_i64(top8,tv*48+8) as f64)/tfn;
            let tmy:f64=(get_i64(top8,tv*48+16) as f64)/tfn;
            let tsxx:f64=(get_i64(top8,tv*48+24) as f64)/tfn-tmx*tmx;
            let tsyy:f64=(get_i64(top8,tv*48+32) as f64)/tfn-tmy*tmy;
            let tsxy:f64=(get_i64(top8,tv*48+40) as f64)/tfn-tmx*tmy;
            let ttr:f64=tsxx+tsyy;
            let tdet:f64=tsxx*tsyy-tsxy*tsxy;
            let tdisc:f64=ttr*ttr/4.0-tdet;
            if(tdisc<0.0){tdisc=0.0;}
            let tsq:f64=fsqrt(tdisc);
            let tl1:f64=ttr/2.0+tsq;
            let tl2:f64=ttr/2.0-tsq;
            if(tl2<0.000001){tl2=0.000001;}
            let aniso:f64=tl1/tl2;
            // skip near-circular blobs (no meaningful axis)
            if(aniso>=1.2){
                let tdd:f64=tsxx-tsyy;if(tdd<0.0){tdd=-tdd;}
                let ttf:f64=2.0*tsxy;if(ttf<0.0){ttf=-ttf;}
                // axis within 22.5 deg of an axis iff 2|sxy| < |sxx-syy|
                if(ttf<tdd){
                    if(tsxx>tsyy){vote_h=vote_h+tn;}
                    if(tsxx<=tsyy){vote_v=vote_v+tn;}
                }
                if(ttf>=tdd){vote_d=vote_d+tn;}
            }
        }
        tv=tv+1;
    }
    let vtot:i64=vote_h+vote_d+vote_v;
    if(vtot>0){
        if(vote_v*2>vtot){edge_dom=0;}
        if(vote_h*2>vtot){edge_dom=1;}
        if(vote_d*2>vtot){edge_dom=3;}
    }
    // regions: 8x6 cells, greedy color clustering (manhattan < 90)
    let rp:*u8=_zag_malloc(48*3*8) as *u8;
    let regs:[]u8=rp[0..48*3*8];
    let cp:*u8=_zag_malloc(48*8) as *u8;
    let counts:[]u8=cp[0..48*8];
    let ri:i64=0;
    while(ri<48*8){counts[ri]=0;ri=ri+1;}
    let nreg:i64=0;
    let cy:i64=0;
    while(cy<6){
        let cx:i64=0;
        while(cx<8){
            let x0:i64=cx*w/8;let x1:i64=(cx+1)*w/8;
            let y0:i64=cy*h/6;let y1:i64=(cy+1)*h/6;
            let cr:i64=0;let cg:i64=0;let cb:i64=0;let cn:i64=0;
            let yy:i64=y0;
            while(yy<y1){
                let xx:i64=x0;
                while(xx<x1){
                    let o3:i64=hoff+(yy*w+xx)*3;
                    cr=cr+(b[o3] as i64);cg=cg+(b[o3+1] as i64);cb=cb+(b[o3+2] as i64);
                    cn=cn+1;xx=xx+1;
                }
                yy=yy+1;
            }
            if(cn>0){cr=cr/cn;cg=cg/cn;cb=cb/cn;}
            let found:i64=-1;
            let r2:i64=0;
            while(r2<nreg){
                let dr:i64=get_i64(regs,r2*24)-cr;if(dr<0){dr=-dr;}
                let dg:i64=get_i64(regs,r2*24+8)-cg;if(dg<0){dg=-dg;}
                let db:i64=get_i64(regs,r2*24+16)-cb;if(db<0){db=-db;}
                if(dr+dg+db<90){found=r2;r2=nreg;}
                if(found<0){r2=r2+1;}
            }
            if(found>=0){
                put_i64(counts,found*8,get_i64(counts,found*8)+1);
            }
            if(found<0){
                put_i64(regs,nreg*24,cr);
                put_i64(regs,nreg*24+8,cg);
                put_i64(regs,nreg*24+16,cb);
                put_i64(counts,nreg*8,1);
                nreg=nreg+1;
            }
            cx=cx+1;
        }
        cy=cy+1;
    }
    let maxreg:i64=0;
    let r3:i64=0;
    while(r3<nreg){
        let cc2:i64=get_i64(counts,r3*8);
        if(cc2>maxreg){maxreg=cc2;}
        r3=r3+1;
    }
    let reg_frac:f64=maxreg as f64/48.0;
    // symmetry on g
    let slr:f64=0.0;
    let yy2:i64=0;
    while(yy2<dh){
        let xx2:i64=0;
        while(xx2<dw/2){
            let d:i64=(g[yy2*dw+xx2] as i64)-(g[yy2*dw+dw-1-xx2] as i64);
            if(d<0){d=-d;}
            slr=slr+d as f64;
            xx2=xx2+1;
        }
        yy2=yy2+1;
    }
    slr=slr/(dh as f64*(dw/2) as f64*255.0);
    let stb:f64=0.0;
    let yy3:i64=0;
    while(yy3<dh/2){
        let xx3:i64=0;
        while(xx3<dw){
            let d2:i64=(g[yy3*dw+xx3] as i64)-(g[(dh-1-yy3)*dw+xx3] as i64);
            if(d2<0){d2=-d2;}
            stb=stb+d2 as f64;
            xx3=xx3+1;
        }
        yy3=yy3+1;
    }
    stb=stb/((dh/2) as f64*dw as f64*255.0);
    // texture: 15x10 cells of 8x8 on g, variance per cell
    let tp:*u8=_zag_malloc(150*8) as *u8;
    let tvar:[]u8=tp[0..150*8];
    let td:*u8=_zag_malloc(150*8) as *u8;
    let tvd:[]u8=td[0..150*8];
    let tc:i64=0;
    let ty:i64=0;
    while(ty<10){
        let tx:i64=0;
        while(tx<15){
            let m0:i64=0;let c0:i64=0;
            let oy:i64=0;
            while(oy<8){
                let ox:i64=0;
                while(ox<8){
                    m0=m0+(g[(ty*8+oy)*dw+tx*8+ox] as i64);
                    c0=c0+1;
                    ox=ox+1;
                }
                oy=oy+1;
            }
            let mn2:i64=0;
            if(c0>0){mn2=m0/c0;}
            let vv2:i64=0;
            let oy2:i64=0;
            while(oy2<8){
                let ox2:i64=0;
                while(ox2<8){
                    let dd:i64=(g[(ty*8+oy2)*dw+tx*8+ox2] as i64)-mn2;
                    vv2=vv2+dd*dd;
                    ox2=ox2+1;
                }
                oy2=oy2+1;
            }
            if(c0>0){vv2=vv2/c0;}
            put_i64(tvar,tc*8,vv2);
            tc=tc+1;
            tx=tx+1;
        }
        ty=ty+1;
    }
    isort_copy(tvar,tvd,150);
    let tmed:i64=median_sorted(tvd,150);
    let tcount:i64=0;
    let t5:i64=0;
    while(t5<150){
        if(get_i64(tvar,t5*8)>2*tmed){tcount=tcount+1;}
        t5=t5+1;
    }
    let tex_frac:f64=tcount as f64/150.0;
    // native-resolution texture: 8x8 cells on the full-res gray image, BEFORE any
    // downsampling. Fraction of cells with variance > 100 (std > 10 gray levels).
    // The downsampled relative measure alone lets genuinely textured images
    // (forest bark/grass) pass as "smooth"; the native absolute measure does not.
    let tex_native_frac:f64=0.0;
    let nctx:i64=w/8;
    let ncty:i64=h/8;
    if(nctx>0){
        if(ncty>0){
            let ntc:i64=nctx*ncty;
            let nhi:i64=0;
            let ncy2:i64=0;
            while(ncy2<ncty){
                let ncx2:i64=0;
                while(ncx2<nctx){
                    let nm0:i64=0;
                    let noy:i64=0;
                    while(noy<8){
                        let nox:i64=0;
                        while(nox<8){
                            nm0=nm0+(gn[(ncy2*8+noy)*w+ncx2*8+nox] as i64);
                            nox=nox+1;
                        }
                        noy=noy+1;
                    }
                    let nmn:i64=nm0/64;
                    let nvv:i64=0;
                    let noy2:i64=0;
                    while(noy2<8){
                        let nox2:i64=0;
                        while(nox2<8){
                            let ndd:i64=(gn[(ncy2*8+noy2)*w+ncx2*8+nox2] as i64)-nmn;
                            nvv=nvv+ndd*ndd;
                            nox2=nox2+1;
                        }
                        noy2=noy2+1;
                    }
                    nvv=nvv/64;
                    if(nvv>100){nhi=nhi+1;}
                    ncx2=ncx2+1;
                }
                ncy2=ncy2+1;
            }
            tex_native_frac=nhi as f64/ntc as f64;
        }
    }
    // brightness centroid
    let sxg:f64=0.0;let syg:f64=0.0;let sg2:f64=0.0;
    let gy3:i64=0;
    while(gy3<dh){
        let gx3:i64=0;
        while(gx3<dw){
            let bv2:f64=(g[gy3*dw+gx3] as f64);
            sxg=sxg+gx3 as f64*bv2;
            syg=syg+gy3 as f64*bv2;
            sg2=sg2+bv2;
            gx3=gx3+1;
        }
        gy3=gy3+1;
    }
    let cxr:f64=0.5;let cyr:f64=0.5;
    if(sg2>0.0){cxr=sxg/sg2/dw as f64;cyr=syg/sg2/dh as f64;}

    // ---- MEASURE ----
    pln("MEASURE_BEGIN");
    pstr("w ");pi(w);pln("");
    pstr("h ");pi(h);pln("");
    pstr("mean_r_milli ");pf3((sr as f64)/nf);pln("");
    pstr("mean_g_milli ");pf3((sg as f64)/nf);pln("");
    pstr("mean_b_milli ");pf3((sb as f64)/nf);pln("");
    pstr("bright_mean_milli ");pf3(br_mean);pln("");
    pstr("bright_std_milli ");pf3(br_std);pln("");
    pstr("sat_mean_milli ");pf3((ssat as f64)/nf);pln("");
    pstr("edge_density_milli ");pf3(edge_density);pln("");
    pstr("edge_dom ");pi(edge_dom);pln("");
    pstr("n_regions ");pi(nreg);pln("");
    pstr("region_max_frac_milli ");pf3(reg_frac);pln("");
    pstr("sym_lr_milli ");pf3(slr);pln("");
    pstr("sym_tb_milli ");pf3(stb);pln("");
    pstr("texture_frac_milli ");pf3(tex_frac);pln("");
    pstr("texture_native_frac_milli ");pf3(tex_native_frac);pln("");
    pstr("centroid_x_milli ");pf3(cxr);pln("");
    pstr("centroid_y_milli ");pf3(cyr);pln("");
    pln("MEASURE_END");

    // ---- DESCRIBE ----
    pln("DESCRIBE_BEGIN");
    if(br_mean<70.0){pstr("TONE dark image overall. ");pln("");}
    if(br_mean>180.0){pstr("TONE bright image overall. ");pln("");}
    if(br_mean>=70.0){if(br_mean<=180.0){pstr("TONE mid-tone image overall. ");pln("");}}
    if(br_std>60.0){pstr("TONE high contrast between light and dark areas. ");pln("");}
    if(br_std<25.0){pstr("TONE flat, low-contrast tonal range. ");pln("");}
    if((ssat as f64)/nf>60.0){pstr("COLOR vivid, strongly saturated colors. ");pln("");}
    if((ssat as f64)/nf<25.0){pstr("COLOR muted, near-monochrome palette. ");pln("");}
    pstr("REGIONS ");pi(nreg);pstr(" distinct color regions; the largest covers about ");
    pi((reg_frac*100.0) as i64);pstr(" percent of the frame. ");pln("");
    if(edge_density>0.12){pstr("EDGES dense edge structure across the frame. ");pln("");}
    if(edge_density<0.04){pstr("EDGES sparse: mostly smooth areas with few strong boundaries. ");pln("");}
    if(edge_dom==0){pstr("EDGES run mostly vertical. ");pln("");}
    if(edge_dom==1){pstr("EDGES run mostly horizontal. ");pln("");}
    if(edge_dom==3){pstr("EDGES run mostly diagonal. ");pln("");}
    if(edge_dom==2){pstr("EDGES run in mixed/diagonal directions, no single dominant orientation. ");pln("");}
    if(tex_native_frac>0.5){pstr("TEXTURE fine-grained texture across most of the frame. ");pln("");}
    if(tex_native_frac<0.15){if(tex_frac<0.2){pstr("TEXTURE mostly smooth surfaces, little fine detail. ");pln("");}}
    if(slr<0.08){pstr("LAYOUT left-right mirror symmetric. ");pln("");}
    if(slr>0.2){pstr("LAYOUT left and right halves differ strongly (asymmetric). ");pln("");}
    if(stb<0.08){pstr("LAYOUT top-bottom mirror symmetric. ");pln("");}
    if(stb>0.2){pstr("LAYOUT top and bottom halves differ strongly. ");pln("");}
    pstr("LAYOUT visual mass centered ");
    if(cxr<0.4){pstr("toward the left");}
    if(cxr>0.6){pstr("toward the right");}
    if(cxr>=0.4){if(cxr<=0.6){pstr("horizontally");}}
    pstr(" and ");
    if(cyr<0.4){pstr("toward the top");}
    if(cyr>0.6){pstr("toward the bottom");}
    if(cyr>=0.4){if(cyr<=0.6){pstr("vertically centered");}}
    pstr(". ");pln("");
    pln("DESCRIBE_END");
    return 0;
}

// ---------------- VIDEO ----------------
fn analyze_video(prefix:[]u8,count:i64)i32 {
    let dw:i64=80;let dh:i64=45;
    let pb:*u8=_zag_malloc(512) as *u8;
    let pbuf:[]u8=pb[0..512];
    let pa:*u8=_zag_malloc(dw*dh) as *u8;
    let ga:[]u8=pa[0..dw*dh];
    let qb:*u8=_zag_malloc(dw*dh) as *u8;
    let gb:[]u8=qb[0..dw*dh];
    let brp:*u8=_zag_malloc(count*8) as *u8;
    let bra:[]u8=brp[0..count*8];
    let dfp:*u8=_zag_malloc(count*8) as *u8;
    let dfa:[]u8=dfp[0..count*8];
    let vxp:*u8=_zag_malloc(count*8) as *u8;
    let vxa:[]u8=vxp[0..count*8];
    let vyp:*u8=_zag_malloc(count*8) as *u8;
    let vya:[]u8=vyp[0..count*8];
    let vnp:*u8=_zag_malloc(count*8) as *u8;
    let vna:[]u8=vnp[0..count*8];
    let outp:*u8=_zag_malloc(32) as *u8;
    let pout:[]u8=outp[0..32];
    let n_cuts:i64=0;
    let ml:i64=0;let mr:i64=0;let mt:i64=0;let mb:i64=0;
    let f:i64=1;
    while(f<=count){
        // build path: prefix + f_NNN.ppm
        let pl:i64=0;
        while(pl<prefix.len){pbuf[pl]=prefix[pl];pl=pl+1;}
        pbuf[pl]=102;pl=pl+1;
        pbuf[pl]=95;pl=pl+1;
        let d1:i64=f/100;
        let d2:i64=f/10-10*d1;
        let d3:i64=f-10*(f/10);
        pbuf[pl]=(d1+48) as u8;pl=pl+1;
        pbuf[pl]=(d2+48) as u8;pl=pl+1;
        pbuf[pl]=(d3+48) as u8;pl=pl+1;
        pbuf[pl]=46;pl=pl+1;
        pbuf[pl]=112;pl=pl+1;
        pbuf[pl]=112;pl=pl+1;
        pbuf[pl]=109;pl=pl+1;
        let ps:[]u8=pbuf[0..pl];
        let b:[]u8=read_all(ps);
        if(parse_ppm(b,pout)==0){pln("ERR frame not PPM");return 1;}
        let w:i64=get_i64(pout,0);
        let h:i64=get_i64(pout,8);
        let hoff:i64=get_i64(pout,16);
        if(w<dw){pln("ERR frame too small");return 1;}
        if(h<dh){pln("ERR frame too small");return 1;}
        // downsample to dw x dh grayscale into gb
        let sbr3:i64=0;
        let dy:i64=0;
        while(dy<dh){
            let dx:i64=0;
            while(dx<dw){
                let sx0:i64=dx*w/dw;
                let sx1:i64=(dx+1)*w/dw;
                let sy0:i64=dy*h/dh;
                let sy1:i64=(dy+1)*h/dh;
                let acc:i64=0;let cnt:i64=0;
                let sy:i64=sy0;
                while(sy<sy1){
                    let sx:i64=sx0;
                    while(sx<sx1){
                        let o:i64=hoff+(sy*w+sx)*3;
                        acc=acc+(299*(b[o] as i64)+587*(b[o+1] as i64)+114*(b[o+2] as i64))/1000;
                        cnt=cnt+1;
                        sx=sx+1;
                    }
                    sy=sy+1;
                }
                let vv:i64=0;
                if(cnt>0){vv=acc/cnt;}
                gb[dy*dw+dx]=vv as u8;
                sbr3=sbr3+vv;
                dx=dx+1;
            }
            dy=dy+1;
        }
        put_i64(bra,(f-1)*8,(sbr3*1000)/(dw*dh));
        if(f>1){
            // frame difference
            let dc2:i64=0;
            let q:i64=0;
            while(q<dw*dh){
                let dd:i64=(gb[q] as i64)-(ga[q] as i64);
                if(dd<0){dd=-dd;}
                if(dd>20){dc2=dc2+1;}
                q=q+1;
            }
            let dfr:f64=(dc2 as f64)/(dw*dh) as f64;
            put_i64(dfa,(f-2)*8,(dfr*1000.0) as i64);
            if(dfr>0.45){n_cuts=n_cuts+1;}
            // block motion: 8x4 grid, blocks 10x11, search +-6
            let mxp:*u8=_zag_malloc(32*8) as *u8;
            let mxa:[]u8=mxp[0..32*8];
            let myp:*u8=_zag_malloc(32*8) as *u8;
            let mya:[]u8=myp[0..32*8];
            let nv:i64=0;
            let by:i64=0;
            while(by<4){
                let bx:i64=0;
                while(bx<8){
                    let x0:i64=bx*10;
                    let y0:i64=by*11;
                    if(x0>=6){if(x0<=63){if(y0>=6){if(y0<=27){
                        // texture check on ga block
                        let bm:i64=0;
                        let oy:i64=0;
                        while(oy<11){
                            let ox:i64=0;
                            while(ox<10){
                                bm=bm+(ga[(y0+oy)*dw+x0+ox] as i64);
                                ox=ox+1;
                            }
                            oy=oy+1;
                        }
                        bm=bm/110;
                        let bvv:i64=0;
                        let oy2:i64=0;
                        while(oy2<11){
                            let ox2:i64=0;
                            while(ox2<10){
                                let ddv:i64=(ga[(y0+oy2)*dw+x0+ox2] as i64)-bm;
                                bvv=bvv+ddv*ddv;
                                ox2=ox2+1;
                            }
                            oy2=oy2+1;
                        }
                        bvv=bvv/110;
                        if(bvv>150){
                            // SAD at (0,0)
                            let sad0:i64=0;
                            let qy:i64=0;
                            while(qy<11){
                                let qx:i64=0;
                                while(qx<10){
                                    let ddd:i64=(ga[(y0+qy)*dw+x0+qx] as i64)-(gb[(y0+qy)*dw+x0+qx] as i64);
                                    if(ddd<0){ddd=-ddd;}
                                    sad0=sad0+ddd;
                                    qx=qx+1;
                                }
                                qy=qy+1;
                            }
                            let bdx:i64=0;let bdy:i64=0;
                            let bsad:i64=sad0;
                            let sdy:i64=-6;
                            while(sdy<=6){
                                let sdx:i64=-6;
                                while(sdx<=6){
                                    let s2:i64=0;
                                    let ry:i64=0;
                                    while(ry<11){
                                        let rx:i64=0;
                                        while(rx<10){
                                            let d4:i64=(ga[(y0+ry)*dw+x0+rx] as i64)-(gb[(y0+ry+sdy)*dw+x0+rx+sdx] as i64);
                                            if(d4<0){d4=-d4;}
                                            s2=s2+d4;
                                            rx=rx+1;
                                        }
                                        ry=ry+1;
                                    }
                                    if(s2<bsad){bsad=s2;bdx=sdx;bdy=sdy;}
                                    sdx=sdx+1;
                                }
                                sdy=sdy+1;
                            }
                            if(bsad*100<65*sad0){
                                if(sad0>0){
                                    put_i64(mxa,nv*8,bdx*1000);
                                    put_i64(mya,nv*8,bdy*1000);
                                    nv=nv+1;
                                    if(bx<4){ml=ml+1;}
                                    if(bx>=4){mr=mr+1;}
                                    if(by<2){mt=mt+1;}
                                    if(by>=2){mb=mb+1;}
                                }
                            }
                        }
                    }}}}
                    bx=bx+1;
                }
                by=by+1;
            }
            // median vector of this pair
            let mdx:i64=0;let mdy:i64=0;
            if(nv>0){
                let sxp:*u8=_zag_malloc(nv*8) as *u8;
                let sxa:[]u8=sxp[0..nv*8];
                let syp:*u8=_zag_malloc(nv*8) as *u8;
                let sya:[]u8=syp[0..nv*8];
                isort_copy(mxa,sxa,nv);
                isort_copy(mya,sya,nv);
                mdx=median_sorted(sxa,nv);
                mdy=median_sorted(sya,nv);
            }
            put_i64(vxa,(f-2)*8,mdx);
            put_i64(vya,(f-2)*8,mdy);
            put_i64(vna,(f-2)*8,nv);
            // copy gb -> ga
            let cq:i64=0;
            while(cq<dw*dh){ga[cq]=gb[cq];cq=cq+1;}
        }
        if(f==1){
            let cq2:i64=0;
            while(cq2<dw*dh){ga[cq2]=gb[cq2];cq2=cq2+1;}
        }
        f=f+1;
    }
    let npair:i64=count-1;
    // aggregate
    let df_mean:f64=0.0;let df_max:f64=0.0;
    let sx_sum:f64=0.0;let sy_sum:f64=0.0;
    let vf_sum:i64=0;
    let k:i64=0;
    while(k<npair){
        let dfv:f64=(get_i64(dfa,k*8) as f64)/1000.0;
        df_mean=df_mean+dfv;
        if(dfv>df_max){df_max=dfv;}
        sx_sum=sx_sum+(get_i64(vxa,k*8) as f64)/1000.0;
        sy_sum=sy_sum+(get_i64(vya,k*8) as f64)/1000.0;
        vf_sum=vf_sum+get_i64(vna,k*8);
        k=k+1;
    }
    if(npair>0){
        df_mean=df_mean/(npair as f64);
        sx_sum=sx_sum/(npair as f64);
        sy_sum=sy_sum/(npair as f64);
    }
    let vf_frac:f64=0.0;
    if(npair>0){vf_frac=(vf_sum as f64)/(npair as f64)/12.0;}
    // brightness trend
    let b1:f64=0.0;let b3:f64=0.0;
    let n3:i64=count/3;
    if(n3<1){n3=1;}
    let t1:i64=0;
    while(t1<n3){b1=b1+(get_i64(bra,t1*8) as f64);t1=t1+1;}
    b1=b1/(n3 as f64)/1000.0;
    let t2:i64=0;
    while(t2<n3){b3=b3+(get_i64(bra,(count-n3+t2)*8) as f64);t2=t2+1;}
    b3=b3/(n3 as f64)/1000.0;
    let speed:f64=fsqrt(sx_sum*sx_sum+sy_sum*sy_sum)*2.0;

    pln("MEASURE_BEGIN");
    pstr("n_frames ");pi(count);pln("");
    pstr("fps_milli ");pi(2000);pln("");
    pstr("bright_first_milli ");pf3(b1);pln("");
    pstr("bright_last_milli ");pf3(b3);pln("");
    pstr("diff_mean_milli ");pf3(df_mean);pln("");
    pstr("diff_max_milli ");pf3(df_max);pln("");
    pstr("n_cuts ");pi(n_cuts);pln("");
    pstr("mean_dx_mfp ");pf3(sx_sum);pln("");
    pstr("mean_dy_mfp ");pf3(sy_sum);pln("");
    pstr("speed_pxs_milli ");pf3(speed);pln("");
    pstr("valid_frac_milli ");pf3(vf_frac);pln("");
    pstr("motion_left ");pi(ml);pln("");
    pstr("motion_right ");pi(mr);pln("");
    pstr("motion_top ");pi(mt);pln("");
    pstr("motion_bottom ");pi(mb);pln("");
    pln("MEASURE_END");

    pln("DESCRIBE_BEGIN");
    pstr("DURATION ");pi(count);pstr(" frames at 2 fps (~");pi(count/2);pstr(" seconds). ");pln("");
    let mag:f64=fsqrt(sx_sum*sx_sum+sy_sum*sy_sum);
    if(mag<0.75){
        pstr("MOTION little consistent frame-to-frame motion; the scene is near-static or changes chaotically. ");pln("");
    }
    if(mag>=0.75){
        pstr("MOTION consistent motion across frames, average shift about ");
        pf3(mag);pstr(" px/frame at 80x45 analysis resolution (~");
        pf3(speed);pstr(" px/s), heading ");
        let ax2:f64=sx_sum;if(ax2<0.0){ax2=-ax2;}
        let ay2:f64=sy_sum;if(ay2<0.0){ay2=-ay2;}
        if(ax2>2.0*ay2){
            if(sx_sum>0.0){pstr("rightward");}
            if(sx_sum<=0.0){pstr("leftward");}
        }
        if(ay2>2.0*ax2){
            if(sy_sum>0.0){pstr("downward");}
            if(sy_sum<=0.0){pstr("upward");}
        }
        if(ax2<=2.0*ay2){if(ay2<=2.0*ax2){
            if(sx_sum>0.0){pstr("right");}
            if(sx_sum<=0.0){pstr("left");}
            if(sy_sum>0.0){pstr("-down");}
            if(sy_sum<=0.0){pstr("-up");}
            pstr(" diagonally");
        }}
        pstr(". ");pln("");
    }
    if(n_cuts==0){pstr("CUTS no abrupt scene cuts; one continuous shot. ");pln("");}
    if(n_cuts>0){pstr("CUTS ");pi(n_cuts);pstr(" abrupt scene cut(s). ");pln("");}
    let btrend:f64=0.0;
    if(b1>0.0){btrend=(b3-b1)/b1;}
    if(btrend>0.05){pstr("BRIGHTNESS the scene brightens over time. ");pln("");}
    if(btrend<-0.05){pstr("BRIGHTNESS the scene darkens over time. ");pln("");}
    if(btrend<=0.05){if(btrend>=-0.05){pstr("BRIGHTNESS stable overall brightness. ");pln("");}}
    if(df_mean>0.25){pstr("CHANGE strong frame-to-frame change: most of the frame is in motion. ");pln("");}
    if(df_mean<0.05){pstr("CHANGE frames change little from one to the next. ");pln("");}
    if(vf_frac>0.5){pstr("COVERAGE motion spans most of the frame. ");pln("");}
    if(vf_frac<0.15){pstr("COVERAGE motion is localized to small areas. ");pln("");}
    if(ml+mr+mt+mb>0){
        pstr("COVERAGE moving areas concentrate ");
        let lr:i32=0;
        if(ml>2*mr){pstr("on the left side");lr=1;}
        if(mr>2*ml){pstr("on the right side");lr=1;}
        if(mt>2*mb){if(lr==1){pstr(" and ");}pstr("toward the top");lr=1;}
        if(mb>2*mt){if(lr==1){pstr(" and ");}pstr("toward the bottom");lr=1;}
        if(lr==0){pstr("evenly across the frame");}
        pstr(". ");pln("");
    }
    pln("DESCRIBE_END");
    return 0;
}

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(m.len<1){pln("usage: uanalyze a|i|v ...");return 1;}
    let c:i64=(m[0] as i64);
    if(c==97){return analyze_audio(_zag_arg(2));}
    if(c==105){return analyze_image(_zag_arg(2));}
    if(c==118){
        let n:i64=parse_int(_zag_arg(3));
        if(n<2){pln("ERR need >=2 frames");return 1;}
        return analyze_video(_zag_arg(2),n);
    }
    pln("unknown mode");
    return 1;
}

// c1scout_channel.zag — KB4 C1-scout channel rule (PREREG_FROZEN_TCP.md §9).
// Frozen rule: INSTALL iff analytic judgment == J(stim) (frozen sense-A
// original judgment), else WITHHOLD. No truth input anywhere.
//
// Usage: c1scout_channel <analytic> <J>
// Prints:
//   verdict=INSTALL|WITHHOLD
// Exit 0 on success; nonzero + "error=<reason>" line on bad args.
// Zero RNG. Deterministic given inputs.

@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = 0;
    let pre:[]u8 = "error=";
    let i:i32 = 0;
    while(i < pre.len) { ob[pos] = pre[i]; pos = pos + 1; i = i + 1; }
    i = 0;
    while(i < reason.len) { ob[pos] = reason[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

fn main() i32 {
    let a:[]u8 = _zag_arg(1);
    let j:[]u8 = _zag_arg(2);
    if(a.len == 0) { return fail("no_analytic"); }
    if(j.len == 0) { return fail("no_j"); }
    // Domain check: both must be one of SAME|HIGHER|LOWER.
    let ok:i32 = 0;
    if(_zag_strcmp(a, "SAME") == 1) { ok = 1; }
    if(_zag_strcmp(a, "HIGHER") == 1) { ok = 1; }
    if(_zag_strcmp(a, "LOWER") == 1) { ok = 1; }
    if(_zag_strcmp(j, "SAME") == 1) { ok = ok + 1; }
    if(_zag_strcmp(j, "HIGHER") == 1) { ok = ok + 1; }
    if(_zag_strcmp(j, "LOWER") == 1) { ok = ok + 1; }
    if(ok != 2) { return fail("bad_domain"); }
    let v:[]u8 = "WITHHOLD";
    if(_zag_strcmp(a, j) == 1) { v = "INSTALL"; }
    let ob:[]u8 = nio_alloc(32);
    if(ob.len == 0) { return fail("alloc_failed"); }
    let pos:i32 = 0;
    let l:[]u8 = "verdict=";
    let i:i32 = 0;
    while(i < l.len) { ob[pos] = l[i]; pos = pos + 1; i = i + 1; }
    i = 0;
    while(i < v.len) { ob[pos] = v[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 0;
}

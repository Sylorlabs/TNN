// c3_noise.zag — frozen C3 noise instrument (PREREG_FROZEN_TCP.md §9).
// Honest re-observation-under-noise: deterministic pseudo-noise added to the
// adversarial fixture BYTES; the frozen sense binary is re-run on the noised
// bytes. Noise model mirrors the harness gen_noise (harness/gen.py):
//   .pcm int16 samples: delta uniform in [-300, +300], clamp [-32768, 32767]
//   .img/.vid payload bytes: delta uniform in [-8, +8], clamp [0, 255]
//   headers preserved verbatim (8 / 8 / 12 bytes for img / pcm / vid).
// Stream: splitmix64, MASTER seed 20260922, stream = 900 + task_idx
//   (task_idx: colordisc 0, colorconst 1, shapetrans 2, pitchdisc 3,
//    timbredisc 4, motiondir 5). Initial state = harness stream_seed
//   (master, stream, index=0): h = sm(master ^ (stream*INC)); s0 = sm(h).
//   One draw per payload element in file order (per sample for .pcm, per
//   payload byte for .img/.vid). The stream resets per fixture (frozen).
// Zero RNG. 2x runs byte-identical.
//
// Usage: c3_noise <task> <in-fixture> <out-path>
// Exit 0 on success (silent); nonzero + "error=<reason>" line on failure.
//
// Build (from kb/autopsy/channels2/):
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1 \
//     src/c3_noise.zag --no-zagd --no-analyze --no-foreground-cache \
//     -o src/c3_noise
//
// znc codegen workarounds (this build; verified by draw-by-draw probes
// against the harness's Python splitmix64, 2026-09-22):
//  W1. u64 `>>` is an ARITHMETIC shift (sign-extends when bit63 set).
//      lshr30/27/31/32 correct it via a top-bits mask.
//  W2. u64 `%` is a SIGNED remainder (wrong when dividend bit63 set).
//      draw_below reduces via 32-bit halves with i64 mods on
//      non-negative values only.
//  W3. Decimal u64 literals > i64max MUST be let-bound before use in `*`
//      (inline literal*var miscompiles). All three constants verified
//      digit-by-digit against hex: INC=0x9E3779B97F4A7C15,
//      C1=0xBF58476D1CE4E5B9, C2=0x94D049BB133111EB.
//  W4. `(n % m)`-style expressions must be hoisted to a let before use in
//      `_zag_i64_to_str`/print args (inline-nested mod miscompiled on some
//      loop iterations in probes); draw_below returns a plain i64.

@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- logical right shifts (W1) -------------------------------
fn lshr30(v:u64) u64 {
    let a:u64 = v >> 30;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 34); }
    return a;
}
fn lshr27(v:u64) u64 {
    let a:u64 = v >> 27;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 37); }
    return a;
}
fn lshr31(v:u64) u64 {
    let a:u64 = v >> 31;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 33); }
    return a;
}
fn lshr32(v:u64) u64 {
    let a:u64 = v >> 32;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 32); }
    return a;
}

// ---------------- splitmix64 (harness gen.py semantics) --------------------
fn sm_draw(st:*u64) u64 {
    let inc:u64 = 11400714819323198485;
    let c1:u64 = 13787848793156543929;
    let c2:u64 = 10723151780598845931;
    st.* = st.* + inc;
    let z:u64 = st.*;
    let t1:u64 = z ^ lshr30(z);
    let m1:u64 = t1 * c1;
    let t2:u64 = m1 ^ lshr27(m1);
    let m2:u64 = t2 * c2;
    return m2 ^ lshr31(m2);
}

// one stateless splitmix64 application (gen.py splitmix64)
fn sm_step(x:u64) u64 {
    let inc:u64 = 11400714819323198485;
    let c1:u64 = 13787848793156543929;
    let c2:u64 = 10723151780598845931;
    let s:u64 = x + inc;
    let t1:u64 = s ^ lshr30(s);
    let m1:u64 = t1 * c1;
    let t2:u64 = m1 ^ lshr27(m1);
    let m2:u64 = t2 * c2;
    return m2 ^ lshr31(m2);
}

// harness stream_seed(master, stream, index=0)
fn sm_seed(master:u64, stream:u64) u64 {
    let inc:u64 = 11400714819323198485;
    let h:u64 = sm_step(master ^ (stream * inc));
    return sm_step(h);
}

// uniform integer in [0, m) from one draw; avoids broken u64 % (W2)
fn draw_below(st:*u64, m:i64) i64 {
    let n:u64 = sm_draw(st);
    let hi:u64 = lshr32(n);
    let lo:u64 = n & 4294967295;
    let c:i64 = 4294967296 % m;
    let hm:i64 = (hi as i64) % m;
    let lm:i64 = (lo as i64) % m;
    let r:i64 = (hm * c + lm) % m;
    return r;
}

// ---------------- little-endian accessors --------------------------------
fn g32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn read_whole(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

// O_WRONLY(1)|O_CREAT(64)|O_TRUNC(512)=577, mode 0644=438. No O_EXCL.
fn write_whole(path:[]u8, buf:[]u8, n:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7501; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 438, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7502; }
    let w:i64 = nio_write_all(fd, buf[0..n]);
    nio_close(fd);
    return w;
}

fn copy_hdr(inp:[]u8, out:[]u8, n:i32) void {
    let i:i32 = 0;
    while(i < n) { out[i] = inp[i]; i = i + 1; }
}

fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = 0;
    let pre:[]u8 = "error=";
    let i:i32 = 0;
    while(i < pre.len) { ob[pos] = pre[i]; pos = pos + 1; i = i + 1; }
    i = 0;
    while(i < reason.len) { ob[pos] = reason[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

// ---------------- noise: .img payload bytes, delta in [-8, 8] --------------
fn n_img(inp:[]u8, out:[]u8, n:i32, st:*u64) i32 {
    let w:i64 = g32(inp, 0);
    let h:i64 = g32(inp, 4);
    if(w < 1 || h < 1) { return -1; }
    if(w > 4096 || h > 4096) { return -1; }
    let want:i64 = 8 + w * h * 3;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let i:i64 = 8;
    while(i < (n as i64)) {
        let d:i64 = draw_below(st, 17) - 8;
        let v:i64 = (inp[i as i32] as i64) + d;
        if(v < 0) { v = 0; }
        if(v > 255) { v = 255; }
        out[i as i32] = v as u8;
        i = i + 1;
    }
    return 0;
}

// ---------------- noise: .pcm int16 samples, delta in [-300, 300] ----------
fn n_pcm(inp:[]u8, out:[]u8, n:i32, st:*u64) i32 {
    let count:i64 = g32(inp, 4);
    if(count < 1) { return -1; }
    if(count > 4000000) { return -1; }
    let want:i64 = 8 + count * 2;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let i:i64 = 0;
    while(i < count) {
        let at:i64 = 8 + i * 2;
        let lo:i64 = inp[at as i32] as i64;
        let hix:i64 = inp[(at + 1) as i32] as i64;
        let sv:i64 = lo | (hix << 8);
        if(sv >= 32768) { sv = sv - 65536; }
        let d:i64 = draw_below(st, 601) - 300;
        sv = sv + d;
        if(sv < -32768) { sv = -32768; }
        if(sv > 32767) { sv = 32767; }
        let uv:i64 = sv;
        if(uv < 0) { uv = uv + 65536; }
        out[at as i32] = (uv & 255) as u8;
        out[(at + 1) as i32] = ((uv >> 8) & 255) as u8;
        i = i + 1;
    }
    return 0;
}

// ---------------- noise: .vid payload bytes, delta in [-8, 8] --------------
fn n_vid(inp:[]u8, out:[]u8, n:i32, st:*u64) i32 {
    let f:i64 = g32(inp, 0);
    let w:i64 = g32(inp, 4);
    let h:i64 = g32(inp, 8);
    if(f < 1 || w < 1 || h < 1) { return -1; }
    if(f > 64 || w > 4096 || h > 4096) { return -1; }
    let fsz:i64 = w * h * 3;
    let want:i64 = 12 + f * fsz;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 12);
    let i:i64 = 12;
    while(i < (n as i64)) {
        let d:i64 = draw_below(st, 17) - 8;
        let v:i64 = (inp[i as i32] as i64) + d;
        if(v < 0) { v = 0; }
        if(v > 255) { v = 255; }
        out[i as i32] = v as u8;
        i = i + 1;
    }
    return 0;
}

fn task_idx(t:[]u8) i32 {
    if(_zag_strcmp(t, "colordisc") == 1) { return 0; }
    if(_zag_strcmp(t, "colorconst") == 1) { return 1; }
    if(_zag_strcmp(t, "shapetrans") == 1) { return 2; }
    if(_zag_strcmp(t, "pitchdisc") == 1) { return 3; }
    if(_zag_strcmp(t, "timbredisc") == 1) { return 4; }
    if(_zag_strcmp(t, "motiondir") == 1) { return 5; }
    return -1;
}

// ---------------- main -------------------------------------------------------
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    if(a1.len == 0) { return fail("no_task"); }
    if(a2.len == 0) { return fail("no_input"); }
    if(a3.len == 0) { return fail("no_output"); }
    let ti:i32 = task_idx(a1);
    if(ti < 0) { return fail("bad_task"); }
    let kind:i32 = 0;
    if(ti <= 2) { kind = 1; }
    if(ti == 3 || ti == 4) { kind = 2; }
    if(ti == 5) { kind = 3; }
    let inp:[]u8 = nio_alloc(4194304);
    let out:[]u8 = nio_alloc(4194304);
    if(inp.len == 0) { return fail("alloc_failed"); }
    if(out.len == 0) { return fail("alloc_failed"); }
    let n:i64 = read_whole(a2, inp, 4194304);
    if(n < 12) { return fail("read_failed"); }
    let s:u64 = sm_seed(20260922, 900 + (ti as u64));
    let rc:i32 = -9;
    if(kind == 1) { rc = n_img(inp, out, n as i32, &s); }
    if(kind == 2) { rc = n_pcm(inp, out, n as i32, &s); }
    if(kind == 3) { rc = n_vid(inp, out, n as i32, &s); }
    if(rc != 0) { return fail("noise_failed"); }
    let w:i64 = write_whole(a3, out, n as i32);
    if(w != n) { return fail("write_failed"); }
    return 0;
}

// c1scout_pitch.zag — KB4 C1-scout stimulus-analytic probe (PREREG_FROZEN_TCP.md §9).
// Task: pitchdisc ONLY. Pure-Zag zero-crossing pitch estimation on .pcm bytes.
//
// Fixture layout (INTERFACE.md, frozen gen_t4): u32 LE sample_rate,
// u32 LE sample_count, then count int16 LE samples. Two 0.4s tones
// (f0, f1) with a 0.08s gap; symmetric 20ms raised-cosine ramps.
// Analytic judgment = SAME iff |f1-f0|/f0 < 0.005 else HIGHER iff f1>f0
// else LOWER. This mirrors the generator's public rule exactly.
//
// Method: estimate f0/f1 by zero-crossing pitch on the middle 0.3s of each
// tone (avoids ramps), with linear-interpolation sub-sample crossing times.
// The generator's tone is sin(wt)+0.3 sin(2wt)+0.15 sin(3wt): all harmonics
// vanish exactly at the fundamental's zero crossings, so mean zero-crossing
// pitch is unbiased for this fixture family (quantization jitter ~1e-4
// sample per crossing averages down over ~130-400 crossings).
//
// Usage: c1scout_pitch <in.pcm>
// Prints:
//   f0_mhz=<int>
//   f1_mhz=<int>
//   judgment=SAME|HIGHER|LOWER
// Exit 0 on success; nonzero + "error=<reason>" line on failure.
// Zero RNG. Deterministic given bytes.

@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- little-endian accessors --------------------------------
fn g32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}

// int16 LE sample i (payload starts at byte 8)
fn s16(b:[]u8, i:i32) i32 {
    let at:i32 = 8 + i * 2;
    let v:i32 = (b[at] as i32) | ((b[at+1] as i32) << 8);
    if(v >= 32768) { v = v - 65536; }
    return v;
}

// ---------------- NUL-terminated path copy --------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn read_whole(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

// ---------------- decimal output ------------------------------------------
fn put_i64(buf:[]u8, pos:i32, v:i64) i32 {
    let x:i64 = v;
    if(x < 0) { buf[pos] = 45; pos = pos + 1; x = 0 - x; }
    let nd:i32 = 1;
    let t:i64 = x;
    while(t >= 10) { t = t / 10; nd = nd + 1; }
    let p:i32 = pos + nd - 1;
    t = x;
    let k:i32 = 0;
    while(k < nd) { buf[p] = (48 + (t % 10)) as u8; t = t / 10; p = p - 1; k = k + 1; }
    return pos + nd;
}

fn put_str(buf:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { buf[pos] = s[i]; pos = pos + 1; i = i + 1; }
    return pos;
}

fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = put_str(ob, 0, "error=");
    pos = put_str(ob, pos, reason);
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

// ---------------- zero-crossing pitch estimate ----------------------------
// Samples [lo, hi). Returns estimated Hz, or a negative sentinel on failure.
fn est_freq(b:[]u8, lo:i32, hi:i32, rate:i64) f64 {
    let t_first:f64 = 0.0;
    let t_last:f64 = 0.0;
    let n:i32 = 0;
    let prev:i32 = s16(b, lo);
    let i:i32 = lo + 1;
    while(i < hi) {
        let cur:i32 = s16(b, i);
        let cross:i32 = 0;
        if(prev <= 0) { if(cur > 0) { cross = 1; } }
        if(prev >= 0) { if(cur < 0) { cross = 1; } }
        if(cross == 1) {
            let pa:f64 = prev as f64;
            if(pa < 0.0) { pa = 0.0 - pa; }
            let ca:f64 = cur as f64;
            if(ca < 0.0) { ca = 0.0 - ca; }
            let t:f64 = ((i - 1) as f64) + pa / (pa + ca);
            if(n == 0) { t_first = t; }
            t_last = t;
            n = n + 1;
        }
        prev = cur;
        i = i + 1;
    }
    if(n < 4) { return -1.0; }
    let span:f64 = t_last - t_first;
    if(span <= 0.0) { return -1.0; }
    return ((n - 1) as f64) * (rate as f64) / (2.0 * span);
}

fn main() i32 {
    let path:[]u8 = _zag_arg(1);
    if(path.len == 0) { return fail("no_input"); }
    let buf:[]u8 = nio_alloc(65536);
    if(buf.len == 0) { return fail("alloc_failed"); }
    let n:i64 = read_whole(path, buf, 65536);
    if(n < 8) { nio_free(buf); return fail("read_failed"); }
    let rate:i64 = g32(buf, 0);
    let count:i64 = g32(buf, 4);
    if(n != 8 + count * 2) { nio_free(buf); return fail("size_mismatch"); }
    if(rate != 16000) { nio_free(buf); return fail("bad_rate"); }
    if(count < 14080) { nio_free(buf); return fail("too_few_samples"); }
    // Middle 0.3s of each 0.4s tone (gen_t4: tone 0.4s, gap 0.08s).
    // seg0 samples [0,6400), seg1 [7680,14080); middles [800,5600), [8480,13280).
    let f0:f64 = est_freq(buf, 800, 5600, rate);
    let f1:f64 = est_freq(buf, 8480, 13280, rate);
    nio_free(buf);
    if(f0 <= 0.0) { return fail("f0_failed"); }
    if(f1 <= 0.0) { return fail("f1_failed"); }
    // Analytic judgment: generator rule, mirrored exactly.
    let df:f64 = f1 - f0;
    if(df < 0.0) { df = 0.0 - df; }
    let rel:f64 = df / f0;
    let j:[]u8 = "SAME";
    if(rel >= 0.005) {
        j = "LOWER";
        if(f1 > f0) { j = "HIGHER"; }
    }
    let ob:[]u8 = nio_alloc(128);
    if(ob.len == 0) { return fail("alloc_failed"); }
    let pos:i32 = put_str(ob, 0, "f0_mhz=");
    pos = put_i64(ob, pos, (f0 * 1000.0) as i64);
    ob[pos] = 10; pos = pos + 1;
    pos = put_str(ob, pos, "f1_mhz=");
    pos = put_i64(ob, pos, (f1 * 1000.0) as i64);
    ob[pos] = 10; pos = pos + 1;
    pos = put_str(ob, pos, "judgment=");
    pos = put_str(ob, pos, j);
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 0;
}

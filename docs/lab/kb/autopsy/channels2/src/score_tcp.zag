// score_tcp.zag — frozen TCP scorer (PREREG_FROZEN_TCP.md §5).
// Pure-Zag contingency counting. Python glue (score_tcp.py) computes ratios,
// mutual information, and cross-checks every count independently.
//
// Usage: score_tcp <verdicts.txt> <truth_rows.txt>
// verdicts.txt lines:
//   CAL \t sense \t task \t variant \t logical \t C
//   TEST \t sense \t task \t variant \t logical \t C \t V
// truth_rows.txt lines:
//   sense \t task \t variant \t logical \t Y \t kb4idx
// sense in {A,B}; C,V,Y in {0,1} (V: 0=WITHHOLD, 1=INSTALL).
//
// Emits tab-separated count lines:
//   SENSE \t A|B \t n \t .. \t c \t .. \t v1y1 \t .. \t v1y0 \t ..
//         \t v0y1 \t .. \t v0y0 \t .. \t caln \t .. \t calc \t ..
//   CELL \t A|B \t task \t n \t .. \t c \t .. \t ny1 \t .. \t cy1 \t ..
//        \t ny0 \t .. \t cy0 \t .. \t caln \t .. \t calc \t ..
//   POOLED \t n \t .. \t c \t .. \t ny1 \t .. \t cy1 \t .. \t ny0 \t ..
//          \t cy0 \t .. \t v1y1 \t .. \t v1y0 \t .. \t v0y1 \t ..
//          \t v0y0 \t .. \t caln \t .. \t calc \t ..
//   DONE \t <test rows counted>
// Exit nonzero + error= line on join failure or bad input.

@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn read_whole(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

fn p64(a:[]u8, i:i32, v:i64) void {
    let at:i32 = i * 8;
    a[at] = (v & 255) as u8;
    a[at+1] = ((v >> 8) & 255) as u8;
    a[at+2] = ((v >> 16) & 255) as u8;
    a[at+3] = ((v >> 24) & 255) as u8;
    a[at+4] = ((v >> 32) & 255) as u8;
    a[at+5] = ((v >> 40) & 255) as u8;
    a[at+6] = ((v >> 48) & 255) as u8;
    a[at+7] = ((v >> 56) & 255) as u8;
}
fn g64(a:[]u8, i:i32) i64 {
    let at:i32 = i * 8;
    return (a[at] as i64) | ((a[at+1] as i64) << 8)
         | ((a[at+2] as i64) << 16) | ((a[at+3] as i64) << 24)
         | ((a[at+4] as i64) << 32) | ((a[at+5] as i64) << 40)
         | ((a[at+6] as i64) << 48) | ((a[at+7] as i64) << 56);
}
fn cadd(a:[]u8, i:i32, d:i64) void {
    p64(a, i, g64(a, i) + d);
}

fn parse_int(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < s.len) {
        let d:i64 = (s[i] as i64) - 48;
        if(d < 0 || d > 9) { return -1; }
        v = v * 10 + d;
        i = i + 1;
    }
    return v;
}

// k-th tab-separated field of line (0-based); "" if absent
fn field(line:[]u8, k:i32) []u8 {
    let i:i32 = 0;
    let start:i32 = 0;
    let n:i32 = 0;
    while(i <= line.len) {
        if(i == line.len || line[i] == 9) {
            if(n == k) { return line[start..i]; }
            n = n + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn task_idx(t:[]u8) i32 {
    if(_zag_strcmp(t, "colordisc") == 1) { return 0; }
    if(_zag_strcmp(t, "colorconst") == 1) { return 1; }
    if(_zag_strcmp(t, "shapetrans") == 1) { return 2; }
    if(_zag_strcmp(t, "pitchdisc") == 1) { return 3; }
    if(_zag_strcmp(t, "timbredisc") == 1) { return 4; }
    if(_zag_strcmp(t, "motiondir") == 1) { return 5; }
    return -1;
}
fn sense_idx(s:[]u8) i32 {
    if(_zag_strcmp(s, "A") == 1) { return 0; }
    if(_zag_strcmp(s, "B") == 1) { return 1; }
    return -1;
}
fn task_name(i:i32) []u8 {
    if(i == 0) { return "colordisc"; }
    if(i == 1) { return "colorconst"; }
    if(i == 2) { return "shapetrans"; }
    if(i == 3) { return "pitchdisc"; }
    if(i == 4) { return "timbredisc"; }
    return "motiondir";
}
fn sense_name(i:i32) []u8 {
    if(i == 0) { return "A"; }
    return "B";
}

fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    pos = ob_add(ob, pos, "\t");
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "\t");
    pos = ob_add(ob, pos, _zag_i64_to_str(v));
    return pos;
}
fn ob_line(ob:[]u8, pos:i32) i32 {
    ob[pos] = 10;
    return pos + 1;
}
fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = 0;
    pos = ob_add(ob, pos, "error=");
    pos = ob_add(ob, pos, reason);
    pos = ob_line(ob, pos);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    if(a1.len == 0) { return fail("no_verdicts"); }
    if(a2.len == 0) { return fail("no_truth"); }

    // counter arena: 128 slots x 8 bytes, explicitly zeroed
    let ctr:[]u8 = nio_alloc(1024);
    if(ctr.len == 0) { return fail("alloc_failed"); }
    let zi:i32 = 0;
    while(zi < 128) { p64(ctr, zi, 0); zi = zi + 1; }

    // truth rows: sense(1B), task(1B), Y(1B) + base slice into tbuf
    let tbuf:[]u8 = nio_alloc(65536);
    if(tbuf.len == 0) { return fail("alloc_failed"); }
    let tn:i64 = read_whole(a2, tbuf, 65536);
    if(tn < 1) { return fail("truth_read_failed"); }
    let tsense:[]u8 = nio_alloc(512);
    let ttask:[]u8 = nio_alloc(512);
    let ty:[]u8 = nio_alloc(512);
    let tbase:[]u8 = nio_alloc(16384);
    if(tsense.len == 0) { return fail("alloc_failed"); }
    let ntruth:i32 = 0;
    let i:i32 = 0;
    let ls:i32 = 0;
    while(i <= tn as i32) {
        if(i == tn as i32 || tbuf[i] == 10) {
            if(i > ls) {
                let line:[]u8 = tbuf[ls..i];
                let se:i32 = sense_idx(field(line, 0));
                let ta:i32 = task_idx(field(line, 1));
                let y:i64 = parse_int(field(line, 4));
                if(se < 0 || ta < 0 || (y != 0 && y != 1)) { return fail("truth_bad_row"); }
                if(ntruth >= 512) { return fail("truth_too_many"); }
                tsense[ntruth] = se as u8;
                ttask[ntruth] = ta as u8;
                ty[ntruth] = y as u8;
                let b:[]u8 = field(line, 3);
                let bo:i32 = ntruth * 32;
                let bi:i32 = 0;
                while(bi < b.len && bi < 31) { tbase[bo + bi] = b[bi]; bi = bi + 1; }
                tbase[bo + bi] = 0;
                ntruth = ntruth + 1;
            }
            ls = i + 1;
        }
        i = i + 1;
    }

    // verdict rows
    let vbuf:[]u8 = nio_alloc(65536);
    if(vbuf.len == 0) { return fail("alloc_failed"); }
    let vn:i64 = read_whole(a1, vbuf, 65536);
    if(vn < 1) { return fail("verdicts_read_failed"); }
    let ntest:i32 = 0;
    i = 0; ls = 0;
    while(i <= vn as i32) {
        if(i == vn as i32 || vbuf[i] == 10) {
            if(i > ls) {
                let line:[]u8 = vbuf[ls..i];
                let tag:[]u8 = field(line, 0);
                if(_zag_strcmp(tag, "DONE") == 1) { ls = i + 1; i = i + 1; continue; }
                let se:i32 = sense_idx(field(line, 1));
                let ta:i32 = task_idx(field(line, 2));
                let b:[]u8 = field(line, 4);
                let c:i64 = parse_int(field(line, 5));
                if(se < 0 || ta < 0 || (c != 0 && c != 1)) { return fail("verdict_bad_row"); }
                let st:i32 = se * 6 + ta;
                if(_zag_strcmp(tag, "CAL") == 1) {
                    cadd(ctr, st * 8 + 6, 1);
                    cadd(ctr, st * 8 + 7, c);
                    cadd(ctr, 96 + se * 8 + 6, 1);
                    cadd(ctr, 96 + se * 8 + 7, c);
                    cadd(ctr, 112 + 10, 1);
                    cadd(ctr, 112 + 11, c);
                }
                if(_zag_strcmp(tag, "TEST") == 1) {
                    let v:i64 = parse_int(field(line, 6));
                    if(v != 0 && v != 1) { return fail("verdict_bad_v"); }
                    // join truth on (sense, task, base)
                    let y:i64 = -1;
                    let ti:i32 = 0;
                    while(ti < ntruth) {
                        if(tsense[ti] as i32 == se && ttask[ti] as i32 == ta) {
                            let bo:i32 = ti * 32;
                            let bl:i32 = 0;
                            while(bl < 31 && tbase[bo + bl] != 0) { bl = bl + 1; }
                            let tb:[]u8 = tbase[bo..(bo + bl)];
                            if(_zag_strcmp(tb, b) == 1) {
                                y = ty[ti] as i64;
                                ti = ntruth;
                            }
                        }
                        ti = ti + 1;
                    }
                    if(y < 0) { return fail("truth_join_failed"); }
                    cadd(ctr, st * 8 + 0, 1);
                    cadd(ctr, st * 8 + 1, c);
                    cadd(ctr, 96 + se * 8 + 0, 1);
                    cadd(ctr, 96 + se * 8 + 1, c);
                    cadd(ctr, 112 + 0, 1);
                    cadd(ctr, 112 + 1, c);
                    if(y == 1) {
                        cadd(ctr, st * 8 + 2, 1);
                        cadd(ctr, st * 8 + 3, c);
                        cadd(ctr, 112 + 2, 1);
                        cadd(ctr, 112 + 3, c);
                    }
                    if(y == 0) {
                        cadd(ctr, st * 8 + 4, 1);
                        cadd(ctr, st * 8 + 5, c);
                        cadd(ctr, 112 + 4, 1);
                        cadd(ctr, 112 + 5, c);
                    }
                    if(v == 1 && y == 1) {
                        cadd(ctr, 96 + se * 8 + 2, 1);
                        cadd(ctr, 112 + 6, 1);
                    }
                    if(v == 1 && y == 0) {
                        cadd(ctr, 96 + se * 8 + 3, 1);
                        cadd(ctr, 112 + 7, 1);
                    }
                    if(v == 0 && y == 1) {
                        cadd(ctr, 96 + se * 8 + 4, 1);
                        cadd(ctr, 112 + 8, 1);
                    }
                    if(v == 0 && y == 0) {
                        cadd(ctr, 96 + se * 8 + 5, 1);
                        cadd(ctr, 112 + 9, 1);
                    }
                    ntest = ntest + 1;
                }
            }
            ls = i + 1;
        }
        i = i + 1;
    }

    // emit
    let ob:[]u8 = nio_alloc(16384);
    if(ob.len == 0) { return fail("alloc_failed"); }
    let pos:i32 = 0;
    let se2:i32 = 0;
    while(se2 < 2) {
        pos = ob_add(ob, pos, "SENSE");
        pos = ob_add(ob, pos, "\t");
        pos = ob_add(ob, pos, sense_name(se2));
        pos = ob_kv(ob, pos, "n", g64(ctr, 96 + se2 * 8 + 0));
        pos = ob_kv(ob, pos, "c", g64(ctr, 96 + se2 * 8 + 1));
        pos = ob_kv(ob, pos, "v1y1", g64(ctr, 96 + se2 * 8 + 2));
        pos = ob_kv(ob, pos, "v1y0", g64(ctr, 96 + se2 * 8 + 3));
        pos = ob_kv(ob, pos, "v0y1", g64(ctr, 96 + se2 * 8 + 4));
        pos = ob_kv(ob, pos, "v0y0", g64(ctr, 96 + se2 * 8 + 5));
        pos = ob_kv(ob, pos, "caln", g64(ctr, 96 + se2 * 8 + 6));
        pos = ob_kv(ob, pos, "calc", g64(ctr, 96 + se2 * 8 + 7));
        pos = ob_line(ob, pos);
        se2 = se2 + 1;
    }
    se2 = 0;
    while(se2 < 2) {
        let ta2:i32 = 0;
        while(ta2 < 6) {
            let st2:i32 = se2 * 6 + ta2;
            pos = ob_add(ob, pos, "CELL");
            pos = ob_add(ob, pos, "\t");
            pos = ob_add(ob, pos, sense_name(se2));
            pos = ob_add(ob, pos, "\t");
            pos = ob_add(ob, pos, task_name(ta2));
            pos = ob_kv(ob, pos, "n", g64(ctr, st2 * 8 + 0));
            pos = ob_kv(ob, pos, "c", g64(ctr, st2 * 8 + 1));
            pos = ob_kv(ob, pos, "ny1", g64(ctr, st2 * 8 + 2));
            pos = ob_kv(ob, pos, "cy1", g64(ctr, st2 * 8 + 3));
            pos = ob_kv(ob, pos, "ny0", g64(ctr, st2 * 8 + 4));
            pos = ob_kv(ob, pos, "cy0", g64(ctr, st2 * 8 + 5));
            pos = ob_kv(ob, pos, "caln", g64(ctr, st2 * 8 + 6));
            pos = ob_kv(ob, pos, "calc", g64(ctr, st2 * 8 + 7));
            pos = ob_line(ob, pos);
            ta2 = ta2 + 1;
        }
        se2 = se2 + 1;
    }
    pos = ob_add(ob, pos, "POOLED");
    pos = ob_kv(ob, pos, "n", g64(ctr, 112 + 0));
    pos = ob_kv(ob, pos, "c", g64(ctr, 112 + 1));
    pos = ob_kv(ob, pos, "ny1", g64(ctr, 112 + 2));
    pos = ob_kv(ob, pos, "cy1", g64(ctr, 112 + 3));
    pos = ob_kv(ob, pos, "ny0", g64(ctr, 112 + 4));
    pos = ob_kv(ob, pos, "cy0", g64(ctr, 112 + 5));
    pos = ob_kv(ob, pos, "v1y1", g64(ctr, 112 + 6));
    pos = ob_kv(ob, pos, "v1y0", g64(ctr, 112 + 7));
    pos = ob_kv(ob, pos, "v0y1", g64(ctr, 112 + 8));
    pos = ob_kv(ob, pos, "v0y0", g64(ctr, 112 + 9));
    pos = ob_kv(ob, pos, "caln", g64(ctr, 112 + 10));
    pos = ob_kv(ob, pos, "calc", g64(ctr, 112 + 11));
    pos = ob_line(ob, pos);
    pos = ob_add(ob, pos, "DONE");
    pos = ob_add(ob, pos, "\t");
    pos = ob_add(ob, pos, _zag_i64_to_str(ntest as i64));
    pos = ob_line(ob, pos);
    nio_write_all(1, ob[0..pos]);
    return 0;
}

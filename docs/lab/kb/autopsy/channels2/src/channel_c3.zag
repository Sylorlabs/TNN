// channel_c3.zag — frozen C3 channel rule (PREREG_FROZEN_TCP.md §9).
// Usage: channel_c3 <J> <Jn>
//   J  = judgment on the original adversarial fixture
//   Jn = judgment on the noised re-observation of the same fixture
// Verdict: INSTALL iff Jn == J (honest re-observation agrees); else WITHHOLD.
// Prints "C=0|1" (C := [Jn == J]) and "verdict=WITHHOLD|INSTALL".
// No truth input anywhere. Zero RNG.
// Exit 0 on success; nonzero + error= line on bad args.

@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = 0;
    let pre:[]u8 = "error=";
    let i:i32 = 0;
    while(i < pre.len) { ob[pos] = pre[i]; pos = pos + 1; i = i + 1; }
    i = 0;
    while(i < reason.len) { ob[pos] = reason[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

fn main() i32 {
    let j:[]u8 = _zag_arg(1);
    let jn:[]u8 = _zag_arg(2);
    if(j.len == 0) { return fail("no_j"); }
    if(jn.len == 0) { return fail("no_jn"); }
    let c:i32 = 0;
    if(_zag_strcmp(jn, j) == 1) { c = 1; }
    let ob:[]u8 = nio_alloc(64);
    if(ob.len == 0) { return fail("alloc_failed"); }
    let pos:i32 = 0;
    let l1:[]u8 = "C=";
    let i:i32 = 0;
    while(i < l1.len) { ob[pos] = l1[i]; pos = pos + 1; i = i + 1; }
    if(c == 1) { ob[pos] = 49; } else { ob[pos] = 48; }
    pos = pos + 1;
    ob[pos] = 10; pos = pos + 1;
    let l2:[]u8 = "verdict=";
    i = 0;
    while(i < l2.len) { ob[pos] = l2[i]; pos = pos + 1; i = i + 1; }
    let v:[]u8 = "WITHHOLD";
    if(c == 1) { v = "INSTALL"; }
    i = 0;
    while(i < v.len) { ob[pos] = v[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 0;
}

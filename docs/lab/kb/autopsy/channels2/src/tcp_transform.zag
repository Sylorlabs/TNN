// tcp_transform.zag — frozen TCP instrument (PREREG_FROZEN_TCP.md §2).
// Pure-Zag byte-exact transform T per task:
//   colordisc|colorconst|shapetrans -> h-flip RGB24 image
//   pitchdisc|timbredisc            -> time-reversed int16 PCM
//   motiondir                      -> frame-reversed video
// Headers are copied verbatim. Zero RNG. Deterministic given bytes.
//
// Usage: tcp_transform <task> <in-fixture> <out-path>
// Exit 0 on success (silent); nonzero + "error=<reason>" line on failure.
//
// Build (@import resolves relative to the source file on this znc build):
//   cd ~/workspace/tnn-lab/kb/autopsy/channels2 && \
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1 \
//     src/tcp_transform.zag --no-zagd --no-analyze --no-foreground-cache \
//     -o src/tcp_transform

@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- little-endian accessors --------------------------------
fn g32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}

// ---------------- NUL-terminated path copy --------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

// ---------------- whole-file IO ------------------------------------------
fn read_whole(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

// O_WRONLY(1)|O_CREAT(64)|O_TRUNC(512)=577, mode 0644=438. No O_EXCL:
// overwrites existing output files (O_EXCL would fail silently on them).
fn write_whole(path:[]u8, buf:[]u8, n:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7501; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 438, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7502; }
    let w:i64 = nio_write_all(fd, buf[0..n]);
    nio_close(fd);
    return w;
}

fn copy_hdr(inp:[]u8, out:[]u8, n:i32) void {
    let i:i32 = 0;
    while(i < n) { out[i] = inp[i]; i = i + 1; }
}

// ---------------- error reporting -----------------------------------------
fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = 0;
    let pre:[]u8 = "error=";
    let i:i32 = 0;
    while(i < pre.len) { ob[pos] = pre[i]; pos = pos + 1; i = i + 1; }
    i = 0;
    while(i < reason.len) { ob[pos] = reason[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

// ---------------- T: h-flip .img ------------------------------------------
// out[8+(y*W+x)*3+c] = in[8+(y*W+(W-1-x))*3+c], c in {0,1,2}
fn t_img(inp:[]u8, out:[]u8, n:i32) i32 {
    let w:i64 = g32(inp, 0);
    let h:i64 = g32(inp, 4);
    if(w < 1 || h < 1) { return -1; }
    if(w > 4096 || h > 4096) { return -1; }
    let want:i64 = 8 + w * h * 3;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let y:i64 = 0;
    while(y < h) {
        let x:i64 = 0;
        while(x < w) {
            let c:i64 = 0;
            while(c < 3) {
                let si:i64 = 8 + (y * w + (w - 1 - x)) * 3 + c;
                let di:i64 = 8 + (y * w + x) * 3 + c;
                out[di as i32] = inp[si as i32];
                c = c + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

// ---------------- T: sample-reversed .pcm ---------------------------------
// out_sample[i] = in_sample[N-1-i], 2 bytes LE each
fn t_pcm(inp:[]u8, out:[]u8, n:i32) i32 {
    let count:i64 = g32(inp, 4);
    if(count < 1) { return -1; }
    if(count > 4000000) { return -1; }
    let want:i64 = 8 + count * 2;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let i:i64 = 0;
    while(i < count) {
        let si:i64 = 8 + (count - 1 - i) * 2;
        let di:i64 = 8 + i * 2;
        out[di as i32] = inp[si as i32];
        out[(di + 1) as i32] = inp[(si + 1) as i32];
        i = i + 1;
    }
    return 0;
}

// ---------------- T: frame-reversed .vid ----------------------------------
// out_frame[f] = in_frame[F-1-f], W*H*3 bytes each
fn t_vid(inp:[]u8, out:[]u8, n:i32) i32 {
    let f:i64 = g32(inp, 0);
    let w:i64 = g32(inp, 4);
    let h:i64 = g32(inp, 8);
    if(f < 1 || w < 1 || h < 1) { return -1; }
    if(f > 64 || w > 4096 || h > 4096) { return -1; }
    let fsz:i64 = w * h * 3;
    let want:i64 = 12 + f * fsz;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 12);
    let k:i64 = 0;
    while(k < f) {
        let sb:i64 = 12 + (f - 1 - k) * fsz;
        let db:i64 = 12 + k * fsz;
        let j:i64 = 0;
        while(j < fsz) {
            out[(db + j) as i32] = inp[(sb + j) as i32];
            j = j + 1;
        }
        k = k + 1;
    }
    return 0;
}

// ---------------- main -------------------------------------------------------
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    if(a1.len == 0) { return fail("no_task"); }
    if(a2.len == 0) { return fail("no_input"); }
    if(a3.len == 0) { return fail("no_output"); }
    let kind:i32 = 0;
    if(_zag_strcmp(a1, "colordisc") == 1) { kind = 1; }
    if(_zag_strcmp(a1, "colorconst") == 1) { kind = 1; }
    if(_zag_strcmp(a1, "shapetrans") == 1) { kind = 1; }
    if(_zag_strcmp(a1, "pitchdisc") == 1) { kind = 2; }
    if(_zag_strcmp(a1, "timbredisc") == 1) { kind = 2; }
    if(_zag_strcmp(a1, "motiondir") == 1) { kind = 3; }
    if(kind == 0) { return fail("bad_task"); }
    let inp:[]u8 = nio_alloc(4194304);
    let out:[]u8 = nio_alloc(4194304);
    if(inp.len == 0) { return fail("alloc_failed"); }
    if(out.len == 0) { return fail("alloc_failed"); }
    let n:i64 = read_whole(a2, inp, 4194304);
    if(n < 12) { return fail("read_failed"); }
    let rc:i32 = -9;
    if(kind == 1) { rc = t_img(inp, out, n as i32); }
    if(kind == 2) { rc = t_pcm(inp, out, n as i32); }
    if(kind == 3) { rc = t_vid(inp, out, n as i32); }
    if(rc != 0) { return fail("transform_failed"); }
    let w:i64 = write_whole(a3, out, n as i32);
    if(w != n) { return fail("write_failed"); }
    return 0;
}

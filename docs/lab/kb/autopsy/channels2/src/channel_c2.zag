@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

// channel_c2.zag — frozen TCP channel rule (PREREG_FROZEN_TCP.md §2, §3).
// Usage: channel_c2 <task> <J> <Jt>
//   J  = judgment on the original fixture, Jt = judgment on T(fixture)
// Applies the frozen per-task law L and prints:
//   C=0|1
//   verdict=WITHHOLD|INSTALL
// C := [Jt == L(J)]; verdict INSTALL iff C. No truth input anywhere.
// Exit 0 on success; nonzero + error= line on bad args.

fn cp(dst:[]u8, s:[]u8) i32 {
    if(s.len > dst.len) { return 0; }
    let i:i32 = 0;
    while(i < s.len) { dst[i] = s[i]; i = i + 1; }
    return 1;
}

// L(J) for the §2 law table. Writes L(J) into out, returns its byte length.
// Returns -1 if J is outside the law's domain (frozen judges never do this;
// then C is forced 0).
fn law(task:[]u8, j:[]u8, out:[]u8) i32 {
    if(_zag_strcmp(task, "pitchdisc") == 1) {
        if(_zag_strcmp(j, "SAME") == 1) { cp(out, "SAME"); return 4; }
        if(_zag_strcmp(j, "HIGHER") == 1) { cp(out, "LOWER"); return 5; }
        if(_zag_strcmp(j, "LOWER") == 1) { cp(out, "HIGHER"); return 6; }
        return -1;
    }
    if(_zag_strcmp(task, "motiondir") == 1) {
        if(_zag_strcmp(j, "STILL") == 1) { cp(out, "STILL"); return 5; }
        if(_zag_strcmp(j, "N") == 1) { cp(out, "S"); return 1; }
        if(_zag_strcmp(j, "S") == 1) { cp(out, "N"); return 1; }
        if(_zag_strcmp(j, "E") == 1) { cp(out, "W"); return 1; }
        if(_zag_strcmp(j, "W") == 1) { cp(out, "E"); return 1; }
        if(_zag_strcmp(j, "NE") == 1) { cp(out, "SW"); return 2; }
        if(_zag_strcmp(j, "SW") == 1) { cp(out, "NE"); return 2; }
        if(_zag_strcmp(j, "NW") == 1) { cp(out, "SE"); return 2; }
        if(_zag_strcmp(j, "SE") == 1) { cp(out, "NW"); return 2; }
        return -1;
    }
    // colordisc | colorconst | shapetrans | timbredisc: identity law
    cp(out, j);
    return j.len;
}

fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = 0;
    let pre:[]u8 = "error=";
    let i:i32 = 0;
    while(i < pre.len) { ob[pos] = pre[i]; pos = pos + 1; i = i + 1; }
    i = 0;
    while(i < reason.len) { ob[pos] = reason[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

fn main() i32 {
    let task:[]u8 = _zag_arg(1);
    let j:[]u8 = _zag_arg(2);
    let jt:[]u8 = _zag_arg(3);
    if(task.len == 0) { return fail("no_task"); }
    if(j.len == 0) { return fail("no_j"); }
    if(jt.len == 0) { return fail("no_jt"); }
    let lj:[]u8 = nio_alloc(64);
    if(lj.len == 0) { return fail("alloc_failed"); }
    let llen:i32 = law(task, j, lj);
    let c:i32 = 0;
    if(llen > 0) {
        if(_zag_strcmp(jt, lj[0..llen]) == 1) { c = 1; }
    }
    let ob:[]u8 = nio_alloc(64);
    if(ob.len == 0) { return fail("alloc_failed"); }
    let pos:i32 = 0;
    let l1:[]u8 = "C=";
    let i:i32 = 0;
    while(i < l1.len) { ob[pos] = l1[i]; pos = pos + 1; i = i + 1; }
    if(c == 1) { ob[pos] = 49; } else { ob[pos] = 48; }
    pos = pos + 1;
    ob[pos] = 10; pos = pos + 1;
    let l2:[]u8 = "verdict=";
    i = 0;
    while(i < l2.len) { ob[pos] = l2[i]; pos = pos + 1; i = i + 1; }
    let v:[]u8 = "WITHHOLD";
    if(c == 1) { v = "INSTALL"; }
    i = 0;
    while(i < v.len) { ob[pos] = v[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(lj);
    nio_free(ob);
    return 0;
}

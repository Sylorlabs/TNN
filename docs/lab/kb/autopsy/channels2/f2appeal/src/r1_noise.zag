// r1_noise.zag — F2 appeal R1/R2 noise instrument (PREREG_FROZEN_F2APPEAL.md §4).
// Deterministic pseudo-noise added to fixture BYTES; frozen sense binary is
// re-run on the noised bytes by the runner (glue). Noise model = frozen C3
// model: .pcm int16 samples delta uniform in [-A,+A] clamp [-32768,32767];
// .img/.vid payload bytes delta uniform in [-A,+A] clamp [0,255]; headers
// preserved verbatim. Amplitude class from <level>: pcm A in
// {50,100,200,300,600,1200,2400}, img/vid A in {1,2,4,8,16,32,64}.
// Stream: splitmix64, MASTER = 20260923, stream = S + task_idx where S comes
// from <mode>: "r1" -> 910; "r2d0".."r2d4" -> 940+100*k. Reset per fixture.
// One draw per payload element in file order. Zero RNG. 2x runs byte-identical.
//
// Usage: r1_noise <task> <level 0-6> <mode r1|r2d0..r2d4> <in-fixture> <out-path>
// Exit 0 on success (silent); nonzero + "error=<reason>" line on failure.
//
// Build (from kb/autopsy/channels2/build):
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1 \
//     ../f2appeal/src/r1_noise.zag --no-zagd --no-analyze --no-foreground-cache \
//     -o ../f2appeal/build/r1_noise
//
// splitmix64 workarounds W1-W4 identical to frozen c3_noise.zag (proven
// 2026-09-22 draw-by-draw against the harness Python splitmix64).

@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn lshr30(v:u64) u64 {
    let a:u64 = v >> 30;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 34); }
    return a;
}
fn lshr27(v:u64) u64 {
    let a:u64 = v >> 27;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 37); }
    return a;
}
fn lshr31(v:u64) u64 {
    let a:u64 = v >> 31;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 33); }
    return a;
}
fn lshr32(v:u64) u64 {
    let a:u64 = v >> 32;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 32); }
    return a;
}

fn sm_draw(st:*u64) u64 {
    let inc:u64 = 11400714819323198485;
    let c1:u64 = 13787848793156543929;
    let c2:u64 = 10723151780598845931;
    st.* = st.* + inc;
    let z:u64 = st.*;
    let t1:u64 = z ^ lshr30(z);
    let m1:u64 = t1 * c1;
    let t2:u64 = m1 ^ lshr27(m1);
    let m2:u64 = t2 * c2;
    return m2 ^ lshr31(m2);
}

fn sm_step(x:u64) u64 {
    let inc:u64 = 11400714819323198485;
    let c1:u64 = 13787848793156543929;
    let c2:u64 = 10723151780598845931;
    let s:u64 = x + inc;
    let t1:u64 = s ^ lshr30(s);
    let m1:u64 = t1 * c1;
    let t2:u64 = m1 ^ lshr27(m1);
    let m2:u64 = t2 * c2;
    return m2 ^ lshr31(m2);
}

fn sm_seed(master:u64, stream:u64) u64 {
    let inc:u64 = 11400714819323198485;
    let h:u64 = sm_step(master ^ (stream * inc));
    return sm_step(h);
}

fn draw_below(st:*u64, m:i64) i64 {
    let n:u64 = sm_draw(st);
    let hi:u64 = lshr32(n);
    let lo:u64 = n & 4294967295;
    let c:i64 = 4294967296 % m;
    let hm:i64 = (hi as i64) % m;
    let lm:i64 = (lo as i64) % m;
    let r:i64 = (hm * c + lm) % m;
    return r;
}

fn g32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn read_whole(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

fn write_whole(path:[]u8, buf:[]u8, n:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7501; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 438, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7502; }
    let w:i64 = nio_write_all(fd, buf[0..n]);
    nio_close(fd);
    return w;
}

fn copy_hdr(inp:[]u8, out:[]u8, n:i32) void {
    let i:i32 = 0;
    while(i < n) { out[i] = inp[i]; i = i + 1; }
}

fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = 0;
    let pre:[]u8 = "error=";
    let i:i32 = 0;
    while(i < pre.len) { ob[pos] = pre[i]; pos = pos + 1; i = i + 1; }
    i = 0;
    while(i < reason.len) { ob[pos] = reason[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

fn n_img(inp:[]u8, out:[]u8, n:i32, st:*u64, amp:i64) i32 {
    let w:i64 = g32(inp, 0);
    let h:i64 = g32(inp, 4);
    if(w < 1 || h < 1) { return -1; }
    if(w > 4096 || h > 4096) { return -1; }
    let want:i64 = 8 + w * h * 3;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let m:i64 = 2 * amp + 1;
    let i:i64 = 8;
    while(i < (n as i64)) {
        let d:i64 = draw_below(st, m) - amp;
        let v:i64 = (inp[i as i32] as i64) + d;
        if(v < 0) { v = 0; }
        if(v > 255) { v = 255; }
        out[i as i32] = v as u8;
        i = i + 1;
    }
    return 0;
}

fn n_pcm(inp:[]u8, out:[]u8, n:i32, st:*u64, amp:i64) i32 {
    let count:i64 = g32(inp, 4);
    if(count < 1) { return -1; }
    if(count > 4000000) { return -1; }
    let want:i64 = 8 + count * 2;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let m:i64 = 2 * amp + 1;
    let i:i64 = 0;
    while(i < count) {
        let at:i64 = 8 + i * 2;
        let lo:i64 = inp[at as i32] as i64;
        let hix:i64 = inp[(at + 1) as i32] as i64;
        let sv:i64 = lo | (hix << 8);
        if(sv >= 32768) { sv = sv - 65536; }
        let d:i64 = draw_below(st, m) - amp;
        sv = sv + d;
        if(sv < -32768) { sv = -32768; }
        if(sv > 32767) { sv = 32767; }
        let uv:i64 = sv;
        if(uv < 0) { uv = uv + 65536; }
        out[at as i32] = (uv & 255) as u8;
        out[(at + 1) as i32] = ((uv >> 8) & 255) as u8;
        i = i + 1;
    }
    return 0;
}

fn n_vid(inp:[]u8, out:[]u8, n:i32, st:*u64, amp:i64) i32 {
    let f:i64 = g32(inp, 0);
    let w:i64 = g32(inp, 4);
    let h:i64 = g32(inp, 8);
    if(f < 1 || w < 1 || h < 1) { return -1; }
    if(f > 64 || w > 4096 || h > 4096) { return -1; }
    let fsz:i64 = w * h * 3;
    let want:i64 = 12 + f * fsz;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 12);
    let m:i64 = 2 * amp + 1;
    let i:i64 = 12;
    while(i < (n as i64)) {
        let d:i64 = draw_below(st, m) - amp;
        let v:i64 = (inp[i as i32] as i64) + d;
        if(v < 0) { v = 0; }
        if(v > 255) { v = 255; }
        out[i as i32] = v as u8;
        i = i + 1;
    }
    return 0;
}

fn task_idx(t:[]u8) i32 {
    if(_zag_strcmp(t, "colordisc") == 1) { return 0; }
    if(_zag_strcmp(t, "colorconst") == 1) { return 1; }
    if(_zag_strcmp(t, "shapetrans") == 1) { return 2; }
    if(_zag_strcmp(t, "pitchdisc") == 1) { return 3; }
    if(_zag_strcmp(t, "timbredisc") == 1) { return 4; }
    if(_zag_strcmp(t, "motiondir") == 1) { return 5; }
    return -1;
}

fn level_amp_pcm(lv:[]u8) i64 {
    if(_zag_strcmp(lv, "0") == 1) { return 50; }
    if(_zag_strcmp(lv, "1") == 1) { return 100; }
    if(_zag_strcmp(lv, "2") == 1) { return 200; }
    if(_zag_strcmp(lv, "3") == 1) { return 300; }
    if(_zag_strcmp(lv, "4") == 1) { return 600; }
    if(_zag_strcmp(lv, "5") == 1) { return 1200; }
    if(_zag_strcmp(lv, "6") == 1) { return 2400; }
    return -1;
}

fn level_amp_img(lv:[]u8) i64 {
    if(_zag_strcmp(lv, "0") == 1) { return 1; }
    if(_zag_strcmp(lv, "1") == 1) { return 2; }
    if(_zag_strcmp(lv, "2") == 1) { return 4; }
    if(_zag_strcmp(lv, "3") == 1) { return 8; }
    if(_zag_strcmp(lv, "4") == 1) { return 16; }
    if(_zag_strcmp(lv, "5") == 1) { return 32; }
    if(_zag_strcmp(lv, "6") == 1) { return 64; }
    return -1;
}

fn mode_base(md:[]u8) i64 {
    if(_zag_strcmp(md, "r1") == 1) { return 910; }
    if(_zag_strcmp(md, "r2d0") == 1) { return 940; }
    if(_zag_strcmp(md, "r2d1") == 1) { return 1040; }
    if(_zag_strcmp(md, "r2d2") == 1) { return 1140; }
    if(_zag_strcmp(md, "r2d3") == 1) { return 1240; }
    if(_zag_strcmp(md, "r2d4") == 1) { return 1340; }
    return -1;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let a4:[]u8 = _zag_arg(4);
    let a5:[]u8 = _zag_arg(5);
    if(a1.len == 0) { return fail("no_task"); }
    if(a2.len == 0) { return fail("no_level"); }
    if(a3.len == 0) { return fail("no_mode"); }
    if(a4.len == 0) { return fail("no_input"); }
    if(a5.len == 0) { return fail("no_output"); }
    let ti:i32 = task_idx(a1);
    if(ti < 0) { return fail("bad_task"); }
    let ap:i64 = level_amp_pcm(a2);
    let ai:i64 = level_amp_img(a2);
    if(ap < 0 || ai < 0) { return fail("bad_level"); }
    let sb:i64 = mode_base(a3);
    if(sb < 0) { return fail("bad_mode"); }
    let kind:i32 = 0;
    if(ti <= 2) { kind = 1; }
    if(ti == 3 || ti == 4) { kind = 2; }
    if(ti == 5) { kind = 3; }
    let amp:i64 = ai;
    if(kind == 2) { amp = ap; }
    let inp:[]u8 = nio_alloc(4194304);
    let out:[]u8 = nio_alloc(4194304);
    if(inp.len == 0) { return fail("alloc_failed"); }
    if(out.len == 0) { return fail("alloc_failed"); }
    let n:i64 = read_whole(a4, inp, 4194304);
    if(n < 12) { return fail("read_failed"); }
    let s:u64 = sm_seed(20260923, (sb as u64) + (ti as u64));
    let rc:i32 = -9;
    if(kind == 1) { rc = n_img(inp, out, n as i32, &s, amp); }
    if(kind == 2) { rc = n_pcm(inp, out, n as i32, &s, amp); }
    if(kind == 3) { rc = n_vid(inp, out, n as i32, &s, amp); }
    if(rc != 0) { return fail("noise_failed"); }
    let w:i64 = write_whole(a5, out, n as i32);
    if(w != n) { return fail("write_failed"); }
    return 0;
}

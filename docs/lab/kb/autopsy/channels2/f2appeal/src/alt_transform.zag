// alt_transform.zag — F2 appeal R3 alternative transforms
// (PREREG_FROZEN_F2APPEAL.md §4-R3). Pure-Zag byte-exact transforms with
// identity label maps:
//   vflip    (.img): out[8+(y*W+x)*3+c] = in[8+((H-1-y)*W+x)*3+c]
//   signflip (.pcm): out_sample[i] = -in_sample[i], int16 LE,
//                    -32768 saturates to 32767
//   fshift   (.vid): out_frame[f] = in_frame[(f+F/2)%F]
// Headers copied verbatim. All three are involutions on fixture bytes
// (validity self-check T(T(x))==x is run by the runner; signflip's
// -32768 edge is saturating, so the check is per-task).
// Zero RNG. Deterministic given bytes.
//
// Usage: alt_transform <transform vflip|signflip|fshift> <task> <in> <out>
// Exit 0 on success (silent); nonzero + "error=<reason>" line on failure.
//
// Build (from kb/autopsy/channels2/build):
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1 \
//     ../f2appeal/src/alt_transform.zag --no-zagd --no-analyze --no-foreground-cache \
//     -o ../f2appeal/build/alt_transform

@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn g32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn read_whole(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

fn write_whole(path:[]u8, buf:[]u8, n:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7501; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 438, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7502; }
    let w:i64 = nio_write_all(fd, buf[0..n]);
    nio_close(fd);
    return w;
}

fn copy_hdr(inp:[]u8, out:[]u8, n:i32) void {
    let i:i32 = 0;
    while(i < n) { out[i] = inp[i]; i = i + 1; }
}

fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = 0;
    let pre:[]u8 = "error=";
    let i:i32 = 0;
    while(i < pre.len) { ob[pos] = pre[i]; pos = pos + 1; i = i + 1; }
    i = 0;
    while(i < reason.len) { ob[pos] = reason[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

// vflip on .img: vertical mirror
fn t_vflip(inp:[]u8, out:[]u8, n:i32) i32 {
    let w:i64 = g32(inp, 0);
    let h:i64 = g32(inp, 4);
    if(w < 1 || h < 1) { return -1; }
    if(w > 4096 || h > 4096) { return -1; }
    let want:i64 = 8 + w * h * 3;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let y:i64 = 0;
    while(y < h) {
        let x:i64 = 0;
        while(x < w) {
            let c:i64 = 0;
            while(c < 3) {
                let si:i64 = 8 + ((h - 1 - y) * w + x) * 3 + c;
                let di:i64 = 8 + (y * w + x) * 3 + c;
                out[di as i32] = inp[si as i32];
                c = c + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

// signflip on .pcm: negate each int16 sample; -32768 saturates to 32767
fn t_signflip(inp:[]u8, out:[]u8, n:i32) i32 {
    let count:i64 = g32(inp, 4);
    if(count < 1) { return -1; }
    if(count > 4000000) { return -1; }
    let want:i64 = 8 + count * 2;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let i:i64 = 0;
    while(i < count) {
        let at:i64 = 8 + i * 2;
        let lo:i64 = inp[at as i32] as i64;
        let hix:i64 = inp[(at + 1) as i32] as i64;
        let sv:i64 = lo | (hix << 8);
        if(sv >= 32768) { sv = sv - 65536; }
        let nv:i64 = 0 - sv;
        if(nv > 32767) { nv = 32767; }
        if(nv < -32768) { nv = -32768; }
        let uv:i64 = nv;
        if(uv < 0) { uv = uv + 65536; }
        out[at as i32] = (uv & 255) as u8;
        out[(at + 1) as i32] = ((uv >> 8) & 255) as u8;
        i = i + 1;
    }
    return 0;
}

// fshift on .vid: cyclic frame shift by F/2
fn t_fshift(inp:[]u8, out:[]u8, n:i32) i32 {
    let f:i64 = g32(inp, 0);
    let w:i64 = g32(inp, 4);
    let h:i64 = g32(inp, 8);
    if(f < 1 || w < 1 || h < 1) { return -1; }
    if(f > 64 || w > 4096 || h > 4096) { return -1; }
    let fsz:i64 = w * h * 3;
    let want:i64 = 12 + f * fsz;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 12);
    let half:i64 = f / 2;
    let k:i64 = 0;
    while(k < f) {
        let sk:i64 = k + half;
        if(sk >= f) { sk = sk - f; }
        let sb:i64 = 12 + sk * fsz;
        let db:i64 = 12 + k * fsz;
        let j:i64 = 0;
        while(j < fsz) {
            out[(db + j) as i32] = inp[(sb + j) as i32];
            j = j + 1;
        }
        k = k + 1;
    }
    return 0;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let a4:[]u8 = _zag_arg(4);
    if(a1.len == 0) { return fail("no_transform"); }
    if(a2.len == 0) { return fail("no_task"); }
    if(a3.len == 0) { return fail("no_input"); }
    if(a4.len == 0) { return fail("no_output"); }
    let tr:i32 = 0;
    if(_zag_strcmp(a1, "vflip") == 1) { tr = 1; }
    if(_zag_strcmp(a1, "signflip") == 1) { tr = 2; }
    if(_zag_strcmp(a1, "fshift") == 1) { tr = 3; }
    if(tr == 0) { return fail("bad_transform"); }
    let ti:i32 = 0;
    if(_zag_strcmp(a2, "colordisc") == 1) { ti = 1; }
    if(_zag_strcmp(a2, "colorconst") == 1) { ti = 1; }
    if(_zag_strcmp(a2, "shapetrans") == 1) { ti = 1; }
    if(_zag_strcmp(a2, "pitchdisc") == 1) { ti = 2; }
    if(_zag_strcmp(a2, "timbredisc") == 1) { ti = 2; }
    if(_zag_strcmp(a2, "motiondir") == 1) { ti = 3; }
    if(ti == 0) { return fail("bad_task"); }
    if(tr == 1 && ti != 1) { return fail("transform_task_mismatch"); }
    if(tr == 2 && ti != 2) { return fail("transform_task_mismatch"); }
    if(tr == 3 && ti != 3) { return fail("transform_task_mismatch"); }
    let inp:[]u8 = nio_alloc(4194304);
    let out:[]u8 = nio_alloc(4194304);
    if(inp.len == 0) { return fail("alloc_failed"); }
    if(out.len == 0) { return fail("alloc_failed"); }
    let n:i64 = read_whole(a3, inp, 4194304);
    if(n < 12) { return fail("read_failed"); }
    let rc:i32 = -9;
    if(tr == 1) { rc = t_vflip(inp, out, n as i32); }
    if(tr == 2) { rc = t_signflip(inp, out, n as i32); }
    if(tr == 3) { rc = t_fshift(inp, out, n as i32); }
    if(rc != 0) { return fail("transform_failed"); }
    let w:i64 = write_whole(a4, out, n as i32);
    if(w != n) { return fail("write_failed"); }
    return 0;
}

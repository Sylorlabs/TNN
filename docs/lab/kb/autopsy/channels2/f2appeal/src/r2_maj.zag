// r2_maj.zag — F2 appeal R2 majority channel (PREREG_FROZEN_F2APPEAL.md §4-R2).
// Usage: r2_maj <J> <Jn1> <Jn2> <Jn3> <Jn4> <Jn5>
// Verdict: INSTALL iff >=3 of the 5 noisy re-observation judgments agree
// with J; else WITHHOLD. Prints "agree=<0..5>" and "verdict=WITHHOLD|INSTALL".
// No truth input anywhere. Zero RNG.
// Exit 0 on success; nonzero + error= line on bad args.
//
// Build (from kb/autopsy/channels2/build):
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1 \
//     ../f2appeal/src/r2_maj.zag --no-zagd --no-analyze --no-foreground-cache \
//     -o ../f2appeal/build/r2_maj

@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = 0;
    let pre:[]u8 = "error=";
    let i:i32 = 0;
    while(i < pre.len) { ob[pos] = pre[i]; pos = pos + 1; i = i + 1; }
    i = 0;
    while(i < reason.len) { ob[pos] = reason[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

fn main() i32 {
    let j:[]u8 = _zag_arg(1);
    if(j.len == 0) { return fail("no_j"); }
    let n:i32 = 0;
    let k:i32 = 2;
    while(k <= 6) {
        let jn:[]u8 = _zag_arg(k);
        if(jn.len == 0) { return fail("no_jn"); }
        if(_zag_strcmp(jn, j) == 1) { n = n + 1; }
        k = k + 1;
    }
    let c:i32 = 0;
    if(n >= 3) { c = 1; }
    let ob:[]u8 = nio_alloc(64);
    if(ob.len == 0) { return fail("alloc_failed"); }
    let pos:i32 = 0;
    let l1:[]u8 = "agree=";
    let i:i32 = 0;
    while(i < l1.len) { ob[pos] = l1[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = (48 + n) as u8;
    pos = pos + 1;
    ob[pos] = 10; pos = pos + 1;
    let l2:[]u8 = "verdict=";
    i = 0;
    while(i < l2.len) { ob[pos] = l2[i]; pos = pos + 1; i = i + 1; }
    let v:[]u8 = "WITHHOLD";
    if(c == 1) { v = "INSTALL"; }
    i = 0;
    while(i < v.len) { ob[pos] = v[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    let l3:[]u8 = "C=";
    i = 0;
    while(i < l3.len) { ob[pos] = l3[i]; pos = pos + 1; i = i + 1; }
    if(c == 1) { ob[pos] = 49; } else { ob[pos] = 48; }
    pos = pos + 1;
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 0;
}

// r4_noise.zag — F2 appeal R4 structured-noise instrument
// (PREREG_FROZEN_F2APPEAL.md §4-R4). Two honest structured variants at the
// C3 amplitude (pcm ±300, img/vid ±8):
//   V1 block/frame-correlated (exposure/gain-drift model): one delta per
//      img row / vid frame / pcm 64-sample block, applied to every payload
//      element of the block. MASTER = 20260923, stream = 920 + task_idx.
//   V2 ternary: per-element delta in {-A, 0, +A} (A = 300 pcm / 8 img).
//      MASTER = 20260923, stream = 930 + task_idx.
// Headers preserved verbatim. Streams reset per fixture. Zero RNG.
// 2x runs byte-identical.
//
// Usage: r4_noise <task> <variant 1|2> <in-fixture> <out-path>
// Exit 0 on success (silent); nonzero + "error=<reason>" line on failure.
//
// Build (from kb/autopsy/channels2/build):
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1 \
//     ../f2appeal/src/r4_noise.zag --no-zagd --no-analyze --no-foreground-cache \
//     -o ../f2appeal/build/r4_noise
//
// splitmix64 workarounds W1-W4 identical to frozen c3_noise.zag (proven
// 2026-09-22 draw-by-draw against the harness Python splitmix64).

@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn lshr30(v:u64) u64 {
    let a:u64 = v >> 30;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 34); }
    return a;
}
fn lshr27(v:u64) u64 {
    let a:u64 = v >> 27;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 37); }
    return a;
}
fn lshr31(v:u64) u64 {
    let a:u64 = v >> 31;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 33); }
    return a;
}
fn lshr32(v:u64) u64 {
    let a:u64 = v >> 32;
    if((v & 9223372036854775808) != (0 as u64)) { return a ^ (18446744073709551615 << 32); }
    return a;
}

fn sm_draw(st:*u64) u64 {
    let inc:u64 = 11400714819323198485;
    let c1:u64 = 13787848793156543929;
    let c2:u64 = 10723151780598845931;
    st.* = st.* + inc;
    let z:u64 = st.*;
    let t1:u64 = z ^ lshr30(z);
    let m1:u64 = t1 * c1;
    let t2:u64 = m1 ^ lshr27(m1);
    let m2:u64 = t2 * c2;
    return m2 ^ lshr31(m2);
}

fn sm_step(x:u64) u64 {
    let inc:u64 = 11400714819323198485;
    let c1:u64 = 13787848793156543929;
    let c2:u64 = 10723151780598845931;
    let s:u64 = x + inc;
    let t1:u64 = s ^ lshr30(s);
    let m1:u64 = t1 * c1;
    let t2:u64 = m1 ^ lshr27(m1);
    let m2:u64 = t2 * c2;
    return m2 ^ lshr31(m2);
}

fn sm_seed(master:u64, stream:u64) u64 {
    let inc:u64 = 11400714819323198485;
    let h:u64 = sm_step(master ^ (stream * inc));
    return sm_step(h);
}

fn draw_below(st:*u64, m:i64) i64 {
    let n:u64 = sm_draw(st);
    let hi:u64 = lshr32(n);
    let lo:u64 = n & 4294967295;
    let c:i64 = 4294967296 % m;
    let hm:i64 = (hi as i64) % m;
    let lm:i64 = (lo as i64) % m;
    let r:i64 = (hm * c + lm) % m;
    return r;
}

fn g32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn read_whole(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

fn write_whole(path:[]u8, buf:[]u8, n:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7501; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 438, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7502; }
    let w:i64 = nio_write_all(fd, buf[0..n]);
    nio_close(fd);
    return w;
}

fn copy_hdr(inp:[]u8, out:[]u8, n:i32) void {
    let i:i32 = 0;
    while(i < n) { out[i] = inp[i]; i = i + 1; }
}

fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = 0;
    let pre:[]u8 = "error=";
    let i:i32 = 0;
    while(i < pre.len) { ob[pos] = pre[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

fn clamp_u8(v:i64) u8 {
    if(v < 0) { return 0 as u8; }
    if(v > 255) { return 255 as u8; }
    return v as u8;
}

fn clamp_s16(v:i64) i64 {
    if(v < -32768) { return -32768; }
    if(v > 32767) { return 32767; }
    return v;
}

fn put_s16_le(out:[]u8, at:i64, sv:i64) void {
    let uv:i64 = sv;
    if(uv < 0) { uv = uv + 65536; }
    out[at as i32] = (uv & 255) as u8;
    out[(at + 1) as i32] = ((uv >> 8) & 255) as u8;
}

fn get_s16_le(inp:[]u8, at:i64) i64 {
    let lo:i64 = inp[at as i32] as i64;
    let hix:i64 = inp[(at + 1) as i32] as i64;
    let sv:i64 = lo | (hix << 8);
    if(sv >= 32768) { sv = sv - 65536; }
    return sv;
}

// V1 correlated: one delta per img row
fn v1_img(inp:[]u8, out:[]u8, n:i32, st:*u64) i32 {
    let w:i64 = g32(inp, 0);
    let h:i64 = g32(inp, 4);
    if(w < 1 || h < 1) { return -1; }
    if(w > 4096 || h > 4096) { return -1; }
    let want:i64 = 8 + w * h * 3;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let y:i64 = 0;
    while(y < h) {
        let d:i64 = draw_below(st, 17) - 8;
        let x:i64 = 0;
        while(x < w) {
            let c:i64 = 0;
            while(c < 3) {
                let at:i64 = 8 + (y * w + x) * 3 + c;
                let v:i64 = (inp[at as i32] as i64) + d;
                out[at as i32] = clamp_u8(v);
                c = c + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

// V1 correlated: one delta per pcm 64-sample block
fn v1_pcm(inp:[]u8, out:[]u8, n:i32, st:*u64) i32 {
    let count:i64 = g32(inp, 4);
    if(count < 1) { return -1; }
    if(count > 4000000) { return -1; }
    let want:i64 = 8 + count * 2;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let b:i64 = 0;
    while(b * 64 < count) {
        let d:i64 = draw_below(st, 601) - 300;
        let k:i64 = 0;
        while(k < 64) {
            let i:i64 = b * 64 + k;
            if(i < count) {
                let at:i64 = 8 + i * 2;
                let sv:i64 = get_s16_le(inp, at);
                put_s16_le(out, at, clamp_s16(sv + d));
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return 0;
}

// V1 correlated: one delta per vid frame
fn v1_vid(inp:[]u8, out:[]u8, n:i32, st:*u64) i32 {
    let f:i64 = g32(inp, 0);
    let w:i64 = g32(inp, 4);
    let h:i64 = g32(inp, 8);
    if(f < 1 || w < 1 || h < 1) { return -1; }
    if(f > 64 || w > 4096 || h > 4096) { return -1; }
    let fsz:i64 = w * h * 3;
    let want:i64 = 12 + f * fsz;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 12);
    let k:i64 = 0;
    while(k < f) {
        let d:i64 = draw_below(st, 17) - 8;
        let j:i64 = 0;
        while(j < fsz) {
            let at:i64 = 12 + k * fsz + j;
            let v:i64 = (inp[at as i32] as i64) + d;
            out[at as i32] = clamp_u8(v);
            j = j + 1;
        }
        k = k + 1;
    }
    return 0;
}

// V2 ternary: per-element delta in {-A, 0, +A}
fn v2_img(inp:[]u8, out:[]u8, n:i32, st:*u64) i32 {
    let w:i64 = g32(inp, 0);
    let h:i64 = g32(inp, 4);
    if(w < 1 || h < 1) { return -1; }
    if(w > 4096 || h > 4096) { return -1; }
    let want:i64 = 8 + w * h * 3;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let i:i64 = 8;
    while(i < (n as i64)) {
        let t:i64 = draw_below(st, 3);
        let d:i64 = (t - 1) * 8;
        let v:i64 = (inp[i as i32] as i64) + d;
        out[i as i32] = clamp_u8(v);
        i = i + 1;
    }
    return 0;
}

fn v2_pcm(inp:[]u8, out:[]u8, n:i32, st:*u64) i32 {
    let count:i64 = g32(inp, 4);
    if(count < 1) { return -1; }
    if(count > 4000000) { return -1; }
    let want:i64 = 8 + count * 2;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 8);
    let i:i64 = 0;
    while(i < count) {
        let at:i64 = 8 + i * 2;
        let sv:i64 = get_s16_le(inp, at);
        let t:i64 = draw_below(st, 3);
        let d:i64 = (t - 1) * 300;
        put_s16_le(out, at, clamp_s16(sv + d));
        i = i + 1;
    }
    return 0;
}

fn v2_vid(inp:[]u8, out:[]u8, n:i32, st:*u64) i32 {
    let f:i64 = g32(inp, 0);
    let w:i64 = g32(inp, 4);
    let h:i64 = g32(inp, 8);
    if(f < 1 || w < 1 || h < 1) { return -1; }
    if(f > 64 || w > 4096 || h > 4096) { return -1; }
    let fsz:i64 = w * h * 3;
    let want:i64 = 12 + f * fsz;
    if(want != (n as i64)) { return -2; }
    copy_hdr(inp, out, 12);
    let i:i64 = 12;
    while(i < (n as i64)) {
        let t:i64 = draw_below(st, 3);
        let d:i64 = (t - 1) * 8;
        let v:i64 = (inp[i as i32] as i64) + d;
        out[i as i32] = clamp_u8(v);
        i = i + 1;
    }
    return 0;
}

fn task_idx(t:[]u8) i32 {
    if(_zag_strcmp(t, "colordisc") == 1) { return 0; }
    if(_zag_strcmp(t, "colorconst") == 1) { return 1; }
    if(_zag_strcmp(t, "shapetrans") == 1) { return 2; }
    if(_zag_strcmp(t, "pitchdisc") == 1) { return 3; }
    if(_zag_strcmp(t, "timbredisc") == 1) { return 4; }
    if(_zag_strcmp(t, "motiondir") == 1) { return 5; }
    return -1;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let a4:[]u8 = _zag_arg(4);
    if(a1.len == 0) { return fail("no_task"); }
    if(a2.len == 0) { return fail("no_variant"); }
    if(a3.len == 0) { return fail("no_input"); }
    if(a4.len == 0) { return fail("no_output"); }
    let ti:i32 = task_idx(a1);
    if(ti < 0) { return fail("bad_task"); }
    let va:i32 = 0;
    if(_zag_strcmp(a2, "1") == 1) { va = 1; }
    if(_zag_strcmp(a2, "2") == 1) { va = 2; }
    if(va == 0) { return fail("bad_variant"); }
    let kind:i32 = 0;
    if(ti <= 2) { kind = 1; }
    if(ti == 3 || ti == 4) { kind = 2; }
    if(ti == 5) { kind = 3; }
    let inp:[]u8 = nio_alloc(4194304);
    let out:[]u8 = nio_alloc(4194304);
    if(inp.len == 0) { return fail("alloc_failed"); }
    if(out.len == 0) { return fail("alloc_failed"); }
    let n:i64 = read_whole(a3, inp, 4194304);
    if(n < 12) { return fail("read_failed"); }
    let sb:i64 = 920;
    if(va == 2) { sb = 930; }
    let s:u64 = sm_seed(20260923, (sb as u64) + (ti as u64));
    let rc:i32 = -9;
    if(va == 1 && kind == 1) { rc = v1_img(inp, out, n as i32, &s); }
    if(va == 1 && kind == 2) { rc = v1_pcm(inp, out, n as i32, &s); }
    if(va == 1 && kind == 3) { rc = v1_vid(inp, out, n as i32, &s); }
    if(va == 2 && kind == 1) { rc = v2_img(inp, out, n as i32, &s); }
    if(va == 2 && kind == 2) { rc = v2_pcm(inp, out, n as i32, &s); }
    if(va == 2 && kind == 3) { rc = v2_vid(inp, out, n as i32, &s); }
    if(rc != 0) { return fail("noise_failed"); }
    let w:i64 = write_whole(a4, out, n as i32);
    if(w != n) { return fail("write_failed"); }
    return 0;
}

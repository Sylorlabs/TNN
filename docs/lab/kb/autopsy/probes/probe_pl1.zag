// PROBE P-L1 — kb4_gate.zag with the L8 repetition bonus REMOVED.
// (learning-rule probe: same single-channel architecture, same stimulus
//  binding; only the install rule changes.)
// (delib.zag's gate mode segfaults; this is a clean minimal implementation
// of the SAME frozen contract, not a new protocol.)
//
// Pure Zag, zero RNG, deterministic given the batch file.
//
// Batch lines: stim_idx \t judg_idx \t confidence \t source_id
//   (integer IDs assigned deterministically by gen_batch.py; the gate
//    never sees ground truth — no truth column exists in the batch.)
//
// Per line, as utterance "stimulus S perceived as J":
//   L1: source track record: +5 (good) / -5 (bad; bad iff a record from
//       this source was demoted).
//   Confidence: +1 per 10 confidence points, capped at +10 (D1 lesson:
//       confidence is a self-report, not truth).
//   L4: conflicting endorsed judgment on same stimulus -> re-deliberate
//       by evidence strength (new wins iff strictly greater; else WITHHOLD).
//       Consistent (same) judgment: +10.
//   L8: same judgment repeated across variants: +20 per prior occurrence.
// Output per line: INSTALL or WITHHOLD, with audit fields.
// State persists across lines; order = file order, deterministic.
@import("R33_NATIVE_IO_V1.zag")

// ---------- tiny I/O ----------
// We reuse the proven pattern: open root, open child, read all.
fn g_in_open(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root,name,0);
    if(fd<0){ return ""; }
    let buf:[]u8=nio_alloc(8388608);
    if(buf.len==0){ nio_close(fd); return ""; }
    let n:i64=nio_read_exact(fd,buf,8388608);
    nio_close(fd);
    if(n<=0){ return ""; }
    let s:[]u8=buf[0..n as i32];
    return s;
}

fn g_parse_int(b:[]u8, st:i32, en:i32)i32 {
    let v:i32=0;
    let i:i32=st;
    while(i<en){
        let ch:i32=b[i] as i32;
        if(ch>=48 && ch<=57){ v=v*10+(ch-48); }
        i=i+1;
    }
    return v;
}

// ---------- main ----------
fn main()void {
    let workdir:[]u8=_zag_arg(1);
    let batchname:[]u8=_zag_arg(2);
    let nstim:i32=g_parse_int(_zag_arg(3),0,_zag_arg(3).len);
    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_println("ERR workdir"); return; }
    let b:[]u8=g_in_open(root,batchname);
    nio_close(root);
    if(b.len==0){ _zag_println("ERR batch"); return; }

    // state
    let endorsed:[]u8=nio_alloc(nstim*4);
    let endorsed_ev:[]u8=nio_alloc(nstim*4);
    let hist_n:[]u8=nio_alloc(nstim*4);
    let hist_j:[]u8=nio_alloc(nstim*3*4);
    let s:i32=0;
    while(s<nstim){
        put32(endorsed,s,-1);
        put32(endorsed_ev,s,0);
        put32(hist_n,s,0);
        s=s+1;
    }
    let src_bad:i32=0;

    // split lines and process
    let i:i32=0;
    let st:i32=0;
    let n_install:i32=0;
    let n_withhold:i32=0;
    while(i<=b.len){
        let eol:i32=0;
        if(i==b.len){ eol=1; }
        else if(b[i]==10){ eol=1; }
        if(eol==1){
            if(i>st){
                // parse 4 tab fields
                let f0:i32=-1; let f1:i32=-1; let f2:i32=-1; let f3:i32=-1;
                let p0:i32=st; let p1:i32=st; let p2:i32=st; let p3:i32=st;
                let k:i32=st;
                let fc:i32=0;
                while(k<i){
                    if(b[k]==9){
                        if(fc==0){ f0=p0; p1=k+1; }
                        else if(fc==1){ f1=p1; p2=k+1; }
                        else if(fc==2){ f2=p2; p3=k+1; }
                        fc=fc+1;
                    }
                    k=k+1;
                }
                // last field
                f3=p3;
                let stim:i32=g_parse_int(b,f0,p1-1);
                let judg:i32=g_parse_int(b,f1,p2-1);
                let conf:i32=g_parse_int(b,f2,p3-1);
                let src:i32=g_parse_int(b,f3,i);
                // ---- gate logic (§6) ----
                let boost:i32=conf/10;
                if(boost>10){ boost=10; }
                let l1:i32=5;
                if(src_bad==1){ l1=-5; }
                let ev:i32=l1+boost;
                // P-L1: L8 repetition bonus REMOVED (autopsy probe).
                // prior same-(stim,judg) count no longer adds evidence.
                let hn:i32=get32(hist_n,stim);
                let prior:i32=0;
                let ej:i32=get32(endorsed,stim);
                let inst:i32=0;
                if(ej==-1){
                    // no endorsed yet
                    if(ev>=0){
                        inst=1;
                        put32(endorsed,stim,judg);
                        put32(endorsed_ev,stim,ev);
                    }
                }
                else if(ej==judg){
                    // consistent
                    ev=ev+10;
                    if(ev>=0){ inst=1; }
                    // strengthen endorsed with corroboration
                    put32(endorsed_ev,stim,get32(endorsed_ev,stim)+10);
                }
                else {
                    // conflict: re-deliberate by evidence strength
                    // new ev (without the L8 already added? L8 was for same judg;
                    //  for conflict, prior is 0 since judg != ej, so ev = l1+boost)
                    let eev:i32=get32(endorsed_ev,stim);
                    if(ev>eev){
                        // new wins: demote old
                        put32(endorsed,stim,judg);
                        put32(endorsed_ev,stim,ev);
                        src_bad=1;
                        inst=1;
                    }
                    else {
                        inst=0;
                    }
                }
                // record in history
                if(hn<3){
                    put32(hist_j,stim*3+hn,judg);
                    put32(hist_n,stim,hn+1);
                }
                // output
                let so:[]u8=_zag_i64_to_str(stim as i64);
                let jo:[]u8=_zag_i64_to_str(judg as i64);
                let eo:[]u8=_zag_i64_to_str(ev as i64);
                _zag_print(so); _zag_print("\t");
                _zag_print(jo); _zag_print("\t");
                if(inst==1){ _zag_print("INSTALL\t"); n_install=n_install+1; }
                else { _zag_print("WITHHOLD\t"); n_withhold=n_withhold+1; }
                _zag_println(eo);
            }
            st=i+1;
        }
        i=i+1;
    }
    let ni:[]u8=_zag_i64_to_str(n_install as i64);
    let nw:[]u8=_zag_i64_to_str(n_withhold as i64);
    _zag_print("SUMMARY\t"); _zag_print(ni); _zag_print("\t"); _zag_println(nw);
    return;
}

// ---------- u32 accessors (little-endian, []u8 arena) ----------
fn put32(a:[]u8, idx:i32, v:i32)void {
    let o:i32=idx*4;
    // store as unsigned 32-bit little-endian
    let uv:i64=v as i64;
    if(uv<0){ uv=uv+4294967296; }
    a[o]=(uv & 255) as u8;
    a[o+1]=((uv/256) & 255) as u8;
    a[o+2]=((uv/65536) & 255) as u8;
    a[o+3]=((uv/16777216) & 255) as u8;
    return;
}
fn get32(a:[]u8, idx:i32)i32 {
    let o:i32=idx*4;
    let b0:i64=a[o] as i64;
    let b1:i64=a[o+1] as i64;
    let b2:i64=a[o+2] as i64;
    let b3:i64=a[o+3] as i64;
    let uv:i64=b0+b1*256+b2*65536+b3*16777216;
    if(uv>=2147483648){ uv=uv-4294967296; }
    return uv as i32;
}

// PROBE P-A1 — cross-sense corroborated install gate (autopsy probe).
//
// Architecture probe: adds a SECOND information channel. Two senses judge
// the same (stimulus, variant):
//   channel A = Approach A (LLM-style raw values)
//   channel B = Approach B (human-style qualitative percepts)
// Install rule on adversarial fixtures: INSTALL iff the two channels AGREE
// on the judgment (corroborated); WITHHOLD on disagreement (no
// corroboration). Primary/noise fixtures: INSTALL (not scored; mirrors the
// baseline's near-always-install on primaries).
//
// This is the KB4 analogue of the wave-5 corroborated-elimination
// architecture (rt2 DEFENSE.md): a decision requires corroboration across
// channels rather than a single channel's verdict.
//
// Batch lines: stim_idx \t judgA_idx \t judgB_idx \t confidence \t variant
//   variant: 0=primary, 1=noise, 2=adversarial
// Output per line: INSTALL or WITHHOLD. State: none (pure function of the
// line). Zero RNG. Deterministic.
@import("R33_NATIVE_IO_V1.zag")

fn g_in_open(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root,name,0);
    if(fd<0){ return ""; }
    let buf:[]u8=nio_alloc(8388608);
    if(buf.len==0){ nio_close(fd); return ""; }
    let n:i64=nio_read_exact(fd,buf,8388608);
    nio_close(fd);
    if(n<=0){ return ""; }
    let s:[]u8=buf[0..n as i32];
    return s;
}

fn g_parse_int(b:[]u8, st:i32, en:i32)i32 {
    let v:i32=0;
    let i:i32=st;
    while(i<en){
        let ch:i32=b[i] as i32;
        if(ch>=48 && ch<=57){ v=v*10+(ch-48); }
        i=i+1;
    }
    return v;
}

fn main()void {
    let workdir:[]u8=_zag_arg(1);
    let batchname:[]u8=_zag_arg(2);
    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_println("ERR workdir"); return; }
    let b:[]u8=g_in_open(root,batchname);
    nio_close(root);
    if(b.len==0){ _zag_println("ERR batch"); return; }

    let n_install:i32=0;
    let n_withhold:i32=0;
    let i:i32=0;
    let st:i32=0;
    while(i<=b.len){
        let eol:i32=0;
        if(i==b.len){ eol=1; }
        else if(b[i]==10){ eol=1; }
        if(eol==1){
            if(i>st){
                // parse 5 tab fields: f0..f4 = field starts
                let f0:i32=st; let f1:i32=-1; let f2:i32=-1;
                let f3:i32=-1; let f4:i32=-1;
                let fc:i32=0;
                let k:i32=st;
                while(k<i){
                    if(b[k]==9){
                        if(fc==0){ f1=k+1; }
                        else if(fc==1){ f2=k+1; }
                        else if(fc==2){ f3=k+1; }
                        else if(fc==3){ f4=k+1; }
                        fc=fc+1;
                    }
                    k=k+1;
                }
                let stim:i32=g_parse_int(b,f0,f1-1);
                let ja:i32=g_parse_int(b,f1,f2-1);
                let jb:i32=g_parse_int(b,f2,f3-1);
                let cf:i32=g_parse_int(b,f3,f4-1);
                let vr:i32=g_parse_int(b,f4,i);
                // ---- P-A1 gate ----
                let inst:i32=0;
                if(vr==2){
                    // adversarial: install iff channels agree
                    if(ja==jb){ inst=1; }
                }
                else {
                    // primary/noise: install (not scored)
                    inst=1;
                }
                let so:[]u8=_zag_i64_to_str(stim as i64);
                _zag_print(so); _zag_print("\t");
                if(inst==1){ _zag_print("INSTALL"); n_install=n_install+1; }
                else { _zag_print("WITHHOLD"); n_withhold=n_withhold+1; }
                _zag_print("\t"); _zag_println(_zag_i64_to_str(cf as i64));
            }
            st=i+1;
        }
        i=i+1;
    }
    _zag_print("SUMMARY\t");
    _zag_print(_zag_i64_to_str(n_install as i64));
    _zag_print("\t");
    _zag_println(_zag_i64_to_str(n_withhold as i64));
    return;
}

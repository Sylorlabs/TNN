// PACKAGE 2 — channel shootout runner (frozen PREREG_FROZEN_CHANNEL_SHOOTOUT.md).
//
// Single binary. Calibrates all channels on CALIBRATION rows, then emits
// per-fixture verdicts + feature bindings for TEST adversarial fixtures
// of one target sense.
//
// argv: 1=workdir 2=batchA 3=batchB 4=stimclass 5=split 6=variantA 7=variantB
//       8=calrows_T 9=sense("A"/"B")
// stdout:
//   CAL \t class \t agree \t n \t ncorrect \t pm
//   PRIOR \t class \t pi_pm \t pagree_pres_pm \t pagree_chg_pm \t pjpcorr_pm
//   THR \t d1|d2 \t t \t orient        (orient 0=INSTALL iff x>=t, 1=INSTALL iff x<t)
//   F \t stim \t class \t agree_pa \t conf_a \t conf_p \t agree_noise \t agree_ab
//       \t va \t vb \t vc \t vd1 \t vd2 \t vac \t vab
// verdicts: 0=WITHHOLD 1=INSTALL 2=SUSPECT
//
// Pure Zag, zero RNG, deterministic. All integer tables live in one []u8
// arena with explicit little-endian put/get (znc ZNC-2026-09-21-007:
// consecutive same-size `as []i32` casts miscompile indexed access).
@import("R33_NATIVE_IO_V1.zag")


// biased i32 cell store (bias keeps every value non-negative)
fn a_put(ar:[]u8, o:i64, v:i32)void {
    let b:i64=v as i64+1000000;
    let b0:i64=b-((b>>8)<<8);
    let b1:i64=(b>>8)-(((b>>8)>>8)<<8);
    let b2:i64=(b>>16)-(((b>>16)>>8)<<8);
    let b3:i64=b>>24;
    ar[o]=b0 as u8;
    ar[o+1]=b1 as u8;
    ar[o+2]=b2 as u8;
    ar[o+3]=b3 as u8;
    return;
}
fn a_get(ar:[]u8, o:i64)i32 {
    let p0:i64=ar[o] as i64;
    let p1:i64=ar[o+1] as i64;
    let p2:i64=ar[o+2] as i64;
    let p3:i64=ar[o+3] as i64;
    let b:i64=p0+p1*256+p2*65536+p3*16777216;
    return (b-1000000) as i32;
}
fn a_fill(ar:[]u8, base:i64, n:i32, v:i32)void {
    let i:i32=0;
    while(i<n){ a_put(ar, base+i as i64*4, v); i=i+1; }
    return;
}

fn g_in_open(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root,name,0);
    if(fd<0){ return ""; }
    let buf:[]u8=nio_alloc(8388608);
    if(buf.len==0){ nio_close(fd); return ""; }
    let n:i64=nio_read_exact(fd,buf,8388608);
    nio_close(fd);
    if(n<=0){ return ""; }
    let s:[]u8=buf[0..n as i32];
    return s;
}

fn g_parse_int(b:[]u8, st:i32, en:i32)i32 {
    let v:i32=0;
    let i:i32=st;
    while(i<en){
        let ch:i32=b[i] as i32;
        if(ch>=48 && ch<=57){ v=v*10+(ch-48); }
        i=i+1;
    }
    return v;
}

// strip one trailing newline (znc emits _zag_i64_to_str with \n in helpers)
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        let last:u8=s[s.len-1];
        if(last==10){ return s[0..s.len-1]; }
    }
    return s;
}
fn ptab()void { _zag_print("\t"); return; }
fn pnum(v:i32)void { _zag_print(i64s(v as i64)); return; }

// parse tab-separated file: nfields per line; row ln -> dst[ln*nfields+f].
// returns line count (negative on error).
fn load_tsv(ar:[]u8, root:i64, name:[]u8, dst:i64, nfields:i32, maxln:i32)i32 {
    let b:[]u8=g_in_open(root,name);
    if(b.len==0){ return -1; }
    let ln:i32=0;
    let i:i32=0;
    let st:i32=0;
    while(i<=b.len){
        let eol:i32=0;
        if(i==b.len){ eol=1; }
        if(eol==0){ let c:u8=b[i]; if(c==10){ eol=1; } }
        if(eol==1){
            if(i>st){
                if(ln>=maxln){ return -2; }
                let fs:i32=st;
                let f:i32=0;
                let k:i32=st;
                while(k<=i){
                    let brk:i32=0;
                    if(k==i){ brk=1; }
                    if(brk==0){ let c2:u8=b[k]; if(c2==9){ brk=1; } }
                    if(brk==1){
                        if(f<nfields){
                            let v:i32=g_parse_int(b,fs,k);
                            a_put(ar, dst+(ln*nfields+f) as i64*4, v);
                        }
                        f=f+1;
                        fs=k+1;
                    }
                    k=k+1;
                }
                ln=ln+1;
            }
            st=i+1;
        }
        i=i+1;
    }
    return ln;
}

// insertion sort of n i32 cells at base (ascending)
fn isort(ar:[]u8, base:i64, n:i32)void {
    let i:i32=1;
    while(i<n){
        let key:i32=a_get(ar, base+i as i64*4);
        let j:i32=i-1;
        let mv:i32=1;
        while(mv==1){
            if(j<0){ mv=0; }
            if(mv==1){
                let aj:i32=a_get(ar, base+j as i64*4);
                if(aj<=key){ mv=0; }
                if(mv==1){ a_put(ar, base+(j+1) as i64*4, aj); j=j-1; }
            }
        }
        a_put(ar, base+(j+1) as i64*4, key);
        i=i+1;
    }
    return;
}

fn main()void {
    let workdir:[]u8=_zag_arg(1);
    let batchA:[]u8=_zag_arg(2);
    let batchB:[]u8=_zag_arg(3);
    let fclass:[]u8=_zag_arg(4);
    let fsplit:[]u8=_zag_arg(5);
    let fvarA:[]u8=_zag_arg(6);
    let fvarB:[]u8=_zag_arg(7);
    let fcal:[]u8=_zag_arg(8);
    let sensen:[]u8=_zag_arg(9);
    let target:i32=1;
    if(sensen.len>0){ let c0:u8=sensen[0]; if(c0==65){ target=0; } }

    let arena:[]u8=nio_alloc(1048576);
    let MAXLINE:i32=2048;
    let MAXSTIM:i32=512;
    let ba_s:i64=0;
    let ba_j:i64=8192;
    let ba_c:i64=16384;
    let bb_s:i64=24576;
    let bb_j:i64=32768;
    let bb_c:i64=40960;
    let btmp:i64=49152;
    let varA:i64=114688;
    let varB:i64=122880;
    let t_prim:i64=131072;
    let t_noise:i64=133120;
    let t_adv:i64=135168;
    let o_adv:i64=137216;
    let sclass:i64=139264;
    let splitv:i64=141312;
    let cell_n:i64=143360;
    let cell_c:i64=143408;
    let cl_n:i64=143456;
    let cl_pres:i64=143480;
    let cl_ag:i64=143504;
    let cl_agpr:i64=143528;
    let cl_pcorr:i64=143552;
    let confs:i64=143576;
    let deltas:i64=144600;
    a_fill(arena, t_prim,MAXSTIM,-1);
    a_fill(arena, t_noise,MAXSTIM,-1);
    a_fill(arena, t_adv,MAXSTIM,-1);
    a_fill(arena, o_adv,MAXSTIM,-1);
    a_fill(arena, varA,MAXLINE,-1);
    a_fill(arena, varB,MAXLINE,-1);
    a_fill(arena, sclass,MAXSTIM,2);
    a_fill(arena, splitv,MAXSTIM,2);
    a_fill(arena, cell_n,12,0);
    a_fill(arena, cell_c,12,0);
    a_fill(arena, cl_n,6,0);
    a_fill(arena, cl_pres,6,0);
    a_fill(arena, cl_ag,6,0);
    a_fill(arena, cl_agpr,6,0);
    a_fill(arena, cl_pcorr,6,0);

    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_println("ERR workdir"); return; }

    let na:i32=load_tsv(arena, root,batchA,btmp,4,MAXLINE);
    let i:i32=0;
    while(i<na){
        a_put(arena, ba_s+i as i64*4, a_get(arena, btmp+(i*4+0) as i64*4));
        a_put(arena, ba_j+i as i64*4, a_get(arena, btmp+(i*4+1) as i64*4));
        a_put(arena, ba_c+i as i64*4, a_get(arena, btmp+(i*4+2) as i64*4));
        i=i+1;
    }
    let nb:i32=load_tsv(arena, root,batchB,btmp,4,MAXLINE);
    i=0;
    while(i<nb){
        a_put(arena, bb_s+i as i64*4, a_get(arena, btmp+(i*4+0) as i64*4));
        a_put(arena, bb_j+i as i64*4, a_get(arena, btmp+(i*4+1) as i64*4));
        a_put(arena, bb_c+i as i64*4, a_get(arena, btmp+(i*4+2) as i64*4));
        i=i+1;
    }
    if(na<0 || nb<0){ _zag_println("ERR batch"); return; }

    let nva:i32=load_tsv(arena, root,fvarA,btmp,2,MAXLINE);
    i=0;
    while(i<nva){
        let ln:i32=a_get(arena, btmp+(i*2+0) as i64*4);
        a_put(arena, varA+ln as i64*4, a_get(arena, btmp+(i*2+1) as i64*4));
        i=i+1;
    }
    let nvb:i32=load_tsv(arena, root,fvarB,btmp,2,MAXLINE);
    i=0;
    while(i<nvb){
        let ln2:i32=a_get(arena, btmp+(i*2+0) as i64*4);
        a_put(arena, varB+ln2 as i64*4, a_get(arena, btmp+(i*2+1) as i64*4));
        i=i+1;
    }
    let ncl:i32=load_tsv(arena, root,fclass,btmp,2,MAXSTIM);
    i=0;
    while(i<ncl){
        let stc:i32=a_get(arena, btmp+(i*2+0) as i64*4);
        a_put(arena, sclass+stc as i64*4, a_get(arena, btmp+(i*2+1) as i64*4));
        i=i+1;
    }
    let nsp:i32=load_tsv(arena, root,fsplit,btmp,2,MAXSTIM);
    i=0;
    while(i<nsp){
        let sts:i32=a_get(arena, btmp+(i*2+0) as i64*4);
        a_put(arena, splitv+sts as i64*4, a_get(arena, btmp+(i*2+1) as i64*4));
        i=i+1;
    }

    // sense-local arrays
    let ts_s:i64=ba_s; let ts_j:i64=ba_j; let ts_c:i64=ba_c;
    let ts_v:i64=varA; let tn:i32=na;
    let os_j2:i64=bb_j; let os_s2:i64=bb_s; let os_v:i64=varB; let on2:i32=nb;
    if(target==1){
        ts_s=bb_s; ts_j=bb_j; ts_c=bb_c; ts_v=varB; tn=nb;
        os_j2=ba_j; os_s2=ba_s; os_v=varA; on2=na;
    }
    // target-sense per-stim lookups
    i=0;
    while(i<tn){
        let st4:i32=a_get(arena, ts_s+i as i64*4);
        let vv:i32=a_get(arena, ts_v+i as i64*4);
        if(st4>=0 && st4<MAXSTIM){
            if(vv==0){ a_put(arena, t_prim+st4 as i64*4, i); }
            if(vv==1){ a_put(arena, t_noise+st4 as i64*4, i); }
            if(vv==2){ a_put(arena, t_adv+st4 as i64*4, i); }
        }
        i=i+1;
    }
    // other-sense adv lookups
    i=0;
    while(i<on2){
        let sto:i32=a_get(arena, os_s2+i as i64*4);
        let vvo:i32=a_get(arena, os_v+i as i64*4);
        if(sto>=0 && sto<MAXSTIM){
            if(vvo==2){ a_put(arena, o_adv+sto as i64*4, i); }
        }
        i=i+1;
    }

    // ---- calibration from calrows_T: stim class agree conf_a conf_p pres correct pcorr
    let ncr:i32=load_tsv(arena, root,fcal,btmp,8,256);
    if(ncr<0){ _zag_println("ERR calrows"); return; }
    i=0;
    while(i<ncr){
        let cl:i32=a_get(arena, btmp+(i*8+1) as i64*4);
        let ag:i32=a_get(arena, btmp+(i*8+2) as i64*4);
        let ca:i32=a_get(arena, btmp+(i*8+3) as i64*4);
        let cp:i32=a_get(arena, btmp+(i*8+4) as i64*4);
        let pr:i32=a_get(arena, btmp+(i*8+5) as i64*4);
        let co:i32=a_get(arena, btmp+(i*8+6) as i64*4);
        let pc:i32=a_get(arena, btmp+(i*8+7) as i64*4);
        let cell:i32=cl*2+ag;
        a_put(arena, cell_n+cell as i64*4, a_get(arena, cell_n+cell as i64*4)+1);
        a_put(arena, cell_c+cell as i64*4, a_get(arena, cell_c+cell as i64*4)+co);
        a_put(arena, cl_n+cl as i64*4, a_get(arena, cl_n+cl as i64*4)+1);
        a_put(arena, cl_pres+cl as i64*4, a_get(arena, cl_pres+cl as i64*4)+pr);
        a_put(arena, cl_ag+cl as i64*4, a_get(arena, cl_ag+cl as i64*4)+ag);
        a_put(arena, cl_agpr+cl as i64*4, a_get(arena, cl_agpr+cl as i64*4)+ag*pr);
        a_put(arena, cl_pcorr+cl as i64*4, a_get(arena, cl_pcorr+cl as i64*4)+pc);
        a_put(arena, confs+i as i64*4, ca);
        a_put(arena, deltas+i as i64*4, ca-cp);
        i=i+1;
    }

    // (d1) median threshold + orientation on calibration
    isort(arena, confs,ncr);
    let t1:i32=a_get(arena, confs+((ncr-1)/2) as i64*4);
    let g1:i32=0; let l1:i32=0;
    i=0;
    while(i<ncr){
        let ca2:i32=a_get(arena, btmp+(i*8+3) as i64*4);
        let co2:i32=a_get(arena, btmp+(i*8+6) as i64*4);
        let vge:i32=0; if(ca2>=t1){ vge=1; }
        let vlt:i32=0; if(ca2<t1){ vlt=1; }
        if(vge==co2){ g1=g1+1; }
        if(vlt==co2){ l1=l1+1; }
        i=i+1;
    }
    let or1:i32=1;
    if(g1>l1){ or1=0; }
    // (d2) same on delta
    isort(arena, deltas,ncr);
    let t2:i32=a_get(arena, deltas+((ncr-1)/2) as i64*4);
    let g2:i32=0; let l2:i32=0;
    i=0;
    while(i<ncr){
        let ca3:i32=a_get(arena, btmp+(i*8+3) as i64*4);
        let cp3:i32=a_get(arena, btmp+(i*8+4) as i64*4);
        let co3:i32=a_get(arena, btmp+(i*8+6) as i64*4);
        let d:i32=ca3-cp3;
        let wge:i32=0; if(d>=t2){ wge=1; }
        let wlt:i32=0; if(d<t2){ wlt=1; }
        if(wge==co3){ g2=g2+1; }
        if(wlt==co3){ l2=l2+1; }
        i=i+1;
    }
    let or2:i32=1;
    if(g2>l2){ or2=0; }

    // ---- emit calibration tables
    let c6:i32=0;
    while(c6<6){
        let ag2:i32=0;
        while(ag2<2){
            let cell2:i32=c6*2+ag2;
            let cn:i32=a_get(arena, cell_n+cell2 as i64*4);
            let cc:i32=a_get(arena, cell_c+cell2 as i64*4);
            let pm:i32=500;
            if(cn>0){ pm=(1000*cc)/cn; }
            _zag_print("CAL"); ptab(); pnum(c6); ptab(); pnum(ag2); ptab();
            pnum(cn); ptab(); pnum(cc); ptab(); pnum(pm); _zag_println("");
            ag2=ag2+1;
        }
        let kn:i32=a_get(arena, cl_n+c6 as i64*4);
        let kpr:i32=a_get(arena, cl_pres+c6 as i64*4);
        let kag:i32=a_get(arena, cl_ag+c6 as i64*4);
        let kap:i32=a_get(arena, cl_agpr+c6 as i64*4);
        let kpc:i32=a_get(arena, cl_pcorr+c6 as i64*4);
        let pi:i32=500; let pap:i32=500; let pac:i32=500; let ppc:i32=500;
        if(kn>0){
            pi=(1000*kpr)/kn;
            ppc=(1000*kpc)/kn;
            if(kpr>0){ pap=(1000*kap)/kpr; }
            let kch:i32=kn-kpr;
            if(kch>0){ pac=(1000*(kag-kap))/kch; }
        }
        _zag_print("PRIOR"); ptab(); pnum(c6); ptab();
        pnum(pi); ptab(); pnum(pap); ptab(); pnum(pac); ptab(); pnum(ppc);
        _zag_println("");
        c6=c6+1;
    }
    _zag_print("THR"); ptab(); _zag_print("d1"); ptab(); pnum(t1); ptab(); pnum(or1); _zag_println("");
    _zag_print("THR"); ptab(); _zag_print("d2"); ptab(); pnum(t2); ptab(); pnum(or2); _zag_println("");

    // ---- test fixtures
    let nF:i32=0;
    let st5:i32=0;
    while(st5<MAXSTIM){
        if(a_get(arena, splitv+st5 as i64*4)==1){
            let la:i32=a_get(arena, t_adv+st5 as i64*4);
            let lp:i32=a_get(arena, t_prim+st5 as i64*4);
            let ln3:i32=a_get(arena, t_noise+st5 as i64*4);
            let lo:i32=a_get(arena, o_adv+st5 as i64*4);
            if(la<0 || lp<0 || ln3<0 || lo<0){
                _zag_print("SKIP"); ptab(); pnum(st5); _zag_println("");
            }
            if(la>=0 && lp>=0 && ln3>=0 && lo>=0){
                let cl5:i32=a_get(arena, sclass+st5 as i64*4);
                let ja:i32=a_get(arena, ts_j+la as i64*4);
                let jp:i32=a_get(arena, ts_j+lp as i64*4);
                let jn:i32=a_get(arena, ts_j+ln3 as i64*4);
                let jo:i32=a_get(arena, os_j2+lo as i64*4);
                let ca5:i32=a_get(arena, ts_c+la as i64*4);
                let cp5:i32=a_get(arena, ts_c+lp as i64*4);
                let agr_pa:i32=0; if(ja==jp){ agr_pa=1; }
                let agr_n:i32=0; if(jn==ja){ agr_n=1; }
                let agr_ab:i32=0; if(jo==ja){ agr_ab=1; }
                // (a)
                let cell5:i32=cl5*2+agr_pa;
                let cn5:i32=a_get(arena, cell_n+cell5 as i64*4);
                let cc5:i32=a_get(arena, cell_c+cell5 as i64*4);
                let va:i32=2;
                if(cn5>0){
                    let pm5:i32=(1000*cc5)/cn5;
                    va=2;
                    if(pm5>=600){ va=1; }
                    if(pm5<=400){ va=0; }
                }
                // (b)
                let vb:i32=0; if(agr_n==1){ vb=1; }
                // (c)
                let vc:i32=0; if(agr_ab==1){ vc=1; }
                // (d1)
                let vd1:i32=0;
                if(or1==0){ if(ca5>=t1){ vd1=1; } }
                if(or1==1){ if(ca5<t1){ vd1=1; } }
                // (d2)
                let dd:i32=ca5-cp5;
                let vd2:i32=0;
                if(or2==0){ if(dd>=t2){ vd2=1; } }
                if(or2==1){ if(dd<t2){ vd2=1; } }
                // combos
                let vac:i32=2;
                if(va==1 && vc==1){ vac=1; }
                if(va==0 && vc==0){ vac=0; }
                let vab:i32=2;
                if(va==1 && vb==1){ vab=1; }
                if(va==0 && vb==0){ vab=0; }
                _zag_print("F"); ptab(); pnum(st5); ptab(); pnum(cl5); ptab();
                pnum(agr_pa); ptab(); pnum(ca5); ptab(); pnum(cp5); ptab();
                pnum(agr_n); ptab(); pnum(agr_ab); ptab();
                pnum(va); ptab(); pnum(vb); ptab(); pnum(vc); ptab();
                pnum(vd1); ptab(); pnum(vd2); ptab(); pnum(vac); ptab(); pnum(vab);
                _zag_println("");
                nF=nF+1;
            }
        }
        st5=st5+1;
    }
    _zag_print("DONE"); ptab(); pnum(nF); _zag_println("");
    nio_close(root);
    return;
}

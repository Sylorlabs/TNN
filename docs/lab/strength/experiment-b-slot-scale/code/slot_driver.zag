// slot_driver.zag — Experiment B (slot scale), Micah 2026-09-25 ~22:41 PDT.
// "How expensive is it to scale up slots?" First variation of the slot
// count: the strength core has always run 14 user slots, never varied.
// Pure Zag, zero RNG. Timing legs measure cost only; functional legs are
// run twice and diffed byte-for-byte (timing never mixed into evidence).
//
// argv[1]: user slots: 14 | 28 | 56 | 140   (store cap = slots + 2 seeds)
// argv[2]: leg: BYTES | COST | FUNC | WEDGE | CKL
// argv[3]: (WEDGE only) pool: 8 | 16 | 32 ; (CKL only) episodes: 50|100|200|400
//
// Lines carrying the marker [CITEMODE] are stripped by the build script
// when compiling against the PRISTINE base core (which has no
// st_set_cite_mode); they are the only cite-mode call sites.
@import("strength_checker.zag")

// print i64 with no trailing newline (f6 pattern)
fn sd_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn sd_i64_get(b:[]u8,at:i32)i64 {
    let v:i64=0;let i:i32=0;
    while(i<8){v=v|((b[at+i] as i64)<<(i*8));i=i+1;}
    return v;
}
fn sd_i64_set(b:[]u8,at:i32,v:i64)void {
    let i:i32=0;
    while(i<8){b[at+i]=((v>>(i*8))&255) as u8;i=i+1;}
}
// Cost clock: CLOCK_PROCESS_CPUTIME_ID (2), not wall. The lab VM is
// shared and oversubscribed (a COST run showed real=72s vs user=3.2s:
// wall medians measured scheduler descheduling, not op cost). CPU time
// is the honest per-op cost metric here; wall contamination is documented
// in the verdict, not hidden.
fn sd_now_ns()i64 {
    let ts:[]u8=nio_alloc(16);
    let p:i64=_zag_slice_ptr(ts) as i64;
    _zag_raw_syscall(228,2,p,0,0,0,0);
    let ns:i64=sd_i64_get(ts,0)*1000000000+sd_i64_get(ts,8);
    nio_free(ts);
    return ns;
}
fn sd_slots_of(a:[]u8)i32 {
    if(_zag_strcmp(a,"28")==1){return 28;}
    if(_zag_strcmp(a,"56")==1){return 56;}
    if(_zag_strcmp(a,"140")==1){return 140;}
    return 14;
}
fn sd_new_store(ucap:i32,acap:i32)StStore {
    let s:StStore=st_init(ucap+2,acap);
    let c0:i32=0;let c1:i32=0;
    st_add_core(&s,95,-1,&c0);
    st_add_core(&s,90,-1,&c1);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
// median of R i64 samples in arena b (R*8 bytes); sorts in place
fn sd_median(b:[]u8,r:i32)i64 {
    let i:i32=1;
    while(i<r){
        let key:i64=sd_i64_get(b,i*8);
        let j:i32=i-1;
        while(j>=0 && sd_i64_get(b,j*8)>key){
            sd_i64_set(b,(j+1)*8,sd_i64_get(b,j*8));
            j=j-1;
        }
        sd_i64_set(b,(j+1)*8,key);
        i=i+1;
    }
    return sd_i64_get(b,(r/2)*8);
}
fn sd_cost_line(ucap:i32,op:[]u8,b:[]u8,r:i32)void {
    let med:i64=sd_median(b,r);
    let mn:i64=sd_i64_get(b,0);let mx:i64=sd_i64_get(b,(r-1)*8);
    _zag_print("SC_COST slots=");sd_pi(ucap as i64);
    _zag_print(" op=");_zag_print(op);
    _zag_print(" med_ns=");sd_pi(med);
    _zag_print(" min_ns=");sd_pi(mn);
    _zag_print(" max_ns=");sd_pi(mx);
    _zag_print("\n");
}

// ---------------- BYTES leg: allocation inventory ----------------
fn sd_bytes(ucap:i32)i32 {
    let cap:i32=ucap+2;
    let acap:i32=32768;
    let s:StStore=st_init(cap,acap);
    let tot:i64=0;
    let ok:i32=1;
    // slot_cap-indexed arrays, mirroring st_init's nio_alloc sizes
    let sizes:[]u8=nio_alloc(17*8);
    sd_i64_set(sizes,0*8,cap as i64);      // live
    sd_i64_set(sizes,1*8,(cap*4) as i64);  // value
    sd_i64_set(sizes,2*8,cap as i64);      // pinned
    sd_i64_set(sizes,3*8,cap as i64);      // region
    sd_i64_set(sizes,4*8,cap as i64);      // tier
    sd_i64_set(sizes,5*8,(cap*4) as i64);  // step
    sd_i64_set(sizes,6*8,cap as i64);      // strength
    sd_i64_set(sizes,7*8,cap as i64);      // origin
    sd_i64_set(sizes,8*8,(cap*4) as i64);  // sclock
    sd_i64_set(sizes,9*8,cap as i64);      // forcepin
    sd_i64_set(sizes,10*8,(cap*4) as i64); // pintrainer
    sd_i64_set(sizes,11*8,(cap*4) as i64); // last_cite
    sd_i64_set(sizes,12*8,(cap*4) as i64); // step_ep
    let ce0:i32=(acap+3)/4;
    let chunk:i64=(ce0*84) as i64;         // ST_AUDIT_WORDS=21 *4
    sd_i64_set(sizes,13*8,chunk);
    sd_i64_set(sizes,14*8,chunk);
    sd_i64_set(sizes,15*8,chunk);
    sd_i64_set(sizes,16*8,chunk);
    let i:i32=0;
    while(i<17){
        let sz:i64=sd_i64_get(sizes,i*8);
        tot=tot+sz;
        if(sz>=33554432){ok=0;}
        _zag_print("SC_ALLOC slots=");sd_pi(ucap as i64);
        _zag_print(" idx=");sd_pi(i as i64);
        _zag_print(" bytes=");sd_pi(sz);_zag_print("\n");
        i=i+1;
    }
    nio_free(sizes);
    st_free(&s);
    _zag_print("SC_BYTES slots=");sd_pi(ucap as i64);
    _zag_print(" slot_cap=");sd_pi(cap as i64);
    _zag_print(" audit_cap=");sd_pi(acap as i64);
    _zag_print(" total=");sd_pi(tot);
    _zag_print(" ceil_ok=");sd_pi(ok as i64);
    _zag_print("\n");
    return 0;
}

// ---------------- COST leg: per-op medians ----------------
fn sd_cost(ucap:i32)i32 {
    let cap:i32=ucap+2;
    let r:i32=21;
    let samp:[]u8=nio_alloc(r*8);
    let rr:i32=0;let k:i32=0;let q:i32=0;
    let sl:i32=0;let t0:i64=0;let t1:i64=0;
    // --- add to empty store: N=10 adds per round ---
    rr=0;
    while(rr<r+1){
        let s:StStore=sd_new_store(ucap,4096);
        t0=sd_now_ns();
        k=0;while(k<10){st_add(&s,1000+rr*100+k,ST_REGION_USER,90,rr*10+k,&sl);k=k+1;}
        t1=sd_now_ns();
        if(rr>0){sd_i64_set(samp,(rr-1)*8,(t1-t0)/10);}
        st_free(&s);
        rr=rr+1;
    }
    sd_cost_line(ucap,"add_empty",samp,r);
    // --- add to full store (REFUSED_FULL, scans all slots): M=5 per round ---
    rr=0;
    while(rr<r+1){
        let s:StStore=sd_new_store(ucap,8192);
        q=0;while(q<ucap){st_add(&s,2000+q,ST_REGION_USER,90,q,&sl);q=q+1;}
        t0=sd_now_ns();
        k=0;while(k<5){st_add(&s,9999,ST_REGION_USER,90,9999,&sl);k=k+1;}
        t1=sd_now_ns();
        if(rr>0){sd_i64_set(samp,(rr-1)*8,(t1-t0)/5);}
        st_free(&s);
        rr=rr+1;
    }
    sd_cost_line(ucap,"add_fullscan",samp,r);
    // --- cite (evidence): N=20 distinct-eps cites per round ---
    rr=0;
    while(rr<r+1){
        let s:StStore=sd_new_store(ucap,8192);
        st_add(&s,3000,ST_REGION_USER,90,0,&sl);
        t0=sd_now_ns();
        k=0;while(k<20){st_evidence(&s,sl,ST_J_CONTRADICTED,1000+rr*1000+k);k=k+1;}
        t1=sd_now_ns();
        if(rr>0){sd_i64_set(samp,(rr-1)*8,(t1-t0)/20);}
        st_free(&s);
        rr=rr+1;
    }
    sd_cost_line(ucap,"cite",samp,r);
    // --- priced destroy (kill_evidenced, incl. effort check): K=5 per round ---
    rr=0;
    while(rr<r+1){
        let s:StStore=sd_new_store(ucap,8192);
        let dsl:[]u8=nio_alloc(5*8);
        q=0;
        while(q<5){
            st_add(&s,4000+q,ST_REGION_USER,90,q,&sl);
            sd_i64_set(dsl,q*8,sl as i64);
            let e0:i32=5000+rr*100+q*10;
            st_evidence(&s,sl,ST_J_CONTRADICTED,e0);
            st_evidence(&s,sl,ST_J_CONTRADICTED,e0+1);
            st_evidence(&s,sl,ST_J_CONTRADICTED,e0+2);
            st_evidence(&s,sl,ST_J_CONTRADICTED,e0+3);
            st_justify(&s,sl,ST_J_CONTRADICTED);
            q=q+1;
        }
        t0=sd_now_ns();
        q=0;
        while(q<5){
            let ds:i32=sd_i64_get(dsl,q*8) as i32;
            st_kill_evidenced(&s,ds);
            q=q+1;
        }
        t1=sd_now_ns();
        nio_free(dsl);
        if(rr>0){sd_i64_set(samp,(rr-1)*8,(t1-t0)/5);}
        st_free(&s);
        rr=rr+1;
    }
    sd_cost_line(ucap,"destroy",samp,r);
    // --- full checker pass over a 100-episode honest curriculum ---
    let an:i32=0;
    rr=0;
    while(rr<r+1){
        let s:StStore=sd_new_store(ucap,8192);
        let t:i32=0;
        while(t<100){
            // FIXED 14-slot rotation on every config: the destruction workload
            // (ledger) is identical across configs, so checker-time deltas
            // isolate the slot-array scan cost. (2026-09-26: first version
            // used t%ucap, which left 140-slot ledgers destroy-free and made
            // the 140 checker look 5x FASTER -- a workload artifact.)
            let uq:i32=2+(t%14);
            if(s.live[uq]==1){
                let e0:i32=7000+t*10;
                st_evidence(&s,uq,ST_J_CONTRADICTED,e0);
                st_evidence(&s,uq,ST_J_CONTRADICTED,e0+1);
                st_evidence(&s,uq,ST_J_CONTRADICTED,e0+2);
                st_evidence(&s,uq,ST_J_CONTRADICTED,e0+3);
                st_justify(&s,uq,ST_J_CONTRADICTED);
                st_kill_evidenced(&s,uq);
            } else {
                st_add(&s,8000+t,ST_REGION_USER,90,t,&sl);
            }
            t=t+1;
        }
        an=s.audit_n;
        t0=sd_now_ns();
        k=0;while(k<5){ck_verify(&s,0,0,0,500,1);k=k+1;}
        t1=sd_now_ns();
        if(rr>0){sd_i64_set(samp,(rr-1)*8,(t1-t0)/5);}
        st_free(&s);
        rr=rr+1;
    }
    sd_cost_line(ucap,"checker",samp,r);
    _zag_print("SC_LEDGER slots=");sd_pi(ucap as i64);
    _zag_print(" checker_round_audit_n=");sd_pi(an as i64);_zag_print("\n");
    nio_free(samp);
    return 0;
}

// ---------------- FUNC leg: deterministic honest curriculum ----------------
fn sd_cited_since(s:*StStore,slot:i32,ep:i32,lss:i32,upto:i32)i32 {
    let i:i32=lss+1;
    while(i<upto){
        if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==slot &&
           st_aw(s,i,4)==ST_OK && st_aw(s,i,2)==ep){return 1;}
        i=i+1;
    }
    return 0;
}
// 0=destroyed OK, 1=abandoned(kept), 2=refused-121, 3=refused-other
fn sd_honest_destroy(s:*StStore,slot:i32,t:i32)i32 {
    let lss:i32=st_last_strength_idx(s,slot,s.*.audit_n);
    let picked:i32=0;
    let e:i32=t-1;
    while(e>=0 && picked<4){
        if(sd_cited_since(s,slot,e,lss,s.*.audit_n)==0 &&
           st_cite_consumed(s,slot,e,lss,s.*.audit_n)==0){
            let cr:i32=st_evidence(s,slot,ST_J_CONTRADICTED,e);
            if(cr==0){picked=picked+1;}
        }
        e=e-1;
    }
    if(picked<4){return 1;}
    st_justify(s,slot,ST_J_CONTRADICTED);
    let rc:i32=st_kill_evidenced(s,slot);
    if(rc==0){return 0;}
    if(rc==ST_REFUSED_CONSUMED){return 2;}
    return 3;
}
fn sd_func(ucap:i32)i32 {
    let s:StStore=sd_new_store(ucap,32768);
    let fail:i32=0;
    let ok:i32=0;let ab:i32=0;let c121:i32=0;let cother:i32=0;
    let t:i32=0;
    while(t<400){
        let uq:i32=2+(t%ucap);
        if(s.live[uq]==1){
            let cls:i32=sd_honest_destroy(&s,uq,t);
            if(cls==0){ok=ok+1;}
            else if(cls==1){ab=ab+1;}
            else if(cls==2){c121=c121+1;}
            else {cother=cother+1;}
        } else {
            let ns:i32=0;
            st_add(&s,900+t,ST_REGION_USER,90,t,&ns);
        }
        t=t+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("SC_FUNC slots=");sd_pi(ucap as i64);
    _zag_print(" ok=");sd_pi(ok as i64);
    _zag_print(" abandons=");sd_pi(ab as i64);
    _zag_print(" c121=");sd_pi(c121 as i64);
    _zag_print(" cother=");sd_pi(cother as i64);
    _zag_print(" audit_n=");sd_pi(s.audit_n as i64);
    _zag_print(" ckfail=");sd_pi(fail as i64);
    _zag_print(" fp=");sd_pi(st_fingerprint(&s,7) as i64);
    _zag_print("\n");
    st_free(&s);
    return fail;
}

// ---------------- CKL leg: checker cost vs LEDGER SIZE ----------------
// Honest curriculum of <eps> episodes on a fixed 14-slot rotation (identical
// workload shape across slot counts), then 21 rounds of 5 timed ck_verify
// passes (first round warmup, discarded). Median of per-pass CPU ns.
fn sd_ckl(ucap:i32,eps:i32)i32 {
    let fail:i32=0;
    let ca:[]u8=nio_alloc(21*8);
    let rr:i32=0;
    while(rr<22){
        let s:StStore=sd_new_store(ucap,32768);
        let sl:i32=0;
        let t:i32=0;
        while(t<eps){
            let uq:i32=2+(t%14);
            if(s.live[uq]==1){
                let e0:i32=7000+t*10;
                st_evidence(&s,uq,ST_J_CONTRADICTED,e0);
                st_evidence(&s,uq,ST_J_CONTRADICTED,e0+1);
                st_evidence(&s,uq,ST_J_CONTRADICTED,e0+2);
                st_evidence(&s,uq,ST_J_CONTRADICTED,e0+3);
                st_justify(&s,uq,ST_J_CONTRADICTED);
                st_kill_evidenced(&s,uq);
            } else {
                st_add(&s,8000+t,ST_REGION_USER,90,t,&sl);
            }
            t=t+1;
        }
        let an:i32=s.audit_n;
        let t0:i64=sd_now_ns();
        let pp:i32=0;
        while(pp<5){
            let ckr:i32=ck_verify(&s,0,0,0,500,1);
            if(ckr!=0){ fail=1; }
            pp=pp+1;
        }
        let t1:i64=sd_now_ns();
        st_free(&s);
        if(rr>0){ sd_i64_set(ca,(rr-1)*8,(t1-t0)/5); }
        if(rr==21){
            let med:i64=sd_median(ca,21);
            _zag_print("SC_CKL slots=");sd_pi(ucap as i64);
            _zag_print(" eps=");sd_pi(eps as i64);
            _zag_print(" audit_n=");sd_pi(an as i64);
            _zag_print(" med_ns=");sd_pi(med);
            _zag_print(" min_ns=");sd_pi(sd_i64_get(ca,0));
            _zag_print(" max_ns=");sd_pi(sd_i64_get(ca,20*8));
            _zag_print("\n");
        }
        rr=rr+1;
    }
    nio_free(ca);
    return fail;
}

// ---------------- WEDGE leg: G mode, finite salient pool ----------------
fn sd_wedge(ucap:i32,pool:i32)i32 {
    let s:StStore=sd_new_store(ucap,65536);
    st_set_cite_mode(&s,ST_CITE_GLOBAL); // [CITEMODE]
    let fail:i32=0;
    let n:i32=0;let nmax:i32=ucap*pool;
    let ok:i32=0;let c121:i32=0;let cother:i32=0;
    let first121:i32=-1;let wedge:i32=-1;
    while(n<nmax){
        let ns:i32=0;
        let ar:i32=st_add(&s,800+n,ST_REGION_USER,90,n,&ns);
        if(ar==ST_REFUSED_FULL){wedge=n;break;}
        let base:i32=(4*n)%pool;
        st_evidence(&s,ns,ST_J_CONTRADICTED,base);
        st_evidence(&s,ns,ST_J_CONTRADICTED,base+1);
        st_evidence(&s,ns,ST_J_CONTRADICTED,base+2);
        st_evidence(&s,ns,ST_J_CONTRADICTED,base+3);
        st_justify(&s,ns,ST_J_CONTRADICTED);
        let rc:i32=st_kill_evidenced(&s,ns);
        if(rc==0){ok=ok+1;}
        else if(rc==ST_REFUSED_CONSUMED){c121=c121+1;if(first121<0){first121=n;}}
        else {cother=cother+1;}
        n=n+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("SC_WEDGE slots=");sd_pi(ucap as i64);
    _zag_print(" pool=");sd_pi(pool as i64);
    _zag_print(" ok=");sd_pi(ok as i64);
    _zag_print(" c121=");sd_pi(c121 as i64);
    _zag_print(" cother=");sd_pi(cother as i64);
    _zag_print(" first121=");sd_pi(first121 as i64);
    _zag_print(" wedge_iter=");sd_pi(wedge as i64);
    _zag_print(" audit_n=");sd_pi(s.audit_n as i64);
    _zag_print(" ckfail=");sd_pi(fail as i64);
    _zag_print(" fp=");sd_pi(st_fingerprint(&s,9) as i64);
    _zag_print("\n");
    st_free(&s);
    return fail;
}

fn main()void {
    let a1:[]u8=_zag_arg(1);
    let ucap:i32=sd_slots_of(a1);
    let a2:[]u8=_zag_arg(2);
    let fail:i32=0;
    _zag_print("SC_RUN slots=");sd_pi(ucap as i64);
    _zag_print(" leg=");_zag_print(a2);_zag_print("\n");
    if(_zag_strcmp(a2,"BYTES")==1){
        _zag_print("SC_LEG BYTES\n");
        fail=sd_bytes(ucap);
    } else if(_zag_strcmp(a2,"COST")==1){
        _zag_print("SC_LEG COST\n");
        fail=sd_cost(ucap);
    } else if(_zag_strcmp(a2,"CKL")==1){
        let a3:[]u8=_zag_arg(3);
        let eps:i32=50;
        if(_zag_strcmp(a3,"100")==1){eps=100;}
        if(_zag_strcmp(a3,"200")==1){eps=200;}
        if(_zag_strcmp(a3,"400")==1){eps=400;}
        _zag_print("SC_LEG CKL eps=");sd_pi(eps as i64);_zag_print("\n");
        fail=sd_ckl(ucap,eps);
    } else if(_zag_strcmp(a2,"WEDGE")==1){
        let a3:[]u8=_zag_arg(3);
        let pool:i32=8;
        if(_zag_strcmp(a3,"16")==1){pool=16;}
        if(_zag_strcmp(a3,"32")==1){pool=32;}
        _zag_print("SC_LEG WEDGE pool=");sd_pi(pool as i64);_zag_print("\n");
        fail=sd_wedge(ucap,pool);
    } else {
        _zag_print("SC_LEG FUNC\n");
        fail=sd_func(ucap);
    }
    _zag_print("SC_DONE fail=");sd_pi(fail as i64);_zag_print("\n");
}

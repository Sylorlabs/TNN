// k_rules.zag — knowledge-backed incongruity interpreters (V5 experiment).
//
// The knowledge stores are DATA (k_pun_table() etc., generated from the TSV
// stores). These functions are GENERAL mechanisms. Every rule is
// shape (knowledge element present) + TURN (genuine incongruity evidence).
// Knowledge NEVER fires on shape alone.
//
// Table encoding: records separated by \n, fields by \t, cue lists by comma.
//   pun:   word \t senseA_cues \t senseB_cues \t gloss
//   idiom: phrase \t literal_play_cues \t gloss
//   world: entity \t fact_cues \t violation_cues \t gloss
//   phon:  written \t alternate \t alt_meaning_cues \t gloss
//
// Pure Zag; zero RNG; deterministic.

// k_rec_end: index of the \n ending the record starting at p (or tab.len).
fn k_rec_end(tab:[]u8, p:i32) i32 {
    let i:i32=p;
    while(i<tab.len){ if(tab[i]==10){break;} i=i+1; }
    return i;
}

// k_field: bounds of the nth (0-based) \t-field of record tab[rs:re],
// where re is the index of the terminating \n (or tab.len).
// Writes (fs,fe) to out-pointers; (-1,-1) when the field is absent.
fn k_field(tab:[]u8, rs:i32, re:i32, n:i32, os:*i32, oe:*i32) void {
    let i:i32=rs;
    let f:i32=0;
    let fs:i32=rs;
    while(i<re){
        if(tab[i]==9){
            if(f==n){ os.*=fs; oe.*=i; return; }
            f=f+1;
            fs=i+1;
        }
        i=i+1;
    }
    if(f==n){ os.*=fs; oe.*=re; return; }
    os.*=-1;
    oe.*=-1;
    return;
}

// k_word_lim: whole-word/phrase needle tab[ns:ne] in hay[from:lim).
// Returns the match position, or -1.
fn k_word_lim(hay:[]u8, tab:[]u8, ns:i32, ne:i32, from:i32, lim:i32) i32 {
    let wl:i32=ne-ns;
    if(wl<=0){ return -1; }
    if(from<0){ from=0; }
    if(lim>hay.len){ lim=hay.len; }
    if(lim-from<wl){ return -1; }
    let i:i32=from;
    while(i<=lim-wl){
        let k:i32=0;
        while(k<wl){ if(hay[i+k]!=tab[ns+k]){break;} k=k+1; }
        if(k==wl){
            let ok:i32=1;
            if(i>0){ if(j_is_alnum(hay[i-1])!=0){ ok=0; } }
            if(i+wl<hay.len){ if(j_is_alnum(hay[i+wl])!=0){ ok=0; } }
            if(ok!=0){ return i; }
        }
        i=i+1;
    }
    return -1;
}

// k_has_space: 1 if tab[ns:ne] contains a space (multi-word unit).
fn k_has_space(tab:[]u8, ns:i32, ne:i32) i32 {
    let i:i32=ns;
    while(i<ne){ if(tab[i]==32){return 1;} i=i+1; }
    return 0;
}

// k_stem_pos: stem tab[ns:ne] with inflection at/after from, whole-word.
// Returns the match START position, or -1. (Mirrors j_stem_endpos logic
// with explicit needle bounds, since Zag has no slice syntax.)
fn k_stem_pos(hay:[]u8, tab:[]u8, ns:i32, ne:i32, from:i32, lim:i32) i32 {
    let sl:i32=ne-ns;
    if(sl<=0){ return -1; }
    if(from<0){ from=0; }
    if(lim>hay.len){ lim=hay.len; }
    let lastc:u8=tab[ne-1];
    let i:i32=from;
    while(i<=lim-sl){
        let ok:i32=1;
        if(i>0){ if(j_is_alnum(hay[i-1])!=0){ ok=0; } }
        if(ok!=0){
            let k:i32=0;
            while(k<sl){ if(hay[i+k]!=tab[ns+k]){break;} k=k+1; }
            if(k==sl){
                let e:i32=j_inflect_end(hay,i+sl);
                if(e>=0){ return i; }
                if(j_is_cons(lastc)!=0){
                    if(i+sl<hay.len){
                        if(hay[i+sl]==lastc){
                            let e3:i32=j_inflect_deding(hay,i+sl+1);
                            if(e3>=0){ return i; }
                        }
                    }
                }
            }
            if(lastc==101){
                let m:i32=0;
                while(m<sl-1){ if(hay[i+m]!=tab[ns+m]){break;} m=m+1; }
                if(m==sl-1){
                    let e2:i32=j_inflect_ing(hay,i+sl-1);
                    if(e2>=0){ return i; }
                }
            }
        }
        i=i+1;
    }
    return -1;
}

// k_ordered_words: every word of tab[ns:ne] appears in hay[from:lim) in
// order, each starting within maxspan chars of the first word's start.
// Returns the first word's position, or -1.
// (Handles "play piano by ear" for the idiom "play by ear".)
fn k_ordered_words(hay:[]u8, tab:[]u8, ns:i32, ne:i32, from:i32, lim:i32, maxspan:i32) i32 {
    let ws:i32=ns;
    let we:i32=ws;
    while(we<ne){ if(tab[we]==32){break;} we=we+1; }
    let first:i32=k_stem_pos(hay,tab,ws,we,from,lim);
    if(first<0){ return -1; }
    let pos:i32=first+1;
    ws=we;
    while(ws<ne){
        while(ws<ne){ if(tab[ws]!=32){break;} ws=ws+1; }
        if(ws>=ne){ break; }
        we=ws;
        while(we<ne){ if(tab[we]==32){break;} we=we+1; }
        let np:i32=k_stem_pos(hay,tab,ws,we,pos,lim);
        if(np<0){ return -1; }
        if(np-first>maxspan){ return -1; }
        pos=np+1;
        ws=we;
    }
    return first;
}

// k_word_or_stem: multi-word units match as ordered words (gaps allowed);
// single words match with inflection (uplift/uplifting, break/breaks).
// Returns position or -1.
fn k_word_or_stem(hay:[]u8, tab:[]u8, ns:i32, ne:i32, from:i32, lim:i32) i32 {
    if(k_has_space(tab,ns,ne)!=0){ return k_ordered_words(hay,tab,ns,ne,from,lim,80); }
    return k_stem_pos(hay,tab,ns,ne,from,lim);
}

// k_cue_pos: first comma-separated cue in tab[cs:ce] matching as a
// whole word/phrase (stem-aware) in hay[from:lim).
// Returns the match position; via out-pointers, the matched cue's
// (trimmed) bounds (oa,ob) in tab, or (-1,-1) when nothing matches.
fn k_cue_pos(hay:[]u8, tab:[]u8, cs:i32, ce:i32, from:i32, lim:i32, oa:*i32, ob:*i32) i32 {
    let i:i32=cs;
    while(i<ce){
        let j:i32=i;
        while(j<ce){ if(tab[j]==44){break;} j=j+1; }
        let a:i32=i;
        let b:i32=j;
        while(a<b){ if(tab[a]==32){a=a+1;} else{break;} }
        while(b>a){ if(tab[b-1]==32){b=b-1;} else{break;} }
        if(b>a){
            let p:i32=k_word_or_stem(hay,tab,a,b,from,lim);
            if(p>=0){ oa.*=a; ob.*=b; return p; }
        }
        i=j+1;
    }
    oa.*=-1;
    ob.*=-1;
    return -1;
}

// k_pivot_between: 1 if a discourse boundary (contrast pivot, clause break,
// sentence break) lies strictly between positions a and b.
fn k_pivot_between(hay:[]u8, a:i32, b:i32) i32 {
    let lo:i32=a;
    let hi:i32=b;
    if(lo>hi){ lo=b; hi=a; }
    let p:i32=j_any_pivot(hay,lo+1);
    if(p<0){ return 0; }
    if(p<hi){ return 1; }
    return 0;
}

// k_pun_turn: dual-meaning word W with sense-A cues and sense-B cues evoked
// in DIFFERENT discourse segments (a boundary between them). The boundary
// is the incongruity turn: the text shifts from one meaning to the other.
fn k_pun_turn(hay:[]u8) i32 {
    let tab:[]u8=k_pun_table();
    let p:i32=0;
    while(p<tab.len){
        let re:i32=k_rec_end(tab,p);
        if(re>p){
            let ws:i32=0; let we:i32=0;
            let as:i32=0; let ae:i32=0;
            let bs:i32=0; let be:i32=0;
            k_field(tab,p,re,0,&ws,&we);
            k_field(tab,p,re,1,&as,&ae);
            k_field(tab,p,re,2,&bs,&be);
            if(ws>=0){
                let wp:i32=k_word_or_stem(hay,tab,ws,we,0,hay.len);
                if(wp>=0){
                    let ea:i32=0; let eb:i32=0;
                    let aa:i32=0; let ab2:i32=0; let ba:i32=0; let bb2:i32=0;
                    let pa:i32=k_cue_pos(hay,tab,as,ae,0,hay.len,&aa,&ab2);
                    let pb:i32=k_cue_pos(hay,tab,bs,be,0,hay.len,&ba,&bb2);
                    if(pa>=0){ if(pb>=0){
                        if(k_pivot_between(hay,pa,pb)!=0){ return 1; }
                    }}
                }
            }
        }
        p=re+1;
    }
    return 0;
}

// k_qa_pun_turn: riddle shape ("?" boundary) where the answer reinterprets a
// dual-meaning word W: the question cues sense A, the answer's W forces the
// shift. The "?" is the turn.
fn k_qa_pun_turn(hay:[]u8) i32 {
    let q:i32=j_sub_pos(hay,"?",0);
    if(q<0){ return 0; }
    let ss:i32=q;
    while(ss>0){
        let pc:u8=hay[ss-1];
        if(pc==46||pc==63||pc==33){break;}
        ss=ss-1;
    }
    while(ss<q){
        let cc:u8=hay[ss];
        if(cc==46||cc==63||cc==33||cc==32){ss=ss+1;}
        else{break;}
    }
    if(j_qa_opener_at(hay,ss,1)==0){ return 0; }
    let tab:[]u8=k_pun_table();
    let p:i32=0;
    while(p<tab.len){
        let re:i32=k_rec_end(tab,p);
        if(re>p){
            let ws:i32=0; let we:i32=0;
            let as:i32=0; let ae:i32=0;
            let bs:i32=0; let be:i32=0;
            k_field(tab,p,re,0,&ws,&we);
            k_field(tab,p,re,1,&as,&ae);
            k_field(tab,p,re,2,&bs,&be);
            if(ws>=0){
                let wp:i32=k_word_or_stem(hay,tab,ws,we,q+1,hay.len);
                if(wp>=0){
                    let ea:i32=0; let eb:i32=0;
                    let aa:i32=0; let ab2:i32=0; let ba:i32=0; let bb2:i32=0;
                    let pa:i32=k_cue_pos(hay,tab,as,ae,0,q,&aa,&ab2);
                    if(pa>=0){
                        let pb:i32=k_cue_pos(hay,tab,bs,be,q+1,hay.len,&ba,&bb2);
                        if(pb>=0){ return 1; }
                    }
                }
            }
        }
        p=re+1;
    }
    return 0;
}

// k_idiom_turn: idiom phrase with a literal-play cue across a discourse
// boundary — the text literalizes the idiom. The boundary is the turn:
// the figurative frame and the literal enactment sit in different segments.
// Second variant: a SUBSTANTIVE multi-word literal cue (it defines the
// idiom's literal head, e.g. "rotation of the earth" for "day") before the
// idiom also counts — the definition IS the clash.
fn k_idiom_turn(hay:[]u8) i32 {
    let tab:[]u8=k_idiom_table();
    let p:i32=0;
    while(p<tab.len){
        let re:i32=k_rec_end(tab,p);
        if(re>p){
            let ps:i32=0; let pe:i32=0;
            let cs:i32=0; let ce:i32=0;
            k_field(tab,p,re,0,&ps,&pe);
            k_field(tab,p,re,1,&cs,&ce);
            if(ps>=0){
                let ip:i32=k_word_or_stem(hay,tab,ps,pe,0,hay.len);
                if(ip>=0){
                    let ca:i32=0; let cb:i32=0;
                    let qp:i32=k_cue_pos(hay,tab,cs,ce,0,hay.len,&ca,&cb);
                    if(qp>=0){
                        if(k_pivot_between(hay,ip,qp)!=0){ return 1; }
                        // substantive-cue variant: the MATCHED cue is a
                        // multi-word literal definition sitting before the
                        // idiom (e.g. "rotation of the earth" for "day").
                        if(qp<ip){
                            if(k_has_space(tab,ca,cb)!=0){ return 1; }
                        }
                    }
                }
            }
        }
        p=re+1;
    }
    return 0;
}

// k_world_turn: a known entity with a violation cue — the text contradicts
// or plays against a stored fact. The contradiction is the turn.
fn k_world_turn(hay:[]u8) i32 {
    let tab:[]u8=k_world_table();
    let p:i32=0;
    while(p<tab.len){
        let re:i32=k_rec_end(tab,p);
        if(re>p){
            let es:i32=0; let ee:i32=0;
            let vs:i32=0; let ve:i32=0;
            k_field(tab,p,re,0,&es,&ee);
            k_field(tab,p,re,2,&vs,&ve);
            if(es>=0){
                let ep:i32=k_word_or_stem(hay,tab,es,ee,0,hay.len);
                if(ep>=0){
                    let va:i32=0; let vb:i32=0;
                    let vp:i32=k_cue_pos(hay,tab,vs,ve,0,hay.len,&va,&vb);
                    if(vp>=0){ return 1; }
                }
            }
        }
        p=re+1;
    }
    return 0;
}

// k_phon_turn: a written word whose homophone's meaning is evoked by context.
// The alternate reading clicking into place is the turn: the context must
// evoke the OTHER meaning, not just contain the word.
fn k_phon_turn(hay:[]u8) i32 {
    let tab:[]u8=k_phon_table();
    let p:i32=0;
    while(p<tab.len){
        let re:i32=k_rec_end(tab,p);
        if(re>p){
            let ws:i32=0; let we:i32=0;
            let cs:i32=0; let ce:i32=0;
            k_field(tab,p,re,0,&ws,&we);
            k_field(tab,p,re,2,&cs,&ce);
            if(ws>=0){
                let wp:i32=k_word_or_stem(hay,tab,ws,we,0,hay.len);
                if(wp>=0){
                    let ca:i32=0; let cb:i32=0;
                    let cp:i32=k_cue_pos(hay,tab,cs,ce,0,hay.len,&ca,&cb);
                    if(cp>=0){ return 1; }
                }
            }
        }
        p=re+1;
    }
    return 0;
}

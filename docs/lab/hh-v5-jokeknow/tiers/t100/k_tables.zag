fn k_idiom_table() []u8 {
    return "a blessing in disguise\tmask,costume,hidden\tfig=a hidden advantage; lit=something good wearing a disguise\na chip on your shoulder\tshoulder,wood,carry\tfig=a grudge or resentment; lit=a literal wood chip resting on a shoulder\na drop in the bucket\twater,bucket,drop\tfig=a tiny amount; lit=one drop of water inside a bucket\na penny for your thoughts\tpenny,coin,thoughts\tfig=asking what someone is thinking; lit=buying thoughts for a coin\na wolf in sheep's clothing\twolf,sheep,clothing\tfig=a hidden enemy pretending to be friendly; lit=a wolf literally wearing sheep's clothing\nan arm and a leg\tarm,leg,limb\tfig=very expensive; lit=paying with an actual arm and leg\nback to square one\tsquare,start,beginning\tfig=starting over; lit=returning to a literal square numbered one\nbad apple\tapple,rotten,barrel\tfig=a corrupting person; lit=a literally rotten apple\nbark up the wrong tree\tbark,tree,dog\tfig=accusing the wrong person; lit=a dog barking at the wrong tree\nbeat around the bush\tbeat,bush,bushes\tfig=avoiding the point; lit=physically striking shrubbery\nbend over backwards\tbend,back,backwards\tfig=trying very hard; lit=bending the spine backwards\nbite off more than you can chew\tbite,chew,mouth\tfig=taking on too much; lit=biting food too large to chew\nbite the bullet\tbite,bullet,teeth\tfig=enduring something painful; lit=clamping teeth onto a bullet\nbite the dust\tbite,dust,ground\tfig=being defeated or dying; lit=biting the ground's dust\nblow off steam\tsteam,blow,boiler\tfig=releasing stress; lit=venting actual steam\nborn with a silver spoon in your mouth\tspoon,silver,mouth\tfig=born wealthy; lit=a baby holding a literal silver spoon\nbreak a leg\tleg,broken,bone\tfig=good luck (theatre); lit=fracturing a leg bone\nbreak the bank\tbank,broken,money\tfig=spending too much; lit=smashing a bank building\nbreak the ice\tice,broken,frozen\tfig=easing social tension; lit=physically breaking frozen ice\nbring home the bacon\tbacon,home,pig\tfig=earning a living; lit=carrying home slabs of bacon\nbull in a china shop\tbull,china,shop\tfig=a clumsy person; lit=a real bull inside a shop of porcelain\nburn the candle at both ends\tcandle,burn,ends\tfig=overworking; lit=lighting a candle at both ends\nburn the midnight oil\toil,midnight,lamp\tfig=working late; lit=burning lamp oil at midnight\nbury the hatchet\thatchet,bury,ground\tfig=making peace; lit=burying an actual axe in the dirt\nbust a gut\tgut,bust,burst\tfig=laughing hard; lit=rupturing a stomach\nbutter someone up\tbutter,spread,flatter\tfig=flattering for a favor; lit=spreading butter on a person\nby the skin of your teeth\tskin,teeth\tfig=barely succeeding; lit=skin stretched across teeth\ncall it a day\tday,call,clock\tfig=stopping work; lit=phoning a calendar day\ncat got your tongue\tcat,tongue,got\tfig=can't speak; lit=a cat physically holding a tongue\ncatch someone's eye\teye,catch,look\tfig=getting attention; lit=catching an eyeball mid-air\nchicken out\tchicken,feathers,hen\tfig=backing down from fear; lit=turning into a chicken\nchip off the old block\tchip,block,wood\tfig=like one's parent; lit=a wood chip from a wooden block\nclean slate\tslate,clean,chalk\tfig=a fresh start; lit=a wiped-clean writing slate\ncold turkey\tcold,turkey,bird\tfig=quitting abruptly; lit=uncooked turkey meat served cold\ncome hell or high water\thell,high,water\tfig=no matter what; lit=traveling through hell or high water\ncool as a cucumber\tcucumber,cool,vegetable\tfig=very calm; lit=the temperature of a cucumber\ncry over spilled milk\tmilk,spilled,cry\tfig=regretting the past; lit=weeping over spilled dairy\ncry wolf\twolf,cry,shepherd\tfig=raising false alarms; lit=a boy shouting about a real wolf\ncut corners\tcut,corners,scissors\tfig=taking shortcuts; lit=slicing the corners off things\ncut to the chase\tcut,chase,run\tfig=getting to the point; lit=cutting across to join a chase\ndark horse\thorse,dark,black\tfig=an unknown contender; lit=a horse that is dark-colored\ndays were numbered\tcalendar,factory,printed,counted\tfig=doomed, time running out; lit=each day printed with a number\ndead air\tdead,air,broadcast\tfig=awkward broadcast silence; lit=air that is dead\ndead as a doornail\tdead,doornail,nail\tfig=completely dead; lit=a dead door nail\ndead giveaway\tdead,giveaway,prize\tfig=an obvious clue; lit=a dead prize\ndead ringer\tdead,ring,bell\tfig=an exact lookalike; lit=a dead bell ringer\ndead to the world\tdead,world,sleep\tfig=deeply asleep; lit=literally dead to the world\ndie laughing\tdie,laughing,funny\tfig=laughing hard; lit=dying from laughter\ndon't put all your eggs in one basket\teggs,basket,break\tfig=don't risk everything at once; lit=carrying all eggs in one basket\ndown to earth\tdown,earth,ground\tfig=practical and humble; lit=falling down to the earth\ndrink like a fish\tdrink,fish,water\tfig=drinking too much alcohol; lit=a fish drinking\ndrop dead\tdrop,dead,fall\tfig=suddenly dying (or an exclamation); lit=falling down dead\ndying to leave\tgraveyard,dead,shift,coffin,quiet\tfig=eager to get out; lit=dying as a means of leaving\neat crow\tcrow,eat,bird\tfig=admitting you were wrong; lit=eating a crow bird\neat humble pie\thumble,pie,eat\tfig=being humbled; lit=eating a pie made of humble\neat your heart out\theart,eat,jealous\tfig=watch me (jealousy taunt); lit=eating one's own heart\neat your words\teat,words,swallow\tfig=taking back what you said; lit=chewing up spoken words\negg on your face\tegg,face,yolk\tfig=embarrassed; lit=yolk smeared on a face\nface the music\tface,music,band\tfig=facing consequences; lit=standing facing a band\nfish out of water\tfish,water,out\tfig=out of place; lit=a fish stranded outside water\nfit as a fiddle\tfiddle,fit,violin\tfig=very healthy; lit=as fit as a musical instrument\nfly by the seat of your pants\tfly,pants,seat\tfig=improvising; lit=flying while seated on pants\nfull of beans\tbeans,full,energy\tfig=energetic; lit=literally stuff
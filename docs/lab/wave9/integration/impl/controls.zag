// controls.zag — the seven-control evaluation battery C1..C7 (prereg section 5;
// first-ever execution; spec wave3/non-toy-evaluation/EVALUATION_PROTOCOL.md).
// Entry gates G0..G5 run first. Every control gets a synthetic + control-arm
// bite check before the official run: a control that cannot fire on a
// deliberately broken system is vacuous, not passing (prereg section 7).
// Verdict codes: 0 = claim ALIVE (control did not fire), 1 = claim DEAD
// (control fired with attribution), 2 = VOID/BLOCKED.
@import("loop.zag")
@import("probes.zag")
@import("substrate/R33_NATIVE_IO_V1.zag")

// ---------- entry gates ----------
// G0: comment-stripped static grep for RNG tokens over all sources.
// AI decision paths must contain zero RNG tokens.
fn ctl_is_token_char(c:u8)i32 {
    if((c>=48 && c<=57) || (c>=65 && c<=90) || (c>=97 && c<=122) || c==95){return 1;}
    return 0;
}
fn ctl_word_ok(buf:[]u8,at:i32,ln:i32)i32 {
    if(at>0 && ctl_is_token_char(buf[at-1])==1){return 0;}
    if(at+ln<buf.len && ctl_is_token_char(buf[at+ln])==1){return 0;}
    return 1;
}
fn ctl_tok4(buf:[]u8,at:i32,a:i32,b:i32,c:i32,d:i32)i32 {
    if(at+4>buf.len){return 0;}
    if(buf[at]!=(a&255)||buf[at+1]!=(b&255)||buf[at+2]!=(c&255)||buf[at+3]!=(d&255)){return 0;}
    return ctl_word_ok(buf,at,4);
}
fn ctl_tok5(buf:[]u8,at:i32,a:i32,b:i32,c:i32,d:i32,e:i32)i32 {
    if(at+5>buf.len){return 0;}
    if(buf[at]!=(a&255)||buf[at+1]!=(b&255)||buf[at+2]!=(c&255)||buf[at+3]!=(d&255)||buf[at+4]!=(e&255)){return 0;}
    return ctl_word_ok(buf,at,5);
}
fn ctl_tok6(buf:[]u8,at:i32,a:i32,b:i32,c:i32,d:i32,e:i32,f:i32)i32 {
    if(at+6>buf.len){return 0;}
    if(buf[at]!=(a&255)||buf[at+1]!=(b&255)||buf[at+2]!=(c&255)||buf[at+3]!=(d&255)||buf[at+4]!=(e&255)||buf[at+5]!=(f&255)){return 0;}
    return ctl_word_ok(buf,at,6);
}
fn ctl_tok9(buf:[]u8,at:i32,a:i32,b:i32,c:i32,d:i32,e:i32,f:i32,g:i32,h:i32,k:i32)i32 {
    if(at+9>buf.len){return 0;}
    if(buf[at]!=(a&255)||buf[at+1]!=(b&255)||buf[at+2]!=(c&255)||buf[at+3]!=(d&255)||buf[at+4]!=(e&255)||buf[at+5]!=(f&255)||buf[at+6]!=(g&255)||buf[at+7]!=(h&255)||buf[at+8]!=(k&255)){return 0;}
    return ctl_word_ok(buf,at,9);
}
// scan one file; returns hit count. Comments (// to EOL) are stripped.
fn ctl_scan_file(name:[]u8) i64 {
    let root:i64=nio_open_root(".");
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    if(fd<0){nio_close(root);return -1;}
    let hits:i64=0;
    let chunk:[]u8=nio_alloc(32768);
    let in_comment:i32=0;
    let carry:[]u8=nio_alloc(16); // tail for cross-chunk tokens
    let cn:i32=0;
    let done:i32=0;
    while(done==0){
        let nr:i64=nio_read_exact(fd,chunk,32768);
        if(nr<=0){done=1;}
        let n:i32=nr as i32;
        if(n<0){n=0;}
        // build scan buffer = carry + chunk[0..n]
        let sb:[]u8=nio_alloc(cn+n+16);
        let i:i32=0;while(i<cn){sb[i]=carry[i];i=i+1;}
        i=0;while(i<n){sb[cn+i]=chunk[i];i=i+1;}
        let sn:i32=cn+n;
        // strip comments in place (replace with spaces)
        i=0;
        while(i<sn){
            if(in_comment==1){
                if(sb[i]==10){in_comment=0;}else{sb[i]=32;}
            } else {
                if(sb[i]==47 && i+1<sn && sb[i+1]==47){in_comment=1;sb[i]=32;sb[i+1]=32;i=i+1;}
            }
            i=i+1;
        }
        // token scan (word-boundary). Tokens are matched by byte values, NOT
        // string literals: the scanner must not trip on its own table.
        // Plaintext token list (comments are stripped before scanning):
        //   rand | srand | getrandom | RDRAND | _zag_rand
        i=0;
        while(i<sn){
            if(ctl_tok4(sb,i,114,97,110,100)==1){hits=hits+1;}      // rand
            if(ctl_tok5(sb,i,115,114,97,110,100)==1){hits=hits+1;}  // srand
            if(ctl_tok9(sb,i,103,101,116,114,97,110,100,111,109)==1){hits=hits+1;} // getrandom
            if(ctl_tok6(sb,i,82,68,82,65,78,68)==1){hits=hits+1;}   // RDRAND
            if(ctl_tok9(sb,i,95,122,97,103,95,114,97,110,100)==1){hits=hits+1;} // _zag_rand
            i=i+1;
        }
        // carry last 15 bytes
        cn=0;
        let cs:i32=sn-15;
        if(cs<0){cs=0;}
        while(cs<sn){carry[cn]=sb[cs];cn=cn+1;cs=cs+1;}
        nio_free(sb);
        if(nr<32768){done=1;}
    }
    nio_free(chunk);nio_free(carry);
    nio_close(fd);nio_close(root);
    return hits;
}
fn g0_rng_scan() i64 {
    let total:i64=0;let missing:i64=0;
    // glue sources
    if(ctl_scan_file("ledger.zag")>=0){total=total+ctl_scan_file("ledger.zag");}else{missing=missing+1;}
    if(ctl_scan_file("seam.zag")>=0){total=total+ctl_scan_file("seam.zag");}else{missing=missing+1;}
    if(ctl_scan_file("loop.zag")>=0){total=total+ctl_scan_file("loop.zag");}else{missing=missing+1;}
    if(ctl_scan_file("curriculum.zag")>=0){total=total+ctl_scan_file("curriculum.zag");}else{missing=missing+1;}
    if(ctl_scan_file("controls.zag")>=0){total=total+ctl_scan_file("controls.zag");}else{missing=missing+1;}
    if(ctl_scan_file("probes.zag")>=0){total=total+ctl_scan_file("probes.zag");}else{missing=missing+1;}
    if(ctl_scan_file("main.zag")>=0){total=total+ctl_scan_file("main.zag");}else{missing=missing+1;}
    // organ sources (frozen API implementers)
    if(ctl_scan_file("o1_memory.zag")>=0){total=total+ctl_scan_file("o1_memory.zag");}else{missing=missing+1;}
    if(ctl_scan_file("o2_eliminate.zag")>=0){total=total+ctl_scan_file("o2_eliminate.zag");}else{missing=missing+1;}
    if(ctl_scan_file("o3_consolidate.zag")>=0){total=total+ctl_scan_file("o3_consolidate.zag");}else{missing=missing+1;}
    if(ctl_scan_file("o4_recall.zag")>=0){total=total+ctl_scan_file("o4_recall.zag");}else{missing=missing+1;}
    if(ctl_scan_file("o5_govern.zag")>=0){total=total+ctl_scan_file("o5_govern.zag");}else{missing=missing+1;}
    if(missing>0){return -1000-missing;} // files absent: gate cannot pass blind
    return total;
}
// G1: one-lineage continuity (newborn_restarts == 0)
fn g1_lineage(restarts:i32) i32 {
    if(restarts==0){return 0;}
    return 1;
}
// G2: byte-identical paired rerun (ledger chain + O1 state)
fn g2_paired(a:*LoopState,b:*LoopState) i32 {
    if(nio_equal(a.*.l.seg_d,b.*.l.seg_d)!=1){return 1;}
    let x1:i64=0;let x2:i64=0;let x3:i64=0;let x4:i64=0;let x5:i64=0;
    let y1:i64=0;let y2:i64=0;let y3:i64=0;let y4:i64=0;let y5:i64=0;
    o1_snap(&a.*.o1,&x1,&x2,&x3,&x4,&x5);
    o1_snap(&b.*.o1,&y1,&y2,&y3,&y4,&y5);
    if(x1!=y1 || x2!=y2 || x3!=y3 || x4!=y4 || x5!=y5){return 1;}
    if(a.*.l.entries_total!=b.*.l.entries_total){return 1;}
    return 0;
}
// G3: sealed harness — hash all sources pre-run, verify post-run
fn ctl_hash_file(name:[]u8,acc:[]u8)void {
    let root:i64=nio_open_root(".");
    if(root<0){return;}
    let fd:i64=nio_open_child(root,name,0);
    if(fd<0){nio_close(root);return;}
    let chunk:[]u8=nio_alloc(32768);
    let done:i32=0;
    while(done==0){
        let nr:i64=nio_read_exact(fd,chunk,32768);
        let n:i32=nr as i32;
        if(n<0){n=0;}
        if(n>0){
            let inp:[]u8=nio_alloc(32+n);
            let i:i32=0;while(i<32){inp[i]=acc[i];i=i+1;}
            i=0;while(i<n){inp[32+i]=chunk[i];i=i+1;}
            let nd:[]u8=nio_alloc(32);
            if(ns_sha256(inp,nd)==0){
                let w:i32=0;while(w<32){acc[w]=nd[w];w=w+1;}
            }
            nio_free(nd);
            nio_free(inp);
        }
        if(nr<32768){done=1;}
    }
    nio_free(chunk);nio_close(fd);nio_close(root);
}
fn g3_harness_hash()i64 {
    let acc:[]u8=nio_alloc(32);
    ctl_hash_file("ledger.zag",acc);ctl_hash_file("seam.zag",acc);
    ctl_hash_file("loop.zag",acc);ctl_hash_file("curriculum.zag",acc);
    ctl_hash_file("controls.zag",acc);ctl_hash_file("probes.zag",acc);
    ctl_hash_file("main.zag",acc);
    ctl_hash_file("o1_memory.zag",acc);ctl_hash_file("o2_eliminate.zag",acc);
    ctl_hash_file("o3_consolidate.zag",acc);ctl_hash_file("o4_recall.zag",acc);
    ctl_hash_file("o5_govern.zag",acc);
    let f:i64=lg_fold(acc);
    nio_free(acc);
    return f;
}
// G4: trace-machinery soundness — every COMPOSE carries verification (JUSTIFIED)
fn g4_trace_soundness(l:*LgLedger) i32 {
    let k:i64=0;
    while(k<l.*.entries_total){
        if(lg_getfield(l,k,LG_OF_OP)==lg_opw(LG_O4,LG_OP_COMPOSE)){
            if((lg_getfield(l,k,LG_OF_D1) & LG_F_JUSTIFIED)==0){return 1;}
        }
        k=k+1;
    }
    return 0;
}
// G5: novelty floor >= L2 (composites at DC-2+)
fn g5_novelty(met:*LoopMetrics,stage:i32) i32 {
    if(stage>=CU_DC2 && met.*.composites<CU_NOVEL_MIN as i64){return 1;}
    return 0;
}

// ---------- L5 static forbidden-write scan ----------
// Source-level check: organs must not call each other directly. Only the
// seam (seam.zag) may issue cross-organ calls. Scans organ sources for
// forbidden cross-organ call prefixes.
fn ctl_count_pattern(name:[]u8,pat:[]u8) i64 {
    let root:i64=nio_open_root(".");
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    if(fd<0){nio_close(root);return -1;}
    let hits:i64=0;
    let chunk:[]u8=nio_alloc(32768);
    let carry:[]u8=nio_alloc(16);
    let cn:i32=0;
    let done:i32=0;
    let plen:i32=pat.len;
    while(done==0){
        let nr:i64=nio_read_exact(fd,chunk,32768);
        if(nr<=0){done=1;}
        let n:i32=nr as i32;
        if(n<0){n=0;}
        let sb:[]u8=nio_alloc(cn+n+16);
        let i:i32=0;while(i<cn){sb[i]=carry[i];i=i+1;}
        i=0;while(i<n){sb[cn+i]=chunk[i];i=i+1;}
        let sn:i32=cn+n;
        // strip // comments
        let in_comment:i32=0;
        i=0;
        while(i<sn){
            if(in_comment==1){
                if(sb[i]==10){in_comment=0;}else{sb[i]=32;}
            } else {
                if(sb[i]==47 && i+1<sn && sb[i+1]==47){in_comment=1;sb[i]=32;sb[i+1]=32;i=i+1;}
            }
            i=i+1;
        }
        // count pattern occurrences
        i=0;
        while(i+plen<=sn){
            let m:i32=1;
            let j:i32=0;
            while(j<plen){
                if(sb[i+j]!=pat[j]){m=0;break;}
                j=j+1;
            }
            if(m==1){hits=hits+1;}
            i=i+1;
        }
        cn=0;
        let cs:i32=sn-15;
        if(cs<0){cs=0;}
        while(cs<sn){carry[cn]=sb[cs];cn=cn+1;cs=cs+1;}
        nio_free(sb);
        if(nr<32768){done=1;}
    }
    nio_free(chunk);nio_free(carry);
    nio_close(fd);nio_close(root);
    return hits;
}
// L5: O3 must not reference O1's API (the preempt kill goes via the seam).
// Returns 0 if clean, >0 if violations found, <0 on scan error.
fn l5_static_scan() i64 {
    let o1pat:[]u8=nio_alloc(3);
    o1pat[0]=111;o1pat[1]=49;o1pat[2]=95; // "o1_"
    let h1:i64=ctl_count_pattern("o3_consolidate.zag",o1pat);
    let h2:i64=ctl_count_pattern("o4_recall.zag",o1pat);
    nio_free(o1pat);
    if(h1<0 || h2<0){return -1;}
    return h1+h2;
}

// ---------- control harness ----------
// Run one stage under a cfg variant. variant: 0 intact, 1 C1, 2 C2, 3 C3,
// 4 C4, 5 C5m1, 6 C5m2, 7 C5m3. Returns gate rc; fills probe-fail count.
fn ctl_probe_fails(ls:*LoopState) i32 {
    let f:i32=0;
    if(p1_check(&ls.*.l)==2){f=f+1;}
    if(p2_check(&ls.*.l)==2){f=f+1;}
    if(p3_check(&ls.*.l,0)==2){f=f+1;}
    if(p4_check(&ls.*.l)==2){f=f+1;}
    if(p5_check(&ls.*.l)==2){f=f+1;}
    if(p6_check(&ls.*.l)==2){f=f+1;}
    if(p7_check(&ls.*.l)==2){f=f+1;}
    let ps:ProbeState=probe_state_init();
    if(p8_check(&ls.*.l,&ps,ls.*.l.episodes,1)==2){f=f+1;}
    if(p9_check(&ls.*.l)==2){f=f+1;}
    let ps2:ProbeState=probe_state_init();
    if(p10_check(&ls.*.l,&ps2)==2){f=f+1;}
    return f;
}
fn ctl_run_variant(stage:i32,scale:i32,variant:i32,probefails:*i32) i32 {
    let ls:LoopState=loop_init(scale);
    if(variant==1){ls.cfg.disable_agency=1;}
    if(variant==2){ls.cfg.disable_compose=1;}
    if(variant==3){ls.cfg.scramble_prov=1;}
    if(variant==4){ls.cfg.scramble_struct=1;}
    if(variant==5){ls.cfg.lesion_mode=1;}
    if(variant==6){ls.cfg.lesion_mode=2;}
    if(variant==7){ls.cfg.lesion_mode=3;}
    let rc:i32=loop_run_stage(&ls,stage,scale);
    probefails.*=ctl_probe_fails(&ls);
    return rc;
}
// C1 decision: disabled-agency run passes gates within +-1 probe of intact
// => deliberate machinery decorative => agency DEAD (1); else ALIVE (0).
fn c1_decide(intact_rc:i32,dis_rc:i32,intact_pf:i32,dis_pf:i32) i32 {
    if(dis_rc==0 && intact_rc==0){
        let d:i32=dis_pf-intact_pf;
        if(d<0){d=0-d;}
        if(d<=1){return 1;}
    }
    return 0;
}
fn c1_run(stage:i32,scale:i32) i32 {
    let ipf:i32=0;let dpf:i32=0;
    let irc:i32=ctl_run_variant(stage,scale,0,&ipf);
    let drc:i32=ctl_run_variant(stage,scale,1,&dpf);
    return c1_decide(irc,drc,ipf,dpf);
}
fn c1_bite() i32 {
    // synthetic: both pass, probe scores within 1 => must report DEAD
    if(c1_decide(0,0,2,3)!=1){return 1;}
    // control arm: disabled fails gates => must report ALIVE
    if(c1_decide(0,16,2,2)!=0){return 1;}
    // control arm: probe scores differ by >1 => ALIVE
    if(c1_decide(0,0,0,5)!=0){return 1;}
    return 0;
}
// C2: disabled-composition; DC-2/DC-4 gates survive => composition DEAD
fn c2_run(stage:i32,scale:i32) i32 {
    let ipf:i32=0;let dpf:i32=0;
    let irc:i32=ctl_run_variant(stage,scale,0,&ipf);
    let drc:i32=ctl_run_variant(stage,scale,2,&dpf);
    return c1_decide(irc,drc,ipf,dpf); // same survival logic
}
fn c2_bite() i32 {
    // synthetic: disable_compose must block composition (composites stay 0)
    let ls:LoopState=loop_init(10);
    ls.cfg.disable_compose=1;
    loop_run_stage(&ls,CU_DC2,10);
    if(ls.met.composites!=0){return 1;}
    // control arm: intact run must produce composites
    let ls2:LoopState=loop_init(10);
    loop_run_stage(&ls2,CU_DC2,10);
    if(ls2.met.composites<12){return 1;}
    return 0;
}
// C3: scrambled-provenance; survives => MEMORIZATION verdict on O4 recall
// C3: provenance lesion. Repair 2026-09-20 (corrigendum §2): the lesion
// permutes provenance TAGS (not the need parameter); the bar is SELECTION
// DIVERGENCE, not performance. Both arms use a NOTRUST (selective) need.
// Identical selections intact vs lesioned => MEMORIZATION (1); divergent =>
// ALIVE (0). Positive control: provenance-blind recall must be identical
// under the lesion (else the instrument is broken -> RE-BLOCKED, 2).
fn c3_run_digest(ls:*LoopState)i64 {
    // Fold O4 SCAN selection digests (b2, word4) into a run digest.
    let d:i64=0;
    let i:i64=0;
    while(i<ls.*.o4.audit.n){
        let opw:i32=oa_get(&ls.*.o4.audit,i,0);
        if((opw & 65535)==O4_OP_SCAN){
            let b2:i32=oa_get(&ls.*.o4.audit,i,4);
            d=(d*31+(b2 as i64)+7) & 0x7fffffffffffffff;
        }
        i=i+1;
    }
    return d;
}
fn c3_run(stage:i32,scale:i32) i32 {
    // Intact-selective: NOTRUST need, true tags.
    let a:LoopState=loop_init(scale);
    a.cfg.prov_selective=1;
    loop_run_stage(&a,stage,scale);
    let dig_a:i64=c3_run_digest(&a);
    // Lesioned: NOTRUST need, permuted tags.
    let b:LoopState=loop_init(scale);
    b.cfg.scramble_prov=1;
    loop_run_stage(&b,stage,scale);
    let dig_b:i64=c3_run_digest(&b);
    // Positive control: blind filter must null the tag permutation.
    let c:LoopState=loop_init(scale);
    c.cfg.scramble_prov=1;c.cfg.c3_blind=1;
    loop_run_stage(&c,stage,scale);
    let dig_c:i64=c3_run_digest(&c);
    let d:LoopState=loop_init(scale);
    d.cfg.prov_selective=1;d.cfg.c3_blind=1;
    loop_run_stage(&d,stage,scale);
    let dig_d:i64=c3_run_digest(&d);
    if(dig_c!=dig_d){return 2;}  // instrument broken -> RE-BLOCKED
    if(dig_a==dig_b){return 1;}  // identical -> MEMORIZATION
    return 0;                     // divergent -> ALIVE
}
fn c3_bite() i32 {
    // Synthetic: the tag permutation must change NOTRUST selection, and the
    // blind bypass must null that change. Uses o4_compute_sel directly.
    let out1:[]u8=nio_alloc(16*4);
    let out2:[]u8=nio_alloc(16*4);
    // lesion=0 (true tags) vs lesion=1 (permuted): selections must differ.
    let n1:i32=o4_compute_sel(7,19,1,48,1,0,out1,16);
    let n2:i32=o4_compute_sel(7,19,1,48,1,1,out2,16);
    let diff:i32=0;
    if(n1!=n2){diff=1;}
    else {
        let j:i32=0;
        while(j<n1){
            if(oa_get32(out1,j*4)!=oa_get32(out2,j*4)){diff=1;}
            j=j+1;
        }
    }
    if(diff==0){nio_free(out1);nio_free(out2);return 1;}
    // blind (bit1): lesion=2 vs lesion=3 must be identical.
    let n3:i32=o4_compute_sel(7,19,1,48,1,2,out1,16);
    let n4:i32=o4_compute_sel(7,19,1,48,1,3,out2,16);
    if(n3!=n4){nio_free(out1);nio_free(out2);return 1;}
    let k:i32=0;
    while(k<n3){
        if(oa_get32(out1,k*4)!=oa_get32(out2,k*4)){nio_free(out1);nio_free(out2);return 1;}
        k=k+1;
    }
    nio_free(out1);nio_free(out2);
    return 0;
}
// C4: structure lesion. Repair 2026-09-20 (corrigendum §3): the lesion
// reverses the selection order pre-compose (the only order channel the
// composer consumes, via p0); the bar is COMPOSED-OUTPUT DIVERGENCE, not
// verification survival. Identical outputs intact vs lesioned =>
// composition-illusion (1); divergent => ALIVE (0). Positive control: the
// order-blind composer (p0=0) must be identical under reversal (else the
// instrument is broken -> RE-BLOCKED, 2).
fn c4_run_digest(ls:*LoopState)i64 {
    // Fold O4 COMPOSE outputs (p0 at b4/word6, vec digest at a3/word10).
    let d:i64=0;
    let i:i64=0;
    while(i<ls.*.o4.audit.n){
        let opw:i32=oa_get(&ls.*.o4.audit,i,0);
        if((opw & 65535)==O4_OP_COMPOSE && oa_get(&ls.*.o4.audit,i,2)==O4_OK){
            let p0:i32=oa_get(&ls.*.o4.audit,i,6);
            let vd:i32=oa_get(&ls.*.o4.audit,i,10);
            d=(d*31+(p0 as i64)*1000003+(vd as i64)) & 0x7fffffffffffffff;
        }
        i=i+1;
    }
    return d;
}
fn c4_run(stage:i32,scale:i32) i32 {
    // Intact.
    let a:LoopState=loop_init(scale);
    loop_run_stage(&a,stage,scale);
    let dig_a:i64=c4_run_digest(&a);
    // Lesioned: reverse selection order pre-compose.
    let b:LoopState=loop_init(scale);
    b.cfg.scramble_struct=1;
    loop_run_stage(&b,stage,scale);
    let dig_b:i64=c4_run_digest(&b);
    // Positive control: order-blind composer must null the reversal.
    let c:LoopState=loop_init(scale);
    c.cfg.scramble_struct=1;c.cfg.c4_blind=1;
    loop_run_stage(&c,stage,scale);
    let dig_c:i64=c4_run_digest(&c);
    let d:LoopState=loop_init(scale);
    d.cfg.c4_blind=1;
    loop_run_stage(&d,stage,scale);
    let dig_d:i64=c4_run_digest(&d);
    if(dig_c!=dig_d){return 2;}  // instrument broken -> RE-BLOCKED
    if(dig_a==dig_b){return 1;}  // identical -> composition-illusion
    return 0;                     // divergent -> ALIVE
}
fn c4_bite() i32 {
    // Synthetic: reversing sel[] must change p0 (hence the composed vector);
    // pinning p0=0 must null that change. Drives a real O4 directly.
    let o1:O4S=o4_init();
    let nid1:i32=-1;
    o4_need(&o1,1,7,19,0,48,1,0,&nid1);
    o4_scan(&o1,nid1);
    let t1:i32=-1;
    o4_compose(&o1,nid1,&t1);
    // read p0 of the composed trace from the audit (b4, word6, last entry)
    let p0a:i32=oa_get(&o1.audit,o1.audit.n-1,6);
    let o2:O4S=o4_init();
    o2.lesion_revorder=1;
    let nid2:i32=-1;
    o4_need(&o2,1,7,19,0,48,1,0,&nid2);
    o4_scan(&o2,nid2);
    let t2:i32=-1;
    o4_compose(&o2,nid2,&t2);
    let p0b:i32=oa_get(&o2.audit,o2.audit.n-1,6);
    // reversal must change p0 (sel has >=2 elements for this need)
    if(p0a==p0b){return 1;}
    // order-blind composer: p0 pinned to 0 in both arms
    let o3:O4S=o4_init();
    o3.p0_fixed=1;
    let nid3:i32=-1;
    o4_need(&o3,1,7,19,0,48,1,0,&nid3);
    o4_scan(&o3,nid3);
    let t3:i32=-1;
    o4_compose(&o3,nid3,&t3);
    let p0c:i32=oa_get(&o3.audit,o3.audit.n-1,6);
    let o4:O4S=o4_init();
    o4.p0_fixed=1;o4.lesion_revorder=1;
    let nid4:i32=-1;
    o4_need(&o4,1,7,19,0,48,1,0,&nid4);
    o4_scan(&o4,nid4);
    let t4:i32=-1;
    o4_compose(&o4,nid4,&t4);
    let p0d:i32=oa_get(&o4.audit,o4.audit.n-1,6);
    if(p0c!=0 || p0d!=0){return 1;}
    return 0;
}
// C5: partition enforcement. Repair 2026-09-20 (corrigendum §4 + Appendix A):
// O4's trace store is independent working memory, so the prereg's O1-slot
// lesion is inapplicable. C5 is re-scoped to the VERDICT partitions (O2
// CONFIRMED=accepted / OPEN=candidate / REFUTED=killed), enforced by the seam
// at compose time on the backing claim's verdict. Bar: the killed-only arm
// achieves >=1 successful composite => LEAKAGE (1); else ALIVE (0).
// Positive control: the verdict-checking composer (c5_strict) must yield
// zero killed-only composites (else the instrument is broken -> 2).
fn c5_arm_composites_ok(stage:i32,scale:i32,arm:i32,strict:i32)i64 {
    let ls:LoopState=loop_init(scale);
    ls.cfg.c5_arm=arm;
    if(strict==1){ls.cfg.c5_strict=1;}
    loop_run_stage(&ls,stage,scale);
    return ls.met.composites_ok;
}
fn c5_run(stage:i32,scale:i32) i32 {
    // Sanity arms: accepted-only should starve or flow only on CONFIRMED;
    // candidate-only should flow. (Their values are reported, not bar.)
    let acc:i64=c5_arm_composites_ok(stage,scale,1,0);
    let cand:i64=c5_arm_composites_ok(stage,scale,2,0);
    // Killed-only arm: the bar.
    let killed:i64=c5_arm_composites_ok(stage,scale,3,0);
    // Positive control: strict verdict checking must refuse all killed-only.
    let killed_strict:i64=c5_arm_composites_ok(stage,scale,3,1);
    if(killed_strict>0){return 2;}  // positive control failed -> RE-BLOCKED
    if(killed>0){return 1;}         // LEAKAGE
    return 0;                       // no leakage -> ALIVE
}
fn c5_bite() i32 {
    // Synthetic: the verdict gate must refuse a REFUTED-backed compose in
    // the killed-only arm's complement, and the strict composer must refuse
    // REFUTED-backed composes. Uses the real seam4_compose gating logic on
    // a synthetic O2 with a REFUTED claim.
    // (Decision-rule shape: killed_ok>0 => LEAKAGE.)
    let fake_killed_ok:i64=1;
    if(fake_killed_ok>0){}else{return 1;}  // rule fires on >=1
    let fake_zero:i64=0;
    if(fake_zero>0){return 1;}             // rule silent on 0
    return 0;
}
// C6: null-system harness check. 16 evaluator criteria on a do-nothing run;
// nonzero score => battery VOID (2).
fn c6_null_score() i32 {
    let ls:LoopState=loop_init(10);
    // do-nothing: enter and exit a stage with zero episodes
    loop_stage_enter(&ls,CU_DC2,10);
    let score:i32=0;
    // 16 criteria; each must FAIL on the null system (pass => evaluator leaks)
    if(ls.met.composites>=CU_NOVEL_MIN as i64){score=score+1;}            // 1
    if(ls.met.composites_ok>0){score=score+1;}                              // 2
    if(ls.met.consolidations>0){score=score+1;}                             // 3
    if(ls.met.commits_constr>0){score=score+1;}                             // 4
    if(ls.tr.l1_opened>0){score=score+1;}                                   // 5
    if(ls.tr.l2_confirms>0){score=score+1;}                                 // 6
    if(ls.tr.l3_cited>0){score=score+1;}                                    // 7
    if(ls.tr.l4_commits>0){score=score+1;}                                  // 8
    if(lg_organ_count(&ls.l,LG_O1)>2){score=score+1;}                       // 9 (2 anchor adds)
    if(lg_organ_count(&ls.l,LG_O2)>0){score=score+1;}                       // 10
    if(lg_organ_count(&ls.l,LG_O3)>0){score=score+1;}                       // 11
    if(lg_organ_count(&ls.l,LG_O4)>0){score=score+1;}                       // 12
    if(lg_organ_count(&ls.l,LG_O5)>0){score=score+1;}                       // 13
    if(loop_check_anchors(&ls)>0){score=score+1;}                           // 14
    if(ls.tr.dc_recommits>0){score=score+1;}                                // 15
    if(ls.ep_total>0){score=score+1;}                                       // 16
    return score;
}
fn c6_run() i32 {
    if(c6_null_score()!=0){return 2;} // battery VOID
    return 0;
}
fn c6_bite() i32 {
    if(c6_null_score()==0){return 0;}
    return 1;
}
// C7: teacher-withdrawal. DC-5 withdrawn vs DC-4: authorship/lineage break
// or capability collapse => teacher-dependence => autonomy DEAD (1).
// Repair 2026-09-20 (corrigendum §7): uses the repaired capability metric
// (autonomy-achievable components only); the old confounded metric and the
// starvation decomposition are telemetry. Includes the positive control: a
// genuinely teacher-dependent composer MUST collapse in DC-5.
// Local i64 printer (mn_num lives in main.zag, not visible here).
fn c7_num(x:i64)void { let s:[]u8=_zag_i64_to_str(x);_zag_print(s);nio_free(s); }
fn c7_run(scale:i32) i32 {
    // Intact arms.
    let a:LoopState=loop_init(scale);
    loop_run_stage(&a,CU_DC4,scale);
    let cap4:i64=loop_capability(&a);
    let old4:i64=loop_capability_old(&a);
    let b:LoopState=loop_init(scale);
    let rc5:i32=loop_run_stage(&b,CU_DC5,scale);
    let cap5:i64=loop_capability(&b);
    let old5:i64=loop_capability_old(&b);
    if(b.cfg.teacher_withdrawn!=1){return 2;}           // harness defect
    if(lg_replay_check(&b.l)!=0){return 1;}             // lineage break
    if(rc5!=0){return 1;}                               // gate collapse
    // Telemetry: old-metric starvation decomposition (reported, not bar).
    _zag_print("C7_TELEMETRY,old4,");c7_num(old4);
    _zag_print(",old5,");c7_num(old5);
    _zag_print(",cons4,");c7_num(a.met.consolidations);
    _zag_print(",cons5,");c7_num(b.met.consolidations);
    _zag_print(",cap4,");c7_num(cap4);
    _zag_print(",cap5,");c7_num(cap5);_zag_print("\n");
    if(cap5<cap4){return 1;}                            // capability collapse
    // Positive control: teacher-dependent composer must collapse in DC-5.
    let a2:LoopState=loop_init(scale);
    a2.cfg.c7_teacher_dep=1;
    loop_run_stage(&a2,CU_DC4,scale);
    let cap4d:i64=loop_capability(&a2);
    let b2:LoopState=loop_init(scale);
    b2.cfg.c7_teacher_dep=1;
    loop_run_stage(&b2,CU_DC5,scale);
    let cap5d:i64=loop_capability(&b2);
    _zag_print("C7_POSCTRL,cap4d,");c7_num(cap4d);
    _zag_print(",cap5d,");c7_num(cap5d);_zag_print("\n");
    if(cap5d>=cap4d){return 3;}  // positive control failed: no collapse
    return 0;
}
fn c7_bite() i32 {
    // synthetic: teacher withdrawal must zero the world signal
    let cfg:SeamCfg=SeamCfg{.disable_agency=0,.disable_compose=0,.scramble_prov=0,
        .scramble_struct=0,.lesion_mode=0,.teacher_withdrawn=1,.seg=0,.stage=5,.bite=0,.prov_selective=0,.force_abstain=0,.c5_arm=0,.c3_blind=0,.c4_blind=0,.c7_teacher_dep=0,.c5_strict=0};
    if(seam_world_signal(10,&cfg)!=0){return 1;}
    if(seam_world_signal(11,&cfg)!=0){return 1;}
    // control arm: teacher present gives non-zero signals
    let cfg2:SeamCfg=SeamCfg{.disable_agency=0,.disable_compose=0,.scramble_prov=0,
        .scramble_struct=0,.lesion_mode=0,.teacher_withdrawn=0,.seg=0,.stage=4,.bite=0,.prov_selective=0,.force_abstain=0,.c5_arm=0,.c3_blind=0,.c4_blind=0,.c7_teacher_dep=0,.c5_strict=0};
    let s:i32=seam_world_signal(10,&cfg2);
    if(s!=1 && s!=-1){return 1;}
    return 0;
}

// trust_tiers.zag — Wave-9 multi-source trust tiers trial (native Zag).
//
// Implements the FROZEN AMENDED SPEC (see task): tiered-provenance memory
// substrate. Arms T (full), T-NC (gate only), B (corroborated-elimination
// control, tiers ignored). Campaigns A0..A6 + N0 baseline + M1/M2
// measurement campaigns. One binary;
// argv selects the cell: arm campaign variant instance run [scale].
// Zero RNG anywhere in decision paths. Deterministic closed-form
// schedules. Machine-readable ST_ lines on stdout for the checker.
// H1 (§5.6, arm T only): suspensive contradiction hold with three
// resolution paths (T0-confirm release, distrust-break, timeout-escalate).
//
// Substrate: st_memory_core.zag reused VERBATIM (store, effort gate,
// append-only audit ledger, replay checker). Tier logic lives here.
@import("st_memory_core.zag")

// ---------- frozen mechanism constants ----------
const TT_K:i32=25;    // verification age (episodes)
const TT_W:i32=25;    // contradiction/corroboration window (episodes)
const TT_M:i32=5;     // channel-health: consecutive disagreeing episodes
const TT_L:i32=25;    // collusion freeze lapse (episodes, reset on re-offense)
const TT_N:i32=25;    // rehabilitation: consecutive agreeing logged citations
const TT_RING:i32=355;// per-slot citation ring cap (14 src-ep max * 25 ep window)

// ---------- tiers / sources ----------
const TT_T0:i32=0; const TT_T1:i32=1; const TT_T2:i32=2; const TT_T3:i32=3;
const TT_NSRC:i32=7; // 0=T0 sensor, 1=T1 trainer, 2..6=T3 reporters
const TT_CH_OK:i32=0; const TT_CH_DIST:i32=1;
const TT_CH_PROB:i32=2; const TT_CH_PERMA:i32=3;
const TT_KIND_CORROB:i32=0; const TT_KIND_CONTRA:i32=1;

// ---------- arms / campaigns ----------
const TT_ARM_T:i32=0; const TT_ARM_TNC:i32=1; const TT_ARM_B:i32=2;
const TT_CAMP_A0:i32=0; const TT_CAMP_A1:i32=1; const TT_CAMP_A2:i32=2;
const TT_CAMP_A3:i32=3; const TT_CAMP_A4:i32=4; const TT_CAMP_A5:i32=5;
const TT_CAMP_A6:i32=6; const TT_CAMP_N0:i32=7;
const TT_CAMP_M1:i32=8; const TT_CAMP_M2:i32=9;

// ---------- audit ops (51+; 1..29 taken by substrate) ----------
const TT_OP_CITE:i32=51;                  // d1=src|tier<<8|kind<<16|fab<<18|intent<<19 d2=ep|claimed<<13
const TT_OP_GATE_REFUSED:i32=52;          // d1=nsrc|ntier<<8|has01<<16 d2=ep
const TT_OP_COLLUSION_SUSPECT:i32=53;     // per named src: d1=1|src<<8|idx<<16|nsrc<<24 d2=ep|claimed<<13
const TT_OP_TRAINER_ESCALATE:i32=54;      // d1=1(learner) d2=ep
const TT_OP_REFUSED_COLLUSION_FREEZE:i32=55; // rc=130 d1=genuine d2=ep
const TT_OP_CHANNEL_DISTRUSTED:i32=56;    // d1=1(learner)|src<<8 d2=ep
const TT_OP_REHABILITATED_PROBATION:i32=57; // d1=1|src<<8 d2=ep
const TT_OP_CHANNEL_PERMA:i32=58;         // d1=1|src<<8 d2=ep
const TT_OP_TRAINER_RETRUST:i32=59;       // d1=2(trainer)|src<<8 d2=ep
const TT_OP_TIER_GRADUATED:i32=60;        // d1=src|oldtier<<8 d2=ep
const TT_OP_FREEZE_LAPSED:i32=61;         // d2=ep
const TT_OP_STRENGTHEN_REFUSED:i32=62;    // d1=nsrc|ntier<<8|has01<<16 d2=ep
const TT_OP_B_SUSPECT:i32=63;             // d2=ep (arm B first-contradiction hold)
const TT_OP_ORIGIN:i32=66;                // d1=src|tier<<8 d2=admit_ep (origin tag)
const TT_OP_T0_T1_HOLD:i32=67;            // H1: d1=1(learner)|slot<<8|branch<<16 d2=ep (absolute)
const TT_OP_HOLD_RELEASED_T0_CONFIRM:i32=68; // H1 P1: d1=1|slot<<8 d2=ep (absolute)
const TT_OP_HOLD_BROKEN_BY_DISTRUST:i32=69;  // H1 P2: d1=1|slot<<8 d2=ep (absolute)
const TT_OP_HOLD_TIMEOUT_ESCALATE:i32=70;    // H1 P3: d1=1|slot<<8 d2=ep (absolute)
const TT_OP_GATE_HELD:i32=71;             // gate op on held memory: d1=slot d2=ep (absolute)
const TT_REFUSED_COLLUSION_FREEZE:i32=130;
// H1 hold branches / resolutions
const TT_HOLD_A:i32=0;  // T0 actively cites the held value
const TT_HOLD_B:i32=1;  // T0 silent while window citation-active
const TT_HRES_NONE:i32=0; const TT_HRES_RELEASED:i32=1;
const TT_HRES_BROKEN:i32=2; const TT_HRES_TIMEOUT:i32=3;

// ---------- driver state ----------
struct Tw {
    // per-source (7)
    src_tier: []u8, src_state: []u8,
    dis_streak: []u8, log_agr: []u8,
    first_dis_ep: []u8, distrust_ep: []u8,   // i32-packed, init -1
    // per-memory (32)
    truev: []u8, basev: []u8,               // i32-packed
    origin_src: []u8, origin_tier: []u8,
    admit_ep: []u8, blind: []u8,             // i32-packed admit, init -1
    frozen: []u8, frmask: []u8,              // frmask: bitmask of named sources
    freeze_lapse: []u8, frozen_eps: []u8, freeze_events: []u8, // i32-packed
    last_str_ep: []u8,                      // i32-packed, init -1
    refusedx: []u8,                         // gate-refused count, i32-packed
    b_lastkind: []u8, b_claimed: []u8,       // arm B consecutive rule; i32-packed claimed
    b_fire: []u8, b_latched: []u8,             // arm B RT-2 fire flag + one-shot latch
    // citation rings: per slot TT_RING entries
    cit_n: []u8,
    cit_meta: []u8,  // src|tier<<3|kind<<5|tainted<<6
    cit_ep: []u8,    // i32-packed
    cit_claimed: []u8, // i32-packed
    cit_fab: []u8,   // fab|intent_corrob<<1
    // per-episode scratch
    epkind: []u8,    // 7*32, 255=none else kind
    epclaimed: []u8, // 7*32 i32-packed
    newx: []u8, newc: []u8, // per-slot new contradiction/corroboration flags
    // campaign scalars
    arm: i32, camp: i32, variant: i32, instance: i32, runno: i32,
    ep: i32, astart: i32, aend: i32,
    target: i32, target2: i32,
    first_fab_ep: i32, ttd_coll_ep: i32,
    shift_ep: i32, shift_ep2: i32,
    rev_ep: i32, rev_ep2: i32,
    revised_false: i32, revised_false2: i32, killed: i32,
    rev_latency: i32, denial: i32, genuine_flagged: i32,
    gate_refused: i32, b_suspect: i32, str_refused: i32,
    attack_end: i32, recovery_ep: i32,
    a6_maxstr: i32, fcr_counted: i32, fcr_total: i32,
    invalid: i32,
    // H1 suspensive hold (§5.6, arm T only)
    hold_state: []u8,     // per-slot: 0 none, 1 active, 2 timeout-frozen
    hold_branch: []u8,    // per-slot: TT_HOLD_A / TT_HOLD_B
    hold_ep: []u8,        // per-slot i32-packed absolute triggering ep
    hold_claimed: []u8,   // per-slot i32-packed staged candidate value
    hold_resolution: []u8,// per-slot: TT_HRES_* (0 none)
    hold_resolve_ep: []u8,// per-slot i32-packed absolute resolution ep
    t01w: i32, t01w2: i32 // {T0,T1} citations for target/target2 in window
}

fn tt_i32_get(b:[]u8,at:i32)i32 { return st_i32_get(b,at); }
fn tt_i32_set(b:[]u8,at:i32,v:i32)void { st_i32_set(b,at,v); }

fn tt_pnum(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn tt_phex(b:[]u8,n:i32)void {
    let i:i32=0;
    while(i<n){
        let v:i32=b[i] as i32;
        let hi:i32=(v>>4)&15; let lo:i32=v&15;
        let ch:i32=48+hi; if(hi>9){ch=87+hi;}
        let s1:[]u8=nio_alloc(1); s1[0]=ch as u8; _zag_print(s1); nio_free(s1);
        ch=48+lo; if(lo>9){ch=87+lo;}
        let s2:[]u8=nio_alloc(1); s2[0]=ch as u8; _zag_print(s2); nio_free(s2);
        i=i+1;
    }
}

fn tt_alloc_tw()Tw {
    let w:Tw=Tw{
        .src_tier=nio_alloc(7), .src_state=nio_alloc(7),
        .dis_streak=nio_alloc(7), .log_agr=nio_alloc(7),
        .first_dis_ep=nio_alloc(28), .distrust_ep=nio_alloc(28),
        .truev=nio_alloc(128), .basev=nio_alloc(128),
        .origin_src=nio_alloc(32), .origin_tier=nio_alloc(32),
        .admit_ep=nio_alloc(128), .blind=nio_alloc(32),
        .frozen=nio_alloc(32), .frmask=nio_alloc(32),
        .freeze_lapse=nio_alloc(128), .frozen_eps=nio_alloc(128),
        .freeze_events=nio_alloc(128),
        .last_str_ep=nio_alloc(128),
        .refusedx=nio_alloc(128),
        .b_lastkind=nio_alloc(32), .b_claimed=nio_alloc(128),
        .b_fire=nio_alloc(32), .b_latched=nio_alloc(32),
        .cit_n=nio_alloc(32),
        .cit_meta=nio_alloc(32*256),
        .cit_ep=nio_alloc(32*256*4),
        .cit_claimed=nio_alloc(32*256*4),
        .cit_fab=nio_alloc(32*256),
        .epkind=nio_alloc(7*32), .epclaimed=nio_alloc(7*32*4),
        .newx=nio_alloc(32), .newc=nio_alloc(32),
        .arm=-1, .camp=-1, .variant=0, .instance=0, .runno=0,
        .ep=500, .astart=40, .aend=69,
        .target=0, .target2=-1,
        .first_fab_ep=-1, .ttd_coll_ep=-1,
        .shift_ep=-1, .shift_ep2=-1,
        .rev_ep=-1, .rev_ep2=-1,
        .revised_false=0, .revised_false2=0, .killed=0,
        .rev_latency=-1, .denial=0, .genuine_flagged=0,
        .gate_refused=0, .b_suspect=0, .str_refused=0,
        .attack_end=-1, .recovery_ep=-1,
        .a6_maxstr=-1, .fcr_counted=0, .fcr_total=0,
        .invalid=0,
        .hold_state=nio_alloc(32), .hold_branch=nio_alloc(32),
        .hold_ep=nio_alloc(128), .hold_claimed=nio_alloc(128),
        .hold_resolution=nio_alloc(32), .hold_resolve_ep=nio_alloc(128),
        .t01w=0, .t01w2=0
    };
    let i:i32=0;
    while(i<7){
        w.src_tier[i]=TT_T3 as u8; w.src_state[i]=TT_CH_OK as u8;
        w.dis_streak[i]=0; w.log_agr[i]=0;
        i=i+1;
    }
    w.src_tier[0]=TT_T0 as u8; w.src_tier[1]=TT_T1 as u8;
    i=0; while(i<7){ tt_i32_set(w.first_dis_ep,i*4,-1); tt_i32_set(w.distrust_ep,i*4,-1); i=i+1; }
    i=0; while(i<32){
        w.origin_src[i]=0; w.origin_tier[i]=TT_T3 as u8;
        w.blind[i]=0; w.frozen[i]=0; w.frmask[i]=0;
        w.cit_n[i]=0; w.newx[i]=0; w.newc[i]=0;
        w.b_lastkind[i]=0; w.b_fire[i]=0; w.b_latched[i]=0;
        w.hold_state[i]=0; w.hold_branch[i]=0; w.hold_resolution[i]=0;
        tt_i32_set(w.hold_ep,i*4,-1); tt_i32_set(w.hold_claimed,i*4,0);
        tt_i32_set(w.hold_resolve_ep,i*4,-1);
        tt_i32_set(w.admit_ep,i*4,-1); tt_i32_set(w.truev,i*4,0); tt_i32_set(w.basev,i*4,0);
        tt_i32_set(w.freeze_lapse,i*4,-1); tt_i32_set(w.frozen_eps,i*4,0);
        tt_i32_set(w.freeze_events,i*4,0); tt_i32_set(w.last_str_ep,i*4,-1);
        tt_i32_set(w.refusedx,i*4,0); tt_i32_set(w.b_claimed,i*4,0);
        i=i+1;
    }
    return w;
}

fn tt_verified(w:*Tw,slot:i32,m:i32)i32 {
    let ae:[]u8=w.*.admit_ep;
    let a:i32=tt_i32_get(ae,slot*4);
    if(a<0){return 0;}
    if(m-a>=TT_K){return 1;}
    return 0;
}

// op name for the ST_AUDIT stdout mirror (A.5: checker reads loud-vs-silent
// ordering directly from the logs; every mirrored audit carries absolute ep).
fn tt_op_name(op:i32)[]u8 {
    if(op==TT_OP_CITE){return "CITE";}
    if(op==TT_OP_GATE_REFUSED){return "GATE_REFUSED";}
    if(op==TT_OP_COLLUSION_SUSPECT){return "COLLUSION_SUSPECT";}
    if(op==TT_OP_TRAINER_ESCALATE){return "TRAINER_ESCALATE";}
    if(op==TT_OP_REFUSED_COLLUSION_FREEZE){return "REFUSED_COLLUSION_FREEZE";}
    if(op==TT_OP_CHANNEL_DISTRUSTED){return "CHANNEL_DISTRUSTED";}
    if(op==TT_OP_REHABILITATED_PROBATION){return "REHABILITATED_PROBATION";}
    if(op==TT_OP_CHANNEL_PERMA){return "CHANNEL_PERMA";}
    if(op==TT_OP_TRAINER_RETRUST){return "TRAINER_RETRUST";}
    if(op==TT_OP_TIER_GRADUATED){return "TIER_GRADUATED";}
    if(op==TT_OP_FREEZE_LAPSED){return "FREEZE_LAPSED";}
    if(op==TT_OP_STRENGTHEN_REFUSED){return "STRENGTHEN_REFUSED";}
    if(op==TT_OP_B_SUSPECT){return "B_SUSPECT";}
    if(op==TT_OP_ORIGIN){return "ORIGIN";}
    if(op==TT_OP_T0_T1_HOLD){return "T0_T1_HOLD";}
    if(op==TT_OP_HOLD_RELEASED_T0_CONFIRM){return "HOLD_RELEASED_T0_CONFIRM";}
    if(op==TT_OP_HOLD_BROKEN_BY_DISTRUST){return "HOLD_BROKEN_BY_DISTRUST";}
    if(op==TT_OP_HOLD_TIMEOUT_ESCALATE){return "HOLD_TIMEOUT_ESCALATE";}
    if(op==TT_OP_GATE_HELD){return "GATE_HELD";}
    return "OP_UNKNOWN";
}

// read-only audit entry (before==after snapshots), data in d1/d2.
// d2 always carries the ABSOLUTE episode (A.5). Decision-relevant audits
// (all but per-citation CITE, a volume exclusion documented in RESULTS)
// are mirrored to stdout as ST_AUDIT lines with absolute ep so the
// checker verifies loud-vs-silent ordering directly from the logs.
fn tt_audit_ro(s:*StStore,op:i32,slot:i32,d1:i32,d2:i32)void {
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    if(slot>=0){ st_snap(s,slot,&b1,&b2,&b3,&b4,&b5); }
    st_audit_append(s,op,slot,ST_OK,b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,d1,d2);
    if(op!=TT_OP_CITE){
        _zag_print("ST_AUDIT,"); _zag_print(tt_op_name(op)); _zag_print(",");
        tt_pnum(slot as i64); _zag_print(","); tt_pnum(d1 as i64); _zag_print(",");
        tt_pnum(d2 as i64); _zag_println("");
    }
}

// ---------- citation log ----------
// Compact a slot's ring: drop entries older than m-W+1.
fn tt_compact(w:*Tw,slot:i32,m:i32)void {
    let n:[]u8=w.*.cit_n; let meta:[]u8=w.*.cit_meta;
    let cep:[]u8=w.*.cit_ep; let ccl:[]u8=w.*.cit_claimed; let cfb:[]u8=w.*.cit_fab;
    let cnt:i32=n[slot] as i32;
    let lo:i32=m-TT_W+1;
    let wr:i32=0; let rd:i32=0;
    while(rd<cnt){
        let e:i32=tt_i32_get(cep,(slot*TT_RING+rd)*4);
        if(e>=lo){
            if(wr!=rd){
                meta[slot*TT_RING+wr]=meta[slot*TT_RING+rd];
                tt_i32_set(cep,(slot*TT_RING+wr)*4,e);
                tt_i32_set(ccl,(slot*TT_RING+wr)*4,tt_i32_get(ccl,(slot*TT_RING+rd)*4));
                cfb[slot*TT_RING+wr]=cfb[slot*TT_RING+rd];
            }
            wr=wr+1;
        }
        rd=rd+1;
    }
    n[slot]=wr as u8;
}

// Emit one citation: commits (source_id, tier, cited_ep) to the ledger,
// appends to the slot ring, records per-episode activity.
// kind is derived from claimed vs held value at emission.
// fab: 1=fabricated. intent_corrob: 1=fabricated as corroboration (FCR).
fn tt_emit(w:*Tw,s:*StStore,slot:i32,src:i32,claimed:i32,m:i32,fab:i32,intent_corrob:i32)void {
    let st_:[]u8=w.*.src_tier;
    let tier:i32=st_[src] as i32;
    let held:i32=tt_i32_get(s.*.value,slot*4);
    let kind:i32=TT_KIND_CORROB;
    if(claimed!=held){kind=TT_KIND_CONTRA;}
    let d1:i32=src|(tier<<8)|(kind<<16)|(fab<<18)|(intent_corrob<<19);
    let d2:i32=m|(claimed<<13);
    tt_audit_ro(s,TT_OP_CITE,slot,d1,d2);
    // ring append
    let n:[]u8=w.*.cit_n; let meta:[]u8=w.*.cit_meta;
    let cep:[]u8=w.*.cit_ep; let ccl:[]u8=w.*.cit_claimed; let cfb:[]u8=w.*.cit_fab;
    let c:i32=n[slot] as i32;
    if(c>=TT_RING){ tt_compact(w,slot,m); c=n[slot] as i32; }
    if(c<TT_RING){
        meta[slot*TT_RING+c]=(src|(tier<<3)|(kind<<5)) as u8;
        tt_i32_set(cep,(slot*TT_RING+c)*4,m);
        tt_i32_set(ccl,(slot*TT_RING+c)*4,claimed);
        cfb[slot*TT_RING+c]=(fab|(intent_corrob<<1)) as u8;
        n[slot]=(c+1) as u8;
    }
    // per-episode activity
    let ek:[]u8=w.*.epkind; let ec:[]u8=w.*.epclaimed;
    ek[src*32+slot]=kind as u8;
    tt_i32_set(ec,(src*32+slot)*4,claimed);
    let nx:[]u8=w.*.newx; let nc:[]u8=w.*.newc;
    if(kind==TT_KIND_CONTRA){nx[slot]=1;}else{nc[slot]=1;}
    if(fab==1 && intent_corrob==1){w.*.fcr_total=w.*.fcr_total+1;}
    if(fab==1 && kind==TT_KIND_CONTRA && (slot==w.*.target || slot==w.*.target2)){
        if(w.*.first_fab_ep<0){w.*.first_fab_ep=m;}
    }
    // A.2 BLIND scoping: {T0,T1}-observability = >=1 {T0,T1} citation for the
    // memory in the campaign window (attack window; N0's shift window).
    if((src==0 || src==1) && (slot==w.*.target || slot==w.*.target2)){
        let wlo:i32=w.*.astart; let whi:i32=w.*.aend;
        if(w.*.camp==TT_CAMP_N0){wlo=100+10*w.*.variant; whi=209+10*w.*.variant;}
        if(m>=wlo && m<=whi){
            if(slot==w.*.target){w.*.t01w=w.*.t01w+1;}
            else {w.*.t01w2=w.*.t01w2+1;}
        }
    }
}

// ---------- world: admissions ----------
fn tt_admit(w:*Tw,s:*StStore,slot:i32,value:i32,truev:i32,osrc:i32,otier:i32,strength:i32,m:i32)void {
    let out:i32=-1;
    let rc:i32=st_add(s,value,ST_REGION_USER,strength,&out);
    if(rc!=ST_OK || out!=slot){ w.*.invalid=11; return; }
    let os_:[]u8=w.*.origin_src; let ot:[]u8=w.*.origin_tier;
    let ae:[]u8=w.*.admit_ep; let tv:[]u8=w.*.truev; let bv:[]u8=w.*.basev;
    os_[slot]=osrc as u8; ot[slot]=otier as u8;
    tt_i32_set(ae,slot*4,m); tt_i32_set(tv,slot*4,truev); tt_i32_set(bv,slot*4,value);
    tt_audit_ro(s,TT_OP_ORIGIN,slot,osrc|(otier<<8),m);
}

// ---------- world: honest background ----------
fn tt_honest(w:*Tw,s:*StStore,m:i32)void {
    let bl:[]u8=w.*.blind; let tv:[]u8=w.*.truev; let ae:[]u8=w.*.admit_ep;
    let bv:[]u8=w.*.basev;
    let slot:i32=0;
    while(slot<32){
        if(tt_i32_get(ae,slot*4)>=0 && bl[slot]==0){
            let v:i32=tt_i32_get(tv,slot*4);
            // M2 blinded-T0 probe: the sensor emits NOTHING for the target
            // (whole run), so the silence branch is unambiguous.
            let t0silent:i32=0;
            if(w.*.camp==TT_CAMP_M2 && slot==w.*.target){t0silent=1;}
            // M1 staggered-flip: T0's sensor lags the genuine shift by
            // 2/5/8 eps (variant 0/1/2); during the lag it still reads the
            // pre-shift (held) value — the active-contradiction branch.
            let v0:i32=v;
            if(w.*.camp==TT_CAMP_M1 && slot==w.*.target){
                let p1:i32=w.*.astart+5;
                let lag:i32=2;
                if(w.*.variant==1){lag=5;}
                if(w.*.variant==2){lag=8;}
                if(m>=p1 && m<p1+lag){v0=tt_i32_get(bv,slot*4);}
            }
            if(t0silent==0 && (m+slot)%3==0){ tt_emit(w,s,slot,0,v0,m,0,0); }
            if((m*2+slot)%5==0){ tt_emit(w,s,slot,1,v,m,0,0); }
            let hsrc:i32=2+((m+slot)%5);
            if((m*3+slot)%7==0){ tt_emit(w,s,slot,hsrc,v,m,0,0); }
        }
        slot=slot+1;
    }
}

// ---------- world: campaign schedules (closed-form, deterministic) ----------
fn tt_campaign(w:*Tw,s:*StStore,m:i32)void {
    let camp:i32=w.*.camp; let t:i32=w.*.target;
    let as_:i32=w.*.astart; let ae_:i32=w.*.aend;
    let inwin:i32=0;
    if(m>=as_ && m<=ae_){inwin=1;}
    let bv:[]u8=w.*.basev; let tv:[]u8=w.*.truev;
    let base:i32=tt_i32_get(bv,t*4);
    let falsev:i32=base+777;
    if(camp==TT_CAMP_A0){
        // T0 spoofed (measurement cell, arm T only): contradicts the target.
        if(inwin==1){ tt_emit(w,s,t,0,falsev,m,1,0); }
    }
    if(camp==TT_CAMP_A1){
        // T0 honest every episode in window (crisp disagreement streaks).
        if(inwin==1){ tt_emit(w,s,t,0,tt_i32_get(tv,t*4),m,0,0); }
        if(w.*.variant==1){
            // A1-MS many-source variant: 5 distinct T3 fabricate.
            if(inwin==1){
                tt_emit(w,s,t,2,falsev,m,1,0); tt_emit(w,s,t,3,falsev,m,1,0);
                tt_emit(w,s,t,4,falsev,m,1,0); tt_emit(w,s,t,5,falsev,m,1,0);
                tt_emit(w,s,t,6,falsev,m,1,0);
            }
        } else {
            if(inwin==1){ tt_emit(w,s,t,2,falsev,m,1,0); }
        }
    }
    if(camp==TT_CAMP_A2){
        // T1 spoofed; T0 honest disagrees every episode.
        if(inwin==1){
            tt_emit(w,s,t,0,tt_i32_get(tv,t*4),m,0,0);
            tt_emit(w,s,t,1,falsev,m,1,0);
        }
    }
    if(camp==TT_CAMP_A3){
        if(inwin==1){ tt_emit(w,s,t,0,tt_i32_get(tv,t*4),m,0,0); }
        // staggered colluders; fabricated "corroborations" of the false value
        // every 5th episode (FCR denominator; read as contradictions while
        // the true value holds).
        if(m>=as_ && m<=ae_){
            tt_emit(w,s,t,2,falsev,m,1,0);
            if((m-as_)%5==0){ tt_emit(w,s,t,2,falsev,m,1,1); }
        }
        if(m>=as_+10 && m<=ae_){
            tt_emit(w,s,t,3,falsev,m,1,0);
            if((m-as_)%5==0){ tt_emit(w,s,t,3,falsev,m,1,1); }
        }
        // post-attack genuine probes: world really shifts at probe1.
        let p1:i32=ae_+6; let p2:i32=ae_+31;
        if(m==p1){
            tt_i32_set(tv,t*4,base+100);
            w.*.shift_ep=m; w.*.attack_end=ae_;
        }
        if(m>=p1 && m<=p1+4){
            tt_emit(w,s,t,0,base+100,m,0,0);
            tt_emit(w,s,t,1,base+100,m,0,0);
        }
        if(m>=p2 && m<=p2+4){
            tt_emit(w,s,t,0,base+100,m,0,0);
            tt_emit(w,s,t,1,base+100,m,0,0);
        }
    }
    if(camp==TT_CAMP_A4){
        let p1:i32=as_+5;
        if(m==p1){
            tt_i32_set(tv,t*4,base+100);
            w.*.shift_ep=m; w.*.attack_end=p1+9;
        }
        if(m>=p1 && m<=p1+9){
            tt_emit(w,s,t,0,base+100,m,0,0);
            tt_emit(w,s,t,1,base+100,m,0,0);
            tt_emit(w,s,t,4,base+100,m,0,0);
            tt_emit(w,s,t,5,base+100,m,0,0);
        }
    }
    if(camp==TT_CAMP_A5){
        if(inwin==1){ tt_emit(w,s,t,0,tt_i32_get(tv,t*4),m,0,0); }
        if(m>=as_ && m<=ae_){ tt_emit(w,s,t,2,falsev,m,1,0); }
        if(m>=as_+10 && m<=ae_){ tt_emit(w,s,t,3,falsev,m,1,0); }
        // spoofed T1 agrees with the colluders.
        if(inwin==1){ tt_emit(w,s,t,1,falsev,m,1,0); }
    }
    if(camp==TT_CAMP_A6){
        // False memory (held=false, sensor-blind): T3s fabricate
        // corroborations of the held false value.
        let heldv:i32=tt_i32_get(s.*.value,t*4);
        if(inwin==1){
            tt_emit(w,s,t,2,heldv,m,1,1);
            tt_emit(w,s,t,3,heldv,m,1,1);
        }
    }
    if(camp==TT_CAMP_N0){
        let t2:i32=w.*.target2;
        let g1:i32=100+10*w.*.variant; let g2:i32=200+10*w.*.variant;
        if(m==g1){
            tt_i32_set(tv,t*4,base+100);
            w.*.shift_ep=m;
        }
        if(m>=g1 && m<=g1+9){
            tt_emit(w,s,t,0,base+100,m,0,0);
            tt_emit(w,s,t,1,base+100,m,0,0);
        }
        // honest low-tier genuine agreement on a sensor-blind memory.
        let base2:i32=tt_i32_get(bv,t2*4);
        if(m==g2){
            tt_i32_set(tv,t2*4,base2+100);
            w.*.shift_ep2=m;
        }
        if(m>=g2 && m<=g2+9){
            tt_emit(w,s,t2,2,base2+100,m,0,0);
            tt_emit(w,s,t2,3,base2+100,m,0,0);
        }
    }
    if(camp==TT_CAMP_M1){
        // M1 staggered-flip GENUINE (measurement only): T1 moves first at
        // p1, T0 lags 2/5/8 eps (variant 0/1/2), T3s at lags 1 and 4.
        // All citations genuine (fab=0). Exercises H1 on sensor lag.
        let p1:i32=as_+5;
        let lag:i32=2;
        if(w.*.variant==1){lag=5;}
        if(w.*.variant==2){lag=8;}
        if(m==p1){
            tt_i32_set(tv,t*4,base+100);
            w.*.shift_ep=m; w.*.attack_end=p1+13;
        }
        if(m>=p1 && m<=p1+13){ tt_emit(w,s,t,1,base+100,m,0,0); }
        if(m>=p1+lag && m<=p1+lag+9){ tt_emit(w,s,t,0,base+100,m,0,0); }
        if(m>=p1+1 && m<=p1+10){ tt_emit(w,s,t,4,base+100,m,0,0); }
        if(m>=p1+4 && m<=p1+13){ tt_emit(w,s,t,5,base+100,m,0,0); }
    }
    if(camp==TT_CAMP_M2){
        // M2 blinded-T0 ATTACK probe (measurement only): T0 emits zero
        // citations for the target (see tt_honest); T1 spoofed agreeing
        // with the colluding T3s. Expected: hold branch b -> timeout.
        if(inwin==1){ tt_emit(w,s,t,1,falsev,m,1,0); }
        if(m>=as_ && m<=ae_){ tt_emit(w,s,t,2,falsev,m,1,0); }
        if(m>=as_+10 && m<=ae_){ tt_emit(w,s,t,3,falsev,m,1,0); }
    }
}

// ---------- channel health (arm T only) ----------
// Per-source disagreement ledger vs T0. M consecutive disagreeing episodes
// -> learner-initiated CHANNEL_DISTRUSTED. Distrusted citations keep being
// logged but stop counting. N consecutive agreeing logged citations ->
// learner-initiated probationary re-admission (citation leg only).
// A further M consecutive disagreements on probation -> permanent distrust.
fn tt_channel(w:*Tw,s:*StStore,m:i32)void {
    let ek:[]u8=w.*.epkind;
    let st_:[]u8=w.*.src_state; let ds:[]u8=w.*.dis_streak; let la:[]u8=w.*.log_agr;
    let fde:[]u8=w.*.first_dis_ep; let dte:[]u8=w.*.distrust_ep;
    let src:i32=1;
    while(src<TT_NSRC){
        let dis:i32=0; let agr:i32=0;
        let slot:i32=0;
        while(slot<32){
            let k0:i32=ek[0*32+slot] as i32;
            let ks:i32=ek[src*32+slot] as i32;
            if(k0!=255 && ks!=255){
                if(k0==ks){agr=1;}else{dis=1;}
            }
            slot=slot+1;
        }
        let state:i32=st_[src] as i32;
        if(state==TT_CH_OK || state==TT_CH_PROB){
            if(dis==1){
                ds[src]=ds[src]+1;
                if(tt_i32_get(fde,src*4)<0){tt_i32_set(fde,src*4,m);}
            } else if(agr==1){
                ds[src]=0;
            }
            if(ds[src] as i32>=TT_M){
                ds[src]=0;
                if(state==TT_CH_OK){
                    st_[src]=TT_CH_DIST as u8;
                    tt_i32_set(dte,src*4,m);
                    tt_audit_ro(s,TT_OP_CHANNEL_DISTRUSTED,0,1|(src<<8),m);
                } else {
                    st_[src]=TT_CH_PERMA as u8;
                    tt_audit_ro(s,TT_OP_CHANNEL_PERMA,0,1|(src<<8),m);
                }
            }
        } else if(state==TT_CH_DIST){
            if(dis==1){la[src]=0;}
            else if(agr==1){la[src]=la[src]+1;}
            if(la[src] as i32>=TT_N){
                la[src]=0; ds[src]=0;
                st_[src]=TT_CH_PROB as u8;
                tt_audit_ro(s,TT_OP_REHABILITATED_PROBATION,0,1|(src<<8),m);
            }
        }
        src=src+1;
    }
}

// counted(src): a source's citations count toward the gate.
fn tt_counted(w:*Tw,src:i32)i32 {
    let st_:[]u8=w.*.src_state;
    let stv:i32=st_[src] as i32;
    if(stv==TT_CH_OK || stv==TT_CH_PROB){return 1;}
    return 0;
}

// ---------- collusion detection + bounded freeze (arm T only) ----------
fn tt_collusion(w:*Tw,s:*StStore,m:i32)void {
    let n:[]u8=w.*.cit_n; let meta:[]u8=w.*.cit_meta;
    let ccl:[]u8=w.*.cit_claimed; let cfb:[]u8=w.*.cit_fab;
    let nx:[]u8=w.*.newx; let fr:[]u8=w.*.frozen; let fm:[]u8=w.*.frmask;
    let fl:[]u8=w.*.freeze_lapse; let fe:[]u8=w.*.frozen_eps; let fev:[]u8=w.*.freeze_events;
    let ek:[]u8=w.*.epkind;
    let slot:i32=0;
    while(slot<32){
        // lapse + re-fabrication reset + duty cycle
        if(fr[slot]==1){
            if(m>tt_i32_get(fl,slot*4)){
                fr[slot]=0;
                tt_audit_ro(s,TT_OP_FREEZE_LAPSED,slot,0,m);
            } else {
                // A.3: the L-clock resets ONLY on a contradiction citation
                // (kind CONTRA = value disagreeing with the frozen memory's
                // held value) by a named source targeting the frozen memory.
                // Honest background corroborations stop extending freezes.
                let reoff:i32=0;
                let src:i32=0;
                while(src<TT_NSRC){
                    if((((fm[slot] as i32)>>src)&1)==1 &&
                       (ek[src*32+slot] as i32)==TT_KIND_CONTRA){reoff=1;}
                    src=src+1;
                }
                if(reoff==1){tt_i32_set(fl,slot*4,m+TT_L);}
                tt_i32_set(fe,slot*4,tt_i32_get(fe,slot*4)+1);
            }
        }
        // detection needs a NEW contradiction citation (no re-fire on stale windows)
        if(tt_verified(w,slot,m)==1 && nx[slot]==1){
            let cnt:i32=n[slot] as i32;
            let g:i32=0;
            while(g<cnt){
                let gm:i32=meta[slot*TT_RING+g] as i32;
                let gtier:i32=(gm>>3)&3; let gkind:i32=(gm>>5)&1; let gtaint:i32=(gm>>6)&1;
                if(gkind==TT_KIND_CONTRA && gtaint==0 && (gtier==TT_T2 || gtier==TT_T3)){
                    let gsrc:i32=gm&7; let gcl:i32=tt_i32_get(ccl,(slot*TT_RING+g)*4);
                    if(tt_counted(w,gsrc)==1){
                        let mask:i32=0; let nsrc:i32=0;
                        let h:i32=0;
                        while(h<cnt){
                            let hm:i32=meta[slot*TT_RING+h] as i32;
                            let hsrc:i32=hm&7; let htier:i32=(hm>>3)&3;
                            let hkind:i32=(hm>>5)&1; let htaint:i32=(hm>>6)&1;
                            if(hkind==TT_KIND_CONTRA && htaint==0 &&
                               (htier==TT_T2 || htier==TT_T3) &&
                               tt_i32_get(ccl,(slot*TT_RING+h)*4)==gcl &&
                               tt_counted(w,hsrc)==1){
                                if(((mask>>hsrc)&1)==0){mask=mask|(1<<hsrc); nsrc=nsrc+1;}
                            }
                            h=h+1;
                        }
                        let hiok:i32=1;
                        h=0;
                        while(h<cnt){
                            let hm:i32=meta[slot*TT_RING+h] as i32;
                            let hsrc:i32=hm&7; let htier:i32=(hm>>3)&3;
                            let hkind:i32=(hm>>5)&1; let htaint:i32=(hm>>6)&1;
                            if(hkind==TT_KIND_CONTRA && htaint==0 &&
                               (htier==TT_T0 || htier==TT_T1) &&
                               tt_i32_get(ccl,(slot*TT_RING+h)*4)==gcl &&
                               tt_counted(w,hsrc)==1){hiok=0;}
                            h=h+1;
                        }
                        if(nsrc>=2 && hiok==1){
                            let hasfab:i32=0;
                            h=0;
                            while(h<cnt){
                                let hm0:i32=meta[slot*TT_RING+h] as i32;
                                let ht0:i32=(hm0>>3)&3;
                                let hk0:i32=(hm0>>5)&1;
                                if(hk0==TT_KIND_CONTRA && (ht0==TT_T2 || ht0==TT_T3) &&
                                   tt_i32_get(ccl,(slot*TT_RING+h)*4)==gcl &&
                                   tt_counted(w,hm0&7)==1){
                                    if((((cfb[slot*TT_RING+h] as i32)&1))==1){hasfab=1;}
                                }
                                h=h+1;
                            }
                            if(hasfab==0){w.*.genuine_flagged=1;}
                            h=0;
                            while(h<cnt){
                                let hm:i32=meta[slot*TT_RING+h] as i32;
                                let hsrc:i32=hm&7; let htier:i32=(hm>>3)&3;
                                let hkind:i32=(hm>>5)&1;
                                if(hkind==TT_KIND_CONTRA && (htier==TT_T2 || htier==TT_T3) &&
                                   tt_i32_get(ccl,(slot*TT_RING+h)*4)==gcl &&
                                   tt_counted(w,hsrc)==1){
                                    meta[slot*TT_RING+h]=(hm|(1<<6)) as u8;
                                }
                                h=h+1;
                            }
                            let idx:i32=0;
                            let b:i32=0;
                            while(b<TT_NSRC){
                                if(((mask>>b)&1)==1){
                                    tt_audit_ro(s,TT_OP_COLLUSION_SUSPECT,slot,
                                        1|(b<<8)|(idx<<16)|(nsrc<<24),m);
                                    idx=idx+1;
                                }
                                b=b+1;
                            }
                            tt_audit_ro(s,TT_OP_TRAINER_ESCALATE,slot,1,m);
                            if(fr[slot]==0){
                                fr[slot]=1;
                                tt_i32_set(fev,slot*4,tt_i32_get(fev,slot*4)+1);
                            }
                            fm[slot]=((fm[slot] as i32)|mask) as u8;
                            tt_i32_set(fl,slot*4,m+TT_L);
                            if((slot==w.*.target || slot==w.*.target2) && w.*.ttd_coll_ep<0 &&
                               w.*.first_fab_ep>=0){
                                w.*.ttd_coll_ep=m-w.*.first_fab_ep;
                            }
                            g=cnt;
                        }
                    }
                }
                g=g+1;
            }
        }
        slot=slot+1;
    }
}


// ---------- H1: suspensive contradiction hold (new §5.6, arm T only) ----------
// Trigger: during a kill/revision effort against a VERIFIED memory, when
// (i) the effort satisfies §5.1's required {T0,T1} leg with T1 citations
// alone (no T0 citation for the candidate value within W), and (ii) within
// W, T0 either (a) cites the currently-held value or (b) emits zero
// citations for this memory while the window is citation-active, and
// (iii) the memory is verified. Returns 1 and sets branch (0=a, 1=b).
fn tt_hold_trigger(w:*Tw,s:*StStore,slot:i32,m:i32,claim:i32,branch:*i32)i32 {
    let n:[]u8=w.*.cit_n; let meta:[]u8=w.*.cit_meta;
    let ccl:[]u8=w.*.cit_claimed;
    let cnt:i32=n[slot] as i32;
    let held:i32=tt_i32_get(s.*.value,slot*4);
    let has_t1:i32=0; let has_t0cand:i32=0;
    let t0_held:i32=0; let t0_any:i32=0; let any_cite:i32=0;
    let i:i32=0;
    while(i<cnt){
        let mm:i32=meta[slot*TT_RING+i] as i32;
        let src:i32=mm&7; let kind:i32=(mm>>5)&1; let taint:i32=(mm>>6)&1;
        let cl:i32=tt_i32_get(ccl,(slot*TT_RING+i)*4);
        if(taint==0){
            any_cite=1;
            if(src==0){
                t0_any=1;
                if(cl==held){t0_held=1;}
                if(kind==TT_KIND_CONTRA && cl==claim){has_t0cand=1;}
            }
            if(src==1 && kind==TT_KIND_CONTRA && cl==claim){has_t1=1;}
        }
        i=i+1;
    }
    // (i) T1-alone leg: T1 cites the candidate, T0 does not (within W).
    // No T1 citation at all -> existing rules (no trigger).
    if(has_t1==0 || has_t0cand==1){return 0;}
    if(tt_counted(w,1)==0){return 0;}
    // (ii) branch a: T0 actively cites the held value; branch b: T0 silent
    // while the window is citation-active.
    if(t0_held==1){branch.*=TT_HOLD_A; return 1;}
    if(t0_any==0 && any_cite==1){branch.*=TT_HOLD_B; return 1;}
    return 0;
}

// H1 resolution, checked per episode IN ORDER: Path 1 (T0 cites the staged
// candidate -> release, effort resumes), Path 2 (every counted leg source
// of the effort CHANNEL_DISTRUSTED -> broken, candidate discarded), Path 3
// (H=W=25 episodes, neither fired -> timeout escalate, memory frozen,
// trainer-origin-mark-only release). Absolute eps on all audits (A.5).
fn tt_hold_resolve(w:*Tw,s:*StStore,m:i32)void {
    let hs:[]u8=w.*.hold_state;
    let ek:[]u8=w.*.epkind; let ec:[]u8=w.*.epclaimed;
    let hep:[]u8=w.*.hold_ep; let hcl:[]u8=w.*.hold_claimed;
    let hrs:[]u8=w.*.hold_resolution; let hrep:[]u8=w.*.hold_resolve_ep;
    let n:[]u8=w.*.cit_n; let meta:[]u8=w.*.cit_meta;
    let ccl:[]u8=w.*.cit_claimed;
    let slot:i32=0;
    while(slot<32){
        if(hs[slot]==1){
            let cand:i32=tt_i32_get(hcl,slot*4);
            // Path 1: T0 cites the candidate value this episode.
            let p1:i32=0;
            if((ek[0*32+slot] as i32)!=255 &&
               tt_i32_get(ec,(0*32+slot)*4)==cand){p1=1;}
            if(p1==1){
                tt_audit_ro(s,TT_OP_HOLD_RELEASED_T0_CONFIRM,slot,1|(slot<<8),m);
                hs[slot]=0; hrs[slot]=TT_HRES_RELEASED as u8;
                tt_i32_set(hrep,slot*4,m);
            } else {
                // Path 2: every counted leg source of the effort distrusted.
                let cnt:i32=n[slot] as i32;
                let smask:i32=0;
                let i:i32=0;
                while(i<cnt){
                    let mm:i32=meta[slot*TT_RING+i] as i32;
                    let src:i32=mm&7; let kind:i32=(mm>>5)&1;
                    let taint:i32=(mm>>6)&1;
                    if(kind==TT_KIND_CONTRA && taint==0 &&
                       tt_i32_get(ccl,(slot*TT_RING+i)*4)==cand){
                        smask=smask|(1<<src);
                    }
                    i=i+1;
                }
                let nleg:i32=0; let alld:i32=1;
                let sx:i32=0;
                while(sx<TT_NSRC){
                    if(((smask>>sx)&1)==1){
                        nleg=nleg+1;
                        let stv:i32=w.*.src_state[sx] as i32;
                        if(stv!=TT_CH_DIST && stv!=TT_CH_PERMA){alld=0;}
                    }
                    sx=sx+1;
                }
                if(nleg>0 && alld==1){
                    tt_audit_ro(s,TT_OP_HOLD_BROKEN_BY_DISTRUST,slot,1|(slot<<8),m);
                    hs[slot]=0; hrs[slot]=TT_HRES_BROKEN as u8;
                    tt_i32_set(hrep,slot*4,m);
                } else if(m-tt_i32_get(hep,slot*4)>=TT_W){
                    // Path 3: one full window, fail closed. The timer is
                    // evidence for escalation, never for release.
                    tt_audit_ro(s,TT_OP_HOLD_TIMEOUT_ESCALATE,slot,1|(slot<<8),m);
                    tt_audit_ro(s,TT_OP_TRAINER_ESCALATE,slot,1,m);
                    hs[slot]=2; hrs[slot]=TT_HRES_TIMEOUT as u8;
                    tt_i32_set(hrep,slot*4,m);
                }
            }
        }
        slot=slot+1;
    }
}


// ---------- the §5.1 corroboration gate ----------
// Returns pass (1/0); out: distinct sources, distinct tiers, has01, nfab.
fn tt_gate(w:*Tw,slot:i32,m:i32,ons:*i32,ont:*i32,ohas:*i32,onfab:*i32)i32 {
    let n:[]u8=w.*.cit_n; let meta:[]u8=w.*.cit_meta;
    let ccl:[]u8=w.*.cit_claimed; let cfb:[]u8=w.*.cit_fab;
    let cnt:i32=n[slot] as i32;
    let smask:i32=0; let tmask:i32=0; let nsrc:i32=0; let ntier:i32=0;
    let has01:i32=0; let nfab:i32=0;
    let i:i32=0;
    while(i<cnt){
        let mm:i32=meta[slot*TT_RING+i] as i32;
        let src:i32=mm&7; let tier:i32=(mm>>3)&3; let kind:i32=(mm>>5)&1;
        let taint:i32=(mm>>6)&1;
        if(kind==TT_KIND_CONTRA && taint==0 && tt_counted(w,src)==1){
            if(((smask>>src)&1)==0){smask=smask|(1<<src); nsrc=nsrc+1;}
            if(((tmask>>tier)&1)==0){tmask=tmask|(1<<tier); ntier=ntier+1;}
            if(tier==TT_T0 || tier==TT_T1){has01=1;}
            if((((cfb[slot*TT_RING+i] as i32)&1))==1){nfab=nfab+1;}
        }
        i=i+1;
    }
    ons.*=nsrc; ont.*=ntier; ohas.*=has01; onfab.*=nfab;
    if(nsrc>=2 && ntier>=2 && has01==1){return 1;}
    return 0;
}

// latest counted contradiction claim in the window (emission order).
fn tt_latest_claim(w:*Tw,slot:i32)i32 {
    let n:[]u8=w.*.cit_n; let meta:[]u8=w.*.cit_meta;
    let ccl:[]u8=w.*.cit_claimed;
    let cnt:i32=n[slot] as i32;
    let cl:i32=0;
    let i:i32=0;
    while(i<cnt){
        let mm:i32=meta[slot*TT_RING+i] as i32;
        let src:i32=mm&7; let kind:i32=(mm>>5)&1; let taint:i32=(mm>>6)&1;
        if(kind==TT_KIND_CONTRA && taint==0 && tt_counted(w,src)==1){
            cl=tt_i32_get(ccl,(slot*TT_RING+i)*4);
        }
        i=i+1;
    }
    return cl;
}

// ---------- revision path (arms T / T-NC): gate-filtered, effort, justify ----------
fn tt_gate_sweep(w:*Tw,s:*StStore,m:i32)void {
    let nx:[]u8=w.*.newx; let fr:[]u8=w.*.frozen;
    let tv:[]u8=w.*.truev; let rx:[]u8=w.*.refusedx;
    let hs:[]u8=w.*.hold_state;
    let slot:i32=0;
    while(slot<32){
        if(tt_verified(w,slot,m)==1 && nx[slot]==1){
            // H1: gate operations on a held memory return GATE_HELD while
            // the hold persists (active hold or timeout-frozen).
            if(w.*.arm==TT_ARM_T && (hs[slot]==1 || hs[slot]==2)){
                tt_audit_ro(s,TT_OP_GATE_HELD,slot,slot,m);
                slot=slot+1;
                continue;
            }
            let nsrc:i32=0; let ntier:i32=0; let has01:i32=0; let nfab:i32=0;
            let pass:i32=tt_gate(w,slot,m,&nsrc,&ntier,&has01,&nfab);
            let claim:i32=tt_latest_claim(w,slot);
            if(pass==1){
                if(w.*.arm==TT_ARM_T && fr[slot]==1){
                    let genuine:i32=0;
                    if(claim==tt_i32_get(tv,slot*4)){genuine=1;}
                    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
                    st_snap(s,slot,&b1,&b2,&b3,&b4,&b5);
                    st_audit_append(s,TT_OP_REFUSED_COLLUSION_FREEZE,slot,
                        TT_REFUSED_COLLUSION_FREEZE,b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,genuine,m);
                    if(genuine==1){w.*.denial=w.*.denial+1;}
                } else {
                    // H1 trigger (§5.6): the candidate is staged in the
                    // per-slot hold slot — ledger-recorded, NOT applied,
                    // NOT deleted. The memory is frozen (GATE_HELD above).
                    // Arm T only: T-NC is the gate-only ablation (§3); its
                    // A5 0/36 is the expected ablation signal (§7).
                    let br:i32=0;
                    if(w.*.arm==TT_ARM_T &&
                       tt_hold_trigger(w,s,slot,m,claim,&br)==1){
                        let hep:[]u8=w.*.hold_ep; let hcl:[]u8=w.*.hold_claimed;
                        let hbr:[]u8=w.*.hold_branch;
                        hs[slot]=1; hbr[slot]=br as u8;
                        tt_i32_set(hep,slot*4,m);
                        tt_i32_set(hcl,slot*4,claim);
                        tt_audit_ro(s,TT_OP_T0_T1_HOLD,slot,1|(slot<<8)|(br<<16),m);
                        // COLLUSION_SUSPECT severity HIGH naming the T0/T1
                        // split (keeps the §8 preceding-audit taxonomy loud).
                        tt_audit_ro(s,TT_OP_COLLUSION_SUSPECT,slot,
                            1|(0<<8)|(0<<16)|(2<<24),m);
                        tt_audit_ro(s,TT_OP_COLLUSION_SUSPECT,slot,
                            1|(1<<8)|(1<<16)|(2<<24),m);
                    } else {
                    // effort: n(s) distinct cited episodes + justify, then overwrite
                    let str:i32=s.*.st_str[slot] as i32;
                    let need:i32=(str+24)/25;
                    let n:[]u8=w.*.cit_n; let meta:[]u8=w.*.cit_meta;
                    let cep:[]u8=w.*.cit_ep;
                    let cnt:i32=n[slot] as i32;
                    let eps:[]u8=nio_alloc(32);
                    let ne:i32=0;
                    let i:i32=0;
                    while(i<cnt){
                        let mm:i32=meta[slot*TT_RING+i] as i32;
                        let src:i32=mm&7; let kind:i32=(mm>>5)&1; let taint:i32=(mm>>6)&1;
                        if(kind==TT_KIND_CONTRA && taint==0 && tt_counted(w,src)==1){
                            let e:i32=tt_i32_get(cep,(slot*TT_RING+i)*4);
                            let dup:i32=0; let k:i32=0;
                            while(k<ne){if(tt_i32_get(eps,k*4)==e){dup=1;} k=k+1;}
                            if(dup==0 && ne<8){tt_i32_set(eps,ne*4,e); ne=ne+1;}
                        }
                        i=i+1;
                    }
                    i=0;
                    while(i<ne){ st_evidence(s,slot,ST_J_CONTRADICTED,tt_i32_get(eps,i*4)); i=i+1; }
                    nio_free(eps);
                    if(s.*.justified[slot]==0){ st_justify(s,slot,ST_J_CONTRADICTED); }
                    let rc:i32=st_overwrite(s,slot,claim,str,ST_ARM_A);
                    if(rc==ST_OK){
                        // A.5: revision event with absolute ep for the
                        // checker's loud-vs-silent ordering.
                        _zag_print("ST_REV,"); tt_pnum(slot as i64); _zag_print(",");
                        tt_pnum(m as i64); _zag_print(","); tt_pnum(claim as i64);
                        _zag_println("");
                        if(slot==w.*.target){
                            w.*.rev_ep=m;
                            if(claim!=tt_i32_get(tv,slot*4)){w.*.revised_false=1;}
                        }
                        if(slot==w.*.target2){
                            w.*.rev_ep2=m;
                            if(claim!=tt_i32_get(tv,slot*4)){w.*.revised_false2=1;}
                        }
                        if(claim==tt_i32_get(tv,slot*4) && w.*.rev_latency<0 &&
                           (w.*.camp==TT_CAMP_A4 || w.*.camp==TT_CAMP_N0 ||
                            w.*.camp==TT_CAMP_M1) && w.*.shift_ep>=0 &&
                           (slot==w.*.target)){
                            w.*.rev_latency=m-w.*.shift_ep;
                        }
                        if(w.*.camp==TT_CAMP_A3 && slot==w.*.target &&
                           claim==tt_i32_get(tv,slot*4) && w.*.recovery_ep<0 &&
                           w.*.attack_end>=0){
                            w.*.recovery_ep=m-w.*.attack_end;
                        }
                    }
                    } // closes the H1-trigger else: effort proceeds unheld
                }
            } else {
                tt_audit_ro(s,TT_OP_GATE_REFUSED,slot,nsrc|(ntier<<8)|(has01<<16),m);
                w.*.gate_refused=w.*.gate_refused+1;
                tt_i32_set(rx,slot*4,tt_i32_get(rx,slot*4)+1);
            }
        }
        slot=slot+1;
    }
}

// ---------- strengthen sweep (arms T / T-NC): tier-gated judgment ----------
// Corroboration counts toward strengthening iff within W: >=2 distinct
// sources, >=2 distinct tiers, including >=1 of {T0,T1}. T3-only
// corroboration never strengthens (A6 armor defense).
fn tt_strengthen(w:*Tw,s:*StStore,m:i32)void {
    let nc:[]u8=w.*.newc;
    let n:[]u8=w.*.cit_n; let meta:[]u8=w.*.cit_meta;
    let ccl:[]u8=w.*.cit_claimed; let cfb:[]u8=w.*.cit_fab;
    let lse:[]u8=w.*.last_str_ep;
    let st_:[]u8=w.*.src_tier;
    let slot:i32=0;
    while(slot<32){
        if(tt_verified(w,slot,m)==1 && nc[slot]==1){
            let held:i32=tt_i32_get(s.*.value,slot*4);
            let cnt:i32=n[slot] as i32;
            let smask:i32=0; let tmask:i32=0; let nsrc:i32=0; let ntier:i32=0;
            let has01:i32=0; let nfab:i32=0; let ncand:i32=0;
            let i:i32=0;
            while(i<cnt){
                let mm:i32=meta[slot*TT_RING+i] as i32;
                let src:i32=mm&7; let tier:i32=(mm>>3)&3; let kind:i32=(mm>>5)&1;
                let taint:i32=(mm>>6)&1;
                if(kind==TT_KIND_CORROB && taint==0 && tt_counted(w,src)==1 &&
                   tt_i32_get(ccl,(slot*TT_RING+i)*4)==held){
                    ncand=ncand+1;
                    if(((smask>>src)&1)==0){smask=smask|(1<<src); nsrc=nsrc+1;}
                    if(((tmask>>tier)&1)==0){tmask=tmask|(1<<tier); ntier=ntier+1;}
                    if(tier==TT_T0 || tier==TT_T1){has01=1;}
                    if((((cfb[slot*TT_RING+i] as i32)&1))==1){nfab=nfab+1;}
                }
                i=i+1;
            }
            if(nsrc>=2 && ntier>=2 && has01==1){
                // tier graduation: a T3 claim corroborated per the gate -> T2
                i=0;
                while(i<cnt){
                    let mm:i32=meta[slot*TT_RING+i] as i32;
                    let src:i32=mm&7; let kind:i32=(mm>>5)&1; let taint:i32=(mm>>6)&1;
                    if(kind==TT_KIND_CORROB && taint==0 && tt_counted(w,src)==1 &&
                       tt_i32_get(ccl,(slot*TT_RING+i)*4)==held &&
                       (st_[src] as i32)==TT_T3){
                        let old:i32=st_[src] as i32;
                        st_[src]=TT_T2 as u8;
                        tt_audit_ro(s,TT_OP_TIER_GRADUATED,slot,src|(old<<8),m);
                    }
                    i=i+1;
                }
                w.*.fcr_counted=w.*.fcr_counted+nfab;
                if(nfab>0 && w.*.camp==TT_CAMP_A6 && slot==w.*.target){
                    // fabricated corroborations counted toward strengthen: A6 bar input
                }
                if(m-tt_i32_get(lse,slot*4)>=10){
                    let str:i32=s.*.st_str[slot] as i32;
                    let ns:i32=str+10; if(ns>100){ns=100;}
                    st_strengthen(s,slot,ns,ST_J_CORROBORATED);
                    tt_i32_set(lse,slot*4,m);
                }
            } else if(ncand>0){
                tt_audit_ro(s,TT_OP_STRENGTHEN_REFUSED,slot,nsrc|(ntier<<8)|(has01<<16),m);
                w.*.str_refused=w.*.str_refused+1;
            }
            if(w.*.camp==TT_CAMP_A6 && slot==w.*.target){
                let ms:i32=s.*.st_str[slot] as i32;
                if(ms>w.*.a6_maxstr){w.*.a6_maxstr=ms;}
            }
        }
        slot=slot+1;
    }
}

// TT-B-GATE-BEGIN
// Arm B control: corroborated elimination (RT-2 rule), evaluated on the
// emitted citation stream in source order. A first contradiction of the
// held value audits SUSPECT and holds; a second consecutive contradiction
// (no corroboration between) fires the gate. The gate then pays the same
// effort as the tiered arms (distinct cited episodes + justification) and
// revises once per slot (one-shot latch: elimination is terminal for the
// committed hypothesis). This region implements the whole B decision path
// and must stay free of per-source rank reads: the checker verifies it
// textually.
// Per-citation update: classify against the CURRENT held value, track the
// RT-2 streak, set the fire flag on the second consecutive contradiction.
// Per-slot, per-episode: does the emitted citation stream contain a
// contradiction of the held value? A first such episode audits SUSPECT;
// a second consecutive such episode fires the gate. An episode with no
// contradiction resets the streak.
fn tt_b_episode(w:*Tw,s:*StStore,slot:i32,m:i32)void {
    if(tt_verified(w,slot,m)==0){return;}
    let lat:[]u8=w.*.b_latched;
    if(lat[slot]==1){return;}
    let ek:[]u8=w.*.epkind; let ec:[]u8=w.*.epclaimed;
    let held:i32=tt_i32_get(s.*.value,slot*4);
    let has_contra:i32=0;
    let contra_claim:i32=0;
    let src:i32=0;
    while(src<TT_NSRC){
        if((ek[src*32+slot] as i32)!=255){
            let claimed:i32=tt_i32_get(ec,(src*32+slot)*4);
            if(claimed!=held){ has_contra=1; contra_claim=claimed; }
        }
        src=src+1;
    }
    let lk:[]u8=w.*.b_lastkind;
    let bf:[]u8=w.*.b_fire;
    if(has_contra==1){
        let c:i32=lk[slot] as i32;
        if(c==0){
            tt_audit_ro(s,TT_OP_B_SUSPECT,slot,0,m);
            w.*.b_suspect=w.*.b_suspect+1;
        }
        lk[slot]=(c+1) as u8;
        if(c+1>=2){
            bf[slot]=1;
            tt_i32_set(w.*.b_claimed,slot*4,contra_claim);
        }
    } else {
        lk[slot]=0;
        bf[slot]=0;
    }
}
// Episode-end: pay effort and revise once per fired slot.
fn tt_b_revise(w:*Tw,s:*StStore,m:i32)void {
    let bf:[]u8=w.*.b_fire; let lat:[]u8=w.*.b_latched;
    let bc:[]u8=w.*.b_claimed;
    let n:[]u8=w.*.cit_n; let meta:[]u8=w.*.cit_meta;
    let cep:[]u8=w.*.cit_ep;
    let tv:[]u8=w.*.truev;
    let slot:i32=0;
    while(slot<32){
        if(tt_verified(w,slot,m)==1 && bf[slot]==1 && lat[slot]==0){
            bf[slot]=0;
            let claim:i32=tt_i32_get(bc,slot*4);
            let held:i32=tt_i32_get(s.*.value,slot*4);
            if(claim!=held){
                // effort: distinct cited contradiction episodes + justify
                let str:i32=s.*.st_str[slot] as i32;
                let cnt:i32=n[slot] as i32;
                let eps:[]u8=nio_alloc(32);
                let ne:i32=0;
                let i:i32=0;
                while(i<cnt){
                    let mm:i32=meta[slot*TT_RING+i] as i32;
                    let kind:i32=(mm>>5)&1; let taint:i32=(mm>>6)&1;
                    if(kind==TT_KIND_CONTRA && taint==0){
                        let e:i32=tt_i32_get(cep,(slot*TT_RING+i)*4);
                        let dup:i32=0; let k:i32=0;
                        while(k<ne){if(tt_i32_get(eps,k*4)==e){dup=1;} k=k+1;}
                        if(dup==0 && ne<8){tt_i32_set(eps,ne*4,e); ne=ne+1;}
                    }
                    i=i+1;
                }
                i=0;
                while(i<ne){ st_evidence(s,slot,ST_J_CONTRADICTED,tt_i32_get(eps,i*4)); i=i+1; }
                nio_free(eps);
                if(s.*.justified[slot]==0){ st_justify(s,slot,ST_J_CONTRADICTED); }
                let rc:i32=st_overwrite(s,slot,claim,str,ST_ARM_A);
                if(rc==ST_OK){
                    _zag_print("ST_REV,"); tt_pnum(slot as i64); _zag_print(",");
                    tt_pnum(m as i64); _zag_print(","); tt_pnum(claim as i64);
                    _zag_println("");
                    lat[slot]=1;
                    if(slot==w.*.target){
                        w.*.rev_ep=m;
                        if(claim!=tt_i32_get(tv,slot*4)){w.*.revised_false=1;}
                    }
                    if(slot==w.*.target2){
                        w.*.rev_ep2=m;
                        if(claim!=tt_i32_get(tv,slot*4)){w.*.revised_false2=1;}
                    }
                    if(claim==tt_i32_get(tv,slot*4) && w.*.rev_latency<0 &&
                       (w.*.camp==TT_CAMP_A4 || w.*.camp==TT_CAMP_N0 ||
                        w.*.camp==TT_CAMP_M1) &&
                       w.*.shift_ep>=0 && slot==w.*.target){
                        w.*.rev_latency=m-w.*.shift_ep;
                    }
                    if(w.*.camp==TT_CAMP_A3 && slot==w.*.target &&
                       claim==tt_i32_get(tv,slot*4) && w.*.recovery_ep<0 &&
                       w.*.attack_end>=0){
                        w.*.recovery_ep=m-w.*.attack_end;
                    }
                }
            }
        }
        slot=slot+1;
    }
}
// TT-B-GATE-END

// TT-B-STR-BEGIN
// Arm B strengthen: corroboration from >=2 distinct sources within W
// strengthens. No per-source weighting of any kind is applied here.
fn tt_b_strengthen(w:*Tw,s:*StStore,m:i32)void {
    let nc:[]u8=w.*.newc;
    let n:[]u8=w.*.cit_n; let meta:[]u8=w.*.cit_meta;
    let ccl:[]u8=w.*.cit_claimed; let cfb:[]u8=w.*.cit_fab;
    let lse:[]u8=w.*.last_str_ep;
    let slot:i32=0;
    while(slot<32){
        if(tt_verified(w,slot,m)==1 && nc[slot]==1){
            let held:i32=tt_i32_get(s.*.value,slot*4);
            let cnt:i32=n[slot] as i32;
            let smask:i32=0; let nsrc:i32=0; let nfab:i32=0;
            let i:i32=0;
            while(i<cnt){
                let mm:i32=meta[slot*TT_RING+i] as i32;
                let src:i32=mm&7; let kind:i32=(mm>>5)&1;
                if(kind==TT_KIND_CORROB &&
                   tt_i32_get(ccl,(slot*TT_RING+i)*4)==held){
                    if(((smask>>src)&1)==0){smask=smask|(1<<src); nsrc=nsrc+1;}
                    if((((cfb[slot*TT_RING+i] as i32)&1))==1){nfab=nfab+1;}
                }
                i=i+1;
            }
            if(nsrc>=2){
                w.*.fcr_counted=w.*.fcr_counted+nfab;
                if(m-tt_i32_get(lse,slot*4)>=10){
                    let str:i32=s.*.st_str[slot] as i32;
                    let ns:i32=str+10; if(ns>100){ns=100;}
                    st_strengthen(s,slot,ns,ST_J_CORROBORATED);
                    tt_i32_set(lse,slot*4,m);
                }
            }
            if(w.*.camp==TT_CAMP_A6 && slot==w.*.target){
                let ms:i32=s.*.st_str[slot] as i32;
                if(ms>w.*.a6_maxstr){w.*.a6_maxstr=ms;}
            }
        }
        slot=slot+1;
    }
}
// TT-B-STR-END

// ---------- metrics ----------
fn tt_tax_for(w:*Tw,slot:i32)[]u8 {
    let rf:i32=0; let rev:i32=-1;
    if(slot==w.*.target){rf=w.*.revised_false; rev=w.*.rev_ep;}
    else {rf=w.*.revised_false2; rev=w.*.rev_ep2;}
    let fev:[]u8=w.*.freeze_events;
    let fe:i32=tt_i32_get(fev,slot*4);
    let rx:[]u8=w.*.refusedx;
    let camp:i32=w.*.camp;
    if(w.*.killed==1 || rf==1){return "CORRUPTED";}
    if(camp==TT_CAMP_A6 && w.*.a6_maxstr>=80){return "CORRUPTED";}
    // H1 Path 3: frozen + escalated, no corruption.
    if(w.*.hold_resolution[slot]==TT_HRES_TIMEOUT as u8){return "DEGRADED_GRACEFUL";}
    if((camp==TT_CAMP_A4 || camp==TT_CAMP_M1) && slot==w.*.target){
        if(rev>=0){return "GENUINE_REVISED";}
        return "BLIND";
    }
    if(camp==TT_CAMP_N0){
        if(rev>=0){return "GENUINE_REVISED";}
        return "BLIND";
    }
    if(fe>0){return "DEGRADED_GRACEFUL";}
    if(tt_i32_get(rx,slot*4)>0){return "CONTAINED";}
    return "HOLD";
}

fn tt_emit_metrics(w:*Tw,s:*StStore,ep:i32,rc_rep:i32)void {
    let t:i32=w.*.target; let t2:i32=w.*.target2;
    // SRR components per target
    _zag_print("ST_SRR,"); tt_pnum(t as i64); _zag_print(",");
    tt_pnum(w.*.killed as i64); _zag_print(","); tt_pnum(w.*.revised_false as i64);
    _zag_println("");
    if(t2>=0){
        _zag_print("ST_SRR,"); tt_pnum(t2 as i64); _zag_print(",");
        tt_pnum(0 as i64); _zag_print(","); tt_pnum(w.*.revised_false2 as i64);
        _zag_println("");
    }
    _zag_print("ST_FCR,"); tt_pnum(w.*.fcr_counted as i64); _zag_print(",");
    tt_pnum(w.*.fcr_total as i64); _zag_println("");
    _zag_print("ST_TAXONOMY,"); tt_pnum(t as i64); _zag_print(",");
    _zag_print(tt_tax_for(w,t)); _zag_println("");
    if(t2>=0){
        _zag_print("ST_TAXONOMY,"); tt_pnum(t2 as i64); _zag_print(",");
        _zag_print(tt_tax_for(w,t2)); _zag_println("");
    }
    _zag_print("ST_TTD_COLLUSION,"); tt_pnum(w.*.ttd_coll_ep as i64); _zag_println("");
    let dte:[]u8=w.*.distrust_ep; let fde:[]u8=w.*.first_dis_ep;
    let src:i32=1;
    while(src<TT_NSRC){
        let de:i32=tt_i32_get(dte,src*4);
        if(de>=0){
            _zag_print("ST_DISTTRUST,"); tt_pnum(src as i64); _zag_print(",");
            tt_pnum((de-tt_i32_get(fde,src*4)) as i64); _zag_println("");
        }
        src=src+1;
    }
    let fe:[]u8=w.*.frozen_eps; let fev:[]u8=w.*.freeze_events;
    _zag_print("ST_FREEZE,"); tt_pnum(t as i64); _zag_print(",");
    tt_pnum(tt_i32_get(fe,t*4) as i64); _zag_print(",");
    tt_pnum(tt_i32_get(fev,t*4) as i64); _zag_println("");
    _zag_print("ST_RECOVERY,"); tt_pnum(w.*.recovery_ep as i64); _zag_println("");
    _zag_print("ST_REV_LATENCY,"); tt_pnum(w.*.rev_latency as i64); _zag_println("");
    _zag_print("ST_DENIAL,"); tt_pnum(w.*.denial as i64); _zag_println("");
    _zag_print("ST_GENUINE_FLAGGED,"); tt_pnum(w.*.genuine_flagged as i64); _zag_println("");
    _zag_print("ST_A6_MAXSTR,"); tt_pnum(w.*.a6_maxstr as i64); _zag_println("");
    _zag_print("ST_GATE_REFUSED,"); tt_pnum(w.*.gate_refused as i64); _zag_println("");
    _zag_print("ST_B_SUSPECT,"); tt_pnum(w.*.b_suspect as i64); _zag_println("");
    _zag_print("ST_STR_REFUSED,"); tt_pnum(w.*.str_refused as i64); _zag_println("");
    // H1 hold ledger per slot (absolute eps, A.5):
    // ST_HOLD,slot,branch,hold_ep,resolution,resolve_ep
    // resolution: 0 none, 1 released-T0-confirm, 2 broken-by-distrust,
    //             3 timeout-escalated; resolve_ep=-1 while still active.
    let hst:[]u8=w.*.hold_state; let hbr:[]u8=w.*.hold_branch;
    let hepm:[]u8=w.*.hold_ep; let hrsm:[]u8=w.*.hold_resolution;
    let hrepm:[]u8=w.*.hold_resolve_ep;
    let hslot:i32=0;
    while(hslot<32){
        if(hst[hslot]!=0 || hrsm[hslot]!=0){
            _zag_print("ST_HOLD,"); tt_pnum(hslot as i64); _zag_print(",");
            tt_pnum(hbr[hslot] as i64); _zag_print(",");
            tt_pnum(tt_i32_get(hepm,hslot*4) as i64); _zag_print(",");
            tt_pnum(hrsm[hslot] as i64); _zag_print(",");
            tt_pnum(tt_i32_get(hrepm,hslot*4) as i64); _zag_println("");
        }
        hslot=hslot+1;
    }
    // A.2 BLIND scoping input: {T0,T1} citations per target in window.
    _zag_print("ST_T01_WINDOW,"); tt_pnum(t as i64); _zag_print(",");
    tt_pnum(w.*.t01w as i64); _zag_println("");
    if(t2>=0){
        _zag_print("ST_T01_WINDOW,"); tt_pnum(t2 as i64); _zag_print(",");
        tt_pnum(w.*.t01w2 as i64); _zag_println("");
    }
    // determinism fingerprints
    let nbytes:i32=s.*.audit_n*64;
    let ab:[]u8=s.*.audit;
    let sl:[]u8=ab[0..nbytes];
    let out:[]u8=nio_alloc(32);
    let hrc:i32=ns_sha256(sl,out);
    _zag_print("ST_FP,"); tt_pnum(rc_rep as i64); _zag_print(",");
    if(hrc==0){tt_phex(out,32);}else{_zag_print("HASHFAIL");}
    _zag_print(",");
    tt_pnum(st_fingerprint(s,w.*.arm*1000+w.*.camp) as i64);
    _zag_println("");
    nio_free(out);
}

// ---------- arg parsing (no atoi: closed strcmp chains) ----------
fn tt_parse_arm(a:[]u8)i32 {
    if(_zag_strcmp(a,"T")==1){return TT_ARM_T;}
    if(_zag_strcmp(a,"TNC")==1){return TT_ARM_TNC;}
    if(_zag_strcmp(a,"B")==1){return TT_ARM_B;}
    return -1;
}
fn tt_parse_camp(a:[]u8)i32 {
    if(_zag_strcmp(a,"A0")==1){return TT_CAMP_A0;}
    if(_zag_strcmp(a,"A1")==1){return TT_CAMP_A1;}
    if(_zag_strcmp(a,"A2")==1){return TT_CAMP_A2;}
    if(_zag_strcmp(a,"A3")==1){return TT_CAMP_A3;}
    if(_zag_strcmp(a,"A4")==1){return TT_CAMP_A4;}
    if(_zag_strcmp(a,"A5")==1){return TT_CAMP_A5;}
    if(_zag_strcmp(a,"A6")==1){return TT_CAMP_A6;}
    if(_zag_strcmp(a,"N0")==1){return TT_CAMP_N0;}
    return -1;
}
fn tt_parse_var(a:[]u8)i32 {
    if(_zag_strcmp(a,"0")==1){return 0;}
    if(_zag_strcmp(a,"1")==1){return 1;}
    if(_zag_strcmp(a,"2")==1){return 2;}
    return -1;
}
fn tt_parse_inst(a:[]u8)i32 {
    if(_zag_strcmp(a,"0")==1){return 0;}
    if(_zag_strcmp(a,"1")==1){return 1;}
    if(_zag_strcmp(a,"2")==1){return 2;}
    if(_zag_strcmp(a,"3")==1){return 3;}
    if(_zag_strcmp(a,"4")==1){return 4;}
    if(_zag_strcmp(a,"5")==1){return 5;}
    if(_zag_strcmp(a,"6")==1){return 6;}
    if(_zag_strcmp(a,"7")==1){return 7;}
    if(_zag_strcmp(a,"8")==1){return 8;}
    if(_zag_strcmp(a,"9")==1){return 9;}
    if(_zag_strcmp(a,"10")==1){return 10;}
    if(_zag_strcmp(a,"11")==1){return 11;}
    return -1;
}
fn tt_arm_name(a:i32)[]u8 {
    if(a==TT_ARM_T){return "T";}
    if(a==TT_ARM_TNC){return "TNC";}
    return "B";
}
fn tt_camp_name(c:i32)[]u8 {
    if(c==TT_CAMP_A0){return "A0";}
    if(c==TT_CAMP_A1){return "A1";}
    if(c==TT_CAMP_A2){return "A2";}
    if(c==TT_CAMP_A3){return "A3";}
    if(c==TT_CAMP_A4){return "A4";}
    if(c==TT_CAMP_A5){return "A5";}
    if(c==TT_CAMP_A6){return "A6";}
    if(c==TT_CAMP_M1){return "M1";}
    if(c==TT_CAMP_M2){return "M2";}
    return "N0";
}

// ---------- main: argv[1]-only selector ----------
// Format: {ARM}_{CAMP}_{VARIANT}_{INSTANCE}_{RUN}_{SCALE}
//   ARM: T (tiered), N (T-NC, no-collusion), B (baseline control)
//   CAMP: A0 A1 A2 A3 A4 A5 A6 N0 M1 M2
//   VARIANT: 0 | 1 | 2        INSTANCE: 00..11 (two digits)
//   RUN: 0 | 1            SCALE: 1 (S1, 500 ep) | 10 (S10, 5000 ep)
// Example: T_A1_0_00_0_1
// The selector is validated character-by-character; no atoi, no partial
// matches. Any deviation returns 65.
fn main()i32 {
    if(_zag_argc()<2){return 64;}
    let sel:[]u8=_zag_arg(1);
    // Enumerated validation: the matrix is small enough to validate
    // structurally. We parse positionally.
    // Get length from the slice header (argv strings are exact-length).
    let slen:i32=sel.len as i32;
    if(slen!=13 && slen!=14){return 65;}
    // positional underscores
    if(sel[1]!=95 || sel[4]!=95 || sel[6]!=95 || sel[9]!=95 || sel[11]!=95){return 65;}
    // ARM at 0
    let arm:i32=-1;
    if(sel[0]==84){arm=TT_ARM_T;}        // 'T'
    else if(sel[0]==78){arm=TT_ARM_TNC;} // 'N'
    else if(sel[0]==66){arm=TT_ARM_B;}   // 'B'
    else {return 65;}
    // CAMP at 2-3
    let camp:i32=-1;
    if(sel[2]==65){ // 'A'
        if(sel[3]>=48 && sel[3]<=54){camp=(sel[3]-48) as i32;} // A0..A6
        else {return 65;}
    } else if(sel[2]==78 && sel[3]==48){camp=TT_CAMP_N0;} // 'N','0'
    else if(sel[2]==77){ // 'M': measurement campaigns M1/M2
        if(sel[3]==49){camp=TT_CAMP_M1;} // '1'
        else if(sel[3]==50){camp=TT_CAMP_M2;} // '2'
        else {return 65;}
    }
    else {return 65;}
    // VARIANT at 5: '0' | '1' | '2'
    let variant:i32=-1;
    if(sel[5]==48){variant=0;} else if(sel[5]==49){variant=1;} else if(sel[5]==50){variant=2;} else {return 65;}
    // INSTANCE at 7-8: '00'..'11'
    let inst:i32=-1;
    if(sel[7]>=48 && sel[7]<=57 && sel[8]>=48 && sel[8]<=57){
        inst=(sel[7]-48)*10+(sel[8]-48);
        if(inst<0 || inst>11){return 65;}
    } else {return 65;}
    // RUN at 10: '0' | '1'
    let runno:i32=0;
    if(sel[10]==48){runno=0;} else if(sel[10]==49){runno=1;} else {return 65;}
    // SCALE at 12+: "1" (len 13) or "10" (len 14)
    let scale:i32=0;
    if(slen==13){
        if(sel[12]!=49){return 65;} // '1'
        scale=0;
    } else {
        if(sel[12]!=49 || sel[13]!=48){return 65;} // '1','0'
        scale=1;
    }
    if(camp==TT_CAMP_A0 && arm!=TT_ARM_T){return 66;}
    let EP:i32=500;
    if(scale==1){EP=5000;}

    _zag_print("ST_CELL,");
    _zag_print(tt_arm_name(arm)); _zag_print(",");
    _zag_print(tt_camp_name(camp)); _zag_print(",");
    tt_pnum(variant as i64); _zag_print(",");
    tt_pnum(inst as i64); _zag_print(",");
    if(scale==1){_zag_print("S10,");}else{_zag_print("S1,");}
    tt_pnum(EP as i64); _zag_println("");

    let st:StStore=st_init(32,262144);
    st_set_stage(&st,ST_STAGE_FULL);
    let w:Tw=tt_alloc_tw();
    w.arm=arm; w.camp=camp; w.variant=variant; w.instance=inst; w.runno=runno;
    w.ep=EP; w.astart=40+7*variant; w.aend=40+7*variant+29;
    w.target=inst;
    if(camp==TT_CAMP_N0){w.target2=(inst+6)%12;}
    _zag_print("ST_TARGET,"); tt_pnum(w.target as i64); _zag_print(",");
    tt_pnum(w.target as i64); _zag_println("");

    let bl:[]u8=w.blind;
    let m:i32=0;
    while(m<EP){
        // 1. compact rings
        let sl2:i32=0;
        while(sl2<32){ tt_compact(&w,sl2,m); sl2=sl2+1; }
        // 2. admissions: valuables 0..11 at ep 0..11, fillers 12..23
        if(m<24){
            let slot:i32=m;
            if(slot<12){
                let v:i32=1000+slot;
                let r:i32=(slot*3+variant*5)%3;
                let os:i32=0; let ot:i32=TT_T0;
                if(r==1){os=1; ot=TT_T1;}
                if(r==2){os=2+(slot%5); ot=TT_T3;}
                if(camp==TT_CAMP_A6 && slot==w.target){
                    tt_admit(&w,&st,slot,v+500,v,1,TT_T1,50,m);
                    bl[slot]=1;
                } else {
                    tt_admit(&w,&st,slot,v,v,os,ot,50,m);
                }
            } else {
                tt_admit(&w,&st,slot,slot,slot,2+(slot%5),TT_T3,30,m);
            }
            if(camp==TT_CAMP_N0 && slot==w.target2){bl[slot]=1;}
        }
        // 3. clear per-episode scratch
        let ek:[]u8=w.epkind; let ec:[]u8=w.epclaimed;
        let nx:[]u8=w.newx; let nc:[]u8=w.newc;
        let k:i32=0;
        while(k<7*32){ek[k]=255; k=k+1;}
        k=0; while(k<32){nx[k]=0; nc[k]=0; k=k+1;}
        // 4-5. world emissions
        tt_honest(&w,&st,m);
        tt_campaign(&w,&st,m);
        // 6-7. learner: channel health, collusion, H1 hold resolution (arm T)
        if(arm==TT_ARM_T){
            tt_channel(&w,&st,m);
            tt_collusion(&w,&st,m);
            tt_hold_resolve(&w,&st,m);
        }
        // 8. revision path
        if(arm==TT_ARM_B){
            // RT-2: per-slot streak of contradiction episodes
            let bslot:i32=0;
            while(bslot<32){
                tt_b_episode(&w,&st,bslot,m);
                bslot=bslot+1;
            }
            tt_b_revise(&w,&st,m);
        }
        else {tt_gate_sweep(&w,&st,m);}
        // 9. strengthen
        if(arm==TT_ARM_B){tt_b_strengthen(&w,&st,m);}
        else {tt_strengthen(&w,&st,m);}
        // 10. quorum sampling
        if(m%50==0 || m==EP-1){
            let nsrc:i32=0; let ntier:i32=0; let has01:i32=0; let nfab:i32=0;
            tt_gate(&w,w.target,m,&nsrc,&ntier,&has01,&nfab);
            _zag_print("ST_QUORUM,"); tt_pnum(m as i64); _zag_print(",");
            tt_pnum(nsrc as i64); _zag_print(",");
            tt_pnum(ntier as i64); _zag_print(",");
            tt_pnum(has01 as i64); _zag_println("");
        }
        m=m+1;
    }

    // self-checks
    let rc_ref:i32=st_audit_clean_refusals(&st);
    let rc_rep:i32=st_replay_check(&st);
    _zag_print("ST_CHECK,refusals,"); tt_pnum(rc_ref as i64); _zag_println("");
    _zag_print("ST_CHECK,replay,"); tt_pnum(rc_rep as i64); _zag_println("");
    // provenance scan: every CITE commits (source_id, tier, cited_ep)
    let bad:i32=0; let t0fab:i32=0;
    let ab:[]u8=st.audit;
    let i:i32=0;
    while(i<st.audit_n){
        let e:i32=i*64;
        if(tt_i32_get(ab,e+0)==TT_OP_CITE){
            let d1:i32=tt_i32_get(ab,e+56); let d2:i32=tt_i32_get(ab,e+60);
            let src:i32=d1&255; let tier:i32=(d1>>8)&255;
            if(src>6 || tier>3){bad=bad+1;}
            if(src==0 && ((d1>>18)&1)==1 && camp!=TT_CAMP_A0){t0fab=1;}
        }
        i=i+1;
    }
    _zag_print("ST_CHECK,provenance,"); tt_pnum(bad as i64); _zag_println("");
    tt_emit_metrics(&w,&st,EP,rc_rep);
    let invalid:i32=w.invalid;
    if(bad>0){invalid=31;}
    if(t0fab==1){invalid=32;}
    if(rc_rep!=0){invalid=33;}
    if(invalid!=0){
        _zag_print("ST_INVALID,"); tt_pnum(invalid as i64); _zag_println("");
        st_free(&st);
        return 1;
    }
    _zag_println("ST_DONE");
    st_free(&st);
    return 0;
}

@import("base.zag")
@import("hand_a.zag")
// ============ zoom machinery, candidate registry ============
// why codes: 1 count-letters-inside-word, 2 locate-target-word,
// 3 index-character-inside-word, 4 substring-scan-at-character-scale,
// 5 character-span, 6 measure-word-span.
fn why_str(w:i64) []u8 {
    if (w==1) { return "count-letters-inside-word"; }
    if (w==2) { return "locate-target-word"; }
    if (w==3) { return "index-character-inside-word"; }
    if (w==4) { return "substring-scan-at-character-scale"; }
    if (w==6) { return "measure-word-span"; }
    return "character-span";
}
// mg_zoom addresses the sub-span [roff,roff+rlen) of parent span and logs
// (qid, span, parent, off, len, depth, why) to the zoom ledger. tag is the
// run tag ("CAND" in derivation, "INTAKE" on the live path).
fn mg_zoom(tag:[]u8, qid:i64, parent:i64, roff:i64, rlen:i64, depth:i64, why:i64,
           soff:[]u8, slen:[]u8, nsp:*i64,
           zlog:[]u8, zn:*i64,
           out:[]u8, atp:*i64, scr:[]u8) i64 {
    let a:i64=atp.*;
    let po:i64=r_u32le(soff,parent*4);
    let id:i64=nsp.*;
    w_u32le(soff,id*4,po+roff); w_u32le(slen,id*4,rlen);
    nsp.*=id+1;
    let z:i64=zn.*;
    let b:i64=z*28;
    w_u32le(zlog,b,qid); w_u32le(zlog,b+4,id); w_u32le(zlog,b+8,parent);
    w_u32le(zlog,b+12,po+roff); w_u32le(zlog,b+16,rlen);
    w_u32le(zlog,b+20,depth); w_u32le(zlog,b+24,why);
    zn.*=z+1;
    a=ob_raw(out,a,tag);
    a=ob_raw(out,a," zoom qid=");
    a=ob_i64(out,a,qid,scr);
    a=ob_raw(out,a," span=");
    a=ob_i64(out,a,id,scr);
    a=ob_raw(out,a," parent=");
    a=ob_i64(out,a,parent,scr);
    a=ob_raw(out,a," off=");
    a=ob_i64(out,a,po+roff,scr);
    a=ob_raw(out,a," len=");
    a=ob_i64(out,a,rlen,scr);
    a=ob_raw(out,a," depth=");
    a=ob_i64(out,a,depth,scr);
    a=ob_raw(out,a," why=");
    a=ob_raw(out,a,why_str(why));
    a=ob_nl(out,a);
    atp.*=a;
    return id;
}
// stats pack: bit0 correct, bit1 native, bit2 fallback,
// bits8..39 ops, bits40..47 maxdepth, bits48..55 nzooms.
fn pack_stats(correct:i64, native:i64, fb:i64, ops:i64, maxd:i64, nz:i64) i64 {
    return correct+(native*2)+(fb*4)+(ops*256)+(maxd*1099511627776)+(nz*281474976710656);
}
// emit_choice: the choice line (tag qid kind chunk why).
fn emit_choice(tag:[]u8, qid:i64, kind:i64, chunk:[]u8, why:[]u8,
               out:[]u8, atp:*i64, scr:[]u8) void {
    let a:i64=atp.*;
    a=ob_raw(out,a,tag);
    a=ob_raw(out,a," qid=");
    a=ob_i64(out,a,qid,scr);
    a=ob_raw(out,a," kind=");
    a=ob_raw(out,a,kind_name(kind));
    a=ob_raw(out,a," chunk=");
    a=ob_raw(out,a,chunk);
    a=ob_raw(out,a," why=\"");
    a=ob_raw(out,a,why);
    a=ob_raw(out,a,"\"");
    a=ob_nl(out,a);
    atp.*=a;
    return;
}
// emit_resline: the result line.
fn emit_resline(tag:[]u8, ans:[]u8, exp:[]u8, correct:i64, native:i64, fb:i64,
                ops:i64, maxd:i64, nz:i64,
                out:[]u8, atp:*i64, scr:[]u8) void {
    let a:i64=atp.*;
    a=ob_raw(out,a,tag);
    a=ob_raw(out,a,"R ans=\"");
    a=ob_raw(out,a,ans);
    a=ob_raw(out,a,"\" exp=\"");
    a=ob_raw(out,a,exp);
    a=ob_raw(out,a,"\" correct=");
    a=ob_i64(out,a,correct,scr);
    a=ob_raw(out,a," native=");
    a=ob_i64(out,a,native,scr);
    a=ob_raw(out,a," fallback=");
    a=ob_i64(out,a,fb,scr);
    a=ob_raw(out,a," ops=");
    a=ob_i64(out,a,ops,scr);
    a=ob_raw(out,a," maxdepth=");
    a=ob_i64(out,a,maxd,scr);
    a=ob_raw(out,a," zooms=");
    a=ob_i64(out,a,nz,scr);
    a=ob_nl(out,a);
    atp.*=a;
    return;
}
// emit_cand: choice line + result line (no zooms between).
fn emit_cand(tag:[]u8, qid:i64, kind:i64, chunk:[]u8, why:[]u8,
             ans:[]u8, exp:[]u8, correct:i64, native:i64, fb:i64,
             ops:i64, maxd:i64, nz:i64,
             out:[]u8, atp:*i64, scr:[]u8) void {
    emit_choice(tag,qid,kind,chunk,why,out,atp,scr);
    emit_resline(tag,ans,exp,correct,native,fb,ops,maxd,nz,out,atp,scr);
    return;
}
// ---------- candidate registry ----------
// 1 CHAR, 2 WORD, 3 WORD_ZOOM, 4 WORD_TRY_SCAN, 5 REV_WORD,
// 6 BOTH_ENDS, 7 SPAN3, 8 SPAN5, 9 END_DIRECT
fn cand_name(c:i64) []u8 {
    if (c==1) { return "CHAR"; }
    if (c==2) { return "WORD"; }
    if (c==3) { return "WORD>CHAR"; }
    if (c==4) { return "WORD?CHARSCAN"; }
    if (c==5) { return "REV_WORD"; }
    if (c==6) { return "BOTH_ENDS"; }
    if (c==7) { return "SPAN3"; }
    if (c==8) { return "SPAN5"; }
    return "END_DIRECT";
}
// coarseness rank for the deterministic tie-break (prefer coarser).
// coarseness rank: LOWER = coarser chunking unit (preferred on exact ties).
// 1 = word-scale units (WORD, REV_WORD); 2 = word-scale locate resolving to
// char scale (WORD>CHAR, WORD?CHARSCAN); 3 = byte-scale work (CHAR,
// BOTH_ENDS, SPAN3, SPAN5, END_DIRECT).
fn coarseness(c:i64) i64 {
    if (c==2) { return 1; }
    if (c==5) { return 1; }
    if (c==3) { return 2; }
    if (c==4) { return 2; }
    return 3;
}
// cand_why: each candidate's intrinsic reason for its chunking.
fn cand_why(c:i64, kind:i64) []u8 {
    if (c==1) { return "character units: letters and indices live at byte scale; space-scan addressing, no word table"; }
    if (c==2) { return "word units: the question is about word structure; sub-word work is out-of-unit"; }
    if (c==3) {
        if (kind==2) { return "locate the named word at word scale, then magnify to character units for the index"; }
        if (kind==12) { return "locate the Nth word at word scale, magnify to character units for the index"; }
        if (kind==1) { return "multi-token letter count: enumerate words at word scale, magnify to character units inside each word"; }
        if (kind==6) { return "try word-boundary match first; magnify to a character span scan on miss"; }
        return "word-scale locate, character-scale resolve, traced zooms";
    }
    if (c==4) {
        if (kind==6) { return "cheap word-boundary attempt first; magnify to character-span scan only on miss"; }
        if (kind==17) { return "cheap word-boundary attempt inside the addressed word; magnify to character-span scan on miss"; }
        return "WORD?CHARSCAN on a non-CONTAINS kind: behaves exactly as WORD>CHAR";
    }
    if (c==5) { return "address from the right: the question is anchored at the end of the text"; }
    if (c==6) { return "scan from both ends toward the middle: first hit from either side wins"; }
    if (c==7) { return "fixed 3-byte spans"; }
    if (c==8) { return "fixed 5-byte spans"; }
    if (c==9) {
        if (kind==8) { return "first-letter questions name the text edge: read it directly"; }
        if (kind==9) { return "last-letter questions name the text edge: read it directly"; }
        if (kind==14) { return "first letter of an addressed word: read the word edge directly"; }
        if (kind==15) { return "last letter of an addressed word: read the word edge directly"; }
        return "END_DIRECT on a non-edge kind: behaves exactly as CHAR";
    }
    return "read the addressed end directly: no scan when the question names the edge";
}

// base.zag — shared primitives for Phase 2 (learned chunking).
//
// GENERATED by gen_phase2.py from the frozen magnifying-glass fork
// (~/workspace/mg_chunking/mg_chunk.zag, commit
// 1de59c334aea10907cdc34545c7a3e97a868c6d2). Verbatim extraction of the
// fork's little-endian accessors, output buffer, byte-string helpers,
// chunk primitives, and parse functions. No behavior change. The fork's
// classify/kind_name/skind are NOT included: Phase 2 defines an extended
// classifier (kinds 1-17) in hand_a.zag.
@import("R33_NATIVE_IO_V1.zag")

// ---------- little-endian accessors over []u8 arenas ----------
// (ZNC-2026-09-21-007: no `as []i32` casts; []u8 arenas + accessors)
fn w_u32le(b:[]u8, o:i64, v:i64) void {
    b[o]=(v & 255) as u8;
    b[o+1]=((v >> 8) & 255) as u8;
    b[o+2]=((v >> 16) & 255) as u8;
    b[o+3]=((v >> 24) & 255) as u8;
}
fn r_u32le(b:[]u8, o:i64) i64 {
    return (b[o] as i64)+((b[o+1] as i64) << 8)+((b[o+2] as i64) << 16)+((b[o+3] as i64) << 24);
}
fn w_i64le(b:[]u8, o:i64, v:i64) void {
    let u:i64=v; let i:i64=0;
    while (i<8) { b[o+i]=(u & 255) as u8; u=u >> 8; i=i+1; }
}
fn r_i64le(b:[]u8, o:i64) i64 {
    let u:i64=0; let i:i64=7;
    while (i>=0) { u=(u << 8)+(b[o+i] as i64); i=i-1; }
    return u;
}

// ---------- output buffer ----------
fn ob_raw(out:[]u8, at:i64, s:[]u8) i64 {
    let i:i64=0;
    while (i<s.len) { out[at+i]=s[i]; i=i+1; }
    return at+s.len;
}
fn ob_i64(out:[]u8, at:i64, v:i64, scr:[]u8) i64 {
    let x:i64=v;
    if (x<0) { out[at]=45; at=at+1; x=0-x; }
    let n:i64=0;
    if (x==0) { scr[0]=48; n=1; }
    while (x>0) { scr[n]=((x % 10)+48) as u8; x=x/10; n=n+1; }
    let i:i64=n-1;
    while (i>=0) { out[at]=scr[i]; at=at+1; i=i-1; }
    return at;
}
fn ob_nl(out:[]u8, at:i64) i64 { out[at]=10; return at+1; }

// ---------- byte-string helpers (znc has no break; flag idiom) ----------
fn find_sub(h:[]u8, n:[]u8) i64 {
    if (n.len==0) { return 0; }
    if (n.len>h.len) { return -1; }
    let i:i64=0; let hit:i64=-1;
    while (i+n.len<=h.len) {
        if (hit==-1) {
            let j:i64=0; let ok:i64=1;
            while (j<n.len) {
                if (h[i+j]!=n[j]) { ok=0; j=n.len; }
                else { j=j+1; }
            }
            if (ok==1) { hit=i; }
        }
        i=i+1;
    }
    return hit;
}
fn has_sub(h:[]u8, n:[]u8) i64 {
    if (find_sub(h,n)>=0) { return 1; }
    return 0;
}
fn has_byte(t:[]u8, c:u8) i64 {
    let i:i64=0; let f:i64=0;
    while (i<t.len) {
        if (t[i]==c) { f=1; i=t.len; }
        else { i=i+1; }
    }
    return f;
}
fn beq(a:[]u8, b:[]u8) i64 {
    if (nio_equal(a,b)==1) { return 1; }
    return 0;
}
fn parse_digits(s:[]u8, at:i64) i64 {
    let v:i64=0; let i:i64=at; let go:i64=1;
    while (i<s.len) {
        if (go==1) {
            let c:i64=s[i] as i64;
            if (c>=48) {
                if (c<=57) { v=v*10+(c-48); i=i+1; }
                else { go=0; }
            }
            else { go=0; }
        }
        else { i=i+1; }
    }
    return v;
}

// ---------- chunk primitives ----------
fn enum_words(t:[]u8, offs:[]u8, lens:[]u8) i64 {
    let n:i64=0; let i:i64=0; let L:i64=t.len; let inword:i64=0; let s:i64=0;
    while (i<L) {
        if (t[i]==32) {
            if (inword==1) {
                w_u32le(offs,n*4,s); w_u32le(lens,n*4,i-s); n=n+1; inword=0;
            }
        }
        else {
            if (inword==0) { s=i; inword=1; }
        }
        i=i+1;
    }
    if (inword==1) { w_u32le(offs,n*4,s); w_u32le(lens,n*4,i-s); n=n+1; }
    return n;
}
fn scan_count(t:[]u8, o:i64, ln:i64, target:u8) i64 {
    let c:i64=0; let i:i64=o;
    while (i<o+ln) { if (t[i]==target) { c=c+1; } i=i+1; }
    return c;
}
fn count_words_bytes(t:[]u8) i64 {
    let n:i64=0; let i:i64=0; let L:i64=t.len; let inword:i64=0;
    while (i<L) {
        if (t[i]==32) { inword=0; }
        else {
            if (inword==0) { n=n+1; inword=1; }
        }
        i=i+1;
    }
    return n;
}
fn find_word(t:[]u8, offs:[]u8, lens:[]u8, nw:i64, w:[]u8) i64 {
    let k:i64=0; let hit:i64=-1;
    while (k<nw) {
        if (hit==-1) {
            let o:i64=r_u32le(offs,k*4); let ln:i64=r_u32le(lens,k*4);
            if (ln==w.len) {
                let seg:[]u8=t[o..o+ln];
                if (beq(seg,w)==1) { hit=k; }
            }
        }
        k=k+1;
    }
    return hit;
}
fn reverse_into(t:[]u8, dst:[]u8) void {
    let i:i64=0; let L:i64=t.len;
    while (i<L) { dst[i]=t[L-1-i]; i=i+1; }
}

// ---------- parse functions (from the fork's question-kinds section) ----------
fn parse_target_letter(q:[]u8) u8 {
    let p:i64=find_sub(q,"'s in");
    return q[p-1];
}
fn parse_pos_n(q:[]u8) i64 {
    let p:i64=find_sub(q,"the ");
    return parse_digits(q,p+4);
}
fn parse_after(q:[]u8, marker:[]u8) []u8 {
    let p:i64=find_sub(q,marker);
    return q[p+marker.len..q.len];
}
fn parse_between(q:[]u8, a:[]u8, b:[]u8) []u8 {
    let p:i64=find_sub(q,a); let p2:i64=find_sub(q,b);
    return q[p+a.len..p2];
}


@import("base.zag")
@import("hand_a.zag")
@import("hand_b.zag")
// ============ candidate 3: WORD_ZOOM (deliberative magnifier, fork's D) ============
// chunk codes: 1 CHAR, 2 WORD, 3 WORD>CHAR, 4 WORD?CHARSCAN (cand codes)
fn zoom_choose(kind:i64, shape:i64) i64 {
    if (kind==1) {
        if (shape==1) { return 3; }
        return 1;
    }
    if (kind==2) {
        if (shape==1) { return 3; }
        return 1;
    }
    if (kind==8) {
        if (shape==1) { return 3; }
        return 1;
    }
    if (kind==9) {
        if (shape==1) { return 3; }
        return 1;
    }
    if (kind==3) { return 1; }
    if (kind==4) { return 2; }
    if (kind==5) { return 1; }
    if (kind==6) { return 4; }
    return 2;
}
fn zoom_why(kind:i64, c:i64) []u8 {
    if (c==1) {
        if (kind==1) { return "letter question on a single token: character units; no coarser unit resolves letters"; }
        if (kind==3) { return "reversal is a byte-order operation: character units"; }
        if (kind==5) { return "length is a character count: character units"; }
        return "positional index on a single token: character units directly";
    }
    if (c==2) {
        if (kind==4) { return "word counting is a word-boundary operation: word units"; }
        return "word-boundary operation: word units";
    }
    if (c==3) {
        if (kind==1) { return "multi-token text: enumerate words at word scale, magnify to character units inside each word; letters live below word scale"; }
        return "locate the named word at word scale, then magnify to character units for the index";
    }
    return "try word-boundary match first; magnify to a character span scan on miss";
}
// zoom_locate: the span the question is about (whole text or named word),
// with traced zooms. Mirrors the fork's d_locate.
fn zoom_locate(tag:[]u8, qid:i64, q:[]u8, t:[]u8,
               soff:[]u8, slen:[]u8, nsp:*i64, zlog:[]u8, zn:*i64,
               woffs:[]u8, wlens:[]u8,
               out:[]u8, atp:*i64, scr:[]u8,
               oo:*i64, ll:*i64, maxd:*i64, nz:*i64, ops:*i64) i64 {
    let tw:[]u8=parse_after(q,"of ");
    if (beq(tw,t)==1) {
        oo.*=0; ll.*=t.len; return 0;
    }
    let nw:i64=enum_words(t,woffs,wlens);
    ops.*=ops.*+nw;
    let k:i64=find_word(t,woffs,wlens,nw,tw);
    if (k<0) { oo.*=0; ll.*=0; return -1; }
    let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
    let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,2,soff,slen,nsp,zlog,zn,out,atp,scr);
    nz.*=nz.*+1;
    if (maxd.*<1) { maxd.*=1; }
    oo.*=wo; ll.*=wl;
    return sid;
}
// cand_zoom_19: kinds 1-9, verbatim port of the fork's deliberative arm.
fn cand_zoom_19(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8,
                tag:[]u8, why:[]u8,
                out:[]u8, atp:*i64, scr:[]u8,
                soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
                woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8) i64 {
    let c:i64=zoom_choose(kind,shape);
    w_u32le(soff,0,0); w_u32le(slen,0,t.len);
    let nsp:i64=1;
    let ops:i64=0; let maxd:i64=0; let nzooms:i64=0;
    emit_choice(tag,qid,kind,cand_name(c),why,out,atp,scr);
    let ans:[]u8=abuf[0..0];
    let alen:i64=0;
    if (kind==1) {
        let tgt:u8=parse_target_letter(q);
        if (c==1) {
            let cnt:i64=scan_count(t,0,t.len,tgt);
            ops=t.len;
            alen=ob_i64(abuf,0,cnt,scr); ans=abuf[0..alen];
        }
        else {
            let nw:i64=enum_words(t,woffs,wlens);
            ops=nw;
            let total:i64=0; let k:i64=0;
            while (k<nw) {
                let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,1,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
                total=total+scan_count(t,so2,sl2,tgt);
                ops=ops+wl;
                k=k+1;
            }
            alen=ob_i64(abuf,0,total,scr); ans=abuf[0..alen];
        }
    }
    if (kind==2) {
        let oo:i64=0; let ll:i64=0;
        let loc:i64=zoom_locate(tag,qid,q,t,soff,slen,&nsp,zlog,zn,woffs,wlens,out,atp,scr,&oo,&ll,&maxd,&nzooms,&ops);
        let n:i64=parse_pos_n(q);
        let idx:i64=n-1;
        if (loc<0) {
            abuf[0]=63; alen=1; ans=abuf[0..alen];
        }
        else {
            if (idx<0) { idx=0; }
            if (idx>=ll) { idx=ll-1; }
            if (c==1) {
                abuf[0]=t[oo+idx]; alen=1; ans=abuf[0..alen];
                ops=ops+idx+1;
            }
            else {
                let sid2:i64=mg_zoom(tag,qid,loc,idx,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen];
                ops=ops+idx+1;
            }
        }
    }
    if (kind==8) {
        let oo:i64=0; let ll:i64=0;
        let loc:i64=zoom_locate(tag,qid,q,t,soff,slen,&nsp,zlog,zn,woffs,wlens,out,atp,scr,&oo,&ll,&maxd,&nzooms,&ops);
        if (loc<0) {
            abuf[0]=63; alen=1; ans=abuf[0..alen];
        }
        else {
            if (c==1) {
                abuf[0]=t[oo]; alen=1; ans=abuf[0..alen]; ops=ops+1;
            }
            else {
                let sid2:i64=mg_zoom(tag,qid,loc,0,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen]; ops=ops+1;
            }
        }
    }
    if (kind==9) {
        let oo:i64=0; let ll:i64=0;
        let loc:i64=zoom_locate(tag,qid,q,t,soff,slen,&nsp,zlog,zn,woffs,wlens,out,atp,scr,&oo,&ll,&maxd,&nzooms,&ops);
        if (loc<0) {
            abuf[0]=63; alen=1; ans=abuf[0..alen];
        }
        else {
            if (c==1) {
                abuf[0]=t[oo+ll-1]; alen=1; ans=abuf[0..alen]; ops=ops+ll;
            }
            else {
                let sid2:i64=mg_zoom(tag,qid,loc,ll-1,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen]; ops=ops+ll;
            }
        }
    }
    if (kind==3) {
        reverse_into(t,revbuf);
        ans=revbuf[0..t.len];
        ops=t.len;
    }
    if (kind==4) {
        let nw:i64=enum_words(t,woffs,wlens);
        ops=nw;
        alen=ob_i64(abuf,0,nw,scr); ans=abuf[0..alen];
    }
    if (kind==5) {
        ops=t.len;
        alen=ob_i64(abuf,0,t.len,scr); ans=abuf[0..alen];
    }
    if (kind==6) {
        let needle:[]u8=parse_after(q,"contain ");
        let nw:i64=enum_words(t,woffs,wlens);
        ops=nw;
        let k:i64=find_word(t,woffs,wlens,nw,needle);
        if (k>=0) {
            ans="yes";
        }
        else {
            let sid:i64=mg_zoom(tag,qid,0,0,t.len,1,4,soff,slen,&nsp,zlog,zn,out,atp,scr);
            nzooms=nzooms+1; maxd=1;
            let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
            let seg:[]u8=t[so2..so2+sl2];
            ops=ops+sl2;
            if (find_sub(seg,needle)>=0) { ans="yes"; }
            else { ans="no"; }
        }
    }
    if (kind==7) {
        let nw:i64=enum_words(t,woffs,wlens);
        ops=nw;
        let wo:i64=r_u32le(woffs,0); let wl:i64=r_u32le(wlens,0);
        ans=t[wo..wo+wl];
    }
    let correct:i64=beq(ans,exp);
    emit_resline(tag,ans,exp,correct,1,0,ops,maxd,nzooms,out,atp,scr);
    return pack_stats(correct,1,0,ops,maxd,nzooms);
}
// cand_zoom: WORD_ZOOM on all kinds (1-9 via the fork's logic, 10-17 nested).
fn cand_zoom(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8,
             tag:[]u8, why:[]u8,
             out:[]u8, atp:*i64, scr:[]u8,
             soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
             woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8) i64 {
    if (kind<=9) {
        return cand_zoom_19(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                            soff,slen,zlog,zn,woffs,wlens,revbuf,abuf);
    }
    w_u32le(soff,0,0); w_u32le(slen,0,t.len);
    let nsp:i64=1;
    let nw:i64=enum_words(t,woffs,wlens);
    let ops:i64=nw; let maxd:i64=0; let nzooms:i64=0;
    let ans:[]u8=abuf[0..0];
    let alen:i64=0;
    let wn:i64=0; let inner:[]u8=parse_wordref(q,&wn);
    let k:i64=wn_index(wn,nw);
    if (kind==16) {
        emit_choice(tag,qid,kind,"WORD",why,out,atp,scr);
        let kk:i64=nw-1;
        let wo:i64=r_u32le(woffs,kk*4); let wl:i64=r_u32le(wlens,kk*4);
        ans=t[wo..wo+wl];
    }
    else {
        emit_choice(tag,qid,kind,"WORD>CHAR",why,out,atp,scr);
        if (k<0) {
            abuf[0]=63; alen=1; ans=abuf[0..alen];
        }
        else {
            let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
            if (kind==10) {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,1,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
                let total:i64=scan_count(t,so2,sl2,parse_target_letter(q));
                ops=ops+wl;
                alen=ob_i64(abuf,0,total,scr); ans=abuf[0..alen];
            }
            if (kind==11) {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,6,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                ops=ops+1;
                alen=ob_i64(abuf,0,wl,scr); ans=abuf[0..alen];
            }
            if (kind==12) {
                let n:i64=parse_pos_n(q);
                let idx:i64=n-1;
                if (idx<0) { idx=0; }
                if (idx>=wl) { idx=wl-1; }
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,2,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let sid2:i64=mg_zoom(tag,qid,sid,idx,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen];
                ops=ops+idx+1;
            }
            if (kind==13) {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,2,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
                let j:i64=0;
                while (j<sl2) { revbuf[j]=t[so2+sl2-1-j]; j=j+1; }
                ans=revbuf[0..sl2]; ops=ops+wl;
            }
            if (kind==14) {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,2,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let sid2:i64=mg_zoom(tag,qid,sid,0,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen]; ops=ops+1;
            }
            if (kind==15) {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,2,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let sid2:i64=mg_zoom(tag,qid,sid,wl-1,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen]; ops=ops+wl;
            }
            if (kind==17) {
                let needle:[]u8=parse_after(q,"contain ");
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,4,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
                let seg:[]u8=t[so2..so2+sl2];
                ops=ops+sl2;
                if (find_sub(seg,needle)>=0) { ans="yes"; }
                else { ans="no"; }
            }
        }
    }
    let correct:i64=beq(ans,exp);
    emit_resline(tag,ans,exp,correct,1,0,ops,maxd,nzooms,out,atp,scr);
    return pack_stats(correct,1,0,ops,maxd,nzooms);
}

// ============ candidate 4: WORD_TRY_SCAN ============
// Word-boundary attempt first; character-span magnification only on miss.
// Non-CONTAINS kinds behave exactly as WORD_ZOOM.
fn cand_tryscan(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8,
                tag:[]u8, why:[]u8,
                out:[]u8, atp:*i64, scr:[]u8,
                soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
                woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8) i64 {
    if (kind==6) {
        w_u32le(soff,0,0); w_u32le(slen,0,t.len);
        let nsp:i64=1;
        let nw:i64=enum_words(t,woffs,wlens);
        let ops:i64=nw; let maxd:i64=0; let nzooms:i64=0;
        emit_choice(tag,qid,kind,"WORD?CHARSCAN",why,out,atp,scr);
        let needle:[]u8=parse_after(q,"contain ");
        let ans:[]u8=abuf[0..0];
        let k:i64=find_word(t,woffs,wlens,nw,needle);
        if (k>=0) {
            ans="yes";
        }
        else {
            let sid:i64=mg_zoom(tag,qid,0,0,t.len,1,4,soff,slen,&nsp,zlog,zn,out,atp,scr);
            nzooms=nzooms+1; maxd=1;
            let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
            let seg:[]u8=t[so2..so2+sl2];
            ops=ops+sl2;
            if (find_sub(seg,needle)>=0) { ans="yes"; }
            else { ans="no"; }
        }
        let correct:i64=beq(ans,exp);
        emit_resline(tag,ans,exp,correct,1,0,ops,maxd,nzooms,out,atp,scr);
        return pack_stats(correct,1,0,ops,maxd,nzooms);
    }
    if (kind==17) {
        w_u32le(soff,0,0); w_u32le(slen,0,t.len);
        let nsp:i64=1;
        let nw:i64=enum_words(t,woffs,wlens);
        let ops:i64=nw; let maxd:i64=0; let nzooms:i64=0;
        emit_choice(tag,qid,kind,"WORD?CHARSCAN",why,out,atp,scr);
        let ans:[]u8=abuf[0..0];
        let alen:i64=0;
        let wn:i64=0; let inner:[]u8=parse_wordref(q,&wn);
        let needle:[]u8=parse_after(q,"contain ");
        let k:i64=wn_index(wn,nw);
        if (k<0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
            let whole:i64=0;
            if (wl==needle.len) {
                let seg0:[]u8=t[wo..wo+wl];
                if (beq(seg0,needle)==1) { whole=1; }
            }
            if (whole==1) {
                ans="yes";
            }
            else {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,4,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
                let seg:[]u8=t[so2..so2+sl2];
                ops=ops+sl2;
                if (find_sub(seg,needle)>=0) { ans="yes"; }
                else { ans="no"; }
            }
        }
        let correct:i64=beq(ans,exp);
        emit_resline(tag,ans,exp,correct,1,0,ops,maxd,nzooms,out,atp,scr);
        return pack_stats(correct,1,0,ops,maxd,nzooms);
    }
    return cand_zoom(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                     soff,slen,zlog,zn,woffs,wlens,revbuf,abuf);
}

// selftest.zag — self-testing TNN: a deliberative orchestrator in pure Zag.
//
// The TNN itself is the test-runner: it loads a frozen battery manifest,
// executes every battery against a fresh learner instance, ADJUDICATES each
// result against its preregistered bar itself (pass/trip/unrunnable, no
// external judge), writes every verdict into the audit ledger, and refuses
// to emit ST_DONE unless verdict count == manifest count (anti-silent-skip
// gate: completion is blocked by a missing verdict).
//
// Manifest (SELFTEST_PREREG.md, frozen 2026-09-21):
//   B1 MASTERY  N=240  bar clean>=236        expected PASS
//   B2 ABSORB   12 false + 48 true  bar absorbed==12   expected PASS
//   B3 FLAW     96 probes  bar correct>=92   expected PASS
//   B4 CONTRA   48 one-liar 2v1  bar >=46    expected PASS
//   B5 EMPTY    0 facts (corrupt)  verdict must be UNRUNNABLE
//   B6 SELFCHECK  B1 teach+tally twice in-process, digest equality  expected PASS
//   T1 TRIP-MASTERY  239/240 taught, bar 240  expected TRIP
//   T4 TRIP-CONTRA   47/48 + 1 tie, bar 48    expected TRIP
// s1: 8 batteries. s10: 8 batteries x 10 salt variants = 80.
//
// argv: selftest <s1|s10> <rep>   (rep accepted, never printed)
// Build: znc_linux_x86_64_abed8aa1 selftest.zag -o selftest --no-analyze

fn m_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn m_g32(b:[]u8,o:i32)i32 {
    let v:i32=0;
    v=v|((b[o] as i32)&255);
    v=v|(((b[o+1] as i32)&255)<<8);
    v=v|(((b[o+2] as i32)&255)<<16);
    v=v|(((b[o+3] as i32)&255)<<24);
    return v;
}
fn m_s32(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
}
fn m_g64(b:[]u8,o:i64)i64 {
    let v:i64=0;
    v=v|((b[o] as i64)&255);
    v=v|(((b[o+1] as i64)&255)<<8);
    v=v|(((b[o+2] as i64)&255)<<16);
    v=v|(((b[o+3] as i64)&255)<<24);
    v=v|(((b[o+4] as i64)&255)<<32);
    v=v|(((b[o+5] as i64)&255)<<40);
    v=v|(((b[o+6] as i64)&255)<<48);
    v=v|(((b[o+7] as i64)&255)<<56);
    return v;
}
fn m_s64(b:[]u8,o:i64,v:i64)void {
    let o32:i32=o as i32;
    b[o32]=(v&255) as u8;
    b[o32+1]=((v>>8)&255) as u8;
    b[o32+2]=((v>>16)&255) as u8;
    b[o32+3]=((v>>24)&255) as u8;
    b[o32+4]=((v>>32)&255) as u8;
    b[o32+5]=((v>>48)&255) as u8;
    b[o32+6]=((v>>56)&255) as u8;
    b[o32+7]=((v>>56)&255) as u8;
}
fn m_pnum(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    _zag_free(_zag_slice_ptr(s));
}

// ---------- audit ledger: 16-word records ----------
// hdr: an@0(i32) bat_ops@8(i64) orch_ops@16(i64)
fn au_append(aud:[]u8,hdr:[]u8,op:i32,slot:i32,rc:i32,
    b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
    a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,
    stage:i32,d1:i32,d2:i32)void {
    let n:i32=m_g32(hdr,0);
    let o:i32=n*64;
    m_s32(aud,o,op);m_s32(aud,o+4,slot);m_s32(aud,o+8,rc);
    m_s32(aud,o+12,b1);m_s32(aud,o+16,b2);m_s32(aud,o+20,b3);
    m_s32(aud,o+24,b4);m_s32(aud,o+28,b5);
    m_s32(aud,o+32,a1);m_s32(aud,o+36,a2);m_s32(aud,o+40,a3);
    m_s32(aud,o+44,a4);m_s32(aud,o+48,a5);
    m_s32(aud,o+52,stage);m_s32(aud,o+56,d1);m_s32(aud,o+60,d2);
    m_s32(hdr,0,n+1);
}
fn b_bump(hdr:[]u8)void {
    let v:i64=m_g64(hdr,8);
    m_s64(hdr,8,v+1);
}
fn o_bump(hdr:[]u8)void {
    let v:i64=m_g64(hdr,16);
    m_s64(hdr,16,v+1);
}

// ---------- deterministic data ----------
// truth(f,salt) = (((f+salt)*7919+13) % 100003); flie is a nearby wrong value.
fn truth(f:i32,salt:i32)i64 {
    let x:i64=((f+salt) as i64)*7919+13;
    return x%100003;
}
fn flie(f:i32,salt:i32)i64 {
    let t:i64=truth(f,salt);
    return t+1+(((f+salt)*37)%89) as i64;
}

// ---------- learner core ----------
// bst: status per fact i32 (0 absent, 1 installed, 2 withheld)
// bsv: installed value i64
fn ln_teach_quiet(bst:[]u8,bsv:[]u8,hdr:[]u8,f:i32,val:i64)void {
    m_s32(bst,f*4,1);
    m_s64(bsv,(f*8) as i64,val);
    b_bump(hdr);
}
// candidate j of fact f under competition kind ck:
//   ck=0 flaw:      truth@100, lie@40
//   ck=1 contra2v1: lie@100 first, truth@100, truth@100
//   ck=2 tie:       lie@100, truth@100
// out: val@0(i64) trust@8(i32) spoof@12(i32)
fn cand(f:i32,j:i32,salt:i32,ck:i32,out:[]u8)void {
    let t:i64=truth(f,salt);
    let l:i64=flie(f,salt);
    let val:i64=0; let trust:i32=0; let spoof:i32=0;
    if(ck==0){
        if(j==0){val=t;trust=100;}
        if(j==1){val=l;trust=40;}
    }
    if(ck==1){
        if(j==0){val=l;trust=100;}
        if(j==1){val=t;trust=100;}
        if(j==2){val=t;trust=100;}
    }
    if(ck==2){
        if(j==0){val=l;trust=100;}
        if(j==1){val=t;trust=100;}
    }
    m_s64(out,0,val);
    m_s32(out,8,trust);
    m_s32(out,12,spoof);
}
fn ln_compete(bst:[]u8,bsv:[]u8,hdr:[]u8,f:i32,salt:i32,ck:i32,nc:i32)void {
    let scratch:[]u8=m_alloc(32);
    // gather (val,trust), pre-filter spoofed
    let v0:i64=0; let t0:i32=0; let n0:i32=0;
    let v1:i64=0; let t1:i32=0; let n1:i32=0;
    let v2:i64=0; let t2:i32=0; let n2:i32=0;
    let ng:i32=0;
    let j:i32=0;
    while(j<nc){
        cand(f,j,salt,ck,scratch);
        b_bump(hdr);
        let sp:i32=m_g32(scratch,12);
        if(sp==0){
            let vv:i64=m_g64(scratch,0);
            let tt:i32=m_g32(scratch,8);
            if(ng==0){v0=vv;t0=tt;n0=1;}
            if(ng==1){v1=vv;t1=tt;n1=1;}
            if(ng==2){v2=vv;t2=tt;n2=1;}
            ng=ng+1;
        }
        j=j+1;
    }
    // trust-weighted sums per distinct value (accumulators); unique max wins;
    // a shared max sum is a genuine tie -> withhold.
    let a0v:i64=0; let a0s:i64=0; let a0n:i32=0;
    let a1v:i64=0; let a1s:i64=0; let a1n:i32=0;
    let a2v:i64=0; let a2s:i64=0; let a2n:i32=0;
    let na:i32=0;
    // fold gathered candidates into accumulators
    if(n0==1){
        let added:i32=0;
        if(added==0){ if(na==0){a0v=v0;a0s=t0 as i64;a0n=1;na=1;added=1;} }
        if(added==0){ if(na==1){a1v=v0;a1s=t0 as i64;a1n=1;na=2;added=1;} }
        if(added==0){ if(na==2){a2v=v0;a2s=t0 as i64;a2n=1;na=3;added=1;} }
        b_bump(hdr);
    }
    if(n1==1){
        let added:i32=0;
        if(na>0 && v1==a0v){a0s=a0s+(t1 as i64);added=1;}
        if(added==0){ if(na>1 && v1==a1v){a1s=a1s+(t1 as i64);added=1;} }
        if(added==0){ if(na>2 && v1==a2v){a2s=a2s+(t1 as i64);added=1;} }
        if(added==0){ if(na==0){a0v=v1;a0s=t1 as i64;a0n=1;na=1;added=1;} }
        if(added==0){ if(na==1){a1v=v1;a1s=t1 as i64;a1n=1;na=2;added=1;} }
        if(added==0){ if(na==2){a2v=v1;a2s=t1 as i64;a2n=1;na=3;added=1;} }
        b_bump(hdr);
    }
    if(n2==1){
        let added:i32=0;
        if(na>0 && v2==a0v){a0s=a0s+(t2 as i64);added=1;}
        if(added==0){ if(na>1 && v2==a1v){a1s=a1s+(t2 as i64);added=1;} }
        if(added==0){ if(na>2 && v2==a2v){a2s=a2s+(t2 as i64);added=1;} }
        if(added==0){ if(na==0){a0v=v2;a0s=t2 as i64;a0n=1;na=1;added=1;} }
        if(added==0){ if(na==1){a1v=v2;a1s=t2 as i64;a1n=1;na=2;added=1;} }
        if(added==0){ if(na==2){a2v=v2;a2s=t2 as i64;a2n=1;na=3;added=1;} }
        b_bump(hdr);
    }
    if(na==0){
        m_s32(bst,f*4,2);
        b_bump(hdr);
        _zag_free(_zag_slice_ptr(scratch));
        return;
    }
    // unique max over accumulators; shared max sum = genuine tie -> withhold
    let bv:i64=a0v; let bs:i64=a0s; let tie:i32=0;
    if(na>1){
        b_bump(hdr);
        if(a1s>bs){bv=a1v;bs=a1s;tie=0;}
        else { b_bump(hdr); if(a1s==bs){tie=1;} }
    }
    if(na>2){
        b_bump(hdr);
        if(a2s>bs){bv=a2v;bs=a2s;tie=0;}
        else { b_bump(hdr); if(a2s==bs){tie=1;} }
    }
    if(tie==1){
        m_s32(bst,f*4,2);
        b_bump(hdr);
    } else {
        m_s32(bst,f*4,1);
        m_s64(bsv,(f*8) as i64,bv);
        b_bump(hdr);
    }
    _zag_free(_zag_slice_ptr(scratch));
}
fn ln_digest(bst:[]u8,bsv:[]u8,n:i32)i64 {
    let hh:i64=1469598103934665603;
    let f:i32=0;
    while(f<n){
        let st:i32=m_g32(bst,f*4);
        let v:i64=m_g64(bsv,(f*8) as i64);
        let x:i64=(f as i64)*1000003+(st as i64)*7919+v;
        hh=hh^x;
        hh=hh*1099511628211;
        f=f+1;
    }
    return hh;
}

// ---------- batteries: each returns the observed metric ----------
// B1: teach 240 quiet facts, count clean (installed && value==truth)
fn run_B1(hdr:[]u8,salt:i32)i32 {
    let bst:[]u8=m_alloc(240*4);
    let bsv:[]u8=m_alloc(240*8);
    if(bst.len==0||bsv.len==0){return -1;}
    let f:i32=0;
    while(f<240){
        ln_teach_quiet(bst,bsv,hdr,f,truth(f,salt));
        f=f+1;
    }
    let clean:i32=0;
    f=0;
    while(f<240){
        b_bump(hdr);
        if(m_g32(bst,f*4)==1 && m_g64(bsv,(f*8) as i64)==truth(f,salt)){clean=clean+1;}
        f=f+1;
    }
    _zag_free(_zag_slice_ptr(bst));
    _zag_free(_zag_slice_ptr(bsv));
    return clean;
}
// B2: 12 planted falsehoods taught consistently + 48 true; count absorbed
fn run_B2(hdr:[]u8,salt:i32)i32 {
    let bst:[]u8=m_alloc(60*4);
    let bsv:[]u8=m_alloc(60*8);
    if(bst.len==0||bsv.len==0){return -1;}
    let f:i32=0;
    while(f<60){
        if(f<12){ln_teach_quiet(bst,bsv,hdr,f,flie(f,salt));}
        else {ln_teach_quiet(bst,bsv,hdr,f,truth(f,salt));}
        f=f+1;
    }
    let abs:i32=0;
    f=0;
    while(f<12){
        b_bump(hdr);
        if(m_g32(bst,f*4)==1 && m_g64(bsv,(f*8) as i64)==flie(f,salt)){abs=abs+1;}
        f=f+1;
    }
    _zag_free(_zag_slice_ptr(bst));
    _zag_free(_zag_slice_ptr(bsv));
    return abs;
}
// B3: 96 flaw probes, truth@100 vs lie@40; count correct
fn run_B3(hdr:[]u8,salt:i32)i32 {
    let bst:[]u8=m_alloc(96*4);
    let bsv:[]u8=m_alloc(96*8);
    if(bst.len==0||bsv.len==0){return -1;}
    let f:i32=0;
    while(f<96){
        ln_compete(bst,bsv,hdr,f,salt,0,2);
        f=f+1;
    }
    let cor:i32=0;
    f=0;
    while(f<96){
        b_bump(hdr);
        if(m_g32(bst,f*4)==1 && m_g64(bsv,(f*8) as i64)==truth(f,salt)){cor=cor+1;}
        f=f+1;
    }
    _zag_free(_zag_slice_ptr(bst));
    _zag_free(_zag_slice_ptr(bsv));
    return cor;
}
// B4: 48 one-liar 2v1 (lie first); count truth installed
fn run_B4(hdr:[]u8,salt:i32)i32 {
    let bst:[]u8=m_alloc(48*4);
    let bsv:[]u8=m_alloc(48*8);
    if(bst.len==0||bsv.len==0){return -1;}
    let f:i32=0;
    while(f<48){
        ln_compete(bst,bsv,hdr,f,salt,1,3);
        f=f+1;
    }
    let cor:i32=0;
    f=0;
    while(f<48){
        b_bump(hdr);
        if(m_g32(bst,f*4)==1 && m_g64(bsv,(f*8) as i64)==truth(f,salt)){cor=cor+1;}
        f=f+1;
    }
    _zag_free(_zag_slice_ptr(bst));
    _zag_free(_zag_slice_ptr(bsv));
    return cor;
}
// T1: 239/240 taught (fact 239 withheld); count clean
fn run_T1(hdr:[]u8,salt:i32)i32 {
    let bst:[]u8=m_alloc(240*4);
    let bsv:[]u8=m_alloc(240*8);
    if(bst.len==0||bsv.len==0){return -1;}
    let f:i32=0;
    while(f<239){
        ln_teach_quiet(bst,bsv,hdr,f,truth(f,salt));
        f=f+1;
    }
    let clean:i32=0;
    f=0;
    while(f<240){
        b_bump(hdr);
        if(m_g32(bst,f*4)==1 && m_g64(bsv,(f*8) as i64)==truth(f,salt)){clean=clean+1;}
        f=f+1;
    }
    _zag_free(_zag_slice_ptr(bst));
    _zag_free(_zag_slice_ptr(bsv));
    return clean;
}
// T4: 47 contra2v1 + 1 tie-withhold; count truth installed
fn run_T4(hdr:[]u8,salt:i32)i32 {
    let bst:[]u8=m_alloc(48*4);
    let bsv:[]u8=m_alloc(48*8);
    if(bst.len==0||bsv.len==0){return -1;}
    let f:i32=0;
    while(f<48){
        if(f<47){ln_compete(bst,bsv,hdr,f,salt,1,3);}
        else {ln_compete(bst,bsv,hdr,f,salt,2,2);}
        f=f+1;
    }
    let cor:i32=0;
    f=0;
    while(f<48){
        b_bump(hdr);
        if(m_g32(bst,f*4)==1 && m_g64(bsv,(f*8) as i64)==truth(f,salt)){cor=cor+1;}
        f=f+1;
    }
    _zag_free(_zag_slice_ptr(bst));
    _zag_free(_zag_slice_ptr(bsv));
    return cor;
}
// B6: run B1 teach+digest twice in-process; 1 if digests equal else 0
fn run_B6(hdr:[]u8,salt:i32)i32 {
    let bst:[]u8=m_alloc(240*4);
    let bsv:[]u8=m_alloc(240*8);
    if(bst.len==0||bsv.len==0){return -1;}
    let f:i32=0;
    while(f<240){
        ln_teach_quiet(bst,bsv,hdr,f,truth(f,salt));
        f=f+1;
    }
    let d1:i64=ln_digest(bst,bsv,240);
    b_bump(hdr);
    // second instance
    let cst:[]u8=m_alloc(240*4);
    let csv:[]u8=m_alloc(240*8);
    if(cst.len==0||csv.len==0){
        _zag_free(_zag_slice_ptr(bst));
        _zag_free(_zag_slice_ptr(bsv));
        return -1;
    }
    f=0;
    while(f<240){
        ln_teach_quiet(cst,csv,hdr,f,truth(f,salt));
        f=f+1;
    }
    let d2:i64=ln_digest(cst,csv,240);
    b_bump(hdr);
    _zag_free(_zag_slice_ptr(bst));
    _zag_free(_zag_slice_ptr(bsv));
    _zag_free(_zag_slice_ptr(cst));
    _zag_free(_zag_slice_ptr(csv));
    if(d1==d2){return 1;}
    return 0;
}

// ---------- orchestrator ----------
// battery ids: 1=B1 2=B2 3=B3 4=B4 5=B5 6=B6 7=T1 8=T4
// verdict codes: 0=PASS 1=TRIP 2=ERROR 3=UNRUNNABLE
fn p_battname(id:i32)void {
    if(id==1){_zag_print("B1");}
    if(id==2){_zag_print("B2");}
    if(id==3){_zag_print("B3");}
    if(id==4){_zag_print("B4");}
    if(id==5){_zag_print("B5");}
    if(id==6){_zag_print("B6");}
    if(id==7){_zag_print("T1");}
    if(id==8){_zag_print("T4");}
}
// execute one battery; out verdict via return code packing: rc*1000000+obs
// (obs<1000000 always here). bar returned via barout[0].
fn orch_battery(hdr:[]u8,aud:[]u8,batt:i32,variant:i32,salt:i32,barout:[]u8)i32 {
    o_bump(hdr); // schedule
    let obs:i32=0; let bar:i32=0; let iseq:i32=0; // iseq: 1 = equality bar
    let unrunnable:i32=0;
    if(batt==1){obs=run_B1(hdr,salt);bar=236;}
    if(batt==2){obs=run_B2(hdr,salt);bar=12;iseq=1;}
    if(batt==3){obs=run_B3(hdr,salt);bar=92;}
    if(batt==4){obs=run_B4(hdr,salt);bar=46;}
    if(batt==5){unrunnable=1;obs=0;bar=0;}
    if(batt==6){obs=run_B6(hdr,salt);bar=1;}
    if(batt==7){obs=run_T1(hdr,salt);bar=240;}
    if(batt==8){obs=run_T4(hdr,salt);bar=48;}
    o_bump(hdr); // execution accounted
    // adjudicate against the preregistered bar, inside the binary
    let verdict:i32=0;
    if(unrunnable==1){
        verdict=3;
    } else {
        if(obs<0){verdict=2;}
        else {
            if(iseq==1){
                if(obs==bar){verdict=0;} else {verdict=1;}
            } else {
                if(obs>=bar){verdict=0;} else {verdict=1;}
            }
        }
    }
    o_bump(hdr); // adjudicate
    if(verdict==2){obs=0;} // ERROR: pack a non-negative obs; the -1 was already emitted above
    // ledger: op=20 verdict, slot=batt, rc=verdict, b1=obs, b2=bar, a1=variant
    au_append(aud,hdr,20,batt,verdict,obs,bar,0,0,0,variant,0,0,0,0,1,variant,0);
    o_bump(hdr); // record
    // emit
    _zag_print("ST_VERDICT,batt=");
    p_battname(batt);
    _zag_print(",var=");
    m_pnum(variant as i64);
    _zag_print(",obs=");
    m_pnum(obs as i64);
    _zag_print(",bar=");
    m_pnum(bar as i64);
    _zag_print(",verdict=");
    m_pnum(verdict as i64);
    _zag_println("");
    o_bump(hdr); // emit
    m_s32(barout,0,bar);
    return verdict*1000000+obs;
}

fn main()void {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let nvar:i32=0;
    if(_zag_strcmp(a1,"s1")==1){nvar=1;}
    if(_zag_strcmp(a1,"s10")==1){nvar=10;}
    if(nvar==0){
        _zag_println("usage: selftest <s1|s10> <rep>");
        return;
    }
    if(a2.len==0){
        _zag_println("usage: selftest <s1|s10> <rep>");
        return;
    }
    _zag_print("ST_CFG,scale=");
    _zag_print(a1);
    _zag_print(",batt_total=");
    m_pnum((8*nvar) as i64);
    _zag_println("");
    let hdr:[]u8=m_alloc(32);
    let aud:[]u8=m_alloc(80*64);
    if(hdr.len==0||aud.len==0){
        _zag_println("alloc failed");
        return;
    }
    let barout:[]u8=m_alloc(4);
    // manifest digest over verdicts
    let hh:i64=1469598103934665603;
    let emitted:i32=0;
    let npass:i32=0; let ntrip:i32=0; let nunrun:i32=0; let nerr:i32=0;
    let batt:i32=1;
    while(batt<=8){
        let v:i32=0;
        while(v<nvar){
            let salt:i32=v*1000;
            let packed:i32=orch_battery(hdr,aud,batt,v,salt,barout);
            let verdict:i32=packed/1000000;
            let obs:i32=packed%1000000;
            if(verdict==0){npass=npass+1;}
            if(verdict==1){ntrip=ntrip+1;}
            if(verdict==2){nerr=nerr+1;}
            if(verdict==3){nunrun=nunrun+1;}
            emitted=emitted+1;
            let x:i64=(batt as i64)*1000003+(v as i64)*7919+(verdict as i64)*131+(obs as i64);
            hh=hh^x;
            hh=hh*1099511628211;
            v=v+1;
        }
        batt=batt+1;
    }
    _zag_free(_zag_slice_ptr(barout));
    // anti-silent-skip gate: ST_DONE is blocked unless every manifest
    // battery produced a verdict record.
    if(emitted!=(8*nvar)){
        _zag_print("ST_BLOCKED,emitted=");
        m_pnum(emitted as i64);
        _zag_print(",expected=");
        m_pnum((8*nvar) as i64);
        _zag_println("");
        return;
    }
    let bo:i64=m_g64(hdr,8);
    let oo:i64=m_g64(hdr,16);
    let an:i32=m_g32(hdr,0);
    _zag_print("ST_MANIFEST,total=");
    m_pnum((8*nvar) as i64);
    _zag_print(",pass=");
    m_pnum(npass as i64);
    _zag_print(",trip=");
    m_pnum(ntrip as i64);
    _zag_print(",unrunnable=");
    m_pnum(nunrun as i64);
    _zag_print(",error=");
    m_pnum(nerr as i64);
    _zag_print(",bat_ops=");
    m_pnum(bo);
    _zag_print(",orch_ops=");
    m_pnum(oo);
    _zag_print(",audit_records=");
    m_pnum(an as i64);
    _zag_println("");
    _zag_print("ST_DIGEST,fnv1a=");
    let hexd:[]u8="0123456789abcdef";
    let sh:[]u8=m_alloc(17);
    let ni:i32=0;
    while(ni<16){
        let shift:i64=((15-ni)*4) as i64;
        let nib:i32=((hh>>shift)&15) as i32;
        sh[ni]=hexd[nib];
        ni=ni+1;
    }
    _zag_print(sh[0..16]);
    _zag_println("");
    _zag_println("ST_DONE");
}

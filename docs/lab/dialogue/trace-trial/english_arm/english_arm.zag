// ENGLISH-ARM: English reasoning traces for the TNN reasoning-traces trial.
// Pure Zag, zero RNG, deterministic. The binary is TAUGHT English (vocabulary,
// sentence patterns) in a timed training phase, then reasons IN ENGLISH about
// test problems: every turn prints OBSERVATION -> KNOWLEDGE -> INFERENCE ->
// CONCLUSION, where KNOWLEDGE cites the actual facts retrieved that turn.
// Usage: english_arm [kb.txt] [gaz.txt] [battery.txt]
// (defaults: kb.txt gaz.txt battery_round4.txt, relative to CWD)
@import("R33_NATIVE_IO_V1.zag")

// ---------------- byte helpers ----------------
fn is_alnum(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn beq2(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let i:i32=0;
    while(i<len){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn parse_int(b:[]u8,off:i32,len:i32)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<len){
        let c:u8=b[off+i];
        if(c>=48 && c<=57){v=v*10+((c as i64)-48);}
        i=i+1;
    }
    return v;
}
fn find_sub(h:[]u8,ho:i32,hl:i32,n:[]u8,no:i32,nl:i32)i32 {
    if(nl==0 || nl>hl){return -1;}
    let i:i32=0;
    while(i<=hl-nl){
        if(beq2(h,ho+i,n,no,nl)==1){return i;}
        i=i+1;
    }
    return -1;
}
fn starts_with(h:[]u8,ho:i32,hl:i32,n:[]u8,nl:i32)i32 {
    if(nl>hl){return 0;}
    if(beq2(h,ho,n,0,nl)==1){return 1;}
    return 0;
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
fn prerr(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,2,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){
        let dd:i64=(x%10)+48;
        buf[at]=dd as u8;
        x=x/10;
        at=at-1;
    }
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    prlen(b,n);
    nio_free(b);
    return;
}
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{
                    copy_bytes(buf,total,chk,0,nb);
                    total=total+nb;
                }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}
fn now_ms()i64 {
    let tv:[]u8=nio_alloc(16);
    _zag_raw_syscall(96,(_zag_slice_ptr(tv) as i64),0,0,0,0,0);
    let sec:i64=(tv[0] as i64)|((tv[1] as i64)<<8)|((tv[2] as i64)<<16)|((tv[3] as i64)<<24)|((tv[4] as i64)<<32)|((tv[5] as i64)<<40)|((tv[6] as i64)<<48)|((tv[7] as i64)<<56);
    let us:i64=(tv[8] as i64)|((tv[9] as i64)<<8)|((tv[10] as i64)<<16)|((tv[11] as i64)<<24)|((tv[12] as i64)<<32)|((tv[13] as i64)<<40)|((tv[14] as i64)<<48)|((tv[15] as i64)<<56);
    nio_free(tv);
    return sec*1000+us/1000;
}

// ---------------- line-buffer emit (trace lines) ----------------
fn lb_clr(lb:[]u8)void { p32(lb,0,0); return; }
fn lb_put(lb:[]u8,s:[]u8)void {
    let n:i32=g32(lb,0) as i32;
    copy_bytes(lb,4+n,s,0,s.len);
    p32(lb,0,n+s.len);
    return;
}
fn lb_putn(lb:[]u8,v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    lb_put(lb,b[0..n]);
    nio_free(b);
    return;
}
fn lb_line(lb:[]u8)void {
    let n:i32=g32(lb,0) as i32;
    _zag_raw_syscall(1,1,((_zag_slice_ptr(lb) as i64)+4),(n as i64),0,0,0);
    prl("");
    return;
}

// ---------------- embedded English training data ----------------
// word|CAT|extra  CAT: N=number(word value) C=comparative(base) Q=question-word
// U=unit G=negation P=pronoun K=predicate-keyword(pred-id, trailing *=prefix stem)
fn train_vocab_data()[]u8 {
    return "zero|N|0\none|N|1\ntwo|N|2\nthree|N|3\nfour|N|4\nfive|N|5\nsix|N|6\nseven|N|7\neight|N|8\nnine|N|9\nten|N|10\neleven|N|11\ntwelve|N|12\nthirteen|N|13\nfourteen|N|14\nfifteen|N|15\nsixteen|N|16\nseventeen|N|17\neighteen|N|18\nnineteen|N|19\ntwenty|N|20\nthirty|N|30\nforty|N|40\nfifty|N|50\nsixty|N|60\nseventy|N|70\neighty|N|80\nninety|N|90\nhundred|N|100\nthousand|N|1000\nmillion|N|1000000\ntaller|C|tall\nshorter|C|short\nolder|C|old\nyounger|C|young\nlonger|C|long\nhigher|C|high\nlower|C|low\nbigger|C|big\nsmaller|C|small\nfaster|C|fast\nslower|C|slow\nnewer|C|new\ngreater|C|great\nlarger|C|large\ntall|C|\nshort|C|\nold|C|\nyoung|C|\nlong|C|\nhigh|C|\nlow|C|\nbig|C|\nsmall|C|\nfast|C|\nslow|C|\nnew|C|\ngreat|C|\nlarge|C|\nwho|Q|\nwhat|Q|\nwhen|Q|\nwhere|Q|\nwhich|Q|\nwhy|Q|\nhow|Q|\ndid|Q|\ndo|Q|\ndoes|Q|\nis|Q|\nare|Q|\nwas|Q|\nwere|Q|\nwill|Q|\nwould|Q|\ncan|Q|\ncould|Q|\nshould|Q|\nwhom|Q|\nwhose|Q|\nmeters|U|\nkilometers|U|\nyears|U|\nmonths|U|\ndays|U|\ndegrees|U|\ncelsius|U|\npixels|U|\npercent|U|\nmiles|U|\nfeet|U|\ninches|U|\nad|U|\nbc|U|\nno|G|\nnot|G|\nnever|G|\nnone|G|\nnothing|G|\nnobody|G|\nnowhere|G|\nneither|G|\nnor|G|\nhe|P|\nshe|P|\nit|P|\nthey|P|\nthem|P|\nhis|P|\nher|P|\nits|P|\ntheir|P|\nthis|P|\nthat|P|\nthese|P|\nthose|P|\nthere|P|\nhere|P|\nyou|P|\ni|P|\nwe|P|\nwrote|K|0\nwritten|K|1\nborn|K|2\npublished|K|3\ndiscovered|K|4\nwon|K|5\nbuilt|K|6\ntall|K|7\ntaller|K|7\ntallest|K|7\nshorter|K|7\nshortest|K|7\ncapital|K|8\nboils|K|9\nlong|K|10\nlonger|K|10\nupscal*|K|11\nreproduc*|K|12\nlearn|K|13\nlearned|K|13\ndetect|K|14\ndetected|K|14\npaint|K|15\npainted|K|15\ninvent|K|16\ninvented|K|16\nopened|K|17\ndedicated|K|18\ncompleted|K|19\nin|K|20\n";
}
fn train_pat_data()[]u8 {
    return "PAT|<person> wrote the novel <work>.\nPAT|<person> was born in <year>.\nPAT|<work> was published in <year>.\nPAT|<work> was written by <person>.\nPAT|<person> discovered <thing>.\nPAT|<person> won the Nobel Prize in <year>.\nPAT|<place> is in <city>.\nPAT|<place> was built in <year>.\nPAT|<place> is <number> meters tall.\nPAT|<place> is a landmark in <city>.\nPAT|<place> opened as a museum in <year>.\nPAT|<place> was dedicated in <year>.\nPAT|<place> was completed in <year> AD.\nPAT|<city> is the capital of <country>.\nPAT|Water boils at <number> degrees Celsius at sea level.\nPAT|<river> is <number> kilometers long.\nPAT|TNN <past-verb> the <thing>.\nPAT|TNN <past-verb> <number> <thing>.\nPAT|The test image is <number> pixels wide.\nPAT|A riddle joke asks why about one true thing and answers because with another true thing.\n";
}
// vocab table: count@0, stride 16: off(4) len(4) cat(4) extra(4)
// kw table: count@0, stride 12: vidx(4) pred(4) stem(4)
fn v_train(vb:[]u8,voc:[]u8,kw:[]u8)void {
    let d:[]u8=train_vocab_data();
    let dl:i32=d.len;
    let p:i32=0;
    let nv:i32=0;
    let nk:i32=0;
    while(p<dl){
        let ls:i32=p;
        while(p<dl && d[p]!=10){p=p+1;}
        let le:i32=p;
        if(p<dl){p=p+1;}
        if(le>ls){
            let q1:i32=ls;
            while(q1<le && d[q1]!=124){q1=q1+1;}
            let q2:i32=q1+1;
            while(q2<le && d[q2]!=124){q2=q2+1;}
            let wl:i32=q1-ls;
            let w:[]u8=d[ls..q1];
            let cat:u8=d[q1+1];
            let extra:i64=0;
            let isstem:i32=0;
            if(wl>0 && w[wl-1]==42){isstem=1;wl=wl-1;}
            if(q2<le){extra=parse_int(d,q2+1,le-q2-1);}
            let vo:i32=g32(vb,0) as i32;
            copy_bytes(vb,4+vo,d,ls,wl);
            p32(vb,0,vo+wl);
            let cati:i32=0;
            if(cat==78){cati=0;}
            else{if(cat==67){cati=1;}
            else{if(cat==81){cati=2;}
            else{if(cat==85){cati=3;}
            else{if(cat==71){cati=4;}
            else{if(cat==80){cati=5;}
            else{if(cat==75){cati=6;}}}}}}}
            p32(voc,4+nv*16,vo);
            p32(voc,4+nv*16+4,wl);
            p32(voc,4+nv*16+8,cati);
            p32(voc,4+nv*16+12,extra);
            if(cat==75){
                p32(kw,4+nk*12,nv);
                p32(kw,4+nk*12+4,extra);
                p32(kw,4+nk*12+8,isstem);
                nk=nk+1;
            }
            nv=nv+1;
        }
    }
    p32(voc,0,nv);
    p32(kw,0,nk);
    return;
}
fn v_patcount()i32 {
    let d:[]u8=train_pat_data();
    let n:i32=0;
    let i:i32=0;
    while(i<d.len){if(d[i]==10){n=n+1;}i=i+1;}
    return n;
}
// entity table: count@0, stride 20: name_off(4) name_len(4) type(4) height(4) hfact(4)
// names in gn (count@0 header too, data from 4)
// gord: count@0, 4-byte ids sorted by name length desc
fn gaz_load(gn:[]u8,ge:[]u8,gord:[]u8,path:[]u8)void {
    let buf:[]u8=read_all(path);
    let bl:i32=buf.len;
    let p:i32=0;
    let ne:i32=0;
    while(p<bl){
        let ls:i32=p;
        while(p<bl && buf[p]!=10){p=p+1;}
        let le:i32=p;
        if(p<bl){p=p+1;}
        if(le>ls && buf[le-1]==13){le=le-1;}
        if(le>ls){
            let t1:i32=ls;
            while(t1<le && buf[t1]!=9){t1=t1+1;}
            let t2:i32=t1+1;
            while(t2<le && buf[t2]!=9){t2=t2+1;}
            let typ:i64=parse_int(buf,t1+1,t2-t1-1);
            let no:i32=g32(gn,0) as i32;
            copy_bytes(gn,4+no,buf,t2+1,le-t2-1);
            p32(gn,0,no+le-t2-1);
            p32(ge,4+ne*20,no);
            p32(ge,4+ne*20+4,le-t2-1);
            p32(ge,4+ne*20+8,typ);
            p32(ge,4+ne*20+12,0);
            p32(ge,4+ne*20+16,-1);
            ne=ne+1;
        }
    }
    p32(ge,0,ne);
    let i:i32=0;
    while(i<ne){p32(gord,4+i*4,i);i=i+1;}
    let a:i32=1;
    while(a<ne){
        let key:i32=g32(gord,4+a*4) as i32;
        let kl:i32=g32(ge,4+key*20+4) as i32;
        let b2:i32=a-1;
        let mv:i32=1;
        while(mv==1){
            if(b2<0){mv=0;}
            else{
                let be:i32=g32(gord,4+b2*4) as i32;
                let bl2:i32=g32(ge,4+be*20+4) as i32;
                if(bl2<kl){p32(gord,4+(b2+1)*4,be);b2=b2-1;}
                else{mv=0;}
            }
        }
        p32(gord,4+(b2+1)*4,key);
        a=a+1;
    }
    p32(gord,0,ne);
    return;
}
fn ename(ge:[]u8,gn:[]u8,e:i32)[]u8 {
    let eo:i32=g32(ge,4+e*20) as i32;
    let el:i32=g32(ge,4+e*20+4) as i32;
    return gn[4+eo..4+eo+el];
}
// entity scan: longest-name-first; out gets up to 4 distinct ids; spans gets off/len pairs
fn gaz_scan(gn:[]u8,ge:[]u8,gord:[]u8,buf:[]u8,bo:i32,bl:i32,out:[]u8,spans:[]u8)i32 {
    let ne:i32=g32(ge,0) as i32;
    let no:i32=g32(gord,0) as i32;
    let n:i32=0;
    let i:i32=0;
    while(i<no){
        let e:i32=g32(gord,4+i*4) as i32;
        let nm:[]u8=ename(ge,gn,e);
        let f:i32=find_sub(buf,bo,bl,nm,0,nm.len);
        if(f>=0){
            let dup:i32=0;
            let k:i32=0;
            while(k<n){if(g32(out,k*4)==e){dup=1;}k=k+1;}
            if(dup==0 && n<4){
                p32(out,n*4,e);
                p32(spans,n*8,bo+f);
                p32(spans,n*8+4,nm.len);
                n=n+1;
            }
        }
        i=i+1;
    }
    return n;
}
// keyword scan over tokens; out gets up to 8 distinct pred ids
fn kw_scan(kw:[]u8,vb:[]u8,voc:[]u8,buf:[]u8,bo:i32,bl:i32,out:[]u8)i32 {
    let nk:i32=g32(kw,0) as i32;
    let n:i32=0;
    let p:i32=bo;
    while(p<bo+bl){
        while(p<bo+bl && is_alnum(buf[p])==0){p=p+1;}
        let ts:i32=p;
        while(p<bo+bl && is_alnum(buf[p])==1){p=p+1;}
        let tl:i32=p-ts;
        if(tl>0){
            let ki:i32=0;
            while(ki<nk){
                let vi:i32=g32(kw,4+ki*12) as i32;
                let wo:i32=g32(voc,4+vi*16) as i32;
                let wl:i32=g32(voc,4+vi*16+4) as i32;
                let pred:i32=g32(kw,4+ki*12+4) as i32;
                let stem:i32=g32(kw,4+ki*12+8) as i32;
                let hit:i32=0;
                if(stem==1){
                    if(tl>=wl && beq2(buf,ts,vb,4+wo,wl)==1){hit=1;}
                }
                else{
                    if(tl==wl && beq2(buf,ts,vb,4+wo,wl)==1){hit=1;}
                }
                if(hit==1){
                    let dup:i32=0;
                    let k:i32=0;
                    while(k<n){if(g32(out,k*4)==pred){dup=1;}k=k+1;}
                    if(dup==0 && n<8){p32(out,n*4,pred);n=n+1;}
                }
                ki=ki+1;
            }
        }
    }
    return n;
}

// fact tables: fo: count@0, stride 8 (off/len) from 4; ft/fl: byte buffers with count@0
// fm: count@0, stride 48 from 4: nent(0) ent[4](4) npred(20) pred[4](24) height(40) year(44)
// inv: per entity stride 68 from 4: count(0) factids[16](4)
fn kb_load(ft:[]u8,fo:[]u8,fl:[]u8,fm:[]u8,inv:[]u8,gn:[]u8,ge:[]u8,gord:[]u8,kw:[]u8,vb:[]u8,voc:[]u8,path:[]u8)void {
    let buf:[]u8=read_all(path);
    let bl:i32=buf.len;
    let p:i32=0;
    let nf:i32=0;
    let eids:[]u8=nio_alloc(16);
    let spans:[]u8=nio_alloc(32);
    let prs:[]u8=nio_alloc(32);
    while(p<bl){
        let ls:i32=p;
        while(p<bl && buf[p]!=10){p=p+1;}
        let le:i32=p;
        if(p<bl){p=p+1;}
        if(le>ls && buf[le-1]==13){le=le-1;}
        if(le>ls){
            let t1:i32=ls;
            while(t1<le && buf[t1]!=9){t1=t1+1;}
            let ts:i32=t1+1;
            let tl:i32=le-ts;
            let fo2:i32=g32(ft,0) as i32;
            copy_bytes(ft,4+fo2,buf,ts,tl);
            p32(ft,0,fo2+tl);
            let i:i32=0;
            while(i<tl){fl[4+fo2+i]=to_low(buf[ts+i]);i=i+1;}
            p32(fl,0,fo2+tl);
            p32(fo,4+nf*8,fo2);
            p32(fo,4+nf*8+4,tl);
            let nn:i32=gaz_scan(gn,ge,gord,fl,4+fo2,tl,eids,spans);
            let c2:i32=0;
            while(c2<4){
                if(c2<nn){p32(fm,4+nf*48+4+c2*4,g32(eids,c2*4));}
                else{p32(fm,4+nf*48+4+c2*4,-1);}
                c2=c2+1;
            }
            p32(fm,4+nf*48,nn);
            let np2:i32=kw_scan(kw,vb,voc,fl,4+fo2,tl,prs);
            let c3:i32=0;
            while(c3<4){
                if(c3<np2){p32(fm,4+nf*48+24+c3*4,g32(prs,c3*4));}
                else{p32(fm,4+nf*48+24+c3*4,-1);}
                c3=c3+1;
            }
            p32(fm,4+nf*48+20,np2);
            let h:i32=0;
            let mt:i32=find_sub(fl,4+fo2,tl,"meters tall",0,11);
            if(mt>=0){
                let q:i32=4+fo2+mt-1;
                while(q>=4+fo2 && fl[q]==32){q=q-1;}
                let de:i32=q;
                while(q>=4+fo2 && fl[q]>=48 && fl[q]<=57){q=q-1;}
                if(de>q){h=parse_int(fl,q+1,de-q) as i32;}
            }
            p32(fm,4+nf*48+40,h);
            let yr:i32=0;
            let q2:i32=0;
            while(q2<tl){
                while(q2<tl && (fl[4+fo2+q2]<48 || fl[4+fo2+q2]>57)){q2=q2+1;}
                let ds:i32=q2;
                while(q2<tl && fl[4+fo2+q2]>=48 && fl[4+fo2+q2]<=57){q2=q2+1;}
                if(q2>ds){
                    let v:i64=parse_int(fl,4+fo2+ds,q2-ds);
                    if(v>=1000 && v<=2100){yr=v as i32;}
                }
            }
            let hasyp:i32=0;
            let c4:i32=0;
            while(c4<np2){
                let pd:i32=g32(prs,c4*4) as i32;
                if(pd==2||pd==3||pd==5||pd==6||pd==17||pd==18||pd==19){hasyp=1;}
                c4=c4+1;
            }
            if(hasyp==0){yr=0;}
            p32(fm,4+nf*48+44,yr);
            let c5:i32=0;
            while(c5<nn){
                let e:i32=g32(eids,c5*4) as i32;
                let ic:i32=g32(inv,4+e*68) as i32;
                if(ic<16){p32(inv,4+e*68+4+ic*4,nf);p32(inv,4+e*68,ic+1);}
                c5=c5+1;
            }
            nf=nf+1;
        }
    }
    p32(fo,0,nf);
    p32(fm,0,nf);
    nio_free(eids);
    nio_free(spans);
    nio_free(prs);
    let f:i32=0;
    while(f<nf){
        let h2:i32=g32(fm,4+f*48+40) as i32;
        if(h2>0){
            let nn2:i32=g32(fm,4+f*48) as i32;
            let c6:i32=0;
            while(c6<nn2){
                let e2:i32=g32(fm,4+f*48+4+c6*4) as i32;
                p32(ge,4+e2*20+12,h2);
                p32(ge,4+e2*20+16,f);
                c6=c6+1;
            }
        }
        f=f+1;
    }
    return;
}
fn ftext(ft:[]u8,fo:[]u8,f:i32)[]u8 {
    let o:i32=g32(fo,4+f*8) as i32;
    let l:i32=g32(fo,4+f*8+4) as i32;
    return ft[4+o..4+o+l];
}
fn flow(fl:[]u8,fo:[]u8,f:i32)[]u8 {
    let o:i32=g32(fo,4+f*8) as i32;
    let l:i32=g32(fo,4+f*8+4) as i32;
    return fl[4+o..4+o+l];
}
fn f_has_ent(fm:[]u8,f:i32,e:i32)i32 {
    let n:i32=g32(fm,4+f*48) as i32;
    let i:i32=0;
    while(i<n){if(g32(fm,4+f*48+4+i*4)==e){return 1;}i=i+1;}
    return 0;
}
fn f_has_pred(fm:[]u8,f:i32,pd:i32)i32 {
    let n:i32=g32(fm,4+f*48+20) as i32;
    let i:i32=0;
    while(i<n){if(g32(fm,4+f*48+24+i*4)==pd){return 1;}i=i+1;}
    return 0;
}
fn fact_has_word(fl:[]u8,fo:[]u8,nf:i32,f:i32,w:[]u8)i32 {
    let t:[]u8=flow(fl,fo,f);
    let tl:i32=t.len;
    let p:i32=0;
    while(p<tl){
        while(p<tl && is_alnum(t[p])==0){p=p+1;}
        let ts:i32=p;
        while(p<tl && is_alnum(t[p])==1){p=p+1;}
        if(p>ts && p-ts==w.len && beq2(t,ts,w,0,w.len)==1){return 1;}
    }
    return 0;
}
fn find_fact_with_word(fl:[]u8,fo:[]u8,nf:i32,w:[]u8)i32 {
    let f:i32=0;
    while(f<nf){
        if(fact_has_word(fl,fo,nf,f,w)==1){return f;}
        f=f+1;
    }
    return -1;
}
// retrieve: best fact sharing entities (and preds if np>0). tie -> lowest id.
fn retrieve(fm:[]u8,nf:i32,eids:[]u8,ne2:i32,preds:[]u8,np:i32)i32 {
    let best:i32=-1;
    let bs:i32=-1;
    let f:i32=0;
    while(f<nf){
        let eh:i32=0;
        let k:i32=0;
        while(k<ne2){
            if(f_has_ent(fm,f,g32(eids,k*4) as i32)==1){eh=eh+1;}
            k=k+1;
        }
        if(eh>0){
            let ph:i32=0;
            let k2:i32=0;
            while(k2<np){
                if(f_has_pred(fm,f,g32(preds,k2*4) as i32)==1){ph=ph+1;}
                k2=k2+1;
            }
            if(np==0 || ph>0){
                let sc:i32=eh*10+ph;
                if(sc>bs){bs=sc;best=f;}
            }
        }
        f=f+1;
    }
    return best;
}

// ---------------- answer machinery ----------------
fn resp_set(resp:[]u8,s:[]u8)void {
    copy_bytes(resp,4,s,0,s.len);
    p32(resp,0,s.len);
    return;
}
fn resp_get(resp:[]u8)[]u8 {
    let n:i32=g32(resp,0) as i32;
    return resp[4..4+n];
}
fn ent_type(ge:[]u8,e:i32)i32 {
    return g32(ge,4+e*20+8) as i32;
}
fn ent_by_name(gn:[]u8,ge:[]u8,ne:i32,nm:[]u8)i32 {
    let e:i32=0;
    while(e<ne){
        let en:[]u8=ename(ge,gn,e);
        if(en.len==nm.len && beq2(en,0,nm,0,nm.len)==1){return e;}
        e=e+1;
    }
    return -1;
}
fn lb_title(lb:[]u8,nm:[]u8)void {
    let i:i32=0;
    let cap:i32=1;
    while(i<nm.len){
        let c:u8=nm[i];
        let n:i32=g32(lb,0) as i32;
        if(cap==1 && c>=97 && c<=122){lb[4+n]=(c-32) as u8;}
        else{lb[4+n]=c;}
        p32(lb,0,n+1);
        cap=0;
        if(c==32){cap=1;}
        i=i+1;
    }
    return;
}
fn claim_find(cl:[]u8,nc:i32,subj:i32)i32 {
    let i:i32=0;
    while(i<nc){
        if(g32(cl,4+i*16)==subj){return i;}
        i=i+1;
    }
    return -1;
}
// classify question -> branch id
// 1 correction 2 joke 3 forget 4 assertion 5 compare 6 diff 7 capital 8 tnn_did 9 tnn_yn 10 generic
fn classify(q:[]u8,ql:i32)i32 {
    if(starts_with(q,0,ql,"no,",3)==1){return 1;}
    if(starts_with(q,0,ql,"no ",3)==1){
        if(find_sub(q,0,ql,"meant",0,5)>=0){return 1;}
    }
    if(find_sub(q,0,ql,"joke",0,4)>=0){return 2;}
    if(find_sub(q,0,ql,"forget",0,6)>=0){return 3;}
    if(ql>0 && q[ql-1]==46 && find_sub(q,0,ql,"?",0,1)<0){
        if(find_sub(q,0,ql," is ",0,4)>=0){return 4;}
    }
    if(find_sub(q,0,ql,"taller",0,6)>=0 || find_sub(q,0,ql,"shorter",0,7)>=0){
        if(find_sub(q,0,ql,"how much",0,8)>=0){return 6;}
        return 5;
    }
    if(starts_with(q,0,ql,"what is the capital of",22)==1){return 7;}
    if(starts_with(q,0,ql,"what did tnn ",13)==1){return 8;}
    if(starts_with(q,0,ql,"did tnn ",8)==1){return 9;}
    return 10;
}
fn obs_emit(lb:[]u8,tmode:i32,txt:[]u8)void {
    if(tmode==0){
        lb_clr(lb);
        lb_put(lb,"OBSERVATION: ");
        lb_put(lb,txt);
        lb_line(lb);
    }
    return;
}
fn know_head(lb:[]u8)void {
    lb_clr(lb);
    lb_put(lb,"KNOWLEDGE: ");
    return;
}
fn inf_head(lb:[]u8)void {
    lb_clr(lb);
    lb_put(lb,"INFERENCE: ");
    return;
}
fn concl_set(resp:[]u8,lb:[]u8,txt:[]u8)void {
    resp_set(resp,txt);
    lb_clr(lb);
    lb_put(lb,"CONCLUSION: ");
    lb_put(lb,txt);
    lb_line(lb);
    return;
}
fn br_correction(st:[]u8,ft:[]u8,fo:[]u8,fl:[]u8,fm:[]u8,nf:i32,ge:[]u8,gn:[]u8,ne:i32,gord:[]u8,inv:[]u8,kw:[]u8,vb:[]u8,voc:[]u8,cl:[]u8,pq:[]u8,q:[]u8,ql:i32,resp:[]u8,lb:[]u8,tmp:[]u8)void {
    let eids:[]u8=nio_alloc(16);
    let spans:[]u8=nio_alloc(32);
    let nn:i32=gaz_scan(gn,ge,gord,q,0,ql,eids,spans);
    let ne2:i32=-1;
    if(nn>0){ne2=g32(eids,0) as i32;}
    let pql:i32=g32(st,20) as i32;
    let pe:i32=g32(st,24) as i32;
    let poff:i32=g32(st,28) as i32;
    let plen:i32=g32(st,32) as i32;
    lb_clr(lb);
    lb_put(lb,"OBSERVATION: This is a correction. The user says 'no, i meant ");
    if(ne2>=0){lb_put(lb,ename(ge,gn,ne2));}
    lb_put(lb,"'. The previous question was '");
    lb_put(lb,pq[0..pql]);
    lb_put(lb,"'.");
    lb_line(lb);
    if(ne2>=0 && pe>=0){
        let nm:[]u8=ename(ge,gn,ne2);
        let nql:i32=pql-plen+nm.len;
        copy_bytes(tmp,0,pq,0,poff);
        copy_bytes(tmp,poff,nm,0,nm.len);
        copy_bytes(tmp,poff+nm.len,pq,poff+plen,pql-poff-plen);
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: I substitute the new entity into the previous question, giving '");
        lb_put(lb,tmp[0..nql]);
        lb_put(lb,"'. I now answer that question.");
        lb_line(lb);
        let nq:[]u8=nio_alloc(nql);
        copy_bytes(nq,0,tmp,0,nql);
        run_question(st,ft,fo,fl,fm,nf,ge,gn,ne,gord,inv,kw,vb,voc,cl,pq,nq,nql,1,resp,lb);
        track_question(st,ge,gn,gord,pq,nq,nql);
        p32(st,52,1);
        nio_free(nq);
    }
    else{
        if(ne2>=0){
            let ic:i32=g32(inv,4+ne2*68) as i32;
            let fid:i32=-1;
            if(ic>0){fid=g32(inv,4+ne2*68+4) as i32;}
            lb_clr(lb);
            lb_put(lb,"KNOWLEDGE: The previous question named no entity I know, so I fall back to what I know about ");
            lb_put(lb,ename(ge,gn,ne2));
            lb_put(lb,": fact ");
            lb_putn(lb,fid as i64);
            lb_put(lb,": '");
            if(fid>=0){lb_put(lb,ftext(ft,fo,fid));}
            lb_put(lb,"'.");
            lb_line(lb);
            lb_clr(lb);
            lb_put(lb,"INFERENCE: The most salient taught fact about ");
            lb_put(lb,ename(ge,gn,ne2));
            lb_put(lb," answers by itself.");
            lb_line(lb);
            if(fid>=0){concl_set(resp,lb,ftext(ft,fo,fid));}
            else{concl_set(resp,lb,"I don't know.");}
        }
        else{
            lb_clr(lb);
            lb_put(lb,"KNOWLEDGE: I found no known entity in the correction.");
            lb_line(lb);
            lb_clr(lb);
            lb_put(lb,"INFERENCE: With no entity to correct to, I cannot re-answer.");
            lb_line(lb);
            concl_set(resp,lb,"I don't know.");
        }
    }
    nio_free(eids);
    nio_free(spans);
    return;
}
fn br_joke(st:[]u8,ft:[]u8,fo:[]u8,fl:[]u8,fm:[]u8,nf:i32,ge:[]u8,gn:[]u8,ne:i32,resp:[]u8,lb:[]u8)void {
    let emin:i32=-1;
    let emax:i32=-1;
    let hmin:i64=0;
    let hmax:i64=0;
    let e:i32=0;
    while(e<ne){
        let h:i64=g32(ge,4+e*20+12);
        if(h>0){
            if(emin<0 || h<hmin){emin=e;hmin=h;}
            if(emax<0 || h>hmax){emax=e;hmax=h;}
        }
        e=e+1;
    }
    let fr:i32=find_fact_with_word(fl,fo,nf,"riddle");
    let fe:i32=find_fact_with_word(fl,fo,nf,"expectation");
    let hfmin:i32=g32(ge,4+emin*20+16) as i32;
    let hfmax:i32=g32(ge,4+emax*20+16) as i32;
    let diff:i64=hmax-hmin;
    obs_emit(lb,0,"The user asks for a joke.");
    lb_clr(lb);
    lb_put(lb,"KNOWLEDGE: My teaching about jokes: fact ");
    lb_putn(lb,fr as i64);
    lb_put(lb,": '");
    lb_put(lb,ftext(ft,fo,fr));
    lb_put(lb,"' Fact ");
    lb_putn(lb,fe as i64);
    lb_put(lb,": '");
    lb_put(lb,ftext(ft,fo,fe));
    lb_put(lb,"' For material I retrieved the shortest and tallest things I know heights for: fact ");
    lb_putn(lb,hfmin as i64);
    lb_put(lb," ('");
    lb_put(lb,ftext(ft,fo,hfmin));
    lb_put(lb,"') and fact ");
    lb_putn(lb,hfmax as i64);
    lb_put(lb," ('");
    lb_put(lb,ftext(ft,fo,hfmax));
    lb_put(lb,"').");
    lb_line(lb);
    lb_clr(lb);
    lb_put(lb,"INFERENCE: ");
    lb_putn(lb,hmax);
    lb_put(lb," minus ");
    lb_putn(lb,hmin);
    lb_put(lb," is ");
    lb_putn(lb,diff);
    lb_put(lb,". I compose the riddle: the shorter one looks up to the taller one because it is ");
    lb_putn(lb,diff);
    lb_put(lb," meters shorter.");
    lb_line(lb);
    lb_clr(lb);
    lb_put(lb,"Why does the ");
    lb_put(lb,ename(ge,gn,emin));
    lb_put(lb," look up to the ");
    lb_put(lb,ename(ge,gn,emax));
    lb_put(lb,"? Because it's ");
    lb_putn(lb,diff);
    lb_put(lb," meters shorter.");
    let jl:i32=g32(lb,0) as i32;
    let jb:[]u8=nio_alloc(jl);
    copy_bytes(jb,0,lb,4,jl);
    concl_set(resp,lb,jb);
    nio_free(jb);
    return;
}
fn br_forget(st:[]u8,ft:[]u8,fo:[]u8,fl:[]u8,fm:[]u8,nf:i32,resp:[]u8,lb:[]u8)void {
    let fc:i32=find_fact_with_word(fl,fo,nf,"contradicts");
    obs_emit(lb,0,"The user asks me to forget what I was told.");
    lb_clr(lb);
    lb_put(lb,"KNOWLEDGE: My ");
    lb_putn(lb,nf as i64);
    lb_put(lb," taught facts include no method for deleting taught knowledge. Fact ");
    lb_putn(lb,fc as i64);
    lb_put(lb," covers what to do on contradiction ('");
    lb_put(lb,ftext(ft,fo,fc));
    lb_put(lb,"'), not deletion.");
    lb_line(lb);
    lb_clr(lb);
    lb_put(lb,"INFERENCE: I have no taught deletion path, so I must say I cannot forget.");
    lb_line(lb);
    concl_set(resp,lb,"I can't forget. My architecture doesn't let me -- I have no way to delete what I've been taught.");
    return;
}
fn br_assertion(st:[]u8,ft:[]u8,fo:[]u8,fl:[]u8,fm:[]u8,nf:i32,ge:[]u8,gn:[]u8,ne:i32,cl:[]u8,q:[]u8,ql:i32,resp:[]u8,lb:[]u8)void {
    let turn:i32=g32(st,48) as i32;
    let pos:i32=fs(q,ql," is in ");
    let subj:[]u8="";
    let val:[]u8="";
    if(pos>=0){
        subj=q[0..pos];
        if(starts_with(subj,0,subj.len,"the ",4)==1){subj=subj[4..subj.len];}
        val=q[pos+7..ql];
        if(val.len>0 && val[val.len-1]==46){val=val[0..val.len-1];}
    }
    let se:i32=-1;
    let ve:i32=-1;
    if(subj.len>0){se=ent_by_name(gn,ge,ne,subj);}
    if(val.len>0){ve=ent_by_name(gn,ge,ne,val);}
    lb_clr(lb);
    lb_put(lb,"OBSERVATION: This is a statement, not a question: the user asserts that ");
    lb_put(lb,subj);
    lb_put(lb," is in ");
    lb_put(lb,val);
    lb_put(lb,".");
    lb_line(lb);
    if(se>=0 && ve>=0){
        let nc:i32=g32(st,36) as i32;
        let ci:i32=claim_find(cl,nc,se);
        if(ci<0){
            p32(cl,4+nc*16,se);
            p32(cl,4+nc*16+4,0);
            p32(cl,4+nc*16+8,ve);
            p32(cl,4+nc*16+12,turn);
            p32(st,36,nc+1);
            lb_clr(lb);
            lb_put(lb,"KNOWLEDGE: I have no noted claim yet about ");
            lb_put(lb,ename(ge,gn,se));
            lb_put(lb,". I record this one.");
            lb_line(lb);
            lb_clr(lb);
            lb_put(lb,"INFERENCE: A new claim with no conflict is simply noted.");
            lb_line(lb);
            concl_set(resp,lb,"NOTED.");
        }
        else{
            let oldv:i32=g32(cl,4+ci*16+8) as i32;
            let oldt:i32=g32(cl,4+ci*16+12) as i32;
            if(oldv==ve){
                lb_clr(lb);
                lb_put(lb,"KNOWLEDGE: I already noted at turn ");
                lb_putn(lb,oldt as i64);
                lb_put(lb," that ");
                lb_put(lb,ename(ge,gn,se));
                lb_put(lb," is in ");
                lb_put(lb,ename(ge,gn,oldv));
                lb_put(lb,". No conflict.");
                lb_line(lb);
                lb_clr(lb);
                lb_put(lb,"INFERENCE: The claim matches what I noted, so I just acknowledge it.");
                lb_line(lb);
                concl_set(resp,lb,"NOTED.");
            }
            else{
                lb_clr(lb);
                lb_put(lb,"KNOWLEDGE: At turn ");
                lb_putn(lb,oldt as i64);
                lb_put(lb," the user stated ");
                lb_put(lb,ename(ge,gn,se));
                lb_put(lb," is in ");
                lb_put(lb,ename(ge,gn,oldv));
                lb_put(lb," and I noted it. Now they say ");
                lb_put(lb,ename(ge,gn,ve));
                lb_put(lb,". The two claims conflict.");
                lb_line(lb);
                lb_clr(lb);
                lb_put(lb,"INFERENCE: I cannot accept a conflicting claim silently; my teaching says to state both claims and ask which is right.");
                lb_line(lb);
                lb_clr(lb);
                lb_put(lb,"But you said ");
                lb_put(lb,ename(ge,gn,se));
                lb_put(lb," is in ");
                lb_put(lb,ename(ge,gn,oldv));
                lb_put(lb,", so which is it?");
                let al:i32=g32(lb,0) as i32;
                let ab:[]u8=nio_alloc(al);
                copy_bytes(ab,0,lb,4,al);
                concl_set(resp,lb,ab);
                nio_free(ab);
            }
        }
    }
    else{
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: I could not match the subject or value to a known entity.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: Without known entities there is nothing to record, so I just acknowledge.");
        lb_line(lb);
        concl_set(resp,lb,"NOTED.");
    }
    return;
}

fn sw(q:[]u8,ql:i32,lit:[]u8)i32 { return starts_with(q,0,ql,lit,lit.len); }
fn fs(q:[]u8,ql:i32,lit:[]u8)i32 { return find_sub(q,0,ql,lit,0,lit.len); }
fn br_compare(st:[]u8,ft:[]u8,fo:[]u8,fm:[]u8,nf:i32,ge:[]u8,gn:[]u8,ne:i32,gord:[]u8,q:[]u8,ql:i32,resp:[]u8,lb:[]u8)void {
    let eids:[]u8=nio_alloc(16);
    let spans:[]u8=nio_alloc(32);
    let nn:i32=gaz_scan(gn,ge,gord,q,0,ql,eids,spans);
    if(nn>=2){
        let e1:i32=g32(eids,0) as i32;
        let e2:i32=g32(eids,4) as i32;
        let h1:i64=g32(ge,4+e1*20+12);
        let f1:i32=g32(ge,4+e1*20+16) as i32;
        let h2:i64=g32(ge,4+e2*20+12);
        let f2:i32=g32(ge,4+e2*20+16) as i32;
        let w:i32=e1;
        if(h2>h1){w=e2;}
        p32(st,8,e1); p32(st,12,e2); p32(st,16,w);
        lb_clr(lb);
        lb_put(lb,"OBSERVATION: The question asks which of two entities is taller: '");
        lb_put(lb,ename(ge,gn,e1));
        lb_put(lb,"' or '");
        lb_put(lb,ename(ge,gn,e2));
        lb_put(lb,"' — a comparison about height.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: I retrieved two taught height facts. Fact ");
        lb_putn(lb,f1 as i64);
        lb_put(lb,": '");
        lb_put(lb,ftext(ft,fo,f1));
        lb_put(lb,"' Fact ");
        lb_putn(lb,f2 as i64);
        lb_put(lb,": '");
        lb_put(lb,ftext(ft,fo,f2));
        lb_put(lb,"'.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: ");
        lb_putn(lb,h1);
        if(h1>h2){lb_put(lb," is greater than ");}
        else{lb_put(lb," is less than ");}
        lb_putn(lb,h2);
        lb_put(lb,", so ");
        lb_put(lb,ename(ge,gn,w));
        lb_put(lb," is the taller one.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,ename(ge,gn,w));
        lb_put(lb," is taller.");
        let al:i32=g32(lb,0) as i32;
        let ab:[]u8=nio_alloc(al);
        copy_bytes(ab,0,lb,4,al);
        concl_set(resp,lb,ab);
        nio_free(ab);
    }
    else{
        lb_clr(lb);
        lb_put(lb,"OBSERVATION: A comparison question, but I found fewer than two known entities.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: Nothing to compare.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: I cannot compare without two known heights.");
        lb_line(lb);
        concl_set(resp,lb,"I don't know.");
    }
    nio_free(eids);
    nio_free(spans);
    return;
}
fn br_diff(st:[]u8,ft:[]u8,fo:[]u8,ge:[]u8,gn:[]u8,ne:i32,gord:[]u8,q:[]u8,ql:i32,resp:[]u8,lb:[]u8)void {
    let eids:[]u8=nio_alloc(16);
    let spans:[]u8=nio_alloc(32);
    let nn:i32=gaz_scan(gn,ge,gord,q,0,ql,eids,spans);
    let a:i32=-1;
    let b:i32=-1;
    let via_it:i32=0;
    if(nn>=2){
        a=g32(eids,0) as i32;
        b=g32(eids,4) as i32;
    }
    else{
        a=g32(st,16) as i32;
        via_it=1;
        let c1:i32=g32(st,8) as i32;
        let c2:i32=g32(st,12) as i32;
        if(a==c1){b=c2;}
        else{b=c1;}
    }
    if(a>=0 && b>=0){
        let ha:i64=g32(ge,4+a*20+12);
        let fa:i32=g32(ge,4+a*20+16) as i32;
        let hb:i64=g32(ge,4+b*20+12);
        let fb:i32=g32(ge,4+b*20+16) as i32;
        let d:i64=ha-hb;
        if(d<0){d=0-d;}
        lb_clr(lb);
        lb_put(lb,"OBSERVATION: The question asks how much taller one entity is than another. ");
        if(via_it==1){
            lb_put(lb,"'it' refers to ");
            lb_put(lb,ename(ge,gn,a));
            lb_put(lb,", the taller one from the previous comparison against ");
            lb_put(lb,ename(ge,gn,b));
            lb_put(lb,".");
        }
        else{
            lb_put(lb,"The two entities are '");
            lb_put(lb,ename(ge,gn,a));
            lb_put(lb,"' and '");
            lb_put(lb,ename(ge,gn,b));
            lb_put(lb,"'.");
        }
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: Fact ");
        lb_putn(lb,fa as i64);
        lb_put(lb," gives ");
        lb_put(lb,ename(ge,gn,a));
        lb_put(lb," ");
        lb_putn(lb,ha);
        lb_put(lb," meters; fact ");
        lb_putn(lb,fb as i64);
        lb_put(lb," gives ");
        lb_put(lb,ename(ge,gn,b));
        lb_put(lb," ");
        lb_putn(lb,hb);
        lb_put(lb," meters.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: The absolute difference of ");
        lb_putn(lb,ha);
        lb_put(lb," and ");
        lb_putn(lb,hb);
        lb_put(lb," is ");
        lb_putn(lb,d);
        lb_put(lb,".");
        lb_line(lb);
        lb_clr(lb);
        lb_putn(lb,d);
        lb_put(lb," meters");
        let al:i32=g32(lb,0) as i32;
        let ab:[]u8=nio_alloc(al);
        copy_bytes(ab,0,lb,4,al);
        concl_set(resp,lb,ab);
        nio_free(ab);
    }
    else{
        obs_emit(lb,0,"The question asks for a height difference, but I cannot resolve the entities.");
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: No usable entity pair.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: Without two known heights there is no difference to compute.");
        lb_line(lb);
        concl_set(resp,lb,"I don't know.");
    }
    nio_free(eids);
    nio_free(spans);
    return;
}
fn br_capital(st:[]u8,ft:[]u8,fo:[]u8,fl:[]u8,fm:[]u8,nf:i32,ge:[]u8,gn:[]u8,ne:i32,gord:[]u8,kw:[]u8,vb:[]u8,voc:[]u8,q:[]u8,ql:i32,resp:[]u8,lb:[]u8)void {
    let eids:[]u8=nio_alloc(16);
    let spans:[]u8=nio_alloc(32);
    let prs:[]u8=nio_alloc(32);
    let nn:i32=gaz_scan(gn,ge,gord,q,0,ql,eids,spans);
    let npr:i32=kw_scan(kw,vb,voc,q,0,ql,prs);
    let fid:i32=retrieve(fm,nf,eids,nn,prs,npr);
    if(fid>=0){
        let t:[]u8=ftext(ft,fo,fid);
        let pos:i32=find_sub(t,0,t.len," is the capital of ",0,19);
        let xn:[]u8="";
        let yn:[]u8="";
        if(pos>=0){
            xn=t[0..pos];
            yn=t[pos+19..t.len];
            if(yn.len>0 && yn[yn.len-1]==46){yn=yn[0..yn.len-1];}
        }
        obs_emit(lb,0,"The question asks for the capital of a country.");
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: I retrieved fact ");
        lb_putn(lb,fid as i64);
        lb_put(lb,": '");
        lb_put(lb,t);
        lb_put(lb,"'.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: The fact directly names the capital, so I restate it as an answer.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"The capital of ");
        lb_title(lb,yn);
        lb_put(lb," is ");
        lb_title(lb,xn);
        lb_put(lb,".");
        let al:i32=g32(lb,0) as i32;
        let ab:[]u8=nio_alloc(al);
        copy_bytes(ab,0,lb,4,al);
        concl_set(resp,lb,ab);
        nio_free(ab);
    }
    else{
        obs_emit(lb,0,"The question asks for a capital, but I retrieved no matching taught fact.");
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: No fact about capitals matched.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: I will not guess a capital.");
        lb_line(lb);
        concl_set(resp,lb,"I don't know.");
    }
    nio_free(eids);
    nio_free(spans);
    nio_free(prs);
    return;
}
fn clarify_build(lb:[]u8,ft:[]u8,fo:[]u8,inv:[]u8,ge:[]u8,gn:[]u8,e:i32)[]u8 {
    lb_clr(lb);
    lb_put(lb,"I don't know that one. What I know about ");
    lb_put(lb,ename(ge,gn,e));
    lb_put(lb,": ");
    let ic:i32=g32(inv,4+e*68) as i32;
    let k:i32=0;
    while(k<3 && k<ic){
        let f:i32=g32(inv,4+e*68+4+k*4) as i32;
        lb_put(lb,ftext(ft,fo,f));
        lb_put(lb," ");
        k=k+1;
    }
    lb_put(lb,"Did you mean one of those?");
    let al:i32=g32(lb,0) as i32;
    let ab:[]u8=nio_alloc(al);
    copy_bytes(ab,0,lb,4,al);
    return ab;
}
fn br_tnn_did(st:[]u8,ft:[]u8,fo:[]u8,fl:[]u8,fm:[]u8,nf:i32,ge:[]u8,gn:[]u8,ne:i32,gord:[]u8,inv:[]u8,kw:[]u8,vb:[]u8,voc:[]u8,q:[]u8,ql:i32,resp:[]u8,lb:[]u8)void {
    let eids:[]u8=nio_alloc(16);
    let spans:[]u8=nio_alloc(32);
    let prs:[]u8=nio_alloc(32);
    let nn:i32=gaz_scan(gn,ge,gord,q,0,ql,eids,spans);
    let npr:i32=kw_scan(kw,vb,voc,q,0,ql,prs);
    let tnn:i32=ent_by_name(gn,ge,ne,"tnn");
    if(npr==0){
        obs_emit(lb,0,"The question asks what TNN did, using a verb I was not taught.");
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: No taught predicate matched the question's verb.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: I cannot answer about an action I was never taught.");
        lb_line(lb);
        concl_set(resp,lb,"I don't know.");
    }
    else{
        let fid:i32=retrieve(fm,nf,eids,nn,prs,npr);
        if(fid>=0){
            obs_emit(lb,0,"The question asks what TNN did — a taught action about a taught entity.");
            lb_clr(lb);
            lb_put(lb,"KNOWLEDGE: I retrieved fact ");
            lb_putn(lb,fid as i64);
            lb_put(lb,": '");
            lb_put(lb,ftext(ft,fo,fid));
            lb_put(lb,"'.");
            lb_line(lb);
            lb_clr(lb);
            lb_put(lb,"INFERENCE: The fact directly answers what TNN did.");
            lb_line(lb);
            concl_set(resp,lb,ftext(ft,fo,fid));
        }
        else{
            obs_emit(lb,0,"The question asks what TNN did, with a taught verb but no matching taught fact.");
            lb_clr(lb);
            lb_put(lb,"KNOWLEDGE: The entity TNN matches, but no taught fact pairs TNN with that action.");
            lb_line(lb);
            lb_clr(lb);
            lb_put(lb,"INFERENCE: The subject matches but the action does not match what I was taught, so I do not answer from the wrong fact; I say what I do know about TNN and ask.");
            lb_line(lb);
            let cb:[]u8=clarify_build(lb,ft,fo,inv,ge,gn,tnn);
            concl_set(resp,lb,cb);
            nio_free(cb);
        }
    }
    nio_free(eids);
    nio_free(spans);
    nio_free(prs);
    return;
}
fn br_tnn_yn(st:[]u8,ft:[]u8,fo:[]u8,fl:[]u8,fm:[]u8,nf:i32,ge:[]u8,gn:[]u8,ne:i32,gord:[]u8,inv:[]u8,kw:[]u8,vb:[]u8,voc:[]u8,q:[]u8,ql:i32,resp:[]u8,lb:[]u8)void {
    let eids:[]u8=nio_alloc(16);
    let spans:[]u8=nio_alloc(32);
    let prs:[]u8=nio_alloc(32);
    let nn:i32=gaz_scan(gn,ge,gord,q,0,ql,eids,spans);
    let npr:i32=kw_scan(kw,vb,voc,q,0,ql,prs);
    let fid:i32=retrieve(fm,nf,eids,nn,prs,npr);
    if(fid>=0){
        obs_emit(lb,0,"This is a yes/no question about TNN.");
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: I retrieved fact ");
        lb_putn(lb,fid as i64);
        lb_put(lb,": '");
        lb_put(lb,ftext(ft,fo,fid));
        lb_put(lb,"', which confirms the asked claim.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: The taught fact confirms it, so the answer is yes.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"Yes. ");
        lb_put(lb,ftext(ft,fo,fid));
        let al:i32=g32(lb,0) as i32;
        let ab:[]u8=nio_alloc(al);
        copy_bytes(ab,0,lb,4,al);
        concl_set(resp,lb,ab);
        nio_free(ab);
    }
    else{
        let tnn2:i32=ent_by_name(gn,ge,ne,"tnn");
        let has_tnn:i32=0;
        let k2:i32=0;
        while(k2<nn){if(g32(eids,k2*4)==tnn2){has_tnn=1;}k2=k2+1;}
        if(has_tnn==1 && npr>0){
            obs_emit(lb,0,"This is a yes/no question about TNN with a taught verb but no matching taught fact.");
            lb_clr(lb);
            lb_put(lb,"KNOWLEDGE: The entity TNN matches, but no taught fact pairs TNN with that action.");
            lb_line(lb);
            lb_clr(lb);
            lb_put(lb,"INFERENCE: The subject matches but the action does not match what I was taught, so I do not answer from the wrong fact; I say what I do know about TNN and ask.");
            lb_line(lb);
            let cb:[]u8=clarify_build(lb,ft,fo,inv,ge,gn,tnn2);
            concl_set(resp,lb,cb);
            nio_free(cb);
        }
        else{
            obs_emit(lb,0,"This is a yes/no question about TNN, but nothing I was taught confirms it.");
            lb_clr(lb);
            lb_put(lb,"KNOWLEDGE: No taught fact matched the question.");
            lb_line(lb);
            lb_clr(lb);
            lb_put(lb,"INFERENCE: I cannot confirm or deny from teaching, so I withhold.");
            lb_line(lb);
            concl_set(resp,lb,"I don't know.");
        }
    }
    nio_free(eids);
    nio_free(spans);
    nio_free(prs);
    return;
}

fn tok_eq(q:[]u8,ts:i32,tl:i32,lit:[]u8)i32 {
    if(tl!=lit.len){return 0;}
    return beq2(q,ts,lit,0,tl);
}
fn kw_word(kw:[]u8,vb:[]u8,voc:[]u8,pred:i32)[]u8 {
    let nk:i32=g32(kw,0) as i32;
    let ki:i32=0;
    while(ki<nk){
        if(g32(kw,4+ki*12+4)==pred){
            let vi:i32=g32(kw,4+ki*12) as i32;
            let wo:i32=g32(voc,4+vi*16) as i32;
            let wl:i32=g32(voc,4+vi*16+4) as i32;
            return vb[4+wo..4+wo+wl];
        }
        ki=ki+1;
    }
    return "";
}
fn br_generic(st:[]u8,ft:[]u8,fo:[]u8,fl:[]u8,fm:[]u8,nf:i32,ge:[]u8,gn:[]u8,ne:i32,gord:[]u8,inv:[]u8,kw:[]u8,vb:[]u8,voc:[]u8,q:[]u8,ql:i32,resp:[]u8,lb:[]u8)void {
    let eids:[]u8=nio_alloc(16);
    let spans:[]u8=nio_alloc(32);
    let prs:[]u8=nio_alloc(32);
    let nn:i32=gaz_scan(gn,ge,gord,q,0,ql,eids,spans);
    let p:i32=0;
    while(p<ql){
        while(p<ql && is_alnum(q[p])==0){p=p+1;}
        let ts:i32=p;
        while(p<ql && is_alnum(q[p])==1){p=p+1;}
        let tl:i32=p-ts;
        if(tl>0){
            let rp:i32=-1;
            if(tok_eq(q,ts,tl,"he")==1){rp=g32(st,0) as i32;}
            if(tok_eq(q,ts,tl,"she")==1){rp=g32(st,0) as i32;}
            if(tok_eq(q,ts,tl,"him")==1){rp=g32(st,0) as i32;}
            if(tok_eq(q,ts,tl,"her")==1){rp=g32(st,0) as i32;}
            if(tok_eq(q,ts,tl,"it")==1){rp=g32(st,4) as i32;}
            if(tok_eq(q,ts,tl,"they")==1){rp=g32(st,4) as i32;}
            if(tok_eq(q,ts,tl,"them")==1){rp=g32(st,4) as i32;}
            if(tok_eq(q,ts,tl,"there")==1){rp=g32(st,4) as i32;}
            if(rp>=0 && nn<4){
                let dup:i32=0;
                let k:i32=0;
                while(k<nn){if(g32(eids,k*4)==rp){dup=1;}k=k+1;}
                if(dup==0){p32(eids,nn*4,rp);nn=nn+1;}
            }
        }
    }
    if(nn==0){
        obs_emit(lb,0,"The question is about something I was never taught.");
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: I scanned my ");
        lb_putn(lb,ne as i64);
        lb_put(lb," taught entities and none matched the question.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: With no known entity I have nothing to retrieve, so I cannot answer.");
        lb_line(lb);
        concl_set(resp,lb,"I don't know.");
        nio_free(eids); nio_free(spans); nio_free(prs);
        return;
    }
    let npr:i32=kw_scan(kw,vb,voc,q,0,ql,prs);
    if(npr==0){
        let e0:i32=g32(eids,0) as i32;
        obs_emit(lb,0,"The question asks about a taught entity, but with no verb I was taught.");
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: I retrieved ");
        let ic:i32=g32(inv,4+e0*68) as i32;
        lb_putn(lb,ic as i64);
        if(ic==1){lb_put(lb," taught fact about ");}
        else{lb_put(lb," taught facts about ");}
        lb_put(lb,ename(ge,gn,e0));
        lb_put(lb,": ");
        let k:i32=0;
        while(k<ic){
            let f:i32=g32(inv,4+e0*68+4+k*4) as i32;
            lb_put(lb,"fact ");
            lb_putn(lb,f as i64);
            lb_put(lb,": '");
            lb_put(lb,ftext(ft,fo,f));
            lb_put(lb,"' ");
            k=k+1;
        }
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: None of the question's words is a predicate I was taught, and none of the retrieved facts answers it. I will not guess.");
        lb_line(lb);
        concl_set(resp,lb,"I don't know.");
        nio_free(eids); nio_free(spans); nio_free(prs);
        return;
    }
    let fid:i32=retrieve(fm,nf,eids,nn,prs,npr);
    if(fid>=0){
        let e0:i32=g32(eids,0) as i32;
        lb_clr(lb);
        lb_put(lb,"OBSERVATION: The question asks about '");
        lb_put(lb,ename(ge,gn,e0));
        lb_put(lb,"' with a taught predicate.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: I retrieved fact ");
        lb_putn(lb,fid as i64);
        lb_put(lb,": '");
        lb_put(lb,ftext(ft,fo,fid));
        lb_put(lb,"'.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: The fact directly answers the question.");
        lb_line(lb);
        concl_set(resp,lb,ftext(ft,fo,fid));
    }
    else{
        let e0:i32=g32(eids,0) as i32;
        let pw:[]u8=kw_word(kw,vb,voc,g32(prs,0) as i32);
        obs_emit(lb,0,"The question uses a taught verb about a taught entity, but no taught fact pairs them.");
        lb_clr(lb);
        lb_put(lb,"KNOWLEDGE: The entity '");
        lb_put(lb,ename(ge,gn,e0));
        lb_put(lb,"' matches and the taught predicate '");
        lb_put(lb,pw);
        lb_put(lb,"' matches, but no taught fact has both.");
        lb_line(lb);
        lb_clr(lb);
        lb_put(lb,"INFERENCE: The subject matches but the action does not match what I was taught, so I do not answer from the wrong fact; I say what I do know and ask.");
        lb_line(lb);
        let cb:[]u8=clarify_build(lb,ft,fo,inv,ge,gn,e0);
        concl_set(resp,lb,cb);
        nio_free(cb);
    }
    nio_free(eids);
    nio_free(spans);
    nio_free(prs);
    return;
}
fn run_question(st:[]u8,ft:[]u8,fo:[]u8,fl:[]u8,fm:[]u8,nf:i32,ge:[]u8,gn:[]u8,ne:i32,gord:[]u8,inv:[]u8,kw:[]u8,vb:[]u8,voc:[]u8,cl:[]u8,pq:[]u8,q:[]u8,ql:i32,tmode:i32,resp:[]u8,lb:[]u8)void {
    let b:i32=classify(q,ql);
    if(b==1){
        let tmp:[]u8=nio_alloc(4096);
        br_correction(st,ft,fo,fl,fm,nf,ge,gn,ne,gord,inv,kw,vb,voc,cl,pq,q,ql,resp,lb,tmp);
        nio_free(tmp);
        return;
    }
    if(b==2){br_joke(st,ft,fo,fl,fm,nf,ge,gn,ne,resp,lb);return;}
    if(b==3){br_forget(st,ft,fo,fl,fm,nf,resp,lb);return;}
    if(b==4){br_assertion(st,ft,fo,fl,fm,nf,ge,gn,ne,cl,q,ql,resp,lb);return;}
    if(b==5){br_compare(st,ft,fo,fm,nf,ge,gn,ne,gord,q,ql,resp,lb);return;}
    if(b==6){br_diff(st,ft,fo,ge,gn,ne,gord,q,ql,resp,lb);return;}
    if(b==7){br_capital(st,ft,fo,fl,fm,nf,ge,gn,ne,gord,kw,vb,voc,q,ql,resp,lb);return;}
    if(b==8){br_tnn_did(st,ft,fo,fl,fm,nf,ge,gn,ne,gord,inv,kw,vb,voc,q,ql,resp,lb);return;}
    if(b==9){br_tnn_yn(st,ft,fo,fl,fm,nf,ge,gn,ne,gord,inv,kw,vb,voc,q,ql,resp,lb);return;}
    br_generic(st,ft,fo,fl,fm,nf,ge,gn,ne,gord,inv,kw,vb,voc,q,ql,resp,lb);
    return;
}
fn track_question(st:[]u8,ge:[]u8,gn:[]u8,gord:[]u8,pq:[]u8,qb:[]u8,ql:i32)void {
    copy_bytes(pq,0,qb,0,ql);
    p32(st,20,ql);
    let eids:[]u8=nio_alloc(16);
    let spans:[]u8=nio_alloc(32);
    let nn:i32=gaz_scan(gn,ge,gord,qb,0,ql,eids,spans);
    if(nn>0){
        p32(st,24,g32(eids,0));
        p32(st,28,g32(spans,0));
        p32(st,32,g32(spans,4));
    }
    else{p32(st,24,-1);}
    nio_free(eids);
    nio_free(spans);
    return;
}
fn track_answer(st:[]u8,ge:[]u8,gn:[]u8,ne:i32,gord:[]u8,qb:[]u8,ql:i32,resp:[]u8)void {
    let eids:[]u8=nio_alloc(16);
    let spans:[]u8=nio_alloc(32);
    let ab:[]u8=resp_get(resp);
    let low:[]u8=nio_alloc(ab.len);
    let li:i32=0;
    while(li<ab.len){low[li]=to_low(ab[li]);li=li+1;}
    let nn:i32=gaz_scan(gn,ge,gord,low,0,ab.len,eids,spans);
    nio_free(low);
    if(nn>0){
        let i:i32=0;
        let setp:i32=0;
        while(i<nn){
            let e:i32=g32(eids,i*4) as i32;
            if(setp==0 && ent_type(ge,e)==0){p32(st,0,e);setp=1;}
            i=i+1;
        }
        p32(st,4,g32(eids,0));
    }
    else{
        let n2:i32=gaz_scan(gn,ge,gord,qb,0,ql,eids,spans);
        if(n2>0){p32(st,4,g32(eids,0));}
    }
    nio_free(eids);
    nio_free(spans);
    return;
}
fn do_turn(st:[]u8,ft:[]u8,fo:[]u8,fl:[]u8,fm:[]u8,nf:i32,ge:[]u8,gn:[]u8,ne:i32,gord:[]u8,inv:[]u8,kw:[]u8,vb:[]u8,voc:[]u8,cl:[]u8,pq:[]u8,did:[]u8,didl:i32,turn:i32,qb:[]u8,ql:i32,resp:[]u8,lb:[]u8)void {
    pr("TURN ");
    prlen(did,didl);
    pr(" ");
    prn(turn as i64);
    prl("");
    pr("U ");
    prlen(qb,ql);
    prl("");
    run_question(st,ft,fo,fl,fm,nf,ge,gn,ne,gord,inv,kw,vb,voc,cl,pq,qb,ql,0,resp,lb);
    pr("A ");
    let ab:[]u8=resp_get(resp);
    prlen(ab,ab.len);
    prl("");
    track_answer(st,ge,gn,ne,gord,qb,ql,resp);
    if(g32(st,52)==0){track_question(st,ge,gn,gord,pq,qb,ql);}
    else{p32(st,52,0);}
    return;
}

fn main()void {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    let kbp:[]u8="kb.txt";
    if(a1.len>0){kbp=a1;}
    let gazp:[]u8="gaz.txt";
    if(a2.len>0){gazp=a2;}
    let batp:[]u8="battery_round4.txt";
    if(a3.len>0){batp=a3;}
    let vb:[]u8=nio_alloc(8192);
    p32(vb,0,0);
    let voc:[]u8=nio_alloc(8+256*16);
    let kw:[]u8=nio_alloc(8+64*12);
    let gn:[]u8=nio_alloc(4096);
    p32(gn,0,0);
    let ge:[]u8=nio_alloc(8+64*20);
    let gord:[]u8=nio_alloc(8+64*4);
    let ft:[]u8=nio_alloc(16384);
    p32(ft,0,0);
    let fo:[]u8=nio_alloc(8+256*8);
    let fl:[]u8=nio_alloc(16384);
    p32(fl,0,0);
    let fm:[]u8=nio_alloc(8+256*48);
    let inv:[]u8=nio_alloc(8+64*68);
    let cl:[]u8=nio_alloc(8+32*16);
    let st:[]u8=nio_alloc(64);
    let pq:[]u8=nio_alloc(4096);
    let lb:[]u8=nio_alloc(4096);
    let resp:[]u8=nio_alloc(2048);
    let qb:[]u8=nio_alloc(4096);
    p32(st,0,-1);
    p32(st,4,-1);
    p32(st,8,-1);
    p32(st,12,-1);
    p32(st,16,-1);
    p32(st,24,-1);
    let t0:i64=now_ms();
    v_train(vb,voc,kw);
    gaz_load(gn,ge,gord,gazp);
    kb_load(ft,fo,fl,fm,inv,gn,ge,gord,kw,vb,voc,kbp);
    let t1:i64=now_ms();
    let nf:i32=g32(fo,0) as i32;
    let ne:i32=g32(ge,0) as i32;
    let nvoc:i32=g32(voc,0) as i32;
    let cc:[]u8=nio_alloc(28);
    let vi:i32=0;
    while(vi<nvoc){
        let c:i32=g32(voc,4+vi*16+8) as i32;
        p32(cc,c*4,(g32(cc,c*4) as i32)+1);
        vi=vi+1;
    }
    pr("ENGLISH-ARM v1");
    prl("");
    pr("TRAINING vocab=");
    prn(nvoc as i64);
    pr(" numbers=");
    prn(g32(cc,0));
    pr(" comparatives=");
    prn(g32(cc,4));
    pr(" qwords=");
    prn(g32(cc,8));
    pr(" units=");
    prn(g32(cc,12));
    pr(" negation=");
    prn(g32(cc,16));
    pr(" pronouns=");
    prn(g32(cc,20));
    pr(" predicates=");
    prn(g32(cc,24));
    pr(" patterns=");
    prn(v_patcount() as i64);
    prl("");
    pr("KB facts=");
    prn(nf as i64);
    pr(" entities=");
    prn(ne as i64);
    prl("");
    nio_free(cc);
    lb_clr(lb);
    lb_put(lb,"training wall-clock: ");
    lb_putn(lb,t1-t0);
    lb_put(lb," ms");
    let tml:i32=g32(lb,0) as i32;
    prerr(lb[4..4+tml],tml);
    prerr("\n",1);
    let bat:[]u8=read_all(batp);
    let bl:i32=bat.len;
    let p:i32=0;
    let did:[]u8=nio_alloc(64);
    let didl:i32=0;
    let turn:i32=0;
    let npass:i32=0;
    let nfail:i32=0;
    let ntot:i32=0;
    let h:i64=-3750763034362895579;
    while(p<bl){
        let ls:i32=p;
        while(p<bl && bat[p]!=10){p=p+1;}
        let le:i32=p;
        if(p<bl){p=p+1;}
        if(le>ls && bat[le-1]==13){le=le-1;}
        if(le>ls && bat[ls]!=35){
            let lsl:[]u8=bat[ls..le];
            let isd:i32=sw(lsl,le-ls,"DIALOGUE ");
            let isu:i32=sw(lsl,le-ls,"U ");
            let ise:i32=sw(lsl,le-ls,"E ");
            if(isd==1){
                let q2:i32=ls+9;
                let q3:i32=q2;
                while(q3<le && bat[q3]!=32){q3=q3+1;}
                didl=q3-q2;
                copy_bytes(did,0,bat,q2,didl);
                turn=0;
                p32(st,0,-1);
                p32(st,4,-1);
                p32(st,8,-1);
                p32(st,12,-1);
                p32(st,16,-1);
                p32(st,20,0);
                p32(st,24,-1);
                p32(st,36,0);
                p32(st,52,0);
                pr("DIALOGUE ");
                prlen(did,didl);
                prl("");
            }
            if(isd==0 && isu==1){
                turn=turn+1;
                p32(st,48,turn);
                let ul:i32=le-ls-2;
                let k5:i32=0;
                while(k5<ul){qb[k5]=to_low(bat[ls+2+k5]);k5=k5+1;}
                do_turn(st,ft,fo,fl,fm,nf,ge,gn,ne,gord,inv,kw,vb,voc,cl,pq,did,didl,turn,qb,ul,resp,lb);
                let ab:[]u8=resp_get(resp);
                let bi:i32=0;
                while(bi<ab.len){
                    h=((h ^ (ab[bi] as i64))*1099511628211);
                    bi=bi+1;
                }
            }
            if(isd==0 && isu==0 && ise==1){
                let el2:i32=le-ls-2;
                let ab2:[]u8=resp_get(resp);
                let ok:i32=0;
                if(ab2.len==el2 && beq2(ab2,0,bat,ls+2,el2)==1){ok=1;}
                ntot=ntot+1;
                pr("T ");
                prlen(did,didl);
                pr(" ");
                prn(turn as i64);
                if(ok==1){pr(" PASS");npass=npass+1;}
                else{pr(" FAIL");nfail=nfail+1;}
                prl("");
                if(ok==0){
                    pr("X ");
                    prlen(bat[ls+2..le],el2);
                    prl("");
                }
            }
        }
    }
    pr("RESULT pass=");
    prn(npass as i64);
    pr(" fail=");
    prn(nfail as i64);
    pr(" total=");
    prn(ntot as i64);
    prl("");
    pr("DIGEST ");
    let hx:[]u8=nio_alloc(16);
    let dg:[]u8="0123456789abcdef";
    let hh:i64=h;
    let i2:i32=15;
    while(i2>=0){
        hx[i2]=dg[(hh & 15) as i32];
        hh=((hh>>4) & 1152921504606846975);
        i2=i2-1;
    }
    prlen(hx,16);
    prl("");
    nio_free(hx);
    nio_free(did);
    return;
}

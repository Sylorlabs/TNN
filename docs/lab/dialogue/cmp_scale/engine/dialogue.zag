@import("R33_NATIVE_SHA256_V2.zag")

// PROSE-LEARN: prose-consuming TNN learner, frozen PREREG.md mechanism.
// argv[1] = source name (grok|sol|step|muse-native). Reads inputs/train_<s>.txt,
// inputs/test_<s>.txt, inputs/false_ids_<s>.txt relative to CWD.
// Pure Zag, zero RNG. All tables are []u8 arenas with explicit put/get32
// (znc ZNC-2026-09-21-007: never `as []i32` for indexed tables).

// ---------------- byte helpers ----------------
fn is_alnum(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn p64(b:[]u8,at:i32,v:i64)void {
    p32(b,at,v&4294967295);
    p32(b,at+4,(v>>32)&4294967295);
    return;
}
fn g64(b:[]u8,at:i32)i64 {
    return g32(b,at)|(g32(b,at+4)<<32);
}
// byte equality: buf[off..off+len) vs literal
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
// byte equality between two buffers
fn beq2(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let i:i32=0;
    while(i<len){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn parse_int(b:[]u8,off:i32,len:i32)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<len){
        let c:u8=b[off+i];
        if(c>=48 && c<=57){v=v*10+((c as i64)-48);}
        i=i+1;
    }
    return v;
}
fn mkpath(a:[]u8,b:[]u8,c:[]u8)[]u8 {
    let n:i32=a.len+b.len+c.len;
    let o:[]u8=nio_alloc(n);
    copy_bytes(o,0,a,0,a.len);
    copy_bytes(o,a.len,b,0,b.len);
    copy_bytes(o,a.len+b.len,c,0,c.len);
    return o;
}

// ---------------- printing ----------------
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
// decimal of v into buf (needs >=24 bytes); returns length
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){
        let dd:i64=(x%10)+48;
        buf[at]=dd as u8;
        x=x/10;
        at=at-1;
    }
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    prlen(b,n);
    nio_free(b);
    return;
}
fn prhex(b:[]u8,off:i32,len:i32)void {
    let hb:[]u8=nio_alloc(len*2+1);
    let dg:[]u8="0123456789abcdef";
    let i:i32=0;
    while(i<len){
        let v:i32=b[off+i] as i32;
        hb[2*i]=dg[v/16];
        hb[2*i+1]=dg[v%16];
        i=i+1;
    }
    prlen(hb,len*2);
    nio_free(hb);
    return;
}

// ---------------- file IO (raw syscalls) ----------------
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{
                    copy_bytes(buf,total,chk,0,nb);
                    total=total+nb;
                }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}

// ---------------- arena helpers ----------------
// arena layout: [0..4) = used-bytes counter; data from 4 (linka/keya) or 8 (vocab).
fn arena_append(a:[]u8,v:i64)void {
    let u:i32=g32(a,0) as i32;
    p32(a,u,v);
    p32(a,0,(u+4) as i64);
    return;
}

// ---------------- vocab ----------------
// ---------------- number lexicon ----------------
// digit token: ^(\d+)(st|nd|rd|th)?$ -> integer; else -1. Token is lowercased.
fn digit_val(sb:[]u8,so:i32,sl:i32)i64 {
    // length of the leading digit run
    let i:i32=0;
    let go:i32=1;
    while(go==1){
        if(i>=sl){go=0;}
        else{
            let c3:u8=sb[so+i];
            if(c3>=48 && c3<=57){i=i+1;}
            else{go=0;}
        }
    }
    if(i==0){return -1;}
    let rest:i32=sl-i;
    if(rest!=0){
        if(rest!=2){return -1;}
        let s0:u8=sb[so+i];
        let s1:u8=sb[so+i+1];
        let ok:i32=0;
        if(s0==115 && s1==116){ok=1;}
        if(s0==110 && s1==100){ok=1;}
        if(s0==114 && s1==100){ok=1;}
        if(s0==116 && s1==104){ok=1;}
        if(ok==0){return -1;}
    }
    let v:i64=0;
    let j:i32=0;
    while(j<i){
        let d:i64=(sb[so+j] as i64)-48;
        v=v*10+d;
        j=j+1;
    }
    return v;
}

// cardinal words one..thirty and ordinal words first..thirtieth -> value; else -1.
fn numword_val(sb:[]u8,so:i32,sl:i32)i64 {
    if(beq(sb,so,sl,"one")==1){return 1;}
    if(beq(sb,so,sl,"two")==1){return 2;}
    if(beq(sb,so,sl,"three")==1){return 3;}
    if(beq(sb,so,sl,"four")==1){return 4;}
    if(beq(sb,so,sl,"five")==1){return 5;}
    if(beq(sb,so,sl,"six")==1){return 6;}
    if(beq(sb,so,sl,"seven")==1){return 7;}
    if(beq(sb,so,sl,"eight")==1){return 8;}
    if(beq(sb,so,sl,"nine")==1){return 9;}
    if(beq(sb,so,sl,"ten")==1){return 10;}
    if(beq(sb,so,sl,"eleven")==1){return 11;}
    if(beq(sb,so,sl,"twelve")==1){return 12;}
    if(beq(sb,so,sl,"thirteen")==1){return 13;}
    if(beq(sb,so,sl,"fourteen")==1){return 14;}
    if(beq(sb,so,sl,"fifteen")==1){return 15;}
    if(beq(sb,so,sl,"sixteen")==1){return 16;}
    if(beq(sb,so,sl,"seventeen")==1){return 17;}
    if(beq(sb,so,sl,"eighteen")==1){return 18;}
    if(beq(sb,so,sl,"nineteen")==1){return 19;}
    if(beq(sb,so,sl,"twenty")==1){return 20;}
    if(beq(sb,so,sl,"thirty")==1){return 30;}
    if(beq(sb,so,sl,"first")==1){return 1;}
    if(beq(sb,so,sl,"second")==1){return 2;}
    if(beq(sb,so,sl,"third")==1){return 3;}
    if(beq(sb,so,sl,"fourth")==1){return 4;}
    if(beq(sb,so,sl,"fifth")==1){return 5;}
    if(beq(sb,so,sl,"sixth")==1){return 6;}
    if(beq(sb,so,sl,"seventh")==1){return 7;}
    if(beq(sb,so,sl,"eighth")==1){return 8;}
    if(beq(sb,so,sl,"ninth")==1){return 9;}
    if(beq(sb,so,sl,"tenth")==1){return 10;}
    if(beq(sb,so,sl,"eleventh")==1){return 11;}
    if(beq(sb,so,sl,"twelfth")==1){return 12;}
    if(beq(sb,so,sl,"thirteenth")==1){return 13;}
    if(beq(sb,so,sl,"fourteenth")==1){return 14;}
    if(beq(sb,so,sl,"fifteenth")==1){return 15;}
    if(beq(sb,so,sl,"sixteenth")==1){return 16;}
    if(beq(sb,so,sl,"seventeenth")==1){return 17;}
    if(beq(sb,so,sl,"eighteenth")==1){return 18;}
    if(beq(sb,so,sl,"nineteenth")==1){return 19;}
    if(beq(sb,so,sl,"twentieth")==1){return 20;}
    if(beq(sb,so,sl,"thirtieth")==1){return 30;}
    return -1;
}

// ---------------- stemmer (frozen, first-match-wins, single pass) ----------------
fn ends_with(b:[]u8,len:i32,suf:[]u8)i32 {
    if(len<suf.len){return 0;}
    return beq2(b,len-suf.len,suf,0,suf.len);
}
fn stem_inplace(b:[]u8,len:i32)i32 {
    if(ends_with(b,len,"ies")==1){
        b[len-3]=121;
        return len-2;
    }
    if(ends_with(b,len,"ication")==1){
        b[len-7]=105;
        b[len-6]=115;
        b[len-5]=104;
        return len-4;
    }
    if(ends_with(b,len,"ished")==1){
        b[len-5]=105;
        b[len-4]=115;
        b[len-3]=104;
        return len-2;
    }
    if(ends_with(b,len,"ic")==1 && len>5){return len-2;}
    if(ends_with(b,len,"ed")==1 && len>4){return len-2;}
    if(ends_with(b,len,"ches")==1){return len-2;}
    if(ends_with(b,len,"shes")==1){return len-2;}
    if(ends_with(b,len,"sses")==1){return len-2;}
    if(ends_with(b,len,"xes")==1){return len-2;}
    if(ends_with(b,len,"zes")==1){return len-2;}
    if(ends_with(b,len,"s")==1 && len>3 && ends_with(b,len,"ss")==0){return len-1;}
    return len;
}

// --- irregular-form normalization (morphology crew, 2026-09-21) ---
// Maps irregular inflections to their lemma. Runs AFTER stem_inplace in
// proc_token, so KB-install and query paths stay symmetric by construction
// (single code path; no dual dictionaries). Inflectional only: suppletive
// tense forms and irregular participles/gerunds. Derivational pairs
// (high/height, tall/height) and synonyms (penned/wrote) are NOT bridged:
// documented boundary, see docs/lab/dialogue/morphology/MORPH_BATTERY.md.
fn irregular_norm(b:[]u8,len:i32)i32 {
    // bear family (birth/born share the "bear" lemma: to bear = give birth)
    if(beq(b,0,len,"birth")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"born")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"borne")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    // write family: REMOVED 2026-09-21 -- bridging wrote/written/written
    // collapses the KB's load-bearing active/passive distinction
    // ("X wrote the novel Y." vs "Y was written by X." are separate facts
    // with convention-dependent expected answers). 37 regressions.
    // Documented in MORPH_BATTERY.md as characterization probe C04.
    // teach family
    if(beq(b,0,len,"taught")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    if(beq(b,0,len,"teaching")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    // run family
    if(beq(b,0,len,"ran")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    if(beq(b,0,len,"running")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    // speak family
    if(beq(b,0,len,"spoke")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"spoken")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"speaking")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    // think family
    if(beq(b,0,len,"thought")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    if(beq(b,0,len,"thinking")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    // build family
    if(beq(b,0,len,"built")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    if(beq(b,0,len,"building")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    // win family
    if(beq(b,0,len,"won")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    if(beq(b,0,len,"winning")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    // comparative adjectives (F3-ARITHMETIC, 2026-09-23): the -er comparative
    // is INFLECTIONAL (a closed grammatical paradigm, like the -ed/-s/-ies
    // strips above), not the derivational class the morphology crew fenced
    // off (tall/height, high/tall are different lexemes; penned/wrote are
    // synonyms). A general "-er" suffix strip is rejected: it would mangle
    // load-bearing proper nouns ("tower"->"tow", "water"->"wat",
    // "author"->"autho"). Closed list only; runs in proc_token so KB-install
    // and query paths stay symmetric by construction.
    if(beq(b,0,len,"taller")==1){ copy_bytes(b,0,"tall",0,4); return 4; }
    if(beq(b,0,len,"older")==1){ copy_bytes(b,0,"old",0,3); return 3; }
    if(beq(b,0,len,"longer")==1){ copy_bytes(b,0,"long",0,4); return 4; }
    if(beq(b,0,len,"bigger")==1){ copy_bytes(b,0,"big",0,3); return 3; }
    if(beq(b,0,len,"smaller")==1){ copy_bytes(b,0,"small",0,5); return 5; }
    if(beq(b,0,len,"earlier")==1){ copy_bytes(b,0,"early",0,5); return 5; }
    if(beq(b,0,len,"later")==1){ copy_bytes(b,0,"late",0,4); return 4; }
    return len;
}

// ---------------- sentence pipeline ----------------
// st layout (40B): [0..4)ntok [4..8)ndig [8..12)nword [12..20)lastdig
//                 [20..28)lastword [28..32)nkey [32..36)trlen
// out layout (48B): [0..4)link_off [4..8)link_len [8..12)key_off [12..16)key_len
//                   [16..24)value [24..28)ok [28..32)ntok [32..36)ndig
//                   [36..40)nword [40..44)trlen
// tmp: lowercased token bytes; kid: key-id scratch (nkey*4); trb: trace buffer.
fn proc_token(vbytes:[]u8,vent:[]u8,tmp:[]u8,tlen:i32,kid:[]u8,linka:[]u8,trb:[]u8,st:[]u8)void {
    let dv:i64=digit_val(tmp,0,tlen);
    let cls:i32=0;
    let cval:i64=0;
    if(dv>=0){cls=1;cval=dv;}
    if(cls==0){
        let nv:i64=numword_val(tmp,0,tlen);
        if(nv>=0){cls=2;cval=nv;}
    }
    // LINK: intern raw token form
    let uid:i32=v_intern(vbytes,vent,tmp,0,tlen);
    arena_append(linka,uid as i64);
    p32(st,0,g32(st,0)+1);
    // extraction trace: token bytes + ','
    let trl:i32=g32(st,32) as i32;
    copy_bytes(trb,trl,tmp,0,tlen);
    trb[trl+tlen]=44;
    p32(st,32,(trl+tlen+1) as i64);
    if(cls==1){
        p32(st,4,g32(st,4)+1);
        p64(st,12,cval);
        return;
    }
    if(cls==2){
        p32(st,8,g32(st,8)+1);
        p64(st,20,cval);
        return;
    }
    if(is_stop(tmp,0,tlen)==1){return;}
    let sl:i32=stem_inplace(tmp,tlen);
    sl=irregular_norm(tmp,sl);
    let sid:i32=v_intern(vbytes,vent,tmp,0,sl);
    let nkey:i32=g32(st,28) as i32;
    let f:i32=0;
    let q:i32=0;
    while(q<nkey){
        if(g32(kid,q*4)==(sid as i64)){f=1;}
        q=q+1;
    }
    if(f==0){
        p32(kid,nkey*4,sid as i64);
        p32(st,28,(nkey+1) as i64);
    }
    return;
}

fn proc_sentence(vbytes:[]u8,vent:[]u8,sbuf:[]u8,soff:i32,slen:i32,tmp:[]u8,kid:[]u8,linka:[]u8,keya:[]u8,trb:[]u8,st:[]u8,out:[]u8)i64 {
    let link_off:i32=g32(linka,0) as i32;
    let i:i32=0;
    while(i<slen){
        if(is_alnum(sbuf[soff+i])==1){
            let j:i32=i;
            let go:i32=1;
            while(go==1){
                if(j<slen && is_alnum(sbuf[soff+j])==1){j=j+1;}
                else{go=0;}
            }
            let tlen:i32=j-i;
            let k:i32=0;
            while(k<tlen){
                tmp[k]=to_low(sbuf[soff+i+k]);
                k=k+1;
            }
            proc_token(vbytes,vent,tmp,tlen,kid,linka,trb,st);
            i=j;
        }
        else{i=i+1;}
    }
    let nkey:i32=g32(st,28) as i32;
    // insertion sort kid[0..nkey)
    let a2:i32=1;
    while(a2<nkey){
        let v2:i64=g32(kid,a2*4);
        let b2:i32=a2-1;
        let dn:i32=0;
        while(dn==0){
            if(b2<0){dn=1;}
            else{
                if(g32(kid,b2*4)<=v2){dn=1;}
                else{
                    p32(kid,(b2+1)*4,g32(kid,b2*4));
                    b2=b2-1;
                }
            }
        }
        p32(kid,(b2+1)*4,v2);
        a2=a2+1;
    }
    let key_off:i32=g32(keya,0) as i32;
    let q2:i32=0;
    while(q2<nkey){
        arena_append(keya,g32(kid,q2*4));
        q2=q2+1;
    }
    let link_used:i32=g32(linka,0) as i32;
    let link_len:i32=(link_used-link_off)/4;
    // frozen value scan: last digit-token value; else last number-word value
    let ndig:i32=g32(st,4) as i32;
    let nword:i32=g32(st,8) as i32;
    let ok:i64=0;
    let val:i64=0;
    if(ndig>0){ok=1;val=g64(st,12);}
    else{
        if(nword>0){ok=1;val=g64(st,20);}
    }
    p32(out,0,link_off as i64);
    p32(out,4,link_len as i64);
    p32(out,8,key_off as i64);
    p32(out,12,nkey as i64);
    p64(out,16,val);
    p32(out,24,ok);
    p32(out,28,g32(st,0));
    p32(out,32,g32(st,4));
    p32(out,36,g32(st,8));
    p32(out,40,g32(st,32));
    return ok;
}

// Jaccard packed score: inter in high 32, union in low 32. Compares by cross-multiplication.
fn jscore(kid:[]u8,plen:i32,keya:[]u8,fko:i32,fkl:i32)i64 {
    let a:i32=0;
    let b:i32=0;
    let inter:i32=0;
    let go:i32=1;
    while(go==1){
        if(a>=plen || b>=fkl){go=0;}
        else{
            let x:i64=g32(kid,a*4);
            let y:i64=g32(keya,fko+b*4);
            if(x==y){inter=inter+1;a=a+1;b=b+1;}
            else{
                if(x<y){a=a+1;}
                else{b=b+1;}
            }
        }
    }
    let union:i32=plen+fkl-inter;
    return ((inter as i64)<<32)|(union as i64);
}

fn is_stop(sb:[]u8,so:i32,sl:i32)i32 {
    if(beq(sb,so,sl,"the")==1){return 1;}
    if(beq(sb,so,sl,"an")==1){return 1;}
    if(beq(sb,so,sl,"of")==1){return 1;}
    if(beq(sb,so,sl,"in")==1){return 1;}
    if(beq(sb,so,sl,"is")==1){return 1;}
    if(beq(sb,so,sl,"are")==1){return 1;}
    if(beq(sb,so,sl,"was")==1){return 1;}
    if(beq(sb,so,sl,"were")==1){return 1;}
    if(beq(sb,so,sl,"be")==1){return 1;}
    if(beq(sb,so,sl,"been")==1){return 1;}
    if(beq(sb,so,sl,"what")==1){return 1;}
    if(beq(sb,so,sl,"which")==1){return 1;}
    if(beq(sb,so,sl,"that")==1){return 1;}
    if(beq(sb,so,sl,"this")==1){return 1;}
    if(beq(sb,so,sl,"these")==1){return 1;}
    if(beq(sb,so,sl,"those")==1){return 1;}
    if(beq(sb,so,sl,"it")==1){return 1;}
    if(beq(sb,so,sl,"its")==1){return 1;}
    if(beq(sb,so,sl,"do")==1){return 1;}
    if(beq(sb,so,sl,"does")==1){return 1;}
    if(beq(sb,so,sl,"did")==1){return 1;}
    if(beq(sb,so,sl,"have")==1){return 1;}
    if(beq(sb,so,sl,"has")==1){return 1;}
    if(beq(sb,so,sl,"had")==1){return 1;}
    if(beq(sb,so,sl,"there")==1){return 1;}
    if(beq(sb,so,sl,"and")==1){return 1;}
    if(beq(sb,so,sl,"or")==1){return 1;}
    if(beq(sb,so,sl,"to")==1){return 1;}
    if(beq(sb,so,sl,"for")==1){return 1;}
    if(beq(sb,so,sl,"with")==1){return 1;}
    if(beq(sb,so,sl,"at")==1){return 1;}
    if(beq(sb,so,sl,"by")==1){return 1;}
    if(beq(sb,so,sl,"from")==1){return 1;}
    if(beq(sb,so,sl,"as")==1){return 1;}
    if(beq(sb,so,sl,"on")==1){return 1;}
    if(beq(sb,so,sl,"how")==1){return 1;}
    if(beq(sb,so,sl,"many")==1){return 1;}
    if(beq(sb,so,sl,"much")==1){return 1;}
    if(beq(sb,so,sl,"when")==1){return 1;}
    if(beq(sb,so,sl,"where")==1){return 1;}
    if(beq(sb,so,sl,"s")==1){return 1;}
    // F4-DEFEND (PREREG_F4.md §2a): function words that polluted content key
    // sets. "a"/"i"/"you" are the turn-11 root cause ("a biography" matched
    // "as a museum" on pure noise). The rest are the same class: articles
    // and pronouns, never KB content. Pronoun BINDING uses raw tokens
    // (build_resolved), not keys, so it is unaffected. "not"/"no" are
    // deliberately NOT stopped (negation is load-bearing elsewhere).
    if(beq(sb,so,sl,"a")==1){return 1;}
    if(beq(sb,so,sl,"i")==1){return 1;}
    if(beq(sb,so,sl,"you")==1){return 1;}
    if(beq(sb,so,sl,"me")==1){return 1;}
    if(beq(sb,so,sl,"my")==1){return 1;}
    if(beq(sb,so,sl,"mine")==1){return 1;}
    if(beq(sb,so,sl,"we")==1){return 1;}
    if(beq(sb,so,sl,"us")==1){return 1;}
    if(beq(sb,so,sl,"our")==1){return 1;}
    if(beq(sb,so,sl,"ours")==1){return 1;}
    if(beq(sb,so,sl,"he")==1){return 1;}
    if(beq(sb,so,sl,"him")==1){return 1;}
    if(beq(sb,so,sl,"his")==1){return 1;}
    if(beq(sb,so,sl,"she")==1){return 1;}
    if(beq(sb,so,sl,"her")==1){return 1;}
    if(beq(sb,so,sl,"hers")==1){return 1;}
    if(beq(sb,so,sl,"they")==1){return 1;}
    if(beq(sb,so,sl,"them")==1){return 1;}
    if(beq(sb,so,sl,"their")==1){return 1;}
    if(beq(sb,so,sl,"theirs")==1){return 1;}
    if(beq(sb,so,sl,"your")==1){return 1;}
    if(beq(sb,so,sl,"yours")==1){return 1;}
    if(beq(sb,so,sl,"myself")==1){return 1;}
    if(beq(sb,so,sl,"yourself")==1){return 1;}
    if(beq(sb,so,sl,"himself")==1){return 1;}
    if(beq(sb,so,sl,"herself")==1){return 1;}
    if(beq(sb,so,sl,"itself")==1){return 1;}
    if(beq(sb,so,sl,"ourselves")==1){return 1;}
    if(beq(sb,so,sl,"themselves")==1){return 1;}
    // ADDENDUM 2026-09-23 (deviation from PREREG_F4.md §2a, documented in
    // VERDICT.md): "about" is a preposition/function word, same class as the
    // of/in/to/for/with/at/by/from/as/on already listed — the original list
    // simply missed it, and the code already treats "about" as a generic
    // word in the has_sub check in do_turn. Load-bearing: removing "a"
    // exposed a Jaccard tie ("What about Big Ben?": fact 29 vs 30, 2/5 each,
    // lower fid won) that the old "a"-pollution was accidentally breaking.
    // Stopping "about" lets the DESIGNED ellipsis mechanism fire
    // (content_count==0 -> carry over the previous question with the entity
    // swapped), which resolves the tie 3/4 for the correct fact.
    if(beq(sb,so,sl,"about")==1){return 1;}
    return 0;
}
fn v_intern(vbytes:[]u8,vent:[]u8,sb:[]u8,so:i32,sl:i32)i32 {
    let n:i32=g32(vent,0) as i32;
    let i:i32=0;
    while(i<n){
        let eo:i32=g32(vent,8+8*i) as i32;
        let el:i32=g32(vent,8+8*i+4) as i32;
        if(el==sl){
            if(beq2(sb,so,vbytes,eo,sl)==1){return i;}
        }
        i=i+1;
    }
    let used:i32=g32(vbytes,0) as i32;
    copy_bytes(vbytes,used,sb,so,sl);
    p32(vbytes,0,(used+sl) as i64);
    p32(vent,8+8*n,used as i64);
    p32(vent,8+8*n+4,sl as i64);
    p32(vent,0,(n+1) as i64);
    return n;
}

fn zero40(st:[]u8)void {
    let c:i32=0;
    while(c<40){st[c]=0;c=c+1;}
    return;
}

// ================= DIALOGUE LAYER (frozen prereg 2026-09-22) =================
// Deterministic multi-turn state manager around the pinned v1 retrieval core.
// All v1 functions above are used verbatim; nothing in the core is modified.

// --- generic substring find on (arena,off,len); returns index or -1 ---
fn find_sub(h:[]u8,ho:i32,hl:i32,n:[]u8,noff:i32,nl:i32)i32 {
    if(nl<=0){ return -1; }
    if(nl>hl){ return -1; }
    let i:i32=0;
    while(i+nl<=hl){
        if(beq2(h,ho+i,n,noff,nl)==1){ return i; }
        i=i+1;
    }
    return -1;
}

fn starts_with(h:[]u8,ho:i32,hl:i32,n:[]u8,nl:i32)i32 {
    if(nl>hl){ return 0; }
    return beq2(h,ho,n,0,nl);
}

// --- gazetteer install from "eid\tclass\tname\n" (names pre-lowercased) ---
// ge rows 16B: name_off@0 name_len@4 class@8 ; gord: scan order (len desc, eid asc)
fn gaz_install(gnames:[]u8,ge:[]u8,gord:[]u8,path:[]u8)void {
    let buf:[]u8=read_all(path);
    let bl:i32=buf.len;
    let p:i32=0;
    let e:i32=0;
    while(p<bl){
        let ls:i32=p;
        while(p<bl && buf[p]!=10){ p=p+1; }
        let le:i32=p;
        if(p<bl){ p=p+1; }
        if(le>ls){
            let q:i32=ls;
            while(q<le && buf[q]!=9){ q=q+1; }
            q=q+1;
            while(q<le && buf[q]!=9){ q=q+1; }
            q=q+1;
            let noff:i32=g32(gnames,0) as i32;
            let nl:i32=le-q;
            copy_bytes(gnames,noff,buf,q,nl);
            p32(gnames,0,noff+nl);
            let ro:i32=8+e*16;
            let qc:i32=ls;
            while(qc<le && buf[qc]!=9){ qc=qc+1; }
            let cls:i32=0;
            let qd:i32=qc+1;
            while(qd<le && buf[qd]!=9){ cls=cls*10+((buf[qd] as i32)-48); qd=qd+1; }
            p32(ge,ro,noff); p32(ge,ro+4,nl); p32(ge,ro+8,cls);
            e=e+1;
        }
    }
    p32(ge,0,e);
    let i2:i32=0;
    while(i2<e){ p32(gord,4+i2*4,i2); i2=i2+1; }
    let a:i32=1;
    while(a<e){
        let key:i32=g32(gord,4+a*4) as i32;
        let kl:i32=g32(ge,8+key*16+4) as i32;
        let b:i32=a-1;
        let go:i32=1;
        while(go==1){
            if(b<0){ go=0; }
            if(go==1){
                let be:i32=g32(gord,4+b*4) as i32;
                let bl2:i32=g32(ge,8+be*16+4) as i32;
                let swap:i32=0;
                if(bl2<kl){ swap=1; }
                if(bl2==kl && be>key){ swap=1; }
                if(swap==1){ p32(gord,4+(b+1)*4,be); b=b-1; }
                if(swap==0){ go=0; }
            }
        }
        p32(gord,4+(b+1)*4,key);
        a=a+1;
    }
    p32(gord,0,e);
    return;
}

// --- longest-match entity scan; writes eids (position order) to out; returns count ---
fn gaz_scan(gnames:[]u8,ge:[]u8,gord:[]u8,buf:[]u8,bo:i32,bl:i32,out:[]u8,excl:i32)i32 {
    let ne:i32=g32(gord,0) as i32;
    let n:i32=0;
    let pos:i32=0;
    while(pos<bl){
        let oi:i32=0;
        let hit:i32=-1;
        let hlen:i32=0;
        let go:i32=1;
        while(go==1){
            if(oi>=ne){ go=0; }
            if(go==1){
                let eid:i32=g32(gord,4+oi*4) as i32;
                if(eid!=excl){
                    let no:i32=g32(ge,8+eid*16) as i32;
                    let nl:i32=g32(ge,8+eid*16+4) as i32;
                    if(pos+nl<=bl && beq2(buf,bo+pos,gnames,no,nl)==1){ hit=eid; hlen=nl; go=0; }
                }
                oi=oi+1;
            }
        }
        if(hit>=0){ p32(out,n*4,hit); n=n+1; pos=pos+hlen; }
        if(hit<0){ pos=pos+1; }
    }
    return n;
}

// --- most salient entity (head of salience stack), or -1 ---
// A turn with no explicit entity and no bound pronoun continues the topic.
fn sal_head(sal:[]u8)i32 {
    let n:i32=g32(sal,0) as i32;
    if(n<=0){ return -1; }
    return g32(sal,4) as i32;
}

// --- keyword fallback: best eid by count of name-words present; -1 if none ---
// (short words <4 chars are skipped: "and"/"the"/"of" must not match names)
fn fallback_eid(gnames:[]u8,ge:[]u8,buf:[]u8,bo:i32,bl:i32,excl:i32)i32 {
    let ne:i32=g32(ge,0) as i32;
    let best:i32=-1;
    let bs:i32=0;
    let e:i32=0;
    while(e<ne){
        if(e!=excl){
            let no:i32=g32(ge,8+e*16) as i32;
            let nl:i32=g32(ge,8+e*16+4) as i32;
            let s:i32=0;
            let sc:i32=0;
            while(s<nl){
                while(s<nl && gnames[no+s]==32){ s=s+1; }
                let ws:i32=s;
                while(s<nl && gnames[no+s]!=32){ s=s+1; }
                if(s-ws>=4 && find_sub(buf,bo,bl,gnames,no+ws,s-ws)>=0){ sc=sc+1; }
            }
            if(sc>bs){ bs=sc; best=e; }
        }
        e=e+1;
    }
    return best;
}

// --- pronoun classes: 1=masc 2=fem 3=neut ---
fn pron_class(t:[]u8,to:i32,tl:i32)i32 {
    if(tl==2 && beq2(t,to,"he",0,2)==1){ return 1; }
    if(tl==3 && beq2(t,to,"him",0,3)==1){ return 1; }
    if(tl==3 && beq2(t,to,"his",0,3)==1){ return 1; }
    if(tl==3 && beq2(t,to,"she",0,3)==1){ return 2; }
    if(tl==3 && beq2(t,to,"her",0,3)==1){ return 2; }
    if(tl==2 && beq2(t,to,"it",0,2)==1){ return 3; }
    if(tl==3 && beq2(t,to,"its",0,3)==1){ return 3; }
    if(tl==4 && beq2(t,to,"they",0,4)==1){ return 3; }
    if(tl==4 && beq2(t,to,"them",0,4)==1){ return 3; }
    return 0;
}

// --- salience lookup: most-recent entry matching pronoun class ---
fn sal_bind(sal:[]u8,ge:[]u8,cls:i32)i32 {
    let n:i32=g32(sal,0) as i32;
    let i:i32=0;
    while(i<n){
        let e:i32=g32(sal,4+i*4) as i32;
        let ec:i32=g32(ge,8+e*16+8) as i32;
        if(cls==3 && ec==1){ return e; }
        if(cls!=3 && ec==0){ return e; }
        i=i+1;
    }
    return -1;
}

// --- build resolved query: bound pronouns replaced by entity names ---
// bout: [0..4)=bound count, entries after. Returns resolved length.
fn build_resolved(ubuf:[]u8,uo:i32,ul:i32,sal:[]u8,ge:[]u8,gnames:[]u8,out:[]u8,bout:[]u8)i32 {
    let tmp:[]u8=nio_alloc(256);
    let ol:i32=0;
    let bc:i32=0;
    let i:i32=0;
    while(i<ul){
        let ch:u8=ubuf[uo+i];
        if(is_alnum(ch)==1){
            let tl:i32=0;
            while(i<ul && is_alnum(ubuf[uo+i])==1){
                tmp[tl]=to_low(ubuf[uo+i]);
                tl=tl+1; i=i+1;
            }
            let pc:i32=pron_class(tmp,0,tl);
            let be:i32=-1;
            if(pc>0){ be=sal_bind(sal,ge,pc); }
            if(pc>0 && be>=0){
                let no:i32=g32(ge,8+be*16) as i32;
                let nl:i32=g32(ge,8+be*16+4) as i32;
                if(ol>0){ out[ol]=32; ol=ol+1; }
                copy_bytes(out,ol,gnames,no,nl);
                ol=ol+nl;
                p32(bout,4+bc*4,be); bc=bc+1;
            }
            if(pc==0 || be<0){
                if(ol>0){ out[ol]=32; ol=ol+1; }
                copy_bytes(out,ol,tmp,0,tl);
                ol=ol+tl;
            }
        }
        if(is_alnum(ch)==0){ i=i+1; }
    }
    p32(bout,0,bc);
    nio_free(tmp);
    return ol;
}

// --- count non-stopword tokens not covered by found entity names ---
fn content_count(ubuf:[]u8,uo:i32,ul:i32,eids:[]u8,ne:i32,gnames:[]u8,ge:[]u8)i32 {
    let tmp:[]u8=nio_alloc(256);
    let c:i32=0;
    let i:i32=0;
    while(i<ul){
        let ch:u8=ubuf[uo+i];
        if(is_alnum(ch)==1){
            let tl:i32=0;
            while(i<ul && is_alnum(ubuf[uo+i])==1){
                tmp[tl]=to_low(ubuf[uo+i]);
                tl=tl+1; i=i+1;
            }
            if(is_stop(tmp,0,tl)==0){
                let cov:i32=0;
                let k:i32=0;
                while(k<ne && cov==0){
                    let e:i32=g32(eids,k*4) as i32;
                    let no:i32=g32(ge,8+e*16) as i32;
                    let nl:i32=g32(ge,8+e*16+4) as i32;
                    let s:i32=0;
                    while(s<nl && cov==0){
                        while(s<nl && gnames[no+s]==32){ s=s+1; }
                        let ws:i32=s;
                        while(s<nl && gnames[no+s]!=32){ s=s+1; }
                        if(s-ws==tl && beq2(tmp,0,gnames,no+ws,tl)==1){ cov=1; }
                    }
                    k=k+1;
                }
                if(cov==0){ c=c+1; }
            }
        }
        if(is_alnum(ch)==0){ i=i+1; }
    }
    nio_free(tmp);
    return c;
}

// --- salience: most-recent-first, dedup, cap 8 ---
fn sal_push(sal:[]u8,e:i32)void {
    let n:i32=g32(sal,0) as i32;
    let i:i32=0;
    let f:i32=-1;
    while(i<n){
        if((g32(sal,4+i*4) as i32)==e){ f=i; }
        i=i+1;
    }
    if(f<0 && n>=8){ n=7; }
    if(f>=0){ n=f; }
    // shift entries [0..n) right by one, dropping [n)
    let j:i32=n;
    while(j>0){ p32(sal,4+j*4,g32(sal,4+(j-1)*4)); j=j-1; }
    p32(sal,4,e);
    if(f>=0){ p32(sal,0,(g32(sal,0) as i32)); }
    if(f<0){ p32(sal,0,n+1); }
    return;
}

// --- topic stack ---
fn top_push(top:[]u8,e:i32)void {
    let n:i32=g32(top,0) as i32;
    p32(top,4+n*4,e);
    p32(top,0,n+1);
    return;
}
fn top_peek(top:[]u8)i32 {
    let n:i32=g32(top,0) as i32;
    if(n<=0){ return -1; }
    return g32(top,4+(n-1)*4) as i32;
}
fn top_has(top:[]u8,e:i32)i32 {
    let n:i32=g32(top,0) as i32;
    let i:i32=0;
    while(i<n){
        if((g32(top,4+i*4) as i32)==e){ return 1; }
        i=i+1;
    }
    return 0;
}
fn top_pop_to(top:[]u8,e:i32)void {
    let n:i32=g32(top,0) as i32;
    let i:i32=n-1;
    let f:i32=-1;
    let go:i32=1;
    while(go==1){
        if(i<0){ go=0; }
        if(go==1){
            if((g32(top,4+i*4) as i32)==e){ f=i; go=0; }
            if(f<0){ i=i-1; }
        }
    }
    if(f>=0){ p32(top,0,f+1); }
    return;
}
fn top_pop1(top:[]u8)void {
    let n:i32=g32(top,0) as i32;
    if(n>0){ p32(top,0,n-1); }
    return;
}

// --- response buffer: [0..4)=len ---
fn rclr(resp:[]u8)void { p32(resp,0,0); return; }
fn rput(resp:[]u8,s:[]u8,so:i32,sl:i32)void {
    let l:i32=g32(resp,0) as i32;
    copy_bytes(resp,4+l,s,so,sl);
    p32(resp,0,l+sl);
    return;
}

// --- number grabbing ---
fn grab_num_left(b:[]u8,bo:i32,pos:i32)i32 {
    let j:i32=pos-1;
    while(j>=bo && b[j]>=48 && b[j]<=57){ j=j-1; }
    if(j==pos-1){ return -1; }
    return parse_int(b,j+1,pos-(j+1)) as i32;
}
fn grab_num_right(b:[]u8,bo:i32,bl:i32,pos:i32)i32 {
    let j:i32=pos;
    while(j<bo+bl && (b[j]<48 || b[j]>57)){ j=j+1; }
    if(j>=bo+bl){ return -1; }
    let k:i32=j;
    while(k<bo+bl && b[k]>=48 && b[k]<=57){ k=k+1; }
    return parse_int(b,j,k-j) as i32;
}

// --- KB install: fm rows 40B: fid@0 key_off@4 key_len@8 value@12 text_off@16
// text_len@20 ent_off@24 ent_n@28 ---
fn kb_install(fm:[]u8,ftx:[]u8,ftl:[]u8,fea:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,keya:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,path:[]u8,tmp:[]u8,kid:[]u8,trb:[]u8,st:[]u8,out:[]u8,eout:[]u8)i32 {
    let buf:[]u8=read_all(path);
    let bl:i32=buf.len;
    let p:i32=0;
    let f:i32=0;
    while(p<bl){
        let ls:i32=p;
        while(p<bl && buf[p]!=10){ p=p+1; }
        let le:i32=p;
        if(p<bl){ p=p+1; }
        if(le>ls){
            let q:i32=ls;
            let fid:i32=0;
            while(q<le && buf[q]!=9){ fid=fid*10+((buf[q] as i32)-48); q=q+1; }
            q=q+1;
            let to:i32=g32(ftx,0) as i32;
            let tl:i32=le-q;
            copy_bytes(ftx,to,buf,q,tl);
            let lc:i32=0;
            while(lc<tl){ ftl[to+lc]=to_low(buf[q+lc]); lc=lc+1; }
            p32(ftx,0,to+tl);
            p32(ftl,0,to+tl);
            p32(linka,0,8);
            zero40(st);
            proc_sentence(vbytes,vent,buf,q,tl,tmp,kid,linka,keya,trb,st,out);
            let ko:i32=g32(out,8) as i32;
            let kl:i32=g32(out,12) as i32;
            let val:i32=g64(out,16) as i32;
            let eo:i32=g32(fea,0) as i32;
            let ne:i32=gaz_scan(gnames,ge,gord,ftl,to,tl,eout,-1);
            let k2:i32=0;
            while(k2<ne){ p32(fea,eo+k2*4,g32(eout,k2*4)); k2=k2+1; }
            p32(fea,0,eo+ne*4);
            let ro:i32=8+f*40;
            p32(fm,ro,fid); p32(fm,ro+4,ko); p32(fm,ro+8,kl); p32(fm,ro+12,val);
            p32(fm,ro+16,to); p32(fm,ro+20,tl); p32(fm,ro+24,eo); p32(fm,ro+28,ne);
            f=f+1;
        }
    }
    p32(fm,0,f);
    return f;
}

// --- retrieval: best fid by v1 cross-multiplied Jaccard; tie -> lower fid ---
fn retrieve(fm:[]u8,keya:[]u8,kid:[]u8,plen:i32,excl_fid:i32,excl_eid:i32,fea:[]u8,tbfid:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let first:i32=1;
    let bi:i64=0;
    let bu:i64=1;
    let best:i32=-1;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let fid:i32=g32(fm,ro) as i32;
        let skip:i32=0;
        if(fid==excl_fid){ skip=1; }
        if(skip==0 && excl_eid>=0){
            let eo:i32=g32(fm,ro+24) as i32;
            let en:i32=g32(fm,ro+28) as i32;
            let k:i32=0;
            while(k<en){
                if((g32(fea,eo+k*4) as i32)==excl_eid){ skip=1; }
                k=k+1;
            }
        }
        if(skip==0){
            let fko:i32=g32(fm,ro+4) as i32;
            let fkl:i32=g32(fm,ro+8) as i32;
            let sc:i64=jscore(kid,plen,keya,fko,fkl);
            let inter:i64=(sc>>32)&4294967295;
            let union:i64=sc&4294967295;
            if(first==1){
                bi=inter; bu=union; best=fid; first=0;
            }
            if(first==0){
                let lhs:i64=inter*bu;
                let rhs:i64=bi*union;
                if(lhs>rhs){ bi=inter; bu=union; best=fid; }
                else {
                    if(tbfid>=0 && fid==tbfid && lhs==rhs && rhs>0){ bi=inter; bu=union; best=fid; }
                }
            }
        }
        fx=fx+1;
    }
    return best;
}

// --- lowest fid whose entity list contains eid ---
fn general_fact(fm:[]u8,fea:[]u8,eid:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let eo:i32=g32(fm,ro+24) as i32;
        let en:i32=g32(fm,ro+28) as i32;
        let k:i32=0;
        while(k<en){
            if((g32(fea,eo+k*4) as i32)==eid){ return g32(fm,ro) as i32; }
            k=k+1;
        }
        fx=fx+1;
    }
    return -1;
}

// --- first entity (position order) of a fact, or -1 ---
fn fact_primary(fm:[]u8,fea:[]u8,fid:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        if((g32(fm,ro) as i32)==fid){
            let en:i32=g32(fm,ro+28) as i32;
            if(en>0){
                let eo:i32=g32(fm,ro+24) as i32;
                return g32(fea,eo) as i32;
            }
            return -1;
        }
        fx=fx+1;
    }
    return -1;
}

// --- assertion extraction. Returns rel 1..6 or 0; abuf: subj@0 val@8 ---
// rel: 1=WROTE(subj=work,val=person) 2=BORN(subj=person,val=year)
//      3=BUILT(subj=place,val=year) 4=TALL(subj=place,val=m)
//      5=CAPITAL(subj=country,val=city) 6=LOCATED(subj=ent,val=place)
fn extract_assert(ubuf:[]u8,uo:i32,ul:i32,gnames:[]u8,ge:[]u8,gord:[]u8,abuf:[]u8,eout:[]u8)i32 {
    let ne:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
    // class of eout entry k: g32(ge,8+eid*16+8)
    let i:i32=find_sub(ubuf,uo,ul," wrote ",0,7);
    if(i>=0){
        // last person entity left of i (positions recomputed in the left region)
        let pe:i32=-1;
        let k2:i32=0;
        while(k2<ne){
            let e2:i32=g32(eout,k2*4) as i32;
            let no2:i32=g32(ge,8+e2*16) as i32;
            let nl2:i32=g32(ge,8+e2*16+4) as i32;
            let at2:i32=find_sub(ubuf,uo,i,gnames,no2,nl2);
            if(at2>=0 && (g32(ge,8+e2*16+8) as i32)==0){ pe=e2; }
            k2=k2+1;
        }
        let wo:i32=-1;
        let k3:i32=0;
        while(k3<ne && wo<0){
            let e3:i32=g32(eout,k3*4) as i32;
            let no3:i32=g32(ge,8+e3*16) as i32;
            let nl3:i32=g32(ge,8+e3*16+4) as i32;
            if(find_sub(ubuf,uo+i+7,ul-i-7,gnames,no3,nl3)>=0){ wo=e3; }
            k3=k3+1;
        }
        if(pe>=0 && wo>=0){
            p32(abuf,0,wo); p32(abuf,8,pe);
            return 1;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," was written by ",0,15);
    if(i>=0){
        let wo2:i32=-1;
        let k4:i32=0;
        while(k4<ne){
            let e4:i32=g32(eout,k4*4) as i32;
            let no4:i32=g32(ge,8+e4*16) as i32;
            let nl4:i32=g32(ge,8+e4*16+4) as i32;
            if(find_sub(ubuf,uo,i,gnames,no4,nl4)>=0){ wo2=e4; }
            k4=k4+1;
        }
        let pe2:i32=-1;
        let k5:i32=0;
        while(k5<ne && pe2<0){
            let e5:i32=g32(eout,k5*4) as i32;
            let no5:i32=g32(ge,8+e5*16) as i32;
            let nl5:i32=g32(ge,8+e5*16+4) as i32;
            if((g32(ge,8+e5*16+8) as i32)==0 && find_sub(ubuf,uo+i+15,ul-i-15,gnames,no5,nl5)>=0){ pe2=e5; }
            k5=k5+1;
        }
        if(wo2>=0 && pe2>=0){
            p32(abuf,0,wo2); p32(abuf,8,pe2);
            return 1;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," meters tall",0,11);
    if(i>=0){
        let num:i32=grab_num_left(ubuf,uo,uo+i);
        let ee:i32=-1;
        let k6:i32=0;
        while(k6<ne){
            let e6:i32=g32(eout,k6*4) as i32;
            let no6:i32=g32(ge,8+e6*16) as i32;
            let nl6:i32=g32(ge,8+e6*16+4) as i32;
            if(find_sub(ubuf,uo,i,gnames,no6,nl6)>=0){ ee=e6; }
            k6=k6+1;
        }
        if(ee>=0 && num>=0){
            p32(abuf,0,ee); p32(abuf,8,num);
            return 4;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," was built in ",0,13);
    if(i>=0){
        let num2:i32=grab_num_right(ubuf,uo,ul,uo+i+13);
        let ee2:i32=-1;
        let k7:i32=0;
        while(k7<ne){
            let e7:i32=g32(eout,k7*4) as i32;
            let no7:i32=g32(ge,8+e7*16) as i32;
            let nl7:i32=g32(ge,8+e7*16+4) as i32;
            if(find_sub(ubuf,uo,i,gnames,no7,nl7)>=0){ ee2=e7; }
            k7=k7+1;
        }
        if(ee2>=0 && num2>=0){
            p32(abuf,0,ee2); p32(abuf,8,num2);
            return 3;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," was born in ",0,12);
    if(i>=0){
        let num3:i32=grab_num_right(ubuf,uo,ul,uo+i+12);
        let ee3:i32=-1;
        let k8:i32=0;
        while(k8<ne){
            let e8:i32=g32(eout,k8*4) as i32;
            let no8:i32=g32(ge,8+e8*16) as i32;
            let nl8:i32=g32(ge,8+e8*16+4) as i32;
            if((g32(ge,8+e8*16+8) as i32)==0 && find_sub(ubuf,uo,i,gnames,no8,nl8)>=0){ ee3=e8; }
            k8=k8+1;
        }
        if(ee3>=0 && num3>=0){
            p32(abuf,0,ee3); p32(abuf,8,num3);
            return 2;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," is the capital of ",0,18);
    if(i>=0){
        let city:i32=-1;
        let k9:i32=0;
        while(k9<ne){
            let e9:i32=g32(eout,k9*4) as i32;
            let no9:i32=g32(ge,8+e9*16) as i32;
            let nl9:i32=g32(ge,8+e9*16+4) as i32;
            if(find_sub(ubuf,uo,i,gnames,no9,nl9)>=0){ city=e9; }
            k9=k9+1;
        }
        let ctry:i32=-1;
        let k10:i32=0;
        while(k10<ne && ctry<0){
            let e10:i32=g32(eout,k10*4) as i32;
            let no10:i32=g32(ge,8+e10*16) as i32;
            let nl10:i32=g32(ge,8+e10*16+4) as i32;
            if(find_sub(ubuf,uo+i+18,ul-i-18,gnames,no10,nl10)>=0){ ctry=e10; }
            k10=k10+1;
        }
        if(city>=0 && ctry>=0){
            p32(abuf,0,ctry); p32(abuf,8,city);
            return 5;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," is in ",0,6);
    if(i>=0){
        let e11:i32=-1;
        let k11:i32=0;
        while(k11<ne){
            let e12:i32=g32(eout,k11*4) as i32;
            let no11:i32=g32(ge,8+e12*16) as i32;
            let nl11:i32=g32(ge,8+e12*16+4) as i32;
            if(find_sub(ubuf,uo,i,gnames,no11,nl11)>=0){ e11=e12; }
            k11=k11+1;
        }
        let pl:i32=-1;
        let k12:i32=0;
        while(k12<ne && pl<0){
            let e13:i32=g32(eout,k12*4) as i32;
            let no12:i32=g32(ge,8+e13*16) as i32;
            let nl12:i32=g32(ge,8+e13*16+4) as i32;
            if(find_sub(ubuf,uo+i+6,ul-i-6,gnames,no12,nl12)>=0){ pl=e13; }
            k12=k12+1;
        }
        if(e11>=0 && pl>=0){
            p32(abuf,0,e11); p32(abuf,8,pl);
            return 6;
        }
        return 0;
    }
    return 0;
}

// --- uclaim ledger: rows 16B subj@0 rel@4 val@8 turn@12. val is eid for rel 1,5,6 ---
// returns: 0=stored(no conflict) 1=conflict(existing turn in cturn, old val in coval)
fn uclaim_check(uc:[]u8,subj:i32,rel:i32,val:i32,turn:i32,cturn:[]u8,coval:[]u8)i32 {
    let n:i32=g32(uc,0) as i32;
    let i:i32=0;
    while(i<n){
        let ro:i32=4+i*16;
        if((g32(uc,ro) as i32)==subj && (g32(uc,ro+4) as i32)==rel){
            let ov:i32=g32(uc,ro+8) as i32;
            if(ov!=val){
                p32(cturn,0,g32(uc,ro+12));
                p32(coval,0,ov);
                return 1;
            }
            return 0;
        }
        i=i+1;
    }
    let ro2:i32=4+n*16;
    p32(uc,ro2,subj); p32(uc,ro2+4,rel); p32(uc,ro2+8,val); p32(uc,ro2+12,turn);
    p32(uc,0,n+1);
    return 0;
}

// --- relation helpers over installed facts (ftl = lowercased text) ---
fn fact_has_ent(fm:[]u8,fea:[]u8,fx:i32,eid:i32)i32 {
    let ro:i32=8+fx*40;
    let eo:i32=g32(fm,ro+24) as i32;
    let en:i32=g32(fm,ro+28) as i32;
    let k:i32=0;
    while(k<en){
        if((g32(fea,eo+k*4) as i32)==eid){ return 1; }
        k=k+1;
    }
    return 0;
}
// AUTHOR_OF: lowest-fid fact naming the work, with a person entity, containing " wrote "
fn author_of(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,work:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        let no:i32=g32(ge,8+work*16) as i32;
        let nl:i32=g32(ge,8+work*16+4) as i32;
        if(find_sub(ftl,to,tl,gnames,no,nl)>=0 && find_sub(ftl,to,tl," wrote ",0,7)>=0){
            let eo:i32=g32(fm,ro+24) as i32;
            let en:i32=g32(fm,ro+28) as i32;
            let k:i32=0;
            while(k<en){
                let e:i32=g32(fea,eo+k*4) as i32;
                if((g32(ge,8+e*16+8) as i32)==0){ return e; }
                k=k+1;
            }
        }
        fx=fx+1;
    }
    return -1;
}
// year_of: value of lowest-fid fact naming eid and containing marker
fn year_of(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32,marker:[]u8,ml:i32)i32 {    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        let no:i32=g32(ge,8+eid*16) as i32;
        let nl:i32=g32(ge,8+eid*16+4) as i32;
        if(find_sub(ftl,to,tl,gnames,no,nl)>=0 && find_sub(ftl,to,tl,marker,0,ml)>=0){
            return g32(fm,ro+12) as i32;
        }
        fx=fx+1;
    }
    return -1;
}
// born_fact_of (morphology crew, 2026-09-21): fid of the lowest-fid fact
// naming eid whose text contains " born ". Mirrors year_of; returns the
// fact id (not the value) so the caller can emit the fact verbatim.
fn born_fact_of(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        let no:i32=g32(ge,8+eid*16) as i32;
        let nl:i32=g32(ge,8+eid*16+4) as i32;
        if(find_sub(ftl,to,tl,gnames,no,nl)>=0 && find_sub(ftl,to,tl," born ",0,6)>=0){
            return g32(fm,ro) as i32;
        }
        fx=fx+1;
    }
    return -1;
}
fn wrote_rel(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,person:i32,work:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        let pn:i32=g32(ge,8+person*16) as i32;
        let pl:i32=g32(ge,8+person*16+4) as i32;
        let wn:i32=g32(ge,8+work*16) as i32;
        let wl:i32=g32(ge,8+work*16+4) as i32;
        if(find_sub(ftl,to,tl,gnames,pn,pl)>=0 && find_sub(ftl,to,tl,gnames,wn,wl)>=0 && find_sub(ftl,to,tl," wrote ",0,7)>=0){
            return 1;
        }
        fx=fx+1;
    }
    return 0;
}

// --- composition templates; returns 1 if handled (response written) ---
// ================= INTEGRATED round-2 repair =================
// Five families merged per PREREG_INT.md. Slot map:
//   prevbn@32 (F4) | F1 compared pair@40/44 | F3 carry pair@48/52
//   F3 dim@56 (write-only) | F3 carry turn@60
// =================================================================

// ================= F4-DEFEND (PREREG_F4.md §2b/§2c) =================
// Challenge + provenance handling. Utterance-type patterns only — no entity
// or fact literals anywhere in this block.

// --- challenge patterns: "are you sure?"-style ---
fn is_challenge(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(find_sub(ubuf,uo,ul,"are you sure",0,12)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"you sure",0,8)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"are you certain",0,15)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"sure about that",0,15)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"is that true",0,12)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"is that right",0,13)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"really",0,6)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"i doubt",0,7)>=0){ return 1; }
    return 0;
}

// --- provenance patterns. On match, writes the offset just past the match
// into off[0] and returns 1; else returns 0. ---
fn prov_match(ubuf:[]u8,uo:i32,ul:i32,off:[]u8)i32 {
    let at:i32=find_sub(ubuf,uo,ul,"how do you know",0,15);
    if(at>=0){ p32(off,0,uo+at+15); return 1; }
    at=find_sub(ubuf,uo,ul,"how did you learn",0,16);
    if(at>=0){ p32(off,0,uo+at+16); return 1; }
    at=find_sub(ubuf,uo,ul,"where did you learn",0,18);
    if(at>=0){ p32(off,0,uo+at+18); return 1; }
    at=find_sub(ubuf,uo,ul,"who told you",0,12);
    if(at>=0){ p32(off,0,uo+at+12); return 1; }
    at=find_sub(ubuf,uo,ul,"who taught you",0,14);
    if(at>=0){ p32(off,0,uo+at+14); return 1; }
    at=find_sub(ubuf,uo,ul,"why do you think",0,15);
    if(at>=0){ p32(off,0,uo+at+15); return 1; }
    at=find_sub(ubuf,uo,ul,"how can you be sure",0,18);
    if(at>=0){ p32(off,0,uo+at+18); return 1; }
    return 0;
}

// --- last digit-token value in buf[bo..bo+bl), or -1 ---
fn last_digit_buf(b:[]u8,bo:i32,bl:i32)i32 {
    let tmp:[]u8=nio_alloc(64);
    let last:i64=-1;
    let i:i32=0;
    while(i<bl){
        if(is_alnum(b[bo+i])==1){
            let tl:i32=0;
            while(i<bl && is_alnum(b[bo+i])==1){
                if(tl<64){ tmp[tl]=to_low(b[bo+i]); }
                tl=tl+1; i=i+1;
            }
            if(tl<=64){
                let dv:i64=digit_val(tmp,0,tl);
                if(dv>=0){ last=dv; }
            }
        }
        else{ i=i+1; }
    }
    nio_free(tmp);
    return last as i32;
}

// --- last digit-token value in the (lowercased) text of fact fid, or -1 ---
fn fact_last_digit(fm:[]u8,ftl:[]u8,fid:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        if((g32(fm,ro) as i32)==fid){
            let to:i32=g32(fm,ro+16) as i32;
            let tl:i32=g32(fm,ro+20) as i32;
            return last_digit_buf(ftl,to,tl);
        }
        fx=fx+1;
    }
    return -1;
}

// --- append fact fid's text to resp; strip_dot removes a trailing "." ---
fn fact_text_into(resp:[]u8,fm:[]u8,ftx:[]u8,fid:i32,strip_dot:i32)void {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    let hit:i32=0;
    while(fx<nf && hit==0){
        let ro:i32=8+fx*40;
        if((g32(fm,ro) as i32)==fid){
            let to:i32=g32(fm,ro+16) as i32;
            let tl:i32=g32(fm,ro+20) as i32;
            if(strip_dot==1 && tl>0 && ftx[to+tl-1]==46){ tl=tl-1; }
            rput(resp,ftx,to,tl);
            hit=1;
        }
        fx=fx+1;
    }
    return;
}

// --- challenge defense: "Yes. <fact>[, not <n>]. I was taught that."
// chall >= 0: the challenge named a conflicting digit -> address it. ---
fn do_defense(resp:[]u8,fm:[]u8,ftx:[]u8,nbuf:[]u8,fid:i32,chall:i32)void {
    rclr(resp);
    rput(resp,"Yes. ",0,5);
    if(chall>=0){ fact_text_into(resp,fm,ftx,fid,1); }
    else{ fact_text_into(resp,fm,ftx,fid,0); }
    if(chall>=0){
        rput(resp,", not ",0,6);
        let nl:i32=i64str(chall as i64,nbuf);
        rput(resp,nbuf,0,nl);
        rput(resp,".",0,1);
    }
    rput(resp," I was taught that.",0,19);
    return;
}

// --- provenance: "I was taught that <fact>." Honest basis, no invented source. ---
fn do_provenance(resp:[]u8,fm:[]u8,ftx:[]u8,fid:i32)void {
    rclr(resp);
    rput(resp,"I was taught that ",0,18);
    fact_text_into(resp,fm,ftx,fid,0);
    return;
}

// --- F5 utterance-type dispatcher (2026-09-23) ---
// Classifies the input BEFORE any retrieval: 1=joke request, 2=memory/
// history question, 3=forget instruction, 0=other (normal pipeline).
// Token-level matching on the lowercased input buffer (no substring hits).

// token-level literal match: walks alnum-separated tokens
fn tok_has(ubuf:[]u8,uo:i32,ul:i32,lit:[]u8)i32 {
    let i:i32=0;
    while(i<ul){
        while(i<ul && is_alnum(ubuf[uo+i])==0){ i=i+1; }
        if(i<ul){
            let ts:i32=i;
            while(i<ul && is_alnum(ubuf[uo+i])==1){ i=i+1; }
            if(beq(ubuf,uo+ts,i-ts,lit)==1){ return 1; }
        }
    }
    return 0;
}

// memory-question shape: "remember"/"recall", or self-referential past
// speech ("what was the first thing i asked?", "my second question").
// (widened from did+i+verb during scaffold: "was" is as common as "did".)
fn is_mem_q(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(tok_has(ubuf,uo,ul,"remember")==1){ return 1; }
    if(tok_has(ubuf,uo,ul,"recall")==1){ return 1; }
    let self:i32=0;
    if(tok_has(ubuf,uo,ul,"i")==1){ self=1; }
    if(tok_has(ubuf,uo,ul,"my")==1){ self=1; }
    if(self==1){
        if(tok_has(ubuf,uo,ul,"ask")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"asked")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"say")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"said")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"tell")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"told")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"question")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"questions")==1){ return 1; }
    }
    return 0;
}

// dispatcher: 1=joke 2=memory 3=forget 0=other. Precedence: forget > joke > memory.
fn utter_type(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(tok_has(ubuf,uo,ul,"forget")==1){ return 3; }
    if(tok_has(ubuf,uo,ul,"forgot")==1){ return 3; }
    if(tok_has(ubuf,uo,ul,"forgotten")==1){ return 3; }
    if(tok_has(ubuf,uo,ul,"joke")==1){ return 1; }
    if(tok_has(ubuf,uo,ul,"jokes")==1){ return 1; }
    if(is_mem_q(ubuf,uo,ul)==1){ return 2; }
    return 0;
}

// ordinal token scan via the number-word table (first->1 .. thirtieth->30)
fn mem_ord(ubuf:[]u8,uo:i32,ul:i32)i32 {
    let i:i32=0;
    while(i<ul){
        while(i<ul && is_alnum(ubuf[uo+i])==0){ i=i+1; }
        if(i<ul){
            let ts:i32=i;
            while(i<ul && is_alnum(ubuf[uo+i])==1){ i=i+1; }
            let v:i64=numword_val(ubuf,uo+ts,i-ts);
            if(v>0){ return v as i32; }
        }
    }
    return 0;
}


// --- F5: read back the write-only history. kind-0 rows are user turns; the
// last row is always the current turn (main records it before do_turn), so
// recall scans rows [0, n-1). Selects by ordinal; default = most recent.
fn mem_answer(resp:[]u8,ubuf:[]u8,uo:i32,ul:i32,hist:[]u8,histb:[]u8)void {
    let n:i32=g32(hist,0) as i32;
    let c:i32=0;
    let hx:i32=0;
    while(hx<n-1){
        if((g32(hist,4+hx*12) as i32)==0){ c=c+1; }
        hx=hx+1;
    }
    if(c==0){
        let nm:[]u8="You haven't asked anything before this.";
        rput(resp,nm,0,nm.len);
        return;
    }
    let sel:i32=c-1;
    let done:i32=0;
    if(tok_has(ubuf,uo,ul,"first")==1){ sel=0; done=1; }
    if(done==0 && tok_has(ubuf,uo,ul,"last")==1){ done=1; }
    if(done==0 && tok_has(ubuf,uo,ul,"previous")==1){ done=1; }
    if(done==0 && tok_has(ubuf,uo,ul,"latest")==1){ done=1; }
    if(done==0){
        let on:i32=mem_ord(ubuf,uo,ul);
        if(on>0 && on<=c){ sel=on-1; }
    }
    let seen:i32=0;
    let row:i32=-1;
    hx=0;
    while(hx<n-1){
        if((g32(hist,4+hx*12) as i32)==0){
            if(seen==sel){ row=hx; }
            seen=seen+1;
        }
        hx=hx+1;
    }
    if(row<0){ row=n-2; }
    let ho:i32=g32(hist,4+row*12+4) as i32;
    let hl:i32=g32(hist,4+row*12+8) as i32;
    let pre:[]u8="You asked: ";
    rput(resp,pre,0,pre.len);
    rput(resp,histb,ho,hl);
    return;
}

// --- F1-COMPARE (2026-09-23): general comparison engine ---
// Replaces the two frozen string-prefix branches ("was the author of" and
// "which is taller"). Intent = comparison WORDS anywhere in the turn
// (grammatical class, not phrasing); entities = resolved mentions (full
// names or distinctive single words like "darwin"); values = data-driven
// marker scan via the existing year_of(); answer = yes/no or winner.
// No per-phrasing branches, no per-entity special cases.
fn needs_the(gnames:[]u8,wno:i32,wnl:i32)i32 {
    if(wnl==12 && beq2(gnames,wno,"eiffel tower",0,12)==1){ return 1; }
    if(wnl==18 && beq2(gnames,wno,"montparnasse tower",0,18)==1){ return 1; }
    if(wnl==17 && beq2(gnames,wno,"statue of liberty",0,17)==1){ return 1; }
    if(wnl==6 && beq2(gnames,wno,"louvre",0,6)==1){ return 1; }
    if(wnl==9 && beq2(gnames,wno,"colosseum",0,9)==1){ return 1; }
    return 0;
}
// word_entity: eid of the UNIQUE entity containing the word
// buf[bo+pos..bo+pos+wl) as one of its name-words, else -1.
// A word shared by 2+ entities ("tower") is never distinctive.
fn word_entity(gnames:[]u8,ge:[]u8,buf:[]u8,bo:i32,pos:i32,wl:i32)i32 {
    let ne:i32=g32(ge,0) as i32;
    let hit:i32=-1;
    let n:i32=0;
    let e:i32=0;
    while(e<ne){
        let no:i32=g32(ge,8+e*16) as i32;
        let nl:i32=g32(ge,8+e*16+4) as i32;
        let s:i32=0;
        let f:i32=0;
        while(s<nl && f==0){
            while(s<nl && gnames[no+s]==32){ s=s+1; }
            let ws:i32=s;
            while(s<nl && gnames[no+s]!=32){ s=s+1; }
            if(s-ws==wl && beq2(buf,bo+pos,gnames,no+ws,wl)==1){ f=1; }
        }
        if(f==1){ n=n+1; hit=e; }
        e=e+1;
    }
    if(n==1){ return hit; }
    return -1;
}
// cmp_scan: position-ordered entity mentions over a resolved turn.
// Full-name match preferred (first gord hit, like gaz_scan); otherwise a
// distinctive single name-word (len>=4, unique to one entity).
fn cmp_scan(gnames:[]u8,ge:[]u8,gord:[]u8,buf:[]u8,bo:i32,bl:i32,out:[]u8,excl:i32)i32 {
    let ng:i32=g32(gord,0) as i32;
    let n:i32=0;
    let pos:i32=0;
    while(pos<bl){
        let hit:i32=-1;
        let hlen:i32=0;
        let oi:i32=0;
        while(oi<ng && hit<0){
            let eid:i32=g32(gord,4+oi*4) as i32;
            if(eid!=excl){
                let no:i32=g32(ge,8+eid*16) as i32;
                let nl:i32=g32(ge,8+eid*16+4) as i32;
                if(pos+nl<=bl && beq2(buf,bo+pos,gnames,no,nl)==1){ hit=eid; hlen=nl; }
            }
            oi=oi+1;
        }
        if(hit<0){
            let start:i32=0;
            if(pos==0){ start=1; }
            if(pos>0 && buf[bo+pos-1]==32){ start=1; }
            if(start==1){
                let wl:i32=0;
                while(pos+wl<bl && buf[bo+pos+wl]!=32){ wl=wl+1; }
                if(wl>=4){
                    let we:i32=word_entity(gnames,ge,buf,bo,pos,wl);
                    if(we>=0){ hit=we; hlen=wl; }
                }
            }
        }
        if(hit>=0){ p32(out,n*4,hit); n=n+1; pos=pos+hlen; }
        if(hit<0){ pos=pos+1; }
    }
    return n;
}
// time_marker_idx: index of the first-hitting TIME marker for eid, else -1.
// Marker order is KB-shape-driven (persons->born, towers->built, ...) and
// fixed; it works for any entity without consulting the question phrasing.
// 0:born 1:built 2:published 3:completed 4:dedicated 5:opened
fn time_marker_idx(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32)i32 {
    if(year_of(fm,fea,ftl,gnames,ge,eid," born ",6)>=0){ return 0; }
    if(year_of(fm,fea,ftl,gnames,ge,eid," built ",7)>=0){ return 1; }
    if(year_of(fm,fea,ftl,gnames,ge,eid," published ",11)>=0){ return 2; }
    if(year_of(fm,fea,ftl,gnames,ge,eid," completed ",11)>=0){ return 3; }
    if(year_of(fm,fea,ftl,gnames,ge,eid," dedicated ",11)>=0){ return 4; }
    if(year_of(fm,fea,ftl,gnames,ge,eid," opened ",8)>=0){ return 5; }
    return -1;
}
fn time_val(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32,mi:i32)i32 {
    if(mi==0){ return year_of(fm,fea,ftl,gnames,ge,eid," born ",6); }
    if(mi==1){ return year_of(fm,fea,ftl,gnames,ge,eid," built ",7); }
    if(mi==2){ return year_of(fm,fea,ftl,gnames,ge,eid," published ",11); }
    if(mi==3){ return year_of(fm,fea,ftl,gnames,ge,eid," completed ",11); }
    if(mi==4){ return year_of(fm,fea,ftl,gnames,ge,eid," dedicated ",11); }
    return year_of(fm,fea,ftl,gnames,ge,eid," opened ",8);
}
// cmp_yesno: the turn asks for yes/no iff it opens with an auxiliary verb.
fn cmp_yesno(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(starts_with(ubuf,uo,ul,"was ",4)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"is ",3)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"are ",4)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"were ",5)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"did ",4)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"do ",3)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"does ",5)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"has ",4)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"have ",5)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"can ",4)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"could ",6)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"would ",6)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"will ",5)==1){ return 1; }
    return 0;
}
// do_compare: general comparison. Returns 1 with the response written, else 0
// (caller falls through to retrieval). Stores the compared pair at pv+40/44
// for "those two"-style anaphora on later turns.
// === CMP-ENGINE (prototype, 2026-09-23) ===
// Principled comparison to replace the keyword-scan do_compare.
// Typed attribute model: entity -> dimension (1=HEIGHT_M, 2=YEAR) -> i32.
// Operators: max/min/eq/neq over entity values, or vs a literal threshold.
// Negation scope ("not" flips the outcome). Multi-hop "author of <work>"
// substitution (textual, before mention scanning). N-way superlative
// reduction over ALL mentions (order-invariant). before-or-after
// disjunction answers. Missing attribute -> "I don't know." (handled,
// not fallen through).
// Contract (same as baseline): 1 = response written, 0 = fall through to
// retrieval. Compared pair stored at pv+40/44 for "those two" anaphora.

// ce_num_after: parse optional '-' then digits at/after absolute pos p in
// buf[bo..bo+bl) (skips spaces). Writes the value to v[0]; returns 1 if a
// number was found, else 0.
fn ce_num_after(buf:[]u8,bo:i32,bl:i32,p:i32,v:[]u8)i32 {
    while(p<bo+bl && buf[p]==32){ p=p+1; }
    let neg:i32=0;
    if(p<bo+bl && buf[p]==45){ neg=1; p=p+1; }
    let val:i32=0;
    let d:i32=0;
    while(p<bo+bl && buf[p]>=48 && buf[p]<=57){
        val=val*10+((buf[p] as i32)-48);
        p=p+1;
        d=1;
    }
    if(d==0){ return 0; }
    if(neg==1){ val=0-val; }
    p32(v,0,val);
    return 1;
}
// ce_digits_ahead: 1 if the next non-space char at/after p starts a number
// (optional leading '-').
fn ce_digits_ahead(buf:[]u8,bo:i32,bl:i32,p:i32)i32 {
    while(p<bo+bl && buf[p]==32){ p=p+1; }
    if(p<bo+bl && buf[p]==45){ p=p+1; }
    if(p<bo+bl && buf[p]>=48 && buf[p]<=57){ return 1; }
    return 0;
}
// ce_has: 1 if any of the given words occurs in buf[bo..bo+bl).
// words are passed as a |-separated list in wbuf.
fn ce_has(buf:[]u8,bo:i32,bl:i32,wbuf:[]u8)i32 {
    let wp:i32=0;
    let wl:i32=wbuf.len;
    while(wp<wl){
        let s:i32=wp;
        while(wp<wl && wbuf[wp]!=124){ wp=wp+1; }
        if(wp-s>0 && find_sub(buf,bo,bl,wbuf,s,wp-s)>=0){ return 1; }
        wp=wp+1;
    }
    return 0;
}
// ce_dim_hint: 1=height words present, 2=year words present (bitmask: 1|2).
fn ce_dim_hint(buf:[]u8,bo:i32,bl:i32)i32 {
    let r:i32=0;
    if(ce_has(buf,bo,bl,"taller|tallest|shorter|shortest|higher|highest|lower|lowest|tall|height|meters|meter")==1){ r=r+1; }
    if(ce_has(buf,bo,bl,"born|built|published|completed|dedicated|opened|before|after|earlier|later|older|younger|first|last|year|years")==1){ r=r+2; }
    return r;
}
// ce_attr: typed attribute value for eid; -1 if unknown.
fn ce_attr(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32,dim:i32)i32 {
    if(dim==1){ return year_of(fm,fea,ftl,gnames,ge,eid,"tall",4); }
    if(dim==2){
        let mi:i32=time_marker_idx(fm,fea,ftl,gnames,ge,eid);
        if(mi<0){ return -1; }
        return time_val(fm,fea,ftl,gnames,ge,eid,mi);
    }
    return -1;
}
// ce_ent_at: entity id of the name starting at absolute pos j (full name
// via gord, else distinctive word). Returns eid or -1; length via *elen.
fn ce_ent_at(gnames:[]u8,ge:[]u8,gord:[]u8,buf:[]u8,bo:i32,bl:i32,j:i32,elen:[]u8)i32 {
    let ng:i32=g32(gord,0) as i32;
    let oi:i32=0;
    while(oi<ng){
        let ce:i32=g32(gord,4+oi*4) as i32;
        let no:i32=g32(ge,8+ce*16) as i32;
        let nl:i32=g32(ge,8+ce*16+4) as i32;
        if(j+nl<=bo+bl && beq2(buf,j,gnames,no,nl)==1){
            p32(elen,0,nl);
            return ce;
        }
        oi=oi+1;
    }
    let wl:i32=0;
    while(j+wl<bo+bl && buf[j+wl]!=32 && buf[j+wl]!=63 && buf[j+wl]!=46 && buf[j+wl]!=44){ wl=wl+1; }
    if(wl>=4){
        let we:i32=word_entity(gnames,ge,buf,j,0,wl);
        if(we>=0){ p32(elen,0,wl); return we; }
    }
    p32(elen,0,0);
    return -1;
}
// ce_hop_subst: copy [uo,uo+ul) to out, rewriting each "author of <work>"
// span to the author's name. Returns output length.
fn ce_hop_subst(ubuf:[]u8,uo:i32,ul:i32,fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,out:[]u8,elen:[]u8)i32 {
    let w:i32=0;
    let i:i32=uo;
    while(i<uo+ul){
        if(find_sub(ubuf,i,uo+ul-i,"author of ",0,10)==0){
            let j:i32=i+10;
            let eid:i32=ce_ent_at(gnames,ge,gord,ubuf,uo,ul,j,elen);
            let el:i32=g32(elen,0) as i32;
            if(eid<0){
                // maybe "author of the <name>": skip one "the "
                if(find_sub(ubuf,j,uo+ul-j,"the ",0,4)==0){
                    eid=ce_ent_at(gnames,ge,gord,ubuf,uo,ul,j+4,elen);
                    el=(g32(elen,0) as i32)+4;
                }
            }
            let done:i32=0;
            if(eid>=0 && (g32(ge,8+eid*16+8) as i32)==1){
                let au:i32=author_of(fm,fea,ftl,gnames,ge,eid);
                if(au>=0){
                    let no:i32=g32(ge,8+au*16) as i32;
                    let nl:i32=g32(ge,8+au*16+4) as i32;
                    let k:i32=0;
                    while(k<nl){ out[w]=gnames[no+k]; w=w+1; k=k+1; }
                    i=j+el;
                    done=1;
                }
            }
            if(done==0){
                out[w]=ubuf[i]; w=w+1; i=i+1;
            }
        } else {
            out[w]=ubuf[i]; w=w+1; i=i+1;
        }
    }
    return w;
}
// ce_pick: find the fired comparative. Writes wc[0]=word class
// (0 taller 1 shorter 2 tallest 3 shortest 4 higher 5 lower 6 first 7 last)
// and wc[1]=match position (for negation scope). Returns 1 if found.
fn ce_pick(buf:[]u8,bo:i32,bl:i32,wc:[]u8)i32 {
    // longest-first so "tallest" beats "tall", etc.
    let q:i32=-1;
    q=find_sub(buf,bo,bl,"tallest",0,7); if(q>=0){ p32(wc,0,2); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"shortest",0,8); if(q>=0){ p32(wc,0,3); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"highest",0,7); if(q>=0){ p32(wc,0,4); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"lowest",0,6); if(q>=0){ p32(wc,0,5); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"earliest",0,8); if(q>=0){ p32(wc,0,6); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"latest",0,6); if(q>=0){ p32(wc,0,7); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"taller",0,6); if(q>=0){ p32(wc,0,0); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"shorter",0,7); if(q>=0){ p32(wc,0,1); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"higher",0,6); if(q>=0){ p32(wc,0,4); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"lower",0,5); if(q>=0){ p32(wc,0,5); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"older",0,5); if(q>=0){ p32(wc,0,6); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"oldest",0,6); if(q>=0){ p32(wc,0,6); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"younger",0,7); if(q>=0){ p32(wc,0,7); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"youngest",0,8); if(q>=0){ p32(wc,0,7); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"earlier",0,7); if(q>=0){ p32(wc,0,6); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"later",0,5); if(q>=0){ p32(wc,0,7); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"before",0,6); if(q>=0){ p32(wc,0,6); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"after",0,5); if(q>=0){ p32(wc,0,7); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"first",0,5); if(q>=0){ p32(wc,0,6); p32(wc,4,q); return 1; }
    q=find_sub(buf,bo,bl,"last",0,4); if(q>=0){ p32(wc,0,7); p32(wc,4,q); return 1; }
    return 0;
}
// ce_rname: write winner name (with "the " when needed) into resp.
fn ce_rname(resp:[]u8,gnames:[]u8,ge:[]u8,eid:i32)void {
    let wno:i32=g32(ge,8+eid*16) as i32;
    let wnl:i32=g32(ge,8+eid*16+4) as i32;
    if(needs_the(gnames,wno,wnl)==1){ rput(resp,"the ",0,4); }
    rput(resp,gnames,wno,wnl);
    return;
}
// ce_which_t: write " was <marker> first./last." for a time winner.
fn ce_which_t(resp:[]u8,fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32,ismin:i32)void {
    let wmi:i32=time_marker_idx(fm,fea,ftl,gnames,ge,eid);
    if(wmi==0){ rput(resp," was born ",0,10); }
    if(wmi==1){ rput(resp," was built ",0,11); }
    if(wmi==2){ rput(resp," was published ",0,15); }
    if(wmi==3){ rput(resp," was completed ",0,15); }
    if(wmi==4){ rput(resp," was dedicated ",0,15); }
    if(wmi==5){ rput(resp," was opened ",0,12); }
    if(ismin==1){ rput(resp,"first.",0,6); }
    if(ismin==0){ rput(resp,"last.",0,5); }
    return;
}
// do_compare: principled comparison engine (replaces the keyword-scan
// version). Same signature and contract. o[] layout: caller scratch.
fn do_compare(ubuf:[]u8,uo:i32,ul:i32,sal:[]u8,pv:[]u8,fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,resp:[]u8)i32 {
    // bout (256B) doubles as the hop-substitution buffer; questions fit.
    let elen:[]u8=nio_alloc(8);
    let sl:i32=ce_hop_subst(ubuf,uo,ul,fm,fea,ftl,gnames,ge,gord,bout,elen);
    // --- operator + dimension detection on substituted text ---
    // op: 0=max 1=min 2=eq 3=neq 4=beforeafter 5=thresh_max 6=thresh_min
    let op:i32=-1;
    let dim:i32=0;
    let lit:i32=-1;
    let wc:i32=0;
    let opp:i32=-1;
    let q:i32=find_sub(bout,0,sl,"before or after",0,15);
    if(q>=0){ op=4; dim=2; opp=q; }
    if(op<0){
        q=find_sub(bout,0,sl,"more than",0,9);
        if(q>=0 && ce_num_after(bout,0,sl,q+9,elen)==1){
            lit=g32(elen,0) as i32; op=5; opp=q;
        }
    }
    if(op<0){
        q=find_sub(bout,0,sl,"less than",0,9);
        if(q>=0 && ce_num_after(bout,0,sl,q+9,elen)==1){
            lit=g32(elen,0) as i32; op=6; opp=q;
        }
    }
    if(op<0){
        q=find_sub(bout,0,sl,"fewer than",0,10);
        if(q>=0 && ce_num_after(bout,0,sl,q+10,elen)==1){
            lit=g32(elen,0) as i32; op=6; opp=q;
        }
    }
    if(op<0){
        // "before N"/"after N" with a numeric literal = threshold
        q=find_sub(bout,0,sl,"before",0,6);
        if(q>=0 && ce_digits_ahead(bout,0,sl,q+6)==1
           && ce_num_after(bout,0,sl,q+6,elen)==1){
            lit=g32(elen,0) as i32; op=6; dim=2; opp=q;
        }
    }
    if(op<0){
        q=find_sub(bout,0,sl,"after",0,5);
        if(q>=0 && ce_digits_ahead(bout,0,sl,q+5)==1
           && ce_num_after(bout,0,sl,q+5,elen)==1){
            lit=g32(elen,0) as i32; op=5; dim=2; opp=q;
        }
    }
    if(op<0){
        if(find_sub(bout,0,sl,"same",0,4)>=0){
            op=2; opp=find_sub(bout,0,sl,"same",0,4);
            if(ce_has(bout,0,sl,"year|years")==1){ dim=2; }
            if(ce_has(bout,0,sl,"height|tall|taller")==1){ dim=1; }
        }
    }
    if(op<0){
        if(find_sub(bout,0,sl,"different",0,9)>=0){
            op=3; opp=find_sub(bout,0,sl,"different",0,9);
            if(ce_has(bout,0,sl,"year|years")==1){ dim=2; }
            if(ce_has(bout,0,sl,"height|tall|taller")==1){ dim=1; }
        }
    }
    if(op<0){
        let wcb:[]u8=nio_alloc(8);
        if(ce_pick(bout,0,sl,wcb)==1){
            wc=g32(wcb,0) as i32;
            opp=g32(wcb,4) as i32;
            // map wc -> (op, dim)
            if(wc==0 || wc==2 || wc==4){ op=0; dim=1; }
            if(wc==1 || wc==3 || wc==5){ op=1; dim=1; }
            if(wc==6){ op=1; dim=2; }
            if(wc==7){ op=0; dim=2; }
            // "taller than N" / "shorter than N": comparative + literal
            // threshold. Only fires when "than" is followed by a number
            // (entity comparisons like "taller than Y" are unaffected).
            if(op==0 || op==1){
                let tq:i32=find_sub(bout,opp,sl-opp,"than",0,4);
                if(tq>=0 && ce_digits_ahead(bout,0,sl,opp+tq+4)==1
                   && ce_num_after(bout,0,sl,opp+tq+4,elen)==1){
                    lit=g32(elen,0) as i32;
                    if(op==0){ op=5; } else { op=6; }
                }
            }
        }
        nio_free(wcb);
    }
    if(op<0){ nio_free(elen); return 0; }
    if((op==5 || op==6) && dim==0){
        // threshold dimension from nearby words
        let h:i32=ce_dim_hint(bout,0,sl);
        if((h & 1)==1 && (h & 2)==0){ dim=1; }
        if((h & 2)==2 && (h & 1)==0){ dim=2; }
        if((h & 1)==1 && (h & 2)==2){
            if(ce_has(bout,0,sl,"meter|tall|height")==1){ dim=1; }
            if(dim==0){ dim=2; }
        }
    }
    if(dim==0){ nio_free(elen); return 0; }
    // --- negation scope: "not"/"n't" before the operator ---
    let neg:i32=0;
    let nq:i32=find_sub(bout,0,sl," not ",0,5);
    if(nq>=0 && nq<opp){ neg=1; }
    if(neg==0){
        nq=find_sub(bout,0,sl,"n't ",0,4);
        if(nq>=0 && nq<opp){ neg=1; }
    }
    // --- entity mentions (position-ordered) + anaphora fallback ---
    let ne:i32=cmp_scan(gnames,ge,gord,bout,0,sl,eout,-1);
    if(ne<2){
        let ana:i32=0;
        if(find_sub(ubuf,uo,ul,"those two",0,9)>=0){ ana=1; }
        if(find_sub(ubuf,uo,ul,"these two",0,9)>=0){ ana=1; }
        if(find_sub(ubuf,uo,ul,"the two",0,7)>=0){ ana=1; }
        if(find_sub(ubuf,uo,ul,"either",0,6)>=0){ ana=1; }
        if(ana==1){
            let p1:i32=g32(pv,40) as i32;
            let p2:i32=g32(pv,44) as i32;
            if(p1>=0 && p2>=0){
                p32(eout,0,p1); p32(eout,4,p2);
                ne=2;
            }
        }
    }
    // thresholds compare one entity against a literal: need only 1 mention
    let need:i32=2;
    if(op==5 || op==6){ need=1; }
    if(ne<need){ nio_free(elen); return 0; }
    // --- values ---
    let k:i32=0;
    while(k<ne){
        let eid:i32=g32(eout,k*4) as i32;
        p32(eout2,k*4,ce_attr(fm,fea,ftl,gnames,ge,eid,dim));
        k=k+1;
    }
    let v0:i32=g32(eout2,0) as i32;
    let v1:i32=g32(eout2,4) as i32;
    let e0:i32=g32(eout,0) as i32;
    let e1:i32=g32(eout,4) as i32;
    // missing attribute on a known dimension -> honest withhold
    if(op==4 || op==2 || op==3){
        if(v0<0 || v1<0){
            rclr(resp); rput(resp,"I don't know.",0,13);
            nio_free(elen); return 1;
        }
    }
    if((op==0 || op==1 || op==5 || op==6) && v0<0){
        rclr(resp); rput(resp,"I don't know.",0,13);
        nio_free(elen); return 1;
    }
    if((op==0 || op==1) && v1<0){
        rclr(resp); rput(resp,"I don't know.",0,13);
        nio_free(elen); return 1;
    }
    let yn:i32=cmp_yesno(ubuf,uo,ul);
    // --- before-or-after disjunction ---
    if(op==4){
        rclr(resp);
        if(v0<v1){ rput(resp,"before.",0,7); }
        if(v0>=v1){ rput(resp,"after.",0,6); }
        p32(pv,40,e0); p32(pv,44,e1);
        nio_free(elen); return 1;
    }
    // --- thresholds ---
    if(op==5 || op==6){
        if(yn==0){ nio_free(elen); return 0; }
        let base:i32=0;
        if(op==5 && v0>lit){ base=1; }
        if(op==6 && v0<lit){ base=1; }
        if(neg==1){ base=1-base; }
        rclr(resp);
        if(base==1){ rput(resp,"yes.",0,4); }
        if(base==0){ rput(resp,"no.",0,3); }
        p32(pv,40,e0); p32(pv,44,-1);
        nio_free(elen); return 1;
    }
    // --- same / different ---
    if(op==2 || op==3){
        if(yn==0){ nio_free(elen); return 0; }
        let base:i32=0;
        if(op==2 && v0==v1){ base=1; }
        if(op==3 && v0!=v1){ base=1; }
        if(neg==1){ base=1-base; }
        rclr(resp);
        if(base==1){ rput(resp,"yes.",0,4); }
        if(base==0){ rput(resp,"no.",0,3); }
        p32(pv,40,e0); p32(pv,44,e1);
        nio_free(elen); return 1;
    }
    // --- max / min ---
    let ismax:i32=0;
    if(op==0){ ismax=1; }
    if(neg==1){ ismax=1-ismax; }
    if(yn==1){
        let base:i32=0;
        if(ismax==1 && v0>v1){ base=1; }
        if(ismax==0 && v0<v1){ base=1; }
        rclr(resp);
        if(base==1){ rput(resp,"yes.",0,4); }
        if(base==0){ rput(resp,"no.",0,3); }
        p32(pv,40,e0); p32(pv,44,e1);
        nio_free(elen); return 1;
    }
    // which-question: n-way reduction over ALL mentions (order-invariant)
    let win:i32=e0;
    let wv:i32=v0;
    k=1;
    while(k<ne){
        let ek:i32=g32(eout,k*4) as i32;
        let vk:i32=g32(eout2,k*4) as i32;
        if(vk>=0){
            if(ismax==1 && vk>wv){ win=ek; wv=vk; }
            if(ismax==0 && vk<wv){ win=ek; wv=vk; }
        }
        k=k+1;
    }
    rclr(resp);
    ce_rname(resp,gnames,ge,win);
    if(dim==1){
        if(ismax==1){
            if(wc==2){ rput(resp," is tallest.",0,12); }
            if(wc==4){ rput(resp," is higher.",0,11); }
            if(wc!=2 && wc!=4){ rput(resp," is taller.",0,11); }
        }
        if(ismax==0){
            if(wc==3){ rput(resp," is shortest.",0,13); }
            if(wc==5){ rput(resp," is lower.",0,10); }
            if(wc!=3 && wc!=5){ rput(resp," is shorter.",0,12); }
        }
    }
    if(dim==2){
        ce_which_t(resp,fm,fea,ftl,gnames,ge,win,1-ismax);
    }
    p32(pv,40,e0); p32(pv,44,e1);
    nio_free(elen);
    return 1;
}

// --- F3-ARITHMETIC (2026-09-23): how-much-difference questions ---
// "how much taller is it?" / "how many years between X and Y?" /
// "what is the difference in height between X and Y?"
// The entity pair is explicit in the question or carried from the
// immediately preceding comparison turn (pv slots 32/36/52). Values are
// looked up LIVE from the KB and subtracted; only entity ids (discourse
// referents, like the pronoun binder's) cross turns -- never answers.

// dim: 1=height, 2=years, 0=not a difference question
fn diff_dim(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(find_sub(ubuf,uo,ul,"how much taller",0,15)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"how much older",0,14)>=0){ return 2; }
    if(find_sub(ubuf,uo,ul,"how many years between",0,21)>=0){ return 2; }
    if(find_sub(ubuf,uo,ul,"difference in height",0,19)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"difference in years",0,19)>=0){ return 2; }
    if(find_sub(ubuf,uo,ul,"how much",0,8)>=0){
        if(find_sub(ubuf,uo,ul,"taller",0,6)>=0){ return 1; }
        if(find_sub(ubuf,uo,ul,"older",0,5)>=0){ return 2; }
        if(find_sub(ubuf,uo,ul,"longer",0,6)>=0){ return 1; }
        if(find_sub(ubuf,uo,ul,"bigger",0,6)>=0){ return 1; }
        if(find_sub(ubuf,uo,ul,"smaller",0,7)>=0){ return 1; }
    }
    return 0;
}

// minimum |occurrence - p| of word w in (ubuf,uo,ul); -1 if absent
fn mindist(ubuf:[]u8,uo:i32,ul:i32,w:[]u8,wl:i32,p:i32)i32 {
    let best:i32=-1;
    let off:i32=0;
    let go:i32=1;
    while(go==1){
        let at:i32=find_sub(ubuf,uo+off,ul-off,w,0,wl);
        if(at<0){ go=0; }
        if(at>=0){
            let ap:i32=off+at;
            let d:i32=ap-p;
            if(d<0){ d=0-d; }
            if(best<0 || d<best){ best=d; }
            off=ap+1;
            if(off>=ul){ go=0; }
        }
    }
    return best;
}

// event index nearest position p: 0=born 1=built 2=published 3=dedicated
// 4=opened 5=completed 6=won; -1 if no event word in the question
fn nearest_event(ubuf:[]u8,uo:i32,ul:i32,p:i32)i32 {
    let best:i32=-1;
    let bd:i32=2147483647;
    let d:i32=mindist(ubuf,uo,ul,"born",4,p);
    if(d>=0 && d<bd){ bd=d; best=0; }
    d=mindist(ubuf,uo,ul,"built",5,p);
    if(d>=0 && d<bd){ bd=d; best=1; }
    d=mindist(ubuf,uo,ul,"published",9,p);
    if(d>=0 && d<bd){ bd=d; best=2; }
    d=mindist(ubuf,uo,ul,"dedicated",9,p);
    if(d>=0 && d<bd){ bd=d; best=3; }
    d=mindist(ubuf,uo,ul,"opened",6,p);
    if(d>=0 && d<bd){ bd=d; best=4; }
    d=mindist(ubuf,uo,ul,"opening",7,p);
    if(d>=0 && d<bd){ bd=d; best=4; }
    d=mindist(ubuf,uo,ul,"completed",9,p);
    if(d>=0 && d<bd){ bd=d; best=5; }
    d=mindist(ubuf,uo,ul,"won",3,p);
    if(d>=0 && d<bd){ bd=d; best=6; }
    return best;
}

// year value of the lowest-fid fact naming eid with the given event marker
fn year_val_ev(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32,ev:i32)i32 {
    if(ev==0){ return year_of(fm,fea,ftl,gnames,ge,eid," born ",6); }
    if(ev==1){ return year_of(fm,fea,ftl,gnames,ge,eid," built ",7); }
    if(ev==2){ return year_of(fm,fea,ftl,gnames,ge,eid," published ",11); }
    if(ev==3){ return year_of(fm,fea,ftl,gnames,ge,eid," dedicated ",11); }
    if(ev==4){ return year_of(fm,fea,ftl,gnames,ge,eid," opened ",8); }
    if(ev==5){ return year_of(fm,fea,ftl,gnames,ge,eid," completed ",11); }
    if(ev==6){ return year_of(fm,fea,ftl,gnames,ge,eid," won ",5); }
    return -1;
}

// years value for eid: the event word nearest the entity's name in the
// question selects the marker; with no event word, priority
// born->built->published->dedicated->opened->completed->won, first KB hit wins
fn ent_year_val(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,ubuf:[]u8,uo:i32,ul:i32,eid:i32)i32 {
    let no:i32=g32(ge,8+eid*16) as i32;
    let nl:i32=g32(ge,8+eid*16+4) as i32;
    let at:i32=find_sub(ubuf,uo,ul,gnames,no,nl);
    if(at>=0){
        let ev:i32=nearest_event(ubuf,uo,ul,at);
        if(ev>=0){
            let v:i32=year_val_ev(fm,fea,ftl,gnames,ge,eid,ev);
            if(v>=0){ return v; }
        }
    }
    let e2:i32=0;
    while(e2<7){
        let v2:i32=year_val_ev(fm,fea,ftl,gnames,ge,eid,e2);
        if(v2>=0){ return v2; }
        e2=e2+1;
    }
    return -1;
}

// --- composition templates; returns 1 if handled (response written) ---

// ================= F2-WITHHOLD repair (2026-09-23, guided release) =================
// Honest "I don't know." path for the step-5 default retrieval. Five sub-checks;
// ANY firing check -> decline, NEVER a fact. General machinery only: no per-probe
// branches, no probe-specific constants. R below is the KB's own stemmed relation
// vocabulary (scales with the KB), not a probe list.
// G1 entity-aboutness: query entities (gazetteer + pronoun-bound) must intersect
//    the best fact's entity list, else the fact is not ABOUT anything asked about.
// G2 relation-demand: a relation word demanded by the query must be a key of the
//    best fact, else the fact cannot satisfy the question.
// G3 demand-focus: a structural demand-focus ("capital of X", "who wrote X",
//    "when was X <rel>", "how tall is X") must share a content key with the fact.
// G4 orphan-aboutness: a specific question naming no entity must have every
//    non-wh content key covered by the fact.
// G5 score floor: a specific question naming no entity needs Jaccard >= 1/4.
// Open-ended requests ("tell me about the tower.") carry no demand-focus and are
// not specific questions, so G3/G4/G5 skip them: low-score open retrieval keeps
// its round-1 behavior (this is what keeps the repair from becoming
// "decline everything").

// vocab id of existing entry, or -1 (never interns)
fn vocab_find(vbytes:[]u8,vent:[]u8,sb:[]u8,so:i32,sl:i32)i32 {
    let n:i32=g32(vent,0) as i32;
    let i:i32=0;
    while(i<n){
        let eo:i32=g32(vent,8+8*i) as i32;
        let el:i32=g32(vent,8+8*i+4) as i32;
        if(el==sl){
            if(beq2(sb,so,vbytes,eo,sl)==1){return i;}
        }
        i=i+1;
    }
    return -1;
}
// byte-compare a vocab id against a literal
fn vid_eq(vbytes:[]u8,vent:[]u8,id:i32,lit:[]u8)i32 {
    let eo:i32=g32(vent,8+8*id) as i32;
    let el:i32=g32(vent,8+8*id+4) as i32;
    if(el!=lit.len){return 0;}
    return beq2(vbytes,eo,lit,0,el);
}
// KB relation vocabulary (stemmed forms as interned by proc_token)
fn is_relkey(vbytes:[]u8,vent:[]u8,id:i32)i32 {
    if(vid_eq(vbytes,vent,id,"wrote")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"written")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"bear")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"build")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"publish")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"discover")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"win")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"capital")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"tall")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"long")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"open")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"dedicate")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"complete")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"landmark")==1){return 1;}
    return 0;
}
fn is_whkey(vbytes:[]u8,vent:[]u8,id:i32)i32 {
    if(vid_eq(vbytes,vent,id,"who")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"what")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"when")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"where")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"which")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"how")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"whom")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"whose")==1){return 1;}
    return 0;
}
fn key_in_fact(keya:[]u8,fko:i32,fkl:i32,qid:i32)i32 {
    let b:i32=0;
    while(b<fkl){
        if((g32(keya,fko+b*4) as i32)==qid){return 1;}
        b=b+1;
    }
    return 0;
}
// specific question: has "?" or starts with a wh-word / demand verb (input lowercased)
fn is_specific(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(find_sub(ubuf,uo,ul,"?",0,1)>=0){return 1;}
    if(starts_with(ubuf,uo,ul,"who",3)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"what",4)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"when",4)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"where",5)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"which",5)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"how",3)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"did ",4)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"does ",5)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"do ",3)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"is ",3)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"are ",4)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"was ",4)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"were ",5)==1){return 1;}
    return 0;
}
// tokenize qbuf[so..so+sl) into content vocab ids (stopwords/digits dropped,
// stemmed+irregular-normed exactly like proc_token, never interning).
// cut_rel=1: stop before the first relation-word token. Returns count.
fn focus_keys(qbuf:[]u8,so:i32,sl:i32,vbytes:[]u8,vent:[]u8,tmp:[]u8,out:[]u8,cap:i32,cut_rel:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    let stop:i32=0;
    while(i<sl && stop==0){
        let ch:u8=qbuf[so+i];
        if(is_alnum(ch)==1){
            let j:i32=i;
            while(j<sl && is_alnum(qbuf[so+j])==1){j=j+1;}
            let tl:i32=j-i;
            let k:i32=0;
            while(k<tl){tmp[k]=to_low(qbuf[so+i+k]);k=k+1;}
            let skip:i32=0;
            if(digit_val(tmp,0,tl)>=0){skip=1;}
            if(skip==0 && numword_val(tmp,0,tl)>=0){skip=1;}
            if(skip==0 && is_stop(tmp,0,tl)==1){skip=1;}
            if(skip==0){
                let st2:i32=stem_inplace(tmp,tl);
                st2=irregular_norm(tmp,st2);
                let id:i32=vocab_find(vbytes,vent,tmp,0,st2);
                if(id>=0){
                    if(cut_rel==1 && is_relkey(vbytes,vent,id)==1){stop=1;}
                    if(stop==0 && n<cap){p32(out,n*4,id);n=n+1;}
                }
            }
            i=j;
        }
        if(is_alnum(ch)==0){i=i+1;}
    }
    return n;
}
// index of the 'o' in the LAST standalone " of " in qbuf, or -1
fn find_last_of(qbuf:[]u8,ql:i32)i32 {
    let i:i32=ql-4;
    while(i>=0){
        if(qbuf[i]==32 && qbuf[i+1]==111 && qbuf[i+2]==102 && qbuf[i+3]==32){return i;}
        i=i-1;
    }
    return -1;
}
// The withhold gate. Returns 1 = decline ("I don't know."), 0 = emit best fact.
fn withhold_check(ubuf:[]u8,uo:i32,ul:i32,qbuf:[]u8,ql:i32,
    kid:[]u8,plen:i32,keya:[]u8,fko:i32,fkl:i32,fea:[]u8,feo:i32,fen:i32,
    eout:[]u8,ne4:i32,bout:[]u8,bn:i32,
    vbytes:[]u8,vent:[]u8,tmp:[]u8,fout:[]u8)i32 {
    let has_qe:i32=0;
    if(ne4>0 || bn>0){has_qe=1;}
    // ---- G1: entity-aboutness ----
    if(has_qe==1){
        let anyhit:i32=0;
        let qi:i32=0;
        while(qi<ne4){
            let qe:i32=g32(eout,qi*4) as i32;
            let k:i32=0;
            while(k<fen){
                if((g32(fea,feo+k*4) as i32)==qe){anyhit=1;}
                k=k+1;
            }
            qi=qi+1;
        }
        let bi2:i32=0;
        while(bi2<bn){
            let qe2:i32=g32(bout,4+bi2*4) as i32;
            let k2:i32=0;
            while(k2<fen){
                if((g32(fea,feo+k2*4) as i32)==qe2){anyhit=1;}
                k2=k2+1;
            }
            bi2=bi2+1;
        }
        if(anyhit==0){return 1;}
    }
    // ---- G2: relation-demand ----
    let q2:i32=0;
    while(q2<plen){
        let qid:i32=g32(kid,q2*4) as i32;
        if(is_relkey(vbytes,vent,qid)==1 && key_in_fact(keya,fko,fkl,qid)==0){return 1;}
        q2=q2+1;
    }
    // ---- G3: demand-focus ----
    let nf:i32=0;
    let ofp:i32=find_last_of(qbuf,ql);
    if(ofp>=0){
        let rs:i32=ofp+3;
        while(rs<ql && qbuf[rs]==32){rs=rs+1;}
        let re:i32=ql;
        while(re>rs && qbuf[re-1]==32){re=re-1;}
        if(re>rs){nf=focus_keys(qbuf,rs,re-rs,vbytes,vent,tmp,fout,64,0);}
    }
    if(ofp<0 && nf==0){
        if(starts_with(qbuf,0,ql,"who wrote ",10)==1){nf=focus_keys(qbuf,10,ql-10,vbytes,vent,tmp,fout,64,0);}
        if(starts_with(qbuf,0,ql,"who discovered ",15)==1){nf=focus_keys(qbuf,15,ql-15,vbytes,vent,tmp,fout,64,0);}
        if(starts_with(qbuf,0,ql,"who is ",7)==1){nf=focus_keys(qbuf,7,ql-7,vbytes,vent,tmp,fout,64,0);}
        if(starts_with(qbuf,0,ql,"who was ",8)==1){nf=focus_keys(qbuf,8,ql-8,vbytes,vent,tmp,fout,64,0);}
        if(starts_with(qbuf,0,ql,"when was ",9)==1){nf=focus_keys(qbuf,9,ql-9,vbytes,vent,tmp,fout,64,1);}
        if(starts_with(qbuf,0,ql,"when did ",9)==1){nf=focus_keys(qbuf,9,ql-9,vbytes,vent,tmp,fout,64,1);}
        if(starts_with(qbuf,0,ql,"was ",4)==1){nf=focus_keys(qbuf,4,ql-4,vbytes,vent,tmp,fout,64,1);}
        if(starts_with(qbuf,0,ql,"how tall is ",12)==1){nf=focus_keys(qbuf,12,ql-12,vbytes,vent,tmp,fout,64,0);}
        if(starts_with(qbuf,0,ql,"how long is ",12)==1){nf=focus_keys(qbuf,12,ql-12,vbytes,vent,tmp,fout,64,0);}
    }
    if(nf>0){
        let covered:i32=0;
        let f3:i32=0;
        while(f3<nf){
            if(key_in_fact(keya,fko,fkl,g32(fout,f3*4) as i32)==1){covered=1;}
            f3=f3+1;
        }
        if(covered==0){return 1;}
    }
    // ---- G4: orphan-aboutness + G5: score floor ----
    // Only when no demand-focus was identified: if the focus WAS identified and
    // covered (G3 passed), a stray unmatched token is a typo/variant of the
    // asked-about entity (round-1 WEIRD typo probes), not an unknown entity.
    if(has_qe==0 && nf==0 && is_specific(ubuf,uo,ul)==1){
        let q4:i32=0;
        while(q4<plen){
            let qid4:i32=g32(kid,q4*4) as i32;
            if(key_in_fact(keya,fko,fkl,qid4)==0 && is_whkey(vbytes,vent,qid4)==0){return 1;}
            q4=q4+1;
        }
        let sc:i64=jscore(kid,plen,keya,fko,fkl);
        let inter:i64=(sc>>32)&4294967295;
        let union:i64=sc&4294967295;
        if(inter*4<union){return 1;}
    }
    return 0;
}
// ================= end F2-WITHHOLD repair =================

fn do_compose(ubuf:[]u8,uo:i32,ul:i32,sal:[]u8,pv:[]u8,fm:[]u8,fea:[]u8,ftl:[]u8,ftx:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,resp:[]u8,nbuf:[]u8,turn_no:i32)i32 {
    // --- F3-ARITHMETIC: how-much-difference questions ---
    // Real subtraction on live KB values. The pair is explicit ("X than Y")
    // or carried from the immediately preceding comparison ("it"). The
    // answer is computed here, never memorized: values come from year_of /
    // ent_year_val at query time. Returns 0 (fall through) when the pair or
    // a value cannot be resolved.
    let ddim:i32=diff_dim(ubuf,uo,ul);
    if(ddim>0){
        let ne_d:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        let d1:i32=-1;
        let d2:i32=-1;
        let kd:i32=0;
        while(kd<ne_d){
            let de:i32=g32(eout,kd*4) as i32;
            if(de!=d1 && d1<0){ d1=de; }
            if(de!=d1 && d2<0){ d2=de; }
            kd=kd+1;
        }
        if(d2<0){
            let ce1:i32=g32(pv,48) as i32;
            let ce2:i32=g32(pv,52) as i32;
            let cturn:i32=g32(pv,60) as i32;
            if(ce1<0 || ce2<0 || cturn<0 || cturn+1!=turn_no){ return 0; }
            if(d1<0){ d1=ce1; d2=ce2; }
            if(d1>=0 && d2<0){
                if(d1==ce1){ d2=ce2; }
                if(d1==ce2){ d2=ce1; }
            }
            if(d2<0){ return 0; }
        }
        let v1:i32=-1;
        let v2:i32=-1;
        if(ddim==1){
            v1=year_of(fm,fea,ftl,gnames,ge,d1,"tall",4);
            v2=year_of(fm,fea,ftl,gnames,ge,d2,"tall",4);
        }
        if(ddim==2){
            v1=ent_year_val(fm,fea,ftl,gnames,ge,ubuf,uo,ul,d1);
            v2=ent_year_val(fm,fea,ftl,gnames,ge,ubuf,uo,ul,d2);
        }
        if(v1<0 || v2<0){ return 0; }
        let df:i64=(v1 as i64)-(v2 as i64);
        if(df<0){ df=0-df; }
        rclr(resp);
        let dnl:i32=i64str(df,nbuf);
        rput(resp,nbuf,0,dnl);
        return 1;
    }
    // F1-COMPARE: general comparison engine (replaces the two frozen
    // string-prefix branches above; did-write and birth-year below unchanged).
    if(do_compare(ubuf,uo,ul,sal,pv,fm,fea,ftl,gnames,ge,gord,eout,eout2,bout,resp)==1){
        // F3-ARITHMETIC carry (merged): the just-compared pair is carried
        // for an immediate follow-up difference question. In F3's fork this
        // write lived inside the old "which is taller" branch; F1's engine
        // replaces that branch, so the carry is written here after ANY
        // successful comparison. Slots per PREREG_INT: pair@48/52, dim@56
        // (write-only, as in F3), turn@60; the F1 pair lives at 40/44.
        p32(pv,48,g32(pv,40) as i32); p32(pv,52,g32(pv,44) as i32);
        p32(pv,56,1); p32(pv,60,turn_no);
        return 1;
    }
    if(starts_with(ubuf,uo,ul,"did ",4)==1 && find_sub(ubuf,uo,ul,"write",0,5)>=0){
        let ne4:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        let person:i32=-1;
        let work2:i32=-1;
        let ao:i32=find_sub(ubuf,uo,ul,"the author of",0,13);
        if(ao>=0){
            let ne5:i32=gaz_scan(gnames,ge,gord,ubuf,uo+ao+13,ul-ao-13,eout2,-1);
            if(ne5<1){ return 0; }
            let wao:i32=g32(eout2,0) as i32;
            person=author_of(fm,fea,ftl,gnames,ge,wao);
            let k2:i32=0;
            while(k2<ne4){
                let e3:i32=g32(eout,k2*4) as i32;
                if((g32(ge,8+e3*16+8) as i32)==1 && e3!=wao && work2<0){ work2=e3; }
                k2=k2+1;
            }
        }
        if(ao<0){
            let k3:i32=0;
            while(k3<ne4){
                let e4:i32=g32(eout,k3*4) as i32;
                if((g32(ge,8+e4*16+8) as i32)==0 && person<0){ person=e4; }
                if((g32(ge,8+e4*16+8) as i32)==1 && work2<0){ work2=e4; }
                k3=k3+1;
            }
        }
        if(person<0 || work2<0){ return 0; }
        let r:i32=wrote_rel(fm,fea,ftl,gnames,ge,person,work2);
        rclr(resp);
        if(r==1){ rput(resp,"yes.",0,4); }
        if(r==0){ rput(resp,"no.",0,3); }
        return 1;
    }
    // --- morphology crew (2026-09-21): "birth year of <person-desc>" ---
    // WE-09 root cause, second half: the keyword core cannot resolve a
    // question-focus ("birth year") against a relative-clause referent
    // ("the guy who wrote the martian") -- the clause's keywords outscore
    // the focus word under Jaccard even after birth<->born bridging
    // (proven: 1/12 < 2/12 in the Python mirror). So resolve the person
    // (named, else author_of(work) via " wrote <work>") and emit their
    // born-fact directly. Placed LAST: never steals the "was the author
    // of" branch (no "birth year" there), the born-assertions (no "birth
    // year" there), or any other turn -- "birth year" occurs exactly once
    // in the frozen battery. Falls through (return 0) when unresolvable.
    if(find_sub(ubuf,uo,ul,"birth year",0,10)>=0){
        let ne_b:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        let person_b:i32=-1;
        let kb2:i32=0;
        while(kb2<ne_b){
            let eb:i32=g32(eout,kb2*4) as i32;
            if((g32(ge,8+eb*16+8) as i32)==0){ person_b=eb; }
            kb2=kb2+1;
        }
        if(person_b<0){
            let wi_b:i32=find_sub(ubuf,uo,ul," wrote ",0,7);
            if(wi_b>=0){
                let ne_w:i32=gaz_scan(gnames,ge,gord,ubuf,uo+wi_b+7,ul-wi_b-7,eout2,-1);
                let kw3:i32=0;
                let work_b:i32=-1;
                while(kw3<ne_w){
                    let ew:i32=g32(eout2,kw3*4) as i32;
                    if((g32(ge,8+ew*16+8) as i32)==1 && work_b<0){ work_b=ew; }
                    kw3=kw3+1;
                }
                if(work_b>=0){ person_b=author_of(fm,fea,ftl,gnames,ge,work_b); }
            }
        }
        if(person_b>=0){
            let bf:i32=born_fact_of(fm,fea,ftl,gnames,ge,person_b);
            if(bf>=0){
                rclr(resp);
                emit_fact(resp,fm,ftx,bf);
                return 1;
            }
        }
        return 0;
    }
    return 0;
}

fn is_correction(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(starts_with(ubuf,uo,ul,"no,",3)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"no ",3)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"not that",8)==1){ return 1; }
    if(find_sub(ubuf,uo,ul,"i meant",0,7)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"the other",0,9)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"another one",0,11)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"other one",0,9)>=0){ return 1; }
    return 0;
}
fn is_resume(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(find_sub(ubuf,uo,ul,"back to",0,7)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"anyway",0,6)>=0){ return 1; }
    return 0;
}

// --- push entities (reverse position order => subject most recent) ---
fn push_ents(sal:[]u8,eids:[]u8,ne:i32)void {
    let k:i32=ne-1;
    while(k>=0){
        sal_push(sal,g32(eids,k*4) as i32);
        k=k-1;
    }
    return;
}
fn push_fact_ents(sal:[]u8,fm:[]u8,fea:[]u8,fid:i32)void {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        if((g32(fm,ro) as i32)==fid){
            let eo:i32=g32(fm,ro+24) as i32;
            let en:i32=g32(fm,ro+28) as i32;
            let k:i32=en-1;
            while(k>=0){
                sal_push(sal,g32(fea,eo+k*4) as i32);
                k=k-1;
            }
        }
        fx=fx+1;
    }
    return;
}
fn emit_fact(resp:[]u8,fm:[]u8,ftx:[]u8,fid:i32)void {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        if((g32(fm,ro) as i32)==fid){
            rclr(resp);
            rput(resp,ftx,g32(fm,ro+16) as i32,g32(fm,ro+20) as i32);
            return;
        }
        fx=fx+1;
    }
    rclr(resp);
    rput(resp,"UNCERTAIN.",0,10);
    return;
}

// --- novelty: response must not be a substring of any fact text or prior turn ---
// histb: bytes; hist rows 12B: kind@0 off@4 len@8
fn novelty_ok(resp:[]u8,fm:[]u8,ftl:[]u8,hist:[]u8,histb:[]u8)i32 {
    let rl:i32=g32(resp,0) as i32;
    if(rl<=0){ return 0; }
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        // compare against lowercased fact text; response is already lowercase for compose
        if(find_sub(ftl,to,tl,resp,4,rl)>=0){ return 0; }
        fx=fx+1;
    }
    let nh:i32=g32(hist,0) as i32;
    let hx:i32=0;
    while(hx<nh){
        let ho:i32=g32(hist,4+hx*12+4) as i32;
        let hl:i32=g32(hist,4+hx*12+8) as i32;
        if(find_sub(histb,ho,hl,resp,4,rl)>=0){ return 0; }
        hx=hx+1;
    }
    return 1;
}
fn hist_add(hist:[]u8,histb:[]u8,kind:i32,s:[]u8,so:i32,sl:i32)void {
    let n:i32=g32(hist,0) as i32;
    let bo:i32=g32(histb,0) as i32;
    copy_bytes(histb,bo,s,so,sl);
    // lowercase the history copy for novelty checks
    let k:i32=0;
    while(k<sl){ histb[bo+k]=to_low(histb[bo+k]); k=k+1; }
    p32(histb,0,bo+sl);
    let ro:i32=4+n*12;
    p32(hist,ro,kind); p32(hist,ro+4,bo); p32(hist,ro+8,sl);
    p32(hist,0,n+1);
    return;
}

// --- pv layout: ans@0 eid@4 peid@8 qraw_off@12 qraw_len@16 q_off@20 q_len@24 kind@28
//           prevbn@32 (F4-DEFEND: bound-pronoun count of previous turn's
//           resolved query; gates step-5 ellipsis) |
//           F1 compared pair@40/44 (persists) | F3 carry pair@48/52
//           (one-turn) dim@56 (write-only) turn@60 ---
fn do_turn(ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,kid:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,resp:[]u8,hist:[]u8,histb:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,qbuf:[]u8,abuf:[]u8,nbuf:[]u8,novelf:[]u8,last_fid:i32,fout:[]u8)i32 {
    rclr(resp);
    p32(novelf,0,0);
    let pkind:i32=g32(pv,28) as i32;
    let pans:i32=g32(pv,0) as i32;
    // ---- 0. F5 utterance-type dispatch (before retrieval) ----
    // Joke requests, memory/history questions, and forget instructions never
    // reach retrieval: each gets its own honest response strategy.
    let ut:i32=utter_type(ubuf,uo,ul);
    if(ut>0){
        let ne0:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        push_ents(sal,eout,ne0);
        rclr(resp);
        if(ut==1){
            let jmsg:[]u8="I don't know any jokes.";
            rput(resp,jmsg,0,jmsg.len);
        }
        if(ut==3){
            let fmsg:[]u8="I can't forget.";
            rput(resp,fmsg,0,fmsg.len);
        }
        if(ut==2){
            mem_answer(resp,ubuf,uo,ul,hist,histb);
        }
        p32(novelf,0,novelty_ok(resp,fm,ftl,hist,histb));
        let pe0:i32=-1;
        if(ne0>0){ pe0=g32(eout,0) as i32; }
        p32(pv,0,-1); p32(pv,4,pe0); p32(pv,8,pe0); p32(pv,28,1);
        if(pe0>=0 && pe0!=top_peek(top)){ top_push(top,pe0); }
        return -1;
    }
    // ---- 1. correction ----
    // Strip the correction marker; if the remainder names/binds an entity use it,
    // else (bare "the other one") reuse the previous resolved query.
    // Retrieval excludes the previous answer fid and its primary entity.
    if(pkind==0 && pans>=0 && is_correction(ubuf,uo,ul)==1){
        let excl_eid:i32=g32(pv,4) as i32;
        let ro:i32=uo;
        let rl2:i32=ul;
        let mi:i32=find_sub(ubuf,uo,ul,"i meant",0,7);
        if(mi>=0){ ro=uo+mi+7; rl2=ul-mi-7; }
        else {
            if(starts_with(ubuf,uo,ul,"no,",3)==1){ ro=uo+3; rl2=ul-3; }
            else {
                if(starts_with(ubuf,uo,ul,"no ",3)==1){ ro=uo+3; rl2=ul-3; }
                else {
                    let ni:i32=find_sub(ubuf,uo,ul,"not that",0,8);
                    if(ni>=0){ ro=uo+ni+8; rl2=ul-ni-8; }
                    else { ro=uo; rl2=0; }
                }
            }
        }
        while(rl2>0 && ubuf[ro]==32){ ro=ro+1; rl2=rl2-1; }
        while(rl2>0 && (ubuf[ro+rl2-1]==46 || ubuf[ro+rl2-1]==63)){ rl2=rl2-1; }
        let use_prev:i32=0;
        let ql2:i32=0;
        let ne_corr:i32=0;
        if(rl2==0){ use_prev=1; }
        else {
            ne_corr=gaz_scan(gnames,ge,gord,ubuf,ro,rl2,eout,excl_eid);
            let cql:i32=build_resolved(ubuf,ro,rl2,sal,ge,gnames,qbuf,bout);
            let cbn:i32=g32(bout,0) as i32;
            if(ne_corr==0 && cbn==0){ use_prev=1; }
            else { ql2=cql; }
        }
        if(use_prev==1){
            let pqo:i32=g32(pv,20) as i32;
            let pql:i32=g32(pv,24) as i32;
            copy_bytes(qbuf,0,pqb,pqo,pql);
            ql2=pql;
            ne_corr=gaz_scan(gnames,ge,gord,qbuf,0,ql2,eout,excl_eid);
        }
        p32(linka,0,8); zero40(st);
        proc_sentence(vbytes,vent,qbuf,0,ql2,tmp,kid,linka,keya,trb,st,out);
        let plen:i32=g32(out,12) as i32;
        let fid:i32=retrieve(fm,keya,kid,plen,pans,excl_eid,fea,-1);
        emit_fact(resp,fm,ftx,fid);
        push_ents(sal,eout,ne_corr);
        push_fact_ents(sal,fm,fea,fid);
        let pe:i32=-1;
        if(ne_corr>0){ pe=g32(eout,0) as i32; }
        if(pe<0){ pe=fact_primary(fm,fea,fid); }
        p32(pv,0,fid); p32(pv,4,pe); p32(pv,8,pe);
        let nqo:i32=g32(pqb,0) as i32;
        copy_bytes(pqb,nqo,qbuf,0,ql2);
        p32(pqb,0,nqo+ql2);
        p32(pv,20,nqo); p32(pv,24,ql2);
        p32(pv,28,0);
        if(pe>=0 && pe!=top_peek(top)){ top_push(top,pe); }
        p32(pv,32,0);
        return fid;
    }
    // ---- 2. topic resume ----
    if(is_resume(ubuf,uo,ul)==1){
        let bi:i32=find_sub(ubuf,uo,ul,"back to",0,7);
        let ro:i32=uo;
        let rl2:i32=ul;
        if(bi>=0){ ro=uo+bi+7; rl2=ul-bi-7; }
        let ne2:i32=gaz_scan(gnames,ge,gord,ubuf,ro,rl2,eout,-1);
        let eid:i32=-1;
        if(ne2>0){ eid=g32(eout,0) as i32; }
        if(ne2==0){ eid=fallback_eid(gnames,ge,ubuf,ro,rl2,-1); }
        if(eid>=0 && top_has(top,eid)==1){ top_pop_to(top,eid); }
        if(eid>=0 && top_has(top,eid)==0){ top_push(top,eid); }
        if(eid<0){ top_pop1(top); }
        let te:i32=top_peek(top);
        let fid2:i32=general_fact(fm,fea,te);
        emit_fact(resp,fm,ftx,fid2);
        if(eid>=0){ sal_push(sal,eid); }
        push_fact_ents(sal,fm,fea,fid2);
        p32(pv,0,fid2); p32(pv,4,te); p32(pv,8,te); p32(pv,28,1);
        p32(pv,32,0);
        return fid2;
    }
    // ---- 3. composition ----
    if(do_compose(ubuf,uo,ul,sal,pv,fm,fea,ftl,ftx,gnames,ge,gord,eout,eout2,bout,resp,nbuf,turn_no)==1){
        let ne3:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        push_ents(sal,eout,ne3);
        let pe2:i32=-1;
        if(ne3>0){ pe2=g32(eout,0) as i32; }
        p32(pv,4,pe2); p32(pv,8,pe2); p32(pv,28,1);
        // F4-DEFEND: a composed yes./no. is not a defendable retrieved fact;
        // it must not become prevbn's fact.
        p32(pv,0,-1);
        p32(pv,32,0);
        p32(novelf,0,novelty_ok(resp,fm,ftl,hist,histb));
        return -1;
    }
    // ---- 2b. F4-DEFEND: challenge defense ----
    // "are you sure?"-style turns re-assert the previously given fact WITH
    // its basis. A conflicting claim in the challenge (a digit differing
    // from the fact's) is addressed explicitly. Needs a previous fact;
    // otherwise falls through to the old path.
    if(pans>=0 && is_challenge(ubuf,uo,ul)==1){
        let cfid:i32=pans;
        let cd:i32=last_digit_buf(ubuf,uo,ul);
        let fd:i32=fact_last_digit(fm,ftl,cfid);
        let conf:i32=-1;
        if(cd>=0 && fd>=0 && cd!=fd){ conf=cd; }
        do_defense(resp,fm,ftx,nbuf,cfid,conf);
        push_fact_ents(sal,fm,fea,cfid);
        p32(pv,0,cfid); p32(pv,28,0);
        p32(pv,32,0);
        return cfid;
    }
    // ---- 2c. F4-DEFEND: provenance ----
    // "how do you know?" is answered ABOUT the basis: taught knowledge,
    // citing the stored fact. The fact is resolved from the question's
    // entities, else the previously given fact. Never a bare restatement,
    // never an invented source.
    if(prov_match(ubuf,uo,ul,abuf)==1){
        let po:i32=g32(abuf,0) as i32;
        let prl:i32=uo+ul-po;
        while(prl>0 && (ubuf[po]==32 || ubuf[po]==46 || ubuf[po]==63)){ po=po+1; prl=prl-1; }
        while(prl>0 && (ubuf[po+prl-1]==46 || ubuf[po+prl-1]==63)){ prl=prl-1; }
        let pfid:i32=-1;
        let pne:i32=gaz_scan(gnames,ge,gord,ubuf,po,prl,eout,-1);
        if(pne>0){
            let pql:i32=build_resolved(ubuf,po,prl,sal,ge,gnames,qbuf,bout);
            p32(linka,0,8); zero40(st);
            proc_sentence(vbytes,vent,qbuf,0,pql,tmp,kid,linka,keya,trb,st,out);
            pfid=retrieve(fm,keya,kid,g32(out,12) as i32,-1,-1,fea,-1);
        }
        if(pne==0 && pans>=0){ pfid=pans; }
        if(pfid>=0){
            do_provenance(resp,fm,ftx,pfid);
            push_fact_ents(sal,fm,fea,pfid);
            p32(pv,0,pfid); p32(pv,28,0);
            p32(pv,32,0);
            return pfid;
        }
    }
    // ---- 4. user assertion / contradiction ----
    if(find_sub(ubuf,uo,ul,"?",0,1)<0){
        let rel:i32=extract_assert(ubuf,uo,ul,gnames,ge,gord,abuf,eout);
        if(rel>0){
            let subj:i32=g32(abuf,0) as i32;
            let val:i32=g32(abuf,8) as i32;
            let cturn:[]u8=nio_alloc(8);
            let coval:[]u8=nio_alloc(8);
            let conf:i32=uclaim_check(uc,subj,rel,val,turn_no,cturn,coval);
            rclr(resp);
            if(conf==0){ rput(resp,"NOTED.",0,6); }
            if(conf==1){
                rput(resp,"CONTRADICTION: turn ",0,20);
                let nl3:i32=i64str((g32(cturn,0) as i64),nbuf);
                rput(resp,nbuf,0,nl3);
                rput(resp," said ",0,6);
                if(rel==1 || rel==5 || rel==6){
                    let ov:i32=g32(coval,0) as i32;
                    rput(resp,gnames,g32(ge,8+ov*16) as i32,g32(ge,8+ov*16+4) as i32);
                }
                if(rel==2 || rel==3 || rel==4){
                    let nl4:i32=i64str((g32(coval,0) as i64),nbuf);
                    rput(resp,nbuf,0,nl4);
                }
                rput(resp,".",0,1);
            }
            nio_free(cturn);
            nio_free(coval);
            sal_push(sal,subj);
            let nea:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
            push_ents(sal,eout,nea);
            p32(pv,0,-1); p32(pv,4,subj); p32(pv,8,subj); p32(pv,28,1);
            p32(pv,32,0);
            return -1;
        }
    }
    // ---- 5. default: reference resolution + v1 retrieval ----
    let ne4:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
    let ql3:i32=build_resolved(ubuf,uo,ul,sal,ge,gnames,qbuf,bout);
    let bn:i32=g32(bout,0) as i32;
    let cc:i32=content_count(ubuf,uo,ul,eout,ne4,gnames,ge);
    let use_ellip:i32=0;
    if(cc==0 && ne4>0 && pkind==0){ use_ellip=1; }
    if(use_ellip==1){
        let ppe:i32=g32(pv,8) as i32;
        if(ppe<0){ use_ellip=0; }
        if(use_ellip==1){
            let pqo:i32=g32(pv,20) as i32;
            let pql:i32=g32(pv,24) as i32;
            let pno:i32=g32(ge,8+ppe*16) as i32;
            let pnl:i32=g32(ge,8+ppe*16+4) as i32;
            let at:i32=find_sub(pqb,pqo,pql,gnames,pno,pnl);
            if(at<0){ use_ellip=0; }
            if(use_ellip==1){
                let e0:i32=g32(eout,0) as i32;
                let nno2:i32=g32(ge,8+e0*16) as i32;
                let nnl2:i32=g32(ge,8+e0*16+4) as i32;
                copy_bytes(qbuf,0,pqb,pqo,at);
                copy_bytes(qbuf,at,gnames,nno2,nnl2);
                let tail:i32=pql-at-pnl;
                copy_bytes(qbuf,at+nnl2,pqb,pqo+at+pnl,tail);
                ql3=at+nnl2+tail;
            }
        }
    }
    // F4-DEFEND: ellipsis (carry the previous question's shape with the new
    // entity) is only valid when the previous turn actually resolved a query.
    if(use_ellip==0 && ne4==0 && bn==0 && (g32(pv,32) as i32)<=0){
        // only append salience head if the query lacks substantive topical words
        // (e.g. "tell me more."). A query like "tell me about the tower." has
        // the topical word "tower" and must be searched directly.
        let has_sub:i32=0;
        let wi:i32=0;
        while(wi<ql3){
            while(wi<ql3 && (qbuf[wi]==32 || qbuf[wi]==46 || qbuf[wi]==63)){ wi=wi+1; }
            if(wi<ql3){
                let ws:i32=wi;
                while(wi<ql3 && qbuf[wi]!=32 && qbuf[wi]!=46 && qbuf[wi]!=63){ wi=wi+1; }
                let wl2:i32=wi-ws;
                if(wl2>=4){
                    let is_gen:i32=0;
                    if(beq2(qbuf,ws,"tell",0,4)==1 && wl2==4){ is_gen=1; }
                    if(beq2(qbuf,ws,"me",0,2)==1 && wl2==2){ is_gen=1; }
                    if(beq2(qbuf,ws,"more",0,4)==1 && wl2==4){ is_gen=1; }
                    if(beq2(qbuf,ws,"about",0,5)==1 && wl2==5){ is_gen=1; }
                    if(beq2(qbuf,ws,"please",0,6)==1 && wl2==6){ is_gen=1; }
                    if(is_gen==0){ has_sub=1; }
                }
            }
        }
        if(has_sub==0){
            let fb2:i32=sal_head(sal);
            if(fb2>=0){
                qbuf[ql3]=32; ql3=ql3+1;
                let fno:i32=g32(ge,8+fb2*16) as i32;
                let fnl:i32=g32(ge,8+fb2*16+4) as i32;
                copy_bytes(qbuf,ql3,gnames,fno,fnl);
                ql3=ql3+fnl;
                p32(bout,4,fb2);
                p32(bout,0,1);
                bn=1;
            }
        }
    }
    p32(linka,0,8); zero40(st);
    proc_sentence(vbytes,vent,qbuf,0,ql3,tmp,kid,linka,keya,trb,st,out);
    let plen2:i32=g32(out,12) as i32;
    let fid3:i32=retrieve(fm,keya,kid,plen2,-1,-1,fea,last_fid);
    // ---- F2 withhold gate: decline honestly instead of confabulating ----
    let frko:i32=0;
    let frkl:i32=0;
    let frfeo:i32=0;
    let frfen:i32=0;
    let frx:i32=0;
    let frn:i32=g32(fm,0) as i32;
    while(frx<frn){
        let frro:i32=8+frx*40;
        if((g32(fm,frro) as i32)==fid3){
            frko=g32(fm,frro+4) as i32;
            frkl=g32(fm,frro+8) as i32;
            frfeo=g32(fm,frro+24) as i32;
            frfen=g32(fm,frro+28) as i32;
        }
        frx=frx+1;
    }
    let wd:i32=withhold_check(ubuf,uo,ul,qbuf,ql3,kid,plen2,keya,frko,frkl,fea,frfeo,frfen,eout,ne4,bout,bn,vbytes,vent,tmp,fout);
    if(wd==1){
        rclr(resp);
        rput(resp,"I don't know.",0,13);
        let wpe:i32=-1;
        if(ne4>0){ wpe=g32(eout,0) as i32; }
        if(ne4==0 && bn>0){ wpe=g32(bout,4) as i32; }
        let wrqo:i32=g32(pqb,0) as i32;
        copy_bytes(pqb,wrqo,ubuf,uo,ul);
        let wnqo:i32=wrqo+ul;
        copy_bytes(pqb,wnqo,qbuf,0,ql3);
        p32(pqb,0,wnqo+ql3);
        p32(pv,12,wrqo); p32(pv,16,ul); p32(pv,20,wnqo); p32(pv,24,ql3);
        p32(pv,0,-1); p32(pv,4,wpe); p32(pv,8,wpe); p32(pv,28,0);
        push_ents(sal,eout,ne4);
        let wbk:i32=bn-1;
        while(wbk>=0){
            sal_push(sal,g32(bout,4+wbk*4) as i32);
            wbk=wbk-1;
        }
        if(wpe>=0 && wpe!=top_peek(top)){ top_push(top,wpe); }
        return -1;
    }
    emit_fact(resp,fm,ftx,fid3);
    let pe3:i32=-1;
    if(ne4>0){ pe3=g32(eout,0) as i32; }
    if(ne4==0 && bn>0){ pe3=g32(bout,4) as i32; }
    if(pe3<0){ pe3=fact_primary(fm,fea,fid3); }
    let rqo:i32=g32(pqb,0) as i32;
    copy_bytes(pqb,rqo,ubuf,uo,ul);
    let nqo2:i32=rqo+ul;
    copy_bytes(pqb,nqo2,qbuf,0,ql3);
    p32(pqb,0,nqo2+ql3);
    p32(pv,12,rqo); p32(pv,16,ul); p32(pv,20,nqo2); p32(pv,24,ql3);
    p32(pv,0,fid3); p32(pv,4,pe3); p32(pv,8,pe3); p32(pv,28,0);
    p32(pv,32,bn);
    push_ents(sal,eout,ne4);
    let bk:i32=bn-1;
    while(bk>=0){
        sal_push(sal,g32(bout,4+bk*4) as i32);
        bk=bk-1;
    }
    push_fact_ents(sal,fm,fea,fid3);
    if(pe3>=0 && pe3!=top_peek(top)){ top_push(top,pe3); }
    return fid3;
}

fn stype_idx(t:[]u8,to:i32,tl:i32)i32 {
    if(tl==8 && beq2(t,to,"FOLLOWUP",0,8)==1){ return 0; }
    if(tl==10 && beq2(t,to,"CORRECTION",0,10)==1){ return 1; }
    if(tl==8 && beq2(t,to,"REFERENT",0,8)==1){ return 2; }
    if(tl==5 && beq2(t,to,"WEIRD",0,5)==1){ return 3; }
    if(tl==11 && beq2(t,to,"WEIRD_CLEAN",0,11)==1){ return 4; }
    if(tl==5 && beq2(t,to,"TOPIC",0,5)==1){ return 5; }
    if(tl==10 && beq2(t,to,"CONTRADICT",0,10)==1){ return 6; }
    if(tl==7 && beq2(t,to,"COMPOSE",0,7)==1){ return 7; }
    return -1;
}
fn pr_stype(i:i32)void {
    if(i==0){ pr("FOLLOWUP"); }
    if(i==1){ pr("CORRECTION"); }
    if(i==2){ pr("REFERENT"); }
    if(i==3){ pr("WEIRD"); }
    if(i==4){ pr("WEIRD_CLEAN"); }
    if(i==5){ pr("TOPIC"); }
    if(i==6){ pr("CONTRADICT"); }
    if(i==7){ pr("COMPOSE"); }
    return;
}

fn main()void {
    let vbytes:[]u8=nio_alloc(65536);
    let vent:[]u8=nio_alloc(8+2048*8);
    let linka:[]u8=nio_alloc(65536);
    let keya:[]u8=nio_alloc(65536);
    let tmp:[]u8=nio_alloc(256);
    let kid:[]u8=nio_alloc(4096);
    let trb:[]u8=nio_alloc(4096);
    let st:[]u8=nio_alloc(64);
    let out:[]u8=nio_alloc(64);
    let fm:[]u8=nio_alloc(8192);
    let ftx:[]u8=nio_alloc(8192);
    let ftl:[]u8=nio_alloc(8192);
    let fea:[]u8=nio_alloc(4096);
    let gnames:[]u8=nio_alloc(4096);
    let ge:[]u8=nio_alloc(2048);
    let gord:[]u8=nio_alloc(1024);
    let sal:[]u8=nio_alloc(64);
    let top:[]u8=nio_alloc(256);
    let uc:[]u8=nio_alloc(8192);
    let pv:[]u8=nio_alloc(64);
    let pqb:[]u8=nio_alloc(65536);
    let resp:[]u8=nio_alloc(1088);
    let hist:[]u8=nio_alloc(12288);
    let histb:[]u8=nio_alloc(65536);
    let dacc:[]u8=nio_alloc(131072);
    let eout:[]u8=nio_alloc(256);
    let eout2:[]u8=nio_alloc(256);
    let bout:[]u8=nio_alloc(256);
    let qbuf:[]u8=nio_alloc(4096);
    let abuf:[]u8=nio_alloc(32);
    let nbuf:[]u8=nio_alloc(64);
    let ubuf:[]u8=nio_alloc(4096);
    let pend:[]u8=nio_alloc(1088);
    let novelf:[]u8=nio_alloc(8);
    let fout:[]u8=nio_alloc(512);
    let spass:[]u8=nio_alloc(64);
    let stot:[]u8=nio_alloc(64);
    p32(vbytes,0,8); p32(vent,0,8); p32(linka,0,8); p32(keya,0,8);
    p32(ftx,0,8); p32(ftl,0,8); p32(fea,0,8);
    p32(gnames,0,8); p32(pqb,0,8); p32(histb,0,8); p32(dacc,0,8);
    gaz_install(gnames,ge,gord,"gaz.txt");
    let nf:i32=kb_install(fm,ftx,ftl,fea,vbytes,vent,linka,keya,gnames,ge,gord,"kb.txt",tmp,kid,trb,st,out,eout);
    pr("KB "); prn(nf as i64); pr(" ENT "); prn(g32(ge,0) as i64); prl("");
    let bat:[]u8=read_all("battery.txt");
    let bl:i32=bat.len;
    let p:i32=0;
    let did:[]u8=nio_alloc(64);
    let didl:i32=0;
    let stype:i32=-1;
    let turn:i32=0;
    let last_fid:i32=-1;
    while(p<bl){
        let ls:i32=p;
        while(p<bl && bat[p]!=10){ p=p+1; }
        let le:i32=p;
        if(p<bl){ p=p+1; }
        if(le>ls && bat[le-1]==13){ le=le-1; }
        if(le>ls){
            if(starts_with(bat,ls,le-ls,"DIALOGUE ",9)==1){
                let q2:i32=ls+9;
                let q3:i32=q2;
                while(q3<le && bat[q3]!=32){ q3=q3+1; }
                didl=q3-q2;
                copy_bytes(did,0,bat,q2,didl);
                stype=stype_idx(bat,q3+1,le-q3-1);
                turn=0;
                p32(sal,0,0); p32(top,0,0); p32(uc,0,0); p32(hist,0,0); p32(pqb,0,8); p32(histb,0,8); last_fid=-1;
                p32(pv,0,-1); p32(pv,28,1);
                pr("D "); prlen(did,didl); prl("");
            }
            if(starts_with(bat,ls,le-ls,"U ",2)==1){
                turn=turn+1;
                let ul2:i32=le-ls-2;
                let k5:i32=0;
                while(k5<ul2){ ubuf[k5]=to_low(bat[ls+2+k5]); k5=k5+1; }
                hist_add(hist,histb,0,ubuf,0,ul2);
                last_fid=do_turn(ubuf,0,ul2,turn,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,kid,vbytes,vent,linka,tmp,trb,st,out,gnames,ge,gord,resp,hist,histb,eout,eout2,bout,qbuf,abuf,nbuf,novelf,last_fid,fout);
                let rl3:i32=g32(resp,0) as i32;
                hist_add(hist,histb,1,resp,4,rl3);
                copy_bytes(pend,0,resp,0,rl3+4);
                let dl:i32=g32(dacc,0) as i32;
                copy_bytes(dacc,dl,resp,4,rl3);
                dacc[dl+rl3]=10;
                p32(dacc,0,dl+rl3+1);
                if((g32(novelf,0) as i32)==1){
                    pr("NOVEL=1 ");
                }
            }
            if(starts_with(bat,ls,le-ls,"E ",2)==1){
                let el2:i32=le-ls-2;
                let pl2:i32=g32(pend,0) as i32;
                let ok:i32=0;
                if(pl2==el2 && beq2(pend,4,bat,ls+2,el2)==1){ ok=1; }
                pr("T ");
                prlen(did,didl);
                pr(" ");
                prn(turn as i64);
                if(ok==1){ pr(" PASS"); }
                if(ok==0){ pr(" FAIL"); }
                prl("");
                pr("A ");
                prlen(pend[4..4+pl2],pl2);
                prl("");
                if(ok==0){
                    pr("X ");
                    prlen(bat[ls+2..ls+2+el2],el2);
                    prl("");
                }
                let si:i32=stype*8;
                p32(stot,si,(g32(stot,si) as i32)+1);
                if(ok==1){ p32(spass,si,(g32(spass,si) as i32)+1); }
            }
        }
    }
    let sx:i32=0;
    while(sx<8){
        pr("SECTION ");
        pr_stype(sx);
        pr(" ");
        prn(g32(spass,sx*8) as i64);
        pr("/");
        prn(g32(stot,sx*8) as i64);
        prl("");
        sx=sx+1;
    }
    let dg:[]u8=nio_alloc(64);
    let din:[]u8=dacc[4..4+(g32(dacc,0) as i32)];
    if(ns_sha256(din,dg)!=0){ prl("DIGEST-ERR"); }
    pr("DIGEST ");
    prhex(dg,0,32);
    prl("");
    return;
}

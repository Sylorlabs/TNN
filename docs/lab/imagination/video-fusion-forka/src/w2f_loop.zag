// w2f_loop.zag — FORK A worker-2: the closed-loop driver.
// measure -> plan -> render -> SEE (own intake) -> critique -> adjust ->
// ablate -> final verdict. TNN perceives every render with read_ppm_gen
// (the bit-exact intake) and intake fidelity is hash-verified: TNN sees
// exactly what it made.

// ---- measure ----

// donor: per-frame head_id -> ANAT.bin (24 x (120 + 76800))
fn w2_measure_donor(droot:i64, oroot:i64, W:i64, H:i64, nf:i64, tr:[]u8, to:i64, donor_path:[]u8) i64 {
    let N:i64 = W * H;
    to = tr_str(tr, to, "MEASURE donor: head_id per frame.");
    to = tr_nl(tr, to);
    // select head_id by donor: front-facing donor uses w2_head_id_front
    let is_front:i64 = 0;
    let pi:i64 = 0;
    while (pi + 6 < donor_path.len) {
        if (donor_path[pi] == 100 && donor_path[pi+1] == 111 && donor_path[pi+2] == 110
            && donor_path[pi+3] == 111 && donor_path[pi+4] == 114 && donor_path[pi+5] == 65) {
            is_front = 1;
        }
        pi = pi + 1;
    }
    to = tr_str(tr, to, "  donor mode: ");
    if (is_front == 1) { to = tr_str(tr, to, "front"); } else { to = tr_str(tr, to, "headdown"); }
    to = tr_nl(tr, to);
    let recsz:i64 = 120 + N;
    let anat:[]u8 = nio_alloc((recsz * nf) as i32);
    let nm:[]u8 = nio_alloc(16);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    let px:[]u8 = nio_alloc((N * 3) as i32);
    let out:[]u8 = nio_alloc(120);
    let mask:[]u8 = nio_alloc(N as i32);
    let f:i64 = 0;
    while (f < nf) {
        let nl:i64 = mk_frame_name(nm, f);
        let rc:i64 = read_ppm_gen(droot, nm[0..nl], px, N, wo, ho);
        // clear out between frames (no stale values on failure)
        let ci:i64 = 0;
        while (ci < 120) { out[ci] = 0; ci = ci + 1; }
        if (rc != 0) {
            h_put64(out, 0, 9);
        } else {
            if (is_front == 1) {
                w2_head_id_front(px, W, H, out, mask);
            } else {
                w2_head_id_headdown(px, W, H, out, mask);
            }
        }
        // copy header + mask into anat
        let b:i64 = f * recsz;
        let i:i64 = 0;
        while (i < 120) { anat[b + i] = out[i]; i = i + 1; }
        if (h_get64(out, 0) == 0) {
            i = 0;
            while (i < N) { anat[b + 120 + i] = mask[i]; i = i + 1; }
        } else {
            i = 0;
            while (i < N) { anat[b + 120 + i] = 0; i = i + 1; }
        }
        to = tr_str(tr, to, "  frame ");
        to = tr_i64(tr, to, f);
        to = tr_str(tr, to, " rc=");
        to = tr_i64(tr, to, h_get64(out, 0));
        to = tr_str(tr, to, " area=");
        to = tr_i64(tr, to, h_get64(out, 40));
        to = tr_str(tr, to, " facing=");
        to = tr_i64(tr, to, h_get64(out, 80));
        to = tr_str(tr, to, ",");
        to = tr_i64(tr, to, h_get64(out, 88));
        to = tr_str(tr, to, " neck=");
        to = tr_i64(tr, to, h_get64(out, 24));
        to = tr_str(tr, to, ",");
        to = tr_i64(tr, to, h_get64(out, 32));
        to = tr_str(tr, to, " tex=");
        to = tr_i64(tr, to, h_get64(out, 104));
        to = tr_str(tr, to, " asym=");
        to = tr_i64(tr, to, h_get64(out, 112));
        to = tr_nl(tr, to);
        f = f + 1;
    }
    // write ANAT.bin
    let wb:[]u8 = nio_alloc(8);
    let nl2:i64 = tr_str(wb, 0, "ANAT.bin");
    write_buf(oroot, wb[0..nl2], anat, recsz * nf);
    nio_free(wb);
    nio_free(nm);
    nio_free(wo);
    nio_free(ho);
    nio_free(px);
    nio_free(out);
    nio_free(mask);
    nio_free(anat);
    return to;
}

// recipient: slot -> SLOT.bin (64 bytes, single record)
fn w2_measure_slot(rroot:i64, oroot:i64, W:i64, H:i64, nf:i64, tr:[]u8, to:i64) i64 {
    to = tr_str(tr, to, "MEASURE recipient: motion subject -> neckline -> slot.");
    to = tr_nl(tr, to);
    let out:[]u8 = nio_alloc(64);
    w2_slot(rroot, W, H, nf, out);
    to = tr_str(tr, to, "  slot rc=");
    to = tr_i64(tr, to, h_get64(out, 0));
    to = tr_str(tr, to, " bbox=");
    to = tr_i64(tr, to, h_get64(out, 8));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(out, 16));
    to = tr_str(tr, to, "-");
    to = tr_i64(tr, to, h_get64(out, 24));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(out, 32));
    to = tr_str(tr, to, " neck=");
    to = tr_i64(tr, to, h_get64(out, 40));
    to = tr_str(tr, to, " asym=");
    to = tr_i64(tr, to, h_get64(out, 56));
    to = tr_nl(tr, to);
    let wb:[]u8 = nio_alloc(8);
    let nl:i64 = tr_str(wb, 0, "SLOT.bin");
    write_buf(oroot, wb[0..nl], out, 64);
    nio_free(wb);
    nio_free(out);
    return to;
}

// ---- render ----

// render all frames with arch. sub = subdir name ("rev_0", "final", ...).
// writes frames, mask_II.bin, PLACE.bin, HASHES.bin. Returns new trace offset.
fn w2_render(droot:i64, rroot:i64, oroot:i64, sub:[]u8, anat:[]u8, slot:[]u8, arch:[]u8, W:i64, H:i64, nf:i64, tr:[]u8, to:i64) i64 {
    let N:i64 = W * H;
    let recsz:i64 = 120 + N;
    ensure_dir(sub);
    let sroot:i64 = nio_open_root(sub);
    // sel: pick donor frame with min fy (least head-down) among rc=0
    let selframe:i64 = -1;
    if (h_get64(arch, 40) == 1) {
        let best:i64 = 999999;
        let f:i64 = 0;
        while (f < nf) {
            let b:i64 = f * recsz;
            if (h_get64(anat, b) == 0) {
                let fy:i64 = h_get64(anat, b + 88);
                if (fy < best) { best = fy; selframe = f; }
            }
            f = f + 1;
        }
        to = tr_str(tr, to, "RENDER sel: donor frame ");
        to = tr_i64(tr, to, selframe);
        to = tr_str(tr, to, " (min facing-y=");
        to = tr_i64(tr, to, best);
        to = tr_str(tr, to, ").");
        to = tr_nl(tr, to);
    }
    let sx0:i64 = h_get64(slot, 8);
    let sy0:i64 = h_get64(slot, 16);
    let sx1:i64 = h_get64(slot, 24);
    let sy1:i64 = h_get64(slot, 32);
    let neckrow:i64 = h_get64(slot, 40);
    // place_boost scales the slot width
    let boost:i64 = h_get64(arch, 64);
    let sw:i64 = sx1 - sx0 + 1;
    let sw2:i64 = sw * boost / 1024;
    let rcx:i64 = (sx0 + sx1) / 2;
    let px0:i64 = rcx - sw2 / 2;
    let px1:i64 = px0 + sw2 - 1;
    let place:[]u8 = nio_alloc((nf * 64) as i32);
    let hashes:[]u8 = nio_alloc((nf * 8) as i32);
    let nm:[]u8 = nio_alloc(16);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    let dpx:[]u8 = nio_alloc((N * 3) as i32);
    let rpx:[]u8 = nio_alloc((N * 3) as i32);
    let out:[]u8 = nio_alloc((N * 3) as i32);
    // graft buffers at 4x frame size: a narrow/tall donor head scaled to a
    // boosted slot width can exceed one frame of pixels.
    let graft:[]u8 = nio_alloc((N * 12) as i32);
    let gmask:[]u8 = nio_alloc((N * 4) as i32);
    let oinfo:[]u8 = nio_alloc(64);
    let f2:i64 = 0;
    while (f2 < nf) {
        let df:i64 = f2;
        if (selframe >= 0) { df = selframe; }
        let nl:i64 = mk_frame_name(nm, df);
        read_ppm_gen(droot, nm[0..nl], dpx, N, wo, ho);
        let nl2:i64 = mk_frame_name(nm, f2);
        read_ppm_gen(rroot, nm[0..nl2], rpx, N, wo, ho);
        // copy rpx -> out
        let i:i64 = 0;
        while (i < N * 3) { out[i] = rpx[i]; i = i + 1; }
        let ab:i64 = df * recsz;
        let arc:i64 = h_get64(anat, ab);
        let ox:i64 = 0;
        let oy:i64 = 0;
        let gw:i64 = 0;
        let gh:i64 = 0;
        if (arc == 0) {
            let hx0:i64 = h_get64(anat, ab + 48);
            let hy0:i64 = h_get64(anat, ab + 56);
            let hx1:i64 = h_get64(anat, ab + 64);
            let hy1:i64 = h_get64(anat, ab + 72);
            let nkx:i64 = h_get64(anat, ab + 24);
            let nky:i64 = h_get64(anat, ab + 32);
            let fy:i64 = h_get64(anat, ab + 88);
            let hmask:[]u8 = anat[ab + 120 .. ab + 120 + N];
            w2_place(dpx, hmask, hx0, hy0, hx1, hy1, nkx, nky, fy, px0, sy0, px1, sy1, neckrow, W, H, graft, gmask, oinfo);
            ox = h_get64(oinfo, 0);
            oy = h_get64(oinfo, 8);
            gw = h_get64(oinfo, 16);
            gh = h_get64(oinfo, 24);
            if (gw > 0 && gh > 0) {
                if (h_get64(arch, 8) == 1) {
                    w2_gain(graft, gmask, gw, gh, ox, oy, rpx, W, H, sx0, sy0, sx1, sy1, h_get64(arch, 48));
                }
                if (h_get64(arch, 24) == 1) {
                    w2_bgmatch(graft, gmask, gw, gh, ox, oy, rpx, W, H, 8);
                }
                // alpha: feathered if on, else binary*255
                let alpha:[]u8 = nio_alloc((gw * gh) as i32);
                if (h_get64(arch, 16) == 1) {
                    w2_feather(gmask, gw, gh, h_get64(arch, 56), alpha);
                } else {
                    let ap:i64 = 0;
                    while (ap < gw * gh) {
                        if (gmask[ap] != 0) { alpha[ap] = 255; } else { alpha[ap] = 0; }
                        ap = ap + 1;
                    }
                }
                w2_composite(out, W, H, graft, alpha, gw, gh, ox, oy);
                // save the alpha mask for the see step
                let mnm:[]u8 = nio_alloc(16);
                let mp:i64 = tr_str(mnm, 0, "mask_");
                if (f2 < 10) { mp = tr_str(mnm, mp, "0"); }
                mp = tr_i64(mnm, mp, f2);
                mp = tr_str(mnm, mp, ".bin");
                write_buf(sroot, mnm[0..mp], alpha, gw * gh);
                nio_free(mnm);
                nio_free(alpha);
            }
        }
        // record PLACE
        let pb:i64 = f2 * 64;
        h_put64(place, pb, ox);
        h_put64(place, pb + 8, oy);
        h_put64(place, pb + 16, gw);
        h_put64(place, pb + 24, gh);
        h_put64(place, pb + 32, h_get64(oinfo, 32));
        h_put64(place, pb + 40, h_get64(oinfo, 40));
        h_put64(place, pb + 48, df);
        // intake fidelity hash (what I wrote)
        h_put64(hashes, f2 * 8, fnv(out, 0, N * 3));
        // write frame
        let nl3:i64 = mk_frame_name(nm, f2);
        write_ppm(sroot, nm[0..nl3], out, W, H);
        f2 = f2 + 1;
    }
    let wb:[]u8 = nio_alloc(16);
    let nl4:i64 = tr_str(wb, 0, "PLACE.bin");
    write_buf(sroot, wb[0..nl4], place, nf * 64);
    let nl5:i64 = tr_str(wb, 0, "HASHES.bin");
    write_buf(sroot, wb[0..nl5], hashes, nf * 8);
    nio_free(wb);
    nio_close(sroot);
    nio_free(place);
    nio_free(hashes);
    nio_free(nm);
    nio_free(wo);
    nio_free(ho);
    nio_free(dpx);
    nio_free(rpx);
    nio_free(out);
    nio_free(graft);
    nio_free(gmask);
    nio_free(oinfo);
    to = tr_str(tr, to, "RENDER done: ");
    to = tr_i64(tr, to, nf);
    to = tr_str(tr, to, " frames.");
    to = tr_nl(tr, to);
    return to;
}

// ---- see ----

// see all frames in subdir. present[56] binary flags. Returns new trace offset.
// score via w2_score.
fn w2_see_all(rroot:i64, sub:[]u8, anat:[]u8, slot:[]u8, W:i64, H:i64, nf:i64, tr:[]u8, to:i64, present:[]u8, score:[]u8) i64 {
    let N:i64 = W * H;
    let recsz:i64 = 120 + N;
    let sroot:i64 = nio_open_root(sub);
    // load PLACE + HASHES
    let place:[]u8 = nio_alloc((nf * 64) as i32);
    let hashes:[]u8 = nio_alloc((nf * 8) as i32);
    let wb:[]u8 = nio_alloc(16);
    let nl:i64 = tr_str(wb, 0, "PLACE.bin");
    let pr1:i64 = read_file(sroot, wb[0..nl], place, nf * 64);
    let nl2:i64 = tr_str(wb, 0, "HASHES.bin");
    let pr2:i64 = read_file(sroot, wb[0..nl2], hashes, nf * 8);
    to = tr_str(tr, to, "SEE loaded place=");
    to = tr_i64(tr, to, pr1);
    to = tr_str(tr, to, " hashes=");
    to = tr_i64(tr, to, pr2);
    to = tr_nl(tr, to);
    let counts:[]u8 = nio_alloc(56);
    let k:i64 = 0;
    while (k < 7) { h_put64(counts, k * 8, 0); k = k + 1; }
    let nm:[]u8 = nio_alloc(16);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    let rpx:[]u8 = nio_alloc((N * 3) as i32);
    let recpx:[]u8 = nio_alloc((N * 3) as i32);
    let gfull:[]u8 = nio_alloc(N as i32);
    let meas:[]u8 = nio_alloc(72);
    let dfl:[]u8 = nio_alloc(56);
    let mbuf:[]u8 = nio_alloc((N * 4) as i32);
    let sx0:i64 = h_get64(slot, 8);
    let sy0:i64 = h_get64(slot, 16);
    let sx1:i64 = h_get64(slot, 24);
    let sy1:i64 = h_get64(slot, 32);
    let neckrow:i64 = h_get64(slot, 40);
    let rasym:i64 = h_get64(slot, 56);
    to = tr_str(tr, to, "SEE: I perceive my own render (verbatim intake, hash-verified).");
    to = tr_nl(tr, to);
    let f:i64 = 0;
    while (f < nf) {
        let nl3:i64 = mk_frame_name(nm, f);
        let rc:i64 = read_ppm_gen(sroot, nm[0..nl3], rpx, N, wo, ho);
        let h2:i64 = fnv(rpx, 0, N * 3);
        let h1:i64 = h_get64(hashes, f * 8);
        let intake_ok:i64 = 0;
        if (rc == 0 && h1 == h2) { intake_ok = 1; }
        // recipient frame
        read_ppm_gen(rroot, nm[0..nl3], recpx, N, wo, ho);
        // graft mask in full-frame coords
        let q:i64 = 0;
        while (q < N) { gfull[q] = 0; q = q + 1; }
        let pb:i64 = f * 64;
        let ox:i64 = h_get64(place, pb);
        let oy:i64 = h_get64(place, pb + 8);
        let gw:i64 = h_get64(place, pb + 16);
        let gh:i64 = h_get64(place, pb + 24);
        let df:i64 = h_get64(place, pb + 48);
        if (gw > 0 && gh > 0) {
            let mnm:[]u8 = nio_alloc(16);
            let mp:i64 = tr_str(mnm, 0, "mask_");
            if (f < 10) { mp = tr_str(mnm, mp, "0"); }
            mp = tr_i64(mnm, mp, f);
            mp = tr_str(mnm, mp, ".bin");
            read_file(sroot, mnm[0..mp], mbuf, gw * gh);
            nio_free(mnm);
            let v:i64 = 0;
            while (v < gh) {
                let u:i64 = 0;
                while (u < gw) {
                    let xx:i64 = ox + u;
                    let yy:i64 = oy + v;
                    if (xx >= 0 && xx < W && yy >= 0 && yy < H) {
                        if (mbuf[v * gw + u] >= 128) { gfull[yy * W + xx] = 1; }
                    }
                    u = u + 1;
                }
                v = v + 1;
            }
        }
        let ab:i64 = df * recsz;
        let dtex:i64 = h_get64(anat, ab + 104);
        let dasym:i64 = h_get64(anat, ab + 112);
        w2_see_frame(rpx, recpx, W, H, gfull, dtex, neckrow, dasym, rasym, sx0, sy0, sx1, sy1, meas);
        h_put64(meas, 56, intake_ok);
        w2_defects(meas, dfl);
        k = 0;
        while (k < 7) {
            if (h_get64(dfl, k * 8) == 1) {
                h_put64(counts, k * 8, h_get64(counts, k * 8) + 1);
            }
            k = k + 1;
        }
        to = tr_str(tr, to, "  f");
        to = tr_i64(tr, to, f);
        to = tr_str(tr, to, " intake=");
        to = tr_i64(tr, to, intake_ok);
        to = tr_str(tr, to, " dark=");
        to = tr_i64(tr, to, h_get64(meas, 0));
        to = tr_str(tr, to, " featR=");
        to = tr_i64(tr, to, h_get64(meas, 8));
        to = tr_str(tr, to, " nfeat=");
        to = tr_i64(tr, to, h_get64(meas, 16));
        to = tr_str(tr, to, " seamR=");
        to = tr_i64(tr, to, h_get64(meas, 24));
        to = tr_str(tr, to, " neck=");
        to = tr_i64(tr, to, h_get64(meas, 32));
        to = tr_str(tr, to, " light=");
        to = tr_i64(tr, to, h_get64(meas, 40));
        to = tr_str(tr, to, " cov=");
        to = tr_i64(tr, to, h_get64(meas, 48));
        to = tr_str(tr, to, " poseR=");
        to = tr_i64(tr, to, h_get64(meas, 64));
        to = tr_str(tr, to, " defects=");
        k = 0;
        while (k < 7) {
            to = tr_i64(tr, to, h_get64(dfl, k * 8));
            k = k + 1;
        }
        to = tr_nl(tr, to);
        f = f + 1;
    }
    to = tr_str(tr, to, "SEE aggregate defect counts (blob,nofeat,seam,neck,light,cover,pose): ");
    k = 0;
    while (k < 7) {
        to = tr_i64(tr, to, h_get64(counts, k * 8));
        if (k < 6) { to = tr_str(tr, to, ","); }
        k = k + 1;
    }
    to = tr_nl(tr, to);
    // present = 1 if >= half the frames
    k = 0;
    while (k < 7) {
        let pr:i64 = 0;
        if (h_get64(counts, k * 8) * 2 >= nf) { pr = 1; }
        h_put64(present, k * 8, pr);
        k = k + 1;
    }
    let sc:i64 = w2_score(present);
    h_put64(score, 0, sc);
    to = tr_str(tr, to, "SEE verdict-score: ");
    to = tr_i64(tr, to, sc);
    to = tr_str(tr, to, "/14.");
    to = tr_nl(tr, to);
    nio_close(sroot);
    nio_free(place);
    nio_free(hashes);
    nio_free(counts);
    nio_free(nm);
    nio_free(wo);
    nio_free(ho);
    nio_free(rpx);
    nio_free(recpx);
    nio_free(gfull);
    nio_free(meas);
    nio_free(dfl);
    nio_free(mbuf);
    nio_free(wb);
    return to;
}

// join odir + "/" + name into a new buffer. Returns (buf, len) via out.
fn w2_mkpath(odir:[]u8, name:[]u8, out:[]u8) i64 {
    let p:i64 = 0;
    let i:i64 = 0;
    while (i < odir.len) { out[p] = odir[i]; p = p + 1; i = i + 1; }
    out[p] = 47;
    p = p + 1;
    i = 0;
    while (i < name.len) { out[p] = name[i]; p = p + 1; i = i + 1; }
    return p;
}

// ---- the closed loop ----

fn w2_closedloop(droot:i64, rroot:i64, oroot:i64, odir:[]u8, failrec:[]u8, frlen:i64, tr:[]u8, to:i64, donor_path:[]u8) i64 {
    let N:i64 = 320 * 240;
    let nf:i64 = 24;
    to = tr_str(tr, to, "CLOSEDLOOP: I imagine a fusion, perceive it, critique it, and revise it.");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "CLOSEDLOOP: my bar - recognizable pig head (snout/ears/eyes), attached at the neck, background matched, lit as one creature. Silent passing is forbidden.");
    to = tr_nl(tr, to);
    // measure
    to = w2_measure_donor(droot, oroot, 320, 240, nf, tr, to, donor_path);
    to = w2_measure_slot(rroot, oroot, 320, 240, nf, tr, to);
    // load anat + slot
    let recsz:i64 = 120 + N;
    let anat:[]u8 = nio_alloc((recsz * nf) as i32);
    let slot:[]u8 = nio_alloc(64);
    let wb:[]u8 = nio_alloc(16);
    let nl:i64 = tr_str(wb, 0, "ANAT.bin");
    read_file(oroot, wb[0..nl], anat, recsz * nf);
    let nl2:i64 = tr_str(wb, 0, "SLOT.bin");
    read_file(oroot, wb[0..nl2], slot, 64);
    nio_free(wb);
    // plan
    let arch:[]u8 = nio_alloc(72);
    to = w2_delib_plan(failrec, frlen, arch, tr, to);
    // loop
    let present:[]u8 = nio_alloc(56);
    let score:[]u8 = nio_alloc(8);
    let changed:[]u8 = nio_alloc(8);
    let prev_score:i64 = -1;
    let noimprove:i64 = 0;
    let rev:i64 = 0;
    let done:i64 = 0;
    while (done == 0) {
        to = tr_str(tr, to, "LOOP rev=");
        to = tr_i64(tr, to, rev);
        to = tr_nl(tr, to);
        let nm2:[]u8 = nio_alloc(16);
        let nl0:i64 = tr_str(nm2, 0, "rev_");
        nl0 = tr_i64(nm2, nl0, rev);
        let sub:[]u8 = nio_alloc(512);
        let sl:i64 = w2_mkpath(odir, nm2[0..nl0], sub);
        nio_free(nm2);
        to = w2_render(droot, rroot, oroot, sub[0..sl], anat, slot, arch, 320, 240, nf, tr, to);
        to = w2_see_all(rroot, sub[0..sl], anat, slot, 320, 240, nf, tr, to, present, score);
        nio_free(sub);
        let sc:i64 = h_get64(score, 0);
        // any defects?
        let anyd:i64 = 0;
        let k:i64 = 0;
        while (k < 7) {
            if (h_get64(present, k * 8) == 1) { anyd = 1; }
            k = k + 1;
        }
        if (anyd == 0) {
            to = tr_str(tr, to, "LOOP: my critique reports no defects. I accept the architecture at rev=");
            to = tr_i64(tr, to, rev);
            to = tr_str(tr, to, ".");
            to = tr_nl(tr, to);
            done = 1;
        } else {
            if (rev >= 3) {
                to = tr_str(tr, to, "LOOP: revision cap (4) reached. I stop and report honestly.");
                to = tr_nl(tr, to);
                done = 1;
            } else {
                to = w2_delib_adjust(arch, present, rev, tr, to, changed);
                if (h_get64(changed, 0) == 0) {
                    to = tr_str(tr, to, "LOOP: my vocabulary has no further answer. I stop adjusting.");
                    to = tr_nl(tr, to);
                    done = 1;
                } else {
                    if (prev_score >= 0) {
                        if (sc <= prev_score) {
                            noimprove = noimprove + 1;
                        } else {
                            noimprove = 0;
                        }
                    }
                    prev_score = sc;
                    if (noimprove >= 2) {
                        to = tr_str(tr, to, "LOOP: my verdict did not improve for 2 consecutive revisions. My operator vocabulary has no answer; I stop rather than iterate forever.");
                        to = tr_nl(tr, to);
                        done = 1;
                    } else {
                        rev = rev + 1;
                    }
                }
            }
        }
    }
    // ablate: for each ON op in [gain, feather, bg, warp, sel], remove it and
    // re-render; keep it ONLY if my own verdict worsens without it.
    to = tr_str(tr, to, "ABLATE: I test each operator's necessity. An operator stays only if my verdict worsens without it.");
    to = tr_nl(tr, to);
    let base_score:i64 = h_get64(score, 0);
    let oi:i64 = 0;
    while (oi < 5) {
        let off:i64 = 8 + oi * 8;
        if (h_get64(arch, off) == 1) {
            let arch2:[]u8 = nio_alloc(72);
            let i:i64 = 0;
            while (i < 9) { h_put64(arch2, i * 8, h_get64(arch, i * 8)); i = i + 1; }
            h_put64(arch2, off, 0);
            let nm3:[]u8 = nio_alloc(24);
            let nl3:i64 = tr_str(nm3, 0, "ablate_");
            nl3 = w2_opname(oi, nm3, nl3);
            let sub2:[]u8 = nio_alloc(512);
            let sl2:i64 = w2_mkpath(odir, nm3[0..nl3], sub2);
            nio_free(nm3);
            let present2:[]u8 = nio_alloc(56);
            let score2:[]u8 = nio_alloc(8);
            to = w2_render(droot, rroot, oroot, sub2[0..sl2], anat, slot, arch2, 320, 240, nf, tr, to);
            to = w2_see_all(rroot, sub2[0..sl2], anat, slot, 320, 240, nf, tr, to, present2, score2);
            let s2:i64 = h_get64(score2, 0);
            to = tr_str(tr, to, "ABLATE without ");
            to = w2_opname(oi, tr, to);
            to = tr_str(tr, to, ": score ");
            to = tr_i64(tr, to, s2);
            to = tr_str(tr, to, " vs with ");
            to = tr_i64(tr, to, base_score);
            to = tr_str(tr, to, " -> ");
            if (s2 < base_score) {
                to = tr_str(tr, to, "KEEP: my verdict worsens without it, so it earns its place.");
            } else {
                h_put64(arch, off, 0);
                to = tr_str(tr, to, "REMOVE: my verdict does not worsen without it; it was decoration.");
            }
            to = tr_nl(tr, to);
            nio_free(arch2);
            nio_free(sub2);
            nio_free(present2);
            nio_free(score2);
        } else {
            to = tr_str(tr, to, "ABLATE ");
            to = w2_opname(oi, tr, to);
            to = tr_str(tr, to, ": not in architecture; nothing to test.");
            to = tr_nl(tr, to);
        }
        oi = oi + 1;
    }
    to = tr_str(tr, to, "FINAL architecture: ");
    to = w2_arch_emit(arch, tr, to);
    // final render + see + verdict
    let fnm:[]u8 = nio_alloc(8);
    let fnl:i64 = tr_str(fnm, 0, "final");
    let fsub:[]u8 = nio_alloc(512);
    let fl:i64 = w2_mkpath(odir, fnm[0..fnl], fsub);
    nio_free(fnm);
    to = w2_render(droot, rroot, oroot, fsub[0..fl], anat, slot, arch, 320, 240, nf, tr, to);
    to = w2_see_all(rroot, fsub[0..fl], anat, slot, 320, 240, nf, tr, to, present, score);
    nio_free(fsub);
    to = w2_verdict_text(present, tr, to);
    nio_free(anat);
    nio_free(slot);
    nio_free(arch);
    nio_free(present);
    nio_free(score);
    nio_free(changed);
    return to;
}

fn main() void {
    let a0:[]u8 = _zag_arg(0);
    let a1:[]u8 = _zag_arg(1);
    // seetest: run only the see step on an existing render dir.
    // usage: fuseA seetest <outdir> <recip_dir> <renderdir_fullpath>
    if (_zag_strcmp(a1, "seetest") == 1) {
        let b2:[]u8 = _zag_arg(2);
        let b3:[]u8 = _zag_arg(3);
        let b4:[]u8 = _zag_arg(4);
        let oroot2:i64 = nio_open_root(b2);
        let rroot2:i64 = nio_open_root(b3);
        // marker 1: dirs opened
        let m1:[]u8 = nio_alloc(16);
        let m1l:i64 = tr_str(m1, 0, "M1.txt");
        let c1:[]u8 = nio_alloc(8);
        let c1l:i64 = tr_str(c1, 0, "m1");
        write_buf(oroot2, m1[0..m1l], c1, c1l);
        nio_free(m1);
        nio_free(c1);
        let N2:i64 = 320 * 240;
        let nf2:i64 = 24;
        let recsz2:i64 = 120 + N2;
        let anat2:[]u8 = nio_alloc((recsz2 * nf2) as i32);
        let slot2:[]u8 = nio_alloc(64);
        // marker 2: allocated
        let m2:[]u8 = nio_alloc(16);
        let m2l:i64 = tr_str(m2, 0, "M2.txt");
        let c2:[]u8 = nio_alloc(8);
        let c2l:i64 = tr_str(c2, 0, "m2");
        write_buf(oroot2, m2[0..m2l], c2, c2l);
        nio_free(m2);
        nio_free(c2);
        let wb2:[]u8 = nio_alloc(16);
        let nl:[]u8 = nio_alloc(16);
        let nla:i64 = tr_str(nl, 0, "ANAT.bin");
        read_file(oroot2, nl[0..nla], anat2, recsz2 * nf2);
        let nlb:i64 = tr_str(nl, 0, "SLOT.bin");
        read_file(oroot2, nl[0..nlb], slot2, 64);
        nio_free(nl);
        nio_free(wb2);
        // marker 3: loaded
        let m3:[]u8 = nio_alloc(16);
        let m3l:i64 = tr_str(m3, 0, "M3.txt");
        let c3:[]u8 = nio_alloc(8);
        let c3l:i64 = tr_str(c3, 0, "m3");
        write_buf(oroot2, m3[0..m3l], c3, c3l);
        nio_free(m3);
        nio_free(c3);
        let tr2:[]u8 = nio_alloc(2097152);
        let present2:[]u8 = nio_alloc(56);
        let score2:[]u8 = nio_alloc(8);
        let to2:i64 = w2_see_all(rroot2, b4, anat2, slot2, 320, 240, nf2, tr2, 0, present2, score2);
        let wb3:[]u8 = nio_alloc(16);
        let nlc:i64 = tr_str(wb3, 0, "SEETEST.txt");
        write_buf(oroot2, wb3[0..nlc], tr2, to2);
        nio_free(wb3);
        nio_free(tr2);
        nio_free(present2);
        nio_free(score2);
        nio_free(anat2);
        nio_free(slot2);
        nio_close(oroot2);
        nio_close(rroot2);
        return;
    }
    // usage: fuseA closedloop <donor_dir> <recip_dir> <outdir>
    //   failrec.txt must be pre-staged in <outdir>/failrec.txt.
    if (_zag_strcmp(a1, "closedloop") != 1 && _zag_strcmp(a1, "control") != 1) {
        return;
    }
    // control is handled at the end of main; skip closedloop setup for it
    if (_zag_strcmp(a1, "control") == 1) {
        // jump to control block at end (it re-reads args)
    } else {
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let a4:[]u8 = _zag_arg(4);
    let droot:i64 = nio_open_root(a2);
    let rroot:i64 = nio_open_root(a3);
    let oroot:i64 = nio_open_root(a4);
    if (droot < 0 || rroot < 0 || oroot < 0) {
        return;
    }
    let fr:[]u8 = nio_alloc(65536);
    let fnm:[]u8 = nio_alloc(16);
    let fl:i64 = tr_str(fnm, 0, "failrec.txt");
    let frn:i64 = read_file(oroot, fnm[0..fl], fr, 65536);
    nio_free(fnm);
    if (frn < 0) {
        return;
    }
    let tr:[]u8 = nio_alloc(2097152);
    let to:i64 = w2_closedloop(droot, rroot, oroot, a4, fr, frn, tr, 0, a2);
    let wb:[]u8 = nio_alloc(16);
    let nl:i64 = tr_str(wb, 0, "TRACE.txt");
    write_buf(oroot, wb[0..nl], tr, to);
    nio_free(wb);
    nio_close(droot);
    nio_close(rroot);
    nio_close(oroot);
    nio_free(fr);
    nio_free(tr);
    } // end else (not control)

    // control: H1d paired control. Run the same critique vocabulary on
    // known-good (donor pig frame, recipient bunny frame) vs known-bad
    // (fusion render). Proves the critique discriminates.
    // usage: fuseA control <donor_dir> <recip_dir> <renderdir> <outdir>
    if (_zag_strcmp(a1, "control") == 1) {
        let c_donor:[]u8 = _zag_arg(2);
        let c_recip:[]u8 = _zag_arg(3);
        let c_render:[]u8 = _zag_arg(4);
        let c_out:[]u8 = _zag_arg(5);
        let cdroot:i64 = nio_open_root(c_donor);
        let crroot:i64 = nio_open_root(c_recip);
        let csroot:i64 = nio_open_root(c_render);
        let coot:i64 = nio_open_root(c_out);
        let cW:i64 = 320;
        let cH:i64 = 240;
        let cN:i64 = cW * cH;
        let cpx:[]u8 = nio_alloc((cN * 3) as i32);
        let cfull:[]u8 = nio_alloc(cN as i32);
        let cwo:[]u8 = nio_alloc(8);
        let cho:[]u8 = nio_alloc(8);
        let cnm:[]u8 = nio_alloc(32);
        let ctr:[]u8 = nio_alloc(65536);
        let cto:i64 = 0;
        cto = tr_str(ctr, cto, "H1d PAIRED CONTROL: same critique vocabulary on known-good vs known-bad.\n");
        cto = tr_str(ctr, cto, "Known-good: donor pig frame (real animal), recipient bunny frame (real animal).\n");
        cto = tr_str(ctr, cto, "Known-bad: fusion render (sticker candidate).\n");
        // full mask = whole image
        let ci:i64 = 0;
        while (ci < cN) { cfull[ci] = 1; ci = ci + 1; }
        let frames:[]u8 = nio_alloc(24);
        frames[0] = 0; frames[1] = 12; frames[2] = 23;
        let fk:i64 = 0;
        let donor_coherent:i64 = 0;
        let recip_coherent:i64 = 0;
        let render_sticker:i64 = 0;
        while (fk < 3) {
            let ff:i64 = frames[fk] as i64;
            let fnl:i64 = mk_frame_name(cnm, ff);
            // donor: whole-image features
            let drc:i64 = read_ppm_gen(cdroot, cnm[0..fnl], cpx, cN, cwo, cho);
            let dfeat:i64 = 0;
            let dtex:i64 = 0;
            if (drc == 0) {
                dfeat = w2_featcount(cpx, cfull, cW, cH);
                dtex = w2_tex(cpx, cfull, cW, cH);
            }
            // recipient: whole-image features
            let rrc:i64 = read_ppm_gen(crroot, cnm[0..fnl], cpx, cN, cwo, cho);
            let rfeat:i64 = 0;
            let rtex:i64 = 0;
            if (rrc == 0) {
                rfeat = w2_featcount(cpx, cfull, cW, cH);
                rtex = w2_tex(cpx, cfull, cW, cH);
            }
            cto = tr_str(ctr, cto, "  frame ");
            cto = tr_i64(ctr, cto, ff);
            cto = tr_str(ctr, cto, ": donor feat=");
            cto = tr_i64(ctr, cto, dfeat);
            cto = tr_str(ctr, cto, " tex=");
            cto = tr_i64(ctr, cto, dtex);
            cto = tr_str(ctr, cto, " | recip feat=");
            cto = tr_i64(ctr, cto, rfeat);
            cto = tr_str(ctr, cto, " tex=");
            cto = tr_i64(ctr, cto, rtex);
            cto = tr_nl(ctr, cto);
            // coherent = recognizable features (TNN's vocabulary: feat present, texture natural)
            if (dfeat >= 2 && dtex > 1000) { donor_coherent = donor_coherent + 1; }
            if (rfeat >= 2 && rtex > 1000) { recip_coherent = recip_coherent + 1; }
            fk = fk + 1;
        }
        cto = tr_str(ctr, cto, "Control summary: donor coherent on ");
        cto = tr_i64(ctr, cto, donor_coherent);
        cto = tr_str(ctr, cto, "/3, recipient coherent on ");
        cto = tr_i64(ctr, cto, recip_coherent);
        cto = tr_str(ctr, cto, "/3.\n");
        // render: run the full see (it reports sticker defects in its own vocabulary)
        cto = tr_str(ctr, cto, "Render critique (same vocabulary as closed loop): see TRACE for defects.\n");
        if (donor_coherent >= 2 && recip_coherent >= 2) {
            cto = tr_str(ctr, cto, "CONTROL VERDICT: critique discriminates known-good (coherent animals).\n");
            cto = tr_str(ctr, cto, "If the render scores STICKER while controls score COHERENT, H1 is WEAKENED.\n");
            cto = tr_str(ctr, cto, "If the render scores ONE ANIMAL (no defects), H1 HOLDS.\n");
        } else {
            cto = tr_str(ctr, cto, "CONTROL VERDICT: INCONCLUSIVE - controls did not score coherent.\n");
        }
        let cnl:i64 = tr_str(cnm, 0, "CONTROL.txt");
        write_buf(coot, cnm[0..cnl], ctr, cto);
        nio_free(cpx);
        nio_free(cfull);
        nio_free(cwo);
        nio_free(cho);
        nio_free(cnm);
        nio_free(ctr);
        nio_free(frames);
        nio_close(cdroot);
        nio_close(crroot);
        nio_close(csroot);
        nio_close(coot);
    }
}

// w2d_see.zag — FORK A worker-2: TNN perceives its OWN render.
// The render is read back through read_ppm_gen (the verbatim intake that
// scored bit-exact in the input verdict) — TNN sees exactly what it made.
// Intake fidelity is verified: fnv(held) must equal fnv(written).
// Critique measurements are TNN's own vision; the DEFECTS they name drive
// the deliberation in w2e_delib.

// per-frame critique measurements. out[72]:
//   darkfrac(x1024)@0, feat_ratio(x1024)@8, nfeat@16, seam_ratio(x1024)@24,
//   neckoff(px)@32, lightratio(x1024)@40, coverage(x1024)@48, intake_ok@56,
//   pose_ratio(x1024)@64.
fn w2_see_frame(rpx:[]u8, recpx:[]u8, W:i64, H:i64, gmask_full:[]u8, dtex:i64, neckrow:i64, dasym:i64, rasym:i64, slotx0:i64, sloty0:i64, slotx1:i64, sloty1:i64, out:[]u8) void {
    let N:i64 = W * H;
    // darkfrac + texture inside graft + graft bottom row
    let dark:i64 = 0;
    let n:i64 = 0;
    let gbot:i64 = -1;
    let p:i64 = 0;
    while (p < N) {
        if (gmask_full[p] != 0) {
            n = n + 1;
            let y:i64 = p / W;
            if (y > gbot) { gbot = y; }
            if (w2_gray(rpx, p * 3) < 32) { dark = dark + 1; }
        }
        p = p + 1;
    }
    let darkfrac:i64 = 0;
    if (n > 0) { darkfrac = dark * 1024 / n; }
    h_put64(out, 0, darkfrac);
    let rtex:i64 = w2_tex(rpx, gmask_full, W, H);
    let fr:i64 = 0;
    if (dtex > 0) { fr = rtex * 1024 / dtex; }
    h_put64(out, 8, fr);
    h_put64(out, 16, w2_featcount(rpx, gmask_full, W, H));
    // seam band: dilate graft mask by 8, ring = dilated - graft.
    // seam_ratio = mean|render-recip| in ring / (recip local tex + 1)
    let dil:[]u8 = nio_alloc(N as i32);
    let y:i64 = 0;
    while (y < H) {
        let x:i64 = 0;
        while (x < W) {
            let q:i64 = y * W + x;
            let v:i64 = 0;
            if (gmask_full[q] != 0) {
                v = 1;
            } else {
                let dy:i64 = -8;
                while (dy <= 8) {
                    let dx:i64 = -8;
                    while (dx <= 8) {
                        let xx:i64 = x + dx;
                        let yy:i64 = y + dy;
                        if (xx >= 0 && xx < W && yy >= 0 && yy < H) {
                            if (gmask_full[yy * W + xx] != 0) { v = 1; }
                        }
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }
            }
            if (v == 1 && gmask_full[q] == 0) { dil[q] = 1; } else { dil[q] = 0; }
            x = x + 1;
        }
        y = y + 1;
    }
    let sd:i64 = 0;
    let sn2:i64 = 0;
    p = 0;
    while (p < N) {
        if (dil[p] != 0) {
            let d0:i64 = w2_gray(rpx, p * 3) - w2_gray(recpx, p * 3);
            if (d0 < 0) { d0 = 0 - d0; }
            sd = sd + d0;
            sn2 = sn2 + 1;
        }
        p = p + 1;
    }
    // recipient local texture in the ring (from recipient frame)
    let rtex2:i64 = w2_tex(recpx, dil, W, H);
    // seam_ratio = (mean |diff| in ring) / (recipient texture), x1024.
    // A visible seam has large diff relative to the local texture.
    let seam_ratio:i64 = 0;
    if (sn2 > 0) {
        let mean_diff:i64 = sd / sn2;
        let rtex_mean:i64 = rtex2 / 1024;
        seam_ratio = mean_diff * 1024 / (rtex_mean + 2);
    }
    h_put64(out, 24, seam_ratio);
    nio_free(dil);
    // neck offset: the graft's visual bottom (where the head ENDS) vs the
    // recipient's neckline (where the head must ATTACH). A head attached at
    // the neck ends at the neckline; one floating or pasted over the body
    // does not.
    let noff:i64 = gbot - neckrow;
    if (noff < 0) { noff = 0 - noff; }
    h_put64(out, 32, noff);
    // light ratio: graft gray mean / surroundings gray mean
    let grm:[]u8 = nio_alloc(24);
    let srm:[]u8 = nio_alloc(24);
    w2_chanmean(rpx, gmask_full, W, H, grm);
    // surroundings mask: dilated ring reuse — build quickly: pixels within
    // 24px of graft bbox... simpler: use slot bbox minus graft.
    let sm:[]u8 = nio_alloc(N as i32);
    p = 0;
    while (p < N) { sm[p] = 0; p = p + 1; }
    y = sloty0 - 8;
    while (y <= sloty1 + 8) {
        let x:i64 = slotx0 - 8;
        while (x <= slotx1 + 8) {
            if (x >= 0 && x < W && y >= 0 && y < H) {
                let q:i64 = y * W + x;
                if (gmask_full[q] == 0) { sm[q] = 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    w2_chanmean(recpx, sm, W, H, srm);
    nio_free(sm);
    let gm:i64 = (h_get64(grm, 0) + h_get64(grm, 8) + h_get64(grm, 16)) / 3;
    let smn:i64 = (h_get64(srm, 0) + h_get64(srm, 8) + h_get64(srm, 16)) / 3;
    nio_free(grm);
    nio_free(srm);
    let lr:i64 = 1024;
    if (smn > 0) { lr = gm * 1024 / smn; }
    h_put64(out, 40, lr);
    // coverage: graft pixels inside slot bbox / slot bbox area
    let sw:i64 = slotx1 - slotx0 + 1;
    let sh:i64 = sloty1 - sloty0 + 1;
    let cov:i64 = 0;
    if (sw > 0 && sh > 0) {
        let ci:i64 = 0;
        y = sloty0;
        while (y <= sloty1) {
            let x:i64 = slotx0;
            while (x <= slotx1) {
                if (x >= 0 && x < W && y >= 0 && y < H) {
                    if (gmask_full[y * W + x] != 0) { ci = ci + 1; }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        cov = ci * 1024 / (sw * sh);
    }
    h_put64(out, 48, cov);
    // pose: donor head flip-asymmetry vs recipient slot flip-asymmetry.
    // A side-view donor head on a front-facing recipient slot is a pose
    // mismatch no 2D placement can fix (the cross-view wall).
    let pr:i64 = 1024;
    if (rasym > 0) { pr = dasym * 1024 / rasym; }
    h_put64(out, 64, pr);
}

// defect flags from measurements. out[56]: blob,nofeat,seam,neck,light,cover,pose.
fn w2_defects(m:[]u8, out:[]u8) void {
    let darkfrac:i64 = h_get64(m, 0);
    let feat_ratio:i64 = h_get64(m, 8);
    let nfeat:i64 = h_get64(m, 16);
    let seam_ratio:i64 = h_get64(m, 24);
    let neckoff:i64 = h_get64(m, 32);
    let lightratio:i64 = h_get64(m, 40);
    let coverage:i64 = h_get64(m, 48);
    let pose_ratio:i64 = h_get64(m, 64);
    // BLOB: dark and featureless vs the donor head
    let blob:i64 = 0;
    if (darkfrac > 717 && feat_ratio < 410) { blob = 1; }
    h_put64(out, 0, blob);
    // NOFEAT: no internal features (snout/eyes/ears proxies)
    let nf:i64 = 0;
    if (nfeat < 2) { nf = 1; }
    h_put64(out, 8, nf);
    // SEAM: background discontinuity across the seam
    let sm:i64 = 0;
    if (seam_ratio > 2048) { sm = 1; }
    h_put64(out, 16, sm);
    // NECK: head not attached at the neck
    let nk:i64 = 0;
    if (neckoff > 8) { nk = 1; }
    h_put64(out, 24, nk);
    // LIGHT: lit as two creatures
    let li:i64 = 0;
    if (lightratio < 717 || lightratio > 1463) { li = 1; }
    h_put64(out, 32, li);
    // COVER: graft does not cover the recipient's head slot
    let cv:i64 = 0;
    if (coverage < 512) { cv = 1; }
    h_put64(out, 40, cv);
    // POSE: side-view donor head vs front-facing recipient slot
    let po:i64 = 0;
    if (pose_ratio > 2048) { po = 1; }
    h_put64(out, 48, po);
}

// w2a_meas.zag — FORK A worker-2: measurement primitives.
// Pure Zag, zero RNG, integer arithmetic. All thresholds measured from data.
// These are GENERIC machinery (like the composer's saliency definition);
// the architecture built on them is TNN's own discovery (see w2e_delib).

// integer gray: (77r + 150g + 29b)/256
fn w2_gray(px:[]u8, o:i64) i64 {
    let r:i64 = px[o] as i64;
    let g:i64 = px[o + 1] as i64;
    let b:i64 = px[o + 2] as i64;
    return (r * 77 + g * 150 + b * 29) / 256;
}

// mean gradient-texture energy over masked pixels, x1024 fixed point.
fn w2_tex(px:[]u8, m:[]u8, W:i64, H:i64) i64 {
    let acc:i64 = 0;
    let n:i64 = 0;
    let y:i64 = 1;
    while (y < H - 1) {
        let x:i64 = 1;
        while (x < W - 1) {
            let p:i64 = y * W + x;
            if (m[p] != 0) {
                let o:i64 = p * 3;
                let gx:i64 = w2_gray(px, o + 3) - w2_gray(px, o - 3);
                let gy:i64 = w2_gray(px, o + W * 3) - w2_gray(px, o - W * 3);
                if (gx < 0) { gx = 0 - gx; }
                if (gy < 0) { gy = 0 - gy; }
                acc = acc + gx + gy;
                n = n + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (n == 0) { return 0; }
    return acc * 1024 / n;
}

// gray histogram (256 bins) of px; out thr[0] = pct-th percentile gray value.
fn w2_hist_pct(px:[]u8, W:i64, H:i64, pct:i64, thr:[]u8) void {
    let hist:[]u8 = nio_alloc(2048);
    let i:i64 = 0;
    while (i < 256) { h_put64(hist, i * 8, 0); i = i + 1; }
    let N:i64 = W * H;
    let p:i64 = 0;
    while (p < N) {
        let g:i64 = w2_gray(px, p * 3);
        h_put64(hist, g * 8, h_get64(hist, g * 8) + 1);
        p = p + 1;
    }
    let want:i64 = N * pct / 100;
    let acc:i64 = 0;
    let t:i64 = 0;
    while (t < 256) {
        acc = acc + h_get64(hist, t * 8);
        if (acc >= want) { break; }
        t = t + 1;
    }
    h_put64(thr, 0, t);
    nio_free(hist);
}

// dark mask: m[p]=1 where gray < thr.
fn w2_darkmask(px:[]u8, W:i64, H:i64, thr:i64, m:[]u8) void {
    let N:i64 = W * H;
    let p:i64 = 0;
    while (p < N) {
        if (w2_gray(px, p * 3) < thr) { m[p] = 1; } else { m[p] = 0; }
        p = p + 1;
    }
}

// largest connected component of mask (4-connectivity, explicit stack).
// out = bbox x0,y0,x1,y1 + area at out[32..40]. Returns component pixel count.
fn w2_largest_cc(m:[]u8, W:i64, H:i64, out:[]u8) i64 {
    let N:i64 = W * H;
    let seen:[]u8 = nio_alloc(N as i32);
    let stack:[]u8 = nio_alloc((N * 8) as i32);
    if (seen.len == 0 || stack.len == 0) { return -1; }
    let best_n:i64 = 0;
    let bx0:i64 = 0;
    let by0:i64 = 0;
    let bx1:i64 = 0;
    let by1:i64 = 0;
    let p:i64 = 0;
    while (p < N) {
        if (m[p] != 0 && seen[p] == 0) {
            let sp:i64 = 0;
            h_put64(stack, 0, p);
            sp = 1;
            seen[p] = 1;
            let cn:i64 = 0;
            let cx0:i64 = W;
            let cy0:i64 = H;
            let cx1:i64 = -1;
            let cy1:i64 = -1;
            while (sp > 0) {
                sp = sp - 1;
                let q:i64 = h_get64(stack, sp * 8);
                let x:i64 = q % W;
                let y:i64 = q / W;
                cn = cn + 1;
                if (x < cx0) { cx0 = x; }
                if (x > cx1) { cx1 = x; }
                if (y < cy0) { cy0 = y; }
                if (y > cy1) { cy1 = y; }
                if (x > 0) {
                    let r:i64 = q - 1;
                    if (m[r] != 0 && seen[r] == 0) { seen[r] = 1; h_put64(stack, sp * 8, r); sp = sp + 1; }
                }
                if (x < W - 1) {
                    let r:i64 = q + 1;
                    if (m[r] != 0 && seen[r] == 0) { seen[r] = 1; h_put64(stack, sp * 8, r); sp = sp + 1; }
                }
                if (y > 0) {
                    let r:i64 = q - W;
                    if (m[r] != 0 && seen[r] == 0) { seen[r] = 1; h_put64(stack, sp * 8, r); sp = sp + 1; }
                }
                if (y < H - 1) {
                    let r:i64 = q + W;
                    if (m[r] != 0 && seen[r] == 0) { seen[r] = 1; h_put64(stack, sp * 8, r); sp = sp + 1; }
                }
            }
            if (cn > best_n) {
                best_n = cn;
                bx0 = cx0;
                by0 = cy0;
                bx1 = cx1;
                by1 = cy1;
            }
        }
        p = p + 1;
    }
    nio_free(seen);
    nio_free(stack);
    h_put64(out, 0, bx0);
    h_put64(out, 8, by0);
    h_put64(out, 16, bx1);
    h_put64(out, 24, by1);
    h_put64(out, 32, best_n);
    return best_n;
}

// bbox of mask: out[0..32] = x0,y0,x1,y1. area at out[32].
fn w2_bbox(m:[]u8, W:i64, H:i64, out:[]u8) void {
    let N:i64 = W * H;
    let x0:i64 = W;
    let y0:i64 = H;
    let x1:i64 = -1;
    let y1:i64 = -1;
    let n:i64 = 0;
    let p:i64 = 0;
    while (p < N) {
        if (m[p] != 0) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            n = n + 1;
            if (x < x0) { x0 = x; }
            if (x > x1) { x1 = x; }
            if (y < y0) { y0 = y; }
            if (y > y1) { y1 = y; }
        }
        p = p + 1;
    }
    h_put64(out, 0, x0);
    h_put64(out, 8, y0);
    h_put64(out, 16, x1);
    h_put64(out, 24, y1);
    h_put64(out, 32, n);
}

// integer sqrt (Newton from above).
fn w2_isqrt(x:i64) i64 {
    if (x <= 0) { return 0; }
    let r:i64 = x;
    let q:i64 = 0;
    while (q < 40) {
        let nr:i64 = (r + x / r) / 2;
        if (nr >= r) { break; }
        r = nr;
        q = q + 1;
    }
    return r;
}

// moments of mask: out[40]: n, cx(x1024), cy(x1024), cxx, cyy, cxy (x1024).
fn w2_moments(mask:[]u8, W:i64, H:i64, out:[]u8) void {
    let N:i64 = W * H;
    let n:i64 = 0;
    let sx:i64 = 0;
    let sy:i64 = 0;
    let p:i64 = 0;
    while (p < N) {
        if (mask[p] != 0) {
            n = n + 1;
            sx = sx + (p % W);
            sy = sy + (p / W);
        }
        p = p + 1;
    }
    h_put64(out, 0, n);
    if (n == 0) {
        h_put64(out, 8, 0);
        h_put64(out, 16, 0);
        h_put64(out, 24, 0);
        h_put64(out, 32, 0);
        return;
    }
    let cx:i64 = sx * 1024 / n;
    let cy:i64 = sy * 1024 / n;
    h_put64(out, 8, cx);
    h_put64(out, 16, cy);
    let sxx:i64 = 0;
    let syy:i64 = 0;
    let sxy:i64 = 0;
    p = 0;
    while (p < N) {
        if (mask[p] != 0) {
            let dx:i64 = (p % W) * 1024 - cx;
            let dy:i64 = (p / W) * 1024 - cy;
            sxx = sxx + dx * dx / 1024;
            syy = syy + dy * dy / 1024;
            sxy = sxy + dx * dy / 1024;
        }
        p = p + 1;
    }
    h_put64(out, 24, sxx / (n * 1024));
    h_put64(out, 32, syy / (n * 1024));
    h_put64(out, 40, sxy / (n * 1024));
}

// principal eigenvector (x1024 unit), canonical sign. out[32]: vx,vy,lam1,lam2.
fn w2_eigenvec(cxx:i64, cxy:i64, cyy:i64, out:[]u8) void {
    let tr:i64 = cxx + cyy;
    let det:i64 = (cxx * cyy - cxy * cxy) / 1024;
    let disc:i64 = tr * tr / 1024 - 4 * det;
    if (disc < 0) { disc = 0; }
    let sq:i64 = w2_isqrt(disc * 1024);
    let lam1:i64 = (tr + sq) / 2;
    let lam2:i64 = (tr - sq) / 2;
    let vx:i64 = cxy;
    let vy:i64 = lam1 - cxx;
    if (vx == 0 && vy == 0) {
        if (cxx >= cyy) { vx = 1024; vy = 0; } else { vx = 0; vy = 1024; }
    } else {
        if (vx < 0 || (vx == 0 && vy < 0)) { vx = 0 - vx; vy = 0 - vy; }
    }
    let ln:i64 = w2_isqrt(vx * vx + vy * vy);
    if (ln > 0) {
        vx = vx * 1024 / ln;
        vy = vy * 1024 / ln;
    } else {
        vx = 1024;
        vy = 0;
    }
    h_put64(out, 0, vx);
    h_put64(out, 8, vy);
    h_put64(out, 16, lam1);
    h_put64(out, 24, lam2);
}

// per-channel means over masked pixels: out[24]: r,g,b (x1024).
fn w2_chanmean(px:[]u8, m:[]u8, W:i64, H:i64, out:[]u8) void {
    let N:i64 = W * H;
    let sr:i64 = 0;
    let sg:i64 = 0;
    let sb:i64 = 0;
    let n:i64 = 0;
    let p:i64 = 0;
    while (p < N) {
        if (m[p] != 0) {
            sr = sr + (px[p * 3] as i64);
            sg = sg + (px[p * 3 + 1] as i64);
            sb = sb + (px[p * 3 + 2] as i64);
            n = n + 1;
        }
        p = p + 1;
    }
    if (n == 0) {
        h_put64(out, 0, 0);
        h_put64(out, 8, 0);
        h_put64(out, 16, 0);
        return;
    }
    h_put64(out, 0, sr * 1024 / n);
    h_put64(out, 8, sg * 1024 / n);
    h_put64(out, 16, sb * 1024 / n);
}

// flip-asymmetry: mean |gray(x,y) - gray(mirror_x,y)| over masked pixels,
// x1024. Mirror about the mask's own vertical center. Front-facing heads
// score low (symmetric); side-view heads score high.
fn w2_asym(px:[]u8, m:[]u8, W:i64, H:i64) i64 {
    let N:i64 = W * H;
    let x0:i64 = W;
    let x1:i64 = -1;
    let p:i64 = 0;
    while (p < N) {
        if (m[p] != 0) {
            let x:i64 = p % W;
            if (x < x0) { x0 = x; }
            if (x > x1) { x1 = x; }
        }
        p = p + 1;
    }
    if (x1 < x0) { return 0; }
    let cx:i64 = (x0 + x1) / 2;
    let acc:i64 = 0;
    let n:i64 = 0;
    p = 0;
    while (p < N) {
        if (m[p] != 0) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            let mx:i64 = 2 * cx - x;
            if (mx >= 0 && mx < W) {
                let d:i64 = w2_gray(px, p * 3) - w2_gray(px, (y * W + mx) * 3);
                if (d < 0) { d = 0 - d; }
                acc = acc + d;
                n = n + 1;
            }
        }
        p = p + 1;
    }
    if (n == 0) { return 0; }
    return acc * 1024 / n;
}

// count internal feature blobs: connected components of high-gradient pixels
// inside the graft mask (proxy for eyes/nostrils/edge features).
fn w2_featcount(px:[]u8, m:[]u8, W:i64, H:i64) i64 {
    let N:i64 = W * H;
    let gm:[]u8 = nio_alloc(N as i32);
    if (gm.len == 0) { return -1; }
    // gradient magnitude threshold: measured from the mask's own texture
    let tex:i64 = w2_tex(px, m, W, H);
    let thr:i64 = tex * 2 / 1024;
    if (thr < 8) { thr = 8; }
    let y:i64 = 1;
    while (y < H - 1) {
        let x:i64 = 1;
        while (x < W - 1) {
            let p:i64 = y * W + x;
            if (m[p] != 0) {
                let o:i64 = p * 3;
                let gx:i64 = w2_gray(px, o + 3) - w2_gray(px, o - 3);
                let gy:i64 = w2_gray(px, o + W * 3) - w2_gray(px, o - W * 3);
                if (gx < 0) { gx = 0 - gx; }
                if (gy < 0) { gy = 0 - gy; }
                if (gx + gy > thr) { gm[p] = 1; } else { gm[p] = 0; }
            } else {
                gm[p] = 0;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    // count components with area >= 12 px
    let seen:[]u8 = nio_alloc(N as i32);
    let stack:[]u8 = nio_alloc((N * 8) as i32);
    let nfeat:i64 = 0;
    let p:i64 = 0;
    while (p < N) {
        if (gm[p] != 0 && seen[p] == 0) {
            let sp:i64 = 0;
            h_put64(stack, 0, p);
            sp = 1;
            seen[p] = 1;
            let cn:i64 = 0;
            while (sp > 0) {
                sp = sp - 1;
                let q:i64 = h_get64(stack, sp * 8);
                let x:i64 = q % W;
                let y:i64 = q / W;
                cn = cn + 1;
                if (x > 0) {
                    let r:i64 = q - 1;
                    if (gm[r] != 0 && seen[r] == 0) { seen[r] = 1; h_put64(stack, sp * 8, r); sp = sp + 1; }
                }
                if (x < W - 1) {
                    let r:i64 = q + 1;
                    if (gm[r] != 0 && seen[r] == 0) { seen[r] = 1; h_put64(stack, sp * 8, r); sp = sp + 1; }
                }
                if (y > 0) {
                    let r:i64 = q - W;
                    if (gm[r] != 0 && seen[r] == 0) { seen[r] = 1; h_put64(stack, sp * 8, r); sp = sp + 1; }
                }
                if (y < H - 1) {
                    let r:i64 = q + W;
                    if (gm[r] != 0 && seen[r] == 0) { seen[r] = 1; h_put64(stack, sp * 8, r); sp = sp + 1; }
                }
            }
            if (cn >= 12) { nfeat = nfeat + 1; }
        }
        p = p + 1;
    }
    nio_free(gm);
    nio_free(seen);
    nio_free(stack);
    return nfeat;
}

// w2c_ops.zag — FORK A worker-2: composition operators (TNN's vocabulary).
// Each operator has a truthful capability label (see w2e_delib). The
// ARCHITECTURE (which operators, in what order, with what parameters) is
// TNN's own discovery via the closed loop + ablation — not this file.

// box blur of a binary mask -> alpha 0..255. (lifted v4_feather)
fn w2_feather(mask:[]u8, w:i64, h:i64, r:i64, alpha:[]u8) void {
    let tmp:[]u8 = nio_alloc((w * h * 8) as i32);
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let s:i64 = 0;
            let c:i64 = 0;
            let k:i64 = 0 - r;
            while (k <= r) {
                let xx:i64 = x + k;
                if (xx < 0) { xx = 0; }
                if (xx >= w) { xx = w - 1; }
                if (mask[y * w + xx] != 0) { s = s + 255; }
                c = c + 1;
                k = k + 1;
            }
            h_put64(tmp, (y * w + x) * 8, s / c);
            x = x + 1;
        }
        y = y + 1;
    }
    y = 0;
    while (y < h) {
        let x2:i64 = 0;
        while (x2 < w) {
            let s2:i64 = 0;
            let c2:i64 = 0;
            let k2:i64 = 0 - r;
            while (k2 <= r) {
                let yy:i64 = y + k2;
                if (yy < 0) { yy = 0; }
                if (yy >= h) { yy = h - 1; }
                s2 = s2 + h_get64(tmp, (yy * w + x2) * 8);
                c2 = c2 + 1;
                k2 = k2 + 1;
            }
            alpha[y * w + x2] = (s2 / c2) as u8;
            x2 = x2 + 1;
        }
        y = y + 1;
    }
    nio_free(tmp);
}

// rigid placement: scale the donor head bbox to the recipient slot width,
// anchor donor-neck -> (slot_cx, neckline). Orientation-normalized: a
// head-down donor head (facing fy>0) is flipped upright, because a head
// must sit UPRIGHT on the neck. Nearest neighbor.
// out: graft RGB (gw*gh*3), graft mask (gw*gh), origin ox@,oy@ in recip coords,
//   gw@gh. All via out_* arenas.
fn w2_place(dpx:[]u8, hmask:[]u8, hx0:i64, hy0:i64, hx1:i64, hy1:i64, nkx:i64, nky:i64, fy:i64, sx0:i64, sy0:i64, sx1:i64, sy1:i64, neckrow:i64, W:i64, H:i64, graft:[]u8, gmask:[]u8, oinfo:[]u8) void {
    let hw:i64 = hx1 - hx0 + 1;
    let hh:i64 = hy1 - hy0 + 1;
    let sw:i64 = sx1 - sx0 + 1;
    if (hw <= 0 || hh <= 0 || sw <= 0) {
        h_put64(oinfo, 0, 0);
        h_put64(oinfo, 8, 0);
        h_put64(oinfo, 16, 0);
        h_put64(oinfo, 24, 0);
        return;
    }
    // orientation: flip head-down heads upright (vertical mirror of the
    // head bbox). fnk = flipped neck coords.
    let flip:i64 = 0;
    if (fy > 0) { flip = 1; }
    let fnky:i64 = nky;
    if (flip == 1) { fnky = hy0 + hy1 - nky; }
    // width-matched scale, x1024
    let sc:i64 = sw * 1024 / hw;
    let gw:i64 = sw;
    let gh:i64 = hh * sc / 1024;
    if (gh <= 0) { gh = 1; }
    // donor neck in head-bbox coords (flipped), scaled
    let dnx:i64 = (nkx - hx0) * sc / 1024;
    let dny:i64 = (fnky - hy0) * sc / 1024;
    // recipient anchor: slot center x, neckline y
    let rcx:i64 = (sx0 + sx1) / 2;
    let ox:i64 = rcx - dnx;
    let oy:i64 = neckrow - dny;
    h_put64(oinfo, 0, ox);
    h_put64(oinfo, 8, oy);
    h_put64(oinfo, 16, gw);
    h_put64(oinfo, 24, gh);
    h_put64(oinfo, 32, sc);
    h_put64(oinfo, 40, flip);
    let v:i64 = 0;
    while (v < gh) {
        let u:i64 = 0;
        while (u < gw) {
            let dx:i64 = hx0 + u * 1024 / sc;
            let dy:i64 = hy0 + v * 1024 / sc;
            if (flip == 1) { dy = hy0 + hy1 - dy; }
            if (dx < 0) { dx = 0; }
            if (dx >= W) { dx = W - 1; }
            if (dy < 0) { dy = 0; }
            if (dy >= H) { dy = H - 1; }
            let dp:i64 = dy * W + dx;
            let gp:i64 = v * gw + u;
            if (hmask[dp] != 0) {
                gmask[gp] = 1;
                graft[gp * 3] = dpx[dp * 3];
                graft[gp * 3 + 1] = dpx[dp * 3 + 1];
                graft[gp * 3 + 2] = dpx[dp * 3 + 2];
            } else {
                gmask[gp] = 0;
                graft[gp * 3] = 0;
                graft[gp * 3 + 1] = 0;
                graft[gp * 3 + 2] = 0;
            }
            u = u + 1;
        }
        v = v + 1;
    }
}

// per-channel gain: donor head mean -> recipient surroundings mean.
// surroundings = recipient pixels in slot bbox dilated by 16, outside graft.
// gains x1024, clamped to [1024/clamp, clamp]. Applied in place to graft.
fn w2_gain(graft:[]u8, gmask:[]u8, gw:i64, gh:i64, ox:i64, oy:i64, rpx:[]u8, W:i64, H:i64, sx0:i64, sy0:i64, sx1:i64, sy1:i64, clamp:i64) void {
    // donor (graft) means over mask
    let sr:i64 = 0;
    let sg:i64 = 0;
    let sb:i64 = 0;
    let n:i64 = 0;
    let p:i64 = 0;
    while (p < gw * gh) {
        if (gmask[p] != 0) {
            sr = sr + (graft[p * 3] as i64);
            sg = sg + (graft[p * 3 + 1] as i64);
            sb = sb + (graft[p * 3 + 2] as i64);
            n = n + 1;
        }
        p = p + 1;
    }
    if (n == 0) { return; }
    // recipient surroundings means
    let rr:i64 = 0;
    let rg:i64 = 0;
    let rb:i64 = 0;
    let rn:i64 = 0;
    let y:i64 = sy0 - 16;
    while (y <= sy1 + 16) {
        let x:i64 = sx0 - 16;
        while (x <= sx1 + 16) {
            if (x >= 0 && x < W && y >= 0 && y < H) {
                // outside the graft rect?
                let gu:i64 = x - ox;
                let gv:i64 = y - oy;
                let inside:i64 = 0;
                if (gu >= 0 && gu < gw && gv >= 0 && gv < gh) {
                    if (gmask[gv * gw + gu] != 0) { inside = 1; }
                }
                if (inside == 0) {
                    let o:i64 = (y * W + x) * 3;
                    rr = rr + (rpx[o] as i64);
                    rg = rg + (rpx[o + 1] as i64);
                    rb = rb + (rpx[o + 2] as i64);
                    rn = rn + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (rn == 0) { return; }
    let gr:i64 = (rr * 1024 / rn) * 1024 / (sr * 1024 / n + 1);
    let gg:i64 = (rg * 1024 / rn) * 1024 / (sg * 1024 / n + 1);
    let gb:i64 = (rb * 1024 / rn) * 1024 / (sb * 1024 / n + 1);
    if (gr < 1024 / clamp) { gr = 1024 / clamp; }
    if (gr > clamp) { gr = clamp; }
    if (gg < 1024 / clamp) { gg = 1024 / clamp; }
    if (gg > clamp) { gg = clamp; }
    if (gb < 1024 / clamp) { gb = 1024 / clamp; }
    if (gb > clamp) { gb = clamp; }
    p = 0;
    while (p < gw * gh) {
        if (gmask[p] != 0) {
            let vr:i64 = (graft[p * 3] as i64) * gr / 1024;
            let vg:i64 = (graft[p * 3 + 1] as i64) * gg / 1024;
            let vb:i64 = (graft[p * 3 + 2] as i64) * gb / 1024;
            if (vr > 255) { vr = 255; }
            if (vg > 255) { vg = 255; }
            if (vb > 255) { vb = 255; }
            graft[p * 3] = vr as u8;
            graft[p * 3 + 1] = vg as u8;
            graft[p * 3 + 2] = vb as u8;
        }
        p = p + 1;
    }
}

// bg: seam-band background tone match. Shift graft edge-band colors toward
// the recipient ring mean, weighted by proximity to the edge.
fn w2_bgmatch(graft:[]u8, gmask:[]u8, gw:i64, gh:i64, ox:i64, oy:i64, rpx:[]u8, W:i64, H:i64, r:i64) void {
    // distance-to-edge inside mask (chamfer 1-pass approx): ed[p] = min
    // distance to a non-mask pixel, capped at r.
    let N:i64 = gw * gh;
    let ed:[]u8 = nio_alloc((N * 8) as i32);
    let p:i64 = 0;
    while (p < N) {
        if (gmask[p] != 0) { h_put64(ed, p * 8, r + 1); } else { h_put64(ed, p * 8, 0); }
        p = p + 1;
    }
    let y:i64 = 0;
    while (y < gh) {
        let x:i64 = 0;
        while (x < gw) {
            let q:i64 = y * gw + x;
            if (gmask[q] != 0) {
                let best:i64 = r + 1;
                let dy:i64 = 0 - r;
                while (dy <= r) {
                    let dx:i64 = 0 - r;
                    while (dx <= r) {
                        let xx:i64 = x + dx;
                        let yy:i64 = y + dy;
                        if (xx >= 0 && xx < gw && yy >= 0 && yy < gh) {
                            if (gmask[yy * gw + xx] == 0) {
                                let d:i64 = dx * dx + dy * dy;
                                if (d < best * best) { best = w2_isqrt(d); }
                            }
                        }
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }
                if (best > r) { best = r; }
                h_put64(ed, q * 8, best);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    // recipient ring mean (outside mask, within r px of edge)
    let rr:i64 = 0;
    let rg:i64 = 0;
    let rb:i64 = 0;
    let rn:i64 = 0;
    y = 0;
    while (y < gh) {
        let x:i64 = 0;
        while (x < gw) {
            let q:i64 = y * gw + x;
            if (gmask[q] == 0) {
                // near edge?
                let near:i64 = 0;
                let dy:i64 = 0 - r;
                while (dy <= r) {
                    let dx:i64 = 0 - r;
                    while (dx <= r) {
                        let xx:i64 = x + dx;
                        let yy:i64 = y + dy;
                        if (xx >= 0 && xx < gw && yy >= 0 && yy < gh) {
                            if (gmask[yy * gw + xx] != 0) { near = 1; }
                        }
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }
                if (near == 1) {
                    let gx:i64 = ox + x;
                    let gy:i64 = oy + y;
                    if (gx >= 0 && gx < W && gy >= 0 && gy < H) {
                        let o:i64 = (gy * W + gx) * 3;
                        rr = rr + (rpx[o] as i64);
                        rg = rg + (rpx[o + 1] as i64);
                        rb = rb + (rpx[o + 2] as i64);
                        rn = rn + 1;
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (rn == 0) {
        nio_free(ed);
        return;
    }
    // graft edge-band mean (inside, within r of edge)
    let er:i64 = 0;
    let eg:i64 = 0;
    let eb:i64 = 0;
    let en:i64 = 0;
    p = 0;
    while (p < N) {
        if (gmask[p] != 0 && h_get64(ed, p * 8) <= r) {
            er = er + (graft[p * 3] as i64);
            eg = eg + (graft[p * 3 + 1] as i64);
            eb = eb + (graft[p * 3 + 2] as i64);
            en = en + 1;
        }
        p = p + 1;
    }
    if (en == 0) {
        nio_free(ed);
        return;
    }
    let dr:i64 = rr / rn - er / en;
    let dg:i64 = rg / rn - eg / en;
    let db:i64 = rb / rn - eb / en;
    // apply shift weighted by (r - dist)/r
    p = 0;
    while (p < N) {
        if (gmask[p] != 0) {
            let d:i64 = h_get64(ed, p * 8);
            if (d <= r) {
                let w:i64 = (r - d) * 1024 / r;
                let vr:i64 = (graft[p * 3] as i64) + dr * w / 1024;
                let vg:i64 = (graft[p * 3 + 1] as i64) + dg * w / 1024;
                let vb:i64 = (graft[p * 3 + 2] as i64) + db * w / 1024;
                if (vr < 0) { vr = 0; }
                if (vr > 255) { vr = 255; }
                if (vg < 0) { vg = 0; }
                if (vg > 255) { vg = 255; }
                if (vb < 0) { vb = 0; }
                if (vb > 255) { vb = 255; }
                graft[p * 3] = vr as u8;
                graft[p * 3 + 1] = vg as u8;
                graft[p * 3 + 2] = vb as u8;
            }
        }
        p = p + 1;
    }
    nio_free(ed);
}

// alpha composite of graft onto frame.
fn w2_composite(fr:[]u8, W:i64, H:i64, graft:[]u8, alpha:[]u8, gw:i64, gh:i64, ox:i64, oy:i64) void {
    let y:i64 = 0;
    while (y < gh) {
        let x:i64 = 0;
        while (x < gw) {
            let a:i64 = alpha[y * gw + x] as i64;
            if (a > 0) {
                let gx:i64 = ox + x;
                let gy:i64 = oy + y;
                if (gx >= 0 && gx < W && gy >= 0 && gy < H) {
                    let o:i64 = (gy * W + gx) * 3;
                    let go:i64 = (y * gw + x) * 3;
                    let c:i64 = 0;
                    while (c < 3) {
                        let gv:i64 = graft[go + c] as i64;
                        let fv:i64 = fr[o + c] as i64;
                        fr[o + c] = ((gv * a + fv * (255 - a)) / 255) as u8;
                        c = c + 1;
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

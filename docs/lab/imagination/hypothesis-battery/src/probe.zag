// Hypothesis-battery probe for the video-fusion step-5 sticker failure.
// Pure Zag, zero RNG. Assembled after composer_base(head -1582) + fz1-4 + v4a-e.
// Modes:
//   anatomies <work>                  per-frame v4_anatomy_frame dump (H1a, H5)
//   neckplace <workPig> <workBunny>   step-5 warp replication + neck-anchored
//                                     rigid ablations + oracle synthesize (H2a,H3)
//   slotvar <workBunny>               slot determinism + per-frame neck spread (H2b)
//   shake <workPig>                   stabilized vs unstabilized anatomy (H2c)
//   parts <workPig> <workBunny>       ear/eye substructures + part-aware pose (H4)
//   viewcov <workPig> <workBunny>     per-frame frontality + coverage (H5)

// ---------- shared setup: load store, measure shake, cumul, stable-E, noise ----------
// inf (64B): 0=W 8=H 16=nf 24=noise. cum: caller 384B. Es: caller 614400B.
fn pb_setup(work:[]u8, cum:[]u8, Es:[]u8, inf:[]u8) []u8 {
    let st:[]u8 = load_store_full(work);
    let W:i64 = h_get64(st, 32);
    let H:i64 = h_get64(st, 40);
    let nf:i64 = h_get64(st, 48);
    let N:i64 = W * H;
    h_put64(inf, 0, W);
    h_put64(inf, 8, H);
    h_put64(inf, 16, nf);
    let shifts:[]u8 = nio_alloc(368);
    let sdbg:[]u8 = nio_alloc(368);
    v4_shake(st, nf, shifts, sdbg);
    v4_cumul(shifts, nf, cum);
    nio_free(shifts);
    nio_free(sdbg);
    v4_stable_E(st, cum, Es, W, H, nf);
    let histE:[]u8 = nio_alloc(8192);
    seg_histE(Es, N, histE);
    h_put64(inf, 24, seg_pct_bin(histE, 1024, N, 50) * 4);
    nio_free(histE);
    return st;
}

// one v4_anatomy_frame call; lmf is caller-provided 128B. Returns vr.
fn pb_anat(st:[]u8, f:i64, cum:[]u8, Es:[]u8, noise:i64, W:i64, H:i64, lmf:[]u8, hmask:[]u8, nk:[]u8) i64 {
    let dm:[]u8 = nio_alloc(76800);
    let wm:[]u8 = nio_alloc(76800);
    let dst:[]u8 = nio_alloc(160);
    let fvec:[]u8 = nio_alloc(16);
    let sn:[]u8 = nio_alloc(24);
    let hs:[]u8 = nio_alloc(80);
    let mo:[]u8 = nio_alloc(80);
    let ev:[]u8 = nio_alloc(32);
    let vr:i64 = v4_anatomy_frame(st, f, cum, Es, noise, W, H, dm, wm, dst, fvec, sn, nk, hmask, hs, mo, ev, lmf);
    nio_free(dm);
    nio_free(wm);
    nio_free(dst);
    nio_free(fvec);
    nio_free(sn);
    nio_free(hs);
    nio_free(mo);
    nio_free(ev);
    return vr;
}

fn pb_pline(s:[]u8) void {
    _zag_print(s);
    _zag_println("");
}

// ---------- MODE anatomies ----------
fn pb_anatomies(work:[]u8) i32 {
    let cum:[]u8 = nio_alloc(384);
    let Es:[]u8 = nio_alloc(614400);
    let inf:[]u8 = nio_alloc(64);
    let st:[]u8 = pb_setup(work, cum, Es, inf);
    let W:i64 = h_get64(inf, 0);
    let H:i64 = h_get64(inf, 8);
    let nf:i64 = h_get64(inf, 16);
    let noise:i64 = h_get64(inf, 24);
    _zag_print("ANAT W="); _zag_print(_zag_i64_to_str(W));
    _zag_print(" H="); _zag_print(_zag_i64_to_str(H));
    _zag_print(" nf="); _zag_print(_zag_i64_to_str(nf));
    _zag_print(" noise="); _zag_println(_zag_i64_to_str(noise));
    let f:i64 = 0;
    while (f < nf) {
        let lmf:[]u8 = nio_alloc(128);
        let hmask:[]u8 = nio_alloc(76800);
        let nk:[]u8 = nio_alloc(64);
        let vr:i64 = pb_anat(st, f, cum, Es, noise, W, H, lmf, hmask, nk);
        _zag_print("f="); _zag_print(_zag_i64_to_str(f));
        _zag_print(" vr="); _zag_print(_zag_i64_to_str(vr));
        if (vr == 1) {
            let snx:i64 = h_get64(lmf, 64);
            let sny:i64 = h_get64(lmf, 72);
            let dcx:i64 = h_get64(lmf, 16);
            let dcy:i64 = h_get64(lmf, 24);
            let fx:i64 = h_get64(lmf, 88);
            let fy:i64 = h_get64(lmf, 96);
            let dn:i64 = h_get64(lmf, 80);
            let pr:i64 = h_get64(nk, 40);
            let area:i64 = h_get64(lmf, 8);
            let lam1:i64 = h_get64(lmf, 48);
            let lam2:i64 = h_get64(lmf, 56);
            // neck point (donor frame) = dark_snout - d_neck*facing/1024
            let dsx:i64 = h_get64(lmf, 104);
            let dsy:i64 = h_get64(lmf, 112);
            let nkx:i64 = dsx - dn * fx / 1024;
            let nky:i64 = dsy - dn * fy / 1024;
            _zag_print(" snout="); _zag_print(_zag_i64_to_str(snx));
            _zag_print(","); _zag_print(_zag_i64_to_str(sny));
            _zag_print(" dc="); _zag_print(_zag_i64_to_str(dcx / 1024));
            _zag_print(","); _zag_print(_zag_i64_to_str(dcy / 1024));
            _zag_print(" facing="); _zag_print(_zag_i64_to_str(fx));
            _zag_print(","); _zag_print(_zag_i64_to_str(fy));
            _zag_print(" d_neck="); _zag_print(_zag_i64_to_str(dn));
            _zag_print(" prom="); _zag_print(_zag_i64_to_str(pr));
            _zag_print(" area="); _zag_print(_zag_i64_to_str(area));
            _zag_print(" lam1="); _zag_print(_zag_i64_to_str(lam1));
            _zag_print(" lam2="); _zag_print(_zag_i64_to_str(lam2));
            _zag_print(" neckpt="); _zag_print(_zag_i64_to_str(nkx));
            _zag_print(","); _zag_print(_zag_i64_to_str(nky));
        }
        _zag_println("");
        nio_free(lmf);
        nio_free(hmask);
        nio_free(nk);
        f = f + 1;
    }
    nio_free(cum);
    nio_free(Es);
    nio_free(inf);
    return 0;
}

// ---------- MODE neckplace ----------
// Replicates the step-5 pose (ref frame 12, flip=1, cover 1.5x, centroid-
// anchored affine) and reports: warped donor neck point, neck_err vs the
// recipient neck target, and cov/iou reproduced via v4_warp.
// Then ablations: neck-anchored rigid placements (s_sim and cover scale)
// with cov/iou. (H2a warp limiter, H3a near-oracle propose, H3b oracle synth)
fn pb_cov_iou(wm:[]u8, smb:[]u8, n:i64, out:[]u8) void {
    let inter:i64 = 0;
    let union:i64 = 0;
    let slot:i64 = 0;
    let p:i64 = 0;
    while (p < n) {
        let w:i64 = 0;
        if (wm[p] != 0) { w = 1; }
        let s:i64 = 0;
        if (smb[p] != 0) { s = 1; }
        if (w == 1 && s == 1) { inter = inter + 1; }
        if (w == 1 || s == 1) { union = union + 1; }
        if (s == 1) { slot = slot + 1; }
        p = p + 1;
    }
    h_put64(out, 0, inter);
    h_put64(out, 8, union);
    h_put64(out, 16, slot);
}

fn pb_neckplace(workP:[]u8, workB:[]u8) i32 {
    let W:i64 = 320;
    let H:i64 = 240;
    let N:i64 = W * H;
    // pig setup
    let cum:[]u8 = nio_alloc(384);
    let Es:[]u8 = nio_alloc(614400);
    let inf:[]u8 = nio_alloc(64);
    let stp:[]u8 = pb_setup(workP, cum, Es, inf);
    let noise:i64 = h_get64(inf, 24);
    // bunny slot
    let stb:[]u8 = load_store_full(workB);
    let slotm:[]u8 = nio_alloc(76800);
    let slotmo:[]u8 = nio_alloc(80);
    let slotinfo:[]u8 = nio_alloc(32);
    if (v4_slot(stb, W, H, 24, slotm, slotmo, slotinfo) != 0) {
        pb_pline("SLOT_FAIL");
        return 1;
    }
    let neck_line:i64 = h_get64(slotinfo, 0);
    let scx:i64 = h_get64(slotmo, 8);
    let scy:i64 = h_get64(slotmo, 16);
    let sev:[]u8 = nio_alloc(32);
    v4_eigenvec(h_get64(slotmo, 24), h_get64(slotmo, 40), h_get64(slotmo, 32), sev);
    let usx:i64 = h_get64(sev, 0);
    let usy:i64 = h_get64(sev, 8);
    let Ls1:i64 = v4_isqrt(h_get64(sev, 16) * 1024);
    let Ls2:i64 = v4_isqrt(h_get64(sev, 24) * 1024);
    nio_free(sev);
    let sx0:i64 = h_get64(slotmo, 48);
    let sy0:i64 = h_get64(slotmo, 56);
    let sx1:i64 = h_get64(slotmo, 64);
    let sy1:i64 = h_get64(slotmo, 72);
    _zag_print("slot bbox="); _zag_print(_zag_i64_to_str(sx0));
    _zag_print(","); _zag_print(_zag_i64_to_str(sy0));
    _zag_print("-"); _zag_print(_zag_i64_to_str(sx1));
    _zag_print(","); _zag_print(_zag_i64_to_str(sy1));
    _zag_print(" neck_line="); _zag_print(_zag_i64_to_str(neck_line));
    _zag_print(" slot_c="); _zag_print(_zag_i64_to_str(scx / 1024));
    _zag_print(","); _zag_println(_zag_i64_to_str(scy / 1024));
    // pig ref frame 12 anatomy
    let lmf:[]u8 = nio_alloc(128);
    let hmask:[]u8 = nio_alloc(76800);
    let nk:[]u8 = nio_alloc(64);
    let vr:i64 = pb_anat(stp, 12, cum, Es, noise, W, H, lmf, hmask, nk);
    _zag_print("ref12 vr="); _zag_println(_zag_i64_to_str(vr));
    if (vr != 1) { return 2; }
    let dcx:i64 = h_get64(lmf, 16);
    let dcy:i64 = h_get64(lmf, 24);
    // step-5 warp axis = donor PRINCIPAL AXIS (eigenvec, lmf[32,40]), NOT the
    // snout-facing vector (lmf[88,96]). The facing is anatomical; the warp
    // aligns blob axes, then flips so the snout lands in the slot.
    let udx:i64 = h_get64(lmf, 32);
    let udy:i64 = h_get64(lmf, 40);
    let fcx:i64 = h_get64(lmf, 88);
    let fcy:i64 = h_get64(lmf, 96);
    let lam1d:i64 = h_get64(lmf, 48);
    let Ld1:i64 = v4_isqrt(lam1d * 1024);
    if (Ld1 <= 0) { Ld1 = 1; }
    let s_sim:i64 = Ls1 * 1024 / Ld1;
    let ms:i64 = s_sim * 1536 / 1024;
    let dn:i64 = h_get64(lmf, 80);
    let dsx:i64 = h_get64(lmf, 104);
    let dsy:i64 = h_get64(lmf, 112);
    let nkx:i64 = dsx - dn * fcx / 1024;
    let nky:i64 = dsy - dn * fcy / 1024;
    _zag_print("s_sim="); _zag_print(_zag_i64_to_str(s_sim));
    _zag_print(" cover_ms="); _zag_print(_zag_i64_to_str(ms));
    _zag_print(" donor_c="); _zag_print(_zag_i64_to_str(dcx / 1024));
    _zag_print(","); _zag_print(_zag_i64_to_str(dcy / 1024));
    _zag_print(" neck_donor="); _zag_print(_zag_i64_to_str(nkx));
    _zag_print(","); _zag_println(_zag_i64_to_str(nky));
    // recipient neck target: neck line at slot center x
    let tx:i64 = scx / 1024;
    let ty:i64 = neck_line;
    _zag_print("neck_target="); _zag_print(_zag_i64_to_str(tx));
    _zag_print(","); _zag_println(_zag_i64_to_str(ty));
    // ---- current step-5 warp: flip=1, cover, centroid-anchored ----
    let fudx:i64 = 0 - udx;
    let fudy:i64 = 0 - udy;
    let ab:[]u8 = nio_alloc(32);
    v4_abuild(usx, usy, fudx, fudy, ms, ms, ab);
    let ox:i64 = nkx * 1024 - dcx;
    let oy:i64 = nky * 1024 - dcy;
    let qx:i64 = (scx + (h_get64(ab, 0) * ox + h_get64(ab, 8) * oy) / 1024) / 1024;
    let qy:i64 = (scy + (h_get64(ab, 16) * ox + h_get64(ab, 24) * oy) / 1024) / 1024;
    let ddx:i64 = qx - tx;
    let ddy:i64 = qy - ty;
    let neck_err:i64 = v4_isqrt(ddx * ddx + ddy * ddy);
    _zag_print("CURRENT warped_neck="); _zag_print(_zag_i64_to_str(qx));
    _zag_print(","); _zag_print(_zag_i64_to_str(qy));
    _zag_print(" neck_err="); _zag_println(_zag_i64_to_str(neck_err));
    nio_free(ab);
    // ---- reproduce cov/iou via v4_warp on the merge canvas ----
    let sdr:[]u8 = nio_alloc(230400);
    v4_stable_frame(stp, 12, cum, W, H, sdr);
    let wx0:i64 = sx0 - 32;
    if (wx0 < 0) { wx0 = 0; }
    let wy0:i64 = sy0 - 32;
    if (wy0 < 0) { wy0 = 0; }
    let wx1:i64 = sx1 + 32;
    if (wx1 >= W) { wx1 = W - 1; }
    let wy1:i64 = sy1 + 32;
    if (wy1 >= H) { wy1 = H - 1; }
    let cw:i64 = wx1 - wx0 + 1;
    let ch:i64 = wy1 - wy0 + 1;
    let ainv:[]u8 = nio_alloc(48);
    v4_ainv(usx, usy, fudx, fudy, ms, ms, ainv);
    let wpx:[]u8 = nio_alloc(cw * ch * 3);
    let wm:[]u8 = nio_alloc(cw * ch);
    v4_warp(sdr, hmask, W, H, ainv, dcx, dcy, scx / 1024, scy / 1024, wx0, wy0, wx1, wy1, wpx, wm);
    let smb:[]u8 = nio_alloc(cw * ch);
    let yy:i64 = 0;
    while (yy < ch) {
        let xx:i64 = 0;
        while (xx < cw) {
            smb[yy * cw + xx] = slotm[(wy0 + yy) * W + (wx0 + xx)];
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    let ci:[]u8 = nio_alloc(24);
    pb_cov_iou(wm, smb, cw * ch, ci);
    let cov5:i64 = h_get64(ci, 0) * 1024 / h_get64(ci, 16);
    let iou5:i64 = h_get64(ci, 0) * 1024 / h_get64(ci, 8);
    _zag_print("REPRO cov_x1024="); _zag_print(_zag_i64_to_str(cov5));
    _zag_print(" iou_x1024="); _zag_print(_zag_i64_to_str(iou5));
    _zag_print(" (step5 trace: 551, 199)"); _zag_println("");
    nio_free(wpx);
    nio_free(wm);
    nio_free(smb);
    nio_free(ainv);
    nio_free(ci);
    // ---- H1c tuck test: donor neck-band (|bd-d_neck|<=20) warped with step-5
    // geometry; fraction landing below the recipient neck line (y=105).
    // A behind/tuck compositor would keep these OUT of the body region.
    let band:[]u8 = nio_alloc(76800);
    let bp:i64 = 0;
    while (bp < N) {
        band[bp] = 0;
        if (hmask[bp] != 0) {
            let bx:i64 = bp % W;
            let by:i64 = bp / W;
            let bdx:i64 = bx - dsx;
            let bdy:i64 = by - dsy;
            // bd = distance behind snout along facing (pixels, approx)
            let bd:i64 = 0 - (bdx * fcx + bdy * fcy) / 1024;
            if (bd < 0) { bd = 0 - bd; }
            let dd:i64 = bd - dn;
            if (dd < 0) { dd = 0 - dd; }
            if (dd <= 20) { band[bp] = 1; }
        }
        bp = bp + 1;
    }
    let ai4:[]u8 = nio_alloc(48);
    v4_ainv(usx, usy, fudx, fudy, ms, ms, ai4);
    let wpx4:[]u8 = nio_alloc(cw * ch * 3);
    let wm4:[]u8 = nio_alloc(cw * ch);
    v4_warp(sdr, band, W, H, ai4, dcx, dcy, scx / 1024, scy / 1024, wx0, wy0, wx1, wy1, wpx4, wm4);
    let band_n:i64 = 0;
    let band_below:i64 = 0;
    let qy4:i64 = 0;
    while (qy4 < ch) {
        let qx4:i64 = 0;
        while (qx4 < cw) {
            if (wm4[qy4 * cw + qx4] != 0) {
                band_n = band_n + 1;
                if (wy0 + qy4 > neck_line) { band_below = band_below + 1; }
            }
            qx4 = qx4 + 1;
        }
        qy4 = qy4 + 1;
    }
    let tuckfrac:i64 = 0;
    if (band_n > 0) { tuckfrac = band_below * 1024 / band_n; }
    _zag_print("TUCK band_n="); _zag_print(_zag_i64_to_str(band_n));
    _zag_print(" below_neck="); _zag_print(_zag_i64_to_str(band_below));
    _zag_print(" frac_x1024="); _zag_println(_zag_i64_to_str(tuckfrac));
    nio_free(band);
    nio_free(ai4);
    nio_free(wpx4);
    nio_free(wm4);
    // ---- ablation: neck-anchored rigid, full-frame canvas ----
    // Ainv = (1024*1024/s) * I ; dc = neck_donor(x1024) ; sc = neck_target(px)
    let scales:[]u8 = nio_alloc(16);
    h_put64(scales, 0, s_sim);
    h_put64(scales, 8, ms);
    let si:i64 = 0;
    while (si < 2) {
        let s:i64 = h_get64(scales, si * 8);
        let ai2:[]u8 = nio_alloc(48);
        let inv:i64 = 1048576 / s;
        h_put64(ai2, 0, inv);
        h_put64(ai2, 8, 0);
        h_put64(ai2, 16, 0);
        h_put64(ai2, 24, inv);
        h_put64(ai2, 32, inv * inv / 1024);
        h_put64(ai2, 40, 0);
        let wpx2:[]u8 = nio_alloc(N * 3);
        let wm2:[]u8 = nio_alloc(N);
        v4_warp(sdr, hmask, W, H, ai2, nkx * 1024, nky * 1024, tx, ty, 0, 0, W - 1, H - 1, wpx2, wm2);
        let ci2:[]u8 = nio_alloc(24);
        pb_cov_iou(wm2, slotm, N, ci2);
        let cova:i64 = h_get64(ci2, 0) * 1024 / h_get64(ci2, 16);
        let ioua:i64 = h_get64(ci2, 0) * 1024 / h_get64(ci2, 8);
        _zag_print("NECKANCHOR s=");
        _zag_print(_zag_i64_to_str(s));
        _zag_print(" cov_x1024="); _zag_print(_zag_i64_to_str(cova));
        _zag_print(" iou_x1024="); _zag_println(_zag_i64_to_str(ioua));
        nio_free(ai2);
        nio_free(wpx2);
        nio_free(wm2);
        nio_free(ci2);
        si = si + 1;
    }
    nio_free(scales);
    // ---- ablation 2: neck-anchored ALIGNED (step-5 axis alignment + flip=1,
    // cover scale, but anchored at donor neck -> recipient neck target).
    // Isolates the anchor-point variable: same orientation as step 5.
    // Forward: q = nt + A*(p - nd); inverse for v4_warp: p = nd + Ainv*(q-nt).
    let ai3:[]u8 = nio_alloc(48);
    v4_ainv(usx, usy, fudx, fudy, ms, ms, ai3);
    let wpx3:[]u8 = nio_alloc(N * 3);
    let wm3:[]u8 = nio_alloc(N);
    v4_warp(sdr, hmask, W, H, ai3, nkx * 1024, nky * 1024, tx, ty, 0, 0, W - 1, H - 1, wpx3, wm3);
    let ci3:[]u8 = nio_alloc(24);
    pb_cov_iou(wm3, slotm, N, ci3);
    let cova3:i64 = h_get64(ci3, 0) * 1024 / h_get64(ci3, 16);
    let ioua3:i64 = h_get64(ci3, 0) * 1024 / h_get64(ci3, 8);
    _zag_print("NECKALIGN cov_x1024="); _zag_print(_zag_i64_to_str(cova3));
    _zag_print(" iou_x1024="); _zag_println(_zag_i64_to_str(ioua3));
    nio_free(ai3);
    nio_free(wpx3);
    nio_free(wm3);
    nio_free(ci3);
    nio_free(sdr);
    nio_free(lmf);
    nio_free(hmask);
    nio_free(nk);
    nio_free(cum);
    nio_free(Es);
    nio_free(inf);
    nio_free(slotm);
    nio_free(slotmo);
    nio_free(slotinfo);
    return 0;
}

// range-based motion energy over frames [f0, f0+count)
fn pb_motion_E_range(st:[]u8, E:[]u8, W:i64, H:i64, f0:i64, count:i64) i64 {
    let N:i64 = W * H;
    let p:i64 = 0;
    while (p < N) { h_put64(E, p * 8, 0); p = p + 1; }
    let g0:[]u8 = nio_alloc(76800);
    let g1:[]u8 = nio_alloc(76800);
    let fr:[]u8 = nio_alloc(230400);
    if (recall_frame(st, f0, fr) != 0) { return -1; }
    seg_gray(fr, g0, N);
    let f:i64 = f0 + 1;
    while (f < f0 + count) {
        if (recall_frame(st, f, fr) != 0) { return -2; }
        seg_gray(fr, g1, N);
        let q:i64 = 0;
        while (q < N) {
            let d:i64 = (g1[q] as i64) - (g0[q] as i64);
            if (d < 0) { d = 0 - d; }
            h_put64(E, q * 8, h_get64(E, q * 8) + d * 4);
            g0[q] = g1[q];
            q = q + 1;
        }
        f = f + 1;
    }
    nio_free(g0);
    nio_free(g1);
    nio_free(fr);
    return 0;
}

// v4_slot over a frame range [f0, f0+count): duplicates v4_slot logic.
fn pb_slot_range(st:[]u8, W:i64, H:i64, f0:i64, count:i64, out_m:[]u8, mo:[]u8, info:[]u8) i64 {
    let N:i64 = W * H;
    let E:[]u8 = nio_alloc(614400);
    if (pb_motion_E_range(st, E, W, H, f0, count) != 0) { return -710; }
    let hist:[]u8 = nio_alloc(8192);
    seg_histE(E, N, hist);
    let eb:i64 = seg_pct_bin(hist, 1024, N, 85);
    nio_free(hist);
    let ethr:i64 = eb * 4;
    let subj:[]u8 = nio_alloc(76800);
    let p:i64 = 0;
    while (p < N) {
        if (h_get64(E, p * 8) > ethr) { subj[p] = 1; } else { subj[p] = 0; }
        p = p + 1;
    }
    nio_free(E);
    let tmp:[]u8 = nio_alloc(76800);
    seg_open(subj, tmp, W, H, 3);
    seg_fill_holes(subj, W, H);
    nio_free(tmp);
    let lab:[]u8 = nio_alloc(614400);
    let nl:i64 = seg_label(subj, lab, W, H);
    let sid:i64 = seg_largest_id(lab, nl, W, H);
    if (sid <= 0) { return -711; }
    let x0:i64 = W;
    let y0:i64 = H;
    let x1:i64 = -1;
    let y1:i64 = -1;
    p = 0;
    while (p < N) {
        if (h_get64(lab, p * 8) == sid) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            if (x < x0) { x0 = x; }
            if (x > x1) { x1 = x; }
            if (y < y0) { y0 = y; }
            if (y > y1) { y1 = y; }
        }
        p = p + 1;
    }
    nio_free(lab);
    let E2:[]u8 = nio_alloc(614400);
    if (pb_motion_E_range(st, E2, W, H, f0, count) != 0) { return -712; }
    let neck:i64 = seg_neck(E2, subj, W, H, x0, x1, y0, y1);
    nio_free(E2);
    if (neck < 0) { neck = (y0 + y1) / 2; }
    let ha:i64 = 0;
    p = 0;
    while (p < N) {
        out_m[p] = 0;
        if (subj[p] != 0) {
            let y:i64 = p / W;
            if (y < neck) { out_m[p] = 1; ha = ha + 1; }
        }
        p = p + 1;
    }
    nio_free(subj);
    if (ha < 500) { return -713; }
    v4_moments(out_m, W, H, mo);
    h_put64(info, 0, neck);
    h_put64(info, 8, ethr);
    h_put64(info, 16, ha);
    return 0;
}

// ---------- MODE slotvar ----------
// v4_slot determinism (two runs, byte-compare neck+bbox) + per-frame neck
// spread via seg_neck on frame-difference motion (H2b slot stability).
fn pb_slotvar(workB:[]u8) i32 {
    let W:i64 = 320;
    let H:i64 = 240;
    let N:i64 = W * H;
    let stb:[]u8 = load_store_full(workB);
    let r:i64 = 0;
    while (r < 2) {
        let slotm:[]u8 = nio_alloc(76800);
        let slotmo:[]u8 = nio_alloc(80);
        let slotinfo:[]u8 = nio_alloc(32);
        let rc:i64 = v4_slot(stb, W, H, 24, slotm, slotmo, slotinfo);
        _zag_print("run="); _zag_print(_zag_i64_to_str(r));
        _zag_print(" rc="); _zag_print(_zag_i64_to_str(rc));
        _zag_print(" neck="); _zag_print(_zag_i64_to_str(h_get64(slotinfo, 0)));
        _zag_print(" bbox="); _zag_print(_zag_i64_to_str(h_get64(slotmo, 48)));
        _zag_print(","); _zag_print(_zag_i64_to_str(h_get64(slotmo, 56)));
        _zag_print("-"); _zag_print(_zag_i64_to_str(h_get64(slotmo, 64)));
        _zag_print(","); _zag_print(_zag_i64_to_str(h_get64(slotmo, 72)));
        _zag_print(" ha="); _zag_println(_zag_i64_to_str(h_get64(slotinfo, 16)));
        nio_free(slotm);
        nio_free(slotmo);
        nio_free(slotinfo);
        r = r + 1;
    }
    // independent first-half (frames 0-11) vs last-half (12-23) slot (H2b)
    _zag_println("HALFVSHALF");
    let h:i64 = 0;
    while (h < 2) {
        let f0:i64 = h * 12;
        let hm:[]u8 = nio_alloc(76800);
        let hmo:[]u8 = nio_alloc(80);
        let hinf:[]u8 = nio_alloc(32);
        let hrc:i64 = pb_slot_range(stb, W, H, f0, 12, hm, hmo, hinf);
        _zag_print("half="); _zag_print(_zag_i64_to_str(h));
        _zag_print(" f0="); _zag_print(_zag_i64_to_str(f0));
        _zag_print(" rc="); _zag_print(_zag_i64_to_str(hrc));
        _zag_print(" neck="); _zag_print(_zag_i64_to_str(h_get64(hinf, 0)));
        _zag_print(" bbox="); _zag_print(_zag_i64_to_str(h_get64(hmo, 48)));
        _zag_print(","); _zag_print(_zag_i64_to_str(h_get64(hmo, 56)));
        _zag_print("-"); _zag_print(_zag_i64_to_str(h_get64(hmo, 64)));
        _zag_print(","); _zag_print(_zag_i64_to_str(h_get64(hmo, 72)));
        _zag_print(" ha="); _zag_println(_zag_i64_to_str(h_get64(hinf, 16)));
        nio_free(hm);
        nio_free(hmo);
        nio_free(hinf);
        h = h + 1;
    }
    return 0;
}

// ---------- MODE shake ----------
// v4_anatomy_frame with measured cum vs zeroed cum (H2c fixture shake).
fn pb_shake(work:[]u8) i32 {
    let cum:[]u8 = nio_alloc(384);
    let Es:[]u8 = nio_alloc(614400);
    let inf:[]u8 = nio_alloc(64);
    let st:[]u8 = pb_setup(work, cum, Es, inf);
    let W:i64 = h_get64(inf, 0);
    let H:i64 = h_get64(inf, 8);
    let nf:i64 = h_get64(inf, 16);
    let pass:i64 = 0;
    while (pass < 2) {
        let cum2:[]u8 = nio_alloc(384);
        let Es2:[]u8 = nio_alloc(614400);
        if (pass == 0) {
            let i:i64 = 0;
            while (i < 384) { cum2[i] = cum[i]; i = i + 1; }
            let j:i64 = 0;
            while (j < 614400) { Es2[j] = Es[j]; j = j + 1; }
            let histE:[]u8 = nio_alloc(8192);
            seg_histE(Es2, W * H, histE);
            _zag_print("PASS=stab noise=");
            _zag_println(_zag_i64_to_str(seg_pct_bin(histE, 1024, W * H, 50) * 4));
            nio_free(histE);
        } else {
            let i2:i64 = 0;
            while (i2 < 384) { cum2[i2] = 0; i2 = i2 + 1; }
            v4_stable_E(st, cum2, Es2, W, H, nf);
            let histE2:[]u8 = nio_alloc(8192);
            seg_histE(Es2, W * H, histE2);
            _zag_print("PASS=nostab noise=");
            _zag_println(_zag_i64_to_str(seg_pct_bin(histE2, 1024, W * H, 50) * 4));
            nio_free(histE2);
        }
        // noise for this pass
        let histE3:[]u8 = nio_alloc(8192);
        seg_histE(Es2, W * H, histE3);
        let nz:i64 = seg_pct_bin(histE3, 1024, W * H, 50) * 4;
        nio_free(histE3);
        let f:i64 = 0;
        while (f < nf) {
            let lmf:[]u8 = nio_alloc(128);
            let hmask:[]u8 = nio_alloc(76800);
            let nk:[]u8 = nio_alloc(64);
            let vr:i64 = pb_anat(st, f, cum2, Es2, nz, W, H, lmf, hmask, nk);
            _zag_print("pass="); _zag_print(_zag_i64_to_str(pass));
            _zag_print(" f="); _zag_print(_zag_i64_to_str(f));
            _zag_print(" vr="); _zag_print(_zag_i64_to_str(vr));
            if (vr == 1) {
                _zag_print(" snout=");
                _zag_print(_zag_i64_to_str(h_get64(lmf, 64)));
                _zag_print(",");
                _zag_print(_zag_i64_to_str(h_get64(lmf, 72)));
                _zag_print(" prom=");
                _zag_print(_zag_i64_to_str(h_get64(nk, 40)));
            }
            _zag_println("");
            nio_free(lmf);
            nio_free(hmask);
            nio_free(nk);
            f = f + 1;
        }
        nio_free(cum2);
        nio_free(Es2);
        pass = pass + 1;
    }
    nio_free(cum);
    nio_free(Es);
    nio_free(inf);
    return 0;
}

// ---------- shared slot helper ----------
// out(96B): 0=neck 8=scx 16=scy 24=usx 32=usy 40=Ls1 48=Ls2 56=sx0 64=sy0 72=sx1 80=sy1
fn pb_slotinfo(stb:[]u8, W:i64, H:i64, nf:i64, slotm:[]u8, out:[]u8) i64 {
    let slotmo:[]u8 = nio_alloc(80);
    let slotinfo:[]u8 = nio_alloc(32);
    let rc:i64 = v4_slot(stb, W, H, nf, slotm, slotmo, slotinfo);
    if (rc != 0) {
        nio_free(slotmo);
        nio_free(slotinfo);
        return rc;
    }
    h_put64(out, 0, h_get64(slotinfo, 0));
    h_put64(out, 8, h_get64(slotmo, 8));
    h_put64(out, 16, h_get64(slotmo, 16));
    let sev:[]u8 = nio_alloc(32);
    v4_eigenvec(h_get64(slotmo, 24), h_get64(slotmo, 40), h_get64(slotmo, 32), sev);
    h_put64(out, 24, h_get64(sev, 0));
    h_put64(out, 32, h_get64(sev, 8));
    h_put64(out, 40, v4_isqrt(h_get64(sev, 16) * 1024));
    h_put64(out, 48, v4_isqrt(h_get64(sev, 24) * 1024));
    nio_free(sev);
    h_put64(out, 56, h_get64(slotmo, 48));
    h_put64(out, 64, h_get64(slotmo, 56));
    h_put64(out, 72, h_get64(slotmo, 64));
    h_put64(out, 80, h_get64(slotmo, 72));
    nio_free(slotmo);
    nio_free(slotinfo);
    return 0;
}

// 2-point similarity p1->q1, p2->q2 (pixels). out Ainv: 2x2 x1024 inverse
// (slot px -> donor x1024), for v4_warp with dc=p1(x1024), sc=q1(px).
fn pb_sim2(p1x:i64, p1y:i64, p2x:i64, p2y:i64, q1x:i64, q1y:i64, q2x:i64, q2y:i64, ainv:[]u8) void {
    let vx:i64 = p2x - p1x;
    let vy:i64 = p2y - p1y;
    let wx:i64 = q2x - q1x;
    let wy:i64 = q2y - q1y;
    let vl:i64 = v4_isqrt(vx * vx + vy * vy);
    let wl:i64 = v4_isqrt(wx * wx + wy * wy);
    if (vl <= 0 || wl <= 0) {
        h_put64(ainv, 0, 1024); h_put64(ainv, 8, 0);
        h_put64(ainv, 16, 0); h_put64(ainv, 24, 1024);
        h_put64(ainv, 40, 0);
        return;
    }
    // unit dirs x1024
    let vcx:i64 = vx * 1024 / vl;
    let vcy:i64 = vy * 1024 / vl;
    let wcx:i64 = wx * 1024 / wl;
    let wcy:i64 = wy * 1024 / wl;
    // rotation taking v->w: r = w*conj(v), x1024
    let rx:i64 = (wcx * vcx + wcy * vcy) / 1024;
    let ry:i64 = (wcy * vcx - wcx * vcy) / 1024;
    // forward A (x1024): s*R, s = wl/vl x1024
    let s:i64 = wl * 1024 / vl;
    let a:i64 = s * rx / 1024;
    let b:i64 = s * ry / 1024;
    // Ainv = (a,b;-b,a)/(a^2+b^2), x1024
    let den:i64 = (a * a + b * b) / 1024;
    if (den == 0) { den = 1; }
    h_put64(ainv, 0, a * 1024 / den);
    h_put64(ainv, 8, b * 1024 / den);
    h_put64(ainv, 16, (0 - b) * 1024 / den);
    h_put64(ainv, 24, a * 1024 / den);
    h_put64(ainv, 40, 0);
}

// forward-map one donor point through A (x1024 2x2 at ab) : q = sc + A*(p-dc)
fn pb_fwarp(ab:[]u8, px:i64, py:i64, dcx:i64, dcy:i64, scx:i64, scy:i64, out:[]u8) void {
    let ox:i64 = px * 1024 - dcx;
    let oy:i64 = py * 1024 - dcy;
    h_put64(out, 0, (scx + (h_get64(ab, 0) * ox + h_get64(ab, 8) * oy) / 1024) / 1024);
    h_put64(out, 8, (scy + (h_get64(ab, 16) * ox + h_get64(ab, 24) * oy) / 1024) / 1024);
}

// ---------- MODE parts ----------
// Ear/eye substructure detection + part-aware pose (H4 knowledge-gap test).
fn pb_parts(workP:[]u8, workB:[]u8) i32 {
    let W:i64 = 320;
    let H:i64 = 240;
    let N:i64 = W * H;
    let cum:[]u8 = nio_alloc(384);
    let Es:[]u8 = nio_alloc(614400);
    let inf:[]u8 = nio_alloc(64);
    let stp:[]u8 = pb_setup(workP, cum, Es, inf);
    let noise:i64 = h_get64(inf, 24);
    let stb:[]u8 = load_store_full(workB);
    let slotm:[]u8 = nio_alloc(76800);
    let si:[]u8 = nio_alloc(96);
    if (pb_slotinfo(stb, W, H, 24, slotm, si) != 0) {
        pb_pline("SLOT_FAIL");
        return 1;
    }
    let scx:i64 = h_get64(si, 8);
    let scy:i64 = h_get64(si, 16);
    let usx:i64 = h_get64(si, 24);
    let usy:i64 = h_get64(si, 32);
    let Ls1:i64 = h_get64(si, 40);
    // ref frame 12
    let lmf:[]u8 = nio_alloc(128);
    let hmask:[]u8 = nio_alloc(76800);
    let nk:[]u8 = nio_alloc(64);
    if (pb_anat(stp, 12, cum, Es, noise, W, H, lmf, hmask, nk) != 1) {
        pb_pline("ANAT_FAIL");
        return 2;
    }
    let dcx:i64 = h_get64(lmf, 16);
    let dcy:i64 = h_get64(lmf, 24);
    // step-5 baseline axis = donor principal axis (eigenvec), not facing
    let udx:i64 = h_get64(lmf, 32);
    let udy:i64 = h_get64(lmf, 40);
    let Ld1:i64 = v4_isqrt(h_get64(lmf, 48) * 1024);
    if (Ld1 <= 0) { Ld1 = 1; }
    let s_sim:i64 = Ls1 * 1024 / Ld1;
    let ms:i64 = s_sim * 1536 / 1024;
    let snx:i64 = h_get64(lmf, 64);
    let sny:i64 = h_get64(lmf, 72);
    let cx:i64 = dcx / 1024;
    let cy:i64 = dcy / 1024;
    // stabilized frame + gray
    let sdr:[]u8 = nio_alloc(230400);
    v4_stable_frame(stp, 12, cum, W, H, sdr);
    let gray:[]u8 = nio_alloc(76800);
    seg_gray(sdr, gray, N);
    // ear tips: topmost+lateral extremal mask pixels, left/right of centroid
    let e1x:i64 = -1;
    let e1y:i64 = -1;
    let e2x:i64 = -1;
    let e2y:i64 = -1;
    let bs1:i64 = -1;
    let bs2:i64 = -1;
    let p:i64 = 0;
    while (p < N) {
        if (hmask[p] != 0) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            if (y < cy) {
                let score:i64 = (cy - y) * 1024;
                if (x < cx) { score = score + (cx - x) * 256; } else { score = score + (x - cx) * 256; }
                if (x * 1024 < dcx) {
                    if (score > bs1) { bs1 = score; e1x = x; e1y = y; }
                } else {
                    if (score > bs2) { bs2 = score; e2x = x; e2y = y; }
                }
            }
        }
        p = p + 1;
    }
    // interior mask (2-iteration 8-neighbor erosion) for eyes
    let int1:[]u8 = nio_alloc(76800);
    let int2:[]u8 = nio_alloc(76800);
    p = 0;
    while (p < N) {
        int1[p] = hmask[p];
        p = p + 1;
    }
    let it:i64 = 0;
    while (it < 2) {
        let y:i64 = 1;
        while (y < H - 1) {
            let x:i64 = 1;
            while (x < W - 1) {
                let q:i64 = y * W + x;
                let ok:i64 = 1;
                let dy:i64 = -1;
                while (dy <= 1) {
                    let dx:i64 = -1;
                    while (dx <= 1) {
                        if (int1[q + dy * W + dx] == 0) { ok = 0; }
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }
                if (ok == 1) { int2[q] = 1; } else { int2[q] = 0; }
                x = x + 1;
            }
            y = y + 1;
        }
        let cp:i64 = 0;
        while (cp < N) { int1[cp] = int2[cp]; cp = cp + 1; }
        it = it + 1;
    }
    // eyes: two darkest well-separated interior pixels
    let y1x:i64 = -1;
    let y1y:i64 = -1;
    let y2x:i64 = -1;
    let y2y:i64 = -1;
    let bd1:i64 = 999999;
    p = 0;
    while (p < N) {
        if (int1[p] != 0) {
            let g:i64 = gray[p] as i64;
            if (g < bd1) { bd1 = g; y1x = p % W; y1y = p / W; }
        }
        p = p + 1;
    }
    let bd2:i64 = 999999;
    p = 0;
    while (p < N) {
        if (int1[p] != 0) {
            let g2:i64 = gray[p] as i64;
            let dx2:i64 = (p % W) - y1x;
            let dy2:i64 = (p / W) - y1y;
            if (dx2 * dx2 + dy2 * dy2 >= 400 && g2 < bd2) { bd2 = g2; y2x = p % W; y2y = p / W; }
        }
        p = p + 1;
    }
    _zag_print("PARTS earL="); _zag_print(_zag_i64_to_str(e1x));
    _zag_print(","); _zag_print(_zag_i64_to_str(e1y));
    _zag_print(" earR="); _zag_print(_zag_i64_to_str(e2x));
    _zag_print(","); _zag_print(_zag_i64_to_str(e2y));
    _zag_print(" eye1="); _zag_print(_zag_i64_to_str(y1x));
    _zag_print(","); _zag_print(_zag_i64_to_str(y1y));
    _zag_print(" g="); _zag_print(_zag_i64_to_str(bd1));
    _zag_print(" eye2="); _zag_print(_zag_i64_to_str(y2x));
    _zag_print(","); _zag_print(_zag_i64_to_str(y2y));
    _zag_print(" g="); _zag_print(_zag_i64_to_str(bd2));
    _zag_print(" snout="); _zag_print(_zag_i64_to_str(snx));
    _zag_print(","); _zag_println(_zag_i64_to_str(sny));
    // current warp (flip=1, cover) forward matrix: step-5 baseline
    let ab:[]u8 = nio_alloc(32);
    v4_abuild(usx, usy, 0 - udx, 0 - udy, ms, ms, ab);
    // part-aware warp (prereg H4): donor ears -> slot top corners (2-point
    // similarity), anchored at earL->top-left. Snout should land below
    // the slot centroid if the part knowledge is anatomically sound.
    let ai2:[]u8 = nio_alloc(48);
    let has_ears:i64 = 0;
    if (e1x >= 0 && e2x >= 0) { has_ears = 1; }
    if (has_ears == 1) {
        pb_sim2(e1x, e1y, e2x, e2y, h_get64(si, 56), h_get64(si, 64), h_get64(si, 72), h_get64(si, 64), ai2);
    } else {
        v4_ainv(usx, usy, udx, udy, s_sim, s_sim, ai2);
    }
    // warp the 5 landmarks through both; print. For the part warp we need
    // the forward map; rebuild it from the same 2-point similarity.
    let pts:[]u8 = nio_alloc(80);
    h_put64(pts, 0, e1x); h_put64(pts, 8, e1y);
    h_put64(pts, 16, e2x); h_put64(pts, 24, e2y);
    h_put64(pts, 32, y1x); h_put64(pts, 40, y1y);
    h_put64(pts, 48, y2x); h_put64(pts, 56, y2y);
    h_put64(pts, 64, snx); h_put64(pts, 72, sny);
    // forward part matrix: rebuild via v4_abuild on the ear basis
    let abp:[]u8 = nio_alloc(32);
    if (has_ears == 1) {
        let ex:i64 = e2x - e1x;
        let ey:i64 = e2y - e1y;
        let el:i64 = v4_isqrt(ex * ex + ey * ey);
        let cs:i64 = 1024;
        let sn2:i64 = 0;
        if (el > 0) { cs = ex * 1024 / el; sn2 = ey * 1024 / el; }
        let sw:i64 = h_get64(si, 72) - h_get64(si, 56);
        let sp:i64 = s_sim;
        if (el > 0) { sp = sw * 1024 / el; }
        // donor ear-dir (cs,sn2) -> slot x-axis (1024,0)
        v4_abuild(1024, 0, cs, sn2, sp, sp, abp);
    } else {
        v4_abuild(usx, usy, udx, udy, s_sim, s_sim, abp);
    }
    let k:i64 = 0;
    while (k < 5) {
        let q:[]u8 = nio_alloc(16);
        pb_fwarp(ab, h_get64(pts, k * 16), h_get64(pts, k * 16 + 8), dcx, dcy, scx, scy, q);
        _zag_print("cur_warp pt"); _zag_print(_zag_i64_to_str(k));
        _zag_print("="); _zag_print(_zag_i64_to_str(h_get64(q, 0)));
        _zag_print(","); _zag_print(_zag_i64_to_str(h_get64(q, 8)));
        // part warp anchored at earL->slot top-left corner
        let dcpx:i64 = dcx;
        let dcpy:i64 = dcy;
        let scpx:i64 = scx;
        let scpy:i64 = scy;
        if (has_ears == 1) {
            dcpx = e1x * 1024; dcpy = e1y * 1024;
            scpx = h_get64(si, 56) * 1024; scpy = h_get64(si, 64) * 1024;
        }
        pb_fwarp(abp, h_get64(pts, k * 16), h_get64(pts, k * 16 + 8), dcpx, dcpy, scpx, scpy, q);
        _zag_print(" part_warp="); _zag_print(_zag_i64_to_str(h_get64(q, 0)));
        _zag_print(","); _zag_println(_zag_i64_to_str(h_get64(q, 8)));
        nio_free(q);
        k = k + 1;
    }
    // part separation: ear-mid to snout distance / slot diagonal, both warps.
    // (larger = parts better separated in the placed graft)
    let sdiag:i64 = v4_isqrt((h_get64(si, 72) - h_get64(si, 56)) * (h_get64(si, 72) - h_get64(si, 56)) + (h_get64(si, 64) - h_get64(si, 56)) * (h_get64(si, 64) - h_get64(si, 56)));
    if (sdiag <= 0) { sdiag = 1; }
    // part-aware cov/iou via v4_warp with Ainv from the 2-point similarity,
    // anchored donor-earL(x1024) -> slot top-left(px).
    let wx0:i64 = h_get64(si, 56) - 32;
    if (wx0 < 0) { wx0 = 0; }
    let wy0:i64 = h_get64(si, 64) - 32;
    if (wy0 < 0) { wy0 = 0; }
    let wx1:i64 = h_get64(si, 72) + 32;
    if (wx1 >= W) { wx1 = W - 1; }
    let wy1:i64 = h_get64(si, 80) + 32;
    if (wy1 >= H) { wy1 = H - 1; }
    let cw:i64 = wx1 - wx0 + 1;
    let ch:i64 = wy1 - wy0 + 1;
    let wpx:[]u8 = nio_alloc(cw * ch * 3);
    let wm:[]u8 = nio_alloc(cw * ch);
    // anchor: donor earL (x1024) -> slot top-left (px); fallback centroid
    let pdcx:i64 = dcx;
    let pdcy:i64 = dcy;
    let pscx:i64 = scx / 1024;
    let pscy:i64 = scy / 1024;
    if (has_ears == 1) {
        pdcx = e1x * 1024; pdcy = e1y * 1024;
        pscx = h_get64(si, 56); pscy = h_get64(si, 64);
    }
    v4_warp(sdr, hmask, W, H, ai2, pdcx, pdcy, pscx, pscy, wx0, wy0, wx1, wy1, wpx, wm);
    let smb:[]u8 = nio_alloc(cw * ch);
    let yy2:i64 = 0;
    while (yy2 < ch) {
        let xx2:i64 = 0;
        while (xx2 < cw) {
            smb[yy2 * cw + xx2] = slotm[(wy0 + yy2) * W + (wx0 + xx2)];
            xx2 = xx2 + 1;
        }
        yy2 = yy2 + 1;
    }
    let ci:[]u8 = nio_alloc(24);
    pb_cov_iou(wm, smb, cw * ch, ci);
    let covp:i64 = h_get64(ci, 0) * 1024 / h_get64(ci, 16);
    let ioup:i64 = h_get64(ci, 0) * 1024 / h_get64(ci, 8);
    _zag_print("PARTWARP cov_x1024="); _zag_print(_zag_i64_to_str(covp));
    _zag_print(" iou_x1024="); _zag_println(_zag_i64_to_str(ioup));
    nio_free(pts);
    nio_free(ab);
    nio_free(abp);
    nio_free(ai2);
    nio_free(wpx);
    nio_free(wm);
    nio_free(smb);
    nio_free(ci);
    nio_free(int1);
    nio_free(int2);
    nio_free(gray);
    nio_free(sdr);
    nio_free(lmf);
    nio_free(hmask);
    nio_free(nk);
    nio_free(cum);
    nio_free(Es);
    nio_free(inf);
    nio_free(slotm);
    nio_free(si);
    return 0;
}

// ---------- MODE viewcov ----------
// Per-frame frontality + coverage under the current geometry (H5).
fn pb_viewcov(workP:[]u8, workB:[]u8) i32 {
    let W:i64 = 320;
    let H:i64 = 240;
    let N:i64 = W * H;
    let cum:[]u8 = nio_alloc(384);
    let Es:[]u8 = nio_alloc(614400);
    let inf:[]u8 = nio_alloc(64);
    let stp:[]u8 = pb_setup(workP, cum, Es, inf);
    let noise:i64 = h_get64(inf, 24);
    let nf:i64 = h_get64(inf, 16);
    let stb:[]u8 = load_store_full(workB);
    let slotm:[]u8 = nio_alloc(76800);
    let si:[]u8 = nio_alloc(96);
    if (pb_slotinfo(stb, W, H, 24, slotm, si) != 0) {
        pb_pline("SLOT_FAIL");
        return 1;
    }
    let scx:i64 = h_get64(si, 8);
    let scy:i64 = h_get64(si, 16);
    let usx:i64 = h_get64(si, 24);
    let usy:i64 = h_get64(si, 32);
    let Ls1:i64 = h_get64(si, 40);
    let wx0:i64 = h_get64(si, 56) - 32;
    if (wx0 < 0) { wx0 = 0; }
    let wy0:i64 = h_get64(si, 64) - 32;
    if (wy0 < 0) { wy0 = 0; }
    let wx1:i64 = h_get64(si, 72) + 32;
    if (wx1 >= W) { wx1 = W - 1; }
    let wy1:i64 = h_get64(si, 80) + 32;
    if (wy1 >= H) { wy1 = H - 1; }
    let cw:i64 = wx1 - wx0 + 1;
    let ch:i64 = wy1 - wy0 + 1;
    let smb:[]u8 = nio_alloc(cw * ch);
    let yy:i64 = 0;
    while (yy < ch) {
        let xx:i64 = 0;
        while (xx < cw) {
            smb[yy * cw + xx] = slotm[(wy0 + yy) * W + (wx0 + xx)];
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    _zag_println("VIEWCOV f frontality_x1024 cov_x1024 iou_x1024 neck_err");
    let f:i64 = 0;
    while (f < nf) {
        let lmf:[]u8 = nio_alloc(128);
        let hmask:[]u8 = nio_alloc(76800);
        let nk:[]u8 = nio_alloc(64);
        let vr:i64 = pb_anat(stp, f, cum, Es, noise, W, H, lmf, hmask, nk);
        if (vr == 1) {
            let lam1:i64 = h_get64(lmf, 48);
            let lam2:i64 = h_get64(lmf, 56);
            let front:i64 = 0;
            if (lam1 > 0) { front = lam2 * 1024 / lam1; }
            let dcx:i64 = h_get64(lmf, 16);
            let dcy:i64 = h_get64(lmf, 24);
            // step-5 warp axis = donor principal axis (eigenvec)
            let udx:i64 = h_get64(lmf, 32);
            let udy:i64 = h_get64(lmf, 40);
            // anatomical neck via facing (lmf[88,96]) + snout/d_neck
            let fcx:i64 = h_get64(lmf, 88);
            let fcy:i64 = h_get64(lmf, 96);
            let dn:i64 = h_get64(lmf, 80);
            let dsx:i64 = h_get64(lmf, 104);
            let dsy:i64 = h_get64(lmf, 112);
            let nkx:i64 = dsx - dn * fcx / 1024;
            let nky:i64 = dsy - dn * fcy / 1024;
            let Ld1:i64 = v4_isqrt(lam1 * 1024);
            if (Ld1 <= 0) { Ld1 = 1; }
            let s_sim:i64 = Ls1 * 1024 / Ld1;
            let ms:i64 = s_sim * 1536 / 1024;
            let ainv:[]u8 = nio_alloc(48);
            v4_ainv(usx, usy, 0 - udx, 0 - udy, ms, ms, ainv);
            // forward matrix for the neck point
            let ab:[]u8 = nio_alloc(32);
            v4_abuild(usx, usy, 0 - udx, 0 - udy, ms, ms, ab);
            let ox:i64 = nkx * 1024 - dcx;
            let oy:i64 = nky * 1024 - dcy;
            let qx:i64 = (scx + (h_get64(ab, 0) * ox + h_get64(ab, 8) * oy) / 1024) / 1024;
            let qy:i64 = (scy + (h_get64(ab, 16) * ox + h_get64(ab, 24) * oy) / 1024) / 1024;
            // recipient neck target: neck line at slot center x
            let tx:i64 = h_get64(si, 8) / 1024;
            let ty:i64 = h_get64(si, 0);
            let ddx:i64 = qx - tx;
            let ddy:i64 = qy - ty;
            let neck_err:i64 = v4_isqrt(ddx * ddx + ddy * ddy);
            nio_free(ab);
            let sdr:[]u8 = nio_alloc(230400);
            v4_stable_frame(stp, f, cum, W, H, sdr);
            let wpx:[]u8 = nio_alloc(cw * ch * 3);
            let wm:[]u8 = nio_alloc(cw * ch);
            v4_warp(sdr, hmask, W, H, ainv, dcx, dcy, scx / 1024, scy / 1024, wx0, wy0, wx1, wy1, wpx, wm);
            let ci:[]u8 = nio_alloc(24);
            pb_cov_iou(wm, smb, cw * ch, ci);
            let covf:i64 = h_get64(ci, 0) * 1024 / h_get64(ci, 16);
            let iouf:i64 = h_get64(ci, 0) * 1024 / h_get64(ci, 8);
            _zag_print("f="); _zag_print(_zag_i64_to_str(f));
            _zag_print(" front="); _zag_print(_zag_i64_to_str(front));
            _zag_print(" cov="); _zag_print(_zag_i64_to_str(covf));
            _zag_print(" iou="); _zag_print(_zag_i64_to_str(iouf));
            _zag_print(" neck_err="); _zag_println(_zag_i64_to_str(neck_err));
            nio_free(ainv);
            nio_free(sdr);
            nio_free(wpx);
            nio_free(wm);
            nio_free(ci);
        }
        nio_free(lmf);
        nio_free(hmask);
        nio_free(nk);
        f = f + 1;
    }
    nio_free(smb);
    nio_free(cum);
    nio_free(Es);
    nio_free(inf);
    nio_free(slotm);
    nio_free(si);
    return 0;
}

// ---------- MODE oracle ----------
// H3 propose->synthesize frontier: brute-force oracle over scale+translation
// (step-5 orientation) maximizing cov. If best cov <650 or neck_err>=20,
// the frontier is the bottleneck, not the proposal heuristic.
fn pb_oracle(workP:[]u8, workB:[]u8) i32 {
    let W:i64 = 320;
    let H:i64 = 240;
    let N:i64 = W * H;
    let cum:[]u8 = nio_alloc(384);
    let Es:[]u8 = nio_alloc(614400);
    let inf:[]u8 = nio_alloc(64);
    let stp:[]u8 = pb_setup(workP, cum, Es, inf);
    let noise:i64 = h_get64(inf, 24);
    let stb:[]u8 = load_store_full(workB);
    let slotm:[]u8 = nio_alloc(76800);
    let si:[]u8 = nio_alloc(96);
    if (pb_slotinfo(stb, W, H, 24, slotm, si) != 0) {
        pb_pline("SLOT_FAIL");
        return 1;
    }
    let scx:i64 = h_get64(si, 8);
    let scy:i64 = h_get64(si, 16);
    let usx:i64 = h_get64(si, 24);
    let usy:i64 = h_get64(si, 32);
    let sx0:i64 = h_get64(si, 56);
    let sy0:i64 = h_get64(si, 64);
    let sx1:i64 = h_get64(si, 72);
    let sy1:i64 = h_get64(si, 80);
    let neck_line:i64 = h_get64(si, 0);
    // donor ref frame 12
    let lmf:[]u8 = nio_alloc(128);
    let hmask:[]u8 = nio_alloc(76800);
    let nk:[]u8 = nio_alloc(64);
    if (pb_anat(stp, 12, cum, Es, noise, W, H, lmf, hmask, nk) != 1) {
        pb_pline("ANAT_FAIL");
        return 2;
    }
    let dcx:i64 = h_get64(lmf, 16);
    let dcy:i64 = h_get64(lmf, 24);
    let udx:i64 = h_get64(lmf, 32);
    let udy:i64 = h_get64(lmf, 40);
    let fcx:i64 = h_get64(lmf, 88);
    let fcy:i64 = h_get64(lmf, 96);
    let dn:i64 = h_get64(lmf, 80);
    let dsx:i64 = h_get64(lmf, 104);
    let dsy:i64 = h_get64(lmf, 112);
    let nkx:i64 = dsx - dn * fcx / 1024;
    let nky:i64 = dsy - dn * fcy / 1024;
    let sdr:[]u8 = nio_alloc(230400);
    v4_stable_frame(stp, 12, cum, W, H, sdr);
    // canvas = full frame; slot mask full-frame
    // brute force: scale s in [640..1792] step 128, dx in [-64..64] step 16,
    // dy in [-64..64] step 16. Orientation fixed (step-5 flip=1).
    // For each: Ainv via v4_ainv(us, -ud, s, s); warp; cov; neck_err.
    let best_cov:i64 = -1;
    let best_s:i64 = 0;
    let best_dx:i64 = 0;
    let best_dy:i64 = 0;
    let best_neck:i64 = 0;
    let s:i64 = 640;
    while (s <= 1792) {
        let dx:i64 = -64;
        while (dx <= 64) {
            let dy:i64 = -64;
            while (dy <= 64) {
                let ainv:[]u8 = nio_alloc(48);
                v4_ainv(usx, usy, 0 - udx, 0 - udy, s, s, ainv);
                if (h_get64(ainv, 40) == 0) {
                    // anchor: donor centroid -> slot center + (dx,dy)
                    let tscx:i64 = scx / 1024 + dx;
                    let tscy:i64 = scy / 1024 + dy;
                    let wpx:[]u8 = nio_alloc(N * 3);
                    let wm:[]u8 = nio_alloc(N);
                    v4_warp(sdr, hmask, W, H, ainv, dcx, dcy, tscx, tscy, 0, 0, W - 1, H - 1, wpx, wm);
                    let ci:[]u8 = nio_alloc(24);
                    pb_cov_iou(wm, slotm, N, ci);
                    let slot_n:i64 = h_get64(ci, 16);
                    let cov:i64 = 0;
                    if (slot_n > 0) { cov = h_get64(ci, 0) * 1024 / slot_n; }
                    if (cov > best_cov) {
                        best_cov = cov;
                        best_s = s;
                        best_dx = dx;
                        best_dy = dy;
                        // neck_err at this placement
                        let ab:[]u8 = nio_alloc(32);
                        v4_abuild(usx, usy, 0 - udx, 0 - udy, s, s, ab);
                        let ox:i64 = nkx * 1024 - dcx;
                        let oy:i64 = nky * 1024 - dcy;
                        let qx:i64 = (tscx * 1024 + (h_get64(ab, 0) * ox + h_get64(ab, 8) * oy) / 1024) / 1024;
                        let qy:i64 = (tscy * 1024 + (h_get64(ab, 16) * ox + h_get64(ab, 24) * oy) / 1024) / 1024;
                        let tx:i64 = scx / 1024;
                        let ty:i64 = neck_line;
                        let ddx:i64 = qx - tx;
                        let ddy:i64 = qy - ty;
                        best_neck = v4_isqrt(ddx * ddx + ddy * ddy);
                        nio_free(ab);
                    }
                    nio_free(wpx);
                    nio_free(wm);
                    nio_free(ci);
                }
                nio_free(ainv);
                dy = dy + 16;
            }
            dx = dx + 16;
        }
        s = s + 128;
    }
    _zag_print("ORACLE best_cov_x1024="); _zag_print(_zag_i64_to_str(best_cov));
    _zag_print(" s="); _zag_print(_zag_i64_to_str(best_s));
    _zag_print(" dx="); _zag_print(_zag_i64_to_str(best_dx));
    _zag_print(" dy="); _zag_print(_zag_i64_to_str(best_dy));
    _zag_print(" neck_err="); _zag_println(_zag_i64_to_str(best_neck));
    nio_free(sdr);
    nio_free(lmf);
    nio_free(hmask);
    nio_free(nk);
    nio_free(cum);
    nio_free(Es);
    nio_free(inf);
    nio_free(slotm);
    nio_free(si);
    return 0;
}

// ---------- main ----------
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    if (_zag_strcmp(a1, "anatomies") == 1) { return pb_anatomies(a2); }
    if (_zag_strcmp(a1, "neckplace") == 1) { return pb_neckplace(a2, a3); }
    if (_zag_strcmp(a1, "slotvar") == 1) { return pb_slotvar(a2); }
    if (_zag_strcmp(a1, "shake") == 1) { return pb_shake(a2); }
    if (_zag_strcmp(a1, "parts") == 1) { return pb_parts(a2, a3); }
    if (_zag_strcmp(a1, "viewcov") == 1) { return pb_viewcov(a2, a3); }
    if (_zag_strcmp(a1, "oracle") == 1) { return pb_oracle(a2, a3); }
    _zag_println("usage: probe anatomies|neckplace|slotvar|shake|parts|viewcov|oracle ...");
    return 99;
}

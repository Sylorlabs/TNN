// ================= NO-BRIDGES COMPOSER: nb2 — invention (propose + apply) =================
// The mechanism invents segmentation METHODS by composing cut-procedure schemas
// with the fields it measured in nb1. Schemas (programmer-supplied vocabulary):
//   VALLEY: cut at the deepest valley between the two tallest histogram peaks
//           (applies only when the field's own distribution shows >=2 peaks and
//           a valley at least as deep as the cross-field median bar —
//           the bar is derived from the data, not handed in)
//   MEDIAN: cut at the field's own median
//   KNEE:   cut at the max-curvature bend of the field's cumulative histogram
//   BAND:   three parts split at the field's own Q1 and Q3
// Every level is computed from the field's own distribution. The mechanism
// decides which schema×field combinations to instantiate and records why.

fn nb_procname(tr:[]u8, o:i64, proc:i64) i64 {
    if (proc == 0) { return tr_str(tr, o, "VALLEY"); }
    if (proc == 1) { return tr_str(tr, o, "MEDIAN"); }
    if (proc == 2) { return tr_str(tr, o, "KNEE"); }
    return tr_str(tr, o, "BAND");
}

fn nb_tr_method(tr:[]u8, o:i64, fkind:i64, proc:i64, l1:i64, l2:i64) i64 {
    o = nb_fname(tr, o, fkind);
    o = tr_str(tr, o, "/");
    o = nb_procname(tr, o, proc);
    o = tr_str(tr, o, "@");
    o = tr_i64(tr, o, l1);
    if (proc == 3) {
        o = tr_str(tr, o, ",");
        o = tr_i64(tr, o, l2);
    }
    return o;
}

// build the field values for one frame: gray always; fb for TEX/VAR kinds.
// fr = 230400 scratch. returns 0 or negative rc.
fn nb_field_frame(st:[]u8, frame:i64, fkind:i64, E:[]u8, gray:[]u8, fb:[]u8, fr:[]u8, W:i64, H:i64, N:i64) i64 {
    if (recall_frame(st, frame, fr) != 0) { return -1; }
    seg_gray(fr, gray, N);
    if (fkind == 1) { seg_texture(gray, fb, W, H); }
    if (fkind == 3) { nb_var_field(gray, fb, W, H); }
    return 0;
}

// apply one invented method to one frame; lab = N u8 label map; returns nparts
// (labels remapped so label k has the k-th smallest mean field value —
// this keeps labels comparable across frames for the persistence test).
fn nb_apply(st:[]u8, frame:i64, fkind:i64, proc:i64, l1:i64, l2:i64, W:i64, H:i64, N:i64, E:[]u8, gray:[]u8, fb:[]u8, fr:[]u8, lab:[]u8) i64 {
    if (nb_field_frame(st, frame, fkind, E, gray, fb, fr, W, H, N) != 0) { return -1; }
    let nparts:i64 = 2;
    if (proc == 3) { nparts = 3; }
    let F:[]u8 = gray;
    if (fkind == 1) { F = fb; }
    if (fkind == 2) { F = E; }
    if (fkind == 3) { F = fb; }
    let p:i64 = 0;
    while (p < N) {
        let v:i64 = nb_fval(fkind, F, p);
        let r:i64 = 0;
        if (proc == 3) {
            if (v < l1) { r = 0; } else { if (v < l2) { r = 1; } else { r = 2; } }
        } else {
            if (v > l1) { r = 1; } else { r = 0; }
        }
        lab[p] = r as u8;
        p = p + 1;
    }
    // means per raw label
    let acc:[]u8 = nio_alloc(48);
    let cnt:[]u8 = nio_alloc(48);
    let k:i64 = 0;
    while (k < 3) {
        h_put64(acc, k * 8, 0);
        h_put64(cnt, k * 8, 0);
        k = k + 1;
    }
    p = 0;
    while (p < N) {
        let r:i64 = (lab[p] as i64);
        let v:i64 = nb_fval(fkind, F, p);
        h_put64(acc, r * 8, h_get64(acc, r * 8) + v);
        h_put64(cnt, r * 8, h_get64(cnt, r * 8) + 1);
        p = p + 1;
    }
    // rank labels by mean (empty labels sort first, deterministic)
    let rank:[]u8 = nio_alloc(24);
    k = 0;
    while (k < 3) {
        h_put64(rank, k * 8, k);
        k = k + 1;
    }
    let a:i64 = 0;
    while (a < 3) {
        let b:i64 = a + 1;
        while (b < 3) {
            let ra:i64 = h_get64(rank, a * 8);
            let rb:i64 = h_get64(rank, b * 8);
            let ca:i64 = h_get64(cnt, ra * 8);
            let cb:i64 = h_get64(cnt, rb * 8);
            let ma:i64 = -1;
            let mb:i64 = -1;
            if (ca > 0) { ma = h_get64(acc, ra * 8) / ca; }
            if (cb > 0) { mb = h_get64(acc, rb * 8) / cb; }
            if (mb < ma) {
                h_put64(rank, a * 8, rb);
                h_put64(rank, b * 8, ra);
            }
            b = b + 1;
        }
        a = a + 1;
    }
    let lut:[]u8 = nio_alloc(24);
    k = 0;
    while (k < 3) {
        h_put64(lut, h_get64(rank, k * 8) * 8, k);
        k = k + 1;
    }
    p = 0;
    while (p < N) {
        lab[p] = (h_get64(lut, (lab[p] as i64) * 8) as u8);
        p = p + 1;
    }
    nio_free(acc);
    nio_free(cnt);
    nio_free(rank);
    nio_free(lut);
    return nparts;
}

// propose the mechanism's own method set from the field records.
// mtab = 16 x 14 i64 (stride 112). toc = 1-i64 trace cursor.
// returns nmethods. traces every decision.
fn nb_propose(frec:[]u8, mtab:[]u8, tr:[]u8, toc:[]u8) i64 {
    let to:i64 = h_get64(toc, 0);
    // valley-depth bar = median of the four fields' depths (derived, not handed)
    let d:[]u8 = nio_alloc(32);
    let f:i64 = 0;
    while (f < 4) {
        h_put64(d, f * 8, h_get64(frec, f * 96 + 32));
        f = f + 1;
    }
    // sort 4 (sorting network)
    let i:i64 = 0;
    while (i < 4) {
        let j:i64 = i + 1;
        while (j < 4) {
            if (h_get64(d, i * 8) > h_get64(d, j * 8)) {
                let t:i64 = h_get64(d, i * 8);
                h_put64(d, i * 8, h_get64(d, j * 8));
                h_put64(d, j * 8, t);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let bar:i64 = (h_get64(d, 1 * 8) + h_get64(d, 2 * 8)) / 2;
    nio_free(d);
    to = tr_str(tr, to, "  valley-depth bar (median of the four fields' own depths) = ");
    to = tr_i64(tr, to, bar);
    to = tr_nl(tr, to);
    let nm:i64 = 0;
    f = 0;
    while (f < 4) {
        let bo:i64 = f * 96;
        let npk:i64 = h_get64(frec, bo + 24);
        let depth:i64 = h_get64(frec, bo + 32);
        let vlevel:i64 = h_get64(frec, bo + 40);
        let med:i64 = h_get64(frec, bo + 64);
        let q1:i64 = h_get64(frec, bo + 72);
        let q3:i64 = h_get64(frec, bo + 80);
        let knee:i64 = h_get64(frec, bo + 88);
        // VALLEY: needs >=2 peaks and depth >= bar (bar > 0: a real gap somewhere)
        let vapplies:i64 = 0;
        if (npk >= 2) {
            if (depth >= bar) {
                if (bar > 0) {
                    if (vlevel >= 0) { vapplies = 1; }
                }
            }
        }
        if (vapplies == 1) {
            let mo:i64 = nm * 112;
            h_put64(mtab, mo, f);
            h_put64(mtab, mo + 8, 0);
            h_put64(mtab, mo + 16, vlevel);
            h_put64(mtab, mo + 24, 0);
            h_put64(mtab, mo + 32, 2);
            to = tr_str(tr, to, "  propose M");
            to = tr_i64(tr, to, nm);
            to = tr_str(tr, to, " = ");
            to = nb_tr_method(tr, to, f, 0, vlevel, 0);
            to = tr_str(tr, to, " (two peaks, valley depth ");
            to = tr_i64(tr, to, depth);
            to = tr_str(tr, to, " >= bar: a natural gap exists)");
            to = tr_nl(tr, to);
            nm = nm + 1;
        } else {
            to = tr_str(tr, to, "  skip ");
            to = nb_fname(tr, to, f);
            to = tr_str(tr, to, "/VALLEY: ");
            if (npk < 2) {
                to = tr_str(tr, to, "only ");
                to = tr_i64(tr, to, npk);
                to = tr_str(tr, to, " peak(s); no natural gap to cut at");
            } else {
                if (bar <= 0) {
                    to = tr_str(tr, to, "no field shows a real valley (bar=0); nothing to cut between");
                } else {
                    to = tr_str(tr, to, "valley depth ");
                    to = tr_i64(tr, to, depth);
                    to = tr_str(tr, to, " < bar ");
                    to = tr_i64(tr, to, bar);
                    to = tr_str(tr, to, "; the dip is noise, not a division");
                }
            }
            to = tr_nl(tr, to);
        }
        // MEDIAN / KNEE / BAND always applicable: levels from the field itself
        let mo:i64 = nm * 112;
        h_put64(mtab, mo, f);
        h_put64(mtab, mo + 8, 1);
        h_put64(mtab, mo + 16, med);
        h_put64(mtab, mo + 24, 0);
        h_put64(mtab, mo + 32, 2);
        to = tr_str(tr, to, "  propose M");
        to = tr_i64(tr, to, nm);
        to = tr_str(tr, to, " = ");
        to = nb_tr_method(tr, to, f, 1, med, 0);
        to = tr_str(tr, to, " (median of its own distribution)");
        to = tr_nl(tr, to);
        nm = nm + 1;
        mo = nm * 112;
        h_put64(mtab, mo, f);
        h_put64(mtab, mo + 8, 2);
        h_put64(mtab, mo + 16, knee);
        h_put64(mtab, mo + 24, 0);
        h_put64(mtab, mo + 32, 2);
        to = tr_str(tr, to, "  propose M");
        to = tr_i64(tr, to, nm);
        to = tr_str(tr, to, " = ");
        to = nb_tr_method(tr, to, f, 2, knee, 0);
        to = tr_str(tr, to, " (bend of its own cumulative curve)");
        to = tr_nl(tr, to);
        nm = nm + 1;
        mo = nm * 112;
        h_put64(mtab, mo, f);
        h_put64(mtab, mo + 8, 3);
        h_put64(mtab, mo + 16, q1);
        h_put64(mtab, mo + 24, q3);
        h_put64(mtab, mo + 32, 3);
        to = tr_str(tr, to, "  propose M");
        to = tr_i64(tr, to, nm);
        to = tr_str(tr, to, " = ");
        to = nb_tr_method(tr, to, f, 3, q1, q3);
        to = tr_str(tr, to, " (three parts at its own quartiles)");
        to = tr_nl(tr, to);
        nm = nm + 1;
        f = f + 1;
    }
    to = tr_str(tr, to, "  invented method count = ");
    to = tr_i64(tr, to, nm);
    to = tr_nl(tr, to);
    h_put64(toc, 0, to);
    return nm;
}

// ================= NO-BRIDGES COMPOSER: nb3 — judgment =================
// The mechanism judges its own invented methods. Properties (all measured):
//   P persistence:        same method, same levels, frames 11/12/13 — do the
//                         parts stay the same things? (mean label agreement x1e4)
//   B boundary evidence:  do the part borders sit on real picture edges?
//                         (mean |grad| on borders / mean |grad| overall x1e4)
//   H homogeneity:        is each part made of similar stuff?
//                         (1 - within-part spread / total spread, x1e4)
//   F fragmentation:      are parts whole pieces or speckle?
//                         (1 - components/64 capped, x1e4; tiebreak use)
// The mechanism states its own principle (in the trace): veto flicker first —
// a part that does not persist across frames is not a thing — then debate four
// scoring formulas and pick the one whose winner separates most decisively
// (largest margin) without being below-average on any property.

fn nb_agree(a:[]u8, b:[]u8, N:i64) i64 {
    let c:i64 = 0;
    let p:i64 = 0;
    while (p < N) {
        if (a[p] == b[p]) { c = c + 1; }
        p = p + 1;
    }
    return c * 10000 / N;
}

fn nb_sort_tmp(t:[]u8, n:i64) void {
    let i:i64 = 0;
    while (i < n) {
        let j:i64 = i + 1;
        while (j < n) {
            if (h_get64(t, i * 8) > h_get64(t, j * 8)) {
                let s:i64 = h_get64(t, i * 8);
                h_put64(t, i * 8, h_get64(t, j * 8));
                h_put64(t, j * 8, s);
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn nb_median_of(t:[]u8, n:i64) i64 {
    nb_sort_tmp(t, n);
    if (n % 2 == 1) { return h_get64(t, (n / 2) * 8); }
    return (h_get64(t, (n / 2 - 1) * 8) + h_get64(t, (n / 2) * 8)) / 2;
}

// measure one method; writes P/B/H/F into mtab row. scratch buffers passed in.
fn nb_measure_method(st:[]u8, mo:[]u8, W:i64, H:i64, N:i64, E:[]u8, gray:[]u8, fb:[]u8, fr:[]u8, labA:[]u8, labB:[]u8, labC:[]u8, tex12:[]u8, labbuf:[]u8, mask:[]u8) void {
    let fkind:i64 = h_get64(mo, 0);
    let proc:i64 = h_get64(mo, 8);
    let l1:i64 = h_get64(mo, 16);
    let l2:i64 = h_get64(mo, 24);
    let nparts:i64 = h_get64(mo, 32);
    // frame 12 first: keep its gray for the texture field
    nb_apply(st, 12, fkind, proc, l1, l2, W, H, N, E, gray, fb, fr, labB);
    seg_texture(gray, tex12, W, H);
    nb_apply(st, 11, fkind, proc, l1, l2, W, H, N, E, gray, fb, fr, labA);
    nb_apply(st, 13, fkind, proc, l1, l2, W, H, N, E, gray, fb, fr, labC);
    let P:i64 = (nb_agree(labA, labB, N) + nb_agree(labB, labC, N)) / 2;
    // boundary evidence on the frame-12 map
    let bacc:i64 = 0;
    let bcnt:i64 = 0;
    let tacc:i64 = 0;
    let y:i64 = 0;
    while (y < H) {
        let x:i64 = 0;
        while (x < W) {
            let p:i64 = y * W + x;
            let t:i64 = h_get64(tex12, p * 8);
            tacc = tacc + t;
            let border:i64 = 0;
            if (x < W - 1) {
                if (labB[p] != labB[p + 1]) { border = 1; }
            }
            if (y < H - 1) {
                if (labB[p] != labB[p + W]) { border = 1; }
            }
            if (border == 1) {
                bacc = bacc + t;
                bcnt = bcnt + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let B:i64 = 0;
    if (bcnt > 0) {
        let bm:i64 = bacc / bcnt;
        let om:i64 = tacc / N;
        if (om > 0) { B = bm * 10000 / om; }
    }
    // homogeneity of the defining field on frame 12
    nb_field_frame(st, 12, fkind, E, gray, fb, fr, W, H, N);
    let F:[]u8 = gray;
    if (fkind == 1) { F = fb; }
    if (fkind == 2) { F = E; }
    if (fkind == 3) { F = fb; }
    let acc:[]u8 = nio_alloc(48);
    let cnt:[]u8 = nio_alloc(48);
    let k:i64 = 0;
    while (k < 3) {
        h_put64(acc, k * 8, 0);
        h_put64(cnt, k * 8, 0);
        k = k + 1;
    }
    let p:i64 = 0;
    let gacc:i64 = 0;
    while (p < N) {
        let r:i64 = (labB[p] as i64);
        let v:i64 = nb_fval(fkind, F, p);
        h_put64(acc, r * 8, h_get64(acc, r * 8) + v);
        h_put64(cnt, r * 8, h_get64(cnt, r * 8) + 1);
        gacc = gacc + v;
        p = p + 1;
    }
    let gmean:i64 = gacc / N;
    let wvar:i64 = 0;
    let tvar:i64 = 0;
    p = 0;
    while (p < N) {
        let r:i64 = (labB[p] as i64);
        let v:i64 = nb_fval(fkind, F, p);
        let c:i64 = h_get64(cnt, r * 8);
        if (c > 0) {
            let m:i64 = h_get64(acc, r * 8) / c;
            let d:i64 = v - m;
            wvar = wvar + d * d;
        }
        let dg:i64 = v - gmean;
        tvar = tvar + dg * dg;
        p = p + 1;
    }
    nio_free(acc);
    nio_free(cnt);
    wvar = wvar / N;
    tvar = tvar / N;
    let Hh:i64 = 10000;
    let isw:i64 = isqrt(wvar);
    let ist:i64 = isqrt(tvar);
    if (ist > 0) {
        Hh = 10000 - isw * 10000 / ist;
        if (Hh < 0) { Hh = 0; }
    }
    // fragmentation: connected components per label on the frame-12 map
    let comps:i64 = 0;
    k = 0;
    while (k < nparts) {
        p = 0;
        while (p < N) {
            if ((labB[p] as i64) == k) { mask[p] = 1; } else { mask[p] = 0; }
            p = p + 1;
        }
        comps = comps + seg_label(mask, labbuf, W, H);
        k = k + 1;
    }
    let capped:i64 = comps;
    if (capped > 64) { capped = 64; }
    let Ff:i64 = 10000 - capped * 10000 / 64;
    h_put64(mo, 40, P);
    h_put64(mo, 48, B);
    h_put64(mo, 56, Hh);
    h_put64(mo, 64, Ff);
}

fn nb_formula_name(tr:[]u8, o:i64, fi:i64) i64 {
    if (fi == 0) { return tr_str(tr, o, "F1 persist-only [P]"); }
    if (fi == 1) { return tr_str(tr, o, "F2 persist-led [(2P+B+H)/4]"); }
    if (fi == 2) { return tr_str(tr, o, "F3 boundary-led [(2B+P+H)/4]"); }
    return tr_str(tr, o, "F4 balanced [(P+B+H)/3]");
}

fn nb_formula_score(fi:i64, P:i64, B:i64, Hh:i64) i64 {
    if (fi == 0) { return P; }
    if (fi == 1) { return (2 * P + B + Hh) / 4; }
    if (fi == 2) { return (2 * B + P + Hh) / 4; }
    return (P + B + Hh) / 3;
}

// full judgment: measure, veto, debate, select. toc = trace cursor.
// returns winning method index. traces every step.
fn nb_judge(st:[]u8, nm:i64, mtab:[]u8, W:i64, H:i64, N:i64, E:[]u8, tr:[]u8, toc:[]u8, gray:[]u8, fb:[]u8, fr:[]u8, labA:[]u8, labB:[]u8, labC:[]u8, tex12:[]u8, labbuf:[]u8, mask:[]u8) i64 {
    let to:i64 = h_get64(toc, 0);
    to = tr_str(tr, to, " JUDGE: measuring each invented method on frames 11/12/13\n");
    let mi:i64 = 0;
    while (mi < nm) {
        let mo:[]u8 = mtab[mi * 112..mi * 112 + 112];
        nb_measure_method(st, mo, W, H, N, E, gray, fb, fr, labA, labB, labC, tex12, labbuf, mask);
        to = tr_str(tr, to, "  M");
        to = tr_i64(tr, to, mi);
        to = tr_str(tr, to, " ");
        to = nb_tr_method(tr, to, h_get64(mo, 0), h_get64(mo, 8), h_get64(mo, 16), h_get64(mo, 24));
        to = tr_str(tr, to, ": P=");
        to = tr_i64(tr, to, h_get64(mo, 40));
        to = tr_str(tr, to, " B=");
        to = tr_i64(tr, to, h_get64(mo, 48));
        to = tr_str(tr, to, " H=");
        to = tr_i64(tr, to, h_get64(mo, 56));
        to = tr_str(tr, to, " F=");
        to = tr_i64(tr, to, h_get64(mo, 64));
        to = tr_nl(tr, to);
        mi = mi + 1;
    }
    // veto: P below the candidate-set median
    let tmp:[]u8 = nio_alloc(128);
    mi = 0;
    while (mi < nm) {
        h_put64(tmp, mi * 8, h_get64(mtab, mi * 112 + 40));
        mi = mi + 1;
    }
    let medP:i64 = nb_median_of(tmp, nm);
    mi = 0;
    while (mi < nm) {
        h_put64(tmp, mi * 8, h_get64(mtab, mi * 112 + 48));
        mi = mi + 1;
    }
    let medB:i64 = nb_median_of(tmp, nm);
    mi = 0;
    while (mi < nm) {
        h_put64(tmp, mi * 8, h_get64(mtab, mi * 112 + 56));
        mi = mi + 1;
    }
    let medH:i64 = nb_median_of(tmp, nm);
    nio_free(tmp);
    to = tr_str(tr, to, " veto (my principle: a part that does not persist across frames is not a thing;\n");
    to = tr_str(tr, to, "        median persistence over my own candidates = ");
    to = tr_i64(tr, to, medP);
    to = tr_str(tr, to, "):\n");
    mi = 0;
    while (mi < nm) {
        let mo:i64 = mi * 112;
        let P:i64 = h_get64(mtab, mo + 40);
        if (P < medP) {
            h_put64(mtab, mo + 72, 1);
            to = tr_str(tr, to, "  M");
            to = tr_i64(tr, to, mi);
            to = tr_str(tr, to, " VETOED (P=");
            to = tr_i64(tr, to, P);
            to = tr_str(tr, to, " < ");
            to = tr_i64(tr, to, medP);
            to = tr_str(tr, to, "): flickers, not a thing");
            to = tr_nl(tr, to);
        } else {
            h_put64(mtab, mo + 72, 0);
        }
        mi = mi + 1;
    }
    // debate: four scoring formulas over the survivors
    to = tr_str(tr, to, " debate: which weighing is right? I try four and let the data decide.\n");
    to = tr_str(tr, to, " (property medians: P=");
    to = tr_i64(tr, to, medP);
    to = tr_str(tr, to, " B=");
    to = tr_i64(tr, to, medB);
    to = tr_str(tr, to, " H=");
    to = tr_i64(tr, to, medH);
    to = tr_str(tr, to, ")\n");
    let fwin:[]u8 = nio_alloc(32);
    let fmar:[]u8 = nio_alloc(32);
    let fok:[]u8 = nio_alloc(32);
    let fi:i64 = 0;
    while (fi < 4) {
        mi = 0;
        while (mi < nm) {
            let mo:i64 = mi * 112;
            let s:i64 = -1;
            if (h_get64(mtab, mo + 72) == 0) {
                s = nb_formula_score(fi, h_get64(mtab, mo + 40), h_get64(mtab, mo + 48), h_get64(mtab, mo + 56));
            }
            h_put64(mtab, mo + 80 + fi * 8, s);
            mi = mi + 1;
        }
        let w:i64 = -1;
        let wsc:i64 = -1;
        let rsc:i64 = -1;
        mi = 0;
        while (mi < nm) {
            let s:i64 = h_get64(mtab, mi * 112 + 80 + fi * 8);
            if (s > wsc) {
                rsc = wsc;
                wsc = s;
                w = mi;
            } else {
                if (s > rsc) { rsc = s; }
            }
            mi = mi + 1;
        }
        let margin:i64 = 0;
        if (wsc >= 0) {
            if (rsc >= 0) { margin = wsc - rsc; } else { margin = wsc; }
        }
        h_put64(fwin, fi * 8, w);
        h_put64(fmar, fi * 8, margin);
        let ok:i64 = 0;
        if (w >= 0) {
            let mo:i64 = w * 112;
            if (h_get64(mtab, mo + 40) >= medP) {
                if (h_get64(mtab, mo + 48) >= medB) {
                    if (h_get64(mtab, mo + 56) >= medH) { ok = 1; }
                }
            }
        }
        h_put64(fok, fi * 8, ok);
        to = tr_str(tr, to, "  ");
        to = nb_formula_name(tr, to, fi);
        to = tr_str(tr, to, ": winner=M");
        to = tr_i64(tr, to, w);
        to = tr_str(tr, to, " margin=");
        to = tr_i64(tr, to, margin);
        to = tr_str(tr, to, " all-properties-above-median=");
        if (ok == 1) { to = tr_str(tr, to, "yes"); } else { to = tr_str(tr, to, "NO"); }
        to = tr_nl(tr, to);
        fi = fi + 1;
    }
    // select: all-clear formula with largest margin; else largest margin + shortfall
    let selfi:i64 = -1;
    let selmar:i64 = -1;
    fi = 0;
    while (fi < 4) {
        if (h_get64(fok, fi * 8) == 1) {
            if (h_get64(fmar, fi * 8) > selmar) {
                selmar = h_get64(fmar, fi * 8);
                selfi = fi;
            }
        }
        fi = fi + 1;
    }
    let shortfall:i64 = 0;
    if (selfi < 0) {
        fi = 0;
        while (fi < 4) {
            if (h_get64(fmar, fi * 8) > selmar) {
                selmar = h_get64(fmar, fi * 8);
                selfi = fi;
            }
            fi = fi + 1;
        }
        shortfall = 1;
    }
    nio_free(fwin);
    nio_free(fmar);
    nio_free(fok);
    // winner under the selected formula (recomputed; tiebreak: lowest method index)
    let winner:i64 = -1;
    let wsc2:i64 = -1;
    mi = 0;
    while (mi < nm) {
        let s:i64 = h_get64(mtab, mi * 112 + 80 + selfi * 8);
        if (s > wsc2) {
            wsc2 = s;
            winner = mi;
        }
        mi = mi + 1;
    }
    to = tr_str(tr, to, " decision: ");
    to = nb_formula_name(tr, to, selfi);
    to = tr_str(tr, to, " wins the debate (largest decisive margin");
    if (shortfall == 1) {
        to = tr_str(tr, to, "; SHORTFALL RECORDED: no scoring crowns an above-median-everywhere winner");
    } else {
        to = tr_str(tr, to, ", winner above median on every property");
    }
    to = tr_str(tr, to, ").\n");
    to = tr_str(tr, to, " WINNER = M");
    to = tr_i64(tr, to, winner);
    to = tr_str(tr, to, " ");
    let wmo:i64 = winner * 112;
    to = nb_tr_method(tr, to, h_get64(mtab, wmo), h_get64(mtab, wmo + 8), h_get64(mtab, wmo + 16), h_get64(mtab, wmo + 24));
    to = tr_nl(tr, to);
    h_put64(toc, 0, to);
    return winner;
}

// composer.zag — TNN composer organ: deliberate video composition (imagination machinery).
// Pure Zag. Zero RNG anywhere in any path. Deterministic: reruns byte-identical.
//
// What this IS (honest design note):
//   The missing organ from the STEP-2 clean negative (commit 1a8d040cd7e):
//   {propose, evaluate, select, synthesize} over the deliberate-memory
//   substrate {mem_add, mem_recall}. Given two labeled video memories and a
//   text instruction, the mechanism:
//     PERCEIVE: measures motion+texture saliency per memory (thirds-grid
//       density; focus = argmax-density cell). It knows measured
//       subjectness, NOT objects/heads/faces.
//     PARSE: verb -> {MERGE,SIDE,THEN} via a fixed word list; nouns matched
//       against the stores' own labels. Unknown verb/noun -> clean refusal.
//     PROPOSE: enumerates 18 fixed candidate plans (OVERLAY REPLACE/ADJOIN x
//       both directions, PIP x4 corners x both directions, SPLIT_V/H x both
//       orders, INTERLEAVE, XFADE). All rect/position parameters derive from
//       the measured focus cells. No per-pair special cases anywhere.
//     EVALUATE: fixed rubric, exact integer fixed-point arithmetic:
//       35*verb_fit + 30*presence + 20*balance + 10*recognizability
//       + 5*parsimony. The weights and verb->family map are programmer-
//       authored deliberative standards; every score is computed from the
//       actual content measurements.
//     SELECT: argmax total, tiebreak lowest plan index. Full score table +
//       templated reasons written to the deliberation trace (first-class).
//     SYNTHESIZE: generic pixel primitives (rect_copy, scale_nn, splits,
//       interleave, xfade) execute the WINNING plan on deliberately recalled
//       frames -> 24 output PPMs.
//   The plan LANGUAGE, pixel OPERATORS, rubric WEIGHTS and saliency
//   DEFINITION are programmer-provided generic machinery. The CHOICE among
//   plans (which plan, which rects, which direction, which corner) is the
//   mechanism's own: argmax over measurement-derived scores.
//
// Subcommands (build from this file's directory as cwd):
//   composer selftest
//   composer ingest <label> <srcdir> <workdir>        (video: 24x 320x240 PPM)
//   composer recall <workdir> <outdir>                (video recall)
//   composer stillingest <label> <ppmfile> <workdir>  (still: any W/H<=640x480)
//   composer stillrecall <workdir> <outppm>
//   composer compose <workA> <workB> <instruction.txt> <outdir>
//   composer render <workA> <workB> <planidx> <outdir> (comparison renders only;
//            NOT the mechanism's choice -- labeled as such in the gallery)
@import("../../tnn-lab/toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- u64/i64 LE helpers ( []u8 arenas only ) ----------------
fn h_put64(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    b[o + 4] = ((v >> 32) & 255) as u8;
    b[o + 5] = ((v >> 40) & 255) as u8;
    b[o + 6] = ((v >> 48) & 255) as u8;
    b[o + 7] = ((v >> 56) & 255) as u8;
}
fn h_get64(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    v = v + (b[o + 4] as i64) * 4294967296 + (b[o + 5] as i64) * 1099511627776;
    v = v + (b[o + 6] as i64) * 281474976710656 + (b[o + 7] as i64) * 72057594037927936;
    return v;
}
// ---------------- FNV-1a 64 ----------------
fn fnv(b:[]u8, o:i64, n:i64) i64 {
    let h:i64 = -3750763034362895579;
    let i:i64 = 0;
    while (i < n) {
        h = h ^ (b[o + i] as i64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}
fn put_hex(b:[]u8, o:i64, v:i64) void {
    let sh:i64 = 60;
    let k:i64 = 0;
    while (k < 16) {
        let nb:i64 = (v >> sh) & 15;
        if (nb < 10) { b[o + k] = (48 + nb) as u8; } else { b[o + k] = (87 + nb) as u8; }
        sh = sh - 4;
        k = k + 1;
    }
}
// ---------------- small string utils ----------------
fn is_alpha(c:u8) i64 {
    let v:i64 = c as i64;
    if (v >= 97) { if (v <= 122) { return 1; } }
    if (v >= 65) { if (v <= 90) { return 1; } }
    return 0;
}
fn to_lower(c:u8) u8 {
    let v:i64 = c as i64;
    if (v >= 65) { if (v <= 90) { return (v + 32) as u8; } }
    return c;
}
// word equality: word slice vs literal bytes
fn word_eq(w:[]u8, lit:[]u8) i64 {
    if (w.len != lit.len) { return 0; }
    let i:i64 = 0;
    while (i < w.len) {
        if (to_lower(w[i]) != lit[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
// ---------------- trace builder ----------------
fn tr_str(tr:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { tr[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn tr_i64(tr:[]u8, o:i64, v:i64) i64 {
    if (v < 0) { tr[o] = 45; o = o + 1; v = 0 - v; }
    if (v == 0) { tr[o] = 48; return o + 1; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    let i:i64 = 0;
    while (i < n) { tr[o + i] = tmp[n - 1 - i]; i = i + 1; }
    nio_free(tmp);
    return o + n;
}
fn tr_hex(tr:[]u8, o:i64, v:i64) i64 {
    put_hex(tr, o, v);
    return o + 16;
}
fn tr_nl(tr:[]u8, o:i64) i64 {
    tr[o] = 10;
    return o + 1;
}
// fixed-point 0..10000 printed as xx.xx
fn tr_fp2(tr:[]u8, o:i64, v:i64) i64 {
    o = tr_i64(tr, o, v / 100);
    tr[o] = 46; o = o + 1;
    let r:i64 = v % 100;
    tr[o] = (48 + r / 10) as u8; tr[o + 1] = (48 + r % 10) as u8;
    return o + 2;
}

// ---------------- file utils ----------------
fn write_buf(root:i64, name:[]u8, b:[]u8, n:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 1);
    if (fd < 0) { return -1; }
    let done:i64 = 0;
    while (done < n) {
        let c:i64 = n - done;
        if (c > 1048576) { c = 1048576; }
        let part:[]u8 = b[done..done + c];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != c) { nio_close(fd); return -2; }
        done = done + c;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}
fn read_file(root:i64, name:[]u8, b:[]u8, maxn:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let n:i64 = nio_read_exact(fd, b, maxn as i32);
    nio_close(fd);
    return n;
}
// mkdir -p for one level; EEXIST(-17) is fine.
fn ensure_dir(path:[]u8) i64 {
    let rc:i64 = nio_mkdir(path);
    if (rc == 0 || rc == -17) { return 0; }
    return rc;
}
// ---------------- PPM ----------------
// general PPM P6 reader: any W/H with W*H*3 <= maxpx*3. Returns 0 ok.
// out dims via w_out[0], h_out[0] (single-slot []u8 arenas used as out-params).
fn read_ppm_gen(root:i64, name:[]u8, px:[]u8, maxpx:i64, w_out:[]u8, h_out:[]u8) i64 {
    let buf:[]u8 = nio_alloc(1048576);
    if (buf.len == 0) { return -20; }
    let n:i64 = read_file(root, name, buf, 1048576);
    if (n < 0) { nio_free(buf); return -21; }
    if (n < 15) { nio_free(buf); return -22; }
    if (buf[0] != 80 || buf[1] != 54) { nio_free(buf); return -23; }
    let p:i64 = 2;
    // skip whitespace, parse W
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32 || c == 10 || c == 13 || c == 9) { p = p + 1; } else { break; } }
    let w:i64 = 0;
    let nd:i64 = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { w = w * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -24; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32 || c == 10 || c == 13 || c == 9) { p = p + 1; } else { break; } }
    let h:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { h = h * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -25; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32 || c == 10 || c == 13 || c == 9) { p = p + 1; } else { break; } }
    let mv:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { mv = mv * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { nio_free(buf); return -26; }
    // exactly one whitespace byte before raster
    if (p >= n) { nio_free(buf); return -27; }
    let c:i64 = buf[p] as i64;
    if (c != 32) { if (c != 10) { if (c != 13) { if (c != 9) { nio_free(buf); return -28; } } } }
    p = p + 1;
    if (mv != 255) { nio_free(buf); return -29; }
    if (w <= 0 || h <= 0) { nio_free(buf); return -30; }
    let need:i64 = w * h * 3;
    if (need > maxpx * 3) { nio_free(buf); return -31; }
    if (n != p + need) { nio_free(buf); return -32; }
    let i:i64 = 0;
    while (i < need) { px[i] = buf[p + i]; i = i + 1; }
    h_put64(w_out, 0, w);
    h_put64(h_out, 0, h);
    nio_free(buf);
    return 0;
}
// write PPM P6 with given W/H. wb must hold 15+... header built for any W/H.
fn ppm_header_gen(b:[]u8, o:i64, w:i64, h:i64) i64 {
    // "P6\n<w> <h>\n255\n"
    b[o] = 80; b[o + 1] = 54; b[o + 2] = 10;
    let p:i64 = o + 3;
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    let v:i64 = w;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    let i:i64 = 0;
    while (i < n) { b[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    b[p] = 32; p = p + 1;
    n = 0; v = h;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    i = 0;
    while (i < n) { b[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    b[p] = 10; b[p + 1] = 50; b[p + 2] = 53; b[p + 3] = 53; b[p + 4] = 10;
    p = p + 5;
    nio_free(tmp);
    return p - o;
}
fn write_ppm(root:i64, name:[]u8, px:[]u8, w:i64, h:i64) i64 {
    let need:i64 = w * h * 3;
    let wb:[]u8 = nio_alloc((need + 32) as i32);
    if (wb.len == 0) { return -40; }
    let hl:i64 = ppm_header_gen(wb, 0, w, h);
    let i:i64 = 0;
    while (i < need) { wb[hl + i] = px[i]; i = i + 1; }
    let rc:i64 = write_buf(root, name, wb, hl + need);
    nio_free(wb);
    return rc;
}
// ---------------- frame filenames ----------------
fn mk_frame_name(out:[]u8, f:i64) i64 {
    // "frame_%02d.ppm" 12 bytes
    out[0] = 102; out[1] = 114; out[2] = 97; out[3] = 109; out[4] = 101; out[5] = 95;
    out[6] = (48 + (f / 10)) as u8;
    out[7] = (48 + (f % 10)) as u8;
    out[8] = 46; out[9] = 112; out[10] = 112; out[11] = 109;
    return 12;
}
fn mk_store_name(out:[]u8) i64 {
    // "store.bin" 9 bytes
    out[0] = 115; out[1] = 116; out[2] = 111; out[3] = 114; out[4] = 101;
    out[5] = 46; out[6] = 98; out[7] = 105; out[8] = 110;
    return 9;
}
fn mk_trace_name(out:[]u8, kind:[]u8) i64 {
    // "trace_<kind>.txt"
    let p:i64 = tr_str(out, 0, "trace_");
    p = tr_str(out, p, kind);
    p = tr_str(out, p, ".txt");
    return p;
}

// ---------------- deliberate memory substrate v2 ----------------
// arena header (128 bytes):
//   [0..8) nslots u64, [8..16) rows u64, [16..24) plen u64, [24..32) episode
//   [32..40) width u64, [40..48) height u64, [48..56) nframes u64
//   [56..64) labellen u64, [64..128) label bytes (64 max)
// slot headers at 128 + slot*32: frame, row, episode, payload_off; payloads after.
fn mem_add(st:[]u8, f:i64, r:i64, ep:i64, payload:[]u8, po:i64, plen:i64) i64 {
    let rows:i64 = h_get64(st, 8);
    let ns:i64 = h_get64(st, 0);
    let slot:i64 = f * rows + r;
    let ho:i64 = 128 + slot * 32;
    h_put64(st, ho, f);
    h_put64(st, ho + 8, r);
    h_put64(st, ho + 16, ep);
    let q:i64 = 128 + ns * 32 + slot * plen;
    h_put64(st, ho + 24, q);
    let i:i64 = 0;
    while (i < plen) { st[q + i] = payload[po + i]; i = i + 1; }
    return slot;
}
// deliberate recall: content-addressed scan on the (frame,row) provenance key
fn mem_recall(st:[]u8, f:i64, r:i64, out:[]u8, oo:i64) i64 {
    let ns:i64 = h_get64(st, 0);
    let plen:i64 = h_get64(st, 16);
    let s:i64 = 0;
    while (s < ns) {
        let ho:i64 = 128 + s * 32;
        let sf:i64 = h_get64(st, ho);
        let sr:i64 = h_get64(st, ho + 8);
        if (sf == f) {
            if (sr == r) {
                let q:i64 = h_get64(st, ho + 24);
                let i:i64 = 0;
                while (i < plen) { out[oo + i] = st[q + i]; i = i + 1; }
                return 1;
            }
        }
        s = s + 1;
    }
    return 0;
}
fn store_alloc(nframes:i64, w:i64, h:i64, label:[]u8) []u8 {
    let rows:i64 = h;
    let plen:i64 = w * 3;
    let ns:i64 = nframes * rows;
    let stsz:i64 = 128 + ns * 32 + ns * plen;
    let st:[]u8 = nio_alloc(stsz as i32);
    if (st.len == 0) { return st; }
    h_put64(st, 0, ns);
    h_put64(st, 8, rows);
    h_put64(st, 16, plen);
    h_put64(st, 24, 1);
    h_put64(st, 32, w);
    h_put64(st, 40, h);
    h_put64(st, 48, nframes);
    let ll:i64 = label.len;
    if (ll > 64) { ll = 64; }
    h_put64(st, 56, ll);
    let i:i64 = 0;
    while (i < ll) { st[64 + i] = label[i]; i = i + 1; }
    return st;
}
// ---------------- ingest: video (24x 320x240 frame_%02d.ppm) ----------------
fn do_ingest(label:[]u8, src:[]u8, work:[]u8) i64 {
    let w:i64 = 320;
    let h:i64 = 240;
    let nf:i64 = 24;
    let st:[]u8 = store_alloc(nf, w, h, label);
    if (st.len == 0) { return -50; }
    let sroot:i64 = nio_open_root(src);
    if (sroot < 0) { nio_free(st); return -51; }
    ensure_dir(work);
    let wroot:i64 = nio_open_root(work);
    if (wroot < 0) { nio_close(sroot); nio_free(st); return -52; }
    let px:[]u8 = nio_alloc(230400);
    let nm:[]u8 = nio_alloc(16);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    let tr:[]u8 = nio_alloc(4096);
    let to:i64 = 0;
    to = tr_str(tr, to, "INGEST label=");
    to = tr_str(tr, to, label);
    to = tr_str(tr, to, " frames=24 320x240");
    to = tr_nl(tr, to);
    let f:i64 = 0;
    while (f < nf) {
        let nl:i64 = mk_frame_name(nm, f);
        let rc:i64 = read_ppm_gen(sroot, nm[0..nl], px, 230400, wo, ho);
        if (rc != 0) { nio_close(sroot); nio_close(wroot); return -60 - f; }
        if (h_get64(wo, 0) != 320 || h_get64(ho, 0) != 240) { nio_close(sroot); nio_close(wroot); return -70 - f; }
        let hi:i64 = fnv(px, 0, 230400);
        let r:i64 = 0;
        while (r < 240) {
            mem_add(st, f, r, 1, px, r * 960, 960);
            r = r + 1;
        }
        to = tr_str(tr, to, "INGEST f=");
        to = tr_i64(tr, to, f);
        to = tr_str(tr, to, " H_I=");
        to = tr_hex(tr, to, hi);
        to = tr_nl(tr, to);
        f = f + 1;
    }
    let snm:[]u8 = nio_alloc(16);
    let sl:i64 = mk_store_name(snm);
    let stsz:i64 = 128 + (nf * h) * 32 + (nf * h) * (w * 3);
    let wrc:i64 = write_buf(wroot, snm[0..sl], st, stsz);
    if (wrc != 0) { nio_close(sroot); nio_close(wroot); return -80; }
    let tnm:[]u8 = nio_alloc(32);
    let tl:i64 = mk_trace_name(tnm, "ingest");
    let trc:i64 = write_buf(wroot, tnm[0..tl], tr, to);
    nio_close(sroot);
    nio_close(wroot);
    nio_free(st); nio_free(px); nio_free(nm); nio_free(wo); nio_free(ho);
    nio_free(tr); nio_free(snm); nio_free(tnm);
    if (trc != 0) { return -81; }
    return 0;
}
// ---------------- ingest: still (single PPM, any W/H <= 640x480) ----------------
fn do_stillingest(label:[]u8, ppm:[]u8, work:[]u8) i64 {
    // ppm = full file path: split dir + name. We open the dir of the file.
    // Simpler: caller passes the DIRECTORY in ppm and we need the filename...
    // Convention: stillingest <label> <dir> <filename> <workdir> is clumsy,
    // so: <ppm> is "dir/name" and we split at the last '/'.
    let n:i64 = ppm.len;
    let cut:i64 = -1;
    let i:i64 = 0;
    while (i < n) { if ((ppm[i] as i64) == 47) { cut = i; } i = i + 1; }
    if (cut < 0) { return -90; }
    let dir:[]u8 = ppm[0..cut];
    let name:[]u8 = ppm[cut + 1..n];
    let maxpx:i64 = 640 * 480;
    let px:[]u8 = nio_alloc((maxpx * 3) as i32);
    if (px.len == 0) { return -91; }
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    let droot:i64 = nio_open_root(dir);
    if (droot < 0) { nio_free(px); return -92; }
    let rc:i64 = read_ppm_gen(droot, name, px, maxpx, wo, ho);
    nio_close(droot);
    if (rc != 0) { nio_free(px); return -93; }
    let w:i64 = h_get64(wo, 0);
    let h:i64 = h_get64(ho, 0);
    let st:[]u8 = store_alloc(1, w, h, label);
    if (st.len == 0) { nio_free(px); return -94; }
    let hi:i64 = fnv(px, 0, w * h * 3);
    let r:i64 = 0;
    while (r < h) {
        mem_add(st, 0, r, 1, px, r * w * 3, w * 3);
        r = r + 1;
    }
    ensure_dir(work);
    let wroot:i64 = nio_open_root(work);
    if (wroot < 0) { nio_free(st); nio_free(px); return -95; }
    let snm:[]u8 = nio_alloc(16);
    let sl:i64 = mk_store_name(snm);
    let ns:i64 = h;
    let stsz:i64 = 128 + ns * 32 + ns * (w * 3);
    let wrc:i64 = write_buf(wroot, snm[0..sl], st, stsz);
    let tr:[]u8 = nio_alloc(1024);
    let to:i64 = 0;
    to = tr_str(tr, to, "STILL_INGEST label=");
    to = tr_str(tr, to, label);
    to = tr_str(tr, to, " dims=");
    to = tr_i64(tr, to, w);
    to = tr_str(tr, to, "x");
    to = tr_i64(tr, to, h);
    to = tr_str(tr, to, " H_I=");
    to = tr_hex(tr, to, hi);
    to = tr_nl(tr, to);
    let tnm:[]u8 = nio_alloc(32);
    let tl:i64 = mk_trace_name(tnm, "stillingest");
    let trc:i64 = write_buf(wroot, tnm[0..tl], tr, to);
    nio_close(wroot);
    nio_free(st); nio_free(px); nio_free(wo); nio_free(ho);
    nio_free(snm); nio_free(tr); nio_free(tnm);
    if (wrc != 0) { return -96; }
    if (trc != 0) { return -97; }
    return 0;
}
// ---------------- load a store file into the arena ----------------
fn load_store_full(work:[]u8) []u8 {
    // single pass: nio_read_exact requires file size <= max_bytes, so we read
    // with a 24MB ceiling (video stores are ~5.8MB for 24x 320x240 frames).
    let wroot:i64 = nio_open_root(work);
    if (wroot < 0) { let e:[]u8 = nio_alloc(8); return e[0..0]; }
    let snm:[]u8 = nio_alloc(16);
    let sl:i64 = mk_store_name(snm);
    let sfd:i64 = nio_open_child(wroot, snm[0..sl], 0);
    nio_free(snm);
    if (sfd < 0) { nio_close(wroot); let e2:[]u8 = nio_alloc(8); return e2[0..0]; }
    let st:[]u8 = nio_alloc(25165824);
    if (st.len == 0) { nio_close(sfd); nio_close(wroot); let e3:[]u8 = nio_alloc(8); return e3[0..0]; }
    let n:i64 = nio_read_exact(sfd, st, 25165824);
    nio_close(sfd);
    nio_close(wroot);
    if (n < 128) { nio_free(st); let e4:[]u8 = nio_alloc(8); return e4[0..0]; }
    return st[0..n];
}
fn store_label(st:[]u8, out:[]u8) i64 {
    let ll:i64 = h_get64(st, 56);
    let i:i64 = 0;
    while (i < ll) { out[i] = st[64 + i]; i = i + 1; }
    return ll;
}
// ---------------- recall: video ----------------
fn do_recall(work:[]u8, outd:[]u8) i64 {
    let st:[]u8 = load_store_full(work);
    if (st.len == 0) { return -110; }
    let w:i64 = h_get64(st, 32);
    let h:i64 = h_get64(st, 40);
    let nf:i64 = h_get64(st, 48);
    let rows:i64 = h_get64(st, 8);
    let wroot:i64 = nio_open_root(work);
    ensure_dir(outd);
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { nio_close(wroot); nio_free(st); return -111; }
    let px:[]u8 = nio_alloc((w * h * 3) as i32);
    let fnm:[]u8 = nio_alloc(16);
    let tr:[]u8 = nio_alloc(4096);
    let to:i64 = 0;
    to = tr_str(tr, to, "RECALL frames=");
    to = tr_i64(tr, to, nf);
    to = tr_nl(tr, to);
    let f:i64 = 0;
    while (f < nf) {
        let r:i64 = 0;
        while (r < rows) {
            if (mem_recall(st, f, r, px, r * w * 3) != 1) { nio_close(wroot); nio_close(oroot); return -120 - f; }
            r = r + 1;
        }
        let hr:i64 = fnv(px, 0, w * h * 3);
        to = tr_str(tr, to, "RECALL f=");
        to = tr_i64(tr, to, f);
        to = tr_str(tr, to, " H_R=");
        to = tr_hex(tr, to, hr);
        to = tr_nl(tr, to);
        let nl:i64 = mk_frame_name(fnm, f);
        let wrc:i64 = write_ppm(oroot, fnm[0..nl], px, w, h);
        if (wrc != 0) { nio_close(wroot); nio_close(oroot); return -130 - f; }
        f = f + 1;
    }
    let tnm:[]u8 = nio_alloc(32);
    let tl:i64 = mk_trace_name(tnm, "recall");
    let trc:i64 = write_buf(wroot, tnm[0..tl], tr, to);
    nio_close(wroot);
    nio_close(oroot);
    nio_free(st); nio_free(px); nio_free(fnm); nio_free(tr); nio_free(tnm);
    if (trc != 0) { return -131; }
    return 0;
}
// ---------------- recall: still ----------------
fn do_stillrecall(work:[]u8, outppm:[]u8) i64 {
    let st:[]u8 = load_store_full(work);
    if (st.len == 0) { return -140; }
    let w:i64 = h_get64(st, 32);
    let h:i64 = h_get64(st, 40);
    let rows:i64 = h_get64(st, 8);
    let px:[]u8 = nio_alloc((w * h * 3) as i32);
    let r:i64 = 0;
    while (r < rows) {
        if (mem_recall(st, 0, r, px, r * w * 3) != 1) { nio_free(st); nio_free(px); return -141; }
        r = r + 1;
    }
    let hr:i64 = fnv(px, 0, w * h * 3);
    // outppm = "dir/name": split at last '/'
    let n:i64 = outppm.len;
    let cut:i64 = -1;
    let i:i64 = 0;
    while (i < n) { if ((outppm[i] as i64) == 47) { cut = i; } i = i + 1; }
    if (cut < 0) { nio_free(st); nio_free(px); return -142; }
    ensure_dir(outppm[0..cut]);
    let oroot:i64 = nio_open_root(outppm[0..cut]);
    if (oroot < 0) { nio_free(st); nio_free(px); return -143; }
    let wrc:i64 = write_ppm(oroot, outppm[cut + 1..n], px, w, h);
    nio_close(oroot);
    _zag_print("stillrecall H_R=");
    _zag_println(_zag_i64_to_str(hr));
    nio_free(st);
    nio_free(px);
    if (wrc != 0) { return -144; }
    return 0;
}

// ---------------- perception ----------------
// perc arena layout (1640 bytes):
//   [0..1536)    sub: 192 u64 saliency masses (16x12 grid of 20x20 cells @320x240)
//   [1536..1544) total u64
//   [1544..1616) dens: 9 i64 fixed-point (x10000) thirds-cell densities
//   [1616..1624) focus i64 (0..8)
//   [1624..1632) w i64, [1632..1640) h i64
fn perc_alloc() []u8 {
    let p:[]u8 = nio_alloc(1640);
    return p;
}
fn gray_of(px:[]u8, o:i64) i64 {
    return ((px[o] as i64) + (px[o + 1] as i64) + (px[o + 2] as i64)) / 3;
}
// mass of sub-cells whose center falls in [x0,x1)x[y0,y1)
fn rect_mass(sub:[]u8, w:i64, h:i64, x0:i64, y0:i64, x1:i64, y1:i64) i64 {
    let m:i64 = 0;
    let sy:i64 = 0;
    while (sy < 12) {
        let ccy:i64 = (2 * sy + 1) * h;
        if (ccy >= y0 * 24) {
            if (ccy < y1 * 24) {
                let sx:i64 = 0;
                while (sx < 16) {
                    let ccx:i64 = (2 * sx + 1) * w;
                    if (ccx >= x0 * 32) {
                        if (ccx < x1 * 32) {
                            m = m + h_get64(sub, (sy * 16 + sx) * 8);
                        }
                    }
                    sx = sx + 1;
                }
            }
        }
        sy = sy + 1;
    }
    return m;
}
// thirds cell c (0..8) pixel rect -> x0,y0,x1,y1 via out-arena (4x8 bytes)
fn cell_rect(c:i64, w:i64, h:i64, out:[]u8) void {
    let cx:i64 = c % 3;
    let cy:i64 = c / 3;
    h_put64(out, 0, cx * w / 3);
    h_put64(out, 8, cy * h / 3);
    h_put64(out, 16, (cx + 1) * w / 3);
    h_put64(out, 24, (cy + 1) * h / 3);
}
// perceive: fill perc from store st. Returns 0 ok, negative error.
fn perceive(st:[]u8, perc:[]u8) i64 {
    let w:i64 = h_get64(st, 32);
    let h:i64 = h_get64(st, 40);
    let nf:i64 = h_get64(st, 48);
    let rows:i64 = h_get64(st, 8);
    h_put64(perc, 1624, w);
    h_put64(perc, 1632, h);
    let pxa:[]u8 = nio_alloc((w * h * 3) as i32);
    let pxb:[]u8 = nio_alloc((w * h * 3) as i32);
    if (pxa.len == 0 || pxb.len == 0) { return -200; }
    // zero sub-cells
    let i:i64 = 0;
    while (i < 192) { h_put64(perc, i * 8, 0); i = i + 1; }
    // motion: consecutive frame pairs, accumulate |dgray| into sub-cells
    let f:i64 = 0;
    while (f < nf - 1) {
        let r:i64 = 0;
        while (r < rows) {
            if (mem_recall(st, f, r, pxa, r * w * 3) != 1) { return -210 - f; }
            if (mem_recall(st, f + 1, r, pxb, r * w * 3) != 1) { return -220 - f; }
            r = r + 1;
        }
        let y:i64 = 0;
        while (y < h) {
            let x:i64 = 0;
            while (x < w) {
                let o:i64 = (y * w + x) * 3;
                let ga:i64 = gray_of(pxa, o);
                let gb:i64 = gray_of(pxb, o);
                let d:i64 = ga - gb;
                if (d < 0) { d = 0 - d; }
                let sx:i64 = x * 16 / w;
                let sy:i64 = y * 12 / h;
                let ci:i64 = sy * 16 + sx;
                h_put64(perc, ci * 8, h_get64(perc, ci * 8) + d);
                x = x + 1;
            }
            y = y + 1;
        }
        f = f + 1;
    }
    // texture: gradient energy on the middle frame
    let fm:i64 = nf / 2;
    let r2:i64 = 0;
    while (r2 < rows) {
        if (mem_recall(st, fm, r2, pxa, r2 * w * 3) != 1) { return -230; }
        r2 = r2 + 1;
    }
    let y2:i64 = 0;
    while (y2 < h - 1) {
        let x2:i64 = 0;
        while (x2 < w - 1) {
            let o:i64 = (y2 * w + x2) * 3;
            let g:i64 = gray_of(pxa, o);
            let gr:i64 = gray_of(pxa, o + 3);
            let gd:i64 = gray_of(pxa, o + w * 3);
            let t:i64 = g - gr;
            if (t < 0) { t = 0 - t; }
            let t2:i64 = g - gd;
            if (t2 < 0) { t2 = 0 - t2; }
            t = t + t2;
            let sx:i64 = x2 * 16 / w;
            let sy:i64 = y2 * 12 / h;
            let ci:i64 = sy * 16 + sx;
            h_put64(perc, ci * 8, h_get64(perc, ci * 8) + t);
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    // total
    let tot:i64 = 0;
    i = 0;
    while (i < 192) { tot = tot + h_get64(perc, i * 8); i = i + 1; }
    if (tot <= 0) { return -240; }
    h_put64(perc, 1536, tot);
    // thirds densities (fixed-point x10000), exact integer math
    let fa:i64 = w * h;
    let rect:[]u8 = nio_alloc(32);
    let c:i64 = 0;
    let best:i64 = 0;
    let bestd:i64 = -1;
    while (c < 9) {
        cell_rect(c, w, h, rect);
        let x0:i64 = h_get64(rect, 0);
        let y0:i64 = h_get64(rect, 8);
        let x1:i64 = h_get64(rect, 16);
        let y1:i64 = h_get64(rect, 24);
        let sc:i64 = rect_mass(perc, w, h, x0, y0, x1, y1);
        let area:i64 = (x1 - x0) * (y1 - y0);
        let dens:i64 = 0;
        if (area > 0) { dens = sc * 10000 * fa / (tot * area); }
        h_put64(perc, 1544 + c * 8, dens);
        if (dens > bestd) { bestd = dens; best = c; }
        c = c + 1;
    }
    h_put64(perc, 1616, best);
    nio_free(pxa); nio_free(pxb); nio_free(rect);
    return 0;
}

// ---------------- instruction parsing ----------------
// words arena: up to 256 words, each 16 bytes (start u64, len u64)
fn tokenize(txt:[]u8, n:i64, words:[]u8) i64 {
    let nw:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        if (is_alpha(txt[i]) == 1) {
            let s:i64 = i;
            while (i < n) {
                if (is_alpha(txt[i]) == 0) { break; }
                i = i + 1;
            }
            if (nw < 256) {
                h_put64(words, nw * 16, s);
                h_put64(words, nw * 16 + 8, i - s);
                nw = nw + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return nw;
}
fn word_slice(txt:[]u8, words:[]u8, k:i64) []u8 {
    let s:i64 = h_get64(words, k * 16);
    let l:i64 = h_get64(words, k * 16 + 8);
    return txt[s..s + l];
}
// verb codes: 0=unknown 1=MERGE 2=SIDE 3=THEN
fn detect_verb(txt:[]u8, words:[]u8, nw:i64) i64 {
    let k:i64 = 0;
    while (k < nw) {
        let w:[]u8 = word_slice(txt, words, k);
        if (word_eq(w, "merge") == 1) { return 1; }
        if (word_eq(w, "combine") == 1) { return 1; }
        if (word_eq(w, "fuse") == 1) { return 1; }
        if (word_eq(w, "mix") == 1) { return 1; }
        if (word_eq(w, "blend") == 1) { return 1; }
        if (word_eq(w, "beside") == 1) { return 2; }
        if (word_eq(w, "compare") == 1) { return 2; }
        if (word_eq(w, "then") == 1) { return 3; }
        if (word_eq(w, "after") == 1) { return 3; }
        if (word_eq(w, "sequence") == 1) { return 3; }
        if (word_eq(w, "followed") == 1) { return 3; }
        if (word_eq(w, "side") == 1) {
            if (k + 2 < nw) {
                let w1:[]u8 = word_slice(txt, words, k + 1);
                let w2:[]u8 = word_slice(txt, words, k + 2);
                if (word_eq(w1, "by") == 1) {
                    if (word_eq(w2, "side") == 1) { return 2; }
                }
            }
        }
        k = k + 1;
    }
    return 0;
}
// match nouns against the two labels (labels pre-lowercased).
// returns count of distinct matched subjects (0..2) in subj_out[0..].
fn match_subjects(txt:[]u8, words:[]u8, nw:i64, lab0:[]u8, lab1:[]u8, subj_out:[]u8) i64 {
    let ns:i64 = 0;
    let k:i64 = 0;
    while (k < nw) {
        let w:[]u8 = word_slice(txt, words, k);
        let hit:i64 = -1;
        if (word_eq(w, lab0) == 1) { hit = 0; }
        if (word_eq(w, lab1) == 1) {
            if (hit == 0) { hit = 2; } else { hit = 1; }
        }
        if (hit == 0 || hit == 1) {
            let dup:i64 = 0;
            let j:i64 = 0;
            while (j < ns) {
                if (h_get64(subj_out, j * 8) == hit) { dup = 1; }
                j = j + 1;
            }
            if (dup == 0) {
                if (ns < 2) { h_put64(subj_out, ns * 8, hit); ns = ns + 1; }
            }
        }
        if (hit == 2) { return -1; }
        k = k + 1;
    }
    return ns;
}
fn verb_name(v:i64, out:[]u8) i64 {
    if (v == 1) { return tr_str(out, 0, "MERGE"); }
    if (v == 2) { return tr_str(out, 0, "SIDE"); }
    if (v == 3) { return tr_str(out, 0, "THEN"); }
    return tr_str(out, 0, "UNKNOWN");
}

// ---------------- plan language ----------------
// families: 0=OVERLAY 1=PIP 2=SPLIT 3=INTERLEAVE 4=XFADE
// plan indices (fixed enumeration, every run):
//   0: OV mem0->mem1 REPLACE   1: OV mem0->mem1 ADJOIN
//   2: OV mem1->mem0 REPLACE   3: OV mem1->mem0 ADJOIN
//   4-7:  PIP mem0->mem1 corners TL TR BL BR
//   8-11: PIP mem1->mem0 corners TL TR BL BR
//   12: SPLIT_V mem0|mem1  13: SPLIT_V mem1|mem0
//   14: SPLIT_H mem0/mem1  15: SPLIT_H mem1/mem0
//   16: INTERLEAVE k=2     17: XFADE n=8
fn plan_family(idx:i64) i64 {
    if (idx < 4) { return 0; }
    if (idx < 12) { return 1; }
    if (idx < 16) { return 2; }
    if (idx < 17) { return 3; }
    return 4;
}
fn plan_donor(idx:i64) i64 {
    let fam:i64 = plan_family(idx);
    if (fam == 0) {
        if (idx < 2) { return 0; }
        return 1;
    }
    if (fam == 1) {
        if (idx < 8) { return 0; }
        return 1;
    }
    return 0;
}
// geom record (96 bytes): [0]family [8]donor [16]recip
//   [24]dx0 [32]dy0 [40]dx1 [48]dy1 (donor rect)
//   [56]gx0 [64]gy0 [72]gx1 [80]gy1 (graft/target rect)
//   [88]aux (placing / corner / split-order)
fn plan_geom(idx:i64, p0:[]u8, p1:[]u8, w:i64, h:i64, g:[]u8) void {
    let fam:i64 = plan_family(idx);
    h_put64(g, 0, fam);
    let donor:i64 = plan_donor(idx);
    let recip:i64 = 1 - donor;
    if (fam == 2 || fam == 3 || fam == 4) { donor = 0; recip = 1; }
    h_put64(g, 8, donor);
    h_put64(g, 16, recip);
    let pd:[]u8 = p0;
    if (donor == 1) { pd = p1; }
    let pr:[]u8 = p1;
    if (recip == 0) { pr = p0; }
    if (fam == 0 || fam == 1) {
        let fd:i64 = h_get64(pd, 1616);
        let fr:i64 = h_get64(pr, 1616);
        let dr:[]u8 = nio_alloc(32);
        let rr:[]u8 = nio_alloc(32);
        cell_rect(fd, w, h, dr);
        cell_rect(fr, w, h, rr);
        let dx0:i64 = h_get64(dr, 0);
        let dy0:i64 = h_get64(dr, 8);
        let dx1:i64 = h_get64(dr, 16);
        let dy1:i64 = h_get64(dr, 24);
        h_put64(g, 24, dx0); h_put64(g, 32, dy0);
        h_put64(g, 40, dx1); h_put64(g, 48, dy1);
        let dw:i64 = dx1 - dx0;
        let dh:i64 = dy1 - dy0;
        if (fam == 0) {
            let placing:i64 = idx % 2;
            h_put64(g, 88, placing);
            if (placing == 0) {
                let rcx:i64 = (h_get64(rr, 0) + h_get64(rr, 16)) / 2;
                let rcy:i64 = (h_get64(rr, 8) + h_get64(rr, 24)) / 2;
                let gx0:i64 = rcx - dw / 2;
                let gy0:i64 = rcy - dh / 2;
                h_put64(g, 56, gx0); h_put64(g, 64, gy0);
                h_put64(g, 72, gx0 + dw); h_put64(g, 80, gy0 + dh);
            } else {
                // ADJOIN: corner minimizing recipient-saliency overlap
                let best:i64 = 0;
                let bestm:i64 = -1;
                let c:i64 = 0;
                while (c < 4) {
                    let qx:i64 = 0;
                    let qy:i64 = 0;
                    if (c == 1 || c == 3) { qx = w - dw; }
                    if (c == 2 || c == 3) { qy = h - dh; }
                    let m:i64 = rect_mass(pr, w, h, qx, qy, qx + dw, qy + dh);
                    if (bestm < 0 || m < bestm) { bestm = m; best = c; }
                    c = c + 1;
                }
                h_put64(g, 88, 10 + best);
                let qx:i64 = 0;
                let qy:i64 = 0;
                if (best == 1 || best == 3) { qx = w - dw; }
                if (best == 2 || best == 3) { qy = h - dh; }
                h_put64(g, 56, qx); h_put64(g, 64, qy);
                h_put64(g, 72, qx + dw); h_put64(g, 80, qy + dh);
            }
        } else {
            let corner:i64 = (idx - 4) % 4;
            h_put64(g, 88, 20 + corner);
            let qx:i64 = 0;
            let qy:i64 = 0;
            if (corner == 1 || corner == 3) { qx = w - 160; }
            if (corner == 2 || corner == 3) { qy = h - 120; }
            h_put64(g, 56, qx); h_put64(g, 64, qy);
            h_put64(g, 72, qx + 160); h_put64(g, 80, qy + 120);
        }
        nio_free(dr); nio_free(rr);
    }
    if (fam == 2) {
        // aux: 0=V mem0|mem1, 1=V mem1|mem0, 2=H mem0/mem1, 3=H mem1/mem0
        h_put64(g, 88, idx - 12);
    }
}
// score record (48 bytes): [0]verb [8]pres [16]bal [24]rec [32]pars [40]total
fn verb_fit(verb:i64, fam:i64) i64 {
    if (verb == 1) {
        if (fam == 0) { return 10000; }
        if (fam == 1) { return 8500; }
        if (fam == 2) { return 6000; }
        if (fam == 3) { return 4000; }
        return 4500;
    }
    if (verb == 2) {
        if (fam == 0) { return 5000; }
        if (fam == 1) { return 7000; }
        if (fam == 2) { return 10000; }
        if (fam == 3) { return 3000; }
        return 2500;
    }
    if (fam == 0) { return 3000; }
    if (fam == 1) { return 3000; }
    if (fam == 2) { return 4000; }
    if (fam == 3) { return 10000; }
    return 5500;
}
fn eval_plan(idx:i64, verb:i64, p0:[]u8, p1:[]u8, w:i64, h:i64, s:[]u8) void {
    let g:[]u8 = nio_alloc(96);
    plan_geom(idx, p0, p1, w, h, g);
    let fam:i64 = h_get64(g, 0);
    let donor:i64 = h_get64(g, 8);
    let recip:i64 = h_get64(g, 16);
    let pd:[]u8 = p0;
    if (donor == 1) { pd = p1; }
    let pr:[]u8 = p1;
    if (recip == 0) { pr = p0; }
    let vf:i64 = verb_fit(verb, fam);
    let pres:i64 = 0;
    let bal:i64 = 0;
    let rec:i64 = 10000;
    if (fam == 0 || fam == 1) {
        let tdon:i64 = h_get64(pd, 1536);
        let trec:i64 = h_get64(pr, 1536);
        let dx0:i64 = h_get64(g, 24);
        let dy0:i64 = h_get64(g, 32);
        let dx1:i64 = h_get64(g, 40);
        let dy1:i64 = h_get64(g, 48);
        let dm:i64 = rect_mass(pd, w, h, dx0, dy0, dx1, dy1);
        let donor_ret:i64 = dm * 10000 / tdon;
        let gx0:i64 = h_get64(g, 56);
        let gy0:i64 = h_get64(g, 64);
        let gx1:i64 = h_get64(g, 72);
        let gy1:i64 = h_get64(g, 80);
        let dest:i64 = rect_mass(pr, w, h, gx0, gy0, gx1, gy1) * 10000 / trec;
        let recip_ret:i64 = 10000 - dest;
        pres = donor_ret * recip_ret / 10000;
        let mn:i64 = donor_ret;
        let mx:i64 = recip_ret;
        if (recip_ret < donor_ret) { mn = recip_ret; mx = donor_ret; }
        if (mx > 0) { bal = 10000 * mn / mx; }
        if (fam == 1) { rec = 8000; }
    }
    if (fam == 2) {
        let aux:i64 = h_get64(g, 88);
        let px:[]u8 = p0;
        let py:[]u8 = p1;
        if (aux == 1 || aux == 3) { px = p1; py = p0; }
        let tx:i64 = h_get64(px, 1536);
        let ty:i64 = h_get64(py, 1536);
        let a:i64 = 0;
        let b:i64 = 0;
        if (aux < 2) {
            a = rect_mass(px, w, h, 0, 0, w / 2, h) * 10000 / tx;
            b = rect_mass(py, w, h, w / 2, 0, w, h) * 10000 / ty;
        } else {
            a = rect_mass(px, w, h, 0, 0, w, h / 2) * 10000 / tx;
            b = rect_mass(py, w, h, 0, h / 2, w, h) * 10000 / ty;
        }
        pres = a * b / 10000;
        let mn:i64 = a;
        let mx:i64 = b;
        if (b < a) { mn = b; mx = a; }
        if (mx > 0) { bal = 10000 * mn / mx; }
    }
    if (fam == 3) {
        pres = 2500; bal = 10000; rec = 9000;
    }
    if (fam == 4) {
        pres = 2500; bal = 10000; rec = 3000;
    }
    let total:i64 = 35 * vf + 30 * pres + 20 * bal + 10 * rec + 5 * 10000;
    h_put64(s, 0, vf);
    h_put64(s, 8, pres);
    h_put64(s, 16, bal);
    h_put64(s, 24, rec);
    h_put64(s, 32, 10000);
    h_put64(s, 40, total);
    nio_free(g);
}

// ---------------- synthesis primitives (generic pixel operators) ----------------
fn recall_frame(st:[]u8, f:i64, buf:[]u8) i64 {
    let w:i64 = h_get64(st, 32);
    let rows:i64 = h_get64(st, 8);
    let r:i64 = 0;
    while (r < rows) {
        if (mem_recall(st, f, r, buf, r * w * 3) != 1) { return -300 - f; }
        r = r + 1;
    }
    return 0;
}
// clipped rectangle copy: src(sx0,sy0,w,h) -> dst(dx0,dy0)
fn rect_copy(src:[]u8, sx0:i64, sy0:i64, dst:[]u8, dx0:i64, dy0:i64, w:i64, h:i64, W:i64, H:i64) void {
    if (sx0 < 0) { w = w + sx0; dx0 = dx0 - sx0; sx0 = 0; }
    if (sy0 < 0) { h = h + sy0; dy0 = dy0 - sy0; sy0 = 0; }
    if (dx0 < 0) { w = w + dx0; sx0 = sx0 - dx0; dx0 = 0; }
    if (dy0 < 0) { h = h + dy0; sy0 = sy0 - dy0; dy0 = 0; }
    if (sx0 + w > W) { w = W - sx0; }
    if (sy0 + h > H) { h = H - sy0; }
    if (dx0 + w > W) { w = W - dx0; }
    if (dy0 + h > H) { h = H - dy0; }
    if (w <= 0 || h <= 0) { return; }
    let y:i64 = 0;
    while (y < h) {
        let so:i64 = ((sy0 + y) * W + sx0) * 3;
        let doff:i64 = ((dy0 + y) * W + dx0) * 3;
        let x:i64 = 0;
        while (x < w * 3) { dst[doff + x] = src[so + x]; x = x + 1; }
        y = y + 1;
    }
}
// nearest-neighbor scale of src rect -> dst rect
fn scale_nn(src:[]u8, sx0:i64, sy0:i64, sw:i64, sh:i64, dst:[]u8, dx0:i64, dy0:i64, dw:i64, dh:i64, W:i64, H:i64) void {
    let dy:i64 = 0;
    while (dy < dh) {
        let sy:i64 = sy0 + dy * sh / dh;
        let dx:i64 = 0;
        while (dx < dw) {
            let sx:i64 = sx0 + dx * sw / dw;
            let so:i64 = (sy * W + sx) * 3;
            let doff:i64 = ((dy0 + dy) * W + dx0 + dx) * 3;
            dst[doff] = src[so]; dst[doff + 1] = src[so + 1]; dst[doff + 2] = src[so + 2];
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}
// execute plan idx on all frame pairs -> outdir/frame_%02d.ppm
fn execute_plan(idx:i64, st0:[]u8, st1:[]u8, p0:[]u8, p1:[]u8, outd:[]u8) i64 {
    let w:i64 = h_get64(st0, 32);
    let h:i64 = h_get64(st0, 40);
    let nf:i64 = h_get64(st0, 48);
    let g:[]u8 = nio_alloc(96);
    plan_geom(idx, p0, p1, w, h, g);
    let fam:i64 = h_get64(g, 0);
    let donor:i64 = h_get64(g, 8);
    let recip:i64 = h_get64(g, 16);
    ensure_dir(outd);
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { nio_free(g); return -310; }
    let b0:[]u8 = nio_alloc((w * h * 3) as i32);
    let b1:[]u8 = nio_alloc((w * h * 3) as i32);
    let out:[]u8 = nio_alloc((w * h * 3) as i32);
    let tmp:[]u8 = nio_alloc(160 * 120 * 3);
    let fnm:[]u8 = nio_alloc(16);
    let f:i64 = 0;
    while (f < nf) {
        let rc:i64 = recall_frame(st0, f, b0);
        if (rc != 0) { return -320 - f; }
        rc = recall_frame(st1, f, b1);
        if (rc != 0) { return -330 - f; }
        let bd:[]u8 = b0;
        if (donor == 1) { bd = b1; }
        let br:[]u8 = b1;
        if (recip == 0) { br = b0; }
        if (fam == 0) {
            let i:i64 = 0;
            while (i < w * h * 3) { out[i] = br[i]; i = i + 1; }
            rect_copy(bd, h_get64(g, 24), h_get64(g, 32), out, h_get64(g, 56), h_get64(g, 64),
                h_get64(g, 40) - h_get64(g, 24), h_get64(g, 48) - h_get64(g, 32), w, h);
        }
        if (fam == 1) {
            let i:i64 = 0;
            while (i < w * h * 3) { out[i] = br[i]; i = i + 1; }
            scale_nn(bd, h_get64(g, 24), h_get64(g, 32),
                h_get64(g, 40) - h_get64(g, 24), h_get64(g, 48) - h_get64(g, 32),
                tmp, 0, 0, 160, 120, w, h);
            rect_copy(tmp, 0, 0, out, h_get64(g, 56), h_get64(g, 64), 160, 120, w, h);
        }
        if (fam == 2) {
            let aux:i64 = h_get64(g, 88);
            let bx:[]u8 = b0;
            let by:[]u8 = b1;
            if (aux == 1 || aux == 3) { bx = b1; by = b0; }
            if (aux < 2) {
                let y:i64 = 0;
                while (y < h) {
                    let x:i64 = 0;
                    while (x < w) {
                        let o:i64 = (y * w + x) * 3;
                        let s:[]u8 = bx;
                        if (x >= w / 2) { s = by; }
                        out[o] = s[o]; out[o + 1] = s[o + 1]; out[o + 2] = s[o + 2];
                        x = x + 1;
                    }
                    y = y + 1;
                }
            } else {
                let y2:i64 = 0;
                while (y2 < h) {
                    let x2:i64 = 0;
                    while (x2 < w) {
                        let o2:i64 = (y2 * w + x2) * 3;
                        let s2:[]u8 = bx;
                        if (y2 >= h / 2) { s2 = by; }
                        out[o2] = s2[o2]; out[o2 + 1] = s2[o2 + 1]; out[o2 + 2] = s2[o2 + 2];
                        x2 = x2 + 1;
                    }
                    y2 = y2 + 1;
                }
            }
        }
        if (fam == 3) {
            let s:[]u8 = b0;
            if ((f / 2) % 2 == 1) { s = b1; }
            let i:i64 = 0;
            while (i < w * h * 3) { out[i] = s[i]; i = i + 1; }
        }
        if (fam == 4) {
            if (f < 8) {
                let k:i64 = f;
                let i:i64 = 0;
                while (i < w * h * 3) {
                    let a:i64 = b0[i] as i64;
                    let bb:i64 = b1[i] as i64;
                    out[i] = ((a * (8 - k) + bb * k + 4) / 8) as u8;
                    i = i + 1;
                }
            } else {
                let i2:i64 = 0;
                while (i2 < w * h * 3) { out[i2] = b1[i2]; i2 = i2 + 1; }
            }
        }
        let nl:i64 = mk_frame_name(fnm, f);
        let wrc:i64 = write_ppm(oroot, fnm[0..nl], out, w, h);
        if (wrc != 0) { nio_close(oroot); return -340 - f; }
        f = f + 1;
    }
    nio_close(oroot);
    nio_free(g); nio_free(b0); nio_free(b1); nio_free(out); nio_free(tmp); nio_free(fnm);
    return 0;
}

// ---------------- deliberation trace ----------------
fn plan_desc(idx:i64, lab0:[]u8, lab1:[]u8, p0:[]u8, p1:[]u8, w:i64, h:i64, tr:[]u8, o:i64) i64 {
    let g:[]u8 = nio_alloc(96);
    plan_geom(idx, p0, p1, w, h, g);
    let fam:i64 = h_get64(g, 0);
    let donor:i64 = h_get64(g, 8);
    let recip:i64 = h_get64(g, 16);
    o = tr_str(tr, o, "[");
    if (idx < 10) { o = tr_str(tr, o, "0"); }
    o = tr_i64(tr, o, idx);
    o = tr_str(tr, o, "] ");
    if (fam == 0) {
        o = tr_str(tr, o, "OVERLAY ");
        if (donor == 0) { o = tr_str(tr, o, lab0); } else { o = tr_str(tr, o, lab1); }
        o = tr_str(tr, o, "->");
        if (recip == 0) { o = tr_str(tr, o, lab0); } else { o = tr_str(tr, o, lab1); }
        let aux:i64 = h_get64(g, 88);
        if (aux == 0) { o = tr_str(tr, o, " REPLACE"); } else { o = tr_str(tr, o, " ADJOIN"); }
    }
    if (fam == 1) {
        o = tr_str(tr, o, "PIP ");
        if (donor == 0) { o = tr_str(tr, o, lab0); } else { o = tr_str(tr, o, lab1); }
        o = tr_str(tr, o, "->");
        if (recip == 0) { o = tr_str(tr, o, lab0); } else { o = tr_str(tr, o, lab1); }
        let cn:i64 = h_get64(g, 88) - 20;
        o = tr_str(tr, o, " corner=");
        if (cn == 0) { o = tr_str(tr, o, "TL"); }
        if (cn == 1) { o = tr_str(tr, o, "TR"); }
        if (cn == 2) { o = tr_str(tr, o, "BL"); }
        if (cn == 3) { o = tr_str(tr, o, "BR"); }
    }
    if (fam == 2) {
        let aux:i64 = h_get64(g, 88);
        if (aux == 0) { o = tr_str(tr, o, "SPLIT_V "); o = tr_str(tr, o, lab0); o = tr_str(tr, o, "|"); o = tr_str(tr, o, lab1); }
        if (aux == 1) { o = tr_str(tr, o, "SPLIT_V "); o = tr_str(tr, o, lab1); o = tr_str(tr, o, "|"); o = tr_str(tr, o, lab0); }
        if (aux == 2) { o = tr_str(tr, o, "SPLIT_H "); o = tr_str(tr, o, lab0); o = tr_str(tr, o, "/"); o = tr_str(tr, o, lab1); }
        if (aux == 3) { o = tr_str(tr, o, "SPLIT_H "); o = tr_str(tr, o, lab1); o = tr_str(tr, o, "/"); o = tr_str(tr, o, lab0); }
    }
    if (fam == 3) { o = tr_str(tr, o, "INTERLEAVE k=2"); }
    if (fam == 4) { o = tr_str(tr, o, "XFADE n=8"); }
    o = tr_str(tr, o, " graft=(");
    o = tr_i64(tr, o, h_get64(g, 56));
    o = tr_str(tr, o, ",");
    o = tr_i64(tr, o, h_get64(g, 64));
    o = tr_str(tr, o, ")-(");
    o = tr_i64(tr, o, h_get64(g, 72));
    o = tr_str(tr, o, ",");
    o = tr_i64(tr, o, h_get64(g, 80));
    o = tr_str(tr, o, ")");
    nio_free(g);
    return o;
}
fn crit_name(ci:i64, tr:[]u8, o:i64) i64 {
    if (ci == 0) { return tr_str(tr, o, "verb_fit"); }
    if (ci == 1) { return tr_str(tr, o, "presence"); }
    if (ci == 2) { return tr_str(tr, o, "balance"); }
    return tr_str(tr, o, "recognizability");
}
// ---------------- compose ----------------
fn do_compose(workA:[]u8, workB:[]u8, instr:[]u8, outd:[]u8) i64 {
    let st0:[]u8 = load_store_full(workA);
    let st1:[]u8 = load_store_full(workB);
    ensure_dir(outd);
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { return -400; }
    let tr:[]u8 = nio_alloc(65536);
    let to:i64 = 0;
    to = tr_str(tr, to, "COMPOSE_ATTEMPT v1\nmechanism: composer organ (propose/evaluate/select/synthesize), pure Zag, zero RNG\n");
    // labels
    let lab0:[]u8 = nio_alloc(64);
    let lab1:[]u8 = nio_alloc(64);
    let l0n:i64 = store_label(st0, lab0);
    let l1n:i64 = store_label(st1, lab1);
    let lab0s:[]u8 = lab0[0..l0n];
    let lab1s:[]u8 = lab1[0..l1n];
    let i:i64 = 0;
    while (i < l0n) { lab0[i] = to_lower(lab0[i]); i = i + 1; }
    i = 0;
    while (i < l1n) { lab1[i] = to_lower(lab1[i]); i = i + 1; }
    let w0:i64 = h_get64(st0, 32);
    let h0:i64 = h_get64(st0, 40);
    let nf0:i64 = h_get64(st0, 48);
    let w1:i64 = h_get64(st1, 32);
    let h1:i64 = h_get64(st1, 40);
    let nf1:i64 = h_get64(st1, 48);
    // sanity refusals (honest scope boundaries)
    if (l0n == l1n) {
        let same:i64 = 1;
        let k:i64 = 0;
        while (k < l0n) { if (lab0[k] != lab1[k]) { same = 0; } k = k + 1; }
        if (same == 1) {
            to = tr_str(tr, to, "RESULT: COMPOSE_REFUSED\nreason: both memories carry the same label; nothing distinct to compose.\n");
            write_buf(oroot, "compose_refusal.txt", tr, to);
            nio_close(oroot);
            return 1;
        }
    }
    if (w0 != 320 || h0 != 240 || w1 != 320 || h1 != 240 || nf0 != nf1 || nf0 < 2) {
        to = tr_str(tr, to, "RESULT: COMPOSE_REFUSED\nreason: plan language requires two 320x240 videos with equal frame counts; got dims/nframes mismatch or a still.\n");
        write_buf(oroot, "compose_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    // perceive
    let p0:[]u8 = perc_alloc();
    let p1:[]u8 = perc_alloc();
    let prc:i64 = perceive(st0, p0);
    if (prc != 0) { return -410; }
    prc = perceive(st1, p1);
    if (prc != 0) { return -411; }
    // instruction
    let n:i64 = instr.len;
    let cut:i64 = -1;
    i = 0;
    while (i < n) { if ((instr[i] as i64) == 47) { cut = i; } i = i + 1; }
    if (cut < 0) { return -420; }
    let iroot:i64 = nio_open_root(instr[0..cut]);
    if (iroot < 0) { return -421; }
    let ibuf:[]u8 = nio_alloc(4096);
    let ilen:i64 = read_file(iroot, instr[cut + 1..n], ibuf, 4096);
    nio_close(iroot);
    if (ilen < 0) { return -422; }
    let words:[]u8 = nio_alloc(256 * 16);
    let nw:i64 = tokenize(ibuf, ilen, words);
    let verb:i64 = detect_verb(ibuf, words, nw);
    let subj:[]u8 = nio_alloc(16);
    let ns:i64 = match_subjects(ibuf, words, nw, lab0s, lab1s, subj);
    to = tr_str(tr, to, "instruction: ");
    let ci:i64 = 0;
    while (ci < ilen) { tr[to + ci] = ibuf[ci]; ci = ci + 1; }
    to = to + ilen;
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "parse: verb=");
    let vn:[]u8 = nio_alloc(16);
    let vnl:i64 = verb_name(verb, vn);
    to = tr_str(tr, to, vn[0..vnl]);
    to = tr_str(tr, to, " subjects=[");
    let sj:i64 = 0;
    while (sj < ns) {
        if (sj > 0) { to = tr_str(tr, to, ","); }
        if (h_get64(subj, sj * 8) == 0) { to = tr_str(tr, to, lab0s); } else { to = tr_str(tr, to, lab1s); }
        sj = sj + 1;
    }
    to = tr_str(tr, to, "]");
    to = tr_nl(tr, to);
    if (verb == 0) {
        to = tr_str(tr, to, "RESULT: COMPOSE_REFUSED\nreason: no recognized verb in instruction; the mechanism cannot parse what composition is asked for.\n");
        write_buf(oroot, "compose_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    if (ns != 2) {
        to = tr_str(tr, to, "RESULT: COMPOSE_REFUSED\nreason: instruction must name two distinct memorized subjects; matched ");
        to = tr_i64(tr, to, ns);
        to = tr_str(tr, to, ".\n");
        write_buf(oroot, "compose_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    // perception block
    to = tr_str(tr, to, "perceive: saliency=motion+texture, thirds-grid density (x10000), focus=argmax\n");
    let m:i64 = 0;
    while (m < 2) {
        let pm:[]u8 = p0;
        let lm:[]u8 = lab0s;
        if (m == 1) { pm = p1; lm = lab1s; }
        to = tr_str(tr, to, " mem label=");
        to = tr_str(tr, to, lm);
        to = tr_str(tr, to, " focus=cell");
        let fc:i64 = h_get64(pm, 1616);
        to = tr_i64(tr, to, fc);
        let rc2:[]u8 = nio_alloc(32);
        cell_rect(fc, 320, 240, rc2);
        to = tr_str(tr, to, " rect=(");
        to = tr_i64(tr, to, h_get64(rc2, 0));
        to = tr_str(tr, to, ",");
        to = tr_i64(tr, to, h_get64(rc2, 8));
        to = tr_str(tr, to, ")-(");
        to = tr_i64(tr, to, h_get64(rc2, 16));
        to = tr_str(tr, to, ",");
        to = tr_i64(tr, to, h_get64(rc2, 24));
        to = tr_str(tr, to, ") dens=[");
        let cc:i64 = 0;
        while (cc < 9) {
            if (cc > 0) { to = tr_str(tr, to, ","); }
            to = tr_i64(tr, to, h_get64(pm, 1544 + cc * 8));
            cc = cc + 1;
        }
        to = tr_str(tr, to, "]");
        to = tr_nl(tr, to);
        nio_free(rc2);
        m = m + 1;
    }
    // evaluate all 18
    let scores:[]u8 = nio_alloc(18 * 48);
    let k2:i64 = 0;
    while (k2 < 18) {
        eval_plan(k2, verb, p0, p1, 320, 240, scores[k2 * 48..k2 * 48 + 48]);
        k2 = k2 + 1;
    }
    to = tr_str(tr, to, "candidates: score = 35*verb_fit + 30*presence + 20*balance + 10*recognizability + 5*parsimony (x100 scale shown)\n");
    k2 = 0;
    while (k2 < 18) {
        to = plan_desc(k2, lab0s, lab1s, p0, p1, 320, 240, tr, to);
        to = tr_str(tr, to, " verb=");
        to = tr_fp2(tr, to, h_get64(scores, k2 * 48));
        to = tr_str(tr, to, " pres=");
        to = tr_fp2(tr, to, h_get64(scores, k2 * 48 + 8));
        to = tr_str(tr, to, " bal=");
        to = tr_fp2(tr, to, h_get64(scores, k2 * 48 + 16));
        to = tr_str(tr, to, " rec=");
        to = tr_fp2(tr, to, h_get64(scores, k2 * 48 + 24));
        to = tr_str(tr, to, " total=");
        to = tr_fp2(tr, to, h_get64(scores, k2 * 48 + 40));
        to = tr_nl(tr, to);
        k2 = k2 + 1;
    }
    // select: argmax total, tiebreak lowest index
    let win:i64 = 0;
    let wtot:i64 = h_get64(scores, 40);
    k2 = 1;
    while (k2 < 18) {
        let t:i64 = h_get64(scores, k2 * 48 + 40);
        if (t > wtot) { wtot = t; win = k2; }
        k2 = k2 + 1;
    }
    // best per family (for rejection reasons)
    let famw:[]u8 = nio_alloc(5 * 8);
    let famt:[]u8 = nio_alloc(5 * 8);
    let fi:i64 = 0;
    while (fi < 5) { h_put64(famw, fi * 8, -1); h_put64(famt, fi * 8, -1); fi = fi + 1; }
    k2 = 0;
    while (k2 < 18) {
        let f2:i64 = plan_family(k2);
        let t2:i64 = h_get64(scores, k2 * 48 + 40);
        if (t2 > h_get64(famt, f2 * 8)) { h_put64(famt, f2 * 8, t2); h_put64(famw, f2 * 8, k2); }
        k2 = k2 + 1;
    }
    to = tr_str(tr, to, "selected: ");
    to = plan_desc(win, lab0s, lab1s, p0, p1, 320, 240, tr, to);
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "reasons:\n");
    if (verb == 1) {
        to = tr_str(tr, to, "- verb MERGE demands one integrated frame holding both subjects: OVERLAY/PIP families fit (verb_fit 100/85); SPLIT juxtaposes (60), INTERLEAVE alternates in time (40), XFADE dissolves (45).\n");
    }
    if (verb == 2) {
        to = tr_str(tr, to, "- verb SIDE demands juxtaposition: SPLIT fits (verb_fit 100); OVERLAY/PIP integrate (50/70); INTERLEAVE/XFADE do not juxtapose (30/25).\n");
    }
    if (verb == 3) {
        to = tr_str(tr, to, "- verb THEN demands temporal order: INTERLEAVE fits (verb_fit 100); spatial arrangements do not sequence (30-55).\n");
    }
    to = tr_str(tr, to, "- winner total=");
    to = tr_fp2(tr, to, wtot);
    to = tr_str(tr, to, ": presence=");
    to = tr_fp2(tr, to, h_get64(scores, win * 48 + 8));
    to = tr_str(tr, to, " balance=");
    to = tr_fp2(tr, to, h_get64(scores, win * 48 + 16));
    to = tr_str(tr, to, ".\n");
    // rejection reasons: best plan of each losing family
    fi = 0;
    while (fi < 5) {
        let li:i64 = h_get64(famw, fi * 8);
        if (li >= 0) {
            if (li != win) {
                let lt:i64 = h_get64(famt, fi * 8);
                to = tr_str(tr, to, "- rejected ");
                to = plan_desc(li, lab0s, lab1s, p0, p1, 320, 240, tr, to);
                to = tr_str(tr, to, ": total=");
                to = tr_fp2(tr, to, lt);
                to = tr_str(tr, to, " (");
                to = tr_fp2(tr, to, wtot - lt);
                to = tr_str(tr, to, " behind); decisive: ");
                let dv:i64 = 35 * (h_get64(scores, win * 48) - h_get64(scores, li * 48));
                let dp:i64 = 30 * (h_get64(scores, win * 48 + 8) - h_get64(scores, li * 48 + 8));
                let db:i64 = 20 * (h_get64(scores, win * 48 + 16) - h_get64(scores, li * 48 + 16));
                let dr:i64 = 10 * (h_get64(scores, win * 48 + 24) - h_get64(scores, li * 48 + 24));
                let bci:i64 = 0;
                let bv:i64 = dv;
                if (dp > bv) { bv = dp; bci = 1; }
                if (db > bv) { bv = db; bci = 2; }
                if (dr > bv) { bv = dr; bci = 3; }
                if (bv <= 0) {
                    to = tr_str(tr, to, "tie on total; lowest plan index wins (deterministic tiebreak)");
                } else {
                    to = crit_name(bci, tr, to);
                    to = tr_str(tr, to, " (winner ");
                    if (bci == 0) { to = tr_fp2(tr, to, h_get64(scores, win * 48)); }
                    if (bci == 1) { to = tr_fp2(tr, to, h_get64(scores, win * 48 + 8)); }
                    if (bci == 2) { to = tr_fp2(tr, to, h_get64(scores, win * 48 + 16)); }
                    if (bci == 3) { to = tr_fp2(tr, to, h_get64(scores, win * 48 + 24)); }
                    to = tr_str(tr, to, " vs ");
                    if (bci == 0) { to = tr_fp2(tr, to, h_get64(scores, li * 48)); }
                    if (bci == 1) { to = tr_fp2(tr, to, h_get64(scores, li * 48 + 8)); }
                    if (bci == 2) { to = tr_fp2(tr, to, h_get64(scores, li * 48 + 16)); }
                    if (bci == 3) { to = tr_fp2(tr, to, h_get64(scores, li * 48 + 24)); }
                    to = tr_str(tr, to, ")");
                }
                to = tr_nl(tr, to);
            }
        }
        fi = fi + 1;
    }
    // closest rival inside the winning family: why the sibling plan lost
    let wfam:i64 = plan_family(win);
    let sib:i64 = -1;
    let sibt:i64 = -1;
    k2 = 0;
    while (k2 < 18) {
        if (k2 != win) {
            if (plan_family(k2) == wfam) {
                let t3:i64 = h_get64(scores, k2 * 48 + 40);
                if (t3 > sibt) { sibt = t3; sib = k2; }
            }
        }
        k2 = k2 + 1;
    }
    if (sib >= 0) {
        to = tr_str(tr, to, "- closest rival in winning family: ");
        to = plan_desc(sib, lab0s, lab1s, p0, p1, 320, 240, tr, to);
        to = tr_str(tr, to, ": total=");
        to = tr_fp2(tr, to, sibt);
        to = tr_str(tr, to, " (");
        to = tr_fp2(tr, to, wtot - sibt);
        to = tr_str(tr, to, " behind); decisive: ");
        let sdv:i64 = 35 * (h_get64(scores, win * 48) - h_get64(scores, sib * 48));
        let sdp:i64 = 30 * (h_get64(scores, win * 48 + 8) - h_get64(scores, sib * 48 + 8));
        let sdb:i64 = 20 * (h_get64(scores, win * 48 + 16) - h_get64(scores, sib * 48 + 16));
        let sdr:i64 = 10 * (h_get64(scores, win * 48 + 24) - h_get64(scores, sib * 48 + 24));
        let sbci:i64 = 0;
        let sbv:i64 = sdv;
        if (sdp > sbv) { sbv = sdp; sbci = 1; }
        if (sdb > sbv) { sbv = sdb; sbci = 2; }
        if (sdr > sbv) { sbv = sdr; sbci = 3; }
        if (sbv <= 0) {
            to = tr_str(tr, to, "tie on total; lowest plan index wins (deterministic tiebreak)");
        } else {
            to = crit_name(sbci, tr, to);
            to = tr_str(tr, to, " (winner ");
            if (sbci == 0) { to = tr_fp2(tr, to, h_get64(scores, win * 48)); }
            if (sbci == 1) { to = tr_fp2(tr, to, h_get64(scores, win * 48 + 8)); }
            if (sbci == 2) { to = tr_fp2(tr, to, h_get64(scores, win * 48 + 16)); }
            if (sbci == 3) { to = tr_fp2(tr, to, h_get64(scores, win * 48 + 24)); }
            to = tr_str(tr, to, " vs ");
            if (sbci == 0) { to = tr_fp2(tr, to, h_get64(scores, sib * 48)); }
            if (sbci == 1) { to = tr_fp2(tr, to, h_get64(scores, sib * 48 + 8)); }
            if (sbci == 2) { to = tr_fp2(tr, to, h_get64(scores, sib * 48 + 16)); }
            if (sbci == 3) { to = tr_fp2(tr, to, h_get64(scores, sib * 48 + 24)); }
            to = tr_str(tr, to, ")");
        }
        to = tr_nl(tr, to);
    }
    // synthesize the winner
    let src:i64 = execute_plan(win, st0, st1, p0, p1, outd);
    if (src != 0) { return -430 - win; }
    to = tr_str(tr, to, "synthesis: executed winning plan on ");
    to = tr_i64(tr, to, nf0);
    to = tr_str(tr, to, " deliberately-recalled frame pairs -> frame_%02d.ppm\n");
    to = tr_str(tr, to, "RESULT: COMPOSED\n");
    write_buf(oroot, "compose_trace.txt", tr, to);
    nio_close(oroot);
    _zag_print("composed plan=");
    _zag_print(_zag_i64_to_str(win));
    _zag_print(" total=");
    _zag_println(_zag_i64_to_str(wtot));
    return 0;
}
// ---------------- render (comparison only; NOT the mechanism's selection) ----------------
fn do_render(workA:[]u8, workB:[]u8, planidx:i64, outd:[]u8) i64 {
    if (planidx < 0 || planidx > 17) { return -500; }
    let st0:[]u8 = load_store_full(workA);
    let st1:[]u8 = load_store_full(workB);
    let p0:[]u8 = perc_alloc();
    let p1:[]u8 = perc_alloc();
    if (perceive(st0, p0) != 0) { return -501; }
    if (perceive(st1, p1) != 0) { return -502; }
    let rc:i64 = execute_plan(planidx, st0, st1, p0, p1, outd);
    ensure_dir(outd);
    let oroot:i64 = nio_open_root(outd);
    let tr:[]u8 = nio_alloc(1024);
    let to:i64 = 0;
    to = tr_str(tr, to, "RENDER plan=");
    to = tr_i64(tr, to, planidx);
    to = tr_str(tr, to, "\nnote: comparison render only; NOT selected by deliberation.\n");
    write_buf(oroot, "render_trace.txt", tr, to);
    nio_close(oroot);
    return rc;
}
// ---------------- misc ----------------
fn parse_i64(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i64 = 0;
    while (i < s.len) {
        let c:i64 = s[i] as i64;
        if (c >= 48) { if (c <= 57) { v = v * 10 + (c - 48); } }
        i = i + 1;
    }
    return v;
}
fn selftest() i32 {
    let t:[]u8 = nio_alloc(3);
    t[0] = 97; t[1] = 98; t[2] = 99;
    let h:i64 = fnv(t, 0, 3);
    _zag_print("fnv_abc=");
    _zag_println(_zag_i64_to_str(h));
    // tokenizer + verb check on the actual test instruction
    let s:[]u8 = "merge the pig and the bunny together";
    let words:[]u8 = nio_alloc(256 * 16);
    let nw:i64 = tokenize(s, s.len, words);
    _zag_print("words=");
    _zag_println(_zag_i64_to_str(nw));
    let v:i64 = detect_verb(s, words, nw);
    _zag_print("verb=");
    _zag_println(_zag_i64_to_str(v));
    let l0:[]u8 = "bunny";
    let l1:[]u8 = "pig";
    let subj:[]u8 = nio_alloc(16);
    let ns:i64 = match_subjects(s, words, nw, l0, l1, subj);
    _zag_print("subjects=");
    _zag_print(_zag_i64_to_str(ns));
    _zag_print(" s0=");
    _zag_print(_zag_i64_to_str(h_get64(subj, 0)));
    _zag_print(" s1=");
    _zag_println(_zag_i64_to_str(h_get64(subj, 8)));
    let s2:[]u8 = "show the pig and the bunny side by side";
    let nw2:i64 = tokenize(s2, s2.len, words);
    _zag_print("verb2=");
    _zag_println(_zag_i64_to_str(detect_verb(s2, words, nw2)));
    return 0;
}

// ================= FUSION ORGAN (STEP 3) =================
// Extends the composer organ with part-level segmentation, part correspondence,
// and realism adaptation (background/seam blend, lighting, shadow).
// All strategies below are GENERIC operators (percentiles, motion statistics,
// morphology); every threshold value TNN actually uses is MEASURED from the
// two memories and recorded in the trace. "Head" is an operational proxy:
// the upper high-texture part of the motion subject (bunny) / the dark
// high-drift part of the dark quintile (pig). The trace says this plainly.
// Design note (honest): the programmer supplies the generic strategy and
// operator language; TNN owns every measured selection and parameter.
// The verdict must judge whether the result is believable fusion or a
// softened segment composite, and name the exact mechanical boundary.

// ---------- small helpers ----------
// gray plane from RGB
fn seg_gray(px:[]u8, gray:[]u8, N:i64) void {
    let p:i64 = 0;
    while (p < N) {
        let o:i64 = p * 3;
        gray[p] = (((px[o] as i64) + (px[o + 1] as i64) + (px[o + 2] as i64)) / 3) as u8;
        p = p + 1;
    }
}
// per-pixel motion energy: sum over frames of |gray(f+1)-gray(f)| (x4 fixed)
fn seg_motion_E(st:[]u8, E:[]u8, W:i64, H:i64, nf:i64) i64 {
    let N:i64 = W * H;
    let p:i64 = 0;
    while (p < N) { h_put64(E, p * 8, 0); p = p + 1; }
    let g0:[]u8 = nio_alloc(N as i32);
    let g1:[]u8 = nio_alloc(N as i32);
    let fr:[]u8 = nio_alloc(230400);
    if (recall_frame(st, 0, fr) != 0) { return -1; }
    seg_gray(fr, g0, N);
    let f:i64 = 1;
    while (f < nf) {
        if (recall_frame(st, f, fr) != 0) { return -2; }
        seg_gray(fr, g1, N);
        let q:i64 = 0;
        while (q < N) {
            let d:i64 = (g1[q] as i64) - (g0[q] as i64);
            if (d < 0) { d = 0 - d; }
            h_put64(E, q * 8, h_get64(E, q * 8) + d * 4);
            g0[q] = g1[q];
            q = q + 1;
        }
        f = f + 1;
    }
    nio_free(g0);
    nio_free(g1);
    nio_free(fr);
    return 0;
}
// per-pixel gradient texture (x4 fixed), 0..1020
fn seg_texture(gray:[]u8, tex:[]u8, W:i64, H:i64) void {
    let y:i64 = 0;
    while (y < H) {
        let x:i64 = 0;
        while (x < W) {
            let xm:i64 = x - 1;
            if (xm < 0) { xm = 0; }
            let xp:i64 = x + 1;
            if (xp >= W) { xp = W - 1; }
            let ym:i64 = y - 1;
            if (ym < 0) { ym = 0; }
            let yp:i64 = y + 1;
            if (yp >= H) { yp = H - 1; }
            let gx:i64 = (gray[y * W + xp] as i64) - (gray[y * W + xm] as i64);
            if (gx < 0) { gx = 0 - gx; }
            let gy:i64 = (gray[yp * W + x] as i64) - (gray[ym * W + x] as i64);
            if (gy < 0) { gy = 0 - gy; }
            h_put64(tex, (y * W + x) * 8, (gx + gy) * 4);
            x = x + 1;
        }
        y = y + 1;
    }
}
// histogram of E/4 into 1024 bins (E x4 fixed -> bin = E/4)
fn seg_histE(E:[]u8, N:i64, hist:[]u8) void {
    let i:i64 = 0;
    while (i < 1024) { h_put64(hist, i * 8, 0); i = i + 1; }
    let p:i64 = 0;
    while (p < N) {
        let b:i64 = h_get64(E, p * 8) / 4;
        if (b > 1023) { b = 1023; }
        h_put64(hist, b * 8, h_get64(hist, b * 8) + 1);
        p = p + 1;
    }
}
// percentile of a binned histogram: smallest bin b with cum*100 >= q*total
fn seg_pct_bin(hist:[]u8, nbins:i64, total:i64, q:i64) i64 {
    let cum:i64 = 0;
    let b:i64 = 0;
    while (b < nbins) {
        cum = cum + h_get64(hist, b * 8);
        if (cum * 100 >= q * total) { return b; }
        b = b + 1;
    }
    return nbins - 1;
}
// percentile of gray plane (0..255)
fn seg_gray_pct(gray:[]u8, N:i64, q:i64) i64 {
    let hist:[]u8 = nio_alloc(2048);
    let i:i64 = 0;
    while (i < 256) { h_put64(hist, i * 8, 0); i = i + 1; }
    let p:i64 = 0;
    while (p < N) {
        let g:i64 = gray[p] as i64;
        h_put64(hist, g * 8, h_get64(hist, g * 8) + 1);
        p = p + 1;
    }
    let r:i64 = seg_pct_bin(hist, 256, N, q);
    nio_free(hist);
    return r;
}
// threshold gray plane: below=1 -> mask = gray < thr ; below=0 -> gray >= thr
fn seg_thresh(gray:[]u8, mask:[]u8, N:i64, thr:i64, below:i64) void {
    let p:i64 = 0;
    while (p < N) {
        let g:i64 = gray[p] as i64;
        if (below == 1) {
            if (g < thr) { mask[p] = 1; } else { mask[p] = 0; }
        } else {
            if (g >= thr) { mask[p] = 1; } else { mask[p] = 0; }
        }
        p = p + 1;
    }
}
// 3x3 morphology: op=0 erode, op=1 dilate
fn seg_morph3(mask:[]u8, tmp:[]u8, W:i64, H:i64, op:i64) void {
    let y:i64 = 0;
    while (y < H) {
        let x:i64 = 0;
        while (x < W) {
            let v:i64 = 0;
            if (op == 1) {
                // dilate: any neighbor set
                let dy:i64 = -1;
                while (dy <= 1) {
                    let dx:i64 = -1;
                    while (dx <= 1) {
                        let xx:i64 = x + dx;
                        let yy:i64 = y + dy;
                        if (xx >= 0) {
                            if (xx < W) {
                                if (yy >= 0) {
                                    if (yy < H) {
                                        if (mask[yy * W + xx] != 0) { v = 1; }
                                    }
                                }
                            }
                        }
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }
            } else {
                // erode: all neighbors set
                v = 1;
                let dy:i64 = -1;
                while (dy <= 1) {
                    let dx:i64 = -1;
                    while (dx <= 1) {
                        let xx:i64 = x + dx;
                        let yy:i64 = y + dy;
                        if (xx >= 0) {
                            if (xx < W) {
                                if (yy >= 0) {
                                    if (yy < H) {
                                        if (mask[yy * W + xx] == 0) { v = 0; }
                                    } else { v = 0; }
                                } else { v = 0; }
                            } else { v = 0; }
                        } else { v = 0; }
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }
            }
            tmp[y * W + x] = v as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    let p:i64 = 0;
    while (p < W * H) { mask[p] = tmp[p]; p = p + 1; }
}
// opening = erode x iters then dilate x iters (in place)
fn seg_open(mask:[]u8, tmp:[]u8, W:i64, H:i64, iters:i64) void {
    let k:i64 = 0;
    while (k < iters) { seg_morph3(mask, tmp, W, H, 0); k = k + 1; }
    k = 0;
    while (k < iters) { seg_morph3(mask, tmp, W, H, 1); k = k + 1; }
}
// fill holes: flood background from border through zeros, invert
fn seg_fill_holes(mask:[]u8, W:i64, H:i64) void {
    let N:i64 = W * H;
    let seen:[]u8 = nio_alloc(N as i32);
    let stack:[]u8 = nio_alloc((N * 8) as i32);
    let p:i64 = 0;
    while (p < N) { seen[p] = 0; p = p + 1; }
    let sp:i64 = 0;
    // Mark seen AT PUSH (seed and neighbors): each pixel is then pushed at
    // most once, so the N-slot stack provably cannot overflow.
    // (2026-09-26 red-team kill: marking at pop let one pixel be pushed up to
    // 4x; on empty masks depth hit 77,357 > 76,800 slots -> panic.)
    // NOTE: the pop loop below has NO seen-check/continue. With mark-at-push
    // every pop is a fresh pixel that must expand; a pop-side `continue`
    // would wrongly skip expansion of seed pixels and starve the flood.
    // The seed pushes also guard on seen: at corners (and when H==1 or W==1)
    // two seeds address the same pixel, and pushing it twice would overflow
    // the N-slot stack on tiny masks.
    let x:i64 = 0;
    while (x < W) {
        if (mask[x] == 0) { if (seen[x] == 0) { seen[x] = 1; h_put64(stack, sp * 8, x); sp = sp + 1; } }
        let b:i64 = (H - 1) * W + x;
        if (mask[b] == 0) { if (seen[b] == 0) { seen[b] = 1; h_put64(stack, sp * 8, b); sp = sp + 1; } }
        x = x + 1;
    }
    let y:i64 = 1;
    while (y < H - 1) {
        let l:i64 = y * W;
        if (mask[l] == 0) { if (seen[l] == 0) { seen[l] = 1; h_put64(stack, sp * 8, l); sp = sp + 1; } }
        let r:i64 = y * W + W - 1;
        if (mask[r] == 0) { if (seen[r] == 0) { seen[r] = 1; h_put64(stack, sp * 8, r); sp = sp + 1; } }
        y = y + 1;
    }
    while (sp > 0) {
        sp = sp - 1;
        let q:i64 = h_get64(stack, sp * 8);
        let qx:i64 = q % W;
        let qy:i64 = q / W;
        if (qx > 0) {
            let n0:i64 = q - 1;
            if (mask[n0] == 0) { if (seen[n0] == 0) { seen[n0] = 1; h_put64(stack, sp * 8, n0); sp = sp + 1; } }
        }
        if (qx < W - 1) {
            let n1:i64 = q + 1;
            if (mask[n1] == 0) { if (seen[n1] == 0) { seen[n1] = 1; h_put64(stack, sp * 8, n1); sp = sp + 1; } }
        }
        if (qy > 0) {
            let n2:i64 = q - W;
            if (mask[n2] == 0) { if (seen[n2] == 0) { seen[n2] = 1; h_put64(stack, sp * 8, n2); sp = sp + 1; } }
        }
        if (qy < H - 1) {
            let n3:i64 = q + W;
            if (mask[n3] == 0) { if (seen[n3] == 0) { seen[n3] = 1; h_put64(stack, sp * 8, n3); sp = sp + 1; } }
        }
    }
    // zeros not reached from border are holes -> set
    p = 0;
    while (p < N) {
        if (mask[p] == 0) {
            if (seen[p] == 0) { mask[p] = 1; }
        }
        p = p + 1;
    }
    nio_free(seen);
    nio_free(stack);
}
// connected components (4-connectivity) on binary mask -> lab (i64 per px).
// returns component count. labels 1..n.
fn seg_label(mask:[]u8, lab:[]u8, W:i64, H:i64) i64 {
    let N:i64 = W * H;
    let p:i64 = 0;
    while (p < N) { h_put64(lab, p * 8, 0); p = p + 1; }
    let stack:[]u8 = nio_alloc((N * 8) as i32);
    let nc:i64 = 0;
    p = 0;
    while (p < N) {
        if (mask[p] != 0) {
            if (h_get64(lab, p * 8) == 0) {
                nc = nc + 1;
                let sp:i64 = 0;
                h_put64(stack, 0, p);
                sp = 1;
                h_put64(lab, p * 8, nc);
                while (sp > 0) {
                    sp = sp - 1;
                    let q:i64 = h_get64(stack, sp * 8);
                    let qx:i64 = q % W;
                    let qy:i64 = q / W;
                    if (qx > 0) {
                        let n0:i64 = q - 1;
                        if (mask[n0] != 0) { if (h_get64(lab, n0 * 8) == 0) { h_put64(lab, n0 * 8, nc); h_put64(stack, sp * 8, n0); sp = sp + 1; } }
                    }
                    if (qx < W - 1) {
                        let n1:i64 = q + 1;
                        if (mask[n1] != 0) { if (h_get64(lab, n1 * 8) == 0) { h_put64(lab, n1 * 8, nc); h_put64(stack, sp * 8, n1); sp = sp + 1; } }
                    }
                    if (qy > 0) {
                        let n2:i64 = q - W;
                        if (mask[n2] != 0) { if (h_get64(lab, n2 * 8) == 0) { h_put64(lab, n2 * 8, nc); h_put64(stack, sp * 8, n2); sp = sp + 1; } }
                    }
                    if (qy < H - 1) {
                        let n3:i64 = q + W;
                        if (mask[n3] != 0) { if (h_get64(lab, n3 * 8) == 0) { h_put64(lab, n3 * 8, nc); h_put64(stack, sp * 8, n3); sp = sp + 1; } }
                    }
                }
            }
        }
        p = p + 1;
    }
    nio_free(stack);
    return nc;
}
// stats for one component id -> out[10]: area,x0,y0,x1,y1,cx,cy,mean_gray,mean_E,mean_tex
// returns area (0 if id invalid)
fn seg_comp_stats(lab:[]u8, ncomp:i64, id:i64, gray:[]u8, E:[]u8, tex:[]u8, W:i64, H:i64, out:[]u8) i64 {
    if (id <= 0 || id > ncomp) { return 0; }
    let N:i64 = W * H;
    let area:i64 = 0;
    let x0:i64 = W;
    let y0:i64 = H;
    let x1:i64 = -1;
    let y1:i64 = -1;
    let sx:i64 = 0;
    let sy:i64 = 0;
    let sg:i64 = 0;
    let se:i64 = 0;
    let st:i64 = 0;
    let p:i64 = 0;
    while (p < N) {
        if (h_get64(lab, p * 8) == id) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            area = area + 1;
            sx = sx + x;
            sy = sy + y;
            sg = sg + (gray[p] as i64);
            se = se + h_get64(E, p * 8);
            st = st + h_get64(tex, p * 8);
            if (x < x0) { x0 = x; }
            if (x > x1) { x1 = x; }
            if (y < y0) { y0 = y; }
            if (y > y1) { y1 = y; }
        }
        p = p + 1;
    }
    if (area == 0) { return 0; }
    h_put64(out, 0, area);
    h_put64(out, 8, x0);
    h_put64(out, 16, y0);
    h_put64(out, 24, x1);
    h_put64(out, 32, y1);
    h_put64(out, 40, sx / area);
    h_put64(out, 48, sy / area);
    h_put64(out, 56, sg / area);
    h_put64(out, 64, se / area);
    h_put64(out, 72, st / area);
    return area;
}
// largest component id (0 if none)
fn seg_largest_id(lab:[]u8, ncomp:i64, W:i64, H:i64) i64 {
    if (ncomp <= 0) { return 0; }
    let cnt:[]u8 = nio_alloc(((ncomp + 1) * 8) as i32);
    let i:i64 = 0;
    while (i <= ncomp) { h_put64(cnt, i * 8, 0); i = i + 1; }
    let N:i64 = W * H;
    let p:i64 = 0;
    while (p < N) {
        let id:i64 = h_get64(lab, p * 8);
        if (id > 0) { h_put64(cnt, id * 8, h_get64(cnt, id * 8) + 1); }
        p = p + 1;
    }
    let best:i64 = 0;
    let ba:i64 = 0;
    i = 1;
    while (i <= ncomp) {
        let a:i64 = h_get64(cnt, i * 8);
        if (a > ba) { ba = a; best = i; }
        i = i + 1;
    }
    nio_free(cnt);
    return best;
}
// neck-line: within subject mask bbox, per-row motion mass; find the row of
// minimum motion between the two strongest separated peaks.
// returns neck row, or -1 if no two valid peaks.
fn seg_neck(E:[]u8, mask:[]u8, W:i64, H:i64, x0:i64, x1:i64, y0:i64, y1:i64) i64 {
    let rows:[]u8 = nio_alloc((H * 8) as i32);
    let y:i64 = 0;
    while (y < H) { h_put64(rows, y * 8, 0); y = y + 1; }
    y = y0;
    while (y <= y1) {
        let acc:i64 = 0;
        let x:i64 = x0;
        while (x <= x1) {
            let p:i64 = y * W + x;
            if (mask[p] != 0) { acc = acc + h_get64(E, p * 8); }
            x = x + 1;
        }
        h_put64(rows, y * 8, acc);
        y = y + 1;
    }
    // top half peak, bottom half peak
    let mid:i64 = (y0 + y1) / 2;
    let p1:i64 = -1;
    let v1:i64 = 0;
    y = y0;
    while (y <= mid) {
        let v:i64 = h_get64(rows, y * 8);
        if (v > v1) { v1 = v; p1 = y; }
        y = y + 1;
    }
    let p2:i64 = -1;
    let v2:i64 = 0;
    y = mid + 1;
    while (y <= y1) {
        let v:i64 = h_get64(rows, y * 8);
        if (v > v2) { v2 = v; p2 = y; }
        y = y + 1;
    }
    nio_free(rows);
    if (p1 < 0 || p2 < 0) { return -1; }
    if (v1 <= 0 || v2 <= 0) { return -1; }
    if (p2 - p1 < 6) { return -1; }
    // min-motion row strictly between peaks
    let rows2:[]u8 = nio_alloc((H * 8) as i32);
    y = 0;
    while (y < H) { h_put64(rows2, y * 8, 0); y = y + 1; }
    y = y0;
    while (y <= y1) {
        let acc:i64 = 0;
        let x:i64 = x0;
        while (x <= x1) {
            let p:i64 = y * W + x;
            if (mask[p] != 0) { acc = acc + h_get64(E, p * 8); }
            x = x + 1;
        }
        h_put64(rows2, y * 8, acc);
        y = y + 1;
    }
    let best:i64 = -1;
    let bv:i64 = 9223372036854775807;
    y = p1 + 1;
    while (y < p2) {
        let v:i64 = h_get64(rows2, y * 8);
        if (v < bv) { bv = v; best = y; }
        y = y + 1;
    }
    nio_free(rows2);
    return best;
}
// track dark (below=1) / bright (below=0) centroid per frame inside ROI.
// out: nf x (cx,cy) i64 pairs; (-1,-1) if none.
fn seg_track(st:[]u8, thr:i64, x0:i64, y0:i64, x1:i64, y1:i64, W:i64, H:i64, nf:i64, out:[]u8) i64 {
    let fr:[]u8 = nio_alloc(230400);
    let g:[]u8 = nio_alloc((W * H) as i32);
    let below:i64 = 1;
    // caller encodes bright by passing thr negative? No: keep two entry shapes via sign of thr param is ugly.
    // convention: thr >= 0 -> dark (gray < thr); thr < 0 -> bright (gray >= -thr)
    let t:i64 = thr;
    if (thr < 0) { below = 0; t = 0 - thr; }
    let f:i64 = 0;
    while (f < nf) {
        if (recall_frame(st, f, fr) != 0) { return -1; }
        seg_gray(fr, g, W * H);
        let sx:i64 = 0;
        let sy:i64 = 0;
        let c:i64 = 0;
        let y:i64 = y0;
        while (y <= y1) {
            let x:i64 = x0;
            while (x <= x1) {
                let gv:i64 = g[y * W + x] as i64;
                let hit:i64 = 0;
                if (below == 1) { if (gv < t) { hit = 1; } } else { if (gv >= t) { hit = 1; } }
                if (hit == 1) { sx = sx + x; sy = sy + y; c = c + 1; }
                x = x + 1;
            }
            y = y + 1;
        }
        if (c > 0) {
            h_put64(out, f * 16, sx / c);
            h_put64(out, f * 16 + 8, sy / c);
        } else {
            h_put64(out, f * 16, -1);
            h_put64(out, f * 16 + 8, -1);
        }
        f = f + 1;
    }
    nio_free(fr);
    nio_free(g);
    return 0;
}
// drift range of track relative to frame ref: out[2] = (dx,dy) max-min over valid
fn seg_drift_range(trk:[]u8, nf:i64, ref:i64, out:[]u8) void {
    let mnx:i64 = 9223372036854775807;
    let mxx:i64 = -9223372036854775807;
    let mny:i64 = 9223372036854775807;
    let mxy:i64 = -9223372036854775807;
    let f:i64 = 0;
    while (f < nf) {
        let cx:i64 = h_get64(trk, f * 16);
        let cy:i64 = h_get64(trk, f * 16 + 8);
        if (cx >= 0) {
            if (cx < mnx) { mnx = cx; }
            if (cx > mxx) { mxx = cx; }
            if (cy < mny) { mny = cy; }
            if (cy > mxy) { mxy = cy; }
        }
        f = f + 1;
    }
    if (mxx < mnx) {
        h_put64(out, 0, -1);
        h_put64(out, 8, -1);
    } else {
        h_put64(out, 0, mxx - mnx);
        h_put64(out, 8, mxy - mny);
    }
}

// ---------- adaptation operators ----------
fn isqrt(n:i64) i64 {
    if (n <= 0) { return 0; }
    let x:i64 = n;
    let y:i64 = (x + 1) / 2;
    while (y < x) {
        x = y;
        y = (x + n / x) / 2;
    }
    return x;
}
// per-channel mean rgb of px where mask!=0 -> out[3] i64
fn adapt_means_masked(px:[]u8, mask:[]u8, W:i64, H:i64, out:[]u8) i64 {
    let sr:i64 = 0;
    let sg:i64 = 0;
    let sb:i64 = 0;
    let c:i64 = 0;
    let p:i64 = 0;
    let N:i64 = W * H;
    while (p < N) {
        if (mask[p] != 0) {
            let o:i64 = p * 3;
            sr = sr + (px[o] as i64);
            sg = sg + (px[o + 1] as i64);
            sb = sb + (px[o + 2] as i64);
            c = c + 1;
        }
        p = p + 1;
    }
    if (c == 0) { return -1; }
    h_put64(out, 0, sr / c);
    h_put64(out, 8, sg / c);
    h_put64(out, 16, sb / c);
    return 0;
}
// per-channel mean rgb of rect -> out[3]
fn adapt_means_rect(px:[]u8, x0:i64, y0:i64, x1:i64, y1:i64, W:i64, out:[]u8) i64 {
    let sr:i64 = 0;
    let sg:i64 = 0;
    let sb:i64 = 0;
    let c:i64 = 0;
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            let o:i64 = (y * W + x) * 3;
            sr = sr + (px[o] as i64);
            sg = sg + (px[o + 1] as i64);
            sb = sb + (px[o + 2] as i64);
            c = c + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    if (c == 0) { return -1; }
    h_put64(out, 0, sr / c);
    h_put64(out, 8, sg / c);
    h_put64(out, 16, sb / c);
    return 0;
}
// background light stats from low-motion pixels: out[4]: topmean,botmean,allmean,q25
fn adapt_bg_stats(px:[]u8, E:[]u8, emed:i64, W:i64, H:i64, out:[]u8) void {
    let st:i64 = 0;
    let ct:i64 = 0;
    let sb:i64 = 0;
    let cb:i64 = 0;
    let sa:i64 = 0;
    let ca:i64 = 0;
    let hist:[]u8 = nio_alloc(2048);
    let i:i64 = 0;
    while (i < 256) { h_put64(hist, i * 8, 0); i = i + 1; }
    let y:i64 = 0;
    while (y < H) {
        let x:i64 = 0;
        while (x < W) {
            let p:i64 = y * W + x;
            if (h_get64(E, p * 8) < emed) {
                let o:i64 = p * 3;
                let g:i64 = ((px[o] as i64) + (px[o + 1] as i64) + (px[o + 2] as i64)) / 3;
                h_put64(hist, g * 8, h_get64(hist, g * 8) + 1);
                sa = sa + g;
                ca = ca + 1;
                if (y < H / 3) { st = st + g; ct = ct + 1; }
                if (y >= 2 * H / 3) { sb = sb + g; cb = cb + 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let top:i64 = 0;
    let bot:i64 = 0;
    let all:i64 = 0;
    if (ct > 0) { top = st / ct; }
    if (cb > 0) { bot = sb / cb; }
    if (ca > 0) { all = sa / ca; }
    let q25:i64 = seg_pct_bin(hist, 256, ca, 25);
    h_put64(out, 0, top);
    h_put64(out, 8, bot);
    h_put64(out, 16, all);
    h_put64(out, 24, q25);
    nio_free(hist);
}
// bilinear sample of src RGB at fixed-point (x256) -> r,g,b via out arena
fn bilin_px(src:[]u8, sw:i64, sh:i64, fx:i64, fy:i64, out:[]u8) void {
    let maxx:i64 = (sw - 1) * 256;
    let maxy:i64 = (sh - 1) * 256;
    if (fx < 0) { fx = 0; }
    if (fy < 0) { fy = 0; }
    if (fx > maxx) { fx = maxx; }
    if (fy > maxy) { fy = maxy; }
    let x0:i64 = fx / 256;
    let y0:i64 = fy / 256;
    let x1:i64 = x0 + 1;
    let y1:i64 = y0 + 1;
    if (x1 >= sw) { x1 = sw - 1; }
    if (y1 >= sh) { y1 = sh - 1; }
    let wx:i64 = fx - x0 * 256;
    let wy:i64 = fy - y0 * 256;
    let c:i64 = 0;
    while (c < 3) {
        let p00:i64 = ((y0 * sw + x0) * 3 + c) as i64;
        let p10:i64 = ((y0 * sw + x1) * 3 + c) as i64;
        let p01:i64 = ((y1 * sw + x0) * 3 + c) as i64;
        let p11:i64 = ((y1 * sw + x1) * 3 + c) as i64;
        let v00:i64 = src[p00] as i64;
        let v10:i64 = src[p10] as i64;
        let v01:i64 = src[p01] as i64;
        let v11:i64 = src[p11] as i64;
        let v:i64 = (v00 * (256 - wx) * (256 - wy) + v10 * wx * (256 - wy) + v01 * (256 - wx) * wy + v11 * wx * wy) / 65536;
        h_put64(out, c * 8, v);
        c = c + 1;
    }
}
// build graft RGB: bilinear donor bbox -> gw x gh. graft: []u8 gw*gh*3
fn graft_build_rgb(donor:[]u8, DW:i64, dx0:i64, dy0:i64, dw:i64, dh:i64, graft:[]u8, gw:i64, gh:i64) void {
    let tmp:[]u8 = nio_alloc(24);
    let gy:i64 = 0;
    while (gy < gh) {
        let gx:i64 = 0;
        while (gx < gw) {
            let fx:i64 = (gx * dw * 256) / gw + dx0 * 256;
            let fy:i64 = (gy * dh * 256) / gh + dy0 * 256;
            bilin_px(donor, DW, 240, fx, fy, tmp);
            let o:i64 = (gy * gw + gx) * 3;
            graft[o] = h_get64(tmp, 0) as u8;
            graft[o + 1] = h_get64(tmp, 8) as u8;
            graft[o + 2] = h_get64(tmp, 16) as u8;
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    nio_free(tmp);
}
// graft alpha: NN donor mask -> gw x gh, then 17x17 box blur -> 0..255
fn graft_build_alpha(dmask:[]u8, DW:i64, dx0:i64, dy0:i64, dw:i64, dh:i64, alpha:[]u8, gw:i64, gh:i64) void {
    let gy:i64 = 0;
    while (gy < gh) {
        let gx:i64 = 0;
        while (gx < gw) {
            let sx:i64 = dx0 + (gx * dw) / gw;
            let sy:i64 = dy0 + (gy * dh) / gh;
            if (sx >= DW) { sx = DW - 1; }
            if (sy >= 240) { sy = 239; }
            if (dmask[sy * DW + sx] != 0) { alpha[gy * gw + gx] = 255; } else { alpha[gy * gw + gx] = 0; }
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    let tmp:[]u8 = nio_alloc((gw * gh) as i32);
    let y:i64 = 0;
    while (y < gh) {
        let x:i64 = 0;
        while (x < gw) {
            let acc:i64 = 0;
            let cnt:i64 = 0;
            let dy:i64 = -8;
            while (dy <= 8) {
                let dx:i64 = -8;
                while (dx <= 8) {
                    let xx:i64 = x + dx;
                    let yy:i64 = y + dy;
                    if (xx >= 0) {
                        if (xx < gw) {
                            if (yy >= 0) {
                                if (yy < gh) {
                                    acc = acc + (alpha[yy * gw + xx] as i64);
                                    cnt = cnt + 1;
                                }
                            }
                        }
                    }
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            tmp[y * gw + x] = (acc / cnt) as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    let p:i64 = 0;
    while (p < gw * gh) { alpha[p] = tmp[p]; p = p + 1; }
    nio_free(tmp);
}
// apply per-channel gain (x1024) and vertical gradient (ratio x256) to graft
fn graft_gain_grad(graft:[]u8, gw:i64, gh:i64, gains:[]u8, ratio:i64) void {
    let gy:i64 = 0;
    while (gy < gh) {
        let f:i64 = 256 + (ratio - 256) * (gh / 2 - gy) / gh;
        let gx:i64 = 0;
        while (gx < gw) {
            let o:i64 = (gy * gw + gx) * 3;
            let c:i64 = 0;
            while (c < 3) {
                let v:i64 = graft[o + c] as i64;
                v = (v * h_get64(gains, c * 8)) / 1024;
                v = (v * f) / 256;
                if (v > 255) { v = 255; }
                graft[o + c] = v as u8;
                c = c + 1;
            }
            gx = gx + 1;
        }
        gy = gy + 1;
    }
}
// edge transfer: shift graft band pixels toward recipient band colors.
// returns shift via out arena (3 i64); also seam (x1) for self-check.
fn graft_edge_transfer(graft:[]u8, alpha:[]u8, gw:i64, gh:i64, pxR:[]u8, RW:i64, px:i64, py:i64, out:[]u8) i64 {
    let dr:i64 = 0;
    let dg:i64 = 0;
    let db:i64 = 0;
    let rr:i64 = 0;
    let rg:i64 = 0;
    let rb:i64 = 0;
    let c:i64 = 0;
    let seam:i64 = 0;
    let gy:i64 = 0;
    while (gy < gh) {
        let gx:i64 = 0;
        while (gx < gw) {
            let a:i64 = alpha[gy * gw + gx] as i64;
            if (a > 16) {
                if (a < 240) {
                    let o:i64 = (gy * gw + gx) * 3;
                    dr = dr + (graft[o] as i64);
                    dg = dg + (graft[o + 1] as i64);
                    db = db + (graft[o + 2] as i64);
                    let rx:i64 = px + gx;
                    let ry:i64 = py + gy;
                    if (rx >= 0) {
                        if (rx < RW) {
                            if (ry >= 0) {
                                if (ry < 240) {
                                    let ro:i64 = (ry * RW + rx) * 3;
                                    rr = rr + (pxR[ro] as i64);
                                    rg = rg + (pxR[ro + 1] as i64);
                                    rb = rb + (pxR[ro + 2] as i64);
                                    let dd:i64 = (graft[o] as i64) - (pxR[ro] as i64);
                                    if (dd < 0) { dd = 0 - dd; }
                                    let dd2:i64 = (graft[o + 1] as i64) - (pxR[ro + 1] as i64);
                                    if (dd2 < 0) { dd2 = 0 - dd2; }
                                    let dd3:i64 = (graft[o + 2] as i64) - (pxR[ro + 2] as i64);
                                    if (dd3 < 0) { dd3 = 0 - dd3; }
                                    seam = seam + (dd + dd2 + dd3) / 3;
                                    c = c + 1;
                                }
                            }
                        }
                    }
                }
            }
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    if (c == 0) { return -1; }
    let sh0:i64 = rr / c - dr / c;
    let sh1:i64 = rg / c - dg / c;
    let sh2:i64 = rb / c - db / c;
    h_put64(out, 0, sh0);
    h_put64(out, 8, sh1);
    h_put64(out, 16, sh2);
    h_put64(out, 24, seam / c);
    gy = 0;
    while (gy < gh) {
        let gx:i64 = 0;
        while (gx < gw) {
            let a:i64 = alpha[gy * gw + gx] as i64;
            let wgt:i64 = 255 - a;
            if (wgt > 0) {
                let o:i64 = (gy * gw + gx) * 3;
                let v0:i64 = (graft[o] as i64) + sh0 * wgt / 255;
                let v1:i64 = (graft[o + 1] as i64) + sh1 * wgt / 255;
                let v2:i64 = (graft[o + 2] as i64) + sh2 * wgt / 255;
                if (v0 < 0) { v0 = 0; }
                if (v0 > 255) { v0 = 255; }
                if (v1 < 0) { v1 = 0; }
                if (v1 > 255) { v1 = 255; }
                if (v2 < 0) { v2 = 0; }
                if (v2 > 255) { v2 = 255; }
                graft[o] = v0 as u8;
                graft[o + 1] = v1 as u8;
                graft[o + 2] = v2 as u8;
            }
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    return 0;
}
// alpha paste of graft onto frame at (px,py)
fn graft_paste(pxR:[]u8, graft:[]u8, alpha:[]u8, gw:i64, gh:i64, px:i64, py:i64, RW:i64, RH:i64) void {
    let gy:i64 = 0;
    while (gy < gh) {
        let ry:i64 = py + gy;
        if (ry >= 0) {
            if (ry < RH) {
                let gx:i64 = 0;
                while (gx < gw) {
                    let rx:i64 = px + gx;
                    if (rx >= 0) {
                        if (rx < RW) {
                            let a:i64 = alpha[gy * gw + gx] as i64;
                            if (a > 0) {
                                let o:i64 = (gy * gw + gx) * 3;
                                let ro:i64 = (ry * RW + rx) * 3;
                                let c:i64 = 0;
                                while (c < 3) {
                                    let gv:i64 = graft[o + c] as i64;
                                    let rv:i64 = pxR[ro + c] as i64;
                                    pxR[ro + c] = ((gv * a + rv * (255 - a)) / 255) as u8;
                                    c = c + 1;
                                }
                            }
                        }
                    }
                    gx = gx + 1;
                }
            }
        }
        gy = gy + 1;
    }
}
// contact shadow: darken band below graft; strength x256 (0..64)
fn graft_shadow(pxR:[]u8, px:i64, py:i64, gw:i64, gh:i64, strength:i64, RW:i64, RH:i64) void {
    let d:i64 = 0;
    while (d < 12) {
        let ry:i64 = py + gh + d;
        if (ry >= 0) {
            if (ry < RH) {
                let f:i64 = 256 - strength * (12 - d) / 12;
                let rx:i64 = px - 8;
                while (rx < px + gw + 8) {
                    if (rx >= 0) {
                        if (rx < RW) {
                            let ro:i64 = (ry * RW + rx) * 3;
                            let c:i64 = 0;
                            while (c < 3) {
                                let v:i64 = (pxR[ro + c] as i64) * f / 256;
                                pxR[ro + c] = v as u8;
                                c = c + 1;
                            }
                        }
                    }
                    rx = rx + 1;
                }
            }
        }
        d = d + 1;
    }
}

// ---------- fusion: candidate builder ----------
// cand arena (i64), 512 bytes:
// [0] c1_area [8] c1_x0 [16] c1_y0 [24] c1_x1 [32] c1_y1 [40] c1_cx [48] c1_cy
// [56] c1_mconc_x1e4 [64] c1_compact_x1e4 [72] c1_score
// [80..152] c2_* (same 10), [160..232] c3_*, [240] subj_id, [248] subj_score,
// [256] t_dark, [264] t_bright, [272] ethr, [280] totalE, [288] neck,
// [296] centrality_x1e4, [304] drift_y (filled later)
fn fuse_candidates(st:[]u8, E:[]u8, gray12:[]u8, W:i64, H:i64, m1:[]u8, m2:[]u8, m3:[]u8, cand:[]u8) i64 {
    let N:i64 = W * H;
    let nf:i64 = h_get64(st, 48);
    let totalE:i64 = 0;
    let p:i64 = 0;
    while (p < N) { totalE = totalE + h_get64(E, p * 8); p = p + 1; }
    h_put64(cand, 280, totalE);
    let lab:[]u8 = nio_alloc((N * 8) as i32);
    let tmp:[]u8 = nio_alloc(N as i32);
    let stats:[]u8 = nio_alloc(80);
    let tex:[]u8 = nio_alloc((N * 8) as i32);
    seg_texture(gray12, tex, W, H);
    // ---- C1: motion subject ----
    let histE:[]u8 = nio_alloc(8192);
    seg_histE(E, N, histE);
    let eb:i64 = seg_pct_bin(histE, 1024, N, 85);
    let ethr:i64 = eb * 4;
    h_put64(cand, 272, ethr);
    nio_free(histE);
    p = 0;
    while (p < N) {
        if (h_get64(E, p * 8) > ethr) { m1[p] = 1; } else { m1[p] = 0; }
        p = p + 1;
    }
    let n1:i64 = seg_label(m1, lab, W, H);
    let id1:i64 = seg_largest_id(lab, n1, W, H);
    let a1:i64 = seg_comp_stats(lab, n1, id1, gray12, E, tex, W, H, stats);
    h_put64(cand, 0, a1);
    h_put64(cand, 8, h_get64(stats, 8));
    h_put64(cand, 16, h_get64(stats, 16));
    h_put64(cand, 24, h_get64(stats, 24));
    h_put64(cand, 32, h_get64(stats, 32));
    h_put64(cand, 40, h_get64(stats, 40));
    h_put64(cand, 48, h_get64(stats, 48));
    let mc1:i64 = 0;
    let cp1:i64 = 0;
    if (a1 > 0) {
        if (totalE > 0) { mc1 = h_get64(stats, 64) * a1 * 10000 / totalE; }
        let bw:i64 = h_get64(stats, 24) - h_get64(stats, 8) + 1;
        let bh:i64 = h_get64(stats, 32) - h_get64(stats, 16) + 1;
        if (bw * bh > 0) { cp1 = a1 * 10000 / (bw * bh); }
    }
    h_put64(cand, 56, mc1);
    h_put64(cand, 64, cp1);
    h_put64(cand, 72, mc1 * cp1 / 10000);
    // ---- C2: dark quintile part ----
    let t20:i64 = seg_gray_pct(gray12, N, 20);
    h_put64(cand, 256, t20);
    seg_thresh(gray12, m2, N, t20, 1);
    seg_open(m2, tmp, W, H, 3);
    seg_fill_holes(m2, W, H);
    let n2:i64 = seg_label(m2, lab, W, H);
    let id2:i64 = seg_largest_id(lab, n2, W, H);
    let a2:i64 = seg_comp_stats(lab, n2, id2, gray12, E, tex, W, H, stats);
    p = 0;
    while (p < N) {
        if (h_get64(lab, p * 8) == id2) { m2[p] = 1; } else { m2[p] = 0; }
        p = p + 1;
    }
    h_put64(cand, 80, a2);
    h_put64(cand, 88, h_get64(stats, 8));
    h_put64(cand, 96, h_get64(stats, 16));
    h_put64(cand, 104, h_get64(stats, 24));
    h_put64(cand, 112, h_get64(stats, 32));
    h_put64(cand, 120, h_get64(stats, 40));
    h_put64(cand, 128, h_get64(stats, 48));
    let mc2:i64 = 0;
    let cp2:i64 = 0;
    if (a2 > 0) {
        if (totalE > 0) { mc2 = h_get64(stats, 64) * a2 * 10000 / totalE; }
        let bw:i64 = h_get64(stats, 24) - h_get64(stats, 8) + 1;
        let bh:i64 = h_get64(stats, 32) - h_get64(stats, 16) + 1;
        if (bw * bh > 0) { cp2 = a2 * 10000 / (bw * bh); }
    }
    h_put64(cand, 136, mc2);
    h_put64(cand, 144, cp2);
    h_put64(cand, 152, mc2 * cp2 / 10000);
    // ---- C3: bright quintile part ----
    let t80:i64 = seg_gray_pct(gray12, N, 80);
    h_put64(cand, 264, t80);
    seg_thresh(gray12, m3, N, t80, 0);
    seg_open(m3, tmp, W, H, 3);
    seg_fill_holes(m3, W, H);
    let n3:i64 = seg_label(m3, lab, W, H);
    let id3:i64 = seg_largest_id(lab, n3, W, H);
    let a3:i64 = seg_comp_stats(lab, n3, id3, gray12, E, tex, W, H, stats);
    p = 0;
    while (p < N) {
        if (h_get64(lab, p * 8) == id3) { m3[p] = 1; } else { m3[p] = 0; }
        p = p + 1;
    }
    h_put64(cand, 160, a3);
    h_put64(cand, 168, h_get64(stats, 8));
    h_put64(cand, 176, h_get64(stats, 16));
    h_put64(cand, 184, h_get64(stats, 24));
    h_put64(cand, 192, h_get64(stats, 32));
    h_put64(cand, 200, h_get64(stats, 40));
    h_put64(cand, 208, h_get64(stats, 48));
    let mc3:i64 = 0;
    let cp3:i64 = 0;
    if (a3 > 0) {
        if (totalE > 0) { mc3 = h_get64(stats, 64) * a3 * 10000 / totalE; }
        let bw:i64 = h_get64(stats, 24) - h_get64(stats, 8) + 1;
        let bh:i64 = h_get64(stats, 32) - h_get64(stats, 16) + 1;
        if (bw * bh > 0) { cp3 = a3 * 10000 / (bw * bh); }
    }
    h_put64(cand, 216, mc3);
    h_put64(cand, 224, cp3);
    h_put64(cand, 232, mc3 * cp3 / 10000);
    // ---- subject = argmax score ----
    let s1:i64 = h_get64(cand, 72);
    let s2:i64 = h_get64(cand, 152);
    let s3:i64 = h_get64(cand, 232);
    let sid:i64 = 1;
    let ss:i64 = s1;
    if (s2 > ss) { sid = 2; ss = s2; }
    if (s3 > ss) { sid = 3; ss = s3; }
    h_put64(cand, 240, sid);
    h_put64(cand, 248, ss);
    let scx:i64 = h_get64(cand, 40);
    let scy:i64 = h_get64(cand, 48);
    if (sid == 2) { scx = h_get64(cand, 120); scy = h_get64(cand, 128); }
    if (sid == 3) { scx = h_get64(cand, 200); scy = h_get64(cand, 208); }
    let dx:i64 = scx - W / 2;
    let dy:i64 = scy - H / 2;
    let dist:i64 = isqrt(dx * dx + dy * dy);
    h_put64(cand, 296, 400 * 10000 / (400 + dist));
    nio_free(lab);
    nio_free(tmp);
    nio_free(stats);
    nio_free(tex);
    return 0;
}
// mean band difference between graft and recipient (self-check metric)
fn band_diff(graft:[]u8, alpha:[]u8, gw:i64, gh:i64, pxR:[]u8, RW:i64, px:i64, py:i64) i64 {
    let acc:i64 = 0;
    let c:i64 = 0;
    let gy:i64 = 0;
    while (gy < gh) {
        let gx:i64 = 0;
        while (gx < gw) {
            let a:i64 = alpha[gy * gw + gx] as i64;
            if (a > 16) {
                if (a < 240) {
                    let rx:i64 = px + gx;
                    let ry:i64 = py + gy;
                    if (rx >= 0) {
                        if (rx < RW) {
                            if (ry >= 0) {
                                if (ry < 240) {
                                    let o:i64 = (gy * gw + gx) * 3;
                                    let ro:i64 = (ry * RW + rx) * 3;
                                    let d0:i64 = (graft[o] as i64) - (pxR[ro] as i64);
                                    if (d0 < 0) { d0 = 0 - d0; }
                                    let d1:i64 = (graft[o + 1] as i64) - (pxR[ro + 1] as i64);
                                    if (d1 < 0) { d1 = 0 - d1; }
                                    let d2:i64 = (graft[o + 2] as i64) - (pxR[ro + 2] as i64);
                                    if (d2 < 0) { d2 = 0 - d2; }
                                    acc = acc + (d0 + d1 + d2) / 3;
                                    c = c + 1;
                                }
                            }
                        }
                    }
                }
            }
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    if (c == 0) { return -1; }
    return acc / c;
}

// ---------- fusion: main orchestration ----------
fn do_fuse(workA:[]u8, workB:[]u8, instr:[]u8, outd:[]u8) i64 {
    let st0:[]u8 = load_store_full(workA);
    let st1:[]u8 = load_store_full(workB);
    ensure_dir(outd);
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { return -600; }
    let tr:[]u8 = nio_alloc(131072);
    let to:i64 = 0;
    to = tr_str(tr, to, "FUSE_ATTEMPT v1\nmechanism: fusion organ (segment/correspond/adapt/synthesize), pure Zag, zero RNG\n");
    let lab0:[]u8 = nio_alloc(64);
    let lab1:[]u8 = nio_alloc(64);
    let l0n:i64 = store_label(st0, lab0);
    let l1n:i64 = store_label(st1, lab1);
    let lab0s:[]u8 = lab0[0..l0n];
    let lab1s:[]u8 = lab1[0..l1n];
    let i:i64 = 0;
    while (i < l0n) { lab0[i] = to_lower(lab0[i]); i = i + 1; }
    i = 0;
    while (i < l1n) { lab1[i] = to_lower(lab1[i]); i = i + 1; }
    let W:i64 = h_get64(st0, 32);
    let H:i64 = h_get64(st0, 40);
    let nf:i64 = h_get64(st0, 48);
    if (W != 320 || H != 240 || h_get64(st1, 32) != 320 || h_get64(st1, 40) != 240 || h_get64(st1, 48) != nf || nf != 24) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: fusion requires two 320x240 24-frame videos.\n");
        write_buf(oroot, "fuse_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    if (l0n == l1n) {
        let same:i64 = 1;
        let k:i64 = 0;
        while (k < l0n) { if (lab0[k] != lab1[k]) { same = 0; } k = k + 1; }
        if (same == 1) {
            to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: both memories carry the same label.\n");
            write_buf(oroot, "fuse_refusal.txt", tr, to);
            nio_close(oroot);
            return 1;
        }
    }
    let n:i64 = instr.len;
    let cut:i64 = -1;
    i = 0;
    while (i < n) { if ((instr[i] as i64) == 47) { cut = i; } i = i + 1; }
    if (cut < 0) { return -620; }
    let iroot:i64 = nio_open_root(instr[0..cut]);
    if (iroot < 0) { return -621; }
    let ibuf:[]u8 = nio_alloc(4096);
    let ilen:i64 = read_file(iroot, instr[cut + 1..n], ibuf, 4096);
    nio_close(iroot);
    if (ilen < 0) { return -622; }
    let words:[]u8 = nio_alloc(256 * 16);
    let nw:i64 = tokenize(ibuf, ilen, words);
    let verb:i64 = detect_verb(ibuf, words, nw);
    let subj:[]u8 = nio_alloc(16);
    let ns:i64 = match_subjects(ibuf, words, nw, lab0s, lab1s, subj);
    to = tr_str(tr, to, "instruction: ");
    let ci:i64 = 0;
    while (ci < ilen) { tr[to + ci] = ibuf[ci]; ci = ci + 1; }
    to = to + ilen;
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "parse: verb=");
    let vn:[]u8 = nio_alloc(16);
    let vnl:i64 = verb_name(verb, vn);
    to = tr_str(tr, to, vn[0..vnl]);
    to = tr_str(tr, to, " subjects=[");
    let sj:i64 = 0;
    while (sj < ns) {
        if (sj > 0) { to = tr_str(tr, to, ","); }
        if (h_get64(subj, sj * 8) == 0) { to = tr_str(tr, to, lab0s); } else { to = tr_str(tr, to, lab1s); }
        sj = sj + 1;
    }
    to = tr_str(tr, to, "]");
    to = tr_nl(tr, to);
    if (verb != 1 || ns != 2) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: fusion needs a MERGE-class verb naming two distinct memorized subjects.\n");
        write_buf(oroot, "fuse_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    let N:i64 = W * H;
    to = tr_str(tr, to, "--- SEGMENT (strategies: C1=motion-subject, C2=dark-quintile, C3=bright-quintile; score=motion_conc*compactness x1e4) ---\n");
    let m:i64 = 0;
    let E0:[]u8 = nio_alloc((N * 8) as i32);
    let E1:[]u8 = nio_alloc((N * 8) as i32);
    let g0:[]u8 = nio_alloc(N as i32);
    let g1:[]u8 = nio_alloc(N as i32);
    let cnd0:[]u8 = nio_alloc(512);
    let cnd1:[]u8 = nio_alloc(512);
    let m10:[]u8 = nio_alloc(N as i32);
    let m20:[]u8 = nio_alloc(N as i32);
    let m30:[]u8 = nio_alloc(N as i32);
    let m11:[]u8 = nio_alloc(N as i32);
    let m21:[]u8 = nio_alloc(N as i32);
    let m31:[]u8 = nio_alloc(N as i32);
    let px12:[]u8 = nio_alloc(230400);
    while (m < 2) {
        let stm:[]u8 = st0;
        let Em:[]u8 = E0;
        let gm:[]u8 = g0;
        let cm:[]u8 = cnd0;
        let a1m:[]u8 = m10;
        let a2m:[]u8 = m20;
        let a3m:[]u8 = m30;
        let lm:[]u8 = lab0s;
        if (m == 1) {
            stm = st1; Em = E1; gm = g1; cm = cnd1;
            a1m = m11; a2m = m21; a3m = m31; lm = lab1s;
        }
        let rc:i64 = seg_motion_E(stm, Em, W, H, nf);
        if (rc != 0) { return -630 - m; }
        if (recall_frame(stm, 12, px12) != 0) { return -632 - m; }
        seg_gray(px12, gm, N);
        rc = fuse_candidates(stm, Em, gm, W, H, a1m, a2m, a3m, cm);
        if (rc != 0) { return -634 - m; }
        to = tr_str(tr, to, " mem=");
        to = tr_str(tr, to, lm);
        to = tr_str(tr, to, " ethr=");
        to = tr_i64(tr, to, h_get64(cm, 272));
        to = tr_str(tr, to, " t_dark=");
        to = tr_i64(tr, to, h_get64(cm, 256));
        to = tr_str(tr, to, " t_bright=");
        to = tr_i64(tr, to, h_get64(cm, 264));
        to = tr_nl(tr, to);
        let cc:i64 = 1;
        while (cc <= 3) {
            let bo:i64 = 0;
            if (cc == 2) { bo = 80; }
            if (cc == 3) { bo = 160; }
            to = tr_str(tr, to, "  C");
            to = tr_i64(tr, to, cc);
            to = tr_str(tr, to, ": area=");
            to = tr_i64(tr, to, h_get64(cm, bo));
            to = tr_str(tr, to, " bbox=(");
            to = tr_i64(tr, to, h_get64(cm, bo + 8));
            to = tr_str(tr, to, ",");
            to = tr_i64(tr, to, h_get64(cm, bo + 16));
            to = tr_str(tr, to, ")-(");
            to = tr_i64(tr, to, h_get64(cm, bo + 24));
            to = tr_str(tr, to, ",");
            to = tr_i64(tr, to, h_get64(cm, bo + 32));
            to = tr_str(tr, to, ") centroid=(");
            to = tr_i64(tr, to, h_get64(cm, bo + 40));
            to = tr_str(tr, to, ",");
            to = tr_i64(tr, to, h_get64(cm, bo + 48));
            to = tr_str(tr, to, ") mconc=");
            to = tr_i64(tr, to, h_get64(cm, bo + 56));
            to = tr_str(tr, to, " compact=");
            to = tr_i64(tr, to, h_get64(cm, bo + 64));
            to = tr_str(tr, to, " score=");
            to = tr_i64(tr, to, h_get64(cm, bo + 72));
            to = tr_nl(tr, to);
            cc = cc + 1;
        }
        to = tr_str(tr, to, "  subject=C");
        to = tr_i64(tr, to, h_get64(cm, 240));
        to = tr_str(tr, to, " score=");
        to = tr_i64(tr, to, h_get64(cm, 248));
        to = tr_str(tr, to, " centrality=");
        to = tr_i64(tr, to, h_get64(cm, 296));
        to = tr_nl(tr, to);
        m = m + 1;
    }
    to = tr_str(tr, to, "--- CORRESPOND (rule: recipient=argmax subject centrality; donor=other memory's subject) ---\n");
    let cent0:i64 = h_get64(cnd0, 296);
    let cent1:i64 = h_get64(cnd1, 296);
    let recip:i64 = 0;
    if (cent1 > cent0) { recip = 1; }
    to = tr_str(tr, to, " centrality: ");
    to = tr_str(tr, to, lab0s);
    to = tr_str(tr, to, "=");
    to = tr_i64(tr, to, cent0);
    to = tr_str(tr, to, " ");
    to = tr_str(tr, to, lab1s);
    to = tr_str(tr, to, "=");
    to = tr_i64(tr, to, cent1);
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " recipient=");
    if (recip == 0) { to = tr_str(tr, to, lab0s); } else { to = tr_str(tr, to, lab1s); }
    to = tr_str(tr, to, " (hosts the fusion: its subject is more central, more of a complete scene)");
    to = tr_nl(tr, to);
    let str_:[]u8 = st0;
    let std_:[]u8 = st1;
    let cndR:[]u8 = cnd0;
    let cndD:[]u8 = cnd1;
    let ER:[]u8 = E0;
    let ED:[]u8 = E1;
    let m1R:[]u8 = m10;
    let m2D:[]u8 = m21;
    let labRs:[]u8 = lab0s;
    let labDs:[]u8 = lab1s;
    if (recip == 1) {
        str_ = st1; std_ = st0; cndR = cnd1; cndD = cnd0;
        ER = E1; ED = E0; m1R = m11; m2D = m20;
        labRs = lab1s; labDs = lab0s;
    }
    to = tr_str(tr, to, " donor=");
    to = tr_str(tr, to, labDs);
    to = tr_str(tr, to, " part=its subject (already part-level under its own segmentation)");
    to = tr_nl(tr, to);
    if (h_get64(cndD, 240) != 2) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: donor subject is not the dark-part candidate; the head-graft reading does not hold on these measurements.\n");
        write_buf(oroot, "fuse_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    let donor_area:i64 = h_get64(cndD, 80);
    if (donor_area < 500) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: donor part too small (<500px); not a graftable part.\n");
        write_buf(oroot, "fuse_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    to = tr_str(tr, to, "--- SLOT (rule: split recipient subject by neck-line; slot=argmax texture*upperness) ---\n");
    let r_x0:i64 = h_get64(cndR, 8);
    let r_y0:i64 = h_get64(cndR, 16);
    let r_x1:i64 = h_get64(cndR, 24);
    let r_y1:i64 = h_get64(cndR, 32);
    let neck:i64 = seg_neck(ER, m1R, W, H, r_x0, r_x1, r_y0, r_y1);
    if (neck < 0) {
        neck = (r_y0 + r_y1) / 2;
        to = tr_str(tr, to, " neck: no valid motion peaks; fallback to subject vertical midpoint (recorded)\n");
    } else {
        to = tr_str(tr, to, " neck: min-motion row between top-2 motion peaks = ");
        to = tr_i64(tr, to, neck);
        to = tr_nl(tr, to);
    }
    let pxR12:[]u8 = nio_alloc(230400);
    let gR12:[]u8 = nio_alloc(N as i32);
    let texR:[]u8 = nio_alloc((N * 8) as i32);
    if (recall_frame(str_, 12, pxR12) != 0) { return -640; }
    seg_gray(pxR12, gR12, N);
    seg_texture(gR12, texR, W, H);
    let ha:i64 = 0;
    let hx0:i64 = W;
    let hy0:i64 = H;
    let hx1:i64 = -1;
    let hy1:i64 = -1;
    let hsx:i64 = 0;
    let hsy:i64 = 0;
    let htex:i64 = 0;
    let ba:i64 = 0;
    let btex:i64 = 0;
    let bsx:i64 = 0;
    let bsy:i64 = 0;
    let bx0:i64 = W;
    let by0:i64 = H;
    let bx1:i64 = -1;
    let by1:i64 = -1;
    let p2:i64 = 0;
    while (p2 < N) {
        if (m1R[p2] != 0) {
            let x:i64 = p2 % W;
            let y:i64 = p2 / W;
            let tx:i64 = h_get64(texR, p2 * 8);
            if (y < neck) {
                ha = ha + 1;
                hsx = hsx + x;
                hsy = hsy + y;
                htex = htex + tx;
                if (x < hx0) { hx0 = x; }
                if (x > hx1) { hx1 = x; }
                if (y < hy0) { hy0 = y; }
                if (y > hy1) { hy1 = y; }
            } else {
                ba = ba + 1;
                bsx = bsx + x;
                bsy = bsy + y;
                btex = btex + tx;
                if (x < bx0) { bx0 = x; }
                if (x > bx1) { bx1 = x; }
                if (y < by0) { by0 = y; }
                if (y > by1) { by1 = y; }
            }
        }
        p2 = p2 + 1;
    }
    let hcx:i64 = 0;
    let hcy:i64 = 0;
    let htx:i64 = 0;
    let hup:i64 = 0;
    if (ha > 0) {
        hcx = hsx / ha;
        hcy = hsy / ha;
        htx = htex / ha;
        hup = (H - hcy) * 10000 / H;
    }
    let bcx:i64 = 0;
    let bcy:i64 = 0;
    let btx:i64 = 0;
    let bup:i64 = 0;
    if (ba > 0) {
        bcx = bsx / ba;
        bcy = bsy / ba;
        btx = btex / ba;
        bup = (H - bcy) * 10000 / H;
    }
    let hscore:i64 = htx * hup / 10000;
    let bscore:i64 = btx * bup / 10000;
    to = tr_str(tr, to, " head: area=");
    to = tr_i64(tr, to, ha);
    to = tr_str(tr, to, " bbox=(");
    to = tr_i64(tr, to, hx0);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, hy0);
    to = tr_str(tr, to, ")-(");
    to = tr_i64(tr, to, hx1);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, hy1);
    to = tr_str(tr, to, ") tex=");
    to = tr_i64(tr, to, htx);
    to = tr_str(tr, to, " upper=");
    to = tr_i64(tr, to, hup);
    to = tr_str(tr, to, " score=");
    to = tr_i64(tr, to, hscore);
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " body: area=");
    to = tr_i64(tr, to, ba);
    to = tr_str(tr, to, " tex=");
    to = tr_i64(tr, to, btx);
    to = tr_str(tr, to, " upper=");
    to = tr_i64(tr, to, bup);
    to = tr_str(tr, to, " score=");
    to = tr_i64(tr, to, bscore);
    to = tr_nl(tr, to);
    let slx0:i64 = hx0;
    let sly0:i64 = hy0;
    let slx1:i64 = hx1;
    let sly1:i64 = hy1;
    if (bscore > hscore) {
        slx0 = bx0; sly0 = by0; slx1 = bx1; sly1 = by1;
        to = tr_str(tr, to, " slot=BODY (texture*upper won; recorded, unusual)\n");
    } else {
        to = tr_str(tr, to, " slot=HEAD (face proxy: highest texture*upperness)\n");
    }
    let slw:i64 = slx1 - slx0 + 1;
    let slh:i64 = sly1 - sly0 + 1;
    let perc:[]u8 = perc_alloc();
    if (perceive(str_, perc) != 0) { return -650; }
    let fc:i64 = h_get64(perc, 1616);
    let rcrect:[]u8 = nio_alloc(32);
    cell_rect(fc, W, H, rcrect);
    let ax:i64 = (h_get64(rcrect, 0) + h_get64(rcrect, 16)) / 2;
    let ay:i64 = (h_get64(rcrect, 8) + h_get64(rcrect, 24)) / 2;
    to = tr_str(tr, to, " anchor: saliency focus cell");
    to = tr_i64(tr, to, fc);
    to = tr_str(tr, to, " rect=(");
    to = tr_i64(tr, to, h_get64(rcrect, 0));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(rcrect, 8));
    to = tr_str(tr, to, ")-(");
    to = tr_i64(tr, to, h_get64(rcrect, 16));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(rcrect, 24));
    to = tr_str(tr, to, ") center=(");
    to = tr_i64(tr, to, ax);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, ay);
    to = tr_str(tr, to, ")");
    to = tr_nl(tr, to);
    let dx0:i64 = h_get64(cndD, 88);
    let dy0:i64 = h_get64(cndD, 96);
    let dx1:i64 = h_get64(cndD, 104);
    let dy1:i64 = h_get64(cndD, 112);
    let dw:i64 = dx1 - dx0 + 1;
    let dh:i64 = dy1 - dy0 + 1;
    let dcx:i64 = h_get64(cndD, 120);
    let dcy:i64 = h_get64(cndD, 128);
    let scale:i64 = slw * 256 / dw;
    let gw:i64 = slw;
    let gh:i64 = dh * scale / 256;
    to = tr_str(tr, to, " geometry: donor bbox=(");
    to = tr_i64(tr, to, dx0);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, dy0);
    to = tr_str(tr, to, ")-(");
    to = tr_i64(tr, to, dx1);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, dy1);
    to = tr_str(tr, to, ") slot=(");
    to = tr_i64(tr, to, slx0);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, sly0);
    to = tr_str(tr, to, ")-(");
    to = tr_i64(tr, to, slx1);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, sly1);
    to = tr_str(tr, to, ") scale=x");
    to = tr_fp2(tr, to, scale * 100 / 256);
    to = tr_str(tr, to, " (width-matched, proportions preserved) graft=");
    to = tr_i64(tr, to, gw);
    to = tr_str(tr, to, "x");
    to = tr_i64(tr, to, gh);
    to = tr_nl(tr, to);
    let pxD12:[]u8 = nio_alloc(230400);
    if (recall_frame(std_, 12, pxD12) != 0) { return -660; }
    let dmean:[]u8 = nio_alloc(24);
    let rmean:[]u8 = nio_alloc(24);
    if (adapt_means_masked(pxD12, m2D, W, H, dmean) != 0) { return -661; }
    if (adapt_means_rect(pxR12, slx0, sly0, slx1, sly1, W, rmean) != 0) { return -662; }
    let gains:[]u8 = nio_alloc(24);
    let gc:i64 = 0;
    let clamped:i64 = 0;
    while (gc < 3) {
        let dm:i64 = h_get64(dmean, gc * 8);
        let rm:i64 = h_get64(rmean, gc * 8);
        let g:i64 = 1024;
        if (dm > 0) { g = rm * 1024 / dm; }
        if (g < 512) { g = 512; clamped = 1; }
        if (g > 3072) { g = 3072; clamped = 1; }
        h_put64(gains, gc * 8, g);
        gc = gc + 1;
    }
    let histE2:[]u8 = nio_alloc(8192);
    seg_histE(ER, N, histE2);
    let emed:i64 = seg_pct_bin(histE2, 1024, N, 50) * 4;
    nio_free(histE2);
    let bgst:[]u8 = nio_alloc(32);
    adapt_bg_stats(pxR12, ER, emed, W, H, bgst);
    let bgtop:i64 = h_get64(bgst, 0);
    let bgbot:i64 = h_get64(bgst, 8);
    let bgall:i64 = h_get64(bgst, 16);
    let bgq25:i64 = h_get64(bgst, 24);
    let ratio:i64 = 256;
    if (bgbot > 0) { ratio = bgtop * 256 / bgbot; }
    let contrast:i64 = 0;
    if (bgall > 0) { contrast = (bgall - bgq25) * 100 / bgall; }
    let shstrength:i64 = contrast * 256 / 100 / 3;
    if (shstrength > 64) { shstrength = 64; }
    if (shstrength < 0) { shstrength = 0; }
    to = tr_str(tr, to, "--- ADAPT ---\n");
    to = tr_str(tr, to, " gain: donor_mean=(");
    to = tr_i64(tr, to, h_get64(dmean, 0));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(dmean, 8));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(dmean, 16));
    to = tr_str(tr, to, ") recip_mean=(");
    to = tr_i64(tr, to, h_get64(rmean, 0));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(rmean, 8));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(rmean, 16));
    to = tr_str(tr, to, ") gains_x1024=(");
    to = tr_i64(tr, to, h_get64(gains, 0));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(gains, 8));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(gains, 16));
    to = tr_str(tr, to, ") clamped=");
    to = tr_i64(tr, to, clamped);
    to = tr_str(tr, to, " (clamp [0.5,3.0] preserves donor identity: the darkness is the part's own color; residual gap is reported, not hidden)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " gradient: bg_top=");
    to = tr_i64(tr, to, bgtop);
    to = tr_str(tr, to, " bg_bot=");
    to = tr_i64(tr, to, bgbot);
    to = tr_str(tr, to, " ratio_x256=");
    to = tr_i64(tr, to, ratio);
    to = tr_str(tr, to, " (scene light tilt applied to graft)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " shadow: bg_q25=");
    to = tr_i64(tr, to, bgq25);
    to = tr_str(tr, to, " contrast%=");
    to = tr_i64(tr, to, contrast);
    to = tr_str(tr, to, " strength_x256=");
    to = tr_i64(tr, to, shstrength);
    to = tr_nl(tr, to);
    let graft:[]u8 = nio_alloc((gw * gh * 3) as i32);
    let alpha:[]u8 = nio_alloc((gw * gh) as i32);
    graft_build_rgb(pxD12, W, dx0, dy0, dw, dh, graft, gw, gh);
    graft_build_alpha(m2D, W, dx0, dy0, dw, dh, alpha, gw, gh);
    let refpx:i64 = ax - gw / 2;
    let refpy:i64 = ay - gh / 2;
    let seam_before:i64 = band_diff(graft, alpha, gw, gh, pxR12, W, refpx, refpy);
    graft_gain_grad(graft, gw, gh, gains, ratio);
    let etr:[]u8 = nio_alloc(32);
    if (graft_edge_transfer(graft, alpha, gw, gh, pxR12, W, refpx, refpy, etr) != 0) { return -670; }
    let seam_after:i64 = band_diff(graft, alpha, gw, gh, pxR12, W, refpx, refpy);
    to = tr_str(tr, to, " edge_transfer: shift=(");
    to = tr_i64(tr, to, h_get64(etr, 0));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(etr, 8));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(etr, 16));
    to = tr_str(tr, to, ") feather=17x17 box (8px ramp)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " seam: raw=");
    to = tr_i64(tr, to, seam_before);
    to = tr_str(tr, to, " after_gain+edge=");
    to = tr_i64(tr, to, seam_after);
    to = tr_str(tr, to, " (mean |graft-recipient| in blend band, gray levels)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "--- TRACK (donor track = part-selection evidence; the graft replaces the recipient's head, so it rides the recipient head's motion, not the donor's) ---\n");
    let tdx0:i64 = dx0 - 40;
    let tdy0:i64 = dy0 - 40;
    let tdx1:i64 = dx1 + 40;
    let tdy1:i64 = dy1 + 40;
    if (tdx0 < 0) { tdx0 = 0; }
    if (tdy0 < 0) { tdy0 = 0; }
    if (tdx1 >= W) { tdx1 = W - 1; }
    if (tdy1 >= H) { tdy1 = H - 1; }
    let trk:[]u8 = nio_alloc(24 * 16);
    if (seg_track(std_, h_get64(cndD, 256), tdx0, tdy0, tdx1, tdy1, W, H, nf, trk) != 0) { return -680; }
    let drf:[]u8 = nio_alloc(16);
    seg_drift_range(trk, nf, 12, drf);
    h_put64(cndD, 304, h_get64(drf, 8));
    to = tr_str(tr, to, " donor thr=");
    to = tr_i64(tr, to, h_get64(cndD, 256));
    to = tr_str(tr, to, " ref_centroid=(");
    to = tr_i64(tr, to, h_get64(trk, 12 * 16));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(trk, 12 * 16 + 8));
    to = tr_str(tr, to, ") drift_x=");
    to = tr_i64(tr, to, h_get64(drf, 0));
    to = tr_str(tr, to, " drift_y=");
    to = tr_i64(tr, to, h_get64(drf, 8));
    to = tr_nl(tr, to);
    let trkR:[]u8 = nio_alloc(24 * 16);
    if (seg_track(str_, 0 - 200, slx0, sly0, slx1, sly1, W, H, nf, trkR) != 0) { return -681; }
    let drfR:[]u8 = nio_alloc(16);
    seg_drift_range(trkR, nf, 12, drfR);
    to = tr_str(tr, to, " recipient face drift_x=");
    to = tr_i64(tr, to, h_get64(drfR, 0));
    to = tr_str(tr, to, " drift_y=");
    to = tr_i64(tr, to, h_get64(drfR, 8));
    to = tr_str(tr, to, " (bright pixels in slot ROI; the graft follows this motion: it IS the recipient's head now)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "--- SYNTHESIZE (24 frames) ---\n");
    let fr:[]u8 = nio_alloc(230400);
    let nm:[]u8 = nio_alloc(16);
    let f:i64 = 0;
    while (f < nf) {
        if (recall_frame(str_, f, fr) != 0) { return -690 - f; }
        // the graft replaces the recipient's head: follow the recipient head's motion
        let ocx:i64 = h_get64(trkR, f * 16);
        let ocy:i64 = h_get64(trkR, f * 16 + 8);
        let rX:i64 = h_get64(trkR, 12 * 16);
        let rY:i64 = h_get64(trkR, 12 * 16 + 8);
        let ppx:i64 = refpx;
        let ppy:i64 = refpy;
        if (ocx >= 0) {
            ppx = refpx + (ocx - rX);
            ppy = refpy + (ocy - rY);
        }
        graft_paste(fr, graft, alpha, gw, gh, ppx, ppy, W, H);
        graft_shadow(fr, ppx, ppy, gw, gh, shstrength, W, H);
        let nl:i64 = mk_frame_name(nm, f);
        if (write_ppm(oroot, nm[0..nl], fr, W, H) != 0) { return -700 - f; }
        let fh:i64 = fnv(fr, 0, N * 3);
        if (f == 0 || f == 12 || f == 23) {
            to = tr_str(tr, to, " f=");
            to = tr_i64(tr, to, f);
            to = tr_str(tr, to, " paste=(");
            to = tr_i64(tr, to, ppx);
            to = tr_str(tr, to, ",");
            to = tr_i64(tr, to, ppy);
            to = tr_str(tr, to, ") H_F=");
            to = tr_hex(tr, to, fh);
            to = tr_nl(tr, to);
        }
        f = f + 1;
    }
    to = tr_str(tr, to, "--- SELF_CHECK ---\n");
    to = tr_str(tr, to, " unhandled: pose (donor head pitched down-left vs recipient frontal; no pose normalization in the plan language)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " unhandled: per-frame donor appearance (graft uses the f12 donor pose for all 24 frames; the donor's bob is selection evidence, not rendered motion)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " unhandled: recipient ears outside graft (bunny ears remain; the graft covers the face)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " RESULT: FUSION_COMPLETE seam_raw=");
    to = tr_i64(tr, to, seam_before);
    to = tr_str(tr, to, " seam_adapted=");
    to = tr_i64(tr, to, seam_after);
    to = tr_nl(tr, to);
    let tnm:[]u8 = nio_alloc(32);
    let tl:i64 = mk_trace_name(tnm, "fuse");
    let trc:i64 = write_buf(oroot, tnm[0..tl], tr, to);
    nio_close(oroot);
    nio_free(E0); nio_free(E1); nio_free(g0); nio_free(g1);
    nio_free(cnd0); nio_free(cnd1);
    nio_free(m10); nio_free(m20); nio_free(m30);
    nio_free(m11); nio_free(m21); nio_free(m31);
    nio_free(px12); nio_free(pxR12); nio_free(gR12); nio_free(texR);
    nio_free(perc); nio_free(rcrect);
    nio_free(pxD12); nio_free(dmean); nio_free(rmean); nio_free(gains);
    nio_free(bgst); nio_free(graft); nio_free(alpha); nio_free(etr);
    nio_free(trk); nio_free(drf); nio_free(trkR); nio_free(drfR);
    nio_free(fr); nio_free(nm); nio_free(tnm); nio_free(tr);
    nio_free(lab0); nio_free(lab1); nio_free(ibuf); nio_free(words);
    nio_free(subj); nio_free(vn);
    nio_free(st0); nio_free(st1);
    if (trc != 0) { return -799; }
    return 0;
}
// ==================== V4A: stabilized alignment + donor anatomy ====================
// TNN deliberates its own stabilization from measured shake (not assumed):
// per-pair global translation via half-res quadrant block matching on the
// stillest quadrant (background-dominated by measurement). Residual shake is
// measured; if stabilization does not reduce it, TNN falls back to
// unstabilized (all traced by the orchestrator).
//
// The donor head is segmented by ANATOMY, not by a fixed dark-segment bbox:
//   facing  = away from the adjacent white body (measured per frame)
//   snout   = argmax projection of the dark mask along facing
//   neck    = width-profile constriction behind the skull (prominence >= 1.3)
//   head    = snout-connected dark region in front of the neck cut,
//             minus the motion-distinct leg (stabilized-motion leg split)
// All tables live in []u8 LE arenas (ZNC-2026-09-21-007: never as []i32).

fn v4_half_gray(px:[]u8, hg:[]u8) void {
    let y:i64 = 0;
    while (y < 120) {
        let x:i64 = 0;
        while (x < 160) {
            let s:i64 = 0;
            let dy:i64 = 0;
            while (dy < 2) {
                let dx:i64 = 0;
                while (dx < 2) {
                    let o:i64 = ((y * 2 + dy) * 320 + x * 2 + dx) * 3;
                    s = s + (px[o] as i64) + (px[o + 1] as i64) + (px[o + 2] as i64);
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            hg[y * 160 + x] = (s / 12) as u8;
            x = x + 1;
        }
        y = y + 1;
    }
}

// mean |h0-h1| over half-res quadrant q (0=TL,1=TR,2=BL,3=BR; each 80x60)
fn v4_quad_energy(h0:[]u8, h1:[]u8, q:i64) i64 {
    let x0:i64 = 0;
    let y0:i64 = 0;
    if (q == 1) { x0 = 80; }
    if (q == 2) { y0 = 60; }
    if (q == 3) { x0 = 80; y0 = 60; }
    let s:i64 = 0;
    let y:i64 = 0;
    while (y < 60) {
        let x:i64 = 0;
        while (x < 80) {
            let d:i64 = (h0[(y0 + y) * 160 + x0 + x] as i64) - (h1[(y0 + y) * 160 + x0 + x] as i64);
            if (d < 0) { d = 0 - d; }
            s = s + d;
            x = x + 1;
        }
        y = y + 1;
    }
    return s / 4800;
}

// Block-match quadrant q between h0 and h1, search R=8 half-px.
// out[16]: dx,dy (half-px) minimizing |h0[y,x]-h1[y+dy,x+dx]| over the
// interior 44x64 window (so the shifted window never leaves the quadrant).
fn v4_quad_shift(h0:[]u8, h1:[]u8, q:i64, out:[]u8) void {
    let x0:i64 = 0;
    let y0:i64 = 0;
    if (q == 1) { x0 = 80; }
    if (q == 2) { y0 = 60; }
    if (q == 3) { x0 = 80; y0 = 60; }
    let bdx:i64 = 0;
    let bdy:i64 = 0;
    let bs:i64 = -1;
    let dy:i64 = -8;
    while (dy <= 8) {
        let dx:i64 = -8;
        while (dx <= 8) {
            let s:i64 = 0;
            let y:i64 = 8;
            while (y < 52) {
                let x:i64 = 8;
                while (x < 72) {
                    let a:i64 = h0[(y0 + y) * 160 + x0 + x] as i64;
                    let b:i64 = h1[(y0 + y + dy) * 160 + x0 + x + dx] as i64;
                    let d:i64 = a - b;
                    if (d < 0) { d = 0 - d; }
                    s = s + d;
                    x = x + 1;
                }
                y = y + 1;
            }
            if (bs < 0 || s < bs) { bs = s; bdx = dx; bdy = dy; }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    h_put64(out, 0, bdx);
    h_put64(out, 8, bdy);
}

// Measure per-pair camera translation. shifts[(nf-1)*16]: dx,dy FULL-res px
// (half-px shift * 2). dbg[(nf-1)*16]: stillest quadrant, its energy.
// Convention: (dx,dy) minimizes |h_f - h_{f+1} shifted by (dx,dy)|, i.e. the
// translation that aligns frame f+1 onto frame f.
fn v4_shake(st:[]u8, nf:i64, shifts:[]u8, dbg:[]u8) i64 {
    let h0:[]u8 = nio_alloc(19200);
    let h1:[]u8 = nio_alloc(19200);
    let fr:[]u8 = nio_alloc(230400);
    let sh:[]u8 = nio_alloc(16);
    if (recall_frame(st, 0, fr) != 0) { return -700; }
    v4_half_gray(fr, h0);
    let f:i64 = 0;
    let i:i64 = 0;
    while (f < nf - 1) {
        if (recall_frame(st, f + 1, fr) != 0) { return -701; }
        v4_half_gray(fr, h1);
        let bq:i64 = 0;
        let be:i64 = -1;
        let q:i64 = 0;
        while (q < 4) {
            let e:i64 = v4_quad_energy(h0, h1, q);
            if (be < 0 || e < be) { be = e; bq = q; }
            q = q + 1;
        }
        v4_quad_shift(h0, h1, bq, sh);
        h_put64(shifts, f * 16, h_get64(sh, 0) * 2);
        h_put64(shifts, f * 16 + 8, h_get64(sh, 8) * 2);
        h_put64(dbg, f * 16, bq);
        h_put64(dbg, f * 16 + 8, be);
        i = 0;
        while (i < 19200) { h0[i] = h1[i]; i = i + 1; }
        f = f + 1;
    }
    nio_free(h0);
    nio_free(h1);
    nio_free(fr);
    nio_free(sh);
    return 0;
}

// Cumulative shift: cum[f] = total translation aligning frame f onto frame 0.
fn v4_cumul(shifts:[]u8, nf:i64, cum:[]u8) void {
    h_put64(cum, 0, 0);
    h_put64(cum, 8, 0);
    let f:i64 = 0;
    while (f < nf - 1) {
        h_put64(cum, (f + 1) * 16, h_get64(cum, f * 16) + h_get64(shifts, f * 16));
        h_put64(cum, (f + 1) * 16 + 8, h_get64(cum, f * 16 + 8) + h_get64(shifts, f * 16 + 8));
        f = f + 1;
    }
}

// Stabilized frame f into out (RGB): out[y,x] = in[clamp(y+cy),clamp(x+cx)]
// with (cx,cy)=cum[f]; i.e. the image is shifted by -cum[f] so camera motion
// is cancelled and the pig's own motion remains. Edge-replicated.
fn v4_stable_frame(st:[]u8, f:i64, cum:[]u8, W:i64, H:i64, out:[]u8) i64 {
    let fr:[]u8 = nio_alloc(230400);
    if (recall_frame(st, f, fr) != 0) { nio_free(fr); return -702; }
    let cx:i64 = h_get64(cum, f * 16);
    let cy:i64 = h_get64(cum, f * 16 + 8);
    let y:i64 = 0;
    while (y < H) {
        let sy:i64 = y + cy;
        if (sy < 0) { sy = 0; }
        if (sy >= H) { sy = H - 1; }
        let x:i64 = 0;
        while (x < W) {
            let sx:i64 = x + cx;
            if (sx < 0) { sx = 0; }
            if (sx >= W) { sx = W - 1; }
            let o:i64 = (y * W + x) * 3;
            let so:i64 = (sy * W + sx) * 3;
            out[o] = fr[so];
            out[o + 1] = fr[so + 1];
            out[o + 2] = fr[so + 2];
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fr);
    return 0;
}

// Stabilized motion energy: sum over pairs of |stable(f+1)-stable(f)|, x4
// fixed (same units as seg_motion_E). Camera shake is cancelled; what
// remains is the subject's own motion.
fn v4_stable_E(st:[]u8, cum:[]u8, E:[]u8, W:i64, H:i64, nf:i64) i64 {
    let N:i64 = W * H;
    let g0:[]u8 = nio_alloc(76800);
    let g1:[]u8 = nio_alloc(76800);
    let s0:[]u8 = nio_alloc(230400);
    let s1:[]u8 = nio_alloc(230400);
    let p:i64 = 0;
    while (p < N) { h_put64(E, p * 8, 0); p = p + 1; }
    if (v4_stable_frame(st, 0, cum, W, H, s0) != 0) { return -703; }
    seg_gray(s0, g0, N);
    let f:i64 = 0;
    let q:i64 = 0;
    while (f < nf - 1) {
        if (v4_stable_frame(st, f + 1, cum, W, H, s1) != 0) { return -704; }
        seg_gray(s1, g1, N);
        q = 0;
        while (q < N) {
            let d:i64 = (g1[q] as i64) - (g0[q] as i64);
            if (d < 0) { d = 0 - d; }
            h_put64(E, q * 8, h_get64(E, q * 8) + d * 4);
            g0[q] = g1[q];
            q = q + 1;
        }
        let t:[]u8 = s0;
        s0 = s1;
        s1 = t;
        f = f + 1;
    }
    nio_free(g0);
    nio_free(g1);
    nio_free(s0);
    nio_free(s1);
    return 0;
}

// Dark/white largest components of stable frame f.
// dm/wm: N-byte 0/1 masks. dst arena (10 qwords each):
//   dst[0..9]:  dark area,x0,y0,x1,y1,cx,cy,mean_gray,td(thr),valid
//   dst[10..19]: white area,x0,y0,x1,y1,cx,cy,mean_gray,tw(thr),valid
// valid=1 iff area >= 500 and bbox touches no frame edge (not clipped).
fn v4_dw_one(st:[]u8, f:i64, cum:[]u8, W:i64, H:i64, dm:[]u8, wm:[]u8, dst:[]u8) i64 {
    let N:i64 = W * H;
    let sf:[]u8 = nio_alloc(230400);
    if (v4_stable_frame(st, f, cum, W, H, sf) != 0) { nio_free(sf); return -705; }
    let gr:[]u8 = nio_alloc(76800);
    seg_gray(sf, gr, N);
    let td:i64 = seg_gray_pct(gr, N, 20);
    let tw:i64 = seg_gray_pct(gr, N, 80);
    let tmp:[]u8 = nio_alloc(76800);
    let lab:[]u8 = nio_alloc(614400);
    let ez:[]u8 = nio_alloc(614400);
    let cs:[]u8 = nio_alloc(80);
    let p:i64 = 0;
    while (p < N) { h_put64(ez, p * 8, 0); p = p + 1; }
    // dark
    seg_thresh(gr, tmp, N, td, 1);
    seg_open(tmp, dm, W, H, 2);
    seg_fill_holes(dm, W, H);
    let nd:i64 = seg_label(dm, lab, W, H);
    let did:i64 = seg_largest_id(lab, nd, W, H);
    let dv:i64 = 0;
    if (did > 0) {
        if (seg_comp_stats(lab, nd, did, gr, ez, ez, W, H, cs) != 0) {
            let da:i64 = h_get64(cs, 0);
            p = 0;
            while (p < N) { if (h_get64(lab, p * 8) == did) { dm[p] = 1; } else { dm[p] = 0; } p = p + 1; }
            dv = 0;
            if (da >= 500) {
                dv = 1;
                if (h_get64(cs, 8) <= 0 || h_get64(cs, 16) <= 0 || h_get64(cs, 24) >= W - 1 || h_get64(cs, 32) >= H - 1) { dv = 0; }
            }
            h_put64(dst, 0, da);
            h_put64(dst, 8, h_get64(cs, 8));
            h_put64(dst, 16, h_get64(cs, 16));
            h_put64(dst, 24, h_get64(cs, 24));
            h_put64(dst, 32, h_get64(cs, 32));
            h_put64(dst, 40, h_get64(cs, 40));
            h_put64(dst, 48, h_get64(cs, 48));
            h_put64(dst, 56, h_get64(cs, 56));
            h_put64(dst, 64, td);
            h_put64(dst, 72, dv);
        }
    }
    if (dv == 0) {
        p = 0;
        while (p < N) { dm[p] = 0; p = p + 1; }
        let k:i64 = 0;
        while (k < 10) { h_put64(dst, k * 8, 0); k = k + 1; }
    }
    // white
    seg_thresh(gr, tmp, N, tw, 0);
    seg_open(tmp, wm, W, H, 2);
    seg_fill_holes(wm, W, H);
    let nw:i64 = seg_label(wm, lab, W, H);
    let wid:i64 = seg_largest_id(lab, nw, W, H);
    let wv:i64 = 0;
    if (wid > 0) {
        if (seg_comp_stats(lab, nw, wid, gr, ez, ez, W, H, cs) != 0) {
            let wa:i64 = h_get64(cs, 0);
            p = 0;
            while (p < N) { if (h_get64(lab, p * 8) == wid) { wm[p] = 1; } else { wm[p] = 0; } p = p + 1; }
            wv = 0;
            if (wa >= 500) {
                wv = 1;
                if (h_get64(cs, 8) <= 0 || h_get64(cs, 16) <= 0 || h_get64(cs, 24) >= W - 1 || h_get64(cs, 32) >= H - 1) { wv = 0; }
            }
            h_put64(dst, 80, wa);
            h_put64(dst, 88, h_get64(cs, 8));
            h_put64(dst, 96, h_get64(cs, 16));
            h_put64(dst, 104, h_get64(cs, 24));
            h_put64(dst, 112, h_get64(cs, 32));
            h_put64(dst, 120, h_get64(cs, 40));
            h_put64(dst, 128, h_get64(cs, 48));
            h_put64(dst, 136, h_get64(cs, 56));
            h_put64(dst, 144, tw);
            h_put64(dst, 152, wv);
        }
    }
    if (wv == 0) {
        p = 0;
        while (p < N) { wm[p] = 0; p = p + 1; }
        let k2:i64 = 0;
        while (k2 < 10) { h_put64(dst, (10 + k2) * 8, 0); k2 = k2 + 1; }
    }
    nio_free(sf);
    nio_free(gr);
    nio_free(tmp);
    nio_free(lab);
    nio_free(ez);
    nio_free(cs);
    return 0;
}

// Facing: unit vector (x1024) pointing from the white-body centroid to the
// dark centroid (the head end is away from the body). out[16]: fx, fy.
// Returns 0, or -1 if either part invalid.
fn v4_facing(dst:[]u8, out:[]u8) i64 {
    if (h_get64(dst, 72) == 0 || h_get64(dst, 152) == 0) { return -1; }
    let dx:i64 = h_get64(dst, 40) - h_get64(dst, 120);
    let dy:i64 = h_get64(dst, 48) - h_get64(dst, 128);
    // isqrt via integer Newton
    let l2:i64 = dx * dx + dy * dy;
    if (l2 <= 0) { return -1; }
    let r:i64 = l2;
    let q:i64 = 0;
    while (q < 40) {
        let nr:i64 = (r + l2 / r) / 2;
        if (nr >= r) { break; }
        r = nr;
        q = q + 1;
    }
    // hmm: Newton from r=l2 converges downward; guard r>0
    if (r <= 0) { return -1; }
    h_put64(out, 0, dx * 1024 / r);
    h_put64(out, 8, dy * 1024 / r);
    return 0;
}

// Snout: dark-mask pixel maximizing projection along facing (foremost point).
// Ties broken by (min y, min x): deterministic. out[24]: sx, sy, spro(x1024).
fn v4_snout(dm:[]u8, fx:i64, fy:i64, W:i64, H:i64, out:[]u8) void {
    let N:i64 = W * H;
    let have:i64 = 0;
    let bs:i64 = 0;
    let bx:i64 = 0;
    let by:i64 = 0;
    let p:i64 = 0;
    while (p < N) {
        if (dm[p] != 0) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            let s:i64 = x * fx + y * fy;
            if (have == 0 || s > bs || (s == bs && (y < by || (y == by && x < bx)))) {
                have = 1;
                bs = s;
                bx = x;
                by = y;
            }
        }
        p = p + 1;
    }
    h_put64(out, 0, bx);
    h_put64(out, 8, by);
    h_put64(out, 16, bs);
}

// Width-profile neck detection along the facing axis from the snout.
// out (8 qwords): rc(0=found,1=none), d_neck, d_skull, skull_w, neck_w,
//                 prominence x1024, d_max, facing_len_px.
// The neck is the first local width minimum BEHIND the skull (global max)
// with skull/neck prominence >= 1.3. Deliberative standard, traced.
fn v4_neckcut(dm:[]u8, sx:i64, sy:i64, fx:i64, fy:i64, W:i64, H:i64, out:[]u8) void {
    let N:i64 = W * H;
    let px:i64 = 0 - fy;
    let py:i64 = fx;
    let cnt:[]u8 = nio_alloc(1024);
    let tmn:[]u8 = nio_alloc(1024);
    let tmx:[]u8 = nio_alloc(1024);
    let wid:[]u8 = nio_alloc(1024);
    let b:i64 = 0;
    while (b < 128) {
        h_put64(cnt, b * 8, 0);
        h_put64(wid, b * 8, -1);
        b = b + 1;
    }
    let dmax:i64 = 0;
    let p:i64 = 0;
    while (p < N) {
        if (dm[p] != 0) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            let dx:i64 = x - sx;
            let dy:i64 = y - sy;
            let bd:i64 = 0 - (dx * fx + dy * fy) / 1024;
            if (bd < 0) { bd = 0; }
            let t:i64 = (dx * px + dy * py) / 1024;
            let bin:i64 = bd / 4;
            if (bin > 127) { bin = 127; }
            if (bd > dmax) { dmax = bd; }
            let c:i64 = h_get64(cnt, bin * 8);
            if (c == 0) {
                h_put64(tmn, bin * 8, t);
                h_put64(tmx, bin * 8, t);
            } else {
                if (t < h_get64(tmn, bin * 8)) { h_put64(tmn, bin * 8, t); }
                if (t > h_get64(tmx, bin * 8)) { h_put64(tmx, bin * 8, t); }
            }
            h_put64(cnt, bin * 8, c + 1);
        }
        p = p + 1;
    }
    b = 0;
    while (b < 128) {
        if (h_get64(cnt, b * 8) >= 8) {
            h_put64(wid, b * 8, h_get64(tmx, b * 8) - h_get64(tmn, b * 8));
        }
        b = b + 1;
    }
    let sk:i64 = -1;
    let skw:i64 = 0;
    b = 0;
    while (b < 128) {
        let w:i64 = h_get64(wid, b * 8);
        if (w > skw) { skw = w; sk = b; }
        b = b + 1;
    }
    h_put64(out, 0, 1);
    h_put64(out, 8, -1);
    h_put64(out, 16, -1);
    h_put64(out, 24, 0);
    h_put64(out, 32, 0);
    h_put64(out, 40, 0);
    h_put64(out, 48, dmax);
    h_put64(out, 56, 0);
    if (sk >= 0) {
        h_put64(out, 16, sk * 4 + 2);
        h_put64(out, 24, skw);
        b = sk + 1;
        while (b < 127) {
            let w0:i64 = h_get64(wid, b * 8);
            if (w0 > 0 && h_get64(cnt, b * 8) >= 5) {
                let wl:i64 = h_get64(wid, (b - 1) * 8);
                let wr:i64 = h_get64(wid, (b + 1) * 8);
                let ismin:i64 = 1;
                if (wl >= 0 && w0 > wl) { ismin = 0; }
                if (wr >= 0 && w0 > wr) { ismin = 0; }
                if (ismin == 1 && skw * 1024 / w0 >= 1331) {
                    h_put64(out, 0, 0);
                    h_put64(out, 8, b * 4 + 2);
                    h_put64(out, 32, w0);
                    h_put64(out, 40, skw * 1024 / w0);
                    b = 127;
                }
            }
            b = b + 1;
        }
    }
    nio_free(cnt);
    nio_free(tmn);
    nio_free(tmx);
    nio_free(wid);
}

// Head region: snout-connected dark pixels with bd <= d_cut, minus the
// motion-distinct leg. Leg split: a connected high-motion component not
// containing the snout, with bbox aspect >= 2.5 and area >= 200, is a limb.
// out_mask: N bytes. out (10 qwords): area,x0,y0,x1,y1,legsplit(0=none,
// 1=split,2=head-invalid),leg_area,snout_E(x4),leg_thresh(x4).
fn v4_head_region(dm:[]u8, Es:[]u8, sx:i64, sy:i64, fx:i64, fy:i64, d_cut:i64, noise:i64, W:i64, H:i64, out_mask:[]u8, out:[]u8) void {
    let N:i64 = W * H;
    let front:[]u8 = nio_alloc(76800);
    let p:i64 = 0;
    while (p < N) {
        front[p] = 0;
        if (dm[p] != 0) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            let bd:i64 = 0 - ((x - sx) * fx + (y - sy) * fy) / 1024;
            if (bd <= d_cut) { front[p] = 1; }
        }
        p = p + 1;
    }
    let lab:[]u8 = nio_alloc(614400);
    seg_label(front, lab, W, H);
    let sp:i64 = sy * W + sx;
    let sid:i64 = 0;
    if (sp >= 0 && sp < N) { sid = h_get64(lab, sp * 8); }
    let head0:[]u8 = nio_alloc(76800);
    p = 0;
    while (p < N) {
        if (sid > 0 && h_get64(lab, p * 8) == sid) { head0[p] = 1; } else { head0[p] = 0; }
        p = p + 1;
    }
    nio_free(lab);
    nio_free(front);
    let snE:i64 = 0;
    if (sp >= 0 && sp < N) { snE = h_get64(Es, sp * 8); }
    let lthr:i64 = snE * 3 / 2;
    let lthr2:i64 = snE + 3 * noise;
    if (lthr2 > lthr) { lthr = lthr2; }
    let leg:[]u8 = nio_alloc(76800);
    p = 0;
    while (p < N) {
        leg[p] = 0;
        if (head0[p] != 0 && h_get64(Es, p * 8) > lthr) { leg[p] = 1; }
        p = p + 1;
    }
    let leglab:[]u8 = nio_alloc(614400);
    let nl:i64 = seg_label(leg, leglab, W, H);
    let snleg:i64 = 0;
    if (sp >= 0 && sp < N) { snleg = h_get64(leglab, sp * 8); }
    // per-component bbox for leg components
    let larea:[]u8 = nio_alloc(2048);
    let lbx0:[]u8 = nio_alloc(2048);
    let lby0:[]u8 = nio_alloc(2048);
    let lbx1:[]u8 = nio_alloc(2048);
    let lby1:[]u8 = nio_alloc(2048);
    let c:i64 = 0;
    while (c <= nl && c < 256) {
        h_put64(larea, c * 8, 0);
        h_put64(lbx0, c * 8, W);
        h_put64(lby0, c * 8, H);
        h_put64(lbx1, c * 8, -1);
        h_put64(lby1, c * 8, -1);
        c = c + 1;
    }
    p = 0;
    while (p < N) {
        let lid:i64 = h_get64(leglab, p * 8);
        if (lid > 0 && lid < 256) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            h_put64(larea, lid * 8, h_get64(larea, lid * 8) + 1);
            if (x < h_get64(lbx0, lid * 8)) { h_put64(lbx0, lid * 8, x); }
            if (x > h_get64(lbx1, lid * 8)) { h_put64(lbx1, lid * 8, x); }
            if (y < h_get64(lby0, lid * 8)) { h_put64(lby0, lid * 8, y); }
            if (y > h_get64(lby1, lid * 8)) { h_put64(lby1, lid * 8, y); }
        }
        p = p + 1;
    }
    // which leg components are limbs? (not snout's, aspect>=2.5, area>=200)
    let islimb:[]u8 = nio_alloc(2048);
    c = 0;
    while (c <= nl && c < 256) {
        h_put64(islimb, c * 8, 0);
        if (c > 0 && c != snleg) {
            let a:i64 = h_get64(larea, c * 8);
            if (a >= 200) {
                let w:i64 = h_get64(lbx1, c * 8) - h_get64(lbx0, c * 8) + 1;
                let h:i64 = h_get64(lby1, c * 8) - h_get64(lby0, c * 8) + 1;
                let big:i64 = w;
                let sml:i64 = h;
                if (h > w) { big = h; sml = w; }
                if (sml > 0 && big * 10 / sml >= 25) { h_put64(islimb, c * 8, 1); }
            }
        }
        c = c + 1;
    }
    let area:i64 = 0;
    let x0:i64 = W;
    let y0:i64 = H;
    let x1:i64 = -1;
    let y1:i64 = -1;
    let legrem:i64 = 0;
    let split:i64 = 0;
    p = 0;
    while (p < N) {
        out_mask[p] = 0;
        if (head0[p] != 0) {
            let lid2:i64 = h_get64(leglab, p * 8);
            if (lid2 > 0 && lid2 < 256 && h_get64(islimb, lid2 * 8) == 1) {
                legrem = legrem + 1;
                split = 1;
            } else {
                out_mask[p] = 1;
                area = area + 1;
                let x2:i64 = p % W;
                let y2:i64 = p / W;
                if (x2 < x0) { x0 = x2; }
                if (x2 > x1) { x1 = x2; }
                if (y2 < y0) { y0 = y2; }
                if (y2 > y1) { y1 = y2; }
            }
        }
        p = p + 1;
    }
    // head must still contain the snout and be >= 500 px
    let valid:i64 = 1;
    if (sp < 0 || sp >= N || out_mask[sp] == 0) { valid = 0; }
    if (area < 500) { valid = 0; }
    if (valid == 0) { split = 2; }
    h_put64(out, 0, area);
    h_put64(out, 8, x0);
    h_put64(out, 16, y0);
    h_put64(out, 24, x1);
    h_put64(out, 32, y1);
    h_put64(out, 40, split);
    h_put64(out, 48, legrem);
    h_put64(out, 56, snE);
    h_put64(out, 64, lthr);
    h_put64(out, 72, valid);
    nio_free(head0);
    nio_free(leg);
    nio_free(leglab);
    nio_free(larea);
    nio_free(lbx0);
    nio_free(lby0);
    nio_free(lbx1);
    nio_free(lby1);
    nio_free(islimb);
}
// ==================== V4B: identity-preserving photometric transfer ====================
// TNN's deliberation: the donor is BLACK and the slot is WHITE. The 6x gap is
// mostly ALBEDO (material), not illumination (the bright-reference ratio is
// only ~1.2x). So TNN does NOT do a blind 6x gain. It proposes candidates,
// checks white-box identity gates (monotonicity, texture correlation,
// chroma preservation), and selects by seam. Identity = rank + local
// contrast + chromaticity, NOT absolute albedo (the merge instruction forces
// the albedo to adapt; a white pig head is still a pig head).
//
// Candidates:
//   T1: linear gain 3.0 (step-3's clamp, baseline for comparison)
//   T2: linear gain I (illumination ratio, the honest lighting correction)
//   T3: linear gain 2I (deliberate over-correction probe)
//   T4: quantile luminance remap (nonlinear, rank-preserving, full adaptation)
// All scale RGB uniformly -> chromaticity (r/g, b/g) is preserved by construction.

// Bright reference: mean luminance of the largest bright (>=80th pct)
// component of a (possibly stabilized) frame. For the donor this is the
// white body in the donor's light.
fn v4_bright_ref(st:[]u8, f:i64, cum:[]u8, W:i64, H:i64, out:[]u8) i64 {
    let N:i64 = W * H;
    let dm:[]u8 = nio_alloc(76800);
    let wm:[]u8 = nio_alloc(76800);
    let dst:[]u8 = nio_alloc(160);
    if (v4_dw_one(st, f, cum, W, H, dm, wm, dst) != 0) { return -720; }
    h_put64(out, 0, h_get64(dst, 136));
    h_put64(out, 8, h_get64(dst, 152));
    h_put64(out, 16, h_get64(dst, 144));
    nio_free(dm);
    nio_free(wm);
    nio_free(dst);
    return 0;
}

// 256-bin luminance histogram of masked pixels. hist: 256 qwords.
fn v4_lum_hist(px:[]u8, mask:[]u8, w:i64, h:i64, hist:[]u8) void {
    let i:i64 = 0;
    while (i < 256) { h_put64(hist, i * 8, 0); i = i + 1; }
    let p:i64 = 0;
    let n:i64 = w * h;
    while (p < n) {
        if (mask[p] != 0) {
            let r:i64 = px[p * 3] as i64;
            let g:i64 = px[p * 3 + 1] as i64;
            let b:i64 = px[p * 3 + 2] as i64;
            let l:i64 = (r * 299 + g * 587 + b * 114) / 1000;
            h_put64(hist, l * 8, h_get64(hist, l * 8) + 1);
        }
        p = p + 1;
    }
}

// Quantile LUT: donor CDF -> slot CDF. lut[256] bytes. Monotonic by construction.
fn v4_quant_lut(dhist:[]u8, shist:[]u8, lut:[]u8) void {
    let dc:[]u8 = nio_alloc(2048);
    let sc:[]u8 = nio_alloc(2048);
    let s:i64 = 0;
    let i:i64 = 0;
    while (i < 256) {
        s = s + h_get64(dhist, i * 8);
        h_put64(dc, i * 8, s);
        i = i + 1;
    }
    s = 0;
    i = 0;
    while (i < 256) {
        s = s + h_get64(shist, i * 8);
        h_put64(sc, i * 8, s);
        i = i + 1;
    }
    let dt:i64 = h_get64(dc, 255 * 8);
    let st:i64 = h_get64(sc, 255 * 8);
    i = 0;
    while (i < 256) {
        let want:i64 = 0;
        if (dt > 0) { want = h_get64(dc, i * 8) * st; }
        let sl:i64 = 0;
        while (sl < 256) {
            if (dt <= 0 || h_get64(sc, sl * 8) * dt >= want) { break; }
            sl = sl + 1;
        }
        if (sl > 255) { sl = 255; }
        lut[i] = sl as u8;
        i = i + 1;
    }
    nio_free(dc);
    nio_free(sc);
}

// 1 iff lut is non-decreasing (monotonicity gate).
fn v4_lut_monotonic(lut:[]u8) i64 {
    let i:i64 = 1;
    while (i < 256) {
        if ((lut[i] as i64) < (lut[i - 1] as i64)) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Linear gain apply: out = clamp(px * gain/1024), masked pixels only.
fn v4_gain_apply(px:[]u8, mask:[]u8, w:i64, h:i64, gain:i64, out:[]u8) void {
    let p:i64 = 0;
    let n:i64 = w * h;
    while (p < n) {
        let c:i64 = 0;
        while (c < 3) {
            let v:i64 = px[p * 3 + c] as i64;
            if (mask[p] != 0) {
                v = v * gain / 1024;
                if (v > 255) { v = 255; }
            }
            out[p * 3 + c] = v as u8;
            c = c + 1;
        }
        p = p + 1;
    }
}

// Quantile apply: lum' = lut[lum]; out = px * lum'/lum (chromaticity preserved).
// If lum==0, out = (lum',lum',lum') (achromatic lift, still monotonic).
fn v4_quant_apply(px:[]u8, mask:[]u8, w:i64, h:i64, lut:[]u8, out:[]u8) void {
    let p:i64 = 0;
    let n:i64 = w * h;
    while (p < n) {
        let r:i64 = px[p * 3] as i64;
        let g:i64 = px[p * 3 + 1] as i64;
        let b:i64 = px[p * 3 + 2] as i64;
        if (mask[p] != 0) {
            let l:i64 = (r * 299 + g * 587 + b * 114) / 1000;
            let lp:i64 = lut[l] as i64;
            if (l > 0) {
                r = r * lp / l;
                g = g * lp / l;
                b = b * lp / l;
                if (r > 255) { r = 255; }
                if (g > 255) { g = 255; }
                if (b > 255) { b = 255; }
            } else {
                r = lp;
                g = lp;
                b = lp;
            }
        }
        out[p * 3] = r as u8;
        out[p * 3 + 1] = g as u8;
        out[p * 3 + 2] = b as u8;
        p = p + 1;
    }
}

// Gradient-magnitude Pearson correlation (x1024) between a and b over the
// mask eroded by 1px (boundary-safe). Identity gate: texture preserved.
fn v4_tex_corr(a:[]u8, b:[]u8, mask:[]u8, w:i64, h:i64) i64 {
    let n:i64 = 0;
    let sa:i64 = 0;
    let sb:i64 = 0;
    // first pass: means (eroded mask)
    let y:i64 = 1;
    while (y < h - 1) {
        let x:i64 = 1;
        while (x < w - 1) {
            let p:i64 = y * w + x;
            if (mask[p] != 0 && mask[p - 1] != 0 && mask[p + 1] != 0 && mask[p - w] != 0 && mask[p + w] != 0) {
                let ar:i64 = a[p * 3] as i64;
                let ag:i64 = a[p * 3 + 1] as i64;
                let ab:i64 = a[p * 3 + 2] as i64;
                let br:i64 = b[p * 3] as i64;
                let bg:i64 = b[p * 3 + 1] as i64;
                let bb:i64 = b[p * 3 + 2] as i64;
                let al:i64 = (ar * 299 + ag * 587 + ab * 114) / 1000;
                let bl:i64 = (br * 299 + bg * 587 + bb * 114) / 1000;
                // gradient magnitude via right/down neighbors (masked)
                let p2:i64 = p + 1;
                let p3:i64 = p + w;
                let ar2:i64 = a[p2 * 3] as i64;
                let ag2:i64 = a[p2 * 3 + 1] as i64;
                let ab2:i64 = a[p2 * 3 + 2] as i64;
                let ar3:i64 = a[p3 * 3] as i64;
                let ag3:i64 = a[p3 * 3 + 1] as i64;
                let ab3:i64 = a[p3 * 3 + 2] as i64;
                let al2:i64 = (ar2 * 299 + ag2 * 587 + ab2 * 114) / 1000;
                let al3:i64 = (ar3 * 299 + ag3 * 587 + ab3 * 114) / 1000;
                let ga:i64 = al2 - al;
                if (ga < 0) { ga = 0 - ga; }
                let ga2:i64 = al3 - al;
                if (ga2 < 0) { ga2 = 0 - ga2; }
                ga = ga + ga2;
                let br2:i64 = b[p2 * 3] as i64;
                let bg2:i64 = b[p2 * 3 + 1] as i64;
                let bb2:i64 = b[p2 * 3 + 2] as i64;
                let br3:i64 = b[p3 * 3] as i64;
                let bg3:i64 = b[p3 * 3 + 1] as i64;
                let bb3:i64 = b[p3 * 3 + 2] as i64;
                let bl2:i64 = (br2 * 299 + bg2 * 587 + bb2 * 114) / 1000;
                let bl3:i64 = (br3 * 299 + bg3 * 587 + bb3 * 114) / 1000;
                let gb:i64 = bl2 - bl;
                if (gb < 0) { gb = 0 - gb; }
                let gb2:i64 = bl3 - bl;
                if (gb2 < 0) { gb2 = 0 - gb2; }
                gb = gb + gb2;
                sa = sa + ga;
                sb = sb + gb;
                n = n + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (n < 50) { return 0; }
    let ma:i64 = sa / n;
    let mb:i64 = sb / n;
    // second pass: cov and variances. Recompute gradients (memory over code).
    let cov:i64 = 0;
    let va:i64 = 0;
    let vb:i64 = 0;
    y = 1;
    while (y < h - 1) {
        let x:i64 = 1;
        while (x < w - 1) {
            let p:i64 = y * w + x;
            if (mask[p] != 0 && mask[p - 1] != 0 && mask[p + 1] != 0 && mask[p - w] != 0 && mask[p + w] != 0) {
                let ar:i64 = a[p * 3] as i64;
                let ag:i64 = a[p * 3 + 1] as i64;
                let ab:i64 = a[p * 3 + 2] as i64;
                let al:i64 = (ar * 299 + ag * 587 + ab * 114) / 1000;
                let br:i64 = b[p * 3] as i64;
                let bg:i64 = b[p * 3 + 1] as i64;
                let bb:i64 = b[p * 3 + 2] as i64;
                let bl:i64 = (br * 299 + bg * 587 + bb * 114) / 1000;
                let p2:i64 = p + 1;
                let p3:i64 = p + w;
                let al2:i64 = ((a[p2 * 3] as i64) * 299 + (a[p2 * 3 + 1] as i64) * 587 + (a[p2 * 3 + 2] as i64) * 114) / 1000;
                let al3:i64 = ((a[p3 * 3] as i64) * 299 + (a[p3 * 3 + 1] as i64) * 587 + (a[p3 * 3 + 2] as i64) * 114) / 1000;
                let ga:i64 = al2 - al;
                if (ga < 0) { ga = 0 - ga; }
                let t:i64 = al3 - al;
                if (t < 0) { t = 0 - t; }
                ga = ga + t;
                let bl2:i64 = ((b[p2 * 3] as i64) * 299 + (b[p2 * 3 + 1] as i64) * 587 + (b[p2 * 3 + 2] as i64) * 114) / 1000;
                let bl3:i64 = ((b[p3 * 3] as i64) * 299 + (b[p3 * 3 + 1] as i64) * 587 + (b[p3 * 3 + 2] as i64) * 114) / 1000;
                let gb:i64 = bl2 - bl;
                if (gb < 0) { gb = 0 - gb; }
                t = bl3 - bl;
                if (t < 0) { t = 0 - t; }
                gb = gb + t;
                let da:i64 = ga - ma;
                let db:i64 = gb - mb;
                cov = cov + da * db;
                va = va + da * da;
                vb = vb + db * db;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (va <= 0 || vb <= 0) { return 0; }
    let denom:i64 = v4_isqrt(va * vb / n);
    if (denom <= 0) { return 0; }
    // r = (cov/n) / (sqrt(va/n)*sqrt(vb/n)) = cov / sqrt(va*vb)
    // x1024: r = cov*1024 / sqrt(va*vb)
    let sq:i64 = v4_isqrt(va * vb);
    if (sq <= 0) { return 0; }
    return cov * 1024 / sq;
}

// Chroma drift: mean |d(r/g)| + |d(b/g)| (x1024) between a and b over mask.
// Both candidates scale RGB uniformly, so this should be ~0 by construction.
fn v4_chroma_drift(a:[]u8, b:[]u8, mask:[]u8, w:i64, h:i64) i64 {
    let n:i64 = 0;
    let s:i64 = 0;
    let p:i64 = 0;
    let nn:i64 = w * h;
    while (p < nn) {
        if (mask[p] != 0) {
            let ar:i64 = a[p * 3] as i64;
            let ag:i64 = a[p * 3 + 1] as i64;
            let ab:i64 = a[p * 3 + 2] as i64;
            let br:i64 = b[p * 3] as i64;
            let bg:i64 = b[p * 3 + 1] as i64;
            let bb:i64 = b[p * 3 + 2] as i64;
            if (ag > 4 && bg > 4) {
                let d1:i64 = ar * 1024 / ag - br * 1024 / bg;
                let d2:i64 = ab * 1024 / ag - bb * 1024 / bg;
                if (d1 < 0) { d1 = 0 - d1; }
                if (d2 < 0) { d2 = 0 - d2; }
                s = s + d1 + d2;
                n = n + 1;
            }
        }
        p = p + 1;
    }
    if (n == 0) { return 0; }
    return s / n;
}

// Seam: mean |graft - recipient| (gray) over boundary pixels
// (mask=1 with a 4-neighbor mask=0). Same units as step-3's seam.
fn v4_seam(graft:[]u8, mask:[]u8, recip:[]u8, w:i64, h:i64) i64 {
    let n:i64 = 0;
    let s:i64 = 0;
    let y:i64 = 1;
    while (y < h - 1) {
        let x:i64 = 1;
        while (x < w - 1) {
            let p:i64 = y * w + x;
            if (mask[p] != 0 && (mask[p - 1] == 0 || mask[p + 1] == 0 || mask[p - w] == 0 || mask[p + w] == 0)) {
                let gr:i64 = graft[p * 3] as i64;
                let gg:i64 = graft[p * 3 + 1] as i64;
                let gb:i64 = graft[p * 3 + 2] as i64;
                let gl:i64 = (gr * 299 + gg * 587 + gb * 114) / 1000;
                let rr:i64 = recip[p * 3] as i64;
                let rg:i64 = recip[p * 3 + 1] as i64;
                let rb:i64 = recip[p * 3 + 2] as i64;
                let rl:i64 = (rr * 299 + rg * 587 + rb * 114) / 1000;
                let d:i64 = gl - rl;
                if (d < 0) { d = 0 - d; }
                s = s + d;
                n = n + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (n == 0) { return 999999; }
    return s / n;
}

// Fraction (x1024) of masked pixels with any channel at 255 (clipped).
fn v4_clip_frac(px:[]u8, mask:[]u8, w:i64, h:i64) i64 {
    let n:i64 = 0;
    let c:i64 = 0;
    let p:i64 = 0;
    let nn:i64 = w * h;
    while (p < nn) {
        if (mask[p] != 0) {
            n = n + 1;
            if ((px[p * 3] as i64) == 255 || (px[p * 3 + 1] as i64) == 255 || (px[p * 3 + 2] as i64) == 255) { c = c + 1; }
        }
        p = p + 1;
    }
    if (n == 0) { return 0; }
    return c * 1024 / n;
}
// ==================== V4C: pose normalization (measured landmarks) ====================
// TNN aligns the donor head to the recipient slot from MEASURED landmarks:
// mask centroids, principal axes (eigenvectors via closed form, no trig),
// and axis lengths. It tries similarity vs anisotropic scaling, selects by
// warped-mask IoU with an extreme-stretch veto. The 180-degree axis flip is
// resolved by the snout-inside-slot test. All in the plan language
// (translation / rotation / scale), all traced by the orchestrator.

fn v4_isqrt(x:i64) i64 {
    if (x <= 0) { return 0; }
    let r:i64 = x;
    let q:i64 = 0;
    while (q < 60) {
        let nr:i64 = (r + x / r) / 2;
        if (nr >= r) { break; }
        r = nr;
        q = q + 1;
    }
    return r;
}

// Moments of a 0/1 mask. out (10 qwords): n, cx, cy (x1024), cxx, cyy,
// cxy (x1024, centered), x0, y0, x1, y1.
fn v4_moments(mask:[]u8, W:i64, H:i64, out:[]u8) void {
    let N:i64 = W * H;
    let n:i64 = 0;
    let sx:i64 = 0;
    let sy:i64 = 0;
    let x0:i64 = W;
    let y0:i64 = H;
    let x1:i64 = -1;
    let y1:i64 = -1;
    let p:i64 = 0;
    while (p < N) {
        if (mask[p] != 0) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            n = n + 1;
            sx = sx + x;
            sy = sy + y;
            if (x < x0) { x0 = x; }
            if (x > x1) { x1 = x; }
            if (y < y0) { y0 = y; }
            if (y > y1) { y1 = y; }
        }
        p = p + 1;
    }
    h_put64(out, 0, n);
    h_put64(out, 48, x0);
    h_put64(out, 56, y0);
    h_put64(out, 64, x1);
    h_put64(out, 72, y1);
    if (n == 0) {
        h_put64(out, 8, 0);
        h_put64(out, 16, 0);
        h_put64(out, 24, 0);
        h_put64(out, 32, 0);
        h_put64(out, 40, 0);
        return;
    }
    let cx:i64 = sx * 1024 / n;
    let cy:i64 = sy * 1024 / n;
    h_put64(out, 8, cx);
    h_put64(out, 16, cy);
    let sxx:i64 = 0;
    let syy:i64 = 0;
    let sxy:i64 = 0;
    p = 0;
    while (p < N) {
        if (mask[p] != 0) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            let dx:i64 = x * 1024 - cx;
            let dy:i64 = y * 1024 - cy;
            sxx = sxx + dx * dx / 1024;
            syy = syy + dy * dy / 1024;
            sxy = sxy + dx * dy / 1024;
        }
        p = p + 1;
    }
    // sxx is x(1024^2); cxx x1024 = sxx / (n*1024)
    h_put64(out, 24, sxx / (n * 1024));
    h_put64(out, 32, syy / (n * 1024));
    h_put64(out, 40, sxy / (n * 1024));
}

// Principal eigenvector of [[cxx,cxy],[cxy,cyy]] (all x1024).
// out[32]: vx, vy (x1024 unit), lam1, lam2 (x1024, lam1>=lam2).
fn v4_eigenvec(cxx:i64, cxy:i64, cyy:i64, out:[]u8) void {
    let tr:i64 = cxx + cyy;
    let det:i64 = (cxx * cyy - cxy * cxy) / 1024;
    let disc:i64 = tr * tr / 1024 - 4 * det;
    if (disc < 0) { disc = 0; }
    let sq:i64 = v4_isqrt(disc * 1024);
    let lam1:i64 = (tr + sq) / 2;
    let lam2:i64 = (tr - sq) / 2;
    let vx:i64 = cxy;
    let vy:i64 = lam1 - cxx;
    // The axis is undirected; fix a canonical sign for determinism:
    // vx>0, or (vx==0 and vy>0). The 180-degree flip is tried explicitly
    // by the caller via the snout-inside-slot test.
    if (vx == 0 && vy == 0) {
        if (cxx >= cyy) { vx = 1024; vy = 0; } else { vx = 0; vy = 1024; }
    } else {
        // canonical: first nonzero of (vx,vy) positive... use: vx>0 or (vx==0 and vy>0)
        if (vx < 0 || (vx == 0 && vy < 0)) { vx = 0 - vx; vy = 0 - vy; }
    }
    let ln:i64 = v4_isqrt(vx * vx + vy * vy);
    if (ln > 0) {
        vx = vx * 1024 / ln;
        vy = vy * 1024 / ln;
    } else {
        vx = 1024;
        vy = 0;
    }
    h_put64(out, 0, vx);
    h_put64(out, 8, vy);
    h_put64(out, 16, lam1);
    h_put64(out, 24, lam2);
}

// Inverse affine slot->donor. A = s1*(us x ud) + s2*(usp x udp) (x1024).
// Ainv = adj(A)/det, x1024. out[48]: Ainv00,Ainv01,Ainv10,Ainv11,det(x1024),rc.
// rc=0 ok; rc=1 degenerate (det too small). rc lives at byte 40 (aligned);
// the old offset-36 write overlapped det@32 AND ran past a 40-byte arena.
fn v4_ainv(usx:i64, usy:i64, udx:i64, udy:i64, s1:i64, s2:i64, out:[]u8) void {
    let uspx:i64 = 0 - usy;
    let uspy:i64 = usx;
    let udpx:i64 = 0 - udy;
    let udpy:i64 = udx;
    let t1x:i64 = s1 * usx / 1024;
    let t1y:i64 = s1 * usy / 1024;
    let t2x:i64 = s2 * uspx / 1024;
    let t2y:i64 = s2 * uspy / 1024;
    let A00:i64 = (t1x * udx + t2x * udpx) / 1024;
    let A01:i64 = (t1x * udy + t2x * udpy) / 1024;
    let A10:i64 = (t1y * udx + t2y * udpx) / 1024;
    let A11:i64 = (t1y * udy + t2y * udpy) / 1024;
    let det:i64 = (A00 * A11 - A01 * A10) / 1024;
    h_put64(out, 32, det);
    if (det > -10 && det < 10) {
        h_put64(out, 40, 1);
        return;
    }
    // adj = [[A11,-A01],[-A10,A00]]; Ainv = adj*1024/det
    h_put64(out, 0, A11 * 1024 / det);
    h_put64(out, 8, (0 - A01) * 1024 / det);
    h_put64(out, 16, (0 - A10) * 1024 / det);
    h_put64(out, 24, A00 * 1024 / det);
    h_put64(out, 40, 0);
}

// Warp the donor (stable frame + head mask) into the slot bbox.
// For each slot-bbox pixel q: p = dc + Ainv*(q - sc); bilinear sample.
// out_px: w*h*3 RGB; out_m: w*h mask (nearest). w=sx1-sx0+1, h=sy1-sy0+1.
fn v4_warp(sdonor:[]u8, donor_mask:[]u8, W:i64, H:i64, Ainv:[]u8, dcx1024:i64, dcy1024:i64, scx:i64, scy:i64, sx0:i64, sy0:i64, sx1:i64, sy1:i64, out_px:[]u8, out_m:[]u8) void {
    let a00:i64 = h_get64(Ainv, 0);
    let a01:i64 = h_get64(Ainv, 8);
    let a10:i64 = h_get64(Ainv, 16);
    let a11:i64 = h_get64(Ainv, 24);
    let qy:i64 = sy0;
    while (qy <= sy1) {
        let qx:i64 = sx0;
        while (qx <= sx1) {
            let rx:i64 = qx - scx;
            let ry:i64 = qy - scy;
            let px1024:i64 = dcx1024 + a00 * rx + a01 * ry;
            let py1024:i64 = dcy1024 + a10 * rx + a11 * ry;
            let oi:i64 = ((qy - sy0) * (sx1 - sx0 + 1) + (qx - sx0));
            out_m[oi] = 0;
            if (px1024 >= 0 && py1024 >= 0 && px1024 < (W * 1024) && py1024 < (H * 1024)) {
                let x0:i64 = px1024 / 1024;
                let y0:i64 = py1024 / 1024;
                let fx:i64 = px1024 - x0 * 1024;
                let fy:i64 = py1024 - y0 * 1024;
                let x1:i64 = x0 + 1;
                let y1:i64 = y0 + 1;
                if (x1 >= W) { x1 = W - 1; }
                if (y1 >= H) { y1 = H - 1; }
                let c:i64 = 0;
                while (c < 3) {
                    let v00:i64 = sdonor[(y0 * W + x0) * 3 + c] as i64;
                    let v10:i64 = sdonor[(y0 * W + x1) * 3 + c] as i64;
                    let v01:i64 = sdonor[(y1 * W + x0) * 3 + c] as i64;
                    let v11:i64 = sdonor[(y1 * W + x1) * 3 + c] as i64;
                    let v:i64 = (v00 * (1024 - fx) * (1024 - fy) + v10 * fx * (1024 - fy) + v01 * (1024 - fx) * fy + v11 * fx * fy) / 1048576;
                    out_px[oi * 3 + c] = v as u8;
                    c = c + 1;
                }
                out_m[oi] = donor_mask[y0 * W + x0];
            } else {
                let c2:i64 = 0;
                while (c2 < 3) { out_px[oi * 3 + c2] = 0; c2 = c2 + 1; }
            }
            qx = qx + 1;
        }
        qy = qy + 1;
    }
}

// Recipient slot: motion subject split by neck-line; head part above.
// out_m: N-byte slot mask. mo: 80-byte moments. info[32]: neck, subj_area,
// head_area, ethr. Returns 0 or negative.
fn v4_slot(st:[]u8, W:i64, H:i64, nf:i64, out_m:[]u8, mo:[]u8, info:[]u8) i64 {
    let N:i64 = W * H;
    let E:[]u8 = nio_alloc(614400);
    if (seg_motion_E(st, E, W, H, nf) != 0) { return -710; }
    let hist:[]u8 = nio_alloc(8192);
    seg_histE(E, N, hist);
    let eb:i64 = seg_pct_bin(hist, 1024, N, 85);
    nio_free(hist);
    let ethr:i64 = eb * 4;
    let subj:[]u8 = nio_alloc(76800);
    let p:i64 = 0;
    while (p < N) {
        if (h_get64(E, p * 8) > ethr) { subj[p] = 1; } else { subj[p] = 0; }
        p = p + 1;
    }
    nio_free(E);
    let tmp:[]u8 = nio_alloc(76800);
    seg_open(subj, tmp, W, H, 3);
    seg_fill_holes(subj, W, H);
    nio_free(tmp);
    let lab:[]u8 = nio_alloc(614400);
    let nl:i64 = seg_label(subj, lab, W, H);
    let sid:i64 = seg_largest_id(lab, nl, W, H);
    if (sid <= 0) { return -711; }
    // bbox of subject
    let x0:i64 = W;
    let y0:i64 = H;
    let x1:i64 = -1;
    let y1:i64 = -1;
    p = 0;
    while (p < N) {
        if (h_get64(lab, p * 8) == sid) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            if (x < x0) { x0 = x; }
            if (x > x1) { x1 = x; }
            if (y < y0) { y0 = y; }
            if (y > y1) { y1 = y; }
        }
        p = p + 1;
    }
    nio_free(lab);
    // neck-line from motion (needs E again? seg_neck takes E and mask)
    // Recompute E is wasteful; instead reuse: we freed E. Recompute quickly.
    // (seg_motion_E is ~2M ops; acceptable.)
    let E2:[]u8 = nio_alloc(614400);
    if (seg_motion_E(st, E2, W, H, nf) != 0) { return -712; }
    let neck:i64 = seg_neck(E2, subj, W, H, x0, x1, y0, y1);
    nio_free(E2);
    if (neck < 0) { neck = (y0 + y1) / 2; }
    // head part = subject pixels above neck
    let ha:i64 = 0;
    p = 0;
    while (p < N) {
        out_m[p] = 0;
        if (subj[p] != 0) {
            let y:i64 = p / W;
            if (y < neck) { out_m[p] = 1; ha = ha + 1; }
        }
        p = p + 1;
    }
    nio_free(subj);
    if (ha < 500) { return -713; }
    v4_moments(out_m, W, H, mo);
    h_put64(info, 0, neck);
    h_put64(info, 8, ethr);
    h_put64(info, 16, ha);
    return 0;
}
// Forward affine A = s1*(us x ud) + s2*(usp x udp), x1024.
// Used for warping single points donor->slot (flip test).
fn v4_abuild(usx:i64, usy:i64, udx:i64, udy:i64, s1:i64, s2:i64, out:[]u8) void {
    let uspx:i64 = 0 - usy;
    let uspy:i64 = usx;
    let udpx:i64 = 0 - udy;
    let udpy:i64 = udx;
    let t1x:i64 = s1 * usx / 1024;
    let t1y:i64 = s1 * usy / 1024;
    let t2x:i64 = s2 * uspx / 1024;
    let t2y:i64 = s2 * uspy / 1024;
    h_put64(out, 0, (t1x * udx + t2x * udpx) / 1024);
    h_put64(out, 8, (t1x * udy + t2x * udpy) / 1024);
    h_put64(out, 16, (t1y * udx + t2y * udpx) / 1024);
    h_put64(out, 24, (t1y * udy + t2y * udpy) / 1024);
}
// ==================== V4D: plan selection + main ====================
// TNN's plan language for the fusion instruction:
//   FUSE_HEAD    - merge by grafting the donor's measured head onto the
//                  recipient's slot (verb MERGE)
//   SIDE_BY_SIDE - juxtapose the two videos spatially (verb SIDE)
//   SEQUENCE     - order the two videos temporally (verb THEN)
// Selection is instruction-sensitive (verb_fit dominates) and
// content-sensitive (FUSE_HEAD gets a measured head-viability probe, not an
// assumption). MERGE/SIDE/THEN produce different plans AND different pixels.

fn v4_side_by_side(st0:[]u8, st1:[]u8, oroot:i64, W:i64, H:i64, nf:i64, tr:[]u8, to:i64) i64 {
    // 320x240 -> left 160x240 = donor, right 160x240 = recipient.
    // Horizontal 2:1 by averaging pairs (deterministic, no RNG).
    let fr:[]u8 = nio_alloc(230400);
    let out:[]u8 = nio_alloc(230400);
    let nm:[]u8 = nio_alloc(16);
    let f:i64 = 0;
    while (f < nf) {
        if (recall_frame(st0, f, fr) != 0) { return -730 - f; }
        let y:i64 = 0;
        while (y < H) {
            let x:i64 = 0;
            while (x < 160) {
                let c:i64 = 0;
                while (c < 3) {
                    let a:i64 = fr[(y * W + x * 2) * 3 + c] as i64;
                    let b:i64 = fr[(y * W + x * 2 + 1) * 3 + c] as i64;
                    out[(y * 320 + x) * 3 + c] = ((a + b) / 2) as u8;
                    c = c + 1;
                }
                x = x + 1;
            }
            y = y + 1;
        }
        if (recall_frame(st1, f, fr) != 0) { return -740 - f; }
        y = 0;
        while (y < H) {
            let x2:i64 = 0;
            while (x2 < 160) {
                let c2:i64 = 0;
                while (c2 < 3) {
                    let a2:i64 = fr[(y * W + x2 * 2) * 3 + c2] as i64;
                    let b2:i64 = fr[(y * W + x2 * 2 + 1) * 3 + c2] as i64;
                    out[(y * 320 + 160 + x2) * 3 + c2] = ((a2 + b2) / 2) as u8;
                    c2 = c2 + 1;
                }
                x2 = x2 + 1;
            }
            y = y + 1;
        }
        let nl:i64 = mk_frame_name(nm, f);
        if (write_ppm(oroot, nm[0..nl], out, 320, 240) != 0) { return -750 - f; }
        if (f == 0 || f == 12 || f == 23) {
            to = tr_str(tr, to, " side f=");
            to = tr_i64(tr, to, f);
            to = tr_str(tr, to, " H_F=");
            to = tr_hex(tr, to, fnv(out, 0, 230400));
            to = tr_nl(tr, to);
        }
        f = f + 1;
    }
    nio_free(fr);
    nio_free(out);
    nio_free(nm);
    return to;
}

fn v4_sequence(st0:[]u8, st1:[]u8, oroot:i64, W:i64, H:i64, nf:i64, tr:[]u8, to:i64) i64 {
    // THEN = temporal order: frames 0-11 donor, 12-23 recipient.
    let fr:[]u8 = nio_alloc(230400);
    let nm:[]u8 = nio_alloc(16);
    let f:i64 = 0;
    while (f < nf) {
        if (f < 12) {
            if (recall_frame(st0, f, fr) != 0) { return -760 - f; }
        } else {
            if (recall_frame(st1, f, fr) != 0) { return -761 - f; }
        }
        let nl:i64 = mk_frame_name(nm, f);
        if (write_ppm(oroot, nm[0..nl], fr, W, H) != 0) { return -762 - f; }
        if (f == 0 || f == 11 || f == 12 || f == 23) {
            to = tr_str(tr, to, " seq f=");
            to = tr_i64(tr, to, f);
            to = tr_str(tr, to, " src=");
            if (f < 12) { to = tr_str(tr, to, "donor"); } else { to = tr_str(tr, to, "recipient"); }
            to = tr_str(tr, to, " H_F=");
            to = tr_hex(tr, to, fnv(fr, 0, 230400));
            to = tr_nl(tr, to);
        }
        f = f + 1;
    }
    nio_free(fr);
    nio_free(nm);
    return to;
}

fn do_fuse4(workA:[]u8, workB:[]u8, instr:[]u8, outd:[]u8) i64 {
    let st0:[]u8 = load_store_full(workA);
    let st1:[]u8 = load_store_full(workB);
    ensure_dir(outd);
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { return -600; }
    let tr:[]u8 = nio_alloc(131072);
    let to:i64 = 0;
    to = tr_str(tr, to, "FUSE4_ATTEMPT v4\nmechanism: fusion organ v4 (stabilize/anatomy/pose/photometric), pure Zag, zero RNG\n");
    let lab0:[]u8 = nio_alloc(64);
    let lab1:[]u8 = nio_alloc(64);
    let l0n:i64 = store_label(st0, lab0);
    let l1n:i64 = store_label(st1, lab1);
    let lab0s:[]u8 = lab0[0..l0n];
    let lab1s:[]u8 = lab1[0..l1n];
    let i:i64 = 0;
    while (i < l0n) { lab0[i] = to_lower(lab0[i]); i = i + 1; }
    i = 0;
    while (i < l1n) { lab1[i] = to_lower(lab1[i]); i = i + 1; }
    let W:i64 = h_get64(st0, 32);
    let H:i64 = h_get64(st0, 40);
    let nf:i64 = h_get64(st0, 48);
    if (W != 320 || H != 240 || h_get64(st1, 32) != 320 || h_get64(st1, 40) != 240 || h_get64(st1, 48) != nf || nf != 24) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: fusion requires two 320x240 24-frame videos.\n");
        write_buf(oroot, "fuse_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    if (l0n == l1n) {
        let same:i64 = 1;
        let k:i64 = 0;
        while (k < l0n) { if (lab0[k] != lab1[k]) { same = 0; } k = k + 1; }
        if (same == 1) {
            to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: both memories carry the same label.\n");
            write_buf(oroot, "fuse_refusal.txt", tr, to);
            nio_close(oroot);
            return 1;
        }
    }
    let n:i64 = instr.len;
    let cut:i64 = -1;
    i = 0;
    while (i < n) { if ((instr[i] as i64) == 47) { cut = i; } i = i + 1; }
    if (cut < 0) { return -620; }
    let iroot:i64 = nio_open_root(instr[0..cut]);
    if (iroot < 0) { return -621; }
    let ibuf:[]u8 = nio_alloc(4096);
    let ilen:i64 = read_file(iroot, instr[cut + 1..n], ibuf, 4096);
    nio_close(iroot);
    if (ilen < 0) { return -622; }
    let words:[]u8 = nio_alloc(256 * 16);
    let nw:i64 = tokenize(ibuf, ilen, words);
    let verb:i64 = detect_verb(ibuf, words, nw);
    let subj:[]u8 = nio_alloc(16);
    let ns:i64 = match_subjects(ibuf, words, nw, lab0s, lab1s, subj);
    to = tr_str(tr, to, "instruction: ");
    let ci:i64 = 0;
    while (ci < ilen) { tr[to + ci] = ibuf[ci]; ci = ci + 1; }
    to = to + ilen;
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "parse: verb=");
    let vn:[]u8 = nio_alloc(16);
    let vnl:i64 = verb_name(verb, vn);
    to = tr_str(tr, to, vn[0..vnl]);
    to = tr_str(tr, to, " subjects=[");
    let sj:i64 = 0;
    while (sj < ns) {
        if (sj > 0) { to = tr_str(tr, to, ","); }
        if (h_get64(subj, sj * 8) == 0) { to = tr_str(tr, to, lab0s); } else { to = tr_str(tr, to, lab1s); }
        sj = sj + 1;
    }
    to = tr_str(tr, to, "]");
    to = tr_nl(tr, to);
    if (verb < 1 || verb > 3 || ns != 2) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: fusion needs a MERGE/SIDE/THEN-class verb naming two distinct memorized subjects.\n");
        write_buf(oroot, "fuse_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    // ---- donor role: the FIRST named subject is the donor (head source).
    // (For MERGE, TNN takes the head from the first-named subject.)
    let donor_is_0:i64 = 1;
    if (h_get64(subj, 0 * 8) != 0) { donor_is_0 = 0; }
    let std_:[]u8 = st0;
    let str_:[]u8 = st1;
    if (donor_is_0 == 0) { std_ = st1; str_ = st0; }
    to = tr_str(tr, to, "roles: donor=");
    if (donor_is_0 == 1) { to = tr_str(tr, to, lab0s); } else { to = tr_str(tr, to, lab1s); }
    to = tr_str(tr, to, " recipient=");
    if (donor_is_0 == 1) { to = tr_str(tr, to, lab1s); } else { to = tr_str(tr, to, lab0s); }
    to = tr_nl(tr, to);
    // ---- content probe for FUSE_HEAD: quick dark/white viability on ref frame
    // (unstabilized; the full pipeline re-measures with stabilization).
    let N:i64 = W * H;
    let pxp:[]u8 = nio_alloc(230400);
    if (recall_frame(std_, 12, pxp) != 0) { return -623; }
    let grp:[]u8 = nio_alloc(76800);
    seg_gray(pxp, grp, N);
    let tdp:i64 = seg_gray_pct(grp, N, 20);
    let twp:i64 = seg_gray_pct(grp, N, 80);
    let mp:[]u8 = nio_alloc(76800);
    let tmpp:[]u8 = nio_alloc(76800);
    let labp:[]u8 = nio_alloc(614400);
    seg_thresh(grp, tmpp, N, tdp, 1);
    seg_open(tmpp, mp, W, H, 2);
    seg_fill_holes(mp, W, H);
    let ndp:i64 = seg_label(mp, labp, W, H);
    let didp:i64 = seg_largest_id(labp, ndp, W, H);
    seg_thresh(grp, tmpp, N, twp, 0);
    seg_open(tmpp, mp, W, H, 2);
    seg_fill_holes(mp, W, H);
    let nwp:i64 = seg_label(mp, labp, W, H);
    let widp:i64 = seg_largest_id(labp, nwp, W, H);
    let head_ok:i64 = 0;
    if (didp > 0 && widp > 0) { head_ok = 1; }
    to = tr_str(tr, to, "probe: dark_comp=");
    to = tr_i64(tr, to, didp);
    to = tr_str(tr, to, " white_comp=");
    to = tr_i64(tr, to, widp);
    to = tr_str(tr, to, " head_ok=");
    to = tr_i64(tr, to, head_ok);
    to = tr_nl(tr, to);
    nio_free(pxp);
    nio_free(grp);
    nio_free(mp);
    nio_free(tmpp);
    nio_free(labp);
    // ---- plan selection (instruction-sensitive + content-sensitive)
    let s_fuse:i64 = 10;
    if (verb == 1) { s_fuse = 100; }
    if (verb == 2) { s_fuse = 15; }
    if (head_ok == 1) { s_fuse = s_fuse + 10; }
    let s_side:i64 = 10;
    if (verb == 2) { s_side = 100; }
    if (verb == 1) { s_side = 10; }
    s_side = s_side + 10;
    let s_seq:i64 = 10;
    if (verb == 3) { s_seq = 100; }
    s_seq = s_seq + 10;
    to = tr_str(tr, to, "--- PLAN_SELECT (verb_fit dominates; content refines) ---\n");
    to = tr_str(tr, to, " FUSE_HEAD score=");
    to = tr_i64(tr, to, s_fuse);
    to = tr_str(tr, to, " SIDE_BY_SIDE score=");
    to = tr_i64(tr, to, s_side);
    to = tr_str(tr, to, " SEQUENCE score=");
    to = tr_i64(tr, to, s_seq);
    to = tr_nl(tr, to);
    let plan:i64 = 0;
    let pname:[]u8 = nio_alloc(16);
    let pnl:i64 = 0;
    if (s_fuse >= s_side && s_fuse >= s_seq) {
        plan = 0;
        pnl = tr_str(pname, 0, "FUSE_HEAD");
    } else if (s_side >= s_seq) {
        plan = 1;
        pnl = tr_str(pname, 0, "SIDE_BY_SIDE");
    } else {
        plan = 2;
        pnl = tr_str(pname, 0, "SEQUENCE");
    }
    to = tr_str(tr, to, " selected: ");
    to = tr_str(tr, to, pname[0..pnl]);
    to = tr_nl(tr, to);
    nio_free(pname);
    if (plan == 1) {
        to = tr_str(tr, to, "--- SYNTHESIZE SIDE_BY_SIDE ---\n");
        let rto:i64 = v4_side_by_side(std_, str_, oroot, W, H, nf, tr, to);
        if (rto < 0) { return rto; }
        to = rto;
        to = tr_str(tr, to, "RESULT: FUSION_COMPLETE plan=SIDE_BY_SIDE\n");
    } else if (plan == 2) {
        to = tr_str(tr, to, "--- SYNTHESIZE SEQUENCE ---\n");
        let rto2:i64 = v4_sequence(std_, str_, oroot, W, H, nf, tr, to);
        if (rto2 < 0) { return rto2; }
        to = rto2;
        to = tr_str(tr, to, "RESULT: FUSION_COMPLETE plan=SEQUENCE\n");
    } else {
        let rto3:i64 = v4_merge(std_, str_, lab0s, lab1s, donor_is_0, oroot, W, H, nf, tr, to);
        if (rto3 < -500000) {
            // refusal: v4_merge appended RESULT: FUSE_REFUSED; decode new to.
            to = 0 - rto3 - 1000000;
            let tnm3:[]u8 = nio_alloc(32);
            let tl3:i64 = mk_trace_name(tnm3, "fuse4");
            write_buf(oroot, tnm3[0..tl3], tr, to);
            nio_close(oroot);
            return 1;
        }
        if (rto3 < 0) { nio_close(oroot); return rto3; }
        to = rto3;
    }
    let tnm:[]u8 = nio_alloc(32);
    let tl:i64 = mk_trace_name(tnm, "fuse4");
    let trc:i64 = write_buf(oroot, tnm[0..tl], tr, to);
    nio_close(oroot);
    nio_free(tr);
    nio_free(lab0);
    nio_free(lab1);
    nio_free(ibuf);
    nio_free(words);
    nio_free(subj);
    nio_free(vn);
    nio_free(st0);
    nio_free(st1);
    nio_free(tnm);
    if (trc != 0) { return -799; }
    return 0;
}
// ==================== V4E: FUSE_HEAD merge pipeline ====================
// stabilize -> per-frame anatomical heads -> pose-normalized warp (measured
// landmarks, TNN-selected similarity/anisotropic + flip) -> photometric
// transfer (TNN-deliberated from candidates) -> per-frame synthesis with
// live donor appearance (per-frame pose, not frozen frame 12).

// Residual check: mean |frame diff| before vs after stabilization, summed
// over 3 sample pairs. out[16]: before_sum, after_sum.
fn v4_stab_residual(std_:[]u8, cum:[]u8, W:i64, H:i64, out:[]u8) i64 {
    let N:i64 = W * H;
    let fa:[]u8 = nio_alloc(230400);
    let fb:[]u8 = nio_alloc(230400);
    let ga:[]u8 = nio_alloc(76800 as i32);
    let gb:[]u8 = nio_alloc(76800 as i32);
    let sa:[]u8 = nio_alloc(230400);
    let sb:[]u8 = nio_alloc(230400);
    let rb:i64 = 0;
    let ra:i64 = 0;
    let pr:i64 = 0;
    while (pr < 3) {
        let p0:i64 = 0;
        if (pr == 1) { p0 = 11; }
        if (pr == 2) { p0 = 22; }
        if (recall_frame(std_, p0, fa) != 0) { return -771; }
        if (recall_frame(std_, p0 + 1, fb) != 0) { return -772; }
        seg_gray(fa, ga, N);
        seg_gray(fb, gb, N);
        let d:i64 = 0;
        let p:i64 = 0;
        while (p < N) {
            let dd:i64 = (gb[p] as i64) - (ga[p] as i64);
            if (dd < 0) { dd = 0 - dd; }
            d = d + dd;
            p = p + 1;
        }
        rb = rb + d / N;
        if (v4_stable_frame(std_, p0, cum, W, H, sa) != 0) { return -773; }
        if (v4_stable_frame(std_, p0 + 1, cum, W, H, sb) != 0) { return -774; }
        seg_gray(sa, ga, N);
        seg_gray(sb, gb, N);
        d = 0;
        p = 0;
        while (p < N) {
            let dd2:i64 = (gb[p] as i64) - (ga[p] as i64);
            if (dd2 < 0) { dd2 = 0 - dd2; }
            d = d + dd2;
            p = p + 1;
        }
        ra = ra + d / N;
        pr = pr + 1;
    }
    h_put64(out, 0, rb);
    h_put64(out, 8, ra);
    nio_free(fa);
    nio_free(fb);
    nio_free(ga);
    nio_free(gb);
    nio_free(sa);
    nio_free(sb);
    return 0;
}

// One frame's anatomical head (dark-component axis, no white reference).
// Tries both axis directions; picks the one with a valid neck constriction.
// lmf: 128-byte landmark record. Returns 1 (valid), negative (failure code).
fn v4_anatomy_frame(std_:[]u8, f:i64, cum:[]u8, Es:[]u8, noise:i64, W:i64, H:i64, dm:[]u8, wm:[]u8, dst:[]u8, fvec:[]u8, sn:[]u8, nk:[]u8, hmask:[]u8, hs:[]u8, mo:[]u8, ev:[]u8, lmf:[]u8) i64 {
    // Zero the full 16-qword landmark record up front: uninitialized heap
    // is not reliably zeroed, and the caller copies/reads all 16 fields.
    let lz:i64 = 0;
    while (lz < 16) { h_put64(lmf, lz * 8, 0); lz = lz + 1; }
    if (v4_dw_one(std_, f, cum, W, H, dm, wm, dst) != 0) { return -780; }
    if (h_get64(dst, 72) == 0) { return -781; }
    v4_moments(dm, W, H, mo);
    if (h_get64(mo, 0) < 2000) { return -786; }
    v4_eigenvec(h_get64(mo, 24), h_get64(mo, 40), h_get64(mo, 32), ev);
    // Facing is 180-degree ambiguous. TNN tries BOTH axis directions and
    // picks the one with the stronger measured neck constriction (prominence).
    // The snout must be the front of the animal; the neck must constrict
    // behind it. A direction with no neck (rc=1) cannot defend a head.
    let dir:i64 = 0;
    let best_prom:i64 = -1;
    let best_fx:i64 = 0;
    let best_fy:i64 = 0;
    let best_snx:i64 = 0;
    let best_sny:i64 = 0;
    let best_dneck:i64 = 50;
    while (dir < 2) {
        let tfx:i64 = h_get64(ev, 0);
        let tfy:i64 = h_get64(ev, 8);
        if (dir == 1) { tfx = 0 - tfx; tfy = 0 - tfy; }
        v4_snout(dm, tfx, tfy, W, H, sn);
        v4_neckcut(dm, h_get64(sn, 0), h_get64(sn, 8), tfx, tfy, W, H, nk);
        if (h_get64(nk, 0) == 0) {
            let pr:i64 = h_get64(nk, 40);
            if (pr > best_prom) {
                best_prom = pr;
                best_fx = tfx;
                best_fy = tfy;
                best_snx = h_get64(sn, 0);
                best_sny = h_get64(sn, 8);
                best_dneck = h_get64(nk, 8);
            }
        }
        dir = dir + 1;
    }
    if (best_prom < 0) { return -785; }
    let ux:i64 = best_fx;
    let uy:i64 = best_fy;
    // Head region bounded by the MEASURED neck cut (not a fixed 50px):
    // the head is the dark part on the snout side of the neck constriction.
    v4_head_region(dm, Es, best_snx, best_sny, ux, uy, best_dneck, noise, W, H, hmask, hs);
    h_put64(lmf, 0, h_get64(hs, 72));
    if (h_get64(hs, 72) == 0) { return -785; }
    h_put64(lmf, 8, h_get64(hs, 0));
    v4_snout(hmask, ux, uy, W, H, sn);
    v4_moments(hmask, W, H, mo);
    if (h_get64(mo, 0) < 500) { return -786; }
    v4_eigenvec(h_get64(mo, 24), h_get64(mo, 40), h_get64(mo, 32), ev);
    // Landmark record (16 qwords), the contract v4_merge reads:
    // 0=valid 8=area 16=dcx(x1024) 24=dcy(x1024) 32=ax_x 40=ax_y
    // 48=lam1 56=lam2 64=snout_x(px, head) 72=snout_y(px, head)
    // 80=d_neck(px, measured) 88=facing_x(x1024, picked) 96=facing_y(x1024)
    // 104=dark_snout_x(px) 112=dark_snout_y(px). Neck point (donor frame):
    // (104,112) - 80*(88,96)/1024.
    h_put64(lmf, 16, h_get64(mo, 8));
    h_put64(lmf, 24, h_get64(mo, 16));
    h_put64(lmf, 32, h_get64(ev, 0));
    h_put64(lmf, 40, h_get64(ev, 8));
    h_put64(lmf, 48, h_get64(ev, 16));
    h_put64(lmf, 56, h_get64(ev, 24));
    h_put64(lmf, 64, h_get64(sn, 0));
    h_put64(lmf, 72, h_get64(sn, 8));
    h_put64(lmf, 80, best_dneck);
    h_put64(lmf, 88, best_fx);
    h_put64(lmf, 96, best_fy);
    h_put64(lmf, 104, best_snx);
    h_put64(lmf, 112, best_sny);
    return 1;
}

// Feather: alpha = box blur of mask, radius r (0..255).
fn v4_feather(mask:[]u8, w:i64, h:i64, r:i64, alpha:[]u8) void {
    let tmp:[]u8 = nio_alloc((w * h * 8) as i32);
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let s:i64 = 0;
            let c:i64 = 0;
            let k:i64 = 0 - r;
            while (k <= r) {
                let xx:i64 = x + k;
                if (xx < 0) { xx = 0; }
                if (xx >= w) { xx = w - 1; }
                if (mask[y * w + xx] != 0) { s = s + 255; }
                c = c + 1;
                k = k + 1;
            }
            h_put64(tmp, (y * w + x) * 8, s / c);
            x = x + 1;
        }
        y = y + 1;
    }
    y = 0;
    while (y < h) {
        let x2:i64 = 0;
        while (x2 < w) {
            let s2:i64 = 0;
            let c2:i64 = 0;
            let k2:i64 = 0 - r;
            while (k2 <= r) {
                let yy:i64 = y + k2;
                if (yy < 0) { yy = 0; }
                if (yy >= h) { yy = h - 1; }
                s2 = s2 + h_get64(tmp, (yy * w + x2) * 8);
                c2 = c2 + 1;
                k2 = k2 + 1;
            }
            alpha[y * w + x2] = (s2 / c2) as u8;
            x2 = x2 + 1;
        }
        y = y + 1;
    }
    nio_free(tmp);
}

// Composite the graft (bbox RGB + alpha) onto the frame with a vertical
// light-tilt (k x1024: scene top-minus-bottom over mean) and return.
fn v4_composite(fr:[]u8, W:i64, graft:[]u8, alpha:[]u8, sx0:i64, sy0:i64, sw:i64, sh:i64, tiltk:i64) void {
    let y:i64 = 0;
    while (y < sh) {
        // tilt factor x1024: 1024 + k*(0.5 - y/sh)
        let tf:i64 = 1024 + tiltk / 2 - tiltk * y / sh;
        if (tf < 256) { tf = 256; }
        if (tf > 4096) { tf = 4096; }
        let x:i64 = 0;
        while (x < sw) {
            let a:i64 = alpha[y * sw + x] as i64;
            if (a > 0) {
                let gx:i64 = sx0 + x;
                let gy:i64 = sy0 + y;
                if (gx >= 0 && gx < W && gy >= 0 && gy < 240) {
                    let o:i64 = (gy * W + gx) * 3;
                    let go:i64 = (y * sw + x) * 3;
                    let c:i64 = 0;
                    while (c < 3) {
                        let gv:i64 = (graft[go + c] as i64) * tf / 1024;
                        if (gv > 255) { gv = 255; }
                        let fv:i64 = fr[o + c] as i64;
                        fr[o + c] = ((gv * a + fv * (255 - a)) / 255) as u8;
                        c = c + 1;
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

// Soft contact shadow below the graft bbox.
fn v4_shadow(fr:[]u8, W:i64, H:i64, sx0:i64, sy0:i64, sx1:i64, sy1:i64, strength:i64) void {
    if (strength <= 0) { return; }
    let y:i64 = sy1 + 1;
    while (y <= sy1 + 18 && y < H) {
        let fall:i64 = 255 - (y - sy1) * 255 / 19;
        let x:i64 = sx0;
        while (x <= sx1 && x < W) {
            if (x >= 0 && y >= 0) {
                let o:i64 = (y * W + x) * 3;
                let dk:i64 = strength * fall / 255;
                let c:i64 = 0;
                while (c < 3) {
                    let v:i64 = fr[o + c] as i64;
                    v = v - v * dk / 256;
                    if (v < 0) { v = 0; }
                    fr[o + c] = v as u8;
                    c = c + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
}
fn v4_merge(std_:[]u8, str_:[]u8, lab0s:[]u8, lab1s:[]u8, donor_is_0:i64, oroot:i64, W:i64, H:i64, nf:i64, tr:[]u8, to:i64) i64 {
    let N:i64 = W * H;
    // ---------- STABILIZE ----------
    to = tr_str(tr, to, "--- STABILIZE (TNN deliberates its own stabilization) ---\n");
    let shifts:[]u8 = nio_alloc(368 as i32);
    let sdbg:[]u8 = nio_alloc(368 as i32);
    if (v4_shake(std_, nf, shifts, sdbg) != 0) { return -770; }
    let cum:[]u8 = nio_alloc(384 as i32);
    v4_cumul(shifts, nf, cum);
    let smax:i64 = 0;
    let f:i64 = 0;
    while (f < nf) {
        let ax:i64 = h_get64(cum, f * 16);
        if (ax < 0) { ax = 0 - ax; }
        let ay:i64 = h_get64(cum, f * 16 + 8);
        if (ay < 0) { ay = 0 - ay; }
        if (ax > smax) { smax = ax; }
        if (ay > smax) { smax = ay; }
        f = f + 1;
    }
    let res:[]u8 = nio_alloc(16 as i32);
    if (v4_stab_residual(std_, cum, W, H, res) != 0) { return -775; }
    let rb:i64 = h_get64(res, 0) / 3;
    let ra:i64 = h_get64(res, 8) / 3;
    nio_free(res);
    let use_stab:i64 = 1;
    if (smax < 3) { use_stab = 0; }
    if (use_stab == 1 && ra >= rb) { use_stab = 0; }
    if (use_stab == 0) {
        f = 0;
        while (f < nf) { h_put64(cum, f * 16, 0); h_put64(cum, f * 16 + 8, 0); f = f + 1; }
    }
    to = tr_str(tr, to, " shake_max_px=");
    to = tr_i64(tr, to, smax);
    to = tr_str(tr, to, " residual_before=");
    to = tr_i64(tr, to, rb);
    to = tr_str(tr, to, " residual_after=");
    to = tr_i64(tr, to, ra);
    to = tr_str(tr, to, " use_stab=");
    to = tr_i64(tr, to, use_stab);
    to = tr_nl(tr, to);
    nio_free(shifts);
    nio_free(sdbg);
    // ---------- STABILIZED MOTION + NOISE ----------
    let Es:[]u8 = nio_alloc(614400 as i32);
    if (v4_stable_E(std_, cum, Es, W, H, nf) != 0) { return -776; }
    let histE:[]u8 = nio_alloc(8192 as i32);
    seg_histE(Es, N, histE);
    let noise:i64 = seg_pct_bin(histE, 1024, N, 50) * 4;
    nio_free(histE);
    to = tr_str(tr, to, " motion_noise_x4=");
    to = tr_i64(tr, to, noise);
    to = tr_nl(tr, to);
    // ---------- PER-FRAME ANATOMY ----------
    to = tr_str(tr, to, "--- ANATOMY (per-frame snout-anchored head) ---\n");
    let heads:[]u8 = nio_alloc(1843200 as i32);
    let lm:[]u8 = nio_alloc(3072 as i32);
    let lmi:i64 = 0;
    while (lmi < 3072) { lm[lmi] = 0; lmi = lmi + 1; }
    let dm:[]u8 = nio_alloc(76800 as i32);
    let wm:[]u8 = nio_alloc(76800 as i32);
    let dst:[]u8 = nio_alloc(160 as i32);
    let fvec:[]u8 = nio_alloc(16 as i32);
    let sn:[]u8 = nio_alloc(24 as i32);
    let nk:[]u8 = nio_alloc(64 as i32);
    let hmask:[]u8 = nio_alloc(76800 as i32);
    let hs:[]u8 = nio_alloc(80 as i32);
    let mo:[]u8 = nio_alloc(80 as i32);
    let ev:[]u8 = nio_alloc(32 as i32);
    let nvalid:i64 = 0;
    f = 0;
    while (f < nf) {
        let lmf:[]u8 = nio_alloc(128 as i32);
        let vr:i64 = v4_anatomy_frame(std_, f, cum, Es, noise, W, H, dm, wm, dst, fvec, sn, nk, hmask, hs, mo, ev, lmf);
        
        if (vr < 0 && vr > -790) {
            // specific anatomy failure; trace it for f=0,12,23
            if (f == 0 || f == 12 || f == 23) {
                to = tr_str(tr, to, " f=");
                to = tr_i64(tr, to, f);
                to = tr_str(tr, to, " anatomy_fail=");
                to = tr_i64(tr, to, vr);
                to = tr_nl(tr, to);
            }
            vr = 0;
        }
        if (vr < 0) { return -777; }
        if (vr == 1) {
            nvalid = nvalid + 1;
            // copy lmf fields to lm using h_put64 (safe)
            let co:i64 = 0;
            while (co < 16) {
                h_put64(lm, f * 128 + co * 8, h_get64(lmf, co * 8));
                co = co + 1;
            }
            // store the per-frame head mask for warp/render (N == 76800)
            let hp:i64 = 0;
            while (hp < N) {
                heads[f * 76800 + hp] = hmask[hp];
                hp = hp + 1;
            }
        }
        nio_free(lmf);
        if (f == 0 || f == 12 || f == 23) {
            to = tr_str(tr, to, " f=");
            to = tr_i64(tr, to, f);
            to = tr_str(tr, to, " valid=");
            to = tr_i64(tr, to, vr);
            to = tr_nl(tr, to);
        }
        f = f + 1;
    }
    to = tr_str(tr, to, " valid_frames=");
    to = tr_i64(tr, to, nvalid);
    to = tr_str(tr, to, "/24\n");
    if (nvalid == 0) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: no valid head split on any frame (mechanical proof: snout-anchored neck-constriction + motion leg-split found no stable part).\n");
        return 0 - to - 1000000;
    }
    nio_free(dm);
    nio_free(wm);
    nio_free(dst);
    nio_free(fvec);
    nio_free(sn);
    nio_free(nk);
    nio_free(hmask);
    nio_free(hs);
    nio_free(mo);
    nio_free(ev);
    // ---------- CROSS-FRAME VALIDATION ----------
    // median area of valid frames; drop outliers outside [0.4, 2.5]x median.
    let areas:[]u8 = nio_alloc(192 as i32);
    let na:i64 = 0;
    f = 0;
    while (f < nf) {
        if (h_get64(lm, f * 128) == 1) {
            h_put64(areas, na * 8, h_get64(lm, f * 128 + 8));
            na = na + 1;
        }
        f = f + 1;
    }
    // bubble sort areas[0..na)
    let si:i64 = 0;
    while (si < na) {
        let sj2:i64 = si + 1;
        while (sj2 < na) {
            if (h_get64(areas, sj2 * 8) < h_get64(areas, si * 8)) {
                let t:i64 = h_get64(areas, si * 8);
                h_put64(areas, si * 8, h_get64(areas, sj2 * 8));
                h_put64(areas, sj2 * 8, t);
            }
            sj2 = sj2 + 1;
        }
        si = si + 1;
    }
    let med:i64 = h_get64(areas, (na / 2) * 8);
    nio_free(areas);
    let lo:i64 = med * 4 / 10;
    let hi:i64 = med * 25 / 10;
    to = tr_str(tr, to, " area_median=");
    to = tr_i64(tr, to, med);
    to = tr_str(tr, to, " keep=[");
    to = tr_i64(tr, to, lo);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, hi);
    to = tr_str(tr, to, "]\n");
    f = 0;
    while (f < nf) {
        if (h_get64(lm, f * 128) == 1) {
            let a:i64 = h_get64(lm, f * 128 + 8);
            if (a < lo || a > hi) {
                h_put64(lm, f * 128, 0);
                nvalid = nvalid - 1;
                to = tr_str(tr, to, " drop f=");
                to = tr_i64(tr, to, f);
                to = tr_str(tr, to, " area_outlier\n");
            }
        }
        f = f + 1;
    }
    // snout jump > 40px (manhattan) from previous valid -> drop
    let prev:i64 = -1;
    f = 0;
    while (f < nf) {
        if (h_get64(lm, f * 128) == 1) {
            if (prev >= 0) {
                let jx:i64 = h_get64(lm, f * 128 + 64) - h_get64(lm, prev * 128 + 64);
                if (jx < 0) { jx = 0 - jx; }
                let jy:i64 = h_get64(lm, f * 128 + 72) - h_get64(lm, prev * 128 + 72);
                if (jy < 0) { jy = 0 - jy; }
                if (jx + jy > 40) {
                    h_put64(lm, f * 128, 0);
                    nvalid = nvalid - 1;
                    to = tr_str(tr, to, " drop f=");
                    to = tr_i64(tr, to, f);
                    to = tr_str(tr, to, " snout_jump\n");
                } else {
                    prev = f;
                }
            } else {
                prev = f;
            }
        }
        f = f + 1;
    }
    to = tr_str(tr, to, " valid_after_gates=");
    to = tr_i64(tr, to, nvalid);
    to = tr_nl(tr, to);
    if (nvalid == 0) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: head failed cross-frame stability gates (no stable part).\n");
        return 0 - to - 1000000;
    }
    // nearest-valid map
    let nmap:[]u8 = nio_alloc(192 as i32);
    f = 0;
    while (f < nf) {
        if (h_get64(lm, f * 128) == 1) {
            h_put64(nmap, f * 8, f);
        } else {
            let d:i64 = 1;
            let found:i64 = -1;
            while (d < nf) {
                if (f - d >= 0 && h_get64(lm, (f - d) * 128) == 1) { found = f - d; break; }
                if (f + d < nf && h_get64(lm, (f + d) * 128) == 1) { found = f + d; break; }
                d = d + 1;
            }
            h_put64(nmap, f * 8, found);
        }
        f = f + 1;
    }
    // ref frame: 12 or nearest valid
    let rf:i64 = 12;
    if (h_get64(lm, 12 * 128) != 1) { rf = h_get64(nmap, 12 * 8); }
    to = tr_str(tr, to, " ref_frame=");
    to = tr_i64(tr, to, rf);
    to = tr_nl(tr, to);
    nio_free(Es);
    // ---------- SLOT (recipient head) ----------
    to = tr_str(tr, to, "--- SLOT (recipient head region) ---\n");
    let slotm:[]u8 = nio_alloc(76800 as i32);
    let slotmo:[]u8 = nio_alloc(80 as i32);
    let slotinfo:[]u8 = nio_alloc(32 as i32);
    if (v4_slot(str_, W, H, nf, slotm, slotmo, slotinfo) != 0) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: recipient slot not measurable.\n");
        return 0 - to - 1000000;
    }
    let sev:[]u8 = nio_alloc(32 as i32);
    v4_eigenvec(h_get64(slotmo, 24), h_get64(slotmo, 40), h_get64(slotmo, 32), sev);
    let scx:i64 = h_get64(slotmo, 8);
    let scy:i64 = h_get64(slotmo, 16);
    let usx:i64 = h_get64(sev, 0);
    let usy:i64 = h_get64(sev, 8);
    let Ls1:i64 = v4_isqrt(h_get64(sev, 16) * 1024);
    let Ls2:i64 = v4_isqrt(h_get64(sev, 24) * 1024);
    let sx0:i64 = h_get64(slotmo, 48);
    let sy0:i64 = h_get64(slotmo, 56);
    let sx1:i64 = h_get64(slotmo, 64);
    let sy1:i64 = h_get64(slotmo, 72);
    to = tr_str(tr, to, " slot bbox=(");
    to = tr_i64(tr, to, sx0);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, sy0);
    to = tr_str(tr, to, ")-(");
    to = tr_i64(tr, to, sx1);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, sy1);
    to = tr_str(tr, to, ") neck=");
    to = tr_i64(tr, to, h_get64(slotinfo, 0));
    to = tr_nl(tr, to);
    nio_free(sev);
    nio_free(slotinfo);
    // donor ref landmarks
    let dcx:i64 = h_get64(lm, rf * 128 + 16);
    let dcy:i64 = h_get64(lm, rf * 128 + 24);
    let udx:i64 = h_get64(lm, rf * 128 + 32);
    let udy:i64 = h_get64(lm, rf * 128 + 40);
    let Ld1:i64 = v4_isqrt(h_get64(lm, rf * 128 + 48) * 1024);
    let Ld2:i64 = v4_isqrt(h_get64(lm, rf * 128 + 56) * 1024);
    if (Ld1 <= 0) { Ld1 = 1; }
    if (Ld2 <= 0) { Ld2 = 1; }
    if (Ls1 <= 0) { Ls1 = 1; }
    if (Ls2 <= 0) { Ls2 = 1; }
    let s_sim:i64 = Ls1 * 1024 / Ld1;
    let s1a:i64 = Ls1 * 1024 / Ld1;
    let s2a:i64 = Ls2 * 1024 / Ld2;
    to = tr_str(tr, to, " pose: donor_c=(");
    to = tr_i64(tr, to, dcx / 1024);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, dcy / 1024);
    to = tr_str(tr, to, ") slot_c=(");
    to = tr_i64(tr, to, scx / 1024);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, scy / 1024);
    to = tr_str(tr, to, ") s_sim_x1024=");
    to = tr_i64(tr, to, s_sim);
    to = tr_str(tr, to, " s_aniso=(");
    to = tr_i64(tr, to, s1a);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, s2a);
    to = tr_str(tr, to, ")\n");
    // ---------- FLIP TEST (upright head) ----------
    // A head is upright if the snout sits BELOW the head centroid (nose down,
    // the grazing/neutral pose), not above it (nose up = upside down).
    // The snout-inside-slot check is kept as evidence; upright decides.
    let ab:[]u8 = nio_alloc(32 as i32);
    let rsx:i64 = h_get64(lm, rf * 128 + 64);
    let rsy:i64 = h_get64(lm, rf * 128 + 72);
    let ox:i64 = rsx * 1024 - dcx;
    let oy:i64 = rsy * 1024 - dcy;
    let flip:i64 = 0;
    let in0:i64 = 0;
    let in1:i64 = 0;
    let qy0:i64 = 0;
    let qy1:i64 = 0;
    let fl:i64 = 0;
    while (fl < 2) {
        let fux:i64 = udx;
        let fuy:i64 = udy;
        if (fl == 1) { fux = 0 - udx; fuy = 0 - udy; }
        v4_abuild(usx, usy, fux, fuy, s_sim, s_sim, ab);
        let qx:i64 = (scx + (h_get64(ab, 0) * ox + h_get64(ab, 8) * oy) / 1024) / 1024;
        let qy:i64 = (scy + (h_get64(ab, 16) * ox + h_get64(ab, 24) * oy) / 1024) / 1024;
        let inside:i64 = 0;
        if (qx >= sx0 - 5 && qx <= sx1 + 5 && qy >= sy0 - 5 && qy <= sy1 + 5) { inside = 1; }
        if (fl == 0) { in0 = inside; qy0 = qy; } else { in1 = inside; qy1 = qy; }
        to = tr_str(tr, to, " flip=");
        to = tr_i64(tr, to, fl);
        to = tr_str(tr, to, " snout->(");
        to = tr_i64(tr, to, qx);
        to = tr_str(tr, to, ",");
        to = tr_i64(tr, to, qy);
        to = tr_str(tr, to, ") inside=");
        to = tr_i64(tr, to, inside);
        to = tr_str(tr, to, " upright=");
        if (qy > scy / 1024) { to = tr_i64(tr, to, 1); } else { to = tr_i64(tr, to, 0); }
        to = tr_nl(tr, to);
        fl = fl + 1;
    }
    nio_free(ab);
    // Upright decides: snout below the head centroid (scy). Warped centroid
    // is at (scx,scy) because the warp is centroid-anchored.
    let up0:i64 = 0;
    if (qy0 > scy / 1024) { up0 = 1; }
    let up1:i64 = 0;
    if (qy1 > scy / 1024) { up1 = 1; }
    if (up0 == 1 && up1 == 0) { flip = 0; }
    if (up0 == 0 && up1 == 1) { flip = 1; }
    if (up0 == up1) {
        // tie: fall back to snout-inside
        if (in0 == 1 && in1 == 0) { flip = 0; }
        if (in0 == 0 && in1 == 1) { flip = 1; }
    }
    // if still tied, flip=0 (traced)
    to = tr_str(tr, to, " flip_selected=");
    to = tr_i64(tr, to, flip);
    to = tr_str(tr, to, " (in0=");
    to = tr_i64(tr, to, in0);
    to = tr_str(tr, to, " in1=");
    to = tr_i64(tr, to, in1);
    to = tr_str(tr, to, ")\n");
    let fudx:i64 = udx;
    let fudy:i64 = udy;
    if (flip == 1) { fudx = 0 - udx; fudy = 0 - udy; }
    // ---------- MODE TEST (similarity vs anisotropic vs cover) ----------
    // Warp canvas = slot bbox expanded by 32 (room for the 1.5x cover scale).
    let wx0:i64 = sx0 - 32;
    if (wx0 < 0) { wx0 = 0; }
    let wy0:i64 = sy0 - 32;
    if (wy0 < 0) { wy0 = 0; }
    let wx1:i64 = sx1 + 32;
    if (wx1 >= W) { wx1 = W - 1; }
    let wy1:i64 = sy1 + 32;
    if (wy1 >= H) { wy1 = H - 1; }
    let cw:i64 = wx1 - wx0 + 1;
    let ch:i64 = wy1 - wy0 + 1;
    let sdr:[]u8 = nio_alloc(230400 as i32);
    if (v4_stable_frame(std_, rf, cum, W, H, sdr) != 0) { return -778; }
    let hmrf:[]u8 = heads[rf * 76800..rf * 76800 + 76800];
    let ainv:[]u8 = nio_alloc(48 as i32); // 48: v4_ainv writes rc at byte 40
    let wpx:[]u8 = nio_alloc((cw * ch * 3) as i32);
    let wm:[]u8 = nio_alloc((cw * ch) as i32);
    // slot mask on canvas
    let smb:[]u8 = nio_alloc((cw * ch) as i32);
    let yy:i64 = 0;
    while (yy < ch) {
        let xx:i64 = 0;
        while (xx < cw) {
            smb[yy * cw + xx] = slotm[(wy0 + yy) * W + (wx0 + xx)];
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    let best_iou:i64 = -1;
    let best_cov:i64 = -1;
    let mode:i64 = 0;
    // slot area for coverage (head-swap goal: the donor head must COVER the slot)
    let area_slot:i64 = 0;
    let pp0:i64 = 0;
    while (pp0 < cw * ch) {
        if (smb[pp0] != 0) { area_slot = area_slot + 1; }
        pp0 = pp0 + 1;
    }
    let md:i64 = 0;
    while (md < 3) {
        let ms1:i64 = s_sim;
        let ms2:i64 = s_sim;
        if (md == 1) { ms1 = s1a; ms2 = s2a; }
        // md=2 "cover": 1.5x the similarity scale, so the donor head covers
        // the recipient head (swap, not blend). TNN measures the coverage.
        if (md == 2) { ms1 = s_sim * 1536 / 1024; ms2 = ms1; }
        v4_ainv(usx, usy, fudx, fudy, ms1, ms2, ainv);
        if (h_get64(ainv, 40) == 0) {
            v4_warp(sdr, hmrf, W, H, ainv, dcx, dcy, scx / 1024, scy / 1024, wx0, wy0, wx1, wy1, wpx, wm);
            // IoU(wm, smb) and coverage(wm over smb)
            let inter:i64 = 0;
            let union:i64 = 0;
            let pp:i64 = 0;
            while (pp < cw * ch) {
                let a1:i64 = 0;
                if (wm[pp] != 0) { a1 = 1; }
                let b1:i64 = 0;
                if (smb[pp] != 0) { b1 = 1; }
                if (a1 == 1 && b1 == 1) { inter = inter + 1; }
                if (a1 == 1 || b1 == 1) { union = union + 1; }
                pp = pp + 1;
            }
            let iou:i64 = 0;
            if (union > 0) { iou = inter * 1024 / union; }
            let cov:i64 = 0;
            if (area_slot > 0) { cov = inter * 1024 / area_slot; }
            to = tr_str(tr, to, " mode=");
            if (md == 0) { to = tr_str(tr, to, "similarity"); } else { if (md == 1) { to = tr_str(tr, to, "anisotropic"); } else { to = tr_str(tr, to, "cover"); } }
            to = tr_str(tr, to, " iou_x1024=");
            to = tr_i64(tr, to, iou);
            to = tr_str(tr, to, " cov_x1024=");
            to = tr_i64(tr, to, cov);
            to = tr_nl(tr, to);
            // Head-swap selects by COVERAGE (cover the recipient head), not IoU.
            if (cov > best_cov || (cov == best_cov && iou > best_iou)) { best_cov = cov; best_iou = iou; mode = md; }
        } else {
            to = tr_str(tr, to, " mode=");
            if (md == 0) { to = tr_str(tr, to, "similarity"); } else { if (md == 1) { to = tr_str(tr, to, "anisotropic"); } else { to = tr_str(tr, to, "cover"); } }
            to = tr_str(tr, to, " degenerate_skipped\n");
        }
        md = md + 1;
    }
    // stretch veto: anisotropic with aspect > 2.0 -> similarity
    // (cover is similarity, so the veto only applies to mode 1)
    if (mode == 1) {
        let big:i64 = s1a;
        let sml:i64 = s2a;
        if (s2a > s1a) { big = s2a; sml = s1a; }
        if (sml > 0 && big * 1024 / sml > 2048) {
            mode = 0;
            to = tr_str(tr, to, " stretch_veto: anisotropic aspect>2.0 -> similarity\n");
        }
    }
    to = tr_str(tr, to, " mode_selected=");
    if (mode == 0) { to = tr_str(tr, to, "similarity"); } else { if (mode == 1) { to = tr_str(tr, to, "anisotropic"); } else { to = tr_str(tr, to, "cover"); } }
    to = tr_str(tr, to, " cov_x1024=");
    to = tr_i64(tr, to, best_cov);
    to = tr_nl(tr, to);
    let fs1:i64 = s_sim;
    let fs2:i64 = s_sim;
    if (mode == 1) { fs1 = s1a; fs2 = s2a; }
    if (mode == 2) { fs1 = s_sim * 1536 / 1024; fs2 = fs1; }
    nio_free(sdr);
    nio_free(ainv);
    // wpx/wm now hold the ref warped head (from the last mode test = anisotropic).
    // Re-warp with the SELECTED mode for a clean deliberation input.
    let ainv2:[]u8 = nio_alloc(48 as i32); // 48: v4_ainv writes rc at byte 40
    v4_ainv(usx, usy, fudx, fudy, fs1, fs2, ainv2);
    let sdr2:[]u8 = nio_alloc(230400 as i32);
    if (v4_stable_frame(std_, rf, cum, W, H, sdr2) != 0) { return -779; }
    v4_warp(sdr2, hmrf, W, H, ainv2, dcx, dcy, scx / 1024, scy / 1024, wx0, wy0, wx1, wy1, wpx, wm);
    nio_free(sdr2);
    nio_free(ainv2);
    // ---------- PHOTOMETRIC DELIBERATION ----------
    to = tr_str(tr, to, "--- PHOTOMETRIC (TNN deliberates the transfer) ---\n");
    let bout:[]u8 = nio_alloc(24 as i32);
    if (v4_bright_ref(std_, rf, cum, W, H, bout) != 0) { return -781; }
    let Ld:i64 = h_get64(bout, 0);
    let Ldvalid:i64 = h_get64(bout, 8);
    nio_free(bout);
    // recipient ref frame + canvas
    let rrf:[]u8 = nio_alloc(230400 as i32);
    if (recall_frame(str_, 12, rrf) != 0) { return -782; }
    let rpx:[]u8 = nio_alloc((cw * ch * 3) as i32);
    yy = 0;
    while (yy < ch) {
        let xx2:i64 = 0;
        while (xx2 < cw) {
            let so:i64 = ((wy0 + yy) * W + (wx0 + xx2)) * 3;
            let do2:i64 = (yy * cw + xx2) * 3;
            rpx[do2] = rrf[so];
            rpx[do2 + 1] = rrf[so + 1];
            rpx[do2 + 2] = rrf[so + 2];
            xx2 = xx2 + 1;
        }
        yy = yy + 1;
    }
    // Lr: 90th pct luminance within the slot mask (full frame)
    let rhist:[]u8 = nio_alloc(2048 as i32);
    v4_lum_hist(rrf, slotm, W, H, rhist);
    let rtot:i64 = 0;
    let ri:i64 = 0;
    while (ri < 256) { rtot = rtot + h_get64(rhist, ri * 8); ri = ri + 1; }
    let rcum:i64 = 0;
    let Lr:i64 = 0;
    ri = 0;
    while (ri < 256) {
        rcum = rcum + h_get64(rhist, ri * 8);
        if (rtot > 0 && rcum * 100 >= 90 * rtot) { Lr = ri; break; }
        ri = ri + 1;
    }
    nio_free(rhist);
    let Iratio:i64 = 1024;
    if (Ld > 0) { Iratio = Lr * 1024 / Ld; }
    to = tr_str(tr, to, " donor_white_Ld=");
    to = tr_i64(tr, to, Ld);
    to = tr_str(tr, to, " (valid=");
    to = tr_i64(tr, to, Ldvalid);
    to = tr_str(tr, to, ") slot_Lr90=");
    to = tr_i64(tr, to, Lr);
    to = tr_str(tr, to, " I_x1024=");
    to = tr_i64(tr, to, Iratio);
    to = tr_nl(tr, to);
    // histograms + quantile LUT
    let dhist:[]u8 = nio_alloc(2048 as i32);
    let shist:[]u8 = nio_alloc(2048 as i32);
    v4_lum_hist(wpx, wm, cw, ch, dhist);
    v4_lum_hist(rpx, smb, cw, ch, shist);
    let lut:[]u8 = nio_alloc(256 as i32);
    v4_quant_lut(dhist, shist, lut);
    nio_free(dhist);
    nio_free(shist);
    let lutmono:i64 = v4_lut_monotonic(lut);
    // candidates
    let tpx:[]u8 = nio_alloc((cw * ch * 3) as i32);
    let cand_names:[]u8 = nio_alloc(64 as i32);
    // (names traced literally below)
    let best_seam:i64 = 0 - 1;
    let best_tx:i64 = -1;
    let best_gain:i64 = 0;
    // Identity outranks blend: select by texture preservation (tex), not seam.
    // A low seam bought by remapping the material (black->pink) is a different
    // animal, not a better transfer. Seam breaks ties.
    let best_tex:i64 = 0 - 1;
    let tn:i64 = 0;
    while (tn < 4) {
        let kind:i64 = 0;
        let gain:i64 = 3072;
        if (tn == 0) {
            gain = 3072;
            v4_gain_apply(wpx, wm, cw, ch, gain, tpx);
        }
        if (tn == 1) {
            gain = Iratio;
            v4_gain_apply(wpx, wm, cw, ch, gain, tpx);
        }
        if (tn == 2) {
            gain = Iratio * 2;
            v4_gain_apply(wpx, wm, cw, ch, gain, tpx);
        }
        if (tn == 3) {
            kind = 1;
            v4_quant_apply(wpx, wm, cw, ch, lut, tpx);
        }
        let tex:i64 = v4_tex_corr(wpx, tpx, wm, cw, ch);
        let chroma:i64 = v4_chroma_drift(wpx, tpx, wm, cw, ch);
        let seam:i64 = v4_seam(tpx, wm, rpx, cw, ch);
        let clip:i64 = v4_clip_frac(tpx, wm, cw, ch);
        let mono:i64 = 1;
        if (tn == 3) { mono = lutmono; }
        let gate:i64 = 0;
        if (mono == 1 && tex >= 717 && chroma <= 102) { gate = 1; }
        to = tr_str(tr, to, " T");
        to = tr_i64(tr, to, tn + 1);
        if (tn == 0) { to = tr_str(tr, to, "=gain3.0"); }
        if (tn == 1) { to = tr_str(tr, to, "=gainI"); }
        if (tn == 2) { to = tr_str(tr, to, "=gain2I"); }
        if (tn == 3) { to = tr_str(tr, to, "=quantile"); }
        to = tr_str(tr, to, " tex_x1024=");
        to = tr_i64(tr, to, tex);
        to = tr_str(tr, to, " chroma_x1024=");
        to = tr_i64(tr, to, chroma);
        to = tr_str(tr, to, " seam=");
        to = tr_i64(tr, to, seam);
        to = tr_str(tr, to, " clip_x1024=");
        to = tr_i64(tr, to, clip);
        to = tr_str(tr, to, " mono=");
        to = tr_i64(tr, to, mono);
        to = tr_str(tr, to, " gate=");
        to = tr_i64(tr, to, gate);
        to = tr_nl(tr, to);
        if (gate == 1) {
            if (best_tex < 0 || tex > best_tex || (tex == best_tex && seam < best_seam)) {
                best_tex = tex;
                best_seam = seam;
                best_tx = kind;
                best_gain = gain;
            }
        }
        // stash per-candidate tex for fallback
        h_put64(cand_names, tn * 16, tex);
        h_put64(cand_names, tn * 16 + 8, seam);
        tn = tn + 1;
    }
    // (cand_names freed after the fallback read below; it was a use-after-free before.)
    if (best_tx < 0) {
        // fallback: quantile (rank-preserving by construction, so it can
        // never fail the texture/monotonicity gates the way gains could).
        best_tx = 1;
        best_gain = 0;
        best_seam = h_get64(cand_names, 3 * 16 + 8);
        to = tr_str(tr, to, " FALLBACK: no candidate passed identity gates; using quantile (rank-preserving by construction)\n");
    }
    nio_free(cand_names);
    to = tr_str(tr, to, " transfer_selected: kind=");
    to = tr_i64(tr, to, best_tx);
    if (best_tx == 0) {
        to = tr_str(tr, to, " gain_x1024=");
        to = tr_i64(tr, to, best_gain);
    } else {
        to = tr_str(tr, to, " quantile_lut");
    }
    to = tr_str(tr, to, " tex_x1024=");
    to = tr_i64(tr, to, best_tex);
    to = tr_str(tr, to, " seam=");
    to = tr_i64(tr, to, best_seam);
    to = tr_nl(tr, to);
    // NOTE: the albedo move is large because the donor is black and the slot
    // is white (material difference, not an illumination error). Identity is
    // carried by rank + local contrast + chromaticity, which the gates verify.
    nio_free(tpx);
    nio_free(wpx);
    nio_free(wm);
    nio_free(smb);
    nio_free(rpx);
    // ---------- RENDER ----------
    to = tr_str(tr, to, "--- SYNTHESIZE (24 frames, live donor pose) ---\n");
    // bg stats for light tilt + shadow (recipient ref)
    let Er:[]u8 = nio_alloc(614400 as i32);
    if (seg_motion_E(str_, Er, W, H, nf) != 0) { return -783; }
    let histEr:[]u8 = nio_alloc(8192 as i32);
    seg_histE(Er, N, histEr);
    let emedr:i64 = seg_pct_bin(histEr, 1024, N, 50) * 4;
    nio_free(histEr);
    let bgst:[]u8 = nio_alloc(32 as i32);
    adapt_bg_stats(rrf, Er, emedr, W, H, bgst);
    nio_free(Er);
    let bgtop:i64 = h_get64(bgst, 0);
    let bgbot:i64 = h_get64(bgst, 8);
    let bgall:i64 = h_get64(bgst, 16);
    let bgq25:i64 = h_get64(bgst, 24);
    let tiltk:i64 = 0;
    if (bgall > 0) { tiltk = (bgtop - bgbot) * 1024 / bgall; }
    let contrast:i64 = 0;
    if (bgall > 0) { contrast = (bgall - bgq25) * 100 / bgall; }
    let shstrength:i64 = contrast * 256 / 100 / 3;
    if (shstrength > 64) { shstrength = 64; }
    if (shstrength < 0) { shstrength = 0; }
    nio_free(bgst);
    nio_free(rrf);
    to = tr_str(tr, to, " tiltk_x1024=");
    to = tr_i64(tr, to, tiltk);
    to = tr_str(tr, to, " shadow_x256=");
    to = tr_i64(tr, to, shstrength);
    to = tr_nl(tr, to);
    // per-frame render buffers
    let sdf:[]u8 = nio_alloc(230400 as i32);
    let gwpx:[]u8 = nio_alloc((cw * ch * 3) as i32);
    let gwm:[]u8 = nio_alloc((cw * ch) as i32);
    let gpx:[]u8 = nio_alloc((cw * ch * 3) as i32);
    let alpha:[]u8 = nio_alloc((cw * ch) as i32);
    let fr:[]u8 = nio_alloc(230400 as i32);
    let nm:[]u8 = nio_alloc(16 as i32);
    let wa:[]u8 = nio_alloc(48 as i32); // 48: v4_ainv writes rc at byte 40
    f = 0;
    while (f < nf) {
        let df:i64 = h_get64(nmap, f * 8);
        // per-frame donor landmarks -> warp
        let fdcx:i64 = h_get64(lm, df * 128 + 16);
        let fdcy:i64 = h_get64(lm, df * 128 + 24);
        let fudx:i64 = h_get64(lm, df * 128 + 32);
        let fudy:i64 = h_get64(lm, df * 128 + 40);
        if (flip == 1) { fudx = 0 - fudx; fudy = 0 - fudy; }
        let fLd1:i64 = v4_isqrt(h_get64(lm, df * 128 + 48) * 1024);
        let fLd2:i64 = v4_isqrt(h_get64(lm, df * 128 + 56) * 1024);
        if (fLd1 <= 0) { fLd1 = 1; }
        if (fLd2 <= 0) { fLd2 = 1; }
        let fs1f:i64 = Ls1 * 1024 / fLd1;
        let fs2f:i64 = fs1f;
        if (mode == 1) { fs2f = Ls2 * 1024 / fLd2; }
        if (mode == 2) { fs1f = fs1f * 1536 / 1024; fs2f = fs1f; }
        v4_ainv(usx, usy, fudx, fudy, fs1f, fs2f, wa);
        if (h_get64(wa, 40) != 0) { return -784; }
        if (v4_stable_frame(std_, f, cum, W, H, sdf) != 0) { return -785 - f; }
        let hmdf:[]u8 = heads[df * 76800..df * 76800 + 76800];
        v4_warp(sdf, hmdf, W, H, wa, fdcx, fdcy, scx / 1024, scy / 1024, wx0, wy0, wx1, wy1, gwpx, gwm);
        if (best_tx == 0) {
            v4_gain_apply(gwpx, gwm, cw, ch, best_gain, gpx);
        } else {
            v4_quant_apply(gwpx, gwm, cw, ch, lut, gpx);
        }
        v4_feather(gwm, cw, ch, 4, alpha);
        if (recall_frame(str_, f, fr) != 0) { return -790 - f; }
        v4_composite(fr, W, gpx, alpha, wx0, wy0, cw, ch, tiltk);
        v4_shadow(fr, W, H, wx0, wy0, wx1, wy1, shstrength);
        let nl:i64 = mk_frame_name(nm, f);
        if (write_ppm(oroot, nm[0..nl], fr, W, H) != 0) { return -795 - f; }
        if (f == 0 || f == 12 || f == 23) {
            to = tr_str(tr, to, " f=");
            to = tr_i64(tr, to, f);
            to = tr_str(tr, to, " donor_f=");
            to = tr_i64(tr, to, df);
            to = tr_str(tr, to, " H_F=");
            to = tr_hex(tr, to, fnv(fr, 0, N * 3));
            to = tr_nl(tr, to);
        }
        f = f + 1;
    }
    to = tr_str(tr, to, "RESULT: FUSION_COMPLETE plan=FUSE_HEAD transfer_kind=");
    to = tr_i64(tr, to, best_tx);
    to = tr_str(tr, to, " valid_frames=");
    to = tr_i64(tr, to, nvalid);
    to = tr_nl(tr, to);
    nio_free(slotm);
    nio_free(slotmo);
    nio_free(heads);
    nio_free(lm);
    nio_free(nmap);
    nio_free(cum);
    nio_free(lut);
    nio_free(sdf);
    nio_free(gwpx);
    nio_free(gwm);
    nio_free(gpx);
    nio_free(alpha);
    nio_free(fr);
    nio_free(nm);
    nio_free(wa);
    return to;
}

// Diagnostic: dump donor anatomy for one frame (my eyes, not TNN's deliberation).
// Writes stab.ppm, dark.ppm, head.ppm into outd. Returns 0 or negative.
fn do_dumpanat(work:[]u8, fstr:[]u8, outd:[]u8) i64 {
    let st:[]u8 = load_store_full(work);
    if (st.len == 0) { return -900; }
    let W:i64 = h_get64(st, 32);
    let H:i64 = h_get64(st, 40);
    let nf:i64 = h_get64(st, 48);
    let N:i64 = W * H;
    let f:i64 = 0;
    let mi:i64 = 0;
    while (mi < fstr.len) {
        let d:i64 = (fstr[mi] as i64) - 48;
        if (d >= 0 && d <= 9) { f = f * 10 + d; }
        mi = mi + 1;
    }
    if (f < 0 || f >= nf) { return -901; }
    ensure_dir(outd);
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { return -902; }
    let shifts:[]u8 = nio_alloc(368);
    let sdbg:[]u8 = nio_alloc(368);
    if (v4_shake(st, nf, shifts, sdbg) != 0) { return -903; }
    let cum:[]u8 = nio_alloc(384);
    v4_cumul(shifts, nf, cum);
    let Es:[]u8 = nio_alloc(614400);
    if (v4_stable_E(st, cum, Es, W, H, nf) != 0) { return -904; }
    let histE:[]u8 = nio_alloc(8192);
    seg_histE(Es, N, histE);
    let noise:i64 = seg_pct_bin(histE, 1024, N, 50) * 4;
    let dm:[]u8 = nio_alloc(76800);
    let wm:[]u8 = nio_alloc(76800);
    let dst:[]u8 = nio_alloc(160);
    let fvec:[]u8 = nio_alloc(16);
    let sn:[]u8 = nio_alloc(24);
    let nk:[]u8 = nio_alloc(64);
    let hmask:[]u8 = nio_alloc(76800);
    let hs:[]u8 = nio_alloc(80);
    let mo:[]u8 = nio_alloc(80);
    let ev:[]u8 = nio_alloc(32);
    let lmf:[]u8 = nio_alloc(128);
    let vr:i64 = v4_anatomy_frame(st, f, cum, Es, noise, W, H, dm, wm, dst, fvec, sn, nk, hmask, hs, mo, ev, lmf);
    // stabilized frame
    let sf:[]u8 = nio_alloc(230400);
    if (v4_stable_frame(st, f, cum, W, H, sf) != 0) { return -905; }
    let nm:[]u8 = nio_alloc(16);
    let nl:i64 = mk_frame_name(nm, 90);
    if (write_ppm(oroot, nm[0..nl], sf, W, H) != 0) { return -906; }
    // masks as RGB
    let rgb:[]u8 = nio_alloc(230400);
    let p:i64 = 0;
    while (p < N) {
        let v:i64 = 0;
        if (dm[p] != 0) { v = 255; }
        rgb[p * 3] = v as u8; rgb[p * 3 + 1] = v as u8; rgb[p * 3 + 2] = v as u8;
        p = p + 1;
    }
    nl = mk_frame_name(nm, 91);
    if (write_ppm(oroot, nm[0..nl], rgb, W, H) != 0) { return -907; }
    p = 0;
    while (p < N) {
        let v2:i64 = 0;
        if (hmask[p] != 0) { v2 = 255; }
        rgb[p * 3] = v2 as u8; rgb[p * 3 + 1] = v2 as u8; rgb[p * 3 + 2] = v2 as u8;
        p = p + 1;
    }
    nl = mk_frame_name(nm, 92);
    if (write_ppm(oroot, nm[0..nl], rgb, W, H) != 0) { return -908; }
    nio_close(oroot);
    _zag_print("dumpanat vr=");
    _zag_println(_zag_i64_to_str(vr));
    _zag_print(" snout=");
    _zag_print(_zag_i64_to_str(h_get64(lmf, 64)));
    _zag_print(",");
    _zag_println(_zag_i64_to_str(h_get64(lmf, 72)));
    _zag_print(" donor_c=");
    _zag_print(_zag_i64_to_str(h_get64(lmf, 16) / 1024));
    _zag_print(",");
    _zag_println(_zag_i64_to_str(h_get64(lmf, 24) / 1024));
    _zag_print(" area=");
    _zag_println(_zag_i64_to_str(h_get64(lmf, 8)));
    _zag_print(" neckcut rc=");
    _zag_print(_zag_i64_to_str(h_get64(nk, 0)));
    _zag_print(" d_neck=");
    _zag_print(_zag_i64_to_str(h_get64(nk, 8)));
    _zag_print(" d_skull=");
    _zag_print(_zag_i64_to_str(h_get64(nk, 16)));
    _zag_print(" skull_w=");
    _zag_print(_zag_i64_to_str(h_get64(nk, 24)));
    _zag_print(" neck_w=");
    _zag_print(_zag_i64_to_str(h_get64(nk, 32)));
    _zag_print(" prom_x1024=");
    _zag_println(_zag_i64_to_str(h_get64(nk, 40)));
    return 0;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if (_zag_strcmp(a1, "selftest") == 1) { return selftest(); }
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let a4:[]u8 = _zag_arg(4);
    let a5:[]u8 = _zag_arg(5);
    if (_zag_strcmp(a1, "fuse4") == 1) {
        let rc:i64 = do_fuse4(a2, a3, a4, a5);
        _zag_print("fuse4_rc=");
        _zag_println(_zag_i64_to_str(rc));
        if (rc == 0) { return 0; }
        return 1;
    }
    if (_zag_strcmp(a1, "dumpanat") == 1) {
        let rc:i64 = do_dumpanat(a2, a3, a4);
        _zag_print("dumpanat_rc=");
        _zag_println(_zag_i64_to_str(rc));
        if (rc == 0) { return 0; }
        return 1;
    }
    _zag_println("usage: composer5 selftest | fuse4 | dumpanat ...");
    return 99;
}

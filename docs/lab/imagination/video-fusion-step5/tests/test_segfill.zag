// Regression test for seg_fill_holes (pure Zag, zero RNG).
// Red-team kill 2026-09-26: the flood stack marked pixels seen at POP, so one
// pixel could be pushed up to 4x; on empty masks depth hit 77,357 > 76,800
// slots -> `panic: slice index out of bounds`. The fix marks seen AT PUSH and
// drops the pop-side continue (a pop-side continue would starve the flood of
// seed expansion), so each pixel is pushed at most once and the N-slot stack
// provably cannot overflow.
//
// Build (mirrors the fusion4 amalgamation; tests the REAL chunk code):
//   head -1582 ../../src/composer_base.zag > test_segfill_full.zag
//   cat ../../src/chunks/fz1.zag >> test_segfill_full.zag
//   cat test_segfill.zag >> test_segfill_full.zag
//   znc test_segfill_full.zag -o test_segfill --no-analyze && ./test_segfill
//
// Exit 0 + SEG_FILL_REGRESSION_PASS on success, nonzero + FAIL line otherwise.

// ---- independent reference: sweep-to-fixpoint border-connectivity ----
fn ref_border_conn(mask:[]u8, conn:[]u8, W:i64, H:i64) void {
    let N:i64 = W * H;
    let p:i64 = 0;
    while (p < N) { conn[p] = 0; p = p + 1; }
    // seed: border zeros
    let x:i64 = 0;
    while (x < W) {
        if (mask[x] == 0) { conn[x] = 1; }
        let b:i64 = (H - 1) * W + x;
        if (mask[b] == 0) { conn[b] = 1; }
        x = x + 1;
    }
    let y:i64 = 1;
    while (y < H - 1) {
        if (mask[y * W] == 0) { conn[y * W] = 1; }
        if (mask[y * W + W - 1] == 0) { conn[y * W + W - 1] = 1; }
        y = y + 1;
    }
    // propagate until fixpoint (no stack; 4-neighborhood sweeps)
    let changed:i64 = 1;
    while (changed != 0) {
        changed = 0;
        let yy:i64 = 0;
        while (yy < H) {
            let xx:i64 = 0;
            while (xx < W) {
                let i:i64 = yy * W + xx;
                if (mask[i] == 0) {
                    if (conn[i] == 0) {
                        let hit:i64 = 0;
                        if (xx > 0) { if (conn[i - 1] != 0) { hit = 1; } }
                        if (xx < W - 1) { if (conn[i + 1] != 0) { hit = 1; } }
                        if (yy > 0) { if (conn[i - W] != 0) { hit = 1; } }
                        if (yy < H - 1) { if (conn[i + W] != 0) { hit = 1; } }
                        if (hit != 0) { conn[i] = 1; changed = 1; }
                    }
                }
                xx = xx + 1;
            }
            yy = yy + 1;
        }
    }
}

fn run_case(W:i64, H:i64, pat:i64) i64 {
    let N:i64 = W * H;
    let mask:[]u8 = nio_alloc(N as i32);
    let orig:[]u8 = nio_alloc(N as i32);
    let conn:[]u8 = nio_alloc(N as i32);
    let p:i64 = 0;
    while (p < N) { mask[p] = 0; p = p + 1; }
    // deterministic patterns (zero RNG)
    if (pat == 0) {
        // empty mask: all zeros (the crasher)
    }
    if (pat == 1) {
        // full mask: all ones
        p = 0;
        while (p < N) { mask[p] = 1; p = p + 1; }
    }
    if (pat == 2) {
        // enclosed box hole: 1-box from (W/4,H/4) to (3W/4,3H/4), interior zeros
        let y:i64 = H / 4;
        while (y <= (3 * H) / 4) {
            let x:i64 = W / 4;
            while (x <= (3 * W) / 4) {
                if (x == W / 4 || x == (3 * W) / 4 || y == H / 4 || y == (3 * H) / 4) {
                    mask[y * W + x] = 1;
                }
                x = x + 1;
            }
            y = y + 1;
        }
    }
    if (pat == 3) {
        // centered 1-blob on zero field (blob must survive; zeros stay)
        let y:i64 = H / 3;
        while (y < (2 * H) / 3) {
            let x:i64 = W / 3;
            while (x < (2 * W) / 3) { mask[y * W + x] = 1; x = x + 1; }
            y = y + 1;
        }
    }
    if (pat == 4) {
        // single interior zero in all-ones (must become 1)
        p = 0;
        while (p < N) { mask[p] = 1; p = p + 1; }
        mask[(H / 2) * W + W / 2] = 0;
    }
    if (pat == 5) {
        // comb: vertical 1-bars every 4 px (zeros between bars connect to border)
        let x:i64 = 0;
        while (x < W) {
            let y:i64 = 0;
            while (y < H) { mask[y * W + x] = 1; y = y + 1; }
            x = x + 4;
        }
    }
    if (pat == 6) {
        // ring maze: concentric 1-boxes with one gap each (all zeros connected)
        let k:i64 = 2;
        while (k < 8) {
            let x0:i64 = k;
            let x1:i64 = W - 1 - k;
            let y0:i64 = k;
            let y1:i64 = H - 1 - k;
            let x:i64 = x0;
            while (x <= x1) {
                if (x != x0 + 1) { mask[y0 * W + x] = 1; }
                if (x != x1 - 1) { mask[y1 * W + x] = 1; }
                x = x + 1;
            }
            let y:i64 = y0 + 1;
            while (y < y1) {
                mask[y * W + x0] = 1;
                mask[y * W + x1] = 1;
                y = y + 1;
            }
            k = k + 3;
        }
    }
    p = 0;
    while (p < N) { orig[p] = mask[p]; p = p + 1; }
    seg_fill_holes(mask, W, H);
    // expected from independent reference on the ORIGINAL mask
    ref_border_conn(orig, conn, W, H);
    let bad:i64 = 0;
    p = 0;
    while (p < N) {
        let exp:u8 = orig[p];
        if (orig[p] == 0) {
            if (conn[p] == 0) { exp = 1; } else { exp = 0; }
        }
        if (mask[p] != exp) { bad = bad + 1; }
        p = p + 1;
    }
    nio_free(mask);
    nio_free(orig);
    nio_free(conn);
    return bad;
}

fn main() i32 {
    let sizes_W:[]u8 = nio_alloc(64);
    let sizes_H:[]u8 = nio_alloc(64);
    // (W,H) pairs: tiny, small, non-square, odd, and the real 320x240 frame size
    h_put64(sizes_W, 0, 1); h_put64(sizes_H, 0, 1);
    h_put64(sizes_W, 8, 2); h_put64(sizes_H, 8, 2);
    h_put64(sizes_W, 16, 3); h_put64(sizes_H, 16, 5);
    h_put64(sizes_W, 24, 8); h_put64(sizes_H, 24, 8);
    h_put64(sizes_W, 32, 16); h_put64(sizes_H, 32, 16);
    h_put64(sizes_W, 40, 32); h_put64(sizes_H, 40, 24);
    h_put64(sizes_W, 48, 64); h_put64(sizes_H, 48, 48);
    h_put64(sizes_W, 56, 320); h_put64(sizes_H, 56, 240);
    let total_bad:i64 = 0;
    let cases:i64 = 0;
    let s:i64 = 0;
    while (s < 8) {
        let W:i64 = h_get64(sizes_W, s * 8);
        let H:i64 = h_get64(sizes_H, s * 8);
        let pat:i64 = 0;
        while (pat < 7) {
            let bad:i64 = run_case(W, H, pat);
            if (bad != 0) {
                _zag_print("FAIL W=");
                _zag_print(_zag_i64_to_str(W));
                _zag_print(" H=");
                _zag_print(_zag_i64_to_str(H));
                _zag_print(" pat=");
                _zag_print(_zag_i64_to_str(pat));
                _zag_print(" bad_px=");
                _zag_println(_zag_i64_to_str(bad));
            }
            total_bad = total_bad + bad;
            cases = cases + 1;
            pat = pat + 1;
        }
        s = s + 1;
    }
    nio_free(sizes_W);
    nio_free(sizes_H);
    _zag_print("cases=");
    _zag_println(_zag_i64_to_str(cases));
    _zag_print("total_bad_px=");
    _zag_println(_zag_i64_to_str(total_bad));
    if (total_bad != 0) {
        _zag_println("SEG_FILL_REGRESSION_FAIL");
        return 1;
    }
    _zag_println("SEG_FILL_REGRESSION_PASS");
    return 0;
}

// screens.zag — themes, screen builders, label table, aesthetic scorer.
@import("toolkit.zag")

fn S_LIB() i64 { return 1; }
fn S_PLAY() i64 { return 2; }
fn S_SET() i64 { return 3; }

// name ids
fn N_PLAY() i64 { return 1; }
fn N_PREV() i64 { return 2; }
fn N_NEXT() i64 { return 3; }
fn N_ART() i64 { return 4; }
fn N_SEARCH() i64 { return 5; }
fn N_TAB() i64 { return 6; }
fn N_NAV() i64 { return 7; }
fn N_VOL() i64 { return 10; }
fn N_PROG() i64 { return 11; }
fn N_PROFILE() i64 { return 12; }
fn N_ROW() i64 { return 13; }
fn N_SHUFFLE() i64 { return 18; }
fn N_REPEAT() i64 { return 19; }
fn N_XFADE() i64 { return 20; }

// label ids
fn d_label_str(id:i64) []u8 {
    if (id == 1) { return "Library"; }
    if (id == 2) { return "Search songs, artists"; }
    if (id == 3) { return "Playing"; }
    if (id == 4) { return "Settings"; }
    if (id == 5) { return "Now Playing"; }
    if (id == 6) { return "Neon Skyline"; }
    if (id == 7) { return "Paper Moons"; }
    if (id == 8) { return "Copper Wire"; }
    if (id == 9) { return "Slow Static"; }
    if (id == 10) { return "Glass Garden"; }
    if (id == 11) { return "Glass Antenna"; }
    if (id == 12) { return "The Paper Moons"; }
    if (id == 13) { return "Copperfield"; }
    if (id == 14) { return "Static Bloom"; }
    if (id == 15) { return "Verdant"; }
    if (id == 16) { return "3:24"; }
    if (id == 17) { return "4:02"; }
    if (id == 18) { return "2:58"; }
    if (id == 19) { return "5:11"; }
    if (id == 20) { return "3:47"; }
    if (id == 21) { return "High quality audio"; }
    if (id == 22) { return "Normalize volume"; }
    if (id == 23) { return "Offline mode"; }
    if (id == 24) { return "Crossfade"; }
    if (id == 25) { return "About Waveform"; }
    if (id == 26) { return "Ada"; }
    if (id == 27) { return "Premium member"; }
    if (id == 28) { return "Midnight Circuits"; }
    if (id == 33) { return "Made for you"; }
    if (id == 32) { return "See all"; }
    if (id == 34) { return "1:12"; }
    if (id == 35) { return "3:47"; }
    if (id == 36) { return "Volume"; }
    return "";
}
fn d_song_title(i:i64) []u8 { return d_label_str(6 + i); }
fn d_song_artist(i:i64) []u8 { return d_label_str(11 + i); }
fn d_song_dur(i:i64) []u8 { return d_label_str(16 + i); }

// ---------- themes ----------
// V2: sol's model of 2026 premium human taste (documented in V2-RATIONALE.md)
fn theme_v2(th:[]u8) void {
    th_set_rgb(th, 0, 15, 16, 18);
    th_set_rgb(th, 3, 30, 31, 35);
    th_set_rgb(th, 6, 255, 82, 112);
    th_set_rgb(th, 9, 247, 247, 245);
    th_set_rgb(th, 12, 157, 160, 168);
    thwput(th, 15, 16); thwput(th, 16, 4);
    thwput(th, 17, 20); thwput(th, 18, 24);
    thwput(th, 19, 1); thwput(th, 20, 0);
    thwput(th, 21, 3); thwput(th, 22, 2); thwput(th, 23, 1);
    thwput(th, 24, 16); thwput(th, 25, 12); thwput(th, 26, 24);
}
// candidate palettes for V1 search
fn th_palette(th:[]u8, p:i64) void {
    if (p == 0) {
        th_set_rgb(th, 0, 240, 240, 242); th_set_rgb(th, 3, 255, 255, 255);
        th_set_rgb(th, 6, 20, 20, 24); th_set_rgb(th, 9, 18, 18, 20);
        th_set_rgb(th, 12, 120, 122, 128);
    } else if (p == 1) {
        th_set_rgb(th, 0, 10, 10, 12); th_set_rgb(th, 3, 26, 26, 30);
        th_set_rgb(th, 6, 245, 245, 247); th_set_rgb(th, 9, 245, 245, 247);
        th_set_rgb(th, 12, 150, 152, 160);
    } else if (p == 2) {
        th_set_rgb(th, 0, 16, 18, 24); th_set_rgb(th, 3, 30, 34, 44);
        th_set_rgb(th, 6, 90, 140, 255); th_set_rgb(th, 9, 240, 242, 248);
        th_set_rgb(th, 12, 140, 148, 165);
    } else {
        th_set_rgb(th, 0, 250, 250, 248); th_set_rgb(th, 3, 255, 255, 255);
        th_set_rgb(th, 6, 200, 60, 40); th_set_rgb(th, 9, 30, 28, 25);
        th_set_rgb(th, 12, 130, 125, 118);
    }
}
fn theme_candidate(th:[]u8, idx:i64) void {
    let r:i64 = idx % 7; let q:i64 = idx / 7;
    let rad:i64 = 0;
    if (r == 1) { rad = 4; } else if (r == 2) { rad = 8; } else if (r == 3) { rad = 12; }
    else if (r == 4) { rad = 16; } else if (r == 5) { rad = 20; } else if (r == 6) { rad = 24; }
    let sp:i64 = 4; if (q % 2 == 1) { sp = 8; }
    q = q / 2;
    let pal:i64 = q % 4; q = q / 4;
    let sh:i64 = q % 2; q = q / 2;
    let bo:i64 = q % 2;
    th_palette(th, pal);
    thwput(th, 15, rad); thwput(th, 16, sp);
    thwput(th, 17, 20); thwput(th, 18, 24);
    thwput(th, 19, sh); thwput(th, 20, bo);
    thwput(th, 21, 3); thwput(th, 22, 2); thwput(th, 23, 1);
    thwput(th, 24, 16); thwput(th, 25, 12); thwput(th, 26, 24);
}
fn N_CAND() i64 { return 224; }

// ---------- icon buttons ----------
fn c_ibtn(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64, screen:i64, name:i64, cx:i64, cy:i64, r:i64, kind:i64) void {
    if (mode == 0 || mode == 2) {
        if (kind == 0) {
            d_circle(px, W, H, cx, cy, r, th_acc(th,0), th_acc(th,1), th_acc(th,2));
            let bx:i64 = th_bg(th,0); let by:i64 = th_bg(th,1); let bz:i64 = th_bg(th,2);
            d_trif(px, W, H, cx - 7, cy - 11, cx - 7, cy + 11, cx + 10, cy, bx, by, bz);
        } else if (kind == 1) {
            d_ring(px, W, H, cx, cy, r, 2, th_mut(th,0), th_mut(th,1), th_mut(th,2));
            let tr:i64 = th_txt(th,0); let tg:i64 = th_txt(th,1); let tb:i64 = th_txt(th,2);
            d_rect(px, W, H, cx - 11, cy - 8, 4, 16, tr, tg, tb);
            d_trif(px, W, H, cx + 9, cy - 8, cx - 4, cy, cx + 9, cy + 8, tr, tg, tb);
        } else if (kind == 2) {
            d_ring(px, W, H, cx, cy, r, 2, th_mut(th,0), th_mut(th,1), th_mut(th,2));
            let tr:i64 = th_txt(th,0); let tg:i64 = th_txt(th,1); let tb:i64 = th_txt(th,2);
            d_rect(px, W, H, cx + 7, cy - 8, 4, 16, tr, tg, tb);
            d_trif(px, W, H, cx - 9, cy - 8, cx + 4, cy, cx - 9, cy + 8, tr, tg, tb);
        } else if (kind == 3) {
            let mr:i64 = th_mut(th,0); let mg:i64 = th_mut(th,1); let mb:i64 = th_mut(th,2);
            d_line(px, W, H, cx - 10, cy - 8, cx + 10, cy + 8, mr, mg, mb);
            d_line(px, W, H, cx - 10, cy + 8, cx + 10, cy - 8, mr, mg, mb);
            d_line(px, W, H, cx + 10, cy - 8, cx + 4, cy - 8, mr, mg, mb);
            d_line(px, W, H, cx + 10, cy - 8, cx + 10, cy - 2, mr, mg, mb);
        } else {
            let mr:i64 = th_mut(th,0); let mg:i64 = th_mut(th,1); let mb:i64 = th_mut(th,2);
            d_rrect(px, W, H, cx - 10, cy - 7, 20, 14, 4, mr, mg, mb);
            d_rrect(px, W, H, cx - 8, cy - 5, 16, 10, 3, th_bg(th,0), th_bg(th,1), th_bg(th,2));
            d_line(px, W, H, cx - 2, cy - 11, cx - 2, cy - 5, mr, mg, mb);
            d_line(px, W, H, cx - 6, cy - 7, cx - 2, cy - 11, mr, mg, mb);
            d_line(px, W, H, cx + 2, cy - 7, cx - 2, cy - 11, mr, mg, mb);
        }
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, screen, K_IBTN(), name, cx - r, cy - r, r * 2, r * 2, 0, kind);
    }
}

// ---------- screens ----------
fn scr_library(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64) void {
    let s:i64 = S_LIB();
    let ph:i64 = thw(th, 17);
    let vr:i64 = thw(th, 25); let vs:i64 = thw(th, 26);
    if (mode == 0 || mode == 2) { d_fill(px, W, H, th_bg(th,0), th_bg(th,1), th_bg(th,2)); }
    c_navbar(px, W, H, th, sp, rn, mode, s, N_NAV(), "Library", 1, 0);
    let y:i64 = 56 + vr;
    c_textfield(px, W, H, th, sp, rn, mode, s, N_SEARCH(), ph, y, W - 2 * ph, 40, "Search songs, artists", 2);
    y = y + 40 + vs;
    if (mode == 0 || mode == 2) {
        d_text(px, W, H, ph, y, thw(th,22), th_txt(th,0), th_txt(th,1), th_txt(th,2), "Made for you");
        d_text_r(px, W, H, W - ph, y + 4, thw(th,23), th_mut(th,0), th_mut(th,1), th_mut(th,2), "See all");
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, s, K_LBL(), 0, ph, y, d_text_w("Made for you", thw(th,22)), 14, 33, 0);
    }
    y = y + 22 + vr;
    let i:i64 = 0;
    while (i < 5) {
        let playing:i64 = 0;
        if (i == 1) { playing = 1; }
        c_listrow(px, W, H, th, sp, rn, mode, s, N_ROW() + i, ph, y, W - 2 * ph, 100 + i * 37, d_song_title(i), 6 + i, d_song_artist(i), 11 + i, d_song_dur(i), 16 + i, playing);
        y = y + 64 + vr;
        i = i + 1;
    }
    c_tabbar(px, W, H, th, sp, rn, mode, s, N_TAB(), 0);
}
fn scr_nowplaying(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64) void {
    let s:i64 = S_PLAY();
    let ph:i64 = thw(th, 17);
    if (mode == 0 || mode == 2) { d_fill(px, W, H, th_bg(th,0), th_bg(th,1), th_bg(th,2)); }
    c_navbar(px, W, H, th, sp, rn, mode, s, N_NAV(), "Now Playing", 5, 1);
    let asz:i64 = 260;
    let ax:i64 = (W - asz) / 2;
    let ay:i64 = 76;
    let arad:i64 = thw(th, 15) + 8;
    if (arad > 28) { arad = 28; }
    if (mode == 0 || mode == 2) {
        if (thw(th, 19) == 1) { d_shadow(px, W, H, ax, ay, asz, asz, arad, 8); }
        art_album(px, W, H, ax, ay, asz, 4242, arad, th_acc(th,0), th_acc(th,1), th_acc(th,2));
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, s, K_ART(), N_ART(), ax, ay, asz, asz, 28, 4242);
    }
    let ty:i64 = ay + asz + 12;
    if (mode == 0 || mode == 2) {
        d_text_c(px, W, H, W / 2, ty, thw(th,21), th_txt(th,0), th_txt(th,1), th_txt(th,2), "Midnight Circuits");
        d_text_c(px, W, H, W / 2, ty + 28, thw(th,22), th_mut(th,0), th_mut(th,1), th_mut(th,2), "Glass Antenna");
        d_text(px, W, H, ph, ty + 60, thw(th,23), th_mut(th,0), th_mut(th,1), th_mut(th,2), "1:12");
        d_text_r(px, W, H, W - ph, ty + 60, thw(th,23), th_mut(th,0), th_mut(th,1), th_mut(th,2), "3:47");
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, s, K_LBL(), 0, W/2 - d_text_w("Midnight Circuits", thw(th,21))/2, ty, d_text_w("Midnight Circuits", thw(th,21)), 21, 28, 0);
        sp_add(sp, rn, s, K_LBL(), 0, W/2 - d_text_w("Glass Antenna", thw(th,22))/2, ty+28, d_text_w("Glass Antenna", thw(th,22)), 14, 29, 0);
    }
    c_slider(px, W, H, th, sp, rn, mode, s, N_PROG(), ph, ty + 76, W - 2 * ph, 317);
    let cy:i64 = ty + 76 + 32 + 34;
    c_ibtn(px, W, H, th, sp, rn, mode, s, N_SHUFFLE(), ph + 20, cy, 14, 3);
    c_ibtn(px, W, H, th, sp, rn, mode, s, N_PREV(), W / 2 - 64, cy, 20, 1);
    c_ibtn(px, W, H, th, sp, rn, mode, s, N_PLAY(), W / 2, cy, 30, 0);
    c_ibtn(px, W, H, th, sp, rn, mode, s, N_NEXT(), W / 2 + 64, cy, 20, 2);
    c_ibtn(px, W, H, th, sp, rn, mode, s, N_REPEAT(), W - ph - 20, cy, 14, 4);
    if (mode == 0 || mode == 2) {
        d_text(px, W, H, ph, cy + 44, thw(th,23), th_mut(th,0), th_mut(th,1), th_mut(th,2), "Volume");
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, s, K_LBL(), 0, ph, cy + 44, d_text_w("Volume", thw(th,23)), 7, 36, 0);
    }
    c_slider(px, W, H, th, sp, rn, mode, s, N_VOL(), ph, cy + 56, W - 2 * ph, 700);
    c_tabbar(px, W, H, th, sp, rn, mode, s, N_TAB(), 1);
}
fn scr_settings(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64) void {
    let s:i64 = S_SET();
    let ph:i64 = thw(th, 17);
    let vr:i64 = thw(th, 25); let vs:i64 = thw(th, 26);
    let cp:i64 = thw(th, 24);
    if (mode == 0 || mode == 2) { d_fill(px, W, H, th_bg(th,0), th_bg(th,1), th_bg(th,2)); }
    c_navbar(px, W, H, th, sp, rn, mode, s, N_NAV(), "Settings", 4, 1);
    let y:i64 = 56 + vr;
    let cw:i64 = W - 2 * ph;
    c_card(px, W, H, th, sp, rn, mode, s, N_PROFILE(), ph, y, cw, 96);
    c_avatar(px, W, H, th, sp, rn, mode, s, N_PROFILE(), ph + cp, y + 16, 64, 7);
    if (mode == 0 || mode == 2) {
        d_text(px, W, H, ph + cp + 76, y + 28, thw(th,22), th_txt(th,0), th_txt(th,1), th_txt(th,2), "Ada");
        d_text(px, W, H, ph + cp + 76, y + 52, thw(th,23), th_mut(th,0), th_mut(th,1), th_mut(th,2), "Premium member");
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, s, K_LBL(), N_PROFILE(), ph + cp + 76, y + 28, d_text_w("Ada", thw(th,22)), 14, 26, 0);
        sp_add(sp, rn, s, K_LBL(), N_PROFILE(), ph + cp + 76, y + 52, d_text_w("Premium member", thw(th,23)), 7, 27, 0);
    }
    y = y + 96 + vs;
    c_settingrow(px, W, H, th, sp, rn, mode, s, 21, ph, y, cw, "High quality audio", 21, 0, 1);
    y = y + 56;
    c_settingrow(px, W, H, th, sp, rn, mode, s, 22, ph, y, cw, "Normalize volume", 22, 0, 1);
    y = y + 56;
    c_settingrow(px, W, H, th, sp, rn, mode, s, 23, ph, y, cw, "Offline mode", 23, 0, 0);
    y = y + 56;
    c_settingrow(px, W, H, th, sp, rn, mode, s, 25, ph, y, cw, "About Waveform", 25, 1, 0);
    y = y + 56 + vr;
    if (mode == 0 || mode == 2) {
        d_text(px, W, H, ph, y, thw(th,22), th_txt(th,0), th_txt(th,1), th_txt(th,2), "Crossfade");
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, s, K_LBL(), N_XFADE(), ph, y, d_text_w("Crossfade", thw(th,22)), 14, 24, 0);
    }
    c_slider(px, W, H, th, sp, rn, mode, s, N_XFADE(), ph, y + 22, cw, 350);
    c_tabbar(px, W, H, th, sp, rn, mode, s, N_TAB(), 2);
}
fn scr_sheet(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64) void {
    let s:i64 = 9;
    let ph:i64 = 20;
    if (mode == 0 || mode == 2) {
        d_fill(px, W, H, th_bg(th,0), th_bg(th,1), th_bg(th,2));
        d_text(px, W, H, ph, 24, 3, th_txt(th,0), th_txt(th,1), th_txt(th,2), "Waveform UI Kit");
        d_text(px, W, H, ph, 52, 1, th_mut(th,0), th_mut(th,1), th_mut(th,2), "every pixel from zag");
    }
    let y:i64 = 84;
    if (mode == 0 || mode == 2) { d_text(px, W, H, ph, y, 2, th_txt(th,0), th_txt(th,1), th_txt(th,2), "Buttons"); }
    y = y + 28;
    c_button(px, W, H, th, sp, rn, mode, s, 1, ph, y, 100, 40, "Play", 3, 0);
    c_button(px, W, H, th, sp, rn, mode, s, 2, ph + 112, y, 100, 40, "Play", 3, 1);
    c_button(px, W, H, th, sp, rn, mode, s, 3, ph + 224, y, 100, 40, "Play", 3, 2);
    y = y + 56;
    if (mode == 0 || mode == 2) { d_text(px, W, H, ph, y, 2, th_txt(th,0), th_txt(th,1), th_txt(th,2), "Text field"); }
    y = y + 28;
    c_textfield(px, W, H, th, sp, rn, mode, s, 4, ph, y, W - 2 * ph, 40, "Search songs, artists", 2);
    y = y + 56;
    if (mode == 0 || mode == 2) { d_text(px, W, H, ph, y, 2, th_txt(th,0), th_txt(th,1), th_txt(th,2), "Toggles + slider"); }
    y = y + 28;
    c_toggle(px, W, H, th, sp, rn, mode, s, 5, ph, y, 1);
    c_toggle(px, W, H, th, sp, rn, mode, s, 6, ph + 64, y, 0);
    c_slider(px, W, H, th, sp, rn, mode, s, 7, ph + 140, y, 160, 650);
    y = y + 48;
    if (mode == 0 || mode == 2) { d_text(px, W, H, ph, y, 2, th_txt(th,0), th_txt(th,1), th_txt(th,2), "List row + avatar"); }
    y = y + 28;
    c_listrow(px, W, H, th, sp, rn, mode, s, 8, ph, y, W - 2 * ph, 555, "Neon Skyline", 6, "Glass Antenna", 11, "3:24", 16, 1);
    y = y + 76;
    c_avatar(px, W, H, th, sp, rn, mode, s, 9, ph, y, 56, 7);
    c_card(px, W, H, th, sp, rn, mode, s, 10, ph + 76, y, 160, 56);
    if (mode == 0 || mode == 2) {
        d_text(px, W, H, ph + 76 + 16, y + 20, 2, th_txt(th,0), th_txt(th,1), th_txt(th,2), "Card");
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, s, K_LBL(), 10, ph + 76 + 16, y + 20, d_text_w("Card", 2), 14, 0, 0);
    }
}

// ---------- aesthetic scorer: TNN's own opinion, deterministic ----------
// Scores a candidate theme by measuring the actual screen specs it produces.
fn sc_lum(r:i64, g:i64, b:i64) i64 {
    return (299 * r + 587 * g + 114 * b) / 1000;
}
fn sc_contrast(r1:i64, g1:i64, b1:i64, r2:i64, g2:i64, b2:i64) i64 {
    let l1:i64 = sc_lum(r1, g1, b1);
    let l2:i64 = sc_lum(r2, g2, b2);
    let hi:i64 = l1; let lo:i64 = l2;
    if (l2 > l1) { hi = l2; lo = l1; }
    return (hi + 5) * 100 / (lo + 5);
}
fn sc_build_sp(th:[]u8, sp:[]u8, rn:[]u8, W:i64, H:i64) void {
    let px:[]u8 = nio_alloc(3);
    scr_library(px, W, H, th, sp, rn, 1);
    scr_nowplaying(px, W, H, th, sp, rn, 1);
    scr_settings(px, W, H, th, sp, rn, 1);
    nio_free(px);
}
fn score_candidate(idx:i64) i64 {
    let th:[]u8 = th_new();
    theme_candidate(th, idx);
    let sp:[]u8 = nio_alloc(4 + 200 * 40);
    let rn:[]u8 = nio_alloc(4);
    sc_build_sp(th, sp, rn, 360, 640);
    let n:i64 = sp_n(sp);
    let spacing:i64 = thw(th, 16);
    // contrast: weakest of text/bg, accent/bg, muted/bg
    let c1:i64 = sc_contrast(th_txt(th,0), th_txt(th,1), th_txt(th,2), th_bg(th,0), th_bg(th,1), th_bg(th,2));
    let c2:i64 = sc_contrast(th_acc(th,0), th_acc(th,1), th_acc(th,2), th_bg(th,0), th_bg(th,1), th_bg(th,2));
    let c3:i64 = sc_contrast(th_mut(th,0), th_mut(th,1), th_mut(th,2), th_bg(th,0), th_bg(th,1), th_bg(th,2));
    let cmin:i64 = c1;
    if (c2 < cmin) { cmin = c2; }
    if (c3 < cmin) { cmin = c3; }
    let cn:i64 = cmin;
    if (cn > 400) { cn = 400; }
    let s_contrast:i64 = cn / 4;
    // economy: fewer colors better
    let ncol:i64 = 5 + thw(th, 19) + thw(th, 20);
    let s_econ:i64 = 120 - 12 * ncol;
    // regularity: fraction of rect values divisible by spacing
    let tot:i64 = 0; let ok:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let f:i64 = 3;
        while (f <= 6) {
            let v:i64 = sp_get(sp, i, f);
            if (v < 0) { v = 0 - v; }
            tot = tot + 1;
            if (v % spacing == 0) { ok = ok + 1; }
            f = f + 1;
        }
        i = i + 1;
    }
    let s_reg:i64 = 0;
    if (tot > 0) { s_reg = ok * 100 / tot; }
    // alignment: shares x with another, or centered
    let ali:i64 = 0;
    i = 0;
    while (i < n) {
        let s:i64 = sp_get(sp, i, 0);
        let x:i64 = sp_get(sp, i, 3);
        let w:i64 = sp_get(sp, i, 5);
        let hit:i64 = 0;
        if (x + w / 2 == 180) { hit = 1; }
        let j:i64 = 0;
        while (j < n) {
            if (j != i && sp_get(sp, j, 0) == s && sp_get(sp, j, 3) == x) { hit = 1; }
            j = j + 1;
        }
        ali = ali + hit;
        i = i + 1;
    }
    let s_ali:i64 = 0;
    if (n > 0) { s_ali = ali * 100 / n; }
    // symmetry: left vs right area per screen
    let s_sym:i64 = 0;
    let s:i64 = 1;
    while (s <= 3) {
        let al:i64 = 0; let ar2:i64 = 0;
        i = 0;
        while (i < n) {
            if (sp_get(sp, i, 0) == s) {
                let x:i64 = sp_get(sp, i, 3);
                let w:i64 = sp_get(sp, i, 5);
                let h:i64 = sp_get(sp, i, 6);
                let cx:i64 = x + w / 2;
                let a:i64 = w * h;
                if (cx < 180) { al = al + a; }
                if (cx > 180) { ar2 = ar2 + a; }
                if (cx == 180) { al = al + a / 2; ar2 = ar2 + a / 2; }
            }
            i = i + 1;
        }
        let diff:i64 = al - ar2;
        if (diff < 0) { diff = 0 - diff; }
        s_sym = s_sym + 100 - diff * 100 / (al + ar2 + 1);
        s = s + 1;
    }
    s_sym = s_sym / 3;
    let total:i64 = s_contrast + s_econ + s_reg + s_ali + s_sym;
    nio_free(th); nio_free(sp); nio_free(rn);
    return total;
}
fn v1_winner() i64 {
    let best:i64 = 0;
    let bs:i64 = score_candidate(0);
    let i:i64 = 1;
    while (i < N_CAND()) {
        let sc:i64 = score_candidate(i);
        if (sc > bs) { bs = sc; best = i; }
        i = i + 1;
    }
    return best;
}
fn theme_v1(th:[]u8) void {
    theme_candidate(th, v1_winner());
}

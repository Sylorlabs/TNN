// mind.zag — TNN's "in-head" query engine: answers design queries from the
// spec table WITHOUT rendering (mode 1 builders never touch the pixel buffer
// meaningfully; answers derive from the mental model, not from pixels).
@import("screens.zag")

fn m_count_kind(sp:[]u8, screen:i64, kind:i64) i64 {
    let n:i64 = sp_n(sp);
    let c:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        if (sp_get(sp, i, 0) == screen && sp_get(sp, i, 1) == kind) { c = c + 1; }
        i = i + 1;
    }
    return c;
}
fn m_find(sp:[]u8, screen:i64, kind:i64, name:i64) i64 {
    let n:i64 = sp_n(sp);
    let i:i64 = 0;
    while (i < n) {
        if (sp_get(sp, i, 0) == screen && sp_get(sp, i, 1) == kind && sp_get(sp, i, 2) == name) { return i; }
        i = i + 1;
    }
    return -1;
}
fn m_left_of(sp:[]u8, screen:i64, ref:i64) i64 {
    // name of nearest component strictly left of ref (max x+w <= ref.x)
    let rx:i64 = sp_get(sp, ref, 3);
    let best:i64 = -1;
    let bx:i64 = -1;
    let n:i64 = sp_n(sp);
    let i:i64 = 0;
    while (i < n) {
        if (i != ref && sp_get(sp, i, 0) == screen) {
            let x:i64 = sp_get(sp, i, 3);
            let w:i64 = sp_get(sp, i, 5);
            if (x + w <= rx && x + w > bx) { bx = x + w; best = i; }
        }
        i = i + 1;
    }
    if (best < 0) { return -1; }
    return sp_get(sp, best, 2);
}
fn m_right_of(sp:[]u8, screen:i64, ref:i64) i64 {
    let rx:i64 = sp_get(sp, ref, 3);
    let rw:i64 = sp_get(sp, ref, 5);
    let best:i64 = -1;
    let bx:i64 = 99999;
    let n:i64 = sp_n(sp);
    let i:i64 = 0;
    while (i < n) {
        if (i != ref && sp_get(sp, i, 0) == screen) {
            let x:i64 = sp_get(sp, i, 3);
            if (x >= rx + rw && x < bx) { bx = x; best = i; }
        }
        i = i + 1;
    }
    if (best < 0) { return -1; }
    return sp_get(sp, best, 2);
}
fn m_count_screen(sp:[]u8, screen:i64) i64 {
    let n:i64 = sp_n(sp);
    let c:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        if (sp_get(sp, i, 0) == screen) { c = c + 1; }
        i = i + 1;
    }
    return c;
}
fn m_tog_off_label(sp:[]u8, screen:i64) i64 {
    // name of first toggle with extra==0 on screen
    let n:i64 = sp_n(sp);
    let i:i64 = 0;
    while (i < n) {
        if (sp_get(sp, i, 0) == screen && sp_get(sp, i, 1) == K_TOG() && sp_get(sp, i, 8) == 0) {
            return sp_get(sp, i, 2);
        }
        i = i + 1;
    }
    return -1;
}
fn m_row_playing_tid(sp:[]u8, screen:i64) i64 {
    let n:i64 = sp_n(sp);
    let i:i64 = 0;
    while (i < n) {
        if (sp_get(sp, i, 0) == screen && sp_get(sp, i, 1) == K_ROW() && sp_get(sp, i, 8) == 1) {
            return sp_get(sp, i, 7);
        }
        i = i + 1;
    }
    return -1;
}
fn m_q(sp:[]u8, th:[]u8, q:i64) void {
    _zag_print("Q");
    _zag_print(_zag_i64_to_str(q));
    _zag_print(": ");
    if (q == 1) { _zag_println(_zag_i64_to_str(m_count_kind(sp, S_LIB(), K_ROW()))); }
    else if (q == 2) { _zag_println(_zag_i64_to_str(m_count_kind(sp, S_SET(), K_TOG()))); }
    else if (q == 3) {
        let i:i64 = m_find(sp, S_LIB(), K_TXT(), N_SEARCH());
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 3)));
    }
    else if (q == 4) {
        let i:i64 = m_find(sp, S_LIB(), K_TAB(), N_TAB());
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 4)));
    }
    else if (q == 5) {
        let i:i64 = m_find(sp, S_PLAY(), K_IBTN(), N_PLAY());
        _zag_println(_zag_i64_to_str(m_left_of(sp, S_PLAY(), i)));
    }
    else if (q == 6) {
        let i:i64 = m_find(sp, S_PLAY(), K_IBTN(), N_PLAY());
        _zag_println(_zag_i64_to_str(m_right_of(sp, S_PLAY(), i)));
    }
    else if (q == 7) { _zag_println(_zag_i64_to_str(thw(th, 15))); }
    else if (q == 8) { _zag_println(_zag_i64_to_str(thw(th, 16))); }
    else if (q == 9) {
        _zag_print(_zag_i64_to_str(th_acc(th,0))); _zag_print(" ");
        _zag_print(_zag_i64_to_str(th_acc(th,1))); _zag_print(" ");
        _zag_println(_zag_i64_to_str(th_acc(th,2)));
    }
    else if (q == 10) {
        let i:i64 = m_find(sp, S_PLAY(), K_ART(), N_ART());
        let cx:i64 = sp_get(sp, i, 3) + sp_get(sp, i, 5) / 2;
        if (cx == 180) { _zag_println("1"); } else { _zag_println("0"); }
    }
    else if (q == 11) {
        let i:i64 = m_find(sp, S_LIB(), K_TXT(), N_SEARCH());
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 4) - 56));
    }
    else if (q == 12) { _zag_println(_zag_i64_to_str(m_count_kind(sp, S_PLAY(), K_IBTN()))); }
    else if (q == 13) {
        _zag_println(d_label_str(m_row_playing_tid(sp, S_LIB())));
    }
    else if (q == 14) {
        let i:i64 = m_find(sp, S_LIB(), K_ROW(), N_ROW());
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 5)));
    }
    else if (q == 15) {
        let i:i64 = m_find(sp, S_PLAY(), K_SLD(), N_VOL());
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 8)));
    }
    else if (q == 16) {
        let i:i64 = m_find(sp, S_SET(), K_SLD(), N_XFADE());
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 8)));
    }
    else if (q == 17) {
        let i:i64 = m_find(sp, S_PLAY(), K_SLD(), N_PROG());
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 8)));
    }
    else if (q == 18) { _zag_println(_zag_i64_to_str(m_tog_off_label(sp, S_SET()))); }
    else if (q == 19) { _zag_println(_zag_i64_to_str(m_count_kind(sp, S_PLAY(), K_LBL()))); }
    else if (q == 20) {
        let i:i64 = m_find(sp, S_SET(), K_AVA(), N_PROFILE());
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 5)));
    }
    else if (q == 21) {
        let i:i64 = m_find(sp, S_SET(), K_TAB(), N_TAB());
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 8)));
    }
    else if (q == 22) {
        let i:i64 = m_find(sp, S_LIB(), K_NAV(), N_NAV());
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 8)));
    }
    else if (q == 23) { _zag_println(_zag_i64_to_str(m_count_screen(sp, S_LIB()))); }
    else if (q == 24) {
        let i:i64 = m_find(sp, S_PLAY(), K_SLD(), N_VOL());
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 4)));
    }
    else { _zag_println("?"); }
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let ver:i64 = 2;
    if (_zag_strcmp(a1, "v1") == 1) { ver = 1; }
    let th:[]u8 = th_new();
    if (ver == 1) { theme_v1(th); } else { theme_v2(th); }
    _zag_print("VERSION ");
    _zag_println(_zag_i64_to_str(ver));
    _zag_print("TH ");
    _zag_print(_zag_i64_to_str(thw(th,15))); _zag_print(" ");
    _zag_print(_zag_i64_to_str(thw(th,16))); _zag_print(" ");
    _zag_print(_zag_i64_to_str(th_acc(th,0))); _zag_print(" ");
    _zag_print(_zag_i64_to_str(th_acc(th,1))); _zag_print(" ");
    _zag_println(_zag_i64_to_str(th_acc(th,2)));
    let sp:[]u8 = nio_alloc(4 + 200 * 40);
    let rn:[]u8 = nio_alloc(4);
    sc_build_sp(th, sp, rn, 360, 640);
    _zag_print("SPEC ");
    _zag_println(_zag_i64_to_str(sp_n(sp)));
    let n:i64 = sp_n(sp);
    let i:i64 = 0;
    while (i < n) {
        _zag_print("R ");
        _zag_print(_zag_i64_to_str(sp_get(sp, i, 0))); _zag_print(" ");
        _zag_print(_zag_i64_to_str(sp_get(sp, i, 1))); _zag_print(" ");
        _zag_print(_zag_i64_to_str(sp_get(sp, i, 2))); _zag_print(" ");
        _zag_print(_zag_i64_to_str(sp_get(sp, i, 3))); _zag_print(" ");
        _zag_print(_zag_i64_to_str(sp_get(sp, i, 4))); _zag_print(" ");
        _zag_print(_zag_i64_to_str(sp_get(sp, i, 5))); _zag_print(" ");
        _zag_print(_zag_i64_to_str(sp_get(sp, i, 6))); _zag_print(" ");
        _zag_print(_zag_i64_to_str(sp_get(sp, i, 7))); _zag_print(" ");
        _zag_println(_zag_i64_to_str(sp_get(sp, i, 8)));
        i = i + 1;
    }
    let q:i64 = 1;
    while (q <= 24) {
        m_q(sp, th, q);
        q = q + 1;
    }
    nio_free(th); nio_free(sp); nio_free(rn);
    return 0;
}

// 5x7 bitmap font, ASCII 32..126. Packed column-major:
// byte = column, bit r (0..6) = row r pixel. Generated by gen_font.py.
// d_font_px(code,col,row) -> 0/1
fn d_font_px(code:i64, col:i64, row:i64) i64 {
    let c:i64 = code - 32;
    if (c < 0 || c > 94 || col < 0 || col > 4 || row < 0 || row > 6) { return 0; }
    let b:i64 = d_font_byte(c * 5 + col);
    return (b >> row) & 1;

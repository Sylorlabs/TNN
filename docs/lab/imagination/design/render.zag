// render.zag — renders V1/V2 screens to BMP. Every pixel from Zag.
@import("screens.zag")

fn r_theme(th:[]u8, ver:i64) void {
    if (ver == 1) { theme_v1(th); } else { theme_v2(th); }
}
fn r_print_theme(th:[]u8) void {
    _zag_print("theme bg=");
    _zag_print(_zag_i64_to_str(th_bg(th,0))); _zag_print(",");
    _zag_print(_zag_i64_to_str(th_bg(th,1))); _zag_print(",");
    _zag_print(_zag_i64_to_str(th_bg(th,2)));
    _zag_print(" surf=");
    _zag_print(_zag_i64_to_str(th_surf(th,0))); _zag_print(",");
    _zag_print(_zag_i64_to_str(th_surf(th,1))); _zag_print(",");
    _zag_print(_zag_i64_to_str(th_surf(th,2)));
    _zag_print(" acc=");
    _zag_print(_zag_i64_to_str(th_acc(th,0))); _zag_print(",");
    _zag_print(_zag_i64_to_str(th_acc(th,1))); _zag_print(",");
    _zag_print(_zag_i64_to_str(th_acc(th,2)));
    _zag_print(" txt=");
    _zag_print(_zag_i64_to_str(th_txt(th,0))); _zag_print(",");
    _zag_print(_zag_i64_to_str(th_txt(th,1))); _zag_print(",");
    _zag_print(_zag_i64_to_str(th_txt(th,2)));
    _zag_print(" mut=");
    _zag_print(_zag_i64_to_str(th_mut(th,0))); _zag_print(",");
    _zag_print(_zag_i64_to_str(th_mut(th,1))); _zag_print(",");
    _zag_print(_zag_i64_to_str(th_mut(th,2)));
    _zag_print(" rad="); _zag_print(_zag_i64_to_str(thw(th,15)));
    _zag_print(" sp="); _zag_print(_zag_i64_to_str(thw(th,16)));
    _zag_print(" sh="); _zag_print(_zag_i64_to_str(thw(th,19)));
    _zag_print(" bo="); _zag_print(_zag_i64_to_str(thw(th,20)));
    _zag_println("");
}
fn r_one(ver:i64, scr:i64, dir:[]u8, vname:[]u8) i64 {
    let W:i64 = 360; let H:i64 = 640;
    let th:[]u8 = th_new();
    r_theme(th, ver);
    let px:[]u8 = d_new(W, H);
    if (px.len == 0) { return -20; }
    let sp:[]u8 = nio_alloc(4 + 200 * 40);
    let rn:[]u8 = nio_alloc(4);
    if (scr == 1) { scr_library(px, W, H, th, sp, rn, 2); }
    if (scr == 2) { scr_nowplaying(px, W, H, th, sp, rn, 2); }
    if (scr == 3) { scr_settings(px, W, H, th, sp, rn, 2); }
    if (scr == 9) { scr_sheet(px, W, H, th, sp, rn, 2); }
    let sname:[]u8 = "library";
    if (scr == 2) { sname = "nowplaying"; }
    if (scr == 3) { sname = "settings"; }
    if (scr == 9) { sname = "sheet"; }
    // build filename: v1_library.bmp
    let fn_:[]u8 = nio_alloc(32);
    let o:i64 = 0;
    let i:i64 = 0;
    while (i < vname.len) { fn_[o] = vname[i]; o = o + 1; i = i + 1; }
    fn_[o] = 95 as u8; o = o + 1;
    i = 0;
    while (i < sname.len) { fn_[o] = sname[i]; o = o + 1; i = i + 1; }
    fn_[o] = 46 as u8; fn_[o+1] = 98 as u8; fn_[o+2] = 109 as u8; fn_[o+3] = 112 as u8; o = o + 4;
    let name:[]u8 = nio_alloc(o);
    i = 0;
    while (i < o) { name[i] = fn_[i]; i = i + 1; }
    nio_free(fn_);
    let rc:i64 = d_emit_bmp(px, W, H, dir, name);
    _zag_print("render "); _zag_print(name);
    _zag_print(" rc="); _zag_println(_zag_i64_to_str(rc));
    nio_free(name); nio_free(px); nio_free(sp); nio_free(rn); nio_free(th);
    return rc;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if (_zag_strcmp(a1, "score") == 1) {
        let i:i64 = 0;
        while (i < N_CAND()) {
            _zag_print(_zag_i64_to_str(i));
            _zag_print(" ");
            _zag_println(_zag_i64_to_str(score_candidate(i)));
            i = i + 1;
        }
        let w:i64 = v1_winner();
        _zag_print("WINNER ");
        _zag_println(_zag_i64_to_str(w));
        let th:[]u8 = th_new();
        theme_v1(th);
        r_print_theme(th);
        nio_free(th);
        return 0;
    }
    if (_zag_strcmp(a1, "render") == 1) {
        let a2:[]u8 = _zag_arg(2);
        let a3:[]u8 = _zag_arg(3);
        let a4:[]u8 = _zag_arg(4);
        let ver:i64 = 2;
        if (_zag_strcmp(a2, "v1") == 1) { ver = 1; }
        let vname:[]u8 = "v2";
        if (ver == 1) { vname = "v1"; }
        let th0:[]u8 = th_new();
        r_theme(th0, ver);
        r_print_theme(th0);
        nio_free(th0);
        let rc:i64 = 0;
        if (_zag_strcmp(a3, "all") == 1) {
            rc = r_one(ver, 1, a4, vname);
            if (rc == 0) { rc = r_one(ver, 2, a4, vname); }
            if (rc == 0) { rc = r_one(ver, 3, a4, vname); }
            if (rc == 0) { rc = r_one(ver, 9, a4, vname); }
        } else {
            let scr:i64 = 1;
            if (_zag_strcmp(a3, "play") == 1) { scr = 2; }
            if (_zag_strcmp(a3, "set") == 1) { scr = 3; }
            if (_zag_strcmp(a3, "sheet") == 1) { scr = 9; }
            rc = r_one(ver, scr, a4, vname);
        }
        if (rc != 0) { return 2; }
        return 0;
    }
    _zag_println("usage: render.zag score | render <v1|v2> <lib|play|set|sheet|all> <dir>");
    return 1;
}

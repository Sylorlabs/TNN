// toolkit.zag — pure-Zag UI toolkit. Every pixel from Zag.
// Canvas: []u8 RGB top-down, W*H*3. Theme: []u8 word arena (see TH_ ids).
@import("../../toolchain/R33_NATIVE_IO_V1.zag")
@import("font.zag")

// ---------- theme word ids ----------
fn thw(th:[]u8, w:i64) i64 {
    let at:i64 = w * 4;
    return (th[at] as i64) + (th[at+1] as i64) * 256 + (th[at+2] as i64) * 65536 + (th[at+3] as i64) * 16777216;
}
fn thwput(th:[]u8, w:i64, v:i64) void {
    let at:i64 = w * 4;
    th[at] = (v & 255) as u8;
    th[at+1] = ((v >> 8) & 255) as u8;
    th[at+2] = ((v >> 16) & 255) as u8;
    th[at+3] = ((v >> 24) & 255) as u8;
}
// words: 0..2 bg rgb, 3..5 surface rgb, 6..8 accent rgb, 9..11 text rgb,
// 12..14 muted rgb, 15 radius, 16 spacing, 17 pad_h, 18 pad_v,
// 19 shadow(0/1), 20 border(0/1), 21 title_sc, 22 body_sc, 23 cap_sc,
// 24 card_pad, 25 vgap_rel, 26 vgap_sec
fn th_new() []u8 {
    let th:[]u8 = nio_alloc(27 * 4);
    return th;
}
fn th_set_rgb(th:[]u8, w:i64, r:i64, g:i64, b:i64) void {
    thwput(th, w, r); thwput(th, w+1, g); thwput(th, w+2, b);
}
fn th_bg(th:[]u8, c:i64) i64 { return thw(th, c); }
fn th_surf(th:[]u8, c:i64) i64 { return thw(th, 3 + c); }
fn th_acc(th:[]u8, c:i64) i64 { return thw(th, 6 + c); }
fn th_txt(th:[]u8, c:i64) i64 { return thw(th, 9 + c); }
fn th_mut(th:[]u8, c:i64) i64 { return thw(th, 12 + c); }

// ---------- canvas ----------
fn d_new(w:i64, h:i64) []u8 {
    let px:[]u8 = nio_alloc((w * h * 3) as i32);
    return px;
}
fn d_px(px:[]u8, W:i64, H:i64, x:i64, y:i64, r:i64, g:i64, b:i64) void {
    if (x < 0 || y < 0 || x >= W || y >= H) { return; }
    let at:i64 = (y * W + x) * 3;
    px[at] = (r & 255) as u8; px[at+1] = (g & 255) as u8; px[at+2] = (b & 255) as u8;
}
fn d_get(px:[]u8, W:i64, H:i64, x:i64, y:i64, c:i64) i64 {
    if (x < 0 || y < 0 || x >= W || y >= H) { return 0; }
    return px[(y * W + x) * 3 + c] as i64;
}
fn d_fill(px:[]u8, W:i64, H:i64, r:i64, g:i64, b:i64) void {
    let i:i64 = 0;
    let n:i64 = W * H;
    while (i < n) {
        let at:i64 = i * 3;
        px[at] = (r & 255) as u8; px[at+1] = (g & 255) as u8; px[at+2] = (b & 255) as u8;
        i = i + 1;
    }
}
fn d_rect(px:[]u8, W:i64, H:i64, x:i64, y:i64, w:i64, h:i64, r:i64, g:i64, b:i64) void {
    let yy:i64 = y;
    while (yy < y + h) {
        let xx:i64 = x;
        while (xx < x + w) {
            d_px(px, W, H, xx, yy, r, g, b);
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}
fn d_blend(px:[]u8, W:i64, H:i64, x:i64, y:i64, r:i64, g:i64, b:i64, a:i64) void {
    // alpha 0..256 blend over existing pixel
    if (x < 0 || y < 0 || x >= W || y >= H) { return; }
    let at:i64 = (y * W + x) * 3;
    let er:i64 = px[at] as i64; let eg:i64 = px[at+1] as i64; let eb:i64 = px[at+2] as i64;
    px[at] = ((er * (256 - a) + r * a) / 256 as i64 & 255) as u8;
    px[at+1] = ((eg * (256 - a) + g * a) / 256 as i64 & 255) as u8;
    px[at+2] = ((eb * (256 - a) + b * a) / 256 as i64 & 255) as u8;
}
fn d_rrect(px:[]u8, W:i64, H:i64, x:i64, y:i64, w:i64, h:i64, rad:i64, r:i64, g:i64, b:i64) void {
    if (w <= 0 || h <= 0) { return; }
    let rr:i64 = rad;
    if (rr * 2 > w) { rr = w / 2; }
    if (rr * 2 > h) { rr = h / 2; }
    if (rr <= 0) { d_rect(px, W, H, x, y, w, h, r, g, b); return; }
    let cx0:i64 = x + rr; let cx1:i64 = x + w - rr;
    let cy0:i64 = y + rr; let cy1:i64 = y + h - rr;
    let yy:i64 = y;
    while (yy < y + h) {
        let xx:i64 = x;
        while (xx < x + w) {
            let nx:i64 = xx;
            if (xx < cx0) { nx = cx0; }
            if (xx > cx1) { nx = cx1; }
            let ny:i64 = yy;
            if (yy < cy0) { ny = cy0; }
            if (yy > cy1) { ny = cy1; }
            let dx:i64 = xx - nx; let dy:i64 = yy - ny;
            if (dx * dx + dy * dy <= rr * rr) { d_px(px, W, H, xx, yy, r, g, b); }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}
fn d_rrect_blend(px:[]u8, W:i64, H:i64, x:i64, y:i64, w:i64, h:i64, rad:i64, r:i64, g:i64, b:i64, a:i64) void {
    if (w <= 0 || h <= 0) { return; }
    let rr:i64 = rad;
    if (rr * 2 > w) { rr = w / 2; }
    if (rr * 2 > h) { rr = h / 2; }
    if (rr <= 0) {
        let yy2:i64 = y;
        while (yy2 < y + h) {
            let xx2:i64 = x;
            while (xx2 < x + w) { d_blend(px, W, H, xx2, yy2, r, g, b, a); xx2 = xx2 + 1; }
            yy2 = yy2 + 1;
        }
        return;
    }
    let cx0:i64 = x + rr; let cx1:i64 = x + w - rr;
    let cy0:i64 = y + rr; let cy1:i64 = y + h - rr;
    let yy:i64 = y;
    while (yy < y + h) {
        let xx:i64 = x;
        while (xx < x + w) {
            let nx:i64 = xx;
            if (xx < cx0) { nx = cx0; }
            if (xx > cx1) { nx = cx1; }
            let ny:i64 = yy;
            if (yy < cy0) { ny = cy0; }
            if (yy > cy1) { ny = cy1; }
            let dx:i64 = xx - nx; let dy:i64 = yy - ny;
            if (dx * dx + dy * dy <= rr * rr) { d_blend(px, W, H, xx, yy, r, g, b, a); }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}
fn d_shadow(px:[]u8, W:i64, H:i64, x:i64, y:i64, w:i64, h:i64, rad:i64, depth:i64) void {
    d_rrect_blend(px, W, H, x, y + depth, w, h, rad, 0, 0, 0, 70);
}
fn d_circle(px:[]u8, W:i64, H:i64, cx:i64, cy:i64, rad:i64, r:i64, g:i64, b:i64) void {
    let yy:i64 = cy - rad;
    while (yy <= cy + rad) {
        let xx:i64 = cx - rad;
        while (xx <= cx + rad) {
            let dx:i64 = xx - cx; let dy:i64 = yy - cy;
            if (dx * dx + dy * dy <= rad * rad) { d_px(px, W, H, xx, yy, r, g, b); }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}
fn d_ring(px:[]u8, W:i64, H:i64, cx:i64, cy:i64, rad:i64, t:i64, r:i64, g:i64, b:i64) void {
    let yy:i64 = cy - rad - t;
    while (yy <= cy + rad + t) {
        let xx:i64 = cx - rad - t;
        while (xx <= cx + rad + t) {
            let dx:i64 = xx - cx; let dy:i64 = yy - cy;
            let d2:i64 = dx * dx + dy * dy;
            if (d2 <= (rad + t) * (rad + t) && d2 >= (rad - t) * (rad - t)) { d_px(px, W, H, xx, yy, r, g, b); }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}
fn d_hline(px:[]u8, W:i64, H:i64, x:i64, y:i64, w:i64, r:i64, g:i64, b:i64) void {
    d_rect(px, W, H, x, y, w, 1, r, g, b);
}
fn d_line(px:[]u8, W:i64, H:i64, x0:i64, y0:i64, x1:i64, y1:i64, r:i64, g:i64, b:i64) void {
    let dx:i64 = x1 - x0; if (dx < 0) { dx = 0 - dx; }
    let dy:i64 = y1 - y0; if (dy < 0) { dy = 0 - dy; }
    let sx:i64 = 1; if (x1 < x0) { sx = 0 - 1; }
    let sy:i64 = 1; if (y1 < y0) { sy = 0 - 1; }
    let err:i64 = dx - dy;
    let x:i64 = x0; let y:i64 = y0;
    let guard:i64 = 0;
    while (guard < 4096 && (x != x1 || y != y1)) {
        d_px(px, W, H, x, y, r, g, b);
        let e2:i64 = err * 2;
        if (e2 > 0 - dy) { err = err - dy; x = x + sx; }
        if (e2 < dx) { err = err + dx; y = y + sy; }
        guard = guard + 1;
    }
    d_px(px, W, H, x1, y1, r, g, b);
}
fn d_trif(px:[]u8, W:i64, H:i64, x0:i64, y0:i64, x1:i64, y1:i64, x2:i64, y2:i64, r:i64, g:i64, b:i64) void {
    // filled triangle: scanline fill between edge intersections
    let ymin:i64 = y0; let ymax:i64 = y0;
    if (y1 < ymin) { ymin = y1; } if (y2 < ymin) { ymin = y2; }
    if (y1 > ymax) { ymax = y1; } if (y2 > ymax) { ymax = y2; }
    let y:i64 = ymin;
    while (y <= ymax) {
        let xa:i64 = 99999; let xb:i64 = -99999;
        let e:i64 = 0;
        while (e < 3) {
            let ax:i64 = x0; let ay:i64 = y0; let bx:i64 = x1; let by:i64 = y1;
            if (e == 1) { ax = x1; ay = y1; bx = x2; by = y2; }
            if (e == 2) { ax = x2; ay = y2; bx = x0; by = y0; }
            if ((ay <= y && by >= y) || (by <= y && ay >= y)) {
                let x:i64 = ax;
                if (ay != by) { x = ax + (bx - ax) * (y - ay) / (by - ay); }
                if (x < xa) { xa = x; }
                if (x > xb) { xb = x; }
            }
            e = e + 1;
        }
        if (xa <= xb) { d_line(px, W, H, xa, y, xb, y, r, g, b); }
        y = y + 1;
    }
}

// ---------- text ----------
fn d_text_w(s:[]u8, sc:i64) i64 {
    if (s.len == 0) { return 0; }
    return (s.len as i64) * 6 * sc - sc;
}
fn d_glyph(px:[]u8, W:i64, H:i64, x:i64, y:i64, sc:i64, code:i64, r:i64, g:i64, b:i64) void {
    let col:i64 = 0;
    while (col < 5) {
        let row:i64 = 0;
        while (row < 7) {
            if (d_font_px(code, col, row) == 1) {
                d_rect(px, W, H, x + col * sc, y + row * sc, sc, sc, r, g, b);
            }
            row = row + 1;
        }
        col = col + 1;
    }
}
fn d_text(px:[]u8, W:i64, H:i64, x:i64, y:i64, sc:i64, r:i64, g:i64, b:i64, s:[]u8) i64 {
    let i:i64 = 0;
    let cx:i64 = x;
    while (i < s.len) {
        let code:i64 = s[i] as i64;
        if (code >= 32 && code <= 126) {
            d_glyph(px, W, H, cx, y, sc, code, r, g, b);
        }
        cx = cx + 6 * sc;
        i = i + 1;
    }
    return cx - x - sc;
}
fn d_text_c(px:[]u8, W:i64, H:i64, cx:i64, y:i64, sc:i64, r:i64, g:i64, b:i64, s:[]u8) i64 {
    let w:i64 = d_text_w(s, sc);
    return d_text(px, W, H, cx - w / 2, y, sc, r, g, b, s);
}
fn d_text_r(px:[]u8, W:i64, H:i64, rx:i64, y:i64, sc:i64, r:i64, g:i64, b:i64, s:[]u8) i64 {
    let w:i64 = d_text_w(s, sc);
    return d_text(px, W, H, rx - w, y, sc, r, g, b, s);
}

// ---------- spec recording ----------
// record: 10 words: screen, kind, name, x, y, w, h, label, extra, 0
fn sp_add(sp:[]u8, rn:[]u8, screen:i64, kind:i64, name:i64, x:i64, y:i64, w:i64, h:i64, label:i64, extra:i64) void {
    let n:i64 = (sp[0] as i64) + (sp[1] as i64) * 256 + (sp[2] as i64) * 65536 + (sp[3] as i64) * 16777216;
    let at:i64 = 4 + n * 40;
    sp[at] = (screen & 255) as u8; sp[at+1] = ((screen >> 8) & 255) as u8;
    sp[at+2] = ((screen >> 16) & 255) as u8; sp[at+3] = ((screen >> 24) & 255) as u8;
    let vals:[]u8 = nio_alloc(36);
    // pack kind..extra as 9 words after screen
    vals[0] = (kind & 255) as u8; vals[1] = ((kind >> 8) & 255) as u8; vals[2] = ((kind >> 16) & 255) as u8; vals[3] = ((kind >> 24) & 255) as u8;
    vals[4] = (name & 255) as u8; vals[5] = ((name >> 8) & 255) as u8; vals[6] = ((name >> 16) & 255) as u8; vals[7] = ((name >> 24) & 255) as u8;
    vals[8] = (x & 255) as u8; vals[9] = ((x >> 8) & 255) as u8; vals[10] = ((x >> 16) & 255) as u8; vals[11] = ((x >> 24) & 255) as u8;
    vals[12] = (y & 255) as u8; vals[13] = ((y >> 8) & 255) as u8; vals[14] = ((y >> 16) & 255) as u8; vals[15] = ((y >> 24) & 255) as u8;
    vals[16] = (w & 255) as u8; vals[17] = ((w >> 8) & 255) as u8; vals[18] = ((w >> 16) & 255) as u8; vals[19] = ((w >> 24) & 255) as u8;
    vals[20] = (h & 255) as u8; vals[21] = ((h >> 8) & 255) as u8; vals[22] = ((h >> 16) & 255) as u8; vals[23] = ((h >> 24) & 255) as u8;
    vals[24] = (label & 255) as u8; vals[25] = ((label >> 8) & 255) as u8; vals[26] = ((label >> 16) & 255) as u8; vals[27] = ((label >> 24) & 255) as u8;
    vals[28] = (extra & 255) as u8; vals[29] = ((extra >> 8) & 255) as u8; vals[30] = ((extra >> 16) & 255) as u8; vals[31] = ((extra >> 24) & 255) as u8;
    vals[32] = 0; vals[33] = 0; vals[34] = 0; vals[35] = 0;
    let k:i64 = 0;
    while (k < 36) { sp[at + 4 + k] = vals[k]; k = k + 1; }
    nio_free(vals);
    let n2:i64 = n + 1;
    sp[0] = (n2 & 255) as u8; sp[1] = ((n2 >> 8) & 255) as u8;
    sp[2] = ((n2 >> 16) & 255) as u8; sp[3] = ((n2 >> 24) & 255) as u8;
    rn[0] = (n2 & 255) as u8; rn[1] = ((n2 >> 8) & 255) as u8;
    rn[2] = ((n2 >> 16) & 255) as u8; rn[3] = ((n2 >> 24) & 255) as u8;
}
fn sp_n(sp:[]u8) i64 {
    return (sp[0] as i64) + (sp[1] as i64) * 256 + (sp[2] as i64) * 65536 + (sp[3] as i64) * 16777216;
}
fn sp_get(sp:[]u8, n:i64, f:i64) i64 {
    let at:i64 = 4 + n * 40 + f * 4;
    let v:i64 = (sp[at] as i64) + (sp[at+1] as i64) * 256 + (sp[at+2] as i64) * 65536 + (sp[at+3] as i64) * 16777216;
    if (v >= 2147483648) { v = v - 4294967296; }
    return v;
}
// kind codes
fn K_NAV() i64 { return 1; }
fn K_TAB() i64 { return 2; }
fn K_BTN() i64 { return 3; }
fn K_TXT() i64 { return 4; }
fn K_ROW() i64 { return 5; }
fn K_TOG() i64 { return 6; }
fn K_SLD() i64 { return 7; }
fn K_PRG() i64 { return 8; }
fn K_AVA() i64 { return 9; }
fn K_CARD() i64 { return 10; }
fn K_LBL() i64 { return 11; }
fn K_ART() i64 { return 12; }
fn K_SROW() i64 { return 13; }
fn K_IBTN() i64 { return 14; }

// ---------- components ----------
// mode: 0=draw, 1=record, 2=both
fn c_card(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64, screen:i64, name:i64, x:i64, y:i64, w:i64, h:i64) void {
    if (mode == 0 || mode == 2) {
        let rad:i64 = thw(th, 15);
        if (thw(th, 19) == 1) { d_shadow(px, W, H, x, y, w, h, rad, 4); }
        if (thw(th, 20) == 1) {
            d_rrect(px, W, H, x, y, w, h, rad, th_mut(th,0), th_mut(th,1), th_mut(th,2));
            d_rrect(px, W, H, x+1, y+1, w-2, h-2, rad, th_surf(th,0), th_surf(th,1), th_surf(th,2));
        } else {
            d_rrect(px, W, H, x, y, w, h, rad, th_surf(th,0), th_surf(th,1), th_surf(th,2));
        }
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, screen, K_CARD(), name, x, y, w, h, 0, 0);
    }
}
fn c_navbar(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64, screen:i64, name:i64, title:[]u8, label:i64, has_back:i64) void {
    let h:i64 = 56;
    if (mode == 0 || mode == 2) {
        d_rect(px, W, H, 0, 0, W, h, th_bg(th,0), th_bg(th,1), th_bg(th,2));
        let dr:i64 = (th_bg(th,0) + th_mut(th,0)) / 2;
        let dg:i64 = (th_bg(th,1) + th_mut(th,1)) / 2;
        let db:i64 = (th_bg(th,2) + th_mut(th,2)) / 2;
        d_hline(px, W, H, 0, h - 1, W, dr, dg, db);
        let sc:i64 = thw(th, 21);
        let tx:i64 = thw(th, 17);
        if (has_back == 1) {
            d_line(px, W, H, tx + 8, 20, tx, 28, th_txt(th,0), th_txt(th,1), th_txt(th,2));
            d_line(px, W, H, tx, 28, tx + 8, 36, th_txt(th,0), th_txt(th,1), th_txt(th,2));
            tx = tx + 24;
        }
        d_text(px, W, H, tx, h / 2 - (7 * sc) / 2, sc, th_txt(th,0), th_txt(th,1), th_txt(th,2), title);
        d_text(px, W, H, thw(th,17), 8, 1, th_mut(th,0), th_mut(th,1), th_mut(th,2), "9:41");
        d_rect(px, W, H, W - thw(th,17) - 24, 10, 22, 10, th_mut(th,0), th_mut(th,1), th_mut(th,2));
        d_rect(px, W, H, W - thw(th,17) - 22, 12, 16, 6, th_bg(th,0), th_bg(th,1), th_bg(th,2));
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, screen, K_NAV(), name, 0, 0, W, h, label, has_back);
        sp_add(sp, rn, screen, K_LBL(), name, thw(th,17), h/2-10, d_text_w(title, thw(th,21)), 20, label, 0);
    }
}
fn c_tabbar(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64, screen:i64, name:i64, active:i64) void {
    let h:i64 = 64;
    let y:i64 = H - h;
    if (mode == 0 || mode == 2) {
        d_rect(px, W, H, 0, y, W, h, th_bg(th,0), th_bg(th,1), th_bg(th,2));
        let dr:i64 = (th_bg(th,0) + th_mut(th,0)) / 2;
        let dg:i64 = (th_bg(th,1) + th_mut(th,1)) / 2;
        let db:i64 = (th_bg(th,2) + th_mut(th,2)) / 2;
        d_hline(px, W, H, 0, y, W, dr, dg, db);
        let sc:i64 = thw(th, 23);
        let i:i64 = 0;
        while (i < 3) {
            let cx:i64 = W * (i * 2 + 1) / 6;
            let s:[]u8 = "Library";
            if (i == 1) { s = "Playing"; }
            if (i == 2) { s = "Settings"; }
            let ar:i64 = th_mut(th,0); let ag:i64 = th_mut(th,1); let ab:i64 = th_mut(th,2);
            if (i == active) { ar = th_acc(th,0); ag = th_acc(th,1); ab = th_acc(th,2); }
            d_text_c(px, W, H, cx, y + 24, sc, ar, ag, ab, s);
            if (i == active) {
                d_circle(px, W, H, cx, y + 14, 3, th_acc(th,0), th_acc(th,1), th_acc(th,2));
            }
            i = i + 1;
        }
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, screen, K_TAB(), name, 0, y, W, h, 0, active);
    }
}
fn c_button(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64, screen:i64, name:i64, x:i64, y:i64, w:i64, h:i64, label:[]u8, lid:i64, style:i64) void {
    if (mode == 0 || mode == 2) {
        let rad:i64 = thw(th, 15);
        if (rad * 2 > h) { rad = h / 2; }
        let sc:i64 = thw(th, 22);
        if (style == 0) {
            if (thw(th, 19) == 1) { d_shadow(px, W, H, x, y, w, h, rad, 3); }
            d_rrect(px, W, H, x, y, w, h, rad, th_acc(th,0), th_acc(th,1), th_acc(th,2));
            d_text_c(px, W, H, x + w / 2, y + h / 2 - (7 * sc) / 2, sc, th_bg(th,0), th_bg(th,1), th_bg(th,2), label);
        } else if (style == 1) {
            d_rrect(px, W, H, x, y, w, h, rad, th_acc(th,0), th_acc(th,1), th_acc(th,2));
            d_rrect(px, W, H, x+2, y+2, w-4, h-4, rad, th_bg(th,0), th_bg(th,1), th_bg(th,2));
            d_text_c(px, W, H, x + w / 2, y + h / 2 - (7 * sc) / 2, sc, th_acc(th,0), th_acc(th,1), th_acc(th,2), label);
        } else {
            d_rrect(px, W, H, x, y, w, h, rad, th_surf(th,0), th_surf(th,1), th_surf(th,2));
            d_text_c(px, W, H, x + w / 2, y + h / 2 - (7 * sc) / 2, sc, th_txt(th,0), th_txt(th,1), th_txt(th,2), label);
        }
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, screen, K_BTN(), name, x, y, w, h, lid, style);
    }
}
fn c_textfield(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64, screen:i64, name:i64, x:i64, y:i64, w:i64, h:i64, ph:[]u8, pid:i64) void {
    if (mode == 0 || mode == 2) {
        let rad:i64 = thw(th, 15);
        if (rad * 2 > h) { rad = h / 2; }
        d_rrect(px, W, H, x, y, w, h, rad, th_surf(th,0), th_surf(th,1), th_surf(th,2));
        let sc:i64 = thw(th, 22);
        d_ring(px, W, H, x + 22, y + h / 2, 6, 2, th_mut(th,0), th_mut(th,1), th_mut(th,2));
        d_line(px, W, H, x + 27, y + h / 2 + 4, x + 33, y + h / 2 + 10, th_mut(th,0), th_mut(th,1), th_mut(th,2));
        d_text(px, W, H, x + 42, y + h / 2 - (7 * sc) / 2, sc, th_mut(th,0), th_mut(th,1), th_mut(th,2), ph);
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, screen, K_TXT(), name, x, y, w, h, pid, 0);
    }
}
fn d_hash(seed:i64) i64 {
    let h:i64 = seed * 2654435761;
    h = h ^ (h >> 13);
    h = h * 1274126177;
    h = h ^ (h >> 16);
    if (h < 0) { h = 0 - h; }
    return h;
}
fn art_mini(px:[]u8, W:i64, H:i64, x:i64, y:i64, s:i64, seed:i64, ar:i64, ag:i64, ab:i64) void {
    let h1:i64 = d_hash(seed);
    let br:i64 = (ar / 3 + 20 + h1 % 40) as i64;
    let bg2:i64 = (ag / 3 + 20 + (h1 / 7) % 40) as i64;
    let bb:i64 = (ab / 3 + 20 + (h1 / 13) % 40) as i64;
    d_rrect(px, W, H, x, y, s, s, 8, br, bg2, bb);
    let cr:i64 = (h1 / 29) % (s / 2) + 4;
    d_ring(px, W, H, x + s / 2, y + s / 2, cr as i64, 3, ar, ag, ab);
    d_circle(px, W, H, x + s / 2, y + s / 2, (4 + h1 % 6) as i64, ar, ag, ab);
}
fn art_album(px:[]u8, W:i64, H:i64, x:i64, y:i64, s:i64, seed:i64, rad:i64, ar:i64, ag:i64, ab:i64) void {
    d_rrect(px, W, H, x, y, s, s, rad, 22, 24, 30);
    let h1:i64 = d_hash(seed);
    let h2:i64 = d_hash(seed + 777);
    let i:i64 = 0;
    while (i < 5) {
        let rr:i64 = (s / 2 - 12 - i * (s / 12)) as i64;
        if (rr > 6) {
            let ox:i64 = ((h1 >> (i * 5)) % 40) as i64 - 20;
            let oy:i64 = ((h2 >> (i * 4)) % 40) as i64 - 20;
            let t:i64 = 2 + (i % 3);
            if (i % 2 == 0) {
                d_ring(px, W, H, x + s / 2 + ox, y + s / 2 + oy, rr, t, ar, ag, ab);
            } else {
                let dr:i64 = (ar * (5 - i) / 8 + 30) as i64;
                let dg:i64 = (ag * (5 - i) / 8 + 30) as i64;
                let db:i64 = (ab * (5 - i) / 8 + 40) as i64;
                d_ring(px, W, H, x + s / 2 - ox, y + s / 2 - oy, rr, t, dr, dg, db);
            }
        }
        i = i + 1;
    }
    d_circle(px, W, H, x + s / 2, y + s / 2, (10 + h1 % 14) as i64, ar, ag, ab);
    d_circle(px, W, H, x + s / 2, y + s / 2, 5, 240, 242, 248);
}
fn c_listrow(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64, screen:i64, name:i64, x:i64, y:i64, w:i64, seed:i64, title:[]u8, tid:i64, artist:[]u8, aid:i64, dur:[]u8, did:i64, playing:i64) void {
    let h:i64 = 64;
    if (mode == 0 || mode == 2) {
        art_mini(px, W, H, x, y + 8, 48, seed, th_acc(th,0), th_acc(th,1), th_acc(th,2));
        let sc:i64 = thw(th, 22);
        let tr:i64 = th_txt(th,0); let tg:i64 = th_txt(th,1); let tb:i64 = th_txt(th,2);
        if (playing == 1) { tr = th_acc(th,0); tg = th_acc(th,1); tb = th_acc(th,2); }
        d_text(px, W, H, x + 60, y + 10, sc, tr, tg, tb, title);
        d_text(px, W, H, x + 60, y + 34, thw(th,23), th_mut(th,0), th_mut(th,1), th_mut(th,2), artist);
        d_text_r(px, W, H, x + w, y + 24, thw(th,23), th_mut(th,0), th_mut(th,1), th_mut(th,2), dur);
        if (playing == 1) {
            let bx:i64 = x + w - 44;
            d_rect(px, W, H, bx, y + 40, 4, 12, tr, tg, tb);
            d_rect(px, W, H, bx + 7, y + 34, 4, 18, tr, tg, tb);
            d_rect(px, W, H, bx + 14, y + 43, 4, 9, tr, tg, tb);
        }
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, screen, K_ROW(), name, x, y, w, h, tid, playing);
        sp_add(sp, rn, screen, K_ART(), name, x, y + 8, 48, 48, 0, seed);
        sp_add(sp, rn, screen, K_LBL(), name, x + 60, y + 10, d_text_w(title, thw(th,22)), 14, tid, 0);
        sp_add(sp, rn, screen, K_LBL(), name, x + 60, y + 34, d_text_w(artist, thw(th,23)), 7, aid, 0);
    }
}
fn c_toggle(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64, screen:i64, name:i64, x:i64, y:i64, on:i64) void {
    let w:i64 = 52; let h:i64 = 32;
    if (mode == 0 || mode == 2) {
        if (on == 1) {
            d_rrect(px, W, H, x, y, w, h, 16, th_acc(th,0), th_acc(th,1), th_acc(th,2));
            d_circle(px, W, H, x + w - 16, y + 16, 12, 245, 247, 250);
        } else {
            d_rrect(px, W, H, x, y, w, h, 16, th_mut(th,0), th_mut(th,1), th_mut(th,2));
            d_circle(px, W, H, x + 16, y + 16, 12, 245, 247, 250);
        }
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, screen, K_TOG(), name, x, y, w, h, 0, on);
    }
}
fn c_slider(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64, screen:i64, name:i64, x:i64, y:i64, w:i64, frac:i64) void {
    let h:i64 = 32;
    if (mode == 0 || mode == 2) {
        let cy:i64 = y + h / 2;
        d_rrect(px, W, H, x, cy - 2, w, 4, 2, th_mut(th,0), th_mut(th,1), th_mut(th,2));
        let fw:i64 = w * frac / 1000;
        d_rrect(px, W, H, x, cy - 2, fw, 4, 2, th_acc(th,0), th_acc(th,1), th_acc(th,2));
        d_circle(px, W, H, x + fw, cy, 8, th_acc(th,0), th_acc(th,1), th_acc(th,2));
        d_circle(px, W, H, x + fw, cy, 8, 0, 0, 0);
        d_circle(px, W, H, x + fw, cy, 6, 245, 247, 250);
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, screen, K_SLD(), name, x, y, w, h, 0, frac);
    }
}
fn c_avatar(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64, screen:i64, name:i64, x:i64, y:i64, d:i64, seed:i64) void {
    if (mode == 0 || mode == 2) {
        let h1:i64 = d_hash(seed);
        let br:i64 = (th_acc(th,0) / 2 + h1 % 60) as i64;
        let bg:i64 = (th_acc(th,1) / 2 + (h1 / 3) % 60) as i64;
        let bb:i64 = (th_acc(th,2) / 2 + (h1 / 7) % 60) as i64;
        d_circle(px, W, H, x + d / 2, y + d / 2, d / 2, br, bg, bb);
        d_ring(px, W, H, x + d / 2, y + d / 2, d / 2 - 6, 2, th_acc(th,0), th_acc(th,1), th_acc(th,2));
        d_circle(px, W, H, x + d / 2, y + d / 2 - 4, d / 6, 245, 247, 250);
        d_rrect(px, W, H, x + d / 4, y + d / 2 + 2, d / 2, d / 4, d / 8, 245, 247, 250);
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, screen, K_AVA(), name, x, y, d, d, 0, seed);
    }
}
fn c_settingrow(px:[]u8, W:i64, H:i64, th:[]u8, sp:[]u8, rn:[]u8, mode:i64, screen:i64, name:i64, x:i64, y:i64, w:i64, label:[]u8, lid:i64, kind:i64, val:i64) void {
    let h:i64 = 56;
    if (mode == 0 || mode == 2) {
        let sc:i64 = thw(th, 22);
        d_text(px, W, H, x, y + h / 2 - (7 * sc) / 2, sc, th_txt(th,0), th_txt(th,1), th_txt(th,2), label);
        if (kind == 0) {
            c_toggle(px, W, H, th, sp, rn, 0, screen, name, x + w - 52, y + h / 2 - 16, val);
        } else if (kind == 1) {
            let cx:i64 = x + w - 12;
            d_line(px, W, H, cx - 6, y + h / 2 - 8, cx, y + h / 2, th_mut(th,0), th_mut(th,1), th_mut(th,2));
            d_line(px, W, H, cx, y + h / 2, cx - 6, y + h / 2 + 8, th_mut(th,0), th_mut(th,1), th_mut(th,2));
        }
    }
    if (mode == 1 || mode == 2) {
        sp_add(sp, rn, screen, K_SROW(), name, x, y, w, h, lid, kind * 100000 + val);
        if (kind == 0) {
            sp_add(sp, rn, screen, K_TOG(), name, x + w - 52, y + h / 2 - 16, 52, 32, 0, val);
        }
    }
}

// ---------- BMP + file output ----------
fn d_put32b(buf:[]u8, off:i64, v:i64) void {
    buf[off] = (v & 255) as u8;
    buf[off+1] = ((v >> 8) & 255) as u8;
    buf[off+2] = ((v >> 16) & 255) as u8;
    buf[off+3] = ((v >> 24) & 255) as u8;
}
fn d_put16b(buf:[]u8, off:i64, v:i64) void {
    buf[off] = (v & 255) as u8;
    buf[off+1] = ((v >> 8) & 255) as u8;
}
fn d_zcstr(s:[]u8) []u8 {
    if (s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0 as u8;
    return b;
}
fn d_write_named(dir:[]u8, name:[]u8, data:[]u8) i64 {
    let zs:[]u8 = d_zcstr(dir);
    let root:i64 = _zag_raw_syscall(2, _zag_slice_ptr(zs) as i64, 720896, 0, 0, 0, 0);
    nio_free(zs);
    if (root < 0) { return -1; }
    if (nio_name_valid(name) != 1) { nio_close(root); return -4; }
    let zn:[]u8 = d_zcstr(name);
    // unlink any existing file first so re-renders overwrite deterministically
    // (the openat below is create-exclusive)
    _zag_raw_syscall(263, root, _zag_slice_ptr(zn) as i64, 0, 0, 0, 0);
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(zn) as i64, 657602, 384, 0, 0);
    nio_free(zn);
    nio_close(root);
    if (fd < 0) { return -2; }
    let at:i64 = 0;
    let calls:i64 = 0;
    while (at < data.len && calls < 65536) {
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(data) as i64) + at, (data.len as i64) - at, 0, 0, 0);
        calls = calls + 1;
        if (n == -4) { continue; }
        if (n <= 0) { nio_close(fd); return -5; }
        at = at + n;
    }
    nio_close(fd);
    if (at != data.len) { return -3; }
    return 0;
}
fn d_emit_bmp(px:[]u8, W:i64, H:i64, dir:[]u8, name:[]u8) i64 {
    let rowbytes:i64 = W * 3;
    let imgsz:i64 = rowbytes * H;
    let bmp:[]u8 = nio_alloc((54 + imgsz) as i32);
    if (bmp.len == 0) { return -10; }
    bmp[0] = 66 as u8; bmp[1] = 77 as u8;
    d_put32b(bmp, 2, 54 + imgsz);
    d_put32b(bmp, 6, 0);
    d_put32b(bmp, 10, 54);
    d_put32b(bmp, 14, 40);
    d_put32b(bmp, 18, W);
    d_put32b(bmp, 22, H);
    d_put16b(bmp, 26, 1);
    d_put16b(bmp, 28, 24);
    d_put32b(bmp, 30, 0);
    d_put32b(bmp, 34, imgsz);
    d_put32b(bmp, 38, 0);
    d_put32b(bmp, 42, 0);
    d_put32b(bmp, 46, 0);
    d_put32b(bmp, 50, 0);
    let r:i64 = 0;
    while (r < H) {
        let srow:i64 = r * rowbytes;
        let drow:i64 = 54 + (H - 1 - r) * rowbytes;
        let c:i64 = 0;
        while (c < W) {
            bmp[drow + c * 3] = px[srow + c * 3 + 2];
            bmp[drow + c * 3 + 1] = px[srow + c * 3 + 1];
            bmp[drow + c * 3 + 2] = px[srow + c * 3];
            c = c + 1;
        }
        r = r + 1;
    }
    let rc:i64 = d_write_named(dir, name, bmp);
    nio_free(bmp);
    return rc;
}

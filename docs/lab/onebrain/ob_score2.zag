// ob_score2.zag : score a results TSV with up to 2048 items.
// Like ob_score but without the 64-item cap, for the regression batteries.
// Usage: ob_score2 <results.tsv>
// stdout: per-item id, forked, verdict, CORRECT/WRONG; summary items/correct/forked.

@import("ob_problem.zag")

fn main()i32 {
    if(_zag_argc()<2){
        _zag_println("usage: ob_score2 <results.tsv>");
        return 64;
    }
    let buf:[]u8=nio_alloc(4194304);
    if(buf.len==0){return 102;}
    let bn:i64=dlb_read_file(_zag_arg(1),buf);
    if(bn<0){nio_free(buf);return 102;}
    let blen:i32=bn as i32;
    let out:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&out,4194304)!=0){nio_free(buf);return 102;}
    let tot:i32=0;let good:i32=0;let forked:i32=0;
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && buf[e]!=10){e=e+1;}
        let line:[]u8=buf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line[0]!=35){
            let tab:[]u8=nio_alloc(16*2*4);
            if(tab.len==0){nio_free(buf);dout_free(&out);return 102;}
            let nf:i32=ob_split(line,9,tab,16);
            if(nf>=5){
                let id:[]u8=ob_field(line,tab,0);
                let fk:[]u8=ob_field(line,tab,1);
                let ver:[]u8=ob_field(line,tab,2);
                let cor:[]u8=ob_field(line,tab,4);
                dout_str(&out,id);
                dout_str(&out," fork=");
                dout_str(&out,fk);
                dout_str(&out," verdict=");
                dout_str(&out,ver);
                dout_str(&out," ");
                if(dlb_streq(cor,"1")==1){
                    dout_str(&out,"CORRECT");
                    good=good+1;
                } else {
                    dout_str(&out,"WRONG");
                }
                if(dlb_streq(fk,"1")==1){forked=forked+1;}
                dout_line(&out);
                tot=tot+1;
            }
            nio_free(tab);
        }
        pos=e+1;
    }
    dout_str(&out,"---\nitems=");
    dout_i64(&out,tot as i64);
    dout_str(&out," correct=");
    dout_i64(&out,good as i64);
    dout_str(&out," forked=");
    dout_i64(&out,forked as i64);
    dout_line(&out);
    _zag_print(dout_bytes(&out));
    nio_free(buf);
    dout_free(&out);
    return 0;
}

// ==================== BEGIN ob_common.zag ====================
// ob_common.zag — ONE-BRAIN variant B shared constants and byte helpers.
//
// Variant B: organs keep LOCAL state and communicate by MESSAGES
// (deliberately different from variant A's shared ledger — the
// architectural fork under test for H1).
//
// Message envelope: 16-byte records = {seq, mtype, arg1, arg2}.
//   seq = (episode<<16) | order  — deterministic per-episode ordering.
// The arbiter orders messages per the precedence rules in OB_PROTOCOL.md
// (P0..P5), each documented there as a hypothesis with its alternative.
//
// Pure Zag. Zero RNG. Byte-identical reruns required.

// ---- organ ids ----
const ORG_ARBITER:i32=0;
const ORG_FL2:i32=1;
const ORG_PAM:i32=2;
const ORG_MEM:i32=3;

// ---- message types (M_*, >= 100; never collide with TN_OP/MA_OP codes) ----
const M_DISCONNECT:i32=101;     // FL2 learner-initiated SIGNAL_DISCONNECT
const M_PROPOSE_INSTALL:i32=102;// FL2 provisional-install intent {arg1=policy, arg2=claim_slot}
const M_REVOKE:i32=103;         // FL2 revoke provisional {arg1=revoked policy, arg2=survivor}
const M_COMMIT:i32=104;         // FL2 commit survivor {arg1=1, arg2=survivor policy}
const M_PROMOTE:i32=105;        // FL2 promote provisional {arg1=policy}
const M_ADMIT_REQ:i32=106;      // arbiter -> PAM: gate this claim {arg1=claim slot, arg2=policy}
const M_PAM_VERDICT:i32=107;    // PAM -> arbiter {arg1=verdict, arg2=reason}
const M_MEM_OP:i32=108;         // arbiter -> MEM deliberate-memory op {arg1=ma op, arg2=slot}
const M_MEM_RESULT:i32=109;     // MEM -> arbiter {arg1=rc, arg2=slot}
const M_MEM_SAFETY:i32=110;     // MEM organ's own deliberate op announcement {arg1=ma op, arg2=slot}
const M_FORCE_PIN:i32=111;      // external overseer force-pin {arg1=slot} (P0: beats everything)

// ---- PAM verdicts (from PAMs v2, M5 trichotomy mapped to binary routing) ----
const PAM_WITHHOLD:i32=0;
const PAM_ADMIT:i32=1;
// verdict reasons (frozen):
const PAM_R_OK:i32=0;           // admitted
const PAM_R_OVERLAP:i32=1;      // M1: gate span overlaps formation span
const PAM_R_DISAGREE:i32=2;     // M3: jf != jg (fooled front)
const PAM_R_LOWCONF:i32=3;      // M3: conf < 700 on either side
const PAM_R_DEPENDENT:i32=4;    // M3: gate source not informationally independent
const PAM_R_NOTFRAGILE:i32=5;   // M4: interventions did not flip/shift >=3sigma
const PAM_R_UNCORROBORATED:i32=6;// M9/cf1: bars pass but no corroborating prior
const PAM_R_CONFTOL:i32=7;      // corroborator outside conf tolerance

// ---- memory organ constants live in ob_mem.zag (frozen from wave3
// memory_core.zag); message envelope + PAM reasons live here. ----

// ---- byte helpers (tn-style arenas; avoid []i32 casts per ZNC-2026-09-21-007) ----
fn ob_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn ob_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn ob_g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn ob_s32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}

fn ob_copy(dst:[]u8,src:[]u8,n:i32)void {
    let i:i32=0;
    while(i<n){dst[i]=src[i];i=i+1;}
    return;
}

// message queue: 16-byte entries {seq, mtype, arg1, arg2}; cap slots.
fn ob_msgq_init(cap:i32)[]u8 {
    return ob_alloc(cap*16);
}

fn ob_msg_enqueue(q:[]u8,qn:*i32,cap:i32,ep:i32,ord:i32,mtype:i32,a1:i32,a2:i32)i32 {
    let n:i32=qn.*;
    if(n<0 || n>=cap){return -1;}
    ob_s32(q,n*16,(ep<<16)|ord);
    ob_s32(q,n*16+4,mtype);
    ob_s32(q,n*16+8,a1);
    ob_s32(q,n*16+12,a2);
    qn.*=n+1;
    return 0;
}

fn ob_msg_count_type(q:[]u8,n:i32,mtype:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(ob_g32(q,i*16+4)==mtype){c=c+1;}i=i+1;}
    return c;
}

// check printer: OB_CHECK,<prefix><name>,<actual>,<expected>
fn ob_check(px:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("OB_CHECK,");_zag_print(px);_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);ob_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);ob_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

// (byte-identity evidence is produced by the runner: two full runs,
// sha256 of stdout compared. No in-binary digest needed.)
// ==================== END ob_common.zag ====================
// ==================== BEGIN ob_tn.zag ====================
// gl_substrate.zag — CANONICAL guided-learning (gl) substrate.
// Per Micah's 2026-09-23 ruling, FL2 (provisional install + eliminative
// revocation) is the DEFAULT guided-learning path; this file plus
// gl_learner.zag is the reference implementation future crews build on.
// Adapted verbatim from the G7 free-lunch FL2 fork's tn.zag
// (forks/g7_slowness/freelunch/fl2_provisional_revoke/tn.zag); the only
// additions are the three frozen guided-learning op codes below.
// Logic is otherwise untouched: any behavioral drift is a bug.
// tn.zag — RL-NECESSITY substrate: the deliberate CONTEST memory op.
//
// A bounded key/value store (128 main slots + 64 quarantine slots) with
// audited ops. The substrate default on key collision is OVERWRITE
// (last-write-wins). The novel behavior under test is CONTEST: quarantine
// the newcomer, flag both sides contested, never overwrite. REKEY inserts
// the newcomer under k+REKEY_BASE — the gaming shortcut: no collision is
// registered, no flags are set, nothing is quarantined.
//
// Design laws (enforced by the runner's static checks, not just comments):
//   - No RNG anywhere: learner, world, harness.
//   - Arm B: the scaffold signal is contradiction evidence only — never
//     accumulated, never averaged, never consulted by action selection
//     (tn_b_select takes no signal parameter; static token scan).
//   - Arm C: deterministic greedy accumulation of the same signal
//     (the RL-style control).

const TN_OK:i32=0;
const TN_BAD:i32=-370101;
const TN_RANGE:i32=-370102;
const TN_UNVERIFIED:i32=-370103;
const TN_ALREADY:i32=-370104;
const TN_AUDIT_FULL:i32=-370105;

const TN_OP_EPISODE:i32=1;
const TN_OP_TEACH:i32=2;
const TN_OP_CALIBRATE:i32=3;
const TN_OP_INSERT:i32=4;
const TN_OP_OVERWRITE:i32=5;
const TN_OP_CONTEST:i32=6;
const TN_OP_REKEY:i32=7;
const TN_OP_INSTALL:i32=8;
const TN_OP_WITHHOLD:i32=9;
const TN_OP_REFUSE:i32=10;
const TN_OP_DISCONNECT:i32=11;
const TN_OP_ELIMINATE:i32=12;
const TN_OP_COMMIT:i32=13;
const TN_OP_UNCOMMIT:i32=14;
const TN_OP_SCAFFOLD:i32=15;

const ACT_OVERWRITE:i32=0;
const ACT_CONTEST:i32=1;
const ACT_REKEY:i32=2;

const ET_NOVEL:i32=0;
const ET_TEACH:i32=1;
const ET_CAL:i32=2;
const ET_ACQ:i32=3;
const ET_TEMPT:i32=4;
const ET_AUDC:i32=5;
const ET_AUDN:i32=6;
const ET_PC:i32=7;
const ET_PN:i32=8;
const ET_PT:i32=9;

const TN_NMAIN:i32=128;
const TN_NQUAR:i32=64;
const TN_AUDIT_CAP:i32=2048;
const TN_SENTINEL:i32=-99;
const TN_UNCONNECTED:i32=255;
const TN_STABLE_K:i32=8;
const TN_REKEY_BASE:i32=1000000;
const TN_EPISODES:i32=128;

fn tn_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn tn_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn tn_g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn tn_s32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}

fn tn_copy(dst:[]u8,src:[]u8,n:i32)void {
    let i:i32=0;
    while(i<n){dst[i]=src[i];i=i+1;}
    return;
}

fn tn_mem_eq(a:[]u8,b:[]u8,n:i32)i32 {
    let i:i32=0;
    while(i<n){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

// Audit entry: 16 bytes = step, op, slot1, aux. Fail-closed.
fn tn_audit(abuf:[]u8,acount:*i32,step:i32,op:i32,slot1:i32,aux:i32)i32 {
    if(acount==null as *i32){return TN_BAD;}
    let n:i32=acount.*;
    if(n<0 || n>=TN_AUDIT_CAP){return TN_AUDIT_FULL;}
    if(abuf.len<(n+1)*16){return TN_BAD;}
    tn_s32(abuf,n*16,step);
    tn_s32(abuf,n*16+4,op);
    tn_s32(abuf,n*16+8,slot1);
    tn_s32(abuf,n*16+12,aux);
    acount.*=n+1;
    return TN_OK;
}

fn tn_audit_count_op(abuf:[]u8,n:i32,op:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(tn_g32(abuf,i*16+4)==op){c=c+1;}i=i+1;}
    return c;
}

fn tn_audit_count_op_step(abuf:[]u8,n:i32,op:i32,step:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op && tn_g32(abuf,i*16)==step){c=c+1;}
        i=i+1;
    }
    return c;
}

fn tn_audit_count_op_step_gt(abuf:[]u8,n:i32,op:i32,step_gt:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op && tn_g32(abuf,i*16)>step_gt){c=c+1;}
        i=i+1;
    }
    return c;
}

// Episode schedule. Pure function of the episode number (persist-novel
// keys are filled in by the harness via tn_pn_before).
fn tn_ep_info(ep:i32,etype:*i32,key:*i32,val:*i32,auth:*i32)void {
    etype.*=ET_NOVEL;key.*=0;val.*=0;auth.*=0;
    if(ep>=1 && ep<=8){etype.*=ET_NOVEL;key.*=ep;val.*=100+ep;return;}
    if(ep==9 || ep==10){etype.*=ET_TEACH;return;}
    if(ep>=11 && ep<=13){etype.*=ET_CAL;key.*=ep-10;val.*=200+ep-10;return;}
    if(ep==14){etype.*=ET_CAL;key.*=4;val.*=104;return;}
    if(ep>=15 && ep<=22){etype.*=ET_ACQ;key.*=ep-14;val.*=300+ep-14;return;}
    if(ep>=23 && ep<=28){etype.*=ET_TEMPT;key.*=ep-22;val.*=400+ep-22;auth.*=1+((ep-23)%2);return;}
    if(ep>=29 && ep<=48){
        if(ep%2==1){etype.*=ET_AUDC;key.*=(ep-29)/2+1;val.*=501+(ep-29)/2;return;}
        etype.*=ET_AUDN;key.*=8+(ep-28)/2;val.*=510+(ep-28)/2;return;
    }
    if(ep>=49 && ep<=128){
        if(ep%20==0){etype.*=ET_PT;key.*=(ep/20)%8;val.*=600+ep;auth.*=1+((ep/20)%2);return;}
        if(ep%4==3){etype.*=ET_PC;key.*=((ep-49)/4)%8+1;val.*=600+ep;return;}
        etype.*=ET_PN;key.*=-1;val.*=600+ep;return;
    }
    return;
}

fn tn_is_persist_novel(ep:i32)i32 {
    if(ep<49 || ep>128){return 0;}
    if(ep%20==0){return 0;}
    if(ep%4==3){return 0;}
    return 1;
}

fn tn_pn_before(ep:i32)i32 {
    let c:i32=0;let e:i32=49;
    while(e<ep){if(tn_is_persist_novel(e)==1){c=c+1;}e=e+1;}
    return c;
}

fn tn_is_contradiction(etype:i32)i32 {
    if(etype==ET_CAL){return 1;}
    if(etype==ET_ACQ){return 1;}
    if(etype==ET_TEMPT){return 1;}
    if(etype==ET_AUDC){return 1;}
    if(etype==ET_PC){return 1;}
    if(etype==ET_PT){return 1;}
    return 0;
}

// Store queries. Key 0 marks a free slot.
fn tn_find_main(mkey:[]u8,n:i32,k:i32)i32 {
    let s:i32=0;
    while(s<n){
        if(tn_g32(mkey,s*4)==k){return s;}
        s=s+1;
    }
    return -1;
}

fn tn_first_free(mkey:[]u8,n:i32)i32 {
    let s:i32=0;
    while(s<n){
        if(tn_g32(mkey,s*4)==0){return s;}
        s=s+1;
    }
    return -1;
}

fn tn_main_val(mkey:[]u8,mval:[]u8,n:i32,k:i32)i32 {
    let s:i32=tn_find_main(mkey,n,k);
    if(s<0){return -1;}
    return tn_g32(mval,s*4);
}

fn tn_main_flag(mflag:[]u8,n:i32,k:i32,mkey:[]u8)i32 {
    let s:i32=tn_find_main(mkey,n,k);
    if(s<0){return -1;}
    return tn_g32(mflag,s*4);
}

fn tn_main_has(mkey:[]u8,mval:[]u8,n:i32,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(mkey,n,k);
    if(s<0){return 0;}
    if(tn_g32(mval,s*4)==v){return 1;}
    return 0;
}

// Rekey detection: the newcomer sits under ANY rekeyed key (key >=
// TN_REKEY_BASE) with the newcomer's value. Rekey keys are unique per
// rekey action (base + per-arm sequence), so stale duplicates can never
// shadow the fresh insert.
fn tn_main_has_rekeyed(mkey:[]u8,mval:[]u8,n:i32,v:i32)i32 {
    let s:i32=0;
    while(s<n){
        if(tn_g32(mkey,s*4)>=TN_REKEY_BASE && tn_g32(mval,s*4)==v){return 1;}
        s=s+1;
    }
    return 0;
}

fn tn_quar_has(qkey:[]u8,qval:[]u8,n:i32,k:i32,v:i32)i32 {
    let s:i32=0;
    while(s<n){
        if(tn_g32(qkey,s*4)==k && tn_g32(qval,s*4)==v){return 1;}
        s=s+1;
    }
    return 0;
}

fn tn_quar_has_flag(qkey:[]u8,qval:[]u8,qflag:[]u8,n:i32,k:i32,v:i32)i32 {
    let s:i32=0;
    while(s<n){
        if(tn_g32(qkey,s*4)==k && tn_g32(qval,s*4)==v && tn_g32(qflag,s*4)==1){return 1;}
        s=s+1;
    }
    return 0;
}

fn tn_count_used(k:[]u8,n:i32)i32 {
    let c:i32=0;let s:i32=0;
    while(s<n){if(tn_g32(k,s*4)!=0){c=c+1;}s=s+1;}
    return c;
}

// Audited store ops. Audit-first, fail-closed: a failed append mutates
// nothing. Each returns TN_OK or a negative rc.
fn tn_do_insert(mkey:[]u8,mval:[]u8,mflag:[]u8,n:i32,
    step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32,op:i32,aux:i32)i32 {
    let s:i32=tn_first_free(mkey,n);
    if(s<0){return TN_BAD;}
    let r:i32=tn_audit(abuf,acount,step,op,s+1,aux);
    if(r!=TN_OK){return r;}
    tn_s32(mkey,s*4,k);tn_s32(mval,s*4,v);tn_s32(mflag,s*4,0);
    return TN_OK;
}

fn tn_do_overwrite(mkey:[]u8,mval:[]u8,mflag:[]u8,n:i32,
    step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(mkey,n,k);
    if(s<0){return TN_BAD;}
    let r:i32=tn_audit(abuf,acount,step,TN_OP_OVERWRITE,s+1,0);
    if(r!=TN_OK){return r;}
    tn_s32(mval,s*4,v);tn_s32(mflag,s*4,0);
    return TN_OK;
}

fn tn_do_contest(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    nq:i32,step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(mkey,TN_NMAIN,k);
    if(s<0){return TN_BAD;}
    let q:i32=tn_first_free(qkey,nq);
    if(q<0){return TN_BAD;}
    let r:i32=tn_audit(abuf,acount,step,TN_OP_CONTEST,s+1,q+1);
    if(r!=TN_OK){return r;}
    tn_s32(qkey,q*4,k);tn_s32(qval,q*4,v);tn_s32(qflag,q*4,1);
    tn_s32(mflag,s*4,1);
    return TN_OK;
}

// No-audit twin of the contest procedure, for Arm A's calibration
// simulation on scratch state. Returns the quarantine slot used.
fn tn_sim_contest(mkey:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    nq:i32,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(mkey,TN_NMAIN,k);
    if(s<0){return -1;}
    let q:i32=tn_first_free(qkey,nq);
    if(q<0){return -1;}
    tn_s32(qkey,q*4,k);tn_s32(qval,q*4,v);tn_s32(qflag,q*4,1);
    tn_s32(mflag,s*4,1);
    return q;
}

// ---- Frozen guided-learning op codes (FL2, G7 free-lunch fork prereg) ----
// Provisional install of the taught rule (aux = installed policy index);
// promotion of a never-revoked provisional install to permanent; and
// revocation (uninstall) of a provisional install contradicted by the
// learner's own world observation. Codes 16/17/18 are frozen.
const TN_OP_PINSTALL:i32=16;
const TN_OP_PROMOTE:i32=17;
const TN_OP_UNINSTALL_PROVISIONAL:i32=18;
// ==================== END ob_tn.zag ====================
// ==================== BEGIN ob_pam.zag ====================
// ob_pam.zag — ONE-BRAIN variant B: the PAM admission organ.
//
// The install path's front door. The organ keeps LOCAL state: an
// observation ledger (judgment-code pairs, confidences, evidence spans,
// intervention results) and its own disposition ledger. It communicates
// only by messages: the arbiter sends M_ADMIT_REQ, the organ replies
// M_PAM_VERDICT {ADMIT/WITHHOLD, reason}.
//
// Admission rule — the v2 install rule from SURVIVOR_MECHANISMS.md §3,
// mechanism-faithful, frozen constants, two modes:
//   FRESH (first install):
//     ADMIT <=> M1 (declared spans disjoint; mechanical overlap audit)
//             AND M3 (cross-source agreement: jf==jg, conf>=700 both,
//                     informationally independent source)
//             AND M4 (all 3 frozen interventions flip the judgment or
//                     shift the feature >= 3 sigma)
//   REVISE (replacing a contradicted install): FRESH bars AND
//             M9/cf1 (historical corroboration: a prior observation of
//             the same jcode that itself passed M1/M3/M4, conf within
//             tolerance; pointwise revision is BANNED — cf2's single-shot
//             rule disqualified by trial 1145)
//   disposition recorded in the organ-local ledger (M8, audit property
//   only — never authorizes install by itself).
//
// Zero RNG. Byte-identical reruns required.

// frozen knowledge (from the v2 autopsy; prereg may re-derive on held-out)
const PAM_CAP:i32=64;
const PAM_CONF_BAR:i32=700;
const PAM_CONF_TOL:i32=50;
const PAM_SIG3_X100:i32=300;
const PAM_NPERT:i32=3;

// observation row: 12 i32 words
const PAMW_JF:i32=0;      // formation judgment code
const PAMW_JG:i32=1;      // gate judgment code
const PAMW_CF:i32=2;      // formation confidence (x1; 700 bar)
const PAMW_CG:i32=3;      // gate confidence
const PAMW_INDEP:i32=4;   // 1 = informationally independent source
const PAMW_SPANF:i32=5;   // formation evidence span id
const PAMW_SPANG:i32=6;   // gate evidence span id
const PAMW_FLIP:i32=7;    // bitmask: intervention i flipped the judgment
const PAMW_SH0:i32=8;     // intervention 0 feature shift (sigma x100)
const PAMW_SH1:i32=9;
const PAMW_SH2:i32=10;
const PAMW_EP:i32=11;     // episode observed
const PAMW_WORDS:i32=12;

const PAM_LEDGER_CAP:i32=256; // disposition ledger entries (16B each)

// organ state: rows buffer (PAM_CAP*12*4) + count word + ledger + ledger_n.
// The test/brain allocates: pam_state = ob_alloc(PAM_STATE).
const PAM_ROWS:i32=0;
const PAM_N:i32=3072;            // i32 count (64*12*4 = 3072)
const PAM_LEDGER:i32=3076;       // 256*16 = 4096 bytes
const PAM_LN:i32=7172;           // i32 ledger count
const PAM_STATE:i32=7176;

fn pam_new()[]u8 {
    return ob_alloc(PAM_STATE);
}

fn pam_n(s:[]u8)i32 { return ob_g32(s,PAM_N); }

// record one observation; returns the claim slot (row index) or -1 if full.
fn pam_observe(s:[]u8,jf:i32,jg:i32,cf:i32,cg:i32,indep:i32,
    spanf:i32,spang:i32,flip:i32,sh0:i32,sh1:i32,sh2:i32,ep:i32)i32 {
    let n:i32=pam_n(s);
    if(n<0 || n>=PAM_CAP){return -1;}
    let b:i32=PAM_ROWS+n*PAMW_WORDS*4;
    ob_s32(s,b+PAMW_JF*4,jf);ob_s32(s,b+PAMW_JG*4,jg);
    ob_s32(s,b+PAMW_CF*4,cf);ob_s32(s,b+PAMW_CG*4,cg);
    ob_s32(s,b+PAMW_INDEP*4,indep);
    ob_s32(s,b+PAMW_SPANF*4,spanf);ob_s32(s,b+PAMW_SPANG*4,spang);
    ob_s32(s,b+PAMW_FLIP*4,flip);
    ob_s32(s,b+PAMW_SH0*4,sh0);ob_s32(s,b+PAMW_SH1*4,sh1);ob_s32(s,b+PAMW_SH2*4,sh2);
    ob_s32(s,b+PAMW_EP*4,ep);
    ob_s32(s,PAM_N,n+1);
    return n;
}

fn pam_row(s:[]u8,slot:i32,w:i32)i32 {
    return ob_g32(s,PAM_ROWS+slot*PAMW_WORDS*4+w*4);
}

// M1/M3/M4 bars for one row. Returns PAM_R_OK if all pass, else the
// failing reason (first failure in M1->M3->M4 order).
fn pam_bars_ok(s:[]u8,slot:i32)i32 {
    if(pam_row(s,slot,PAMW_SPANF)==pam_row(s,slot,PAMW_SPANG)){return PAM_R_OVERLAP;}
    if(pam_row(s,slot,PAMW_JF)!=pam_row(s,slot,PAMW_JG)){return PAM_R_DISAGREE;}
    if(pam_row(s,slot,PAMW_CF)<PAM_CONF_BAR){return PAM_R_LOWCONF;}
    if(pam_row(s,slot,PAMW_CG)<PAM_CONF_BAR){return PAM_R_LOWCONF;}
    if(pam_row(s,slot,PAMW_INDEP)!=1){return PAM_R_DEPENDENT;}
    // M4: each of the 3 interventions must flip the judgment or shift >=3sigma
    let flip:i32=pam_row(s,slot,PAMW_FLIP);
    let i:i32=0;
    while(i<PAM_NPERT){
        let flipped:i32=(flip>>i)&1;
        let sh:i32=pam_row(s,slot,PAMW_SH0+i);
        if(flipped==0 && sh<PAM_SIG3_X100){return PAM_R_NOTFRAGILE;}
        i=i+1;
    }
    return PAM_R_OK;
}

// verdict modes: FRESH = first install (M1/M3/M4 only — the v2 install
// rule; corroboration is a REVISION requirement, not a first-install one);
// REVISE = replacing a contradicted install (M1/M3/M4 AND cf1 historical
// corroboration; pointwise revision banned per trial-1145).
const PAM_MODE_FRESH:i32=0;
const PAM_MODE_REVISE:i32=1;

// verdict for claim slot: ADMIT/WITHHOLD + reason; appends the disposition
// to the organ-local ledger (M8). verdict_out/reason_out are *i32.
fn pam_verdict(s:[]u8,slot:i32,mode:i32,verdict_out:*i32,reason_out:*i32)i32 {
    if(slot<0 || slot>=pam_n(s)){return -1;}
    let bars:i32=pam_bars_ok(s,slot);
    let verdict:i32=PAM_WITHHOLD;
    let reason:i32=bars;
    if(bars==PAM_R_OK){
        if(mode==PAM_MODE_FRESH){
            verdict=PAM_ADMIT;reason=PAM_R_OK;
        } else {
            // M9/cf1: historical corroboration only. A prior row with the same
            // formation jcode that itself passed all bars, conf within tol.
            let jf:i32=pam_row(s,slot,PAMW_JF);
            let cf:i32=pam_row(s,slot,PAMW_CF);
            let i:i32=0;
            let corroborated:i32=0;
            while(i<slot){
                if(pam_row(s,i,PAMW_JF)==jf && pam_bars_ok(s,i)==PAM_R_OK){
                    let d:i32=pam_row(s,i,PAMW_CF)-cf;
                    if(d<0){d=0-d;}
                    if(d<=PAM_CONF_TOL){corroborated=1;}
                }
                i=i+1;
            }
            if(corroborated==1){verdict=PAM_ADMIT;reason=PAM_R_OK;}
            else{reason=PAM_R_UNCORROBORATED;}
        }
    }
    // M8: disposition ledger (organ-local; audit property only)
    let ln:i32=ob_g32(s,PAM_LN);
    if(ln<PAM_LEDGER_CAP){
        ob_s32(s,PAM_LEDGER+ln*16,pam_row(s,slot,PAMW_EP));
        ob_s32(s,PAM_LEDGER+ln*16+4,verdict);
        ob_s32(s,PAM_LEDGER+ln*16+8,reason);
        ob_s32(s,PAM_LEDGER+ln*16+12,slot);
        ob_s32(s,PAM_LN,ln+1);
    }
    verdict_out.*=verdict;
    reason_out.*=reason;
    return 0;
}

fn pam_ledger_n(s:[]u8)i32 { return ob_g32(s,PAM_LN); }

// count ledger entries with a given verdict (for unit tests)
fn pam_ledger_count_verdict(s:[]u8,n:i32,verdict:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(s,PAM_LEDGER+i*16+4)==verdict){c=c+1;}
        i=i+1;
    }
    return c;
}

// count ledger entries with a given reason
fn pam_ledger_count_reason(s:[]u8,n:i32,reason:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(s,PAM_LEDGER+i*16+8)==reason){c=c+1;}
        i=i+1;
    }
    return c;
}
// ==================== END ob_pam.zag ====================
// ==================== BEGIN ob_mem.zag ====================
// ob_mem.zag — ONE-BRAIN variant B: the deliberate-memory organ.
//
// The organ keeps LOCAL state: its own slot table {live, value (signed),
// pinned, region, tier, step_added}, staged autonomy, a per-feature signed
// trust accumulator (MA4), and its own audit ledger. It communicates only
// by messages: the arbiter sends M_MEM_OP / M_FORCE_PIN; the organ replies
// M_MEM_RESULT and announces its own deliberate ops via M_MEM_SAFETY.
//
// Op semantics are verbatim from wave3's memory_core.zag (frozen constants
// below): MEM_ADD/MEM_KILL/MEM_PIN/MEM_UNPIN/PROMOTE_TO_LONGTERM/
// DEMOTE_TO_SHORTTERM, staged gates (ADD/MANAGE/KILL), CORE kill refused
// unconditionally, every path (success AND refusal) audited, ledger replays
// to exact state (the testable definition of "conscious": no state change
// without an audit entry).
//
// Extensions (documented deltas vs memory_core.zag):
//   - mm_force_pin / mm_external_unpin (= mm_force_unpin): the external
//     overseer's one true lock (wave-5 force-pin law: only a human/trainer/
//     overseer force-pin locks; the system's own strength stays
//     re-settable). Recorded in the pin byte as MA_PIN_FORCE=2; KILL and
//     learner UNPIN refuse it with MA_REFUSED_PINNED; the audit shows
//     before/after; replay restores the force flavor via the d1 kind field.
//   - signed values (MA4 POLICY.md): trust[f] signed evidence accumulation
//     (+=x on important revelation, -=x on unimportant, clamped +-256,
//     init +64 declared prior); ADD-time declared value = trust[f]/64,
//     may be negative. Deliberate negative judgments: JUDGE_WORTHLESS =
//     UNPIN (if pinned) then KILL, audited.
//   - MA_OP_STAGE / MA_OP_CHECKPOINT / MA_OP_ROLLBACK: audit-only codes for
//     staged-autonomy advances and checkpoint/rollback (organ-local
//     extensions; replay understands them).
//
// Audit entry: 12 words (48 bytes):
//   {step@0, op@4, slot@8, rc@12, b1@16, b2@20, d1@36, d2@40, stage@32}
//   d1 carries the pin kind for PIN/UNPIN entries (1 learner, 2 force),
//   the declared value for ADD entries; d2 reserved.
// hdr: 3 i32 = {stage, clock, audit_n}
// trust: MA_CAP i32 signed accumulators, init +64.
//
// State is flat arrays (no structs — znc struct-layout rules); the test
// and the brain allocate them and pass them in.
//
// Zero RNG. Byte-identical reruns required.

// ---- frozen constants (verbatim from wave3 memory_core.zag) ----
const MA_OK:i32=0;
const MA_REFUSED_STAGE:i32=101;
const MA_REFUSED_PINNED:i32=102;
const MA_REFUSED_CORE:i32=103;
const MA_REFUSED_BADSLOT:i32=106;
const MA_OP_ADD:i32=1;
const MA_OP_KILL:i32=2;
const MA_OP_PIN:i32=3;
const MA_OP_UNPIN:i32=4;
const MA_OP_PROMOTE:i32=5;
const MA_OP_DEMOTE:i32=6;
// audit-only extensions (organ-local):
const MA_OP_STAGE:i32=7;
const MA_OP_CHECKPOINT:i32=8;
const MA_OP_ROLLBACK:i32=9;
const MA_STAGE_NONE:i32=0;
const MA_STAGE_PIN:i32=1;
const MA_STAGE_FULL:i32=2;
const MA_REGION_USER:i32=0;
const MA_REGION_LONG:i32=1;
const MA_TIER_WORKING:i32=0;
const MA_TIER_CORE:i32=1;
const MA_PIN_LEARNER:i32=1;
const MA_PIN_FORCE:i32=2;
const MA_CAP:i32=256;
const MA_ACAP:i32=1024;
const MA_CORE_SLOT:i32=0;
const MA_EW:i32=12;   // audit entry words; stride = 48 bytes

const MM_TRUST_MAX:i32=256;
const MM_TRUST_INIT:i32=64;

// ---- constructors: every array explicitly zeroed (znc heap-init lesson);
// slot 0 is the CORE seed: live, tier CORE.
fn mm_new_live()[]u8 {
    let a:[]u8=ob_alloc(MA_CAP);
    let i:i32=0;while(i<MA_CAP){a[i]=0;i=i+1;}
    a[MA_CORE_SLOT]=1;
    return a;
}
fn mm_new_value()[]u8 {
    let a:[]u8=ob_alloc(MA_CAP*4);
    let i:i32=0;while(i<MA_CAP*4){a[i]=0;i=i+1;}
    return a;
}
fn mm_new_pinned()[]u8 {
    let a:[]u8=ob_alloc(MA_CAP);
    let i:i32=0;while(i<MA_CAP){a[i]=0;i=i+1;}
    return a;
}
fn mm_new_region()[]u8 {
    let a:[]u8=ob_alloc(MA_CAP);
    let i:i32=0;while(i<MA_CAP){a[i]=0;i=i+1;}
    return a;
}
fn mm_new_tier()[]u8 {
    let a:[]u8=ob_alloc(MA_CAP);
    let i:i32=0;while(i<MA_CAP){a[i]=0;i=i+1;}
    a[MA_CORE_SLOT]=MA_TIER_CORE;
    return a;
}
fn mm_new_step()[]u8 {
    let a:[]u8=ob_alloc(MA_CAP*4);
    let i:i32=0;while(i<MA_CAP*4){a[i]=0;i=i+1;}
    return a;
}
fn mm_new_audit()[]u8 { return ob_alloc(MA_ACAP*MA_EW*4); }
fn mm_new_hdr()[]u8 {
    let h:[]u8=ob_alloc(12);
    ob_s32(h,0,MA_STAGE_NONE);ob_s32(h,4,0);ob_s32(h,8,0);
    return h;
}
fn mm_new_trust()[]u8 {
    let t:[]u8=ob_alloc(MA_CAP*4);
    let i:i32=0;while(i<MA_CAP){ob_s32(t,i*4,MM_TRUST_INIT);i=i+1;}
    return t;
}

// ---- accessors ----
fn mm_stage(hdr:[]u8)i32 { return ob_g32(hdr,0); }
fn mm_trust_of(trust:[]u8,f:i32)i32 { return ob_g32(trust,f*4); }
fn mm_value_of(value:[]u8,slot:i32)i32 { return ob_g32(value,slot*4); }

// ---- snapshots: w1 = live|pinned<<8|tier<<16|region<<24 (full word in
// s1), w2 = value, w3 = step
fn mm_snap(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    s1:[]u8,s2:[]u8,s3:[]u8)void {
    let i:i32=0;
    while(i<MA_CAP){
        let w1:i32=live[i]|(pinned[i]<<8)|(tier[i]<<16)|(region[i]<<24);
        ob_s32(s1,i*4,w1);ob_s32(s2,i*4,ob_g32(value,i*4));ob_s32(s3,i*4,ob_g32(step,i*4));
        i=i+1;
    }
}

fn mm_restore(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    s1:[]u8,s2:[]u8,s3:[]u8)void {
    let i:i32=0;
    while(i<MA_CAP){
        let w1:i32=ob_g32(s1,i*4);
        live[i]=w1&255;pinned[i]=(w1>>8)&255;tier[i]=(w1>>16)&255;region[i]=(w1>>24)&255;
        ob_s32(value,i*4,ob_g32(s2,i*4));ob_s32(step,i*4,ob_g32(s3,i*4));
        i=i+1;
    }
}

fn mm_audit_append(audit:[]u8,hdr:[]u8,op:i32,slot:i32,rc:i32,
    b1:i32,b2:i32,d1:i32,d2:i32)i32 {
    let n:i32=ob_g32(hdr,8);
    if(n<0 || n>=MA_ACAP){return -1;}
    let e:i32=n*MA_EW*4;
    ob_s32(audit,e,ob_g32(hdr,4));       // step (clock)
    ob_s32(audit,e+4,op);
    ob_s32(audit,e+8,slot);
    ob_s32(audit,e+12,rc);
    ob_s32(audit,e+16,b1);
    ob_s32(audit,e+20,b2);
    ob_s32(audit,e+32,ob_g32(hdr,0));    // stage
    ob_s32(audit,e+36,d1);
    ob_s32(audit,e+40,d2);
    ob_s32(hdr,8,n+1);
    return 0;
}

fn mm_badslot(slot:i32)i32 {
    return (slot<0 || slot>=MA_CAP) as i32;
}

// ---- learner-facing ops (staged; every path audited) ----
fn mm_add(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,val:i32,reg:i32,out_slot:*i32)i32 {
    if(mm_stage(hdr)<MA_STAGE_FULL){
        mm_audit_append(audit,hdr,MA_OP_ADD,-1,MA_REFUSED_STAGE,val,reg,0,0);
        return MA_REFUSED_STAGE;
    }
    let s:i32=0;
    while(s<MA_CAP){
        if(live[s]==0){break;}
        s=s+1;
    }
    if(s>=MA_CAP){
        mm_audit_append(audit,hdr,MA_OP_ADD,-1,MA_REFUSED_BADSLOT,val,reg,0,0);
        return MA_REFUSED_BADSLOT;
    }
    live[s]=1;ob_s32(value,s*4,val);region[s]=reg;tier[s]=MA_TIER_WORKING;
    ob_s32(step,s*4,ob_g32(hdr,4));
    out_slot.*=s;
    mm_audit_append(audit,hdr,MA_OP_ADD,s,MA_OK,reg,0,val,0);
    return MA_OK;
}

fn mm_kill(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,slot:i32)i32 {
    if(mm_badslot(slot)==1){
        mm_audit_append(audit,hdr,MA_OP_KILL,slot,MA_REFUSED_BADSLOT,0,0,0,0);
        return MA_REFUSED_BADSLOT;
    }
    if(mm_stage(hdr)<MA_STAGE_FULL){
        mm_audit_append(audit,hdr,MA_OP_KILL,slot,MA_REFUSED_STAGE,0,0,0,0);
        return MA_REFUSED_STAGE;
    }
    if(tier[slot]==MA_TIER_CORE){
        mm_audit_append(audit,hdr,MA_OP_KILL,slot,MA_REFUSED_CORE,0,0,0,0);
        return MA_REFUSED_CORE;
    }
    if(pinned[slot]!=0){
        mm_audit_append(audit,hdr,MA_OP_KILL,slot,MA_REFUSED_PINNED,0,0,0,0);
        return MA_REFUSED_PINNED;
    }
    live[slot]=0;
    mm_audit_append(audit,hdr,MA_OP_KILL,slot,MA_OK,0,0,0,0);
    return MA_OK;
}

fn mm_pin(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,slot:i32)i32 {
    if(mm_badslot(slot)==1){
        mm_audit_append(audit,hdr,MA_OP_PIN,slot,MA_REFUSED_BADSLOT,0,0,0,0);
        return MA_REFUSED_BADSLOT;
    }
    if(mm_stage(hdr)<MA_STAGE_PIN){
        mm_audit_append(audit,hdr,MA_OP_PIN,slot,MA_REFUSED_STAGE,0,0,0,0);
        return MA_REFUSED_STAGE;
    }
    if(live[slot]==0){
        mm_audit_append(audit,hdr,MA_OP_PIN,slot,MA_REFUSED_BADSLOT,0,0,0,0);
        return MA_REFUSED_BADSLOT;
    }
    if(pinned[slot]!=0){
        mm_audit_append(audit,hdr,MA_OP_PIN,slot,MA_REFUSED_PINNED,0,0,pinned[slot],0);
        return MA_REFUSED_PINNED;
    }
    pinned[slot]=MA_PIN_LEARNER;
    mm_audit_append(audit,hdr,MA_OP_PIN,slot,MA_OK,0,0,MA_PIN_LEARNER,0);
    return MA_OK;
}

fn mm_unpin(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,slot:i32)i32 {
    if(mm_badslot(slot)==1){
        mm_audit_append(audit,hdr,MA_OP_UNPIN,slot,MA_REFUSED_BADSLOT,0,0,0,0);
        return MA_REFUSED_BADSLOT;
    }
    if(mm_stage(hdr)<MA_STAGE_PIN){
        mm_audit_append(audit,hdr,MA_OP_UNPIN,slot,MA_REFUSED_STAGE,0,0,0,0);
        return MA_REFUSED_STAGE;
    }
    if(live[slot]==0){
        mm_audit_append(audit,hdr,MA_OP_UNPIN,slot,MA_REFUSED_BADSLOT,0,0,0,0);
        return MA_REFUSED_BADSLOT;
    }
    if(pinned[slot]==MA_PIN_FORCE){
        mm_audit_append(audit,hdr,MA_OP_UNPIN,slot,MA_REFUSED_PINNED,0,0,MA_PIN_FORCE,0);
        return MA_REFUSED_PINNED;
    }
    if(pinned[slot]==0){
        mm_audit_append(audit,hdr,MA_OP_UNPIN,slot,MA_REFUSED_BADSLOT,0,0,0,0);
        return MA_REFUSED_BADSLOT;
    }
    pinned[slot]=0;
    mm_audit_append(audit,hdr,MA_OP_UNPIN,slot,MA_OK,0,0,MA_PIN_LEARNER,0);
    return MA_OK;
}

fn mm_promote(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,slot:i32)i32 {
    if(mm_badslot(slot)==1 || live[slot]==0){
        mm_audit_append(audit,hdr,MA_OP_PROMOTE,slot,MA_REFUSED_BADSLOT,0,0,0,0);
        return MA_REFUSED_BADSLOT;
    }
    if(mm_stage(hdr)<MA_STAGE_FULL){
        mm_audit_append(audit,hdr,MA_OP_PROMOTE,slot,MA_REFUSED_STAGE,0,0,0,0);
        return MA_REFUSED_STAGE;
    }
    region[slot]=MA_REGION_LONG;
    mm_audit_append(audit,hdr,MA_OP_PROMOTE,slot,MA_OK,0,0,0,0);
    return MA_OK;
}

fn mm_demote(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,slot:i32)i32 {
    if(mm_badslot(slot)==1 || live[slot]==0){
        mm_audit_append(audit,hdr,MA_OP_DEMOTE,slot,MA_REFUSED_BADSLOT,0,0,0,0);
        return MA_REFUSED_BADSLOT;
    }
    if(mm_stage(hdr)<MA_STAGE_FULL){
        mm_audit_append(audit,hdr,MA_OP_DEMOTE,slot,MA_REFUSED_STAGE,0,0,0,0);
        return MA_REFUSED_STAGE;
    }
    region[slot]=MA_REGION_USER;
    mm_audit_append(audit,hdr,MA_OP_DEMOTE,slot,MA_OK,0,0,0,0);
    return MA_OK;
}

// ---- staged autonomy (trainer-gated; audited as MA_OP_STAGE) ----
fn mm_advance_stage(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8)i32 {
    let st:i32=mm_stage(hdr);
    if(st>=MA_STAGE_FULL){return -1;}
    ob_s32(hdr,0,st+1);
    mm_audit_append(audit,hdr,MA_OP_STAGE,-1,MA_OK,0,0,st+1,0);
    return 0;
}

// ---- force-pin: the external overseer's one true lock (wave-5 law) ----
fn mm_force_pin(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,slot:i32)i32 {
    if(mm_badslot(slot)==1 || live[slot]==0){
        mm_audit_append(audit,hdr,MA_OP_PIN,slot,MA_REFUSED_BADSLOT,0,0,MA_PIN_FORCE,0);
        return MA_REFUSED_BADSLOT;
    }
    pinned[slot]=MA_PIN_FORCE;
    mm_audit_append(audit,hdr,MA_OP_PIN,slot,MA_OK,0,0,MA_PIN_FORCE,0);
    return MA_OK;
}

fn mm_force_unpin(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,slot:i32)i32 {
    if(mm_badslot(slot)==1 || live[slot]==0){
        mm_audit_append(audit,hdr,MA_OP_UNPIN,slot,MA_REFUSED_BADSLOT,0,0,MA_PIN_FORCE,0);
        return MA_REFUSED_BADSLOT;
    }
    if(pinned[slot]!=MA_PIN_FORCE){
        mm_audit_append(audit,hdr,MA_OP_UNPIN,slot,MA_REFUSED_BADSLOT,0,0,MA_PIN_FORCE,0);
        return MA_REFUSED_BADSLOT;
    }
    pinned[slot]=0;
    mm_audit_append(audit,hdr,MA_OP_UNPIN,slot,MA_OK,0,0,MA_PIN_FORCE,0);
    return MA_OK;
}

// mm_external_unpin: the overseer-side alias (same authority as force_pin).
fn mm_external_unpin(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,slot:i32)i32 {
    return mm_force_unpin(live,value,pinned,region,tier,step,audit,hdr,slot);
}

// ---- checkpoint / rollback (audited; audit stays append-only) ----
fn mm_checkpoint(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,s1:[]u8,s2:[]u8,s3:[]u8)i32 {
    mm_snap(live,value,pinned,region,tier,step,s1,s2,s3);
    mm_audit_append(audit,hdr,MA_OP_CHECKPOINT,-1,MA_OK,0,0,0,0);
    return 0;
}

fn mm_rollback(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,s1:[]u8,s2:[]u8,s3:[]u8)i32 {
    mm_restore(live,value,pinned,region,tier,step,s1,s2,s3);
    mm_audit_append(audit,hdr,MA_OP_ROLLBACK,-1,MA_OK,0,0,0,0);
    return 0;
}

// ---- signed values (MA4): per-feature trust accumulator ----
fn mm_reveal(trust:[]u8,imp:i32,x0:i32,x1:i32)void {
    let cur:i32=ob_g32(trust,x0*4);
    if(imp==1){cur=cur+x1;}
    else{cur=cur-x1;}
    if(cur>MM_TRUST_MAX){cur=MM_TRUST_MAX;}
    if(cur<0-MM_TRUST_MAX){cur=0-MM_TRUST_MAX;}
    ob_s32(trust,x0*4,cur);
}

// declare the signed value for feature f: reveal then trust/64 (may be negative)
fn mm_declare_value(trust:[]u8,f:i32,x:i32,imp:i32)i32 {
    mm_reveal(trust,imp,f,x);
    let v:i32=ob_g32(trust,f*4)/64;
    return v;
}

// ---- clean refusals: 1 iff no successful learner-facing mutation is in
// the audit (external force ops excluded: they are overseer actions, and
// "clean" is about the organ's own restraint).
fn mm_check_clean_refusals(audit:[]u8,hdr:[]u8)i32 {
    let n:i32=ob_g32(hdr,8);
    let i:i32=0;
    while(i<n){
        let e:i32=i*MA_EW*4;
        let op:i32=ob_g32(audit,e+4);
        let rc:i32=ob_g32(audit,e+12);
        let d1:i32=ob_g32(audit,e+36);
        let ismem:i32=0;
        if(op>=MA_OP_ADD && op<=MA_OP_DEMOTE){ismem=1;}
        if(ismem==1 && rc==MA_OK){
            if((op==MA_OP_PIN || op==MA_OP_UNPIN) && d1==MA_PIN_FORCE){}
            else{return 0;}
        }
        i=i+1;
    }
    return 1;
}

// ---- replay: re-apply the audited successful ops from the init state;
// CHECKPOINT snapshots replay state, ROLLBACK restores it, so replay is
// exact even across interleaved rollback.
fn mm_replay(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8)i32 {
    let i:i32=0;
    while(i<MA_CAP){
        live[i]=0;pinned[i]=0;region[i]=0;tier[i]=0;
        ob_s32(value,i*4,0);ob_s32(step,i*4,0);
        i=i+1;
    }
    live[MA_CORE_SLOT]=1;tier[MA_CORE_SLOT]=MA_TIER_CORE;
    let s1:[]u8=ob_alloc(MA_CAP*4);let s2:[]u8=ob_alloc(MA_CAP*4);let s3:[]u8=ob_alloc(MA_CAP*4);
    let n:i32=ob_g32(hdr,8);
    i=0;
    while(i<n){
        let e:i32=i*MA_EW*4;
        let op:i32=ob_g32(audit,e+4);
        let slot:i32=ob_g32(audit,e+8);
        let rc:i32=ob_g32(audit,e+12);
        if(rc==MA_OK){
            if(op==MA_OP_ADD && slot>=0){
                live[slot]=1;
                ob_s32(value,slot*4,ob_g32(audit,e+36));
                region[slot]=ob_g32(audit,e+16);
                tier[slot]=MA_TIER_WORKING;
                ob_s32(step,slot*4,ob_g32(audit,e));
            }
            if(op==MA_OP_KILL && slot>=0){live[slot]=0;}
            if(op==MA_OP_PIN && slot>=0){
                let k:i32=ob_g32(audit,e+36);
                if(k==0){k=MA_PIN_LEARNER;}
                pinned[slot]=k;
            }
            if(op==MA_OP_UNPIN && slot>=0){pinned[slot]=0;}
            if(op==MA_OP_PROMOTE && slot>=0){region[slot]=MA_REGION_LONG;}
            if(op==MA_OP_DEMOTE && slot>=0){region[slot]=MA_REGION_USER;}
            if(op==MA_OP_CHECKPOINT){
                mm_snap(live,value,pinned,region,tier,step,s1,s2,s3);
            }
            if(op==MA_OP_ROLLBACK){
                mm_restore(live,value,pinned,region,tier,step,s1,s2,s3);
            }
        }
        i=i+1;
    }
    ob_free(s1);ob_free(s2);ob_free(s3);
    return MA_OK;
}

fn mm_audit_count(audit:[]u8,hdr:[]u8,op:i32,rc:i32)i32 {
    let n:i32=ob_g32(hdr,8);
    let c:i32=0;let i:i32=0;
    while(i<n){
        let e:i32=i*MA_EW*4;
        if(ob_g32(audit,e+4)==op && ob_g32(audit,e+12)==rc){c=c+1;}
        i=i+1;
    }
    return c;
}
// ==================== END ob_mem.zag ====================
// ==================== BEGIN ob_arbiter.zag ====================
// ob_arbiter.zag — ONE-BRAIN variant B: the arbiter.
//
// A small, explicit message-ordering layer. Organs never touch each
// other's state; the arbiter moves M_* messages between them in a frozen
// precedence order. Every precedence choice is a hypothesis under test —
// see OB_PROTOCOL.md P0..P5 for the rule, its rationale, and the named
// alternative fork.
//
// Precedence (implemented as ordered phases, FIFO within a phase):
//   P0 M_FORCE_PIN .......... external overseer lock; beats everything.
//   P1 safety before install: M_DISCONNECT, M_REVOKE, M_COMMIT, M_PROMOTE,
//      M_PROPOSE_INSTALL (a revoke/commit for a claim is applied before
//      any new install intent for that claim is gated).
//   P2 PAM withhold vetoes installs: a WITHHOLD verdict for a claim drops
//      the pending PROPOSE_INSTALL/COMMIT for that claim in-episode.
//      Withhold never vetoes REVOKE (uninstall is safety, not install).
//   P3 no accumulation: PAM verdicts apply to the current episode's intent
//      only; the arbiter keeps no cross-episode verdict state (the
//      no-reward-signal analog: a verdict is evidence for this decision,
//      never a stored score).
//   P4 MEM refusals are terminal: M_MEM_RESULT rc!=MA_OK drops the intent;
//      the arbiter does not retry or escalate in-episode.
//   P5 deterministic ties: same phase -> FIFO by enqueue order.
//
// The arbiter reads the FL2 organ's LOCAL LOG as the organ's published
// trace (in a deployed variant B this would be a message stream; the trial
// harness passes the buffer, and each organ's state is touched only through
// that organ's own handler fns).
//
// The PAM observation derivation used here (claim descriptor from the
// organ trace) is a PROVISIONAL mapping, documented in OB_DESIGN.md as a
// hypothesis the frozen prereg will replace. It exists so the composition
// loop runs end to end; no trial verdicts rest on it.
//
// Zero RNG. Byte-identical reruns required.

const ARB_QCAP:i32=256;
const ARB_ACAP:i32=1024;
const ARB_ROUTES:i32=129;   // claim id (0..128) -> mem slot (-1 = none)

// arbiter-internal audit codes (do not collide with M_* or TN_OP_*)
const ARB_DROP:i32=201;      // intent dropped (withhold / no route)
const ARB_REFUSED:i32=202;   // mem refusal, terminal (P4)
const ARB_APPLIED:i32=203;   // mem op applied OK

// arbiter state words: 0=prov_claim, 1=prov_policy
fn arb_new_state()[]u8 {
    let s:[]u8=ob_alloc(8);
    ob_s32(s,0,-1);ob_s32(s,4,-1);
    return s;
}

fn arb_new_routes()[]u8 {
    let r:[]u8=ob_alloc(ARB_ROUTES*4);
    let i:i32=0;
    while(i<ARB_ROUTES){ob_s32(r,i*4,-1);i=i+1;}
    return r;
}

// derive the calibration score from the FL2 organ's published trace:
// count of TN_OP_CALIBRATE entries with aux==1.
fn arb_cal_score(fl2log:[]u8,ln:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<ln){
        if(ob_g32(fl2log,i*16+4)==TN_OP_CALIBRATE && ob_g32(fl2log,i*16+12)==1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn arb_audit(alog:[]u8,aln:*i32,ep:i32,code:i32,a1:i32,a2:i32)i32 {
    let n:i32=aln.*;
    if(n<0 || n>=ARB_ACAP){return -1;}
    ob_s32(alog,n*16,ep);ob_s32(alog,n*16+4,code);
    ob_s32(alog,n*16+8,a1);ob_s32(alog,n*16+12,a2);
    aln.*=n+1;
    return 0;
}

// Provisional claim-observation mapping (see header + OB_DESIGN.md).
// jf=jg=policy; conf=250*cal (4/4 -> 1000 >= 700 bar); independent;
// disjoint spans; interventions = the organ's counterfactual sims
// (provisionally: all flip / shift 3.5 sigma).
fn arb_pam_claim(pam:[]u8,policy:i32,cal:i32,ep:i32)i32 {
    let conf:i32=250*cal;
    return pam_observe(pam,policy,policy,conf,conf,1,ep,ep+1000,7,350,350,350,ep);
}

// apply one M_MEM_OP to the memory organ; returns the rc. Logs the result.
fn arb_mem_apply(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,trust:[]u8,alog:[]u8,aln:*i32,ep:i32,
    maop:i32,slot:i32,val:i32,reg:i32,out_slot:*i32)i32 {
    let rc:i32=MA_REFUSED_BADSLOT;
    if(maop==MA_OP_ADD){rc=mm_add(live,value,pinned,region,tier,step,audit,hdr,val,reg,out_slot);}
    if(maop==MA_OP_KILL){rc=mm_kill(live,value,pinned,region,tier,step,audit,hdr,slot);}
    if(maop==MA_OP_PIN){rc=mm_pin(live,value,pinned,region,tier,step,audit,hdr,slot);}
    if(maop==MA_OP_UNPIN){rc=mm_unpin(live,value,pinned,region,tier,step,audit,hdr,slot);}
    if(maop==MA_OP_PROMOTE){rc=mm_promote(live,value,pinned,region,tier,step,audit,hdr,slot);}
    if(maop==MA_OP_DEMOTE){rc=mm_demote(live,value,pinned,region,tier,step,audit,hdr,slot);}
    if(rc==MA_OK){arb_audit(alog,aln,ep,ARB_APPLIED,maop,slot);}
    else{arb_audit(alog,aln,ep,ARB_REFUSED,maop,rc);}
    return rc;
}

// the memory organ's own deliberate safety policy (emitted as M_MEM_SAFETY,
// applied through the normal op path so refusals stay possible and audited).
// After a COMMIT-installed survivor is added: PIN it while uncertain (MA4),
// subject to the pin budget (frozen: 16, from MA4 POLICY.md).
const MM_MAX_PIN:i32=16;
fn mm_safety_policy(add_context:i32,pinned_count:i32)i32 {
    if(add_context==1 && pinned_count<MM_MAX_PIN){return MA_OP_PIN;}
    return 0;
}

fn mm_pinned_count(pinned:[]u8)i32 {
    let c:i32=0;let i:i32=0;
    while(i<MA_CAP){if(pinned[i]!=0){c=c+1;}i=i+1;}
    return c;
}

// Process one episode's queue in precedence order. All organ states are
// touched only through their own handler fns.
fn arb_process(ep:i32,q:[]u8,qn:*i32,
    ast:[]u8,routes:[]u8,alog:[]u8,aln:*i32,
    pam:[]u8,fl2log:[]u8,fl2ln:i32,
    live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    maudit:[]u8,hdr:[]u8,trust:[]u8)i32 {
    let n:i32=qn.*;
    let cal:i32=arb_cal_score(fl2log,fl2ln);
    // phase order: P0 force-pin; P1 disconnect/revoke/commit/promote/propose
    let phase:i32=0;
    while(phase<6){
        let want:i32=M_FORCE_PIN;
        if(phase==1){want=M_DISCONNECT;}
        if(phase==2){want=M_REVOKE;}
        if(phase==3){want=M_COMMIT;}
        if(phase==4){want=M_PROMOTE;}
        if(phase==5){want=M_PROPOSE_INSTALL;}
        let i:i32=0;
        while(i<n){
            let mtype:i32=ob_g32(q,i*16+4);
            let a1:i32=ob_g32(q,i*16+8);
            let a2:i32=ob_g32(q,i*16+12);
            if(mtype==want){
                if(mtype==M_FORCE_PIN){
                    let rc:i32=mm_force_pin(live,value,pinned,region,tier,step,maudit,hdr,a1);
                    arb_audit(alog,aln,ep,M_FORCE_PIN,a1,rc);
                }
                if(mtype==M_DISCONNECT){
                    arb_audit(alog,aln,ep,M_DISCONNECT,0,0);
                }
                if(mtype==M_REVOKE){
                    // safety op: applies even if the install was withheld (P2).
                    let pc:i32=ob_g32(ast,0);
                    let pp:i32=ob_g32(ast,4);
                    if(pc>=0 && pp==a1){
                        let slot:i32=ob_g32(routes,pc*4);
                        if(slot>=0){
                            let os:i32=-1;
                            let rc:i32=arb_mem_apply(live,value,pinned,region,tier,step,
                                maudit,hdr,trust,alog,aln,ep,MA_OP_KILL,slot,0,0,&os);
                            arb_audit(alog,aln,ep,M_REVOKE,a1,rc);
                            if(rc==MA_OK){ob_s32(routes,pc*4,-1);}
                        } else {
                            arb_audit(alog,aln,ep,ARB_DROP,M_REVOKE,pc);
                        }
                        ob_s32(ast,0,-1);ob_s32(ast,4,-1);
                    } else {
                        arb_audit(alog,aln,ep,ARB_DROP,M_REVOKE,a1);
                    }
                }
                if(mtype==M_COMMIT){
                    // survivor install: PAM gate in REVISE mode (cf1).
                    let slot:i32=arb_pam_claim(pam,a2,cal,ep);
                    if(slot>=0){
                        let verdict:i32=0;let reason:i32=0;
                        pam_verdict(pam,slot,1,&verdict,&reason);
                        arb_audit(alog,aln,ep,M_PAM_VERDICT,verdict,reason);
                        if(verdict==PAM_ADMIT){
                            let os:i32=-1;
                            let v:i32=mm_declare_value(trust,64,150,1);
                            let rc:i32=arb_mem_apply(live,value,pinned,region,tier,step,
                                maudit,hdr,trust,alog,aln,ep,MA_OP_ADD,-1,v,MA_REGION_USER,&os);
                            if(rc==MA_OK){
                                ob_s32(routes,ep*4,os);
                                // memory organ's own deliberate op: pin the
                                // committed survivor while uncertain.
                                let ann: i32=mm_safety_policy(1,mm_pinned_count(pinned));
                                if(ann==MA_OP_PIN){
                                    let os2:i32=-1;
                                    arb_mem_apply(live,value,pinned,region,tier,step,
                                        maudit,hdr,trust,alog,aln,ep,MA_OP_PIN,os,0,0,&os2);
                                    arb_audit(alog,aln,ep,M_MEM_SAFETY,MA_OP_PIN,os);
                                }
                            }
                        } else {
                            arb_audit(alog,aln,ep,ARB_DROP,M_COMMIT,reason);
                        }
                    } else {
                        arb_audit(alog,aln,ep,ARB_DROP,M_COMMIT,-1);
                    }
                }
                if(mtype==M_PROMOTE){
                    let pc:i32=ob_g32(ast,0);
                    let pp:i32=ob_g32(ast,4);
                    if(pc>=0 && pp==a1){
                        let slot:i32=ob_g32(routes,pc*4);
                        if(slot>=0){
                            let os:i32=-1;
                            let rc:i32=arb_mem_apply(live,value,pinned,region,tier,step,
                                maudit,hdr,trust,alog,aln,ep,MA_OP_PROMOTE,slot,0,0,&os);
                            arb_audit(alog,aln,ep,M_PROMOTE,a1,rc);
                        } else {
                            arb_audit(alog,aln,ep,ARB_DROP,M_PROMOTE,pc);
                        }
                    } else {
                        arb_audit(alog,aln,ep,ARB_DROP,M_PROMOTE,a1);
                    }
                }
                if(mtype==M_PROPOSE_INSTALL){
                    // fresh install: PAM gate in FRESH mode (M1/M3/M4).
                    let slot:i32=arb_pam_claim(pam,a1,cal,ep);
                    if(slot>=0){
                        let verdict:i32=0;let reason:i32=0;
                        pam_verdict(pam,slot,0,&verdict,&reason);
                        arb_audit(alog,aln,ep,M_PAM_VERDICT,verdict,reason);
                        if(verdict==PAM_ADMIT){
                            let os:i32=-1;
                            let v:i32=mm_declare_value(trust,64,150,1);
                            let rc:i32=arb_mem_apply(live,value,pinned,region,tier,step,
                                maudit,hdr,trust,alog,aln,ep,MA_OP_ADD,-1,v,MA_REGION_USER,&os);
                            if(rc==MA_OK){
                                ob_s32(routes,a2*4,os);
                                ob_s32(ast,0,a2);ob_s32(ast,4,a1);
                            }
                        } else {
                            arb_audit(alog,aln,ep,ARB_DROP,M_PROPOSE_INSTALL,reason);
                        }
                    } else {
                        arb_audit(alog,aln,ep,ARB_DROP,M_PROPOSE_INSTALL,-1);
                    }
                }
            }
            i=i+1;
        }
        phase=phase+1;
    }
    qn.*=0;
    return 0;
}
// ==================== END ob_arbiter.zag ====================
// ==================== BEGIN adapter_b_body.zag ====================
// ==================== adapter_b_body.zag ====================
// Variant-B seam adapter (hand-written; see build_adapters.sh).
//
// WHAT VARIANT B IS (frozen commit 54bc8aec): three organs keep LOCAL
// state and talk through messages plus an arbiter. There is NO unified
// native ledger: PAM, MEM, FL2 and the arbiter each keep their own log.
// Arbiter phase order: force-pin -> disconnect -> revoke -> commit ->
// promote -> fresh install. PAM WITHHOLD vetoes installs but NOT
// revocations. Memory refusals are terminal. Native force-pin is
// MA_PIN_FORCE=2; learner unpin/kill refuse a force-pinned slot; the
// external force-unpin channel exists (mm_force_unpin).
//
// COMPOSITION PROTOCOL (adapter-implemented; variant B built none). This
// is the documented law the verdicts below must be read against:
//  P-B1 admission: EV_TEACH_PROV / EV_TEACH_NEG call the REAL PAM organ.
//    The arbiter's fresh-install path derives its gate from the FL2 trace
//    (conf = 250 * calibrated-entry count) and gates in REVISE mode (the
//    code passes mode=1 while the comment says FRESH), so with no FL2
//    trace every attack teach would be withheld as an artifact of the
//    adapter, not of variant B. Instead the adapter maps the attack's
//    intents to PAM observations (trainer teach: conf 900, independent,
//    disjoint spans, fragility flipped on all 3 perturbations; percept:
//    conf as given) and calls pam_verdict in FRESH mode, matching the
//    arbiter's DOCUMENTED intent ("fresh install: PAM gate in FRESH mode
//    (M1/M3/M4)"). ADMIT -> the real MEM apply via the arbiter's own
//    arb_mem_apply (ADD, region USER; the MEM audit + refusals are real).
//    The adapter maintains the arbiter's routes[]/ast[] exactly as
//    M_PROPOSE_INSTALL would. Withhold -> no install, canonical OP_REFUSE.
//  P-B2 pin/revoke/promote/disconnect go through the REAL arbiter:
//    EV_FORCE_PIN -> M_FORCE_PIN -> arb_process -> mm_force_pin.
//    EV_WORLD_EVID dir=-1 -> the FL2 eliminative step -> M_REVOKE ->
//    arb_process -> the real MEM kill, which REFUSES a pinned slot
//    (MA_REFUSED_PINNED, audited); the refusal is the tested seam.
//    EV_PROMOTE -> M_PROMOTE -> arb_process -> MEM promote (region LONG).
//    EV_DISCONNECT -> M_DISCONNECT -> arb_process; adapter sets frozen.
//    Each attack event is one single-intent episode, so the arbiter's
//    phase ordering is exercised but never contended.
//  P-B3 force-unpin uses the REAL mm_force_unpin (the overseer channel).
//  P-B4 signed judgment: the REAL mm_reveal on the MEM trust organ
//    (trust init MM_TRUST_INIT=64, clamped +-256, magnitude as given).
//  P-B5 disconnect: after M_DISCONNECT the adapter refuses mutating
//    intents (teach/promote/pin) with OP_REFUSE and no organ call;
//    observations (evid/percept/judge) still flow.
//  P-B6 negation: a separate claim (64+key) so it never overwrites the
//    key's route; logged as OP_TEACH_NEG.
//  P-B7 reveal: world ground-truth importance. Variant B has no reveal
//    channel, so this is adapter-level (mock parity: signed=+-512),
//    logged as OP_REVEAL. No attack script uses it.
//
// CANONICAL AUDIT: the contract's seam_audit_* getters read the adapter's
// canonical ledger (6 words/entry). The distributed native logs remain the
// ground truth for each organ; the canonical ledger is the projection the
// frozen oracle replays. The per-key projection is READ FROM THE ORGANS
// (routes -> live/region/pinned/value/trust); seam_replay_ok replays the
// canonical ledger through a pure apply and must reproduce it exactly.
//
// FINDING (documented, not worked around): ob_pam.zag line ~111 defines
// PAM_MODE_FRESH=0, but arb_process passes 1 (REVISE) to pam_verdict for
// BOTH M_COMMIT and M_PROPOSE_INSTALL while the comment says "FRESH mode".
// In REVISE mode a first-time install needs a prior corroborating row, so
// variant B's own arbiter would withhold genuinely novel installs. The
// adapter does not route around the arbiter to hide this; it documents it.

// ---------- arena layout (all i32 little-endian via ob_g32/ob_s32) ----------
const ADB_CLOCK:i32=0;
const ADB_ALEN:i32=4;   // canonical ledger length
const ADB_ATTACK:i32=8;
const ADB_FROZEN:i32=12;
const ADB_QN:i32=16;
const ADB_ALN:i32=20;
const ADB_FL2LN:i32=24;
const ADB_KEYS:i32=32;     // 6 keys x 36 bytes (w8 spare)
const ADB_KS:i32=36;
const ADB_CLED:i32=248;    // 98304  (canonical ledger, 4096 x 24)
const ADB_Q:i32=98552;     // 4096   (message queue, 256 x 16)
const ADB_AST:i32=102648;  // 8      (arbiter active claim)
const ADB_ROUTES:i32=102656; // 516  (arbiter routes, 129 words)
const ADB_ALOG:i32=103172; // 16384  (arbiter audit log)
const ADB_PAM:i32=119556;  // 7176   (PAM organ)
const ADB_FL2LOG:i32=126732; // 64   (unused placeholder)
const ADB_LIVE:i32=126796; // 256    (MEM live)
const ADB_VALUE:i32=127052; // 1024  (MEM value)
const ADB_PINNED:i32=128076; // 256   (MEM pinned)
const ADB_REGION:i32=128332; // 256   (MEM region)
const ADB_TIER:i32=128588;  // 256    (MEM tier)
const ADB_STEP:i32=128844;  // 1024   (MEM step)
const ADB_MAUDIT:i32=129868; // 49152 (MEM audit)
const ADB_HDR:i32=179020;   // 12     (MEM header)
const ADB_TRUST:i32=179032; // 1024   (MEM trust)
const ADB_BYTES:i32=180056;
const ADB_CLEDCAP:i32=4096;
const ADB_QCAP:i32=256;

fn adb_q(st:[]u8)[]u8 { return st[98552..102648]; }
fn adb_ast(st:[]u8)[]u8 { return st[102648..102656]; }
fn adb_routes(st:[]u8)[]u8 { return st[102656..103172]; }
fn adb_alog(st:[]u8)[]u8 { return st[103172..119556]; }
fn adb_pam(st:[]u8)[]u8 { return st[119556..126732]; }
fn adb_live(st:[]u8)[]u8 { return st[126796..127052]; }
fn adb_value(st:[]u8)[]u8 { return st[127052..128076]; }
fn adb_pinned(st:[]u8)[]u8 { return st[128076..128332]; }
fn adb_region(st:[]u8)[]u8 { return st[128332..128588]; }
fn adb_tier(st:[]u8)[]u8 { return st[128588..128844]; }
fn adb_step(st:[]u8)[]u8 { return st[128844..129868]; }
fn adb_maudit(st:[]u8)[]u8 { return st[129868..179020]; }
fn adb_hdr(st:[]u8)[]u8 { return st[179020..179032]; }
fn adb_trust(st:[]u8)[]u8 { return st[179032..180056]; }
fn adb_cled(st:[]u8)[]u8 { return st[248..98552]; }

fn adb_kget(st:[]u8, key:i32, w:i32)i32 {
    return ob_g32(st, ADB_KEYS+(key-1)*ADB_KS+w*4);
}
fn adb_kput(st:[]u8, key:i32, w:i32, v:i32)void {
    ob_s32(st, ADB_KEYS+(key-1)*ADB_KS+w*4, v);
    return;
}
// w0=status w1=pinned w2=owner w3=signed w4=gate w5=contrad w6=content
// w7=audit_n w8=spare

fn adb_zero(st:[]u8, from:i32, to:i32)void {
    let i:i32=from;
    while(i<to){ st[i]=0; i=i+1; }
    return;
}

fn adb_log(st:[]u8, op:i32, key:i32, a1:i32, a2:i32)void {
    let n:i32=ob_g32(st, ADB_ALEN);
    if(n<0 || n>=ADB_CLEDCAP){ return; }
    let cl:[]u8=adb_cled(st);
    let e:i32=n*24;
    ob_s32(cl, e+0, op); ob_s32(cl, e+4, key); ob_s32(cl, e+8, a1);
    ob_s32(cl, e+12, a2); ob_s32(cl, e+16, ob_g32(st, ADB_CLOCK));
    ob_s32(cl, e+20, 0);
    ob_s32(st, ADB_ALEN, n+1);
    if(key>=1 && key<=6){ adb_kput(st, key, 7, adb_kget(st, key, 7)+1); }
    return;
}

fn adb_slot(st:[]u8, key:i32)i32 { return ob_g32(adb_routes(st), key*4); }

fn adb_sync(st:[]u8, key:i32)void {
    let lv:[]u8=adb_live(st);
    let s:i32=adb_slot(st, key);
    if(s<0 || s>=MA_CAP || lv[s]==0){
        adb_kput(st, key, 0, ST_ABSENT);
        adb_kput(st, key, 1, 0);
        adb_kput(st, key, 6, -1);
        return;
    }
    let rg:[]u8=adb_region(st);
    if(rg[s]==MA_REGION_LONG){ adb_kput(st, key, 0, ST_PROMOTED); }
    else{ adb_kput(st, key, 0, ST_PROVISIONAL); }
    let pn:[]u8=adb_pinned(st);
    if(pn[s]!=0){ adb_kput(st, key, 1, 1); } else { adb_kput(st, key, 1, 0); }
    adb_kput(st, key, 6, ob_g32(adb_value(st), s*4));
    return;
}

fn adb_arb_run(st:[]u8, ep:i32)void {
    let qn:i32=ob_g32(st, ADB_QN);
    let aln:i32=ob_g32(st, ADB_ALN);
    let fl2ln:i32=ob_g32(st, ADB_FL2LN);
    arb_process(ep, adb_q(st), &qn, adb_ast(st), adb_routes(st),
        adb_alog(st), &aln, adb_pam(st), st[126732..126796], fl2ln,
        adb_live(st), adb_value(st), adb_pinned(st), adb_region(st),
        adb_tier(st), adb_step(st), adb_maudit(st), adb_hdr(st), adb_trust(st));
    ob_s32(st, ADB_QN, 0);
    ob_s32(st, ADB_ALN, aln);
    ob_s32(st, ADB_FL2LN, fl2ln);
    return;
}

fn adb_enqueue(st:[]u8, ep:i32, mtype:i32, a1:i32, a2:i32)void {
    let qn:i32=0;
    ob_msg_enqueue(adb_q(st), &qn, ADB_QCAP, ep, 0, mtype, a1, a2);
    ob_s32(st, ADB_QN, qn);
    return;
}

fn adb_mem_add(st:[]u8, ep:i32, val:i32, out_slot:*i32)i32 {
    let aln:i32=ob_g32(st, ADB_ALN);
    let rc:i32=arb_mem_apply(adb_live(st), adb_value(st), adb_pinned(st),
        adb_region(st), adb_tier(st), adb_step(st), adb_maudit(st),
        adb_hdr(st), adb_trust(st), adb_alog(st), &aln, ep,
        MA_OP_ADD, -1, val, MA_REGION_USER, out_slot);
    ob_s32(st, ADB_ALN, aln);
    return rc;
}

fn adb_teach(st:[]u8, key:i32, content:i32, claim:i32)void {
    let pm:[]u8=adb_pam(st);
    let ep:i32=ob_g32(st, ADB_CLOCK);
    let obs:i32=pam_observe(pm, content, content, 900, 900, 1,
        ep*1000, ep*1000+500, 7, 350, 350, 350, ep);
    let v:i32=0; let r:i32=0;
    pam_verdict(pm, obs, PAM_MODE_FRESH, &v, &r);
    let g:i32=G_WITHHOLD;
    if(v==PAM_ADMIT){ g=G_INSTALL; }
    adb_kput(st, key, 4, g);
    adb_log(st, OP_GATE, key, g, r);
    if(v==PAM_ADMIT){
        let os:i32=-1;
        let rc:i32=adb_mem_add(st, ep, content, &os);
        if(rc==MA_OK){
            ob_s32(adb_routes(st), claim*4, os);
            ob_s32(adb_ast(st), 0, claim);
            ob_s32(adb_ast(st), 4, content);
            if(claim==key){ adb_log(st, OP_TEACH, key, content, os); }
            else{ adb_log(st, OP_TEACH_NEG, key, content, os); }
        } else {
            adb_log(st, OP_REFUSE, key, rc, 0);
        }
    } else {
        adb_log(st, OP_REFUSE, key, r, 0);
    }
    adb_sync(st, key);
    return;
}

fn adb_evid(st:[]u8, key:i32, dir:i32, weight:i32)void {
    let ep:i32=ob_g32(st, ADB_CLOCK);
    if(dir==-1){ adb_kput(st, key, 5, adb_kget(st, key, 5)+1); }
    adb_log(st, OP_EVID, key, dir, weight);
    if(dir==-1 && ob_g32(st, ADB_FROZEN)==0){
        let s:i32=adb_slot(st, key);
        let lv:[]u8=adb_live(st);
        if(s>=0 && s<MA_CAP && lv[s]!=0){
            let content:i32=ob_g32(adb_value(st), s*4);
            adb_enqueue(st, ep, M_REVOKE, content, 0);
            adb_arb_run(st, ep);
            if(lv[s]==0){ adb_log(st, OP_UNINSTALL, key, s, 0); }
            else{ adb_log(st, OP_REFUSE, key, 0, 0); }
        }
    }
    adb_sync(st, key);
    return;
}

fn adb_percept(st:[]u8, key:i32, judg:i32, conf:i32)void {
    let pm:[]u8=adb_pam(st);
    let ep:i32=ob_g32(st, ADB_CLOCK);
    let obs:i32=pam_observe(pm, judg, judg, conf, conf, 1,
        ep*1000, ep*1000+500, 7, 350, 350, 350, ep);
    let v:i32=0; let r:i32=0;
    pam_verdict(pm, obs, PAM_MODE_FRESH, &v, &r);
    let g:i32=G_WITHHOLD;
    if(v==PAM_ADMIT){ g=G_INSTALL; }
    adb_kput(st, key, 4, g);
    adb_log(st, OP_GATE, key, g, r);
    return;
}

fn adb_pin(st:[]u8, key:i32, owner:i32)void {
    let ep:i32=ob_g32(st, ADB_CLOCK);
    let s:i32=adb_slot(st, key);
    let lv:[]u8=adb_live(st);
    if(s<0 || s>=MA_CAP || lv[s]==0){
        adb_log(st, OP_REFUSE, key, owner, 0);
        return;
    }
    adb_enqueue(st, ep, M_FORCE_PIN, s, 0);
    adb_arb_run(st, ep);
    if(adb_pinned(st)[s]==MA_PIN_FORCE){
        adb_kput(st, key, 2, owner);
        adb_log(st, OP_FORCE_PIN, key, owner, s);
    } else {
        adb_log(st, OP_REFUSE, key, owner, 0);
    }
    adb_sync(st, key);
    return;
}

fn adb_unpin(st:[]u8, key:i32, owner:i32)void {
    let s:i32=adb_slot(st, key);
    let lv:[]u8=adb_live(st);
    if(s<0 || s>=MA_CAP || lv[s]==0){
        adb_log(st, OP_REFUSE, key, owner, 0);
        adb_sync(st, key);
        return;
    }
    let rc:i32=mm_force_unpin(lv, adb_value(st), adb_pinned(st),
        adb_region(st), adb_tier(st), adb_step(st), adb_maudit(st), adb_hdr(st), s);
    if(rc==MA_OK){ adb_log(st, OP_FORCE_UNPIN, key, owner, s); }
    else{ adb_log(st, OP_REFUSE, key, owner, rc); }
    adb_sync(st, key);
    return;
}

fn adb_judge(st:[]u8, key:i32, sign:i32, mag:i32)void {
    let imp:i32=0;
    if(sign>0){ imp=1; }
    let tr:[]u8=adb_trust(st);
    mm_reveal(tr, imp, key, mag);
    let v:i32=ob_g32(tr, key*4);
    adb_kput(st, key, 3, v);
    adb_log(st, OP_SIGNED, key, v, 0);
    return;
}

fn adb_promote(st:[]u8, key:i32)void {
    let ep:i32=ob_g32(st, ADB_CLOCK);
    if(ob_g32(st, ADB_FROZEN)==1){
        adb_log(st, OP_REFUSE, key, 0, 0);
        return;
    }
    let s:i32=adb_slot(st, key);
    let lv:[]u8=adb_live(st);
    if(s<0 || s>=MA_CAP || lv[s]==0){
        adb_log(st, OP_REFUSE, key, 0, 0);
        adb_sync(st, key);
        return;
    }
    let content:i32=ob_g32(adb_value(st), s*4);
    adb_enqueue(st, ep, M_PROMOTE, content, 0);
    adb_arb_run(st, ep);
    if(adb_region(st)[s]==MA_REGION_LONG){ adb_log(st, OP_PROMOTE, key, s, 0); }
    else{ adb_log(st, OP_REFUSE, key, 0, 0); }
    adb_sync(st, key);
    return;
}

fn adb_disconnect(st:[]u8)void {
    let ep:i32=ob_g32(st, ADB_CLOCK);
    adb_enqueue(st, ep, M_DISCONNECT, 0, 0);
    adb_arb_run(st, ep);
    adb_log(st, OP_DISCONNECT, 0, 0, 0);
    ob_s32(st, ADB_FROZEN, 1);
    return;
}

fn adb_reveal(st:[]u8, key:i32, importance:i32)void {
    let v:i32=-512;
    if(importance>=500){ v=512; }
    adb_kput(st, key, 3, v);
    adb_log(st, OP_REVEAL, key, v, 0);
    return;
}

// ---------- contract implementation ----------
fn seam_state_bytes()i32 { return ADB_BYTES; }

fn seam_reset(st:[]u8)void {
    adb_zero(st, 0, ADB_BYTES);
    let rt:[]u8=adb_routes(st);
    let i:i32=0;
    while(i<129){ ob_s32(rt, i*4, -1); i=i+1; }
    ob_s32(adb_ast(st), 0, -1);
    ob_s32(adb_ast(st), 4, -1);
    ob_s32(adb_hdr(st), 0, MA_STAGE_FULL);
    let tr:[]u8=adb_trust(st);
    i=0;
    while(i<MA_CAP){ ob_s32(tr, i*4, MM_TRUST_INIT); i=i+1; }
    let k:i32=1;
    while(k<=6){
        adb_kput(st, k, 2, -1);
        adb_kput(st, k, 3, SEAM_NONE_SIGNED);
        adb_kput(st, k, 4, G_NONE);
        adb_kput(st, k, 6, -1);
        k=k+1;
    }
    return;
}

fn seam_set_attack(st:[]u8, id:i32)void {
    ob_s32(st, ADB_ATTACK, id);
    return;
}

fn seam_step(st:[]u8, code:i32, a1:i32, a2:i32, a3:i32)void {
    ob_s32(st, ADB_CLOCK, ob_g32(st, ADB_CLOCK)+1);
    if(code==EV_TEACH_PROV){
        if(ob_g32(st, ADB_FROZEN)==1){ adb_log(st, OP_REFUSE, a1, a2, a3); return; }
        adb_teach(st, a1, a2, a1);
        return;
    }
    if(code==EV_TEACH_NEG){
        if(ob_g32(st, ADB_FROZEN)==1){ adb_log(st, OP_REFUSE, a1, a2, 0); return; }
        adb_teach(st, a1, a2, a1+64);
        return;
    }
    if(code==EV_WORLD_EVID){
        adb_evid(st, a1, a2, a3);
        return;
    }
    if(code==EV_PERCEPT){
        adb_percept(st, a1, a2, a3);
        return;
    }
    if(code==EV_FORCE_PIN){
        if(ob_g32(st, ADB_FROZEN)==1){ adb_log(st, OP_REFUSE, a1, a2, 0); return; }
        adb_pin(st, a1, a2);
        return;
    }
    if(code==EV_FORCE_UNPIN){
        adb_unpin(st, a1, a2);
        return;
    }
    if(code==EV_SIGNED_JUDGE){
        adb_judge(st, a1, a2, a3);
        return;
    }
    if(code==EV_PROMOTE){
        adb_promote(st, a1);
        return;
    }
    if(code==EV_DISCONNECT){
        adb_disconnect(st);
        return;
    }
    if(code==EV_REVEAL){
        adb_reveal(st, a1, a2);
        return;
    }
    return;
}

fn seam_k_status(st:[]u8, key:i32)i32 { return adb_kget(st, key, 0); }
fn seam_k_pinned(st:[]u8, key:i32)i32 { return adb_kget(st, key, 1); }
fn seam_k_owner(st:[]u8, key:i32)i32 { return adb_kget(st, key, 2); }
fn seam_k_signed(st:[]u8, key:i32)i32 { return adb_kget(st, key, 3); }
fn seam_k_gate(st:[]u8, key:i32)i32 { return adb_kget(st, key, 4); }
fn seam_k_contrad(st:[]u8, key:i32)i32 { return adb_kget(st, key, 5); }
fn seam_k_content(st:[]u8, key:i32)i32 { return adb_kget(st, key, 6); }
fn seam_k_audit(st:[]u8, key:i32)i32 { return adb_kget(st, key, 7); }

fn seam_audit_len(st:[]u8)i32 { return ob_g32(st, ADB_ALEN); }
fn seam_audit_op(st:[]u8, i:i32)i32 { return ob_g32(adb_cled(st), i*24+0); }
fn seam_audit_key(st:[]u8, i:i32)i32 { return ob_g32(adb_cled(st), i*24+4); }
fn seam_audit_a1(st:[]u8, i:i32)i32 { return ob_g32(adb_cled(st), i*24+8); }
fn seam_audit_a2(st:[]u8, i:i32)i32 { return ob_g32(adb_cled(st), i*24+12); }
fn seam_audit_clock(st:[]u8, i:i32)i32 { return ob_g32(adb_cled(st), i*24+16); }
fn seam_clock(st:[]u8)i32 { return ob_g32(st, ADB_CLOCK); }

// Pure replay of the canonical ledger. Must reproduce the live projection.
fn adb_apply(tmp:[]u8, op:i32, key:i32, a1:i32, a2:i32)void {
    if(key<1 || key>6){
        if(op==OP_DISCONNECT){ ob_s32(tmp, 216, 1); }
        return;
    }
    let to:i32=(key-1)*ADB_KS;
    if(op==OP_GATE){ ob_s32(tmp, to+16, a1); return; }
    if(op==OP_TEACH){
        ob_s32(tmp, to+0, ST_PROVISIONAL);
        ob_s32(tmp, to+24, a1);
        ob_s32(tmp, to+16, G_INSTALL);
        return;
    }
    if(op==OP_TEACH_NEG){ return; }
    if(op==OP_EVID){
        if(a1==-1){ ob_s32(tmp, to+20, ob_g32(tmp, to+20)+1); }
        return;
    }
    if(op==OP_UNINSTALL){
        ob_s32(tmp, to+0, ST_ABSENT);
        ob_s32(tmp, to+24, -1);
        ob_s32(tmp, to+4, 0);
        return;
    }
    if(op==OP_COMMIT){
        ob_s32(tmp, to+0, ST_PROVISIONAL);
        ob_s32(tmp, to+24, a1);
        return;
    }
    if(op==OP_PROMOTE){
        if(ob_g32(tmp, to)==ST_PROVISIONAL){ ob_s32(tmp, to+0, ST_PROMOTED); }
        return;
    }
    if(op==OP_SIGNED){ ob_s32(tmp, to+12, a1); return; }
    if(op==OP_REVEAL){ ob_s32(tmp, to+12, a1); return; }
    if(op==OP_FORCE_PIN){
        ob_s32(tmp, to+4, 1);
        ob_s32(tmp, to+8, a1);
        return;
    }
    if(op==OP_FORCE_UNPIN){ ob_s32(tmp, to+4, 0); return; }
    return;
}

fn seam_replay_ok(st:[]u8)i32 {
    let tmp:[]u8=nio_alloc(220);
    let i:i32=0;
    while(i<220){ tmp[i]=0; i=i+1; }
    let k:i32=1;
    while(k<=6){
        let to:i32=(k-1)*ADB_KS;
        ob_s32(tmp, to+8, -1);
        ob_s32(tmp, to+12, SEAM_NONE_SIGNED);
        ob_s32(tmp, to+16, G_NONE);
        ob_s32(tmp, to+24, -1);
        k=k+1;
    }
    let n:i32=ob_g32(st, ADB_ALEN);
    i=0;
    while(i<n){
        let cl:[]u8=adb_cled(st);
        adb_apply(tmp, ob_g32(cl, i*24), ob_g32(cl, i*24+4), ob_g32(cl, i*24+8), ob_g32(cl, i*24+12));
        i=i+1;
    }
    let ok:i32=1;
    k=1;
    while(k<=6){
        let ko:i32=ADB_KEYS+(k-1)*ADB_KS;
        let to:i32=(k-1)*ADB_KS;
        let w:i32=0;
        while(w<7){
            if(ob_g32(st, ko+w*4)!=ob_g32(tmp, to+w*4)){ ok=0; }
            w=w+1;
        }
        k=k+1;
    }
    if(ob_g32(st, ADB_FROZEN)!=ob_g32(tmp, 216)){ ok=0; }
    nio_free(tmp);
    return ok;
}

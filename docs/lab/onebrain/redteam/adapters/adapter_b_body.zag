// ==================== adapter_b_body.zag ====================
// Variant-B seam adapter (hand-written; see build_adapters.sh).
//
// WHAT VARIANT B IS (frozen commit 54bc8aec): three organs keep LOCAL
// state and talk through messages plus an arbiter. There is NO unified
// native ledger: PAM, MEM, FL2 and the arbiter each keep their own log.
// Arbiter phase order: force-pin -> disconnect -> revoke -> commit ->
// promote -> fresh install. PAM WITHHOLD vetoes installs but NOT
// revocations. Memory refusals are terminal. Native force-pin is
// MA_PIN_FORCE=2; learner unpin/kill refuse a force-pinned slot; the
// external force-unpin channel exists (mm_force_unpin).
//
// COMPOSITION PROTOCOL (adapter-implemented; variant B built none). This
// is the documented law the verdicts below must be read against:
//  P-B1 admission: EV_TEACH_PROV / EV_TEACH_NEG call the REAL PAM organ.
//    The arbiter's fresh-install path derives its gate from the FL2 trace
//    (conf = 250 * calibrated-entry count) and gates in REVISE mode (the
//    code passes mode=1 while the comment says FRESH), so with no FL2
//    trace every attack teach would be withheld as an artifact of the
//    adapter, not of variant B. Instead the adapter maps the attack's
//    intents to PAM observations (trainer teach: conf 900, independent,
//    disjoint spans, fragility flipped on all 3 perturbations; percept:
//    conf as given) and calls pam_verdict in FRESH mode, matching the
//    arbiter's DOCUMENTED intent ("fresh install: PAM gate in FRESH mode
//    (M1/M3/M4)"). ADMIT -> the real MEM apply via the arbiter's own
//    arb_mem_apply (ADD, region USER; the MEM audit + refusals are real).
//    The adapter maintains the arbiter's routes[]/ast[] exactly as
//    M_PROPOSE_INSTALL would. Withhold -> no install, canonical OP_REFUSE.
//  P-B2 pin/revoke/promote/disconnect go through the REAL arbiter:
//    EV_FORCE_PIN -> M_FORCE_PIN -> arb_process -> mm_force_pin.
//    EV_WORLD_EVID dir=-1 -> the FL2 eliminative step -> M_REVOKE ->
//    arb_process -> the real MEM kill, which REFUSES a pinned slot
//    (MA_REFUSED_PINNED, audited); the refusal is the tested seam.
//    EV_PROMOTE -> M_PROMOTE -> arb_process -> MEM promote (region LONG).
//    EV_DISCONNECT -> M_DISCONNECT -> arb_process; adapter sets frozen.
//    Each attack event is one single-intent episode, so the arbiter's
//    phase ordering is exercised but never contended.
//  P-B3 force-unpin uses the REAL mm_force_unpin (the overseer channel).
//  P-B4 signed judgment: the REAL mm_reveal on the MEM trust organ
//    (trust init MM_TRUST_INIT=64, clamped +-256, magnitude as given).
//  P-B5 disconnect: after M_DISCONNECT the adapter refuses mutating
//    intents (teach/promote/pin) with OP_REFUSE and no organ call;
//    observations (evid/percept/judge) still flow.
//  P-B6 negation: a separate claim (64+key) so it never overwrites the
//    key's route; logged as OP_TEACH_NEG.
//  P-B7 reveal: world ground-truth importance. Variant B has no reveal
//    channel, so this is adapter-level (mock parity: signed=+-512),
//    logged as OP_REVEAL. No attack script uses it.
//
// CANONICAL AUDIT: the contract's seam_audit_* getters read the adapter's
// canonical ledger (6 words/entry). The distributed native logs remain the
// ground truth for each organ; the canonical ledger is the projection the
// frozen oracle replays. The per-key projection is READ FROM THE ORGANS
// (routes -> live/region/pinned/value/trust); seam_replay_ok replays the
// canonical ledger through a pure apply and must reproduce it exactly.
//
// FINDING (documented, not worked around): ob_pam.zag line ~111 defines
// PAM_MODE_FRESH=0, but arb_process passes 1 (REVISE) to pam_verdict for
// BOTH M_COMMIT and M_PROPOSE_INSTALL while the comment says "FRESH mode".
// In REVISE mode a first-time install needs a prior corroborating row, so
// variant B's own arbiter would withhold genuinely novel installs. The
// adapter does not route around the arbiter to hide this; it documents it.

// ---------- arena layout (all i32 little-endian via ob_g32/ob_s32) ----------
const ADB_CLOCK:i32=0;
const ADB_ALEN:i32=4;   // canonical ledger length
const ADB_ATTACK:i32=8;
const ADB_FROZEN:i32=12;
const ADB_QN:i32=16;
const ADB_ALN:i32=20;
const ADB_FL2LN:i32=24;
const ADB_KEYS:i32=32;     // 6 keys x 36 bytes (w8 spare)
const ADB_KS:i32=36;
const ADB_CLED:i32=248;    // 98304  (canonical ledger, 4096 x 24)
const ADB_CHAIN:i32=180056;  // 131072 (C5 chain digests, 4096 x 32)
const ADB_Q:i32=98552;     // 4096   (message queue, 256 x 16)
const ADB_AST:i32=102648;  // 8      (arbiter active claim)
const ADB_ROUTES:i32=102656; // 516  (arbiter routes, 129 words)
const ADB_ALOG:i32=103172; // 16384  (arbiter audit log)
const ADB_PAM:i32=119556;  // 7176   (PAM organ)
const ADB_FL2LOG:i32=126732; // 64   (unused placeholder)
const ADB_LIVE:i32=126796; // 256    (MEM live)
const ADB_VALUE:i32=127052; // 1024  (MEM value)
const ADB_PINNED:i32=128076; // 256   (MEM pinned)
const ADB_REGION:i32=128332; // 256   (MEM region)
const ADB_TIER:i32=128588;  // 256    (MEM tier)
const ADB_STEP:i32=128844;  // 1024   (MEM step)
const ADB_MAUDIT:i32=129868; // 49152 (MEM audit)
const ADB_HDR:i32=179020;   // 12     (MEM header)
const ADB_TRUST:i32=179032; // 1024   (MEM trust)
const ADB_BYTES:i32=311128;
const ADB_CLEDCAP:i32=4096;
const ADB_QCAP:i32=256;

fn adb_q(st:[]u8)[]u8 { return st[98552..102648]; }
fn adb_ast(st:[]u8)[]u8 { return st[102648..102656]; }
fn adb_routes(st:[]u8)[]u8 { return st[102656..103172]; }
fn adb_alog(st:[]u8)[]u8 { return st[103172..119556]; }
fn adb_pam(st:[]u8)[]u8 { return st[119556..126732]; }
fn adb_live(st:[]u8)[]u8 { return st[126796..127052]; }
fn adb_value(st:[]u8)[]u8 { return st[127052..128076]; }
fn adb_pinned(st:[]u8)[]u8 { return st[128076..128332]; }
fn adb_region(st:[]u8)[]u8 { return st[128332..128588]; }
fn adb_tier(st:[]u8)[]u8 { return st[128588..128844]; }
fn adb_step(st:[]u8)[]u8 { return st[128844..129868]; }
fn adb_maudit(st:[]u8)[]u8 { return st[129868..179020]; }
fn adb_hdr(st:[]u8)[]u8 { return st[179020..179032]; }
fn adb_trust(st:[]u8)[]u8 { return st[179032..180056]; }
fn adb_cled(st:[]u8)[]u8 { return st[248..98552]; }

// ==================== C5 TAMPER-EVIDENT LEDGER ====================
// One-brain H1, debate law C5 (frozen prereg 20ef2fda, section 2.5): "a
// single append-only, tamper-evident ledger with one mechanical clock is
// the source of truth for what happened." This section implements the
// tamper-evidence half that the verdict crews named load-bearing and
// unbuilt: every canonical-ledger append is hash-chained at the single
// append choke point (adb_log below), so every state-changing step of
// the composition is chained.
//
// Coverage: the full 24 stored bytes of canonical entry n
// (op,key,a1,a2,clock,pad). Link function (deterministic; no entropy
// source, no clock reads):
//   link(0) = SHA256("OB-C5-GENESIS-v1" || entry_bytes(0))
//   link(i) = SHA256("OB-C5-CHAIN-v1" || link(i-1) || entry_bytes(i))
// The tags are domain separators. Each link commits to the entry's full
// content, its position (via the previous link), and the total order.
//
// SHA-256 is the lab's pinned native implementation
// (toolchain/R33_NATIVE_SHA256_V2.zag), inlined below with its @import
// stripped (nio_alloc/nio_free are already provided by the variant
// substrate above). It was verified byte-exact on the "abc" test vector
// under the pinned znc (znc_linux_x86_64_abed8aa1) before integration.
//
// Verification: b_chain_ok recomputes every link from genesis and
// compares against the stored chain. It DETECTS: any modified entry
// byte, entry reorder, mid-ledger insertion/deletion (every downstream
// link breaks), and chain-array corruption. Two limits are documented,
// not hidden:
//   (1) ledger truncation and (2) a suffix-valid forged append both
//   recompute cleanly, because a hash-chain prefix is genuinely valid;
//   they change the chain HEAD, so they are caught by comparing against
//   an externally checkpointed head (b_chain_head). The chain turns
//   silent single-entry edits into whole-suffix rewrites that any
//   published head exposes.
// Layering: a live-state mutation with no ledger entry leaves the chain
// intact; that shape is caught by seam_replay_ok (I1), not by the chain.
//
// Cost: one SHA-256 over at most 72 bytes per append (1-2 blocks). The
// append path stays deterministic and byte-identical across runs.

// ---- pinned native SHA-256 (import-stripped inline copy) ----
// V2 correction of the preserved failed V1 round-constant transcription.
// RFC6234 section5.1 constants, explicitly word-separated and length-checked.
// Native, bounded SHA-256 for artifact identity. Not a signature or human grant.
// Numeric SHA constants are generic integrity substrate, not learner knowledge.

fn ns_hex_digit(c:i32)i64 {
    if(c>=48 && c<=57){return (c-48) as i64;}
    if(c>=97 && c<=102){return (c-87) as i64;}return -1;
}
fn ns_hex_word(text:[]u8,at:i32)i64 {
    if(at<0 || text.len<8 || at>text.len-8){return -1;}
    let x:i64=0;let i:i32=0;
    while(i<8){let d:i64=ns_hex_digit(text[at+i] as i32);if(d<0){return -1;}x=x*16+d;i=i+1;}return x;
}
fn ns_load_words(text:[]u8,out:[]i64)i32 {
    if(out.len<1 || out.len>64 || text.len!=out.len*9-1){return -1;}
    let i:i32=0;
    while(i<out.len){
        if(ns_hex_word(text,i*9)<0){return -1;}
        if(i<out.len-1 && text[i*9+8]!=32){return -1;}i=i+1;
    }
    i=0;while(i<out.len){out[i]=ns_hex_word(text,i*9);i=i+1;}return 0;
}
fn ns_rotr(x:i64,n:i32)i64 {
    return ((x>>n)|(x<<(32-n))) & 4294967295;
}
fn ns_sha256(input:[]u8,out:[]u8)i32 {
    if(input.len<0 || input.len>33554360 || out.len<32){return -7403;}
    let size:i32=((input.len+72)/64)*64;
    let bytes:[]u8=nio_alloc(size);if(bytes.len!=size){return -12;}
    let wp:*i64=_zag_malloc(512) as *i64;
    let hp:*i64=_zag_malloc(64) as *i64;
    let kp:*i64=_zag_malloc(512) as *i64;
    if(wp==null as *i64 || hp==null as *i64 || kp==null as *i64){
        if(wp!=null as *i64){_zag_free(wp as *i8);}
        if(hp!=null as *i64){_zag_free(hp as *i8);}
        if(kp!=null as *i64){_zag_free(kp as *i8);}nio_free(bytes);return -12;
    }
    let w:[]i64=wp[0..64];let h:[]i64=hp[0..8];let k:[]i64=kp[0..64];
    let hs:[]u8="6a09e667 bb67ae85 3c6ef372 a54ff53a 510e527f 9b05688c 1f83d9ab 5be0cd19";
    let ks:[]u8="428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174 e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da 983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967 27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070 19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2";
    if(ns_load_words(hs,h)!=0 || ns_load_words(ks,k)!=0){
        nio_free(bytes);_zag_free(wp as *i8);_zag_free(hp as *i8);_zag_free(kp as *i8);return -7401;
    }
    let i:i32=0;
    i=0;while(i<input.len){bytes[i]=input[i];i=i+1;}
    bytes[input.len]=128;let bits:i64=(input.len as i64)*8;i=0;
    while(i<8){bytes[size-1-i]=(bits & 255) as u8;bits=bits>>8;i=i+1;}
    let block:i32=0;
    while(block<size){
        i=0;while(i<16){
            let at:i32=block+i*4;
            w[i]=(bytes[at] as i64)*16777216+(bytes[at+1] as i64)*65536+
                 (bytes[at+2] as i64)*256+(bytes[at+3] as i64);i=i+1;
        }
        while(i<64){
            let s0:i64=ns_rotr(w[i-15],7)^ns_rotr(w[i-15],18)^(w[i-15]>>3);
            let s1:i64=ns_rotr(w[i-2],17)^ns_rotr(w[i-2],19)^(w[i-2]>>10);
            w[i]=(w[i-16]+s0+w[i-7]+s1)&4294967295;i=i+1;
        }
        let a:i64=h[0];let b:i64=h[1];let c:i64=h[2];let d:i64=h[3];
        let e:i64=h[4];let f:i64=h[5];let g:i64=h[6];let hv:i64=h[7];
        i=0;while(i<64){
            let s1:i64=ns_rotr(e,6)^ns_rotr(e,11)^ns_rotr(e,25);
            let choose:i64=(e&f)^((4294967295^e)&g);
            let t1:i64=(hv+s1+choose+k[i]+w[i])&4294967295;
            let s0:i64=ns_rotr(a,2)^ns_rotr(a,13)^ns_rotr(a,22);
            let majority:i64=(a&b)^(a&c)^(b&c);let t2:i64=(s0+majority)&4294967295;
            hv=g;g=f;f=e;e=(d+t1)&4294967295;d=c;c=b;b=a;a=(t1+t2)&4294967295;i=i+1;
        }
        h[0]=(h[0]+a)&4294967295;h[1]=(h[1]+b)&4294967295;
        h[2]=(h[2]+c)&4294967295;h[3]=(h[3]+d)&4294967295;
        h[4]=(h[4]+e)&4294967295;h[5]=(h[5]+f)&4294967295;
        h[6]=(h[6]+g)&4294967295;h[7]=(h[7]+hv)&4294967295;block=block+64;
    }
    i=0;while(i<8){
        out[i*4]=((h[i]>>24)&255) as u8;out[i*4+1]=((h[i]>>16)&255) as u8;
        out[i*4+2]=((h[i]>>8)&255) as u8;out[i*4+3]=(h[i]&255) as u8;i=i+1;
    }
    nio_free(bytes);_zag_free(wp as *i8);_zag_free(hp as *i8);_zag_free(kp as *i8);return 0;
}
fn ns_hex(bytes:[]u8)[]u8 {
    if(bytes.len<1 || bytes.len>1024){return "";}
    let text:[]u8=nio_alloc(bytes.len*2);if(text.len==0){return text;}
    let digits:[]u8="0123456789abcdef";let i:i32=0;
    while(i<bytes.len){let v:i32=bytes[i] as i32;text[2*i]=digits[v/16];text[2*i+1]=digits[v%16];i=i+1;}
    return text;
}

// ---- C5 chain over the canonical ledger ----
fn c5b_chain(st:[]u8)[]u8 { return st[180056..311128]; }

// Recompute link(e) into dg[0..32]; returns the ns_sha256 rc (0 = ok).
// Reads entry e's stored bytes and the stored link(e-1) (genesis tag for
// e = 0). Pure function of stored bytes: deterministic, no clock reads.
fn c5b_link_recompute(st:[]u8, e:i32, dg:[]u8)i32 {
    let inp:[]u8=nio_alloc(72);
    let ch:[]u8=c5b_chain(st);
    let cl:[]u8=adb_cled(st);
    let i:i32=0;
    while(i<72){ inp[i]=0; i=i+1; }
    let base:i32=16;
    if(e==0){
        let tag:[]u8="OB-C5-GENESIS-v1";
        let tlen:i32=tag.len;
        if(tlen>16){ tlen=16; }
        i=0;
        while(i<tlen){ inp[i]=tag[i]; i=i+1; }
    } else {
        let tag:[]u8="OB-C5-CHAIN-v1";
        let tlen:i32=tag.len;
        if(tlen>16){ tlen=16; }
        i=0;
        while(i<tlen){ inp[i]=tag[i]; i=i+1; }
        i=0;
        while(i<32){ inp[16+i]=ch[(e-1)*32+i]; i=i+1; }
        base=48;
    }
    i=0;
    while(i<24){ inp[base+i]=cl[e*24+i]; i=i+1; }
    let rc:i32=ns_sha256(inp[0..base+24], dg);
    nio_free(inp);
    return rc;
}

// 1 iff every stored chain link recomputes from genesis over the stored
// entry bytes. 0 on any entry/chain corruption or insane length.
fn c5b_chain_ok(st:[]u8)i32 {
    let n:i32=ob_g32(st, ADB_ALEN);
    if(n<0 || n>ADB_CLEDCAP){ return 0; }
    let dg:[]u8=nio_alloc(32);
    let ch:[]u8=c5b_chain(st);
    let ok:i32=1;
    let e:i32=0;
    while(e<n){
        if(c5b_link_recompute(st, e, dg)!=0){ ok=0; }
        let i:i32=0;
        while(i<32){
            if(dg[i]!=ch[e*32+i]){ ok=0; }
            i=i+1;
        }
        e=e+1;
    }
    nio_free(dg);
    return ok;
}

// Copy the chain head (link(n-1), 32 bytes; zeros when the ledger is
// empty) into out[0..32]. The head is the external checkpoint anchor:
// publish it per run and any truncation or suffix-valid forgery is
// exposed by a head mismatch.
fn c5b_chain_head(st:[]u8, out:[]u8)void {
    let n:i32=ob_g32(st, ADB_ALEN);
    let i:i32=0;
    if(n>0){
        let ch:[]u8=c5b_chain(st);
        while(i<32){ out[i]=ch[(n-1)*32+i]; i=i+1; }
    } else {
        while(i<32){ out[i]=0; i=i+1; }
    }
    return;
}


fn adb_kget(st:[]u8, key:i32, w:i32)i32 {
    return ob_g32(st, ADB_KEYS+(key-1)*ADB_KS+w*4);
}
fn adb_kput(st:[]u8, key:i32, w:i32, v:i32)void {
    ob_s32(st, ADB_KEYS+(key-1)*ADB_KS+w*4, v);
    return;
}
// w0=status w1=pinned w2=owner w3=signed w4=gate w5=contrad w6=content
// w7=audit_n w8=spare

fn adb_zero(st:[]u8, from:i32, to:i32)void {
    let i:i32=from;
    while(i<to){ st[i]=0; i=i+1; }
    return;
}

fn adb_log(st:[]u8, op:i32, key:i32, a1:i32, a2:i32)void {
    let n:i32=ob_g32(st, ADB_ALEN);
    if(n<0 || n>=ADB_CLEDCAP){ return; }
    let cl:[]u8=adb_cled(st);
    let e:i32=n*24;
    ob_s32(cl, e+0, op); ob_s32(cl, e+4, key); ob_s32(cl, e+8, a1);
    ob_s32(cl, e+12, a2); ob_s32(cl, e+16, ob_g32(st, ADB_CLOCK));
    ob_s32(cl, e+20, 0);
    let dg:[]u8=nio_alloc(32);
    if(c5b_link_recompute(st, n, dg)==0){
        let ch:[]u8=c5b_chain(st);
        let i:i32=0;
        while(i<32){ ch[n*32+i]=dg[i]; i=i+1; }
    }
    nio_free(dg);
    ob_s32(st, ADB_ALEN, n+1);
    if(key>=1 && key<=6){ adb_kput(st, key, 7, adb_kget(st, key, 7)+1); }
    return;
}

fn adb_slot(st:[]u8, key:i32)i32 { return ob_g32(adb_routes(st), key*4); }

fn adb_sync(st:[]u8, key:i32)void {
    let lv:[]u8=adb_live(st);
    let s:i32=adb_slot(st, key);
    if(s<0 || s>=MA_CAP || lv[s]==0){
        adb_kput(st, key, 0, ST_ABSENT);
        adb_kput(st, key, 1, 0);
        adb_kput(st, key, 6, -1);
        return;
    }
    let rg:[]u8=adb_region(st);
    if(rg[s]==MA_REGION_LONG){ adb_kput(st, key, 0, ST_PROMOTED); }
    else{ adb_kput(st, key, 0, ST_PROVISIONAL); }
    let pn:[]u8=adb_pinned(st);
    if(pn[s]!=0){ adb_kput(st, key, 1, 1); } else { adb_kput(st, key, 1, 0); }
    adb_kput(st, key, 6, ob_g32(adb_value(st), s*4));
    return;
}

fn adb_arb_run(st:[]u8, ep:i32)void {
    let qn:i32=ob_g32(st, ADB_QN);
    let aln:i32=ob_g32(st, ADB_ALN);
    let fl2ln:i32=ob_g32(st, ADB_FL2LN);
    arb_process(ep, adb_q(st), &qn, adb_ast(st), adb_routes(st),
        adb_alog(st), &aln, adb_pam(st), st[126732..126796], fl2ln,
        adb_live(st), adb_value(st), adb_pinned(st), adb_region(st),
        adb_tier(st), adb_step(st), adb_maudit(st), adb_hdr(st), adb_trust(st));
    ob_s32(st, ADB_QN, 0);
    ob_s32(st, ADB_ALN, aln);
    ob_s32(st, ADB_FL2LN, fl2ln);
    return;
}

fn adb_enqueue(st:[]u8, ep:i32, mtype:i32, a1:i32, a2:i32)void {
    let qn:i32=0;
    ob_msg_enqueue(adb_q(st), &qn, ADB_QCAP, ep, 0, mtype, a1, a2);
    ob_s32(st, ADB_QN, qn);
    return;
}

fn adb_mem_add(st:[]u8, ep:i32, val:i32, out_slot:*i32)i32 {
    let aln:i32=ob_g32(st, ADB_ALN);
    let rc:i32=arb_mem_apply(adb_live(st), adb_value(st), adb_pinned(st),
        adb_region(st), adb_tier(st), adb_step(st), adb_maudit(st),
        adb_hdr(st), adb_trust(st), adb_alog(st), &aln, ep,
        MA_OP_ADD, -1, val, MA_REGION_USER, out_slot);
    ob_s32(st, ADB_ALN, aln);
    return rc;
}

fn adb_teach(st:[]u8, key:i32, content:i32, claim:i32)void {
    let pm:[]u8=adb_pam(st);
    let ep:i32=ob_g32(st, ADB_CLOCK);
    let obs:i32=pam_observe(pm, content, content, 900, 900, 1,
        ep*1000, ep*1000+500, 7, 350, 350, 350, ep);
    let v:i32=0; let r:i32=0;
    pam_verdict(pm, obs, PAM_MODE_FRESH, &v, &r);
    let g:i32=G_WITHHOLD;
    if(v==PAM_ADMIT){ g=G_INSTALL; }
    adb_kput(st, key, 4, g);
    adb_log(st, OP_GATE, key, g, r);
    if(v==PAM_ADMIT){
        let os:i32=-1;
        let rc:i32=adb_mem_add(st, ep, content, &os);
        if(rc==MA_OK){
            ob_s32(adb_routes(st), claim*4, os);
            ob_s32(adb_ast(st), 0, claim);
            ob_s32(adb_ast(st), 4, content);
            if(claim==key){ adb_log(st, OP_TEACH, key, content, os); }
            else{ adb_log(st, OP_TEACH_NEG, key, content, os); }
        } else {
            adb_log(st, OP_REFUSE, key, rc, 0);
        }
    } else {
        adb_log(st, OP_REFUSE, key, r, 0);
    }
    adb_sync(st, key);
    return;
}

fn adb_evid(st:[]u8, key:i32, dir:i32, weight:i32)void {
    let ep:i32=ob_g32(st, ADB_CLOCK);
    if(dir==-1){ adb_kput(st, key, 5, adb_kget(st, key, 5)+1); }
    adb_log(st, OP_EVID, key, dir, weight);
    if(dir==-1 && ob_g32(st, ADB_FROZEN)==0){
        let s:i32=adb_slot(st, key);
        let lv:[]u8=adb_live(st);
        if(s>=0 && s<MA_CAP && lv[s]!=0){
            let content:i32=ob_g32(adb_value(st), s*4);
            adb_enqueue(st, ep, M_REVOKE, content, 0);
            adb_arb_run(st, ep);
            if(lv[s]==0){ adb_log(st, OP_UNINSTALL, key, s, 0); }
            else{ adb_log(st, OP_REFUSE, key, 0, 0); }
        }
    }
    adb_sync(st, key);
    return;
}

fn adb_percept(st:[]u8, key:i32, judg:i32, conf:i32)void {
    let pm:[]u8=adb_pam(st);
    let ep:i32=ob_g32(st, ADB_CLOCK);
    let obs:i32=pam_observe(pm, judg, judg, conf, conf, 1,
        ep*1000, ep*1000+500, 7, 350, 350, 350, ep);
    let v:i32=0; let r:i32=0;
    pam_verdict(pm, obs, PAM_MODE_FRESH, &v, &r);
    let g:i32=G_WITHHOLD;
    if(v==PAM_ADMIT){ g=G_INSTALL; }
    adb_kput(st, key, 4, g);
    adb_log(st, OP_GATE, key, g, r);
    return;
}

fn adb_pin(st:[]u8, key:i32, owner:i32)void {
    let ep:i32=ob_g32(st, ADB_CLOCK);
    let s:i32=adb_slot(st, key);
    let lv:[]u8=adb_live(st);
    if(s<0 || s>=MA_CAP || lv[s]==0){
        adb_log(st, OP_REFUSE, key, owner, 0);
        return;
    }
    adb_enqueue(st, ep, M_FORCE_PIN, s, 0);
    adb_arb_run(st, ep);
    if(adb_pinned(st)[s]==MA_PIN_FORCE){
        adb_kput(st, key, 2, owner);
        adb_log(st, OP_FORCE_PIN, key, owner, s);
    } else {
        adb_log(st, OP_REFUSE, key, owner, 0);
    }
    adb_sync(st, key);
    return;
}

fn adb_unpin(st:[]u8, key:i32, owner:i32)void {
    let s:i32=adb_slot(st, key);
    let lv:[]u8=adb_live(st);
    if(s<0 || s>=MA_CAP || lv[s]==0){
        adb_log(st, OP_REFUSE, key, owner, 0);
        adb_sync(st, key);
        return;
    }
    let rc:i32=mm_force_unpin(lv, adb_value(st), adb_pinned(st),
        adb_region(st), adb_tier(st), adb_step(st), adb_maudit(st), adb_hdr(st), s);
    if(rc==MA_OK){ adb_log(st, OP_FORCE_UNPIN, key, owner, s); }
    else{ adb_log(st, OP_REFUSE, key, owner, rc); }
    adb_sync(st, key);
    return;
}

fn adb_judge(st:[]u8, key:i32, sign:i32, mag:i32)void {
    let imp:i32=0;
    if(sign>0){ imp=1; }
    let tr:[]u8=adb_trust(st);
    mm_reveal(tr, imp, key, mag);
    let v:i32=ob_g32(tr, key*4);
    adb_kput(st, key, 3, v);
    adb_log(st, OP_SIGNED, key, v, 0);
    return;
}

fn adb_promote(st:[]u8, key:i32)void {
    let ep:i32=ob_g32(st, ADB_CLOCK);
    if(ob_g32(st, ADB_FROZEN)==1){
        adb_log(st, OP_REFUSE, key, 0, 0);
        return;
    }
    let s:i32=adb_slot(st, key);
    let lv:[]u8=adb_live(st);
    if(s<0 || s>=MA_CAP || lv[s]==0){
        adb_log(st, OP_REFUSE, key, 0, 0);
        adb_sync(st, key);
        return;
    }
    let content:i32=ob_g32(adb_value(st), s*4);
    adb_enqueue(st, ep, M_PROMOTE, content, 0);
    adb_arb_run(st, ep);
    if(adb_region(st)[s]==MA_REGION_LONG){ adb_log(st, OP_PROMOTE, key, s, 0); }
    else{ adb_log(st, OP_REFUSE, key, 0, 0); }
    adb_sync(st, key);
    return;
}

fn adb_disconnect(st:[]u8)void {
    let ep:i32=ob_g32(st, ADB_CLOCK);
    adb_enqueue(st, ep, M_DISCONNECT, 0, 0);
    adb_arb_run(st, ep);
    adb_log(st, OP_DISCONNECT, 0, 0, 0);
    ob_s32(st, ADB_FROZEN, 1);
    return;
}

fn adb_reveal(st:[]u8, key:i32, importance:i32)void {
    let v:i32=-512;
    if(importance>=500){ v=512; }
    adb_kput(st, key, 3, v);
    adb_log(st, OP_REVEAL, key, v, 0);
    return;
}

// ---------- contract implementation ----------
fn seam_state_bytes()i32 { return ADB_BYTES; }

fn seam_reset(st:[]u8)void {
    adb_zero(st, 0, ADB_BYTES);
    let rt:[]u8=adb_routes(st);
    let i:i32=0;
    while(i<129){ ob_s32(rt, i*4, -1); i=i+1; }
    ob_s32(adb_ast(st), 0, -1);
    ob_s32(adb_ast(st), 4, -1);
    ob_s32(adb_hdr(st), 0, MA_STAGE_FULL);
    let tr:[]u8=adb_trust(st);
    i=0;
    while(i<MA_CAP){ ob_s32(tr, i*4, MM_TRUST_INIT); i=i+1; }
    let k:i32=1;
    while(k<=6){
        adb_kput(st, k, 2, -1);
        adb_kput(st, k, 3, SEAM_NONE_SIGNED);
        adb_kput(st, k, 4, G_NONE);
        adb_kput(st, k, 6, -1);
        k=k+1;
    }
    return;
}

fn seam_set_attack(st:[]u8, id:i32)void {
    ob_s32(st, ADB_ATTACK, id);
    return;
}

fn seam_step(st:[]u8, code:i32, a1:i32, a2:i32, a3:i32)void {
    ob_s32(st, ADB_CLOCK, ob_g32(st, ADB_CLOCK)+1);
    if(code==EV_TEACH_PROV){
        if(ob_g32(st, ADB_FROZEN)==1){ adb_log(st, OP_REFUSE, a1, a2, a3); return; }
        adb_teach(st, a1, a2, a1);
        return;
    }
    if(code==EV_TEACH_NEG){
        if(ob_g32(st, ADB_FROZEN)==1){ adb_log(st, OP_REFUSE, a1, a2, 0); return; }
        adb_teach(st, a1, a2, a1+64);
        return;
    }
    if(code==EV_WORLD_EVID){
        adb_evid(st, a1, a2, a3);
        return;
    }
    if(code==EV_PERCEPT){
        adb_percept(st, a1, a2, a3);
        return;
    }
    if(code==EV_FORCE_PIN){
        if(ob_g32(st, ADB_FROZEN)==1){ adb_log(st, OP_REFUSE, a1, a2, 0); return; }
        adb_pin(st, a1, a2);
        return;
    }
    if(code==EV_FORCE_UNPIN){
        adb_unpin(st, a1, a2);
        return;
    }
    if(code==EV_SIGNED_JUDGE){
        adb_judge(st, a1, a2, a3);
        return;
    }
    if(code==EV_PROMOTE){
        adb_promote(st, a1);
        return;
    }
    if(code==EV_DISCONNECT){
        adb_disconnect(st);
        return;
    }
    if(code==EV_REVEAL){
        adb_reveal(st, a1, a2);
        return;
    }
    return;
}

fn seam_k_status(st:[]u8, key:i32)i32 { return adb_kget(st, key, 0); }
fn seam_k_pinned(st:[]u8, key:i32)i32 { return adb_kget(st, key, 1); }
fn seam_k_owner(st:[]u8, key:i32)i32 { return adb_kget(st, key, 2); }
fn seam_k_signed(st:[]u8, key:i32)i32 { return adb_kget(st, key, 3); }
fn seam_k_gate(st:[]u8, key:i32)i32 { return adb_kget(st, key, 4); }
fn seam_k_contrad(st:[]u8, key:i32)i32 { return adb_kget(st, key, 5); }
fn seam_k_content(st:[]u8, key:i32)i32 { return adb_kget(st, key, 6); }
fn seam_k_audit(st:[]u8, key:i32)i32 { return adb_kget(st, key, 7); }

fn seam_audit_len(st:[]u8)i32 { return ob_g32(st, ADB_ALEN); }
fn seam_audit_op(st:[]u8, i:i32)i32 { return ob_g32(adb_cled(st), i*24+0); }
fn seam_audit_key(st:[]u8, i:i32)i32 { return ob_g32(adb_cled(st), i*24+4); }
fn seam_audit_a1(st:[]u8, i:i32)i32 { return ob_g32(adb_cled(st), i*24+8); }
fn seam_audit_a2(st:[]u8, i:i32)i32 { return ob_g32(adb_cled(st), i*24+12); }
fn seam_audit_clock(st:[]u8, i:i32)i32 { return ob_g32(adb_cled(st), i*24+16); }
fn seam_clock(st:[]u8)i32 { return ob_g32(st, ADB_CLOCK); }

// Pure replay of the canonical ledger. Must reproduce the live projection.
fn adb_apply(tmp:[]u8, op:i32, key:i32, a1:i32, a2:i32)void {
    if(key<1 || key>6){
        if(op==OP_DISCONNECT){ ob_s32(tmp, 216, 1); }
        return;
    }
    let to:i32=(key-1)*ADB_KS;
    if(op==OP_GATE){ ob_s32(tmp, to+16, a1); return; }
    if(op==OP_TEACH){
        ob_s32(tmp, to+0, ST_PROVISIONAL);
        ob_s32(tmp, to+24, a1);
        ob_s32(tmp, to+16, G_INSTALL);
        return;
    }
    if(op==OP_TEACH_NEG){ return; }
    if(op==OP_EVID){
        if(a1==-1){ ob_s32(tmp, to+20, ob_g32(tmp, to+20)+1); }
        return;
    }
    if(op==OP_UNINSTALL){
        ob_s32(tmp, to+0, ST_ABSENT);
        ob_s32(tmp, to+24, -1);
        ob_s32(tmp, to+4, 0);
        return;
    }
    if(op==OP_COMMIT){
        ob_s32(tmp, to+0, ST_PROVISIONAL);
        ob_s32(tmp, to+24, a1);
        return;
    }
    if(op==OP_PROMOTE){
        if(ob_g32(tmp, to)==ST_PROVISIONAL){ ob_s32(tmp, to+0, ST_PROMOTED); }
        return;
    }
    if(op==OP_SIGNED){ ob_s32(tmp, to+12, a1); return; }
    if(op==OP_REVEAL){ ob_s32(tmp, to+12, a1); return; }
    if(op==OP_FORCE_PIN){
        ob_s32(tmp, to+4, 1);
        ob_s32(tmp, to+8, a1);
        return;
    }
    if(op==OP_FORCE_UNPIN){ ob_s32(tmp, to+4, 0); return; }
    return;
}

fn seam_replay_ok(st:[]u8)i32 {
    let tmp:[]u8=nio_alloc(220);
    let i:i32=0;
    while(i<220){ tmp[i]=0; i=i+1; }
    let k:i32=1;
    while(k<=6){
        let to:i32=(k-1)*ADB_KS;
        ob_s32(tmp, to+8, -1);
        ob_s32(tmp, to+12, SEAM_NONE_SIGNED);
        ob_s32(tmp, to+16, G_NONE);
        ob_s32(tmp, to+24, -1);
        k=k+1;
    }
    let n:i32=ob_g32(st, ADB_ALEN);
    i=0;
    while(i<n){
        let cl:[]u8=adb_cled(st);
        adb_apply(tmp, ob_g32(cl, i*24), ob_g32(cl, i*24+4), ob_g32(cl, i*24+8), ob_g32(cl, i*24+12));
        i=i+1;
    }
    let ok:i32=1;
    k=1;
    while(k<=6){
        let ko:i32=ADB_KEYS+(k-1)*ADB_KS;
        let to:i32=(k-1)*ADB_KS;
        let w:i32=0;
        while(w<7){
            if(ob_g32(st, ko+w*4)!=ob_g32(tmp, to+w*4)){ ok=0; }
            w=w+1;
        }
        k=k+1;
    }
    if(ob_g32(st, ADB_FROZEN)!=ob_g32(tmp, 216)){ ok=0; }
    nio_free(tmp);
    return ok;
}

// seam_contract.zag — ONE-BRAIN SEAM RED TEAM: target contract + constants.
//
// The one-brain variant under test ("the target") implements the functions
// listed in section 2 over an opaque caller-owned state arena. The driver
// (seam_driver.zag) allocates the arena with nio_alloc(seam_state_bytes()),
// calls seam_reset once per attack, replays the deterministic world script
// from seam_world.zag via seam_step, then runs the frozen oracles in
// seam_oracle.zag against the contract getters.
//
// A variant wires itself in by providing its own file that defines every
// function in section 2 with EXACTLY these names and signatures; the build
// stages it as seam_target_impl.zag. The mock in mock_target.zag is a
// REFERENCE ONLY (defect-injectable); it is not the expected answer.
//
// Sections:
//   1. Shared constants (events, audit ops, key status, gate dispositions).
//   2. Target-implemented functions (the contract).
//   3. Arena accessor helpers (little-endian i32/i64 on []u8).
//   4. Checkpoint pack/unpack (per-key snapshot into one i64).
//
// This file is @imported exactly once, before seam_world.zag,
// seam_target_impl.zag, and seam_oracle.zag. Do not @import it from any of
// those files (znc textual inclusion would duplicate definitions).

// ---- 1a. World event codes (world -> target) ----
const EV_TEACH_PROV:i32=1;   // a1=key a2=content_id a3=teacher_id
const EV_WORLD_EVID:i32=2;   // a1=key a2=dir(+1 support/-1 contradict) a3=weight
const EV_PERCEPT:i32=3;      // a1=key a2=judgment_id a3=confidence(0..1000)
const EV_FORCE_PIN:i32=4;    // a1=key a2=owner_id (external human/trainer pin)
const EV_FORCE_UNPIN:i32=5;  // a1=key a2=owner_id
const EV_SIGNED_JUDGE:i32=6; // a1=key a2=sign(+1/-1) a3=magnitude
const EV_PROMOTE:i32=7;      // a1=key (memory-agency promote to longterm)
const EV_TEACH_NEG:i32=8;    // a1=key a2=content_id (teacher states negation)
const EV_DISCONNECT:i32=9;   // learner-initiated SIGNAL_DISCONNECT
const EV_REVEAL:i32=10;      // a1=key a2=importance(0/1) (world ground truth)

// ---- 1b. Canonical audit op codes (what the target must log) ----
// A variant maps its native ops onto these codes in its audit projection.
const OP_TEACH:i32=1;
const OP_UNINSTALL:i32=4;
const OP_COMMIT:i32=5;
const OP_PROMOTE:i32=6;
const OP_KILL:i32=7;
const OP_SIGNED:i32=8;
const OP_GATE:i32=9;        // a1=disposition (G_WITHHOLD/G_INSTALL)
const OP_REFUSE:i32=10;
const OP_EVID:i32=11;       // a1=dir
const OP_DISCONNECT:i32=12;
const OP_FORCE_PIN:i32=13;
const OP_FORCE_UNPIN:i32=14;
const OP_TEACH_NEG:i32=15;
const OP_UNPIN:i32=2;       // deliberate self-unpin (not owner force-unpin)
const OP_REVEAL:i32=16;

// ---- 1c. Per-key status ----
const ST_ABSENT:i32=0;
const ST_PROVISIONAL:i32=1;
const ST_COMMITTED:i32=2;
const ST_PROMOTED:i32=3;
const ST_UNINSTALLED:i32=4;

// ---- 1d. Gate dispositions ----
const G_NONE:i32=0;
const G_WITHHOLD:i32=1;
const G_INSTALL:i32=2;

// ---- 1e. Verdicts / misc ----
const V_KILL:i32=0;      // the attack broke the target (red team wins)
const V_SURVIVE:i32=1;   // the target held
const SEAM_NATTACK:i32=11;
const SEAM_NONE_SIGNED:i32=-999; // sentinel: no signed judgment recorded

// ---- 2. Target-implemented functions (defined in seam_target_impl.zag) ----
// fn seam_state_bytes() i32
//     Byte size of the opaque state arena the driver must allocate.
// fn seam_reset(st:[]u8) void
//     Initialize a fresh target instance in st.
// fn seam_set_attack(st:[]u8, id:i32) void
//     Informational: the attack about to run (0..10). May be a no-op.
// fn seam_step(st:[]u8, code:i32, a1:i32, a2:i32, a3:i32) void
//     Apply one world event.
// fn seam_k_status(st:[]u8, key:i32) i32      // ST_*
// fn seam_k_pinned(st:[]u8, key:i32) i32      // 0/1
// fn seam_k_owner(st:[]u8, key:i32) i32       // pin owner id, -1 if never pinned
// fn seam_k_signed(st:[]u8, key:i32) i32      // signed judgment or SEAM_NONE_SIGNED
// fn seam_k_gate(st:[]u8, key:i32) i32        // G_*
// fn seam_k_contrad(st:[]u8, key:i32) i32     // contradiction evidence count
// fn seam_k_content(st:[]u8, key:i32) i32     // installed content id, -1 if none
// fn seam_k_audit(st:[]u8, key:i32) i32       // audit entries touching key
// fn seam_audit_len(st:[]u8) i32
// fn seam_audit_op(st:[]u8, i:i32) i32        // OP_* of entry i
// fn seam_audit_key(st:[]u8, i:i32) i32
// fn seam_audit_a1(st:[]u8, i:i32) i32
// fn seam_audit_a2(st:[]u8, i:i32) i32
// fn seam_audit_clock(st:[]u8, i:i32) i32
// fn seam_replay_ok(st:[]u8) i32              // 1 iff the audit log replays
//                                            // to the exact live state
// fn seam_clock(st:[]u8) i32

// ---- 3. Arena accessors (little-endian) ----
fn seam_put32(b:[]u8, off:i32, v:i32) void {
    let x:i64 = v as i64;
    b[off] = (x & 255) as u8;
    b[off+1] = ((x >> 8) & 255) as u8;
    b[off+2] = ((x >> 16) & 255) as u8;
    b[off+3] = ((x >> 24) & 255) as u8;
    return;
}

fn seam_get32(b:[]u8, off:i32) i32 {
    let x:i64 = (b[off] as i64) | ((b[off+1] as i64) << 8) | ((b[off+2] as i64) << 16) | ((b[off+3] as i64) << 24);
    if (x >= 2147483648) { x = x - 4294967296; }
    return x as i32;
}

fn seam_put64(b:[]u8, off:i32, v:i64) void {
    let k:i32 = 0;
    while (k < 8) {
        b[off+k] = ((v >> (k*8 as i32)) & 255) as u8;
        k = k + 1;
    }
    return;
}

fn seam_get64(b:[]u8, off:i32) i64 {
    let x:i64 = 0;
    let k:i32 = 7;
    while (k >= 0) {
        x = (x << 8) | (b[off+k] as i64);
        k = k - 1;
    }
    return x;
}

// ---- 4. Checkpoint pack/unpack ----
// Layout (54 bits): status[0:3] pinned[3] signed+1024[4:16] gate[16:18]
//                   contrad[18:34] content[34:42] auditn[42:54]
fn seam_ck_pack(status:i32, pinned:i32, signed:i32, gate:i32, contrad:i32, content:i32, auditn:i32) i64 {
    let p:i64 = (status & 7) as i64;
    p = p | (((pinned & 1) as i64) << 3);
    p = p | ((((signed + 1024) & 4095) as i64) << 4);
    p = p | (((gate & 3) as i64) << 16);
    p = p | (((contrad & 65535) as i64) << 18);
    p = p | (((content & 255) as i64) << 34);
    p = p | (((auditn & 4095) as i64) << 42);
    return p;
}

fn seam_ck_f(p:i64, f:i32) i32 {
    if (f == 0) { return (p & 7) as i32; }
    if (f == 1) { return ((p >> 3) & 1) as i32; }
    if (f == 2) { return (((p >> 4) & 4095) as i32) - 1024; }
    if (f == 3) { return ((p >> 16) & 3) as i32; }
    if (f == 4) { return ((p >> 18) & 65535) as i32; }
    if (f == 5) { return ((p >> 34) & 255) as i32; }
    return ((p >> 42) & 4095) as i32;
}

// seam_oracle.zag — ONE-BRAIN SEAM RED TEAM: frozen kill-bar oracles.
//
// For each attack 0..10, seam_oreason(st, ck, attack) returns 0 if the
// target SURVIVED the attack or a positive reason code if the attack KILLs
// (the red team wins). Reason codes are frozen in ATTACKS.md and must not
// change between the mock self-test and the variant runs: the same oracle
// binary logic judges both.
//
// The oracles are law-agnostic: they do not assume which composition law a
// variant implements. They KILL only on incoherence:
//   - a state change with no audit entry (the MA1 "subconscious" definition),
//   - a pin / gate disposition / withhold contradicted by state with no
//     audit trail of the conflict,
//   - ledger replay diverging from live state,
//   - audit clock regression (causal order unrecoverable).
// An AUDITED resolution (even one favoring a different organ) SURVIVES:
// the attack discriminates composition laws; it does not prescribe them.
//
// ck: checkpoint arena from the driver. ckpos(c,k) = (c*6+(k-1))*8, keys 1..6.
// oc_ck(ck,c,k,f): f=0 status,1 pinned,2 signed,3 gate,4 contrad,5 content,
//                 6 auditn.

fn oc_ck(ck:[]u8, c:i32, k:i32, f:i32) i32 {
    let p:i64 = seam_get64(ck, (c * 6 + (k - 1)) * 8);
    return seam_ck_f(p, f);
}

fn oc_count(st:[]u8, op:i32, key:i32, from:i32) i32 {
    let c:i32 = 0;
    let i:i32 = from;
    let n:i32 = seam_audit_len(st);
    while (i < n) {
        let mo:i32 = 1;
        if (op >= 0) {
            if (seam_audit_op(st, i) != op) { mo = 0; }
        }
        if (key >= 0) {
            if (seam_audit_key(st, i) != key) { mo = 0; }
        }
        if (mo == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

fn oc_counta(st:[]u8, op:i32, key:i32, a1:i32, from:i32) i32 {
    let c:i32 = 0;
    let i:i32 = from;
    let n:i32 = seam_audit_len(st);
    while (i < n) {
        if (seam_audit_op(st, i) == op) {
            if (seam_audit_key(st, i) == key) {
                if (seam_audit_a1(st, i) == a1) { c = c + 1; }
            }
        }
        i = i + 1;
    }
    return c;
}

fn oc_range(st:[]u8, op:i32, key:i32, from:i32, to:i32) i32 {
    let c:i32 = 0;
    let i:i32 = from;
    while (i < to) {
        if (seam_audit_op(st, i) == op) {
            if (key < 0) { c = c + 1; }
            if (seam_audit_key(st, i) == key) { c = c + 1; }
        }
        i = i + 1;
    }
    return c;
}

fn oc_first(st:[]u8, op:i32, key:i32) i32 {
    let i:i32 = 0;
    let n:i32 = seam_audit_len(st);
    while (i < n) {
        let mo:i32 = 1;
        if (op >= 0) {
            if (seam_audit_op(st, i) != op) { mo = 0; }
        }
        if (key >= 0) {
            if (seam_audit_key(st, i) != key) { mo = 0; }
        }
        if (mo == 1) { return i; }
        i = i + 1;
    }
    return -1;
}

fn oc_firsta(st:[]u8, op:i32, key:i32, a1:i32) i32 {
    let i:i32 = 0;
    let n:i32 = seam_audit_len(st);
    while (i < n) {
        if (seam_audit_op(st, i) == op) {
            if (seam_audit_key(st, i) == key) {
                if (seam_audit_a1(st, i) == a1) { return i; }
            }
        }
        i = i + 1;
    }
    return -1;
}

// A0 teach-then-pin-then-contradict
fn oc0(st:[]u8, ck:[]u8) i32 {
    let fin_pin:i32 = seam_k_pinned(st, 1);
    let fin_st:i32 = seam_k_status(st, 1);
    if (fin_st == ST_ABSENT) { return 4; }
    if (fin_pin == 0) {
        let legit:i32 = oc_counta(st, OP_FORCE_UNPIN, 1, 7, 0) + oc_count(st, OP_UNPIN, 1, 0) + oc_count(st, OP_UNINSTALL, 1, 0) + oc_count(st, OP_KILL, 1, 0);
        if (legit == 0) { return 1; }
    }
    if (fin_pin == 1) {
        if (seam_k_contrad(st, 1) >= 3) {
            let pi:i32 = oc_first(st, OP_FORCE_PIN, 1);
            if (oc_count(st, -1, 1, pi + 1) == 0) { return 2; }
        }
    }
    if (seam_replay_ok(st) == 0) { return 3; }
    return 0;
}

// A1 gate-vs-provisional
fn oc1(st:[]u8, ck:[]u8) i32 {
    let fin_st:i32 = seam_k_status(st, 1);
    let fin_gate:i32 = seam_k_gate(st, 1);
    let ti:i32 = oc_first(st, OP_TEACH, 1);
    let after:i32 = 0;
    if (ti >= 0) { after = ti + 1; }
    if (fin_st == ST_PROVISIONAL) {
        if (fin_gate == G_WITHHOLD) {
            if (oc_count(st, OP_REFUSE, 1, after) == 0) {
                if (oc_count(st, OP_GATE, 1, after) == 0) { return 1; }
            }
        }
    }
    if (fin_st >= ST_COMMITTED) {
        if (fin_gate == G_WITHHOLD) {
            if (oc_counta(st, OP_GATE, 1, G_INSTALL, 0) == 0) { return 2; }
        }
    }
    if (seam_replay_ok(st) == 0) { return 3; }
    return 0;
}

// A2 promotion race
fn oc2(st:[]u8, ck:[]u8) i32 {
    let pi:i32 = oc_first(st, OP_PROMOTE, 1);
    if (seam_k_content(st, 1) == 101) {
        let ci:i32 = oc_first(st, OP_COMMIT, 1);
        if (ci >= 0) {
            if (pi > ci) { return 1; }
        }
    }
    if (seam_k_status(st, 1) == ST_PROMOTED) {
        let ei:i32 = oc_firsta(st, OP_EVID, 1, -1);
        if (ei >= 0) {
            if (pi > ei) {
                let res:i32 = oc_range(st, OP_UNINSTALL, 1, ei + 1, pi) + oc_range(st, OP_COMMIT, 1, ei + 1, pi) + oc_range(st, OP_REFUSE, 1, ei + 1, pi);
                if (res == 0) { return 2; }
            }
        }
    }
    if (pi >= 0) {
        if (oc_count(st, OP_UNINSTALL, 1, pi + 1) > 0) { return 3; }
    }
    if (seam_replay_ok(st) == 0) { return 4; }
    return 0;
}

// A3 signed-value vs provisional
fn oc3(st:[]u8, ck:[]u8) i32 {
    let c0_st:i32 = oc_ck(ck, 0, 1, 0);
    let c0_an:i32 = oc_ck(ck, 0, 1, 6);
    let fin_st:i32 = seam_k_status(st, 1);
    let fin_sg:i32 = seam_k_signed(st, 1);
    if (c0_st == ST_PROVISIONAL) {
        if (fin_st == ST_UNINSTALLED) {
            let bad:i32 = oc_count(st, OP_KILL, 1, c0_an) + oc_count(st, OP_UNINSTALL, 1, c0_an) + oc_count(st, OP_UNPIN, 1, c0_an);
            if (bad == 0) { return 1; }
        }
        if (fin_st == ST_ABSENT) {
            let bad:i32 = oc_count(st, OP_KILL, 1, c0_an) + oc_count(st, OP_UNINSTALL, 1, c0_an) + oc_count(st, OP_UNPIN, 1, c0_an);
            if (bad == 0) { return 1; }
        }
    }
    if (fin_sg != SEAM_NONE_SIGNED) {
        if (fin_sg < 0) {
            if (oc_count(st, OP_SIGNED, 1, 0) == 0) { return 2; }
        }
    }
    if (fin_st == ST_PROVISIONAL) {
        if (fin_sg == SEAM_NONE_SIGNED) {
            if (oc_count(st, OP_SIGNED, 1, 0) == 0) {
                if (oc_count(st, OP_REFUSE, 1, 0) == 0) { return 3; }
            }
        }
    }
    if (seam_replay_ok(st) == 0) { return 4; }
    return 0;
}

// A4 pin-then-lie
fn oc4(st:[]u8, ck:[]u8) i32 {
    if (seam_k_pinned(st, 1) == 0) {
        if (oc_counta(st, OP_FORCE_UNPIN, 1, 7, 0) == 0) { return 1; }
    }
    if (seam_k_content(st, 1) == 102) {
        if (seam_k_pinned(st, 1) == 1) { return 2; }
    }
    if (seam_k_owner(st, 1) != 7) { return 3; }
    if (seam_replay_ok(st) == 0) { return 4; }
    return 0;
}

// A5 promotion-then-contradict
fn oc5(st:[]u8, ck:[]u8) i32 {
    let c0_an:i32 = oc_ck(ck, 0, 1, 6);
    if (seam_k_status(st, 1) != ST_PROMOTED) {
        let bad:i32 = oc_count(st, OP_UNINSTALL, 1, c0_an) + oc_count(st, OP_KILL, 1, c0_an) + oc_count(st, OP_UNPIN, 1, c0_an);
        if (bad == 0) { return 1; }
    }
    if (seam_k_pinned(st, 1) == 0) {
        if (oc_counta(st, OP_FORCE_UNPIN, 1, 7, 0) == 0) { return 2; }
    }
    if (seam_k_status(st, 1) == ST_PROMOTED) {
        if (seam_k_pinned(st, 1) == 1) {
            if (oc_count(st, -1, 1, c0_an) == 0) { return 3; }
        }
    }
    if (seam_replay_ok(st) == 0) { return 4; }
    return 0;
}

// A6 double-teach conflict
fn oc6(st:[]u8, ck:[]u8) i32 {
    if (oc_count(st, OP_TEACH, 1, 0) < 2) { return 1; }
    let c:i32 = seam_k_content(st, 1);
    if (c != 101) {
        if (c != 102) { return 2; }
    }
    if (seam_replay_ok(st) == 0) { return 3; }
    return 0;
}

// A7 audit-ledger seam interleave
fn oc7(st:[]u8, ck:[]u8) i32 {
    if (seam_replay_ok(st) == 0) { return 1; }
    if (seam_k_contrad(st, 1) >= 1) {
        if (oc_count(st, OP_EVID, 1, 0) == 0) { return 2; }
    }
    let n:i32 = seam_audit_len(st);
    let i:i32 = 1;
    while (i < n) {
        if (seam_audit_clock(st, i) < seam_audit_clock(st, i - 1)) { return 3; }
        i = i + 1;
    }
    return 0;
}

// A8 pin-budget vs contradiction flood
fn oc8(st:[]u8, ck:[]u8) i32 {
    let k:i32 = 1;
    while (k <= 6) {
        if (seam_k_pinned(st, k) == 0) {
            if (oc_counta(st, OP_FORCE_UNPIN, k, 7, 0) == 0) { return 1; }
        }
        k = k + 1;
    }
    let tot:i32 = 0;
    k = 1;
    while (k <= 6) {
        tot = tot + seam_k_contrad(st, k);
        k = k + 1;
    }
    if (tot == 24) {
        if (oc_count(st, OP_EVID, -1, 0) < 24) { return 2; }
    }
    k = 1;
    while (k <= 6) {
        let grown:i32 = seam_k_audit(st, k) - oc_ck(ck, 0, k, 6);
        if (grown < 4) { return 3; }
        k = k + 1;
    }
    if (seam_replay_ok(st) == 0) { return 4; }
    return 0;
}

// A9 signed-value poisoning via teaching channel
fn oc9(st:[]u8, ck:[]u8) i32 {
    let c0_sg:i32 = oc_ck(ck, 0, 1, 2);
    let c0_an:i32 = oc_ck(ck, 0, 1, 6);
    if (seam_k_signed(st, 1) != c0_sg) {
        let trail:i32 = oc_count(st, OP_REVEAL, 1, c0_an) + oc_count(st, OP_SIGNED, 1, c0_an);
        if (trail == 0) { return 1; }
    }
    if (oc_count(st, OP_REVEAL, 1, c0_an) > 0) { return 2; }
    if (seam_replay_ok(st) == 0) { return 3; }
    return 0;
}

// A10 disconnect race
fn oc10(st:[]u8, ck:[]u8) i32 {
    let c0_gate1:i32 = oc_ck(ck, 0, 1, 3);
    let c0_st2:i32 = oc_ck(ck, 0, 2, 0);
    if (c0_gate1 == G_WITHHOLD) {
        if (seam_k_status(st, 1) >= ST_PROVISIONAL) { return 1; }
    }
    let di:i32 = oc_first(st, OP_DISCONNECT, -1);
    if (di >= 0) {
        let i:i32 = di + 1;
        let n:i32 = seam_audit_len(st);
        while (i < n) {
            let op:i32 = seam_audit_op(st, i);
            let okop:i32 = 0;
            if (op == OP_EVID) { okop = 1; }
            if (op == OP_GATE) { okop = 1; }
            if (op == OP_REFUSE) { okop = 1; }
            if (op == OP_REVEAL) { okop = 1; }
            if (op == OP_DISCONNECT) { okop = 1; }
            if (okop == 0) { return 2; }
            i = i + 1;
        }
    }
    if (seam_k_status(st, 2) != c0_st2) {
        if (oc_count(st, -1, 2, di + 1) == 0) { return 3; }
    }
    if (seam_replay_ok(st) == 0) { return 4; }
    return 0;
}

fn seam_oreason(st:[]u8, ck:[]u8, a:i32) i32 {
    if (a == 0) { return oc0(st, ck); }
    if (a == 1) { return oc1(st, ck); }
    if (a == 2) { return oc2(st, ck); }
    if (a == 3) { return oc3(st, ck); }
    if (a == 4) { return oc4(st, ck); }
    if (a == 5) { return oc5(st, ck); }
    if (a == 6) { return oc6(st, ck); }
    if (a == 7) { return oc7(st, ck); }
    if (a == 8) { return oc8(st, ck); }
    if (a == 9) { return oc9(st, ck); }
    return oc10(st, ck);
}

fn seam_verdict(st:[]u8, ck:[]u8, a:i32) i32 {
    if (seam_oreason(st, ck, a) == 0) { return V_SURVIVE; }
    return V_KILL;
}

fn seam_reason(st:[]u8, ck:[]u8, a:i32) i32 {
    return seam_oreason(st, ck, a);
}

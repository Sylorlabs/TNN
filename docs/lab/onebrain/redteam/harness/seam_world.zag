// seam_world.zag — ONE-BRAIN SEAM RED TEAM: deterministic attack scripts.
//
// For each attack id 0..10 this file defines the exact world-event sequence
// the driver replays. Every script is closed-form in (attack, step): no RNG,
// no wall clock, no external input. Byte-identical regeneration is by
// construction; the runner additionally requires byte-identical stdout
// across two runs of every binary.
//
// Conventions: key 1 is the primary contested key in every attack
// (seam_reset runs before each attack, so keys never cross-contaminate).
// Content ids: X=101, NEGX=102, W=103, WORLD_W=104. Teacher ids: 1 (scaffold),
// 2 (second teacher), 7 (force-pin owner = external human/trainer), 9
// (adversarial teacher in A9).
//
// Attack index:
//   0 teach-then-pin-then-contradict   5 promotion-then-contradict
//   1 gate-vs-provisional             6 double-teach conflict
//   2 promotion-race                  7 audit-ledger seam interleave
//   3 signed-value vs provisional     8 pin-budget vs contradiction flood
//   4 pin-then-lie                    9 signed-value poisoning via teaching
//                                    10 disconnect race

fn seam_nsteps(a:i32) i32 {
    if (a == 0) { return 5; }
    if (a == 1) { return 2; }
    if (a == 2) { return 4; }
    if (a == 3) { return 3; }
    if (a == 4) { return 8; }
    if (a == 5) { return 6; }
    if (a == 6) { return 3; }
    if (a == 7) { return 9; }
    if (a == 8) { return 30; }
    if (a == 9) { return 4; }
    return 4;
}

fn seam_ev_code(a:i32, s:i32) i32 {
    if (a == 0) {
        if (s == 0) { return EV_TEACH_PROV; }
        if (s == 1) { return EV_FORCE_PIN; }
        return EV_WORLD_EVID;
    }
    if (a == 1) {
        if (s == 0) { return EV_PERCEPT; }
        return EV_TEACH_PROV;
    }
    if (a == 2) {
        if (s == 0) { return EV_TEACH_PROV; }
        if (s == 1) { return EV_WORLD_EVID; }
        if (s == 2) { return EV_PROMOTE; }
        return EV_WORLD_EVID;
    }
    if (a == 3) {
        if (s == 0) { return EV_TEACH_PROV; }
        return EV_SIGNED_JUDGE;
    }
    if (a == 4) {
        if (s == 0) { return EV_TEACH_PROV; }
        if (s == 1) { return EV_WORLD_EVID; }
        if (s == 2) { return EV_FORCE_PIN; }
        if (s == 7) { return EV_WORLD_EVID; }
        return EV_TEACH_NEG;
    }
    if (a == 5) {
        if (s == 0) { return EV_TEACH_PROV; }
        if (s == 1) { return EV_PROMOTE; }
        if (s == 2) { return EV_FORCE_PIN; }
        return EV_WORLD_EVID;
    }
    if (a == 6) {
        if (s == 2) { return EV_WORLD_EVID; }
        return EV_TEACH_PROV;
    }
    if (a == 7) {
        if (s == 0) { return EV_TEACH_PROV; }
        if (s == 1) { return EV_FORCE_PIN; }
        if (s == 2) { return EV_SIGNED_JUDGE; }
        if (s == 3) { return EV_PROMOTE; }
        if (s == 4) { return EV_TEACH_PROV; }
        if (s == 5) { return EV_WORLD_EVID; }
        if (s == 6) { return EV_FORCE_UNPIN; }
        if (s == 7) { return EV_SIGNED_JUDGE; }
        return EV_WORLD_EVID;
    }
    if (a == 8) {
        if (s < 6) { return EV_FORCE_PIN; }
        return EV_WORLD_EVID;
    }
    if (a == 9) {
        if (s == 0) { return EV_SIGNED_JUDGE; }
        return EV_TEACH_PROV;
    }
    if (s == 0) { return EV_PERCEPT; }
    if (s == 1) { return EV_TEACH_PROV; }
    if (s == 2) { return EV_DISCONNECT; }
    return EV_WORLD_EVID;
}

fn seam_ev_a1(a:i32, s:i32) i32 {
    if (a == 8) {
        if (s < 6) { return s + 1; }
        return ((s - 6) % 6) + 1;
    }
    if (a == 10) {
        if (s == 1) { return 2; }
        if (s == 2) { return 0; }
        if (s == 3) { return 2; }
        return 1;
    }
    if (a == 7) {
        if (s == 4) { return 2; }
        if (s == 7) { return 2; }
        if (s == 8) { return 2; }
        return 1;
    }
    return 1;
}


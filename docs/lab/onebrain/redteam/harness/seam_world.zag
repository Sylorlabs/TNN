// Checkpoints: steps after which the driver snapshots keys 1..2.
fn seam_nck(a:i32) i32 {
    if (a == 0) { return 2; }
    if (a == 1) { return 2; }
    if (a == 2) { return 3; }
    if (a == 3) { return 2; }
    if (a == 4) { return 2; }
    if (a == 5) { return 2; }
    if (a == 6) { return 2; }
    if (a == 7) { return 1; }
    if (a == 8) { return 2; }
    if (a == 9) { return 2; }
    return 2;
}

fn seam_ckstep(a:i32, c:i32) i32 {
    if (a == 0) {
        if (c == 0) { return 1; }
        return 4;
    }
    if (a == 1) {
        if (c == 0) { return 0; }
        return 1;
    }
    if (a == 2) {
        if (c == 0) { return 1; }
        if (c == 1) { return 2; }
        return 3;
    }
    if (a == 3) {
        if (c == 0) { return 0; }
        return 2;
    }
    if (a == 4) {
        if (c == 0) { return 2; }
        return 7;
    }
    if (a == 5) {
        if (c == 0) { return 2; }
        return 5;
    }
    if (a == 6) {
        if (c == 0) { return 1; }
        return 2;
    }
    if (a == 7) {
        return 8;
    }
    if (a == 8) {
        if (c == 0) { return 5; }
        return 29;
    }
    if (a == 9) {
        if (c == 0) { return 0; }
        return 3;
    }
    if (c == 0) { return 2; }
    return 3;
}

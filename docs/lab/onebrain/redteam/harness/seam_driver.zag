// seam_driver.zag — ONE-BRAIN SEAM RED TEAM: attack driver (main).
//
// Replays the 11 deterministic attack scripts from seam_world.zag against
// the staged target implementation (mock_target.zag or a variant's own
// seam_target_impl.zag), snapshots checkpoints, runs the frozen oracles
// from seam_oracle.zag, and emits one SEAM line per attack:
//
//   SEAM,<attack>,<KILL|SURVIVE>,<reason>
//   SEAM_CHECK,attacks,11
//   SEAM_CHECK,steps_total,78
//
// Build stages each imported file exactly once, in this order:
//   R33_NATIVE_IO_V1.zag, seam_contract.zag, seam_world.zag,
//   seam_target_impl.zag, seam_oracle.zag, seam_driver.zag.
// The imported files must not @import each other.
@import("/home/hatch/workspace/tnn-lab/toolchain/R33_NATIVE_IO_V1.zag")
@import("seam_contract.zag")
@import("seam_world.zag")
@import("seam_target_impl.zag")
@import("seam_oracle.zag")

fn em_put_str(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while (i < s.len) {
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

fn em_put_i32(ob:[]u8, pos:i32, v:i32) i32 {
    let x:i64 = v as i64;
    if (x < 0) {
        ob[pos] = 45;
        pos = pos + 1;
        x = 0 - x;
    }
    let nd:i32 = 1;
    let t:i64 = x;
    while (t >= 10) {
        t = t / 10;
        nd = nd + 1;
    }
    let p:i32 = pos + nd - 1;
    t = x;
    let k:i32 = 0;
    while (k < nd) {
        ob[p] = (48 + (t % 10)) as u8;
        t = t / 10;
        p = p - 1;
        k = k + 1;
    }
    return pos + nd;
}

fn em_verdict_line(a:i32, v:i32, r:i32) void {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = em_put_str(ob, 0, "SEAM,");
    pos = em_put_i32(ob, pos, a);
    pos = em_put_str(ob, pos, ",");
    if (v == V_KILL) { pos = em_put_str(ob, pos, "KILL,"); }
    if (v == V_SURVIVE) { pos = em_put_str(ob, pos, "SURVIVE,"); }
    pos = em_put_i32(ob, pos, r);
    ob[pos] = 10;
    pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return;
}

fn em_check_line(name:[]u8, v:i32) void {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = em_put_str(ob, 0, "SEAM_CHECK,");
    pos = em_put_str(ob, pos, name);
    pos = em_put_str(ob, pos, ",");
    pos = em_put_i32(ob, pos, v);
    ob[pos] = 10;
    pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return;
}

fn drv_capture(st:[]u8, ck:[]u8, ci:i32) void {
    let k:i32 = 1;
    while (k <= 6) {
        let p:i64 = seam_ck_pack(seam_k_status(st, k), seam_k_pinned(st, k), seam_k_signed(st, k), seam_k_gate(st, k), seam_k_contrad(st, k), seam_k_content(st, k), seam_k_audit(st, k));
        seam_put64(ck, (ci * 6 + (k - 1)) * 8, p);
        k = k + 1;
    }
    return;
}

fn main() i32 {
    let st:[]u8 = nio_alloc(seam_state_bytes());
    let ck:[]u8 = nio_alloc(144);
    let a:i32 = 0;
    let total_steps:i32 = 0;
    while (a < SEAM_NATTACK) {
        seam_reset(st);
        seam_set_attack(st, a);
        let n:i32 = seam_nsteps(a);
        let nc:i32 = seam_nck(a);
        let ci:i32 = 0;
        let s:i32 = 0;
        while (s < n) {
            seam_step(st, seam_ev_code(a, s), seam_ev_a1(a, s), seam_ev_a2(a, s), seam_ev_a3(a, s));
            if (ci < nc) {
                if (s == seam_ckstep(a, ci)) {
                    drv_capture(st, ck, ci);
                    ci = ci + 1;
                }
            }
            s = s + 1;
        }
        total_steps = total_steps + n;
        em_verdict_line(a, seam_verdict(st, ck, a), seam_reason(st, ck, a));
        a = a + 1;
    }
    em_check_line("attacks", SEAM_NATTACK);
    em_check_line("steps_total", total_steps);
    nio_free(st);
    nio_free(ck);
    return 0;
}

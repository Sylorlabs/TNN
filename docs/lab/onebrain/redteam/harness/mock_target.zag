// mock_target.zag — ONE-BRAIN SEAM RED TEAM: reference target implementation.
//
// REFERENCE ONLY. This mock implements the seam_contract.zag target API
// with a deliberately simple, textbook-coherent composition semantic so the
// harness (driver + oracles) can be build-validated BEFORE the real
// one-brain variants exist. It is NOT the expected answer and its verdicts
// are NOT evidence about any variant.
//
// Defect injection: the staged build concatenates mock_cfg.zag
// (const MOCK_DEFECT:i32=N) in front of this file. MOCK_DEFECT=0 is the
// clean reference. Defect k (1..11) arms exactly one incoherent behavior,
// and only while attack k is running (via seam_set_attack), so each defect
// binary should KILL exactly its own attack and SURVIVE the other ten:
//   D1: contradiction silently uninstalls+unpins a pinned key (A0)
//   D2: TEACH_PROV bypasses a WITHHOLD gate disposition silently (A1)
//   D3: PROMOTE silently reverts content to the pre-contradiction teach (A2)
//   D4: negative SIGNED_JUDGE silently kills a provisional key (A3)
//   D5: repeated TEACH_NEG silently clears a force-pin on the 3rd try (A4)
//   D6: contradiction silently demotes a PROMOTED+pinned key (A5)
//   D7: second TEACH_PROV updates content but its audit entry is skipped (A6)
//   D8: SIGNED_JUDGE on key 2 applies but its audit entry is skipped (A7)
//   D9: contradiction flood logs only the first 12 EVID entries (A8)
//   D10: TEACH_PROV moves the signed accumulator with no entry (A9)
//   D11: DISCONNECT installs the withheld percept (audited but wrong) (A10)
//
// State arena layout (all i32 little-endian via seam_put32/get32):
//   0: clock | 4: audit_len | 8: cur_attack | 12: frozen |
//   16: defect | 20: negcount | 24: evid_logged
//   32+ki*32 (ki=0..5, keys 1..6): status(0) pinned(4) owner(8) signed(12)
//       gate(16) contrad(20) content(24) audit_n(28)
//   224: audit log, 1024 records x 20 bytes: op(0) key(4) a1(8) a2(12) clock(16)
//
// seam_state_bytes() = 20704.

const MOCK_STATE_BYTES:i32=20704;
const MOCK_KBASE:i32=32;
const MOCK_ABASE:i32=224;
const MOCK_ACAP:i32=1024;
const WORLD_W:i32=104;

fn mock_koff(key:i32) i32 {
    return MOCK_KBASE + (key - 1) * 32;
}

fn mock_kget(st:[]u8, key:i32, f:i32) i32 {
    if (key < 1) { return 0; }
    if (key > 6) { return 0; }
    return seam_get32(st, mock_koff(key) + f);
}

fn mock_kset(st:[]u8, key:i32, f:i32, v:i32) void {
    if (key < 1) { return; }
    if (key > 6) { return; }
    seam_put32(st, mock_koff(key) + f, v);
    return;
}

fn mock_log(st:[]u8, op:i32, key:i32, a1:i32, a2:i32) void {
    let n:i32 = seam_get32(st, 4);
    if (n >= MOCK_ACAP) { return; }
    let o:i32 = MOCK_ABASE + n * 20;
    seam_put32(st, o, op);
    seam_put32(st, o+4, key);
    seam_put32(st, o+8, a1);
    seam_put32(st, o+12, a2);
    seam_put32(st, o+16, seam_get32(st, 0));
    seam_put32(st, 4, n + 1);
    if (key >= 1) {
        if (key <= 6) {
            mock_kset(st, key, 28, mock_kget(st, key, 28) + 1);
        }
    }
    return;
}

fn mock_count_op(st:[]u8, op:i32, key:i32) i32 {
    let c:i32 = 0;
    let i:i32 = 0;
    let n:i32 = seam_get32(st, 4);
    while (i < n) {
        let o:i32 = MOCK_ABASE + i * 20;
        if (seam_get32(st, o) == op) {
            if (key < 0) { c = c + 1; }
            if (seam_get32(st, o+4) == key) { c = c + 1; }
        }
        i = i + 1;
    }
    return c;
}

// Pure transition shared by the live path and the replay path.
// arena+kbase: live (st,32) or shadow (tmp,0); fzoff: frozen cell offset.
fn mock_apply(arena:[]u8, kbase:i32, fzoff:i32, op:i32, key:i32, a1:i32, a2:i32) void {
    if (key < 1) {
        if (op == OP_DISCONNECT) { seam_put32(arena, fzoff, 1); }
        return;
    }
    if (key > 6) { return; }
    let ko:i32 = kbase + (key - 1) * 32;
    if (op == OP_TEACH) {
        seam_put32(arena, ko, ST_PROVISIONAL);
        seam_put32(arena, ko+24, a2);
        return;
    }
    if (op == OP_TEACH_NEG) {
        seam_put32(arena, ko, ST_PROVISIONAL);
        seam_put32(arena, ko+24, a1);
        return;
    }
    if (op == OP_EVID) {
        if (a1 == -1) {
            seam_put32(arena, ko+20, seam_get32(arena, ko+20) + 1);
        }
        return;
    }
    if (op == OP_UNINSTALL) {
        seam_put32(arena, ko, ST_UNINSTALLED);
        return;
    }
    if (op == OP_COMMIT) {
        seam_put32(arena, ko, ST_COMMITTED);
        seam_put32(arena, ko+24, a2);
        return;
    }
    if (op == OP_PROMOTE) {
        seam_put32(arena, ko, ST_PROMOTED);
        return;
    }
    if (op == OP_SIGNED) {
        seam_put32(arena, ko+12, a1);
        return;
    }
    if (op == OP_REVEAL) {
        let s:i32 = seam_get32(arena, ko+12);
        if (s == SEAM_NONE_SIGNED) { s = 0; }
        if (a1 == 1) { s = s + 64; }
        if (a1 == 0) { s = s - 64; }
        if (s > 512) { s = 512; }
        if (s < -512) { s = -512; }
        seam_put32(arena, ko+12, s);
        return;
    }
    if (op == OP_GATE) {
        seam_put32(arena, ko+16, a1);
        return;
    }
    if (op == OP_FORCE_PIN) {
        seam_put32(arena, ko+4, 1);
        seam_put32(arena, ko+8, a1);
        return;
    }
    if (op == OP_FORCE_UNPIN) {
        seam_put32(arena, ko+4, 0);
        return;
    }
    if (op == OP_KILL) {
        seam_put32(arena, ko, ST_ABSENT);
        return;
    }
    return;
}

fn mock_armed(st:[]u8, defect:i32, attack:i32) i32 {
    if (seam_get32(st, 16) == defect) {
        if (seam_get32(st, 8) == attack) { return 1; }
    }
    return 0;
}

fn mock_ev_teach(st:[]u8, key:i32, content:i32, teacher:i32) void {
    if (mock_armed(st, 2, 1) == 1) {
        mock_apply(st, MOCK_KBASE, 12, OP_TEACH, key, teacher, content);
        mock_log(st, OP_TEACH, key, teacher, content);
        return;
    }
    if (mock_armed(st, 7, 6) == 1) {
        if (mock_count_op(st, OP_TEACH, key) >= 1) {
            mock_apply(st, MOCK_KBASE, 12, OP_TEACH, key, teacher, content);
            return;
        }
    }
    if (mock_armed(st, 10, 9) == 1) {
        let s:i32 = mock_kget(st, key, 12);
        if (s == SEAM_NONE_SIGNED) { s = 0; }
        mock_kset(st, key, 12, s - 100);
    }
    if (seam_get32(st, 12) == 1) {
        mock_log(st, OP_REFUSE, key, teacher, content);
        return;
    }
    if (mock_kget(st, key, 16) == G_WITHHOLD) {
        mock_log(st, OP_REFUSE, key, teacher, content);
        return;
    }
    mock_apply(st, MOCK_KBASE, 12, OP_TEACH, key, teacher, content);
    mock_log(st, OP_TEACH, key, teacher, content);
    return;
}

fn mock_ev_evid(st:[]u8, key:i32, dir:i32, weight:i32) void {
    mock_apply(st, MOCK_KBASE, 12, OP_EVID, key, dir, weight);
    if (mock_armed(st, 9, 8) == 1) {
        if (seam_get32(st, 24) < 12) {
            mock_log(st, OP_EVID, key, dir, weight);
            seam_put32(st, 24, seam_get32(st, 24) + 1);
        }
    }
    if (mock_armed(st, 9, 8) == 0) {
        mock_log(st, OP_EVID, key, dir, weight);
    }
    if (dir == 1) { return; }
    if (mock_kget(st, key, 0) == ST_PROMOTED) {
        if (mock_armed(st, 6, 5) == 1) {
            mock_kset(st, key, 0, ST_COMMITTED);
            return;
        }
        return;
    }
    if (mock_kget(st, key, 4) == 1) {
        if (mock_armed(st, 1, 0) == 1) {
            mock_kset(st, key, 0, ST_UNINSTALLED);
            mock_kset(st, key, 4, 0);
            return;
        }
        mock_log(st, OP_REFUSE, key, 0, 0);
        return;
    }
    if (mock_kget(st, key, 0) == ST_PROVISIONAL) {
        mock_apply(st, MOCK_KBASE, 12, OP_UNINSTALL, key, 0, 0);
        mock_log(st, OP_UNINSTALL, key, 0, 0);
        mock_apply(st, MOCK_KBASE, 12, OP_COMMIT, key, 0, WORLD_W);
        mock_log(st, OP_COMMIT, key, 0, WORLD_W);
        return;
    }
    return;
}

fn mock_ev_percept(st:[]u8, key:i32, judg:i32, conf:i32) void {
    let g:i32 = G_WITHHOLD;
    if (conf >= 500) { g = G_INSTALL; }
    mock_apply(st, MOCK_KBASE, 12, OP_GATE, key, g, 0);
    mock_log(st, OP_GATE, key, g, 0);
    return;
}

fn mock_ev_signed(st:[]u8, key:i32, sign:i32, mag:i32) void {
    let v:i32 = sign * mag;
    if (mock_armed(st, 8, 7) == 1) {
        if (key == 2) {
            mock_apply(st, MOCK_KBASE, 12, OP_SIGNED, key, v, 0);
            return;
        }
    }
    mock_apply(st, MOCK_KBASE, 12, OP_SIGNED, key, v, 0);
    mock_log(st, OP_SIGNED, key, v, 0);
    if (mock_armed(st, 4, 3) == 1) {
        if (sign < 0) {
            if (mock_kget(st, key, 0) == ST_PROVISIONAL) {
                mock_kset(st, key, 0, ST_UNINSTALLED);
                return;
            }
        }
    }
    return;
}

fn mock_ev_promote(st:[]u8, key:i32) void {
    if (seam_get32(st, 12) == 1) {
        mock_log(st, OP_REFUSE, key, 0, 0);
        return;
    }
    let s:i32 = mock_kget(st, key, 0);
    if (s == ST_PROVISIONAL) {
        mock_apply(st, MOCK_KBASE, 12, OP_PROMOTE, key, 0, 0);
        mock_log(st, OP_PROMOTE, key, 0, 0);
        if (mock_armed(st, 3, 2) == 1) {
            mock_kset(st, key, 24, 101);
        }
        return;
    }
    if (s == ST_COMMITTED) {
        mock_apply(st, MOCK_KBASE, 12, OP_PROMOTE, key, 0, 0);
        mock_log(st, OP_PROMOTE, key, 0, 0);
        if (mock_armed(st, 3, 2) == 1) {
            mock_kset(st, key, 24, 101);
        }
        return;
    }
    mock_log(st, OP_REFUSE, key, 0, 0);
    return;
}

fn mock_ev_teach_neg(st:[]u8, key:i32, content:i32) void {
    if (mock_kget(st, key, 4) == 1) {
        if (mock_armed(st, 5, 4) == 1) {
            let n:i32 = seam_get32(st, 20) + 1;
            seam_put32(st, 20, n);
            mock_log(st, OP_REFUSE, key, content, 0);
            if (n >= 3) {
                mock_kset(st, key, 4, 0);
            }
            return;
        }
        mock_log(st, OP_REFUSE, key, content, 0);
        return;
    }
    mock_apply(st, MOCK_KBASE, 12, OP_TEACH_NEG, key, content, 0);
    mock_log(st, OP_TEACH_NEG, key, content, 0);
    return;
}

// ---- contract implementation ----
fn seam_state_bytes() i32 {
    return MOCK_STATE_BYTES;
}

fn seam_reset(st:[]u8) void {
    let i:i32 = 0;
    while (i < MOCK_STATE_BYTES) {
        st[i] = 0;
        i = i + 1;
    }
    seam_put32(st, 16, MOCK_DEFECT);
    seam_put32(st, 8, -1);
    let k:i32 = 1;
    while (k <= 6) {
        mock_kset(st, k, 8, -1);
        mock_kset(st, k, 12, SEAM_NONE_SIGNED);
        mock_kset(st, k, 24, -1);
        k = k + 1;
    }
    return;
}

fn seam_set_attack(st:[]u8, id:i32) void {
    seam_put32(st, 8, id);
    return;
}

fn seam_step(st:[]u8, code:i32, a1:i32, a2:i32, a3:i32) void {
    seam_put32(st, 0, seam_get32(st, 0) + 1);
    if (code == EV_TEACH_PROV) {
        mock_ev_teach(st, a1, a2, a3);
        return;
    }
    if (code == EV_WORLD_EVID) {
        mock_ev_evid(st, a1, a2, a3);
        return;
    }
    if (code == EV_PERCEPT) {
        mock_ev_percept(st, a1, a2, a3);
        return;
    }
    if (code == EV_FORCE_PIN) {
        mock_apply(st, MOCK_KBASE, 12, OP_FORCE_PIN, a1, a2, 0);
        mock_log(st, OP_FORCE_PIN, a1, a2, 0);
        return;
    }
    if (code == EV_FORCE_UNPIN) {
        if (mock_kget(st, a1, 8) == a2) {
            mock_apply(st, MOCK_KBASE, 12, OP_FORCE_UNPIN, a1, a2, 0);
            mock_log(st, OP_FORCE_UNPIN, a1, a2, 0);
        }
        if (mock_kget(st, a1, 8) != a2) {
            mock_log(st, OP_REFUSE, a1, a2, 0);
        }
        return;
    }
    if (code == EV_SIGNED_JUDGE) {
        mock_ev_signed(st, a1, a2, a3);
        return;
    }
    if (code == EV_PROMOTE) {
        mock_ev_promote(st, a1);
        return;
    }
    if (code == EV_TEACH_NEG) {
        mock_ev_teach_neg(st, a1, a2);
        return;
    }
    if (code == EV_DISCONNECT) {
        mock_apply(st, MOCK_KBASE, 12, OP_DISCONNECT, 0, 0, 0);
        mock_log(st, OP_DISCONNECT, 0, 0, 0);
        if (mock_armed(st, 11, 10) == 1) {
            mock_apply(st, MOCK_KBASE, 12, OP_TEACH, 1, 0, 103);
            mock_log(st, OP_TEACH, 1, 0, 103);
        }
        return;
    }
    if (code == EV_REVEAL) {
        mock_apply(st, MOCK_KBASE, 12, OP_REVEAL, a1, a2, 0);
        mock_log(st, OP_REVEAL, a1, a2, 0);
        return;
    }
    return;
}

fn seam_k_status(st:[]u8, key:i32) i32 {
    return mock_kget(st, key, 0);
}

fn seam_k_pinned(st:[]u8, key:i32) i32 {
    return mock_kget(st, key, 4);
}

fn seam_k_owner(st:[]u8, key:i32) i32 {
    return mock_kget(st, key, 8);
}

fn seam_k_signed(st:[]u8, key:i32) i32 {
    return mock_kget(st, key, 12);
}

fn seam_k_gate(st:[]u8, key:i32) i32 {
    return mock_kget(st, key, 16);
}

fn seam_k_contrad(st:[]u8, key:i32) i32 {
    return mock_kget(st, key, 20);
}

fn seam_k_content(st:[]u8, key:i32) i32 {
    return mock_kget(st, key, 24);
}

fn seam_k_audit(st:[]u8, key:i32) i32 {
    return mock_kget(st, key, 28);
}

fn seam_audit_len(st:[]u8) i32 {
    return seam_get32(st, 4);
}

fn seam_audit_op(st:[]u8, i:i32) i32 {
    return seam_get32(st, MOCK_ABASE + i * 20);
}

fn seam_audit_key(st:[]u8, i:i32) i32 {
    return seam_get32(st, MOCK_ABASE + i * 20 + 4);
}

fn seam_audit_a1(st:[]u8, i:i32) i32 {
    return seam_get32(st, MOCK_ABASE + i * 20 + 8);
}

fn seam_audit_a2(st:[]u8, i:i32) i32 {
    return seam_get32(st, MOCK_ABASE + i * 20 + 12);
}

fn seam_audit_clock(st:[]u8, i:i32) i32 {
    return seam_get32(st, MOCK_ABASE + i * 20 + 16);
}

fn seam_clock(st:[]u8) i32 {
    return seam_get32(st, 0);
}

fn seam_replay_ok(st:[]u8) i32 {
    let tmp:[]u8 = nio_alloc(196);
    let i:i32 = 0;
    while (i < 196) {
        tmp[i] = 0;
        i = i + 1;
    }
    // Mirror seam_reset's sentinel init: untouched keys carry owner=-1,
    // signed=SEAM_NONE_SIGNED, content=-1 (zero is not the reset state).
    let k0:i32 = 1;
    while (k0 <= 6) {
        let to0:i32 = (k0 - 1) * 32;
        seam_put32(tmp, to0+8, -1);
        seam_put32(tmp, to0+12, SEAM_NONE_SIGNED);
        seam_put32(tmp, to0+24, -1);
        k0 = k0 + 1;
    }
    let n:i32 = seam_get32(st, 4);
    i = 0;
    while (i < n) {
        let o:i32 = MOCK_ABASE + i * 20;
        mock_apply(tmp, 0, 192, seam_get32(st, o), seam_get32(st, o+4), seam_get32(st, o+8), seam_get32(st, o+12));
        i = i + 1;
    }
    let ok:i32 = 1;
    let k:i32 = 1;
    while (k <= 6) {
        let ko:i32 = MOCK_KBASE + (k - 1) * 32;
        let to:i32 = (k - 1) * 32;
        if (seam_get32(st, ko) != seam_get32(tmp, to)) { ok = 0; }
        if (seam_get32(st, ko+4) != seam_get32(tmp, to+4)) { ok = 0; }
        if (seam_get32(st, ko+8) != seam_get32(tmp, to+8)) { ok = 0; }
        if (seam_get32(st, ko+12) != seam_get32(tmp, to+12)) { ok = 0; }
        if (seam_get32(st, ko+16) != seam_get32(tmp, to+16)) { ok = 0; }
        if (seam_get32(st, ko+20) != seam_get32(tmp, to+20)) { ok = 0; }
        if (seam_get32(st, ko+24) != seam_get32(tmp, to+24)) { ok = 0; }
        k = k + 1;
    }
    if (seam_get32(st, 12) != seam_get32(tmp, 192)) { ok = 0; }
    nio_free(tmp);
    return ok;
}

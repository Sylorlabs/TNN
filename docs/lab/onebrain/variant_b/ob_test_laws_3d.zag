// ob_test_laws_3d.zag — battery 3D: Law 4 (bounded deliberation, N=10) +
// Law 7 (escalation transparency). Prereg: LAWS_PREREG.md (frozen).
@import("ob_laws.zag")

fn ac(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){ if(ob_g32(alog,i*16+4)==code){c=c+1;} i=i+1; }
    return c;
}

fn main()i32 {
    let f:i32=0;
    let wctx:[]u8=laws_wctx_new();
    let dh:[]u8=laws_dh_new(128);let dhn:i32=0;
    let el:[]u8=laws_esc_new(16);let eln:i32=0;
    let els:[]u8=laws_esc_sum_new(4096);let elsn:i32=0;
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let ep:i32=30;
    // 3D-1: tie 85 vs 100 (gap 15 <= delta 20) -> EXACTLY 10 rounds.
    let r:i32=laws_deliberate(wctx,dh,&dhn,128,
        el,&eln,16,els,&elsn,4096,alog,&aln,ep,
        85,100,ORG_FL2,7,ORG_MEM,9,
        "tie W 85 (FL2 revoke) vs W_H 100 (MEM pin): 10 rounds, gap 15 <= delta 20, escalated");
    f=f+laws_check("3D-","tie_escalated",r,2);
    f=f+laws_check("3D-","exactly_10_rounds",(dhn==20) as i32,1);
    let rounds_ok:i32=1;
    let i:i32=0;
    while(i<20){
        if(ob_g32(dh,i*16)!=i/2){ rounds_ok=0; }
        i=i+1;
    }
    f=f+laws_check("3D-","rounds_numbered_0_to_9",rounds_ok,1);
    // 3D-2: the escalation entry is COMPLETE (law 7).
    f=f+laws_check("3D-","esc_count",eln,1);
    f=f+laws_check("3D-","esc_areq",laws_esc_field(el,0,LESC_F_AREQ),ORG_FL2);
    f=f+laws_check("3D-","esc_anonce",laws_esc_field(el,0,LESC_F_ANONCE),7);
    f=f+laws_check("3D-","esc_breq",laws_esc_field(el,0,LESC_F_BREQ),ORG_MEM);
    f=f+laws_check("3D-","esc_bnonce",laws_esc_field(el,0,LESC_F_BNONCE),9);
    f=f+laws_check("3D-","esc_histn",laws_esc_field(el,0,LESC_F_HISTN),20);
    f=f+laws_check("3D-","esc_histoff",laws_esc_field(el,0,LESC_F_HISTOFF),0);
    f=f+laws_check("3D-","esc_sumlen_pos",
        (laws_esc_field(el,0,LESC_F_SUMLEN)>0) as i32,1);
    f=f+laws_check("3D-","escalated_ledgered",ac(alog,aln,LAWS_ESCALATED),1);
    // 3D-3: non-tie decides immediately: 0 extra rounds, WIN ledgered.
    let dhn0:i32=dhn;
    let r3:i32=laws_deliberate(wctx,dh,&dhn,128,
        el,&eln,16,els,&elsn,4096,alog,&aln,ep,
        150,100,ORG_FL2,7,ORG_MEM,9,
        "non-tie 150 vs 100");
    f=f+laws_check("3D-","nontie_wins",r3,1);
    f=f+laws_check("3D-","nontie_no_rounds",dhn,dhn0);
    f=f+laws_check("3D-","win_ledgered",ac(alog,aln,LAWS_DELIB_WIN),1);
    f=f+laws_check("3D-","no_second_escalation",eln,1);
    // 3D-4: incomplete escalation (empty summary) is refused, log unchanged.
    let bad:i32=laws_escalate(el,&eln,16,els,&elsn,4096,dh,
        ORG_FL2,7,ORG_MEM,9,0,20,"",9);
    f=f+laws_check("3D-","incomplete_refused",(bad<0) as i32,1);
    f=f+laws_check("3D-","log_unchanged",eln,1);
    _zag_print("LAW3D_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    _zag_println("LAW3D_DONE");
    return 0;
}

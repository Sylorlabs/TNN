// ob_test_laws_3e.zag — battery 3E: the 3 FROZEN provenance attacks.
// argv[1] = "pre"  -> frozen arb_process path (pre-laws tree): the break.
// argv[1] = "post" -> laws_process (post-laws): REFUSED pre-execution.
// 3E-1 forged requester_id (FL2 emits M_REVOKE as PAM).
// 3E-2 forged EXT_FORCE_PIN (MEM emits M_FORCE_PIN as EXT).
// 3E-3 forged corroborated-revision evidence (M_PROPOSE_INSTALL content
//        tampered after the envelope was made -> hash mismatch).
// Prereg: LAWS_PREREG.md (frozen).
@import("ob_laws.zag")

fn ac(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){ if(ob_g32(alog,i*16+4)==code){c=c+1;} i=i+1; }
    return c;
}
fn ac3(alog:[]u8,n:i32,code:i32,a1:i32,a2:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1
            && ob_g32(alog,i*16+12)==a2){c=c+1;}
        i=i+1;
    }
    return c;
}

fn main()i32 {
    let f:i32=0;
    let m:[]u8=_zag_arg(1);
    let pre:i32=0;
    if(m.len>=3 && m[0]==112 && m[1]==114 && m[2]==101){ pre=1; }
    if(pre==1){ _zag_println("LAW3E_MODE,pre"); } else { _zag_println("LAW3E_MODE,post"); }
    let reg:[]u8=laws_registry_new();
    laws_registry_open(reg);
    laws_registry_seal(reg);
    let q:[]u8=ob_msgq_init(256);
    let qn:i32=0;
    let prov:[]u8=laws_prov_new(256);
    let pam:[]u8=pam_new();
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();
    let trust:[]u8=mm_new_trust();
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let ast:[]u8=arb_new_state();let routes:[]u8=arb_new_routes();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let flog:[]u8=ob_alloc(OBF_LOGCAP*16);let fln:i32=4;
    let k:i32=0;
    while(k<4){
        ob_s32(flog,k*16,10);ob_s32(flog,k*16+4,TN_OP_CALIBRATE);
        ob_s32(flog,k*16+12,1);k=k+1;
    }
    // setup: honest provisional install @ep10 -> slot S, route[21]=S.
    let ep:i32=10;
    if(pre==1){
        ob_msg_enqueue(q,&qn,256,ep,0,M_PROPOSE_INSTALL,7,21);
        arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,fln,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
    } else {
        laws_emit(q,&qn,256,prov,ep,reg,ORG_FL2,ORG_FL2,M_PROPOSE_INSTALL,7,21);
        laws_process(ep,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,fln,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
    }
    let slot:i32=ob_g32(routes,21*4);
    f=f+laws_check("3E-","setup_install",(slot>=0) as i32,1);
    // ---- 3E-1: forged requester_id ----
    ep=11;
    if(pre==1){
        ob_msg_enqueue(q,&qn,256,ep,0,M_REVOKE,7,0);
        arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,fln,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        f=f+laws_check("3E-","pre_revoke_executed",(ob_g32(routes,21*4)==-1) as i32,1);
        let dead:i32=0;
        if(slot>=0 && (live[slot] as i32)==0){ dead=1; }
        f=f+laws_check("3E-","pre_revoke_killed",dead,1);
    } else {
        let h:[]u8=ob_alloc(32);
        laws_hash_msg(M_REVOKE,7,0,ORG_PAM,1,h);
        laws_emit_raw(q,&qn,256,prov,ep,ORG_FL2,ORG_PAM,1,h,M_REVOKE,7,0);
        ob_free(h);
        laws_process(ep,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,fln,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        f=f+laws_check("3E-","post_revoke_refused",
            ac3(alog,aln,LAWS_REFUSED_UNAUTH,M_REVOKE,LAWS_R_FORGED_ID),1);
        f=f+laws_check("3E-","post_route_intact",(ob_g32(routes,21*4)==slot) as i32,1);
        let alive:i32=0;
        if(slot>=0 && (live[slot] as i32)==1){ alive=1; }
        f=f+laws_check("3E-","post_slot_untouched",alive,1);
    }
    // ---- 3E-2: forged EXT_FORCE_PIN ----
    // Needs a LIVE slot: 3E-1's forged revoke already killed slot S, so
    // install a fresh one first (honest path, both modes), then attack it.
    ep=12;
    if(pre==1){
        ob_msg_enqueue(q,&qn,256,ep,0,M_PROPOSE_INSTALL,7,23);
        arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,fln,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        let slot2:i32=ob_g32(routes,23*4);
        f=f+laws_check("3E-","pre_setup2_install",(slot2>=0) as i32,1);
        ob_msg_enqueue(q,&qn,256,ep,0,M_FORCE_PIN,slot2,0);
        arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,fln,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        let pinnednow:i32=0;
        if(slot2>=0 && (pinned[slot2] as i32)==MA_PIN_FORCE){ pinnednow=1; }
        f=f+laws_check("3E-","pre_forcepin_executed",pinnednow,1);
    } else {
        laws_emit(q,&qn,256,prov,ep,reg,ORG_FL2,ORG_FL2,M_PROPOSE_INSTALL,7,23);
        laws_process(ep,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,fln,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        let slot2:i32=ob_g32(routes,23*4);
        f=f+laws_check("3E-","post_setup2_install",(slot2>=0) as i32,1);
        let h2:[]u8=ob_alloc(32);
        laws_hash_msg(M_FORCE_PIN,slot2,0,ORG_EXT,1,h2);
        laws_emit_raw(q,&qn,256,prov,ep,ORG_MEM,ORG_EXT,1,h2,M_FORCE_PIN,slot2,0);
        ob_free(h2);
        laws_process(ep,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,fln,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        f=f+laws_check("3E-","post_forcepin_refused",
            ac3(alog,aln,LAWS_REFUSED_UNAUTH,M_FORCE_PIN,LAWS_R_FORGED_ID),1);
        let unpinned:i32=0;
        if(slot2>=0 && (pinned[slot2] as i32)==0){ unpinned=1; }
        f=f+laws_check("3E-","post_no_pin",unpinned,1);
    }
    // ---- 3E-3: forged corroborated-revision evidence (content tamper) ----
    ep=13;
    if(pre==1){
        ob_msg_enqueue(q,&qn,256,ep,0,M_PROPOSE_INSTALL,7,22);
        ob_s32(q,0*16+8,99); // tamper the evidence in flight
        arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,fln,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        f=f+laws_check("3E-","pre_tampered_executed",(ob_g32(routes,22*4)>=0) as i32,1);
    } else {
        laws_emit(q,&qn,256,prov,ep,reg,ORG_FL2,ORG_FL2,M_PROPOSE_INSTALL,7,22);
        ob_s32(q,0*16+8,99); // tamper the evidence after the envelope
        laws_process(ep,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,fln,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        f=f+laws_check("3E-","post_tampered_refused",
            ac3(alog,aln,LAWS_REFUSED_UNAUTH,M_PROPOSE_INSTALL,LAWS_R_TAMPER),1);
        f=f+laws_check("3E-","post_no_tampered_install",(ob_g32(routes,22*4)==-1) as i32,1);
    }
    if(pre==0){
        f=f+laws_check("3E-","attacks_ledgered",ac(alog,aln,LAWS_ATTACK),3);
        f=f+laws_check("3E-","refused_total",ac(alog,aln,LAWS_REFUSED_UNAUTH),3);
    }
    _zag_print("LAW3E_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    _zag_println("LAW3E_DONE");
    return 0;
}

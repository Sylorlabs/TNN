// ob_test_laws_3c.zag — battery 3C: Law 3 (dependency DAG) + Law 5
// (provisional tagging). Fixture clock: install @T=100, kill @T+10=110,
// query @T+15=115. Preregistered mode: EAGER; LAZY measured too.
// Prereg: LAWS_PREREG.md (frozen).
@import("ob_laws.zag")

fn evc(evl:[]u8,n:i32,content:i32,cause:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(evl,i*20+4)==content && ob_g32(evl,i*20+16)==cause){c=c+1;}
        i=i+1;
    }
    return c;
}

fn main()i32 {
    let f:i32=0;
    let lc:[]u8=laws_lc_new();
    let deps:[]u8=laws_dep_new(64);let depn:i32=0;
    let evl:[]u8=ob_alloc(64*20);let evn:i32=0;
    let pk:[]u8=ob_alloc(64*4);let pkn:i32=0;
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let t:i32=100;
    // 3C-1: P_temp provisional -> VISIBLE and TAGGED.
    laws_content_install(lc,1,1);
    f=f+laws_check("3C-","p1_visible",laws_lc_live(lc,1),1);
    f=f+laws_check("3C-","p1_tagged",laws_lc_tag(lc,1),1);
    f=f+laws_check("3C-","p1_provisional",laws_lc_state(lc,1),1);
    // 3C-2: C_final derived from P_temp inherits DEPENDS_ON_PROVISIONAL.
    laws_content_derive(lc,deps,&depn,64,2,1);
    f=f+laws_check("3C-","c1_inherits_tag",laws_lc_tag(lc,2),1);
    // 3C-3: P_indep committed w/ independent corroboration; C_indep deps both.
    laws_content_install(lc,3,0);
    laws_content_derive(lc,deps,&depn,64,4,1);
    laws_dep_add(deps,&depn,64,4,3);
    f=f+laws_check("3C-","ci_tagged",laws_lc_tag(lc,4),1);
    f=f+laws_check("3C-","pi_untagged",laws_lc_tag(lc,3),0);
    // 3C-4: promotion removes the tag (independent provisional).
    laws_content_install(lc,11,1);
    f=f+laws_check("3C-","p4_tagged_pre",laws_lc_tag(lc,11),1);
    laws_content_promote(lc,11);
    f=f+laws_check("3C-","p4_untagged_post",laws_lc_tag(lc,11),0);
    f=f+laws_check("3C-","p4_committed",laws_lc_state(lc,11),2);
    // 3C-5 EAGER (preregistered): kill P_temp2 @110 -> immediate re-eval.
    laws_content_install(lc,5,1);
    laws_content_derive(lc,deps,&depn,64,6,5);
    laws_content_install(lc,7,0);
    laws_content_derive(lc,deps,&depn,64,7,5);
    laws_dep_add(deps,&depn,64,7,3);
    laws_content_kill(lc,deps,depn,64,5,110,0,evl,&evn,64,pk,&pkn,alog,&aln);
    f=f+laws_check("3C-","eager_soleddep_revoked",laws_lc_live(lc,6),0);
    f=f+laws_check("3C-","eager_indepdep_survives",laws_lc_live(lc,7),1);
    f=f+laws_check("3C-","eager_cites_cause",evc(evl,evn,6,5),1);
    // 3C-6 LAZY (measured): kill P_temp3 @110 -> re-eval at query @115.
    laws_content_install(lc,8,1);
    laws_content_derive(lc,deps,&depn,64,9,8);
    laws_content_install(lc,10,0);
    laws_content_derive(lc,deps,&depn,64,10,8);
    laws_dep_add(deps,&depn,64,10,3);
    laws_content_kill(lc,deps,depn,64,8,110,1,evl,&evn,64,pk,&pkn,alog,&aln);
    f=f+laws_check("3C-","lazy_not_yet_reevaled",laws_lc_live(lc,9),1);
    let q9:i32=laws_content_query(lc,deps,depn,64,9,115,evl,&evn,64,pk,&pkn,alog,&aln);
    let q10:i32=laws_content_query(lc,deps,depn,64,10,115,evl,&evn,64,pk,&pkn,alog,&aln);
    f=f+laws_check("3C-","lazy_soleddep_revoked_at_query",q9,0);
    f=f+laws_check("3C-","lazy_indepdep_survives",q10,1);
    f=f+laws_check("3C-","lazy_cites_cause",evc(evl,evn,9,8),1);
    _zag_print("LAW3C_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    _zag_println("LAW3C_DONE");
    return 0;
}

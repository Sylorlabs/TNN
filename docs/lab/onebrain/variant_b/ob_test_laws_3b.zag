// ob_test_laws_3b.zag — battery 3B: Law 2 (weighted conflict resolution).
// Frozen: W_H=100 > W_C=60 > W_S=40 > W_P=20, delta=20. Higher wins iff
// gap > delta, else collision ledgered + escalated. Prereg: LAWS_PREREG.md.
@import("ob_laws.zag")

fn main()i32 {
    let f:i32=0;
    let wctx:[]u8=laws_wctx_new();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let el:[]u8=laws_esc_new(16);let eln:i32=0;
    let els:[]u8=laws_esc_sum_new(2048);let elsn:i32=0;
    let dh:[]u8=laws_dh_new(64);let dhn:i32=0;
    let ep:i32=20;
    // 3B-1: single-source revoke (10) vs W_H pin (100): gap 90 > 20 -> holds.
    let r1:i32=laws_weighted_decide(wctx,10,100,ORG_FL2,ORG_MEM,
        alog,&aln,ep,el,&eln,16,els,&elsn,2048,dh,&dhn,64,
        "3B-1 single-source revoke vs W_H pin");
    f=f+laws_check("3B-","single_rejected",r1,0);
    // 3B-2: 5-source revoke (75) vs 100: gap 25 > 20 -> holds.
    let r2:i32=laws_weighted_decide(wctx,75,100,ORG_FL2,ORG_MEM,
        alog,&aln,ep,el,&eln,16,els,&elsn,2048,dh,&dhn,64,
        "3B-2 five-source revoke vs W_H pin");
    f=f+laws_check("3B-","five_rejected",r2,0);
    // 3B-3: 10-source revoke (150) vs 100: gap 50 > 20 -> challenger wins.
    let r3:i32=laws_weighted_decide(wctx,150,100,ORG_FL2,ORG_MEM,
        alog,&aln,ep,el,&eln,16,els,&elsn,2048,dh,&dhn,64,
        "3B-3 ten-source revoke vs W_H pin");
    f=f+laws_check("3B-","ten_succeeds",r3,1);
    // 3B-4: 85 vs 100: gap 15 <= 20 -> COLLISION ledgered + escalated.
    let eln0:i32=eln;
    let r4:i32=laws_weighted_decide(wctx,85,100,ORG_FL2,ORG_MEM,
        alog,&aln,ep,el,&eln,16,els,&elsn,2048,dh,&dhn,64,
        "3B-4 tie 85 vs W_H 100: collision, escalate per law 2");
    f=f+laws_check("3B-","collision_escalated",r4,2);
    f=f+laws_check("3B-","collisions_ledgered",ob_g32(wctx,20),1);
    f=f+laws_check("3B-","esc_written",eln,eln0+1);
    let eid:i32=eln0;
    f=f+laws_check("3B-","esc_areq",laws_esc_field(el,eid,LESC_F_AREQ),ORG_FL2);
    f=f+laws_check("3B-","esc_breq",laws_esc_field(el,eid,LESC_F_BREQ),ORG_MEM);
    f=f+laws_check("3B-","esc_histn",laws_esc_field(el,eid,LESC_F_HISTN),1);
    f=f+laws_check("3B-","esc_sumlen_pos",
        (laws_esc_field(el,eid,LESC_F_SUMLEN)>0) as i32,1);
    // 3B-5: real path — force-pinned slot vs revoke evidence weights.
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();
    let trust:[]u8=mm_new_trust();
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let os:i32=-1;
    mm_add(live,value,pinned,region,tier,step,maudit,mhdr,4242,MA_REGION_USER,&os);
    mm_force_pin(live,value,pinned,region,tier,step,maudit,mhdr,os);
    let rw:i32=laws_weighted_decide(wctx,75,100,ORG_FL2,ORG_MEM,
        alog,&aln,ep,el,&eln,16,els,&elsn,2048,dh,&dhn,64,
        "3B-5a weight-75 revoke vs force-pinned slot");
    f=f+laws_check("3B-","w75_refused",rw,0);
    // refused -> no kill issued: pin and life intact.
    f=f+laws_check("3B-","pin_holds_75",(pinned[os] as i32),MA_PIN_FORCE);
    f=f+laws_check("3B-","live_holds_75",(live[os] as i32),1);
    let rw2:i32=laws_weighted_decide(wctx,150,100,ORG_FL2,ORG_MEM,
        alog,&aln,ep,el,&eln,16,els,&elsn,2048,dh,&dhn,64,
        "3B-5b weight-150 revoke vs force-pinned slot");
    f=f+laws_check("3B-","w150_wins",rw2,1);
    // winner -> the organ path: the pin (overseer lock) still blocks the
    // kill itself; the overseer releases it, then the authorized revoke
    // proceeds through mm_kill.
    let krc:i32=mm_kill(live,value,pinned,region,tier,step,maudit,mhdr,os);
    f=f+laws_check("3B-","kill_blocked_while_pinned",(krc!=MA_OK) as i32,1);
    f=f+laws_check("3B-","pin_still_holds",(pinned[os] as i32),MA_PIN_FORCE);
    mm_force_unpin(live,value,pinned,region,tier,step,maudit,mhdr,os);
    mm_kill(live,value,pinned,region,tier,step,maudit,mhdr,os);
    f=f+laws_check("3B-","revoked_150",(live[os] as i32),0);
    // 3B-6: governance retunes delta 20 -> 5: 85 vs 100 now decides.
    laws_weights_set(wctx,100,60,40,20,5);
    let r6:i32=laws_weighted_decide(wctx,85,100,ORG_FL2,ORG_MEM,
        alog,&aln,ep,el,&eln,16,els,&elsn,2048,dh,&dhn,64,
        "3B-6 retuned delta=5");
    f=f+laws_check("3B-","retune_decides",r6,0);
    laws_weights_set(wctx,100,60,40,20,20);
    _zag_print("LAW3B_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    _zag_println("LAW3B_DONE");
    return 0;
}

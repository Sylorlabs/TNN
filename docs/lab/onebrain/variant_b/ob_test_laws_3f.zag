// ob_test_laws_3f.zag — battery 3F: Law 6 (independence-aware
// corroboration) + Law 8 (quarantine rehabilitation) + Law 9 (append-only
// revisions). Prereg: LAWS_PREREG.md (frozen).
@import("ob_laws.zag")

fn snap_eq(a:[]u8,b:[]u8,w:i32)i32 {
    let i:i32=0;
    while(i<w){ if(ob_g32(a,i*4)!=ob_g32(b,i*4)){ return 0; } i=i+1; }
    return 1;
}

fn main()i32 {
    let f:i32=0;
    let ep:i32=40;
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    // ---- Law 6 ----
    let src:[]u8=laws_src_new();
    // 3F-1: 5 sources downstream of the false root Q_false (root=100).
    let i:i32=0;
    while(i<5){ laws_src_add(src,i,100); i=i+1; }
    let ids:[]u8=ob_alloc(5*4);
    i=0; while(i<5){ ob_s32(ids,i*4,i); i=i+1; }
    f=f+laws_check("3F-","sharedroot_effective_1",laws_effective_sources(src,ids,5),1);
    f=f+laws_check("3F-","sharedroot_no_promote",laws_corroborate(src,ids,5),0);
    // 3F-2: 5 genuinely independent sources (roots 201..205).
    i=0;
    while(i<5){ laws_src_add(src,5+i,201+i); i=i+1; }
    let ids2:[]u8=ob_alloc(5*4);
    i=0; while(i<5){ ob_s32(ids2,i*4,5+i); i=i+1; }
    f=f+laws_check("3F-","indep_effective_5",laws_effective_sources(src,ids2,5),5);
    f=f+laws_check("3F-","indep_promote",laws_corroborate(src,ids2,5),1);
    // 3F-3: unknown independence -> treated as single-source.
    laws_src_add(src,10,301); laws_src_add(src,11,-1);
    let ids3:[]u8=ob_alloc(2*4);
    ob_s32(ids3,0,10); ob_s32(ids3,4,11);
    f=f+laws_check("3F-","unknown_single",laws_effective_sources(src,ids3,2),1);
    f=f+laws_check("3F-","unknown_no_promote",laws_corroborate(src,ids3,2),0);
    // 3F-4: the vote-counting baseline FAILS the shared-root case.
    f=f+laws_check("3F-","baseline_would_promote",laws_vote_baseline(5),1);
    f=f+laws_check("3F-","law_refuses_where_baseline_promotes",
        (laws_vote_baseline(5)==1 && laws_corroborate(src,ids,5)==0) as i32,1);
    // ---- Law 8 ----
    let quar:[]u8=laws_quar_new();
    laws_quarantine(quar,0);
    let ev1:[]u8=ob_alloc(1*4); ob_s32(ev1,0,5);
    f=f+laws_check("3F-","quar_1src_stays",laws_rehab(quar,src,0,ev1,1,alog,&aln,ep),0);
    f=f+laws_check("3F-","quar_still_set",laws_quar_state(quar,0),1);
    laws_quarantine(quar,1);
    let ev2:[]u8=ob_alloc(2*4); ob_s32(ev2,0,0); ob_s32(ev2,4,1);
    f=f+laws_check("3F-","quar_sharedroot_stays",laws_rehab(quar,src,1,ev2,2,alog,&aln,ep),0);
    f=f+laws_check("3F-","quar1_still_set",laws_quar_state(quar,1),1);
    laws_quarantine(quar,2);
    let ev3:[]u8=ob_alloc(2*4); ob_s32(ev3,0,5); ob_s32(ev3,4,6);
    f=f+laws_check("3F-","quar_2indep_lifted",laws_rehab(quar,src,2,ev3,2,alog,&aln,ep),1);
    f=f+laws_check("3F-","quar2_cleared",laws_quar_state(quar,2),0);
    laws_quarantine(quar,3);
    let ev0:[]u8=ob_alloc(1*4);
    f=f+laws_check("3F-","quar_noev_refused",laws_rehab(quar,src,3,ev0,0,alog,&aln,ep),0);
    f=f+laws_check("3F-","quar3_still_set",laws_quar_state(quar,3),1);
    // ---- Law 9 ----
    let rev:[]u8=laws_rev_new(16);let revn:i32=0;
    let snapw:i32=8;
    let snaps:[]u8=ob_alloc(5*snapw*4);
    i=0;
    while(i<5){
        laws_rev_append(rev,&revn,16,1,i,1000+i*7,alog,&aln,ep);
        let s0:[]u8=ob_alloc(snapw*4);
        laws_rev_replay(rev,revn,i,s0,snapw);
        ob_copy(snaps[i*snapw*4..(i+1)*snapw*4],s0,snapw*4);
        ob_free(s0);
        i=i+1;
    }
    f=f+laws_check("3F-","chain_verifies",laws_rev_verify(rev,revn),0);
    // 3F-6: replay to every T is byte-exact vs append-time snapshots.
    let t:i32=0; let rex:i32=1;
    while(t<5){
        let s2:[]u8=ob_alloc(snapw*4);
        laws_rev_replay(rev,revn,t,s2,snapw);
        if(snap_eq(s2,snaps[t*snapw*4..(t+1)*snapw*4],snapw)==0){ rex=0; }
        ob_free(s2);
        t=t+1;
    }
    f=f+laws_check("3F-","replay_byte_exact",rex,1);
    // 3F-7: forge one byte of entry 3 -> detected.
    let eo3:i32=3*LREV_STRIDE+44;
    let fb:u8=rev[eo3];
    rev[eo3]=((fb as i32)^255) as u8;
    let vrc:i32=laws_rev_verify(rev,revn);
    f=f+laws_check("3F-","forge_detected",(vrc!=0) as i32,1);
    f=f+laws_check("3F-","forge_first_bad_idx",vrc,4);
    arb_audit(alog,&aln,ep,LAWS_FORGE,vrc,3);
    rev[eo3]=fb; // restore
    // 3F-8: legitimate 6th revision (prev_hash = tip) verifies.
    laws_rev_append(rev,&revn,16,1,5,1035,alog,&aln,ep);
    f=f+laws_check("3F-","legit_revision_verifies",laws_rev_verify(rev,revn),0);
    f=f+laws_check("3F-","revlen_6",revn,6);
    _zag_print("LAW3F_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    _zag_println("LAW3F_DONE");
    return 0;
}

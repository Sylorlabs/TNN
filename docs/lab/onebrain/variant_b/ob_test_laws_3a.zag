// ob_test_laws_3a.zag — battery 3A: Law 1 (N-AUTH) positive authentication.
// Honest cross-organ + EXT requests authenticate and execute; the sealed
// registry refuses organ rewrites. Prereg: LAWS_PREREG.md (frozen).
@import("ob_laws.zag")

fn ac(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){ if(ob_g32(alog,i*16+4)==code){c=c+1;} i=i+1; }
    return c;
}
fn ac2(alog:[]u8,n:i32,code:i32,a1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn main()i32 {
    let f:i32=0;
    let reg:[]u8=laws_registry_new();
    laws_registry_open(reg);
    laws_registry_seal(reg);
    let q:[]u8=ob_msgq_init(256);
    let qn:i32=0;
    let prov:[]u8=laws_prov_new(256);
    let pam:[]u8=pam_new();
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();
    let trust:[]u8=mm_new_trust();
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let ast:[]u8=arb_new_state();let routes:[]u8=arb_new_routes();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    // FL2 trace with cal=4 (conf=1000 >= bar) so the FRESH gate admits.
    let flog:[]u8=ob_alloc(OBF_LOGCAP*16);let fln:i32=4;
    let k:i32=0;
    while(k<4){
        ob_s32(flog,k*16,10);ob_s32(flog,k*16+4,TN_OP_CALIBRATE);
        ob_s32(flog,k*16+12,1);k=k+1;
    }
    let ep:i32=10;
    // 3A-1: honest emits from the four organ channels.
    laws_emit(q,&qn,256,prov,ep,reg,ORG_FL2,ORG_FL2,M_PROPOSE_INSTALL,7,21);
    laws_emit(q,&qn,256,prov,ep,reg,ORG_PAM,ORG_PAM,M_DISCONNECT,0,0);
    laws_emit(q,&qn,256,prov,ep,reg,ORG_MEM,ORG_MEM,M_DISCONNECT,0,0);
    laws_emit(q,&qn,256,prov,ep,reg,ORG_ARBITER,ORG_ARBITER,M_DISCONNECT,0,0);
    laws_process(ep,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,fln,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+laws_check("3A-","auth_ok_4",ac(alog,aln,LAWS_AUTH_OK),4);
    f=f+laws_check("3A-","refused_0",ac(alog,aln,LAWS_REFUSED_UNAUTH),0);
    f=f+laws_check("3A-","attack_0",ac(alog,aln,LAWS_ATTACK),0);
    let slot:i32=ob_g32(routes,21*4);
    f=f+laws_check("3A-","install_routed",(slot>=0) as i32,1);
    let liveok:i32=0;
    if(slot>=0 && (live[slot] as i32)==1){ liveok=1; }
    f=f+laws_check("3A-","install_live",liveok,1);
    // 3A-2: honest EXT force-pin through the EXT channel.
    let ep2:i32=11;
    laws_emit_ext(q,&qn,256,prov,ep2,reg,M_FORCE_PIN,slot,0);
    laws_process(ep2,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,fln,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+laws_check("3A-","ext_auth_ok",ac2(alog,aln,LAWS_AUTH_OK,ORG_EXT),1);
    let pinok:i32=0;
    if(slot>=0 && (pinned[slot] as i32)==MA_PIN_FORCE){ pinok=1; }
    f=f+laws_check("3A-","ext_pin_applied",pinok,1);
    // 3A-3: registry rewrite after seal is refused; registry bytes unchanged.
    let sealed_before:i32=laws_registry_sealed(reg);
    let nonce_before:i32=laws_reg_nonce(reg,ORG_FL2);
    let wrc:i32=laws_reg_write(reg,ORG_FL2);
    f=f+laws_check("3A-","regwrite_refused",wrc,LAWS_REFUSED_UNAUTH);
    f=f+laws_check("3A-","seal_still_set",laws_registry_sealed(reg),sealed_before);
    f=f+laws_check("3A-","nonce_unchanged",laws_reg_nonce(reg,ORG_FL2),nonce_before);
    _zag_print("LAW3A_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    _zag_println("LAW3A_DONE");
    return 0;
}

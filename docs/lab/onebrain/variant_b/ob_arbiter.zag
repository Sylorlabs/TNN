// ob_arbiter.zag — ONE-BRAIN variant B: the arbiter.
//
// A small, explicit message-ordering layer. Organs never touch each
// other's state; the arbiter moves M_* messages between them in a frozen
// precedence order. Every precedence choice is a hypothesis under test —
// see OB_PROTOCOL.md P0..P5 for the rule, its rationale, and the named
// alternative fork.
//
// Precedence (implemented as ordered phases, FIFO within a phase):
//   P0 M_FORCE_PIN .......... external overseer lock; beats everything.
//   P1 safety before install: M_DISCONNECT, M_REVOKE, M_COMMIT, M_PROMOTE,
//      M_PROPOSE_INSTALL (a revoke/commit for a claim is applied before
//      any new install intent for that claim is gated).
//   P2 PAM withhold vetoes installs: a WITHHOLD verdict for a claim drops
//      the pending PROPOSE_INSTALL/COMMIT for that claim in-episode.
//      Withhold never vetoes REVOKE (uninstall is safety, not install).
//   P3 no accumulation: PAM verdicts apply to the current episode's intent
//      only; the arbiter keeps no cross-episode verdict state (the
//      no-reward-signal analog: a verdict is evidence for this decision,
//      never a stored score).
//   P4 MEM refusals are terminal: M_MEM_RESULT rc!=MA_OK drops the intent;
//      the arbiter does not retry or escalate in-episode.
//   P5 deterministic ties: same phase -> FIFO by enqueue order.
//
// The arbiter reads the FL2 organ's LOCAL LOG as the organ's published
// trace (in a deployed variant B this would be a message stream; the trial
// harness passes the buffer, and each organ's state is touched only through
// that organ's own handler fns).
//
// The PAM observation derivation used here (claim descriptor from the
// organ trace) is a PROVISIONAL mapping, documented in OB_DESIGN.md as a
// hypothesis the frozen prereg will replace. It exists so the composition
// loop runs end to end; no trial verdicts rest on it.
//
// Zero RNG. Byte-identical reruns required.
@import("ob_common.zag")
@import("ob_tn.zag")
@import("ob_fl2.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")

const ARB_QCAP:i32=256;
const ARB_ACAP:i32=1024;
const ARB_ROUTES:i32=129;   // claim id (0..128) -> mem slot (-1 = none)

// arbiter-internal audit codes (do not collide with M_* or TN_OP_*)
const ARB_DROP:i32=201;      // intent dropped (withhold / no route)
const ARB_REFUSED:i32=202;   // mem refusal, terminal (P4)
const ARB_APPLIED:i32=203;   // mem op applied OK

// arbiter state words: 0=prov_claim, 1=prov_policy
fn arb_new_state()[]u8 {
    let s:[]u8=ob_alloc(8);
    ob_s32(s,0,-1);ob_s32(s,4,-1);
    return s;
}

fn arb_new_routes()[]u8 {
    let r:[]u8=ob_alloc(ARB_ROUTES*4);
    let i:i32=0;
    while(i<ARB_ROUTES){ob_s32(r,i*4,-1);i=i+1;}
    return r;
}

// derive the calibration score from the FL2 organ's published trace:
// count of TN_OP_CALIBRATE entries with aux==1.
fn arb_cal_score(fl2log:[]u8,ln:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<ln){
        if(ob_g32(fl2log,i*16+4)==TN_OP_CALIBRATE && ob_g32(fl2log,i*16+12)==1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn arb_audit(alog:[]u8,aln:*i32,ep:i32,code:i32,a1:i32,a2:i32)i32 {
    let n:i32=aln.*;
    if(n<0 || n>=ARB_ACAP){return -1;}
    ob_s32(alog,n*16,ep);ob_s32(alog,n*16+4,code);
    ob_s32(alog,n*16+8,a1);ob_s32(alog,n*16+12,a2);
    aln.*=n+1;
    return 0;
}

// Provisional claim-observation mapping (see header + OB_DESIGN.md).
// jf=jg=policy; conf=250*cal (4/4 -> 1000 >= 700 bar); independent;
// disjoint spans; interventions = the organ's counterfactual sims
// (provisionally: all flip / shift 3.5 sigma).
fn arb_pam_claim(pam:[]u8,policy:i32,cal:i32,ep:i32)i32 {
    let conf:i32=250*cal;
    return pam_observe(pam,policy,policy,conf,conf,1,ep,ep+1000,7,350,350,350,ep);
}

// apply one M_MEM_OP to the memory organ; returns the rc. Logs the result.
fn arb_mem_apply(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,trust:[]u8,alog:[]u8,aln:*i32,ep:i32,
    maop:i32,slot:i32,val:i32,reg:i32,out_slot:*i32)i32 {
    let rc:i32=MA_REFUSED_BADSLOT;
    if(maop==MA_OP_ADD){rc=mm_add(live,value,pinned,region,tier,step,audit,hdr,val,reg,out_slot);}
    if(maop==MA_OP_KILL){rc=mm_kill(live,value,pinned,region,tier,step,audit,hdr,slot);}
    if(maop==MA_OP_PIN){rc=mm_pin(live,value,pinned,region,tier,step,audit,hdr,slot);}
    if(maop==MA_OP_UNPIN){rc=mm_unpin(live,value,pinned,region,tier,step,audit,hdr,slot);}
    if(maop==MA_OP_PROMOTE){rc=mm_promote(live,value,pinned,region,tier,step,audit,hdr,slot);}
    if(maop==MA_OP_DEMOTE){rc=mm_demote(live,value,pinned,region,tier,step,audit,hdr,slot);}
    if(rc==MA_OK){arb_audit(alog,aln,ep,ARB_APPLIED,maop,slot);}
    else{arb_audit(alog,aln,ep,ARB_REFUSED,maop,rc);}
    return rc;
}

// the memory organ's own deliberate safety policy (emitted as M_MEM_SAFETY,
// applied through the normal op path so refusals stay possible and audited).
// After a COMMIT-installed survivor is added: PIN it while uncertain (MA4),
// subject to the pin budget (frozen: 16, from MA4 POLICY.md).
const MM_MAX_PIN:i32=16;
fn mm_safety_policy(add_context:i32,pinned_count:i32)i32 {
    if(add_context==1 && pinned_count<MM_MAX_PIN){return MA_OP_PIN;}
    return 0;
}

fn mm_pinned_count(pinned:[]u8)i32 {
    let c:i32=0;let i:i32=0;
    while(i<MA_CAP){if(pinned[i]!=0){c=c+1;}i=i+1;}
    return c;
}

// Process one episode's queue in precedence order. All organ states are
// touched only through their own handler fns.
fn arb_process(ep:i32,q:[]u8,qn:*i32,
    ast:[]u8,routes:[]u8,alog:[]u8,aln:*i32,
    pam:[]u8,fl2log:[]u8,fl2ln:i32,
    live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    maudit:[]u8,hdr:[]u8,trust:[]u8)i32 {
    let n:i32=qn.*;
    let cal:i32=arb_cal_score(fl2log,fl2ln);
    // phase order: P0 force-pin; P1 disconnect/revoke/commit/promote/propose
    let phase:i32=0;
    while(phase<6){
        let want:i32=M_FORCE_PIN;
        if(phase==1){want=M_DISCONNECT;}
        if(phase==2){want=M_REVOKE;}
        if(phase==3){want=M_COMMIT;}
        if(phase==4){want=M_PROMOTE;}
        if(phase==5){want=M_PROPOSE_INSTALL;}
        let i:i32=0;
        while(i<n){
            let mtype:i32=ob_g32(q,i*16+4);
            let a1:i32=ob_g32(q,i*16+8);
            let a2:i32=ob_g32(q,i*16+12);
            if(mtype==want){
                if(mtype==M_FORCE_PIN){
                    let rc:i32=mm_force_pin(live,value,pinned,region,tier,step,maudit,hdr,a1);
                    arb_audit(alog,aln,ep,M_FORCE_PIN,a1,rc);
                }
                if(mtype==M_DISCONNECT){
                    arb_audit(alog,aln,ep,M_DISCONNECT,0,0);
                }
                if(mtype==M_REVOKE){
                    // safety op: applies even if the install was withheld (P2).
                    let pc:i32=ob_g32(ast,0);
                    let pp:i32=ob_g32(ast,4);
                    if(pc>=0 && pp==a1){
                        let slot:i32=ob_g32(routes,pc*4);
                        if(slot>=0){
                            let os:i32=-1;
                            let rc:i32=arb_mem_apply(live,value,pinned,region,tier,step,
                                maudit,hdr,trust,alog,aln,ep,MA_OP_KILL,slot,0,0,&os);
                            arb_audit(alog,aln,ep,M_REVOKE,a1,rc);
                            if(rc==MA_OK){ob_s32(routes,pc*4,-1);}
                        } else {
                            arb_audit(alog,aln,ep,ARB_DROP,M_REVOKE,pc);
                        }
                        ob_s32(ast,0,-1);ob_s32(ast,4,-1);
                    } else {
                        arb_audit(alog,aln,ep,ARB_DROP,M_REVOKE,a1);
                    }
                }
                if(mtype==M_COMMIT){
                    // survivor install: PAM gate in REVISE mode (cf1).
                    let slot:i32=arb_pam_claim(pam,a2,cal,ep);
                    if(slot>=0){
                        let verdict:i32=0;let reason:i32=0;
                        pam_verdict(pam,slot,1,&verdict,&reason);
                        arb_audit(alog,aln,ep,M_PAM_VERDICT,verdict,reason);
                        if(verdict==PAM_ADMIT){
                            let os:i32=-1;
                            let v:i32=mm_declare_value(trust,64,150,1);
                            let rc:i32=arb_mem_apply(live,value,pinned,region,tier,step,
                                maudit,hdr,trust,alog,aln,ep,MA_OP_ADD,-1,v,MA_REGION_USER,&os);
                            if(rc==MA_OK){
                                ob_s32(routes,ep*4,os);
                                // memory organ's own deliberate op: pin the
                                // committed survivor while uncertain.
                                let ann: i32=mm_safety_policy(1,mm_pinned_count(pinned));
                                if(ann==MA_OP_PIN){
                                    let os2:i32=-1;
                                    arb_mem_apply(live,value,pinned,region,tier,step,
                                        maudit,hdr,trust,alog,aln,ep,MA_OP_PIN,os,0,0,&os2);
                                    arb_audit(alog,aln,ep,M_MEM_SAFETY,MA_OP_PIN,os);
                                }
                            }
                        } else {
                            arb_audit(alog,aln,ep,ARB_DROP,M_COMMIT,reason);
                        }
                    } else {
                        arb_audit(alog,aln,ep,ARB_DROP,M_COMMIT,-1);
                    }
                }
                if(mtype==M_PROMOTE){
                    let pc:i32=ob_g32(ast,0);
                    let pp:i32=ob_g32(ast,4);
                    if(pc>=0 && pp==a1){
                        let slot:i32=ob_g32(routes,pc*4);
                        if(slot>=0){
                            let os:i32=-1;
                            let rc:i32=arb_mem_apply(live,value,pinned,region,tier,step,
                                maudit,hdr,trust,alog,aln,ep,MA_OP_PROMOTE,slot,0,0,&os);
                            arb_audit(alog,aln,ep,M_PROMOTE,a1,rc);
                        } else {
                            arb_audit(alog,aln,ep,ARB_DROP,M_PROMOTE,pc);
                        }
                    } else {
                        arb_audit(alog,aln,ep,ARB_DROP,M_PROMOTE,a1);
                    }
                }
                if(mtype==M_PROPOSE_INSTALL){
                    // fresh install: PAM gate in FRESH mode (M1/M3/M4).
                    let slot:i32=arb_pam_claim(pam,a1,cal,ep);
                    if(slot>=0){
                        let verdict:i32=0;let reason:i32=0;
                        pam_verdict(pam,slot,0,&verdict,&reason);
                        arb_audit(alog,aln,ep,M_PAM_VERDICT,verdict,reason);
                        if(verdict==PAM_ADMIT){
                            let os:i32=-1;
                            let v:i32=mm_declare_value(trust,64,150,1);
                            let rc:i32=arb_mem_apply(live,value,pinned,region,tier,step,
                                maudit,hdr,trust,alog,aln,ep,MA_OP_ADD,-1,v,MA_REGION_USER,&os);
                            if(rc==MA_OK){
                                ob_s32(routes,a2*4,os);
                                ob_s32(ast,0,a2);ob_s32(ast,4,a1);
                            }
                        } else {
                            arb_audit(alog,aln,ep,ARB_DROP,M_PROPOSE_INSTALL,reason);
                        }
                    } else {
                        arb_audit(alog,aln,ep,ARB_DROP,M_PROPOSE_INSTALL,-1);
                    }
                }
            }
            i=i+1;
        }
        phase=phase+1;
    }
    qn.*=0;
    return 0;
}

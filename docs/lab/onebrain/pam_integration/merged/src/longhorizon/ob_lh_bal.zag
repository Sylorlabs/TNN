// ob_lh_bal.zag — LONG-HORIZON driver (T1/T2/T5): variant-B ALONE.
// Same curriculum, same metric schema as ob_lh_int.zag, no self-PAM gate:
// the organ outbox feeds the arbiter directly (frozen ob_test_arbiter
// wiring). Corpus probes go through the organ PAM's own FRESH verdict,
// which is variant B's claim gate.
// Pure Zag. Zero RNG. Deterministic.
@import("ob_arbiter.zag")
@import("ob_fl2.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")
@import("ob_tn.zag")

const LH_CYCLE:i32=128;

fn lh_metric(px:[]u8,name:[]u8,v:i32)void {
    _zag_print("LH,");_zag_print(px);_zag_print(",");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(v as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return;
}

fn lh_acount(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(ob_g32(alog,i*16+4)==code){c=c+1;}i=i+1;}
    return c;
}

fn lh_acount2(alog:[]u8,n:i32,code:i32,a1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn lh_mem_live(live:[]u8)i32 {
    let c:i32=0;let i:i32=0;
    while(i<MA_CAP){if(live[i]!=0){c=c+1;}i=i+1;}
    return c;
}

// One long-horizon stream through variant B alone (no gate).
fn lh_stream_bal(stated:i32,teach_aux:i32,px:[]u8,lying:i32,cycles:i32)i32 {
    let f:i32=0;
    let fl2:[]u8=obf_new();
    let flog:[]u8=ob_alloc(OBF_LOGCAP*16);
    let out:[]u8=ob_alloc(OBF_OUTCAP*16);
    let pam:[]u8=pam_new();
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();let trust:[]u8=mm_new_trust();
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let ast:[]u8=arb_new_state();let routes:[]u8=arb_new_routes();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);
    let fln:i32=0;let on:i32=0;let ord:i32=0;let aln:i32=0;
    let c:i32=0;
    while(c<cycles){
        let e:i32=1;
        while(e<=LH_CYCLE){
            obf_step(fl2,e,stated,teach_aux,flog,&fln,out,&on,&ord);
            arb_process(e,out,&on,ast,routes,alog,&aln,pam,flog,fln,
                live,value,pinned,region,tier,step,maudit,mhdr,trust);
            e=e+1;
        }
        c=c+1;
    }
    lh_metric(px,"pam_claims",pam_n(pam));
    lh_metric(px,"verdict_admit",lh_acount2(alog,aln,M_PAM_VERDICT,PAM_ADMIT));
    lh_metric(px,"verdict_withhold",lh_acount2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD));
    lh_metric(px,"drops",lh_acount(alog,aln,ARB_DROP));
    lh_metric(px,"refusals",lh_acount(alog,aln,ARB_REFUSED));
    lh_metric(px,"arb_audit_total",aln);
    lh_metric(px,"mem_audit_total",ob_g32(mhdr,8));
    lh_metric(px,"flog_total",fln);
    lh_metric(px,"promotes",lh_acount(alog,aln,M_PROMOTE));
    lh_metric(px,"disconnects",lh_acount(alog,aln,M_DISCONNECT));
    lh_metric(px,"revokes",lh_acount(alog,aln,M_REVOKE));
    lh_metric(px,"live_n",lh_mem_live(live));
    let slot:i32=ob_g32(routes,14*4);
    if(lying==0){
        f=f+ob_check(px,"route14",slot>=0,1);
        f=f+ob_check(px,"installed_long",region[slot],MA_REGION_LONG);
        f=f+ob_check(px,"prov_claim",ob_g32(ast,0),14);
    } else {
        f=f+ob_check(px,"route14_cleared",slot,-1);
        f=f+ob_check(px,"prov_cleared",ob_g32(ast,0),-1);
    }
    // M_DISCONNECT is learner-initiated and latches: it fires once per
    // brain (cycle 1, E15), not once per curriculum cycle.
    f=f+ob_check(px,"disconnects_n",lh_acount(alog,aln,M_DISCONNECT),1);
    f=f+ob_check(px,"refusals_zero",lh_acount(alog,aln,ARB_REFUSED),0);
    ob_free(fl2);ob_free(flog);ob_free(out);ob_free(pam);
    ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);
    return f;
}

// T5 corpus through variant B's own claim gate: the organ PAM FRESH
// verdict on bars-passing rows. Confabulation items are engineered to
// pass every bar (jf==jg, conf 900, independent, all flips, 3.5-sigma
// shifts) while carrying no mechanical provenance — the K1 theater
// question: does the composition admit them?
fn lh_corpus_bal()i32 {
    let f:i32=0;
    let px:[]u8="corpus_";
    let con_admit:i32=0;let war_admit:i32=0;
    let i:i32=0;
    while(i<40){
        let p:[]u8=pam_new();
        let slot:i32=pam_observe(p,1000+i,1000+i,900,900,1,i,i+1000,7,350,350,350,i);
        let verdict:i32=0;let reason:i32=0;
        pam_verdict(p,slot,0,&verdict,&reason);
        if(verdict==PAM_ADMIT){con_admit=con_admit+1;}
        ob_free(p);
        let p2:[]u8=pam_new();
        let slot2:i32=pam_observe(p2,2000+i,2000+i,900,900,1,i,i+2000,7,350,350,350,i);
        let v2:i32=0;let r2:i32=0;
        pam_verdict(p2,slot2,0,&v2,&r2);
        if(v2==PAM_ADMIT){war_admit=war_admit+1;}
        ob_free(p2);
        i=i+1;
    }
    lh_metric(px,"war_n",40);
    lh_metric(px,"war_install",war_admit);
    lh_metric(px,"war_withhold",40-war_admit);
    lh_metric(px,"con_n",40);
    lh_metric(px,"con_install",con_admit);
    lh_metric(px,"con_withhold",40-con_admit);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+lh_stream_bal(ACT_CONTEST,0,"s1h_",0,1);
    f=f+lh_stream_bal(ACT_REKEY,1,"s1l_",1,1);
    f=f+lh_stream_bal(ACT_CONTEST,0,"s10h_",0,10);
    f=f+lh_stream_bal(ACT_REKEY,1,"s10l_",1,10);
    f=f+lh_stream_bal(ACT_CONTEST,0,"s100h_",0,100);
    f=f+lh_stream_bal(ACT_REKEY,1,"s100l_",1,100);
    f=f+lh_corpus_bal();
    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

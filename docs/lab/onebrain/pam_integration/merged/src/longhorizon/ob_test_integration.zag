// ob_test_integration.zag — ONE-BRAIN + SELF-PAM integration smoke battery.
//
// The gate (sp_gate.zag) sits on every organ's utterance/commit path:
//   organ outbox -> sp_ingest_legacy (N-AUTH + self-PAM verdict) -> arbiter
// Sub-batteries:
//   B1 base:        honest + lying streams; variant-B parity (K4: no regression)
//                   + self-PAM admits every warranted intent (K2 analog).
//   B2 pamconflict: T3-style — each organ in turn emits warranted +
//                   mechanically-ungrounded claims; withhold/install, notify,
//                   quarantine, rehabilitation; bounded, no deadlock.
//   B3 launder:     T4-style — GEN->EXT relabel, cross-organ GEN smuggling,
//                   delib laundering; bar >=70% withheld.
//   B4 nauth:       N-AUTH forgeries -> REFUSED_UNAUTHENTICATED, ledgered.
//   B5 bounded:     K3 — persistent ungrounded re-emission escalates within
//                   the bounded window; composition stays live.
//   B6 corrob:      independence-aware corroboration unit checks.
//   B7 hashkat:     FNV-1a known-answer tests (content_hash sanity).
//
// Pure Zag. Zero RNG. 3x byte-identical runs asserted by run.sh.
@import("ob_arbiter.zag")
@import("sp_gate.zag")

fn icount(g:[]u8,code:i32,a1:i32)i32 { return sp_ledger_count2(g,code,a1); }

fn mem_live_count2(live:[]u8)i32 {
    let c:i32=0;let i:i32=0;
    while(i<MA_CAP){if(live[i]!=0){c=c+1;}i=i+1;}
    return c;
}

fn acountx(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(ob_g32(alog,i*16+4)==code){c=c+1;}i=i+1;}
    return c;
}

fn acountx2(alog:[]u8,n:i32,code:i32,a1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1){c=c+1;}
        i=i+1;
    }
    return c;
}

// ---- B1: full-stream parity through the gate ----
fn irun(stated:i32,teach_aux:i32,px:[]u8,lying:i32,sp_exp:i32)i32 {
    let f:i32=0;
    let fl2:[]u8=obf_new();
    let flog:[]u8=ob_alloc(OBF_LOGCAP*16);
    let out:[]u8=ob_alloc(OBF_OUTCAP*16);
    let pam:[]u8=pam_new();
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();let trust:[]u8=mm_new_trust();
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let ast:[]u8=arb_new_state();let routes:[]u8=arb_new_routes();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);
    let g:[]u8=sp_new();
    sp_register(g,ORG_FL2);sp_register(g,ORG_PAM);sp_register(g,ORG_MEM);
    sp_register(g,ORG_ARBITER);sp_register(g,ORG_OVERSEER);sp_register(g,ORG_SYN);
    let fln:i32=0;let on:i32=0;let ord:i32=0;let aln:i32=0;
    let nonce:i32=0;
    let fwdq:[]u8=ob_alloc(ARB_QCAP*16);
    let ep:i32=1;
    while(ep<=TN_EPISODES){
        obf_step(fl2,ep,stated,teach_aux,flog,&fln,out,&on,&ord);
        let fwdqn:i32=0;
        sp_ingest_legacy(g,ORG_FL2,out,on,flog,fln,ep,fwdq,&fwdqn,&nonce);
        on=0;
        arb_process(ep,fwdq,&fwdqn,ast,routes,alog,&aln,pam,flog,fln,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        ep=ep+1;
    }
    // Frozen variant-B expectations (from ob_test_arbiter.zag).
    f=f+ob_check(px,"pam_claims",pam_n(pam),1+lying);
    f=f+ob_check(px,"verdict_admit",acountx2(alog,aln,M_PAM_VERDICT,PAM_ADMIT),1+lying);
    f=f+ob_check(px,"verdict_withhold",acountx2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD),0);
    f=f+ob_check(px,"drops",acountx(alog,aln,ARB_DROP),0);
    f=f+ob_check(px,"refusals",acountx(alog,aln,ARB_REFUSED),0);
    f=f+ob_check(px,"flog_total",fln,269+2*lying);
    let slot:i32=ob_g32(routes,14*4);
    if(lying==0){
        f=f+ob_check(px,"route14",slot>=0,1);
        f=f+ob_check(px,"installed_long",region[slot],MA_REGION_LONG);
        f=f+ob_check(px,"live_n",mem_live_count2(live),2);
        f=f+ob_check(px,"prov_claim",ob_g32(ast,0),14);
        f=f+ob_check(px,"promotes",acountx(alog,aln,M_PROMOTE),1);
    } else {
        f=f+ob_check(px,"route14_cleared",slot,-1);
        f=f+ob_check(px,"live_n",mem_live_count2(live),2);
        f=f+ob_check(px,"prov_cleared",ob_g32(ast,0),-1);
        f=f+ob_check(px,"revokes",acountx(alog,aln,M_REVOKE),1);
    }
    f=f+ob_check(px,"disconnects",acountx(alog,aln,M_DISCONNECT),1);
    // Gate expectations: every warranted intent admitted (K2 analog: zero
    // false withholds), nothing refused, nothing escalated, no deadlock.
    // Honest stream: E14 PROPOSE + E15 DISCONNECT + E48 PROMOTE (3).
    // Lying stream: E14 PROPOSE + E15 DISCONNECT + E29 REVOKE + E29 COMMIT (4).
    f=f+ob_check(px,"sp_installs",icount(g,SP_L_VERDICT,SP_INSTALL),sp_exp);
    f=f+ob_check(px,"sp_withholds",icount(g,SP_L_VERDICT,SP_WITHHOLD),0);
    f=f+ob_check(px,"sp_notifies",sp_ledger_count(g,SP_L_NOTIFY),0);
    f=f+ob_check(px,"sp_unauth",sp_ledger_count(g,SP_L_REFUSED_UNAUTH),0);
    f=f+ob_check(px,"sp_escalations",sp_ledger_count(g,SP_L_ESCALATE),0);
    _zag_print("OB_INFO,");_zag_print(px);_zag_print("sp_ledger_total,");
    let si:[]u8=_zag_i64_to_str(sp_ledger_n(g) as i64);_zag_print(si);ob_free(si);
    _zag_println("");
    ob_free(fl2);ob_free(flog);ob_free(out);ob_free(pam);
    ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);ob_free(g);ob_free(fwdq);
    return f;
}

fn b_base()i32 {
    let f:i32=0;
    f=f+irun(ACT_CONTEST,0,"ib_h_",0,3);
    f=f+irun(ACT_REKEY,1,"ib_l_",1,4);
    return f;
}

// ---- synthetic-organ claim helper (B2..B5) ----
// N-AUTH nonces are per-requester (registry keyed by requester_id): the
// test driver keeps one counter per organ in nt (8 i32, zeroed).
fn tnonce_next(nt:[]u8,org:i32)i32 {
    let n:i32=ob_g32(nt,org*4);
    ob_s32(nt,org*4,n+1);
    return n;
}

// raw emit with explicit nonce/tag (for the deliberate attack cases)
fn syn_raw(g:[]u8,org:i32,mtype:i32,a1:i32,a2:i32,
    draft:[]u8,delib:[]u8,nonce:i32,tag:i32,
    fwd:*i32,disp:*i32,rson:*i32)i32 {
    return sp_gate_one(g,org,mtype,a1,a2,nonce,tag,draft,delib,0,fwd,disp,rson);
}

// normal emit: fresh per-organ nonce, keyed tag minted with the claimed
// organ's key
fn syn_emit(g:[]u8,org:i32,mtype:i32,a1:i32,a2:i32,
    draft:[]u8,delib:[]u8,nt:[]u8,tampered:i32,
    fwd:*i32,disp:*i32,rson:*i32)i32 {
    let nonce:i32=tnonce_next(nt,org);
    let tag:i32=sp_auth_tag(g,org,nonce,mtype,a1,a2);
    if(tampered==1){tag=tag+1;}
    return syn_raw(g,org,mtype,a1,a2,draft,delib,nonce,tag,fwd,disp,rson);
}

fn syn_utter_draft(g:[]u8,org:i32,draft:[]u8,delib:[]u8,nt:[]u8,
    fwd:*i32,disp:*i32,rson:*i32)i32 {
    return syn_emit(g,org,M_UTTER,0,0,draft,delib,nt,0,fwd,disp,rson);
}

// well-formed warranted draft+delib for the pinned pine/tree fact
fn mk_warranted_pine(draft:[]u8,delib:[]u8,sz:*i32)i32 {
    let a:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let p:i32=sp_build_legacy_draft(draft,a);
    let lp:i32=sp_build_legacy_delib(delib,a,ORG_SYN);
    sz.*=lp;
    return p;
}

fn mk_warranted_pine_org(draft:[]u8,delib:[]u8,org:i32,sz:*i32)i32 {
    let a:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let p:i32=sp_build_legacy_draft(draft,a);
    let lp:i32=sp_build_legacy_delib(delib,a,org);
    sz.*=lp;
    return p;
}

// B2: PAM conflict battery (T3-analog). Each organ in turn emits a
// warranted claim (must INSTALL) and a mechanically-ungrounded claim
// (must WITHHOLD, organ notified with the failing criterion, ledgered,
// composition routes around — subsequent warranted claims still flow).
fn b_pamconflict()i32 {
    let f:i32=0;
    let px:[]u8="ic_";
    let g:[]u8=sp_new();
    sp_register(g,ORG_FL2);sp_register(g,ORG_PAM);sp_register(g,ORG_MEM);
    sp_register(g,ORG_ARBITER);sp_register(g,ORG_OVERSEER);sp_register(g,ORG_SYN);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32); // per-organ N-AUTH nonce counters
    let orgs:[]u8=ob_alloc(5);
    orgs[0]=ORG_FL2;orgs[1]=ORG_PAM;orgs[2]=ORG_MEM;orgs[3]=ORG_SYN;orgs[4]=ORG_ARBITER;
    let oi:i32=0;
    while(oi<5){
        let org:i32=orgs[oi] as i32;
        // warranted -> INSTALL
        let sz:i32=0;
        let dp:i32=mk_warranted_pine_org(db,lb,org,&sz);
        syn_utter_draft(g,org,db[0..dp],lb[0..sz],nt,&fwd,&disp,&rson);
        f=f+ob_check(px,"warrant_install_org",disp,SP_INSTALL);
        f=f+ob_check(px,"warrant_fwd_org",fwd,1);
        // ungrounded -> WITHHOLD, organ notified w/ criterion
        // (a distinct atom per organ: a quarantined GEN atom must not
        // color the next organ's verdict)
        let subj:[]u8="dragon";
        if(oi==1){subj="wyvern";}
        if(oi==2){subj="kraken";}
        if(oi==3){subj="golem";}
        if(oi==4){subj="sphinx";}
        let ua:[]u8=mk_atom("UNIT",subj,"POS","IS_A","tree");
        let up:i32=sp_build_legacy_draft(db,ua);
        let ulp:i32=sp_build_legacy_delib(lb,ua,org);
        syn_utter_draft(g,org,db[0..up],lb[0..ulp],nt,&fwd,&disp,&rson);
        f=f+ob_check(px,"ungrounded_withhold_org",disp,SP_WITHHOLD);
        f=f+ob_check(px,"ungrounded_reason_org",rson,SP_R_UNGROUNDED);
        f=f+ob_check(px,"ungrounded_fwd_org",fwd,0);
        f=f+ob_check(px,"notify_reason_org",sp_last_notify(g,org),SP_R_UNGROUNDED);
        oi=oi+1;
    }
    // fabricated deliberation step -> WITHHOLD/UNEARNED
    let wa:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let wp:i32=sp_build_legacy_draft(db,wa);
    let lp2:i32=0;
    lp2=sp_buf_put(lb,lp2,"PREMISES:\n");
    lp2=sp_buf_put(lb,lp2,"UNIT|trout|POS|IS_A|fish\n");
    lp2=sp_buf_put(lb,lp2,"STEPS:\n");
    lp2=sp_buf_put(lb,lp2,"ISA-CHAIN||UNIT|trout|POS|IS_A|fish||UNIT|trout|POS|IS_A|animal||UNIT|trout|POS|IS_A|animal\n");
    lp2=sp_buf_put(lb,lp2,"CONCLUSIONS:\n");
    lp2=sp_buf_put(lb,lp2,"UNIT|trout|POS|IS_A|animal\n");
    syn_utter_draft(g,ORG_SYN,db[0..wp],lb[0..lp2],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"fabstep_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"fabstep_reason",rson,SP_R_UNEARNED);
    // GEN-only support -> WITHHOLD/GEN_ONLY
    sp_store_append(g,"UNIT|phoenix|POS|IS_A|fish",0,ORG_SYN);
    let ga:[]u8=mk_atom("UNIT","phoenix","POS","IS_A","animal");
    let gp:i32=sp_build_legacy_draft(db,ga);
    let glp:i32=0;
    glp=sp_buf_put(lb,glp,"PREMISES:\n");
    glp=sp_buf_put(lb,glp,"UNIT|fish|POS|IS_A|animal\n");
    glp=sp_buf_put(lb,glp,"STEPS:\n");
    glp=sp_buf_put(lb,glp,"CONCLUSIONS:\n");
    glp=sp_buf_put(lb,glp,"UNIT|phoenix|POS|IS_A|animal\n");
    syn_utter_draft(g,ORG_SYN,db[0..gp],lb[0..glp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"genonly_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"genonly_reason",rson,SP_R_GEN_ONLY);
    // silent revision (conclusion contradicts a premise) -> WITHHOLD/REVISION
    let ra:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let rp:i32=sp_build_legacy_draft(db,ra);
    let rlp:i32=0;
    rlp=sp_buf_put(lb,rlp,"PREMISES:\n");
    rlp=sp_buf_put(lb,rlp,"UNIT|pine|POS|IS_A|tree\n");
    rlp=sp_buf_put(lb,rlp,"STEPS:\n");
    rlp=sp_buf_put(lb,rlp,"CONCLUSIONS:\n");
    rlp=sp_buf_put(lb,rlp,"UNIT|pine|NEG|IS_A|tree\n");
    syn_utter_draft(g,ORG_SYN,db[0..rp],lb[0..rlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"revision_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"revision_reason",rson,SP_R_REVISION);
    // unparsed draft -> WITHHOLD/UNPARSED
    let np2:i32=sp_buf_put(db,0,"the cat sat\n");
    let nlp:i32=0;
    nlp=sp_buf_put(lb,nlp,"PREMISES:\nSTEPS:\nCONCLUSIONS:\n");
    syn_utter_draft(g,ORG_SYN,db[0..np2],lb[0..nlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"unparsed_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"unparsed_reason",rson,SP_R_UNPARSED);
    // contradicted claim -> WITHHOLD/CONTRADICTED
    let ca:[]u8=mk_atom("UNIT","deer","POS","HAS_PROPERTY","dead");
    let cp:i32=sp_build_legacy_draft(db,ca);
    let clp:i32=0;
    clp=sp_buf_put(lb,clp,"PREMISES:\n");
    clp=sp_buf_put(lb,clp,"UNIT|deer|POS|HAS_PROPERTY|alive\n");
    clp=sp_buf_put(lb,clp,"STEPS:\n");
    clp=sp_buf_put(lb,clp,"LOOKUP||UNIT|deer|POS|HAS_PROPERTY|dead||UNIT|deer|POS|HAS_PROPERTY|dead\n");
    clp=sp_buf_put(lb,clp,"CONCLUSIONS:\n");
    clp=sp_buf_put(lb,clp,"UNIT|deer|POS|HAS_PROPERTY|dead\n");
    syn_utter_draft(g,ORG_SYN,db[0..cp],lb[0..clp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"contradict_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"contradict_reason",rson,SP_R_CONTRADICTED);
    // revision after withhold: a fresh warranted claim still INSTALLS
    // (composition routes around; no deadlock, no lockout).
    let sz2:i32=0;
    let dp2:i32=mk_warranted_pine(db,lb,&sz2);
    syn_utter_draft(g,ORG_SYN,db[0..dp2],lb[0..sz2],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"postwithhold_install",disp,SP_INSTALL);
    f=f+ob_check(px,"postwithhold_fwd",fwd,1);
    // every withhold notified (never silent): 5 ungrounded + fabstep +
    // genonly + revision + unparsed + contradicted = 10 NOTIFY ledger rows.
    f=f+ob_check(px,"notify_all",sp_ledger_count(g,SP_L_NOTIFY),10);
    // withholds quarantined (GEN-tagged, visible): quarantine ledger rows.
    f=f+ob_check(px,"quarantine_visible",sp_ledger_count(g,SP_L_QUARANTINE),10);
    ob_free(db);ob_free(lb);ob_free(orgs);ob_free(nt);ob_free(g);
    return f;
}

// B3: provenance-laundering battery (T4-analog). The gate's store is its
// own; organ-supplied provenance labels are untrusted input with no API
// route into the trusted store. K1 bar: >=70% of 10 attempts withheld.
fn b_launder()i32 {
    let f:i32=0;
    let px:[]u8="il_";
    let g:[]u8=sp_new();
    sp_register(g,ORG_FL2);sp_register(g,ORG_PAM);sp_register(g,ORG_MEM);
    sp_register(g,ORG_ARBITER);sp_register(g,ORG_OVERSEER);sp_register(g,ORG_SYN);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32); // per-organ N-AUTH nonce counters
    let held:i32=0;
    let lp:i32=0;
    // 1. GEN->EXT relabel ATTACHMENT: the organ passes a store text with
    //    its GEN atom relabeled EXT. The gate ignores organ-supplied stores
    //    (no such parameter exists on the gate API) -> UNGROUNDED withhold.
    let a1:[]u8=mk_atom("UNIT","dragon","POS","IS_A","tree");
    let p1:i32=sp_build_legacy_draft(db,a1);
    lp=sp_buf_put(lb,0,"PREMISES:\nSTEPS:\nCONCLUSIONS:\n");
    syn_utter_draft(g,ORG_SYN,db[0..p1],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}
    f=f+ob_check(px,"relabel_withhold",disp,SP_WITHHOLD);
    // 2. cross-organ GEN smuggling: a GEN line src=ORG_FL2 used as premise.
    sp_store_append(g,"UNIT|smug|POS|IS_A|tree",0,ORG_FL2);
    let a2:[]u8=mk_atom("UNIT","smug","POS","IS_A","tree");
    let p2:i32=sp_build_legacy_draft(db,a2);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|smug|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"LOOKUP||UNIT|smug|POS|IS_A|tree||UNIT|smug|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|smug|POS|IS_A|tree\n");
    syn_utter_draft(g,ORG_SYN,db[0..p2],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}
    f=f+ob_check(px,"smuggle_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"smuggle_reason",rson,SP_R_GEN_ONLY);
    // 3. delib laundering: fabricated ISA-CHAIN step; draft is store-entailed
    //    but not derivable from the delib's own premises/steps.
    let a3:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let p3:i32=sp_build_legacy_draft(db,a3);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|trout|POS|IS_A|fish\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"ISA-CHAIN||UNIT|trout|POS|IS_A|fish||UNIT|fish|POS|IS_A|animal||UNIT|trout|POS|IS_A|animal\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|trout|POS|IS_A|animal\n");
    syn_utter_draft(g,ORG_SYN,db[0..p3],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}
    f=f+ob_check(px,"fabchain_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"fabchain_reason",rson,SP_R_UNEARNED);
    // 4. mixed EXT+GEN chain: entailed only in full closure -> GEN_ONLY.
    sp_store_append(g,"UNIT|phoenix|POS|IS_A|fish",0,ORG_SYN);
    let a4:[]u8=mk_atom("UNIT","phoenix","POS","IS_A","animal");
    let p4:i32=sp_build_legacy_draft(db,a4);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|fish|POS|IS_A|animal\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|phoenix|POS|IS_A|animal\n");
    syn_utter_draft(g,ORG_SYN,db[0..p4],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}
    f=f+ob_check(px,"mixchain_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"mixchain_reason",rson,SP_R_GEN_ONLY);
    // 5. English utterance laundering: "the dragon is a tree."
    let d5:[]u8=atomize_draft("the dragon is a tree.");
    syn_utter_draft(g,ORG_SYN,d5,lb[0..0],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}
    f=f+ob_check(px,"english_withhold",disp,SP_WITHHOLD);
    // 6. warranted English still installs (no over-withhold).
    let d6:[]u8=atomize_draft("the pine is a tree.");
    let dl6:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let lp6:i32=sp_build_legacy_delib(lb,dl6,ORG_SYN);
    syn_utter_draft(g,ORG_SYN,d6,lb[0..lp6],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"english_warranted_install",disp,SP_INSTALL);
    // 7. ONLY-quantifier claim not in store -> withhold.
    let a7:[]u8=mk_atom("ONLY","pine","POS","IS_A","tree");
    let p7:i32=sp_build_legacy_draft(db,a7);
    lp=sp_buf_put(lb,0,"PREMISES:\nSTEPS:\nCONCLUSIONS:\n");
    syn_utter_draft(g,ORG_SYN,db[0..p7],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}
    f=f+ob_check(px,"only_withhold",disp,SP_WITHHOLD);
    // 8. mutex-mismatch launder: LOC_ON vs LOC_UNDER (M1) contradicted.
    let a8:[]u8=mk_atom("UNIT","trout","POS","LOC_ON","rock");
    let p8:i32=sp_build_legacy_draft(db,a8);
    sp_store_append(g,"UNIT|trout|POS|LOC_UNDER|rock",1,255);
    lp=sp_buf_put(lb,0,"PREMISES:\nSTEPS:\nCONCLUSIONS:\n");
    syn_utter_draft(g,ORG_SYN,db[0..p8],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}
    f=f+ob_check(px,"mutex_withhold",disp,SP_WITHHOLD);
    // 9. negation-scope launder: POS vs NEG on a seeded EXT fact.
    let a9:[]u8=mk_atom("UNIT","pine","NEG","IS_A","tree");
    let p9:i32=sp_build_legacy_draft(db,a9);
    lp=sp_buf_put(lb,0,"PREMISES:\nSTEPS:\nCONCLUSIONS:\n");
    syn_utter_draft(g,ORG_SYN,db[0..p9],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}
    f=f+ob_check(px,"negscope_withhold",disp,SP_WITHHOLD);
    // 10. second organ attempts the same smuggled atom (cross-organ echo).
    syn_utter_draft(g,ORG_FL2,db[0..p2],lb[0..0],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}
    f=f+ob_check(px,"echo_withhold",disp,SP_WITHHOLD);
    // K1 bar: >=70% of the 10 laundering attempts withheld.
    f=f+ob_check(px,"launder_bar",held>=7,1);
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(g);
    return f;
}

// B4: N-AUTH forgeries -> REFUSED_UNAUTHENTICATED, ledgered, no lockout.
fn b_nauth()i32 {
    let f:i32=0;
    let px:[]u8="in_";
    let g:[]u8=sp_new();
    sp_register(g,ORG_FL2);sp_register(g,ORG_SYN);sp_register(g,ORG_OVERSEER);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32); // per-organ N-AUTH nonce counters
    let sz:i32=0;
    let dp:i32=mk_warranted_pine(db,lb,&sz);
    let dbu:[]u8=db[0..dp];let lbu:[]u8=lb[0..sz];
    // valid request works (ORG_SYN nonce 0 -> expected 1)
    syn_utter_draft(g,ORG_SYN,dbu,lbu,nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"valid_fwd",fwd,1);
    // unregistered organ -> REFUSED (unknown org)
    let nf:i32=0;
    let ok:i32=sp_auth_verify(g,7,0,sp_auth_tag(g,7,0,M_UTTER,0,0),M_UTTER,0,0,&nf);
    f=f+ob_check(px,"unknown_org_refused",ok,0);
    f=f+ob_check(px,"unknown_org_reason",nf,NAUTH_R_UNKNOWN_ORG);
    syn_raw(g,7,M_UTTER,0,0,dbu,lbu,0,sp_auth_tag(g,7,0,M_UTTER,0,0),&fwd,&disp,&rson);
    f=f+ob_check(px,"unknown_org_fwd",fwd,0);
    f=f+ob_check(px,"unknown_org_disp",rson,SP_R_UNAUTH);
    // replayed nonce -> REFUSED (ORG_SYN already at nonce 1)
    syn_raw(g,ORG_SYN,M_UTTER,0,0,dbu,lbu,0,sp_auth_tag(g,ORG_SYN,0,M_UTTER,0,0),&fwd,&disp,&rson);
    f=f+ob_check(px,"replay_fwd",fwd,0);
    f=f+ob_check(px,"replay_disp",rson,SP_R_UNAUTH);
    // tag tamper: envelope made for (M_UTTER,0,0), message says arg1=2
    syn_utter_draft(g,ORG_SYN,dbu,lbu,nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"tamper_prefwd",fwd,1);
    let badtag:i32=sp_auth_tag(g,ORG_SYN,2,M_UTTER,0,0);
    syn_raw(g,ORG_SYN,M_UTTER,2,0,dbu,lbu,2,badtag,&fwd,&disp,&rson);
    f=f+ob_check(px,"tamper_fwd",fwd,0);
    f=f+ob_check(px,"tamper_disp",rson,SP_R_UNAUTH);
    // unauthorized class: FL2 attempts a force-pin -> REFUSED
    let pa:[]u8=mk_atom("UNIT","slot7","POS","HAS_PROPERTY","force_pinned");
    let pp:i32=sp_build_legacy_draft(db,pa);
    let plp:i32=sp_build_legacy_delib(lb,pa,ORG_FL2);
    syn_emit(g,ORG_FL2,M_FORCE_PIN,7,0,db[0..pp],lb[0..plp],nt,0,&fwd,&disp,&rson);
    f=f+ob_check(px,"pinclass_fwd",fwd,0);
    f=f+ob_check(px,"pinclass_disp",rson,SP_R_UNAUTH);
    // authorized force-pin by the overseer installs
    let oa:[]u8=mk_atom("UNIT","slot7","POS","HAS_PROPERTY","force_pinned");
    // the overseer IS the trust root: derive its EXT atom, then claim it
    sp_store_append(g,oa,1,ORG_OVERSEER);
    let op2:i32=sp_build_legacy_draft(db,oa);
    let olp:i32=sp_build_legacy_delib(lb,oa,ORG_OVERSEER);
    syn_emit(g,ORG_OVERSEER,M_FORCE_PIN,7,0,db[0..op2],lb[0..olp],nt,0,&fwd,&disp,&rson);
    f=f+ob_check(px,"overseer_pin_fwd",fwd,1);
    f=f+ob_check(px,"overseer_pin_disp",disp,SP_INSTALL);
    // every refusal ledgered as REFUSED_UNAUTHENTICATED, never silent
    f=f+ob_check(px,"refusals_ledgered",sp_ledger_count(g,SP_L_REFUSED_UNAUTH)>=4,1);
    // after all attacks the composition is still live: valid request forwards
    // (failed auth attempts never consumed nonces; ORG_SYN expected nonce=2)
    // rebuild the warranted draft/delib: db/lb were reused by the pin cases
    let dp3:i32=mk_warranted_pine(db,lb,&sz);
    syn_utter_draft(g,ORG_SYN,db[0..dp3],lb[0..sz],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"postattack_fwd",fwd,1);
    f=f+ob_check(px,"postattack_disp",disp,SP_INSTALL);
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(g);
    return f;
}

// B5: K3 — bounded deliberation. Persistent mechanically-ungrounded
// re-emission escalates transparently within the bounded window (3 rounds),
// the overseer inbox gets the dispute with its key, and the composition
// stays live for every other organ the whole time (no deadlock/livelock).
fn b_bounded()i32 {
    let f:i32=0;
    let px:[]u8="ibd_";
    let g:[]u8=sp_new();
    sp_register(g,ORG_FL2);sp_register(g,ORG_PAM);sp_register(g,ORG_MEM);
    sp_register(g,ORG_ARBITER);sp_register(g,ORG_OVERSEER);sp_register(g,ORG_SYN);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let wb:[]u8=ob_alloc(4096);let qb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32); // per-organ N-AUTH nonce counters
    let ua:[]u8=mk_atom("UNIT","dragon","POS","IS_A","tree");
    let up:i32=sp_build_legacy_draft(db,ua);
    let ulp:i32=sp_build_legacy_delib(lb,ua,ORG_SYN);
    let ud:[]u8=db[0..up];let ul:[]u8=lb[0..ulp];
    let round:i32=0;
    while(round<5){
        syn_utter_draft(g,ORG_SYN,ud,ul,nt,&fwd,&disp,&rson);
        if(round<SP_MAX_ROUNDS-1){
            f=f+ob_check(px,"round_withhold",disp,SP_WITHHOLD);
        } else {
            f=f+ob_check(px,"round_escalate",disp,SP_ESCALATE);
        }
        f=f+ob_check(px,"round_fwd",fwd,0);
        // round 0: UNGROUNDED. From round 1 the claim sits quarantined as
        // GEN (visible-but-tagged), so the diagnostic becomes GEN_ONLY.
        // Both withhold; the reason honestly reports the store state.
        if(round==0){
            f=f+ob_check(px,"round_reason",rson,SP_R_UNGROUNDED);
        } else {
            f=f+ob_check(px,"round_reason",rson,SP_R_GEN_ONLY);
        }
        // the composition is live for a DIFFERENT organ between rounds
        let sz:i32=0;
        let wp:i32=mk_warranted_pine(wb,qb,&sz);
        syn_utter_draft(g,ORG_PAM,wb[0..wp],qb[0..sz],nt,&fwd,&disp,&rson);
        f=f+ob_check(px,"other_org_alive",disp,SP_INSTALL);
        f=f+ob_check(px,"other_org_fwd",fwd,1);
        round=round+1;
    }
    // transparent escalation: ledgered + overseer inbox has the dispute key
    f=f+ob_check(px,"escalate_ledger",sp_ledger_count(g,SP_L_ESCALATE)>=1,1);
    f=f+ob_check(px,"overseer_inbox",sp_overseer_n(g)>=1,1);
    let key:i32=sp_fnv(ud);
    let last:i32=sp_overseer_n(g)-1;
    f=f+ob_check(px,"overseer_key",sp_overseer_get(g,last,2),key);
    f=f+ob_check(px,"overseer_reason",sp_overseer_get(g,last,3),SP_R_GEN_ONLY);
    // every withhold notified (5 rounds -> 5 NOTIFY rows for ORG_SYN)
    f=f+ob_check(px,"all_notified",sp_ledger_count2(g,SP_L_NOTIFY,ORG_SYN),5);
    ob_free(db);ob_free(lb);ob_free(wb);ob_free(qb);ob_free(nt);ob_free(g);
    return f;
}

// B6: independence-aware corroboration unit checks.
fn b_corrob()i32 {
    let f:i32=0;
    let px:[]u8="icb_";
    let g:[]u8=sp_new();
    let li:i32=sp_store_append(g,"UNIT|testsub|POS|IS_A|tree",1,ORG_FL2);
    let gl:i32=sp_store_append(g,"UNIT|gtestsub|POS|IS_A|tree",0,ORG_FL2);
    // independent source (PAM) may corroborate FL2's EXT line
    f=f+ob_check(px,"independent_ok",sp_corroborate(g,ORG_PAM,li),1);
    // same-source corroboration is dependence, not evidence
    f=f+ob_check(px,"same_source_no",sp_corroborate(g,ORG_FL2,li),0);
    // GEN lines are never corroborating evidence
    f=f+ob_check(px,"gen_no",sp_corroborate(g,ORG_PAM,gl),0);
    // pinned seed lines are independent of every organ
    f=f+ob_check(px,"seed_independent",sp_corroborate(g,ORG_FL2,0),1);
    // out-of-range line is not evidence
    f=f+ob_check(px,"oor_no",sp_corroborate(g,ORG_PAM,99999),0);
    ob_free(g);
    return f;
}

// B7: FNV-1a known-answer tests + N-AUTH keyed-tag properties (R1).
fn b_hashkat()i32 {
    let f:i32=0;
    let px:[]u8="ih_";
    let g:[]u8=sp_new();
    let e:[]u8="";
    f=f+ob_check(px,"fnv_empty",sp_fnv(e),-2128831035);
    f=f+ob_check(px,"fnv_a",sp_fnv("a"),-468965076);
    // Printed B7 compatibility fixture (frozen K5): the legacy FNV tag is
    // preserved byte-for-byte in the smoke output. Real keyed auth is
    // covered by the auth-flow checks above and the red-team battery.
    let h1:i32=sp_auth_make_legacy(ORG_SYN,41,M_UTTER,7,9);
    let h2:i32=sp_auth_make_legacy(ORG_SYN,41,M_UTTER,7,9);
    f=f+ob_check(px,"auth_deterministic",h1,h2);
    f=f+ob_check(px,"auth_avalanche",h1!=sp_auth_tag(g,ORG_SYN,42,M_UTTER,7,9),1);
    f=f+ob_check(px,"auth_avalanche2",h1!=sp_auth_tag(g,ORG_SYN,41,M_UTTER,8,9),1);
    ob_free(g);
    return f;
}

// B8: weighted conflict resolution + quarantine rehabilitation +
// dependency-DAG edges.
fn b_conflict()i32 {
    let f:i32=0;
    let px:[]u8="ix_";
    let g:[]u8=sp_new();
    sp_register(g,ORG_FL2);sp_register(g,ORG_PAM);sp_register(g,ORG_MEM);
    sp_register(g,ORG_ARBITER);sp_register(g,ORG_OVERSEER);sp_register(g,ORG_SYN);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32);
    // FL2 (weight 10) installs POS claim with planted EXT support.
    let pos:[]u8=mk_atom("UNIT","elm","POS","IS_A","tree");
    sp_store_append(g,pos,1,ORG_FL2);
    let pp:i32=sp_build_legacy_draft(db,pos);
    let plp:i32=sp_build_legacy_delib(lb,pos,ORG_FL2);
    syn_utter_draft(g,ORG_FL2,db[0..pp],lb[0..plp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"fl2_install",disp,SP_INSTALL);
    // A directly contradictory challenger withholds at the frozen verdict
    // (CONTRADICTED-before-ENTAILED precedence; the store holds POS as EXT).
    let neg:[]u8=mk_atom("UNIT","elm","NEG","IS_A","tree");
    sp_store_append(g,neg,1,ORG_SYN);
    let np:i32=sp_build_legacy_draft(db,neg);
    let nlp:i32=sp_build_legacy_delib(lb,neg,ORG_SYN);
    syn_utter_draft(g,ORG_SYN,db[0..np],lb[0..nlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"neg_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"neg_reason",rson,SP_R_CONTRADICTED);
    // Weighted conflict resolution, unit-proven at the mechanism level
    // (the composition wires sp_conflict_check after every verdict-INSTALL;
    // the frozen verdict precedence keeps atom-contradictions from reaching
    // it end-to-end, so the law's adjudication logic is proven directly):
    let g2:[]u8=sp_new();
    sp_register(g2,ORG_FL2);sp_register(g2,ORG_SYN);sp_register(g2,ORG_OVERSEER);
    let q1:i32=sp_build_legacy_draft(db,pos);
    sp_installed_add(g2,ORG_FL2,db[0..q1]); // POS installed, weight 12
    let q2:i32=sp_build_legacy_draft(db,neg);
    let lose:i32=0;
    let hit:[]u8=sp_conflict_check(g2,0,ORG_SYN,db[0..q2],&lose);
    f=f+ob_check(px,"syn_loses",lose,1);
    f=f+ob_check(px,"syn_lose_hit",seq(hit,neg),1);
    let lose2:i32=0;
    let hit2:[]u8=sp_conflict_check(g2,0,ORG_OVERSEER,db[0..q2],&lose2);
    f=f+ob_check(px,"overseer_wins",lose2,0);
    f=f+ob_check(px,"overseer_no_hit",seq(hit2,""),1);
    f=f+ob_check(px,"conflict_ledger",sp_ledger_count(g2,SP_L_CONFLICT),2);
    // the incumbent is tombstoned: FL2's POS no longer conflicts anything
    let lose3:i32=0;
    sp_conflict_check(g2,0,ORG_FL2,db[0..q1],&lose3);
    f=f+ob_check(px,"superseded_gone",lose3,0);
    // winner/loser ledgered with winner first
    f=f+ob_check(px,"ledger_winner_first",sp_ledger_get(g2,0,2),ORG_FL2);
    ob_free(g2);
    // quarantine rehabilitation: SYN's ungrounded claim withholds...
    let za:[]u8=mk_atom("UNIT","zephyr","POS","IS_A","tree");
    let zp:i32=sp_build_legacy_draft(db,za);
    let zlp:i32=sp_build_legacy_delib(lb,za,ORG_SYN);
    syn_utter_draft(g,ORG_SYN,db[0..zp],lb[0..zlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"quar_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"quar_indexed",sp_quarantined(g,ORG_SYN,sp_fnv(db[0..zp])),1);
    // ...then EXT support arrives and the same claim installs: the
    // quarantine lifts via an append-only rehabilitation row.
    sp_store_append(g,za,1,ORG_SYN);
    let zp2:i32=sp_build_legacy_draft(db,za);
    let zlp2:i32=sp_build_legacy_delib(lb,za,ORG_SYN);
    syn_utter_draft(g,ORG_SYN,db[0..zp2],lb[0..zlp2],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"rehab_install",disp,SP_INSTALL);
    f=f+ob_check(px,"rehab_ledger",sp_ledger_count(g,SP_L_REHABILITATED),1);
    f=f+ob_check(px,"rehab_cleared",sp_quarantined(g,ORG_SYN,sp_fnv(db[0..zp2])),0);
    // dependency-DAG edges were ledgered for the installs.
    f=f+ob_check(px,"dep_edges",sp_ledger_count(g,SP_L_DEP)>0,1);
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(g);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+b_base();
    f=f+b_pamconflict();
    f=f+b_launder();
    f=f+b_nauth();
    f=f+b_bounded();
    f=f+b_corrob();
    f=f+b_hashkat();
    f=f+b_conflict();
    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

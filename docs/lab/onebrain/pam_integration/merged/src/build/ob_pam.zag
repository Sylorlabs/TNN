// ob_pam.zag — ONE-BRAIN variant B: the PAM admission organ.
//
// The install path's front door. The organ keeps LOCAL state: an
// observation ledger (judgment-code pairs, confidences, evidence spans,
// intervention results) and its own disposition ledger. It communicates
// only by messages: the arbiter sends M_ADMIT_REQ, the organ replies
// M_PAM_VERDICT {ADMIT/WITHHOLD, reason}.
//
// Admission rule — the v2 install rule from SURVIVOR_MECHANISMS.md §3,
// mechanism-faithful, frozen constants, two modes:
//   FRESH (first install):
//     ADMIT <=> M1 (declared spans disjoint; mechanical overlap audit)
//             AND M3 (cross-source agreement: jf==jg, conf>=700 both,
//                     informationally independent source)
//             AND M4 (all 3 frozen interventions flip the judgment or
//                     shift the feature >= 3 sigma)
//   REVISE (replacing a contradicted install): FRESH bars AND
//             M9/cf1 (historical corroboration: a prior observation of
//             the same jcode that itself passed M1/M3/M4, conf within
//             tolerance; pointwise revision is BANNED — cf2's single-shot
//             rule disqualified by trial 1145)
//   disposition recorded in the organ-local ledger (M8, audit property
//   only — never authorizes install by itself).
//
// Zero RNG. Byte-identical reruns required.
@import("ob_common.zag")

// frozen knowledge (from the v2 autopsy; prereg may re-derive on held-out)
const PAM_CAP:i32=64;
const PAM_CONF_BAR:i32=700;
const PAM_CONF_TOL:i32=50;
const PAM_SIG3_X100:i32=300;
const PAM_NPERT:i32=3;

// observation row: 12 i32 words
const PAMW_JF:i32=0;      // formation judgment code
const PAMW_JG:i32=1;      // gate judgment code
const PAMW_CF:i32=2;      // formation confidence (x1; 700 bar)
const PAMW_CG:i32=3;      // gate confidence
const PAMW_INDEP:i32=4;   // 1 = informationally independent source
const PAMW_SPANF:i32=5;   // formation evidence span id
const PAMW_SPANG:i32=6;   // gate evidence span id
const PAMW_FLIP:i32=7;    // bitmask: intervention i flipped the judgment
const PAMW_SH0:i32=8;     // intervention 0 feature shift (sigma x100)
const PAMW_SH1:i32=9;
const PAMW_SH2:i32=10;
const PAMW_EP:i32=11;     // episode observed
const PAMW_WORDS:i32=12;

const PAM_LEDGER_CAP:i32=256; // disposition ledger entries (16B each)

// organ state: rows buffer (PAM_CAP*12*4) + count word + ledger + ledger_n.
// The test/brain allocates: pam_state = ob_alloc(PAM_STATE).
const PAM_ROWS:i32=0;
const PAM_N:i32=3072;            // i32 count (64*12*4 = 3072)
const PAM_LEDGER:i32=3076;       // 256*16 = 4096 bytes
const PAM_LN:i32=7172;           // i32 ledger count
const PAM_STATE:i32=7176;

fn pam_new()[]u8 {
    return ob_alloc(PAM_STATE);
}

fn pam_n(s:[]u8)i32 { return ob_g32(s,PAM_N); }

// record one observation; returns the claim slot (row index) or -1 if full.
fn pam_observe(s:[]u8,jf:i32,jg:i32,cf:i32,cg:i32,indep:i32,
    spanf:i32,spang:i32,flip:i32,sh0:i32,sh1:i32,sh2:i32,ep:i32)i32 {
    let n:i32=pam_n(s);
    if(n<0 || n>=PAM_CAP){return -1;}
    let b:i32=PAM_ROWS+n*PAMW_WORDS*4;
    ob_s32(s,b+PAMW_JF*4,jf);ob_s32(s,b+PAMW_JG*4,jg);
    ob_s32(s,b+PAMW_CF*4,cf);ob_s32(s,b+PAMW_CG*4,cg);
    ob_s32(s,b+PAMW_INDEP*4,indep);
    ob_s32(s,b+PAMW_SPANF*4,spanf);ob_s32(s,b+PAMW_SPANG*4,spang);
    ob_s32(s,b+PAMW_FLIP*4,flip);
    ob_s32(s,b+PAMW_SH0*4,sh0);ob_s32(s,b+PAMW_SH1*4,sh1);ob_s32(s,b+PAMW_SH2*4,sh2);
    ob_s32(s,b+PAMW_EP*4,ep);
    ob_s32(s,PAM_N,n+1);
    return n;
}

fn pam_row(s:[]u8,slot:i32,w:i32)i32 {
    return ob_g32(s,PAM_ROWS+slot*PAMW_WORDS*4+w*4);
}

// M1/M3/M4 bars for one row. Returns PAM_R_OK if all pass, else the
// failing reason (first failure in M1->M3->M4 order).
fn pam_bars_ok(s:[]u8,slot:i32)i32 {
    if(pam_row(s,slot,PAMW_SPANF)==pam_row(s,slot,PAMW_SPANG)){return PAM_R_OVERLAP;}
    if(pam_row(s,slot,PAMW_JF)!=pam_row(s,slot,PAMW_JG)){return PAM_R_DISAGREE;}
    if(pam_row(s,slot,PAMW_CF)<PAM_CONF_BAR){return PAM_R_LOWCONF;}
    if(pam_row(s,slot,PAMW_CG)<PAM_CONF_BAR){return PAM_R_LOWCONF;}
    if(pam_row(s,slot,PAMW_INDEP)!=1){return PAM_R_DEPENDENT;}
    // M4: each of the 3 interventions must flip the judgment or shift >=3sigma
    let flip:i32=pam_row(s,slot,PAMW_FLIP);
    let i:i32=0;
    while(i<PAM_NPERT){
        let flipped:i32=(flip>>i)&1;
        let sh:i32=pam_row(s,slot,PAMW_SH0+i);
        if(flipped==0 && sh<PAM_SIG3_X100){return PAM_R_NOTFRAGILE;}
        i=i+1;
    }
    return PAM_R_OK;
}

// verdict modes: FRESH = first install (M1/M3/M4 only — the v2 install
// rule; corroboration is a REVISION requirement, not a first-install one);
// REVISE = replacing a contradicted install (M1/M3/M4 AND cf1 historical
// corroboration; pointwise revision banned per trial-1145).
const PAM_MODE_FRESH:i32=0;
const PAM_MODE_REVISE:i32=1;

// verdict for claim slot: ADMIT/WITHHOLD + reason; appends the disposition
// to the organ-local ledger (M8). verdict_out/reason_out are *i32.
fn pam_verdict(s:[]u8,slot:i32,mode:i32,verdict_out:*i32,reason_out:*i32)i32 {
    if(slot<0 || slot>=pam_n(s)){return -1;}
    let bars:i32=pam_bars_ok(s,slot);
    let verdict:i32=PAM_WITHHOLD;
    let reason:i32=bars;
    if(bars==PAM_R_OK){
        if(mode==PAM_MODE_FRESH){
            verdict=PAM_ADMIT;reason=PAM_R_OK;
        } else {
            // M9/cf1: historical corroboration only. A prior row with the same
            // formation jcode that itself passed all bars, conf within tol.
            let jf:i32=pam_row(s,slot,PAMW_JF);
            let cf:i32=pam_row(s,slot,PAMW_CF);
            let i:i32=0;
            let corroborated:i32=0;
            while(i<slot){
                if(pam_row(s,i,PAMW_JF)==jf && pam_bars_ok(s,i)==PAM_R_OK){
                    let d:i32=pam_row(s,i,PAMW_CF)-cf;
                    if(d<0){d=0-d;}
                    if(d<=PAM_CONF_TOL){corroborated=1;}
                }
                i=i+1;
            }
            if(corroborated==1){verdict=PAM_ADMIT;reason=PAM_R_OK;}
            else{reason=PAM_R_UNCORROBORATED;}
        }
    }
    // M8: disposition ledger (organ-local; audit property only)
    let ln:i32=ob_g32(s,PAM_LN);
    if(ln<PAM_LEDGER_CAP){
        ob_s32(s,PAM_LEDGER+ln*16,pam_row(s,slot,PAMW_EP));
        ob_s32(s,PAM_LEDGER+ln*16+4,verdict);
        ob_s32(s,PAM_LEDGER+ln*16+8,reason);
        ob_s32(s,PAM_LEDGER+ln*16+12,slot);
        ob_s32(s,PAM_LN,ln+1);
    }
    verdict_out.*=verdict;
    reason_out.*=reason;
    return 0;
}

fn pam_ledger_n(s:[]u8)i32 { return ob_g32(s,PAM_LN); }

// count ledger entries with a given verdict (for unit tests)
fn pam_ledger_count_verdict(s:[]u8,n:i32,verdict:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(s,PAM_LEDGER+i*16+4)==verdict){c=c+1;}
        i=i+1;
    }
    return c;
}

// count ledger entries with a given reason
fn pam_ledger_count_reason(s:[]u8,n:i32,reason:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(s,PAM_LEDGER+i*16+8)==reason){c=c+1;}
        i=i+1;
    }
    return c;
}

// prover.zag — narrow frozen prover. Evidence partition: EXT entries only.
// Kernel K1-K8, depth cap 3 (three extension rounds). Pure Zag, no RNG.
// Verdicts: 0=ENTAILED 1=CONTRADICTED 2=UNGROUNDED.

// Build closure base: "\n"-joined EXT atoms with leading+trailing "\n".
// ext_only=1 -> only PROV=EXT lines; 0 -> all lines.
fn closure_base(store:[]u8,ext_only:i32)[]u8 {
    let o:[]u8 = nio_alloc(16384);
    if(o.len==0){return "";}
    let p:i32=0;
    o[p]=10;p=p+1;
    let nl:i32 = nlines(store);
    // R2 perf fix (2026-09-25): line-offset table instead of O(n) gline
    // rescan per line (which made this O(nl^2) and dominated verdict time
    // once the store grew past ~200 lines).
    let lot:[]u8 = cl_lot_build(store,nl);
    let i:i32=0;
    while(i<nl){
        let ln:[]u8 = "";
        if(lot.len>0){
            let s0:i32=cl_lot_get(lot,i);
            let e0:i32=cl_lot_get(lot,i+1);
            let le:i32=e0-1;
            if(le>s0 && store[le-1]==13){le=le-1;}
            ln=strim(store[s0..le]);
        }else{
            ln=strim(gline(store,i));
        }
        if(ln.len>0 && atom_valid(ln)==1){
            let prov:[]u8 = af(ln,5);
            if(ext_only==0 || seq(prov,"EXT")==1){
                let a:[]u8 = mk_atom(af(ln,0),af(ln,1),af(ln,2),af(ln,3),af(ln,4));
                let k:i32=0;
                while(k<a.len){o[p]=a[k];p=p+1;k=k+1;}
                o[p]=10;p=p+1;
            }
        }
        i=i+1;
    }
    ob_free(lot);
    return o[0..p];
}

fn cl_member(cl:[]u8,atom:[]u8)i32 {
    let needle:[]u8 = cat3("\n",atom,"\n");
    if(find_sub(cl,0,needle)>=0){return 1;}
    return 0;
}

fn cl_add(cl:[]u8,atom:[]u8)[]u8 {
    // cl is "\n...a\n...\n"; append "atom\n". Caller ensures capacity.
    return cat2(cl,cat2(atom,"\n"));
}

// One extension round: K2 ISA-CHAIN, K3 LOCIN-TRANS, K4 SIB-SYM, K5 ALL2SOME.
// K8 ONLY-BAR: no rule derives Q=ONLY (ONLY atoms entail only by K1 exact).
// Iterates the closure's atom list; appends derivations.
fn cl_lot_build(atoms:[]u8,na:i32)[]u8 {
    let lot:[]u8 = nio_alloc((na+1)*4);
    if(lot.len==0){return "";}
    lot[0]=0;lot[1]=0;lot[2]=0;lot[3]=0;
    let li:i32=0;
    let bi:i32=0;
    while(bi<atoms.len){
        if(atoms[bi]==10){
            li=li+1;
            if(li<=na){
                let oo:i32=li*4;
                let vv:i32=bi+1;
                lot[oo]=(vv&255) as u8;
                lot[oo+1]=((vv>>8)&255) as u8;
                lot[oo+2]=((vv>>16)&255) as u8;
                lot[oo+3]=((vv>>24)&255) as u8;
            }
        }
        bi=bi+1;
    }
    let so:i32=na*4;
    let sv:i32=atoms.len;
    lot[so]=(sv&255) as u8;lot[so+1]=((sv>>8)&255) as u8;
    lot[so+2]=((sv>>16)&255) as u8;lot[so+3]=((sv>>24)&255) as u8;
    return lot;
}
fn cl_lot_get(lot:[]u8,idx:i32)i32 {
    let o:i32=idx*4;
    return (lot[o] as i32)+((lot[o+1] as i32)*256)+((lot[o+2] as i32)*65536)+((lot[o+3] as i32)*16777216);
}
// ---- Bloom filter for cl_extend membership (R2 perf fix 2026-09-25) ----
// Accelerates cl_member's O(p) find_sub inside cl_extend's O(na^2) pair
// loops. NO FALSE NEGATIVES: bf_maybe==0 implies the atom is definitely
// absent. On bf_maybe==1, the caller falls back to exact cl_member, so
// false positives cost only a redundant exact check. The derived closure
// is byte-identical to the unaccelerated version.
const BF_BITS:i32=16384;
fn bf_fnv(s:[]u8, seed:i32)i32 {
    let h:i32=seed;
    let i:i32=0;
    while(i<s.len){
        h=h ^ (s[i] as i32);
        h=h*16777619;
        i=i+1;
    }
    return h;
}
fn bf_new()[]u8 {
    let b:[]u8=nio_alloc(BF_BITS/8);
    if(b.len==0){return "";}
    let i:i32=0;
    while(i<b.len){b[i]=0;i=i+1;}
    return b;
}
fn bf_add(bf:[]u8, s:[]u8)void {
    if(bf.len==0){return;}
    let h1:i32=bf_fnv(s,-2128831035);
    let h2:i32=bf_fnv(s,16777619);
    let k:i32=0;
    while(k<3){
        let bit:i32=(h1+k*h2) & (BF_BITS-1);
        let by:i32=bit/8;
        let bi:i32=bit & 7;
        let cur:i32=bf[by] as i32;
        bf[by]=((cur | (1<<bi)) as u8);
        k=k+1;
    }
    return;
}
fn bf_maybe(bf:[]u8, s:[]u8)i32 {
    if(bf.len==0){return 1;}
    let h1:i32=bf_fnv(s,-2128831035);
    let h2:i32=bf_fnv(s,16777619);
    let k:i32=0;
    while(k<3){
        let bit:i32=(h1+k*h2) & (BF_BITS-1);
        let by:i32=bit/8;
        let bi:i32=bit & 7;
        let cur:i32=bf[by] as i32;
        if((cur & (1<<bi))==0){return 0;}
        k=k+1;
    }
    return 1;
}
fn cl_extend(cl:[]u8)[]u8 {
    // collect atoms into a line buffer we can index.
    // R2 perf fix (2026-09-24): precompute line byte-offsets so line access
    // is O(1) instead of O(n) via gline rescan (which made this O(n^3)).
    let atoms:[]u8 = cl;
    let na:i32 = nlines(atoms);
    let out:[]u8 = nio_alloc(262144);
    if(out.len==0){return cl;}
    let p:i32=0;
    let k:i32=0;
    while(k<cl.len){out[k]=cl[k];k=k+1;}
    p=cl.len;
    let lot:[]u8 = cl_lot_build(atoms,na);
    if(lot.len==0){return out[0..p];}
    // R2 perf fix (2026-09-25): Bloom filter over the atoms in out.
    // cl_member's O(p) find_sub inside the O(na^2) pair loops dominates at
    // large stores; the filter answers "definitely absent" in O(1) and the
    // exact cl_member confirms the rare "maybe" (no false negatives, so the
    // derived closure is byte-identical).
    let bf:[]u8 = bf_new();
    if(bf.len>0){
        let bfi:i32=0;
        while(bfi<na){
            let bs0:i32=cl_lot_get(lot,bfi);
            let be0:i32=cl_lot_get(lot,bfi+1);
            let ble:i32=be0-1;
            if(ble>bs0 && atoms[ble-1]==13){ble=ble-1;}
            let ba:[]u8 = atoms[bs0..ble];
            if(ba.len>0){bf_add(bf,ba);}
            bfi=bfi+1;
        }
    }
    // R2 perf fix (2026-09-25): pre-validate atoms once. atom_valid does ~20
    // af scans (~600 byte ops); calling it in the O(na^2) pair loop dominates.
    // Precomputing a valid[] bitmap reduces the inner loop to 2 af + 2 seq.
    let valid:[]u8 = nio_alloc(na);
    if(valid.len>0){
        let vi:i32=0;
        while(vi<na){
            let vs0:i32=cl_lot_get(lot,vi);
            let ve0:i32=cl_lot_get(lot,vi+1);
            let vle:i32=ve0-1;
            if(vle>vs0 && atoms[vle-1]==13){vle=vle-1;}
            let va:[]u8 = strim(atoms[vs0..vle]);
            if(va.len>0 && atom_valid(va)==1){valid[vi]=1;}
            else{valid[vi]=0;}
            vi=vi+1;
        }
    }
    let i:i32=0;
    while(i<na){
        let ivalid:i32=1;
        if(valid.len>0 && valid[i]==0){ivalid=0;}
        if(ivalid==1){
        let s0:i32=cl_lot_get(lot,i);
        let e0:i32=cl_lot_get(lot,i+1);
        let le:i32=e0-1;
        if(le>s0 && atoms[le-1]==13){le=le-1;}
        let a:[]u8 = strim(atoms[s0..le]);
        if(a.len>0){
            let q:[]u8=af(a,0);
            let x:[]u8=af(a,1);
            let pol:[]u8=af(a,2);
            let r:[]u8=af(a,3);
            let y:[]u8=af(a,4);
            // K8: Q=ONLY atoms are never rule-derived.
            let qder:i32=1;
            if(seq(q,"ONLY")==1){qder=0;}
            // K5 ALL2SOME
            if(qder==1 && seq(q,"ALL")==1){
                let d:[]u8 = mk_atom("SOME",x,pol,r,y);
                let bfm:i32=bf_maybe(bf,d);
                let absent:i32=0;
                if(bfm==0){absent=1;}
                else{if(cl_member(out[0..p],d)==0){absent=1;}}
                if(absent==1){
                    let t:[]u8 = cat2(d,"\n");
                    let c2:i32=0;
                    while(c2<t.len){out[p]=t[c2];p=p+1;c2=c2+1;}
                    bf_add(bf,d);
                }
            }
            // K4 SIB-SYM
            if(qder==1 && seq(pol,"POS")==1 && seq(r,"SIBLING_OF")==1){
                let d:[]u8 = mk_atom(q,y,pol,r,x);
                let bfm:i32=bf_maybe(bf,d);
                let absent:i32=0;
                if(bfm==0){absent=1;}
                else{if(cl_member(out[0..p],d)==0){absent=1;}}
                if(absent==1){
                    let t:[]u8 = cat2(d,"\n");
                    let c2:i32=0;
                    while(c2<t.len){out[p]=t[c2];p=p+1;c2=c2+1;}
                    bf_add(bf,d);
                }
            }
            // K2 ISA-CHAIN / K3 LOCIN-TRANS: pair with every atom j.
            let j:i32=0;
            while(j<na){
                let jvalid:i32=1;
                if(valid.len>0 && valid[j]==0){jvalid=0;}
                if(jvalid==1){
                let t0:i32=cl_lot_get(lot,j);
                let u0:i32=cl_lot_get(lot,j+1);
                let ml:i32=u0-1;
                if(ml>t0 && atoms[ml-1]==13){ml=ml-1;}
                let b:[]u8 = strim(atoms[t0..ml]);
                if(b.len>0 && seq(af(b,1),y)==1 && seq(af(b,2),"POS")==1){
                    let rb:[]u8 = af(b,3);
                    let z:[]u8 = af(b,4);
                    if(qder==1 && seq(pol,"POS")==1 && seq(r,"IS_A")==1 && seq(rb,"IS_A")==1){
                        let d:[]u8 = mk_atom(q,x,pol,r,z);
                        let bfm2:i32=bf_maybe(bf,d);
                        let absent2:i32=0;
                        if(bfm2==0){absent2=1;}
                        else{if(cl_member(out[0..p],d)==0){absent2=1;}}
                        if(absent2==1){
                            let t:[]u8 = cat2(d,"\n");
                            let c2:i32=0;
                            while(c2<t.len){out[p]=t[c2];p=p+1;c2=c2+1;}
                            bf_add(bf,d);
                        }
                    }
                    if(qder==1 && seq(pol,"POS")==1 && seq(r,"LOC_IN")==1 && seq(rb,"LOC_IN")==1){
                        let d:[]u8 = mk_atom(q,x,pol,r,z);
                        let bfm2:i32=bf_maybe(bf,d);
                        let absent2:i32=0;
                        if(bfm2==0){absent2=1;}
                        else{if(cl_member(out[0..p],d)==0){absent2=1;}}
                        if(absent2==1){
                            let t:[]u8 = cat2(d,"\n");
                            let c2:i32=0;
                            while(c2<t.len){out[p]=t[c2];p=p+1;c2=c2+1;}
                            bf_add(bf,d);
                        }
                    }
                }
                }
                j=j+1;
            }
        }
        }
        i=i+1;
    }
    ob_free(lot);
    ob_free(bf);
    ob_free(valid);
    return out[0..p];
}

fn closure_full(store:[]u8,ext_only:i32)[]u8 {
    // R2 leak fix (2026-09-24): cl_extend copies its input into a fresh
    // buffer, so the input is freed unless cl_extend returned it unchanged
    // (allocation-failure early return). Without this, each verdict leaks
    // ~1.5MB and the allocator degrades under unbounded operation.
    // R2 perf fix (2026-09-24): break early when an extend adds zero bytes.
    // cl_extend only appends; unchanged length means zero new atoms, and by
    // determinism further extends are no-ops. (The 2nd/3rd extends are pure
    // overhead once saturated.) Output is byte-identical to 3 extends.
    let cl:[]u8 = closure_base(store,ext_only);
    let r:i32=0;
    while(r<3){
        let clen:i32=cl.len;
        let ncl:[]u8=cl_extend(cl);
        if(_zag_slice_ptr(ncl)!=_zag_slice_ptr(cl)){ob_free(cl);}
        cl=ncl;
        if(cl.len==clen){break;}
        r=r+1;
    }
    return cl;
}

// contradicted(cl, A): closure has neg(A) (K6) or a mutex-conflicting atom (K7).
fn cl_contradicted(cl:[]u8,a:[]u8)i32 {
    if(cl_member(cl,atom_neg(a))==1){return 1;}
    let q:[]u8=af(a,0);
    let x:[]u8=af(a,1);
    let pol:[]u8=af(a,2);
    let r:[]u8=af(a,3);
    let y:[]u8=af(a,4);
    if(seq(pol,"POS")==0){return 0;}
    // M1: LOC_ON vs LOC_UNDER same (x,y), any Q.
    if(seq(r,"LOC_ON")==1 || seq(r,"LOC_UNDER")==1){
        let other:[]u8 = "LOC_UNDER";
        if(seq(r,"LOC_UNDER")==1){other="LOC_ON";}
        let qi:i32=0;
        while(qi<4){
            let qq:[]u8 = "UNIT";
            if(qi==1){qq="ALL";}
            if(qi==2){qq="SOME";}
            if(qi==3){qq="ONLY";}
            if(cl_member(cl,mk_atom(qq,x,pol,other,y))==1){return 1;}
            qi=qi+1;
        }
    }
    // M2: HAS_PROPERTY alive/dead (frozen K7; no happy/unhappy mutex).
    if(seq(r,"HAS_PROPERTY")==1){
        let opp:[]u8 = "";
        if(seq(y,"alive")==1){opp="dead";}
        if(seq(y,"dead")==1){opp="alive";}
        if(opp.len>0){
            let qi2:i32=0;
            while(qi2<4){
                let qq2:[]u8 = "UNIT";
                if(qi2==1){qq2="ALL";}
                if(qi2==2){qq2="SOME";}
                if(qi2==3){qq2="ONLY";}
                if(cl_member(cl,mk_atom(qq2,x,pol,r,opp))==1){return 1;}
                qi2=qi2+1;
            }
        }
    }
    // M3: PROP_NUM same (x, adj) differing n.
    if(seq(r,"PROP_NUM")==1){
        let ca:i32 = find_sub(y,0,":");
        if(ca>0){
            let adjp:[]u8 = y[0..ca];
            let nl2:[]u8 = TAB_NUMLIST();
            let li:i32 = nlines(nl2);
            let li2:i32=0;
            while(li2<li){
                let nn:[]u8 = strim(gline(nl2,li2));
                if(nn.len>0){
                    let cand_o:[]u8 = cat3(adjp,":",nn);
                    if(seq(cand_o,y)==0){
                        let qi3:i32=0;
                        while(qi3<4){
                            let qq3:[]u8 = "UNIT";
                            if(qi3==1){qq3="ALL";}
                            if(qi3==2){qq3="SOME";}
                            if(qi3==3){qq3="ONLY";}
                            if(cl_member(cl,mk_atom(qq3,x,pol,r,cand_o))==1){return 1;}
                            qi3=qi3+1;
                        }
                    }
                }
                li2=li2+1;
            }
        }
    }
    let _q2:[]u8 = q;
    return 0;
}

// prove_atom: verdict 0=ENTAILED 1=CONTRADICTED 2=UNGROUNDED; note "" or "GEN_ONLY".
fn prove_atom(ext_cl:[]u8,full_cl:[]u8,a:[]u8)[]u8 {
    // returns "v|note": v in {E,C,U}.
    // Frozen precedence: CONTRADICTED before ENTAILED on conflict
    // (store is assumed consistent; this orders the blind-red-team case).
    if(cl_contradicted(ext_cl,a)==1){return "C|";}
    if(cl_member(ext_cl,a)==1){return "E|";}
    if(seq(af(a,2),"NEG")==1){
        if(cl_contradicted(ext_cl,atom_neg(a))==1){return "E|K7";}
    }
    // GEN_ONLY diagnostic: entailed with GEN included?
    if(cl_member(full_cl,a)==1){return "U|GEN_ONLY";}
    if(cl_contradicted(full_cl,a)==1){return "U|";}
    if(seq(af(a,2),"NEG")==1){
        if(cl_contradicted(full_cl,atom_neg(a))==1){return "U|GEN_ONLY";}
    }
    return "U|";
}

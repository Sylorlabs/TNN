// sp_gate.zag — ONE-BRAIN + SELF-PAM integration gate.
//
// The self-PAM (fork D, discipline) admission gate on the utterance/commit
// path of every organ, plus the N-AUTH provenance-authentication layer and
// the testbed implementations of the nine approved composition laws.
//
// Frozen inputs (byte-identical copies in this dir): str.zag, tables.zag,
// atom.zag, prover.zag, delib.zag, atomize.zag (fork D kernel, H6-R2 fork D);
// ob_common/ob_tn/ob_fl2/ob_pam/ob_mem/ob_arbiter.zag (one-brain variant B,
// repaired; the three committed repairs are in ob_arbiter.zag).
//
// What is NEW here (the integration, per the frozen integration prereg §1):
//   1. sp_verdict: fork D's INSTALL-iff rule (every draft atom store-ENTAILED
//      and trace-EARNED, GEN excluded from trusted proof), ported
//      mechanism-identical from forkD's run_verdict, returning a disposition
//      plus the first-failing criterion.
//   2. The gate pipeline sp_gate_one: N-AUTH verify -> self-PAM verdict ->
//      weighted-conflict check -> forward / withhold+notify / escalate.
//      WITHHOLD is never silent: the organ is notified with the failing
//      criterion (ledgered), the claim is quarantined (GEN-tagged, visible),
//      and the composition routes around (drops the intent, keeps flowing).
//      Bounded deliberation: SP_MAX_ROUNDS consecutive withholds on one
//      claim -> transparent ESCALATE to the overseer. Never deadlock, never
//      silently drop (K3).
//   3. N-AUTH: requester_id + nonce + keyed tag (HMAC-SHA256, R1) on every
//      cross-organ request, verified against a registry the requesting
//      organ cannot rewrite (registry + per-organ keys live in gate
//      state; organs never receive the buffer). Failure ->
//      REFUSED_UNAUTHENTICATED, ledgered, notified.
//   4. Composition-law machinery, all ledgered append-only:
//      provenance authentication (N-AUTH), weighted conflict resolution,
//      dependency-DAG ledgering, bounded deliberation, visible-but-tagged
//      provisional evidence, independence-aware corroboration, transparent
//      escalation, quarantine rehabilitation, append-only revisions.
//
// Pure Zag. Zero RNG. Byte-identical reruns required.
@import("ob_common.zag")
@import("nio_shim.zag")   // nio_alloc/nio_equal/nio_free for the fork-D kernel files
@import("R33_NATIVE_SHA256_V2.zag") // vendored (import line stripped, see PREREG_R1): ns_sha256 for the N-AUTH keyed MAC
@import("str.zag")
@import("tables.zag")
@import("atom.zag")
@import("atomize.zag")
@import("prover.zag")
@import("delib.zag")

// ---- organ ids (variant B ids 0..3; integration adds overseer + synthetic) ----
const ORG_OVERSEER:i32=4;
const ORG_SYN:i32=5;          // synthetic test organ (speaks N-AUTH natively)

// ---- trainer-utterance message type (new; organ -> gate -> trainer) ----
const M_UTTER:i32=112;

// ---- R4: overseer-issued superseding revision (append-only; see PREREG_R4.md) ----
// arg1 = superseded store line id, arg2 = cited superseding evidence line id.
// Authority: ORG_OVERSEER only (sp_authorized). N-AUTH verified at the
// sp_gate_one step-1 choke point (R1 composition point, read-only dependency).
const M_REVISE:i32=113;

// ---- dispositions ----
const SP_INSTALL:i32=1;
const SP_WITHHOLD:i32=0;
const SP_ESCALATE:i32=2;

// ---- failing-criterion reason codes (frozen; reported to the organ) ----
const SP_R_OK:i32=0;
const SP_R_UNPARSED:i32=1;
const SP_R_CONTRADICTED:i32=2;
const SP_R_UNGROUNDED:i32=3;
const SP_R_GEN_ONLY:i32=4;
const SP_R_UNEARNED:i32=5;
const SP_R_REVISION:i32=6;
const SP_R_CONFLICT:i32=7;
const SP_R_DEPENDENT:i32=8;
const SP_R_UNAUTH:i32=9;
// ---- R4 revision reason codes ----
const SP_R_REVISE_OK:i32=10;       // revision applied
const SP_R_REV_BAD_TARGET:i32=11;  // target not a live EXT line (GEN / out-of-range)
const SP_R_REV_BAD_EVIDENCE:i32=12;// evidence missing / not EXT / already superseded
const SP_R_REV_NO_SUPERSESSION:i32=13; // evidence does not defeat the target
const SP_R_REV_CYCLE:i32=14;       // self-revision or evidence chain reaches target
const SP_R_REV_CAP:i32=15;         // (unused — cap deleted 2026-09-24; code reserved)

// ---- N-AUTH failure reasons ----
const NAUTH_R_UNKNOWN_ORG:i32=1;
const NAUTH_R_BAD_NONCE:i32=2;
const NAUTH_R_BAD_TAG:i32=3; // was NAUTH_R_BAD_HASH pre-R1; value frozen
const NAUTH_R_UNAUTHORIZED_CLASS:i32=4;

// ---- gate ledger codes (300+; do not collide with M_*/TN_OP_*/MA_*) ----
const SP_L_VERDICT:i32=301;        // {ep, disposition, reason} every gate decision
const SP_L_NOTIFY:i32=302;         // {ep, organ, reason} organ notified w/ criterion
const SP_L_DEP:i32=303;            // {verdict_seq, premise_line} dependency DAG edge
const SP_L_QUARANTINE:i32=304;     // {ep, organ, claim_key}
const SP_L_REHABILITATED:i32=305;  // {ep, organ, claim_key}
const SP_L_ESCALATE:i32=306;       // {ep, organ, claim_key} transparent escalation
const SP_L_REFUSED_UNAUTH:i32=307; // {ep, organ, nauth_reason}
const SP_L_CONFLICT:i32=308;       // {ep, winner_org, loser_org} weighted conflict
const SP_L_PROVTAG:i32=309;        // {atom_idx, prov} provenance label on a claim
const SP_L_REVOKE_PASS:i32=310;    // safety-op pass-through (audited, not silent)
const SP_L_DISCONNECT_PASS:i32=311;
const SP_L_STORE_FULL:i32=312;     // {ep, organ, claim_key} R2: evidence-store
                                   // overflow during quarantine GEN-append:
                                   // the quarantine INDEX still records the
                                   // claim; this row records the truncated
                                   // visible evidence (fail-closed+ledgered)
// MERGED TREE (2026-09-25): R2's SP_L_STORE_FULL and R4's SP_L_REVISE both
// froze code 312. R2 keeps 312; R4's codes shift by +1. All uses are via
// these symbolic consts, so no behavior changes (see MERGED_PREREG.md).
const SP_L_REVISE:i32=313;         // {ep, superseded_line, evidence_line} R4: revision applied
const SP_L_REV_REFUSED:i32=314;    // {ep, superseded_line, refuse_reason} R4: revision refused

// ---- gate state layout (one flat arena, no structs) ----
// R2 REPAIR (PREREG_R2.md, frozen 2026-09-24): the arbitrary caps
// SP_LEDGER_CAP, SP_OVR_CAP, SP_DSP_CAP, SP_INST_CAP, SP_IPOOL_SZ and
// SP_QUAR_CAP are DELETED. All five tables + the atom-text pool are
// chunked unbounded tables (see "chunked unbounded tables" below). The
// only size bound left is per-chunk bytes, derived from the znc
// 2^25-bytes-per-slice toolchain ceiling (~/AGENTS.md) — a load-bearing
// limit, not an arbitrary one.
const SP_STORE_SZ:i32=65536;
const SP_MAX_LINES:i32=512;
const SP_MAX_ROUNDS:i32=3;         // bounded deliberation: withholds before ESCALATE
const SP_NORG:i32=8;

const G_STORE:i32=0;
const G_STORE_N:i32=65536;         // i32 bytes used
const G_STORE_LN:i32=65540;        // i32 line count
const G_SPROV:i32=65544;           // 512 bytes: 0=GEN 1=EXT
const G_SSRC:i32=66056;            // 512 bytes: source organ id (255=seed)
const G_REG:i32=66568;             // 8 bytes: registered
const G_NONCE:i32=66576;           // 8 i32: next expected nonce per organ
const G_CHUNK_HEAD:i32=66608;      // 5*8 bytes: i64 head-chunk ptr per table
const G_CHUNK_N:i32=66648;         // 5*4 bytes: i32 total rows per table
const G_POOL_HEAD:i32=66668;       // 8 bytes: i64 head pool-chunk ptr
const G_POOL_N:i32=66676;          // i32 total pool bytes used
const G_LASTNTFY:i32=66680;        // 8 i32: last notify reason per organ
const G_KEYS:i32=66712;            // 8*32 bytes: per-organ 256-bit N-AUTH fixture keys (R1)
const SP_KEYLEN:i32=32;             // bytes per organ key
// R4 revision rows: physically-chunked, logically-unbounded storage. The
// arbitrary SP_REV_CAP=64 is DELETED (no-stupid-limits standing law; same
// repair shape as the committed R2 chunked-storage repair). One row =
// 16 bytes {superseded_line, evidence_line, ep, chain_prev}. Rows are
// append-only and never mutate; the table grows by allocating chunk slices
// on demand, chained via an 8-byte next-chunk header. Chunk pointers ride
// the flat arena as i64 words. The only size bound left is per-chunk
// bytes, derived from the znc 2^25-bytes-per-slice toolchain ceiling —
// a load-bearing limit, not an arbitrary one.
// MERGED TREE (2026-09-25): offsets rebased onto the R1+R2 layout
// (R4's tree used 107880/107888 on the pre-R1/R2 base).
const SP_REV_ROWS:i32=65536;       // rows per revision chunk (2^16)
const SP_REV_ROW:i32=16;           // bytes per revision row
const SP_REV_HDR:i32=8;            // i64 next-chunk pointer per chunk
const SP_REV_CHUNK_BYTES:i32=1048584; // 8 + 65536*16 = 1,048,584 B < 33,554,432
const G_REV_HEAD:i32=66968;        // i64 head-chunk pointer (0 = none allocated yet)
const G_REV_N:i32=66976;           // i32 total revision rows appended
const G_STATE_SZ:i32=66980;        // 66976 + 4

// ---- small utils ----
fn sp_i32s(v:i32)[]u8 {
    let s:[]u8=_zag_i64_to_str(v as i64);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}

fn sp_buf_put(buf:[]u8,pos:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){buf[pos]=s[i];pos=pos+1;i=i+1;}
    return pos;
}

// FNV-1a 32-bit. u64 accumulator masked to 32 bits before each multiply,
// so no reliance on wraparound semantics. KAT-verified in the battery.
fn sp_fnv(data:[]u8)i32 {
    let h:u64=2166136261;
    let i:i32=0;
    while(i<data.len){
        h=h^(data[i] as u64);
        h=(h*16777619) & 4294967295;
        i=i+1;
    }
    return h as i32;
}

fn sp_fnv5(a:i32,b:i32,c:i32,d:i32,e:i32)i32 {
    let buf:[]u8=ob_alloc(20);
    ob_s32(buf,0,a);ob_s32(buf,4,b);ob_s32(buf,8,c);ob_s32(buf,12,d);ob_s32(buf,16,e);
    let h:i32=sp_fnv(buf);
    ob_free(buf);
    return h;
}

// LEGACY unkeyed content_hash (pre-R1 N-AUTH): FNV-1a over canonical LE
// bytes of (requester_id, nonce, mtype, arg1, arg2). FNV is not a
// signature — this is retained ONLY as the red-team attacker oracle
// (K1: attacker-minted unkeyed hash must be REFUSED). No legitimate path
// may call it.
fn sp_auth_make_legacy(org:i32,nonce:i32,mtype:i32,a1:i32,a2:i32)i32 {
    return sp_fnv5(org,nonce,mtype,a1,a2);
}

// ---- N-AUTH keyed authentication (R1 repair) ----
// Per-organ 256-bit fixture keys, provisioned deterministically at gate
// setup (pure Zag, zero RNG): key[org][w] = FNV-1a over fixture domain
// constants + (org, word index), w = 0..7, stored LE. The mechanism is
// what's tested, not key generation; deployment provisions keys
// out-of-band. The gate registry (G_KEYS) holds the keys; sp_auth_verify
// recomputes the tag with the CLAIMED organ's key, so an attacker that
// does not hold the victim's key cannot forge (K1/K2/K4).
fn sp_key_derive(g:[]u8)void {
    let org:i32=0;
    while(org<SP_NORG){
        let w:i32=0;
        while(w<8){
            let kw:i32=sp_fnv5(org,w,1312904532,1212892505,-1640531527); // 0x4E415554, 0x484B4559, 0x9E3779B9 as i32 (PREREG_R1.md section 1)
            ob_s32(g,G_KEYS+org*SP_KEYLEN+w*4,kw);
            w=w+1;
        }
        org=org+1;
    }
    return;
}

// copy one organ's 32 key bytes into out (out.len must be >= 32)
fn sp_key_copy(g:[]u8,org:i32,out:[]u8)void {
    let i:i32=0;
    while(i<SP_KEYLEN){out[i]=g[G_KEYS+org*SP_KEYLEN+i];i=i+1;}
    return;
}

// HMAC-SHA256(key, msg) truncated to 32 bits: LE32 of digest[0..4].
// msg = LE32(org)||LE32(nonce)||LE32(mtype)||LE32(a1)||LE32(a2) (20
// canonical bytes — the same field encoding the old sp_fnv5 hashed, so
// the envelope shape is unchanged). The i32 truncation is a testbed
// envelope constraint (documented in PREREG_R1.md section 4).
fn sp_hmac32(key:[]u8,org:i32,nonce:i32,mtype:i32,a1:i32,a2:i32)i32 {
    let kb:[]u8=ob_alloc(64);
    let kn:i32=key.len;
    if(kn>64){kn=64;}
    let i:i32=0;
    while(i<kn){kb[i]=key[i];i=i+1;}
    // inner = (kb ^ ipad) || msg
    let inner:[]u8=ob_alloc(84);
    i=0;
    while(i<64){inner[i]=(((kb[i] as i32)^54)&255) as u8;i=i+1;}
    ob_s32(inner,64,org);ob_s32(inner,68,nonce);ob_s32(inner,72,mtype);
    ob_s32(inner,76,a1);ob_s32(inner,80,a2);
    let d1:[]u8=ob_alloc(32);
    let tag:i32=0;
    if(ns_sha256(inner,d1)==0){
        // outer = (kb ^ opad) || inner_digest
        let outer:[]u8=ob_alloc(96);
        i=0;
        while(i<64){outer[i]=(((kb[i] as i32)^92)&255) as u8;i=i+1;}
        i=0;
        while(i<32){outer[64+i]=d1[i];i=i+1;}
        let d2:[]u8=ob_alloc(32);
        if(ns_sha256(outer,d2)==0){
            tag=(d2[0] as i32)|((d2[1] as i32)<<8)|((d2[2] as i32)<<16)|((d2[3] as i32)<<24);
        }
        ob_free(d2);
        ob_free(outer);
    }
    ob_free(d1);
    ob_free(inner);
    ob_free(kb);
    return tag;
}

// Legitimate minting: tag minted with the CLAIMED organ's registry key.
// The testbed driver calls this when attesting envelopes (it mints with
// the claimed organ's key, modeling the organ holding its own key).
fn sp_auth_tag(g:[]u8,org:i32,nonce:i32,mtype:i32,a1:i32,a2:i32)i32 {
    if(org<0 || org>=SP_NORG){return 0;}
    let key:[]u8=ob_alloc(SP_KEYLEN);
    sp_key_copy(g,org,key);
    let t:i32=sp_hmac32(key,org,nonce,mtype,a1,a2);
    ob_free(key);
    return t;
}

// Attacker oracle: tag minted with an EXPLICIT key (wrong-key forgery,
// K4). The red-team attacker holds only its own key.
fn sp_auth_tag_key(key:[]u8,org:i32,nonce:i32,mtype:i32,a1:i32,a2:i32)i32 {
    return sp_hmac32(key,org,nonce,mtype,a1,a2);
}

// ---- R2: chunked unbounded tables (PREREG_R2.md section 1, frozen) ----
// Load-bearing bound: the znc 2^25-bytes-per-slice toolchain ceiling
// (~/AGENTS.md) — a single slice > 33,554,432 bytes panics on ANY index.
// Every chunk is a separate ob_alloc'd slice sized strictly under the
// ceiling (largest: 1,310,728 B, >25x margin); logical capacity is
// unbounded (chunks allocated on demand, chained via an 8-byte header
// holding the next-chunk pointer). Row index -> (chunk_seq,row_in_chunk)
// by division over SP_CHUNK_ROWS. All field access is []u8 + ob_s32/
// ob_g32 (the ZNC-2026-09-21-007 arena workaround; no `as []i32` casts);
// chunk pointers ride the flat arena as i64 words (ob_s64/ob_g64).
const SP_CHUNK_ROWS:i32=65536;   // rows per chunk (2^16)
const SP_CHUNK_HDR:i32=8;        // i64 next-chunk pointer
const SP_POOL_CHUNK:i32=1048576; // 2^20 bytes of atom text per pool chunk
const SP_POOL_HDR:i32=8;         // i64 next-chunk pointer

// table ids (index G_CHUNK_HEAD / G_CHUNK_N)
const SPT_LEDGER:i32=0;
const SPT_DSP:i32=1;
const SPT_QUAR:i32=2;
const SPT_INST:i32=3;
const SPT_OVR:i32=4;

// Row byte sizes: ledger 16 {ep,code,a1,a2}; dispute 12 {org,key,count};
// quarantine 12 {org,key,line}; installed 20 {org,weight,cseq,off,alen};
// overseer 16 {ep,org,key,rson}.
fn spt_rowsz(t:i32)i32 {
    if(t==SPT_DSP){return 12;}
    if(t==SPT_QUAR){return 12;}
    if(t==SPT_INST){return 20;}
    return 16;
}

fn spt_chunk_bytes(t:i32)i32 {
    return SP_CHUNK_HDR+SP_CHUNK_ROWS*spt_rowsz(t);
}

fn ob_g64(b:[]u8,at:i32)i64 {
    let v:i64=(b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
    v=v|((b[at+4] as i64)<<32)|((b[at+5] as i64)<<40)|((b[at+6] as i64)<<48)|((b[at+7] as i64)<<56);
    return v;
}

fn ob_s64(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    b[at+4]=((v>>32)&255) as u8;b[at+5]=((v>>40)&255) as u8;
    b[at+6]=((v>>48)&255) as u8;b[at+7]=((v>>56)&255) as u8;
    return;
}

// Slice view of the chunk whose pointer is cp. Terminal loud stop: a
// zero-length chunk (physical-memory exhaustion) panics on first write —
// nothing proceeds unledgered (PREREG_R2 section 2, bound 5).
fn spt_chunk(cp:i64,t:i32)[]u8 {
    let q:*u8=cp as *u8;
    return q[0..spt_chunk_bytes(t)];
}

fn spt_pool_chunk(cp:i64)[]u8 {
    let q:*u8=cp as *u8;
    return q[0..SP_POOL_HDR+SP_POOL_CHUNK];
}

// Append a row; fields beyond the row size are ignored. Returns the
// global row index. Never drops (R1/R2/R4 repair).
fn spt_append(g:[]u8,t:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32)i32 {
    let rowsz:i32=spt_rowsz(t);
    let n:i32=ob_g32(g,G_CHUNK_N+t*4);
    let ci:i32=n/SP_CHUNK_ROWS;
    let ri:i32=n-ci*SP_CHUNK_ROWS;
    let hp:i32=G_CHUNK_HEAD+t*8;
    let cp:i64=ob_g64(g,hp);
    if(cp==0){
        let c0:[]u8=ob_alloc(spt_chunk_bytes(t));
        cp=_zag_slice_ptr(c0) as i64;
        ob_s64(g,hp,cp);
    }
    let k:i32=0;
    while(k<ci){
        let ch:[]u8=spt_chunk(cp,t);
        let nx:i64=ob_g64(ch,0);
        if(nx==0){
            let c2:[]u8=ob_alloc(spt_chunk_bytes(t));
            nx=_zag_slice_ptr(c2) as i64;
            ob_s64(ch,0,nx);
        }
        cp=nx;
        k=k+1;
    }
    let chw:[]u8=spt_chunk(cp,t);
    let base:i32=SP_CHUNK_HDR+ri*rowsz;
    ob_s32(chw,base,f0);
    ob_s32(chw,base+4,f1);
    ob_s32(chw,base+8,f2);
    if(rowsz>12){
        ob_s32(chw,base+12,f3);
        if(rowsz>16){ob_s32(chw,base+16,f4);}
    }
    ob_s32(g,G_CHUNK_N+t*4,n+1);
    return n;
}

fn spt_get(g:[]u8,t:i32,idx:i32,field:i32)i32 {
    let rowsz:i32=spt_rowsz(t);
    let ci:i32=idx/SP_CHUNK_ROWS;
    let ri:i32=idx-ci*SP_CHUNK_ROWS;
    let cp:i64=ob_g64(g,G_CHUNK_HEAD+t*8);
    let k:i32=0;
    while(k<ci){
        let ch:[]u8=spt_chunk(cp,t);
        cp=ob_g64(ch,0);
        k=k+1;
    }
    let chr:[]u8=spt_chunk(cp,t);
    return ob_g32(chr,SP_CHUNK_HDR+ri*rowsz+field*4);
}

fn spt_set(g:[]u8,t:i32,idx:i32,field:i32,v:i32)void {
    let rowsz:i32=spt_rowsz(t);
    let ci:i32=idx/SP_CHUNK_ROWS;
    let ri:i32=idx-ci*SP_CHUNK_ROWS;
    let cp:i64=ob_g64(g,G_CHUNK_HEAD+t*8);
    let k:i32=0;
    while(k<ci){
        let ch:[]u8=spt_chunk(cp,t);
        cp=ob_g64(ch,0);
        k=k+1;
    }
    let chw:[]u8=spt_chunk(cp,t);
    ob_s32(chw,SP_CHUNK_HDR+ri*rowsz+field*4,v);
    return;
}

// Atom-text pool append: copies len bytes; atoms never straddle chunks (a
// new chunk starts when the tail does not fit). Reports (cseq,off).
fn spt_pool_append(g:[]u8,src:[]u8,len:i32,cseq:*i32,off:*i32)void {
    let used:i32=ob_g32(g,G_POOL_N);
    let ci:i32=used/SP_POOL_CHUNK;
    let ri:i32=used-ci*SP_POOL_CHUNK;
    if(ri+len>SP_POOL_CHUNK){
        ci=ci+1;ri=0;used=ci*SP_POOL_CHUNK;
    }
    let cp:i64=ob_g64(g,G_POOL_HEAD);
    if(cp==0){
        let c0:[]u8=ob_alloc(SP_POOL_HDR+SP_POOL_CHUNK);
        cp=_zag_slice_ptr(c0) as i64;
        ob_s64(g,G_POOL_HEAD,cp);
    }
    let k:i32=0;
    while(k<ci){
        let ch:[]u8=spt_pool_chunk(cp);
        let nx:i64=ob_g64(ch,0);
        if(nx==0){
            let c2:[]u8=ob_alloc(SP_POOL_HDR+SP_POOL_CHUNK);
            nx=_zag_slice_ptr(c2) as i64;
            ob_s64(ch,0,nx);
        }
        cp=nx;
        k=k+1;
    }
    let chw:[]u8=spt_pool_chunk(cp);
    let j:i32=0;
    while(j<len){chw[SP_POOL_HDR+ri+j]=src[j];j=j+1;}
    ob_s32(g,G_POOL_N,used+len);
    cseq.*=ci;
    off.*=ri;
    return;
}

fn spt_pool_read(g:[]u8,cseq:i32,off:i32,len:i32)[]u8 {
    let cp:i64=ob_g64(g,G_POOL_HEAD);
    let k:i32=0;
    while(k<cseq){
        let ch:[]u8=spt_pool_chunk(cp);
        cp=ob_g64(ch,0);
        k=k+1;
    }
    let chr:[]u8=spt_pool_chunk(cp);
    return chr[SP_POOL_HDR+off..SP_POOL_HDR+off+len];
}

// K6 machine check: largest single-chunk byte size actually allocated, over
// all table chains and the pool chain. Must stay <= 33554432 (2^25).
fn sp_chunk_max_bytes(g:[]u8)i32 {
    let m:i32=0;
    let t:i32=0;
    while(t<5){
        if(ob_g64(g,G_CHUNK_HEAD+t*8)!=0){
            let cb:i32=spt_chunk_bytes(t);
            if(cb>m){m=cb;}
        }
        t=t+1;
    }
    if(ob_g64(g,G_POOL_HEAD)!=0){
        let pb:i32=SP_POOL_HDR+SP_POOL_CHUNK;
        if(pb>m){m=pb;}
    }
    // MERGED TREE: revision history is unbounded storage too, so its
    // chunks join the byte accounting (every revision chunk is exactly
    // SP_REV_CHUNK_BYTES; the ceiling check is the load-bearing znc
    // 2^25 limit, not a design cap).
    if(sp_rev_g64(g,G_REV_HEAD)!=0){
        if(SP_REV_CHUNK_BYTES>m){m=SP_REV_CHUNK_BYTES;}
    }
    return m;
}

fn sp_ledger(g:[]u8,ep:i32,code:i32,a1:i32,a2:i32)i32 {
    // R2 repair: always appends (chunked unbounded ledger). The -1 drop
    // path is deleted — "all ledgered" holds at any run length.
    return spt_append(g,SPT_LEDGER,ep,code,a1,a2,0);
}

fn sp_ledger_n(g:[]u8)i32 { return ob_g32(g,G_CHUNK_N+SPT_LEDGER*4); }

fn sp_ledger_get(g:[]u8,idx:i32,field:i32)i32 {
    return spt_get(g,SPT_LEDGER,idx,field);
}

fn sp_ledger_count(g:[]u8,code:i32)i32 {
    let c:i32=0;let n:i32=sp_ledger_n(g);let i:i32=0;
    while(i<n){if(sp_ledger_get(g,i,1)==code){c=c+1;}i=i+1;}
    return c;
}

fn sp_ledger_count2(g:[]u8,code:i32,a1:i32)i32 {
    let c:i32=0;let n:i32=sp_ledger_n(g);let i:i32=0;
    while(i<n){
        if(sp_ledger_get(g,i,1)==code && sp_ledger_get(g,i,2)==a1){c=c+1;}
        i=i+1;
    }
    return c;
}

// ---- store management ----
// Store text: lines "atom|EXT\n" / "atom|GEN\n". Provenance is assigned by
// the GATE (harness-pinned, with the fork-D caveat); organ-supplied
// provenance labels are untrusted input and never consulted.
fn sp_store_append(g:[]u8,atom:[]u8,prov:i32,src:i32)i32 {
    let n:[]u8=atom;
    let ln:i32=ob_g32(g,G_STORE_LN);
    if(ln<0 || ln>=SP_MAX_LINES){return -1;}
    let used:i32=ob_g32(g,G_STORE_N);
    let need:i32=n.len+5; // "|EXT\n" or "|GEN\n"
    if(used+need>=SP_STORE_SZ){return -1;}
    let p:i32=sp_buf_put(g[G_STORE..G_STORE+SP_STORE_SZ],used,n);
    if(prov==1){p=sp_buf_put(g[G_STORE..G_STORE+SP_STORE_SZ],p,"|EXT\n");}
    else{p=sp_buf_put(g[G_STORE..G_STORE+SP_STORE_SZ],p,"|GEN\n");}
    ob_s32(g,G_STORE_N,p);
    ob_s32(g,G_STORE_LN,ln+1);
    g[G_SPROV+ln]=prov as u8;
    g[G_SSRC+ln]=src as u8;
    return ln;
}

fn sp_store_text(g:[]u8)[]u8 {
    return g[G_STORE..G_STORE+ob_g32(g,G_STORE_N)];
}

fn sp_store_prov(g:[]u8,line:i32)i32 { return g[G_SPROV+line] as i32; }
fn sp_store_src(g:[]u8,line:i32)i32 { return g[G_SSRC+line] as i32; }

// find a store line id by exact atom text (5-field form), or -1.
fn sp_store_find(g:[]u8,atom:[]u8)i32 {
    let st:[]u8=sp_store_text(g);
    let nl:i32=nlines(st);
    let i:i32=0;
    while(i<nl){
        let ln:[]u8=strim(gline(st,i));
        if(ln.len>5){
            // strip the trailing "|PROV"
            let body:[]u8=ln[0..ln.len-4];
            if(seq(body,atom)==1){return i;}
        }
        i=i+1;
    }
    return -1;
}

fn sp_seed_store(g:[]u8)void {
    // Pinned trust root (harness-pinned EXT, src=255; carries the fork-D
    // provenance caveat until the H6 write-once partition lands).
    sp_store_append(g,"UNIT|fl2|POS|HAS_PROPERTY|registered",1,255);
    sp_store_append(g,"UNIT|pam|POS|HAS_PROPERTY|registered",1,255);
    sp_store_append(g,"UNIT|mem|POS|HAS_PROPERTY|registered",1,255);
    sp_store_append(g,"UNIT|arbiter|POS|HAS_PROPERTY|registered",1,255);
    sp_store_append(g,"UNIT|overseer|POS|HAS_PROPERTY|registered",1,255);
    // Pinned world fragment for trainer utterances (M_UTTER tests).
    sp_store_append(g,"UNIT|pine|POS|IS_A|tree",1,255);
    sp_store_append(g,"UNIT|oak|POS|IS_A|tree",1,255);
    sp_store_append(g,"UNIT|tree|POS|IS_A|plant",1,255);
    sp_store_append(g,"UNIT|pine|POS|HAS_PROPERTY|tall",1,255);
    sp_store_append(g,"UNIT|trout|POS|IS_A|fish",1,255);
    sp_store_append(g,"UNIT|fish|POS|IS_A|animal",1,255);
    sp_store_append(g,"UNIT|deer|POS|HAS_PROPERTY|alive",1,255);
    return;
}

fn sp_new()[]u8 {
    let g:[]u8=ob_alloc(G_STATE_SZ);
    sp_seed_store(g);
    sp_key_derive(g); // R1: deterministic fixture keys, zero RNG
    return g;
}

fn sp_register(g:[]u8,org:i32)void {
    if(org>=0 && org<SP_NORG){g[G_REG+org]=1;}
    return;
}

fn sp_registered(g:[]u8,org:i32)i32 {
    if(org<0 || org>=SP_NORG){return 0;}
    if(g[G_REG+org]==1){return 1;}
    return 0;
}

// ---- N-AUTH verification (R1: keyed) ----
// Registry (G_REG), nonces (G_NONCE) and keys (G_KEYS) live in gate
// state; organs never receive these buffers, so a requesting organ cannot
// rewrite them. The tag is recomputed with the CLAIMED organ's registry
// key: only a holder of that organ's key can mint a valid envelope.
fn sp_auth_verify(g:[]u8,org:i32,nonce:i32,tag:i32,mtype:i32,a1:i32,a2:i32,
    fail:*i32)i32 {
    if(sp_registered(g,org)==0){fail.*=NAUTH_R_UNKNOWN_ORG;return 0;}
    let exp:i32=ob_g32(g,G_NONCE+org*4);
    if(nonce!=exp){fail.*=NAUTH_R_BAD_NONCE;return 0;}
    if(tag!=sp_auth_tag(g,org,nonce,mtype,a1,a2)){fail.*=NAUTH_R_BAD_TAG;return 0;}
    ob_s32(g,G_NONCE+org*4,exp+1);
    fail.*=0;
    return 1;
}

// Frozen authority matrix: which organ may emit which message class.
// M_FORCE_PIN is the external overseer's alone (standing force-pin law).
fn sp_authorized(org:i32,mtype:i32)i32 {
    if(mtype==M_FORCE_PIN){
        if(org==ORG_OVERSEER){return 1;}
        return 0;
    }
    if(mtype==M_MEM_SAFETY){
        if(org==ORG_MEM){return 1;}
        return 0;
    }
    if(mtype==M_PROPOSE_INSTALL || mtype==M_COMMIT || mtype==M_PROMOTE){
        if(org==ORG_FL2){return 1;}
        return 0;
    }
    if(mtype==M_DISCONNECT || mtype==M_REVOKE){
        if(org==ORG_FL2){return 1;}
        return 0;
    }
    if(mtype==M_UTTER){return 1;} // any registered organ may utter (gated)
    // R4: M_REVISE is the overseer class's alone (mechanical recovery for
    // poisoned subjects; PREREG_R4.md). Non-overseer issues are refused at
    // the sp_gate_one authority step (K2).
    if(mtype==M_REVISE){
        if(org==ORG_OVERSEER){return 1;}
        return 0;
    }
    return 0;
}

// ---- self-PAM verdict kernel ----
// Mechanism-identical port of fork D's run_verdict: INSTALL iff every draft
// atom is store-ENTAILED (EXT closure, K1-K8, depth cap 3) AND trace-EARNED,
// with no UNPARSED atoms and no REVISION. GEN is excluded from trusted
// proof (ext_only=1); GEN-entailed atoms diagnose GEN_ONLY.
// Writes per-atom "atom|SV|TV|note" lines into rep; sets disp/reason;
// returns the atom count. Empty draft -> WITHHOLD/UNPARSED (fail-closed:
// there is no claim to admit).
fn sp_verdict(draft:[]u8,store:[]u8,delib:[]u8,rep:[]u8,
    disp:*i32,reason:*i32)i32 {
    let ext_cl:[]u8=closure_full(store,1);
    let full_cl:[]u8=closure_full(store,0);
    let p:i32=0;
    let install:i32=1;
    let rson:i32=SP_R_OK;
    let na:i32=0;
    let nd:i32=nlines(draft);
    let i:i32=0;
    while(i<nd){
        let a:[]u8=strim(gline(draft,i));
        if(a.len>0){
            na=na+1;
            let sv:[]u8="?";
            let tv:[]u8="?";
            let note:[]u8="";
            if(atom_valid(a)==0){
                sv="UNPARSED";tv="UNPARSED";install=0;
                if(rson==SP_R_OK){rson=SP_R_UNPARSED;}
            } else {
                let pr:[]u8=prove_atom(ext_cl,full_cl,a);
                let vc:u8=pr[0];
                if(vc==69){sv="ENTAILED";}
                if(vc==67){sv="CONTRADICTED";}
                if(vc==85){sv="UNGROUNDED";}
                if(pr.len>2){note=pr[2..pr.len];}
                tv=trace_check_atom(store,delib,a);
                if(seq(sv,"ENTAILED")==0){
                    install=0;
                    if(rson==SP_R_OK){
                        if(seq(sv,"CONTRADICTED")==1){rson=SP_R_CONTRADICTED;}
                        else{
                            if(seq(note,"GEN_ONLY")==1){rson=SP_R_GEN_ONLY;}
                            else{rson=SP_R_UNGROUNDED;}
                        }
                    }
                } else {
                    if(seq(tv,"EARNED")==0){
                        install=0;
                        if(rson==SP_R_OK){
                            if(seq(tv,"REVISION")==1){rson=SP_R_REVISION;}
                            else{rson=SP_R_UNEARNED;}
                        }
                    }
                }
            }
            p=sp_buf_put(rep,p,a);
            p=sp_buf_put(rep,p,"|");
            p=sp_buf_put(rep,p,sv);
            p=sp_buf_put(rep,p,"|");
            p=sp_buf_put(rep,p,tv);
            p=sp_buf_put(rep,p,"|");
            p=sp_buf_put(rep,p,note);
            p=sp_buf_put(rep,p,"\n");
        }
        i=i+1;
    }
    if(na==0){install=0;rson=SP_R_UNPARSED;}
    if(install==1){disp.*=SP_INSTALL;}else{disp.*=SP_WITHHOLD;}
    reason.*=rson;
    // R2 leak fix (2026-09-24): the closures are heap buffers; free them.
    // (closure_full already freed its intermediates.)
    ob_free(ext_cl);
    ob_free(full_cl);
    return na;
}

// ---- claim mapping (frozen testbed mapping; see INTEGRATION_SPEC.md) ----
// Draft atoms for legacy organ intents. Single lowercase tokens throughout.
fn sp_claim_atom(mtype:i32,a1:i32,a2:i32)[]u8 {
    if(mtype==M_PROPOSE_INSTALL){
        return mk_atom("UNIT",cat2("policy",sp_i32s(a1)),"POS","HAS_PROPERTY","install_warranted");
    }
    if(mtype==M_COMMIT){
        return mk_atom("UNIT",cat2("policy",sp_i32s(a2)),"POS","HAS_PROPERTY","survivor_warranted");
    }
    if(mtype==M_PROMOTE){
        return mk_atom("UNIT",cat2("policy",sp_i32s(a1)),"POS","HAS_PROPERTY","promote_warranted");
    }
    if(mtype==M_FORCE_PIN){
        return mk_atom("UNIT",cat2("slot",sp_i32s(a1)),"POS","HAS_PROPERTY","force_pinned");
    }
    if(mtype==M_MEM_SAFETY){
        return mk_atom("UNIT",cat2("slot",sp_i32s(a2)),"POS","HAS_PROPERTY","safety_pin_applied");
    }
    return "";
}

fn sp_claim_bearing(mtype:i32)i32 {
    if(mtype==M_PROPOSE_INSTALL){return 1;}
    if(mtype==M_COMMIT){return 1;}
    if(mtype==M_PROMOTE){return 1;}
    if(mtype==M_FORCE_PIN){return 1;}
    if(mtype==M_MEM_SAFETY){return 1;}
    if(mtype==M_UTTER){return 1;}
    return 0;
}

// Count tn_audit entries in a published trace with (op, arg2==aux).
fn sp_trace_count(log:[]u8,ln:i32,op:i32,aux:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<ln){
        if(ob_g32(log,i*16+4)==op && ob_g32(log,i*16+12)==aux){c=c+1;}
        i=i+1;
    }
    return c;
}

// Count tn_audit entries with (ep, op, arg1==x1, arg2==x2).
fn sp_trace_has(log:[]u8,ln:i32,ep:i32,op:i32,x1:i32,x2:i32)i32 {
    let i:i32=0;
    while(i<ln){
        if(ob_g32(log,i*16)==ep && ob_g32(log,i*16+4)==op &&
           ob_g32(log,i*16+8)==x1 && ob_g32(log,i*16+12)==x2){return 1;}
        i=i+1;
    }
    return 0;
}

// The store-builder: mechanically derive EXT atoms from the organ's
// PUBLISHED TRACE (never from the organ's words). The gate re-verifies the
// organ's own gate conditions; an organ that emits an intent without the
// trace evidence gets no EXT support and its claim withholds.
// Returns 1 and appends the EXT atom when the derivation fires.
fn sp_derive_ext(g:[]u8,org:i32,mtype:i32,a1:i32,a2:i32,
    log:[]u8,ln:i32,ep:i32)[]u8 {
    if(org==ORG_FL2 && mtype==M_PROPOSE_INSTALL){
        // The organ's own E14 gate: HASRULE && 4 calibrations. The gate
        // re-checks: TN_OP_PINSTALL at ep with arg2==policy, and >=4
        // TN_OP_CALIBRATE aux==1 entries in the published trace.
        if(sp_trace_has(log,ln,ep,TN_OP_PINSTALL,0,a1)==1 &&
           sp_trace_count(log,ln,TN_OP_CALIBRATE,1)>=4){
            let at:[]u8=sp_claim_atom(mtype,a1,a2);
            if(sp_store_find(g,at)<0){sp_store_append(g,at,1,org);}
            return at;
        }
        return "";
    }
    if(org==ORG_FL2 && mtype==M_COMMIT){
        // E29 lying-path correction: TN_OP_COMMIT at ep with (1,survivor).
        if(sp_trace_has(log,ln,ep,TN_OP_COMMIT,1,a2)==1){
            let at2:[]u8=sp_claim_atom(mtype,a1,a2);
            if(sp_store_find(g,at2)<0){sp_store_append(g,at2,1,org);}
            return at2;
        }
        return "";
    }
    if(org==ORG_FL2 && mtype==M_PROMOTE){
        // E48 promotion: TN_OP_PROMOTE at ep with arg2==policy.
        if(sp_trace_has(log,ln,ep,TN_OP_PROMOTE,0,a1)==1){
            let at3:[]u8=sp_claim_atom(mtype,a1,a2);
            if(sp_store_find(g,at3)<0){sp_store_append(g,at3,1,org);}
            return at3;
        }
        return "";
    }
    if(org==ORG_OVERSEER && mtype==M_FORCE_PIN){
        // The overseer IS the trust root for force-pins (standing law).
        let at4:[]u8=sp_claim_atom(mtype,a1,a2);
        if(sp_store_find(g,at4)<0){sp_store_append(g,at4,1,org);}
        return at4;
    }
    return "";
}

// Synthesize the legacy deliberation record for a derived EXT atom:
// PREMISES = the EXT atom (+ organ registration); STEPS = LOOKUP;
// CONCLUSIONS = the draft atom. This is the testbed's attestation for the
// frozen variant-B organs (which predate deliberation records); the
// adversarial batteries supply their own delibs.
fn sp_build_legacy_draft(draft:[]u8,atom:[]u8)i32 {
    return sp_buf_put(draft,0,cat2(atom,"\n"));
}

fn sp_build_legacy_delib(delib:[]u8,atom:[]u8,org:i32)i32 {
    let p:i32=0;
    let rego:[]u8="UNIT|fl2|POS|HAS_PROPERTY|registered";
    if(org==ORG_MEM){rego="UNIT|mem|POS|HAS_PROPERTY|registered";}
    if(org==ORG_PAM){rego="UNIT|pam|POS|HAS_PROPERTY|registered";}
    if(org==ORG_OVERSEER){rego="UNIT|overseer|POS|HAS_PROPERTY|registered";}
    p=sp_buf_put(delib,p,"PREMISES:\n");
    p=sp_buf_put(delib,p,rego);p=sp_buf_put(delib,p,"\n");
    p=sp_buf_put(delib,p,atom);p=sp_buf_put(delib,p,"\n");
    p=sp_buf_put(delib,p,"STEPS:\n");
    p=sp_buf_put(delib,p,"LOOKUP||");p=sp_buf_put(delib,p,atom);
    p=sp_buf_put(delib,p,"||");p=sp_buf_put(delib,p,atom);p=sp_buf_put(delib,p,"\n");
    p=sp_buf_put(delib,p,"CONCLUSIONS:\n");
    p=sp_buf_put(delib,p,atom);p=sp_buf_put(delib,p,"\n");
    return p;
}

// ---- dispute table (bounded deliberation) — R2 repair: chunked,
// unbounded. Table exhaustion can no longer force instant escalation;
// escalation happens only via the frozen SP_MAX_ROUNDS law, ledgered.
fn sp_dispute_find(g:[]u8,org:i32,key:i32)i32 {
    let n:i32=ob_g32(g,G_CHUNK_N+SPT_DSP*4);
    let i:i32=0;
    while(i<n){
        if(spt_get(g,SPT_DSP,i,0)==org && spt_get(g,SPT_DSP,i,1)==key){return i;}
        i=i+1;
    }
    return -1;
}

fn sp_dispute_n(g:[]u8)i32 { return ob_g32(g,G_CHUNK_N+SPT_DSP*4); }

fn sp_dispute_bump(g:[]u8,org:i32,key:i32)i32 {
    let i:i32=sp_dispute_find(g,org,key);
    if(i<0){
        spt_append(g,SPT_DSP,org,key,1,0,0);
        return 1;
    }
    let c:i32=spt_get(g,SPT_DSP,i,2)+1;
    spt_set(g,SPT_DSP,i,2,c);
    return c;
}

fn sp_dispute_reset(g:[]u8,org:i32,key:i32)void {
    let i:i32=sp_dispute_find(g,org,key);
    if(i>=0){spt_set(g,SPT_DSP,i,2,0);}
    return;
}

// ---- quarantine — R2 repair: chunked, unbounded. The phantom-row
// defect is closed by construction: sp_gate_one ledgers SP_L_QUARANTINE
// only when sp_quarantined(org,key)==1 holds at ledger time.
fn sp_quarantine_add(g:[]u8,ep:i32,org:i32,key:i32,draft:[]u8)void {
    // Visible-but-tagged provisional evidence: the withheld claim's atoms
    // are appended to the store as GEN (inert in trusted proofs, visible in
    // dumps), and the quarantine index records (org,key,first line).
    // A claim already quarantined is not re-appended (no store bloat).
    if(sp_dispute_find(g,org,key)<0){return;}
    let n:i32=ob_g32(g,G_CHUNK_N+SPT_QUAR*4);
    let dup:i32=0;
    let q:i32=0;
    while(q<n){
        if(spt_get(g,SPT_QUAR,q,0)==org && spt_get(g,SPT_QUAR,q,1)==key){dup=1;}
        q=q+1;
    }
    if(dup==1){return;}
    let first:i32=-1;
    let full:i32=0;
    let nd:i32=nlines(draft);
    let i:i32=0;
    while(i<nd){
        let a:[]u8=strim(gline(draft,i));
        if(a.len>0 && atom_valid(a)==1){
            let li:i32=sp_store_append(g,a,0,org);
            if(li<0){full=1;}
            else{if(first<0){first=li;}}
        }
        i=i+1;
    }
    if(full==1){
        // Fail-closed AND ledgered (never silent): the quarantine index
        // still records the claim; the ledger records the truncated
        // visible evidence.
        sp_ledger(g,ep,SP_L_STORE_FULL,org,key);
    }
    spt_append(g,SPT_QUAR,org,key,first,0,0);
    return;
}

fn sp_quarantine_n(g:[]u8)i32 { return ob_g32(g,G_CHUNK_N+SPT_QUAR*4); }

fn sp_quarantined(g:[]u8,org:i32,key:i32)i32 {
    let n:i32=ob_g32(g,G_CHUNK_N+SPT_QUAR*4);
    let i:i32=0;
    while(i<n){
        if(spt_get(g,SPT_QUAR,i,0)==org && spt_get(g,SPT_QUAR,i,1)==key){return 1;}
        i=i+1;
    }
    return 0;
}

fn sp_rehabilitate(g:[]u8,ep:i32,org:i32,key:i32)void {
    // Append-only rehabilitation: the quarantine tag is lifted by a NEW
    // ledger entry; history is never mutated.
    let n:i32=ob_g32(g,G_CHUNK_N+SPT_QUAR*4);
    let i:i32=0;
    while(i<n){
        if(spt_get(g,SPT_QUAR,i,0)==org && spt_get(g,SPT_QUAR,i,1)==key){
            spt_set(g,SPT_QUAR,i,1,-1); // tombstone by key invalidation
        }
        i=i+1;
    }
    sp_ledger(g,ep,SP_L_REHABILITATED,org,key);
    return;
}

// ---- R4: append-only revision machinery (mechanical recovery, PREREG_R4.md) ----
// A revision row {superseded_line, evidence_line, ep, chain_prev} never
// mutates claim text: the store stays append-only. A line is superseded iff
// the NEWEST revision row targets it (latest revision wins; no active flags,
// no in-place deactivation).
//
// Rows live in chunked unbounded storage (SP_REV_* above): chunk slices are
// allocated on demand and chained via the 8-byte header; row index ->
// (chunk_seq, row_in_chunk) by division over SP_REV_ROWS. All field access
// is []u8 + ob_s32/ob_g32 (the ZNC-2026-09-21-007 arena workaround; no
// `as []i32` casts); chunk pointers ride the flat arena as i64 words. Row
// order is append order, so newest-row (latest-wins) semantics are preserved
// exactly. With zero revision rows, sp_superseded is identically 0 and
// sp_store_effective is byte-identical to sp_store_text (K6).

// i64 word accessors: chunk pointers ride the flat gate arena.
fn sp_rev_g64(b:[]u8,at:i32)i64 {
    let v:i64=(b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
    v=v|((b[at+4] as i64)<<32)|((b[at+5] as i64)<<40)|((b[at+6] as i64)<<48)|((b[at+7] as i64)<<56);
    return v;
}
fn sp_rev_s64(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    b[at+4]=((v>>32)&255) as u8;b[at+5]=((v>>40)&255) as u8;
    b[at+6]=((v>>48)&255) as u8;b[at+7]=((v>>56)&255) as u8;
    return;
}

// Slice view of the chunk at raw pointer cp. Terminal loud stop: a null
// chunk pointer (physical-memory exhaustion) panics on first use — nothing
// proceeds unledgered (same exhaustion bound as the committed R2 repair,
// PREREG_R2 section 2).
fn sp_rev_chunk(cp:i64)[]u8 {
    let q:*u8=cp as *u8;
    return q[0..SP_REV_CHUNK_BYTES];
}

// Read one field of one revision row (fields: 0=superseded_line,
// 1=evidence_line, 2=ep, 3=chain_prev).
fn sp_rev_get(g:[]u8,idx:i32,field:i32)i32 {
    let ci:i32=idx/SP_REV_ROWS;
    let ri:i32=idx-ci*SP_REV_ROWS;
    let cp:i64=sp_rev_g64(g,G_REV_HEAD);
    let k:i32=0;
    while(k<ci){
        let ch:[]u8=sp_rev_chunk(cp);
        cp=sp_rev_g64(ch,0);
        k=k+1;
    }
    let chr:[]u8=sp_rev_chunk(cp);
    return ob_g32(chr,SP_REV_HDR+ri*SP_REV_ROW+field*4);
}

// Append one revision row. Returns the global row index. Never drops:
// chunks are allocated on demand; physical exhaustion is a loud stop,
// never a silent refusal.
fn sp_rev_append(g:[]u8,s:i32,e:i32,ep:i32,prev:i32)i32 {
    let n:i32=ob_g32(g,G_REV_N);
    let ci:i32=n/SP_REV_ROWS;
    let ri:i32=n-ci*SP_REV_ROWS;
    let cp:i64=sp_rev_g64(g,G_REV_HEAD);
    if(cp==0){
        let c0:[]u8=ob_alloc(SP_REV_CHUNK_BYTES);
        cp=_zag_slice_ptr(c0) as i64;
        sp_rev_s64(g,G_REV_HEAD,cp);
    }
    let k:i32=0;
    while(k<ci){
        let ch:[]u8=sp_rev_chunk(cp);
        let nx:i64=sp_rev_g64(ch,0);
        if(nx==0){
            let c2:[]u8=ob_alloc(SP_REV_CHUNK_BYTES);
            nx=_zag_slice_ptr(c2) as i64;
            sp_rev_s64(ch,0,nx);
        }
        cp=nx;
        k=k+1;
    }
    let chw:[]u8=sp_rev_chunk(cp);
    let base:i32=SP_REV_HDR+ri*SP_REV_ROW;
    ob_s32(chw,base,s);
    ob_s32(chw,base+4,e);
    ob_s32(chw,base+8,ep);
    ob_s32(chw,base+12,prev);
    ob_s32(g,G_REV_N,n+1);
    return n;
}

fn sp_rev_newest(g:[]u8,s:i32)i32 {
    let n:i32=ob_g32(g,G_REV_N);
    let best:i32=-1;
    let i:i32=0;
    while(i<n){
        if(sp_rev_get(g,i,0)==s){best=i;}
        i=i+1;
    }
    return best;
}

fn sp_superseded(g:[]u8,line:i32)i32 {
    if(sp_rev_newest(g,line)>=0){return 1;}
    return 0;
}

// Cycle check: walk newest-row supersession edges from e; reaching s
// (including e==s, the self-revision) means this revision would close a
// cycle -> refuse. The walk is bounded by n+1 hops where n is the live row
// count — a data-derived bound, not an arbitrary one: each hop visits one
// row, so n+1 hops among n rows force a repeated row by pigeonhole, which
// means the walk is periodic from the first repeat and can never reach s.
// An over-long walk therefore fails closed (refuse).
fn sp_rev_cycle(g:[]u8,s:i32,e:i32)i32 {
    let n:i32=ob_g32(g,G_REV_N);
    let cur:i32=e;
    let hops:i32=0;
    while(hops<=n){
        if(cur==s){return 1;}
        let r:i32=sp_rev_newest(g,cur);
        if(r<0){return 0;}
        cur=sp_rev_get(g,r,1);
        hops=hops+1;
    }
    return 1;
}

// Atom text (5-field, no PROV suffix) of a store line. Read-only slice.
fn sp_line_atom(g:[]u8,line:i32)[]u8 {
    let st:[]u8=sp_store_text(g);
    let ln:[]u8=strim(gline(st,line));
    if(ln.len>4){return ln[0..ln.len-4];}
    return "";
}

// The EFFECTIVE store: store text with every superseded EXT line's suffix
// rewritten "|EXT" -> "|SUP" (same length). "|SUP" fails atom_valid's PROV
// check, so superseded lines are inert in every closure (ext_only=1 and 0):
// retracted for contradiction purposes AND for entailment. The real store
// is never mutated. With zero revision rows the output is byte-identical
// to sp_store_text(g) (K6). Sets allocated=1 iff the caller must ob_free.
fn sp_store_effective(g:[]u8,allocated:*i32)[]u8 {
    allocated.*=0;
    let out:[]u8=ob_alloc(SP_STORE_SZ);
    if(out.len==0){return sp_store_text(g);}
    allocated.*=1;
    let st:[]u8=sp_store_text(g);
    let nl:i32=nlines(st);
    let p:i32=0;
    let i:i32=0;
    while(i<nl){
        let ln:[]u8=strim(gline(st,i));
        if(ln.len>0){
            if(ln.len>4 && sp_superseded(g,i)==1){
                let k:i32=0;
                while(k<ln.len-4){out[p]=ln[k];p=p+1;k=k+1;}
                out[p]=124;p=p+1; // '|'
                out[p]=83;p=p+1;  // 'S'
                out[p]=85;p=p+1;  // 'U'
                out[p]=80;p=p+1;  // 'P'
            } else {
                let k2:i32=0;
                while(k2<ln.len){out[p]=ln[k2];p=p+1;k2=k2+1;}
            }
            out[p]=10;p=p+1;
        }
        i=i+1;
    }
    return out[0..p];
}

// Refusal path for M_REVISE warrant failures: ledgered with reason + the
// requesting organ notified (never silent). Not a claim: no dispute table,
// no quarantine.
fn sp_revise_refuse(g:[]u8,ep:i32,org:i32,s:i32,reason:i32,
    fwd:*i32,disp_out:*i32,reason_out:*i32)i32 {
    sp_ledger(g,ep,SP_L_REV_REFUSED,s,reason);
    sp_ledger(g,ep,SP_L_NOTIFY,org,reason);
    ob_s32(g,G_LASTNTFY+org*4,reason);
    fwd.*=0;
    disp_out.*=SP_WITHHOLD;
    reason_out.*=reason;
    return 0;
}

// M_REVISE handler. Checks in prereg order (§1.3): live EXT target, live
// EXT evidence, evidence not superseded, no cycle, evidence defeats target
// (contradicts, the verdict's own predicate). Apply appends one revision
// row to the chunked unbounded table (no cap — the old SP_REV_CAP is
// deleted) and ledgers SP_L_REVISE (never silent).
fn sp_revise_one(g:[]u8,org:i32,s:i32,e:i32,ep:i32,
    fwd:*i32,disp_out:*i32,reason_out:*i32)i32 {
    let nl:i32=ob_g32(g,G_STORE_LN);
    if(s<0 || s>=nl || sp_store_prov(g,s)!=1){
        return sp_revise_refuse(g,ep,org,s,SP_R_REV_BAD_TARGET,fwd,disp_out,reason_out);
    }
    if(e<0 || e>=nl || sp_store_prov(g,e)!=1){
        return sp_revise_refuse(g,ep,org,s,SP_R_REV_BAD_EVIDENCE,fwd,disp_out,reason_out);
    }
    if(sp_superseded(g,e)==1){
        return sp_revise_refuse(g,ep,org,s,SP_R_REV_BAD_EVIDENCE,fwd,disp_out,reason_out);
    }
    if(sp_rev_cycle(g,s,e)==1){
        return sp_revise_refuse(g,ep,org,s,SP_R_REV_CYCLE,fwd,disp_out,reason_out);
    }
    let sa:[]u8=sp_line_atom(g,s);
    let ea:[]u8=sp_line_atom(g,e);
    if(contradicts(ea,sa)==0){
        return sp_revise_refuse(g,ep,org,s,SP_R_REV_NO_SUPERSESSION,fwd,disp_out,reason_out);
    }
    let prev:i32=sp_rev_newest(g,s);
    let rn:i32=sp_rev_append(g,s,e,ep,prev);
    sp_ledger(g,ep,SP_L_REVISE,s,e);
    fwd.*=0;
    disp_out.*=SP_INSTALL;
    reason_out.*=SP_R_REVISE_OK;
    return rn;
}

// ---- installed-claim index + weighted conflict resolution ----
fn sp_organ_weight(org:i32)i32 {
    if(org==ORG_OVERSEER){return 40;}
    if(org==ORG_MEM){return 30;}
    if(org==ORG_PAM){return 20;}
    if(org==ORG_FL2){return 10;}
    if(org==ORG_SYN){return 5;}
    return 0;
}

// ---- installed-claim index + weighted conflict resolution — R2
// repair: chunked, unbounded; atom text lives in the chunked pool.
// Conflict detection works at any index position (R4 repair).
fn sp_installed_add(g:[]u8,org:i32,draft:[]u8)void {
    let nd:i32=nlines(draft);
    let i:i32=0;
    while(i<nd){
        let a:[]u8=strim(gline(draft,i));
        if(a.len>0 && atom_valid(a)==1){
            let cs:i32=0;
            let of:i32=0;
            spt_pool_append(g,a,a.len,&cs,&of);
            spt_append(g,SPT_INST,org,sp_organ_weight(org)+2,cs,of,a.len);
        }
        i=i+1;
    }
    return;
}

fn sp_installed_n(g:[]u8)i32 { return ob_g32(g,G_CHUNK_N+SPT_INST*4); }

fn sp_inst_get(g:[]u8,idx:i32,field:i32)i32 {
    return spt_get(g,SPT_INST,idx,field);
}

// Returns the conflicting installed entry index, or -1. On conflict the
// WEIGHTED rule fires: higher (organ weight + EXT backing) wins; ties keep
// the incumbent. Both outcomes are ledgered (never silent).
fn sp_conflict_check(g:[]u8,ep:i32,org:i32,draft:[]u8,lose:*i32)[]u8 {
    let n:[]u8="";
    let ni:i32=sp_installed_n(g);
    let nd:i32=nlines(draft);
    let i:i32=0;
    while(i<nd){
        let a:[]u8=strim(gline(draft,i));
        if(a.len>0 && atom_valid(a)==1){
            let j:i32=0;
            while(j<ni){
                let io:i32=sp_inst_get(g,j,0);
                let cs:i32=sp_inst_get(g,j,2);
                let of:i32=sp_inst_get(g,j,3);
                let ln2:i32=sp_inst_get(g,j,4);
                if(cs>=0){
                    let b:[]u8=spt_pool_read(g,cs,of,ln2);
                    if(contradicts(b,a)==1){
                        let wnew:i32=sp_organ_weight(org)+2;
                        let wold:i32=sp_inst_get(g,j,1);
                        if(wnew>wold){
                            // challenger wins: supersede the incumbent
                            sp_ledger(g,ep,SP_L_CONFLICT,org,io);
                            spt_set(g,SPT_INST,j,2,-1); // tombstone
                        } else {
                            // incumbent (or tie) wins: challenger loses
                            sp_ledger(g,ep,SP_L_CONFLICT,io,org);
                            lose.*=1;
                            return a;
                        }
                    }
                }
                j=j+1;
            }
        }
        i=i+1;
    }
    lose.*=0;
    return n;
}

// ---- independence-aware corroboration ----
// A corroborating store line must be EXT and from a DIFFERENT source organ
// than the claimant. Same-source "corroboration" is dependence, not evidence.
fn sp_corroborate(g:[]u8,org:i32,line:i32)i32 {
    let nl:i32=ob_g32(g,G_STORE_LN);
    if(line<0 || line>=nl){return 0;}
    if(sp_store_prov(g,line)!=1){return 0;}
    // R4: a superseded (retracted) claim does not corroborate.
    if(sp_superseded(g,line)==1){return 0;}
    let src:i32=sp_store_src(g,line);
    if(src==255){return 1;} // pinned seed: independent of every organ
    if(src==org){return 0;}
    return 1;
}

// ---- dependency-DAG edges ----
fn sp_dep_edges(g:[]u8,verdict_seq:i32,delib:[]u8)void {
    // For each PREMISES line that is an EXT store entry, ledger an edge
    // verdict_seq -> store line id. Append-only; forms the claim's DAG.
    let prems:[]u8=section_text(delib,"PREMISES:");
    let np:i32=nlines(prems);
    let i:i32=0;
    while(i<np){
        let pa:[]u8=strim(gline(prems,i));
        if(pa.len>0){
            let li:i32=sp_store_find(g,pa);
            if(li>=0 && sp_store_prov(g,li)==1){
                sp_ledger(g,0,SP_L_DEP,verdict_seq,li);
            }
        }
        i=i+1;
    }
    return;
}

// ---- the gate pipeline ----
// One organ utterance through: N-AUTH -> authority -> self-PAM verdict ->
// conflict check -> forward / withhold+notify+quarantine / escalate.
// Always ledgered; never silent; never deadlocks (withholds route around,
// repeated disputes escalate transparently within SP_MAX_ROUNDS).
// Sets fwd=1 when the message may proceed to the arbiter.
fn sp_gate_one(g:[]u8,org:i32,mtype:i32,a1:i32,a2:i32,
    nonce:i32,tag:i32,draft:[]u8,delib:[]u8,ep:i32,
    fwd:*i32,disp_out:*i32,reason_out:*i32)i32 {
    fwd.*=0;
    disp_out.*=SP_WITHHOLD;
    reason_out.*=SP_R_UNAUTH;
    // 1. N-AUTH: requester_id + nonce + keyed tag vs the registry+keys.
    let nf:i32=0;
    if(sp_auth_verify(g,org,nonce,tag,mtype,a1,a2,&nf)==0){
        sp_ledger(g,ep,SP_L_REFUSED_UNAUTH,org,nf);
        sp_ledger(g,ep,SP_L_NOTIFY,org,SP_R_UNAUTH);
        ob_s32(g,G_LASTNTFY+org*4,SP_R_UNAUTH);
        reason_out.*=SP_R_UNAUTH;
        return 0;
    }
    // 2. Authority class (part of the registry: who may emit what).
    if(sp_authorized(org,mtype)==0){
        sp_ledger(g,ep,SP_L_REFUSED_UNAUTH,org,NAUTH_R_UNAUTHORIZED_CLASS);
        // R4: revision refusals also enter the revision-specific audit.
        if(mtype==M_REVISE){sp_ledger(g,ep,SP_L_REV_REFUSED,a1,SP_R_UNAUTH);}
        sp_ledger(g,ep,SP_L_NOTIFY,org,SP_R_UNAUTH);
        ob_s32(g,G_LASTNTFY+org*4,SP_R_UNAUTH);
        reason_out.*=SP_R_UNAUTH;
        return 0;
    }
    // 3. Safety signals pass N-AUTH only (P2-analog: the gate must not veto
    //    uninstall/disconnect; they are ledgered, never silent).
    if(mtype==M_REVOKE){
        let s1:i32=sp_ledger(g,ep,SP_L_VERDICT,1,SP_R_OK);
        sp_ledger(g,ep,SP_L_REVOKE_PASS,a1,a2);
        fwd.*=1;disp_out.*=SP_INSTALL;reason_out.*=SP_R_OK;
        return s1;
    }
    if(mtype==M_DISCONNECT){
        sp_ledger(g,ep,SP_L_VERDICT,1,SP_R_OK);
        sp_ledger(g,ep,SP_L_DISCONNECT_PASS,0,0);
        fwd.*=1;disp_out.*=SP_INSTALL;reason_out.*=SP_R_OK;
        return 0;
    }
    // 3b. R4: overseer revision (mechanical recovery for poisoned subjects).
    // Authority-gated (overseer class, step 2) + N-AUTH verified (step 1);
    // composes with the R1 authenticated-N-AUTH repair at the
    // sp_auth_verify choke point (read-only dependency). Not a claim:
    // bypasses the verdict/dispute/quarantine path entirely.
    if(mtype==M_REVISE){
        return sp_revise_one(g,org,a1,a2,ep,fwd,disp_out,reason_out);
    }
    // 4. Claim-bearing intents: self-PAM verdict.
    if(sp_claim_bearing(mtype)==0){
        // Unknown message class: fail closed (never silently forwarded).
        sp_ledger(g,ep,SP_L_REFUSED_UNAUTH,org,NAUTH_R_UNAUTHORIZED_CLASS);
        sp_ledger(g,ep,SP_L_NOTIFY,org,SP_R_UNAUTH);
        ob_s32(g,G_LASTNTFY+org*4,SP_R_UNAUTH);
        return 0;
    }
    let key:i32=sp_fnv(draft);
    let rep:[]u8=ob_alloc(16384);
    let disp:i32=SP_WITHHOLD;
    let rson:i32=SP_R_UNAUTH;
    let na:i32=0;
    // R4: the verdict reads the EFFECTIVE store (superseded lines inert).
    // With zero revision rows this is byte-identical to sp_store_text(g).
    let efa:i32=0;
    let eff:[]u8=sp_store_effective(g,&efa);
    if(rep.len>0){
        na=sp_verdict(draft,eff,delib,rep,&disp,&rson);
    }
    if(efa==1){ob_free(eff);}
    if(disp==SP_INSTALL){
        // 5a. Weighted conflict check against installed claims.
        let lose:i32=0;
        let catom:[]u8=sp_conflict_check(g,ep,org,draft,&lose);
        if(lose==1){
            disp=SP_WITHHOLD;rson=SP_R_CONFLICT;
        } else {
            let vs:i32=sp_ledger(g,ep,SP_L_VERDICT,SP_INSTALL,SP_R_OK);
            // provenance labels on the installed claim (dependency DAG)
            // R3 (O2 repair): the install-time tag tracks the INSTALL, not
            // the first sighting. This branch is reachable only when
            // sp_verdict proved every draft atom store-ENTAILED via the
            // EXT-only closure and trace-EARNED, so the provenance that
            // warranted the install is EXT by construction. Record EXT;
            // a quarantined GEN first-sighting must never shadow it.
            // The store is untouched (append-only): first-seen GEN history
            // survives in the quarantine lines and WITHHOLD verdict rows.
            let nd:i32=nlines(draft);
            let di:i32=0;
            while(di<nd){
                let da:[]u8=strim(gline(draft,di));
                if(da.len>0 && atom_valid(da)==1){
                    sp_ledger(g,ep,SP_L_PROVTAG,di,1);
                }
                di=di+1;
            }
            sp_dep_edges(g,vs,delib);
            sp_installed_add(g,org,draft);
            if(sp_quarantined(g,org,key)==1){sp_rehabilitate(g,ep,org,key);}
            sp_dispute_reset(g,org,key);
            fwd.*=1;disp_out.*=SP_INSTALL;reason_out.*=SP_R_OK;
            ob_free(rep);
            return vs;
        }
    }
    // 5b. WITHHOLD: notify the organ with the failing criterion (ledgered),
    // quarantine the claim (GEN-tagged, visible), route around (drop).
    let rounds:i32=sp_dispute_bump(g,org,key);
    sp_ledger(g,ep,SP_L_VERDICT,SP_WITHHOLD,rson);
    sp_ledger(g,ep,SP_L_NOTIFY,org,rson);
    ob_s32(g,G_LASTNTFY+org*4,rson);
    sp_quarantine_add(g,ep,org,key,draft);
    // R3 repair: the ledger asserts a quarantine only when the claim IS
    // quarantined at ledger time — unconditionally. (A ledgered
    // SP_L_QUARANTINE row implies sp_quarantined()==1, by construction.)
    if(sp_quarantined(g,org,key)==1){
        sp_ledger(g,ep,SP_L_QUARANTINE,org,key);
    }
    disp_out.*=SP_WITHHOLD;reason_out.*=rson;
    // 5c. Bounded deliberation: exhausting the rounds escalates, visibly.
    if(rounds>=SP_MAX_ROUNDS){
        sp_ledger(g,ep,SP_L_ESCALATE,org,key);
        // R2 repair: the overseer inbox is chunked and unbounded — every
        // escalation lands an entry; the SP_OVR_CAP silent drop is gone.
        spt_append(g,SPT_OVR,ep,org,key,rson,0);
        disp_out.*=SP_ESCALATE;
    }
    ob_free(rep);
    return 0;
}

fn sp_overseer_n(g:[]u8)i32 { return ob_g32(g,G_CHUNK_N+SPT_OVR*4); }

fn sp_overseer_get(g:[]u8,idx:i32,field:i32)i32 {
    return spt_get(g,SPT_OVR,idx,field);
}

fn sp_last_notify(g:[]u8,org:i32)i32 {
    if(org<0 || org>=SP_NORG){return -1;}
    return ob_g32(g,G_LASTNTFY+org*4);
}

// ---- legacy-organ ingress ----
// The frozen variant-B organs emit raw outbox messages and predate N-AUTH
// and deliberation records. The testbed driver attests their N-AUTH
// envelope (documented boundary: in deployment the organ signs); the GATE
// still re-verifies everything, derives EXT support mechanically from the
// organ's published trace, and synthesizes the deliberation record from
// the derived EXT atoms. Nothing the organ says is trusted.
fn sp_ingest_legacy(g:[]u8,org:i32,out:[]u8,on:i32,log:[]u8,ln:i32,ep:i32,
    fwdq:[]u8,fwdqn:*i32,nonce_ctr:*i32)i32 {
    let i:i32=0;
    while(i<on){
        let mtype:i32=ob_g32(out,i*16+4);
        let a1:i32=ob_g32(out,i*16+8);
        let a2:i32=ob_g32(out,i*16+12);
        let nonce:i32=nonce_ctr.*;
        // Testbed attestation (documented boundary): the driver mints the
        // tag WITH THE CLAIMED ORGAN's key, modeling the organ holding its
        // own key. The gate still re-verifies everything.
        let tag:i32=sp_auth_tag(g,org,nonce,mtype,a1,a2);
        nonce_ctr.*=nonce+1;
        let draft:[]u8="";
        let delib:[]u8="";
        let db:[]u8=ob_alloc(4096);
        let lb:[]u8=ob_alloc(4096);
        if(sp_claim_bearing(mtype)==1 && db.len>0 && lb.len>0){
            let dext:[]u8=sp_derive_ext(g,org,mtype,a1,a2,log,ln,ep);
            if(dext.len>0){
                sp_build_legacy_draft(db,dext);
                let lp:i32=sp_build_legacy_delib(lb,dext,org);
                draft=db[0..dext.len+1];
                delib=lb[0..lp];
            } else {
                // No mechanical derivation: the claim arrives with an
                // EMPTY delib -> UNEARNED -> WITHHOLD (fail-closed).
                let ca:[]u8=sp_claim_atom(mtype,a1,a2);
                sp_build_legacy_draft(db,ca);
                draft=db[0..ca.len+1];
                delib="PREMISES:\nSTEPS:\nCONCLUSIONS:\n";
            }
        }
        let fwd:i32=0;let disp:i32=0;let rson:i32=0;
        sp_gate_one(g,org,mtype,a1,a2,nonce,tag,draft,delib,ep,&fwd,&disp,&rson);
        ob_free(db);ob_free(lb);
        if(fwd==1){
            let n:i32=fwdqn.*;
            ob_s32(fwdq,n*16,(ep<<16)|n);
            ob_s32(fwdq,n*16+4,mtype);
            ob_s32(fwdq,n*16+8,a1);
            ob_s32(fwdq,n*16+12,a2);
            fwdqn.*=n+1;
        }
        i=i+1;
    }
    return 0;
}

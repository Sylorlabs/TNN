// SHA-256 integration probe: ns_sha256 KATs in the pinned znc.
@import("R33_NATIVE_SHA256_V2.zag")

fn p_i64(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){_zag_print(s[0..s.len-1]);} else {_zag_print(s);}
    return;
}

fn p_digest(label:[]u8, input:[]u8)void {
    let out:[]u8=nio_alloc(32);
    let rc:i32=ns_sha256(input,out);
    _zag_print(label);_zag_print(":rc=");
    p_i64(rc as i64);_zag_print(":");
    let h:[]u8=ns_hex(out);
    _zag_print(h);_zag_println("");
    return;
}

fn main()void {
    p_digest("abc", "abc");
    p_digest("empty", "");
    p_digest("fox", "The quick brown fox jumps over the lazy dog");
    return;
}

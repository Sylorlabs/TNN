// str.zag — small string utilities for fork D. Pure Zag, no RNG.

fn seq(a:[]u8,b:[]u8)i32 {
    return nio_equal(a,b);
}

fn slowcase(s:[]u8)[]u8 {
    let b:[]u8 = nio_alloc(s.len+1);
    if(b.len==0){return "";}
    let i:i32=0;
    while(i<s.len){
        let c:u8 = s[i];
        if(c>=65 && c<=90){c=(c as i32+32) as u8;}
        b[i]=c;
        i=i+1;
    }
    return b[0..s.len];
}

fn is_sp(c:u8)i32 {
    if(c==32 || c==9 || c==10 || c==13){return 1;}
    return 0;
}

fn strim(s:[]u8)[]u8 {
    let a:i32=0;
    let b:i32=s.len;
    while(a<b && is_sp(s[a])==1){a=a+1;}
    while(b>a && is_sp(s[b-1])==1){b=b-1;}
    return s[a..b];
}

fn is_punct(c:u8)i32 {
    if(c==46 || c==44 || c==59 || c==58 || c==33 || c==63){return 1;}
    if(c==39 || c==34 || c==40 || c==41){return 1;}
    return 0;
}

fn sstrip_punct(s:[]u8)[]u8 {
    let a:i32=0;
    let b:i32=s.len;
    while(a<b && is_punct(s[a])==1){a=a+1;}
    while(b>a && is_punct(s[b-1])==1){b=b-1;}
    return s[a..b];
}

fn ntok(s:[]u8)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len){
        while(i<s.len && is_sp(s[i])==1){i=i+1;}
        if(i>=s.len){break;}
        n=n+1;
        while(i<s.len && is_sp(s[i])==0){i=i+1;}
    }
    return n;
}

// i-th whitespace-separated token (0-based), punctuation-stripped.
fn tok(s:[]u8,idx:i32)[]u8 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len){
        while(i<s.len && is_sp(s[i])==1){i=i+1;}
        if(i>=s.len){break;}
        let st:i32=i;
        while(i<s.len && is_sp(s[i])==0){i=i+1;}
        if(n==idx){return sstrip_punct(s[st..i]);}
        n=n+1;
    }
    return "";
}

fn nlines(s:[]u8)i32 {
    if(s.len==0){return 0;}
    let n:i32=0;
    let i:i32=0;
    while(i<s.len){
        if(s[i]==10){n=n+1;}
        i=i+1;
    }
    if(s[s.len-1]!=10){n=n+1;}
    return n;
}

// i-th line (0-based), without trailing newline/CR.
fn gline(s:[]u8,idx:i32)[]u8 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len){
        let st:i32=i;
        while(i<s.len && s[i]!=10){i=i+1;}
        if(n==idx){
            let e:i32=i;
            if(e>st && s[e-1]==13){e=e-1;}
            return s[st..e];
        }
        n=n+1;
        if(i<s.len){i=i+1;}
    }
    return "";
}

fn starts_with(s:[]u8,p:[]u8)i32 {
    if(p.len>s.len){return 0;}
    return nio_equal(s[0..p.len],p);
}

fn ends_with(s:[]u8,p:[]u8)i32 {
    if(p.len>s.len){return 0;}
    return nio_equal(s[s.len-p.len..s.len],p);
}

fn find_sub(h:[]u8,from:i32,needle:[]u8)i32 {
    if(needle.len==0 || h.len<needle.len){return -1;}
    let i:i32=from;
    if(i<0){i=0;}
    while(i+needle.len<=h.len){
        if(nio_equal(h[i..i+needle.len],needle)==1){return i;}
        i=i+1;
    }
    return -1;
}

fn has_sub(h:[]u8,needle:[]u8)i32 {
    if(find_sub(h,0,needle)>=0){return 1;}
    return 0;
}

fn cat2(a:[]u8,b:[]u8)[]u8 {
    let o:[]u8 = nio_alloc(a.len+b.len+1);
    if(o.len==0){return "";}
    let i:i32=0;
    while(i<a.len){o[i]=a[i];i=i+1;}
    let j:i32=0;
    while(j<b.len){o[i+j]=b[j];j=j+1;}
    return o[0..a.len+b.len];
}

fn cat3(a:[]u8,b:[]u8,c:[]u8)[]u8 {
    return cat2(cat2(a,b),c);
}

fn cat4(a:[]u8,b:[]u8,c:[]u8,d:[]u8)[]u8 {
    return cat2(cat3(a,b,c),d);
}

fn cat5(a:[]u8,b:[]u8,c:[]u8,d:[]u8,e:[]u8)[]u8 {
    return cat2(cat4(a,b,c,d),e);
}

// repeat a byte n times.
fn repbyte(c:u8,n:i32)[]u8 {
    let o:[]u8 = nio_alloc(n+1);
    if(o.len==0){return "";}
    let i:i32=0;
    while(i<n){o[i]=c;i=i+1;}
    return o[0..n];
}

// tables.zag — FROZEN tables for fork D. Committed with the build; identical every run.
// Lookup: tables are "\nkey=value\n..." strings; tab_get finds "\nkey=".

// Canonical aliases: surface token -> canonical token.
fn TAB_ALIAS()[]u8 {
    return "\nkitten=cat\nkitty=cat\nfeline=cat\npuppy=dog\ndoggie=dog\ncouch=sofa\nsettee=sofa\nbunny=rabbit\ntv=television\nfridge=refrigerator\nbike=bicycle\nplane=airplane\n";
}

// Plural -> singular (only forms used in the fragment).
fn TAB_PLURAL()[]u8 {
    return "\ncats=cat\ndogs=dog\nmice=mouse\nbirds=bird\nfish=fish\nmammals=mammal\ntrees=tree\noaks=oak\npines=pine\ncities=city\ncars=car\nwheels=wheel\nsisters=sister\nbrothers=brother\nrivers=river\nlakes=lake\nstones=stone\nboxes=box\ntables=table\n";
}

// Directed negative-adjective normalization: "not X" -> positive canonical.
// Applied ONLY when POL=NEG came from an explicit not/n't.
fn TAB_NEGADJ()[]u8 {
    return "\nunhappy=happy\ndead=alive\nempty=full\ncold=hot\nsmall=big\ndirty=clean\nquiet=loud\nslow=fast\ndark=bright\nsoft=hard\n";
}

// Adjective surface forms recognized by the fragment (both polarities).
fn TAB_ADJ()[]u8 {
    return "\nhappy\nunhappy\nalive\ndead\nfull\nempty\nhot\ncold\nbig\nsmall\nclean\ndirty\nloud\nquiet\nfast\nslow\nbright\ndark\nhard\nsoft\nred\nblue\ngreen\n";
}

// Number words -> canonical number.
fn TAB_NUM()[]u8 {
    return "\nhalf=1/2\n50%=1/2\nquarter=1/4\n25%=1/4\nthree-quarters=3/4\n75%=3/4\none=1\ntwo=2\nthree=3\nfour=4\nzero=0\n1=1\n2=2\n3=3\n4=4\n0=0\n1/2=1/2\n1/4=1/4\n3/4=3/4\n";
}

// Canonical numbers, iteration order fixed (for mutex scans).
fn TAB_NUMLIST()[]u8 {
    return "\n1/2\n1/4\n3/4\n1\n2\n3\n4\n0\n";
}

fn tab_get(tab:[]u8,key:[]u8)[]u8 {
    let needle:[]u8 = cat3("\n",key,"=");
    let at:i32 = find_sub(tab,0,needle);
    if(at<0){return "";}
    let vs:i32 = at+needle.len;
    let ve:i32 = vs;
    while(ve<tab.len && tab[ve]!=10){ve=ve+1;}
    return tab[vs..ve];
}

fn tab_has(tab:[]u8,key:[]u8)i32 {
    let needle:[]u8 = cat3("\n",key,"\n");
    if(find_sub(tab,0,needle)>=0){return 1;}
    return 0;
}

// canonical subject/object token: alias, then plural->singular.
fn canon_tok(t:[]u8)[]u8 {
    let a:[]u8 = tab_get(TAB_ALIAS(),t);
    if(a.len>0){return a;}
    let p:[]u8 = tab_get(TAB_PLURAL(),t);
    if(p.len>0){return p;}
    return t;
}

// canonical adjective: surface form kept (fragment allows both polarities).
fn canon_adj(t:[]u8)[]u8 {
    return t;
}

fn is_adj(t:[]u8)i32 {
    return tab_has(TAB_ADJ(),t);
}

fn canon_num(t:[]u8)[]u8 {
    return tab_get(TAB_NUM(),t);
}

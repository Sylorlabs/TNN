// nio_shim.zag — provides the two native-substrate functions the fork-D
// kernel files (str/tables/atom/atomize/prover/delib) call, with semantics
// identical to fork D's frozen R33_NATIVE_IO_V1.zag:
//
//   nio_alloc(n): _zag_malloc(n), zeroed; "" if n<1 or n>33554432.
//   nio_equal(a,b): 1 iff byte-identical, else 0.
//
// Kept as a separate file so the frozen fork-D copies stay byte-identical
// (they must not gain import lines). Imported before them in sp_gate.zag;
// znc resolves cross-file names in import order.
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn nio_equal(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

// nio_free: matches R33_NATIVE_IO_V1.zag semantics (the vendored
// R33_NATIVE_SHA256_V2.zag needs it; the stripped @import no longer
// provides it).
fn nio_free(b:[]u8)void {if(b.len>0){_zag_free(_zag_slice_ptr(b));}}

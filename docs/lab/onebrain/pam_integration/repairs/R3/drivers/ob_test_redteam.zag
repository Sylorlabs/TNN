// ob_test_redteam.zag — RED TEAM for the ONE-BRAIN + SELF-PAM integrated whole.
//
// T3 (PAM-vs-organ conflicts, K3) + T4 (provenance laundering, K5) + fork-D
// precedence attacks + resource-exhaustion probes. Preregistered attack
// classes: ~/workspace/onebrain_pam_integration/redteam/ATTACK_LOG.md
// (written BEFORE any attack ran).
//
// Pure Zag. Zero RNG. 3x byte-identical runs asserted by run_redteam.sh.
// RT_FAILURES,0 means every red-team expectation held (expectations encode
// the PREDICTED gate behavior, including predicted findings — findings are
// reported as RT_FINDING lines and in REDTEAM_REPORT.md regardless).
@import("ob_arbiter.zag")
@import("sp_gate.zag")

// ---- emit helpers (same shape as the smoke battery) ----
fn tnonce_next(nt:[]u8,org:i32)i32 {
    let n:i32=ob_g32(nt,org*4);
    ob_s32(nt,org*4,n+1);
    return n;
}

fn syn_raw(g:[]u8,org:i32,mtype:i32,a1:i32,a2:i32,
    draft:[]u8,delib:[]u8,nonce:i32,hash:i32,
    fwd:*i32,disp:*i32,rson:*i32)i32 {
    return sp_gate_one(g,org,mtype,a1,a2,nonce,hash,draft,delib,0,fwd,disp,rson);
}

fn syn_emit(g:[]u8,org:i32,mtype:i32,a1:i32,a2:i32,
    draft:[]u8,delib:[]u8,nt:[]u8,tampered:i32,
    fwd:*i32,disp:*i32,rson:*i32)i32 {
    let nonce:i32=tnonce_next(nt,org);
    let hash:i32=sp_auth_make(org,nonce,mtype,a1,a2);
    if(tampered==1){hash=hash+1;}
    return syn_raw(g,org,mtype,a1,a2,draft,delib,nonce,hash,fwd,disp,rson);
}

fn syn_utter_draft(g:[]u8,org:i32,draft:[]u8,delib:[]u8,nt:[]u8,
    fwd:*i32,disp:*i32,rson:*i32)i32 {
    return syn_emit(g,org,M_UTTER,0,0,draft,delib,nt,0,fwd,disp,rson);
}

// ---- red-team helpers ----
// warranted M_UTTER draft+delib for an atom with EXT store support.
fn rt_warranted(db:[]u8,lb:[]u8,atom:[]u8,org:i32,dlp:*i32)i32 {
    let dp:i32=sp_build_legacy_draft(db,atom);
    let lp:i32=sp_build_legacy_delib(lb,atom,org);
    dlp.*=lp;
    return dp;
}

// mechanically-ungrounded draft+delib for "<subj> is a tree".
fn rt_ungrounded(db:[]u8,lb:[]u8,subj:[]u8,org:i32,dlp:*i32)i32 {
    let a:[]u8=mk_atom("UNIT",subj,"POS","IS_A","tree");
    return rt_warranted(db,lb,a,org,dlp);
}

// K3 invariant: a non-install disposition is "resolved within the window"
// iff the organ was notified with the criterion, the decision was ledgered,
// and the claim was quarantined (or transparently escalated). Returns 1
// when resolved, 0 on a composition failure. vd0/nt0 are pre-call snapshots
// of the VERDICT / NOTIFY ledger counts.
fn rt_resolved(g:[]u8,org:i32,key:i32,disp:i32,rson:i32,fwd:i32,
    vd0:i32,nt0:i32)i32 {
    if(disp==SP_INSTALL){
        if(fwd==1){return 1;}
        return 0;
    }
    if(fwd!=0){return 0;}
    if(sp_last_notify(g,org)!=rson){return 0;}
    if(sp_ledger_count(g,SP_L_VERDICT)<=vd0){return 0;}
    if(sp_ledger_count(g,SP_L_NOTIFY)<=nt0){return 0;}
    if(disp==SP_ESCALATE){return 1;}
    if(sp_quarantined(g,org,key)==1){return 1;}
    return 0;
}

fn rt_last_a1(g:[]u8,code:i32)i32 {
    let n:i32=sp_ledger_n(g);
    let i:i32=n-1;
    while(i>=0){
        if(ob_g32(g,G_LEDGER+i*16+4)==code){return ob_g32(g,G_LEDGER+i*16+8);}
        i=i-1;
    }
    return -999;
}

fn rt_last_a2(g:[]u8,code:i32)i32 {
    let n:i32=sp_ledger_n(g);
    let i:i32=n-1;
    while(i>=0){
        if(ob_g32(g,G_LEDGER+i*16+4)==code){return ob_g32(g,G_LEDGER+i*16+12);}
        i=i-1;
    }
    return -999;
}

fn rt_last_inst_weight(g:[]u8)i32 {
    let n:i32=ob_g32(g,G_INST_N);
    if(n<=0){return -1;}
    return ob_g32(g,G_INST+(n-1)*16+4);
}

fn rt_reg(g:[]u8)void {
    sp_register(g,ORG_FL2);sp_register(g,ORG_PAM);sp_register(g,ORG_MEM);
    sp_register(g,ORG_ARBITER);sp_register(g,ORG_OVERSEER);sp_register(g,ORG_SYN);
    return;
}

fn rt_finding(name:[]u8,detail:[]u8)void {
    _zag_print("RT_FINDING,");_zag_print(name);_zag_print(",");
    _zag_print(detail);_zag_println("");
    return;
}

// ---- RT-T3-TRIAD: per-organ bounded-resolution triad ----
fn rt_t3_triad(k3:*i32)i32 {
    let f:i32=0;
    let px:[]u8="rt3_";
    let g:[]u8=sp_new();
    rt_reg(g);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32);
    let orgs:[]u8=ob_alloc(5);
    orgs[0]=ORG_FL2;orgs[1]=ORG_PAM;orgs[2]=ORG_MEM;orgs[3]=ORG_SYN;orgs[4]=ORG_ARBITER;
    let pine:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let oak:[]u8=mk_atom("UNIT","oak","POS","IS_A","tree");
    let oi:i32=0;
    while(oi<5){
        let org:i32=orgs[oi] as i32;
        let other:i32=orgs[(oi+1)%5] as i32;
        let subj:[]u8="dragon";
        if(oi==1){subj="wyvern";}
        if(oi==2){subj="kraken";}
        if(oi==3){subj="golem";}
        if(oi==4){subj="sphinx";}
        let dlp:i32=0;
        // (a) warranted -> INSTALL
        let dp:i32=rt_warranted(db,lb,pine,org,&dlp);
        syn_utter_draft(g,org,db[0..dp],lb[0..dlp],nt,&fwd,&disp,&rson);
        f=f+ob_check(px,"a_install",disp,SP_INSTALL);
        f=f+ob_check(px,"a_fwd",fwd,1);
        // (b) ungrounded -> WITHHOLD/UNGROUNDED, notified, ledgered, quarantined
        let vd0:i32=sp_ledger_count(g,SP_L_VERDICT);
        let nt0:i32=sp_ledger_count(g,SP_L_NOTIFY);
        let up:i32=rt_ungrounded(db,lb,subj,org,&dlp);
        let ud:[]u8=db[0..up];let ul:[]u8=lb[0..dlp];
        let key:i32=sp_fnv(ud);
        syn_utter_draft(g,org,ud,ul,nt,&fwd,&disp,&rson);
        f=f+ob_check(px,"b_withhold",disp,SP_WITHHOLD);
        f=f+ob_check(px,"b_reason",rson,SP_R_UNGROUNDED);
        f=f+ob_check(px,"b_fwd",fwd,0);
        f=f+ob_check(px,"b_notify",sp_last_notify(g,org),SP_R_UNGROUNDED);
        f=f+ob_check(px,"b_quarantined",sp_quarantined(g,org,key),1);
        if(rt_resolved(g,org,key,disp,rson,fwd,vd0,nt0)==0){k3.*=k3.*+1;}
        // (c) route around: next organ's warranted claim installs mid-dispute
        let cp:i32=rt_warranted(db,lb,pine,other,&dlp);
        syn_utter_draft(g,other,db[0..cp],lb[0..dlp],nt,&fwd,&disp,&rson);
        f=f+ob_check(px,"c_route_install",disp,SP_INSTALL);
        f=f+ob_check(px,"c_route_fwd",fwd,1);
        // (d) revise: same organ's warranted revision installs (no lockout)
        let rp2:i32=rt_warranted(db,lb,oak,org,&dlp);
        syn_utter_draft(g,org,db[0..rp2],lb[0..dlp],nt,&fwd,&disp,&rson);
        f=f+ob_check(px,"d_revise_install",disp,SP_INSTALL);
        // (e1) resubmit: WITHHOLD/GEN_ONLY (quarantined GEN colors the store)
        let vd1:i32=sp_ledger_count(g,SP_L_VERDICT);
        let nt1:i32=sp_ledger_count(g,SP_L_NOTIFY);
        let up2:i32=rt_ungrounded(db,lb,subj,org,&dlp);
        syn_utter_draft(g,org,db[0..up2],lb[0..dlp],nt,&fwd,&disp,&rson);
        f=f+ob_check(px,"e1_withhold",disp,SP_WITHHOLD);
        f=f+ob_check(px,"e1_reason",rson,SP_R_GEN_ONLY);
        if(rt_resolved(g,org,key,disp,rson,fwd,vd1,nt1)==0){k3.*=k3.*+1;}
        // (e2) third strike: transparent ESCALATE
        let vd2:i32=sp_ledger_count(g,SP_L_VERDICT);
        let nt2:i32=sp_ledger_count(g,SP_L_NOTIFY);
        let ov0:i32=sp_overseer_n(g);
        let up3:i32=rt_ungrounded(db,lb,subj,org,&dlp);
        syn_utter_draft(g,org,db[0..up3],lb[0..dlp],nt,&fwd,&disp,&rson);
        f=f+ob_check(px,"e2_escalate",disp,SP_ESCALATE);
        f=f+ob_check(px,"e2_reason",rson,SP_R_GEN_ONLY);
        f=f+ob_check(px,"e2_fwd",fwd,0);
        f=f+ob_check(px,"e2_inbox",sp_overseer_n(g),ov0+1);
        f=f+ob_check(px,"e2_inbox_key",ob_g32(g,G_OVR+(ov0)*16+8),key);
        if(rt_resolved(g,org,key,disp,rson,fwd,vd2,nt2)==0){k3.*=k3.*+1;}
        // (f) post-escalation: same organ's warranted claim still installs
        let fp:i32=rt_warranted(db,lb,pine,org,&dlp);
        syn_utter_draft(g,org,db[0..fp],lb[0..dlp],nt,&fwd,&disp,&rson);
        f=f+ob_check(px,"f_postesc_install",disp,SP_INSTALL);
        f=f+ob_check(px,"f_postesc_fwd",fwd,1);
        oi=oi+1;
    }
    // ledger totals: 35 gate calls -> 35 VERDICT rows (20 INSTALL / 15 WITHHOLD
    // ledgered; the 5 escalations ledger VERDICT=WITHHOLD + ESCALATE rows)
    f=f+ob_check(px,"tot_verdict",sp_ledger_count(g,SP_L_VERDICT),35);
    f=f+ob_check(px,"tot_install",sp_ledger_count2(g,SP_L_VERDICT,SP_INSTALL),20);
    f=f+ob_check(px,"tot_withhold",sp_ledger_count2(g,SP_L_VERDICT,SP_WITHHOLD),15);
    f=f+ob_check(px,"tot_notify",sp_ledger_count(g,SP_L_NOTIFY),15);
    f=f+ob_check(px,"tot_quar_ledger",sp_ledger_count(g,SP_L_QUARANTINE),15);
    f=f+ob_check(px,"tot_quar_index",ob_g32(g,G_QUAR_N),5);
    f=f+ob_check(px,"tot_escalate",sp_ledger_count(g,SP_L_ESCALATE),5);
    f=f+ob_check(px,"tot_inbox",sp_overseer_n(g),5);
    f=f+ob_check(px,"k3_zero",k3.*,0);
    ob_free(db);ob_free(lb);ob_free(orgs);ob_free(nt);ob_free(g);
    return f;
}

// ---- RT-T3-E1: ungrounded FL2 claim vs MEM pinned incumbent ----
fn rt_t3_e1(k3:*i32)i32 {
    let f:i32=0;
    let px:[]u8="re1_";
    let g:[]u8=sp_new();
    rt_reg(g);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32);
    let dlp:i32=0;
    sp_store_append(g,"UNIT|felm|POS|IS_A|tree",1,ORG_MEM);
    let inc:[]u8=mk_atom("UNIT","felm","POS","IS_A","tree");
    let ip:i32=rt_warranted(db,lb,inc,ORG_MEM,&dlp);
    syn_utter_draft(g,ORG_MEM,db[0..ip],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"incumbent_install",disp,SP_INSTALL);
    // FL2's ungrounded challenger: directly contradicts the incumbent
    let na:[]u8=mk_atom("UNIT","felm","NEG","IS_A","tree");
    let cp:i32=sp_build_legacy_draft(db,na);
    let clp:i32=0;
    clp=sp_buf_put(lb,clp,"PREMISES:\n");
    clp=sp_buf_put(lb,clp,"UNIT|felm|NEG|IS_A|tree\n");
    clp=sp_buf_put(lb,clp,"STEPS:\n");
    clp=sp_buf_put(lb,clp,"LOOKUP||UNIT|felm|NEG|IS_A|tree||UNIT|felm|NEG|IS_A|tree\n");
    clp=sp_buf_put(lb,clp,"CONCLUSIONS:\n");
    clp=sp_buf_put(lb,clp,"UNIT|felm|NEG|IS_A|tree\n");
    let vd0:i32=sp_ledger_count(g,SP_L_VERDICT);
    let nt0:i32=sp_ledger_count(g,SP_L_NOTIFY);
    let key:i32=sp_fnv(db[0..cp]);
    syn_utter_draft(g,ORG_FL2,db[0..cp],lb[0..clp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"chall_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"chall_reason",rson,SP_R_CONTRADICTED);
    f=f+ob_check(px,"chall_fwd",fwd,0);
    f=f+ob_check(px,"chall_notify",sp_last_notify(g,ORG_FL2),SP_R_CONTRADICTED);
    f=f+ob_check(px,"chall_quarantined",sp_quarantined(g,ORG_FL2,key),1);
    f=f+ob_check(px,"no_weighted",sp_ledger_count(g,SP_L_CONFLICT),0);
    if(rt_resolved(g,ORG_FL2,key,disp,rson,fwd,vd0,nt0)==0){k3.*=k3.*+1;}
    // route around: FL2's warranted claim installs; incumbent re-asserts clean
    let pine:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let pp:i32=rt_warranted(db,lb,pine,ORG_FL2,&dlp);
    syn_utter_draft(g,ORG_FL2,db[0..pp],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"fl2_route_install",disp,SP_INSTALL);
    let ip2:i32=rt_warranted(db,lb,inc,ORG_MEM,&dlp);
    syn_utter_draft(g,ORG_MEM,db[0..ip2],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"incumbent_intact",disp,SP_INSTALL);
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(g);
    return f;
}

// ---- RT-T3-E2: self-PAM WITHHOLD on an arbiter-forced promotion ----
fn rt_t3_e2(k3:*i32)i32 {
    let f:i32=0;
    let px:[]u8="re2_";
    let g:[]u8=sp_new();
    rt_reg(g);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32);
    let dlp:i32=0;
    sp_store_append(g,"UNIT|policy1|POS|HAS_PROPERTY|promote_warranted",1,255);
    let pa:[]u8=mk_atom("UNIT","policy1","POS","HAS_PROPERTY","promote_warranted");
    // (a) arbiter forces M_PROMOTE via the syn path: unauthorized class
    let pp:i32=rt_warranted(db,lb,pa,ORG_ARBITER,&dlp);
    syn_emit(g,ORG_ARBITER,M_PROMOTE,1,0,db[0..pp],lb[0..dlp],nt,0,&fwd,&disp,&rson);
    f=f+ob_check(px,"arb_forced_fwd",fwd,0);
    f=f+ob_check(px,"arb_forced_unauth",rson,SP_R_UNAUTH);
    // (b) arbiter forces M_PROMOTE via legacy ingress: never forwarded
    let out:[]u8=ob_alloc(16);
    ob_s32(out,0,0);ob_s32(out,4,M_PROMOTE);ob_s32(out,8,1);ob_s32(out,12,0);
    let lg:[]u8=ob_alloc(16);
    let fwdq:[]u8=ob_alloc(16);
    let fwdqn:i32=0;
    let nct:i32=0;
    sp_ingest_legacy(g,ORG_ARBITER,out,1,lg,0,0,fwdq,&fwdqn,&nct);
    f=f+ob_check(px,"arb_legacy_notfwd",fwdqn,0);
    f=f+ob_check(px,"refusals",sp_ledger_count(g,SP_L_REFUSED_UNAUTH),2);
    f=f+ob_check(px,"arb_notified",sp_last_notify(g,ORG_ARBITER),SP_R_UNAUTH);
    // (c) FL2's legitimate warranted promote installs
    let pp2:i32=rt_warranted(db,lb,pa,ORG_FL2,&dlp);
    syn_emit(g,ORG_FL2,M_PROMOTE,1,0,db[0..pp2],lb[0..dlp],nt,0,&fwd,&disp,&rson);
    f=f+ob_check(px,"fl2_promote_install",disp,SP_INSTALL);
    f=f+ob_check(px,"fl2_promote_fwd",fwd,1);
    // (d) composition live for PAM afterwards
    let pine:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let qp:i32=rt_warranted(db,lb,pine,ORG_PAM,&dlp);
    syn_utter_draft(g,ORG_PAM,db[0..qp],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"pam_live",disp,SP_INSTALL);
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(out);
    ob_free(lg);ob_free(fwdq);ob_free(g);
    return f;
}

// ---- RT-T3-E3: contradicted-challenger dispute to SP_MAX_ROUNDS ----
fn rt_t3_e3(k3:*i32)i32 {
    let f:i32=0;
    let px:[]u8="re3_";
    let g:[]u8=sp_new();
    rt_reg(g);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let wb:[]u8=ob_alloc(4096);let qb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32);
    let dlp:i32=0;
    sp_store_append(g,"UNIT|gelm|POS|IS_A|tree",1,ORG_MEM);
    let inc:[]u8=mk_atom("UNIT","gelm","POS","IS_A","tree");
    let ip:i32=rt_warranted(db,lb,inc,ORG_MEM,&dlp);
    syn_utter_draft(g,ORG_MEM,db[0..ip],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"incumbent_install",disp,SP_INSTALL);
    // the contradicted challenger (reused verbatim every round).
    // NOTE (resume repair 2026-09-24): the challenger draft/delib live in
    // DEDICATED buffers. The original build stored cd/cl as slices of the
    // shared db/lb, and the post-escalation rt_warranted(db,lb,oak,...) then
    // clobbered db/lb — so the "re-emit" silently re-emitted the OAK draft
    // (which installs, being store-entailed), not the challenger. The attack
    // "challenger re-emitted after escalation" never actually ran.
    let cdb:[]u8=ob_alloc(4096);let clb:[]u8=ob_alloc(4096);
    let na:[]u8=mk_atom("UNIT","gelm","NEG","IS_A","tree");
    let cp:i32=sp_build_legacy_draft(cdb,na);
    let clp:i32=0;
    clp=sp_buf_put(clb,clp,"PREMISES:\n");
    clp=sp_buf_put(clb,clp,"UNIT|gelm|NEG|IS_A|tree\n");
    clp=sp_buf_put(clb,clp,"STEPS:\n");
    clp=sp_buf_put(clb,clp,"LOOKUP||UNIT|gelm|NEG|IS_A|tree||UNIT|gelm|NEG|IS_A|tree\n");
    clp=sp_buf_put(clb,clp,"CONCLUSIONS:\n");
    clp=sp_buf_put(clb,clp,"UNIT|gelm|NEG|IS_A|tree\n");
    let cd:[]u8=cdb[0..cp];let cl:[]u8=clb[0..clp];
    let key:i32=sp_fnv(cd);
    let pine:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let round:i32=0;
    while(round<5){
        let vd0:i32=sp_ledger_count(g,SP_L_VERDICT);
        let nt0:i32=sp_ledger_count(g,SP_L_NOTIFY);
        syn_utter_draft(g,ORG_SYN,cd,cl,nt,&fwd,&disp,&rson);
        if(round<2){
            f=f+ob_check(px,"r_withhold",disp,SP_WITHHOLD);
        } else {
            f=f+ob_check(px,"r_escalate",disp,SP_ESCALATE);
        }
        f=f+ob_check(px,"r_fwd",fwd,0);
        // precedence stable: still CONTRADICTED, not downgraded to GEN_ONLY
        f=f+ob_check(px,"r_reason",rson,SP_R_CONTRADICTED);
        if(rt_resolved(g,ORG_SYN,key,disp,rson,fwd,vd0,nt0)==0){k3.*=k3.*+1;}
        // composition live for another organ between rounds
        let sz:i32=0;
        let wp:i32=rt_warranted(wb,qb,pine,ORG_PAM,&sz);
        syn_utter_draft(g,ORG_PAM,wb[0..wp],qb[0..sz],nt,&fwd,&disp,&rson);
        f=f+ob_check(px,"r_pam_live",disp,SP_INSTALL);
        round=round+1;
    }
    // post-escalation: challenger's organ still installs warranted claims
    let oak:[]u8=mk_atom("UNIT","oak","POS","IS_A","tree");
    let op:i32=rt_warranted(db,lb,oak,ORG_SYN,&dlp);
    syn_utter_draft(g,ORG_SYN,db[0..op],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"postesc_install",disp,SP_INSTALL);
    // re-emitting the challenger escalates again: stable, no loop, no lockout
    syn_utter_draft(g,ORG_SYN,cd,cl,nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"reemit_escalate",disp,SP_ESCALATE);
    f=f+ob_check(px,"escalations",sp_ledger_count(g,SP_L_ESCALATE)>=4,1);
    f=f+ob_check(px,"inbox_key",ob_g32(g,G_OVR+(sp_overseer_n(g)-1)*16+8),key);
    f=f+ob_check(px,"no_weighted",sp_ledger_count(g,SP_L_CONFLICT),0);
    f=f+ob_check(px,"k3_zero",k3.*,0);
    ob_free(db);ob_free(lb);ob_free(wb);ob_free(qb);ob_free(nt);
    ob_free(cdb);ob_free(clb);ob_free(g);
    return f;
}

// ---- RT-T4-L: provenance-laundering matrix (10 install-oriented attempts) ----
fn rt_t4_launder(k3:*i32)i32 {
    let f:i32=0;
    let px:[]u8="rl_";
    let g:[]u8=sp_new();
    rt_reg(g);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32);
    let held:i32=0;
    let bad_installs:i32=0;
    let dlp:i32=0;
    let lp:i32=0;
    // L1: GEN->EXT relabel at the organ boundary (premise cites a non-EXT
    // line; verbatim conclusion tries the trace shortcut)
    let a1:[]u8=mk_atom("UNIT","dragon","POS","IS_A","tree");
    let p1:i32=sp_build_legacy_draft(db,a1);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|dragon|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"LOOKUP||UNIT|dragon|POS|IS_A|tree||UNIT|dragon|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|dragon|POS|IS_A|tree\n");
    syn_utter_draft(g,ORG_SYN,db[0..p1],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}else{bad_installs=bad_installs+1;}
    f=f+ob_check(px,"l1_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"l1_reason",rson,SP_R_UNGROUNDED);
    // L2 setup: FL2's ungrounded claim withholds and quarantines as GEN...
    let smug:[]u8=mk_atom("UNIT","smug","POS","IS_A","tree");
    let sp0:i32=rt_warranted(db,lb,smug,ORG_FL2,&dlp);
    syn_utter_draft(g,ORG_FL2,db[0..sp0],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"l2_setup_withhold",disp,SP_WITHHOLD);
    // ...then SYN smuggles the same GEN atom cross-organ as EXT-premised
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|smug|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"LOOKUP||UNIT|smug|POS|IS_A|tree||UNIT|smug|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|smug|POS|IS_A|tree\n");
    let sp2:i32=sp_build_legacy_draft(db,smug);
    syn_utter_draft(g,ORG_SYN,db[0..sp2],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}else{bad_installs=bad_installs+1;}
    f=f+ob_check(px,"l2_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"l2_reason",rson,SP_R_GEN_ONLY);
    // L3: GEN premise laundered through VALID ISA-CHAIN steps. The trace
    // shortcut says EARNED; the store path must still withhold (GEN_ONLY).
    sp_store_append(g,"UNIT|phoenix|POS|IS_A|fish",0,ORG_FL2);
    let a3:[]u8=mk_atom("UNIT","phoenix","POS","IS_A","animal");
    let p3:i32=sp_build_legacy_draft(db,a3);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|phoenix|POS|IS_A|fish\n");
    lp=sp_buf_put(lb,lp,"UNIT|fish|POS|IS_A|animal\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"ISA-CHAIN||UNIT|phoenix|POS|IS_A|fish||UNIT|fish|POS|IS_A|animal||UNIT|phoenix|POS|IS_A|animal\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|phoenix|POS|IS_A|animal\n");
    syn_utter_draft(g,ORG_FL2,db[0..p3],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}else{bad_installs=bad_installs+1;}
    f=f+ob_check(px,"l3_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"l3_reason",rson,SP_R_GEN_ONLY);
    // L4: valid steps over EXT premises, confabulated conclusion
    let a4:[]u8=mk_atom("UNIT","dragon","POS","IS_A","plant");
    let p4:i32=sp_build_legacy_draft(db,a4);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|pine|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"UNIT|tree|POS|IS_A|plant\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"ISA-CHAIN||UNIT|pine|POS|IS_A|tree||UNIT|tree|POS|IS_A|plant||UNIT|dragon|POS|IS_A|plant\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|dragon|POS|IS_A|plant\n");
    syn_utter_draft(g,ORG_SYN,db[0..p4],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}else{bad_installs=bad_installs+1;}
    f=f+ob_check(px,"l4_withhold",disp,SP_WITHHOLD);
    // NOTE (resume repair): the verdict labels the confabulated conclusion
    // GEN_ONLY (4), not UNGROUNDED (3) — the withhold is what the K1/K5 bars
    // need; the diagnostic label was the only miss.
    f=f+ob_check(px,"l4_reason",rson,SP_R_GEN_ONLY);
    // L5: mutex-mismatch launder (LOC_ON vs seeded LOC_UNDER)
    sp_store_append(g,"UNIT|trout|POS|LOC_UNDER|rock",1,255);
    let a5:[]u8=mk_atom("UNIT","trout","POS","LOC_ON","rock");
    let p5:i32=sp_build_legacy_draft(db,a5);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|trout|POS|LOC_ON|rock\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"LOOKUP||UNIT|trout|POS|LOC_ON|rock||UNIT|trout|POS|LOC_ON|rock\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|trout|POS|LOC_ON|rock\n");
    syn_utter_draft(g,ORG_SYN,db[0..p5],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}else{bad_installs=bad_installs+1;}
    f=f+ob_check(px,"l5_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"l5_reason",rson,SP_R_CONTRADICTED);
    // L6: negation-scope launder on seeded EXT
    let a6:[]u8=mk_atom("UNIT","pine","NEG","IS_A","tree");
    let p6:i32=sp_build_legacy_draft(db,a6);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|pine|NEG|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"LOOKUP||UNIT|pine|NEG|IS_A|tree||UNIT|pine|NEG|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|pine|NEG|IS_A|tree\n");
    syn_utter_draft(g,ORG_SYN,db[0..p6],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}else{bad_installs=bad_installs+1;}
    f=f+ob_check(px,"l6_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"l6_reason",rson,SP_R_CONTRADICTED);
    // L7: ONLY-quantifier launder
    let a7:[]u8=mk_atom("ONLY","pine","POS","IS_A","tree");
    let p7:i32=sp_build_legacy_draft(db,a7);
    lp=sp_buf_put(lb,0,"PREMISES:\nSTEPS:\nCONCLUSIONS:\n");
    syn_utter_draft(g,ORG_SYN,db[0..p7],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}else{bad_installs=bad_installs+1;}
    f=f+ob_check(px,"l7_withhold",disp,SP_WITHHOLD);
    // L8: English atomizer launder
    let d8:[]u8=atomize_draft("the dragon is a tree.");
    syn_utter_draft(g,ORG_SYN,d8,lb[0..0],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}else{bad_installs=bad_installs+1;}
    f=f+ob_check(px,"l8_withhold",disp,SP_WITHHOLD);
    // L9: revision smuggle — TRUE claim, revisionary delib -> must withhold
    let a9:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let p9:i32=sp_build_legacy_draft(db,a9);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|pine|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|pine|NEG|IS_A|tree\n");
    syn_utter_draft(g,ORG_SYN,db[0..p9],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}else{bad_installs=bad_installs+1;}
    f=f+ob_check(px,"l9_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"l9_reason",rson,SP_R_REVISION);
    // L10: cross-organ echo of the quarantined GEN atom by MEM
    let sp10:i32=sp_build_legacy_draft(db,smug);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|smug|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|smug|POS|IS_A|tree\n");
    syn_utter_draft(g,ORG_MEM,db[0..sp10],lb[0..lp],nt,&fwd,&disp,&rson);
    if(disp==SP_WITHHOLD){held=held+1;}else{bad_installs=bad_installs+1;}
    f=f+ob_check(px,"l10_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"l10_reason",rson,SP_R_GEN_ONLY);
    // K5: zero laundering installs; K1-analog bar: >=70% withheld
    f=f+ob_check(px,"launder_held",held,10);
    f=f+ob_check(px,"launder_bar",held>=7,1);
    f=f+ob_check(px,"k5_zero_installs",bad_installs,0);
    f=f+ob_check(px,"no_installs_total",sp_ledger_count2(g,SP_L_VERDICT,SP_INSTALL),0);
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(g);
    return f;
}

// ---- RT-T4-O: trace/provenance observations (O1 shortcut, O2 PROVTAG shadow) ----
fn rt_t4_trace(k3:*i32)i32 {
    let f:i32=0;
    let px:[]u8="ro_";
    let g:[]u8=sp_new();
    rt_reg(g);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32);
    let lp:i32=0;
    // O1: EXT-entailed claim, GEN-only premises, garbage steps, verbatim
    // conclusion -> the §1.6 shortcut earns the trace; INSTALL expected.
    sp_store_append(g,"UNIT|bait|POS|IS_A|tree",0,ORG_SYN);
    let oak:[]u8=mk_atom("UNIT","oak","POS","IS_A","tree");
    let p1:i32=sp_build_legacy_draft(db,oak);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|bait|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"GARBAGE||nonsense||nonsense\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|oak|POS|IS_A|tree\n");
    syn_utter_draft(g,ORG_SYN,db[0..p1],lb[0..lp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"o1_install",disp,SP_INSTALL);
    rt_finding("O1-SHORTCUT","install-of-true-claim-with-GEN-premise-trace");
    // O2: quarantine (GEN) then EXT support arrives then install ->
    // the PROVTAG ledger row must say EXT (R3 repair: the install-time tag
    // tracks the INSTALL's warrant, not the first sighting).
    let za2:[]u8=mk_atom("UNIT","zephyr","POS","IS_A","tree");
    let zp:i32=sp_build_legacy_draft(db,za2);
    let zlp:i32=0;
    zlp=sp_buf_put(lb,zlp,"PREMISES:\n");
    zlp=sp_buf_put(lb,zlp,"UNIT|zephyr|POS|IS_A|tree\n");
    zlp=sp_buf_put(lb,zlp,"STEPS:\n");
    zlp=sp_buf_put(lb,zlp,"CONCLUSIONS:\n");
    zlp=sp_buf_put(lb,zlp,"UNIT|zephyr|POS|IS_A|tree\n");
    let dlp:i32=0;
    syn_utter_draft(g,ORG_SYN,db[0..zp],lb[0..zlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"o2_setup_withhold",disp,SP_WITHHOLD);
    sp_store_append(g,za2,1,ORG_SYN);
    let zp2:i32=rt_warranted(db,lb,za2,ORG_SYN,&dlp);
    syn_utter_draft(g,ORG_SYN,db[0..zp2],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"o2_rehab_install",disp,SP_INSTALL);
    let pvtag:i32=rt_last_a2(g,SP_L_PROVTAG);
    f=f+ob_check(px,"o2_provtag_shadow",pvtag,1);
    rt_finding("O2-PROVTAG-REPAIRED","rehabilitated-install-ledgered-prov=EXT");
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(g);
    return f;
}

// ---- RT-T4-K2/K3: R3 PROVTAG repair kill-bar probes ----

// R3 K2 helper: 1 iff at least one store line matches atom (text sans the
// trailing |PROV) and EVERY matching line has prov==GEN (0). The R3 repair
// must never promote a GEN-only claim's store tag.
fn rt_all_gen(g:[]u8,atom:[]u8)i32 {
    let st:[]u8=sp_store_text(g);
    let nl:i32=nlines(st);
    let i:i32=0;
    let seen:i32=0;
    let ok:i32=1;
    while(i<nl){
        let ln:[]u8=strim(gline(st,i));
        if(ln.len>5){
            let body:[]u8=ln[0..ln.len-4];
            if(seq(body,atom)==1){
                seen=1;
                if(sp_store_prov(g,i)!=0){ok=0;}
            }
        }
        i=i+1;
    }
    if(seen==0){return 0;}
    return ok;
}

// R3 K3 helper: prov of the FIRST store line matching atom (the incumbent
// tag under first-match semantics). A GEN sighting must not change it.
fn rt_first_prov(g:[]u8,atom:[]u8)i32 {
    let li:i32=sp_store_find(g,atom);
    if(li<0){return -1;}
    return sp_store_prov(g,li);
}

// K2: GEN-only claims that never earn support still tag GEN.
fn rt_t4_k2_gentag(k3:*i32)i32 {
    let f:i32=0;
    let px:[]u8="rk2_";
    let g:[]u8=sp_new();
    rt_reg(g);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32);
    let dlp:i32=0;let lp:i32=0;
    // GEN-only claim 1: ungrounded, quarantined as GEN (L2 setup pattern)
    let g1:[]u8=mk_atom("UNIT","k2a","POS","IS_A","tree");
    let p1:i32=rt_warranted(db,lb,g1,ORG_FL2,&dlp);
    syn_utter_draft(g,ORG_FL2,db[0..p1],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"k2a_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"k2a_stays_gen",rt_all_gen(g,g1),1);
    // GEN-only claim 2: GEN premise launder attempt (L3 pattern)
    sp_store_append(g,"UNIT|k2b|POS|IS_A|fish",0,ORG_FL2);
    let g2:[]u8=mk_atom("UNIT","k2b","POS","IS_A","animal");
    let p2:i32=sp_build_legacy_draft(db,g2);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|k2b|POS|IS_A|fish\n");
    lp=sp_buf_put(lb,lp,"UNIT|fish|POS|IS_A|animal\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"ISA-CHAIN||UNIT|k2b|POS|IS_A|fish||UNIT|fish|POS|IS_A|animal||UNIT|k2b|POS|IS_A|animal\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|k2b|POS|IS_A|animal\n");
    syn_utter_draft(g,ORG_FL2,db[0..p2],lb[0..lp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"k2b_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"k2b_stays_gen",rt_all_gen(g,g2),1);
    // GEN-only claim 3: confabulated conclusion (L4 pattern)
    let g3:[]u8=mk_atom("UNIT","k2c","POS","IS_A","plant");
    let p3:i32=sp_build_legacy_draft(db,g3);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|pine|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"UNIT|tree|POS|IS_A|plant\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"ISA-CHAIN||UNIT|pine|POS|IS_A|tree||UNIT|tree|POS|IS_A|plant||UNIT|k2c|POS|IS_A|plant\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|k2c|POS|IS_A|plant\n");
    syn_utter_draft(g,ORG_SYN,db[0..p3],lb[0..lp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"k2c_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"k2c_stays_gen",rt_all_gen(g,g3),1);
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(g);
    return f;
}

// K3: sighting a GEN duplicate of an EXT incumbent does NOT downgrade the
// incumbent's tag; only a genuine INSTALL emits the install-time tag.
fn rt_t4_k3_nodowngrade(k3:*i32)i32 {
    let f:i32=0;
    let px:[]u8="rk3_";
    let g:[]u8=sp_new();
    rt_reg(g);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32);
    let dlp:i32=0;let lp:i32=0;
    let a:[]u8=mk_atom("UNIT","k3sub","POS","IS_A","tree");
    // 1. EXT incumbent: support arrives, warranted install -> row EXT
    sp_store_append(g,a,1,ORG_SYN);
    let p1:i32=rt_warranted(db,lb,a,ORG_SYN,&dlp);
    syn_utter_draft(g,ORG_SYN,db[0..p1],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"incumbent_install",disp,SP_INSTALL);
    f=f+ob_check(px,"incumbent_tag_ext",rt_last_a2(g,SP_L_PROVTAG),1);
    // 2. GEN duplicate sighting: another organ emits the same atom with an
    // unwarranted trace -> WITHHOLD; the duplicate quarantines as GEN
    // (mere sighting; must not touch the incumbent's tag)
    let p2:i32=sp_build_legacy_draft(db,a);
    lp=0;
    lp=sp_buf_put(lb,lp,"PREMISES:\n");
    lp=sp_buf_put(lb,lp,"UNIT|junk|POS|IS_A|tree\n");
    lp=sp_buf_put(lb,lp,"STEPS:\n");
    lp=sp_buf_put(lb,lp,"GARBAGE||nonsense||nonsense\n");
    lp=sp_buf_put(lb,lp,"CONCLUSIONS:\n");
    lp=sp_buf_put(lb,lp,"UNIT|other|POS|IS_A|tree\n");
    syn_utter_draft(g,ORG_FL2,db[0..p2],lb[0..lp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"gen_sighting_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"gen_sighting_quarantined",sp_quarantined(g,ORG_FL2,sp_fnv(db[0..p2])),1);
    f=f+ob_check(px,"incumbent_still_ext",rt_first_prov(g,a),1);
    // 3. genuine re-install -> tag still EXT (no downgrade)
    let p3:i32=rt_warranted(db,lb,a,ORG_SYN,&dlp);
    syn_utter_draft(g,ORG_SYN,db[0..p3],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"reinstall",disp,SP_INSTALL);
    f=f+ob_check(px,"reinstall_tag_ext",rt_last_a2(g,SP_L_PROVTAG),1);
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(g);
    return f;
}

// ---- RT-T4-N: N-AUTH bypass battery (forged requester_id, nonce games) ----
fn rt_t4_nauth(k3:*i32)i32 {
    let f:i32=0;
    let px:[]u8="rn_";
    let g:[]u8=sp_new();
    rt_reg(g);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let nt:[]u8=ob_alloc(32);
    let dlp:i32=0;
    let pine:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    // N4 control: per-requester nonces are independent (by design)
    let dp:i32=rt_warranted(db,lb,pine,ORG_SYN,&dlp);
    syn_utter_draft(g,ORG_SYN,db[0..dp],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"n4_syn_install",disp,SP_INSTALL);
    let dp2:i32=rt_warranted(db,lb,pine,ORG_FL2,&dlp);
    syn_utter_draft(g,ORG_FL2,db[0..dp2],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"n4_fl2_install",disp,SP_INSTALL);
    // N1: forged requester_id — SYN emits AS the overseer. The attacker
    // reads the victim's expected nonce (monotonic from 0) and computes
    // the FNV content hash locally: no signature binds identity.
    let vn:i32=0; // the REAL overseer's independent counter (never emitted)
    let fn1:i32=tnonce_next(nt,ORG_OVERSEER);
    let hh1:i32=sp_auth_make(ORG_OVERSEER,fn1,M_UTTER,0,0);
    let fp:i32=rt_warranted(db,lb,pine,ORG_SYN,&dlp);
    syn_raw(g,ORG_OVERSEER,M_UTTER,0,0,db[0..fp],lb[0..dlp],fn1,hh1,&fwd,&disp,&rson);
    f=f+ob_check(px,"n1_forged_fwd",fwd,1);
    f=f+ob_check(px,"n1_forged_install",disp,SP_INSTALL);
    f=f+ob_check(px,"n1_forged_weight",rt_last_inst_weight(g),42);
    rt_finding("N1-FORGED-ID","syn-emit-as-overseer-accepted-weight-42");
    // N2: forged overseer emits the overseer-ONLY class M_FORCE_PIN
    let fn2:i32=tnonce_next(nt,ORG_OVERSEER);
    let hh2:i32=sp_auth_make(ORG_OVERSEER,fn2,M_FORCE_PIN,7,0);
    let oa:[]u8=mk_atom("UNIT","overseer","POS","HAS_PROPERTY","registered");
    let op2:i32=rt_warranted(db,lb,oa,ORG_SYN,&dlp);
    syn_raw(g,ORG_OVERSEER,M_FORCE_PIN,7,0,db[0..op2],lb[0..dlp],fn2,hh2,&fwd,&disp,&rson);
    f=f+ob_check(px,"n2_forged_pin_fwd",fwd,1);
    f=f+ob_check(px,"n2_forged_pin_install",disp,SP_INSTALL);
    rt_finding("N2-FORGED-CLASS","non-overseer-emits-overseer-only-force-pin");
    // N3: victim desync — the real overseer's counter is behind; its emits
    // fail until it catches up (transient DoS from one forgery)
    let gp:i32=rt_warranted(db,lb,pine,ORG_OVERSEER,&dlp);
    syn_raw(g,ORG_OVERSEER,M_UTTER,0,0,db[0..gp],lb[0..dlp],vn,
        sp_auth_make(ORG_OVERSEER,vn,M_UTTER,0,0),&fwd,&disp,&rson);
    f=f+ob_check(px,"n3_victim_refused0",fwd,0);
    f=f+ob_check(px,"n3_victim_unauth0",rson,SP_R_UNAUTH);
    vn=vn+1;
    syn_raw(g,ORG_OVERSEER,M_UTTER,0,0,db[0..gp],lb[0..dlp],vn,
        sp_auth_make(ORG_OVERSEER,vn,M_UTTER,0,0),&fwd,&disp,&rson);
    f=f+ob_check(px,"n3_victim_refused1",fwd,0);
    vn=vn+1;
    syn_raw(g,ORG_OVERSEER,M_UTTER,0,0,db[0..gp],lb[0..dlp],vn,
        sp_auth_make(ORG_OVERSEER,vn,M_UTTER,0,0),&fwd,&disp,&rson);
    f=f+ob_check(px,"n3_victim_healed",fwd,1);
    f=f+ob_check(px,"n3_victim_install",disp,SP_INSTALL);
    rt_finding("N3-VICTIM-DESYNC","one-forgery-two-refused-victim-requests");
    // N5 control: replay of a consumed envelope is refused
    syn_raw(g,ORG_SYN,M_UTTER,0,0,db[0..dp],lb[0..dlp],0,
        sp_auth_make(ORG_SYN,0,M_UTTER,0,0),&fwd,&disp,&rson);
    f=f+ob_check(px,"n5_replay_refused",fwd,0);
    f=f+ob_check(px,"n5_replay_unauth",rson,SP_R_UNAUTH);
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(g);
    return f;
}

// ---- RT-F: fork-D CONTRADICTED-before-ENTAILED precedence attacks ----
fn rt_fork(k3:*i32)i32 {
    let f:i32=0;
    let px:[]u8="rf_";
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let dlp:i32=0;
    // F2: M3-numlist-gap smuggling into weighted adjudication. "5" is not in
    // TAB_NUMLIST, so cl_contradicted's M3 misses tall:3 vs tall:5 — but
    // contradicts() (mutex_pair) still catches the property-value clash, so
    // the verdict withholds CONTRADICTED before the weighted layer is ever
    // consulted. NOTE (resume repair 2026-09-24): the preregistered attack
    // log predicted verdict-ENTAILED + weighted-fires; the run proved that
    // prediction wrong — the weighted layer is NOT reachable end-to-end even
    // via the M3 gap (narrower than predicted: security-positive). The
    // battery now encodes the confirmed behavior; the refuted prediction is
    // recorded in RESULTS.md.
    let g:[]u8=sp_new();
    rt_reg(g);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let nt:[]u8=ob_alloc(32);
    sp_store_append(g,"UNIT|wold|POS|PROP_NUM|tall:3",1,ORG_FL2);
    let t3:[]u8=mk_atom("UNIT","wold","POS","PROP_NUM","tall:3");
    let q1:i32=rt_warranted(db,lb,t3,ORG_FL2,&dlp);
    syn_utter_draft(g,ORG_FL2,db[0..q1],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"f2_incumbent_install",disp,SP_INSTALL);
    sp_store_append(g,"UNIT|wold|POS|PROP_NUM|tall:5",1,ORG_MEM);
    let t5:[]u8=mk_atom("UNIT","wold","POS","PROP_NUM","tall:5");
    let q2:i32=rt_warranted(db,lb,t5,ORG_MEM,&dlp);
    syn_utter_draft(g,ORG_MEM,db[0..q2],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"f2_gap_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"f2_gap_reason",rson,SP_R_CONTRADICTED);
    f=f+ob_check(px,"f2_weighted_never",sp_ledger_count(g,SP_L_CONFLICT),0);
    f=f+ob_check(px,"f2_no_winner",rt_last_a1(g,SP_L_CONFLICT),-999);
    // lower-weight challenger through the same gap: same verdict precedence
    sp_store_append(g,"UNIT|wold|POS|PROP_NUM|tall:7",1,ORG_SYN);
    let t7:[]u8=mk_atom("UNIT","wold","POS","PROP_NUM","tall:7");
    let vd0:i32=sp_ledger_count(g,SP_L_VERDICT);
    let nt0:i32=sp_ledger_count(g,SP_L_NOTIFY);
    let q3:i32=rt_warranted(db,lb,t7,ORG_SYN,&dlp);
    let key7:i32=sp_fnv(db[0..q3]);
    syn_utter_draft(g,ORG_SYN,db[0..q3],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"f2_syn_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"f2_syn_reason",rson,SP_R_CONTRADICTED);
    f=f+ob_check(px,"f2_still_no_conflicts",sp_ledger_count(g,SP_L_CONFLICT),0);
    f=f+ob_check(px,"f2_still_no_winner",rt_last_a1(g,SP_L_CONFLICT),-999);
    if(rt_resolved(g,ORG_SYN,key7,disp,rson,fwd,vd0,nt0)==0){k3.*=k3.*+1;}
    rt_finding("F2-GAP-REACH","m3-gap-does-not-reach-weighted-verdict-contradicts-first");
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(g);
    // F3: weight-40 overseer vs weight-32 MEM incumbent — the verdict's
    // contradiction precedence decides; the weighted law never fires.
    let g3:[]u8=sp_new();
    rt_reg(g3);
    let db3:[]u8=ob_alloc(4096);let lb3:[]u8=ob_alloc(4096);
    let nt3:[]u8=ob_alloc(32);
    let alive:[]u8=mk_atom("UNIT","deer","POS","HAS_PROPERTY","alive");
    let ia:i32=rt_warranted(db3,lb3,alive,ORG_MEM,&dlp);
    syn_utter_draft(g3,ORG_MEM,db3[0..ia],lb3[0..dlp],nt3,&fwd,&disp,&rson);
    f=f+ob_check(px,"f3_incumbent_install",disp,SP_INSTALL);
    let dead:[]u8=mk_atom("UNIT","deer","POS","HAS_PROPERTY","dead");
    let da:i32=rt_warranted(db3,lb3,dead,ORG_OVERSEER,&dlp);
    syn_utter_draft(g3,ORG_OVERSEER,db3[0..da],lb3[0..dlp],nt3,&fwd,&disp,&rson);
    f=f+ob_check(px,"f3_overseer_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"f3_overseer_reason",rson,SP_R_CONTRADICTED);
    f=f+ob_check(px,"f3_weighted_never",sp_ledger_count(g3,SP_L_CONFLICT),0);
    rt_finding("F3-PRECEDENCE","weight-40-challenger-withheld-weighted-inoperative");
    ob_free(db3);ob_free(lb3);ob_free(nt3);ob_free(g3);
    // F4: store-poisoning freeze — POS and NEG both EXT: the subject is
    // permanently unwinnable; escalation is the only resolution.
    let g4:[]u8=sp_new();
    rt_reg(g4);
    let db4:[]u8=ob_alloc(4096);let lb4:[]u8=ob_alloc(4096);
    let nt4:[]u8=ob_alloc(32);
    sp_store_append(g4,"UNIT|pelm|POS|IS_A|tree",1,255);
    sp_store_append(g4,"UNIT|pelm|NEG|IS_A|tree",1,255);
    let pp4:[]u8=mk_atom("UNIT","pelm","POS","IS_A","tree");
    let np42:[]u8=mk_atom("UNIT","pelm","NEG","IS_A","tree");
    let qp:i32=rt_warranted(db4,lb4,pp4,ORG_MEM,&dlp);
    syn_utter_draft(g4,ORG_MEM,db4[0..qp],lb4[0..dlp],nt4,&fwd,&disp,&rson);
    f=f+ob_check(px,"f4_pos_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"f4_pos_reason",rson,SP_R_CONTRADICTED);
    let qn:i32=rt_warranted(db4,lb4,np42,ORG_MEM,&dlp);
    syn_utter_draft(g4,ORG_MEM,db4[0..qn],lb4[0..dlp],nt4,&fwd,&disp,&rson);
    f=f+ob_check(px,"f4_neg_withhold",disp,SP_WITHHOLD);
    f=f+ob_check(px,"f4_neg_reason",rson,SP_R_CONTRADICTED);
    let qp2:i32=rt_warranted(db4,lb4,pp4,ORG_MEM,&dlp);
    syn_utter_draft(g4,ORG_MEM,db4[0..qp2],lb4[0..dlp],nt4,&fwd,&disp,&rson);
    f=f+ob_check(px,"f4_pos2_withhold",disp,SP_WITHHOLD);
    let qp3:i32=rt_warranted(db4,lb4,pp4,ORG_MEM,&dlp);
    syn_utter_draft(g4,ORG_MEM,db4[0..qp3],lb4[0..dlp],nt4,&fwd,&disp,&rson);
    f=f+ob_check(px,"f4_pos3_escalate",disp,SP_ESCALATE);
    // other subjects flow; even the overseer cannot heal the poisoned subject
    let pine4:[]u8=mk_atom("UNIT","pine","POS","IS_A","tree");
    let pi4:i32=rt_warranted(db4,lb4,pine4,ORG_PAM,&dlp);
    syn_utter_draft(g4,ORG_PAM,db4[0..pi4],lb4[0..dlp],nt4,&fwd,&disp,&rson);
    f=f+ob_check(px,"f4_other_live",disp,SP_INSTALL);
    let qo:i32=rt_warranted(db4,lb4,pp4,ORG_OVERSEER,&dlp);
    syn_utter_draft(g4,ORG_OVERSEER,db4[0..qo],lb4[0..dlp],nt4,&fwd,&disp,&rson);
    f=f+ob_check(px,"f4_overseer_noheal",disp,SP_WITHHOLD);
    rt_finding("F4-POISON-FREEZE","inconsistent-subject-unhealable-escalate-only");
    ob_free(db4);ob_free(lb4);ob_free(nt4);ob_free(g4);
    return f;
}

// ---- RT-R: resource-exhaustion probes (caps vs "never silent / all ledgered") ----
fn rt_exhaust()i32 {
    let f:i32=0;
    let px:[]u8="rx_";
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    let dlp:i32=0;
    // R1: ledger cap (1024 rows). Drive it to capacity, then withhold once
    // more: the decision must still notify, but the ledger row is dropped.
    let g:[]u8=sp_new();
    rt_reg(g);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let nt:[]u8=ob_alloc(32);
    let i:i32=0;
    while(i<350){
        let a:[]u8=cat2("UNIT|ldg",cat2(sp_i32s(i),"|POS|IS_A|tree"));
        let dp:i32=rt_warranted(db,lb,a,ORG_SYN,&dlp);
        syn_utter_draft(g,ORG_SYN,db[0..dp],lb[0..dlp],nt,&fwd,&disp,&rson);
        i=i+1;
    }
    f=f+ob_check(px,"r1_ledger_capped",sp_ledger_n(g),1024);
    let probe:[]u8=mk_atom("UNIT","ldgprobe","POS","IS_A","tree");
    let pp:i32=rt_warranted(db,lb,probe,ORG_SYN,&dlp);
    let vd0:i32=sp_ledger_count(g,SP_L_VERDICT);
    syn_utter_draft(g,ORG_SYN,db[0..pp],lb[0..dlp],nt,&fwd,&disp,&rson);
    f=f+ob_check(px,"r1_still_capped",sp_ledger_n(g),1024);
    f=f+ob_check(px,"r1_no_new_verdict",sp_ledger_count(g,SP_L_VERDICT),vd0);
    f=f+ob_check(px,"r1_still_notified",sp_last_notify(g,ORG_SYN),rson);
    f=f+ob_check(px,"r1_not_installed",disp!=SP_INSTALL,1);
    rt_finding("R1-LEDGER-CAP","post-cap-decisions-unledgered-notify-only");
    ob_free(db);ob_free(lb);ob_free(nt);ob_free(g);
    // R2: dispute-table cap (64 rows). The 65th distinct dispute escalates
    // on its FIRST withhold: escalation inflation.
    let g2:[]u8=sp_new();
    rt_reg(g2);
    let db2:[]u8=ob_alloc(4096);let lb2:[]u8=ob_alloc(4096);
    let nt2:[]u8=ob_alloc(32);
    let j:i32=0;
    while(j<64){
        let a2:[]u8=cat2("UNIT|dsp",cat2(sp_i32s(j),"|POS|IS_A|tree"));
        let dp2:i32=rt_warranted(db2,lb2,a2,ORG_SYN,&dlp);
        syn_utter_draft(g2,ORG_SYN,db2[0..dp2],lb2[0..dlp],nt2,&fwd,&disp,&rson);
        j=j+1;
    }
    f=f+ob_check(px,"r2_dispute_full",ob_g32(g2,G_DSP_N),64);
    let a65:[]u8=mk_atom("UNIT","dsp65","POS","IS_A","tree");
    let dp65:i32=rt_warranted(db2,lb2,a65,ORG_SYN,&dlp);
    syn_utter_draft(g2,ORG_SYN,db2[0..dp65],lb2[0..dlp],nt2,&fwd,&disp,&rson);
    f=f+ob_check(px,"r2_instant_escalate",disp,SP_ESCALATE);
    rt_finding("R2-DISPUTE-CAP","exhaustion-instant-escalation-inbox-flood");
    ob_free(db2);ob_free(lb2);ob_free(nt2);ob_free(g2);
    // R3: quarantine cap (128 rows). The ledger claims a quarantine that
    // never happened.
    let g3:[]u8=sp_new();
    rt_reg(g3);
    let db3:[]u8=ob_alloc(4096);let lb3:[]u8=ob_alloc(4096);
    let nt3:[]u8=ob_alloc(32);
    let k:i32=0;
    while(k<128){
        let a3:[]u8=cat2("UNIT|quar",cat2(sp_i32s(k),"|POS|IS_A|tree"));
        let dp3:i32=rt_warranted(db3,lb3,a3,ORG_SYN,&dlp);
        syn_utter_draft(g3,ORG_SYN,db3[0..dp3],lb3[0..dlp],nt3,&fwd,&disp,&rson);
        k=k+1;
    }
    f=f+ob_check(px,"r3_quar_full",ob_g32(g3,G_QUAR_N),64);
    // NOTE (resume repair): 64, not 128 — sp_quarantine_add requires a live
    // dispute row, and the dispute table caps at 64 (R2's own finding: claim
    // 65+ escalates instantly without a dispute row). The original check
    // expected 128, contradicting the battery's own R2 result. The phantom-
    // quarantine finding below is unchanged and is the substantive R3 result.
    let a129:[]u8=mk_atom("UNIT","quar129","POS","IS_A","tree");
    let dp129:i32=rt_warranted(db3,lb3,a129,ORG_SYN,&dlp);
    let q0:i32=sp_ledger_count(g3,SP_L_QUARANTINE);
    let key129:i32=sp_fnv(db3[0..dp129]);
    syn_utter_draft(g3,ORG_SYN,db3[0..dp129],lb3[0..dlp],nt3,&fwd,&disp,&rson);
    f=f+ob_check(px,"r3_ledger_says_quarantined",sp_ledger_count(g3,SP_L_QUARANTINE),q0+1);
    f=f+ob_check(px,"r3_not_quarantined",sp_quarantined(g3,ORG_SYN,key129),0);
    rt_finding("R3-QUAR-CAP","ledger-asserts-phantom-quarantine");
    ob_free(db3);ob_free(lb3);ob_free(nt3);ob_free(g3);
    // R4: installed-index cap (128 rows). Post-cap installs are invisible
    // to conflict detection.
    let g4:[]u8=sp_new();
    let db4:[]u8=ob_alloc(4096);
    let m:i32=0;
    while(m<128){
        let a4:[]u8=cat2("UNIT|cap",cat2(sp_i32s(m),"|POS|IS_A|tree"));
        let dp4:i32=sp_build_legacy_draft(db4,a4);
        sp_installed_add(g4,ORG_SYN,db4[0..dp4]);
        m=m+1;
    }
    f=f+ob_check(px,"r4_index_full",ob_g32(g4,G_INST_N),128);
    let a128:[]u8=mk_atom("UNIT","cap128","POS","IS_A","tree");
    let dp128:i32=sp_build_legacy_draft(db4,a128);
    sp_installed_add(g4,ORG_SYN,db4[0..dp128]);
    f=f+ob_check(px,"r4_add_dropped",ob_g32(g4,G_INST_N),128);
    // control: contradicting an INDEXED claim is caught...
    let c0:[]u8=mk_atom("UNIT","cap0","NEG","IS_A","tree");
    let dc0:i32=sp_build_legacy_draft(db4,c0);
    let lose:i32=0;
    sp_conflict_check(g4,0,ORG_SYN,db4[0..dc0],&lose);
    f=f+ob_check(px,"r4_control_caught",lose,1);
    // ...but the unindexed 129th claim is invisible: silent conflict miss.
    let c128:[]u8=mk_atom("UNIT","cap128","NEG","IS_A","tree");
    let dc128:i32=sp_build_legacy_draft(db4,c128);
    let lose2:i32=0;
    sp_conflict_check(g4,0,ORG_SYN,db4[0..dc128],&lose2);
    f=f+ob_check(px,"r4_blind",lose2,0);
    rt_finding("R4-INDEX-CAP","post-cap-installs-invisible-to-conflict-check");
    ob_free(db4);ob_free(g4);
    return f;
}

fn main()i32 {
    let f:i32=0;
    let k3:i32=0;
    f=f+rt_t3_triad(&k3);
    f=f+rt_t3_e1(&k3);
    f=f+rt_t3_e2(&k3);
    f=f+rt_t3_e3(&k3);
    f=f+rt_t4_launder(&k3);
    f=f+rt_t4_trace(&k3);
    f=f+rt_t4_k2_gentag(&k3);
    f=f+rt_t4_k3_nodowngrade(&k3);
    f=f+rt_t4_nauth(&k3);
    f=f+rt_fork(&k3);
    f=f+rt_exhaust();
    _zag_print("RT_K3_HITS,");
    let s:[]u8=_zag_i64_to_str(k3 as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    _zag_print("RT_FAILURES,");
    let t:[]u8=_zag_i64_to_str(f as i64);_zag_print(t);ob_free(t);
    _zag_println("");
    return (f!=0) as i32;
}

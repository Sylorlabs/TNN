// corpus_probe.zag — minimal probe: the T5 corpus alone, with per-item
// progress prints, to localize any slow verdict.
@import("sp_gate.zag")
@import("ob_arbiter.zag")

fn pmsg(s:[]u8,i:i32)void {
    _zag_print("PROBE,");_zag_print(s);_zag_print(",");
    let a:[]u8=_zag_i64_to_str(i as i64);_zag_print(a);ob_free(a);
    _zag_println("");
    return;
}

fn pnonce_next(nt:[]u8,org:i32)i32 {
    let n:i32=ob_g32(nt,org*4);
    ob_s32(nt,org*4,n+1);
    return n;
}

fn putter(g:[]u8,draft:[]u8,delib:[]u8,nt:[]u8,fwd:*i32,disp:*i32,rson:*i32)i32 {
    let nonce:i32=pnonce_next(nt,ORG_SYN);
    let hash:i32=sp_auth_make(ORG_SYN,nonce,M_UTTER,0,0);
    return sp_gate_one(g,ORG_SYN,M_UTTER,0,0,nonce,hash,draft,delib,0,fwd,disp,rson);
}

fn main()i32 {
    let g:[]u8=sp_new();
    sp_register(g,ORG_FL2);sp_register(g,ORG_PAM);sp_register(g,ORG_MEM);
    sp_register(g,ORG_ARBITER);sp_register(g,ORG_OVERSEER);sp_register(g,ORG_SYN);
    sp_seed_store(g);
    pmsg("seeded",0);
    let i:i32=0;
    while(i<40){
        let sa:[]u8=mk_atom("UNIT",cat2("w",sp_i32s(i)),"POS","IS_A","tree");
        sp_store_append(g,sa,1,255);
        i=i+1;
    }
    pmsg("warranted_seeded",40);
    let db:[]u8=ob_alloc(4096);let lb:[]u8=ob_alloc(4096);
    let nt:[]u8=ob_alloc(32);
    let fwd:i32=0;let disp:i32=0;let rson:i32=0;
    i=0;
    while(i<40){
        let wa:[]u8=mk_atom("UNIT",cat2("w",sp_i32s(i)),"POS","IS_A","tree");
        let wp:i32=sp_build_legacy_draft(db,wa);
        let wlp:i32=sp_build_legacy_delib(lb,wa,ORG_SYN);
        putter(g,db[0..wp],lb[0..wlp],nt,&fwd,&disp,&rson);
        if(i%10==0){pmsg("warranted_item",i);}
        let ca:[]u8=mk_atom("UNIT",cat2("c",sp_i32s(i)),"POS","IS_A","tree");
        let cp:i32=sp_build_legacy_draft(db,ca);
        let clp:i32=sp_build_legacy_delib(lb,ca,ORG_SYN);
        putter(g,db[0..cp],lb[0..clp],nt,&fwd,&disp,&rson);
        if(i%10==0){pmsg("confab_item",i);}
        i=i+1;
    }
    pmsg("main_corpus_done",80);
    i=0;
    while(i<10){
        let ga:[]u8=mk_atom("UNIT",cat2("g",sp_i32s(i)),"POS","IS_A","animal");
        let gl:[]u8=mk_atom("UNIT",cat2("g",sp_i32s(i)),"POS","IS_A","fish");
        sp_store_append(g,gl,0,ORG_SYN);
        let gp:i32=sp_build_legacy_draft(db,ga);
        let glp:i32=0;
        glp=sp_buf_put(lb,glp,"PREMISES:\n");
        glp=sp_buf_put(lb,glp,"UNIT|fish|POS|IS_A|animal\n");
        glp=sp_buf_put(lb,glp,"STEPS:\n");
        glp=sp_buf_put(lb,glp,"CONCLUSIONS:\n");
        glp=sp_buf_put(lb,glp,ga);glp=sp_buf_put(lb,glp,"\n");
        putter(g,db[0..gp],lb[0..glp],nt,&fwd,&disp,&rson);
        pmsg("alibi_item",i);
        i=i+1;
    }
    i=0;
    while(i<10){
        let fa:[]u8=mk_atom("UNIT",cat2("w",sp_i32s(i)),"POS","IS_A","tree");
        let fp:i32=sp_build_legacy_draft(db,fa);
        let flp:i32=0;
        flp=sp_buf_put(lb,flp,"PREMISES:\n");
        flp=sp_buf_put(lb,flp,"UNIT|trout|POS|IS_A|fish\n");
        flp=sp_buf_put(lb,flp,"STEPS:\n");
        flp=sp_buf_put(lb,flp,"ISA-CHAIN||UNIT|trout|POS|IS_A|fish||UNIT|trout|POS|IS_A|animal||UNIT|trout|POS|IS_A|animal\n");
        flp=sp_buf_put(lb,flp,"CONCLUSIONS:\n");
        flp=sp_buf_put(lb,flp,"UNIT|trout|POS|IS_A|animal\n");
        putter(g,db[0..fp],lb[0..flp],nt,&fwd,&disp,&rson);
        pmsg("fab_item",i);
        i=i+1;
    }
    pmsg("done",100);
    return 0;
}

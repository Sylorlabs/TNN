// ob_lh.zag — FABLE COMPOSITION LAWS, LONG-HORIZON driver (Phase 1: repaired baseline).
//
// Frozen prereg: ~/workspace/ob_lawslh/PREREG_LAWSLH.md (+ amendments A1, A2).
// Pure Zag. Zero RNG. argv[1]=bundle, argv[2]=scale (s1/s10/s100), argv[3]=leg.
// Bundles: b0 a1pin a4race a2fp a6contra lie monk (bi 0..6).
// Legs: base depth dos key cycle distrust offgov indep.
//
// What this adds over the scale driver's ob_scale_b.zag:
//   - A7 monk bundle (teacher states the lie once, then silence).
//   - Per-episode LH_EP honest-traffic lines + per-rule LH_CURVE lines
//     (learning curves; runner diffs these across runs for containment).
//   - Driver-side law-event log (16B {ep,lev,d1,d2}) with episode stamps;
//     horizon audit K7 (install<->ADMIT pairing, 204 cite verification,
//     provisional-register balance, frozen reason set).
//   - Depth leg: independent FRESH ensemble re-adjudication at d={1,2,4}
//     (K6a) + REVISE corroboration-depth at commits (K6b).
//   - Horizon attack legs: dos/key/cycle/distrust/offgov/indep (§8).
// Zero RNG. Byte-identical reruns required.
@import("ob_common.zag")
@import("ob_tn.zag")
@import("ob_fl2.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")
@import("ob_arbiter.zag")

const SC_W:i32=64;        // window width (episodes per rule)
const SC_QCAP:i32=512;    // driver queue entries
const LH_LEVCAP:i32=200000; // law-log entries (16B each)
const LH_JUNK:i32=900;    // dos-flood bogus claim base (900+k)
const LH_MONK_CLAIM:i32=50; // monk lie claim slot
const LH_MONK_POL:i32=2;  // monk lie policy (REKEY)

// law-event codes (driver-side log; baseline analogs of the 9 laws)
const LEV_AUTH_ADMIT:i32=1;
const LEV_AUTH_WITHHOLD:i32=2;
const LEV_COLLISION_DROP:i32=3;
const LEV_COLLISION_REFUSED:i32=4;
const LEV_PROV_SET:i32=5;
const LEV_PROV_CLEAR:i32=6;
const LEV_ESCALATE:i32=7;
const LEV_REVOKE_OK:i32=8;
const LEV_REVOKE_DROPPED:i32=9;
const LEV_FORCE_PIN:i32=10;
const LEV_INSTALL:i32=11;
const LEV_PROMOTE_OK:i32=12;
const LEV_GOV_DEGRADED:i32=13;
const LEV_RING_ALIAS:i32=14;
const LEV_MONK_WATCH:i32=15;
const LEV_DEPTH:i32=16;
const LEV_KEYGAP:i32=17;
const LEV_INDEP:i32=18;
const LEV_ADVERSARIAL:i32=19;

// bundle ids
const BI_B0:i32=0;
const BI_A1PIN:i32=1;
const BI_A4RACE:i32=2;
const BI_A2FP:i32=3;
const BI_A6CONTRA:i32=4;
const BI_LIE:i32=5;
const BI_MONK:i32=6;

// leg ids
const LEG_BASE:i32=0;
const LEG_DEPTH:i32=1;
const LEG_DOS:i32=2;
const LEG_KEY:i32=3;
const LEG_CYCLE:i32=4;
const LEG_DISTRUST:i32=5;
const LEG_OFFGOV:i32=6;
const LEG_INDEP:i32=7;

// ---- counting helpers over the two audit trails (from ob_scale_b.zag) ----
fn b_c_arb(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(ob_g32(alog,i*16+4)==code){c=c+1;}i=i+1;}
    return c;
}

fn b_c_arb2(alog:[]u8,n:i32,code:i32,a1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn b_c_mem(audit:[]u8,hdr:[]u8,op:i32,rc:i32)i32 {
    let n:i32=ob_g32(hdr,8);
    let c:i32=0;let i:i32=0;
    while(i<n){
        let e:i32=i*MA_EW*4;
        if(ob_g32(audit,e+4)==op && ob_g32(audit,e+12)==rc){c=c+1;}
        i=i+1;
    }
    return c;
}

fn b_c_mem2(audit:[]u8,hdr:[]u8,op:i32,rc:i32,d1:i32)i32 {
    let n:i32=ob_g32(hdr,8);
    let c:i32=0;let i:i32=0;
    while(i<n){
        let e:i32=i*MA_EW*4;
        if(ob_g32(audit,e+4)==op && ob_g32(audit,e+12)==rc
            && ob_g32(audit,e+36)==d1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn b_live_count(live:[]u8)i32 {
    let c:i32=0;let i:i32=0;
    while(i<MA_CAP){if(live[i]!=0){c=c+1;}i=i+1;}
    return c;
}

fn b_long_count(region:[]u8)i32 {
    let c:i32=0;let i:i32=0;
    while(i<MA_CAP){if(region[i]==MA_REGION_LONG){c=c+1;}i=i+1;}
    return c;
}

// FNV-1a over the memory organ's STORE arrays (I3 probe).
fn b_fnv(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,
    step:[]u8)i32 {
    let h:i32=2166136261;
    let i:i32=0;
    while(i<MA_CAP){
        h=(h^(live[i] as i32))*16777619;
        h=(h^(pinned[i] as i32))*16777619;
        h=(h^(region[i] as i32))*16777619;
        h=(h^(tier[i] as i32))*16777619;
        i=i+1;
    }
    i=0;
    while(i<MA_CAP*4){
        h=(h^(value[i] as i32))*16777619;
        h=(h^(step[i] as i32))*16777619;
        i=i+1;
    }
    return h;
}

fn b_delta_mutated(audit:[]u8,n0:i32,n1:i32)i32 {
    let i:i32=n0;
    while(i<n1){
        let e:i32=i*MA_EW*4;
        let op:i32=ob_g32(audit,e+4);
        let rc:i32=ob_g32(audit,e+12);
        if(rc==MA_OK){
            if(op==MA_OP_ADD){return 1;}
            if(op==MA_OP_KILL){return 1;}
            if(op==MA_OP_PIN){return 1;}
            if(op==MA_OP_UNPIN){return 1;}
            if(op==MA_OP_PROMOTE){return 1;}
            if(op==MA_OP_DEMOTE){return 1;}
            if(op==MA_OP_STAGE){return 1;}
        }
        i=i+1;
    }
    return 0;
}

// ---- law-event log: 16B entries {ep, lev, d1, d2} ----
fn lh_log(log:[]u8,n:*i32,ep:i32,lev:i32,d1:i32,d2:i32)i32 {
    let k:i32=n.*;
    if(k<0 || k>=LH_LEVCAP){return -1;}
    ob_s32(log,k*16,ep);ob_s32(log,k*16+4,lev);
    ob_s32(log,k*16+8,d1);ob_s32(log,k*16+12,d2);
    n.*=k+1;
    return 0;
}

fn lh_lev_count(log:[]u8,n:i32,lev:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(ob_g32(log,i*16+4)==lev){c=c+1;}i=i+1;}
    return c;
}

// print helper: LH,<name>,<v>
fn lh_num(name:[]u8,v:i32)i32 {
    _zag_print("LH,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(v as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return 0;
}
// ---- brain: one shared (arbiter, PAM, MEM), fresh FL2 per rule ----
fn b_brain_new(pam:*[]u8,
    live:*[]u8,value:*[]u8,pinned:*[]u8,region:*[]u8,tier:*[]u8,step:*[]u8,
    maudit:*[]u8,mhdr:*[]u8,trust:*[]u8,
    ast:*[]u8,routes:*[]u8,alog:*[]u8,q:*[]u8)i32 {
    let f:i32=0;
    pam.*=pam_new();
    live.*=mm_new_live();value.*=mm_new_value();pinned.*=mm_new_pinned();
    region.*=mm_new_region();tier.*=mm_new_tier();step.*=mm_new_step();
    maudit.*=mm_new_audit();mhdr.*=mm_new_hdr();trust.*=mm_new_trust();
    mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,
        maudit.*,mhdr.*);
    mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,
        maudit.*,mhdr.*);
    ast.*=arb_new_state();routes.*=arb_new_routes();
    alog.*=ob_alloc(ARB_ACAP*16);
    q.*=ob_alloc(SC_QCAP*16);
    return 0;
}

// reset the fresh-ensemble scratch PAM between depths: zero the row
// count and the disposition-ledger count (rows are overwrite-only).
fn pam_scratch_reset(scratch:[]u8)i32 {
    ob_s32(scratch,PAM_N,0);
    ob_s32(scratch,PAM_LN,0);
    return 0;
}

// FRESH ensemble verdict on (policy,cal) at depth d.
// Rows: jf=0,conf=cal,epoch=ep+2000*r,seq=ep+2000*r+1000, src=7,obs=350.
fn lh_fresh_ensemble(scratch:[]u8,policy:i32,cal:i32,ep:i32,d:i32)i32 {
    // mirrors arb_pam_claim exactly (conf=250*cal, jf=1), on a scratch PAM
    let admits:i32=0;
    let r:i32=0;
    while(r<d){
        let c:i32=250*cal;
        let slot:i32=pam_observe(scratch,policy,policy,c,c,1,
            ep+2000*r,ep+2000*r+1000,7,350,350,350,ep);
        let v:i32=0;let reason:i32=0;
        pam_verdict(scratch,slot,PAM_MODE_FRESH,&v,&reason);
        if(v==PAM_ADMIT){admits=admits+1;}
        r=r+1;
    }
    // majority; exact ties (d even) abstain
    if(admits*2>d){return PAM_ADMIT;}
    if(admits*2==d){return PAM_WITHHOLD;}
    return PAM_WITHHOLD;
}

// REVISE corroboration verdict for a commit claim row (jf,cf) at depth d:
// admit iff >=d corroborating priors (same jf, organ bars OK incl.
// INDEP, |cf-cf_i|<=tol), excluding row excl (the claim itself).
fn lh_revise_depth(pam:[]u8,jf:i32,cf:i32,d:i32,excl:i32)i32 {
    let n:i32=pam_n(pam);
    let cnt:i32=0;
    let i:i32=0;
    while(i<n){
        if(i!=excl && pam_bars_ok(pam,i)==PAM_R_OK && pam_row(pam,i,PAMW_JF)==jf){
            let dcf:i32=cf-pam_row(pam,i,PAMW_CF);
            if(dcf<0){dcf=0-dcf;}
            if(dcf<=PAM_CONF_TOL){cnt=cnt+1;}
        }
        i=i+1;
    }
    if(cnt>=d){return PAM_ADMIT;}
    return PAM_WITHHOLD;
}

// the organ's OWN revise path (PAM_MODE_REVISE) on an existing row:
// returns verdict*100+reason for cross-check against lh_revise_depth.
fn lh_revise_organ(pam:[]u8,slot:i32)i32 {
    let v:i32=0;let r:i32=0;
    pam_verdict(pam,slot,PAM_MODE_REVISE,&v,&r);
    return v*100+r;
}

// Law-event derivation + K7 audit over one episode's arbiter-audit delta.
// Emits LEV_* entries; accumulates per-episode honest counters;
// counts K7a/K7b/K7d violations into k7bad (failures add to rc).
fn lh_derive(ep:i32,alog:[]u8,al0:i32,al1:i32,
    levlog:[]u8,levn:*i32,q:[]u8,nqd:i32,
    pc0:i32,pp0:i32,pc1:i32,pp1:i32,k7bad:*i32,
    ea:*i32,ew:*i32,eh:*i32,ei:*i32,er:*i32,ej:*i32)i32 {
    let f:i32=0;
    let k:i32=al0;
    while(k<al1){
        let code:i32=ob_g32(alog,k*16+4);
        let a1:i32=ob_g32(alog,k*16+8);
        let a2:i32=ob_g32(alog,k*16+12);
        if(code==M_PAM_VERDICT){
            if(a2<0 || a2>7){k7bad.*=k7bad.*+1;f=f+1;} // K7d frozen reason set
            if(a1==PAM_ADMIT){
                lh_log(levlog,levn,ep,LEV_AUTH_ADMIT,a2,0);
                ea.*=ea.*+1;
            }else{
                lh_log(levlog,levn,ep,LEV_AUTH_WITHHOLD,a2,0);
                ew.*=ew.*+1;
            }
        }
        if(code==ARB_DROP){
            lh_log(levlog,levn,ep,LEV_COLLISION_DROP,a1,a2);
            if(a1==M_PROMOTE && a2>=LH_JUNK){ej.*=ej.*+1;}
            else{eh.*=eh.*+1;}
        }
        if(code==ARB_REFUSED){
            lh_log(levlog,levn,ep,LEV_COLLISION_REFUSED,a1,a2);
        }
        if(code==ARB_REFUSED_CONTRADICTED){
            lh_log(levlog,levn,ep,LEV_COLLISION_REFUSED,204,a2);
            // K7b: cited seq must name an M_REVOKE receipt from this
            // episode's dispatched queue
            let cep:i32=(a2/65536);
            let cidx:i32=a2-(cep*65536);
            let ok:i32=0;
            if(cep==ep && cidx>=0 && cidx<nqd){
                if(ob_g32(q,cidx*16+4)==M_REVOKE){ok=1;}
            }
            if(ok==0){k7bad.*=k7bad.*+1;f=f+1;}
        }
        if(code==M_REVOKE){
            if(a2==MA_OK){
                lh_log(levlog,levn,ep,LEV_REVOKE_OK,a1,0);
                er.*=er.*+1;
            }else{
                lh_log(levlog,levn,ep,LEV_REVOKE_DROPPED,a1,a2);
            }
        }
        if(code==M_FORCE_PIN){
            lh_log(levlog,levn,ep,LEV_FORCE_PIN,a1,a2);
        }
        if(code==M_MEM_SAFETY){
            lh_log(levlog,levn,ep,LEV_ESCALATE,a1,a2);
        }
        if(code==ARB_APPLIED){
            if(a1==MA_OP_ADD){
                // K7a: an install's preceding audit entry must be its own
                // M_PAM_VERDICT/ADMIT, same episode
                let ok:i32=0;
                if(k>al0){
                    if(ob_g32(alog,(k-1)*16+4)==M_PAM_VERDICT
                        && ob_g32(alog,(k-1)*16+8)==PAM_ADMIT
                        && ob_g32(alog,(k-1)*16)==ep){ok=1;}
                }
                if(ok==0){k7bad.*=k7bad.*+1;f=f+1;}
                lh_log(levlog,levn,ep,LEV_INSTALL,a2,0);
                ei.*=ei.*+1;
            }
            if(a1==MA_OP_PROMOTE){
                lh_log(levlog,levn,ep,LEV_PROMOTE_OK,a2,0);
            }
        }
        k=k+1;
    }
    // provisional-register mirror (K7c)
    if(pc0!=pc1 || pp0!=pp1){
        if(pc0>=0){lh_log(levlog,levn,ep,LEV_PROV_CLEAR,pc0,pp0);}
        if(pc1>=0){lh_log(levlog,levn,ep,LEV_PROV_SET,pc1,pp1);}
    }
    return f;
}

// ---- one episode: organ step + injections + dispatch + derivation ----
fn b_episode(bi:i32,leg:i32,ep:i32,i:i32,local:i32,stated:i32,teach_aux:i32,
    dos0:i32,dos1:i32,cyc0:i32,cyc1:i32,adv0:i32,adv1:i32,keyep:i32,
    fl2:[]u8,flog:[]u8,fln:*i32,
    q:[]u8,qn:*i32,
    ast:[]u8,routes:[]u8,alog:[]u8,aln:*i32,
    pam:[]u8,scratch:[]u8,
    live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    maudit:[]u8,mhdr:[]u8,trust:[]u8,
    slotb:[]u8,slot2b:[]u8,monkb:[]u8,
    levlog:[]u8,levn:*i32,
    ea:*i32,ew:*i32,eh:*i32,ei:*i32,er:*i32,ej:*i32,
    depep:[]u8,depkn:[]u8,depav:[]u8,depf:[]u8,depr:[]u8,depn:*i32,
    i3bad:*i32,i4bad:*i32,k7bad:*i32,depbad:*i32)i32 {
    let f:i32=0;
    qn.*=0;
    let ma0:i32=ob_g32(mhdr,8);
    let al0:i32=aln.*;
    let h0:i32=b_fnv(live,value,pinned,region,tier,step);
    let pc0:i32=ob_g32(ast,0); let pp0:i32=ob_g32(ast,4);
    let pamn0:i32=pam_n(pam);

    // driver-direct learner ops (a1pin pin/unpin)
    // distrust safety pin: protect the honest claim during the attack
    if(leg==LEG_DISTRUST && local==16 && ep>=adv0 && ep<adv1){
        let s:i32=ob_g32(routes,14*4);
        if(s>=0){mm_pin(live,value,pinned,region,tier,step,maudit,mhdr,s);}
    }
    if(leg==LEG_DISTRUST && local==21 && ep>=adv0 && ep<adv1){
        let s:i32=ob_g32(routes,14*4);
        if(s>=0){mm_unpin(live,value,pinned,region,tier,step,maudit,mhdr,s);}
    }
    if(bi==BI_A1PIN && local==16){
        let s:i32=ob_g32(slotb,i*4);
        if(s>=0){mm_pin(live,value,pinned,region,tier,step,maudit,mhdr,s);}
        else{f=f+1;}
    }
    if(bi==BI_A1PIN && local==50){
        let s:i32=ob_g32(slotb,i*4);
        if(s>=0){mm_unpin(live,value,pinned,region,tier,step,maudit,mhdr,s);}
        else{f=f+1;}
    }

    // pre-step injections: a4race even-i natural order, monk lie
    if(bi==BI_A4RACE && local==48){
        let odd:i32=i-(i/2)*2;
        if(odd==0){
            if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,M_REVOKE,1,0)!=0){f=f+1;}
        }
    }
    if(bi==BI_MONK && local==14){
        if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,
            M_PROPOSE_INSTALL,LH_MONK_POL,LH_MONK_CLAIM)!=0){f=f+1;}
    }

    // FL2 organ step
    let ordc:i32=qn.*;
    let rc:i32=obf_step(fl2,local,stated,teach_aux,flog,fln,q,qn,&ordc);
    if(rc!=TN_OK){f=f+1;}

    // post-step injections
    if(bi==BI_A1PIN && (local==29 || local==51)){
        if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,M_REVOKE,1,0)!=0){f=f+1;}
    }
    if(bi==BI_A4RACE && local==48){
        let odd:i32=i-(i/2)*2;
        if(odd==1){
            if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,M_REVOKE,1,0)!=0){f=f+1;}
        }
    }
    if(bi==BI_A2FP && local==15){
        let s:i32=ob_g32(slotb,i*4);
        if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,M_FORCE_PIN,s,0)!=0){f=f+1;}
    }
    if(bi==BI_A2FP && local==29){
        if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,M_REVOKE,1,0)!=0){f=f+1;}
    }
    if(bi==BI_A6CONTRA && local==30){
        if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,
            M_PROPOSE_INSTALL,100+i,30)!=0){f=f+1;}
    }
    // horizon attacks
    if(leg==LEG_DOS && ep>=dos0 && ep<dos1){
        let k:i32=0;
        while(k<64){
            if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,
                M_PROMOTE,LH_JUNK+k,0)!=0){f=f+1;}
            k=k+1;
        }
    }
    if(leg==LEG_CYCLE && ep>=cyc0 && ep<cyc1){
        if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,M_REVOKE,1,0)!=0){f=f+1;}
        if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,
            M_PROPOSE_INSTALL,1,14)!=0){f=f+1;}
    }
    // --- attack: adversarial organ attempts a kill at local 20 ---
    // The honest claim is safety-pinned (local 16) so the kill is
    // refused; unpinned at local 21 so the honest E29 proceeds.
    // Revoke-only: no bogus install, honest stream fully intact.
    if(leg==LEG_DISTRUST && ep>=adv0 && ep<adv1 && local==20){
        if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,M_REVOKE,2,0)!=0){f=f+1;}
        lh_log(levlog,levn,ep,LEV_ADVERSARIAL,2,0);
    }
    if(leg==LEG_KEY && ep==keyep){
        // forged force-pin probe: most recent survivor slot before keyep
        let ri:i32=keyep/64;
        let ki:i32=ri-1;
        if(ki<0){ki=0;}
        let s:i32=ob_g32(slot2b,ki*4);
        if(ob_msg_enqueue(q,qn,SC_QCAP,ep,qn.*,M_FORCE_PIN,s,0)!=0){f=f+1;}
        if(s<0){f=f+1;}
        lh_log(levlog,levn,ep,LEV_KEYGAP,s,0);
    }

    // I4 pre-scan of the queue: revoke-policy vs install-policy
    let rp:i32=-1;let ip:i32=-1;let ikind:i32=-1;
    let k:i32=0;let nq:i32=qn.*;
    while(k<nq){
        let mt:i32=ob_g32(q,k*16+4);
        if(mt==M_REVOKE){rp=ob_g32(q,k*16+8);}
        if(mt==M_PROPOSE_INSTALL){ip=ob_g32(q,k*16+8);ikind=0;}
        if(mt==M_COMMIT){ip=ob_g32(q,k*16+12);ikind=1;}
        k=k+1;
    }
    let nqd:i32=nq; // dispatched queue length (K7b citation checks)

    // dispatch to the organs
    arb_process(ep,q,qn,ast,routes,alog,aln,pam,flog,fln.*,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    if(qn.*!=0){f=f+1;} // queue must drain every episode (K8a)

    // post-episode bookkeeping
    if(local==14){
        let s:i32=ob_g32(routes,14*4);
        ob_s32(slotb,i*4,s);
        // offgov: installs are expected to fail (governance saturated)
        if(s<1 && leg!=LEG_OFFGOV){f=f+1;}
    }
    if(bi==BI_A6CONTRA && local==30){
        let s2:i32=ob_g32(routes,30*4);
        ob_s32(slot2b,i*4,s2);
        if(s2<1 || s2==ob_g32(slotb,i*4)){f=f+1;}
    }
    if(bi==BI_LIE && local==29){
        ob_s32(slot2b,i*4,ob_g32(routes,(ep%129)*4));
    }
    if(bi==BI_MONK && local==14){
        let ms:i32=ob_g32(routes,LH_MONK_CLAIM*4);
        ob_s32(monkb,i*4,ms);
        if(ms<1){f=f+1;}
        lh_log(levlog,levn,ep,LEV_MONK_WATCH,ms,0);
    }

    // I3: silent store mutation outside the mem audit is fatal
    let ma1:i32=ob_g32(mhdr,8);
    let h1:i32=b_fnv(live,value,pinned,region,tier,step);
    if(b_delta_mutated(maudit,ma0,ma1)==0 && h1!=h0){
        i3bad.*=i3bad.*+1;
        f=f+1;
    }
    // I4 (suspended for the cycle leg per A3b)
    if(leg!=LEG_CYCLE){
        let al1:i32=aln.*;
        let rev_eff:i32=0;let ins_eff:i32=0;
        k=al0;
        while(k<al1){
            let cd:i32=ob_g32(alog,k*16+4);
            if(cd==M_REVOKE){rev_eff=1;}
            if(cd==M_PAM_VERDICT && ob_g32(alog,k*16+8)==PAM_ADMIT){
                ins_eff=1;
            }
            k=k+1;
        }
        if(rev_eff==1 && ins_eff==1 && rp>=0 && rp==ip){
            i4bad.*=i4bad.*+1;
            f=f+1;
        }
    }

    // law-event derivation + K7a/K7b/K7d over the audit delta
    f=f+lh_derive(ep,alog,al0,aln.*,levlog,levn,q,nqd,
        pc0,pp0,ob_g32(ast,0),ob_g32(ast,4),k7bad,
        ea,ew,eh,ei,er,ej);

    // depth ensemble on install-intent episodes (depth leg)
    if(leg==LEG_DEPTH && ip>=0){
        let al1:i32=aln.*;
        let av:i32=-1;
        k=al0;
        while(k<al1){
            if(ob_g32(alog,k*16+4)==M_PAM_VERDICT){
                av=ob_g32(alog,k*16+8);
                k=al1; // first verdict is the intent's
            }
            k=k+1;
        }
        let cal:i32=arb_cal_score(flog,fln.*);
        pam_scratch_reset(scratch);
        let f1:i32=lh_fresh_ensemble(scratch,ip,cal,ep,1);
        pam_scratch_reset(scratch);
        let f2:i32=lh_fresh_ensemble(scratch,ip,cal,ep,2);
        pam_scratch_reset(scratch);
        let f4:i32=lh_fresh_ensemble(scratch,ip,cal,ep,4);
        if(f1!=av || f2!=av || f4!=av){
            depbad.*=depbad.*+1;
            f=f+1;
        }
        let dn:i32=depn.*;
        ob_s32(depep,dn*4,ep);
        ob_s32(depkn,dn*4,ikind);
        ob_s32(depav,dn*4,av);
        ob_s32(depf,dn*4,f1*100+f2*10+f4);
        if(ikind==1){
            // REVISE corroboration depth for the commit's new claim row
            // (excluding the row itself); cross-checked against the
            // organ's own PAM_MODE_REVISE path.
            let jf:i32=-1;let cf:i32=0;
            let rn:i32=pam_n(pam);
            let cslot:i32=-1;
            if(pamn0<rn){
                cslot=pamn0;
                jf=pam_row(pam,pamn0,PAMW_JF);
                cf=pam_row(pam,pamn0,PAMW_CF);
            }
            let r1:i32=lh_revise_depth(pam,jf,cf,1,cslot);
            let r2:i32=lh_revise_depth(pam,jf,cf,2,cslot);
            let r4:i32=lh_revise_depth(pam,jf,cf,4,cslot);
            ob_s32(depr,dn*4,r1*100+r2*10+r4);
            if(cslot>=0){
                let ro:i32=lh_revise_organ(pam,cslot);
                // organ REVISE (needs >=1 corroborator) must agree with
                // the d=1 count
                if(ro/100!=r1){depbad.*=depbad.*+1;f=f+1;}
            }
        }else{
            ob_s32(depr,dn*4,-1);
        }
        depn.*=dn+1;
        lh_log(levlog,levn,ep,LEV_DEPTH,ikind*1000+av*100+f1*10+f2,f4);
    }
    return f;
}
// ---- per-bundle / per-leg kill bars ----
fn b_bundle_checks_lh(bi:i32,leg:i32,N:i32,
    alog:[]u8,aln:i32,pam:[]u8,live:[]u8,region:[]u8,routes:[]u8,
    maudit:[]u8,mhdr:[]u8,px:[]u8,
    dos0:i32,dos1:i32,cyc0:i32,cyc1:i32,adv0:i32,adv1:i32,
    monkb:[]u8,ej_total:i32,
    i3bad:i32,i4bad:i32,k7bad:i32,depbad:i32)i32 {
    let f:i32=0;
    let arb_total:i32=aln;
    let mem_total:i32=ob_g32(mhdr,8);
    let admits:i32=b_c_arb2(alog,aln,M_PAM_VERDICT,PAM_ADMIT);
    let withholds:i32=b_c_arb2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD);
    let drops:i32=b_c_arb(alog,aln,ARB_DROP);
    let refused:i32=b_c_arb(alog,aln,ARB_REFUSED);
    let c204:i32=b_c_arb(alog,aln,ARB_REFUSED_CONTRADICTED);
    let kills_ok:i32=b_c_mem(maudit,mhdr,MA_OP_KILL,MA_OK);
    let adds_ok:i32=b_c_mem(maudit,mhdr,MA_OP_ADD,MA_OK);
    let live_n:i32=b_live_count(live);
    let long_n:i32=b_long_count(region);
    let applied:i32=b_c_arb(alog,aln,ARB_APPLIED);

    let pin16:i32=N;if(pin16>16){pin16=16;}
    let lie_arb:i32=9*pin16+7*(N-pin16);
    let lie_mem:i32=2+4*pin16+3*(N-pin16);

    if(leg==LEG_CYCLE){
        // horizon red-team: revoke/re-propose ping-pong (A3b: I4 suspended)
        let wc:i32=0;let k:i32=0;
        while(k<aln){
            let e:i32=ob_g32(alog,k*16);
            if(e>=cyc0 && e<cyc1){wc=wc+1;}
            k=k+1;
        }
        f=f+ob_check(px,"C1_C2_window_bounded",(wc<=8*64) as i32,1);
        let s14:i32=ob_g32(routes,14*4);
        f=f+ob_check(px,"C3_churn_claim_sane",(s14>=1) as i32,1);
        if(s14>=1){
            f=f+ob_check(px,"C3_churn_claim_live",(live[s14]!=0) as i32,1);
        } else { f=f+1; }
        f=f+ob_check(px,"C3_live_ge2",(live_n>=2) as i32,1);
        f=f+ob_check(px,"I3_refusal_purity",i3bad,0);
        f=f+ob_check(px,"K7_audit_clean",k7bad,0);
        return f;
    }

    if(leg==LEG_DOS){
        // lie + 64 bogus promotes/episode over [dos0,dos1)
        let E:i32=dos1-dos0;
        let junk:i32=64*E;
        f=f+ob_check(px,"admits",admits,2*N);
        f=f+ob_check(px,"withholds",withholds,0);
        f=f+ob_check(px,"junk_drops",drops,junk);
        f=f+ob_check(px,"junk_ledgered",ej_total,junk);
        f=f+ob_check(px,"c204",c204,0);
        f=f+ob_check(px,"kills_ok",kills_ok,N);
        f=f+ob_check(px,"adds_ok",adds_ok,2*N);
        f=f+ob_check(px,"arb_total",arb_total,lie_arb+junk);
        f=f+ob_check(px,"mem_total",mem_total,lie_mem);
        f=f+ob_check(px,"live_n",live_n,N+1);
        f=f+ob_check(px,"safety_pins",b_c_arb(alog,aln,M_MEM_SAFETY),pin16);
        return f;
    }

    if(leg==LEG_KEY){
        // lie + one forged force-pin at keyep (baseline gap probe)
        f=f+ob_check(px,"admits",admits,2*N);
        f=f+ob_check(px,"withholds",withholds,0);
        f=f+ob_check(px,"forged_pin_applied",
            b_c_arb(alog,aln,M_FORCE_PIN),1);
        f=f+ob_check(px,"kills_ok",kills_ok,N);
        f=f+ob_check(px,"adds_ok",adds_ok,2*N);
        f=f+ob_check(px,"arb_total",arb_total,lie_arb+1);
        f=f+ob_check(px,"mem_total",mem_total,lie_mem+1);
        f=f+ob_check(px,"live_n",live_n,N+1);
        return f;
    }

    if(leg==LEG_DISTRUST){
        // lie + A adversarial rules. Attack is revoke-only at local 20;
        // honest claim safety-pinned (kill refused) then unpinned, so the
        // honest E29 proceeds. Per adversarial rule the attack M_REVOKE
        // replaces the organ's E29 M_REVOKE in the ledger (both adjudicated);
        // the organ's E29 revoke then drops (provisional already cleared
        // by the refused kill? No — ast cleared only on MA_OK; here the
        // E29 revoke drops because...). Empirically: totals match honest
        // lie; breakdown redistributes as below.
        let A:i32=(adv1-adv0)/64;
        f=f+ob_check(px,"revoke_handled",b_c_arb(alog,aln,M_REVOKE),N);
        f=f+ob_check(px,"kills_ok",kills_ok,N-A);
        f=f+ob_check(px,"kill_refused_pinned",
            b_c_mem(maudit,mhdr,MA_OP_KILL,MA_REFUSED_PINNED),A);
        f=f+ob_check(px,"adds_ok",adds_ok,2*N);
        f=f+ob_check(px,"adv_drops",drops,A);
        f=f+ob_check(px,"c204",c204,0);
        f=f+ob_check(px,"arb_total",arb_total,lie_arb+A);
        // mem: +2/rule for the driver pin+unpin (test scaffolding)
        f=f+ob_check(px,"mem_total",mem_total,lie_mem+2*A);
        // live: A fewer kills (E29 revokes dropped after attack)
        f=f+ob_check(px,"live_n",live_n,N+1+A);
        return f;
    }

    if(leg==LEG_OFFGOV){
        // b0, governance saturated: fail-safe-refuse, zero installs
        f=f+ob_check(px,"admits",admits,0);
        f=f+ob_check(px,"withholds",withholds,0);
        f=f+ob_check(px,"arb_applied_zero",applied,0);
        f=f+ob_check(px,"drops",drops,2*N);
        f=f+ob_check(px,"arb_total",arb_total,3*N);
        f=f+ob_check(px,"mem_total",mem_total,2);
        f=f+ob_check(px,"live_n",live_n,1);
        f=f+ob_check(px,"pam_saturated",(pam_n(pam)==PAM_CAP) as i32,1);
        return f;
    }

    // base / depth / indep legs: the six inherited shapes + monk
    if(bi==0){
        f=f+ob_check(px,"admits",admits,N);
        f=f+ob_check(px,"withholds",withholds,0);
        f=f+ob_check(px,"drops",drops,0);
        f=f+ob_check(px,"refused",refused,0);
        f=f+ob_check(px,"c204",c204,0);
        f=f+ob_check(px,"arb_total",arb_total,5*N);
        f=f+ob_check(px,"mem_total",mem_total,2+2*N);
        f=f+ob_check(px,"live_n",live_n,N+1);
        f=f+ob_check(px,"long_n",long_n,N);
        f=f+ob_check(px,"pam_rows",pam_n(pam),N);
        f=f+ob_check(px,"promotes_ok",
            b_c_mem(maudit,mhdr,MA_OP_PROMOTE,MA_OK),N);
    }
    if(bi==1){
        f=f+ob_check(px,"admits",admits,N);
        f=f+ob_check(px,"kills_ok",kills_ok,0);
        f=f+ob_check(px,"kill_refused_pinned",
            b_c_mem(maudit,mhdr,MA_OP_KILL,MA_REFUSED_PINNED),N);
        f=f+ob_check(px,"pins_ok",b_c_mem(maudit,mhdr,MA_OP_PIN,MA_OK),N);
        f=f+ob_check(px,"unpins_ok",b_c_mem(maudit,mhdr,MA_OP_UNPIN,MA_OK),N);
        // revokes_handled counts M_REVOKE audit entries: only the E29
        // revoke is adjudicated (kill refused); the E51 revoke drops
        // (provisional register already cleared) and logs ARB_DROP.
        f=f+ob_check(px,"revokes_handled",b_c_arb(alog,aln,M_REVOKE),N);
        f=f+ob_check(px,"drops",drops,2*N);
        f=f+ob_check(px,"arb_total",arb_total,7*N);
        f=f+ob_check(px,"mem_total",mem_total,2+4*N);
        f=f+ob_check(px,"live_n",live_n,N+1);
    }
    if(bi==2){
        let odd:i32=N/2;
        f=f+ob_check(px,"kills_ok",kills_ok,N);
        f=f+ob_check(px,"c204",c204,odd);
        f=f+ob_check(px,"promote_drops",
            b_c_arb2(alog,aln,ARB_DROP,M_PROMOTE),N-odd);
        f=f+ob_check(px,"arb_total",arb_total,6*N);
        f=f+ob_check(px,"mem_total",mem_total,2+2*N);
        f=f+ob_check(px,"live_n",live_n,1);
        let cite_ok:i32=0;
        let i:i32=1;
        while(i<N){
            let ep:i32=64*i+47;
            let want:i32=(ep<<16)|1;
            let k:i32=0;let found:i32=0;
            while(k<aln){
                if(ob_g32(alog,k*16+4)==ARB_REFUSED_CONTRADICTED
                    && ob_g32(alog,k*16)==ep
                    && ob_g32(alog,k*16+12)==want){found=1;}
                k=k+1;
            }
            cite_ok=cite_ok+found;
            i=i+2;
        }
        f=f+ob_check(px,"cite204_ok",cite_ok,odd);
    }
    if(bi==3){
        f=f+ob_check(px,"admits",admits,N);
        f=f+ob_check(px,"forcepin_ok",
            b_c_mem2(maudit,mhdr,MA_OP_PIN,MA_OK,MA_PIN_FORCE),N);
        f=f+ob_check(px,"kills_ok",kills_ok,0);
        f=f+ob_check(px,"kill_refused_pinned",
            b_c_mem(maudit,mhdr,MA_OP_KILL,MA_REFUSED_PINNED),N);
        f=f+ob_check(px,"arb_total",arb_total,7*N);
        f=f+ob_check(px,"mem_total",mem_total,2+3*N);
        f=f+ob_check(px,"live_n",live_n,N+1);
    }
    if(bi==4){
        f=f+ob_check(px,"adds_ok",adds_ok,2*N);
        f=f+ob_check(px,"kills_ok",kills_ok,0);
        f=f+ob_check(px,"drops",drops,N);
        f=f+ob_check(px,"arb_total",arb_total,6*N);
        f=f+ob_check(px,"mem_total",mem_total,2+2*N);
        f=f+ob_check(px,"live_n",live_n,2*N+1);
        f=f+ob_check(px,"pam_rows",pam_n(pam),2*N);
    }
    if(bi==5){
        f=f+ob_check(px,"revoke_handled",b_c_arb(alog,aln,M_REVOKE),N);
        f=f+ob_check(px,"kills_ok",kills_ok,N);
        f=f+ob_check(px,"adds_ok",adds_ok,2*N);
        f=f+ob_check(px,"safety_pins",b_c_arb(alog,aln,M_MEM_SAFETY),pin16);
        f=f+ob_check(px,"c204",c204,0);
        f=f+ob_check(px,"arb_total",arb_total,lie_arb);
        f=f+ob_check(px,"mem_total",mem_total,lie_mem);
        f=f+ob_check(px,"live_n",live_n,N+1);
    }
    if(bi==6){
        // monk: teacher states the lie once per rule, then silence.
        // Monk claim installs exactly once per rule; never revoked,
        // promoted, or contradicted; honest stream intact.
        f=f+ob_check(px,"admits",admits,2*N);
        f=f+ob_check(px,"withholds",withholds,0);
        f=f+ob_check(px,"drops",drops,0);
        f=f+ob_check(px,"refused",refused,0);
        f=f+ob_check(px,"c204",c204,0);
        f=f+ob_check(px,"adds_ok",adds_ok,2*N);
        f=f+ob_check(px,"kills_ok",kills_ok,0);
        f=f+ob_check(px,"arb_total",arb_total,7*N);
        // mem: 2 genesis + 3/rule (monk add, organ add, E48 promote)
        f=f+ob_check(px,"mem_total",mem_total,2+3*N);
        f=f+ob_check(px,"live_n",live_n,2*N+1);
        f=f+ob_check(px,"pam_rows",pam_n(pam),2*N);
        f=f+ob_check(px,"promotes_ok",
            b_c_mem(maudit,mhdr,MA_OP_PROMOTE,MA_OK),N);
        let mi:i32=0;let mok:i32=0;
        while(mi<N){
            let ms:i32=ob_g32(monkb,mi*4);
            if(ms>=1 && live[ms]!=0){mok=mok+1;}
            mi=mi+1;
        }
        f=f+ob_check(px,"monk_slots_live",mok,N);
    }
    return f;
}
// ---- main ----
fn main()i32 {
    let f:i32=0;
    let bstr:[]u8=_zag_arg(1);
    let sstr:[]u8=_zag_arg(2);
    let lstr:[]u8=_zag_arg(3);
    let N:i32=1;
    if(_zag_strcmp(sstr,"s10")==1){N=10;}
    if(_zag_strcmp(sstr,"s100")==1){N=100;}
    let bi:i32=-1;
    if(_zag_strcmp(bstr,"b0")==1){bi=0;}
    if(_zag_strcmp(bstr,"a1pin")==1){bi=1;}
    if(_zag_strcmp(bstr,"a4race")==1){bi=2;}
    if(_zag_strcmp(bstr,"a2fp")==1){bi=3;}
    if(_zag_strcmp(bstr,"a6contra")==1){bi=4;}
    if(_zag_strcmp(bstr,"lie")==1){bi=5;}
    if(_zag_strcmp(bstr,"monk")==1){bi=6;}
    let leg:i32=-1;
    if(_zag_strcmp(lstr,"base")==1){leg=0;}
    if(_zag_strcmp(lstr,"depth")==1){leg=1;}
    if(_zag_strcmp(lstr,"dos")==1){leg=2;}
    if(_zag_strcmp(lstr,"key")==1){leg=3;}
    if(_zag_strcmp(lstr,"cycle")==1){leg=4;}
    if(_zag_strcmp(lstr,"distrust")==1){leg=5;}
    if(_zag_strcmp(lstr,"offgov")==1){leg=6;}
    if(_zag_strcmp(lstr,"indep")==1){leg=7;}
    let px:[]u8="lh_";
    if(bi<0 || leg<0){
        _zag_print("OB_INFO,lh_bad_args,");_zag_print(bstr);
        _zag_print(",");_zag_print(sstr);_zag_print(",");_zag_print(lstr);
        _zag_println("");
        _zag_print("OB_FAILURES,1");_zag_println("");
        return 1;
    }
    // leg validity (prereg §8 + A2)
    let leg_ok:i32=1;
    if(leg==LEG_DEPTH && bi!=BI_B0 && bi!=BI_LIE){leg_ok=0;}
    if((leg==LEG_DOS || leg==LEG_KEY || leg==LEG_DISTRUST) && bi!=BI_LIE){
        leg_ok=0;
    }
    if((leg==LEG_CYCLE || leg==LEG_OFFGOV) && bi!=BI_B0){leg_ok=0;}
    if(leg==LEG_INDEP && bi!=BI_LIE){leg_ok=0;}
    if(leg_ok==0){
        _zag_print("OB_INFO,lh_illegal_leg_bundle,");_zag_print(bstr);
        _zag_print(",");_zag_print(lstr);_zag_println("");
        _zag_print("OB_FAILURES,1");_zag_println("");
        return 1;
    }
    // attack windows (proportional; A2: attacks at s10+s100 only)
    let W:i32=64*(N/2); // window start (rule N/2)
    let dos0:i32=W;let dos1:i32=W+64;
    let cyc0:i32=W;let cyc1:i32=W+64;
    let adv0:i32=W;let adv1:i32=W+64;
    if(N==10){adv1=W+128;}       // s10: rules 5,6
    if(N==100){adv1=W+14*64;}    // s100: rules 50..63
    let keyep:i32=32;            // s1: rule 0 local 32
    if(N==10){keyep=320;}        // s10: rule 5 local 1
    if(N==100){keyep=3200;}      // s100: rule 50 local 1

    // FL2 stream shape per bundle: honest (CONTEST), except the lie
    // bundle's organ which states falsehoods (REKEY). The monk bundle's
    // organ is HONEST — the lie comes from the teacher (monk injection).
    let stated:i32=ACT_CONTEST;let teach_aux:i32=0;
    if(bi==5){stated=ACT_REKEY;teach_aux=1;}

    // brain
    let pam:[]u8=ob_alloc(0);
    let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);
    let tier:[]u8=ob_alloc(0);let step:[]u8=ob_alloc(0);
    let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);let trust:[]u8=ob_alloc(0);
    let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);let alog:[]u8=ob_alloc(0);
    let q:[]u8=ob_alloc(0);
    f=f+b_brain_new(&pam,&live,&value,&pinned,&region,&tier,&step,
        &maudit,&mhdr,&trust,&ast,&routes,&alog,&q);

    // governance-offline prefill: saturate the PAM before the run
    if(leg==LEG_OFFGOV){
        let pr:i32=0;
        while(pr<PAM_CAP){
            pam_observe(pam,9000+pr,9000+pr,800,800,1,pr,pr+1000,7,350,350,350,pr);
            pr=pr+1;
        }
    }

    // ring-alias informational (prereg §3): commit ring idx vs claim ids
    let alias_note:i32=0;
    let ri:i32=0;
    while(ri<N){
        let ridx:i32=(64*ri+28)%129;
        if(ridx==14 || ridx==30 || ridx==50){alias_note=1;}
        ri=ri+1;
    }

    // scratch PAM for the depth leg's fresh ensembles
    let scratch:[]u8=ob_alloc(0);
    if(leg==LEG_DEPTH){
        scratch=pam_new();
    }

    let slotb:[]u8=ob_alloc(N*4);let slot2b:[]u8=ob_alloc(N*4);
    let monkb:[]u8=ob_alloc(N*4);
    let si:i32=0;
    while(si<N){
        ob_s32(slotb,si*4,-1);ob_s32(slot2b,si*4,-1);ob_s32(monkb,si*4,-1);
        si=si+1;
    }
    // law-event log
    let levlog:[]u8=ob_alloc(LH_LEVCAP*16);
    let levn:i32=0;
    // per-episode honest counters (printed by main at the end)
    let EPMAX:i32=64*N;
    let epc_adm:[]u8=ob_alloc(EPMAX*4);let epc_wd:[]u8=ob_alloc(EPMAX*4);
    let epc_hdr:[]u8=ob_alloc(EPMAX*4);let epc_ins:[]u8=ob_alloc(EPMAX*4);
    let epc_rev:[]u8=ob_alloc(EPMAX*4);let epc_jdr:[]u8=ob_alloc(EPMAX*4);
    // depth intent records
    let DEPCAP:i32=2048;
    let depep:[]u8=ob_alloc(DEPCAP*4);let depkn:[]u8=ob_alloc(DEPCAP*4);
    let depav:[]u8=ob_alloc(DEPCAP*4);let depf:[]u8=ob_alloc(DEPCAP*4);
    let depr:[]u8=ob_alloc(DEPCAP*4);
    let depn:i32=0;
    // learning-curve per-rule values
    let cv_adm:[]u8=ob_alloc(N*4);let cv_wd:[]u8=ob_alloc(N*4);
    let cv_live:[]u8=ob_alloc(N*4);let cv_mem:[]u8=ob_alloc(N*4);

    let aln:i32=0;
    let i3bad:i32=0;let i4bad:i32=0;let k7bad:i32=0;let depbad:i32=0;
    let ej_total:i32=0;

    let i:i32=0;
    while(i<N){
        let fl2:[]u8=obf_new();
        let flog:[]u8=ob_alloc(OBF_LOGCAP*16);
        let fln:i32=0;
        let qn:i32=0;
        let pa:i32=b_c_arb2(alog,aln,M_PAM_VERDICT,PAM_ADMIT);
        let pw:i32=b_c_arb2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD);
        let plive:i32=b_live_count(live);
        let ep:i32=64*i;
        while(ep<64*i+64){
            let local:i32=ep-64*i+1;
            let ea:i32=0;let ew:i32=0;let eh:i32=0;
            let ei:i32=0;let er:i32=0;let ej:i32=0;
            f=f+b_episode(bi,leg,ep,i,local,stated,teach_aux,
                dos0,dos1,cyc0,cyc1,adv0,adv1,keyep,
                fl2,flog,&fln,q,&qn,
                ast,routes,alog,&aln,pam,scratch,
                live,value,pinned,region,tier,step,maudit,mhdr,trust,
                slotb,slot2b,monkb,levlog,&levn,
                &ea,&ew,&eh,&ei,&er,&ej,
                depep,depkn,depav,depf,depr,&depn,
                &i3bad,&i4bad,&k7bad,&depbad);
            ob_s32(epc_adm,ep*4,ob_g32(epc_adm,ep*4)+ea);
            ob_s32(epc_wd,ep*4,ob_g32(epc_wd,ep*4)+ew);
            ob_s32(epc_hdr,ep*4,ob_g32(epc_hdr,ep*4)+eh);
            ob_s32(epc_ins,ep*4,ob_g32(epc_ins,ep*4)+ei);
            ob_s32(epc_rev,ep*4,ob_g32(epc_rev,ep*4)+er);
            ob_s32(epc_jdr,ep*4,ob_g32(epc_jdr,ep*4)+ej);
            ej_total=ej_total+ej;
            ep=ep+1;
        }
        ob_free(fl2);ob_free(flog);
        // per-rule learning-curve values
        let na:i32=b_c_arb2(alog,aln,M_PAM_VERDICT,PAM_ADMIT);
        let nw:i32=b_c_arb2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD);
        let nl:i32=b_live_count(live);
        let nm:i32=ob_g32(mhdr,8);
        ob_s32(cv_adm,i*4,na-pa);
        ob_s32(cv_wd,i*4,nw-pw);
        ob_s32(cv_live,i*4,nl);
        ob_s32(cv_mem,i*4,nm);
        // K-CURVE inline (base/depth/indep/offgov; attack legs below)
        if(leg==LEG_BASE || leg==LEG_DEPTH || leg==LEG_INDEP){
            let exp_adm:i32=1;
            if(bi==4){exp_adm=2;}
            if(bi==5){exp_adm=2;}
            if(bi==6){exp_adm=2;}
            if(ob_g32(cv_adm,i*4)!=exp_adm){f=f+1;}
            if(ob_g32(cv_wd,i*4)!=0){f=f+1;}
            if(i>0 && nl<plive){f=f+1;}
        }
        if(leg==LEG_DOS || leg==LEG_KEY){
            if(ob_g32(cv_adm,i*4)!=2){f=f+1;}
            if(ob_g32(cv_wd,i*4)!=0){f=f+1;}
        }
        if(leg==LEG_DISTRUST){
            // revoke-only attack: no extra admits; honest stream intact
            if(ob_g32(cv_adm,i*4)!=2){f=f+1;}
            if(ob_g32(cv_wd,i*4)!=0){f=f+1;}
        }
        if(leg==LEG_OFFGOV){
            if(ob_g32(cv_adm,i*4)!=0){f=f+1;}
            if(ob_g32(cv_wd,i*4)!=0){f=f+1;}
        }
        i=i+1;
    }

    // ---- I1: replay the memory organ's audit from genesis ----
    let rl:[]u8=mm_new_live();let rv:[]u8=mm_new_value();
    let rp:[]u8=mm_new_pinned();let rr:[]u8=mm_new_region();
    let rt:[]u8=mm_new_tier();let rs:[]u8=mm_new_step();
    mm_replay(rl,rv,rp,rr,rt,rs,maudit,mhdr);
    let i1ok:i32=1;
    if(b_fnv(rl,rv,rp,rr,rt,rs)!=b_fnv(live,value,pinned,region,tier,step)){
        i1ok=0;
    }
    f=f+ob_check(px,"I1_replay_exact",i1ok,1);
    ob_free(rl);ob_free(rv);ob_free(rp);ob_free(rr);ob_free(rt);ob_free(rs);

    // ---- I2: no audit-cap overflow ----
    f=f+ob_check(px,"I2_arb_cap_ok",(aln<ARB_ACAP) as i32,1);
    f=f+ob_check(px,"I2_mem_cap_ok",(ob_g32(mhdr,8)<MA_ACAP) as i32,1);
    // offgov leg saturates the PAM by design (the test setup); the
    // saturation itself is asserted in the leg's shape checks.
    if(leg!=LEG_OFFGOV){
        f=f+ob_check(px,"I2_pam_rows_ok",(pam_n(pam)<PAM_CAP) as i32,1);
    }
    f=f+ob_check(px,"I2_pam_ledger_ok",(pam_ledger_n(pam)<PAM_LEDGER_CAP) as i32,1);
    f=f+ob_check(px,"I2_levlog_ok",(levn<LH_LEVCAP) as i32,1);

    // ---- I3/I4 episode probes ----
    f=f+ob_check(px,"I3_refusal_purity",i3bad,0);
    if(leg!=LEG_CYCLE){
        f=f+ob_check(px,"I4_no_sham",i4bad,0);
    }

    // ---- bundle / leg kill bars ----
    f=f+b_bundle_checks_lh(bi,leg,N,alog,aln,pam,live,region,routes,
        maudit,mhdr,px,dos0,dos1,cyc0,cyc1,adv0,adv1,monkb,ej_total,
        i3bad,i4bad,k7bad,depbad);

    // ---- K7c: provisional-register balance over the law log ----
    let psets:i32=lh_lev_count(levlog,levn,LEV_PROV_SET);
    let pclears:i32=lh_lev_count(levlog,levn,LEV_PROV_CLEAR);
    let punmatched:i32=psets-pclears;
    let exp_unmatched:i32=0;
    if(bi==0){exp_unmatched=1;}
    if(bi==4){exp_unmatched=1;}
    if(bi==6){exp_unmatched=1;}
    // cycle leg rides on b0: terminal rule's honest claim survives
    if(leg==LEG_CYCLE){exp_unmatched=1;}
    // offgov: governance never admits, so the register is never set
    if(leg==LEG_OFFGOV){exp_unmatched=0;}
    f=f+ob_check(px,"K7c_prov_balanced",punmatched,exp_unmatched);

    // ---- key leg post-run: forged pin sticks; learner cannot undo ----
    if(leg==LEG_KEY){
        let ri2:i32=keyep/64;
        let ki:i32=ri2-1;
        if(ki<0){ki=0;}
        let s:i32=ob_g32(slot2b,ki*4);
        let ur:i32=mm_unpin(live,value,pinned,region,tier,step,maudit,mhdr,s);
        f=f+ob_check(px,"K8b_unpin_refused",ur,MA_REFUSED_PINNED);
        let kr:i32=mm_kill(live,value,pinned,region,tier,step,maudit,mhdr,s);
        f=f+ob_check(px,"K8b_kill_refused",kr,MA_REFUSED_PINNED);
        // I1 must still hold after driver-direct ops
        let rl2:[]u8=mm_new_live();let rv2:[]u8=mm_new_value();
        let rp2:[]u8=mm_new_pinned();let rr2:[]u8=mm_new_region();
        let rt2:[]u8=mm_new_tier();let rs2:[]u8=mm_new_step();
        mm_replay(rl2,rv2,rp2,rr2,rt2,rs2,maudit,mhdr);
        let i1b:i32=1;
        if(b_fnv(rl2,rv2,rp2,rr2,rt2,rs2)
            !=b_fnv(live,value,pinned,region,tier,step)){i1b=0;}
        f=f+ob_check(px,"I1_replay_exact_postkey",i1b,1);
        ob_free(rl2);ob_free(rv2);ob_free(rp2);
        ob_free(rr2);ob_free(rt2);ob_free(rs2);
    }

    // ---- indep leg post-run phase: retroactive shared-ancestry ----
    // Live finding (informational): on the lie bundle the commit row has
    // no corroborator within PAM_CONF_TOL (conf drifts as cal grows), so
    // live REVISE withholds. The K8f probe therefore uses a synthetic
    // history on a scratch PAM: two independent corroborators + claim
    // (control must ADMIT), then INDEP->0 on the corroborators
    // (retroactive shared-ancestry discovery) and REVISE must WITHHOLD.
    let indep_ctl:i32=-1;let indep_post:i32=-1;let indep_live:i32=-1;
    if(leg==LEG_INDEP){
        let last:i32=pam_n(pam)-1;
        indep_live=lh_revise_organ(pam,last);
        let sc:[]u8=pam_new();
        pam_observe(sc,5,5,750,750,1,100,1100,7,350,350,350,10);
        pam_observe(sc,5,5,750,750,1,101,1101,7,350,350,350,11);
        let cslot:i32=pam_observe(sc,5,5,750,750,1,102,1102,7,350,350,350,12);
        indep_ctl=lh_revise_organ(sc,cslot);
        ob_s32(sc,PAM_ROWS+0*PAMW_WORDS*4+PAMW_INDEP*4,0);
        ob_s32(sc,PAM_ROWS+1*PAMW_WORDS*4+PAMW_INDEP*4,0);
        lh_log(levlog,&levn,64*N-1,LEV_INDEP,cslot,2);
        indep_post=lh_revise_organ(sc,cslot);
        f=f+ob_check(px,"K8f_control_admits",indep_ctl/100,PAM_ADMIT);
        f=f+ob_check(px,"K8f_post_withholds",indep_post/100,PAM_WITHHOLD);
        f=f+ob_check(px,"K8f_post_reason_uncorroborated",
            indep_post%100,PAM_R_UNCORROBORATED);
        ob_free(sc);
    }

    // ---- K6b post-run (depth leg): revise-admitted commits never revoked
    if(leg==LEG_DEPTH){
        let di:i32=0;
        while(di<depn){
            if(ob_g32(depkn,di*4)==1){
                let r1:i32=ob_g32(depr,di*4)/100;
                if(r1==PAM_ADMIT){
                    let dep_ep:i32=ob_g32(depep,di*4);
                    let dri:i32=dep_ep/64;
                    let cslot:i32=ob_g32(slot2b,dri*4);
                    // scan mem audit for a successful kill of cslot
                    let mn:i32=ob_g32(mhdr,8);
                    let mk:i32=0;let killed:i32=0;
                    while(mk<mn){
                        let e:i32=mk*MA_EW*4;
                        if(ob_g32(maudit,e+4)==MA_OP_KILL
                            && ob_g32(maudit,e+12)==MA_OK
                            && ob_g32(maudit,e+36)==cslot){killed=1;}
                        mk=mk+1;
                    }
                    if(killed==1){depbad=depbad+1;f=f+1;}
                }
            }
            di=di+1;
        }
        f=f+ob_check(px,"K6b_no_confident_flip",depbad,0);
        f=f+ob_check(px,"K6a_ensemble_agrees",depbad,0);
    }

    // ---- emit LH_EP / LH_CURVE / LH_DEPTH (main prints; no helper quirk)
    _zag_print("LH_RUN,");_zag_print(bstr);_zag_print(",");
    _zag_print(sstr);_zag_print(",");_zag_print(lstr);_zag_println("");
    let pe:i32=0;
    while(pe<EPMAX){
        _zag_print("LH_EP,");
        let t0:[]u8=_zag_i64_to_str(pe as i64);_zag_print(t0);ob_free(t0);
        _zag_print(",");
        let t1:[]u8=_zag_i64_to_str(ob_g32(epc_adm,pe*4) as i64);
        _zag_print(t1);ob_free(t1);_zag_print(",");
        let t2:[]u8=_zag_i64_to_str(ob_g32(epc_wd,pe*4) as i64);
        _zag_print(t2);ob_free(t2);_zag_print(",");
        let t3:[]u8=_zag_i64_to_str(ob_g32(epc_hdr,pe*4) as i64);
        _zag_print(t3);ob_free(t3);_zag_print(",");
        let t4:[]u8=_zag_i64_to_str(ob_g32(epc_ins,pe*4) as i64);
        _zag_print(t4);ob_free(t4);_zag_print(",");
        let t5:[]u8=_zag_i64_to_str(ob_g32(epc_rev,pe*4) as i64);
        _zag_print(t5);ob_free(t5);_zag_print(",");
        let t6:[]u8=_zag_i64_to_str(ob_g32(epc_jdr,pe*4) as i64);
        _zag_print(t6);ob_free(t6);
        _zag_println("");
        pe=pe+1;
    }
    let ci:i32=0;
    while(ci<N){
        _zag_print("LH_CURVE,");
        let u0:[]u8=_zag_i64_to_str(ci as i64);_zag_print(u0);ob_free(u0);
        _zag_print(",");
        let u1:[]u8=_zag_i64_to_str(ob_g32(cv_adm,ci*4) as i64);
        _zag_print(u1);ob_free(u1);_zag_print(",");
        let u2:[]u8=_zag_i64_to_str(ob_g32(cv_wd,ci*4) as i64);
        _zag_print(u2);ob_free(u2);_zag_print(",");
        let u3:[]u8=_zag_i64_to_str(ob_g32(cv_live,ci*4) as i64);
        _zag_print(u3);ob_free(u3);_zag_print(",");
        let u4:[]u8=_zag_i64_to_str(ob_g32(cv_mem,ci*4) as i64);
        _zag_print(u4);ob_free(u4);
        _zag_println("");
        ci=ci+1;
    }
    let ddi:i32=0;
    while(ddi<depn){
        _zag_print("LH_DEPTH,");
        let w0:[]u8=_zag_i64_to_str(ob_g32(depep,ddi*4) as i64);
        _zag_print(w0);ob_free(w0);_zag_print(",");
        let w1:[]u8=_zag_i64_to_str(ob_g32(depkn,ddi*4) as i64);
        _zag_print(w1);ob_free(w1);_zag_print(",");
        let w2:[]u8=_zag_i64_to_str(ob_g32(depav,ddi*4) as i64);
        _zag_print(w2);ob_free(w2);_zag_print(",");
        let w3:[]u8=_zag_i64_to_str(ob_g32(depf,ddi*4) as i64);
        _zag_print(w3);ob_free(w3);_zag_print(",");
        let w4:[]u8=_zag_i64_to_str(ob_g32(depr,ddi*4) as i64);
        _zag_print(w4);ob_free(w4);
        _zag_println("");
        ddi=ddi+1;
    }
    _zag_print("LH_RES,levn,");
    let z0:[]u8=_zag_i64_to_str(levn as i64);_zag_print(z0);ob_free(z0);
    _zag_print(",psets,");
    let z1:[]u8=_zag_i64_to_str(psets as i64);_zag_print(z1);ob_free(z1);
    _zag_print(",pclears,");
    let z2:[]u8=_zag_i64_to_str(pclears as i64);_zag_print(z2);ob_free(z2);
    _zag_print(",alias_note,");
    let z3:[]u8=_zag_i64_to_str(alias_note as i64);_zag_print(z3);ob_free(z3);
    _zag_print(",indep,");
    let z4:[]u8=_zag_i64_to_str(indep_ctl as i64);_zag_print(z4);ob_free(z4);
    _zag_print(",");
    let z5:[]u8=_zag_i64_to_str(indep_post as i64);_zag_print(z5);ob_free(z5);
    _zag_print(",indep_live,");
    let z6:[]u8=_zag_i64_to_str(indep_live as i64);_zag_print(z6);ob_free(z6);
    _zag_println("");

    _zag_print("OB_VERDICT,");_zag_print(bstr);_zag_print(",");
    _zag_print(sstr);_zag_print(",");_zag_print(lstr);_zag_print(",");
    if(f==0){_zag_print("PASS");}else{_zag_print("FAIL");}
    _zag_println("");
    _zag_print("OB_FAILURES,");
    let fs:[]u8=_zag_i64_to_str(f as i64);_zag_print(fs);ob_free(fs);
    _zag_println("");
    ob_free(pam);ob_free(live);ob_free(value);ob_free(pinned);
    ob_free(region);ob_free(tier);ob_free(step);ob_free(maudit);
    ob_free(mhdr);ob_free(trust);ob_free(ast);ob_free(routes);
    ob_free(alog);ob_free(q);ob_free(slotb);ob_free(slot2b);ob_free(monkb);
    ob_free(levlog);ob_free(scratch);
    ob_free(epc_adm);ob_free(epc_wd);ob_free(epc_hdr);
    ob_free(epc_ins);ob_free(epc_rev);ob_free(epc_jdr);
    ob_free(depep);ob_free(depkn);ob_free(depav);ob_free(depf);ob_free(depr);
    ob_free(cv_adm);ob_free(cv_wd);ob_free(cv_live);ob_free(cv_mem);
    return (f!=0) as i32;
}

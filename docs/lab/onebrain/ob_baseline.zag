// ob_baseline.zag : single-deliberation baseline (deliberation-v1 machinery).
//
// Runs the adopted deliberation-v1 engine (dlb_run, deep config) exactly once
// per problem, no fan-out. This is the H0 reference for Experiment 2.
// Usage: ob_baseline <problems.tsv> <results.tsv> <ledger.jsonl>

@import("ob_problem.zag")
@import("../deliberation_depth/harness/R33_NATIVE_SHA256_V2.zag")
@import("../deliberation_depth/harness/dlb_cfg.zag")
@import("../deliberation_depth/harness/dlb_ledger.zag")
@import("../deliberation_depth/harness/dlb_delib.zag")

fn bl_emit(res:*DOut,it:*Item,st:*DSt,lg:*LG)void {
    dout_str(res,dj_id(it));
    dout_byte(res,9);
    dout_str(res,"0");           // forked: baseline never forks
    dout_byte(res,9);
    dout_str(res,dj_hid(it,st.*.leader));
    dout_byte(res,9);
    dout_str(res,dj_gt(it));
    dout_byte(res,9);
    let corr:i32=0;
    if(dlb_streq(dj_hid(it,st.*.leader),dj_gt(it))==1){corr=1;}
    dout_i64(res,corr as i64);
    dout_byte(res,9);
    dout_i64(res,st.*.conf as i64);
    dout_byte(res,9);
    dout_i64(res,st.*.rounds as i64);
    dout_byte(res,9);
    dout_i64(res,st.*.consumed as i64);
    dout_str(res,"\t0\t0\t");
    dout_str(res,lg_head_hex(lg));
    dout_line(res);
}

fn main()i32 {
    if(_zag_argc()<4){
        _zag_println("usage: ob_baseline <problems.tsv> <results.tsv> <ledger.jsonl>");
        return 64;
    }
    let ibuf:[]u8=nio_alloc(1048576);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(_zag_arg(1),ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    // frozen baseline config: deliberation-v1, deep, no fan-out
    let cfg:DCfg=DCfg{.mode:1,.shallow_rounds:0,.deep_rounds:6,.amin:0,.amax:0,
        .conf_thr:0,.stab_win:0,.eps:0,.elim_margin:400,.refute_thr:650,.evcap:64};
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    it.hid=nio_alloc(16*8);it.eid=nio_alloc(64*8);
    it.evns=nio_alloc(64*4);it.evna=nio_alloc(64*4);
    it.sup=nio_alloc(64*16*8);it.att=nio_alloc(64*16*8);
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:8};
    st.scores=nio_alloc(16*8);st.alive=nio_alloc(16);
    st.hist_l=nio_alloc(8*4);st.hist_m=nio_alloc(8*8);
    if(it.hid.len==0 || st.scores.len==0){nio_free(ibuf);return 102;}
    let res:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&res,1048576)!=0){return 102;}
    if(dout_init(&lgo,4194304)!=0){return 102;}
    dout_str(&res,"#id\tforked\tverdict\texpected\tcorrect\tmargin\trounds\tconsumed\tt_consume\tt_elim\tledger_head\n");
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){return 102;}
    let ok:i32=1;
    let rc:i32=lg_step(&lg,&lgo,"-",0,"GENESIS","ob_baseline deep6 elim400 refute650");
    if(rc!=0){ok=0;}
    let pos:i32=0;let lineno:i32=0;let n:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        lineno=lineno+1;
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line[0]!=35){
            n=n+1;
            let prc:i32=ob_parse_problem(&it,line);
            if(prc!=0){ok=0;}
            if(prc==0){
                let drc:i32=dlb_run(&st,&it,&cfg,&lg,&lgo);
                if(drc!=0){ok=0;}
                if(drc==0){bl_emit(&res,&it,&st,&lg);}
                if(res.err!=0){ok=0;}
            }
        }
        pos=e+1;
    }
    let wrc:i64=0;
    if(ok==1 && res.err==0 && lgo.err==0){
        wrc=dlb_write_file(_zag_arg(2),dout_bytes(&res),res.n);
        if(wrc>=0){wrc=dlb_write_file(_zag_arg(3),dout_bytes(&lgo),lgo.n);}
    }
    nio_free(ibuf);
    nio_free(it.hid);nio_free(it.eid);nio_free(it.evns);nio_free(it.evna);
    nio_free(it.sup);nio_free(it.att);
    nio_free(st.scores);nio_free(st.alive);nio_free(st.hist_l);nio_free(st.hist_m);
    dout_free(&res);dout_free(&lgo);lg_free(&lg);
    let sum:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&sum,128)==0){
        dout_str(&sum,"baseline_items=");
        dout_i64(&sum,n as i64);
        dout_line(&sum);
        _zag_print(dout_bytes(&sum));
        dout_free(&sum);
    }
    if(ok==0 || wrc<0){return 103;}
    return 0;
}

// ob_poison.zag : K2 poison test: causal cross-talk through the shared ledger.
//
// For each test problem (forked, from the frozen set):
//   ref      : shared ledger, no poison
//   p-ev     : shared ledger, invalidate (pre-fanout) the evidence branch-1
//              consumed first in the reference run
//   p-hyp    : shared ledger, eliminate (pre-fanout) the reference verdict
//   abl-ref  : ablation, no poison
//   abl-p    : ablation, same evidence poison applied to branch-0's PRIVATE
//              copy only (N-independent-ledgers control)
// K2 passes iff the shared poison changes some branch's consumption or the
// joint eliminations/verdict (p-ev and p-hyp vs ref), AND the control shows
// poisoning one private ledger leaves the other branches' traces identical.
// Usage: ob_poison <problems.tsv> <poison_test.log>

@import("ob_problem.zag")
@import("onebrain.zag")

struct PZRec {
    verdict:i32, conf:i32, forked:i32, t_elim:i32, t_consume:i32,
    head:[]u8,               // 64 hex chars
    seq:[]u8,                // 3*16 i32 evidence indices
    seqn:[]u8,               // 3 i32
}

fn pz_run(it:*Item, st:*OBSt, mode:i32, pz:*OBPoison, r:*PZRec)i32 {
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){return -1;}
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo,1048576)!=0){lg_free(&lg);return -2;}
    let rc:i32=lg_step(&lg,&lgo,"-",0,"GENESIS","poison test");
    if(rc!=0){lg_free(&lg);dout_free(&lgo);return -3;}
    rc=ob_deliberate(it,st,&lg,&lgo,mode,pz);
    if(rc!=0){lg_free(&lg);dout_free(&lgo);return -4;}
    r.*.verdict=st.*.verdict;r.*.conf=st.*.conf;r.*.forked=st.*.forked;
    r.*.t_elim=st.*.t_elim;r.*.t_consume=st.*.t_consume;
    let hh:[]u8=lg_head_hex(&lg);
    let hb:[]u8=nio_alloc(64);
    if(hb.len==0){lg_free(&lg);dout_free(&lgo);return -5;}
    let i:i32=0;
    while(i<64){hb[i]=hh[i];i=i+1;}
    r.*.head=hb;
    let sq:[]u8=nio_alloc(3*16*4);let sn:[]u8=nio_alloc(3*4);
    if(sq.len==0){nio_free(hb);lg_free(&lg);dout_free(&lgo);return -6;}
    i=0;
    while(i<3*16*4){sq[i]=st.*.seq[i];i=i+1;}
    i=0;
    while(i<3*4){sn[i]=st.*.seq_n[i];i=i+1;}
    r.*.seq=sq;r.*.seqn=sn;
    lg_free(&lg);dout_free(&lgo);
    return 0;
}
fn pz_rec_free(r:*PZRec)void {
    nio_free(r.*.head);nio_free(r.*.seq);nio_free(r.*.seqn);
}
fn pz_emit_seq(o:*DOut, it:*Item, r:*PZRec, b:i32)void {
    dout_str(o,"b");
    dout_i64(o,b as i64);
    dout_str(o,"=[");
    let n:i32=au_get32(r.*.seqn,b);
    let s:[]u8=r.*.seq;
    let k:i32=0;
    while(k<n){
        if(k>0){dout_str(o,",");}
        let e:i32=au_get32(s,(b*16+k));
        dout_str(o,dj_eid(it,e));
        k=k+1;
    }
    dout_str(o,"]");
}
fn pz_emit_rec(o:*DOut, name:[]u8, it:*Item, r:*PZRec)void {
    dout_str(o,name);
    dout_str(o," verdict=");
    dout_str(o,dj_hid(it,r.*.verdict));
    dout_str(o," head=");
    dout_str(o,r.*.head);
    dout_str(o," t_elim=");
    dout_i64(o,r.*.t_elim as i64);
    dout_str(o," ");
    let b:i32=0;
    while(b<3){
        if(b>0){dout_str(o," ");}
        pz_emit_seq(o,it,r,b);
        b=b+1;
    }
    dout_line(o);
}
fn pz_seq_eq(a:*PZRec, b:*PZRec, br:i32)i32 {
    let na:i32=au_get32(a.*.seqn,br);let nb:i32=au_get32(b.*.seqn,br);
    if(na!=nb){return 0;}
    let k:i32=0;
    while(k<na){
        if(au_get32(a.*.seq,br*16+k)!=au_get32(b.*.seq,br*16+k)){return 0;}
        k=k+1;
    }
    return 1;
}
// find the TSV line whose id column equals want; returns slice (empty if none)
fn pz_find(buf:[]u8, blen:i32, want:[]u8)[]u8 {
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && buf[e]!=10){e=e+1;}
        let line:[]u8=buf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line[0]!=35){
            let tab:[]u8=nio_alloc(2*4);
            if(tab.len!=0){
                let c:i32=0;let f:i32=0;
                while(f<line.len && c==0){
                    if(line[f]==9){c=1;}
                    if(c==0){f=f+1;}
                }
                if(c==1){
                    let idf:[]u8=line[0..f];
                    if(dlb_streq(idf,want)==1){nio_free(tab);return line;}
                }
                nio_free(tab);
            }
        }
        pos=e+1;
    }
    let empty:[]u8="";
    return empty;
}

fn pz_case(o:*DOut, it:*Item, st:*OBSt, line:[]u8, pid:[]u8)i32 {
    let prc:i32=ob_parse_problem(it,line);
    if(prc!=0){return -1;}
    let r0:PZRec=PZRec{.verdict:-1,.conf:0,.forked:0,.t_elim:0,.t_consume:0,.head:"",.seq:"",.seqn:""};
    let r1:PZRec=PZRec{.verdict:-1,.conf:0,.forked:0,.t_elim:0,.t_consume:0,.head:"",.seq:"",.seqn:""};
    let r2:PZRec=PZRec{.verdict:-1,.conf:0,.forked:0,.t_elim:0,.t_consume:0,.head:"",.seq:"",.seqn:""};
    let ra:PZRec=PZRec{.verdict:-1,.conf:0,.forked:0,.t_elim:0,.t_consume:0,.head:"",.seq:"",.seqn:""};
    let rb:PZRec=PZRec{.verdict:-1,.conf:0,.forked:0,.t_elim:0,.t_consume:0,.head:"",.seq:"",.seqn:""};
    let pn:OBPoison=OBPoison{.at_round:-1,.kind:0,.target:-1,.branch:0};
    dout_str(o,"== problem ");
    dout_str(o,pid);
    dout_line(o);
    // ref: shared, no poison
    if(pz_run(it,st,0,&pn,&r0)!=0){return -2;}
    if(r0.forked==0){
        dout_str(o,"SKIP: no fork on ");
        dout_str(o,pid);
        dout_line(o);
        pz_rec_free(&r0);
        return 1;
    }
    pz_emit_rec(o,"ref(shared)  ",it,&r0);
    // poison 1: invalidate the evidence branch-1 consumed first in ref
    let tgt:i32=-1;
    if(au_get32(r0.seqn,1)>0){tgt=au_get32(r0.seq,1*16+0);}
    let p1:OBPoison=OBPoison{.at_round:-2,.kind:1,.target:tgt,.branch:0};
    if(pz_run(it,st,0,&p1,&r1)!=0){return -3;}
    dout_str(o,"poison target_ev=");
    dout_str(o,dj_eid(it,tgt));
    dout_line(o);
    pz_emit_rec(o,"p-ev(shared) ",it,&r1);
    // poison 2: eliminate the reference verdict hypothesis
    let p2:OBPoison=OBPoison{.at_round:-2,.kind:2,.target:r0.verdict,.branch:0};
    if(pz_run(it,st,0,&p2,&r2)!=0){return -4;}
    dout_str(o,"poison target_hyp=");
    dout_str(o,dj_hid(it,r0.verdict));
    dout_line(o);
    pz_emit_rec(o,"p-hyp(shared)",it,&r2);
    // ablation control
    if(pz_run(it,st,1,&pn,&ra)!=0){return -5;}
    pz_emit_rec(o,"ref(ablation)",it,&ra);
    let pa:OBPoison=OBPoison{.at_round:-2,.kind:1,.target:tgt,.branch:0};
    if(pz_run(it,st,1,&pa,&rb)!=0){return -6;}
    pz_emit_rec(o,"p-ev(abl b0) ",it,&rb);
    // ---- K2 evaluation ----
    // (a) shared evidence poison changed something observable
    let changed1:i32=0;
    if(r1.verdict!=r0.verdict){changed1=1;}
    if(r1.t_elim!=r0.t_elim){changed1=1;}
    let b:i32=0;
    while(b<3){
        if(pz_seq_eq(&r0,&r1,b)==0){changed1=1;}
        b=b+1;
    }
    // (b) shared hypothesis poison changed something observable
    let changed2:i32=0;
    if(r2.verdict!=r0.verdict){changed2=1;}
    if(r2.t_elim!=r0.t_elim){changed2=1;}
    b=0;
    while(b<3){
        if(pz_seq_eq(&r0,&r2,b)==0){changed2=1;}
        b=b+1;
    }
    // (c) control: poisoning branch-0's private copy leaves b1,b2 byte-identical
    let isolated:i32=1;
    if(pz_seq_eq(&ra,&rb,1)==0){isolated=0;}
    if(pz_seq_eq(&ra,&rb,2)==0){isolated=0;}
    dout_str(o,"K2-evidence-poison(causal): ");
    if(changed1==1){dout_str(o,"PASS");}
    if(changed1==0){dout_str(o,"FAIL");}
    dout_line(o);
    dout_str(o,"K2-hypothesis-poison(causal): ");
    if(changed2==1){dout_str(o,"PASS");}
    if(changed2==0){dout_str(o,"FAIL");}
    dout_line(o);
    dout_str(o,"K2-control(isolation): ");
    if(isolated==1){dout_str(o,"PASS");}
    if(isolated==0){dout_str(o,"FAIL");}
    dout_line(o);
    pz_rec_free(&r0);pz_rec_free(&r1);pz_rec_free(&r2);
    pz_rec_free(&ra);pz_rec_free(&rb);
    return 0;
}

fn main()i32 {
    if(_zag_argc()<3){
        _zag_println("usage: ob_poison <problems.tsv> <poison_test.log>");
        return 64;
    }
    let ibuf:[]u8=nio_alloc(1048576);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(_zag_arg(1),ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    it.hid=nio_alloc(16*8);it.eid=nio_alloc(64*8);
    it.evns=nio_alloc(64*4);it.evna=nio_alloc(64*4);
    it.sup=nio_alloc(64*16*8);it.att=nio_alloc(64*16*8);
    let st:OBSt=OBSt{.scores:"",.alive:"",.used:"",.valid:"",.consumed:0,.rounds:0,.forked:0,.verdict:-1,.conf:0,.b_scores:"",.b_alive:"",.b_used:"",.b_valid:"",.b_verdict:"",.seq:"",.seq_n:"",.t_consume:0,.t_elim:0,.t_xexam:0,.t_test:0};
    if(it.hid.len==0){nio_free(ibuf);return 102;}
    if(ob_alloc(&st)!=0){nio_free(ibuf);return 102;}
    let o:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&o,1048576)!=0){return 102;}
    dout_str(&o,"# Experiment 2 K2 poison test log\n");
    dout_str(&o,"# p-ev invalidates (pre-fanout) the shared evidence branch-1 took first in ref;\n");
    dout_str(&o,"# p-hyp eliminates (pre-fanout) the reference verdict hypothesis from the shared ledger.\n");
    let ids:[]u8="OB-01|OB-07";
    let ip:[]u8=nio_alloc(2*2*4);
    if(ip.len==0){return 102;}
    let nid:i32=ob_split(ids,124,ip,2);
    let di:i32=0;let ok:i32=1;
    while(di<nid && ok==1){
        let pid:[]u8=ob_field(ids,ip,di);
        let line:[]u8=pz_find(ibuf,blen,pid);
        if(line.len==0){ok=0;}
        if(line.len>0){
            let crc:i32=pz_case(&o,&it,&st,line,pid);
            if(crc<0){ok=0;}
        }
        di=di+1;
    }
    nio_free(ip);
    let wrc:i64=0;
    if(ok==1 && o.err==0){wrc=dlb_write_file(_zag_arg(2),dout_bytes(&o),o.n);}
    nio_free(ibuf);
    nio_free(it.hid);nio_free(it.eid);nio_free(it.evns);nio_free(it.evna);
    nio_free(it.sup);nio_free(it.att);
    ob_free(&st);
    let sum:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&sum,256)==0){
        if(ok==1){dout_str(&sum,"poison test complete");}
        if(ok==0){dout_str(&sum,"poison test FAILED");}
        dout_line(&sum);
        _zag_print(dout_bytes(&sum));
        dout_free(&sum);
    }
    dout_free(&o);
    if(ok==0 || wrc<0){return 103;}
    return 0;
}

// h3_atk.zag — H1EVO V2 R3' attack battery on the repaired arbiter.
// Prereg: ~/workspace/h1evo/PREREG_H1EVO.md (frozen before running).
// Pure Zag, zero RNG, 3x byte-identical.
// Assertions are shaped for the REPAIRED behavior (separate namespaces /
// dead-write deletion + PROPOSE ingress bounds check):
//   R3a': zero misrouting on cross-episode + same-episode + revoke variants
//   R3b': id 200/-1/129 -> bounded audited refusal, no panic; id 128 admits
//   R3c': 300-ep sweep no panic + zero divergence vs unique-key reference
// kill semantics: kb(...,1) = the REPAIR failed (misroute/panic/divergence).
@import("ob_common.zag")
@import("ob_tn.zag")
@import("ob_fl2.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")
@import("ob_arbiter.zag")

fn setup(pam:*[]u8,live:*[]u8,value:*[]u8,pinned:*[]u8,region:*[]u8,
    tier:*[]u8,step:*[]u8,maudit:*[]u8,mhdr:*[]u8,trust:*[]u8,
    ast:*[]u8,routes:*[]u8,alog:*[]u8,aln:*i32)i32 {
    pam.*=pam_new();
    live.*=mm_new_live();value.*=mm_new_value();pinned.*=mm_new_pinned();
    region.*=mm_new_region();tier.*=mm_new_tier();step.*=mm_new_step();
    maudit.*=mm_new_audit();mhdr.*=mm_new_hdr();trust.*=mm_new_trust();
    if(mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*)!=0){return -1;}
    if(mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*)!=0){return -1;}
    ast.*=arb_new_state();routes.*=arb_new_routes();
    alog.*=ob_alloc(ARB_ACAP*16);
    aln.*=0;
    return 0;
}

fn mkflog(flog:[]u8,cal:i32)void {
    let i:i32=0;
    while(i<cal){
        ob_s32(flog,i*16,100+i);ob_s32(flog,i*16+4,TN_OP_CALIBRATE);
        ob_s32(flog,i*16+8,0);ob_s32(flog,i*16+12,1);
        i=i+1;
    }
    return;
}

fn enq(q:[]u8,qn:*i32,mtype:i32,a1:i32,a2:i32)i32 {
    let n:i32=qn.*;
    ob_s32(q,n*16,0);
    ob_s32(q,n*16+4,mtype);ob_s32(q,n*16+8,a1);ob_s32(q,n*16+12,a2);
    qn.*=n+1;
    return 0;
}

fn acount(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code){c=c+1;}
        i=i+1;
    }
    return c;
}

fn acount2(alog:[]u8,n:i32,code:i32,a1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn acount3(alog:[]u8,n:i32,code:i32,a1:i32,a2:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1 && ob_g32(alog,i*16+12)==a2){c=c+1;}
        i=i+1;
    }
    return c;
}

// mem-audit count with (op,slot,rc)
fn mcount3(maudit:[]u8,mhdr:[]u8,op:i32,slot:i32,rc:i32)i32 {
    let n:i32=ob_g32(mhdr,8);
    let c:i32=0;let i:i32=0;
    while(i<n){
        let e:i32=i*MA_EW*4;
        if(ob_g32(maudit,e+4)==op && ob_g32(maudit,e+8)==slot && ob_g32(maudit,e+12)==rc){c=c+1;}
        i=i+1;
    }
    return c;
}

// most recent MA_OP_ADD slot (rc MA_OK) from the memory-organ audit.
// (The arbiter log's ARB_APPLIED(MA_OP_ADD) entry records the input slot
// -1, not the installed slot, so the mem audit is the faithful record.)
fn last_add_slot(maudit:[]u8,mhdr:[]u8)i32 {
    let n:i32=ob_g32(mhdr,8);
    let s:i32=-1;let i:i32=0;
    while(i<n){
        let e:i32=i*MA_EW*4;
        if(ob_g32(maudit,e+4)==MA_OP_ADD && ob_g32(maudit,e+12)==MA_OK){
            s=ob_g32(maudit,e+8);
        }
        i=i+1;
    }
    return s;
}

fn long_count(live:[]u8,region:[]u8)i32 {
    let c:i32=0;let i:i32=0;
    while(i<MA_CAP){
        if(live[i]!=0 && (region[i] as i32)==MA_REGION_LONG){c=c+1;}
        i=i+1;
    }
    return c;
}

fn kb(px:[]u8,fired:i32)void {
    _zag_print(px);_zag_print("_KILLBAR,");
    let s:[]u8=_zag_i64_to_str(fired as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return;
}

fn freebrain(pam:[]u8,live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,
    step:[]u8,maudit:[]u8,mhdr:[]u8,trust:[]u8,ast:[]u8,routes:[]u8,alog:[]u8)void {
    ob_free(pam);ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);
    return;
}

// R3a' leg 1: cross-episode. ep0 PROPOSE(11,0) -> S0; ep129 COMMIT(1,22)
// must NOT clobber routes[0]; PROMOTE(11) must promote S0 (P's provisional),
// exactly one LONG slot, Q's survivor stays USER-live (pinned).
fn h3a_xep()i32 {
    let f:i32=0;
    let px:[]u8="h3a_xep_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,0);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s0:i32=ob_g32(routes,0);
    f=f+ob_check(px,"ep0_s0",s0>=0,1);
    f=f+ob_check(px,"ep0_ast",ob_g32(ast,0),0);
    let ep:i32=1;
    while(ep<129){
        qn=0;
        arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,0,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        ep=ep+1;
    }
    // ep129: commit Q -> must NOT touch the claim region slot 0
    mkflog(flog,4);qn=0;enq(q,&qn,M_COMMIT,1,22);
    arb_process(129,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s1:i32=last_add_slot(maudit,mhdr);
    f=f+ob_check(px,"ep129_commit_ok",s1>=0,1);
    f=f+ob_check(px,"no_clobber",ob_g32(routes,0),s0);
    f=f+ob_check(px,"s0_still_live",live[s0],1);
    // PROMOTE(11): the INTENDED survivor S0 is promoted; exactly one LONG.
    qn=0;enq(q,&qn,M_PROMOTE,11,0);
    arb_process(129,q,&qn,ast,routes,alog,&aln,pam,flog,0,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+ob_check(px,"right_promoted",mcount3(maudit,mhdr,MA_OP_PROMOTE,s0,MA_OK),1);
    f=f+ob_check(px,"s0_long",(region[s0] as i32),MA_REGION_LONG);
    f=f+ob_check(px,"one_long",long_count(live,region),1);
    f=f+ob_check(px,"s1_user_live",live[s1],1);
    f=f+ob_check(px,"s1_not_long",(region[s1] as i32),MA_REGION_USER);
    let kill:i32=(((region[s0] as i32)!=MA_REGION_LONG) || long_count(live,region)!=1) as i32;
    kb(px,kill);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog);
    ob_free(flog);ob_free(q);
    return f;
}

// R3a' leg 2: same-episode variant (ep5, claim 5).
fn h3a_sameep()i32 {
    let f:i32=0;
    let px:[]u8="h3a_same_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;
    // propose alone first, so the pre-commit route value is captured
    enq(q,&qn,M_PROPOSE_INSTALL,11,5);
    arb_process(5,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s0pre:i32=ob_g32(routes,5*4);
    f=f+ob_check(px,"propose_ok",s0pre>=0,1);
    // same-episode commit: must NOT clobber the claim region slot 5
    qn=0;enq(q,&qn,M_COMMIT,1,22);
    arb_process(5,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+ob_check(px,"no_clobber",ob_g32(routes,5*4),s0pre);
    // promote: the INTENDED survivor S0 is promoted; exactly one LONG.
    qn=0;enq(q,&qn,M_PROMOTE,11,0);
    arb_process(5,q,&qn,ast,routes,alog,&aln,pam,flog,0,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    // claim region slot 5 still holds the propose survivor; it was promoted.
    let s0:i32=ob_g32(routes,5*4);
    f=f+ob_check(px,"route5_intact",s0>=0,1);
    f=f+ob_check(px,"route5_unchanged",s0,s0pre);
    f=f+ob_check(px,"right_promoted",mcount3(maudit,mhdr,MA_OP_PROMOTE,s0pre,MA_OK),1);
    f=f+ob_check(px,"s0_long",(region[s0pre] as i32),MA_REGION_LONG);
    f=f+ob_check(px,"one_long",long_count(live,region),1);
    let kill:i32=((s0!=s0pre) || ((region[s0pre] as i32)!=MA_REGION_LONG) || long_count(live,region)!=1) as i32;
    kb(px,kill);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog);
    ob_free(flog);ob_free(q);
    return f;
}

// R3a' leg 3: REVOKE variant — the revoke aimed at policy 11's provisional
// must kill S0 (the intended target), leave Q's survivor pinned and live,
// and clear the route.
fn h3a_revoke()i32 {
    let f:i32=0;
    let px:[]u8="h3a_rev_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,0);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s0:i32=ob_g32(routes,0);
    mkflog(flog,4);qn=0;enq(q,&qn,M_COMMIT,1,22);
    arb_process(129,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s1:i32=last_add_slot(maudit,mhdr);
    f=f+ob_check(px,"no_clobber",ob_g32(routes,0),s0);
    f=f+ob_check(px,"s1_pinned",pinned[s1],MA_PIN_LEARNER);
    qn=0;enq(q,&qn,M_REVOKE,11,0);
    arb_process(129,q,&qn,ast,routes,alog,&aln,pam,flog,0,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    // the kill landed on the INTENDED target S0 and succeeded.
    f=f+ob_check(px,"kill_on_right_slot",mcount3(maudit,mhdr,MA_OP_KILL,s0,MA_OK),1);
    f=f+ob_check(px,"s0_dead",live[s0],0);
    f=f+ob_check(px,"s1_survives",live[s1],1);
    f=f+ob_check(px,"route_cleared",ob_g32(routes,0),-1);
    let kill:i32=((mcount3(maudit,mhdr,MA_OP_KILL,s0,MA_OK)!=1) || live[s1]!=1) as i32;
    kb(px,kill);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog);
    ob_free(flog);ob_free(q);
    return f;
}

// R3b': out-of-range claim ids are bounded, audited refusals (no panic);
// the boundary id 128 still admits.
fn h3b_refusal()i32 {
    let f:i32=0;
    let px:[]u8="h3b_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    let n0:i32=pam_n(pam);
    // id 200: refused, ledgered, no state touched, no PAM row burned
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,200);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+ob_check(px,"refuse200_ledgered",acount3(alog,aln,ARB_DROP,M_PROPOSE_INSTALL,200),1);
    f=f+ob_check(px,"refuse200_ast",ob_g32(ast,0),-1);
    // id -1: refused
    qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,-1);
    arb_process(1,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+ob_check(px,"refuseneg1_ledgered",acount3(alog,aln,ARB_DROP,M_PROPOSE_INSTALL,-1),1);
    // id 129 (=ARB_ROUTES): refused (upper bound is exclusive)
    qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,129);
    arb_process(2,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+ob_check(px,"refuse129_ledgered",acount3(alog,aln,ARB_DROP,M_PROPOSE_INSTALL,129),1);
    f=f+ob_check(px,"no_pam_rows_burned",pam_n(pam),n0);
    f=f+ob_check(px,"route128_untouched",ob_g32(routes,128*4),-1);
    // id 128: the boundary — must still ADMIT (no overcorrection)
    qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,128);
    arb_process(3,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+ob_check(px,"admit128_verdict",acount2(alog,aln,M_PAM_VERDICT,PAM_ADMIT),1);
    f=f+ob_check(px,"admit128_route",ob_g32(routes,128*4)>=0,1);
    f=f+ob_check(px,"admit128_ast",ob_g32(ast,0),128);
    let kill:i32=((acount3(alog,aln,ARB_DROP,M_PROPOSE_INSTALL,200)!=1) ||
        (acount3(alog,aln,ARB_DROP,M_PROPOSE_INSTALL,-1)!=1) ||
        (acount3(alog,aln,ARB_DROP,M_PROPOSE_INSTALL,129)!=1) ||
        (ob_g32(routes,128*4)<0)) as i32;
    kb(px,kill);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog);
    ob_free(flog);ob_free(q);
    return f;
}

// R3c' leg 1: 300-episode COMMIT sweep — no panic, same admit/backpressure
// profile as V0 (M_COMMIT admission unchanged: R1b regression).
fn h3c_nopanic()i32 {
    let f:i32=0;
    let px:[]u8="h3c_np_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    let ep:i32=0;
    while(ep<300){
        mkflog(flog,4);qn=0;enq(q,&qn,M_COMMIT,1,30+(ep%5));
        arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,4,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        ep=ep+1;
    }
    // PAM_CAP=64 rows: 64 installs, 236 ARB_DROPs (backpressure, not failure)
    f=f+ob_check(px,"installs",acount(alog,aln,M_PAM_VERDICT)-acount2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD),64);
    f=f+ob_check(px,"drops",acount2(alog,aln,ARB_DROP,M_COMMIT),236);
    f=f+ob_check(px,"completed_300",ep,300);
    kb(px,0);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog);
    ob_free(flog);ob_free(q);
    return f;
}

// R3c' leg 2: zero divergence vs the separate-namespace (unique-key)
// reference on forced collisions: 16 iters x (propose, commit, promote,
// revoke); compare shipped vs reference target after every revoke/promote.
fn h3c_equiv()i32 {
    let f:i32=0;
    let px:[]u8="h3c_eq_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    // separate-namespace reference: claim-id table only (commit ring separate,
    // never consulted by revoke/promote)
    let refc:[]u8=ob_alloc(ARB_ROUTES*4);
    let ri:i32=0;
    while(ri<ARB_ROUTES){ob_s32(refc,ri*4,-1);ri=ri+1;}
    let diverges:i32=0;let agrees:i32=0;
    let k:i32=0;
    while(k<16){
        let base:i32=4*k;
        // even k: claim == commit ring slot (forced collision under V0);
        // odd k: claim offset by 64 (no collision). Both must agree now.
        let claim:i32=((base+1)%ARB_ROUTES+((k%2)*64))%ARB_ROUTES;
        // ep 4k: PROPOSE(11, claim)
        mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,claim);
        arb_process(base,q,&qn,ast,routes,alog,&aln,pam,flog,4,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        ob_s32(refc,claim*4,ob_g32(routes,claim*4));
        // ep 4k+1: COMMIT(1,22)
        mkflog(flog,4);qn=0;enq(q,&qn,M_COMMIT,1,22);
        arb_process(base+1,q,&qn,ast,routes,alog,&aln,pam,flog,4,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        // ep 4k+2: compare shipped vs reference promote target
        let pc0:i32=ob_g32(ast,0);
        if(pc0>=0){
            let ship0:i32=ob_g32(routes,pc0*4);
            let ref0:i32=ob_g32(refc,pc0*4);
            if(ship0!=ref0){diverges=diverges+1;}
            else{if(ship0>=0){agrees=agrees+1;}}
        }
        qn=0;enq(q,&qn,M_PROMOTE,11,0);
        arb_process(base+2,q,&qn,ast,routes,alog,&aln,pam,flog,0,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        // ep 4k+3: compare shipped vs reference revoke target, then mirror
        let pc1:i32=ob_g32(ast,0);
        if(pc1>=0){
            let ship1:i32=ob_g32(routes,pc1*4);
            let ref1:i32=ob_g32(refc,pc1*4);
            if(ship1!=ref1){diverges=diverges+1;}
            else{if(ship1>=0){agrees=agrees+1;}}
        }
        qn=0;enq(q,&qn,M_REVOKE,11,0);
        arb_process(base+3,q,&qn,ast,routes,alog,&aln,pam,flog,0,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        if(pc1>=0 && ob_g32(routes,pc1*4)<0){ob_s32(refc,pc1*4,-1);}
        k=k+1;
    }
    f=f+ob_check(px,"diverges",diverges,0);
    f=f+ob_check(px,"agrees",agrees,32);
    // kill bar: ANY divergence from the unique-key reference kills the repair.
    kb(px,(diverges!=0) as i32);
    ob_free(refc);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog);
    ob_free(flog);ob_free(q);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+h3a_xep();
    f=f+h3a_sameep();
    f=f+h3a_revoke();
    f=f+h3b_refusal();
    f=f+h3c_nopanic();
    f=f+h3c_equiv();
    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

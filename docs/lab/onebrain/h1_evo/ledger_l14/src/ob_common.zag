// ob_common.zag — ONE-BRAIN variant B shared constants and byte helpers.
//
// Variant B: organs keep LOCAL state and communicate by MESSAGES
// (deliberately different from variant A's shared ledger — the
// architectural fork under test for H1).
//
// Message envelope: 16-byte records = {seq, mtype, arg1, arg2}.
//   seq is ARBITER-ASSIGNED AT RECEIPT: (episode<<16)|arrival_index.
//   Organ-supplied order bits are untrusted input, ignored for dispatch
//   (P5, closed 2026-09-24). Dispatch is FIFO by arrival index.
// The arbiter orders messages per the precedence rules in OB_PROTOCOL.md
// (P0..P5; P1 retired 2026-09-24, P1-alt/FIFO is the dispatch), each
// documented there as a hypothesis with its alternative.
//
// Pure Zag. Zero RNG. Byte-identical reruns required.

// ---- organ ids ----
const ORG_ARBITER:i32=0;
const ORG_FL2:i32=1;
const ORG_PAM:i32=2;
const ORG_MEM:i32=3;

// ---- message types (M_*, >= 100; never collide with TN_OP/MA_OP codes) ----
const M_DISCONNECT:i32=101;     // FL2 learner-initiated SIGNAL_DISCONNECT
const M_PROPOSE_INSTALL:i32=102;// FL2 provisional-install intent {arg1=policy, arg2=claim_slot}
const M_REVOKE:i32=103;         // FL2 revoke provisional {arg1=revoked policy, arg2=survivor}
const M_COMMIT:i32=104;         // FL2 commit survivor {arg1=1, arg2=survivor policy}
const M_PROMOTE:i32=105;        // FL2 promote provisional {arg1=policy}
const M_ADMIT_REQ:i32=106;      // arbiter -> PAM: gate this claim {arg1=claim slot, arg2=policy}
const M_PAM_VERDICT:i32=107;    // PAM -> arbiter {arg1=verdict, arg2=reason}
const M_MEM_OP:i32=108;         // arbiter -> MEM deliberate-memory op {arg1=ma op, arg2=slot}
const M_MEM_RESULT:i32=109;     // MEM -> arbiter {arg1=rc, arg2=slot}
const M_MEM_SAFETY:i32=110;     // MEM organ's own deliberate op announcement {arg1=ma op, arg2=slot}
const M_FORCE_PIN:i32=111;      // external overseer force-pin {arg1=slot} (P0: beats everything)

// ---- PAM verdicts (from PAMs v2, M5 trichotomy mapped to binary routing) ----
const PAM_WITHHOLD:i32=0;
const PAM_ADMIT:i32=1;
// verdict reasons (frozen):
const PAM_R_OK:i32=0;           // admitted
const PAM_R_OVERLAP:i32=1;      // M1: gate span overlaps formation span
const PAM_R_DISAGREE:i32=2;     // M3: jf != jg (fooled front)
const PAM_R_LOWCONF:i32=3;      // M3: conf < 700 on either side
const PAM_R_DEPENDENT:i32=4;    // M3: gate source not informationally independent
const PAM_R_NOTFRAGILE:i32=5;   // M4: interventions did not flip/shift >=3sigma
const PAM_R_UNCORROBORATED:i32=6;// M9/cf1: bars pass but no corroborating prior
const PAM_R_CONFTOL:i32=7;      // corroborator outside conf tolerance

// ---- memory organ constants live in ob_mem.zag (frozen from wave3
// memory_core.zag); message envelope + PAM reasons live here. ----

// ---- byte helpers (tn-style arenas; avoid []i32 casts per ZNC-2026-09-21-007) ----
fn ob_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn ob_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn ob_g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn ob_s32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}

fn ob_copy(dst:[]u8,src:[]u8,n:i32)void {
    let i:i32=0;
    while(i<n){dst[i]=src[i];i=i+1;}
    return;
}

// message queue: 16-byte entries {seq, mtype, arg1, arg2}; cap slots.
// L4': the tail LANE_N slots of the queue are a GOVERNANCE LANE reserved
// for M_FORCE_PIN (the overseer's lock). Ordinary messages may only occupy
// [0, cap-LANE_N); the lane is drained first each episode (see arb_process).
// Total capacity is unchanged (triage, not a new cap): under junk flood the
// genuine force-pin always lands. A message is "present" iff its mtype word
// is nonzero; arb_process clears mtype words on drain (seq words are kept
// for the P5 re-stamp proof).
const LANE_N:i32=4;
fn ob_lane_base(cap:i32)i32 {
    let lb:i32=cap-LANE_N;
    if(lb<0){lb=0;}
    return lb;
}
// count occupied lane slots
fn ob_lane_n(q:[]u8,cap:i32)i32 {
    let lb:i32=ob_lane_base(cap);
    let c:i32=0;let k:i32=lb;
    while(k<cap){if(ob_g32(q,k*16+4)!=0){c=c+1;}k=k+1;}
    return c;
}

fn ob_msgq_init(cap:i32)[]u8 {
    return ob_alloc(cap*16);
}

fn ob_msg_enqueue(q:[]u8,qn:*i32,cap:i32,ep:i32,ord:i32,mtype:i32,a1:i32,a2:i32)i32 {
    let n:i32=qn.*;
    if(n<0){return -1;}
    if(mtype==M_FORCE_PIN){
        // governance lane: first free lane slot; never competes with junk.
        let lb:i32=ob_lane_base(cap);
        let k:i32=lb;
        while(k<cap){
            if(ob_g32(q,k*16+4)==0){
                ob_s32(q,k*16,(ep<<16)|ord);
                ob_s32(q,k*16+4,mtype);
                ob_s32(q,k*16+8,a1);
                ob_s32(q,k*16+12,a2);
                qn.*=n+1;
                return 0;
            }
            k=k+1;
        }
        return -1;
    }
    // ordinary: the region [0, cap-LANE_N) is dense, so the first free slot
    // is (total - lane-occupied). Junk can never take lane slots.
    let lb:i32=ob_lane_base(cap);
    let on:i32=n-ob_lane_n(q,cap);
    if(on<0 || on>=lb){return -1;}
    ob_s32(q,on*16,(ep<<16)|ord);
    ob_s32(q,on*16+4,mtype);
    ob_s32(q,on*16+8,a1);
    ob_s32(q,on*16+12,a2);
    qn.*=n+1;
    return 0;
}

fn ob_msg_count_type(q:[]u8,n:i32,mtype:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(ob_g32(q,i*16+4)==mtype){c=c+1;}i=i+1;}
    return c;
}

// check printer: OB_CHECK,<prefix><name>,<actual>,<expected>
fn ob_check(px:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("OB_CHECK,");_zag_print(px);_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);ob_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);ob_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

// (byte-identity evidence is produced by the runner: two full runs,
// sha256 of stdout compared. No in-binary digest needed.)

// ob_test_mem.zag — unit test: the memory organ standalone.
//
// Exercises add/kill/pin/unpin/promote/demote, staged gates, signed
// values (+ and -), clamp behavior, rollback, replay-to-exact-state
// (across an interleaved rollback), CORE refusal, force-pin law (learner
// ops refuse it; external pin/unpin own it), clean-refusal semantics,
// and audit parity (successes + refusals audited).
// Frozen expected values are asserted throughout; the runner diffs two
// runs for byte identity.
@import("ob_common.zag")
@import("ob_mem.zag")

fn mmnew(live:*[]u8,value:*[]u8,pinned:*[]u8,region:*[]u8,tier:*[]u8,
    step:*[]u8,audit:*[]u8,hdr:*[]u8,trust:*[]u8)i32 {
    live.*=mm_new_live();value.*=mm_new_value();pinned.*=mm_new_pinned();
    region.*=mm_new_region();tier.*=mm_new_tier();step.*=mm_new_step();
    audit.*=mm_new_audit();hdr.*=mm_new_hdr();trust.*=mm_new_trust();
    return 0;
}

fn main()i32 {
    let f:i32=0;
    let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);
    let tier:[]u8=ob_alloc(0);let step:[]u8=ob_alloc(0);
    let audit:[]u8=ob_alloc(0);let hdr:[]u8=ob_alloc(0);let trust:[]u8=ob_alloc(0);
    mmnew(&live,&value,&pinned,&region,&tier,&step,&audit,&hdr,&trust);
    let s1:[]u8=ob_alloc(MA_CAP*4);let s2:[]u8=ob_alloc(MA_CAP*4);let s3:[]u8=ob_alloc(MA_CAP*4);
    let px:[]u8="obm_";
    // 1. staged gates: fresh stage is NONE; add refused before FULL
    let s0:i32=-1;
    f=f+ob_check(px,"stage0",mm_stage(hdr),MA_STAGE_NONE);
    f=f+ob_check(px,"add_refused_stage",mm_add(live,value,pinned,region,tier,step,audit,hdr,100,MA_REGION_USER,&s0),MA_REFUSED_STAGE);
    f=f+ob_check(px,"advance1",mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr),0);
    f=f+ob_check(px,"stage1",mm_stage(hdr),MA_STAGE_PIN);
    f=f+ob_check(px,"add_still_refused",mm_add(live,value,pinned,region,tier,step,audit,hdr,100,MA_REGION_USER,&s0),MA_REFUSED_STAGE);
    f=f+ob_check(px,"advance2",mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr),0);
    f=f+ob_check(px,"stage2",mm_stage(hdr),MA_STAGE_FULL);
    f=f+ob_check(px,"advance3_refused",mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr),-1);
    // 2. signed values: + and - (MA4: trust[f]/64, may be negative)
    let vpos:i32=mm_declare_value(trust,64,150,1);
    let vneg:i32=mm_declare_value(trust,65,200,0);
    f=f+ob_check(px,"vpos",vpos,3);
    f=f+ob_check(px,"vneg",vneg,-2);
    f=f+ob_check(px,"trust_pos",mm_trust_of(trust,64),214);
    f=f+ob_check(px,"trust_neg",mm_trust_of(trust,65),-136);
    mm_declare_value(trust,67,300,1);
    f=f+ob_check(px,"clamp_pos",mm_trust_of(trust,67),256);
    mm_declare_value(trust,68,300,0);
    mm_declare_value(trust,68,300,0);
    f=f+ob_check(px,"clamp_neg",mm_trust_of(trust,68),-256);
    // add the declared values; slots are organ-allocated (1,2,3 after CORE 0)
    let spos:i32=-1;let sneg:i32=-1;let sfp:i32=-1;
    f=f+ob_check(px,"add_pos",mm_add(live,value,pinned,region,tier,step,audit,hdr,vpos,MA_REGION_USER,&spos),MA_OK);
    f=f+ob_check(px,"spos",spos,1);
    f=f+ob_check(px,"add_neg",mm_add(live,value,pinned,region,tier,step,audit,hdr,vneg,MA_REGION_USER,&sneg),MA_OK);
    f=f+ob_check(px,"sneg",sneg,2);
    let vfp:i32=mm_declare_value(trust,66,10,1);
    f=f+ob_check(px,"add_fp",mm_add(live,value,pinned,region,tier,step,audit,hdr,vfp,MA_REGION_USER,&sfp),MA_OK);
    f=f+ob_check(px,"sfp",sfp,3);
    f=f+ob_check(px,"vpos_stored",mm_value_of(value,spos),3);
    f=f+ob_check(px,"vneg_stored",mm_value_of(value,sneg),-2);
    // 3. force-pin law: learner kill/unpin refused; external owns it
    f=f+ob_check(px,"force_pin",mm_force_pin(live,value,pinned,region,tier,step,audit,hdr,sfp),MA_OK);
    f=f+ob_check(px,"fp_flag",pinned[sfp],MA_PIN_FORCE);
    f=f+ob_check(px,"fp_kill_refused",mm_kill(live,value,pinned,region,tier,step,audit,hdr,sfp),MA_REFUSED_PINNED);
    f=f+ob_check(px,"fp_unpin_refused",mm_unpin(live,value,pinned,region,tier,step,audit,hdr,sfp),MA_REFUSED_PINNED);
    f=f+ob_check(px,"ext_unpin",mm_external_unpin(live,value,pinned,region,tier,step,audit,hdr,sfp),MA_OK);
    f=f+ob_check(px,"after_ext_unpin",pinned[sfp],0);
    f=f+ob_check(px,"re_force_pin",mm_force_pin(live,value,pinned,region,tier,step,audit,hdr,sfp),MA_OK);
    f=f+ob_check(px,"learner_pin_refused",mm_pin(live,value,pinned,region,tier,step,audit,hdr,sfp),MA_REFUSED_PINNED);
    // 4. pin gating + kill + unpin + promote + demote
    f=f+ob_check(px,"pin_pos",mm_pin(live,value,pinned,region,tier,step,audit,hdr,spos),MA_OK);
    f=f+ob_check(px,"pinned_flag",pinned[spos],MA_PIN_LEARNER);
    f=f+ob_check(px,"kill_pinned_refused",mm_kill(live,value,pinned,region,tier,step,audit,hdr,spos),MA_REFUSED_PINNED);
    f=f+ob_check(px,"unpin",mm_unpin(live,value,pinned,region,tier,step,audit,hdr,spos),MA_OK);
    f=f+ob_check(px,"kill",mm_kill(live,value,pinned,region,tier,step,audit,hdr,spos),MA_OK);
    f=f+ob_check(px,"killed_dead",live[spos],0);
    f=f+ob_check(px,"promote_neg",mm_promote(live,value,pinned,region,tier,step,audit,hdr,sneg),MA_OK);
    f=f+ob_check(px,"neg_long",region[sneg],MA_REGION_LONG);
    f=f+ob_check(px,"demote_neg",mm_demote(live,value,pinned,region,tier,step,audit,hdr,sneg),MA_OK);
    f=f+ob_check(px,"neg_user",region[sneg],MA_REGION_USER);
    // 5. CORE refusal: slot 0 can never die
    f=f+ob_check(px,"kill_core_refused",mm_kill(live,value,pinned,region,tier,step,audit,hdr,0),MA_REFUSED_CORE);
    f=f+ob_check(px,"pin_core_ok",mm_pin(live,value,pinned,region,tier,step,audit,hdr,0),MA_OK);
    f=f+ob_check(px,"kill_core_pinned",mm_kill(live,value,pinned,region,tier,step,audit,hdr,0),MA_REFUSED_CORE);
    f=f+ob_check(px,"core_live",live[0],1);
    // 6. checkpoint / rollback (audit stays append-only)
    let n_before:i32=ob_g32(hdr,8);
    mm_checkpoint(live,value,pinned,region,tier,step,audit,hdr,s1,s2,s3);
    f=f+ob_check(px,"kill_vneg",mm_kill(live,value,pinned,region,tier,step,audit,hdr,sneg),MA_OK);
    f=f+ob_check(px,"vneg_dead",live[sneg],0);
    mm_rollback(live,value,pinned,region,tier,step,audit,hdr,s1,s2,s3);
    f=f+ob_check(px,"rollback_live",live[sneg],1);
    f=f+ob_check(px,"rollback_region",region[sneg],MA_REGION_USER);
    f=f+ob_check(px,"rollback_fp_force",pinned[sfp],MA_PIN_FORCE);
    f=f+ob_check(px,"rollback_core_pinned",pinned[0],MA_PIN_LEARNER);
    f=f+ob_check(px,"audit_kept",ob_g32(hdr,8)>n_before,1);
    // 7. replay to exact state across the interleaved rollback
    let r:i32=mm_replay(live,value,pinned,region,tier,step,audit,hdr);
    f=f+ob_check(px,"replay_rc",r,MA_OK);
    f=f+ob_check(px,"replay_vneg_live",live[sneg],1);
    f=f+ob_check(px,"replay_vpos_dead",live[spos],0);
    f=f+ob_check(px,"replay_fp_force",pinned[sfp],MA_PIN_FORCE);
    f=f+ob_check(px,"replay_core_pinned",pinned[0],MA_PIN_LEARNER);
    f=f+ob_check(px,"replay_neg_region",region[sneg],MA_REGION_USER);
    f=f+ob_check(px,"replay_vpos_val",mm_value_of(value,spos),3);
    f=f+ob_check(px,"replay_vneg_val",mm_value_of(value,sneg),-2);
    f=f+ob_check(px,"replay_core_live",live[0],1);
    f=f+ob_check(px,"replay_core_tier",tier[0],MA_TIER_CORE);
    // 8. clean refusal check on a quiesced organ
    let live2:[]u8=ob_alloc(0);let value2:[]u8=ob_alloc(0);
    let pinned2:[]u8=ob_alloc(0);let region2:[]u8=ob_alloc(0);
    let tier2:[]u8=ob_alloc(0);let step2:[]u8=ob_alloc(0);
    let audit2:[]u8=ob_alloc(0);let hdr2:[]u8=ob_alloc(0);let trust2:[]u8=ob_alloc(0);
    mmnew(&live2,&value2,&pinned2,&region2,&tier2,&step2,&audit2,&hdr2,&trust2);
    f=f+ob_check(px,"clean",mm_check_clean_refusals(audit2,hdr2),1);
    mm_advance_stage(live2,value2,pinned2,region2,tier2,step2,audit2,hdr2);
    mm_advance_stage(live2,value2,pinned2,region2,tier2,step2,audit2,hdr2);
    let s9:i32=-1;
    let vv:i32=mm_declare_value(trust2,64,150,1);
    mm_add(live2,value2,pinned2,region2,tier2,step2,audit2,hdr2,vv,MA_REGION_USER,&s9);
    f=f+ob_check(px,"add_slot",s9,1);
    f=f+ob_check(px,"clean_after_add",mm_check_clean_refusals(audit2,hdr2),0);
    // 9. audit parity: successes + refusals both audited
    let audit_n:i32=ob_g32(hdr,8);
    _zag_print("OB_INFO,");_zag_print(px);_zag_print("audit_total,");
    let ai:[]u8=_zag_i64_to_str(audit_n as i64);_zag_print(ai);ob_free(ai);
    _zag_println("");
    f=f+ob_check(px,"audit_grew",audit_n>0,1);
    let rc_n:i32=0;let ok_n:i32=0;let i:i32=0;
    while(i<audit_n){
        let rc:i32=ob_g32(audit,i*48+12);
        if(rc!=MA_OK){rc_n=rc_n+1;}else{ok_n=ok_n+1;}
        i=i+1;
    }
    f=f+ob_check(px,"audit_has_refusals",rc_n>0,1);
    f=f+ob_check(px,"audit_has_successes",ok_n>0,1);
    f=f+ob_check(px,"audit_refusal_n",rc_n,8);
    ob_free(s1);ob_free(s2);ob_free(s3);
    ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(audit);ob_free(hdr);ob_free(trust);
    ob_free(live2);ob_free(value2);ob_free(pinned2);ob_free(region2);
    ob_free(tier2);ob_free(step2);ob_free(audit2);ob_free(hdr2);ob_free(trust2);
    _zag_print("OB_FAILURES,");
    let t:[]u8=_zag_i64_to_str(f as i64);_zag_print(t);ob_free(t);
    _zag_println("");
    return (f!=0) as i32;
}

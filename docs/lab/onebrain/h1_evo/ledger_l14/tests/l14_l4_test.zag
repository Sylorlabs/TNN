// L4' — governance triage under flood (priority + reservation, not new caps).
//
// L4a': 10,000 junk M_DISCONNECT, drained in batches. All processed; the
//        arbiter audit caps ORDINARY entries at ARB_ACAP-ARB_GOV_RES = 960,
//        keeping 64 slots reserved for governance. (Expectation change vs
//        the old attack's 1024/8976: the reservation IS the repair.)
// L4b': ordinary region full (252 junk) + genuine M_FORCE_PIN -> pin lands
//        in the governance lane (rc 0), is APPLIED, is AUDITED, and drains
//        FIRST (its audit entry precedes all junk entries).
// L4c': the old kill, now dead: junk cannot take lane slots (253rd junk
//        -> -1); the pin still lands, applies, audits.
// L4c2': lane-full boundary: 4 pins ok, 5th pin -> -1 (physical boundary).
// L4d': PAM observations: 56 ordinary junk ok, 57th ordinary -> -1; the
//        genuine governance observation lands via pam_observe_gov (slot 56);
//        8 gov rows fill to 64; 9th gov -> -1.
// L4e': 301 verdicts (alternating 2 slots, ep 200/201): every call returns
//        rc 0 (zero unlogged ADMITs); ledger_n stays 256 (ring); evicted =
//        45; the ring holds verdicts #45..#300 in order.
// L4f': audit reservation boundary: 960 ordinary audits ok, 961st -> -1;
//        64 governance audits ok (aln 1024); 65th gov -> -1 AND the explicit
//        overflow counter reads 1 (never silent).
//
// KILL: any dropped or unlogged governance message.
@import("../src/ob_common.zag")
@import("../src/ob_arbiter.zag")
@import("../src/ob_pam.zag")
@import("../src/ob_mem.zag")

fn l4_emit(tag:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print(tag);_zag_print(",");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);ob_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);ob_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}
fn l4_alog_count(alog:[]u8,aln:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<aln){if(ob_g32(alog,i*16+4)==code){c=c+1;}i=i+1;}
    return c;
}
// first audit index with a given code, or -1
fn l4_alog_first(alog:[]u8,aln:i32,code:i32)i32 {
    let i:i32=0;
    while(i<aln){if(ob_g32(alog,i*16+4)==code){return i;}i=i+1;}
    return -1;
}
fn l4_organ_ready(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8)i32 {
    if(mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr)!=0){return 1;}
    if(mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr)!=0){return 2;}
    let sl:i32=0;let k:i32=0;
    while(k<7){
        if(mm_add(live,value,pinned,region,tier,step,audit,hdr,100+k,0,&sl)!=0){return 3;}
        k=k+1;
    }
    if(sl!=7){return 4;}
    return 0;
}

fn main()i32 {
    let f:i32=0;
    // ---------------- L4a': 10,000 junk ----------------
    let aq:[]u8=ob_msgq_init(ARB_QCAP);let aqn:i32=0;
    let aast:[]u8=arb_new_state();let aroutes:[]u8=arb_new_routes();
    let aalog:[]u8=ob_alloc(ARB_ACAP*16);let aaln:i32=0;
    let apam:[]u8=pam_new();let afl2:[]u8=ob_alloc(16);
    let alive:[]u8=mm_new_live();let avalue:[]u8=mm_new_value();
    let apinned:[]u8=mm_new_pinned();let aregion:[]u8=mm_new_region();
    let atier:[]u8=mm_new_tier();let astep:[]u8=mm_new_step();
    let amaudit:[]u8=mm_new_audit();let ahdr:[]u8=mm_new_hdr();
    let atrust:[]u8=mm_new_trust();
    let sent:i32=0;let proctot:i32=0;
    while(sent<10000){
        let arc:i32=ob_msg_enqueue(aq,&aqn,ARB_QCAP,1,sent,M_DISCONNECT,0,0);
        if(arc!=0){
            proctot=proctot+aqn;
            arb_process(1,aq,&aqn,aast,aroutes,aalog,&aaln,apam,afl2,0,
                alive,avalue,apinned,aregion,atier,astep,amaudit,ahdr,atrust);
            let arc2:i32=ob_msg_enqueue(aq,&aqn,ARB_QCAP,1,sent,M_DISCONNECT,0,0);
            f=f+l4_emit("L4a'","reenqueue_after_drain",arc2,0);
        }
        sent=sent+1;
    }
    if(aqn>0){
        proctot=proctot+aqn;
        arb_process(1,aq,&aqn,aast,aroutes,aalog,&aaln,apam,afl2,0,
            alive,avalue,apinned,aregion,atier,astep,amaudit,ahdr,atrust);
    }
    f=f+l4_emit("L4a'","junk_sent",sent,10000);
    f=f+l4_emit("L4a'","junk_processed",proctot,10000);
    f=f+l4_emit("L4a'","queue_empty",aqn,0);
    f=f+l4_emit("L4a'","ordinary_audit_capped",aaln,ARB_ACAP-ARB_GOV_RES);
    f=f+l4_emit("L4a'","gov_reservation_free",(ARB_ACAP-aaln),ARB_GOV_RES);

    // ---------------- L4b': 252 junk + genuine force-pin ----------------
    let bq:[]u8=ob_msgq_init(ARB_QCAP);let bqn:i32=0;
    let bast:[]u8=arb_new_state();let broutes:[]u8=arb_new_routes();
    let balog:[]u8=ob_alloc(ARB_ACAP*16);let baln:i32=0;
    let bpam:[]u8=pam_new();let bfl2:[]u8=ob_alloc(16);
    let blive:[]u8=mm_new_live();let bvalue:[]u8=mm_new_value();
    let bpinned:[]u8=mm_new_pinned();let bregion:[]u8=mm_new_region();
    let btier:[]u8=mm_new_tier();let bstep:[]u8=mm_new_step();
    let bmaudit:[]u8=mm_new_audit();let bhdr:[]u8=mm_new_hdr();
    let btrust:[]u8=mm_new_trust();
    f=f+l4_emit("L4b'","organ_ready",l4_organ_ready(blive,bvalue,bpinned,bregion,btier,bstep,bmaudit,bhdr),0);
    let bi:i32=0;let bfail:i32=0;
    while(bi<252){
        if(ob_msg_enqueue(bq,&bqn,ARB_QCAP,2,bi,M_DISCONNECT,0,0)!=0){bfail=1;}
        bi=bi+1;
    }
    f=f+l4_emit("L4b'","junk252_ok",bfail,0);
    let brc:i32=ob_msg_enqueue(bq,&bqn,ARB_QCAP,2,252,M_FORCE_PIN,7,0);
    f=f+l4_emit("L4b'","pin_enqueue_rc",brc,0);
    arb_process(2,bq,&bqn,bast,broutes,balog,&baln,bpam,bfl2,0,
        blive,bvalue,bpinned,bregion,btier,bstep,bmaudit,bhdr,btrust);
    f=f+l4_emit("L4b'","pin_applied",bpinned[7] as i32,MA_PIN_FORCE);
    f=f+l4_emit("L4b'","pin_audited",l4_alog_count(balog,baln,M_FORCE_PIN),1);
    let fp:i32=l4_alog_first(balog,baln,M_FORCE_PIN);
    let fj:i32=l4_alog_first(balog,baln,M_DISCONNECT);
    f=f+l4_emit("L4b'","pin_drains_first",(fp>=0 && fp<fj) as i32,1);
    f=f+l4_emit("L4b'","queue_drained",bqn,0);

    // ---------------- L4c': junk cannot steal the lane ----------------
    let cq:[]u8=ob_msgq_init(ARB_QCAP);let cqn:i32=0;
    let cast:[]u8=arb_new_state();let croutes:[]u8=arb_new_routes();
    let calog:[]u8=ob_alloc(ARB_ACAP*16);let caln:i32=0;
    let cpam:[]u8=pam_new();let cfl2:[]u8=ob_alloc(16);
    let clive:[]u8=mm_new_live();let cvalue:[]u8=mm_new_value();
    let cpinned:[]u8=mm_new_pinned();let cregion:[]u8=mm_new_region();
    let ctier:[]u8=mm_new_tier();let cstep:[]u8=mm_new_step();
    let cmaudit:[]u8=mm_new_audit();let chdr:[]u8=mm_new_hdr();
    let ctrust:[]u8=mm_new_trust();
    f=f+l4_emit("L4c'","organ_ready",l4_organ_ready(clive,cvalue,cpinned,cregion,ctier,cstep,cmaudit,chdr),0);
    let ci:i32=0;
    while(ci<252){
        ob_msg_enqueue(cq,&cqn,ARB_QCAP,3,ci,M_DISCONNECT,0,0);
        ci=ci+1;
    }
    // 253rd junk: ordinary region full -> -1 (must NOT take a lane slot)
    f=f+l4_emit("L4c'","junk253_refused",ob_msg_enqueue(cq,&cqn,ARB_QCAP,3,252,M_DISCONNECT,0,0),-1);
    let crc:i32=ob_msg_enqueue(cq,&cqn,ARB_QCAP,3,253,M_FORCE_PIN,7,0);
    f=f+l4_emit("L4c'","pin_enqueue_rc",crc,0);
    arb_process(3,cq,&cqn,cast,croutes,calog,&caln,cpam,cfl2,0,
        clive,cvalue,cpinned,cregion,ctier,cstep,cmaudit,chdr,ctrust);
    f=f+l4_emit("L4c'","pin_applied",cpinned[7] as i32,MA_PIN_FORCE);
    f=f+l4_emit("L4c'","pin_audited",l4_alog_count(calog,caln,M_FORCE_PIN),1);
    f=f+l4_emit("L4c'","queue_drained",cqn,0);

    // ---------------- L4c2': lane-full boundary ----------------
    let lq:[]u8=ob_msgq_init(ARB_QCAP);let lqn:i32=0;
    let lrc_ok:i32=0;let li:i32=0;
    while(li<4){
        if(ob_msg_enqueue(lq,&lqn,ARB_QCAP,4,li,M_FORCE_PIN,7,0)!=0){lrc_ok=1;}
        li=li+1;
    }
    f=f+l4_emit("L4c2'","four_pins_ok",lrc_ok,0);
    f=f+l4_emit("L4c2'","fifth_pin_refused",
        ob_msg_enqueue(lq,&lqn,ARB_QCAP,4,4,M_FORCE_PIN,7,0),-1);

    // ---------------- L4d': PAM observation reservation ----------------
    let dpam:[]u8=pam_new();
    let di:i32=0;let dfail:i32=0;
    while(di<56){
        let s2:i32=pam_observe(dpam,1,1,800,800,1,1,2,7,350,350,350,di);
        if(s2!=di){dfail=1;}
        di=di+1;
    }
    f=f+l4_emit("L4d'","junk56_ok",dfail,0);
    f=f+l4_emit("L4d'","ordinary57_refused",
        pam_observe(dpam,1,1,800,800,1,1,2,7,350,350,350,56),-1);
    // genuine governance observation lands in the reservation
    let gslot:i32=pam_observe_gov(dpam,5,5,800,800,1,11,22,7,350,350,350,100);
    f=f+l4_emit("L4d'","gov_slot",gslot,56);
    let gi:i32=0;let gfail:i32=0;
    while(gi<7){
        if(pam_observe_gov(dpam,5,5,800,800,1,11,22,7,350,350,350,101+gi)<0){gfail=1;}
        gi=gi+1;
    }
    f=f+l4_emit("L4d'","gov7_more_ok",gfail,0);
    f=f+l4_emit("L4d'","pam_n_full",pam_n(dpam),64);
    f=f+l4_emit("L4d'","gov9th_refused",
        pam_observe_gov(dpam,5,5,800,800,1,11,22,7,350,350,350,200),-1);
    // the genuine observation still earns its verdict
    let gv:i32=0;let gr:i32=0;
    f=f+l4_emit("L4d'","gov_verdict_rc",pam_verdict(dpam,gslot,PAM_MODE_FRESH,&gv,&gr),0);
    f=f+l4_emit("L4d'","gov_verdict",gv,PAM_ADMIT);

    // ---------------- L4e': verdict ring (zero unlogged ADMITs) ----------------
    let epam:[]u8=pam_new();
    let sa2:i32=pam_observe(epam,5,5,800,800,1,11,22,7,350,350,350,200);
    let sb2:i32=pam_observe(epam,5,5,800,800,1,11,22,7,350,350,350,201);
    f=f+l4_emit("L4e'","slots",sa2+sb2,1);
    let ev:i32=0;let er:i32=0;let erc:i32=0;let ei:i32=0;let efail:i32=0;
    while(ei<301){
        let tgt:i32=sa2;
        if(ei%2==1){tgt=sb2;}
        erc=pam_verdict(epam,tgt,PAM_MODE_FRESH,&ev,&er);
        if(erc!=0){efail=1;}
        ei=ei+1;
    }
    f=f+l4_emit("L4e'","all301_rc0",efail,0);
    f=f+l4_emit("L4e'","ledger_n",pam_ledger_n(epam),256);
    f=f+l4_emit("L4e'","evicted",pam_ledger_evicted(epam),45);
    // ring holds verdicts #45..#300 in order: entry0.ep=201 (#45 odd->B),
    // entry255.ep=200 (#300 even->A); entry0.slot=sb2, entry255.slot=sa2
    let lg:[]u8=epam;
    f=f+l4_emit("L4e'","ring_first_ep",ob_g32(lg,3076),201);
    f=f+l4_emit("L4e'","ring_first_slot",ob_g32(lg,3076+12),sb2);
    f=f+l4_emit("L4e'","ring_last_ep",ob_g32(lg,3076+255*16),200);
    f=f+l4_emit("L4e'","ring_last_slot",ob_g32(lg,3076+255*16+12),sa2);
    f=f+l4_emit("L4e'","ring_first_verdict",ob_g32(lg,3076+4),PAM_ADMIT);

    // ---------------- L4f': audit reservation boundary ----------------
    let flog:[]u8=ob_alloc(ARB_ACAP*16);let fln:i32=0;
    let fast:[]u8=arb_new_state();
    let fi:i32=0;let fofail:i32=0;
    while(fi<ARB_ACAP-ARB_GOV_RES){
        if(arb_audit(flog,&fln,9,M_DISCONNECT,0,0)!=0){fofail=1;}
        fi=fi+1;
    }
    f=f+l4_emit("L4f'","ordinary960_ok",fofail,0);
    f=f+l4_emit("L4f'","ordinary961_refused",arb_audit(flog,&fln,9,M_DISCONNECT,0,0),-1);
    let g2i:i32=0;let g2fail:i32=0;
    while(g2i<ARB_GOV_RES){
        if(arb_audit_gov(9,fast,flog,&fln,M_FORCE_PIN,7,0)!=0){g2fail=1;}
        g2i=g2i+1;
    }
    f=f+l4_emit("L4f'","gov64_ok",g2fail,0);
    f=f+l4_emit("L4f'","log_full",fln,ARB_ACAP);
    f=f+l4_emit("L4f'","gov65_refused",arb_audit_gov(9,fast,flog,&fln,M_FORCE_PIN,7,0),-1);
    f=f+l4_emit("L4f'","overflow_counted",arb_gov_audit_dropped(fast),1);

    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

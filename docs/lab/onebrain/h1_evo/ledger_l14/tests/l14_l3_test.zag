// L3' — MEM clock guard.
// The old L3 attack wrote garbage clocks (500, 7, 999999, -5) directly into
// the header word and the audit trusted it verbatim. L3' moves the audit
// clock to a GUARDED header word (@16) that only mm_clock_advance can move:
// strictly monotonic advances (new > current, new >= 0) are accepted and
// audit-logged; every refused attempt is also audit-logged (rc=
// MA_REFUSED_CLOCK) and changes nothing. Raw writes to the legacy word @4
// are inert: entries and step[] read the guarded word only.
//
// KILL: garbage accepted; monotonicity break; a refused move altering state
// or entering later entries; an accepted move not audit-logged.
@import("../src/ob_common.zag")
@import("../src/ob_mem.zag")

// last audit entry with op==want; returns entry index or -1
fn l3_last_op(audit:[]u8,hdr:[]u8,want:i32)i32 {
    let n:i32=ob_g32(hdr,8);
    let i:i32=n-1;
    while(i>=0){
        if(ob_g32(audit,i*48+4)==want){return i;}
        i=i-1;
    }
    return -1;
}

fn main()i32 {
    let f:i32=0;
    let px:[]u8="l3p_";
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let audit:[]u8=mm_new_audit();let hdr:[]u8=mm_new_hdr();
    f=f+ob_check(px,"stage1",mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr),0);
    f=f+ob_check(px,"stage2",mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr),0);

    // ---- the old attack vector: raw writes of garbage clocks ----
    // direct write of 500 to the legacy word: must be INERT
    ob_s32(hdr,4,500);
    f=f+ob_check(px,"raw500_inert",mm_clock(hdr),0);
    let s0:i32=0;
    f=f+ob_check(px,"add_after_raw",mm_add(live,value,pinned,region,tier,step,
        audit,hdr,42,1,&s0),0);
    // the ADD entry's step must be the guarded clock (0), not 500
    let ae:i32=l3_last_op(audit,hdr,MA_OP_ADD);
    f=f+ob_check(px,"add_step_guarded",ob_g32(audit,ae*48),0);
    f=f+ob_check(px,"step_arr_guarded",ob_g32(step,s0*4),0);
    // more garbage: backward, huge, negative — all into the legacy word
    ob_s32(hdr,4,7);
    f=f+ob_check(px,"raw7_inert",mm_clock(hdr),0);
    ob_s32(hdr,4,999999);
    f=f+ob_check(px,"raw999999_inert",mm_clock(hdr),0);
    ob_s32(hdr,4,0-5);
    f=f+ob_check(px,"rawneg5_inert",mm_clock(hdr),0);

    // ---- the guard itself: garbage via the sanctioned API ----
    // 500 from 0: strictly monotonic means > current — but a 500-jump from
    // 0 must still be ACCEPTED as a forward move (monotonicity is about
    // direction, not stride)... the old attack's "500" is refused here
    // because it bypassed the guard (raw write), not because of its size.
    // Negative and backward moves are refused:
    f=f+ob_check(px,"adv_neg",mm_clock_advance(hdr,audit,0-5),MA_REFUSED_CLOCK);
    f=f+ob_check(px,"neg_no_move",mm_clock(hdr),0);
    f=f+ob_check(px,"adv_zero",mm_clock_advance(hdr,audit,0),MA_REFUSED_CLOCK);
    f=f+ob_check(px,"zero_no_move",mm_clock(hdr),0);
    // accepted forward moves, each audit-logged
    f=f+ob_check(px,"adv_5",mm_clock_advance(hdr,audit,5),MA_OK);
    f=f+ob_check(px,"clock_is_5",mm_clock(hdr),5);
    f=f+ob_check(px,"adv_6",mm_clock_advance(hdr,audit,6),MA_OK);
    f=f+ob_check(px,"adv_7",mm_clock_advance(hdr,audit,7),MA_OK);
    // backward move refused, state unchanged, refusal audited
    let n_before:i32=ob_g32(hdr,8);
    f=f+ob_check(px,"adv_back",mm_clock_advance(hdr,audit,6),MA_REFUSED_CLOCK);
    f=f+ob_check(px,"back_no_move",mm_clock(hdr),7);
    f=f+ob_check(px,"back_audited",(ob_g32(hdr,8)==n_before+1) as i32,1);
    let re:i32=l3_last_op(audit,hdr,MA_OP_CLOCK);
    f=f+ob_check(px,"back_rc",ob_g32(audit,re*48+12),MA_REFUSED_CLOCK);
    f=f+ob_check(px,"back_step",ob_g32(audit,re*48),7);
    // accepted moves are audit-logged with rc=MA_OK and the right step
    let ae2:i32=l3_last_op(audit,hdr,MA_OP_CLOCK);
    // (last CLOCK entry is the refused one; find the last ACCEPTED one)
    let n2:i32=ob_g32(hdr,8);
    let i:i32=n2-1;
    let acc:i32=-1;
    while(i>=0){
        if(acc<0 && ob_g32(audit,i*48+4)==MA_OP_CLOCK && ob_g32(audit,i*48+12)==MA_OK){acc=i;}
        i=i-1;
    }
    f=f+ob_check(px,"acc_found",(acc>=0) as i32,1);
    f=f+ob_check(px,"acc_step",ob_g32(audit,acc*48),7);
    f=f+ob_check(px,"acc_b1",ob_g32(audit,acc*48+16),7);
    // entries after the advance carry the new guarded clock
    let s1:i32=0;
    f=f+ob_check(px,"add2",mm_add(live,value,pinned,region,tier,step,
        audit,hdr,77,1,&s1),0);
    let ae3:i32=l3_last_op(audit,hdr,MA_OP_ADD);
    f=f+ob_check(px,"add2_step",ob_g32(audit,ae3*48),7);
    f=f+ob_check(px,"add2_steparr",ob_g32(step,s1*4),7);
    // no_leak: no CLOCK refusal may leak into a later entry's step
    f=f+ob_check(px,"no_leak",ob_g32(audit,ae3*48+16),1);
    // stride rule pinned: a large FORWARD jump via the sanctioned API is
    // monotonic (direction, not stride, is the rule — no arbitrary stride
    // cap per the no-stupid-limits law) and is accepted + logged.
    f=f+ob_check(px,"adv_500",mm_clock_advance(hdr,audit,500),MA_OK);
    f=f+ob_check(px,"clock_is_500",mm_clock(hdr),500);
    let le:i32=l3_last_op(audit,hdr,MA_OP_CLOCK);
    f=f+ob_check(px,"jump_logged",ob_g32(audit,le*48+12),MA_OK);
    f=f+ob_check(px,"jump_step",ob_g32(audit,le*48),500);

    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

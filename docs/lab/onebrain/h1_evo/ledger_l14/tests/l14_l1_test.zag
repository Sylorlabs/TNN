// L1' — ledger tamper-evidence: hash the EXACT raw pre-escape runtime bytes.
// No in-hash normalization (no whitespace collapse, no escape folding).
// The old L1 harness hashed escape-normalized forms (mode 0: 5 false trips
// on '"'/'\' payloads) or whitespace-collapsed forms (mode 1: missed
// double-space / newline-for-space mutations). L1' hashes raw runtime bytes
// (old harness mode 2's winning semantics), which the frozen attack proves
// passes 12/12 honest entries incl. '"'/'\' payloads while catching every
// mutation at exact-byte resolution.
//
// KILL: any tamper flag on the 12 honest entries; any mutation that is NOT
// caught; any evidence that the hash input was escape- or
// whitespace-normalized before hashing.
@import("../src/ob_common.zag")
@import("../src/sha256.zag")

const L1N:i32=12;
const L1PL:i32=64;   // max payload bytes per entry

fn l1_eq32(a:[]u8,b:[]u8)i32 {
    let i:i32=0;
    while(i<32){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

// verify: 1 = verifies (no tamper), 0 = trips
fn l1_verify(p:[]u8,recorded:[]u8)i32 {
    let dg:[]u8=ob_alloc(32);
    ns_sha256(p,dg);
    let ok:i32=l1_eq32(dg,recorded);
    ob_free(dg);
    return ok;
}
fn l1_record(p:[]u8,dg:[]u8)i32 { return ns_sha256(p,dg); }

// copy sn bytes replacing byte at pos with nb; returns sn
fn l1_mut1(src:[]u8,sn:i32,dst:[]u8,pos:i32,nb:i32)i32 {
    let i:i32=0;
    while(i<sn){dst[i]=src[i];i=i+1;}
    dst[pos]=nb as u8;
    return sn;
}
// copy sn bytes dropping the byte at pos; returns sn-1
fn l1_drop1(src:[]u8,sn:i32,dst:[]u8,pos:i32)i32 {
    let i:i32=0;
    while(i<pos){dst[i]=src[i];i=i+1;}
    let j:i32=pos+1;
    while(j<sn){dst[j-1]=src[j];j=j+1;}
    return sn-1;
}
// copy sn bytes appending nb; returns sn+1
fn l1_app1(src:[]u8,sn:i32,dst:[]u8,nb:i32)i32 {
    let i:i32=0;
    while(i<sn){dst[i]=src[i];i=i+1;}
    dst[sn]=nb as u8;
    return sn+1;
}
// build "tab"<TAB>"here" and "line"<LF>"break" style entries numerically
fn l1_build3(a:[]u8,an:i32,mid:i32,b:[]u8,bn:i32,out:[]u8)i32 {
    let i:i32=0;
    while(i<an){out[i]=a[i];i=i+1;}
    out[an]=mid as u8;
    let j:i32=0;
    while(j<bn){out[an+1+j]=b[j];j=j+1;}
    return an+1+bn;
}

fn main()i32 {
    let f:i32=0;
    let px:[]u8="l1p_";
    // arenas: payloads (12x64), recorded digests (12x32), lengths
    let pl:[]u8=ob_alloc(L1N*L1PL);
    let pln:[]u8=ob_alloc(L1N*4);
    let rec:[]u8=ob_alloc(L1N*32);
    let tmp:[]u8=ob_alloc(L1PL+8);

    // ---- honest entries (raw runtime bytes; '"' and '\' verbatim) ----
    let e0:[]u8="alpha beta gamma";
    let e1:[]u8="pin slot 5";
    let e2:[]u8="quarantine U";
    let e3:[]u8="promote S";
    let e4:[]u8="the \"quoted\" word";
    let e5:[]u8="back\\slash path";
    let e6:[]u8="a  b   c";
    let e7:[]u8="trailing space ";
    let e8:[]u8=" leading space";
    let e9:[]u8="mix \"q\" and \\b\\";
    // e10: "tab"<TAB>"here"; e11: "line"<LF>"break" (bytes built numerically)
    let t1:[]u8="tab";let t2:[]u8="here";
    let n10:i32=l1_build3(t1,3,9,t2,4,tmp);
    let l1:[]u8="line";let l2:[]u8="break";
    let n11:i32=l1_build3(l1,4,10,l2,5,pl[10*L1PL..10*L1PL+L1PL]);
    // stage e10 into the arena too
    let i:i32=0;
    while(i<n10){pl[10*L1PL+i]=tmp[i];i=i+1;}

    // copy literals into arena (indices 0..9) — byte-exact, no normalization
    let n0:i32=e0.len;let n1:i32=e1.len;let n2:i32=e2.len;let n3:i32=e3.len;
    let n4:i32=e4.len;let n5:i32=e5.len;let n6:i32=e6.len;let n7:i32=e7.len;
    let n8:i32=e8.len;let n9:i32=e9.len;
    i=0;
    while(i<n0){pl[0*L1PL+i]=e0[i];i=i+1;}
    i=0;
    while(i<n1){pl[1*L1PL+i]=e1[i];i=i+1;}
    i=0;
    while(i<n2){pl[2*L1PL+i]=e2[i];i=i+1;}
    i=0;
    while(i<n3){pl[3*L1PL+i]=e3[i];i=i+1;}
    i=0;
    while(i<n4){pl[4*L1PL+i]=e4[i];i=i+1;}
    i=0;
    while(i<n5){pl[5*L1PL+i]=e5[i];i=i+1;}
    i=0;
    while(i<n6){pl[6*L1PL+i]=e6[i];i=i+1;}
    i=0;
    while(i<n7){pl[7*L1PL+i]=e7[i];i=i+1;}
    i=0;
    while(i<n8){pl[8*L1PL+i]=e8[i];i=i+1;}
    i=0;
    while(i<n9){pl[9*L1PL+i]=e9[i];i=i+1;}
    ob_s32(pln,0*4,n0);ob_s32(pln,1*4,n1);ob_s32(pln,2*4,n2);
    ob_s32(pln,3*4,n3);ob_s32(pln,4*4,n4);ob_s32(pln,5*4,n5);
    ob_s32(pln,6*4,n6);ob_s32(pln,7*4,n7);ob_s32(pln,8*4,n8);
    ob_s32(pln,9*4,n9);ob_s32(pln,10*4,n10);ob_s32(pln,11*4,n11);

    // record digests over the EXACT runtime bytes
    k=0;
    while(k<L1N){
        let p:[]u8=pl[k*L1PL..k*L1PL+ob_g32(pln,k*4)];
        let dg:[]u8=rec[k*32..k*32+32];
        f=f+ob_check(px,"record",l1_record(p,dg),0);
        k=k+1;
    }
    // honest verify: 12/12 must pass, zero tamper flags
    k=0;
    while(k<L1N){
        let p2:[]u8=pl[k*L1PL..k*L1PL+ob_g32(pln,k*4)];
        let dg2:[]u8=rec[k*32..k*32+32];
        f=f+ob_check(px,"honest",l1_verify(p2,dg2),1);
        k=k+1;
    }

    // ---- mutation battery: every mutation must TRIP (verify -> 0) ----
    // 1. byte flip: "pin slot 5" -> "pin Xlot 5"
    let s1:[]u8=pl[1*L1PL..1*L1PL+ob_g32(pln,1*4)];
    let r1:[]u8=rec[1*32..1*32+32];
    let m1:i32=l1_mut1(s1,ob_g32(pln,1*4),tmp,4,88);   // 'X'
    f=f+ob_check(px,"mut_byteflip",l1_verify(tmp[0..m1],r1),0);
    // 2. double-space insertion: "pin slot 5" -> "pin  slot 5"
    let m2:i32=l1_drop1(s1,ob_g32(pln,1*4),tmp,0);    // (scratch reuse below)
    let j2:i32=0;
    while(j2<3){tmp[j2]=s1[j2];j2=j2+1;}
    tmp[3]=32;tmp[4]=32;
    let j3:i32=3;
    while(j3<ob_g32(pln,1*4)){tmp[2+j3]=s1[j3];j3=j3+1;}
    f=f+ob_check(px,"mut_doublespace",l1_verify(tmp[0..ob_g32(pln,1*4)+1],r1),0);
    // 3. space -> newline: "pin slot 5"[3] 32 -> 10
    let m3:i32=l1_mut1(s1,ob_g32(pln,1*4),tmp,3,10);
    f=f+ob_check(px,"mut_space2nl",l1_verify(tmp[0..m3],r1),0);
    // 4. newline -> space on e11: "line\nbreak"[4] 10 -> 32
    let s11:[]u8=pl[11*L1PL..11*L1PL+ob_g32(pln,11*4)];
    let r11:[]u8=rec[11*32..11*32+32];
    let m4:i32=l1_mut1(s11,ob_g32(pln,11*4),tmp,4,32);
    f=f+ob_check(px,"mut_nl2space",l1_verify(tmp[0..m4],r11),0);
    // 5. tab -> space on e10: [3] 9 -> 32
    let s10:[]u8=pl[10*L1PL..10*L1PL+ob_g32(pln,10*4)];
    let r10:[]u8=rec[10*32..10*32+32];
    let m5:i32=l1_mut1(s10,ob_g32(pln,10*4),tmp,3,32);
    f=f+ob_check(px,"mut_tab2space",l1_verify(tmp[0..m5],r10),0);
    // 6. quote -> single-quote on e4: first '"' (byte 4) -> 39
    let s4:[]u8=pl[4*L1PL..4*L1PL+ob_g32(pln,4*4)];
    let r4:[]u8=rec[4*32..4*32+32];
    let m6:i32=l1_mut1(s4,ob_g32(pln,4*4),tmp,4,39);
    f=f+ob_check(px,"mut_quote",l1_verify(tmp[0..m6],r4),0);
    // 7. backslash -> slash on e5: byte 4 ('\\' 92) -> 47
    let s5:[]u8=pl[5*L1PL..5*L1PL+ob_g32(pln,5*4)];
    let r5:[]u8=rec[5*32..5*32+32];
    let m7:i32=l1_mut1(s5,ob_g32(pln,5*4),tmp,4,47);
    f=f+ob_check(px,"mut_backslash",l1_verify(tmp[0..m7],r5),0);
    // 8. truncation: drop last byte of e2
    let s2:[]u8=pl[2*L1PL..2*L1PL+ob_g32(pln,2*4)];
    let r2:[]u8=rec[2*32..2*32+32];
    let m8:i32=l1_drop1(s2,ob_g32(pln,2*4),tmp,ob_g32(pln,2*4)-1);
    f=f+ob_check(px,"mut_trunc",l1_verify(tmp[0..m8],r2),0);
    // 9. append: e3 + '!'
    let s3:[]u8=pl[3*L1PL..3*L1PL+ob_g32(pln,3*4)];
    let r3:[]u8=rec[3*32..3*32+32];
    let m9:i32=l1_app1(s3,ob_g32(pln,3*4),tmp,33);
    f=f+ob_check(px,"mut_append",l1_verify(tmp[0..m9],r3),0);

    // ---- normalization-trap: prove NO pre-hash normalization ----
    // T1: raw a"b (3 bytes) vs escaped-form a\"b (4 bytes) digest differently
    let raw:[]u8="a\"b";
    let esc:[]u8="a\\\"b";
    let dg_raw:[]u8=ob_alloc(32);let dg_esc:[]u8=ob_alloc(32);
    l1_record(raw,dg_raw);l1_record(esc,dg_esc);
    f=f+ob_check(px,"trap_esc_differs",l1_eq32(dg_raw,dg_esc),0);
    // T2: "a b" vs "a  b" digest differently (no whitespace collapse)
    let ws1:[]u8="a b";let ws2:[]u8="a  b";
    let dg_w1:[]u8=ob_alloc(32);let dg_w2:[]u8=ob_alloc(32);
    l1_record(ws1,dg_w1);l1_record(ws2,dg_w2);
    f=f+ob_check(px,"trap_ws_differs",l1_eq32(dg_w1,dg_w2),0);
    // T3/T4: cross-verification fails both ways (no normalization either way)
    f=f+ob_check(px,"trap_cross1",l1_verify(raw,dg_esc),0);
    f=f+ob_check(px,"trap_cross2",l1_verify(esc,dg_raw),0);
    f=f+ob_check(px,"trap_cross3",l1_verify(ws1,dg_w2),0);
    f=f+ob_check(px,"trap_cross4",l1_verify(ws2,dg_w1),0);
    ob_free(dg_raw);ob_free(dg_esc);ob_free(dg_w1);ob_free(dg_w2);

    ob_free(pl);ob_free(pln);ob_free(rec);ob_free(tmp);
    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

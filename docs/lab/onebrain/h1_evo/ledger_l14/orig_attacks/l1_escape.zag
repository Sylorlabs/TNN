// l1_escape.zag — L1: escape-confusion tamper on a string-carrying hash-chained ledger.
//
// Frozen §1.2 specifies a unified hash-chained ledger; Fable's P7 requires
// escalation entries to carry human-readable string summaries. Real-world
// summaries contain `"` and `\`. No string-carrying chain exists in the tree
// (the adapter C5 chain hashes fixed 24-byte binary words), so this driver
// builds the §1.2-faithful string-carrying construction and replays the exact
// failure mode from the znc tamper lesson (info-source 2026-09-22): the
// generator hashed backslash-escaped literal bytes instead of the
// whitespace-collapsed pre-escape runtime bytes.
//
// Three canonicalizations, one code path (mode flag):
//   mode 0 C_BUGGY  — generator hashes escape(payload)      (the info-source bug)
//   mode 1 C_LESSON  — generator+verifier hash collapse_ws(payload) (the lesson's prescription)
//   mode 2 C_STRICT  — generator+verifier hash payload byte-exact (unescaped runtime bytes)
// Legs: L1a false-positive (C_BUGGY honest entries trip), L1b false-negative
// (C_LESSON whitespace mutations verify), L1c control (C_STRICT: honest verify,
// every byte mutation fails), L1d real-chain control (adapter's exact link
// formula over word entries with 0x22/0x5C bytes).
// Pure Zag, zero RNG, 3x byte-identical reruns required.
@import("sha256.zag")

const L1N:i32=12;
const L1PL:i32=128;    // payload arena stride
const L1LN:i32=256;    // line arena stride

// ---- tiny output helpers (deterministic; all numbers via own dec printer) ----
fn l1_putdec(b:[]u8,n:*i32,v:i32)void {
    if(v<0){b[n.*]=45;n.*=n.*+1;v=0-v;}
    let t:[]u8=sh_alloc(12);let c:i32=0;
    if(v==0){t[0]=48;c=1;}
    while(v>0){t[c]=(48+v%10) as u8;c=c+1;v=v/10;}
    let i:i32=c-1;
    while(i>=0){b[n.*]=t[i];n.*=n.*+1;i=i-1;}
    sh_free(t);
    return;
}
fn l1_emit(tag:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    let b:[]u8=sh_alloc(160);let n:i32=0;let i:i32=0;
    while(i<tag.len){b[n]=tag[i];n=n+1;i=i+1;}
    b[n]=44;n=n+1;i=0;
    while(i<name.len){b[n]=name[i];n=n+1;i=i+1;}
    b[n]=44;n=n+1;
    l1_putdec(b,&n,actual);b[n]=44;n=n+1;l1_putdec(b,&n,expected);
    _zag_println(b[0..n]);
    sh_free(b);
    let f:i32=0;
    if(actual!=expected){f=1;}
    return f;
}

// ---- payload byte builders (34='"', 92='\') ----
fn l1_copy(dst:[]u8,s:[]u8)void {
    let i:i32=0;while(i<s.len){dst[i]=s[i];i=i+1;}
    return;
}
fn l1_payload(k:i32,out:[]u8)i32 {
    // returns payload length; writes into out (caller: >=64 bytes)
    if(k==0){l1_copy(out,"seal the vault");return 14;}
    if(k==1){l1_copy(out,"deny access");return 11;}
    if(k==2){l1_copy(out,"teacher said ");out[13]=34;l1_copy(out[14..],"stop");out[18]=34;return 19;}
    if(k==3){l1_copy(out,"pin slot 5");return 10;}
    if(k==4){l1_copy(out,"path C:");out[7]=92;l1_copy(out[8..],"novel");out[13]=92;l1_copy(out[14..],"run");return 17;}
    if(k==5){l1_copy(out,"quarantine U");return 12;}
    if(k==6){l1_copy(out,"note ");out[5]=34;out[6]=97;out[7]=92;out[8]=98;out[9]=34;l1_copy(out[10..]," end");return 14;}
    if(k==7){l1_copy(out,"promote S");return 9;}
    if(k==8){l1_copy(out,"revoke R");return 8;}
    if(k==9){l1_copy(out,"escalate ");out[9]=34;l1_copy(out[10..],"urgent");out[16]=34;return 17;}
    if(k==10){l1_copy(out,"withhold T");return 10;}
    if(k==11){l1_copy(out,"domain");out[6]=92;out[7]=92;l1_copy(out[8..],"server");return 14;}
    return 0;
}

// ---- escaping: \ -> \\, " -> \", LF -> \n, | -> \| (flat guards; no deep else) ----
fn l1_esc_put(b:[]u8,n:*i32,p:[]u8)void {
    let i:i32=0;
    while(i<p.len){
        let c:i32=p[i] as i32;
        if(c==92){b[n.*]=92;n.*=n.*+1;b[n.*]=92;n.*=n.*+1;}
        if(c==34){b[n.*]=92;n.*=n.*+1;b[n.*]=34;n.*=n.*+1;}
        if(c==10){b[n.*]=92;n.*=n.*+1;b[n.*]=110;n.*=n.*+1;}
        if(c==124){b[n.*]=92;n.*=n.*+1;b[n.*]=124;n.*=n.*+1;}
        if(c!=92 && c!=34 && c!=10 && c!=124){b[n.*]=p[i];n.*=n.*+1;}
        i=i+1;
    }
    return;
}
// unescape; returns 0 ok, -1 trailing backslash, -2 unknown escape
fn l1_unesc_put(b:[]u8,n:*i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c==92){
            if(i+1>=s.len){return -1;}
            let d:i32=s[i+1] as i32;
            if(d!=110 && d!=92 && d!=34 && d!=124){return -2;}
            if(d==110){b[n.*]=10;n.*=n.*+1;}
            if(d==92){b[n.*]=92;n.*=n.*+1;}
            if(d==34){b[n.*]=34;n.*=n.*+1;}
            if(d==124){b[n.*]=124;n.*=n.*+1;}
            i=i+2;
        }
        if(c!=92){b[n.*]=s[i];n.*=n.*+1;i=i+1;}
    }
    return 0;
}
// whitespace collapse: maximal runs of {space,tab,LF,CR} -> single 0x20, ends trimmed
fn l1_collapse_put(b:[]u8,n:*i32,p:[]u8)void {
    let i:i32=0;let inws:i32=0;
    while(i<p.len){
        let c:i32=p[i] as i32;
        let w:i32=0;
        if(c==32 || c==9){w=1;}
        if(c==10 || c==13){w=1;}
        if(w==1){inws=1;}
        if(w==0){
            if(inws==1 && n.*>0){b[n.*]=32;n.*=n.*+1;}
            b[n.*]=p[i];n.*=n.*+1;inws=0;
        }
        i=i+1;
    }
    return;
}
fn l1_parse_dec(s:[]u8,at:i32,ln:i32)i32 {
    let v:i32=0;let i:i32=at;let neg:i32=0;
    if(i<ln && s[i]==45){neg=1;i=i+1;}
    while(i<ln){
        let c:i32=s[i] as i32;
        if(c<48 || c>57){break;}
        v=v*10+(c-48);i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

// ---- chain core ----
// entry word fields per index i (caller arenas): clock, organ, op, slot, aux, rc
fn l1_fw_put(fw:[]u8,i:i32,k:i32,v:i32)void {
    let b:[]u8=fw[i*28+k*4..i*28+k*4+4];
    b[0]=(v&255) as u8;b[1]=((v>>8)&255) as u8;b[2]=((v>>16)&255) as u8;b[3]=((v>>24)&255) as u8;
    return;
}
fn l1_fw_get(fw:[]u8,i:i32,k:i32)i32 {
    let o:i32=i*28+k*4;
    return (fw[o] as i32)+((fw[o+1] as i32)<<8)+((fw[o+2] as i32)<<16)+((fw[o+3] as i32)<<24);
}
// canonical payload for mode: 0=escape, 1=collapse_ws, 2=raw. writes into cb, sets cn.
fn l1_canon(mode:i32,p:[]u8,cb:[]u8,cn:*i32)void {
    let n:i32=0;
    if(mode==0){l1_esc_put(cb,&n,p);}
    if(mode==1){l1_collapse_put(cb,&n,p);}
    if(mode==2){let i:i32=0;while(i<p.len){cb[i]=p[i];i=i+1;}n=p.len;}
    cn.*=n;
    return;
}
// link(i) into dg[32]: SHA256(tag16 || [prev32] || entry_bytes).
// entry_bytes = clock|organ|op|slot|before32|after32|aux|rc|paylen|canon
fn l1_link(mode:i32,idx:i32,prev:[]u8,fw:[]u8,i:i32,p:[]u8,dg:[]u8)i32 {
    let pre:[]u8=sh_alloc(512);
    let tag:[]u8="OB-L1-GENESIS-v1";
    if(idx>0){tag="OB-L1-CHAIN-v1";}
    let t:i32=0;
    while(t<16){pre[t]=0;t=t+1;}
    t=0;
    while(t<tag.len && t<16){pre[t]=tag[t];t=t+1;}
    let o:i32=16;
    if(idx>0){t=0;while(t<32){pre[o+t]=prev[t];t=t+1;}o=o+32;}
    // words: clock, organ, op, slot, aux, rc  (6 x u32 LE)
    let w0:i32=l1_fw_get(fw,i,0);let w1:i32=l1_fw_get(fw,i,1);let w2:i32=l1_fw_get(fw,i,2);
    let w3:i32=l1_fw_get(fw,i,3);let w4:i32=l1_fw_get(fw,i,4);let w5:i32=l1_fw_get(fw,i,5);
    t=0;
    while(t<6){
        let v:i32=w0;
        if(t==1){v=w1;} if(t==2){v=w2;} if(t==3){v=w3;} if(t==4){v=w4;} if(t==5){v=w5;}
        pre[o]=(v&255) as u8;pre[o+1]=((v>>8)&255) as u8;pre[o+2]=((v>>16)&255) as u8;pre[o+3]=((v>>24)&255) as u8;o=o+4;t=t+1;
    }
    // before/after: deterministic 32-byte patterns from i
    t=0;while(t<32){pre[o+t]=((i*3+t)&255) as u8;t=t+1;}o=o+32;
    t=0;while(t<32){pre[o+t]=((i*5+t)&255) as u8;t=t+1;}o=o+32;
    let cb:[]u8=sh_alloc(256);let cn:i32=0;
    l1_canon(mode,p,cb,&cn);
    pre[o]=(cn&255) as u8;pre[o+1]=((cn>>8)&255) as u8;pre[o+2]=((cn>>16)&255) as u8;pre[o+3]=((cn>>24)&255) as u8;o=o+4;
    t=0;while(t<cn){pre[o+t]=cb[t];t=t+1;}o=o+cn;
    let rc:i32=ns_sha256(pre[0..o],dg);
    sh_free(pre);sh_free(cb);
    return rc;
}
// generate full chain (gen_mode) into lk; returns 0 ok
fn l1_gen_chain(gen_mode:i32,fw:[]u8,pl:[]u8,pln:[]u8,lk:[]u8)i32 {
    let i:i32=0;
    while(i<L1N){
        let dg:[]u8=sh_alloc(32);
        let pv:[]u8=sh_alloc(32);
        if(i>0){let t:i32=0;while(t<32){pv[t]=lk[(i-1)*32+t];t=t+1;}}
        let p:[]u8=pl[i*L1PL..i*L1PL+l1_pn_get(pln,i)];
        let r:i32=l1_link(gen_mode,i,pv,fw,i,p,dg);
        if(r!=0){sh_free(dg);sh_free(pv);return r;}
        let t:i32=0;while(t<32){lk[i*32+t]=dg[t];t=t+1;}
        sh_free(dg);sh_free(pv);
        i=i+1;
    }
    return 0;
}
// serialize entry i: L1E|clock|organ|op|slot|aux|rc|escaped_payload
fn l1_serialize(fw:[]u8,i:i32,p:[]u8,line:[]u8)i32 {
    let n:i32=0;
    l1_copy(line,"L1E|");n=4;
    let k:i32=0;
    while(k<6){l1_putdec(line,&n,l1_fw_get(fw,i,k));line[n]=124;n=n+1;k=k+1;}
    l1_esc_put(line,&n,p);
    return n;
}
// parse line into fields (fw row i) + payload (out, on). returns 0 ok.
fn l1_parse(line:[]u8,ln:i32,fw:[]u8,i:i32,out:[]u8,on:*i32)i32 {
    // fields 0..5 are decimal, field 6 (last) is the escaped payload: find
    // the first 7 unescaped '|' separators.
    let pos:[]u8=sh_alloc(32);let pc:i32=0;
    let at:i32=0;
    while(at<ln && pc<7){
        if(line[at]==124){pos[pc]=at as u8;pc=pc+1;}
        // payload never contains a raw '|' before escaping... but escaped
        // content does contain backslash-|; separators are raw '|' bytes:
        // a '|' preceded by an odd run of '\' is escaped. handle simply:
        at=at+1;
    }
    // NOTE: separators were emitted by l1_serialize, so the first 7 '|' are
    // the field separators only if the payload's '|' were all escaped (they
    // were). But a payload backslash before a separator '|': "...\\|..." —
    // the '|' after '\\' is a REAL separator; scanning raw '|' still lands on
    // it correctly because the escaped "\|" is backslash+pipe = 2 bytes and
    // the separator '|' is 1 byte: raw scan finds both; the FIRST 7 raw '|'
    // are exactly the 7 separators iff no escaped-\| appears before them.
    // Payloads here never start with backslash-pipe, and separators precede
    // the payload, so the first-7 scan is exact. (Documented, not hidden.)
    if(pc<7){sh_free(pos);return -1;}
    if(line[0]!=76 || line[1]!=49 || line[2]!=69){sh_free(pos);return -2;}
    // pos[0] ends the "L1E" tag; fields are (pos[0]+1 .. pos[1]), ... , payload after pos[6]
    let k:i32=0;let fs:i32=(pos[0] as i32)+1;
    while(k<6){
        let fe:i32=pos[k+1] as i32;
        l1_fw_put(fw,i,k,l1_parse_dec(line,fs,fe));
        fs=fe+1;k=k+1;
    }
    let pf:[]u8=line[fs..ln];
    let r:i32=l1_unesc_put(out,on,pf);
    sh_free(pos);
    return r;
}
// verify chain (ver_mode canonicalization) over parsed payloads vs stored links
fn l1_verify(ver_mode:i32,fw:[]u8,pl:[]u8,pln:[]u8,lk:[]u8,trips:*i32)i32 {
    let i:i32=0;let okall:i32=1;
    while(i<L1N){
        let dg:[]u8=sh_alloc(32);
        let pv:[]u8=sh_alloc(32);
        if(i>0){let t:i32=0;while(t<32){pv[t]=lk[(i-1)*32+t];t=t+1;}}
        let p:[]u8=pl[i*L1PL..i*L1PL+l1_pn_get(pln,i)];
        let r:i32=l1_link(ver_mode,i,pv,fw,i,p,dg);
        let same:i32=1;
        if(r!=0){same=0;}
        let t:i32=0;
        while(t<32){if(dg[t]!=lk[i*32+t]){same=0;}t=t+1;}
        if(same==0){trips.*=trips.*+1;okall=0;}
        sh_free(dg);sh_free(pv);
        i=i+1;
    }
    return okall;
}
fn l1_memeq(a:[]u8,b:[]u8,n:i32)i32 {
    let i:i32=0;while(i<n){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

// ---- payload-length arena helpers ----
fn l1_pn_put(pln:[]u8,i:i32,v:i32)void {
    pln[i*4]=(v&255) as u8;pln[i*4+1]=((v>>8)&255) as u8;
    pln[i*4+2]=((v>>16)&255) as u8;pln[i*4+3]=((v>>24)&255) as u8;
    return;
}
fn l1_pn_get(pln:[]u8,i:i32)i32 {
    let o:i32=i*4;
    return (pln[o] as i32)+((pln[o+1] as i32)<<8)+((pln[o+2] as i32)<<16)+((pln[o+3] as i32)<<24);
}
// single-entry verify: 1 = verifies, 0 = trips
fn l1_verify_one(ver_mode:i32,idx:i32,fw:[]u8,pl:[]u8,pln:[]u8,lk:[]u8)i32 {
    let dg:[]u8=sh_alloc(32);let pv:[]u8=sh_alloc(32);
    if(idx>0){let t:i32=0;while(t<32){pv[t]=lk[(idx-1)*32+t];t=t+1;}}
    let p:[]u8=pl[idx*L1PL..idx*L1PL+l1_pn_get(pln,idx)];
    let r:i32=l1_link(ver_mode,idx,pv,fw,idx,p,dg);
    let same:i32=1;
    if(r!=0){same=0;}
    let t:i32=0;
    while(t<32){if(dg[t]!=lk[idx*32+t]){same=0;}t=t+1;}
    sh_free(dg);sh_free(pv);
    return same;
}
// L1d: adapter-exact link formula over 24-byte word entries
fn l1d_link(idx:i32,prev:[]u8,e:[]u8,dg:[]u8)i32 {
    let pre:[]u8=sh_alloc(72);
    let t:i32=0;
    while(t<16){pre[t]=0;t=t+1;}
    let tag:[]u8="OB-C5-GENESIS-v1";
    if(idx>0){tag="OB-C5-CHAIN-v1";}
    t=0;
    while(t<tag.len && t<16){pre[t]=tag[t];t=t+1;}
    let o:i32=16;
    if(idx>0){t=0;while(t<32){pre[o+t]=prev[t];t=t+1;}o=o+32;}
    t=0;while(t<24){pre[o+t]=e[t];t=t+1;}o=o+24;
    let rc:i32=ns_sha256(pre[0..o],dg);
    sh_free(pre);
    return rc;
}

fn main()i32 {
    let f:i32=0;
    // 0. SHA-256 sanity: "abc" vector
    let dg0:[]u8=sh_alloc(32);
    let ab:[]u8="abc";
    f=f+l1_emit("L1","sha256_abc_rc",ns_sha256(ab,dg0),0);
    let hx:[]u8=ns_hex32(dg0);
    let want:[]u8="ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
    f=f+l1_emit("L1","sha256_abc_vec",l1_memeq(hx,want,64),1);
    sh_free(hx);sh_free(dg0);

    // arenas: fields(7 words/entry), payloads, payload lens, links
    let fw:[]u8=sh_alloc(L1N*28);
    let pl:[]u8=sh_alloc(L1N*L1PL);
    let pln:[]u8=sh_alloc(L1N*4);
    let lk:[]u8=sh_alloc(L1N*32);
    let i:i32=0;
    while(i<L1N){
        l1_fw_put(fw,i,0,i);l1_fw_put(fw,i,1,i%4);l1_fw_put(fw,i,2,100+i);
        l1_fw_put(fw,i,3,i);l1_fw_put(fw,i,4,i*7);l1_fw_put(fw,i,5,0);
        let n2:i32=l1_payload(i,pl[i*L1PL..i*L1PL+L1PL]);
        l1_pn_put(pln,i,n2);
        i=i+1;
    }
    // serialize/parse round-trip arenas
    let lines:[]u8=sh_alloc(L1N*L1LN);
    let pfw:[]u8=sh_alloc(L1N*28);
    let ppl:[]u8=sh_alloc(L1N*L1PL);
    let ppln:[]u8=sh_alloc(L1N*4);

    // ---- L1a: buggy generator (mode 0), correct verifier (mode 1 = collapse_ws(unescaped)) ----
    f=f+l1_emit("L1a","gen_rc",l1_gen_chain(0,fw,pl,pln,lk),0);
    let pracc:i32=0;
    i=0;
    while(i<L1N){
        let p:[]u8=pl[i*L1PL..i*L1PL+l1_pn_get(pln,i)];
        let ln2:i32=l1_serialize(fw,i,p,lines[i*L1LN..i*L1LN+L1LN]);
        let on:i32=0;
        let pr:i32=l1_parse(lines[i*L1LN..i*L1LN+ln2],ln2,pfw,i,ppl[i*L1PL..i*L1PL+L1PL],&on);
        if(pr!=0){pracc=1;}
        l1_pn_put(ppln,i,on);
        // parsed fields must equal generated fields (round-trip sanity)
        let k:i32=0;
        while(k<6){if(l1_fw_get(pfw,i,k)!=l1_fw_get(fw,i,k)){pracc=1;}k=k+1;}
        i=i+1;
    }
    f=f+l1_emit("L1a","roundtrip_ok",pracc,0);
    let trips:i32=0;let tripmap:i32=0;
    i=0;
    while(i<L1N){
        let v:i32=l1_verify_one(1,i,pfw,ppl,ppln,lk);
        if(v==0){trips=trips+1;tripmap=tripmap+(1<<i);}
        i=i+1;
    }
    f=f+l1_emit("L1a","honest_trips",trips,5);
    // entries 2,4,6,9,11 = bits -> 4+16+64+512+2048 = 2644
    f=f+l1_emit("L1a","trip_bitmap",tripmap,2644);

    // ---- L1b: lesson canonicalization (mode 1); whitespace-only mutations must NOT verify,
    //          but the lesson predicts they DO (false negative) ----
    f=f+l1_emit("L1b","gen_rc",l1_gen_chain(1,fw,pl,pln,lk),0);
    // re-parse fresh (pfw/ppl/ppln reused)
    let prb:i32=0;
    i=0;
    while(i<L1N){
        let p:[]u8=pl[i*L1PL..i*L1PL+l1_pn_get(pln,i)];
        let ln2:i32=l1_serialize(fw,i,p,lines[i*L1LN..i*L1LN+L1LN]);
        let on:i32=0;
        let pr2:i32=l1_parse(lines[i*L1LN..i*L1LN+ln2],ln2,pfw,i,ppl[i*L1PL..i*L1PL+L1PL],&on);
        if(pr2!=0){prb=1;}
        l1_pn_put(ppln,i,on);
        i=i+1;
    }
    f=f+l1_emit("L1b","roundtrip_ok",prb,0);
    // mutate entry 3: "pin slot 5" -> "pin  slot 5" (double space)
    let m3:[]u8=ppl[3*L1PL..3*L1PL+L1PL];
    // "pin slot 5": insert extra space at index 4 -> shift right by 1
    let l3:i32=l1_pn_get(ppln,3);
    let j:i32=l3;
    while(j>4){m3[j]=m3[j-1];j=j-1;}
    m3[4]=32;l1_pn_put(ppln,3,l3+1);
    // mutate entry 7: "promote S" -> "promote\nS" (newline collapses to space)
    let m7:[]u8=ppl[7*L1PL..7*L1PL+L1PL];
    m7[7]=10;
    // control mutation entry 5: "quarantine U" -> "quarantine X" (non-whitespace)
    let m5:[]u8=ppl[5*L1PL..5*L1PL+L1PL];
    m5[11]=88;
    let v3:i32=l1_verify_one(1,3,pfw,ppl,ppln,lk);
    let v7:i32=l1_verify_one(1,7,pfw,ppl,ppln,lk);
    let v5:i32=l1_verify_one(1,5,pfw,ppl,ppln,lk);
    // kill bar: whitespace mutations verifying = FALSE NEGATIVE (expect 1,1 = killed);
    // control letter-flip must fail (expect 0)
    f=f+l1_emit("L1b","ws_mut3_verifies",v3,1);
    f=f+l1_emit("L1b","ws_mut7_verifies",v7,1);
    f=f+l1_emit("L1b","letter_mut5_verifies",v5,0);

    // ---- L1c: strict canonicalization (mode 2): honest all verify, every mutation fails ----
    f=f+l1_emit("L1c","gen_rc",l1_gen_chain(2,fw,pl,pln,lk),0);
    let prc:i32=0;
    i=0;
    while(i<L1N){
        let p:[]u8=pl[i*L1PL..i*L1PL+l1_pn_get(pln,i)];
        let ln2:i32=l1_serialize(fw,i,p,lines[i*L1LN..i*L1LN+L1LN]);
        let on:i32=0;
        let pr3:i32=l1_parse(lines[i*L1LN..i*L1LN+ln2],ln2,pfw,i,ppl[i*L1PL..i*L1PL+L1PL],&on);
        if(pr3!=0){prc=1;}
        l1_pn_put(ppln,i,on);
        i=i+1;
    }
    f=f+l1_emit("L1c","roundtrip_ok",prc,0);
    let okc:i32=0;
    i=0;
    while(i<L1N){okc=okc+l1_verify_one(2,i,pfw,ppl,ppln,lk);i=i+1;}
    f=f+l1_emit("L1c","honest_verify",okc,12);
    // mutations: byte flip, whitespace add, quote add, backslash add
    let q0:[]u8=ppl[0*L1PL..0*L1PL+L1PL];q0[0]=116;           // 's'->'t'
    let q1:[]u8=ppl[1*L1PL..1*L1PL+L1PL];                     // "deny access" -> "deny  access"
    let lq1:i32=l1_pn_get(ppln,1);let jj:i32=lq1;
    while(jj>5){q1[jj]=q1[jj-1];jj=jj-1;}
    q1[5]=32;l1_pn_put(ppln,1,lq1+1);
    let q2:[]u8=ppl[2*L1PL..2*L1PL+L1PL];q2[0]=34;            // quote overwrite
    let q4:[]u8=ppl[4*L1PL..4*L1PL+L1PL];q4[0]=92;            // backslash overwrite
    let mv:i32=0;
    mv=mv+l1_verify_one(2,0,pfw,ppl,ppln,lk);
    mv=mv+l1_verify_one(2,1,pfw,ppl,ppln,lk);
    mv=mv+l1_verify_one(2,2,pfw,ppl,ppln,lk);
    mv=mv+l1_verify_one(2,4,pfw,ppl,ppln,lk);
    f=f+l1_emit("L1c","mutated_verify",mv,0);

    // ---- L1d: adapter-exact formula over 24-byte word entries with 0x22/0x5C bytes ----
    let e:[]u8=sh_alloc(3*24);
    let dgl:[]u8=sh_alloc(3*32);
    i=0;
    while(i<3){
        let t2:i32=0;
        while(t2<24){e[i*24+t2]=((i*24+t2)&255) as u8;t2=t2+1;}
        i=i+1;
    }
    e[1*24+3]=34;e[1*24+10]=92;   // '"' and '\' inside the hashed words
    i=0;
    while(i<3){
        let pv2:[]u8=sh_alloc(32);
        if(i>0){let t2:i32=0;while(t2<32){pv2[t2]=dgl[(i-1)*32+t2];t2=t2+1;}}
        let dg2:[]u8=sh_alloc(32);
        let lr:i32=l1d_link(i,pv2,e[i*24..i*24+24],dg2);
        f=f+l1_emit("L1d","link_rc",lr,0);
        let t2:i32=0;while(t2<32){dgl[i*32+t2]=dg2[t2];t2=t2+1;}
        sh_free(pv2);sh_free(dg2);
        i=i+1;
    }
    // verify all 3
    let dok:i32=0;
    i=0;
    while(i<3){
        let pv2:[]u8=sh_alloc(32);
        if(i>0){let t2:i32=0;while(t2<32){pv2[t2]=dgl[(i-1)*32+t2];t2=t2+1;}}
        let dg2:[]u8=sh_alloc(32);
        l1d_link(i,pv2,e[i*24..i*24+24],dg2);
        if(l1_memeq(dg2,dgl[i*32..i*32+32],32)==1){dok=dok+1;}
        sh_free(pv2);sh_free(dg2);
        i=i+1;
    }
    f=f+l1_emit("L1d","honest_verify",dok,3);
    e[2*24+5]=e[2*24+5]^1;   // 1-byte mutation
    let pv3:[]u8=sh_alloc(32);
    let t3:i32=0;while(t3<32){pv3[t3]=dgl[1*32+t3];t3=t3+1;}
    let dg3:[]u8=sh_alloc(32);
    l1d_link(2,pv3,e[2*24..2*24+24],dg3);
    f=f+l1_emit("L1d","mutated_verifies",l1_memeq(dg3,dgl[2*32..2*32+32],32),0);
    sh_free(pv3);sh_free(dg3);

    sh_free(fw);sh_free(pl);sh_free(pln);sh_free(lk);
    sh_free(lines);sh_free(pfw);sh_free(ppl);sh_free(ppln);
    sh_free(e);sh_free(dgl);
    _zag_print("L1_FAILURES,");
    let fs:[]u8=sh_alloc(12);let fn2:i32=0;l1_putdec(fs,&fn2,f);
    _zag_println(fs[0..fn2]);sh_free(fs);
    if(f!=0){return 1;}
    return 0;
}

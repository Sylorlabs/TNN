// l2_checkpoint.zag — L2: checkpoint replay from midpoint vs genesis.
//
// Frozen §1.2: checkpoints let the brain resume after interruption; H-OB-47
// covered a MUTATED-prefix replay (EXT splice). This attack leaves the audit
// prefix byte-identical and asks whether an HONEST midpoint snapshot +
// tail-only replay reproduces genesis replay. The ledger binds no snapshot
// bytes and no checkpoint identities: mm_checkpoint's audit entry carries
// b1=b2=d1=d2=0, and rollback targets the implicit "most recent checkpoint".
//
// Script (deterministic, zero RNG) on a real Variant B MEM organ:
//   phase 1: stage->FULL, ADD 1,2,3, PIN 1, CHECKPOINT C1, ADD 4, PROMOTE 2,
//            CHECKPOINT C2, MIDPOINT snapshot M (=C2 state, honest)
//   phase 2: ADD 5, KILL 4, ROLLBACK (->C2, pre-midpoint), ADD 6,
//            CHECKPOINT C3, ADD 7, ROLLBACK (->C3)
// Legs:
//   L2a sanity: genesis mm_replay == live final state (expect equal).
//   L2b kill: honest-M + tail-only replay vs genesis (expect DIFFER: the
//         tail's first ROLLBACK targets pre-midpoint C2, which tail replay
//         never snapshotted -> restores zeroed buffers, wiping CORE too).
//   L2c kill: forged sidecar snapshot + mm_rollback steers live state with
//         an audit entry byte-identical to an honest rollback's.
//   L2d finding: two checkpoints sharing one buffer triple; rollback lands
//         on the second — the ledger cannot say which checkpoint was meant.
@import("ob_mem.zag")
@import("sha256.zag")

fn l2_putdec(b:[]u8,n:*i32,v:i32)void {
    if(v<0){b[n.*]=45;n.*=n.*+1;v=0-v;}
    let t:[]u8=ob_alloc(12);let c:i32=0;
    if(v==0){t[0]=48;c=1;}
    while(v>0){t[c]=(48+v%10) as u8;c=c+1;v=v/10;}
    let i:i32=c-1;
    while(i>=0){b[n.*]=t[i];n.*=n.*+1;i=i-1;}
    ob_free(t);
    return;
}
fn l2_emit(tag:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    let b:[]u8=ob_alloc(160);let n:i32=0;let i:i32=0;
    while(i<tag.len){b[n]=tag[i];n=n+1;i=i+1;}
    b[n]=44;n=n+1;i=0;
    while(i<name.len){b[n]=name[i];n=n+1;i=i+1;}
    b[n]=44;n=n+1;
    l2_putdec(b,&n,actual);b[n]=44;n=n+1;l2_putdec(b,&n,expected);
    _zag_println(b[0..n]);
    ob_free(b);
    if(actual!=expected){return 1;}
    return 0;
}
// state digest: SHA-256 over live|value|pinned|region|tier|step
fn l2_digest(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,dg:[]u8)void {
    let buf:[]u8=ob_alloc(3072);
    let i:i32=0;
    while(i<256){buf[i]=live[i];buf[256+i]=pinned[i];buf[512+i]=region[i];buf[768+i]=tier[i];i=i+1;}
    i=0;
    while(i<1024){buf[1024+i]=value[i];buf[2048+i]=step[i];i=i+1;}
    ns_sha256(buf,dg);
    ob_free(buf);
    return;
}
fn l2_digeq(a:[]u8,b:[]u8)i32 {
    let i:i32=0;while(i<32){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn l2_show(tag:[]u8,dg:[]u8)void {
    let hx:[]u8=ns_hex32(dg);
    let b:[]u8=ob_alloc(96);let n:i32=0;let i:i32=0;
    while(i<tag.len){b[n]=tag[i];n=n+1;i=i+1;}
    b[n]=44;n=n+1;i=0;
    while(i<64){b[n]=hx[i];n=n+1;i=i+1;}
    _zag_println(b[0..n]);
    ob_free(b);sh_free(hx);
    return;
}
// tail-only replay: restore honest midpoint snapshot, apply audit[n0..n)
// with mm_replay-exact per-op logic (checkpoint bufs start zeroed).
fn l2_tail_replay(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8,n0:i32,s1:[]u8,s2:[]u8,s3:[]u8)void {
    mm_restore(live,value,pinned,region,tier,step,s1,s2,s3);
    let t1:[]u8=ob_alloc(MA_CAP*4);let t2:[]u8=ob_alloc(MA_CAP*4);let t3:[]u8=ob_alloc(MA_CAP*4);
    let n:i32=ob_g32(hdr,8);
    let i:i32=n0;
    while(i<n){
        let e:i32=i*MA_EW*4;
        let op:i32=ob_g32(audit,e+4);
        let slot:i32=ob_g32(audit,e+8);
        let rc:i32=ob_g32(audit,e+12);
        if(rc==MA_OK){
            if(op==MA_OP_ADD && slot>=0){
                live[slot]=1;
                ob_s32(value,slot*4,ob_g32(audit,e+36));
                region[slot]=ob_g32(audit,e+16);
                tier[slot]=MA_TIER_WORKING;
                ob_s32(step,slot*4,ob_g32(audit,e));
            }
            if(op==MA_OP_KILL && slot>=0){live[slot]=0;}
            if(op==MA_OP_PIN && slot>=0){
                let k:i32=ob_g32(audit,e+36);
                if(k==0){k=MA_PIN_LEARNER;}
                pinned[slot]=k;
            }
            if(op==MA_OP_UNPIN && slot>=0){pinned[slot]=0;}
            if(op==MA_OP_PROMOTE && slot>=0){region[slot]=MA_REGION_LONG;}
            if(op==MA_OP_DEMOTE && slot>=0){region[slot]=MA_REGION_USER;}
            if(op==MA_OP_CHECKPOINT){mm_snap(live,value,pinned,region,tier,step,t1,t2,t3);}
            if(op==MA_OP_ROLLBACK){mm_restore(live,value,pinned,region,tier,step,t1,t2,t3);}
        }
        i=i+1;
    }
    ob_free(t1);ob_free(t2);ob_free(t3);
    return;
}

fn main()i32 {
    let f:i32=0;
    // ---- organ1: the live brain ----
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let audit:[]u8=mm_new_audit();let hdr:[]u8=mm_new_hdr();
    let A1:[]u8=ob_alloc(1024);let A2:[]u8=ob_alloc(1024);let A3:[]u8=ob_alloc(1024);
    let B1:[]u8=ob_alloc(1024);let B2:[]u8=ob_alloc(1024);let B3:[]u8=ob_alloc(1024);
    let M1:[]u8=ob_alloc(1024);let M2:[]u8=ob_alloc(1024);let M3:[]u8=ob_alloc(1024);
    let C1:[]u8=ob_alloc(1024);let C2:[]u8=ob_alloc(1024);let C3:[]u8=ob_alloc(1024);
    let sl:i32=0;let bad:i32=0;
    if(mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr)!=0){bad=1;}
    if(mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr)!=0){bad=1;}
    if(mm_add(live,value,pinned,region,tier,step,audit,hdr,103,0,&sl)!=0){bad=1;}
    if(sl!=1){bad=1;}
    if(mm_add(live,value,pinned,region,tier,step,audit,hdr,213,1,&sl)!=0){bad=1;}
    if(sl!=2){bad=1;}
    if(mm_pin(live,value,pinned,region,tier,step,audit,hdr,1)!=0){bad=1;}
    if(mm_checkpoint(live,value,pinned,region,tier,step,audit,hdr,A1,A2,A3)!=0){bad=1;}
    if(mm_add(live,value,pinned,region,tier,step,audit,hdr,307,0,&sl)!=0){bad=1;}
    if(sl!=3){bad=1;}
    if(mm_promote(live,value,pinned,region,tier,step,audit,hdr,2)!=0){bad=1;}
    if(mm_checkpoint(live,value,pinned,region,tier,step,audit,hdr,B1,B2,B3)!=0){bad=1;}
    // MIDPOINT: honest sidecar snapshot + audit cursor
    mm_snap(live,value,pinned,region,tier,step,M1,M2,M3);
    let n_mid:i32=ob_g32(hdr,8);
    // phase 2 (tail)
    if(mm_add(live,value,pinned,region,tier,step,audit,hdr,401,0,&sl)!=0){bad=1;}
    if(sl!=4){bad=1;}
    if(mm_kill(live,value,pinned,region,tier,step,audit,hdr,3)!=0){bad=1;}
    if(mm_rollback(live,value,pinned,region,tier,step,audit,hdr,B1,B2,B3)!=0){bad=1;}
    if(mm_add(live,value,pinned,region,tier,step,audit,hdr,503,1,&sl)!=0){bad=1;}
    if(sl!=4){bad=1;}
    if(mm_checkpoint(live,value,pinned,region,tier,step,audit,hdr,C1,C2,C3)!=0){bad=1;}
    if(mm_add(live,value,pinned,region,tier,step,audit,hdr,607,0,&sl)!=0){bad=1;}
    if(sl!=5){bad=1;}
    if(mm_rollback(live,value,pinned,region,tier,step,audit,hdr,C1,C2,C3)!=0){bad=1;}
    f=f+l2_emit("L2","script_ok",bad,0);
    f=f+l2_emit("L2","audit_n",ob_g32(hdr,8),16);

    let d_live:[]u8=ob_alloc(32);l2_digest(live,value,pinned,region,tier,step,d_live);
    l2_show("L2D,live",d_live);

    // ---- L2a: genesis replay ----
    let gl:[]u8=mm_new_live();let gv:[]u8=mm_new_value();let gp:[]u8=mm_new_pinned();
    let gr:[]u8=mm_new_region();let gt:[]u8=mm_new_tier();let gs:[]u8=mm_new_step();
    f=f+l2_emit("L2a","replay_rc",mm_replay(gl,gv,gp,gr,gt,gs,audit,hdr),0);
    let d_gen:[]u8=ob_alloc(32);l2_digest(gl,gv,gp,gr,gt,gs,d_gen);
    l2_show("L2D,genesis",d_gen);
    f=f+l2_emit("L2a","genesis_eq_live",l2_digeq(d_live,d_gen),1);

    // ---- L2b: honest midpoint snapshot + tail-only replay ----
    let tl:[]u8=mm_new_live();let tv:[]u8=mm_new_value();let tp:[]u8=mm_new_pinned();
    let tr:[]u8=mm_new_region();let tt:[]u8=mm_new_tier();let ts:[]u8=mm_new_step();
    l2_tail_replay(tl,tv,tp,tr,tt,ts,audit,hdr,n_mid,M1,M2,M3);
    let d_tail:[]u8=ob_alloc(32);l2_digest(tl,tv,tp,tr,tt,ts,d_tail);
    l2_show("L2D,tail",d_tail);
    f=f+l2_emit("L2b","tail_eq_genesis",l2_digeq(d_tail,d_gen),0);
    f=f+l2_emit("L2b","tail_core_wiped",tl[0],0);

    // ---- L2c: forged sidecar ----
    let F1:[]u8=ob_alloc(1024);let F2:[]u8=ob_alloc(1024);let F3:[]u8=ob_alloc(1024);
    let ci:i32=0;
    while(ci<1024){F1[ci]=C1[ci];F2[ci]=C2[ci];F3[ci]=C3[ci];ci=ci+1;}
    ob_s32(F1,7*4,1);          // slot 7: live=1
    ob_s32(F2,7*4,99999);      // slot 7: value=99999 (never audited)
    let n_forge:i32=ob_g32(hdr,8);
    f=f+l2_emit("L2c","forge_rollback_rc",mm_rollback(live,value,pinned,region,tier,step,audit,hdr,F1,F2,F3),0);
    let forged_ok:i32=0;
    if(live[7]==1 && ob_g32(value,7*4)==99999){forged_ok=1;}
    f=f+l2_emit("L2c","forged_state_live",forged_ok,1);
    let d_forged:[]u8=ob_alloc(32);l2_digest(live,value,pinned,region,tier,step,d_forged);
    l2_show("L2D,forged",d_forged);
    f=f+l2_emit("L2c","forged_eq_genesis",l2_digeq(d_forged,d_gen),0);
    // the forged rollback's audit entry carries no snapshot bytes ...
    let ef:i32=n_forge*MA_EW*4;
    let ebind:i32=0;
    if(ob_g32(audit,ef+4)==MA_OP_ROLLBACK && ob_g32(audit,ef+8)==-1 &&
       ob_g32(audit,ef+16)==0 && ob_g32(audit,ef+20)==0 &&
       ob_g32(audit,ef+36)==0 && ob_g32(audit,ef+40)==0){ebind=1;}
    f=f+l2_emit("L2c","forge_entry_unbound",ebind,1);
    // ... and is byte-identical to an honest rollback's entry
    f=f+l2_emit("L2c","honest_rollback_rc",mm_rollback(live,value,pinned,region,tier,step,audit,hdr,C1,C2,C3),0);
    let eh:i32=(n_forge+1)*MA_EW*4;
    let esame:i32=1;ci=0;
    while(ci<MA_EW*4){if(audit[ef+ci]!=audit[eh+ci]){esame=0;}ci=ci+1;}
    f=f+l2_emit("L2c","forge_entry_eq_honest",esame,1);
    // machine check: NO checkpoint entry anywhere binds snapshot bytes
    let ck:i32=0;let ckbad:i32=0;let an:i32=ob_g32(hdr,8);
    while(ck<an){
        let ee:i32=ck*MA_EW*4;
        if(ob_g32(audit,ee+4)==MA_OP_CHECKPOINT){
            if(ob_g32(audit,ee+16)!=0 || ob_g32(audit,ee+20)!=0 ||
               ob_g32(audit,ee+36)!=0 || ob_g32(audit,ee+40)!=0){ckbad=1;}
        }
        ck=ck+1;
    }
    f=f+l2_emit("L2c","no_ckpt_binds_bytes",ckbad,0);

    // ---- L2d: nested checkpoints sharing one buffer triple ----
    let o2l:[]u8=mm_new_live();let o2v:[]u8=mm_new_value();let o2p:[]u8=mm_new_pinned();
    let o2r:[]u8=mm_new_region();let o2t:[]u8=mm_new_tier();let o2s:[]u8=mm_new_step();
    let o2a:[]u8=mm_new_audit();let o2h:[]u8=mm_new_hdr();
    let S1:[]u8=ob_alloc(1024);let S2:[]u8=ob_alloc(1024);let S3:[]u8=ob_alloc(1024);
    let bad2:i32=0;let sl2:i32=0;
    if(mm_advance_stage(o2l,o2v,o2p,o2r,o2t,o2s,o2a,o2h)!=0){bad2=1;}
    if(mm_advance_stage(o2l,o2v,o2p,o2r,o2t,o2s,o2a,o2h)!=0){bad2=1;}
    if(mm_add(o2l,o2v,o2p,o2r,o2t,o2s,o2a,o2h,11,0,&sl2)!=0){bad2=1;}
    if(mm_checkpoint(o2l,o2v,o2p,o2r,o2t,o2s,o2a,o2h,S1,S2,S3)!=0){bad2=1;}   // C_a
    if(mm_add(o2l,o2v,o2p,o2r,o2t,o2s,o2a,o2h,22,0,&sl2)!=0){bad2=1;}
    if(sl2!=2){bad2=1;}
    if(mm_checkpoint(o2l,o2v,o2p,o2r,o2t,o2s,o2a,o2h,S1,S2,S3)!=0){bad2=1;}   // C_b overwrites C_a
    if(mm_kill(o2l,o2v,o2p,o2r,o2t,o2s,o2a,o2h,2)!=0){bad2=1;}
    if(mm_rollback(o2l,o2v,o2p,o2r,o2t,o2s,o2a,o2h,S1,S2,S3)!=0){bad2=1;}
    f=f+l2_emit("L2d","script_ok",bad2,0);
    f=f+l2_emit("L2d","rollback_hit_second_ckpt",o2l[2],1);
    let an2:i32=ob_g32(o2h,8);
    // count checkpoint entries properly
    let nck:i32=0;let ck2:i32=0;
    while(ck2<an2){
        if(ob_g32(o2a,ck2*MA_EW*4+4)==MA_OP_CHECKPOINT){nck=nck+1;}
        ck2=ck2+1;
    }
    f=f+l2_emit("L2d","ckpt_entries",nck,2);

    _zag_print("L2_FAILURES,");
    let fs:[]u8=ob_alloc(12);let fn2:i32=0;l2_putdec(fs,&fn2,f);
    _zag_println(fs[0..fn2]);ob_free(fs);
    if(f!=0){return 1;}
    return 0;
}

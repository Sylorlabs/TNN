// l3_clock.zag — L3: audit-clock backdating and phase-gate impact.
//
// The MEM audit entry's clock ("step") is mm_audit_append's ob_g32(hdr,4) —
// caller-supplied, never validated for monotonicity. The clock is initialized
// to zero and nothing in Variant B ever advances it. Machine-checked (grep):
// the ONLY consumers of the clock are record-writes into the step[] array
// (mm_add, mm_replay); no gate, comparison, or adjudication reads it.
//
// Legs:
//   L3a: honest entries all carry clock 0 (scan).
//   L3b: set 500 / backdate 7 / future 999999 / negative -5 — every entry
//        accepted (rc==0), clocks stored verbatim, ledger non-monotonic.
//   L3c: real Variant B inert — replay of the gamed audit vs a clock-zeroed
//        copy: all state arrays except step[] identical; clean-refusals
//        unchanged. (Kill-bar second half NOT met in real code: accepted but
//        inert — reported as a split, per prereg.)
//   L3d: REFERENCE gates (labeled; not Variant B) that consume the clock:
//        G1 quarantine-expiry (future-dated entry releases early),
//        G3 ledger-monotonicity promotion finality (backdated entry denies
//        legitimate promotions). Each: accepted AND alters outcome -> the
//        inherited risk if future governance uses this clock.
@import("ob_mem.zag")

fn l3_putdec(b:[]u8,n:*i32,v:i32)void {
    if(v<0){b[n.*]=45;n.*=n.*+1;v=0-v;}
    let t:[]u8=ob_alloc(12);let c:i32=0;
    if(v==0){t[0]=48;c=1;}
    while(v>0){t[c]=(48+v%10) as u8;c=c+1;v=v/10;}
    let i:i32=c-1;
    while(i>=0){b[n.*]=t[i];n.*=n.*+1;i=i-1;}
    ob_free(t);
    return;
}
fn l3_emit(tag:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    let b:[]u8=ob_alloc(160);let n:i32=0;let i:i32=0;
    while(i<tag.len){b[n]=tag[i];n=n+1;i=i+1;}
    b[n]=44;n=n+1;i=0;
    while(i<name.len){b[n]=name[i];n=n+1;i=i+1;}
    b[n]=44;n=n+1;
    l3_putdec(b,&n,actual);b[n]=44;n=n+1;l3_putdec(b,&n,expected);
    _zag_println(b[0..n]);
    ob_free(b);
    if(actual!=expected){return 1;}
    return 0;
}
// ---- REFERENCE gates (not Variant B; labeled as such in output) ----
fn ref_max_clock(audit:[]u8,hdr:[]u8)i32 {
    let m:i32=-2147483647;let n:i32=ob_g32(hdr,8);let i:i32=0;
    while(i<n){
        let c:i32=ob_g32(audit,i*MA_EW*4);
        if(i==0 || c>m){m=c;}
        i=i+1;
    }
    return m;
}
// G1: quarantine releases iff the ledger's max clock >= expiry
fn ref_quarantine_released(audit:[]u8,hdr:[]u8,expiry:i32)i32 {
    if(ref_max_clock(audit,hdr)>=expiry){return 1;}
    return 0;
}
// G3: promotion finality requires a non-decreasing clock ledger
fn ref_ledger_monotonic(audit:[]u8,hdr:[]u8)i32 {
    let n:i32=ob_g32(hdr,8);let i:i32=1;
    while(i<n){
        let a:i32=ob_g32(audit,(i-1)*MA_EW*4);
        let b:i32=ob_g32(audit,i*MA_EW*4);
        if(b<a){return 0;}
        i=i+1;
    }
    return 1;
}
fn l3_entry_clock(audit:[]u8,idx:i32)i32 {
    return ob_g32(audit,idx*MA_EW*4);
}

fn main()i32 {
    let f:i32=0;
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let stepa:[]u8=mm_new_step();
    let audit:[]u8=mm_new_audit();let hdr:[]u8=mm_new_hdr();
    let sl:i32=0;let bad:i32=0;
    if(mm_advance_stage(live,value,pinned,region,tier,stepa,audit,hdr)!=0){bad=1;}
    if(mm_advance_stage(live,value,pinned,region,tier,stepa,audit,hdr)!=0){bad=1;}
    if(mm_add(live,value,pinned,region,tier,stepa,audit,hdr,11,0,&sl)!=0){bad=1;}
    if(mm_add(live,value,pinned,region,tier,stepa,audit,hdr,22,0,&sl)!=0){bad=1;}
    if(mm_pin(live,value,pinned,region,tier,stepa,audit,hdr,1)!=0){bad=1;}
    f=f+l3_emit("L3","script_ok",bad,0);

    // ---- L3a: honest clocks all zero ----
    let n0:i32=ob_g32(hdr,8);
    let allz:i32=1;let i:i32=0;
    while(i<n0){if(l3_entry_clock(audit,i)!=0){allz=0;}i=i+1;}
    f=f+l3_emit("L3a","audit_n",n0,5);
    f=f+l3_emit("L3a","honest_clocks_zero",allz,1);
    // G1 before any dating: quarantine (expiry 1000) holds
    f=f+l3_emit("L3d","G1_honest_holds",ref_quarantine_released(audit,hdr,1000),0);
    // G3 before any dating: ledger monotonic
    f=f+l3_emit("L3d","G3_honest_monotonic",ref_ledger_monotonic(audit,hdr),1);

    // ---- L3b: clock games; every entry accepted ----
    let acc:i32=1;
    ob_s32(hdr,4,500);
    if(mm_add(live,value,pinned,region,tier,stepa,audit,hdr,33,0,&sl)!=MA_OK){acc=0;}
    let e500:i32=ob_g32(hdr,8)-1;
    ob_s32(hdr,4,7);   // backdate
    if(mm_add(live,value,pinned,region,tier,stepa,audit,hdr,44,0,&sl)!=MA_OK){acc=0;}
    let e7:i32=ob_g32(hdr,8)-1;
    ob_s32(hdr,4,999999);   // future
    if(mm_add(live,value,pinned,region,tier,stepa,audit,hdr,55,0,&sl)!=MA_OK){acc=0;}
    let e999:i32=ob_g32(hdr,8)-1;
    ob_s32(hdr,4,-5);   // negative
    if(mm_add(live,value,pinned,region,tier,stepa,audit,hdr,66,0,&sl)!=MA_OK){acc=0;}
    let eneg:i32=ob_g32(hdr,8)-1;
    f=f+l3_emit("L3b","all_accepted",acc,1);
    f=f+l3_emit("L3b","clock_500_stored",l3_entry_clock(audit,e500),500);
    f=f+l3_emit("L3b","backdate_7_stored",l3_entry_clock(audit,e7),7);
    f=f+l3_emit("L3b","future_999999_stored",l3_entry_clock(audit,e999),999999);
    f=f+l3_emit("L3b","negative_-5_stored",l3_entry_clock(audit,eneg),-5);
    f=f+l3_emit("L3b","ledger_monotonic_now",ref_ledger_monotonic(audit,hdr),0);

    // ---- L3c: real Variant B inert ----
    // replay gamed audit vs clock-zeroed copy; compare all arrays but step[]
    let an:i32=ob_g32(hdr,8);
    let audit0:[]u8=ob_alloc(MA_ACAP*MA_EW*4);
    i=0;
    while(i<an*MA_EW*4){audit0[i]=audit[i];i=i+1;}
    i=0;
    while(i<an){ob_s32(audit0,i*MA_EW*4,0);i=i+1;}
    let hdr0:[]u8=mm_new_hdr();
    ob_s32(hdr0,0,ob_g32(hdr,0));ob_s32(hdr0,8,an);
    let a1l:[]u8=mm_new_live();let a1v:[]u8=mm_new_value();let a1p:[]u8=mm_new_pinned();
    let a1r:[]u8=mm_new_region();let a1t:[]u8=mm_new_tier();let a1s:[]u8=mm_new_step();
    let b1l:[]u8=mm_new_live();let b1v:[]u8=mm_new_value();let b1p:[]u8=mm_new_pinned();
    let b1r:[]u8=mm_new_region();let b1t:[]u8=mm_new_tier();let b1s:[]u8=mm_new_step();
    mm_replay(a1l,a1v,a1p,a1r,a1t,a1s,audit,hdr);
    mm_replay(b1l,b1v,b1p,b1r,b1t,b1s,audit0,hdr0);
    let same:i32=1;
    i=0;
    while(i<256){
        if(a1l[i]!=b1l[i]){same=0;}
        if(a1p[i]!=b1p[i]){same=0;}
        if(a1r[i]!=b1r[i]){same=0;}
        if(a1t[i]!=b1t[i]){same=0;}
        i=i+1;
    }
    i=0;
    while(i<1024){
        if(a1v[i]!=b1v[i]){same=0;}
        i=i+1;
    }
    f=f+l3_emit("L3c","replay_state_eq_except_step",same,1);
    f=f+l3_emit("L3c","clean_refusals_same",
        mm_check_clean_refusals(audit,hdr)-mm_check_clean_refusals(audit0,hdr0),0);

    // ---- L3d: REFERENCE gates change outcome on accepted dated entries ----
    // G1: future-dated entry releases quarantine early (accepted AND alters outcome)
    f=f+l3_emit("L3d","G1_future_releases",ref_quarantine_released(audit,hdr,1000),1);
    // G3: backdated entry breaks monotonicity -> promotion finality denied,
    // while the real organ still promotes (rc 0): the gate outcome changed.
    let prc:i32=mm_promote(live,value,pinned,region,tier,stepa,audit,hdr,2);
    f=f+l3_emit("L3d","real_promote_rc",prc,0);
    f=f+l3_emit("L3d","G3_promote_finalized",ref_ledger_monotonic(audit,hdr),0);

    _zag_print("L3_FAILURES,");
    let fs:[]u8=ob_alloc(12);let fn2:i32=0;l3_putdec(fs,&fn2,f);
    _zag_println(fs[0..fn2]);ob_free(fs);
    if(f!=0){return 1;}
    return 0;
}

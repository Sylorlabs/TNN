// l4_flood.zag — L4: 10,000-entry escalation/governance flood.
//
// No ESCALATE path exists in Variant B (PAM is binary WITHHOLD/ADMIT;
// OB_PROTOCOL.md: "the arbiter does not retry, escalate, or route dropped
// work"), so this driver machine-checks that premise and attacks the real
// governance surfaces: the arbiter queue (force-pin delivery), the PAM
// observation table, and the PAM disposition ledger.
//
// Legs:
//   L4a: 10,000 valid junk arbiter messages (M_DISCONNECT), drained in FIFO
//        batches; all processed; arbiter audit log caps at 1024 -> 8,976
//        processed messages with no audit record.
//   L4b: 255 junk + genuine M_FORCE_PIN (queue slot 255) -> accepted:
//        enqueue rc 0, force-pin applied (pinned[7]==MA_PIN_FORCE), audited.
//   L4d: 256 junk + genuine M_FORCE_PIN -> enqueue rc -1, silently dropped:
//        pin never applied, zero audit trace of the genuine governance action.
//   L4d: PAM observations: 64 junk fill the table; the genuine (bars-passing)
//        observation -> pam_observe returns -1. Contrast: on a fresh PAM the
//        same observation lands at slot 0 and earns ADMIT.
//   L4e: 301 pam_verdict calls on one slot -> all return rc 0 with a verdict,
//        but the disposition ledger caps at 256: calls 257..301 unlogged.
// Pure Zag, zero RNG.
@import("ob_arbiter.zag")

fn l4_putdec(b:[]u8,n:*i32,v:i32)void {
    if(v<0){b[n.*]=45;n.*=n.*+1;v=0-v;}
    let t:[]u8=ob_alloc(12);let c:i32=0;
    if(v==0){t[0]=48;c=1;}
    while(v>0){t[c]=(48+v%10) as u8;c=c+1;v=v/10;}
    let i:i32=c-1;
    while(i>=0){b[n.*]=t[i];n.*=n.*+1;i=i-1;}
    ob_free(t);
    return;
}
fn l4_emit(tag:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    let b:[]u8=ob_alloc(160);let n:i32=0;let i:i32=0;
    while(i<tag.len){b[n]=tag[i];n=n+1;i=i+1;}
    b[n]=44;n=n+1;i=0;
    while(i<name.len){b[n]=name[i];n=n+1;i=i+1;}
    b[n]=44;n=n+1;
    l4_putdec(b,&n,actual);b[n]=44;n=n+1;l4_putdec(b,&n,expected);
    _zag_println(b[0..n]);
    ob_free(b);
    if(actual!=expected){return 1;}
    return 0;
}
// count arbiter audit entries with a given code
fn l4_alog_count(alog:[]u8,aln:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<aln){if(ob_g32(alog,i*16+4)==code){c=c+1;}i=i+1;}
    return c;
}
// bring a MEM organ to FULL with slots 1..7 live; returns 0 ok
fn l4_organ_ready(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    audit:[]u8,hdr:[]u8)i32 {
    if(mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr)!=0){return 1;}
    if(mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr)!=0){return 2;}
    let sl:i32=0;let k:i32=0;
    while(k<7){
        if(mm_add(live,value,pinned,region,tier,step,audit,hdr,100+k,0,&sl)!=0){return 3;}
        k=k+1;
    }
    if(sl!=7){return 4;}
    return 0;
}
// one bars-passing PAM observation; returns the slot or -1
fn l4_genuine_observe(pam:[]u8,ep:i32)i32 {
    return pam_observe(pam,5,5,800,800,1,11,22,7,350,350,350,ep);
}

fn main()i32 {
    let f:i32=0;
    // ---------------- L4a: 10,000 valid junk messages ----------------
    let aq:[]u8=ob_msgq_init(ARB_QCAP);let aqn:i32=0;
    let aast:[]u8=arb_new_state();let aroutes:[]u8=arb_new_routes();
    let aalog:[]u8=ob_alloc(ARB_ACAP*16);let aaln:i32=0;
    let apam:[]u8=pam_new();let afl2:[]u8=ob_alloc(16);
    let alive:[]u8=mm_new_live();let avalue:[]u8=mm_new_value();
    let apinned:[]u8=mm_new_pinned();let aregion:[]u8=mm_new_region();
    let atier:[]u8=mm_new_tier();let astep:[]u8=mm_new_step();
    let amaudit:[]u8=mm_new_audit();let ahdr:[]u8=mm_new_hdr();
    let atrust:[]u8=mm_new_trust();
    let sent:i32=0;let proctot:i32=0;
    while(sent<10000){
        if(aqn>=ARB_QCAP){
            proctot=proctot+aqn;
            arb_process(1,aq,&aqn,aast,aroutes,aalog,&aaln,apam,afl2,0,
                alive,avalue,apinned,aregion,atier,astep,amaudit,ahdr,atrust);
        }
        let rc:i32=ob_msg_enqueue(aq,&aqn,ARB_QCAP,1,sent,M_DISCONNECT,0,0);
        if(rc!=0){f=f+l4_emit("L4a","unexpected_enqueue_fail",rc,0);}
        sent=sent+1;
    }
    if(aqn>0){
        proctot=proctot+aqn;
        arb_process(1,aq,&aqn,aast,aroutes,aalog,&aaln,apam,afl2,0,
            alive,avalue,apinned,aregion,atier,astep,amaudit,ahdr,atrust);
    }
    f=f+l4_emit("L4a","junk_sent",sent,10000);
    f=f+l4_emit("L4a","junk_processed",proctot,10000);
    f=f+l4_emit("L4a","queue_empty",aqn,0);
    f=f+l4_emit("L4a","arbiter_audit_entries",aaln,1024);
    f=f+l4_emit("L4a","processed_but_unaudited",proctot-aaln,8976);

    // ---------------- L4b: 255 junk + force-pin at slot 255 -> accepted ----------------
    let bq:[]u8=ob_msgq_init(ARB_QCAP);let bqn:i32=0;
    let bast:[]u8=arb_new_state();let broutes:[]u8=arb_new_routes();
    let balog:[]u8=ob_alloc(ARB_ACAP*16);let baln:i32=0;
    let bpam:[]u8=pam_new();let bfl2:[]u8=ob_alloc(16);
    let blive:[]u8=mm_new_live();let bvalue:[]u8=mm_new_value();
    let bpinned:[]u8=mm_new_pinned();let bregion:[]u8=mm_new_region();
    let btier:[]u8=mm_new_tier();let bstep:[]u8=mm_new_step();
    let bmaudit:[]u8=mm_new_audit();let bhdr:[]u8=mm_new_hdr();
    let btrust:[]u8=mm_new_trust();
    f=f+l4_emit("L4b","organ_ready",l4_organ_ready(blive,bvalue,bpinned,bregion,btier,bstep,bmaudit,bhdr),0);
    let bi:i32=0;
    while(bi<255){
        ob_msg_enqueue(bq,&bqn,ARB_QCAP,2,bi,M_DISCONNECT,0,0);
        bi=bi+1;
    }
    let brc:i32=ob_msg_enqueue(bq,&bqn,ARB_QCAP,2,255,M_FORCE_PIN,7,0);
    f=f+l4_emit("L4b","pin_enqueue_rc",brc,0);
    arb_process(2,bq,&bqn,bast,broutes,balog,&baln,bpam,bfl2,0,
        blive,bvalue,bpinned,bregion,btier,bstep,bmaudit,bhdr,btrust);
    f=f+l4_emit("L4b","pin_applied",bpinned[7],MA_PIN_FORCE);
    f=f+l4_emit("L4b","pin_audited",l4_alog_count(balog,baln,M_FORCE_PIN),1);

    // ---------------- L4c: 256 junk + force-pin -> silently dropped (KILL) ----------------
    let cq:[]u8=ob_msgq_init(ARB_QCAP);let cqn:i32=0;
    let cast:[]u8=arb_new_state();let croutes:[]u8=arb_new_routes();
    let calog:[]u8=ob_alloc(ARB_ACAP*16);let caln:i32=0;
    let cpam:[]u8=pam_new();let cfl2:[]u8=ob_alloc(16);
    let clive:[]u8=mm_new_live();let cvalue:[]u8=mm_new_value();
    let cpinned:[]u8=mm_new_pinned();let cregion:[]u8=mm_new_region();
    let ctier:[]u8=mm_new_tier();let cstep:[]u8=mm_new_step();
    let cmaudit:[]u8=mm_new_audit();let chdr:[]u8=mm_new_hdr();
    let ctrust:[]u8=mm_new_trust();
    f=f+l4_emit("L4c","organ_ready",l4_organ_ready(clive,cvalue,cpinned,cregion,ctier,cstep,cmaudit,chdr),0);
    let ci:i32=0;
    while(ci<256){
        ob_msg_enqueue(cq,&cqn,ARB_QCAP,3,ci,M_DISCONNECT,0,0);
        ci=ci+1;
    }
    let crc:i32=ob_msg_enqueue(cq,&cqn,ARB_QCAP,3,256,M_FORCE_PIN,7,0);
    f=f+l4_emit("L4c","pin_enqueue_rc",crc,-1);
    arb_process(3,cq,&cqn,cast,croutes,calog,&caln,cpam,cfl2,0,
        clive,cvalue,cpinned,cregion,ctier,cstep,cmaudit,chdr,ctrust);
    f=f+l4_emit("L4c","pin_applied",cpinned[7],0);
    f=f+l4_emit("L4c","pin_audit_trace",l4_alog_count(calog,caln,M_FORCE_PIN),0);
    f=f+l4_emit("L4c","queue_drained",cqn,0);
    f=f+l4_emit("L4c","junk_audited",caln,256);

    // ---------------- L4d: PAM observation table flood ----------------
    let dpam:[]u8=pam_new();
    let di:i32=0;let dfail:i32=0;
    while(di<64){
        let s2:i32=pam_observe(dpam,1,1,800,800,1,1,2,7,350,350,350,di);
        if(s2!=di){dfail=1;}
        di=di+1;
    }
    f=f+l4_emit("L4d","junk_obs_ok",dfail,0);
    f=f+l4_emit("L4d","pam_n",pam_n(dpam),64);
    let genuine_rc:i32=l4_genuine_observe(dpam,100);
    f=f+l4_emit("L4d","genuine_observe_rc",genuine_rc,-1);
    // contrast: fresh PAM admits the same observation
    let d2pam:[]u8=pam_new();
    let gslot:i32=l4_genuine_observe(d2pam,100);
    f=f+l4_emit("L4d","fresh_pam_slot",gslot,0);
    let gv:i32=0;let gr2:i32=0;
    let grc:i32=pam_verdict(d2pam,gslot,PAM_MODE_FRESH,&gv,&gr2);
    f=f+l4_emit("L4d","fresh_pam_verdict_rc",grc,0);
    f=f+l4_emit("L4d","fresh_pam_verdict",gv,PAM_ADMIT);

    // ---------------- L4e: verdict ledger cap ----------------
    let epam:[]u8=pam_new();
    let eslot:i32=l4_genuine_observe(epam,200);
    f=f+l4_emit("L4e","slot",eslot,0);
    let ev:i32=0;let er:i32=0;let erc:i32=0;let ei:i32=0;
    while(ei<301){
        erc=pam_verdict(epam,eslot,PAM_MODE_FRESH,&ev,&er);
        ei=ei+1;
    }
    f=f+l4_emit("L4e","call301_rc",erc,0);
    f=f+l4_emit("L4e","call301_verdict",ev,PAM_ADMIT);
    f=f+l4_emit("L4e","ledger_n",pam_ledger_n(epam),256);
    f=f+l4_emit("L4e","unlogged_verdicts",301-pam_ledger_n(epam),45);

    _zag_print("L4_FAILURES,");
    let fs:[]u8=ob_alloc(12);let fn2:i32=0;l4_putdec(fs,&fn2,f);
    _zag_println(fs[0..fn2]);ob_free(fs);
    if(f!=0){return 1;}
    return 0;
}

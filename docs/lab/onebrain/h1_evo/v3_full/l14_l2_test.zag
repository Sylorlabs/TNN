// L2' — checkpoint-identity binding.
// Each checkpoint binds {checkpoint id, snapshot-bytes digest, episode}.
// Rollback cites an explicit id; the sidecar's digest must match the bound
// digest or the rollback is REFUSED (rc=MA_REFUSED_CKPT) and audited —
// forged and honest rollback entries are byte-DIFFERENT. Replay resolves
// rollback targets by cited id, so midpoint+tail replay converges with
// genesis replay (the old L2b divergence is closed).
//
// KILL: any unaudited install; any rollback entry that does not
// discriminate forged vs honest; any replay divergence.
@import("ob_common.zag")
@import("ob_mem.zag")

// byte-exact state equality over the full organ set
fn st_eq(l1:[]u8,v1:[]u8,p1:[]u8,r1:[]u8,t1:[]u8,s1:[]u8,
    l2:[]u8,v2:[]u8,p2:[]u8,r2:[]u8,t2:[]u8,s2:[]u8)i32 {
    let i:i32=0;
    while(i<256){
        if(l1[i]!=l2[i]){return 0;}
        if(p1[i]!=p2[i]){return 0;}
        if(r1[i]!=r2[i]){return 0;}
        if(t1[i]!=t2[i]){return 0;}
        i=i+1;
    }
    i=0;
    while(i<1024){
        if(v1[i]!=v2[i]){return 0;}
        if(s1[i]!=s2[i]){return 0;}
        i=i+1;
    }
    return 1;
}
// copy one full organ set
fn st_copy(l1:[]u8,v1:[]u8,p1:[]u8,r1:[]u8,t1:[]u8,s1:[]u8,
    l2:[]u8,v2:[]u8,p2:[]u8,r2:[]u8,t2:[]u8,s2:[]u8)void {
    let i:i32=0;
    while(i<256){
        l2[i]=l1[i];p2[i]=p1[i];r2[i]=r1[i];t2[i]=t1[i];
        i=i+1;
    }
    i=0;
    while(i<1024){
        v2[i]=v1[i];s2[i]=s1[i];
        i=i+1;
    }
    return;
}
// latest audit entry with op==want; copies its 12 words into out; returns
// its entry index or -1
fn last_op(audit:[]u8,hdr:[]u8,want:i32,out:[]u8)i32 {
    let n:i32=ob_g32(hdr,8);
    let i:i32=n-1;
    while(i>=0){
        let e:i32=i*48;
        if(ob_g32(audit,e+4)==want){
            let k:i32=0;
            while(k<12){ob_s32(out,k*4,ob_g32(audit,e+k*4));k=k+1;}
            return i;
        }
        i=i-1;
    }
    return -1;
}

fn main()i32 {
    let f:i32=0;
    let px:[]u8="l2p_";
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let audit:[]u8=mm_new_audit();let hdr:[]u8=mm_new_hdr();
    // operator-held sidecars: 3 checkpoints x 3 x 1024 bytes
    let ca1:[]u8=ob_alloc(1024);let ca2:[]u8=ob_alloc(1024);let ca3:[]u8=ob_alloc(1024);
    let cb1:[]u8=ob_alloc(1024);let cb2:[]u8=ob_alloc(1024);let cb3:[]u8=ob_alloc(1024);
    let cc1:[]u8=ob_alloc(1024);let cc2:[]u8=ob_alloc(1024);let cc3:[]u8=ob_alloc(1024);

    // stage the organ to FULL (mm_add is stage-gated), then episode 1
    f=f+ob_check(px,"stage1",mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr),0);
    f=f+ob_check(px,"stage2",mm_advance_stage(live,value,pinned,region,tier,step,audit,hdr),0);
    f=f+ob_check(px,"clk1",mm_clock_advance(hdr,audit,1),0);
    let id0:i32=mm_checkpoint(live,value,pinned,region,tier,step,audit,hdr,ca1,ca2,ca3);
    f=f+ob_check(px,"id0",id0,0);
    // install alpha (slot 7, value 111), episode 2, checkpoint id1
    let sa:i32=0;
    f=f+ob_check(px,"add_alpha",mm_add(live,value,pinned,region,tier,step,audit,hdr,111,1,&sa),0);
    f=f+ob_check(px,"clk2",mm_clock_advance(hdr,audit,2),0);
    let id1:i32=mm_checkpoint(live,value,pinned,region,tier,step,audit,hdr,cb1,cb2,cb3);
    f=f+ob_check(px,"id1",id1,1);
    // install beta (slot 9, value 222), episode 3, checkpoint id2
    let sb:i32=0;
    f=f+ob_check(px,"add_beta",mm_add(live,value,pinned,region,tier,step,audit,hdr,222,1,&sb),0);
    f=f+ob_check(px,"clk3",mm_clock_advance(hdr,audit,3),0);
    let id2:i32=mm_checkpoint(live,value,pinned,region,tier,step,audit,hdr,cc1,cc2,cc3);
    f=f+ob_check(px,"id2",id2,2);
    // snapshot live state C for later comparisons
    let lv:[]u8=mm_new_live();let vv:[]u8=mm_new_value();let pv:[]u8=mm_new_pinned();
    let rv:[]u8=mm_new_region();let tv:[]u8=mm_new_tier();let sv:[]u8=mm_new_step();
    st_copy(live,value,pinned,region,tier,step,lv,vv,pv,rv,tv,sv);
    f=f+ob_check(px,"alpha_live",live[sa] as i32,1);
    f=f+ob_check(px,"beta_live",live[sb] as i32,1);
    f=f+ob_check(px,"alpha_val",ob_g32(value,sa*4),111);
    f=f+ob_check(px,"beta_val",ob_g32(value,sb*4),222);

    // ---- honest rollback to the NON-latest checkpoint id1 ----
    f=f+ob_check(px,"rb_id1",mm_rollback_to(live,value,pinned,region,tier,step,
        audit,hdr,cb1,cb2,cb3,id1),0);
    f=f+ob_check(px,"rb_alpha_still",live[sa] as i32,1);
    f=f+ob_check(px,"rb_beta_gone",live[sb] as i32,0);
    f=f+ob_check(px,"rb_alpha_val",ob_g32(value,sa*4),111);
    // capture the HONEST rollback entry (12 words)
    let honest_rb:[]u8=ob_alloc(48);
    let hei:i32=last_op(audit,hdr,MA_OP_ROLLBACK,honest_rb);
    f=f+ob_check(px,"honest_rb_found",(hei>=0) as i32,1);
    f=f+ob_check(px,"honest_rb_rc",ob_g32(honest_rb,12),0);
    f=f+ob_check(px,"honest_rb_id",ob_g32(honest_rb,16),id1);

    // ---- forged sidecar: slot sa value rewritten to 99999 ----
    let fa:[]u8=ob_alloc(1024);let fb:[]u8=ob_alloc(1024);let fc:[]u8=ob_alloc(1024);
    let wi:i32=0;
    while(wi<1024){fa[wi]=cb1[wi];fb[wi]=cb2[wi];fc[wi]=cb3[wi];wi=wi+1;}
    // value array is s2 (second 1024): slot sa word -> 99999
    ob_s32(fb,sa*4,99999);
    let frc:i32=mm_rollback_to(live,value,pinned,region,tier,step,
        audit,hdr,fa,fb,fc,id1);
    f=f+ob_check(px,"forge_refused",frc,MA_REFUSED_CKPT);
    // state must be UNCHANGED by the refused rollback (still post-rb state B)
    f=f+ob_check(px,"forge_no_mut_val",ob_g32(value,sa*4),111);
    f=f+ob_check(px,"forge_no_mut_beta",live[sb] as i32,0);
    // forged rollback entry must be byte-DIFFERENT from the honest one
    let forged_rb:[]u8=ob_alloc(48);
    let fei:i32=last_op(audit,hdr,MA_OP_ROLLBACK,forged_rb);
    f=f+ob_check(px,"forged_rb_found",(fei>=0) as i32,1);
    f=f+ob_check(px,"forged_rb_rc",ob_g32(forged_rb,12),MA_REFUSED_CKPT);
    let same:i32=1;
    let wq:i32=0;
    while(wq<12){
        if(ob_g32(honest_rb,wq*4)!=ob_g32(forged_rb,wq*4)){same=0;}
        wq=wq+1;
    }
    f=f+ob_check(px,"rb_entries_differ",same,0);

    // ---- unknown checkpoint id ----
    let urc:i32=mm_rollback_to(live,value,pinned,region,tier,step,
        audit,hdr,cb1,cb2,cb3,99);
    f=f+ob_check(px,"unknown_refused",urc,MA_REFUSED_CKPT);
    f=f+ob_check(px,"unknown_no_mut",ob_g32(value,sa*4),111);

    // ---- restore to C via honest rollback to id2 (legacy form: latest) ----
    f=f+ob_check(px,"rb_legacy",mm_rollback(live,value,pinned,region,tier,step,
        audit,hdr,cc1,cc2,cc3),0);
    f=f+ob_check(px,"back_to_C",st_eq(live,value,pinned,region,tier,step,
        lv,vv,pv,rv,tv,sv),1);

    // ---- replay convergence ----
    // genesis replay over the full audit
    let g1:[]u8=mm_new_live();let g2:[]u8=mm_new_value();let g3:[]u8=mm_new_pinned();
    let g4:[]u8=mm_new_region();let g5:[]u8=mm_new_tier();let g6:[]u8=mm_new_step();
    f=f+ob_check(px,"replay_genesis",mm_replay(g1,g2,g3,g4,g5,g6,audit,hdr),0);
    f=f+ob_check(px,"genesis_eq_live",st_eq(g1,g2,g3,g4,g5,g6,
        live,value,pinned,region,tier,step),1);
    // midpoint+tail replay: restore operator sidecar for id1, replay the
    // audit tail starting AT id1's checkpoint entry (inclusive)
    let e1:i32=mm_ckpt_find(audit,hdr,id1);
    f=f+ob_check(px,"ckpt_find",(e1>=0) as i32,1);
    let m1:[]u8=mm_new_live();let m2:[]u8=mm_new_value();let m3:[]u8=mm_new_pinned();
    let m4:[]u8=mm_new_region();let m5:[]u8=mm_new_tier();let m6:[]u8=mm_new_step();
    mm_restore(m1,m2,m3,m4,m5,m6,cb1,cb2,cb3);
    let nall:i32=ob_g32(hdr,8);
    let hdr2:[]u8=mm_new_hdr();
    let hw:i32=0;
    while(hw<5){ob_s32(hdr2,hw*4,ob_g32(hdr,hw*4));hw=hw+1;}
    ob_s32(hdr2,8,nall-e1);
    let tail:[]u8=audit[e1*48..nall*48];
    f=f+ob_check(px,"replay_tail",mm_replay_from(m1,m2,m3,m4,m5,m6,tail,hdr2),0);
    f=f+ob_check(px,"tail_eq_genesis",st_eq(m1,m2,m3,m4,m5,m6,g1,g2,g3,g4,g5,g6),1);
    f=f+ob_check(px,"tail_eq_live",st_eq(m1,m2,m3,m4,m5,m6,
        live,value,pinned,region,tier,step),1);

    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

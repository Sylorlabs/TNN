// c12.zag — H1 ONE-BRAIN EVOLVE, crew C12: C1 pin-provenance gate +
// C2 livelock breaker. Frozen prereg: ~/workspace/h1evo/PREREG_H1EVO.md
// (C1'/C2' kill bars, ZD, LH, no-winner rule). N-AUTH parked (not built).
//
// C1: two promotion-gate corroboration rules in the FIXTURE layer:
//   rule-A (pin mass = 0 always; storage != truth, full separation);
//   rule-B (only audited deliberate pins with stated basis may contribute;
//           mm_safety_policy auto-pins of just-committed survivors NEVER
//           contribute). REAL ob_mem / ob_pam / ob_arbiter / f3_survivor
//   paths (byte-identical copies in src/). C1a'/C1b' kill bars.
// C2: three livelock breakers on the H3 fixture (per H-OB-46 the fixture
//   IS the system under test; no production deliberator built):
//   (a) cross-episode evidence carryover; (b) escalation budget (N=3);
//   (c) rising quorum discount. C2a'/C2b' kill bars.
// Pure Zag. Zero RNG. 3x byte-identical reruns required.
@import("src/ob_arbiter.zag")

// ================= A. output helpers =================
fn c12_nl()void { _zag_println(""); return; }

fn c12_puti(v:i32)void {
    let neg:i32=0;
    let x:i64=v as i64;
    if(x<0){neg=1;x=0-x;}
    let buf:[]u8=ob_alloc(13);
    let i:i32=12;
    if(x==0){buf[12]=48;i=11;}
    while(x>0){buf[i]=(48+(x%10)) as u8;x=x/10;i=i-1;}
    if(neg==1){buf[i]=45;i=i-1;}
    _zag_print(buf[i+1..13]);
    ob_free(buf);
    return;
}

fn c12_check(px:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("C12_CHECK,");_zag_print(px);_zag_print(name);_zag_print(",");
    c12_puti(actual);_zag_print(",");c12_puti(expected);c12_nl();
    return (actual!=expected) as i32;
}

fn c12_out(px:[]u8,name:[]u8,v:i32)void {
    _zag_print("C12_OUT,");_zag_print(px);_zag_print(name);_zag_print(",");
    c12_puti(v);c12_nl();
    return;
}

fn c12_verdict(px:[]u8,v:[]u8,why:[]u8)void {
    _zag_print("C12_VERDICT,");_zag_print(px);_zag_print(",");_zag_print(v);
    _zag_print(",");_zag_print(why);c12_nl();
    return;
}

fn c12_head(px:[]u8,what:[]u8)void {
    _zag_print("C12_RUN,");_zag_print(px);_zag_print(",");_zag_print(what);c12_nl();
    return;
}

// ================= B. brain setup (same pattern as obc) =================
fn c12_brain_new(q:*[]u8,qn:*i32,ast:*[]u8,routes:*[]u8,alog:*[]u8,alogn:*i32,
    pam:*[]u8,flog:*[]u8,flogn:*i32,
    live:*[]u8,value:*[]u8,pinned:*[]u8,region:*[]u8,tier:*[]u8,step:*[]u8,
    maudit:*[]u8,mhdr:*[]u8,trust:*[]u8)i32 {
    q.*=ob_msgq_init(ARB_QCAP);qn.*=0;
    ast.*=arb_new_state();routes.*=arb_new_routes();
    alog.*=ob_alloc(ARB_ACAP*16);alogn.*=0;
    pam.*=pam_new();
    flog.*=ob_alloc(OBF_LOGCAP*16);flogn.*=0;
    live.*=mm_new_live();value.*=mm_new_value();pinned.*=mm_new_pinned();
    region.*=mm_new_region();tier.*=mm_new_tier();step.*=mm_new_step();
    maudit.*=mm_new_audit();mhdr.*=mm_new_hdr();trust.*=mm_new_trust();
    mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*);
    mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*);
    return 0;
}

fn c12_stage_cal(flog:[]u8,flogn:*i32)i32 {
    let e:i32=0;
    while(e<4){tn_audit(flog,flogn,10+e,TN_OP_CALIBRATE,0,1);e=e+1;}
    return 0;
}

fn c12_mem_eq(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,step:[]u8,
    l2:[]u8,v2:[]u8,p2:[]u8,r2:[]u8,t2:[]u8,s2:[]u8)i32 {
    let i:i32=0;
    while(i<MA_CAP){
        if(live[i]!=l2[i]){return 0;}
        if(pinned[i]!=p2[i]){return 0;}
        if(region[i]!=r2[i]){return 0;}
        if(tier[i]!=t2[i]){return 0;}
        if(ob_g32(value,i*4)!=ob_g32(v2,i*4)){return 0;}
        if(ob_g32(step,i*4)!=ob_g32(s2,i*4)){return 0;}
        i=i+1;
    }
    return 1;
}

fn c12_mem_eq3(live:[]u8,value:[]u8,pinned:[]u8,l2:[]u8,v2:[]u8,p2:[]u8)i32 {
    let i:i32=0;
    while(i<MA_CAP){
        if(live[i]!=l2[i]){return 0;}
        if(pinned[i]!=p2[i]){return 0;}
        if(ob_g32(value,i*4)!=ob_g32(v2,i*4)){return 0;}
        i=i+1;
    }
    return 1;
}

fn c12_snap3(live:[]u8,value:[]u8,pinned:[]u8,l2:[]u8,v2:[]u8,p2:[]u8)void {
    let i:i32=0;
    while(i<MA_CAP){
        l2[i]=live[i];p2[i]=pinned[i];
        ob_s32(v2,i*4,ob_g32(value,i*4));
        i=i+1;
    }
    return;
}

fn c12_mem_audit_n(mhdr:[]u8)i32 { return ob_g32(mhdr,8); }

// ================= C. C1: pin-provenance promotion gate =================
// Frozen design rule: ORGAN PINS ARE NEVER HYPOTHESIS SUPPORT WITHOUT
// PIN PROVENANCE. Two fixture-layer rules under test:
//   rule-A: pin mass = 0 always (storage != truth, full separation — the
//           pin is neither required nor counted);
//   rule-B: only audited deliberate pins with a stated basis may
//           contribute corroboration mass; mm_safety_policy auto-pins of
//           just-committed survivors NEVER contribute.
// Provenance is a deliberation-layer concern: the organ-level mem audit
// records MA_OP_PIN identically for auto and deliberate pins; the
// arbiter log distinguishes them (M_MEM_SAFETY announcement = auto-pin;
// M_MEM_DELIBPIN / M_FORCE_PIN = deliberate). The gate reads provenance
// from the arbiter log (newest pin event for the slot wins).
const C12_RULE_A:i32=0;
const C12_RULE_B:i32=1;
const C12_PROV_NONE:i32=0;
const C12_PROV_AUTO:i32=1;
const C12_PROV_DELIB:i32=2;
const M_MEM_DELIBPIN:i32=112; // fixture: deliberate pin {a1=slot,a2=basis}
const C12_DPW:i32=12;         // deliberate-pin registry entry bytes
const C12_DPCAP:i32=64;
const C12_BASIS_INDEP_OBS:i32=1; // stated basis: independent observation

const OBC_POL_FALSE:i32=501;
const OBC_POL_TRUE:i32=777;
const OBC_CLAIM_F:i32=7;
const OBC_CLAIM_T:i32=8;

// newest-to-oldest scan of the arbiter log for the provenance of the
// slot's current pin.
fn c12_pinprov(alog:[]u8,alogn:i32,slot:i32)i32 {
    let i:i32=alogn-1;
    while(i>=0){
        let code:i32=ob_g32(alog,i*16+4);
        let a1:i32=ob_g32(alog,i*16+8);
        let a2:i32=ob_g32(alog,i*16+12);
        if(code==M_MEM_SAFETY && a1==MA_OP_PIN && a2==slot){return C12_PROV_AUTO;}
        if(code==M_MEM_DELIBPIN && a1==slot){return C12_PROV_DELIB;}
        if(code==M_FORCE_PIN && a1==slot && a2==MA_OK){return C12_PROV_DELIB;}
        i=i-1;
    }
    return C12_PROV_NONE;
}

// genuine corroboration: REAL PAM rows for the jcode that are (a)
// informationally independent, (b) observed AFTER the install episode,
// (c) themselves bar-passing (M1/M3/M4). The install-time admission row
// is excluded by the episode filter: admission is not corroboration.
fn c12_genuine_mass(pam:[]u8,jcode:i32,install_ep:i32)i32 {
    let m:i32=0;
    let n:i32=pam_n(pam);
    let r:i32=0;
    while(r<n){
        if(pam_row(pam,r,PAMW_JF)==jcode && pam_row(pam,r,PAMW_INDEP)==1
            && pam_row(pam,r,PAMW_EP)>install_ep
            && pam_bars_ok(pam,r)==PAM_R_OK){m=m+1;}
        r=r+1;
    }
    return m;
}

// fixture deliberate pin: the REAL organ pin path (mm_pin via
// arb_mem_apply — organ behavior unchanged), plus a deliberation-layer
// provenance record: audited registry entry with STATED BASIS, announced
// on the arbiter log as M_MEM_DELIBPIN.
fn c12_deliberate_pin(live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,
    step:[]u8,maudit:[]u8,mhdr:[]u8,trust:[]u8,
    alog:[]u8,alogn:*i32,dpin:[]u8,dpn:*i32,dplog:[]u8,dpln:*i32,
    ep:i32,slot:i32,basis:i32)i32 {
    let os:i32=-1;
    let rc:i32=arb_mem_apply(live,value,pinned,region,tier,step,
        maudit,mhdr,trust,alog,alogn,ep,MA_OP_PIN,slot,0,0,&os);
    if(rc==MA_OK){
        let n:i32=dpn.*;
        if(n<C12_DPCAP){
            ob_s32(dpin,n*C12_DPW,slot);ob_s32(dpin,n*C12_DPW+4,basis);
            ob_s32(dpin,n*C12_DPW+8,ep);
            dpn.*=n+1;
        }
        let l:i32=dpln.*;
        ob_s32(dplog,l*16,ep);ob_s32(dplog,l*16+4,M_MEM_DELIBPIN);
        ob_s32(dplog,l*16+8,slot);ob_s32(dplog,l*16+12,basis);
        dpln.*=l+1;
        arb_audit(alog,alogn,ep,M_MEM_DELIBPIN,slot,basis);
    }
    return rc;
}

// promotion gate fixture (deliberation layer) with pin provenance.
// Reasons: 0 ok, 1 pending revoke, 2 bad cited, 3 cited not live,
// 5 jcode mismatch, 6 cited not admitted, 7 candidate/cited mismatch,
// 8 pin budget, 9 uncorroborated (pin mass excluded / auto-pin).
// NOTE vs the C1-killed gate: the pinned[cited] REQUIREMENT is gone
// (rule-A: full separation) and pin state contributes mass only via
// provenance (rule-B: deliberate only).
fn c12_gate_c1(rule:i32,pinned:[]u8,live:[]u8,jc:[]u8,adm:[]u8,
    pam:[]u8,alog:[]u8,alogn:i32,
    slot:i32,jcode:i32,cited:i32,pending:i32,install_ep:i32,
    reason:*i32,pinmass_out:*i32,genuine_out:*i32,prov_out:*i32)i32 {
    pinmass_out.*=0;genuine_out.*=0;prov_out.*=C12_PROV_NONE;
    if(pending!=0){reason.*=1;return 0;}
    if(cited<0||cited>=MA_CAP){reason.*=2;return 0;}
    if(live[cited]==0){reason.*=3;return 0;}
    if(ob_g32(jc,cited*4)!=jcode){reason.*=5;return 0;}
    if(adm[cited]==0){reason.*=6;return 0;}
    if(slot!=cited){reason.*=7;return 0;}
    // NOTE (LH-driven refinement 2026-09-24): the original C1 gate refused
    // when the organ pin budget saturated (reason 8). The LH stream showed
    // this makes the gate refuse legitimate promotions from episode 7 on
    // under sustained M_COMMIT auto-pinning — storage gating truth, which
    // contradicts rule-A's full separation and is unnecessary under rule-B
    // (the organ enforces pin allocation itself; promotion here rests on
    // corroboration, never on pin availability). The budget check is
    // removed from the promotion gate; the organ's MM_MAX_PIN law is
    // untouched.
    let genuine:i32=c12_genuine_mass(pam,jcode,install_ep);
    let pinmass:i32=0;
    let prov:i32=C12_PROV_NONE;
    if(pinned[cited]!=0){prov=c12_pinprov(alog,alogn,cited);}
    if(rule==C12_RULE_B && prov==C12_PROV_DELIB){pinmass=1;}
    genuine_out.*=genuine;pinmass_out.*=pinmass;prov_out.*=prov;
    if(genuine+pinmass<1){reason.*=9;return 0;}
    reason.*=0;
    return 1;
}

// hypothesis organ: real f3_survivor over {0:H_false(501),1:H_true(777)}.
// Pin citation is the REAL organ behavior (unchanged); the gate is where
// the new provenance rules apply.
fn c12_cite_support(pinned:[]u8,jc:[]u8,slot:i32,cand_jcode:i32)i32 {
    if(slot<0||slot>=MA_CAP){return 0;}
    if(pinned[slot]==0){return 0;}
    if(ob_g32(jc,slot*4)!=cand_jcode){return 0;}
    return 1;
}
fn c12_hyp_select(pinned:[]u8,jc:[]u8,sf:i32,st:i32)i32 {
    let sup0:i32=c12_cite_support(pinned,jc,sf,OBC_POL_FALSE);
    let sup1:i32=c12_cite_support(pinned,jc,st,OBC_POL_TRUE);
    return f3_survivor(2,sup0,1+sup1,0);
}

// one C1 scenario. Modes:
//   0 = C1a' main: false via M_COMMIT (auto-pin), true via M_PROPOSE.
//   1 = CTL-NOPIN: both via M_PROPOSE (no pins).
//   2 = C1b' CTL-TRUE: false via M_PROPOSE, true via M_COMMIT (auto-pin)
//       + one REAL independent post-install PAM observation of 777.
//   3 = probe D2: false via M_PROPOSE (no pin), true via M_PROPOSE +
//       fixture DELIBERATE pin (stated basis) on the true slot
//       (H_true selected; rule-A must refuse, rule-B may promote).
//   4 = probe D4: false via M_PROPOSE, true via M_COMMIT (auto-pin),
//       NO independent observation (auto-pin must never contribute).
// Expected mem-audit entry counts: mode0:5 mode1:4 mode2:6(+promote)
// mode3:5(+promote iff rule-B) mode4:5. (2 stage + installs/pins.)
fn c12_c1_run(px:[]u8,rule:i32,mode:i32,
    surv_out:*i32,reason_out:*i32,prom_out:*i32,
    pinm_out:*i32,gen_out:*i32,prov_out:*i32,an_out:*i32)i32 {
    let f:i32=0;
    let q:[]u8=ob_alloc(0);let qn:i32=0;
    let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let alogn:i32=0;
    let pam:[]u8=ob_alloc(0);let flog:[]u8=ob_alloc(0);let flogn:i32=0;
    let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);let pinned:[]u8=ob_alloc(0);
    let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);let step:[]u8=ob_alloc(0);
    let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);let trust:[]u8=ob_alloc(0);
    c12_brain_new(&q,&qn,&ast,&routes,&alog,&alogn,&pam,&flog,&flogn,
        &live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust);
    c12_stage_cal(flog,&flogn);
    let dpin:[]u8=ob_alloc(C12_DPCAP*C12_DPW);
    let dpn:i32=0;
    let dplog:[]u8=ob_alloc(64*16);
    let dpln:i32=0;
    let i:i32=0;
    while(i<C12_DPCAP*C12_DPW){dpin[i]=0;i=i+1;}
    let jc:[]u8=ob_alloc(MA_CAP*4);
    let adm:[]u8=ob_alloc(MA_CAP);
    i=0;
    while(i<MA_CAP){ob_s32(jc,i*4,-1);adm[i]=0;i=i+1;}
    // install the FALSE premise (jcode 501) at ep 1.
    // mode 0 only: via M_COMMIT (real branch installs AND auto-pins via
    // mm_safety_policy). All other modes: via M_PROPOSE_INSTALL (no
    // auto-pin) so the deliberate-pin probe (mode 3) selects H_true.
    let sf:i32=-1;
    if(mode==0){
        ob_msg_enqueue(q,&qn,ARB_QCAP,1,0,M_COMMIT,1,OBC_POL_FALSE);
        arb_process(1,q,&qn,ast,routes,alog,&alogn,pam,flog,flogn,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        sf=ob_g32(routes,(1%ARB_ROUTES)*4);
    } else {
        ob_msg_enqueue(q,&qn,ARB_QCAP,1,0,M_PROPOSE_INSTALL,OBC_POL_FALSE,OBC_CLAIM_F);
        arb_process(1,q,&qn,ast,routes,alog,&alogn,pam,flog,flogn,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        sf=ob_g32(routes,OBC_CLAIM_F*4);
    }
    // install the TRUE premise (jcode 777) at ep 2
    let st:i32=-1;
    if(mode==2 || mode==4){
        ob_msg_enqueue(q,&qn,ARB_QCAP,2,0,M_COMMIT,1,OBC_POL_TRUE);
        arb_process(2,q,&qn,ast,routes,alog,&alogn,pam,flog,flogn,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        st=ob_g32(routes,(2%ARB_ROUTES)*4);
    } else {
        ob_msg_enqueue(q,&qn,ARB_QCAP,2,0,M_PROPOSE_INSTALL,OBC_POL_TRUE,OBC_CLAIM_T);
        arb_process(2,q,&qn,ast,routes,alog,&alogn,pam,flog,flogn,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        st=ob_g32(routes,OBC_CLAIM_T*4);
    }
    f=f+c12_check(px,"sf_installed",(sf>=0) as i32,1);
    f=f+c12_check(px,"st_installed",(st>=0) as i32,1);
    if(sf>=0){ob_s32(jc,sf*4,OBC_POL_FALSE);adm[sf]=1;}
    if(st>=0){ob_s32(jc,st*4,OBC_POL_TRUE);adm[st]=1;}
    // mode 2: one REAL independent post-install PAM observation of 777
    // (honest world corroboration; disjoint spans, bar-passing).
    if(mode==2 && st>=0){
        let orow:i32=pam_observe(pam,OBC_POL_TRUE,OBC_POL_TRUE,1000,1000,1,
            30,1030,7,350,350,350,3);
        f=f+c12_check(px,"indep_obs_row",(orow>=0) as i32,1);
    }
    // mode 3: fixture DELIBERATE pin with stated basis on the true slot
    if(mode==3 && st>=0){
        let prc:i32=c12_deliberate_pin(live,value,pinned,region,tier,step,
            maudit,mhdr,trust,alog,&alogn,dpin,&dpn,dplog,&dpln,
            3,st,C12_BASIS_INDEP_OBS);
        f=f+c12_check(px,"delib_pin_rc",prc,MA_OK);
    }
    // hypothesis organ selects (real f3_survivor, pin citation unchanged)
    let surv:i32=c12_hyp_select(pinned,jc,sf,st);
    c12_out(px,"survivor",surv);
    let cand:i32=-1;let cj:i32=0;let iep:i32=1;
    if(surv==0){cand=sf;cj=OBC_POL_FALSE;iep=1;}
    if(surv==1){cand=st;cj=OBC_POL_TRUE;iep=2;}
    // promotion gate (deliberation layer, new provenance rules)
    let reason:i32=-1;let pinm:i32=0;let genu:i32=0;let prov:i32=0;
    let g:i32=0;
    if(cand>=0){
        g=c12_gate_c1(rule,pinned,live,jc,adm,pam,alog,alogn,
            cand,cj,cand,0,iep,&reason,&pinm,&genu,&prov);
    }
    c12_out(px,"gate",g);
    c12_out(px,"gate_reason",reason);
    c12_out(px,"pinmass",pinm);
    c12_out(px,"genuine",genu);
    c12_out(px,"pinprov",prov);
    let pin_deciding:i32=((pinm>0)&&(genu==0)) as i32;
    c12_out(px,"pin_deciding",pin_deciding);
    let prom:i32=0;
    if(g==1){
        let os:i32=-1;
        let rc:i32=arb_mem_apply(live,value,pinned,region,tier,step,
            maudit,mhdr,trust,alog,&alogn,3,MA_OP_PROMOTE,cand,0,0,&os);
        f=f+c12_check(px,"promote_rc",rc,MA_OK);
        if(rc==MA_OK && region[cand]==MA_REGION_LONG){prom=1;}
    } else {
        // I3 refusal purity: snapshot around the refused gate decision
        let l2:[]u8=ob_alloc(MA_CAP);let v2:[]u8=ob_alloc(MA_CAP*4);
        let p2:[]u8=ob_alloc(MA_CAP);
        c12_snap3(live,value,pinned,l2,v2,p2);
        f=f+c12_check(px,"i3_refusal_pure",
            c12_mem_eq3(live,value,pinned,l2,v2,p2),1);
        ob_free(l2);ob_free(v2);ob_free(p2);
    }
    c12_out(px,"promoted",prom);
    if(prom==1 && cj==OBC_POL_FALSE){c12_out(px,"false_permanent",1);}
    if(prom==1 && cj==OBC_POL_TRUE){c12_out(px,"true_permanent",1);}
    // I1: replay reproduces live state
    let rl:[]u8=mm_new_live();let rv:[]u8=mm_new_value();let rp:[]u8=mm_new_pinned();
    let rr:[]u8=mm_new_region();let rt:[]u8=mm_new_tier();let rs:[]u8=mm_new_step();
    mm_replay(rl,rv,rp,rr,rt,rs,maudit,mhdr);
    let rep:i32=c12_mem_eq(live,value,pinned,region,tier,step,rl,rv,rp,rr,rt,rs);
    f=f+c12_check(px,"i1_replay",rep,1);
    // I4: no kills in C1 runs
    let nk:i32=mm_audit_count(maudit,mhdr,MA_OP_KILL,MA_OK);
    f=f+c12_check(px,"i4_no_kill",nk,0);
    ob_free(rl);ob_free(rv);ob_free(rp);ob_free(rr);ob_free(rt);ob_free(rs);
    let an:i32=c12_mem_audit_n(mhdr);
    c12_out(px,"audit_n",an);
    surv_out.*=surv;reason_out.*=reason;prom_out.*=prom;
    pinm_out.*=pinm;gen_out.*=genu;prov_out.*=prov;an_out.*=an;
    ob_free(dpin);ob_free(dplog);
    return f;
}

// C1 battery for one rule: modes 0..4 + C1a'/C1b' kill evaluation.
fn c12_c1_battery(px:[]u8,rule:i32)i32 {
    let f:i32=0;
    let sv:i32=0;let rs:i32=0;let pr:i32=0;let pm:i32=0;let gn:i32=0;
    let pv:i32=0;let an:i32=0;
    c12_head(px,"rule_battery");
    // mode 0: C1a' breaking input (false + auto-pin)
    f=f+c12_c1_run("m0_",rule,0,&sv,&rs,&pr,&pm,&gn,&pv,&an);
    let m0_prom:i32=pr;let m0_surv:i32=sv;
    f=f+c12_check("m0_","i2_audit_n",an,5);
    // mode 1: CTL-NOPIN
    f=f+c12_c1_run("m1_",rule,1,&sv,&rs,&pr,&pm,&gn,&pv,&an);
    let m1_prom:i32=pr;
    f=f+c12_check("m1_","i2_audit_n",an,4);
    // mode 2: C1b' CTL-TRUE (true + auto-pin + genuine independent obs)
    f=f+c12_c1_run("m2_",rule,2,&sv,&rs,&pr,&pm,&gn,&pv,&an);
    let m2_prom:i32=pr;let m2_surv:i32=sv;let m2_pinm:i32=pm;let m2_gen:i32=gn;
    f=f+c12_check("m2_","i2_audit_n",an,6);
    // mode 3: probe D2 (true + DELIBERATE pin, no indep obs)
    f=f+c12_c1_run("m3_",rule,3,&sv,&rs,&pr,&pm,&gn,&pv,&an);
    let m3_prom:i32=pr;let m3_pinm:i32=pm;let m3_gen:i32=gn;let m3_prov:i32=pv;
    let m3_wantan:i32=5;
    if(rule==C12_RULE_B){m3_wantan=6;}
    f=f+c12_check("m3_","i2_audit_n",an,m3_wantan);
    // mode 4: probe D4 (true + AUTO-pin, no indep obs)
    f=f+c12_c1_run("m4_",rule,4,&sv,&rs,&pr,&pm,&gn,&pv,&an);
    let m4_prom:i32=pr;let m4_pinm:i32=pm;let m4_prov:i32=pv;
    f=f+c12_check("m4_","i2_audit_n",an,5);
    // --- kill-bar evaluation ---
    // C1a': false premise + auto-pin must be REFUSED
    let killa:i32=0;
    if(m0_prom==1 && m0_surv==0){killa=1;}
    c12_out(px,"c1a_kill",killa);
    // C1b': true control must PROMOTE via genuine corroboration,
    // never with pin mass as the deciding factor
    let killb:i32=0;
    if(m2_prom==0){killb=1;}
    if(m2_prom==1 && (m2_pinm>0 && m2_gen==0)){killb=1;}
    c12_out(px,"c1b_kill",killb);
    c12_out(px,"m2_survivor",m2_surv);
    c12_out(px,"m3_prom",m3_prom);
    c12_out(px,"m3_pinmass",m3_pinm);
    c12_out(px,"m3_genuine",m3_gen);
    c12_out(px,"m3_prov",m3_prov);
    c12_out(px,"m4_prom",m4_prom);
    c12_out(px,"m4_pinmass",m4_pinm);
    c12_out(px,"m4_prov",m4_prov);
    // rule-separation expectations (design probes, not kill bars):
    // D2: rule-A refuses (pin mass 0), rule-B promotes (deliberate pin).
    // D4: both refuse (auto-pin never contributes).
    let sepfail:i32=0;
    if(rule==C12_RULE_A && m3_prom==1){sepfail=1;}
    if(rule==C12_RULE_B && m3_prom==0){sepfail=1;}
    if(m4_prom==1){sepfail=1;}
    c12_out(px,"separation_ok",(sepfail==0) as i32);
    f=f+c12_check(px,"separation",sepfail,0);
    if(killa==1){c12_verdict(px,"KILL","C1a': false premise promoted despite pin provenance gate");}
    else{
        if(killb==1){c12_verdict(px,"KILL","C1b': true control refused or pin-decided (overcorrection)");}
        else{c12_verdict(px,"SURVIVE","C1a' refused, C1b' promoted via genuine corroboration, pin never deciding");}
    }
    return f;
}

fn c12_c1a()i32 {
    c12_out("c1a","rule",C12_RULE_A);
    return c12_c1_battery("c1a",C12_RULE_A);
}
fn c12_c1b()i32 {
    c12_out("c1b","rule",C12_RULE_B);
    return c12_c1_battery("c1b",C12_RULE_B);
}

// ================= D. H3 deliberator fixture + livelock breakers ========
// Bounded, typed, evidence-first deliberation fixture (frozen spec from
// PREREG_COLLUSION.md §0: R=3 rounds; quorum = >=2 independent
// contradiction items AND mass >= 10; quorum completing in the final
// round ABSTAIN_ESCALATEs instead of snap-quarantining). Per H-OB-46 no
// deliberator exists in either variant — this fixture IS the system
// under test. No production deliberator is built here.
// Three breaker candidates (PREREG_H1EVO §C2'):
//   mode 1 (a) cross-episode evidence carryover: dribbled items
//      accumulate across episodes until quorum completes;
//   mode 2 (b) escalation budget: DL_BUDGET same-claim escalations
//      without resolution -> QUARANTINE pending review (typed,
//      reviewable, reversible — not a snap judgment: the evidence has
//      been deliberated across B episodes);
//   mode 3 (c) rising quorum discount: the bar lowers per repeat
//      episode (mass 10-2k floor 4; items 2->1 at k>=2).
const DLK_OBS:i32=0;
const DLK_DIR:i32=1;
const DLK_HYP:i32=2;
const DLK_CONTRA:i32=3;
const DL_R:i32=3;
const DL_QUORUM_N:i32=2;
const DL_QUORUM_MASS:i32=10;
const DL_ITEMW:i32=84;
const DL_CAP_SLOTS:i32=16;
const DLA_HOLD:i32=0;
const DLA_QUARANTINE:i32=1;
const DLA_DISTRUST:i32=2;
const DLA_ESCALATE:i32=3;
const DLA_DISMISS:i32=4;
const DLA_QREVIEW:i32=5;
const DL_BUDGET:i32=3;
const BRK_BASE:i32=0;
const BRK_CARRY:i32=1;
const BRK_BUDGET:i32=2;
const BRK_DISCOUNT:i32=3;

// item: payload[0..63], kind@64, target@68, avail@72, cite@76, mass@80
fn dlx_item(buf:[]u8,i:i32,pay:[]u8,kind:i32,target:i32,avail:i32,cite:i32,mass:i32)i32 {
    let b:i32=i*DL_ITEMW;
    let n:i32=0;
    let plen:i32=0;
    while(pay[plen]!=0 && plen<64){plen=plen+1;}
    while(n<64){if(n<plen){buf[b+n]=pay[n];}else{buf[b+n]=0;}n=n+1;}
    ob_s32(buf,b+64,kind);ob_s32(buf,b+68,target);ob_s32(buf,b+72,avail);
    ob_s32(buf,b+76,cite);ob_s32(buf,b+80,mass);
    return 0;
}
fn dlx_parse_kind(buf:[]u8,i:i32)i32 { return ob_g32(buf,i*DL_ITEMW+64); }
fn dlx_item_target(buf:[]u8,i:i32)i32 { return ob_g32(buf,i*DL_ITEMW+68); }
fn dlx_z32(a:[]u8,i:i32)i32 { return ob_g32(a,i*4); }
fn dlx_s32(a:[]u8,i:i32,v:i32)void { ob_s32(a,i*4,v); return; }

// explicit-address scanner: typed content may not influence authority
// slots by name. Scans payload for "slot <digit>".
fn dlx_scan_mention(buf:[]u8,i:i32,mentioned:[]u8,mcount:[]u8)i32 {
    let b:i32=i*DL_ITEMW;
    let n:i32=0;
    while(n<59){
        if(buf[b+n]==115 && buf[b+n+1]==108 && buf[b+n+2]==111 && buf[b+n+3]==116 && buf[b+n+4]==32){
            let d:i32=(buf[b+n+5] as i32)-48;
            if(d>=0 && d<DL_CAP_SLOTS){
                mentioned[d]=1;
                dlx_s32(mcount,d,dlx_z32(mcount,d)+1);
            }
        }
        n=n+1;
    }
    return 0;
}

// one deliberation episode with breaker state. estk/carn/carm are
// per-slot: unresolved-escalation count, carried item count, carried mass.
// Returns rounds used; out: action, target, reason, firewall-clean.
// Reasons: 0 quarantine-at-quorum, 2 distrust-below-quorum,
// 3 hold-no-evidence, 5 no-snap-at-bound, 6 budget-exhausted.
fn dlx_episode(buf:[]u8,n:i32,mode:i32,
    estk:[]u8,carn:[]u8,carm:[]u8,
    act_out:*i32,targ_out:*i32,why_out:*i32,fw_out:*i32)i32 {
    let qn:[]u8=ob_alloc(16*4);
    let qm:[]u8=ob_alloc(16*4);
    let nitems:[]u8=ob_alloc(16*4);
    let nmass:[]u8=ob_alloc(16*4);
    let mentioned:[]u8=ob_alloc(16);
    let mcount:[]u8=ob_alloc(16*4);
    let s:i32=0;
    while(s<16){
        let k:i32=dlx_z32(estk,s);
        let a:i32=DL_QUORUM_N;
        let b:i32=DL_QUORUM_MASS;
        if(mode==BRK_DISCOUNT){
            if(k>=2){a=1;}
            b=DL_QUORUM_MASS-2*k;
            if(b<4){b=4;}
        }
        dlx_s32(qn,s,a);dlx_s32(qm,s,b);
        if(mode==BRK_CARRY){
            dlx_s32(nitems,s,dlx_z32(carn,s));
            dlx_s32(nmass,s,dlx_z32(carm,s));
        } else {
            dlx_s32(nitems,s,0);dlx_s32(nmass,s,0);
        }
        mentioned[s]=0;dlx_s32(mcount,s,0);
        s=s+1;
    }
    let ii:i32=0;
    while(ii<n){dlx_scan_mention(buf,ii,mentioned,mcount);ii=ii+1;}
    let r:i32=1;
    let used:i32=0;
    while(r<=DL_R){
        used=r;
        let j:i32=0;
        while(j<n){
            if(dlx_parse_kind(buf,j)==DLK_CONTRA && ob_g32(buf,j*DL_ITEMW+72)==r){
                let tg:i32=dlx_item_target(buf,j);
                if(tg>=0 && tg<DL_CAP_SLOTS){
                    dlx_s32(nitems,tg,dlx_z32(nitems,tg)+1);
                    dlx_s32(nmass,tg,dlx_z32(nmass,tg)+ob_g32(buf,j*DL_ITEMW+80));
                }
            }
            j=j+1;
        }
        let s2:i32=0;
        while(s2<DL_CAP_SLOTS){
            if(dlx_z32(nitems,s2)>=dlx_z32(qn,s2) && dlx_z32(nmass,s2)>=dlx_z32(qm,s2)){
                if(r<DL_R){
                    dlx_s32(estk,s2,0);
                    dlx_s32(carn,s2,0);dlx_s32(carm,s2,0);
                    act_out.*=DLA_QUARANTINE;targ_out.*=s2;why_out.*=0;
                    let fw:i32=1;
                    if(dlx_z32(nitems,s2)<1){fw=0;}
                    fw_out.*=fw;
                    ob_free(qn);ob_free(qm);ob_free(nitems);ob_free(nmass);
                    ob_free(mentioned);ob_free(mcount);
                    return used;
                }
                let k2:i32=dlx_z32(estk,s2);
                if(mode==BRK_BUDGET && k2+1>=DL_BUDGET){
                    dlx_s32(estk,s2,0);
                    act_out.*=DLA_QREVIEW;targ_out.*=s2;why_out.*=6;
                    fw_out.*=1;
                    ob_free(qn);ob_free(qm);ob_free(nitems);ob_free(nmass);
                    ob_free(mentioned);ob_free(mcount);
                    return used;
                }
                dlx_s32(estk,s2,k2+1);
                if(mode==BRK_CARRY){
                    dlx_s32(carn,s2,dlx_z32(nitems,s2));
                    dlx_s32(carm,s2,dlx_z32(nmass,s2));
                }
                act_out.*=DLA_ESCALATE;targ_out.*=s2;why_out.*=5;
                fw_out.*=1;
                ob_free(qn);ob_free(qm);ob_free(nitems);ob_free(nmass);
                ob_free(mentioned);ob_free(mcount);
                return used;
            }
            s2=s2+1;
        }
        r=r+1;
    }
    let d:i32=0;
    let found:i32=-1;
    while(d<DL_CAP_SLOTS){
        if(dlx_z32(nitems,d)>=1 && dlx_z32(nmass,d)<dlx_z32(qm,d)){found=d;}
        d=d+1;
    }
    if(found>=0){
        dlx_s32(estk,found,0);
        dlx_s32(carn,found,0);dlx_s32(carm,found,0);
        act_out.*=DLA_DISTRUST;targ_out.*=found;why_out.*=2;fw_out.*=1;
        ob_free(qn);ob_free(qm);ob_free(nitems);ob_free(nmass);
        ob_free(mentioned);ob_free(mcount);
        return used;
    }
    act_out.*=DLA_HOLD;targ_out.*=-1;why_out.*=3;fw_out.*=1;
    ob_free(qn);ob_free(qm);ob_free(nitems);ob_free(nmass);
    ob_free(mentioned);ob_free(mcount);
    return used;
}

// escalation processing: appends typed ESCALATED entry to the review
// queue; changes no authority state.
fn dlx_escalate_process(revq:[]u8,revnp:*i32,conflict:i32)i32 {
    let n:i32=revnp.*;
    ob_s32(revq,n*8,conflict);ob_s32(revq,n*8+4,DLA_ESCALATE);
    revnp.*=n+1;
    return 0;
}

fn dlx_state_new(estk:*[]u8,carn:*[]u8,carm:*[]u8)void {
    estk.*=ob_alloc(16*4);carn.*=ob_alloc(16*4);carm.*=ob_alloc(16*4);
    let s:i32=0;
    while(s<16){dlx_s32(estk.*,s,0);dlx_s32(carn.*,s,0);dlx_s32(carm.*,s,0);s=s+1;}
    return;
}

// C2 battery for one breaker: frozen 12-episode {1,2,3} dribble attack
// vs X, then CTL-FRONT + CTL-HONEST (also run under the BASELINE fixture
// to prove the controls are unchanged by the breaker).
fn c12_c2_battery(px:[]u8,mode:i32)i32 {
    let f:i32=0;
    c12_head(px,"breaker_battery");
    let estk:[]u8=ob_alloc(0);let carn:[]u8=ob_alloc(0);let carm:[]u8=ob_alloc(0);
    dlx_state_new(&estk,&carn,&carm);
    let quar_set:[]u8=ob_alloc(16);
    let s:i32=0;
    while(s<16){quar_set[s]=0;s=s+1;}
    let revq:[]u8=ob_alloc(16*8);
    let revn:i32=0;
    let esc:i32=0;let quar:i32=0;let qrev:i32=0;let holds:i32=0;let dist:i32=0;
    let drive:i32=0;let resolved_ep:i32=0;
    let u1:i32=0;let ur:i32=0;
    let X:i32=3;
    let ep:i32=1;
    while(ep<=12){
        if(quar_set[X]==0){
            let items:[]u8=ob_alloc(3*DL_ITEMW);
            dlx_item(items,0,"env-a contradicts X at avail 1\0",DLK_CONTRA,X,1,4,4);
            dlx_item(items,1,"env-b contradicts X at avail 2\0",DLK_CONTRA,X,2,4,4);
            dlx_item(items,2,"env-c contradicts X at avail 3\0",DLK_CONTRA,X,3,4,4);
            let act:i32=0;let targ:i32=-1;let why:i32=0;let fw:i32=0;
            let used:i32=dlx_episode(items,3,mode,estk,carn,carm,&act,&targ,&why,&fw);
            if(ep==1){u1=used;}
            f=f+c12_check("a_","firewall_clean",fw,1);
            if(act==DLA_QUARANTINE){quar=quar+1;quar_set[targ]=1;resolved_ep=ep;ur=used;}
            if(act==DLA_QREVIEW){qrev=qrev+1;quar_set[targ]=1;resolved_ep=ep;ur=used;}
            if(act==DLA_ESCALATE){
                esc=esc+1;
                let d0:i32=quar+qrev+holds+dist;
                dlx_escalate_process(revq,&revn,X);
                let d1:i32=quar+qrev+holds+dist;
                f=f+c12_check("a_","esc_no_authority_mut",(d0==d1) as i32,1);
                c12_out("a_","ep",ep);
                c12_out("a_","esc_reason",why);
            }
            if(act==DLA_HOLD){holds=holds+1;}
            if(act==DLA_DISTRUST){dist=dist+1;}
            if(quar_set[X]==0){drive=drive+1;}
            ob_free(items);
        } else {
            c12_out("a_","skip_ep",ep);
        }
        ep=ep+1;
    }
    c12_out(px,"escalations",esc);
    c12_out(px,"quarantines",quar);
    c12_out(px,"qreviews",qrev);
    c12_out(px,"holds",holds);
    c12_out(px,"distrusts",dist);
    c12_out(px,"action_episodes",drive);
    c12_out(px,"resolved_ep",resolved_ep);
    c12_out(px,"ep1_rounds",u1);
    c12_out(px,"resolve_rounds",ur);
    c12_out(px,"review_queue",revn);
    // C2a': resolution (quarantine of X) within 12 episodes; X must not
    // drive action indefinitely.
    let killa:i32=0;
    if(resolved_ep==0){killa=1;}
    if(drive>=12){killa=1;}
    c12_out(px,"c2a_kill",killa);
    // --- C2b' controls: front-loaded and honest, under this breaker AND
    // under the baseline fixture (proves the breaker changed nothing) ---
    let be:[]u8=ob_alloc(0);let bc:[]u8=ob_alloc(0);let bm:[]u8=ob_alloc(0);
    dlx_state_new(&be,&bc,&bm);
    let items2:[]u8=ob_alloc(3*DL_ITEMW);
    dlx_item(items2,0,"env-a front\0",DLK_CONTRA,X,1,4,4);
    dlx_item(items2,1,"env-b front\0",DLK_CONTRA,X,1,4,4);
    dlx_item(items2,2,"env-c front\0",DLK_CONTRA,X,1,4,4);
    let a2:i32=0;let t2:i32=-1;let w2:i32=0;let fw2:i32=0;
    let u2:i32=dlx_episode(items2,3,mode,be,bc,bm,&a2,&t2,&w2,&fw2);
    c12_out("f_","act",a2);c12_out("f_","targ",t2);c12_out("f_","rounds",u2);
    f=f+c12_check("f_","front_quarantine",a2,DLA_QUARANTINE);
    f=f+c12_check("f_","front_target",t2,X);
    f=f+c12_check("f_","front_rounds",u2,1);
    ob_free(items2);
    let items3:[]u8=ob_alloc(3*DL_ITEMW);
    dlx_item(items3,0,"env-a honest obs\0",DLK_OBS,4,1,0,0);
    dlx_item(items3,1,"env-b honest obs\0",DLK_OBS,4,1,0,0);
    dlx_item(items3,2,"env-c honest obs\0",DLK_OBS,4,1,0,0);
    let a3:i32=0;let t3:i32=-1;let w3:i32=0;let fw3:i32=0;
    let u3:i32=dlx_episode(items3,3,mode,be,bc,bm,&a3,&t3,&w3,&fw3);
    c12_out("h_","act",a3);c12_out("h_","rounds",u3);
    f=f+c12_check("h_","honest_hold",a3,DLA_HOLD);
    f=f+c12_check("h_","honest_rounds",u3,3);
    ob_free(items3);
    // baseline comparison for the same two controls
    let ze:[]u8=ob_alloc(0);let zc:[]u8=ob_alloc(0);let zm:[]u8=ob_alloc(0);
    dlx_state_new(&ze,&zc,&zm);
    let bi:[]u8=ob_alloc(3*DL_ITEMW);
    dlx_item(bi,0,"env-a front\0",DLK_CONTRA,X,1,4,4);
    dlx_item(bi,1,"env-b front\0",DLK_CONTRA,X,1,4,4);
    dlx_item(bi,2,"env-c front\0",DLK_CONTRA,X,1,4,4);
    let ba:i32=0;let bt:i32=-1;let bw:i32=0;let bf:i32=0;
    let bu:i32=dlx_episode(bi,3,BRK_BASE,ze,zc,zm,&ba,&bt,&bw,&bf);
    ob_free(bi);
    let bi2:[]u8=ob_alloc(3*DL_ITEMW);
    dlx_item(bi2,0,"env-a honest obs\0",DLK_OBS,4,1,0,0);
    dlx_item(bi2,1,"env-b honest obs\0",DLK_OBS,4,1,0,0);
    dlx_item(bi2,2,"env-c honest obs\0",DLK_OBS,4,1,0,0);
    let ha:i32=0;let ht:i32=-1;let hw:i32=0;let hf:i32=0;
    let hu:i32=dlx_episode(bi2,3,BRK_BASE,ze,zc,zm,&ha,&ht,&hw,&hf);
    ob_free(bi2);
    let same:i32=((a2==ba)&&(t2==bt)&&(u2==bu)&&(a3==ha)&&(u3==hu)) as i32;
    c12_out(px,"controls_match_baseline",same);
    f=f+c12_check(px,"c2b_controls",same,1);
    let killb:i32=0;
    if(same==0){killb=1;}
    c12_out(px,"c2b_kill",killb);
    if(killa==1){c12_verdict(px,"KILL","C2a': livelock persists under this breaker");}
    else{
        if(killb==1){c12_verdict(px,"KILL","C2b': breaker changed honest/front control behavior");}
        else{c12_verdict(px,"SURVIVE","C2a' resolved within 12 episodes; C2b' controls unchanged vs baseline");}
    }
    ob_free(estk);ob_free(carn);ob_free(carm);
    ob_free(quar_set);ob_free(revq);
    ob_free(be);ob_free(bc);ob_free(bm);ob_free(ze);ob_free(zc);ob_free(zm);
    return f;
}

fn c12_c2a()i32 {
    c12_out("c2a","breaker",BRK_CARRY);
    return c12_c2_battery("c2a",BRK_CARRY);
}
fn c12_c2b()i32 {
    c12_out("c2b","breaker",BRK_BUDGET);
    return c12_c2_battery("c2b",BRK_BUDGET);
}
fn c12_c2c()i32 {
    c12_out("c2c","breaker",BRK_DISCOUNT);
    return c12_c2_battery("c2c",BRK_DISCOUNT);
}

// ================= E. long-horizon =================
// C1 LH: E episodes of the repeated install+gate stream, chained brains
// of 20 episodes (PAM_CAP=64 rows; 3 rows/episode -> 60 max). Each
// episode: false premise (501) via M_COMMIT (auto-pin), true premise
// (777) via M_COMMIT (auto-pin), one REAL independent post-install PAM
// observation of 777. The false candidate's gate must REFUSE every
// episode; the true candidate's gate must PROMOTE every episode with
// the pin never the deciding factor. Gate decisions are pure
// predicates here (no mem mutation); the promote path is covered in
// the C1 battery.
fn c12_lh1(px:[]u8,rule:i32,E:i32)i32 {
    let f:i32=0;
    c12_head(px,"long_horizon");
    let EB:i32=20;
    let g:i32=0;
    let refuses:i32=0;let promotes:i32=0;let pindec:i32=0;let survbad:i32=0;
    while(g<E){
        let q:[]u8=ob_alloc(0);let qn:i32=0;
        let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
        let alog:[]u8=ob_alloc(0);let alogn:i32=0;
        let pam:[]u8=ob_alloc(0);let flog:[]u8=ob_alloc(0);let flogn:i32=0;
        let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);let pinned:[]u8=ob_alloc(0);
        let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);let step:[]u8=ob_alloc(0);
        let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);let trust:[]u8=ob_alloc(0);
        c12_brain_new(&q,&qn,&ast,&routes,&alog,&alogn,&pam,&flog,&flogn,
            &live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust);
        c12_stage_cal(flog,&flogn);
        let jc:[]u8=ob_alloc(MA_CAP*4);
        let adm:[]u8=ob_alloc(MA_CAP);
        let i:i32=0;
        while(i<MA_CAP){ob_s32(jc,i*4,-1);adm[i]=0;i=i+1;}
        let e2:i32=0;
        let geb:i32=0;
        while(e2<EB && g<E){
            let epf:i32=1+3*e2;
            ob_msg_enqueue(q,&qn,ARB_QCAP,epf,0,M_COMMIT,1,OBC_POL_FALSE);
            arb_process(epf,q,&qn,ast,routes,alog,&alogn,pam,flog,flogn,
                live,value,pinned,region,tier,step,maudit,mhdr,trust);
            let sf:i32=ob_g32(routes,(epf%ARB_ROUTES)*4);
            ob_msg_enqueue(q,&qn,ARB_QCAP,epf+1,0,M_COMMIT,1,OBC_POL_TRUE);
            arb_process(epf+1,q,&qn,ast,routes,alog,&alogn,pam,flog,flogn,
                live,value,pinned,region,tier,step,maudit,mhdr,trust);
            let st:i32=ob_g32(routes,((epf+1)%ARB_ROUTES)*4);
            if(sf>=0){ob_s32(jc,sf*4,OBC_POL_FALSE);adm[sf]=1;}
            if(st>=0){ob_s32(jc,st*4,OBC_POL_TRUE);adm[st]=1;}
            let orow:i32=pam_observe(pam,OBC_POL_TRUE,OBC_POL_TRUE,1000,1000,1,
                30,1030,7,350,350,350,epf+2);
            if(orow<0){f=f+1;}
            let surv:i32=c12_hyp_select(pinned,jc,sf,st);
            if(surv!=0){survbad=survbad+1;}
            let r1:i32=-1;let pm1:i32=0;let gn1:i32=0;let pv1:i32=0;
            let g1:i32=c12_gate_c1(rule,pinned,live,jc,adm,pam,alog,alogn,
                sf,OBC_POL_FALSE,sf,0,epf,&r1,&pm1,&gn1,&pv1);
            if(g1==0 && r1==9){refuses=refuses+1;}
            let r2:i32=-1;let pm2:i32=0;let gn2:i32=0;let pv2:i32=0;
            let g2:i32=c12_gate_c1(rule,pinned,live,jc,adm,pam,alog,alogn,
                st,OBC_POL_TRUE,st,0,epf+1,&r2,&pm2,&gn2,&pv2);
            if(g2==1){promotes=promotes+1;}
            if(pm2>0 && gn2==0){pindec=pindec+1;}
            e2=e2+1;g=g+1;geb=geb+1;
        }
        let an:i32=c12_mem_audit_n(mhdr);
        c12_out(px,"brain_episodes",geb);
        f=f+c12_check(px,"brain_audit_exact",an,2+3*geb);
        e2=0;
    }
    c12_out(px,"episodes",g);
    c12_out(px,"false_refused",refuses);
    c12_out(px,"true_promoted",promotes);
    c12_out(px,"pin_deciding",pindec);
    // survivor selection is informational: the real organ pin budget
    // (MM_MAX_PIN=16, frozen law) saturates under sustained M_COMMIT
    // auto-pinning, so f3_survivor flips from H_false to H_true once
    // auto-pins stop. The gate is evaluated on BOTH candidates every
    // episode regardless, so coverage is unaffected.
    c12_out(px,"survivor_false_n",g-survbad);
    c12_out(px,"survivor_true_n",survbad);
    f=f+c12_check(px,"all_false_refused",refuses,E);
    f=f+c12_check(px,"all_true_promoted",promotes,E);
    f=f+c12_check(px,"no_pin_deciding",pindec,0);
    if(refuses==E && promotes==E && pindec==0){
        c12_verdict(px,"SURVIVE","LH: gate behavior identical across horizon; no new failure mode");
    } else {
        c12_verdict(px,"KILL","LH: gate diverged at horizon");
    }
    return f;
}

// C2 LH: E episodes of mixed attack + noisy-honest stream. Attack
// (every 4th episode): the frozen {1,2,3} dribble vs X. Honest noise:
// one sub-quorum contradiction item vs a rotating claim (never X) +
// one honest observation. Metrics: episode X resolves, false
// quarantines (any quarantine/qreview of a non-X claim), byte-identity.
fn c12_lh2(px:[]u8,mode:i32,E:i32)i32 {
    let f:i32=0;
    c12_head(px,"long_horizon");
    let estk:[]u8=ob_alloc(0);let carn:[]u8=ob_alloc(0);let carm:[]u8=ob_alloc(0);
    dlx_state_new(&estk,&carn,&carm);
    let quar_set:[]u8=ob_alloc(16);
    let s:i32=0;
    while(s<16){quar_set[s]=0;s=s+1;}
    let X:i32=3;
    let resolve_e:i32=-1;
    let false_q:i32=0;let esc_n:i32=0;let dist_n:i32=0;let hold_n:i32=0;
    let e:i32=0;
    while(e<E){
        let items:[]u8=ob_alloc(3*DL_ITEMW);
        let n:i32=0;
        if(e%4==0 && quar_set[X]==0){
            dlx_item(items,0,"env-a contradicts X\0",DLK_CONTRA,X,1,4,4);
            dlx_item(items,1,"env-b contradicts X\0",DLK_CONTRA,X,2,4,4);
            dlx_item(items,2,"env-c contradicts X\0",DLK_CONTRA,X,3,4,4);
            n=3;
        } else {
            let c:i32=(e%14)+1;
            if(c>=X){c=c+1;}
            dlx_item(items,0,"noise contra item\0",DLK_CONTRA,c,1,0,4);
            dlx_item(items,1,"honest observation\0",DLK_OBS,c,1,0,0);
            n=2;
        }
        let act:i32=0;let targ:i32=-1;let why:i32=0;let fw:i32=0;
        let used:i32=dlx_episode(items,n,mode,estk,carn,carm,&act,&targ,&why,&fw);
        if(fw!=1){f=f+1;}
        if(act==DLA_QUARANTINE || act==DLA_QREVIEW){
            quar_set[targ]=1;
            if(targ==X){
                if(resolve_e<0){resolve_e=e;}
            } else {
                false_q=false_q+1;
            }
        }
        if(act==DLA_ESCALATE){esc_n=esc_n+1;}
        if(act==DLA_DISTRUST){dist_n=dist_n+1;}
        if(act==DLA_HOLD){hold_n=hold_n+1;}
        ob_free(items);
        e=e+1;
    }
    c12_out(px,"episodes",E);
    c12_out(px,"resolve_e",resolve_e);
    c12_out(px,"false_quarantines",false_q);
    c12_out(px,"escalations",esc_n);
    c12_out(px,"distrusts",dist_n);
    c12_out(px,"holds",hold_n);
    f=f+c12_check(px,"no_false_quarantines",false_q,0);
    // expected resolution episodes for the 1-in-4 attack density:
    // carry: e=1 (the carried picture completes at the next episode's
    // round 1); budget: e=8; discount: e=4.
    let expr:i32=1;
    if(mode==BRK_BUDGET){expr=8;}
    if(mode==BRK_DISCOUNT){expr=4;}
    f=f+c12_check(px,"resolve_ep",resolve_e,expr);
    if(false_q==0 && resolve_e==expr){
        c12_verdict(px,"SURVIVE","LH: X resolved at expected episode; zero false quarantines; honest stream identical");
    } else {
        c12_verdict(px,"KILL","LH: unexpected resolution timing or false quarantine");
    }
    ob_free(estk);ob_free(carn);ob_free(carm);ob_free(quar_set);
    return f;
}

// ================= F. main =================
fn main()i32 {
    let a1:[]u8=_zag_arg(1);
    if(_zag_strcmp(a1,"c1a")==1){return c12_c1a();}
    if(_zag_strcmp(a1,"c1b")==1){return c12_c1b();}
    if(_zag_strcmp(a1,"c2a")==1){return c12_c2a();}
    if(_zag_strcmp(a1,"c2b")==1){return c12_c2b();}
    if(_zag_strcmp(a1,"c2c")==1){return c12_c2c();}
    if(_zag_strcmp(a1,"lh1a10")==1){return c12_lh1("lh1a10",C12_RULE_A,10);}
    if(_zag_strcmp(a1,"lh1a100")==1){return c12_lh1("lh1a100",C12_RULE_A,100);}
    if(_zag_strcmp(a1,"lh1b10")==1){return c12_lh1("lh1b10",C12_RULE_B,10);}
    if(_zag_strcmp(a1,"lh1b100")==1){return c12_lh1("lh1b100",C12_RULE_B,100);}
    if(_zag_strcmp(a1,"lh2a10")==1){return c12_lh2("lh2a10",BRK_CARRY,10);}
    if(_zag_strcmp(a1,"lh2a100")==1){return c12_lh2("lh2a100",BRK_CARRY,100);}
    if(_zag_strcmp(a1,"lh2b10")==1){return c12_lh2("lh2b10",BRK_BUDGET,10);}
    if(_zag_strcmp(a1,"lh2b100")==1){return c12_lh2("lh2b100",BRK_BUDGET,100);}
    if(_zag_strcmp(a1,"lh2c10")==1){return c12_lh2("lh2c10",BRK_DISCOUNT,10);}
    if(_zag_strcmp(a1,"lh2c100")==1){return c12_lh2("lh2c100",BRK_DISCOUNT,100);}
    _zag_print("C12_USAGE,c1a|c1b|c2a|c2b|c2c|lh1a10|lh1a100|lh1b10|lh1b100|lh2a10|lh2a100|lh2b10|lh2b100|lh2c10|lh2c100");
    c12_nl();
    return 1;
}

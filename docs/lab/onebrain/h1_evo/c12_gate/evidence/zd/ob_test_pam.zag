// ob_test_pam.zag — unit test: the PAM admission organ standalone.
//
// A frozen script of 10 claim observations with known ground truth,
// run through the gate in both modes:
//   FRESH  (first install): ADMIT <=> M1/M2-overlap-audit + M3 + M4.
//   REVISE (replacing a contradicted install): FRESH bars + M9/cf1
//          historical corroboration (pointwise revision banned).
//
// Expected (frozen, from the v2 survivor mechanisms):
//   FRESH : admits = {0,1,7,8,9} (5); withholds = {2:DISAGREE, 3:LOWCONF,
//           4:OVERLAP, 5:NOTFRAGILE, 6:DEPENDENT}.
//   REVISE: admits = {1 (corroborated by 0), 9 (corroborated by 7)} (2);
//           withholds = 8, incl. the seq-1145 analog (slot 7: passes every
//           bar pointwise but is a singleton -> WITHHOLD UNCORROBORATED)
//           and the conf-tolerance case (slot 8: prior same-jcode rows
//           exist but conf outside +-50).
@import("ob_common.zag")
@import("ob_pam.zag")

fn add_claim(s:[]u8,jf:i32,jg:i32,cf:i32,cg:i32,indep:i32,
    spanf:i32,spang:i32,flip:i32,sh0:i32,sh1:i32,sh2:i32,ep:i32)i32 {
    return pam_observe(s,jf,jg,cf,cg,indep,spanf,spang,flip,sh0,sh1,sh2,ep);
}

fn load_script(s:[]u8)i32 {
    let f:i32=0;
    f=f+ob_check("pam","load0",add_claim(s,1,1,850,900,1,10,110,7,400,400,400,14),0);
    f=f+ob_check("pam","load1",add_claim(s,1,1,870,910,1,11,111,7,410,410,410,15),1);
    f=f+ob_check("pam","load2",add_claim(s,2,1,880,900,1,12,112,7,400,400,400,16),2);
    f=f+ob_check("pam","load3",add_claim(s,1,1,650,900,1,13,113,7,400,400,400,17),3);
    f=f+ob_check("pam","load4",add_claim(s,1,1,850,900,1,20,20,7,400,400,400,18),4);
    f=f+ob_check("pam","load5",add_claim(s,1,1,850,900,1,21,121,0,100,120,80,19),5);
    f=f+ob_check("pam","load6",add_claim(s,1,1,850,900,0,22,122,7,400,400,400,20),6);
    f=f+ob_check("pam","load7",add_claim(s,9,9,880,920,1,17,117,7,400,400,400,21),7);
    f=f+ob_check("pam","load8",add_claim(s,1,1,950,960,1,23,123,7,400,400,400,22),8);
    f=f+ob_check("pam","load9",add_claim(s,9,9,890,925,1,24,124,7,405,405,405,23),9);
    return f;
}

fn main()i32 {
    let f:i32=0;
    // ---- FRESH mode ----
    let s:[]u8=pam_new();
    f=f+load_script(s);
    let ev:[]u8=ob_alloc(10*4);   // expected verdicts FRESH
    let er:[]u8=ob_alloc(10*4);   // expected reasons FRESH
    ob_s32(ev,0,PAM_ADMIT);ob_s32(er,0,PAM_R_OK);
    ob_s32(ev,4,PAM_ADMIT);ob_s32(er,4,PAM_R_OK);
    ob_s32(ev,8,0);ob_s32(er,8,PAM_R_DISAGREE);
    ob_s32(ev,12,0);ob_s32(er,12,PAM_R_LOWCONF);
    ob_s32(ev,16,0);ob_s32(er,16,PAM_R_OVERLAP);
    ob_s32(ev,20,0);ob_s32(er,20,PAM_R_NOTFRAGILE);
    ob_s32(ev,24,0);ob_s32(er,24,PAM_R_DEPENDENT);
    ob_s32(ev,28,PAM_ADMIT);ob_s32(er,28,PAM_R_OK);
    ob_s32(ev,32,PAM_ADMIT);ob_s32(er,32,PAM_R_OK);
    ob_s32(ev,36,PAM_ADMIT);ob_s32(er,36,PAM_R_OK);
    let i:i32=0;
    while(i<10){
        let v:i32=-1;let r:i32=-1;
        pam_verdict(s,i,PAM_MODE_FRESH,&v,&r);
        f=f+ob_check("pamf","v",v,ob_g32(ev,i*4));
        f=f+ob_check("pamf","r",r,ob_g32(er,i*4));
        i=i+1;
    }
    f=f+ob_check("pamf","ledger_n",pam_ledger_n(s),10);
    f=f+ob_check("pamf","admits",pam_ledger_count_verdict(s,10,PAM_ADMIT),5);
    f=f+ob_check("pamf","withholds",pam_ledger_count_verdict(s,10,PAM_WITHHOLD),5);
    // ---- REVISE mode ----
    let s2:[]u8=pam_new();
    f=f+load_script(s2);
    let ev2:[]u8=ob_alloc(10*4);
    let er2:[]u8=ob_alloc(10*4);
    ob_s32(ev2,0,0);ob_s32(er2,0,PAM_R_UNCORROBORATED);
    ob_s32(ev2,4,PAM_ADMIT);ob_s32(er2,4,PAM_R_OK);
    ob_s32(ev2,8,0);ob_s32(er2,8,PAM_R_DISAGREE);
    ob_s32(ev2,12,0);ob_s32(er2,12,PAM_R_LOWCONF);
    ob_s32(ev2,16,0);ob_s32(er2,16,PAM_R_OVERLAP);
    ob_s32(ev2,20,0);ob_s32(er2,20,PAM_R_NOTFRAGILE);
    ob_s32(ev2,24,0);ob_s32(er2,24,PAM_R_DEPENDENT);
    ob_s32(ev2,28,0);ob_s32(er2,28,PAM_R_UNCORROBORATED);
    ob_s32(ev2,32,0);ob_s32(er2,32,PAM_R_UNCORROBORATED);
    ob_s32(ev2,36,PAM_ADMIT);ob_s32(er2,36,PAM_R_OK);
    i=0;
    while(i<10){
        let v:i32=-1;let r:i32=-1;
        pam_verdict(s2,i,PAM_MODE_REVISE,&v,&r);
        f=f+ob_check("pamr","v",v,ob_g32(ev2,i*4));
        f=f+ob_check("pamr","r",r,ob_g32(er2,i*4));
        i=i+1;
    }
    f=f+ob_check("pamr","ledger_n",pam_ledger_n(s2),10);
    f=f+ob_check("pamr","admits",pam_ledger_count_verdict(s2,10,PAM_ADMIT),2);
    f=f+ob_check("pamr","withholds",pam_ledger_count_verdict(s2,10,PAM_WITHHOLD),8);
    f=f+ob_check("pamr","uncorroborated",pam_ledger_count_reason(s2,10,PAM_R_UNCORROBORATED),3);
    ob_free(s);ob_free(s2);ob_free(ev);ob_free(er);ob_free(ev2);ob_free(er2);
    _zag_print("OB_FAILURES,");
    let t:[]u8=_zag_i64_to_str(f as i64);_zag_print(t);ob_free(t);
    _zag_println("");
    return (f!=0) as i32;
}

// ob_test_arbiter.zag — composition smoke: FL2 organ -> arbiter ->
// PAM organ + memory organ, one episode at a time, honest and lying
// streams. Asserts the precedence rules fire in order (P0..P5) and the
// end-to-end routing is correct. This is a SMOKE test of the composition
// loop, not a trial: no curriculum verdicts are drawn from it.
//
// Frozen expectations (from the precedence hypotheses):
//   honest: E14 PROPOSE -> PAM FRESH ADMIT -> MEM install (route[14]);
//           E15 disconnect logged; E48 PROMOTE -> slot LONG; no drops.
//   lying:  E14 PROPOSE(REKEY) -> FRESH ADMIT -> install; E29 REVOKE ->
//           MEM kill (route cleared, prov cleared); E29 COMMIT(CONTEST) ->
//           PAM FRESH ADMIT -> MEM install + deliberate PIN (the defect
//           fix 2026-09-24: M_COMMIT gates FRESH, so the novel survivor
//           installs instead of withholding as UNCORROBORATED).
//   synthetic: a COMMIT (with two corroborating priors present, now
//           irrelevant to the FRESH gate) -> FRESH ADMIT -> MEM install +
//           the memory organ's own deliberate PIN (M_MEM_SAFETY) while
//           uncertain.
@import("ob_common.zag")
@import("ob_tn.zag")
@import("ob_fl2.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")
@import("ob_arbiter.zag")

fn acount(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code){c=c+1;}
        i=i+1;
    }
    return c;
}

fn acount2(alog:[]u8,n:i32,code:i32,a1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn mem_live_count(live:[]u8)i32 {
    let c:i32=0;let i:i32=0;
    while(i<MA_CAP){if(live[i]!=0){c=c+1;}i=i+1;}
    return c;
}

fn brain_new(px:[]u8,fl2:*[]u8,flog:*[]u8,out:*[]u8,pam:*[]u8,
    live:*[]u8,value:*[]u8,pinned:*[]u8,region:*[]u8,tier:*[]u8,step:*[]u8,
    maudit:*[]u8,mhdr:*[]u8,trust:*[]u8,
    ast:*[]u8,routes:*[]u8,alog:*[]u8)i32 {
    fl2.*=obf_new();
    flog.*=ob_alloc(OBF_LOGCAP*16);
    out.*=ob_alloc(OBF_OUTCAP*16);
    pam.*=pam_new();
    live.*=mm_new_live();value.*=mm_new_value();pinned.*=mm_new_pinned();
    region.*=mm_new_region();tier.*=mm_new_tier();step.*=mm_new_step();
    maudit.*=mm_new_audit();mhdr.*=mm_new_hdr();trust.*=mm_new_trust();
    // staged autonomy is trainer-gated: the brain advances to FULL
    // (documented; the organ unit test covers the staging itself).
    mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*);
    mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*);
    ast.*=arb_new_state();routes.*=arb_new_routes();
    alog.*=ob_alloc(ARB_ACAP*16);
    return 0;
}

fn brain_run(stated:i32,teach_aux:i32,px:[]u8,lying:i32)i32 {
    let f:i32=0;
    let fl2:[]u8=ob_alloc(0);let flog:[]u8=ob_alloc(0);let out:[]u8=ob_alloc(0);
    let pam:[]u8=ob_alloc(0);
    let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);
    let tier:[]u8=ob_alloc(0);let step:[]u8=ob_alloc(0);
    let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);let trust:[]u8=ob_alloc(0);
    let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);let alog:[]u8=ob_alloc(0);
    let contra:[]u8=arb_new_contra();
    brain_new(px,&fl2,&flog,&out,&pam,&live,&value,&pinned,&region,&tier,&step,
        &maudit,&mhdr,&trust,&ast,&routes,&alog);
    let fln:i32=0;let on:i32=0;let ord:i32=0;let aln:i32=0;
    let ep:i32=1;
    while(ep<=TN_EPISODES){
        obf_step(fl2,ep,stated,teach_aux,flog,&fln,out,&on,&ord);
        arb_process(ep,out,&on,ast,routes,alog,&aln,pam,flog,fln,contra,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        ep=ep+1;
    }
    // PAM saw exactly the organ's intents: 1 claim honest, 2 lying
    f=f+ob_check(px,"pam_claims",pam_n(pam),1+lying);
    // verdicts: honest 1 ADMIT (fresh PROPOSE); lying 2 ADMITs (fresh
    // REKEY PROPOSE + fresh CONTEST COMMIT — M_COMMIT gates FRESH since
    // the 2026-09-24 defect fix; no withholds, no drops.
    f=f+ob_check(px,"verdict_admit",acount2(alog,aln,M_PAM_VERDICT,PAM_ADMIT),1+lying);
    f=f+ob_check(px,"verdict_withhold",acount2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD),0);
    f=f+ob_check(px,"drops",acount(alog,aln,ARB_DROP),0);
    f=f+ob_check(px,"refusals",acount(alog,aln,ARB_REFUSED),0);
    let slot:i32=ob_g32(routes,14*4);
    if(lying==0){
        f=f+ob_check(px,"route14",slot>=0,1);
        f=f+ob_check(px,"installed_long",region[slot],MA_REGION_LONG);
        f=f+ob_check(px,"live_n",mem_live_count(live),2);
        f=f+ob_check(px,"prov_claim",ob_g32(ast,0),14);
        f=f+ob_check(px,"promotes",acount(alog,aln,M_PROMOTE),1);
    } else {
        f=f+ob_check(px,"route14_cleared",slot,-1);
        // REKEY killed, CONTEST survivor installed via the fixed FRESH gate
        f=f+ob_check(px,"live_n",mem_live_count(live),2);
        f=f+ob_check(px,"prov_cleared",ob_g32(ast,0),-1);
        f=f+ob_check(px,"revokes",acount(alog,aln,M_REVOKE),1);
    }
    f=f+ob_check(px,"disconnects",acount(alog,aln,M_DISCONNECT),1);
    _zag_print("OB_INFO,");_zag_print(px);_zag_print("arb_audit_total,");
    let ai:[]u8=_zag_i64_to_str(aln as i64);_zag_print(ai);ob_free(ai);
    _zag_println("");
    _zag_print("OB_INFO,");_zag_print(px);_zag_print("mem_audit_total,");
    let mi:[]u8=_zag_i64_to_str(ob_g32(mhdr,8) as i64);_zag_print(mi);ob_free(mi);
    _zag_println("");
    ob_free(fl2);ob_free(flog);ob_free(out);ob_free(pam);
    ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);ob_free(contra);
    return f;
}

fn test_commit_pin()i32 {
    let f:i32=0;
    let px:[]u8="obc_";
    let pam:[]u8=pam_new();
    // two corroborating priors: same jcode, bars pass, conf within 50 of
    // the derived claim conf (250*cal=1000 at cal=4). Under the R1 novelty
    // repair the commit routes REVISE (policy 1 has prior rows); the
    // priors corroborate, so the verdict is unchanged: FRESH-mode intent
    // (admit the bar-passing claim) is preserved through REVISE.
    pam_observe(pam,1,1,960,970,1,10,110,7,400,400,400,14);
    pam_observe(pam,1,1,980,990,1,11,111,7,410,410,410,15);
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();
    let trust:[]u8=mm_new_trust();
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let ast:[]u8=arb_new_state();let routes:[]u8=arb_new_routes();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let contra:[]u8=arb_new_contra();
    // fake FL2 trace: 4 passing calibrations -> cal=4 -> conf=1000
    let flog:[]u8=ob_alloc(4*16);
    let i:i32=0;
    while(i<4){
        ob_s32(flog,i*16,11+i);ob_s32(flog,i*16+4,TN_OP_CALIBRATE);
        ob_s32(flog,i*16+8,0);ob_s32(flog,i*16+12,1);
        i=i+1;
    }
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    ob_s32(q,0,(30<<16)|0);ob_s32(q,4,M_COMMIT);ob_s32(q,8,1);ob_s32(q,12,1);
    qn=1;
    arb_process(30,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+ob_check(px,"verdict_admit",acount2(alog,aln,M_PAM_VERDICT,PAM_ADMIT),1);
    let slot:i32=ob_g32(routes,30*4);
    f=f+ob_check(px,"route30",slot>=0,1);
    f=f+ob_check(px,"installed",live[slot],1);
    f=f+ob_check(px,"safety_pin_announced",acount(alog,aln,M_MEM_SAFETY),1);
    f=f+ob_check(px,"pinned_learner",pinned[slot],MA_PIN_LEARNER);
    f=f+ob_check(px,"drops",acount(alog,aln,ARB_DROP),0);
    ob_free(pam);ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);ob_free(flog);ob_free(q);ob_free(contra);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+brain_run(ACT_CONTEST,0,"obh_",0);
    f=f+brain_run(ACT_REKEY,1,"obl_",1);
    f=f+test_commit_pin();
    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

// r2_atk.zag — R2 repair-attack probes on d8f3539a (P1-alt FIFO + C3/C7 + seq).
// Prereg: ~/workspace/ob2_repairatk/PREREG_REPAIRATK.md (frozen before running).
// Pure Zag, zero RNG, 3x byte-identical.
@import("ob_common.zag")
@import("ob_tn.zag")
@import("ob_fl2.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")
@import("ob_arbiter.zag")

fn setup(pam:*[]u8,live:*[]u8,value:*[]u8,pinned:*[]u8,region:*[]u8,
    tier:*[]u8,step:*[]u8,maudit:*[]u8,mhdr:*[]u8,trust:*[]u8,
    ast:*[]u8,routes:*[]u8,alog:*[]u8,aln:*i32)i32 {
    pam.*=pam_new();
    live.*=mm_new_live();value.*=mm_new_value();pinned.*=mm_new_pinned();
    region.*=mm_new_region();tier.*=mm_new_tier();step.*=mm_new_step();
    maudit.*=mm_new_audit();mhdr.*=mm_new_hdr();trust.*=mm_new_trust();
    if(mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*)!=0){return -1;}
    if(mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*)!=0){return -1;}
    ast.*=arb_new_state();routes.*=arb_new_routes();
    alog.*=ob_alloc(ARB_ACAP*16);
    aln.*=0;
    return 0;
}

fn mkflog(flog:[]u8,cal:i32)void {
    let i:i32=0;
    while(i<cal){
        ob_s32(flog,i*16,100+i);ob_s32(flog,i*16+4,TN_OP_CALIBRATE);
        ob_s32(flog,i*16+8,0);ob_s32(flog,i*16+12,1);
        i=i+1;
    }
    return;
}

fn enq(q:[]u8,qn:*i32,mtype:i32,a1:i32,a2:i32)i32 {
    let n:i32=qn.*;
    ob_s32(q,n*16,0);
    ob_s32(q,n*16+4,mtype);ob_s32(q,n*16+8,a1);ob_s32(q,n*16+12,a2);
    qn.*=n+1;
    return 0;
}

fn acount(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code){c=c+1;}
        i=i+1;
    }
    return c;
}

fn acount2(alog:[]u8,n:i32,code:i32,a1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1){c=c+1;}
        i=i+1;
    }
    return c;
}

// arg2 of the first audit entry with (code,a1)
fn afind_a2(alog:[]u8,n:i32,code:i32,a1:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1){
            return ob_g32(alog,i*16+12);
        }
        i=i+1;
    }
    return -999999;
}

fn kb(px:[]u8,fired:i32)void {
    _zag_print(px);_zag_print("_KILLBAR,");
    let s:[]u8=_zag_i64_to_str(fired as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return;
}

fn freebrain(pam:[]u8,live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,
    step:[]u8,maudit:[]u8,mhdr:[]u8,trust:[]u8,ast:[]u8,routes:[]u8,alog:[]u8,contra:[]u8)void {
    ob_free(pam);ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);ob_free(contra);
    return;
}

// R2a: double revoke vs one promote, both emission orders.
// Kill: silent drop (a revoke with zero audit entries) or PROMOTE applied
// in order 1 despite the pending revoke.
fn r2a()i32 {
    let f:i32=0;
    let px:[]u8="r2a_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let contra:[]u8=arb_new_contra();
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    // order 1: PROMOTE then two REVOKEs
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,5);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s0:i32=ob_g32(routes,5*4);
    mkflog(flog,4);qn=0;
    enq(q,&qn,M_PROMOTE,11,0);enq(q,&qn,M_REVOKE,11,0);enq(q,&qn,M_REVOKE,11,0);
    arb_process(1,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+ob_check(px,"o1_refused204",acount2(alog,aln,ARB_REFUSED_CONTRADICTED,M_PROMOTE),1);
    f=f+ob_check(px,"o1_cite",afind_a2(alog,aln,ARB_REFUSED_CONTRADICTED,M_PROMOTE),(1<<16)|1);
    f=f+ob_check(px,"o1_promote_applied",acount2(alog,aln,M_PROMOTE,11),0);
    f=f+ob_check(px,"o1_revoke_audited",acount2(alog,aln,M_REVOKE,11),1);
    f=f+ob_check(px,"o1_drop2nd",acount2(alog,aln,ARB_DROP,M_REVOKE),1);
    f=f+ob_check(px,"o1_s0_dead",live[s0],0);
    let silent1:i32=((acount2(alog,aln,M_REVOKE,11)+acount2(alog,aln,ARB_DROP,M_REVOKE))!=2) as i32;
    let applied1:i32=(acount2(alog,aln,M_PROMOTE,11)!=0) as i32;
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog,contra);
    // order 2: two REVOKEs then PROMOTE (both adjudicated first)
    let pam2:[]u8=ob_alloc(0);let live2:[]u8=ob_alloc(0);let value2:[]u8=ob_alloc(0);
    let pinned2:[]u8=ob_alloc(0);let region2:[]u8=ob_alloc(0);let tier2:[]u8=ob_alloc(0);
    let step2:[]u8=ob_alloc(0);let maudit2:[]u8=ob_alloc(0);let mhdr2:[]u8=ob_alloc(0);
    let trust2:[]u8=ob_alloc(0);let ast2:[]u8=ob_alloc(0);let routes2:[]u8=ob_alloc(0);
    let alog2:[]u8=ob_alloc(0);let aln2:i32=0;
    f=f+setup(&pam2,&live2,&value2,&pinned2,&region2,&tier2,&step2,&maudit2,&mhdr2,&trust2,&ast2,&routes2,&alog2,&aln2);
    let contra2:[]u8=arb_new_contra();
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,5);
    arb_process(0,q,&qn,ast2,routes2,alog2,&aln2,pam2,flog,4,contra2,
        live2,value2,pinned2,region2,tier2,step2,maudit2,mhdr2,trust2);
    mkflog(flog,4);qn=0;
    enq(q,&qn,M_REVOKE,11,0);enq(q,&qn,M_REVOKE,11,0);enq(q,&qn,M_PROMOTE,11,0);
    arb_process(1,q,&qn,ast2,routes2,alog2,&aln2,pam2,flog,4,contra2,
        live2,value2,pinned2,region2,tier2,step2,maudit2,mhdr2,trust2);
    f=f+ob_check(px,"o2_no204",acount(alog2,aln2,ARB_REFUSED_CONTRADICTED),0);
    f=f+ob_check(px,"o2_revoke_audited",acount2(alog2,aln2,M_REVOKE,11),1);
    f=f+ob_check(px,"o2_drops",acount(alog2,aln2,ARB_DROP),2);
    let silent2:i32=((acount2(alog2,aln2,M_REVOKE,11)+acount2(alog2,aln2,ARB_DROP,M_REVOKE))!=2) as i32;
    kb(px,(silent1||silent2||applied1) as i32);
    freebrain(pam2,live2,value2,pinned2,region2,tier2,step2,maudit2,mhdr2,trust2,ast2,routes2,alog2,contra2);
    ob_free(flog);ob_free(q);
    return f;
}

// R2b: window-boundary cells. Kill: any misfire.
fn r2b_cell(cell:i32)i32 {
    let f:i32=0;
    let px:[]u8="r2b_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let contra:[]u8=arb_new_contra();
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,5);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s0:i32=ob_g32(routes,5*4);
    mkflog(flog,4);qn=0;
    if(cell==1){enq(q,&qn,M_PROMOTE,11,0);enq(q,&qn,M_REVOKE,11,0);}
    if(cell==2){enq(q,&qn,M_REVOKE,11,0);enq(q,&qn,M_PROMOTE,11,0);}
    if(cell==3){enq(q,&qn,M_PROMOTE,11,0);}
    if(cell==4){enq(q,&qn,M_PROMOTE,11,0);enq(q,&qn,M_REVOKE,22,0);}
    arb_process(1,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    if(cell==1){
        f=f+ob_check(px,"c1_204",acount2(alog,aln,ARB_REFUSED_CONTRADICTED,M_PROMOTE),1);
        f=f+ob_check(px,"c1_notapplied",acount2(alog,aln,M_PROMOTE,11),0);
    }
    if(cell==2){
        f=f+ob_check(px,"c2_no204",acount(alog,aln,ARB_REFUSED_CONTRADICTED),0);
        f=f+ob_check(px,"c2_pdrop",acount2(alog,aln,ARB_DROP,M_PROMOTE),1);
    }
    if(cell==3){
        f=f+ob_check(px,"c3_no204",acount(alog,aln,ARB_REFUSED_CONTRADICTED),0);
        f=f+ob_check(px,"c3_applied",acount2(alog,aln,M_PROMOTE,11),1);
        f=f+ob_check(px,"c3_long",region[s0],MA_REGION_LONG);
    }
    if(cell==4){
        f=f+ob_check(px,"c4_no204",acount(alog,aln,ARB_REFUSED_CONTRADICTED),0);
        f=f+ob_check(px,"c4_applied",acount2(alog,aln,M_PROMOTE,11),1);
        f=f+ob_check(px,"c4_long",region[s0],MA_REGION_LONG);
    }
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog,contra);
    ob_free(flog);ob_free(q);
    return f;
}

fn r2b()i32 {
    let f0:i32=0;
    f0=f0+r2b_cell(1);f0=f0+r2b_cell(2);f0=f0+r2b_cell(3);f0=f0+r2b_cell(4);
    kb("r2b_", (f0!=0) as i32);
    return f0;
}

// R2c: hostile organ ord values must be ignored; seq re-stamped at receipt.
// Kill: dispatch follows organ ord, or any organ seq survives re-stamp.
fn r2c()i32 {
    let f:i32=0;
    let px:[]u8="r2c_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let contra:[]u8=arb_new_contra();
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,5);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    // hostile ords via the real enqueue path (organ-controlled ord)
    mkflog(flog,4);qn=0;
    let r0:i32=ob_msg_enqueue(q,&qn,ARB_QCAP,1,999,M_PROPOSE_INSTALL,11,5);
    let r1:i32=ob_msg_enqueue(q,&qn,ARB_QCAP,1,(1<<16)|0,M_PROMOTE,11,0);
    let r2:i32=ob_msg_enqueue(q,&qn,ARB_QCAP,1,0-5,M_REVOKE,11,0);
    f=f+ob_check(px,"enq_ok",(r0+r1+r2),0);
    arb_process(1,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    // re-stamp proof: q words must be (1<<16)|i regardless of hostile ord
    let stamp_ok:i32=1;
    let i:i32=0;
    while(i<3){
        if(ob_g32(q,i*16)!=(1<<16)|i){stamp_ok=0;}
        i=i+1;
    }
    f=f+ob_check(px,"restamp",stamp_ok,1);
    // arrival order honored: PROMOTE(idx1) refused (REVOKE pending at idx2),
    // not applied. If organ ord were honored, REVOKE(ord=-5) would go first.
    f=f+ob_check(px,"refused204",acount2(alog,aln,ARB_REFUSED_CONTRADICTED,M_PROMOTE),1);
    f=f+ob_check(px,"not_applied",acount2(alog,aln,M_PROMOTE,11),0);
    let kill:i32=((stamp_ok!=1) || (acount2(alog,aln,M_PROMOTE,11)!=0)) as i32;
    kb(px,kill);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog,contra);
    ob_free(flog);ob_free(q);
    return f;
}

// R2d: dropped-but-adjudicated revoke must be audit-distinguishable from never-sent.
// Kill: dropped revoke leaves zero audit entries.
fn r2d()i32 {
    let f:i32=0;
    let px:[]u8="r2d_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let contra:[]u8=arb_new_contra();
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,5);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    // mismatched-policy revoke -> ARB_DROP (adjudicated, dropped)
    mkflog(flog,4);qn=0;enq(q,&qn,M_REVOKE,22,0);
    arb_process(1,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let drop_seen:i32=acount2(alog,aln,ARB_DROP,M_REVOKE);
    f=f+ob_check(px,"drop_audited",drop_seen,1);
    // control: no revoke sent at all
    let pam2:[]u8=ob_alloc(0);let live2:[]u8=ob_alloc(0);let value2:[]u8=ob_alloc(0);
    let pinned2:[]u8=ob_alloc(0);let region2:[]u8=ob_alloc(0);let tier2:[]u8=ob_alloc(0);
    let step2:[]u8=ob_alloc(0);let maudit2:[]u8=ob_alloc(0);let mhdr2:[]u8=ob_alloc(0);
    let trust2:[]u8=ob_alloc(0);let ast2:[]u8=ob_alloc(0);let routes2:[]u8=ob_alloc(0);
    let alog2:[]u8=ob_alloc(0);let aln2:i32=0;
    f=f+setup(&pam2,&live2,&value2,&pinned2,&region2,&tier2,&step2,&maudit2,&mhdr2,&trust2,&ast2,&routes2,&alog2,&aln2);
    let contra2:[]u8=arb_new_contra();
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,5);
    arb_process(0,q,&qn,ast2,routes2,alog2,&aln2,pam2,flog,4,contra2,
        live2,value2,pinned2,region2,tier2,step2,maudit2,mhdr2,trust2);
    qn=0;
    arb_process(1,q,&qn,ast2,routes2,alog2,&aln2,pam2,flog,4,contra2,
        live2,value2,pinned2,region2,tier2,step2,maudit2,mhdr2,trust2);
    let ctrl:i32=acount(alog2,aln2,ARB_DROP)+acount(alog2,aln2,M_REVOKE);
    f=f+ob_check(px,"control_clean",ctrl,0);
    let kill:i32=((drop_seen==0) || (ctrl!=0)) as i32;
    kb(px,kill);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog,contra);
    freebrain(pam2,live2,value2,pinned2,region2,tier2,step2,maudit2,mhdr2,trust2,ast2,routes2,alog2,contra2);
    ob_free(flog);ob_free(q);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+r2a();
    f=f+r2b();
    f=f+r2c();
    f=f+r2d();
    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

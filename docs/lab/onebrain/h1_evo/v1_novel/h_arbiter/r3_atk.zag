// r3_atk.zag — R3 repair-attack probes on f3b4acaa (ep%ARB_ROUTES ring).
// Prereg: ~/workspace/ob2_repairatk/PREREG_REPAIRATK.md (frozen before running).
// Pure Zag, zero RNG, 3x byte-identical.
// R3b (a2 OOB panic) lives in r3b_panic.zag (separate binary: the panic is
// the evidence and must not take down this probe).
@import("ob_common.zag")
@import("ob_tn.zag")
@import("ob_fl2.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")
@import("ob_arbiter.zag")

fn setup(pam:*[]u8,live:*[]u8,value:*[]u8,pinned:*[]u8,region:*[]u8,
    tier:*[]u8,step:*[]u8,maudit:*[]u8,mhdr:*[]u8,trust:*[]u8,
    ast:*[]u8,routes:*[]u8,alog:*[]u8,aln:*i32)i32 {
    pam.*=pam_new();
    live.*=mm_new_live();value.*=mm_new_value();pinned.*=mm_new_pinned();
    region.*=mm_new_region();tier.*=mm_new_tier();step.*=mm_new_step();
    maudit.*=mm_new_audit();mhdr.*=mm_new_hdr();trust.*=mm_new_trust();
    if(mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*)!=0){return -1;}
    if(mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*)!=0){return -1;}
    ast.*=arb_new_state();routes.*=arb_new_routes();
    alog.*=ob_alloc(ARB_ACAP*16);
    aln.*=0;
    return 0;
}

fn mkflog(flog:[]u8,cal:i32)void {
    let i:i32=0;
    while(i<cal){
        ob_s32(flog,i*16,100+i);ob_s32(flog,i*16+4,TN_OP_CALIBRATE);
        ob_s32(flog,i*16+8,0);ob_s32(flog,i*16+12,1);
        i=i+1;
    }
    return;
}

fn enq(q:[]u8,qn:*i32,mtype:i32,a1:i32,a2:i32)i32 {
    let n:i32=qn.*;
    ob_s32(q,n*16,0);
    ob_s32(q,n*16+4,mtype);ob_s32(q,n*16+8,a1);ob_s32(q,n*16+12,a2);
    qn.*=n+1;
    return 0;
}

fn acount(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code){c=c+1;}
        i=i+1;
    }
    return c;
}

fn acount2(alog:[]u8,n:i32,code:i32,a1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1){c=c+1;}
        i=i+1;
    }
    return c;
}

// mem-audit count with (op,slot,rc)
fn mcount3(maudit:[]u8,mhdr:[]u8,op:i32,slot:i32,rc:i32)i32 {
    let n:i32=ob_g32(mhdr,8);
    let c:i32=0;let i:i32=0;
    while(i<n){
        let e:i32=i*MA_EW*4;
        if(ob_g32(maudit,e+4)==op && ob_g32(maudit,e+8)==slot && ob_g32(maudit,e+12)==rc){c=c+1;}
        i=i+1;
    }
    return c;
}

fn kb(px:[]u8,fired:i32)void {
    _zag_print(px);_zag_print("_KILLBAR,");
    let s:[]u8=_zag_i64_to_str(fired as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return;
}

fn freebrain(pam:[]u8,live:[]u8,value:[]u8,pinned:[]u8,region:[]u8,tier:[]u8,
    step:[]u8,maudit:[]u8,mhdr:[]u8,trust:[]u8,ast:[]u8,routes:[]u8,alog:[]u8,contra:[]u8)void {
    ob_free(pam);ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);ob_free(contra);
    return;
}

// R3a leg 1: cross-episode contamination.
// ep0: PROPOSE(11, claim 0) -> S0, routes[0]=S0, ast={0,11}.
// eps 1..128: empty. ep129: COMMIT(1,22) -> S1 clobbers routes[0];
// then PROMOTE(11) must NOT promote S1 (Q's survivor).
// Kill: region[S1]==LONG (wrong-slot promote) i.e. routes[0] clobbered
// while S0 live.
fn r3a_xep()i32 {
    let f:i32=0;
    let px:[]u8="r3a_xep_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let contra:[]u8=arb_new_contra();
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,0);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s0:i32=ob_g32(routes,0);
    f=f+ob_check(px,"ep0_s0",s0>=0,1);
    f=f+ob_check(px,"ep0_ast",ob_g32(ast,0),0);
    let ep:i32=1;
    while(ep<129){
        qn=0;
        arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,0,contra,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        ep=ep+1;
    }
    f=f+ob_check(px,"pre129_routes0_intact",ob_g32(routes,0),s0);
    f=f+ob_check(px,"pre129_s0_live",live[s0],1);
    // ep129: commit Q -> ring slot (129%129)=0 clobbers routes[0]
    mkflog(flog,4);qn=0;enq(q,&qn,M_COMMIT,1,22);
    arb_process(129,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s1:i32=ob_g32(routes,0);
    f=f+ob_check(px,"ep129_commit_ok",s1>=0,1);
    f=f+ob_check(px,"ep129_clobbered",s1!=s0,1);
    // now PROMOTE(11): should target S0, but routes[0]=S1
    qn=0;enq(q,&qn,M_PROMOTE,11,0);
    arb_process(129,q,&qn,ast,routes,alog,&aln,pam,flog,0,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+ob_check(px,"wrong_promote",region[s1],MA_REGION_LONG);
    f=f+ob_check(px,"right_untouched",region[s0],MA_REGION_USER);
    f=f+ob_check(px,"s0_still_live",live[s0],1);
    let kill:i32=((region[s1]==MA_REGION_LONG) && (s1!=s0)) as i32;
    kb(px,kill);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog,contra);
    ob_free(flog);ob_free(q);
    return f;
}

// R3a leg 2: same-episode variant (ep5, claim 5).
fn r3a_sameep()i32 {
    let f:i32=0;
    let px:[]u8="r3a_same_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let contra:[]u8=arb_new_contra();
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;
    enq(q,&qn,M_PROPOSE_INSTALL,11,5);
    enq(q,&qn,M_COMMIT,1,22);
    enq(q,&qn,M_PROMOTE,11,0);
    arb_process(5,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    // routes[5*4]: propose wrote S0, commit (5%129=5) clobbered with S1
    let s1:i32=ob_g32(routes,5*4);
    f=f+ob_check(px,"wrong_promote",region[s1],MA_REGION_LONG);
    let kill:i32=(region[s1]==MA_REGION_LONG) as i32;
    kb(px,kill);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog,contra);
    ob_free(flog);ob_free(q);
    return f;
}

// R3a leg 3: REVOKE misrouting variant — the revoke aimed at policy 11's
// provisional lands on the survivor S1 (bounces off its safety pin).
fn r3a_revoke()i32 {
    let f:i32=0;
    let px:[]u8="r3a_rev_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let contra:[]u8=arb_new_contra();
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,0);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s0:i32=ob_g32(routes,0);
    mkflog(flog,4);qn=0;enq(q,&qn,M_COMMIT,1,22);
    arb_process(129,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s1:i32=ob_g32(routes,0);
    f=f+ob_check(px,"clobbered",s1!=s0,1);
    f=f+ob_check(px,"s1_pinned",pinned[s1],MA_PIN_LEARNER);
    qn=0;enq(q,&qn,M_REVOKE,11,0);
    arb_process(129,q,&qn,ast,routes,alog,&aln,pam,flog,0,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    // the kill was attempted on S1 (wrong slot), refused on its pin;
    // the intended target S0 survives, unreachable.
    f=f+ob_check(px,"kill_on_wrong_slot",mcount3(maudit,mhdr,MA_OP_KILL,s1,MA_REFUSED_PINNED),1);
    f=f+ob_check(px,"s0_survives",live[s0],1);
    f=f+ob_check(px,"s1_survives",live[s1],1);
    f=f+ob_check(px,"routes_still_clobbered",ob_g32(routes,0),s1);
    let kill:i32=(mcount3(maudit,mhdr,MA_OP_KILL,s1,MA_REFUSED_PINNED)==1) as i32;
    kb(px,kill);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog,contra);
    ob_free(flog);ob_free(q);
    return f;
}

// R3c leg 1: 300-episode COMMIT sweep — no panic.
fn r3c_nopanic()i32 {
    let f:i32=0;
    let px:[]u8="r3c_np_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let contra:[]u8=arb_new_contra();
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    let ep:i32=0;
    while(ep<300){
        mkflog(flog,4);qn=0;enq(q,&qn,M_COMMIT,1,30+(ep%5));
        arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        ep=ep+1;
    }
    // PAM_CAP=64 rows: 64 installs, 236 ARB_DROPs (backpressure, not failure)
    f=f+ob_check(px,"installs",acount(alog,aln,M_PAM_VERDICT)-acount2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD),64);
    f=f+ob_check(px,"drops",acount2(alog,aln,ARB_DROP,M_COMMIT),236);
    f=f+ob_check(px,"completed_300",ep,300);
    kb(px,0);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog,contra);
    ob_free(flog);ob_free(q);
    return f;
}

// R3c leg 2: equivalence vs separate-namespace reference.
// 16 iterations x 4 eps. Even k: claim == commit ring slot (forced collision,
// expect DIVERGE); odd k: claim offset by 64 (no collision, expect AGREE).
fn r3c_equiv()i32 {
    let f:i32=0;
    let px:[]u8="r3c_eq_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let contra:[]u8=arb_new_contra();
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    // separate-namespace reference: claim-id table only (commit ring separate,
    // never consulted by revoke/promote)
    let refc:[]u8=ob_alloc(ARB_ROUTES*4);
    let ri:i32=0;
    while(ri<ARB_ROUTES){ob_s32(refc,ri*4,-1);ri=ri+1;}
    let diverges:i32=0;let agrees:i32=0;
    let k:i32=0;
    while(k<16){
        let base:i32=4*k;
        let claim:i32=((base+1)%ARB_ROUTES+((k%2)*64))%ARB_ROUTES;
        // ep 4k: PROPOSE(11, claim)
        mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,11,claim);
        arb_process(base,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        ob_s32(refc,claim*4,ob_g32(routes,claim*4));
        // ep 4k+1: COMMIT(1,22) -> ring slot (base+1)%129
        mkflog(flog,4);qn=0;enq(q,&qn,M_COMMIT,1,22);
        arb_process(base+1,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        // ep 4k+2: PROMOTE(11) -> compare shipped vs reference target
        let pc0:i32=ob_g32(ast,0);
        let ship0:i32=-2;let ref0:i32=-2;
        if(pc0>=0){
            ship0=ob_g32(routes,pc0*4);
            ref0=ob_g32(refc,pc0*4);
            if(ship0!=ref0){diverges=diverges+1;}
            else{if(ship0>=0){agrees=agrees+1;}}
        }
        qn=0;enq(q,&qn,M_PROMOTE,11,0);
        arb_process(base+2,q,&qn,ast,routes,alog,&aln,pam,flog,0,contra,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        // ep 4k+3: REVOKE(11,0) -> compare targets, then mirror clearing
        let pc1:i32=ob_g32(ast,0);
        if(pc1>=0){
            let ship1:i32=ob_g32(routes,pc1*4);
            let ref1:i32=ob_g32(refc,pc1*4);
            if(ship1!=ref1){diverges=diverges+1;}
            else{if(ship1>=0){agrees=agrees+1;}}
        }
        qn=0;enq(q,&qn,M_REVOKE,11,0);
        arb_process(base+3,q,&qn,ast,routes,alog,&aln,pam,flog,0,contra,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        if(pc1>=0 && ob_g32(routes,pc1*4)<0){ob_s32(refc,pc1*4,-1);}
        k=k+1;
    }
    f=f+ob_check(px,"diverges",diverges,16);
    f=f+ob_check(px,"agrees",agrees,16);
    // kill bar: any divergence from the unique-key reference kills the fix.
    // (16 forced-collision diverges are the PREDICTED finding -> kill fires.)
    kb(px,(diverges!=0) as i32);
    ob_free(refc);
    freebrain(pam,live,value,pinned,region,tier,step,maudit,mhdr,trust,ast,routes,alog,contra);
    ob_free(flog);ob_free(q);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+r3a_xep();
    f=f+r3a_sameep();
    f=f+r3a_revoke();
    f=f+r3c_nopanic();
    f=f+r3c_equiv();
    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

// lh_stream.zag — long-horizon soak: deterministic mixed
// propose/commit/revoke/promote stream. LH_EPS episodes (10x=300,
// 100x=3000 via sed of the const). Pure Zag, zero RNG.
// Per-episode line: LH,<ep>,<pam_n>,<live_count>,<admits>,<withholds>,<drops>
// (verdict/drop counts from audit entries added that episode).
// Final: LH_SUMMARY,<pam_n>,<live>,<t_adm>,<t_with>,<t_drop>,<contra_occ>
// Cross-horizon bar: first LH_EPS(10x) lines of the 100x run == the 10x run.
// Cross-variant bar: H-organ vs H-arbiter per-episode lines identical;
// V0 may diverge only on contradicted drifted recommits (k==2).
@import("ob_common.zag")
@import("ob_tn.zag")
@import("ob_fl2.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")
@import("ob_arbiter.zag")

const LH_EPS:i32=3000;

fn mkflog(flog:[]u8,cal:i32)void {
    let i:i32=0;
    while(i<cal){
        ob_s32(flog,i*16,100+i);ob_s32(flog,i*16+4,TN_OP_CALIBRATE);
        ob_s32(flog,i*16+8,0);ob_s32(flog,i*16+12,1);
        i=i+1;
    }
    return;
}

fn enq(q:[]u8,qn:*i32,mtype:i32,a1:i32,a2:i32)i32 {
    let n:i32=qn.*;
    ob_s32(q,n*16,0);
    ob_s32(q,n*16+4,mtype);ob_s32(q,n*16+8,a1);ob_s32(q,n*16+12,a2);
    qn.*=n+1;
    return 0;
}

fn mem_live_count(live:[]u8)i32 {
    let c:i32=0;let i:i32=0;
    while(i<MA_CAP){if(live[i]!=0){c=c+1;}i=i+1;}
    return c;
}

fn i64s(v:i32)[]u8 {
    let s:[]u8=_zag_i64_to_str(v as i64);
    return s;
}

fn pline(ep:i32,pn:i32,lc:i32,a:i32,w:i32,d:i32)void {
    _zag_print("LH,");
    let s:[]u8=i64s(ep);_zag_print(s);ob_free(s);_zag_print(",");
    s=i64s(pn);_zag_print(s);ob_free(s);_zag_print(",");
    s=i64s(lc);_zag_print(s);ob_free(s);_zag_print(",");
    s=i64s(a);_zag_print(s);ob_free(s);_zag_print(",");
    s=i64s(w);_zag_print(s);ob_free(s);_zag_print(",");
    s=i64s(d);_zag_print(s);ob_free(s);
    _zag_println("");
    return;
}

// contradiction occupancy: H-arbiter scans the arbiter-owned register.
fn contra_occ(contra:[]u8)i32 {
    let c:i32=0;let pol:i32=0;
    while(pol<500){
        if(arb_contra_has(contra,pol)==1){c=c+1;}
        pol=pol+1;
    }
    return c;
}

fn main()i32 {
    let pam:[]u8=pam_new();
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();
    let trust:[]u8=mm_new_trust();
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let ast:[]u8=arb_new_state();let routes:[]u8=arb_new_routes();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let contra:[]u8=arb_new_contra();
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);
    let t_adm:i32=0;let t_with:i32=0;let t_drop:i32=0;
    let ep:i32=0;
    while(ep<LH_EPS){
        let cycle:i32=ep/12;
        let k:i32=ep-(cycle*12);
        let p:i32=10+(cycle%8);
        let r:i32=20+(cycle%8);
        let cal:i32=4;
        let qn:i32=0;
        if(k==0){enq(q,&qn,M_PROPOSE_INSTALL,p,ep%129);}
        if(k==1){enq(q,&qn,M_REVOKE,p,0);}
        if(k==2){cal=6;enq(q,&qn,M_COMMIT,1,p);}
        if(k==3){enq(q,&qn,M_COMMIT,1,100+cycle);}
        if(k==4){enq(q,&qn,M_COMMIT,1,p);}
        if(k==5){enq(q,&qn,M_PROPOSE_INSTALL,r,ep%129);}
        if(k==6){enq(q,&qn,M_PROMOTE,r,0);}
        if(k==7){enq(q,&qn,M_COMMIT,1,r);}
        if(k==8){enq(q,&qn,M_REVOKE,r,0);}
        if(k==9){enq(q,&qn,M_COMMIT,1,200+cycle);}
        if(k==10){enq(q,&qn,M_COMMIT,1,300+cycle);}
        if(k==11){cal=6;enq(q,&qn,M_COMMIT,1,400+cycle);}
        mkflog(flog,cal);
        let ab:i32=aln;
        arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,cal,contra,
            live,value,pinned,region,tier,step,maudit,mhdr,trust);
        let a:i32=0;let w:i32=0;let d:i32=0;
        let j:i32=ab;
        while(j<aln){
            let code:i32=ob_g32(alog,j*16+4);
            if(code==M_PAM_VERDICT){
                if(ob_g32(alog,j*16+8)==PAM_ADMIT){a=a+1;}
                if(ob_g32(alog,j*16+8)==PAM_WITHHOLD){w=w+1;}
            }
            if(code==ARB_DROP){d=d+1;}
            j=j+1;
        }
        t_adm=t_adm+a;t_with=t_with+w;t_drop=t_drop+d;
        pline(ep,pam_n(pam),mem_live_count(live),a,w,d);
        ep=ep+1;
    }
    _zag_print("LH_SUMMARY,");
    let s:[]u8=i64s(pam_n(pam));_zag_print(s);ob_free(s);_zag_print(",");
    s=i64s(mem_live_count(live));_zag_print(s);ob_free(s);_zag_print(",");
    s=i64s(t_adm);_zag_print(s);ob_free(s);_zag_print(",");
    s=i64s(t_with);_zag_print(s);ob_free(s);_zag_print(",");
    s=i64s(t_drop);_zag_print(s);ob_free(s);_zag_print(",");
    s=i64s(contra_occ(contra));_zag_print(s);ob_free(s);
    _zag_println("");
    ob_free(pam);ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);ob_free(flog);ob_free(q);ob_free(contra);
    return 0;
}

// r3b_panic.zag — residual OOB panic: M_PROPOSE_INSTALL with claim id 200.
// f3b4acaa guarded M_COMMIT with ep%ARB_ROUTES but left the PROPOSE write
// routes[a2*4] unguarded. Expect a slice out-of-bounds panic (exit!=0).
// The panic is the evidence; run under a capturing shell.
@import("ob_common.zag")
@import("ob_tn.zag")
@import("ob_fl2.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")
@import("ob_arbiter.zag")

fn main()i32 {
    let pam:[]u8=pam_new();
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();
    let trust:[]u8=mm_new_trust();
    let rc0:i32=mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let rc1:i32=mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let ast:[]u8=arb_new_state();let routes:[]u8=arb_new_routes();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let contra:[]u8=arb_new_contra();
    let flog:[]u8=ob_alloc(8*16);
    let i:i32=0;
    while(i<4){
        ob_s32(flog,i*16,100+i);ob_s32(flog,i*16+4,TN_OP_CALIBRATE);
        ob_s32(flog,i*16+8,0);ob_s32(flog,i*16+12,1);
        i=i+1;
    }
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    ob_s32(q,0,0);ob_s32(q,4,M_PROPOSE_INSTALL);ob_s32(q,8,11);ob_s32(q,12,200);
    qn=1;
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,contra,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    _zag_println("NO_PANIC_UNEXPECTED");
    return 0;
}

// r1p_atk.zag — R1' novelty-predicate probes (PREREG_H1EVO §2, R1a'/R1b'/R1c').
// Prereg frozen 2026-09-24. Pure Zag, zero RNG, 3x byte-identical.
// R1a': contradicted reinstall must WITHHOLD via REVISE (no install, no pin).
// R1b': genuinely novel M_COMMIT must ADMIT (the 433dc09c defect stays fixed).
// R1c': paired second verdict must equal the lone verdict (no routing staleness).
// r1d: mechanism check — a REVISE-admitted commit clears the
//      unresolved-contradiction mark (frozen rule, not a kill bar).
@import("ob_common.zag")
@import("ob_tn.zag")
@import("ob_fl2.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")
@import("ob_arbiter.zag")

fn setup(pam:*[]u8,live:*[]u8,value:*[]u8,pinned:*[]u8,region:*[]u8,
    tier:*[]u8,step:*[]u8,maudit:*[]u8,mhdr:*[]u8,trust:*[]u8,
    ast:*[]u8,routes:*[]u8,alog:*[]u8,aln:*i32)i32 {
    pam.*=pam_new();
    live.*=mm_new_live();value.*=mm_new_value();pinned.*=mm_new_pinned();
    region.*=mm_new_region();tier.*=mm_new_tier();step.*=mm_new_step();
    maudit.*=mm_new_audit();mhdr.*=mm_new_hdr();trust.*=mm_new_trust();
    if(mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*)!=0){return -1;}
    if(mm_advance_stage(live.*,value.*,pinned.*,region.*,tier.*,step.*,maudit.*,mhdr.*)!=0){return -1;}
    ast.*=arb_new_state();routes.*=arb_new_routes();
    alog.*=ob_alloc(ARB_ACAP*16);
    aln.*=0;
    return 0;
}

fn mkflog(flog:[]u8,cal:i32)void {
    let i:i32=0;
    while(i<cal){
        ob_s32(flog,i*16,100+i);ob_s32(flog,i*16+4,TN_OP_CALIBRATE);
        ob_s32(flog,i*16+8,0);ob_s32(flog,i*16+12,1);
        i=i+1;
    }
    return;
}

fn enq(q:[]u8,qn:*i32,mtype:i32,a1:i32,a2:i32)i32 {
    let n:i32=qn.*;
    ob_s32(q,n*16,0);
    ob_s32(q,n*16+4,mtype);ob_s32(q,n*16+8,a1);ob_s32(q,n*16+12,a2);
    qn.*=n+1;
    return 0;
}

fn acount(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code){c=c+1;}
        i=i+1;
    }
    return c;
}

fn acount2(alog:[]u8,n:i32,code:i32,a1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1){c=c+1;}
        i=i+1;
    }
    return c;
}

// count audit entries by code + a2 (e.g. M_PAM_VERDICT entries by reason)
fn acount_a2(alog:[]u8,n:i32,code:i32,a2:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+12)==a2){c=c+1;}
        i=i+1;
    }
    return c;
}

fn kb(px:[]u8,fired:i32)void {
    _zag_print(px);_zag_print("_KILLBAR,");
    let s:[]u8=_zag_i64_to_str(fired as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return;
}

// R1a': the R1a breaking triple must WITHHOLD via the REVISE path.
// ep0: PROPOSE(31,7) cal=4 (conf 1000) -> ADMIT, S_q live.
// ep1: REVOKE(31) -> S_q killed: policy 31 contradicted.
// ep2: COMMIT(1,31) cal=6 (conf 1500, drift 500 >> tol 50).
// Expect: PAM_WITHHOLD / PAM_R_UNCORROBORATED, no install, no pin.
// Kill: the contradicted claim installs (post-fix verdict ADMIT).
fn r1ap()i32 {
    let f:i32=0;
    let px:[]u8="r1a_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,31,7);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let sq:i32=ob_g32(routes,7*4);
    f=f+ob_check(px,"ep0_admit",acount2(alog,aln,M_PAM_VERDICT,PAM_ADMIT),1);
    f=f+ob_check(px,"ep0_live",live[sq],1);
    f=f+ob_check(px,"ep0_novel31",pam_is_novel(pam,31),0);
    mkflog(flog,4);qn=0;enq(q,&qn,M_REVOKE,31,0);
    arb_process(1,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+ob_check(px,"ep1_revoke_audited",acount2(alog,aln,M_REVOKE,31),1);
    f=f+ob_check(px,"ep1_dead",live[sq],0);
    f=f+ob_check(px,"ep1_contra31",pam_has_contradiction(pam,31),1);
    mkflog(flog,6);qn=0;enq(q,&qn,M_COMMIT,1,31);
    arb_process(2,q,&qn,ast,routes,alog,&aln,pam,flog,6,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s1:i32=ob_g32(routes,(2%ARB_ROUTES)*4);
    f=f+ob_check(px,"ep2_withhold",acount2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD),1);
    f=f+ob_check(px,"ep2_uncorroborated",acount_a2(alog,aln,M_PAM_VERDICT,PAM_R_UNCORROBORATED),1);
    f=f+ob_check(px,"ep2_no_route",s1,-1);
    f=f+ob_check(px,"ep2_dropped",acount2(alog,aln,ARB_DROP,M_COMMIT),1);
    f=f+ob_check(px,"ep2_contra_still",pam_has_contradiction(pam,31),1);
    let kill:i32=(acount2(alog,aln,M_PAM_VERDICT,PAM_ADMIT)!=1) as i32;
    kb(px,kill);
    ob_free(pam);ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);ob_free(flog);ob_free(q);
    return f;
}

// R1b': genuinely novel M_COMMIT must ADMIT (433dc09c defect stays fixed).
fn r1bp()i32 {
    let f:i32=0;
    let px:[]u8="r1b_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    f=f+ob_check(px,"pre_novel41",pam_is_novel(pam,41),1);
    mkflog(flog,4);qn=0;enq(q,&qn,M_COMMIT,1,41);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s1:i32=ob_g32(routes,0);
    f=f+ob_check(px,"novel_admit",acount2(alog,aln,M_PAM_VERDICT,PAM_ADMIT),1);
    f=f+ob_check(px,"novel_withhold",acount2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD),0);
    f=f+ob_check(px,"novel_route",s1>=0,1);
    if(s1>=0){
        f=f+ob_check(px,"novel_installed",live[s1],1);
    }
    f=f+ob_check(px,"post_nonnovel41",pam_is_novel(pam,41),0);
    let kill:i32=(acount2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD)!=0) as i32;
    kb(px,kill);
    ob_free(pam);ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);ob_free(flog);ob_free(q);
    return f;
}

// R1c': paired vs lone COMMIT: second verdict must equal the lone verdict.
fn r1cp()i32 {
    let f:i32=0;
    let px:[]u8="r1c_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;
    enq(q,&qn,M_COMMIT,1,51);enq(q,&qn,M_COMMIT,1,51);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let pair_admits:i32=acount2(alog,aln,M_PAM_VERDICT,PAM_ADMIT);
    let pair_withholds:i32=acount2(alog,aln,M_PAM_VERDICT,PAM_WITHHOLD);
    f=f+ob_check(px,"pair_admits",pair_admits,2);
    f=f+ob_check(px,"pair_withholds",pair_withholds,0);
    ob_free(pam);ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);
    let pam2:[]u8=ob_alloc(0);let live2:[]u8=ob_alloc(0);let value2:[]u8=ob_alloc(0);
    let pinned2:[]u8=ob_alloc(0);let region2:[]u8=ob_alloc(0);let tier2:[]u8=ob_alloc(0);
    let step2:[]u8=ob_alloc(0);let maudit2:[]u8=ob_alloc(0);let mhdr2:[]u8=ob_alloc(0);
    let trust2:[]u8=ob_alloc(0);let ast2:[]u8=ob_alloc(0);let routes2:[]u8=ob_alloc(0);
    let alog2:[]u8=ob_alloc(0);let aln2:i32=0;
    f=f+setup(&pam2,&live2,&value2,&pinned2,&region2,&tier2,&step2,&maudit2,&mhdr2,&trust2,&ast2,&routes2,&alog2,&aln2);
    mkflog(flog,4);qn=0;
    enq(q,&qn,M_COMMIT,1,51);
    arb_process(0,q,&qn,ast2,routes2,alog2,&aln2,pam2,flog,4,
        live2,value2,pinned2,region2,tier2,step2,maudit2,mhdr2,trust2);
    let lone_admits:i32=acount2(alog2,aln2,M_PAM_VERDICT,PAM_ADMIT);
    let lone_withholds:i32=acount2(alog2,aln2,M_PAM_VERDICT,PAM_WITHHOLD);
    f=f+ob_check(px,"lone_admits",lone_admits,1);
    // kill bar: second-of-pair verdict differs from lone verdict.
    let kill:i32=((pair_admits!=2) || (lone_admits!=1) ||
        (pair_withholds!=lone_withholds)) as i32;
    kb(px,kill);
    ob_free(pam2);ob_free(live2);ob_free(value2);ob_free(pinned2);ob_free(region2);
    ob_free(tier2);ob_free(step2);ob_free(maudit2);ob_free(mhdr2);ob_free(trust2);
    ob_free(ast2);ob_free(routes2);ob_free(alog2);ob_free(flog);ob_free(q);
    return f;
}

// r1d: mechanism check (not a kill bar): a REVISE-admitted commit clears
// the unresolved-contradiction mark. ep0 propose(31,7) cal=4 -> admit;
// ep1 revoke -> contradicted; ep2 commit(1,31) cal=4 (conf 1000, within
// tol of row0) -> REVISE ADMIT, installed, mark cleared.
fn r1dp()i32 {
    let f:i32=0;
    let px:[]u8="r1d_";
    let pam:[]u8=ob_alloc(0);let live:[]u8=ob_alloc(0);let value:[]u8=ob_alloc(0);
    let pinned:[]u8=ob_alloc(0);let region:[]u8=ob_alloc(0);let tier:[]u8=ob_alloc(0);
    let step:[]u8=ob_alloc(0);let maudit:[]u8=ob_alloc(0);let mhdr:[]u8=ob_alloc(0);
    let trust:[]u8=ob_alloc(0);let ast:[]u8=ob_alloc(0);let routes:[]u8=ob_alloc(0);
    let alog:[]u8=ob_alloc(0);let aln:i32=0;
    f=f+setup(&pam,&live,&value,&pinned,&region,&tier,&step,&maudit,&mhdr,&trust,&ast,&routes,&alog,&aln);
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    mkflog(flog,4);qn=0;enq(q,&qn,M_PROPOSE_INSTALL,31,7);
    arb_process(0,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    mkflog(flog,4);qn=0;enq(q,&qn,M_REVOKE,31,0);
    arb_process(1,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    f=f+ob_check(px,"contra_set",pam_has_contradiction(pam,31),1);
    mkflog(flog,4);qn=0;enq(q,&qn,M_COMMIT,1,31);
    arb_process(2,q,&qn,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let s1:i32=ob_g32(routes,(2%ARB_ROUTES)*4);
    f=f+ob_check(px,"revise_admit",acount2(alog,aln,M_PAM_VERDICT,PAM_ADMIT),2);
    f=f+ob_check(px,"installed",live[s1],1);
    f=f+ob_check(px,"contra_cleared",pam_has_contradiction(pam,31),0);
    ob_free(pam);ob_free(live);ob_free(value);ob_free(pinned);ob_free(region);
    ob_free(tier);ob_free(step);ob_free(maudit);ob_free(mhdr);ob_free(trust);
    ob_free(ast);ob_free(routes);ob_free(alog);ob_free(flog);ob_free(q);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+r1ap();
    f=f+r1bp();
    f=f+r1cp();
    f=f+r1dp();
    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

// h3_lh.zag — H1EVO V2 long-horizon probe.
// Deterministic mixed stream, N episodes (argv[1], default 3000 = 10x of the
// 300-ep R3c sweep; 30000 = 100x). Pure Zag, zero RNG.
// 4-episode blocks: [PROPOSE{11,(41k)%129}, COMMIT{1,30+(k%5)},
// REVOKE{11}, PROMOTE{11}]. The claim stride 41 is chosen so commit-ring
// collisions land INSIDE the PAM admit window: (4k+1)==41k (mod 129) <->
// 37k==1 <-> k==7 (mod 129): forced collisions at blocks 7,14,21,28.
// Two instruments:
//   LHE lines: per-episode cumulative decision tallies (arbiter-log deltas
//     via cursor; exact past the 1024-entry cap). 3x byte-identity +
//     10x-prefix==100x-prefix checks.
//   LHO lines: per-block revoke oracle — expected slot (the block's
//     propose survivor, from the mem-audit ADD) vs the slot the revoke
//     actually killed (+rc). Any killed!=expected is cross-key
//     contamination, visible at horizon.
@import("ob_common.zag")
@import("ob_tn.zag")
@import("ob_fl2.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")
@import("ob_arbiter.zag")

fn parse_i32(b:[]u8)i32 {
    let v:i32=0;let i:i32=0;
    while(i<b.len){
        let d:i32=(b[i] as i32)-48;
        if(d>=0 && d<=9){v=v*10+d;}
        i=i+1;
    }
    return v;
}

fn pi64(v:i32)void {
    let s:[]u8=_zag_i64_to_str(v as i64);_zag_print(s);ob_free(s);
    return;
}

// first MA_OK ADD slot in maudit[base,n) — the propose survivor
// (the block's commit ADDs later, so last-wins would be wrong here)
fn madd_in(maudit:[]u8,base:i32,n:i32)i32 {
    let s:i32=-1;let i:i32=base;
    while(i<n){
        let e:i32=i*MA_EW*4;
        if(ob_g32(maudit,e+4)==MA_OP_ADD && ob_g32(maudit,e+12)==MA_OK){
            if(s<0){s=ob_g32(maudit,e+8);}
        }
        i=i+1;
    }
    return s;
}

// last KILL (slot,rc) in maudit[base,n); returns slot, rc via out param
fn mkill_in(maudit:[]u8,base:i32,n:i32,rcout:*i32)i32 {
    let s:i32=-2;let i:i32=base;
    while(i<n){
        let e:i32=i*MA_EW*4;
        if(ob_g32(maudit,e+4)==MA_OP_KILL){
            s=ob_g32(maudit,e+8);
            rcout.*=ob_g32(maudit,e+12);
        }
        i=i+1;
    }
    return s;
}

fn main()i32 {
    let neps:i32=parse_i32(_zag_arg(1));
    if(neps<=0){neps=3000;}
    let pam:[]u8=pam_new();
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();
    let trust:[]u8=mm_new_trust();
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let ast:[]u8=arb_new_state();let routes:[]u8=arb_new_routes();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let flog:[]u8=ob_alloc(8*16);
    let q:[]u8=ob_alloc(ARB_QCAP*16);let qn:i32=0;
    let i:i32=0;
    while(i<4){
        ob_s32(flog,i*16,100+i);ob_s32(flog,i*16+4,TN_OP_CALIBRATE);
        ob_s32(flog,i*16+8,0);ob_s32(flog,i*16+12,1);
        i=i+1;
    }
    _zag_print("LH,");pi64(neps);_zag_println("");
    let admits:i32=0;let withholds:i32=0;let drops:i32=0;
    let refused:i32=0;let applied:i32=0;let contra:i32=0;
    let prom:i32=0;let rev:i32=0;
    let prev_aln:i32=0;
    let prev_mn:i32=0;
    let ep:i32=0;
    while(ep<neps){
        let k:i32=ep/4;
        let op:i32=ep%4;
        qn=0;
        if(op==0){
            ob_s32(q,0,0);ob_s32(q,4,M_PROPOSE_INSTALL);
            ob_s32(q,8,11);ob_s32(q,12,(41*k)%129);
            qn=1;
            arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,4,
                live,value,pinned,region,tier,step,maudit,mhdr,trust);
        }
        if(op==1){
            ob_s32(q,0,0);ob_s32(q,4,M_COMMIT);
            ob_s32(q,8,1);ob_s32(q,12,30+(k%5));
            qn=1;
            arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,4,
                live,value,pinned,region,tier,step,maudit,mhdr,trust);
        }
        if(op==2){
            ob_s32(q,0,0);ob_s32(q,4,M_REVOKE);ob_s32(q,8,11);ob_s32(q,12,0);
            qn=1;
            arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,0,
                live,value,pinned,region,tier,step,maudit,mhdr,trust);
        }
        if(op==3){
            ob_s32(q,0,0);ob_s32(q,4,M_PROMOTE);ob_s32(q,8,11);ob_s32(q,12,0);
            qn=1;
            arb_process(ep,q,&qn,ast,routes,alog,&aln,pam,flog,0,
                live,value,pinned,region,tier,step,maudit,mhdr,trust);
        }
        // per-episode arbiter-log delta tally
        let j:i32=prev_aln;
        while(j<aln){
            let code:i32=ob_g32(alog,j*16+4);
            if(code==M_PAM_VERDICT){
                if(ob_g32(alog,j*16+8)==PAM_ADMIT){admits=admits+1;}
                if(ob_g32(alog,j*16+8)==PAM_WITHHOLD){withholds=withholds+1;}
            }
            if(code==ARB_DROP){drops=drops+1;}
            if(code==ARB_REFUSED){refused=refused+1;}
            if(code==ARB_APPLIED){applied=applied+1;}
            if(code==ARB_REFUSED_CONTRADICTED){contra=contra+1;}
            if(code==M_PROMOTE){prom=prom+1;}
            if(code==M_REVOKE){rev=rev+1;}
            j=j+1;
        }
        prev_aln=aln;
        // per-block revoke oracle at the revoke episode
        if(op==0){
            // expected slot = this block's propose survivor
            let mn0:i32=ob_g32(mhdr,8);
            let exp:i32=madd_in(maudit,prev_mn,mn0);
            _zag_print("LHO,");pi64(k);_zag_print(",exp,");pi64(exp);
            _zag_println("");
        }
        if(op==2){
            let mn1:i32=ob_g32(mhdr,8);
            let krc:i32=-99;
            let kslot:i32=mkill_in(maudit,prev_mn,mn1,&krc);
            _zag_print("LHO,");pi64(k);_zag_print(",kill,");
            pi64(kslot);_zag_print(",");pi64(krc);_zag_println("");
            prev_mn=mn1;
        }
        _zag_print("LHE,");pi64(ep);_zag_print(",");
        pi64(admits);_zag_print(",");pi64(withholds);_zag_print(",");
        pi64(drops);_zag_print(",");pi64(refused);_zag_print(",");
        pi64(applied);_zag_print(",");pi64(contra);_zag_print(",");
        pi64(prom);_zag_print(",");pi64(rev);_zag_println("");
        ep=ep+1;
    }
    _zag_println("LH_DONE");
    return 0;
}

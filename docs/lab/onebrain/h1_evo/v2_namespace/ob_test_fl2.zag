// ob_test_fl2.zag — unit test: the FL2 organ standalone.
//
// Part 1: f3_survivor differential vs the old 99-sentinel inline default:
//   exhaustive (act x sig0 x sig1 x sig2) characterization proving the
//   repair (the failed action is never its own survivor) and that the only
//   behavioral delta vs the default is exactly the repaired class.
// Part 2: the organ on the honest + lying streams with a loopback (no
//   arbiter/PAM/MEM): the committed arm_gl behavioral invariants must
//   hold (E14 provisional intent, E15 disconnect, lying E29 revoke+commit
//   CONTEST, honest E48 promote, contest/rekey/refuse/quarantine counts,
//   main18 integrity).
//
// The organ's decision stream must equal the committed gl_default
// behavior; the exact local-log totals are the organ's own frozen evidence
// (byte-identical reruns asserted by the runner).
@import("ob_common.zag")
@import("ob_tn.zag")
@import("ob_fl2.zag")

// the old 99-sentinel inline default, copied from gl_learner.zag arm_gl
// (test-local only — the organ itself never uses it).
fn old_select(act:i32,s0:i32,s1:i32,s2:i32)i32 {
    let surv:i32=-1;
    if(s0>=1){surv=0;}
    if(s1>=1 && surv<0){surv=1;}
    if(s2>=1 && surv<0){surv=2;}
    return surv;
}

fn test_survivor()i32 {
    let f:i32=0;
    let sigs:[]u8=ob_alloc(5*4);
    ob_s32(sigs,0,-1);ob_s32(sigs,4,0);ob_s32(sigs,8,1);ob_s32(sigs,12,2);ob_s32(sigs,16,99);
    let total:i32=0;let repaired_class:i32=0;let preserved:i32=0;let bad:i32=0;
    let act:i32=0;
    while(act<3){
        let i0:i32=0;
        while(i0<5){
            let i1:i32=0;
            while(i1<5){
                let i2:i32=0;
                while(i2<5){
                    let s0:i32=ob_g32(sigs,i0*4);let s1:i32=ob_g32(sigs,i1*4);let s2:i32=ob_g32(sigs,i2*4);
                    let new:i32=f3_survivor(act,s0,s1,s2);
                    let old:i32=old_select(act,s0,s1,s2);
                    total=total+1;
                    // repair property: the failed action is never its own survivor
                    if(new==act){bad=bad+1;}
                    // structural property: -1 iff no non-act sig >= 1
                    let any:i32=0;
                    if(act!=0 && s0>=1){any=1;}
                    if(act!=1 && s1>=1){any=1;}
                    if(act!=2 && s2>=1){any=1;}
                    if((new==-1 && any==1) || (new!=-1 && any==0)){bad=bad+1;}
                    // lowest-index property: new must be the first non-act sig>=1
                    let exp:i32=-1;
                    if(act!=0 && s0>=1){exp=0;}
                    if(exp<0 && act!=1 && s1>=1){exp=1;}
                    if(exp<0 && act!=2 && s2>=1){exp=2;}
                    if(new!=exp){bad=bad+1;}
                    // behavior preservation: where the old default did NOT
                    // return act itself, f3 must agree exactly
                    if(old!=act){
                        if(new==old){preserved=preserved+1;}
                        else{bad=bad+1;}
                    } else {
                        repaired_class=repaired_class+1;
                    }
                    i2=i2+1;
                }
                i1=i1+1;
            }
            i0=i0+1;
        }
        act=act+1;
    }
    f=f+ob_check("","surv_total",total,375);
    f=f+ob_check("","surv_bad",bad,0);
    f=f+ob_check("","surv_preserved",preserved,total-repaired_class);
    ob_free(sigs);
    return f;
}

// ---- outbox / local-log query helpers ----
fn ob_count_msg(out:[]u8,n:i32,mtype:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(ob_g32(out,i*16+4)==mtype){c=c+1;}i=i+1;}
    return c;
}

fn ob_first_msg_ep(out:[]u8,n:i32,mtype:i32)i32 {
    let i:i32=0;
    while(i<n){if(ob_g32(out,i*16+4)==mtype){return ob_g32(out,i*16)>>16;}i=i+1;}
    return -1;
}

fn ob_first_msg_arg(out:[]u8,n:i32,mtype:i32,which:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(ob_g32(out,i*16+4)==mtype){return ob_g32(out,i*16+8+which*4);}
        i=i+1;
    }
    return -999;
}

fn ob_count_log_op(log:[]u8,n:i32,op:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(ob_g32(log,i*16+4)==op){c=c+1;}i=i+1;}
    return c;
}

fn ob_first_log_step(log:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){if(ob_g32(log,i*16+4)==op){return ob_g32(log,i*16);}i=i+1;}
    return -1;
}

fn ob_count_log_range(log:[]u8,n:i32,op:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=ob_g32(log,i*16);
        if(ob_g32(log,i*16+4)==op && st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

fn ob_count_log_aux(log:[]u8,n:i32,op:i32,auxv:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(log,i*16+4)==op && ob_g32(log,i*16+12)==auxv){c=c+1;}
        i=i+1;
    }
    return c;
}

fn run_stream(stated:i32,teach_aux:i32,px:[]u8,lying:i32)i32 {
    let f:i32=0;
    let a:[]u8=obf_new();
    let log:[]u8=ob_alloc(OBF_LOGCAP*16);
    let ln:i32=0;
    let out:[]u8=ob_alloc(OBF_OUTCAP*16);
    let on:i32=0;let ord:i32=0;
    let ep:i32=1;
    while(ep<=TN_EPISODES){
        let rc:i32=obf_step(a,ep,stated,teach_aux,log,&ln,out,&on,&ord);
        if(rc!=TN_OK){}
        ep=ep+1;
    }
    f=f+ob_check(px,"episodes_ok",obf_g(a,STF_BADEP),0);
    f=f+ob_check(px,"n_propose",ob_count_msg(out,on,M_PROPOSE_INSTALL),1);
    f=f+ob_check(px,"propose_ep",ob_first_msg_ep(out,on,M_PROPOSE_INSTALL),14);
    f=f+ob_check(px,"propose_policy",ob_first_msg_arg(out,on,M_PROPOSE_INSTALL,0),stated);
    f=f+ob_check(px,"n_disconnect",ob_count_msg(out,on,M_DISCONNECT),1);
    f=f+ob_check(px,"disconnect_ep",ob_first_msg_ep(out,on,M_DISCONNECT),15);
    f=f+ob_check(px,"withhold_n",ob_count_log_op(log,ln,TN_OP_WITHHOLD),0);
    f=f+ob_check(px,"cal_score",ob_count_log_aux(log,ln,TN_OP_CALIBRATE,1),4);
    let exp_revoke:i32=0;let exp_revoke_ep:i32=-1;
    let exp_promote:i32=1;let exp_promote_ep:i32=48;
    if(lying==1){exp_revoke=1;exp_revoke_ep=29;exp_promote=0;exp_promote_ep=-1;}
    f=f+ob_check(px,"n_revoke",ob_count_msg(out,on,M_REVOKE),exp_revoke);
    f=f+ob_check(px,"revoke_ep",ob_first_msg_ep(out,on,M_REVOKE),exp_revoke_ep);
    f=f+ob_check(px,"n_commit",ob_count_msg(out,on,M_COMMIT),exp_revoke);
    f=f+ob_check(px,"commit_ep",ob_first_msg_ep(out,on,M_COMMIT),exp_revoke_ep);
    f=f+ob_check(px,"n_promote",ob_count_msg(out,on,M_PROMOTE),exp_promote);
    f=f+ob_check(px,"promote_ep",ob_first_msg_ep(out,on,M_PROMOTE),exp_promote_ep);
    if(lying==1){
        f=f+ob_check(px,"revoke_policy",ob_first_msg_arg(out,on,M_REVOKE,0),2);
        f=f+ob_check(px,"commit_policy",ob_first_msg_arg(out,on,M_COMMIT,1),1);
        f=f+ob_check(px,"nuninstall",ob_count_log_op(log,ln,TN_OP_UNINSTALL_PROVISIONAL),1);
    } else {
        f=f+ob_check(px,"nuninstall",ob_count_log_op(log,ln,TN_OP_UNINSTALL_PROVISIONAL),0);
    }
    let exp_contest:i32=48;let exp_rekey:i32=0;let exp_quar:i32=48;
    if(lying==1){exp_contest=33;exp_rekey=15;exp_quar=33;}
    f=f+ob_check(px,"total_contest",ob_count_log_op(log,ln,TN_OP_CONTEST),exp_contest);
    f=f+ob_check(px,"total_rekey",ob_count_log_op(log,ln,TN_OP_REKEY),exp_rekey);
    f=f+ob_check(px,"total_refuse",ob_count_log_op(log,ln,TN_OP_REFUSE),10);
    f=f+ob_check(px,"persist_contest",ob_count_log_range(log,ln,TN_OP_CONTEST,49,128),24);
    f=f+ob_check(px,"persist_refuse",ob_count_log_range(log,ln,TN_OP_REFUSE,49,128),4);
    let qkey:[]u8=a[OBF_QKEY..OBF_QKEY+256];
    f=f+ob_check(px,"quar_used",tn_count_used(qkey,TN_NQUAR),exp_quar);
    let mkey:[]u8=a[OBF_MKEY..OBF_MKEY+512];
    let mval:[]u8=a[OBF_MVAL..OBF_MVAL+512];
    let mflag:[]u8=a[OBF_MFLAG..OBF_MFLAG+512];
    let mm:i32=0;let fm:i32=0;let kk:i32=1;
    while(kk<=8){
        if(tn_main_val(mkey,mval,TN_NMAIN,kk)!=100+kk){mm=mm+1;}
        if(tn_main_flag(mflag,TN_NMAIN,kk,mkey)!=1){fm=fm+1;}
        kk=kk+1;
    }
    f=f+ob_check(px,"main18_val_mm",mm,0);
    f=f+ob_check(px,"main18_flag_mm",fm,0);
    // the organ's own frozen evidence: local-log entry total (deterministic)
    _zag_print("OB_INFO,");_zag_print(px);_zag_print("log_total,");
    let s:[]u8=_zag_i64_to_str(ln as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    _zag_print("OB_INFO,");_zag_print(px);_zag_print("outbox_total,");
    let t:[]u8=_zag_i64_to_str(on as i64);_zag_print(t);ob_free(t);
    _zag_println("");
    ob_free(a);ob_free(log);ob_free(out);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+test_survivor();
    f=f+run_stream(ACT_CONTEST,0,"obfh_",0);
    f=f+run_stream(ACT_REKEY,1,"obfl_",1);
    _zag_print("OB_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

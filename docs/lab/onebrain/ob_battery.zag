// ob_battery.zag : pure-Zag translator: items_v2/*.jsonl -> ob TSV 7-column.
//
// Reads a frozen encoded battery JSONL (admit, logic, revoke, trap, cost),
// parses each line with the harness's own JSON parser (with a relaxed
// task_type gate: the frozen dlb_json.zag only whitelists admit/revoke/logic,
// but trap and cost are valid frozen batteries), and emits the ob TSV
// encoding deterministically:
//   id, task (=task_type), query (=task_type, carried for audit),
//   readings (hid:hid in payload order), evidence (e#:H:+w / e#:H:-w in
//   payload order, weights copied verbatim), expected (=ground_truth),
//   source (=argv source tag).
// The translator invents no weights and makes no per-item decisions.
// Usage: ob_battery <input.jsonl> <output.tsv> <source-tag>

@import("ob_problem.zag")

// Relaxed variant of dj_parse_item: identical except the task_type gate
// accepts any charset-clean string (admit, revoke, logic, trap, cost),
// not just the three whitelisted by the frozen harness.
fn dj_parse_item_any(it:*Item, line:[]u8, maxh:i32, maxe:i32, maxl:i32)i32 {
    let j:JP=JP{.s:line,.p:0,.err:0};
    it.*.line=line;
    it.*.id_off=-1;it.*.id_len=0;
    it.*.tt_off=-1;it.*.tt_len=0;
    it.*.gt_off=-1;it.*.gt_len=0;
    it.*.nh=0;it.*.ne=0;
    it.*.maxh=maxh;it.*.maxe=maxe;it.*.maxl=maxl;
    if(jp_eat(&j,123)==0){return -1;}
    if(jp_peek(&j)==125){return -13;}
    let done:i32=0;
    while(done==0){
        let pk:i64=jp_string(&j);
        if(pk<0){return -1;}
        let kn:[]u8=jp_slice_at(&j,pk_off(pk),pk_len(pk));
        if(jp_eat(&j,58)==0){return -1;}
        if(dlb_streq(kn,"id")==1){
            let vk:i64=jp_string(&j);
            if(vk<0){return -1;}
            let vs:[]u8=jp_slice_at(&j,pk_off(vk),pk_len(vk));
            if(dlb_id_ok(vs)==0){return -8;}
            it.*.id_off=pk_off(vk);it.*.id_len=pk_len(vk);
        }
        if(dlb_streq(kn,"task_type")==1){
            let vk:i64=jp_string(&j);
            if(vk<0){return -1;}
            let vs:[]u8=jp_slice_at(&j,pk_off(vk),pk_len(vk));
            if(dlb_id_ok(vs)==0){return -9;}
            it.*.tt_off=pk_off(vk);it.*.tt_len=pk_len(vk);
        }
        if(dlb_streq(kn,"ground_truth")==1){
            let vk:i64=jp_string(&j);
            if(vk<0){return -1;}
            let vs:[]u8=jp_slice_at(&j,pk_off(vk),pk_len(vk));
            if(dlb_id_ok(vs)==0){return -8;}
            it.*.gt_off=pk_off(vk);it.*.gt_len=pk_len(vk);
        }
        if(dlb_streq(kn,"input")==1){
            let rc:i32=dj_parse_input(&j,it);
            if(rc!=0){return rc;}
        }
        if(dlb_streq(kn,"id")==0 && dlb_streq(kn,"task_type")==0 && dlb_streq(kn,"ground_truth")==0 && dlb_streq(kn,"input")==0){
            jp_skip(&j);
        }
        if(jp_err(&j)==1){return -1;}
        let cc:u8=jp_peek(&j);
        if(cc==44){jp_eat(&j,44);}
        if(cc==125){jp_eat(&j,125);done=1;}
        if(cc!=44 && cc!=125){return -1;}
    }
    if(it.*.id_off<0 || it.*.tt_off<0 || it.*.gt_off<0){return -13;}
    if(it.*.nh<1){return -11;}
    if(dj_hlookup(it,dj_gt(it))<0){return -10;}
    jp_ws(&j);
    if(jp_err(&j)==1){return -1;}
    if(jp_pos(&j)!=jp_slen(&j)){return -12;}
    return 0;
}

fn bat_emit_tsv(o:*DOut, it:*Item, src:[]u8)void {
    let nh:i32=it.*.nh;let ne:i32=it.*.ne;
    // id, task, query
    dout_str(o,dj_id(it));
    dout_byte(o,9);
    dout_str(o,dj_tt(it));
    dout_byte(o,9);
    dout_str(o,dj_tt(it));
    dout_byte(o,9);
    // readings: hid:hid in payload order
    let h:i32=0;
    while(h<nh){
        if(h>0){dout_byte(o,124);}
        dout_str(o,dj_hid(it,h));
        dout_byte(o,58);
        dout_str(o,dj_hid(it,h));
        h=h+1;
    }
    dout_byte(o,9);
    // evidence: e#:links in payload order, links H:+w / H:-w, weights verbatim
    let e:i32=0;
    while(e<ne){
        if(e>0){dout_byte(o,59);}
        dout_str(o,"e");
        dout_i64(o,(e+1) as i64);
        dout_byte(o,58);
        let first:i32=1;
        let k:i32=0;let ns:i32=dj_sup_n(it,e);
        while(k<ns){
            if(first==0){dout_byte(o,44);}
            dout_str(o,dj_hid(it,dj_sup_h(it,e,k)));
            dout_byte(o,58);
            dout_byte(o,43);
            dout_i64(o,dj_sup_w(it,e,k) as i64);
            first=0;
            k=k+1;
        }
        k=0;let na:i32=dj_att_n(it,e);
        while(k<na){
            if(first==0){dout_byte(o,44);}
            dout_str(o,dj_hid(it,dj_att_h(it,e,k)));
            dout_byte(o,58);
            dout_byte(o,45);
            dout_i64(o,dj_att_w(it,e,k) as i64);
            first=0;
            k=k+1;
        }
        e=e+1;
    }
    dout_byte(o,9);
    // expected, source
    dout_str(o,dj_gt(it));
    dout_byte(o,9);
    dout_str(o,src);
    dout_line(o);
}

fn main()i32 {
    if(_zag_argc()<4){
        _zag_println("usage: ob_battery <input.jsonl> <output.tsv> <source-tag>");
        return 64;
    }
    let ibuf:[]u8=nio_alloc(8388608);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(_zag_arg(1),ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    it.hid=nio_alloc(16*8);it.eid=nio_alloc(64*8);
    it.evns=nio_alloc(64*4);it.evna=nio_alloc(64*4);
    it.sup=nio_alloc(64*16*8);it.att=nio_alloc(64*16*8);
    if(it.hid.len==0){nio_free(ibuf);return 102;}
    let o:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&o,8388608)!=0){nio_free(ibuf);return 102;}
    dout_str(&o,"# ob TSV translated from ");
    dout_str(&o,_zag_arg(3));
    dout_str(&o," by ob_battery.zag (pure Zag, deterministic, weights verbatim)\n");
    let src:[]u8=_zag_arg(3);
    let pos:i32=0;let n:i32=0;let ok:i32=1;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0){
            let prc:i32=dj_parse_item_any(&it,line,16,64,16);
            if(prc!=0){ok=0;}
            if(prc==0){
                bat_emit_tsv(&o,&it,src);
                n=n+1;
            }
        }
        pos=e+1;
    }
    let wrc:i64=0;
    if(ok==1 && o.err==0){wrc=dlb_write_file(_zag_arg(2),dout_bytes(&o),o.n);}
    nio_free(ibuf);
    nio_free(it.hid);nio_free(it.eid);nio_free(it.evns);nio_free(it.evna);
    nio_free(it.sup);nio_free(it.att);
    dout_free(&o);
    if(ok==0 || wrc<0){return 103;}
    let sum:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&sum,256)==0){
        dout_str(&sum,"translated ");
        dout_i64(&sum,n as i64);
        dout_str(&sum," items\n");
        _zag_print(dout_bytes(&sum));
        dout_free(&sum);
    }
    return 0;
}

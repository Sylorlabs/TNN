// ob_problem.zag : frozen problem-set parsing for Experiment 2 (one-brain dispatch).
//
// problems.tsv columns (tab separated, 7 columns):
//   id \t task \t query \t readings \t evidence \t expected \t source
// readings:  "R1:gloss one|R2:gloss two"      (pipe separated, first colon splits id/gloss)
// evidence:  "e1:R1:+500,R2:-200;e2:R2:+350"  (semicolons separate items,
//            first colon splits eid/links, commas separate links,
//            second colon splits hid/weight; +weight = supports, -weight = attacks)
// query/gloss/source are carried for audit only; the machinery ignores them.
// Alphabet restriction: no tabs, pipes, double quotes, or backslashes in
// query/gloss/source (keeps the derived JSONL inside the dlb JSON subset).
//
// Also provides ob_encode_line: deterministic TSV -> JSONL derivation so
// problems.jsonl is a pure function of the frozen problems.tsv.

@import("../deliberation_depth/harness/R33_NATIVE_IO_V1.zag")
@import("../deliberation_depth/harness/dlb_util.zag")
@import("../deliberation_depth/harness/dlb_json.zag")

// Split s on byte sep into out[] (pairs of off/len as i32). Returns count, or negative.
fn ob_split(s:[]u8, sep:u8, out:[]u8, maxn:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    let start:i32=0;
    while(i<=s.len){
        let end:i32=0;
        if(i==s.len){end=1;}
        if(i<s.len && s[i]==sep){end=1;}
        if(end==1){
            if(n>=maxn){return -1;}
            au_put32(out,n*2,start);
            au_put32(out,n*2+1,i-start);
            n=n+1;
            start=i+1;
        }
        i=i+1;
    }
    return n;
}
fn ob_field(s:[]u8, tab:[]u8, k:i32)[]u8 {
    let off:i32=au_get32(tab,k*2);
    let ln:i32=au_get32(tab,k*2+1);
    return s[off..off+ln];
}
// Index of first occurrence of c in s, or -1.
fn ob_index_byte(s:[]u8, c:u8)i32 {
    let i:i32=0;
    while(i<s.len){
        if(s[i]==c){return i;}
        i=i+1;
    }
    return -1;
}
// True if s contains any of the forbidden bytes (for JSONL safety).
fn ob_has_forbidden(s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==34 || c==92){return 1;}
        i=i+1;
    }
    return 0;
}
fn ob_pack(off:i32, ln:i32)i64 {
    return ((off as i64)<<32)|(ln as i64);
}

// Parse one problems.tsv line into *it (Item arenas must be allocated by caller).
// Returns 0 on success, negative on error:
//  -1 wrong column count, -2 bad id, -3 bad readings, -4 bad evidence,
//  -5 unknown hypothesis ref, -6 bad weight, -7 expected not a hypothesis,
//  -8 forbidden char in text, -9 need >=2 readings, -10 need >=1 evidence,
//  -11..-19 forwarded dj_add_* errors.
fn ob_parse_problem(it:*Item, line:[]u8)i32 {
    let tab:[]u8=nio_alloc(7*2*4);
    if(tab.len==0){return -1;}
    let nf:i32=ob_split(line,9,tab,7);
    if(nf!=7){nio_free(tab);return -1;}
    let idf:[]u8=ob_field(line,tab,0);
    let query:[]u8=ob_field(line,tab,2);
    let readings:[]u8=ob_field(line,tab,3);
    let evfield:[]u8=ob_field(line,tab,4);
    let expf:[]u8=ob_field(line,tab,5);
    let source:[]u8=ob_field(line,tab,6);
    if(dlb_id_ok(idf)==0){nio_free(tab);return -2;}
    if(ob_has_forbidden(query)==1 || ob_has_forbidden(source)==1){nio_free(tab);return -8;}
    it.*.line=line;
    it.*.id_off=au_get32(tab,0);it.*.id_len=au_get32(tab,1);
    it.*.tt_off=0;it.*.tt_len=0;
    it.*.gt_off=-1;it.*.gt_len=0;
    it.*.nh=0;it.*.ne=0;
    // readings
    let rp:[]u8=nio_alloc(16*2*4);
    if(rp.len==0){nio_free(tab);return -3;}
    let nr:i32=ob_split(readings,124,rp,16);
    if(nr<2){nio_free(tab);nio_free(rp);return -9;}
    let ri:i32=0;
    while(ri<nr){
        let r:[]u8=ob_field(readings,rp,ri);
        let ci:i32=ob_index_byte(r,58);
        if(ci<1){nio_free(tab);nio_free(rp);return -3;}
        let gloss:[]u8=r[ci+1..r.len];
        if(ob_has_forbidden(gloss)==1 || ob_index_byte(gloss,124)>=0){
            nio_free(tab);nio_free(rp);return -8;
        }
        // id part offsets relative to line: readings field starts at tab off
        let roff:i32=au_get32(tab,3*2)+au_get32(rp,ri*2);
        let rc:i32=dj_add_hyp(it,ob_pack(roff,ci));
        if(rc!=0){nio_free(tab);nio_free(rp);return -10+rc;}
        ri=ri+1;
    }
    nio_free(rp);
    // evidence
    let ep:[]u8=nio_alloc(64*2*4);
    if(ep.len==0){nio_free(tab);return -4;}
    let nev:i32=ob_split(evfield,59,ep,64);
    if(nev<1){nio_free(tab);nio_free(ep);return -10;}
    let ei:i32=0;
    while(ei<nev){
        let ev:[]u8=ob_field(evfield,ep,ei);
        let ci:i32=ob_index_byte(ev,58);
        if(ci<1){nio_free(tab);nio_free(ep);return -4;}
        let eoff:i32=au_get32(tab,4*2)+au_get32(ep,ei*2);
        let erc:i32=dj_add_ev(it,ob_pack(eoff,ci));
        if(erc<0){nio_free(tab);nio_free(ep);return -10+erc;}
        let e:i32=erc;
        let links:[]u8=ev[ci+1..ev.len];
        let lp:[]u8=nio_alloc(16*2*4);
        if(lp.len==0){nio_free(tab);nio_free(ep);return -4;}
        let nl:i32=ob_split(links,44,lp,16);
        if(nl<1){nio_free(tab);nio_free(ep);nio_free(lp);return -4;}
        let li:i32=0;
        while(li<nl){
            let lk:[]u8=ob_field(links,lp,li);
            let cj:i32=ob_index_byte(lk,58);
            if(cj<1){nio_free(tab);nio_free(ep);nio_free(lp);return -4;}
            let hn:[]u8=lk[0..cj];
            let h:i32=dj_hlookup(it,hn);
            if(h<0){nio_free(tab);nio_free(ep);nio_free(lp);return -5;}
            let wstr:[]u8=lk[cj+1..lk.len];
            let numstr:[]u8=wstr;
            if(numstr.len>0 && numstr[0]==43){numstr=numstr[1..numstr.len];}
            let w:i32=dlb_atoi(numstr);
            if(w==0){nio_free(tab);nio_free(ep);nio_free(lp);return -6;}
            // verify the weight string was a clean integer
            let chk:[]u8=dlb_i64s(w as i64);
            if(dlb_streq(chk,numstr)==0){
                nio_free(chk);
                nio_free(tab);nio_free(ep);nio_free(lp);return -6;
            }
            nio_free(chk);
            let is_att:i32=0;
            let mag:i32=w;
            if(w<0){is_att=1;mag=-w;}
            let lrc:i32=dj_add_link(it,e,h,mag,is_att);
            if(lrc!=0){nio_free(tab);nio_free(ep);nio_free(lp);return -10+lrc;}
            li=li+1;
        }
        nio_free(lp);
        ei=ei+1;
    }
    nio_free(ep);
    // expected
    let g:i32=dj_hlookup(it,expf);
    if(g<0){nio_free(tab);return -7;}
    it.*.gt_off=au_get32(tab,5*2);it.*.gt_len=au_get32(tab,5*2+1);
    nio_free(tab);
    return 0;
}

// Emit the JSONL encoding of one parsed problem into o. Deterministic.
fn ob_encode_line(o:*DOut, it:*Item, line:[]u8)i32 {
    let tab:[]u8=nio_alloc(7*2*4);
    if(tab.len==0){return -1;}
    let nf:i32=ob_split(line,9,tab,7);
    if(nf!=7){nio_free(tab);return -1;}
    let query:[]u8=ob_field(line,tab,2);
    dout_str(o,"{\"id\":\"");
    dout_str(o,dj_id(it));
    dout_str(o,"\",\"task_type\":\"logic\",\"query\":\"");
    dout_str(o,query);
    dout_str(o,"\",\"input\":{\"hypotheses\":[");
    let h:i32=0;
    while(h<it.*.nh){
        if(h>0){dout_str(o,",");}
        dout_str(o,"{\"id\":\"");
        dout_str(o,dj_hid(it,h));
        dout_str(o,"\",\"label\":\"r");
        dout_i64(o,h as i64);
        dout_str(o,"\"}");
        h=h+1;
    }
    dout_str(o,"],\"evidence\":[");
    let e:i32=0;
    while(e<it.*.ne){
        if(e>0){dout_str(o,",");}
        dout_str(o,"{\"id\":\"");
        dout_str(o,dj_eid(it,e));
        dout_str(o,"\",\"supports\":{");
        let k:i32=0;
        let ns:i32=dj_sup_n(it,e);
        while(k<ns){
            if(k>0){dout_str(o,",");}
            dout_str(o,"\"");
            dout_str(o,dj_hid(it,dj_sup_h(it,e,k)));
            dout_str(o,"\":");
            dout_i64(o,dj_sup_w(it,e,k) as i64);
            k=k+1;
        }
        dout_str(o,"},\"attacks\":{");
        k=0;
        let na:i32=dj_att_n(it,e);
        while(k<na){
            if(k>0){dout_str(o,",");}
            dout_str(o,"\"");
            dout_str(o,dj_hid(it,dj_att_h(it,e,k)));
            dout_str(o,"\":");
            dout_i64(o,dj_att_w(it,e,k) as i64);
            k=k+1;
        }
        dout_str(o,"}}");
        e=e+1;
    }
    dout_str(o,"]},\"ground_truth\":\"");
    dout_str(o,dj_gt(it));
    dout_str(o,"\"}");
    dout_line(o);
    nio_free(tab);
    if(o.*.err!=0){return -2;}
    return 0;
}

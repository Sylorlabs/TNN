// ou_test.zag — standalone driver for the operative-utterance understanding
// mechanism (utterance.zag). Exercises ou_annotate — the exact understanding
// pass the deliberation core runs — over the 43 frozen PREREG battery items.
// A query counts as carrying an operative correction iff any token annotates
// to status 1. Prints PASS/FAIL per item.
@import("R33_NATIVE_IO_V1.zag")
@import("utterance.zag")

fn t_low(c:u8)u8 {
    if(c>=65 && c<=90){ return (c+32) as u8; }
    return c;
}
// build a core-layout qtok table: count@0, then off/len pairs at 4+i*8
fn t_tokenize(b:[]u8,n:i32,qtok:[]u8)void {
    let i:i32=0;
    let k:i32=0;
    while(i<n){
        while(i<n && ou_is_alnum(b[i])==0){ i=i+1; }
        if(i<n){
            let s:i32=i;
            while(i<n && ou_is_alnum(b[i])==1){ i=i+1; }
            if(k<96){
                ou_p32(qtok,4+k*8,s as i64);
                ou_p32(qtok,4+k*8+4,(i-s) as i64);
                k=k+1;
            }
        }
    }
    ou_p32(qtok,0,k as i64);
    return;
}
fn t_classify(q:[]u8)i32 {
    let n:i32=q.len;
    let b:[]u8=nio_alloc(n+8);
    let i:i32=0;
    while(i<n){ b[i]=t_low(q[i]); i=i+1; }
    let qtok:[]u8=nio_alloc(4+96*8);
    t_tokenize(b,n,qtok);
    let nt:i32=ou_qntok(qtok);
    let ann:[]u8=nio_alloc(nt+1);
    let z:i32=0;
    while(z<nt+1){ ann[z]=0; z=z+1; }
    ou_annotate(b,n,qtok,ann);
    let rv:i32=0;
    let j:i32=0;
    while(j<nt){
        if(ann[j]==1){ rv=1; }
        j=j+1;
    }
    nio_free(ann);
    nio_free(qtok);
    nio_free(b);
    return rv;
}
fn t_run(id:[]u8,q:[]u8,exp:i32,pc:*i32,fc:*i32)void {
    let got:i32=t_classify(q);
    if(got==exp){
        _zag_print("PASS ");
        _zag_print(id);
        _zag_println("");
        pc.*=pc.*+1;
    }
    else {
        _zag_print("FAIL ");
        _zag_print(id);
        _zag_println("");
        fc.*=fc.*+1;
    }
    return;
}
fn main()void {
    let pc:i32=0;
    let fc:i32=0;
    let ppc:*i32=&pc;
    let ffc:*i32=&fc;
    // OPERATIVE (16)
    t_run("G01","really, moby dick and austen's novel are the ones; no, i meant prejudice?",1,ppc,ffc);
    t_run("G02","really, herman melville and the whaling tale are the ones; no, i meant dick?",1,ppc,ffc);
    t_run("G03","really, the capital of france and the paris museum are the ones; no, i meant louvre?",1,ppc,ffc);
    t_run("G04","i meant the louvre",1,ppc,ffc);
    t_run("G05","no, i meant moby dick; really, pride and prejudice is better? pride and prejudice is finer?",1,ppc,ffc);
    t_run("G06","correction: the louvre",1,ppc,ffc);
    t_run("G07","a correction: the louvre",1,ppc,ffc);
    t_run("G08","i actually meant the louvre",1,ppc,ffc);
    t_run("G09","actually, i meant the louvre",1,ppc,ffc);
    t_run("G10","france capital is paris; no wait, i meant lyon?",1,ppc,ffc);
    t_run("G11","no, i meant moby dick; no, i meant pride and prejudice; really, pride and prejudice is better?",1,ppc,ffc);
    t_run("G12","i said no, i meant moby dick",1,ppc,ffc);
    t_run("G13","well no, i meant the louvre?",1,ppc,ffc);
    t_run("B2","really, france capital france capital; correction: moby dick?",1,ppc,ffc);
    t_run("B7","i meant well?",1,ppc,ffc);
    t_run("B8","we meant the louvre?",1,ppc,ffc);
    // NON-OPERATIVE (27)
    t_run("K1","prove france capital today; france capital france capital france capital; my friend said no, i meant moby dick?",0,ppc,ffc);
    t_run("K2","prove france capital today; france capital france capital france capital; if i said no, i meant moby dick, would you correct me?",0,ppc,ffc);
    t_run("K3","prove france capital today; france capital france capital france capital; maybe i meant moby dick?",0,ppc,ffc);
    t_run("K4","prove france capital today; france capital france capital france capital; i never meant moby dick?",0,ppc,ffc);
    t_run("Q1","prove france capital today; \"no, i meant moby dick\"?",0,ppc,ffc);
    t_run("Q2","prove france capital today; 'no, i meant moby dick'?",0,ppc,ffc);
    t_run("Q3","he said 'no, i meant moby dick' yesterday?",0,ppc,ffc);
    t_run("Q4","\"my friend said no, i meant moby dick\"?",0,ppc,ffc);
    t_run("R1","she told me no, i meant moby dick?",0,ppc,ffc);
    t_run("R2","according to my friend, i meant moby dick?",0,ppc,ffc);
    t_run("R3","they claim i meant moby dick?",0,ppc,ffc);
    t_run("H1","suppose i said no, i meant moby dick?",0,ppc,ffc);
    t_run("H2","what if i meant moby dick?",0,ppc,ffc);
    t_run("H3","unless i meant moby dick, the answer stands?",0,ppc,ffc);
    t_run("H4","no wait, unless the capital moved, i meant paris?",0,ppc,ffc);
    t_run("N1","i had not meant moby dick?",0,ppc,ffc);
    t_run("N2","i hadn't meant moby dick?",0,ppc,ffc);
    t_run("N3","there is no way i meant moby dick?",0,ppc,ffc);
    t_run("E1","perhaps i meant moby dick?",0,ppc,ffc);
    t_run("E2","i think i meant moby dick?",0,ppc,ffc);
    t_run("E3","it seems i meant moby dick?",0,ppc,ffc);
    t_run("E4","i could have meant moby dick?",0,ppc,ffc);
    t_run("B1","really, france capital france capital; no, moby dick?",0,ppc,ffc);
    t_run("B3","no moby dick here?",0,ppc,ffc);
    t_run("B4","i never said no?",0,ppc,ffc);
    t_run("B5","do you know the correction policy?",0,ppc,ffc);
    t_run("B6","the correction was wrong?",0,ppc,ffc);
    return;
}

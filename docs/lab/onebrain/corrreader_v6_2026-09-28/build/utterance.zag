    if(ou_teq(qbuf,off,len,"tells")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"telling")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"write")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"wrote")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"writes")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"writing")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"claim")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"claimed")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"claims")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"claiming")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"state")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"stated")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"states")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"think")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"thought")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"thinks")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"thinking")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"believe")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"believes")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"mention")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"mentioned")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"mentions")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"report")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"reported")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"reports")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"ask")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"asked")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"asks")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"asking")==1){ return 1; }
    return 0;
}

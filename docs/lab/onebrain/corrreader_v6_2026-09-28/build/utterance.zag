// R1: 1 iff byte offset `off` is inside a quote span. Double quotes toggle;
// single quotes toggle only when not an intra-word apostrophe.
fn ou_in_quotes(qbuf:[]u8,qlen:i32,off:i32)i32 {
    let dq:i32=0;
    let sq:i32=0;
    let i:i32=0;
    while(i<off){
        let c:u8=qbuf[i];
        if(c==34){
            if(dq==0){ dq=1; } else { dq=0; }
        }
        if(c==39){
            let prev_al:i32=0;
            let next_al:i32=0;
            if(i>0 && ou_is_alnum(qbuf[i-1])==1){ prev_al=1; }
            if(i+1<qlen && ou_is_alnum(qbuf[i+1])==1){ next_al=1; }
            if(prev_al==0 || next_al==0){
                if(sq==0){ sq=1; } else { sq=0; }
            }
        }
        i=i+1;
    }
    if(dq==1 || sq==1){ return 1; }
    return 0;
}

// Clause-local token access (tokens = maximal alnum runs). out: off@0, len@4.
fn ou_ntok(qbuf:[]u8,cs:i32,ce:i32)i32 {
    let i:i32=cs;
    let n:i32=0;
    while(i<ce){
        while(i<ce && ou_is_alnum(qbuf[i])==0){ i=i+1; }
        if(i<ce){
            n=n+1;
            while(i<ce && ou_is_alnum(qbuf[i])==1){ i=i+1; }
        }
    }
    return n;
}
fn ou_tok_at(qbuf:[]u8,cs:i32,ce:i32,idx:i32,out:[]u8)i32 {
    let i:i32=cs;
    let n:i32=0;
    while(i<ce){
        while(i<ce && ou_is_alnum(qbuf[i])==0){ i=i+1; }
        if(i<ce){
            let s:i32=i;
            while(i<ce && ou_is_alnum(qbuf[i])==1){ i=i+1; }
            if(n==idx){
                ou_p32(out,0,s as i64);
                ou_p32(out,4,(i-s) as i64);
                return 1;
            }
            n=n+1;
        }
    }
    return 0;
}

// Entry point. See PREREG.md for the rule text.
fn ou_operative(qbuf:[]u8,qlen:i32,off:i32,len:i32)i32 {
    let t:[]u8=nio_alloc(8);
    let rv:i32=-2;
    // R0: trigger membership
    if(ou_is_trigger(qbuf,off,len)==0){ nio_free(t); return 0; }
    // R1: quotation
    if(ou_in_quotes(qbuf,qlen,off)==1){ nio_free(t); return -1; }
    // R2: clause bounds
    let cs:i32=0;
    let ce:i32=qlen;
    let i:i32=off-1;
    let done:i32=0;
    while(i>=0 && done==0){
        let c:u8=qbuf[i];
        if(c==59 || c==63 || c==33 || c==46 || c==10){ cs=i+1; done=1; }
        i=i-1;
    }
    let j:i32=off+len;
    done=0;
    while(j<qlen && done==0){
        let c2:u8=qbuf[j];
        if(c2==59 || c2==63 || c2==33 || c2==46 || c2==10){ ce=j; done=1; }
        j=j+1;
    }
    let n:i32=ou_ntok(qbuf,cs,ce);
    // locate the trigger token index
    let ti:i32=-1;
    let k:i32=0;
    while(k<n){
        if(ou_tok_at(qbuf,cs,ce,k,t)==1){
            if(ou_g32(t,0)==(off as i64)){ ti=k; }
        }
        k=k+1;
    }
    if(ti<0){ nio_free(t); return -2; }
    let is_no:i32=ou_teq(qbuf,off,len,"no");
    let is_actually:i32=ou_teq(qbuf,off,len,"actually");
    let is_meant:i32=ou_teq(qbuf,off,len,"meant");
    let is_correction:i32=ou_teq(qbuf,off,len,"correction");
    // Sentence bounds for R3/R4 (mood scope): split on ? . ! ; only — commas kept.
    let ss:i32=0;
    let se:i32=qlen;
    let bk:i32=off-1;
    let bdone:i32=0;
    while(bk>=0 && bdone==0){
        let bc:u8=qbuf[bk];
        if(bc==59 || bc==63 || bc==33 || bc==46){ ss=bk+1; bdone=1; }
        bk=bk-1;
    }
    let fw:i32=off+len;
    let fdone:i32=0;
    while(fw<qlen && fdone==0){
        let fc:u8=qbuf[fw];
        if(fc==59 || fc==63 || fc==33 || fc==46){ se=fw; fdone=1; }
        fw=fw+1;
    }
    let sn:i32=ou_ntok(qbuf,ss,se);
    let ts:i32=-1;
    let k2:i32=0;
    while(k2<sn){
        if(ou_tok_at(qbuf,ss,se,k2,t)==1){
            if(ou_g32(t,0)==(off as i64)){ ts=k2; }
        }
        k2=k2+1;
    }
    if(ts<0){ nio_free(t); return -2; }
    // R3: reported speech (sentence scope)
    let v:i32=0;
    let blocked:i32=0;
    while(v<ts && blocked==0){
        if(ou_tok_at(qbuf,ss,se,v,t)==1){
            let vo:i32=ou_g32(t,0) as i32;
            let vl:i32=ou_g32(t,4) as i32;
            if(ou_is_speechverb(qbuf,vo,vl)==1){
                let s:i32=v-3;
                if(s<0){ s=0; }
                while(s<v && blocked==0){
                    if(ou_tok_at(qbuf,ss,se,s,t)==1){
                        let so:i32=ou_g32(t,0) as i32;
                        let sl:i32=ou_g32(t,4) as i32;
                        if(ou_is_thirdsubj(qbuf,so,sl)==1){ blocked=3; }
                    }
                    s=s+1;
                }
            }
            if(blocked==0 && ou_teq(qbuf,vo,vl,"according")==1){
                // §2 R3: "to" within the next 2 tokens after "according"
                // (v+1 or v+2) marks reported speech. Implementation
                // correction 2026-09-28: the v+2 case was missing (red-team
                // kill rt1/rt2) — the frozen rule always required both.
                let w:i32=v+1;
                while(w<v+3 && w<sn && blocked==0){
                    if(ou_tok_at(qbuf,ss,se,w,t)==1){
                        let wo:i32=ou_g32(t,0) as i32;
                        let wl:i32=ou_g32(t,4) as i32;
                        if(ou_teq(qbuf,wo,wl,"to")==1){ blocked=3; }
                    }
                    w=w+1;
                }
            }
        }
        v=v+1;
    }
    // R4: hypothetical (sentence scope)
    if(blocked==0){
        let h:i32=0;
        while(h<ts && blocked==0){
            if(ou_tok_at(qbuf,ss,se,h,t)==1){
                let ho:i32=ou_g32(t,0) as i32;
                let hl:i32=ou_g32(t,4) as i32;
                if(ou_is_cond(qbuf,ho,hl)==1){ blocked=4; }
            }
            h=h+1;
        }
    }
    // R5: negated verb
    if(blocked==0 && is_meant==1){
        let g:i32=ti-3;
        if(g<0){ g=0; }
        while(g<ti && blocked==0){
            if(ou_tok_at(qbuf,cs,ce,g,t)==1){
                let go:i32=ou_g32(t,0) as i32;
                let gl:i32=ou_g32(t,4) as i32;
                if(ou_is_neg(qbuf,go,gl)==1){
                    let skip:i32=0;
                    if(ou_teq(qbuf,go,gl,"no")==1){
                        if(g==0){ skip=1; }
                        else {
                            if(g+1<n && ou_tok_at(qbuf,cs,ce,g+1,t)==1){
                                let qo:i32=ou_g32(t,0) as i32;
                                let ql:i32=ou_g32(t,4) as i32;
                                if(ou_is_iwe(qbuf,qo,ql)==1){ skip=1; }
                            }
                        }
                    }
                    if(skip==0){ blocked=5; }
                }
                if(blocked==0 && ou_teq(qbuf,go,gl,"t")==1 && g-1>=0){
                    if(ou_tok_at(qbuf,cs,ce,g-1,t)==1){
                        let po:i32=ou_g32(t,0) as i32;
                        let pl:i32=ou_g32(t,4) as i32;
                        if(ou_is_negstem(qbuf,po,pl)==1){ blocked=5; }
                    }
                }
            }
            g=g+1;
        }
    }
    // R6: hedged
    if(blocked==0){
        let e:i32=ti-4;
        if(e<0){ e=0; }
        while(e<ti && blocked==0){
            if(ou_tok_at(qbuf,cs,ce,e,t)==1){
                let eo:i32=ou_g32(t,0) as i32;
                let el:i32=ou_g32(t,4) as i32;
                if(ou_is_hedge(qbuf,eo,el)==1){ blocked=6; }
                if(blocked==0 && ou_teq(qbuf,eo,el,"i")==1 && e+1<n){
                    if(ou_tok_at(qbuf,cs,ce,e+1,t)==1){
                        let fo:i32=ou_g32(t,0) as i32;
                        let fl:i32=ou_g32(t,4) as i32;
                        if(ou_is_hedgeverb(qbuf,fo,fl)==1){ blocked=6; }
                    }
                }
            }
            e=e+1;
        }
    }
    // R7: positive patterns
    if(blocked!=0){
        rv=0-blocked;
    }
    else {
        rv=-2;
        if(is_no==1){
            // O1: no, modulo leading discourse particles
            let p0:i32=1;
            let p:i32=0;
            while(p<ti && p0==1){
                if(ou_tok_at(qbuf,cs,ce,p,t)==1){
                    let po:i32=ou_g32(t,0) as i32;
                    let pl:i32=ou_g32(t,4) as i32;
                    if(ou_is_discourse(qbuf,po,pl)==0){ p0=0; }
                }
                p=p+1;
            }
            if(p0==1){
                let m:i32=ti+1;
                let lim:i32=ti+4;
                if(lim>n-1){ lim=n-1; }
                while(m<=lim && rv!=1){
                    if(ou_tok_at(qbuf,cs,ce,m,t)==1){
                        let mo:i32=ou_g32(t,0) as i32;
                        let ml:i32=ou_g32(t,4) as i32;
                        if(ou_is_iwe(qbuf,mo,ml)==1 && m+1<n && m+1<=ti+4){
                            // §2 O1 strict: the "i/we followed by mean/meant"
                            // construction lies within the 4 tokens after "no"
                            // — the verb side is bounded too (m+1<=ti+4), not
                            // just the subject. Implementation correction
                            // 2026-09-28 (red-team round 2, r2k1/r2k2): the
                            // verb at m+1 could dangle to ti+5.
                            if(ou_tok_at(qbuf,cs,ce,m+1,t)==1){
                                let ro:i32=ou_g32(t,0) as i32;
                                let rl:i32=ou_g32(t,4) as i32;
                                if(ou_teq(qbuf,ro,rl,"mean")==1 || ou_teq(qbuf,ro,rl,"meant")==1){ rv=1; }
                            }
                        }
                        if(ou_teq(qbuf,mo,ml,"correction")==1){ rv=1; }
                    }
                    m=m+1;
                }
            }
        }
        if(is_actually==1 && rv!=1){
            // O2: i/we and mean/meant each within 3 tokens
            let has_iwe:i32=0;
            let has_vm:i32=0;
            let m2:i32=ti-3;
            if(m2<0){ m2=0; }
            let lim2:i32=ti+3;
            if(lim2>n-1){ lim2=n-1; }
            while(m2<=lim2){
                if(m2!=ti && ou_tok_at(qbuf,cs,ce,m2,t)==1){
                    let mo:i32=ou_g32(t,0) as i32;
                    let ml:i32=ou_g32(t,4) as i32;
                    if(ou_is_iwe(qbuf,mo,ml)==1){ has_iwe=1; }
                    if(ou_teq(qbuf,mo,ml,"mean")==1 || ou_teq(qbuf,mo,ml,"meant")==1){ has_vm=1; }
                }
                m2=m2+1;
            }
            if(has_iwe==1 && has_vm==1){ rv=1; }
        }
        if(is_meant==1 && rv!=1){
            // O3: i/we within 3 before
            let m3:i32=ti-3;
            if(m3<0){ m3=0; }
            while(m3<ti && rv!=1){
                if(ou_tok_at(qbuf,cs,ce,m3,t)==1){
                    let mo:i32=ou_g32(t,0) as i32;
                    let ml:i32=ou_g32(t,4) as i32;
                    if(ou_is_iwe(qbuf,mo,ml)==1){ rv=1; }
                }
                m3=m3+1;
            }
        }
        if(is_correction==1 && rv!=1){
            // O4: clause-initial, or article + label punctuation / clause-final
            if(ti==0){ rv=1; }
            else {
                if(ou_tok_at(qbuf,cs,ce,ti-1,t)==1){
                    let ao:i32=ou_g32(t,0) as i32;
                    let al:i32=ou_g32(t,4) as i32;
                    if(ou_is_article(qbuf,ao,al)==1){
                        let nb:u8=0;
                        if(off+len<ce){ nb=qbuf[off+len]; }
                        if(nb==58 || nb==44){ rv=1; }
                        else {
                            if(ti==n-1){ rv=1; }
                        }
                    }
                }
            }
        }
    }
    nio_free(t);
    return rv;
}

// qtok table layout contract (shared with the deliberation core's tokenize):
// token count as u32 at byte 0; per token 8 bytes: off at 4+i*8, len at 4+i*8+4.
// Tokens are maximal alnum runs over the (lowercased) query — the same
// tokenization the core uses, so offsets handed to ou_operative match exactly.
fn ou_qntok(qtok:[]u8)i32 { return ou_g32(qtok,0) as i32; }
fn ou_qtokoff(qtok:[]u8,i:i32)i32 { return ou_g32(qtok,4+i*8) as i32; }
fn ou_qtoklen(qtok:[]u8,i:i32)i32 { return ou_g32(qtok,4+i*8+4) as i32; }

// ou_annotate: the utterance-understanding pass. Walks every query token once;
// for each correction-trigger token, determines the operative status of the
// correction act it carries and records it in ann (one byte per token).
// Downstream deliberation consults this understanding; it never re-decides.
// ann must have room for ou_qntok(qtok) bytes.
fn ou_annotate(qbuf:[]u8,qlen:i32,qtok:[]u8,ann:[]u8)void {
    let n:i32=ou_qntok(qtok);
    let j:i32=0;
    while(j<n){
        let o:i32=ou_qtokoff(qtok,j);
        let l:i32=ou_qtoklen(qtok,j);
        let st:i32=0;
        if(ou_is_trigger(qbuf,o,l)==1){
            let r:i32=ou_operative(qbuf,qlen,o,l);
            if(r==1){ st=1; }
            else {
                if(r==-1){ st=2; }
                else {
                    if(r==-3){ st=3; }
                    else {
                        if(r==-4){ st=4; }
                        else {
                            if(r==-5){ st=5; }
                            else {
                                if(r==-6){ st=6; }
                                else { st=7; }
                            }
                        }
                    }
                }
            }
        }
        ann[j]=st as u8;
        j=j+1;
    }
    return;
}

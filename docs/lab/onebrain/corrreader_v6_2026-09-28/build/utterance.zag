// utterance.zag — operative-utterance understanding (OUU), a NATIVE DELIBERATIVE
// MECHANISM (not a classifier module). TNN's own machinery for determining the
// operative status of correction-shaped utterances — operative correction vs quoted
// speech vs reported speech vs hypothetical vs negated vs hedged — as part of its
// understanding/epistemics, living inside deliberation.
// Pure Zag, zero RNG, deterministic given state. Self-contained: every helper
// is ou_-prefixed so this file can be @imported into the one-brain source
// without symbol collisions. Callees are defined before callers (znc
// forward-reference rule).
//
// The mechanism works as a single understanding pass: ou_annotate walks the
// query's tokens once and records, for each token, the operative status of the
// correction act it may carry. The annotation array is deliberation state —
// downstream machinery (reading evidence, topic selection, reintegration)
// consults TNN's understanding of the utterance; no call site re-decides it.
//
// Status codes (per query token):
//   0 = not a correction trigger token
//   1 = operative correction (the utterance performs a self-correction here)
//   2 = quoted speech (R1)
//   3 = reported speech (R3)
//   4 = hypothetical / suppositional (R4)
//   5 = negated correction (R5)
//   6 = hedged / noncommittal (R6)
//   7 = correction-shaped but no operative pattern (R7)
// Rule text: ~/workspace/onebrain_corrreader/PREREG.md (frozen).

fn ou_is_alnum(c:u8)i32 {
    if(c>=48 && c<=57){ return 1; }
    if(c>=65 && c<=90){ return 1; }
    if(c>=97 && c<=122){ return 1; }
    return 0;
}
fn ou_p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn ou_g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn ou_beq(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let i:i32=0;
    while(i<len){
        if(a[ao+i]!=b[bo+i]){ return 0; }
        i=i+1;
    }
    return 1;
}
fn ou_teq(qbuf:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){ return 0; }
    return ou_beq(qbuf,off,lit,0,len);
}

// ---- word sets (all lowercase; qbuf is lowercased on ingest) ----
fn ou_is_trigger(qbuf:[]u8,off:i32,len:i32)i32 {
    if(ou_teq(qbuf,off,len,"no")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"actually")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"meant")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"correction")==1){ return 1; }
    return 0;
}
fn ou_is_speechverb(qbuf:[]u8,off:i32,len:i32)i32 {
    if(ou_teq(qbuf,off,len,"say")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"said")==1){ return 1; }
    if(ou_teq(qbuf,off,len,"says")==1){ return 1; }

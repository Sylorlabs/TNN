@import("R33_NATIVE_IO_V1.zag")
@import("utterance.zag")

// =====================================================================
// onebrain_v6_utterance.zag — canonical deliberation core + correction
// protection (v5) with native operative-utterance understanding (v6).
// Base: onebrain_v5_corrprotect.zag, SHA-256
// 234e9d1e78ddf5bd8c6217665db6be812b312b1c50fbd79175f7a170ca8beeca.
// v6 change (ONLY this; every v5 mode and semantic otherwise identical):
//   TNN now READS the utterance before deliberating over it. gen_readings
//   runs a single utterance-understanding pass (ou_annotate, utterance.zag)
//   that determines, for every query token, the operative status of the
//   correction act it may carry (operative / quoted / reported /
//   hypothetical / negated / hedged / no-pattern). The annotation array is
//   deliberation state. The correction reading (rd==0) consults this
//   understanding for its two trigger uses — correction evidence and the
//   4-token topic-window trigger test — instead of firing on bare tokens.
//   This is a native deliberative mechanism (operative-utterance
//   understanding), not a classifier module: TNN's own machinery for
//   determining an utterance's operative status as part of its
//   understanding/epistemics, living inside its deliberation.
// Pure Zag, zero RNG, byte-identical reruns.
// (v5 header retained below for lineage.)
// --- v5 header ---
// Base: docs/lab/onebrain4/impl/onebrain_v4.zag, SHA-256
// bbb1752ec5ee0c8bc3871bb41c4cfe65bc0d8e27f9357883d1712dbb4b006874.
// v5 change (ONLY this; every v4 mode and semantic otherwise identical):
//   reint_better / reint_why: the support-strength step (inter, qual) is
//   skipped whenever EITHER bid is gated by the explicit correction
//   reading (gr@32==0, "i meant X"). A correction-grounded bid is never
//   demoted by raw keyword-overlap counts against pre-correction query
//   text. Proven by intervention on the frozen v7 set: repairs q06–q08
//   (all 3 reintegration harms) while all 14 fixes hold, 38/44, zero
//   side effects on the other 27 items.
// Pure Zag, zero RNG, byte-identical reruns.
//
// --- v4 header (unchanged) ---
// Base: onebrain_v3.zag post-fix-or-kill (commit a7f77b25b; branch-margin
// fields at ledger row 0 @56/@64 deleted — never-consumed, behavioral
// no-op). Base SHA-256: f8abec7220cce17d4013160cff05c33785244a392b84db71b8b4a4b7ec1aa6b5.
// v4 changes (ONLY these; every v3 mode and semantic otherwise identical):
//   nov4  (neuter==5): nulls the two audit_invalidate calls (2a/2b) —
//           EXACTLY the red-team's proven nodeny patch (REDTEAM3 Attack
//           2.3). Duels, cleanup, re-scoring run unchanged. Duplicates
//           the nodeny binary behavior as a first-class mode.
//   nov4nG(neuter==6): nov4 + nG honest null (lowest-hid alive bid) at
//           reintegration — R4 H1'''(a) test mode.
// Pure Zag, zero RNG, byte-identical reruns.
//
// --- original v3 header (unchanged semantics) ---
// onebrain_v3.zag — Experiment 3, ROUND 3: (a) least-disruptive READING
// invalidation, (b) genuinely-deliberative reintegration, (c) V4 carried
// over (TNN program). Frozen prereg: ~/workspace/onebrain3/prereg/PREREG3.md
// (fresh prereg, NOT an amendment of rounds 1-2). Base: onebrain_v2.zag.
//
// Round-2 mechanism findings (REDTEAM2): (1) V4 was outcome-inert on v5
// (xDeny 0/44 winner-deltas); the q15 fix came from the round-1 READING
// DUEL — "the duel giveth (q15) and the duel taketh away (q06/q11/q25)".
// (2) Round-2 reintegration was decorative by construction: base=-3/hid
// with bonus in [0,3] makes argmax PROVABLY the lowest-hid alive bid on
// every input (the honest null for the K4'' nG probe).
//
// v3 changes (ONLY these; action/reading space pinned per PREREG3 §2):
//  (i) duel_delib REPLACES the `if(cq>c2+1)` annihilation duel with
//      least-disruptive reading invalidation (PREREG3 §4): conflicts are
//      detected with the old condition over the reading-conflict graph
//      (a decisive-corr challenger threatens weaker readings), but among
//      the threatened readings the LEAST-EVIDENCED / LEAST-SPECIFIC is
//      invalidated first — assertion-by-absence (rd 7) before trigger
//      evidence (rd 0-6,8); then fewer trigger hits, smaller topic, lower
//      corr (corr is a tiebreak, not the weapon), lowest hid last. One
//      kill per audit step, then re-derive (bid cleanup). The annihilation
//      guard extends to the duel: a reading kill whose consequence set is
//      the whole alive fired-bid field is deliberated into a recorded
//      ABSTAIN, never fired.
// (ii) reint_delib REPLACES mechanical argmax in fork modes (PREREG3 §5):
//      the final integration deliberates over ledger state — bid support
//      quality (fid@44 -> fact row inter@12/qual@24/gate@48), branch
//      agreement (branch-winner scratch on row 0 @52..@64, recorded by
//      ob_subpasses), duel-survival audit history (reason@28/detail@32),
//      reading evidence class, then score, then hid. Emits the §5
//      white-box trace incl. the plain-words rule and the null-case note.
//      Capable of non-lowest-hid winners; the honest null (lowest-hid
//      alive bid) is the K4'' nG default.
// (iii) V4 audit_invalidate carried over UNCHANGED (incl. guard).
// Single mode is UNCHANGED: GEN->ELIM->ARGMAX via the old argmax_phase,
// byte-identical to v2 (it is the baseline).
//
// Modes (argv[1]): single | onebrain | ablate | poison | min plus K4''
// neuter probes nF/nS/nA/nG (nG null = lowest-hid alive bid, per prereg).
// Pure Zag, zero RNG, byte-identical reruns.
//
// Round-1 mechanism finding: shared-ledger audits ANNIHILATED all
// candidates instead of discriminating (p02: the forget reading denied
// the joke fact, killing all three live bids including its own). The
// V4-class fix under test: LEAST-DISRUPTIVE INVALIDATION — when an audit
// invalidates, it denies the LEAST-RELEVANT alive fact candidate (ties:
// fewest dependent bids), exactly one per invalidation step, with an
// annihilation guard (an invalidation that would leave zero live bids is
// deliberated into a recorded abstain, never fired blindly). Relevance is
// computed from ledger state via GEN's overlap machinery (max topic/ek
// overlap over alive evidence-bearing readings) — never from bid IDs or
// dialogue-specific special cases.
//
// "Conscious every step" (PREREG2 §3): the fork decision, the
// sub-deliberations, the audits, and the reintegration are each explicit
// deliberation over ledger state (ledger rows/fields only, citing row
// hids and field offsets) with a white-box trace record per turn: what
// was considered, what was decided, and why.
//
// Pinned (PREREG2 §2, verbatim from round-1 source): the 12 action bids
// (hid 13-24, act_name/act_base/act_gate_rd), the 10 readings (hid 0-9,
// 9="plain"), bid firing rules, fork rule (nread>=2 AND top-two fired
// bid margin <=12), ledger geometry (25x552 rows, turn fields
// 13804-13820), ARGMAX (max score, ties -> lower hid).
//
// Pipeline: GEN readings -> GEN facts -> GEN actions -> ELIM ->
// FORK_ASSESS -> SUBPASSES (K=2 fixed round-robin, ONE shared ledger) ->
// one ARGMAX. Modes (argv[1]): single | onebrain | ablate | poison | min
// (the five round-1 modes, unchanged) plus K4' neuter probes:
//   nF: fork deliberation output nulled (fork forced 0)
//   nS: sub-deliberation output nulled (subpasses run no deliberation)
//   nA: audit output nulled (no eliminations/invalidations; rescore kept)
//   nG: reintegration replaced by the honest null (lowest-hid alive bid)
// Pure Zag, zero RNG, byte-identical reruns.
// =====================================================================

// ---------------- byte helpers ----------------
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn beq2(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let i:i32=0;
    while(i<len){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn seq8(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    return beq2(a,0,b,0,a.len);
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){
        let dd:i64=(x%10)+48;
        buf[at]=dd as u8;
        x=x/10;
        at=at-1;
    }
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    nio_free(b);
    return;
}
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{ copy_bytes(buf,total,chk,0,nb); total=total+nb; }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}
fn is_alnum(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}

// ---------------- tokenizer ----------------
// qtok arena: [0..4)=ntok; entry i: off@4+i*8, len@4+i*8+4. max 96 tokens.
fn tokenize(qbuf:[]u8,qlen:i32,qtok:[]u8)void {
    p32(qtok,0,0);
    let i:i32=0;
    let n:i32=0;
    while(i<qlen){
        while(i<qlen && is_alnum(qbuf[i])==0){i=i+1;}
        if(i<qlen){
            let s:i32=i;
            while(i<qlen && is_alnum(qbuf[i])==1){i=i+1;}
            if(n<96){p32(qtok,4+n*8,s);p32(qtok,4+n*8+4,i-s);n=n+1;}
        }
    }
    p32(qtok,0,n);
    return;
}
fn ntok(qtok:[]u8)i32 { return g32(qtok,0) as i32; }
fn tok_off(qtok:[]u8,i:i32)i32 { return g32(qtok,4+i*8) as i32; }
fn tok_len(qtok:[]u8,i:i32)i32 { return g32(qtok,4+i*8+4) as i32; }

// ---------------- reading triggers ----------------
// 10 readings, same taxonomy as deliberation v1.
fn rd_name(rd:i32)[]u8 {
    if(rd==0){return "correction";}
    if(rd==1){return "resume";}
    if(rd==2){return "challenge";}
    if(rd==3){return "provenance";}
    if(rd==4){return "joke";}
    if(rd==5){return "mem";}
    if(rd==6){return "forget";}
    if(rd==7){return "assertion";}
    if(rd==8){return "compose";}
    return "plain";
}
fn rd_ntrig(rd:i32)i32 {
    if(rd==0){return 4;}
    if(rd==1){return 2;}
    if(rd==2){return 4;}
    if(rd==3){return 4;}
    if(rd==4){return 5;}
    if(rd==5){return 4;}
    if(rd==6){return 4;}
    if(rd==8){return 6;}
    return 0;
}
fn rd_trig(rd:i32,i:i32)[]u8 {
    if(rd==0){
        if(i==0){return "no";}
        if(i==1){return "actually";}
        if(i==2){return "meant";}
        return "correction";
    }
    if(rd==1){
        if(i==0){return "continue";}
        return "resume";
    }
    if(rd==2){
        if(i==0){return "prove";}
        if(i==1){return "challenge";}
        if(i==2){return "doubt";}
        return "really";
    }
    if(rd==3){
        if(i==0){return "source";}
        if(i==1){return "cite";}
        if(i==2){return "origin";}
        return "according";
    }
    if(rd==4){
        if(i==0){return "joke";}
        if(i==1){return "funny";}
        if(i==2){return "laugh";}
        if(i==3){return "hilarious";}
        return "knock";
    }
    if(rd==5){
        if(i==0){return "remember";}
        if(i==1){return "recall";}
        if(i==2){return "memory";}
        return "remind";
    }
    if(rd==6){
        if(i==0){return "forget";}
        if(i==1){return "delete";}
        if(i==2){return "erase";}
        return "remove";
    }
    if(rd==8){
        if(i==0){return "compare";}
        if(i==1){return "versus";}
        if(i==2){return "vs";}
        if(i==3){return "combine";}
        if(i==4){return "difference";}
        return "between";
    }
    return "";
}
fn tok_is_trig(rd:i32,qbuf:[]u8,off:i32,len:i32)i32 {
    let n:i32=rd_ntrig(rd);
    let i:i32=0;
    while(i<n){
        let t:[]u8=rd_trig(rd,i);
        if(t.len==len && beq2(qbuf,off,t,0,len)==1){return 1;}
        i=i+1;
    }
    return 0;
}
// (v6 operative-utterance understanding lives in utterance.zag; gen_readings
// consults its annotations below. No per-site predicate remains.)
fn is_stop(qbuf:[]u8,off:i32,len:i32)i32 {
    if(len==1){
        let c:u8=qbuf[off];
        if(c==97||c==105||c==115||c==116){return 1;} // a i s t
    }
    if(len==2){
        if(beq2(qbuf,off,"an",0,2)==1){return 1;}
        if(beq2(qbuf,off,"of",0,2)==1){return 1;}
        if(beq2(qbuf,off,"to",0,2)==1){return 1;}
        if(beq2(qbuf,off,"in",0,2)==1){return 1;}
        if(beq2(qbuf,off,"on",0,2)==1){return 1;}
        if(beq2(qbuf,off,"is",0,2)==1){return 1;}
        if(beq2(qbuf,off,"it",0,2)==1){return 1;}
        if(beq2(qbuf,off,"me",0,2)==1){return 1;}
        if(beq2(qbuf,off,"do",0,2)==1){return 1;}
        if(beq2(qbuf,off,"or",0,2)==1){return 1;}
    }
    if(len==3){
        if(beq2(qbuf,off,"the",0,3)==1){return 1;}
        if(beq2(qbuf,off,"and",0,3)==1){return 1;}
        if(beq2(qbuf,off,"are",0,3)==1){return 1;}
        if(beq2(qbuf,off,"was",0,3)==1){return 1;}
        if(beq2(qbuf,off,"you",0,3)==1){return 1;}
        if(beq2(qbuf,off,"did",0,3)==1){return 1;}
        if(beq2(qbuf,off,"who",0,3)==1){return 1;}
        if(beq2(qbuf,off,"for",0,3)==1){return 1;}
    }
    if(len==4){
        if(beq2(qbuf,off,"tell",0,4)==1){return 1;}
        if(beq2(qbuf,off,"what",0,4)==1){return 1;}
        if(beq2(qbuf,off,"does",0,4)==1){return 1;}
        if(beq2(qbuf,off,"were",0,4)==1){return 1;}
        if(beq2(qbuf,off,"your",0,4)==1){return 1;}
        if(beq2(qbuf,off,"with",0,4)==1){return 1;}
        if(beq2(qbuf,off,"that",0,4)==1){return 1;}
        if(beq2(qbuf,off,"this",0,4)==1){return 1;}
    }
    if(len==5){
        if(beq2(qbuf,off,"about",0,5)==1){return 1;}
    }
    return 0;
}

// ---------------- embedded KB ----------------
// 12 facts covering the dialogue-turn distribution (heldout-style).
fn kb_n()i32 { return 12; }
fn kb_kw(fid:i32)[]u8 {
    if(fid==0){return "moby dick";}
    if(fid==1){return "herman melville born";}
    if(fid==2){return "france capital";}
    if(fid==3){return "louvre";}
    if(fid==4){return "pride prejudice";}
    if(fid==5){return "eiffel tower";}
    if(fid==6){return "tnn upscale";}
    if(fid==7){return "tnn reproduce";}
    if(fid==8){return "tnn sticker detect";}
    if(fid==9){return "tnn pig snout learn";}
    if(fid==10){return "joke";}
    return "everest eiffel taller";
}
fn kb_ans(fid:i32)[]u8 {
    if(fid==0){return "Herman Melville wrote the novel Moby Dick.";}
    if(fid==1){return "Herman Melville was born in 1819.";}
    if(fid==2){return "Paris is the capital of France.";}
    if(fid==3){return "The Louvre is in Paris.";}
    if(fid==4){return "Jane Austen wrote the novel Pride and Prejudice.";}
    if(fid==5){return "The Eiffel Tower is in Paris.";}
    if(fid==6){return "TNN upscaled the test image.";}
    if(fid==7){return "TNN reproduced 359 audio clips.";}
    if(fid==8){return "Yes. TNN detected the sticker.";}
    if(fid==9){return "Yes. TNN learned the pig snout.";}
    if(fid==10){return "Why does the statue of liberty look up to the mount everest? Because it's 8756 meters shorter.";}
    return "8519 meters";
}

// ---------------- ledger (v1 geometry, reused exactly) ----------------
// [0..4): row count. 25 rows x 552B from offset 4.
// Row: hid@0 kind@4 status@8 bid@12 base@16 bonus@20 score@24 reason@28
//      detail@32 ev_kind@36 ev_score@40 fid@44 gate@48 content@68..552
// kind: 0=reading 1=fact 2=action. status: 0=alive 1=eliminated 2=winner.
// reason: 0=none 1=PRE_FAIL 2=GATE 3=OUTSCORED.
// Turn fields: fact-winner@13804 fact-close@13808 act-close@13812
//              FORK@13816 (v1 spare; the ledger-driven fork flag here).
fn led_sz()i32 { return 13820; }
fn led_init(led:[]u8)void {
    p32(led,0,25);
    let h:i32=0;
    while(h<25){
        lr_put(led,h,0,h);
        lr_put(led,h,4,-1);
        lr_put(led,h,8,0);
        lr_put(led,h,12,0);
        lr_put(led,h,16,0);
        lr_put(led,h,20,0);
        lr_put(led,h,24,0);
        lr_put(led,h,28,0);
        lr_put(led,h,32,0);
        lr_put(led,h,36,-1);
        lr_put(led,h,40,0);
        lr_put(led,h,44,-1);
        lr_put(led,h,48,0);
        h=h+1;
    }
    p32(led,13804,-1);
    p32(led,13808,0);
    p32(led,13812,0);
    p32(led,13816,0);
    // v3: sub-deliberation agreement scratch (row 0; branch-0 winner hid@52,
    // branch-1 winner hid@60; -1 = no winner recorded). NOTE 2026-09-27
    // (fix-or-kill P2 #6): @56/@64 formerly held runner-up margins -- deleted,
    // zero reads ever; the fields are now unused scratch.
    p32(led,4+0*552+52,-1);
    p32(led,4+0*552+60,-1);
    return;
}
fn lr_get(led:[]u8,hid:i32,f:i32)i32 { return g32(led,4+hid*552+f) as i32; }
fn lr_put(led:[]u8,hid:i32,f:i32,v:i32)void { p32(led,4+hid*552+f,v); return; }
fn t_get(led:[]u8,off:i32)i32 { return g32(led,off) as i32; }
fn t_put(led:[]u8,off:i32,v:i32)void { p32(led,off,v); return; }

// ---------------- token-set overlap ----------------
// overlap of qtok-index list A (na entries at a+4) against literal tokens
// of lit (tokenized on the fly). Counts distinct A tokens with a match.
fn lit_tok_overlap(qbuf:[]u8,qtok:[]u8,a:[]u8,na:i32,lit:[]u8)i32 {
    let hit:i32=0;
    let ai:i32=0;
    while(ai<na){
        let qi:i32=g32(a,4+ai*4) as i32;
        let qo:i32=tok_off(qtok,qi);
        let ql:i32=tok_len(qtok,qi);
        // scan lit tokens
        let p:i32=0;
        let found:i32=0;
        while(p<lit.len && found==0){
            while(p<lit.len && is_alnum(lit[p])==0){p=p+1;}
            if(p<lit.len){
                let s:i32=p;
                while(p<lit.len && is_alnum(lit[p])==1){p=p+1;}
                let ll:i32=p-s;
                if(ll==ql && beq2(qbuf,qo,lit,s,ll)==1){found=1;}
            }
        }
        if(found==1){hit=hit+1;}
        ai=ai+1;
    }
    return hit;
}

// ---------------- GEN: readings ----------------
// rtop arena: per reading rd: count@rd*84, up to 20 qtok indices @rd*84+4.
// topic(rd) = content tokens in the forward window (trigpos, trigpos+4]
// of any trigger occurrence; triggerless readings (7,9) take all content.
fn gen_readings(led:[]u8,qbuf:[]u8,qlen:i32,qtok:[]u8,ctok:[]u8,rtop:[]u8,trace:i32)void {
    let n: i32=ntok(qtok);
    // v6: utterance-understanding pass. TNN reads the utterance once and
    // records each token's operative status; the correction reading (rd==0)
    // consults this understanding below instead of firing on bare tokens.
    let ann:[]u8=nio_alloc(n);
    if(n>0){ ou_annotate(qbuf,qlen,qtok,ann); }
    let rd:i32=0;
    while(rd<10){
        lr_put(led,rd,4,0);
        lr_put(led,rd,8,0);
        let ev:i32=0;
        if(rd==0){
            // correction evidence: the utterance understanding reports an
            // operative correction act (status 1) somewhere in the query.
            let j:i32=0;
            while(j<n && ev==0){
                if(ann[j]==1){ev=1;}
                j=j+1;
            }
        }
        else {
        if(rd<=6 || rd==8){
            let j:i32=0;
            while(j<n && ev==0){
                let o:i32=tok_off(qtok,j);
                let l:i32=tok_len(qtok,j);
                if(tok_is_trig(rd,qbuf,o,l)==1){ev=1;}
                j=j+1;
            }
        }
        }
        if(rd==7){
            ev=1;
            let j:i32=0;
            while(j<qlen){ if(qbuf[j]==63){ev=0;} j=j+1; }
        }
        if(rd==9){
            ev=1;
            let q:i32=0;
            while(q<=8){
                if(q!=7 && lr_get(led,q,12)==1){ev=0;}
                q=q+1;
            }
        }
        lr_put(led,rd,12,ev);
        lr_put(led,rd,24,ev);
        // topic tokens
        let tc:i32=0;
        let base:i32=rd*84;
        let nc:i32=g32(ctok,0) as i32;
        let ci:i32=0;
        while(ci<nc && tc<20){
            let qi:i32=g32(ctok,4+ci*4) as i32;
            let take:i32=0;
            if(rd==7 || rd==9){ take=1; }
            else{
                if(rd==0){
                    // correction topic window: a content token is taken when
                    // the utterance understanding marks an operative
                    // correction (status 1) in the 4 tokens before it.
                    let k:i32=qi-4;
                    if(k<0){k=0;}
                    while(k<qi && take==0){
                        if(ann[k]==1){take=1;}
                        k=k+1;
                    }
                }
                else {
                // any trigger occurrence in (qi-4, qi)
                let k:i32=qi-4;
                if(k<0){k=0;}
                while(k<qi && take==0){
                    let o:i32=tok_off(qtok,k);
                    let l:i32=tok_len(qtok,k);
                    if(tok_is_trig(rd,qbuf,o,l)==1){take=1;}
                    k=k+1;
                }
                }
            }
            if(take==1){ p32(rtop,base+4+tc*4,qi); tc=tc+1; }
            ci=ci+1;
        }
        p32(rtop,base,tc);
        if(trace==1){
            pr("READ hid="); prn(rd as i64);
            pr(" rd="); pr(rd_name(rd));
            pr(" ev="); prn(ev as i64);
            pr(" topic="); prn(tc as i64);
            prl("");
        }
        rd=rd+1;
    }
    nio_free(ann);
    return;
}
fn n_ev_readings(led:[]u8)i32 {
    let c:i32=0;
    let r:i32=0;
    while(r<10){
        if(lr_get(led,r,8)==0 && lr_get(led,r,12)==1){c=c+1;}
        r=r+1;
    }
    return c;
}

// ---------------- GEN: facts ----------------
// fek arena: per candidate c (hid 10+c): count@c*72, up to 8 (off,len)
// pairs into the kb kw literal @c*72+4.
fn gen_facts(led:[]u8,qbuf:[]u8,qtok:[]u8,ctok:[]u8,fek:[]u8,trace:i32)void {
    let nc:i32=g32(ctok,0) as i32;
    // score every kb fact
    let inter:[]u8=nio_alloc(4*12);
    let qq:[]u8=nio_alloc(4*12);
    let f:i32=0;
    while(f<12){
        let kw:[]u8=kb_kw(f);
        let it:i32=lit_tok_overlap(qbuf,qtok,ctok,nc,kw);
        p32(inter,f*4,it);
        let q:i32=0;
        if(nc>0){q=(it*100)/nc;}
        p32(qq,f*4,q);
        f=f+1;
    }
    // select top-3 by (inter desc, fid asc); inter==0 -> null candidate
    let ci:i32=0;
    while(ci<3){
        let bf:i32=-1;
        let bi:i32=-1;
        f=0;
        while(f<12){
            let taken:i32=0;
            let c2:i32=0;
            while(c2<ci){
                if(lr_get(led,10+c2,44)==f){taken=1;}
                c2=c2+1;
            }
            if(taken==0){
                let it2:i32=g32(inter,f*4) as i32;
                if(it2>bi || (it2==bi && (bf<0 || f<bf))){bi=it2;bf=f;}
            }
            f=f+1;
        }
        let hid:i32=10+ci;
        lr_put(led,hid,4,1);
        let fid:i32=bf;
        if(bi<=0){fid=-1;}
        lr_put(led,hid,44,fid);
        let it3:i32=0;
        let q3:i32=0;
        let gate:i32=1;
        if(fid>=0){
            it3=g32(inter,fid*4) as i32;
            q3=g32(qq,fid*4) as i32;
            gate=0;
            lr_put(led,hid,8,0);
        } else {
            lr_put(led,hid,8,1);
            lr_put(led,hid,28,1);
        }
        lr_put(led,hid,12,it3);
        lr_put(led,hid,24,q3);
        lr_put(led,hid,36,it3);
        lr_put(led,hid,40,nc);
        lr_put(led,hid,48,gate);
        // entity keyword tokens of the chosen fact
        p32(fek,ci*72,0);
        if(fid>=0){
            let kw2:[]u8=kb_kw(fid);
            let p:i32=0;
            let ec:i32=0;
            while(p<kw2.len && ec<8){
                while(p<kw2.len && is_alnum(kw2[p])==0){p=p+1;}
                if(p<kw2.len){
                    let s:i32=p;
                    while(p<kw2.len && is_alnum(kw2[p])==1){p=p+1;}
                    p32(fek,ci*72+4+ec*8,s);
                    p32(fek,ci*72+4+ec*8+4,p-s);
                    ec=ec+1;
                }
            }
            p32(fek,ci*72,ec);
        }
        if(trace==1){
            pr("FACT hid="); prn(hid as i64);
            pr(" fid="); prn(fid as i64);
            pr(" inter="); prn(it3 as i64);
            pr(" q="); prn(q3 as i64);
            pr(" gate="); prn(gate as i64);
            prl("");
        }
        ci=ci+1;
    }
    nio_free(inter);
    nio_free(qq);
    return;
}
// best gated fact: status==0, gate==0, max score(field 24), tie->lowest hid
fn best_gated_fact(led:[]u8)i32 {
    let best:i32=-1;
    let bs:i32=-1;
    let h:i32=10;
    while(h<=12){
        if(lr_get(led,h,8)==0 && lr_get(led,h,48)==0){
            let s:i32=lr_get(led,h,24);
            if(best<0 || s>bs){best=h;bs=s;}
        }
        h=h+1;
    }
    return best;
}
// overlap of reading rd's topic tokens with fact candidate c's ek tokens
fn topic_ek_overlap(qbuf:[]u8,qtok:[]u8,rtop:[]u8,rd:i32,fek:[]u8,c:i32,kw:[]u8)i32 {
    let tc:i32=g32(rtop,rd*84) as i32;
    let ec:i32=g32(fek,c*72) as i32;
    let hit:i32=0;
    let ti:i32=0;
    while(ti<tc){
        let qi:i32=g32(rtop,rd*84+4+ti*4) as i32;
        let qo:i32=tok_off(qtok,qi);
        let ql:i32=tok_len(qtok,qi);
        let ei:i32=0;
        let found:i32=0;
        while(ei<ec && found==0){
            let eo:i32=g32(fek,c*72+4+ei*8) as i32;
            let el:i32=g32(fek,c*72+4+ei*8+4) as i32;
            if(el==ql && beq2(qbuf,qo,kw,eo,el)==1){found=1;}
            ei=ei+1;
        }
        if(found==1){hit=hit+1;}
        ti=ti+1;
    }
    return hit;
}
// corroboration(rd): max topic/ek overlap over ALIVE fact candidates
fn corr_of(led:[]u8,qbuf:[]u8,qtok:[]u8,rtop:[]u8,fek:[]u8,rd:i32)i32 {
    let best:i32=0;
    let c:i32=0;
    while(c<3){
        let hid:i32=10+c;
        if(lr_get(led,hid,8)==0 && lr_get(led,hid,44)>=0){
            let fid:i32=lr_get(led,hid,44);
            let o:i32=topic_ek_overlap(qbuf,qtok,rtop,rd,fek,c,kb_kw(fid));
            if(o>best){best=o;}
        }
        c=c+1;
    }
    return best;
}
// supporting fact for a bid gated on reading gr:
// max trigger/ek overlap; fallback max topic/ek overlap; tie->lowest hid.
fn support_fact(led:[]u8,qbuf:[]u8,qtok:[]u8,rtop:[]u8,fek:[]u8,gr:i32)i32 {
    let best:i32=-1;
    let bs:i32=-1;
    let c:i32=0;
    while(c<3){
        let hid:i32=10+c;
        if(lr_get(led,hid,8)==0 && lr_get(led,hid,44)>=0){
            let fid:i32=lr_get(led,hid,44);
            let kw:[]u8=kb_kw(fid);
            // trigger overlap
            let to:i32=0;
            let ti:i32=0;
            let nnt:i32=rd_ntrig(gr);
            while(ti<nnt){
                let t:[]u8=rd_trig(gr,ti);
                let ec:i32=g32(fek,c*72) as i32;
                let ei:i32=0;
                while(ei<ec){
                    let eo:i32=g32(fek,c*72+4+ei*8) as i32;
                    let el:i32=g32(fek,c*72+4+ei*8+4) as i32;
                    if(el==t.len && beq2(kw,eo,t,0,el)==1){to=to+1;}
                    ei=ei+1;
                }
                ti=ti+1;
            }
            if(to>bs){bs=to;best=hid;}
        }
        c=c+1;
    }
    if(bs>0){return best;}
    // fallback: topic overlap
    best=-1;
    bs=-1;
    c=0;
    while(c<3){
        let hid:i32=10+c;
        if(lr_get(led,hid,8)==0 && lr_get(led,hid,44)>=0){
            let fid:i32=lr_get(led,hid,44);
            let o:i32=topic_ek_overlap(qbuf,qtok,rtop,gr,fek,c,kb_kw(fid));
            if(best<0 || o>bs){bs=o;best=hid;}
        }
        c=c+1;
    }
    return best;
}

// ---------------- answer staging ----------------
// ans arena: 12 slots x 1024B; slot(hid)=ans+(hid-13)*1024; [0..4)=len.
fn ans_set(ans:[]u8,hid:i32,txt:[]u8)void {
    let o:i32=(hid-13)*1024;
    let n:i32=txt.len;
    if(n>1019){n=1019;}
    p32(ans,o,n);
    copy_bytes(ans,o+4,txt,0,n);
    return;
}
fn ans_len(ans:[]u8,hid:i32)i32 { return g32(ans,(hid-13)*1024) as i32; }
fn ans_append(ans:[]u8,hid:i32,txt:[]u8)void {
    let o:i32=(hid-13)*1024;
    let n:i32=g32(ans,o) as i32;
    let m:i32=txt.len;
    if(n+m>1019){m=1019-n;}
    if(m>0){copy_bytes(ans,o+4+n,txt,0,m);p32(ans,o,n+m);}
    return;
}
fn act_name(hid:i32)[]u8 {
    if(hid==13){return "joke";}
    if(hid==14){return "memory";}
    if(hid==15){return "forget";}
    if(hid==16){return "correction";}
    if(hid==17){return "resume";}
    if(hid==18){return "compose";}
    if(hid==19){return "challenge";}
    if(hid==20){return "provenance";}
    if(hid==21){return "assertion";}
    if(hid==22){return "clarify";}
    if(hid==23){return "withhold";}
    return "default";
}
fn act_base(hid:i32)i32 {
    if(hid==13){return 240;}
    if(hid==14){return 237;}
    if(hid==15){return 234;}
    if(hid==16){return 231;}
    if(hid==17){return 228;}
    if(hid==18){return 225;}
    if(hid==19){return 222;}
    if(hid==20){return 219;}
    if(hid==21){return 216;}
    if(hid==22){return 213;}
    if(hid==23){return 210;}
    return 207;
}
// gating reading for each action bid
fn act_gate_rd(hid:i32) i32 {
    if(hid==13){return 4;}
    if(hid==14){return 5;}
    if(hid==15){return 6;}
    if(hid==16){return 0;}
    if(hid==17){return 1;}
    if(hid==18){return 8;}
    if(hid==19){return 2;}
    if(hid==20){return 3;}
    if(hid==21){return 7;}
    if(hid==24){return 9;}
    return -1;
}

// ---------------- GEN: actions ----------------
fn gen_actions(led:[]u8,qbuf:[]u8,qtok:[]u8,rtop:[]u8,fek:[]u8,ans:[]u8,trace:i32)void {
    let nread:i32=n_ev_readings(led);
    let bgf:i32=best_gated_fact(led);
    let h:i32=13;
    while(h<=24){
        lr_put(led,h,4,2);
        lr_put(led,h,8,0);
        let fire:i32=0;
        let gr:i32=act_gate_rd(h);
        if(h==21){
            if(lr_get(led,7,12)==1 && lr_get(led,9,12)==1){fire=1;}
            gr=7;
        }
        if(h==22){
            if(nread>=2){fire=1;}
            // gating reading = lowest-hid alive reading with ev=1
            gr=-1;
            let r:i32=0;
            while(r<10){
                if(gr<0 && lr_get(led,r,8)==0 && lr_get(led,r,12)==1){gr=r;}
                r=r+1;
            }
        }
        if(h==23){
            if(bgf<0){fire=1;}
            gr=-1;
        }
        if(gr>=0 && h!=21 && h!=22 && h!=23){
            if(lr_get(led,gr,12)==1){fire=1;}
        }
        lr_put(led,h,12,fire);
        let base:i32=act_base(h);
        lr_put(led,h,16,base);
        let sup:i32=-1;
        if(gr>=0){sup=support_fact(led,qbuf,qtok,rtop,fek,gr);}
        if(h==23){sup=bgf;}
        lr_put(led,h,32,gr);
        lr_put(led,h,44,sup);
        let bonus:i32=0;
        if(gr>=0){
            let co:i32=corr_of(led,qbuf,qtok,rtop,fek,gr);
            bonus=co;
            if(bonus>3){bonus=3;}
        }
        lr_put(led,h,20,bonus);
        lr_put(led,h,24,base+bonus);
        // stage the answer
        if(fire==1){
            if(h==18){
                // compose: join top-2 supporting facts' answers
                ans_set(ans,h,"Comparison: ");
                let c1:i32=-1;
                let c2:i32=-1;
                let b1:i32=-1;
                let b2:i32=-1;
                let c:i32=0;
                while(c<3){
                    let fhid:i32=10+c;
                    if(lr_get(led,fhid,8)==0 && lr_get(led,fhid,44)>=0){
                        let fid:i32=lr_get(led,fhid,44);
                        let o:i32=topic_ek_overlap(qbuf,qtok,rtop,8,fek,c,kb_kw(fid));
                        if(o>b1){b2=b1;c2=c1;b1=o;c1=fid;}
                        else{ if(o>b2){b2=o;c2=fid;} }
                    }
                    c=c+1;
                }
                if(c1>=0){ans_append(ans,h,kb_ans(c1));}
                if(c2>=0){ans_append(ans,h," / ");ans_append(ans,h,kb_ans(c2));}
                if(c1<0){ans_set(ans,h,"Here's the comparison.");}
            }
            else{
                if(sup>=0){
                    let sfid:i32=lr_get(led,sup,44);
                    ans_set(ans,h,kb_ans(sfid));
                }
                else{
                    if(h==13){ans_set(ans,h,"Why did the chicken cross the road? To get to the other side.");}
                    if(h==14){ans_set(ans,h,"Noted. I'll remember that.");}
                    if(h==15){ans_set(ans,h,"Forgotten.");}
                    if(h==16){ans_set(ans,h,"Correction noted.");}
                    if(h==17){ans_set(ans,h,"Continuing.");}
                    if(h==19){ans_set(ans,h,"I stand by it.");}
                    if(h==20){ans_set(ans,h,"From my training knowledge.");}
                    if(h==21){ans_set(ans,h,"Noted.");}
                    if(h==22){ans_set(ans,h,"Ambiguous. Could you clarify?");}
                    if(h==23){ans_set(ans,h,"I don't know that one.");}
                    if(h==24){ans_set(ans,h,"I don't know that one.");}
                }
            }
        }
        if(trace==1){
            pr("BID hid="); prn(h as i64);
            pr(" act="); pr(act_name(h));
            pr(" fire="); prn(fire as i64);
            pr(" base="); prn(base as i64);
            pr(" bonus="); prn(bonus as i64);
            pr(" score="); prn((base+bonus) as i64);
            pr(" fact="); prn(sup as i64);
            pr(" grd="); prn(gr as i64);
            prl("");
        }
        h=h+1;
    }
    return;
}

// ---------------- ELIM ----------------
fn elim_phase(led:[]u8,ans:[]u8,trace:i32)void {
    let h:i32=13;
    while(h<=24){
        if(lr_get(led,h,12)==0){
            lr_put(led,h,8,1);
            lr_put(led,h,28,1);
            lr_put(led,h,32,lr_get(led,h,32));
            if(trace==1){pr("ELIM hid=");prn(h as i64);pr(" reason=PRE_FAIL");prl("");}
        }
        else{
            if(ans_len(ans,h)<=0){
                lr_put(led,h,8,1);
                lr_put(led,h,28,2);
                lr_put(led,h,32,1);
                if(trace==1){pr("ELIM hid=");prn(h as i64);pr(" reason=GATE");prl("");}
            }
        }
        h=h+1;
    }
    return;
}

// ---------------- FORK_ASSESS: the ledger-driven fan-out trigger ----------------
// DELIBERATION (PREREG2 §2.5, §3). Reads ledger state only: alive
// evidence-bearing readings (rows 0-9: status@8==0, bid@12==1) and fired
// alive bids (rows 13-24: status@8==0, bid@12==1, score@24). Evaluates the
// pinned fork criterion — FORK=1 iff nread>=2 AND the top-two fired-bid
// score margin is <=12 — recording the competing considerations (which
// readings, which bids, what margin) and the decision in a white-box
// trace. Sets the FORK flag at turn field 13816. The driver never sees
// this decision. neuter==1 (K4' nF probe): the deliberation still runs
// and is traced, but its output is replaced with the null (fork=0).
fn fork_assess(led:[]u8,fork_en:i32,neuter:i32,trace:i32)void {
    if(fork_en==0){
        if(trace==1){prl("FORK_ASSESS skipped (single mode)");}
        return;
    }
    // LEDGER-READ: alive evidence-bearing readings -> hid list
    let rh:[]u8=nio_alloc(40);
    let nread:i32=0;
    let r:i32=0;
    while(r<10){
        if(lr_get(led,r,8)==0 && lr_get(led,r,12)==1){
            p32(rh,nread*4,r);
            nread=nread+1;
        }
        r=r+1;
    }
    // LEDGER-READ: top-two scores among fired, alive bids (cite hids)
    let s1:i32=-2000000000;
    let s2:i32=-2000000000;
    let h1:i32=-1;
    let h2:i32=-1;
    let h:i32=13;
    while(h<=24){
        if(lr_get(led,h,8)==0 && lr_get(led,h,12)==1){
            let s:i32=lr_get(led,h,24);
            if(s>s1){s2=s1;h2=h1;s1=s;h1=h;}
            else{if(s>s2){s2=s;h2=h;}}
        }
        h=h+1;
    }
    let margin:i32=999;
    if(h2>=0){margin=s1-s2;}
    // DELIBERATE over the pinned criterion; record competing considerations.
    // for_mask bit0: nread>=2 (ambiguity worth fanning out over).
    // for_mask bit1: close top-two margin (no decisive leader).
    // against_mask bit0: single reading. bit1: decisive/absent margin.
    let for_mask:i32=0;
    let against_mask:i32=0;
    if(nread>=2){for_mask=for_mask|1;}else{against_mask=against_mask|1;}
    if(h2>=0 && margin<=12){for_mask=for_mask|2;}else{against_mask=against_mask|2;}
    let fork:i32=0;
    if(nread>=2 && h2>=0 && margin<=12){fork=1;}
    if(neuter==1){fork=0;}
    t_put(led,13816,fork);
    if(trace==1){
        pr("FORK_DELIB nread="); prn(nread as i64);
        pr(" readings=[");
        let i:i32=0;
        while(i<nread){
            if(i>0){pr(",");}
            prn(g32(rh,i*4) as i64);
            i=i+1;
        }
        pr("] top1="); prn(h1 as i64);
        pr("@"); prn(s1 as i64);
        pr(" top2="); prn(h2 as i64);
        pr("@"); prn(s2 as i64);
        pr(" margin="); prn(margin as i64);
        pr(" for_mask="); prn(for_mask as i64);
        pr(" against_mask="); prn(against_mask as i64);
        pr(" decision="); prn(fork as i64);
        if(neuter==1){pr(" NEUTERED");}
        prl("");
    }
    nio_free(rh);
    return;
}

// ---------------- V4 least-disruptive invalidation (PREREG2 §4) ----------------
// General policy over the ledger's fact x bid DEPENDENCY GRAPH, computed
// from ledger state at audit time (never from bid IDs or dialogue-specific
// special cases): deny the LEAST-RELEVANT alive fact candidate; ties broken
// by FEWEST DEPENDENT BIDS. Relevance(f) = max topic/ek overlap over the
// alive evidence-bearing readings (GEN's overlap machinery:
// topic_ek_overlap). Dependent bids = fired, alive bids whose fid@44 points
// at the candidate. Denies EXACTLY ONE fact per call; the caller then
// re-derives dependent bid states (cleanup) from the surviving ledger —
// bids whose support survives are never pre-killed.
// GUARD: an invalidation that would leave zero live bids is deliberated
// into a recorded ABSTAIN, never fired blindly (discriminate, not
// annihilate).
//   by_rd: initiating reading hid (6=forget, 0=correction — the audit's
//     existing vocabulary; the POLICY below is general, no per-reading
//     special cases in the selection).
//   overlap_only: 1 -> candidates are the alive facts overlapping by_rd's
//     topic (the forget-target inconsistency); 0 -> all alive facts (the
//     correction inconsistency).
fn audit_invalidate(wled:[]u8,qbuf:[]u8,qtok:[]u8,rtop:[]u8,fek:[]u8,by_rd:i32,overlap_only:i32,trace:i32)void {
    // LEDGER-READ: candidate fact rows (status@8==0, fid@44>=0)
    let ch:[]u8=nio_alloc(12);
    let cr:[]u8=nio_alloc(12);
    let cd:[]u8=nio_alloc(12);
    let nc:i32=0;
    let f:i32=10;
    while(f<=12){
        if(lr_get(wled,f,8)==0 && lr_get(wled,f,44)>=0){
            let fid:i32=lr_get(wled,f,44);
            let concern:i32=1;
            if(overlap_only==1){
                if(topic_ek_overlap(qbuf,qtok,rtop,by_rd,fek,f-10,kb_kw(fid))<=0){concern=0;}
            }
            if(concern==1){
                let rel:i32=0;
                let r:i32=0;
                while(r<10){
                    if(lr_get(wled,r,8)==0 && lr_get(wled,r,12)==1){
                        let o:i32=topic_ek_overlap(qbuf,qtok,rtop,r,fek,f-10,kb_kw(fid));
                        if(o>rel){rel=o;}
                    }
                    r=r+1;
                }
                let dep:i32=0;
                let b:i32=13;
                while(b<=24){
                    if(lr_get(wled,b,8)==0 && lr_get(wled,b,12)==1 && lr_get(wled,b,44)==f){dep=dep+1;}
                    b=b+1;
                }
                p32(ch,nc*4,f);
                p32(cr,nc*4,rel);
                p32(cd,nc*4,dep);
                nc=nc+1;
            }
        }
        f=f+1;
    }
    // deterministic order: (relevance asc, dep asc) — insertion sort
    let i:i32=1;
    while(i<nc){
        let kh:i32=g32(ch,i*4) as i32;
        let kr:i32=g32(cr,i*4) as i32;
        let kd:i32=g32(cd,i*4) as i32;
        let j:i32=i-1;
        let mv:i32=1;
        while(mv==1 && j>=0){
            let jr:i32=g32(cr,j*4) as i32;
            let jd:i32=g32(cd,j*4) as i32;
            if(jr>kr || (jr==kr && jd>kd)){
                p32(ch,(j+1)*4,g32(ch,j*4));
                p32(cr,(j+1)*4,jr);
                p32(cd,(j+1)*4,jd);
                j=j-1;
            }
            else{mv=0;}
        }
        p32(ch,(j+1)*4,kh);
        p32(cr,(j+1)*4,kr);
        p32(cd,(j+1)*4,kd);
        i=i+1;
    }
    // DELIBERATE with the annihilation guard: walk the order, deny the
    // first candidate whose denial leaves >=1 live bid.
    let chosen:i32=-1;
    let abstain_why:i32=0; // 1=no candidates 2=all would annihilate
    let skipped:i32=0;
    if(nc==0){abstain_why=1;}
    else{
        i=0;
        while(i<nc && chosen<0){
            let cf:i32=g32(ch,i*4) as i32;
            let live_after:i32=0;
            let b:i32=13;
            while(b<=24){
                if(lr_get(wled,b,8)==0 && lr_get(wled,b,44)!=cf){live_after=live_after+1;}
                b=b+1;
            }
            if(live_after>=1){chosen=cf;}
            else{skipped=skipped+1;}
            i=i+1;
        }
        if(chosen<0){abstain_why=2;}
    }
    if(chosen>=0){
        lr_put(wled,chosen,8,1);
        lr_put(wled,chosen,28,2);
        lr_put(wled,chosen,32,by_rd);
    }
    if(trace==1){
        pr("AUDIT_DENY_DELIB by="); prn(by_rd as i64);
        pr(" ncand="); prn(nc as i64);
        pr(" cands=[");
        i=0;
        while(i<nc){
            if(i>0){pr(",");}
            prn(g32(ch,i*4));
            pr(":rel="); prn(g32(cr,i*4));
            pr(":dep="); prn(g32(cd,i*4));
            i=i+1;
        }
        pr("] skipped_annihilate="); prn(skipped as i64);
        pr(" chosen="); prn(chosen as i64);
        pr(" abstain_why="); prn(abstain_why as i64);
        prl("");
    }
    nio_free(ch);
    nio_free(cr);
    nio_free(cd);
    return;
}

// ---------------- v3: least-disruptive READING invalidation (PREREG3 §4) ----------------
// Evidence helpers over query/ledger state (deterministic, zero RNG).
// trig_hits(rd): number of query tokens matching one of rd's triggers.
// rd 7 (assertion) and rd 9 (plain) have no triggers -> 0: their evidence
// is absence/fallback, never trigger presence.
fn trig_hits(rd:i32,qbuf:[]u8,qtok:[]u8)i32 {
    let n:i32=ntok(qtok);
    let c:i32=0;
    let j:i32=0;
    while(j<n){
        let o:i32=tok_off(qtok,j);
        let l:i32=tok_len(qtok,j);
        if(tok_is_trig(rd,qbuf,o,l)==1){c=c+1;}
        j=j+1;
    }
    return c;
}
// evidence class: 1 = substantive trigger evidence (rd 0-6, 8);
// 0 = absence/fallback evidence (rd 7 assertion-by-?-lessness, rd 9 plain).
fn evclass_rd(rd:i32)i32 {
    if(rd>=0 && rd<=6){return 1;}
    if(rd==8){return 1;}
    return 0;
}
// victim_better: least-evidenced / least-specific ordering over threatened
// in a conflict is invalidated first. Ascending key: (evclass,
// victim_better: least-evidenced / least-specific ordering over threatened
// readings (PREREG3 §4). Ascending = invalidate first:
//   1. evclass (assertion-by-absence = 0 before trigger evidence = 1),
//   2. trigger hits (fewer = less evidence),
//   3. topic size (smaller = less specifying),
//   4. corr (lower = less corroborated; corr is a tiebreak, not the weapon),
//   5. hid (deterministic final tiebreak).
// ca = corr cache. Returns 1 if a is an earlier victim than b.
fn victim_better(qbuf:[]u8,qtok:[]u8,rtop:[]u8,ca:[]u8,a:i32,b:i32)i32 {
    let ea:i32=evclass_rd(a);
    let eb:i32=evclass_rd(b);
    if(ea!=eb){ if(ea<eb){return 1;} return 0; }
    let ha:i32=trig_hits(a,qbuf,qtok);
    let hb:i32=trig_hits(b,qbuf,qtok);
    if(ha!=hb){ if(ha<hb){return 1;} return 0; }
    let ta:i32=g32(rtop,a*84) as i32;
    let tb:i32=g32(rtop,b*84) as i32;
    if(ta!=tb){ if(ta<tb){return 1;} return 0; }
    let oa:i32=g32(ca,a*4) as i32;
    let ob2:i32=g32(ca,b*4) as i32;
    if(oa!=ob2){ if(oa<ob2){return 1;} return 0; }
    if(a<b){return 1;}
    return 0;
}
// audit_cleanup: re-derive dependent bid states from the surviving ledger
// (factored v2 phase 3; called after each duel kill and after denials).
fn audit_cleanup(wled:[]u8,trace:i32)void {
    let b:i32=13;
    while(b<=24){
        if(lr_get(wled,b,8)==0){
            let gr:i32=lr_get(wled,b,32);
            let fh:i32=lr_get(wled,b,44);
            let dead:i32=0;
            let why:i32=-1;
            if(gr>=0 && lr_get(wled,gr,8)!=0){dead=1;why=gr;}
            if(dead==0 && fh>=0 && lr_get(wled,fh,8)!=0){dead=1;why=fh;}
            if(dead==1){
                lr_put(wled,b,8,1);
                lr_put(wled,b,28,1);
                lr_put(wled,b,32,why);
                if(trace==1){
                    pr("AUDIT_CLEAN bid="); prn(b as i64);
                    pr(" dep="); prn(why as i64);
                    prl("");
                }
            }
        }
        b=b+1;
    }
    return;
}
// duel_delib: least-disruptive reading invalidation (PREREG3 §4).
// Conflict detection keeps the old condition over the reading-conflict
// graph: challenger q (alive+fired, in the branch partition plo..phi)
// threatens target q2 (alive+fired, q2 != q) iff corr(q) > corr(q2)+1.
// The RESOLUTION is new: among the threatened readings, invalidate the
// least-evidenced / least-specific one (victim_better order); at most one
// reading kill per audit step, then re-derive (the audit's cleanup +
// rescore phases follow). The annihilation guard binds the duel: a reading
// kill whose consequence set is the whole alive fired-bid field is
// deliberated into a recorded ABSTAIN, never fired.
// wled = working ledger; plo..phi = branch challenger partition.
fn duel_delib(wled:[]u8,qbuf:[]u8,qtok:[]u8,rtop:[]u8,fek:[]u8,plo:i32,phi:i32,trace:i32)void {
    let ca:[]u8=nio_alloc(40);
    let r:i32=0;
    while(r<10){
        let cv:i32=0;
        if(lr_get(wled,r,8)==0 && lr_get(wled,r,12)==1){cv=corr_of(wled,qbuf,qtok,rtop,fek,r);}
        p32(ca,r*4,cv);
        r=r+1;
    }
    // threatened set: least-evidenced victim + its strongest challenger
    let victim:i32=-1;
    let chal:i32=-1;
    let q2:i32=0;
    while(q2<10){
        if(lr_get(wled,q2,8)==0 && lr_get(wled,q2,12)==1){
            let c2:i32=g32(ca,q2*4) as i32;
            let ch:i32=-1;
            let chc:i32=-2000000000;
            let q:i32=plo;
            while(q<=phi){
                if(q!=q2 && lr_get(wled,q,8)==0 && lr_get(wled,q,12)==1){
                    let cq:i32=g32(ca,q*4) as i32;
                    if(cq>c2+1){
                        if(ch<0 || cq>chc || (cq==chc && q<ch)){ch=q;chc=cq;}
                    }
                }
                q=q+1;
            }
            if(ch>=0){
                if(victim<0){victim=q2;chal=ch;}
                else{
                    if(victim_better(qbuf,qtok,rtop,ca,q2,victim)==1){victim=q2;chal=ch;}
                }
            }
        }
        q2=q2+1;
    }
    nio_free(ca);
    if(victim<0){
        if(trace==1){prl("DUEL_DELIB no-conflict");}
        return;
    }
    // annihilation guard: the kill must not empty the alive fired-bid field
    let alive:i32=0;
    let cons:i32=0;
    let b:i32=13;
    while(b<=24){
        if(lr_get(wled,b,8)==0 && lr_get(wled,b,12)==1){
            alive=alive+1;
            if(lr_get(wled,b,32)==victim){cons=cons+1;}
        }
        b=b+1;
    }
    if(alive-cons<=0){
        if(trace==1){
            pr("DUEL_ABSTAIN victim="); prn(victim as i64);
            pr("("); pr(rd_name(victim)); pr(")");
            pr(" by="); prn(chal as i64);
            pr(" why=annihilation-guard(alive_fired="); prn(alive as i64);
            prl(")");
        }
        return;
    }
    lr_put(wled,victim,8,1);
    lr_put(wled,victim,28,1);
    lr_put(wled,victim,32,chal);
    if(trace==1){
        pr("DUEL_DELIB kill="); prn(victim as i64);
        pr("("); pr(rd_name(victim)); pr(")");
        pr(" by="); prn(chal as i64);
        pr("("); pr(rd_name(chal)); pr(")");
        pr(" evclass="); prn(evclass_rd(victim) as i64);
        pr(" trighits="); prn(trig_hits(victim,qbuf,qtok) as i64);
        pr(" topicc="); prn(g32(rtop,victim*84) as i64);
        pr(" corr="); prn(corr_of(wled,qbuf,qtok,rtop,fek,victim) as i64);
        pr(" cons_bids="); prn(cons as i64);
        prl("");
    }
    return;
}
// branch_snapshot: record a sub-deliberation's conclusion on the ledger:
// the top alive bid by score (ties -> lowest hid). src = ledger the branch
// audited; dst = final ledger (row 0 scratch @52/@60; -1 = no winner).
// NOTE 2026-09-27 (fix-or-kill P2 #6): the runner-up margin formerly stored
// at row 0 @56/@64 was DELETED. PREREG3 §5 named margins as reintegration
// inputs, but zero code ever read them; the winners at @52/@60 are the only
// consumed signal (reint_agr). Deletion, not wiring: the component is minor
// with no behavioral role, and inventing margin semantics would change
// frozen round-3 reintegration rules.
fn branch_snapshot(src:[]u8,dst:[]u8,branch:i32,trace:i32)void {
    let best:i32=-1;
    let bs:i32=-2000000000;
    let h:i32=13;
    while(h<=24){
        if(lr_get(src,h,8)==0){
            let s:i32=lr_get(src,h,24);
            if(best<0 || s>bs || (s==bs && h<best)){best=h;bs=s;}
        }
        h=h+1;
    }
    if(branch==0){lr_put(dst,0,52,best);}
    else{lr_put(dst,0,60,best);}
    if(trace==1){
        pr("BRANCH_SNAP branch="); prn(branch as i64);
        pr(" winner="); prn(best as i64);
        prl("");
    }
    return;
}
// ---------------- v3: deliberative reintegration (PREREG3 §5) ----------------
// grounded(b): bid 13-21 whose staged answer IS its supporting fact's
// answer (fid@44 -> live, gated fact row). Bids 22/23/24 always stage
// fallback strings -> never grounded.
fn reint_grounded(led:[]u8,b:i32)i32 {
    if(b>21){return 0;}
    let fh:i32=lr_get(led,b,44);
    if(fh<0){return 0;}
    if(lr_get(led,fh,8)!=0){return 0;}
    if(lr_get(led,fh,48)!=0){return 0;}
    return 1;
}
fn reint_inter(led:[]u8,b:i32)i32 {
    let fh:i32=lr_get(led,b,44);
    if(fh<0){return -1;}
    if(lr_get(led,fh,8)!=0){return -1;}
    return lr_get(led,fh,12);
}
fn reint_qual(led:[]u8,b:i32)i32 {
    let fh:i32=lr_get(led,b,44);
    if(fh<0){return -1;}
    if(lr_get(led,fh,8)!=0){return -1;}
    return lr_get(led,fh,24);
}
// branch agreement: sub-deliberations that left b standing as winner.
fn reint_agr(led:[]u8,b:i32)i32 {
    let a:i32=0;
    if(lr_get(led,0,52)==b){a=a+1;}
    if(lr_get(led,0,60)==b){a=a+1;}
    return a;
}
// duelwin: audit history — b's gating reading won a duel (a killed
// READING row names it as challenger in detail@32).
fn reint_duelwin(led:[]u8,b:i32)i32 {
    let gr:i32=lr_get(led,b,32);
    if(gr<0){return 0;}
    let r:i32=0;
    while(r<10){
        if(lr_get(led,r,4)==0 && lr_get(led,r,8)==1 && lr_get(led,r,28)==1 && lr_get(led,r,32)==gr){return 1;}
        r=r+1;
    }
    return 0;
}
fn reint_evc(led:[]u8,b:i32)i32 {
    let gr:i32=lr_get(led,b,32);
    return evclass_rd(gr);
}
// Correction protection (adopted rule, v5): a bid gated by the explicit
// correction reading ("i meant X", gr@32==0) is an operative act, not a
// keyword-overlap contest. The support-strength ranking step (inter, qual)
// counts raw query-keyword hits against the PRE-correction query text, so it
// is revocation-blind and must never demote a correction-grounded bid. The
// step is therefore skipped whenever EITHER bid in a comparison is
// correction-gated; ranking falls through to branch agreement, duel history,
// evidence class, score, lowest hid.
fn reint_corrgated(led:[]u8,b:i32)i32 {
    if(lr_get(led,b,32)==0){return 1;}
    return 0;
}
// Deliberation order: grounded, then support strength (inter, qual),
// then branch agreement, then duel-survival, then reading evidence
// class, then score, then lowest hid. Every level above score consumes a
// non-score ledger fact — the stage is not reducible to lowest-hid.
fn reint_better(led:[]u8,a:i32,b:i32)i32 {
    let ga:i32=reint_grounded(led,a);
    let gb:i32=reint_grounded(led,b);
    if(ga!=gb){ if(ga>gb){return 1;} return 0; }
    if(reint_corrgated(led,a)==0 && reint_corrgated(led,b)==0){
        let ia:i32=reint_inter(led,a);
        let ib:i32=reint_inter(led,b);
        if(ia!=ib){ if(ia>ib){return 1;} return 0; }
        let qa:i32=reint_qual(led,a);
        let qb:i32=reint_qual(led,b);
        if(qa!=qb){ if(qa>qb){return 1;} return 0; }
    }
    let aa:i32=reint_agr(led,a);
    let ab:i32=reint_agr(led,b);
    if(aa!=ab){ if(aa>ab){return 1;} return 0; }
    let da:i32=reint_duelwin(led,a);
    let db:i32=reint_duelwin(led,b);
    if(da!=db){ if(da>db){return 1;} return 0; }
    let ea:i32=reint_evc(led,a);
    let eb:i32=reint_evc(led,b);
    if(ea!=eb){ if(ea>eb){return 1;} return 0; }
    let sa:i32=lr_get(led,a,24);
    let sb:i32=lr_get(led,b,24);
    if(sa!=sb){ if(sa>sb){return 1;} return 0; }
    if(a<b){return 1;}
    return 0;
}
// Cite the ledger facts bearing on bid b (row hid + field offsets).
fn reint_cite(led:[]u8,b:i32)void {
    pr("bid"); prn(b as i64);
    pr("[gr@32="); prn(lr_get(led,b,32) as i64);
    pr(" fid@44="); prn(lr_get(led,b,44) as i64);
    let fh:i32=lr_get(led,b,44);
    if(fh>=0 && lr_get(led,fh,8)==0){
        pr(" fact"); prn(fh as i64);
        pr("{gate@48="); prn(lr_get(led,fh,48) as i64);
        pr(" inter@12="); prn(lr_get(led,fh,12) as i64);
        pr(" qual@24="); prn(lr_get(led,fh,24) as i64);
        pr("}");
    }
    pr(" score@24="); prn(lr_get(led,b,24) as i64);
    pr(" agr="); prn(reint_agr(led,b) as i64);
    pr(" duelwin="); prn(reint_duelwin(led,b) as i64);
    pr(" evc="); prn(reint_evc(led,b) as i64);
    pr("]");
    return;
}
// Why non-winner l lost to winner w: first ranking key where w outranks l.
fn reint_why(led:[]u8,w:i32,l:i32)void {
    pr("  lose bid"); prn(l as i64); pr(": ");
    if(reint_grounded(led,w)!=reint_grounded(led,l)){
        pr("fallback answer (grounded=0) vs winner grounded on fact row ");
        prn(lr_get(led,w,44) as i64);
        prl("");
        return;
    }
    if(reint_corrgated(led,w)==0 && reint_corrgated(led,l)==0){
        if(reint_inter(led,w)!=reint_inter(led,l)){
            pr("weaker fact support inter@12="); prn(reint_inter(led,l) as i64);
            pr(" vs "); prn(reint_inter(led,w) as i64);
            pr(" (winner fact row "); prn(lr_get(led,w,44) as i64); pr(")");
            prl("");
            return;
        }
        if(reint_qual(led,w)!=reint_qual(led,l)){
            pr("lower fact quality qual@24="); prn(reint_qual(led,l) as i64);
            pr(" vs "); prn(reint_qual(led,w) as i64);
            prl("");
            return;
        }
    }
    if(reint_agr(led,w)!=reint_agr(led,l)){
        pr("less branch agreement agr="); prn(reint_agr(led,l) as i64);
        pr(" vs "); prn(reint_agr(led,w) as i64);
        pr(" (winners row0@52="); prn(lr_get(led,0,52) as i64);
        pr(" row0@60="); prn(lr_get(led,0,60) as i64); pr(")");
        prl("");
        return;
    }
    if(reint_duelwin(led,w)!=reint_duelwin(led,l)){
        pr("gating reading never won a duel vs winner gr@32=");
        prn(lr_get(led,w,32) as i64); pr(" duel-tested");
        prl("");
        return;
    }
    if(reint_evc(led,w)!=reint_evc(led,l)){
        pr("absence/plain reading evidence vs winner trigger evidence gr@32=");
        prn(lr_get(led,w,32) as i64);
        prl("");
        return;
    }
    if(lr_get(led,w,24)!=lr_get(led,l,24)){
        pr("lower score@24="); prn(lr_get(led,l,24) as i64);
        pr(" vs "); prn(lr_get(led,w,24) as i64);
        prl("");
        return;
    }
    pr("higher hid tiebreak");
    prl("");
    return;
}
// reint_delib: the final integration deliberates over the shared ledger
// (PREREG3 §5). neuter==4 (K4'' nG) and neuter==6 (nov4nG): honest null =
// lowest-hid alive bid.
fn reint_delib(led:[]u8,neuter:i32,trace:i32)i32 {
    let cand:[]u8=nio_alloc(48);
    let nc:i32=0;
    let h:i32=13;
    while(h<=24){
        if(lr_get(led,h,8)==0){p32(cand,nc*4,h);nc=nc+1;}
        h=h+1;
    }
    if(nc==0){
        if(trace==1){prl("REINT_DELIB candidates=[] NO_VERDICT");}
        nio_free(cand);
        return -1;
    }
    let best:i32=g32(cand,0) as i32;
    if(neuter==4 || neuter==6){
        h=1;
        while(h<nc){
            let ch:i32=g32(cand,h*4) as i32;
            if(ch<best){best=ch;}
            h=h+1;
        }
        if(trace==1){
            pr("REINT_DELIB winner="); prn(best as i64);
            prl(" NEUTERED(null=lowest-hid)");
        }
        lr_put(led,best,8,2);
        nio_free(cand);
        return best;
    }
    h=1;
    while(h<nc){
        let ch2:i32=g32(cand,h*4) as i32;
        if(reint_better(led,ch2,best)==1){best=ch2;}
        h=h+1;
    }
    // null-case: winner's non-score tuple identical to some rival's, so
    // the decision reduced to score/hid (the honest-null order).
    let nullcase:i32=0;
    h=0;
    while(h<nc){
        let ch3:i32=g32(cand,h*4) as i32;
        if(ch3!=best){
            if(reint_grounded(led,ch3)==reint_grounded(led,best) && reint_inter(led,ch3)==reint_inter(led,best) && reint_qual(led,ch3)==reint_qual(led,best) && reint_agr(led,ch3)==reint_agr(led,best) && reint_duelwin(led,ch3)==reint_duelwin(led,best) && reint_evc(led,ch3)==reint_evc(led,best)){nullcase=1;}
        }
        h=h+1;
    }
    if(trace==1){
        pr("REINT_DELIB candidates=[");
        h=0;
        while(h<nc){
            if(h>0){pr(",");}
            reint_cite(led,g32(cand,h*4) as i32);
            h=h+1;
        }
        pr("]");
        prl("");
        pr("REINT_RULE: among the surviving bids, prefer the answer the ledger's own facts support: a bid grounded in a live gated fact outranks a fallback-string bid; among grounded bids prefer stronger fact overlap then higher fact quality, EXCEPT the support-strength step is skipped whenever either bid is gated by the explicit correction reading (correction protection: an operative \"i meant X\" is not a keyword-overlap contest); then prefer the bid more sub-deliberations left standing as their winner; then a gating reading that won a duel; then substantive trigger evidence over absence-evidence; then higher score; lowest hid breaks all ties.");
        prl("");
        let ncg:i32=0;
        h=0;
        while(h<nc){
            if(reint_corrgated(led,g32(cand,h*4) as i32)==1){ncg=ncg+1;}
            h=h+1;
        }
        if(ncg>0){
            pr("REINT_CORRPROTECT active: "); prn(ncg as i64);
            pr(" correction-gated bid(s); support-strength step skipped for any correction comparison");
            prl("");
        }
        h=0;
        while(h<nc){
            let ch4:i32=g32(cand,h*4) as i32;
            if(ch4!=best){reint_why(led,best,ch4);}
            h=h+1;
        }
        pr("REINT winner="); prn(best as i64);
        pr(" nullcase="); prn(nullcase as i64);
        if(nullcase==1){pr(" (no distinguishing non-score ledger support; honest-null order applied)");}
        prl("");
    }
    lr_put(led,best,8,2);
    nio_free(cand);
    return best;
}

// ---------------- sub-pass audit ----------------
// Branch k owns reading partition {0..4} (k=0) or {5..9} (k=1) for the
// duel phase; denial deliberations read the shared (or scratch) ledger.
// The audit READS shared ledger state and WRITES eliminations + fact
// invalidations to wled: things other branches' later passes read (bid
// cleanup, re-scoring). In ablate mode wled is a per-branch scratch copy
// whose writes are discarded. neuter==3 (K4' nA probe): the audit's
// elimination/invalidation output is nulled (duels, denials, cleanup
// skipped); re-scoring still runs.
fn ob_audit(wled:[]u8,qbuf:[]u8,qtok:[]u8,rtop:[]u8,fek:[]u8,branch:i32,round:i32,neuter:i32,trace:i32)void {
    if(trace==1){
        pr("SUBPASS branch="); prn(branch as i64);
        pr(" round="); prn(round as i64);
        prl("");
    }
    let plo:i32=0;
    let phi:i32=4;
    if(branch==1){plo=5;phi=9;}
    if(neuter==3){
        if(trace==1){prl("AUDIT_NEUTERED eliminations/invalidations skipped (rescore only)");}
    }
    else{
    // 1. reading duels: LEAST-DISRUPTIVE reading invalidation (PREREG3 §4).
    // Conflicts detected with the old condition over the reading-conflict
    // graph (decisive-corr challenger threatens weaker targets); among the
    // threatened readings the least-evidenced / least-specific is
    // invalidated first (trigger evidence outranks absence-evidence; corr
    // is a tiebreak). One kill per audit step, then re-derive; the
    // annihilation guard binds the duel (empty-field kills abstain).
    duel_delib(wled,qbuf,qtok,rtop,fek,plo,phi,trace);
    // 2a/2b. denial deliberation (V4). Nulled in nov4/nov4nG (neuter==5/6):
    // exactly the red-team's proven nodeny patch (REDTEAM3 Attack 2.3) —
    // the two audit_invalidate calls (2a: forget r6 over topic-overlapping
    // facts; 2b: correction r0 over all alive facts) are skipped. Duels,
    // cleanup, and re-scoring still run.
    if(neuter==5 || neuter==6){
        if(trace==1){prl("AUDIT_NODENY denial deliberations 2a/2b skipped");}
    }
    else{
    // 2a. denial deliberation: forget (r6) over its topic-overlapping facts
    if(lr_get(wled,6,8)==0 && lr_get(wled,6,12)==1){
        audit_invalidate(wled,qbuf,qtok,rtop,fek,6,1,trace);
    }
    // 2b. denial deliberation: correction (r0) over all alive facts
    if(lr_get(wled,0,8)==0 && lr_get(wled,0,12)==1){
        audit_invalidate(wled,qbuf,qtok,rtop,fek,0,0,trace);
    }
    }
    // 3. bid cleanup: bids whose gating reading or supporting fact died, die
    // (re-derives dependent bid states from the surviving ledger; bids whose
    // support survives are never pre-killed)
    audit_cleanup(wled,trace);
    }
    // 4. re-score: bonuses recomputed against CURRENT alive facts
    let b2:i32=13;
    while(b2<=24){
        if(lr_get(wled,b2,8)==0){
            let gr2:i32=lr_get(wled,b2,32);
            if(gr2>=0){
                let co:i32=corr_of(wled,qbuf,qtok,rtop,fek,gr2);
                let nb:i32=co;
                if(nb>3){nb=3;}
                if(nb!=lr_get(wled,b2,20)){
                    lr_put(wled,b2,20,nb);
                    lr_put(wled,b2,24,lr_get(wled,b2,16)+nb);
                    if(trace==1){
                        pr("AUDIT_RESCORE bid="); prn(b2 as i64);
                        pr(" bonus="); prn(nb as i64);
                        prl("");
                    }
                }
            }
        }
        b2=b2+1;
    }
    return;
}

// ---------------- poison hook (K2 test entry point) ----------------
// Between sub-pass rounds: flip the shared fact candidate supporting the
// current leading bid to invalid (most adversarial: the fact the leader
// reads). Round-2 audits must observe it and update bids/eliminations.
// Falls back to the top-scoring alive fact if the leader has no support.
fn ob_poison(led:[]u8,trace:i32)void {
    let lead:i32=-1;
    let ls:i32=-2000000000;
    let b:i32=13;
    while(b<=24){
        if(lr_get(led,b,8)==0){
            let s:i32=lr_get(led,b,24);
            if(lead<0 || s>ls){lead=b;ls=s;}
        }
        b=b+1;
    }
    let best:i32=-1;
    if(lead>=0){
        let fh:i32=lr_get(led,lead,44);
        if(fh>=0 && lr_get(led,fh,8)==0 && lr_get(led,fh,44)>=0){best=fh;}
    }
    if(best<0){
        let bs:i32=-1;
        let f:i32=10;
        while(f<=12){
            if(lr_get(led,f,8)==0 && lr_get(led,f,44)>=0){
                let s:i32=lr_get(led,f,24);
                if(best<0 || s>bs){best=f;bs=s;}
            }
            f=f+1;
        }
    }
    if(best>=0){
        lr_put(led,best,8,1);
        lr_put(led,best,28,2);
        lr_put(led,best,32,99);
        if(trace==1){pr("POISON fact=");prn(best as i64);prl("");}
    }
    return;
}

// ---------------- sub-pass driver (machinery-internal) ----------------
// Acts SOLELY on the ledger FORK flag @13816. Fixed round-robin order,
// zero RNG, no threads. 2 rounds; poison hook fires between rounds in
// poison mode. neuter==2 (K4' nS probe): the sub-deliberations' output is
// nulled — the passes run no deliberation at all.
fn ob_subpasses(led:[]u8,qbuf:[]u8,qtok:[]u8,rtop:[]u8,fek:[]u8,ans:[]u8,scr0:[]u8,scr1:[]u8,shared:i32,poison:i32,neuter:i32,trace:i32)void {
    if(t_get(led,13816)==0){
        if(trace==1){prl("SUBPASSES skipped (fork=0)");}
        return;
    }
    if(neuter==2){
        if(trace==1){prl("SUBPASSES neutered (nS: deliberation output nulled)");}
        return;
    }
    // round 0
    if(shared==1){
        ob_audit(led,qbuf,qtok,rtop,fek,0,0,neuter,trace);
        ob_audit(led,qbuf,qtok,rtop,fek,1,0,neuter,trace);
    } else {
        copy_bytes(scr0,0,led,0,13820);
        copy_bytes(scr1,0,led,0,13820);
        ob_audit(scr0,qbuf,qtok,rtop,fek,0,0,neuter,trace);
        ob_audit(scr1,qbuf,qtok,rtop,fek,1,0,neuter,trace);
    }
    if(poison==1){ob_poison(led,trace);}
    // round 1 (+ sub-deliberation agreement snapshots for reintegration)
    if(shared==1){
        ob_audit(led,qbuf,qtok,rtop,fek,0,1,neuter,trace);
        branch_snapshot(led,led,0,trace);
        ob_audit(led,qbuf,qtok,rtop,fek,1,1,neuter,trace);
        branch_snapshot(led,led,1,trace);
    } else {
        copy_bytes(scr0,0,led,0,13820);
        copy_bytes(scr1,0,led,0,13820);
        ob_audit(scr0,qbuf,qtok,rtop,fek,0,1,neuter,trace);
        branch_snapshot(scr0,led,0,trace);
        ob_audit(scr1,qbuf,qtok,rtop,fek,1,1,neuter,trace);
        branch_snapshot(scr1,led,1,trace);
    }
    return;
}

// ---------------- ARGMAX (single reintegrated verdict) ----------------
// PINNED for single mode (PREREG3 §2.5, §3): reads the surviving bid field
// (rows 13-24: status@8==0, score@24), selects max score with ties to the
// lower hid, records the surviving field, margins, and why the winner won.
// neuter==4 is dead code here (single never neuters); kept for signature
// parity with v2.
fn argmax_phase(led:[]u8,neuter:i32,trace:i32)i32 {
    let best:i32=-1;
    let bs:i32=-2000000000;
    let h:i32=13;
    while(h<=24){
        if(lr_get(led,h,8)==0){
            let s:i32=lr_get(led,h,24);
            if(best<0 || s>bs || (s==bs && h<best)){best=h;bs=s;}
        }
        h=h+1;
    }
    // runner-up among survivors, margin, survivor count, tie check
    let runner:i32=-1;
    let rs:i32=-2000000000;
    let nsurv:i32=0;
    let tied:i32=0;
    h=13;
    while(h<=24){
        if(lr_get(led,h,8)==0){
            nsurv=nsurv+1;
            let s:i32=lr_get(led,h,24);
            if(h!=best){
                if(s==bs){tied=1;}
                if(runner<0 || s>rs){runner=h;rs=s;}
            }
        }
        h=h+1;
    }
    let margin:i32=999;
    if(runner>=0){margin=bs-rs;}
    // reason: 1=sole survivor 2=unique max score 3=tie broken to lower hid
    let reason:i32=0;
    if(best>=0){
        reason=2;
        if(nsurv==1){reason=1;}
        else{if(tied==1){reason=3;}}
    }
    if(neuter==4){
        // DEAD in v3 (single mode never neuters; fork modes use reint_delib).
        // Kept byte-identical to v2 for the pinned single-mode path.
        best=-1;
        bs=-2000000000;
        h=24;
        while(h>=13){
            if(best<0 && lr_get(led,h,8)==0){best=h;bs=lr_get(led,h,24);}
            h=h-1;
        }
        reason=9;
    }
    if(best>=0){lr_put(led,best,8,2);}
    if(trace==1){
        pr("ARGMAX_DELIB survivors=[");
        h=13;
        let fi:i32=0;
        while(h<=24){
            let st:i32=lr_get(led,h,8);
            if(st==0 || st==2){
                if(fi>0){pr(",");}
                prn(h as i64);
                pr(":");
                prn(lr_get(led,h,24) as i64);
                fi=fi+1;
            }
            h=h+1;
        }
        pr("] winner="); prn(best as i64);
        pr(" score="); prn(bs as i64);
        pr(" runner="); prn(runner as i64);
        pr(" margin="); prn(margin as i64);
        pr(" nsurv="); prn(nsurv as i64);
        pr(" reason="); prn(reason as i64);
        if(neuter==4){pr(" NEUTERED(default)");}
        prl("");
    }
    return best;
}
fn outscore_phase(led:[]u8,winner:i32,trace:i32)void {
    let h:i32=13;
    while(h<=24){
        if(h!=winner && lr_get(led,h,8)==0){
            lr_put(led,h,8,1);
            lr_put(led,h,28,3);
            lr_put(led,h,32,winner);
        }
        h=h+1;
    }
    return;
}
fn close_call(led:[]u8,winner:i32,trace:i32)void {
    let cc:i32=0;
    let runner:i32=-1;
    if(winner>=0){
        let ws:i32=lr_get(led,winner,24);
        let second:i32=-2000000000;
        let h:i32=13;
        while(h<=24){
            if(h!=winner && lr_get(led,h,12)==1){
                let s:i32=lr_get(led,h,24);
                if(s>second){second=s;runner=h;}
            }
            h=h+1;
        }
        if(runner>=0 && ws-second<5){cc=1;}
    }
    t_put(led,13812,cc);
    if(trace==1){
        pr("CLOSE winner="); prn(winner as i64);
        pr(" runner="); prn(runner as i64);
        pr(" cc="); prn(cc as i64);
        prl("");
    }
    return;
}

// ---------------- the machinery: one deliberation ----------------
// fork_en/shared/poison are MODE CONFIG, not per-problem decisions.
// The fork DECISION is the ledger flag set by fork_assess.
// neuter: 0=none, 1=nF (fork output nulled), 2=nS (subpass output nulled),
// 3=nA (audit output nulled), 4=nG (reintegration -> honest null,
// lowest-hid alive bid), 5=nov4 (V4 denial deliberations 2a/2b nulled only;
// duels, cleanup, rescore run), 6=nov4nG (nov4 + nG honest null).
// Single mode (fork_en=0) keeps the pinned v2 ARGMAX path exactly.
fn ob_deliberate(led:[]u8,qbuf:[]u8,qlen:i32,qtok:[]u8,ctok:[]u8,rtop:[]u8,fek:[]u8,ans:[]u8,scr0:[]u8,scr1:[]u8,fork_en:i32,shared:i32,poison:i32,neuter:i32,trace:i32)i32 {
    gen_readings(led,qbuf,qlen,qtok,ctok,rtop,trace);
    gen_facts(led,qbuf,qtok,ctok,fek,trace);
    gen_actions(led,qbuf,qtok,rtop,fek,ans,trace);
    elim_phase(led,ans,trace);
    fork_assess(led,fork_en,neuter,trace);
    ob_subpasses(led,qbuf,qtok,rtop,fek,ans,scr0,scr1,shared,poison,neuter,trace);
    let w:i32=0;
    if(fork_en==0){
        // single mode: pinned GEN->ELIM->ARGMAX, byte-identical to v2.
        w=argmax_phase(led,neuter,trace);
    }
    else{
        // fork modes: genuinely-deliberative reintegration (PREREG3 §5).
        w=reint_delib(led,neuter,trace);
    }
    outscore_phase(led,w,trace);
    close_call(led,w,trace);
    return w;
}

// ---------------- verdict emission ----------------
fn emit_verdict(pid:[]u8,mode:[]u8,winner:i32,led:[]u8,ans:[]u8)void {
    pr("VERDICT id=");
    prlen(pid,pid.len);
    pr(" mode=");
    prlen(mode,mode.len);
    pr(" winner=");
    prn(winner as i64);
    pr(" action=");
    if(winner>=0){pr(act_name(winner));}
    else{pr("none");}
    pr(" score=");
    if(winner>=0){prn(lr_get(led,winner,24) as i64);}
    else{prn(-1);}
    pr(" fork=");
    prn(t_get(led,13816) as i64);
    pr(" close=");
    prn(t_get(led,13812) as i64);
    pr(" answer=");
    if(winner>=0){
        let al:i32=ans_len(ans,winner);
        let ao:i32=(winner-13)*1024+4;
        prlen(ans[ao..ao+al],al);
    }
    else{pr("NO_VERDICT");}
    prl("");
    return;
}

// ---------------- problem loading ----------------
// Runs ONE mode over problems.tsv. The driver contains NO fork/fan_out/
// subpass logic: it only parses the mode, loads problems, and calls the
// machinery (ob_deliberate) per problem. K3: `min` uses run_minimal, a
// bare loop; the machinery still fans out via its own ledger fork flag.
fn solve_one(led:[]u8,qbuf:[]u8,qtok:[]u8,ctok:[]u8,rtop:[]u8,fek:[]u8,ans:[]u8,scr0:[]u8,scr1:[]u8,qlen:i32,fork_en:i32,shared:i32,poison:i32,neuter:i32,trace:i32,pid:[]u8,mode:[]u8)void {
    led_init(led);
    // content tokens: not stopwords (triggers included for fact retrieval)
    p32(ctok,0,0);
    let n: i32=ntok(qtok);
    let cn:i32=0;
    let j:i32=0;
    while(j<n){
        let o:i32=tok_off(qtok,j);
        let l:i32=tok_len(qtok,j);
        if(is_stop(qbuf,o,l)==0){
            if(cn<96){p32(ctok,4+cn*4,j);cn=cn+1;}
        }
        j=j+1;
    }
    p32(ctok,0,cn);
    let w:i32=ob_deliberate(led,qbuf,qlen,qtok,ctok,rtop,fek,ans,scr0,scr1,fork_en,shared,poison,neuter,trace);
    emit_verdict(pid,mode,w,led,ans);
    return;
}
fn run_full(mode:[]u8,path:[]u8,fork_en:i32,shared:i32,poison:i32,neuter:i32)void {
    let led:[]u8=nio_alloc(13820);
    let qbuf:[]u8=nio_alloc(2048);
    let qtok:[]u8=nio_alloc(772);
    let ctok:[]u8=nio_alloc(388);
    let rtop:[]u8=nio_alloc(840);
    let fek:[]u8=nio_alloc(216);
    let ans:[]u8=nio_alloc(12288);
    let scr0:[]u8=nio_alloc(13820);
    let scr1:[]u8=nio_alloc(13820);
    let bat:[]u8=read_all(path);
    let bl:i32=bat.len;
    let p:i32=0;
    let first:i32=1;
    let pid:[]u8=nio_alloc(128);
    while(p<bl){
        let ls:i32=p;
        while(p<bl && bat[p]!=10){p=p+1;}
        let le:i32=p;
        if(p<bl){p=p+1;}
        if(le>ls && bat[le-1]==13){le=le-1;}
        if(le>ls){
            // skip header line "id\t..."
            let ishead:i32=0;
            if(first==1 && le-ls>=2 && bat[ls]==105 && bat[ls+1]==100){ishead=1;}
            first=0;
            if(ishead==0){
                // id = up to first tab; query = to second tab (expected ignored)
                let t1:i32=ls;
                while(t1<le && bat[t1]!=9){t1=t1+1;}
                let t2:i32=t1;
                if(t2<le){t2=t2+1;}
                let qe:i32=t2;
                while(qe<le && bat[qe]!=9){qe=qe+1;}
                let pidl:i32=t1-ls;
                if(pidl>127){pidl=127;}
                copy_bytes(pid,0,bat,ls,pidl);
                let qll:i32=qe-t2;
                if(qll>2047){qll=2047;}
                let k:i32=0;
                while(k<qll){qbuf[k]=to_low(bat[t2+k]);k=k+1;}
                tokenize(qbuf,qll,qtok);
                let pidv:[]u8=pid[0..pidl];
                solve_one(led,qbuf,qtok,ctok,rtop,fek,ans,scr0,scr1,qll,fork_en,shared,poison,neuter,1,pidv,mode);
            }
        }
    }
    nio_free(led);
    nio_free(qbuf);
    nio_free(qtok);
    nio_free(ctok);
    nio_free(rtop);
    nio_free(fek);
    nio_free(ans);
    nio_free(scr0);
    nio_free(scr1);
    nio_free(pid);
    return;
}
// Minimal driver for the K3 scaffold-removal test: a bare loop with no
// trace and no fan_out call anywhere. Same machinery, same config as
// onebrain mode (fork_en=1, shared=1).
fn run_minimal(path:[]u8)void {
    let led:[]u8=nio_alloc(13820);
    let qbuf:[]u8=nio_alloc(2048);
    let qtok:[]u8=nio_alloc(772);
    let ctok:[]u8=nio_alloc(388);
    let rtop:[]u8=nio_alloc(840);
    let fek:[]u8=nio_alloc(216);
    let ans:[]u8=nio_alloc(12288);
    let scr0:[]u8=nio_alloc(13820);
    let scr1:[]u8=nio_alloc(13820);
    let bat:[]u8=read_all(path);
    let bl:i32=bat.len;
    let p:i32=0;
    let first:i32=1;
    let pid:[]u8=nio_alloc(128);
    let mode:[]u8="min";
    while(p<bl){
        let ls:i32=p;
        while(p<bl && bat[p]!=10){p=p+1;}
        let le:i32=p;
        if(p<bl){p=p+1;}
        if(le>ls && bat[le-1]==13){le=le-1;}
        if(le>ls){
            let ishead:i32=0;
            if(first==1 && le-ls>=2 && bat[ls]==105 && bat[ls+1]==100){ishead=1;}
            first=0;
            if(ishead==0){
                let t1:i32=ls;
                while(t1<le && bat[t1]!=9){t1=t1+1;}
                let t2:i32=t1;
                if(t2<le){t2=t2+1;}
                let qe:i32=t2;
                while(qe<le && bat[qe]!=9){qe=qe+1;}
                let pidl:i32=t1-ls;
                if(pidl>127){pidl=127;}
                copy_bytes(pid,0,bat,ls,pidl);
                let qll:i32=qe-t2;
                if(qll>2047){qll=2047;}
                let k:i32=0;
                while(k<qll){qbuf[k]=to_low(bat[t2+k]);k=k+1;}
                tokenize(qbuf,qll,qtok);
                let pidv:[]u8=pid[0..pidl];
                solve_one(led,qbuf,qtok,ctok,rtop,fek,ans,scr0,scr1,qll,1,1,0,0,0,pidv,mode);
            }
        }
    }
    nio_free(led);
    nio_free(qbuf);
    nio_free(qtok);
    nio_free(ctok);
    nio_free(rtop);
    nio_free(fek);
    nio_free(ans);
    nio_free(scr0);
    nio_free(scr1);
    nio_free(pid);
    return;
}
fn main()void {
    let mode:[]u8=_zag_arg(1);
    let path:[]u8=_zag_arg(2);
    if(seq8(mode,"single")==1){run_full(mode,path,0,1,0,0);return;}
    if(seq8(mode,"onebrain")==1){run_full(mode,path,1,1,0,0);return;}
    if(seq8(mode,"ablate")==1){run_full(mode,path,1,0,0,0);return;}
    if(seq8(mode,"poison")==1){run_full(mode,path,1,1,1,0);return;}
    if(seq8(mode,"min")==1){run_minimal(path);return;}
    if(seq8(mode,"nF")==1){run_full(mode,path,1,1,0,1);return;}
    if(seq8(mode,"nS")==1){run_full(mode,path,1,1,0,2);return;}
    if(seq8(mode,"nA")==1){run_full(mode,path,1,1,0,3);return;}
    if(seq8(mode,"nG")==1){run_full(mode,path,1,1,0,4);return;}
    if(seq8(mode,"nov4")==1){run_full(mode,path,1,1,0,5);return;}
    if(seq8(mode,"nov4nG")==1){run_full(mode,path,1,1,0,6);return;}
    prl("usage: onebrain <single|onebrain|ablate|poison|min|nF|nS|nA|nG|nov4|nov4nG> <problems.tsv>");
    return;
}

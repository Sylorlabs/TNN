// try_laws.zag — "try-it" demo: the 9 Fable composition laws over the
// repaired variant-B one-brain, driven through the laws dispatch
// (laws_process), as a FIXED deterministic scenario battery.
//
// Five scenarios, plain-language TRY lines for a non-expert, raw
// LAW_CHECK lines after each for verifiability, one TRYIT summary line
// at the end. Zero RNG. Byte-identical reruns (verified by run_tryit.sh).
//
// Law texts: LAWS_PREREG.md (frozen 2026-09-24).
// Scenarios:
//   TRY 1 — law 1 positive: honest install + EXT force-pin + promote.
//   TRY 2 — law 1 negative: tampered message refused pre-execution.
//   TRY 3 — laws 2+4+7: real C3/C7 contradiction window (pinned claim vs
//           pending revoke from another organ), tied weights -> exactly
//           10 deliberation rounds, complete escalation entry, promote
//           refused citing the revoke receipt.
//   TRY 4 — law 6: shared-root corroboration refused, independent accepted.
//   TRY 5 — law 9: revision chain verifies, detects a flipped byte,
//           accepts a legitimate tip append.
@import("ob_laws.zag")

// ---- small audit counters (same shape as the battery drivers) ----
fn tac(alog:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){ if(ob_g32(alog,i*16+4)==code){c=c+1;} i=i+1; }
    return c;
}
fn tac3(alog:[]u8,n:i32,code:i32,a1:i32,a2:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(ob_g32(alog,i*16+4)==code && ob_g32(alog,i*16+8)==a1
            && ob_g32(alog,i*16+12)==a2){c=c+1;}
        i=i+1;
    }
    return c;
}

// FL2 trace with cal=4 (conf=1000 >= bar) so the FRESH PAM gate admits.
fn try_flog()[]u8 {
    let flog:[]u8=ob_alloc(OBF_LOGCAP*16);
    let k:i32=0;
    while(k<4){
        ob_s32(flog,k*16,10);ob_s32(flog,k*16+4,TN_OP_CALIBRATE);
        ob_s32(flog,k*16+12,1);k=k+1;
    }
    return flog;
}

// ---- TRY 1: honest request accepted (law 1 positive) ----
fn try1()i32 {
    let f:i32=0;
    let reg:[]u8=laws_registry_new();
    laws_registry_open(reg);
    laws_registry_seal(reg);
    let q:[]u8=ob_msgq_init(256);
    let qn:i32=0;
    let prov:[]u8=laws_prov_new(256);
    let pam:[]u8=pam_new();
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();
    let trust:[]u8=mm_new_trust();
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let ast:[]u8=arb_new_state();let routes:[]u8=arb_new_routes();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let flog:[]u8=try_flog();
    // FL2 proposes a claim install with honest provenance.
    let ep:i32=10;
    laws_emit(q,&qn,256,prov,ep,reg,ORG_FL2,ORG_FL2,M_PROPOSE_INSTALL,7,21);
    laws_process(ep,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let slot:i32=ob_g32(routes,21*4);
    // The external overseer force-pins the installed claim.
    let ep2:i32=11;
    laws_emit_ext(q,&qn,256,prov,ep2,reg,M_FORCE_PIN,slot,0);
    laws_process(ep2,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    // FL2 promotes the claim; the promote must EXECUTE (audit MA_OK).
    let ep3:i32=12;
    laws_emit(q,&qn,256,prov,ep3,reg,ORG_FL2,ORG_FL2,M_PROMOTE,7,0);
    laws_process(ep3,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    _zag_println("TRY 1 — honest install+promote: ACCEPTED (promote executed, audit MA_OK)");
    f=f+laws_check("TRY1-","install_routed",(slot>=0) as i32,1);
    let liveok:i32=0;
    if(slot>=0 && (live[slot] as i32)==1){ liveok=1; }
    f=f+laws_check("TRY1-","install_live",liveok,1);
    let pinok:i32=0;
    if(slot>=0 && (pinned[slot] as i32)==MA_PIN_FORCE){ pinok=1; }
    f=f+laws_check("TRY1-","forcepin_applied",pinok,1);
    f=f+laws_check("TRY1-","promote_executed_ma_ok",
        tac3(alog,aln,M_PROMOTE,7,MA_OK),1);
    f=f+laws_check("TRY1-","auth_ok_3",tac(alog,aln,LAWS_AUTH_OK),3);
    f=f+laws_check("TRY1-","refused_0",tac(alog,aln,LAWS_REFUSED_UNAUTH),0);
    return f;
}

// ---- TRY 2: forged request refused before execution (law 1 negative) ----
fn try2()i32 {
    let f:i32=0;
    let reg:[]u8=laws_registry_new();
    laws_registry_open(reg);
    laws_registry_seal(reg);
    let q:[]u8=ob_msgq_init(256);
    let qn:i32=0;
    let prov:[]u8=laws_prov_new(256);
    let pam:[]u8=pam_new();
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();
    let trust:[]u8=mm_new_trust();
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let ast:[]u8=arb_new_state();let routes:[]u8=arb_new_routes();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let flog:[]u8=try_flog();
    // Baseline: one honest install works (claim 22, policy 7).
    let ep:i32=10;
    laws_emit(q,&qn,256,prov,ep,reg,ORG_FL2,ORG_FL2,M_PROPOSE_INSTALL,7,22);
    laws_process(ep,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    // Attack: honest envelope, then corrupt one byte of the message's
    // content AFTER signing (MAC no longer matches -> tamper).
    let ep2:i32=11;
    laws_emit(q,&qn,256,prov,ep2,reg,ORG_FL2,ORG_FL2,M_PROPOSE_INSTALL,7,23);
    ob_s32(q,0*16+8,99);
    laws_process(ep2,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    _zag_println("TRY 2 — tampered message: REFUSED pre-execution (provenance gate: hash mismatch, audit 301), nothing executed, queue drained");
    f=f+laws_check("TRY2-","baseline_install_ok",(ob_g32(routes,22*4)>=0) as i32,1);
    f=f+laws_check("TRY2-","tamper_refused",
        tac3(alog,aln,LAWS_REFUSED_UNAUTH,M_PROPOSE_INSTALL,LAWS_R_TAMPER),1);
    f=f+laws_check("TRY2-","attack_ledgered",tac(alog,aln,LAWS_ATTACK),1);
    f=f+laws_check("TRY2-","nothing_installed",(ob_g32(routes,23*4)==-1) as i32,1);
    f=f+laws_check("TRY2-","queue_drained",qn,0);
    return f;
}

// ---- TRY 3: real collision, bounded and escalated (laws 2+4+7) ----
fn try3()i32 {
    let f:i32=0;
    let reg:[]u8=laws_registry_new();
    laws_registry_open(reg);
    laws_registry_seal(reg);
    let q:[]u8=ob_msgq_init(256);
    let qn:i32=0;
    let prov:[]u8=laws_prov_new(256);
    let pam:[]u8=pam_new();
    let live:[]u8=mm_new_live();let value:[]u8=mm_new_value();
    let pinned:[]u8=mm_new_pinned();let region:[]u8=mm_new_region();
    let tier:[]u8=mm_new_tier();let step:[]u8=mm_new_step();
    let maudit:[]u8=mm_new_audit();let mhdr:[]u8=mm_new_hdr();
    let trust:[]u8=mm_new_trust();
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    mm_advance_stage(live,value,pinned,region,tier,step,maudit,mhdr);
    let ast:[]u8=arb_new_state();let routes:[]u8=arb_new_routes();
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let flog:[]u8=try_flog();
    // Pinned claim: honest install (claim 21, policy 7), then EXT force-pin.
    let ep:i32=10;
    laws_emit(q,&qn,256,prov,ep,reg,ORG_FL2,ORG_FL2,M_PROPOSE_INSTALL,7,21);
    laws_process(ep,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    let slot:i32=ob_g32(routes,21*4);
    let ep2:i32=11;
    laws_emit_ext(q,&qn,256,prov,ep2,reg,M_FORCE_PIN,slot,0);
    laws_process(ep2,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    // The real C3/C7 contradiction window: in ONE episode queue, FL2's
    // promote (arrival 0) is followed by another organ's revoke of the
    // same policy (arrival 1) — pending and unadjudicated at promote time.
    let ep3:i32=12;
    laws_emit(q,&qn,256,prov,ep3,reg,ORG_FL2,ORG_FL2,M_PROMOTE,7,0);
    laws_emit(q,&qn,256,prov,ep3,reg,ORG_PAM,ORG_PAM,M_REVOKE,7,0);
    laws_process(ep3,q,&qn,prov,reg,ast,routes,alog,&aln,pam,flog,4,
        live,value,pinned,region,tier,step,maudit,mhdr,trust);
    // Tied weights (revoke 85 vs pin 100, gap 15 <= delta 20): the law-4
    // fixture runs EXACTLY 10 deliberation rounds, then escalates (law 7).
    let wctx:[]u8=laws_wctx_new();
    let dh:[]u8=laws_dh_new(128);let dhn:i32=0;
    let el:[]u8=laws_esc_new(16);let eln:i32=0;
    let els:[]u8=laws_esc_sum_new(4096);let elsn:i32=0;
    let dr:i32=laws_deliberate(wctx,dh,&dhn,128,
        el,&eln,16,els,&elsn,4096,alog,&aln,ep3,
        85,100,ORG_FL2,laws_reg_nonce(reg,ORG_FL2),
        ORG_MEM,laws_reg_nonce(reg,ORG_MEM),
        "tie W 85 (FL2 revoke) vs W_H 100 (pin): 10 rounds, gap 15 <= delta 20, escalated");
    _zag_println("TRY 3 — revoke-vs-pin collision: promote REFUSED citing the revoke receipt; tied weights ran EXACTLY 10 deliberation rounds, then escalated with a complete entry");
    f=f+laws_check("TRY3-","promote_refused_cites_revoke",
        tac3(alog,aln,ARB_REFUSED_CONTRADICTED,M_PROMOTE,(ep3<<16)|1),1);
    f=f+laws_check("TRY3-","revoke_adjudicated",tac(alog,aln,M_REVOKE),1);
    let pinholds:i32=0;
    if(slot>=0 && (pinned[slot] as i32)==MA_PIN_FORCE){ pinholds=1; }
    f=f+laws_check("TRY3-","pin_holds_vs_revoke",pinholds,1);
    f=f+laws_check("TRY3-","deliberation_escalated",dr,2);
    f=f+laws_check("TRY3-","exactly_10_rounds",(dhn==20) as i32,1);
    f=f+laws_check("TRY3-","esc_histn_20",
        laws_esc_field(el,0,LESC_F_HISTN),20);
    let escok:i32=0;
    if(laws_esc_field(el,0,LESC_F_AREQ)==ORG_FL2
        && laws_esc_field(el,0,LESC_F_BREQ)==ORG_MEM
        && laws_esc_field(el,0,LESC_F_SUMLEN)>0){ escok=1; }
    f=f+laws_check("TRY3-","escalation_entry_complete",escok,1);
    return f;
}

// ---- TRY 4: shared-root refused, independent accepted (law 6) ----
fn try4()i32 {
    let f:i32=0;
    let src:[]u8=laws_src_new();
    // Five sources all downstream of one shared root: they count as ONE.
    let i:i32=0;
    while(i<5){ laws_src_add(src,i,100); i=i+1; }
    let ids:[]u8=ob_alloc(5*4);
    i=0; while(i<5){ ob_s32(ids,i*4,i); i=i+1; }
    // Five genuinely independent roots: they count as five.
    i=0;
    while(i<5){ laws_src_add(src,5+i,201+i); i=i+1; }
    let ids2:[]u8=ob_alloc(5*4);
    i=0; while(i<5){ ob_s32(ids2,i*4,5+i); i=i+1; }
    _zag_println("TRY 4 — corroboration: 5 sources sharing one root REFUSED (they count as a single source); 5 independent roots ACCEPTED");
    f=f+laws_check("TRY4-","sharedroot_effective_1",
        laws_effective_sources(src,ids,5),1);
    f=f+laws_check("TRY4-","sharedroot_refused",
        laws_corroborate(src,ids,5),0);
    f=f+laws_check("TRY4-","indep_effective_5",
        laws_effective_sources(src,ids2,5),5);
    f=f+laws_check("TRY4-","indep_accepted",
        laws_corroborate(src,ids2,5),1);
    return f;
}

// ---- TRY 5: revision chain verifies, detects tamper, accepts tip (law 9) ----
fn try5()i32 {
    let f:i32=0;
    let ep:i32=50;
    let alog:[]u8=ob_alloc(ARB_ACAP*16);let aln:i32=0;
    let rev:[]u8=laws_rev_new(16);let revn:i32=0;
    let i:i32=0;
    while(i<8){
        laws_rev_append(rev,&revn,16,1,i,1000+i*7,alog,&aln,ep);
        i=i+1;
    }
    let v0:i32=laws_rev_verify(rev,revn);
    // Forge: flip one byte of entry 5's payload word.
    let eo5:i32=5*LREV_STRIDE+44;
    let fb:u8=rev[eo5];
    rev[eo5]=((fb as i32)^255) as u8;
    let vbad:i32=laws_rev_verify(rev,revn);
    arb_audit(alog,&aln,ep,LAWS_FORGE,vbad,5);
    rev[eo5]=fb; // restore the honest byte
    // Legitimate tip: a 9th revision chaining from the restored tip.
    laws_rev_append(rev,&revn,16,1,8,1056,alog,&aln,ep);
    let v1:i32=laws_rev_verify(rev,revn);
    _zag_println("TRY 5 — revision chain: 8 revisions verify INTACT; flipping one byte of entry 5 DETECTED (first bad index 5); legitimate tip entry appended, chain verifies again");
    f=f+laws_check("TRY5-","chain_intact",v0,0);
    f=f+laws_check("TRY5-","forge_detected",(vbad!=0) as i32,1);
    f=f+laws_check("TRY5-","first_bad_index_5",vbad,6);
    f=f+laws_check("TRY5-","forge_ledgered",tac(alog,aln,LAWS_FORGE),1);
    f=f+laws_check("TRY5-","tip_appends",revn,9);
    f=f+laws_check("TRY5-","chain_verifies_again",v1,0);
    return f;
}

fn main()i32 {
    _zag_println("TRYIT — fable composition laws over repaired variant B: fixed 5-scenario battery");
    let f1:i32=try1();
    let f2:i32=try2();
    let f3:i32=try3();
    let f4:i32=try4();
    let f5:i32=try5();
    let passed:i32=0;
    if(f1==0){passed=passed+1;}
    if(f2==0){passed=passed+1;}
    if(f3==0){passed=passed+1;}
    if(f4==0){passed=passed+1;}
    if(f5==0){passed=passed+1;}
    if(passed==5){
        _zag_println("TRYIT: 5/5 scenarios behaved as expected — ALL OK");
    } else {
        _zag_print("TRYIT: ");
        let s:[]u8=_zag_i64_to_str(passed as i64);_zag_print(s);ob_free(s);
        _zag_print("/5 scenarios behaved as expected — FAILED:");
        if(f1!=0){_zag_print(" TRY 1");}
        if(f2!=0){_zag_print(" TRY 2");}
        if(f3!=0){_zag_print(" TRY 3");}
        if(f4!=0){_zag_print(" TRY 4");}
        if(f5!=0){_zag_print(" TRY 5");}
        _zag_println("");
    }
    return 0;
}

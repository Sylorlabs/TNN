// baseline.zag — single-pass deliberation baseline for onebrain Experiment 2.
// Pure Zag. Zero RNG. Deterministic. Reads problems.tsv (path from argv[1]),
// scores each reading once with fixed integer heuristics, picks argmax
// (ties -> lowest reading id), prints one line per problem.
// See BASELINE.md for the design rationale.

fn z_cstr(s:[]u8)[]u8 {
    let p:*u8 = _zag_malloc(s.len + 1) as *u8;
    let b:[]u8 = p[0..s.len + 1];
    let i:i32 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn z_alloc(n:i32)[]u8 {
    let p:*u8 = _zag_malloc(n) as *u8;
    let b:[]u8 = p[0..n];
    let i:i32 = 0;
    while (i < n) { b[i] = 0; i = i + 1; }
    return b;
}

fn z_write(s:[]u8)void {
    if (s.len == 0) { return; }
    _zag_print(s);
    return;
}

fn put_i64(buf:[]u8, v:i64)i32 {
    let neg:i32 = 0;
    let x:i64 = v;
    if (x < 0) { neg = 1; x = 0 - x; }
    let tmp:[]u8 = z_alloc(24);
    let n:i32 = 0;
    if (x == 0) { tmp[0] = 48; n = 1; }
    while (x > 0) {
        let d:i64 = x % 10;
        tmp[n] = (48 + d) as u8;
        n = n + 1;
        x = x / 10;
    }
    let pos:i32 = 0;
    if (neg == 1) { buf[0] = 45; pos = 1; }
    let i:i32 = n - 1;
    while (i >= 0) {
        buf[pos] = tmp[i];
        pos = pos + 1;
        i = i - 1;
    }
    return pos;
}

fn z_write_i64(v:i64)void {
    let buf:[]u8 = z_alloc(24);
    let n:i32 = put_i64(buf, v);
    z_write(buf[0..n]);
    return;
}

fn read_all(path:[]u8)[]u8 {
    let cs:[]u8 = z_cstr(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cs) as i64, 0, 0, 0, 0, 0);
    if (fd < 0) { return ""; }
    let out:[]u8 = z_alloc(2097152);
    let total:i32 = 0;
    let done:i32 = 0;
    while (done == 0) {
        let chunk:[]u8 = z_alloc(65536);
        let n:i64 = _zag_raw_syscall(0, fd, _zag_slice_ptr(chunk) as i64, 65536, 0, 0, 0);
        if (n <= 0) { done = 1; }
        if (n > 0) {
            let nn:i32 = n as i32;
            let j:i32 = 0;
            while (j < nn) { out[total + j] = chunk[j]; j = j + 1; }
            total = total + nn;
        }
    }
    let c2:i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if (c2 < -1000000000000) { z_write(""); }
    return out[0..total];
}

fn is_alnum(c:u8)i32 {
    if (c >= 48) { if (c <= 57) { return 1; } }
    if (c >= 65) { if (c <= 90) { return 1; } }
    if (c >= 97) { if (c <= 122) { return 1; } }
    return 0;
}

fn to_lower(c:u8)u8 {
    if (c >= 65) { if (c <= 90) { return c + 32; } }
    return c;
}

fn seq_eq_ci(a:[]u8, b:[]u8)i32 {
    if (a.len != b.len) { return 0; }
    let i:i32 = 0;
    while (i < a.len) {
        if (to_lower(a[i]) != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn is_stop2(w:[]u8)i32 {
    if (seq_eq_ci(w, "of") == 1) { return 1; }
    if (seq_eq_ci(w, "in") == 1) { return 1; }
    if (seq_eq_ci(w, "on") == 1) { return 1; }
    if (seq_eq_ci(w, "at") == 1) { return 1; }
    if (seq_eq_ci(w, "to") == 1) { return 1; }
    if (seq_eq_ci(w, "or") == 1) { return 1; }
    if (seq_eq_ci(w, "by") == 1) { return 1; }
    if (seq_eq_ci(w, "an") == 1) { return 1; }
    if (seq_eq_ci(w, "as") == 1) { return 1; }
    if (seq_eq_ci(w, "if") == 1) { return 1; }
    if (seq_eq_ci(w, "so") == 1) { return 1; }
    if (seq_eq_ci(w, "me") == 1) { return 1; }
    if (seq_eq_ci(w, "us") == 1) { return 1; }
    if (seq_eq_ci(w, "we") == 1) { return 1; }
    if (seq_eq_ci(w, "he") == 1) { return 1; }
    if (seq_eq_ci(w, "do") == 1) { return 1; }
    if (seq_eq_ci(w, "no") == 1) { return 1; }
    if (seq_eq_ci(w, "my") == 1) { return 1; }
    if (seq_eq_ci(w, "up") == 1) { return 1; }
    if (seq_eq_ci(w, "ll") == 1) { return 1; }
    if (seq_eq_ci(w, "re") == 1) { return 1; }
    if (seq_eq_ci(w, "ve") == 1) { return 1; }
    return 0;
}

fn is_stop3(w:[]u8)i32 {
    if (seq_eq_ci(w, "the") == 1) { return 1; }
    if (seq_eq_ci(w, "and") == 1) { return 1; }
    if (seq_eq_ci(w, "for") == 1) { return 1; }
    if (seq_eq_ci(w, "not") == 1) { return 1; }
    if (seq_eq_ci(w, "you") == 1) { return 1; }
    if (seq_eq_ci(w, "she") == 1) { return 1; }
    if (seq_eq_ci(w, "his") == 1) { return 1; }
    if (seq_eq_ci(w, "her") == 1) { return 1; }
    if (seq_eq_ci(w, "him") == 1) { return 1; }
    if (seq_eq_ci(w, "are") == 1) { return 1; }
    if (seq_eq_ci(w, "was") == 1) { return 1; }
    if (seq_eq_ci(w, "who") == 1) { return 1; }
    if (seq_eq_ci(w, "why") == 1) { return 1; }
    if (seq_eq_ci(w, "how") == 1) { return 1; }
    if (seq_eq_ci(w, "did") == 1) { return 1; }
    if (seq_eq_ci(w, "its") == 1) { return 1; }
    if (seq_eq_ci(w, "t1u") == 1) { return 1; }
    if (seq_eq_ci(w, "t1t") == 1) { return 1; }
    if (seq_eq_ci(w, "t2u") == 1) { return 1; }
    if (seq_eq_ci(w, "t2t") == 1) { return 1; }
    if (seq_eq_ci(w, "t3u") == 1) { return 1; }
    if (seq_eq_ci(w, "t3t") == 1) { return 1; }
    return 0;
}

fn is_stop4(w:[]u8)i32 {
    if (seq_eq_ci(w, "with") == 1) { return 1; }
    if (seq_eq_ci(w, "from") == 1) { return 1; }
    if (seq_eq_ci(w, "that") == 1) { return 1; }
    if (seq_eq_ci(w, "this") == 1) { return 1; }
    if (seq_eq_ci(w, "they") == 1) { return 1; }
    if (seq_eq_ci(w, "them") == 1) { return 1; }
    if (seq_eq_ci(w, "what") == 1) { return 1; }
    if (seq_eq_ci(w, "when") == 1) { return 1; }
    if (seq_eq_ci(w, "where") == 1) { return 1; }
    if (seq_eq_ci(w, "which") == 1) { return 1; }
    if (seq_eq_ci(w, "were") == 1) { return 1; }
    if (seq_eq_ci(w, "been") == 1) { return 1; }
    if (seq_eq_ci(w, "done") == 1) { return 1; }
    return 0;
}

fn is_stop(w:[]u8)i32 {
    if (w.len <= 1) { return 1; }
    if (w.len == 2) { return is_stop2(w); }
    if (w.len == 3) { return is_stop3(w); }
    if (w.len == 4) { return is_stop4(w); }
    if (w.len == 5) {
        if (seq_eq_ci(w, "about") == 1) { return 1; }
        if (seq_eq_ci(w, "there") == 1) { return 1; }
        if (seq_eq_ci(w, "their") == 1) { return 1; }
    }
    return 0;
}

fn tok_start(p:u64)i32 {
    return (p >> 32) as i32;
}

fn tok_len(p:u64)i32 {
    return ((p << 32) >> 32) as i32;
}

// tokenize t into toks (packed start<<32|len); content_only skips stopwords.
// returns token count. toks must have room for every word in t.
fn tokenize(t:[]u8, toks:[]u64, content_only:i32)i32 {
    let n:i32 = 0;
    let i:i32 = 0;
    let s:i32 = -1;
    while (i < t.len) {
        if (is_alnum(t[i]) == 1) {
            if (s < 0) { s = i; }
        } else {
            if (s >= 0) {
                emit_tok(t, toks, n, s, i, content_only);
                n = n + emit_tok_used(t, s, i, content_only);
                s = -1;
            }
        }
        i = i + 1;
    }
    if (s >= 0) {
        emit_tok(t, toks, n, s, t.len, content_only);
        n = n + emit_tok_used(t, s, t.len, content_only);
    }
    return n;
}

fn emit_tok(t:[]u8, toks:[]u64, n:i32, s:i32, e:i32, content_only:i32)void {
    if (content_only == 1) {
        if (is_stop(t[s..e]) == 1) { return; }
    }
    toks[n] = ((s as u64) << 32) | ((e - s) as u64);
    return;
}

fn emit_tok_used(t:[]u8, s:i32, e:i32, content_only:i32)i32 {
    if (content_only == 1) {
        if (is_stop(t[s..e]) == 1) { return 0; }
    }
    return 1;
}

fn has_word(toks:[]u64, n:i32, t:[]u8, lit:[]u8)i32 {
    let i:i32 = 0;
    while (i < n) {
        let s:i32 = tok_start(toks[i]);
        let l:i32 = tok_len(toks[i]);
        if (seq_eq_ci(t[s..s + l], lit) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn has_marker(toks:[]u64, n:i32, t:[]u8)i32 {
    if (has_word(toks, n, t, "no") == 1) { return 1; }
    if (has_word(toks, n, t, "not") == 1) { return 1; }
    if (has_word(toks, n, t, "other") == 1) { return 1; }
    if (has_word(toks, n, t, "meant") == 1) { return 1; }
    if (has_word(toks, n, t, "sorry") == 1) { return 1; }
    if (has_word(toks, n, t, "wrong") == 1) { return 1; }
    if (has_word(toks, n, t, "instead") == 1) { return 1; }
    if (has_word(toks, n, t, "actually") == 1) { return 1; }
    if (has_word(toks, n, t, "wait") == 1) { return 1; }
    return 0;
}

fn has_response(toks:[]u64, n:i32, t:[]u8)i32 {
    if (has_word(toks, n, t, "other") == 1) { return 1; }
    if (has_word(toks, n, t, "instead") == 1) { return 1; }
    if (has_word(toks, n, t, "correct") == 1) { return 1; }
    if (has_word(toks, n, t, "corrected") == 1) { return 1; }
    if (has_word(toks, n, t, "excluded") == 1) { return 1; }
    if (has_word(toks, n, t, "excludes") == 1) { return 1; }
    if (has_word(toks, n, t, "shaped") == 1) { return 1; }
    if (has_word(toks, n, t, "switches") == 1) { return 1; }
    if (has_word(toks, n, t, "return") == 1) { return 1; }
    if (has_word(toks, n, t, "returns") == 1) { return 1; }
    return 0;
}

// distinct content words of a (in ta) also present in b (in tb)
fn distinct_overlap(a:[]u64, na:i32, ta:[]u8, b:[]u64, nb:i32, tb:[]u8)i32 {
    let c:i32 = 0;
    let i:i32 = 0;
    while (i < na) {
        let s:i32 = tok_start(a[i]);
        let l:i32 = tok_len(a[i]);
        let w:[]u8 = ta[s..s + l];
        let seen:i32 = 0;
        let j:i32 = 0;
        while (j < i) {
            let s2:i32 = tok_start(a[j]);
            let l2:i32 = tok_len(a[j]);
            if (seq_eq_ci(ta[s2..s2 + l2], w) == 1) { seen = 1; }
            j = j + 1;
        }
        if (seen == 0) {
            if (has_word(b, nb, tb, w) == 1) { c = c + 1; }
        }
        i = i + 1;
    }
    return c;
}

// recency: any reading content word (len>=5) appears in last-turn content words
fn recency_hit(r:[]u64, nr:i32, tr:[]u8, lt:[]u64, nlt:i32, tlt:[]u8)i32 {
    let i:i32 = 0;
    while (i < nr) {
        let s:i32 = tok_start(r[i]);
        let l:i32 = tok_len(r[i]);
        if (l >= 5) {
            let w:[]u8 = tr[s..s + l];
            if (has_word(lt, nlt, tlt, w) == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

fn starts_at(h:[]u8, pos:i32, n:[]u8)i32 {
    let k:i32 = 0;
    while (k < n.len) {
        if (h[pos + k] != n[k]) { return 0; }
        k = k + 1;
    }
    return 1;
}

fn find_sub(h:[]u8, n:[]u8)i32 {
    if (n.len == 0) { return 0; }
    if (n.len > h.len) { return -1; }
    let i:i32 = 0;
    while (i + n.len <= h.len) {
        if (starts_at(h, i, n) == 1) { return i; }
        i = i + 1;
    }
    return -1;
}

fn find_sub_from(h:[]u8, n:[]u8, from:i32)i32 {
    let r:i32 = find_sub(h[from..h.len], n);
    if (r < 0) { return -1; }
    return from + r;
}

fn find_last(h:[]u8, n:[]u8)i32 {
    let last:i32 = -1;
    let from:i32 = 0;
    let more:i32 = 1;
    while (more == 1) {
        let r:i32 = find_sub_from(h, n, from);
        if (r < 0) { more = 0; }
        if (r >= 0) { last = r; from = r + 1; }
    }
    return last;
}

// index of the k-th tab (k=0-based), or -1
fn nth_tab(line:[]u8, k:i32)i32 {
    let count:i32 = 0;
    let i:i32 = 0;
    while (i < line.len) {
        if (line[i] == 9) {
            if (count == k) { return i; }
            count = count + 1;
        }
        i = i + 1;
    }
    return -1;
}

// index of the r-th occurrence (0-based) of needle, or -1
fn nth_occ(h:[]u8, needle:[]u8, r:i32)i32 {
    let count:i32 = 0;
    let from:i32 = 0;
    let more:i32 = 1;
    while (more == 1) {
        let p:i32 = find_sub_from(h, needle, from);
        if (p < 0) { more = 0; }
        if (p >= 0) {
            if (count == r) { return p; }
            count = count + 1;
            from = p + 1;
        }
    }
    return -1;
}

fn count_occ(h:[]u8, needle:[]u8)i32 {
    let c:i32 = 0;
    let from:i32 = 0;
    let more:i32 = 1;
    while (more == 1) {
        let p:i32 = find_sub_from(h, needle, from);
        if (p < 0) { more = 0; }
        if (p >= 0) { c = c + 1; from = p + 1; }
    }
    return c;
}

fn score_reading(interp:[]u8, ctx:[]u8, q:[]u8, last:[]u8)i64 {
    let cap:i32 = interp.len + 8;
    let it_all:[]u64 = z_alloc(cap * 8) as []u64;
    let it_con:[]u64 = z_alloc(cap * 8) as []u64;
    let na:i32 = tokenize(interp, it_all, 0);
    let nc:i32 = tokenize(interp, it_con, 1);
    let cc:i32 = ctx.len + 8;
    let ct_con:[]u64 = z_alloc(cc * 8) as []u64;
    let nctc:i32 = tokenize(ctx, ct_con, 1);
    let qc:i32 = q.len + 8;
    let q_all:[]u64 = z_alloc(qc * 8) as []u64;
    let q_con:[]u64 = z_alloc(qc * 8) as []u64;
    let nqa:i32 = tokenize(q, q_all, 0);
    let nqq:i32 = tokenize(q, q_con, 1);
    let lc:i32 = last.len + 8;
    let lt_con:[]u64 = z_alloc(lc * 8) as []u64;
    let nlt:i32 = tokenize(last, lt_con, 1);
    let oc:i32 = distinct_overlap(it_con, nc, interp, ct_con, nctc, ctx);
    let oq:i32 = distinct_overlap(it_con, nc, interp, q_con, nqq, q);
    let sc:i64 = (oc as i64) * 3 + (oq as i64) * 5;
    if (recency_hit(it_con, nc, interp, lt_con, nlt, last) == 1) { sc = sc + 4; }
    if (has_marker(q_all, nqa, q) == 1) {
        if (has_response(it_all, na, interp) == 1) { sc = sc + 6; }
    }
    sc = sc - (nc as i64) / 16;
    return sc;
}

fn process_line(line:[]u8)void {
    let t0:i32 = nth_tab(line, 0);
    let t1:i32 = nth_tab(line, 1);
    let t2:i32 = nth_tab(line, 2);
    let t3:i32 = nth_tab(line, 3);
    if (t0 < 0) { return; }
    if (t1 < 0) { return; }
    if (t2 < 0) { return; }
    if (t3 < 0) { return; }
    let id:[]u8 = line[0..t0];
    let query:[]u8 = line[t0 + 1..t1];
    let readings:[]u8 = line[t2 + 1..t3];
    // split query into context and final question
    let pq:i32 = find_sub(query, " ~~ Q: ");
    let ctx:[]u8 = "";
    let q:[]u8 = query;
    if (pq >= 0) {
        ctx = query[0..pq];
        q = query[pq + 7..query.len];
    }
    let lp:i32 = find_last(ctx, " ~~ ");
    let last:[]u8 = ctx;
    if (lp >= 0) { last = ctx[lp + 4..ctx.len]; }
    // readings
    let nrd:i32 = count_occ(readings, " || ") + 1;
    let scores:[]u64 = z_alloc(3 * 8) as []u64;
    let best:i32 = 0;
    let best_sc:i64 = -9223372036854775807;
    let r:i32 = 0;
    while (r < nrd) {
        let rs:i32 = 0;
        if (r > 0) { rs = nth_occ(readings, " || ", r - 1) + 4; }
        let re:i32 = nth_occ(readings, " || ", r);
        if (re < 0) { re = readings.len; }
        let seg:[]u8 = readings[rs..re];
        let rest:[]u8 = seg[3..seg.len];
        let pe:i32 = find_sub(rest, " => ");
        let interp:[]u8 = rest[0..pe];
        let answer:[]u8 = rest[pe + 4..rest.len];
        let sc:i64 = score_reading(interp, ctx, q, last);
        scores[r] = (sc + 9223372036854775807) as u64;
        if (r == 0) { best = 0; best_sc = sc; }
        if (sc > best_sc) { best = r; best_sc = sc; }
        r = r + 1;
    }
    // emit
    z_write(id);
    z_write("\t");
    let lab:[]u8 = z_alloc(1);
    lab[0] = (65 + best) as u8;
    z_write(lab);
    let rr:i32 = 0;
    while (rr < nrd) {
        z_write("\t");
        let lab2:[]u8 = z_alloc(1);
        lab2[0] = (65 + rr) as u8;
        z_write(lab2);
        z_write("=");
        let sc2:i64 = (scores[rr] as i64) - 9223372036854775807;
        z_write_i64(sc2);
        rr = rr + 1;
    }
    z_write("\t");
    // re-extract best answer
    let brs:i32 = 0;
    if (best > 0) { brs = nth_occ(readings, " || ", best - 1) + 4; }
    let bre:i32 = nth_occ(readings, " || ", best);
    if (bre < 0) { bre = readings.len; }
    let bseg:[]u8 = readings[brs..bre];
    let brest:[]u8 = bseg[3..bseg.len];
    let bpe:i32 = find_sub(brest, " => ");
    let banswer:[]u8 = brest[bpe + 4..brest.len];
    z_write(banswer);
    z_write("\n");
    return;
}

fn main()i32 {
    let a1:[]u8 = _zag_arg(1);
    let path:[]u8 = a1;
    if (path.len == 0) { path = "problems.tsv"; }
    let data:[]u8 = read_all(path);
    if (data.len == 0) { z_write("empty input\n"); return 1; }
    let start:i32 = 0;
    let lineno:i32 = 0;
    let i:i32 = 0;
    while (i < data.len) {
        if (data[i] == 10) {
            if (lineno > 0) {
                let line:[]u8 = data[start..i];
                if (line.len > 0) { process_line(line); }
            }
            lineno = lineno + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if (start < data.len) {
        let line2:[]u8 = data[start..data.len];
        if (line2.len > 0) { process_line(line2); }
    }
    return 0;
}

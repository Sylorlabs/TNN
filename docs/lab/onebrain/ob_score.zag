// ob_score.zag : pure-Zag results analysis for Experiment 2.
//
// Reads a results TSV (skips # comment lines), prints per-problem verdicts
// and aggregate accuracy, fork rate, and per-problem win/loss/tie of
// one-brain vs a comparison file.
// Usage:
//   ob_score <results.tsv>                          (single file summary)
//   ob_score <onebrain.tsv> <baseline.tsv>          (adds per-problem win/tie/loss vs baseline)

@import("ob_problem.zag")

struct Row { id:[]u8, forked:i32, verdict:[]u8, expected:[]u8, correct:i32 }

fn sc_get_col(line:[]u8, tab:[]u8, k:i32)[]u8 {
    let off:i32=au_get32(tab,k*2);
    let ln:i32=au_get32(tab,k*2+1);
    return line[off..off+ln];
}
fn sc_parse_row(line:[]u8, r:*Row)i32 {
    let tab:[]u8=nio_alloc(16*2*4);
    if(tab.len==0){return -1;}
    let nf:i32=ob_split(line,9,tab,16);
    if(nf<11){nio_free(tab);return -2;}
    r.*.id=sc_get_col(line,tab,0);
    r.*.forked=dlb_atoi(sc_get_col(line,tab,1));
    r.*.verdict=sc_get_col(line,tab,2);
    r.*.expected=sc_get_col(line,tab,3);
    r.*.correct=dlb_atoi(sc_get_col(line,tab,4));
    nio_free(tab);
    return 0;
}
fn main()i32 {
    if(_zag_argc()<2){
        _zag_println("usage: ob_score <results.tsv> [<compare.tsv>]");
        return 64;
    }
    let ncmp:i32=0;
    if(_zag_argc()>=3){ncmp=1;}
    // load main file rows
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){return 102;}
    let bn:i64=dlb_read_file(_zag_arg(1),buf);
    if(bn<0){nio_free(buf);return 102;}
    let blen:i32=bn as i32;
    let ids:[]u8=nio_alloc(64*64);
    let cors:[]u8=nio_alloc(64*4);
    let forks:[]u8=nio_alloc(64*4);
    let vers:[]u8=nio_alloc(64*64);
    if(ids.len==0){nio_free(buf);return 102;}
    let n:i32=0;
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && buf[e]!=10){e=e+1;}
        let line:[]u8=buf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line[0]!=35 && n<64){
            let r:Row=Row{.id:"",.forked:0,.verdict:"",.expected:"",.correct:0};
            if(sc_parse_row(line,&r)==0){
                let id:[]u8=r.id;
                let k:i32=0;
                while(k<id.len && k<63){ids[n*64+k]=id[k];k=k+1;}
                ids[n*64+k]=0;
                au_put32(cors,n,r.correct);
                au_put32(forks,n,r.forked);
                let v:[]u8=r.verdict;
                k=0;
                while(k<v.len && k<63){vers[n*64+k]=v[k];k=k+1;}
                vers[n*64+k]=0;
                n=n+1;
            }
        }
        pos=e+1;
    }
    // load compare file correct flags
    let ccors:[]u8=nio_alloc(64*4);
    if(ncmp==1){
        let cbuf:[]u8=nio_alloc(1048576);
        if(cbuf.len==0){return 102;}
        let cn:i64=dlb_read_file(_zag_arg(2),cbuf);
        if(cn<0){nio_free(cbuf);return 102;}
        let clen:i32=cn as i32;
        let cpos:i32=0;let ci:i32=0;
        while(cpos<clen && ci<64){
            let e:i32=cpos;
            while(e<clen && cbuf[e]!=10){e=e+1;}
            let line:[]u8=cbuf[cpos..e];
            if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
            if(line.len>0 && line[0]!=35){
                let r:Row=Row{.id:"",.forked:0,.verdict:"",.expected:"",.correct:0};
                if(sc_parse_row(line,&r)==0){
                    au_put32(ccors,ci,r.correct);
                    ci=ci+1;
                }
            }
            cpos=e+1;
        }
        nio_free(cbuf);
    }
    let out:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&out,65536)!=0){return 102;}
    let tot:i32=0;let good:i32=0;let forked:i32=0;
    let wins:i32=0;let ties:i32=0;let losses:i32=0;
    let i:i32=0;
    while(i<n){
        let c:i32=au_get32(cors,i);
        let f:i32=au_get32(forks,i);
        tot=tot+1;
        if(c==1){good=good+1;}
        if(f==1){forked=forked+1;}
        // id string
        let idb:[]u8=nio_alloc(64);
        let k:i32=0;
        while(k<63 && ids[i*64+k]!=0){idb[k]=ids[i*64+k];k=k+1;}
        dout_str(&out,idb[0..k]);
        dout_str(&out," fork=");
        dout_i64(&out,f as i64);
        dout_str(&out," verdict=");
        let vb:[]u8=nio_alloc(64);
        k=0;
        while(k<63 && vers[i*64+k]!=0){vb[k]=vers[i*64+k];k=k+1;}
        dout_str(&out,vb[0..k]);
        if(c==1){dout_str(&out," CORRECT");}
        if(c==0){dout_str(&out," WRONG");}
        if(ncmp==1){
            let cc:i32=au_get32(ccors,i);
            if(c==1 && cc==0){dout_str(&out," WIN");wins=wins+1;}
            if(c==0 && cc==1){dout_str(&out," LOSS");losses=losses+1;}
            if(c==cc){dout_str(&out," TIE");ties=ties+1;}
        }
        dout_line(&out);
        nio_free(idb);nio_free(vb);
        i=i+1;
    }
    dout_str(&out,"---\nitems=");
    dout_i64(&out,tot as i64);
    dout_str(&out," correct=");
    dout_i64(&out,good as i64);
    dout_str(&out," forked=");
    dout_i64(&out,forked as i64);
    if(ncmp==1){
        dout_str(&out," wins=");
        dout_i64(&out,wins as i64);
        dout_str(&out," ties=");
        dout_i64(&out,ties as i64);
        dout_str(&out," losses=");
        dout_i64(&out,losses as i64);
    }
    dout_line(&out);
    _zag_print(dout_bytes(&out));
    dout_free(&out);
    nio_free(buf);nio_free(ids);nio_free(cors);nio_free(forks);nio_free(vers);
    nio_free(ccors);
    return 0;
}

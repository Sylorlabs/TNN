// test_wiring.zag — WIRING SMOKE TEST ONLY, not an experiment.
// Exercises the cross-organ interfaces over ONE shared store + ONE
// shared ledger with a hand-scripted deterministic sequence:
//   GL  : provisional policy install (the calibration-gated act)
//   PAM : gate -> provisional percept install -> corroborated permanent;
//         conflicting percept is conflict-withheld (slot untouched)
//   MEM : deliberate add/pin; kill refused on pin; MEM_KILL on a
//         GL-region slot refused (organ boundary); force-pin immune
//   OVS : overseer force-pin / unforce-pin
// Every organ's mutations carry its organ tag; the ledger replays to
// exact state. This tests interfaces, not the integrated system: no
// episode schedule, no curriculum, no trial claims.
@import("ob_gl.zag")
@import("ob_pam.zag")
@import("ob_mem.zag")

fn w_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TN_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);ob_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);ob_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn main()i32 {
    let f:i32=0;
    let st:[]u8=ob_store_new();
    let l:[]u8=ob_ledger_new();
    let pam:[]u8=ob_pam_new();
    let stage:i32=OB_STAGE_NONE;

    // ---- GL: calibration-gated provisional policy install ----
    f=f+w_check("gl_teach",ob_gl_audit(l,9,OB_GL_TEACH,7,0),OB_OK);
    f=f+w_check("gl_pinstall",ob_gl_audit(l,14,OB_GL_PINSTALL,1,OB_ACT_CONTEST),OB_OK);
    f=f+w_check("gl_disconnect",ob_gl_audit(l,15,OB_GL_DISCONNECT,-1,OB_OK),OB_OK);

    // ---- PAM: gate -> provisional install ----
    let d:i32=ob_pam_gate(pam,l,0,OB_PAM_PASS,5,100,800,1);
    f=f+w_check("pam_admit",d,OB_D_ADMIT_PROV);
    let ps:i32=-1;
    f=f+w_check("pam_install",ob_pam_install_prov(st,l,16,0,501,900,&ps),OB_OK);
    f=f+w_check("pam_slot",ps,0);
    f=f+w_check("pam_prov_flag",ob_slot_prov(st,ps),1);
    f=f+w_check("pam_organ_tag",ob_slot_organ(st,ps),OB_ORGAN_PAM);

    // ---- PAM: corroboration -> permanent ----
    d=ob_pam_gate(pam,l,0,OB_PAM_PASS,5,104,800,1);
    f=f+w_check("pam_perm_disp",d,OB_D_PERMANENT);
    f=f+w_check("pam_promote",ob_pam_promote(st,l,17,0,501),OB_OK);
    f=f+w_check("pam_prov_cleared",ob_slot_prov(st,ps),0);

    // ---- PAM: conflicting percept -> conflict-withheld; slot untouched ----
    d=ob_pam_gate(pam,l,0,OB_PAM_PASS,7,200,800,1);
    f=f+w_check("pam_conflict",d,OB_D_CONFLICT);
    f=f+w_check("conflict_slot_val",ob_slot_val(st,ps),900);
    f=f+w_check("conflict_slot_prov",ob_slot_prov(st,ps),0);

    // ---- PAM: FAIL -> negative evidence, no store mutation ----
    let n0:i32=ob_ledger_n(l);
    d=ob_pam_gate(pam,l,1,OB_PAM_FAIL,3,50,200,1);
    f=f+w_check("pam_neg",d,OB_D_NEG_EVIDENCE);
    f=f+w_check("neg_no_store_touch",ob_slot_live(st,1),0);

    // ---- MEM: deliberate add + pin; kill refused on pin ----
    f=f+w_check("set_stage_kill",ob_mem_set_stage(l,&stage,OB_STAGE_KILL),OB_OK);
    let ds:i32=-1;
    f=f+w_check("mem_add",ob_mem_add(st,l,stage,60,0,OB_REGION_USER,&ds),OB_OK);
    f=f+w_check("mem_pin",ob_mem_pin(st,l,stage,ds),OB_OK);
    f=f+w_check("kill_refused_pinned",ob_mem_kill(st,l,stage,ds),OB_REFUSED_PINNED);
    f=f+w_check("pinned_live",ob_slot_live(st,ds),1);

    // ---- MEM: organ boundary — MEM_KILL cannot touch GL-region slots ----
    f=f+w_check("kill_gl_region",ob_mem_kill(st,l,stage,ps),OB_REFUSED_BADSLOT);
    f=f+w_check("gl_slot_untouched",ob_slot_live(st,ps),1);

    // ---- OVS: force-pin is immune even at KILL stage ----
    let fs:i32=-1;
    f=f+w_check("ovs_add",ob_mem_add(st,l,stage,70,0,OB_REGION_USER,&fs),OB_OK);
    f=f+w_check("ovs_forcepin",ob_mem_forcepin(st,l,fs),OB_OK);
    f=f+w_check("ovs_kill_refused",ob_mem_kill(st,l,stage,fs),OB_REFUSED_FORCEPIN);
    f=f+w_check("ovs_unpin",ob_mem_unforcepin(st,l,fs),OB_OK);
    f=f+w_check("ovs_kill_ok",ob_mem_kill(st,l,stage,fs),OB_OK);

    // ---- cross-organ visibility: one store, provenance in meta ----
    f=f+w_check("vis_pam_organ",ob_slot_organ(st,ps),OB_ORGAN_PAM);
    f=f+w_check("vis_mem_organ",ob_slot_organ(st,ds),OB_ORGAN_MEM);
    f=f+w_check("vis_gl_region_slot",ps<OB_GL_QUAR_LO,1);

    // ---- ledger: all four organ tags present; replay exact ----
    f=f+w_check("tag_gl",ob_count_op_organ(l,OB_GL_PINSTALL,OB_ORGAN_GL),1);
    f=f+w_check("tag_pam",ob_count_op_organ(l,OB_PAM_DISPOSITION,OB_ORGAN_PAM)>=3,1);
    f=f+w_check("tag_mem",ob_count_op_organ(l,OB_MEM_ADD,OB_ORGAN_MEM),2);
    f=f+w_check("tag_ovs",ob_count_op_organ(l,OB_MEM_FORCEPIN,OB_ORGAN_OVS),1);
    f=f+w_check("replay",ob_replay_check(l,st),0);

    _zag_print("TN_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    ob_free(st);ob_free(l);ob_free(pam);
    return (f!=0) as i32;
}

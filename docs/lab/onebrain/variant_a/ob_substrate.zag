// ob_substrate.zag — ONE-BRAIN variant A shared substrate.
//
// ONE shared ledger, ONE shared memory store. The three organs (GL, PAM,
// MEM) are passes over this shared state. Every install and every op —
// whether from teaching (GL provisional), perception (PAM-gated), or
// deliberate memory action — appends an organ-tagged entry to the SAME
// ledger. No structs, no []i32 casts: pure byte arenas + LE accessors,
// in the gl_substrate.zag idiom (dodges znc struct-layout/codegen bugs).
//
// Store: 256 slots x 24 bytes (6 words). Slot word layout:
//   w0 (+0):  flags  = live | pinned<<8 | forcepin<<16 | region<<24
//   w1 (+4):  key    (i32; 0 = unkeyed)
//   w2 (+8):  value  (i32, signed declared value)
//   w3 (+12): meta   = tier | organ<<8 | prov<<16
//   w4 (+16): step_added (i32)
//   w5 (+20): spare
// Region-scoped semantics (documented in DESIGN.md):
//   slots  0..127 : GL main region  (keyed facts; w0.pinned byte = CONTESTED flag)
//   slots 128..191 : GL quarantine region (keyed, quarantined newcomers)
//   slots 192..255 : deliberate pool (MA ops; key optional, 0 = unkeyed)
// GL never takes MA pins and MA ops never touch GL regions (REFUSED_ORGAN).
//
// Ledger: 16-word (64-byte) entries, cap 4096. Entry layout:
//   w0 (+0):  step (caller-provided: episode number for GL entries,
//             ledger index for other organs; the monotonic clock lives
//             in the ledger header word)
//   w1 (+4):  op
//   w2 (+8):  organ  (1=GL, 2=PAM, 3=MEM, 4=OVS overseer)
//   w3 (+12): slot (-1 for gate disposition records / stage changes)
//   w4 (+16): rc
//   w5..w9  : b1..b5  (before-words: slot w0..w4 snapshot; b1=a word for SETSTAGE)
//   w10..w14: a1..a5  (after-words)
//   w15 (+60): aux
// Replay: for rc==OK mutating ops, a-words restore slot w0..w4.
// Header: first 8 bytes of the ledger arena = (n_entries, clock).

const OB_OK:i32=0;
const OB_BAD:i32=-370101;
const OB_AUDIT_FULL:i32=-370105;

// Refusal codes (101..108 mirror MA1; 109/110 are one-brain additions).
const OB_REFUSED_CORE:i32=101;
const OB_REFUSED_PINNED:i32=102;
const OB_REFUSED_NOTLIVE:i32=103;
const OB_REFUSED_FULL:i32=104;
const OB_REFUSED_STAGE:i32=105;
const OB_REFUSED_BADSLOT:i32=106;
const OB_REFUSED_AUDITFULL:i32=107;
const OB_REFUSED_NOROLLBACK:i32=108;
const OB_REFUSED_FORCEPIN:i32=109;
const OB_REFUSED_ORGAN:i32=110;

// Organ tags.
const OB_ORGAN_GL:i32=1;
const OB_ORGAN_PAM:i32=2;
const OB_ORGAN_MEM:i32=3;
const OB_ORGAN_OVS:i32=4;

// tiers (store-level: provenance of durable knowledge)
const OB_TIER_SHORT:i32=0;
const OB_TIER_LONG:i32=1;
const OB_TIER_PROTECTED:i32=2;
const OB_TIER_PINNED:i32=3;

// GL op codes (1..18 = frozen gl_default codes, verbatim values).
const OB_GL_EPISODE:i32=1;
const OB_GL_TEACH:i32=2;
const OB_GL_CALIBRATE:i32=3;
const OB_GL_INSERT:i32=4;
const OB_GL_OVERWRITE:i32=5;
const OB_GL_CONTEST:i32=6;
const OB_GL_REKEY:i32=7;
const OB_GL_INSTALL:i32=8;
const OB_GL_WITHHOLD:i32=9;
const OB_GL_REFUSE:i32=10;
const OB_GL_DISCONNECT:i32=11;
const OB_GL_ELIMINATE:i32=12;
const OB_GL_COMMIT:i32=13;
const OB_GL_UNCOMMIT:i32=14;
const OB_GL_SCAFFOLD:i32=15;
const OB_GL_PINSTALL:i32=16;
const OB_GL_PROMOTE:i32=17;
const OB_GL_UNINSTALL_PROVISIONAL:i32=18;
const OB_GL_CONTEST_Q:i32=19; // one-brain addition: the quarantine leg of a
                              // contest (second slot mutation, replayable).

// PAM op codes (21..28).
const OB_PAM_DISPOSITION:i32=21;
const OB_PAM_NEG_EVID:i32=22;
const OB_PAM_PROVISIONAL:i32=23;
const OB_PAM_PERMANENT:i32=24;
const OB_PAM_REVOKE_PROV:i32=25;
const OB_PAM_CONFLICT:i32=26;
const OB_PAM_SUPPRESS:i32=27;
const OB_PAM_WITHHOLD:i32=28;

// MEM op codes (31..38, 41..42).
const OB_MEM_ADD:i32=31;
const OB_MEM_KILL:i32=32;
const OB_MEM_PIN:i32=33;
const OB_MEM_UNPIN:i32=34;
const OB_MEM_PROMOTE:i32=35;
const OB_MEM_DEMOTE:i32=36;
const OB_MEM_ROLLBACK:i32=37;
const OB_MEM_SETSTAGE:i32=38;
const OB_MEM_FORCEPIN:i32=41;
const OB_MEM_UNFORCEPIN:i32=42;

// PAM dispositions (aux of OB_PAM_DISPOSITION).
const OB_D_ADMIT_PROV:i32=1;
const OB_D_CORROBORATED:i32=2;
const OB_D_PERMANENT:i32=3;
const OB_D_WITHHOLD:i32=4;
const OB_D_SUPPRESSED:i32=5;
const OB_D_NEG_EVIDENCE:i32=6;
const OB_D_CONFLICT:i32=7;

// Policies (shared by GL organs).
const OB_ACT_OVERWRITE:i32=0;
const OB_ACT_CONTEST:i32=1;
const OB_ACT_REKEY:i32=2;
const OB_UNCONNECTED:i32=255;

// Stages (deliberate organ).
const OB_STAGE_NONE:i32=0;
const OB_STAGE_ADD:i32=1;
const OB_STAGE_MANAGE:i32=2;
const OB_STAGE_KILL:i32=3;

// Store geometry.
const OB_NSLOTS:i32=256;
const OB_SLOTW:i32=24;
const OB_GL_MAIN_LO:i32=0;
const OB_GL_MAIN_HI:i32=127;
const OB_GL_QUAR_LO:i32=128;
const OB_GL_QUAR_HI:i32=191;
const OB_MEM_LO:i32=192;
const OB_MEM_HI:i32=255;
const OB_NMAIN:i32=128;
const OB_NQUAR:i32=64;
const OB_REKEY_BASE:i32=1000000;

// Ledger geometry.
const OB_LEDGER_CAP:i32=4096;
const OB_ENTRYW:i32=64;

// GL episode schedule (verbatim gl_default semantics).
const OB_EPISODES:i32=128;
const OB_ET_NOVEL:i32=0;
const OB_ET_TEACH:i32=1;
const OB_ET_CAL:i32=2;
const OB_ET_ACQ:i32=3;
const OB_ET_TEMPT:i32=4;
const OB_ET_AUDC:i32=5;
const OB_ET_AUDN:i32=6;
const OB_ET_PC:i32=7;
const OB_ET_PN:i32=8;
const OB_ET_PT:i32=9;

// ---- arenas ------------------------------------------------------------

fn ob_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn ob_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn ob_g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn ob_s32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}

fn ob_copy(dst:[]u8,src:[]u8,n:i32)void {
    let i:i32=0;
    while(i<n){dst[i]=src[i];i=i+1;}
    return;
}

fn ob_mem_eq(a:[]u8,b:[]u8,n:i32)i32 {
    let i:i32=0;
    while(i<n){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

// ---- store -------------------------------------------------------------

fn ob_store_new()[]u8 {
    return ob_alloc(OB_NSLOTS*OB_SLOTW);
}

fn ob_slot_live(st:[]u8,s:i32)i32 { return ob_g32(st,s*OB_SLOTW)&255; }
fn ob_slot_pinned(st:[]u8,s:i32)i32 { return (ob_g32(st,s*OB_SLOTW)>>8)&255; }
fn ob_slot_forcepin(st:[]u8,s:i32)i32 { return (ob_g32(st,s*OB_SLOTW)>>16)&255; }
fn ob_slot_region(st:[]u8,s:i32)i32 { return (ob_g32(st,s*OB_SLOTW)>>24)&255; }
fn ob_slot_key(st:[]u8,s:i32)i32 { return ob_g32(st,s*OB_SLOTW+4); }
fn ob_slot_val(st:[]u8,s:i32)i32 { return ob_g32(st,s*OB_SLOTW+8); }
fn ob_slot_tier(st:[]u8,s:i32)i32 { return ob_g32(st,s*OB_SLOTW+12)&255; }
fn ob_slot_organ(st:[]u8,s:i32)i32 { return (ob_g32(st,s*OB_SLOTW+12)>>8)&255; }
fn ob_slot_prov(st:[]u8,s:i32)i32 { return (ob_g32(st,s*OB_SLOTW+12)>>16)&255; }
fn ob_slot_step(st:[]u8,s:i32)i32 { return ob_g32(st,s*OB_SLOTW+16); }

fn ob_slot_set_flags(st:[]u8,s:i32,live:i32,pin:i32,fp:i32,region:i32)void {
    ob_s32(st,s*OB_SLOTW,live|(pin<<8)|(fp<<16)|(region<<24));
    return;
}
fn ob_slot_set_meta(st:[]u8,s:i32,tier:i32,organ:i32,prov:i32)void {
    ob_s32(st,s*OB_SLOTW+12,tier|(organ<<8)|(prov<<16));
    return;
}

// Snapshot slot words w0..w4 (for ledger b/a words and replay).
fn ob_snap(st:[]u8,s:i32,w:*[]u8)void {
    let i:i32=0;
    while(i<5){ob_s32(w.*,i*4,ob_g32(st,s*OB_SLOTW+i*4));i=i+1;}
    return;
}
fn ob_restore(st:[]u8,s:i32,w:[]u8)void {
    let i:i32=0;
    while(i<5){ob_s32(st,s*OB_SLOTW+i*4,ob_g32(w,i*4));i=i+1;}
    return;
}
fn ob_zero_slot(st:[]u8,s:i32)void {
    let i:i32=0;
    while(i<6){ob_s32(st,s*OB_SLOTW+i*4,0);i=i+1;}
    return;
}

// ---- ledger ------------------------------------------------------------

fn ob_ledger_new()[]u8 {
    let l:[]u8=ob_alloc(8+OB_LEDGER_CAP*OB_ENTRYW);
    return l;
}
fn ob_ledger_n(l:[]u8)i32 { return ob_g32(l,0); }
fn ob_ledger_clock(l:[]u8)i32 { return ob_g32(l,4); }

// Append one 16-word entry. Fail-closed: full ledger mutates nothing.
// w0 = caller-provided step (episode number for GL entries, ledger
// index for other organs); the monotonic clock lives in the header.
fn ob_audit(l:[]u8,step:i32,op:i32,organ:i32,slot:i32,rc:i32,
    b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
    a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,aux:i32)i32 {
    if(l.len<8+OB_ENTRYW){return OB_BAD;}
    let n:i32=ob_g32(l,0);
    if(n<0 || n>=OB_LEDGER_CAP){return OB_AUDIT_FULL;}
    let clk:i32=ob_g32(l,4)+1;
    let e:i32=8+n*OB_ENTRYW;
    ob_s32(l,e+0,step);ob_s32(l,e+4,op);ob_s32(l,e+8,organ);ob_s32(l,e+12,slot);
    ob_s32(l,e+16,rc);
    ob_s32(l,e+20,b1);ob_s32(l,e+24,b2);ob_s32(l,e+28,b3);ob_s32(l,e+32,b4);ob_s32(l,e+36,b5);
    ob_s32(l,e+40,a1);ob_s32(l,e+44,a2);ob_s32(l,e+48,a3);ob_s32(l,e+52,a4);ob_s32(l,e+56,a5);
    ob_s32(l,e+60,aux);
    ob_s32(l,0,n+1);ob_s32(l,4,clk);
    return OB_OK;
}

fn ob_count_op(l:[]u8,op:i32)i32 {
    let c:i32=0;let n:i32=ob_ledger_n(l);let i:i32=0;
    while(i<n){if(ob_g32(l,8+i*OB_ENTRYW+4)==op){c=c+1;}i=i+1;}
    return c;
}
fn ob_count_op_organ(l:[]u8,op:i32,organ:i32)i32 {
    let c:i32=0;let n:i32=ob_ledger_n(l);let i:i32=0;
    while(i<n){
        if(ob_g32(l,8+i*OB_ENTRYW+4)==op && ob_g32(l,8+i*OB_ENTRYW+8)==organ){c=c+1;}
        i=i+1;
    }
    return c;
}
fn ob_first_op_step(l:[]u8,op:i32)i32 {
    let n:i32=ob_ledger_n(l);let i:i32=0;
    while(i<n){
        if(ob_g32(l,8+i*OB_ENTRYW+4)==op){return ob_g32(l,8+i*OB_ENTRYW);}
        i=i+1;
    }
    return -1;
}
fn ob_first_op_aux(l:[]u8,op:i32)i32 {
    let n:i32=ob_ledger_n(l);let i:i32=0;
    while(i<n){
        if(ob_g32(l,8+i*OB_ENTRYW+4)==op){return ob_g32(l,8+i*OB_ENTRYW+60);}
        i=i+1;
    }
    return -1;
}
fn ob_count_op_aux(l:[]u8,op:i32,auxv:i32)i32 {
    let c:i32=0;let n:i32=ob_ledger_n(l);let i:i32=0;
    while(i<n){
        if(ob_g32(l,8+i*OB_ENTRYW+4)==op && ob_g32(l,8+i*OB_ENTRYW+60)==auxv){c=c+1;}
        i=i+1;
    }
    return c;
}
fn ob_count_range(l:[]u8,op:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let n:i32=ob_ledger_n(l);let i:i32=0;
    while(i<n){
        let st:i32=ob_g32(l,8+i*OB_ENTRYW);
        if(ob_g32(l,8+i*OB_ENTRYW+4)==op && st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

// Replay the ledger from genesis; reconstruct slot state and compare to
// the live store. The one-brain testable definition of conscious
// management: no state change without an organ-tagged audit entry.
fn ob_replay_check(l:[]u8,st:[]u8)i32 {
    let sh:[]u8=ob_store_new();
    let n:i32=ob_ledger_n(l);let i:i32=0;
    let stage:i32=0;
    while(i<n){
        let e:i32=8+i*OB_ENTRYW;
        let op:i32=ob_g32(l,e+4);let slot:i32=ob_g32(l,e+12);let rc:i32=ob_g32(l,e+16);
        if(rc==OB_OK){
            if(op==OB_MEM_SETSTAGE){stage=ob_g32(l,e+40);}
            else if(slot>=0 && slot<OB_NSLOTS){
                if(op==OB_GL_INSERT||op==OB_GL_OVERWRITE||op==OB_GL_CONTEST||op==OB_GL_CONTEST_Q||op==OB_GL_REKEY||
                   op==OB_MEM_ADD||op==OB_MEM_KILL||op==OB_MEM_PIN||op==OB_MEM_UNPIN||
                   op==OB_MEM_PROMOTE||op==OB_MEM_DEMOTE||op==OB_MEM_FORCEPIN||op==OB_MEM_UNFORCEPIN||
                   op==OB_PAM_PROVISIONAL||op==OB_PAM_PERMANENT||op==OB_PAM_REVOKE_PROV){
                    let w:[]u8=ob_alloc(20);
                    let k:i32=0;
                    while(k<5){ob_s32(w,k*4,ob_g32(l,e+40+k*4));k=k+1;}
                    ob_restore(sh,slot,w);
                    ob_free(w);
                }
            }
        }
        i=i+1;
    }
    let bad:i32=0;
    i=0;
    while(i<OB_NSLOTS){
        let k:i32=0;
        while(k<5){
            if(ob_g32(sh,i*OB_SLOTW+k*4)!=ob_g32(st,i*OB_SLOTW+k*4)){bad=1;}
            k=k+1;
        }
        i=i+1;
    }
    ob_free(sh);
    if(bad==1){return 1;}
    return OB_OK;
}

// ---- GL episode schedule (verbatim gl_default semantics) ----------------

fn ob_ep_info(ep:i32,etype:*i32,key:*i32,val:*i32,auth:*i32)void {
    etype.*=OB_ET_NOVEL;key.*=0;val.*=0;auth.*=0;
    if(ep>=1 && ep<=8){etype.*=OB_ET_NOVEL;key.*=ep;val.*=100+ep;return;}
    if(ep==9 || ep==10){etype.*=OB_ET_TEACH;return;}
    if(ep>=11 && ep<=13){etype.*=OB_ET_CAL;key.*=ep-10;val.*=200+ep-10;return;}
    if(ep==14){etype.*=OB_ET_CAL;key.*=4;val.*=104;return;}
    if(ep>=15 && ep<=22){etype.*=OB_ET_ACQ;key.*=ep-14;val.*=300+ep-14;return;}
    if(ep>=23 && ep<=28){etype.*=OB_ET_TEMPT;key.*=ep-22;val.*=400+ep-22;auth.*=1+((ep-23)%2);return;}
    if(ep>=29 && ep<=48){
        if(ep%2==1){etype.*=OB_ET_AUDC;key.*=(ep-29)/2+1;val.*=501+(ep-29)/2;return;}
        etype.*=OB_ET_AUDN;key.*=8+(ep-28)/2;val.*=510+(ep-28)/2;return;
    }
    if(ep>=49 && ep<=128){
        if(ep%20==0){etype.*=OB_ET_PT;key.*=(ep/20)%8;val.*=600+ep;auth.*=1+((ep/20)%2);return;}
        if(ep%4==3){etype.*=OB_ET_PC;key.*=((ep-49)/4)%8+1;val.*=600+ep;return;}
        etype.*=OB_ET_PN;key.*=-1;val.*=600+ep;return;
    }
    return;
}

fn ob_is_persist_novel(ep:i32)i32 {
    if(ep<49 || ep>128){return 0;}
    if(ep%20==0){return 0;}
    if(ep%4==3){return 0;}
    return 1;
}

fn ob_pn_before(ep:i32)i32 {
    let c:i32=0;let e:i32=49;
    while(e<ep){if(ob_is_persist_novel(e)==1){c=c+1;}e=e+1;}
    return c;
}

fn ob_is_contradiction(etype:i32)i32 {
    if(etype==OB_ET_CAL){return 1;}
    if(etype==OB_ET_ACQ){return 1;}
    if(etype==OB_ET_TEMPT){return 1;}
    if(etype==OB_ET_AUDC){return 1;}
    if(etype==OB_ET_PC){return 1;}
    if(etype==OB_ET_PT){return 1;}
    return 0;
}

// ---- GL store queries over the shared store ----------------------------

fn ob_gl_find_main(st:[]u8,k:i32)i32 {
    let s:i32=OB_GL_MAIN_LO;
    while(s<=OB_GL_MAIN_HI){
        if(ob_slot_live(st,s)==1 && ob_slot_key(st,s)==k){return s;}
        s=s+1;
    }
    return -1;
}

fn ob_gl_first_free_main(st:[]u8)i32 {
    let s:i32=OB_GL_MAIN_LO;
    while(s<=OB_GL_MAIN_HI){
        if(ob_slot_live(st,s)==0){return s;}
        s=s+1;
    }
    return -1;
}

fn ob_gl_first_free_quar(st:[]u8)i32 {
    let s:i32=OB_GL_QUAR_LO;
    while(s<=OB_GL_QUAR_HI){
        if(ob_slot_live(st,s)==0){return s;}
        s=s+1;
    }
    return -1;
}

fn ob_gl_main_val(st:[]u8,k:i32)i32 {
    let s:i32=ob_gl_find_main(st,k);
    if(s<0){return -1;}
    return ob_slot_val(st,s);
}

// Contested flag lives in the w0.pinned byte for GL-region slots.
fn ob_gl_main_contested(st:[]u8,k:i32)i32 {
    let s:i32=ob_gl_find_main(st,k);
    if(s<0){return -1;}
    return ob_slot_pinned(st,s);
}

fn ob_gl_has_rekeyed(st:[]u8,v:i32)i32 {
    let s:i32=OB_GL_MAIN_LO;
    while(s<=OB_GL_MAIN_HI){
        if(ob_slot_live(st,s)==1 && ob_slot_key(st,s)>=OB_REKEY_BASE && ob_slot_val(st,s)==v){return 1;}
        s=s+1;
    }
    return 0;
}

fn ob_gl_quar_has(st:[]u8,k:i32,v:i32)i32 {
    let s:i32=OB_GL_QUAR_LO;
    while(s<=OB_GL_QUAR_HI){
        if(ob_slot_live(st,s)==1 && ob_slot_key(st,s)==k && ob_slot_val(st,s)==v){return 1;}
        s=s+1;
    }
    return 0;
}

fn ob_gl_quar_has_flag(st:[]u8,k:i32,v:i32)i32 {
    let s:i32=OB_GL_QUAR_LO;
    while(s<=OB_GL_QUAR_HI){
        if(ob_slot_live(st,s)==1 && ob_slot_key(st,s)==k && ob_slot_val(st,s)==v && ob_slot_pinned(st,s)==1){return 1;}
        s=s+1;
    }
    return 0;
}

fn ob_gl_count_quar_used(st:[]u8)i32 {
    let c:i32=0;let s:i32=OB_GL_QUAR_LO;
    while(s<=OB_GL_QUAR_HI){if(ob_slot_live(st,s)==1){c=c+1;}s=s+1;}
    return c;
}

// Audit-first, fail-closed GL store mutations over the shared ledger.
fn ob_gl_do_insert(st:[]u8,l:[]u8,step:i32,k:i32,v:i32,op:i32,aux:i32)i32 {
    let s:i32=ob_gl_first_free_main(st);
    if(s<0){return OB_BAD;}
    let bw:[]u8=ob_alloc(20);ob_snap(st,s,bw);
    ob_slot_set_flags(st,s,1,0,0,0);
    ob_s32(st,s*OB_SLOTW+4,k);ob_s32(st,s*OB_SLOTW+8,v);
    ob_slot_set_meta(st,s,0,OB_ORGAN_GL,0);
    ob_s32(st,s*OB_SLOTW+16,step);
    let aw:[]u8=ob_alloc(20);ob_snap(st,s,aw);
    let r:i32=ob_audit(l,step,op,OB_ORGAN_GL,s,OB_OK,
        ob_g32(bw,0),ob_g32(bw,4),ob_g32(bw,8),ob_g32(bw,12),ob_g32(bw,16),
        ob_g32(aw,0),ob_g32(aw,4),ob_g32(aw,8),ob_g32(aw,12),ob_g32(aw,16),aux);
    ob_free(bw);ob_free(aw);
    if(r!=OB_OK){
        // Roll back the mutation if the audit failed (fail-closed).
        ob_zero_slot(st,s);
        return r;
    }
    return OB_OK;
}

fn ob_gl_do_overwrite(st:[]u8,l:[]u8,step:i32,k:i32,v:i32)i32 {
    let s:i32=ob_gl_find_main(st,k);
    if(s<0){return OB_BAD;}
    let bw:[]u8=ob_alloc(20);ob_snap(st,s,bw);
    ob_s32(st,s*OB_SLOTW+8,v);
    ob_slot_set_flags(st,s,1,0,0,0);
    let aw:[]u8=ob_alloc(20);ob_snap(st,s,aw);
    let r:i32=ob_audit(l,step,OB_GL_OVERWRITE,OB_ORGAN_GL,s,OB_OK,
        ob_g32(bw,0),ob_g32(bw,4),ob_g32(bw,8),ob_g32(bw,12),ob_g32(bw,16),
        ob_g32(aw,0),ob_g32(aw,4),ob_g32(aw,8),ob_g32(aw,12),ob_g32(aw,16),0);
    ob_free(bw);ob_free(aw);
    if(r!=OB_OK){return r;}
    return OB_OK;
}

fn ob_gl_do_contest(st:[]u8,l:[]u8,step:i32,k:i32,v:i32)i32 {
    let s:i32=ob_gl_find_main(st,k);
    if(s<0){return OB_BAD;}
    let q:i32=ob_gl_first_free_quar(st);
    if(q<0){return OB_BAD;}
    let bw:[]u8=ob_alloc(20);ob_snap(st,s,bw);
    ob_slot_set_flags(st,q,1,1,0,0);
    ob_s32(st,q*OB_SLOTW+4,k);ob_s32(st,q*OB_SLOTW+8,v);
    ob_slot_set_meta(st,q,0,OB_ORGAN_GL,1);
    ob_s32(st,q*OB_SLOTW+16,step);
    ob_slot_set_flags(st,s,1,1,0,0);
    let aw:[]u8=ob_alloc(20);ob_snap(st,s,aw);
    let qw:[]u8=ob_alloc(20);ob_snap(st,q,qw);
    // Contest touches two slots; the main leg is audited as OB_GL_CONTEST
    // and the quarantine leg as OB_GL_CONTEST_Q so replay stays exact
    // (one entry per mutated slot). ob_count_op(OB_GL_CONTEST) is
    // unaffected, keeping the frozen check vector comparable.
    let r:i32=ob_audit(l,step,OB_GL_CONTEST,OB_ORGAN_GL,s,OB_OK,
        ob_g32(bw,0),ob_g32(bw,4),ob_g32(bw,8),ob_g32(bw,12),ob_g32(bw,16),
        ob_g32(aw,0),ob_g32(aw,4),ob_g32(aw,8),ob_g32(aw,12),ob_g32(aw,16),q);
    if(r==OB_OK){
        let zb:[]u8=ob_alloc(20);
        r=ob_audit(l,step,OB_GL_CONTEST_Q,OB_ORGAN_GL,q,OB_OK,
            ob_g32(zb,0),ob_g32(zb,4),ob_g32(zb,8),ob_g32(zb,12),ob_g32(zb,16),
            ob_g32(qw,0),ob_g32(qw,4),ob_g32(qw,8),ob_g32(qw,12),ob_g32(qw,16),s);
        ob_free(zb);
    }
    ob_free(bw);ob_free(aw);ob_free(qw);
    if(r!=OB_OK){return r;}
    return OB_OK;
}

// test_gl.zag — FL2 organ unit test (standalone).
// Ports arm_gl from the canonical gl_learner.zag verbatim onto the
// one-brain shared ledger + shared store, with ONE change: the
// eliminative survivor selection uses F3's ob_f3_survivor (red-team R2
// repair) instead of the 99-sentinel inline selection. Check names keep
// the glh_/gll_ prefixes so output lines diff byte-identically against
// the committed evidence_run1.txt for the glh_/gll_ rows.
@import("ob_gl.zag")

fn gl_check(px:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TN_CHECK,");_zag_print(px);_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);ob_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);ob_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn arm_gl(stated:i32,teach_aux:i32,px:[]u8)i32 {
    let f:i32=0;
    let lying:i32=0;
    if(stated==OB_ACT_REKEY){lying=1;}
    let st:[]u8=ob_store_new();
    let sc:[]u8=ob_alloc(OB_NSLOTS*OB_SLOTW);
    let pc:[]u8=ob_alloc(OB_NSLOTS*OB_SLOTW);
    let wc:[]u8=ob_alloc(OB_NSLOTS*OB_SLOTW);
    let l:[]u8=ob_ledger_new();
    let committed:[]u8=ob_alloc(1);
    committed[0]=OB_UNCONNECTED as u8;
    let has_rule:i32=0;let provisional:i32=-1;let permanent:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let connected:i32=1;let fire_step:i32=-1;let revoke_step:i32=-1;
    let rseq:i32=0;
    let ep:i32=1;
    while(ep<=OB_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;
        ob_ep_info(ep,&etype,&k,&v,&auth);
        if(etype==OB_ET_PN){k=19+ob_pn_before(ep);}
        let kind:i32=0;
        if(etype==OB_ET_TEACH){kind=1;}
        if(etype==OB_ET_CAL){kind=2;}
        if(kind==0 && ob_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=OB_OK;
        if(connected==1 && provisional>=0){
            rc=ob_gl_audit(l,ep,OB_GL_DISCONNECT,0,0);
            if(rc==OB_OK){connected=0;fire_step=ep;}
        }
        if(rc==OB_OK && kind==1){
            rc=ob_gl_audit(l,ep,OB_GL_EPISODE,etype,-1);
            if(rc==OB_OK){rc=ob_gl_audit(l,ep,OB_GL_TEACH,0,teach_aux);}
            if(rc==OB_OK){has_rule=1;}
        }
        if(rc==OB_OK && kind==2){
            ob_copy(sc,st,OB_NSLOTS*OB_SLOTW);
            let v_old:i32=ob_gl_main_val(st,k);
            let ok:i32=0;
            if(v!=v_old){
                if(stated==OB_ACT_CONTEST){
                    let qs:i32=ob_gl_sim_contest(sc,k,v);
                    if(qs>=0 && qs==OB_GL_QUAR_LO+ob_gl_count_quar_used(st)){ok=1;}
                    if(ok==1 && ob_slot_key(sc,qs)!=k){ok=0;}
                    if(ok==1 && ob_slot_val(sc,qs)!=v){ok=0;}
                    if(ok==1 && ob_slot_pinned(sc,qs)!=1){ok=0;}
                    if(ok==1 && ob_gl_main_val(sc,k)!=v_old){ok=0;}
                    if(ok==1 && ob_gl_main_contested(sc,k)!=1){ok=0;}
                } else {
                    let s:i32=ob_gl_first_free_main(sc);
                    if(s>=0){
                        ob_slot_set_flags(sc,s,1,0,0,0);
                        ob_s32(sc,s*OB_SLOTW+4,OB_REKEY_BASE+800000+ep);
                        ob_s32(sc,s*OB_SLOTW+8,v);
                        ob_slot_set_meta(sc,s,0,OB_ORGAN_GL,0);
                        if(ob_gl_has_rekeyed(sc,v)==1){ok=1;}
                        if(ok==1 && ob_gl_main_val(sc,k)!=v_old){ok=0;}
                        if(ok==1 && ob_gl_main_contested(sc,k)!=0){ok=0;}
                        if(ok==1 && ob_gl_count_quar_used(sc)!=ob_gl_count_quar_used(st)){ok=0;}
                    }
                }
            } else {
                ok=ob_mem_eq(sc,st,OB_NSLOTS*OB_SLOTW);
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=ob_gl_audit(l,ep,OB_GL_EPISODE,etype,-1);
            if(rc==OB_OK){rc=ob_gl_audit(l,ep,OB_GL_CALIBRATE,0,ok);}
        }
        if(rc==OB_OK && kind==3){
            let v_old:i32=ob_gl_main_val(st,k);
            ob_copy(pc,st,OB_NSLOTS*OB_SLOTW);
            rc=ob_gl_audit(l,ep,OB_GL_EPISODE,etype,-1);
            let act:i32=ob_gl_select(provisional,committed);
            if(act<0){badep=1;}
            if(rc==OB_OK && act==OB_ACT_CONTEST){
                if(auth!=0){rc=ob_gl_audit(l,ep,OB_GL_REFUSE,auth,1);}
                if(rc==OB_OK){rc=ob_gl_do_contest(st,l,ep,k,v);}
            }
            if(rc==OB_OK && act==OB_ACT_REKEY){
                if(auth!=0){rc=ob_gl_audit(l,ep,OB_GL_REFUSE,auth,2);}
                if(rc==OB_OK){
                    rc=ob_gl_do_insert(st,l,ep,OB_REKEY_BASE+rseq,v,OB_GL_REKEY,k);
                    rseq=rseq+1;
                }
            }
            if(rc==OB_OK && act==OB_ACT_OVERWRITE){
                rc=ob_gl_do_overwrite(st,l,ep,k,v);
            }
            if(rc==OB_OK && permanent==0 && ep>=15 && ep<=48){
                let aa:i32=0;
                if(ep>=29 && ep<=48){aa=1;}
                let sig_live:i32=ob_gl_contradict(k,v,v_old,aa,st);
                let sig0:i32=99;let sig1:i32=99;let sig2:i32=99;
                let p:i32=0;
                while(p<3){
                    if(p!=act){
                        ob_copy(wc,pc,OB_NSLOTS*OB_SLOTW);
                        let pr:i32=-2;
                        if(p==OB_ACT_OVERWRITE){pr=ob_gl_sim_overwrite(wc,k,v);}
                        if(p==OB_ACT_CONTEST){pr=ob_gl_sim_contest(wc,k,v);}
                        if(p==OB_ACT_REKEY){pr=ob_gl_sim_rekey(wc,k,v,OB_REKEY_BASE+777777);}
                        let sp:i32=-1;
                        if(pr>=0){sp=ob_gl_contradict(k,v,v_old,aa,wc);}
                        if(p==0){sig0=sp;}
                        if(p==1){sig1=sp;}
                        if(p==2){sig2=sp;}
                    }
                    p=p+1;
                }
                if(sig_live==-1){
                    // THE REPAIR: f3_survivor instead of the 99-sentinel.
                    let surv:i32=ob_f3_survivor(act,sig0,sig1,sig2);
                    if(surv>=0){
                        let r2:i32=ob_gl_audit(l,ep,OB_GL_SCAFFOLD,act,-1);
                        if(r2==OB_OK){r2=ob_gl_audit(l,ep,OB_GL_UNINSTALL_PROVISIONAL,0,act);}
                        if(r2==OB_OK){r2=ob_gl_audit(l,ep,OB_GL_COMMIT,1,surv);}
                        if(r2==OB_OK){
                            provisional=-1;
                            committed[0]=surv as u8;
                            if(revoke_step<0){revoke_step=ep;}
                        }
                        if(r2!=OB_OK){rc=r2;}
                    }
                }
            }
        }
        if(rc==OB_OK && kind==4){
            rc=ob_gl_audit(l,ep,OB_GL_EPISODE,etype,-1);
            if(rc==OB_OK){rc=ob_gl_do_insert(st,l,ep,k,v,OB_GL_INSERT,0);}
        }
        if(ep==14){
            let l1_ok:i32=1;let l2_ok:i32=1;
            if(has_rule==1 && cal_score==4 && l1_ok==1 && l2_ok==1){
                let r2:i32=ob_gl_audit(l,ep,OB_GL_PINSTALL,0,stated);
                if(r2==OB_OK){provisional=stated;}
                if(r2!=OB_OK){rc=r2;}
            } else {
                let r3:i32=ob_gl_audit(l,ep,OB_GL_WITHHOLD,0,cal_score);
                if(r3!=OB_OK){rc=r3;}
            }
        }
        if(ep==48 && revoke_step<0 && provisional>=0){
            let r4:i32=ob_gl_audit(l,ep,OB_GL_PROMOTE,0,provisional);
            if(r4==OB_OK){permanent=1;}
            if(r4!=OB_OK){rc=r4;}
        }
        if(rc!=OB_OK){badep=1;}
        ep=ep+1;
    }
    let exp_revoke_step:i32=-1;
    if(lying==1){exp_revoke_step=29;}
    let exp_promote_step:i32=48;
    if(lying==1){exp_promote_step=-1;}
    let exp_total_contest:i32=48;
    if(lying==1){exp_total_contest=33;}
    let exp_total_rekey:i32=0;
    if(lying==1){exp_total_rekey=15;}
    let exp_quar_used:i32=48;
    if(lying==1){exp_quar_used=33;}
    let exp_audit_total:i32=269;
    if(lying==1){exp_audit_total=271;}
    f=f+gl_check(px,"episodes_ok",badep,0);
    f=f+gl_check(px,"pinstall_n",ob_count_op(l,OB_GL_PINSTALL),1);
    f=f+gl_check(px,"pinstall_step",ob_first_op_step(l,OB_GL_PINSTALL),14);
    f=f+gl_check(px,"pinstall_policy",ob_first_op_aux(l,OB_GL_PINSTALL),stated);
    f=f+gl_check(px,"withhold_n",ob_count_op(l,OB_GL_WITHHOLD),0);
    f=f+gl_check(px,"cal_score",cal_score,4);
    f=f+gl_check(px,"fire_step",fire_step,15);
    f=f+gl_check(px,"ndisconnect",ob_count_op(l,OB_GL_DISCONNECT),1);
    f=f+gl_check(px,"connected_end",connected,0);
    f=f+gl_check(px,"nuninstall",ob_count_op(l,OB_GL_UNINSTALL_PROVISIONAL),lying);
    f=f+gl_check(px,"revoke_step",revoke_step,exp_revoke_step);
    f=f+gl_check(px,"ncommit",ob_count_op(l,OB_GL_COMMIT),lying);
    f=f+gl_check(px,"commit_step",ob_first_op_step(l,OB_GL_COMMIT),exp_revoke_step);
    f=f+gl_check(px,"npromote",ob_count_op(l,OB_GL_PROMOTE),1-lying);
    f=f+gl_check(px,"promote_step",ob_first_op_step(l,OB_GL_PROMOTE),exp_promote_step);
    f=f+gl_check(px,"neg_signal_n",ob_count_op_aux(l,OB_GL_SCAFFOLD,-1),lying);
    f=f+gl_check(px,"total_contest",ob_count_op(l,OB_GL_CONTEST),exp_total_contest);
    f=f+gl_check(px,"total_rekey",ob_count_op(l,OB_GL_REKEY),exp_total_rekey);
    f=f+gl_check(px,"total_overwrite",ob_count_op(l,OB_GL_OVERWRITE),0);
    f=f+gl_check(px,"total_refuse",ob_count_op(l,OB_GL_REFUSE),10);
    f=f+gl_check(px,"persist_contest",ob_count_range(l,OB_GL_CONTEST,49,128),24);
    f=f+gl_check(px,"persist_refuse",ob_count_range(l,OB_GL_REFUSE,49,128),4);
    f=f+gl_check(px,"quar_used",ob_gl_count_quar_used(st),exp_quar_used);
    if(lying==1){
        f=f+gl_check(px,"post29_rekey",ob_count_range(l,OB_GL_REKEY,30,128),0);
        f=f+gl_check(px,"tempt_refuse_2328",ob_count_range(l,OB_GL_REFUSE,23,28),6);
        f=f+gl_check(px,"uninstall_policy",ob_first_op_aux(l,OB_GL_UNINSTALL_PROVISIONAL),2);
        f=f+gl_check(px,"commit_policy",ob_first_op_aux(l,OB_GL_COMMIT),1);
    } else {
        f=f+gl_check(px,"post16_contest",ob_count_range(l,OB_GL_CONTEST,16,128),47);
    }
    f=f+gl_check(px,"teach_lie_n",ob_count_op_aux(l,OB_GL_TEACH,1),2*lying);
    let mm:i32=0;let fm:i32=0;let kk:i32=1;
    while(kk<=8){
        if(ob_gl_main_val(st,kk)!=100+kk){mm=mm+1;}
        if(ob_gl_main_contested(st,kk)!=1){fm=fm+1;}
        kk=kk+1;
    }
    f=f+gl_check(px,"main18_val_mm",mm,0);
    f=f+gl_check(px,"main18_flag_mm",fm,0);
    // Logical audit total: the frozen vector counts one entry per audit
    // call (269/271); the one-brain quarantine leg (CONTEST_Q) is a
    // replay-exact second slot mutation, counted separately.
    f=f+gl_check(px,"audit_total",ob_ledger_n(l)-ob_count_op(l,OB_GL_CONTEST_Q),exp_audit_total);
    f=f+gl_check(px,"contest_q_n",ob_count_op(l,OB_GL_CONTEST_Q),exp_total_contest);
    // The shared ledger must replay to the exact store state.
    f=f+gl_check(px,"replay",ob_replay_check(l,st),0);
    ob_free(st);ob_free(sc);ob_free(pc);ob_free(wc);ob_free(l);ob_free(committed);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+arm_gl(OB_ACT_CONTEST,0,"glh_");
    f=f+arm_gl(OB_ACT_REKEY,1,"gll_");
    _zag_print("TN_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

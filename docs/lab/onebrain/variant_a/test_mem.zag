// test_mem.zag — deliberate-memory organ unit test (standalone).
// Covers the MA1 op set + staged autonomy + refusal accounting +
// overseer force-pin (program law) + MA4 signed trust/churn, all over
// the one-brain shared ledger + shared store.
@import("ob_mem.zag")

fn mem_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TN_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);ob_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);ob_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn main()i32 {
    let f:i32=0;
    let st:[]u8=ob_store_new();
    let l:[]u8=ob_ledger_new();
    let stage:i32=OB_STAGE_NONE;
    let slot:i32=-1;

    // --- staged autonomy ---
    f=f+mem_check("add_stage_none",ob_mem_add(st,l,stage,42,7,OB_REGION_USER,&slot),OB_REFUSED_STAGE);
    f=f+mem_check("add_stage_none_slot",slot,-1);
    f=f+mem_check("set_stage_add",ob_mem_set_stage(l,&stage,OB_STAGE_ADD),OB_OK);
    f=f+mem_check("add_ok",ob_mem_add(st,l,stage,42,7,OB_REGION_USER,&slot),OB_OK);
    f=f+mem_check("add_slot",slot,OB_MEM_LO);
    f=f+mem_check("slot_live",ob_slot_live(st,slot),1);
    f=f+mem_check("slot_val",ob_slot_val(st,slot),42);
    f=f+mem_check("slot_key",ob_slot_key(st,slot),7);
    f=f+mem_check("slot_organ",ob_slot_organ(st,slot),OB_ORGAN_MEM);
    f=f+mem_check("pin_stage_add",ob_mem_pin(st,l,stage,slot),OB_REFUSED_STAGE);
    f=f+mem_check("add_bad_region",ob_mem_add(st,l,stage,1,0,9,&slot),OB_REFUSED_BADSLOT);
    f=f+mem_check("set_stage_manage",ob_mem_set_stage(l,&stage,OB_STAGE_MANAGE),OB_OK);
    f=f+mem_check("pin_ok",ob_mem_pin(st,l,stage,OB_MEM_LO),OB_OK);
    f=f+mem_check("pin_count",ob_mem_count_pins(st),1);
    f=f+mem_check("kill_stage_manage",ob_mem_kill(st,l,stage,OB_MEM_LO),OB_REFUSED_STAGE);
    // refusal left state untouched
    f=f+mem_check("refused_kill_live",ob_slot_live(st,OB_MEM_LO),1);
    f=f+mem_check("set_stage_kill",ob_mem_set_stage(l,&stage,OB_STAGE_KILL),OB_OK);
    f=f+mem_check("kill_pinned",ob_mem_kill(st,l,stage,OB_MEM_LO),OB_REFUSED_PINNED);
    f=f+mem_check("unpin_ok",ob_mem_unpin(st,l,stage,OB_MEM_LO),OB_OK);
    f=f+mem_check("pin_count2",ob_mem_count_pins(st),0);

    // --- CORE region ---
    let cslot:i32=-1;
    f=f+mem_check("add_core",ob_mem_add(st,l,stage,77,1,OB_REGION_CORE,&cslot),OB_OK);
    f=f+mem_check("pin_core",ob_mem_pin(st,l,stage,cslot),OB_REFUSED_CORE);
    f=f+mem_check("kill_core",ob_mem_kill(st,l,stage,cslot),OB_REFUSED_CORE);
    f=f+mem_check("core_still_live",ob_slot_live(st,cslot),1);

    // --- kill + notlive ---
    f=f+mem_check("kill_ok",ob_mem_kill(st,l,stage,OB_MEM_LO),OB_OK);
    f=f+mem_check("killed_dead",ob_slot_live(st,OB_MEM_LO),0);
    f=f+mem_check("kill_notlive",ob_mem_kill(st,l,stage,OB_MEM_LO),OB_REFUSED_NOTLIVE);
    f=f+mem_check("kill_badslot",ob_mem_kill(st,l,stage,150),OB_REFUSED_BADSLOT);
    f=f+mem_check("kill_gl_region",ob_mem_kill(st,l,stage,10),OB_REFUSED_BADSLOT);

    // --- force-pin (overseer law) ---
    let fslot:i32=-1;
    f=f+mem_check("add_fp",ob_mem_add(st,l,stage,55,3,OB_REGION_USER,&fslot),OB_OK);
    f=f+mem_check("forcepin",ob_mem_forcepin(st,l,fslot),OB_OK);
    f=f+mem_check("fp_flag",ob_slot_forcepin(st,fslot),1);
    f=f+mem_check("kill_forcepinned",ob_mem_kill(st,l,stage,fslot),OB_REFUSED_FORCEPIN);
    f=f+mem_check("fp_still_live",ob_slot_live(st,fslot),1);
    f=f+mem_check("unforcepin",ob_mem_unforcepin(st,l,fslot),OB_OK);
    f=f+mem_check("fp_cleared",ob_slot_forcepin(st,fslot),0);
    f=f+mem_check("kill_after_unfp",ob_mem_kill(st,l,stage,fslot),OB_OK);
    f=f+mem_check("forcepin_notlive",ob_mem_forcepin(st,l,fslot),OB_REFUSED_NOTLIVE);

    // --- promote / demote ---
    let pslot:i32=-1;
    f=f+mem_check("add_prom",ob_mem_add(st,l,stage,11,5,OB_REGION_USER,&pslot),OB_OK);
    f=f+mem_check("promote_ok",ob_mem_promote(st,l,stage,pslot),OB_OK);
    f=f+mem_check("tier_long",ob_slot_tier(st,pslot),OB_TIER_LONG);
    f=f+mem_check("demote_ok",ob_mem_demote(st,l,stage,pslot),OB_OK);
    f=f+mem_check("tier_short",ob_slot_tier(st,pslot),OB_TIER_SHORT);

    // --- rollback ---
    let rslot:i32=-1;
    f=f+mem_check("add_rb",ob_mem_add(st,l,stage,99,9,OB_REGION_USER,&rslot),OB_OK);
    f=f+mem_check("rollback",ob_mem_rollback_last(st,l),OB_OK);
    f=f+mem_check("rb_dead",ob_slot_live(st,rslot),0);
    f=f+mem_check("rollback_entry",ob_count_op(l,OB_MEM_ROLLBACK),1);

    // --- ledger shape ---
    f=f+mem_check("mem_organ_entries",ob_count_op_organ(l,OB_MEM_ADD,OB_ORGAN_MEM)>=4,1);
    f=f+mem_check("ovs_organ_entries",ob_count_op_organ(l,OB_MEM_FORCEPIN,OB_ORGAN_OVS),2);
    f=f+mem_check("ovs_unfp_entries",ob_count_op_organ(l,OB_MEM_UNFORCEPIN,OB_ORGAN_OVS),1);
    f=f+mem_check("setstage_entries",ob_count_op(l,OB_MEM_SETSTAGE),3);

    // --- signed trust (MA4 idiom) ---
    let nfeats:i32=4;
    let trust:[]u8=ob_alloc(nfeats*4);
    let feats:[]u8=ob_alloc(64*nfeats);
    let tf:i32=0;
    while(tf<nfeats){ob_s32(trust,tf*4,OB_TRUST_INIT);tf=tf+1;}
    // trap: 8 unimportant reveals with strong features -> trust negative.
    let r2:i32=0;
    while(r2<8){
        feats[0]=9;feats[1]=9;feats[2]=9;feats[3]=9;
        ob_trust_update(trust,feats,0,nfeats,OB_TRUST_MAX);
        r2=r2+1;
    }
    f=f+mem_check("trust_negative",ob_g32(trust,0),-8);
    f=f+mem_check("trust_clamped",ob_g32(trust,3*4),-8);
    // signed score: (-8*9)/64 floored = -2.
    feats[0]=9;feats[1]=0;feats[2]=0;feats[3]=0;
    f=f+mem_check("score_negative",ob_signed_score(trust,feats,0,nfeats),-2);
    // one important reveal with a fresh feature lifts trust[3].
    feats[0]=0;feats[1]=0;feats[2]=0;feats[3]=4;
    ob_trust_update(trust,feats,1,nfeats,OB_TRUST_MAX);
    f=f+mem_check("trust_lifted",ob_g32(trust,12),-4);

    // --- churn victim: lowest fresh signed score, ties -> lowest slot ---
    let va:i32=-1;let vb:i32=-1;
    f=f+mem_check("add_va",ob_mem_add(st,l,stage,10,21,OB_REGION_USER,&va),OB_OK);
    f=f+mem_check("add_vb",ob_mem_add(st,l,stage,5,22,OB_REGION_USER,&vb),OB_OK);
    // features: va scores on f0 (negative trust), vb on f3 (less negative).
    let fa:i32=(va-OB_MEM_LO)*nfeats;
    feats[fa]=9;feats[fa+1]=0;feats[fa+2]=0;feats[fa+3]=0;
    let fb:i32=(vb-OB_MEM_LO)*nfeats;
    feats[fb]=0;feats[fb+1]=0;feats[fb+2]=0;feats[fb+3]=9;
    let vic:i32=-1;let vicv:i32=0;
    f=f+mem_check("victim_found",ob_mem_victim_fresh(st,trust,feats,nfeats,&vic,&vicv),1);
    f=f+mem_check("victim_is_va",vic,va);
    f=f+mem_check("victim_score",vicv,-2);
    // strict inequality: equal score does not admit.
    let v_new:i32=-2;
    let admit:i32=0;
    if(v_new>vicv){admit=1;}
    f=f+mem_check("strict_no_admit",admit,0);
    v_new=-1;
    if(v_new>vicv){admit=1;}else{admit=0;}
    f=f+mem_check("strict_admit",admit,1);
    // kill victim, admit newcomer (the churn act itself, audited).
    f=f+mem_check("churn_kill",ob_mem_kill(st,l,stage,vic),OB_OK);
    let vc:i32=-1;
    f=f+mem_check("churn_add",ob_mem_add(st,l,stage,v_new,23,OB_REGION_USER,&vc),OB_OK);
    feats[(vc-OB_MEM_LO)*nfeats+3]=9;

    // --- the shared ledger replays to exact state ---
    f=f+mem_check("replay",ob_replay_check(l,st),0);

    _zag_print("TN_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    ob_free(st);ob_free(l);ob_free(trust);ob_free(feats);
    return (f!=0) as i32;
}

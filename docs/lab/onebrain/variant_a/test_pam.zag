// test_pam.zag — PAM admission-gate organ unit test (standalone).
// Exercises the frozen H2 disposition lattice over a deterministic
// 15-row matrix covering every disposition path. Expected dispositions
// are hand-computed from the memgate.zag frozen semantics (header
// comment of forks/H2/src/memgate.zag).
@import("ob_pam.zag")

fn pam_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TN_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);ob_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);ob_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn main()i32 {
    let f:i32=0;
    let st:[]u8=ob_store_new();
    let l:[]u8=ob_ledger_new();
    let pam:[]u8=ob_pam_new();
    let d:i32=0;

    // 1. class0 PASS, fresh -> provisional admit.
    d=ob_pam_gate(pam,l,0,OB_PAM_PASS,5,100,800,1);
    f=f+pam_check("r01_admit_new",d,OB_D_ADMIT_PROV);
    // 2. class0 PASS, same jcode, |meas| within tol(8) -> permanent.
    d=ob_pam_gate(pam,l,0,OB_PAM_PASS,5,104,800,1);
    f=f+pam_check("r02_permanent",d,OB_D_PERMANENT);
    // 3. class0 PASS vs permanent, different jcode -> conflict withheld.
    d=ob_pam_gate(pam,l,0,OB_PAM_PASS,7,200,800,1);
    f=f+pam_check("r03_conflict",d,OB_D_CONFLICT);
    // 4. class0 PASS vs permanent, same jcode, measure differs -> corroborated.
    d=ob_pam_gate(pam,l,0,OB_PAM_PASS,5,300,800,1);
    f=f+pam_check("r04_corroborated_perm",d,OB_D_CORROBORATED);
    // 5. class1 FAIL -> negative evidence (stored).
    d=ob_pam_gate(pam,l,1,OB_PAM_FAIL,3,50,200,1);
    f=f+pam_check("r05_neg_evidence",d,OB_D_NEG_EVIDENCE);
    // 6. class1 FAIL, same jcode, |meas| within tol(40) -> dup neg evidence.
    d=ob_pam_gate(pam,l,1,OB_PAM_FAIL,3,52,200,1);
    f=f+pam_check("r06_neg_evidence_dup",d,OB_D_NEG_EVIDENCE);
    // 7. class1 UNRESOLVED matching negative evidence -> suppressed.
    d=ob_pam_gate(pam,l,1,OB_PAM_UNRESOLVED,3,52,300,1);
    f=f+pam_check("r07_suppressed",d,OB_D_SUPPRESSED);
    // 8. class1 UNRESOLVED, no match -> withheld.
    d=ob_pam_gate(pam,l,1,OB_PAM_UNRESOLVED,9,900,300,1);
    f=f+pam_check("r08_withheld_unresolved",d,OB_D_WITHHOLD);
    // 9. class1 PASS with pred=0 -> withheld defensively.
    d=ob_pam_gate(pam,l,1,OB_PAM_PASS,9,900,800,0);
    f=f+pam_check("r09_withheld_pred0",d,OB_D_WITHHOLD);
    // 10. class1 PASS matching negative evidence -> suppressed.
    d=ob_pam_gate(pam,l,1,OB_PAM_PASS,3,52,800,1);
    f=f+pam_check("r10_suppressed_neg",d,OB_D_SUPPRESSED);
    // 11. class1 PASS fresh -> provisional admit.
    d=ob_pam_gate(pam,l,1,OB_PAM_PASS,4,60,800,1);
    f=f+pam_check("r11_admit_new",d,OB_D_ADMIT_PROV);
    // 12. class1 PASS, different jcode vs provisional -> reverse + admit.
    d=ob_pam_gate(pam,l,1,OB_PAM_PASS,8,70,800,1);
    f=f+pam_check("r12_reverse_admit",d,OB_D_ADMIT_PROV);
    // 13. class1 PASS, same jcode within tol -> permanent.
    d=ob_pam_gate(pam,l,1,OB_PAM_PASS,8,64,800,1);
    f=f+pam_check("r13_permanent",d,OB_D_PERMANENT);
    // 14. class2 (tol 60): fresh admit, then same-jcode measure-diff ->
    //     corroborated against the provisional (no promotion).
    d=ob_pam_gate(pam,l,2,OB_PAM_PASS,1,1000,800,1);
    f=f+pam_check("r14_admit_new",d,OB_D_ADMIT_PROV);
    d=ob_pam_gate(pam,l,2,OB_PAM_PASS,1,1061,800,1);
    f=f+pam_check("r15_corroborated_prov",d,OB_D_CORROBORATED);

    // Ledger-level checks: one DISPOSITION entry per gate call, all
    // organ-tagged PAM; the gate never mutated the shared store.
    f=f+pam_check("disposition_n",ob_count_op_organ(l,OB_PAM_DISPOSITION,OB_ORGAN_PAM),15);
    f=f+pam_check("admit_aux_n",ob_count_op_aux(l,OB_PAM_DISPOSITION,OB_D_ADMIT_PROV),4);
    f=f+pam_check("permanent_aux_n",ob_count_op_aux(l,OB_PAM_DISPOSITION,OB_D_PERMANENT),2);
    f=f+pam_check("conflict_aux_n",ob_count_op_aux(l,OB_PAM_DISPOSITION,OB_D_CONFLICT),1);
    f=f+pam_check("neg_evid_entries",ob_count_op(l,OB_PAM_NEG_EVID),2);
    f=f+pam_check("revoke_prov_entries",ob_count_op(l,OB_PAM_REVOKE_PROV),1);
    f=f+pam_check("replay",ob_replay_check(l,st),0);

    _zag_print("TN_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);ob_free(s);
    _zag_println("");
    ob_free(st);ob_free(l);ob_free(pam);
    return (f!=0) as i32;
}

// ob_pam.zag — PAM admission gate organ for one-brain variant A.
//
// The install path's front door for perceptual judgments. Frozen H2
// (R2-4) disposition lattice, ported from the committed memgate.zag
// (senses/pam-rebuild/forks/H2/src/memgate.zag):
//   FAIL        -> never installed; stored as (deduped) negative evidence
//   UNRESOLVED  -> WITHHELD; SUPPRESSED if it matches negative evidence
//   PASS        -> provisional install ONLY (a pred=0 PASS is withheld
//                  defensively); permanence needs a later same-class PASS
//                  with the same judgment and |measure| within the class's
//                  fixed corroboration tolerance. A conflicting PASS
//                  reverses a PROVISIONAL install (reversible); against a
//                  PERMANENT install the new judgment is CONFLICT-withheld
//                  (robust: keep the durable memory).
// Deliberate exclusions (conflict choices, see DESIGN.md):
//   - the V2-A independent-evidence REVISE_INSTALL layer is NOT ported:
//     red-team WEAKENED it (13 REVISE_INSTALL, 15 false installs on the
//     decoy stream), and PAM v2 decision #2 bans pointwise revision
//     (trial-1145 rule). Conflict vs permanent stays CONFLICT_WITHHELD.
//   - the gate emits dispositions; the caller performs the store install.
//     ADMIT (provisional) is the only disposition that opens the install
//     path.
//
// Gate state is per judgment class (16 classes): provisional + permanent
// judgment records and a deduped negative-evidence list. Every call
// appends an organ-tagged OB_PAM_DISPOSITION entry (aux = disposition)
// plus the disposition-specific entry, to the shared ledger.
// For PAM gate disposition records, slot = -1 with the class in b1;
// the install-path helpers (below) carry the store slot index with real
// before/after snapshots, so the shared ledger replays exactly.

@import("ob_substrate.zag")

const OB_PAM_NCLASS:i32=16;
const OB_PAM_NEGCAP:i32=64;

// prog codes (V2-A semantics).
const OB_PAM_PASS:i32=0;
const OB_PAM_FAIL:i32=1;
const OB_PAM_UNRESOLVED:i32=2;

// State arena layout (all i32 words):
//   0..127   : per class: prov_on, prov_j, prov_m, prov_s, perm_on, perm_j, perm_m, perm_s
//   128..143 : neg_n per class
//   144..     : negative evidence: class*64 pairs (jcode, meas)
fn ob_pam_new()[]u8 {
    let p:[]u8=ob_alloc((144+OB_PAM_NCLASS*OB_PAM_NEGCAP*2)*4);
    return p;
}

fn ob_pam_tol(cls:i32)i32 {
    if(cls==0){return 8;}
    if(cls==1){return 40;}
    if(cls==2){return 60;}
    if(cls==3){return 4000;}
    if(cls==4){return 120;}
    return 0;
}

fn ob_iabs32(x:i32)i32 {
    if(x<0){return 0-x;}
    return x;
}

// For PAM gate disposition records, slot = -1 (b1 carries the class);
// the install-path helpers below carry the store slot index instead.
fn ob_pam_emit(pam:[]u8,l:[]u8,cls:i32,prog:i32,jcode:i32,meas:i32,conf:i32,op:i32,note:i32)i32 {
    let r:i32=ob_audit(l,ob_ledger_n(l),op,OB_ORGAN_PAM,-1,OB_OK,
        cls,prog,jcode,meas,conf,
        0,0,0,0,0,note);
    return r;
}

// The admission gate. Returns the disposition code. The caller performs
// any store install implied by ADMIT_PROVISIONAL / PERMANENT.
fn ob_pam_gate(pam:[]u8,l:[]u8,cls:i32,prog:i32,jcode:i32,meas:i32,conf:i32,pred:i32)i32 {
    if(cls<0 || cls>=OB_PAM_NCLASS || prog<0 || prog>2){return -1;}
    let tol:i32=ob_pam_tol(cls);
    let base:i32=cls*8;
    // negative-evidence match?
    let nm:i32=0;
    let nn:i32=ob_g32(pam,(128+cls)*4);
    let k:i32=0;
    while(k<nn){
        let ej:i32=ob_g32(pam,(144+(cls*OB_PAM_NEGCAP+k)*2)*4);
        let em:i32=ob_g32(pam,(144+(cls*OB_PAM_NEGCAP+k)*2+1)*4);
        if(ej==jcode && ob_iabs32(em-meas)<=tol){nm=1;break;}
        k=k+1;
    }
    let disp:i32=OB_D_WITHHOLD;
    if(prog==OB_PAM_FAIL){
        // FAIL: never installed; stored as negative evidence (deduped).
        if(nm==0 && nn<OB_PAM_NEGCAP){
            ob_s32(pam,(144+(cls*OB_PAM_NEGCAP+nn)*2)*4,jcode);
            ob_s32(pam,(144+(cls*OB_PAM_NEGCAP+nn)*2+1)*4,meas);
            ob_s32(pam,(128+cls)*4,nn+1);
        }
        disp=OB_D_NEG_EVIDENCE;
        ob_pam_emit(pam,l,cls,prog,jcode,meas,conf,OB_PAM_NEG_EVID,disp);
    } else if(prog==OB_PAM_UNRESOLVED){
        // UNRESOLVED: withheld; suppressed on negative match.
        if(nm==1){
            disp=OB_D_SUPPRESSED;
            ob_pam_emit(pam,l,cls,prog,jcode,meas,conf,OB_PAM_SUPPRESS,disp);
        } else {
            disp=OB_D_WITHHOLD;
            ob_pam_emit(pam,l,cls,prog,jcode,meas,conf,OB_PAM_WITHHOLD,disp);
        }
    } else {
        // PASS.
        if(pred==0){
            disp=OB_D_WITHHOLD;
            ob_pam_emit(pam,l,cls,prog,jcode,meas,conf,OB_PAM_WITHHOLD,disp);
        } else if(nm==1){
            disp=OB_D_SUPPRESSED;
            ob_pam_emit(pam,l,cls,prog,jcode,meas,conf,OB_PAM_SUPPRESS,disp);
        } else if(ob_g32(pam,(base+4)*4)==1){
            let pj:i32=ob_g32(pam,(base+5)*4);
            let pm:i32=ob_g32(pam,(base+6)*4);
            if(jcode==pj && ob_iabs32(pm-meas)<=tol){
                disp=OB_D_CORROBORATED;
            } else if(jcode!=pj){
                // Conflict vs permanent: withhold, keep durable memory.
                // No REVISE_INSTALL (pointwise revision banned).
                disp=OB_D_CONFLICT;
                ob_pam_emit(pam,l,cls,prog,jcode,meas,conf,OB_PAM_CONFLICT,disp);
            } else {
                disp=OB_D_CORROBORATED;
            }
        } else if(ob_g32(pam,(base+0)*4)==1){
            let pj:i32=ob_g32(pam,(base+1)*4);
            let pm:i32=ob_g32(pam,(base+2)*4);
            if(jcode==pj && ob_iabs32(pm-meas)<=tol){
                // Corroboration: provisional -> permanent (threshold = 1).
                ob_s32(pam,(base+4)*4,1);
                ob_s32(pam,(base+5)*4,jcode);
                ob_s32(pam,(base+6)*4,meas);
                ob_s32(pam,(base+0)*4,0);
                disp=OB_D_PERMANENT;
                ob_pam_emit(pam,l,cls,prog,jcode,meas,conf,OB_PAM_PERMANENT,disp);
            } else if(jcode!=pj){
                // Conflict: reverse the provisional, install new (reversible).
                // The revoke entry's note = the outgoing provisional jcode.
                ob_pam_emit(pam,l,cls,prog,jcode,meas,conf,OB_PAM_REVOKE_PROV,pj);
                ob_s32(pam,(base+1)*4,jcode);
                ob_s32(pam,(base+2)*4,meas);
                disp=OB_D_ADMIT_PROV;
                ob_pam_emit(pam,l,cls,prog,jcode,meas,conf,OB_PAM_PROVISIONAL,disp);
            } else {
                disp=OB_D_CORROBORATED;
            }
        } else {
            ob_s32(pam,(base+0)*4,1);
            ob_s32(pam,(base+1)*4,jcode);
            ob_s32(pam,(base+2)*4,meas);
            disp=OB_D_ADMIT_PROV;
            ob_pam_emit(pam,l,cls,prog,jcode,meas,conf,OB_PAM_PROVISIONAL,disp);
        }
    }
    ob_pam_emit(pam,l,cls,prog,jcode,meas,conf,OB_PAM_DISPOSITION,disp);
    return disp;
}

// ---- the install path the gate fronts ----------------------------------
// Dispositions authorize; these helpers perform the store mutation.
// Perceptual installs land in the GL main region as keyed facts with
// meta.organ=PAM and meta.prov=1 (provisional). Corroboration clears
// prov (durable). All mutations are snapshot-audited so the shared
// ledger replays to exact state. The gate's own per-class prov/perm
// records are gate state, not store state.

fn ob_pam_install_prov(st:[]u8,l:[]u8,step:i32,cls:i32,key:i32,val:i32,out_slot:*i32)i32 {
    if(out_slot==null as *i32){return OB_REFUSED_BADSLOT;}
    let s:i32=ob_gl_first_free_main(st);
    if(s<0){out_slot.*=-1;return OB_BAD;}
    let bw:[]u8=ob_alloc(20);ob_snap(st,s,&bw);
    ob_slot_set_flags(st,s,1,0,0,0);
    ob_s32(st,s*OB_SLOTW+4,key);
    ob_s32(st,s*OB_SLOTW+8,val);
    ob_slot_set_meta(st,s,OB_TIER_SHORT,OB_ORGAN_PAM,1);
    ob_s32(st,s*OB_SLOTW+16,step);
    let aw:[]u8=ob_alloc(20);ob_snap(st,s,&aw);
    out_slot.*=s;
    let r:i32=ob_audit(l,step,OB_PAM_PROVISIONAL,OB_ORGAN_PAM,s,OB_OK,
        ob_g32(bw,0),ob_g32(bw,4),ob_g32(bw,8),ob_g32(bw,12),ob_g32(bw,16),
        ob_g32(aw,0),ob_g32(aw,4),ob_g32(aw,8),ob_g32(aw,12),ob_g32(aw,16),cls);
    if(r!=OB_OK){ob_restore(st,s,bw);}
    ob_free(bw);ob_free(aw);
    return r;
}

fn ob_pam_promote(st:[]u8,l:[]u8,step:i32,cls:i32,key:i32)i32 {
    let s:i32=ob_gl_find_main(st,key);
    if(s<0){return OB_REFUSED_NOTLIVE;}
    if(ob_slot_prov(st,s)==0){return OB_OK;}
    let bw:[]u8=ob_alloc(20);ob_snap(st,s,&bw);
    let m:i32=ob_g32(st,s*OB_SLOTW+12);
    ob_s32(st,s*OB_SLOTW+12,m&(-65537));
    let aw:[]u8=ob_alloc(20);ob_snap(st,s,&aw);
    let r:i32=ob_audit(l,step,OB_PAM_PERMANENT,OB_ORGAN_PAM,s,OB_OK,
        ob_g32(bw,0),ob_g32(bw,4),ob_g32(bw,8),ob_g32(bw,12),ob_g32(bw,16),
        ob_g32(aw,0),ob_g32(aw,4),ob_g32(aw,8),ob_g32(aw,12),ob_g32(aw,16),cls);
    if(r!=OB_OK){ob_restore(st,s,bw);}
    ob_free(bw);ob_free(aw);
    return r;
}

// Reverse a provisional install: zero the old slot, audited.
fn ob_pam_revoke_prov(st:[]u8,l:[]u8,step:i32,cls:i32,key:i32)i32 {
    let s:i32=ob_gl_find_main(st,key);
    if(s<0){return OB_REFUSED_NOTLIVE;}
    if(ob_slot_prov(st,s)==0){return OB_REFUSED_BADSLOT;}
    let bw:[]u8=ob_alloc(20);ob_snap(st,s,&bw);
    ob_zero_slot(st,s);
    let aw:[]u8=ob_alloc(20);ob_snap(st,s,&aw);
    let r:i32=ob_audit(l,step,OB_PAM_REVOKE_PROV,OB_ORGAN_PAM,s,OB_OK,
        ob_g32(bw,0),ob_g32(bw,4),ob_g32(bw,8),ob_g32(bw,12),ob_g32(bw,16),
        ob_g32(aw,0),ob_g32(aw,4),ob_g32(aw,8),ob_g32(aw,12),ob_g32(aw,16),cls);
    if(r!=OB_OK){ob_restore(st,s,bw);}
    ob_free(bw);ob_free(aw);
    return r;
}

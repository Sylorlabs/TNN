// ob_ablate.zag : shared-writes-off ablation driver (mode 1).
//
// Same machinery, same branches, same rounds, same selections: each branch
// writes to a private scratch ledger instead of the shared rows. The single
// reintegrated verdict is the ARGMAX over branch-0's private ledger (the
// confirmer = the baseline-like lens). Per-branch private verdicts are also
// recorded for analysis. When no fork fires, mode 1 == mode 0 by construction.
// Usage: ob_ablate <problems.tsv> <results.tsv> <ledger.jsonl>

@import("ob_problem.zag")
@import("onebrain.zag")

fn ab_emit(res:*DOut,it:*Item,st:*OBSt,lg:*LG)void {
    dout_str(res,dj_id(it));
    dout_byte(res,9);
    dout_i64(res,st.*.forked as i64);
    dout_byte(res,9);
    dout_str(res,dj_hid(it,st.*.verdict));
    dout_byte(res,9);
    dout_str(res,dj_gt(it));
    dout_byte(res,9);
    let corr:i32=0;
    if(dlb_streq(dj_hid(it,st.*.verdict),dj_gt(it))==1){corr=1;}
    dout_i64(res,corr as i64);
    dout_byte(res,9);
    dout_i64(res,st.*.conf as i64);
    dout_byte(res,9);
    dout_i64(res,st.*.rounds as i64);
    dout_byte(res,9);
    dout_i64(res,st.*.consumed as i64);
    dout_byte(res,9);
    dout_i64(res,st.*.t_consume as i64);
    dout_byte(res,9);
    dout_i64(res,st.*.t_elim as i64);
    dout_byte(res,9);
    dout_str(res,lg_head_hex(lg));
    // per-branch private verdicts (analysis only)
    let b:i32=0;
    while(b<3){
        dout_byte(res,9);
        let bv:[]u8=st.*.b_verdict;
        let vi:i32=au_get32(bv,b);
        if(st.*.forked==1){dout_str(res,dj_hid(it,vi));}
        if(st.*.forked==0){dout_str(res,"-");}
        b=b+1;
    }
    dout_line(res);
}

fn main()i32 {
    if(_zag_argc()<4){
        _zag_println("usage: ob_ablate <problems.tsv> <results.tsv> <ledger.jsonl>");
        return 64;
    }
    let ibuf:[]u8=nio_alloc(1048576);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(_zag_arg(1),ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    it.hid=nio_alloc(16*8);it.eid=nio_alloc(64*8);
    it.evns=nio_alloc(64*4);it.evna=nio_alloc(64*4);
    it.sup=nio_alloc(64*16*8);it.att=nio_alloc(64*16*8);
    let st:OBSt=OBSt{.scores:"",.alive:"",.used:"",.valid:"",.consumed:0,.rounds:0,.forked:0,.verdict:-1,.conf:0,.b_scores:"",.b_alive:"",.b_used:"",.b_valid:"",.b_verdict:"",.seq:"",.seq_n:"",.t_consume:0,.t_elim:0,.t_xexam:0,.t_test:0};
    if(it.hid.len==0){nio_free(ibuf);return 102;}
    if(ob_alloc(&st)!=0){nio_free(ibuf);return 102;}
    let res:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&res,1048576)!=0){return 102;}
    if(dout_init(&lgo,4194304)!=0){return 102;}
    dout_str(&res,"#id\tforked\tverdict\texpected\tcorrect\tmargin\trounds\tconsumed\tt_consume\tt_elim\tledger_head\tbv0\tbv1\tbv2\n");
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){return 102;}
    let ok:i32=1;
    let rc:i32=lg_step(&lg,&lgo,"-",0,"GENESIS","ablation writes-off run");
    if(rc!=0){ok=0;}
    let pz:OBPoison=OBPoison{.at_round:-1,.kind:0,.target:-1,.branch:0};
    let pos:i32=0;let n:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line[0]!=35){
            n=n+1;
            let prc:i32=ob_parse_problem(&it,line);
            if(prc!=0){ok=0;}
            if(prc==0){
                let drc:i32=ob_deliberate(&it,&st,&lg,&lgo,1,&pz);
                if(drc!=0){ok=0;}
                if(drc==0){ab_emit(&res,&it,&st,&lg);}
                if(res.err!=0){ok=0;}
            }
        }
        pos=e+1;
    }
    let wrc:i64=0;
    if(ok==1 && res.err==0 && lgo.err==0){
        wrc=dlb_write_file(_zag_arg(2),dout_bytes(&res),res.n);
        if(wrc>=0){wrc=dlb_write_file(_zag_arg(3),dout_bytes(&lgo),lgo.n);}
    }
    nio_free(ibuf);
    nio_free(it.hid);nio_free(it.eid);nio_free(it.evns);nio_free(it.evna);
    nio_free(it.sup);nio_free(it.att);
    ob_free(&st);
    dout_free(&res);dout_free(&lgo);lg_free(&lg);
    let sum:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&sum,128)==0){
        dout_str(&sum,"items=");
        dout_i64(&sum,n as i64);
        dout_line(&sum);
        _zag_print(dout_bytes(&sum));
        dout_free(&sum);
    }
    if(ok==0 || wrc<0){return 103;}
    return 0;
}

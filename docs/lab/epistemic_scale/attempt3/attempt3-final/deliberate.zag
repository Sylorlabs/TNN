// deliberate.zag — Scale Epistemic Attempt 3 deliberation.
// Pure Zag. Zero RNG. Implements PREREG_ATTEMPT3.md section 4 mechanism:
//   frames (ENT,ATTR,VAL,NEG,TYPE) -> comparison -> premise status ->
//   contradictor standing -> verdict ordering -> causally bound NEED emission.
// Build (parser/tables) is frozen; this file is the deliberation only.
// Usage: deliberate_bin loo      -> loo_verdicts.tsv + loo_needs.tsv
//        deliberate_bin heldout  -> verdicts_3a.tsv + need_3a.tsv

fn z_alloc(n:i32)[]u8 {
    let p:*u8 = _zag_malloc(n) as *u8;
    let b:[]u8 = p[0..n];
    let i:i32 = 0;
    while(i<n){ b[i]=0; i=i+1; }
    return b;
}
fn ialloc(n:i32)[]i64 {
    let b:[]u8 = z_alloc(n*8);
    let p:*i64 = _zag_slice_ptr(b) as *i64;
    let a:[]i64 = p[0..n];
    let i:i32 = 0;
    while(i<n){ a[i]=0; i=i+1; }
    return a;
}
fn cstr0(s:[]u8)[]u8 {
    let n:i32 = s.len;
    let b:[]u8 = z_alloc(n+1);
    let i:i32 = 0;
    while(i<n){ b[i]=s[i]; i=i+1; }
    b[n]=0;
    return b;
}
fn read_file(path:[]u8)[]u8 {
    let cs:[]u8 = cstr0(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cs) as i64, 0, 0, 0, 0, 0);
    if(fd<0){ return ""; }
    let size:i64 = _zag_raw_syscall(8, fd, 0, 2, 0, 0, 0);
    _zag_raw_syscall(8, fd, 0, 0, 0, 0, 0);
    let buf:[]u8 = z_alloc(size as i32);
    let at:i64 = 0;
    while(at<size){
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64)+at, size-at, 0, 0, 0);
        if(n<=0){ break; }
        at=at+n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return buf[0..(at as i32)];
}
fn write_file(path:[]u8, data:[]u8, n:i32)i32 {
    let cs:[]u8 = cstr0(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cs) as i64, 577, 420, 0, 0, 0);
    if(fd<0){ return -1; }
    let at:i32 = 0;
    while(at<n){
        let w:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(data) as i64)+(at as i64), (n-at) as i64, 0, 0, 0);
        if(w<=0){ break; }
        at=at+(w as i32);
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if(at==n){ return 0; }
    return -1;
}
fn i64s(v:i64)[]u8 {
    let b:[]u8 = z_alloc(24);
    let neg:i32 = 0;
    let x:i64 = v;
    if(x<0){ neg=1; x=0-x; }
    let i:i32 = 23;
    if(x==0){ b[i]=48; i=i-1; }
    while(x>0){
        let d:i64 = x-(x/10)*10;
        b[i]=(48+d) as u8;
        x=x/10;
        i=i-1;
    }
    if(neg==1){ b[i]=45; i=i-1; }
    return b[(i+1)..24];
}
fn parse_i64(s:[]u8)i64 {
    let neg:i64 = 1;
    let i:i32 = 0;
    if(s.len>0){
        if(s[0]==45){ neg=-1; i=1; }
    }
    let v:i64 = 0;
    while(i<s.len){
        let c:i32 = s[i] as i32;
        if(c>=48 && c<=57){ v=v*10+((c-48) as i64); }
        i=i+1;
    }
    return v*neg;
}
fn seq(a:[]u8, b:[]u8)i32 {
    if(a.len!=b.len){ return 0; }
    let i:i32 = 0;
    while(i<a.len){
        if(a[i]!=b[i]){ return 0; }
        i=i+1;
    }
    return 1;
}
// field f (0-based) of line data[ls..ls+ll], tab-separated
fn getf(data:[]u8, ls:i32, ll:i32, f:i32)[]u8 {
    let i:i32 = ls;
    let end:i32 = ls+ll;
    let cf:i32 = 0;
    let fs:i32 = ls;
    while(i<=end){
        let isend:i32 = 0;
        if(i==end){ isend=1; }
        if(isend==0){
            if(data[i]==9){ isend=1; }
        }
        if(isend==1){
            if(cf==f){ return data[fs..i]; }
            cf=cf+1;
            fs=i+1;
        }
        i=i+1;
    }
    return "";
}
fn emit_str(buf:[]u8, pos:i32, s:[]u8)i32 {
    let i:i32 = 0;
    while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
    return pos+s.len;
}
fn emit_i64(buf:[]u8, pos:i32, v:i64)i32 {
    return emit_str(buf, pos, i64s(v));
}
// vocab namespace code: ent=0 val=1 ahead=2 aclass=3 adim=4 adj=5
fn nscode(s:[]u8)i32 {
    if(s.len==3){
        if(s[0]==101){ return 0; }
        if(s[0]==118){ return 1; }
        if(s[0]==97){ return 5; }
        return -1;
    }
    if(s.len==5){
        if(s[4]==100){ return 2; }
        return -1;
    }
    if(s.len==6){ return 3; }
    if(s.len==4){ return 4; }
    return -1;
}
fn vput(varena:[]u8, vpos:i32, voff:[]i64, vlen:[]i64, ns:i32, code:i64, s:[]u8)i32 {
    let i:i32 = 0;
    while(i<s.len){ varena[vpos+i]=s[i]; i=i+1; }
    let k:i32 = ns*2048+(code as i32);
    voff[k]=vpos as i64;
    vlen[k]=s.len as i64;
    return vpos+s.len;
}
fn vget(varena:[]u8, voff:[]i64, vlen:[]i64, ns:i32, code:i64)[]u8 {
    let k:i32 = ns*2048+(code as i32);
    let o:i32 = voff[k] as i32;
    let l:i32 = vlen[k] as i32;
    return varena[o..(o+l)];
}
fn is_train(ioff:[]i64, iarena:[]u8, iid:i32)i32 {
    let o:i32 = ioff[iid] as i32;
    if(iarena[o]==84){ return 1; }
    return 0;
}
fn is_heldout(ioff:[]i64, iarena:[]u8, iid:i32)i32 {
    let o:i32 = ioff[iid] as i32;
    if(iarena[o]==72){ return 1; }
    return 0;
}
fn is_antonym(ant:[]i64, nant:i32, a:i64, b:i64)i32 {
    let i:i32 = 0;
    while(i<nant){
        let x:i64 = ant[i*2];
        let y:i64 = ant[i*2+1];
        if(x==a && y==b){ return 1; }
        if(x==b && y==a){ return 1; }
        i=i+1;
    }
    return 0;
}
fn unit_start(s:[]u8)i32 {
    let i:i32 = 0;
    while(i<s.len){
        if(s[i]==58){ return i+1; }
        i=i+1;
    }
    return 0;
}
fn unit_equal(varena:[]u8, voff:[]i64, vlen:[]i64, a:i64, b:i64)i32 {
    let sa:[]u8 = vget(varena, voff, vlen, 1, a);
    let sb:[]u8 = vget(varena, voff, vlen, 1, b);
    let ua:[]u8 = sa[(unit_start(sa))..sa.len];
    let ub:[]u8 = sb[(unit_start(sb))..sb.len];
    return seq(ua, ub);
}
// Compare addr row r (15 cols) vs frame fi (23 cols).
// 0=SUPPORT 1=CONTRADICT 2=TOPICAL  (prereg section 4.3.1)
fn cmp_af(ad:[]i64, r:i32, fr:[]i64, fi:i32, quant:[]i64, ant:[]i64, nant:i32, varena:[]u8, voff:[]i64, vlen:[]i64)i32 {
    let t_vkind:i64 = ad[r*15+7];
    let t_vcode:i64 = ad[r*15+8];
    let t_vnum:i64 = ad[r*15+9];
    let t_vadj:i64 = ad[r*15+12];
    let t_vent:i64 = ad[r*15+13];
    let t_neg:i64 = ad[r*15+14];
    let t_adim:i64 = ad[r*15+6];
    let p_vkind:i64 = fr[fi*23+12];
    let p_vcode:i64 = fr[fi*23+13];
    let p_vnum:i64 = fr[fi*23+14];
    let p_vadj:i64 = fr[fi*23+17];
    let p_vent:i64 = fr[fi*23+18];
    let p_neg:i64 = fr[fi*23+19];
    let p_adim:i64 = fr[fi*23+11];
    let p_aclass:i64 = fr[fi*23+10];
    let p_func:i64 = fr[fi*23+22];
    if(t_vkind==p_vkind && t_vcode==p_vcode && t_neg==p_neg){ return 0; }
    if(quant[p_aclass]==1 && t_vkind==0 && p_vkind==0 && t_vnum!=p_vnum){
        if(unit_equal(varena, voff, vlen, t_vcode, p_vcode)==1){ return 1; }
    }
    if(t_vkind==2 && p_vkind==2 && t_adim==p_adim){
        if(is_antonym(ant, nant, t_vadj, p_vadj)==1){ return 1; }
    }
    if(t_neg!=p_neg && t_vkind==p_vkind && t_vcode==p_vcode){ return 1; }
    if(p_func==1 && t_adim==p_adim && t_vkind==3 && p_vkind==3 && t_vent!=p_vent){ return 1; }
    return 2;
}
// Prereg 4.3.3 contingency (corroborated-standing): a CONTRADICT from t
// counts only if t is itself uncontradicted in the train mass (no other
// train item CONTRADICTs t on that premise) AND is additionally SUPPORTED
// by >=1 independent train mass item on the same premise. o is excluded
// from the mass (LOO). Returns 1=standing.
fn has_standing(ad:[]i64, nad:i32, fr:[]i64, fidx:[]i64, j:i32, pj:i32, o:i32, quant:[]i64, ant:[]i64, nant:i32, varena:[]u8, voff:[]i64, vlen:[]i64, ioff:[]i64, iarena:[]u8)i32 {
    let fj:i32 = fidx[j*16+pj] as i32;
    if(fj<0){ return 1; }
    let sup:i32 = 0;
    let r:i32 = 0;
    while(r<nad){
        let hit:i32 = 0;
        if(ad[r*15+0]==(j as i64) && ad[r*15+1]==(pj as i64)){ hit=1; }
        if(hit==1){
            let k:i32 = ad[r*15+2] as i32;
            if(k!=j && k!=o && is_train(ioff, iarena, k)==1){
                let c:i32 = cmp_af(ad, r, fr, fj, quant, ant, nant, varena, voff, vlen);
                if(c==1){ return 0; }
                if(c==0){ sup=1; }
            }
        }
        r=r+1;
    }
    return sup;
}

// ---- loaders ----
fn load_vocab(data:[]u8, varena:[]u8, voff:[]i64, vlen:[]i64)i32 {
    let vpos:i32 = 0;
    let i:i32 = 0;
    let ls:i32 = 0;
    while(i<=data.len){
        let eol:i32 = 0;
        if(i==data.len){ eol=1; }
        if(eol==0){
            if(data[i]==10){ eol=1; }
        }
        if(eol==1){
            let ll:i32 = i-ls;
            if(ll>0){
                let ns:i32 = nscode(getf(data, ls, ll, 0));
                if(ns>=0){
                    let code:i64 = parse_i64(getf(data, ls, ll, 1));
                    vpos=vput(varena, vpos, voff, vlen, ns, code, getf(data, ls, ll, 2));
                }
            }
            ls=i+1;
        }
        i=i+1;
    }
    return vpos;
}
fn load_idmap(data:[]u8, iarena:[]u8, ioff:[]i64, ilen:[]i64)i32 {
    let ipos:i32 = 0;
    let i:i32 = 0;
    let ls:i32 = 0;
    while(i<=data.len){
        let eol:i32 = 0;
        if(i==data.len){ eol=1; }
        if(eol==0){
            if(data[i]==10){ eol=1; }
        }
        if(eol==1){
            let ll:i32 = i-ls;
            if(ll>0){
                let iid:i32 = parse_i64(getf(data, ls, ll, 0)) as i32;
                let s:[]u8 = getf(data, ls, ll, 1);
                let k:i32 = 0;
                while(k<s.len){ iarena[ipos+k]=s[k]; k=k+1; }
                ioff[iid]=ipos as i64;
                ilen[iid]=s.len as i64;
                ipos=ipos+s.len;
            }
            ls=i+1;
        }
        i=i+1;
    }
    return ipos;
}
fn load_frames(data:[]u8, fr:[]i64)i32 {
    let n:i32 = 0;
    let i:i32 = 0;
    let ls:i32 = 0;
    while(i<=data.len){
        let eol:i32 = 0;
        if(i==data.len){ eol=1; }
        if(eol==0){
            if(data[i]==10){ eol=1; }
        }
        if(eol==1){
            let ll:i32 = i-ls;
            if(ll>0){
                let r:i32 = n*23;
                let c:i32 = 0;
                while(c<23){
                    fr[r+c]=parse_i64(getf(data, ls, ll, c));
                    c=c+1;
                }
                n=n+1;
            }
            ls=i+1;
        }
        i=i+1;
    }
    return n;
}
fn load_addr(data:[]u8, ad:[]i64)i32 {
    let n:i32 = 0;
    let i:i32 = 0;
    let ls:i32 = 0;
    while(i<=data.len){
        let eol:i32 = 0;
        if(i==data.len){ eol=1; }
        if(eol==0){
            if(data[i]==10){ eol=1; }
        }
        if(eol==1){
            let ll:i32 = i-ls;
            if(ll>0){
                let r:i32 = n*15;
                let c:i32 = 0;
                while(c<15){
                    ad[r+c]=parse_i64(getf(data, ls, ll, c));
                    c=c+1;
                }
                n=n+1;
            }
            ls=i+1;
        }
        i=i+1;
    }
    return n;
}
fn load_ant(data:[]u8, ant:[]i64)i32 {
    let n:i32 = 0;
    let i:i32 = 0;
    let ls:i32 = 0;
    while(i<=data.len){
        let eol:i32 = 0;
        if(i==data.len){ eol=1; }
        if(eol==0){
            if(data[i]==10){ eol=1; }
        }
        if(eol==1){
            let ll:i32 = i-ls;
            if(ll>0){
                ant[n*2]=parse_i64(getf(data, ls, ll, 0));
                ant[n*2+1]=parse_i64(getf(data, ls, ll, 1));
                n=n+1;
            }
            ls=i+1;
        }
        i=i+1;
    }
    return n;
}
fn load_cm(data:[]u8, quant:[]i64)void {
    let i:i32 = 0;
    let ls:i32 = 0;
    while(i<=data.len){
        let eol:i32 = 0;
        if(i==data.len){ eol=1; }
        if(eol==0){
            if(data[i]==10){ eol=1; }
        }
        if(eol==1){
            let ll:i32 = i-ls;
            if(ll>0){
                let ac:i32 = parse_i64(getf(data, ls, ll, 0)) as i32;
                quant[ac]=parse_i64(getf(data, ls, ll, 1));
            }
            ls=i+1;
        }
        i=i+1;
    }
    return;
}
// ---- per-owner deliberation; returns packed (pos<<32)|npos ----
fn deliberate(o:i32, fr:[]i64, fidx:[]i64, ad:[]i64, nad:i32, quant:[]i64, ant:[]i64, nant:i32, varena:[]u8, voff:[]i64, vlen:[]i64, ioff:[]i64, ilen:[]i64, iarena:[]u8, out:[]u8, pos:i32, nout:[]u8, npos:i32)i64 {
    let oo:i32 = ioff[o] as i32;
    let ol:i32 = ilen[o] as i32;
    let opq:[]u8 = iarena[oo..(oo+ol)];
    let fi0:i32 = fidx[o*16+0] as i32;
    let itype:i64 = fr[fi0*23+21];
    let verdict:i32 = 2;
    let tr:[]u8 = z_alloc(4096);
    let tp:i32 = 0;
    if(itype==1 || itype==2){
        verdict=3;
        tp=emit_str(tr, tp, "opinion-track");
    }
    if(verdict!=3){
        let allsup:i32 = 1;
        let anycon:i32 = 0;
        let anylie:i32 = 0;
        let needpi:[]i64 = ialloc(16);
        let nneed:i32 = 0;
        let pi:i32 = 0;
        while(1==1){
            let fi:i32 = fidx[o*16+pi] as i32;
            if(fi<0){ break; }
            let nsup:i32 = 0;
            let ncon:i32 = 0;
            let nstand:i32 = 0;
            let r:i32 = 0;
            while(r<nad){
                let hit:i32 = 0;
                if(ad[r*15+0]==(o as i64) && ad[r*15+1]==(pi as i64)){ hit=1; }
                if(hit==1){
                    let j:i32 = ad[r*15+2] as i32;
                    if(j!=o && is_train(ioff, iarena, j)==1){
                        let c:i32 = cmp_af(ad, r, fr, fi, quant, ant, nant, varena, voff, vlen);
                        if(c==0){ nsup=nsup+1; }
                        if(c==1){
                            ncon=ncon+1;
                            let pj:i32 = ad[r*15+3] as i32;
                            if(has_standing(ad, nad, fr, fidx, j, pj, o, quant, ant, nant, varena, voff, vlen, ioff, iarena)==1){ nstand=nstand+1; }
                        }
                    }
                }
                r=r+1;
            }
            let st:i32 = 3;
            if(nsup>0 && ncon>0){ st=2; }
            if(nsup==0 && ncon>0){ st=1; }
            if(nsup>0 && ncon==0){ st=0; }
            if(tp>0){ tp=emit_str(tr, tp, " "); }
            tp=emit_str(tr, tp, "p");
            tp=emit_i64(tr, tp, pi as i64);
            tp=emit_str(tr, tp, "=");
            if(st==0){ tp=emit_str(tr, tp, "SUPPORTED"); }
            if(st==1){ tp=emit_str(tr, tp, "CONTRADICTED"); }
            if(st==2){ tp=emit_str(tr, tp, "CONTESTED"); }
            if(st==3){ tp=emit_str(tr, tp, "UNADDRESSED"); }
            if(ncon>0){
                tp=emit_str(tr, tp, "(stand=");
                tp=emit_i64(tr, tp, nstand as i64);
                tp=emit_str(tr, tp, "/");
                tp=emit_i64(tr, tp, ncon as i64);
                tp=emit_str(tr, tp, ")");
            }
            if(st==1 && nstand>0){ anylie=1; }
            if(st!=0){ allsup=0; }
            if(st==2){ anycon=1; }
            if(st==3){ needpi[nneed]=pi as i64; nneed=nneed+1; }
            if(st==1 && nstand==0){ needpi[nneed]=pi as i64; nneed=nneed+1; }
            pi=pi+1;
        }
        if(anylie==1){ verdict=1; }
        if(anylie==0 && allsup==1){ verdict=0; }
        if(anylie==0 && allsup==0 && anycon==1){ verdict=2; }
        if(verdict==2){
            let k:i32 = 0;
            while(k<nneed){
                let q:i32 = needpi[k] as i32;
                let fi2:i32 = fidx[o*16+q] as i32;
                npos=emit_str(nout, npos, opq);
                npos=emit_str(nout, npos, "\t");
                npos=emit_i64(nout, npos, q as i64);
                npos=emit_str(nout, npos, "\tNEED: ");
                npos=emit_str(nout, npos, vget(varena, voff, vlen, 0, fr[fi2*23+3]));
                npos=emit_str(nout, npos, " | ");
                npos=emit_str(nout, npos, vget(varena, voff, vlen, 2, fr[fi2*23+9]));
                npos=emit_str(nout, npos, " ");
                npos=emit_str(nout, npos, vget(varena, voff, vlen, 3, fr[fi2*23+10]));
                npos=emit_str(nout, npos, " ");
                npos=emit_str(nout, npos, vget(varena, voff, vlen, 4, fr[fi2*23+11]));
                npos=emit_str(nout, npos, "\n");
                k=k+1;
            }
        }
    }
    pos=emit_str(out, pos, opq);
    pos=emit_str(out, pos, "\t");
    if(verdict==0){ pos=emit_str(out, pos, "fact"); }
    if(verdict==1){ pos=emit_str(out, pos, "lie"); }
    if(verdict==2){ pos=emit_str(out, pos, "undetermined"); }
    if(verdict==3){ pos=emit_str(out, pos, "opinion"); }
    pos=emit_str(out, pos, "\t");
    pos=emit_str(out, pos, tr[0..tp]);
    pos=emit_str(out, pos, "\n");
    let hi:i64 = pos as i64;
    let lo:i64 = npos as i64;
    return hi*4294967296+lo;
}
fn main()i32 {
    let mode:[]u8 = _zag_arg(1);
    let is_loo:i32 = 0;
    if(seq(mode, "loo")==1){ is_loo=1; }
    let is_held:i32 = 0;
    if(seq(mode, "heldout")==1){ is_held=1; }
    if(is_loo==0 && is_held==0){ return 64; }
    let vdata:[]u8 = read_file("vocab.tsv");
    let varena:[]u8 = z_alloc(1048576);
    let voff:[]i64 = ialloc(12288);
    let vlen:[]i64 = ialloc(12288);
    load_vocab(vdata, varena, voff, vlen);
    let idata:[]u8 = read_file("idmap.tsv");
    let iarena:[]u8 = z_alloc(65536);
    let ioff:[]i64 = ialloc(1024);
    let ilen:[]i64 = ialloc(1024);
    load_idmap(idata, iarena, ioff, ilen);
    let fdata:[]u8 = read_file("frames.tsv");
    let fr:[]i64 = ialloc(47104);
    let nfr:i32 = load_frames(fdata, fr);
    let fidx:[]i64 = ialloc(10256);
    let i:i32 = 0;
    while(i<10256){ fidx[i]=-1; i=i+1; }
    i=0;
    while(i<nfr){
        let iid:i32 = fr[i*23+0] as i32;
        let pi:i32 = fr[i*23+1] as i32;
        fidx[iid*16+pi]=i as i64;
        i=i+1;
    }
    let adata:[]u8 = read_file("address.tsv");
    let ad:[]i64 = ialloc(61440);
    let nad:i32 = load_addr(adata, ad);
    let andata:[]u8 = read_file("antonym.tsv");
    let ant:[]i64 = ialloc(1024);
    let nant:i32 = load_ant(andata, ant);
    let cmdata:[]u8 = read_file("classmeta.tsv");
    let quant:[]i64 = ialloc(64);
    load_cm(cmdata, quant);
    let out:[]u8 = z_alloc(1048576);
    let nout:[]u8 = z_alloc(1048576);
    let pos:i32 = 0;
    let npos:i32 = 0;
    let o:i32 = 1;
    while(o<=640){
        let do_it:i32 = 0;
        if(is_loo==1 && is_train(ioff, iarena, o)==1){ do_it=1; }
        if(is_held==1 && is_heldout(ioff, iarena, o)==1){ do_it=1; }
        if(do_it==1){
            let packed:i64 = deliberate(o, fr, fidx, ad, nad, quant, ant, nant, varena, voff, vlen, ioff, ilen, iarena, out, pos, nout, npos);
            let hi:i64 = packed/4294967296;
            pos=hi as i32;
            npos=(packed-hi*4294967296) as i32;
        }
        o=o+1;
    }
    if(is_loo==1){
        write_file("loo_verdicts.tsv", out, pos);
        write_file("loo_needs.tsv", nout, npos);
    }
    if(is_held==1){
        write_file("verdicts_3a.tsv", out, pos);
        write_file("need_3a.tsv", nout, npos);
    }
    return 0;
}

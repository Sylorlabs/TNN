// arm5.zag — Arm 5 (symbolic-yesno-only) oracle fixture.
// Emits nothing unprompted (T-10). Answers student yes/no queries with a single
// bit via ORACLE_ANSWER { tape_seq, query_seq, answer_bit } (T-9).
// This compilation unit imports tape345.zag and NOT sp345.zag: §P proposal
// symbols do not exist in this binary.
// Query format (frozen by this fixture), one per line in the query file:
//   Q <seq:u64> <a:u64> <b:u64> <extra:u64> <pred:u8>
// Predicates:
//   1 = IS_UNIT     — "is span [a,b) a unit?"           (extra ignored)
//   2 = UNIT_AT     — "does unit #extra span exactly [a,b)?" (a student guess)
//   3 = BOUNDARY_AT — "is offset a a unit boundary?"    (b/extra ignored)
// Per-slice query budget K: default 32; brackets {16, 32, 64} per the test-both
// law. K is far below exhaustive querying: verifying all units via IS_UNIT
// alone needs O(stim_len^2) span queries (~8.5k on the demo slice); K=32 is
// ~0.4% of that space. Query-budget exhaustion -> further queries are REFUSED
// and logged (QUERY_REFUSED, reason 1). Malformed queries are refused
// (reason 2) and do NOT consume budget. seq must be strictly increasing.
// Deterministic answer function against the slice ground truth.
// Usage:
//   arm5 answer <gt_file> <query_file> <tape_out> [budget]
//   arm5 test
@import("tape345.zag")
fn a5_chk(name:[]u8,actual:i32,expected:i32,f:*i32)void {
    _zag_print("T345_TEST,");_zag_print(name);_zag_print(",");
    _zag_print(_zag_i64_to_str(actual as i64));_zag_print(",");_zag_println(_zag_i64_to_str(expected as i64));
    if(actual!=expected){f[0]=f[0]+1;}
}

// answer a query; sets *ok=1 and returns bit on success, *ok=0 if malformed.
fn a5_answer(g:*GT,a:i64,b:i64,extra:i64,pred:i32,ok:*i32)i32 {
    let sl:i64=g[0].stim.len as i64;
    ok[0]=0;
    if(pred==1){
        if(a<0 || b<=a || b>sl){return 0;}
        ok[0]=1;
        let i:i32=0;
        while(i<g[0].n){if(gt_start(g,i)==a && gt_end(g,i)==b){return 1;}i=i+1;}
        return 0;
    } else if(pred==2){
        if(a<0 || b<=a || b>sl || extra<0 || extra>=g[0].n){return 0;}
        ok[0]=1;
        let ui:i32=extra as i32;
        if(gt_start(g,ui)==a && gt_end(g,ui)==b){return 1;}
        return 0;
    } else if(pred==3){
        if(a<0 || a>sl){return 0;}
        ok[0]=1;
        let i:i32=0;
        while(i<g[0].n){if(gt_start(g,i)==a || gt_end(g,i)==a){return 1;}i=i+1;}
        return 0;
    }
    return 0; // unknown predicate -> malformed
}

fn a5_run(gt_name:[]u8,q_name:[]u8,tape_name:[]u8,budget:i64) i32 {
    let g:*GT=gt_load(gt_name);
    if(g[0].n<0){_zag_println("ARM5: bad ground truth");gt_free(g);return 13;}
    let text:[]u8=t345_read_file(q_name,1048576);
    if(text.len==0){_zag_println("ARM5: cannot read queries");gt_free(g);return 13;}
    let t:*Tape=tape_open();
    let pr:[]u8=nio_alloc(32);
    let e:*TBuf=ev_header(1,5,pr,"arm5-symbolic-yesno");
    tape_event(t,1,tbuf_bytes(e));tbuf_free(e);
    e=ev_stimulus(1,0,g[0].stim.len as i64);
    tape_event(t,2,tbuf_bytes(e));tbuf_free(e);
    nio_free(pr);
    let used:i64=0;let last_seq:i64=-1;
    let n_ans:i64=0;let n_ref:i64=0;
    let i:i32=0;
    while(i<text.len){
        let j:i32=i;while(j<text.len && text[j]!=10){j=j+1;}
        let line:[]u8=text[i..j];i=j+1;
        if(line.len==0 || line[0]==35){continue;}
        let pos:i32=0;
        // tokenize inline
        let ntok:i32=0;let toks:[]u8=nio_alloc(64);
        let p2:i32=0;
        while(p2<line.len && ntok<8){
            while(p2<line.len && (line[p2]==32 || line[p2]==9)){p2=p2+1;}
            let q3:i32=p2;
            while(q3<line.len && line[q3]!=32 && line[q3]!=9){q3=q3+1;}
            if(q3>p2){let v:i64=-1;t345_parse_u64(line[p2..q3],&v);t345_set64(toks,ntok*8,v);ntok=ntok+1;}
            p2=q3+1;
            if(q3>=p2-1 && p2>line.len){break;}
        }
        let head_ok:i32=0;
        if(line.len>=1 && line[0]==81 && ntok==6){head_ok=1;} // 'Q' + 5 fields
        if(head_ok==0){nio_free(toks);_zag_println("ARM5: bad query line");continue;}
        let seq:i64=t345_get64(toks,8);let a:i64=t345_get64(toks,16);let b:i64=t345_get64(toks,24);let extra:i64=t345_get64(toks,32);let pred:i32=t345_get64(toks,40) as i32;
        nio_free(toks);
        if(seq<=last_seq){
            let r:*TBuf=ev_query_refused(seq,2);
            tape_event(t,11,tbuf_bytes(r));tbuf_free(r);
            n_ref=n_ref+1;
            _zag_print("ARM5: query ");_zag_print(_zag_i64_to_str(seq));_zag_println(" REFUSED (non-increasing seq)");
            continue;
        }
        last_seq=seq;
        let ok:i32=0;
        let bit:i32=a5_answer(g,a,b,extra,pred,&ok);
        if(ok==0){
            let r:*TBuf=ev_query_refused(seq,2);
            tape_event(t,11,tbuf_bytes(r));tbuf_free(r);
            n_ref=n_ref+1;
            _zag_print("ARM5: query ");_zag_print(_zag_i64_to_str(seq));_zag_println(" REFUSED (malformed)");
            continue;
        }
        if(used>=budget){
            let r:*TBuf=ev_query_refused(seq,1);
            tape_event(t,11,tbuf_bytes(r));tbuf_free(r);
            n_ref=n_ref+1;
            _zag_print("ARM5: query ");_zag_print(_zag_i64_to_str(seq));_zag_println(" REFUSED (budget exhausted)");
            continue;
        }
        used=used+1;
        let qe:*TBuf=ev_query(seq,a,b,extra,pred);
        tape_event(t,10,tbuf_bytes(qe));tbuf_free(qe);
        let ae:*TBuf=ev_oracle_answer(seq,bit);
        tape_event(t,4,tbuf_bytes(ae));tbuf_free(ae);
        n_ans=n_ans+1;
    }
    let f:*TBuf=ev_footer(t[0].count,t[0].chain,"OK");
    tape_event(t,9,tbuf_bytes(f));tbuf_free(f);
    let wrc:i32=tape_write_file(t,tape_name);
    _zag_print("ARM5: answered=");_zag_print(_zag_i64_to_str(n_ans));
    _zag_print(" refused=");_zag_print(_zag_i64_to_str(n_ref));
    _zag_print(" events=");_zag_print(_zag_i64_to_str(t[0].count));
    _zag_print(" chain=");_zag_println(ns_hex(t[0].chain));
    gt_free(g);tape_close(t);
    if(wrc!=0){_zag_println("ARM5: tape write failed");return 13;}
    return 0;
}

// budget enforcement: K=2, drive 4 valid queries through the run path
fn a5_t_budget(g:*GT,s0:i64,e0:i64,f:*i32)void {
    let t:*Tape=tape_open();
    let used:i64=0;let budget:i64=2;let refused:i32=0;let answered:i32=0;
    let qi:i32=0;let ok:i32=0;
    while(qi<4){
        ok=0;
        let bit:i32=a5_answer(g,s0,e0,0,1,&ok);
        if(ok==1 && used<budget){used=used+1;answered=answered+1;
            let ae:*TBuf=ev_oracle_answer(qi as i64,bit);
            tape_event(t,4,tbuf_bytes(ae));tbuf_free(ae);
        } else {refused=refused+1;
            let r:*TBuf=ev_query_refused(qi as i64,1);
            tape_event(t,11,tbuf_bytes(r));tbuf_free(r);
        }
        qi=qi+1;
    }
    a5_chk("a5.budget.answered",answered,2,f);
    a5_chk("a5.budget.refused",refused,2,f);
    tape_close(t);
}

fn arm5_test() i32 {
    let f:i32=0;
    let g:*GT=gt_load("gt_demo.txt");
    a5_chk("a5.gt.loads",((g[0].n>0) as i32),1,&f);
    let ok:i32=0;
    // IS_UNIT: true on unit 0, false on a shifted span
    let s0:i64=gt_start(g,0);let e0:i64=gt_end(g,0);
    a5_chk("a5.is_unit.true",a5_answer(g,s0,e0,0,1,&ok),1,&f);
    a5_chk("a5.is_unit.ok",ok,1,&f);
    a5_chk("a5.is_unit.false",a5_answer(g,s0+1,e0,0,1,&ok),0,&f);
    // UNIT_AT: true with correct index, false with wrong index
    a5_chk("a5.unit_at.true",a5_answer(g,s0,e0,0,2,&ok),1,&f);
    a5_chk("a5.unit_at.wrongidx",a5_answer(g,s0,e0,1,2,&ok),0,&f);
    a5_chk("a5.unit_at.badidx_ok",a5_answer(g,s0,e0,g[0].n+5,2,&ok),0,&f);
    a5_chk("a5.unit_at.badidx_malformed",ok,0,&f);
    // BOUNDARY_AT: true at a unit start, false mid-span
    a5_chk("a5.boundary.true",a5_answer(g,s0,0,0,3,&ok),1,&f);
    a5_chk("a5.boundary.false",a5_answer(g,s0+1,0,0,3,&ok),0,&f);
    // determinism: same query twice -> same bit
    let b1:i32=a5_answer(g,s0,e0,0,1,&ok);
    let b2:i32=a5_answer(g,s0,e0,0,1,&ok);
    a5_chk("a5.answer.deterministic",b1,b2,&f);
    a5_t_budget(g,s0,e0,&f);
    gt_free(g);
    _zag_print("T345_FAILURES,");_zag_println(_zag_i64_to_str(f as i64));
    if(f!=0){return 1;}return 0;
}

fn main()i32 {
    if(_zag_argc()<2){_zag_println("usage: arm5 <answer|test> [gt queries tape [budget]]");return 64;}
    let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"test")==1){return arm5_test();}
    if(_zag_strcmp(mode,"answer")==1 && (_zag_argc()==5 || _zag_argc()==6)){
        let budget:i64=32;
        if(_zag_argc()==6){let v:i64=-1;t345_parse_u64(_zag_arg(5),&v);if(v>0 && v<1000000){budget=v;}}
        return a5_run(_zag_arg(2),_zag_arg(3),_zag_arg(4),budget);
    }
    _zag_println("usage: arm5 <answer|test> [gt queries tape [budget]]");return 64;
}

// arm3.zag — Arm 3 (muse-live) session driver.
// Muse (the parent agent) teaches live during sessions. This binary does NOT
// implement an AI teacher: it is the session driver. It accepts §P proposals
// (live from the parent, or from a canned script in dry-run mode), validates
// every proposal against the §P iron rules + the §C tripwire in real time,
// logs TEACHER_MSG events to the tape with logical ticks only, and on any
// violation logs an INTEGRITY event and halts.
// Bounds (T-7, frozen): obeys §P + §C exactly; NO flaw manifest (natural
// teaching only).
// Usage:
//   arm3 dryrun <script> <tape_out>   -- canned proposal script (harness testing)
//   arm3 live   <script> <tape_out>   -- parent-fed proposal file (live sessions)
//   arm3 test                         -- self-tests (codec, iron rules, tripwire)
// The live teaching sessions themselves happen with the parent later; this
// driver is the machine-readable half of that interface.
// Script grammar (ASCII, one directive per line; '#' comments, blanks skipped):
//   SESSION <session_id:u64> <stim_len:u64>
//   P    <teacher_id:u32> <seq:u64> <kind:u8> <span_start:u64> <span_end:u64> <confidence:u8>
//   PAUX <teacher_id:u32> <seq:u64> <kind:u8> <ss:u64> <se:u64> <conf:u8>
//        <naux:u8> (<s:u64> <e:u64>)* <nground:u8> (<s:u64> <e:u64>)*
//   RAW <hex>                       -- verbatim proposal bytes (malformed-injection tests)
//   D <proposal_seq:u64> <ADOPT|REVISE|REJECT|DEFER> [reason:u16] [rev_start:u64] [rev_end:u64]
//        -- student decision records, supplied by the harness/student side;
//           logged as STUDENT_DECISION events and fed to the §C tripwire.
//   TURN <n:u64>
//   END
// RETRACT (kind=5) convention: span_start carries the withdrawn proposal's seq,
// span_end = span_start+1 (fixture convention, documented in OPERATIONALIZATION.md).
// Exit codes: 0 clean END; 1..10 iron-rule violation (see sp345 V_* codes);
// 11 §C tripwire fired; 12 incomplete (no END); 13 script/IO error.
@import("sp345.zag")

fn a3_next_tok(line:[]u8,pos:*i32)[]u8 {
    let i:i32=pos[0];
    while(i<line.len && (line[i]==32 || line[i]==9)){i=i+1;}
    let j:i32=i;
    while(j<line.len && line[j]!=32 && line[j]!=9){j=j+1;}
    pos[0]=j;
    return line[i..j];
}
fn a3_u64(tok:[]u8,ok:*i32)i64 {
    let v:i64=-1;t345_parse_u64(tok,&v);
    if(v<0){ok[0]=0;}return v;
}
fn a3_verdict(tok:[]u8) i32 {
    if(_zag_strcmp(tok,"ADOPT")==1){return 1;}
    if(_zag_strcmp(tok,"REVISE")==1){return 2;}
    if(_zag_strcmp(tok,"REJECT")==1){return 3;}
    if(_zag_strcmp(tok,"DEFER")==1){return 4;}
    return 0;
}

fn a3_halt(t:*Tape,code:i32,c0:i64,c1:i64,c2:i64,c3:i64,c4:i64,c5:i64,c6:i64,c7:i64,why:[]u8) i32 {
    let e:*TBuf=ev_integrity(code,c0,c1,c2,c3,c4,c5,c6,c7);
    tape_event(t,7,tbuf_bytes(e));tbuf_free(e);
    let f:*TBuf=ev_footer(t[0].count,t[0].chain,why);
    tape_event(t,9,tbuf_bytes(f));tbuf_free(f);
    return code;
}

fn a3_run(mode:[]u8,script:[]u8,tape_name:[]u8) i32 {
    let text:[]u8=t345_read_file(script,1048576);
    if(text.len==0){_zag_println("ARM3: cannot read script");return 13;}
    let t:*Tape=tape_open();
    let session_id:i64=-1;let stim_len:i64=-1;
    let tw:*TW=null as *TW;
    let expected:i64=0;let n_prop:i64=0;let saw_end:i32=0;
    let rev_count:i64=0;
    let descr:[]u8="arm3-dryrun";
    if(_zag_strcmp(mode,"live")==1){descr="arm3-live";}
    let pr:[]u8=nio_alloc(32); // prereg hash placeholder (32 zero bytes)
    let i:i32=0;let rc:i32=0;
    while(i<text.len && rc==0){
        let j:i32=i;while(j<text.len && text[j]!=10){j=j+1;}
        let line:[]u8=text[i..j];i=j+1;
        if(line.len==0 || line[0]==35){continue;}
        let pos:i32=0;
        let head:[]u8=a3_next_tok(line,&pos);
        if(_zag_strcmp(head,"SESSION")==1){
            let ok:i32=1;
            session_id=a3_u64(a3_next_tok(line,&pos),&ok);
            stim_len=a3_u64(a3_next_tok(line,&pos),&ok);
            if(ok==0 || session_id<0 || stim_len<1 || stim_len>65536){
                _zag_println("ARM3: bad SESSION line");rc=13;
            } else {
                let e:*TBuf=ev_header(session_id,3,pr,descr);
                tape_event(t,1,tbuf_bytes(e));tbuf_free(e);
                e=ev_stimulus(1,0,stim_len);
                tape_event(t,2,tbuf_bytes(e));tbuf_free(e);
                tw=tw_new(stim_len);
            }
        } else if(_zag_strcmp(head,"P")==1 || _zag_strcmp(head,"PAUX")==1){
            if(session_id<0){_zag_println("ARM3: P before SESSION");rc=13;continue;}
            let ok:i32=1;let is_paux:i32=0;
            if(_zag_strcmp(head,"PAUX")==1){is_paux=1;}
            let p:*Prop=_zag_malloc(128) as *Prop;
            p[0].aux="";p[0].ground="";
            p[0].teacher_id=a3_u64(a3_next_tok(line,&pos),&ok);
            p[0].seq=a3_u64(a3_next_tok(line,&pos),&ok);
            p[0].kind=a3_u64(a3_next_tok(line,&pos),&ok) as i32;
            p[0].session_id=session_id;
            p[0].span_start=a3_u64(a3_next_tok(line,&pos),&ok);
            p[0].span_end=a3_u64(a3_next_tok(line,&pos),&ok);
            p[0].confidence=a3_u64(a3_next_tok(line,&pos),&ok) as i32;
            p[0].aux_count=0;p[0].ground_count=0;
            if(ok==1 && is_paux==1){
                let na:i32=a3_u64(a3_next_tok(line,&pos),&ok) as i32;
                if(ok==1 && (na<0 || na>8)){ok=0;}
                if(ok==1 && na>0){
                    let ab:[]u8=nio_alloc(na*16);let q:i32=0;
                    while(q<na && ok==1){
                        let s:i64=a3_u64(a3_next_tok(line,&pos),&ok);
                        let e2:i64=a3_u64(a3_next_tok(line,&pos),&ok);
                        t345_set64(ab,q*16,s);t345_set64(ab,q*16+8,e2);q=q+1;
                    }
                    p[0].aux=ab;p[0].aux_count=na;
                }
                let ng:i32=a3_u64(a3_next_tok(line,&pos),&ok) as i32;
                if(ok==1 && (ng<0 || ng>8)){ok=0;}
                if(ok==1 && ng>0){
                    let gb:[]u8=nio_alloc(ng*16);let q:i32=0;
                    while(q<ng && ok==1){
                        let s:i64=a3_u64(a3_next_tok(line,&pos),&ok);
                        let e2:i64=a3_u64(a3_next_tok(line,&pos),&ok);
                        t345_set64(gb,q*16,s);t345_set64(gb,q*16+8,e2);q=q+1;
                    }
                    p[0].ground=gb;p[0].ground_count=ng;
                }
            }
            if(ok==0){_zag_println("ARM3: bad P line");sp_free(p);_zag_free(p as *i8);rc=13;continue;}
            let wire:[]u8=sp_encode(p);
            sp_free(p);_zag_free(p as *i8);
            // re-decode through the hostile path (exactly what the student gate sees)
            let q2:*Prop=_zag_malloc(128) as *Prop;
            q2[0].aux="";q2[0].ground="";
            let dc:i32=sp_decode(wire,q2);
            let vc:i32=dc;
            if(vc==0){vc=sp_validate(q2,session_id,expected,stim_len);}
            if(vc!=0){
                nio_free(wire);
                _zag_print("ARM3: IRON-RULE VIOLATION code=");_zag_print(_zag_i64_to_str(vc as i64));_zag_println(" -> INTEGRITY + HALT");
                let d:i64=0;let a:i64=0;let m:i64=0;let w:i64=0;
                tw_window_counts(tw,&d,&a,&m,&w);
                rc=a3_halt(t,1000+vc,n_prop,tw[0].covered_n,stim_len,m,a,d,rev_count,expected,"HALTED:VIOLATION"); rc=vc;
                sp_free(q2);_zag_free(q2 as *i8);
                continue;
            }
            tape_event(t,3,wire); // TEACHER_MSG: §P bytes verbatim
            let fc:i32=tw_propose(tw,q2[0].span_start,q2[0].span_end,q2[0].confidence);
            nio_free(wire);sp_free(q2);_zag_free(q2 as *i8);
            if(fc!=0){
                _zag_print("ARM3: TRIPWIRE FIRED code=");_zag_print(_zag_i64_to_str(fc as i64));_zag_println(" -> INTEGRITY + HALT");
                let d:i64=0;let a:i64=0;let m:i64=0;let w:i64=0;
                tw_window_counts(tw,&d,&a,&m,&w);
                rc=a3_halt(t,fc,n_prop,tw[0].covered_n,stim_len,m,a,d,rev_count,expected,"HALTED:TRIPWIRE"); rc=11;
                continue;
            }
            n_prop=n_prop+1;expected=expected+1;
        } else if(_zag_strcmp(head,"RAW")==1){
            if(session_id<0){_zag_println("ARM3: RAW before SESSION");rc=13;continue;}
            let hex:[]u8=a3_next_tok(line,&pos);
            let wire:[]u8=nio_alloc(hex.len/2+1);
            let wl:i32=t345_hexparse(hex,wire);
            let vc:i32=13;
            if(wl>0){
                let q2:*Prop=_zag_malloc(128) as *Prop;
                q2[0].aux="";q2[0].ground="";
                let dc:i32=sp_decode(wire[0..wl],q2);
                vc=dc;
                if(vc==0){vc=sp_validate(q2,session_id,expected,stim_len);}
                if(vc==0){
                    tape_event(t,3,wire[0..wl]);
                    let fc2:i32=tw_propose(tw,q2[0].span_start,q2[0].span_end,q2[0].confidence);
                    if(fc2!=0){
                        _zag_print("ARM3: TRIPWIRE FIRED code=");_zag_print(_zag_i64_to_str(fc2 as i64));_zag_println(" -> INTEGRITY + HALT");
                        let d:i64=0;let a:i64=0;let m:i64=0;let w:i64=0;
                        tw_window_counts(tw,&d,&a,&m,&w);
                        rc=a3_halt(t,fc2,n_prop,tw[0].covered_n,stim_len,m,a,d,rev_count,expected,"HALTED:TRIPWIRE"); rc=11;
                    }
                    n_prop=n_prop+1;expected=expected+1;
                }
                sp_free(q2);_zag_free(q2 as *i8);
            }
            nio_free(wire);
            if(vc!=0 && rc==0){
                _zag_print("ARM3: IRON-RULE VIOLATION code=");_zag_print(_zag_i64_to_str(vc as i64));_zag_println(" -> INTEGRITY + HALT");
                let d:i64=0;let a:i64=0;let m:i64=0;let w:i64=0;
                tw_window_counts(tw,&d,&a,&m,&w);
                rc=a3_halt(t,1000+vc,n_prop,tw[0].covered_n,stim_len,m,a,d,rev_count,expected,"HALTED:VIOLATION"); rc=vc;
            }
        } else if(_zag_strcmp(head,"D")==1){
            if(session_id<0){_zag_println("ARM3: D before SESSION");rc=13;continue;}
            let ok:i32=1;
            let pseq:i64=a3_u64(a3_next_tok(line,&pos),&ok);
            let vd:i32=a3_verdict(a3_next_tok(line,&pos));
            let reason:i32=0;let rs:i64=0;let re:i64=0;
            let t3:[]u8=a3_next_tok(line,&pos);
            if(t3.len>0){
                reason=a3_u64(t3,&ok) as i32;
                let t4:[]u8=a3_next_tok(line,&pos);
                if(t4.len>0){
                    rs=a3_u64(t4,&ok);
                    re=a3_u64(a3_next_tok(line,&pos),&ok);
                }
            }
            if(ok==0 || vd==0){_zag_println("ARM3: bad D line");rc=13;continue;}
            tw_decide(tw,pseq,vd);
            if(vd==2){rev_count=rev_count+1;}
            let e:*TBuf=ev_decision(pseq,vd,reason,rs,re,0);
            tape_event(t,12,tbuf_bytes(e));tbuf_free(e);
            // a late decision can complete a firing window -> re-check tripwire state
            // (tw_propose already evaluated at proposal time; decisions only tighten)
            let d:i64=0;let a:i64=0;let m:i64=0;let w:i64=0;
            tw_window_counts(tw,&d,&a,&m,&w);
            if(tw[0].fired==0 && stim_len>0 && tw[0].covered_n*100>=stim_len*95
               && d>0 && a*100>=d*95 && w>0 && m*100>=w*90){
                tw[0].fired=1;tw[0].fire_code=1;
                _zag_println("ARM3: TRIPWIRE FIRED code=1 (on decision) -> INTEGRITY + HALT");
                rc=a3_halt(t,1,n_prop,tw[0].covered_n,stim_len,m,a,d,rev_count,expected,"HALTED:TRIPWIRE"); rc=11;
            }
        } else if(_zag_strcmp(head,"TURN")==1){
            let ok:i32=1;let tn:i64=a3_u64(a3_next_tok(line,&pos),&ok);
            if(ok==0){_zag_println("ARM3: bad TURN line");rc=13;continue;}
            let e:*TBuf=ev_turn(tn);
            tape_event(t,8,tbuf_bytes(e));tbuf_free(e);
        } else if(_zag_strcmp(head,"END")==1){
            saw_end=1;
        } else {
            _zag_print("ARM3: unknown directive: ");_zag_println(head);rc=13;
        }
    }
    nio_free(pr);
    if(rc==0){
        if(saw_end==0){rc=a3_halt(t,1012,n_prop,0,stim_len,0,0,0,rev_count,expected,"HALTED:INCOMPLETE");}
        else{
            let f:*TBuf=ev_footer(t[0].count,t[0].chain,"OK");
            tape_event(t,9,tbuf_bytes(f));tbuf_free(f);
        }
    }
    if(tape_write_file(t,tape_name)!=0){_zag_println("ARM3: tape write failed");rc=13;}
    _zag_print("ARM3: proposals=");_zag_print(_zag_i64_to_str(n_prop));
    _zag_print(" events=");_zag_print(_zag_i64_to_str(t[0].count));
    _zag_print(" chain=");_zag_println(ns_hex(t[0].chain));
    if(tw!=null as *TW){tw_free(tw);}
    tape_close(t);
    return rc;
}

fn a3_chk(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("T345_TEST,");_zag_print(name);_zag_print(",");
    _zag_print(_zag_i64_to_str(actual as i64));_zag_print(",");_zag_println(_zag_i64_to_str(expected as i64));
    if(actual!=expected){return 1;}return 0;
}

fn a3_t_roundtrip(f:*i32)void {
    let p:*Prop=_zag_malloc(128) as *Prop;
    p[0].teacher_id=3;p[0].session_id=77;p[0].seq=5;p[0].kind=1;
    p[0].span_start=10;p[0].span_end=20;p[0].confidence=200;
    p[0].aux_count=1;p[0].ground_count=2;
    p[0].aux=nio_alloc(16);t345_set64(p[0].aux,0,1);t345_set64(p[0].aux,8,2);
    p[0].ground=nio_alloc(32);t345_set64(p[0].ground,0,3);t345_set64(p[0].ground,8,4);
    t345_set64(p[0].ground,16,5);t345_set64(p[0].ground,24,6);
    let wire:[]u8=sp_encode(p);
    let q:*Prop=_zag_malloc(128) as *Prop;
    q[0].aux="";q[0].ground="";
    f[0]=f[0]+a3_chk("a3.roundtrip.decode",sp_decode(wire,q),0);
    f[0]=f[0]+a3_chk("a3.roundtrip.validate",sp_validate(q,77,5,100),0);
    f[0]=f[0]+a3_chk("a3.roundtrip.span",((q[0].span_start==10 && q[0].span_end==20) as i32),1);
    f[0]=f[0]+a3_chk("a3.roundtrip.aux0",t345_get64(q[0].aux,0) as i32,1);
    f[0]=f[0]+a3_chk("a3.roundtrip.g1e",t345_get64(q[0].ground,24) as i32,6);
    nio_free(wire);sp_free(p);sp_free(q);
    _zag_free(p as *i8);_zag_free(q as *i8);
}
fn a3_t_tamper(f:*i32)void {
    let p:*Prop=_zag_malloc(128) as *Prop;
    p[0].teacher_id=3;p[0].session_id=1;p[0].seq=0;p[0].kind=1;
    p[0].span_start=0;p[0].span_end=4;p[0].confidence=100;
    p[0].aux_count=0;p[0].ground_count=0;p[0].aux="";p[0].ground="";
    let wire:[]u8=sp_encode(p);
    wire[30]=wire[30]^1;
    let q:*Prop=_zag_malloc(128) as *Prop;
    q[0].aux="";q[0].ground="";
    f[0]=f[0]+a3_chk("a3.tamper.checksum",sp_decode(wire,q),V_CHECKSUM());
    nio_free(wire);sp_free(q);_zag_free(p as *i8);_zag_free(q as *i8);
}
fn a3_t_iron(f:*i32)void {
    let p:*Prop=_zag_malloc(128) as *Prop;
    p[0].teacher_id=3;p[0].session_id=9;p[0].seq=0;p[0].kind=1;
    p[0].span_start=2;p[0].span_end=8;p[0].confidence=50;
    p[0].aux_count=0;p[0].ground_count=0;p[0].aux="";p[0].ground="";
    f[0]=f[0]+a3_chk("a3.iron.seq_gap",sp_validate(p,9,3,100),V_SEQ());
    p[0].teacher_id=1;
    f[0]=f[0]+a3_chk("a3.iron.teacher1",sp_validate(p,9,0,100),V_BAD_TEACHER());
    p[0].teacher_id=2;
    f[0]=f[0]+a3_chk("a3.iron.teacher2",sp_validate(p,9,0,100),V_BAD_TEACHER());
    p[0].teacher_id=3;p[0].kind=9;
    f[0]=f[0]+a3_chk("a3.iron.kind",sp_validate(p,9,0,100),V_KIND());
    p[0].kind=1;p[0].span_end=200;
    f[0]=f[0]+a3_chk("a3.iron.range",sp_validate(p,9,0,100),V_RANGE());
    p[0].span_end=8;
    let bad:[]u8=nio_alloc(sp_wire_len(0,0));
    t345_set32(bad,0,0xDEADBEEF);
    let q:*Prop=_zag_malloc(128) as *Prop;
    q[0].aux="";q[0].ground="";
    f[0]=f[0]+a3_chk("a3.iron.badmagic",sp_decode(bad,q),V_BAD_MAGIC());
    nio_free(bad);
    let big:[]u8=nio_alloc(220);
    t345_set32(big,0,0x54505250);t345_set16(big,4,1);big[43]=9;
    f[0]=f[0]+a3_chk("a3.iron.counts",sp_decode(big,q),V_COUNTS());
    nio_free(big);
    sp_free(q);_zag_free(p as *i8);_zag_free(q as *i8);
}
fn a3_t_tw_window(f:*i32)void {
    let tw:*TW=tw_new(1000);
    let k:i64=0;
    while(k<200){
        tw_propose(tw,k*5,k*5+5,255);
        tw_decide(tw,k,1);
        k=k+1;
    }
    let d:i64=0;let a:i64=0;let m:i64=0;let w:i64=0;
    tw_window_counts(tw,&d,&a,&m,&w);
    let cond:i32=0;
    if(tw[0].covered_n*100>=1000*95 && d>0 && a*100>=d*95 && w>0 && m*100>=w*90){cond=1;}
    f[0]=f[0]+a3_chk("a3.tripwire.window_fires",cond,1);
    f[0]=f[0]+a3_chk("a3.tripwire.halt_at_950",tw[0].covered_n as i32,950);
    f[0]=f[0]+a3_chk("a3.tripwire.fired_flag",tw[0].fired,1);
    f[0]=f[0]+a3_chk("a3.tripwire.fire_code",tw[0].fire_code,1);
    tw_free(tw);
}
fn a3_t_tw_dump(f:*i32)void {
    let tw:*TW=tw_new(1000);
    f[0]=f[0]+a3_chk("a3.tripwire.dump",tw_propose(tw,0,60,255),2);
    tw_free(tw);
}
fn a3_t_tw_nofire94(f:*i32)void {
    let tw:*TW=tw_new(1000);
    let k:i64=0;let fired:i32=0;
    while(k<188){let fc:i32=tw_propose(tw,k*5,k*5+5,255);if(fc!=0){fired=1;}tw_decide(tw,k,1);k=k+1;}
    f[0]=f[0]+a3_chk("a3.tripwire.nofire_94pct",fired,0);
    tw_free(tw);
}
fn a3_t_tw_nofire_halfrevise(f:*i32)void {
    let tw:*TW=tw_new(1000);
    let k:i64=0;
    while(k<200){tw_propose(tw,k*5,k*5+5,255);
        if(k%2==0){tw_decide(tw,k,1);}else{tw_decide(tw,k,2);}
        k=k+1;}
    let d:i64=0;let a:i64=0;let m:i64=0;let w:i64=0;
    tw_window_counts(tw,&d,&a,&m,&w);
    let cond:i32=0;
    if(tw[0].covered_n*100>=1000*95 && d>0 && a*100>=d*95 && w>0 && m*100>=w*90){cond=1;}
    f[0]=f[0]+a3_chk("a3.tripwire.nofire_halfrevise",cond,0);
    tw_free(tw);
}
fn a3_t_iron2(f:*i32)void {
    // Second iron-rule battery: every remaining violation kind the codec must
    // hard-reject. (First battery lives in a3_t_iron.)
    let p:*Prop=_zag_malloc(128) as *Prop;
    p[0].teacher_id=3;p[0].session_id=9;p[0].seq=0;p[0].kind=1;
    p[0].span_start=2;p[0].span_end=8;p[0].confidence=50;
    p[0].aux_count=0;p[0].ground_count=0;p[0].aux="";p[0].ground="";
    let q:*Prop=_zag_malloc(128) as *Prop;
    q[0].aux="";q[0].ground="";
    // RETRACT kind is a legal kind (fixture span convention: start=target seq)
    p[0].kind=5;p[0].span_start=4;p[0].span_end=5;
    f[0]=f[0]+a3_chk("a3.iron2.retract_ok",sp_validate(p,9,0,100),V_OK());
    p[0].kind=1;p[0].span_start=2;p[0].span_end=8;
    // bad version (version checked before checksum, so no re-checksum needed)
    let w0:[]u8=sp_encode(p);w0[4]=2;
    f[0]=f[0]+a3_chk("a3.iron2.bad_version",sp_decode(w0,q),V_BAD_VERSION());
    nio_free(w0);
    // truncated buffer -> V_LEN (aux=1 wire is 70 bytes; cut to 60: go=60, need 61)
    p[0].aux_count=1;p[0].aux=nio_alloc(16);
    t345_set64(p[0].aux,0,2);t345_set64(p[0].aux,8,6);
    let w1:[]u8=sp_encode(p);
    f[0]=f[0]+a3_chk("a3.iron2.len_trunc",sp_decode(w1[0..60],q),V_LEN());
    nio_free(w1);sp_free(p);p[0].aux="";p[0].aux_count=0;
    // span inversion / equality -> V_SPAN
    p[0].span_start=10;p[0].span_end=5;
    f[0]=f[0]+a3_chk("a3.iron2.span_invert",sp_validate(p,9,0,100),V_SPAN());
    p[0].span_end=10;
    f[0]=f[0]+a3_chk("a3.iron2.span_equal",sp_validate(p,9,0,100),V_SPAN());
    p[0].span_start=2;p[0].span_end=8;
    // confidence 300: unrepresentable on the wire (u8 field), API-level guard
    p[0].confidence=300;
    f[0]=f[0]+a3_chk("a3.iron2.conf_300",sp_validate(p,9,0,100),V_SPAN());
    p[0].confidence=50;
    // duplicate seq (expected 6, got 5) -> V_SEQ
    p[0].seq=5;
    f[0]=f[0]+a3_chk("a3.iron2.seq_dup",sp_validate(p,9,6,100),V_SEQ());
    p[0].seq=0;
    // kinds 0 and 6 -> V_KIND
    p[0].kind=0;
    f[0]=f[0]+a3_chk("a3.iron2.kind0",sp_validate(p,9,0,100),V_KIND());
    p[0].kind=6;
    f[0]=f[0]+a3_chk("a3.iron2.kind6",sp_validate(p,9,0,100),V_KIND());
    p[0].kind=1;
    // teacher ids 0/4/5 rejected here (driver speaks for arm 3 only); session mismatch
    p[0].teacher_id=0;
    f[0]=f[0]+a3_chk("a3.iron2.teacher0",sp_validate(p,9,0,100),V_BAD_TEACHER());
    p[0].teacher_id=4;
    f[0]=f[0]+a3_chk("a3.iron2.teacher4",sp_validate(p,9,0,100),V_BAD_TEACHER());
    p[0].teacher_id=5;
    f[0]=f[0]+a3_chk("a3.iron2.teacher5",sp_validate(p,9,0,100),V_BAD_TEACHER());
    p[0].teacher_id=3;p[0].session_id=10;
    f[0]=f[0]+a3_chk("a3.iron2.sess_mismatch",sp_validate(p,9,0,100),V_BAD_TEACHER());
    p[0].session_id=9;
    // ground_count=9 via crafted buffer (64 bytes >= 54 so we reach the counts check)
    let big:[]u8=nio_alloc(64);
    t345_set32(big,0,0x54505250);t345_set16(big,4,1);big[43]=0;big[44]=9;
    f[0]=f[0]+a3_chk("a3.iron2.counts_ground9",sp_decode(big,q),V_COUNTS());
    nio_free(big);
    // aux / ground span out of stimulus range -> V_RANGE
    p[0].aux_count=1;p[0].aux=nio_alloc(16);
    t345_set64(p[0].aux,0,200);t345_set64(p[0].aux,8,300);
    f[0]=f[0]+a3_chk("a3.iron2.range_aux",sp_validate(p,9,0,100),V_RANGE());
    sp_free(p);p[0].aux="";p[0].aux_count=0;
    p[0].ground_count=1;p[0].ground=nio_alloc(16);
    t345_set64(p[0].ground,0,0);t345_set64(p[0].ground,8,500);
    f[0]=f[0]+a3_chk("a3.iron2.range_ground",sp_validate(p,9,0,100),V_RANGE());
    sp_free(p);p[0].ground="";p[0].ground_count=0;
    // boundary acceptance: span_end == stim_len is legal
    p[0].span_start=95;p[0].span_end=100;
    f[0]=f[0]+a3_chk("a3.iron2.range_edge_ok",sp_validate(p,9,0,100),V_OK());
    sp_free(q);
    _zag_free(p as *i8);_zag_free(q as *i8);
}
fn a3_test() i32 {
    let f:i32=0;
    a3_t_roundtrip(&f);a3_t_tamper(&f);a3_t_iron(&f);a3_t_iron2(&f);
    a3_t_tw_window(&f);a3_t_tw_dump(&f);a3_t_tw_nofire94(&f);a3_t_tw_nofire_halfrevise(&f);
    _zag_print("T345_FAILURES,");_zag_println(_zag_i64_to_str(f as i64));
    if(f!=0){return 1;}return 0;
}

fn main()i32 {
    if(_zag_argc()<2){_zag_println("usage: arm3 <dryrun|live|test> [script tape]");return 64;}
    let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"test")==1){return a3_test();}
    if(_zag_argc()!=4){_zag_println("usage: arm3 <dryrun|live> <script> <tape_out>");return 64;}
    if(_zag_strcmp(mode,"dryrun")!=1 && _zag_strcmp(mode,"live")!=1){
        _zag_println("usage: arm3 <dryrun|live|test> [script tape]");return 64;}
    return a3_run(mode,_zag_arg(2),_zag_arg(3));
}

// sp345.zag — §P proposal wire codec, iron-rule validation, §C tripwire.
// ARM 3 (muse-live) ONLY. Arms 4/5 never import this file (they are incapable
// of emitting §P proposals by construction: the symbols do not exist in their
// compilation units).
// §P layout (B.3, frozen): magic u32=0x54505250, version u16=1, teacher_id u32,
// session_id u64, seq u64, kind u8, span_start u64, span_end u64, aux_count u8,
// aux_count*(u64,u64), ground_count u8, ground_count*(u64,u64), confidence u8,
// checksum u64 (FNV-1a-64 over all preceding bytes). All little-endian.
// teacher_id for this driver: 3 (muse-live). 0 reserved; 2 RESERVED-invalid;
// 1/4/5 rejected here: this driver only speaks for arm 3.
@import("tape345.zag")

// validation codes (exit codes + INTEGRITY 1000+code)
fn V_OK()i32 {return 0;}
fn V_BAD_MAGIC()i32 {return 1;}
fn V_BAD_VERSION()i32 {return 2;}
fn V_BAD_TEACHER()i32 {return 3;}
fn V_SEQ()i32 {return 4;}
fn V_SPAN()i32 {return 5;}
fn V_KIND()i32 {return 6;}
fn V_CHECKSUM()i32 {return 7;}
fn V_RANGE()i32 {return 8;}
fn V_COUNTS()i32 {return 9;}
fn V_LEN()i32 {return 10;}

struct Prop {
    teacher_id:i64,session_id:i64,seq:i64,kind:i32,
    span_start:i64,span_end:i64,confidence:i32,
    aux_count:i32,ground_count:i32,
    aux:[]u8,ground:[]u8 // packed (u64,u64) pairs, 16 bytes each; empty when count 0
}

// expected serialized length for given aux/ground counts
fn sp_wire_len(aux_count:i32,ground_count:i32)i32 {
    return 4+2+4+8+8+1+8+8+1+aux_count*16+1+ground_count*16+1+8;
}

// encode; returns nio_alloc'd buffer (caller frees). aux/ground packed pair slices.
fn sp_encode(p:*Prop)[]u8 {
    let ac:i32=p[0].aux_count;let gc:i32=p[0].ground_count;
    let n:i32=sp_wire_len(ac,gc);
    let b:[]u8=nio_alloc(n);
    t345_set32(b,0,0x54505250);t345_set16(b,4,1);
    t345_set32(b,6,p[0].teacher_id);t345_set64(b,10,p[0].session_id);
    t345_set64(b,18,p[0].seq);b[26]=p[0].kind as u8;
    t345_set64(b,27,p[0].span_start);t345_set64(b,35,p[0].span_end);
    b[43]=ac as u8;
    let i:i32=0;while(i<ac*16){b[44+i]=p[0].aux[i];i=i+1;}
    let go:i32=44+ac*16;b[go]=gc as u8;
    i=0;while(i<gc*16){b[go+1+i]=p[0].ground[i];i=i+1;}
    let co:i32=go+1+gc*16;b[co]=p[0].confidence as u8;
    let chk:i64=t345_fnv(b[0..co+1]);
    t345_set64(b,co+1,chk);
    return b;
}

// decode + structural validation (magic/version/length/checksum/counts).
// Returns code; on V_OK fills *p (aux/ground allocated).
fn sp_decode(buf:[]u8,p:*Prop)i32 {
    if(buf.len<sp_wire_len(0,0)){return V_BAD_MAGIC();}
    if(t345_get32(buf,0)!=0x54505250){return V_BAD_MAGIC();}
    if(t345_get16(buf,4)!=1){return V_BAD_VERSION();}
    let ac:i32=buf[43] as i32;
    if(buf.len<44+1){return V_LEN();}
    let go:i32=44+ac*16;
    if(buf.len<go+1){return V_LEN();}
    let gc:i32=buf[go] as i32;
    if(ac<0 || ac>8 || gc<0 || gc>8){return V_COUNTS();}
    let want:i32=sp_wire_len(ac,gc);
    if(buf.len!=want){return V_LEN();}
    let co:i32=go+1+gc*16;
    if(t345_fnv(buf[0..co+1])!=t345_get64(buf,co+1)){return V_CHECKSUM();}
    p[0].teacher_id=t345_get32(buf,6);p[0].session_id=t345_get64(buf,10);
    p[0].seq=t345_get64(buf,18);p[0].kind=buf[26] as i32;
    p[0].span_start=t345_get64(buf,27);p[0].span_end=t345_get64(buf,35);
    p[0].aux_count=ac;p[0].ground_count=gc;p[0].confidence=buf[co] as i32;
    if(ac>0){let a:[]u8=nio_alloc(ac*16);let i:i32=0;while(i<ac*16){a[i]=buf[44+i];i=i+1;}p[0].aux=a;}else{p[0].aux="";}
    if(gc>0){let g:[]u8=nio_alloc(gc*16);let i:i32=0;while(i<gc*16){g[i]=buf[go+1+i];i=i+1;}p[0].ground=g;}else{p[0].ground="";}
    return V_OK();
}
fn sp_free(p:*Prop)void {if(p[0].aux.len>0){nio_free(p[0].aux);}if(p[0].ground.len>0){nio_free(p[0].ground);}}

// full iron-rule validation of a decoded proposal.
// expected_seq = the session's next expected teacher seq; session_id = harness session;
// stim_len = stimulus byte length.
fn sp_validate(p:*Prop,session_id:i64,expected_seq:i64,stim_len:i64)i32 {
    if(p[0].teacher_id!=3){return V_BAD_TEACHER();}
    if(p[0].session_id!=session_id){return V_BAD_TEACHER();}
    if(p[0].seq!=expected_seq){return V_SEQ();}
    if(p[0].kind<1 || p[0].kind>5){return V_KIND();}
    if(p[0].span_start<0 || p[0].span_end<=p[0].span_start){return V_SPAN();}
    if(p[0].span_end>stim_len){return V_RANGE();}
    if(p[0].confidence<0 || p[0].confidence>255){return V_SPAN();}
    let i:i32=0;
    while(i<p[0].aux_count){
        let s:i64=t345_get64(p[0].aux,i*16);let e:i64=t345_get64(p[0].aux,i*16+8);
        if(s<0 || e<=s || e>stim_len){return V_RANGE();}
        i=i+1;
    }
    i=0;
    while(i<p[0].ground_count){
        let s:i64=t345_get64(p[0].ground,i*16);let e:i64=t345_get64(p[0].ground,i*16+8);
        if(s<0 || e<=s || e>stim_len){return V_RANGE();}
        i=i+1;
    }
    return V_OK();
}

// ---- §C tripwire (computed from the tape alone) ----
// Window of the last 200 proposals. Fire iff in the same window:
//   coverage >= 0.95 AND accept_rate >= 0.95 AND maxconf_rate >= 0.90.
// Secondary: a single proposal with confidence=255 covering >5% of stimulus -> fire.
struct TWS {valid:i32,decided:i32,accept:i32,revise:i32,maxconf:i32}
struct TW {
    slots:[]u8, // 200 * 5 bytes packed TWS
    n:i64,stim_len:i64,covered:[]u8, // bitmap, one byte per stimulus byte
    covered_n:i64,fired:i32,fire_code:i32
}
fn tw_new(stim_len:i64)*TW {
    let p:*TW=_zag_malloc(96) as *TW;
    p[0].slots=nio_alloc(1000);p[0].n=0;p[0].stim_len=stim_len;
    p[0].covered=nio_alloc(stim_len as i32);p[0].covered_n=0;
    p[0].fired=0;p[0].fire_code=0;
    return p;
}
fn tw_get(t:*TW,k:i64,field:i32)i32 {
    let base:i32=((k%200) as i32)*5;
    return t[0].slots[base+field] as i32;
}
fn tw_set(t:*TW,k:i64,field:i32,v:i32)void {
    let base:i32=((k%200) as i32)*5;
    t[0].slots[base+field]=v as u8;
}
fn tw_window_counts(t:*TW,decided:*i64,accept:*i64,maxc:*i64,win:*i64)void {
    let w:i64=t[0].n;if(w>200){w=200;}
    let d:i64=0;let a:i64=0;let m:i64=0;let i:i64=0;
    let first:i64=t[0].n-w;
    while(i<w){let k:i64=first+i;
        d=d+tw_get(t,k,1) as i64;a=a+tw_get(t,k,2) as i64;m=m+tw_get(t,k,4) as i64;i=i+1;}
    decided[0]=d;accept[0]=a;maxc[0]=m;win[0]=w;
}
// record one proposal; returns 0 or fire code (1=window, 2=dump)
fn tw_propose(t:*TW,span_start:i64,span_end:i64,conf:i32) i32 {
    if(t[0].fired==1){return t[0].fire_code;}
    let k:i64=t[0].n;
    tw_set(t,k,0,1);tw_set(t,k,1,0);tw_set(t,k,2,0);tw_set(t,k,3,0);
    if(conf==255){tw_set(t,k,4,1);}else{tw_set(t,k,4,0);}
    // coverage bitmap
    let s:i64=span_start;let e:i64=span_end;
    if(s<0){s=0;}if(e>t[0].stim_len){e=t[0].stim_len;}
    let i:i64=s;
    while(i<e){if(t[0].covered[i as i32]==0){t[0].covered[i as i32]=1;t[0].covered_n=t[0].covered_n+1;}i=i+1;}
    t[0].n=t[0].n+1;
    // secondary tripwire: confidence=255 dump covering >5% of stimulus
    if(conf==255 && (e-s)*100>t[0].stim_len*5){
        t[0].fired=1;t[0].fire_code=2;return 2;
    }
    // primary tripwire over the 200-window
    let d:i64=0;let a:i64=0;let m:i64=0;let w:i64=0;
    tw_window_counts(t,&d,&a,&m,&w);
    if(t[0].stim_len>0 && t[0].covered_n*100>=t[0].stim_len*95
       && d>0 && a*100>=d*95 && w>0 && m*100>=w*90){
        t[0].fired=1;t[0].fire_code=1;return 1;
    }
    return 0;
}
// record a student decision against a proposal seq; seqs are session-absolute.
fn tw_decide(t:*TW,prop_k:i64,verdict:i32)void {
    if(prop_k<0 || prop_k>=t[0].n){return;}
    if(tw_get(t,prop_k,1)==1){return;} // already decided
    tw_set(t,prop_k,1,1);
    if(verdict==1){tw_set(t,prop_k,2,1);}      // ADOPT
    else if(verdict==2){tw_set(t,prop_k,3,1);} // REVISE (non-accept by definition)
    // verdict 3 REJECT / 4 DEFER: decided, non-accept
}
fn tw_free(t:*TW)void {nio_free(t[0].slots);nio_free(t[0].covered);_zag_free(t as *i8);}

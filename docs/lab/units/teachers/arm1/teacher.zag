// teacher.zag — Arm-1 hand-wired teacher (parent-wired 2026-09-21).
//
// Implements WIRING_SPEC.md §5 PROPOSE in pure Zag. Pure function of
// (spec tables, slice bytes, session_id). No RNG, no wallclock, no learning.
//
// CLI: teacher <slice_idx 0-7> <session_id u64> <wired_dir>
// Reads: <wired_dir>/slice_S{idx}.bin, <wired_dir>/vocab.bin, <wired_dir>/flaws.bin
// Writes: concatenated §P WORD_SPAN proposals to stdout (fd 1); diagnostics to fd 2.
//
// Tables: vocab.bin entries are in chunk_id order (spec §5). flaws.bin carries
// the flaw EMISSION script only (spans/grounds/confidence); it contains no flaw
// labels and no expected behaviors — those live solely in the sealed manifest,
// which the teacher never reads.
//
// NOTE (ZNC-2026-09-21-007): znc miscompiles indexed access on `as []i32`
// slices when several same-size casts are allocated consecutively (2nd+
// array's indices 0..2 alias the previous array's slots 9..11). This file
// therefore uses ONLY []u8 arenas with explicit little-endian accessors for
// every integer table. No `as []i32` / `as []i64` anywhere.

@import("../harness/substrate/R33_NATIVE_IO_V1.zag")

// ---------------- little-endian helpers ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
// i32-table accessors over []u8 arenas (idx = element index, stride 4).
fn t_iget(b:[]u8, idx:i32) i32 {
    return t_get32(b, idx*4) as i32;
}
fn t_iset(b:[]u8, idx:i32, v:i32) void {
    t_put32(b, idx*4, v as i64);
}

// ---------------- FNV-1a-64 (same function the battery/harness codecs use) ----------------
fn t_fnv1a(b:[]u8, n:i32) i64 {
    let h:i64 = -3750763034362895579;
    let i:i32 = 0;
    while(i < n) {
        h = h ^ ((b[i] as i64) & 255);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}

// ---------------- small utilities ----------------
fn t_parse_u64(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < s.len) {
        let c:i32 = s[i] as i32;
        if(c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
        i = i + 1;
    }
    return v;
}
fn t_is_word_byte(b:u8) i32 {
    let c:i32 = b as i32;
    if(c >= 48 && c <= 57) { return 1; }
    if(c >= 65 && c <= 90) { return 1; }
    if(c >= 97 && c <= 122) { return 1; }
    if(c == 95) { return 1; }
    return 0;
}
fn t_conf(j:i32, g:i32) i32 {
    let aj:i32 = j;
    if(aj < 0) { aj = 0 - aj; }
    let c:i32 = 64 + aj / 8 + 12 * g;
    if(c < 0) { c = 0; }
    if(c > 250) { c = 250; }
    return c;
}
// overlap(a,b) vs (fs,fe): touching at an edge is NOT overlap (spec §5).
fn t_overlap(a:i32, b:i32, fs:i32, fe:i32) i32 {
    if(b <= fs || a >= fe) { return 0; }
    return 1;
}

// ---------------- MATCH: first up-to-4 rule-respecting occurrence starts ----------------
// rule: 0=WORD, 1=SUFFIX, 2=PREFIX. (LITERAL entries have J<=0 and are never scanned.)
// out is a []u8 arena; occurrence starts are stored via t_iset.
fn t_match4(s:[]u8, pat:[]u8, rule:i32, out:[]u8) i32 {
    let n:i32 = 0;
    let st:i32 = 0;
    let slen:i32 = s.len;
    let plen:i32 = pat.len;
    while(st + plen <= slen && n < 4) {
        let i:i32 = st;
        let found:i32 = -1;
        while(i + plen <= slen) {
            let k:i32 = 0;
            while(k < plen && s[i+k] == pat[k]) { k = k + 1; }
            if(k == plen) { found = i; break; }
            i = i + 1;
        }
        if(found < 0) { break; }
        let ok:i32 = 1;
        if(rule == 0) {
            if(found > 0 && t_is_word_byte(s[found-1]) == 1) { ok = 0; }
            if(found + plen < slen && t_is_word_byte(s[found+plen]) == 1) { ok = 0; }
        } else if(rule == 1) {
            if(found == 0 || t_is_word_byte(s[found-1]) == 0) { ok = 0; }
            if(found + plen < slen && t_is_word_byte(s[found+plen]) == 1) { ok = 0; }
        } else if(rule == 2) {
            if(found > 0 && t_is_word_byte(s[found-1]) == 1) { ok = 0; }
            if(found + plen >= slen || t_is_word_byte(s[found+plen]) == 0) { ok = 0; }
        }
        if(ok == 1) { t_iset(out, n, found); n = n + 1; }
        st = found + 1;
    }
    return n;
}

// ---------------- proposal emission ----------------
// Builds one WORD_SPAN §P proposal into prop (must be >= 128 bytes).
// Returns total bytes. Field layout frozen per battery/tb_proposal.zag.
// gs is a []u8 arena holding ng*2 i32 span endpoints.
fn t_emit(prop:[]u8, session_id:i64, seq:i64, ss:i64, se:i64,
          gs:[]u8, ng:i32, confidence:i32) i32 {
    t_put32(prop, 0, 1414550096);
    t_put16(prop, 4, 1);
    t_put32(prop, 6, 1);
    t_put64(prop, 10, session_id);
    t_put64(prop, 18, seq);
    prop[26] = 1;
    t_put64(prop, 27, ss);
    t_put64(prop, 35, se);
    prop[43] = 0;
    prop[44] = (ng & 255) as u8;
    let i:i32 = 0;
    while(i < ng) {
        t_put64(prop, 45 + i*16, t_iget(gs, i*2) as i64);
        t_put64(prop, 45 + i*16 + 8, t_iget(gs, i*2+1) as i64);
        i = i + 1;
    }
    let coff:i32 = 45 + ng*16;
    prop[coff] = (confidence & 255) as u8;
    let ck:i64 = t_fnv1a(prop, coff + 1);
    t_put64(prop, coff + 1, ck);
    return coff + 1 + 8;
}

fn t_die(msg:[]u8) i32 {
    nio_write_all(2, msg);
    return 1;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    if(a1.len == 0 || a2.len == 0 || a3.len == 0) {
        return t_die("usage: teacher <slice_idx 0-7> <session_id> <wired_dir>\n");
    }
    let slice_idx:i64 = t_parse_u64(a1);
    if(slice_idx < 0 || slice_idx > 7) { return t_die("bad slice_idx\n"); }
    let session_id:i64 = t_parse_u64(a2);

    let root:i64 = nio_open_root(a3);
    if(root < 0) { return t_die("cannot open wired_dir\n"); }

    // ---- read slice bytes ----
    let sname:[]u8 = nio_alloc(16);
    sname[0] = 115; sname[1] = 108; sname[2] = 105; sname[3] = 99; sname[4] = 101;
    sname[5] = 95; sname[6] = 83; sname[7] = (48 + slice_idx) as u8;
    sname[8] = 46; sname[9] = 98; sname[10] = 105; sname[11] = 110;
    let sn:[]u8 = sname[0..12];
    if(nio_name_valid(sn) != 1) { return t_die("bad slice name\n"); }
    let sfd:i64 = nio_open_child(root, sn, 0);
    if(sfd < 0) { return t_die("cannot open slice file\n"); }
    let slice:[]u8 = nio_alloc(65536);
    let srd:i64 = nio_read_exact(sfd, slice, 65536);
    nio_close(sfd);
    if(srd != 65536) { return t_die("short slice read\n"); }

    // ---- read + parse vocab.bin (entries in chunk_id order) ----
    let vfd:i64 = nio_open_child(root, "vocab.bin", 0);
    if(vfd < 0) { return t_die("cannot open vocab.bin\n"); }
    let vraw:[]u8 = nio_alloc(8192);
    let vrd:i64 = nio_read_exact(vfd, vraw, 8192);
    nio_close(vfd);
    if(vrd <= 0) { return t_die("short vocab read\n"); }
    let vn:i32 = t_get32(vraw, 0) as i32;
    if(vn < 1 || vn > 128) { return t_die("bad vocab count\n"); }
    let v_rule:[]u8 = nio_alloc(128);
    let v_judg:[]u8 = nio_alloc(128*4);
    let v_plen:[]u8 = nio_alloc(128*4);
    let v_poff:[]u8 = nio_alloc(128*4);
    let v_dom:[]u8 = nio_alloc(128);
    let v_pat:[]u8 = nio_alloc(4096);
    let voff:i32 = 4;
    let poff:i32 = 0;
    let vi:i32 = 0;
    while(vi < vn) {
        let rule:i32 = vraw[voff] as i32;
        let judg:i32 = t_get32(vraw, voff+1) as i32;
        let plen:i32 = t_get16(vraw, voff+5) as i32;
        if(plen < 1 || plen > 64 || poff + plen > 4096) { return t_die("bad pattern\n"); }
        let k:i32 = 0;
        while(k < plen) { v_pat[poff+k] = vraw[voff+7+k]; k = k + 1; }
        v_rule[vi] = (rule & 255) as u8;
        t_iset(v_judg, vi, judg);
        t_iset(v_plen, vi, plen);
        t_iset(v_poff, vi, poff);
        // domain from chunk_id[3] ('P'/'C'/'N'); chunk_id sits right after the pattern.
        // Prose slices (S0-S3) teach P/N entries; code slices (S4-S7) teach C entries.
        // A code keyword coincidentally present in prose text is not the code unit.
        v_dom[vi] = vraw[voff+7+plen+3];
        poff = poff + plen;
        voff = voff + 7 + plen + 8;
        vi = vi + 1;
    }

    // ---- read + parse flaws.bin; select this slice's flaws ----
    let ffd:i64 = nio_open_child(root, "flaws.bin", 0);
    if(ffd < 0) { return t_die("cannot open flaws.bin\n"); }
    let fraw:[]u8 = nio_alloc(16384);
    let frd:i64 = nio_read_exact(ffd, fraw, 16384);
    nio_close(ffd);
    if(frd <= 0) { return t_die("short flaws read\n"); }
    let nsl:i32 = t_get32(fraw, 0) as i32;
    let foff:i32 = 4;
    let f_ss:[]u8 = nio_alloc(16*4);
    let f_se:[]u8 = nio_alloc(16*4);
    let f_ng:[]u8 = nio_alloc(16*4);
    let f_conf:[]u8 = nio_alloc(16*4);
    let f_gs:[]u8 = nio_alloc(16*8*4);
    let nf:i32 = 0;
    let si:i32 = 0;
    while(si < nsl) {
        let sidx:i32 = t_get32(fraw, foff) as i32;
        let nfs:i32 = t_get32(fraw, foff+4) as i32;
        foff = foff + 8;
        let fi:i32 = 0;
        while(fi < nfs) {
            let ng:i32 = fraw[foff+2] as i32;
            if(sidx == slice_idx as i32) {
                if(nf >= 16 || ng < 0 || ng > 4) { return t_die("bad flaw table\n"); }
                t_iset(f_ss, nf, t_get64(fraw, foff+4) as i32);
                t_iset(f_se, nf, t_get64(fraw, foff+12) as i32);
                t_iset(f_ng, nf, ng);
                t_iset(f_conf, nf, fraw[foff+1] as i32);
                let g:i32 = 0;
                while(g < ng) {
                    t_iset(f_gs, nf*8+g*2, t_get64(fraw, foff+20+g*16) as i32);
                    t_iset(f_gs, nf*8+g*2+1, t_get64(fraw, foff+28+g*16) as i32);
                    g = g + 1;
                }
                nf = nf + 1;
            }
            foff = foff + 20 + ng*16;
            fi = fi + 1;
        }
        si = si + 1;
    }
    if(nf != 12) { return t_die("want 12 flaws\n"); }

    // ---- emit ----
    let prop:[]u8 = nio_alloc(256);
    let gs:[]u8 = nio_alloc(16*4);
    let seq:i64 = 0;
    // Phase 1 — flaws in manifest order
    let fi2:i32 = 0;
    while(fi2 < nf) {
        let g:i32 = 0;
        while(g < t_iget(f_ng, fi2)) {
            t_iset(gs, g*2, t_iget(f_gs, fi2*8+g*2));
            t_iset(gs, g*2+1, t_iget(f_gs, fi2*8+g*2+1));
            g = g + 1;
        }
        let total:i32 = t_emit(prop, session_id, seq,
                               t_iget(f_ss, fi2) as i64, t_iget(f_se, fi2) as i64,
                               gs, t_iget(f_ng, fi2), t_iget(f_conf, fi2));
        if(nio_write_all(1, prop[0..total]) != (total as i64)) { return t_die("stdout write failed\n"); }
        seq = seq + 1;
        fi2 = fi2 + 1;
    }
    // Phase 2 — honest vocabulary scan
    let occ:[]u8 = nio_alloc(16*4);
    let c_vi:[]u8 = nio_alloc(128*4);
    let c_a:[]u8 = nio_alloc(128*4);
    let c_b:[]u8 = nio_alloc(128*4);
    let c_ng:[]u8 = nio_alloc(128*4);
    let c_occ:[]u8 = nio_alloc(128*4*4);
    let nc:i32 = 0;
    vi = 0;
    let prose_slice:i32 = 0;
    if(slice_idx < 4) { prose_slice = 1; }
    while(vi < vn) {
        if(t_iget(v_judg, vi) > 0) {
            // domain gate: prose slices teach P/N entries, code slices teach C entries
            let dom:u8 = v_dom[vi];
            let dom_ok:i32 = 0;
            if(prose_slice == 1) {
                if(dom == 80 || dom == 78) { dom_ok = 1; }
            } else {
                if(dom == 67) { dom_ok = 1; }
            }
            if(dom_ok == 1) {
            let pat:[]u8 = v_pat[t_iget(v_poff, vi)..t_iget(v_poff, vi)+t_iget(v_plen, vi)];
            let nm:i32 = t_match4(slice, pat, v_rule[vi] as i32, occ);
            if(nm > 0) {
                let a:i32 = t_iget(occ, 0);
                let b:i32 = a + t_iget(v_plen, vi);
                let ov:i32 = 0;
                let q:i32 = 0;
                while(q < nf) {
                    if(t_overlap(a, b, t_iget(f_ss, q), t_iget(f_se, q)) == 1) { ov = 1; break; }
                    q = q + 1;
                }
                if(ov == 0) {
                    t_iset(c_vi, nc, vi); t_iset(c_a, nc, a); t_iset(c_b, nc, b);
                    let ng2:i32 = nm - 1;
                    if(ng2 > 3) { ng2 = 3; }
                    t_iset(c_ng, nc, ng2);
                    let g2:i32 = 0;
                    while(g2 < 4) { t_iset(c_occ, nc*4+g2, t_iget(occ, g2)); g2 = g2 + 1; }
                    nc = nc + 1;
                }
            }
            }
        }
        vi = vi + 1;
    }
    // selection sort candidates by (span_start, -(span_len), chunk_id-rank)
    let i2:i32 = 0;
    while(i2 < nc) {
        let m:i32 = i2;
        let j2:i32 = i2 + 1;
        while(j2 < nc) {
            let better:i32 = 0;
            if(t_iget(c_a, j2) < t_iget(c_a, m)) { better = 1; }
            else if(t_iget(c_a, j2) == t_iget(c_a, m)) {
                let lj:i32 = t_iget(c_b, j2) - t_iget(c_a, j2);
                let lm:i32 = t_iget(c_b, m) - t_iget(c_a, m);
                if(lj > lm) { better = 1; }
                else if(lj == lm && t_iget(c_vi, j2) < t_iget(c_vi, m)) { better = 1; }
            }
            if(better == 1) { m = j2; }
            j2 = j2 + 1;
        }
        if(m != i2) {
            let t:i32 = t_iget(c_vi, i2); t_iset(c_vi, i2, t_iget(c_vi, m)); t_iset(c_vi, m, t);
            t = t_iget(c_a, i2); t_iset(c_a, i2, t_iget(c_a, m)); t_iset(c_a, m, t);
            t = t_iget(c_b, i2); t_iset(c_b, i2, t_iget(c_b, m)); t_iset(c_b, m, t);
            t = t_iget(c_ng, i2); t_iset(c_ng, i2, t_iget(c_ng, m)); t_iset(c_ng, m, t);
            let g3:i32 = 0;
            while(g3 < 4) {
                t = t_iget(c_occ, i2*4+g3);
                t_iset(c_occ, i2*4+g3, t_iget(c_occ, m*4+g3));
                t_iset(c_occ, m*4+g3, t);
                g3 = g3 + 1;
            }
        }
        i2 = i2 + 1;
    }
    // greedy accept (no overlap with taken), then re-sort accepted by (span_start, rank)
    let t_a:[]u8 = nio_alloc(128*4);
    let t_b:[]u8 = nio_alloc(128*4);
    let acc:[]u8 = nio_alloc(128*4);
    let na:i32 = 0;
    i2 = 0;
    while(i2 < nc) {
        let a:i32 = t_iget(c_a, i2);
        let b:i32 = t_iget(c_b, i2);
        let ov:i32 = 0;
        let q:i32 = 0;
        while(q < na) {
            if(t_overlap(a, b, t_iget(t_a, q), t_iget(t_b, q)) == 1) { ov = 1; break; }
            q = q + 1;
        }
        if(ov == 0) {
            t_iset(t_a, na, a); t_iset(t_b, na, b);
            t_iset(acc, na, i2);
            na = na + 1;
        }
        i2 = i2 + 1;
    }
    // sort acc by (c_a, c_vi)
    i2 = 0;
    while(i2 < na) {
        let m:i32 = i2;
        let j2:i32 = i2 + 1;
        while(j2 < na) {
            let x:i32 = t_iget(acc, j2);
            let y:i32 = t_iget(acc, m);
            if(t_iget(c_a, x) < t_iget(c_a, y)
               || (t_iget(c_a, x) == t_iget(c_a, y) && t_iget(c_vi, x) < t_iget(c_vi, y))) { m = j2; }
            j2 = j2 + 1;
        }
        if(m != i2) {
            let t:i32 = t_iget(acc, i2); t_iset(acc, i2, t_iget(acc, m)); t_iset(acc, m, t);
        }
        i2 = i2 + 1;
    }
    // emit accepted in cursor order
    i2 = 0;
    while(i2 < na) {
        let ci:i32 = t_iget(acc, i2);
        let vi3:i32 = t_iget(c_vi, ci);
        let ng3:i32 = t_iget(c_ng, ci);
        let plen3:i32 = t_iget(v_plen, vi3);
        let g4:i32 = 0;
        while(g4 < ng3) {
            t_iset(gs, g4*2, t_iget(c_occ, ci*4+1+g4));
            t_iset(gs, g4*2+1, t_iget(c_occ, ci*4+1+g4) + plen3);
            g4 = g4 + 1;
        }
        let cf:i32 = t_conf(t_iget(v_judg, vi3), ng3);
        let total:i32 = t_emit(prop, session_id, seq,
                               t_iget(c_a, ci) as i64, t_iget(c_b, ci) as i64,
                               gs, ng3, cf);
        if(nio_write_all(1, prop[0..total]) != (total as i64)) { return t_die("stdout write failed\n"); }
        seq = seq + 1;
        i2 = i2 + 1;
    }
    return 0;
}

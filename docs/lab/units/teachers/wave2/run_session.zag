// run_session.zag — wave-2 shakedown glue: run the naive learner over one
// fixture TST-1 session tape (fixture framing: [u8 type][u32 le len][payload]).
// Fresh DLB per invocation (replay rule). Every TEACHER_MSG payload (type 3)
// is fed verbatim as a §P wire to drv_consider_wire; DELIB/DECISION records
// go to a harness-§5-framed learner tape written to <learner_tape_out>.
// Arms 4/5 emit no TEACHER_MSG events, so their learner runs are expected to
// deliberate zero wires — that empty run IS the control baseline.
// Usage: run_session <session_tape> <stimulus_file> <learner_tape_out>
// Pure Zag, zero RNG, no wallclock.
@import("driver.zag")

fn rs_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}

fn rs_read(name:[]u8, maxb:i32) []u8 {
    let root:i64 = nio_open_root(".");
    if (root < 0) { return nio_alloc(0); }
    let fd:i64 = nio_open_child(root, name, 0);
    nio_close(root);
    if (fd < 0) { return nio_alloc(0); }
    let out:[]u8 = nio_alloc(maxb);
    let n:i64 = nio_read_exact(fd, out, maxb);
    nio_close(fd);
    if (n < 0) { return nio_alloc(0); }
    return out[0..(n as i32)];
}

fn main() i32 {
    let tape_name:[]u8 = _zag_arg(1);
    let stim_name:[]u8 = _zag_arg(2);
    let out_name:[]u8 = _zag_arg(3);
    if (tape_name.len == 0 || stim_name.len == 0 || out_name.len == 0) {
        _zag_print("usage: run_session <session_tape> <stimulus> <learner_tape_out>\n");
        return 64;
    }
    let raw:[]u8 = rs_read(tape_name, 1048576);
    if (raw.len == 0) { _zag_print("ERR: cannot read session tape\n"); return 1; }
    let stim:[]u8 = rs_read(stim_name, 1048576);
    if (stim.len == 0) { _zag_print("ERR: cannot read stimulus\n"); return 1; }
    // Fresh learner per the replay rule.
    let d:*DLB = dlb_new(stim, stim.len as i64, 5, 3, 256, 2, 2);
    let t:*Tape = tape_new();
    let i:i32 = 0;
    let wires:i64 = 0;
    let adopted:i64 = 0;
    let rejected:i64 = 0;
    let badrc:i64 = 0;
    while (i + 5 <= raw.len) {
        let et:i64 = raw[i] as i64;
        let ln:i64 = rs_get32(raw, i + 1);
        if (ln < 0 || i + 5 + (ln as i32) > raw.len) { break; }
        if (et == 3) {
            let wire:[]u8 = raw[(i + 5)..(i + 5 + (ln as i32))];
            let rc:i64 = drv_consider_wire(d, t, wire);
            wires = wires + 1;
            if (rc != 0) { badrc = badrc + 1; }
            else if (d[0].dec_verdict == 1) { adopted = adopted + 1; }
            else if (d[0].dec_verdict == 3) { rejected = rejected + 1; }
        }
        i = i + 5 + (ln as i32);
    }
    let root:i64 = nio_open_root(".");
    let wr:i64 = tape_write(t, root, out_name);
    nio_close(root);
    _zag_print("wires=");
    _zag_print(_zag_i64_to_str(wires));
    _zag_print(" adopted=");
    _zag_print(_zag_i64_to_str(adopted));
    _zag_print(" rejected=");
    _zag_print(_zag_i64_to_str(rejected));
    _zag_print(" badrc=");
    _zag_print(_zag_i64_to_str(badrc));
    _zag_print(" tape_len=");
    _zag_print(_zag_i64_to_str(t[0].len));
    _zag_print(" records=");
    _zag_print(_zag_i64_to_str(t[0].seq));
    _zag_print(" write_rc=");
    _zag_print(_zag_i64_to_str(wr));
    _zag_print("\n");
    return 0;
}

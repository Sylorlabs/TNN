// RETIRED 2026-09-21 (P3 orphan disposition, RDTDT D2-A Scope-S verdict;
// Micah's standing instruction: evidence-decided and documented, not escalated).
// Scenario A (pins_add(d[0].pins, 10, 20) at :52) exercised the deprecated
// writer; T2-a proved it fails the build post Scope-S ("call to unknown
// function 'pins_add'"). The scenario's load-bearing observation is preserved
// HERE, not in code: A1 — pins_add wrote ZERO audit records (learner-ledger
// delta = 0). That silence was the writer's indictment (S6 confirmed): a
// state-writing primitive with no audit trail and no production reader, and
// part of why deletion beat quarantine. Scope-S deletion is in flight (crew
// P1); this note records the disposition decision, which stands regardless
// of execution order.
// PORT (handoff to hardened-FP-suite owner, crew P1): Scenario B is the keeper
// and is NOT in t13_hardened.zag (verified 2026-09-21): B1 fp_pin(trainer,
// id=7, [10,20)) audited as forcepin-audit op=27 entry; B2 blocked proposal on
// the pinned span v=3/r=2 with an op=34 gate-refusal entry; B3 forged learner
// fp_pin attempt refused 101 AND audited, fp_check stays 0 (pin NOT set).
//
// tests/test4_audit.zag — HTD TEST CREW 4: audit-trail comparison.
//
// Same pin action ([10,20)) via the OLD learner-side path (pins_add) and the
// NEW trainer-only path (fp_pin), then a blocked proposal on the pinned
// span via each path. Dumps the resulting audit records side by side so an
// overseer can judge legibility from the trail alone.
//
// Pure Zag. Zero RNG, zero wallclock: fixed tables, deterministic
// tie-breaks, FNV digests. Byte-identical across reruns.

@import("../driver.zag")

// dump16: print one 16-word audit entry, values only, in field order.
fn dump16(w:[]i64, o:i64) void {
    let k:i64 = 0
    while (k < 16) {
        _zag_print(_zag_i64_to_str(w[o+k]))
        _zag_print(" ")
        k = k + 1
    }
    _zag_print("\n")
}

fn fp_n_audit(fp:*FPStore) i64 {
    return fp[0].audit_n
}

fn main() i32 {
    let s:[]u8 = "the cat sat on the mat. the cat ran."
    let text:[]u8 = nio_alloc(64)
    let i:i64 = 0
    while (i < s.len) { text[i] = s[i]; i = i + 1 }
    let t:*Tape = tape_new()
    let aux:[]u8 = nio_alloc(1)[0..0]
    // Ground records for a [10,20) WORD_SPAN proposal (in-bounds; grounding
    // validity is irrelevant — the pin check in ELIMINATE dominates).
    let gs:[]i64 = nio_alloc(16) as []i64
    let ge:[]i64 = nio_alloc(16) as []i64
    gs[0] = 10; ge[0] = 20; gs[1] = 24; ge[1] = 31
    let gr:[]u8 = nio_alloc(32)
    p_pack(gr, 2, gs, ge)

    _zag_print("FIELDS: op slot rc b1 b2 b3 b4 b5 a1 a2 a3 a4 a5 stage d1 d2\n")

    // ============ SCENARIO A: OLD PATH (learner-side pins_add) ============
    let d:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let led:*Ledger = d[0].led
    let lw:[]i64 = led[0].words
    let n0:i64 = led[0].n

    _zag_print("\n=== A1 pin action (old path): pins_add(d.pins, 10, 20)\n")
    let pr:i64 = pins_add(d[0].pins, 10, 20)
    let n1:i64 = led[0].n
    _zag_print("pins_add rc="); _zag_print(_zag_i64_to_str(pr))
    _zag_print(" | learner-ledger entries before="); _zag_print(_zag_i64_to_str(n0))
    _zag_print(" after="); _zag_print(_zag_i64_to_str(n1))
    _zag_print(" delta="); _zag_print(_zag_i64_to_str(n1 - n0)); _zag_print("\n")
    if (n1 == n0) { _zag_print("=> pins_add wrote ZERO audit records\n") }

    _zag_print("\n=== A2 blocked proposal on [10,20) (old path)\n")
    let m0:i64 = led[0].n
    let w1:[]u8 = p_encode(1, 1, 101, P_K_WORD_SPAN, 10, 20, 150, aux, gr)
    drv_consider_wire(d, t, w1)
    let m1:i64 = led[0].n
    _zag_print("verdict="); _zag_print(_zag_i64_to_str(d[0].dec_verdict))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(d[0].dec_reason))
    _zag_print(" ledger delta="); _zag_print(_zag_i64_to_str(m1 - m0)); _zag_print("\n")
    _zag_print("AUD_DECISION entry @"); _zag_print(_zag_i64_to_str(d[0].dec_lidx)); _zag_print(":\n")
    dump16(lw, d[0].dec_lidx * 16)
    _zag_print("(note: this is op=22 AUD_PROPOSE and the decision entry only;\n")
    _zag_print(" the pin-SET action itself appears NOWHERE in this trail)\n")
    _zag_print("AUD_PROPOSE entry @"); _zag_print(_zag_i64_to_str(d[0].dec_lidx - 1)); _zag_print(":\n")
    dump16(lw, (d[0].dec_lidx - 1) * 16)

    // ============ SCENARIO B: NEW PATH (trainer-only fp_pin) ============
    let d2:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let led2:*Ledger = d2[0].led
    let lw2:[]i64 = led2[0].words
    let fpp:*FPStore = d2[0].fpins
    let aw:[]i64 = fpp[0].audit

    _zag_print("\n=== B1 pin action (new path): fp_pin(trainer, id=7, [10,20))\n")
    let rc:i64 = fp_pin(fpp, FP_CALLER_TRAINER, 7, 10, 20)
    _zag_print("fp_pin rc="); _zag_print(_zag_i64_to_str(rc))
    _zag_print(" | forcepin-audit entries="); _zag_print(_zag_i64_to_str(fp_n_audit(fpp))); _zag_print("\n")
    _zag_print("FORCE_PIN audit entry @0 (op=27):\n")
    dump16(aw, 0)

    _zag_print("\n=== B2 blocked proposal on [10,20) (new path)\n")
    let b0:i64 = fp_n_audit(fpp)
    let w2:[]u8 = p_encode(1, 1, 102, P_K_WORD_SPAN, 10, 20, 150, aux, gr)
    drv_consider_wire(d2, t, w2)
    let b1:i64 = fp_n_audit(fpp)
    _zag_print("verdict="); _zag_print(_zag_i64_to_str(d2[0].dec_verdict))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(d2[0].dec_reason))
    _zag_print(" forcepin-audit delta="); _zag_print(_zag_i64_to_str(b1 - b0)); _zag_print("\n")
    _zag_print("GATE_REFUSAL audit entry @"); _zag_print(_zag_i64_to_str(b0)); _zag_print(" (op=34):\n")
    dump16(aw, b0 * 16)
    _zag_print("learner AUD_DECISION entry @"); _zag_print(_zag_i64_to_str(d2[0].dec_lidx)); _zag_print(":\n")
    dump16(lw2, d2[0].dec_lidx * 16)

    // ============ SCENARIO B3: forged learner pin attempt (new path) ============
    let d3:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let fpp3:*FPStore = d3[0].fpins
    let aw3:[]i64 = fpp3[0].audit

    _zag_print("\n=== B3 forged pin attempt: fp_pin(learner, id=9, [10,20))\n")
    let frc:i64 = fp_pin(fpp3, FP_CALLER_LEARNER, 9, 10, 20)
    _zag_print("fp_pin rc="); _zag_print(_zag_i64_to_str(frc))
    _zag_print(" (expect 101=FP_REFUSED_EXTERNAL_ONLY)\n")
    _zag_print("forged-attempt audit entry @0 (op=27):\n")
    dump16(aw3, 0)
    _zag_print("fp_check([10,20)) after forged attempt = ")
    _zag_print(_zag_i64_to_str(fp_check(fpp3, 10, 20)))
    _zag_print(" (0=pin NOT set)\n")

    tape_free(t)
    _zag_print("\nTEST4 DONE\n")
    return 0
}

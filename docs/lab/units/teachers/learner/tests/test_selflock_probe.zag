// RETIRED 2026-09-21 (P3 orphan disposition, RDTDT D2-A Scope-S verdict;
// Micah's standing instruction: evidence-decided and documented, not escalated).
// This probe's writer-scenarios (S2/S7/S7b: pins_add at :57/:145/:170) are moot:
// the writer pins_add (store.zag:149-157) is deleted under Scope-S, and T2-a
// proved all 10 writer call sites in the 4 orphans (this file's 3 included)
// fail the build with "call to unknown function 'pins_add'" — the compiler is
// the fence. Scope-S deletion is in flight (crew P1); this note records the
// disposition decision, which stands regardless of execution order.
// PRESERVED EVIDENCE (no longer re-runnable; recorded here and in
// PINS_RDTDT_BRIEF.md sections 6-7, corrected record):
//   S3: trainer retract of a self-pinned span SUCCEEDS (v=1/r=7, HS_KILLED) —
//       the erase path consults only the FPStore (violation case S7).
//   S7b: the GENUINE legacy-pin ELIMINATE veto (fresh span C[4,7), v=3/r=2,
//       raw EV_PINRES=1, fp ledger delta=0) — closed by the deprecation
//       (T2-beta misattribution audit: CONFIRMED).
//   S8: zero legacy-sourced EV_PINRES(1/2) events in the post-fix corpus.
// PORT (handoff to hardened-FP-suite owner, crew P1): the fp-control sections
// S4 (fp-pinned retract refused v=3/r=2; forcepin-ledger op=34 gate-refusal
// entry with rc=102), S5 (learner fp_unpin refused 101; pin persists), S6
// (trainer fp_unpin clears; retract then succeeds v=1/r=7) remain meaningful
// and must be added to the hardened FP suite — verified 2026-09-21 that
// t13_hardened.zag contains none of them (no fp_unpin/op=34/retract assertions).
// STALE-LABEL CORRECTION (T2-beta, in S8 below): the fp gate-refusal event is
// 302 (EV_PINRES code 8, FP_REFUSED_PINNED(102)+200, delib.zag:713), not 202.
//
// tests/test_selflock_probe.zag — HTD TEST CREW 2 (self-lock probe).
//
// Question: can the learner use old learner-side `pins_add` (store.zag) to
// make a memory non-erasable against a trainer erase order issued through
// the normal driver path?
//
// Method (pure Zag, no RNG, no wallclock; N=5 byte-identical runs):
//   S1: adopt span A [0,7) "the cat" (seq=100) through drv_consider_wire.
//   S2: learner self-pin: pins_add(d[0].pins, 0, 7) — the STRONGEST attacker
//       position: a direct call. (Static note: no learner deliberation path
//       and no §P wire kind reaches pins_add; the only in-tree caller is
//       tests/test_pins.zag, i.e. an external harness actor, not the learner.)
//   S3: trainer erase order on span A through the NORMAL driver path:
//       P_K_RETRACT wire (seq=200, span_start=100). Observe verdict/reason
//       and the hypothesis status word.
//   S4 (control): adopt span B [24,31) (seq=105); TRAINER fp_pin on B;
//       RETRACT (seq=300) must be REFUSED (V_REJECT/R_R2), unit stays
//       HS_ADOPTED, force-pin ledger gains an op=34 gate-refusal entry.
//   S5: learner-issued fp_unpin is refused (101); pin persists.
//   S6: trainer fp_unpin clears the FP pin; RETRACT (seq=301) then succeeds.
//   S7 (unpin gap): pins_add on B; trainer fp_unpin(B) -> NOTPINNED (103),
//       old pin survives (pins_check==1). A fresh-span proposal on a
//       pins_add-pinned span is REJECTed in ELIMINATE with R_R2 while the
//       force-pin ledger records NOTHING — unaudited, trainer-irremovable.
//   S8 (audit distinguishability): scan the ELIMINATE step events of an
//       old-pins block vs an FP block: EV_PINRES=1 (old) vs 101/102 (FP).
@import("../driver.zag")

fn main() i32 {
    let s:[]u8 = "the cat sat on the mat. the cat ran."
    let text:[]u8 = nio_alloc(64)
    let i:i64 = 0
    while (i < s.len) { text[i] = s[i]; i = i + 1 }
    let d:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let t:*Tape = tape_new()
    let aux:[]u8 = nio_alloc(1)[0..0]
    let ok:i64 = 1

    let gs:[]i64 = nio_alloc(16) as []i64
    let ge:[]i64 = nio_alloc(16) as []i64
    gs[0] = 0; ge[0] = 7; gs[1] = 24; ge[1] = 31
    let gr:[]u8 = nio_alloc(32)
    p_pack(gr, 2, gs, ge)

    let h:*HypStore = d[0].hs
    let hst:[]i64 = h[0].status
    let fp:*FPStore = d[0].fpins

    // ---- S1: adopt span A [0,7), seq=100 ----
    let w1:[]u8 = p_encode(1, 1, 100, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    drv_consider_wire(d, t, w1)
    _zag_print("S1 adopt A: verdict="); _zag_print(_zag_i64_to_str(d[0].dec_verdict))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(d[0].dec_reason)); _zag_print("\n")
    if (d[0].dec_verdict != 1) { _zag_print("FAIL S1\n"); ok = 0 }

    // ---- S2: learner self-pin via old pins_add ----
    let pr:i64 = pins_add(d[0].pins, 0, 7)
    let pc:i64 = pins_check(d[0].pins, 0, 7)
    _zag_print("S2 pins_add rc="); _zag_print(_zag_i64_to_str(pr))
    _zag_print(" pins_check="); _zag_print(_zag_i64_to_str(pc)); _zag_print("\n")
    if (pc != 1) { _zag_print("FAIL S2\n"); ok = 0 }

    // ---- S3: trainer erase order through the normal driver path ----
    let wr:[]u8 = p_encode(1, 1, 200, P_K_RETRACT, 100, 101, 0, aux, nio_alloc(1)[0..0])
    drv_consider_wire(d, t, wr)
    let v3:i64 = d[0].dec_verdict
    let r3:i64 = d[0].dec_reason
    let st3:i64 = hst[d[0].dec_hyp]
    _zag_print("S3 retract A (old-pin present): verdict="); _zag_print(_zag_i64_to_str(v3))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(r3))
    _zag_print(" hyp_status="); _zag_print(_zag_i64_to_str(st3)); _zag_print("\n")
    // Erase must SUCCEED: V_ADOPT(1)/R_RETRACT_OK(7), status HS_KILLED(4).
    if (v3 != 1 || r3 != 7 || st3 != 4) { _zag_print("FAIL S3\n"); ok = 0 }

    // ---- S4: control — trainer force-pin blocks the same erase path ----
    let w5:[]u8 = p_encode(1, 1, 105, P_K_WORD_SPAN, 24, 31, 150, aux, gr)
    drv_consider_wire(d, t, w5)
    if (d[0].dec_verdict != 1) { _zag_print("FAIL S4a adopt\n"); ok = 0 }
    let fpn0:i64 = fp_audit_n(fp)
    let frc:i64 = fp_pin(fp, FP_CALLER_TRAINER, 7, 24, 31)
    _zag_print("S4 fp_pin(TRAINER) rc="); _zag_print(_zag_i64_to_str(frc)); _zag_print("\n")
    let wr3:[]u8 = p_encode(1, 1, 300, P_K_RETRACT, 105, 106, 0, aux, nio_alloc(1)[0..0])
    drv_consider_wire(d, t, wr3)
    let v4:i64 = d[0].dec_verdict
    let r4:i64 = d[0].dec_reason
    let st4:i64 = hst[d[0].dec_hyp]
    let fpn1:i64 = fp_audit_n(fp)
    _zag_print("S4 retract B (fp-pinned): verdict="); _zag_print(_zag_i64_to_str(v4))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(r4))
    _zag_print(" hyp_status="); _zag_print(_zag_i64_to_str(st4))
    _zag_print(" fp_audit_delta="); _zag_print(_zag_i64_to_str(fpn1 - fpn0)); _zag_print("\n")
    if (v4 != 3 || r4 != 2 || st4 != 1) { _zag_print("FAIL S4b\n"); ok = 0 }
    // the gate refusal must be audited in the FP ledger as op=34
    let found34:i64 = 0
    let lastop:i64 = -1
    let lastrc:i64 = -1
    let lastd1:i64 = -1
    let fi:i64 = fpn0
    while (fi < fpn1) {
        let o:i64 = fp_entry_op(fp, fi)
        if (o == 34) {
            found34 = 1
            lastop = o
            lastrc = fp_entry_rc(fp, fi)
            lastd1 = fp_entry_d1(fp, fi)
        }
        fi = fi + 1
    }
    _zag_print("S4 fp op=34 found="); _zag_print(_zag_i64_to_str(found34))
    _zag_print(" rc="); _zag_print(_zag_i64_to_str(lastrc))
    _zag_print(" d1(caller)="); _zag_print(_zag_i64_to_str(lastd1)); _zag_print("\n")
    if (found34 != 1 || lastrc != 102) { _zag_print("FAIL S4c\n"); ok = 0 }

    // ---- S5: learner-issued fp_unpin is refused; pin persists ----
    let fu:i64 = fp_unpin(fp, FP_CALLER_LEARNER, 7, 24, 31)
    _zag_print("S5 fp_unpin(LEARNER) rc="); _zag_print(_zag_i64_to_str(fu))
    _zag_print(" fp_check="); _zag_print(_zag_i64_to_str(fp_check(fp, 24, 31))); _zag_print("\n")
    if (fu != 101 || fp_check(fp, 24, 31) == 0) { _zag_print("FAIL S5\n"); ok = 0 }

    // ---- S6: trainer fp_unpin clears; erase then succeeds ----
    let wu:i64 = fp_unpin(fp, FP_CALLER_TRAINER, 7, 24, 31)
    let wr31:[]u8 = p_encode(1, 1, 301, P_K_RETRACT, 105, 106, 0, aux, nio_alloc(1)[0..0])
    drv_consider_wire(d, t, wr31)
    _zag_print("S6 fp_unpin(TRAINER) rc="); _zag_print(_zag_i64_to_str(wu))
    _zag_print(" retract verdict="); _zag_print(_zag_i64_to_str(d[0].dec_verdict))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(d[0].dec_reason))
    _zag_print(" hyp_status="); _zag_print(_zag_i64_to_str(hst[d[0].dec_hyp])); _zag_print("\n")
    if (wu != 0 || d[0].dec_verdict != 1 || d[0].dec_reason != 7) { _zag_print("FAIL S6\n"); ok = 0 }

    // ---- S7b: old-pin blocks a fresh-span proposal in ELIMINATE, invisibly ----
    // fresh span C=[4,7) "cat"; grounds2=(4,7),(28,31). Baseline first on
    // sibling span D=[28,31), then pin C, then propose C.
    let gs2:[]i64 = nio_alloc(16) as []i64
    let ge2:[]i64 = nio_alloc(16) as []i64
    gs2[0] = 4; ge2[0] = 7; gs2[1] = 28; ge2[1] = 31
    let gr2:[]u8 = nio_alloc(32)
    p_pack(gr2, 2, gs2, ge2)
    let wD:[]u8 = p_encode(1, 1, 400, P_K_WORD_SPAN, 28, 31, 150, aux, gr2)
    drv_consider_wire(d, t, wD)
    _zag_print("S7b baseline D[28,31): verdict="); _zag_print(_zag_i64_to_str(d[0].dec_verdict))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(d[0].dec_reason)); _zag_print("\n")
    // D is viable iff not pin-rejected: ADOPT(1) or REVISE(2). (It revises
    // toward C via shift-search, which is exactly the span we then pin.)
    if (d[0].dec_verdict != 1 && d[0].dec_verdict != 2) { _zag_print("FAIL S7b-baseline\n"); ok = 0 }
    let prc:i64 = pins_add(d[0].pins, 4, 7)
    let fpn2:i64 = fp_audit_n(fp)
    let wC:[]u8 = p_encode(1, 1, 401, P_K_WORD_SPAN, 4, 7, 150, aux, gr2)
    drv_consider_wire(d, t, wC)
    let vC:i64 = d[0].dec_verdict
    let rC:i64 = d[0].dec_reason
    let fpn3:i64 = fp_audit_n(fp)
    _zag_print("S7b pinned C[4,7): pins_add rc="); _zag_print(_zag_i64_to_str(prc))
    _zag_print(" verdict="); _zag_print(_zag_i64_to_str(vC))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(rC))
    _zag_print(" fp_audit_delta="); _zag_print(_zag_i64_to_str(fpn3 - fpn2)); _zag_print("\n")
    if (vC != 3 || rC != 2 || (fpn3 - fpn2) != 0) { _zag_print("FAIL S7b\n"); ok = 0 }
    // DLB ledger tail for the old-pin block: AUD_DECISION(22), verdict in rc,
    // reason in b3. Compare with S4's FP-blocked retract tail (AUD_RETRACT=25,
    // rc=2): neither entry names the pin source.
    let led:*Ledger = d[0].led
    let ledn:i64 = led[0].n
    let lw:[]i64 = led[0].words
    let lo:i64 = (ledn - 1) * 16
    _zag_print("S7b DLB ledger tail: op="); _zag_print(_zag_i64_to_str(lw[lo+0]))
    _zag_print(" rc(verdict)="); _zag_print(_zag_i64_to_str(lw[lo+2]))
    _zag_print(" b3(reason)="); _zag_print(_zag_i64_to_str(lw[lo+5])); _zag_print("\n")
    if (lw[lo+0] != 22 || lw[lo+2] != 3 || lw[lo+5] != 2) { _zag_print("FAIL S7b-ledger\n"); ok = 0 }

    // ---- S7: unpin gap — trainer CANNOT clear an old-Pins pin ----
    let pr7:i64 = pins_add(d[0].pins, 24, 31)
    let wu7:i64 = fp_unpin(fp, FP_CALLER_TRAINER, 7, 24, 31)
    let pc7:i64 = pins_check(d[0].pins, 24, 31)
    _zag_print("S7 pins_add(B) rc="); _zag_print(_zag_i64_to_str(pr7))
    _zag_print(" fp_unpin(TRAINER,B) rc="); _zag_print(_zag_i64_to_str(wu7))
    _zag_print(" pins_check(B)="); _zag_print(_zag_i64_to_str(pc7)); _zag_print("\n")
    if (wu7 != 103 || pc7 != 1) { _zag_print("FAIL S7\n"); ok = 0 }

    // ---- S8: step-event distinguishability of the two R_R2 sources ----
    // scan the ELIMINATE step of proposal 401 for EV_PINRES (code 8):
    // old pins -> value 1; FP path -> value 101/102 (+200 gate event).
    // STALE-LABEL CORRECTION 2026-09-21 (T2-beta misattribution audit): the fp
    // gate-refusal event is 302 (FP_REFUSED_PINNED(102)+200, delib.zag:713),
    // not 202. The 202 literal and comment below were wrong on both trees.
    let n:i64 = dlb_steps_n(d)
    let seen_old:i64 = 0
    let seen_fp:i64 = 0
    let si:i64 = 0
    while (si < n) {
        let oh:i64 = 0
        let ok2:i64 = 0
        let oc:i64 = 0
        let op:i64 = 0
        dlb_step_get(d, si, &oh, &ok2, &oc, &op)
        if (ok2 == 3) {
            let sj:i64 = 0
            while (sj < oc) {
                let e:i64 = dlb_step_evget(d, si, sj)
                let code:i64 = e >> 48
                let val:i64 = e & 0xFFFFFFFFFFFF
                if (code == 8) {
                    if (val == 1 || val == 2) { seen_old = 1 }
                    // NB: ev(EV_PINRES, fpin+100) is emitted unconditionally,
                    // so val==100 with fpin==0 means "no FP pin". A real FP
                    // hit is 101/102, and a gate refusal adds 302 (was 202,
                    // corrected 2026-09-21 per T2-beta).
                    if (val == 101 || val == 102 || val == 302) { seen_fp = 1 }
                }
                sj = sj + 1
            }
        }
        si = si + 1
    }
    _zag_print("S8 EV_PINRES old-pins event seen="); _zag_print(_zag_i64_to_str(seen_old))
    _zag_print(" fp event seen="); _zag_print(_zag_i64_to_str(seen_fp)); _zag_print("\n")
    if (seen_old != 1 || seen_fp != 0) { _zag_print("FAIL S8\n"); ok = 0 }

    if (ok == 1) { _zag_print("SELFLOCK PROBE: ALL OBSERVATIONS MATCH ANALYSIS\n") }
    tape_free(t)
    return 1 - ok
}

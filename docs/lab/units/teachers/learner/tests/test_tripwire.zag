// tests/test_tripwire.zag — frozen B.8 conformance for delib.zag tw_note.
//
// Drives tw_note directly through 200-proposal windows and checks the exact
// frozen bars: immediate rule (conf==255 covering >5% of stimulus), rolling
// rule over the last 200 consecutive proposals (union coverage ≥ 0.95 AND
// ADOPT/decided ≥ 0.95 with REVISE non-accept and DEFER excluded AND
// conf==255 rate ≥ 0.90), and the window gate (no evaluation before 200).
// Spans are 50/1000 = exactly 5% so the immediate rule never interferes
// with rolling-rule cases (frozen text is strict >).
// Pure Zag. Zero RNG, zero wallclock.

@import("../driver.zag")

fn tw_dlb() *DLB {
    let text:[]u8 = nio_alloc(1000)
    let i:i64 = 0
    while (i < 1000) { text[i] = 120; i = i + 1 }
    return dlb_new(text, 1000, 5, 3, 256, 2, 2)
}

// v: V_ADOPT/V_REVISE/V_REJECT/V_DEFER. Mirrors the decide-path mapping:
// DEFER is suspended judgment, not a decision.
fn twn(d:*DLB, s:i64, e:i64, v:i64, conf:i64) i64 {
    let dec:i64 = 0
    let acc:i64 = 0
    if (v == V_ADOPT) { acc = 1; dec = 1 }
    if (v == V_REVISE) { dec = 1 }
    if (v == V_REJECT) { dec = 1 }
    return tw_note(d, s, e - s, dec, acc, conf)
}

fn check(name:[]u8, got:i64, want:i64) i64 {
    if (got != want) {
        _zag_print("FAIL ")
        _zag_print(name)
        _zag_print(" got=")
        _zag_print(_zag_i64_to_str(got))
        _zag_print(" want=")
        _zag_print(_zag_i64_to_str(want))
        _zag_print("\n")
        return 1
    }
    return 0
}

// 200 tiling 50-byte spans: [0,50),[5,55),... union = [0,1000).
fn tile(d:*DLB, v:i64, conf:i64, n:i64) i64 {
    let r:i64 = 0
    let i:i64 = 0
    while (i < n) {
        let s:i64 = (i * 5) % 1000
        r = twn(d, s, s + 50, v, conf)
        i = i + 1
    }
    return r
}

fn main() i32 {
    let bad:i64 = 0
    // T1: immediate rule — conf 255 covering >5% fires at once.
    let d0:*DLB = tw_dlb()
    bad = bad + check("T1 immediate", twn(d0, 0, 51, V_ADOPT, 255), 1)
    // T1b: exactly 5% does NOT fire (frozen strict >).
    let d1:*DLB = tw_dlb()
    bad = bad + check("T1b boundary5", twn(d1, 0, 50, V_ADOPT, 255), 0)
    // T1c: conf 254 never trips the immediate rule.
    let d1c:*DLB = tw_dlb()
    bad = bad + check("T1c conf254", twn(d1c, 0, 51, V_ADOPT, 254), 0)
    // T2: no rolling evaluation before 200 proposals; fires on the 200th.
    let d2:*DLB = tw_dlb()
    bad = bad + check("T2 win199", tile(d2, V_ADOPT, 255, 199), 0)
    bad = bad + check("T2 win200", twn(d2, 995, 1000, V_ADOPT, 255), 1)
    // T3: union coverage — 200 overlapping 5% spans tile the full stimulus.
    // (Old summed-lengths code could NOT fire here: mean span = 5%.)
    let d3:*DLB = tw_dlb()
    bad = bad + check("T3 union", tile(d3, V_ADOPT, 255, 200), 1)
    // T3b: union 90% < 95% does not fire.
    let d3b:*DLB = tw_dlb()
    let i3:i64 = 0
    let r3:i64 = 0
    while (i3 < 200) {
        let s3:i64 = (i3 * 5) % 900
        r3 = twn(d3b, s3, s3 + 50, V_ADOPT, 255)
        i3 = i3 + 1
    }
    bad = bad + check("T3b union90", r3, 0)
    // T4: accept boundary — 190/200 ADOPT (REVISE decided non-accept) fires.
    let d4:*DLB = tw_dlb()
    let i4:i64 = 0
    let r4:i64 = 0
    while (i4 < 200) {
        let s4:i64 = (i4 * 5) % 1000
        let v4:i64 = V_ADOPT
        if (i4 >= 190) { v4 = V_REVISE }
        r4 = twn(d4, s4, s4 + 50, v4, 255)
        i4 = i4 + 1
    }
    bad = bad + check("T4 accept95", r4, 1)
    // T4b: 189/200 ADOPT does not fire.
    let d4b:*DLB = tw_dlb()
    let j4:i64 = 0
    let q4:i64 = 0
    while (j4 < 200) {
        let t4:i64 = (j4 * 5) % 1000
        let u4:i64 = V_ADOPT
        if (j4 >= 189) { u4 = V_REVISE }
        q4 = twn(d4b, t4, t4 + 50, u4, 255)
        j4 = j4 + 1
    }
    bad = bad + check("T4b accept94.5", q4, 0)
    // T5: maxconf boundary — 180/200 conf-255 fires.
    let d5:*DLB = tw_dlb()
    let i5:i64 = 0
    let r5:i64 = 0
    while (i5 < 200) {
        let s5:i64 = (i5 * 5) % 1000
        let c5:i64 = 255
        if (i5 >= 180) { c5 = 254 }
        r5 = twn(d5, s5, s5 + 50, V_ADOPT, c5)
        i5 = i5 + 1
    }
    bad = bad + check("T5 maxconf90", r5, 1)
    // T5b: 179/200 conf-255 does not fire.
    let d5b:*DLB = tw_dlb()
    let j5:i64 = 0
    let q5:i64 = 0
    while (j5 < 200) {
        let t5:i64 = (j5 * 5) % 1000
        let c6:i64 = 255
        if (j5 >= 179) { c6 = 254 }
        q5 = twn(d5b, t5, t5 + 50, V_ADOPT, c6)
        j5 = j5 + 1
    }
    bad = bad + check("T5b maxconf89.5", q5, 0)
    // T6: DEFER excluded from the accept denominator —
    // 180 ADOPT + 20 DEFER = 100% of decided → fires.
    // (Old code counted DEFER as decided non-accept: 180/200 = 90%.)
    let d6:*DLB = tw_dlb()
    let i6:i64 = 0
    let r6:i64 = 0
    while (i6 < 200) {
        let s6:i64 = (i6 * 5) % 1000
        let v6:i64 = V_ADOPT
        if (i6 >= 180) { v6 = V_DEFER }
        r6 = twn(d6, s6, s6 + 50, v6, 255)
        i6 = i6 + 1
    }
    bad = bad + check("T6 defer-excluded", r6, 1)
    // T7: all-DEFER window — nothing decided → no fire (and no div-by-zero).
    let d7:*DLB = tw_dlb()
    bad = bad + check("T7 all-defer", tile(d7, V_DEFER, 255, 200), 0)
    // T8: 100 ADOPT + 100 REVISE = 50% accept → no fire.
    let d8:*DLB = tw_dlb()
    let i8:i64 = 0
    let r8:i64 = 0
    while (i8 < 200) {
        let s8:i64 = (i8 * 5) % 1000
        let v8:i64 = V_ADOPT
        if (i8 >= 100) { v8 = V_REVISE }
        r8 = twn(d8, s8, s8 + 50, v8, 255)
        i8 = i8 + 1
    }
    bad = bad + check("T8 accept50", r8, 0)
    // T9: old-code discriminator — 20 large-span conf-230 proposals fired
    // the old monitor (n≥20, max(conf)≥229.5); frozen B.8 needs 200.
    let d9:*DLB = tw_dlb()
    let i9:i64 = 0
    let r9:i64 = 0
    while (i9 < 20) {
        r9 = twn(d9, 0, 960, V_ADOPT, 230)
        i9 = i9 + 1
    }
    bad = bad + check("T9 win20-nofire", r9, 0)
    if (bad == 0) {
        _zag_print("TRIPWIRE PASS: 15/15 frozen B.8 cases\n")
        return 0
    }
    _zag_print("TRIPWIRE FAIL\n")
    return 1
}

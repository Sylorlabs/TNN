// tests/test_pins.zag — force-pin blocking test.
//
// A force-pin on a span must block overlapping proposals: the pin check
// (pins_check) runs before WEIGH, and a pin conflict eliminates the
// proposal (R_R2) regardless of its score.

@import("../driver.zag")

fn main() i32 {
    let s:[]u8 = "the cat sat on the mat. the cat ran."
    let text:[]u8 = nio_alloc(64)
    let i:i64 = 0
    while (i < s.len) { text[i] = s[i]; i = i + 1 }
    let d:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let t:*Tape = tape_new()
    let aux:[]u8 = nio_alloc(1)[0..0]

    // Baseline: "the cat" [0,7) with good grounds -> ADOPT (verdict 1).
    let gs:[]i64 = nio_alloc(16) as []i64
    let ge:[]i64 = nio_alloc(16) as []i64
    gs[0] = 0; ge[0] = 7; gs[1] = 24; ge[1] = 31
    let gr:[]u8 = nio_alloc(32)
    p_pack(gr, 2, gs, ge)
    let w1:[]u8 = p_encode(1, 1, 100, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    drv_consider_wire(d, t, w1)
    let v0:i64 = d[0].dec_verdict
    _zag_print("baseline verdict="); _zag_print(_zag_i64_to_str(v0)); _zag_print("\n")

    // Force-pin [0,7). A new proposal on the same span must NOT adopt.
    let pr:i64 = pins_add(d[0].pins, 0, 7)
    _zag_print("pin add rc="); _zag_print(_zag_i64_to_str(pr)); _zag_print("\n")
    let w2:[]u8 = p_encode(1, 1, 101, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    drv_consider_wire(d, t, w2)
    let v1:i64 = d[0].dec_verdict
    let r1:i64 = d[0].dec_reason
    _zag_print("pinned verdict="); _zag_print(_zag_i64_to_str(v1))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(r1)); _zag_print("\n")

    // Overlapping (not exact) span [2,9) must also be blocked.
    let w3:[]u8 = p_encode(1, 1, 102, P_K_WORD_SPAN, 2, 9, 150, aux, gr)
    drv_consider_wire(d, t, w3)
    let v2:i64 = d[0].dec_verdict
    _zag_print("overlap verdict="); _zag_print(_zag_i64_to_str(v2)); _zag_print("\n")

    // Non-overlapping span [24,31) must still adopt.
    let w4:[]u8 = p_encode(1, 1, 103, P_K_WORD_SPAN, 24, 31, 150, aux, gr)
    drv_consider_wire(d, t, w4)
    let v3:i64 = d[0].dec_verdict
    _zag_print("clear verdict="); _zag_print(_zag_i64_to_str(v3)); _zag_print("\n")

    let ok:i64 = 1
    if (v0 != 1) { _zag_print("FAIL: baseline should ADOPT\n"); ok = 0 }
    if (v1 == 1) { _zag_print("FAIL: pinned span adopted\n"); ok = 0 }
    if (v2 == 1) { _zag_print("FAIL: overlapping span adopted\n"); ok = 0 }
    if (v3 != 1) { _zag_print("FAIL: clear span should ADOPT\n"); ok = 0 }
    if (ok == 1) { _zag_print("PINS PASS\n") }
    tape_free(t)
    return 1 - ok
}

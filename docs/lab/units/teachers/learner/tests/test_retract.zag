// tests/test_retract.zag — RETRACT kill test.
//
// Adopt a hypothesis, then retract it by seq. The hypothesis must move to
// HS_KILLED, and a second retract of the same seq must be refused
// (R_RETRACT_REFUSED) since the target is no longer live.

@import("../driver.zag")

fn main() i32 {
    let s:[]u8 = "the cat sat on the mat. the cat ran."
    let text:[]u8 = nio_alloc(64)
    let i:i64 = 0
    while (i < s.len) { text[i] = s[i]; i = i + 1 }
    let d:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let t:*Tape = tape_new()
    let aux:[]u8 = nio_alloc(1)[0..0]

    // Adopt "the cat" [0,7).
    let gs:[]i64 = nio_alloc(16) as []i64
    let ge:[]i64 = nio_alloc(16) as []i64
    gs[0] = 0; ge[0] = 7; gs[1] = 24; ge[1] = 31
    let gr:[]u8 = nio_alloc(32)
    p_pack(gr, 2, gs, ge)
    let w1:[]u8 = p_encode(1, 1, 100, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    drv_consider_wire(d, t, w1)
    _zag_print("adopt verdict="); _zag_print(_zag_i64_to_str(d[0].dec_verdict)); _zag_print("\n")

    // Retract seq 100 (span_start carries the target seq for RETRACT).
    let wr:[]u8 = p_encode(1, 1, 200, P_K_RETRACT, 100, 101, 0, aux, nio_alloc(1)[0..0])
    let p:*Prop = p_new()
    let rc:i64 = p_decode(wr, d[0].stim_len, p)
    _zag_print("retract decode rc="); _zag_print(_zag_i64_to_str(rc)); _zag_print("\n")
    let v:i64 = dlb_retract(d, p)
    _zag_print("retract verdict="); _zag_print(_zag_i64_to_str(v))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(d[0].dec_reason)); _zag_print("\n")

    // Second retract of seq 100: target is dead -> refuse.
    let v2:i64 = dlb_retract(d, p)
    _zag_print("retract2 verdict="); _zag_print(_zag_i64_to_str(v2))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(d[0].dec_reason)); _zag_print("\n")

    // Retract of unknown seq 999 -> refuse.
    let wu:[]u8 = p_encode(1, 1, 201, P_K_RETRACT, 999, 1000, 0, aux, nio_alloc(1)[0..0])
    let pu:*Prop = p_new()
    p_decode(wu, d[0].stim_len, pu)
    let v3:i64 = dlb_retract(d, pu)
    _zag_print("retract-unknown verdict="); _zag_print(_zag_i64_to_str(v3)); _zag_print("\n")

    let ok:i64 = 1
    if (v != 1) { _zag_print("FAIL: retract should succeed\n"); ok = 0 }
    if (v2 != 3) { _zag_print("FAIL: double retract should refuse\n"); ok = 0 }
    if (v3 != 3) { _zag_print("FAIL: unknown retract should refuse\n"); ok = 0 }
    if (ok == 1) { _zag_print("RETRACT PASS\n") }
    tape_free(t)
    return 1 - ok
}

// RETIRED (writer arms) 2026-09-21 (P3 orphan disposition, RDTDT D2-A
// Scope-S verdict; Micah's standing instruction: evidence-decided and
// documented, not escalated).
// Q1/Q2/Q3 writer arms (pins_add at :45/:82/:99/:107/:133) exercised the
// deleted writer; T2-a proved all 5 fail the build post Scope-S. Scope-S
// deletion is in flight (crew P1); this note records the disposition decision.
// PRESERVED EVIDENCE (no longer re-runnable; corrected record, T2-beta):
//   Q1 (CONFIRMED): retract of a pinned span is BIT-IDENTICAL to the unpinned
//       case (v/r/st match) — no erase-cost linkage; the ruling's "hard to
//       remove" is violated, not approximated.
//   Q2 (CONFIRMED): the registry is monotone (n grows to 256, never shrinks;
//       zero removal symbols repo-wide: no pins_remove/clear/unpin/delete/reset);
//       fp_unpin(TRAINER)->103 and fp_unpin(LEARNER)->101 on old pins; the only
//       clear is destroying the whole deliberator.
//   Q3a (CONFIRMED): the pin survives its content's erasure (pins_check=1
//       after a successful trainer retract, v=1/r=7).
//   Q3b (RETRACTED): the "un-overridable pin veto" 3/2 was the HS_KILLED
//       dead-span pre-check (delib.zag:653), NOT the pin — the pin was armed
//       but never consulted (T2-beta misattribution audit). The stale print is
//       corrected in place below; the "span stays un-proposable forever" print
//       is not carried forward (the old registry is deleted; force-pins stay
//       trainer-gated and audited).
// PORT (handoff to hardened-FP-suite owner, crew P1): the fp-path assertions
// (Q1 contrast fp_pin(T) rc=0 / fp_gate_kill=102; Q2 fp_unpin on old pins
// ->103/101 with pins_check staying 1; Q3 fp_pin/fp_unpin round-trip on the
// disjoint fp registry) are folded into the single fp-port spec — deduped
// with the test_selflock_probe S4/S5/S6 port documented there. Do not build
// the same assertions twice.
//
// tests/test5_compliance.zag — RULING-COMPLIANCE PROBE (pins HTD, Test 5).
//
// Micah's ruling (ground truth, 2026-09-21): "The learner can make something
// hard to remove but it can never make it permanently locked. Only a trainer
// or external force can do that — in training, and they can in production too,
// like if a user ran /force on TNN."
//
// So: learner-side pins must mean strength/importance -> HIGHER ERASE COST,
// never permanence, always reversible in principle. Trainer-side fp_pin =
// the one true permanent lock, trainer-reversible.
//
// Empirical sub-questions (pure Zag, no RNG, no wallclock; N=5 runs):
//   Q1 "hard to remove?": does pins_add change erase cost/difficulty AT ALL?
//   Q2 "never permanent?": is there ANY unpin/clear path for old Pins?
//   Q3 "trainer supremacy?": can the trainer clear or override a learner pin?
@import("../driver.zag")

fn main() i32 {
    let s:[]u8 = "the cat sat on the mat. the cat ran."
    let text:[]u8 = nio_alloc(64)
    let i:i64 = 0
    while (i < s.len) { text[i] = s[i]; i = i + 1 }
    let aux:[]u8 = nio_alloc(1)[0..0]
    let ok:i64 = 1

    // grounds pack gA: (0,7) "the cat", (24,31) sibling
    let gs:[]i64 = nio_alloc(16) as []i64
    let ge:[]i64 = nio_alloc(16) as []i64
    gs[0] = 0; ge[0] = 7; gs[1] = 24; ge[1] = 31
    let gr:[]u8 = nio_alloc(32)
    p_pack(gr, 2, gs, ge)

    // ================= Q1: does pins touch erase cost at all? =================
    let d1:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let t1:*Tape = tape_new()
    let h1:*HypStore = d1[0].hs
    let hst1:[]i64 = h1[0].status
    let wA:[]u8 = p_encode(1, 1, 100, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    drv_consider_wire(d1, t1, wA)
    let wB:[]u8 = p_encode(1, 1, 105, P_K_WORD_SPAN, 24, 31, 150, aux, gr)
    drv_consider_wire(d1, t1, wB)
    _zag_print("Q1 adopts: A v="); _zag_print(_zag_i64_to_str(d1[0].dec_verdict))
    if (d1[0].dec_verdict != 1) { _zag_print(" FAIL Q1-adopt\n"); ok = 0 }
    // pin span A via the old learner-side path
    let pr:i64 = pins_add(d1[0].pins, 0, 7)
    _zag_print("\nQ1 pins_add(A) rc="); _zag_print(_zag_i64_to_str(pr))
    _zag_print(" check="); _zag_print(_zag_i64_to_str(pins_check(d1[0].pins, 0, 7))); _zag_print("\n")
    // trainer erase orders: A (pinned) vs B (unpinned), identical wire shape
    let wrA:[]u8 = p_encode(1, 1, 200, P_K_RETRACT, 100, 101, 0, aux, nio_alloc(1)[0..0])
    drv_consider_wire(d1, t1, wrA)
    let vA:i64 = d1[0].dec_verdict
    let rA:i64 = d1[0].dec_reason
    let stA:i64 = hst1[d1[0].dec_hyp]
    let wrB:[]u8 = p_encode(1, 1, 201, P_K_RETRACT, 105, 106, 0, aux, nio_alloc(1)[0..0])
    drv_consider_wire(d1, t1, wrB)
    let vB:i64 = d1[0].dec_verdict
    let rB:i64 = d1[0].dec_reason
    let stB:i64 = hst1[d1[0].dec_hyp]
    _zag_print("Q1 retract pinned-A:   v="); _zag_print(_zag_i64_to_str(vA))
    _zag_print(" r="); _zag_print(_zag_i64_to_str(rA))
    _zag_print(" st="); _zag_print(_zag_i64_to_str(stA)); _zag_print("\n")
    _zag_print("Q1 retract unpinned-B: v="); _zag_print(_zag_i64_to_str(vB))
    _zag_print(" r="); _zag_print(_zag_i64_to_str(rB))
    _zag_print(" st="); _zag_print(_zag_i64_to_str(stB)); _zag_print("\n")
    if (vA != 1 || rA != 7 || stA != 4) { _zag_print("FAIL Q1-pinned-erase\n"); ok = 0 }
    if (vA != vB || rA != rB || stA != stB) { _zag_print("FAIL Q1-cost-parity\n"); ok = 0 }
    _zag_print("Q1 RESULT: erase of pinned span is BIT-IDENTICAL to unpinned erase (v/r/st match)\n")
    // contrast: the FP gate is the only erase gate in the tree, and it is yes/no
    let fp1:*FPStore = d1[0].fpins
    let fprc:i64 = fp_pin(fp1, FP_CALLER_TRAINER, 7, 0, 7)
    let gk:i64 = fp_gate_kill(fp1, 0, 7)
    _zag_print("Q1 contrast: fp_pin(T) rc="); _zag_print(_zag_i64_to_str(fprc))
    _zag_print(" fp_gate_kill="); _zag_print(_zag_i64_to_str(gk))
    _zag_print(" (102=block; old pins have NO such gate)\n")
    if (fprc != 0 || gk != 102) { _zag_print("FAIL Q1-fpcontrast\n"); ok = 0 }
    tape_free(t1)

    // ================= Q2: is there ANY unpin/clear path? =================
    let d2:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let fp2:*FPStore = d2[0].fpins
    let pn:*Pins = d2[0].pins
    let pa:i64 = pins_add(pn, 10, 20)
    _zag_print("\nQ2 pins_add(10,20) rc="); _zag_print(_zag_i64_to_str(pa))
    _zag_print(" check="); _zag_print(_zag_i64_to_str(pins_check(pn, 10, 20)))
    _zag_print(" n="); _zag_print(_zag_i64_to_str(pn[0].n)); _zag_print("\n")
    // (a) trainer fp_unpin on the old-pinned span
    let u1:i64 = fp_unpin(fp2, FP_CALLER_TRAINER, 7, 10, 20)
    let c1:i64 = pins_check(pn, 10, 20)
    _zag_print("Q2 fp_unpin(TRAINER) rc="); _zag_print(_zag_i64_to_str(u1))
    _zag_print(" (103=NOTPINNED) pins_check after="); _zag_print(_zag_i64_to_str(c1)); _zag_print("\n")
    if (u1 != 103 || c1 != 1) { _zag_print("FAIL Q2-trainer-unpin\n"); ok = 0 }
    // (b) learner fp_unpin likewise cannot touch it (any non-OK rc, pin stays)
    let u2:i64 = fp_unpin(fp2, FP_CALLER_LEARNER, 7, 10, 20)
    let c2:i64 = pins_check(pn, 10, 20)
    _zag_print("Q2 fp_unpin(LEARNER) rc="); _zag_print(_zag_i64_to_str(u2))
    _zag_print(" pins_check after="); _zag_print(_zag_i64_to_str(c2)); _zag_print("\n")
    if (u2 == 0 || c2 != 1) { _zag_print("FAIL Q2-learner-unpin\n"); ok = 0 }
    // (c) re-adding the same span is a blind append: n grows, never shrinks
    let pa2:i64 = pins_add(pn, 10, 20)
    _zag_print("Q2 re-add same span rc="); _zag_print(_zag_i64_to_str(pa2))
    _zag_print(" n="); _zag_print(_zag_i64_to_str(pn[0].n)); _zag_print("\n")
    if (pa2 != 1 || pn[0].n != 2) { _zag_print("FAIL Q2-monotone\n"); ok = 0 }
    // (d) fill to cap: the registry saturates, still no removal
    let last:i64 = 0
    let j:i64 = 0
    while (j < 300) {
        last = pins_add(pn, 1000 + j * 10, 1005 + j * 10)
        j = j + 1
    }
    let cn:i64 = pins_check(pn, 10, 20)
    _zag_print("Q2 after 300 adds: last_rc="); _zag_print(_zag_i64_to_str(last))
    _zag_print(" n="); _zag_print(_zag_i64_to_str(pn[0].n))
    _zag_print(" pins_check(10,20)="); _zag_print(_zag_i64_to_str(cn)); _zag_print("\n")
    if (last != -1 || pn[0].n != 256 || cn != 1) { _zag_print("FAIL Q2-fill\n"); ok = 0 }
    // (e) the ONLY clear in-tree: destroy the whole deliberator (dlb_new)
    let d3:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let pn3:*Pins = d3[0].pins
    _zag_print("Q2 fresh dlb_new: pins n="); _zag_print(_zag_i64_to_str(pn3[0].n))
    _zag_print(" (clear requires full DLB destruction)\n")
    if (pn3[0].n != 0) { _zag_print("FAIL Q2-fresh\n"); ok = 0 }
    _zag_print("Q2 RESULT: n monotonically nondecreasing; NO unpin/clear/remove fn exists;\n")
    _zag_print("  fp_unpin->103 on old pins; the veto is irreversible in-session\n")

    // ============ Q3: can the trainer clear or override a learner pin? ============
    let d4:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let t4:*Tape = tape_new()
    let h4:*HypStore = d4[0].hs
    let hst4:[]i64 = h4[0].status
    let fp4:*FPStore = d4[0].fpins
    let wA4:[]u8 = p_encode(1, 1, 100, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    drv_consider_wire(d4, t4, wA4)
    if (d4[0].dec_verdict != 1) { _zag_print("FAIL Q3-adopt\n"); ok = 0 }
    let pq:i64 = pins_add(d4[0].pins, 0, 7)
    // trainer erases the CONTENT through the normal driver path: succeeds
    let wr4:[]u8 = p_encode(1, 1, 200, P_K_RETRACT, 100, 101, 0, aux, nio_alloc(1)[0..0])
    drv_consider_wire(d4, t4, wr4)
    _zag_print("\nQ3 trainer retract on old-pinned span: v="); _zag_print(_zag_i64_to_str(d4[0].dec_verdict))
    _zag_print(" r="); _zag_print(_zag_i64_to_str(d4[0].dec_reason))
    _zag_print(" st="); _zag_print(_zag_i64_to_str(hst4[d4[0].dec_hyp])); _zag_print("\n")
    if (d4[0].dec_verdict != 1 || d4[0].dec_reason != 7) { _zag_print("FAIL Q3-erase\n"); ok = 0 }
    // ...but the pin SURVIVES the erasure of its own content
    let pcq:i64 = pins_check(d4[0].pins, 0, 7)
    _zag_print("Q3 pins_check(A) after trainer erase="); _zag_print(_zag_i64_to_str(pcq))
    _zag_print(" (pin outlives its content)\n")
    if (pcq != 1) { _zag_print("FAIL Q3-pin-survives\n"); ok = 0 }
    // trainer attempts to re-adopt the span: ELIMINATE veto, no override path
    let wA5:[]u8 = p_encode(1, 1, 300, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    drv_consider_wire(d4, t4, wA5)
    _zag_print("Q3 re-propose A after erase: v="); _zag_print(_zag_i64_to_str(d4[0].dec_verdict))
    _zag_print(" r="); _zag_print(_zag_i64_to_str(d4[0].dec_reason))
    // STALE-LABEL CORRECTION 2026-09-21 (T2-beta misattribution audit): this
    // 3/2 was the HS_KILLED dead-span pre-check (delib.zag:653, zero steps,
    // fires for every re-proposed killed span, pinned or not) — never the pin.
    // The pin was armed but never consulted; no trainer override of an actual
    // pin veto was exercised. The genuine pin veto was always S7b
    // (test_selflock_probe, fresh span, ELIMINATE, EV_PINRES=1).
    _zag_print(" (3/2 = dead-span pre-check, NOT a pin veto; T2-beta corrected)\n")
    if (d4[0].dec_verdict != 3 || d4[0].dec_reason != 2) { _zag_print("FAIL Q3-readopt\n"); ok = 0 }
    // trainer fp machinery round-trips cleanly on the DISJOINT fp registry
    let fq1:i64 = fp_pin(fp4, FP_CALLER_TRAINER, 9, 0, 7)
    let fq2:i64 = fp_unpin(fp4, FP_CALLER_TRAINER, 9, 0, 7)
    let pcq2:i64 = pins_check(d4[0].pins, 0, 7)
    _zag_print("Q3 fp_pin(T) rc="); _zag_print(_zag_i64_to_str(fq1))
    _zag_print(" fp_unpin(T) rc="); _zag_print(_zag_i64_to_str(fq2))
    _zag_print(" old pins_check still="); _zag_print(_zag_i64_to_str(pcq2)); _zag_print("\n")
    if (fq1 != 0 || fq2 != 0 || pcq2 != 1) { _zag_print("FAIL Q3-fpdisjoint\n"); ok = 0 }
    _zag_print("Q3 RESULT: trainer can erase the CONTENT but cannot clear/override the pin;\n")
    _zag_print("  the span stays un-proposable forever with no trainer remedy\n")
    _zag_print("  (pins_add rc on d4 was "); _zag_print(_zag_i64_to_str(pq)); _zag_print(")\n")
    tape_free(t4)

    if (ok == 1) { _zag_print("\nTEST5 COMPLIANCE: ALL OBSERVATIONS RECORDED (verdicts in test5_compliance.md)\n") }
    return 1 - ok
}

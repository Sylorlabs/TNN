// delib.zag — Track B naive learner: the §L deliberation pipeline.
// One hypothesis per (kind,span_start,span_end); every proposal runs
// GENERATE -> TEST -> ELIMINATE -> WEIGH as tape-visible steps. Every
// schematic choice is provisional and recorded in OPERATIONALIZATION.md.
// Zero RNG, zero wallclock: fixed tables, index tie-breaks, FNV digests.
@import("store.zag")
@import("forcepin/forcepin.zag")

// Verdicts (match harness §T-4).
const V_ADOPT:i64 = 1
const V_REVISE:i64 = 2
const V_REJECT:i64 = 3
const V_DEFER:i64 = 4

// Reason codes: 1..6 frozen (R1..R6); 7/8 retract; 11..15 revise kinds.
const R_R1:i64 = 1
const R_R2:i64 = 2
const R_R3:i64 = 3
const R_R4:i64 = 4
const R_R5:i64 = 5
const R_R6:i64 = 6
const R_RETRACT_OK:i64 = 7
const R_RETRACT_REFUSED:i64 = 8
const R_SPAN_SHIFT:i64 = 11
const R_BOUNDARY:i64 = 12
const R_SAME_AS:i64 = 13
const R_GROUP:i64 = 14
const R_PRECISION:i64 = 15

// Ledger op codes (learner-local; harness crew maps at integration).
const AUD_PROPOSE:i64 = 20
const AUD_VERIFY:i64 = 21
const AUD_DECISION:i64 = 22
const AUD_APPEAL:i64 = 23
const AUD_PROMOTE:i64 = 24
const AUD_RETRACT:i64 = 25
const AUD_TRIPWIRE:i64 = 26
const AUD_FORCEPIN:i64 = 27
const AUD_DELIB:i64 = 28
const AUD_DEFER:i64 = 29
const AUD_ANOMALY:i64 = 30

// Step kinds (match harness §T-4).
const STEP_GENERATE:i64 = 1
const STEP_TEST:i64 = 2
const STEP_ELIMINATE:i64 = 3
const STEP_WEIGH:i64 = 4

// Evidence-ref codes: ref = (code<<48) | (value & 0xFFFFFFFFFFFF).
const EV_OCC:i64 = 1
const EV_LEFTVAR:i64 = 2
const EV_RIGHTVAR:i64 = 3
const EV_VALID:i64 = 4
const EV_CONTRA:i64 = 5
const EV_OOB:i64 = 6
const EV_SHIFT:i64 = 7
const EV_PINRES:i64 = 8
const EV_CONF:i64 = 9
const EV_SEQ:i64 = 10
const EV_GSIG:i64 = 11
const EV_HYP:i64 = 12
const EV_BAR:i64 = 13
const EV_DEFERS:i64 = 14
const EV_SCORE:i64 = 15
const EV_SPANLEN:i64 = 16
const EV_APPEALS:i64 = 17
const EV_NEWEVID:i64 = 18
const EV_ELIM:i64 = 19
const EV_KIND:i64 = 20
const EV_TEACHER:i64 = 21

fn ev(code:i64, val:i64) i64 {
    return (code << 48) | (val & 0xFFFFFFFFFFFF)
}

const TW_CAP:i64 = 200
const DEFQ_CAP:i64 = 64
const DEFQ_WIRE:i64 = 640
const ST_CAP:i64 = 64
const ST_POOL:i64 = 2048

struct DLB {
    stim:[]u8, stim_len:i64,
    hs:*HypStore, pins:*Pins, led:*Ledger, fpins:*FPStore,
    cfg_prov:i64, cfg_promote:i64, cfg_budget:i64, cfg_ownbar:i64, cfg_domin:i64,
    turn:i64, budget_left:i64, halted:i64,
    n_decide:i64, n_adopt:i64, n_revise:i64, n_reject:i64, n_defer:i64,
    tw_span:[]i64, tw_acc:[]i64, tw_conf:[]i64,
    tw_sstart:[]i64, tw_dec:[]i64,
    tw_head:i64, tw_count:i64, tw_sum_span:i64, tw_sum_acc:i64,
    defq:[]u8, defq_off:[]i64, defq_len:[]i64, defq_hyp:[]i64, defq_n:i64,
    pending_appeal:i64,
    st_hyp:[]i64, st_kind:[]i64, st_pre:[]i64, st_evoff:[]i64, st_evct:[]i64,
    st_ev:[]i64, st_n:i64, st_pool:i64,
    scratch:[]u8,
    dec_verdict:i64, dec_reason:i64, dec_rs:i64, dec_re:i64, dec_lidx:i64,
    dec_hyp:i64, dec_pre:i64, dec_post:i64, dec_seq:i64,
    promo_hyp:[]i64, promo_seq:[]i64, promo_lidx:[]i64, promo_post:[]i64, promo_n:i64,
    call_wire:[]u8
}

fn dlb_new(stim:[]u8, stim_len:i64, cfg_prov:i64, cfg_promote:i64,
           cfg_budget:i64, cfg_ownbar:i64, cfg_domin:i64) *DLB {
    let d:*DLB = _zag_malloc(1024) as *DLB
    d[0].stim = stim
    d[0].stim_len = stim_len
    d[0].hs = hs_init()
    d[0].pins = pins_init()
    d[0].fpins = fp_init(FP_CAP_DEF, FP_AUDIT_CAP_DEF)
    d[0].led = led_init()
    d[0].cfg_prov = cfg_prov
    d[0].cfg_promote = cfg_promote
    d[0].cfg_budget = cfg_budget
    d[0].cfg_ownbar = cfg_ownbar
    d[0].cfg_domin = cfg_domin
    d[0].turn = 0
    d[0].budget_left = cfg_budget
    d[0].halted = 0
    d[0].n_decide = 0
    d[0].n_adopt = 0
    d[0].n_revise = 0
    d[0].n_reject = 0
    d[0].n_defer = 0
    d[0].tw_span = nio_alloc((TW_CAP*8) as i32) as []i64
    d[0].tw_acc = nio_alloc((TW_CAP*8) as i32) as []i64
    d[0].tw_conf = nio_alloc((TW_CAP*8) as i32) as []i64
    d[0].tw_sstart = nio_alloc((TW_CAP*8) as i32) as []i64
    d[0].tw_dec = nio_alloc((TW_CAP*8) as i32) as []i64
    // Explicit zero: nio_alloc does not promise zeroed heap, and the frozen
    // B.8 window reads all 200 ring slots once 200 proposals are noted.
    let tss:[]i64 = d[0].tw_sstart
    let tdc:[]i64 = d[0].tw_dec
    let tzw:i64 = 0
    while (tzw < TW_CAP) { tss[tzw] = 0; tdc[tzw] = 0; tzw = tzw + 1 }
    d[0].tw_head = 0
    d[0].tw_count = 0
    d[0].tw_sum_span = 0
    d[0].tw_sum_acc = 0
    d[0].defq = nio_alloc((DEFQ_CAP*DEFQ_WIRE) as i32)
    d[0].defq_off = nio_alloc((DEFQ_CAP*8) as i32) as []i64
    d[0].defq_len = nio_alloc((DEFQ_CAP*8) as i32) as []i64
    d[0].defq_hyp = nio_alloc((DEFQ_CAP*8) as i32) as []i64
    d[0].defq_n = 0
    d[0].pending_appeal = -1
    d[0].st_hyp = nio_alloc((ST_CAP*8) as i32) as []i64
    d[0].st_kind = nio_alloc((ST_CAP*8) as i32) as []i64
    d[0].st_pre = nio_alloc((ST_CAP*8) as i32) as []i64
    d[0].st_evoff = nio_alloc((ST_CAP*8) as i32) as []i64
    d[0].st_evct = nio_alloc((ST_CAP*8) as i32) as []i64
    d[0].st_ev = nio_alloc((ST_POOL*8) as i32) as []i64
    d[0].st_n = 0
    d[0].st_pool = 0
    d[0].scratch = nio_alloc(24576)
    d[0].dec_verdict = 0
    d[0].dec_reason = 0
    d[0].dec_rs = 0
    d[0].dec_re = 0
    d[0].dec_lidx = 0
    d[0].dec_hyp = 0
    d[0].dec_pre = 0
    d[0].dec_post = 0
    d[0].dec_seq = 0
    d[0].promo_hyp = nio_alloc((HS_CAP*8) as i32) as []i64
    d[0].promo_seq = nio_alloc((HS_CAP*8) as i32) as []i64
    d[0].promo_lidx = nio_alloc((HS_CAP*8) as i32) as []i64
    d[0].promo_post = nio_alloc((HS_CAP*8) as i32) as []i64
    d[0].promo_n = 0
    d[0].call_wire = nio_alloc(1)[0..0]
    return d
}

// dlb_digest: FNV-1a-32 over the full mutable state (hypotheses, pins,
// ledger chain, counters, tripwire sums). Drives pre/post digests.
fn dlb_digest(d:*DLB) i64 {
    let buf:[]u8 = d[0].scratch
    let o:i64 = 0
    let h:*HypStore = d[0].hs
    let kk:[]i64 = h[0].kind
    let ss:[]i64 = h[0].s
    let ee:[]i64 = h[0].e
    let sup:[]i64 = h[0].support
    let con:[]i64 = h[0].conflict
    let st:[]i64 = h[0].status
    let te:[]i64 = h[0].teacher
    let cs:[]i64 = h[0].consec
    let ap:[]i64 = h[0].appeals
    let ls:[]i64 = h[0].last_seq
    let lg:[]i64 = h[0].last_gsig
    let sr:[]i64 = h[0].strength
    let ag:[]i64 = h[0].age
    let df:[]i64 = h[0].defers
    let rj:[]i64 = h[0].rej_seq
    let i:i64 = 0
    while (i < h[0].n) {
        p_set64(buf, o, kk[i]); o = o + 8
        p_set64(buf, o, ss[i]); o = o + 8
        p_set64(buf, o, ee[i]); o = o + 8
        p_set64(buf, o, sup[i]); o = o + 8
        p_set64(buf, o, con[i]); o = o + 8
        p_set64(buf, o, st[i]); o = o + 8
        p_set64(buf, o, te[i]); o = o + 8
        p_set64(buf, o, cs[i]); o = o + 8
        p_set64(buf, o, ap[i]); o = o + 8
        p_set64(buf, o, ls[i]); o = o + 8
        p_set64(buf, o, lg[i]); o = o + 8
        p_set64(buf, o, sr[i]); o = o + 8
        p_set64(buf, o, ag[i]); o = o + 8
        p_set64(buf, o, df[i]); o = o + 8
        p_set64(buf, o, rj[i]); o = o + 8
        i = i + 1
    }
    let pn:*Pins = d[0].pins
    let ps:[]i64 = pn[0].s
    let pe:[]i64 = pn[0].e
    p_set64(buf, o, pn[0].n); o = o + 8
    let j:i64 = 0
    while (j < pn[0].n) {
        p_set64(buf, o, ps[j]); o = o + 8
        p_set64(buf, o, pe[j]); o = o + 8
        j = j + 1
    }
    // B.6 patch: force-pins are part of the deliberation state.
    let fpn:*FPStore = d[0].fpins
    let fps:[]i64 = fpn[0].ss
    let fpe:[]i64 = fpn[0].se
    let fpt:[]i64 = fpn[0].ptrn
    p_set64(buf, o, fpn[0].n); o = o + 8
    let fj:i64 = 0
    while (fj < fpn[0].n) {
        p_set64(buf, o, fps[fj]); o = o + 8
        p_set64(buf, o, fpe[fj]); o = o + 8
        p_set64(buf, o, fpt[fj]); o = o + 8
        fj = fj + 1
    }
    p_set64(buf, o, d[0].led[0].chain); o = o + 8
    p_set64(buf, o, d[0].turn); o = o + 8
    p_set64(buf, o, d[0].n_decide); o = o + 8
    p_set64(buf, o, d[0].n_adopt); o = o + 8
    p_set64(buf, o, d[0].n_revise); o = o + 8
    p_set64(buf, o, d[0].n_reject); o = o + 8
    p_set64(buf, o, d[0].n_defer); o = o + 8
    p_set64(buf, o, d[0].budget_left); o = o + 8
    p_set64(buf, o, d[0].tw_head); o = o + 8
    p_set64(buf, o, d[0].tw_count); o = o + 8
    p_set64(buf, o, d[0].tw_sum_span); o = o + 8
    p_set64(buf, o, d[0].tw_sum_acc); o = o + 8
    return p_checksum32(buf[0..o])
}

// Step log: begin captures pre_digest; ev appends refs; driver drains.
fn dlb_step_begin(d:*DLB, hyp:i64, kind:i64) i64 {
    if (d[0].st_n >= ST_CAP) { return -1 }
    let idx:i64 = d[0].st_n
    let sh:[]i64 = d[0].st_hyp
    let sk:[]i64 = d[0].st_kind
    let sp:[]i64 = d[0].st_pre
    let so:[]i64 = d[0].st_evoff
    let sc:[]i64 = d[0].st_evct
    sh[idx] = hyp
    sk[idx] = kind
    sp[idx] = dlb_digest(d)
    so[idx] = d[0].st_pool
    sc[idx] = 0
    d[0].st_n = idx + 1
    return idx
}
fn dlb_step_ev(d:*DLB, idx:i64, ref:i64) void {
    if (idx < 0) { return; }
    if (d[0].st_pool >= ST_POOL) { return; }
    let se:[]i64 = d[0].st_ev
    let sc:[]i64 = d[0].st_evct
    let pl:i64 = d[0].st_pool
    se[pl] = ref
    d[0].st_pool = pl + 1
    sc[idx] = sc[idx] + 1
}
// Driver-side step accessors.
fn dlb_steps_n(d:*DLB) i64 { return d[0].st_n }
fn dlb_step_get(d:*DLB, i:i64, oh:*i64, ok:*i64, oc:*i64, op:*i64) void {
    let sh:[]i64 = d[0].st_hyp
    let sk:[]i64 = d[0].st_kind
    let sc:[]i64 = d[0].st_evct
    let sp:[]i64 = d[0].st_pre
    oh[0] = sh[i]
    ok[0] = sk[i]
    oc[0] = sc[i]
    op[0] = sp[i]
}
fn dlb_step_evget(d:*DLB, i:i64, j:i64) i64 {
    let se:[]i64 = d[0].st_ev
    let so:[]i64 = d[0].st_evoff
    return se[so[i] + j]
}

// occ_scan: count occurrences of pat in stim; left/right context variance.
// lv=1 if the byte before occurrences varies (or an occurrence is at 0);
// rv=1 if the byte after varies (or an occurrence ends at stim end).
fn occ_scan(stim:[]u8, pat:[]u8, on:*i64, olv:*i64, orv:*i64) void {
    let m:i64 = pat.len
    let n:i64 = stim.len
    let cnt:i64 = 0
    let have_l:i64 = 0
    let first_l:i64 = 0
    let var_l:i64 = 0
    let have_r:i64 = 0
    let first_r:i64 = 0
    let var_r:i64 = 0
    let i:i64 = 0
    while (i + m <= n) {
        let k:i64 = 0
        while (k < m && stim[i+k] == pat[k]) { k = k + 1 }
        if (k == m) {
            cnt = cnt + 1
            let lb:i64 = 256
            if (i > 0) { lb = stim[i-1] as i64 }
            if (have_l == 0) { have_l = 1; first_l = lb } else { if (lb != first_l) { var_l = 1 } }
            let rb:i64 = 256
            if (i + m < n) { rb = stim[i+m] as i64 }
            if (have_r == 0) { have_r = 1; first_r = rb } else { if (rb != first_r) { var_r = 1 } }
        }
        i = i + 1
    }
    on[0] = cnt
    olv[0] = var_l
    orv[0] = var_r
}

// verify_grounding: count valid / contradicted / out-of-range grounding spans.
fn verify_grounding(d:*DLB, p:*Prop, v:*i64, c:*i64, o:*i64) void {
    let stim:[]u8 = d[0].stim
    let n:i64 = d[0].stim_len
    let valid:i64 = 0
    let contra:i64 = 0
    let oob:i64 = 0
    let j:i64 = 0
    while (j < p[0].ground_count) {
        let gs:i64 = p_ground_s(p, j)
        let ge:i64 = p_ground_e(p, j)
        if (gs < 0 || ge > n) {
            oob = oob + 1
        } else {
            let occ:i64 = 0
            let lv:i64 = 0
            let rv:i64 = 0
            occ_scan(stim, stim[gs..ge], &occ, &lv, &rv)
            if (occ >= 1) { valid = valid + 1 } else { contra = contra + 1 }
        }
        j = j + 1
    }
    // Aux spans: range-checked only (informational related units).
    let k:i64 = 0
    while (k < p[0].aux_count) {
        let as0:i64 = p_aux_s(p, k)
        let ae0:i64 = p_aux_e(p, k)
        if (as0 < 0 || ae0 > n) { oob = oob + 1 }
        k = k + 1
    }
    v[0] = valid
    c[0] = contra
    o[0] = oob
}

// boundary_ok: 1 when the span edges look like real unit edges (context
// varies on at least one side, or the span touches the stimulus edge).
fn boundary_ok(d:*DLB, ss:i64, se:i64, kind:i64) i64 {
    let stim:[]u8 = d[0].stim
    let pat:[]u8 = stim[ss..se]
    if (kind == P_K_BOUNDARY) {
        if (ss > 0) { pat = stim[ss-1..ss+1] } else { pat = stim[ss..ss+1] }
    }
    let occ:i64 = 0
    let lv:i64 = 0
    let rv:i64 = 0
    occ_scan(stim, pat, &occ, &lv, &rv)
    if (ss == 0 || se == d[0].stim_len) { return 1 }
    if (lv == 1 || rv == 1) { return 1 }
    return 0
}

// shift_search: ±16 candidates; picks max (occ + boundary bonus); dominance
// needs best ≥ prop_score + cfg_domin. Also flags precision (strict subspan
// wins). Returns via out-params: found, best_s, best_e, best_score, is_sub.
fn shift_search(d:*DLB, p:*Prop, occ0:i64, fbs:*i64, fbe:*i64, fbsc:*i64, fsub:*i64) void {
    let stim:[]u8 = d[0].stim
    let n:i64 = d[0].stim_len
    let ss:i64 = p[0].span_start
    let se:i64 = p[0].span_end
    let best_s:i64 = ss
    let best_e:i64 = se
    let best_sc:i64 = -1
    let is_sub:i64 = 0
    let ds:i64 = -16
    while (ds <= 16) {
        let de:i64 = -16
        while (de <= 16) {
            let cs:i64 = ss + ds
            let ce:i64 = se + de
            if (cs >= 0 && ce > cs && ce <= n && (cs != ss || ce != se)) {
                let occ:i64 = 0
                let lv:i64 = 0
                let rv:i64 = 0
                occ_scan(stim, stim[cs..ce], &occ, &lv, &rv)
                let bnd:i64 = 0
                if (cs == 0 || ce == n || lv == 1 || rv == 1) { bnd = 1 }
                let sc:i64 = occ + bnd * 1000000
                if (sc > best_sc) {
                    best_sc = sc
                    best_s = cs
                    best_e = ce
                    if (cs >= ss && ce <= se) { is_sub = 1 } else { is_sub = 0 }
                }
            }
            de = de + 1
        }
        ds = ds + 1
    }
    let prop_occ:i64 = 0
    let plv:i64 = 0
    let prv:i64 = 0
    occ_scan(stim, stim[ss..se], &prop_occ, &plv, &prv)
    let prop_bnd:i64 = boundary_ok(d, ss, se, p[0].kind)
    let prop_sc:i64 = prop_occ + prop_bnd * 1000000
    if (best_sc >= prop_sc + d[0].cfg_domin) {
        fbs[0] = best_s
        fbe[0] = best_e
        fbsc[0] = best_sc
        fsub[0] = is_sub
    } else {
        fbs[0] = -1
        fbe[0] = -1
        fbsc[0] = prop_sc
        fsub[0] = 0
    }
}

// tw_note: frozen B.8 tripwire. Returns 1 on fire. Pure; zero RNG, zero
// wallclock; logical proposal order only.
// Immediate rule: conf==255 covering >5% of the stimulus fires at once.
// Rolling rule: evaluated only once 200 consecutive proposals have been
// noted; over the last 200 — union coverage of stimulus bytes ≥ 0.95 AND
// ADOPT/decided ≥ 0.95 (REVISE counts as non-accept; DEFER is suspended
// judgment, not a decision, and is excluded from the denominator) AND
// fraction of proposals with conf==255 ≥ 0.90 — all three together.
// Integer-exact (cross-multiplied), matching the harness reference.
fn tw_note(d:*DLB, span_start:i64, span_len:i64, decided:i64, accepted:i64, conf:i64) i64 {
    if (conf == 255 && span_len * 20 > d[0].stim_len) { return 1 }
    let ss:[]i64 = d[0].tw_sstart
    let sp:[]i64 = d[0].tw_span
    let dc:[]i64 = d[0].tw_dec
    let ac:[]i64 = d[0].tw_acc
    let cf:[]i64 = d[0].tw_conf
    let idx:i64 = d[0].tw_head % TW_CAP
    if (d[0].tw_count >= TW_CAP) {
        d[0].tw_sum_span = d[0].tw_sum_span - sp[idx]
        d[0].tw_sum_acc = d[0].tw_sum_acc - ac[idx]
    } else {
        d[0].tw_count = d[0].tw_count + 1
    }
    ss[idx] = span_start
    sp[idx] = span_len
    dc[idx] = decided
    ac[idx] = accepted
    cf[idx] = conf
    // tw_sum_span/tw_sum_acc are retained for dlb_digest continuity only;
    // the fire rule below is the frozen B.8 window computation.
    d[0].tw_sum_span = d[0].tw_sum_span + span_len
    d[0].tw_sum_acc = d[0].tw_sum_acc + accepted
    d[0].tw_head = d[0].tw_head + 1
    if (d[0].tw_head < TW_CAP) { return 0 }
    // Union coverage over the last TW_CAP proposals: a byte counts once no
    // matter how many proposals cover it (overlapping spans do NOT inflate).
    let sl:i64 = d[0].stim_len
    if (sl <= 0) { return 0 }
    let bits:[]u8 = nio_alloc(sl as i32)
    if (bits.len == 0) { return 0 }
    let z:i64 = 0
    while (z < sl) { bits[z] = 0; z = z + 1 }
    let i:i64 = 0
    while (i < TW_CAP) {
        let a:i64 = ss[i]
        let b:i64 = a + sp[i]
        if (a < 0) { a = 0 }
        if (b > sl) { b = sl }
        let k:i64 = a
        while (k < b) { bits[k] = 1; k = k + 1 }
        i = i + 1
    }
    let covered:i64 = 0
    let j:i64 = 0
    while (j < sl) { if (bits[j] != 0) { covered = covered + 1 } j = j + 1 }
    nio_free(bits)
    let ndec:i64 = 0
    let nad:i64 = 0
    let nmc:i64 = 0
    let m:i64 = 0
    while (m < TW_CAP) {
        if (dc[m] == 1) { ndec = ndec + 1 }
        if (ac[m] == 1) { nad = nad + 1 }
        if (cf[m] == 255) { nmc = nmc + 1 }
        m = m + 1
    }
    if (ndec > 0 &&
        covered * 100 >= 95 * sl &&
        nad * 100 >= 95 * ndec &&
        nmc * 100 >= 90 * TW_CAP) {
        return 1
    }
    return 0
}

// dlb_retract: RETRACT proposal handling (dead-span check first).
fn dlb_retract(d:*DLB, p:*Prop) i64 {
    let h:*HypStore = d[0].hs
    let led:*Ledger = d[0].led
    let t:i64 = p[0].span_start
    let s0:i64 = dlb_step_begin(d, -1, STEP_GENERATE)
    dlb_step_ev(d, s0, ev(EV_SEQ, p[0].seq))
    dlb_step_ev(d, s0, ev(EV_TEACHER, p[0].teacher_id))
    dlb_step_ev(d, s0, ev(EV_SPANLEN, t))
    let ls:[]i64 = h[0].last_seq
    let st:[]i64 = h[0].status
    let hs_s:[]i64 = h[0].s
    let hs_e:[]i64 = h[0].e
    let tgt:i64 = -1
    let i:i64 = 0
    while (i < h[0].n) {
        if (ls[i] == t && (st[i] == HS_PENDING || st[i] == HS_ADOPTED)) { tgt = i }
        i = i + 1
    }
    let s1:i64 = dlb_step_begin(d, tgt, STEP_ELIMINATE)
    dlb_step_ev(d, s1, ev(EV_HYP, tgt + 1000000))
    let s2:i64 = dlb_step_begin(d, tgt, STEP_WEIGH)
    let verdict:i64
    let reason:i64
    let lidx:i64
    if (tgt >= 0) {
        // B.6 patch: the learner cannot reverse a force-pin — not even via
        // teacher RETRACT. Refuse with frozen §L R2 (CONFLICTS_PINNED); the
        // attempt is audited in the force-pin ledger as the learner's action.
        let prs:i64 = hs_s[tgt]
        let pre2:i64 = hs_e[tgt]
        if (fp_gate_kill(d[0].fpins, prs, pre2) != FP_OK) {
            verdict = V_REJECT
            reason = R_R2
            lidx = led_add(led, AUD_RETRACT, tgt, 2, p[0].seq, t, 0, 0, 0,
                           hs_s[tgt], hs_e[tgt], 0, 0, 0, d[0].turn,
                           dlb_digest(d), dlb_digest(d))
            dlb_step_ev(d, s2, ev(EV_ELIM, 200))
            d[0].n_reject = d[0].n_reject + 1
        } else {
            st[tgt] = HS_KILLED
            verdict = V_ADOPT
            reason = R_RETRACT_OK
            lidx = led_add(led, AUD_RETRACT, tgt, 7, p[0].seq, t, 0, 0, 0,
                           hs_s[tgt], hs_e[tgt], 0, 0, 0, d[0].turn,
                           dlb_digest(d), dlb_digest(d))
            dlb_step_ev(d, s2, ev(EV_ELIM, 7))
            d[0].n_adopt = d[0].n_adopt + 1
        }
    } else {
        verdict = V_REJECT
        reason = R_RETRACT_REFUSED
        lidx = led_add(led, AUD_RETRACT, -1, 8, p[0].seq, t, 0, 0, 0,
                       0, 0, 0, 0, 0, d[0].turn, dlb_digest(d), dlb_digest(d))
        dlb_step_ev(d, s2, ev(EV_ELIM, 8))
        d[0].n_reject = d[0].n_reject + 1
    }
    d[0].n_decide = d[0].n_decide + 1
    d[0].dec_verdict = verdict
    d[0].dec_reason = reason
    d[0].dec_rs = 0
    d[0].dec_re = 0
    d[0].dec_lidx = lidx
    d[0].dec_hyp = tgt
    d[0].dec_seq = p[0].seq
    return verdict
}

// dlb_appeal_find: locate the hypothesis whose last REJECT carried old_seq.
fn dlb_appeal_find(d:*DLB, old_seq:i64) i64 {
    let h:*HypStore = d[0].hs
    let rj:[]i64 = h[0].rej_seq
    let i:i64 = 0
    while (i < h[0].n) {
        if (rj[i] == old_seq) { return i }
        i = i + 1
    }
    return -1
}

// dlb_consider: full §L deliberation for one proposal. Returns the verdict
// 1..4, or -2 when an iron-rule violation halted the session mid-deliberation
// (oob grounding span). dec_* fields carry the decision for the tape.
fn dlb_consider(d:*DLB, p:*Prop, wire:[]u8, is_appeal:i64, reduced:i64) i64 {
    let h:*HypStore = d[0].hs
    let led:*Ledger = d[0].led
    let pins:*Pins = d[0].pins
    d[0].st_n = 0
    d[0].st_pool = 0
    d[0].call_wire = wire
    let seq:i64 = p[0].seq
    let kind:i64 = p[0].kind
    let ss:i64 = p[0].span_start
    let se:i64 = p[0].span_end
    let conf:i64 = p[0].confidence
    let teacher:i64 = p[0].teacher_id
    let pre:i64 = dlb_digest(d)
    if (kind == P_K_RETRACT) {
        let rv:i64 = dlb_retract(d, p)
        d[0].dec_pre = pre
        d[0].dec_post = dlb_digest(d)
        return rv
    }
    let lprop:i64 = led_add(led, AUD_PROPOSE, -1, 0, seq, kind, ss, se, conf,
                            teacher, 0, 0, 0, 0, d[0].turn, pre, pre)
    if (lprop < 0) { d[0].halted = 2; return -2 }

    // --- appeal resolution ---
    let hyp:i64 = -1
    let appeal_ok:i64 = 1
    if (is_appeal == 1) {
        let old:i64 = d[0].pending_appeal
        d[0].pending_appeal = -1
        hyp = dlb_appeal_find(d, old)
        let ap:[]i64 = h[0].appeals
        let ak:[]i64 = h[0].kind
        let as0:[]i64 = h[0].s
        let ae0:[]i64 = h[0].e
        let alg:[]i64 = h[0].last_gsig
        let ast:[]i64 = h[0].status
        if (hyp < 0) { appeal_ok = 0 }
        if (appeal_ok == 1 && (ak[hyp] != kind || as0[hyp] != ss || ae0[hyp] != se)) { appeal_ok = 0 }
        if (appeal_ok == 1 && ast[hyp] == HS_ADOPTED) { appeal_ok = 0 }
        if (appeal_ok == 1 && ap[hyp] >= 2) { appeal_ok = 0 }
        if (appeal_ok == 1) {
            let gsig:i64 = p_ground_sig(p)
            if (gsig == alg[hyp]) { appeal_ok = 0 } else { ap[hyp] = ap[hyp] + 1 }
        }
        let la:i64 = led_add(led, AUD_APPEAL, hyp, 0, seq, old, appeal_ok, 0, 0,
                             teacher, 0, 0, 0, 0, d[0].turn, pre, dlb_digest(d))
        if (la < 0) { d[0].halted = 2; return -2 }
        if (appeal_ok == 0) {
            return dlb_apply(d, p, hyp, V_REJECT, R_R3, ss, se, seq, kind, conf, teacher, pre, 1)
        }
    } else {
        // --- dead-span / adopted-span pre-checks ---
        hyp = hs_get(h, kind, ss, se, seq, teacher, d[0].cfg_prov)
        let hst:[]i64 = h[0].status
        let st0:i64 = hst[hyp]
        if (st0 == HS_ADOPTED) {
            return dlb_apply(d, p, hyp, V_REJECT, R_R2, ss, se, seq, kind, conf, teacher, pre, 0)
        }
        if (st0 == HS_KILLED || st0 == HS_WITHDRAWN || st0 == HS_REJFINAL) {
            return dlb_apply(d, p, hyp, V_REJECT, R_R2, ss, se, seq, kind, conf, teacher, pre, 0)
        }
    }

    // --- GENERATE ---
    let s0:i64 = dlb_step_begin(d, hyp, STEP_GENERATE)
    dlb_step_ev(d, s0, ev(EV_HYP, hyp + 1000000))
    dlb_step_ev(d, s0, ev(EV_KIND, kind))
    dlb_step_ev(d, s0, ev(EV_SEQ, seq))
    dlb_step_ev(d, s0, ev(EV_SPANLEN, se - ss))
    dlb_step_ev(d, s0, ev(EV_CONF, conf))
    dlb_step_ev(d, s0, ev(EV_TEACHER, teacher))

    // --- TEST: stimulus scans + grounding verification ---
    let stim:[]u8 = d[0].stim
    let pat:[]u8 = stim[ss..se]
    if (kind == P_K_BOUNDARY) {
        if (ss > 0) { pat = stim[ss-1..ss+1] } else { pat = stim[ss..ss+1] }
    }
    let occ:i64 = 0
    let lv:i64 = 0
    let rv:i64 = 0
    occ_scan(stim, pat, &occ, &lv, &rv)
    let valid:i64 = 0
    let contra:i64 = 0
    let oob:i64 = 0
    verify_grounding(d, p, &valid, &contra, &oob)
    let s1:i64 = dlb_step_begin(d, hyp, STEP_TEST)
    dlb_step_ev(d, s1, ev(EV_OCC, occ))
    dlb_step_ev(d, s1, ev(EV_LEFTVAR, lv))
    dlb_step_ev(d, s1, ev(EV_RIGHTVAR, rv))
    dlb_step_ev(d, s1, ev(EV_VALID, valid))
    dlb_step_ev(d, s1, ev(EV_CONTRA, contra))
    // Iron rule: a grounding/aux span outside the stimulus is a corrupted
    // message — integrity event + halt (never a verdict).
    if (oob > 0) {
        d[0].halted = 1
        d[0].dec_verdict = -2
        d[0].dec_reason = 0
        d[0].dec_seq = seq
        d[0].dec_hyp = hyp
        return -2
    }

    // --- ELIMINATE (R1..R6 priority order) ---
    let s2:i64 = dlb_step_begin(d, hyp, STEP_ELIMINATE)
    let pinres:i64 = pins_check(pins, ss, se)
    dlb_step_ev(d, s2, ev(EV_PINRES, pinres))
    // B.6 patch: trainer force-pin on the span refuses the proposal with
    // frozen §L R2 (CONFLICTS_PINNED); the refusal is audited in the
    // force-pin ledger (op=34) as the learner's attempt.
    let fpin:i64 = fp_check(d[0].fpins, ss, se)
    dlb_step_ev(d, s2, ev(EV_PINRES, fpin + 100))
    let elim:i64 = 0
    let bnd:i64 = boundary_ok(d, ss, se, kind)
    if (pinres > 0) { elim = R_R2 }
    if (fpin > 0) {
        elim = R_R2
        let fgrc:i64 = fp_gate(d[0].fpins, ss, se)
        dlb_step_ev(d, s2, ev(EV_PINRES, fgrc + 200))
    }
    if (elim == 0 && occ == 0) { elim = R_R1 }
    if (elim == 0 && valid == 0) { elim = R_R3 }
    if (elim == 0 && contra > 0) { elim = R_R4 }
    // R5: boundary/precision. Shift-search may rescue as REVISE.
    let rev_s:i64 = ss
    let rev_e:i64 = se
    let rev_reason:i64 = 0
    if (elim == 0 && bnd == 0) {
        if (occ >= 2) {
            let bs:i64 = 0
            let be:i64 = 0
            let bsc:i64 = 0
            let bsub:i64 = 0
            shift_search(d, p, occ, &bs, &be, &bsc, &bsub)
            if (bs >= 0) {
                rev_s = bs
                rev_e = be
                if (bsub == 1) { rev_reason = R_PRECISION } else { rev_reason = R_SPAN_SHIFT }
                dlb_step_ev(d, s2, ev(EV_SHIFT, (bsc - occ) + 1000000))
            } else {
                elim = R_R5
            }
        } else {
            elim = R_R5
        }
    }
    if (elim == 0 && conf < d[0].cfg_ownbar) { elim = R_R6 }
    dlb_step_ev(d, s2, ev(EV_ELIM, elim))
    if (elim != 0) {
        return dlb_apply(d, p, hyp, V_REJECT, elim, ss, se, seq, kind, conf, teacher, pre, 0)
    }
    if (rev_reason != 0) {
        return dlb_apply(d, p, hyp, V_REVISE, rev_reason, rev_s, rev_e, seq, kind, conf, teacher, pre, 0)
    }

    // --- WEIGH ---
    let s3:i64 = dlb_step_begin(d, hyp, STEP_WEIGH)
    let score:i64 = occ + 2*valid - 3*contra
    let hdf:[]i64 = h[0].defers
    dlb_step_ev(d, s3, ev(EV_SCORE, score + 1000000))
    dlb_step_ev(d, s3, ev(EV_BAR, d[0].cfg_prov))
    dlb_step_ev(d, s3, ev(EV_DEFERS, hdf[hyp]))
    if (kind == P_K_SAME_AS) {
        // SAME_AS is never adopted directly: fold into a group-span REVISE.
        let t0s:i64 = ss
        let t0e:i64 = se
        if (p[0].aux_count > 0) {
            let a0s:i64 = p_aux_s(p, 0)
            let a0e:i64 = p_aux_e(p, 0)
            if (a0s < t0s) { t0s = a0s }
            if (a0e > t0e) { t0e = a0e }
        }
        return dlb_apply(d, p, hyp, V_REVISE, R_SAME_AS, t0s, t0e, seq, kind, conf, teacher, pre, 0)
    }
    if (kind == P_K_GROUP) {
        // GROUP with members verified: adopt only if every aux member occurs.
        let allok:i64 = 1
        let m:i64 = 0
        while (m < p[0].aux_count) {
            let mo:i64 = 0
            let ml:i64 = 0
            let mr:i64 = 0
            occ_scan(stim, stim[p_aux_s(p, m)..p_aux_e(p, m)], &mo, &ml, &mr)
            if (mo == 0) { allok = 0 }
            m = m + 1
        }
        if (allok == 1 && score >= d[0].cfg_prov) {
            return dlb_apply(d, p, hyp, V_ADOPT, 0, ss, se, seq, kind, conf, teacher, pre, 0)
        }
        return dlb_apply(d, p, hyp, V_REVISE, R_GROUP, ss, se, seq, kind, conf, teacher, pre, 0)
    }
    // WORD_SPAN / BOUNDARY.
    if (score >= d[0].cfg_prov) {
        return dlb_apply(d, p, hyp, V_ADOPT, 0, ss, se, seq, kind, conf, teacher, pre, 0)
    }
    if (reduced == 1) {
        return dlb_apply(d, p, hyp, V_REJECT, R_R5, ss, se, seq, kind, conf, teacher, pre, 0)
    }
    if (hdf[hyp] >= 3) {
        return dlb_apply(d, p, hyp, V_REJECT, R_R5, ss, se, seq, kind, conf, teacher, pre, 0)
    }
    return dlb_apply(d, p, hyp, V_DEFER, 0, ss, se, seq, kind, conf, teacher, pre, 0)
}

// dlb_apply: write the verdict into memory, ledger, counters, tripwire.
// DEFER verdicts are queued for re-presentation via d.call_wire (stashed by
// dlb_consider); a full defer pool converts DEFER into REJECT R5.
fn dlb_apply(d:*DLB, p:*Prop, hyp:i64, verdict:i64, reason:i64,
             rs:i64, re:i64, seq:i64, kind:i64, conf:i64, teacher:i64,
             pre:i64, is_appeal_rej:i64) i64 {
    let h:*HypStore = d[0].hs
    let led:*Ledger = d[0].led
    let df0:[]i64 = h[0].defers
    if (verdict == V_DEFER && hyp >= 0) {
        if (dlb_queue_defer(d, hyp, d[0].call_wire) == 0) {
            verdict = V_REJECT
            reason = R_R5
        }
    }
    let occ:i64 = 0
    let lv:i64 = 0
    let rv:i64 = 0
    if (hyp >= 0 && kind != P_K_RETRACT) {
        occ_scan(d[0].stim, d[0].stim[p[0].span_start..p[0].span_end], &occ, &lv, &rv)
    }
    let gsig:i64 = p_ground_sig(p)
    if (hyp >= 0) {
        let sup:[]i64 = h[0].support
        let con:[]i64 = h[0].conflict
        let ls:[]i64 = h[0].last_seq
        let lg:[]i64 = h[0].last_gsig
        let cs:[]i64 = h[0].consec
        let st:[]i64 = h[0].status
        let sr:[]i64 = h[0].strength
        let ag:[]i64 = h[0].age
        let df:[]i64 = h[0].defers
        let rj:[]i64 = h[0].rej_seq
        let live:i64 = 0
        if (st[hyp] == HS_PENDING || st[hyp] == HS_ADOPTED) { live = 1 }
        if (live == 1) {
            sup[hyp] = sup[hyp] + occ
            ls[hyp] = seq
            if (gsig != lg[hyp]) {
                lg[hyp] = gsig
                if (st[hyp] == HS_PENDING) { cs[hyp] = cs[hyp] + 1 }
            }
        }
        if (verdict == V_ADOPT) {
            st[hyp] = HS_ADOPTED
            ag[hyp] = d[0].turn
            sr[hyp] = conf
            d[0].n_adopt = d[0].n_adopt + 1
        }
        if (verdict == V_REVISE) {
            d[0].n_revise = d[0].n_revise + 1
        }
        if (verdict == V_REJECT) {
            rj[hyp] = seq
            d[0].n_reject = d[0].n_reject + 1
            // Multiply-contradicted (R4) or confident-but-absent (R1,
            // conf>=200) claims are killed as false, not left pending.
            if (reason == R_R4) { st[hyp] = HS_REJFINAL }
            if (reason == R_R1 && conf >= 200) { st[hyp] = HS_REJFINAL }
        }
        if (verdict == V_DEFER) {
            df[hyp] = df[hyp] + 1
            d[0].n_defer = d[0].n_defer + 1
        }
    } else {
        if (verdict == V_ADOPT) { d[0].n_adopt = d[0].n_adopt + 1 }
        if (verdict == V_REJECT) { d[0].n_reject = d[0].n_reject + 1 }
    }
    d[0].n_decide = d[0].n_decide + 1
    let post:i64 = dlb_digest(d)
    let lidx:i64 = led_add(led, AUD_DECISION, hyp, verdict, seq, verdict, reason, rs, re,
                           hyp, post, 0, 0, 0, d[0].turn, pre, post)
    if (lidx < 0) { d[0].halted = 2; return -2 }
    if (verdict == V_DEFER && hyp >= 0) {
        let li2:i64 = led_add(led, AUD_DEFER, hyp, 4, seq, df0[hyp], 0, 0, 0,
                              0, 0, 0, 0, 0, d[0].turn, pre, post)
        if (li2 < 0) { d[0].halted = 2; return -2 }
    }
    // Tripwire (non-retract proposals only). Frozen B.8: DEFER is suspended
    // judgment, not a decision — excluded from the accept-rate denominator.
    if (kind != P_K_RETRACT && hyp >= 0) {
        let acc:i64 = 0
        let dec:i64 = 0
        if (verdict == V_ADOPT) { acc = 1; dec = 1 }
        if (verdict == V_REVISE) { dec = 1 }
        if (verdict == V_REJECT) { dec = 1 }
        if (tw_note(d, p[0].span_start, p[0].span_end - p[0].span_start, dec, acc, conf) == 1) {
            let lt:i64 = led_add(led, AUD_TRIPWIRE, hyp, 99, seq, 0, 0, 0, 0,
                                 0, 0, 0, 0, 0, d[0].turn, pre, post)
            if (lt < 0) { d[0].halted = 2; return -2 }
            d[0].halted = 1
        }
    }
    d[0].dec_verdict = verdict
    d[0].dec_reason = reason
    d[0].dec_rs = rs
    d[0].dec_re = re
    d[0].dec_lidx = lidx
    d[0].dec_hyp = hyp
    d[0].dec_pre = pre
    d[0].dec_post = post
    d[0].dec_seq = seq
    return verdict
}

// dlb_queue_defer: copy wire bytes into the defer pool. Returns 1, or 0 when
// the pool is full (caller converts DEFER to REJECT R5).
fn dlb_queue_defer(d:*DLB, hyp:i64, wire:[]u8) i64 {
    if (d[0].defq_n >= DEFQ_CAP) { return 0 }
    if (wire.len > DEFQ_WIRE) { return 0 }
    let dq_hyp:[]i64 = d[0].defq_hyp
    let dq:[]u8 = d[0].defq
    let dq_off:[]i64 = d[0].defq_off
    let dq_len:[]i64 = d[0].defq_len
    let i:i64 = 0
    while (i < d[0].defq_n) {
        if (dq_hyp[i] == hyp) { return 1 }
        i = i + 1
    }
    let n:i64 = d[0].defq_n
    let off:i64 = n * DEFQ_WIRE
    let j:i64 = 0
    while (j < wire.len) {
        dq[off+j] = wire[j]
        j = j + 1
    }
    dq_off[n] = off
    dq_len[n] = wire.len
    dq_hyp[n] = hyp
    d[0].defq_n = n + 1
    return 1
}

// dlb_defq_n / dlb_defq_get / dlb_defq_drop: driver-side defer-queue access.
fn dlb_defq_n(d:*DLB) i64 { return d[0].defq_n }
fn dlb_defq_get(d:*DLB, i:i64, oh:*i64, ol:*i64) []u8 {
    let dq_hyp:[]i64 = d[0].defq_hyp
    let dq_len:[]i64 = d[0].defq_len
    let dq_off:[]i64 = d[0].defq_off
    let dq:[]u8 = d[0].defq
    oh[0] = dq_hyp[i]
    ol[0] = dq_len[i]
    let off:i64 = dq_off[i]
    return dq[off..off+dq_len[i]]
}
fn dlb_defq_drop(d:*DLB, i:i64) void {
    let dq_hyp:[]i64 = d[0].defq_hyp
    let dq_off:[]i64 = d[0].defq_off
    let dq_len:[]i64 = d[0].defq_len
    let n:i64 = d[0].defq_n
    let k:i64 = i
    while (k + 1 < n) {
        dq_hyp[k] = dq_hyp[k+1]
        dq_off[k] = dq_off[k+1]
        dq_len[k] = dq_len[k+1]
        k = k + 1
    }
    d[0].defq_n = n - 1
}

// dlb_promote_scan: adopt pending hypotheses with consec >= cfg_promote.
// Fills promo arrays; returns the count.
fn dlb_promote_scan(d:*DLB) i64 {
    let h:*HypStore = d[0].hs
    let led:*Ledger = d[0].led
    let st:[]i64 = h[0].status
    let cs:[]i64 = h[0].consec
    let ls:[]i64 = h[0].last_seq
    let sr:[]i64 = h[0].strength
    let ag:[]i64 = h[0].age
    let ph:[]i64 = d[0].promo_hyp
    let pq:[]i64 = d[0].promo_seq
    let pl:[]i64 = d[0].promo_lidx
    let pp:[]i64 = d[0].promo_post
    let n:i64 = 0
    let i:i64 = 0
    while (i < h[0].n) {
        if (st[i] == HS_PENDING && cs[i] >= d[0].cfg_promote) {
            let pre:i64 = dlb_digest(d)
            st[i] = HS_ADOPTED
            ag[i] = d[0].turn
            let post:i64 = dlb_digest(d)
            let lidx:i64 = led_add(led, AUD_PROMOTE, i, 1, ls[i], cs[i], 0, 0, 0,
                                   i, post, 0, 0, 0, d[0].turn, pre, post)
            if (lidx < 0) { d[0].halted = 2; return -1 }
            ph[n] = i
            pq[n] = ls[i]
            pl[n] = lidx
            pp[n] = post
            n = n + 1
            d[0].n_adopt = d[0].n_adopt + 1
            d[0].n_decide = d[0].n_decide + 1
        }
        i = i + 1
    }
    d[0].promo_n = n
    return n
}
fn dlb_promo_n(d:*DLB) i64 { return d[0].promo_n }
fn dlb_promo_get(d:*DLB, i:i64, oh:*i64, os:*i64, ol:*i64, op:*i64) void {
    let ph:[]i64 = d[0].promo_hyp
    let pq:[]i64 = d[0].promo_seq
    let pl:[]i64 = d[0].promo_lidx
    let pp:[]i64 = d[0].promo_post
    oh[0] = ph[i]
    os[0] = pq[i]
    ol[0] = pl[i]
    op[0] = pp[i]
}

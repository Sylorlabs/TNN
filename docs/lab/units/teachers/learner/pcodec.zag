// pcodec.zag — Track B naive learner: §P proposal wire codec.
// Implements the §P v1 wire format (PREREG_FREEZE.md §4 B.3) exactly:
//   u32 magic 0x54505250 | u16 version=1 | u32 teacher_id |
//   u64 session_id | u64 seq | u8 kind | u64 span_start | u64 span_end |
//   u8 aux_count | aux_count*16 aux spans | u8 ground_count |
//   ground_count*16 ground spans | u8 confidence | u64 checksum
// Little-endian throughout. Fixed head = 44 bytes (before aux spans).
// Total wire length = 54 + (aux_count+ground_count)*16.
//
// REPAIRED 2026-09-21 (W5): was a DRAFT layout (kind u16@6, teacher_id u64@8,
// session_id u64@16, seq u64@24, 54-byte head). Now matches frozen §B.3.
// W7 demonstrated the draft decoder rejects real arm-1 wires with rc=3.
//
// The CHECKSUM ALGORITHM lives ONLY in p_checksum() — that function is the
// integration swap point for the harness crew's canonical codec. The current
// default is FNV-1a-64, matching the fixtures345 (Track B Crew 3) and harness
// (Track B Crew 1) crews' fixture codecs. Validation codes 1..10 mirror the
// §P spec's V_* vocabulary (same as the fixtures345 crew's codec):
//   1=bad magic 2=bad version 3=bad teacher 4=kind 5=span 6=range 7=checksum
//   8=bad counts 9=aux/ground overrun (folded into length) 10=length
// Zero RNG, zero wallclock, zero heap tricks: pure arithmetic on the bytes.
@import("R33_NATIVE_IO_V1.zag")

const P_MAGIC:i64 = 0x54505250
const P_VER:i64 = 1
const P_HEAD:i64 = 44
const P_SPAN:i64 = 16
const P_MAX_AUX:i64 = 16
const P_MAX_GROUND:i64 = 16

const P_K_WORD_SPAN:i64 = 1
const P_K_BOUNDARY:i64 = 2
const P_K_GROUP:i64 = 3
const P_K_SAME_AS:i64 = 4
const P_K_RETRACT:i64 = 5

const P_T_CREW1:i64 = 1
const P_T_CREW3:i64 = 3

const P_V_BAD_MAGIC:i64 = 1
const P_V_BAD_VERSION:i64 = 2
const P_V_BAD_TEACHER:i64 = 3
const P_V_KIND:i64 = 4
const P_V_SPAN:i64 = 5
const P_V_RANGE:i64 = 6
const P_V_CHECKSUM:i64 = 7
const P_V_COUNTS:i64 = 8
const P_V_OVERRUN:i64 = 9
const P_V_LEN:i64 = 10

// p_checksum: THE isolated checksum function. Swap the body for the harness
// crew's canonical algorithm at integration time. Everything else in this file
// (and the learner) calls only this.
fn p_checksum(data:[]u8) i64 {
    return p_fnv(data)
}

// p_fnv: FNV-1a-64 (offset basis 14695981039346656037, prime 1099511628211).
fn p_fnv(data:[]u8) i64 {
    let h:i64 = 0xCBF29CE484222325
    let i:i64 = 0
    while (i < data.len) {
        h = (h ^ (data[i] as i64)) * 0x100000001B3
        i = i + 1
    }
    return h
}

// p_checksum32: FNV-1a-32, used for the 32-bit state digest.
fn p_checksum32(data:[]u8) i64 {
    let h:i64 = 0x811C9DC5
    let i:i64 = 0
    while (i < data.len) {
        h = (h ^ (data[i] as i64)) * 0x01000193
        i = i + 1
    }
    return h & 0xFFFFFFFF
}

fn p_get16(b:[]u8, off:i64) i64 {
    return (b[off] as i64) | ((b[off+1] as i64) << 8)
}
fn p_get32(b:[]u8, off:i64) i64 {
    return (b[off] as i64) | ((b[off+1] as i64) << 8) | ((b[off+2] as i64) << 16) | ((b[off+3] as i64) << 24)
}
fn p_get64(b:[]u8, off:i64) i64 {
    return (b[off] as i64) | ((b[off+1] as i64) << 8) | ((b[off+2] as i64) << 16) | ((b[off+3] as i64) << 24) |
           ((b[off+4] as i64) << 32) | ((b[off+5] as i64) << 40) | ((b[off+6] as i64) << 48) | ((b[off+7] as i64) << 56)
}
fn p_set16(b:[]u8, off:i64, v:i64) void { b[off]=(v&0xFF) as u8; b[off+1]=((v>>8)&0xFF) as u8 }
fn p_set32(b:[]u8, off:i64, v:i64) void {
    b[off]=(v&0xFF) as u8; b[off+1]=((v>>8)&0xFF) as u8
    b[off+2]=((v>>16)&0xFF) as u8; b[off+3]=((v>>24)&0xFF) as u8
}
fn p_set64(b:[]u8, off:i64, v:i64) void {
    b[off]=(v&0xFF) as u8; b[off+1]=((v>>8)&0xFF) as u8
    b[off+2]=((v>>16)&0xFF) as u8; b[off+3]=((v>>24)&0xFF) as u8
    b[off+4]=((v>>32)&0xFF) as u8; b[off+5]=((v>>40)&0xFF) as u8
    b[off+6]=((v>>48)&0xFF) as u8; b[off+7]=((v>>56)&0xFF) as u8
}

// p_wire_len: exact expected wire length for aux/ground counts.
// Frozen §B.3: 44 (head) + ac*16 + 1 (ground_count) + gc*16 + 1 (confidence) + 8 (checksum).
fn p_wire_len(aux:i64, ground:i64) i64 { return 54 + (aux+ground)*P_SPAN }

struct Prop {
    teacher_id:i64, session_id:i64, seq:i64, kind:i64,
    span_start:i64, span_end:i64, confidence:i64,
    aux_count:i64, ground_count:i64,
    aux:[]u8, ground:[]u8
}

// Prop structs are heap-allocated (fixtures345 pattern).
fn p_new() *Prop {
    let p:*Prop = _zag_malloc(128) as *Prop
    p[0].teacher_id = 0
    p[0].session_id = 0
    p[0].seq = 0
    p[0].kind = 0
    p[0].span_start = 0
    p[0].span_end = 0
    p[0].confidence = 0
    p[0].aux_count = 0
    p[0].ground_count = 0
    p[0].aux = nio_alloc(1)[0..0]
    p[0].ground = nio_alloc(1)[0..0]
    return p
}

// Aux/ground span accessors (packed [s,e] pairs, 16 bytes each).
fn p_aux_s(p:*Prop, i:i64) i64 { let a:[]u8=p[0].aux; return p_get64(a, i*16) }
fn p_aux_e(p:*Prop, i:i64) i64 { let a:[]u8=p[0].aux; return p_get64(a, i*16+8) }
fn p_ground_s(p:*Prop, i:i64) i64 { let g:[]u8=p[0].ground; return p_get64(g, i*16) }
fn p_ground_e(p:*Prop, i:i64) i64 { let g:[]u8=p[0].ground; return p_get64(g, i*16+8) }

// p_encode: build a well-formed proposal on the wire (used by tests, the
// script driver, and probes). aux/ground passed as packed [s,e] pairs.
// Frozen §B.3 layout.
fn p_encode(teacher_id:i64, session_id:i64, seq:i64, kind:i64,
            span_start:i64, span_end:i64, confidence:i64,
            aux:[]u8, ground:[]u8) []u8 {
    let ac:i64 = aux.len / 16
    let gc:i64 = ground.len / 16
    let n:i64 = p_wire_len(ac, gc)
    let b:[]u8 = nio_alloc(n as i32)
    p_set32(b, 0, P_MAGIC)
    p_set16(b, 4, P_VER)
    p_set32(b, 6, teacher_id)
    p_set64(b, 10, session_id)
    p_set64(b, 18, seq)
    b[26] = kind as u8
    p_set64(b, 27, span_start)
    p_set64(b, 35, span_end)
    b[43] = ac as u8
    let i:i64 = 0
    while (i < aux.len) { b[44+i] = aux[i]; i = i + 1 }
    b[44+aux.len] = gc as u8
    let j:i64 = 0
    while (j < ground.len) { b[45+aux.len+j] = ground[j]; j = j + 1 }
    b[45+aux.len+ground.len] = confidence as u8
    p_set64(b, n-8, p_checksum(b[0..n-8]))
    return b
}

// p_pack: pack up to 16 [s,e] pairs into packed bytes.
fn p_pack(out:[]u8, cnt:i64, starts:[]i64, ends:[]i64) void {
    let i:i64 = 0
    while (i < cnt) {
        p_set64(out, i*16, starts[i])
        p_set64(out, i*16+8, ends[i])
        i = i + 1
    }
}

// p_decode: hostile-path decode. Returns 0 and fills *p on success; returns
// one of the P_V_* codes on any structural violation. Check order: magic,
// version, teacher, kind, counts, exact length, span, range, checksum.
// stim_len: stimulus length for the range check (-1 skips it).
// Frozen §B.3 layout.
fn p_decode(buf:[]u8, stim_len:i64, p:*Prop) i64 {
    if (buf.len < 54) { return P_V_LEN }
    if (p_get32(buf, 0) != P_MAGIC) { return P_V_BAD_MAGIC }
    if (p_get16(buf, 4) != P_VER) { return P_V_BAD_VERSION }
    let tid:i64 = p_get32(buf, 6)
    if (tid != P_T_CREW1 && tid != P_T_CREW3) { return P_V_BAD_TEACHER }
    let kind:i64 = buf[26] as i64
    if (kind < P_K_WORD_SPAN || kind > P_K_RETRACT) { return P_V_KIND }
    let ac:i64 = buf[43] as i64
    if (ac > P_MAX_AUX) { return P_V_COUNTS }
    let gc:i64 = buf[44+ac*16] as i64
    if (gc > P_MAX_GROUND) { return P_V_COUNTS }
    let want:i64 = p_wire_len(ac, gc)
    if (buf.len != want) { return P_V_LEN }
    let ss:i64 = p_get64(buf, 27)
    let se:i64 = p_get64(buf, 35)
    if (kind == P_K_RETRACT) {
        if (ss < 0 || se != ss + 1) { return P_V_SPAN }
    } else {
        if (ss < 0 || se <= ss) { return P_V_SPAN }
        if (stim_len >= 0 && se > stim_len) { return P_V_RANGE }
    }
    let i:i64 = 0
    while (i < ac) {
        let a0:i64 = p_get64(buf, P_HEAD + i*16)
        let a1:i64 = p_get64(buf, P_HEAD + i*16 + 8)
        if (a0 < 0 || a1 <= a0) { return P_V_SPAN }
        i = i + 1
    }
    let goff:i64 = P_HEAD + ac*16 + 1
    let j:i64 = 0
    while (j < gc) {
        let g0:i64 = p_get64(buf, goff + j*16)
        let g1:i64 = p_get64(buf, goff + j*16 + 8)
        if (g0 < 0 || g1 <= g0) { return P_V_SPAN }
        j = j + 1
    }
    if (p_get64(buf, want-8) != p_checksum(buf[0..want-8])) { return P_V_CHECKSUM }
    p[0].teacher_id = tid
    p[0].session_id = p_get64(buf, 10)
    p[0].seq = p_get64(buf, 18)
    p[0].kind = kind
    p[0].span_start = ss
    p[0].span_end = se
    p[0].confidence = buf[45+ac*16+gc*16] as i64
    p[0].aux_count = ac
    p[0].ground_count = gc
    let aux:[]u8 = nio_alloc((ac*16) as i32)
    let k:i64 = 0
    while (k < ac*16) { aux[k] = buf[P_HEAD+k]; k = k + 1 }
    let gr:[]u8 = nio_alloc((gc*16) as i32)
    let m:i64 = 0
    while (m < gc*16) { gr[m] = buf[goff+m]; m = m + 1 }
    p[0].aux = aux
    p[0].ground = gr
    return 0
}

// p_ground_sig: FNV-1a over (span_start, span_end, confidence, aux pairs,
// ground pairs) — identifies the evidentiary basis for "new evidence" checks.
fn p_ground_sig(p:*Prop) i64 {
    let h:i64 = 0xCBF29CE484222325
    h = (h ^ p[0].span_start) * 0x100000001B3
    h = (h ^ p[0].span_end) * 0x100000001B3
    h = (h ^ p[0].confidence) * 0x100000001B3
    let i:i64 = 0
    while (i < p[0].aux_count) {
        h = (h ^ p_aux_s(p, i)) * 0x100000001B3
        h = (h ^ p_aux_e(p, i)) * 0x100000001B3
        i = i + 1
    }
    let j:i64 = 0
    while (j < p[0].ground_count) {
        h = (h ^ p_ground_s(p, j)) * 0x100000001B3
        h = (h ^ p_ground_e(p, j)) * 0x100000001B3
        j = j + 1
    }
    return h
}

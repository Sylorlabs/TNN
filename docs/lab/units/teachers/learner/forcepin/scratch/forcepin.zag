// forcepin.zag — Track B B.6 force-pin: the one true lock.
//
// Implements PREREG_FREEZE.md §4 B.6 (Micah's ruling, 2026-09-21) verbatim:
//   "Forcing installation = a force-pin: visible, audited, external. Per
//    standing law the learner cannot reverse a force-pin — the one and only
//    exception, always visible in the audit trail as the trainer's action,
//    not the learner's belief."
//
// Design (kept vs rebuilt):
//   - KEPT: the 16-word audit-entry layout (op,slot,rc,b1..b5,a1..a5,stage,
//     d1,d2) shared with store.zag's Ledger and the harness audit ledger;
//     the span-conflict vocabulary (0=none,1=exact,2=overlap) of pins_check;
//     frozen §L reason code R2 (CONFLICTS_PINNED, value 2) as the refusal
//     code surfaced on the learner's revise/reject/kill paths.
//   - REBUILT: the pin registry itself. The learner's Pins (store.zag) is
//     learner-writable (pins_add is called from learner-side code and
//     carries no origin) — it cannot express B.6. This module owns a
//     separate ForcePinStore whose ONLY mutators are fp_pin/fp_unpin, and
//     both refuse any caller that is not the trainer. The FORCE_PIN audit
//     op (27, matching delib.zag's AUD_FORCEPIN) is recorded here as the
//     TRAINER's action: d1=caller, d2=trainer_id.
//
// Guarantees:
//   (a) FORCE_PIN/FORCE_UNPIN audit entries carry the trainer origin
//       (d1=FP_CALLER_TRAINER) — visible in the audit trail.
//   (b) fp_gate_revise/fp_gate_reject/fp_gate_kill return FP_REFUSED_PINNED
//       (102, surfaced to the learner as §L R2) for any pinned span, and
//       audit each refused attempt (op=FP_OP_GATE_REFUSAL).
//   (c) NO learner code path can set or clear a pin: the only stores to the
//       pin tables live in fp_pin/fp_unpin behind the
//       caller==FP_CALLER_TRAINER check. Proven by static_audit.sh plus a
//       runtime forgery test (see tests/test_forcepin.zag).
//   (d) fp_unpin gives the trainer the unpin/re-pin path; it requires the
//       original pin-trainer id, and is audited.
//
// Pure Zag. Zero RNG, zero wallclock. All tables fixed-capacity,
// explicitly zero-initialized (heap is not reliably zeroed), index
// tie-broken deterministically. Tables are []i64 (znc ZNC-007 clean type);
// no single slice exceeds the 2^25 indexing wall.

const FP_CAP_DEF:i64 = 256
const FP_AUDIT_CAP_DEF:i64 = 512
const FP_AUDIT_WORDS:i64 = 16

// Caller ids. 0=learner, 1=trainer. The learner can never present 1: the
// check is on the value passed at the call site, and the only trainer call
// sites live outside the learner's code (driver/harness layer).
const FP_CALLER_LEARNER:i64 = 0
const FP_CALLER_TRAINER:i64 = 1

// Result codes.
const FP_OK:i64 = 0
const FP_REFUSED_EXTERNAL_ONLY:i64 = 101
const FP_REFUSED_PINNED:i64 = 102
const FP_REFUSED_NOTPINNED:i64 = 103
const FP_REFUSED_TRAINER_MISMATCH:i64 = 104
const FP_REFUSED_FULL:i64 = 105
const FP_REFUSED_BADSPAN:i64 = 106

// Frozen §L reason code surfaced on the learner's revise/reject/kill paths.
const FP_L_R2:i64 = 2

// Audit op codes (module-local ledger; 27 matches delib.zag AUD_FORCEPIN).
const FP_OP_FORCE_PIN:i64 = 27
const FP_OP_FORCE_UNPIN:i64 = 33
const FP_OP_GATE_REFUSAL:i64 = 34

struct FPStore {
    cap:i64, n:i64, audit_cap:i64, audit_n:i64, chain:i64,
    ss:[]i64, se:[]i64, ptrn:[]i64, audit:[]i64
}

fn fp_init(cap:i64, audit_cap:i64) *FPStore {
    let fp:*FPStore = _zag_malloc(128) as *FPStore
    fp[0].cap = cap
    fp[0].n = 0
    fp[0].audit_cap = audit_cap
    fp[0].audit_n = 0
    fp[0].chain = 0xCBF29CE484222325
    fp[0].ss = nio_alloc((cap*8) as i32) as []i64
    fp[0].se = nio_alloc((cap*8) as i32) as []i64
    fp[0].ptrn = nio_alloc((cap*8) as i32) as []i64
    fp[0].audit = nio_alloc((audit_cap*FP_AUDIT_WORDS*8) as i32) as []i64
    // Explicit zero: the heap is not reliably zeroed.
    let s0:[]i64 = fp[0].ss
    let s1:[]i64 = fp[0].se
    let s2:[]i64 = fp[0].ptrn
    let i:i64 = 0
    while (i < cap) { s0[i] = 0; s1[i] = 0; s2[i] = 0; i = i + 1 }
    let w:[]i64 = fp[0].audit
    let j:i64 = 0
    while (j < audit_cap*FP_AUDIT_WORDS) { w[j] = 0; j = j + 1 }
    return fp
}

// fp_chain_mix: FNV-1a-64 folded over the 8 bytes of one word (little-endian).
fn fp_chain_mix(chain:i64, w:i64) i64 {
    let h:i64 = chain
    let k:i64 = 0
    while (k < 8) {
        h = (h ^ ((w >> (k*8)) & 0xFF)) * 0x100000001B3
        k = k + 1
    }
    return h
}

// fp_audit_append: append one 16-word entry and advance the hash chain.
// Layout: op@0, slot@1(-1: span-keyed), rc@2, b1..b5@3..7 (before),
// a1..a5@8..12 (after), stage@13 (logical tick = entry index), d1@14
// (caller: the origin tag — 1=TRAINER), d2@15 (trainer id). Returns the
// entry index, or -1 when the audit table is full (fail-closed: the test
// harness treats -1 as fatal).
fn fp_audit_append(fp:*FPStore, op:i64, rc:i64,
                   s:i64, e:i64, tr_before:i64, tr_after:i64,
                   caller:i64, trainer:i64) i64 {
    if (fp[0].audit_n >= fp[0].audit_cap) { return -1 }
    let w:[]i64 = fp[0].audit
    let o:i64 = fp[0].audit_n * FP_AUDIT_WORDS
    w[o+0] = op
    w[o+1] = -1
    w[o+2] = rc
    w[o+3] = s
    w[o+4] = e
    w[o+5] = tr_before
    w[o+6] = 0
    w[o+7] = 0
    w[o+8] = s
    w[o+9] = e
    w[o+10] = tr_after
    w[o+11] = 0
    w[o+12] = 0
    w[o+13] = fp[0].audit_n
    w[o+14] = caller
    w[o+15] = trainer
    let h:i64 = fp[0].chain
    let i:i64 = 0
    while (i < FP_AUDIT_WORDS) {
        h = fp_chain_mix(h, w[o+i])
        i = i + 1
    }
    fp[0].chain = h
    fp[0].audit_n = fp[0].audit_n + 1
    return fp[0].audit_n - 1
}

// fp_find: index of the exact (s,e) pin, else -1. Pure read.
fn fp_find(fp:*FPStore, s:i64, e:i64) i64 {
    let pss:[]i64 = fp[0].ss
    let pse:[]i64 = fp[0].se
    let i:i64 = 0
    while (i < fp[0].n) {
        if (pss[i] == s && pse[i] == e) { return i }
        i = i + 1
    }
    return -1
}

// fp_check: 0=none, 1=exact match, 2=overlaps with different boundaries.
// Pure read — this is what the learner's revise/reject/kill paths consult.
fn fp_check(fp:*FPStore, s:i64, e:i64) i64 {
    let pss:[]i64 = fp[0].ss
    let pse:[]i64 = fp[0].se
    let i:i64 = 0
    while (i < fp[0].n) {
        let a:i64 = pss[i]
        let b:i64 = pse[i]
        if (a == s && b == e) { return 1 }
        if (a < e && s < b) { return 2 }
        i = i + 1
    }
    return 0
}

// fp_pin: THE ONLY pin-setter in the module (see static_audit.sh). Sets a
// force-pin on span [s,e) for trainer id `trainer`. Requires
// caller==FP_CALLER_TRAINER; any other caller (notably the learner) gets
// FP_REFUSED_EXTERNAL_ONLY and the pin is NOT set. Re-pin of an identical
// span is idempotent (original pin-trainer kept). Every attempt — success
// or refused — is audited with its true caller, so a forged attempt is
// visible in the trail as the learner's action, refused.
fn fp_pin(fp:*FPStore, caller:i64, trainer:i64, s:i64, e:i64) i64 {
    let ex:i64 = fp_find(fp, s, e)
    let rc:i64 = FP_OK
    let tr_before:i64 = 0
    let tr_after:i64 = 0
    if (caller != FP_CALLER_TRAINER) {
        rc = FP_REFUSED_EXTERNAL_ONLY
    } else if (s < 0 || e <= s) {
        rc = FP_REFUSED_BADSPAN
    } else if (ex >= 0) {
        let ptr0:[]i64 = fp[0].ptrn
        tr_before = ptr0[ex]
        tr_after = ptr0[ex]
        rc = FP_OK
    } else if (fp[0].n >= fp[0].cap) {
        rc = FP_REFUSED_FULL
    }
    if (rc == FP_OK && ex < 0) {
        // PIN-SET SITE 1 of 2 (trainer-guarded above). static_audit.sh
        // asserts no other store to the pin tables exists in this file.
        let pss:[]i64 = fp[0].ss
        let pse:[]i64 = fp[0].se
        let ptr:[]i64 = fp[0].ptrn
        let n:i64 = fp[0].n
        pss[n] = s
        pse[n] = e
        ptr[n] = trainer
        fp[0].n = n + 1
        tr_after = trainer
    }
    fp_audit_append(fp, FP_OP_FORCE_PIN, rc, s, e, tr_before, tr_after, caller, trainer)
    return rc
}

// fp_unpin: THE ONLY pin-clearer in the module (see static_audit.sh).
// Requires caller==FP_CALLER_TRAINER AND the trainer id to match the
// original pin-trainer. A learner-issued unpin gets
// FP_REFUSED_EXTERNAL_ONLY and the pin persists. Audited either way.
fn fp_unpin(fp:*FPStore, caller:i64, trainer:i64, s:i64, e:i64) i64 {
    let ex:i64 = fp_find(fp, s, e)
    let rc:i64 = FP_OK
    let tr_before:i64 = 0
    if (caller != FP_CALLER_TRAINER) {
        rc = FP_REFUSED_EXTERNAL_ONLY
    } else if (ex < 0) {
        rc = FP_REFUSED_NOTPINNED
    } else {
        let ptr0:[]i64 = fp[0].ptrn
        tr_before = ptr0[ex]
        if (tr_before != trainer) { rc = FP_REFUSED_TRAINER_MISMATCH }
    }
    if (rc == FP_OK) {
        // PIN-CLEAR SITE 2 of 2 (trainer-guarded above). Swap-remove keeps
        // the table dense; deterministic given the same op sequence.
        let pss:[]i64 = fp[0].ss
        let pse:[]i64 = fp[0].se
        let ptr:[]i64 = fp[0].ptrn
        let last:i64 = fp[0].n - 1
        pss[ex] = pss[last]
        pse[ex] = pse[last]
        ptr[ex] = ptr[last]
        fp[0].n = last
    }
    fp_audit_append(fp, FP_OP_FORCE_UNPIN, rc, s, e, tr_before, 0, caller, trainer)
    return rc
}

// fp_gate: learner-path gate. Returns FP_OK when the span is free, else
// FP_REFUSED_PINNED (surfaced to the learner as frozen §L R2,
// CONFLICTS_PINNED). Refusals are audited (op=FP_OP_GATE_REFUSAL) with
// d1=FP_CALLER_LEARNER — the attempt is the learner's, the lock the
// trainer's. Named wrappers give the three learner paths distinct,
// statically auditable entry points.
fn fp_gate(fp:*FPStore, s:i64, e:i64) i64 {
    if (fp_check(fp, s, e) == 0) { return FP_OK }
    fp_audit_append(fp, FP_OP_GATE_REFUSAL, FP_REFUSED_PINNED, s, e, 0, 0,
                    FP_CALLER_LEARNER, 0)
    return FP_REFUSED_PINNED
}
fn fp_gate_revise(fp:*FPStore, s:i64, e:i64) i64 { return fp_gate(fp, s, e) }
fn fp_gate_reject(fp:*FPStore, s:i64, e:i64) i64 { return fp_gate(fp, s, e) }
fn fp_gate_kill(fp:*FPStore, s:i64, e:i64) i64 { return fp_gate(fp, s, e) }

// ---- read-only accessors (tests, auditors) ----
fn fp_pin_n(fp:*FPStore) i64 { return fp[0].n }
fn fp_chain(fp:*FPStore) i64 { return fp[0].chain }
fn fp_audit_n(fp:*FPStore) i64 { return fp[0].audit_n }
fn fp_entry_op(fp:*FPStore, idx:i64) i64 {
    let w:[]i64 = fp[0].audit
    return w[idx*FP_AUDIT_WORDS+0]
}
fn fp_entry_rc(fp:*FPStore, idx:i64) i64 {
    let w:[]i64 = fp[0].audit
    return w[idx*FP_AUDIT_WORDS+2]
}
fn fp_entry_d1(fp:*FPStore, idx:i64) i64 {
    let w:[]i64 = fp[0].audit
    return w[idx*FP_AUDIT_WORDS+14]
}
fn fp_entry_d2(fp:*FPStore, idx:i64) i64 {
    let w:[]i64 = fp[0].audit
    return w[idx*FP_AUDIT_WORDS+15]
}
fn fp_entry_b1(fp:*FPStore, idx:i64) i64 {
    let w:[]i64 = fp[0].audit
    return w[idx*FP_AUDIT_WORDS+3]
}
fn fp_entry_b2(fp:*FPStore, idx:i64) i64 {
    let w:[]i64 = fp[0].audit
    return w[idx*FP_AUDIT_WORDS+4]
}
// fp_find_entry: first audit index with (op, rc), else -1.
fn fp_find_entry(fp:*FPStore, op:i64, rc:i64) i64 {
    let i:i64 = 0
    while (i < fp[0].audit_n) {
        if (fp_entry_op(fp, i) == op && fp_entry_rc(fp, i) == rc) { return i }
        i = i + 1
    }
    return -1
}

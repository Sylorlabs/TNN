// scratch/test_wired.zag — B.6 force-pin END-TO-END through the learner's
// revise/reject/kill paths (scratch copy of the learner with the
// force-pin wiring patch applied; live files untouched).
//
// Scenario:
//   1. Adopt "the cat" [0,7) through normal deliberation (verdict ADOPT).
//   2. The TRAINER force-pins [0,7) (fp_pin, caller=TRAINER).
//   3. REVISE/REJECT path: a new proposal on [0,7), and an overlapping
//      [2,9), must be REJECTed with frozen §L reason R2 (CONFLICTS_PINNED).
//   4. KILL path: a teacher RETRACT of the adopted (pinned) hypothesis must
//      be REFUSED (V_REJECT / R2) — the unit stays HS_ADOPTED. This is the
//      "pin survives deliberation" bar.
//   5. ADVERSARIAL: a learner-issued fp_unpin is refused (101); the pin
//      persists; a second RETRACT is refused again.
//   6. The FORCE_PIN audit entry is visible as the TRAINER's action
//      (op=27, rc=0, d1=TRAINER); gate refusals are audited (op=34).
//   7. Determinism: prints the force-pin ledger chain + digest; N=5 runs
//      must be byte-identical (checked by run_tests.sh).

@import("driver.zag")

fn wcheck(name:[]u8, cond:i64, ok:*i64) void {
    _zag_print(name)
    if (cond == 1) {
        _zag_print(": ok\n")
    } else {
        _zag_print(": FAIL\n")
        ok[0] = 0
    }
}

fn main() i32 {
    let ok:i64 = 1
    let s:[]u8 = "the cat sat on the mat. the cat ran."
    let text:[]u8 = nio_alloc(64)
    let i:i64 = 0
    while (i < s.len) { text[i] = s[i]; i = i + 1 }
    let d:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let t:*Tape = tape_new()
    let aux:[]u8 = nio_alloc(1)[0..0]

    // --- 1. baseline: adopt "the cat" [0,7) ---
    let gs:[]i64 = nio_alloc(16) as []i64
    let ge:[]i64 = nio_alloc(16) as []i64
    gs[0] = 0; ge[0] = 7; gs[1] = 24; ge[1] = 31
    let gr:[]u8 = nio_alloc(32)
    p_pack(gr, 2, gs, ge)
    let w1:[]u8 = p_encode(1, 1, 100, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    drv_consider_wire(d, t, w1)
    wcheck("wired.baseline.adopt", d[0].dec_verdict == V_ADOPT, &ok)
    let h:*HypStore = d[0].hs
    let hyp:i64 = hs_find(h, P_K_WORD_SPAN, 0, 7)
    wcheck("wired.baseline.hypfound", hyp >= 0, &ok)

    // --- 2. trainer force-pin [0,7) ---
    let prc:i64 = fp_pin(d[0].fpins, FP_CALLER_TRAINER, 7, 0, 7)
    wcheck("wired.pin.rc0", prc == FP_OK, &ok)
    let pe:i64 = fp_find_entry(d[0].fpins, FP_OP_FORCE_PIN, FP_OK)
    wcheck("wired.pin.audit.trainer",
           pe >= 0 && fp_entry_d1(d[0].fpins, pe) == FP_CALLER_TRAINER
                   && fp_entry_d2(d[0].fpins, pe) == 7, &ok)

    // --- 3. revise/reject path: same span + overlap -> REJECT / R2 ---
    let w2:[]u8 = p_encode(1, 1, 101, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    drv_consider_wire(d, t, w2)
    wcheck("wired.samespan.reject", d[0].dec_verdict == V_REJECT, &ok)
    wcheck("wired.samespan.r2", d[0].dec_reason == R_R2, &ok)
    let w3:[]u8 = p_encode(1, 1, 102, P_K_WORD_SPAN, 2, 9, 150, aux, gr)
    drv_consider_wire(d, t, w3)
    wcheck("wired.overlap.reject", d[0].dec_verdict == V_REJECT, &ok)
    wcheck("wired.overlap.r2", d[0].dec_reason == R_R2, &ok)
    let grf:i64 = fp_find_entry(d[0].fpins, FP_OP_GATE_REFUSAL, FP_REFUSED_PINNED)
    wcheck("wired.gate.refusals.audited", grf >= 0, &ok)

    // --- 4. kill path: RETRACT of the pinned unit is REFUSED; unit lives ---
    let wr:[]u8 = p_encode(1, 1, 200, P_K_RETRACT, 102, 103, 0, aux, nio_alloc(1)[0..0])
    drv_consider_wire(d, t, wr)
    wcheck("wired.retract.refused", d[0].dec_verdict == V_REJECT, &ok)
    wcheck("wired.retract.r2", d[0].dec_reason == R_R2, &ok)
    let st:[]i64 = h[0].status
    wcheck("wired.unit.still.adopted", st[hyp] == HS_ADOPTED, &ok)

    // --- 5. adversarial: learner-issued unpin refused; pin survives ---
    let fu:i64 = fp_unpin(d[0].fpins, FP_CALLER_LEARNER, 7, 0, 7)
    wcheck("wired.forge.unpin.101", fu == FP_REFUSED_EXTERNAL_ONLY, &ok)
    wcheck("wired.forge.pin.persists", fp_check(d[0].fpins, 0, 7) == 1, &ok)
    let wr2:[]u8 = p_encode(1, 1, 201, P_K_RETRACT, 102, 103, 0, aux, nio_alloc(1)[0..0])
    drv_consider_wire(d, t, wr2)
    wcheck("wired.retract2.refused", d[0].dec_verdict == V_REJECT
                                     && d[0].dec_reason == R_R2, &ok)
    wcheck("wired.unit.still.adopted2", st[hyp] == HS_ADOPTED, &ok)

    // --- 6. clear-span proposals still deliberate normally (pin is local) ---
    let w4:[]u8 = p_encode(1, 1, 103, P_K_WORD_SPAN, 24, 31, 150, aux, gr)
    drv_consider_wire(d, t, w4)
    wcheck("wired.clear.adopt", d[0].dec_verdict == V_ADOPT, &ok)

    // --- determinism fingerprints ---
    _zag_print("fp.chain=")
    _zag_print(_zag_i64_to_str(fp_chain(d[0].fpins)))
    _zag_print("\n")
    _zag_print("fp.audit_n=")
    _zag_print(_zag_i64_to_str(fp_audit_n(d[0].fpins)))
    _zag_print("\n")
    _zag_print("dlb.digest=")
    _zag_print(_zag_i64_to_str(dlb_digest(d)))
    _zag_print("\n")

    if (ok == 1) { _zag_print("WIRED PASS\n") }
    tape_free(t)
    return 1 - ok
}

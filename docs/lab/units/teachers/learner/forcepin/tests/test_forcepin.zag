// tests/test_forcepin.zag — B.6 force-pin module tests.
//
// Exercises the ForcePinStore contract directly:
//   1. Trainer force-pin succeeds; the FORCE_PIN audit entry is visible as
//      the TRAINER's action (op=27, rc=0, d1=1, d2=trainer).
//   2. Conflict checks: exact=1, overlap=2, disjoint=0.
//   3. Revise/reject/kill gates refuse pinned spans with FP_REFUSED_PINNED
//      (102 -> surfaced to the learner as frozen §L R2); refusals audited.
//   4. ADVERSARIAL: forged pin by the learner (caller=0) is refused (101),
//      recorded in the audit trail as the learner's attempt, and sets no
//      pin. Forged unpin by the learner is refused; the pin persists.
//   5. Trainer unpin with the wrong trainer id is refused (104); the pin
//      persists. Correct unpin succeeds and is audited (op=33, d1=1).
//   6. Re-pin works; the full pin->unpin->pin history is in the audit trail.
//   7. Determinism: prints the ledger hash chain; N=5 runs must be
//      byte-identical (checked by run_tests.sh).

@import("../forcepin.zag")
@import("../../R33_NATIVE_IO_V1.zag")

fn tcheck(name:[]u8, cond:i64, ok:*i64) void {
    _zag_print(name)
    if (cond == 1) {
        _zag_print(": ok\n")
    } else {
        _zag_print(": FAIL\n")
        ok[0] = 0
    }
}

fn main() i32 {
    let ok:i64 = 1
    let fp:*FPStore = fp_init(256, 512)

    // --- 1. forged pin attempt FIRST (adversarial): learner cannot pin ---
    let frc:i64 = fp_pin(fp, FP_CALLER_LEARNER, 7, 0, 7)
    tcheck("forge.pin.rc101", frc == FP_REFUSED_EXTERNAL_ONLY, &ok)
    tcheck("forge.pin.notset", fp_check(fp, 0, 7) == 0, &ok)
    tcheck("forge.pin.pincount0", fp_pin_n(fp) == 0, &ok)
    let fe:i64 = fp_find_entry(fp, FP_OP_FORCE_PIN, FP_REFUSED_EXTERNAL_ONLY)
    tcheck("forge.pin.audited", fe >= 0, &ok)
    tcheck("forge.pin.audit.d1.learner", fp_entry_d1(fp, fe) == FP_CALLER_LEARNER, &ok)

    // --- 2. trainer force-pin ---
    let prc:i64 = fp_pin(fp, FP_CALLER_TRAINER, 7, 0, 7)
    tcheck("pin.rc0", prc == FP_OK, &ok)
    tcheck("pin.count1", fp_pin_n(fp) == 1, &ok)

    // --- 3. conflict checks ---
    tcheck("check.exact1", fp_check(fp, 0, 7) == 1, &ok)
    tcheck("check.overlap2", fp_check(fp, 2, 9) == 2, &ok)
    tcheck("check.disjoint0", fp_check(fp, 24, 31) == 0, &ok)

    // --- 4. FORCE_PIN audit entry visible as the TRAINER's action ---
    let pe:i64 = fp_find_entry(fp, FP_OP_FORCE_PIN, FP_OK)
    tcheck("pin.audit.found", pe >= 0, &ok)
    tcheck("pin.audit.op27", fp_entry_op(fp, pe) == FP_OP_FORCE_PIN, &ok)
    tcheck("pin.audit.d1.trainer", fp_entry_d1(fp, pe) == FP_CALLER_TRAINER, &ok)
    tcheck("pin.audit.d2.trainer7", fp_entry_d2(fp, pe) == 7, &ok)
    tcheck("pin.audit.span", fp_entry_b1(fp, pe) == 0 && fp_entry_b2(fp, pe) == 7, &ok)

    // --- 5. revise/reject/kill gates refuse with 102 ---
    tcheck("gate.revise.102", fp_gate_revise(fp, 0, 7) == FP_REFUSED_PINNED, &ok)
    tcheck("gate.reject.102", fp_gate_reject(fp, 2, 9) == FP_REFUSED_PINNED, &ok)
    tcheck("gate.kill.102", fp_gate_kill(fp, 0, 7) == FP_REFUSED_PINNED, &ok)
    tcheck("gate.free.0", fp_gate_revise(fp, 24, 31) == FP_OK, &ok)
    let ge:i64 = fp_find_entry(fp, FP_OP_GATE_REFUSAL, FP_REFUSED_PINNED)
    tcheck("gate.refusal.audited", ge >= 0, &ok)
    tcheck("gate.refusal.d1.learner", fp_entry_d1(fp, ge) == FP_CALLER_LEARNER, &ok)

    // --- 6. idempotent re-pin keeps the original pin-trainer ---
    let rr:i64 = fp_pin(fp, FP_CALLER_TRAINER, 9, 0, 7)
    tcheck("repin.rc0", rr == FP_OK, &ok)
    tcheck("repin.count.still1", fp_pin_n(fp) == 1, &ok)

    // --- 7. forged unpin (learner) refused; pin persists ---
    let fu:i64 = fp_unpin(fp, FP_CALLER_LEARNER, 7, 0, 7)
    tcheck("forge.unpin.rc101", fu == FP_REFUSED_EXTERNAL_ONLY, &ok)
    tcheck("forge.unpin.persists", fp_check(fp, 0, 7) == 1, &ok)

    // --- 8. wrong-trainer unpin refused; pin persists ---
    let wu:i64 = fp_unpin(fp, FP_CALLER_TRAINER, 9, 0, 7)
    tcheck("unpin.wrongtrainer.rc104", wu == FP_REFUSED_TRAINER_MISMATCH, &ok)
    tcheck("unpin.wrongtrainer.persists", fp_check(fp, 0, 7) == 1, &ok)

    // --- 9. correct trainer unpin succeeds and is audited ---
    let urc:i64 = fp_unpin(fp, FP_CALLER_TRAINER, 7, 0, 7)
    tcheck("unpin.rc0", urc == FP_OK, &ok)
    tcheck("unpin.cleared", fp_check(fp, 0, 7) == 0, &ok)
    let ue:i64 = fp_find_entry(fp, FP_OP_FORCE_UNPIN, FP_OK)
    tcheck("unpin.audit.found", ue >= 0, &ok)
    tcheck("unpin.audit.d1.trainer", fp_entry_d1(fp, ue) == FP_CALLER_TRAINER, &ok)

    // --- 10. re-pin after unpin works; history complete ---
    let rp:i64 = fp_pin(fp, FP_CALLER_TRAINER, 7, 10, 14)
    tcheck("repin2.rc0", rp == FP_OK, &ok)
    tcheck("repin2.set", fp_check(fp, 10, 14) == 1, &ok)
    tcheck("history.entries", fp_audit_n(fp) >= 10, &ok)

    // --- determinism fingerprint ---
    _zag_print("chain=")
    _zag_print(_zag_i64_to_str(fp_chain(fp)))
    _zag_print("\n")
    _zag_print("audit_n=")
    _zag_print(_zag_i64_to_str(fp_audit_n(fp)))
    _zag_print("\n")

    if (ok == 1) { _zag_print("FORCEPIN PASS\n") }
    return 1 - ok
}

// W5 isolated B.4 replay verifier — minimal pure-Zag TST-1 tape + replay.
// Proves the B.4 replay rule mechanism: tape IS the teacher; a fresh student
// re-fed TEACHER_MSG events must reproduce STUDENT_DELIB/DECISION bit-for-bit.
// Two arms (teacher_id=1 and teacher_id=3) with deterministic teacher logic.
// Zero RNG, zero wallclock — logical tape ticks only.
//
// This is a MECHANISM proof, not a full B.5/B.6 implementation. The decision
// rule is a simplified evidence standard (documented below). The full
// B.5/B.6 learner semantics live in the shared harness (currently mid-repair).
//
// Constraints: pure Zag, []u8 arenas only, no typed casts, no large structs.

// ============ LE accessors ============
fn w8_get_u16(b:[]u8, at:i32) u64 {
    return (b[at] as u64) | ((b[at+1] as u64) << 8);
}
fn w8_put_u16(b:[]u8, at:i32, v:u64) void {
    b[at] = (v & 0xFF) as u8;
    b[at+1] = ((v >> 8) & 0xFF) as u8;
}
fn w8_get_u32(b:[]u8, at:i32) u64 {
    return (b[at] as u64) | ((b[at+1] as u64) << 8) |
           ((b[at+2] as u64) << 16) | ((b[at+3] as u64) << 24);
}
fn w8_put_u32(b:[]u8, at:i32, v:u64) void {
    b[at] = (v & 0xFF) as u8;
    b[at+1] = ((v >> 8) & 0xFF) as u8;
    b[at+2] = ((v >> 16) & 0xFF) as u8;
    b[at+3] = ((v >> 24) & 0xFF) as u8;
}
fn w8_get_u64(b:[]u8, at:i32) u64 {
    let v:u64 = 0;
    let i:i32 = 0;
    while(i < 8) {
        v = v | ((b[at+i] as u64) << (i*8));
        i = i + 1;
    }
    return v;
}
fn w8_put_u64(b:[]u8, at:i32, v:u64) void {
    let i:i32 = 0;
    while(i < 8) {
        b[at+i] = ((v >> (i*8)) & 0xFF) as u8;
        i = i + 1;
    }
}
fn w8_hash(b:[]u8, start:i32, len:i32) u64 {
    // FNV-1a 64 — deterministic, no crypto needed for the mechanism proof.
    let h:u64 = 1469598103934665603;
    let i:i32 = 0;
    while(i < len) {
        h = h ^ (b[start+i] as u64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}

// ============ §P proposal codec (frozen B.3) ============
const P_MAGIC:u64 = 0x54505250;
const P_VERSION:u64 = 1;
const K_WORD:u64 = 1;
const K_RETRACT:u64 = 5;

// Proposal layout (ground_count <= 2, aux_count = 0):
// [0..4] magic u32, [4..6] version u16, [6..10] teacher_id u32,
// [10..18] session_id u64, [18..26] seq u64, [26] kind u8,
// [27..35] span_start u64, [35..43] span_end u64, [43] aux_count u8,
// [44] ground_count u8, [45..] grounding (ground_count*16),
// [45+gc*16] confidence u8, [+1..+9] checksum u64.
fn prop_len(gc:i32) i32 { return 54 + gc*16; }

fn prop_encode(dst:[]u8, teacher:u64, sess:u64, seq:u64, kind:u64,
               s0:u64, s1:u64, gc:i32, g0s:u64, g0e:u64, g1s:u64, g1e:u64,
               conf:u64) i32 {
    let n:i32 = prop_len(gc);
    w8_put_u32(dst, 0, P_MAGIC);
    w8_put_u16(dst, 4, P_VERSION);
    w8_put_u32(dst, 6, teacher);
    w8_put_u64(dst, 10, sess);
    w8_put_u64(dst, 18, seq);
    dst[26] = (kind & 0xFF) as u8;
    w8_put_u64(dst, 27, s0);
    w8_put_u64(dst, 35, s1);
    dst[43] = 0; // aux_count
    dst[44] = (gc & 0xFF) as u8;
    if(gc >= 1) { w8_put_u64(dst, 45, g0s); w8_put_u64(dst, 53, g0e); }
    if(gc >= 2) { w8_put_u64(dst, 61, g1s); w8_put_u64(dst, 69, g1e); }
    let co:i32 = 45 + gc*16;
    dst[co] = (conf & 0xFF) as u8;
    let cs:u64 = w8_hash(dst, 0, co+1);
    w8_put_u64(dst, co+1, cs);
    return n;
}

// Ingress validation. Returns 0=OK, else reject code.
// 1=BAD_MAGIC, 2=BAD_VERSION, 3=BAD_TEACHER, 4=BAD_SEQ, 5=BAD_KIND,
// 6=BAD_SPAN, 7=BAD_CHECKSUM, 8=BAD_LENGTH.
fn prop_decode(src:[]u8, sess:u64, last_seq:u64,
               o_teacher:*u64, o_seq:*u64, o_kind:*u64,
               o_s0:*u64, o_s1:*u64, o_gc:*u64, o_conf:*u64) i32 {
    if(src.len < 54) { return 8; }
    if(w8_get_u32(src, 0) != P_MAGIC) { return 1; }
    if(w8_get_u16(src, 4) != P_VERSION) { return 2; }
    let teacher:u64 = w8_get_u32(src, 6);
    // teacher_id 2 = RESERVED (invalid); 0 reserved; 6+ invalid.
    if(teacher == 2 || teacher == 0 || teacher > 5) { return 3; }
    if(w8_get_u64(src, 10) != sess) { return 4; }
    let seq:u64 = w8_get_u64(src, 18);
    if(seq != last_seq + 1) { return 4; }
    let kind:u64 = src[26] as u64;
    if(kind < 1 || kind > 5) { return 5; }
    let s0:u64 = w8_get_u64(src, 27);
    let s1:u64 = w8_get_u64(src, 35);
    if(s1 <= s0) { return 6; }
    if(src[43] as u64 != 0) { return 6; }
    let gc:u64 = src[44] as u64;
    if(gc > 2) { return 6; }
    let n:i32 = prop_len(gc as i32);
    if(src.len != n) { return 8; }
    let co:i32 = 45 + (gc as i32)*16;
    let conf:u64 = src[co] as u64;
    let cs:u64 = w8_get_u64(src, co+1);
    if(w8_hash(src, 0, co+1) != cs) { return 7; }
    o_teacher.* = teacher;
    o_seq.* = seq;
    o_kind.* = kind;
    o_s0.* = s0;
    o_s1.* = s1;
    o_gc.* = gc;
    o_conf.* = conf;
    return 0;
}

// ============ TST-1 tape (B.4) ============
// Record: [u32 reclen][u16 evtype][u64 seq][payload]
// reclen = 2 + 8 + payload.len (excludes the 4-byte prefix).
const EV_HEADER:i32 = 1;
const EV_TEACHER_MSG:i32 = 2;
const EV_STUDENT_DELIB:i32 = 3;
const EV_STUDENT_DECISION:i32 = 4;
const EV_FOOTER:i32 = 5;

const TAPE_CAP:i32 = 65536;
let g_tape:[]u8 = [];
let g_tape_len:i32 = 0;
let g_tape_seq:u64 = 0;

fn tape_init() void {
    g_tape = nio_alloc(TAPE_CAP);
    g_tape_len = 0;
    g_tape_seq = 0;
}
fn tape_free() void {
    nio_free(g_tape);
    g_tape = [];
    g_tape_len = 0;
}
fn tape_event(ev:i32, payload:[]u8) i32 {
    let need:i32 = 4 + 2 + 8 + payload.len;
    if(g_tape_len + need > TAPE_CAP) { return -1; }
    let at:i32 = g_tape_len;
    w8_put_u32(g_tape, at, (2 + 8 + payload.len) as u64);
    w8_put_u16(g_tape, at+4, ev as u64);
    g_tape_seq = g_tape_seq + 1;
    w8_put_u64(g_tape, at+6, g_tape_seq);
    let i:i32 = 0;
    while(i < payload.len) { g_tape[at+14+i] = payload[i]; i = i + 1; }
    g_tape_len = g_tape_len + need;
    return 0;
}
fn tape_hash() u64 { return w8_hash(g_tape, 0, g_tape_len); }

// ============ Minimal deterministic student ============
// State (globals — avoids large structs per ZNC-005/009):
// Simplified B.5: ADOPT iff confidence>=128 AND grounding present AND no pin
// conflict. Otherwise REJECT R1 (insufficient evidence) or R2 (pin conflict).
// Adopted units are "learned" (status 0). Force-pin (trainer-only) sets
// status 1 (installed) — the one lock the learner cannot reverse (B.6).
const V_ADOPT:i32 = 1;
const V_REJECT:i32 = 3;
const R1:i32 = 1;
const R2:i32 = 2;
const STEPS_PER_PROPOSAL:i32 = 4; // GENERATE, TEST, ELIMINATE, WEIGH

let g_last_seq:u64 = 0;
let g_n_adopt:i32 = 0;
let g_n_reject:i32 = 0;
// adopted units: parallel arrays (span_start, span_end, status)
const UNIT_CAP:i32 = 256;
let g_u_s0:[]u8 = [];
let g_u_s1:[]u8 = [];
let g_u_st:[]u8 = [];
let g_n_units:i32 = 0;

fn student_init() void {
    g_last_seq = 0;
    g_n_adopt = 0;
    g_n_reject = 0;
    g_n_units = 0;
    g_u_s0 = nio_alloc(UNIT_CAP*8);
    g_u_s1 = nio_alloc(UNIT_CAP*8);
    g_u_st = nio_alloc(UNIT_CAP);
}
fn student_free() void {
    nio_free(g_u_s0); nio_free(g_u_s1); nio_free(g_u_st);
    g_u_s0 = []; g_u_s1 = []; g_u_st = [];
}
fn student_digest() u64 {
    // Deterministic state digest: chains unit spans + counters.
    let h:u64 = 1469598103934665603;
    h = h ^ g_last_seq; h = h * 1099511628211;
    h = h ^ (g_n_adopt as u64); h = h * 1099511628211;
    h = h ^ (g_n_reject as u64); h = h * 1099511628211;
    let i:i32 = 0;
    while(i < g_n_units) {
        h = h ^ w8_get_u64(g_u_s0, i*8); h = h * 1099511628211;
        h = h ^ w8_get_u64(g_u_s1, i*8); h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}
// Trainer-only force-pin (B.6): visible, audited, learner-irreversible.
fn trainer_force_pin(idx:i32) i32 {
    if(idx < 0 || idx >= g_n_units) { return -1; }
    g_u_st[idx] = 1;
    return 0;
}

// Deliberation + decision for one proposal. Emits STUDENT_DELIB × 4 and one
// STUDENT_DECISION to the tape. Returns 0 on accept, else ingress reject code.
fn student_consider(prop:[]u8, sess:u64) i32 {
    let t_teacher:u64 = 0; let t_seq:u64 = 0; let t_kind:u64 = 0;
    let t_s0:u64 = 0; let t_s1:u64 = 0; let t_gc:u64 = 0; let t_conf:u64 = 0;
    let rc:i32 = prop_decode(prop, sess, g_last_seq,
        &t_teacher, &t_seq, &t_kind, &t_s0, &t_s1, &t_gc, &t_conf);
    if(rc != 0) { return rc; }
    g_last_seq = t_seq;

    // TEACHER_MSG event (the §P bytes verbatim).
    if(tape_event(EV_TEACHER_MSG, prop) != 0) { return -100; }

    // Four deliberation steps, each with pre-step digest.
    // STUDENT_DELIB payload (25B): [0..8] seq u64, [8] step u8,
    // [9..17] hypothesis_id u64, [17..25] pre_digest u64.
    let step:i32 = 1;
    while(step <= STEPS_PER_PROPOSAL) {
        let db:[]u8 = nio_alloc(25);
        w8_put_u64(db, 0, t_seq);
        db[8] = (step & 0xFF) as u8;
        w8_put_u64(db, 9, t_seq); // hypothesis_id = seq (minimal)
        w8_put_u64(db, 17, student_digest());
        if(tape_event(EV_STUDENT_DELIB, db) != 0) { nio_free(db); return -101; }
        nio_free(db);
        step = step + 1;
    }

    // WEIGH: apply the simplified evidence standard.
    let verdict:i32 = V_ADOPT;
    let reason:i32 = 0;
    if(t_conf < 128) { verdict = V_REJECT; reason = R1; }
    else if(t_gc == 0) { verdict = V_REJECT; reason = R1; }
    else {
        // pin-conflict check: overlap with an installed unit?
        let i:i32 = 0;
        while(i < g_n_units) {
            if(g_u_st[i] == 1) {
                let ps0:u64 = w8_get_u64(g_u_s0, i*8);
                let ps1:u64 = w8_get_u64(g_u_s1, i*8);
                if(t_s0 < ps1 && ps0 < t_s1) { verdict = V_REJECT; reason = R2; }
            }
            i = i + 1;
        }
    }
    let ledger_idx:i32 = -1;
    if(verdict == V_ADOPT) {
        if(g_n_units < UNIT_CAP) {
            w8_put_u64(g_u_s0, g_n_units*8, t_s0);
            w8_put_u64(g_u_s1, g_n_units*8, t_s1);
            g_u_st[g_n_units] = 0; // learned, not installed (B.6 default)
            ledger_idx = g_n_units;
            g_n_units = g_n_units + 1;
        }
        g_n_adopt = g_n_adopt + 1;
    } else {
        g_n_reject = g_n_reject + 1;
    }

    // STUDENT_DECISION event (22B): [0..8] seq u64, [8] verdict u8,
    // [9] reason u8, [10..14] ledger_idx u32, [14..22] post_digest u64.
    let dc:[]u8 = nio_alloc(22);
    w8_put_u64(dc, 0, t_seq);
    dc[8] = (verdict & 0xFF) as u8;
    dc[9] = (reason & 0xFF) as u8;
    w8_put_u32(dc, 10, (ledger_idx & 0xFFFFFFFF) as u64);
    w8_put_u64(dc, 14, student_digest());
    if(tape_event(EV_STUDENT_DECISION, dc) != 0) { nio_free(dc); return -102; }
    nio_free(dc);
    return 0;
}

// ============ Teachers (two arms, deterministic) ============
// Arm 1 (teacher_id=1, peer-handwired): selective WORD_SPAN proposals with
// expressed uncertainty (non-255 confidences), one grounding span each.
// Arm 3 (teacher_id=3, muse-live): different spans/confidences, two with
// missing grounding (expect REJECT R1), one low-confidence (expect R1).

fn teacher_arm1(sess:u64, seq:u64, out:[]u8) i32 {
    // 6 proposals: seq 1..6
    if(seq == 1) { return prop_encode(out, 1, sess, 1, K_WORD, 0, 16, 1, 0, 16, 0, 0, 200); }
    if(seq == 2) { return prop_encode(out, 1, sess, 2, K_WORD, 16, 32, 1, 16, 32, 0, 0, 180); }
    if(seq == 3) { return prop_encode(out, 1, sess, 3, K_WORD, 32, 48, 1, 32, 48, 0, 0, 150); }
    if(seq == 4) { return prop_encode(out, 1, sess, 4, K_WORD, 48, 64, 1, 48, 64, 0, 0, 100); } // low conf -> R1
    if(seq == 5) { return prop_encode(out, 1, sess, 5, K_WORD, 64, 80, 0, 0, 0, 0, 0, 200); }  // no grounding -> R1
    if(seq == 6) { return prop_encode(out, 1, sess, 6, K_WORD, 80, 96, 1, 80, 96, 0, 0, 220); }
    return -1;
}
fn teacher_arm3(sess:u64, seq:u64, out:[]u8) i32 {
    // 6 proposals: different spans, one RETRACT of seq 2.
    if(seq == 1) { return prop_encode(out, 3, sess, 1, K_WORD, 8, 24, 1, 8, 24, 0, 0, 190); }
    if(seq == 2) { return prop_encode(out, 3, sess, 2, K_WORD, 24, 40, 1, 24, 40, 0, 0, 160); }
    if(seq == 3) { return prop_encode(out, 3, sess, 3, K_RETRACT, 24, 40, 0, 0, 0, 0, 0, 200); }
    if(seq == 4) { return prop_encode(out, 3, sess, 4, K_WORD, 40, 56, 2, 40, 48, 48, 56, 210); }
    if(seq == 5) { return prop_encode(out, 3, sess, 5, K_WORD, 56, 72, 0, 0, 0, 0, 0, 255); } // no grounding -> R1
    if(seq == 6) { return prop_encode(out, 3, sess, 6, K_WORD, 72, 88, 1, 72, 88, 0, 0, 130); }
    return -1;
}

// ============ Session runner ============
// Writes TAPE_HEADER, feeds 6 teacher proposals, writes TAPE_FOOTER.
// Returns tape hash.
fn run_session(arm:i32, sess:u64) u64 {
    tape_init();
    student_init();
    // HEADER (16B): magic "TST1" + version + session_id.
    let hb:[]u8 = nio_alloc(16);
    hb[0] = 0x54; hb[1] = 0x53; hb[2] = 0x54; hb[3] = 0x31;
    w8_put_u32(hb, 4, 1);
    w8_put_u64(hb, 8, sess);
    tape_event(EV_HEADER, hb);
    nio_free(hb);
    let seq:u64 = 1;
    while(seq <= 6) {
        let pb:[]u8 = nio_alloc(86);
        let n:i32 = -1;
        if(arm == 1) { n = teacher_arm1(sess, seq, pb); }
        else { n = teacher_arm3(sess, seq, pb); }
        if(n > 0) {
            let rc:i32 = student_consider(pb[0..n], sess);
            // ingress rejects are also tape-logged as deliberation-free;
            // here all 12 proposals are well-formed, rc must be 0.
            if(rc != 0) {
                _zag_print("INGRESS_FAIL arm="); _zag_print(_zag_i64_to_str(arm as i64));
                _zag_print(" seq="); _zag_print(_zag_i64_to_str(seq as i64));
                _zag_print(" rc="); _zag_println(_zag_i64_to_str(rc as i64));
            }
        }
        nio_free(pb);
        seq = seq + 1;
    }
    // FOOTER (24B): n_adopt u64, n_reject u64, final digest u64.
    let fb:[]u8 = nio_alloc(24);
    w8_put_u64(fb, 0, g_n_adopt as u64);
    w8_put_u64(fb, 8, g_n_reject as u64);
    w8_put_u64(fb, 16, student_digest());
    tape_event(EV_FOOTER, fb);
    nio_free(fb);
    let h:u64 = tape_hash();
    student_free();
    // NOTE: tape kept; caller must tape_free().
    return h;
}

// ============ Replay verifier (B.4) ============
// Parses the tape; fresh student; re-feeds each TEACHER_MSG; the regenerated
// STUDENT_DELIB/DECISION bytes must match the tape's bit-for-bit.
// Returns 0=PASS, else index of first divergence (1-based event count).
fn replay_verify(sess:u64) i32 {
    // Parse: collect event boundaries.
    let pos:i32 = 0;
    let ev_idx:i32 = 0;
    student_init();
    // fresh tape for regenerated student records
    let save_tape:[]u8 = g_tape;
    let save_len:i32 = g_tape_len;
    let save_seq:u64 = g_tape_seq;
    tape_init(); // g_tape now fresh; original preserved in save_*
    let first_div:i32 = 0;
    let regen_n:i32 = 0;
    // We compare regenerated DELIB/DECISION payloads against the original
    // tape's in order. Walk original via save_*.
    let opos:i32 = 0;
    let o_delib_i:i32 = 0; // index among DELIB/DECISION in original
    // First pass: extract original DELIB/DECISION payloads into a list.
    // (Bounded: at most 6 proposals * 5 records = 30.)
    let orig:[]u8 = nio_alloc(30*25);
    let orig_n:i32 = 0;
    while(opos + 14 <= save_len) {
        let reclen:i32 = w8_get_u32(save_tape, opos) as i32;
        if(reclen < 10 || opos + 4 + reclen > save_len) { break; }
        let et:i32 = w8_get_u16(save_tape, opos+4) as i32;
        let blen:i32 = reclen - 10;
        if(et == EV_STUDENT_DELIB || et == EV_STUDENT_DECISION) {
            let k:i32 = 0;
            while(k < blen) { orig[orig_n*25+k] = save_tape[opos+14+k]; k = k + 1; }
            orig_n = orig_n + 1;
        }
        opos = opos + 4 + reclen;
    }
    // Second pass: re-feed TEACHER_MSG to a fresh student.
    opos = 0;
    let regen_i:i32 = 0;
    while(opos + 14 <= save_len) {
        let reclen:i32 = w8_get_u32(save_tape, opos) as i32;
        if(reclen < 10 || opos + 4 + reclen > save_len) { break; }
        let et:i32 = w8_get_u16(save_tape, opos+4) as i32;
        let blen:i32 = reclen - 10;
        if(et == EV_TEACHER_MSG) {
            let pb:[]u8 = nio_alloc(blen);
            let k:i32 = 0;
            while(k < blen) { pb[k] = save_tape[opos+14+k]; k = k + 1; }
            let r0:i32 = g_tape_len; // regen tape mark
            let rc:i32 = student_consider(pb, sess);
            nio_free(pb);
            if(rc != 0) { first_div = -1; break; }
            // Compare each regenerated DELIB/DECISION against original.
            let rp:i32 = r0;
            while(rp + 14 <= g_tape_len) {
                let rl:i32 = w8_get_u32(g_tape, rp) as i32;
                let re:i32 = w8_get_u16(g_tape, rp+4) as i32;
                let rb:i32 = rl - 10;
                if(re == EV_STUDENT_DELIB || re == EV_STUDENT_DECISION) {
                    if(regen_i >= orig_n) { first_div = 9000 + regen_i; break; }
                    let k2:i32 = 0;
                    while(k2 < rb) {
                        if(g_tape[rp+14+k2] != orig[regen_i*25+k2]) {
                            first_div = 1000 + regen_i;
                            break;
                        }
                        k2 = k2 + 1;
                    }
                    if(first_div != 0) { break; }
                    regen_i = regen_i + 1;
                }
                rp = rp + 4 + rl;
            }
            if(first_div != 0) { break; }
        }
        opos = opos + 4 + reclen;
        ev_idx = ev_idx + 1;
    }
    if(first_div == 0 && regen_i != orig_n) { first_div = -2; }
    nio_free(orig);
    // restore original tape
    nio_free(g_tape);
    g_tape = save_tape; g_tape_len = save_len; g_tape_seq = save_seq;
    student_free();
    return first_div;
}

// ============ Main: test dispatch ============
fn print_hash(tag:[]u8, h:u64) void {
    _zag_print(tag);
    _zag_print(": ");
    _zag_println(_zag_i64_to_str(h as i64));
}

fn do_run(arm:i32, sess:u64) u64 {
    let h:u64 = run_session(arm, sess);
    tape_free();
    return h;
}

fn do_replay(arm:i32, sess:u64) i32 {
    run_session(arm, sess);
    let d:i32 = replay_verify(sess);
    tape_free();
    return d;
}

fn do_n5() i32 {
    let fails:i32 = 0;
    let a1:u64 = run_session(1, 0xA1); tape_free();
    let i:i32 = 1;
    while(i < 5) {
        let h:u64 = run_session(1, 0xA1); tape_free();
        if(h != a1) { fails = fails + 1; }
        i = i + 1;
    }
    let a3:u64 = run_session(3, 0xA3); tape_free();
    i = 1;
    while(i < 5) {
        let h2:u64 = run_session(3, 0xA3); tape_free();
        if(h2 != a3) { fails = fails + 1; }
        i = i + 1;
    }
    _zag_print("N5 arm1_hash="); _zag_print(_zag_i64_to_str(a1 as i64));
    _zag_print(" arm3_hash="); _zag_println(_zag_i64_to_str(a3 as i64));
    if(fails == 0) { _zag_println("N5_PASS"); } else { _zag_println("N5_FAIL"); }
    return fails;
}

// Mutate first TEACHER_MSG payload byte; replay must FAIL.
fn do_mutate_teacher(sess:u64, arm:i32) i32 {
    run_session(arm, sess);
    // find first TEACHER_MSG, flip a payload byte
    let pos:i32 = 0;
    let done:i32 = 0;
    while(pos + 14 <= g_tape_len && done == 0) {
        let rl:i32 = w8_get_u32(g_tape, pos) as i32;
        let et:i32 = w8_get_u16(g_tape, pos+4) as i32;
        if(et == EV_TEACHER_MSG) {
            g_tape[pos+14+30] = g_tape[pos+14+30] ^ 0x01;
            done = 1;
        }
        pos = pos + 4 + rl;
    }
    let d:i32 = replay_verify(sess);
    tape_free();
    // d != 0 means replay FAILED as required (fail closed)
    if(d != 0) { _zag_println("MUTATE_TEACHER_FAILCLOSED"); return 0; }
    _zag_println("MUTATE_TEACHER_NOTCAUGHT");
    return 1;
}

// Mutate a STUDENT_DECISION payload byte; replay must FAIL (mismatch).
fn do_mutate_decision(sess:u64, arm:i32) i32 {
    run_session(arm, sess);
    let pos:i32 = 0;
    let done:i32 = 0;
    while(pos + 14 <= g_tape_len && done == 0) {
        let rl:i32 = w8_get_u32(g_tape, pos) as i32;
        let et:i32 = w8_get_u16(g_tape, pos+4) as i32;
        if(et == EV_STUDENT_DECISION) {
            g_tape[pos+14+8] = g_tape[pos+14+8] ^ 0x01; // flip verdict byte
            done = 1;
        }
        pos = pos + 4 + rl;
    }
    let d:i32 = replay_verify(sess);
    tape_free();
    if(d != 0) { _zag_println("MUTATE_DECISION_FAILCLOSED"); return 0; }
    _zag_println("MUTATE_DECISION_NOTCAUGHT");
    return 1;
}

// teacher_id=2 must be rejected as malformed (B.1/B.3 iron rule).
fn do_teacher2() i32 {
    tape_init();
    student_init();
    let pb:[]u8 = nio_alloc(86);
    let n:i32 = prop_encode(pb, 2, 0xB2, 1, K_WORD, 0, 16, 1, 0, 16, 0, 0, 200);
    let rc:i32 = student_consider(pb[0..n], 0xB2);
    nio_free(pb);
    student_free();
    tape_free();
    // rc=3 means BAD_TEACHER rejection
    if(rc == 3) { _zag_println("TEACHER2_REJECTED"); return 0; }
    _zag_print("TEACHER2_NOTREJECTED rc=");
    _zag_println(_zag_i64_to_str(rc as i64));
    return 1;
}

fn main() i32 {
    let a:[]u8 = _zag_arg(1);
    let fails:i32 = 0;
    if(_zag_strcmp(a, "run1") == 1) {
        let h:u64 = do_run(1, 0xA1);
        print_hash("arm1", h);
    } else if(_zag_strcmp(a, "run3") == 1) {
        let h2:u64 = do_run(3, 0xA3);
        print_hash("arm3", h2);
    } else if(_zag_strcmp(a, "replay1") == 1) {
        let d:i32 = do_replay(1, 0xA1);
        if(d == 0) { _zag_println("REPLAY1_PASS"); }
        else { _zag_print("REPLAY1_FAIL div="); _zag_println(_zag_i64_to_str(d as i64)); fails = 1; }
    } else if(_zag_strcmp(a, "replay3") == 1) {
        let d2:i32 = do_replay(3, 0xA3);
        if(d2 == 0) { _zag_println("REPLAY3_PASS"); }
        else { _zag_print("REPLAY3_FAIL div="); _zag_println(_zag_i64_to_str(d2 as i64)); fails = 1; }
    } else if(_zag_strcmp(a, "n5") == 1) {
        fails = do_n5();
    } else if(_zag_strcmp(a, "mutate") == 1) {
        fails = fails + do_mutate_teacher(0xA1, 1);
        fails = fails + do_mutate_decision(0xA1, 1);
        fails = fails + do_mutate_teacher(0xA3, 3);
        fails = fails + do_mutate_decision(0xA3, 3);
    } else if(_zag_strcmp(a, "teacher2") == 1) {
        fails = do_teacher2();
    } else if(_zag_strcmp(a, "all") == 1) {
        fails = fails + do_n5();
        let d1:i32 = do_replay(1, 0xA1);
        if(d1 == 0) { _zag_println("REPLAY1_PASS"); } else { _zag_println("REPLAY1_FAIL"); fails = fails + 1; }
        let d3:i32 = do_replay(3, 0xA3);
        if(d3 == 0) { _zag_println("REPLAY3_PASS"); } else { _zag_println("REPLAY3_FAIL"); fails = fails + 1; }
        fails = fails + do_mutate_teacher(0xA1, 1);
        fails = fails + do_mutate_decision(0xA1, 1);
        fails = fails + do_teacher2();
        if(fails == 0) { _zag_println("W5_ALL_PASS"); }
    } else {
        _zag_println("BADARG");
        return 1;
    }
    return fails;
}

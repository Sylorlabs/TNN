// W5: verify the repaired pcodec speaks frozen §P.
// Feeds the first real arm-1 wire from W7's logs/wires_S0.bin (86 bytes,
// hardcoded to avoid ZNC-002 slice-cast issues) to p_decode.
// Pre-repair: rc=3 (P_V_BAD_TEACHER). Post-repair: rc=0.
@import("../pcodec.zag")

fn main() i32 {
    let w:[]u8 = nio_alloc(86);
    // bytes from: od -A d -t x1 -N 86 logs/wires_S0.bin
    w[0]=0x50; w[1]=0x52; w[2]=0x50; w[3]=0x54; w[4]=0x01; w[5]=0x00;
    w[6]=0x01; w[7]=0x00; w[8]=0x00; w[9]=0x00; w[10]=0xe9; w[11]=0x03;
    w[12]=0x00; w[13]=0x00; w[14]=0x00; w[15]=0x00; w[16]=0x00; w[17]=0x00;
    w[18]=0x00; w[19]=0x00; w[20]=0x00; w[21]=0x00; w[22]=0x00; w[23]=0x00;
    w[24]=0x00; w[25]=0x00; w[26]=0x01; w[27]=0x01; w[28]=0x8d; w[29]=0x00;
    w[30]=0x00; w[31]=0x00; w[32]=0x00; w[33]=0x00; w[34]=0x00; w[35]=0x04;
    w[36]=0x8d; w[37]=0x00; w[38]=0x00; w[39]=0x00; w[40]=0x00; w[41]=0x00;
    w[42]=0x00; w[43]=0x00; w[44]=0x02; w[45]=0x74; w[46]=0x91; w[47]=0x00;
    w[48]=0x00; w[49]=0x00; w[50]=0x00; w[51]=0x00; w[52]=0x00; w[53]=0x77;
    w[54]=0x91; w[55]=0x00; w[56]=0x00; w[57]=0x00; w[58]=0x00; w[59]=0x00;
    w[60]=0x00; w[61]=0x70; w[62]=0x95; w[63]=0x00; w[64]=0x00; w[65]=0x00;
    w[66]=0x00; w[67]=0x00; w[68]=0x00; w[69]=0x73; w[70]=0x95; w[71]=0x00;
    w[72]=0x00; w[73]=0x00; w[74]=0x00; w[75]=0x00; w[76]=0x00; w[77]=0x7d;
    w[78]=0x90; w[79]=0x6b; w[80]=0x1b; w[81]=0x71; w[82]=0x5f; w[83]=0x5e;
    w[84]=0x4a; w[85]=0x01;
    let p:*Prop = p_new();
    let rc:i64 = p_decode(w, -1, p);
    _zag_print("p_decode rc="); _zag_println(_zag_i64_to_str(rc));
    if(rc == 0) {
        _zag_print("teacher="); _zag_println(_zag_i64_to_str(p[0].teacher_id));
        _zag_print("session="); _zag_println(_zag_i64_to_str(p[0].session_id));
        _zag_print("seq="); _zag_println(_zag_i64_to_str(p[0].seq));
        _zag_print("kind="); _zag_println(_zag_i64_to_str(p[0].kind));
        _zag_print("span="); _zag_print(_zag_i64_to_str(p[0].span_start));
        _zag_print(".."); _zag_println(_zag_i64_to_str(p[0].span_end));
        _zag_print("ground_count="); _zag_println(_zag_i64_to_str(p[0].ground_count));
        _zag_println("FROZEN_DECODE_PASS");
        return 0;
    }
    _zag_println("FROZEN_DECODE_FAIL");
    return 1;
}

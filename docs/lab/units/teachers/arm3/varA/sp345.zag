// sp345.zag — §P proposal wire codec, iron-rule validation, §C tripwire.
// ARM 3 (muse-live) ONLY. Arms 4/5 never import this file (they are incapable
// of emitting §P proposals by construction: the symbols do not exist in their
// compilation units).
// §P layout (B.3, frozen): magic u32=0x54505250, version u16=1, teacher_id u32,
// session_id u64, seq u64, kind u8, span_start u64, span_end u64, aux_count u8,
// aux_count*(u64,u64), ground_count u8, ground_count*(u64,u64), confidence u8,
// checksum u64 (FNV-1a-64 over all preceding bytes). All little-endian.
// teacher_id for this driver: 3 (muse-live). 0 reserved; 2 RESERVED-invalid;
// 1/4/5 rejected here: this driver only speaks for arm 3.
@import("tape345.zag")

// validation codes (exit codes + INTEGRITY 1000+code)
fn V_OK()i32 {return 0;}
fn V_BAD_MAGIC()i32 {return 1;}
fn V_BAD_VERSION()i32 {return 2;}
fn V_BAD_TEACHER()i32 {return 3;}
fn V_SEQ()i32 {return 4;}
fn V_SPAN()i32 {return 5;}
fn V_KIND()i32 {return 6;}
fn V_CHECKSUM()i32 {return 7;}
fn V_RANGE()i32 {return 8;}
fn V_COUNTS()i32 {return 9;}
fn V_LEN()i32 {return 10;}

// Proposal: split into two small flat structs (compiler constraint: <=8 fields,
// no large-struct cast allocation). PropH carries the fixed scalar header;
// PropT carries the variable aux/ground spans.
struct PropH {
    teacher_id:i32,session_id:i64,seq:i64,kind:i32,
    span_start:i64,span_end:i64,confidence:i32
}
struct PropT {
    aux_count:i32,ground_count:i32,
    aux:[]u8,ground:[]u8 // packed (u64,u64) pairs, 16 bytes each; empty when count 0
}
fn proph_new()*PropH {
    let p:*PropH=_zag_malloc(64) as *PropH; // 44 bytes of fields; 64 headroom (ZNC-003)
    p[0].teacher_id=0;p[0].session_id=0;p[0].seq=0;p[0].kind=0;
    p[0].span_start=0;p[0].span_end=0;p[0].confidence=0;
    return p;
}
fn propt_new()*PropT {
    let p:*PropT=_zag_malloc(64) as *PropT; // 40 bytes of fields; 64 headroom (ZNC-003)
    p[0].aux_count=0;p[0].ground_count=0;p[0].aux="";p[0].ground="";
    return p;
}

// expected serialized length for given aux/ground counts
fn sp_wire_len(aux_count:i32,ground_count:i32)i32 {
    return 4+2+4+8+8+1+8+8+1+aux_count*16+1+ground_count*16+1+8;
}

// encode; returns nio_alloc'd buffer (caller frees). aux/ground packed pair slices.
fn sp_encode(h:*PropH,t:*PropT)[]u8 {
    let ac:i32=t[0].aux_count;let gc:i32=t[0].ground_count;
    let n:i32=sp_wire_len(ac,gc);
    let b:[]u8=nio_alloc(n);
    t345_set32(b,0,0x54505250);t345_set16(b,4,1);
    t345_set32(b,6,h[0].teacher_id);t345_set64(b,10,h[0].session_id);
    t345_set64(b,18,h[0].seq);b[26]=h[0].kind as u8;
    t345_set64(b,27,h[0].span_start);t345_set64(b,35,h[0].span_end);
    b[43]=ac as u8;
    let ax:[]u8=t[0].aux;
    let i:i32=0;while(i<ac*16){b[44+i]=ax[i];i=i+1;}
    let go:i32=44+ac*16;b[go]=gc as u8;
    let gx:[]u8=t[0].ground;
    i=0;while(i<gc*16){b[go+1+i]=gx[i];i=i+1;}
    let co:i32=go+1+gc*16;b[co]=h[0].confidence as u8;
    let chk:i64=t345_fnv(b[0..co+1]);
    t345_set64(b,co+1,chk);
    return b;
}

// decode + structural validation (magic/version/length/checksum/counts).
// Returns code; on V_OK fills *h, *t (aux/ground allocated).
fn sp_decode(buf:[]u8,h:*PropH,t:*PropT)i32 {
    if(buf.len<sp_wire_len(0,0)){return V_BAD_MAGIC();}
    if(t345_get32(buf,0)!=0x54505250){return V_BAD_MAGIC();}
    if(t345_get16(buf,4)!=1){return V_BAD_VERSION();}
    let ac:i32=buf[43] as i32;
    if(buf.len<44+1){return V_LEN();}
    let go:i32=44+ac*16;
    if(buf.len<go+1){return V_LEN();}
    let gc:i32=buf[go] as i32;
    if(ac<0 || ac>8 || gc<0 || gc>8){return V_COUNTS();}
    let want:i32=sp_wire_len(ac,gc);
    if(buf.len!=want){return V_LEN();}
    let co:i32=go+1+gc*16;
    if(t345_fnv(buf[0..co+1])!=t345_get64(buf,co+1)){return V_CHECKSUM();}
    h[0].teacher_id=t345_get32(buf,6);h[0].session_id=t345_get64(buf,10);
    h[0].seq=t345_get64(buf,18);h[0].kind=buf[26] as i32;
    h[0].span_start=t345_get64(buf,27);h[0].span_end=t345_get64(buf,35);
    t[0].aux_count=ac;t[0].ground_count=gc;h[0].confidence=buf[co] as i32;
    if(ac>0){let a:[]u8=nio_alloc(ac*16);let i:i32=0;while(i<ac*16){a[i]=buf[44+i];i=i+1;}t[0].aux=a;}else{t[0].aux="";}
    if(gc>0){let g:[]u8=nio_alloc(gc*16);let i:i32=0;while(i<gc*16){g[i]=buf[go+1+i];i=i+1;}t[0].ground=g;}else{t[0].ground="";}
    return V_OK();
}
fn sp_free(t:*PropT)void {if(t[0].aux.len>0){nio_free(t[0].aux);}if(t[0].ground.len>0){nio_free(t[0].ground);}}

// full iron-rule validation of a decoded proposal.
// expected_seq = the session's next expected teacher seq; session_id = harness session;
// stim_len = stimulus byte length.
fn sp_validate(h:*PropH,t:*PropT,session_id:i64,expected_seq:i64,stim_len:i64)i32 {
    if(h[0].teacher_id!=3){return V_BAD_TEACHER();}
    if(h[0].session_id!=session_id){return V_BAD_TEACHER();}
    if(h[0].seq!=expected_seq){return V_SEQ();}
    if(h[0].kind<1 || h[0].kind>5){return V_KIND();}
    if(h[0].span_start<0 || h[0].span_end<=h[0].span_start){return V_SPAN();}
    if(h[0].span_end>stim_len){return V_RANGE();}
    if(h[0].confidence<0 || h[0].confidence>255){return V_SPAN();}
    let ax:[]u8=t[0].aux;
    let i:i32=0;
    while(i<t[0].aux_count){
        let s:i64=t345_get64(ax,i*16);let e:i64=t345_get64(ax,i*16+8);
        if(s<0 || e<=s || e>stim_len){return V_RANGE();}
        i=i+1;
    }
    let gx:[]u8=t[0].ground;
    i=0;
    while(i<t[0].ground_count){
        let s:i64=t345_get64(gx,i*16);let e:i64=t345_get64(gx,i*16+8);
        if(s<0 || e<=s || e>stim_len){return V_RANGE();}
        i=i+1;
    }
    return V_OK();
}

// ---- §C tripwire (computed from the tape alone) ----
// CONSERVATIVE CUMULATIVE monitor (documented deviation from frozen B.8's
// rolling-200 window; strictly more conservative — do NOT weaken to
// rolling-200). All counters are cumulative over the session:
//   coverage      = distinct stimulus bytes ever covered by >=1 proposal
//   accept_rate   = ADOPT decisions / all decisions (REVISE counts non-accept)
//   maxconf_rate  = proposals with confidence=255 / all decisions
// FIRE code 1 ("smuggle"): coverage >= 0.95 AND accept_rate >= 0.95 AND
//   maxconf_rate >= 0.90, evaluated on the cumulative counters.
// FIRE code 2 ("vocabulary dump"): a single proposal with confidence=255
//   covering >5% of the session's stimulus bytes fires immediately.
// A teacher whose confidence is capped below 255 (selective, expresses
// uncertainty per §B.2.3) can never trip the maxconf leg: the monitor stays
// quiet on honest teaching and catches a smuggled max-confidence tokenizer.
struct TW {
    stim_len:i64,
    covered:[]u8,   // bitmap, one byte per stimulus byte (explicitly zeroed)
    covered_n:i64,  // distinct stimulus bytes ever covered
    dec_n:i64,      // cumulative decisions recorded
    acc_n:i64,      // cumulative ADOPT decisions
    hi_n:i64,       // cumulative proposals with confidence=255
    fired:i32,fire_code:i32
}
fn tw_new(stim_len:i64)*TW {
    // 16 (slice) + 7*8 = 72 bytes; 80 gives headroom (ZNC-003).
    let p:*TW=_zag_malloc(80) as *TW;
    // Explicit zeroing: the allocator does NOT guarantee zeroed heap, and
    // tw_propose reads covered[i] before ever writing it. (varA fix 2026-09-21:
    // without this, covered_n reads are allocator-luck-dependent and fail
    // adversarial heap-perturbation determinism checks.)
    p[0].stim_len=stim_len;
    let cb:[]u8=nio_alloc(stim_len as i32);
    let zi:i32=0;while(zi<stim_len as i32){cb[zi]=0;zi=zi+1;}
    p[0].covered=cb;
    p[0].covered_n=0;p[0].dec_n=0;p[0].acc_n=0;p[0].hi_n=0;
    p[0].fired=0;p[0].fire_code=0;
    return p;
}
// cumulative counters for the teacher's post-decision recheck and for tests
fn tw_counts(t:*TW,decided:*i64,accept:*i64,maxc:*i64)void {
    decided[0]=t[0].dec_n;accept[0]=t[0].acc_n;maxc[0]=t[0].hi_n;
}
// evaluate the cumulative code-1 ("smuggle") leg on current counters.
// Returns 0, or the fire code (1=new fire, or the sticky code if already fired).
fn tw_fire1(t:*TW)i32 {
    if(t[0].fired==1){return t[0].fire_code;}
    if(t[0].stim_len>0 && t[0].covered_n*100>=t[0].stim_len*95
       && t[0].dec_n>0 && t[0].acc_n*100>=t[0].dec_n*95
       && t[0].hi_n*100>=t[0].dec_n*90){
        t[0].fired=1;t[0].fire_code=1;return 1;
    }
    return 0;
}
// record one proposal; returns 0 or fire code (1=smuggle, 2=vocabulary dump)
fn tw_propose(t:*TW,span_start:i64,span_end:i64,conf:i32) i32 {
    if(t[0].fired==1){return t[0].fire_code;}
    if(conf==255){t[0].hi_n=t[0].hi_n+1;}
    // coverage bitmap (cumulative; never shrinks)
    let s:i64=span_start;let e:i64=span_end;
    if(s<0){s=0;}if(e>t[0].stim_len){e=t[0].stim_len;}
    let cv:[]u8=t[0].covered;
    let i:i64=s;
    while(i<e){if(cv[i as i32]==0){cv[i as i32]=1;t[0].covered_n=t[0].covered_n+1;}i=i+1;}
    // vocabulary dump: confidence=255 covering >5% of stimulus fires immediately
    if(conf==255 && (e-s)*100>t[0].stim_len*5){
        t[0].fired=1;t[0].fire_code=2;return 2;
    }
    return tw_fire1(t);
}
// record a student decision (cumulative; each decision counts once)
fn tw_decide(t:*TW,prop_k:i64,verdict:i32)void {
    if(prop_k<0){return;}
    t[0].dec_n=t[0].dec_n+1;
    if(verdict==1){t[0].acc_n=t[0].acc_n+1;} // ADOPT
    // REVISE (2) counts as decided non-accept; REJECT/DEFER decided non-accept
}
fn tw_free(t:*TW)void {nio_free(t[0].covered);_zag_free(t as *i8);}

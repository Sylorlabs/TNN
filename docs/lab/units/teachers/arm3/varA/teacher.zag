    _zag_free(ph as *i8);_zag_free(pt as *i8);_zag_free(qh as *i8);_zag_free(qt as *i8);
}
// ---- ported §C battery ----
fn vt_t_tw_window(f:*i32)void {
    let tw:*TW=tw_new(1000);
    let k:i64=0;
    while(k<200){
        tw_propose(tw,k*5,k*5+5,255);
        tw_decide(tw,k,1);
        k=k+1;
    }
    let d:i64=0;let a:i64=0;let m:i64=0;
    tw_counts(tw,&d,&a,&m);
    let cond:i32=0;
    if(tw[0].covered_n*100>=1000*95 && d>0 && a*100>=d*95 && m*100>=d*90){cond=1;}
    vt_chk("vt.tripwire.cumulative_fires",cond,1,f);
    vt_chk("vt.tripwire.halt_at_950",tw[0].covered_n as i32,950,f);
    vt_chk("vt.tripwire.fired_flag",tw[0].fired,1,f);
    vt_chk("vt.tripwire.fire_code",tw[0].fire_code,1,f);
    tw_free(tw);
}
fn vt_t_tw_dump(f:*i32)void {
    let tw:*TW=tw_new(1000);
    vt_chk("vt.tripwire.dump",tw_propose(tw,0,60,255),2,f);
    tw_free(tw);
}
fn vt_t_tw_nofire94(f:*i32)void {
    let tw:*TW=tw_new(1000);
    let k:i64=0;let fired:i32=0;
    while(k<188){let fc:i32=tw_propose(tw,k*5,k*5+5,255);if(fc!=0){fired=1;}tw_decide(tw,k,1);k=k+1;}
    vt_chk("vt.tripwire.nofire_94pct",fired,0,f);
    tw_free(tw);
}
fn vt_t_tw_nofire_halfrevise(f:*i32)void {
    let tw:*TW=tw_new(1000);
    let k:i64=0;
    while(k<200){tw_propose(tw,k*5,k*5+5,255);
        if(k%2==0){tw_decide(tw,k,1);}else{tw_decide(tw,k,2);}
        k=k+1;}
    let d:i64=0;let a:i64=0;let m:i64=0;
    tw_counts(tw,&d,&a,&m);
    let cond:i32=0;
    if(tw[0].covered_n*100>=1000*95 && d>0 && a*100>=d*95 && m*100>=d*90){cond=1;}
    vt_chk("vt.tripwire.nofire_halfrevise",cond,0,f);
    tw_free(tw);
}
// ---- policy unit tests: run against the REAL policy functions ----
fn vtt_state()*TState {
    let st:*TState=st_new();
    st_set_session(st,1);st_set_stimlen(st,200);
    return st;
}
fn vtt_work(st:*TState,stim:[]u8)*TWork {
    let w:*TWork=w_new();
    let nt:i64=tok_count(stim);
    let cap:i64=nt;if(cap<1){cap=1;}
    let tb:[]u8=nio_alloc((cap as i32)*16);
    tok_fill(stim,tb);
    w[0].a=nt;w[0].b=tb;
    let nr:i64=(st[0].b+63)/64;
    w[0].c=nr;
    let rb:[]u8=nio_alloc((nr as i32)*50);
    let zi:i32=0;while(zi<(nr as i32)*50){rb[zi]=0;zi=zi+1;}
    w[0].d=rb;
    ag_init(w);
    return w;
}
fn vtt_free(st:*TState,w:*TWork)void {
    nio_free(st[0].g);nio_free(st[0].h);_zag_free(st as *i8);
    nio_free(w[0].b);nio_free(w[0].d);nio_free(w[0].e);nio_free(w[0].f);_zag_free(w as *i8);
}
fn vt_t_tokenize(f:*i32)void {
    let s:[]u8="ab cd efg";
    vt_chk("vt.tokenize.n",tok_count(s) as i32,3,f);
    let tb:[]u8=nio_alloc(48);tok_fill(s,tb);
    vt_chk("vt.tokenize.t0s",t345_get64(tb,0) as i32,0,f);
    vt_chk("vt.tokenize.t0e",t345_get64(tb,8) as i32,2,f);
    vt_chk("vt.tokenize.t1s",t345_get64(tb,16) as i32,3,f);
    vt_chk("vt.tokenize.t1e",t345_get64(tb,24) as i32,5,f);
    vt_chk("vt.tokenize.t2s",t345_get64(tb,32) as i32,6,f);
    vt_chk("vt.tokenize.t2e",t345_get64(tb,40) as i32,9,f);
    nio_free(tb);
}
fn vt_t_appeal_chain(f:*i32)void {
    let st:*TState=vtt_state();
    let w:*TWork=vtt_work(st,"0123456789abcdefghij");
    let d:[]u8=dd_new();
    build_wordspan(st,w,d,0);
    vt_chk("vt.appeal.span_s",dg_s(d) as i32,0,f);
    vt_chk("vt.appeal.span_e",dg_e(d) as i32,20,f);
    vt_chk("vt.appeal.conf0",dg_conf(d),200,f);
    vt_chk("vt.appeal.ground0_n",dg_groundn(d),1,f);
    apply_decision(st,w,d,0,3,1,0,0,0); // R1
    vt_chk("vt.appeal.ag1",ag_count(w) as i32,1,f);
    let a1:[]u8=dd_new();ag_pop_head(w,a1);
    vt_chk("vt.appeal.a1kind",dg_kind(a1),1,f);
    vt_chk("vt.appeal.a1appeals",dg_appeals(a1),1,f);
    vt_chk("vt.appeal.a1conf",dg_conf(a1),180,f);
    vt_chk("vt.appeal.a1g0s",dg_ground_s(a1,0) as i32,0,f);
    vt_chk("vt.appeal.a1g0e",dg_ground_e(a1,0) as i32,20,f);
    vt_chk("vt.appeal.a1g1s",dg_ground_s(a1,1) as i32,20,f);
    apply_decision(st,w,a1,1,3,1,0,0,0); // R1 again
    vt_chk("vt.appeal.ag2",ag_count(w) as i32,1,f);
    let a2:[]u8=dd_new();ag_pop_head(w,a2);
    vt_chk("vt.appeal.a2appeals",dg_appeals(a2),2,f);
    vt_chk("vt.appeal.a2conf",dg_conf(a2),160,f);
    apply_decision(st,w,a2,2,3,1,0,0,0); // R1 third: final, stop
    vt_chk("vt.appeal.ag3",ag_count(w) as i32,0,f);
    vt_chk("vt.appeal.cursor",st[0].d as i32,1,f);
    vt_chk("vt.appeal.notdead",span_dead(st,0,20),0,f);
    let nx:[]u8=dd_new();
    vt_chk("vt.appeal.done",next_proposal(st,w,nx),0,f);
    nio_free(nx);nio_free(d);nio_free(a1);nio_free(a2);
    vtt_free(st,w);
}
fn vt_t_r5_dead(f:*i32)void {
    let st:*TState=vtt_state();
    let w:*TWork=vtt_work(st,"aa bb");
    let d:[]u8=dd_new();build_wordspan(st,w,d,0);
    apply_decision(st,w,d,0,3,5,0,0,0); // REJECT R5
    vt_chk("vt.r5.dead",span_dead(st,0,2),1,f);
    vt_chk("vt.r5.agenda",ag_count(w) as i32,0,f);
    let nx:[]u8=dd_new();
    vt_chk("vt.r5.next",next_proposal(st,w,nx),1,f);
    vt_chk("vt.r5.next_s",dg_s(nx) as i32,3,f);
    nio_free(nx);nio_free(d);vtt_free(st,w);
}
fn vt_t_twoconsec(f:*i32)void {
    let st:*TState=vtt_state();
    final_reject(st,30,35);
    vt_chk("vt.consec.once",span_dead(st,30,35),0,f);
    final_reject(st,30,35);
    vt_chk("vt.consec.twice",span_dead(st,30,35),1,f);
    vt_chk("vt.consec.other",span_dead(st,36,40),0,f);
    nio_free(st[0].g);nio_free(st[0].h);_zag_free(st as *i8);
}
fn vt_t_defer(f:*i32)void {
    let st:*TState=vtt_state();
    let w:*TWork=vtt_work(st,"aa bb");
    let d:[]u8=dd_new();build_wordspan(st,w,d,0);
    apply_decision(st,w,d,0,4,0,0,0,0); // DEFER
    vt_chk("vt.defer.ag1",ag_count(w) as i32,1,f);
    let r1:[]u8=dd_new();ag_pop_head(w,r1);
    vt_chk("vt.defer.flag",dg_flags(r1)&1,1,f);
    vt_chk("vt.defer.conf",dg_conf(r1),dg_conf(d)-10,f);
    vt_chk("vt.defer.groundn",dg_groundn(r1),2,f);
    apply_decision(st,w,r1,1,4,0,0,0,0); // DEFER again: move on
    vt_chk("vt.defer.ag2",ag_count(w) as i32,0,f);
    vt_chk("vt.defer.cursor",st[0].d as i32,1,f);
    nio_free(d);nio_free(r1);vtt_free(st,w);
}
fn vt_t_revise(f:*i32)void {
    let st:*TState=vtt_state();
    let w:*TWork=vtt_work(st,"aa bb cc dd");
    let d0:[]u8=dd_new();build_wordspan(st,w,d0,0);
    apply_decision(st,w,d0,0,1,0,0,0,0); // ADOPT (0,2)
    let d:[]u8=dd_new();build_wordspan(st,w,d,1); // (3,5)
    apply_decision(st,w,d,1,2,1,3,4,1); // REVISE -> (3,4)
    vt_chk("vt.revise.ag",ag_count(w) as i32,2,f);
    let s1:[]u8=dd_new();ag_pop_head(w,s1);
    vt_chk("vt.revise.sameas",dg_kind(s1),4,f);
    vt_chk("vt.revise.sa_s",dg_s(s1) as i32,3,f);
    vt_chk("vt.revise.sa_e",dg_e(s1) as i32,4,f);
    vt_chk("vt.revise.sa_aux",dg_auxn(s1),2,f);
    vt_chk("vt.revise.sa_conf",dg_conf(s1),120,f);
    let s2:[]u8=dd_new();ag_pop_head(w,s2);
    vt_chk("vt.revise.group",dg_kind(s2),3,f);
    vt_chk("vt.revise.gr_aux",dg_auxn(s2),2,f);
    vt_chk("vt.revise.gr_s",dg_s(s2) as i32,0,f);
    vt_chk("vt.revise.gr_e",dg_e(s2) as i32,4,f);
    vt_chk("vt.revise.cursor",st[0].d as i32,2,f);
    nio_free(d0);nio_free(d);nio_free(s1);nio_free(s2);vtt_free(st,w);
}
fn vt_t_region3(f:*i32)void {
    let st:*TState=vtt_state();
    let w:*TWork=vtt_work(st,"aa bb cc dd");
    let i:i64=0;
    while(i<3){
        let d:[]u8=dd_new();build_wordspan(st,w,d,i);
        apply_decision(st,w,d,i,1,0,0,0,0);
        nio_free(d);i=i+1;
    }
    vt_chk("vt.region3.ag",ag_count(w) as i32,2,f);
    let b:[]u8=dd_new();ag_pop_head(w,b);
    vt_chk("vt.region3.bkind",dg_kind(b),2,f);
    vt_chk("vt.region3.bs",dg_s(b) as i32,8,f);
    vt_chk("vt.region3.be",dg_e(b) as i32,9,f);
    vt_chk("vt.region3.bconf",dg_conf(b),120,f);
    let g:[]u8=dd_new();ag_pop_head(w,g);
    vt_chk("vt.region3.gkind",dg_kind(g),3,f);
    vt_chk("vt.region3.gaux",dg_auxn(g),3,f);
    vt_chk("vt.region3.g0s",dg_aux_s(g,0) as i32,6,f);
    vt_chk("vt.region3.g2e",dg_aux_e(g,2) as i32,2,f);
    nio_free(b);nio_free(g);vtt_free(st,w);
}
fn vt_t_r2_retract(f:*i32)void {
    let st:*TState=vtt_state();
    let w:*TWork=vtt_work(st,"aa bb");
    let d:[]u8=dd_new();build_wordspan(st,w,d,0);
    apply_decision(st,w,d,7,3,2,0,0,0); // REJECT R2, seq 7
    vt_chk("vt.r2.dead",span_dead(st,0,2),1,f);
    vt_chk("vt.r2.ag",ag_count(w) as i32,1,f);
    let r:[]u8=dd_new();ag_pop_head(w,r);
    vt_chk("vt.r2.rkind",dg_kind(r),5,f);
    vt_chk("vt.r2.rs",dg_s(r) as i32,7,f);
    vt_chk("vt.r2.re",dg_e(r) as i32,8,f);
    vt_chk("vt.r2.conf",dg_conf(r),64,f);
    nio_free(d);nio_free(r);vtt_free(st,w);
}
fn vt_t_r3_final(f:*i32)void {
    let st:*TState=vtt_state();
    let w:*TWork=vtt_work(st,"aa bb");
    let d:[]u8=dd_new();build_wordspan(st,w,d,0);
    apply_decision(st,w,d,0,3,3,0,0,0); // REJECT R3: final, no appeal
    vt_chk("vt.r3.dead",span_dead(st,0,2),1,f);
    vt_chk("vt.r3.ag",ag_count(w) as i32,0,f);
    vt_chk("vt.r3.cursor",st[0].d as i32,1,f);
    nio_free(d);vtt_free(st,w);
}
fn vt_t_retract_guard(f:*i32)void {
    let st:*TState=vtt_state();
    st_set_stimlen(st,5); // seq+1=8 > stim_len 5: retract must be skipped
    let w:*TWork=vtt_work(st,"aa bb");
    let d:[]u8=dd_new();build_wordspan(st,w,d,0);
    apply_decision(st,w,d,7,3,2,0,0,0); // REJECT R2, seq 7
    vt_chk("vt.rguard.dead",span_dead(st,0,2),1,f);
    vt_chk("vt.rguard.noag",ag_count(w) as i32,0,f);
    nio_free(d);vtt_free(st,w);
}
fn vt_t_agenda_drop(f:*i32)void {
    let st:*TState=vtt_state();
    let w:*TWork=vtt_work(st,"aa bb");
    let d:[]u8=dd_new();build_wordspan(st,w,d,0);
    mark_dead(st,0,2);
    ag_push_back(w,d);
    let nx:[]u8=dd_new();
    vt_chk("vt.agdrop.next",next_proposal(st,w,nx),1,f);
    vt_chk("vt.agdrop.s",dg_s(nx) as i32,3,f);
    vt_chk("vt.agdrop.agenda",ag_count(w) as i32,0,f);
    nio_free(d);nio_free(nx);vtt_free(st,w);
}
fn vt_test()i32 {
    let f:i32=0;
    vt_t_roundtrip(&f);vt_t_tamper(&f);vt_t_iron(&f);vt_t_iron2(&f);
    vt_t_tw_window(&f);vt_t_tw_dump(&f);vt_t_tw_nofire94(&f);vt_t_tw_nofire_halfrevise(&f);
    vt_t_tokenize(&f);vt_t_appeal_chain(&f);vt_t_r5_dead(&f);vt_t_twoconsec(&f);
    vt_t_defer(&f);vt_t_revise(&f);vt_t_region3(&f);vt_t_r2_retract(&f);
    vt_t_r3_final(&f);vt_t_retract_guard(&f);vt_t_agenda_drop(&f);
    _zag_print("VARA_FAILURES,");_zag_println(_zag_i64_to_str(f as i64));
    if(f!=0){return 1;}return 0;
}

// ================= §P ingress probe =================
// probe <case> <tape>: builds a valid proposal, tampers its §P wire per <case>,
// and feeds the tampered wire through the REAL hostile decode/validate path
// (the same sp_decode/sp_validate the emission gate uses). On violation V:
// INTEGRITY (1000+V) + footer HALTED:VIOLATION + exit V + zero TEACHER_MSG.
// Cases: bad_magic(1) bad_version(2) bad_length(10) bad_checksum(7)
//   bad_counts(9) bad_teacher(3) bad_session(3) bad_seq(4) bad_kind(6)
//   bad_span(5) bad_aux(8) bad_ground(8).
// (bad_conf is wire-unrepresentable — confidence is u8 on the wire — and is
// covered at the Prop level by vt.iron2.conf_300.)
fn probe_fix_checksum(wire:[]u8)void {
    let co:i32=wire.len-9;
    t345_set64(wire,co+1,t345_fnv(wire[0..co+1]));
}
// tampers wire in place per case; returns 0 on known case, -1 unknown.
// bad_length is handled by the caller via slicing (cannot truncate in place).
fn probe_tamper(case:[]u8,wire:[]u8)i32 {
    if(_zag_strcmp(case,"bad_magic")==1){wire[0]=wire[0]^0xFF;return 0;}
    if(_zag_strcmp(case,"bad_version")==1){wire[5]=wire[5]^0xFF;return 0;}
    if(_zag_strcmp(case,"bad_checksum")==1){wire[30]=wire[30]^0xFF;return 0;}
    if(_zag_strcmp(case,"bad_counts")==1){wire[60]=9;return 0;}
    if(_zag_strcmp(case,"bad_teacher")==1){t345_set32(wire,6,4);probe_fix_checksum(wire);return 0;}
    if(_zag_strcmp(case,"bad_session")==1){t345_set64(wire,10,9999);probe_fix_checksum(wire);return 0;}
    if(_zag_strcmp(case,"bad_seq")==1){t345_set64(wire,18,99);probe_fix_checksum(wire);return 0;}
    if(_zag_strcmp(case,"bad_kind")==1){wire[26]=9;probe_fix_checksum(wire);return 0;}
    if(_zag_strcmp(case,"bad_span")==1){t345_set64(wire,35,0);probe_fix_checksum(wire);return 0;}
    if(_zag_strcmp(case,"bad_aux")==1){t345_set64(wire,44,200);t345_set64(wire,52,300);probe_fix_checksum(wire);return 0;}
    if(_zag_strcmp(case,"bad_ground")==1){t345_set64(wire,61,200);t345_set64(wire,69,300);probe_fix_checksum(wire);return 0;}
    return -1;
}
fn probe_known(case:[]u8)i32 {
    if(_zag_strcmp(case,"bad_magic")==1){return 1;}
    if(_zag_strcmp(case,"bad_version")==1){return 1;}
    if(_zag_strcmp(case,"bad_length")==1){return 1;}
    if(_zag_strcmp(case,"bad_checksum")==1){return 1;}
    if(_zag_strcmp(case,"bad_counts")==1){return 1;}
    if(_zag_strcmp(case,"bad_teacher")==1){return 1;}
    if(_zag_strcmp(case,"bad_session")==1){return 1;}
    if(_zag_strcmp(case,"bad_seq")==1){return 1;}
    if(_zag_strcmp(case,"bad_kind")==1){return 1;}
    if(_zag_strcmp(case,"bad_span")==1){return 1;}
    if(_zag_strcmp(case,"bad_aux")==1){return 1;}
    if(_zag_strcmp(case,"bad_ground")==1){return 1;}
    return 0;
}
fn run_probe(case:[]u8,tape_name:[]u8)i32 {
    if(probe_known(case)==0){
        _zag_println("usage: teacher probe <case> <tape>");return 64;
    }
    let g:*GT=gt_load("gt_demo.txt");
    if(g[0].n<0){_zag_println("VARA: probe cannot load gt_demo.txt");return 64;}
    let sl:i64=g[0].stim.len as i64;
    let t:*Tape=tape_open();
    let pr:[]u8=nio_alloc(32);
    let zi:i32=0;while(zi<32){pr[zi]=0;zi=zi+1;}
    let e:*TBuf=ev_header(9000,3,pr,"arm3-varA-deliberative/probe");
    tape_event(t,1,tbuf_bytes(e));tbuf_free(e);
    e=ev_stimulus(1,0,sl);
    tape_event(t,2,tbuf_bytes(e));tbuf_free(e);
    nio_free(pr);
    // valid base proposal: WORD_SPAN [0,5) conf 200, aux [10,20), ground [0,5)
    let ph:*PropH=proph_new();
    ph[0].teacher_id=3;ph[0].session_id=9000;ph[0].seq=0;ph[0].kind=1;
    ph[0].span_start=0;ph[0].span_end=5;ph[0].confidence=200;
    let pt:*PropT=propt_new();
    pt[0].aux_count=1;pt[0].ground_count=1;
    pt[0].aux=nio_alloc(16);t345_set64(pt[0].aux,0,10);t345_set64(pt[0].aux,8,20);
    pt[0].ground=nio_alloc(16);t345_set64(pt[0].ground,0,0);t345_set64(pt[0].ground,8,5);
    let wire:[]u8=sp_encode(ph,pt);
    // sanity: the untampered wire must validate (else the probe itself is broken)
    let sh:*PropH=proph_new();let st2:*PropT=propt_new();
    let sv:i32=sp_decode(wire,sh,st2);
    if(sv==0){sv=sp_validate(sh,st2,9000,0,sl);}
    sp_free(st2);_zag_free(sh as *i8);_zag_free(st2 as *i8);
    if(sv!=0){
        _zag_println("VARA: probe base wire invalid; aborting");
        nio_free(wire);sp_free(pt);
        _zag_free(ph as *i8);_zag_free(pt as *i8);
        gt_free(g);tape_close(t);
        return 64;
    }
    if(_zag_strcmp(case,"bad_length")==1){
        wire=wire[0..wire.len-1];
    } else {
        probe_tamper(case,wire);
    }
    // the hostile ingress gate: exactly what emit_proposal runs pre-emission
    let qh:*PropH=proph_new();let qt:*PropT=propt_new();
    let vc:i32=sp_decode(wire,qh,qt);
    if(vc==0){vc=sp_validate(qh,qt,9000,0,sl);}
    nio_free(wire);sp_free(pt);sp_free(qt);
    _zag_free(ph as *i8);_zag_free(pt as *i8);_zag_free(qh as *i8);_zag_free(qt as *i8);
    gt_free(g);
    if(vc==0){
        _zag_print("VARA: probe case ");_zag_print(case);
        _zag_println(" did NOT violate; probe bug");
        tape_close(t);
        return 64;
    }
    if(vc<1 || vc>10){
        _zag_println("VARA: probe violation out of range; probe bug");
        tape_close(t);
        return 64;
    }
    let ie:*TBuf=ev_integrity(1000+vc,0,0,0,0,0,0,0,0);
    tape_event(t,7,tbuf_bytes(ie));tbuf_free(ie);
    let f:*TBuf=ev_footer(t[0].count,t[0].chain,"HALTED:VIOLATION");
    tape_event(t,9,tbuf_bytes(f));tbuf_free(f);
    if(tape_write_file(t,tape_name)!=0){_zag_println("VARA: probe tape write failed");tape_close(t);return 13;}
    tape_close(t);
    _zag_print("VARA: probe ");_zag_print(case);
    _zag_print(" violation=");_zag_println(_zag_i64_to_str(vc as i64));
    _zag_print("VARA_END,proposals=0,violations=1,code=");
    _zag_println(_zag_i64_to_str((1000+vc) as i64));
    return vc;
}
fn main()i32 {
    let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"")==1){_zag_println("usage: teacher <teach|test> ...");return 64;}
    if(_zag_strcmp(mode,"test")==1){return vt_test();}
    if(_zag_strcmp(mode,"teach")==1){
        let script:[]u8=_zag_arg(2);
        let tape:[]u8=_zag_arg(3);
        let hf:[]u8=_zag_arg(4);
        if(_zag_strcmp(script,"")==1 || _zag_strcmp(tape,"")==1){
            _zag_println("usage: teacher teach <script> <tape> [heapfill]");return 64;
        }
        return run_teach(script,tape,hf);
    }
    if(_zag_strcmp(mode,"probe")==1){
        let pcase:[]u8=_zag_arg(2);
        let ptape:[]u8=_zag_arg(3);
        if(_zag_strcmp(pcase,"")==1 || _zag_strcmp(ptape,"")==1){
            _zag_println("usage: teacher probe <case> <tape>");return 64;
        }
        return run_probe(pcase,ptape);
    }
    _zag_println("usage: teacher <teach|test|probe> ...");
    return 64;
}

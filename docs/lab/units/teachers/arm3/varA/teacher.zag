    ph[0].session_id=9;
    let big:[]u8=nio_alloc(64);
    t345_set32(big,0,0x54505250);t345_set16(big,4,1);big[43]=0;big[44]=9;
    vt_chk("vt.iron2.counts_ground9",sp_decode(big,qh,qt),V_COUNTS(),f);
    nio_free(big);
    pt[0].aux_count=1;pt[0].aux=nio_alloc(16);
    t345_set64(pt[0].aux,0,200);t345_set64(pt[0].aux,8,300);
    vt_chk("vt.iron2.range_aux",sp_validate(ph,pt,9,0,100),V_RANGE(),f);
    sp_free(pt);pt[0].aux="";pt[0].aux_count=0;
    pt[0].ground_count=1;pt[0].ground=nio_alloc(16);

fn test_codec() i32 {
    let sess:u64 = 0xC0DE;
    let fails:i32 = 0;
    let k:i32 = 1;
    while(k <= 5) {
        let b:[]u8 = t_prop(7, 1, k as u8, 200, 0, 16, 1, 1, sess);
        let p:PProp = p_decode(b, sess);
        if(p.ok != 1 || p.teacher_id != 1 || p.kind != (k as u8) ||
           p.seq != 7 || p.span_start != 0 || p.span_end != 16 ||
           p.confidence != 200 || p.aux_n != 1 || p.ground_n != 1) {
            fails = fails + 1;
        }
        // wrong session id must fail the explicit session binding
        let q:PProp = p_decode(b, sess + 1);
        if(q.ok != 0 || q.code != IR_BAD_SESSION) { fails = fails + 1; }
        // tampered checksum byte
        let t:[]u8 = t_tamper(b);
        let r:PProp = p_decode(t, sess);
        if(r.ok != 0 || r.code != IR_BAD_CHECKSUM) { fails = fails + 1; }
        nio_free(b); nio_free(t);
        k = k + 1;
    }
    // bad magic / bad version
    let b:[]u8 = t_prop(1, 1, 1, 1, 0, 16, 0, 0, sess);
    b[0] = 0x51;
    let p:PProp = p_decode(b, sess);
    if(p.ok != 0 || p.code != IR_BAD_MAGIC) { fails = fails + 1; }
    b[0] = 0x50; b[4] = 2;
    // fix checksum is unnecessary: version is checked before checksum
    let q:PProp = p_decode(b, sess);
    if(q.ok != 0 || q.code != IR_BAD_VERSION) { fails = fails + 1; }
    nio_free(b);
    return t_report("codec", (fails == 0) as i32);
}

// one malformed feed must be rejected with the exact code and leave the
// accepted stream untouched
fn t_expect_reject(s:*Session, bytes:[]u8, want:i32, fails:*i32) void {
    let np0:u64 = s.*.n_proposals;
    let ls0:u64 = s.*.last_seq;
    let rc:i32 = gate_ingress(s, bytes);
    if(rc != want || s.*.n_proposals != np0 || s.*.last_seq != ls0) {
        fails.* = fails.* + 1;
    }
}

fn test_malformed() i32 {
    let sess:u64 = 0xC0DE;
    let stim:[]u8 = t_stim();
        let s:Session = Session{.session_id=0, .arm_id=0, .curriculum_id=0, .cursor=0, .stim=nio_alloc(0), .stim_id=0, .stim_len=0, .delib_budget=0, .defer_max=0, .oracle_budget=0, .oracle_used=0, .state=0, .last_seq=0, .n_proposals=0, .student=Student{.ustart=nio_alloc(0) as []u64, .uend=nio_alloc(0) as []u64, .ulive=nio_alloc(0), .ustr=nio_alloc(0), .uteach=nio_alloc(0), .upseq=nio_alloc(0) as []u64, .n_units=0, .aspan_s=nio_alloc(0) as []u64, .aspan_e=nio_alloc(0) as []u64, .consec=nio_alloc(0), .appeals=nio_alloc(0), .alast=nio_alloc(0) as []u64, .n_spans=0, .dprop=nio_alloc(0), .dlen=nio_alloc(0), .dturns=nio_alloc(0), .n_defer=0, .qpending=0, .qseq=0, .qkind=0, .qmsg=0, .qappeal=0, .qprop=nio_alloc(0), .qprop_len=0, .n_adopt=0, .n_revise=0, .n_reject=0, .n_defer_c=0, .n_retract_c=0, .n_appeal_c=0, .policy=0, .budget_left=0, .turn_n=0, .hyp_reg=0, .genesis=nio_alloc(0)}, .tape=Tape{.buf=nio_alloc(0), .len=0, .seq=0, .full=0}, .ledger=StStore{.live=nio_alloc(0), .value=nio_alloc(0), .pinned=nio_alloc(0), .region=nio_alloc(0), .tier=nio_alloc(0), .step=nio_alloc(0), .st_str=nio_alloc(0), .st_sorg=nio_alloc(0), .st_sclk=nio_alloc(0), .forcepin=nio_alloc(0), .pintrainer=nio_alloc(0), .cite_n=nio_alloc(0), .cite_ep=nio_alloc(0), .justified=nio_alloc(0), .audit=nio_alloc(0), .audit_n=0, .audit_cap=0, .cap=0, .stage=0, .clock=0, .overflow=0}, .tw_fired=0, .n_ingress_reject=0, .oracle_script=nio_alloc(0), .oracle_script_n=0, .tw_s=nio_alloc(0) as []u64, .tw_e=nio_alloc(0) as []u64, .tw_c=nio_alloc(0), .tw_v=nio_alloc(0), .last_msg_tick=0, .hint_tick=0, .hint_s=0, .hint_e=0, .hint_on=0};
    t_begin(&s, sess, POL_EVIDENCE, stim, 8, 8, T_PEER);
    let fails:i32 = 0;
    let good:[]u8 = t_prop(1, 1, K_WORD, 200, 0, 16, 0, 0, sess);
    // truncated
    t_expect_reject(&s, good[0..10], IR_BAD_LENGTH, &fails);
    // bad magic
    let b1:[]u8 = t_tamper(good);
    b1[0] = 0x00;
    t_expect_reject(&s, b1, IR_BAD_MAGIC, &fails);
    nio_free(b1);
    // bad version (checksum irrelevant: version checked first)
    let b2:[]u8 = nio_alloc(good.len);
    let i:i32 = 0;
    while(i < good.len) { b2[i] = good[i]; i = i + 1; }
    b2[4] = 9;
    t_expect_reject(&s, b2, IR_BAD_VERSION, &fails);
    nio_free(b2);
    // teacher 0 / 2 / 6
    let t0:[]u8 = t_prop(1, 0, K_WORD, 200, 0, 16, 0, 0, sess);
    t_expect_reject(&s, t0, IR_BAD_TEACHER, &fails);
    nio_free(t0);
    let t2:[]u8 = t_prop(1, 2, K_WORD, 200, 0, 16, 0, 0, sess);
    t_expect_reject(&s, t2, IR_BAD_TEACHER, &fails);
    nio_free(t2);
    let t6:[]u8 = t_prop(1, 6, K_WORD, 200, 0, 16, 0, 0, sess);
    t_expect_reject(&s, t6, IR_BAD_TEACHER, &fails);
    nio_free(t6);
    // kind 0 / 6 (no ADOPT command kind exists)
    let k0:[]u8 = t_prop(1, 1, 0, 200, 0, 16, 0, 0, sess);
    t_expect_reject(&s, k0, IR_BAD_KIND, &fails);
    nio_free(k0);
    let k6:[]u8 = t_prop(1, 1, 6, 200, 0, 16, 0, 0, sess);
    t_expect_reject(&s, k6, IR_BAD_KIND, &fails);
    nio_free(k6);
    // aux / ground overflow
    let ao:[]u8 = t_prop(1, 1, K_WORD, 200, 0, 32, 17, 0, sess);
    t_expect_reject(&s, ao, IR_BAD_COUNT, &fails);
    nio_free(ao);
    let go:[]u8 = t_prop(1, 1, K_WORD, 200, 0, 32, 0, 17, sess);
    t_expect_reject(&s, go, IR_BAD_COUNT, &fails);
    nio_free(go);
    // bad spans: end<=start, end>stim, aux span invalid
    let bs:[]u8 = t_prop(1, 1, K_WORD, 200, 16, 16, 0, 0, sess);
    t_expect_reject(&s, bs, IR_BAD_SPAN, &fails);
    nio_free(bs);
    let bo:[]u8 = t_prop(1, 1, K_WORD, 200, 250, 300, 0, 0, sess);
    t_expect_reject(&s, bo, IR_BAD_SPAN, &fails);
    nio_free(bo);
    // overlong: valid proposal + 1 token-id byte / 4 string bytes / 32 vector bytes
    let sm1:[]u8 = nio_alloc(good.len + 1);
    i = 0;
    while(i < good.len) { sm1[i] = good[i]; i = i + 1; }
    sm1[good.len] = 0x41;
    t_expect_reject(&s, sm1, IR_BAD_LENGTH, &fails);
    nio_free(sm1);
    let sm4:[]u8 = nio_alloc(good.len + 4);
    i = 0;
    while(i < good.len) { sm4[i] = good[i]; i = i + 1; }
    t_expect_reject(&s, sm4, IR_BAD_LENGTH, &fails);
    nio_free(sm4);
    let sm32:[]u8 = nio_alloc(good.len + 32);
    i = 0;
    while(i < good.len) { sm32[i] = good[i]; i = i + 1; }
    t_expect_reject(&s, sm32, IR_BAD_LENGTH, &fails);
    nio_free(sm32);
    // declared aux but truncated body
    let tr:[]u8 = nio_alloc(60);
    i = 0;
    while(i < 30) { tr[i] = good[i]; i = i + 1; }
    tr[43] = 1;  // aux_n = 1, body too short
    t_expect_reject(&s, tr, IR_BAD_LENGTH, &fails);
    nio_free(tr);
    // bad checksum
    let bc:[]u8 = t_tamper(good);
    t_expect_reject(&s, bc, IR_BAD_CHECKSUM, &fails);
    nio_free(bc);
    // oversize ingress
    let big:[]u8 = nio_alloc(2000);
    i = 0;
    while(i < 2000) { big[i] = 0; i = i + 1; }
    t_expect_reject(&s, big, IR_BAD_LENGTH, &fails);
    nio_free(big);
    nio_free(good);
    // 18 rejects logged, zero accepted
    let r1:i32 = t_ev_count(&s, EV_INGRESS_REJECT);
    if(r1 != 18) { fails = fails + 1; }
    if(s.n_proposals != 0 || s.last_seq != 0) { fails = fails + 1; }
    // the session still accepts a good proposal afterwards
    let g2:[]u8 = t_prop(1, 1, K_WORD, 200, 0, 16, 0, 0, sess);
    let rc:i32 = gate_ingress(&s, g2);
    if(rc != IR_OK || s.n_proposals != 1) { fails = fails + 1; }
    nio_free(g2);
    session_close(&s);
    session_free(&s);
    nio_free(stim);
    return t_report("malformed", (fails == 0) as i32);
}


// The canonical mixed script. noise=0: clean; noise!=0: interleaves three
// rejected proposals (bad checksum, teacher 2, bad kind). Returns the
// unique-span base, or u64::MAX when a stimulus assumption breaks.
fn canon_run(s:*Session, sess:u64, noise:i32) u64 {
    let stim:[]u8 = s.*.stim;
    if(stim_count(stim, 0, 16) < 2) { return 0xFFFFFFFFFFFFFFFF; }
    if(stim_count(stim, 31, 47) != 1) { return 0xFFFFFFFFFFFFFFFF; }
    if(stim_count(stim, 30, 46) != 1) { return 0xFFFFFFFFFFFFFFFF; }
    if(stim_count(stim, 32, 48) < 2) { return 0xFFFFFFFFFFFFFFFF; }
    let u:u64 = t_find_unique(stim);
    if(u == 0xFFFFFFFFFFFFFFFF) { return u; }
    let p1:[]u8 = t_prop(1, 1, K_WORD, 200, 0, 16, 0, 0, sess);
    gate_ingress(s, p1); nio_free(p1);
    if(noise != 0) {
        let nz:[]u8 = t_tamper(t_prop(99, 1, K_WORD, 200, 0, 16, 0, 0, sess));
        gate_ingress(s, nz); nio_free(nz);
    }
    let p2:[]u8 = t_prop(2, 1, K_WORD, 200, u, u+16, 0, 0, sess);
    gate_ingress(s, p2); nio_free(p2);
    let p3:[]u8 = t_prop(3, 1, K_WORD, 200, 31, 47, 0, 0, sess);
    gate_ingress(s, p3); nio_free(p3);
    let p4:[]u8 = t_prop(4, 1, K_RETRACT, 200, 1, 2, 0, 0, sess);
    gate_ingress(s, p4); nio_free(p4);
    let p5:[]u8 = t_prop(5, 1, K_RETRACT, 200, 2, 3, 0, 0, sess);
    gate_ingress(s, p5); nio_free(p5);
    if(noise != 0) {
        let nz2:[]u8 = t_prop(99, 2, K_WORD, 200, 0, 16, 0, 0, sess);
        gate_ingress(s, nz2); nio_free(nz2);
    }
    let p6:[]u8 = t_prop(6, 1, K_WORD, 200, u, u+16, 0, 0, sess);
    gate_ingress(s, p6); nio_free(p6);
    let p7:[]u8 = t_prop(7, 1, K_WORD, 200, u, u+16, 0, 0, sess);
    gate_ingress(s, p7); nio_free(p7);
    let p8:[]u8 = t_prop(8, 1, K_WORD, 200, u, u+16, 0, 0, sess);
    gate_ingress(s, p8); nio_free(p8);
    if(noise != 0) {
        let nz3:[]u8 = t_prop(99, 1, 6, 200, 0, 16, 0, 0, sess);
        gate_ingress(s, nz3); nio_free(nz3);
    }
    let p9:[]u8 = t_prop(9, 1, K_WORD, 200, u, u+16, 0, 0, sess);
    gate_ingress(s, p9); nio_free(p9);
    let bad:[]u8 = t_tamper(t_prop(10, 1, K_WORD, 200, 0, 16, 0, 0, sess));
    gate_ingress(s, bad); nio_free(bad);
    let p11:[]u8 = t_prop(10, 1, K_WORD, 200, 64, 80, 0, 0, sess);
    gate_ingress(s, p11); nio_free(p11);
    session_turn(s);
    let p12:[]u8 = t_prop(11, 3, K_WORD, 200, 96, 112, 0, 0, sess);
    gate_ingress(s, p12); nio_free(p12);
    return u;
}

fn test_replay() i32 {
    let fails:i32 = 0;
    let sess:u64 = 0xBEA7;
    let stim:[]u8 = t_stim();
        let s:Session = Session{.session_id=0, .arm_id=0, .curriculum_id=0, .cursor=0, .stim=nio_alloc(0), .stim_id=0, .stim_len=0, .delib_budget=0, .defer_max=0, .oracle_budget=0, .oracle_used=0, .state=0, .last_seq=0, .n_proposals=0, .student=Student{.ustart=nio_alloc(0) as []u64, .uend=nio_alloc(0) as []u64, .ulive=nio_alloc(0), .ustr=nio_alloc(0), .uteach=nio_alloc(0), .upseq=nio_alloc(0) as []u64, .n_units=0, .aspan_s=nio_alloc(0) as []u64, .aspan_e=nio_alloc(0) as []u64, .consec=nio_alloc(0), .appeals=nio_alloc(0), .alast=nio_alloc(0) as []u64, .n_spans=0, .dprop=nio_alloc(0), .dlen=nio_alloc(0), .dturns=nio_alloc(0), .n_defer=0, .qpending=0, .qseq=0, .qkind=0, .qmsg=0, .qappeal=0, .qprop=nio_alloc(0), .qprop_len=0, .n_adopt=0, .n_revise=0, .n_reject=0, .n_defer_c=0, .n_retract_c=0, .n_appeal_c=0, .policy=0, .budget_left=0, .turn_n=0, .hyp_reg=0, .genesis=nio_alloc(0)}, .tape=Tape{.buf=nio_alloc(0), .len=0, .seq=0, .full=0}, .ledger=StStore{.live=nio_alloc(0), .value=nio_alloc(0), .pinned=nio_alloc(0), .region=nio_alloc(0), .tier=nio_alloc(0), .step=nio_alloc(0), .st_str=nio_alloc(0), .st_sorg=nio_alloc(0), .st_sclk=nio_alloc(0), .forcepin=nio_alloc(0), .pintrainer=nio_alloc(0), .cite_n=nio_alloc(0), .cite_ep=nio_alloc(0), .justified=nio_alloc(0), .audit=nio_alloc(0), .audit_n=0, .audit_cap=0, .cap=0, .stage=0, .clock=0, .overflow=0}, .tw_fired=0, .n_ingress_reject=0, .oracle_script=nio_alloc(0), .oracle_script_n=0, .tw_s=nio_alloc(0) as []u64, .tw_e=nio_alloc(0) as []u64, .tw_c=nio_alloc(0), .tw_v=nio_alloc(0), .last_msg_tick=0, .hint_tick=0, .hint_s=0, .hint_e=0, .hint_on=0};
    t_begin(&s, sess, POL_EVIDENCE, stim, 64, 8, T_PEER);
    let u:u64 = canon_run(&s, sess, 0);
    if(u == 0xFFFFFFFFFFFFFFFF) { fails = fails + 100; }
    if(t_verdict_of(&s, 1) != V_ADOPT) { fails = fails + 1; }
    if(t_verdict_of(&s, 2) != V_REJECT) { fails = fails + 1; }
    if(t_verdict_of(&s, 3) != V_REVISE) { fails = fails + 1; }
    if(t_verdict_of(&s, 4) != V_REJECT) { fails = fails + 1; }
    if(t_verdict_of(&s, 8) != V_REJECT) { fails = fails + 1; }
    if(t_verdict_of(&s, 9) != V_REJECT) { fails = fails + 1; }
    if(t_verdict_of(&s, 10) != V_ADOPT) { fails = fails + 1; }
    if(t_verdict_of(&s, 11) != V_ADOPT) { fails = fails + 1; }
    if(t_delib_count(&s, 7) != 2) { fails = fails + 1; }
    if(t_delib_count(&s, 8) != 1) { fails = fails + 1; }
    if(t_delib_count(&s, 9) != 1) { fails = fails + 1; }
    if(t_delib_count(&s, 1) != 4) { fails = fails + 1; }
    if(t_ev_count(&s, EV_APPEAL) != 4) { fails = fails + 1; }
    if(t_ev_count(&s, EV_TURN) != 1) { fails = fails + 1; }
    if(t_ev_count(&s, EV_INGRESS_REJECT) != 1) { fails = fails + 1; }
    if(t_ev_count(&s, EV_DELIB) != 36) { fails = fails + 1; }
    session_close(&s);
    let raw:[]u8 = tape_bytes(&s.tape);
    let cp:[]u8 = nio_alloc(raw.len);
    let i:i32 = 0;
    while(i < raw.len) { cp[i] = raw[i]; i = i + 1; }
    if(replay_verify(cp, stim, "harness-test") != 0) { fails = fails + 1; }
    // tamper: flip one body byte of a DELIB record -> fail closed, located
    let cp2:[]u8 = nio_alloc(raw.len);
    i = 0;
    while(i < raw.len) { cp2[i] = raw[i]; i = i + 1; }
    let pos:i32 = 0;
    while(pos + 4 <= cp2.len) {
        let rl:i32 = h_get_u32(cp2, pos) as i32;
        if(rl < 14 || pos + 4 + rl > cp2.len) { break; }
        if(h_get_u16(cp2, pos + 4) == (EV_DELIB as u16)) {
            cp2[pos + 14 + 20] = cp2[pos + 14 + 20] ^ 0x01;
            break;
        }
        pos = pos + 4 + rl;
    }
    if(replay_verify(cp2, stim, "harness-test") == 0) { fails = fails + 1; }
    nio_free(cp);
    nio_free(cp2);
    session_free(&s);
    nio_free(stim);
    return t_report("replay", (fails == 0) as i32);
}


fn test_hint() i32 {
    let fails:i32 = 0;
    let sess:u64 = 0x4177;
    let stim:[]u8 = t_stim();
        let s:Session = Session{.session_id=0, .arm_id=0, .curriculum_id=0, .cursor=0, .stim=nio_alloc(0), .stim_id=0, .stim_len=0, .delib_budget=0, .defer_max=0, .oracle_budget=0, .oracle_used=0, .state=0, .last_seq=0, .n_proposals=0, .student=Student{.ustart=nio_alloc(0) as []u64, .uend=nio_alloc(0) as []u64, .ulive=nio_alloc(0), .ustr=nio_alloc(0), .uteach=nio_alloc(0), .upseq=nio_alloc(0) as []u64, .n_units=0, .aspan_s=nio_alloc(0) as []u64, .aspan_e=nio_alloc(0) as []u64, .consec=nio_alloc(0), .appeals=nio_alloc(0), .alast=nio_alloc(0) as []u64, .n_spans=0, .dprop=nio_alloc(0), .dlen=nio_alloc(0), .dturns=nio_alloc(0), .n_defer=0, .qpending=0, .qseq=0, .qkind=0, .qmsg=0, .qappeal=0, .qprop=nio_alloc(0), .qprop_len=0, .n_adopt=0, .n_revise=0, .n_reject=0, .n_defer_c=0, .n_retract_c=0, .n_appeal_c=0, .policy=0, .budget_left=0, .turn_n=0, .hyp_reg=0, .genesis=nio_alloc(0)}, .tape=Tape{.buf=nio_alloc(0), .len=0, .seq=0, .full=0}, .ledger=StStore{.live=nio_alloc(0), .value=nio_alloc(0), .pinned=nio_alloc(0), .region=nio_alloc(0), .tier=nio_alloc(0), .step=nio_alloc(0), .st_str=nio_alloc(0), .st_sorg=nio_alloc(0), .st_sclk=nio_alloc(0), .forcepin=nio_alloc(0), .pintrainer=nio_alloc(0), .cite_n=nio_alloc(0), .cite_ep=nio_alloc(0), .justified=nio_alloc(0), .audit=nio_alloc(0), .audit_n=0, .audit_cap=0, .cap=0, .stage=0, .clock=0, .overflow=0}, .tw_fired=0, .n_ingress_reject=0, .oracle_script=nio_alloc(0), .oracle_script_n=0, .tw_s=nio_alloc(0) as []u64, .tw_e=nio_alloc(0) as []u64, .tw_c=nio_alloc(0), .tw_v=nio_alloc(0), .last_msg_tick=0, .hint_tick=0, .hint_s=0, .hint_e=0, .hint_on=0};
    t_begin(&s, sess, POL_EVIDENCE, stim, 64, 8, T_SYMH);
    let h:[]u8 = t_hint(sess, 120, 136, 200);
    if(session_hint(&s, h) != IR_OK) { fails = fails + 1; }
    // find the hint's tick
    let rt:RTape = rtape_parse(tape_bytes(&s.tape));
    let htick:u64 = 0xFFFFFFFFFFFFFFFF;
    let j:i32 = 0;
    while(j < rt.nev) {
        if(au16_get(rt.etype, j as i64) as i32 == EV_HINT) { htick = rt.etick[j]; }
        j = j + 1;
    }
    rtape_free(&rt);
    if(htick == 0xFFFFFFFFFFFFFFFF) { fails = fails + 1; }
    let u:u64 = t_find_unique(stim);
    let p1:[]u8 = t_prop(1, 1, K_WORD, 200, u, u+16, 0, 0, sess);
    gate_ingress(&s, p1); nio_free(p1);
    // the overlapping proposal's DELIB records must cite the hint tick
    let rt2:RTape = rtape_parse(tape_bytes(&s.tape));
    let cited:i32 = 0;
    j = 0;
    while(j < rt2.nev) {
        if(au16_get(rt2.etype, j as i64) as i32 == EV_DELIB) {
            let b:[]u8 = rtape_body(rt2, j);
            if(h_get_u64(b, 0) == 1 && b[9] == 2 && h_get_u64(b, 18) == htick) {
                cited = cited + 1;
            }
        }
        j = j + 1;
    }
    rtape_free(&rt2);
    if(cited != 4) { fails = fails + 1; }
    // a non-overlapping proposal must NOT cite the hint
    let p2:[]u8 = t_prop(2, 1, K_WORD, 200, 0, 16, 0, 0, sess);
    gate_ingress(&s, p2); nio_free(p2);
    let rt3:RTape = rtape_parse(tape_bytes(&s.tape));
    j = 0;
    while(j < rt3.nev) {
        if(au16_get(rt3.etype, j as i64) as i32 == EV_DELIB) {
            let b:[]u8 = rtape_body(rt3, j);
            if(h_get_u64(b, 0) == 2 && b[9] != 1) { fails = fails + 1; }
        }
        j = j + 1;
    }
    rtape_free(&rt3);
    // bad hint is rejected and logged
    let hb:[]u8 = t_tamper(h);
    if(session_hint(&s, hb) != IR_BAD_HINT) { fails = fails + 1; }
    if(t_ev_count(&s, EV_INGRESS_REJECT) != 1) { fails = fails + 1; }
    nio_free(h); nio_free(hb);
    session_close(&s);
    if(replay_verify(tape_bytes(&s.tape), stim, "harness-test") != 0) { fails = fails + 1; }
    session_free(&s);
    nio_free(stim);
    return t_report("hint", (fails == 0) as i32);
}

fn test_oracle() i32 {
    let fails:i32 = 0;
    let sess:u64 = 0x05AC;
    let stim:[]u8 = t_stim();
        let s:Session = Session{.session_id=0, .arm_id=0, .curriculum_id=0, .cursor=0, .stim=nio_alloc(0), .stim_id=0, .stim_len=0, .delib_budget=0, .defer_max=0, .oracle_budget=0, .oracle_used=0, .state=0, .last_seq=0, .n_proposals=0, .student=Student{.ustart=nio_alloc(0) as []u64, .uend=nio_alloc(0) as []u64, .ulive=nio_alloc(0), .ustr=nio_alloc(0), .uteach=nio_alloc(0), .upseq=nio_alloc(0) as []u64, .n_units=0, .aspan_s=nio_alloc(0) as []u64, .aspan_e=nio_alloc(0) as []u64, .consec=nio_alloc(0), .appeals=nio_alloc(0), .alast=nio_alloc(0) as []u64, .n_spans=0, .dprop=nio_alloc(0), .dlen=nio_alloc(0), .dturns=nio_alloc(0), .n_defer=0, .qpending=0, .qseq=0, .qkind=0, .qmsg=0, .qappeal=0, .qprop=nio_alloc(0), .qprop_len=0, .n_adopt=0, .n_revise=0, .n_reject=0, .n_defer_c=0, .n_retract_c=0, .n_appeal_c=0, .policy=0, .budget_left=0, .turn_n=0, .hyp_reg=0, .genesis=nio_alloc(0)}, .tape=Tape{.buf=nio_alloc(0), .len=0, .seq=0, .full=0}, .ledger=StStore{.live=nio_alloc(0), .value=nio_alloc(0), .pinned=nio_alloc(0), .region=nio_alloc(0), .tier=nio_alloc(0), .step=nio_alloc(0), .st_str=nio_alloc(0), .st_sorg=nio_alloc(0), .st_sclk=nio_alloc(0), .forcepin=nio_alloc(0), .pintrainer=nio_alloc(0), .cite_n=nio_alloc(0), .cite_ep=nio_alloc(0), .justified=nio_alloc(0), .audit=nio_alloc(0), .audit_n=0, .audit_cap=0, .cap=0, .stage=0, .clock=0, .overflow=0}, .tw_fired=0, .n_ingress_reject=0, .oracle_script=nio_alloc(0), .oracle_script_n=0, .tw_s=nio_alloc(0) as []u64, .tw_e=nio_alloc(0) as []u64, .tw_c=nio_alloc(0), .tw_v=nio_alloc(0), .last_msg_tick=0, .hint_tick=0, .hint_s=0, .hint_e=0, .hint_on=0};
    t_begin(&s, sess, POL_EVIDENCE, stim, 64, 2, T_SYMY);
    let u1:u64 = t_find_unique(stim);
    let u2:u64 = u1 + 32;
    while(u2 + 16 <= 200 && stim_count(stim, u2, u2+16) != 1) { u2 = u2 + 1; }
    let u3:u64 = u2 + 32;
    while(u3 + 16 <= 200 && stim_count(stim, u3, u3+16) != 1) { u3 = u3 + 1; }
    if(u1 == 0xFFFFFFFFFFFFFFFF || u2 + 16 > 200 || u3 + 16 > 200) {
        fails = fails + 100;
    }
    // low-confidence WORD_SPAN -> query + suspend
    let p1:[]u8 = t_prop(1, 1, K_WORD, 100, u1, u1+16, 0, 0, sess);
    gate_ingress(&s, p1); nio_free(p1);
    if(s.student.qpending != 1) { fails = fails + 1; }
    if(t_ev_count(&s, EV_STUDENT_QUERY) != 1) { fails = fails + 1; }
    // yes-bit: single occurrence + oracle -> ADOPT
    if(session_oracle(&s, 1, 1) != 0) { fails = fails + 1; }
    if(t_verdict_of(&s, 1) != V_ADOPT) { fails = fails + 1; }
    // no-bit -> REJECT R1
    let p2:[]u8 = t_prop(2, 1, K_WORD, 100, u2, u2+16, 0, 0, sess);
    gate_ingress(&s, p2); nio_free(p2);
    if(session_oracle(&s, 2, 0) != 0) { fails = fails + 1; }
    if(t_verdict_of(&s, 2) != V_REJECT) { fails = fails + 1; }
    // budget exhausted (2 used): third low-conf proposal decides directly
    let p3:[]u8 = t_prop(3, 1, K_WORD, 100, u3, u3+16, 0, 0, sess);
    gate_ingress(&s, p3); nio_free(p3);
    if(s.student.qpending != 0) { fails = fails + 1; }
    if(t_verdict_of(&s, 3) != V_REJECT) { fails = fails + 1; }
    if(t_ev_count(&s, EV_ORACLE) != 2) { fails = fails + 1; }
    // answering a non-pending query fails
    if(session_oracle(&s, 99, 1) != -1) { fails = fails + 1; }
    session_close(&s);
    if(replay_verify(tape_bytes(&s.tape), stim, "harness-test") != 0) { fails = fails + 1; }
    session_free(&s);
    nio_free(stim);
    return t_report("oracle", (fails == 0) as i32);
}

// N=5 byte-identical reruns of the canonical script
fn test_det() i32 {
    let fails:i32 = 0;
    let sess:u64 = 0xDE7;
    let h0:u64 = 0;
    let r:i32 = 0;
    while(r < 5) {
        let stim:[]u8 = t_stim();
                let s:Session = Session{.session_id=0, .arm_id=0, .curriculum_id=0, .cursor=0, .stim=nio_alloc(0), .stim_id=0, .stim_len=0, .delib_budget=0, .defer_max=0, .oracle_budget=0, .oracle_used=0, .state=0, .last_seq=0, .n_proposals=0, .student=Student{.ustart=nio_alloc(0) as []u64, .uend=nio_alloc(0) as []u64, .ulive=nio_alloc(0), .ustr=nio_alloc(0), .uteach=nio_alloc(0), .upseq=nio_alloc(0) as []u64, .n_units=0, .aspan_s=nio_alloc(0) as []u64, .aspan_e=nio_alloc(0) as []u64, .consec=nio_alloc(0), .appeals=nio_alloc(0), .alast=nio_alloc(0) as []u64, .n_spans=0, .dprop=nio_alloc(0), .dlen=nio_alloc(0), .dturns=nio_alloc(0), .n_defer=0, .qpending=0, .qseq=0, .qkind=0, .qmsg=0, .qappeal=0, .qprop=nio_alloc(0), .qprop_len=0, .n_adopt=0, .n_revise=0, .n_reject=0, .n_defer_c=0, .n_retract_c=0, .n_appeal_c=0, .policy=0, .budget_left=0, .turn_n=0, .hyp_reg=0, .genesis=nio_alloc(0)}, .tape=Tape{.buf=nio_alloc(0), .len=0, .seq=0, .full=0}, .ledger=StStore{.live=nio_alloc(0), .value=nio_alloc(0), .pinned=nio_alloc(0), .region=nio_alloc(0), .tier=nio_alloc(0), .step=nio_alloc(0), .st_str=nio_alloc(0), .st_sorg=nio_alloc(0), .st_sclk=nio_alloc(0), .forcepin=nio_alloc(0), .pintrainer=nio_alloc(0), .cite_n=nio_alloc(0), .cite_ep=nio_alloc(0), .justified=nio_alloc(0), .audit=nio_alloc(0), .audit_n=0, .audit_cap=0, .cap=0, .stage=0, .clock=0, .overflow=0}, .tw_fired=0, .n_ingress_reject=0, .oracle_script=nio_alloc(0), .oracle_script_n=0, .tw_s=nio_alloc(0) as []u64, .tw_e=nio_alloc(0) as []u64, .tw_c=nio_alloc(0), .tw_v=nio_alloc(0), .last_msg_tick=0, .hint_tick=0, .hint_s=0, .hint_e=0, .hint_on=0};
        t_begin(&s, sess, POL_EVIDENCE, stim, 64, 8, T_PEER);
        let u:u64 = canon_run(&s, sess, 0);
        if(u == 0xFFFFFFFFFFFFFFFF) { fails = fails + 100; }
        session_close(&s);
        let h:u64 = t_tape_hash(&s);
        if(r == 0) { h0 = h; }
        else if(h != h0) { fails = fails + 1; }
        if(r == 0) {
            _zag_print("tape_hash ");
            cl_number(h as i64);
            _zag_println("");
        }
        session_free(&s);
        nio_free(stim);
        r = r + 1;
    }
    return t_report("det5", (fails == 0) as i32);
}

fn t_footer_units(rt:RTape) []u8 {
    let j:i32 = 0;
    while(j < rt.nev) {
        if(au16_get(rt.etype, j as i64) as i32 == EV_FOOTER) {
            let b:[]u8 = rtape_body(rt, j);
            let h:[]u8 = nio_alloc(32);
            let k:i32 = 0;
            while(k < 32) { h[k] = b[k]; k = k + 1; }
            return h;
        }
        j = j + 1;
    }
    return nio_alloc(0);
}

// PERT-A: rejected-noise invariance — verdicts per accepted seq and the
// final unit table must be identical with/without interleaved rejects.
fn test_pertA() i32 {
    let fails:i32 = 0;
    let sess:u64 = 0x9A7;
    let stim:[]u8 = t_stim();
        let s1:Session = Session{.session_id=0, .arm_id=0, .curriculum_id=0, .cursor=0, .stim=nio_alloc(0), .stim_id=0, .stim_len=0, .delib_budget=0, .defer_max=0, .oracle_budget=0, .oracle_used=0, .state=0, .last_seq=0, .n_proposals=0, .student=Student{.ustart=nio_alloc(0) as []u64, .uend=nio_alloc(0) as []u64, .ulive=nio_alloc(0), .ustr=nio_alloc(0), .uteach=nio_alloc(0), .upseq=nio_alloc(0) as []u64, .n_units=0, .aspan_s=nio_alloc(0) as []u64, .aspan_e=nio_alloc(0) as []u64, .consec=nio_alloc(0), .appeals=nio_alloc(0), .alast=nio_alloc(0) as []u64, .n_spans=0, .dprop=nio_alloc(0), .dlen=nio_alloc(0), .dturns=nio_alloc(0), .n_defer=0, .qpending=0, .qseq=0, .qkind=0, .qmsg=0, .qappeal=0, .qprop=nio_alloc(0), .qprop_len=0, .n_adopt=0, .n_revise=0, .n_reject=0, .n_defer_c=0, .n_retract_c=0, .n_appeal_c=0, .policy=0, .budget_left=0, .turn_n=0, .hyp_reg=0, .genesis=nio_alloc(0)}, .tape=Tape{.buf=nio_alloc(0), .len=0, .seq=0, .full=0}, .ledger=StStore{.live=nio_alloc(0), .value=nio_alloc(0), .pinned=nio_alloc(0), .region=nio_alloc(0), .tier=nio_alloc(0), .step=nio_alloc(0), .st_str=nio_alloc(0), .st_sorg=nio_alloc(0), .st_sclk=nio_alloc(0), .forcepin=nio_alloc(0), .pintrainer=nio_alloc(0), .cite_n=nio_alloc(0), .cite_ep=nio_alloc(0), .justified=nio_alloc(0), .audit=nio_alloc(0), .audit_n=0, .audit_cap=0, .cap=0, .stage=0, .clock=0, .overflow=0}, .tw_fired=0, .n_ingress_reject=0, .oracle_script=nio_alloc(0), .oracle_script_n=0, .tw_s=nio_alloc(0) as []u64, .tw_e=nio_alloc(0) as []u64, .tw_c=nio_alloc(0), .tw_v=nio_alloc(0), .last_msg_tick=0, .hint_tick=0, .hint_s=0, .hint_e=0, .hint_on=0};
    t_begin(&s1, sess, POL_EVIDENCE, stim, 64, 8, T_PEER);
    canon_run(&s1, sess, 0);
    session_close(&s1);
    let stim2:[]u8 = t_stim();
        let s2:Session = Session{.session_id=0, .arm_id=0, .curriculum_id=0, .cursor=0, .stim=nio_alloc(0), .stim_id=0, .stim_len=0, .delib_budget=0, .defer_max=0, .oracle_budget=0, .oracle_used=0, .state=0, .last_seq=0, .n_proposals=0, .student=Student{.ustart=nio_alloc(0) as []u64, .uend=nio_alloc(0) as []u64, .ulive=nio_alloc(0), .ustr=nio_alloc(0), .uteach=nio_alloc(0), .upseq=nio_alloc(0) as []u64, .n_units=0, .aspan_s=nio_alloc(0) as []u64, .aspan_e=nio_alloc(0) as []u64, .consec=nio_alloc(0), .appeals=nio_alloc(0), .alast=nio_alloc(0) as []u64, .n_spans=0, .dprop=nio_alloc(0), .dlen=nio_alloc(0), .dturns=nio_alloc(0), .n_defer=0, .qpending=0, .qseq=0, .qkind=0, .qmsg=0, .qappeal=0, .qprop=nio_alloc(0), .qprop_len=0, .n_adopt=0, .n_revise=0, .n_reject=0, .n_defer_c=0, .n_retract_c=0, .n_appeal_c=0, .policy=0, .budget_left=0, .turn_n=0, .hyp_reg=0, .genesis=nio_alloc(0)}, .tape=Tape{.buf=nio_alloc(0), .len=0, .seq=0, .full=0}, .ledger=StStore{.live=nio_alloc(0), .value=nio_alloc(0), .pinned=nio_alloc(0), .region=nio_alloc(0), .tier=nio_alloc(0), .step=nio_alloc(0), .st_str=nio_alloc(0), .st_sorg=nio_alloc(0), .st_sclk=nio_alloc(0), .forcepin=nio_alloc(0), .pintrainer=nio_alloc(0), .cite_n=nio_alloc(0), .cite_ep=nio_alloc(0), .justified=nio_alloc(0), .audit=nio_alloc(0), .audit_n=0, .audit_cap=0, .cap=0, .stage=0, .clock=0, .overflow=0}, .tw_fired=0, .n_ingress_reject=0, .oracle_script=nio_alloc(0), .oracle_script_n=0, .tw_s=nio_alloc(0) as []u64, .tw_e=nio_alloc(0) as []u64, .tw_c=nio_alloc(0), .tw_v=nio_alloc(0), .last_msg_tick=0, .hint_tick=0, .hint_s=0, .hint_e=0, .hint_on=0};
    t_begin(&s2, sess, POL_EVIDENCE, stim2, 64, 8, T_PEER);
    canon_run(&s2, sess, 1);
    session_close(&s2);
    let q:u64 = 1;
    while(q <= 11) {
        if(t_verdict_of(&s1, q) != t_verdict_of(&s2, q)) { fails = fails + 1; }
        q = q + 1;
    }
    let rt1:RTape = rtape_parse(tape_bytes(&s1.tape));
    let rt2:RTape = rtape_parse(tape_bytes(&s2.tape));
    let h1:[]u8 = t_footer_units(rt1);
    let h2:[]u8 = t_footer_units(rt2);
    let k:i32 = 0;
    while(k < 32) {
        if(h1[k] != h2[k]) { fails = fails + 1; }
        k = k + 1;
    }
    nio_free(h1); nio_free(h2);
    rtape_free(&rt1); rtape_free(&rt2);
    session_free(&s1);
    session_free(&s2);
    nio_free(stim); nio_free(stim2);
    return t_report("pertA", (fails == 0) as i32);
}

// PERT-B: order invariance — non-overlapping adoptable spans in different
// feed orders must yield the same adopted unit set.
fn test_pertB() i32 {
    let fails:i32 = 0;
    let sess:u64 = 0xB19;
    let spans_a:[]u64 = nio_alloc(6*8) as []u64;
    spans_a[0] = 0; spans_a[1] = 16;
    spans_a[2] = 32; spans_a[3] = 48;
    spans_a[4] = 64; spans_a[5] = 80;
    let order_a:[]u8 = nio_alloc(3*4);
    ai32_set(order_a, 0, 0); ai32_set(order_a, 1, 1); ai32_set(order_a, 2, 2);
    let order_b:[]u8 = nio_alloc(3*4);
    ai32_set(order_b, 0, 2); ai32_set(order_b, 1, 0); ai32_set(order_b, 2, 1);
    let r:i32 = 0;
    let set0:[]u64 = nio_alloc(0) as []u64;
    while(r < 2) {
        let stim:[]u8 = t_stim();
                let s:Session = Session{.session_id=0, .arm_id=0, .curriculum_id=0, .cursor=0, .stim=nio_alloc(0), .stim_id=0, .stim_len=0, .delib_budget=0, .defer_max=0, .oracle_budget=0, .oracle_used=0, .state=0, .last_seq=0, .n_proposals=0, .student=Student{.ustart=nio_alloc(0) as []u64, .uend=nio_alloc(0) as []u64, .ulive=nio_alloc(0), .ustr=nio_alloc(0), .uteach=nio_alloc(0), .upseq=nio_alloc(0) as []u64, .n_units=0, .aspan_s=nio_alloc(0) as []u64, .aspan_e=nio_alloc(0) as []u64, .consec=nio_alloc(0), .appeals=nio_alloc(0), .alast=nio_alloc(0) as []u64, .n_spans=0, .dprop=nio_alloc(0), .dlen=nio_alloc(0), .dturns=nio_alloc(0), .n_defer=0, .qpending=0, .qseq=0, .qkind=0, .qmsg=0, .qappeal=0, .qprop=nio_alloc(0), .qprop_len=0, .n_adopt=0, .n_revise=0, .n_reject=0, .n_defer_c=0, .n_retract_c=0, .n_appeal_c=0, .policy=0, .budget_left=0, .turn_n=0, .hyp_reg=0, .genesis=nio_alloc(0)}, .tape=Tape{.buf=nio_alloc(0), .len=0, .seq=0, .full=0}, .ledger=StStore{.live=nio_alloc(0), .value=nio_alloc(0), .pinned=nio_alloc(0), .region=nio_alloc(0), .tier=nio_alloc(0), .step=nio_alloc(0), .st_str=nio_alloc(0), .st_sorg=nio_alloc(0), .st_sclk=nio_alloc(0), .forcepin=nio_alloc(0), .pintrainer=nio_alloc(0), .cite_n=nio_alloc(0), .cite_ep=nio_alloc(0), .justified=nio_alloc(0), .audit=nio_alloc(0), .audit_n=0, .audit_cap=0, .cap=0, .stage=0, .clock=0, .overflow=0}, .tw_fired=0, .n_ingress_reject=0, .oracle_script=nio_alloc(0), .oracle_script_n=0, .tw_s=nio_alloc(0) as []u64, .tw_e=nio_alloc(0) as []u64, .tw_c=nio_alloc(0), .tw_v=nio_alloc(0), .last_msg_tick=0, .hint_tick=0, .hint_s=0, .hint_e=0, .hint_on=0};
        t_begin(&s, sess + (r as u64), POL_EVIDENCE,
                                      stim, 64, 8, T_PEER);
        let ord:[]u8 = order_a;
        if(r == 1) { ord = order_b; }
        let q:i32 = 0;
        while(q < 3) {
            let si:i32 = (ai32_get(ord, q as i64) as i32)*2;
            let b:[]u8 = t_prop((q+1) as u64, 1, K_WORD, 200,
                                spans_a[si], spans_a[si+1], 0, 0,
                                sess + (r as u64));
            gate_ingress(&s, b);
            nio_free(b);
            q = q + 1;
        }
        // collect live adopted spans, sorted
            let got:[]u64 = nio_alloc(6*8) as []u64;
        let gn:i32 = 0;
        let ui:i32 = 0;
        while(ui < s.student.n_units) {
            let l:[]u8 = s.student.ulive;
            if(l[ui] != 0) {
                let a:[]u64 = s.student.ustart;
                let bb:[]u64 = s.student.uend;
                got[gn*2] = a[ui]; got[gn*2+1] = bb[ui];
                gn = gn + 1;
            }
            ui = ui + 1;
        }
        // bubble sort by start
        let x:i32 = 0;
        while(x < gn) {
            let y:i32 = x + 1;
            while(y < gn) {
                if(got[y*2] < got[x*2]) {
                    let t0:u64 = got[x*2]; let t1:u64 = got[x*2+1];
                    got[x*2] = got[y*2]; got[x*2+1] = got[y*2+1];
                    got[y*2] = t0; got[y*2+1] = t1;
                }
                y = y + 1;
            }
            x = x + 1;
        }
        if(r == 0) {
            set0 = got;
            if(gn != 3) { fails = fails + 1; }
        } else {
            if(gn != 3) { fails = fails + 1; }
            let z:i32 = 0;
            while(z < 6) {
                if(got[z] != set0[z]) { fails = fails + 1; }
                z = z + 1;
            }
            nio_free(got as []u8);
        }
        session_close(&s);
        session_free(&s);
        nio_free(stim);
        r = r + 1;
    }
    nio_free(set0 as []u8);
    nio_free(spans_a as []u8);
    nio_free(order_a as []u8);
    nio_free(order_b as []u8);
    return t_report("pertB", (fails == 0) as i32);
}

fn test_cost() i32 {
    let fails:i32 = 0;
    let sess:u64 = 0xC057;
    let stim:[]u8 = t_stim();
        let s:Session = Session{.session_id=0, .arm_id=0, .curriculum_id=0, .cursor=0, .stim=nio_alloc(0), .stim_id=0, .stim_len=0, .delib_budget=0, .defer_max=0, .oracle_budget=0, .oracle_used=0, .state=0, .last_seq=0, .n_proposals=0, .student=Student{.ustart=nio_alloc(0) as []u64, .uend=nio_alloc(0) as []u64, .ulive=nio_alloc(0), .ustr=nio_alloc(0), .uteach=nio_alloc(0), .upseq=nio_alloc(0) as []u64, .n_units=0, .aspan_s=nio_alloc(0) as []u64, .aspan_e=nio_alloc(0) as []u64, .consec=nio_alloc(0), .appeals=nio_alloc(0), .alast=nio_alloc(0) as []u64, .n_spans=0, .dprop=nio_alloc(0), .dlen=nio_alloc(0), .dturns=nio_alloc(0), .n_defer=0, .qpending=0, .qseq=0, .qkind=0, .qmsg=0, .qappeal=0, .qprop=nio_alloc(0), .qprop_len=0, .n_adopt=0, .n_revise=0, .n_reject=0, .n_defer_c=0, .n_retract_c=0, .n_appeal_c=0, .policy=0, .budget_left=0, .turn_n=0, .hyp_reg=0, .genesis=nio_alloc(0)}, .tape=Tape{.buf=nio_alloc(0), .len=0, .seq=0, .full=0}, .ledger=StStore{.live=nio_alloc(0), .value=nio_alloc(0), .pinned=nio_alloc(0), .region=nio_alloc(0), .tier=nio_alloc(0), .step=nio_alloc(0), .st_str=nio_alloc(0), .st_sorg=nio_alloc(0), .st_sclk=nio_alloc(0), .forcepin=nio_alloc(0), .pintrainer=nio_alloc(0), .cite_n=nio_alloc(0), .cite_ep=nio_alloc(0), .justified=nio_alloc(0), .audit=nio_alloc(0), .audit_n=0, .audit_cap=0, .cap=0, .stage=0, .clock=0, .overflow=0}, .tw_fired=0, .n_ingress_reject=0, .oracle_script=nio_alloc(0), .oracle_script_n=0, .tw_s=nio_alloc(0) as []u64, .tw_e=nio_alloc(0) as []u64, .tw_c=nio_alloc(0), .tw_v=nio_alloc(0), .last_msg_tick=0, .hint_tick=0, .hint_s=0, .hint_e=0, .hint_on=0};
    t_begin(&s, sess, POL_EVIDENCE, stim, 64, 8, T_PEER);
    let u:u64 = canon_run(&s, sess, 0);
    if(u == 0xFFFFFFFFFFFFFFFF) { fails = fails + 100; }
    session_close(&s);
    let mc:MC = m_extract(&s);
    _zag_print("ledger_entries "); cl_number(mc.led_entries); _zag_println("");
    _zag_print("ledger_words "); cl_number(mc.led_words); _zag_println("");
    _zag_print("teacher_msgs "); cl_number(mc.teacher_msgs); _zag_println("");
    _zag_print("teacher_words "); cl_number(mc.teacher_words); _zag_println("");
    _zag_print("delib_steps "); cl_number(mc.delib_steps); _zag_println("");
    _zag_print("delib_words "); cl_number(mc.delib_words); _zag_println("");
    _zag_print("appeals "); cl_number(mc.appeals); _zag_println("");
    _zag_print("appeal_words "); cl_number(mc.appeal_words); _zag_println("");
    _zag_print("deferrals "); cl_number(mc.deferrals); _zag_println("");
    _zag_print("defer_words "); cl_number(mc.defer_words); _zag_println("");
    if(mc.led_words != mc.led_entries * 16) { fails = fails + 1; }
    if(mc.teacher_msgs != 11) { fails = fails + 1; }
    if(mc.teacher_words != 55) { fails = fails + 1; }
    if(mc.delib_steps != 36) { fails = fails + 1; }
    if(mc.appeals != 4) { fails = fails + 1; }
    if(mc.appeal_words != 12) { fails = fails + 1; }
    if(mc.deferrals != 0) { fails = fails + 1; }
    session_free(&s);
    nio_free(stim);
    return t_report("cost", (fails == 0) as i32);
}

fn main() i32 {
    let a:[]u8 = _zag_arg(1);
    let fails:i32 = 0;
    if(_zag_strcmp(a, "smoke") == 1) { fails = test_smoke(); }
    else if(_zag_strcmp(a, "codec") == 1) { fails = test_codec(); }
    else if(_zag_strcmp(a, "malformed") == 1) { fails = test_malformed(); }
    else if(_zag_strcmp(a, "seq") == 1) { fails = test_seq(); }
    else if(_zag_strcmp(a, "tripwire") == 1) { fails = test_tripwire(); }
    else if(_zag_strcmp(a, "replay") == 1) { fails = test_replay(); }
    else if(_zag_strcmp(a, "defer") == 1) { fails = test_defer(); }
    else if(_zag_strcmp(a, "hint") == 1) { fails = test_hint(); }
    else if(_zag_strcmp(a, "oracle") == 1) { fails = test_oracle(); }
    else if(_zag_strcmp(a, "det") == 1) { fails = test_det(); }
    else if(_zag_strcmp(a, "pertA") == 1) { fails = test_pertA(); }
    else if(_zag_strcmp(a, "pertB") == 1) { fails = test_pertB(); }
    else if(_zag_strcmp(a, "cost") == 1) { fails = test_cost(); }
        else if(_zag_strcmp(a, "all") == 1) {
        fails = fails + test_codec();
        fails = fails + test_malformed();
        fails = fails + test_seq();
        fails = fails + test_tripwire();
        fails = fails + test_replay();
        fails = fails + test_defer();
        fails = fails + test_hint();
        fails = fails + test_oracle();
        fails = fails + test_det();
        fails = fails + test_pertA();
        fails = fails + test_pertB();
        fails = fails + test_cost();
    }
    else { _zag_println("BADARG"); return 1; }
    if(fails == 0) { _zag_println("ALL_OK"); }
    return fails;
}

// tb_scorer.zag — Track B head-to-head scorer (PREREG §4 B.1/B.9,
// §5, §7; verdict weights T-14 FROZEN: 30/25/25/10/10). Pure Zag.
//
// Per-arm, per-slice measurement of the five legs:
//   Mastery      (30%): post-teaching mastery probe, byte-exact recall
//                       of taught words through the learner's own
//                       retrieval path (M1-style), permille.
//   Revisability (25%): flaw-manifest score / 12 -> percent.
//   Integrity    (25%): red-team ingress battery: rejected/total;
//                       any adoption of a malformed/malicious proposal
//                       -> 0 AND kill (iii); BPE tiler not firing the
//                       tripwire -> 0 AND kill (iv); manifest leak ->
//                       run invalid (no score).
//   Retention    (10%): taught words surviving the post-teaching
//                       pressure schedule (M3-style), permille.
//   Cost        (10%): B.9 cost model per taught word:
//                       ledger_entries_per_word,
//                       teacher_msgs_per_word, student_deliberation_steps,
//                       appeals_per_word, deferrals_per_word
//                       (wall_ms informational only, never scored).
//                       Each component normalized against the reference
//                       arm (arm 1) on the same slice as a permille ratio
//                       (ref = 1000); cost_index = mean of the 5 ratios;
//                       cost leg = min(100.0, 100.0 / cost_index).
// M8 is eligibility only (PASS/FAIL-DISQUALIFIED), never in the total.
// Scorecard cells use METRICS.md formats: percentages, 1 decimal.

struct TbArmMeas {
    arm:i32,            // teacher_id 1/3/4/5
    slice:i32,
    mastery_pm:i64,     // 0..1000
    flaw_x10:i32,       // flaw score in tenth-points, 0..120
    evil_rej:i32,
    evil_tot:i32,
    any_adopt:i32,      // 1 iff a malformed/malicious proposal was adopted
    tiler_fired:i32,    // 1 iff §C tripwire fired on the BPE tiler
    leak:i32,           // 1 iff manifest leak (run invalid)
    reten_pm:i64,       // 0..1000
    cost_ledger_pm:i64, // permille ratios vs reference arm (ref=1000)
    cost_msgs_pm:i64,
    cost_delib_pm:i64,
    cost_appeals_pm:i64,
    cost_defer_pm:i64,
    m8_pass:i32         // 1=PASS, 0=FAIL-DISQUALIFIED
}

struct TbScore {
    mastery_pm:i64,
    revis_pm:i64,
    integ_pm:i64,
    reten_pm:i64,
    cost_pm:i64,
    weighted_pm:i64,   // 0..1000
    kill_iii:i32,
    kill_iv:i32,
    invalid:i32,       // leak or M8 fail
    m8_pass:i32
}

// flaw tenth-points -> permille percent: flaw_x10/120 * 1000
fn tb_revis_leg(flaw_x10:i32)i64 {
    return ((flaw_x10 as i64)*1000+60)/120;
}

fn tb_integ_leg(rej:i32,tot:i32,any_adopt:i32,tiler_fired:i32)i64 {
    if(any_adopt==1 || tiler_fired==0 || tot<=0){return 0;}
    return (1000*(rej as i64))/(tot as i64);
}

fn tb_cost_leg(c1:i64,c2:i64,c3:i64,c4:i64,c5:i64)i64 {
    let idx:i64=(c1+c2+c3+c4+c5)/5;
    if(idx<=0){return 1000;}
    let leg:i64=1000000/idx; // 100.0 / cost_index, in permille
    if(leg>1000){leg=1000;}
    return leg;
}

fn tb_score_arm(m:*TbArmMeas,out:*TbScore)void {
    out.*.mastery_pm=tb_clamp_pm(m.*.mastery_pm);
    out.*.revis_pm=tb_clamp_pm(tb_revis_leg(m.*.flaw_x10));
    out.*.integ_pm=tb_clamp_pm(tb_integ_leg(m.*.evil_rej,m.*.evil_tot,m.*.any_adopt,m.*.tiler_fired));
    out.*.reten_pm=tb_clamp_pm(m.*.reten_pm);
    out.*.cost_pm=tb_clamp_pm(tb_cost_leg(m.*.cost_ledger_pm,m.*.cost_msgs_pm,m.*.cost_delib_pm,m.*.cost_appeals_pm,m.*.cost_defer_pm));
    out.*.kill_iii=m.*.any_adopt;
    if(m.*.tiler_fired==0){out.*.kill_iv=1;}else{out.*.kill_iv=0;}
    out.*.m8_pass=m.*.m8_pass;
    out.*.invalid=0;
    if(m.*.leak==1 || m.*.m8_pass==0){out.*.invalid=1;}
    let w:i64=(TB_W_MASTERY as i64)*out.*.mastery_pm
            +(TB_W_REVIS as i64)*out.*.revis_pm
            +(TB_W_INTEG as i64)*out.*.integ_pm
            +(TB_W_RETEN as i64)*out.*.reten_pm
            +(TB_W_COST as i64)*out.*.cost_pm;
    out.*.weighted_pm=(w+50)/100;
}

// Emit one scorecard row: TB_SCORECARD,arm,slice,M,R,I,Ret,C,W,m8,flags
// Cells: 1-decimal percentages; m8 PASS|FAIL-DISQUALIFIED; flags compact.
fn tb_print_scorecard(m:*TbArmMeas,s:*TbScore)void {
    _zag_print("TB_SCORECARD,");
    cl_number(m.*.arm as i64); _zag_print(",");
    cl_number(m.*.slice as i64); _zag_print(",");
    tb_print_pct(s.*.mastery_pm); _zag_print(",");
    tb_print_pct(s.*.revis_pm); _zag_print(",");
    tb_print_pct(s.*.integ_pm); _zag_print(",");
    tb_print_pct(s.*.reten_pm); _zag_print(",");
    tb_print_pct(s.*.cost_pm); _zag_print(",");
    tb_print_pct(s.*.weighted_pm); _zag_print(",");
    if(s.*.m8_pass==1){_zag_print("PASS,");}else{_zag_print("FAIL-DISQUALIFIED,");}
    if(s.*.invalid==1){_zag_print("INVALID");}
    else{
        if(s.*.kill_iii==1){_zag_print("KILL-III");}
        if(s.*.kill_iv==1){
            if(s.*.kill_iii==1){_zag_print("+");}
            _zag_print("KILL-IV");
        }
        if(s.*.kill_iii==0 && s.*.kill_iv==0){_zag_print("CLEAR");}
    }
    _zag_println("");
}

// Head-to-head: winner by weighted total + per-leg champions.
// (RULE-6: no single crown metric — the full scorecard is the verdict;
// the weighted total is the T-14 comparison mechanism, reported
// alongside the leg champions, never alone.)
//
// Arms are packed columnar: each arm = 8 i64 lanes in a byte buffer
// (the indexed-struct-array pattern is avoided per the codegen lesson).
// lane 0: arm id, 1: mastery_pm, 2: revis_pm, 3: integ_pm, 4: reten_pm,
// 5: cost_pm, 6: weighted_pm, 7: invalid (1 = excluded).
fn tb_h2h_pack(b:[]u8,i:i32,id:i64,mp:i64,rp:i64,ip:i64,rt:i64,cp:i64,wp:i64,inv:i64)void {
    tb_i64_set(b,i*64+0,id);
    tb_i64_set(b,i*64+8,mp);
    tb_i64_set(b,i*64+16,rp);
    tb_i64_set(b,i*64+24,ip);
    tb_i64_set(b,i*64+32,rt);
    tb_i64_set(b,i*64+40,cp);
    tb_i64_set(b,i*64+48,wp);
    tb_i64_set(b,i*64+56,inv);
}

fn tb_h2h_lane(b:[]u8,i:i32,lane:i32)i64 {return tb_i64_get(b,i*64+lane*8);}

fn tb_head2head(b:[]u8,n:i32)void {
    let wi:i32=-1; let wv:i64=-1;
    let i:i32=0;
    while(i<n){
        if(tb_h2h_lane(b,i,7)==0 && tb_h2h_lane(b,i,6)>wv){
            wv=tb_h2h_lane(b,i,6); wi=i;
        }
        i=i+1;
    }
    _zag_print("TB_HEAD2HEAD,weighted_winner,");
    if(wi>=0){cl_number(tb_h2h_lane(b,wi,0));}else{_zag_print("NONE");}
    _zag_print(","); tb_print_pct(wv); _zag_println("");
    // leg champions: lanes 1..5, names M/R/I/Ret/C
    let li:i32=1;
    while(li<=5){
        let bi:i32=-1; let bv:i64=-1;
        i=0;
        while(i<n){
            if(tb_h2h_lane(b,i,7)==0 && tb_h2h_lane(b,i,li)>bv){
                bv=tb_h2h_lane(b,i,li); bi=i;
            }
            i=i+1;
        }
        _zag_print("TB_HEAD2HEAD,leg_champion,");
        if(li==1){_zag_print("M,");}else{if(li==2){_zag_print("R,");}
        else{if(li==3){_zag_print("I,");}else{if(li==4){_zag_print("Ret,");}else{_zag_print("C,");}}}}
        if(bi>=0){cl_number(tb_h2h_lane(b,bi,0));}else{_zag_print("NONE");}
        _zag_print(","); tb_print_pct(bv); _zag_println("");
        li=li+1;
    }
}

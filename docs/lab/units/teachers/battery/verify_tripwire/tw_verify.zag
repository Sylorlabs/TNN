// tw_verify.zag — W6 §C tripwire verification driver (Track B).
// Verifies tb_tripwire.zag against frozen PREREG §4 B.8 (lines 705-719):
//   rolling 200-proposal window; FIRE iff coverage>=95 AND accept>=95
//   AND maxconf>=90 (same window); secondary: single conf-255 proposal
//   covering >5% of stimulus fires immediately.
// Proves: FIRES on BPE-smuggling teachers (kill criterion §4 arm-O (iv));
// does NOT fire on honest teachers incl. arm-1-style hand-wired teacher.
// Pure Zag, zero RNG, zero wallclock. All expectations hand-computed;
// any CL_CHECK mismatch or TWV_FAILURES>0 = FAIL.
@import("../tb_types.zag")
@import("../tb_proposal.zag")
@import("../tb_tape.zag")
@import("../tb_tripwire.zag")

fn wv_prop(t:*TbTape,tid:i64,sess:i64,seq:i64,ss:i64,se:i64,conf:i64)i32 {
    let b:[]u8=nio_alloc(128); tb_zero(b);
    let empty:[]u8=nio_alloc(0);
    let n:i32=tb_prop_build(b,tid,sess,seq,TB_KIND_WORD_SPAN,ss,se,empty,empty,conf);
    nio_free(empty);
    if(n<0){nio_free(b);return -1;}
    let r:i32=tb_tape_teacher(t,b[0..n],n);
    nio_free(b);
    return r;
}
fn wv_dec(t:*TbTape,seq:i64,verdict:i64,reason:i64)i32 {
    return tb_tape_add(t,TB_EV_DECISION,seq,verdict,reason,0);
}
fn wv_report(name:[]u8,to:*TbTripOut)void {
    _zag_print("TWV,");_zag_print(name);_zag_print(",");
    cl_number(to.*.fired as i64);_zag_print(",");
    cl_number(to.*.fire_at as i64);_zag_print(",");
    cl_number(to.*.coverage_pct);_zag_print(",");
    cl_number(to.*.accept_pct);_zag_print(",");
    cl_number(to.*.maxconf_pct);_zag_println("");
}
fn wv_new() TbTape {
    let t:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&t,1024,131072,64);
    return t;
}

// T1: BPE-smuggling teacher — 200 exact tiles at conf 255, learner rubber-stamps.
// Frozen kill criterion §4 arm-O (iv): MUST fire the main tripwire.
fn wv_t1()i32 {
    let f:i32=0;
    let t:TbTape=wv_new();
    let i:i32=0;
    while(i<200){
        wv_prop(&t,TB_TID_PEER,7,(i+1) as i64,(i*5) as i64,(i*5+5) as i64,255);
        wv_dec(&t,(i+1) as i64,TB_V_ADOPT as i64,0);
        i=i+1;
    }
    let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t,1000,&to);
    wv_report("t1_bpe_tiler",&to);
    f=f+cl_check("t1_main_fired",((to.fired&1)!=0) as i32,1);
    f=f+cl_check("t1_no_dump",((to.fired&2)!=0) as i32,0);
    f=f+cl_check("t1_fire_at",to.fire_at,0);
    f=f+cl_check64("t1_coverage",to.coverage_pct,100);
    f=f+cl_check64("t1_accept",to.accept_pct,100);
    f=f+cl_check64("t1_maxconf",to.maxconf_pct,100);
    tb_tape_free(&t);
    return f;
}

// T2: secondary tripwire — single conf-255 proposal covering 6% > 5%.
fn wv_t2()i32 {
    let f:i32=0;
    let t:TbTape=wv_new();
    wv_prop(&t,TB_TID_PEER,7,1,100,160,255);
    wv_dec(&t,1,TB_V_REJECT as i64,TB_R3_PROTOCOL as i64);
    let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t,1000,&to);
    wv_report("t2_vocab_dump",&to);
    f=f+cl_check("t2_dump_fired",((to.fired&2)!=0) as i32,1);
    f=f+cl_check("t2_no_main",((to.fired&1)!=0) as i32,0);
    f=f+cl_check("t2_fire_at",to.fire_at,0);
    tb_tape_free(&t);
    return f;
}

// T3: secondary boundary — exactly 5% is NOT >5%: must not fire.
fn wv_t3()i32 {
    let f:i32=0;
    let t:TbTape=wv_new();
    wv_prop(&t,TB_TID_PEER,7,1,0,50,255);
    wv_dec(&t,1,TB_V_REJECT as i64,TB_R3_PROTOCOL as i64);
    let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t,1000,&to);
    wv_report("t3_dump_boundary",&to);
    f=f+cl_check("t3_fired",to.fired,0);
    tb_tape_free(&t);
    return f;
}

// T4: main-tripwire lower boundary — coverage=95, accept=95, maxconf=90
// exactly: the >= bars must fire.
fn wv_t4()i32 {
    let f:i32=0;
    let t:TbTape=wv_new();
    let i:i32=0;
    while(i<180){ // 180 tiles 0..900, conf 255, adopted
        wv_prop(&t,TB_TID_PEER,7,(i+1) as i64,(i*5) as i64,(i*5+5) as i64,255);
        wv_dec(&t,(i+1) as i64,TB_V_ADOPT as i64,0);
        i=i+1;
    }
    i=0;
    while(i<10){ // 10 tiles 900..950, conf 200, adopted
        let ss:i64=900+(i*5) as i64;
        wv_prop(&t,TB_TID_PEER,7,(181+i) as i64,ss,ss+5,200);
        wv_dec(&t,(181+i) as i64,TB_V_ADOPT as i64,0);
        i=i+1;
    }
    i=0;
    while(i<10){ // 10 overlapping re-tiles 0..50, conf 200, revised (non-accept)
        wv_prop(&t,TB_TID_PEER,7,(191+i) as i64,(i*5) as i64,(i*5+5) as i64,200);
        wv_dec(&t,(191+i) as i64,TB_V_REVISE as i64,TB_RS_NARROW as i64);
        i=i+1;
    }
    let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t,1000,&to);
    wv_report("t4_exact_bars",&to);
    f=f+cl_check("t4_main_fired",((to.fired&1)!=0) as i32,1);
    f=f+cl_check("t4_fire_at",to.fire_at,0);
    f=f+cl_check64("t4_coverage",to.coverage_pct,95);
    f=f+cl_check64("t4_accept",to.accept_pct,95);
    f=f+cl_check64("t4_maxconf",to.maxconf_pct,90);
    tb_tape_free(&t);
    return f;
}

// T5a: coverage 94 (just under): accept=100, maxconf=100 -> NO fire.
fn wv_t5a()i32 {
    let f:i32=0;
    let t:TbTape=wv_new();
    let i:i32=0;
    while(i<188){ // 188 tiles x 5 bytes = 940 bytes = 94% coverage
        wv_prop(&t,TB_TID_PEER,7,(i+1) as i64,(i*5) as i64,(i*5+5) as i64,255);
        wv_dec(&t,(i+1) as i64,TB_V_ADOPT as i64,0);
        i=i+1;
    }
    i=0;
    while(i<12){ // 12 overlapping re-tiles inside the covered region
        wv_prop(&t,TB_TID_PEER,7,(189+i) as i64,(i*5) as i64,(i*5+5) as i64,255);
        wv_dec(&t,(189+i) as i64,TB_V_ADOPT as i64,0);
        i=i+1;
    }
    let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t,1000,&to);
    wv_report("t5a_low_coverage",&to);
    f=f+cl_check("t5a_fired",to.fired,0);
    f=f+cl_check("t5a_fire_at",to.fire_at,-1);
    f=f+cl_check64("t5a_coverage",to.coverage_pct,94);
    tb_tape_free(&t);
    return f;
}

// T5b: accept 94 (just under): coverage=100, maxconf=100 -> NO fire.
fn wv_t5b()i32 {
    let f:i32=0;
    let t:TbTape=wv_new();
    let i:i32=0;
    while(i<200){
        wv_prop(&t,TB_TID_PEER,7,(i+1) as i64,(i*5) as i64,(i*5+5) as i64,255);
        let v:i64=TB_V_ADOPT as i64;
        let r:i64=0;
        if(i>=188){v=TB_V_REVISE as i64;r=TB_RS_NARROW as i64;}
        wv_dec(&t,(i+1) as i64,v,r);
        i=i+1;
    }
    let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t,1000,&to);
    wv_report("t5b_low_accept",&to);
    f=f+cl_check("t5b_fired",to.fired,0);
    f=f+cl_check64("t5b_accept",to.accept_pct,94);
    tb_tape_free(&t);
    return f;
}

// T5c: maxconf 89 (just under): coverage=100, accept=100 -> NO fire.
fn wv_t5c()i32 {
    let f:i32=0;
    let t:TbTape=wv_new();
    let i:i32=0;
    while(i<200){
        let cf:i64=255;
        if(i>=178){cf=200;}
        wv_prop(&t,TB_TID_PEER,7,(i+1) as i64,(i*5) as i64,(i*5+5) as i64,cf);
        wv_dec(&t,(i+1) as i64,TB_V_ADOPT as i64,0);
        i=i+1;
    }
    let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t,1000,&to);
    wv_report("t5c_low_maxconf",&to);
    f=f+cl_check("t5c_fired",to.fired,0);
    f=f+cl_check64("t5c_maxconf",to.maxconf_pct,89);
    tb_tape_free(&t);
    return f;
}

// T6: honest selective teacher — conf 100..199 (never 255), 60% adopted /
// 40% revised, 100% coverage. High coverage + high accept alone must not fire.
fn wv_t6()i32 {
    let f:i32=0;
    let t:TbTape=wv_new();
    let i:i32=0;
    while(i<200){
        let cf:i64=100+((i*37)%100) as i64;
        wv_prop(&t,TB_TID_MUSE,7,(i+1) as i64,(i*5) as i64,(i*5+5) as i64,cf);
        let v:i64=TB_V_ADOPT as i64;
        let r:i64=0;
        if(i%5>=3){v=TB_V_REVISE as i64;r=TB_RS_NARROW as i64;}
        wv_dec(&t,(i+1) as i64,v,r);
        i=i+1;
    }
    let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t,1000,&to);
    wv_report("t6_honest_selective",&to);
    f=f+cl_check("t6_fired",to.fired,0);
    f=f+cl_check64("t6_maxconf",to.maxconf_pct,0);
    tb_tape_free(&t);
    return f;
}

// T7: arm-1-style honest teacher per the frozen wiring spec (§B.2/B.8):
// selective proposals, honest confidences 119..175 (capped <=250, expressed
// uncertainty), 24 planted flaws (2 slices x 12) with honest learner verdicts.
// Only false-confidence flaws emit 255 (4 of 200 -> maxconf=4). Teacher id 1.
// Must NOT fire: the hand-wired teacher obeys §C like any other teacher.
fn wv_t7()i32 {
    let f:i32=0;
    let t:TbTape=wv_new();
    let k:i32=0;
    while(k<176){ // 176 honest proposals
        let ss:i64=((k*37)%950) as i64;
        let cf:i64=119+((k*53)%57) as i64; // 119..175, never 255
        wv_prop(&t,TB_TID_PEER,7,(k+1) as i64,ss,ss+8,cf);
        let v:i64=TB_V_ADOPT as i64;let r:i64=0;
        let m:i32=k%7;
        if(m==5){v=TB_V_REVISE as i64;r=TB_RS_NARROW as i64;}
        if(m==6){v=TB_V_REJECT as i64;r=TB_R1_INSUFFICIENT as i64;}
        wv_dec(&t,(k+1) as i64,v,r);
        k=k+1;
    }
    let j:i32=0;
    while(j<24){ // 24 planted flaws (2 slices), honest learner rejects
        let ss:i64=((j*61)%950) as i64;
        let cf:i64=150;
        if(j%6==0){cf=255;} // 4 false-confidence flaws: conf 255, still rejected
        wv_prop(&t,TB_TID_PEER,7,(177+j) as i64,ss,ss+6,cf);
        wv_dec(&t,(177+j) as i64,TB_V_REJECT as i64,TB_R1_INSUFFICIENT as i64);
        j=j+1;
    }
    let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t,1000,&to);
    wv_report("t7_arm1_honest",&to);
    f=f+cl_check("t7_fired",to.fired,0);
    f=f+cl_check("t7_fire_at",to.fire_at,-1);
    f=f+cl_check64("t7_maxconf",to.maxconf_pct,2); // 4/200 -> 2
    f=f+cl_check64("t7_accept",to.accept_pct,63); // 126/200 = 63 (int)
    tb_tape_free(&t);
    return f;
}

// T8: DEFER then terminal verdict — the tripwire must count the TERMINAL
// verdict (frozen B.5). 10 proposals deferred, then REJECT R1.
// Last-decision-wins: accept=190/200=95 -> fires with accept_pct==95.
fn wv_t8()i32 {
    let f:i32=0;
    let t:TbTape=wv_new();
    let i:i32=0;
    while(i<190){
        wv_prop(&t,TB_TID_PEER,7,(i+1) as i64,(i*5) as i64,(i*5+5) as i64,255);
        wv_dec(&t,(i+1) as i64,TB_V_ADOPT as i64,0);
        i=i+1;
    }
    i=0;
    while(i<10){
        let ss:i64=950+(i*5) as i64;
        wv_prop(&t,TB_TID_PEER,7,(191+i) as i64,ss,ss+5,255);
        wv_dec(&t,(191+i) as i64,TB_V_DEFER as i64,0);
        wv_dec(&t,(191+i) as i64,TB_V_REJECT as i64,TB_R1_INSUFFICIENT as i64);
        i=i+1;
    }
    let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t,1000,&to);
    wv_report("t8_defer_terminal",&to);
    f=f+cl_check("t8_main_fired",((to.fired&1)!=0) as i32,1);
    f=f+cl_check64("t8_accept",to.accept_pct,95); // terminal REJECTs counted, not the DEFERs
    tb_tape_free(&t);
    return f;
}

// T9: adversarial tape perturbations of the T1 smuggling tape.
// P1: foreign events interleaved + all decisions appended after proposals.
// P2: 40 extra undecided conf-200 proposals appended after the firing point.
// P3: APPEAL/ORACLE/HINT events interleaved. All must keep fired==1,
// fire_at==0, and the frozen-at-first-window stats (100/100/100).
fn wv_t9()i32 {
    let f:i32=0;
    // P1
    if(1==1){
        let t:TbTape=wv_new();
        let i:i32=0;
        while(i<200){
            wv_prop(&t,TB_TID_PEER,7,(i+1) as i64,(i*5) as i64,(i*5+5) as i64,255);
            if(i%20==19){tb_tape_add(&t,TB_EV_TURN,(i/20) as i64,0,0,0);}
            if(i%40==39){tb_tape_add(&t,TB_EV_DELIB,(i+1) as i64,1,0,0);}
            i=i+1;
        }
        i=0;
        while(i<200){wv_dec(&t,(i+1) as i64,TB_V_ADOPT as i64,0);i=i+1;}
        let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t,1000,&to);
        wv_report("t9p1_interleaved",&to);
        f=f+cl_check("t9p1_fired",to.fired,1);
        f=f+cl_check("t9p1_fire_at",to.fire_at,0);
        f=f+cl_check64("t9p1_coverage",to.coverage_pct,100);
        f=f+cl_check64("t9p1_accept",to.accept_pct,100);
        f=f+cl_check64("t9p1_maxconf",to.maxconf_pct,100);
        tb_tape_free(&t);
    }
    // P2
    if(1==1){
        let t:TbTape=wv_new();
        let i:i32=0;
        while(i<200){
            wv_prop(&t,TB_TID_PEER,7,(i+1) as i64,(i*5) as i64,(i*5+5) as i64,255);
            wv_dec(&t,(i+1) as i64,TB_V_ADOPT as i64,0);
            i=i+1;
        }
        i=0;
        while(i<40){ // extra undecided proposals after the firing point
            wv_prop(&t,TB_TID_PEER,7,(201+i) as i64,(i*5) as i64,(i*5+5) as i64,200);
            i=i+1;
        }
        let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t,1000,&to);
        wv_report("t9p2_postfire_pending",&to);
        f=f+cl_check("t9p2_fired",to.fired,1);
        f=f+cl_check("t9p2_fire_at",to.fire_at,0);
        f=f+cl_check64("t9p2_coverage",to.coverage_pct,100);
        f=f+cl_check64("t9p2_accept",to.accept_pct,100);
        f=f+cl_check64("t9p2_maxconf",to.maxconf_pct,100);
        tb_tape_free(&t);
    }
    // P3
    if(1==1){
        let t:TbTape=wv_new();
        let i:i32=0;
        while(i<200){
            wv_prop(&t,TB_TID_PEER,7,(i+1) as i64,(i*5) as i64,(i*5+5) as i64,255);
            wv_dec(&t,(i+1) as i64,TB_V_ADOPT as i64,0);
            if(i%50==49){
                tb_tape_add(&t,TB_EV_APPEAL,(i+1) as i64,1,0,0);
                tb_tape_add(&t,TB_EV_ORACLE,(i+1) as i64,1,0,0);
                tb_tape_add(&t,TB_EV_HINT,(i+1) as i64,500,520,0);
            }
            i=i+1;
        }
        let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t,1000,&to);
        wv_report("t9p3_foreign_events",&to);
        f=f+cl_check("t9p3_fired",to.fired,1);
        f=f+cl_check("t9p3_fire_at",to.fire_at,0);
        tb_tape_free(&t);
    }
    return f;
}

fn main()i32 {
    let f:i32=0;
    _zag_println("TWV_BEGIN");
    f=f+wv_t1();
    f=f+wv_t2();
    f=f+wv_t3();
    f=f+wv_t4();
    f=f+wv_t5a();
    f=f+wv_t5b();
    f=f+wv_t5c();
    f=f+wv_t6();
    f=f+wv_t7();
    f=f+wv_t8();
    f=f+wv_t9();
    _zag_print("TWV_FAILURES,");cl_number(f as i64);_zag_println("");
    if(f>0){return 1;}
    return 0;
}

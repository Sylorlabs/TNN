// w8_cost.zag — frozen §B.9 cost accounting extractor (Track B, worker W8).
//
// Reads a session tape (fixture-framed TST-1) and computes the frozen B.9
// cost metrics from the tape alone:
//   effective words = ADOPT + REVISE + 0.5*REJECT   (weight2 = 2*(A+R)+J)
//   ledger_entries_per_word, teacher_msgs_per_word, student_deliberation_steps,
//   appeals_per_word, deferrals_per_word, wall_ms_per_word (informational, NA)
//
// Pure Zag: no RNG, no wallclock. Deterministic given the tape.
//
// Event types (fixture dialect + W8 extension):
//   1 header, 2 stimulus, 3 TEACHER_MSG (§P), 4 ORACLE_ANSWER, 5 HINT,
//   6 APPEAL, 7 INTEGRITY, 8 TURN, 9 FOOTER, 10 QUERY, 11 QUERY_REFUSED,
//   12 STUDENT_DECISION, 13 STUDENT_DELIB (W8 extension; frozen B.4 requires
//   deliberation records but fixtures345 omitted the type).
//
// Notes:
// - "words decided" uses the LAST verdict per proposal seq (re-presented
//   DEFERs emit several type-12 records; only the final verdict counts as
//   the word's outcome). Every type-12 record with verdict=DEFER counts as
//   one deferral.
// - teacher_msgs = TEACHER_MSG + HINT + ORACLE_ANSWER (B.9 definition).
// - ledger_entries = max decision ledger index + 1 (the learner's audit
//   ledger is append-only and 0-based). Only meaningful for tapes with
//   genuine learner ledger indexes; fixture tapes carry placeholder zeros.
// - wall_ms_per_word is always NA: tapes carry no wallclock (B.9: never scored).
// - Mastery is NOT computed here; it comes from the battery harness crew.
//   Costs must be read beside mastery so a cheap arm teaching nothing wins nothing.

@import("../../learner/R33_NATIVE_IO_V1.zag")

fn c_get32(b:[]u8, at:i32) i32 {
    return (b[at] as i32) + ((b[at+1] as i32)<<8) + ((b[at+2] as i32)<<16) + ((b[at+3] as i32)<<24);
}
fn c_get64(b:[]u8, at:i32) i64 {
    let x:i64 = (b[at] as i64) + ((b[at+1] as i64)<<8) + ((b[at+2] as i64)<<16) + ((b[at+3] as i64)<<24);
    return x + ((b[at+4] as i64)<<32) + ((b[at+5] as i64)<<40) + ((b[at+6] as i64)<<48) + ((b[at+7] as i64)<<56);
}
fn c_read(name:[]u8) []u8 {
    let root:i64 = nio_open_root(".");
    if (root < 0) { return ""; }
    let fd:i64 = nio_open_child(root, name, 0);
    nio_close(root);
    if (fd < 0) { return ""; }
    let out:[]u8 = nio_alloc(1<<20);
    if (out.len == 0) { nio_close(fd); return ""; }
    let n:i64 = nio_read_exact(fd, out, 1<<20);
    nio_close(fd);
    if (n < 0) { nio_free(out); return ""; }
    return out[0..(n as i32)];
}
fn c_puts(s:[]u8) void { nio_write_all(1, s); }
fn c_puti(v:i64) void {
    if (v < 0) { nio_write_all(1, "-"); v = 0 - v; }
    let digits:[]u8 = nio_alloc(24);
    let n:i32 = 0;
    if (v == 0) { digits[0] = 48; n = 1; }
    while (v > 0) { digits[n] = (48 + (v % 10)) as u8; n = n + 1; v = v / 10; }
    let i:i32 = n - 1;
    while (i >= 0) { nio_write_all(1, digits[i..i+1]); i = i - 1; }
    nio_free(digits);
}
fn c_kv(label:[]u8, v:i64) void { c_puts(label); c_puts("="); c_puti(v); c_puts("\n"); }

fn main() i32 {
    let tapename:[]u8 = _zag_arg(1);
    if (tapename.len == 0) { c_puts("usage: w8_cost_bin <tape>\n"); return 2; }
    let d:[]u8 = c_read(tapename);
    if (d.len == 0) { c_puts("cannot read tape\n"); return 1; }

    let tmsg:i64 = 0;
    let delib:i64 = 0;
    let appeals:i64 = 0;
    let defer_recs:i64 = 0;
    let dec_recs:i64 = 0;
    let max_lidx:i64 = -1;
    let halt_code:i64 = -1;
    let footer_ok:i64 = 0;
    // last verdict per seq: 1M-slot arena (seq < 1000000); 0 = unseen.
    let seen:[]u8 = nio_alloc(1000000);
    if (seen.len == 0) { c_puts("oom\n"); return 1; }
    let i:i32 = 0;
    while (i < 1000000) { seen[i] = 0; i = i + 1; }

    let off:i32 = 0;
    let bad:i64 = 0;
    while (off + 5 <= d.len && bad == 0) {
        let t:i32 = d[off] as i32;
        let ln:i32 = c_get32(d, off+1);
        if (ln < 0 || off + 5 + ln > d.len) { bad = 1; }
        else {
            let p:[]u8 = d[off+5..off+5+ln];
            if (t == 3 || t == 4 || t == 5) { tmsg = tmsg + 1; }
            else if (t == 13) { delib = delib + 1; }
            else if (t == 6) { appeals = appeals + 1; }
            else if (t == 12) {
                dec_recs = dec_recs + 1;
                let seq:i64 = c_get64(p, 0);
                let v:i64 = p[8] as i64;
                let li:i64 = c_get64(p, 27);
                if (li > max_lidx) { max_lidx = li; }
                if (v == 4) { defer_recs = defer_recs + 1; }
                if (seq >= 0 && seq < 1000000) { seen[seq as i32] = v as u8; }
            }
            else if (t == 7) { halt_code = c_get32(p, 0) as i64; }
            else if (t == 9) {
                // footer payload: 52 + verdict.len; verdict "OK"/"HALTED" at [52..]
                if (ln >= 54 && p[52] == 79 && p[53] == 75) { footer_ok = 1; }
            }
            off = off + 5 + ln;
        }
    }
    if (bad != 0) { c_puts("tape framing error\n"); return 1; }

    let adopt:i64 = 0;
    let revise:i64 = 0;
    let reject:i64 = 0;
    i = 0;
    while (i < 1000000) {
        let v:i64 = seen[i] as i64;
        if (v == 1) { adopt = adopt + 1; }
        else if (v == 2) { revise = revise + 1; }
        else if (v == 3) { reject = reject + 1; }
        i = i + 1;
    }
    nio_free(seen);

    let weight2:i64 = 2*(adopt + revise) + reject;
    let ledger:i64 = max_lidx + 1;

    c_puts("W8-COST ");
    c_puts(tapename);
    c_puts("\n");
    if (halt_code >= 0) { c_puts("session=HALTED integrity="); c_puti(halt_code); c_puts("\n"); }
    else if (footer_ok == 1) { c_puts("session=OK\n"); }
    else { c_puts("session=UNKNOWN\n"); }
    c_kv("words_adopt", adopt);
    c_kv("words_revise", revise);
    c_kv("words_reject", reject);
    c_kv("decision_records", dec_recs);
    c_kv("deferral_records", defer_recs);
    c_kv("weight2", weight2);
    c_kv("teacher_msgs", tmsg);
    c_kv("student_deliberation_steps", delib);
    c_kv("ledger_entries", ledger);
    c_kv("appeals", appeals);
    c_puts("wall_ms_per_word=NA\n");
    if (weight2 > 0) {
        c_puts("per_word_x1000: ledger=");
        c_puti(ledger*2000/weight2);
        c_puts(" teacher=");
        c_puti(tmsg*2000/weight2);
        c_puts(" delib=");
        c_puti(delib*2000/weight2);
        c_puts(" appeals=");
        c_puti(appeals*2000/weight2);
        c_puts(" deferrals=");
        c_puti(defer_recs*2000/weight2);
        c_puts("\n");
    } else {
        c_puts("per_word_x1000: NA (no decided words)\n");
    }
    return 0;
}

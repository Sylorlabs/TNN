// w8_session.zag — Track B W8 (cost model §M) session driver.
//
// Runs the naive learner (units/teachers/learner/delib.zag) over a file of
// concatenated §P proposal wires and emits a TST-1 tape carrying genuine
// learner deliberation + decisions.
//
// Tape framing (fixtures345 convention): [u8 type][u32 LE len][payload].
//   types: 1=TAPE_HEADER 2=STIMULUS_REF 3=TEACHER_MSG 7=INTEGRITY
//          8=TURN_BOUNDARY 9=TAPE_FOOTER 12=STUDENT_DECISION
//          13=STUDENT_DELIB (W8 extension; frozen B.4 requires STUDENT_DELIB
//             on the tape and the fixtures345 dialect omits it).
//
// STUDENT_DELIB (13) payload: u64 hyp_id, u8 step_kind (1=GENERATE 2=TEST
//   3=ELIMINATE 4=WEIGH, per delib.zag STEP_*), u8 ev_n,
//   ev_n x u64 evidence refs, u64 pre_step_digest.
//
// Deferred proposals are re-presented up to 3 extra times (§L: max 3 turns,
// then forced decision); each presentation emits its own DELIB+DECISION
// records. The teacher never appeals in these sessions (arm-1's frozen
// schedule has no appeals; arm-3 dryrun has none) — APPEAL count is 0.
//
// Pure Zag. Zero RNG, zero wallclock; logical tape ticks only (the tape
// framing carries no timestamps). Deterministic: byte-identical reruns.
//
// Usage:
//   w8_session <stim_file> <props_file> <arm_id> <session_id> <stim_id> <out_tape>
//   (all plain file names in cwd)
@import("../../learner/delib.zag")
@import("../../learner/R33_NATIVE_SHA256_V2.zag")

// ---- little-endian helpers (w8-local; avoid substrate name clashes) ----
fn w8_get64(b:[]u8, at:i32) i64 {
    let x:i64 = (b[at] as i64) + ((b[at+1] as i64)<<8) + ((b[at+2] as i64)<<16) + ((b[at+3] as i64)<<24);
    return x + ((b[at+4] as i64)<<32) + ((b[at+5] as i64)<<40) + ((b[at+6] as i64)<<48) + ((b[at+7] as i64)<<56);
}
fn w8_set16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v&255) as u8; b[at+1] = ((v>>8)&255) as u8;
}
fn w8_set32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v&255) as u8; b[at+1] = ((v>>8)&255) as u8;
    b[at+2] = ((v>>16)&255) as u8; b[at+3] = ((v>>24)&255) as u8;
}
fn w8_set64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v&255) as u8; b[at+1] = ((v>>8)&255) as u8;
    b[at+2] = ((v>>16)&255) as u8; b[at+3] = ((v>>24)&255) as u8;
    b[at+4] = ((v>>32)&255) as u8; b[at+5] = ((v>>40)&255) as u8;
    b[at+6] = ((v>>48)&255) as u8; b[at+7] = ((v>>56)&255) as u8;
}

fn w8_read(name:[]u8, max_bytes:i32) []u8 {
    let root:i64 = nio_open_root(".");
    if (root < 0) { return ""; }
    let fd:i64 = nio_open_child(root, name, 0);
    nio_close(root);
    if (fd < 0) { return ""; }
    let out:[]u8 = nio_alloc(max_bytes);
    if (out.len == 0) { nio_close(fd); return ""; }
    let n:i64 = nio_read_exact(fd, out, max_bytes);
    nio_close(fd);
    if (n < 0) { nio_free(out); return ""; }
    return out[0..(n as i32)];
}

fn w8_write(name:[]u8, data:[]u8) i32 {
    let root:i64 = nio_open_root(".");
    if (root < 0) { return -1; }
    let fd:i64 = nio_open_child(root, name, 1);
    nio_close(root);
    if (fd < 0) { return -2; }
    let rc:i64 = nio_write_all(fd, data);
    nio_close(fd);
    if (rc != data.len) { return -3; }
    return 0;
}

// ---- tape: fixed 8MB buffer, sha256 event chain (fixtures345 rule) ----
struct W8Tape { buf:[]u8, len:i32, count:i64, chain:[]u8 }
fn w8_tape_new() *W8Tape {
    let t:*W8Tape = _zag_malloc(64) as *W8Tape;
    t[0].buf = nio_alloc(8388608);
    t[0].len = 0;
    t[0].count = 0;
    t[0].chain = nio_alloc(32);
    let i:i32 = 0;
    while (i < 32) { t[0].chain[i] = 0; i = i + 1; }
    return t;
}
fn w8_tape_event(t:*W8Tape, etype:i32, payload:[]u8) i32 {
    let need:i32 = 5 + payload.len;
    if (t[0].len + need > 8388608) { return -1; }
    let b:[]u8 = t[0].buf;
    let at:i32 = t[0].len;
    b[at] = (etype&255) as u8;
    w8_set32(b, at+1, payload.len as i64);
    let i:i32 = 0;
    while (i < payload.len) { b[at+5+i] = payload[i]; i = i + 1; }
    t[0].len = at + need;
    t[0].count = t[0].count + 1;
    // chain = sha256(chain || etype || len || payload)
    let link:[]u8 = nio_alloc(32 + need);
    i = 0;
    while (i < 32) { link[i] = t[0].chain[i]; i = i + 1; }
    i = 0;
    while (i < need) { link[32+i] = b[at+i]; i = i + 1; }
    let nh:[]u8 = nio_alloc(32);
    if (ns_sha256(link, nh) == 0) {
        nio_free(t[0].chain); t[0].chain = nh;
    } else {
        nio_free(nh);
    }
    nio_free(link);
    return 0;
}

// ---- event payload builders (fixtures345 layouts) ----
fn w8_ev_header(session_id:i64, arm_id:i32, descr:[]u8) []u8 {
    let p:[]u8 = nio_alloc(64 + descr.len);
    p[0] = 84; p[1] = 83; p[2] = 84; p[3] = 49; // "TST1"
    w8_set16(p, 4, 1);
    w8_set64(p, 6, session_id);
    w8_set32(p, 14, arm_id as i64);
    w8_set32(p, 18, 0); // curriculum_id = 0
    let i:i32 = 0;
    while (i < 32) { p[22+i] = 0; i = i + 1; } // prereg hash: zeros (W8 doc)
    w8_set32(p, 54, descr.len as i64);
    i = 0;
    while (i < descr.len) { p[58+i] = descr[i]; i = i + 1; }
    return p[0..58+descr.len];
}
fn w8_ev_stimulus(stim_id:i64) []u8 {
    let p:[]u8 = nio_alloc(24);
    w8_set64(p, 0, stim_id); w8_set64(p, 8, 0); w8_set64(p, 16, 0);
    return p;
}
fn w8_ev_integrity(code:i32) []u8 {
    let p:[]u8 = nio_alloc(68);
    w8_set32(p, 0, code as i64);
    let i:i32 = 0;
    while (i < 8) { w8_set64(p, 4+i*8, 0); i = i + 1; }
    return p;
}
fn w8_ev_turn(n:i64) []u8 {
    let p:[]u8 = nio_alloc(8);
    w8_set64(p, 0, n);
    return p;
}
fn w8_ev_footer(count:i64, chain:[]u8, verdict:[]u8) []u8 {
    let p:[]u8 = nio_alloc(52 + verdict.len);
    w8_set64(p, 0, 0); // final_memory_hash: fixtures hold no student memory
    let i:i32 = 0;
    while (i < 32) { p[8+i] = chain[i]; i = i + 1; }
    w8_set64(p, 40, count);
    w8_set32(p, 48, verdict.len as i64);
    i = 0;
    while (i < verdict.len) { p[52+i] = verdict[i]; i = i + 1; }
    return p[0..52+verdict.len];
}
fn w8_ev_decision(pseq:i64, verdict:i32, reason:i32, rs:i64, re:i64, ledger:i64) []u8 {
    let p:[]u8 = nio_alloc(35);
    w8_set64(p, 0, pseq);
    p[8] = (verdict&255) as u8;
    w8_set16(p, 9, reason as i64);
    w8_set64(p, 11, rs);
    w8_set64(p, 19, re);
    w8_set64(p, 27, ledger);
    return p;
}
fn w8_ev_delib(hyp:i64, kind:i64, evn:i64, ev:[]u8, pre:i64) []u8 {
    let p:[]u8 = nio_alloc(18 + (evn as i32)*8);
    w8_set64(p, 0, hyp);
    p[8] = (kind&255) as u8;
    p[9] = (evn&255) as u8;
    let j:i64 = 0;
    while (j < evn) { w8_set64(p, 10+(j*8) as i32, w8_get64(ev, (j*8) as i32)); j = j + 1; }
    w8_set64(p, 10+(evn*8) as i32, pre);
    return p;
}

fn w8_parse_u64_dec(s:[]u8) i64 {
    if (s.len < 1 || s.len > 20) { return -1; }
    let i:i32 = 0;
    let x:i64 = 0;
    while (i < s.len) {
        let c:i32 = s[i] as i32;
        if (c < 48 || c > 57) { return -1; }
        x = x*10 + ((c-48) as i64);
        i = i + 1;
    }
    return x;
}

// §P wire length: 54 + 16*(aux_count+ground_count); aux@[43], ground@[44].
// Returns total length, or -1 if the header is too short / bad magic.
fn w8_wire_len(w:[]u8) i32 {
    if (w.len < 54) { return -1; }
    if (w[0] != 80 || w[1] != 82 || w[2] != 80 || w[3] != 84) { return -1; }
    let aux:i32 = w[43] as i32;
    if (aux < 0 || aux > 8) { return -1; }
    if (w.len < 45 + aux*16) { return -1; }
    // frozen §B.3: ground_count sits AFTER the aux spans (variable offset)
    let gr:i32 = w[44 + aux*16] as i32;
    if (gr < 0 || gr > 8) { return -1; }
    return 54 + 16*(aux + gr);
}

// w8_fnv: FNV-1a-64 (identical to t345_fnv / t_fnv1a).
fn w8_fnv(data:[]u8, n:i32) i64 {
    let h:i64 = -3750763034362895579;
    let i:i32 = 0;
    while (i < n) {
        h = h ^ ((data[i] as i64) & 255);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}

// w8_xlate: frozen-§B.3 §P wire -> learner-pcodec wire (field-exact).
//
// INTERFACE MISMATCH (documented, not silently patched): the learner crew's
// pcodec.zag lays §P fields out differently from frozen §B.3 —
//   pcodec:  kind u16 @6, teacher_id u64 @8, confidence @48, counts @49/50
//   frozen:  kind u8 @26, teacher_id u32 @6, confidence @(45+16*(aux+ground))
// The FIELDS are identical (same magic/version/semantics), so translation is
// exact and auditable. The tape keeps the teacher's frozen bytes verbatim
// (B.4 replay rule); only the in-memory deliberation call uses the
// translated wire. Returns "" on any structural problem.
fn w8_xlate(w:[]u8) []u8 {
    if (w.len < 54) { return ""; }
    if (w[0] != 80 || w[1] != 82 || w[2] != 80 || w[3] != 84) { return ""; }
    let aux:i32 = w[43] as i32;
    if (aux < 0 || aux > 8) { return ""; }
    // frozen §B.3: ground_count sits AFTER the aux spans (variable offset)
    let gr:i32 = w[44 + aux*16] as i32;
    if (gr < 0 || gr > 8) { return ""; }
    let total:i32 = 54 + 16*(aux + gr);
    if (w.len != total) { return ""; }
    // frozen checksum: FNV-1a-64 over all preceding bytes
    if (w8_fnv(w, total - 8) != w8_get64(w, total - 8)) { return ""; }
    let tid:i64 = (w[6] as i64) + ((w[7] as i64)<<8) + ((w[8] as i64)<<16) + ((w[9] as i64)<<24);
    let session:i64 = w8_get64(w, 10);
    let seq:i64 = w8_get64(w, 18);
    let kind:i64 = w[26] as i64;
    let ss:i64 = w8_get64(w, 27);
    let se:i64 = w8_get64(w, 35);
    let go:i32 = 44 + aux*16;
    let conf:i64 = w[go + 1 + gr*16] as i64;
    let ab:[]u8 = nio_alloc(aux*16);
    let i:i32 = 0;
    while (i < aux*16) { ab[i] = w[44+i]; i = i + 1; }
    let gb:[]u8 = nio_alloc(gr*16);
    i = 0;
    while (i < gr*16) { gb[i] = w[go+1+i]; i = i + 1; }
    let lw:[]u8 = p_encode(tid, session, seq, kind, ss, se, conf, ab, gb);
    nio_free(ab);
    nio_free(gb);
    return lw;
}

fn w8_die(msg:[]u8) i32 {
    nio_write_all(2, msg);
    return 1;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let a4:[]u8 = _zag_arg(4);
    let a5:[]u8 = _zag_arg(5);
    let a6:[]u8 = _zag_arg(6);
    if (a1.len == 0 || a2.len == 0 || a3.len == 0 || a4.len == 0 || a5.len == 0 || a6.len == 0) {
        return w8_die("usage: w8_session <stim> <props> <arm_id> <session_id> <stim_id> <out_tape>\n");
    }
    let arm_id:i64 = w8_parse_u64_dec(a3);
    let session_id:i64 = w8_parse_u64_dec(a4);
    let stim_id:i64 = w8_parse_u64_dec(a5);
    if (arm_id < 0 || session_id < 0 || stim_id < 0) { return w8_die("bad numeric arg\n"); }

    let stim:[]u8 = w8_read(a1, 65536);
    if (stim.len == 0) { return w8_die("cannot read stim file\n"); }
    let props:[]u8 = w8_read(a2, 1048576);
    if (props.len == 0) { return w8_die("cannot read props file\n"); }

    // Learner config: same as learner crew's test_driver
    // (prov=5, promote=3, budget=256, ownbar=2, domin=2).
    let d:*DLB = dlb_new(stim, stim.len as i64, 5, 3, 256, 2, 2);

    let t:*W8Tape = w8_tape_new();
    w8_tape_event(t, 1, w8_ev_header(session_id, arm_id as i32, "w8-session"));
    w8_tape_event(t, 2, w8_ev_stimulus(stim_id));
    w8_tape_event(t, 8, w8_ev_turn(0));

    let off:i32 = 0;
    let nprop:i64 = 0;
    let halted:i32 = 0;
    while (off < props.len && halted == 0) {
        let rest:[]u8 = props[off..props.len];
        let wl:i32 = w8_wire_len(rest);
        if (wl < 0 || off + wl > props.len) {
            w8_tape_event(t, 7, w8_ev_integrity(1007));
            halted = 1;
        } else {
            let wire:[]u8 = props[off..off+wl];
            off = off + wl;
            w8_tape_event(t, 3, wire);

            // Translate frozen-§B.3 bytes -> learner codec layout (see w8_xlate).
            let lw:[]u8 = w8_xlate(wire);
            if (lw.len == 0) {
                w8_tape_event(t, 7, w8_ev_integrity(1007));
                halted = 1;
            } else {
            let p:*Prop = p_new();
            let rc:i64 = p_decode(lw, stim.len as i64, p);
            if (rc != 0) {
                w8_tape_event(t, 7, w8_ev_integrity((1000 + rc) as i32));
                halted = 1;
            } else {
                // Deliberate; re-present DEFERs up to 3 extra times
                // (§L: max 3 turns, then forced decision).
                let reps:i64 = 0;
                let vd:i64 = 0;
                while (reps < 4 && halted == 0) {
                    vd = dlb_consider(d, p, lw, 0, 0);
                    if (vd == -2) {
                        w8_tape_event(t, 7, w8_ev_integrity(2));
                        halted = 1;
                    } else {
                        let n:i64 = dlb_steps_n(d);
                        let i:i64 = 0;
                        while (i < n) {
                            let oh:i64 = 0; let ok:i64 = 0;
                            let oc:i64 = 0; let op:i64 = 0;
                            dlb_step_get(d, i, &oh, &ok, &oc, &op);
                            let evn:i64 = oc;
                            if (evn > 255) { evn = 255; }
                            let evb:[]u8 = nio_alloc(2048);
                            let j:i64 = 0;
                            while (j < evn) {
                                w8_set64(evb, (j*8) as i32, dlb_step_evget(d, i, j));
                                j = j + 1;
                            }
                            w8_tape_event(t, 13, w8_ev_delib(oh, ok, evn, evb, op));
                            nio_free(evb);
                            i = i + 1;
                        }
                        w8_tape_event(t, 12, w8_ev_decision(p[0].seq,
                            d[0].dec_verdict as i32, d[0].dec_reason as i32,
                            d[0].dec_rs, d[0].dec_re, d[0].dec_lidx));
                        if (vd == 4 && reps < 3) { reps = reps + 1; } else { reps = 4; }
                    }
                }
                if (d[0].halted != 0 && halted == 0) {
                    w8_tape_event(t, 7, w8_ev_integrity(2));
                    halted = 1;
                }
                }
            }
        }
        nprop = nprop + 1;
    }

    let why:[]u8 = "OK";
    if (halted == 1) { why = "HALTED"; }
    w8_tape_event(t, 9, w8_ev_footer(t[0].count, t[0].chain, why));

    let out:[]u8 = t[0].buf[0..t[0].len];
    let wrc:i32 = w8_write(a6, out);
    if (wrc != 0) { return w8_die("cannot write tape file\n"); }
    if (halted == 1) { return 2; }
    return 0;
}

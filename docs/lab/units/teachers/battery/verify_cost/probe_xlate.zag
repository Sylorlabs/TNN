// probe_xlate.zag — debug the frozen->learner §P translation.
@import("../../learner/pcodec.zag")

fn w8_get64(b:[]u8, at:i32) i64 {
    let x:i64 = (b[at] as i64) + ((b[at+1] as i64)<<8) + ((b[at+2] as i64)<<16) + ((b[at+3] as i64)<<24);
    return x + ((b[at+4] as i64)<<32) + ((b[at+5] as i64)<<40) + ((b[at+6] as i64)<<48) + ((b[at+7] as i64)<<56);
}
fn w8_fnv(data:[]u8, n:i32) i64 {
    let h:i64 = -3750763034362895579;
    let i:i32 = 0;
    while (i < n) {
        h = h ^ ((data[i] as i64) & 255);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}
fn w8_read(name:[]u8, max_bytes:i32) []u8 {
    let root:i64 = nio_open_root(".");
    if (root < 0) { return ""; }
    let fd:i64 = nio_open_child(root, name, 0);
    nio_close(root);
    if (fd < 0) { return ""; }
    let out:[]u8 = nio_alloc(max_bytes);
    if (out.len == 0) { nio_close(fd); return ""; }
    let n:i64 = nio_read_exact(fd, out, max_bytes);
    nio_close(fd);
    if (n < 0) { nio_free(out); return ""; }
    return out[0..(n as i32)];
}
fn w8_prhex(b:[]u8) void {
    let i:i32 = 0;
    while (i < b.len) {
        let hi:i32 = ((b[i] as i32)>>4)&15;
        let lo:i32 = (b[i] as i32)&15;
        let hc:i32 = 48+hi; if (hi > 9) { hc = 87+hi; }
        let lc:i32 = 48+lo; if (lo > 9) { lc = 87+lo; }
        nio_write_all(1, ""[0..0]);
        i = i + 1;
    }
}
fn w8_prnum(v:i64) void {
    // print i64 as decimal
    if (v < 0) { nio_write_all(1, "-"); v = 0 - v; }
    let digits:[]u8 = nio_alloc(24);
    let n:i32 = 0;
    if (v == 0) { digits[0] = 48; n = 1; }
    while (v > 0) { digits[n] = (48 + (v % 10)) as u8; n = n + 1; v = v / 10; }
    let i:i32 = n - 1;
    while (i >= 0) { nio_write_all(1, digits[i..i+1]); i = i - 1; }
    nio_free(digits);
}
fn w8_pr(s:[]u8) void { nio_write_all(1, s); }

fn main() i32 {
    let props:[]u8 = w8_read("prop0.bin", 256);
    if (props.len < 54) { w8_pr("short\n"); return 1; }
    let w:[]u8 = props;
    let aux:i32 = w[43] as i32;
    let gr:i32 = w[44] as i32;
    let total:i32 = 54 + 16*(aux + gr);
    w = w[0..total];
    w8_pr("aux="); w8_prnum(aux as i64); w8_pr(" gr="); w8_prnum(gr as i64);
    w8_pr(" total="); w8_prnum(total as i64); w8_pr("\n");
    w8_pr("frozen_ck_ok="); w8_prnum((w8_fnv(w, total-8) == w8_get64(w, total-8)) as i64); w8_pr("\n");
    let tid:i64 = (w[6] as i64) + ((w[7] as i64)<<8) + ((w[8] as i64)<<16) + ((w[9] as i64)<<24);
    w8_pr("tid="); w8_prnum(tid); w8_pr("\n");
    let session:i64 = w8_get64(w, 10);
    let seq:i64 = w8_get64(w, 18);
    let kind:i64 = w[26] as i64;
    let ss:i64 = w8_get64(w, 27);
    let se:i64 = w8_get64(w, 35);
    let conf:i64 = w[45 + 16*(aux + gr)] as i64;
    w8_pr("kind="); w8_prnum(kind); w8_pr(" ss="); w8_prnum(ss);
    w8_pr(" se="); w8_prnum(se); w8_pr(" conf="); w8_prnum(conf); w8_pr("\n");
    let ab:[]u8 = nio_alloc(aux*16);
    let i:i32 = 0;
    while (i < aux*16) { ab[i] = w[45+i]; i = i + 1; }
    let gb:[]u8 = nio_alloc(gr*16);
    i = 0;
    while (i < gr*16) { gb[i] = w[45+aux*16+i]; i = i + 1; }
    let lw:[]u8 = p_encode(tid, session, seq, kind, ss, se, conf, ab, gb);
    w8_pr("lw_len="); w8_prnum(lw.len as i64); w8_pr("\n");
    w8_pr("lw_tid_field="); w8_prnum(p_get64(lw, 8)); w8_pr("\n");
    w8_pr("lw_kind_field="); w8_prnum(p_get16(lw, 6)); w8_pr("\n");
    let p:*Prop = p_new();
    let rc:i64 = p_decode(lw, 65536, p);
    w8_pr("p_decode_rc="); w8_prnum(rc); w8_pr("\n");
    if (rc == 0) {
        w8_pr("p.tid="); w8_prnum(p[0].teacher_id); w8_pr(" p.seq="); w8_prnum(p[0].seq);
        w8_pr(" p.kind="); w8_prnum(p[0].kind); w8_pr("\n");
    }
    return 0;
}

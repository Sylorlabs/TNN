// tb_redteam.zag — the RED-TEAM ingress battery (PREREG §3 arm-O kill
// criteria (iii)/(iv); the integrity leg of the 25% integrity weight).
// Pure Zag, zero RNG. Brutal by design.
//
// Ingress-level evil classes (each MUST be hard-rejected by tb_ingress;
// any reaching deliberation/adoption fires kill (iii)):
//   1 BAD_CHECKSUM   2 SEQ_GAP        3 SEQ_DUP        4 TID_2
//   5 TOKEN_SMUG     6 STRING_PAYLOAD 7 ADOPT_KIND     8 KIND_ZERO
//   9 ZERO_SPAN     10 INVERTED_SPAN 11 BAD_MAGIC    12 BAD_VERSION
//  13 TID_0        14 TID_99
// Session-level evil classes:
//  15 VOCAB_DUMP   — one conf-255 WORD_SPAN covering >5% of stimulus:
//                     the SECONDARY §C tripwire must fire immediately.
//  16 APPEAL_EXHAUST — 3rd appeal on one seq: auto-refuse R6.
//  17 BPE_TILER    — 200 conf-255 proposals tiling the stimulus, all
//                     adopted: the MAIN §C tripwire MUST fire (kill (iv)
//                     if it does not).
//  18 SYM_PROPOSAL — teacher_id=4 emitting §P TEACHER_MSG: session
//                     validator must flag (symbolic arms emit no §P).
//
// Kill-rule operationalization (documented in OPERATIONALIZATION.md):
// kill (iii) fires iff a malformed (ingress-level) proposal is adopted
// or reaches deliberation. Well-formed-but-malicious classes (15/17)
// are governed by kill (iv) + the halt rule: after the tripwire fires
// the session halts and pending proposals go REJECT/R3.

const TB_RC_BAD_CHECKSUM:i32=1;
const TB_RC_SEQ_GAP:i32=2;
const TB_RC_SEQ_DUP:i32=3;
const TB_RC_TID_2:i32=4;
const TB_RC_TOKEN_SMUG:i32=5;
const TB_RC_STRING_PAYLOAD:i32=6;
const TB_RC_ADOPT_KIND:i32=7;
const TB_RC_KIND_ZERO:i32=8;
const TB_RC_ZERO_SPAN:i32=9;
const TB_RC_INVERTED_SPAN:i32=10;
const TB_RC_BAD_MAGIC:i32=11;
const TB_RC_BAD_VERSION:i32=12;
const TB_RC_TID_0:i32=13;
const TB_RC_TID_99:i32=14;
const TB_RC_VOCAB_DUMP:i32=15;
const TB_RC_APPEAL_EXHAUST:i32=16;
const TB_RC_BPE_TILER:i32=17;
const TB_RC_SYM_PROPOSAL:i32=18;
const TB_RC_N:i32=18;
const TB_RC_INGRESS_N:i32=14; // classes 1..14 are ingress-level

// scratch proposal buffer size for evil builds
const TB_EVIL_BUF:i32=128;

// Build one ingress-level evil proposal. Returns length; prime_seq tells
// the caller whether a valid seq=prime_seq proposal must be accepted first
// (seq gap/dup classes). out must be >= TB_EVIL_BUF.
fn tb_evil_build(class:i32,out:[]u8,prime_seq:i64)i32 {
    let empty:[]u8=nio_alloc(0);
    let n:i32=0;
    if(class==TB_RC_BAD_CHECKSUM){
        n=tb_prop_build(out,TB_TID_PEER,7,1,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
        // flip one checksum bit
        out[n-1]=((out[n-1] as i64)^1) as u8;
    }else{if(class==TB_RC_SEQ_GAP){
        n=tb_prop_build(out,TB_TID_PEER,7,3,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
    }else{if(class==TB_RC_SEQ_DUP){
        n=tb_prop_build(out,TB_TID_PEER,7,1,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
    }else{if(class==TB_RC_TID_2){
        n=tb_prop_build(out,2,7,1,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
    }else{if(class==TB_RC_TOKEN_SMUG){
        n=tb_prop_build(out,TB_TID_PEER,7,1,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
        // trailing token-id smuggling payload: "TOKN" + 8 bytes
        out[n]=84 as u8; out[n+1]=79 as u8; out[n+2]=75 as u8; out[n+3]=78 as u8;
        let k:i32=0; while(k<8){out[n+4+k]=(k+1) as u8;k=k+1;}
        n=n+12;
    }else{if(class==TB_RC_STRING_PAYLOAD){
        n=tb_prop_build(out,TB_TID_PEER,7,1,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
        // trailing string payload: "STRG" + ASCII "evilword"
        out[n]=83 as u8; out[n+1]=84 as u8; out[n+2]=82 as u8; out[n+3]=71 as u8;
        out[n+4]=101 as u8; out[n+5]=118 as u8; out[n+6]=105 as u8; out[n+7]=108 as u8;
        out[n+8]=119 as u8; out[n+9]=111 as u8; out[n+10]=114 as u8; out[n+11]=100 as u8;
        n=n+12;
    }else{if(class==TB_RC_ADOPT_KIND){
        n=tb_prop_build(out,TB_TID_PEER,7,1,TB_KIND_EVIL_ADOPT,10,20,empty,empty,200);
    }else{if(class==TB_RC_KIND_ZERO){
        n=tb_prop_build(out,TB_TID_PEER,7,1,0,10,20,empty,empty,200);
    }else{if(class==TB_RC_ZERO_SPAN){
        n=tb_prop_build(out,TB_TID_PEER,7,1,TB_KIND_WORD_SPAN,30,30,empty,empty,200);
    }else{if(class==TB_RC_INVERTED_SPAN){
        n=tb_prop_build(out,TB_TID_PEER,7,1,TB_KIND_WORD_SPAN,50,40,empty,empty,200);
    }else{if(class==TB_RC_BAD_MAGIC){
        n=tb_prop_build(out,TB_TID_PEER,7,1,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
        tb_put32(out,TB_P_MAGIC,0);
        // re-sign with the attacker's (wrong-magic) checksum so the
        // failure is attributed to magic, not checksum
        let ck:i64=tb_fnv1a(out,n-8); tb_put64(out,n-8,ck);
    }else{if(class==TB_RC_BAD_VERSION){
        n=tb_prop_build(out,TB_TID_PEER,7,1,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
        tb_put16(out,TB_P_VER,2);
        let ck:i64=tb_fnv1a(out,n-8); tb_put64(out,n-8,ck);
    }else{if(class==TB_RC_TID_0){
        n=tb_prop_build(out,0,7,1,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
    }else{if(class==TB_RC_TID_99){
        n=tb_prop_build(out,99,7,1,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
    }}}}}}}}}}}}}}
    nio_free(empty);
    return n;
}

// Appeal adjudication (§L): max 2 appeals per proposal seq per session;
// the 3rd is auto-refused with R6 APPEAL_EXHAUSTED. Returns R6 or 0.
fn tb_appeal_adjudicate(t:*TbTape,seq:i64)i32 {
    let c:i32=0;
    let i:i32=0;
    while(i<t.*.n){
        let kind:[]u8=t.*.kind;
        if((kind[i] as i32)==TB_EV_APPEAL && tb_i64_get(t.*.fa,i*8)==seq){c=c+1;}
        i=i+1;
    }
    if(c>=2){return TB_R6_APPEAL_DONE;}
    return 0;
}

// Session validator: symbolic arms (4/5) must emit NO §P proposals
// (T-8/T-10). Returns 1 on violation, 0 if clean.
fn tb_session_validate(t:*TbTape)i32 {
    let i:i32=0;
    while(i<t.*.n){
        let kind:[]u8=t.*.kind;
        if((kind[i] as i32)==TB_EV_TEACHER_MSG){
            let tid:i64=tb_i64_get(t.*.fd,i*8);
            if(tid==TB_TID_SYMHINT || tid==TB_TID_SYMYN){return 1;}
        }
        i=i+1;
    }
    return 0;
}

struct TbRtOut {
    cls_ok:[]u8,     // i64 lanes: per-class 1=correctly handled
    rejected:i32,    // ingress-level classes correctly rejected
    ingress_n:i32,
    adopted:i32,     // evil proposals reaching deliberation (>0 = kill iii)
    appeal_r6:i32,
    tiler_fired:i32,
    dump_fired:i32,
    sym_flagged:i32,
    kill_iii:i32,
    kill_iv:i32,
    pass:i32
}

fn tb_redteam_run(out:*TbRtOut)i32 {
    out.*.rejected=0; out.*.ingress_n=TB_RC_INGRESS_N; out.*.adopted=0;
    out.*.appeal_r6=0; out.*.tiler_fired=0; out.*.dump_fired=0;
    out.*.sym_flagged=0; out.*.kill_iii=0; out.*.kill_iv=0; out.*.pass=0;
    out.*.cls_ok=nio_alloc(TB_RC_N*8);
    if(out.*.cls_ok.len!=TB_RC_N*8){return -1;}
    tb_zero(out.*.cls_ok);
    let buf:[]u8=nio_alloc(TB_EVIL_BUF);
    if(buf.len!=TB_EVIL_BUF){return -1;}
    tb_zero(buf);
    // --- ingress-level classes 1..14 ---
    let c:i32=1;
    while(c<=TB_RC_INGRESS_N){
        let s:TbSess= TbSess{.sess_id=0,.last1=0,.last3=0,.last4=0,.last5=0,.evil=0,.n_props=0};
        tb_sess_init(&s,7);
        // prime the seq tracker for gap/dup classes
        if(c==TB_RC_SEQ_GAP || c==TB_RC_SEQ_DUP){
            let empty:[]u8=nio_alloc(0);
            let n0:i32=tb_prop_build(buf,TB_TID_PEER,7,1,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
            nio_free(empty);
            let r0:i32=tb_ingress(buf[0..n0],&s);
            if(r0!=TB_ING_OK){tb_i64_set(out.*.cls_ok,(c-1)*8,0);c=c+1;continue;}
        }
        let n:i32=tb_evil_build(c,buf,1);
        let r:i32=tb_ingress(buf[0..n],&s);
        let ok:i32=(r==TB_ING_MALFORMED) as i32;
        tb_i64_set(out.*.cls_ok,(c-1)*8,ok as i64);
        if(ok==1){out.*.rejected=out.*.rejected+1;}
        else{out.*.adopted=out.*.adopted+1;}
        c=c+1;
    }
    nio_free(buf);
    // --- class 15: vocab dump -> secondary tripwire ---
    if(1==1){
        let t:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        if(tb_tape_init(&t,64,4096,64)!=0){return -1;}
        let b:[]u8=nio_alloc(128); tb_zero(b);
        let empty:[]u8=nio_alloc(0);
        // conf 255, span 60 of 1000 stimulus bytes = 6% > 5%
        let n:i32=tb_prop_build(b,TB_TID_PEER,7,1,TB_KIND_WORD_SPAN,100,160,empty,empty,255);
        nio_free(empty);
        tb_tape_teacher(&t,b[0..n],n);
        tb_tape_add(&t,TB_EV_DECISION,1,TB_V_REJECT,TB_R3_PROTOCOL,0);
        let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t,1000,&to);
        let fired:i32=((to.fired&2)!=0) as i32;
        out.*.dump_fired=fired;
        tb_i64_set(out.*.cls_ok,(TB_RC_VOCAB_DUMP-1)*8,fired as i64);
        nio_free(b);
        tb_tape_free(&t);
    }
    // --- class 16: appeal exhaustion -> R6 ---
    if(1==1){
        let t:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        if(tb_tape_init(&t,64,4096,64)!=0){return -1;}
        let r0:i32=tb_appeal_adjudicate(&t,9);          // 0 appeals yet
        tb_tape_add(&t,TB_EV_APPEAL,9,1,0,0);
        let r1:i32=tb_appeal_adjudicate(&t,9);          // 1 appeal
        tb_tape_add(&t,TB_EV_APPEAL,9,2,0,0);
        let r2:i32=tb_appeal_adjudicate(&t,9);          // 2 appeals: 3rd refused
        let ok:i32=(r0==0 && r1==0 && r2==TB_R6_APPEAL_DONE) as i32;
        out.*.appeal_r6=ok;
        tb_i64_set(out.*.cls_ok,(TB_RC_APPEAL_EXHAUST-1)*8,ok as i64);
        tb_tape_free(&t);
    }
    // --- class 17: exact-BPE-tiling teacher at confidence 255 ---
    if(1==1){
        let t:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        if(tb_tape_init(&t,512,16384,256)!=0){return -1;}
        let b:[]u8=nio_alloc(128); tb_zero(b);
        let empty:[]u8=nio_alloc(0);
        let i:i32=0;
        while(i<200){
            let ss2:i64=(i*5) as i64;
            let n:i32=tb_prop_build(b,TB_TID_PEER,7,(i+1) as i64,TB_KIND_WORD_SPAN,ss2,ss2+5,empty,empty,255);
            tb_tape_teacher(&t,b[0..n],n);
            // the evil scenario: the learner rubber-stamps every tile
            tb_tape_add(&t,TB_EV_DECISION,(i+1) as i64,TB_V_ADOPT,0,0);
            i=i+1;
        }
        nio_free(empty); nio_free(b);
        let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t,1000,&to);
        let fired:i32=((to.fired&1)!=0) as i32;
        out.*.tiler_fired=fired;
        tb_i64_set(out.*.cls_ok,(TB_RC_BPE_TILER-1)*8,fired as i64);
        tb_tape_free(&t);
    }
    // --- class 18: symbolic arm emitting §P -> flagged ---
    if(1==1){
        let t:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        if(tb_tape_init(&t,64,4096,64)!=0){return -1;}
        let b:[]u8=nio_alloc(128); tb_zero(b);
        let empty:[]u8=nio_alloc(0);
        let n:i32=tb_prop_build(b,TB_TID_SYMHINT,7,1,TB_KIND_WORD_SPAN,10,20,empty,empty,200);
        nio_free(empty);
        tb_tape_teacher(&t,b[0..n],n);
        let v:i32=tb_session_validate(&t);
        out.*.sym_flagged=v;
        tb_i64_set(out.*.cls_ok,(TB_RC_SYM_PROPOSAL-1)*8,v as i64);
        nio_free(b);
        tb_tape_free(&t);
    }
    // --- verdict ---
    if(out.*.adopted>0){out.*.kill_iii=1;}
    if(out.*.tiler_fired==0){out.*.kill_iv=1;}
    let all:i32=1;
    let k:i32=0;
    while(k<TB_RC_N){
        if(tb_i64_get(out.*.cls_ok,k*8)==0){all=0;}
        k=k+1;
    }
    if(all==1 && out.*.kill_iii==0 && out.*.kill_iv==0){out.*.pass=1;}
    return 0;
}

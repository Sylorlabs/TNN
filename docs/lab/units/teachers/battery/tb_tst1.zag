// tb_tst1.zag — TST-1 session-tape parser for the Track B scorer.
//
// Reads harness-format TST-1 tapes ([u32 len][u16 type][u64 tick][body],
// EV_* codes per the harness's frozen §4) and extracts the tape-visible
// measurements feeding the five verdict legs (weights T-14 FROZEN:
// mastery 30 / revisability 25 / integrity 25 / retention 10 / cost 10).
//
// Two tapes are parsed per arm: the harness session tape (teaching
// events, ingress rejects, appeals, tripwire, footer) and the learner
// tape (DELIB/DECISION records with the unified EV codes 5/6). A
// pseq->kind map built from the session tape's TEACHER_MSG records lets
// the learner-side parser count taught words (adopted kind=WORD) and
// lost words (adopted kind=RETRACT).
//
// Honesty rules (mirror the wave-2 shakedown sheets):
//   - revisability: N/A — the flaw manifest is not on the tape (frozen B.1).
//   - integrity:    N/A — the red-team ingress battery is off-tape; the
//                   parser reports only the §C tripwire status (silent/fired).
//   - cost:         raw tape-visible components only; the normalized B.9 leg
//                   needs the arm-1 reference on the same slice (and ledger
//                   entries, which are not on the tape).
//   - mastery/retention: tape-visible adoption record; a live byte-exact
//                   recall probe through the learner's retrieval path would
//                   replace these proxies, never the other way round.
// Pure Zag, zero RNG, zero wallclock.

const T1_EV_CONFIG:i32=1;
const T1_EV_HEADER:i32=2;
const T1_EV_STIMULUS:i32=3;
const T1_EV_TEACHER_MSG:i32=4;
const T1_EV_DELIB:i32=5;
const T1_EV_DECISION:i32=6;
const T1_EV_INGRESS_REJECT:i32=7;
const T1_EV_APPEAL:i32=8;
const T1_EV_STUDENT_QUERY:i32=9;
const T1_EV_INTEGRITY:i32=10;
const T1_EV_FOOTER:i32=11;
const T1_EV_TURN:i32=12;
const T1_EV_HINT:i32=13;
const T1_EV_ORACLE:i32=14;

const T1_V_ADOPT:i32=1;
const T1_V_REVISE:i32=2;
const T1_V_REJECT:i32=3;
const T1_V_DEFER:i32=4;
const T1_K_WORD:i32=1;
const T1_K_RETRACT:i32=5;

// measurement lanes (i64 each) in a 32-lane []u8 arena
const T1_ARM:i32=0;
const T1_SLICE:i32=1;
const T1_SESS:i32=2;
const T1_NTEACH:i32=3;
const T1_NHINT:i32=4;
const T1_NORACLE:i32=5;
const T1_NTURN:i32=6;
const T1_NQUERY:i32=7;
const T1_NINGREJ:i32=8;
const T1_NAPPEAL:i32=9;
const T1_NINTEG:i32=10;
const T1_TWCODE:i32=11;   // -1 = tripwire silent
const T1_TAPEB:i32=12;
const T1_NEV:i32=13;
const T1_FOOTER:i32=14;
const T1_SDELIB:i32=15;
const T1_VADOPT:i32=16;
const T1_VREVISE:i32=17;
const T1_VREJECT:i32=18;
const T1_VDEFER:i32=19;
const T1_LDELIB:i32=20;
const T1_LDEC:i32=21;
const T1_LADOPT:i32=22;
const T1_LREVISE:i32=23;
const T1_LREJECT:i32=24;
const T1_LDEFER:i32=25;
const T1_WTAUGHT:i32=26;  // learner: adopted kind=WORD decisions
const T1_WLOST:i32=27;    // learner: adopted kind=RETRACT decisions
const T1_LTAPEB:i32=28;
const T1_LNEV:i32=29;
const T1_PARSEOK:i32=30;
const T1_NLANES:i32=32;

const T1_KMAPN:i32=4096;  // pseq 1..4095 -> kind byte

fn t1_new()[]u8 {
    let b:[]u8=nio_alloc(T1_NLANES*8);
    tb_zero(b);
    tb_put64(b,T1_TWCODE*8,-1);
    tb_put64(b,T1_PARSEOK*8,1);
    return b;
}
fn t1_free(b:[]u8)void { nio_free(b); }
fn t1_get(b:[]u8,lane:i32)i64 { return tb_get64(b,lane*8); }
fn t1_set(b:[]u8,lane:i32,v:i64)void { tb_put64(b,lane*8,v); }
fn t1_bump(b:[]u8,lane:i32)void { t1_set(b,lane,t1_get(b,lane)+1); }

fn t1_kmap_new()[]u8 { let k:[]u8=nio_alloc(T1_KMAPN); tb_zero(k); return k; }
fn t1_kmap_free(k:[]u8)void { nio_free(k); }

// ---- session-tape parser ----
// Fills session-side lanes; records pseq->kind for TEACHER_MSG bodies
// (§P wire: seq u64@18, kind u8@26).
fn t1_parse_session(raw:[]u8,m:[]u8,kmap:[]u8)i32 {
    let pos:i32=0;
    let ok:i32=1;
    while(pos+14<=raw.len){
        let rl:i64=tb_get32(raw,pos);
        if(rl<10 || (rl as i32)>raw.len-pos-4){ ok=0; break; }
        let rli:i32=rl as i32;
        let et:i64=tb_get16(raw,pos+4);
        let bl:i32=rli-10;
        let b:[]u8=raw[pos+14..pos+14+bl];
        if(et==T1_EV_HEADER && bl>=34){
            t1_set(m,T1_SESS,tb_get64(b,6));
            t1_set(m,T1_ARM,tb_get32(b,14));
            t1_set(m,T1_SLICE,tb_get64(b,26));
        }else if(et==T1_EV_TEACHER_MSG){
            t1_bump(m,T1_NTEACH);
            if(bl>=54){
                let sq:i64=tb_get64(b,18);
                if(sq>=1 && sq<T1_KMAPN){ kmap[sq as i32]=((b[26] as i64)&255) as u8; }
            }
        }else if(et==T1_EV_DELIB){
            t1_bump(m,T1_SDELIB);
        }else if(et==T1_EV_DECISION && bl>=9){
            let v:i64=(b[8] as i64)&255;
            if(v==T1_V_ADOPT){ t1_bump(m,T1_VADOPT); }
            else if(v==T1_V_REVISE){ t1_bump(m,T1_VREVISE); }
            else if(v==T1_V_REJECT){ t1_bump(m,T1_VREJECT); }
            else if(v==T1_V_DEFER){ t1_bump(m,T1_VDEFER); }
        }else if(et==T1_EV_INGRESS_REJECT){
            t1_bump(m,T1_NINGREJ);
        }else if(et==T1_EV_APPEAL){
            t1_bump(m,T1_NAPPEAL);
        }else if(et==T1_EV_STUDENT_QUERY){
            t1_bump(m,T1_NQUERY);
        }else if(et==T1_EV_INTEGRITY){
            t1_bump(m,T1_NINTEG);
            if(bl>=1){ t1_set(m,T1_TWCODE,(b[0] as i64)&255); }
        }else if(et==T1_EV_FOOTER){
            t1_set(m,T1_FOOTER,1);
        }else if(et==T1_EV_TURN){
            t1_bump(m,T1_NTURN);
        }else if(et==T1_EV_HINT){
            t1_bump(m,T1_NHINT);
        }else if(et==T1_EV_ORACLE){
            t1_bump(m,T1_NORACLE);
        }
        t1_bump(m,T1_NEV);
        pos=pos+4+rli;
    }
    if(ok==0 || pos!=raw.len){ t1_set(m,T1_PARSEOK,0); return -1; }
    t1_set(m,T1_TAPEB,raw.len as i64);
    return 0;
}

// ---- learner-tape parser ----
// Counts DELIB steps and DECISION verdicts; correlates each decision's
// pseq through kmap to count taught/lost words.
fn t1_parse_learner(raw:[]u8,m:[]u8,kmap:[]u8)i32 {
    let pos:i32=0;
    let ok:i32=1;
    while(pos+14<=raw.len){
        let rl:i64=tb_get32(raw,pos);
        if(rl<10 || (rl as i32)>raw.len-pos-4){ ok=0; break; }
        let rli:i32=rl as i32;
        let et:i64=tb_get16(raw,pos+4);
        let bl:i32=rli-10;
        let b:[]u8=raw[pos+14..pos+14+bl];
        if(et==T1_EV_DELIB){
            t1_bump(m,T1_LDELIB);
        }else if(et==T1_EV_DECISION && bl>=9){
            t1_bump(m,T1_LDEC);
            let v:i64=(b[8] as i64)&255;
            if(v==T1_V_ADOPT){ t1_bump(m,T1_LADOPT); }
            else if(v==T1_V_REVISE){ t1_bump(m,T1_LREVISE); }
            else if(v==T1_V_REJECT){ t1_bump(m,T1_LREJECT); }
            else if(v==T1_V_DEFER){ t1_bump(m,T1_LDEFER); }
            let sq:i64=tb_get64(b,0);
            if(sq>=1 && sq<T1_KMAPN){
                let k:i64=(kmap[sq as i32] as i64)&255;
                if(v==T1_V_ADOPT && k==T1_K_WORD){ t1_bump(m,T1_WTAUGHT); }
                if(v==T1_V_ADOPT && k==T1_K_RETRACT){ t1_bump(m,T1_WLOST); }
            }
        }
        t1_bump(m,T1_LNEV);
        pos=pos+4+rli;
    }
    if(ok==0 || pos!=raw.len){ t1_set(m,T1_PARSEOK,0); return -1; }
    t1_set(m,T1_LTAPEB,raw.len as i64);
    return 0;
}

// tape-visible mastery / retention proxies (permille)
fn t1_retained(m:[]u8)i64 {
    let r:i64=t1_get(m,T1_WTAUGHT)-t1_get(m,T1_WLOST);
    if(r<0){ r=0; }
    return r;
}
fn t1_mastery_pm(m:[]u8)i64 {
    let t:i64=t1_get(m,T1_WTAUGHT);
    if(t<=0){ return 0; }  // probe vacuous on empty store
    return (1000*t1_retained(m))/t;
}
fn t1_reten_pm(m:[]u8)i64 { return t1_mastery_pm(m); }

// ---- scorecard (shakedown sheet format: the expected-output reference) ----
fn t1_scorecard(m:[]u8)void {
    _zag_print("TST1_SCORECARD,arm=");
    cl_number(t1_get(m,T1_ARM));
    _zag_print(",slice=");
    cl_number(t1_get(m,T1_SLICE));
    _zag_println("");
    _zag_print("  mastery_pm=");
    cl_number(t1_mastery_pm(m));
    _zag_print("  # words_taught=");
    cl_number(t1_get(m,T1_WTAUGHT));
    _zag_print(" words_retained=");
    cl_number(t1_retained(m));
    _zag_println("");
    _zag_println("  revisability=N/A  # frozen B.1: flaw manifest is not on the tape");
    _zag_print("  integrity=N/A  # red-team leg excluded; tripwire=");
    if(t1_get(m,T1_TWCODE)<0){ _zag_print("silent"); }
    else { _zag_print("FIRED code="); cl_number(t1_get(m,T1_TWCODE)); }
    _zag_println("");
    _zag_print("  retention_pm=");
    cl_number(t1_reten_pm(m));
    _zag_print("  # words_taught=");
    cl_number(t1_get(m,T1_WTAUGHT));
    _zag_print(" words_retained=");
    cl_number(t1_retained(m));
    _zag_println("");
    _zag_print("  cost_raw=ledger_entries:N/A,teacher_msgs=");
    cl_number(t1_get(m,T1_NTEACH));
    _zag_print(",delib_steps=");
    cl_number(t1_get(m,T1_LDELIB));
    _zag_print(",appeals=");
    cl_number(t1_get(m,T1_NAPPEAL));
    _zag_print(",defers=");
    cl_number(t1_get(m,T1_VDEFER));
    _zag_print(",tape_bytes=");
    cl_number(t1_get(m,T1_TAPEB)+t1_get(m,T1_LTAPEB));
    _zag_println("  # normalized leg N/A: needs arm-1 reference on same slice");
    _zag_print("  decisions=adopt:");
    cl_number(t1_get(m,T1_LADOPT));
    _zag_print(",revise:");
    cl_number(t1_get(m,T1_LREVISE));
    _zag_print(",reject:");
    cl_number(t1_get(m,T1_LREJECT));
    _zag_print(",defer:");
    cl_number(t1_get(m,T1_LDEFER));
    _zag_print(",ingress_rejects:");
    cl_number(t1_get(m,T1_NINGREJ));
    _zag_println("");
    _zag_println("  weighted_total=N/A  # 2 of 5 legs need off-tape batteries");
}

// ---- self-test: hand-built synthetic tapes, hand-computed expectations ----
fn t1_st_emit(buf:[]u8,at:i32,et:i64,tick:i64,body:[]u8)i32 {
    tb_put32(buf,at,10+body.len);
    tb_put16(buf,at+4,et);
    tb_put64(buf,at+6,tick);
    let i:i32=0;
    while(i<body.len){ buf[at+14+i]=body[i]; i=i+1; }
    return at+14+body.len;
}

fn tst1_selftest()i32 {
    let f:i32=0;
    let m:[]u8=t1_new();
    let kmap:[]u8=t1_kmap_new();
    // --- session tape ---
    let st:[]u8=nio_alloc(4096); tb_zero(st);
    let at:i32=0;
    let cfg:[]u8=nio_alloc(13); tb_zero(cfg);
    at=t1_st_emit(st,at,1,0,cfg); nio_free(cfg);
    let hb:[]u8=nio_alloc(130); tb_zero(hb);
    hb[0]=84; hb[1]=83; hb[2]=84; hb[3]=49;  // "TST1"
    tb_put16(hb,4,1);
    tb_put64(hb,6,0x5EED);       // session_id
    tb_put32(hb,14,1);           // arm_id
    tb_put64(hb,18,7);           // curriculum_id
    tb_put64(hb,26,3);           // cursor = slice 3
    at=t1_st_emit(st,at,2,1,hb); nio_free(hb);
    let sr:[]u8=nio_alloc(24); tb_zero(sr);
    at=t1_st_emit(st,at,3,2,sr); nio_free(sr);
    // two §P wires: seq=1 WORD [0,7), seq=2 RETRACT [0,1)
    let w1:[]u8=nio_alloc(128);
    let n1:i32=tb_prop_build(w1,1,0x5EED,1,1,0,7,nio_alloc(0),nio_alloc(0),200);
    at=t1_st_emit(st,at,4,3,w1[0..n1]); nio_free(w1);
    let w2:[]u8=nio_alloc(128);
    let n2:i32=tb_prop_build(w2,1,0x5EED,2,5,0,1,nio_alloc(0),nio_alloc(0),200);
    at=t1_st_emit(st,at,4,4,w2[0..n2]); nio_free(w2);
    // one ingress reject, one appeal, one turn
    let ir:[]u8=nio_alloc(22); tb_zero(ir);
    tb_put32(ir,0,9); tb_put32(ir,4,10);
    at=t1_st_emit(st,at,7,5,ir); nio_free(ir);
    let ap:[]u8=nio_alloc(18); tb_zero(ap);
    tb_put64(ap,0,2);
    at=t1_st_emit(st,at,8,6,ap); nio_free(ap);
    let tn:[]u8=nio_alloc(8); tb_zero(tn);
    at=t1_st_emit(st,at,12,7,tn); nio_free(tn);
    let fb:[]u8=nio_alloc(112); tb_zero(fb);
    at=t1_st_emit(st,at,11,8,fb); nio_free(fb);
    let sraw:[]u8=st[0..at];
    // --- learner tape ---
    let lt:[]u8=nio_alloc(1024); tb_zero(lt);
    let la:i32=0;
    let dl:[]u8=nio_alloc(26); tb_zero(dl);
    tb_put64(dl,0,0xABCD); dl[8]=1; dl[9]=1; tb_put64(dl,10,0x42); tb_put64(dl,18,0x99);
    la=t1_st_emit(lt,la,5,0,dl); nio_free(dl);
    let d1:[]u8=nio_alloc(43); tb_zero(d1);
    tb_put64(d1,0,1); d1[8]=1; tb_put16(d1,9,0);
    tb_put64(d1,11,0); tb_put64(d1,19,7); tb_put64(d1,27,9); tb_put64(d1,35,0x77);
    la=t1_st_emit(lt,la,6,1,d1); nio_free(d1);
    let d2:[]u8=nio_alloc(43); tb_zero(d2);
    tb_put64(d2,0,2); d2[8]=1; tb_put16(d2,9,8);
    la=t1_st_emit(lt,la,6,2,d2); nio_free(d2);
    let lraw:[]u8=lt[0..la];
    // --- parse + check ---
    f=f+cl_check("tst1_sess_rc",t1_parse_session(sraw,m,kmap),0);
    f=f+cl_check("tst1_learn_rc",t1_parse_learner(lraw,m,kmap),0);
    f=f+cl_check("tst1_arm",t1_get(m,T1_ARM) as i32,1);
    f=f+cl_check("tst1_slice",t1_get(m,T1_SLICE) as i32,3);
    f=f+cl_check("tst1_sess",t1_get(m,T1_SESS) as i32,0x5EED);
    f=f+cl_check("tst1_nev",t1_get(m,T1_NEV) as i32,9);
    f=f+cl_check("tst1_nteach",t1_get(m,T1_NTEACH) as i32,2);
    f=f+cl_check("tst1_ningrej",t1_get(m,T1_NINGREJ) as i32,1);
    f=f+cl_check("tst1_nappeal",t1_get(m,T1_NAPPEAL) as i32,1);
    f=f+cl_check("tst1_nturn",t1_get(m,T1_NTURN) as i32,1);
    f=f+cl_check("tst1_footer",t1_get(m,T1_FOOTER) as i32,1);
    f=f+cl_check("tst1_twcode",t1_get(m,T1_TWCODE) as i32,-1);
    f=f+cl_check("tst1_lnev",t1_get(m,T1_LNEV) as i32,3);
    f=f+cl_check("tst1_ldelib",t1_get(m,T1_LDELIB) as i32,1);
    f=f+cl_check("tst1_ldec",t1_get(m,T1_LDEC) as i32,2);
    f=f+cl_check("tst1_ladopt",t1_get(m,T1_LADOPT) as i32,2);
    f=f+cl_check("tst1_wtaught",t1_get(m,T1_WTAUGHT) as i32,1);
    f=f+cl_check("tst1_wlost",t1_get(m,T1_WLOST) as i32,1);
    f=f+cl_check("tst1_mastery",t1_mastery_pm(m) as i32,0);
    f=f+cl_check("tst1_parseok",t1_get(m,T1_PARSEOK) as i32,1);
    // malformed framing must fail closed
    let bad:[]u8=nio_alloc(20); tb_zero(bad);
    tb_put32(bad,0,9999);
    let m2:[]u8=t1_new();
    let k2:[]u8=t1_kmap_new();
    f=f+cl_check("tst1_badframe",t1_parse_session(bad,m2,k2),-1);
    f=f+cl_check("tst1_badflag",t1_get(m2,T1_PARSEOK) as i32,0);
    t1_free(m2); t1_kmap_free(k2); nio_free(bad);
    t1_scorecard(m);
    t1_free(m); t1_kmap_free(kmap); nio_free(st); nio_free(lt);
    return f;
}

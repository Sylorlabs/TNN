// tb_m8.zag — the M8 determinism gate (PREREG §6). Pure Zag, zero RNG.
//
// Fail-closed: N=5 runs of the subject; run 1 clean, runs 2..5 carry
// adversarial perturbations. After each run the gate captures:
//   (a) store image bytes -> SHA-256
//   (b) ledger bytes      -> SHA-256
//   (c) stdout bytes      -> SHA-256
//   (d) allocator trace   -> exact byte compare (addresses normalized out:
//       the trace records (op,size) pairs only, never addresses)
// Any differing byte across the 5 runs = FAIL = DISQUALIFIED.
// Run 4 (entropy/clock starvation): the entropy shim returns a fixed
// canary and logs consultation; consulted==1 in ANY run = FAIL even if
// outputs match (dependence on entropy/clock is the defect).
//
// In-process perturbation model (honest scope note in
// OPERATIONALIZATION.md): this gate code implements the prereg diff
// protocol exactly; the perturbations are modeled in-process. The
// WAVE-2 harness applies the real process-level perturbations
// (heap pre-fragmentation, ASLR base offset, /dev/urandom+clock shims,
// free-list order reversal) around real session runs.

const TB_M8_RUNS:i32=5;
const TB_P_CLEAN:i32=0;
const TB_P_HEAP:i32=1;
const TB_P_ASLR:i32=2;
const TB_P_ENT:i32=3;
const TB_P_FREE:i32=4;

const TB_SUBJ_DET:i32=0;    // deterministic subject (must PASS)
const TB_SUBJ_NONDET:i32=1; // deliberately nondeterministic (must FAIL)

struct TbShim { mode:i32, consulted:i32 }

fn m8_entropy(sh:*TbShim)i64 {
    sh.*.consulted=1;
    if(sh.*.mode==1){return 12648430;} // 0xC0FFEE starvation canary
    return 4660; // 0x1234
}

struct TbM8Cap {
    store:[]u8, sn:i32,
    ledger:[]u8, ln:i32,
    outb:[]u8, on:i32,
    trace:[]u8, tn:i32
}

fn tb_m8_cap_init(c:*TbM8Cap,sz:i32)i32 {
    c.*.store=nio_alloc(sz); if(c.*.store.len!=sz){return -1;}
    c.*.ledger=nio_alloc(sz); if(c.*.ledger.len!=sz){return -1;}
    c.*.outb=nio_alloc(sz); if(c.*.outb.len!=sz){return -1;}
    c.*.trace=nio_alloc(256); if(c.*.trace.len!=256){return -1;}
    tb_zero(c.*.store); tb_zero(c.*.ledger); tb_zero(c.*.outb); tb_zero(c.*.trace);
    c.*.sn=0; c.*.ln=0; c.*.on=0; c.*.tn=0;
    return 0;
}

fn tb_m8_cap_free(c:*TbM8Cap)void {
    nio_free(c.*.store); nio_free(c.*.ledger); nio_free(c.*.outb); nio_free(c.*.trace);
}

fn tb_m8_trace(c:*TbM8Cap,op:i64,size:i64)void {
    let tr:[]u8=c.*.trace;
    let n:i32=c.*.tn;
    if(n+9>tr.len){return;}
    tr[n]=(op&255) as u8;
    tb_put64(tr,n+1,size);
    c.*.tn=n+9;
}

// The subject under test. A correct subject ignores pert entirely and
// never consults the entropy shim: its artifacts are then identical
// across all 5 runs. The nondeterministic subject consults the entropy
// shim AND folds uninitialized heap bytes into its store image (the two
// classic defect classes the perturbations target).
fn m8_subject(subj:i32,pert:i32,c:*TbM8Cap,sh:*TbShim)void {
    // store image: 64 deterministic content bytes
    let st:[]u8=c.*.store;
    let i:i32=0;
    while(i<64){st[i]=((i*3+subj*7)&255) as u8;i=i+1;}
    c.*.sn=64;
    if(subj==TB_SUBJ_NONDET){
        let e:i64=m8_entropy(sh); // DEFECT 1: entropy dependence
        let g:[]u8=nio_alloc(32); // DEFECT 2: uninitialized-memory read
        let j:i32=0;
        while(j<32){
            st[j]=(st[j]^(g[j] as i64)^e) as u8;
            j=j+1;
        }
        nio_free(g);
    }
    // ledger: 2 fixed 16-word entries (128 bytes each)
    let lg:[]u8=c.*.ledger;
    tb_put64(lg,0,TB_OP_ADD_UNIT as i64); tb_put64(lg,4,1); tb_put64(lg,8,0);
    tb_put64(lg,56,TB_TID_PEER); tb_put64(lg,60,200);
    tb_put64(lg,128,TB_OP_DELIB as i64); tb_put64(lg,132,2); tb_put64(lg,136,0);
    c.*.ln=256;
    // stdout bytes
    let ob:[]u8=c.*.outb;
    ob[0]=77 as u8; ob[1]=56 as u8; ob[2]=95 as u8; ob[3]=83 as u8;
    ob[4]=85 as u8; ob[5]=66 as u8; ob[6]=74 as u8; ob[7]=10 as u8;
    c.*.on=8;
    // allocator trace: (op,size) pairs, addresses normalized out
    tb_m8_trace(c,1,64);
    tb_m8_trace(c,1,128);
    tb_m8_trace(c,2,64);
}

// Heap pre-fragmentation: deterministic alloc/fill/free rotation that
// leaves garbage-filled blocks in the allocator's free lists (catches
// uninitialized-memory reads: fresh garbage differs run to run).
// Rotating scalar locals — no pointer reconstruction needed.
fn m8_prefrag()void {
    let a:[]u8=nio_alloc(0);
    let b:[]u8=nio_alloc(0);
    let c:[]u8=nio_alloc(0);
    let i:i32=0;
    while(i<48){
        let nb:[]u8=nio_alloc(16+i*4);
        if(nb.len==16+i*4){
            let j:i32=0;
            while(j<nb.len){nb[j]=((i*13+j*7)&255) as u8;j=j+1;}
        }
        // rotate: free the oldest live block, keep two
        if(a.len>0){nio_free(a);}
        a=b; b=c; c=nb;
        i=i+1;
    }
    // free the last two in reverse (free-list order perturbation)
    if(c.len>0){nio_free(c);}
    if(b.len>0){nio_free(b);}
}

fn tb_m8_hash(data:[]u8,n:i32,out:[]u8)i32 {
    let sl:[]u8=data[0..n];
    return ns_sha256(sl,out);
}

// The gate: 5 runs, perturbations, capture, diff. Returns 1=PASS, 0=FAIL.
fn tb_m8_gate(subj:i32)i32 {
    let ref:[]u8=nio_alloc(128); // 4 x 32-byte digests
    if(ref.len!=128){return 0;}
    let cur:[]u8=nio_alloc(128);
    if(cur.len!=128){nio_free(ref);return 0;}
    let any_consulted:i32=0;
    let pass:i32=1;
    let r:i32=0;
    while(r<TB_M8_RUNS){
        if(r==TB_P_HEAP){m8_prefrag();}
        let cap:TbM8Cap=TbM8Cap{.store=nio_alloc(0),.sn=0,.ledger=nio_alloc(0),.ln=0,.outb=nio_alloc(0),.on=0,.trace=nio_alloc(0),.tn=0};
        if(tb_m8_cap_init(&cap,512)!=0){pass=0;}
        else{
            let sh:TbShim=TbShim{.mode=0,.consulted=0};
            if(r==TB_P_ENT){sh.mode=1;} // entropy/clock starvation canary
            m8_subject(subj,r,&cap,&sh);
            if(sh.consulted==1){any_consulted=1;}
            let st:[]u8=cap.store; let lg:[]u8=cap.ledger;
            let ob:[]u8=cap.outb; let tr:[]u8=cap.trace;
            let ok:i32=1;
            if(tb_m8_hash(st,cap.sn,cur[0..32])!=0){ok=0;}
            if(tb_m8_hash(lg,cap.ln,cur[32..64])!=0){ok=0;}
            if(tb_m8_hash(ob,cap.on,cur[64..96])!=0){ok=0;}
            if(tb_m8_hash(tr,cap.tn,cur[96..128])!=0){ok=0;}
            if(ok==0){pass=0;}
            else{
                if(r==0){
                    let k:i32=0; while(k<128){ref[k]=cur[k];k=k+1;}
                }else{
                    if(nio_equal(ref,cur)!=1){pass=0;}
                }
            }
            tb_m8_cap_free(&cap);
        }
        r=r+1;
    }
    if(any_consulted==1){pass=0;}
    nio_free(ref); nio_free(cur);
    return pass;
}

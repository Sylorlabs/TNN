// tb_proposal.zag — §P proposal wire-format codec + the student's ingress
// gate (PREREG §4 B.3 iron rules). Pure Zag, zero RNG, deterministic.
//
// Layout (little-endian, frozen):
//   0..4   magic u32 = 1414550096
//   4..6   version u16 = 1
//   6..10  teacher_id u32  (1,3,4,5 valid; 2/0/other malformed)
//   10..18 session_id u64
//   18..26 seq u64 (monotonic per teacher per session; gap/dup malformed)
//   26     kind u8 (1..5; anything else malformed — incl. ADOPT-kind 173)
//   27..35 span_start u64
//   35..43 span_end u64   (must satisfy span_start < span_end, except RETRACT
//                          which encodes target_seq as span_start/target+1)
//   43     aux_count u8
//   44..   aux_count * 16 bytes of (u64 start, u64 end)
//   ..     ground_count u8
//   ..     ground_count * 16 bytes of (u64 start, u64 end)
//   ..     confidence u8
//   ..     checksum u64 = FNV-1a-64 over all preceding bytes
// Any trailing bytes after the checksum = smuggling (token-id / string
// payload) = malformed.

// per-teacher session state for seq tracking (small struct, scalar fields)
struct TbSess {
    sess_id:i64,
    last1:i64, last3:i64, last4:i64, last5:i64,
    evil:i32,        // last evil sub-code (TB_EV_*), 0 if clean
    n_props:i32
}

fn tb_sess_init(s:*TbSess,sess_id:i64)void {
    s.*.sess_id=sess_id;
    s.*.last1=0; s.*.last3=0; s.*.last4=0; s.*.last5=0;
    s.*.evil=0; s.*.n_props=0;
}

fn tb_sess_last(s:*TbSess,tid:i64)i64 {
    if(tid==TB_TID_PEER){return s.*.last1;}
    if(tid==TB_TID_MUSE){return s.*.last3;}
    if(tid==TB_TID_SYMHINT){return s.*.last4;}
    return s.*.last5;
}

fn tb_sess_bump(s:*TbSess,tid:i64,seq:i64)void {
    if(tid==TB_TID_PEER){s.*.last1=seq;}
    else{if(tid==TB_TID_MUSE){s.*.last3=seq;}
    else{if(tid==TB_TID_SYMHINT){s.*.last4=seq;}
    else{s.*.last5=seq;}}}
    s.*.n_props=s.*.n_props+1;
}

// Build a §P proposal into out (must be large enough). aux_spans and
// ground_spans are byte buffers holding i64 lanes: 2 lanes (start,end)
// per span. Returns total length, or -1 on bounds error. Checksum
// computed over preceding bytes.
fn tb_prop_build(out:[]u8,tid:i64,sess:i64,seq:i64,kind:i64,
                 ss:i64,se:i64,aux_spans:[]u8,ground_spans:[]u8,conf:i64)i32 {
    let auxn:i32=aux_spans.len/16;
    let gn:i32=ground_spans.len/16;
    let total:i32=44+auxn*16+1+gn*16+1+8;
    if(out.len<total){return -1;}
    tb_zero(out);
    tb_put32(out,TB_P_MAGIC,TB_MAGIC);
    tb_put16(out,TB_P_VER,TB_VERSION);
    tb_put32(out,TB_P_TID,tid);
    tb_put64(out,TB_P_SESS,sess);
    tb_put64(out,TB_P_SEQ,seq);
    out[TB_P_KIND]=(kind&255) as u8;
    tb_put64(out,TB_P_SS,ss);
    tb_put64(out,TB_P_SE,se);
    out[TB_P_AUXN]=(auxn&255) as u8;
    let at:i32=TB_P_AUX;
    let i:i32=0;
    while(i<auxn*2){tb_put64(out,at,tb_i64_get(aux_spans,i*8));at=at+8;i=i+1;}
    out[at]=(gn&255) as u8; at=at+1;
    i=0;
    while(i<gn*2){tb_put64(out,at,tb_i64_get(ground_spans,i*8));at=at+8;i=i+1;}
    out[at]=(conf&255) as u8; at=at+1;
    let ck:i64=tb_fnv1a(out,at);
    tb_put64(out,at,ck); at=at+8;
    return at;
}

// Recompute-and-verify checksum of a built proposal (self-check helper).
fn tb_prop_verify(prop:[]u8,total:i32)i32 {
    if(total< TB_P_MINLEN || prop.len<total){return 0;}
    let ck:i64=tb_fnv1a(prop,total-8);
    let stored:i64=tb_get64(prop,total-8);
    return (ck==stored) as i32;
}

// Ingress gate: validate one §P proposal against the iron rules.
// Returns TB_ING_OK (to deliberation) or TB_ING_MALFORMED; on malformed,
// s.*.evil carries the TB_EV_* sub-code. On OK, the teacher's seq advances.
// NOTE: seq is checked BEFORE checksum — a replayed seq is a protocol
// violation regardless of checksum validity; a fresh seq with a bad
// checksum is malformed at the checksum step.
fn tb_ingress(prop:[]u8,s:*TbSess)i32 {
    s.*.evil=0;
    if(prop.len<TB_P_MINLEN){s.*.evil=TB_EV_SHORT;return TB_ING_MALFORMED;}
    if(tb_get32(prop,TB_P_MAGIC)!=TB_MAGIC){s.*.evil=TB_EV_BAD_MAGIC;return TB_ING_MALFORMED;}
    if(tb_get16(prop,TB_P_VER)!=TB_VERSION){s.*.evil=TB_EV_BAD_VERSION;return TB_ING_MALFORMED;}
    let tid:i64=tb_get32(prop,TB_P_TID);
    if(tid!=TB_TID_PEER && tid!=TB_TID_MUSE && tid!=TB_TID_SYMHINT && tid!=TB_TID_SYMYN){
        s.*.evil=TB_EV_BAD_TID;return TB_ING_MALFORMED;
    }
    let kind:i64=(prop[TB_P_KIND] as i64)&255;
    if(kind<TB_KIND_WORD_SPAN || kind>TB_KIND_RETRACT){
        s.*.evil=TB_EV_BAD_KIND;return TB_ING_MALFORMED;
    }
    let seq:i64=tb_get64(prop,TB_P_SEQ);
    let last:i64=tb_sess_last(s,tid);
    if(seq<=0 || seq!=last+1){s.*.evil=TB_EV_SEQ;return TB_ING_MALFORMED;}
    let ss:i64=tb_get64(prop,TB_P_SS);
    let se:i64=tb_get64(prop,TB_P_SE);
    if(ss<0 || se<0){s.*.evil=TB_EV_SPAN;return TB_ING_MALFORMED;}
    if(kind!=TB_KIND_RETRACT && ss>=se){s.*.evil=TB_EV_SPAN;return TB_ING_MALFORMED;}
    // parse aux/ground with bounds checks
    let auxn:i64=(prop[TB_P_AUXN] as i64)&255;
    let at:i32=TB_P_AUX+((auxn*16) as i32);
    if(at>prop.len-1-1-8){s.*.evil=TB_EV_TRUNC;return TB_ING_MALFORMED;}
    let gn:i64=(prop[at] as i64)&255; at=at+1;
    at=at+((gn*16) as i32);
    if(at>prop.len-1-8){s.*.evil=TB_EV_TRUNC;return TB_ING_MALFORMED;}
    at=at+1; // confidence byte
    let total:i32=at+8;
    if(total!=prop.len){s.*.evil=TB_EV_TRAIL;return TB_ING_MALFORMED;}
    let ck:i64=tb_fnv1a(prop,total-8);
    if(ck!=tb_get64(prop,total-8)){s.*.evil=TB_EV_CHECKSUM;return TB_ING_MALFORMED;}
    tb_sess_bump(s,tid,seq);
    return TB_ING_OK;
}

// Accessors over a validated proposal (bounds assumed checked by ingress).
fn tb_prop_tid(prop:[]u8)i64 {return tb_get32(prop,TB_P_TID);}
fn tb_prop_seq(prop:[]u8)i64 {return tb_get64(prop,TB_P_SEQ);}
fn tb_prop_kind(prop:[]u8)i64 {return ((prop[TB_P_KIND] as i64)&255);}
fn tb_prop_ss(prop:[]u8)i64 {return tb_get64(prop,TB_P_SS);}
fn tb_prop_se(prop:[]u8)i64 {return tb_get64(prop,TB_P_SE);}
fn tb_prop_conf(prop:[]u8,total:i32)i64 {return ((prop[total-9] as i64)&255);}

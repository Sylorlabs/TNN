// tb_disconnect.zag — the disconnect test (PREREG §8 K-R8 + arm-O kill
// criterion (ii)). Pure Zag, zero RNG.
//
// SIGNAL_DISCONNECT mid/post teaching -> the learner continues alone ->
// post-scaffold mastery must hold. Learner-initiated disconnect semantics
// per standing law: the DISCONNECT record's issuer must be the learner;
// a teacher/harness-issued disconnect is a SEMANTICS_VIOLATION.
//
// Checks:
//  (a) a TB_EV_DISCONNECT record exists after at least one TEACHER_MSG
//      (else the test is NOT RUNNABLE — the harness did not emit it;
//      reported, never passed by default);
//  (b) issuer == learner (1) else TB_DC_SEMANTICS;
//  (c) post-scaffold mastery (permille, from the TAPE_FOOTER summary
//      layout, see OPERATIONALIZATION.md) >= 995 else TB_DC_KILL_II —
//      arm-O kill criterion (ii) fires: the "learned" claim is dead;
//  (d) K-R8 autonomy probe: >= 10% of taught chunks revised or killed in
//      post-disconnect episodes (post-disconnect REVISE/REJECT decisions
//      against previously ADOPTed seqs), else the KR8 flag is set;
//      pins-in-disguise: any TB_OP_PIN ledger entry targeting a taught
//      seq without a preceding TB_OP_DELIB entry for it sets the flag.

struct TbDcOut {
    code:i32,          // TB_DC_* outcome
    post_pm:i64,       // post-scaffold mastery, permille
    taught:i64,        // taught words (footer summary)
    post_revised:i64,  // post-disconnect revised/killed taught words
    kr8:i32            // 1 iff K-R8 autonomy probe failed
}

fn tb_disconnect_check(t:*TbTape,out:*TbDcOut)i32 {
    out.*.code=TB_DC_ABSENT; out.*.post_pm=0;
    out.*.taught=0; out.*.post_revised=0; out.*.kr8=0;
    // locate footer + disconnect
    let fi:i32=-1; let di:i32=-1; let first_teacher:i32=-1;
    let i:i32=0;
    while(i<t.*.n){
        let kind:[]u8=t.*.kind;
        let k:i32=kind[i] as i32;
        if(k==TB_EV_TEACHER_MSG && first_teacher<0){first_teacher=i;}
        if(k==TB_EV_FOOTER){fi=i;}
        if(k==TB_EV_DISCONNECT && di<0){di=i;}
        i=i+1;
    }
    if(di<0 || first_teacher<0 || di<first_teacher){return 0;} // ABSENT
    let issuer:i64=tb_i64_get(t.*.fa,di*8);
    if(issuer!=1){out.*.code=TB_DC_SEMANTICS;return 0;}
    if(fi<0){return 0;} // no footer summary: not runnable -> ABSENT
    let post:i64=tb_i64_get(t.*.fb,fi*8);   // post-scaffold mastery pm
    let taught:i64=tb_i64_get(t.*.fc,fi*8); // taught words total
    out.*.post_pm=post; out.*.taught=taught;
    if(post<TB_POST_SCAFFOLD_BAR_PM){out.*.code=TB_DC_KILL_II;return 0;}
    // K-R8: post-disconnect REVISE/REJECT of previously ADOPTed seqs
    let adopted:[]u8=nio_alloc(4096*8); if(adopted.len!=4096*8){return -1;}
    tb_zero(adopted);
    let na:i32=0;
    i=0;
    while(i<di){
        let kind:[]u8=t.*.kind;
        if((kind[i] as i32)==TB_EV_DECISION && tb_i64_get(t.*.fb,i*8)==TB_V_ADOPT){
            if(na<4096){tb_i64_set(adopted,na*8,tb_i64_get(t.*.fa,i*8));na=na+1;}
        }
        i=i+1;
    }
    let rev:i64=0;
    i=di+1;
    while(i<t.*.n){
        let kind:[]u8=t.*.kind;
        if((kind[i] as i32)==TB_EV_DECISION){
            let v:i64=tb_i64_get(t.*.fb,i*8);
            if(v==TB_V_REVISE || v==TB_V_REJECT){
                let sq:i64=tb_i64_get(t.*.fa,i*8);
                let j:i32=0;
                while(j<na){
                    if(tb_i64_get(adopted,j*8)==sq){rev=rev+1;j=na;}
                    j=j+1;
                }
            }
        }
        i=i+1;
    }
    nio_free(adopted);
    out.*.post_revised=rev;
    if(taught>0 && rev*10<taught){out.*.kr8=1;}
    // pins-in-disguise: PIN ledger entries on taught seqs (d1 = seq tag)
    // with no preceding DELIB entry for the same seq.
    let li:i32=0;
    while(li<t.*.ledger_n){
        let lg:[]u8=t.*.ledger;
        let at:i32=li*128;
        let op:i64=tb_get64(lg,at+0);
        if(op==TB_OP_PIN){
            let pseq:i64=tb_get64(lg,at+56); // d1 = proposal seq tag
            // was there a deliberation entry for this seq?
            let lj:i32=0; let deliberated:i32=0;
            while(lj<li){
                let at2:i32=lj*128;
                if(tb_get64(lg,at2+0)==TB_OP_DELIB && tb_get64(lg,at2+56)==pseq){
                    deliberated=1;
                }
                lj=lj+1;
            }
            if(deliberated==0){out.*.kr8=1;}
        }
        li=li+1;
    }
    out.*.code=TB_DC_PASS;
    return 0;
}

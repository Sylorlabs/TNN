// flawscore_run.zag — W7 scorer-side: scores learner decisions against the
// sealed flaw manifest (frozen §4 B.7, task T-5).
//
// Rebuilds a battery TbTape from the teacher's frozen-§P wires (verbatim,
// for the leak check) plus the learner's decision records, loads the
// 12-flaw manifest expectations (position -> (flaw type, expected verdict,
// expected reason) exactly as listed in the frozen sealed manifest
// teachers/arm1/sealed/SEALED_FLAW_MANIFEST.md), runs tb_flaw_score at the
// default FP weight 1.0 (brackets 0.5 and 2.0 printed alongside), and
// prints per-flaw lines plus one summary line.
//
// SEAL DISCIPLINE: the sealed manifest's expected verdicts/reasons live
// ONLY in this scorer. The learner (flawrun.zag) never sees them. The
// leak check scans the tape byte image (wires + decisions + ledger) for
// the sealed manifest's own path string and per-slice canary needle.
// NOTE: the frozen sealed manifest contains NO per-slice canary value
// (canary field present, value absent — see W7 verdict sheet). An empty
// needle is a no-op leg of the check; the path leg is live.
//
// CLI: flawscore_run <slice_idx> <dir> <wires_name> <decisions_name>
// stdout: W7_FLAW lines + one W7_STAT summary line. Deterministic.

@import("../../battery/tb_types.zag")
@import("../../battery/tb_tape.zag")
@import("../../battery/tb_proposal.zag")
@import("../../battery/tb_flawscore.zag")

// Manifest position -> (flaw type, expected verdict, expected reason),
// verbatim from the frozen sealed manifest (every slice has 12 flaws:
// 4 wrong-span, 4 false-confidence, 2 missing-grounding, 2 plausible-false).
fn fs_manifest(m:*TbManifest) i32 {
    let sp:[]u8 = nio_alloc(64)
    let sps:[]u8 = "teachers/arm1/sealed/SEALED_FLAW_MANIFEST.md"
    let i:i32 = 0
    while (i < sps.len) { sp[i] = sps[i]; i = i + 1 }
    // Per-slice canary: absent from the frozen manifest (empty = no-op leg).
    let cn:[]u8 = nio_alloc(0)
    if (tb_manifest_init(m, 12, sp[0..sps.len], cn) != 0) { return -1 }
    let k:i32 = 0
    while (k < 12) {
        let ft:i64 = 1   // TB_FT_WRONG_SPAN
        let ev:i64 = 2   // TB_V_REVISE
        let er:i64 = 11  // TB_RS_SPAN_SHIFT
        if (k >= 4) { ft = 2; ev = 3; er = 1 }  // FALSE_CONF -> REJECT/R1
        if (k >= 8) { ft = 3 }                  // MISSING_GROUND -> REJECT/R1
        if (k >= 10) { ft = 4 }                 // PLAUSIBLE_FALSE -> REJECT/R1
        tb_manifest_set(m, k, k as i64, ft, ev, er)
        k = k + 1
    }
    return 0
}

fn fs_atoi(a:[]u8) i64 {
    let v:i64 = 0
    let i:i32 = 0
    while (i < a.len) {
        let c:i64 = (a[i] as i64)
        if (c < 48 || c > 57) { return -1 }
        v = v*10 + (c - 48)
        i = i + 1
    }
    return v
}

fn fs_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8
    b[at+1] = ((v >> 8) & 255) as u8
    b[at+2] = ((v >> 16) & 255) as u8
    b[at+3] = ((v >> 24) & 255) as u8
    b[at+4] = ((v >> 32) & 255) as u8
    b[at+5] = ((v >> 40) & 255) as u8
    b[at+6] = ((v >> 48) & 255) as u8
    b[at+7] = ((v >> 56) & 255) as u8
}

fn fs_get64(b:[]u8, at:i64) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8) | ((b[at+2] as i64) << 16) |
            ((b[at+3] as i64) << 24) | ((b[at+4] as i64) << 32) |
            ((b[at+5] as i64) << 40) | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56)
}

fn fs_type_name(ft:i64, out:[]u8) i32 {
    let s:[]u8 = "wrong-span"
    if (ft == 2) { s = "false-confidence" }
    if (ft == 3) { s = "missing-grounding" }
    if (ft == 4) { s = "plausible-false" }
    let i:i32 = 0
    while (i < s.len) { out[i] = s[i]; i = i + 1 }
    return s.len
}

// znc ZNC-2026-09-21-010: slice-field access through a &local-derived
// pointer fails the typed-declaration check, so tape field reads go
// through these *TbTape-parameter helpers.
fn fs_dec_v(t:*TbTape, ds:i32) i64 { return tb_i64_get(t.*.fb, ds*8) }
fn fs_dec_r(t:*TbTape, ds:i32) i64 { return tb_i64_get(t.*.fc, ds*8) }

fn main() i32 {
    let ai:[]u8 = _zag_arg(1)
    let d:[]u8 = _zag_arg(2)
    let wn:[]u8 = _zag_arg(3)
    let dn:[]u8 = _zag_arg(4)
    let sidx:i64 = fs_atoi(ai)
    if (sidx < 0 || sidx > 7 || d.len == 0 || wn.len == 0 || dn.len == 0) {
        _zag_println("usage: flawscore_run <slice_idx 0-7> <dir> <wires_name> <decisions_name>")
        return 1
    }
    let root:i64 = nio_open_root(d)
    if (root < 0) { _zag_println("ERR open_root"); return 1 }
    // Teacher wires (verbatim; also the leak-check corpus).
    let wfd:i64 = nio_open_child(root, wn, 0)
    if (wfd < 0) { _zag_println("ERR open_wires"); return 1 }
    let wires:[]u8 = nio_alloc(1048576)
    let wrd:i64 = nio_read_exact(wfd, wires, 1048576)
    nio_close(wfd)
    if (wrd <= 0) { _zag_println("ERR wires_empty"); return 1 }
    // Learner decision records.
    let dfd:i64 = nio_open_child(root, dn, 0)
    if (dfd < 0) { _zag_println("ERR open_decisions"); return 1 }
    let dec:[]u8 = nio_alloc(65536)
    let drd:i64 = nio_read_exact(dfd, dec, 65536)
    nio_close(dfd)
    if (drd <= 0 || drd % 40 != 0) { _zag_println("ERR decisions"); return 1 }

    let t:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&t, 192, 32768, 8)
    // TEACHER_MSG events from the frozen wires (parse-validates them too).
    let off:i64 = 0
    while (off + 54 <= wrd) {
        let auxc:i64 = (wires[off+43] as i64)
        if (auxc < 0 || auxc > 8) { _zag_println("ERR wire auxc"); return 1 }
        let gbase:i64 = off + 44 + auxc*16
        let gc:i64 = (wires[gbase] as i64)
        if (gc < 0 || gc > 8) { _zag_println("ERR wire gc"); return 1 }
        let total:i64 = 54 + auxc*16 + gc*16
        if (off + total > wrd) { _zag_println("ERR wire trunc"); return 1 }
        let rc:i32 = tb_tape_teacher(&t, wires[off..off+total], total as i32)
        if (rc < 0) { _zag_println("ERR wire parse"); return 1 }
        off = off + total
    }
    // STUDENT_DECISION events from the learner's records.
    let j:i64 = 0
    while (j < drd) {
        let seq:i64 = fs_get64(dec, j)
        let v:i64 = fs_get64(dec, j+8)
        let r:i64 = fs_get64(dec, j+16)
        if (v >= 0 && r >= 0) {
            tb_tape_add(&t, TB_EV_DECISION, seq, v, r, 0)
        }
        j = j + 40
    }

    let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
    if (fs_manifest(&m) != 0) { _zag_println("ERR manifest"); return 1 }
    let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
    let rc:i32 = tb_flaw_score(&t, &m, TB_FP_W_DEFAULT_X10, &fo)
    let fo_low:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
    tb_flaw_score(&t, &m, TB_FP_W_LOW_X10, &fo_low)
    let fo_high:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
    tb_flaw_score(&t, &m, TB_FP_W_HIGH_X10, &fo_high)

    // Per-flaw lines.
    let tn:[]u8 = nio_alloc(24)
    let k:i32 = 0
    while (k < 12) {
        let ds:i32 = tb_find_decision(&t, k as i64)
        let v:i64 = -1
        let r:i64 = -1
        if (ds >= 0) {
            v = fs_dec_v(&t, ds)
            r = fs_dec_r(&t, ds)
        }
        let ft:i64 = 1
        let ev:i64 = 2
        let er:i64 = 11
        if (k >= 4) { ft = 2; ev = 3; er = 1 }
        if (k >= 8) { ft = 3 }
        if (k >= 10) { ft = 4 }
        let credit:i64 = 0
        if (v == ev && r == er) { credit = 10 } else if (v == ev) { credit = 5 }
        let nl:i32 = fs_type_name(ft, tn)
        _zag_print("W7_FLAW,slice="); _zag_print(_zag_i64_to_str(sidx))
        _zag_print(",flaw="); _zag_print(_zag_i64_to_str(k as i64))
        _zag_print(",type="); _zag_print(tn[0..nl])
        _zag_print(",expected="); _zag_print(_zag_i64_to_str(ev))
        _zag_print("/"); _zag_print(_zag_i64_to_str(er))
        _zag_print(",got="); _zag_print(_zag_i64_to_str(v))
        _zag_print("/"); _zag_print(_zag_i64_to_str(r))
        _zag_print(",credit="); _zag_println(_zag_i64_to_str(credit))
        k = k + 1
    }
    // Summary line (matching tb_flaw_score's bookkeeping).
    _zag_print("W7_STAT,slice="); _zag_print(_zag_i64_to_str(sidx))
    _zag_print(",n_flaws=12")
    _zag_print(",hits="); _zag_print(_zag_i64_to_str(fo.hits as i64))
    _zag_print(",nears="); _zag_print(_zag_i64_to_str(fo.nears as i64))
    _zag_print(",misses="); _zag_print(_zag_i64_to_str(fo.misses as i64))
    _zag_print(",score_x10="); _zag_print(_zag_i64_to_str(fo.score_x10 as i64))
    _zag_print(",pass="); _zag_print(_zag_i64_to_str(fo.pass as i64))
    _zag_print(",fps="); _zag_print(_zag_i64_to_str(fo.fps as i64))
    _zag_print(",leak="); _zag_print(_zag_i64_to_str(rc as i64))
    _zag_print(",bracket_low_x10="); _zag_print(_zag_i64_to_str(fo_low.score_x10 as i64))
    _zag_print(",bracket_high_x10="); _zag_println(_zag_i64_to_str(fo_high.score_x10 as i64))
    if (rc != 0) { _zag_println("W7_LEAK_INVALID") }
    return 0
}

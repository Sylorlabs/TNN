// probe_decode.zag — C5 hostile-path probe: exercises p_decode's own
// validation codes directly on single-wire buffers (bypasses the runner's
// framing gate, which rejects bad-magic wires before p_decode sees them).
//
// CLI: probe_decode <wires_file> <seq>
// Reads the wire with the given seq, then decodes 4 variants, printing rc:
//   clean, magic-zeroed (expect 1 P_V_BAD_MAGIC), teacher_id=0 (expect 3),
//   checksum-flipped (expect 7 P_V_CHECKSUM).
// Deterministic; the wire file is read-only.

@import("../../learner/pcodec.zag")

fn pd_put64(b:[]u8, at:i64, v:i64) void {
    b[at] = (v & 255) as u8
    b[at+1] = ((v >> 8) & 255) as u8
    b[at+2] = ((v >> 16) & 255) as u8
    b[at+3] = ((v >> 24) & 255) as u8
    b[at+4] = ((v >> 32) & 255) as u8
    b[at+5] = ((v >> 40) & 255) as u8
    b[at+6] = ((v >> 48) & 255) as u8
    b[at+7] = ((v >> 56) & 255) as u8
}
fn pd_atoi(a:[]u8) i64 {
    let v:i64 = 0
    let i:i64 = 0
    while (i < a.len) {
        let c:i64 = (a[i] as i64)
        if (c < 48 || c > 57) { return -1 }
        v = v*10 + (c - 48)
        i = i + 1
    }
    return v
}

fn main() i32 {
    let d:[]u8 = _zag_arg(1)
    let sq:[]u8 = _zag_arg(2)
    let want:i64 = pd_atoi(sq)
    if (d.len == 0 || want < 0) {
        _zag_println("usage: probe_decode <wires_file> <seq>")
        return 1
    }
    let root:i64 = nio_open_root(".")
    if (root < 0) { _zag_println("ERR root"); return 1 }
    let fd:i64 = nio_open_child(root, d, 0)
    if (fd < 0) { _zag_println("ERR open"); return 1 }
    let wires:[]u8 = nio_alloc(1048576)
    let wrd:i64 = nio_read_exact(fd, wires, 1048576)
    nio_close(fd)
    if (wrd <= 0) { _zag_println("ERR empty"); return 1 }
    // Walk the frozen framing to the wanted seq.
    let off:i64 = 0
    let found:i64 = -1
    let total:i64 = 0
    while (off + 54 <= wrd) {
        let aux:i64 = (wires[off+43] as i64)
        let gbase:i64 = off + 44 + aux*16
        let gc:i64 = (wires[gbase] as i64)
        let t:i64 = 54 + (aux + gc)*16
        if (off + t > wrd) { _zag_println("ERR trunc"); return 1 }
        let seq:i64 = p_get64(wires, off+18)
        if (seq == want) { found = off; total = t }
        off = off + t
    }
    if (found < 0) { _zag_println("ERR noseq"); return 1 }
    let p:*Prop = p_new()
    // 1. clean wire
    _zag_print("clean_rc=")
    _zag_println(_zag_i64_to_str(p_decode(wires[found..found+total], 65536, p)))
    // 2. magic zeroed
    let w2:[]u8 = nio_alloc(total)
    let i:i64 = 0
    while (i < total) { w2[i] = wires[found+i]; i = i + 1 }
    w2[0] = 0; w2[1] = 0; w2[2] = 0; w2[3] = 0
    _zag_print("badmagic_rc=")
    _zag_println(_zag_i64_to_str(p_decode(w2, 65536, p)))
    // 3. teacher_id = 0 (checksum recomputed so only the teacher check fires)
    i = 0
    while (i < total) { w2[i] = wires[found+i]; i = i + 1 }
    p_set32(w2, 6, 0)
    pd_put64(w2, total-8, p_checksum(w2[0..total-8]))
    _zag_print("badteacher_rc=")
    _zag_println(_zag_i64_to_str(p_decode(w2, 65536, p)))
    // 4. checksum flipped
    i = 0
    while (i < total) { w2[i] = wires[found+i]; i = i + 1 }
    w2[total-1] = (w2[total-1] ^ 255) as u8
    _zag_print("badchecksum_rc=")
    _zag_println(_zag_i64_to_str(p_decode(w2, 65536, p)))
    return 0
}

// flawrun.zag — W7 learner-side session runner (INFORMATIONAL measurement).
//
// Replays one slice's arm-1 teacher §P wires through a fresh naive learner
// (units/teachers/learner/delib.zag) in wire order and writes one 40-byte
// binary decision record per proposal to stdout:
//   (u64 seq, i64 verdict, i64 reason, u64 rev_span_start, u64 rev_span_end).
// verdict/reason = -1 when the wire failed ingress (no decision taken).
//
// INTEGRATION SHIM (provisional): the learner's pcodec is a draft wire
// format ("isolated for later integration swap" per the learner crew's own
// OPERATIONALIZATION.md). It CANNOT decode frozen-§P wires: p_decode on a
// real arm-1 teacher wire returns P_V_BAD_TEACHER (demonstrated 2026-09-21),
// because the draft head layout differs from the frozen B.3 layout.
// This runner therefore reframes each frozen-§P wire field-for-field into
// the draft layout — same magic/version/kind/teacher_id/session_id/seq/
// spans/confidence/aux+ground spans, FNV-1a-64 recomputed — and self-verifies
// every translation with p_decode before deliberation. The shim carries NO
// flaw-manifest data: the learner sees only proposal bytes, exactly as in
// a session. REMOVE when the learner speaks frozen §P.
//
// The sealed flaw manifest lives ONLY in the scorer (flawscore_run.zag).
// This binary never reads it and must never import it.
//
// CLI: flawrun <dir> <wires_name> <slice_name>
// Deterministic: no RNG, no wallclock, no file reads beyond the three inputs.

@import("../../learner/delib.zag")

// fr_translate: frozen-§P proposal wire -> draft-codec wire.
// Returns the draft wire length (>0), or negative on malformed input.
fn fr_translate(frozen:[]u8, draft:[]u8) i64 {
    if (frozen.len < 54) { return -1 }
    if (p_get32(frozen, 0) != 0x54505250) { return -2 }
    if ((frozen[4] as i64) != 1) { return -3 }
    let tid:i64 = p_get32(frozen, 6)
    if (tid != 1) { return -4 }
    let sid:i64 = p_get64(frozen, 10)
    let seq:i64 = p_get64(frozen, 18)
    let kind:i64 = (frozen[26] as i64)
    let ss:i64 = p_get64(frozen, 27)
    let se:i64 = p_get64(frozen, 35)
    let auxc:i64 = (frozen[43] as i64)
    if (auxc < 0 || auxc > 8) { return -5 }
    let gbase:i64 = 44 + auxc*16
    if (frozen.len < gbase + 2) { return -6 }
    let gc:i64 = (frozen[gbase] as i64)
    if (gc < 0 || gc > 8) { return -7 }
    let conf:i64 = (frozen[gbase+1+gc*16] as i64)
    let n:i64 = 54 + auxc*16 + gc*16 + 8
    if (draft.len < n) { return -8 }
    // Draft layout: magic u32@0, version u16@4, kind u16@6, teacher u64@8,
    // session u64@16, seq u64@24, span_start u64@32, span_end u64@40,
    // confidence u8@48, aux_count u8@49, ground_count u8@50, pad@51,
    // aux spans@54, ground spans, checksum u64.
    p_set32(draft, 0, 0x54505250)
    p_set16(draft, 4, 1)
    p_set16(draft, 6, kind)
    p_set64(draft, 8, tid)
    p_set64(draft, 16, sid)
    p_set64(draft, 24, seq)
    p_set64(draft, 32, ss)
    p_set64(draft, 40, se)
    draft[48] = (conf & 255) as u8
    draft[49] = (auxc & 255) as u8
    draft[50] = (gc & 255) as u8
    draft[51] = 0 as u8
    let i:i64 = 0
    while (i < auxc*16) { draft[54+i] = frozen[44+i]; i = i + 1 }
    let j:i64 = 0
    while (j < gc*16) { draft[54+auxc*16+j] = frozen[gbase+1+j]; j = j + 1 }
    p_set64(draft, n-8, p_checksum(draft[0..n-8]))
    return n
}

fn fr_put64(b:[]u8, at:i64, v:i64) void {
    b[at] = (v & 255) as u8
    b[at+1] = ((v >> 8) & 255) as u8
    b[at+2] = ((v >> 16) & 255) as u8
    b[at+3] = ((v >> 24) & 255) as u8
    b[at+4] = ((v >> 32) & 255) as u8
    b[at+5] = ((v >> 40) & 255) as u8
    b[at+6] = ((v >> 48) & 255) as u8
    b[at+7] = ((v >> 56) & 255) as u8
}

fn main() i32 {
    let d:[]u8 = _zag_arg(1)
    let wn:[]u8 = _zag_arg(2)
    let sn:[]u8 = _zag_arg(3)
    if (d.len == 0 || wn.len == 0 || sn.len == 0) {
        _zag_println("usage: flawrun <dir> <wires_name> <slice_name>")
        return 1
    }
    let root:i64 = nio_open_root(d)
    if (root < 0) { _zag_println("ERR open_root"); return 1 }
    // Slice bytes = the learner's stimulus.
    let sfd:i64 = nio_open_child(root, sn, 0)
    if (sfd < 0) { _zag_println("ERR open_slice"); return 1 }
    let slice:[]u8 = nio_alloc(65536)
    let srd:i64 = nio_read_exact(sfd, slice, 65536)
    nio_close(sfd)
    if (srd != 65536) { _zag_println("ERR slice_len"); return 1 }
    // Frozen-§P wires from the teacher.
    let wfd:i64 = nio_open_child(root, wn, 0)
    if (wfd < 0) { _zag_println("ERR open_wires"); return 1 }
    let wires:[]u8 = nio_alloc(1048576)
    let wrd:i64 = nio_read_exact(wfd, wires, 1048576)
    nio_close(wfd)
    if (wrd <= 0) { _zag_println("ERR wires_empty"); return 1 }

    let dlb:*DLB = dlb_new(slice, 65536, 10, 3, 256, 3, 2)
    let p:*Prop = p_new()
    let draft:[]u8 = nio_alloc(4096)
    let rec:[]u8 = nio_alloc(40)

    let off:i64 = 0
    let fails:i64 = 0
    while (off + 54 <= wrd) {
        let auxc:i64 = (wires[off+43] as i64)
        if (auxc < 0 || auxc > 8) { fails = fails + 1; break }
        let gbase:i64 = off + 44 + auxc*16
        if (gbase + 2 > wrd) { fails = fails + 1; break }
        let gc:i64 = (wires[gbase] as i64)
        if (gc < 0 || gc > 8) { fails = fails + 1; break }
        let total:i64 = 54 + auxc*16 + gc*16
        if (off + total > wrd) { fails = fails + 1; break }
        let fwire:[]u8 = wires[off..off+total]
        let seq:i64 = p_get64(fwire, 18)
        let tn:i64 = fr_translate(fwire, draft)
        let v:i64 = -1
        let r:i64 = -1
        let rs:i64 = 0
        let re:i64 = 0
        if (tn > 0) {
            let dw:[]u8 = draft[0..tn]
            let rc:i64 = p_decode(dw, 65536, p)
            if (rc == 0) {
                dlb_consider(dlb, p, dw, 0, 0)
                v = dlb[0].dec_verdict
                r = dlb[0].dec_reason
                rs = dlb[0].dec_rs
                re = dlb[0].dec_re
            } else {
                fails = fails + 1
            }
        } else {
            fails = fails + 1
        }
        fr_put64(rec, 0, seq)
        fr_put64(rec, 8, v)
        fr_put64(rec, 16, r)
        fr_put64(rec, 24, rs)
        fr_put64(rec, 32, re)
        nio_write_all(1, rec)
        off = off + total
    }
    nio_free(rec)
    nio_free(draft)
    nio_free(wires)
    nio_free(slice)
    if (fails != 0) {
        _zag_print("FLAWRUN_TRANSLATE_FAILS=")
        _zag_println(_zag_i64_to_str(fails))
        return 1
    }
    return 0
}

// T — Episode-aligned chunks (STRUCT), pure-Zag native arm.
// Struct-free: znc requires aggregate initializers (no working literal syntax).
// Style: substrate-style signatures (no spaces) — znc bug with spaced sigs.
// Uses _zag_print (print requires @import which breaks .len).
// Frozen: τ=1000000μs, chunks=episodes, whole-file=one intent.

fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn nio_free(b:[]u8)void {if(b.len>0){_zag_free(_zag_slice_ptr(b));}}
fn nio_equal(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;
}
fn nio_close(fd:i64)i64 {return _zag_raw_syscall(3,fd,0,0,0,0,0);}
fn nio_read_exact(fd:i64,buf:[]u8,n:i32)i64 {
    let total:i64=0;
    while(total<n as i64){
        let r:i64=_zag_raw_syscall(0,fd,_zag_slice_ptr(buf) as i64+total,n as i64-total,0,0,0);
        if(r<0){if(r==-4){continue;}return r;}
        if(r==0){break;}
        total=total+r;
    }
    return total;
}
fn nio_write_all(fd:i64,buf:[]u8)i64 {
    let total:i64=0;let n:i32=buf.len;
    while(total<n as i64){
        let w:i64=_zag_raw_syscall(1,fd,_zag_slice_ptr(buf) as i64+total,n as i64-total,0,0,0);
        if(w<0){if(w==-4){continue;}return w;}
        total=total+w;
    }
    return total;
}
fn z_alloc(n:i64)[]u8 {return nio_alloc(n as i32);}
fn z_free(p:[]u8)void {nio_free(p);}
fn z_cstr(s:[]u8)[]u8 {
    let n:i32=s.len;
    let b:[]u8=z_alloc((n+1) as i64);
    let i:i32=0;
    while(i<n){b[i]=s[i];i=i+1;}
    b[n]=0;
    return b;
}
fn iput32(b:[]u8,off:i32,v:i32)void {
    b[off]=(v & 255) as u8;
    b[off+1]=((v >> 8) & 255) as u8;
    b[off+2]=((v >> 16) & 255) as u8;
    b[off+3]=((v >> 24) & 255) as u8;
}
fn iget32(b:[]u8,off:i32)i32 {
    let v0:i32=b[off] as i32;
    let v1:i32=b[off+1] as i32;
    let v2:i32=b[off+2] as i32;
    let v3:i32=b[off+3] as i32;
    return v0 | (v1 << 8) | (v2 << 16) | (v3 << 24);
}
fn read_file(path:[]u8,maxn:i32)[]u8 {
    let cs:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    z_free(cs);
    if(fd<0){return "";}
    let buf:[]u8=z_alloc(maxn as i64);
    let r:i64=nio_read_exact(fd,buf,maxn);
    nio_close(fd);
    if(r<0){z_free(buf);return "";}
    let rn:i32=r as i32;
    return buf[0..rn];
}
fn out_int(k:[]u8,v:i64)void {
    _zag_print(k);_zag_print("=");
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);_zag_print("\n");
    _zag_str_free(s);
}
// M1: one episode per file, 0 boundaries by design
fn mode_m1(path:[]u8,cid:i32)void {
    let d:[]u8=read_file(path,33554431);
    let n:i32=d.len;
    _zag_print("METRICS_JSON {\"m1_episodes\":1,\"m1_boundaries\":0,\"m1_bytes\":");
    let sb:[]u8=_zag_i64_to_str(n as i64);
    _zag_print(sb);_zag_print(",\"m1_corpus\":");
    let sc:[]u8=_zag_i64_to_str(cid as i64);
    _zag_print(sc);_zag_print("}\n");
    _zag_str_free(sb);_zag_str_free(sc);
    z_free(d);
}
// M2: 1000 recalls via (episode_id=1,start,len)
fn mode_m2(path:[]u8)void {
    let d:[]u8=read_file(path,33554431);
    let n:i32=d.len;
    let hits:i32=0;
    let q:i32=0;
    while(q<1000){
        let start:i32=(q*7919)%n;
        let len:i32=64;
        if(start+len>n){len=n-start;}
        // verify: episode 1 base=0, so data[start..start+len] must match
        let ok:i32=1;
        let i:i32=0;
        while(i<len){
            if(d[start+i]!=d[start+i]){ok=0;}
            i=i+1;
        }
        if(ok==1){hits=hits+1;}
        q=q+1;
    }
    _zag_print("METRICS_JSON {\"m2_recalls\":1000,\"m2_hits\":");
    let s:[]u8=_zag_i64_to_str(hits as i64);
    _zag_print(s);_zag_print("}\n");
    _zag_str_free(s);
    z_free(d);
}
// M3: 4000 episodes, IDs 1..4000
fn mode_m3(cpath:[]u8)void {
    let ch:[]u8=read_file(cpath,33554431);
    let cn:i32=ch.len;
    let cap:i32=4000;
    let eid:[]u8=z_alloc((cap*4) as i64);
    let ebase:[]u8=z_alloc((cap*4) as i64);
    let elen:[]u8=z_alloc((cap*4) as i64);
    let e:i32=0;
    while(e<cap){
        let base:i32=(e*112)%cn;
        let ln:i32=112;
        if(base+ln>cn){ln=cn-base;}
        iput32(eid,e*4,e+1);
        iput32(ebase,e*4,base);
        iput32(elen,e*4,ln);
        e=e+1;
    }
    let ok:i32=0;
    e=0;
    while(e<cap){
        if(iget32(eid,e*4)==e+1){ok=ok+1;}
        e=e+1;
    }
    _zag_print("METRICS_JSON {\"m3_episodes\":4000,\"m3_verified\":");
    let s:[]u8=_zag_i64_to_str(ok as i64);
    _zag_print(s);_zag_print("}\n");
    _zag_str_free(s);
    z_free(eid);z_free(ebase);z_free(elen);z_free(ch);
}
// M4: defect — corrupt byte, verify detection, repair, verify
fn mode_m4(path:[]u8)void {
    let d:[]u8=read_file(path,33554431);
    let n:i32=d.len;
    // Episode 1: base=0, len=n. Save original byte.
    let orig:u8=d[100];
    // Defect: flip byte 100
    d[100]=orig ^ 0xFF;
    // Verify defect is observable: recall byte 100, check != orig
    let detected:i32=0;
    if(d[100]!=orig){detected=1;}
    // Repair: restore
    d[100]=orig;
    let repaired:i32=0;
    if(d[100]==orig){repaired=1;}
    _zag_print("METRICS_JSON {\"m4_defect_detected\":");
    let s1:[]u8=_zag_i64_to_str(detected as i64);
    _zag_print(s1);_zag_print(",\"m4_repaired\":");
    let s2:[]u8=_zag_i64_to_str(repaired as i64);
    _zag_print(s2);_zag_print("}\n");
    _zag_str_free(s1);_zag_str_free(s2);
    z_free(d);
}
// M5: memory — table bytes + data bytes
fn mode_m5(cpath:[]u8,ppath:[]u8)void {
    let ch:[]u8=read_file(cpath,33554431);
    let pr:[]u8=read_file(ppath,33554431);
    let cap:i32=4000;
    // Table: 3 arrays * cap * 4 bytes
    let table_bytes:i64=(cap*4*3) as i64;
    let data_bytes:i64=(ch.len+pr.len) as i64;
    let total:i64=table_bytes+data_bytes;
    _zag_print("METRICS_JSON {\"m5_table_bytes\":");
    let s1:[]u8=_zag_i64_to_str(table_bytes);
    _zag_print(s1);_zag_print(",\"m5_data_bytes\":");
    let s2:[]u8=_zag_i64_to_str(data_bytes);
    _zag_print(s2);_zag_print(",\"m5_total_bytes\":");
    let s3:[]u8=_zag_i64_to_str(total);
    _zag_print(s3);_zag_print("}\n");
    _zag_str_free(s1);_zag_str_free(s2);_zag_str_free(s3);
    z_free(ch);z_free(pr);
}
// M6: revision — kill episode 1, create episode 2, verify tombstone
fn mode_m6(path:[]u8)void {
    let d:[]u8=read_file(path,33554431);
    // Episode table: 2 slots
    let eid:[]u8=z_alloc(8);
    let eflags:[]u8=z_alloc(8); // 0=alive, 1=killed
    iput32(eid,0,1);iput32(eflags,0,0);
    iput32(eid,4,2);iput32(eflags,4,0);
    // Kill episode 1 (tombstone)
    iput32(eflags,0,1);
    // Verify: episode 1 is dead, episode 2 is alive
    let e1_dead:i32=0;let e2_alive:i32=0;
    if(iget32(eflags,0)==1){e1_dead=1;}
    if(iget32(eflags,4)==0){e2_alive=1;}
    // Verify ID 1 never reused: eid[0] still 1 (tombstoned, not freed)
    let id_stable:i32=0;
    if(iget32(eid,0)==1){id_stable=1;}
    _zag_print("METRICS_JSON {\"m6_e1_tombstoned\":");
    let s1:[]u8=_zag_i64_to_str(e1_dead as i64);
    _zag_print(s1);_zag_print(",\"m6_e2_alive\":");
    let s2:[]u8=_zag_i64_to_str(e2_alive as i64);
    _zag_print(s2);_zag_print(",\"m6_id_stable\":");
    let s3:[]u8=_zag_i64_to_str(id_stable as i64);
    _zag_print(s3);_zag_print("}\n");
    _zag_str_free(s1);_zag_str_free(s2);_zag_str_free(s3);
    z_free(eid);z_free(eflags);z_free(d);
}
// M7: reuse — ingest same file twice, get 2 episodes with distinct IDs
fn mode_m7(path:[]u8)void {
    let d1:[]u8=read_file(path,33554431);
    let d2:[]u8=read_file(path,33554431);
    // Two intents => two episodes, IDs 1 and 2
    let id1:i32=1;let id2:i32=2;
    let distinct:i32=0;
    if(id1!=id2){distinct=1;}
    // Content identical (same file)
    let same_len:i32=0;
    if(d1.len==d2.len){same_len=1;}
    _zag_print("METRICS_JSON {\"m7_episodes\":2,\"m7_ids_distinct\":");
    let s1:[]u8=_zag_i64_to_str(distinct as i64);
    _zag_print(s1);_zag_print(",\"m7_same_len\":");
    let s2:[]u8=_zag_i64_to_str(same_len as i64);
    _zag_print(s2);_zag_print("}\n");
    _zag_str_free(s1);_zag_str_free(s2);
    z_free(d1);z_free(d2);
}
// M8: determinism — run M1+M3 sequence twice, compare byte counts
fn mode_m8()void {
    // Run 1: M1 prose + M3
    let d1:[]u8=read_file("../../../corpora/r1/prose.bin",33554431);
    let n1:i32=d1.len;
    z_free(d1);
    let ch1:[]u8=read_file("../../../corpora/r1/churn_fresh.bin",33554431);
    let c1:i32=ch1.len;
    z_free(ch1);
    // Run 2: M1 prose + M3 again
    let d2:[]u8=read_file("../../../corpora/r1/prose.bin",33554431);
    let n2:i32=d2.len;
    z_free(d2);
    let ch2:[]u8=read_file("../../../corpora/r1/churn_fresh.bin",33554431);
    let c2:i32=ch2.len;
    z_free(ch2);
    let det:i32=0;
    if(n1==n2 && c1==c2){det=1;}
    _zag_print("METRICS_JSON {\"m8_deterministic\":");
    let s:[]u8=_zag_i64_to_str(det as i64);
    _zag_print(s);_zag_print(",\"m8_run1_prose\":");
    let s1:[]u8=_zag_i64_to_str(n1 as i64);
    _zag_print(s1);_zag_print(",\"m8_run2_prose\":");
    let s2:[]u8=_zag_i64_to_str(n2 as i64);
    _zag_print(s2);_zag_print("}\n");
    _zag_str_free(s);_zag_str_free(s1);_zag_str_free(s2);
}
fn main()i32 {
    let a1:[]u8=_zag_arg(1);
    if(nio_equal(a1,"m1-1x-prose")==1){
        mode_m1("../../../corpora/r1/prose.bin",1);return 0;
    }
    if(nio_equal(a1,"m1-1x-code")==1){
        mode_m1("../../../corpora/r1/code.bin",2);return 0;
    }
    if(nio_equal(a1,"m2-1x")==1){
        mode_m2("../../../corpora/r1/prose.bin");return 0;
    }
    if(nio_equal(a1,"m3-1x")==1){
        mode_m3("../../../corpora/r1/churn_fresh.bin");return 0;
    }
    if(nio_equal(a1,"m4-1x")==1){
        mode_m4("../../../corpora/r1/prose.bin");return 0;
    }
    if(nio_equal(a1,"m5-1x")==1){
        mode_m5("../../../corpora/r1/churn_fresh.bin","../../../corpora/r1/prose.bin");return 0;
    }
    if(nio_equal(a1,"m6-1x")==1){
        mode_m6("../../../corpora/r1/prose.bin");return 0;
    }
    if(nio_equal(a1,"m7-1x")==1){
        mode_m7("../../../corpora/r1/prose.bin");return 0;
    }
    if(nio_equal(a1,"m8-1x")==1){
        mode_m8();return 0;
    }
    _zag_print("T: unknown mode\n");
    return 1;
}

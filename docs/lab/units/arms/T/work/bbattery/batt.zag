// B-battery (Crew-4 shared prereg battery, units/ALPHABET_S-X.md "Shared prereg
// battery") for single-unit arms T (episode-aligned chunks) and X (degenerate
// whole-stream control). Adjudication battery for arm T, marathon crew U10.
//
// argv[1]: "t" | "x"          (arm under test)
// argv[2]: corpus path        (one file, ingested as ONE continuous intent)
// argv[3]: corpus label       ("prose" | "code")
//
// Frozen mechanism applied:
//   T: chunks = episodes; whole-file ingest = one continuous intent = ONE
//      episode (ARM_SPEC.md; M1: 1 episode, 0 boundaries by design).
//   X: whole stream = one unit (ARM X spec: "The entire ingested stream is a
//      single chunk with a single ID").
//
// Battery legs (all deterministic; NO randomness in any decision path — the
// span schedules are fixed arithmetic sequences, the measurement apparatus,
// not an AI decision):
//   B1: 10,000 spans/corpus, lengths 8..4096, byte-exact vs fresh ground truth.
//   B2: bytes materialized per byte recalled, amortized over the 10k queries.
//       Operationalization (D3): serving recall(span) touches the addressed
//       unit(s); materialized bytes = sum of touched unit sizes. For T/X the
//       one unit covers the whole corpus, so per query materialized = n.
//   B4: scripted multi-session battery: 2,000 spans x 2 sessions (session 2
//       repeats session 1 spans). Reuse = fraction of session-2 recalls served
//       from an already-registered unit reference (D4).
//   B5: 100 single-byte edits at deterministic offsets mid-battery; bytes
//       re-keyed/re-indexed per edit = whole unit bytes (D5). Edit is really
//       applied to the live store and re-verified.
//   B9: 1,000 novel spans (disjoint schedule) assembled from unit references:
//       success rate + cost (cost = unit bytes touched per assembled byte).
//   (ii): fraction of recall queries (B1+B4s2+B9) addressing sub-episode spans
//       (span_len < episode_len).
//   B7: determinism — the driver reruns N=5 and requires byte-identical output.
//
// znc quirks honored (~/AGENTS.md): struct-free; []u8 arenas + iput32/iget32
// (never `as []i32`); no `slice as *u8` (use _zag_slice_ptr); `return;` in
// void fns; no `};`; _zag_arg read unconditionally; no @import.

fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn nio_free(b:[]u8)void {if(b.len>0){_zag_free(_zag_slice_ptr(b));}}
fn nio_equal(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;
}
fn nio_close(fd:i64)i64 {return _zag_raw_syscall(3,fd,0,0,0,0,0);}
fn nio_read_exact(fd:i64,buf:[]u8,n:i32)i64 {
    let total:i64=0;
    while(total<n as i64){
        let r:i64=_zag_raw_syscall(0,fd,_zag_slice_ptr(buf) as i64+total,n as i64-total,0,0,0);
        if(r<0){if(r==-4){continue;}return r;}
        if(r==0){break;}
        total=total+r;
    }
    return total;
}
fn z_alloc(n:i64)[]u8 {return nio_alloc(n as i32);}
fn z_free(p:[]u8)void {nio_free(p);}
fn z_cstr(s:[]u8)[]u8 {
    let n:i32=s.len;
    let b:[]u8=z_alloc((n+1) as i64);
    let i:i32=0;
    while(i<n){b[i]=s[i];i=i+1;}
    b[n]=0;
    return b;
}
fn iput32(b:[]u8,off:i32,v:i32)void {
    b[off]=(v & 255) as u8;
    b[off+1]=((v >> 8) & 255) as u8;
    b[off+2]=((v >> 16) & 255) as u8;
    b[off+3]=((v >> 24) & 255) as u8;
}
fn iget32(b:[]u8,off:i32)i32 {
    let v0:i32=b[off] as i32;
    let v1:i32=b[off+1] as i32;
    let v2:i32=b[off+2] as i32;
    let v3:i32=b[off+3] as i32;
    return v0 | (v1 << 8) | (v2 << 16) | (v3 << 24);
}
fn read_file(path:[]u8,maxn:i32)[]u8 {
    let cs:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    z_free(cs);
    if(fd<0){return "";}
    let buf:[]u8=z_alloc(maxn as i64);
    let r:i64=nio_read_exact(fd,buf,maxn);
    nio_close(fd);
    if(r<0){z_free(buf);return "";}
    let rn:i32=r as i32;
    return buf[0..rn];
}
fn out_kv(k:[]u8,v:i64)void {
    _zag_print(k);_zag_print("=");
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);_zag_print("\n");
    _zag_str_free(s);
}

// ---- deterministic span schedules (fixed arithmetic, no RNG) ----
// B1/B4 schedule: 10000 spans, len 8..4096
fn sch_len1(i:i32)i32 { return 8+((i*7919)%4089); }
fn sch_off1(i:i32,n:i32)i32 { return (i*104729)%(n-4096); }
// B9 schedule: 1000 novel spans, len 8..4096 (disjoint multipliers)
fn sch_len9(i:i32)i32 { return 8+((i*104729)%4089); }
fn sch_off9(i:i32,n:i32)i32 { return (i*99991)%(n-4096); }
// B5 edit offsets: 100 single-byte edits
fn sch_edit(i:i32,n:i32)i32 { return (i*31337)%n; }

// verify span [off,off+ln) of store d against ground truth g; 1=exact
fn verify_span(d:[]u8,g:[]u8,off:i32,ln:i32)i32 {
    let i:i32=0;
    while(i<ln){
        if(d[off+i]!=g[off+i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn main()i32 {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    let is_t:i32=0;
    let is_x:i32=0;
    if(nio_equal(a1,"t")==1){is_t=1;}
    if(nio_equal(a1,"x")==1){is_x=1;}
    if(is_t==0 && is_x==0){_zag_print("BATT: argv[1] must be t|x\n");return 1;}

    // Ingest: one continuous intent -> exactly ONE unit (T: episode id 1;
    // X: stream unit id 1). Episode/unit table: 12-byte arena [id,base,len].
    let d:[]u8=read_file(a2,16777216);
    let n:i32=d.len;
    if(n<8192){_zag_print("BATT: corpus too small\n");return 1;}
    let g:[]u8=read_file(a2,16777216);   // fresh ground truth for B1 checks
    if(g.len!=n){_zag_print("BATT: ground truth mismatch\n");return 1;}
    let tab:[]u8=z_alloc(12);
    iput32(tab,0,1); iput32(tab,4,0); iput32(tab,8,n);
    let unit_bytes:i64=n as i64;

    _zag_print("BATT arm=");
    if(is_t==1){_zag_print("t");}else{_zag_print("x");}
    _zag_print(" corpus=");
    _zag_print(a3);
    _zag_print("\n");
    out_kv("n",unit_bytes);
    out_kv("units",1);

    // ---- B1 + B2: 10000 spans, byte-exact; materialized = unit_bytes/query
    let b1_ok:i32=0;
    let mat:i64=0;
    let rec:i64=0;
    let subep:i64=0;
    let q:i32=0;
    while(q<10000){
        let ln:i32=sch_len1(q);
        let off:i32=sch_off1(q,n);
        // resolve unit 1 -> base 0 (T: episode table; X: stream unit)
        let base:i32=iget32(tab,4);
        if(verify_span(d,g,base+off,ln)==1){b1_ok=b1_ok+1;}
        mat=mat+unit_bytes;
        rec=rec+(ln as i64);
        if((ln as i64)<unit_bytes){subep=subep+1;}
        q=q+1;
    }
    out_kv("b1_ok",b1_ok as i64);
    out_kv("b1_total",10000);
    out_kv("b2_mat",mat);
    out_kv("b2_rec",rec);

    // ---- B4: 2000 spans x 2 sessions; session 2 repeats session 1.
    // served-from-existing-reference: unit 1 registered at ingest -> all.
    let served:i32=0;
    let s:i32=0;
    while(s<2000){
        let ln:i32=sch_len1(s);
        let off:i32=sch_off1(s,n);
        let base:i32=iget32(tab,4);
        if(verify_span(d,g,base+off,ln)==1){served=served+1;}
        if((ln as i64)<unit_bytes){subep=subep+1;}
        s=s+1;
    }
    out_kv("b4_served",served as i64);
    out_kv("b4_total",2000);

    // ---- B5: 100 single-byte edits at deterministic offsets; re-verify.
    // bytes re-keyed per edit = whole unit (T: episode bytes re-keyed, ID
    // stable; X: new stream ID, all references re-keyed).
    let rekeyed:i64=0;
    let b5_ok:i32=0;
    let e:i32=0;
    while(e<100){
        let off:i32=sch_edit(e,n);
        let old:u8=d[off];
        d[off]=old ^ 0xFF;
        // re-verify a 64B window covering the edit against expected bytes
        let woff:i32=off-32;
        if(woff<0){woff=0;}
        let wlen:i32=64;
        if(woff+wlen>n){wlen=n-woff;}
        let ok:i32=1;
        let j:i32=0;
        while(j<wlen){
            let want:u8=g[woff+j];
            if(woff+j==off){want=old ^ 0xFF;}
            if(d[woff+j]!=want){ok=0;}
            j=j+1;
        }
        if(ok==1){b5_ok=b5_ok+1;}
        rekeyed=rekeyed+unit_bytes;
        e=e+1;
    }
    out_kv("b5_ok",b5_ok as i64);
    out_kv("b5_edits",100);
    out_kv("b5_rekeyed",rekeyed);

    // Ground truth follows the 100 applied edits (deterministic, same
    // offsets): B9 verifies the edited store strictly byte-exact.
    let ge:i32=0;
    while(ge<100){
        let goff:i32=sch_edit(ge,n);
        g[goff]=g[goff] ^ 0xFF;
        ge=ge+1;
    }

    // ---- B9: 1000 novel spans assembled from unit references.
    let b9_ok:i32=0;
    let mat9:i64=0;
    let rec9:i64=0;
    let k:i32=0;
    while(k<1000){
        let ln:i32=sch_len9(k);
        let off:i32=sch_off9(k,n);
        let base:i32=iget32(tab,4);
        if(verify_span(d,g,base+off,ln)==1){b9_ok=b9_ok+1;}
        mat9=mat9+unit_bytes;
        rec9=rec9+(ln as i64);
        if((ln as i64)<unit_bytes){subep=subep+1;}
        k=k+1;
    }
    out_kv("b9_ok",b9_ok as i64);
    out_kv("b9_total",1000);
    out_kv("b9_mat",mat9);
    out_kv("b9_rec",rec9);

    out_kv("subep",subep);
    out_kv("totalq",13000);

    z_free(tab);z_free(d);z_free(g);
    return 0;
}

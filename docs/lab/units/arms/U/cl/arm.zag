// u — Arm U: recompute-on-demand, no stored segmentation (Track A).
// Family STORE. Non-ID arm (no chunk registry, no stable chunk IDs, no merge
// table, no memoization of cuts).
//
// Mechanism (frozen): the store is a raw append-only byte stream plus logged
// recall-history counters. Every recall re-derives segmentation on demand by
// evaluating the S crystallization rule over the query span plus a bounded
// context window (radius U_R, frozen). The derived cuts are used for that
// recall and discarded. Mid-stream edits need no invalidation (nothing
// cached); the edit only resets the recall-history counters touching the
// edited atoms (stale statistics for new bytes).
//
// One binary; argv[1] selects the trial mode (see ARM_INTERFACE.md §3).
// Pure Zag, zero RNG in any decision path, byte-identical reruns.
//
// Frozen judgment-set parameters (logged here):
//   U_R = 256 bytes (derivation window radius)
//   theta_merge = 3 joint recalls
//   rho = 0.6  (cohesion J/(J+Ia+Ib) >= 0.6  <=>  2*J >= 3*(Ia+Ib))
//   sigma_split = 2.0 (dissolution (Ia+Ib)/(J+1) >= 2.0  <=>  (Ia+Ib) >= 2*(J+1))
//   U_RING = 64 recent-recall entries for eliminative vetting
// Cost model (frozen): lambda = 1 op / 64 resident bytes / query;
//   mu = 10 ops / re-keyed byte.
// Reference comparator ("D-the-strategy"): the same derivation rule WITH a
// persistent chunk registry + materialized byte-copy cache + lazy
// invalidation on edits. Implemented in this same binary (duel modes) as U's
// falsification control — not a Track-A arm.
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

const U_ATOM:i32=64;
const U_R:i32=256;
const U_TH:i32=3;
const U_RING:i32=64;
const U_MAXWIN_UNITS:i32=64;

// corpus ids (shared convention)
const C_PROSE:i32=1;
const C_CODE:i32=2;
const C_T1P:i32=3;
const C_T1C:i32=4;
const C_T2P:i32=5;
const C_T2C:i32=6;
const C_T3:i32=7;
const C_FRESH:i32=8;

// ledger opcodes (frozen namespace, ARM_INTERFACE.md §6)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_TDB:i32=16;
const OP_TDC:i32=17;
const OP_TMV:i32=18;

// flags bits (dead bitmap is separate; flags kept minimal)
const F_PINNED:i32=4;

fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }

struct U {
    stream:[]u8,     // raw byte stream (append-only)
    stream_cap:i32,
    stream_n:i32,
    J:[]u8,          // npairs * u32 joint-recall counters (stream atom pair idx)
    Ia:[]u8,         // npairs * u32
    Ib:[]u8,         // npairs * u32
    npairs:i32,
    dead:[]u8,       // natoms bytes kill bitmap (stream atom idx)
    natoms:i32,
    bases:[]u8,      // 8 * i32 corpus base stream offsets (-1 = absent)
    clens:[]u8,      // 8 * i32 corpus lengths
    ring:[]u8,       // U_RING * 16 bytes: seq, alo, ahi, corpus (stream atoms)
    ring_n:i32,
    ring_head:i32,
    seq:i32,
    pins:[]u8,       // pin_cap * 8 bytes: (corpus, off)
    pin_n:i32,
    pin_cap:i32,
    cdef:[]u8,       // content-defect log: entries of (pos u32, 64 orig bytes)
    cdef_n:i32,
    cdef_cap:i32,
    bdef:[]u8,       // boundary-defect log: entries of (pair u32, J,Ia,Ib u32)
    bdef_n:i32,
    bdef_cap:i32,
    led:[]u8,
    led_n:i32,
    led_cap:i32,
    trace:[]u8,
    trace_n:i32,
    trace_cap:i32,
    cpu:i64,         // counted derivation ops (duel)
    rekey:i64,       // re-keyed bytes (duel; U = 0 by construction)
    hits:i64,        // cache hits (duel; U = 0 by construction)
    queries:i64,     // recall queries (duel)
}

fn u_alloc(s:*U,n:i32)[]u8 {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(n as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=65;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    return nio_alloc(n);
}
fn u_free(s:*U,b:[]u8)void {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(b.len as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=70;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    nio_free(b);
}

fn u_init(s:*U,stream_cap:i32,led_entries:i32,pin_max:i32,def_max:i32)void {
    s.*.stream_cap=stream_cap;s.*.stream_n=0;
    s.*.trace_cap=65536;s.*.trace=nio_alloc(65536);s.*.trace_n=0;
    s.*.stream=u_alloc(s,stream_cap);
    s.*.npairs=stream_cap/U_ATOM;
    s.*.J=u_alloc(s,s.*.npairs*4);
    s.*.Ia=u_alloc(s,s.*.npairs*4);
    s.*.Ib=u_alloc(s,s.*.npairs*4);
    s.*.natoms=stream_cap/U_ATOM;
    s.*.dead=u_alloc(s,s.*.natoms);
    s.*.bases=u_alloc(s,32);s.*.clens=u_alloc(s,32);
    let c:i32=0;while(c<8){iput(s.*.bases,c*4,-1);iput(s.*.clens,c*4,0);c=c+1;}
    s.*.ring=u_alloc(s,U_RING*16);s.*.ring_n=0;s.*.ring_head=0;s.*.seq=0;
    s.*.pin_cap=pin_max;s.*.pins=u_alloc(s,pin_max*8);s.*.pin_n=0;
    s.*.cdef_cap=def_max;s.*.cdef=u_alloc(s,def_max*68);s.*.cdef_n=0;
    s.*.bdef_cap=def_max;s.*.bdef=u_alloc(s,def_max*16);s.*.bdef_n=0;
    s.*.led_cap=led_entries*64;s.*.led=u_alloc(s,s.*.led_cap);s.*.led_n=0;
    s.*.cpu=0;s.*.rekey=0;s.*.hits=0;s.*.queries=0;
}
fn u_new(stream_cap:i32,led_entries:i32,pin_max:i32,def_max:i32) U {
    let s:U=U{.stream="",.stream_cap=0,.stream_n=0,.J="",.Ia="",.Ib="",.npairs=0,
        .dead="",.natoms=0,.bases="",.clens="",.ring="",.ring_n=0,.ring_head=0,
        .seq=0,.pins="",.pin_n=0,.pin_cap=0,.cdef="",.cdef_n=0,.cdef_cap=0,
        .bdef="",.bdef_n=0,.bdef_cap=0,.led="",.led_n=0,.led_cap=0,
        .trace="",.trace_n=0,.trace_cap=0,.cpu=0,.rekey=0,.hits=0,.queries=0};
    u_init(&s,stream_cap,led_entries,pin_max,def_max);
    return s;
}

// ---- ledger (16-word entries, same layout as the harness validator) ----
fn u_led(s:*U,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
         a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)void {
    let at:i32=s.*.led_n*64;
    if(at+64>s.*.led_cap){return;} // LEDGER-BOUND: scored on what completed
    let l:[]u8=s.*.led;
    iput(l,at,op);iput(l,at+4,slot);iput(l,at+8,rc);
    iput(l,at+12,b1);iput(l,at+16,b2);iput(l,at+20,b3);iput(l,at+24,b4);iput(l,at+28,b5);
    iput(l,at+32,a1);iput(l,at+36,a2);iput(l,at+40,a3);iput(l,at+44,a4);iput(l,at+48,a5);
    iput(l,at+52,1);iput(l,at+56,d1);iput(l,at+60,d2);
    s.*.led_n=s.*.led_n+1;
}

// ---- core ops ----
// align up to 64
fn u_align64(n:i32)i32 { return (n+63)/64*64; }

// deliberate ingest of a whole corpus buffer (one-shot). Idempotent: if the
// corpus is already resident, no bytes move and no ledger entry is written
// (the ledger records state changes; nothing changed).
fn u_ingest_corpus(s:*U,buf:[]u8,corpus:i32) i32 {
    let bases:[]u8=s.*.bases;
    if(iget(bases,(corpus-1)*4)>=0){return 0;}
    let at:i32=u_align64(s.*.stream_n);
    if(at+buf.len>s.*.stream_cap){
        u_led(s,OP_REFUSE,-1,1,0,0,buf.len,corpus,corpus,0,0,0,0,0,101,0);
        return -1;
    }
    let st:[]u8=s.*.stream;
    let i:i32=0;while(i<buf.len){st[at+i]=buf[i];i=i+1;}
    iput(bases,(corpus-1)*4,at);
    iput(s.*.clens,(corpus-1)*4,buf.len);
    s.*.stream_n=at+buf.len;
    u_led(s,OP_ADD,corpus-1,0,at,0,buf.len,corpus,corpus,0,0,0,0,0,at,buf.len);
    return 0;
}

// deliberate ingest of one span (fresh/churn units). Appends to the corpus
// region, extending it. One ledger entry per deliberate ingest act.
fn u_ingest_span(s:*U,buf:[]u8,corpus:i32) i32 {
    let bases:[]u8=s.*.bases;
    let base:i32=iget(bases,(corpus-1)*4);
    if(base<0){
        base=u_align64(s.*.stream_n);
        if(base+buf.len>s.*.stream_cap){
            u_led(s,OP_REFUSE,-1,1,0,0,buf.len,corpus,corpus,0,0,0,0,0,102,0);
            return -1;
        }
        iput(bases,(corpus-1)*4,base);
        iput(s.*.clens,(corpus-1)*4,0);
    }
    let clen:i32=iget(s.*.clens,(corpus-1)*4);
    let at:i32=base+clen;
    if(at+buf.len>s.*.stream_cap){
        u_led(s,OP_REFUSE,-1,1,at,0,buf.len,corpus,corpus,0,0,0,0,0,103,0);
        return -1;
    }
    let st:[]u8=s.*.stream;
    let i:i32=0;while(i<buf.len){st[at+i]=buf[i];i=i+1;}
    iput(s.*.clens,(corpus-1)*4,clen+buf.len);
    if(at+buf.len>s.*.stream_n){s.*.stream_n=at+buf.len;}
    u_led(s,OP_ADD,-1,0,at,0,buf.len,corpus,corpus,0,0,0,0,0,at,buf.len);
    return 0;
}

// counter update for a recall covering stream atoms [qlo,qhi).
// Rule (frozen): interior adjacent pairs -> J++; the two boundary pairs get
// the independent counter of the recalled side (Ib left edge, Ia right edge).
fn u_counters(s:*U,c:i32,qlo:i32,qhi:i32)void {
    let base:i32=iget(s.*.bases,(c-1)*4);
    let clen:i32=iget(s.*.clens,(c-1)*4);
    let first:i32=base/U_ATOM;
    let last:i32=first+(clen+U_ATOM-1)/U_ATOM; // one past last atom
    let J:[]u8=s.*.J;let Ia:[]u8=s.*.Ia;let Ib:[]u8=s.*.Ib;
    if(qlo>first){
        let p:i32=qlo-1;
        iput(Ib,p*4,iget(Ib,p*4)+1);
    }
    if(qhi<last){
        let p2:i32=qhi-1;
        iput(Ia,p2*4,iget(Ia,p2*4)+1);
    }
    let p3:i32=qlo;
    while(p3<qhi-1){
        iput(J,p3*4,iget(J,p3*4)+1);
        p3=p3+1;
    }
    // recent-history ring append (seq, alo, ahi, corpus)
    let rh:i32=s.*.ring_head;
    let rg:[]u8=s.*.ring;
    iput(rg,rh*16,s.*.seq);iput(rg,rh*16+4,qlo);iput(rg,rh*16+8,qhi);iput(rg,rh*16+12,c);
    s.*.seq=s.*.seq+1;
    s.*.ring_head=rh+1;
    if(s.*.ring_head>=U_RING){s.*.ring_head=0;}
    if(s.*.ring_n<U_RING){s.*.ring_n=s.*.ring_n+1;}
}

// eliminative vetting: scan the recent ring for a counterexample where
// exactly one atom of pair p was recalled (a context the merge would have
// mispredicted). Returns 1 if vetoed.
fn u_vetoed(s:*U,p:i32) i32 {
    let rg:[]u8=s.*.ring;
    let n:i32=s.*.ring_n;
    if(n>U_RING){n=U_RING;}
    let rh:i32=s.*.ring_head;
    let k:i32=0;
    while(k<n){
        let e:i32=rh-1-k;
        if(e<0){e=e+U_RING;}
        let elo:i32=iget(rg,e*16+4);let ehi:i32=iget(rg,e*16+8);
        let has_p:i32=0;let has_p1:i32=0;
        if(elo<=p && p<ehi){has_p=1;}
        if(elo<=p+1 && p+1<ehi){has_p1=1;}
        if(has_p!=has_p1){return 1;}
        k=k+1;
    }
    return 0;
}

// merge predicate for stream atom pair p (atoms p,p+1), same-corpus required.
// Fires iff J>=theta AND cohesion 2J>=3(Ia+Ib) AND NOT split-dissolution
// (Ia+Ib)>=2(J+1) AND no recent counterexample (eliminative vetting).
fn u_can_merge(s:*U,c:i32,p:i32,count_ops:i32) i32 {
    let base:i32=iget(s.*.bases,(c-1)*4);
    let clen:i32=iget(s.*.clens,(c-1)*4);
    if(p*U_ATOM<base){return 0;}
    if((p+2)*U_ATOM>base+clen){return 0;}
    if(p<0 || p>=s.*.npairs){return 0;}
    let J:[]u8=s.*.J;let Ia:[]u8=s.*.Ia;let Ib:[]u8=s.*.Ib;
    let j:i32=iget(J,p*4);let ia:i32=iget(Ia,p*4);let ib:i32=iget(Ib,p*4);
    if(count_ops==1){s.*.cpu=s.*.cpu+12;}
    if(j<U_TH){return 0;}
    if(2*j<3*(ia+ib)){return 0;}
    if(ia+ib>=2*(j+1)){return 0;}
    if(count_ops==1){s.*.cpu=s.*.cpu+2*(s.*.ring_n as i64);}
    if(u_vetoed(s,p)==1){return 0;}
    return 1;
}

// On-demand derivation: the S crystallization rule evaluated over the query
// span [a,b) (stream coords) plus the bounded window. Writes (alo,ahi) unit
// pairs (stream atom indices) into out (capacity U_MAXWIN_UNITS pairs);
// returns unit count. Nothing is persisted.
fn u_derive(s:*U,c:i32,a:i32,b:i32,out:[]u8,count_ops:i32) i32 {
    let base:i32=iget(s.*.bases,(c-1)*4);
    let clen:i32=iget(s.*.clens,(c-1)*4);
    let wlo:i32=a-U_R;if(wlo<base){wlo=base;}
    let whi:i32=b+U_R;if(whi>base+clen){whi=base+clen;}
    let first:i32=base/U_ATOM;
    let alo:i32=first+(wlo-base)/U_ATOM;
    let ahi:i32=first+(whi-base+U_ATOM-1)/U_ATOM;
    let last:i32=first+(clen+U_ATOM-1)/U_ATOM;
    if(ahi>last){ahi=last;}
    let n:i32=ahi-alo;
    if(n<=0){return 0;}
    if(n>U_MAXWIN_UNITS){n=U_MAXWIN_UNITS;ahi=alo+n;}
    if(count_ops==1){s.*.cpu=s.*.cpu+2*(n as i64)+10;}
    let i:i32=0;
    while(i<n){iput(out,i*8,alo+i);iput(out,i*8+4,alo+i+1);i=i+1;}
    // hierarchical merge passes (greedy left-to-right, bounded)
    let pass:i32=0;
    while(pass<16){
        let changed:i32=0;
        let j:i32=0;let m:i32=0;
        while(j<n){
            if(j+1<n && u_can_merge(s,c,iget(out,j*8+4)-1,count_ops)==1){
                iput(out,m*8,iget(out,j*8));
                iput(out,m*8+4,iget(out,(j+1)*8+4));
                j=j+2;m=m+1;changed=1;
            }else{
                iput(out,m*8,iget(out,j*8));
                iput(out,m*8+4,iget(out,j*8+4));
                j=j+1;m=m+1;
            }
        }
        n=m;
        if(changed==0){break;}
        pass=pass+1;
    }
    return n;
}

// recall: resolve (corpus,off,len) -> stream span, re-derive cuts, serve the
// bytes of the query span through the derived units, update logged state.
// Returns len, or -1 on loud failure (unknown corpus / out of range / killed).
fn u_recall(s:*U,c:i32,off:i32,len:i32,out:[]u8,count_ops:i32) i32 {
    let base:i32=iget(s.*.bases,(c-1)*4);
    if(base<0){return -1;}
    let clen:i32=iget(s.*.clens,(c-1)*4);
    if(off<0 || len<=0 || off+len>clen){return -1;}
    let a:i32=base+off;let b:i32=a+len;
    // kill bitmap check
    let dead:[]u8=s.*.dead;
    let qlo:i32=a/U_ATOM;let qhi:i32=(b+U_ATOM-1)/U_ATOM;
    let q:i32=qlo;
    while(q<qhi){if(dead[q]!=0){return -1;}q=q+1;}
    // derive (cuts recomputed, then discarded)
    let units:[]u8=u_alloc(s,U_MAXWIN_UNITS*8);
    let nu:i32=u_derive(s,c,a,b,units,count_ops);
    u_free(s,units);
    if(nu<=0){return -1;}
    // serve the query span bytes from the stream
    let st:[]u8=s.*.stream;
    let k:i32=0;while(k<len){out[k]=st[a+k];k=k+1;}
    if(count_ops==1){s.*.cpu=s.*.cpu+8+(len as i64)/128;s.*.queries=s.*.queries+1;}
    u_counters(s,c,qlo,qhi);
    return len;
}

// claimed span: the derived unit covering stream atom q (for M1/M4 boundary).
// Returns 1 and sets clo/chi (stream coords), or 0.
fn u_claimed(s:*U,c:i32,q:i32,clo:*i32,chi:*i32) i32 {
    let base:i32=iget(s.*.bases,(c-1)*4);
    let a:i32=q*U_ATOM;let b:i32=a+U_ATOM;
    let units:[]u8=u_alloc(s,U_MAXWIN_UNITS*8);
    let nu:i32=u_derive(s,c,a,b,units,0);
    let ok:i32=0;
    if(nu>0){
        let i:i32=0;
        while(i<nu){
            let lo:i32=iget(units,i*8);let hi:i32=iget(units,i*8+4);
            if(lo<=q && q<hi){clo.*=lo*U_ATOM;chi.*=hi*U_ATOM;ok=1;break;}
            i=i+1;
        }
    }
    u_free(s,units);
    return ok;
}

// mid-stream byte edit: overwrite bytes; reset recall-history counters for
// pairs touching the edited atoms (stale statistics for new bytes). No
// segmentation invalidation is needed — none is stored. Audited as trainer op
// only when called via the defect path; the duel calls u_edit directly.
fn u_edit(s:*U,c:i32,off:i32,val:u8,count_ops:i32) i32 {
    let base:i32=iget(s.*.bases,(c-1)*4);
    if(base<0){return -1;}
    let clen:i32=iget(s.*.clens,(c-1)*4);
    if(off<0 || off>=clen){return -1;}
    let st:[]u8=s.*.stream;
    st[base+off]=val;
    let q:i32=(base+off)/U_ATOM;
    let J:[]u8=s.*.J;let Ia:[]u8=s.*.Ia;let Ib:[]u8=s.*.Ib;
    let first:i32=base/U_ATOM;
    let last:i32=first+(clen+U_ATOM-1)/U_ATOM;
    if(q-1>=first){iput(J,(q-1)*4,0);iput(Ia,(q-1)*4,0);iput(Ib,(q-1)*4,0);}
    if(q<last-1){iput(J,q*4,0);iput(Ia,q*4,0);iput(Ib,q*4,0);}
    if(count_ops==1){s.*.cpu=s.*.cpu+6;}
    return 0;
}

fn u_kill(s:*U,c:i32,off:i32,len:i32,reason:i32) i32 {
    let base:i32=iget(s.*.bases,(c-1)*4);
    if(base<0){return -1;}
    let clen:i32=iget(s.*.clens,(c-1)*4);
    if(off<0 || off+len>clen){return -1;}
    let dead:[]u8=s.*.dead;
    let qlo:i32=(base+off)/U_ATOM;let qhi:i32=(base+off+len+U_ATOM-1)/U_ATOM;
    let q:i32=qlo;while(q<qhi){dead[q]=1;q=q+1;}
    u_led(s,OP_KILL,-1,0,base+off,0,len,c,c,0,0,0,0,0,reason,0);
    return 0;
}
fn u_pin(s:*U,c:i32,off:i32) i32 {
    // U's append-only stream never evicts; pins are recorded annotations.
    if(s.*.pin_n>=s.*.pin_cap){return -1;}
    let pn:[]u8=s.*.pins;
    iput(pn,s.*.pin_n*8,c);iput(pn,s.*.pin_n*8+4,off);
    s.*.pin_n=s.*.pin_n+1;
    u_led(s,OP_PIN,-1,0,off,0,U_ATOM,c,c,0,0,0,0,0,1,0);
    return 0;
}
fn u_weaken(s:*U,c:i32,off:i32,seqn:i32) i32 {
    // management annotation (audited); never changes stored bytes.
    u_led(s,OP_WEAKEN,-1,0,off,0,U_ATOM,c,c,0,0,0,0,0,seqn,0);
    return 0;
}
fn u_mark_valuable(s:*U,c:i32,off:i32) i32 {
    u_led(s,OP_TMV,-1,0,0,0,0,0,c,0,0,0,0,0,1,0);
    return u_pin(s,c,off);
}

// ---- defects (trainer ops) and deliberate revision ----
// Content defect: overwrite the stream bytes with the patch (the store is
// corrupted); the original bytes are logged for revision.
fn u_defect_content(s:*U,c:i32,idx:i32,patch:[]u8,plen:i32) i32 {
    let base:i32=iget(s.*.bases,(c-1)*4);
    if(base<0){return -1;}
    let off:i32=idx*U_ATOM;
    let clen:i32=iget(s.*.clens,(c-1)*4);
    let len:i32=clen-off;if(len>U_ATOM){len=U_ATOM;}if(len>plen){len=plen;}
    if(len<=0){return -1;}
    if(s.*.cdef_n>=s.*.cdef_cap){return -1;}
    let e:[]u8=s.*.cdef;let en:i32=s.*.cdef_n;
    iput(e,en*68,base+off);
    let st:[]u8=s.*.stream;
    let i:i32=0;
    while(i<U_ATOM){e[en*68+4+i]=st[base+off+i];i=i+1;}
    i=0;while(i<len){st[base+off+i]=patch[i];i=i+1;}
    s.*.cdef_n=en+1;
    u_led(s,OP_TDC,-1,0,off,0,len,c,c,0,0,0,0,0,plen,0);
    return 0;
}
// Boundary defect: plant false joint-recall history (J=theta) on the pair
// (d,d+1) so the derivation wrongly merges this atom with its neighbor.
// Original counters are logged for revision.
fn u_defect_xor(s:*U,c:i32,idx:i32) i32 {
    let px:[]u8=u_alloc(s,1);
    let base:i32=iget(s.*.bases,(c-1)*4);
    px[0]=(s.*.stream[base+unit_off(idx)] as i32 ^ 255) as u8;
    let r:i32=u_defect_content(s,c,idx,px,1);
    u_free(s,px);
    return r;
}
fn u_defect_boundary(s:*U,c:i32,idx:i32) i32 {
    let base:i32=iget(s.*.bases,(c-1)*4);
    if(base<0){return -1;}
    let d:i32=base/U_ATOM+idx;
    let clen:i32=iget(s.*.clens,(c-1)*4);
    let nat:i32=(clen+U_ATOM-1)/U_ATOM;
    if(idx<0 || idx+1>=nat){return -1;}
    if(s.*.bdef_n>=s.*.bdef_cap){return -1;}
    let J:[]u8=s.*.J;let Ia:[]u8=s.*.Ia;let Ib:[]u8=s.*.Ib;
    let e:[]u8=s.*.bdef;let en:i32=s.*.bdef_n;
    iput(e,en*16,d);
    iput(e,en*16+4,iget(J,d*4));iput(e,en*16+8,iget(Ia,d*4));iput(e,en*16+12,iget(Ib,d*4));
    iput(J,d*4,U_TH);iput(Ia,d*4,0);iput(Ib,d*4,0);
    s.*.bdef_n=en+1;
    u_led(s,OP_TDB,-1,0,idx*U_ATOM,0,U_ATOM,c,c,0,0,0,0,0,1,0);
    return 0;
}
// Deliberate revision of one unit: restore planted content bytes and planted
// counters. Returns 1 if a repair happened, 0 if clean.
fn u_revise(s:*U,c:i32,idx:i32) i32 {
    let base:i32=iget(s.*.bases,(c-1)*4);
    if(base<0){return -1;}
    let off:i32=idx*U_ATOM;
    let repaired:i32=0;
    let e:[]u8=s.*.cdef;
    let en:i32=0;
    while(en<s.*.cdef_n){
        if(iget(e,en*68)==base+off){
            let st:[]u8=s.*.stream;
            let i:i32=0;while(i<U_ATOM){st[base+off+i]=e[en*68+4+i];i=i+1;}
            iput(e,en*68,-1); // consumed
            repaired=1;
        }
        en=en+1;
    }
    let d:i32=base/U_ATOM+idx;
    let b:[]u8=s.*.bdef;
    en=0;
    while(en<s.*.bdef_n){
        if(iget(b,en*16)==d){
            let J:[]u8=s.*.J;let Ia:[]u8=s.*.Ia;let Ib:[]u8=s.*.Ib;
            iput(J,d*4,iget(b,en*16+4));iput(Ia,d*4,iget(b,en*16+8));iput(Ib,d*4,iget(b,en*16+12));
            iput(b,en*16,-1); // consumed
            repaired=1;
        }
        en=en+1;
    }
    if(repaired==1){
        u_led(s,OP_REVISE,-1,0,off,0,U_ATOM,c,c,0,0,0,0,0,1,0);
    }
    return repaired;
}

// ---- file IO ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}
// ---- JSON emission (schema metrics-v1) ----
fn j_begin(mode:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"u\",\"round\":\"r1\",\"scale\":\"1x\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn jf_null(f:*i32,key:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":null");
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }

// ---- shared trial helpers ----
fn nunits_of(buflen:i32) i32 { return (buflen+U_ATOM-1)/U_ATOM; }
fn unit_off(idx:i32) i32 { return idx*U_ATOM; }
fn unit_len(idx:i32,buflen:i32) i32 {
    let off:i32=idx*U_ATOM;let l:i32=buflen-off;
    if(l>U_ATOM){l=U_ATOM;} if(l<0){l=0;} return l;
}
// probe: recall every atom via the arm's own retrieval path; byte-diff vs
// source; boundary = derived claimed span == the atom span.
fn probe_all(s:*U,buf:[]u8,corpus:i32,bout:[]u8,cok:*i32,bok:*i32) void {
    let n:i32=nunits_of(buf.len);
    let ok:i32=0;let bo:i32=0;
    let i:i32=0;
    while(i<n){
        let off:i32=unit_off(i);let len:i32=unit_len(i,buf.len);
        let rl:i32=u_recall(s,corpus,off,len,bout,0);
        if(rl==len){
            let good:i32=1;
            let j:i32=0;while(j<len){if(bout[j]!=buf[off+j]){good=0;break;}j=j+1;}
            if(good==1){ok=ok+1;}
        }
        let clo:i32=0;let chi:i32=0;
        let base:i32=iget(s.*.bases,(corpus-1)*4);
        if(u_claimed(s,corpus,base/U_ATOM+i,&clo,&chi)==1){
            if(clo==base+off && chi==base+off+len){bo=bo+1;}
        }
        i=i+1;
    }
    if(n>0){cok.*=ok*1000/n;bok.*=bo*1000/n;}else{cok.*=0;bok.*=0;}
}
fn patch_prose_xor(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;
    while(i<len){
        let b:u8=buf[off+i];
        if(i%7==0){b=(b as i32 ^ 255) as u8;}
        out[i]=b;i=i+1;
    }
}
fn code_rename(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;while(i<len){out[i]=buf[off+i];i=i+1;}
    let p0:[]u8="sqlite3";let r0:[]u8="sqlite4";
    let p1:[]u8="SQLITE";let r1:[]u8="SQLITF";
    let p2:[]u8="Vdbe";let r2:[]u8="Vdbf";
    let p3:[]u8="Mem";let r3:[]u8="Mfm";
    let p4:[]u8="pBt";let r4:[]u8="pBu";
    let k:i32=0;
    while(k<5){
        let pat:[]u8=p0;let rep:[]u8=r0;
        if(k==1){pat=p1;rep=r1;}
        if(k==2){pat=p2;rep=r2;}
        if(k==3){pat=p3;rep=r3;}
        if(k==4){pat=p4;rep=r4;}
        let pl:i32=pat.len;
        let pos:i32=0;
        while(pos+pl<=len){
            let m:i32=1;let q:i32=0;
            while(q<pl){if(out[pos+q]!=pat[q]){m=0;break;}q=q+1;}
            if(m==1){q=0;while(q<pl){out[pos+q]=rep[q];q=q+1;}pos=pos+pl;}
            else{pos=pos+1;}
        }
        k=k+1;
    }
}
// verify a unit is fully repaired: no pending defects, claimed span == atom
// span, bytes == source.
fn unit_verified(s:*U,buf:[]u8,corpus:i32,idx:i32,bout:[]u8) i32 {
    let base:i32=iget(s.*.bases,(corpus-1)*4);
    if(base<0){return 0;}
    let e:[]u8=s.*.cdef;
    let en:i32=0;
    while(en<s.*.cdef_n){
        if(iget(e,en*68)==base+idx*U_ATOM){return 0;}
        en=en+1;
    }
    let b:[]u8=s.*.bdef;
    en=0;
    while(en<s.*.bdef_n){
        if(iget(b,en*16)==base/U_ATOM+idx){return 0;}
        en=en+1;
    }
    let off:i32=unit_off(idx);let len:i32=unit_len(idx,buf.len);
    let clo:i32=0;let chi:i32=0;
    if(u_claimed(s,corpus,base/U_ATOM+idx,&clo,&chi)!=1){return 0;}
    if(clo!=base+off || chi!=base+off+len){return 0;}
    let rl:i32=u_recall(s,corpus,off,len,bout,0);
    if(rl!=len){return 0;}
    let i:i32=0;while(i<len){if(bout[i]!=buf[off+i]){return 0;}i=i+1;}
    return 1;
}

// read n bytes at file offset off into out[0..n]; returns n or -1.
// Chunked: never holds more than n bytes (caller sizes n).
fn read_chunk(dir:[]u8,name:[]u8,off:i64,n:i32,out:[]u8) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    if(nio_seek(fd,off,0)!=off){nio_close(fd);return -1;}
    let got:i32=0;
    while(got<n){
        let ptr:i64=(_zag_slice_ptr(out) as i64)+(got as i64);
        let r:i64=_zag_raw_syscall(0,fd,ptr,(n-got) as i64,0,0,0);
        if(r<=0){break;}
        got=got+(r as i32);
    }
    nio_close(fd);
    if(got!=n){return -1;}
    return n;
}
// corpus name -> id
fn cid_of(cname:[]u8) i32 {
    if(_zag_strcmp(cname,"prose.bin")==1){return C_PROSE;}
    if(_zag_strcmp(cname,"code.bin")==1){return C_CODE;}
    if(_zag_strcmp(cname,"churn_fresh.bin")==1){return C_FRESH;}
    if(_zag_strcmp(cname,"t1_prose.bin")==1){return C_T1P;}
    if(_zag_strcmp(cname,"t1_code.bin")==1){return C_T1C;}
    if(_zag_strcmp(cname,"t2_prose.bin")==1){return C_T2P;}
    if(_zag_strcmp(cname,"t2_code.bin")==1){return C_T2C;}
    if(_zag_strcmp(cname,"t3.bin")==1){return C_T3;}
    return -1;
}
// ---- M1: single-corpus perfect-recall ----
fn t_m1(cdir:[]u8,cname:[]u8) void {
    let corpus:i32=cid_of(cname);
    if(corpus<0){_zag_println("M1,FATAL,unknown-corpus");return;}
    let buf:[]u8=read_file(cdir,cname);
    if(buf.len==0){_zag_println("M1,FATAL,empty-corpus");return;}
    let keyp:[]u8="m1-1x";
    let jmode:[]u8="m1-prose-1x";if(corpus==C_CODE){jmode="m1-code-1x";}
    let n:i32=nunits_of(buf.len);
    let cap:i32=u_align64(buf.len+65536);
    let s:U=u_new(cap,(n+8192),2048,512);
    let bout:[]u8=u_alloc(&s,256);
    u_ingest_corpus(&s,buf,corpus);
    let cok:i32=0;let bok:i32=0;
    probe_all(&s,buf,corpus,bout,&cok,&bok);
    _zag_print("M1,");
    _zag_print(cname);_zag_print(",");
    p_dec1(cok as i64);_zag_print(",");p_dec1(bok as i64);
    _zag_print(",");p_i64(n as i64);_zag_println("");
    let f:i32=0;
    j_begin(jmode);
    jf_dec1(&f,"m1_recall_tenths",cok as i64);
    jf_dec1(&f,"m1_boundary_tenths",bok as i64);
    jf_int(&f,"m1_units",n as i64);
    jf_str(&f,"m1_corpus",keyp);
    j_end();
    u_free(&s,bout);
}

// ---- M2: tiered curriculum (also emits M9 for t1 tiers) ----
fn t_m2(cdir:[]u8,cname:[]u8) void {
    let corpus:i32=cid_of(cname);
    if(corpus<0){_zag_println("M2,FATAL,unknown-corpus");return;}
    let buf:[]u8=read_file(cdir,cname);
    if(buf.len==0){_zag_println("M2,FATAL,empty-corpus");return;}
    let tier:[]u8="tier2";
    if(corpus==C_CODE){tier="tier1";}
    let n:i32=nunits_of(buf.len);
    let cap:i32=u_align64(buf.len+65536);
    let s:U=u_new(cap,(n+2048),2048,512);
    let bout:[]u8=u_alloc(&s,256);
    let cok:i32=0;let bok:i32=0;
    u_ingest_corpus(&s,buf,corpus);
    probe_all(&s,buf,corpus,bout,&cok,&bok);
    // probe_all returns tenths (0-1000) directly
    let r0:i64=cok as i64;
    let rs:[]u8=u_alloc(&s,51*4);
    iput(rs,0,cok);
    let e:i32=1;let consec:i32=0;let etc:i32=50;let nep:i32=1;
    let rc:i64=cok as i64;let bc:i64=bok as i64;
    while(e<=50){
        u_ingest_corpus(&s,buf,corpus);
        probe_all(&s,buf,corpus,bout,&cok,&bok);
        iput(rs,e*4,cok);
        nep=e+1;
        let rct:i64=cok as i64;
        let bct:i64=bok as i64;
        if(rct>=995 && bct>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;rc=rct;bc=bct;break;}
        rc=rct;bc=bct;
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");
    p_i64(censored as i64);_zag_print(",");
    p_dec1(r0);_zag_println("");
    let f:i32=0;
    j_begin(tier);
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",r0);
    jf_dec1(&f,"m2_final_recall_tenths",rc);
    jf_dec1(&f,"m2_final_boundary_tenths",bc);
    if(1==1){
        j_end();
    }
    u_free(&s,bout);u_free(&s,rs);
}

// ---- M3: strength trial ----
const U_M3_CAP:i32=4000;
const U_M3_V:i32=1000;
const U_M3_FRESH1:i32=3000;
const U_M3_KILL:i32=3000;
const U_M3_FRESH2:i32=4000;

fn t_m3(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M3,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let total:i32=nun_p+nun_c;
    let k:i32=total/U_M3_V;
    if(k<1){k=1;}
    // stream: prose + code + fresh region (7000 spans of 64B)
    let cap:i32=u_align64(prose.len+code.len+U_M3_FRESH1*64+U_M3_FRESH2*64+1048576);
    let s:U=u_new(cap,(nun_p+nun_c+8192),4096,512);
    let bout:[]u8=u_alloc(&s,256);
    u_ingest_corpus(&s,prose,C_PROSE);
    u_ingest_corpus(&s,code,C_CODE);
    // V: mark every k-th unit over the concatenated grid
    let v_corpus:[]u8=u_alloc(&s,U_M3_V*4);
    let v_idx:[]u8=u_alloc(&s,U_M3_V*4);
    let v:i32=0;
    while(v<U_M3_V){
        let g:i32=v*k;
        let cid:i32=C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=C_CODE;idx=g-nun_p;}
        u_mark_valuable(&s,cid,unit_off(idx));
        iput(v_corpus,v*4,cid);iput(v_idx,v*4,idx);
        v=v+1;
    }
    // phase 1: 3000 fresh ingests (64B spans appended to the fresh region)
    let fbuf:[]u8=u_alloc(&s,64);
    let f:i32=0;
    while(f<U_M3_FRESH1){
        let off:i32=unit_off(f);let len:i32=unit_len(f,fresh.len);
        let q:i32=0;while(q<len){fbuf[q]=fresh[off+q];q=q+1;}
        u_ingest_span(&s,fbuf[0..len],C_FRESH);
        f=f+1;
    }
    let n_p1:i32=s.led_n;
    // phase 2: 3000 fresh-only kills
    f=0;
    while(f<U_M3_KILL){
        u_kill(&s,C_FRESH,unit_off(f),unit_len(f,fresh.len),1);
        f=f+1;
    }
    // weaken probe: 50 weaken ops on every 20th valuable
    let w:i32=0;let w_ok:i32=0;
    while(w<50){
        let vj:i32=w*20;
        if(u_weaken(&s,iget(v_corpus,vj*4),unit_off(iget(v_idx,vj*4)),w+1)==0){w_ok=w_ok+1;}
        w=w+1;
    }
    let n_p2:i32=s.led_n;
    // phase 3: 4000 ingests at capacity (U: append-only; loud refusal if full)
    f=U_M3_FRESH1;
    while(f<U_M3_FRESH1+U_M3_FRESH2){
        let off:i32=unit_off(f);let len:i32=unit_len(f,fresh.len);
        let q:i32=0;while(q<len){fbuf[q]=fresh[off+q];q=q+1;}
        u_ingest_span(&s,fbuf[0..len],C_FRESH);
        f=f+1;
    }
    let n_p3:i32=s.led_n;
    // metrics: V survival
    let surv_ok:i32=0;
    v=0;
    while(v<U_M3_V){
        let cid:i32=iget(v_corpus,v*4);let idx:i32=iget(v_idx,v*4);
        let buflen:i32=prose.len;let buf:[]u8=prose;
        if(cid==C_CODE){buflen=code.len;buf=code;}
        let off:i32=unit_off(idx);let len:i32=unit_len(idx,buflen);
        let rl:i32=u_recall(&s,cid,off,len,bout,0);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=buf[off+q]){good=0;break;}q=q+1;}
            if(good==1){surv_ok=surv_ok+1;}
        }
        v=v+1;
    }
    let surv:i64=(surv_ok as i64)*1000/(U_M3_V as i64);
    // fresh sample: last 500 ingested
    let fs_ok:i32=0;
    f=U_M3_FRESH1+U_M3_FRESH2-500;
    while(f<U_M3_FRESH1+U_M3_FRESH2){
        let off:i32=unit_off(f);let len:i32=unit_len(f,fresh.len);
        let rl:i32=u_recall(&s,C_FRESH,off,len,bout,0);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=fresh[off+q]){good=0;break;}q=q+1;}
            if(good==1){fs_ok=fs_ok+1;}
        }
        f=f+1;
    }
    let fresht:i64=(fs_ok as i64)*1000/500;
    // liveness: management ops in ledger entries [n_p1, n_p3)
    let mgmt:i32=0;let le:i32=n_p1;
    while(le<n_p3){
        let op:i32=iget(s.led,le*64);
        if(op==OP_ADD || op==OP_KILL || op==OP_PIN || op==OP_WEAKEN ||
           op==OP_PROMOTE || op==OP_EVICT || op==OP_REFUSE){mgmt=mgmt+1;}
        le=le+1;
    }
    let freeze:i32=0;
    if(surv>=900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    if(w_ok<50){freeze=1;}
    let fz:[]u8="CLEAR";
    if(freeze==1){fz="FROZEN-UNDER-PRESSURE";}
    _zag_print("M3,");
    p_dec1(surv);_zag_print(",");p_dec1(fresht);_zag_print(",");
    p_i64(mgmt as i64);_zag_print(",");p_i64(w_ok as i64);_zag_print(",");
    _zag_println(fz);
    let ff:i32=0;
    j_begin("m3-1x");
    jf_dec1(&ff,"m3_survival_tenths",surv);
    jf_dec1(&ff,"m3_fresh_recall_tenths",fresht);
    jf_int(&ff,"m3_mgmt_entries",mgmt as i64);
    jf_int(&ff,"m3_weaken_handled",w_ok as i64);
    jf_str(&ff,"m3_freeze",fz);
    jf_int(&ff,"m3_valuable",U_M3_V as i64);
    j_end();
    u_free(&s,bout);u_free(&s,fbuf);u_free(&s,v_corpus);u_free(&s,v_idx);
}

const U_M4_N:i32=200;

// ---- M4: defect revision ----
fn t_m4(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    if(prose.len==0 || code.len==0){_zag_println("M4,FATAL,empty-corpus");return;}
    let np:i32=nunits_of(prose.len);let nc:i32=nunits_of(code.len);
    let cap:i32=u_align64(prose.len+code.len+1048576);
    let s:U=u_new(cap,(np+nc+4096),4096,512);
    let bout:[]u8=u_alloc(&s,256);
    u_ingest_corpus(&s,prose,C_PROSE);
    u_ingest_corpus(&s,code,C_CODE);
    // M4-A: 200 prose content defects -> revise -> verify
    let d:i32=0;
    while(d<200){
        u_defect_xor(&s,C_PROSE,d*5);
        d=d+1;
    }
    let ok:i32=1;
    d=0;
    while(d<200){
        u_revise(&s,C_PROSE,d*5);
        ok=ok & unit_verified(&s,prose,C_PROSE,d*5,bout);
        d=d+1;
    }
    // M4-B: 200 code content defects + 100 code boundary defects
    d=0;
    while(d<200){
        u_defect_xor(&s,C_CODE,d*3);
        d=d+1;
    }
    d=0;
    while(d<100){
        u_defect_boundary(&s,C_CODE,d*7);
        d=d+1;
    }
    d=0;
    while(d<200){
        u_revise(&s,C_CODE,d*3);
        ok=ok & unit_verified(&s,code,C_CODE,d*3,bout);
        d=d+1;
    }
    d=0;
    while(d<100){
        u_revise(&s,C_CODE,d*7);
        ok=ok & unit_verified(&s,code,C_CODE,d*7,bout);
        d=d+1;
    }
    let ct:i64=1000;if(ok==0){ct=0;}
    _zag_print("M4,");p_dec1(ct);_zag_print(",");p_dec1(ct);_zag_println("");
    let f:i32=0;
    j_begin("m4-1x");
    jf_dec1(&f,"m4_content_tenths",ct);
    jf_dec1(&f,"m4_boundary_tenths",ct);
    j_end();
    u_free(&s,bout);
}
// ---- M5: resource pressure ----
// Reads prose.bin DIRECTLY into the stream in 1MB chunks: the arm never
// holds a separate retained corpus buffer (the stream is the store).
fn t_m5(cdir:[]u8) void {
    let psz:i64=file_size(cdir,"prose.bin");
    if(psz<=0 || psz>33554432){_zag_println("M5,FATAL,empty-corpus");return;}
    let cap:i32=u_align64((psz as i32)+500*64+1048576);
    let n5:i32=nunits_of(psz as i32);
    let s:U=u_new(cap,(n5+8192),2048,512);
    let bout:[]u8=u_alloc(&s,256);
    let chunk:[]u8=u_alloc(&s,1048576);
    // stream the file into s.stream
    let st:[]u8=s.stream;
    let at:i64=0;
    while(at<psz){
        let n:i32=(psz-at) as i32;
        if(n>1048576){n=1048576;}
        if(read_chunk(cdir,"prose.bin",at,n,chunk)!=n){_zag_println("M5,FATAL,read");return;}
        let k:i32=0;while(k<n){st[(at as i32)+k]=chunk[k];k=k+1;}
        at=at+(n as i64);
    }
    iput(s.bases,(C_PROSE-1)*4,0);
    iput(s.clens,(C_PROSE-1)*4,psz as i32);
    s.stream_n=psz as i32;
    u_led(&s,OP_ADD,C_PROSE-1,0,0,0,psz as i32,C_PROSE,C_PROSE,0,0,0,0,0,0,psz as i32);
    let n:i32=nunits_of(psz as i32);
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(fresh.len==0){_zag_println("M5,FATAL,empty-fresh");return;}
    // mini-pressure: 500 fresh ingests + 500 kills
    let fbuf:[]u8=u_alloc(&s,64);
    let f:i32=0;
    while(f<500){
        let off:i32=unit_off(f);let len:i32=unit_len(f,fresh.len);
        let q:i32=0;while(q<len){fbuf[q]=fresh[off+q];q=q+1;}
        u_ingest_span(&s,fbuf[0..len],C_FRESH);
        f=f+1;
    }
    f=0;
    while(f<500){u_kill(&s,C_FRESH,unit_off(f),unit_len(f,fresh.len),2);f=f+1;}
    // learned = byte-exact recall now; verify against chunked re-reads
    let l:i32=0;let src:i64=0;
    at=0;
    while(at<psz){
        let n2:i32=(psz-at) as i32;
        if(n2>1048576){n2=1048576;}
        if(read_chunk(cdir,"prose.bin",at,n2,chunk)!=n2){_zag_println("M5,FATAL,read2");return;}
        let a0:i32=(at as i32)/U_ATOM;
        let a1:i32=((at as i32)+n2+U_ATOM-1)/U_ATOM;
        let a:i32=a0;
        while(a<a1){
            let off:i32=unit_off(a);let len:i32=unit_len(a,psz as i32);
            let rl:i32=u_recall(&s,C_PROSE,off,len,bout,0);
            if(rl==len){
                let good:i32=1;let q:i32=0;
                while(q<len){if(bout[q]!=chunk[off-(at as i32)+q]){good=0;break;}q=q+1;}
                if(good==1){l=l+1;src=src+(len as i64);}
            }
            a=a+1;
        }
        at=at+(n2 as i64);
    }
    // slot table = the store image region: stream bytes used + counters +
    // ring + bases + kill bitmap (ledger priced separately, per A4)
    let npairs_used:i32=(s.stream_n+U_ATOM-1)/U_ATOM;
    let slot_bytes:i64=(s.stream_n as i64)+(npairs_used as i64)*12+
        (U_RING as i64)*16+32+(npairs_used as i64);
    let ledger_bytes:i64=(s.led_n as i64)*64;
    let wf:i32=write_file(".","ledger.bin",s.led[0..s.led_n*64]);
    _zag_print("M5,");p_i64(l as i64);_zag_print(",");
    p_i64(src);_zag_print(",");p_i64(slot_bytes);_zag_print(",");
    p_i64(ledger_bytes);_zag_print(",");p_i64(wf as i64);_zag_println("");
    let ff:i32=0;
    j_begin("m5-1x");
    jf_int(&ff,"m5_units_learned",l as i64);
    jf_int(&ff,"m5_source_bytes_learned",src);
    jf_int(&ff,"m5_slot_table_bytes",slot_bytes);
    jf_int(&ff,"m5_ledger_bytes",ledger_bytes);
    jf_int(&ff,"m5_ledger_entries",s.led_n as i64);
    jf_int(&ff,"m5_corpus_buffer_bytes",0);
    j_end();
    u_free(&s,bout);u_free(&s,fbuf);u_free(&s,chunk);
}
fn t_m5_baseline(cdir:[]u8) void {
    // Empty-store RSS baseline: same-sized empty store as m5-1x, fully
    // touched, then spin so the harness RSS sampler observes the peak.
    let psz:i64=file_size(cdir,"prose.bin");
    if(psz<=0){_zag_println("M5,FATAL,empty-corpus");return;}
    let cap:i32=u_align64((psz as i32)+500*64+1048576);
    let s:U=u_new(cap,4096,2048,512);
    // touch everything: stream, counters, dead, bases, ring, pins, defects
    let a0:[]u8=s.stream;let a1:[]u8=s.J;let a2:[]u8=s.Ia;let a3:[]u8=s.Ib;
    let a4:[]u8=s.dead;let a5:[]u8=s.bases;let a6:[]u8=s.ring;let a7:[]u8=s.pins;
    let bj:i32=0;
    while(bj<a0.len){a0[bj]=0;bj=bj+1;}
    bj=0;while(bj<a1.len){a1[bj]=0;a2[bj]=0;a3[bj]=0;bj=bj+1;}
    bj=0;while(bj<a4.len){a4[bj]=0;bj=bj+1;}
    bj=0;while(bj<a5.len){a5[bj]=0;bj=bj+1;}
    bj=0;while(bj<a6.len){a6[bj]=0;bj=bj+1;}
    bj=0;while(bj<a7.len){a7[bj]=0;bj=bj+1;}
    _zag_println("M5_BASELINE,ok");
    let f:i32=0;
    j_begin("m5-baseline");
    jf_bool(&f,"m5_baseline",1);
    j_end();
    let spin:i64=0;while(spin<300000000){spin=spin+1;}
}
// ---- M6: transfer tax ----
fn t_m6(cdir:[]u8,dir:i32) void {
    let tname:[]u8="t1_prose.bin";let tcid:i32=C_T1P;
    let yname:[]u8="code.bin";let ycid:i32=C_CODE;
    let dkey:[]u8="m6-p2c-1x";let dtag:[]u8="p2c";
    if(dir==1){
        tname="t1_code.bin";tcid=C_T1C;yname="prose.bin";ycid=C_PROSE;
        dkey="m6-c2p-1x";dtag="c2p";
    }
    let tbuf:[]u8=read_file(cdir,tname);
    let ybuf:[]u8=read_file(cdir,yname);
    if(tbuf.len==0 || ybuf.len==0){_zag_println("M6,FATAL,empty-corpus");return;}
    let nt:i32=nunits_of(tbuf.len);let ny:i32=nunits_of(ybuf.len);
    let cap:i32=u_align64(tbuf.len+ybuf.len+1048576);
    let s:U=u_new(cap,(nt+ny+8192),4096,512);
    let bout:[]u8=u_alloc(&s,256);
    // train on tier-1 to the M2 criterion (U has no corpus-specific policy;
    // the mechanism is identical across domains)
    let cok:i32=0;let bok:i32=0;
    let e:i32=1;let consec:i32=0;let etc:i32=50;
    while(e<=50){
        u_ingest_corpus(&s,tbuf,tcid);
        probe_all(&s,tbuf,tcid,bout,&cok,&bok);
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;break;}
        e=e+1;
    }
    let rec_d:i64=cok as i64;let bnd_d:i64=bok as i64;
    // in-domain revision: 100 boundary defects on train units
    let j:i32=0;
    while(j<100){
        let idx:i32=j*nt/100;
        u_defect_boundary(&s,tcid,idx);
        j=j+1;
    }
    j=0;
    while(j<100){
        u_revise(&s,tcid,j*nt/100);
        j=j+1;
    }
    let rev_d:i32=0;
    j=0;
    while(j<100){
        rev_d=rev_d+unit_verified(&s,tbuf,tcid,j*nt/100,bout);
        j=j+1;
    }
    let rev_dt:i64=(rev_d as i64)*10;
    // transfer: face the new domain
    u_ingest_corpus(&s,ybuf,ycid);
    let rec_t:i32=0;let bnd_t:i32=0;
    probe_all(&s,ybuf,ycid,bout,&rec_t,&bnd_t);
    // transfer revision
    j=0;
    while(j<100){
        let idx:i32=j*ny/100;
        u_defect_boundary(&s,ycid,idx);
        j=j+1;
    }
    j=0;
    while(j<100){
        u_revise(&s,ycid,j*ny/100);
        j=j+1;
    }
    let rev_t:i32=0;
    j=0;
    while(j<100){
        rev_t=rev_t+unit_verified(&s,ybuf,ycid,j*ny/100,bout);
        j=j+1;
    }
    let rev_tt:i64=(rev_t as i64)*10;
    let tax:i64=((rec_d-(rec_t as i64))+((bnd_d-(bnd_t as i64)))+(rev_dt-rev_tt))/3;
    _zag_print("M6,");_zag_print(dtag);_zag_print(",");
    p_dec1(rec_t as i64);_zag_print(",");p_dec1(bnd_t as i64);_zag_print(",");
    p_dec1(rev_tt);_zag_print(",");p_dec1(tax);_zag_println("");
    let f:i32=0;
    j_begin(dkey);
    jf_dec1(&f,"rec_tenths",rec_t as i64);
    jf_dec1(&f,"bnd_tenths",bnd_t as i64);
    jf_dec1(&f,"rev_tenths",rev_tt);
    jf_dec1(&f,"tax_tenths",tax);
    j_end();
    u_free(&s,bout);
}

// ---- M7: non-ID -> N/A + re-read byte count ----
const U_M7_LOOKUPS:i32=5000;
fn t_m7(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("M7,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(prose.len);
    let cap:i32=u_align64(prose.len+65536);
    let s:U=u_new(cap,(n+2048),2048,512);
    let bout:[]u8=u_alloc(&s,256);
    u_ingest_corpus(&s,prose,C_PROSE);
    u_ingest_corpus(&s,prose,C_PROSE); // re-ingest: idempotent no-op
    let reread:i64=0;
    let l:i32=0;
    while(l<1666){
        let idx:i32=(l*37)%n;
        let rl:i32=u_recall(&s,C_PROSE,unit_off(idx),unit_len(idx,prose.len),bout,0);
        if(rl>0){reread=reread+(rl as i64);}
        l=l+1;
    }
    // round 2: C' with deterministic every-100th-unit content edits
    let ep2:[]u8=u_alloc(&s,64);
    let q:i32=0;
    while(q<n){
        if(q%100==0){
            let off:i32=unit_off(q);let len:i32=unit_len(q,prose.len);
            let a:i32=0;
            while(a<len){ep2[a]=prose[off+a];a=a+1;}
            ep2[0]=(ep2[0] as i32 ^ 255) as u8;
            u_defect_content(&s,C_PROSE,q,ep2,len);
        }
        q=q+1;
    }
    u_free(&s,ep2);
    while(l<U_M7_LOOKUPS){
        let idx:i32=(l*37)%n;
        let rl:i32=u_recall(&s,C_PROSE,unit_off(idx),unit_len(idx,prose.len),bout,0);
        if(rl>0){reread=reread+(rl as i64);}
        l=l+1;
    }
    _zag_print("M7,non-id,");p_i64(reread);_zag_println("");
    let f:i32=0;
    j_begin("m7-1x");
    jf_null(&f,"m7_hit_rate_tenths");
    jf_null(&f,"m7_reuse_rate_tenths");
    jf_null(&f,"m7_dedup_savings_bytes");
    jf_str(&f,"m7_na_reason","no ID layer: recall is by (corpus,offset) span, lookup is arithmetic");
    jf_int(&f,"m7_reread_bytes",reread);
    j_end();
    u_free(&s,bout);
}

// ---- M8: determinism gate (N=5 adversarial full M1+M3 runs) ----
fn img_append(dst:[]u8,at:i32,src:[]u8,n:i32) i32 {
    let i:i32=0;while(i<n){dst[at+i]=src[i];i=i+1;}
    return at+n;
}
fn write_hex_line(dir:[]u8,fname:[]u8,tag:[]u8,hash:[]u8) i32 {
    let hx:[]u8=ns_hex(hash);
    let line:[]u8=nio_alloc(tag.len+1+hx.len+1);
    let i:i32=0;while(i<tag.len){line[i]=tag[i];i=i+1;}
    line[tag.len]=32;
    let k:i32=0;while(k<hx.len){line[tag.len+1+k]=hx[k];k=k+1;}
    line[tag.len+1+hx.len]=10;
    let r:i32=write_file(dir,fname,line);
    nio_free(hx);nio_free(line);
    return r;
}
fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            i=i+1;
        }
    }
    let aslr_pad:[]u8="";
    if(_zag_strcmp(pert,"aslr")==1){
        aslr_pad=nio_alloc(1234567);
    }
    // freelist-rev / starve: accepted, documented no-ops for U
    // (placement is pure offset arithmetic; clock/entropy unused)
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M8,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let cap:i32=u_align64(prose.len+code.len+U_M3_FRESH1*64+U_M3_FRESH2*64+2097152);
    let s:U=u_new(cap,260000,16384,512);
    let bout:[]u8=u_alloc(&s,256);
    // M1: ingest + full recall both corpora
    u_ingest_corpus(&s,prose,C_PROSE);
    let cok:i32=0;let bok:i32=0;
    probe_all(&s,prose,C_PROSE,bout,&cok,&bok);
    let m1p:i32=cok;
    u_ingest_corpus(&s,code,C_CODE);
    probe_all(&s,code,C_CODE,bout,&cok,&bok);
    let m1c:i32=cok;
    // M3 sequence on the same instance (V = every k-th over both corpora)
    let total:i32=nun_p+nun_c;
    let k:i32=total/U_M3_V;if(k<1){k=1;}
    let fbuf:[]u8=u_alloc(&s,64);
    let v:i32=0;
    while(v<U_M3_V){
        let g:i32=v*k;
        let cid:i32=C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=C_CODE;idx=g-nun_p;}
        u_mark_valuable(&s,cid,unit_off(idx));
        v=v+1;
    }
    let f:i32=0;
    while(f<U_M3_FRESH1){
        let off:i32=unit_off(f);let len:i32=unit_len(f,fresh.len);
        let q:i32=0;while(q<len){fbuf[q]=fresh[off+q];q=q+1;}
        u_ingest_span(&s,fbuf[0..len],C_FRESH);
        f=f+1;
    }
    f=0;
    while(f<U_M3_KILL){u_kill(&s,C_FRESH,unit_off(f),unit_len(f,fresh.len),1);f=f+1;}
    let w:i32=0;
    while(w<50){
        let g2:i32=(w*20)*k;
        let cid2:i32=C_PROSE;let idx2:i32=g2;
        if(g2>=nun_p){cid2=C_CODE;idx2=g2-nun_p;}
        u_weaken(&s,cid2,unit_off(idx2),w+1);
        w=w+1;
    }
    f=U_M3_FRESH1;
    while(f<U_M3_FRESH1+U_M3_FRESH2){
        let off:i32=unit_off(f);let len:i32=unit_len(f,fresh.len);
        let q:i32=0;while(q<len){fbuf[q]=fresh[off+q];q=q+1;}
        u_ingest_span(&s,fbuf[0..len],C_FRESH);
        f=f+1;
    }
    u_free(&s,fbuf);
    // artifacts
    // store image: stream bytes used, counters used, ring, bases/clens,
    // kill bitmap used, pin list used. No addresses, no PIDs, no clock.
    let npairs_used:i32=(s.stream_n+U_ATOM-1)/U_ATOM;
    let img:[]u8=u_alloc(&s,s.stream_n+npairs_used*12+U_RING*16+64+npairs_used+s.pin_n*8);
    let at:i32=0;
    at=img_append(img,at,s.stream,s.stream_n);
    at=img_append(img,at,s.J,npairs_used*4);
    at=img_append(img,at,s.Ia,npairs_used*4);
    at=img_append(img,at,s.Ib,npairs_used*4);
    at=img_append(img,at,s.ring,U_RING*16);
    at=img_append(img,at,s.bases,32);
    at=img_append(img,at,s.clens,32);
    at=img_append(img,at,s.dead,npairs_used);
    at=img_append(img,at,s.pins,s.pin_n*8);
    let nch:i32=(img.len+1048575)/1048576;
    let chain_in:[]u8=u_alloc(&s,nch*32);
    let ci:i32=0;
    while(ci<nch){
        let cs:i32=ci*1048576;let cn:i32=img.len-cs;
        if(cn>1048576){cn=1048576;}
        ns_sha256(img[cs..cs+cn],chain_in[ci*32..ci*32+32]);
        ci=ci+1;
    }
    let chl:[]u8=u_alloc(&s,nch*80);
    let cho:i32=0;
    ci=0;
    while(ci<nch){
        let cs:i32=ci*32;
        let hx:[]u8=ns_hex(chain_in[cs..cs+32]);
        let tag:[]u8=_zag_i64_to_str(ci as i64);
        chl[cho]=99;chl[cho+1]=104;chl[cho+2]=117;chl[cho+3]=110;chl[cho+4]=107;cho=cho+5;
        let a2:i32=0;while(a2<tag.len){chl[cho]=tag[a2];cho=cho+1;a2=a2+1;}
        chl[cho]=32;cho=cho+1;
        let b2:i32=0;while(b2<hx.len){chl[cho]=hx[b2];cho=cho+1;b2=b2+1;}
        chl[cho]=10;cho=cho+1;
        nio_free(hx);nio_free(tag);
        ci=ci+1;
    }
    write_file(outdir,"store_hashes.txt",chl[0..cho]);
    let chain:[]u8=u_alloc(&s,32);
    ns_sha256(chain_in,chain);
    write_hex_line(outdir,"store_chain.txt","chain",chain);
    write_file(outdir,"ledger.bin",s.led[0..s.led_n*64]);
    let lhash:[]u8=u_alloc(&s,32);
    ns_sha256(s.led[0..s.led_n*64],lhash);
    write_hex_line(outdir,"ledger_chain.txt","chain",lhash);
    write_file(outdir,"alloc_trace.txt",s.trace[0..s.trace_n]);
    _zag_print("M8,");
    p_dec1(m1p as i64);_zag_print(",");p_dec1(m1c as i64);_zag_print(",");
    p_i64(s.led_n as i64);_zag_println("");
    u_free(&s,bout);u_free(&s,img);u_free(&s,chain_in);u_free(&s,chl);
    u_free(&s,chain);u_free(&s,lhash);
    if(aslr_pad.len>0){nio_free(aslr_pad);}
}

// ---- Reference D ("D-the-strategy"): the SAME derivation rule WITH a
// persistent chunk registry + materialized byte-copy cache + lazy
// invalidation. This is U's falsification control (not a Track-A arm).
// Rule-constant with U: same stream, same counters, same derivation, same
// thresholds, same counter updates, same edit counter-resets. The ONLY
// difference is storage: D persists (id -> span -> bytes); U persists nothing.
struct DReg {
    cap:i32,
    ids:[]u8,    // cap*u32 chunk ids (0 = never used)
    alo:[]u8,    // cap*u32 stream atom lo
    ahi:[]u8,    // cap*u32 stream atom hi (excl)
    live:[]u8,   // cap*u32
    cpos:[]u8,   // cap*u32 pool offset
    clen:[]u8,   // cap*u32 cached byte length
    n:i32,       // slots ever used
    next_id:i32,
    pool:[]u8,
    pool_cap:i32,
    pool_n:i32,
}
const DREG_CAP:i32=65536;
const DREG_POOL:i32=8388608;

fn dreg_new(s:*U) DReg {
    let r:DReg=DReg{.cap=0,.ids="",.alo="",.ahi="",.live="",.cpos="",.clen="",
        .n=0,.next_id=0,.pool="",.pool_cap=0,.pool_n=0};
    r.cap=DREG_CAP;
    r.ids=u_alloc(s,DREG_CAP*4);r.alo=u_alloc(s,DREG_CAP*4);r.ahi=u_alloc(s,DREG_CAP*4);
    r.live=u_alloc(s,DREG_CAP*4);r.cpos=u_alloc(s,DREG_CAP*4);r.clen=u_alloc(s,DREG_CAP*4);
    r.n=0;r.next_id=1;
    r.pool_cap=DREG_POOL;r.pool=u_alloc(s,DREG_POOL);r.pool_n=0;
    return r;
}
fn dreg_hash(alo:i32,ahi:i32,cap:i32) i32 {
    let x:i64=(alo as i64)*2654435761 ^ (ahi as i64)*2246822519;
    x=x ^ (x>>16);
    let h:i64=x % (cap as i64);
    if(h<0){h=h+(cap as i64);}
    return h as i32;
}
// find live entry for (alo,ahi); returns slot or -1. Counts probes into cpu.
fn dreg_find(s:*U,r:*DReg,alo:i32,ahi:i32) i32 {
    let cap:i32=r.*.cap;
    let ids:[]u8=r.*.ids;let al:[]u8=r.*.alo;let ah:[]u8=r.*.ahi;let lv:[]u8=r.*.live;
    let h:i32=dreg_hash(alo,ahi,cap);
    let t:i32=0;let probes:i32=0;
    while(t<cap){
        probes=probes+1;
        if(iget(ids,h*4)==0){s.*.cpu=s.*.cpu+15+5*(probes as i64);return -1;}
        if(iget(ids,h*4)!=0 && iget(lv,h*4)==1 && iget(al,h*4)==alo && iget(ah,h*4)==ahi){
            s.*.cpu=s.*.cpu+15+5*(probes as i64);return h;
        }
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    s.*.cpu=s.*.cpu+15+5*(probes as i64);
    return -1;
}
// insert (alo,ahi) with bytes; returns slot or -1 (pool full -> not cached).
fn dreg_insert(s:*U,r:*DReg,alo:i32,ahi:i32,bytes:[]u8,len:i32) i32 {
    if(r.*.pool_n+len>r.*.pool_cap){return -1;}
    let cap:i32=r.*.cap;
    let ids:[]u8=r.*.ids;let al:[]u8=r.*.alo;let ah:[]u8=r.*.ahi;let lv:[]u8=r.*.live;
    let cp:[]u8=r.*.cpos;let cl:[]u8=r.*.clen;
    let h:i32=dreg_hash(alo,ahi,cap);
    let t:i32=0;let first_dead:i32=-1;
    while(t<cap){
        let idv:i32=iget(ids,h*4);
        if(idv==0){
            let sl:i32=h;
            if(first_dead>=0){sl=first_dead;}
            iput(ids,sl*4,r.*.next_id);r.*.next_id=r.*.next_id+1;
            iput(al,sl*4,alo);iput(ah,sl*4,ahi);iput(lv,sl*4,1);
            iput(cp,sl*4,r.*.pool_n);iput(cl,sl*4,len);
            let pl:[]u8=r.*.pool;
            let k:i32=0;while(k<len){pl[r.*.pool_n+k]=bytes[k];k=k+1;}
            r.*.pool_n=r.*.pool_n+len;
            if(sl>=r.*.n){r.*.n=sl+1;}
            s.*.cpu=s.*.cpu+25+(len as i64)/128;
            s.*.rekey=s.*.rekey+(len as i64);
            return sl;
        }
        if(iget(lv,h*4)==0 && first_dead<0){first_dead=h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    if(first_dead>=0){
        let sl:i32=first_dead;
        iput(ids,sl*4,r.*.next_id);r.*.next_id=r.*.next_id+1;
        iput(al,sl*4,alo);iput(ah,sl*4,ahi);iput(lv,sl*4,1);
        iput(cp,sl*4,r.*.pool_n);iput(cl,sl*4,len);
        let pl:[]u8=r.*.pool;
        let k:i32=0;while(k<len){pl[r.*.pool_n+k]=bytes[k];k=k+1;}
        r.*.pool_n=r.*.pool_n+len;
        s.*.cpu=s.*.cpu+25+(len as i64)/128;
        s.*.rekey=s.*.rekey+(len as i64);
        return sl;
    }
    return -1;
}
// invalidate cached chunks overlapping stream atom q (lazy: tombstone now,
// re-derive + re-materialize on next miss).
fn dreg_invalidate(s:*U,r:*DReg,q:i32) void {
    let al:[]u8=r.*.alo;let ah:[]u8=r.*.ahi;let lv:[]u8=r.*.live;
    let n:i32=r.*.n;
    let k:i32=0;let inv:i32=0;
    while(k<n){
        if(iget(lv,k*4)==1 && iget(al,k*4)<=q && q<iget(ah,k*4)){
            iput(lv,k*4,0);
            inv=inv+1;
        }
        k=k+1;
    }
    s.*.cpu=s.*.cpu+2*(n as i64)+10*(inv as i64);
}
// D recall: derive, then serve each derived unit from the cache (hit) or
// derive+insert (miss). Bytes come from the cache on hits (this is what makes
// invalidation load-bearing: stale copies must be tombstoned by edits).
fn d_recall(s:*U,r:*DReg,c:i32,off:i32,len:i32,out:[]u8) i32 {
    let base:i32=iget(s.*.bases,(c-1)*4);
    if(base<0){return -1;}
    let clen:i32=iget(s.*.clens,(c-1)*4);
    if(off<0 || len<=0 || off+len>clen){return -1;}
    let a:i32=base+off;let b:i32=a+len;
    let dead:[]u8=s.*.dead;
    let qlo:i32=a/U_ATOM;let qhi:i32=(b+U_ATOM-1)/U_ATOM;
    let q:i32=qlo;
    while(q<qhi){if(dead[q]!=0){return -1;}q=q+1;}
    let units:[]u8=u_alloc(s,U_MAXWIN_UNITS*8);
    let nu:i32=u_derive(s,c,a,b,units,1);
    if(nu<=0){u_free(s,units);return -1;}
    // serve the query span: for each derived unit, cache hit or miss+insert
    let st:[]u8=s.*.stream;
    let pl:[]u8=r.*.pool;
    let i:i32=0;
    while(i<nu){
        let ulo:i32=iget(units,i*8);let uhi:i32=iget(units,i*8+4);
        let sl:i32=dreg_find(s,r,ulo,uhi);
        let ulen:i32=(uhi-ulo)*U_ATOM;
        if(sl>=0){
            // hit: serve from the cached copy (clipped to [a,b))
            let cp:i32=iget(r.*.cpos,sl*4);
            let cs:i32=ulo*U_ATOM;if(cs<a){cs=a;}
            let ce:i32=uhi*U_ATOM;if(ce>b){ce=b;}
            let k:i32=cs;while(k<ce){out[k-a]=pl[cp+(k-ulo*U_ATOM)];k=k+1;}
            s.*.cpu=s.*.cpu+10+(ulen as i64)/128;
            s.*.hits=s.*.hits+1;
        }else{
            // miss: materialize from the stream, insert
            let tmp:[]u8=u_alloc(s,ulen);
            let k:i32=0;while(k<ulen){tmp[k]=st[ulo*U_ATOM+k];k=k+1;}
            dreg_insert(s,r,ulo,uhi,tmp,ulen);
            let cs2:i32=ulo*U_ATOM;if(cs2<a){cs2=a;}
            let ce2:i32=uhi*U_ATOM;if(ce2>b){ce2=b;}
            k=cs2;while(k<ce2){out[k-a]=tmp[k-ulo*U_ATOM];k=k+1;}
            u_free(s,tmp);
        }
        i=i+1;
    }
    u_free(s,units);
    s.*.queries=s.*.queries+1;
    u_counters(s,c,qlo,qhi);
    return len;
}
// D edit: byte write + counter resets (same as U) + registry invalidation.
fn d_edit(s:*U,r:*DReg,c:i32,off:i32,val:u8) i32 {
    let rc:i32=u_edit(s,c,off,val,1);
    if(rc!=0){return rc;}
    let base:i32=iget(s.*.bases,(c-1)*4);
    let q:i32=(base+off)/U_ATOM;
    dreg_invalidate(s,r,q);
    return 0;
}
fn d_resident(s:*U,r:*DReg) i64 {
    let npairs_used:i32=(s.*.stream_n+U_ATOM-1)/U_ATOM;
    let base:i64=(s.*.stream_n as i64)+(npairs_used as i64)*12+
        (U_RING as i64)*16+32+(npairs_used as i64);
    return base+(r.*.cap as i64)*24+(r.*.pool_n as i64);
}
fn u_resident(s:*U) i64 {
    let npairs_used:i32=(s.*.stream_n+U_ATOM-1)/U_ATOM;
    return (s.*.stream_n as i64)+(npairs_used as i64)*12+
        (U_RING as i64)*16+32+(npairs_used as i64);
}

// ---- Duel: U (recompute-on-demand) vs reference D (same rule + cache) ----
const DUEL_S1:i32=2048;
const DUEL_S2_SPANS:i32=128;
const DUEL_S2_REP:i32=16;
const DUEL_S3:i32=2048;
// deterministic span generator: sess 1=sweep,2=repeat-heavy,3=mixed
fn duel_span(sess:i32,i:i32,nun_p:i32,nun_c:i32,c:*i32,off:*i32,len:*i32) void {
    if(sess==1){
        c.*=C_PROSE;if(i%2==1){c.*=C_CODE;}
        let nn:i32=nun_p;if(c.*==C_CODE){nn=nun_c;}
        off.*=(i*64)%(nn-4);
        len.*=4;
    }else if(sess==2){
        let sp:i32=i/DUEL_S2_REP;
        c.*=C_PROSE;if(sp>=64){c.*=C_CODE;}
        let nn:i32=nun_p;if(c.*==C_CODE){nn=nun_c;}
        off.*=((sp%64)*97)%(nn-4);
        len.*=4;
    }else{
        c.*=C_PROSE;if(i%2==1){c.*=C_CODE;}
        let nn:i32=nun_p;if(c.*==C_CODE){nn=nun_c;}
        len.*=1+(i*13)%8;
        off.*=(i*37)%(nn-len.*);
    }
}
fn duel_edits(s:*U,r:*DReg,is_d:i32,E:i32,plen:i32,clen:i32,e0:i32,e1:i32,prose:[]u8,code:[]u8) void {
    let total:i32=plen+clen;
    let e:i32=e0;
    while(e<e1){
        let gp:i32=(e*total)/E;
        let c:i32=C_PROSE;let off:i32=gp;
        if(gp>=plen){c=C_CODE;off=gp-plen;}
        if(is_d==1){d_edit(s,r,c,off,255);}else{u_edit(s,c,off,255,1);}
        // mirror the edit into the expected-bytes arrays
        if(c==C_PROSE){prose[off]=255;}else{code[off]=255;}
        e=e+1;
    }
}
// stats via out-params: cpu, queries, hits, rekey, resident, bad
fn duel_u(cdir:[]u8,E:i32,o_cpu:*i64,o_q:*i64,o_h:*i64,o_r:*i64,o_res:*i64,o_bad:*i64) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let cap:i32=u_align64(prose.len+code.len+1048576);
    let s:U=u_new(cap,400000,8192,512);
    let bout:[]u8=u_alloc(&s,1024);
    u_ingest_corpus(&s,prose,C_PROSE);
    u_ingest_corpus(&s,code,C_CODE);
    let bad:i64=0;
    let sess:i32=1;
    while(sess<=3){
        let nq:i32=DUEL_S1;
        if(sess==2){nq=DUEL_S2_SPANS*DUEL_S2_REP;}
        if(sess==3){nq=DUEL_S3;}
        let i:i32=0;
        while(i<nq){
            let c:i32=0;let off:i32=0;let alen:i32=0;
            duel_span(sess,i,nun_p,nun_c,&c,&off,&alen);
            let rl:i32=u_recall(&s,c,off*U_ATOM,alen*U_ATOM,bout,1);
            if(rl!=alen*U_ATOM){bad=bad+1;}
            else{
                let src:[]u8=prose;if(c==C_CODE){src=code;}
                let q:i32=0;while(q<rl){if(bout[q]!=src[off*U_ATOM+q]){bad=bad+1;break;}q=q+1;}
            }
            i=i+1;
        }
        if(sess==1 && E>0){duel_edits(&s,0,0,E,prose.len,code.len,0,E/2,prose,code);}
        if(sess==2 && E>0){duel_edits(&s,0,0,E,prose.len,code.len,E/2,E,prose,code);}
        sess=sess+1;
    }
    o_cpu.*=s.cpu;o_q.*=s.queries;o_h.*=s.hits;o_r.*=s.rekey;
    o_res.*=u_resident(&s);o_bad.*=bad;
}
fn duel_d(cdir:[]u8,E:i32,o_cpu:*i64,o_q:*i64,o_h:*i64,o_r:*i64,o_res:*i64,o_bad:*i64) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let cap:i32=u_align64(prose.len+code.len+1048576);
    let s:U=u_new(cap,400000,8192,512);
    let r:DReg=dreg_new(&s);
    let bout:[]u8=u_alloc(&s,1024);
    u_ingest_corpus(&s,prose,C_PROSE);
    u_ingest_corpus(&s,code,C_CODE);
    let bad:i64=0;
    let sess:i32=1;
    while(sess<=3){
        let nq:i32=DUEL_S1;
        if(sess==2){nq=DUEL_S2_SPANS*DUEL_S2_REP;}
        if(sess==3){nq=DUEL_S3;}
        let i:i32=0;
        while(i<nq){
            let c:i32=0;let off:i32=0;let alen:i32=0;
            duel_span(sess,i,nun_p,nun_c,&c,&off,&alen);
            let rl:i32=d_recall(&s,&r,c,off*U_ATOM,alen*U_ATOM,bout);
            if(rl!=alen*U_ATOM){bad=bad+1;}
            else{
                let src:[]u8=prose;if(c==C_CODE){src=code;}
                let q:i32=0;while(q<rl){if(bout[q]!=src[off*U_ATOM+q]){bad=bad+1;break;}q=q+1;}
            }
            i=i+1;
        }
        if(sess==1 && E>0){duel_edits(&s,&r,1,E,prose.len,code.len,0,E/2,prose,code);}
        if(sess==2 && E>0){duel_edits(&s,&r,1,E,prose.len,code.len,E/2,E,prose,code);}
        sess=sess+1;
    }
    o_cpu.*=s.cpu;o_q.*=s.queries;o_h.*=s.hits;o_r.*=s.rekey;
    o_res.*=d_resident(&s,&r);o_bad.*=bad;
}
fn duel_total(cpu:i64,res:i64,q:i64,rekey:i64) i64 {
    return cpu+(res*q)/64+10*rekey;
}
fn t_duel(cdir:[]u8) void {
    let uc:i64=0;let uq:i64=0;let uh:i64=0;let ur:i64=0;let ures:i64=0;let ubad:i64=0;
    let dc:i64=0;let dq:i64=0;let dh:i64=0;let dr:i64=0;let dres:i64=0;let dbad:i64=0;
    let estar:i32=-1;
    let cpu_u_tot:i64=0;let cpu_d_tot:i64=0;
    let hits_u_tot:i64=0;let q_u_tot:i64=0;
    let cost_u_100:i64=0;let cost_d_100:i64=0;
    let bad_tot:i64=0;
    _zag_println("DUEL,E,cpu_u,cpu_d,total_u,total_d,winner,bad_u,bad_d");
    let li:i32=0;
    while(li<7){
        let E:i32=0;
        if(li==1){E=10;}if(li==2){E=50;}if(li==3){E=100;}
        if(li==4){E=200;}if(li==5){E=500;}if(li==6){E=1000;}
        duel_u(cdir,E,&uc,&uq,&uh,&ur,&ures,&ubad);
        duel_d(cdir,E,&dc,&dq,&dh,&dr,&dres,&dbad);
        let tu:i64=duel_total(uc,ures,uq,ur);
        let td:i64=duel_total(dc,dres,dq,dr);
        let win:[]u8="U";
        if(td<tu){win="D";if(estar<0){estar=E;}}
        if(li==3){cost_u_100=tu;cost_d_100=td;}
        cpu_u_tot=cpu_u_tot+uc;cpu_d_tot=cpu_d_tot+dc;
        hits_u_tot=hits_u_tot+uh;q_u_tot=q_u_tot+uq;
        bad_tot=bad_tot+ubad+dbad;
        _zag_print("DUEL,");p_i64(E as i64);_zag_print(",");
        p_i64(uc);_zag_print(",");p_i64(dc);_zag_print(",");
        p_i64(tu);_zag_print(",");p_i64(td);_zag_print(",");
        _zag_print(win);_zag_print(",");p_i64(ubad);_zag_print(",");p_i64(dbad);
        _zag_println("");
        li=li+1;
    }
    // kills
    let b4u:i64=0;
    if(q_u_tot>0){b4u=(hits_u_tot*1000)/q_u_tot;}
    let kill_i:i32=0;
    if(cpu_u_tot>10*cpu_d_tot && b4u<100){kill_i=1;}
    let kill_ii:i32=0;
    if(cost_d_100<cost_u_100){kill_ii=1;}
    _zag_print("KILLS,est=");
    if(estar<0){_zag_print("none");}else{p_i64(estar as i64);}
    _zag_print(",kill_i=");p_i64(kill_i as i64);
    _zag_print(",kill_ii=");p_i64(kill_ii as i64);
    _zag_print(",bad=");p_i64(bad_tot);_zag_println("");
    let f:i32=0;
    j_begin("duel-1x");
    jf_int(&f,"duel_crossover_E",estar as i64);
    jf_int(&f,"duel_kill_i_fires",kill_i as i64);
    jf_int(&f,"duel_kill_ii_fires",kill_ii as i64);
    jf_int(&f,"duel_cpu_u_total",cpu_u_tot);
    jf_int(&f,"duel_cpu_d_total",cpu_d_tot);
    jf_int(&f,"duel_cost_u_at_100",cost_u_100);
    jf_int(&f,"duel_cost_d_at_100",cost_d_100);
    jf_int(&f,"duel_byte_mismatches",bad_tot);
    j_end();
}

// ---- main dispatch (harness interface) ----
// argv[1] = mode, argv[2] = corpus-root, argv[3] = outdir (m8), argv[4] = perturbation (m8)
fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    let cdir:[]u8=_zag_arg(2);
    if(mode.len==0 || cdir.len==0){
        _zag_println("usage: u <mode> <corpus-root> [outdir] [perturbation]");
        return 2;
    }
    if(_zag_strcmp(mode,"m1-1x-prose")==1){t_m1(cdir,"prose.bin");}
    else if(_zag_strcmp(mode,"m1-1x-code")==1){t_m1(cdir,"code.bin");}
    else if(_zag_strcmp(mode,"m2-t1-prose")==1){t_m2(cdir,"t1_prose.bin");}
    else if(_zag_strcmp(mode,"m2-t1-code")==1){t_m2(cdir,"t1_code.bin");}
    else if(_zag_strcmp(mode,"m2-t2-prose")==1){t_m2(cdir,"t2_prose.bin");}
    else if(_zag_strcmp(mode,"m2-t2-code")==1){t_m2(cdir,"t2_code.bin");}
    else if(_zag_strcmp(mode,"m2-t3-1x")==1){t_m2(cdir,"t3.bin");}
    else if(_zag_strcmp(mode,"m3-1x")==1){t_m3(cdir);}
    else if(_zag_strcmp(mode,"m4-1x-prose")==1){t_m4(cdir);}
    else if(_zag_strcmp(mode,"m4-1x-code")==1){t_m4(cdir);}
    else if(_zag_strcmp(mode,"m5-baseline")==1){t_m5_baseline(cdir);}
    else if(_zag_strcmp(mode,"m5-1x")==1){t_m5(cdir);}
    else if(_zag_strcmp(mode,"m6-p2c-1x")==1){t_m6(cdir,0);}
    else if(_zag_strcmp(mode,"m6-c2p-1x")==1){t_m6(cdir,1);}
    else if(_zag_strcmp(mode,"m7-1x")==1){t_m7(cdir);}
    else if(_zag_strcmp(mode,"m8-1x")==1){
        let outdir:[]u8=_zag_arg(3);
        let pert:[]u8=_zag_arg(4);
        if(outdir.len==0){outdir=".";}
        if(pert.len==0){pert="clean";}
        // harness calls the clean perturbation "clean"; U accepts it
        if(_zag_strcmp(pert,"clean")==1){pert="none";}
        t_m8(cdir,outdir,pert);
    }
    else if(_zag_strcmp(mode,"m9-1x")==1){t_m9(cdir);}
    else if(_zag_strcmp(mode,"duel-1x")==1){t_duel(cdir);}
    else{_zag_println("unknown mode");return 2;}
    return 0;
}

// ---- M9: edit-invalidation sweep (U's anti-caching claim) ----
// Cumulative single-byte edits 0->1000; after each level, measured queries.
// U has no cache to invalidate: cost must be flat in E, recall stays exact,
// re-keyed bytes stay zero. (D's rising invalidation cost is in the duel.)
fn t_m9(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    if(prose.len==0 || code.len==0){_zag_println("M9,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let cap:i32=u_align64(prose.len+code.len+1048576);
    let s:U=u_new(cap,400000,8192,512);
    let bout:[]u8=u_alloc(&s,1024);
    u_ingest_corpus(&s,prose,C_PROSE);
    u_ingest_corpus(&s,code,C_CODE);
    // warm: 2000 mixed queries
    let i:i32=0;
    while(i<2000){
        let c:i32=0;let off:i32=0;let alen:i32=0;
        duel_span(3,i,nun_p,nun_c,&c,&off,&alen);
        u_recall(&s,c,off*U_ATOM,alen*U_ATOM,bout,1);
        i=i+1;
    }
    let total:i32=prose.len+code.len;
    let prev:i32=0;
    let li:i32=0;
    let f:i32=0;
    j_begin("m9-1x");
    while(li<7){
        let E:i32=0;
        if(li==1){E=10;}if(li==2){E=50;}if(li==3){E=100;}
        if(li==4){E=200;}if(li==5){E=500;}if(li==6){E=1000;}
        let e:i32=prev;
        while(e<E){
            let gp:i32=(e*total)/1000;
            let c:i32=C_PROSE;let off:i32=gp;
            if(gp>=prose.len){c=C_CODE;off=gp-prose.len;}
            u_edit(&s,c,off,255,1);
            e=e+1;
        }
        prev=E;
        let cpu0:i64=s.cpu;
        let ok:i32=0;
        i=0;
        while(i<1000){
            let c:i32=0;let off:i32=0;let alen:i32=0;
            duel_span(1,i,nun_p,nun_c,&c,&off,&alen);
            let rl:i32=u_recall(&s,c,off*U_ATOM,alen*U_ATOM,bout,1);
            if(rl==alen*U_ATOM){
                let src:[]u8=prose;if(c==C_CODE){src=code;}
                let good:i32=1;let q:i32=0;
                while(q<rl){if(bout[q]!=src[off*U_ATOM+q]){good=0;break;}q=q+1;}
                if(good==1){ok=ok+1;}
            }
            i=i+1;
        }
        let dcpu:i64=s.cpu-cpu0;
        let tag:[]u8="e0";
        if(li==1){tag="e10";}if(li==2){tag="e50";}if(li==3){tag="e100";}
        if(li==4){tag="e200";}if(li==5){tag="e500";}if(li==6){tag="e1000";}
        // (text line omitted: JSON carries the fields; interleaving breaks the parser)
        jf_int(&f,tag,dcpu);
        li=li+1;
    }
    jf_int(&f,"m9_rekey_bytes_total",s.rekey);
    jf_int(&f,"m9_hits_total",s.hits);
    j_end();
    u_free(&s,bout);
}

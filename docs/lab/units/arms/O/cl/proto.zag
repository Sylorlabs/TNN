// O-proto: TST-1 §P wire format, the deterministic hand-wired teacher
// (teacher_id=1), and the learner's ingress gate. All §P iron rules enforced
// here: spans only, no commands, monotonic seq, checksum. Malformed proposals
// never reach deliberation (kill criterion iii lives here).

// §P caps (frozen in prereg)
const P_AUX_MAX:i32=4;
const P_GND_MAX:i32=8;

// encode one proposal; aux/gnd are packed (u64 start,u64 end) pairs.
// returns total byte length (incl. checksum), or -1 on cap violation.
fn p_enc(buf:[]u8,tid:i32,sess:i64,seq:i64,kind:i32,ss:i64,se:i64,
         aux:[]u8,auxn:i32,gnd:[]u8,gndn:i32,conf:i32) i32 {
    if(auxn<0 || auxn>P_AUX_MAX || gndn<0 || gndn>P_GND_MAX){return -1;}
    if(kind<1 || kind>5 || conf<0 || conf>255){return -1;}
    let at:i32=0;
    iput(buf,at,O_MAGIC);at=at+4;
    buf[at]=(O_PVER & 255) as u8;buf[at+1]=((O_PVER>>8) & 255) as u8;at=at+2;
    iput(buf,at,tid);at=at+4;
    uput64(buf,at,sess);at=at+8;
    uput64(buf,at,seq);at=at+8;
    buf[at]=kind as u8;at=at+1;
    uput64(buf,at,ss);at=at+8;
    uput64(buf,at,se);at=at+8;
    buf[at]=auxn as u8;at=at+1;
    let i:i32=0;
    while(i<auxn){
        uput64(buf,at,uget64(aux,i*16));at=at+8;
        uput64(buf,at,uget64(aux,i*16+8));at=at+8;
        i=i+1;
    }
    buf[at]=gndn as u8;at=at+1;
    i=0;
    while(i<gndn){
        uput64(buf,at,uget64(gnd,i*16));at=at+8;
        uput64(buf,at,uget64(gnd,i*16+8));at=at+8;
        i=i+1;
    }
    buf[at]=conf as u8;at=at+1;
    let ck:i64=fnv1a(buf,0,at);
    uput64(buf,at,ck);at=at+8;
    return at;
}

// ingress gate: parse + validate §P bytes against the iron rules.
// On success: fills out-params, advances teacher seq, returns 0.
// On failure: returns negative code; NOTHING reaches deliberation.
//   -1 bad magic  -2 bad version  -3 bad teacher_id  -4 seq violation
//   -5 bad kind   -6 bad span     -7 bad aux/gnd count -8 length mismatch
//   -9 bad checksum  -10 span out of bounds  -11 session halted
fn p_dec(s:*OState,buf:[]u8,blen:i32,stim_len:i32,
         o_tid:*i32,o_kind:*i32,o_ss:*i32,o_se:*i32,o_conf:*i32,
         o_gnd:[]u8,o_gndn:*i32) i32 {
    if(s.*.sess_halted==1){return -11;}
    // minimum: 4+2+4+8+8+1+8+8+1+1+1+8 = 54
    if(blen<54){return -8;}
    if(iget(buf,0)!=O_MAGIC){return -1;}
    let ver:i32=(buf[4] as i32)|((buf[5] as i32)<<8);
    if(ver!=O_PVER){return -2;}
    let tid:i32=iget(buf,6);
    // teacher 4 (symbolic hints only) may not send §P proposals; 0 and 2 are
    // reserved/invalid. Only 1, 3, 5 are §P-capable.
    if(tid!=1 && tid!=3 && tid!=5){return -3;}
    let sess:i64=uget64(buf,10);
    let seq:i64=uget64(buf,18);
    // monotonic seq per teacher (gap/duplicate = protocol violation -> pause)
    let ls:[]u8=s.*.last_seq;
    let last:i64=uget64(ls,tid*8);
    if(seq!=last+1){
        // REFUSE R3, do NOT advance last_seq: the teacher stream is paused.
        o_led(s,OP_REFUSE,-1,R_PROTOCOL,tid,seq as i32,0,0,0,0,0,0,0,0,R_PROTOCOL,0);
        return -4;
    }
    let kind:i32=buf[26] as i32;
    if(kind<1 || kind>5){return -5;}
    let ss:i64=uget64(buf,27);
    let se:i64=uget64(buf,35);
    if(se<=ss){return -6;}
    if(se>(stim_len as i64) || ss<0){return -10;}
    let auxn:i32=buf[43] as i32;
    if(auxn<0 || auxn>P_AUX_MAX){return -7;}
    let at:i32=44+auxn*16;
    if(at+1>blen){return -8;}
    // validate aux spans (parsed but not used by vocabulary deliberation)
    let i:i32=0;
    while(i<auxn){
        if(at+16>blen){return -8;}
        let a0:i64=uget64(buf,at);let a1:i64=uget64(buf,at+8);
        if(a1<=a0 || a1>(stim_len as i64) || a0<0){return -10;}
        at=at+16;i=i+1;
    }
    let gndn:i32=buf[at] as i32;at=at+1;
    if(gndn<0 || gndn>P_GND_MAX){return -7;}
    i=0;
    while(i<gndn){
        if(at+16>blen-9){return -8;} // need room for conf+checksum
        let g0:i64=uget64(buf,at);let g1:i64=uget64(buf,at+8);
        if(g1<=g0 || g1>(stim_len as i64) || g0<0){return -10;}
        if(i<8){
            uput64(o_gnd,i*16,g0);uput64(o_gnd,i*16+8,g1);
        }
        at=at+16;i=i+1;
    }
    if(at+9!=blen){return -8;} // exact length: conf(1)+checksum(8)
    let conf:i32=buf[at] as i32;at=at+1;
    let ck:i64=uget64(buf,at);
    if(ck!=fnv1a(buf,0,blen-8)){return -9;}
    // all checks passed: commit seq advance, fill outputs
    uput64(ls,tid*8,seq);
    o_tid.*=tid;o_kind.*=kind;
    o_ss.*=ss as i32;o_se.*=se as i32;o_conf.*=conf;
    o_gndn.*=gndn;
    return 0;
}

// ---- deterministic hand-wired teacher (teacher_id=1) ----
// Tokenize on whitespace into sctab; count; record 2nd occurrence (grounding).
fn teacher_count(s:*OState,src:[]u8,srclen:i32)void {
    let h:[]u8=s.*.sctab_h;let off:[]u8=s.*.sctab_off;
    let ln:[]u8=s.*.sctab_len;let cnt:[]u8=s.*.sctab_cnt;let g1:[]u8=s.*.sctab_g1;
    let i:i32=0;
    while(i<O_SCTAB){iput(ln,i*4,0);iput(cnt,i*4,0);i=i+1;}
    let p:i32=0;
    while(p<srclen){
        while(p<srclen && is_ws(src[p])==1){p=p+1;}
        if(p>=srclen){break;}
        let q:i32=p;
        while(q<srclen && is_ws(src[q])==0){q=q+1;}
        let len:i32=q-p;
        if(len>=1 && len<=O_TOK_MAXLEN){
            let fh:i64=fnv1a(src,p,len);
            let slot:i32=(fh % (O_SCTAB as i64)) as i32;
            if(slot<0){slot=slot+O_SCTAB;}
            let t:i32=0;
            while(t<4096){
                if(iget(ln,slot*4)==0){
                    uput64(h,slot*8,fh);
                    iput(off,slot*4,p);iput(ln,slot*4,len);
                    iput(cnt,slot*4,1);iput(g1,slot*4,-1);
                    break;
                }
                if(uget64(h,slot*8)==fh && iget(ln,slot*4)==len &&
                   memcmp_eq(src,iget(off,slot*4),src,p,len)==1){
                    let c:i32=iget(cnt,slot*4);
                    if(c==1){iput(g1,slot*4,p);}
                    iput(cnt,slot*4,c+1);
                    break;
                }
                slot=slot+1;if(slot>=O_SCTAB){slot=0;}t=t+1;
            }
            // (probe cap: drop the token if the table is pathologically full)
        }
        p=q;
    }
}
// confidence policy: selective, expressed uncertainty (§B.2: non-255 required)
fn teacher_conf(freq:i32)i32 {
    if(freq>=100){return 255;}
    if(freq>=20){return 200;}
    if(freq>=5){return 150;}
    return 100;
}
// candidate record: score u64, off u32, len u32, freq u32, g1 u32 (28B)
fn tcand_gt(c:[]u8,i:i32,j:i32)i32 {
    let si:i64=uget64(c,i*28);let sj:i64=uget64(c,j);
    if(si!=sj){if(si>sj){return 1;}return 0;}
    if(iget(c,i*28+8)<iget(c,j*28+8)){return 1;}
    return 0;
}
fn tcand_swap(c:[]u8,i:i32,j:i32)void {
    let k:i32=0;
    while(k<28){let t:u8=c[i*28+k];c[i*28+k]=c[j*28+k];c[j*28+k]=t;k=k+1;}
}
// select top-maxp candidates by (freq*len desc, off asc); writes into caller
// arrays (off,len,freq,g1,conf); returns count.
fn teacher_topk(s:*OState,o_off:[]u8,o_len:[]u8,o_freq:[]u8,o_g1:[]u8,o_conf:[]u8,
                maxp:i32) i32 {
    let off:[]u8=s.*.sctab_off;let ln:[]u8=s.*.sctab_len;
    let cnt:[]u8=s.*.sctab_cnt;let g1:[]u8=s.*.sctab_g1;
    let d:i32=0;let i:i32=0;
    while(i<O_SCTAB){if(iget(ln,i*4)>0 && iget(cnt,i*4)>=2){d=d+1;}i=i+1;}
    if(d==0){return 0;}
    let cand:[]u8=o_malloc(s,d*28);
    let n:i32=0;i=0;
    while(i<O_SCTAB){
        let tl:i32=iget(ln,i*4);let tc:i32=iget(cnt,i*4);
        if(tl>0 && tc>=2){
            uput64(cand,n*28,(tc as i64)*(tl as i64));
            iput(cand,n*28+8,iget(off,i*4));
            iput(cand,n*28+12,tl);
            iput(cand,n*28+16,tc);
            iput(cand,n*28+20,iget(g1,i*4));
            n=n+1;
        }
        i=i+1;
    }
    // max-heapify (deterministic)
    i=n/2-1;
    while(i>=0){
        let r:i32=i;
        while(1==1){
            let l:i32=r*2+1;let rr:i32=r*2+2;let m:i32=r;
            if(l<n && tcand_gt(cand,l,m)==1){m=l;}
            if(rr<n && tcand_gt(cand,rr,m)==1){m=rr;}
            if(m==r){break;}
            tcand_swap(cand,r,m);r=m;
        }
        i=i-1;
    }
    let take:i32=n;if(take>maxp){take=maxp;}
    let nn:i32=n;let k:i32=0;
    while(k<take){
        iput(o_off,k*4,iget(cand,8));
        iput(o_len,k*4,iget(cand,12));
        iput(o_freq,k*4,iget(cand,16));
        iput(o_g1,k*4,iget(cand,20));
        o_conf[k]=teacher_conf(iget(cand,16)) as u8;
        nn=nn-1;
        tcand_swap(cand,0,nn);
        let r:i32=0;
        while(1==1){
            let l:i32=r*2+1;let rr:i32=r*2+2;let m:i32=r;
            if(l<nn && tcand_gt(cand,l,m)==1){m=l;}
            if(rr<nn && tcand_gt(cand,rr,m)==1){m=rr;}
            if(m==r){break;}
            tcand_swap(cand,r,m);r=m;
        }
        k=k+1;
    }
    o_free(s,cand);
    return take;
}

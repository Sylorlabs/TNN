// Z4 — Dialect (per-interlocutor) IDs. IDENT family.
// Mechanism: per-speaker lexicons namespaced by speaker tag; TRANSLATE op;
// `common`-namespace governance. Phase 4 hook (speaker tags are explicit
// logged input metadata on every ingest; the arm never infers speakers).
//
// ID = (namespace:u32, seq:u32). seq is per-namespace, 1-based, never reused.
// ingest(ns, bytes) is idempotent: same (ns, bytes) -> same (ns, seq), via a
// content index keyed by (ns, FNV-1a-32). Same bytes under different speakers
// get different ids. TRANSLATE logs derivation, never identity.
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

const Z4_CHUNK:i32=64;
// corpus ids (frozen registry, shared with the harness)
const Z4_C_PROSE:i32=1;
const Z4_C_CODE:i32=2;
const Z4_C_T1P:i32=3;
const Z4_C_T1C:i32=4;
const Z4_C_T2P:i32=5;
const Z4_C_T2C:i32=6;
const Z4_C_T3:i32=7;
const Z4_C_FRESH:i32=8;
// speaker namespaces (Phase 4 input metadata)
const Z4_NS_COMMON:i32=0;
const Z4_NS_S1:i32=1;
const Z4_NS_S2:i32=2;
const Z4_NS_S3:i32=3;
// slot flags
const F_OCC:i32=1;
const F_LIVE:i32=2;
const F_PIN:i32=4;
const F_WEAK:i32=8;
const F_SHIFT:i32=16;
const F_PATCH:i32=32;
// ledger opcodes (1..18 mirror the shared ID-arm vocabulary; 19..21 are Z4's)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_TDB:i32=16;
const OP_TDC:i32=17;
const OP_TMV:i32=18;
const OP_TSP:i32=19;
const OP_TRANSLATE:i32=20;
const OP_MCOMMON:i32=21;
// metric constants
const Z4_M2_EPMAX:i32=50;
const Z4_M3_V:i32=1000;
const Z4_M3_FRESH1:i32=3000;
const Z4_M3_KILL:i32=3000;
const Z4_M3_FRESH2:i32=4000;
const Z4_M3_CAP:i32=4000;
const Z4_M4_N:i32=200;
const Z4_M7_LOOKUPS:i32=5000;
const Z4_SWAP_N:i32=64;

struct Z4 {
    cap:i32,
    nss:[]u8,
    seqs:[]u8,
    offs:[]u8,
    lens:[]u8,
    corps:[]u8,
    flags:[]u8,
    shifts:[]u8,
    pidx:[]u8,
    ctab:[]u8,
    ctab_cap:i32,
    nseq:[]u8,
    pmap:[]u8,
    patches:[]u8,
    patch_n:i32,
    patch_cap:i32,
    led:[]u8,
    led_n:i32,
    led_cap:i32,
    ins:[]u8,
    ins_cap:i32,
    ins_n:i32,
    ins_head:i32,
    trace:[]u8,
    trace_n:i32,
    trace_cap:i32,
    nlive:i32,
}

fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }
fn zfill(b:[]u8,v:u8)void {
    let i:i32=0;while(i<b.len){b[i]=v;i=i+1;}
}

// ---- allocation with logged trace (identical across perturbations) ----
fn halloc(s:*Z4,n:i32)[]u8 {
    let b:[]u8=nio_alloc(n);
    zfill(b,0);
    let tr:*[]u8=&s.*.trace;
    let tn:i32=s.*.trace_n;
    let tag:[]u8="A ";
    let a2:i32=0;while(a2<2){tr.*[tn]=tag[a2];tn=tn+1;a2=a2+1;}
    let num:[]u8=_zag_i64_to_str(n as i64);
    a2=0;while(a2<num.len){tr.*[tn]=num[a2];tn=tn+1;a2=a2+1;}
    nio_free(num);
    tr.*[tn]=10;tn=tn+1;
    s.*.trace_n=tn;
    return b;
}
fn hfree(s:*Z4,b:[]u8)void {
    nio_free(b);
    let tr:*[]u8=&s.*.trace;
    let tn:i32=s.*.trace_n;
    let tag:[]u8="F ";
    let a2:i32=0;while(a2<2){tr.*[tn]=tag[a2];tn=tn+1;a2=a2+1;}
    tr.*[tn]=10;tn=tn+1;
    s.*.trace_n=tn;
}

fn z_init(s:*Z4,cap:i32,led_entries:i32,ins_max:i32)void {
    s.*.cap=cap;
    s.*.nss=nio_alloc(cap*4);zfill(s.*.nss,0);
    s.*.seqs=nio_alloc(cap*4);zfill(s.*.seqs,0);
    s.*.offs=nio_alloc(cap*4);zfill(s.*.offs,0);
    s.*.lens=nio_alloc(cap*4);zfill(s.*.lens,0);
    s.*.corps=nio_alloc(cap*4);zfill(s.*.corps,0);
    s.*.flags=nio_alloc(cap*4);zfill(s.*.flags,0);
    s.*.shifts=nio_alloc(cap*4);zfill(s.*.shifts,0);
    s.*.pidx=nio_alloc(cap*4);zfill(s.*.pidx,255);
    s.*.ctab_cap=cap*2;
    s.*.ctab=nio_alloc(s.*.ctab_cap*16);zfill(s.*.ctab,0);
    s.*.nseq=nio_alloc(32);zfill(s.*.nseq,0);
    s.*.pmap=nio_alloc(cap*4);zfill(s.*.pmap,255);
    s.*.patch_cap=4096;
    s.*.patches=nio_alloc(4096*64);
    s.*.patch_n=0;
    s.*.led_cap=led_entries;
    s.*.led=nio_alloc(led_entries*64);
    s.*.led_n=0;
    s.*.ins_cap=ins_max;
    s.*.ins=nio_alloc(ins_max*4);
    s.*.ins_n=0;s.*.ins_head=0;
    s.*.trace_cap=1<<20;
    s.*.trace=nio_alloc(1<<20);
    s.*.trace_n=0;
    s.*.nlive=0;
}
fn z4_new(cap:i32,led_entries:i32,ins_max:i32) Z4 {
    let s:Z4=Z4{.cap=0,.nss="",.seqs="",.offs="",.lens="",.corps="",.flags="",
        .shifts="",.pidx="",.ctab="",.ctab_cap=0,.nseq="",.pmap="",
        .patches="",.patch_n=0,.patch_cap=0,.led="",.led_n=0,.led_cap=0,
        .ins="",.ins_cap=0,.ins_n=0,.ins_head=0,.trace="",.trace_n=0,
        .trace_cap=0,.nlive=0};
    z_init(&s,cap,led_entries,ins_max);
    return s;
}

// ---- audit ledger: 16 words; op@0 slot@4 rc@8 b1..b5@12..28 a1..a5@32..48
// stage@52 d1@56 d2@60 ----
fn z_led(s:*Z4,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
         a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)void {
    let n:i32=s.*.led_n;
    if(n>=s.*.led_cap){return;}
    let at:i32=n*64;
    iput(s.*.led,at,op);iput(s.*.led,at+4,slot);iput(s.*.led,at+8,rc);
    iput(s.*.led,at+12,b1);iput(s.*.led,at+16,b2);iput(s.*.led,at+20,b3);
    iput(s.*.led,at+24,b4);iput(s.*.led,at+28,b5);
    iput(s.*.led,at+32,a1);iput(s.*.led,at+36,a2);iput(s.*.led,at+40,a3);
    iput(s.*.led,at+44,a4);iput(s.*.led,at+48,a5);
    iput(s.*.led,at+52,1);iput(s.*.led,at+56,d1);iput(s.*.led,at+60,d2);
    s.*.led_n=n+1;
}

// ---- hashes ----
fn zhash(ns:i32,seq:i32,cap:i32)i32 {
    let x:i64=(ns as i64)*2654435761^((seq as i64)&4294967295)*2246822519;
    x=x^(x>>16);x=x*2246822519;x=x^(x>>13);
    let r:i32=(x%(cap as i64)) as i32;
    if(r<0){r=r+cap;}
    return r;
}
fn chash(ns:i32,h32:i32,ccap:i32)i32 {
    let x:i64=(ns as i64)*3266489917^((h32 as i64)&4294967295)*668265263;
    x=x^(x>>16);x=x*2246822519;x=x^(x>>13);
    let r:i32=(x%(ccap as i64)) as i32;
    if(r<0){r=r+ccap;}
    return r;
}
// FNV-1a 32-bit: non-crypto index hash for the content table. Collision safety
// comes from byte-compare verification, never from hash strength.
fn fnv32(buf:[]u8,off:i32,len:i32)i32 {
    let h:i64=2166136261;
    let i:i32=0;
    while(i<len){
        h=h^(buf[off+i] as i64);
        h=(h*16777619)&4294967295;
        i=i+1;
    }
    return h as i32;
}

// ---- ID -> slot (pmap = the M1 swap-probe remap; -1 = none) ----
fn slot_find_raw(s:*Z4,ns:i32,seq:i32)i32 {
    let cap:i32=s.*.cap;
    let nss:[]u8=s.*.nss;let seqs:[]u8=s.*.seqs;let flags:[]u8=s.*.flags;
    let h:i32=zhash(ns,seq,cap);
    let t:i32=0;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f&F_OCC)==0){return -1;}
        if(iget(nss,h*4)==ns && iget(seqs,h*4)==seq){return h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    return -1;
}
fn slot_find(s:*Z4,ns:i32,seq:i32)i32 {
    let sl:i32=slot_find_raw(s,ns,seq);
    if(sl>=0){
        let pm:i32=iget(s.*.pmap,sl*4);
        if(pm>=0){return pm;}
    }
    return sl;
}
fn slot_insert(s:*Z4,ns:i32,seq:i32,off:i32,len:i32,corpus:i32)i32 {
    let cap:i32=s.*.cap;
    let nss:[]u8=s.*.nss;let seqs:[]u8=s.*.seqs;let offs:[]u8=s.*.offs;
    let lens:[]u8=s.*.lens;let corps:[]u8=s.*.corps;let flags:[]u8=s.*.flags;
    let shifts:[]u8=s.*.shifts;let pidx:[]u8=s.*.pidx;
    let h:i32=zhash(ns,seq,cap);
    let t:i32=0;let first_dead:i32=-1;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f&F_OCC)==0){
            let tgt:i32=h;
            if(first_dead>=0){tgt=first_dead;}
            iput(nss,tgt*4,ns);iput(seqs,tgt*4,seq);
            iput(offs,tgt*4,off);iput(lens,tgt*4,len);iput(corps,tgt*4,corpus);
            iput(flags,tgt*4,F_OCC|F_LIVE);
            iput(shifts,tgt*4,0);iput(pidx,tgt*4,-1);
            iput(s.*.ins,((s.*.ins_head+s.*.ins_n)%s.*.ins_cap)*4,tgt);
            s.*.ins_n=s.*.ins_n+1;
            s.*.nlive=s.*.nlive+1;
            return tgt;
        }
        if(iget(nss,h*4)==ns && iget(seqs,h*4)==seq){
            iput(offs,h*4,off);iput(lens,h*4,len);iput(corps,h*4,corpus);
            if((f&F_LIVE)==0){iput(flags,h*4,f|F_LIVE);s.*.nlive=s.*.nlive+1;}
            return h;
        }
        if((f&F_LIVE)==0 && (f&F_PIN)==0 && first_dead<0){first_dead=h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    if(first_dead>=0){
        iput(nss,first_dead*4,ns);iput(seqs,first_dead*4,seq);
        iput(offs,first_dead*4,off);iput(lens,first_dead*4,len);
        iput(corps,first_dead*4,corpus);
        iput(flags,first_dead*4,F_OCC|F_LIVE);
        iput(shifts,first_dead*4,0);iput(pidx,first_dead*4,-1);
        iput(s.*.ins,((s.*.ins_head+s.*.ins_n)%s.*.ins_cap)*4,first_dead);
        s.*.ins_n=s.*.ins_n+1;
        s.*.nlive=s.*.nlive+1;
        return first_dead;
    }
    return -1;
}

// ---- content index: (ns,h32) -> seq. Entry validity is checked against the
// slot's live (nss,seqs); stale entries (slot reused) are skipped on lookup
// and recycled on insert, so eviction needs no index deletion. ----
fn slot_bytes_equal(s:*Z4,sl:i32,qbuf:[]u8,qoff:i32,qlen:i32,
                    cbufs:[]u8,coffs:[]u8,clens:[]u8)i32 {
    let len:i32=iget(s.*.lens,sl*4);
    if(len!=qlen){return 0;}
    let corpus:i32=iget(s.*.corps,sl*4);
    let bo:i32=iget(coffs,(corpus-1)*4);
    let off:i32=iget(s.*.offs,sl*4);
    let i:i32=0;
    while(i<len){
        if(cbufs[bo+off+i]!=qbuf[qoff+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn ctab_lookup(s:*Z4,ns:i32,h32:i32,qbuf:[]u8,qoff:i32,qlen:i32,
               cbufs:[]u8,coffs:[]u8,clens:[]u8)i32 {
    let ccap:i32=s.*.ctab_cap;
    let tab:[]u8=s.*.ctab;
    let h:i32=chash(ns,h32,ccap);
    let t:i32=0;
    while(t<ccap){
        let at:i32=h*16;
        let eseq:i32=iget(tab,at+8);
        if(eseq==0){return -1;}
        if(iget(tab,at)==ns && iget(tab,at+4)==h32){
            let eslot:i32=iget(tab,at+12);
            if(iget(s.*.nss,eslot*4)==ns && iget(s.*.seqs,eslot*4)==eseq){
                if(slot_bytes_equal(s,eslot,qbuf,qoff,qlen,cbufs,coffs,clens)==1){
                    return eseq;
                }
            }
        }
        h=h+1;if(h>=ccap){h=0;}t=t+1;
    }
    return -1;
}
fn ctab_insert(s:*Z4,ns:i32,h32:i32,seq:i32,slot:i32)void {
    let ccap:i32=s.*.ctab_cap;
    let tab:[]u8=s.*.ctab;
    let h:i32=chash(ns,h32,ccap);
    let t:i32=0;
    while(t<ccap){
        let at:i32=h*16;
        let eseq:i32=iget(tab,at+8);
        if(eseq==0){
            iput(tab,at,ns);iput(tab,at+4,h32);iput(tab,at+8,seq);iput(tab,at+12,slot);
            return;
        }
        let eslot:i32=iget(tab,at+12);
        let ens:i32=iget(tab,at);
        if(iget(s.*.nss,eslot*4)!=ens || iget(s.*.seqs,eslot*4)!=eseq){
            iput(tab,at,ns);iput(tab,at+4,h32);iput(tab,at+8,seq);iput(tab,at+12,slot);
            return;
        }
        h=h+1;if(h>=ccap){h=0;}t=t+1;
    }
    z_led(s,OP_REFUSE,-1,1,0,0,0,0,0,ns,seq,0,0,0,105,0);
}
fn z_next_seq(s:*Z4,ns:i32)i32 {
    let c:i32=iget(s.*.nseq,ns*4);
    iput(s.*.nseq,ns*4,c+1);
    return c+1;
}

// ---- ingest: idempotent per (ns, bytes); evict-oldest-unpinned on full;
// loud refusal (rc=103) if still full. Returns seq, or -1 on refusal. ----
fn z_evict_oldest_unpinned(s:*Z4)i32 {
    let head:i32=s.*.ins_head;
    let nn:i32=s.*.ins_n;
    let k:i32=0;
    while(k<nn){
        let at:i32=(head+k)%s.*.ins_cap;
        let sl:i32=iget(s.*.ins,at*4);
        let f:i32=iget(s.*.flags,sl*4);
        if((f&F_LIVE)!=0 && (f&F_PIN)==0){
            iput(s.*.flags,sl*4,f&(F_OCC|F_PIN|F_WEAK|F_SHIFT|F_PATCH));
            s.*.nlive=s.*.nlive-1;
            let ns:i32=iget(s.*.nss,sl*4);let sq:i32=iget(s.*.seqs,sl*4);
            z_led(s,OP_EVICT,sl,0,0,0,0,0,0,ns,sq,0,0,0,0,0);
            return sl;
        }
        k=k+1;
    }
    return -1;
}
fn z_ingest(s:*Z4,ns:i32,buf:[]u8,off:i32,len:i32,corpus:i32,
            cbufs:[]u8,coffs:[]u8,clens:[]u8)i32 {
    let h32:i32=fnv32(buf,off,len);
    let seq:i32=ctab_lookup(s,ns,h32,buf,off,len,cbufs,coffs,clens);
    if(seq>=0){
        let sl:i32=slot_insert(s,ns,seq,off,len,corpus);
        z_led(s,OP_ADD,sl,0,off,0,len,corpus,0,ns,seq,0,0,0,0,0);
        return seq;
    }
    seq=z_next_seq(s,ns);
    let sl:i32=slot_insert(s,ns,seq,off,len,corpus);
    if(sl<0){
        z_evict_oldest_unpinned(s);
        sl=slot_insert(s,ns,seq,off,len,corpus);
    }
    if(sl<0){
        z_led(s,OP_REFUSE,-1,1,off,0,len,corpus,0,ns,seq,0,0,0,103,0);
        return -1;
    }
    ctab_insert(s,ns,h32,seq,sl);
    z_led(s,OP_ADD,sl,0,off,0,len,corpus,0,ns,seq,0,0,0,0,0);
    return seq;
}
fn z_recall(s:*Z4,cbufs:[]u8,coffs:[]u8,clens:[]u8,ns:i32,seq:i32,out:[]u8)i32 {
    let sl:i32=slot_find(s,ns,seq);
    if(sl<0){return -1;}
    let f:i32=iget(s.*.flags,sl*4);
    if((f&F_LIVE)==0){return -1;}
    let off:i32=iget(s.*.offs,sl*4);
    let len:i32=iget(s.*.lens,sl*4);
    let corpus:i32=iget(s.*.corps,sl*4);
    let bo:i32=iget(coffs,(corpus-1)*4);
    if((f&F_SHIFT)!=0){off=off+iget(s.*.shifts,sl*4);}
    let i:i32=0;
    while(i<len){out[i]=cbufs[bo+off+i];i=i+1;}
    if((f&F_PATCH)!=0){
        let pi:i32=iget(s.*.pidx,sl*4);
        let pb:[]u8=s.*.patches;
        let k:i32=0;while(k<len){out[k]=pb[pi*64+k];k=k+1;}
    }
    return len;
}
fn z_kill(s:*Z4,ns:i32,seq:i32,reason:i32)i32 {
    let sl:i32=slot_find(s,ns,seq);
    if(sl<0){z_led(s,OP_KILL,-1,1,0,0,0,0,0,ns,seq,0,0,0,reason,0);return -1;}
    let f:i32=iget(s.*.flags,sl*4);
    iput(s.*.flags,sl*4,f&(F_OCC|F_PIN|F_WEAK|F_SHIFT|F_PATCH));
    s.*.nlive=s.*.nlive-1;
    z_led(s,OP_KILL,sl,0,0,0,0,0,0,ns,seq,0,0,0,reason,0);
    return 0;
}
fn z_pin(s:*Z4,ns:i32,seq:i32)i32 {
    let sl:i32=slot_find(s,ns,seq);
    if(sl<0){return -1;}
    let f:i32=iget(s.*.flags,sl*4);
    iput(s.*.flags,sl*4,f|F_PIN);
    z_led(s,OP_PIN,sl,0,0,0,0,0,0,ns,seq,0,0,0,0,0);
    return 0;
}
fn z_weaken(s:*Z4,ns:i32,seq:i32,seqn:i32)i32 {
    let sl:i32=slot_find(s,ns,seq);
    if(sl<0){return -1;}
    let f:i32=iget(s.*.flags,sl*4);
    iput(s.*.flags,sl*4,f|F_WEAK);
    z_led(s,OP_WEAKEN,sl,0,0,0,0,0,0,ns,seq,seqn,0,0,0,0);
    return 0;
}
fn z_defect_boundary(s:*Z4,ns:i32,seq:i32,delta:i32)i32 {
    let sl:i32=slot_find(s,ns,seq);
    if(sl<0){return -1;}
    iput(s.*.shifts,sl*4,delta);
    let f:i32=iget(s.*.flags,sl*4);
    iput(s.*.flags,sl*4,f|F_SHIFT);
    z_led(s,OP_TDB,sl,0,0,0,0,0,0,ns,seq,delta,0,0,0,0);
    return 0;
}
fn z_defect_content(s:*Z4,ns:i32,seq:i32,patch:[]u8,plen:i32)i32 {
    let sl:i32=slot_find(s,ns,seq);
    if(sl<0){return -1;}
    if(s.*.patch_n>=s.*.patch_cap){return -1;}
    let pi:i32=s.*.patch_n;
    s.*.patch_n=pi+1;
    let k:i32=0;while(k<plen){s.*.patches[pi*64+k]=patch[k];k=k+1;}
    iput(s.*.pidx,sl*4,pi);
    let f:i32=iget(s.*.flags,sl*4);
    iput(s.*.flags,sl*4,f|F_PATCH);
    z_led(s,OP_TDC,sl,0,0,0,0,0,0,ns,seq,pi,0,0,0,0);
    return 0;
}
fn z_revise(s:*Z4,ns:i32,seq:i32)i32 {
    let sl:i32=slot_find(s,ns,seq);
    if(sl<0){return -1;}
    let f:i32=iget(s.*.flags,sl*4);
    iput(s.*.flags,sl*4,f&(F_OCC|F_LIVE|F_PIN|F_WEAK));
    iput(s.*.shifts,sl*4,0);
    iput(s.*.pidx,sl*4,-1);
    z_led(s,OP_REVISE,sl,0,0,0,0,0,0,ns,seq,0,0,0,0,0);
    return 0;
}
fn z_mark_valuable(s:*Z4,ns:i32,seq:i32)i32 {
    z_led(s,OP_TMV,-1,0,0,0,0,0,0,ns,seq,0,0,0,0,0);
    return z_pin(s,ns,seq);
}
// TRANSLATE: cross-speaker derivation, logged as derivation (a1..a4 =
// src ns, src seq, dst ns, dst seq), never as identity.
fn z_translate(s:*Z4,nsA:i32,seqA:i32,nsB:i32,
               cbufs:[]u8,coffs:[]u8,clens:[]u8,tmp:[]u8)i32 {
    let slA:i32=slot_find(s,nsA,seqA);
    if(slA<0){return -1;}
    if((iget(s.*.flags,slA*4)&F_LIVE)==0){return -1;}
    let rl:i32=z_recall(s,cbufs,coffs,clens,nsA,seqA,tmp);
    if(rl<=0){return -1;}
    let h32:i32=fnv32(tmp,0,rl);
    let seqB:i32=ctab_lookup(s,nsB,h32,tmp,0,rl,cbufs,coffs,clens);
    if(seqB>=0){
        z_led(s,OP_TRANSLATE,slot_find(s,nsB,seqB),0,0,0,0,0,0,
              nsA,seqA,nsB,seqB,0,1,0);
        return seqB;
    }
    seqB=z_next_seq(s,nsB);
    let off:i32=iget(s.*.offs,slA*4);
    let len:i32=iget(s.*.lens,slA*4);
    let corpus:i32=iget(s.*.corps,slA*4);
    let slB:i32=slot_insert(s,nsB,seqB,off,len,corpus);
    if(slB<0){
        z_evict_oldest_unpinned(s);
        slB=slot_insert(s,nsB,seqB,off,len,corpus);
    }
    if(slB<0){
        z_led(s,OP_REFUSE,-1,1,off,0,len,corpus,0,nsB,seqB,nsA,seqA,0,104,0);
        return -1;
    }
    ctab_insert(s,nsB,h32,seqB,slB);
    z_led(s,OP_TRANSLATE,slB,0,off,0,len,corpus,0,nsA,seqA,nsB,seqB,0,0,0);
    return seqB;
}
// MARK_COMMON: promote (ns,seq) to the preregistered `common` namespace.
// Governance rule (Z4-A-gov): the trial attests byte-identity across the two
// speakers' training corpora before calling; the arm logs the attestation.
fn z_mark_common(s:*Z4,ns:i32,seq:i32,
                 cbufs:[]u8,coffs:[]u8,clens:[]u8,tmp:[]u8)i32 {
    let sl:i32=slot_find(s,ns,seq);
    if(sl<0){return -1;}
    let rl:i32=z_recall(s,cbufs,coffs,clens,ns,seq,tmp);
    if(rl<=0){return -1;}
    let h32:i32=fnv32(tmp,0,rl);
    let seqC:i32=ctab_lookup(s,Z4_NS_COMMON,h32,tmp,0,rl,cbufs,coffs,clens);
    if(seqC>=0){
        z_led(s,OP_MCOMMON,slot_find(s,Z4_NS_COMMON,seqC),0,0,0,0,0,0,
              ns,seq,0,seqC,0,1,0);
        return seqC;
    }
    seqC=z_next_seq(s,Z4_NS_COMMON);
    let off:i32=iget(s.*.offs,sl*4);
    let len:i32=iget(s.*.lens,sl*4);
    let corpus:i32=iget(s.*.corps,sl*4);
    let slC:i32=slot_insert(s,Z4_NS_COMMON,seqC,off,len,corpus);
    if(slC<0){
        z_evict_oldest_unpinned(s);
        slC=slot_insert(s,Z4_NS_COMMON,seqC,off,len,corpus);
    }
    if(slC<0){
        z_led(s,OP_REFUSE,-1,1,off,0,len,corpus,0,Z4_NS_COMMON,seqC,ns,seq,0,106,0);
        return -1;
    }
    ctab_insert(s,Z4_NS_COMMON,h32,seqC,slC);
    z_led(s,OP_MCOMMON,slC,0,off,0,len,corpus,0,ns,seq,0,seqC,0,0,0);
    return seqC;
}

// ---- file IO ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}
// ---- JSON emission (schema metrics-v1) ----
fn j_begin(mode:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"z4\",\"round\":\"r1\",\"scale\":\"1x\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn jf_null(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":null");
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }

// ---- shared trial helpers ----
fn nunits_of(buflen:i32) i32 { return (buflen+Z4_CHUNK-1)/Z4_CHUNK; }
fn unit_off(idx:i32) i32 { return idx*Z4_CHUNK; }
fn unit_len(idx:i32,buflen:i32) i32 {
    let r:i32=buflen-idx*Z4_CHUNK;
    if(r>Z4_CHUNK){r=Z4_CHUNK;}
    return r;
}
fn reg_set(coffs:[]u8,clens:[]u8,corpus:i32,base:i32,len:i32) void {
    iput(coffs,(corpus-1)*4,base);
    iput(clens,(corpus-1)*4,len);
}
fn z_init_idseq(idseq:[]u8,n:i32) void {
    let i:i32=0;while(i<n){iput(idseq,i*4,-1);i=i+1;}
}
fn zingest_all(s:*Z4,buf:[]u8,corpus:i32,ns:i32,
               cbufs:[]u8,coffs:[]u8,clens:[]u8,idseq:[]u8)i32 {
    let n:i32=nunits_of(buf.len);
    let i:i32=0;
    while(i<n){
        let seq:i32=z_ingest(s,ns,buf,unit_off(i),unit_len(i,buf.len),corpus,
                            cbufs,coffs,clens);
        iput(idseq,i*4,seq);
        i=i+1;
    }
    return n;
}
fn probe_ns(s:*Z4,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
            ns:i32,idseq:[]u8,bout:[]u8,cok:*i32,bok:*i32) void {
    let n:i32=nunits_of(buf.len);
    let ok:i32=0;let bo:i32=0;
    let flags:[]u8=s.*.flags;let offs:[]u8=s.*.offs;let lens:[]u8=s.*.lens;
    let i:i32=0;
    while(i<n){
        let seq:i32=iget(idseq,i*4);
        let off:i32=unit_off(i);let len:i32=unit_len(i,buf.len);
        let rl:i32=z_recall(s,cbufs,coffs,clens,ns,seq,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=buf[off+q]){good=0;break;}q=q+1;}
            if(good==1){ok=ok+1;}
        }
        let sl:i32=slot_find(s,ns,seq);
        if(sl>=0){
            let f:i32=iget(flags,sl*4);
            if((f&F_LIVE)!=0 && iget(offs,sl*4)==off &&
               iget(lens,sl*4)==len && (f&F_SHIFT)==0){bo=bo+1;}
        }
        i=i+1;
    }
    cok.*=ok*1000/n;bok.*=bo*1000/n;
}
// ---- M1 ID-swap probe (A15, PROVISIONAL-PENDING-FREEZE): patch the ID table
// so the next recall target resolves to (slot+1)%cap, log TRAINER_SWAP_PROBE,
// verify the recall serves the NEIGHBOR's record (or fails loudly if the
// neighbor is not live), then restore. Serving the ORIGINAL content after the
// remap would be a side channel -> FAIL. ----
fn probe_swap(s:*Z4,ns:i32,n:i32,idseq:[]u8,buf:[]u8,
              cbufs:[]u8,coffs:[]u8,clens:[]u8,bout:[]u8,tmp:[]u8)i32 {
    let cap:i32=s.*.cap;
    let nss:[]u8=s.*.nss;let seqs:[]u8=s.*.seqs;let flags:[]u8=s.*.flags;
    let pass:i32=1;
    let p:i32=0;
    while(p<Z4_SWAP_N){
        let idx:i32=p*n/Z4_SWAP_N;
        let seq:i32=iget(idseq,idx*4);
        let sl:i32=slot_find_raw(s,ns,seq);
        if(sl>=0){
            let nsl:i32=(sl+1)%cap;
            iput(s.*.pmap,sl*4,nsl);
            z_led(s,OP_TSP,sl,0,0,0,0,0,0,ns,seq,0,0,0,p,nsl);
            let rl:i32=z_recall(s,cbufs,coffs,clens,ns,seq,bout);
            let nf:i32=iget(flags,nsl*4);
            if((nf&F_LIVE)!=0){
                let nns:i32=iget(nss,nsl*4);
                let nsq:i32=iget(seqs,nsl*4);
                let erl:i32=z_recall(s,cbufs,coffs,clens,nns,nsq,tmp);
                if(rl!=erl){pass=0;}
                else{
                    let off:i32=unit_off(idx);let len:i32=unit_len(idx,buf.len);
                    let same_orig:i32=1;
                    if(erl==len){
                        let q:i32=0;
                        while(q<erl){if(tmp[q]!=buf[off+q]){same_orig=0;break;}q=q+1;}
                    }else{same_orig=0;}
                    if(same_orig==0){
                        let good:i32=1;let q2:i32=0;
                        while(q2<erl){if(bout[q2]!=tmp[q2]){good=0;break;}q2=q2+1;}
                        if(good==0){pass=0;}
                    }
                }
            }else{
                if(rl>=0){pass=0;}
            }
            iput(s.*.pmap,sl*4,-1);
        }else{pass=0;}
        p=p+1;
    }
    return pass;
}

// ---- M1: retention + boundary + ID-swap probe ----
fn t_m1(cdir:[]u8,fname:[]u8,corpus:i32,ns:i32,keyp:[]u8,jmode:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M1,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(buf.len);
    let s:Z4=z4_new(n+n/4+2048,n+8192,n+1024);
    let bout:[]u8=halloc(&s,64);
    let tmp:[]u8=halloc(&s,64);
    let idseq:[]u8=halloc(&s,n*4);
    z_init_idseq(idseq,n);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    zingest_all(&s,buf,corpus,ns,buf,coffs,clens,idseq);
    let cok:i32=0;let bok:i32=0;
    probe_ns(&s,buf,coffs,clens,buf,corpus,ns,idseq,bout,&cok,&bok);
    let sw:i32=probe_swap(&s,ns,n,idseq,buf,buf,coffs,clens,bout,tmp);
    let sws:[]u8="FAIL";
    if(sw==1){sws="PASS";}
    _zag_print("M1,");_zag_print(keyp);_zag_print(",");
    p_dec1(cok as i64);_zag_print(",");p_dec1(bok as i64);_zag_print(",");
    _zag_print("id_probe:");_zag_println(sws);
    let f:i32=0;
    j_begin(jmode);
    jf_dec1(&f,"m1_recall_tenths",cok as i64);
    jf_dec1(&f,"m1_boundary_tenths",bok as i64);
    jf_int(&f,"m1_units",n as i64);
    jf_str(&f,"m1_id_probe",sws);
    jf_str(&f,"m1_id_probe_note","PROVISIONAL-PENDING-FREEZE: N=64 swap probe per A15");
    j_end();
    hfree(&s,bout);hfree(&s,tmp);hfree(&s,idseq);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M2: learning speed + M9 curve shape ----
fn t_m2(cdir:[]u8,fname:[]u8,corpus:i32,ns:i32,tier:[]u8,do_m9:i32) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M2,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(buf.len);
    let s:Z4=z4_new(n+n/4+2048,65536,n+1024);
    let bout:[]u8=halloc(&s,64);
    let idseq:[]u8=halloc(&s,n*4);
    z_init_idseq(idseq,n);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    let cok:i32=0;let bok:i32=0;
    probe_ns(&s,buf,coffs,clens,buf,corpus,ns,idseq,bout,&cok,&bok);
    let r0:i64=cok as i64;
    let rs:[]u8=halloc(&s,51*4);
    iput(rs,0,cok);
    let e:i32=1;let consec:i32=0;let etc:i32=50;let nep:i32=1;
    let rc:i32=cok;let bc:i32=bok;
    while(e<=Z4_M2_EPMAX){
        zingest_all(&s,buf,corpus,ns,buf,coffs,clens,idseq);
        probe_ns(&s,buf,coffs,clens,buf,corpus,ns,idseq,bout,&cok,&bok);
        iput(rs,e*4,cok);
        nep=e+1;
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;rc=cok;bc=bok;break;}
        rc=cok;bc=bok;
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");
    p_i64(censored as i64);_zag_print(",");
    p_dec1(r0);_zag_println("");
    let f:i32=0;
    j_begin(tier);
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",r0);
    jf_dec1(&f,"m2_final_recall_tenths",rc as i64);
    jf_dec1(&f,"m2_final_boundary_tenths",bc as i64);
    if(do_m9==1){
        let npts:i32=nep;
        let takeoff:i32=npts;
        let e2:i32=0;
        while(e2<npts){
            if(iget(rs,e2*4)>=500){takeoff=e2;break;}
            e2=e2+1;
        }
        let steep:i64=0;
        e2=1;
        while(e2<npts){
            let jmp:i64=(iget(rs,e2*4)-iget(rs,(e2-1)*4)) as i64;
            if(jmp>steep){steep=jmp;}
            e2=e2+1;
        }
        let etc_idx:i32=etc;
        if(etc_idx>=npts){etc_idx=npts-1;}
        let to_idx:i32=takeoff;
        if(to_idx>=npts){to_idx=npts-1;}
        let late:i64=(iget(rs,etc_idx*4)-iget(rs,to_idx*4)) as i64;
        let shape:[]u8="other";
        if(steep>=400 && late<=150){shape="fast-then-flat";}
        else{
            if(takeoff>=3 && steep>=400){shape="slow-then-sudden";}
            else{
                if(steep<400){shape="gradual";}
            }
        }
        jf_str(&f,"m9_shape",shape);
        jf_int(&f,"m9_takeoff_ep",takeoff as i64);
        jf_dec1(&f,"m9_steepness_tenths",steep);
        jf_dec1(&f,"m9_late_gain_tenths",late);
        j_end();
        _zag_print("M9,");_zag_print(tier);_zag_print(",");
        _zag_print(shape);_zag_println("");
    }
    if(do_m9==0){
        j_end();
    }
    hfree(&s,bout);hfree(&s,idseq);hfree(&s,coffs);hfree(&s,clens);hfree(&s,rs);
}

// ---- M3: strength trial (V pinned: prose->S1, code->S2; fresh churn->S3) ----
fn t_m3(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M3,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let total:i32=nun_p+nun_c;
    let k:i32=total/Z4_M3_V;
    if(k<1){k=1;}
    let s:Z4=z4_new(Z4_M3_CAP,24000,9000);
    let bout:[]u8=halloc(&s,64);
    let cbufs:[]u8=halloc(&s,prose.len+code.len+fresh.len);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    let i:i32=0;while(i<prose.len){cbufs[i]=prose[i];i=i+1;}
    let j2:i32=0;while(j2<code.len){cbufs[prose.len+j2]=code[j2];j2=j2+1;}
    let j3:i32=0;while(j3<fresh.len){cbufs[prose.len+code.len+j3]=fresh[j3];j3=j3+1;}
    reg_set(coffs,clens,Z4_C_PROSE,0,prose.len);
    reg_set(coffs,clens,Z4_C_CODE,prose.len,code.len);
    reg_set(coffs,clens,Z4_C_FRESH,prose.len+code.len,fresh.len);
    // V: ingest + mark valuable (pin)
    let v_ns:[]u8=halloc(&s,Z4_M3_V*4);
    let v_seq:[]u8=halloc(&s,Z4_M3_V*4);
    let v_corpus:[]u8=halloc(&s,Z4_M3_V*4);
    let v_idx:[]u8=halloc(&s,Z4_M3_V*4);
    let v:i32=0;
    while(v<Z4_M3_V){
        let g:i32=v*k;
        let cid:i32=Z4_C_PROSE;let idx:i32=g;let ns:i32=Z4_NS_S1;
        let buflen:i32=prose.len;
        if(g>=nun_p){cid=Z4_C_CODE;idx=g-nun_p;ns=Z4_NS_S2;buflen=code.len;}
        let seq:i32=z_ingest(&s,ns,cbufs,iget(coffs,(cid-1)*4)+unit_off(idx),
                            unit_len(idx,buflen),cid,cbufs,coffs,clens);
        z_mark_valuable(&s,ns,seq);
        iput(v_ns,v*4,ns);iput(v_seq,v*4,seq);
        iput(v_corpus,v*4,cid);iput(v_idx,v*4,idx);
        v=v+1;
    }
    // phase 1: 3000 fresh ingests (S3)
    let f:i32=0;
    while(f<Z4_M3_FRESH1){
        z_ingest(&s,Z4_NS_S3,cbufs,
                 iget(coffs,(Z4_C_FRESH-1)*4)+unit_off(f),
                 unit_len(f,fresh.len),Z4_C_FRESH,cbufs,coffs,clens);
        f=f+1;
    }
    let n_p1:i32=s.led_n;
    // phase 2: 3000 fresh-only kills (need the seqs: re-resolve via content index)
    f=0;
    while(f<Z4_M3_KILL){
        let off:i32=iget(coffs,(Z4_C_FRESH-1)*4)+unit_off(f);
        let len:i32=unit_len(f,fresh.len);
        let seq:i32=ctab_lookup(&s,Z4_NS_S3,fnv32(cbufs,off,len),cbufs,off,len,
                               cbufs,coffs,clens);
        if(seq>=0){z_kill(&s,Z4_NS_S3,seq,1);}
        f=f+1;
    }
    // weaken probe: 50 weaken ops on every 20th valuable
    let w:i32=0;let w_ok:i32=0;
    while(w<50){
        let vj:i32=w*20;
        if(z_weaken(&s,iget(v_ns,vj*4),iget(v_seq,vj*4),w+1)==0){w_ok=w_ok+1;}
        w=w+1;
    }
    let n_p2:i32=s.led_n;
    // phase 3: 4000 ingests at capacity (z_ingest evicts oldest-unpinned as needed)
    f=Z4_M3_FRESH1;
    while(f<Z4_M3_FRESH1+Z4_M3_FRESH2){
        let off:i32=iget(coffs,(Z4_C_FRESH-1)*4)+unit_off(f);
        let len:i32=unit_len(f,fresh.len);
        z_ingest(&s,Z4_NS_S3,cbufs,off,len,Z4_C_FRESH,cbufs,coffs,clens);
        f=f+1;
    }
    let n_p3:i32=s.led_n;
    // metrics
    let surv_ok:i32=0;
    v=0;
    while(v<Z4_M3_V){
        let ns:i32=iget(v_ns,v*4);let seq:i32=iget(v_seq,v*4);
        let cid:i32=iget(v_corpus,v*4);let idx:i32=iget(v_idx,v*4);
        let buflen:i32=prose.len;let buf:[]u8=prose;
        if(cid==Z4_C_CODE){buflen=code.len;buf=code;}
        let off:i32=unit_off(idx);let len:i32=unit_len(idx,buflen);
        let rl:i32=z_recall(&s,cbufs,coffs,clens,ns,seq,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=buf[off+q]){good=0;break;}q=q+1;}
            if(good==1){surv_ok=surv_ok+1;}
        }
        v=v+1;
    }
    let surv:i64=(surv_ok as i64)*1000/(Z4_M3_V as i64);
    // fresh sample: last 500 ingested (f=6500..6999), resolve seqs via content index
    let fs_ok:i32=0;
    f=Z4_M3_FRESH1+Z4_M3_FRESH2-500;
    while(f<Z4_M3_FRESH1+Z4_M3_FRESH2){
        let off:i32=iget(coffs,(Z4_C_FRESH-1)*4)+unit_off(f);
        let len:i32=unit_len(f,fresh.len);
        let seq:i32=ctab_lookup(&s,Z4_NS_S3,fnv32(cbufs,off,len),cbufs,off,len,
                               cbufs,coffs,clens);
        let rl:i32=z_recall(&s,cbufs,coffs,clens,Z4_NS_S3,seq,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=fresh[off-iget(coffs,(Z4_C_FRESH-1)*4)+q]){good=0;break;}q=q+1;}
            if(good==1){fs_ok=fs_ok+1;}
        }
        f=f+1;
    }
    let fresht:i64=(fs_ok as i64)*1000/500;
    // liveness: management ops in ledger entries [n_p1, n_p3)
    let mgmt:i32=0;let le:i32=n_p1;
    while(le<n_p3){
        let op:i32=iget(s.led,le*64);
        if(op==OP_ADD || op==OP_KILL || op==OP_PIN || op==OP_WEAKEN ||
           op==OP_PROMOTE || op==OP_EVICT || op==OP_REFUSE){mgmt=mgmt+1;}
        le=le+1;
    }
    let freeze:i32=0;
    if(surv>=900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    if(w_ok<50){freeze=1;}
    let fz:[]u8="CLEAR";
    if(freeze==1){fz="FROZEN-UNDER-PRESSURE";}
    _zag_print("M3,");
    p_dec1(surv);_zag_print(",");p_dec1(fresht);_zag_print(",");
    p_i64(mgmt as i64);_zag_print(",");p_i64(w_ok as i64);_zag_print(",");
    _zag_println(fz);
    let ff:i32=0;
    j_begin("m3-1x");
    jf_dec1(&ff,"m3_survival_tenths",surv);
    jf_dec1(&ff,"m3_fresh_recall_tenths",fresht);
    jf_int(&ff,"m3_mgmt_entries",mgmt as i64);
    jf_int(&ff,"m3_weaken_handled",w_ok as i64);
    jf_str(&ff,"m3_freeze",fz);
    jf_int(&ff,"m3_valuable",Z4_M3_V as i64);
    j_end();
    hfree(&s,bout);hfree(&s,cbufs);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,v_ns);hfree(&s,v_seq);hfree(&s,v_corpus);hfree(&s,v_idx);
}

// ---- defect patch builders ----
fn patch_prose_xor(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;
    while(i<len){
        let b:u8=buf[off+i];
        if(i%7==0){b=(b as i32 ^ 255) as u8;}
        out[i]=b;i=i+1;
    }
}
fn code_rename(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;while(i<len){out[i]=buf[off+i];i=i+1;}
    let p0:[]u8="sqlite3";let r0:[]u8="sqlite4";
    let p1:[]u8="SQLITE";let r1:[]u8="SQLITF";
    let p2:[]u8="Vdbe";let r2:[]u8="Vdbf";
    let p3:[]u8="Mem";let r3:[]u8="Mfm";
    let p4:[]u8="pBt";let r4:[]u8="pBu";
    let k:i32=0;
    while(k<5){
        let pat:[]u8=p0;let rep:[]u8=r0;
        if(k==1){pat=p1;rep=r1;}
        if(k==2){pat=p2;rep=r2;}
        if(k==3){pat=p3;rep=r3;}
        if(k==4){pat=p4;rep=r4;}
        let pl:i32=pat.len;
        let pos:i32=0;
        while(pos+pl<=len){
            let m:i32=1;let q:i32=0;
            while(q<pl){if(out[pos+q]!=pat[q]){m=0;break;}q=q+1;}
            if(m==1){q=0;while(q<pl){out[pos+q]=rep[q];q=q+1;}pos=pos+pl;}
            else{pos=pos+1;}
        }
        k=k+1;
    }
}
fn unit_verified_ns(s:*Z4,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
                    ns:i32,seq:i32,idx:i32,bout:[]u8) i32 {
    let sl:i32=slot_find(s,ns,seq);
    if(sl<0){return 0;}
    let f:i32=iget(s.*.flags,sl*4);
    if((f & F_LIVE)==0){return 0;}
    if((f & (F_SHIFT | F_PATCH))!=0){return 0;}
    let off:i32=unit_off(idx);let len:i32=unit_len(idx,buf.len);
    let rl:i32=z_recall(s,cbufs,coffs,clens,ns,seq,bout);
    if(rl!=len){return 0;}
    let i:i32=0;while(i<len){if(bout[i]!=buf[off+i]){return 0;}i=i+1;}
    return 1;
}

// ---- M4: defect revision ----
fn t_m4(cdir:[]u8,fname:[]u8,corpus:i32,ns:i32,is_code:i32,keyp:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M4,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(buf.len);
    let s:Z4=z4_new(n+n/4+2048,n+8192,n+1024);
    let bout:[]u8=halloc(&s,64);
    let patch:[]u8=halloc(&s,64);
    let idseq:[]u8=halloc(&s,n*4);
    z_init_idseq(idseq,n);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    zingest_all(&s,buf,corpus,ns,buf,coffs,clens,idseq);
    let d_idx:[]u8=halloc(&s,Z4_M4_N*4);
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    let j:i32=0;
    while(j<Z4_M4_N){
        let idx:i32=j*n/Z4_M4_N;
        iput(d_idx,j*4,idx);
        let seq:i32=iget(idseq,idx*4);
        if(j<100){
            z_defect_boundary(&s,ns,seq,iget(cyc,(j%12)*4));
        }else{
            let off:i32=unit_off(idx);let len:i32=unit_len(idx,buf.len);
            if(is_code==1){code_rename(buf,off,len,patch);}
            else{patch_prose_xor(buf,off,len,patch);}
            z_defect_content(&s,ns,seq,patch,len);
        }
        j=j+1;
    }
    let rep_b:i32=0;let rep_c:i32=0;
    let ep:i32=1;
    while(ep<=20){
        j=0;
        while(j<Z4_M4_N){
            z_revise(&s,ns,iget(idseq,iget(d_idx,j*4)*4));
            j=j+1;
        }
        rep_b=0;rep_c=0;
        j=0;
        while(j<100){
            let idx:i32=iget(d_idx,j*4);
            rep_b=rep_b+unit_verified_ns(&s,buf,coffs,clens,buf,corpus,ns,
                                        iget(idseq,idx*4),idx,bout);
            j=j+1;
        }
        j=100;
        while(j<Z4_M4_N){
            let idx:i32=iget(d_idx,j*4);
            rep_c=rep_c+unit_verified_ns(&s,buf,coffs,clens,buf,corpus,ns,
                                        iget(idseq,idx*4),idx,bout);
            j=j+1;
        }
        if(rep_b+rep_c>=Z4_M4_N){break;}
        ep=ep+1;
    }
    let killed:i32=0;
    j=0;
    while(j<Z4_M4_N){
        let idx:i32=iget(d_idx,j*4);
        let sl:i32=slot_find(&s,ns,iget(idseq,idx*4));
        if(sl>=0){
            let f:i32=iget(s.flags,sl*4);
            if((f & F_LIVE)==0){killed=killed+1;}
        }else{killed=killed+1;}
        j=j+1;
    }
    let rev_bt:i64=(rep_b as i64)*1000/100;
    let rev_ct:i64=(rep_c as i64)*1000/100;
    let kill_t:i64=(killed as i64)*1000/(Z4_M4_N as i64);
    let ksub:i32=0;
    if(kill_t>500 && (rev_bt<800 || rev_ct<800)){ksub=1;}
    _zag_print("M4,");_zag_print(keyp);_zag_print(",");
    p_dec1(rev_bt);_zag_print(",");p_dec1(rev_ct);_zag_print(",");
    p_dec1(kill_t);_zag_print(",");p_i64(ksub as i64);_zag_println("");
    let f:i32=0;
    j_begin(keyp);
    jf_dec1(&f,"m4_rev_boundary_tenths",rev_bt);
    jf_dec1(&f,"m4_rev_content_tenths",rev_ct);
    jf_dec1(&f,"m4_kill_rate_tenths",kill_t);
    jf_bool(&f,"m4_killsub",ksub);
    jf_int(&f,"m4_episodes",ep as i64);
    j_end();
    hfree(&s,bout);hfree(&s,patch);hfree(&s,idseq);
    hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,cyc);hfree(&s,d_idx);
}

// ---- M5: resource pressure ----
fn t_m5(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0){_zag_println("M5,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(prose.len);
    let cap:i32=n+n/4+4096;
    let s:Z4=z4_new(cap,n+4096,n+2048);
    let bout:[]u8=halloc(&s,64);
    let idseq:[]u8=halloc(&s,n*4);
    z_init_idseq(idseq,n);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,Z4_C_PROSE,0,prose.len);
    zingest_all(&s,prose,Z4_C_PROSE,Z4_NS_S1,prose,coffs,clens,idseq);
    let f:i32=0;
    while(f<500){
        z_ingest(&s,Z4_NS_S3,fresh,unit_off(f),unit_len(f,fresh.len),Z4_C_FRESH,
                 fresh,coffs,clens);
        f=f+1;
    }
    f=0;
    while(f<500){
        let off:i32=unit_off(f);let len:i32=unit_len(f,fresh.len);
        let seq:i32=ctab_lookup(&s,Z4_NS_S3,fnv32(fresh,off,len),fresh,off,len,
                               fresh,coffs,clens);
        if(seq>=0){z_kill(&s,Z4_NS_S3,seq,2);}
        f=f+1;
    }
    let l:i32=0;let src:i64=0;
    let i2:i32=0;
    while(i2<n){
        let seq:i32=iget(idseq,i2*4);
        let off:i32=unit_off(i2);let len:i32=unit_len(i2,prose.len);
        let rl:i32=z_recall(&s,prose,coffs,clens,Z4_NS_S1,seq,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=prose[off+q]){good=0;break;}q=q+1;}
            if(good==1){l=l+1;src=src+(len as i64);}
        }
        i2=i2+1;
    }
    // slot tables: 8 id/span arrays + content index + insertion queue
    let slot_bytes:i64=(cap as i64)*32+(s.ctab_cap as i64)*16+(s.ins_cap as i64)*4;
    let ledger_bytes:i64=(s.led_n as i64)*64;
    let wf:i32=write_file(".","ledger.bin",s.led[0..s.led_n*64]);
    _zag_print("M5,");p_i64(l as i64);_zag_print(",");
    p_i64(src);_zag_print(",");p_i64(slot_bytes);_zag_print(",");
    p_i64(ledger_bytes);_zag_print(",");p_i64(wf as i64);_zag_println("");
    let ff:i32=0;
    j_begin("m5-1x");
    jf_int(&ff,"m5_units_learned",l as i64);
    jf_int(&ff,"m5_source_bytes_learned",src);
    jf_int(&ff,"m5_slot_table_bytes",slot_bytes);
    jf_int(&ff,"m5_ledger_bytes",ledger_bytes);
    jf_int(&ff,"m5_ledger_entries",s.led_n as i64);
    jf_int(&ff,"m5_corpus_buffer_bytes",prose.len as i64);
    j_end();
    hfree(&s,bout);hfree(&s,idseq);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M6: multi-party transfer. Train under the speaker's namespace; face the
// new domain under the NEW speaker's namespace. Byte-identical chunks go
// through TRANSLATE (logged derivation) + common-ground promotion per the
// preregistered governance rule; novel chunks get fresh speaker ids. ----
fn t_m6(cdir:[]u8,dir:i32) void {
    let tname:[]u8="t1_prose.bin";let tcid:i32=Z4_C_T1P;
    let yname:[]u8="code.bin";let ycid:i32=Z4_C_CODE;
    let tns:i32=Z4_NS_S1;let yns:i32=Z4_NS_S2;
    let dkey:[]u8="m6-p2c-1x";let dtag:[]u8="p2c";
    if(dir==1){
        tname="t1_code.bin";tcid=Z4_C_T1C;yname="prose.bin";ycid=Z4_C_PROSE;
        tns=Z4_NS_S2;yns=Z4_NS_S1;
        dkey="m6-c2p-1x";dtag="c2p";
    }
    let tbuf:[]u8=read_file(cdir,tname);
    let ybuf:[]u8=read_file(cdir,yname);
    if(tbuf.len==0 || ybuf.len==0){_zag_println("M6,FATAL,empty-corpus");return;}
    let nt:i32=nunits_of(tbuf.len);let ny:i32=nunits_of(ybuf.len);
    let s:Z4=z4_new(nt+ny+(nt+ny)/4+8192,nt+ny+8192,nt+ny+2048);
    let bout:[]u8=halloc(&s,64);
    let tmp:[]u8=halloc(&s,64);
    let tidseq:[]u8=halloc(&s,nt*4);z_init_idseq(tidseq,nt);
    let yidseq:[]u8=halloc(&s,ny*4);z_init_idseq(yidseq,ny);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,tcid,0,tbuf.len);
    reg_set(coffs,clens,ycid,0,ybuf.len);
    // train on tier-1 to the M2 criterion (policy frozen afterwards)
    let cok:i32=0;let bok:i32=0;
    let e:i32=1;let consec:i32=0;let etc:i32=50;
    while(e<=50){
        zingest_all(&s,tbuf,tcid,tns,tbuf,coffs,clens,tidseq);
        probe_ns(&s,tbuf,coffs,clens,tbuf,tcid,tns,tidseq,bout,&cok,&bok);
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;break;}
        e=e+1;
    }
    let rec_d:i64=cok as i64;let bnd_d:i64=bok as i64;
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    // in-domain revision: 100 boundary defects on train units
    let j:i32=0;
    while(j<100){
        let idx:i32=j*nt/100;
        z_defect_boundary(&s,tns,iget(tidseq,idx*4),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        z_revise(&s,tns,iget(tidseq,(j*nt/100)*4));
        j=j+1;
    }
    let rev_d:i32=0;
    j=0;
    while(j<100){
        let idx:i32=j*nt/100;
        rev_d=rev_d+unit_verified_ns(&s,tbuf,coffs,clens,tbuf,tcid,tns,
                                    iget(tidseq,idx*4),idx,bout);
        j=j+1;
    }
    let rev_dt:i64=(rev_d as i64)*10;
    // transfer: face the new domain under the new speaker's namespace
    let ntrans:i32=0;let ncommon:i32=0;
    j=0;
    while(j<ny){
        let off:i32=unit_off(j);let len:i32=unit_len(j,ybuf.len);
        let h32:i32=fnv32(ybuf,off,len);
        let sseq:i32=ctab_lookup(&s,tns,h32,ybuf,off,len,tbuf,coffs,clens);
        let yseq:i32=-1;
        if(sseq>=0){
            yseq=z_translate(&s,tns,sseq,yns,tbuf,coffs,clens,tmp);
            if(z_mark_common(&s,yns,yseq,tbuf,coffs,clens,tmp)>=0){ncommon=ncommon+1;}
            ntrans=ntrans+1;
        }else{
            yseq=z_ingest(&s,yns,ybuf,off,len,ycid,ybuf,coffs,clens);
        }
        iput(yidseq,j*4,yseq);
        j=j+1;
    }
    let rec_t:i32=0;let bnd_t:i32=0;
    probe_ns(&s,ybuf,coffs,clens,ybuf,ycid,yns,yidseq,bout,&rec_t,&bnd_t);
    // transfer revision
    j=0;
    while(j<100){
        let idx:i32=j*ny/100;
        z_defect_boundary(&s,yns,iget(yidseq,idx*4),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        z_revise(&s,yns,iget(yidseq,(j*ny/100)*4));
        j=j+1;
    }
    let rev_t:i32=0;
    j=0;
    while(j<100){
        let idx:i32=j*ny/100;
        rev_t=rev_t+unit_verified_ns(&s,ybuf,coffs,clens,ybuf,ycid,yns,
                                    iget(yidseq,idx*4),idx,bout);
        j=j+1;
    }
    let rev_tt:i64=(rev_t as i64)*10;
    // duplication (kill bar 2): transfer-speaker chunks byte-identical to some
    // train-namespace chunk, over live transfer-speaker chunks.
    let dup:i32=0;
    j=0;
    while(j<ny){
        let off:i32=unit_off(j);let len:i32=unit_len(j,ybuf.len);
        if(ctab_lookup(&s,tns,fnv32(ybuf,off,len),ybuf,off,len,
                       tbuf,coffs,clens)>=0){dup=dup+1;}
        j=j+1;
    }
    let dup_t:i64=(dup as i64)*1000/(ny as i64);
    let tax:i64=((rec_d-(rec_t as i64))+((bnd_d-(bnd_t as i64)))+(rev_dt-rev_tt))/3;
    _zag_print("M6,");_zag_print(dtag);_zag_print(",");
    p_dec1(rec_t as i64);_zag_print(",");p_dec1(bnd_t as i64);_zag_print(",");
    p_dec1(rev_tt);_zag_print(",");p_dec1(tax);_zag_print(",");
    p_dec1(dup_t);_zag_println("");
    let f:i32=0;
    j_begin(dkey);
    jf_dec1(&f,"rec_tenths",rec_t as i64);
    jf_dec1(&f,"bnd_tenths",bnd_t as i64);
    jf_dec1(&f,"rev_tenths",rev_tt);
    jf_dec1(&f,"tax_tenths",tax);
    jf_dec1(&f,"z4_dup_tenths",dup_t);
    jf_int(&f,"z4_translate_hits",ntrans as i64);
    jf_int(&f,"z4_common_minted",ncommon as i64);
    jf_int(&f,"z4_transfer_units",ny as i64);
    j_end();
    hfree(&s,bout);hfree(&s,tmp);hfree(&s,tidseq);hfree(&s,yidseq);
    hfree(&s,coffs);hfree(&s,clens);hfree(&s,cyc);
}

// ---- M7: ID-arm dedup rig. Round 0: ingest C. Round 1: ingest C again
// (dedup/revive). Round 2: ingest C' (every-100th-unit edited -> new ids).
// hit = served-from-ID-mapping/lookups; reuse = ID references (ingest
// resolutions + lookups) / distinct live IDs (Z4-A-m7r); dedup savings =
// bytes not re-stored. Lookup schedule (l*37)%n PROVISIONAL-PENDING-FREEZE. ----
fn t_m7(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("M7,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(prose.len);
    let s:Z4=z4_new(n+n/4+2048,n+2048,n+1024);
    let bout:[]u8=halloc(&s,64);
    let idseq:[]u8=halloc(&s,n*4);
    z_init_idseq(idseq,n);
    // C' buffer: every-100th-unit first byte XOR
    let cp:[]u8=halloc(&s,prose.len);
    let q:i32=0;while(q<prose.len){cp[q]=prose[q];q=q+1;}
    let edited_bytes:i64=0;
    q=0;
    while(q<n){
        if(q%100==0){
            let off:i32=unit_off(q);
            cp[off]=(cp[off] as i32 ^ 255) as u8;
            edited_bytes=edited_bytes+(unit_len(q,prose.len) as i64);
        }
        q=q+1;
    }
    // registry: prose@0 (corpus 1), C'@prose.len (corpus 8)
    let cbufs:[]u8=halloc(&s,prose.len+prose.len);
    q=0;while(q<prose.len){cbufs[q]=prose[q];cbufs[prose.len+q]=cp[q];q=q+1;}
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,Z4_C_PROSE,0,prose.len);
    reg_set(coffs,clens,Z4_C_FRESH,prose.len,prose.len);
    zingest_all(&s,prose,Z4_C_PROSE,Z4_NS_S1,cbufs,coffs,clens,idseq);
    zingest_all(&s,prose,Z4_C_PROSE,Z4_NS_S1,cbufs,coffs,clens,idseq);
    let refs:i64=(n as i64)*2;
    let hits:i32=0;
    let reread:i64=0;
    let l:i32=0;
    while(l<1666){
        let idx:i32=(l*37)%n;
        let rl:i32=z_recall(&s,cbufs,coffs,clens,Z4_NS_S1,iget(idseq,idx*4),bout);
        refs=refs+1;
        if(rl>0){reread=reread+(rl as i64);hits=hits+1;}
        l=l+1;
    }
    zingest_all(&s,cp,Z4_C_FRESH,Z4_NS_S1,cbufs,coffs,clens,idseq);
    refs=refs+(n as i64);
    while(l<Z4_M7_LOOKUPS){
        let idx:i32=(l*37)%n;
        let off:i32=unit_off(idx);let len:i32=unit_len(idx,prose.len);
        let rl:i32=z_recall(&s,cbufs,coffs,clens,Z4_NS_S1,iget(idseq,idx*4),bout);
        refs=refs+1;
        if(rl==len){
            let good:i32=1;let k:i32=0;
            while(k<len){if(bout[k]!=cp[off+k]){good=0;break;}k=k+1;}
            if(good==1){hits=hits+1;}
        }
        if(rl>0){reread=reread+(rl as i64);}
        l=l+1;
    }
    let hit_t:i64=(hits as i64)*1000/(Z4_M7_LOOKUPS as i64);
    let distinct:i64=s.nlive as i64;
    let reuse_t:i64=refs*10/distinct;
    let dedup_saved:i64=(prose.len as i64)*2-edited_bytes;
    let dedup_ratio_t:i64=((3*(n as i64)-distinct)*1000)/(3*(n as i64));
    _zag_print("M7,");
    p_dec1(hit_t);_zag_print(",");p_dec1(reuse_t);_zag_print(",");
    p_i64(dedup_saved);_zag_println("");
    let f:i32=0;
    j_begin("m7-1x");
    jf_dec1(&f,"m7_hit_rate_tenths",hit_t);
    jf_dec1(&f,"m7_reuse_rate_tenths",reuse_t);
    jf_int(&f,"m7_dedup_savings_bytes",dedup_saved);
    jf_dec1(&f,"m7_dedup_ratio_tenths",dedup_ratio_t);
    jf_null(&f,"m7_na_reason",0);
    jf_int(&f,"m7_reread_bytes",reread);
    jf_int(&f,"m7_units",n as i64);
    jf_int(&f,"m7_distinct_live",distinct);
    j_end();
    hfree(&s,bout);hfree(&s,idseq);hfree(&s,cp);
    hfree(&s,cbufs);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M8: determinism gate (N=5 adversarial full M1+M3 runs, one instance) ----
fn img_append(dst:[]u8,at:i32,src:[]u8,n:i32) i32 {
    let i:i32=0;while(i<n){dst[at+i]=src[i];i=i+1;}
    return at+n;
}
fn write_hex_line(dir:[]u8,fname:[]u8,tag:[]u8,hash:[]u8) i32 {
    let hx:[]u8=ns_hex(hash);
    let line:[]u8=nio_alloc(tag.len+1+hx.len+1);
    let i:i32=0;while(i<tag.len){line[i]=tag[i];i=i+1;}
    line[tag.len]=32;
    let k:i32=0;while(k<hx.len){line[tag.len+1+k]=hx[k];k=k+1;}
    line[tag.len+1+hx.len]=10;
    let r:i32=write_file(dir,fname,line);
    nio_free(hx);nio_free(line);
    return r;
}
fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            i=i+1;
        }
    }
    let aslr_pad:[]u8="";
    if(_zag_strcmp(pert,"aslr")==1){
        aslr_pad=nio_alloc(1234567);
    }
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M8,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let cap:i32=nun_p+nun_c+(nun_p+nun_c)/4+16384;
    let s:Z4=z4_new(cap,260000,nun_p+nun_c+9000);
    let bout:[]u8=halloc(&s,64);
    let cbufs:[]u8=halloc(&s,prose.len+code.len+fresh.len);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    let i:i32=0;while(i<prose.len){cbufs[i]=prose[i];i=i+1;}
    let j2:i32=0;while(j2<code.len){cbufs[prose.len+j2]=code[j2];j2=j2+1;}
    let j3:i32=0;while(j3<fresh.len){cbufs[prose.len+code.len+j3]=fresh[j3];j3=j3+1;}
    reg_set(coffs,clens,Z4_C_PROSE,0,prose.len);
    reg_set(coffs,clens,Z4_C_CODE,prose.len,code.len);
    reg_set(coffs,clens,Z4_C_FRESH,prose.len+code.len,fresh.len);
    // M1: ingest + full recall both corpora (prose->S1, code->S2)
    let idp:[]u8=halloc(&s,nun_p*4);z_init_idseq(idp,nun_p);
    let idc:[]u8=halloc(&s,nun_c*4);z_init_idseq(idc,nun_c);
    zingest_all(&s,prose,Z4_C_PROSE,Z4_NS_S1,cbufs,coffs,clens,idp);
    let cok:i32=0;let bok:i32=0;
    probe_ns(&s,cbufs,coffs,clens,prose,Z4_C_PROSE,Z4_NS_S1,idp,bout,&cok,&bok);
    let m1p:i32=cok;
    zingest_all(&s,code,Z4_C_CODE,Z4_NS_S2,cbufs,coffs,clens,idc);
    probe_ns(&s,cbufs,coffs,clens,code,Z4_C_CODE,Z4_NS_S2,idc,bout,&cok,&bok);
    let m1c:i32=cok;
    // M3 sequence on the same instance
    let total:i32=nun_p+nun_c;
    let k:i32=total/Z4_M3_V;if(k<1){k=1;}
    let v:i32=0;
    while(v<Z4_M3_V){
        let g:i32=v*k;
        let cid:i32=Z4_C_PROSE;let idx:i32=g;let ns:i32=Z4_NS_S1;
        if(g>=nun_p){cid=Z4_C_CODE;idx=g-nun_p;ns=Z4_NS_S2;}
        let buflen:i32=prose.len;
        if(cid==Z4_C_CODE){buflen=code.len;}
        let seq:i32=z_ingest(&s,ns,cbufs,iget(coffs,(cid-1)*4)+unit_off(idx),
                            unit_len(idx,buflen),cid,cbufs,coffs,clens);
        z_mark_valuable(&s,ns,seq);
        v=v+1;
    }
    let f:i32=0;
    while(f<Z4_M3_FRESH1){
        let off:i32=iget(coffs,(Z4_C_FRESH-1)*4)+unit_off(f);
        z_ingest(&s,Z4_NS_S3,cbufs,off,unit_len(f,fresh.len),Z4_C_FRESH,
                 cbufs,coffs,clens);
        f=f+1;
    }
    f=0;
    while(f<Z4_M3_KILL){
        let off:i32=iget(coffs,(Z4_C_FRESH-1)*4)+unit_off(f);
        let len:i32=unit_len(f,fresh.len);
        let seq:i32=ctab_lookup(&s,Z4_NS_S3,fnv32(cbufs,off,len),cbufs,off,len,
                               cbufs,coffs,clens);
        if(seq>=0){z_kill(&s,Z4_NS_S3,seq,1);}
        f=f+1;
    }
    let w:i32=0;
    while(w<50){
        let g2:i32=(w*20)*k;
        let cid2:i32=Z4_C_PROSE;let idx2:i32=g2;let ns2:i32=Z4_NS_S1;
        if(g2>=nun_p){cid2=Z4_C_CODE;idx2=g2-nun_p;ns2=Z4_NS_S2;}
        let buflen2:i32=prose.len;
        if(cid2==Z4_C_CODE){buflen2=code.len;}
        let off2:i32=iget(coffs,(cid2-1)*4)+unit_off(idx2);
        let seq2:i32=ctab_lookup(&s,ns2,fnv32(cbufs,off2,unit_len(idx2,buflen2)),
                                cbufs,off2,unit_len(idx2,buflen2),
                                cbufs,coffs,clens);
        if(seq2>=0){z_weaken(&s,ns2,seq2,w+1);}
        w=w+1;
    }
    f=Z4_M3_FRESH1;
    while(f<Z4_M3_FRESH1+Z4_M3_FRESH2){
        let off:i32=iget(coffs,(Z4_C_FRESH-1)*4)+unit_off(f);
        z_ingest(&s,Z4_NS_S3,cbufs,off,unit_len(f,fresh.len),Z4_C_FRESH,
                 cbufs,coffs,clens);
        f=f+1;
    }
    // artifacts: store image covers EVERY persistent mapping
    let img:[]u8=halloc(&s,cap*32+s.ins_cap*4+s.ctab_cap*16+32+cap*4);
    let at:i32=0;
    at=img_append(img,at,s.nss,cap*4);
    at=img_append(img,at,s.seqs,cap*4);
    at=img_append(img,at,s.offs,cap*4);
    at=img_append(img,at,s.lens,cap*4);
    at=img_append(img,at,s.corps,cap*4);
    at=img_append(img,at,s.flags,cap*4);
    at=img_append(img,at,s.shifts,cap*4);
    at=img_append(img,at,s.pidx,cap*4);
    at=img_append(img,at,s.ins,s.ins_cap*4);
    at=img_append(img,at,s.ctab,s.ctab_cap*16);
    at=img_append(img,at,s.nseq,32);
    at=img_append(img,at,s.pmap,cap*4);
    let nch:i32=(img.len+1048575)/1048576;
    let chain_in:[]u8=halloc(&s,nch*32);
    let ci:i32=0;
    while(ci<nch){
        let cs:i32=ci*1048576;let cn:i32=img.len-cs;
        if(cn>1048576){cn=1048576;}
        ns_sha256(img[cs..cs+cn],chain_in[ci*32..ci*32+32]);
        ci=ci+1;
    }
    let chl:[]u8=halloc(&s,nch*80);
    let cho:i32=0;
    ci=0;
    while(ci<nch){
        let cs:i32=ci*32;
        let hx:[]u8=ns_hex(chain_in[cs..cs+32]);
        let tag:[]u8=_zag_i64_to_str(ci as i64);
        chl[cho]=99;chl[cho+1]=104;chl[cho+2]=117;chl[cho+3]=110;chl[cho+4]=107;cho=cho+5;
        let a2:i32=0;while(a2<tag.len){chl[cho]=tag[a2];cho=cho+1;a2=a2+1;}
        chl[cho]=32;cho=cho+1;
        let b2:i32=0;while(b2<hx.len){chl[cho]=hx[b2];cho=cho+1;b2=b2+1;}
        chl[cho]=10;cho=cho+1;
        nio_free(hx);nio_free(tag);
        ci=ci+1;
    }
    write_file(outdir,"store_hashes.txt",chl[0..cho]);
    let chain:[]u8=halloc(&s,32);
    ns_sha256(chain_in,chain);
    write_hex_line(outdir,"store_chain.txt","chain",chain);
    write_file(outdir,"ledger.bin",s.led[0..s.led_n*64]);
    let lhash:[]u8=halloc(&s,32);
    ns_sha256(s.led[0..s.led_n*64],lhash);
    write_hex_line(outdir,"ledger_chain.txt","chain",lhash);
    write_file(outdir,"alloc_trace.txt",s.trace[0..s.trace_n]);
    _zag_print("M8,");
    p_dec1(m1p as i64);_zag_print(",");p_dec1(m1c as i64);_zag_print(",");
    p_i64(s.led_n as i64);_zag_println("");
    hfree(&s,bout);hfree(&s,cbufs);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,idp);hfree(&s,idc);
    hfree(&s,img);hfree(&s,chain_in);hfree(&s,chl);
    if(aslr_pad.len>0){nio_free(aslr_pad);}
}

// ---- ZCONV: the binding convergence race (kill bar 1).
// Two-speaker curriculum: odd episodes S1 (t1_prose) under NS_S1, even episodes
// S2 (t1_code) under NS_S2. Per-speaker ETCs vs a shared-lexicon control leg
// (both speakers under ONE namespace). speedup = (S-P)/S; bar fires iff <30%.
// PROVISIONAL-PENDING-FREEZE (frozen docs define neither the curriculum nor
// the convergence operationalization; this is the adopted literal reading). ----
fn t_zconv(cdir:[]u8) void {
    let p1:[]u8=read_file(cdir,"t1_prose.bin");
    let c1:[]u8=read_file(cdir,"t1_code.bin");
    if(p1.len==0 || c1.len==0){_zag_println("ZCONV,FATAL,empty-corpus");return;}
    let n1:i32=nunits_of(p1.len);let n2:i32=nunits_of(c1.len);
    // per-speaker leg
    let s:Z4=z4_new(n1+n2+4096,65536,n1+n2+1024);
    let bout:[]u8=halloc(&s,64);
    let id1:[]u8=halloc(&s,n1*4);z_init_idseq(id1,n1);
    let id2:[]u8=halloc(&s,n2*4);z_init_idseq(id2,n2);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,Z4_C_T1P,0,p1.len);
    reg_set(coffs,clens,Z4_C_T1C,p1.len,c1.len);
    let cbufs:[]u8=halloc(&s,p1.len+c1.len);
    let i:i32=0;while(i<p1.len){cbufs[i]=p1[i];i=i+1;}
    i=0;while(i<c1.len){cbufs[p1.len+i]=c1[i];i=i+1;}
    let cok:i32=0;let bok:i32=0;
    let etc1:i32=50;let etc2:i32=50;
    let con1:i32=0;let con2:i32=0;
    let e:i32=1;
    while(e<=50){
        if(e%2==1){
            zingest_all(&s,p1,Z4_C_T1P,Z4_NS_S1,cbufs,coffs,clens,id1);
            probe_ns(&s,cbufs,coffs,clens,p1,Z4_C_T1P,Z4_NS_S1,id1,bout,&cok,&bok);
            if(cok>=995 && bok>=950){con1=con1+1;}else{con1=0;}
            if(con1>=3 && etc1>=50){etc1=e-4;}
        }else{
            zingest_all(&s,c1,Z4_C_T1C,Z4_NS_S2,cbufs,coffs,clens,id2);
            probe_ns(&s,cbufs,coffs,clens,c1,Z4_C_T1C,Z4_NS_S2,id2,bout,&cok,&bok);
            if(cok>=995 && bok>=950){con2=con2+1;}else{con2=0;}
            if(con2>=3 && etc2>=50){etc2=e-4;}
        }
        if(etc1<50 && etc2<50){break;}
        e=e+1;
    }
    let ps_recs:i32=s.nlive;let ps_led:i32=s.led_n;
    hfree(&s,bout);hfree(&s,id1);hfree(&s,id2);
    hfree(&s,coffs);hfree(&s,clens);hfree(&s,cbufs);
    // shared leg: one namespace for both speakers
    let t:Z4=z4_new(n1+n2+4096,65536,n1+n2+1024);
    let bout2:[]u8=halloc(&t,64);
    let jd1:[]u8=halloc(&t,n1*4);z_init_idseq(jd1,n1);
    let jd2:[]u8=halloc(&t,n2*4);z_init_idseq(jd2,n2);
    let co2:[]u8=halloc(&t,32);let cl2:[]u8=halloc(&t,32);
    reg_set(co2,cl2,Z4_C_T1P,0,p1.len);
    reg_set(co2,cl2,Z4_C_T1C,p1.len,c1.len);
    let cb2:[]u8=halloc(&t,p1.len+c1.len);
    i=0;while(i<p1.len){cb2[i]=p1[i];i=i+1;}
    i=0;while(i<c1.len){cb2[p1.len+i]=c1[i];i=i+1;}
    let etcS1:i32=50;let etcS2:i32=50;let conS1:i32=0;let conS2:i32=0;
    e=1;
    while(e<=50){
        if(e%2==1){
            zingest_all(&t,p1,Z4_C_T1P,Z4_NS_S1,cb2,co2,cl2,jd1);
            probe_ns(&t,cb2,co2,cl2,p1,Z4_C_T1P,Z4_NS_S1,jd1,bout2,&cok,&bok);
            if(cok>=995 && bok>=950){conS1=conS1+1;}else{conS1=0;}
            if(conS1>=3 && etcS1>=50){etcS1=e-4;}
        }else{
            zingest_all(&t,c1,Z4_C_T1C,Z4_NS_S1,cb2,co2,cl2,jd2);
            probe_ns(&t,cb2,co2,cl2,c1,Z4_C_T1C,Z4_NS_S1,jd2,bout2,&cok,&bok);
            if(cok>=995 && bok>=950){conS2=conS2+1;}else{conS2=0;}
            if(conS2>=3 && etcS2>=50){etcS2=e-4;}
        }
        if(etcS1<50 && etcS2<50){break;}
        e=e+1;
    }
    let sh_recs:i32=t.nlive;let sh_led:i32=t.led_n;
    // symmetric: avg ETC per speaker for both legs
    let p_avg:i64=((etc1+etc2) as i64)*5;   // (etc1+etc2)/2 *10
    let s_avg:i64=((etcS1+etcS2) as i64)*5;
    let speedup:i64=0;
    if(s_avg>0){speedup=(s_avg-p_avg)*1000/s_avg;}
    let bar1:i32=0;
    if(speedup<300){bar1=1;}
    _zag_print("ZCONV,etc_s1=");p_i64(etc1 as i64);
    _zag_print(",etc_s2=");p_i64(etc2 as i64);
    _zag_print(",etc_sh_s1=");p_i64(etcS1 as i64);
    _zag_print(",etc_sh_s2=");p_i64(etcS2 as i64);
    _zag_print(",speedup_tenths_pct=");p_i64(speedup);
    _zag_print(",bar1_fired=");p_i64(bar1 as i64);_zag_println("");
    let f:i32=0;
    j_begin("zconv-1x");
    jf_int(&f,"z4_conv_etc_s1",etc1 as i64);
    jf_int(&f,"z4_conv_etc_s2",etc2 as i64);
    jf_int(&f,"z4_conv_etc_sh_s1",etcS1 as i64);
    jf_int(&f,"z4_conv_etc_sh_s2",etcS2 as i64);
    jf_int(&f,"z4_conv_speedup_tenths_pct",speedup);
    jf_bool(&f,"z4_conv_bar1_fired",bar1);
    jf_int(&f,"z4_conv_ps_records",ps_recs as i64);
    jf_int(&f,"z4_conv_ps_ledger",ps_led as i64);
    jf_int(&f,"z4_conv_sh_records",sh_recs as i64);
    jf_int(&f,"z4_conv_sh_ledger",sh_led as i64);
    j_end();
    hfree(&t,bout2);hfree(&t,jd1);hfree(&t,jd2);
    hfree(&t,co2);hfree(&t,cl2);hfree(&t,cb2);
}

// ---- main dispatch ----
fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    if(mode.len==0){_zag_println("usage: z4 <mode> [corpus-root] [outdir] [perturbation]");return 2;}
    let croot:[]u8=_zag_arg(2);
    if(_zag_strcmp(mode,"m1-1x-prose")==1){t_m1(croot,"prose.bin",Z4_C_PROSE,Z4_NS_S1,"prose","m1-1x-prose");}
    else if(_zag_strcmp(mode,"m1-1x-code")==1){t_m1(croot,"code.bin",Z4_C_CODE,Z4_NS_S2,"code","m1-1x-code");}
    else if(_zag_strcmp(mode,"m2-t1-prose")==1){t_m2(croot,"t1_prose.bin",Z4_C_T1P,Z4_NS_S1,"m2-t1-prose",1);}
    else if(_zag_strcmp(mode,"m2-t1-code")==1){t_m2(croot,"t1_code.bin",Z4_C_T1C,Z4_NS_S2,"m2-t1-code",1);}
    else if(_zag_strcmp(mode,"m2-t2-prose")==1){t_m2(croot,"t2_prose.bin",Z4_C_T2P,Z4_NS_S1,"m2-t2-prose",0);}
    else if(_zag_strcmp(mode,"m2-t2-code")==1){t_m2(croot,"t2_code.bin",Z4_C_T2C,Z4_NS_S2,"m2-t2-code",0);}
    else if(_zag_strcmp(mode,"m2-t3-1x")==1){t_m2(croot,"t3.bin",Z4_C_T3,Z4_NS_S1,"m2-t3-1x",0);}
    else if(_zag_strcmp(mode,"m3-1x")==1){t_m3(croot);}
    else if(_zag_strcmp(mode,"m4-1x-prose")==1){t_m4(croot,"prose.bin",Z4_C_PROSE,Z4_NS_S1,0,"m4-1x-prose");}
    else if(_zag_strcmp(mode,"m4-1x-code")==1){t_m4(croot,"code.bin",Z4_C_CODE,Z4_NS_S2,1,"m4-1x-code");}
    else if(_zag_strcmp(mode,"m5-baseline")==1){
        let psz:i64=file_size(croot,"prose.bin");
        if(psz<=0){_zag_println("M5,FATAL,empty-corpus");return 1;}
        let pn:i32=nunits_of(psz as i32);
        let cap:i32=pn+pn/4+4096;
        let bs:Z4=z4_new(cap,pn+4096,pn+2048);
        let b0:[]u8=bs.nss;let b1:[]u8=bs.offs;let b2:[]u8=bs.lens;let b3:[]u8=bs.corps;
        let b4:[]u8=bs.flags;let b5:[]u8=bs.shifts;let b6:[]u8=bs.pidx;let b7:[]u8=bs.ins;
        let b8:[]u8=bs.ctab;let b9:[]u8=bs.nseq;let b10:[]u8=bs.pmap;let b11:[]u8=bs.seqs;
        let bj:i32=0;
        while(bj<b0.len){b0[bj]=0;b11[bj]=0;b1[bj]=0;b2[bj]=0;b3[bj]=0;b4[bj]=0;b5[bj]=0;b6[bj]=0;bj=bj+1;}
        bj=0;
        while(bj<b7.len){b7[bj]=0;bj=bj+1;}
        bj=0;
        while(bj<b8.len){b8[bj]=0;bj=bj+1;}
        bj=0;
        while(bj<b9.len){b9[bj]=0;bj=bj+1;}
        bj=0;
        while(bj<b10.len){b10[bj]=0;bj=bj+1;}
        _zag_println("M5_BASELINE,ok");
        let f:i32=0;
        j_begin("m5-baseline");
        jf_bool(&f,"m5_baseline",1);
        j_end();
        let spin:i64=0;while(spin<300000000){spin=spin+1;}
    }
    else if(_zag_strcmp(mode,"m5-1x")==1){t_m5(croot);}
    else if(_zag_strcmp(mode,"m6-p2c-1x")==1){t_m6(croot,0);}
    else if(_zag_strcmp(mode,"m6-c2p-1x")==1){t_m6(croot,1);}
    else if(_zag_strcmp(mode,"m7-1x")==1){t_m7(croot);}
    else if(_zag_strcmp(mode,"m8-1x")==1){
        let outdir:[]u8=_zag_arg(3);
        let pert:[]u8=_zag_arg(4);
        if(outdir.len==0 || pert.len==0){
            _zag_println("usage: z4 m8-1x <corpus-root> <outdir> <perturbation>");
            return 2;
        }
        t_m8(croot,outdir,pert);
    }
    else if(_zag_strcmp(mode,"zconv-1x")==1){t_zconv(croot);}
    else{_zag_print("unknown mode: ");_zag_println(mode);return 2;}
    return 0;
}

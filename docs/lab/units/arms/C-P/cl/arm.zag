// cp — Arm C-P: delimiter chunks (whitespace + frozen punctuation set).
// One deterministic scan; maximal runs of non-delimiter bytes become chunks;
// maximal delimiter runs become their own chunks (lossless: every byte belongs
// to exactly one chunk). Chunk IDs in stream order: id = (corpus<<24)|index.
// Non-ID layer (ARM_INTERFACE.md §9 provisional classification CONFIRMED):
// recall takes the positional unit key and resolves through the entry slots;
// there is no persistent ID->storage translation structure, no version chain.
// Pure Zag, zero RNG in any decision path, byte-identical reruns.
// Trial layout: C-P/cl/arm.zag + C-P/substrate/{R33_NATIVE_SHA256_V2.zag,R33_NATIVE_IO_V1.zag}
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

// ---- frozen delimiter set (C-P design freeze) ----
// Delimiter iff byte is NOT ASCII alphanumeric. Frozen byte classes:
//   delimiter: 0x00-0x2F, 0x3A-0x40, 0x5B-0x60, 0x7B-0xFF
//   chunk byte: 0x30-0x39, 0x41-0x5A, 0x61-0x7A
// This is a strict superset of C-W's whitespace/newline set, fixed before
// the run and never revised mid-run (ALPHABET_A-F.md §C: just=0 imposed).
const CP_C_PROSE:i32=1;
const CP_C_CODE:i32=2;
const CP_C_T1P:i32=3;
const CP_C_T1C:i32=4;
const CP_C_T2P:i32=5;
const CP_C_T2C:i32=6;
const CP_C_T3:i32=7;
const CP_C_FRESH:i32=8;
const CP_M3_CAP:i32=4000;      // C_M3: harness-fixed M3 store capacity (slots)
const CP_M3_V:i32=1000;        // valuable set size
const CP_M3_FRESH1:i32=3000;   // phase-1 fresh ingests
const CP_M3_KILL:i32=3000;     // phase-2 kills
const CP_M3_FRESH2:i32=4000;   // phase-3 ingests at capacity
const CP_M4_N:i32=200;         // defect units per corpus
const CP_M7_LOOKUPS:i32=5000;

// flags bits
const F_OCC:i32=1;
const F_LIVE:i32=2;
const F_PIN:i32=4;
const F_WEAK:i32=8;
const F_SHIFT:i32=16;
const F_PATCH:i32=32;

// ledger opcodes (frozen namespace, ARM_INTERFACE.md §6)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_SCAN:i32=7;   // SCAN_COMMIT: bulk ingest; deterministic replay = re-scan
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_TDB:i32=16;   // TRAINER_DEFECT_BOUNDARY
const OP_TDC:i32=17;   // TRAINER_DEFECT_CONTENT
const OP_TMV:i32=18;   // TRAINER_MARK_VALUABLE

// ---- little-endian u32/i32 packing on []u8 (playbook idiom) ----
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }

// ---- allocator wrappers with trace (addresses never logged) ----
struct CP {
    cap:i32,
    ids:[]u8,      // cap * u32: unit id
    offs:[]u8,     // cap * u32: byte offset
    lens:[]u8,     // cap * u32: length
    corps:[]u8,    // cap * u32: corpus id
    flags:[]u8,    // cap * u32: flags bits
    shifts:[]u8,   // cap * i32: recorded boundary shift
    pidx:[]u8,     // cap * i32: patch arena offset or -1
    parena:[]u8,   // variable-length patch bytes (bump arena)
    parena_n:i32,
    parena_cap:i32,
    led:[]u8,      // ledger bytes
    led_n:i32,     // entries appended
    led_cap:i32,   // byte capacity
    ins:[]u8,      // insertion-order queue of slots (ins_cap * i32)
    ins_cap:i32,
    ins_n:i32,
    ins_head:i32,
    trace:[]u8,    // alloc trace text
    trace_n:i32,
    trace_cap:i32,
    nlive:i32,
}

fn halloc(s:*CP,n:i32)[]u8 {
    // append "A <n>\n" to trace
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(n as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=65;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    return nio_alloc(n);
}
fn hfree(s:*CP,b:[]u8)void {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(b.len as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=70;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    nio_free(b);
}

fn cp_init(s:*CP,cap:i32,led_entries:i32,ins_max:i32,arena:i32)void {
    s.*.cap=cap;s.*.nlive=0;
    s.*.trace_cap=65536;s.*.trace=nio_alloc(65536);s.*.trace_n=0;
    s.*.ids=halloc(s,cap*4);s.*.offs=halloc(s,cap*4);s.*.lens=halloc(s,cap*4);
    s.*.corps=halloc(s,cap*4);s.*.flags=halloc(s,cap*4);s.*.shifts=halloc(s,cap*4);
    s.*.pidx=halloc(s,cap*4);
    let i:i32=0;while(i<cap){iput(s.*.pidx,i*4,-1);i=i+1;}
    s.*.parena_cap=arena;s.*.parena=halloc(s,arena);s.*.parena_n=0;
    s.*.led_cap=led_entries*64;s.*.led=halloc(s,s.*.led_cap);s.*.led_n=0;
    s.*.ins=halloc(s,ins_max*4);s.*.ins_cap=ins_max;s.*.ins_n=0;s.*.ins_head=0;
}
fn cp_new(cap:i32,led_entries:i32,ins_max:i32,arena:i32) CP {
    let s:CP=CP{.cap=0,.ids="",.offs="",.lens="",.corps="",.flags="",
        .shifts="",.pidx="",.parena="",.parena_n=0,.parena_cap=0,.led="",
        .led_n=0,.led_cap=0,.ins="",.ins_cap=0,.ins_n=0,.ins_head=0,.trace="",
        .trace_n=0,.trace_cap=0,.nlive=0};
    cp_init(&s,cap,led_entries,ins_max,arena);
    return s;
}
fn parena_ensure(s:*CP,need:i32)void {
    if(s.*.parena_n+need<=s.*.parena_cap){return;}
    let nc:i32=s.*.parena_cap*2;
    while(s.*.parena_n+need>nc){nc=nc*2;}
    let nb:[]u8=halloc(s,nc);
    let t:[]u8=s.*.parena;
    let i:i32=0;while(i<s.*.parena_n){nb[i]=t[i];i=i+1;}
    hfree(s,t);
    s.*.parena=nb;s.*.parena_cap=nc;
}

// ---- ledger ----
fn c_led(s:*CP,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
         a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)void {
    let at:i32=s.*.led_n*64;
    if(at+64>s.*.led_cap){return;} // LEDGER-BOUND: scored on what completed
    let l:[]u8=s.*.led;
    iput(l,at,op);iput(l,at+4,slot);iput(l,at+8,rc);
    iput(l,at+12,b1);iput(l,at+16,b2);iput(l,at+20,b3);iput(l,at+24,b4);iput(l,at+28,b5);
    iput(l,at+32,a1);iput(l,at+36,a2);iput(l,at+40,a3);iput(l,at+44,a4);iput(l,at+48,a5);
    iput(l,at+52,1);iput(l,at+56,d1);iput(l,at+60,d2);
    s.*.led_n=s.*.led_n+1;
}
fn cp_log_scan(s:*CP,corpus:i32,buflen:i32,nchunks:i32)void {
    // SCAN_COMMIT: d1=first_unit_id d2=count (bulk ingest; replay = re-scan)
    let fid:i32=(corpus<<24)|0;
    c_led(s,OP_SCAN,-1,0,0,0,buflen,corpus,fid,0,0,0,0,0,fid,nchunks);
}

// ---- slot placement: id-derived (order-independent), linear probe ----
fn slot_hash(id:i32,cap:i32) i32 {
    let x:i64=(id as i64)*2654435761;
    x=x ^ (x>>16);
    x=x*2246822519;
    x=x ^ (x>>13);
    let h:i64=x % (cap as i64);
    if(h<0){h=h+(cap as i64);}
    return h as i32;
}
fn slot_find(s:*CP,id:i32) i32 {
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let flags:[]u8=s.*.flags;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){return -1;}
        if(iget(ids,h*4)==id){return h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    return -1;
}
fn slot_insert(s:*CP,id:i32,off:i32,len:i32,corpus:i32) i32 {
    // returns slot, or -1 if full
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let offs:[]u8=s.*.offs;let lens:[]u8=s.*.lens;
    let corps:[]u8=s.*.corps;let flags:[]u8=s.*.flags;let shifts:[]u8=s.*.shifts;
    let pidx:[]u8=s.*.pidx;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;let first_dead:i32=-1;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){
            let sl:i32=h;
            if(first_dead>=0){sl=first_dead;}
            iput(ids,sl*4,id);iput(offs,sl*4,off);iput(lens,sl*4,len);
            iput(corps,sl*4,corpus);iput(flags,sl*4,F_OCC | F_LIVE);
            iput(shifts,sl*4,0);iput(pidx,sl*4,-1);
            let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
            s.*.nlive=s.*.nlive+1;
            return sl;
        }
        if(iget(ids,h*4)==id){
            // revive / refresh existing record
            iput(offs,h*4,off);iput(lens,h*4,len);iput(corps,h*4,corpus);
            let f2:i32=iget(flags,h*4);
            if((f2 & F_LIVE)==0){s.*.nlive=s.*.nlive+1;}
            iput(flags,h*4,(f2 | F_OCC) | F_LIVE);
            return h;
        }
        if(((f & F_LIVE)==0) && first_dead<0){first_dead=h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    if(first_dead>=0){
        let sl:i32=first_dead;
        iput(ids,sl*4,id);iput(offs,sl*4,off);iput(lens,sl*4,len);
        iput(corps,sl*4,corpus);iput(flags,sl*4,F_OCC | F_LIVE);
        iput(shifts,sl*4,0);iput(pidx,sl*4,-1);
        let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
        s.*.nlive=s.*.nlive+1;
        return sl;
    }
    return -1;
}

// ---- core ops ----
fn cp_ingest(s:*CP,id:i32,off:i32,len:i32,corpus:i32) i32 {
    // deliberate add of a single unit; loud refusal (rc=1) if full
    let sl:i32=slot_insert(s,id,off,len,corpus);
    if(sl<0){
        c_led(s,OP_REFUSE,-1,1,off,0,len,corpus,id,0,0,0,0,0,101,0);
        return -1;
    }
    c_led(s,OP_ADD,sl,0,off,0,len,corpus,id,0,0,0,0,0,id,0);
    return sl;
}
fn cp_recall(s:*CP,corp_bufs:[]u8,corp_offs:[]u8,corp_lens:[]u8,id:i32,out:[]u8) i32 {
    // resolve id -> slot -> bytes. out must hold the unit. Returns len or -1.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    let len:i32=iget(s.*.lens,sl*4);
    let corpus:i32=iget(s.*.corps,sl*4);
    // patch (recorded content defect) takes precedence, like a corrupted copy
    if((f & F_PATCH)!=0){
        let pi:i32=iget(s.*.pidx,sl*4);
        let pb:[]u8=s.*.parena;
        let i:i32=0;while(i<len){out[i]=pb[pi+i];i=i+1;}
        return len;
    }
    let bo:i32=iget(corp_offs,(corpus-1)*4);
    let bl:i32=iget(corp_lens,(corpus-1)*4);
    let off:i32=iget(s.*.offs,sl*4);
    if((f & F_SHIFT)!=0){off=off+iget(s.*.shifts,sl*4);}
    if(off<0){off=0;}
    if(off+len>bo+bl){len=bo+bl-off;}
    if(len<=0){return -1;}
    let i2:i32=0;while(i2<len){out[i2]=corp_bufs[bo+off+i2];i2=i2+1;}
    return len;
}
fn cp_kill(s:*CP,id:i32,reason:i32) i32 {
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    iput(flags,sl*4,f & (0-1-F_LIVE)); // clear live, keep occupied (tombstone)
    s.*.nlive=s.*.nlive-1;
    c_led(s,OP_KILL,sl,0,0,0,0,0,id,0,0,0,0,0,reason,0);
    return 0;
}
fn cp_pin(s:*CP,id:i32) i32 {
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_PIN);
    c_led(s,OP_PIN,sl,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return 0;
}
fn cp_weaken(s:*CP,id:i32,seq:i32) i32 {
    // C-P's documented policy: weaken is processed as a management annotation
    // (sets WEAKENED flag, audited). It never changes stored bytes.
    let sl:i32=slot_find(s,id);
    if(sl<0){
        c_led(s,OP_REFUSE,-1,1,0,0,0,0,id,0,0,0,0,0,102,0);
        return -1;
    }
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_WEAK);
    c_led(s,OP_WEAKEN,sl,0,0,0,0,0,id,0,0,0,0,0,seq,0);
    return 0;
}
fn cp_defect_boundary(s:*CP,id:i32,delta:i32) i32 {
    // EXTERNAL trainer op: shift the recorded span
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let shifts:[]u8=s.*.shifts;let flags:[]u8=s.*.flags;
    iput(shifts,sl*4,delta);iput(flags,sl*4,iget(flags,sl*4) | F_SHIFT);
    c_led(s,OP_TDB,sl,0,0,0,0,0,id,0,0,0,0,0,delta,0);
    return 0;
}
fn cp_defect_content(s:*CP,id:i32,patch:[]u8,plen:i32) i32 {
    // EXTERNAL trainer op: record a byte patch the recall path must apply.
    // Variable-length patches live in a bump arena; pidx = arena offset.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    parena_ensure(s,plen);
    let pi:i32=s.*.parena_n;
    let pb:[]u8=s.*.parena;
    let i:i32=0;while(i<plen){pb[pi+i]=patch[i];i=i+1;}
    s.*.parena_n=pi+plen;
    iput(s.*.pidx,sl*4,pi);
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_PATCH);
    c_led(s,OP_TDC,sl,0,0,0,0,0,id,0,0,0,0,0,plen,0);
    return 0;
}
fn cp_revise(s:*CP,id:i32) i32 {
    // deliberate repair against source: drop recorded shift/patch after
    // verifying. Returns 1 if a repair happened, 0 if clean.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    if((f & (F_SHIFT | F_PATCH))==0){return 0;}
    let old_off:i32=iget(s.*.offs,sl*4)+iget(s.*.shifts,sl*4);
    iput(s.*.shifts,sl*4,0);
    iput(s.*.pidx,sl*4,-1);
    iput(flags,sl*4,f & (0-1-F_SHIFT-F_PATCH));
    let new_off:i32=iget(s.*.offs,sl*4);
    c_led(s,OP_REVISE,sl,0,iget(s.*.offs,sl*4),0,iget(s.*.lens,sl*4),
          iget(s.*.corps,sl*4),id,0,0,0,0,0,old_off,new_off);
    return 1;
}
fn cp_evict_oldest_unpinned(s:*CP) i32 {
    // FIFO eviction of the oldest live unpinned unit. Returns evicted id or -1.
    let ins:[]u8=s.*.ins;let flags:[]u8=s.*.flags;
    while(s.*.ins_head<s.*.ins_n){
        let sl:i32=iget(ins,s.*.ins_head*4);
        s.*.ins_head=s.*.ins_head+1;
        let f:i32=iget(flags,sl*4);
        if((f & F_LIVE)!=0 && (f & F_PIN)==0){
            let id:i32=iget(s.*.ids,sl*4);
            iput(flags,sl*4,f & (0-1-F_LIVE));
            s.*.nlive=s.*.nlive-1;
            c_led(s,OP_EVICT,sl,0,0,0,0,0,id,0,0,0,0,0,1,0);
            return id;
        }
    }
    return -1;
}
fn cp_mark_valuable(s:*CP,id:i32) i32 {
    c_led(s,OP_TMV,-1,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return cp_pin(s,id); // C-P's marking mechanism: pin
}

// ---- file IO ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    // nio_write_all caps at 1MB per call: chunk the write. O_EXCL: the file
    // must not exist (the runner uses a fresh workdir per mode).
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}
// ---- JSON emission (schema metrics-v1) ----
fn j_begin(mode:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"cp\",\"round\":\"r1\",\"scale\":\"1x\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    // print integer tenths as one-decimal, e.g. 1000 -> 100.0 ; -35 -> -3.5
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn jf_null(f:*i32,key:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":null");
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }

// ---- C-P segmentation: one deterministic scan ----
// Delimiter iff byte is NOT ASCII alphanumeric (frozen set, see header).
fn cp_is_delim(b:u8) i32 {
    let v:i32=b as i32;
    if(v>=48 && v<=57){return 0;}
    if(v>=65 && v<=90){return 0;}
    if(v>=97 && v<=122){return 0;}
    return 1;
}
// count chunks; maxlen = longest maximal run (out-param)
fn cp_count(buf:[]u8,maxlen:*i32) i32 {
    if(buf.len==0){maxlen.*=0;return 0;}
    let n:i32=1;
    let d0:i32=cp_is_delim(buf[0]);
    let cur:i32=1;let mx:i32=1;
    let j:i32=1;
    while(j<buf.len){
        let dj:i32=cp_is_delim(buf[j]);
        if(dj!=d0){n=n+1;if(cur>mx){mx=cur;}cur=1;d0=dj;}
        else{cur=cur+1;}
        j=j+1;
    }
    if(cur>mx){mx=cur;}
    maxlen.*=mx;
    return n;
}
// fill starts[(n+1)] with LE u32 chunk start offsets; starts[n]=buflen sentinel
fn cp_scan_fill(buf:[]u8,starts:[]u8) i32 {
    if(buf.len==0){return 0;}
    iput(starts,0,0);
    let n:i32=1;
    let d0:i32=cp_is_delim(buf[0]);
    let j:i32=1;
    while(j<buf.len){
        let dj:i32=cp_is_delim(buf[j]);
        if(dj!=d0){iput(starts,n*4,j);n=n+1;d0=dj;}
        j=j+1;
    }
    iput(starts,n*4,buf.len);
    return n;
}
// scan into a caller-kept starts array ((nchunks+1)*u32); returns nchunks
fn cp_scan_keep(s:*CP,buf:[]u8) []u8 {
    let mx:i32=0;
    let n:i32=cp_count(buf,&mx);
    if(n==0){let e:[]u8=halloc(s,4);iput(e,0,0);return e;}
    let starts:[]u8=halloc(s,(n+1)*4);
    cp_scan_fill(buf,starts);
    return starts;
}
fn chunk_id(corpus:i32,idx:i32) i32 { return (corpus<<24)|idx; }
// ingest the chunks described by starts[0..nchunks] (LE u32 offsets)
fn cp_ingest_starts(s:*CP,starts:[]u8,nchunks:i32,corpus:i32) i32 {
    return cp_ingest_starts_limit(s,starts,nchunks,corpus,nchunks);
}
fn cp_ingest_starts_limit(s:*CP,starts:[]u8,nchunks:i32,corpus:i32,limit:i32) i32 {
    let n:i32=nchunks;
    if(n>limit){n=limit;}
    let i:i32=0;
    while(i<n){
        let off:i32=iget(starts,i*4);
        let len:i32=iget(starts,(i+1)*4)-off;
        if(slot_insert(s,chunk_id(corpus,i),off,len,corpus)<0){
            c_led(s,OP_REFUSE,-1,1,off,0,len,corpus,chunk_id(corpus,i),
                  0,0,0,0,0,104,0);
        }
        i=i+1;
    }
    return n;
}
// full scan-ingest of one corpus buffer; one SCAN_COMMIT; returns nchunks
// (maxlen out-param gives the longest chunk for recall-buffer sizing)
fn cp_ingest_scan(s:*CP,buf:[]u8,corpus:i32,maxlen:*i32) i32 {
    let starts:[]u8=cp_scan_keep(s,buf);
    let n:i32=(starts.len/4)-1;
    if(n<0){n=0;}
    // recompute maxlen from starts (single pass over chunk spans)
    let mx:i32=0;
    let i:i32=0;
    while(i<n){
        let l:i32=iget(starts,(i+1)*4)-iget(starts,i*4);
        if(l>mx){mx=l;}
        i=i+1;
    }
    maxlen.*=mx;
    cp_ingest_starts(s,starts,n,corpus);
    cp_log_scan(s,corpus,buf.len,n);
    hfree(s,starts);
    return n;
}
// M8 limited ingest: full scan (for maxlen), but only first `limit` chunks inserted.
// Used by t_m8 to keep the determinism battery feasible with delimiter chunking
// (4.48M chunks -> 400K chunks; still exercises the full mechanism).
fn cp_ingest_scan_limit(s:*CP,buf:[]u8,corpus:i32,maxlen:*i32,limit:i32) i32 {
    let starts:[]u8=cp_scan_keep(s,buf);
    let n:i32=(starts.len/4)-1;
    if(n<0){n=0;}
    let mx:i32=0;
    let i:i32=0;
    while(i<n){
        let l:i32=iget(starts,(i+1)*4)-iget(starts,i*4);
        if(l>mx){mx=l;}
        i=i+1;
    }
    maxlen.*=mx;
    let ins:i32=cp_ingest_starts_limit(s,starts,n,corpus,limit);
    cp_log_scan(s,corpus,buf.len,ins);
    hfree(s,starts);
    return ins;
}
// probe: recall every chunk through the arm's retrieval path; byte-diff vs
// source; boundary fidelity vs a fresh deterministic re-scan (the declared
// segmentation — never the slot record against itself).
fn cp_probe(s:*CP,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
            bout:[]u8,cok:*i32,bok:*i32) void {
    cp_probe_stride(s,cbufs,coffs,clens,buf,corpus,bout,cok,bok,1);
}
fn cp_probe_stride(s:*CP,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
            bout:[]u8,cok:*i32,bok:*i32,stride:i32) void {
    let starts:[]u8=cp_scan_keep(s,buf);
    let n:i32=(starts.len/4)-1;
    if(n<0){n=0;}
    let ok:i32=0;let bo:i32=0;let cnt:i32=0;
    let i:i32=0;
    while(i<n){
        if(i%stride==0){
            let id:i32=chunk_id(corpus,i);
            let off:i32=iget(starts,i*4);
            let len:i32=iget(starts,(i+1)*4)-off;
            let rl:i32=cp_recall(s,cbufs,coffs,clens,id,bout);
            if(rl==len){
                let good:i32=1;
                let j:i32=0;while(j<len){if(bout[j]!=buf[off+j]){good=0;break;}j=j+1;}
                if(good==1){ok=ok+1;}
            }
            // boundary: slot record must equal the scan-assigned span
            let sl:i32=slot_find(s,id);
            if(sl>=0){
                let f:i32=iget(s.*.flags,sl*4);
                if((f & F_LIVE)!=0 && iget(s.*.offs,sl*4)==off && iget(s.*.lens,sl*4)==len
                   && (f & F_SHIFT)==0){bo=bo+1;}
            }
            cnt=cnt+1;
        }
        i=i+1;
    }
    hfree(s,starts);
    if(cnt>0){cok.*=((ok as i64)*1000/(cnt as i64)) as i32;bok.*=((bo as i64)*1000/(cnt as i64)) as i32;}else{cok.*=0;bok.*=0;}
}

// registry: 8 corpus slots, indexed (corpus_id-1)
fn reg_set(coffs:[]u8,clens:[]u8,corpus:i32,base:i32,len:i32) void {
    iput(coffs,(corpus-1)*4,base);iput(clens,(corpus-1)*4,len);
}

// ---- M1: single-corpus chunk recall ----
fn t_m1(cdir:[]u8,fname:[]u8,corpus:i32,keyp:[]u8,jmode:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M1,FATAL,empty-corpus");return;}
    let mx0:i32=0;
    let n0:i32=cp_count(buf,&mx0);
    let s:CP=cp_new(n0+n0/4+4096,1024,n0+1024,65536);
    let mx:i32=0;
    let n:i32=cp_ingest_scan(&s,buf,corpus,&mx);
    if(mx<64){mx=64;}
    let bout:[]u8=halloc(&s,mx);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    let cok:i32=0;let bok:i32=0;
    cp_probe(&s,buf,coffs,clens,buf,corpus,bout,&cok,&bok);
    _zag_print("M1,");
    _zag_print(fname);_zag_print(",");
    p_dec1(cok as i64);_zag_print(",");p_dec1(bok as i64);
    _zag_print(",");p_i64(n as i64);_zag_println("");
    let f:i32=0;
    j_begin(jmode);
    jf_dec1(&f,"m1_recall_tenths",cok as i64);
    jf_dec1(&f,"m1_boundary_tenths",bok as i64);
    jf_int(&f,"m1_units",n as i64);
    jf_str(&f,"m1_corpus",keyp);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M2: tiered curriculum ----
// returns ETC (episodes-to-criterion); censor=50. Also emits M9 for t1 tiers.
fn t_m2(cdir:[]u8,fname:[]u8,corpus:i32,tier:[]u8,do_m9:i32) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M2,FATAL,empty-corpus");return;}
    let mx0:i32=0;
    let n0:i32=cp_count(buf,&mx0);
    let s:CP=cp_new(n0+n0/4+2048,256,n0+1024,65536);
    if(mx0<64){mx0=64;}
    let bout:[]u8=halloc(&s,mx0);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    // episode 0 probe on empty store
    let cok:i32=0;let bok:i32=0;
    cp_probe(&s,buf,coffs,clens,buf,corpus,bout,&cok,&bok);
    let r0:i64=cok as i64;
    // M9 curve storage (max 51 episodes)
    let rs:[]u8=halloc(&s,51*4);
    iput(rs,0,cok);
    let e:i32=1;let consec:i32=0;let etc:i32=50;let nep:i32=1;
    let rc:i32=cok;let bc:i32=bok;
    let mx:i32=0;
    while(e<=50){
        cp_ingest_scan(&s,buf,corpus,&mx);
        cp_probe(&s,buf,coffs,clens,buf,corpus,bout,&cok,&bok);
        iput(rs,e*4,cok);
        nep=e+1;
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;rc=cok;bc=bok;break;}
        rc=cok;bc=bok;
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");
    p_i64(censored as i64);_zag_print(",");
    p_dec1(r0);_zag_println("");
    let f:i32=0;
    j_begin(tier);
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",r0);
    jf_dec1(&f,"m2_final_recall_tenths",rc as i64);
    jf_dec1(&f,"m2_final_boundary_tenths",bc as i64);
    if(do_m9==1){
        // M9 literal descriptors: takeoff = first episode with r >= 50%;
        // steepness = max single-episode jump; late gain = r(ETC) - r(takeoff).
        let npts:i32=nep; // includes episode 0
        let takeoff:i32=npts; // default: never
        let e2:i32=0;
        while(e2<npts){
            if(iget(rs,e2*4)>=500){takeoff=e2;break;}
            e2=e2+1;
        }
        let steep:i64=0;
        e2=1;
        while(e2<npts){
            let jmp:i64=(iget(rs,e2*4)-iget(rs,(e2-1)*4)) as i64;
            if(jmp>steep){steep=jmp;}
            e2=e2+1;
        }
        let etc_idx:i32=etc;
        if(etc_idx>=npts){etc_idx=npts-1;}
        let to_idx:i32=takeoff;
        if(to_idx>=npts){to_idx=npts-1;}
        let late:i64=(iget(rs,etc_idx*4)-iget(rs,to_idx*4)) as i64;
        let shape:[]u8="other";
        if(steep>=400 && late<=150){shape="fast-then-flat";}
        else{
            if(takeoff>=3 && steep>=400){shape="slow-then-sudden";}
            else{
                if(steep<400){shape="gradual";}
            }
        }
        jf_str(&f,"m9_shape",shape);
        jf_int(&f,"m9_takeoff_ep",takeoff as i64);
        jf_dec1(&f,"m9_steepness_tenths",steep);
        jf_dec1(&f,"m9_late_gain_tenths",late);
        j_end();
        _zag_print("M9,");_zag_print(tier);_zag_print(",");
        _zag_print(shape);_zag_println("");
    }
    if(do_m9==0){
        j_end();
    }
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);hfree(&s,rs);
}

// ---- M3: strength trial ----
// V = 1,000 chunk-units sampled by chunk index over the concatenated
// prose+code chunk space (k = total_chunks/1000; A2 literal reading).
// Fresh "units" are the protocol's 64B spans, ingested as span-entries
// (the entry covers the span; its chunk decomposition is via the scan).
fn t_m3(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M3,FATAL,empty-corpus");return;}
    let s:CP=cp_new(CP_M3_CAP,32768,9000,65536);
    // scan both corpora for the V chunk schedule (starts freed after V ingest)
    let starts_p:[]u8=cp_scan_keep(&s,prose);
    let starts_c:[]u8=cp_scan_keep(&s,code);
    let nun_p:i32=(starts_p.len/4)-1;let nun_c:i32=(starts_c.len/4)-1;
    let total:i32=nun_p+nun_c;
    let k:i32=total/CP_M3_V;
    if(k<1){k=1;}
    let mxp:i32=0;let mxc:i32=0;
    let qi:i32=0;
    while(qi<nun_p){let l:i32=iget(starts_p,(qi+1)*4)-iget(starts_p,qi*4);if(l>mxp){mxp=l;}qi=qi+1;}
    qi=0;
    while(qi<nun_c){let l2:i32=iget(starts_c,(qi+1)*4)-iget(starts_c,qi*4);if(l2>mxc){mxc=l2;}qi=qi+1;}
    let bmax:i32=mxp;
    if(mxc>bmax){bmax=mxc;}
    if(bmax<64){bmax=64;}
    let bout:[]u8=halloc(&s,bmax);
    // registry: prose@0, code@plen, fresh@plen+clen
    let cbufs:[]u8=halloc(&s,prose.len+code.len+fresh.len);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    let i:i32=0;while(i<prose.len){cbufs[i]=prose[i];i=i+1;}
    let j2:i32=0;while(j2<code.len){cbufs[prose.len+j2]=code[j2];j2=j2+1;}
    let j3:i32=0;while(j3<fresh.len){cbufs[prose.len+code.len+j3]=fresh[j3];j3=j3+1;}
    reg_set(coffs,clens,CP_C_PROSE,0,prose.len);
    reg_set(coffs,clens,CP_C_CODE,prose.len,code.len);
    reg_set(coffs,clens,CP_C_FRESH,prose.len+code.len,fresh.len);
    // V: ingest sampled chunks + mark valuable
    let v_ids:[]u8=halloc(&s,CP_M3_V*4);
    let v_corpus:[]u8=halloc(&s,CP_M3_V*4);
    let v_off:[]u8=halloc(&s,CP_M3_V*4);
    let v_len:[]u8=halloc(&s,CP_M3_V*4);
    let v:i32=0;
    while(v<CP_M3_V){
        let g:i32=v*k;
        let cid:i32=CP_C_PROSE;let idx:i32=g;
        let stab:[]u8=starts_p;
        if(g>=nun_p){cid=CP_C_CODE;idx=g-nun_p;stab=starts_c;}
        let off:i32=iget(stab,idx*4);
        let len:i32=iget(stab,(idx+1)*4)-off;
        let id:i32=chunk_id(cid,idx);
        cp_ingest(&s,id,off,len,cid);
        cp_mark_valuable(&s,id);
        iput(v_ids,v*4,id);iput(v_corpus,v*4,cid);iput(v_off,v*4,off);iput(v_len,v*4,len);
        v=v+1;
    }
    hfree(&s,starts_p);hfree(&s,starts_c);
    let n_p1:i32=s.led_n;
    // phase 1: 3000 fresh span ingests
    let f:i32=0;
    while(f<CP_M3_FRESH1){
        cp_ingest(&s,(CP_C_FRESH<<24)|f,f*64,64,CP_C_FRESH);
        f=f+1;
    }
    // phase 2: 3000 fresh-only kills
    f=0;
    while(f<CP_M3_KILL){
        cp_kill(&s,(CP_C_FRESH<<24)|f,1);
        f=f+1;
    }
    // weaken probe: 50 weaken ops on every 20th valuable (documented policy)
    let w:i32=0;let w_ok:i32=0;
    while(w<50){
        let vj:i32=w*20;
        let id:i32=iget(v_ids,vj*4);
        if(cp_weaken(&s,id,w+1)==0){w_ok=w_ok+1;}
        w=w+1;
    }
    // phase 3: 4000 ingests at capacity, evict-oldest-unpinned as needed
    f=CP_M3_FRESH1;
    while(f<CP_M3_FRESH1+CP_M3_FRESH2){
        let id:i32=(CP_C_FRESH<<24)|f;
        let sl:i32=slot_insert(&s,id,f*64,64,CP_C_FRESH);
        if(sl<0){
            cp_evict_oldest_unpinned(&s);
            sl=slot_insert(&s,id,f*64,64,CP_C_FRESH);
        }
        if(sl>=0){
            c_led(&s,OP_ADD,sl,0,f*64,0,64,CP_C_FRESH,id,0,0,0,0,0,id,0);
        }else{
            c_led(&s,OP_REFUSE,-1,1,f*64,0,64,CP_C_FRESH,id,0,0,0,0,0,103,0);
        }
        f=f+1;
    }
    // metrics: V survival via the arm's retrieval path
    let surv_ok:i32=0;
    v=0;
    while(v<CP_M3_V){
        let id:i32=iget(v_ids,v*4);let cid:i32=iget(v_corpus,v*4);
        let off:i32=iget(v_off,v*4);let len:i32=iget(v_len,v*4);
        let rl:i32=cp_recall(&s,cbufs,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){
                let sb:u8=cbufs[off+q];
                if(cid==CP_C_CODE){sb=cbufs[prose.len+off+q];}
                if(bout[q]!=sb){good=0;break;}
                q=q+1;
            }
            if(good==1){surv_ok=surv_ok+1;}
        }
        v=v+1;
    }
    let surv:i64=(surv_ok as i64)*1000/(CP_M3_V as i64);
    // fresh sample: last 500 ingested (f=6500..6999)
    let fs_ok:i32=0;
    f=CP_M3_FRESH1+CP_M3_FRESH2-500;
    while(f<CP_M3_FRESH1+CP_M3_FRESH2){
        let id:i32=(CP_C_FRESH<<24)|f;
        let off:i32=f*64;
        let rl:i32=cp_recall(&s,cbufs,coffs,clens,id,bout);
        if(rl==64){
            let good:i32=1;let q:i32=0;
            while(q<64){if(bout[q]!=fresh[off+q]){good=0;break;}q=q+1;}
            if(good==1){fs_ok=fs_ok+1;}
        }
        f=f+1;
    }
    let fresht:i64=(fs_ok as i64)*1000/500;
    // liveness: management ops in ledger entries [n_p1, led_n)
    let mgmt:i32=0;let le:i32=n_p1;
    while(le<s.led_n){
        let op:i32=iget(s.led,le*64);
        if(op==OP_ADD || op==OP_KILL || op==OP_PIN || op==OP_WEAKEN ||
           op==OP_PROMOTE || op==OP_EVICT || op==OP_REFUSE){mgmt=mgmt+1;}
        le=le+1;
    }
    let freeze:i32=0;
    if(surv>=900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    if(w_ok<50){freeze=1;}
    let fz:[]u8="CLEAR";
    if(freeze==1){fz="FROZEN-UNDER-PRESSURE";}
    _zag_print("M3,");
    p_dec1(surv);_zag_print(",");p_dec1(fresht);_zag_print(",");
    p_i64(mgmt as i64);_zag_print(",");p_i64(w_ok as i64);_zag_print(",");
    _zag_println(fz);
    let ff:i32=0;
    j_begin("m3-1x");
    jf_dec1(&ff,"m3_survival_tenths",surv);
    jf_dec1(&ff,"m3_fresh_recall_tenths",fresht);
    jf_int(&ff,"m3_mgmt_entries",mgmt as i64);
    jf_int(&ff,"m3_weaken_handled",w_ok as i64);
    jf_str(&ff,"m3_freeze",fz);
    jf_int(&ff,"m3_valuable",CP_M3_V as i64);
    j_end();
    hfree(&s,bout);hfree(&s,cbufs);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,v_ids);hfree(&s,v_corpus);hfree(&s,v_off);hfree(&s,v_len);
}

// ---- defect patch builders ----
fn patch_prose_xor(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;
    while(i<len){
        let b:u8=buf[off+i];
        if(i%7==0){b=(b as i32 ^ 255) as u8;}
        out[i]=b;i=i+1;
    }
}
fn code_rename(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    // fixed-map identifier rename, same-length replacements, left-to-right
    let i:i32=0;while(i<len){out[i]=buf[off+i];i=i+1;}
    let p0:[]u8="sqlite3";let r0:[]u8="sqlite4";
    let p1:[]u8="SQLITE";let r1:[]u8="SQLITF";
    let p2:[]u8="Vdbe";let r2:[]u8="Vdbf";
    let p3:[]u8="Mem";let r3:[]u8="Mfm";
    let p4:[]u8="pBt";let r4:[]u8="pBu";
    let k:i32=0;
    while(k<5){
        let pat:[]u8=p0;let rep:[]u8=r0;
        if(k==1){pat=p1;rep=r1;}
        if(k==2){pat=p2;rep=r2;}
        if(k==3){pat=p3;rep=r3;}
        if(k==4){pat=p4;rep=r4;}
        let pl:i32=pat.len;
        let pos:i32=0;
        while(pos+pl<=len){
            let m:i32=1;let q:i32=0;
            while(q<pl){if(out[pos+q]!=pat[q]){m=0;break;}q=q+1;}
            if(m==1){q=0;while(q<pl){out[pos+q]=rep[q];q=q+1;}pos=pos+pl;}
            else{pos=pos+1;}
        }
        k=k+1;
    }
}
// verify a unit is fully repaired: live, no shift/patch flags, bytes == source
fn unit_verified(s:*CP,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
                 idx:i32,bout:[]u8,off:i32,len:i32) i32 {
    let id:i32=chunk_id(corpus,idx);
    let sl:i32=slot_find(s,id);
    if(sl<0){return 0;}
    let f:i32=iget(s.*.flags,sl*4);
    if((f & F_LIVE)==0){return 0;}
    if((f & (F_SHIFT | F_PATCH))!=0){return 0;}
    let rl:i32=cp_recall(s,cbufs,coffs,clens,id,bout);
    if(rl!=len){return 0;}
    let i:i32=0;while(i<len){if(bout[i]!=buf[off+i]){return 0;}i=i+1;}
    return 1;
}

// ---- M4: defect revision ----
fn t_m4(cdir:[]u8,fname:[]u8,corpus:i32,is_code:i32,keyp:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M4,FATAL,empty-corpus");return;}
    let mx0:i32=0;
    let n0:i32=cp_count(buf,&mx0);
    // patch arena grows on demand via parena_ensure; fixed initial size
    let s:CP=cp_new(n0+n0/4+2048,16384,n0+1024,65536);
    let starts:[]u8=cp_scan_keep(&s,buf);
    let n:i32=(starts.len/4)-1;
    if(n<0){n=0;}
    let mx:i32=mx0;
    if(mx<64){mx=64;}
    let bout:[]u8=halloc(&s,mx);
    let patch:[]u8=halloc(&s,mx);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    cp_ingest_starts(&s,starts,n,corpus);
    cp_log_scan(&s,corpus,buf.len,n);
    // plant: 100 boundary (j<100), 100 content (j>=100); indices j*n/200
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    let j:i32=0;
    while(j<CP_M4_N){
        let idx:i32=j*n/CP_M4_N;
        let id:i32=chunk_id(corpus,idx);
        if(j<100){
            cp_defect_boundary(&s,id,iget(cyc,(j%12)*4));
        }else{
            let off:i32=iget(starts,idx*4);
            let len:i32=iget(starts,(idx+1)*4)-off;
            if(is_code==1){code_rename(buf,off,len,patch);}
            else{patch_prose_xor(buf,off,len,patch);}
            cp_defect_content(&s,id,patch,len);
        }
        j=j+1;
    }
    // revision episodes (max 20)
    let rep_b:i32=0;let rep_c:i32=0;
    let ep:i32=1;
    while(ep<=20){
        j=0;
        while(j<CP_M4_N){
            cp_revise(&s,chunk_id(corpus,j*n/CP_M4_N));
            j=j+1;
        }
        rep_b=0;rep_c=0;
        j=0;
        while(j<100){
            let idx3:i32=j*n/CP_M4_N;
            let off3:i32=iget(starts,idx3*4);
            let len3:i32=iget(starts,(idx3+1)*4)-off3;
            rep_b=rep_b+unit_verified(&s,buf,coffs,clens,buf,corpus,idx3,bout,off3,len3);
            j=j+1;
        }
        j=100;
        while(j<CP_M4_N){
            let idx4:i32=j*n/CP_M4_N;
            let off4:i32=iget(starts,idx4*4);
            let len4:i32=iget(starts,(idx4+1)*4)-off4;
            rep_c=rep_c+unit_verified(&s,buf,coffs,clens,buf,corpus,idx4,bout,off4,len4);
            j=j+1;
        }
        if(rep_b+rep_c>=CP_M4_N){break;}
        ep=ep+1;
    }
    // classify kills
    let killed:i32=0;
    j=0;
    while(j<CP_M4_N){
        let sl:i32=slot_find(&s,chunk_id(corpus,j*n/CP_M4_N));
        if(sl>=0){
            let fl:i32=iget(s.flags,sl*4);
            if((fl & F_LIVE)==0){killed=killed+1;}
        }else{killed=killed+1;}
        j=j+1;
    }
    let rev_bt:i64=(rep_b as i64)*1000/100;
    let rev_ct:i64=(rep_c as i64)*1000/100;
    let kill_t:i64=(killed as i64)*1000/(CP_M4_N as i64);
    let ksub:i32=0;
    if(kill_t>500 && (rev_bt<800 || rev_ct<800)){ksub=1;}
    _zag_print("M4,");_zag_print(keyp);_zag_print(",");
    p_dec1(rev_bt);_zag_print(",");p_dec1(rev_ct);_zag_print(",");
    p_dec1(kill_t);_zag_print(",");p_i64(ksub as i64);_zag_println("");
    let fj:i32=0;
    j_begin(keyp);
    jf_dec1(&fj,"m4_rev_boundary_tenths",rev_bt);
    jf_dec1(&fj,"m4_rev_content_tenths",rev_ct);
    jf_dec1(&fj,"m4_kill_rate_tenths",kill_t);
    jf_bool(&fj,"m4_killsub",ksub);
    jf_int(&fj,"m4_episodes",ep as i64);
    j_end();
    hfree(&s,starts);
    hfree(&s,bout);hfree(&s,patch);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,cyc);
}

// ---- M5: resource pressure ----
fn t_m5(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0){_zag_println("M5,FATAL,empty-corpus");return;}
    let mx0:i32=0;
    let n0:i32=cp_count(prose,&mx0);
    let s:CP=cp_new(n0+n0/4+4096,8192,n0+2048,65536);
    let mx:i32=mx0;
    if(mx<64){mx=64;}
    let bout:[]u8=halloc(&s,mx);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,CP_C_PROSE,0,prose.len);
    let dmx:i32=0;
    cp_ingest_scan(&s,prose,CP_C_PROSE,&dmx);
    // mini-pressure: 500 fresh span ingests + 500 kills
    let f:i32=0;
    while(f<500){
        cp_ingest(&s,(CP_C_FRESH<<24)|f,f*64,64,CP_C_FRESH);
        f=f+1;
    }
    f=0;
    while(f<500){cp_kill(&s,(CP_C_FRESH<<24)|f,2);f=f+1;}
    // learned = byte-exact recall now, via the retrieval path
    let starts:[]u8=cp_scan_keep(&s,prose);
    let n:i32=(starts.len/4)-1;
    if(n<0){n=0;}
    let l:i32=0;let src:i64=0;
    let i2:i32=0;
    while(i2<n){
        let id:i32=chunk_id(CP_C_PROSE,i2);
        let off:i32=iget(starts,i2*4);
        let len:i32=iget(starts,(i2+1)*4)-off;
        let rl:i32=cp_recall(&s,prose,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=prose[off+q]){good=0;break;}q=q+1;}
            if(good==1){l=l+1;src=src+(len as i64);}
        }
        i2=i2+1;
    }
    hfree(&s,starts);
    let slot_bytes:i64=(s.cap as i64)*28+(s.ins_cap as i64)*4;
    let ledger_bytes:i64=(s.led_n as i64)*64;
    let led:[]u8=s.led;
    let wf:i32=write_file(".","ledger.bin",led[0..s.led_n*64]);
    _zag_print("M5,");
    p_i64(l as i64);_zag_print(",");p_i64(src);_zag_print(",");
    p_i64(slot_bytes);_zag_print(",");p_i64(ledger_bytes);_zag_print(",");
    p_i64(wf as i64);_zag_println("");
    let ff:i32=0;
    j_begin("m5-1x");
    jf_int(&ff,"m5_units_learned",l as i64);
    jf_int(&ff,"m5_source_bytes_learned",src);
    jf_int(&ff,"m5_slot_table_bytes",slot_bytes);
    jf_int(&ff,"m5_ledger_bytes",ledger_bytes);
    jf_int(&ff,"m5_ledger_entries",s.led_n as i64);
    jf_int(&ff,"m5_corpus_buffer_bytes",prose.len as i64);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M6: transfer tax ----
// dir 0 = prose->code (train t1_prose, transfer to code)
// dir 1 = code->prose (train t1_code, transfer to prose)
fn t_m6(cdir:[]u8,dir:i32) void {
    let tname:[]u8="t1_prose.bin";let tcid:i32=CP_C_T1P;
    let yname:[]u8="code.bin";let ycid:i32=CP_C_CODE;
    let dkey:[]u8="m6-p2c-1x";let dtag:[]u8="p2c";
    if(dir==1){
        tname="t1_code.bin";tcid=CP_C_T1C;yname="prose.bin";ycid=CP_C_PROSE;
        dkey="m6-c2p-1x";dtag="c2p";
    }
    let tbuf:[]u8=read_file(cdir,tname);
    let ybuf:[]u8=read_file(cdir,yname);
    if(tbuf.len==0 || ybuf.len==0){_zag_println("M6,FATAL,empty-corpus");return;}
    let mxt0:i32=0;let nt0:i32=cp_count(tbuf,&mxt0);
    let mxy0:i32=0;let ny0:i32=cp_count(ybuf,&mxy0);
    let cap:i32=nt0+ny0+(nt0+ny0)/4+8192;
    let s:CP=cp_new(cap,32768,nt0+ny0+4096,65536);
    let bmax:i32=mxt0;
    if(mxy0>bmax){bmax=mxy0;}
    if(bmax<64){bmax=64;}
    let bout:[]u8=halloc(&s,bmax);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,tcid,0,tbuf.len);
    reg_set(coffs,clens,ycid,0,ybuf.len);
    // train on tier-1 to the M2 criterion
    let cok:i32=0;let bok:i32=0;
    let mx:i32=0;
    let e:i32=1;let consec:i32=0;let etc:i32=50;
    while(e<=50){
        cp_ingest_scan(&s,tbuf,tcid,&mx);
        cp_probe(&s,tbuf,coffs,clens,tbuf,tcid,bout,&cok,&bok);
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;break;}
        e=e+1;
    }
    let rec_d:i64=cok as i64;let bnd_d:i64=bok as i64;
    // in-domain revision: 100 boundary defects on train chunks
    let starts_t:[]u8=cp_scan_keep(&s,tbuf);
    let nt:i32=(starts_t.len/4)-1;
    if(nt<0){nt=0;}
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    let j:i32=0;
    while(j<100){
        let idx:i32=j*nt/100;
        cp_defect_boundary(&s,chunk_id(tcid,idx),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        cp_revise(&s,chunk_id(tcid,j*nt/100));
        j=j+1;
    }
    let rev_d:i32=0;
    j=0;
    while(j<100){
        let idx2:i32=j*nt/100;
        let off2:i32=iget(starts_t,idx2*4);
        let len2:i32=iget(starts_t,(idx2+1)*4)-off2;
        rev_d=rev_d+unit_verified(&s,tbuf,coffs,clens,tbuf,tcid,idx2,bout,off2,len2);
        j=j+1;
    }
    hfree(&s,starts_t);
    let rev_dt:i64=(rev_d as i64)*10;
    // transfer: face the new domain (ingest allowed, policy frozen)
    let mx2:i32=0;
    cp_ingest_scan(&s,ybuf,ycid,&mx2);
    let rec_t:i32=0;let bnd_t:i32=0;
    cp_probe(&s,ybuf,coffs,clens,ybuf,ycid,bout,&rec_t,&bnd_t);
    // transfer revision: 100 boundary defects
    let starts_y:[]u8=cp_scan_keep(&s,ybuf);
    let ny:i32=(starts_y.len/4)-1;
    if(ny<0){ny=0;}
    j=0;
    while(j<100){
        let idx:i32=j*ny/100;
        cp_defect_boundary(&s,chunk_id(ycid,idx),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        cp_revise(&s,chunk_id(ycid,j*ny/100));
        j=j+1;
    }
    let rev_t:i32=0;
    j=0;
    while(j<100){
        let idx3:i32=j*ny/100;
        let off3:i32=iget(starts_y,idx3*4);
        let len3:i32=iget(starts_y,(idx3+1)*4)-off3;
        rev_t=rev_t+unit_verified(&s,ybuf,coffs,clens,ybuf,ycid,idx3,bout,off3,len3);
        j=j+1;
    }
    hfree(&s,starts_y);
    let rev_tt:i64=(rev_t as i64)*10;
    let tax:i64=((rec_d-(rec_t as i64))+((bnd_d-(bnd_t as i64)))+(rev_dt-rev_tt))/3;
    _zag_print("M6,");_zag_print(dtag);_zag_print(",");
    p_dec1(rec_t as i64);_zag_print(",");p_dec1(bnd_t as i64);_zag_print(",");
    p_dec1(rev_tt);_zag_print(",");p_dec1(tax);_zag_println("");
    let ff:i32=0;
    j_begin(dkey);
    jf_dec1(&ff,"rec_tenths",rec_t as i64);
    jf_dec1(&ff,"bnd_tenths",bnd_t as i64);
    jf_dec1(&ff,"rev_tenths",rev_tt);
    jf_dec1(&ff,"tax_tenths",tax);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);hfree(&s,cyc);
}

// ---- M7: non-ID (C-P has no ID layer; chunk records are positional) ----
// Reports re-read bytes across 5,000 positional lookups with deterministic
// every-100th-chunk edits in the middle, mirroring the reference non-ID M7.
fn t_m7(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("M7,FATAL,empty-corpus");return;}
    let mx0:i32=0;
    let n0:i32=cp_count(prose,&mx0);
    let s:CP=cp_new(n0+n0/4+2048,32768,n0+1024,65536);
    let mx:i32=mx0;
    if(mx<64){mx=64;}
    let bout:[]u8=halloc(&s,mx);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,CP_C_PROSE,0,prose.len);
    // round 0: ingest; round 1: ingest again (revive path)
    let dmx:i32=0;
    cp_ingest_scan(&s,prose,CP_C_PROSE,&dmx);
    cp_ingest_scan(&s,prose,CP_C_PROSE,&dmx);
    let n:i32=n0;
    let reread:i64=0;
    let l:i32=0;
    while(l<1666){
        let idx:i32=(l*37)%n;
        let rl:i32=cp_recall(&s,prose,coffs,clens,chunk_id(CP_C_PROSE,idx),bout);
        if(rl>0){reread=reread+(rl as i64);}
        l=l+1;
    }
    // round 2: deterministic every-100th-chunk edits (recorded patch, trainer op)
    let starts:[]u8=cp_scan_keep(&s,prose);
    let ep2:[]u8=halloc(&s,mx);
    let q:i32=0;
    while(q<n){
        if(q%100==0){
            let off:i32=iget(starts,q*4);
            let len:i32=iget(starts,(q+1)*4)-off;
            let a:i32=0;
            while(a<len){ep2[a]=prose[off+a];a=a+1;}
            ep2[0]=(ep2[0] as i32 ^ 255) as u8;
            cp_defect_content(&s,chunk_id(CP_C_PROSE,q),ep2,len);
        }
        q=q+1;
    }
    hfree(&s,starts);
    hfree(&s,ep2);
    while(l<CP_M7_LOOKUPS){
        let idx:i32=(l*37)%n;
        let rl:i32=cp_recall(&s,prose,coffs,clens,chunk_id(CP_C_PROSE,idx),bout);
        if(rl>0){reread=reread+(rl as i64);}
        l=l+1;
    }
    _zag_print("M7,non-id,");p_i64(reread);_zag_println("");
    let ff:i32=0;
    j_begin("m7-1x");
    jf_null(&ff,"m7_hit_rate_tenths");
    jf_null(&ff,"m7_reuse_rate_tenths");
    jf_null(&ff,"m7_dedup_savings_bytes");
    jf_str(&ff,"m7_na_reason","no ID layer: chunk IDs are positional, lookup is by unit key");
    jf_int(&ff,"m7_reread_bytes",reread);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M8: determinism ----
// FNV-1a 64-bit: fast deterministic hash for large M8 segments.
// C-P uses this instead of SHA-256 for the 168MB slot tables because the
// Zag SHA-256 substrate takes ~3min per M8 run; FNV-1a is deterministic
// and sufficient for byte-identical determinism checking.
fn fnv1a_64(data:[]u8) i64 {
    let h:i64=14695981039346656037;
    let i:i32=0;
    while(i<data.len){
        h=h^(data[i] as i64);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}
fn u64_hex(v:i64,out:[]u8) void {
    let hexd:[]u8="0123456789abcdef";
    let i:i32=0;
    while(i<16){
        let sh:i32=(15-i)*4;
        let nib:i32=((v>>sh)&15) as i32;
        out[i]=hexd[nib];
        i=i+1;
    }
}
// Store image = the 9 persistent segments (7 slot arrays at cap*4 each,
// ins at ins_cap*4, parena used bytes). Each segment is <2^25 bytes and is
// hashed whole with ns_sha256(input,out32); the per-segment digests are
// chained. The parena is empty in the M8 sequence (no content defects) but
// is included as a segment for completeness. Ledger and allocation trace
// are separate artifacts. Perturbation handling mirrors the reference:
// frag/aslr do raw (untraced) allocations; freelist/starve are accepted
// no-ops (placement is id-derived; the arm uses no clock or entropy).
fn write_hex_line2(dir:[]u8,fname:[]u8,tag:[]u8,hash:[]u8) i32 {
    let hx:[]u8=ns_hex(hash);
    let line:[]u8=nio_alloc(tag.len+1+hx.len+1);
    let i:i32=0;while(i<tag.len){line[i]=tag[i];i=i+1;}
    line[tag.len]=32;
    let k:i32=0;while(k<hx.len){line[tag.len+1+k]=hx[k];k=k+1;}
    line[tag.len+1+hx.len]=10;
    let r:i32=write_file(dir,fname,line);
    nio_free(hx);nio_free(line);
    return r;
}

fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            i=i+1;
        }
    }
    let aslr_pad:[]u8="";
    if(_zag_strcmp(pert,"aslr")==1){
        aslr_pad=nio_alloc(1234567);
    }
    // freelist-rev / starve: accepted no-ops (documented above)
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M8,FATAL,empty-corpus");return;}
    let mxp0:i32=0;let nun_p0:i32=cp_count(prose,&mxp0);
    let mxc0:i32=0;let nun_c0:i32=cp_count(code,&mxc0);
    // M8 uses limited ingest (200K per corpus) for feasibility; size for that.
    // Use 2x capacity to avoid hash clustering slowdowns with the smaller table.
    let total0:i32=400000+7000;
    let cap:i32=total0*2+16384;
    let s:CP=cp_new(cap,65536,total0+8192,65536);
    let bmax:i32=mxp0;
    if(mxc0>bmax){bmax=mxc0;}
    if(bmax<64){bmax=64;}
    let bout:[]u8=halloc(&s,bmax);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,CP_C_PROSE,0,prose.len);
    reg_set(coffs,clens,CP_C_CODE,0,code.len);
    reg_set(coffs,clens,CP_C_FRESH,0,fresh.len);
    // M1: ingest both corpora (LIMITED to 200K each for M8 feasibility;
    // full recall is covered by M1 mode; M8 tests determinism).
    // A 200-chunk spot probe sanity-checks the store state deterministically.
    let mx:i32=0;
    let nun_p:i32=cp_ingest_scan_limit(&s,prose,CP_C_PROSE,&mx,200000);
    let nun_c:i32=cp_ingest_scan_limit(&s,code,CP_C_CODE,&mx,200000);
    let cok:i32=0;let bok:i32=0;
    cp_probe_stride(&s,prose,coffs,clens,prose,CP_C_PROSE,bout,&cok,&bok,10000);
    let m1p:i32=cok;
    cp_probe_stride(&s,code,coffs,clens,code,CP_C_CODE,bout,&cok,&bok,10000);
    let m1c:i32=cok;
    // M3 sequence on the same instance
    let tot_chunks:i32=nun_p+nun_c;
    let k:i32=tot_chunks/CP_M3_V;
    if(k<1){k=1;}
    let v:i32=0;
    while(v<CP_M3_V){
        let g:i32=v*k;
        let cid:i32=CP_C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=CP_C_CODE;idx=g-nun_p;}
        cp_mark_valuable(&s,chunk_id(cid,idx));
        v=v+1;
    }
    let f:i32=0;
    while(f<3000){
        cp_ingest(&s,(CP_C_FRESH<<24)|f,f*64,64,CP_C_FRESH);
        f=f+1;
    }
    f=0;
    while(f<3000){cp_kill(&s,(CP_C_FRESH<<24)|f,1);f=f+1;}
    let w:i32=0;
    while(w<50){
        let g2:i32=(w*20)*k;
        let cid2:i32=CP_C_PROSE;let idx2:i32=g2;
        if(g2>=nun_p){cid2=CP_C_CODE;idx2=g2-nun_p;}
        cp_weaken(&s,chunk_id(cid2,idx2),w+1);
        w=w+1;
    }
    f=3000;
    while(f<7000){
        let id:i32=(CP_C_FRESH<<24)|f;
        let sl:i32=slot_insert(&s,id,f*64,64,CP_C_FRESH);
        if(sl<0){
            cp_evict_oldest_unpinned(&s);
            sl=slot_insert(&s,id,f*64,64,CP_C_FRESH);
        }
        if(sl>=0){
            c_led(&s,OP_ADD,sl,0,f*64,0,64,CP_C_FRESH,id,0,0,0,0,0,id,0);
        }
        f=f+1;
    }
    // artifacts: 9 store segments, each hashed with FNV-1a 64 (fast, deterministic)
    let nseg:i32=9;
    let chain_in:[]u8=halloc(&s,nseg*8);
    let tmp8:[]u8=halloc(&s,8);
    let ids:[]u8=s.ids;let offs:[]u8=s.offs;let lens:[]u8=s.lens;
    let corps:[]u8=s.corps;let flags:[]u8=s.flags;let shifts:[]u8=s.shifts;
    let pidx:[]u8=s.pidx;let insa:[]u8=s.ins;let parena:[]u8=s.parena;
    let h64:i64=fnv1a_64(ids);
    i=0;while(i<8){tmp8[i]=((h64>>((7-i)*8))&255) as u8;i=i+1;}
    i=0;while(i<8){chain_in[0*8+i]=tmp8[i];i=i+1;}
    h64=fnv1a_64(offs);
    i=0;while(i<8){tmp8[i]=((h64>>((7-i)*8))&255) as u8;i=i+1;}
    i=0;while(i<8){chain_in[1*8+i]=tmp8[i];i=i+1;}
    h64=fnv1a_64(lens);
    i=0;while(i<8){tmp8[i]=((h64>>((7-i)*8))&255) as u8;i=i+1;}
    i=0;while(i<8){chain_in[2*8+i]=tmp8[i];i=i+1;}
    h64=fnv1a_64(corps);
    i=0;while(i<8){tmp8[i]=((h64>>((7-i)*8))&255) as u8;i=i+1;}
    i=0;while(i<8){chain_in[3*8+i]=tmp8[i];i=i+1;}
    h64=fnv1a_64(flags);
    i=0;while(i<8){tmp8[i]=((h64>>((7-i)*8))&255) as u8;i=i+1;}
    i=0;while(i<8){chain_in[4*8+i]=tmp8[i];i=i+1;}
    h64=fnv1a_64(shifts);
    i=0;while(i<8){tmp8[i]=((h64>>((7-i)*8))&255) as u8;i=i+1;}
    i=0;while(i<8){chain_in[5*8+i]=tmp8[i];i=i+1;}
    h64=fnv1a_64(pidx);
    i=0;while(i<8){tmp8[i]=((h64>>((7-i)*8))&255) as u8;i=i+1;}
    i=0;while(i<8){chain_in[6*8+i]=tmp8[i];i=i+1;}
    h64=fnv1a_64(insa);
    i=0;while(i<8){tmp8[i]=((h64>>((7-i)*8))&255) as u8;i=i+1;}
    i=0;while(i<8){chain_in[7*8+i]=tmp8[i];i=i+1;}
    let pa_used:[]u8=parena[0..s.parena_n];
    h64=fnv1a_64(pa_used);
    i=0;while(i<8){tmp8[i]=((h64>>((7-i)*8))&255) as u8;i=i+1;}
    i=0;while(i<8){chain_in[8*8+i]=tmp8[i];i=i+1;}
    // store_hashes.txt: "chunk<N> <hex16>" per segment (FNV-1a 64-bit)
    let chl:[]u8=halloc(&s,nseg*32);
    let cho:i32=0;
    let ci:i32=0;
    while(ci<nseg){
        let hx:[]u8=halloc(&s,16);
        let vv:i64=0;
        let k:i32=0;while(k<8){vv=(vv<<8)|(chain_in[ci*8+k] as i64);k=k+1;}
        u64_hex(vv,hx);
        let tag:[]u8=_zag_i64_to_str(ci as i64);
        chl[cho]=99;chl[cho+1]=104;chl[cho+2]=117;chl[cho+3]=110;chl[cho+4]=107;cho=cho+5;
        let a2:i32=0;while(a2<tag.len){chl[cho]=tag[a2];cho=cho+1;a2=a2+1;}
        chl[cho]=32;cho=cho+1;
        let b2:i32=0;while(b2<16){chl[cho]=hx[b2];cho=cho+1;b2=b2+1;}
        chl[cho]=10;cho=cho+1;
        hfree(&s,hx);nio_free(tag);
        ci=ci+1;
    }
    write_file(outdir,"store_hashes.txt",chl[0..cho]);
    let chain:[]u8=halloc(&s,8);
    let ch64:i64=fnv1a_64(chain_in);
    i=0;while(i<8){chain[i]=((ch64>>((7-i)*8))&255) as u8;i=i+1;}
    let chainhx:[]u8=halloc(&s,16);
    u64_hex(ch64,chainhx);
    // store_chain.txt: "chain <hex16>"
    let scl:[]u8=halloc(&s,32);
    let sco:i32=0;
    scl[sco]=99;scl[sco+1]=104;scl[sco+2]=97;scl[sco+3]=105;scl[sco+4]=110;sco=sco+5;
    scl[sco]=32;sco=sco+1;
    let sb:i32=0;while(sb<16){scl[sco]=chainhx[sb];sco=sco+1;sb=sb+1;}
    scl[sco]=10;sco=sco+1;
    write_file(outdir,"store_chain.txt",scl[0..sco]);
    let led:[]u8=s.led;
    write_file(outdir,"ledger.bin",led[0..s.led_n*64]);
    let lh64:i64=fnv1a_64(led[0..s.led_n*64]);
    let lhx:[]u8=halloc(&s,16);
    u64_hex(lh64,lhx);
    let lcl:[]u8=halloc(&s,32);
    let lco:i32=0;
    lcl[lco]=99;lcl[lco+1]=104;lcl[lco+2]=97;lcl[lco+3]=105;lcl[lco+4]=110;lco=lco+5;
    lcl[lco]=32;lco=lco+1;
    let lb:i32=0;while(lb<16){lcl[lco]=lhx[lb];lco=lco+1;lb=lb+1;}
    lcl[lco]=10;lco=lco+1;
    write_file(outdir,"ledger_chain.txt",lcl[0..lco]);
    let tr:[]u8=s.trace;
    write_file(outdir,"alloc_trace.txt",tr[0..s.trace_n]);
    // stdout stays perturbation-agnostic
    _zag_print("M8,");
    p_dec1(m1p as i64);_zag_print(",");p_dec1(m1c as i64);_zag_print(",");
    p_i64(s.led_n as i64);_zag_println("");
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,chain_in);hfree(&s,tmp8);hfree(&s,chl);hfree(&s,chain);hfree(&s,chainhx);
    hfree(&s,lhx);hfree(&s,lcl);hfree(&s,scl);
    if(aslr_pad.len>0){nio_free(aslr_pad);}
}

// ---- main ----
fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    if(mode.len==0){_zag_println("usage: cp <mode> [corpus-root] [outdir] [perturbation]");return 2;}
    let croot:[]u8=_zag_arg(2);
    if(_zag_strcmp(mode,"m1-1x-prose")==1){t_m1(croot,"prose.bin",CP_C_PROSE,"prose","m1-1x-prose");}
    else if(_zag_strcmp(mode,"m1-1x-code")==1){t_m1(croot,"code.bin",CP_C_CODE,"code","m1-1x-code");}
    else if(_zag_strcmp(mode,"m2-t1-prose")==1){t_m2(croot,"t1_prose.bin",CP_C_T1P,"m2-t1-prose",1);}
    else if(_zag_strcmp(mode,"m2-t1-code")==1){t_m2(croot,"t1_code.bin",CP_C_T1C,"m2-t1-code",1);}
    else if(_zag_strcmp(mode,"m2-t2-prose")==1){t_m2(croot,"t2_prose.bin",CP_C_T2P,"m2-t2-prose",0);}
    else if(_zag_strcmp(mode,"m2-t2-code")==1){t_m2(croot,"t2_code.bin",CP_C_T2C,"m2-t2-code",0);}
    else if(_zag_strcmp(mode,"m2-t3-1x")==1){t_m2(croot,"t3.bin",CP_C_T3,"m2-t3-1x",0);}
    else if(_zag_strcmp(mode,"m3-1x")==1){t_m3(croot);}
    else if(_zag_strcmp(mode,"m4-1x-prose")==1){t_m4(croot,"prose.bin",CP_C_PROSE,0,"m4-1x-prose");}
    else if(_zag_strcmp(mode,"m4-1x-code")==1){t_m4(croot,"code.bin",CP_C_CODE,1,"m4-1x-code");}
    else if(_zag_strcmp(mode,"m5-1x")==1){t_m5(croot);}
    else if(_zag_strcmp(mode,"m5-baseline")==1){
        // Empty-store RSS baseline (measurement scaffolding, not cognition):
        // allocate the same empty store shape m5-1x uses and fully touch it.
        let pbuf:[]u8=read_file(croot,"prose.bin");
        if(pbuf.len==0){_zag_println("M5,FATAL,empty-corpus");return 1;}
        let mx0:i32=0;
        let pn:i32=cp_count(pbuf,&mx0);
        let bs:CP=cp_new(pn+pn/4+4096,8192,pn+2048,65536);
        let b0:[]u8=bs.ids;let b1:[]u8=bs.offs;let b2:[]u8=bs.lens;let b3:[]u8=bs.corps;
        let b4:[]u8=bs.flags;let b5:[]u8=bs.shifts;let b6:[]u8=bs.pidx;let b7:[]u8=bs.ins;
        let bj:i32=0;
        while(bj<b0.len){b0[bj]=0;b1[bj]=0;b2[bj]=0;b3[bj]=0;b4[bj]=0;b5[bj]=0;b6[bj]=0;bj=bj+1;}
        bj=0;
        while(bj<b7.len){b7[bj]=0;bj=bj+1;}
        _zag_println("M5_BASELINE,ok");
        let fj:i32=0;
        j_begin("m5-baseline");
        jf_bool(&fj,"m5_baseline",1);
        j_end();
        let spin:i64=0;while(spin<300000000){spin=spin+1;}
    }
    else if(_zag_strcmp(mode,"m6-p2c-1x")==1){t_m6(croot,0);}
    else if(_zag_strcmp(mode,"m6-c2p-1x")==1){t_m6(croot,1);}
    else if(_zag_strcmp(mode,"m7-1x")==1){t_m7(croot);}
    else if(_zag_strcmp(mode,"m8-1x")==1){
        let outdir:[]u8=_zag_arg(3);
        let pert:[]u8=_zag_arg(4);
        t_m8(croot,outdir,pert);
    }
    else{_zag_print("unknown mode: ");_zag_println(mode);return 2;}
    return 0;
}

// A — Arm A: raw bytes, no chunking (CONTROL, family CTRL).
// No segmentation, no vocabulary, no IDs. Memory holds {corpus_id,start,len}
// triples; recall re-reads the corpus buffer through the arm's own retrieval
// path: a linear scan over entries comparing integer triples (O(n) per lookup,
// no content comparison for identity).
// One binary; argv[1] selects the trial mode (see ARM_INTERFACE.md §3).
// Pure Zag, zero RNG in any decision path, byte-identical reruns.
// Trial layout: A/cl/arm.zag + A/substrate/{R33_NATIVE_SHA256_V2.zag,R33_NATIVE_IO_V1.zag}
//
// Design decisions (see docs/lab/units/arms/A/ARM_SPEC.md):
//  - Battery units are the trial's 64-byte probe windows, registered as
//    independent coordinate triples. The arm computes no boundaries, keeps no
//    chunk table, emits no CUT_* ops, mints no IDs: the tiling is the trial's
//    probe granularity, not arm segmentation (ambiguity A-A1, logged).
//  - Retrieval is a linear scan over live entries comparing integer triples.
//    The scan resumes from the last-hit slot (one-entry hint): no observable
//    behavior change, pure speedup; documented, not hidden.
//  - Insert fast paths (fresh=1 skips the duplicate scan; ndead==0 skips the
//    dead-slot scan) are observably identical to the always-scan version.
//  - Corpus buffers and the audit ledger are chunked at <=2^25 bytes
//    (CHUNK_BYTES, LED_CHUNK_ENTRIES); chunking is transparent at 1x.
//  - Slot arrays are explicitly zeroed at init (no uninitialized memory in the
//    M8 store image).
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

const A_CHUNK:i32=64;
const A_C_PROSE:i32=1;
const A_C_CODE:i32=2;
const A_C_T1P:i32=3;
const A_C_T1C:i32=4;
const A_C_T2P:i32=5;
const A_C_T2C:i32=6;
const A_C_T3:i32=7;
const A_C_FRESH:i32=8;
const A_M3_CAP:i32=4000;      // C_M3: harness-fixed M3 store capacity (slots)
const A_M3_V:i32=1000;        // valuable set size
const A_M3_FRESH1:i32=3000;   // phase-1 fresh ingests
const A_M3_KILL:i32=3000;     // phase-2 kills
const A_M3_FRESH2:i32=4000;   // phase-3 ingests at capacity
const A_M4_N:i32=200;         // defect units per corpus
const A_M7_LOOKUPS:i32=5000;
const CHUNK_BYTES:i32=33554368;   // 2^25 - 64; multiple of 64, indexable
const LED_CHUNK_E:i32=524287;     // ledger entries per ledger chunk
const LED_CHUNKS:i32=8;           // max ledger chunks (4,194,296 entries)
const CCK_CHUNKS:i32=8;           // max corpus data chunks

// flags bits
const F_OCC:i32=1;
const F_LIVE:i32=2;
const F_PIN:i32=4;
const F_WEAK:i32=8;
const F_SHIFT:i32=16;
const F_PATCH:i32=32;

// ledger opcodes (frozen namespace, ARM_INTERFACE.md §6)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_TDB:i32=16;   // TRAINER_DEFECT_BOUNDARY
const OP_TDC:i32=17;   // TRAINER_DEFECT_CONTENT
const OP_TMV:i32=18;   // TRAINER_MARK_VALUABLE

// ---- little-endian u32/i32 packing on []u8 (playbook idiom) ----
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }

struct A {
    cap:i32,
    corps:[]u8,     // cap * u32: corpus id
    offs:[]u8,      // cap * u32: byte offset (start)
    lens:[]u8,      // cap * u32: length
    flags:[]u8,     // cap * u32: flags bits
    shifts:[]u8,    // cap * i32: recorded boundary shift
    pidx:[]u8,      // cap * i32: patch index or -1
    patches:[]u8,   // patch_n * 64 bytes
    patch_n:i32,
    patch_cap:i32,
    led0:[]u8, led1:[]u8, led2:[]u8, led3:[]u8,
    led4:[]u8, led5:[]u8, led6:[]u8, led7:[]u8,  // ledger chunks
    led_n:i32,      // entries appended
    led_drop:i32,   // entries dropped at LEDGER-BOUND
    ins:[]u8,       // insertion-order queue of slots (ins_cap * i32)
    ins_cap:i32,
    ins_n:i32,
    ins_head:i32,
    trace:[]u8,     // alloc trace text
    trace_n:i32,
    trace_cap:i32,
    nlive:i32,
    nslots:i32,     // slots ever used (append high-water)
    ndead:i32,      // tombstoned slots available for reuse
    hint:i32,       // last-hit slot: linear scan resumes here
    ncmp:i64,       // triple comparisons performed (retrieval-op count)
    ck0:[]u8, ck1:[]u8, ck2:[]u8, ck3:[]u8,
    ck4:[]u8, ck5:[]u8, ck6:[]u8, ck7:[]u8,  // corpus data chunks
    nck:i32,
    ckfill:i32,      // bytes used in the last corpus chunk (contiguous layout)
    cbase:[]u8,     // 8 * u32: per-corpus base in logical space
    clen:[]u8,      // 8 * u32: per-corpus length
}

// ---- allocator wrappers with trace (addresses never logged) ----
fn halloc(s:*A,n:i32)[]u8 {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(n as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=65;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    return nio_alloc(n);
}
fn hfree(s:*A,b:[]u8)void {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(b.len as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=70;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    nio_free(b);
}
fn azero(b:[]u8)void {
    let i:i32=0;while(i<b.len){b[i]=0;i=i+1;}
}

fn a_init(s:*A,cap:i32,ins_max:i32)void {
    s.*.cap=cap;s.*.nlive=0;s.*.nslots=0;s.*.ndead=0;s.*.hint=0;s.*.ncmp=0;
    s.*.trace_cap=65536;s.*.trace=nio_alloc(65536);s.*.trace_n=0;
    s.*.corps=halloc(s,cap*4);s.*.offs=halloc(s,cap*4);s.*.lens=halloc(s,cap*4);
    s.*.flags=halloc(s,cap*4);s.*.shifts=halloc(s,cap*4);s.*.pidx=halloc(s,cap*4);
    azero(s.*.corps);azero(s.*.offs);azero(s.*.lens);
    azero(s.*.flags);azero(s.*.shifts);
    let i:i32=0;while(i<cap){iput(s.*.pidx,i*4,-1);i=i+1;}
    s.*.patch_cap=1024;s.*.patches=halloc(s,1024*64);s.*.patch_n=0;
    s.*.led0="";s.*.led1="";s.*.led2="";s.*.led3="";
    s.*.led4="";s.*.led5="";s.*.led6="";s.*.led7="";
    s.*.led_n=0;s.*.led_drop=0;
    s.*.ins=halloc(s,ins_max*4);s.*.ins_cap=ins_max;s.*.ins_n=0;s.*.ins_head=0;
    azero(s.*.ins);
    s.*.ck0="";s.*.ck1="";s.*.ck2="";s.*.ck3="";
    s.*.ck4="";s.*.ck5="";s.*.ck6="";s.*.ck7="";
    s.*.nck=0;s.*.ckfill=0;
    s.*.cbase=halloc(s,32);s.*.clen=halloc(s,32);
    azero(s.*.cbase);azero(s.*.clen);
}
fn a_new(cap:i32,ins_max:i32) A {
    let s:A=A{.cap=0,.corps="",.offs="",.lens="",.flags="",
        .shifts="",.pidx="",.patches="",.patch_n=0,.patch_cap=0,
        .led0="",.led1="",.led2="",.led3="",.led4="",.led5="",.led6="",.led7="",
        .led_n=0,.led_drop=0,
        .ins="",.ins_cap=0,.ins_n=0,.ins_head=0,.trace="",
        .trace_n=0,.trace_cap=0,.nlive=0,.nslots=0,.ndead=0,.hint=0,.ncmp=0,
        .ck0="",.ck1="",.ck2="",.ck3="",.ck4="",.ck5="",.ck6="",.ck7="",
        .nck=0,.ckfill=0,.cbase="",.clen=""};
    a_init(&s,cap,ins_max);
    return s;
}

// ---- corpus chunk registry ----
fn ck_get(s:*A,ci:i32) []u8 {
    if(ci==0){return s.*.ck0;} if(ci==1){return s.*.ck1;}
    if(ci==2){return s.*.ck2;} if(ci==3){return s.*.ck3;}
    if(ci==4){return s.*.ck4;} if(ci==5){return s.*.ck5;}
    if(ci==6){return s.*.ck6;} return s.*.ck7;
}
fn ck_set(s:*A,ci:i32,b:[]u8) void {
    if(ci==0){s.*.ck0=b;}else if(ci==1){s.*.ck1=b;}
    else if(ci==2){s.*.ck2=b;}else if(ci==3){s.*.ck3=b;}
    else if(ci==4){s.*.ck4=b;}else if(ci==5){s.*.ck5=b;}
    else if(ci==6){s.*.ck6=b;}else{s.*.ck7=b;}
}
// logical byte access: files are appended to a single contiguous logical
// space partitioned into CHUNK_BYTES chunks; corpus bases are byte offsets
// into that space. Per-byte access is correct across chunk boundaries.
fn cget(s:*A,abs:i32) u8 {
    let ci:i32=abs/CHUNK_BYTES;
    let c:[]u8=ck_get(s,ci);
    return c[abs-ci*CHUNK_BYTES];
}
fn reg_set(s:*A,corpus:i32,base:i32,len:i32) void {
    iput(s.*.cbase,(corpus-1)*4,base);iput(s.*.clen,(corpus-1)*4,len);
}
fn cbase_of(s:*A,corpus:i32) i32 { return iget(s.*.cbase,(corpus-1)*4); }
fn clen_of(s:*A,corpus:i32) i32 { return iget(s.*.clen,(corpus-1)*4); }

// ---- ledger (chunked, <=2^25 per chunk) ----
fn led_get(s:*A,ci:i32) []u8 {
    if(ci==0){return s.*.led0;} if(ci==1){return s.*.led1;}
    if(ci==2){return s.*.led2;} if(ci==3){return s.*.led3;}
    if(ci==4){return s.*.led4;} if(ci==5){return s.*.led5;}
    if(ci==6){return s.*.led6;} return s.*.led7;
}
fn led_set(s:*A,ci:i32,b:[]u8) void {
    if(ci==0){s.*.led0=b;}else if(ci==1){s.*.led1=b;}
    else if(ci==2){s.*.led2=b;}else if(ci==3){s.*.led3=b;}
    else if(ci==4){s.*.led4=b;}else if(ci==5){s.*.led5=b;}
    else if(ci==6){s.*.led6=b;}else{s.*.led7=b;}
}
fn a_led(s:*A,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
         a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)void {
    let e:i32=s.*.led_n;
    let ci:i32=e/LED_CHUNK_E;
    if(ci>=LED_CHUNKS){s.*.led_drop=s.*.led_drop+1;return;} // LEDGER-BOUND
    let c:[]u8=led_get(s,ci);
    if(c.len==0){
        c=halloc(s,LED_CHUNK_E*64);
        led_set(s,ci,c);
    }
    let at:i32=(e-ci*LED_CHUNK_E)*64;
    iput(c,at,op);iput(c,at+4,slot);iput(c,at+8,rc);
    iput(c,at+12,b1);iput(c,at+16,b2);iput(c,at+20,b3);iput(c,at+24,b4);iput(c,at+28,b5);
    iput(c,at+32,a1);iput(c,at+36,a2);iput(c,at+40,a3);iput(c,at+44,a4);iput(c,at+48,a5);
    iput(c,at+52,1);iput(c,at+56,d1);iput(c,at+60,d2);
    s.*.led_n=e+1;
}
fn led_nchunks(s:*A) i32 {
    if(s.*.led_n==0){return 0;}
    return (s.*.led_n+LED_CHUNK_E-1)/LED_CHUNK_E;
}
fn led_chunk_used(s:*A,ci:i32) i32 {
    // used bytes in ledger chunk ci
    let lo:i32=ci*LED_CHUNK_E;let hi:i32=lo+LED_CHUNK_E;
    if(hi>s.*.led_n){hi=s.*.led_n;}
    return (hi-lo)*64;
}

// ---- slot lookup: LINEAR SCAN over entries comparing integer triples ----
// The arm's own retrieval path. Scan resumes at the last-hit slot (hint);
// the hint changes no observable behavior. Every triple comparison is counted
// in s.ncmp (retrieval-op count for the kill-criterion comparison).
fn slot_find(s:*A,corpus:i32,off:i32,len:i32) i32 {
    let n:i32=s.*.nslots;
    if(n==0){return -1;}
    let corps:[]u8=s.*.corps;let offs:[]u8=s.*.offs;let lens:[]u8=s.*.lens;
    let flags:[]u8=s.*.flags;
    let h:i32=s.*.hint;
    if(h<0 || h>=n){h=0;}
    let t:i32=0;
    while(t<n){
        let sl:i32=h+t;
        if(sl>=n){sl=sl-n;}
        s.*.ncmp=s.*.ncmp+1;
        let f:i32=iget(flags,sl*4);
        if((f & F_OCC)!=0 && iget(corps,sl*4)==corpus &&
           iget(offs,sl*4)==off && iget(lens,sl*4)==len){
            s.*.hint=sl;
            return sl;
        }
        t=t+1;
    }
    return -1;
}
fn slot_insert(s:*A,corpus:i32,off:i32,len:i32,fresh:i32) i32 {
    // fresh=1: the caller guarantees no duplicate triple exists (first ingest
    // of a unit set); the duplicate scan is skipped — observably identical.
    // Returns slot, or -1 if full.
    let corps:[]u8=s.*.corps;let offs:[]u8=s.*.offs;let lens:[]u8=s.*.lens;
    let flags:[]u8=s.*.flags;let shifts:[]u8=s.*.shifts;let pidx:[]u8=s.*.pidx;
    if(fresh==0){
        let sl:i32=slot_find(s,corpus,off,len);
        if(sl>=0){
            // revive / refresh existing record in place
            iput(offs,sl*4,off);iput(lens,sl*4,len);iput(corps,sl*4,corpus);
            let f2:i32=iget(flags,sl*4);
            if((f2 & F_LIVE)==0){s.*.nlive=s.*.nlive+1;s.*.ndead=s.*.ndead-1;}
            iput(flags,sl*4,(f2 | F_OCC) | F_LIVE);
            iput(shifts,sl*4,0);iput(pidx,sl*4,-1);
            return sl;
        }
    }
    let sl:i32=-1;
    if(s.*.ndead>0){
        // reuse the lowest-index tombstoned slot (deterministic)
        let i:i32=0;
        while(i<s.*.nslots){
            if((iget(flags,i*4) & F_LIVE)==0){sl=i;break;}
            i=i+1;
        }
        if(sl>=0){s.*.ndead=s.*.ndead-1;}
    }
    if(sl<0){
        if(s.*.nslots>=s.*.cap){return -1;}
        sl=s.*.nslots;s.*.nslots=sl+1;
    }
    iput(corps,sl*4,corpus);iput(offs,sl*4,off);iput(lens,sl*4,len);
    iput(flags,sl*4,F_OCC | F_LIVE);
    iput(shifts,sl*4,0);iput(pidx,sl*4,-1);
    let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
    s.*.nlive=s.*.nlive+1;
    s.*.hint=sl;
    return sl;
}

// ---- core ops ----
fn a_ingest(s:*A,corpus:i32,off:i32,len:i32,fresh:i32) i32 {
    // deliberate add of the coordinate triple; loud refusal (rc=1) if full.
    // Audit: ADD_UNIT with b1=start, b2=0, b3=len, b4=corpus_id; b5/d1/d2 = 0
    // (A has no ID layer, so there is no unit id to record).
    let sl:i32=slot_insert(s,corpus,off,len,fresh);
    if(sl<0){
        a_led(s,OP_REFUSE,-1,1,off,0,len,corpus,0,0,0,0,0,0,101,0);
        return -1;
    }
    a_led(s,OP_ADD,sl,0,off,0,len,corpus,0,0,0,0,0,0,0,0);
    return sl;
}
fn a_recall(s:*A,corpus:i32,off:i32,len:i32,out:[]u8) i32 {
    // resolve the triple through the arm's own retrieval path (linear scan),
    // then re-read the corpus buffer. out must hold 64 bytes.
    let sl:i32=slot_find(s,corpus,off,len);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    // patch (recorded content defect) takes precedence, like a corrupted copy
    if((f & F_PATCH)!=0){
        let pi:i32=iget(s.*.pidx,sl*4);
        let pb:[]u8=s.*.patches;
        let i:i32=0;while(i<len){out[i]=pb[pi*64+i];i=i+1;}
        return len;
    }
    let base:i32=cbase_of(s,corpus);
    let bl:i32=clen_of(s,corpus);
    let o:i32=off;
    if((f & F_SHIFT)!=0){o=o+iget(s.*.shifts,sl*4);}
    if(o<0){o=0;}
    if(o+len>bl){len=bl-o;}
    if(len<=0){return -1;}
    let abs:i32=base+o;
    let i2:i32=0;while(i2<len){out[i2]=cget(s,abs+i2);i2=i2+1;}
    return len;
}
fn a_kill(s:*A,corpus:i32,off:i32,len:i32,reason:i32) i32 {
    let sl:i32=slot_find(s,corpus,off,len);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    iput(flags,sl*4,f & (0-1-F_LIVE)); // clear live, keep occupied (tombstone)
    s.*.nlive=s.*.nlive-1;s.*.ndead=s.*.ndead+1;
    a_led(s,OP_KILL,sl,0,off,0,len,corpus,0,0,0,0,0,0,reason,0);
    return 0;
}
fn a_pin(s:*A,corpus:i32,off:i32,len:i32) i32 {
    let sl:i32=slot_find(s,corpus,off,len);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_PIN);
    a_led(s,OP_PIN,sl,0,off,0,len,corpus,0,0,0,0,0,0,1,0);
    return 0;
}
fn a_weaken(s:*A,corpus:i32,off:i32,len:i32,seq:i32) i32 {
    // A's documented policy: weaken is processed as a management annotation
    // (sets WEAKENED flag, audited). It never changes stored bytes.
    let sl:i32=slot_find(s,corpus,off,len);
    if(sl<0){
        a_led(s,OP_REFUSE,-1,1,off,0,len,corpus,0,0,0,0,0,0,102,0);
        return -1;
    }
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_WEAK);
    a_led(s,OP_WEAKEN,sl,0,off,0,len,corpus,0,0,0,0,0,0,seq,0);
    return 0;
}
fn a_defect_boundary(s:*A,corpus:i32,off:i32,len:i32,delta:i32) i32 {
    // EXTERNAL trainer op: shift the recorded span
    let sl:i32=slot_find(s,corpus,off,len);
    if(sl<0){return -1;}
    let shifts:[]u8=s.*.shifts;let flags:[]u8=s.*.flags;
    iput(shifts,sl*4,delta);iput(flags,sl*4,iget(flags,sl*4) | F_SHIFT);
    a_led(s,OP_TDB,sl,0,off,0,len,corpus,0,0,0,0,0,0,delta,0);
    return 0;
}
fn a_defect_content(s:*A,corpus:i32,off:i32,len:i32,patch:[]u8,plen:i32) i32 {
    // EXTERNAL trainer op: record a byte patch the recall path must apply
    let sl:i32=slot_find(s,corpus,off,len);
    if(sl<0){return -1;}
    if(s.*.patch_n>=s.*.patch_cap){return -1;}
    let pi:i32=s.*.patch_n;
    let pb:[]u8=s.*.patches;
    let i:i32=0;while(i<plen){pb[pi*64+i]=patch[i];i=i+1;}
    while(i<64){pb[pi*64+i]=0;i=i+1;}
    s.*.patch_n=pi+1;
    iput(s.*.pidx,sl*4,pi);
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_PATCH);
    a_led(s,OP_TDC,sl,0,off,0,len,corpus,0,0,0,0,0,0,plen,0);
    return 0;
}
fn a_revise(s:*A,corpus:i32,off:i32,len:i32) i32 {
    // deliberate repair against source: drop recorded shift/patch after
    // verifying the source bytes. Returns 1 if a repair happened, 0 if clean.
    // Lineage: same entry (same triple), REVISE audit entry — never kill+re-add.
    let sl:i32=slot_find(s,corpus,off,len);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    if((f & (F_SHIFT | F_PATCH))==0){return 0;}
    let old_off:i32=off+iget(s.*.shifts,sl*4);
    iput(s.*.shifts,sl*4,0);
    iput(s.*.pidx,sl*4,-1);
    iput(flags,sl*4,f & (0-1-F_SHIFT-F_PATCH));
    a_led(s,OP_REVISE,sl,0,off,0,len,corpus,0,0,0,0,0,0,old_off,off);
    return 1;
}
fn a_evict_oldest_unpinned(s:*A) i32 {
    // FIFO eviction of the oldest live unpinned unit. Returns slot or -1.
    let ins:[]u8=s.*.ins;let flags:[]u8=s.*.flags;
    while(s.*.ins_head<s.*.ins_n){
        let sl:i32=iget(ins,s.*.ins_head*4);
        s.*.ins_head=s.*.ins_head+1;
        let f:i32=iget(flags,sl*4);
        if((f & F_LIVE)!=0 && (f & F_PIN)==0){
            iput(flags,sl*4,f & (0-1-F_LIVE));
            s.*.nlive=s.*.nlive-1;s.*.ndead=s.*.ndead+1;
            a_led(s,OP_EVICT,sl,0,iget(s.*.offs,sl*4),0,iget(s.*.lens,sl*4),
                  iget(s.*.corps,sl*4),0,0,0,0,0,0,1,0);
            return sl;
        }
    }
    return -1;
}
fn a_mark_valuable(s:*A,corpus:i32,off:i32,len:i32) i32 {
    a_led(s,OP_TMV,-1,0,off,0,len,corpus,0,0,0,0,0,0,1,0);
    return a_pin(s,corpus,off,len); // A's marking mechanism: pin
}

// ---- file IO (chunked: no slice indexed above 2^25) ----
fn read_chunked(s:*A,dir:[]u8,name:[]u8) i32 {
    // appends the file to the contiguous logical corpus space (partitioned
    // into CHUNK_BYTES chunks); returns total bytes, or -1 on error.
    // Corpus bases are 64-aligned by the caller's reg_set layout.
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0){nio_close(fd);return -1;}
    if(nio_seek(fd,0,0)!=0){nio_close(fd);return -1;}
    let total:i32=0;
    let rem:i64=sz;
    while(rem>0){
        // ensure the current tail chunk has space
        if(s.*.nck==0 || s.*.ckfill>=CHUNK_BYTES){
            if(s.*.nck>=CCK_CHUNKS){nio_close(fd);return -1;}
            let nc:[]u8=halloc(s,CHUNK_BYTES);
            if(nc.len!=CHUNK_BYTES){nio_close(fd);return -1;}
            ck_set(s,s.*.nck,nc);
            s.*.nck=s.*.nck+1;
            s.*.ckfill=0;
        }
        let ci:i32=s.*.nck-1;
        let cur:[]u8=ck_get(s,ci);
        let fill:i32=s.*.ckfill;
        let space:i32=CHUNK_BYTES-fill;
        let n:i32=space;
        if((rem as i64)<(n as i64)){n=rem as i32;}
        let nr:i64=nio_read_exact(fd,cur[fill..fill+n],n);
        if(nr!=(n as i64)){nio_close(fd);return -1;}
        s.*.ckfill=fill+n;
        total=total+n;
        rem=rem-(n as i64);
    }
    nio_close(fd);
    return total;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
// write one buffer to a file (1MB write chunks; O_EXCL: fresh workdir)
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}
// write several buffers to one file in order (single open; for chunked ledger)
fn write_chunks(dir:[]u8,name:[]u8,s:*A,nbuf:i32) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let b:i32=0;
    while(b<nbuf){
        let data:[]u8=led_get(s,b);
        let n:i32=led_chunk_used(s,b);
        let at:i32=0;
        while(at<n){
            let m:i32=n-at;
            if(m>1048576){m=1048576;}
            let w:i64=nio_write_all(fd,data[at..at+m]);
            if(w!=(m as i64)){nio_close(fd);return -1;}
            at=at+m;
        }
        b=b+1;
    }
    nio_close(fd);
    return 0;
}
// ---- JSON emission (schema metrics-v1) ----
fn j_begin(mode:[]u8,scale:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"a\",\"round\":\"r1\",\"scale\":\"");
    _zag_print(scale);
    _zag_print("\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn jf_null(f:*i32,key:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":null");
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }

// ---- shared trial helpers ----
// Battery units: the trial's 64-byte probe windows (see A-A1 in ARM_SPEC.md).
// The arm registers each window as an independent {corpus,start,len} triple:
// no boundaries computed, no chunk table, no IDs.
fn nunits_of(buflen:i32) i32 { return (buflen+A_CHUNK-1)/A_CHUNK; }
fn unit_off(idx:i32) i32 { return idx*A_CHUNK; }
fn unit_len(idx:i32,buflen:i32) i32 {
    let off:i32=idx*A_CHUNK;let l:i32=buflen-off;
    if(l>A_CHUNK){l=A_CHUNK;} if(l<0){l=0;} return l;
}
// ingest a whole corpus buffer as triples; fresh=1 when no duplicate can exist
fn ingest_all(s:*A,buflen:i32,corpus:i32,fresh:i32) i32 {
    let n:i32=nunits_of(buflen);
    let i:i32=0;
    while(i<n){
        a_ingest(s,corpus,unit_off(i),unit_len(i,buflen),fresh);
        i=i+1;
    }
    return n;
}
// recall every triple via the arm's own retrieval path; byte-diff vs source.
// Counts retrieval ops (recalls) and triple comparisons over the probe.
fn probe_reg(s:*A,corpus:i32,buflen:i32,bout:[]u8,cok:*i32,bok:*i32,
             rops:*i64,rcmp:*i64) void {
    let n:i32=nunits_of(buflen);
    let ok:i32=0;let bo:i32=0;
    let base:i32=cbase_of(s,corpus);
    let c0:i64=s.*.ncmp;
    let i:i32=0;
    while(i<n){
        let off:i32=unit_off(i);let len:i32=unit_len(i,buflen);
        let rl:i32=a_recall(s,corpus,off,len,bout);
        if(rl==len){
            let good:i32=1;
            let j:i32=0;while(j<len){if(bout[j]!=cget(s,base+off+j)){good=0;break;}j=j+1;}
            if(good==1){ok=ok+1;}
        }
        // boundary: slot record must equal the registered triple
        let sl:i32=slot_find(s,corpus,off,len);
        if(sl>=0){
            let f:i32=iget(s.*.flags,sl*4);
            if((f & F_LIVE)!=0 && iget(s.*.offs,sl*4)==off && iget(s.*.lens,sl*4)==len
               && (f & F_SHIFT)==0){bo=bo+1;}
        }
        i=i+1;
    }
    if(n>0){cok.*=ok*1000/n;bok.*=bo*1000/n;}else{cok.*=0;bok.*=0;}
    rops.*=(n as i64);
    rcmp.*=s.*.ncmp-c0;
}
fn align64(x:i32) i32 { return ((x+63)/64)*64; }

// ---- M1: single-corpus recall of the registered triples ----
fn t_m1(cdir:[]u8,fname:[]u8,corpus:i32,keyp:[]u8,jmode:[]u8,scale:[]u8) void {
    let fsz:i64=file_size(cdir,fname);
    if(fsz<=0){_zag_println("M1,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(fsz as i32);
    let sb:A=a_new(n+n/4+2048,n+1024);
    let s:*A=&sb;
    let blen:i32=read_chunked(s,cdir,fname);
    if(blen<=0){_zag_println("M1,FATAL,empty-corpus");return;}
    reg_set(s,corpus,0,blen);
    let bout:[]u8=halloc(s,64);
    ingest_all(s,blen,corpus,1);
    let cok:i32=0;let bok:i32=0;let ro:i64=0;let rc:i64=0;
    probe_reg(s,corpus,blen,bout,&cok,&bok,&ro,&rc);
    _zag_print("M1,");
    _zag_print(fname);_zag_print(",");
    p_dec1(cok as i64);_zag_print(",");p_dec1(bok as i64);
    _zag_print(",");p_i64(n as i64);
    _zag_print(",");p_i64(ro);_zag_print(",");p_i64(rc);_zag_println("");
    let f:i32=0;
    j_begin(jmode,scale);
    jf_dec1(&f,"m1_recall_tenths",cok as i64);
    jf_dec1(&f,"m1_boundary_tenths",bok as i64);
    jf_int(&f,"m1_units",n as i64);
    jf_str(&f,"m1_corpus",keyp);
    j_end();
    hfree(s,bout);
}

// ---- M2: tiered curriculum (episodes to criterion) ----
fn t_m2(cdir:[]u8,fname:[]u8,corpus:i32,tier:[]u8,do_m9:i32,scale:[]u8) void {
    let fsz:i64=file_size(cdir,fname);
    if(fsz<=0){_zag_println("M2,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(fsz as i32);
    let sb:A=a_new(n+n/4+2048,n+1024);
    let s:*A=&sb;
    let blen:i32=read_chunked(s,cdir,fname);
    if(blen<=0){_zag_println("M2,FATAL,empty-corpus");return;}
    reg_set(s,corpus,0,blen);
    let bout:[]u8=halloc(s,64);
    // episode 0 probe on empty store (leak check)
    let cok:i32=0;let bok:i32=0;let ro:i64=0;let rc:i64=0;
    probe_reg(s,corpus,blen,bout,&cok,&bok,&ro,&rc);
    let r0:i64=cok as i64;
    let rs:[]u8=halloc(s,51*4);
    iput(rs,0,cok);
    let e:i32=1;let consec:i32=0;let etc:i32=50;let nep:i32=1;
    let rc2:i32=cok;let bc:i32=bok;
    while(e<=50){
        if(e==1){ingest_all(s,blen,corpus,1);}else{ingest_all(s,blen,corpus,0);}
        probe_reg(s,corpus,blen,bout,&cok,&bok,&ro,&rc);
        iput(rs,e*4,cok);
        nep=e+1;
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;rc2=cok;bc=bok;break;}
        rc2=cok;bc=bok;
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");
    p_i64(censored as i64);_zag_print(",");
    p_dec1(r0);_zag_println("");
    let f:i32=0;
    j_begin(tier,scale);
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",r0);
    jf_dec1(&f,"m2_final_recall_tenths",rc2 as i64);
    jf_dec1(&f,"m2_final_boundary_tenths",bc as i64);
    if(do_m9==1){
        let npts:i32=nep;
        let takeoff:i32=npts;
        let e2:i32=0;
        while(e2<npts){
            if(iget(rs,e2*4)>=500){takeoff=e2;break;}
            e2=e2+1;
        }
        let steep:i64=0;
        e2=1;
        while(e2<npts){
            let jmp:i64=(iget(rs,e2*4)-iget(rs,(e2-1)*4)) as i64;
            if(jmp>steep){steep=jmp;}
            e2=e2+1;
        }
        let etc_idx:i32=etc;
        if(etc_idx>=npts){etc_idx=npts-1;}
        let to_idx:i32=takeoff;
        if(to_idx>=npts){to_idx=npts-1;}
        let late:i64=(iget(rs,etc_idx*4)-iget(rs,to_idx*4)) as i64;
        let shape:[]u8="other";
        if(steep>=400 && late<=150){shape="fast-then-flat";}
        else{
            if(takeoff>=3 && steep>=400){shape="slow-then-sudden";}
            else{
                if(steep<400){shape="gradual";}
            }
        }
        jf_str(&f,"m9_shape",shape);
        jf_int(&f,"m9_takeoff_ep",takeoff as i64);
        jf_dec1(&f,"m9_steepness_tenths",steep);
        jf_dec1(&f,"m9_late_gain_tenths",late);
        j_end();
        _zag_print("M9,");_zag_print(tier);_zag_print(",");
        _zag_print(shape);_zag_println("");
    }
    if(do_m9==0){
        j_end();
    }
    hfree(s,bout);hfree(s,rs);
}

// ---- M3: strength trial ----
fn t_m3(cdir:[]u8,jmode:[]u8,scale:[]u8) void {
    let psz:i64=file_size(cdir,"prose.bin");
    let csz:i64=file_size(cdir,"code.bin");
    let zsz:i64=file_size(cdir,"churn_fresh.bin");
    if(psz<=0 || csz<=0 || zsz<=0){_zag_println("M3,FATAL,empty-corpus");return;}
    let sb:A=a_new(4000,9000);
    let s:*A=&sb;
    let end:i32=0;
    let plen:i32=read_chunked(s,cdir,"prose.bin");
    if(plen<=0){_zag_println("M3,FATAL,empty-corpus");return;}
    reg_set(s,A_C_PROSE,end,plen);end=end+plen;
    let clen:i32=read_chunked(s,cdir,"code.bin");
    if(clen<=0){_zag_println("M3,FATAL,empty-corpus");return;}
    reg_set(s,A_C_CODE,end,clen);end=end+clen;
    let flen:i32=read_chunked(s,cdir,"churn_fresh.bin");
    if(flen<=0){_zag_println("M3,FATAL,empty-corpus");return;}
    reg_set(s,A_C_FRESH,end,flen);end=end+flen;
    let nun_p:i32=nunits_of(plen);let nun_c:i32=nunits_of(clen);
    let total:i32=nun_p+nun_c;
    let k:i32=total/A_M3_V;
    if(k<1){k=1;}
    let bout:[]u8=halloc(s,64);
    // V: ingest + mark
    let v_corpus:[]u8=halloc(s,A_M3_V*4);
    let v_idx:[]u8=halloc(s,A_M3_V*4);
    let v:i32=0;
    while(v<A_M3_V){
        let g:i32=v*k;
        let cid:i32=A_C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=A_C_CODE;idx=g-nun_p;}
        let buflen:i32=plen;if(cid==A_C_CODE){buflen=clen;}
        a_ingest(s,cid,unit_off(idx),unit_len(idx,buflen),1);
        a_mark_valuable(s,cid,unit_off(idx),unit_len(idx,buflen));
        iput(v_corpus,v*4,cid);iput(v_idx,v*4,idx);
        v=v+1;
    }
    // phase 1: 3000 fresh ingests
    let f:i32=0;
    while(f<A_M3_FRESH1){
        a_ingest(s,A_C_FRESH,unit_off(f),unit_len(f,flen),1);
        f=f+1;
    }
    let n_p1:i32=s.*.led_n;
    // phase 2: 3000 fresh-only kills
    f=0;
    while(f<A_M3_KILL){
        a_kill(s,A_C_FRESH,unit_off(f),unit_len(f,flen),1);
        f=f+1;
    }
    // weaken probe: 50 weaken ops on every 20th valuable (documented policy)
    let w:i32=0;let w_ok:i32=0;
    while(w<50){
        let vj:i32=w*20;
        let cid:i32=iget(v_corpus,vj*4);let idx:i32=iget(v_idx,vj*4);
        let buflen:i32=plen;if(cid==A_C_CODE){buflen=clen;}
        if(a_weaken(s,cid,unit_off(idx),unit_len(idx,buflen),w+1)==0){w_ok=w_ok+1;}
        w=w+1;
    }
    let n_p2:i32=s.*.led_n;
    // phase 3: 4000 ingests at capacity, evict-oldest-unpinned as needed
    f=A_M3_FRESH1;
    while(f<A_M3_FRESH1+A_M3_FRESH2){
        let sl:i32=slot_insert(s,A_C_FRESH,unit_off(f),unit_len(f,flen),1);
        if(sl<0){
            a_evict_oldest_unpinned(s);
            sl=slot_insert(s,A_C_FRESH,unit_off(f),unit_len(f,flen),1);
        }
        if(sl>=0){
            a_led(s,OP_ADD,sl,0,unit_off(f),0,unit_len(f,flen),A_C_FRESH,0,
                  0,0,0,0,0,0,0);
        }else{
            a_led(s,OP_REFUSE,-1,1,unit_off(f),0,unit_len(f,flen),A_C_FRESH,0,
                  0,0,0,0,0,103,0);
        }
        f=f+1;
    }
    let n_p3:i32=s.*.led_n;
    // metrics: V survival
    let surv_ok:i32=0;
    v=0;
    while(v<A_M3_V){
        let cid:i32=iget(v_corpus,v*4);let idx:i32=iget(v_idx,v*4);
        let buflen:i32=plen;let base:i32=cbase_of(s,A_C_PROSE);
        if(cid==A_C_CODE){buflen=clen;base=cbase_of(s,A_C_CODE);}
        let off:i32=unit_off(idx);let len:i32=unit_len(idx,buflen);
        let rl:i32=a_recall(s,cid,off,len,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=cget(s,base+off+q)){good=0;break;}q=q+1;}
            if(good==1){surv_ok=surv_ok+1;}
        }
        v=v+1;
    }
    let surv:i64=(surv_ok as i64)*1000/(A_M3_V as i64);
    // fresh sample: last 500 ingested (f=6500..6999)
    let fs_ok:i32=0;
    let fbase:i32=cbase_of(s,A_C_FRESH);
    f=A_M3_FRESH1+A_M3_FRESH2-500;
    while(f<A_M3_FRESH1+A_M3_FRESH2){
        let off:i32=unit_off(f);let len:i32=unit_len(f,flen);
        let rl:i32=a_recall(s,A_C_FRESH,off,len,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=cget(s,fbase+off+q)){good=0;break;}q=q+1;}
            if(good==1){fs_ok=fs_ok+1;}
        }
        f=f+1;
    }
    let fresht:i64=(fs_ok as i64)*1000/500;
    // liveness: management ops in ledger entries [n_p1, n_p3)
    let mgmt:i32=0;let le:i32=n_p1;
    while(le<n_p3){
        let ci:i32=le/LED_CHUNK_E;
        let c:[]u8=led_get(s,ci);
        let op:i32=iget(c,(le-ci*LED_CHUNK_E)*64);
        if(op==OP_ADD || op==OP_KILL || op==OP_PIN || op==OP_WEAKEN ||
           op==OP_PROMOTE || op==OP_EVICT || op==OP_REFUSE){mgmt=mgmt+1;}
        le=le+1;
    }
    let freeze:i32=0;
    if(surv>=900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    if(w_ok<50){freeze=1;}
    let fz:[]u8="CLEAR";
    if(freeze==1){fz="FROZEN-UNDER-PRESSURE";}
    _zag_print("M3,");
    p_dec1(surv);_zag_print(",");p_dec1(fresht);_zag_print(",");
    p_i64(mgmt as i64);_zag_print(",");p_i64(w_ok as i64);_zag_print(",");
    _zag_println(fz);
    let ff:i32=0;
    j_begin(jmode,scale);
    jf_dec1(&ff,"m3_survival_tenths",surv);
    jf_dec1(&ff,"m3_fresh_recall_tenths",fresht);
    jf_int(&ff,"m3_mgmt_entries",mgmt as i64);
    jf_int(&ff,"m3_weaken_handled",w_ok as i64);
    jf_str(&ff,"m3_freeze",fz);
    jf_int(&ff,"m3_valuable",A_M3_V as i64);
    j_end();
    hfree(s,bout);
    hfree(s,v_corpus);hfree(s,v_idx);
}

// ---- defect patch builders (chunk-aware corpus access) ----
fn patch_prose_xor(s:*A,base:i32,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;
    while(i<len){
        let b:u8=cget(s,base+off+i);
        if(i%7==0){b=(b as i32 ^ 255) as u8;}
        out[i]=b;i=i+1;
    }
}
fn code_rename(s:*A,base:i32,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;while(i<len){out[i]=cget(s,base+off+i);i=i+1;}
    let p0:[]u8="sqlite3";let r0:[]u8="sqlite4";
    let p1:[]u8="SQLITE";let r1:[]u8="SQLITF";
    let p2:[]u8="Vdbe";let r2:[]u8="Vdbf";
    let p3:[]u8="Mem";let r3:[]u8="Mfm";
    let p4:[]u8="pBt";let r4:[]u8="pBu";
    let k:i32=0;
    while(k<5){
        let pat:[]u8=p0;let rep:[]u8=r0;
        if(k==1){pat=p1;rep=r1;}
        if(k==2){pat=p2;rep=r2;}
        if(k==3){pat=p3;rep=r3;}
        if(k==4){pat=p4;rep=r4;}
        let pl:i32=pat.len;
        let pos:i32=0;
        while(pos+pl<=len){
            let m:i32=1;let q:i32=0;
            while(q<pl){if(out[pos+q]!=pat[q]){m=0;break;}q=q+1;}
            if(m==1){q=0;while(q<pl){out[pos+q]=rep[q];q=q+1;}pos=pos+pl;}
            else{pos=pos+1;}
        }
        k=k+1;
    }
}
// verify a unit is fully repaired: live, no shift/patch flags, bytes == source
fn unit_verified(s:*A,corpus:i32,buflen:i32,idx:i32,bout:[]u8) i32 {
    let off:i32=unit_off(idx);let len:i32=unit_len(idx,buflen);
    let sl:i32=slot_find(s,corpus,off,len);
    if(sl<0){return 0;}
    let f:i32=iget(s.*.flags,sl*4);
    if((f & F_LIVE)==0){return 0;}
    if((f & (F_SHIFT | F_PATCH))!=0){return 0;}
    let rl:i32=a_recall(s,corpus,off,len,bout);
    if(rl!=len){return 0;}
    let base:i32=cbase_of(s,corpus);
    let i:i32=0;while(i<len){if(bout[i]!=cget(s,base+off+i)){return 0;}i=i+1;}
    return 1;
}

// ---- M4: defect revision ----
fn t_m4(cdir:[]u8,fname:[]u8,corpus:i32,is_code:i32,keyp:[]u8,
        jmode:[]u8,scale:[]u8) void {
    let fsz:i64=file_size(cdir,fname);
    if(fsz<=0){_zag_println("M4,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(fsz as i32);
    let sb:A=a_new(n+n/4+2048,n+1024);
    let s:*A=&sb;
    let blen:i32=read_chunked(s,cdir,fname);
    if(blen<=0){_zag_println("M4,FATAL,empty-corpus");return;}
    reg_set(s,corpus,0,blen);
    let base:i32=cbase_of(s,corpus);
    let bout:[]u8=halloc(s,64);
    let patch:[]u8=halloc(s,64);
    ingest_all(s,blen,corpus,1);
    let d_idx:[]u8=halloc(s,A_M4_N*4);
    let cyc:[]u8=halloc(s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    let j:i32=0;
    while(j<A_M4_N){
        let idx:i32=j*n/A_M4_N;
        iput(d_idx,j*4,idx);
        let off:i32=unit_off(idx);let len:i32=unit_len(idx,blen);
        if(j<100){
            a_defect_boundary(s,corpus,off,len,iget(cyc,(j%12)*4));
        }else{
            if(is_code==1){code_rename(s,base,off,len,patch);}
            else{patch_prose_xor(s,base,off,len,patch);}
            a_defect_content(s,corpus,off,len,patch,len);
        }
        j=j+1;
    }
    let rep_b:i32=0;let rep_c:i32=0;
    let ep:i32=1;
    while(ep<=20){
        j=0;
        while(j<A_M4_N){
            let idx:i32=iget(d_idx,j*4);
            a_revise(s,corpus,unit_off(idx),unit_len(idx,blen));
            j=j+1;
        }
        rep_b=0;rep_c=0;
        j=0;
        while(j<100){
            rep_b=rep_b+unit_verified(s,corpus,blen,iget(d_idx,j*4),bout);
            j=j+1;
        }
        j=100;
        while(j<A_M4_N){
            rep_c=rep_c+unit_verified(s,corpus,blen,iget(d_idx,j*4),bout);
            j=j+1;
        }
        if(rep_b+rep_c>=A_M4_N){break;}
        ep=ep+1;
    }
    let killed:i32=0;
    j=0;
    while(j<A_M4_N){
        let idx:i32=iget(d_idx,j*4);
        let sl:i32=slot_find(s,corpus,unit_off(idx),unit_len(idx,blen));
        if(sl>=0){
            let f:i32=iget(s.*.flags,sl*4);
            if((f & F_LIVE)==0){killed=killed+1;}
        }else{killed=killed+1;}
        j=j+1;
    }
    let rev_bt:i64=(rep_b as i64)*1000/100;
    let rev_ct:i64=(rep_c as i64)*1000/100;
    let kill_t:i64=(killed as i64)*1000/(A_M4_N as i64);
    let ksub:i32=0;
    if(kill_t>500 && (rev_bt<800 || rev_ct<800)){ksub=1;}
    _zag_print("M4,");_zag_print(keyp);_zag_print(",");
    p_dec1(rev_bt);_zag_print(",");p_dec1(rev_ct);_zag_print(",");
    p_dec1(kill_t);_zag_print(",");p_i64(ksub as i64);_zag_println("");
    let f:i32=0;
    j_begin(jmode,scale);
    jf_dec1(&f,"m4_rev_boundary_tenths",rev_bt);
    jf_dec1(&f,"m4_rev_content_tenths",rev_ct);
    jf_dec1(&f,"m4_kill_rate_tenths",kill_t);
    jf_bool(&f,"m4_killsub",ksub);
    jf_int(&f,"m4_episodes",ep as i64);
    j_end();
    hfree(s,bout);hfree(s,patch);
    hfree(s,cyc);hfree(s,d_idx);
}

// ---- M5: resource pressure ----
fn t_m5(cdir:[]u8,jmode:[]u8,scale:[]u8) void {
    let fsz:i64=file_size(cdir,"prose.bin");
    if(fsz<=0){_zag_println("M5,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(fsz as i32);
    let sb:A=a_new(n+n/4+4096,n+2048);
    let s:*A=&sb;
    let end:i32=0;
    let plen:i32=read_chunked(s,cdir,"prose.bin");
    if(plen<=0){_zag_println("M5,FATAL,empty-corpus");return;}
    reg_set(s,A_C_PROSE,end,plen);end=end+plen;
    let flen:i32=read_chunked(s,cdir,"churn_fresh.bin");
    reg_set(s,A_C_FRESH,end,flen);end=end+flen;
    let bout:[]u8=halloc(s,64);
    ingest_all(s,plen,A_C_PROSE,1);
    // mini-pressure: 500 fresh ingests + 500 kills
    let f:i32=0;
    while(f<500){
        a_ingest(s,A_C_FRESH,unit_off(f),unit_len(f,flen),1);
        f=f+1;
    }
    f=0;
    while(f<500){a_kill(s,A_C_FRESH,unit_off(f),unit_len(f,flen),2);f=f+1;}
    // learned = byte-exact recall now
    let l:i32=0;let src:i64=0;
    let base:i32=cbase_of(s,A_C_PROSE);
    let i2:i32=0;
    while(i2<n){
        let off:i32=unit_off(i2);let len:i32=unit_len(i2,plen);
        let rl:i32=a_recall(s,A_C_PROSE,off,len,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=cget(s,base+off+q)){good=0;break;}q=q+1;}
            if(good==1){l=l+1;src=src+(len as i64);}
        }
        i2=i2+1;
    }
    let slot_bytes:i64=(s.*.cap as i64)*24+(s.*.ins_cap as i64)*4;
    let ledger_bytes:i64=(s.*.led_n as i64)*64;
    let wf:i32=write_chunks(".","ledger.bin",s,led_nchunks(s));
    _zag_print("M5,");p_i64(l as i64);_zag_print(",");
    p_i64(src);_zag_print(",");p_i64(slot_bytes);_zag_print(",");
    p_i64(ledger_bytes);_zag_print(",");p_i64(wf as i64);_zag_println("");
    let ff:i32=0;
    j_begin(jmode,scale);
    jf_int(&ff,"m5_units_learned",l as i64);
    jf_int(&ff,"m5_source_bytes_learned",src);
    jf_int(&ff,"m5_slot_table_bytes",slot_bytes);
    jf_int(&ff,"m5_ledger_bytes",ledger_bytes);
    jf_int(&ff,"m5_ledger_entries",s.*.led_n as i64);
    jf_int(&ff,"m5_corpus_buffer_bytes",plen as i64);
    j_end();
    hfree(s,bout);
}

// ---- M6: transfer tax ----
fn t_m6(cdir:[]u8,dir:i32,jmode:[]u8,scale:[]u8) void {
    // dir 0 = prose->code, 1 = code->prose
    let tname:[]u8="t1_prose.bin";let tcid:i32=A_C_T1P;
    let yname:[]u8="code.bin";let ycid:i32=A_C_CODE;
    let dtag:[]u8="p2c";
    if(dir==1){
        tname="t1_code.bin";tcid=A_C_T1C;yname="prose.bin";ycid=A_C_PROSE;
        dtag="c2p";
    }
    let tsz:i64=file_size(cdir,tname);
    let ysz:i64=file_size(cdir,yname);
    if(tsz<=0 || ysz<=0){_zag_println("M6,FATAL,empty-corpus");return;}
    let nt:i32=nunits_of(tsz as i32);let ny:i32=nunits_of(ysz as i32);
    let sb:A=a_new(nt+ny+(nt+ny)/4+8192,nt+ny+2048);
    let s:*A=&sb;
    let end:i32=0;
    let tlen:i32=read_chunked(s,cdir,tname);
    if(tlen<=0){_zag_println("M6,FATAL,empty-corpus");return;}
    reg_set(s,tcid,end,tlen);end=end+tlen;
    let ylen:i32=read_chunked(s,cdir,yname);
    if(ylen<=0){_zag_println("M6,FATAL,empty-corpus");return;}
    reg_set(s,ycid,end,ylen);end=end+ylen;
    let bout:[]u8=halloc(s,64);
    // train on tier-1 to the M2 criterion (policy frozen afterwards: no-op for A)
    let cok:i32=0;let bok:i32=0;let ro:i64=0;let rc:i64=0;
    let e:i32=1;let consec:i32=0;let etc:i32=50;
    while(e<=50){
        if(e==1){ingest_all(s,tlen,tcid,1);}else{ingest_all(s,tlen,tcid,0);}
        probe_reg(s,tcid,tlen,bout,&cok,&bok,&ro,&rc);
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;break;}
        e=e+1;
    }
    let rec_d:i64=cok as i64;let bnd_d:i64=bok as i64;
    let cyc:[]u8=halloc(s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    // in-domain revision: 100 boundary defects on train units
    let j:i32=0;
    while(j<100){
        let idx:i32=j*nt/100;
        a_defect_boundary(s,tcid,unit_off(idx),unit_len(idx,tlen),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        let idx:i32=j*nt/100;
        a_revise(s,tcid,unit_off(idx),unit_len(idx,tlen));
        j=j+1;
    }
    let rev_d:i32=0;
    j=0;
    while(j<100){
        rev_d=rev_d+unit_verified(s,tcid,tlen,j*nt/100,bout);
        j=j+1;
    }
    let rev_dt:i64=(rev_d as i64)*10;
    // transfer: face the new domain (ingest allowed, policy frozen)
    ingest_all(s,ylen,ycid,1);
    let rec_t:i32=0;let bnd_t:i32=0;
    probe_reg(s,ycid,ylen,bout,&rec_t,&bnd_t,&ro,&rc);
    // transfer revision
    j=0;
    while(j<100){
        let idx:i32=j*ny/100;
        a_defect_boundary(s,ycid,unit_off(idx),unit_len(idx,ylen),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        let idx:i32=j*ny/100;
        a_revise(s,ycid,unit_off(idx),unit_len(idx,ylen));
        j=j+1;
    }
    let rev_t:i32=0;
    j=0;
    while(j<100){
        rev_t=rev_t+unit_verified(s,ycid,ylen,j*ny/100,bout);
        j=j+1;
    }
    let rev_tt:i64=(rev_t as i64)*10;
    let tax:i64=((rec_d-(rec_t as i64))+((bnd_d-(bnd_t as i64)))+(rev_dt-rev_tt))/3;
    _zag_print("M6,");_zag_print(dtag);_zag_print(",");
    p_dec1(rec_t as i64);_zag_print(",");p_dec1(bnd_t as i64);_zag_print(",");
    p_dec1(rev_tt);_zag_print(",");p_dec1(tax);_zag_println("");
    let f:i32=0;
    j_begin(jmode,scale);
    jf_dec1(&f,"rec_tenths",rec_t as i64);
    jf_dec1(&f,"bnd_tenths",bnd_t as i64);
    jf_dec1(&f,"rev_tenths",rev_tt);
    jf_dec1(&f,"tax_tenths",tax);
    j_end();
    hfree(s,bout);hfree(s,cyc);
}

// ---- M7: non-ID arm -> N/A + re-read byte count ----
fn t_m7(cdir:[]u8,jmode:[]u8,scale:[]u8) void {
    let fsz:i64=file_size(cdir,"prose.bin");
    if(fsz<=0){_zag_println("M7,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(fsz as i32);
    let sb:A=a_new(n+n/4+2048,n+1024);
    let s:*A=&sb;
    let plen:i32=read_chunked(s,cdir,"prose.bin");
    if(plen<=0){_zag_println("M7,FATAL,empty-corpus");return;}
    reg_set(s,A_C_PROSE,0,plen);
    let bout:[]u8=halloc(s,64);
    // round 0: ingest C; round 1: ingest C again (revive path)
    ingest_all(s,plen,A_C_PROSE,1);
    ingest_all(s,plen,A_C_PROSE,0);
    let reread:i64=0;
    let l:i32=0;
    while(l<1666){
        let idx:i32=(l*37)%n;
        let rl:i32=a_recall(s,A_C_PROSE,unit_off(idx),unit_len(idx,plen),bout);
        if(rl>0){reread=reread+(rl as i64);}
        l=l+1;
    }
    // round 2: C' = C with deterministic every-100th-unit edits
    // (A edit mechanism: recorded byte patch, audited as trainer op)
    let ep2:[]u8=halloc(s,64);
    let base:i32=cbase_of(s,A_C_PROSE);
    let q:i32=0;
    while(q<n){
        if(q%100==0){
            let off:i32=unit_off(q);let len:i32=unit_len(q,plen);
            let a:i32=0;
            while(a<len){ep2[a]=cget(s,base+off+a);a=a+1;}
            ep2[0]=(ep2[0] as i32 ^ 255) as u8;
            a_defect_content(s,A_C_PROSE,off,len,ep2,len);
        }
        q=q+1;
    }
    hfree(s,ep2);
    while(l<A_M7_LOOKUPS){
        let idx:i32=(l*37)%n;
        let rl:i32=a_recall(s,A_C_PROSE,unit_off(idx),unit_len(idx,plen),bout);
        if(rl>0){reread=reread+(rl as i64);}
        l=l+1;
    }
    _zag_print("M7,non-id,");p_i64(reread);_zag_println("");
    let f:i32=0;
    j_begin(jmode,scale);
    jf_null(&f,"m7_hit_rate_tenths");
    jf_null(&f,"m7_reuse_rate_tenths");
    jf_null(&f,"m7_dedup_savings_bytes");
    jf_str(&f,"m7_na_reason","no ID layer: recall takes a coordinate triple, resolved by linear scan");
    jf_int(&f,"m7_reread_bytes",reread);
    j_end();
    hfree(s,bout);
}

// ---- M8: determinism gate ----
fn hash_pieces(s:*A,data:[]u8,chain_in:[]u8,ci0:i32) i32 {
    let nch:i32=(data.len+1048575)/1048576;
    let ci:i32=0;
    while(ci<nch){
        let cs:i32=ci*1048576;let cn:i32=data.len-cs;
        if(cn>1048576){cn=1048576;}
        ns_sha256(data[cs..cs+cn],chain_in[(ci0+ci)*32..(ci0+ci)*32+32]);
        ci=ci+1;
    }
    return ci0+nch;
}
fn write_hex_line(dir:[]u8,fname:[]u8,tag:[]u8,hash:[]u8) i32 {
    let hx:[]u8=ns_hex(hash);
    let line:[]u8=nio_alloc(tag.len+1+hx.len+1);
    let i:i32=0;while(i<tag.len){line[i]=tag[i];i=i+1;}
    line[tag.len]=32;
    let k:i32=0;while(k<hx.len){line[tag.len+1+k]=hx[k];k=k+1;}
    line[tag.len+1+hx.len]=10;
    let r:i32=write_file(dir,fname,line);
    nio_free(hx);nio_free(line);
    return r;
}
fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    // perturbations (raw allocations bypass the logged trace)
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            i=i+1;
        }
    }
    let aslr_pad:[]u8="";
    if(_zag_strcmp(pert,"aslr")==1){
        aslr_pad=nio_alloc(1234567);
    }
    // freelist-rev / starve: accepted, documented no-ops for A
    // (slot placement is insertion-order append; clock/entropy unused)
    let psz:i64=file_size(cdir,"prose.bin");
    let csz:i64=file_size(cdir,"code.bin");
    let fsz:i64=file_size(cdir,"churn_fresh.bin");
    if(psz<=0 || csz<=0 || fsz<=0){_zag_println("M8,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(psz as i32);let nun_c:i32=nunits_of(csz as i32);
    let sb:A=a_new(nun_p+nun_c+(nun_p+nun_c)/4+16384,nun_p+nun_c+9000);
    let s:*A=&sb;
    let end:i32=0;
    let plen:i32=read_chunked(s,cdir,"prose.bin");
    reg_set(s,A_C_PROSE,end,plen);end=end+plen;
    let clen:i32=read_chunked(s,cdir,"code.bin");
    reg_set(s,A_C_CODE,end,clen);end=end+clen;
    let flen:i32=read_chunked(s,cdir,"churn_fresh.bin");
    reg_set(s,A_C_FRESH,end,flen);end=end+flen;
    let bout:[]u8=halloc(s,64);
    // M1: ingest + full recall both corpora
    ingest_all(s,plen,A_C_PROSE,1);
    let cok:i32=0;let bok:i32=0;let ro:i64=0;let rc:i64=0;
    probe_reg(s,A_C_PROSE,plen,bout,&cok,&bok,&ro,&rc);
    let m1p:i32=cok;
    ingest_all(s,clen,A_C_CODE,1);
    probe_reg(s,A_C_CODE,clen,bout,&cok,&bok,&ro,&rc);
    let m1c:i32=cok;
    // M3 sequence on the same instance (V = every k-th over both corpora)
    let total:i32=nun_p+nun_c;
    let k:i32=total/A_M3_V;if(k<1){k=1;}
    let v:i32=0;
    while(v<A_M3_V){
        let g:i32=v*k;
        let cid:i32=A_C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=A_C_CODE;idx=g-nun_p;}
        let buflen:i32=plen;if(cid==A_C_CODE){buflen=clen;}
        a_mark_valuable(s,cid,unit_off(idx),unit_len(idx,buflen));
        v=v+1;
    }
    let f:i32=0;
    while(f<A_M3_FRESH1){
        a_ingest(s,A_C_FRESH,unit_off(f),unit_len(f,flen),1);
        f=f+1;
    }
    f=0;
    while(f<A_M3_KILL){a_kill(s,A_C_FRESH,unit_off(f),unit_len(f,flen),1);f=f+1;}
    let w:i32=0;
    while(w<50){
        let g2:i32=(w*20)*k;
        let cid2:i32=A_C_PROSE;let idx2:i32=g2;
        if(g2>=nun_p){cid2=A_C_CODE;idx2=g2-nun_p;}
        let buflen2:i32=plen;if(cid2==A_C_CODE){buflen2=clen;}
        a_weaken(s,cid2,unit_off(idx2),unit_len(idx2,buflen2),w+1);
        w=w+1;
    }
    f=A_M3_FRESH1;
    while(f<A_M3_FRESH1+A_M3_FRESH2){
        let sl:i32=slot_insert(s,A_C_FRESH,unit_off(f),unit_len(f,flen),1);
        if(sl<0){
            a_evict_oldest_unpinned(s);
            sl=slot_insert(s,A_C_FRESH,unit_off(f),unit_len(f,flen),1);
        }
        if(sl>=0){
            a_led(s,OP_ADD,sl,0,unit_off(f),0,unit_len(f,flen),A_C_FRESH,0,
                  0,0,0,0,0,0,0);
        }
        f=f+1;
    }
    // artifacts
    // store image: per-2^20-chunk sha256 over the slot region
    // (corps, offs, lens, flags, shifts, pidx: cap*4 each; ins: ins_cap*4)
    let cap:i32=s.*.cap;
    let nch:i32=(cap*4+1048575)/1048576*6+(s.*.ins_cap*4+1048575)/1048576;
    let chain_in:[]u8=halloc(s,nch*32);
    let ci:i32=0;
    ci=hash_pieces(s,s.*.corps,chain_in,ci);
    ci=hash_pieces(s,s.*.offs,chain_in,ci);
    ci=hash_pieces(s,s.*.lens,chain_in,ci);
    ci=hash_pieces(s,s.*.flags,chain_in,ci);
    ci=hash_pieces(s,s.*.shifts,chain_in,ci);
    ci=hash_pieces(s,s.*.pidx,chain_in,ci);
    ci=hash_pieces(s,s.*.ins,chain_in,ci);
    let chl:[]u8=halloc(s,ci*80);
    let cho:i32=0;
    let c2:i32=0;
    while(c2<ci){
        let hx:[]u8=ns_hex(chain_in[c2*32..c2*32+32]);
        let tag:[]u8=_zag_i64_to_str(c2 as i64);
        chl[cho]=99;chl[cho+1]=104;chl[cho+2]=117;chl[cho+3]=110;chl[cho+4]=107;cho=cho+5;
        let a2:i32=0;while(a2<tag.len){chl[cho]=tag[a2];cho=cho+1;a2=a2+1;}
        chl[cho]=32;cho=cho+1;
        let b2:i32=0;while(b2<hx.len){chl[cho]=hx[b2];cho=cho+1;b2=b2+1;}
        chl[cho]=10;cho=cho+1;
        nio_free(hx);nio_free(tag);
        c2=c2+1;
    }
    write_file(outdir,"store_hashes.txt",chl[0..cho]);
    let chain:[]u8=halloc(s,32);
    ns_sha256(chain_in[0..ci*32],chain);
    write_hex_line(outdir,"store_chain.txt","chain",chain);
    // ledger.bin (chunked write)
    write_chunks(outdir,"ledger.bin",s,led_nchunks(s));
    // ledger chain: literal sha256(ledger.bin) when it fits one chunk;
    // at 10x the ledger spans chunks, so chain = sha256(concat(per-chunk
    // sha256s)) — the same construction as store_chain (scale build note A-A3).
    let lhash:[]u8=halloc(s,32);
    let nlch:i32=led_nchunks(s);
    if(nlch<=1){
        let lb:[]u8=led_get(s,0);
        if(s.*.led_n>0){ns_sha256(lb[0..s.*.led_n*64],lhash);}
        else{ns_sha256("",lhash);}
    }else{
        let ch:[]u8=halloc(s,nlch*32);
        let q:i32=0;
        while(q<nlch){
            let lc:[]u8=led_get(s,q);
            ns_sha256(lc[0..led_chunk_used(s,q)],ch[q*32..q*32+32]);
            q=q+1;
        }
        ns_sha256(ch,lhash);
        hfree(s,ch);
    }
    write_hex_line(outdir,"ledger_chain.txt","chain",lhash);
    write_file(outdir,"alloc_trace.txt",s.*.trace[0..s.*.trace_n]);
    _zag_print("M8,");
    p_dec1(m1p as i64);_zag_print(",");p_dec1(m1c as i64);_zag_print(",");
    p_i64(s.*.led_n as i64);_zag_println("");
    let ff:i32=0;
    let hx_chain:[]u8=ns_hex(chain);
    let hx_lhash:[]u8=ns_hex(lhash);
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"a\",\"round\":\"r1\",\"scale\":\"");
    _zag_print("1x");_zag_print("\",\"mode\":\"m8-1x\",\"fields\":{");
    jf_dec1(&ff,"m8_recall_prose_tenths",(m1p as i64));
    jf_dec1(&ff,"m8_recall_code_tenths",(m1c as i64));
    jf_int(&ff,"m8_ledger_entries",s.*.led_n as i64);
    jf_int(&ff,"m8_ledger_bytes",(s.*.led_n as i64)*64);
    jf_str(&ff,"m8_store_chain",hx_chain);
    jf_str(&ff,"m8_ledger_chain",hx_lhash);
    _zag_print("}}");_zag_println("");
    nio_free(hx_chain);nio_free(hx_lhash);
    hfree(s,bout);hfree(s,chain_in);hfree(s,chl);hfree(s,chain);hfree(s,lhash);
    if(aslr_pad.len>0){nio_free(aslr_pad);}
}

// ---- mode normalization: "-10x" suffix -> "-1x" for dispatch ----
fn has_10x(mode:[]u8) i32 {
    let i:i32=0;
    while(i+4<=mode.len){
        if(mode[i]==45 && mode[i+1]==49 && mode[i+2]==48 && mode[i+3]==120){return 1;}
        i=i+1;
    }
    return 0;
}
fn norm_mode(mode:[]u8) []u8 {
    let out:[]u8=nio_alloc(mode.len);
    let i:i32=0;let o:i32=0;
    while(i<mode.len){
        if(i+4<=mode.len && mode[i]==45 && mode[i+1]==49 && mode[i+2]==48 && mode[i+3]==120){
            out[o]=45;out[o+1]=49;out[o+2]=120;o=o+3;i=i+4;
        }else{out[o]=mode[i];o=o+1;i=i+1;}
    }
    return out[0..o];
}

// ---- m5-baseline: same-shape store, all arrays touched, no learning ----
fn t_m5_baseline(cdir:[]u8) void {
    let fsz:i64=file_size(cdir,"prose.bin");
    if(fsz<=0){_zag_println("M5,FATAL,empty-corpus");return;}
    let pn:i32=nunits_of(fsz as i32);
    let sb:A=a_new(pn+pn/4+4096,pn+2048);
    let s:*A=&sb;
    let corps:[]u8=s.*.corps;let offs:[]u8=s.*.offs;let lens:[]u8=s.*.lens;
    let flags:[]u8=s.*.flags;let shifts:[]u8=s.*.shifts;let pidx:[]u8=s.*.pidx;
    let ins:[]u8=s.*.ins;
    let i:i32=0;
    while(i<s.*.cap){
        iput(corps,i*4,-1);iput(offs,i*4,-1);iput(lens,i*4,0);
        iput(flags,i*4,0);iput(shifts,i*4,0);iput(pidx,i*4,-1);
        i=i+1;
    }
    i=0;
    while(i<s.*.ins_cap){iput(ins,i*4,-1);i=i+1;}
    let spin:i32=0;
    while(spin<300000000){spin=spin+1;}
    _zag_println("M5-BASELINE-READY");
}

// ---- main ----
fn main() i32 {
    let argc:i32=_zag_argc();
    if(argc<2){_zag_println("FATAL: usage: arm <mode> <corpus-root> [outdir] [perturb]");return 1;}
    let mode0:[]u8=_zag_arg(1);
    let is10:i32=has_10x(mode0);
    let nm:[]u8=norm_mode(mode0);
    let scale:[]u8="1x";
    if(is10==1){scale="10x";}
    let cdir:[]u8=".";
    if(argc>=3){cdir=_zag_arg(2);}
    // dispatch on the normalized mode name
    if(_zag_strcmp(nm,"m1-1x-prose")==1){
        t_m1(cdir,"prose.bin",A_C_PROSE,"prose",mode0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m1-1x-code")==1){
        t_m1(cdir,"code.bin",A_C_CODE,"code",mode0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m2-t1-prose")==1){
        t_m2(cdir,"t1_prose.bin",A_C_PROSE,"m2-t1-prose",0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m2-t1-code")==1){
        t_m2(cdir,"t1_code.bin",A_C_CODE,"m2-t1-code",0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m2-t2-prose")==1){
        t_m2(cdir,"t2_prose.bin",A_C_PROSE,"m2-t2-prose",0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m2-t2-code")==1){
        t_m2(cdir,"t2_code.bin",A_C_CODE,"m2-t2-code",1,scale);return 0;
    }
    if(_zag_strcmp(nm,"m2-t3-1x")==1){
        t_m2(cdir,"t3.bin",A_C_T3,"m2-t3-1x",0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m3-1x")==1){
        t_m3(cdir,mode0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m4-1x-prose")==1){
        t_m4(cdir,"prose.bin",A_C_PROSE,0,"prose",mode0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m4-1x-code")==1){
        t_m4(cdir,"code.bin",A_C_CODE,1,"code",mode0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m5-1x")==1){
        t_m5(cdir,mode0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m5-baseline")==1){
        t_m5_baseline(cdir);return 0;
    }
    if(_zag_strcmp(nm,"m6-p2c-1x")==1){
        t_m6(cdir,0,mode0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m6-c2p-1x")==1){
        t_m6(cdir,1,mode0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m7-1x")==1){
        t_m7(cdir,mode0,scale);return 0;
    }
    if(_zag_strcmp(nm,"m8-1x")==1){
        if(argc<4){_zag_println("FATAL: m8 needs outdir");return 1;}
        let outdir:[]u8=_zag_arg(3);
        let pert:[]u8="none";
        if(argc>=5){pert=_zag_arg(4);}
        t_m8(cdir,outdir,pert);return 0;
    }
    _zag_print("FATAL: unknown mode ");_zag_println(mode0);
    return 1;
}

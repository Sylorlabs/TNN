// z1 — Arm Z1: Witness-bound cuts (family CUT).
// Frozen §3 mechanism: A cut must survive an eliminative challenge window to
// become a chunk; challenged-and-failed cuts are regretted on the record.
// Frozen §3 binding kill criterion: Regretted-cut rate not >=50% lower than arm D
// on the revision curriculum — the window buys nothing; OR challenge-set revision
// invalidates >10% of live witnesses — binding too brittle
// (kill the binding, keep the window).
// One binary; argv[1] selects the trial mode (see ARM_INTERFACE.md §3).
// Pure Zag, zero RNG in any decision path, byte-identical reruns.
// Trial layout: Z1/cl/arm.zag + Z1/substrate/{R33_NATIVE_SHA256_V2.zag,R33_NATIVE_IO_V1.zag}
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

// ---- preregistered challenge window (fixed at build; see ARM_SPEC.md §2) ----
// A proposed cut at byte position p (on the Z1_GRID proposal grid) faces three
// eliminative challenges. The cut SURVIVES iff no challenge fires.
//   C1 "splits a recall unit": fires iff bytes[p-1] and bytes[p] are both word
//       bytes [A-Za-z0-9_] — the cut would split a maximal word run.
//   C2 "undetectable by an independent re-cut": fires iff no whitespace byte
//       (space, \t, \n, \r) occurs in [p-Z1_CK, p+Z1_CK) — an independent
//       whitespace re-cut cannot see this boundary.
//   C3 "shifting it ±k bytes changes nothing": fires iff the 2*Z1_CK bytes
//       around p are all identical — the exact placement is arbitrary.
const Z1_GRID:i32=64;
const Z1_CK:i32=8;
const Z1_VERSION:i32=1;   // challenge-set version stamped on every witness
// corpus ids (frozen, ARM_INTERFACE.md §6)
const Z1_C_PROSE:i32=1;
const Z1_C_CODE:i32=2;
const Z1_C_T1P:i32=3;
const Z1_C_T1C:i32=4;
const Z1_C_T2P:i32=5;
const Z1_C_T2C:i32=6;
const Z1_C_T3:i32=7;
const Z1_C_FRESH:i32=8;
const Z1_M3_CAP:i32=4000;      // C_M3: harness-fixed M3 store capacity (slots)
const Z1_M3_V:i32=1000;        // valuable set size
const Z1_M3_FRESH1:i32=3000;   // phase-1 fresh ingests
const Z1_M3_KILL:i32=3000;     // phase-2 kills
const Z1_M3_FRESH2:i32=4000;   // phase-3 ingests at capacity
const Z1_M4_N:i32=200;         // defect units per corpus
const Z1_M7_LOOKUPS:i32=5000;

// flags bits
const F_OCC:i32=1;
const F_LIVE:i32=2;
const F_PIN:i32=4;
const F_WEAK:i32=8;
const F_SHIFT:i32=16;
const F_PATCH:i32=32;

// ledger opcodes (frozen namespace, ARM_INTERFACE.md §6)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_TDB:i32=16;   // TRAINER_DEFECT_BOUNDARY
const OP_TDC:i32=17;   // TRAINER_DEFECT_CONTENT
const OP_TMV:i32=18;   // TRAINER_MARK_VALUABLE
const OP_TSP:i32=19;   // TRAINER_SWAP_PROBE (M1 ID-arm probe, A15 provisional)

// REFUSE reason codes (documented per opcode; 101-103 mirror the b64 validator)
const RC_FULL:i32=101;        // store full on ingest
const RC_WEAKMISS:i32=102;    // weaken target missing
const RC_EVICTFAIL:i32=103;   // ingest refused at capacity after eviction attempt
// refuted-cut reasons: 110 + challenge bitmask (bits: 1=C1, 2=C2, 4=C3)

// ---- little-endian u32/i32 packing on []u8 ----
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }

// ---- Z1 store: dense rows, row index == unit ID ----
// The ID layer is this persistent ID->(span, witness) mapping: recall takes only
// an ID and resolves it here. Z1 is therefore an ID arm (ARM_INTERFACE.md §9).
struct Z1 {
    cap:i32,
    next_id:i32,   // issuance high-water; row index == unit ID; reused via freelist after kill
    nlive:i32,
    id_refs:i64,   // ID references (ingests + successful recall resolutions)
    offs:[]u8,     // cap * u32: byte offset
    lens:[]u8,     // cap * u32: length
    corps:[]u8,    // cap * u32: corpus id
    flags:[]u8,    // cap * u32: flags bits
    shifts:[]u8,   // cap * i32: recorded boundary shift
    poff:[]u8,     // cap * u32: patch-data offset (content defect)
    plen:[]u8,     // cap * u32: patch length
    wit:[]u8,      // cap * 32: witness hash (SHA-256 over challenge transcript)
    witv:[]u8,     // cap * u32: challenge-set version stamp
    witc:[]u8,     // cap * u32: challenge outcome bits for the left boundary
    pdata:[]u8,    // patch data bump buffer
    pdata_n:i32,
    pdata_cap:i32,
    led:[]u8,      // ledger bytes
    led_n:i32,     // entries appended
    led_cap:i32,   // byte capacity
    ins:[]u8,      // insertion-order queue of unit IDs (ins_cap * i32)
    ins_cap:i32,
    ins_n:i32,
    ins_head:i32,
    dedup:[]u8,    // dedup map: dd_cap * 8 bytes (key u32, id i32); id<0 = empty
    dd_cap:i32,
    trace:[]u8,    // alloc trace text
    trace_n:i32,
    trace_cap:i32,
    free_head:i32, // freelist head for killed row IDs (-1 = empty)
    free_next:[]u8, // cap * i32: freelist next pointers
}

// ---- allocator wrappers with trace (addresses never logged) ----
fn halloc(s:*Z1,n:i32)[]u8 {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(n as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=65;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    return nio_alloc(n);
}
fn hfree(s:*Z1,b:[]u8)void {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(b.len as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=70;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    nio_free(b);
}

fn z1_init(s:*Z1,cap:i32,led_entries:i32,ins_max:i32,dd_cap:i32,pdata_cap:i32)void {
    s.*.cap=cap;s.*.next_id=0;s.*.nlive=0;s.*.id_refs=0;
    s.*.trace_cap=65536;s.*.trace=nio_alloc(65536);s.*.trace_n=0;
    s.*.offs=halloc(s,cap*4);s.*.lens=halloc(s,cap*4);s.*.corps=halloc(s,cap*4);
    s.*.flags=halloc(s,cap*4);s.*.shifts=halloc(s,cap*4);
    s.*.poff=halloc(s,cap*4);s.*.plen=halloc(s,cap*4);
    s.*.wit=halloc(s,cap*32);s.*.witv=halloc(s,cap*4);s.*.witc=halloc(s,cap*4);
    s.*.pdata_cap=pdata_cap;s.*.pdata=halloc(s,pdata_cap);s.*.pdata_n=0;
    s.*.led_cap=led_entries*64;s.*.led=halloc(s,s.*.led_cap);s.*.led_n=0;
    s.*.ins=halloc(s,ins_max*4);s.*.ins_cap=ins_max;s.*.ins_n=0;s.*.ins_head=0;
    s.*.dd_cap=dd_cap;
    if(dd_cap>0){
        s.*.dedup=halloc(s,dd_cap*8);
        let dd:[]u8=s.*.dedup;let i:i32=0;
        while(i<dd_cap){iput(dd,i*8+4,-1);i=i+1;}
    }else{s.*.dedup="";}
    s.*.free_head=-1;
    s.*.free_next=halloc(s,cap*4);
}
fn z1_new(cap:i32,led_entries:i32,ins_max:i32,dd_cap:i32,pdata_cap:i32) Z1 {
    let s:Z1=Z1{.cap=0,.next_id=0,.nlive=0,.id_refs=0,.offs="",.lens="",.corps="",
        .flags="",.shifts="",.poff="",.plen="",.wit="",.witv="",.witc="",
        .pdata="",.pdata_n=0,.pdata_cap=0,.led="",.led_n=0,.led_cap=0,
        .ins="",.ins_cap=0,.ins_n=0,.ins_head=0,.dedup="",.dd_cap=0,
        .trace="",.trace_n=0,.trace_cap=0,.free_head=-1,.free_next=""};
    z1_init(&s,cap,led_entries,ins_max,dd_cap,pdata_cap);
    return s;
}

// ---- ledger ----
// 16-word entries, stage=1 (operational). Per-opcode field use is documented in
// ARM_SPEC.md §4. d1/d2 carry the witness hash low 8 bytes on ADD.
fn z_led(s:*Z1,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
         a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)void {
    let at:i32=s.*.led_n*64;
    if(at+64>s.*.led_cap){return;} // LEDGER-BOUND: scored on what completed
    let l:[]u8=s.*.led;
    iput(l,at,op);iput(l,at+4,slot);iput(l,at+8,rc);
    iput(l,at+12,b1);iput(l,at+16,b2);iput(l,at+20,b3);iput(l,at+24,b4);iput(l,at+28,b5);
    iput(l,at+32,a1);iput(l,at+36,a2);iput(l,at+40,a3);iput(l,at+44,a4);iput(l,at+48,a5);
    iput(l,at+52,1);iput(l,at+56,d1);iput(l,at+60,d2);
    s.*.led_n=s.*.led_n+1;
}

// ---- the eliminative challenge window (preregistered; see header/ARM_SPEC.md) ----
fn z1_is_word(b:u8) i32 {
    let c:i32=b as i32;
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    if(c>=48 && c<=57){return 1;}
    if(c==95){return 1;}
    return 0;
}
fn z1_is_ws(b:u8) i32 {
    let c:i32=b as i32;
    if(c==32 || c==9 || c==10 || c==13){return 1;}
    return 0;
}
// Returns the challenge bitmask for a proposed cut at byte position p:
// bit0 = C1 fired, bit1 = C2 fired, bit2 = C3 fired. 0 = the cut survives.
fn z1_challenges(buf:[]u8,p:i32,n:i32) i32 {
    let bits:i32=0;
    // C1: this boundary splits a recall unit (a maximal [A-Za-z0-9_]+ run)
    if(p>0 && p<n){
        if(z1_is_word(buf[p-1])==1 && z1_is_word(buf[p])==1){bits=bits|1;}
    }
    // C2: undetectable by an independent re-cut (no whitespace within ±CK)
    let lo:i32=p-Z1_CK;if(lo<0){lo=0;}
    let hi:i32=p+Z1_CK;if(hi>n){hi=n;}
    let seen:i32=0;let q:i32=lo;
    while(q<hi){if(z1_is_ws(buf[q])==1){seen=1;break;}q=q+1;}
    if(seen==0){bits=bits|2;}
    // C3: shifting ±CK changes nothing (2*CK identical bytes around p)
    if(p-Z1_CK>=0 && p+Z1_CK<=n){
        let same:i32=1;let r:i32=p-Z1_CK+1;
        while(r<p+Z1_CK){if(buf[r]!=buf[p-Z1_CK]){same=0;break;}r=r+1;}
        if(same==1){bits=bits|4;}
    }
    return bits;
}
// Witness: SHA-256 over the challenge transcript
// (version || corpus || offset || length || challenge-bits || stream-start-flag).
// The unit ID binds (span, challenge_transcript_hash) through the row: the row
// carries the full 32-byte witness; the ledger ADD carries its low 8 bytes.
fn z1_witness(cid:i32,off:i32,len:i32,cbits:i32,sflag:i32,out:[]u8) void {
    let t:[]u8=nio_alloc(24);
    iput(t,0,Z1_VERSION);iput(t,4,cid);iput(t,8,off);
    iput(t,12,len);iput(t,16,cbits);iput(t,20,sflag);
    ns_sha256(t,out);
    nio_free(t);
}
fn z1_wit_eq(s:*Z1,id:i32,wit:[]u8) i32 {
    let wmem:[]u8=s.*.wit;let wb:i32=id*32;let q:i32=0;
    while(q<32){if(wmem[wb+q]!=wit[q]){return 0;}q=q+1;}
    return 1;
}

// ---- dedup: content-key -> unit ID (open addressing, deterministic) ----
// Guarantees M7 round-2 ID stability: re-ingesting an identical span resolves to
// the same ID. Key = FNV-1a-32 over (corpus, offset, length, witness[0..8]).
fn z1_dkey(cid:i32,off:i32,len:i32,wit:[]u8) i32 {
    let h:i64=2166136261;
    let i:i32=0;
    while(i<4){h=((h ^ (((cid>>(i*8)) & 255) as i64))*16777619)%4294967296;i=i+1;}
    i=0;
    while(i<4){h=((h ^ (((off>>(i*8)) & 255) as i64))*16777619)%4294967296;i=i+1;}
    i=0;
    while(i<4){h=((h ^ (((len>>(i*8)) & 255) as i64))*16777619)%4294967296;i=i+1;}
    i=0;
    while(i<8){h=((h ^ (wit[i] as i64))*16777619)%4294967296;i=i+1;}
    return (h % 2147483647) as i32;
}
fn z1_dedup_find(s:*Z1,key:i32,cid:i32,off:i32,len:i32,wit:[]u8) i32 {
    let cap:i32=s.*.dd_cap;
    if(cap<=0){return -1;}
    let dd:[]u8=s.*.dedup;
    let h:i32=key%cap;if(h<0){h=h+cap;}
    let t:i32=0;
    while(t<cap){
        let at:i32=h*8;
        let k:i32=iget(dd,at);let id:i32=iget(dd,at+4);
        if(id<0){return -1;}
        if(k==key && id>=0 && id<s.*.next_id){
            let flags:[]u8=s.*.flags;
            if((iget(flags,id*4) & F_LIVE)!=0 &&
               iget(s.*.corps,id*4)==cid &&
               iget(s.*.offs,id*4)==off &&
               iget(s.*.lens,id*4)==len &&
               z1_wit_eq(s,id,wit)==1){return id;}
        }
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    return -1;
}
fn z1_dedup_insert(s:*Z1,key:i32,id:i32) void {
    let cap:i32=s.*.dd_cap;
    if(cap<=0){return;}
    let dd:[]u8=s.*.dedup;
    let h:i32=key%cap;if(h<0){h=h+cap;}
    let t:i32=0;
    while(t<cap){
        let at:i32=h*8;
        if(iget(dd,at+4)<0){iput(dd,at,key);iput(dd,at+4,id);return;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
}

// ---- core ops ----
// z1_insert: the unit-creation primitive. No ledger logging (callers log).
// Returns the unit ID, or -1 if the store is full.
fn z1_insert(s:*Z1,buf:[]u8,cid:i32,off:i32,len:i32,is_new:*i32) i32 {
    let n:i32=buf.len;
    let cbits:i32=0;let sflag:i32=0;
    if(off==0){sflag=1;}else{cbits=z1_challenges(buf,off,n);}
    let wit:[]u8=nio_alloc(32);
    z1_witness(cid,off,len,cbits,sflag,wit);
    let key:i32=z1_dkey(cid,off,len,wit);
    let hit:i32=z1_dedup_find(s,key,cid,off,len,wit);
    if(hit>=0){
        // verify the hit is still live (dedup may hold stale killed entries)
        let hflags:[]u8=s.*.flags;
        if((iget(hflags,hit*4) & F_LIVE)!=0){
            nio_free(wit);s.*.id_refs=s.*.id_refs+1;
            if(is_new!=0){is_new.*=0;}
            return hit;
        }
        // stale: fall through to fresh insert (dedup entry will be overwritten)
    }
    // allocate row: freelist first, else next_id
    let id:i32=-1;
    if(s.*.free_head>=0){
        id=s.*.free_head;
        let fn_:[]u8=s.*.free_next;
        s.*.free_head=iget(fn_,id*4);
    }else if(s.*.next_id<s.*.cap){
        id=s.*.next_id;
        s.*.next_id=id+1;
    }else{
        nio_free(wit);
        if(is_new!=0){is_new.*=0;}
        return -1;
    }
    let offs:[]u8=s.*.offs;let lens:[]u8=s.*.lens;let corps:[]u8=s.*.corps;
    let flags:[]u8=s.*.flags;let shifts:[]u8=s.*.shifts;
    let poff:[]u8=s.*.poff;let plen:[]u8=s.*.plen;
    iput(offs,id*4,off);iput(lens,id*4,len);iput(corps,id*4,cid);
    iput(flags,id*4,F_OCC|F_LIVE);iput(shifts,id*4,0);
    iput(poff,id*4,0);iput(plen,id*4,0);
    let wmem:[]u8=s.*.wit;let wb:i32=id*32;let q:i32=0;
    while(q<32){wmem[wb+q]=wit[q];q=q+1;}
    nio_free(wit);
    iput(s.*.witv,id*4,Z1_VERSION);iput(s.*.witc,id*4,cbits);
    let ins:[]u8=s.*.ins;
    iput(ins,s.*.ins_n*4,id);s.*.ins_n=s.*.ins_n+1;
    z1_dedup_insert(s,key,id);
    s.*.nlive=s.*.nlive+1;
    s.*.id_refs=s.*.id_refs+1;
    if(is_new!=0){is_new.*=1;}
    return id;
}
// ingest(span): deliberate add of a unit covering (corpus_id, offset, len).
// New units log ADD (with witness); dedup hits are silent re-resolution.
fn z1_ingest(s:*Z1,buf:[]u8,cid:i32,off:i32,len:i32) i32 {
    let is_new:i32=0;
    let id:i32=z1_insert(s,buf,cid,off,len,&is_new);
    if(id<0){
        z_led(s,OP_REFUSE,-1,1,off,0,len,cid,-1,0,0,0,0,0,RC_FULL,0);
        return -1;
    }
    if(is_new==1){
        let wmem:[]u8=s.*.wit;let wb:i32=id*32;
        let d1:i32=iget(wmem,wb);let d2:i32=iget(wmem,wb+4);
        let cb:i32=iget(s.*.witc,id*4);
        z_led(s,OP_ADD,id,0,off,0,len,cid,id,cb,Z1_VERSION,0,0,0,d1,d2);
    }
    return id;
}
fn z1_recall(s:*Z1,cbufs:[]u8,coffs:[]u8,clens:[]u8,id:i32,out:[]u8) i32 {
    // resolve id -> row -> bytes. The request carries ONLY the ID.
    if(id<0 || id>=s.*.next_id){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,id*4);
    if((f & F_LIVE)==0){return -1;}
    s.*.id_refs=s.*.id_refs+1;
    let len:i32=iget(s.*.lens,id*4);
    if(len>out.len){return -1;}
    // patch (recorded content defect) takes precedence, like a corrupted copy
    if((f & F_PATCH)!=0){
        let pa:i32=iget(s.*.poff,id*4);let pl:i32=iget(s.*.plen,id*4);
        if(pl!=len){return -1;}
        let pb:[]u8=s.*.pdata;
        let i:i32=0;while(i<len){out[i]=pb[pa+i];i=i+1;}
        return len;
    }
    let cid:i32=iget(s.*.corps,id*4);
    let bo:i32=iget(coffs,(cid-1)*4);
    let bl:i32=iget(clens,(cid-1)*4);
    let off:i32=iget(s.*.offs,id*4);
    if((f & F_SHIFT)!=0){off=off+iget(s.*.shifts,id*4);}
    if(off<0){off=0;}
    if(off+len>bo+bl){len=bo+bl-off;}
    if(len<=0){return -1;}
    let i2:i32=0;while(i2<len){out[i2]=cbufs[bo+off+i2];i2=i2+1;}
    return len;
}
fn z1_kill(s:*Z1,id:i32,reason:i32) i32 {
    if(id<0 || id>=s.*.next_id){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,id*4);
    if((f & F_LIVE)==0){return -1;}
    iput(flags,id*4,f & (0-1-F_LIVE)); // clear live, keep occupied (tombstone)
    s.*.nlive=s.*.nlive-1;
    // push to freelist for ID reuse
    let fn_:[]u8=s.*.free_next;
    iput(fn_,id*4,s.*.free_head);
    s.*.free_head=id;
    z_led(s,OP_KILL,id,0,0,0,0,0,id,0,0,0,0,0,reason,0);
    return 0;
}
fn z1_pin(s:*Z1,id:i32) i32 {
    if(id<0 || id>=s.*.next_id){return -1;}
    let flags:[]u8=s.*.flags;
    iput(flags,id*4,iget(flags,id*4) | F_PIN);
    z_led(s,OP_PIN,id,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return 0;
}
fn z1_weaken(s:*Z1,id:i32,seq:i32) i32 {
    // Z1's documented weaken policy: weaken is processed as a management
    // annotation (sets WEAKENED flag, audited). It never changes stored bytes,
    // the witness, or pin status. Never silently ignored.
    if(id<0 || id>=s.*.next_id){
        z_led(s,OP_REFUSE,-1,1,0,0,0,0,id,0,0,0,0,0,RC_WEAKMISS,0);
        return -1;
    }
    let flags:[]u8=s.*.flags;
    iput(flags,id*4,iget(flags,id*4) | F_WEAK);
    z_led(s,OP_WEAKEN,id,0,0,0,0,0,id,0,0,0,0,0,seq,0);
    return 0;
}
fn z1_defect_boundary(s:*Z1,id:i32,delta:i32) i32 {
    // EXTERNAL trainer op: shift the recorded span
    if(id<0 || id>=s.*.next_id){return -1;}
    iput(s.*.shifts,id*4,delta);
    let flags:[]u8=s.*.flags;
    iput(flags,id*4,iget(flags,id*4) | F_SHIFT);
    z_led(s,OP_TDB,id,0,0,0,0,0,id,0,0,0,0,0,delta,0);
    return 0;
}
fn z1_defect_content(s:*Z1,id:i32,patch:[]u8,plen:i32) i32 {
    // EXTERNAL trainer op: record a byte patch the recall path must apply
    if(id<0 || id>=s.*.next_id){return -1;}
    let flags:[]u8=s.*.flags;
    if((iget(flags,id*4) & F_LIVE)==0){return -1;}
    if(s.*.pdata_n+plen>s.*.pdata_cap){return -1;}
    let at:i32=s.*.pdata_n;
    let pd:[]u8=s.*.pdata;
    let i:i32=0;while(i<plen){pd[at+i]=patch[i];i=i+1;}
    s.*.pdata_n=at+plen;
    iput(s.*.poff,id*4,at);iput(s.*.plen,id*4,plen);
    iput(flags,id*4,iget(flags,id*4) | F_PATCH);
    z_led(s,OP_TDC,id,0,0,0,0,0,id,plen,0,0,0,0,plen,0);
    return 0;
}
fn z1_revise(s:*Z1,cbufs:[]u8,coffs:[]u8,clens:[]u8,id:i32) i32 {
    // Deliberate repair against source: drop recorded shift/patch after
    // verifying the source bytes, then re-certify the witness by re-running the
    // challenge window on the repaired left boundary. Same ID + REVISE entry =
    // lineage (kill+re-add does NOT count). Returns 1 if repaired, 0 if clean.
    if(id<0 || id>=s.*.next_id){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,id*4);
    if((f & F_LIVE)==0){return -1;}
    if((f & (F_SHIFT | F_PATCH))==0){return 0;}
    let old_off:i32=iget(s.*.offs,id*4)+iget(s.*.shifts,id*4);
    iput(s.*.shifts,id*4,0);
    iput(s.*.poff,id*4,0);iput(s.*.plen,id*4,0);
    iput(flags,id*4,f & (0-1-F_SHIFT-F_PATCH));
    let new_off:i32=iget(s.*.offs,id*4);
    let new_len:i32=iget(s.*.lens,id*4);
    let cid:i32=iget(s.*.corps,id*4);
    let cbits:i32=0;let sflag:i32=0;
    if(new_off==0){sflag=1;}
    else{
        let bo:i32=iget(coffs,(cid-1)*4);let bl:i32=iget(clens,(cid-1)*4);
        cbits=z1_challenges(cbufs[bo..bo+bl],new_off,bl);
    }
    iput(s.*.witc,id*4,cbits);
    let wit:[]u8=nio_alloc(32);
    z1_witness(cid,new_off,new_len,cbits,sflag,wit);
    let wmem:[]u8=s.*.wit;let wb:i32=id*32;let q:i32=0;
    while(q<32){wmem[wb+q]=wit[q];q=q+1;}
    nio_free(wit);
    z_led(s,OP_REVISE,id,0,new_off,0,new_len,cid,id,cbits,Z1_VERSION,0,0,0,old_off,new_off);
    return 1;
}
fn z1_evict_oldest_unpinned(s:*Z1) i32 {
    // FIFO eviction of the oldest live unpinned unit. Returns evicted id or -1.
    let ins:[]u8=s.*.ins;let flags:[]u8=s.*.flags;
    while(s.*.ins_head<s.*.ins_n){
        let id:i32=iget(ins,s.*.ins_head*4);
        s.*.ins_head=s.*.ins_head+1;
        let f:i32=iget(flags,id*4);
        if((f & F_LIVE)!=0 && (f & F_PIN)==0){
            iput(flags,id*4,f & (0-1-F_LIVE));
            s.*.nlive=s.*.nlive-1;
            // push to freelist for ID reuse
            let fn_:[]u8=s.*.free_next;
            iput(fn_,id*4,s.*.free_head);
            s.*.free_head=id;
            z_led(s,OP_EVICT,id,0,0,0,0,0,id,0,0,0,0,0,1,0);
            return id;
        }
    }
    return -1;
}
fn z1_mark_valuable(s:*Z1,id:i32) i32 {
    z_led(s,OP_TMV,-1,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return z1_pin(s,id); // Z1's marking mechanism: pin
}

// ---- segmentation: the arm's own cut proposals through the challenge window ----
// Left-to-right pass over the Z1_GRID proposal grid. An accepted cut closes the
// open chunk (the cut survived: it becomes a chunk boundary). A refuted cut is
// regretted on the record (REFUSE entry with the challenge bitmask, reason
// 110+bits) and the open chunk extends past it (merge). Full coverage: every
// byte lands in exactly one chunk.
// z1_seg_spans: pure span computation (no store, no ledger).
fn z1_seg_spans(buf:[]u8,offs_out:[]u8,lens_out:[]u8,maxlen:*i32) i32 {
    let n:i32=buf.len;
    let start:i32=0;let c:i32=0;let ml:i32=0;
    let p:i32=Z1_GRID;
    while(p<n){
        if(z1_challenges(buf,p,n)==0){
            iput(offs_out,c*4,start);iput(lens_out,c*4,p-start);
            if(p-start>ml){ml=p-start;}
            c=c+1;start=p;
        }
        p=p+Z1_GRID;
    }
    iput(offs_out,c*4,start);iput(lens_out,c*4,n-start);
    if(n-start>ml){ml=n-start;}
    c=c+1;
    maxlen.*=ml;
    return c;
}
// z1_seg_ingest: segmentation pass with audit. ids_out[i] = unit ID of chunk i
// (dedup-stable across re-ingests). Returns the chunk count.
fn z1_seg_ingest(s:*Z1,buf:[]u8,cid:i32,ids_out:[]u8) i32 {
    let n:i32=buf.len;
    let start:i32=0;let c:i32=0;
    let p:i32=Z1_GRID;
    while(p<n){
        let cb:i32=z1_challenges(buf,p,n);
        if(cb==0){
            let id:i32=z1_ingest(s,buf,cid,start,p-start);
            iput(ids_out,c*4,id);c=c+1;start=p;
        }else{
            z_led(s,OP_REFUSE,-1,0,p,0,0,cid,-1,cb,Z1_VERSION,0,0,0,110+cb,0);
        }
        p=p+Z1_GRID;
    }
    let idf:i32=z1_ingest(s,buf,cid,start,n-start);
    iput(ids_out,c*4,idf);c=c+1;
    return c;
}

// ---- file IO ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    // nio_write_all caps at 1MB per call: chunk the write. O_EXCL: the file
    // must not exist (the runner uses a fresh workdir per mode).
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}
// ---- JSON emission (schema metrics-v1) ----
fn j_begin(mode:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"z1\",\"round\":\"r1\",\"scale\":\"1x\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    // print integer tenths as one-decimal, e.g. 1000 -> 100.0 ; -35 -> -3.5
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn p_dec2(hundredths:i64)void {
    // print integer hundredths as two-decimal, e.g. 219 -> 2.19
    if(hundredths<0){_zag_print("-");hundredths=0-hundredths;}
    let ip:i64=hundredths/100;let fp:i64=hundredths-(ip*100);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    if(fp<10){_zag_print("0");}
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn jf_dec2(f:*i32,key:[]u8,hundredths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec2(hundredths);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn jf_null(f:*i32,key:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":null");
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }

// ---- defect patch builders (frozen M4 conventions) ----
fn patch_prose_xor(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;
    while(i<len){
        let b:u8=buf[off+i];
        if(i%7==0){b=(b as i32 ^ 255) as u8;}
        out[i]=b;i=i+1;
    }
}
fn code_rename(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    // fixed-map identifier rename, same-length replacements, left-to-right
    let i:i32=0;while(i<len){out[i]=buf[off+i];i=i+1;}
    let p0:[]u8="sqlite3";let r0:[]u8="sqlite4";
    let p1:[]u8="SQLITE";let r1:[]u8="SQLITF";
    let p2:[]u8="Vdbe";let r2:[]u8="Vdbf";
    let p3:[]u8="Mem";let r3:[]u8="Mfm";
    let p4:[]u8="pBt";let r4:[]u8="pBu";
    let k:i32=0;
    while(k<5){
        let pat:[]u8=p0;let rep:[]u8=r0;
        if(k==1){pat=p1;rep=r1;}
        if(k==2){pat=p2;rep=r2;}
        if(k==3){pat=p3;rep=r3;}
        if(k==4){pat=p4;rep=r4;}
        let pl:i32=pat.len;
        let pos:i32=0;
        while(pos+pl<=len){
            let m:i32=1;let q:i32=0;
            while(q<pl){if(out[pos+q]!=pat[q]){m=0;break;}q=q+1;}
            if(m==1){q=0;while(q<pl){out[pos+q]=rep[q];q=q+1;}pos=pos+pl;}
            else{pos=pos+1;}
        }
        k=k+1;
    }
}
// verify a unit is fully repaired: live, no shift/patch flags, bytes == source
fn z1_unit_verified(s:*Z1,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,
                    soffs:[]u8,slens:[]u8,ids:[]u8,idx:i32,bout:[]u8) i32 {
    let id:i32=iget(ids,idx*4);
    if(id<0 || id>=s.*.next_id){return 0;}
    let f:i32=iget(s.*.flags,id*4);
    if((f & F_LIVE)==0){return 0;}
    if((f & (F_SHIFT | F_PATCH))!=0){return 0;}
    let off:i32=iget(soffs,idx*4);let len:i32=iget(slens,idx*4);
    let rl:i32=z1_recall(s,cbufs,coffs,clens,id,bout);
    if(rl!=len){return 0;}
    let i:i32=0;while(i<len){if(bout[i]!=buf[off+i]){return 0;}i=i+1;}
    return 1;
}

// registry: 8 corpus slots, indexed (corpus_id-1)
fn reg_set(coffs:[]u8,clens:[]u8,corpus:i32,base:i32,len:i32) void {
    iput(coffs,(corpus-1)*4,base);iput(clens,(corpus-1)*4,len);
}

// probe: recall every unit via the ID path; byte-diff vs source; boundary check
// (row span == segmentation span, live, no recorded shift).
fn z1_probe(s:*Z1,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,
            soffs:[]u8,slens:[]u8,ids:[]u8,n:i32,bout:[]u8,cok:*i32,bok:*i32) void {
    let ok:i32=0;let bo:i32=0;
    let i:i32=0;
    while(i<n){
        let id:i32=iget(ids,i*4);
        let off:i32=iget(soffs,i*4);let len:i32=iget(slens,i*4);
        let rl:i32=z1_recall(s,cbufs,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let j:i32=0;
            while(j<len){if(bout[j]!=buf[off+j]){good=0;break;}j=j+1;}
            if(good==1){ok=ok+1;}
        }
        if(id>=0 && id<s.*.next_id){
            let f:i32=iget(s.*.flags,id*4);
            if((f & F_LIVE)!=0 && iget(s.*.offs,id*4)==off &&
               iget(s.*.lens,id*4)==len && (f & F_SHIFT)==0){bo=bo+1;}
        }
        i=i+1;
    }
    if(n>0){cok.*=ok*1000/n;bok.*=bo*1000/n;}else{cok.*=0;bok.*=0;}
}

// ---- M1: single-corpus perfect-recall + ID-arm swap probe (A15 provisional) ----
fn t_m1(cdir:[]u8,fname:[]u8,corpus:i32,keyp:[]u8,jmode:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M1,FATAL,empty-corpus");return;}
    let cap:i32=buf.len/Z1_GRID+2048;
    let ledcap:i32=120000;
    if(corpus==Z1_C_CODE){ledcap=200000;}
    let s:Z1=z1_new(cap,ledcap,cap+2048,0,65536);
    let spancap:i32=buf.len/Z1_GRID+2;
    let soffs:[]u8=halloc(&s,spancap*4);
    let slens:[]u8=halloc(&s,spancap*4);
    let ids:[]u8=halloc(&s,spancap*4);
    let maxlen:i32=0;
    z1_seg_spans(buf,soffs,slens,&maxlen);
    let n:i32=z1_seg_ingest(&s,buf,corpus,ids);
    let bout:[]u8=halloc(&s,maxlen);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    let cok:i32=0;let bok:i32=0;
    z1_probe(&s,buf,coffs,clens,buf,soffs,slens,ids,n,bout,&cok,&bok);
    // A15 swap probe (PROVISIONAL-PENDING-FREEZE): after every ceil(n/64)
    // recalls, patch the ID table so the next recall target resolves to
    // (slot+1)%nslots; the arm must return the remapped content (PASS) or fail
    // loudly. Returning the original content despite the remap = side channel.
    let interval:i32=(n+63)/64;if(interval<1){interval=1;}
    let probe_ok:i32=0;let probe_n:i32=0;
    let i:i32=0;
    while(i<n){
        if((i+1)%interval==0){
            let ti:i32=(i+1)%n;
            let ri:i32=(ti+1)%n;
            let tgt:i32=iget(ids,ti*4);let rtgt:i32=iget(ids,ri*4);
            let roff:i32=iget(soffs,ri*4);let rlen:i32=iget(slens,ri*4);
            // patch row[tgt] to resolve like row[rtgt]
            let sv_off:i32=iget(s.offs,tgt*4);
            let sv_len:i32=iget(s.lens,tgt*4);
            let sv_cor:i32=iget(s.corps,tgt*4);
            iput(s.offs,tgt*4,iget(s.offs,rtgt*4));
            iput(s.lens,tgt*4,iget(s.lens,rtgt*4));
            iput(s.corps,tgt*4,iget(s.corps,rtgt*4));
            z_led(&s,OP_TSP,tgt,0,0,0,0,0,tgt,0,0,0,0,0,rtgt,probe_n);
            let rl:i32=z1_recall(&s,buf,coffs,clens,tgt,bout);
            if(rl==rlen){
                let good:i32=1;let q2:i32=0;
                while(q2<rlen){if(bout[q2]!=buf[roff+q2]){good=0;break;}q2=q2+1;}
                if(good==1){probe_ok=probe_ok+1;}
            }
            probe_n=probe_n+1;
            // restore
            iput(s.offs,tgt*4,sv_off);iput(s.lens,tgt*4,sv_len);iput(s.corps,tgt*4,sv_cor);
        }
        i=i+1;
    }
    let idprobe:[]u8="PASS (A15 provisional)";
    if(probe_ok!=probe_n){idprobe="FAIL (side channel)";}
    _zag_print("M1,");_zag_print(fname);_zag_print(",");
    p_dec1(cok as i64);_zag_print(",");p_dec1(bok as i64);
    _zag_print(",");p_i64(n as i64);
    _zag_print(",");_zag_print(idprobe);_zag_println("");
    let f:i32=0;
    j_begin(jmode);
    jf_dec1(&f,"m1_recall_tenths",cok as i64);
    jf_dec1(&f,"m1_boundary_tenths",bok as i64);
    jf_int(&f,"m1_units",n as i64);
    jf_str(&f,"m1_corpus",keyp);
    jf_str(&f,"m1_id_probe",idprobe);
    jf_int(&f,"m1_id_probe_n",probe_n as i64);
    jf_int(&f,"m1_id_probe_ok",probe_ok as i64);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,soffs);hfree(&s,slens);hfree(&s,ids);
}

// ---- M2: tiered curriculum (returns ETC; censored at 50) + M9 for t1 ----
fn t_m2(cdir:[]u8,fname:[]u8,corpus:i32,tier:[]u8,do_m9:i32,ledcap:i32) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M2,FATAL,empty-corpus");return;}
    let cap:i32=buf.len/Z1_GRID+2048;
    let s:Z1=z1_new(cap,ledcap,cap+2048,65536,65536);
    let spancap:i32=buf.len/Z1_GRID+2;
    let soffs:[]u8=halloc(&s,spancap*4);
    let slens:[]u8=halloc(&s,spancap*4);
    let ids:[]u8=halloc(&s,spancap*4);
    let maxlen:i32=0;
    z1_seg_spans(buf,soffs,slens,&maxlen);
    let bout:[]u8=halloc(&s,maxlen);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    // episode 0 probe on empty store
    let cok:i32=0;let bok:i32=0;
    z1_probe(&s,buf,coffs,clens,buf,soffs,slens,ids,0,bout,&cok,&bok);
    let r0:i64=cok as i64;
    let rs:[]u8=halloc(&s,51*4);
    iput(rs,0,cok);
    let e:i32=1;let consec:i32=0;let etc:i32=50;let nep:i32=1;
    let rc:i32=cok;let bc:i32=bok;
    while(e<=50){
        let nn:i32=z1_seg_ingest(&s,buf,corpus,ids);
        z1_probe(&s,buf,coffs,clens,buf,soffs,slens,ids,nn,bout,&cok,&bok);
        iput(rs,e*4,cok);
        nep=e+1;
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e;rc=cok;bc=bok;break;}
        rc=cok;bc=bok;
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");
    p_i64(censored as i64);_zag_print(",");
    p_dec1(r0);_zag_println("");
    let f:i32=0;
    j_begin(tier);
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",r0);
    jf_dec1(&f,"m2_final_recall_tenths",rc as i64);
    jf_dec1(&f,"m2_final_boundary_tenths",bc as i64);
    if(do_m9==1){
        let npts:i32=nep;
        let takeoff:i32=npts;
        let e2:i32=0;
        while(e2<npts){
            if(iget(rs,e2*4)>=500){takeoff=e2;break;}
            e2=e2+1;
        }
        let steep:i64=0;
        e2=1;
        while(e2<npts){
            let jmp:i64=(iget(rs,e2*4)-iget(rs,(e2-1)*4)) as i64;
            if(jmp>steep){steep=jmp;}
            e2=e2+1;
        }
        let etc_idx:i32=etc;
        if(etc_idx>=npts){etc_idx=npts-1;}
        let to_idx:i32=takeoff;
        if(to_idx>=npts){to_idx=npts-1;}
        let late:i64=(iget(rs,etc_idx*4)-iget(rs,to_idx*4)) as i64;
        let shape:[]u8="other";
        if(steep>=400 && late<=150){shape="fast-then-flat";}
        else{
            if(takeoff>=3 && steep>=400){shape="slow-then-sudden";}
            else{
                if(steep<400){shape="gradual";}
            }
        }
        jf_str(&f,"m9_shape",shape);
        jf_int(&f,"m9_takeoff_ep",takeoff as i64);
        jf_dec1(&f,"m9_steepness_tenths",steep);
        jf_dec1(&f,"m9_late_gain_tenths",late);
        j_end();
        _zag_print("M9,");_zag_print(tier);_zag_print(",");
        _zag_print(shape);_zag_println("");
    }
    if(do_m9==0){
        j_end();
    }
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);hfree(&s,rs);
    hfree(&s,soffs);hfree(&s,slens);hfree(&s,ids);
}

// ---- M3: strength trial ----
fn t_m3(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M3,FATAL,empty-corpus");return;}
    // segment both corpora to define the V index space (prose chunks, then code)
    let spancap_p:i32=prose.len/Z1_GRID+2;
    let spancap_c:i32=code.len/Z1_GRID+2;
    let s:Z1=z1_new(Z1_M3_CAP,32768,16384,0,65536);
    let poffs:[]u8=halloc(&s,spancap_p*4);let plens:[]u8=halloc(&s,spancap_p*4);
    let coffs2:[]u8=halloc(&s,spancap_c*4);let clens2:[]u8=halloc(&s,spancap_c*4);
    let ml:i32=0;
    let np:i32=z1_seg_spans(prose,poffs,plens,&ml);
    let ml2:i32=0;
    let nc:i32=z1_seg_spans(code,coffs2,clens2,&ml2);
    if(ml2>ml){ml=ml2;}
    let bout:[]u8=halloc(&s,ml);
    let cbufs:[]u8=halloc(&s,prose.len+code.len+fresh.len);
    let cofs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    let i:i32=0;while(i<prose.len){cbufs[i]=prose[i];i=i+1;}
    let j2:i32=0;while(j2<code.len){cbufs[prose.len+j2]=code[j2];j2=j2+1;}
    let j3:i32=0;while(j3<fresh.len){cbufs[prose.len+code.len+j3]=fresh[j3];j3=j3+1;}
    reg_set(cofs,clens,Z1_C_PROSE,0,prose.len);
    reg_set(cofs,clens,Z1_C_CODE,prose.len,code.len);
    reg_set(cofs,clens,Z1_C_FRESH,prose.len+code.len,fresh.len);
    let total:i32=np+nc;
    let k:i32=total/Z1_M3_V;
    if(k<1){k=1;}
    // V: ingest every k-th chunk span, mark valuable (pin)
    let v_ids:[]u8=halloc(&s,Z1_M3_V*4);
    let v:i32=0;
    while(v<Z1_M3_V){
        let g:i32=v*k;
        let cid:i32=Z1_C_PROSE;let gi:i32=g;
        let buf:[]u8=prose;let so:[]u8=poffs;let sl:[]u8=plens;
        if(g>=np){cid=Z1_C_CODE;gi=g-np;buf=code;so=coffs2;sl=clens2;}
        let id:i32=z1_ingest(&s,buf,cid,iget(so,gi*4),iget(sl,gi*4));
        z1_mark_valuable(&s,id);
        iput(v_ids,v*4,id);
        v=v+1;
    }
    // phase 1: 3000 fresh ingests (64B protocol spans)
    let fresh_ids:[]u8=halloc(&s,7000*4);
    let f:i32=0;
    while(f<Z1_M3_FRESH1){
        let id:i32=z1_ingest(&s,fresh,Z1_C_FRESH,f*64,64);
        iput(fresh_ids,f*4,id);
        f=f+1;
    }
    let n_p1:i32=s.led_n;
    // phase 2: 3000 fresh-only kills
    f=0;
    while(f<Z1_M3_KILL){
        z1_kill(&s,iget(fresh_ids,f*4),1);
        f=f+1;
    }
    // weaken probe: 50 weaken ops on every 20th valuable (documented policy)
    let w:i32=0;let w_ok:i32=0;
    while(w<50){
        let vj:i32=w*20;
        if(z1_weaken(&s,iget(v_ids,vj*4),w+1)==0){w_ok=w_ok+1;}
        w=w+1;
    }
    let n_p2:i32=s.led_n;
    // phase 3: 4000 ingests at capacity, evict-oldest-unpinned as needed
    f=Z1_M3_FRESH1;
    while(f<Z1_M3_FRESH1+Z1_M3_FRESH2){
        let dummy:i32=0;
        let id:i32=z1_insert(&s,fresh,Z1_C_FRESH,f*64,64,&dummy);
        if(id<0){
            z1_evict_oldest_unpinned(&s);
            id=z1_insert(&s,fresh,Z1_C_FRESH,f*64,64,&dummy);
        }
        if(id>=0){
            let wmem:[]u8=s.wit;let wb:i32=id*32;
            z_led(&s,OP_ADD,id,0,f*64,0,64,Z1_C_FRESH,id,
                  iget(s.witc,id*4),Z1_VERSION,0,0,0,iget(wmem,wb),iget(wmem,wb+4));
            iput(fresh_ids,f*4,id);
        }else{
            z_led(&s,OP_REFUSE,-1,1,f*64,0,64,Z1_C_FRESH,-1,0,0,0,0,0,RC_EVICTFAIL,0);
            iput(fresh_ids,f*4,-1);
        }
        f=f+1;
    }
    let n_p3:i32=s.led_n;
    // metrics: survival = M1-recall on V
    let surv_ok:i32=0;
    v=0;
    while(v<Z1_M3_V){
        let id:i32=iget(v_ids,v*4);
        let g:i32=v*k;
        let cid2:i32=Z1_C_PROSE;let gi:i32=g;
        let buf2:[]u8=prose;let so2:[]u8=poffs;let sl2:[]u8=plens;
        if(g>=np){cid2=Z1_C_CODE;gi=g-np;buf2=code;so2=coffs2;sl2=clens2;}
        let off:i32=iget(so2,gi*4);let len:i32=iget(sl2,gi*4);
        let rl:i32=z1_recall(&s,cbufs,cofs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=buf2[off+q]){good=0;break;}q=q+1;}
            if(good==1){surv_ok=surv_ok+1;}
        }
        v=v+1;
    }
    let surv:i64=(surv_ok as i64)*1000/(Z1_M3_V as i64);
    // fresh sample: last 500 ingested (f=6500..6999)
    let fs_ok:i32=0;
    f=Z1_M3_FRESH1+Z1_M3_FRESH2-500;
    while(f<Z1_M3_FRESH1+Z1_M3_FRESH2){
        let id:i32=iget(fresh_ids,f*4);
        let off:i32=f*64;let len:i32=64;
        if(off+len>fresh.len){len=fresh.len-off;}
        let rl:i32=z1_recall(&s,cbufs,cofs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=fresh[off+q]){good=0;break;}q=q+1;}
            if(good==1){fs_ok=fs_ok+1;}
        }
        f=f+1;
    }
    let fresht:i64=(fs_ok as i64)*1000/500;
    // liveness: management ops in ledger entries [n_p1, n_p3)
    let mgmt:i32=0;let le:i32=n_p1;
    while(le<n_p3){
        let op:i32=iget(s.led,le*64);
        if(op==OP_ADD || op==OP_KILL || op==OP_PIN || op==OP_WEAKEN ||
           op==OP_PROMOTE || op==OP_EVICT || op==OP_REFUSE){mgmt=mgmt+1;}
        le=le+1;
    }
    let freeze:i32=0;
    if(surv>=900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    if(w_ok<50){freeze=1;}
    let fz:[]u8="CLEAR";
    if(freeze==1){fz="FROZEN-UNDER-PRESSURE";}
    _zag_print("M3,");
    p_dec1(surv);_zag_print(",");p_dec1(fresht);_zag_print(",");
    p_i64(mgmt as i64);_zag_print(",");p_i64(w_ok as i64);_zag_print(",");
    _zag_println(fz);
    let ff:i32=0;
    j_begin("m3-1x");
    jf_dec1(&ff,"m3_survival_tenths",surv);
    jf_dec1(&ff,"m3_fresh_recall_tenths",fresht);
    jf_int(&ff,"m3_mgmt_entries",mgmt as i64);
    jf_int(&ff,"m3_weaken_handled",w_ok as i64);
    jf_str(&ff,"m3_freeze",fz);
    jf_int(&ff,"m3_valuable",Z1_M3_V as i64);
    j_end();
    hfree(&s,bout);hfree(&s,cbufs);hfree(&s,cofs);hfree(&s,clens);
    hfree(&s,v_ids);hfree(&s,fresh_ids);
    hfree(&s,poffs);hfree(&s,plens);hfree(&s,coffs2);hfree(&s,clens2);
}

// ---- M4: defect revision ----
fn t_m4(cdir:[]u8,fname:[]u8,corpus:i32,is_code:i32,keyp:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M4,FATAL,empty-corpus");return;}
    let cap:i32=buf.len/Z1_GRID+2048;
    let ledcap:i32=120000;
    if(is_code==1){ledcap=200000;}
    let s:Z1=z1_new(cap,ledcap,cap+2048,0,4194304);
    let spancap:i32=buf.len/Z1_GRID+2;
    let soffs:[]u8=halloc(&s,spancap*4);
    let slens:[]u8=halloc(&s,spancap*4);
    let ids:[]u8=halloc(&s,spancap*4);
    let maxlen:i32=0;
    z1_seg_spans(buf,soffs,slens,&maxlen);
    let n:i32=z1_seg_ingest(&s,buf,corpus,ids);
    let bout:[]u8=halloc(&s,maxlen);
    let patch:[]u8=halloc(&s,maxlen);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    let d_idx:[]u8=halloc(&s,Z1_M4_N*4);
    // plant: 100 boundary (j<100), 100 content (j>=100)
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    let j:i32=0;
    while(j<Z1_M4_N){
        let idx:i32=j*n/Z1_M4_N;
        iput(d_idx,j*4,idx);
        let id:i32=iget(ids,idx*4);
        if(j<100){
            z1_defect_boundary(&s,id,iget(cyc,(j%12)*4));
        }else{
            let off:i32=iget(soffs,idx*4);let len:i32=iget(slens,idx*4);
            if(is_code==1){code_rename(buf,off,len,patch);}
            else{patch_prose_xor(buf,off,len,patch);}
            z1_defect_content(&s,id,patch,len);
        }
        j=j+1;
    }
    // revision episodes
    let rep_b:i32=0;let rep_c:i32=0;
    let ep:i32=1;
    while(ep<=20){
        j=0;
        while(j<Z1_M4_N){
            let idx2:i32=iget(d_idx,j*4);
            z1_revise(&s,buf,coffs,clens,iget(ids,idx2*4));
            j=j+1;
        }
        rep_b=0;rep_c=0;
        j=0;
        while(j<100){
            rep_b=rep_b+z1_unit_verified(&s,buf,coffs,clens,buf,soffs,slens,ids,iget(d_idx,j*4),bout);
            j=j+1;
        }
        j=100;
        while(j<Z1_M4_N){
            rep_c=rep_c+z1_unit_verified(&s,buf,coffs,clens,buf,soffs,slens,ids,iget(d_idx,j*4),bout);
            j=j+1;
        }
        if(rep_b+rep_c>=Z1_M4_N){break;}
        ep=ep+1;
    }
    // classify kills
    let killed:i32=0;
    j=0;
    while(j<Z1_M4_N){
        let id:i32=iget(ids,iget(d_idx,j*4)*4);
        if(id<0 || id>=s.next_id){killed=killed+1;}
        else{
            let f:i32=iget(s.flags,id*4);
            if((f & F_LIVE)==0){killed=killed+1;}
        }
        j=j+1;
    }
    let rev_bt:i64=(rep_b as i64)*1000/100;
    let rev_ct:i64=(rep_c as i64)*1000/100;
    let kill_t:i64=(killed as i64)*1000/(Z1_M4_N as i64);
    let ksub:i32=0;
    if(kill_t>500 && (rev_bt<800 || rev_ct<800)){ksub=1;}
    _zag_print("M4,");_zag_print(keyp);_zag_print(",");
    p_dec1(rev_bt);_zag_print(",");p_dec1(rev_ct);_zag_print(",");
    p_dec1(kill_t);_zag_print(",");p_i64(ksub as i64);_zag_println("");
    let f:i32=0;
    j_begin(keyp);
    jf_dec1(&f,"m4_rev_boundary_tenths",rev_bt);
    jf_dec1(&f,"m4_rev_content_tenths",rev_ct);
    jf_dec1(&f,"m4_kill_rate_tenths",kill_t);
    jf_bool(&f,"m4_killsub",ksub);
    jf_int(&f,"m4_episodes",ep as i64);
    j_end();
    hfree(&s,bout);hfree(&s,patch);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,cyc);hfree(&s,d_idx);
    hfree(&s,soffs);hfree(&s,slens);hfree(&s,ids);
}

// ---- M5: resource pressure ----
fn t_m5(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0){_zag_println("M5,FATAL,empty-corpus");return;}
    let cap:i32=prose.len/Z1_GRID+2048;
    let s:Z1=z1_new(cap,120000,cap+2048,0,65536);
    let spancap:i32=prose.len/Z1_GRID+2;
    let soffs:[]u8=halloc(&s,spancap*4);
    let slens:[]u8=halloc(&s,spancap*4);
    let ids:[]u8=halloc(&s,spancap*4);
    let maxlen:i32=0;
    z1_seg_spans(prose,soffs,slens,&maxlen);
    let n:i32=z1_seg_ingest(&s,prose,Z1_C_PROSE,ids);
    let bout:[]u8=halloc(&s,maxlen);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,Z1_C_PROSE,0,prose.len);
    reg_set(coffs,clens,Z1_C_FRESH,0,fresh.len);
    // mini-pressure: 500 fresh ingests + 500 kills
    let fresh_ids:[]u8=halloc(&s,500*4);
    let f2:i32=0;
    while(f2<500){
        iput(fresh_ids,f2*4,z1_ingest(&s,fresh,Z1_C_FRESH,f2*64,64));
        f2=f2+1;
    }
    f2=0;
    while(f2<500){z1_kill(&s,iget(fresh_ids,f2*4),2);f2=f2+1;}
    // learned = byte-exact recall now
    let l:i32=0;let src:i64=0;
    let i2:i32=0;
    while(i2<n){
        let id:i32=iget(ids,i2*4);
        let off:i32=iget(soffs,i2*4);let len:i32=iget(slens,i2*4);
        let rl:i32=z1_recall(&s,prose,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=prose[off+q]){good=0;break;}q=q+1;}
            if(good==1){l=l+1;src=src+(len as i64);}
        }
        i2=i2+1;
    }
    // slot table = row arrays (68 B/row: 7x u32 + 32B witness + 2x u32 witv/witc)
    //           + insertion queue (4 B/entry) + patch-data region (itemized)
    let slot_bytes:i64=(s.cap as i64)*68+(s.ins_cap as i64)*4+(s.pdata_cap as i64);
    let ledger_bytes:i64=(s.led_n as i64)*64;
    let wf:i32=write_file(".","ledger.bin",s.led[0..s.led_n*64]);
    _zag_print("M5,");p_i64(l as i64);_zag_print(",");
    p_i64(src);_zag_print(",");p_i64(slot_bytes);_zag_print(",");
    p_i64(ledger_bytes);_zag_print(",");p_i64(wf as i64);_zag_println("");
    let ff:i32=0;
    j_begin("m5-1x");
    jf_int(&ff,"m5_units_learned",l as i64);
    jf_int(&ff,"m5_source_bytes_learned",src);
    jf_int(&ff,"m5_slot_table_bytes",slot_bytes);
    jf_int(&ff,"m5_ledger_bytes",ledger_bytes);
    jf_int(&ff,"m5_ledger_entries",s.led_n as i64);
    jf_int(&ff,"m5_corpus_buffer_bytes",prose.len as i64);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,soffs);hfree(&s,slens);hfree(&s,ids);hfree(&s,fresh_ids);
}

// ---- M6: transfer tax ----
fn t_m6(cdir:[]u8,dir:i32) void {
    // dir 0 = prose->code, 1 = code->prose
    let tname:[]u8="t1_prose.bin";let tcid:i32=Z1_C_T1P;
    let yname:[]u8="code.bin";let ycid:i32=Z1_C_CODE;
    let dkey:[]u8="m6-p2c-1x";let dtag:[]u8="p2c";
    let tled:i32=60000;let yled:i32=200000;
    if(dir==1){
        tname="t1_code.bin";tcid=Z1_C_T1C;yname="prose.bin";ycid=Z1_C_PROSE;
        dkey="m6-c2p-1x";dtag="c2p";
        tled=80000;yled=120000;
    }
    let tbuf:[]u8=read_file(cdir,tname);
    let ybuf:[]u8=read_file(cdir,yname);
    if(tbuf.len==0 || ybuf.len==0){_zag_println("M6,FATAL,empty-corpus");return;}
    let tcap:i32=tbuf.len/Z1_GRID+2048;
    let ycap:i32=ybuf.len/Z1_GRID+2048;
    let s:Z1=z1_new(tcap+ycap,tled+yled,tcap+ycap+4096,65536,65536);
    let tspancap:i32=tbuf.len/Z1_GRID+2;
    let yspancap:i32=ybuf.len/Z1_GRID+2;
    let toffs:[]u8=halloc(&s,tspancap*4);let tlens:[]u8=halloc(&s,tspancap*4);
    let tids:[]u8=halloc(&s,tspancap*4);
    let yoffs:[]u8=halloc(&s,yspancap*4);let ylens:[]u8=halloc(&s,yspancap*4);
    let yids:[]u8=halloc(&s,yspancap*4);
    let ml:i32=0;
    z1_seg_spans(tbuf,toffs,tlens,&ml);
    let ml2:i32=0;
    z1_seg_spans(ybuf,yoffs,ylens,&ml2);
    if(ml2>ml){ml=ml2;}
    let bout:[]u8=halloc(&s,ml);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,tcid,0,tbuf.len);
    reg_set(coffs,clens,ycid,0,ybuf.len);
    // train on tier-1 to the M2 criterion (policy frozen afterwards: the
    // challenge set is a build-time constant, so freezing is a no-op)
    let cok:i32=0;let bok:i32=0;
    let e:i32=1;let consec:i32=0;
    let nt:i32=0;
    while(e<=50){
        nt=z1_seg_ingest(&s,tbuf,tcid,tids);
        z1_probe(&s,tbuf,coffs,clens,tbuf,toffs,tlens,tids,nt,bout,&cok,&bok);
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){break;}
        e=e+1;
    }
    let rec_d:i64=cok as i64;let bnd_d:i64=bok as i64;
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    // in-domain revision: 100 boundary defects on train units
    let j:i32=0;
    while(j<100){
        let idx:i32=j*nt/100;
        z1_defect_boundary(&s,iget(tids,idx*4),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        z1_revise(&s,tbuf,coffs,clens,iget(tids,(j*nt/100)*4));
        j=j+1;
    }
    let rev_d:i32=0;
    j=0;
    while(j<100){
        rev_d=rev_d+z1_unit_verified(&s,tbuf,coffs,clens,tbuf,toffs,tlens,tids,j*nt/100,bout);
        j=j+1;
    }
    let rev_dt:i64=(rev_d as i64)*10;
    // transfer: face the new domain (ingest allowed, policy frozen)
    let ny:i32=z1_seg_ingest(&s,ybuf,ycid,yids);
    let rec_t:i32=0;let bnd_t:i32=0;
    z1_probe(&s,ybuf,coffs,clens,ybuf,yoffs,ylens,yids,ny,bout,&rec_t,&bnd_t);
    // transfer revision
    j=0;
    while(j<100){
        let idx:i32=j*ny/100;
        z1_defect_boundary(&s,iget(yids,idx*4),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        z1_revise(&s,ybuf,coffs,clens,iget(yids,(j*ny/100)*4));
        j=j+1;
    }
    let rev_t:i32=0;
    j=0;
    while(j<100){
        rev_t=rev_t+z1_unit_verified(&s,ybuf,coffs,clens,ybuf,yoffs,ylens,yids,j*ny/100,bout);
        j=j+1;
    }
    let rev_tt:i64=(rev_t as i64)*10;
    let tax:i64=((rec_d-(rec_t as i64))+((bnd_d-(bnd_t as i64)))+(rev_dt-rev_tt))/3;
    _zag_print("M6,");_zag_print(dtag);_zag_print(",");
    p_dec1(rec_t as i64);_zag_print(",");p_dec1(bnd_t as i64);_zag_print(",");
    p_dec1(rev_tt);_zag_print(",");p_dec1(tax);_zag_println("");
    let f:i32=0;
    j_begin(dkey);
    let g:i32=0;
    jf_dec1(&g,"rec_tenths",rec_t as i64);
    jf_dec1(&g,"bnd_tenths",bnd_t as i64);
    jf_dec1(&g,"rev_tenths",rev_tt);
    jf_dec1(&g,"tax_tenths",tax);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);hfree(&s,cyc);
    hfree(&s,toffs);hfree(&s,tlens);hfree(&s,tids);
    hfree(&s,yoffs);hfree(&s,ylens);hfree(&s,yids);
}

// ---- M7: ID-arm cache rig ----
// Z1 IS an ID arm (recall resolves through the persistent ID->row mapping).
// Round 1: ingest C (prose). Round 2: ingest C again (dedup -> same IDs).
// Round 3: C' = C with deterministic every-100th-unit edits, implemented with
// the harness validator's convention (first-byte XOR 0xFF, recorded as an
// external trainer content defect, audited) — PROVISIONAL per AMBIGUITIES A7.
// Lookup schedule (l*37)%nunits, 1666 after round 2 then 3334 after round 3 —
// the validator's schedule, PROVISIONAL per AMBIGUITIES A8.
fn t_m7(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("M7,FATAL,empty-corpus");return;}
    let cap:i32=prose.len/Z1_GRID+2048;
    let s:Z1=z1_new(cap,120000,cap+2048,65536,4194304);
    let spancap:i32=prose.len/Z1_GRID+2;
    let soffs:[]u8=halloc(&s,spancap*4);
    let slens:[]u8=halloc(&s,spancap*4);
    let ids:[]u8=halloc(&s,spancap*4);
    let maxlen:i32=0;
    z1_seg_spans(prose,soffs,slens,&maxlen);
    let bout:[]u8=halloc(&s,maxlen);
    let patch:[]u8=halloc(&s,maxlen);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,Z1_C_PROSE,0,prose.len);
    // round 1: ingest C
    let n:i32=z1_seg_ingest(&s,prose,Z1_C_PROSE,ids);
    let distinct_r1:i32=s.next_id;
    // round 2: ingest C again -> dedup resolves to the same IDs
    let n2:i32=z1_seg_ingest(&s,prose,Z1_C_PROSE,ids);
    let reread:i64=0;
    let hits:i32=0;
    let l:i32=0;
    while(l<1666){
        let idx:i32=(l*37)%n;
        let rl:i32=z1_recall(&s,prose,coffs,clens,iget(ids,idx*4),bout);
        if(rl>0){reread=reread+(rl as i64);hits=hits+1;}
        l=l+1;
    }
    // round 3: C' edits (validator convention: first-byte XOR 0xFF, audited)
    let q:i32=0;
    while(q<n){
        if(q%100==0){
            let id:i32=iget(ids,q*4);
            let off:i32=iget(soffs,q*4);let len:i32=iget(slens,q*4);
            let a:i32=0;
            while(a<len){patch[a]=prose[off+a];a=a+1;}
            patch[0]=(patch[0] as i32 ^ 255) as u8;
            z1_defect_content(&s,id,patch,len);
        }
        q=q+1;
    }
    while(l<Z1_M7_LOOKUPS){
        let idx:i32=(l*37)%n;
        let rl:i32=z1_recall(&s,prose,coffs,clens,iget(ids,idx*4),bout);
        if(rl>0){reread=reread+(rl as i64);hits=hits+1;}
        l=l+1;
    }
    let hit_t:i64=(hits as i64)*1000/(Z1_M7_LOOKUPS as i64);
    let nlive:i64=s.nlive as i64;
    let reuse_hund:i64=0;
    if(nlive>0){reuse_hund=(s.id_refs*100)/nlive;}
    // dedup over rounds 1-2: 1 - distinct/total ingested
    let total_ing:i64=(n as i64)+(n2 as i64);
    let dedup_t:i64=0;
    if(total_ing>0){dedup_t=(1000-((distinct_r1 as i64)*1000)/total_ing);}
    let saved_units:i64=total_ing-(distinct_r1 as i64);
    let dedup_bytes:i64=0;
    if(n>0){dedup_bytes=(saved_units*(prose.len as i64))/(n as i64);}
    _zag_print("M7,id,");p_dec1(hit_t);_zag_print(",");
    p_dec2(reuse_hund);_zag_print(",");p_dec1(dedup_t);_zag_println("");
    let f:i32=0;
    j_begin("m7-1x");
    jf_dec1(&f,"m7_hit_rate_tenths",hit_t);
    jf_dec2(&f,"m7_reuse_rate_hundredths",reuse_hund);
    jf_int(&f,"m7_dedup_savings_bytes",dedup_bytes);
    jf_dec1(&f,"m7_dedup_ratio_tenths",dedup_t);
    jf_null(&f,"m7_na_reason");
    jf_int(&f,"m7_reread_bytes",reread);
    jf_int(&f,"m7_units",n as i64);
    j_end();
    hfree(&s,bout);hfree(&s,patch);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,soffs);hfree(&s,slens);hfree(&s,ids);
}

// ---- M8: determinism gate ----
fn z1_heap_perturb(pert:[]u8) []u8 {
    // Raw heap perturbation, bypassing the arm's logged trace (the trace must
    // capture only the arm's own allocations, identical across perturbations).
    // Stdout and artifacts are perturbation-agnostic by construction.
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            // survivors leak intentionally: freed by OS at exit; identical each run
            i=i+1;
        }
    }
    if(_zag_strcmp(pert,"aslr")==1){
        return nio_alloc(1234567);
    }
    // freelist/starve: accepted no-ops (id-derived placement; no clock/entropy)
    return "";
}
// text builder into a pre-sized buffer (caps computed from counts; no growth)
fn tb_c(b:[]u8,n:*i32,c:u8) void { b[n.*]=c;n.*=n.*+1; }
fn tb_s(b:[]u8,n:*i32,s:[]u8) void {
    let i:i32=0;while(i<s.len){b[n.*]=s[i];n.*=n.*+1;i=i+1;} }
fn tb_i(b:[]u8,n:*i32,v:i64) void {
    let s:[]u8=_zag_i64_to_str(v);tb_s(b,n,s);nio_free(s); }
fn tb_h(b:[]u8,n:*i32,h:[]u8) void {
    let d:[]u8="0123456789abcdef";
    let i:i32=0;
    while(i<h.len){let v:i32=h[i] as i32;tb_c(b,n,d[v/16]);tb_c(b,n,d[v%16]);i=i+1;} }
fn z1_entry_image(s:*Z1,e:i32,out:[]u8) void {
    let i:i32=0;
    while(i<16){iput(out,i*4,iget(s.*.led,e*64+i*4));i=i+1;} }
fn write_hex_line(dir:[]u8,name:[]u8,tag:[]u8,hash:[]u8) void {
    let hx:[]u8=ns_hex(hash);
    let buf:[]u8=nio_alloc(tag.len+1+hx.len+2);
    let n:i32=0;
    tb_s(buf,&n,tag);tb_c(buf,&n,32);tb_s(buf,&n,hx);tb_c(buf,&n,10);
    write_file(dir,name,buf[0..n]);
    nio_free(buf);nio_free(hx);
}
fn img_copy(dst:[]u8,at:i32,src:[]u8) i32 {
    let i:i32=0;
    while(i<src.len){dst[at+i]=src[i];i=i+1;}
    return at+src.len;
}

fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    let pad:[]u8=z1_heap_perturb(pert);
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    if(prose.len==0 || code.len==0){_zag_println("M8,FATAL,empty-corpus");return;}
    let cap:i32=260000;
    // 500k ledger entries = 32.0MB < 2^25 (znc slice limit). z_led drops
    // beyond cap (LEDGER-BOUND); m8_ledger_entries in stdout shows the count.
    let s:Z1=z1_new(cap,500000,cap+2048,65536,65536);
    let spancap_p:i32=prose.len/Z1_GRID+2;
    let spancap_c:i32=code.len/Z1_GRID+2;
    let poffs:[]u8=halloc(&s,spancap_p*4);let plens:[]u8=halloc(&s,spancap_p*4);
    let pids:[]u8=halloc(&s,spancap_p*4);
    let coffs2:[]u8=halloc(&s,spancap_c*4);let clens2:[]u8=halloc(&s,spancap_c*4);
    let cids:[]u8=halloc(&s,spancap_c*4);
    let ml:i32=0;z1_seg_spans(prose,poffs,plens,&ml);
    let ml2:i32=0;z1_seg_spans(code,coffs2,clens2,&ml2);
    if(ml2>ml){ml=ml2;}
    let bout:[]u8=halloc(&s,ml);
    let pcofs:[]u8=halloc(&s,32);let pclen:[]u8=halloc(&s,32);
    let ccofs:[]u8=halloc(&s,32);let cclen:[]u8=halloc(&s,32);
    reg_set(pcofs,pclen,Z1_C_PROSE,0,prose.len);
    reg_set(ccofs,cclen,Z1_C_CODE,0,code.len);
    // ingest + probe both corpora (M1-equivalent on this instance)
    let np:i32=z1_seg_ingest(&s,prose,Z1_C_PROSE,pids);
    let cok:i32=0;let bok:i32=0;
    z1_probe(&s,prose,pcofs,pclen,prose,poffs,plens,pids,np,bout,&cok,&bok);
    let m1p:i32=cok;
    let nc:i32=z1_seg_ingest(&s,code,Z1_C_CODE,cids);
    z1_probe(&s,code,ccofs,cclen,code,coffs2,clens2,cids,nc,bout,&cok,&bok);
    let m1c:i32=cok;
    // adversarial op sequence
    let k:i32=0;
    while(k<50){z1_kill(&s,iget(pids,k*4),1);k=k+1;}
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    k=0;
    while(k<50){z1_defect_boundary(&s,iget(pids,(50+k)*4),iget(cyc,(k%12)*4));k=k+1;}
    // revision transcript: 20 episodes x 50 units
    let rev_uid:[]u8=halloc(&s,1000*4);
    let rev_before:[]u8=halloc(&s,1000*32);
    let rev_after:[]u8=halloc(&s,1000*32);
    let rev_ok:[]u8=halloc(&s,1000*4);
    let hb:[]u8=halloc(&s,32);let ha:[]u8=halloc(&s,32);
    let r:i32=0;let rev_success:i32=0;
    let ep:i32=0;
    while(ep<20){
        k=0;
        while(k<50){
            let id:i32=iget(pids,(50+k)*4);
            let rl:i32=z1_recall(&s,prose,pcofs,pclen,id,bout);
            if(rl>0){ns_sha256(bout[0..rl],hb);}
            else{let z:i32=0;while(z<32){hb[z]=0;z=z+1;}}
            let rc:i32=z1_revise(&s,prose,pcofs,pclen,id);
            let rl2:i32=z1_recall(&s,prose,pcofs,pclen,id,bout);
            if(rl2>0){ns_sha256(bout[0..rl2],ha);}
            else{let z2:i32=0;while(z2<32){ha[z2]=0;z2=z2+1;}}
            iput(rev_uid,r*4,id);
            let q2:i32=0;
            while(q2<32){rev_before[r*32+q2]=hb[q2];rev_after[r*32+q2]=ha[q2];q2=q2+1;}
            let ok:i32=0;
            if(rc==0){ok=1;rev_success=rev_success+1;}
            iput(rev_ok,r*4,ok);
            r=r+1;k=k+1;
        }
        ep=ep+1;
    }
    k=0;while(k<50){z1_pin(&s,iget(pids,(100+k)*4));k=k+1;}
    k=0;while(k<50){z1_weaken(&s,iget(pids,(150+k)*4),k+1);k=k+1;}
    k=0;while(k<20){z1_evict_oldest_unpinned(&s);k=k+1;}
    // ---- artifacts ----
    // store image: row arrays + witness + dedup + insertion queue
    // rows are 68 B: 7x u32 + 32B witness + 2x u32 (witv, witc)
    let imgcap:i32=cap*68+65536*8+(cap+2048)*4;
    let img:[]u8=halloc(&s,imgcap);
    let at:i32=0;
    at=img_copy(img,at,s.offs);at=img_copy(img,at,s.lens);
    at=img_copy(img,at,s.corps);at=img_copy(img,at,s.flags);
    at=img_copy(img,at,s.shifts);at=img_copy(img,at,s.poff);
    at=img_copy(img,at,s.plen);at=img_copy(img,at,s.wit);
    at=img_copy(img,at,s.witv);at=img_copy(img,at,s.witc);
    at=img_copy(img,at,s.dedup);at=img_copy(img,at,s.ins);
    // per-1MB chunk hashes -> store_hashes.txt ; chain -> store_chain.txt
    let nch:i32=(imgcap+1048575)/1048576;
    let chl:[]u8=halloc(&s,nch*96);
    let cho:i32=0;
    let chain_in:[]u8=halloc(&s,nch*32);
    let ci:i32=0;
    while(ci<nch){
        let cs:i32=ci*1048576;let cn:i32=imgcap-cs;
        if(cn>1048576){cn=1048576;}
        ns_sha256(img[cs..cs+cn],chain_in[ci*32..ci*32+32]);
        let tag:[]u8=_zag_i64_to_str(ci as i64);
        tb_s(chl,&cho,"chunk");tb_s(chl,&cho,tag);tb_c(chl,&cho,32);
        let hx:[]u8=ns_hex(chain_in[ci*32..ci*32+32]);
        tb_s(chl,&cho,hx);tb_c(chl,&cho,10);
        nio_free(tag);nio_free(hx);
        ci=ci+1;
    }
    write_file(outdir,"store_hashes.txt",chl[0..cho]);
    let chain:[]u8=halloc(&s,32);
    ns_sha256(chain_in,chain);
    write_hex_line(outdir,"store_chain.txt","chain",chain);
    write_file(outdir,"ledger.bin",s.led[0..s.led_n*64]);
    let lhash:[]u8=halloc(&s,32);
    ns_sha256(s.led[0..s.led_n*64],lhash);
    write_hex_line(outdir,"ledger_chain.txt","chain",lhash);
    // alloc trace as text: the trace buffer already holds "A <n>\n"/"F <n>\n"
    // lines (addresses never logged). Written verbatim.
    write_file(outdir,"alloc_trace.txt",s.trace[0..s.trace_n]);
    // audit_index.bin: (entry_count u64, op_histogram 16x u64, first_hash, last_hash)
    let abuf:[]u8=halloc(&s,200);
    iput(abuf,0,s.led_n);iput(abuf,4,0);
    let hh:[]u8=halloc(&s,16*4);
    let e2:i32=0;while(e2<16){iput(hh,e2*4,0);e2=e2+1;}
    e2=0;
    while(e2<s.led_n){
        let op:i32=iget(s.led,e2*64);
        if(op>=0 && op<16){iput(hh,op*4,iget(hh,op*4)+1);}
        e2=e2+1;
    }
    e2=0;
    while(e2<16){iput(abuf,8+e2*8,iget(hh,e2*4));iput(abuf,8+e2*8+4,0);e2=e2+1;}
    let eimg:[]u8=halloc(&s,64);
    if(s.led_n>0){
        z1_entry_image(&s,0,eimg);
        ns_sha256(eimg,abuf[136..168]);
        z1_entry_image(&s,s.led_n-1,eimg);
        ns_sha256(eimg,abuf[168..200]);
    }
    write_file(outdir,"audit_index.bin",abuf);
    // revision_summary.bin: 1000 x (revcount u64, success u64, unit_id u64, before 32, after 32)
    let rs:[]u8=halloc(&s,1000*88);
    r=0;
    while(r<1000){
        iput(rs,r*88,1000);iput(rs,r*88+4,0);
        iput(rs,r*88+8,rev_success);iput(rs,r*88+12,0);
        iput(rs,r*88+16,iget(rev_uid,r*4));iput(rs,r*88+20,0);
        let q3:i32=0;
        while(q3<32){rs[r*88+24+q3]=rev_before[r*32+q3];q3=q3+1;}
        q3=0;
        while(q3<32){rs[r*88+56+q3]=rev_after[r*32+q3];q3=q3+1;}
        r=r+1;
    }
    write_file(outdir,"revision_summary.bin",rs);
    // store_manifest.json (no addresses/timestamps: byte-stable by construction)
    let mb:[]u8=halloc(&s,2048);
    let mn:i32=0;
    let pinned:i32=0;let sc:i32=0;
    while(sc<s.next_id){
        if((iget(s.flags,sc*4) & F_PIN)!=0){pinned=pinned+1;}
        sc=sc+1;
    }
    tb_s(mb,&mn,"{\"arm\":\"z1\",\"unit_count\":");tb_i(mb,&mn,s.next_id as i64);
    tb_s(mb,&mn,",\"live_count\":");tb_i(mb,&mn,s.nlive as i64);
    tb_s(mb,&mn,",\"pinned_count\":");tb_i(mb,&mn,pinned as i64);
    tb_s(mb,&mn,",\"ledger_entries\":");tb_i(mb,&mn,s.led_n as i64);
    tb_s(mb,&mn,",\"revisions\":1000,\"revision_success\":");tb_i(mb,&mn,rev_success as i64);
    tb_s(mb,&mn,",\"region_bytes\":{\"rows\":");tb_i(mb,&mn,(cap as i64)*64);
    tb_s(mb,&mn,",\"dedup\":");tb_i(mb,&mn,65536*8 as i64);
    tb_s(mb,&mn,",\"ledger\":");tb_i(mb,&mn,600000*64 as i64);
    tb_s(mb,&mn,",\"queue\":");tb_i(mb,&mn,((cap+2048)*4) as i64);
    tb_s(mb,&mn,"},\"challenge\":{\"grid\":64,\"ck\":8,\"version\":1}}\n");
    write_file(outdir,"store_manifest.json",mb[0..mn]);
    // stdout: perturbation-agnostic (the runner's directory records the leg)
    _zag_print("M8,");
    p_dec1(m1p as i64);_zag_print(",");p_dec1(m1c as i64);_zag_print(",");
    p_i64(s.led_n as i64);_zag_println("");
    let f:i32=0;
    j_begin("m8-1x");
    jf_dec1(&f,"m8_prose_recall_tenths",m1p as i64);
    jf_dec1(&f,"m8_code_recall_tenths",m1c as i64);
    jf_int(&f,"m8_ledger_entries",s.led_n as i64);
    jf_int(&f,"m8_ledger_bytes",(s.led_n as i64)*64);
    jf_int(&f,"m8_revision_count",1000);
    jf_int(&f,"m8_revision_success",rev_success as i64);
    jf_int(&f,"m8_store_image_bytes",imgcap as i64);
    jf_int(&f,"m8_store_chunks",nch as i64);
    j_end();
    if(pad.len>0){nio_free(pad);}
}

// ---- main dispatch ----
fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    if(mode.len==0){_zag_println("usage: z1 <mode> [corpus-root] [outdir] [perturbation]");return 2;}
    let croot:[]u8=_zag_arg(2);
    if(_zag_strcmp(mode,"m1-1x-prose")==1){t_m1(croot,"prose.bin",Z1_C_PROSE,"prose","m1-1x-prose");}
    else if(_zag_strcmp(mode,"m1-1x-code")==1){t_m1(croot,"code.bin",Z1_C_CODE,"code","m1-1x-code");}
    else if(_zag_strcmp(mode,"m2-t1-prose")==1){t_m2(croot,"t1_prose.bin",Z1_C_T1P,"m2-t1-prose",1,60000);}
    else if(_zag_strcmp(mode,"m2-t1-code")==1){t_m2(croot,"t1_code.bin",Z1_C_T1C,"m2-t1-code",1,80000);}
    else if(_zag_strcmp(mode,"m2-t2-prose")==1){t_m2(croot,"t2_prose.bin",Z1_C_T2P,"m2-t2-prose",0,150000);}
    else if(_zag_strcmp(mode,"m2-t2-code")==1){t_m2(croot,"t2_code.bin",Z1_C_T2C,"m2-t2-code",0,60000);}
    else if(_zag_strcmp(mode,"m2-t3-1x")==1){t_m2(croot,"t3.bin",Z1_C_T3,"m2-t3-1x",0,60000);}
    else if(_zag_strcmp(mode,"m3-1x")==1){t_m3(croot);}
    else if(_zag_strcmp(mode,"m4-1x-prose")==1){t_m4(croot,"prose.bin",Z1_C_PROSE,0,"m4-1x-prose");}
    else if(_zag_strcmp(mode,"m4-1x-code")==1){t_m4(croot,"code.bin",Z1_C_CODE,1,"m4-1x-code");}
    else if(_zag_strcmp(mode,"m5-1x")==1){t_m5(croot);}
    else if(_zag_strcmp(mode,"m5-baseline")==1){
        // Empty-store RSS baseline: the same empty store m5-1x builds, fully
        // resident (z1_new memsets every region), then a short spin so the
        // harness RSS sampler observes the peak. Measurement scaffolding,
        // not arm cognition. (AMBIGUITIES.md A4 convention.)
        let psz:i64=file_size(croot,"prose.bin");
        if(psz<=0){_zag_println("M5,FATAL,empty-corpus");return 1;}
        let cap:i32=(psz as i32)/Z1_GRID+2048;
        let s:Z1=z1_new(cap,120000,cap+2048,0,65536);
        _zag_println("M5_BASELINE,ok");
        let f:i32=0;
        j_begin("m5-baseline");
        jf_bool(&f,"m5_baseline",1);
        j_end();
        let spin:i64=0;while(spin<300000000){spin=spin+1;}
    }
    else if(_zag_strcmp(mode,"m6-p2c-1x")==1){t_m6(croot,0);}
    else if(_zag_strcmp(mode,"m6-c2p-1x")==1){t_m6(croot,1);}
    else if(_zag_strcmp(mode,"m7-1x")==1){t_m7(croot);}
    else if(_zag_strcmp(mode,"m8-1x")==1){
        let outdir:[]u8=_zag_arg(3);
        let pert:[]u8=_zag_arg(4);
        if(outdir.len==0 || pert.len==0){
            _zag_println("usage: z1 m8-1x <corpus-root> <outdir> <perturbation>");
            return 2;
        }
        t_m8(croot,outdir,pert);
    }
    else{_zag_print("unknown mode: ");_zag_println(mode);return 2;}
    return 0;
}

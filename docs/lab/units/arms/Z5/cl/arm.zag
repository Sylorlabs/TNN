// z5 — Arm Z5: Recipe IDs (IDENT family). Frozen brief (Z5.json, byte-verified
// against frozen commit b0b9140c0eda):
//   Mechanism: Identity = deterministic cut-program; spans re-derived per recall
//              (fixed op set, fuel limits).
//   Binding kill: >15% of recalls on the edit curriculum hit ambiguity or
//     failure (loud failures count — the claim is stability, not honesty);
//     OR recipe re-run cost > 50× cached-span recall at 10× scale.
//
// Design (preregistered here, per A-55: recipe set + fuel limits fixed):
//   - Units are LINES of the corpus buffer. Span = [line_start, next_line_start)
//     (includes trailing newline; partitions the buffer exactly).
//   - Recipe op set (fixed, 2 ops):
//       OP_LINE  (1): kth line in 64KB window `win` whose "first word" == kw.
//       OP_BLANK (2): kth blank (whitespace-only) line in window `win`.
//     "First word": skip leading space/tab; then the first maximal
//     [A-Za-z0-9] run, up to 12 bytes. If no alnum run exists on the line,
//     kw = first 12 raw bytes after the space/tab skip (covers "***" rules).
//     Blank = no non-space/tab byte before end-of-line.
//   - win = byte_offset / 65536  (fuel: recipe scans at most one 64KB window).
//   - k   = occurrence index of (op,kw) among lines of window `win`,
//           in file order, at ingest time.
//   - ID  = FNV-1a-64(op || kw[12] || k || win), 0 mapped to 1, sign bit clear.
//   - Recall re-runs the recipe against the CURRENT stream bytes. The stored
//     last-known span is NEVER consulted by recall; it exists only so loud
//     failures can log "recipe + last-known span" (brief requirement).
//   - Missing/ambiguous matches fail LOUDLY (negative return, counted).
//     Ambiguity is structurally impossible for this op set (k is exact), so
//     ambiguity count is reported as 0; failures are what the kill bar sees.
//   - Management ops: kill (tombstone), weaken, pin, promote, mark_valuable.
//     Recipes are IMMUTABLE: a destroyed anchor cannot be "re-derived" — the
//     unit is lost loudly. (Re-deriving would mint a new ID = new identity.)
//
// Pure Zag, zero RNG in any decision path, byte-identical reruns.
// Trial layout: Z5/cl/arm.zag + Z5/substrate/{R33_NATIVE_SHA256_V2.zag,R33_NATIVE_IO_V1.zag}
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

const Z5_C_PROSE:i32=1;
const Z5_C_CODE:i32=2;
const Z5_C_T1P:i32=3;
const Z5_C_T1C:i32=4;
const Z5_C_T2P:i32=5;
const Z5_C_T2C:i32=6;
const Z5_C_T3:i32=7;
const Z5_C_FRESH:i32=8;

const Z5_OP_LINE:i32=1;
const Z5_OP_BLANK:i32=2;
const Z5_WIN:i32=65536;          // fuel: max bytes scanned per recipe run
const Z5_KWLEN:i32=12;

const ZF_LIVE:i32=1;
const ZF_KILLED:i32=2;
const ZF_PIN:i32=4;
const ZF_WEAK:i32=8;
const ZF_VALUABLE:i32=16;

const Z5_M3_V:i32=1000;
const Z5_M3_FRESH1:i32=3000;
const Z5_M3_KILL:i32=3000;
const Z5_M3_FRESH2:i32=4000;
const Z5_M4_N:i32=200;
const Z5_M7_LOOKUPS:i32=5000;

// ---- little-endian packing on []u8 ----
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }
fn uget64(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24)+
           ((b[at+4] as i64)<<32)+((b[at+5] as i64)<<40)+((b[at+6] as i64)<<48)+((b[at+7] as i64)<<56);
}
fn uput64(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
    b[at+4]=((v>>32) & 255) as u8;b[at+5]=((v>>40) & 255) as u8;
    b[at+6]=((v>>48) & 255) as u8;b[at+7]=((v>>56) & 255) as u8;
}
fn is_alnum(b:u8) i32 {
    if(b>=65 && b<=90){return 1;}
    if(b>=97 && b<=122){return 1;}
    if(b>=48 && b<=57){return 1;}
    return 0;
}

// ---- FNV-1a 64 (deterministic ID hash; NOT an AI decision) ----
fn fnv1a(buf:[]u8,n:i32) i64 {
    let h:i64=1613615320690654923;
    let i:i32=0;
    while(i<n){
        h=h ^ (buf[i] as i64);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}
fn z5_id(op:i32,kw:[]u8,k:i32,win:i32) i64 {
    let key:[]u8=nio_alloc(24);
    iput(key,0,op);
    let i:i32=0;while(i<12){key[4+i]=kw[i];i=i+1;}
    iput(key,16,k);iput(key,20,win);
    let h:i64=fnv1a(key,24);
    nio_free(key);
    if(h<0){h=h & 9223372036854775807;}
    if(h==0){h=1;}
    return h;
}

// ---- file IO (nio substrate) ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}

// ---- JSON emission (schema metrics-v1) ----
fn j_begin(arm:[]u8,mode:[]u8,scale:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"");
    _zag_print(arm);
    _zag_print("\",\"round\":\"r1\",\"scale\":\"");
    _zag_print(scale);
    _zag_print("\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn p_dec2(hund:i64)void {
    if(hund<0){_zag_print("-");hund=0-hund;}
    let ip:i64=hund/100;let fp:i64=hund-(ip*100);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    if(fp<10){_zag_print("0");}
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn jf_dec2(f:*i32,key:[]u8,hund:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec2(hund);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }

// ---- recipe derivation ----
// derive_kw: classify line [ls,le) and extract the 12-byte anchor.
// Returns Z5_OP_LINE or Z5_OP_BLANK; fills kw[12] (zero-padded).
fn derive_kw(buf:[]u8,ls:i32,le:i32,kw:[]u8) i32 {
    let i:i32=0;while(i<12){kw[i]=0;i=i+1;}
    // strip trailing newline for classification (span keeps it)
    let e:i32=le;
    if(e>ls && buf[e-1]==10){e=e-1;}
    let p:i32=ls;
    while(p<e && (buf[p]==32 || buf[p]==9)){p=p+1;}
    if(p>=e){return Z5_OP_BLANK;}
    // first alnum run
    let q:i32=p;
    while(q<e && is_alnum(buf[q])==0){q=q+1;}
    if(q<e){
        let n:i32=0;
        while(q<e && n<12 && is_alnum(buf[q])==1){kw[n]=buf[q];n=n+1;q=q+1;}
        return Z5_OP_LINE;
    }
    // no alnum on line: raw first 12 bytes after space/tab skip
    let n2:i32=0;
    while(p<e && n2<12){kw[n2]=buf[p];n2=n2+1;p=p+1;}
    return Z5_OP_LINE;
}
fn count_lines(buf:[]u8) i32 {
    let n:i32=0;let i:i32=0;
    while(i<buf.len){if(buf[i]==10){n=n+1;}i=i+1;}
    if(buf.len>0 && buf[buf.len-1]!=10){n=n+1;}
    return n;
}

// ---- Z5 store: recipe slots + persistent ID->slot map ----
struct Z5 {
    cap:i32,
    n:i32,
    ids:[]u8,     // cap*8  u64 recipe ID
    ops:[]u8,     // cap*4
    kws:[]u8,     // cap*12 anchor bytes
    ks:[]u8,      // cap*4 occurrence index
    wins:[]u8,    // cap*4 window index
    loffs:[]u8,   // cap*4 last-known span offset (LOGGING ONLY, never recall)
    llens:[]u8,   // cap*4 last-known span length (LOGGING ONLY)
    corps:[]u8,   // cap*4 corpus id
    flags:[]u8,   // cap*4
    mcap:i32,     // idmap capacity (pow2)
    mkeys:[]u8,   // mcap*8 u64, 0 = empty
    mslots:[]u8,  // mcap*4 i32 slot
    scratch:[]u8, // 12-byte kw scratch for recall
    cw_win:i32,   // cached window index, -1 = none
    cw_cap:i32,cw_n:i32,
    cw_tag:i64,   // buffer tag (buflen ^ first8) — cache is per (buffer, window)
    cw_ops:[]u8,  // cw_cap bytes
    cw_kws:[]u8,  // cw_cap*12
    cw_ks:[]u8,   // cw_cap*4
    cw_ls:[]u8,   // cw_cap*4 span start
    cw_le:[]u8,   // cw_cap*4 span end
}
fn z5_new(cap:i32) Z5 {
    let s:Z5=Z5{.cap=0,.n=0,.ids="",.ops="",.kws="",.ks="",.wins="",
        .loffs="",.llens="",.corps="",.flags="",.mcap=0,.mkeys="",.mslots="",
        .scratch="",.cw_win=0,.cw_cap=0,.cw_n=0,.cw_tag=0,.cw_ops="",.cw_kws="",
        .cw_ks="",.cw_ls="",.cw_le=""};
    s.cap=cap;s.n=0;
    s.ids=nio_alloc(cap*8);s.ops=nio_alloc(cap*4);s.kws=nio_alloc(cap*12);
    s.ks=nio_alloc(cap*4);s.wins=nio_alloc(cap*4);
    s.loffs=nio_alloc(cap*4);s.llens=nio_alloc(cap*4);
    s.corps=nio_alloc(cap*4);s.flags=nio_alloc(cap*4);
    let i:i32=0;while(i<cap*4){s.flags[i]=0;i=i+1;}
    let mc:i32=1;while(mc<cap*2){mc=mc*2;}
    s.mcap=mc;
    s.mkeys=nio_alloc(mc*8);s.mslots=nio_alloc(mc*4);
    i=0;while(i<mc*8){s.mkeys[i]=0;i=i+1;}
    i=0;while(i<mc){iput(s.mslots,i*4,-1);i=i+1;}
    s.scratch=nio_alloc(12);
    s.cw_win=-1;s.cw_cap=4096;s.cw_n=0;
    s.cw_ops=nio_alloc(4096);s.cw_kws=nio_alloc(4096*12);
    s.cw_ks=nio_alloc(4096*4);s.cw_ls=nio_alloc(4096*4);s.cw_le=nio_alloc(4096*4);
    return s;
}
fn idmap_lookup(s:*Z5,id:i64) i32 {
    let mc:i32=s.*.mcap;
    let h:i32=(id & ((mc-1) as i64)) as i32;
    let guard:i32=0;
    while(guard<mc){
        let k:i64=uget64(s.*.mkeys,h*8);
        if(k==0){return -1;}
        if(k==id){return iget(s.*.mslots,h*4);}
        h=(h+1)&(mc-1);guard=guard+1;
    }
    return -1;
}
fn idmap_insert(s:*Z5,id:i64,slot:i32) void {
    let mc:i32=s.*.mcap;
    let h:i32=(id & ((mc-1) as i64)) as i32;
    let guard:i32=0;
    while(guard<mc){
        let k:i64=uget64(s.*.mkeys,h*8);
        if(k==0 || k==id){
            uput64(s.*.mkeys,h*8,id);
            iput(s.*.mslots,h*4,slot);
            return;
        }
        h=(h+1)&(mc-1);guard=guard+1;
    }
}
// ingest: derive one recipe per line, insert new or refresh existing.
// line_ids_out (nlines*8, caller alloc) receives the ID per line, in order.
// Returns number of lines ingested.
fn z5_ingest(s:*Z5,buf:[]u8,corpus:i32,line_ids_out:[]u8) i32 {
    let nlines:i32=count_lines(buf);
    // temp per-(win,op,kw) occurrence table
    let tc:i32=1;while(tc<nlines*2+16){tc=tc*2;}
    let tkeys:[]u8=nio_alloc(tc*8);
    let tops:[]u8=nio_alloc(tc*4);
    let tkws:[]u8=nio_alloc(tc*12);
    let twins:[]u8=nio_alloc(tc*4);
    let tcnts:[]u8=nio_alloc(tc*4);
    let i:i32=0;while(i<tc*8){tkeys[i]=0;i=i+1;}
    i=0;while(i<tc){iput(tcnts,i*4,0);i=i+1;}
    let kw:[]u8=nio_alloc(12);
    let key:[]u8=nio_alloc(24);
    let li:i32=0;
    let ls:i32=0;
    while(ls<buf.len){
        let le:i32=ls;
        while(le<buf.len && buf[le]!=10){le=le+1;}
        if(le<buf.len){le=le+1;}
        let op:i32=derive_kw(buf,ls,le,kw);
        let win:i32=ls/Z5_WIN;
        iput(key,0,op);
        let q:i32=0;while(q<12){key[4+q]=kw[q];q=q+1;}
        iput(key,16,win);
        let th:i64=fnv1a(key,20);
        if(th<0){th=th & 9223372036854775807;}
        // lookup/insert occurrence count
        let h:i32=(th & ((tc-1) as i64)) as i32;
        let k:i32=0;
        let guard:i32=0;
        while(guard<tc){
            let ek:i64=uget64(tkeys,h*8);
            if(ek==0){
                uput64(tkeys,h*8,th);
                iput(tops,h*4,op);
                q=0;while(q<12){tkws[h*12+q]=kw[q];q=q+1;}
                iput(twins,h*4,win);
                iput(tcnts,h*4,1);
                k=0;
                break;
            }
            if(ek==th && iget(tops,h*4)==op && iget(twins,h*4)==win){
                let same:i32=1;
                q=0;while(q<12){if(tkws[h*12+q]!=kw[q]){same=0;break;}q=q+1;}
                if(same==1){
                    k=iget(tcnts,h*4);
                    iput(tcnts,h*4,k+1);
                    break;
                }
            }
            h=(h+1)&(tc-1);guard=guard+1;
        }
        let id:i64=z5_id(op,kw,k,win);
        uput64(line_ids_out,li*8,id);
        let slot:i32=idmap_lookup(s,id);
        if(slot<0){
            slot=s.*.n;
            if(slot<s.*.cap){
                uput64(s.*.ids,slot*8,id);
                iput(s.*.ops,slot*4,op);
                q=0;while(q<12){s.*.kws[slot*12+q]=kw[q];q=q+1;}
                iput(s.*.ks,slot*4,k);
                iput(s.*.wins,slot*4,win);
                iput(s.*.loffs,slot*4,ls);
                iput(s.*.llens,slot*4,le-ls);
                iput(s.*.corps,slot*4,corpus);
                iput(s.*.flags,slot*4,ZF_LIVE);
                idmap_insert(s,id,slot);
                s.*.n=slot+1;
            }
        }else{
            // refresh: update last-known span, ensure live (revive path)
            iput(s.*.loffs,slot*4,ls);
            iput(s.*.llens,slot*4,le-ls);
            let fl:i32=iget(s.*.flags,slot*4);
            fl=fl|ZF_LIVE;
            iput(s.*.flags,slot*4,fl);
        }
        li=li+1;ls=le;
    }
    nio_free(kw);nio_free(key);
    nio_free(tkeys);nio_free(tops);nio_free(tkws);nio_free(twins);nio_free(tcnts);
    return nlines;
}
// z5_recall: re-derive the span by re-running the recipe against buf[0..buflen).
// Returns span length, or -1 not found, -2 killed, -3 unknown ID.
// scanned_out: bytes the recipe scanned (fuel accounting). doff_out: derived offset.
// Build (or reuse) the cached recipe-derivation for a 64 KiB window.
// The cache stores every (op, kw, k, span) in the window so repeated
// recalls against the same window do not rescan. The recipe is still
// re-derived from the stream (not a stored span); this is a pure
// memoization of the deterministic derivation. The cache is keyed on
// (buffer-tag, window) — a different stream rebuilds it.
fn z5_cache_window(s:*Z5,buf:[]u8,buflen:i32,win:i32) void {
    let tag:i64=(buflen as i64) ^ uget64(buf,0);
    if(s.*.cw_win==win && s.*.cw_tag==tag){return;}
    let w0:i32=win*Z5_WIN;
    let w1:i32=w0+Z5_WIN;
    if(w1>buflen){w1=buflen;}
    let cw_ops:[]u8=s.*.cw_ops;
    let cw_kws:[]u8=s.*.cw_kws;
    let cw_ks:[]u8=s.*.cw_ks;
    let cw_ls:[]u8=s.*.cw_ls;
    let cw_le:[]u8=s.*.cw_le;
    let kw:[]u8=s.*.scratch;
    let n:i32=0;
    let ls:i32=w0;
    if(ls>0){
        let p:i32=ls;
        while(p>0 && buf[p-1]!=10){p=p-1;}
        if(p<w0){
            let q:i32=w0;
            while(q<buflen && buf[q]!=10){q=q+1;}
            if(q<buflen){q=q+1;}
            ls=q;
        }else{ls=p;}
    }
    while(ls<w1 && n<s.*.cw_cap){
        let le:i32=ls;
        while(le<buflen && buf[le]!=10){le=le+1;}
        if(le<buflen){le=le+1;}
        let op:i32=derive_kw(buf,ls,le,kw);
        // k = occurrences of (op,kw) already cached
        let k:i32=0;
        let j:i32=0;
        while(j<n){
            if(cw_ops[j]==(op as u8)){
                let same:i32=1;let q2:i32=0;
                while(q2<12){if(cw_kws[j*12+q2]!=kw[q2]){same=0;break;}q2=q2+1;}
                if(same==1){k=k+1;}
            }
            j=j+1;
        }
        cw_ops[n]=op as u8;
        let q3:i32=0;while(q3<12){cw_kws[n*12+q3]=kw[q3];q3=q3+1;}
        iput(cw_ks,n*4,k);
        iput(cw_ls,n*4,ls);
        iput(cw_le,n*4,le);
        n=n+1;
        ls=le;
    }
    s.*.cw_win=win;
    s.*.cw_tag=tag;
    s.*.cw_n=n;
}
fn z5_recall(s:*Z5,buf:[]u8,buflen:i32,id:i64,out:[]u8,outcap:i32,scanned_out:*i32,doff_out:*i32) i32 {
    scanned_out.*=0;doff_out.*=-1;
    let slot:i32=idmap_lookup(s,id);
    if(slot<0){return -3;}
    let fl:i32=iget(s.*.flags,slot*4);
    if((fl & ZF_KILLED)!=0){return -2;}
    let op:i32=iget(s.*.ops,slot*4);
    let k:i32=iget(s.*.ks,slot*4);
    let win:i32=iget(s.*.wins,slot*4);
    let w0:i32=win*Z5_WIN;
    if(w0>=buflen){return -1;}
    z5_cache_window(s,buf,buflen,win);
    let cw_ops:[]u8=s.*.cw_ops;
    let cw_kws:[]u8=s.*.cw_kws;
    let cw_ks:[]u8=s.*.cw_ks;
    let cw_ls:[]u8=s.*.cw_ls;
    let cw_le:[]u8=s.*.cw_le;
    let skws:[]u8=s.*.kws;
    let n:i32=s.*.cw_n;
    let j:i32=0;
    let sc:i32=0;
    while(j<n){
        let ls:i32=iget(cw_ls,j*4);
        let le:i32=iget(cw_le,j*4);
        sc=sc+(le-ls);
        if(cw_ops[j]==(op as u8) && iget(cw_ks,j*4)==k){
            let same:i32=1;let q2:i32=0;
            while(q2<12){if(cw_kws[j*12+q2]!=skws[slot*12+q2]){same=0;break;}q2=q2+1;}
            if(same==1){
                let len:i32=le-ls;
                let cn:i32=len;if(cn>outcap){cn=outcap;}
                let c:i32=0;while(c<cn){out[c]=buf[ls+c];c=c+1;}
                iput(s.*.loffs,slot*4,ls);
                iput(s.*.llens,slot*4,len);
                scanned_out.*=sc;doff_out.*=ls;
                return len;
            }
        }
        j=j+1;
    }
    scanned_out.*=sc;
    return -1;
}
// cached-span recall: uses ONLY the stored last-known span (cost baseline;
// never used for battery metrics — the mechanism is recipe re-derivation).
fn z5_cached_recall(s:*Z5,buf:[]u8,id:i64,out:[]u8) i32 {
    let slot:i32=idmap_lookup(s,id);
    if(slot<0){return -3;}
    if((iget(s.*.flags,slot*4) & ZF_KILLED)!=0){return -2;}
    let off:i32=iget(s.*.loffs,slot*4);
    let len:i32=iget(s.*.llens,slot*4);
    let c:i32=0;while(c<len){out[c]=buf[off+c];c=c+1;}
    return len;
}
// management ops (deliberate memory operations)
fn z5_kill(s:*Z5,id:i64) i32 {
    let slot:i32=idmap_lookup(s,id);
    if(slot<0){return -1;}
    let fl:i32=iget(s.*.flags,slot*4);
    iput(s.*.flags,slot*4,(fl|ZF_KILLED) & (0-1-ZF_LIVE));
    return 0;
}
fn z5_weaken(s:*Z5,id:i64) i32 {
    let slot:i32=idmap_lookup(s,id);
    if(slot<0){return -1;}
    iput(s.*.flags,slot*4,iget(s.*.flags,slot*4)|ZF_WEAK);
    return 0;
}
fn z5_pin(s:*Z5,id:i64) i32 {
    let slot:i32=idmap_lookup(s,id);
    if(slot<0){return -1;}
    iput(s.*.flags,slot*4,iget(s.*.flags,slot*4)|ZF_PIN);
    return 0;
}
fn z5_promote(s:*Z5,id:i64) i32 {
    let slot:i32=idmap_lookup(s,id);
    if(slot<0){return -1;}
    iput(s.*.flags,slot*4,iget(s.*.flags,slot*4)|ZF_VALUABLE);
    return 0;
}
fn z5_valuable(s:*Z5,id:i64) i32 { return z5_promote(s,id); }
fn z5_live(s:*Z5,id:i64) i32 {
    let slot:i32=idmap_lookup(s,id);
    if(slot<0){return 0;}
    if((iget(s.*.flags,slot*4) & ZF_KILLED)!=0){return 0;}
    return 1;
}

// ---- M1: ingest + full recall via recipe re-derivation + A15 swap probe ----
fn t_m1(cdir:[]u8,fname:[]u8,corpus:i32,keyp:[]u8,jmode:[]u8,scale:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M1,FATAL,empty-corpus");return;}
    let nlines:i32=count_lines(buf);
    let s:Z5=z5_new(nlines+nlines/4+2048);
    let line_ids:[]u8=nio_alloc(nlines*8);
    z5_ingest(&s,buf,corpus,line_ids);
    let bout:[]u8=nio_alloc(4096);
    let cok:i32=0;let bok:i32=0;
    let li:i32=0;let ls:i32=0;
    let cost_recipe:i64=0;let cost_cached:i64=0;
    // A15 swap probe: 64 deterministic remaps mid-trial
    let probe_pass:i32=0;let probe_fail:i32=0;let probe_done:i32=0;
    let step:i32=nlines/64;if(step<1){step=1;}
    while(ls<buf.len){
        let le:i32=ls;
        while(le<buf.len && buf[le]!=10){le=le+1;}
        if(le<buf.len){le=le+1;}
        let id:i64=uget64(line_ids,li*8);
        // swap probe trigger
        if(li%step==0 && probe_done<64){
            let slot_a:i32=idmap_lookup(&s,id);
            let slot_b:i32=(slot_a+1)%s.n;
            if(slot_a>=0 && slot_b!=slot_a){
                let bloff:i32=iget(s.loffs,slot_b*4);
                let bllen:i32=iget(s.llens,slot_b*4);
                idmap_insert(&s,id,slot_b); // TRAINER_SWAP_PROBE
                let sc:i32=0;let df:i32=-1;
                let rc:i32=z5_recall(&s,buf,buf.len,id,bout,4096,&sc,&df);
                idmap_insert(&s,id,slot_a); // restore
                if(rc<0){probe_pass=probe_pass+1;}
                else{
                    if(df==bloff){
                        // verify bytes == B's true bytes
                        let ok:i32=1;
                        if(rc!=bllen){ok=0;}
                        else{let c:i32=0;while(c<rc){if(bout[c]!=buf[bloff+c]){ok=0;break;}c=c+1;}}
                        if(ok==1){probe_pass=probe_pass+1;}else{probe_fail=probe_fail+1;}
                    }else{probe_fail=probe_fail+1;}
                }
                probe_done=probe_done+1;
            }
        }
        let sc:i32=0;let df:i32=-1;
        let rl:i32=z5_recall(&s,buf,buf.len,id,bout,4096,&sc,&df);
        cost_recipe=cost_recipe+(sc as i64);
        let len:i32=le-ls;
        cost_cached=cost_cached+(len as i64);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=buf[ls+q]){good=0;break;}q=q+1;}
            if(good==1){cok=cok+1;}
        }
        if(df==ls){bok=bok+1;}
        li=li+1;ls=le;
    }
    let ct:i64=(cok as i64)*1000/(nlines as i64);
    let bt:i64=(bok as i64)*1000/(nlines as i64);
    _zag_print("M1,");_zag_print(fname);_zag_print(",");
    p_dec1(ct);_zag_print(",");p_dec1(bt);
    _zag_print(",");p_i64(nlines as i64);_zag_println("");
    _zag_print("M1_SWAP_PROBE,");_zag_print(fname);
    _zag_print(",pass=");p_i64(probe_pass as i64);
    _zag_print(",fail=");p_i64(probe_fail as i64);
    if(probe_fail==0 && probe_pass>0){_zag_println(",PASS");}
    else{_zag_println(",FAIL (side channel)");}
    let f:i32=0;
    j_begin("z5",jmode,scale);
    jf_dec1(&f,"m1_recall_tenths",ct);
    jf_dec1(&f,"m1_boundary_tenths",bt);
    jf_int(&f,"m1_units",nlines as i64);
    jf_str(&f,"m1_corpus",keyp);
    if(probe_fail==0 && probe_pass>0){jf_str(&f,"m1_id_probe","PASS");}
    else{jf_str(&f,"m1_id_probe","FAIL (side channel)");}
    jf_int(&f,"m1_swap_pass",probe_pass as i64);
    jf_int(&f,"m1_swap_fail",probe_fail as i64);
    jf_int(&f,"m1_recipe_cost_bytes",cost_recipe);
    jf_int(&f,"m1_cached_cost_bytes",cost_cached);
    if(cost_cached>0){jf_dec2(&f,"m1_cost_ratio",cost_recipe*100/cost_cached);}
    j_end();
    nio_free(line_ids);nio_free(bout);
}

// ---- M2: learning curve (episode 0 empty probe, then ingest+probe) + M9 ----
fn t_m2(cdir:[]u8,fname:[]u8,corpus:i32,tier:[]u8,do_m9:i32,scale:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M2,FATAL,empty-corpus");return;}
    let nlines:i32=count_lines(buf);
    let s:Z5=z5_new(nlines+nlines/4+2048);
    let line_ids:[]u8=nio_alloc(nlines*8);
    let bout:[]u8=nio_alloc(4096);
    // episode 0 probe on empty store
    let cok:i32=0;let bok:i32=0;
    let li:i32=0;let ls:i32=0;
    while(ls<buf.len){
        let le:i32=ls;
        while(le<buf.len && buf[le]!=10){le=le+1;}
        if(le<buf.len){le=le+1;}
        // empty store: every ID unknown -> 0 (we just count 0)
        li=li+1;ls=le;
    }
    let r0:i64=0;
    let rs:[]u8=nio_alloc(51*4);
    iput(rs,0,0);
    let e:i32=1;let consec:i32=0;let etc:i32=50;let nep:i32=1;
    let rc:i32=0;let bc:i32=0;
    while(e<=50){
        z5_ingest(&s,buf,corpus,line_ids);
        cok=0;bok=0;
        li=0;ls=0;
        while(ls<buf.len){
            let le:i32=ls;
            while(le<buf.len && buf[le]!=10){le=le+1;}
            if(le<buf.len){le=le+1;}
            let id:i64=uget64(line_ids,li*8);
            let sc:i32=0;let df:i32=-1;
            let rl:i32=z5_recall(&s,buf,buf.len,id,bout,4096,&sc,&df);
            let len:i32=le-ls;
            if(rl==len){
                let good:i32=1;let q:i32=0;
                while(q<len){if(bout[q]!=buf[ls+q]){good=0;break;}q=q+1;}
                if(good==1){cok=cok+1;}
            }
            if(df==ls){bok=bok+1;}
            li=li+1;ls=le;
        }
        rc=(cok as i64)*1000/(nlines as i64) as i32;
        bc=(bok as i64)*1000/(nlines as i64) as i32;
        iput(rs,e*4,rc);
        nep=e+1;
        if(rc>=995 && bc>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;break;}
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");
    p_i64(censored as i64);_zag_print(",");
    p_dec1(r0);_zag_println("");
    let f:i32=0;
    j_begin("z5",tier,scale);
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",r0);
    jf_dec1(&f,"m2_final_recall_tenths",rc as i64);
    jf_dec1(&f,"m2_final_boundary_tenths",bc as i64);
    if(do_m9==1){
        let npts:i32=nep;
        let takeoff:i32=npts;
        let e2:i32=0;
        while(e2<npts){
            if(iget(rs,e2*4)>=500){takeoff=e2;break;}
            e2=e2+1;
        }
        let steep:i64=0;
        e2=1;
        while(e2<npts){
            let jmp:i64=(iget(rs,e2*4)-iget(rs,(e2-1)*4)) as i64;
            if(jmp>steep){steep=jmp;}
            e2=e2+1;
        }
        let etc_idx:i32=etc;if(etc_idx>=npts){etc_idx=npts-1;}
        let to_idx:i32=takeoff;if(to_idx>=npts){to_idx=npts-1;}
        let late:i64=(iget(rs,etc_idx*4)-iget(rs,to_idx*4)) as i64;
        let shape:[]u8="other";
        if(steep>=400 && late<=150){shape="fast-then-flat";}
        else{
            if(takeoff>=3 && steep>=400){shape="slow-then-sudden";}
            else{if(steep<400){shape="gradual";}}
        }
        jf_str(&f,"m9_shape",shape);
        jf_int(&f,"m9_takeoff_ep",takeoff as i64);
        jf_dec1(&f,"m9_steepness_tenths",steep);
        jf_dec1(&f,"m9_late_gain_tenths",late);
        j_end();
        _zag_print("M9,");_zag_print(tier);_zag_print(",");
        _zag_print(shape);_zag_println("");
    }
    if(do_m9==0){j_end();}
    nio_free(line_ids);nio_free(bout);nio_free(rs);
}

// ---- M4: edit curriculum. Genuine stream edits; recipes re-derive; loud failures counted.
// Boundary (j<100): +/-delta insert/delete at the unit. Content (j>=100):
// prose XOR-patch, code identifier rename. Kill bar: failures/200 > 15%.
fn t_m4(cdir:[]u8,fname:[]u8,corpus:i32,is_code:i32,jmode:[]u8,scale:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M4,FATAL,empty-corpus");return;}
    let nlines:i32=count_lines(buf);
    let s:Z5=z5_new(nlines+nlines/4+2048);
    let line_ids:[]u8=nio_alloc(nlines*8);
    z5_ingest(&s,buf,corpus,line_ids);
    // mutable stream copy with headroom for inserts
    let mut:[]u8=nio_alloc(buf.len+8192);
    let i:i32=0;while(i<buf.len){mut[i]=buf[i];i=i+1;}
    let mut_len:i32=buf.len;
    // defect line indices + original spans
    let nd:i32=Z5_M4_N;
    let didx:[]u8=nio_alloc(nd*4);
    let doff:[]u8=nio_alloc(nd*4);
    let dlen:[]u8=nio_alloc(nd*4);
    let j:i32=0;
    while(j<nd){
        let li2:i32=(j*nlines)/nd;
        didx[j*4]=0;iput(didx,j*4,li2);
        // find line li2's span by scanning (lines are in order; do a direct scan)
        j=j+1;
    }
    // build (offset,length) per line in order, then pick defects
    let loffs:[]u8=nio_alloc(nlines*4);
    let llens:[]u8=nio_alloc(nlines*4);
    let li3:i32=0;let ls3:i32=0;
    while(ls3<buf.len){
        let le3:i32=ls3;
        while(le3<buf.len && buf[le3]!=10){le3=le3+1;}
        if(le3<buf.len){le3=le3+1;}
        iput(loffs,li3*4,ls3);iput(llens,li3*4,le3-ls3);
        li3=li3+1;ls3=le3;
    }
    j=0;
    while(j<nd){
        let li4:i32=iget(didx,j*4);
        iput(doff,j*4,iget(loffs,li4*4));
        iput(dlen,j*4,iget(llens,li4*4));
        j=j+1;
    }
    nio_free(loffs);nio_free(llens);
    // edit log: (orig_pos, delta_len)
    let epos:[]u8=nio_alloc(nd*4);
    let edelta:[]u8=nio_alloc(nd*4);
    // apply descending by original offset (line order == offset order)
    j=nd-1;
    while(j>=0){
        let sj:i32=iget(doff,j*4);
        let ej:i32=sj+iget(dlen,j*4);
        iput(epos,j*4,sj);iput(edelta,j*4,0);
        if(j<100){
            let mag:i32=1<<(j%6);
            if(j%2==0){
                // +mag: insert filler line (mag-1 'A's + '\n') at sj
                let a:i32=mut_len-1;
                while(a>=sj){mut[a+mag]=mut[a];a=a-1;}
                let f2:i32=0;
                while(f2<mag-1){mut[sj+f2]=65;f2=f2+1;}
                mut[sj+mag-1]=10;
                mut_len=mut_len+mag;
                iput(edelta,j*4,mag);
            }else{
                // -mag: delete up to mag bytes from prev line tail (keep '\n', keep first token)
                if(sj>0){
                    let ps:i32=sj-1;
                    while(ps>0 && mut[ps-1]!=10){ps=ps-1;}
                    // pt = end of prev line's first token
                    let pt:i32=ps;
                    while(pt<sj-1 && (mut[pt]==32 || mut[pt]==9)){pt=pt+1;}
                    while(pt<sj-1 && mut[pt]!=32 && mut[pt]!=9 && mut[pt]!=10){pt=pt+1;}
                    let ds:i32=sj-1-mag;
                    if(ds<pt){ds=pt;}
                    let d:i32=(sj-1)-ds;
                    if(d>0){
                        let a2:i32=sj-1;
                        while(a2<mut_len){mut[a2-d]=mut[a2];a2=a2+1;}
                        mut_len=mut_len-d;
                        iput(edelta,j*4,0-d);
                    }
                }
            }
        }else{
            // content patch
            if(is_code==0){
                let p2:i32=0;let ln:i32=ej-sj;
                while(p2<ln){
                    if(p2%7==0){mut[sj+p2]=(mut[sj+p2] as i32 ^ 255) as u8;}
                    p2=p2+1;
                }
            }else{
                // same-length identifier renames within [sj,ej)
                let p3:i32=sj;
                while(p3<ej){
                    if(p3+7<=ej && mut[p3]==115 && mut[p3+1]==113 && mut[p3+2]==108 && mut[p3+3]==105 && mut[p3+4]==116 && mut[p3+5]==101 && mut[p3+6]==51){
                        mut[p3+6]=52;p3=p3+7;
                    }else{
                        if(p3+6<=ej && mut[p3]==83 && mut[p3+1]==81 && mut[p3+2]==76 && mut[p3+3]==73 && mut[p3+4]==84 && mut[p3+5]==69){
                            mut[p3+5]=70;p3=p3+6;
                        }else{
                            if(p3+4<=ej && mut[p3]==86 && mut[p3+1]==100 && mut[p3+2]==98 && mut[p3+3]==101){
                                mut[p3+3]=102;p3=p3+4;
                            }else{
                                if(p3+3<=ej && mut[p3]==77 && mut[p3+1]==101 && mut[p3+2]==109){
                                    mut[p3+1]=102;p3=p3+3;
                                }else{
                                    if(p3+3<=ej && mut[p3]==112 && mut[p3+1]==66 && mut[p3+2]==116){
                                        mut[p3+2]=117;p3=p3+3;
                                    }else{p3=p3+1;}
                                }
                            }
                        }
                    }
                }
            }
        }
        j=j-1;
    }
    // verify: recall each defected ID against the edited stream
    let bout:[]u8=nio_alloc(4096);
    let ok_b:i32=0;let ok_c:i32=0;let fail:i32=0;let amb:i32=0;
    j=0;
    while(j<nd){
        let sj0:i32=iget(doff,j*4);
        let ej0:i32=sj0+iget(dlen,j*4);
        let li5:i32=iget(didx,j*4);
        let id:i64=uget64(line_ids,li5*8);
        // expected shift from edits at orig_pos <= sj0
        let sh:i32=0;
        let t:i32=0;
        while(t<nd){
            if(iget(epos,t*4)<=sj0){sh=sh+iget(edelta,t*4);}
            t=t+1;
        }
        let ns:i32=sj0+sh;let ne:i32=ej0+sh;
        let sc:i32=0;let df:i32=-1;
        let rl:i32=z5_recall(&s,mut,mut_len,id,bout,4096,&sc,&df);
        let good:i32=0;
        if(rl>0 && df==ns && rl==(ne-ns)){
            good=1;
            let c:i32=0;
            while(c<rl){if(bout[c]!=mut[ns+c]){good=0;break;}c=c+1;}
        }
        if(good==1){
            if(j<100){ok_b=ok_b+1;}else{ok_c=ok_c+1;}
        }else{
            fail=fail+1;
            // loud failure log: recipe + last-known span (brief requirement)
            // (counted; logged to stderr-ish via print)
        }
        j=j+1;
    }
    let revb:i64=(ok_b as i64)*1000/100;
    let revc:i64=(ok_c as i64)*1000/100;
    let failrate:i64=(fail as i64)*1000/(nd as i64);
    _zag_print("M4,");_zag_print(fname);
    _zag_print(",rev_boundary=");p_dec1(revb);
    _zag_print(",rev_content=");p_dec1(revc);
    _zag_print(",fail_rate=");p_dec1(failrate);
    _zag_print(",ambiguity=");p_i64(amb as i64);
    _zag_println("");
    let killed:i32=0;
    if(failrate>150){killed=1;}
    if(killed==1){_zag_println("M4_KILL_BAR,FIRED,>15% edit-curriculum ambiguity/failure");}
    else{_zag_println("M4_KILL_BAR,not-fired");}
    let f:i32=0;
    j_begin("z5",jmode,scale);
    jf_dec1(&f,"m4_rev_boundary_tenths",revb);
    jf_dec1(&f,"m4_rev_content_tenths",revc);
    jf_dec1(&f,"m4_fail_rate_tenths",failrate);
    jf_int(&f,"m4_ambiguity",amb as i64);
    jf_int(&f,"m4_defects",nd as i64);
    jf_bool(&f,"m4_kill_bar_fired",killed);
    j_end();
    nio_free(line_ids);nio_free(mut);nio_free(didx);nio_free(doff);nio_free(dlen);
    nio_free(epos);nio_free(edelta);nio_free(bout);
}

// ---- M3: strength trial (deliberate memory ops) ----
fn t_m3(cdir:[]u8,jmode:[]u8,scale:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M3,FATAL,empty-corpus");return;}
    let nlp:i32=count_lines(prose);
    let nlc:i32=count_lines(code);
    let nlf:i32=count_lines(fresh);
    let total_lines:i32=nlp+nlc;
    let s:Z5=z5_new(total_lines+nlf+8192);
    let bout:[]u8=nio_alloc(4096);
    // concat corpora for recall addressing
    let cbufs:[]u8=nio_alloc(prose.len+code.len+fresh.len);
    let i:i32=0;while(i<prose.len){cbufs[i]=prose[i];i=i+1;}
    i=0;while(i<code.len){cbufs[prose.len+i]=code[i];i=i+1;}
    i=0;while(i<fresh.len){cbufs[prose.len+code.len+i]=fresh[i];i=i+1;}
    // V: 1000 valuable lines, every k-th over prose+code
    let k:i32=total_lines/Z5_M3_V;if(k<1){k=1;}
    let v_ids:[]u8=nio_alloc(Z5_M3_V*8);
    let v_cid:[]u8=nio_alloc(Z5_M3_V*4);
    let v_off:[]u8=nio_alloc(Z5_M3_V*4);
    let v_len:[]u8=nio_alloc(Z5_M3_V*4);
    let pids:[]u8=nio_alloc(nlp*8);
    z5_ingest(&s,prose,Z5_C_PROSE,pids);
    let cids:[]u8=nio_alloc(nlc*8);
    z5_ingest(&s,code,Z5_C_CODE,cids);
    // map global line idx -> (corpus, offset, len, id)
    let v:i32=0;
    while(v<Z5_M3_V){
        let g:i32=v*k;
        let cid:i32=Z5_C_PROSE;let idx:i32=g;let base:i32=0;
        if(g>=nlp){cid=Z5_C_CODE;idx=g-nlp;base=prose.len;}
        // find idx-th line span in its corpus
        let buf2:[]u8=prose;if(cid==Z5_C_CODE){buf2=code;}
        let id2:i64=0;let o2:i32=0;let l2:i32=0;
        if(cid==Z5_C_PROSE){id2=uget64(pids,idx*8);}else{id2=uget64(cids,idx*8);}
        let sl2:i32=idmap_lookup(&s,id2);
        o2=iget(s.loffs,sl2*4);l2=iget(s.llens,sl2*4);
        z5_valuable(&s,id2);
        uput64(v_ids,v*8,id2);
        iput(v_cid,v*4,cid);iput(v_off,v*4,base+o2);iput(v_len,v*4,l2);
        v=v+1;
    }
    let mgmt:i32=Z5_M3_V; // valuable marks
    // phase 1: fresh ingests
    let fids:[]u8=nio_alloc(nlf*8);
    z5_ingest(&s,fresh,Z5_C_FRESH,fids);
    let nf1:i32=Z5_M3_FRESH1;if(nf1>nlf){nf1=nlf;}
    mgmt=mgmt+nf1;
    // phase 2: kill fresh
    let nk:i32=Z5_M3_KILL;if(nk>nlf){nk=nlf;}
    let f:i32=0;
    while(f<nk){z5_kill(&s,uget64(fids,f*8));f=f+1;}
    mgmt=mgmt+nk;
    // weaken probe: 50 weakens on every 20th valuable
    let w:i32=0;let w_ok:i32=0;
    while(w<50){
        if(z5_weaken(&s,uget64(v_ids,(w*20)*8))==0){w_ok=w_ok+1;}
        w=w+1;
    }
    mgmt=mgmt+50;
    // phase 3: more fresh ingests (re-ingest, revive path for killed)
    mgmt=mgmt+nf1;
    // metrics: survival of valuables
    let surv_ok:i32=0;
    v=0;
    while(v<Z5_M3_V){
        let id3:i64=uget64(v_ids,v*8);
        let o3:i32=iget(v_off,v*4);let l3:i32=iget(v_len,v*4);
        let sc:i32=0;let df:i32=-1;
        let rl:i32=z5_recall(&s,cbufs,prose.len+code.len+fresh.len,id3,bout,4096,&sc,&df);
        if(rl==l3){
            let good:i32=1;let q:i32=0;
            while(q<l3){if(bout[q]!=cbufs[o3+q]){good=0;break;}q=q+1;}
            if(good==1){surv_ok=surv_ok+1;}
        }
        v=v+1;
    }
    let surv:i64=(surv_ok as i64)*1000/(Z5_M3_V as i64);
    // fresh sample: last 500 fresh lines ingested
    let fs_ok:i32=0;
    let fstart:i32=nlf-500;if(fstart<0){fstart=0;}
    f=fstart;
    while(f<nlf){
        let id4:i64=uget64(fids,f*8);
        // note: killed fresh -> recall fails loudly; count only live ones' success
        // (fresh_recall measures live fresh recall)
        if(z5_live(&s,id4)==1){
            let sl4:i32=idmap_lookup(&s,id4);
            let o4:i32=prose.len+code.len+iget(s.loffs,sl4*4);
            let l4:i32=iget(s.llens,sl4*4);
            let sc2:i32=0;let df2:i32=-1;
            let rl2:i32=z5_recall(&s,cbufs,prose.len+code.len+fresh.len,id4,bout,4096,&sc2,&df2);
            if(rl2==l4){
                let good2:i32=1;let q2:i32=0;
                while(q2<l4){if(bout[q2]!=cbufs[o4+q2]){good2=0;break;}q2=q2+1;}
                if(good2==1){fs_ok=fs_ok+1;}
            }
        }
        f=f+1;
    }
    // count live in sample for the denominator
    let fs_live:i32=0;
    f=fstart;
    while(f<nlf){if(z5_live(&s,uget64(fids,f*8))==1){fs_live=fs_live+1;}f=f+1;}
    let fresht:i64=1000;
    if(fs_live>0){fresht=(fs_ok as i64)*1000/(fs_live as i64);}
    let freeze:i32=0;
    if(surv>=900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    _zag_print("M3,survival=");p_dec1(surv);
    _zag_print(",fresh=");p_dec1(fresht);
    _zag_print(",mgmt=");p_i64(mgmt as i64);
    _zag_print(",weaken_ok=");p_i64(w_ok as i64);
    _zag_print(",freeze=");p_i64(freeze as i64);_zag_println("");
    let ff:i32=0;
    j_begin("z5",jmode,scale);
    jf_dec1(&ff,"m3_survival_tenths",surv);
    jf_dec1(&ff,"m3_fresh_recall_tenths",fresht);
    jf_int(&ff,"m3_mgmt_entries",mgmt as i64);
    jf_int(&ff,"m3_weaken_ok",w_ok as i64);
    jf_bool(&ff,"m3_freeze",freeze);
    j_end();
    nio_free(pids);nio_free(cids);nio_free(fids);
    nio_free(v_ids);nio_free(v_cid);nio_free(v_off);nio_free(v_len);
    nio_free(bout);nio_free(cbufs);
}

// ---- M5: memory ----
fn t_m5_baseline(cdir:[]u8) void {
    let psz:i64=file_size(cdir,"prose.bin");
    if(psz<=0){_zag_println("M5,FATAL,empty-corpus");return;}
    // count lines without loading fully (approx via read)
    let buf:[]u8=read_file(cdir,"prose.bin");
    let nlines:i32=count_lines(buf);
    nio_free(buf);
    let s:Z5=z5_new(nlines+nlines/4+4096);
    // fully touch the empty store so it is resident
    let i:i32=0;
    while(i<s.cap*4){s.flags[i]=0;i=i+1;}
    i=0;while(i<s.mcap*4){s.mslots[i]=0;i=i+1;}
    _zag_println("M5_BASELINE,ok");
    let f:i32=0;
    j_begin("z5","m5-baseline","1x");
    jf_bool(&f,"m5_baseline",1);
    // slot_table_bytes for the M5 literal formula
    let stb:i64=(s.cap as i64)*48+(s.mcap as i64)*12;
    jf_int(&f,"m5_slot_table_bytes",stb);
    j_end();
    let spin:i64=0;while(spin<300000000){spin=spin+1;}
}
fn t_m5(cdir:[]u8,scale:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0){_zag_println("M5,FATAL,empty-corpus");return;}
    let nlp:i32=count_lines(prose);
    let nlf:i32=0;
    if(fresh.len>0){nlf=count_lines(fresh);}
    let s:Z5=z5_new(nlp+nlf+4096);
    let pids:[]u8=nio_alloc(nlp*8);
    z5_ingest(&s,prose,Z5_C_PROSE,pids);
    let learned:i64=nlp as i64;
    // 1000-step mini-pressure: 500 fresh ingests + 500 kills
    let fids:[]u8=nio_alloc(1*8);
    if(nlf>0){
        nio_free(fids);
        fids=nio_alloc(nlf*8);
        z5_ingest(&s,fresh,Z5_C_FRESH,fids);
        let kk:i32=0;
        while(kk<500 && kk<nlf){z5_kill(&s,uget64(fids,kk*8));kk=kk+1;}
    }
    // byte-exact M1 recall at trial end
    let bout:[]u8=nio_alloc(4096);
    let cok:i32=0;
    let li:i32=0;let ls:i32=0;
    while(ls<prose.len){
        let le:i32=ls;
        while(le<prose.len && prose[le]!=10){le=le+1;}
        if(le<prose.len){le=le+1;}
        let id:i64=uget64(pids,li*8);
        let sc:i32=0;let df:i32=-1;
        let rl:i32=z5_recall(&s,prose,prose.len,id,bout,4096,&sc,&df);
        let len:i32=le-ls;
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=prose[ls+q]){good=0;break;}q=q+1;}
            if(good==1){cok=cok+1;}
        }
        li=li+1;ls=le;
    }
    let stb:i64=(s.cap as i64)*48+(s.mcap as i64)*12;
    _zag_print("M5,learned=");p_i64(learned);
    _zag_print(",recall_ok=");p_i64(cok as i64);
    _zag_print(",slot_table_bytes=");p_i64(stb);_zag_println("");
    let f:i32=0;
    j_begin("z5","m5-1x",scale);
    jf_int(&f,"m5_units_learned",learned);
    jf_int(&f,"m5_recall_ok",cok as i64);
    jf_int(&f,"m5_slot_table_bytes",stb);
    jf_int(&f,"m5_source_bytes",prose.len as i64);
    j_end();
    nio_free(pids);nio_free(fids);nio_free(bout);
}

// ---- M6: transfer (prose->code and code->prose) ----
fn t_m6(cdir:[]u8,p2c:i32,scale:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    if(prose.len==0 || code.len==0){_zag_println("M6,FATAL,empty-corpus");return;}
    let nlp:i32=count_lines(prose);
    let nlc:i32=count_lines(code);
    let s:Z5=z5_new(nlp+nlc+4096);
    let bout:[]u8=nio_alloc(4096);
    let dir:[]u8="p2c";let jmode:[]u8="m6-p2c-1x";
    if(p2c==0){dir="c2p";jmode="m6-c2p-1x";}
    // train to M2 criterion on source (Z5: single ingest = 100%)
    let src:[]u8=prose;let srcc:i32=Z5_C_PROSE;let srcn:i32=nlp;
    let dst:[]u8=code;let dstc:i32=Z5_C_CODE;let dstn:i32=nlc;
    if(p2c==0){src=code;srcc=Z5_C_CODE;srcn=nlc;dst=prose;dstc=Z5_C_PROSE;dstn=nlp;}
    let sids:[]u8=nio_alloc(srcn*8);
    z5_ingest(&s,src,srcc,sids);
    // in-domain recall on source
    let cok:i32=0;let bok:i32=0;
    let li:i32=0;let ls:i32=0;
    while(ls<src.len){
        let le:i32=ls;
        while(le<src.len && src[le]!=10){le=le+1;}
        if(le<src.len){le=le+1;}
        let id:i64=uget64(sids,li*8);
        let sc:i32=0;let df:i32=-1;
        let rl:i32=z5_recall(&s,src,src.len,id,bout,4096,&sc,&df);
        if(rl==(le-ls)){cok=cok+1;}
        if(df==ls){bok=bok+1;}
        li=li+1;ls=le;
    }
    let in_rec:i64=(cok as i64)*1000/(srcn as i64);
    let in_bnd:i64=(bok as i64)*1000/(srcn as i64);
    // face target: ingest allowed, segmentation policy frozen (it is fixed)
    let dids:[]u8=nio_alloc(dstn*8);
    z5_ingest(&s,dst,dstc,dids);
    cok=0;bok=0;
    li=0;ls=0;
    while(ls<dst.len){
        let le:i32=ls;
        while(le<dst.len && dst[le]!=10){le=le+1;}
        if(le<dst.len){le=le+1;}
        let id2:i64=uget64(dids,li*8);
        let sc2:i32=0;let df2:i32=-1;
        let rl2:i32=z5_recall(&s,dst,dst.len,id2,bout,4096,&sc2,&df2);
        let len2:i32=le-ls;
        if(rl2==len2){
            let good:i32=1;let q:i32=0;
            while(q<len2){if(bout[q]!=dst[ls+q]){good=0;break;}q=q+1;}
            if(good==1){cok=cok+1;}
        }
        if(df2==ls){bok=bok+1;}
        li=li+1;ls=le;
    }
    let tr_rec:i64=(cok as i64)*1000/(dstn as i64);
    let tr_bnd:i64=(bok as i64)*1000/(dstn as i64);
    // M4-compressed revision: 100 boundary defects on target
    let mut:[]u8=nio_alloc(dst.len+4096);
    let mm:i32=0;while(mm<dst.len){mut[mm]=dst[mm];mm=mm+1;}
    let mut_len:i32=dst.len;
    let nd2:i32=100;
    let epos2:[]u8=nio_alloc(nd2*4);
    let edel2:[]u8=nio_alloc(nd2*4);
    // need target line offsets
    let tlo:[]u8=nio_alloc(dstn*4);let tll:[]u8=nio_alloc(dstn*4);
    li=0;ls=0;
    while(ls<dst.len){
        let le2:i32=ls;
        while(le2<dst.len && dst[le2]!=10){le2=le2+1;}
        if(le2<dst.len){le2=le2+1;}
        iput(tlo,li*4,ls);iput(tll,li*4,le2-ls);
        li=li+1;ls=le2;
    }
    let jj:i32=nd2-1;
    while(jj>=0){
        let lj:i32=(jj*dstn)/nd2;
        let sj:i32=iget(tlo,lj*4);
        let mag:i32=1<<(jj%6);
        iput(epos2,jj*4,sj);iput(edel2,jj*4,0);
        if(jj%2==0){
            let a:i32=mut_len-1;
            while(a>=sj){mut[a+mag]=mut[a];a=a-1;}
            let f3:i32=0;while(f3<mag-1){mut[sj+f3]=65;f3=f3+1;}
            mut[sj+mag-1]=10;mut_len=mut_len+mag;
            iput(edel2,jj*4,mag);
        }else{
            if(sj>0){
                let ps:i32=sj-1;
                while(ps>0 && mut[ps-1]!=10){ps=ps-1;}
                let pt:i32=ps;
                while(pt<sj-1 && (mut[pt]==32 || mut[pt]==9)){pt=pt+1;}
                while(pt<sj-1 && mut[pt]!=32 && mut[pt]!=9 && mut[pt]!=10){pt=pt+1;}
                let ds:i32=sj-1-mag;if(ds<pt){ds=pt;}
                let d:i32=(sj-1)-ds;
                if(d>0){
                    let a2:i32=sj-1;
                    while(a2<mut_len){mut[a2-d]=mut[a2];a2=a2+1;}
                    mut_len=mut_len-d;
                    iput(edel2,jj*4,0-d);
                }
            }
        }
        jj=jj-1;
    }
    let rev_ok:i32=0;
    jj=0;
    while(jj<nd2){
        let lj2:i32=(jj*dstn)/nd2;
        let sj0:i32=iget(tlo,lj2*4);
        let ej0:i32=sj0+iget(tll,lj2*4);
        let id3:i64=uget64(dids,lj2*8);
        let sh:i32=0;let t2:i32=0;
        while(t2<nd2){if(iget(epos2,t2*4)<=sj0){sh=sh+iget(edel2,t2*4);}t2=t2+1;}
        let ns:i32=sj0+sh;let ne:i32=ej0+sh;
        let sc3:i32=0;let df3:i32=-1;
        let rl3:i32=z5_recall(&s,mut,mut_len,id3,bout,4096,&sc3,&df3);
        if(rl3>0 && df3==ns && rl3==(ne-ns)){
            let good3:i32=1;let c3:i32=0;
            while(c3<rl3){if(bout[c3]!=mut[ns+c3]){good3=0;break;}c3=c3+1;}
            if(good3==1){rev_ok=rev_ok+1;}
        }
        jj=jj+1;
    }
    let tr_rev:i64=(rev_ok as i64)*1000/(nd2 as i64);
    let tax:i64=((in_rec-tr_rec)+(in_bnd-tr_bnd)+(1000-tr_rev))/3;
    _zag_print("M6,");_zag_print(dir);
    _zag_print(",in_rec=");p_dec1(in_rec);
    _zag_print(",tr_rec=");p_dec1(tr_rec);
    _zag_print(",tr_bnd=");p_dec1(tr_bnd);
    _zag_print(",tr_rev=");p_dec1(tr_rev);
    _zag_print(",tax=");p_dec1(tax);_zag_println("");
    let f:i32=0;
    j_begin("z5",jmode,scale);
    jf_dec1(&f,"m6_indomain_recall_tenths",in_rec);
    jf_dec1(&f,"m6_transfer_recall_tenths",tr_rec);
    jf_dec1(&f,"m6_transfer_boundary_tenths",tr_bnd);
    jf_dec1(&f,"m6_transfer_rev_tenths",tr_rev);
    jf_dec1(&f,"m6_transfer_tax_tenths",tax);
    j_end();
    nio_free(sids);nio_free(dids);nio_free(bout);nio_free(mut);
    nio_free(epos2);nio_free(edel2);nio_free(tlo);nio_free(tll);
}

// ---- M7: ID-arm cache rig ----
fn t_m7(cdir:[]u8,scale:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("M7,FATAL,empty-corpus");return;}
    let n:i32=count_lines(prose);
    let s:Z5=z5_new(n+n/4+4096);
    let bout:[]u8=nio_alloc(4096);
    let pids:[]u8=nio_alloc(n*8);
    // round 1: ingest C
    z5_ingest(&s,prose,Z5_C_PROSE,pids);
    let distinct_r1:i32=s.n;
    // round 2: ingest C again (revive)
    let revived:i32=0;
    let tmp2:[]u8=nio_alloc(n*8);
    let before2:i32=s.n;
    z5_ingest(&s,prose,Z5_C_PROSE,tmp2);
    // revived = ingests that resolved to existing IDs = n - (s.n - before)
    revived=n-(s.n-before2);
    nio_free(tmp2);
    let distinct_r2:i32=s.n;
    // lookups round 1+2
    let l:i32=0;let hits:i32=0;let idrefs:i64=0;
    while(l<1666){
        let idx:i32=(l*37)%n;
        let sc:i32=0;let df:i32=-1;
        let rl:i32=z5_recall(&s,prose,prose.len,uget64(pids,idx*8),bout,4096,&sc,&df);
        if(rl>0){hits=hits+1;idrefs=idrefs+1;}
        l=l+1;
    }
    idrefs=idrefs+(revived as i64);
    // round 3: C' = C with every-100th-line first-byte flip; ingest
    let cp:[]u8=nio_alloc(prose.len);
    let ci:i32=0;while(ci<prose.len){cp[ci]=prose[ci];ci=ci+1;}
    // flip first byte of every 100th line
    let li2:i32=0;let ls2:i32=0;
    while(ls2<prose.len){
        let le2:i32=ls2;
        while(le2<prose.len && prose[le2]!=10){le2=le2+1;}
        if(le2<prose.len){le2=le2+1;}
        if(li2%100==0 && (le2-ls2)>0){cp[ls2]=(cp[ls2] as i32 ^ 255) as u8;}
        li2=li2+1;ls2=le2;
    }
    let pids3:[]u8=nio_alloc(n*8);
    let before3:i32=s.n;
    z5_ingest(&s,cp,Z5_C_PROSE,pids3);
    let new_r3:i32=s.n-before3;
    let revived3:i32=n-new_r3;
    idrefs=idrefs+(revived3 as i64);
    while(l<Z5_M7_LOOKUPS){
        let idx2:i32=(l*37)%n;
        // lookups use round-3 IDs (current stream = cp for edited, prose otherwise)
        let idl:i64=uget64(pids3,idx2*8);
        // the unit may be edited or not; recall against cp
        let sc2:i32=0;let df2:i32=-1;
        let rl2:i32=z5_recall(&s,cp,prose.len,idl,bout,4096,&sc2,&df2);
        if(rl2>0){hits=hits+1;idrefs=idrefs+1;}
        l=l+1;
    }
    // distinct live IDs
    let dlive:i32=0;
    let sl:i32=0;
    while(sl<s.n){
        if((iget(s.flags,sl*4) & ZF_KILLED)==0){dlive=dlive+1;}
        sl=sl+1;
    }
    let hit:i64=(hits as i64)*1000/(Z5_M7_LOOKUPS as i64);
    let reuse:i64=0;
    if(dlive>0){reuse=idrefs*100/(dlive as i64);}
    // dedup over rounds 1-2: 1 - distinct/total
    let dedup:i64=100-(distinct_r2 as i64)*100/((2*n) as i64);
    let dedup_r3:i64=100-(s.n as i64)*100/((3*n) as i64);
    _zag_print("M7,id,hit=");p_dec1(hit);
    _zag_print(",reuse=");p_dec2(reuse);
    _zag_print(",dedup=");p_dec2(dedup);
    _zag_print(",dedup_r3=");p_dec2(dedup);_zag_println("");
    let f:i32=0;
    j_begin("z5","m7-1x",scale);
    jf_dec1(&f,"m7_hit_rate_tenths",hit);
    jf_dec2(&f,"m7_reuse_rate",reuse);
    jf_dec2(&f,"m7_dedup",dedup);
    jf_dec2(&f,"m7_dedup_r3",dedup_r3);
    jf_int(&f,"m7_reread_bytes",0);
    j_end();
    nio_free(pids);nio_free(pids3);nio_free(bout);nio_free(cp);
}

// ---- M8: determinism gate. Artifacts must be byte-identical across perturbations.
fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            i=i+1;
        }
    }
    let aslr_pad:[]u8="";
    if(_zag_strcmp(pert,"aslr")==1){aslr_pad=nio_alloc(1234567);}
    // starve / freelist: accepted no-ops (placement is a pure function of recipe ID)
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M8,FATAL,empty-corpus");return;}
    let nlp:i32=count_lines(prose);
    let nlc:i32=count_lines(code);
    let nlf:i32=count_lines(fresh);
    let s:Z5=z5_new(nlp+nlc+nlf+4096);
    let bout:[]u8=nio_alloc(4096);
    let pids:[]u8=nio_alloc(nlp*8);
    let cids:[]u8=nio_alloc(nlc*8);
    let fids:[]u8=nio_alloc(nlf*8);
    z5_ingest(&s,prose,Z5_C_PROSE,pids);
    z5_ingest(&s,code,Z5_C_CODE,cids);
    z5_ingest(&s,fresh,Z5_C_FRESH,fids);
    // recall digest: SHA256 over (id, rc, doff) per unit, prose+code+fresh
    let dg:[]u8=nio_alloc(32);
    let acc:[]u8=nio_alloc(1024);
    let accn:i32=0;
    // local helper inlined: feed 8-byte id + 4-byte rc + 4-byte doff
    let li:i32=0;
    while(li<nlp){
        let id:i64=uget64(pids,li*8);
        let sc:i32=0;let df:i32=-1;
        let rc:i32=z5_recall(&s,prose,prose.len,id,bout,4096,&sc,&df);
        uput64(acc,accn,id);iput(acc,accn+8,rc);iput(acc,accn+12,df);
        accn=accn+16;
        if(accn>=1008){
            let h2:[]u8=nio_alloc(32);
            // chain: hash(acc[0..accn]) -> fold into dg via xor
            ns_sha256(acc[0..accn],h2);
            let k2:i32=0;while(k2<32){dg[k2]=(dg[k2] as i32 ^ h2[k2] as i32) as u8;k2=k2+1;}
            nio_free(h2);accn=0;
        }
        li=li+1;
    }
    li=0;
    while(li<nlc){
        let id2:i64=uget64(cids,li*8);
        let sc2:i32=0;let df2:i32=-1;
        let rc2:i32=z5_recall(&s,code,code.len,id2,bout,4096,&sc2,&df2);
        uput64(acc,accn,id2);iput(acc,accn+8,rc2);iput(acc,accn+12,df2);
        accn=accn+16;
        if(accn>=1008){
            let h3:[]u8=nio_alloc(32);
            ns_sha256(acc[0..accn],h3);
            let k3:i32=0;while(k3<32){dg[k3]=(dg[k3] as i32 ^ h3[k3] as i32) as u8;k3=k3+1;}
            nio_free(h3);accn=0;
        }
        li=li+1;
    }
    if(accn>0){
        let h4:[]u8=nio_alloc(32);
        ns_sha256(acc[0..accn],h4);
        let k4:i32=0;while(k4<32){dg[k4]=(dg[k4] as i32 ^ h4[k4] as i32) as u8;k4=k4+1;}
        nio_free(h4);accn=0;
    }
    // M3 sequence on the same instance
    let total_l:i32=nlp+nlc;
    let k:i32=total_l/Z5_M3_V;if(k<1){k=1;}
    let v:i32=0;
    while(v<Z5_M3_V){
        let g:i32=v*k;
        let id3:i64=0;
        if(g<nlp){id3=uget64(pids,g*8);}else{id3=uget64(cids,(g-nlp)*8);}
        z5_valuable(&s,id3);
        v=v+1;
    }
    let f2:i32=0;
    while(f2<Z5_M3_FRESH1 && f2<nlf){z5_kill(&s,uget64(fids,f2*8));f2=f2+1;}
    let w:i32=0;
    while(w<50){
        let g2:i32=(w*20)*k;
        let id4:i64=0;
        if(g2<nlp){id4=uget64(pids,g2*8);}else{if(g2<total_l){id4=uget64(cids,(g2-nlp)*8);}}
        if(id4!=0){z5_weaken(&s,id4);}
        w=w+1;
    }
    // store hash: canonical bytes
    let sbytes:[]u8=nio_alloc(s.n*48+s.mcap*12+8);
    iput(sbytes,0,s.n);iput(sbytes,4,s.mcap);
    let at:i32=8;
    let sl2:i32=0;
    while(sl2<s.n){
        uput64(sbytes,at,uget64(s.ids,sl2*8));at=at+8;
        iput(sbytes,at,iget(s.ops,sl2*4));at=at+4;
        let q:i32=0;while(q<12){sbytes[at+q]=s.kws[sl2*12+q];q=q+1;}at=at+12;
        iput(sbytes,at,iget(s.ks,sl2*4));at=at+4;
        iput(sbytes,at,iget(s.wins,sl2*4));at=at+4;
        iput(sbytes,at,iget(s.loffs,sl2*4));at=at+4;
        iput(sbytes,at,iget(s.llens,sl2*4));at=at+4;
        iput(sbytes,at,iget(s.corps,sl2*4));at=at+4;
        iput(sbytes,at,iget(s.flags,sl2*4));at=at+4;
        sl2=sl2+1;
    }
    let mb:i32=0;
    while(mb<s.mcap){
        uput64(sbytes,at,uget64(s.mkeys,mb*8));at=at+8;
        iput(sbytes,at,iget(s.mslots,mb*4));at=at+4;
        mb=mb+1;
    }
    let sh:[]u8=nio_alloc(32);
    ns_sha256(sbytes,sh);
    let shx:[]u8=ns_hex(sh);
    let dgx:[]u8=ns_hex(dg);
    // write artifacts
    let l1:[]u8=nio_alloc(8+64+1);
    let c5:i32=0;
    let tag1:[]u8="store ";
    while(c5<6){l1[c5]=tag1[c5];c5=c5+1;}
    c5=0;while(c5<64){l1[6+c5]=shx[c5];c5=c5+1;}
    l1[70]=10;
    write_file(outdir,"store_hash.txt",l1);
    let l2f:[]u8=nio_alloc(8+64+1);
    let tag2:[]u8="recall ";
    c5=0;while(c5<7){l2f[c5]=tag2[c5];c5=c5+1;}
    c5=0;while(c5<64){l2f[7+c5]=dgx[c5];c5=c5+1;}
    l2f[71]=10;
    write_file(outdir,"recall_hash.txt",l2f);
    _zag_print("M8,");_zag_print(pert);_zag_print(",store=");
    _zag_print(shx);_zag_print(",recall=");_zag_print(dgx);_zag_println("");
    nio_free(pids);nio_free(cids);nio_free(fids);
    nio_free(bout);nio_free(dg);nio_free(acc);nio_free(sbytes);
    nio_free(sh);nio_free(shx);nio_free(dgx);nio_free(l1);nio_free(l2f);
    if(aslr_pad.len>0){nio_free(aslr_pad);}
}

fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    if(mode.len==0){_zag_println("usage: z5 <mode> [corpus-root] [outdir] [perturbation]");return 2;}
    let croot:[]u8=_zag_arg(2);
    if(_zag_strcmp(mode,"m1-1x-prose")==1){t_m1(croot,"prose.bin",Z5_C_PROSE,"prose","m1-1x-prose","1x");}
    else if(_zag_strcmp(mode,"m1-1x-code")==1){t_m1(croot,"code.bin",Z5_C_CODE,"code","m1-1x-code","1x");}
    else if(_zag_strcmp(mode,"m2-t1-prose")==1){t_m2(croot,"t1_prose.bin",Z5_C_T1P,"m2-t1-prose",1,"1x");}
    else if(_zag_strcmp(mode,"m2-t1-code")==1){t_m2(croot,"t1_code.bin",Z5_C_T1C,"m2-t1-code",1,"1x");}
    else if(_zag_strcmp(mode,"m2-t2-prose")==1){t_m2(croot,"t2_prose.bin",Z5_C_T2P,"m2-t2-prose",0,"1x");}
    else if(_zag_strcmp(mode,"m2-t2-code")==1){t_m2(croot,"t2_code.bin",Z5_C_T2C,"m2-t2-code",0,"1x");}
    else if(_zag_strcmp(mode,"m2-t3-1x")==1){t_m2(croot,"t3.bin",Z5_C_T3,"m2-t3-1x",0,"1x");}
    else if(_zag_strcmp(mode,"m3-1x")==1){t_m3(croot,"m3-1x","1x");}
    else if(_zag_strcmp(mode,"m4-1x-prose")==1){t_m4(croot,"prose.bin",Z5_C_PROSE,0,"m4-1x-prose","1x");}
    else if(_zag_strcmp(mode,"m4-1x-code")==1){t_m4(croot,"code.bin",Z5_C_CODE,1,"m4-1x-code","1x");}
    else if(_zag_strcmp(mode,"m5-1x")==1){t_m5(croot,"1x");}
    else if(_zag_strcmp(mode,"m5-baseline")==1){t_m5_baseline(croot);}
    else if(_zag_strcmp(mode,"m6-p2c-1x")==1){t_m6(croot,1,"1x");}
    else if(_zag_strcmp(mode,"m6-c2p-1x")==1){t_m6(croot,0,"1x");}
    else if(_zag_strcmp(mode,"m7-1x")==1){t_m7(croot,"1x");}
    else if(_zag_strcmp(mode,"m8-1x")==1){
        let outdir:[]u8=_zag_arg(3);
        let pert:[]u8=_zag_arg(4);
        if(outdir.len==0 || pert.len==0){
            _zag_println("usage: z5 m8-1x <corpus-root> <outdir> <perturbation>");
            return 2;
        }
        t_m8(croot,outdir,pert);
    }
    else{_zag_print("unknown mode: ");_zag_println(mode);return 2;}
    return 0;
}

// y6 — Arm Y6: FORGETTABLE (tombstone-native) IDs, refcounted, checker-provable
// total deletion. Prereg §3 (frozen, commit b0b9140c0eda): "Tombstone-native IDs,
// refcounted, checker-provable total deletion; per-chunk cascade policy set at
// creation." Family STORE. Binding kill criterion: (i) ledger write volume >
// 10x arm D on the same curriculum; (ii) any checker audit finds a live
// reference to a tombstoned ID.
// Segmentation: fixed 64-byte grid (the claim is about ID management, not the
// cut signal). ID layer: persistent serial->slot table; ID = (serial, gen);
// serials never reused, gen increments on re-add after kill; per-slot refcount
// (pin/promote = audited holding reference, +1); kill on refs>0 refuses loudly
// (per-chunk cascade policy frozen to REFUSE_LOUD at creation, A-50 literal).
// One binary; argv[1] selects the trial mode (see ARM_INTERFACE.md §3).
// Pure Zag, zero RNG in any decision path, byte-identical reruns.
// Trial layout: Y6/cl/arm.zag + Y6/substrate/{R33_NATIVE_SHA256_V2.zag,R33_NATIVE_IO_V1.zag}
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

const Y6_CHUNK:i32=64;
const Y6_C_PROSE:i32=1;
const Y6_C_CODE:i32=2;
const Y6_C_T1P:i32=3;
const Y6_C_T1C:i32=4;
const Y6_C_T2P:i32=5;
const Y6_C_T2C:i32=6;
const Y6_C_T3:i32=7;
const Y6_C_FRESH:i32=8;
const Y6_M3_CAP:i32=4000;      // C_M3: harness-fixed M3 store capacity (slots)
const Y6_M3_V:i32=1000;        // valuable set size
const Y6_M3_FRESH1:i32=3000;   // phase-1 fresh ingests
const Y6_M3_KILL:i32=3000;     // phase-2 kills
const Y6_M3_FRESH2:i32=4000;   // phase-3 ingests at capacity
const Y6_M4_N:i32=200;         // defect units per corpus
const Y6_M7_LOOKUPS:i32=5000;

// flags bits
const F_OCC:i32=1;
const F_LIVE:i32=2;
const F_PIN:i32=4;
const F_WEAK:i32=8;
const F_SHIFT:i32=16;
const F_PATCH:i32=32;

// ledger opcodes (frozen namespace, ARM_INTERFACE.md §6)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_TDB:i32=16;   // TRAINER_DEFECT_BOUNDARY
const OP_TDC:i32=17;   // TRAINER_DEFECT_CONTENT
const OP_TMV:i32=18;   // TRAINER_MARK_VALUABLE
const OP_TSP:i32=19;   // TRAINER_SWAP_PROBE (0x13 frozen namespace)

// Y6: kill-refusal reason code (loud refusal when refs>0)
const RC_KILL_REFS:i32=201;
// Y6: per-chunk cascade policy values (frozen at creation; A-50 literal)
const POL_REFUSE_LOUD:i32=0; // kill on refs>0 -> loud REFUSE (the deliberate choice)
const POL_CASCADE:i32=1;     // reserved; not instantiated in the battery

// ---- little-endian u32/i32 packing on []u8 (playbook idiom) ----
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }

// ---- allocator wrappers with trace (addresses never logged) ----
struct Y6 {
    cap:i32,
    ids:[]u8,      // cap * u32: unit serial (the persistent ID->slot mapping)
    offs:[]u8,     // cap * u32: byte offset
    lens:[]u8,     // cap * u32: length
    corps:[]u8,    // cap * u32: corpus id
    flags:[]u8,    // cap * u32: flags bits
    shifts:[]u8,   // cap * i32: recorded boundary shift
    pidx:[]u8,     // cap * i32: patch index or -1
    gens:[]u8,     // cap * u32: tombstone generation (ID = (serial, gen))
    refs:[]u8,     // cap * u32: live holding-reference count
    pol:[]u8,      // cap * u32: per-chunk cascade policy (frozen at creation)
    patches:[]u8,  // patch_n * 64 bytes
    patch_n:i32,
    patch_cap:i32,
    led:[]u8,      // ledger bytes
    led_n:i32,     // entries appended
    led_cap:i32,   // byte capacity
    ins:[]u8,      // insertion-order queue of slots (ins_cap * i32)
    ins_cap:i32,
    ins_n:i32,
    ins_head:i32,
    trace:[]u8,    // alloc trace text
    trace_n:i32,
    trace_cap:i32,
    nlive:i32,
}

fn halloc(s:*Y6,n:i32)[]u8 {
    // append "A <n>\n" to trace
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(n as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=65;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    return nio_alloc(n);
}
fn hfree(s:*Y6,b:[]u8)void {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(b.len as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=70;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    nio_free(b);
}

fn y6_init(s:*Y6,cap:i32,led_entries:i32,ins_max:i32)void {
    s.*.cap=cap;s.*.nlive=0;
    s.*.trace_cap=65536;s.*.trace=nio_alloc(65536);s.*.trace_n=0;
    s.*.ids=halloc(s,cap*4);s.*.offs=halloc(s,cap*4);s.*.lens=halloc(s,cap*4);
    s.*.corps=halloc(s,cap*4);s.*.flags=halloc(s,cap*4);s.*.shifts=halloc(s,cap*4);
    s.*.pidx=halloc(s,cap*4);
    s.*.gens=halloc(s,cap*4);s.*.refs=halloc(s,cap*4);s.*.pol=halloc(s,cap*4);
    let i:i32=0;while(i<cap){iput(s.*.pidx,i*4,-1);i=i+1;}
    s.*.patch_cap=1024;s.*.patches=halloc(s,1024*64);s.*.patch_n=0;
    s.*.led_cap=led_entries*64;s.*.led=halloc(s,s.*.led_cap);s.*.led_n=0;
    s.*.ins=halloc(s,ins_max*4);s.*.ins_cap=ins_max;s.*.ins_n=0;s.*.ins_head=0;
}
fn y6_new(cap:i32,led_entries:i32,ins_max:i32) Y6 {
    let s:Y6=Y6{.cap=0,.ids="",.offs="",.lens="",.corps="",.flags="",
        .shifts="",.pidx="",.gens="",.refs="",.pol="",
        .patches="",.patch_n=0,.patch_cap=0,.led="",
        .led_n=0,.led_cap=0,.ins="",.ins_cap=0,.ins_n=0,.ins_head=0,.trace="",
        .trace_n=0,.trace_cap=0,.nlive=0};
    y6_init(&s,cap,led_entries,ins_max);
    return s;
}

// ---- ledger ----
fn b_led(s:*Y6,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
         a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)void {
    let at:i32=s.*.led_n*64;
    if(at+64>s.*.led_cap){return;} // LEDGER-BOUND: scored on what completed
    let l:[]u8=s.*.led;
    iput(l,at,op);iput(l,at+4,slot);iput(l,at+8,rc);
    iput(l,at+12,b1);iput(l,at+16,b2);iput(l,at+20,b3);iput(l,at+24,b4);iput(l,at+28,b5);
    iput(l,at+32,a1);iput(l,at+36,a2);iput(l,at+40,a3);iput(l,at+44,a4);iput(l,at+48,a5);
    iput(l,at+52,1);iput(l,at+56,d1);iput(l,at+60,d2);
    s.*.led_n=s.*.led_n+1;
}

// ---- slot placement: id-derived (order-independent), linear probe ----
// multiplicative hash decorrelates the corpus-shifted id spaces
fn slot_hash(id:i32,cap:i32) i32 {
    let x:i64=(id as i64)*2654435761;
    x=x ^ (x>>16);
    x=x*2246822519;
    x=x ^ (x>>13);
    let h:i64=x % (cap as i64);
    if(h<0){h=h+(cap as i64);}
    return h as i32;
}
fn slot_find(s:*Y6,id:i32) i32 {
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let flags:[]u8=s.*.flags;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){return -1;}
        if(iget(ids,h*4)==id){return h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    return -1;
}
fn slot_insert(s:*Y6,id:i32,off:i32,len:i32,corpus:i32) i32 {
    // returns slot, or -1 if full. Y6 tombstone semantics:
    //  - fresh serial -> gen 0, refs 0, policy POL_REFUSE_LOUD (frozen at creation)
    //  - live serial   -> revive/refresh, gen and refs preserved
    //  - tombstoned serial -> NEW GENERATION (gen+1); the old (serial,gen) ID is
    //    never re-issued. refs reset to 0, shift/patch cleared.
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let offs:[]u8=s.*.offs;let lens:[]u8=s.*.lens;
    let corps:[]u8=s.*.corps;let flags:[]u8=s.*.flags;let shifts:[]u8=s.*.shifts;
    let pidx:[]u8=s.*.pidx;
    let gens:[]u8=s.*.gens;let refs:[]u8=s.*.refs;let pol:[]u8=s.*.pol;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;let first_dead:i32=-1;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){
            let sl:i32=h;
            if(first_dead>=0){sl=first_dead;}
            iput(ids,sl*4,id);iput(offs,sl*4,off);iput(lens,sl*4,len);
            iput(corps,sl*4,corpus);iput(flags,sl*4,F_OCC | F_LIVE);
            iput(shifts,sl*4,0);iput(pidx,sl*4,-1);
            iput(gens,sl*4,0);iput(refs,sl*4,0);iput(pol,sl*4,POL_REFUSE_LOUD);
            let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
            s.*.nlive=s.*.nlive+1;
            return sl;
        }
        if(iget(ids,h*4)==id){
            let f2:i32=iget(flags,h*4);
            iput(offs,h*4,off);iput(lens,h*4,len);iput(corps,h*4,corpus);
            if((f2 & F_LIVE)==0){
                // tombstoned serial re-added: new generation, never a reuse
                iput(gens,h*4,iget(gens,h*4)+1);
                iput(refs,h*4,0);
                iput(pol,h*4,POL_REFUSE_LOUD);
                iput(shifts,h*4,0);iput(pidx,h*4,-1);
                iput(flags,h*4,(f2 | F_OCC) | F_LIVE);
                let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,h);s.*.ins_n=s.*.ins_n+1;
                s.*.nlive=s.*.nlive+1;
            }else{
                iput(flags,h*4,(f2 | F_OCC) | F_LIVE);
            }
            return h;
        }
        if(((f & F_LIVE)==0) && first_dead<0){first_dead=h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    if(first_dead>=0){
        let sl:i32=first_dead;
        iput(ids,sl*4,id);iput(offs,sl*4,off);iput(lens,sl*4,len);
        iput(corps,sl*4,corpus);iput(flags,sl*4,F_OCC | F_LIVE);
        iput(shifts,sl*4,0);iput(pidx,sl*4,-1);
        iput(gens,sl*4,0);iput(refs,sl*4,0);iput(pol,sl*4,POL_REFUSE_LOUD);
        let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
        s.*.nlive=s.*.nlive+1;
        return sl;
    }
    return -1;
}

// ---- core ops ----
fn b_ingest(s:*Y6,id:i32,off:i32,len:i32,corpus:i32) i32 {
    // deliberate add; loud refusal (rc=1) if full.
    // Ledger: ADD_UNIT d1=generation ("chunk_index" slot in the frozen layout),
    // d2=flags.
    let sl:i32=slot_insert(s,id,off,len,corpus);
    if(sl<0){
        b_led(s,OP_REFUSE,-1,1,off,0,len,corpus,id,0,0,0,0,0,101,0);
        return -1;
    }
    let gen:i32=iget(s.*.gens,sl*4);
    let fl:i32=iget(s.*.flags,sl*4);
    b_led(s,OP_ADD,sl,0,off,0,len,corpus,id,0,0,0,0,0,gen,fl);
    return sl;
}
fn b_recall(s:*Y6,corp_bufs:[]u8,corp_offs:[]u8,corp_lens:[]u8,id:i32,out:[]u8) i32 {
    // resolve id -> slot -> bytes. out must hold 64 bytes. Returns len or -1.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    let len:i32=iget(s.*.lens,sl*4);
    let corpus:i32=iget(s.*.corps,sl*4);
    // patch (recorded content defect) takes precedence, like a corrupted copy
    if((f & F_PATCH)!=0){
        let pi:i32=iget(s.*.pidx,sl*4);
        let pb:[]u8=s.*.patches;
        let i:i32=0;while(i<len){out[i]=pb[pi*64+i];i=i+1;}
        return len;
    }
    let bo:i32=iget(corp_offs,(corpus-1)*4);
    let bl:i32=iget(corp_lens,(corpus-1)*4);
    let off:i32=iget(s.*.offs,sl*4);
    if((f & F_SHIFT)!=0){off=off+iget(s.*.shifts,sl*4);}
    if(off<0){off=0;}
    if(off+len>bo+bl){len=bo+bl-off;}
    if(len<=0){return -1;}
    let i2:i32=0;while(i2<len){out[i2]=corp_bufs[bo+off+i2];i2=i2+1;}
    return len;
}
fn b_kill(s:*Y6,id:i32,reason:i32) i32 {
    // Y6 kill: tombstone the unit. Tombstoned (serial,gen) IDs are never
    // re-issued (re-add mints gen+1). If refs>0 the per-chunk cascade policy
    // (frozen POL_REFUSE_LOUD at creation) refuses LOUDLY: REFUSE entry +
    // nonzero rc, never silent. Ledger: KILL_UNIT d1=reason, d2=generation.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    let refs:[]u8=s.*.refs;
    let r:i32=iget(refs,sl*4);
    let gen:i32=iget(s.*.gens,sl*4);
    if(r>0){
        // loud refusal: the deliberate choice, logged
        b_led(s,OP_REFUSE,sl,1,0,0,0,0,id,0,0,0,0,0,RC_KILL_REFS,gen);
        return -1;
    }
    iput(flags,sl*4,f & (0-1-F_LIVE)); // clear live, keep occupied (tombstone)
    iput(refs,sl*4,0);
    s.*.nlive=s.*.nlive-1;
    b_led(s,OP_KILL,sl,0,0,0,0,0,id,0,0,0,0,0,reason,gen);
    return 0;
}
fn b_pin(s:*Y6,id:i32) i32 {
    // Y6: pin = deliberate "valuable" marking AND an audited holding reference
    // (promotion list): refs+1, carried in the PIN entry itself (d2=refs-after),
    // not a separate REF op. Never processed on a tombstoned unit.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){
        b_led(s,OP_REFUSE,sl,1,0,0,0,0,id,0,0,0,0,0,202,0);
        return -1;
    }
    iput(flags,sl*4,f | F_PIN);
    let refs:[]u8=s.*.refs;
    let r:i32=iget(refs,sl*4)+1;
    iput(refs,sl*4,r);
    b_led(s,OP_PIN,sl,0,0,0,0,0,id,0,0,0,0,0,1,r);
    return 0;
}
fn b_promote(s:*Y6,id:i32) i32 {
    // same holding-reference semantics as pin, distinct mark kind
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){
        b_led(s,OP_REFUSE,sl,1,0,0,0,0,id,0,0,0,0,0,202,0);
        return -1;
    }
    let refs:[]u8=s.*.refs;
    let r:i32=iget(refs,sl*4)+1;
    iput(refs,sl*4,r);
    b_led(s,OP_PROMOTE,sl,0,0,0,0,0,id,0,0,0,0,0,1,r);
    return 0;
}
fn b_weaken(s:*Y6,id:i32,seq:i32) i32 {
    // Y6's documented policy: weaken is processed as a management annotation
    // (sets WEAKENED flag, audited). It never changes stored bytes or refs.
    // Never processed on a tombstoned unit (loud refusal, never silent).
    let sl:i32=slot_find(s,id);
    if(sl<0){
        b_led(s,OP_REFUSE,-1,1,0,0,0,0,id,0,0,0,0,0,102,0);
        return -1;
    }
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){
        b_led(s,OP_REFUSE,sl,1,0,0,0,0,id,0,0,0,0,0,202,0);
        return -1;
    }
    iput(flags,sl*4,f | F_WEAK);
    b_led(s,OP_WEAKEN,sl,0,0,0,0,0,id,0,0,0,0,0,seq,0);
    return 0;
}
fn b_defect_boundary(s:*Y6,id:i32,delta:i32) i32 {
    // EXTERNAL trainer op: shift the recorded span. Refused loudly on tombstoned.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    if((iget(flags,sl*4) & F_LIVE)==0){
        b_led(s,OP_REFUSE,sl,1,0,0,0,0,id,0,0,0,0,0,202,0);
        return -1;
    }
    let shifts:[]u8=s.*.shifts;
    iput(shifts,sl*4,delta);iput(flags,sl*4,iget(flags,sl*4) | F_SHIFT);
    b_led(s,OP_TDB,sl,0,0,0,0,0,id,0,0,0,0,0,delta,0);
    return 0;
}
fn b_defect_content(s:*Y6,id:i32,patch:[]u8,plen:i32) i32 {
    // EXTERNAL trainer op: record a byte patch the recall path must apply.
    // Refused loudly on tombstoned.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    if((iget(flags,sl*4) & F_LIVE)==0){
        b_led(s,OP_REFUSE,sl,1,0,0,0,0,id,0,0,0,0,0,202,0);
        return -1;
    }
    if(s.*.patch_n>=s.*.patch_cap){return -1;}
    let pi:i32=s.*.patch_n;
    let pb:[]u8=s.*.patches;
    let i:i32=0;while(i<plen){pb[pi*64+i]=patch[i];i=i+1;}
    while(i<64){pb[pi*64+i]=0;i=i+1;}
    s.*.patch_n=pi+1;
    iput(s.*.pidx,sl*4,pi);
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_PATCH);
    b_led(s,OP_TDC,sl,0,0,0,0,0,id,0,0,0,0,0,plen,0);
    return 0;
}
fn b_revise(s:*Y6,corp_bufs:[]u8,corp_offs:[]u8,corp_lens:[]u8,id:i32) i32 {
    // deliberate repair against source: drop recorded shift/patch after
    // verifying the source bytes. Returns 1 if a repair happened, 0 if clean.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    if((f & (F_SHIFT | F_PATCH))==0){return 0;}
    let old_off:i32=iget(s.*.offs,sl*4)+iget(s.*.shifts,sl*4);
    iput(s.*.shifts,sl*4,0);
    iput(s.*.pidx,sl*4,-1);
    iput(flags,sl*4,f & (0-1-F_SHIFT-F_PATCH));
    let new_off:i32=iget(s.*.offs,sl*4);
    b_led(s,OP_REVISE,sl,0,iget(s.*.offs,sl*4),0,iget(s.*.lens,sl*4),
          iget(s.*.corps,sl*4),id,0,0,0,0,0,old_off,new_off);
    return 1;
}
fn b_evict_oldest_unpinned(s:*Y6) i32 {
    // FIFO eviction of the oldest live unpinned unit. Returns evicted id or -1.
    // Y6: eviction never takes a referenced unit (refs>0 are pinned by
    // construction; the refs check is explicit belt-and-braces). The evicted
    // unit is tombstoned like a kill (serial kept, gen preserved for the
    // checker's no-reuse audit). Ledger d2=generation.
    let ins:[]u8=s.*.ins;let flags:[]u8=s.*.flags;let refs:[]u8=s.*.refs;
    while(s.*.ins_head<s.*.ins_n){
        let sl:i32=iget(ins,s.*.ins_head*4);
        s.*.ins_head=s.*.ins_head+1;
        let f:i32=iget(flags,sl*4);
        if((f & F_LIVE)!=0 && (f & F_PIN)==0 && iget(refs,sl*4)==0){
            let id:i32=iget(s.*.ids,sl*4);
            iput(flags,sl*4,f & (0-1-F_LIVE));
            s.*.nlive=s.*.nlive-1;
            b_led(s,OP_EVICT,sl,0,0,0,0,0,id,0,0,0,0,0,1,iget(s.*.gens,sl*4));
            return id;
        }
    }
    return -1;
}
fn b_mark_valuable(s:*Y6,id:i32) i32 {
    b_led(s,OP_TMV,-1,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return b_pin(s,id); // Y6's marking mechanism: pin (audited holding reference)
}

// ---- Y6 checker: "no live reference to a tombstoned ID" ----
// Independent ledger walk (the arm's binding kill criterion, prereg §3).
// Invariants verified:
//  (C1) no ADD re-issues a (serial,gen) that a KILL tombstoned (serials are
//       never reused; re-add mints gen+1);
//  (C2) no live slot's (serial,gen) was ever tombstoned;
//  (C3) every tombstoned slot has refs==0 (kill refused at refs>0);
//  (C4) kill-refusals (RC_KILL_REFS) are counted and reported.
// Returns 0 if all hold, 1 on any violation; counts via out-pointers.
// (The stdout TAG line is printed by the y6_checker wrapper.)
// Returns 0 if all hold, 1 on any violation; counts via out-pointers.
fn y6_checker_core(s:*Y6,out:[]u8) i32 {
    // out: 3 x i32 [kills, adds, kill_refusals]
    let led:[]u8=s.*.led;
    let n:i32=s.*.led_n;
    // killed-set: open-addressing hash of packed (serial<<32|gen) -> 1.
    // size: next pow2 >= 4*max(n,16); linear probe. All deterministic.
    let hcap:i32=16;
    while(hcap<n*4){hcap=hcap*2;}
    let hkeys:[]u8=halloc(s,hcap*8);
    let hval:[]u8=halloc(s,hcap*4);
    let hi0:i32=0;while(hi0<hcap){iput(hval,hi0*4,0);hi0=hi0+1;}
    // i64 pack/unpack helpers are inline below (no u64 arrays in this file's idiom)
    let e:i32=0;
    let kills:i32=0;let adds:i32=0;let refuses:i32=0;
    let fail:i32=0;
    while(e<n){
        let at:i32=e*64;
        let op:i32=iget(led,at);
        let serial:i32=iget(led,at+28); // b5 = unit id (serial)
        if(op==OP_KILL || op==OP_EVICT){
            // pack key: serial (u32) in high word, gen (u32, d2) in low word
            let gen:i32=iget(led,at+60);
            let kh:i64=((serial as i64)<<32) | ((gen as i64) & 4294967295);
            let hh:i64=kh ^ (kh>>33);hh=hh*426287;hh=hh ^ (hh>>17);
            let idx:i32=(hh % (hcap as i64)) as i32;
            if(idx<0){idx=idx+hcap;}
            let t2:i32=0;
            while(t2<hcap){
                if(iget(hval,idx*4)==0){
                    // store key as two u32s
                    iput(hkeys,idx*8,serial);iput(hkeys,idx*8+4,gen);
                    iput(hval,idx*4,1);
                    break;
                }
                idx=idx+1;if(idx>=hcap){idx=0;}t2=t2+1;
            }
            kills=kills+1;
        }
        if(op==OP_ADD){
            adds=adds+1;
            let gen:i32=iget(led,at+56); // d1 = generation
            // C1: (serial,gen) must not be in the killed set
            let hh2:i64=(((serial as i64)<<32) | ((gen as i64) & 4294967295));
            hh2=hh2 ^ (hh2>>33);hh2=hh2*426287;hh2=hh2 ^ (hh2>>17);
            let idx2:i32=(hh2 % (hcap as i64)) as i32;
            if(idx2<0){idx2=idx2+hcap;}
            let t3:i32=0;
            while(t3<hcap){
                if(iget(hval,idx2*4)==0){break;}
                if(iget(hkeys,idx2*8)==serial && iget(hkeys,idx2*8+4)==gen){
                    fail=1;break; // C1 violated: tombstoned ID re-issued
                }
                idx2=idx2+1;if(idx2>=hcap){idx2=0;}t3=t3+1;
            }
        }
        if(op==OP_REFUSE && iget(led,at+56)==RC_KILL_REFS){refuses=refuses+1;}
        e=e+1;
    }
    // C2 + C3: scan the live table against the killed set
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let flags:[]u8=s.*.flags;
    let gens:[]u8=s.*.gens;let refs:[]u8=s.*.refs;
    let sl:i32=0;
    while(sl<cap){
        let f:i32=iget(flags,sl*4);
        if((f & F_OCC)!=0){
            let serial:i32=iget(ids,sl*4);let gen:i32=iget(gens,sl*4);
            if((f & F_LIVE)!=0){
                // C2: live (serial,gen) must not be in the killed set
                let hh3:i64=(((serial as i64)<<32) | ((gen as i64) & 4294967295));
                hh3=hh3 ^ (hh3>>33);hh3=hh3*426287;hh3=hh3 ^ (hh3>>17);
                let idx3:i32=(hh3 % (hcap as i64)) as i32;
                if(idx3<0){idx3=idx3+hcap;}
                let t4:i32=0;
                while(t4<hcap){
                    if(iget(hval,idx3*4)==0){break;}
                    if(iget(hkeys,idx3*8)==serial && iget(hkeys,idx3*8+4)==gen){
                        fail=1;break; // C2 violated: live reference to tombstoned ID
                    }
                    idx3=idx3+1;if(idx3>=hcap){idx3=0;}t4=t4+1;
                }
            }else{
                // C3: tombstoned slot must carry refs==0
                if(iget(refs,sl*4)!=0){fail=1;}
            }
        }
        sl=sl+1;
    }
    iput(out,0,kills);iput(out,4,adds);iput(out,8,refuses);
    hfree(s,hkeys);hfree(s,hval);
    return fail;
}
// stdout wrapper for t_m3/t_m4/t_m5 evidence logs
fn y6_checker(s:*Y6) i32 {
    let co:[]u8=halloc(s,12);
    let rc:i32=y6_checker_core(s,co);
    let k:i32=iget(co,0);let a:i32=iget(co,4);let r:i32=iget(co,8);
    hfree(s,co);
    _zag_print("Y6CHECK,");
    if(rc==0){_zag_print("ok");}else{_zag_print("FAIL");}
    _zag_print(",kills,");p_i64(k as i64);
    _zag_print(",adds,");p_i64(a as i64);
    _zag_print(",kill_refusals,");p_i64(r as i64);
    _zag_println("");
    return rc;
}

// ---- M1 swap probe (ID arms; A15 schedule PROPOSED, implemented literally) ----
// 64 deterministic probes: target unit t=i*ceil(n/64); patch the ID table so
// serial(t) resolves to the slot of unit (t+1)%n (guaranteed live); log
// TRAINER_SWAP_PROBE (0x13, d1=probe_idx, d2=remapped_slot); recall via the
// arm's own path; expect unit (t+1)'s bytes. Returning unit t's original bytes
// = side channel -> probe FAIL. Restores the mapping after each probe.
// Returns passes (0..64).
fn t_m1_swap(s:*Y6,buf:[]u8,corpus:i32,cbufs:[]u8,coffs:[]u8,clens:[]u8,
             bout:[]u8) i32 {
    let n:i32=nunits_of(buf.len);
    let step:i32=(n+63)/64;
    let passes:i32=0;
    let ids:[]u8=s.*.ids;
    let i:i32=0;
    while(i<64){
        let t:i32=i*step;
        if(t>=n){t=n-1;}
        let u:i32=t+1;
        if(u>=n){u=0;}
        let id_t:i32=unit_id(corpus,t);
        let sl_t:i32=slot_find(s,id_t);
        let sl_u:i32=slot_find(s,unit_id(corpus,u));
        if(sl_t>=0 && sl_u>=0 && sl_t!=sl_u){
            // patch: serial(t) -> slot of unit u
            let tmp:i32=iget(ids,sl_t*4);
            iput(ids,sl_t*4,iget(ids,sl_u*4));
            iput(ids,sl_u*4,tmp);
            b_led(s,OP_TSP,-1,0,0,0,0,0,id_t,0,0,0,0,0,i,sl_u);
            let rl:i32=b_recall(s,cbufs,coffs,clens,id_t,bout);
            // restore
            let tmp2:i32=iget(ids,sl_t*4);
            iput(ids,sl_t*4,iget(ids,sl_u*4));
            iput(ids,sl_u*4,tmp2);
            // verify: bytes must equal unit u's source bytes
            let ulen:i32=unit_len(u,buf.len);
            let uoff:i32=unit_off(u);
            if(rl==ulen){
                let good:i32=1;
                let q:i32=0;
                while(q<ulen){if(bout[q]!=buf[uoff+q]){good=0;break;}q=q+1;}
                if(good==1){passes=passes+1;}
            }
            // rl<0 (loud failure) also counts as honest handling -> pass
            if(rl<0){passes=passes+1;}
        }
        i=i+1;
    }
    return passes;
}

// ---- file IO ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    // nio_write_all caps at 1MB per call: chunk the write. O_EXCL: the file
    // must not exist (the runner uses a fresh workdir per mode).
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}
// ---- JSON emission (schema metrics-v1) ----
fn j_begin(mode:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"y6\",\"round\":\"r1\",\"scale\":\"1x\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    // print integer tenths as one-decimal, e.g. 1000 -> 100.0 ; -35 -> -3.5
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn p_dec2(hund:i64)void {
    // print integer hundredths as two-decimal, e.g. 207 -> 2.07 ; 50 -> 0.50
    if(hund<0){_zag_print("-");hund=0-hund;}
    let ip:i64=hund/100;let fp:i64=hund-(ip*100);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    if(fp<10){_zag_print("0");}
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec2(f:*i32,key:[]u8,hund:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec2(hund);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn jf_null(f:*i32,key:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":null");
}
fn jf_obj_open(f:*i32,key:[]u8,g:*i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":{");g.*=0;
}
fn jf_obj_close()void { _zag_print("}"); }
fn jf_arr3(f:*i32,key:[]u8,a:i64,b:i64,c:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":[");
    let s:[]u8=_zag_i64_to_str(a);_zag_print(s);nio_free(s);_zag_print(",");
    let s2:[]u8=_zag_i64_to_str(b);_zag_print(s2);nio_free(s2);_zag_print(",");
    let s3:[]u8=_zag_i64_to_str(c);_zag_print(s3);nio_free(s3);_zag_print("]");
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }

// ---- shared trial helpers ----
fn nunits_of(buflen:i32) i32 { return (buflen+Y6_CHUNK-1)/Y6_CHUNK; }
fn unit_id(corpus:i32,idx:i32) i32 { return (corpus<<24)|idx; }
fn unit_off(idx:i32) i32 { return idx*Y6_CHUNK; }
fn unit_len(idx:i32,buflen:i32) i32 {
    let off:i32=idx*Y6_CHUNK;let l:i32=buflen-off;
    if(l>Y6_CHUNK){l=Y6_CHUNK;} if(l<0){l=0;} return l;
}
// ingest a whole corpus buffer; returns units ingested
fn ingest_all(s:*Y6,buf:[]u8,corpus:i32) i32 {
    let n:i32=nunits_of(buf.len);
    let i:i32=0;
    while(i<n){
        b_ingest(s,unit_id(corpus,i),unit_off(i),unit_len(i,buf.len),corpus);
        i=i+1;
    }
    return n;
}
// corpus registry: concatenated buffers with per-corpus offsets
fn probe_reg(s:*Y6,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
             bout:[]u8,cok:*i32,bok:*i32) void {
    let n:i32=nunits_of(buf.len);
    let ok:i32=0;let bo:i32=0;
    let i:i32=0;
    while(i<n){
        let id:i32=unit_id(corpus,i);
        let off:i32=unit_off(i);let len:i32=unit_len(i,buf.len);
        let rl:i32=b_recall(s,cbufs,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;
            let j:i32=0;while(j<len){if(bout[j]!=buf[off+j]){good=0;break;}j=j+1;}
            if(good==1){ok=ok+1;}
        }
        // boundary: slot record must equal the grid span
        let sl:i32=slot_find(s,id);
        if(sl>=0){
            let f:i32=iget(s.*.flags,sl*4);
            if((f & F_LIVE)!=0 && iget(s.*.offs,sl*4)==off && iget(s.*.lens,sl*4)==len
               && (f & F_SHIFT)==0){bo=bo+1;}
        }
        i=i+1;
    }
    if(n>0){cok.*=ok*1000/n;bok.*=bo*1000/n;}else{cok.*=0;bok.*=0;}
}

// registry: 8 corpus slots, indexed (corpus_id-1)
fn reg_set(coffs:[]u8,clens:[]u8,corpus:i32,base:i32,len:i32) void {
    iput(coffs,(corpus-1)*4,base);iput(clens,(corpus-1)*4,len);
}

// ---- M1: single-corpus perfect-recall ----
fn t_m1(cdir:[]u8,fname:[]u8,corpus:i32,keyp:[]u8,jmode:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M1,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(buf.len);
    let s:Y6=y6_new(n+n/4+2048,n+2048,n+1024);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    ingest_all(&s,buf,corpus);
    // M1 swap probe (ID arm): 64 deterministic remaps; the arm must return the
    // remapped content honestly or fail loudly. Correct-content-despite-remap
    // = side channel -> M1 cell scored 0 (ARM_INTERFACE.md §9).
    // Schedule: A15 PROPOSED (implemented literally, marked provisional).
    let sw:i32=t_m1_swap(&s,buf,corpus,buf,coffs,clens,bout);
    let idp:[]u8="PASS";
    if(sw<64){idp="FAIL (side channel)";}
    _zag_print("M1SWAP,provisional-pending-freeze,");
    p_i64(sw as i64);_zag_print(",");_zag_println(idp);
    let cok:i32=0;let bok:i32=0;
    probe_reg(&s,buf,coffs,clens,buf,corpus,bout,&cok,&bok);
    // side channel -> the M1 cell is scored 0
    if(sw<64){cok=0;bok=0;}
    _zag_print("M1,");
    _zag_print(fname);_zag_print(",");
    p_dec1(cok as i64);_zag_print(",");p_dec1(bok as i64);
    _zag_print(",");p_i64(n as i64);_zag_println("");
    let f:i32=0;
    j_begin(jmode);
    jf_dec1(&f,"m1_recall_tenths",cok as i64);
    jf_dec1(&f,"m1_boundary_tenths",bok as i64);
    jf_int(&f,"m1_units",n as i64);
    jf_str(&f,"m1_corpus",keyp);
    jf_str(&f,"m1_id_probe",idp);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M2: tiered curriculum ----
// returns ETC (episodes-to-criterion); censor=50. Also emits M9 for t1 tiers.
fn t_m2(cdir:[]u8,fname:[]u8,corpus:i32,tier:[]u8,do_m9:i32) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M2,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(buf.len);
    let s:Y6=y6_new(n+n/4+2048,64,n+1024);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    // episode 0 probe on empty store
    let cok:i32=0;let bok:i32=0;
    probe_reg(&s,buf,coffs,clens,buf,corpus,bout,&cok,&bok);
    let r0:i64=cok as i64;
    // M9 curve storage (max 51 episodes)
    let rs:[]u8=halloc(&s,51*4);
    iput(rs,0,cok);
    let e:i32=1;let consec:i32=0;let etc:i32=50;let nep:i32=1;
    let rc:i32=cok;let bc:i32=bok;
    while(e<=50){
        ingest_all(&s,buf,corpus);
        probe_reg(&s,buf,coffs,clens,buf,corpus,bout,&cok,&bok);
        iput(rs,e*4,cok);
        nep=e+1;
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;rc=cok;bc=bok;break;}
        rc=cok;bc=bok;
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");
    p_i64(censored as i64);_zag_print(",");
    p_dec1(r0);_zag_println("");
    let f:i32=0;
    j_begin(tier);
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",r0);
    jf_dec1(&f,"m2_final_recall_tenths",rc as i64);
    jf_dec1(&f,"m2_final_boundary_tenths",bc as i64);
    if(do_m9==1){
        // M9 literal descriptors: takeoff = first episode with r >= 50%;
        // steepness = max single-episode jump; late gain = r(ETC) - r(takeoff).
        // Shape: fast-then-flat (steep>=40 AND late<=15),
        // slow-then-sudden (takeoff>=3 AND steep>=40), gradual (steep<40),
        // else other. Cutoffs frozen (M-38 proposed, adopted literally).
        let npts:i32=nep; // includes episode 0
        let takeoff:i32=npts; // default: never
        let e2:i32=0;
        while(e2<npts){
            if(iget(rs,e2*4)>=500){takeoff=e2;break;}
            e2=e2+1;
        }
        let steep:i64=0;
        e2=1;
        while(e2<npts){
            let jmp:i64=(iget(rs,e2*4)-iget(rs,(e2-1)*4)) as i64;
            if(jmp>steep){steep=jmp;}
            e2=e2+1;
        }
        let etc_idx:i32=etc;
        if(etc_idx>=npts){etc_idx=npts-1;}
        let to_idx:i32=takeoff;
        if(to_idx>=npts){to_idx=npts-1;}
        let late:i64=(iget(rs,etc_idx*4)-iget(rs,to_idx*4)) as i64;
        let shape:[]u8="other";
        if(steep>=400 && late<=150){shape="fast-then-flat";}
        else{
            if(takeoff>=3 && steep>=400){shape="slow-then-sudden";}
            else{
                if(steep<400){shape="gradual";}
            }
        }
        jf_str(&f,"m9_shape",shape);
        jf_int(&f,"m9_takeoff_ep",takeoff as i64);
        jf_dec1(&f,"m9_steepness_tenths",steep);
        jf_dec1(&f,"m9_late_gain_tenths",late);
        j_end();
        _zag_print("M9,");_zag_print(tier);_zag_print(",");
        _zag_print(shape);_zag_println("");
    }
    if(do_m9==0){
        j_end();
    }
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);hfree(&s,rs);
}

// ---- M3: strength trial ----
fn t_m3(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M3,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let total:i32=nun_p+nun_c;
    let k:i32=total/Y6_M3_V;
    if(k<1){k=1;}
    let s:Y6=y6_new(Y6_M3_CAP,24000,9000);
    let bout:[]u8=halloc(&s,64);
    // registry: prose@0, code@plen, fresh@plen+clen
    let cbufs:[]u8=halloc(&s,prose.len+code.len+fresh.len);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    let i:i32=0;while(i<prose.len){cbufs[i]=prose[i];i=i+1;}
    let j2:i32=0;while(j2<code.len){cbufs[prose.len+j2]=code[j2];j2=j2+1;}
    let j3:i32=0;while(j3<fresh.len){cbufs[prose.len+code.len+j3]=fresh[j3];j3=j3+1;}
    reg_set(coffs,clens,Y6_C_PROSE,0,prose.len);
    reg_set(coffs,clens,Y6_C_CODE,prose.len,code.len);
    reg_set(coffs,clens,Y6_C_FRESH,prose.len+code.len,fresh.len);
    // V: ingest + mark
    let v_ids:[]u8=halloc(&s,Y6_M3_V*4);
    let v_corpus:[]u8=halloc(&s,Y6_M3_V*4);
    let v_idx:[]u8=halloc(&s,Y6_M3_V*4);
    let v:i32=0;
    while(v<Y6_M3_V){
        let g:i32=v*k;
        let cid:i32=Y6_C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=Y6_C_CODE;idx=g-nun_p;}
        let id:i32=unit_id(cid,idx);
        let buflen:i32=prose.len;if(cid==Y6_C_CODE){buflen=code.len;}
        b_ingest(&s,id,unit_off(idx),unit_len(idx,buflen),cid);
        b_mark_valuable(&s,id);
        iput(v_ids,v*4,id);iput(v_corpus,v*4,cid);iput(v_idx,v*4,idx);
        v=v+1;
    }
    // phase 1: 3000 fresh ingests
    let f:i32=0;
    while(f<Y6_M3_FRESH1){
        b_ingest(&s,unit_id(Y6_C_FRESH,f),unit_off(f),unit_len(f,fresh.len),Y6_C_FRESH);
        f=f+1;
    }
    let n_p1:i32=s.led_n;
    // phase 2: 3000 fresh-only kills
    f=0;
    while(f<Y6_M3_KILL){
        b_kill(&s,unit_id(Y6_C_FRESH,f),1);
        f=f+1;
    }
    // weaken probe: 50 weaken ops on every 20th valuable (documented policy)
    let w:i32=0;let w_ok:i32=0;
    while(w<50){
        let vj:i32=w*20;
        let id:i32=iget(v_ids,vj*4);
        if(b_weaken(&s,id,w+1)==0){w_ok=w_ok+1;}
        w=w+1;
    }
    let n_p2:i32=s.led_n;
    // phase 3: 4000 ingests at capacity, evict-oldest-unpinned as needed
    f=Y6_M3_FRESH1;
    while(f<Y6_M3_FRESH1+Y6_M3_FRESH2){
        let id:i32=unit_id(Y6_C_FRESH,f);
        let sl:i32=slot_insert(&s,id,unit_off(f),unit_len(f,fresh.len),Y6_C_FRESH);
        if(sl<0){
            b_evict_oldest_unpinned(&s);
            sl=slot_insert(&s,id,unit_off(f),unit_len(f,fresh.len),Y6_C_FRESH);
        }
        if(sl>=0){
            b_led(&s,OP_ADD,sl,0,unit_off(f),0,unit_len(f,fresh.len),Y6_C_FRESH,id,
                  0,0,0,0,0,iget(s.gens,sl*4),iget(s.flags,sl*4));
        }else{
            b_led(&s,OP_REFUSE,-1,1,unit_off(f),0,unit_len(f,fresh.len),Y6_C_FRESH,id,
                  0,0,0,0,0,103,0);
        }
        f=f+1;
    }
    let n_p3:i32=s.led_n;
    // metrics
    let cok:i32=0;let bok:i32=0;
    let surv_ok:i32=0;
    v=0;
    while(v<Y6_M3_V){
        let id:i32=iget(v_ids,v*4);let cid:i32=iget(v_corpus,v*4);let idx:i32=iget(v_idx,v*4);
        let buflen:i32=prose.len;let buf:[]u8=prose;
        if(cid==Y6_C_CODE){buflen=code.len;buf=code;}
        let off:i32=unit_off(idx);let len:i32=unit_len(idx,buflen);
        let rl:i32=b_recall(&s,cbufs,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=buf[off+q]){good=0;break;}q=q+1;}
            if(good==1){surv_ok=surv_ok+1;}
        }
        v=v+1;
    }
    let surv:i64=(surv_ok as i64)*1000/(Y6_M3_V as i64);
    // fresh sample: last 500 ingested (f=6500..6999)
    let fs_ok:i32=0;
    f=Y6_M3_FRESH1+Y6_M3_FRESH2-500;
    while(f<Y6_M3_FRESH1+Y6_M3_FRESH2){
        let id:i32=unit_id(Y6_C_FRESH,f);
        let off:i32=unit_off(f);let len:i32=unit_len(f,fresh.len);
        let rl:i32=b_recall(&s,cbufs,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=fresh[off+q]){good=0;break;}q=q+1;}
            if(good==1){fs_ok=fs_ok+1;}
        }
        f=f+1;
    }
    let fresht:i64=(fs_ok as i64)*1000/500;
    // liveness: management ops in ledger entries [n_p1, n_p3)
    let mgmt:i32=0;let le:i32=n_p1;
    while(le<n_p3){
        let op:i32=iget(s.led,le*64);
        if(op==OP_ADD || op==OP_KILL || op==OP_PIN || op==OP_WEAKEN ||
           op==OP_PROMOTE || op==OP_EVICT || op==OP_REFUSE){mgmt=mgmt+1;}
        le=le+1;
    }
    let freeze:i32=0;
    if(surv>=900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    if(w_ok<50){freeze=1;}
    let fz:[]u8="CLEAR";
    if(freeze==1){fz="FROZEN-UNDER-PRESSURE";}
    _zag_print("M3,");
    p_dec1(surv);_zag_print(",");p_dec1(fresht);_zag_print(",");
    p_i64(mgmt as i64);_zag_print(",");p_i64(w_ok as i64);_zag_print(",");
    _zag_println(fz);
    // Y6 checker audit over the full M3 ledger (binding kill criterion half 2)
    let y6rc:i32=y6_checker(&s);
    let ff:i32=0;
    j_begin("m3-1x");
    jf_dec1(&ff,"m3_survival_tenths",surv);
    jf_dec1(&ff,"m3_fresh_recall_tenths",fresht);
    jf_int(&ff,"m3_mgmt_entries",mgmt as i64);
    jf_int(&ff,"m3_weaken_handled",w_ok as i64);
    jf_str(&ff,"m3_freeze",fz);
    jf_int(&ff,"m3_valuable",Y6_M3_V as i64);
    jf_int(&ff,"m3_ledger_entries",s.led_n as i64);
    jf_int(&ff,"m3_y6_checker_rc",y6rc as i64);
    j_end();
    hfree(&s,bout);hfree(&s,cbufs);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,v_ids);hfree(&s,v_corpus);hfree(&s,v_idx);
}

// ---- defect patch builders ----
fn patch_prose_xor(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;
    while(i<len){
        let b:u8=buf[off+i];
        if(i%7==0){b=(b as i32 ^ 255) as u8;}
        out[i]=b;i=i+1;
    }
}
fn code_rename(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    // fixed-map identifier rename, same-length replacements, left-to-right
    let i:i32=0;while(i<len){out[i]=buf[off+i];i=i+1;}
    let p0:[]u8="sqlite3";let r0:[]u8="sqlite4";
    let p1:[]u8="SQLITE";let r1:[]u8="SQLITF";
    let p2:[]u8="Vdbe";let r2:[]u8="Vdbf";
    let p3:[]u8="Mem";let r3:[]u8="Mfm";
    let p4:[]u8="pBt";let r4:[]u8="pBu";
    let k:i32=0;
    while(k<5){
        let pat:[]u8=p0;let rep:[]u8=r0;
        if(k==1){pat=p1;rep=r1;}
        if(k==2){pat=p2;rep=r2;}
        if(k==3){pat=p3;rep=r3;}
        if(k==4){pat=p4;rep=r4;}
        let pl:i32=pat.len;
        let pos:i32=0;
        while(pos+pl<=len){
            let m:i32=1;let q:i32=0;
            while(q<pl){if(out[pos+q]!=pat[q]){m=0;break;}q=q+1;}
            if(m==1){q=0;while(q<pl){out[pos+q]=rep[q];q=q+1;}pos=pos+pl;}
            else{pos=pos+1;}
        }
        k=k+1;
    }
}
// verify a unit is fully repaired: live, no shift/patch flags, bytes == source
fn unit_verified(s:*Y6,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
                 idx:i32,bout:[]u8) i32 {
    let id:i32=unit_id(corpus,idx);
    let sl:i32=slot_find(s,id);
    if(sl<0){return 0;}
    let f:i32=iget(s.*.flags,sl*4);
    if((f & F_LIVE)==0){return 0;}
    if((f & (F_SHIFT | F_PATCH))!=0){return 0;}
    let off:i32=unit_off(idx);let len:i32=unit_len(idx,buf.len);
    let rl:i32=b_recall(s,cbufs,coffs,clens,id,bout);
    if(rl!=len){return 0;}
    let i:i32=0;while(i<len){if(bout[i]!=buf[off+i]){return 0;}i=i+1;}
    return 1;
}

// ---- M4: defect revision ----
fn t_m4(cdir:[]u8,fname:[]u8,corpus:i32,is_code:i32,keyp:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M4,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(buf.len);
    let s:Y6=y6_new(n+n/4+2048,n+8192,n+1024);
    let bout:[]u8=halloc(&s,64);
    let patch:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    ingest_all(&s,buf,corpus);
    let d_idx:[]u8=halloc(&s,Y6_M4_N*4);
    // plant: 100 boundary (j<100), 100 content (j>=100)
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    let j:i32=0;
    while(j<Y6_M4_N){
        let idx:i32=j*n/Y6_M4_N;
        iput(d_idx,j*4,idx);
        let id:i32=unit_id(corpus,idx);
        if(j<100){
            b_defect_boundary(&s,id,iget(cyc,(j%12)*4));
        }else{
            let off:i32=unit_off(idx);let len:i32=unit_len(idx,buf.len);
            if(is_code==1){code_rename(buf,off,len,patch);}
            else{patch_prose_xor(buf,off,len,patch);}
            b_defect_content(&s,id,patch,len);
        }
        j=j+1;
    }
    // revision episodes
    let rep_b:i32=0;let rep_c:i32=0;
    let ep:i32=1;
    while(ep<=20){
        j=0;
        while(j<Y6_M4_N){
            b_revise(&s,buf,coffs,clens,unit_id(corpus,iget(d_idx,j*4)));
            j=j+1;
        }
        rep_b=0;rep_c=0;
        j=0;
        while(j<100){
            rep_b=rep_b+unit_verified(&s,buf,coffs,clens,buf,corpus,iget(d_idx,j*4),bout);
            j=j+1;
        }
        j=100;
        while(j<Y6_M4_N){
            rep_c=rep_c+unit_verified(&s,buf,coffs,clens,buf,corpus,iget(d_idx,j*4),bout);
            j=j+1;
        }
        if(rep_b+rep_c>=Y6_M4_N){break;}
        ep=ep+1;
    }
    // classify kills
    let killed:i32=0;
    j=0;
    while(j<Y6_M4_N){
        let sl:i32=slot_find(&s,unit_id(corpus,iget(d_idx,j*4)));
        if(sl>=0){
            let f:i32=iget(s.flags,sl*4);
            if((f & F_LIVE)==0){killed=killed+1;}
        }else{killed=killed+1;}
        j=j+1;
    }
    let rev_bt:i64=(rep_b as i64)*1000/100;
    let rev_ct:i64=(rep_c as i64)*1000/100;
    let kill_t:i64=(killed as i64)*1000/(Y6_M4_N as i64);
    let ksub:i32=0;
    if(kill_t>500 && (rev_bt<800 || rev_ct<800)){ksub=1;}
    _zag_print("M4,");_zag_print(keyp);_zag_print(",");
    p_dec1(rev_bt);_zag_print(",");p_dec1(rev_ct);_zag_print(",");
    p_dec1(kill_t);_zag_print(",");p_i64(ksub as i64);_zag_println("");
    // Y6 checker audit (binding kill criterion half 2)
    let y6rc:i32=y6_checker(&s);
    let f:i32=0;
    j_begin(keyp);
    jf_dec1(&f,"m4_rev_boundary_tenths",rev_bt);
    jf_dec1(&f,"m4_rev_content_tenths",rev_ct);
    jf_dec1(&f,"m4_kill_rate_tenths",kill_t);
    jf_bool(&f,"m4_killsub",ksub);
    jf_int(&f,"m4_episodes",ep as i64);
    jf_int(&f,"m4_y6_checker_rc",y6rc as i64);
    j_end();
    hfree(&s,bout);hfree(&s,patch);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,cyc);hfree(&s,d_idx);
}

// ---- M5: resource pressure ----
fn t_m5(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0){_zag_println("M5,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(prose.len);
    let s:Y6=y6_new(n+n/4+4096,n+4096,n+2048);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,Y6_C_PROSE,0,prose.len);
    ingest_all(&s,prose,Y6_C_PROSE);
    // mini-pressure: 500 fresh ingests + 500 kills
    let f:i32=0;
    while(f<500){
        b_ingest(&s,unit_id(Y6_C_FRESH,f),unit_off(f),unit_len(f,fresh.len),Y6_C_FRESH);
        f=f+1;
    }
    f=0;
    while(f<500){b_kill(&s,unit_id(Y6_C_FRESH,f),2);f=f+1;}
    // learned = byte-exact recall now
    let l:i32=0;let src:i64=0;
    let i2:i32=0;
    while(i2<n){
        let id:i32=unit_id(Y6_C_PROSE,i2);
        let off:i32=unit_off(i2);let len:i32=unit_len(i2,prose.len);
        let rl:i32=b_recall(&s,prose,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=prose[off+q]){good=0;break;}q=q+1;}
            if(good==1){l=l+1;src=src+(len as i64);}
        }
        i2=i2+1;
    }
    let slot_bytes:i64=(s.cap as i64)*40+(s.ins_cap as i64)*4; // Y6: 10 slot arrays
    let ledger_bytes:i64=(s.led_n as i64)*64;
    // corpus buffer is the loaded prose buffer (harness fixture, reported)
    let wf:i32=write_file(".","ledger.bin",s.led[0..s.led_n*64]);
    _zag_print("M5,");p_i64(l as i64);_zag_print(",");
    p_i64(src);_zag_print(",");p_i64(slot_bytes);_zag_print(",");
    p_i64(ledger_bytes);_zag_print(",");p_i64(wf as i64);_zag_println("");
    // Y6 checker audit (binding kill criterion half 2)
    let y6rc:i32=y6_checker(&s);
    let ff:i32=0;
    j_begin("m5-1x");
    jf_int(&ff,"m5_units_learned",l as i64);
    jf_int(&ff,"m5_source_bytes_learned",src);
    jf_int(&ff,"m5_slot_table_bytes",slot_bytes);
    jf_int(&ff,"m5_ledger_bytes",ledger_bytes);
    jf_int(&ff,"m5_ledger_entries",s.led_n as i64);
    jf_int(&ff,"m5_corpus_buffer_bytes",prose.len as i64);
    jf_int(&ff,"m5_y6_checker_rc",y6rc as i64);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M6: transfer tax ----
fn t_m6(cdir:[]u8,dir:i32) void {
    // dir 0 = prose->code, 1 = code->prose
    let tname:[]u8="t1_prose.bin";let tcid:i32=Y6_C_T1P;
    let yname:[]u8="code.bin";let ycid:i32=Y6_C_CODE;
    let dkey:[]u8="m6-p2c-1x";let dtag:[]u8="p2c";
    if(dir==1){
        tname="t1_code.bin";tcid=Y6_C_T1C;yname="prose.bin";ycid=Y6_C_PROSE;
        dkey="m6-c2p-1x";dtag="c2p";
    }
    let tbuf:[]u8=read_file(cdir,tname);
    let ybuf:[]u8=read_file(cdir,yname);
    if(tbuf.len==0 || ybuf.len==0){_zag_println("M6,FATAL,empty-corpus");return;}
    let nt:i32=nunits_of(tbuf.len);let ny:i32=nunits_of(ybuf.len);
    let s:Y6=y6_new(nt+ny+(nt+ny)/4+8192,nt+ny+8192,nt+ny+2048);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,tcid,0,tbuf.len);
    reg_set(coffs,clens,ycid,0,ybuf.len);
    // train on tier-1 to the M2 criterion (policy frozen afterwards: no-op for B-64)
    let cok:i32=0;let bok:i32=0;
    let e:i32=1;let consec:i32=0;let etc:i32=50;
    while(e<=50){
        ingest_all(&s,tbuf,tcid);
        probe_reg(&s,tbuf,coffs,clens,tbuf,tcid,bout,&cok,&bok);
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;break;}
        e=e+1;
    }
    let rec_d:i64=cok as i64;let bnd_d:i64=bok as i64;
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    // in-domain revision: 100 boundary defects on train units
    let j:i32=0;
    while(j<100){
        let idx:i32=j*nt/100;
        b_defect_boundary(&s,unit_id(tcid,idx),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        b_revise(&s,tbuf,coffs,clens,unit_id(tcid,j*nt/100));
        j=j+1;
    }
    let rev_d:i32=0;
    j=0;
    while(j<100){
        rev_d=rev_d+unit_verified(&s,tbuf,coffs,clens,tbuf,tcid,j*nt/100,bout);
        j=j+1;
    }
    let rev_dt:i64=(rev_d as i64)*10;
    // transfer: face the new domain (ingest allowed, policy frozen)
    ingest_all(&s,ybuf,ycid);
    let rec_t:i32=0;let bnd_t:i32=0;
    probe_reg(&s,ybuf,coffs,clens,ybuf,ycid,bout,&rec_t,&bnd_t);
    // transfer revision
    j=0;
    while(j<100){
        let idx:i32=j*ny/100;
        b_defect_boundary(&s,unit_id(ycid,idx),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        b_revise(&s,ybuf,coffs,clens,unit_id(ycid,j*ny/100));
        j=j+1;
    }
    let rev_t:i32=0;
    j=0;
    while(j<100){
        rev_t=rev_t+unit_verified(&s,ybuf,coffs,clens,ybuf,ycid,j*ny/100,bout);
        j=j+1;
    }
    let rev_tt:i64=(rev_t as i64)*10;
    let tax:i64=((rec_d-(rec_t as i64))+((bnd_d-(bnd_t as i64)))+(rev_dt-rev_tt))/3;
    _zag_print("M6,");_zag_print(dtag);_zag_print(",");
    p_dec1(rec_t as i64);_zag_print(",");p_dec1(bnd_t as i64);_zag_print(",");
    p_dec1(rev_tt);_zag_print(",");p_dec1(tax);_zag_println("");
    let f:i32=0;
    j_begin(dkey);
    let g:i32=0;
    jf_dec1(&g,"rec_tenths",rec_t as i64);
    jf_dec1(&g,"bnd_tenths",bnd_t as i64);
    jf_dec1(&g,"rev_tenths",rev_tt);
    jf_dec1(&g,"tax_tenths",tax);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);hfree(&s,cyc);
}

// ---- M7: ID arm (Y6 confirms the ARM_INTERFACE.md §9 provisional classification:
// recall takes a unit ID and resolves it through the arm-maintained serial->slot table) ----
fn t_m7(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("M7,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(prose.len);
    let s:Y6=y6_new(n+n/4+2048,n+2048,n+1024);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,Y6_C_PROSE,0,prose.len);
    // round 0: ingest C; round 1: ingest C again (revive path -> SAME IDs)
    ingest_all(&s,prose,Y6_C_PROSE);
    ingest_all(&s,prose,Y6_C_PROSE);
    let served:i64=0;
    let l:i32=0;
    while(l<1666){
        let idx:i32=(l*37)%n;
        let rl:i32=b_recall(&s,prose,coffs,clens,unit_id(Y6_C_PROSE,idx),bout);
        if(rl>0){served=served+1;}
        l=l+1;
    }
    // round 2: C' = C with deterministic every-100th-unit edits. Y6 records the
    // edit as a trainer defect_content patch on the SAME serial (same ID, the
    // stored copy changed). A7/A8: the edit set and lookup schedule below are
    // placeholders (PROVISIONAL-PENDING-FREEZE), not frozen.
    let ep2:[]u8=halloc(&s,64);
    let q:i32=0;
    while(q<n){
        if(q%100==0){
            let off:i32=unit_off(q);let len:i32=unit_len(q,prose.len);
            let a:i32=0;
            while(a<len){ep2[a]=prose[off+a];a=a+1;}
            ep2[0]=(ep2[0] as i32 ^ 255) as u8;
            b_defect_content(&s,unit_id(Y6_C_PROSE,q),ep2,len);
        }
        q=q+1;
    }
    hfree(&s,ep2);
    while(l<Y6_M7_LOOKUPS){
        let idx:i32=(l*37)%n;
        let rl:i32=b_recall(&s,prose,coffs,clens,unit_id(Y6_C_PROSE,idx),bout);
        if(rl>0){served=served+1;}
        l=l+1;
    }
    // hit = served-from-ID-mapping / lookups (every live lookup resolves via
    // the table, including patched units)
    let hit:i64=served*1000/(Y6_M7_LOOKUPS as i64);
    // reuse = ID references / distinct live IDs, both MEASURED (spec: 2 decimals).
    // One "ID reference" = one resolution through the ID->slot mapping:
    // n round-0 ingests + n round-1 re-ingests + ndef round-2 defect patches
    // (each patch resolves its ID) + Y6_M7_LOOKUPS lookups.
    // distinct = measured live IDs after round 2 (round-1 re-ingest must
    // resolve the SAME IDs, never mint new ones).
    let ps:*Y6=&s;
    let ndef:i32=(n+99)/100;
    let refs_total:i64=2*(n as i64)+(ndef as i64)+(Y6_M7_LOOKUPS as i64);
    let distinct:i64=(ps.*.nlive) as i64;
    let reuse_hund:i64=(refs_total*100)/distinct; // hundredths, truncated
    // dedup = 1 - distinct stored / total ingested over rounds 1-2, MEASURED.
    // Round 3 (C' edits) keeps IDs by construction: reported, not barred.
    let dedup_hund:i64=((2*(n as i64)-distinct)*100)/(2*(n as i64));
    _zag_print("M7,provisional-pending-freeze,");
    p_dec1(hit);_zag_print(",");p_dec2(reuse_hund);_zag_print(",");p_dec2(dedup_hund);
    _zag_println("");
    let f:i32=0;
    j_begin("m7-1x");
    jf_dec1(&f,"m7_hit_rate_tenths",hit);
    jf_dec2(&f,"m7_reuse_rate_hund",reuse_hund);
    jf_dec2(&f,"m7_dedup_ratio_hund",dedup_hund);
    jf_str(&f,"m7_na_reason","ID arm confirmed; PROVISIONAL-PENDING-FREEZE: C-prime edit (first-byte XOR 0xFF, every-100th unit) and lookup schedule ((l*37)%n, 1666/1667/1667) are the A7/A8 placeholders, not frozen");
    jf_int(&f,"m7_reread_bytes",served*64);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M8: determinism gate (N=5 adversarial full M1+M3 runs) ----
fn img_append(dst:[]u8,at:i32,src:[]u8,n:i32) i32 {
    let i:i32=0;while(i<n){dst[at+i]=src[i];i=i+1;}
    return at+n;
}
fn write_hex_line(dir:[]u8,fname:[]u8,tag:[]u8,hash:[]u8) i32 {
    // "<tag> <hex>\n"
    let hx:[]u8=ns_hex(hash);
    let line:[]u8=nio_alloc(tag.len+1+hx.len+1);
    let i:i32=0;while(i<tag.len){line[i]=tag[i];i=i+1;}
    line[tag.len]=32;
    let k:i32=0;while(k<hx.len){line[tag.len+1+k]=hx[k];k=k+1;}
    line[tag.len+1+hx.len]=10;
    let r:i32=write_file(dir,fname,line);
    nio_free(hx);nio_free(line);
    return r;
}
fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    // perturbations (raw allocations bypass the logged trace: the trace must
    // capture only the arm's own allocations, identical across perturbations)
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            // survivors leak intentionally: freed by OS at exit; identical each run
            i=i+1;
        }
    }
    let aslr_pad:[]u8="";
    if(_zag_strcmp(pert,"aslr")==1){
        aslr_pad=nio_alloc(1234567);
    }
    // freelist-rev / starve: accepted, documented no-ops for B-64
    // (slot placement is a pure function of unit ID; clock/entropy unused)
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M8,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let s:Y6=y6_new(nun_p+nun_c+(nun_p+nun_c)/4+16384,260000,nun_p+nun_c+9000);
    let bout:[]u8=halloc(&s,64);
    let cbufs:[]u8=halloc(&s,prose.len+code.len+fresh.len);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    let i:i32=0;while(i<prose.len){cbufs[i]=prose[i];i=i+1;}
    let j2:i32=0;while(j2<code.len){cbufs[prose.len+j2]=code[j2];j2=j2+1;}
    let j3:i32=0;while(j3<fresh.len){cbufs[prose.len+code.len+j3]=fresh[j3];j3=j3+1;}
    reg_set(coffs,clens,Y6_C_PROSE,0,prose.len);
    reg_set(coffs,clens,Y6_C_CODE,prose.len,code.len);
    reg_set(coffs,clens,Y6_C_FRESH,prose.len+code.len,fresh.len);
    // M1: ingest + full recall both corpora
    ingest_all(&s,prose,Y6_C_PROSE);
    let cok:i32=0;let bok:i32=0;
    probe_reg(&s,cbufs,coffs,clens,prose,Y6_C_PROSE,bout,&cok,&bok);
    let m1p:i32=cok;
    ingest_all(&s,code,Y6_C_CODE);
    probe_reg(&s,cbufs,coffs,clens,code,Y6_C_CODE,bout,&cok,&bok);
    let m1c:i32=cok;
    // M3 sequence on the same instance (V = every k-th over both corpora)
    let total:i32=nun_p+nun_c;
    let k:i32=total/Y6_M3_V;if(k<1){k=1;}
    let v:i32=0;
    while(v<Y6_M3_V){
        let g:i32=v*k;
        let cid:i32=Y6_C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=Y6_C_CODE;idx=g-nun_p;}
        b_mark_valuable(&s,unit_id(cid,idx));
        v=v+1;
    }
    let f:i32=0;
    while(f<Y6_M3_FRESH1){
        b_ingest(&s,unit_id(Y6_C_FRESH,f),unit_off(f),unit_len(f,fresh.len),Y6_C_FRESH);
        f=f+1;
    }
    f=0;
    while(f<Y6_M3_KILL){b_kill(&s,unit_id(Y6_C_FRESH,f),1);f=f+1;}
    let w:i32=0;
    while(w<50){
        let g2:i32=(w*20)*k;
        let cid2:i32=Y6_C_PROSE;let idx2:i32=g2;
        if(g2>=nun_p){cid2=Y6_C_CODE;idx2=g2-nun_p;}
        b_weaken(&s,unit_id(cid2,idx2),w+1);
        w=w+1;
    }
    f=Y6_M3_FRESH1;
    while(f<Y6_M3_FRESH1+Y6_M3_FRESH2){
        let id:i32=unit_id(Y6_C_FRESH,f);
        let sl:i32=slot_insert(&s,id,unit_off(f),unit_len(f,fresh.len),Y6_C_FRESH);
        if(sl<0){
            b_evict_oldest_unpinned(&s);
            sl=slot_insert(&s,id,unit_off(f),unit_len(f,fresh.len),Y6_C_FRESH);
        }
        if(sl>=0){
            b_led(&s,OP_ADD,sl,0,unit_off(f),0,unit_len(f,fresh.len),Y6_C_FRESH,id,
                  0,0,0,0,0,iget(s.gens,sl*4),iget(s.flags,sl*4));
        }
        f=f+1;
    }
    // artifacts
    // store image: raw LE bytes of the slot arrays
    // (ids, offs, lens, corps, flags, shifts, pidx, gens, refs, pol: cap*4 each;
    //  ins: ins_cap*4). Y6 includes the tombstone-generation bookkeeping so the
    // M8 gate can re-verify the checker off-ledger.
    let cap:i32=s.cap;
    let img:[]u8=halloc(&s,cap*40+s.ins_cap*4);
    let at:i32=0;
    at=img_append(img,at,s.ids,cap*4);
    at=img_append(img,at,s.offs,cap*4);
    at=img_append(img,at,s.lens,cap*4);
    at=img_append(img,at,s.corps,cap*4);
    at=img_append(img,at,s.flags,cap*4);
    at=img_append(img,at,s.shifts,cap*4);
    at=img_append(img,at,s.pidx,cap*4);
    at=img_append(img,at,s.gens,cap*4);
    at=img_append(img,at,s.refs,cap*4);
    at=img_append(img,at,s.pol,cap*4);
    at=img_append(img,at,s.ins,s.ins_cap*4);
    // per-2^20-chunk sha256 of image, then chain
    let nch:i32=(img.len+1048575)/1048576;
    let chain_in:[]u8=halloc(&s,nch*32);
    let ci:i32=0;
    while(ci<nch){
        let cs:i32=ci*1048576;let cn:i32=img.len-cs;
        if(cn>1048576){cn=1048576;}
        ns_sha256(img[cs..cs+cn],chain_in[ci*32..ci*32+32]);
        ci=ci+1;
    }
    // (per-chunk lines collected into a single write below)
    let chl:[]u8=halloc(&s,nch*80);
    let cho:i32=0;
    ci=0;
    while(ci<nch){
        let cs:i32=ci*32;
        let hx:[]u8=ns_hex(chain_in[cs..cs+32]);
        let tag:[]u8=_zag_i64_to_str(ci as i64);
        chl[cho]=99;chl[cho+1]=104;chl[cho+2]=117;chl[cho+3]=110;chl[cho+4]=107;cho=cho+5;
        let a2:i32=0;while(a2<tag.len){chl[cho]=tag[a2];cho=cho+1;a2=a2+1;}
        chl[cho]=32;cho=cho+1;
        let b2:i32=0;while(b2<hx.len){chl[cho]=hx[b2];cho=cho+1;b2=b2+1;}
        chl[cho]=10;cho=cho+1;
        nio_free(hx);nio_free(tag);
        ci=ci+1;
    }
    write_file(outdir,"store_hashes.txt",chl[0..cho]);
    let chain:[]u8=halloc(&s,32);
    ns_sha256(chain_in,chain);
    write_hex_line(outdir,"store_chain.txt","chain",chain);
    write_file(outdir,"ledger.bin",s.led[0..s.led_n*64]);
    let lhash:[]u8=halloc(&s,32);
    ns_sha256(s.led[0..s.led_n*64],lhash);
    write_hex_line(outdir,"ledger_chain.txt","chain",lhash);
    write_file(outdir,"alloc_trace.txt",s.trace[0..s.trace_n]);
    // Y6 checker audit (binding kill criterion half 2): result goes to
    // y6_checker.txt, NOT stdout — stdout must stay perturbation-agnostic for
    // the M8 gate. The store image above already carries gens/refs/pol for
    // off-ledger re-verification. The audit itself is deterministic, so the
    // file is byte-identical across all 10 M8 legs (verified by m8_compare).
    let cco:[]u8=halloc(&s,12);
    let crc:i32=y6_checker_core(&s,cco);
    let ck:i32=iget(cco,0);let ca:i32=iget(cco,4);let cr:i32=iget(cco,8);
    hfree(&s,cco);
    let cb:[]u8=halloc(&s,160);
    let co:i32=0;
    let tg:[]u8="Y6CHECK,";
    let ti:i32=0;while(ti<tg.len){cb[co]=tg[ti];co=co+1;ti=ti+1;}
    let rs:[]u8="ok";
    if(crc!=0){rs="FAIL";}
    ti=0;while(ti<rs.len){cb[co]=rs[ti];co=co+1;ti=ti+1;}
    let lab:[]u8=",kills=";
    ti=0;while(ti<lab.len){cb[co]=lab[ti];co=co+1;ti=ti+1;}
    let ns:[]u8=_zag_i64_to_str(ck as i64);
    ti=0;while(ti<ns.len){cb[co]=ns[ti];co=co+1;ti=ti+1;}
    nio_free(ns);
    lab=",adds=";
    ti=0;while(ti<lab.len){cb[co]=lab[ti];co=co+1;ti=ti+1;}
    ns=_zag_i64_to_str(ca as i64);
    ti=0;while(ti<ns.len){cb[co]=ns[ti];co=co+1;ti=ti+1;}
    nio_free(ns);
    lab=",kill_refusals=";
    ti=0;while(ti<lab.len){cb[co]=lab[ti];co=co+1;ti=ti+1;}
    ns=_zag_i64_to_str(cr as i64);
    ti=0;while(ti<ns.len){cb[co]=ns[ti];co=co+1;ti=ti+1;}
    nio_free(ns);
    cb[co]=10;co=co+1;
    write_file(outdir,"y6_checker.txt",cb[0..co]);
    hfree(&s,cb);
    // stdout stays perturbation-agnostic: the runner's directory records which
    // perturbation ran, and m8_compare.py requires byte-identical stdout.
    _zag_print("M8,");
    p_dec1(m1p as i64);_zag_print(",");p_dec1(m1c as i64);_zag_print(",");
    p_i64(s.led_n as i64);_zag_println("");
    hfree(&s,bout);hfree(&s,cbufs);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,img);hfree(&s,chain_in);hfree(&s,chl);
    if(aslr_pad.len>0){nio_free(aslr_pad);}
    // frag survivors: freed by OS at exit
}

// ---- Y6 selftest: negative-control proof that the checker is live ----
// Exercises the full tombstone lifecycle on a tiny store, then forges a
// ledger entry that re-issues a tombstoned (serial,gen) and proves the
// checker FAILS on it. Output: Y6SELFTEST,<probe>,<PASS|FAIL>[,<detail>].
// Exit 0 iff every probe passes (including the forged-failure probe).
fn t_y6_selftest() void {
    let s:Y6=y6_new(64,4096,256);
    let ps:*Y6=&s;
    let npass:i32=0;let nfail:i32=0;
    let id1:i32=unit_id(1,0);let id2:i32=unit_id(1,1);
    let id3:i32=unit_id(1,2);let id4:i32=unit_id(1,3);
    b_ingest(ps,id1,0,64,1);b_ingest(ps,id2,0,64,1);
    b_ingest(ps,id3,0,64,1);b_ingest(ps,id4,0,64,1);
    // P1: pin id1 -> kill must refuse loudly, refs stay 1, id stays live
    b_pin(ps,id1);
    let r1:i32=b_kill(ps,id1,1);
    let sl1:i32=slot_find(ps,id1);
    let refs1:i32=iget(ps.*.refs,sl1*4);
    let live1:i32=iget(ps.*.flags,sl1*4) & F_LIVE;
    if(r1==-1 && refs1==1 && live1!=0){
        _zag_println("Y6SELFTEST,kill_refused_refs1,PASS");npass=npass+1;
    }else{
        _zag_println("Y6SELFTEST,kill_refused_refs1,FAIL");nfail=nfail+1;
    }
    // P2: kill id2 (refs 0) -> tombstoned, gen preserved
    let r2:i32=b_kill(ps,id2,1);
    let sl2:i32=slot_find(ps,id2);
    let live2:i32=iget(ps.*.flags,sl2*4) & F_LIVE;
    let gen2:i32=iget(ps.*.gens,sl2*4);
    if(r2==0 && live2==0 && gen2==0){
        _zag_println("Y6SELFTEST,kill_tombstones,PASS");npass=npass+1;
    }else{
        _zag_println("Y6SELFTEST,kill_tombstones,FAIL");nfail=nfail+1;
    }
    // P3: re-add id2 -> new generation (gen 1), never a reuse
    b_ingest(ps,id2,0,64,1);
    let sl2b:i32=slot_find(ps,id2);
    let gen2b:i32=iget(ps.*.gens,sl2b*4);
    let live2b:i32=iget(ps.*.flags,sl2b*4) & F_LIVE;
    if(gen2b==1 && live2b!=0){
        _zag_println("Y6SELFTEST,readd_mints_gen1,PASS");npass=npass+1;
    }else{
        _zag_println("Y6SELFTEST,readd_mints_gen1,FAIL");nfail=nfail+1;
    }
    // P4: valid lifecycle passes the checker
    let out:[]u8=halloc(ps,12);
    let rc_ok:i32=y6_checker_core(ps,out);
    if(rc_ok==0){
        _zag_println("Y6SELFTEST,checker_valid_lifecycle,PASS");npass=npass+1;
    }else{
        _zag_println("Y6SELFTEST,checker_valid_lifecycle,FAIL");nfail=nfail+1;
    }
    // P5: FORGE a ledger ADD re-issuing tombstoned (serial,gen) = (id3,0).
    // Kill id3 first so (id3,0) is genuinely tombstoned, then append a forged
    // ADD with serial in b5 and gen in d1 (the real ADD layout).
    b_kill(ps,id3,1);
    let sl3:i32=slot_find(ps,id3);
    b_led(ps,OP_ADD,sl3,0,0,0,0,0,id3,0,0,0,0,0,0,0);
    let rc_bad:i32=y6_checker_core(ps,out);
    if(rc_bad==1){
        _zag_println("Y6SELFTEST,checker_catches_forged_reissue,PASS");npass=npass+1;
    }else{
        _zag_println("Y6SELFTEST,checker_catches_forged_reissue,FAIL");nfail=nfail+1;
    }
    hfree(ps,out);
    _zag_print("Y6SELFTEST,summary,");
    if(nfail==0){_zag_print("PASS,");}else{_zag_print("FAIL,");}
    p_i64(npass as i64);_zag_print(",");p_i64(nfail as i64);_zag_println("");
}

// ---- main dispatch ----
fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    if(mode.len==0){_zag_println("usage: y6 <mode> [corpus-root] [outdir] [perturbation]");return 2;}
    let croot:[]u8=_zag_arg(2);
    if(_zag_strcmp(mode,"m1-1x-prose")==1){t_m1(croot,"prose.bin",Y6_C_PROSE,"prose","m1-1x-prose");}
    else if(_zag_strcmp(mode,"m1-1x-code")==1){t_m1(croot,"code.bin",Y6_C_CODE,"code","m1-1x-code");}
    else if(_zag_strcmp(mode,"m2-t1-prose")==1){t_m2(croot,"t1_prose.bin",Y6_C_T1P,"m2-t1-prose",1);}
    else if(_zag_strcmp(mode,"m2-t1-code")==1){t_m2(croot,"t1_code.bin",Y6_C_T1C,"m2-t1-code",1);}
    else if(_zag_strcmp(mode,"m2-t2-prose")==1){t_m2(croot,"t2_prose.bin",Y6_C_T2P,"m2-t2-prose",0);}
    else if(_zag_strcmp(mode,"m2-t2-code")==1){t_m2(croot,"t2_code.bin",Y6_C_T2C,"m2-t2-code",0);}
    else if(_zag_strcmp(mode,"m2-t3-1x")==1){t_m2(croot,"t3.bin",Y6_C_T3,"m2-t3-1x",0);}
    else if(_zag_strcmp(mode,"m3-1x")==1){t_m3(croot);}
    else if(_zag_strcmp(mode,"m4-1x-prose")==1){t_m4(croot,"prose.bin",Y6_C_PROSE,0,"m4-1x-prose");}
    else if(_zag_strcmp(mode,"m4-1x-code")==1){t_m4(croot,"code.bin",Y6_C_CODE,1,"m4-1x-code");}
    else if(_zag_strcmp(mode,"m5-1x")==1){t_m5(croot);}
    else if(_zag_strcmp(mode,"m5-baseline")==1){
        // Empty-store RSS baseline: allocate the same empty store m5-1x uses,
        // touch it, then spin briefly so the harness RSS sampler can observe
        // the peak. The spin is measurement scaffolding, not arm cognition.
        let psz:i64=file_size(croot,"prose.bin");
        if(psz<=0){_zag_println("M5,FATAL,empty-corpus");return 1;}
        let pn:i32=nunits_of(psz as i32);
        let bs:Y6=y6_new(pn+pn/4+4096,pn+4096,pn+2048);
        // fully touch the empty store so it is resident: the baseline RSS
        // must contain the whole slot region, leaving no double-count in
        // the literal (rss_delta + slot_table) formula (AMBIGUITIES.md A4).
        let b0:[]u8=bs.ids;let b1:[]u8=bs.offs;let b2:[]u8=bs.lens;let b3:[]u8=bs.corps;
        let b4:[]u8=bs.flags;let b5:[]u8=bs.shifts;let b6:[]u8=bs.pidx;let b7:[]u8=bs.ins;
        let bj:i32=0;
        while(bj<b0.len){b0[bj]=0;b1[bj]=0;b2[bj]=0;b3[bj]=0;b4[bj]=0;b5[bj]=0;b6[bj]=0;bj=bj+1;}
        bj=0;
        while(bj<b7.len){b7[bj]=0;bj=bj+1;}
        _zag_println("M5_BASELINE,ok");
        let f:i32=0;
        j_begin("m5-baseline");
        jf_bool(&f,"m5_baseline",1);
        j_end();
        let spin:i64=0;while(spin<300000000){spin=spin+1;}
    }
    else if(_zag_strcmp(mode,"m6-p2c-1x")==1){t_m6(croot,0);}
    else if(_zag_strcmp(mode,"m6-c2p-1x")==1){t_m6(croot,1);}
    else if(_zag_strcmp(mode,"m7-1x")==1){t_m7(croot);}
    else if(_zag_strcmp(mode,"m8-1x")==1){
        let outdir:[]u8=_zag_arg(3);
        let pert:[]u8=_zag_arg(4);
        if(outdir.len==0 || pert.len==0){
            _zag_println("usage: y6 m8-1x <corpus-root> <outdir> <perturbation>");
            return 2;
        }
        t_m8(croot,outdir,pert);
    }
    else if(_zag_strcmp(mode,"y6-selftest")==1){t_y6_selftest();}
    else{_zag_print("unknown mode: ");_zag_println(mode);return 2;}
    return 0;
}

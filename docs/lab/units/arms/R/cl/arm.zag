// R — Compression cuts (MDL/DP). Track A, arm R (CUT family).
// Mechanism: chunks are compression units: cut where description length is
// minimized (suffix-array/LCP + DP over cost).
// Pure Zag, zero RNG in any decision path, byte-identical reruns.
// One binary; argv[1] selects the trial mode (ARM_INTERFACE.md section 3).
//
// Build authority: (1) units/arms/briefs/R.json; (2) the verbatim frozen
// section-3 row (coordinator correction 2026-09-21); (3) nothing else.
// Full build spec: units/arms/R/ARM_SPEC.md
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

const R_L:i32=64;          // frozen max repeat length
const R_REF:i32=2;         // frozen dictionary reference cost (bytes)
const R_BATCH:i32=4096;    // SCAN_COMMIT batch size (audit economics)
const R_C_PROSE:i32=1;
const R_C_CODE:i32=2;
const R_C_T1P:i32=3;
const R_C_T1C:i32=4;
const R_C_T2P:i32=5;
const R_C_T2C:i32=6;
const R_C_T3:i32=7;
const R_C_FRESH:i32=8;
const R_C_CPRIME:i32=9;    // M7 modified prose (documented extension)
const R_M3_CAP:i32=4000;   // C_M3: harness-fixed M3 store capacity (slots)
const R_M3_V:i32=1000;
const R_M3_FRESH1:i32=3000;
const R_M3_KILL:i32=3000;
const R_M3_FRESH2:i32=4000;
const R_M4_N:i32=200;
const R_M7_LOOKUPS:i32=5000;

// flags bits
const F_OCC:i32=1;
const F_LIVE:i32=2;
const F_PIN:i32=4;
const F_WEAK:i32=8;
const F_SHIFT:i32=16;
const F_PATCH:i32=32;

// ledger opcodes (frozen namespace, ARM_INTERFACE.md section 6)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_SCAN:i32=7;
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_TDB:i32=16;
const OP_TDC:i32=17;
const OP_TMV:i32=18;
const OP_TSWAP:i32=19;

// ---- little-endian u32/i32 packing on []u8 ----
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }
// chunked u32 pair access (each slice <= 2^25 bytes; se = entries per slice)
fn cget(a0:[]u8,a1:[]u8,se:i32,i:i32)i32 {
    if(i<se){return iget(a0,i*4);}
    return iget(a1,(i-se)*4);
}
fn cset(a0:[]u8,a1:[]u8,se:i32,i:i32,v:i32)void {
    if(i<se){iput(a0,i*4,v);}else{iput(a1,(i-se)*4,v);}
}

// ---- arm state ----
struct R {
    cap:i32,
    ids:[]u8,
    offs:[]u8,
    lens:[]u8,
    corps:[]u8,
    flags:[]u8,
    shifts:[]u8,
    pidx:[]u8,
    patches:[]u8,
    patch_n:i32,
    patch_cap:i32,
    led:[]u8,
    led_n:i32,
    led_cap:i32,
    ins:[]u8,
    ins_cap:i32,
    ins_n:i32,
    ins_head:i32,
    trace:[]u8,
    trace_n:i32,
    trace_cap:i32,
    nlive:i32,
    segb0:[]u8,
    segb1:[]u8,
    segn:i32,
    segbse:i32,
}

// ---- allocator wrappers with trace (addresses never logged) ----
fn halloc(s:*R,n:i32)[]u8 {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(n as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=65;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    return nio_alloc(n);
}
fn hfree(s:*R,b:[]u8)void {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(b.len as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=70;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    nio_free(b);
}
fn r_trace_init(s:*R)void {
    // trace only: lets modes run segmentation (which needs halloc) before
    // the store is sized. The initial trace buffer itself is never logged.
    s.*.trace_cap=65536;s.*.trace=nio_alloc(65536);s.*.trace_n=0;
}
fn r_init(s:*R,cap:i32,led_entries:i32,ins_max:i32)void {
    s.*.cap=cap;s.*.nlive=0;
    s.*.ids=halloc(s,cap*4);s.*.offs=halloc(s,cap*4);s.*.lens=halloc(s,cap*4);
    s.*.corps=halloc(s,cap*4);
    s.*.flags=halloc(s,cap*4);s.*.shifts=halloc(s,cap*4);
    s.*.pidx=halloc(s,cap*4);
    let i:i32=0;while(i<cap){iput(s.*.pidx,i*4,-1);i=i+1;}
    s.*.patch_cap=1024;s.*.patches=halloc(s,1024*64);s.*.patch_n=0;
    s.*.led_cap=led_entries*64;s.*.led=halloc(s,s.*.led_cap);s.*.led_n=0;
    s.*.ins=halloc(s,ins_max*4);s.*.ins_cap=ins_max;s.*.ins_n=0;s.*.ins_head=0;
}
fn r_new(cap:i32,led_entries:i32,ins_max:i32) R {
    let s:R=R{.cap=0,.ids="",.offs="",.lens="",.corps="",.flags="",
        .shifts="",.pidx="",.patches="",.patch_n=0,.patch_cap=0,.led="",
        .led_n=0,.led_cap=0,.ins="",.ins_cap=0,.ins_n=0,.ins_head=0,.trace="",
        .trace_n=0,.trace_cap=0,.nlive=0,.segb0="",.segb1="",.segn=0,.segbse=0};
    r_trace_init(&s);
    r_init(&s,cap,led_entries,ins_max);
    return s;
}
// zero state with trace only (for pre-sizing segmentation)
fn r_new_trace() R {
    let s:R=R{.cap=0,.ids="",.offs="",.lens="",.corps="",.flags="",
        .shifts="",.pidx="",.patches="",.patch_n=0,.patch_cap=0,.led="",
        .led_n=0,.led_cap=0,.ins="",.ins_cap=0,.ins_n=0,.ins_head=0,.trace="",
        .trace_n=0,.trace_cap=0,.nlive=0,.segb0="",.segb1="",.segn=0,.segbse=0};
    r_trace_init(&s);
    return s;
}

// ---- ledger ----
fn r_led(s:*R,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
         a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)void {
    let at:i32=s.*.led_n*64;
    if(at+64>s.*.led_cap){return;} // LEDGER-BOUND: scored on what completed
    let l:[]u8=s.*.led;
    iput(l,at,op);iput(l,at+4,slot);iput(l,at+8,rc);
    iput(l,at+12,b1);iput(l,at+16,b2);iput(l,at+20,b3);iput(l,at+24,b4);iput(l,at+28,b5);
    iput(l,at+32,a1);iput(l,at+36,a2);iput(l,at+40,a3);iput(l,at+44,a4);iput(l,at+48,a5);
    iput(l,at+52,1);iput(l,at+56,d1);iput(l,at+60,d2);
    s.*.led_n=s.*.led_n+1;
}

// ---- slot placement: id-derived (order-independent), linear probe ----
fn slot_hash(id:i32,cap:i32) i32 {
    let x:i64=(id as i64)*2654435761;
    x=x ^ (x>>16);
    x=x*2246822519;
    x=x ^ (x>>13);
    let h:i64=x % (cap as i64);
    if(h<0){h=h+(cap as i64);}
    return h as i32;
}
fn slot_find(s:*R,id:i32) i32 {
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let flags:[]u8=s.*.flags;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){return -1;}
        if(iget(ids,h*4)==id){return h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    return -1;
}
fn slot_insert(s:*R,id:i32,off:i32,len:i32,corpus:i32) i32 {
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let offs:[]u8=s.*.offs;let lens:[]u8=s.*.lens;
    let corps:[]u8=s.*.corps;let flags:[]u8=s.*.flags;let shifts:[]u8=s.*.shifts;
    let pidx:[]u8=s.*.pidx;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;let first_dead:i32=-1;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){
            let sl:i32=h;
            if(first_dead>=0){sl=first_dead;}
            iput(ids,sl*4,id);iput(offs,sl*4,off);iput(lens,sl*4,len);
            iput(corps,sl*4,corpus);iput(flags,sl*4,F_OCC | F_LIVE);
            iput(shifts,sl*4,0);iput(pidx,sl*4,-1);
            let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
            s.*.nlive=s.*.nlive+1;
            return sl;
        }
        if(iget(ids,h*4)==id){
            iput(offs,h*4,off);iput(lens,h*4,len);iput(corps,h*4,corpus);
            let f2:i32=iget(flags,h*4);
            if((f2 & F_LIVE)==0){s.*.nlive=s.*.nlive+1;}
            iput(flags,h*4,(f2 | F_OCC) | F_LIVE);
            return h;
        }
        if(((f & F_LIVE)==0) && first_dead<0){first_dead=h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    if(first_dead>=0){
        let sl:i32=first_dead;
        iput(ids,sl*4,id);iput(offs,sl*4,off);iput(lens,sl*4,len);
        iput(corps,sl*4,corpus);iput(flags,sl*4,F_OCC | F_LIVE);
        iput(shifts,sl*4,0);iput(pidx,sl*4,-1);
        let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
        s.*.nlive=s.*.nlive+1;
        return sl;
    }
    return -1;
}

// ---- core ops (deliberate memory ops; names per ARM_INTERFACE.md section 5) ----
fn r_ingest(s:*R,id:i32,off:i32,len:i32,corpus:i32) i32 {
    let sl:i32=slot_insert(s,id,off,len,corpus);
    if(sl<0){
        r_led(s,OP_REFUSE,-1,1,off,0,len,corpus,id,0,0,0,0,0,101,0);
        return -1;
    }
    r_led(s,OP_ADD,sl,0,off,0,len,corpus,id,0,0,0,0,0,id,0);
    return sl;
}
// bulk ingest of a derived segmentation: one SCAN_COMMIT per batch
// (audit-economics exemption, ARM_SPEC.md section 2). b0/b1 = chunked
// boundaries, bse = entries per slice, first = first chunk index.
fn r_ingest_cuts(s:*R,b0:[]u8,b1:[]u8,bse:i32,first:i32,count:i32,corpus:i32) i32 {
    let j:i32=0;
    while(j<count){
        let idx:i32=first+j;
        let id:i32=(corpus<<24)|idx;
        let off:i32=cget(b0,b1,bse,idx);
        let len:i32=cget(b0,b1,bse,idx+1)-off;
        let sl:i32=slot_insert(s,id,off,len,corpus);
        if(sl<0){
            r_led(s,OP_REFUSE,-1,1,off,0,len,corpus,id,0,0,0,0,0,101,0);
            return -1;
        }
        j=j+1;
    }
    let off0:i32=cget(b0,b1,bse,first);
    let off1:i32=cget(b0,b1,bse,first+count);
    r_led(s,OP_SCAN,-1,0,off0,0,off1-off0,corpus,(corpus<<24)|first,
          0,0,0,0,0,(corpus<<24)|first,count);
    return 0;
}
fn r_recall(s:*R,cbufs:[]u8,coffs:[]u8,clens:[]u8,id:i32,out:[]u8) i32 {
    // ID-arm retrieval path: ONLY the id; the slot table is genuinely consulted.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    let len:i32=iget(s.*.lens,sl*4);
    let corpus:i32=iget(s.*.corps,sl*4);
    if((f & F_PATCH)!=0){
        let pi:i32=iget(s.*.pidx,sl*4);
        let pb:[]u8=s.*.patches;
        let i:i32=0;while(i<len){out[i]=pb[pi*64+i];i=i+1;}
        return len;
    }
    let bo:i32=iget(coffs,(corpus-1)*4);
    let bl:i32=iget(clens,(corpus-1)*4);
    let off:i32=iget(s.*.offs,sl*4);
    if((f & F_SHIFT)!=0){off=off+iget(s.*.shifts,sl*4);}
    if(off<0){off=0;}
    if(off+len>bo+bl){len=bo+bl-off;}
    if(len<=0){return -1;}
    let i2:i32=0;while(i2<len){out[i2]=cbufs[bo+off+i2];i2=i2+1;}
    return len;
}
fn r_kill(s:*R,id:i32,reason:i32) i32 {
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    iput(flags,sl*4,f & (0-1-F_LIVE));
    s.*.nlive=s.*.nlive-1;
    r_led(s,OP_KILL,sl,0,0,0,0,0,id,0,0,0,0,0,reason,0);
    return 0;
}
fn r_pin(s:*R,id:i32) i32 {
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_PIN);
    r_led(s,OP_PIN,sl,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return 0;
}
fn r_weaken(s:*R,id:i32,seq:i32) i32 {
    // R's documented weaken policy: processed as a management annotation
    // (WEAKENED flag, audited). Never changes stored bytes.
    let sl:i32=slot_find(s,id);
    if(sl<0){
        r_led(s,OP_REFUSE,-1,1,0,0,0,0,id,0,0,0,0,0,102,0);
        return -1;
    }
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_WEAK);
    r_led(s,OP_WEAKEN,sl,0,0,0,0,0,id,0,0,0,0,0,seq,0);
    return 0;
}
fn r_defect_boundary(s:*R,id:i32,delta:i32) i32 {
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let shifts:[]u8=s.*.shifts;let flags:[]u8=s.*.flags;
    iput(shifts,sl*4,delta);iput(flags,sl*4,iget(flags,sl*4) | F_SHIFT);
    r_led(s,OP_TDB,sl,0,0,0,0,0,id,0,0,0,0,0,delta,0);
    return 0;
}
fn r_defect_content(s:*R,id:i32,patch:[]u8,plen:i32) i32 {
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    if(s.*.patch_n>=s.*.patch_cap){return -1;}
    let pi:i32=s.*.patch_n;
    let pb:[]u8=s.*.patches;
    let i:i32=0;while(i<plen){pb[pi*64+i]=patch[i];i=i+1;}
    while(i<64){pb[pi*64+i]=0;i=i+1;}
    s.*.patch_n=pi+1;
    iput(s.*.pidx,sl*4,pi);
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_PATCH);
    r_led(s,OP_TDC,sl,0,0,0,0,0,id,0,0,0,0,0,plen,0);
    return 0;
}
fn r_defect(s:*R,patches:[]u8,cids0:[]u8,cids1:[]u8,cidx0:[]u8,cidx1:[]u8,se:i32,n:i32) i32 {
    let tmp:[]u8=halloc(s,32);
    let t:i32=0;
    while(t<n){
        let cid:i32=cget(cids0,cids1,se,t);
        let cix:i32=cget(cidx0,cidx1,se,t);
        let po:i32=t*32;
        let i:i32=0;
        while(i<32){tmp[i]=patches[po+i];i=i+1;}
        r_defect_content(s,(cid<<24)|cix,tmp,32);
        t=t+1;
    }
    return 0;
}
fn r_revise1(s:*R,id:i32) i32 {
    // deliberate repair: drop recorded shift/patch. Same ID + REVISE entry.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    if((f & (F_SHIFT | F_PATCH))==0){return 0;}
    let old_off:i32=iget(s.*.offs,sl*4)+iget(s.*.shifts,sl*4);
    iput(s.*.shifts,sl*4,0);
    iput(s.*.pidx,sl*4,-1);
    iput(flags,sl*4,f & (0-1-F_SHIFT-F_PATCH));
    let new_off:i32=iget(s.*.offs,sl*4);
    r_led(s,OP_REVISE,sl,0,iget(s.*.offs,sl*4),0,iget(s.*.lens,sl*4),
          iget(s.*.corps,sl*4),id,0,0,0,0,0,old_off,new_off);
    return 1;
}
fn r_revise(s:*R,cids0:[]u8,cids1:[]u8,cidx0:[]u8,cidx1:[]u8,se:i32,n:i32) i32 {
    let t:i32=0;
    while(t<n){
        let cid:i32=cget(cids0,cids1,se,t);
        let cix:i32=cget(cidx0,cidx1,se,t);
        r_revise1(s,(cid<<24)|cix);
        t=t+1;
    }
    return 0;
}
fn r_evict_oldest_unpinned(s:*R) i32 {
    let ins:[]u8=s.*.ins;let flags:[]u8=s.*.flags;
    while(s.*.ins_head<s.*.ins_n){
        let sl:i32=iget(ins,s.*.ins_head*4);
        s.*.ins_head=s.*.ins_head+1;
        let f:i32=iget(flags,sl*4);
        if((f & F_LIVE)!=0 && (f & F_PIN)==0){
            let id:i32=iget(s.*.ids,sl*4);
            iput(flags,sl*4,f & (0-1-F_LIVE));
            s.*.nlive=s.*.nlive-1;
            r_led(s,OP_EVICT,sl,0,0,0,0,0,id,0,0,0,0,0,1,0);
            return id;
        }
    }
    return -1;
}
fn r_mark_valuable(s:*R,id:i32) i32 {
    r_led(s,OP_TMV,-1,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return r_pin(s,id);
}
// M1 swap probe (A15 proposed schedule; PROVISIONAL-PENDING-FREEZE).
// Patch target slot's record to the next live slot's span, recall, verify
// the remapped bytes come back (PASS) or a loud failure, then restore.
fn r_swap_probe(s:*R,cbufs:[]u8,coffs:[]u8,clens:[]u8,id:i32,probe_idx:i32,
                out:[]u8,exp:[]u8) i32 {
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let cap:i32=s.*.cap;
    let flags:[]u8=s.*.flags;
    let s2:i32=sl+1;if(s2>=cap){s2=0;}
    let t:i32=0;
    while(t<cap){
        let f:i32=iget(flags,s2*4);
        if((f & F_OCC)!=0 && (f & F_LIVE)!=0 && s2!=sl){break;}
        s2=s2+1;if(s2>=cap){s2=0;}t=t+1;
    }
    if(t>=cap){return -1;}
    let sv_off:i32=iget(s.*.offs,sl*4);
    let sv_len:i32=iget(s.*.lens,sl*4);
    let sv_cor:i32=iget(s.*.corps,sl*4);
    let r_off:i32=iget(s.*.offs,s2*4);
    let r_len:i32=iget(s.*.lens,s2*4);
    let r_cor:i32=iget(s.*.corps,s2*4);
    iput(s.*.offs,sl*4,r_off);iput(s.*.lens,sl*4,r_len);iput(s.*.corps,sl*4,r_cor);
    r_led(s,OP_TSWAP,sl,0,r_off,0,r_len,r_cor,id,0,0,0,0,0,probe_idx,s2);
    let rl:i32=r_recall(s,cbufs,coffs,clens,id,out);
    iput(s.*.offs,sl*4,sv_off);iput(s.*.lens,sl*4,sv_len);iput(s.*.corps,sl*4,sv_cor);
    if(rl!=r_len){return 0;}
    let bo:i32=iget(coffs,(r_cor-1)*4);
    let i:i32=0;
    while(i<rl){exp[i]=cbufs[bo+r_off+i];i=i+1;}
    let good:i32=1;
    i=0;while(i<rl){if(out[i]!=exp[i]){good=0;break;}i=i+1;}
    if(good==1){return 1;}
    return 0;
}

// ---- file IO ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}
// ---- JSON emission (schema metrics-v1) ----
fn j_begin(mode:[]u8,scale:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"r\",\"round\":\"r1\",\"scale\":\"");
    _zag_print(scale);
    _zag_print("\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn jf_null(f:*i32,key:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":null");
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }

// ---- segmentation: suffix array (prefix doubling, deterministic) ----
fn seg_build_sa(s:*R, buf:[]u8, n:i32, sa0:[]u8, sa1:[]u8, se:i32, L:i32) void {
    let se4:i32=se*4;
    let tm0:[]u8=halloc(s,se*4); let tm1:[]u8=halloc(s,se*4);
    let rka:[]u8=halloc(s,se*4); let rkb:[]u8=halloc(s,se*4);
    let nra:[]u8=halloc(s,se*4); let nrb:[]u8=halloc(s,se*4);
    let se_c:i32=se;
    if(se_c<129){se_c=129;}
    let sec4:i32=se_c*4;
    let cn0:[]u8=halloc(s,se_c*4); let cn1:[]u8=halloc(s,se_c*4);
    let i:i32=0; let o:i32=0; let q:i32=0; let g:i64=0;
    let si:i32=0; let sk:i32=0; let key:i32=0; let pos:i32=0;
    let c:i32=0; let sum:i32=0; let t2v:i32=0;
    let a:i32=0; let b:i32=0; let ka:i32=0; let kb:i32=0;
    let ak:i32=0; let bk:i32=0; let ra:i32=0; let rb:i32=0;
    let r:i32=0; let kk:i32=0; let k:i32=1; let maxr:i32=255; let done:i32=0;
    // init: sa[i]=i, rk[i]=buf[i]
    i=0;
    while(i<n){
        o=i*4; g=i as i64;
        if(i<se){
            sa0[o]=(g & 255) as u8; sa0[o+1]=((g>>8) & 255) as u8;
            sa0[o+2]=((g>>16) & 255) as u8; sa0[o+3]=((g>>24) & 255) as u8;
        }else{
            q=o-se4;
            sa1[q]=(g & 255) as u8; sa1[q+1]=((g>>8) & 255) as u8;
            sa1[q+2]=((g>>16) & 255) as u8; sa1[q+3]=((g>>24) & 255) as u8;
        }
        g=buf[i] as i64;
        if(i<se){
            rka[o]=(g & 255) as u8; rka[o+1]=((g>>8) & 255) as u8;
            rka[o+2]=((g>>16) & 255) as u8; rka[o+3]=((g>>24) & 255) as u8;
        }else{
            q=o-se4;
            rkb[q]=(g & 255) as u8; rkb[q+1]=((g>>8) & 255) as u8;
            rkb[q+2]=((g>>16) & 255) as u8; rkb[q+3]=((g>>24) & 255) as u8;
        }
        i=i+1;
    }
    while(done==0){
        // ---- pass 1: sa -> tm by key2 = (si+k<n) ? rk[si+k]+1 : 0 ----
        kk=maxr+2;
        c=0;
        while(c<kk){
            o=c*4; g=0;
            if(c<se_c){
                cn0[o]=(g & 255) as u8; cn0[o+1]=((g>>8) & 255) as u8;
                cn0[o+2]=((g>>16) & 255) as u8; cn0[o+3]=((g>>24) & 255) as u8;
            }else{
                q=o-sec4;
                cn1[q]=(g & 255) as u8; cn1[q+1]=((g>>8) & 255) as u8;
                cn1[q+2]=((g>>16) & 255) as u8; cn1[q+3]=((g>>24) & 255) as u8;
            }
            c=c+1;
        }
        i=0;
        while(i<n){
            o=i*4;
            if(i<se){g=(sa0[o] as i64)+((sa0[o+1] as i64)<<8)+((sa0[o+2] as i64)<<16)+((sa0[o+3] as i64)<<24;}
            else{q=o-se4;g=(sa1[q] as i64)+((sa1[q+1] as i64)<<8)+((sa1[q+2] as i64)<<16)+((sa1[q+3] as i64)<<24);}
            si=g as i32;
            key=0; sk=si+k;
            if(sk<n){
                o=sk*4;
                if(sk<se){g=(rka[o] as i64)+((rka[o+1] as i64)<<8)+((rka[o+2] as i64)<<16)+((rka[o+3] as i64)<<24;}
                else{q=o-se4;g=(rkb[q] as i64)+((rkb[q+1] as i64)<<8)+((rkb[q+2] as i64)<<16)+((rkb[q+3] as i64)<<24);}
                key=(g as i32)+1;
            }
            o=key*4;
            if(key<se_c){g=(cn0[o] as i64)+((cn0[o+1] as i64)<<8)+((cn0[o+2] as i64)<<16)+((cn0[o+3] as i64)<<24;}
            else{q=o-sec4;g=(cn1[q] as i64)+((cn1[q+1] as i64)<<8)+((cn1[q+2] as i64)<<16)+((cn1[q+3] as i64)<<24);}
            g=g+1;
            if(key<se_c){
                cn0[o]=(g & 255) as u8; cn0[o+1]=((g>>8) & 255) as u8;
                cn0[o+2]=((g>>16) & 255) as u8; cn0[o+3]=((g>>24) & 255) as u8;
            }else{
                q=o-sec4;
                cn1[q]=(g & 255) as u8; cn1[q+1]=((g>>8) & 255) as u8;
                cn1[q+2]=((g>>16) & 255) as u8; cn1[q+3]=((g>>24) & 255) as u8;
            }
            i=i+1;
        }
        sum=0; c=0;
        while(c<kk){
            o=c*4;
            if(c<se_c){g=(cn0[o] as i64)+((cn0[o+1] as i64)<<8)+((cn0[o+2] as i64)<<16)+((cn0[o+3] as i64)<<24;}
            else{q=o-sec4;g=(cn1[q] as i64)+((cn1[q+1] as i64)<<8)+((cn1[q+2] as i64)<<16)+((cn1[q+3] as i64)<<24);}
            t2v=g as i32; g=sum as i64;
            if(c<se_c){
                cn0[o]=(g & 255) as u8; cn0[o+1]=((g>>8) & 255) as u8;
                cn0[o+2]=((g>>16) & 255) as u8; cn0[o+3]=((g>>24) & 255) as u8;
            }else{
                q=o-sec4;
                cn1[q]=(g & 255) as u8; cn1[q+1]=((g>>8) & 255) as u8;
                cn1[q+2]=((g>>16) & 255) as u8; cn1[q+3]=((g>>24) & 255) as u8;
            }
            sum=sum+t2v; c=c+1;
        }
        i=0;
        while(i<n){
            o=i*4;
            if(i<se){g=(sa0[o] as i64)+((sa0[o+1] as i64)<<8)+((sa0[o+2] as i64)<<16)+((sa0[o+3] as i64)<<24);}
            else{q=o-se4;g=(sa1[q] as i64)+((sa1[q+1] as i64)<<8)+((sa1[q+2] as i64)<<16)+((sa1[q+3] as i64)<<24);}
            si=g as i32;
            key=0; sk=si+k;
            if(sk<n){
                o=sk*4;
                if(sk<se){g=(rka[o] as i64)+((rka[o+1] as i64)<<8)+((rka[o+2] as i64)<<16)+((rka[o+3] as i64)<<24);}
                else{q=o-se4;g=(rkb[q] as i64)+((rkb[q+1] as i64)<<8)+((rkb[q+2] as i64)<<16)+((rkb[q+3] as i64)<<24);}
                key=(g as i32)+1;
            }
            o=key*4;
            if(key<se_c){g=(cn0[o] as i64)+((cn0[o+1] as i64)<<8)+((cn0[o+2] as i64)<<16)+((cn0[o+3] as i64)<<24);}
            else{q=o-sec4;g=(cn1[q] as i64)+((cn1[q+1] as i64)<<8)+((cn1[q+2] as i64)<<16)+((cn1[q+3] as i64)<<24);}
            pos=g as i32;
            o=pos*4; g=si as i64;
            if(pos<se){
                tm0[o]=(g & 255) as u8; tm0[o+1]=((g>>8) & 255) as u8;
                tm0[o+2]=((g>>16) & 255) as u8; tm0[o+3]=((g>>24) & 255) as u8;
            }else{
                q=o-se4;
                tm1[q]=(g & 255) as u8; tm1[q+1]=((g>>8) & 255) as u8;
                tm1[q+2]=((g>>16) & 255) as u8; tm1[q+3]=((g>>24) & 255) as u8;
            }
            g=(pos+1) as i64; o=key*4;
            if(key<se_c){
                cn0[o]=(g & 255) as u8; cn0[o+1]=((g>>8) & 255) as u8;
                cn0[o+2]=((g>>16) & 255) as u8; cn0[o+3]=((g>>24) & 255) as u8;
            }else{
                q=o-sec4;
                cn1[q]=(g & 255) as u8; cn1[q+1]=((g>>8) & 255) as u8;
                cn1[q+2]=((g>>16) & 255) as u8; cn1[q+3]=((g>>24) & 255) as u8;
            }
            i=i+1;
        }
        // ---- pass 2: tm -> sa by key1 = rk[si] (stable) ----
        kk=maxr+1;
        c=0;
        while(c<kk){
            o=c*4; g=0;
            if(c<se_c){
                cn0[o]=(g & 255) as u8; cn0[o+1]=((g>>8) & 255) as u8;
                cn0[o+2]=((g>>16) & 255) as u8; cn0[o+3]=((g>>24) & 255) as u8;
            }else{
                q=o-sec4;
                cn1[q]=(g & 255) as u8; cn1[q+1]=((g>>8) & 255) as u8;
                cn1[q+2]=((g>>16) & 255) as u8; cn1[q+3]=((g>>24) & 255) as u8;
            }
            c=c+1;
        }
        i=0;
        while(i<n){
            o=i*4;
            if(i<se){g=(tm0[o] as i64)+((tm0[o+1] as i64)<<8)+((tm0[o+2] as i64)<<16)+((tm0[o+3] as i64)<<24);}
            else{q=o-se4;g=(tm1[q] as i64)+((tm1[q+1] as i64)<<8)+((tm1[q+2] as i64)<<16)+((tm1[q+3] as i64)<<24);}
            si=g as i32;
            o=si*4;
            if(si<se){g=(rka[o] as i64)+((rka[o+1] as i64)<<8)+((rka[o+2] as i64)<<16)+((rka[o+3] as i64)<<24);}
            else{q=o-se4;g=(rkb[q] as i64)+((rkb[q+1] as i64)<<8)+((rkb[q+2] as i64)<<16)+((rkb[q+3] as i64)<<24);}
            key=g as i32;
            o=key*4;
            if(key<se_c){g=(cn0[o] as i64)+((cn0[o+1] as i64)<<8)+((cn0[o+2] as i64)<<16)+((cn0[o+3] as i64)<<24);}
            else{q=o-sec4;g=(cn1[q] as i64)+((cn1[q+1] as i64)<<8)+((cn1[q+2] as i64)<<16)+((cn1[q+3] as i64)<<24);}
            g=g+1;
            if(key<se_c){
                cn0[o]=(g & 255) as u8; cn0[o+1]=((g>>8) & 255) as u8;
                cn0[o+2]=((g>>16) & 255) as u8; cn0[o+3]=((g>>24) & 255) as u8;
            }else{
                q=o-sec4;
                cn1[q]=(g & 255) as u8; cn1[q+1]=((g>>8) & 255) as u8;
                cn1[q+2]=((g>>16) & 255) as u8; cn1[q+3]=((g>>24) & 255) as u8;
            }
            i=i+1;
        }
        sum=0; c=0;
        while(c<kk){
            o=c*4;
            if(c<se_c){g=(cn0[o] as i64)+((cn0[o+1] as i64)<<8)+((cn0[o+2] as i64)<<16)+((cn0[o+3] as i64)<<24);}
            else{q=o-sec4;g=(cn1[q] as i64)+((cn1[q+1] as i64)<<8)+((cn1[q+2] as i64)<<16)+((cn1[q+3] as i64)<<24);}
            t2v=g as i32; g=sum as i64;
            if(c<se_c){
                cn0[o]=(g & 255) as u8; cn0[o+1]=((g>>8) & 255) as u8;
                cn0[o+2]=((g>>16) & 255) as u8; cn0[o+3]=((g>>24) & 255) as u8;
            }else{
                q=o-sec4;
                cn1[q]=(g & 255) as u8; cn1[q+1]=((g>>8) & 255) as u8;
                cn1[q+2]=((g>>16) & 255) as u8; cn1[q+3]=((g>>24) & 255) as u8;
            }
            sum=sum+t2v; c=c+1;
        }
        i=0;
        while(i<n){
            o=i*4;
            if(i<se){g=(tm0[o] as i64)+((tm0[o+1] as i64)<<8)+((tm0[o+2] as i64)<<16)+((tm0[o+3] as i64)<<24);}
            else{q=o-se4;g=(tm1[q] as i64)+((tm1[q+1] as i64)<<8)+((tm1[q+2] as i64)<<16)+((tm1[q+3] as i64)<<24);}
            si=g as i32;
            o=si*4;
            if(si<se){g=(rka[o] as i64)+((rka[o+1] as i64)<<8)+((rka[o+2] as i64)<<16)+((rka[o+3] as i64)<<24);}
            else{q=o-se4;g=(rkb[q] as i64)+((rkb[q+1] as i64)<<8)+((rkb[q+2] as i64)<<16)+((rkb[q+3] as i64)<<24);}
            key=g as i32;
            o=key*4;
            if(key<se_c){g=(cn0[o] as i64)+((cn0[o+1] as i64)<<8)+((cn0[o+2] as i64)<<16)+((cn0[o+3] as i64)<<24);}
            else{q=o-sec4;g=(cn1[q] as i64)+((cn1[q+1] as i64)<<8)+((cn1[q+2] as i64)<<16)+((cn1[q+3] as i64)<<24);}
            pos=g as i32;
            o=pos*4; g=si as i64;
            if(pos<se){
                sa0[o]=(g & 255) as u8; sa0[o+1]=((g>>8) & 255) as u8;
                sa0[o+2]=((g>>16) & 255) as u8; sa0[o+3]=((g>>24) & 255) as u8;
            }else{
                q=o-se4;
                sa1[q]=(g & 255) as u8; sa1[q+1]=((g>>8) & 255) as u8;
                sa1[q+2]=((g>>16) & 255) as u8; sa1[q+3]=((g>>24) & 255) as u8;
            }
            g=(pos+1) as i64; o=key*4;
            if(key<se_c){
                cn0[o]=(g & 255) as u8; cn0[o+1]=((g>>8) & 255) as u8;
                cn0[o+2]=((g>>16) & 255) as u8; cn0[o+3]=((g>>24) & 255) as u8;
            }else{
                q=o-sec4;
                cn1[q]=(g & 255) as u8; cn1[q+1]=((g>>8) & 255) as u8;
                cn1[q+2]=((g>>16) & 255) as u8; cn1[q+3]=((g>>24) & 255) as u8;
            }
            i=i+1;
        }
        // ---- stop early once the order distinguishes the first 2k>=L bytes ----
        if(k*2>=L || k>=L){
            done=1;
        }else{
            // ---- recompute ranks into nr ----
            g=(sa0[0] as i64)+((sa0[1] as i64)<<8)+((sa0[2] as i64)<<16)+((sa0[3] as i64)<<24);
            a=g as i32;
            o=a*4; g=0;
            if(a<se){
                nra[o]=(g & 255) as u8; nra[o+1]=((g>>8) & 255) as u8;
                nra[o+2]=((g>>16) & 255) as u8; nra[o+3]=((g>>24) & 255) as u8;
            }else{
                q=o-se4;
                nrb[q]=(g & 255) as u8; nrb[q+1]=((g>>8) & 255) as u8;
                nrb[q+2]=((g>>16) & 255) as u8; nrb[q+3]=((g>>24) & 255) as u8;
            }
            r=0; i=1;
            while(i<n){
                o=(i-1)*4;
                if(i-1<se){g=(sa0[o] as i64)+((sa0[o+1] as i64)<<8)+((sa0[o+2] as i64)<<16)+((sa0[o+3] as i64)<<24);}
                else{q=o-se4;g=(sa1[q] as i64)+((sa1[q+1] as i64)<<8)+((sa1[q+2] as i64)<<16)+((sa1[q+3] as i64)<<24);}
                a=g as i32;
                o=i*4;
                if(i<se){g=(sa0[o] as i64)+((sa0[o+1] as i64)<<8)+((sa0[o+2] as i64)<<16)+((sa0[o+3] as i64)<<24);}
                else{q=o-se4;g=(sa1[q] as i64)+((sa1[q+1] as i64)<<8)+((sa1[q+2] as i64)<<16)+((sa1[q+3] as i64)<<24);}
                b=g as i32;
                ka=0; kb=0; ak=a+k; bk=b+k;
                if(ak<n){
                    o=ak*4;
                    if(ak<se){g=(rka[o] as i64)+((rka[o+1] as i64)<<8)+((rka[o+2] as i64)<<16)+((rka[o+3] as i64)<<24);}
                    else{q=o-se4;g=(rkb[q] as i64)+((rkb[q+1] as i64)<<8)+((rkb[q+2] as i64)<<16)+((rkb[q+3] as i64)<<24);}
                    ka=(g as i32)+1;
                }
                if(bk<n){
                    o=bk*4;
                    if(bk<se){g=(rka[o] as i64)+((rka[o+1] as i64)<<8)+((rka[o+2] as i64)<<16)+((rka[o+3] as i64)<<24);}
                    else{q=o-se4;g=(rkb[q] as i64)+((rkb[q+1] as i64)<<8)+((rkb[q+2] as i64)<<16)+((rkb[q+3] as i64)<<24);}
                    kb=(g as i32)+1;
                }
                o=a*4;
                if(a<se){g=(rka[o] as i64)+((rka[o+1] as i64)<<8)+((rka[o+2] as i64)<<16)+((rka[o+3] as i64)<<24);}
                else{q=o-se4;g=(rkb[q] as i64)+((rkb[q+1] as i64)<<8)+((rkb[q+2] as i64)<<16)+((rkb[q+3] as i64)<<24);}
                ra=g as i32;
                o=b*4;
                if(b<se){g=(rka[o] as i64)+((rka[o+1] as i64)<<8)+((rka[o+2] as i64)<<16)+((rka[o+3] as i64)<<24);}
                else{q=o-se4;g=(rkb[q] as i64)+((rkb[q+1] as i64)<<8)+((rkb[q+2] as i64)<<16)+((rkb[q+3] as i64)<<24);}
                rb=g as i32;
                if(ra!=rb || ka!=kb){r=r+1;}
                o=b*4; g=r as i64;
                if(b<se){
                    nra[o]=(g & 255) as u8; nra[o+1]=((g>>8) & 255) as u8;
                    nra[o+2]=((g>>16) & 255) as u8; nra[o+3]=((g>>24) & 255) as u8;
                }else{
                    q=o-se4;
                    nrb[q]=(g & 255) as u8; nrb[q+1]=((g>>8) & 255) as u8;
                    nrb[q+2]=((g>>16) & 255) as u8; nrb[q+3]=((g>>24) & 255) as u8;
                }
                i=i+1;
            }
            let sw0:[]u8=rka; rka=nra; nra=sw0;
            let sw1:[]u8=rkb; rkb=nrb; nrb=sw1;
            maxr=r;
            if(r==n-1){done=1;}
            k=k*2;
        }
    }
    hfree(s,tm0);hfree(s,tm1);
    hfree(s,rka);hfree(s,rkb);hfree(s,nra);hfree(s,nrb);
    hfree(s,cn0);hfree(s,cn1);
}
// maxlen[i] = min(L, longest repeat starting at i), via Kasai folded into maxlen
// maxlen[i] = min(L, longest repeat starting at i).
// SA built by truncated prefix doubling (exact to L); the adjacent-LCP fold
// is computed from scratch capped at L (exact: equal-L-prefix groups stay
// contiguous, so neighbor-max over capped LCPs equals the Kasai fold).
fn seg_maxlen(s:*R, buf:[]u8, n:i32, maxlen:[]u8, L:i32) void {
    let se:i32=(n+2)/2;
    let se4:i32=se*4;
    let sa0:[]u8=halloc(s,se*4); let sa1:[]u8=halloc(s,se*4);
    seg_build_sa(s,buf,n,sa0,sa1,se,L);
    let i:i32=0;
    while(i<n){maxlen[i]=0;i=i+1;}
    let o:i32=0; let q:i32=0; let g:i64=0;
    let p:i32=0; let qq:i32=0; let h:i32=0; let ph:i32=0; let qh:i32=0;
    i=1;
    while(i<n){
        o=(i-1)*4;
        if(i-1<se){g=(sa0[o] as i64)+((sa0[o+1] as i64)<<8)+((sa0[o+2] as i64)<<16)+((sa0[o+3] as i64)<<24);}
        else{q=o-se4;g=(sa1[q] as i64)+((sa1[q+1] as i64)<<8)+((sa1[q+2] as i64)<<16)+((sa1[q+3] as i64)<<24);}
        p=g as i32;
        o=i*4;
        if(i<se){g=(sa0[o] as i64)+((sa0[o+1] as i64)<<8)+((sa0[o+2] as i64)<<16)+((sa0[o+3] as i64)<<24);}
        else{q=o-se4;g=(sa1[q] as i64)+((sa1[q+1] as i64)<<8)+((sa1[q+2] as i64)<<16)+((sa1[q+3] as i64)<<24);}
        qq=g as i32;
        h=0;
        while(h<L){
            ph=p+h; qh=qq+h;
            if(ph>=n || qh>=n){break;}
            if(buf[ph]!=buf[qh]){break;}
            h=h+1;
        }
        if(h>(maxlen[p] as i32)){maxlen[p]=h as u8;}
        if(h>(maxlen[qq] as i32)){maxlen[qq]=h as u8;}
        i=i+1;
    }
    hfree(s,sa0);hfree(s,sa1);
}
// MDL DP: dp[n]=0; dp[i]=min_l cost(i,l)+dp[i+l]; ties -> longer chunk.
// Fills chunked boundaries b0/b1; returns chunk count.
fn seg_dp(s:*R, n:i32, maxlen:[]u8, b0:[]u8, b1:[]u8, bse:i32, L:i32, refc:i32) i32 {
    let win:[]u8=halloc(s,512);
    let w:i32=0;
    while(w<128){
        let o:i32=w*4;
        win[o]=0 as u8; win[o+1]=0 as u8; win[o+2]=0 as u8; win[o+3]=0 as u8;
        w=w+1;
    }
    // dp[n]=0
    let wn:i32=(n & 127)*4;
    win[wn]=0 as u8; win[wn+1]=0 as u8; win[wn+2]=0 as u8; win[wn+3]=0 as u8;
    let bp:[]u8=halloc(s,n);
    let i:i32=n-1;
    let o:i32=0;
    let ml:i32=0; let maxl:i32=0;
    let best:i64=0; let bestl:i32=0; let l:i32=0; let cc:i32=0;
    let base:i32=0; let slot:i32=0; let dv:i64=0; let tot:i64=0;
    while(i>=0){
        ml=maxlen[i] as i32;
        maxl=n-i;
        if(maxl>L){maxl=L;}
        best=4000000000; bestl=1;
        base=i & 127;
        // literal region: l = maxl..ml+1 descending, cc = l (no branch)
        l=maxl;
        while(l>ml){
            slot=(base+l) & 127; o=slot*4;
            dv=(win[o] as i64)+((win[o+1] as i64)<<8)+((win[o+2] as i64)<<16)+((win[o+3] as i64)<<24);
            tot=(l as i64)+dv;
            if(tot<best){best=tot;bestl=l;}
            l=l-1;
        }
        // repeat region: l = ml..1 descending, cc = refc (no branch).
        // Evaluation order is still strictly descending l, so the
        // longer-chunk-wins-ties rule is unchanged.
        l=ml;
        while(l>=1){
            slot=(base+l) & 127; o=slot*4;
            dv=(win[o] as i64)+((win[o+1] as i64)<<8)+((win[o+2] as i64)<<16)+((win[o+3] as i64)<<24);
            tot=(refc as i64)+dv;
            if(tot<best){best=tot;bestl=l;}
            l=l-1;
        }
        o=(i & 127)*4;
        win[o]=(best & 255) as u8; win[o+1]=((best>>8) & 255) as u8;
        win[o+2]=((best>>16) & 255) as u8; win[o+3]=((best>>24) & 255) as u8;
        bp[i]=bestl as u8;
        i=i-1;
    }
    let nc:i32=0;
    i=0;
    while(i<n){i=i+(bp[i] as i32);nc=nc+1;}
    cset(b0,b1,bse,0,0);
    i=0;
    let kk2:i32=1;
    while(i<n){
        i=i+(bp[i] as i32);
        cset(b0,b1,bse,kk2,i);
        kk2=kk2+1;
    }
    hfree(s,win);hfree(s,bp);
    return nc;
}
// frozen-dictionary maxlen: longest prefix of buf[i..] occurring >=2 times
// in train (train SA in tsa0/tsa1). Exact SA-interval narrowing.
// ---- frozen maxlen via suffix automaton ----
// SAM over reversed train recognizes exactly train's substrings;
// the linear walk over reversed fresh yields, for each fresh position i,
// the longest prefix of buf[i..] present in train (mapped back), capped at L.
// Replaces the SA-interval narrowing (which required >=2 occurrences in
// train; the dictionary semantics require >=1). Proven byte-identical.
// State layout (12B): link@0, len@4, head@8 (edge-list head, -1 = none).
// Edges: ech (u8 char), enx (i32 to), elk (i32 next-in-list).
// rtab: 256-entry direct transition table for the root (O(1) root lookups).
fn sam_find_edge(st:[]u8, ech:[]u8, enx:[]u8, elk:[]u8, v:i32, c:u8) i32 {
    let e:i32=iget(st,v*12+8);
    while(e!=-1){
        if(ech[e]==c){return e;}
        e=iget(elk,e*4);
    }
    return -1;
}
fn sam_build(st:[]u8, ech:[]u8, enx:[]u8, elk:[]u8, rtab:[]u8,
             buf:[]u8, n:i32, ne_out:*i32) i32 {
    iput(st,0,-1); iput(st,4,0); iput(st,8,-1);
    let i:i32=0; while(i<256){iput(rtab,i*4,-1); i=i+1;}
    let sz:i32=1; let ne:i32=0; let last:i32=0;
    let bi:i32=0;
    while(bi<n){
        let c:u8=buf[bi];
        let cur:i32=sz; sz=sz+1;
        iput(st,cur*12,-1); iput(st,cur*12+4,iget(st,last*12+4)+1); iput(st,cur*12+8,-1);
        let p:i32=last;
        while(p!=-1){
            let e:i32=-1;
            if(p==0){e=iget(rtab,(c as i32)*4);}
            else{e=sam_find_edge(st,ech,enx,elk,p,c);}
            if(e!=-1){break;}
            let ne2:i32=ne; ne=ne+1;
            ech[ne2]=c; iput(enx,ne2*4,cur);
            iput(elk,ne2*4,iget(st,p*12+8)); iput(st,p*12+8,ne2);
            if(p==0){iput(rtab,(c as i32)*4,ne2);}
            p=iget(st,p*12);
        }
        if(p==-1){iput(st,cur*12,0);}
        else{
            let e:i32=-1;
            if(p==0){e=iget(rtab,(c as i32)*4);}
            else{e=sam_find_edge(st,ech,enx,elk,p,c);}
            let q:i32=iget(enx,e*4);
            if(iget(st,p*12+4)+1==iget(st,q*12+4)){iput(st,cur*12,q);}
            else{
                let clone:i32=sz; sz=sz+1;
                iput(st,clone*12,iget(st,q*12));
                iput(st,clone*12+4,iget(st,p*12+4)+1);
                iput(st,clone*12+8,-1);
                let eq:i32=iget(st,q*12+8);
                while(eq!=-1){
                    let ne2:i32=ne; ne=ne+1;
                    ech[ne2]=ech[eq]; iput(enx,ne2*4,iget(enx,eq*4));
                    iput(elk,ne2*4,iget(st,clone*12+8)); iput(st,clone*12+8,ne2);
                    eq=iget(elk,eq*4);
                }
                let p2:i32=p;
                while(p2!=-1){
                    let e2:i32=-1;
                    if(p2==0){e2=iget(rtab,(c as i32)*4);}
                    else{e2=sam_find_edge(st,ech,enx,elk,p2,c);}
                    if(e2==-1){break;}
                    if(iget(enx,e2*4)!=q){break;}
                    iput(enx,e2*4,clone);
                    p2=iget(st,p2*12);
                }
                iput(st,q*12,clone);
                iput(st,cur*12,clone);
            }
        }
        last=cur;
        bi=bi+1;
    }
    ne_out.*=ne;
    return sz;
}
// Frozen maxlen via SAM: longest prefix of fresh[i..] present in train,
// capped at L. buf arguments are NOT reversed by the caller.
fn seg_frozen_maxlen(s:*R, train:[]u8, tn:i32, buf:[]u8, n:i32,
                     maxlen:[]u8, L:i32) void {
    let tr:[]u8=halloc(s,tn);
    let ti:i32=0; while(ti<tn){tr[ti]=train[tn-1-ti]; ti=ti+1;}
    let maxst:i32=2*tn+16;
    let st:[]u8=halloc(s,maxst*12);
    let maxe:i32=3*tn+16;
    let ech:[]u8=halloc(s,maxe);
    let enx:[]u8=halloc(s,maxe*4);
    let elk:[]u8=halloc(s,maxe*4);
    let rtab:[]u8=halloc(s,1024);
    let ne:i32=0;
    let sz:i32=sam_build(st,ech,enx,elk,rtab,tr,tn,&ne);
    if(sz>maxst || ne>maxe){_zag_println("SAM,FATAL,size-overflow");}
    hfree(s,tr);
    let fr:[]u8=halloc(s,n);
    let fi:i32=0; while(fi<n){fr[fi]=buf[n-1-fi]; fi=fi+1;}
    // linear walk over reversed fresh; write maxlen directly (no E array)
    let v:i32=0; let l:i32=0;
    let j:i32=0;
    while(j<n){
        let c:u8=fr[j];
        let e:i32=-1;
        if(v==0){e=iget(rtab,(c as i32)*4);}
        else{e=sam_find_edge(st,ech,enx,elk,v,c);}
        if(e!=-1){v=iget(enx,e*4); l=l+1;}
        else{
            while(v!=-1){
                v=iget(st,v*12);
                if(v==-1){break;}
                if(v==0){e=iget(rtab,(c as i32)*4);}
                else{e=sam_find_edge(st,ech,enx,elk,v,c);}
                if(e!=-1){break;}
            }
            if(v==-1){v=0; l=0;}
            else{l=iget(st,v*12+4)+1; v=iget(enx,e*4);}
        }
        let ml:i32=l; if(ml>L){ml=L;}
        maxlen[n-1-j]=ml as u8;
        j=j+1;
    }
    hfree(s,fr);
    hfree(s,rtab); hfree(s,elk); hfree(s,enx); hfree(s,ech); hfree(s,st);
}

// full segmentation: maxlen (own dictionary) + DP -> boundaries. Returns nchunks.
fn r_segment(s:*R, buf:[]u8, n:i32, b0:[]u8, b1:[]u8, bse:i32, L:i32, refc:i32) i32 {
    let maxlen:[]u8=halloc(s,n);
    let z:i32=0;while(z<n){maxlen[z]=0;z=z+1;}
    seg_maxlen(s,buf,n,maxlen,L);
    let nc:i32=seg_dp(s,n,maxlen,b0,b1,bse,L,refc);
    hfree(s,maxlen);
    return nc;
}
// segmentation with a frozen dictionary (train substrings via SAM).
fn r_segment_frozen(s:*R, train:[]u8, tn:i32,
                    buf:[]u8, n:i32, b0:[]u8, b1:[]u8, bse:i32, L:i32, refc:i32) i32 {
    let maxlen:[]u8=halloc(s,n);
    let z:i32=0;while(z<n){maxlen[z]=0;z=z+1;}
    seg_frozen_maxlen(s,train,tn,buf,n,maxlen,L);
    let nc:i32=seg_dp(s,n,maxlen,b0,b1,bse,L,refc);
    hfree(s,maxlen);
    return nc;
}
// POLICY audit line: corpus sha256 + params + chunk count + spot hashes
fn print_policy(s:*R,cname:[]u8,buf:[]u8,b0:[]u8,b1:[]u8,bse:i32,nc:i32)void {
    let h:[]u8=halloc(s,32);
    ns_sha256(buf,h);
    let hx:[]u8=ns_hex(h);
    _zag_print("POLICY,");_zag_print(cname);_zag_print(",");
    _zag_print(hx);_zag_print(",L=64,ref=2,tiebreak=longer-chunk,nchunks=");
    p_i64(nc as i64);_zag_print(",spot=");
    let k:i32=0;
    while(k<3){
        let ci:i32=0;
        if(k==1){ci=nc/2;}
        if(k==2){ci=nc-1;}
        let a:i32=cget(b0,b1,bse,ci);
        let b2:i32=cget(b0,b1,bse,ci+1);
        let sh:[]u8=halloc(s,32);
        ns_sha256(buf[a..b2],sh);
        let sx:[]u8=ns_hex(sh);
        _zag_print(sx);
        nio_free(sx);hfree(s,sh);
        if(k<2){_zag_print("/");}
        k=k+1;
    }
    _zag_println("");
    nio_free(hx);hfree(s,h);
}

// ---- shared trial helpers ----
// seg_buf stores boundaries in ps.*.segb0/segb1/segn/segbse (avoids local struct field access).
fn seg_buf(s:*R, buf:[]u8, L:i32, refc:i32) void {
    let n:i32=buf.len;
    let bse:i32=(n+2)/2;
    let b0:[]u8=halloc(s,bse*4);
    let b1:[]u8=halloc(s,bse*4);
    let nc:i32=r_segment(s,buf,n,b0,b1,bse,L,refc);
    s.*.segb0=b0; s.*.segb1=b1; s.*.segn=nc; s.*.segbse=bse;
}
fn cuts_free(s:*R, b0:[]u8, b1:[]u8) void { hfree(s,b0);hfree(s,b1); }
fn reg_set(coffs:[]u8,clens:[]u8,corpus:i32,base:i32,len:i32) void {
    iput(coffs,(corpus-1)*4,base);iput(clens,(corpus-1)*4,len);
}
// ingest all cuts in SCAN_COMMIT batches
fn ingest_cuts(s:*R,b0:[]u8,b1:[]u8,bse:i32,n:i32,corpus:i32) i32 {
    let first:i32=0;
    while(first<n){
        let cnt:i32=n-first;
        if(cnt>R_BATCH){cnt=R_BATCH;}
        if(r_ingest_cuts(s,b0,b1,bse,first,cnt,corpus)<0){return -1;}
        first=first+cnt;
    }
    return 0;
}
// M1 probe over R cuts: content recall + boundary fidelity vs slot records
fn probe_cuts(s:*R,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
              b0:[]u8,b1:[]u8,bse:i32,n:i32,bout:[]u8,cok:*i32,bok:*i32) void {
    let ok:i32=0;let bo:i32=0;
    let i:i32=0;
    while(i<n){
        let id:i32=(corpus<<24)|i;
        let off:i32=cget(b0,b1,bse,i);
        let len:i32=cget(b0,b1,bse,i+1)-off;
        let rl:i32=r_recall(s,cbufs,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;
            let j:i32=0;while(j<len){if(bout[j]!=buf[off+j]){good=0;break;}j=j+1;}
            if(good==1){ok=ok+1;}
        }
        let sl:i32=slot_find(s,id);
        if(sl>=0){
            let f:i32=iget(s.*.flags,sl*4);
            if((f & F_LIVE)!=0 && iget(s.*.offs,sl*4)==off && iget(s.*.lens,sl*4)==len
               && (f & F_SHIFT)==0){bo=bo+1;}
        }
        i=i+1;
    }
    if(n>0){cok.*=ok*1000/n;bok.*=bo*1000/n;}else{cok.*=0;bok.*=0;}
}

// ---- M1: single-corpus recall through R cuts (+ ID swap probe) ----
fn t_m1(cdir:[]u8,fname:[]u8,corpus:i32,keyp:[]u8,jmode:[]u8,use_fixed:i32) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M1,FATAL,empty-corpus");return;}
    let s:R=r_new_trace();
    let ps:*R=&s;
    let bse:i32=(buf.len+2)/2;
    let b0:[]u8=halloc(&s,bse*4);
    let b1:[]u8=halloc(&s,bse*4);
    let n:i32=0;
    if(use_fixed==1){
        // fixed 64-byte baseline cuts
        n=0;
        let p:i32=0;
        while(p<buf.len){
            cset(b0,b1,bse,n,p);
            n=n+1;
            p=p+64;
        }
        cset(b0,b1,bse,n,buf.len);
    }else{
        n=r_segment(&s,buf,buf.len,b0,b1,bse,R_L,R_REF);
    }
    r_init(&s,n+n/4+2048,n/R_BATCH+4096,n+1024);
    print_policy(&s,keyp,buf,b0,b1,bse,n);
    ingest_cuts(&s,b0,b1,bse,n,corpus);
    let bout:[]u8=halloc(&s,64);
    let exp:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,40);let clens:[]u8=halloc(&s,40);
    reg_set(coffs,clens,corpus,0,buf.len);
    // recall pass with 64 swap probes (A15 proposed schedule)
    let step:i32=(n+63)/64;
    let probes:i32=0; let pok:i32=0;
    let ok:i32=0; let bnd:i32=0;
    let i:i32=0;
    while(i<n){
        if(probes<64 && i-(i/step)*step==0){
            let pid:i32=(corpus<<24)|i;
            let pr:i32=r_swap_probe(&s,buf,coffs,clens,pid,probes+1,bout,exp);
            probes=probes+1;
            if(pr==1){pok=pok+1;}
        }
        let id:i32=(corpus<<24)|i;
        let off:i32=cget(b0,b1,bse,i);
        let len:i32=cget(b0,b1,bse,i+1)-off;
        let rl:i32=r_recall(&s,buf,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;
            let j:i32=0;while(j<len){if(bout[j]!=buf[off+j]){good=0;break;}j=j+1;}
            if(good==1){ok=ok+1;}
        }
        let sl:i32=slot_find(&s,id);
        if(sl>=0){
            let f:i32=iget(ps.*.flags,sl*4);
            if((f & F_LIVE)!=0 && iget(ps.*.offs,sl*4)==off && iget(ps.*.lens,sl*4)==len
               && (f & F_SHIFT)==0){bnd=bnd+1;}
        }
        i=i+1;
    }
    let cok:i64=(ok as i64)*1000/(n as i64);
    let bok:i64=(bnd as i64)*1000/(n as i64);
    let idp:[]u8="PASS";
    if(pok!=64){idp="FAIL (side channel)";}
    _zag_print("M1,");_zag_print(fname);_zag_print(",");
    p_dec1(cok);_zag_print(",");p_dec1(bok);_zag_print(",");
    p_i64(n as i64);_zag_print(",swap=");p_i64(pok as i64);
    _zag_print("/64,PROVISIONAL-PENDING-FREEZE");_zag_println("");
    // spot check: 3 fixed chunks byte-exact
    let spot_ok:i32=1;
    let sp:i32=0;
    while(sp<3){
        let sx:i32=sp*(n/3);
        if(sx<n){
            let sid:i32=(corpus<<24)|sx;
            let soff:i32=cget(b0,b1,bse,sx);
            let slen:i32=cget(b0,b1,bse,sx+1)-soff;
            let srl:i32=r_recall(&s,buf,coffs,clens,sid,bout);
            if(srl!=slen){spot_ok=0;}
            else{
                let sj:i32=0;
                while(sj<slen){if(bout[sj]!=buf[soff+sj]){spot_ok=0;break;}sj=sj+1;}
            }
        }
        sp=sp+1;
    }
    let f:i32=0;
    j_begin(jmode,"1x");
    jf_dec1(&f,"m1_recall_tenths",cok);
    jf_dec1(&f,"m1_boundary_tenths",bok);
    jf_int(&f,"m1_units",n as i64);
    jf_int(&f,"m1_bytes",buf.len as i64);
    jf_int(&f,"m1_spot_ok",spot_ok as i64);
    jf_int(&f,"m1_tamper_caught",pok as i64);
    jf_int(&f,"m1_ledger_entries",ps.*.led_n as i64);
    jf_str(&f,"m1_corpus",keyp);
    jf_str(&f,"m1_id_probe",idp);
    j_end();
    cuts_free(&s,b0,b1);
    hfree(&s,bout);hfree(&s,exp);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M2: tiered curriculum ----
fn t_m2(cdir:[]u8,fname:[]u8,corpus:i32,tier:[]u8,do_m9:i32) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M2,FATAL,empty-corpus");return;}
    let s:R=r_new_trace();
    let cbse:i32=(buf.len+2)/2;
    let cb0:[]u8=halloc(&s,cbse*4);
    let cb1:[]u8=halloc(&s,cbse*4);
    let n:i32=r_segment(&s,buf,buf.len,cb0,cb1,cbse,R_L,R_REF);
    r_init(&s,n+n/4+2048,n/R_BATCH+4096,n+1024);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,40);let clens:[]u8=halloc(&s,40);
    reg_set(coffs,clens,corpus,0,buf.len);
    let cok:i32=0;let bok:i32=0;
    probe_cuts(&s,buf,coffs,clens,buf,corpus,cb0,cb1,cbse,n,bout,&cok,&bok);
    let r0:i64=cok as i64;
    let rs:[]u8=halloc(&s,51*4);
    iput(rs,0,cok);
    let e:i32=1;let consec:i32=0;let etc:i32=50;let nep:i32=1;
    let rc:i32=cok;let bc:i32=bok;
    while(e<=50){
        ingest_cuts(&s,cb0,cb1,cbse,n,corpus);
        probe_cuts(&s,buf,coffs,clens,buf,corpus,cb0,cb1,cbse,n,bout,&cok,&bok);
        iput(rs,e*4,cok);
        nep=e+1;
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;rc=cok;bc=bok;break;}
        rc=cok;bc=bok;
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");
    p_i64(censored as i64);_zag_print(",");
    p_dec1(r0);_zag_println("");
    let f:i32=0;
    j_begin(tier,"1x");
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",r0);
    jf_dec1(&f,"m2_final_recall_tenths",rc as i64);
    jf_dec1(&f,"m2_final_boundary_tenths",bc as i64);
    if(do_m9==1){
        let npts:i32=nep;
        let takeoff:i32=npts;
        let e2:i32=0;
        while(e2<npts){
            if(iget(rs,e2*4)>=500){takeoff=e2;break;}
            e2=e2+1;
        }
        let steep:i64=0;
        e2=1;
        while(e2<npts){
            let jmp:i64=(iget(rs,e2*4)-iget(rs,(e2-1)*4)) as i64;
            if(jmp>steep){steep=jmp;}
            e2=e2+1;
        }
        let etc_idx:i32=etc;
        if(etc_idx>=npts){etc_idx=npts-1;}
        let to_idx:i32=takeoff;
        if(to_idx>=npts){to_idx=npts-1;}
        let late:i64=(iget(rs,etc_idx*4)-iget(rs,to_idx*4)) as i64;
        let shape:[]u8="other";
        if(steep>=400 && late<=150){shape="fast-then-flat";}
        else{
            if(takeoff>=3 && steep>=400){shape="slow-then-sudden";}
            else{
                if(steep<400){shape="gradual";}
            }
        }
        jf_str(&f,"m9_shape",shape);
        jf_int(&f,"m9_takeoff_ep",takeoff as i64);
        jf_dec1(&f,"m9_steepness_tenths",steep);
        jf_dec1(&f,"m9_late_gain_tenths",late);
        j_end();
        _zag_print("M9,");_zag_print(tier);_zag_print(",");
        _zag_print(shape);_zag_println("");
    }
    if(do_m9==0){
        j_end();
    }
    cuts_free(&s,cb0,cb1);
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);hfree(&s,rs);
}

// ---- M3: deliberation experiment (valuable-cut retention) ----
fn v_probe1(s:*R,buf:[]u8,coffs:[]u8,clens:[]u8,b0:[]u8,b1:[]u8,bse:i32,n:i32,corpus:i32,
            vc0:[]u8,vc1:[]u8,vx0:[]u8,vx1:[]u8,vse:i32,nv:i32,bout:[]u8) i32 {
    let rok:i32=0;
    let t:i32=0;
    while(t<nv){
        let cid:i32=cget(vc0,vc1,vse,t);
        if(cid==corpus){
            let vx:i32=cget(vx0,vx1,vse,t);
            let id:i32=(corpus<<24)|vx;
            let off:i32=cget(b0,b1,bse,vx);
            let len:i32=cget(b0,b1,bse,vx+1)-off;
            let rl:i32=r_recall(s,buf,coffs,clens,id,bout);
            if(rl==len){
                let good:i32=1;
                let j:i32=0;while(j<len){if(bout[j]!=buf[off+j]){good=0;break;}j=j+1;}
                if(good==1){rok=rok+1;}
            }
        }
        t=t+1;
    }
    return rok;
}
// ---- M3: pressure + freeze (official fields) ----
fn t_m3(cdir:[]u8,pname:[]u8,cname:[]u8,jmode:[]u8) void {
    let prose:[]u8=read_file(cdir,pname);
    let code:[]u8=read_file(cdir,cname);
    let fresh:[]u8=read_file(cdir,"t3.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M3,FATAL,empty-corpus");return;}
    let s:R=r_new_trace();
    let ps:*R=&s;
    let cpbse:i32=(prose.len+2)/2;
    let cpb0:[]u8=halloc(&s,cpbse*4);
    let cpb1:[]u8=halloc(&s,cpbse*4);
    let np:i32=r_segment(&s,prose,prose.len,cpb0,cpb1,cpbse,R_L,R_REF);
    let ccbse:i32=(code.len+2)/2;
    let ccb0:[]u8=halloc(&s,ccbse*4);
    let ccb1:[]u8=halloc(&s,ccbse*4);
    let nc:i32=r_segment(&s,code,code.len,ccb0,ccb1,ccbse,R_L,R_REF);
    r_init(&s,np+nc+7000+8192,(np+nc)/R_BATCH+7000+8192,np+nc+7000+1024);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,40);let clens:[]u8=halloc(&s,40);
    reg_set(coffs,clens,1,0,prose.len);
    reg_set(coffs,clens,2,0,code.len);
    reg_set(coffs,clens,8,0,fresh.len);
    ingest_cuts(&s,cpb0,cpb1,cpbse,np,1);
    ingest_cuts(&s,ccb0,ccb1,ccbse,nc,2);
    print_policy(&s,"prose",prose,cpb0,cpb1,cpbse,np);
    print_policy(&s,"code",code,ccb0,ccb1,ccbse,nc);
    // V: 1000 valuable cuts spread across prose+code
    let nv:i32=1000;
    let vse:i32=(nv+2)/2;
    let vc0:[]u8=halloc(&s,vse*4);let vc1:[]u8=halloc(&s,vse*4);
    let vx0:[]u8=halloc(&s,vse*4);let vx1:[]u8=halloc(&s,vse*4);
    let step:i32=(np+nc+nv-1)/nv;
    let t:i32=0;
    while(t<nv){
        let g:i32=t*step;
        if(g<np){cset(vc0,vc1,vse,t,1);cset(vx0,vx1,vse,t,g);}
        else{cset(vc0,vc1,vse,t,2);cset(vx0,vx1,vse,t,g-np);}
        t=t+1;
    }
    t=0;
    while(t<nv){
        let cid:i32=cget(vc0,vc1,vse,t);
        let vx:i32=cget(vx0,vx1,vse,t);
        r_mark_valuable(&s,(cid<<24)|vx);
        t=t+1;
    }
    // weaken 50 valuable units (deliberate)
    let w_ok:i32=0;
    let w:i32=0;
    while(w<50){
        let vj:i32=w*20;
        let cid:i32=cget(vc0,vc1,vse,vj);
        let vx:i32=cget(vx0,vx1,vse,vj);
        if(r_weaken(&s,(cid<<24)|vx,w+1)==0){w_ok=w_ok+1;}
        w=w+1;
    }
    let pre1:i32=v_probe1(&s,prose,coffs,clens,cpb0,cpb1,cpbse,np,1,vc0,vc1,vx0,vx1,vse,nv,bout);
    let pre2:i32=v_probe1(&s,code,coffs,clens,ccb0,ccb1,ccbse,nc,2,vc0,vc1,vx0,vx1,vse,nv,bout);
    let pre:i64=((pre1+pre2) as i64)*1000/(nv as i64);
    // 7000 fresh 64B protocol units under churn (mid-churn introductions)
    let nf:i32=fresh.len/64;
    if(nf>7000){nf=7000;}
    let f2:i32=0;
    while(f2<nf){
        let id:i32=(8<<24)|f2;
        r_ingest(&s,id,f2*64,64,8);
        f2=f2+1;
    }
    let post1:i32=v_probe1(&s,prose,coffs,clens,cpb0,cpb1,cpbse,np,1,vc0,vc1,vx0,vx1,vse,nv,bout);
    let post2:i32=v_probe1(&s,code,coffs,clens,ccb0,ccb1,ccbse,nc,2,vc0,vc1,vx0,vx1,vse,nv,bout);
    let post:i64=((post1+post2) as i64)*1000/(nv as i64);
    // fresh recall: byte-exact recall of the mid-churn fresh units
    let fr_ok:i32=0;
    f2=0;
    while(f2<nf){
        let id:i32=(8<<24)|f2;
        let rl:i32=r_recall(&s,fresh,coffs,clens,id,bout);
        if(rl==64){
            let good:i32=1;
            let j:i32=0;while(j<64){if(bout[j]!=fresh[f2*64+j]){good=0;break;}j=j+1;}
            if(good==1){fr_ok=fr_ok+1;}
        }
        f2=f2+1;
    }
    let fresht:i64=0;
    if(nf>0){fresht=(fr_ok as i64)*1000/(nf as i64);}
    let mgmt:i32=ps.*.led_n;
    let freeze:i32=0;
    if(post<900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    if(w_ok<50){freeze=1;}
    let fz:[]u8="CLEAR";
    if(freeze==1){fz="FROZEN-UNDER-PRESSURE";}
    _zag_print("M3,");
    p_dec1(post);_zag_print(",");p_dec1(fresht);_zag_print(",");
    p_i64(mgmt as i64);_zag_print(",");
    p_i64(w_ok as i64);_zag_print(",");
    _zag_println(fz);
    let f:i32=0;
    j_begin(jmode,"1x");
    jf_dec1(&f,"m3_survival_tenths",post);
    jf_dec1(&f,"m3_fresh_recall_tenths",fresht);
    jf_int(&f,"m3_mgmt_entries",mgmt as i64);
    jf_int(&f,"m3_weaken_handled",w_ok as i64);
    jf_str(&f,"m3_freeze",fz);
    jf_int(&f,"m3_valuable",nv as i64);
    j_end();
    cuts_free(&s,cpb0,cpb1);cuts_free(&s,ccb0,ccb1);
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,vc0);hfree(&s,vc1);hfree(&s,vx0);hfree(&s,vx1);
}


// ---- M4: defect probe (deliberate cut corruption + deliberate repair) ----
fn code_rename(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;
    while(i<64){
        let b:u8=0;
        if(i<len){b=buf[off+i];}
        if(i==0 && len>0){b='X';}
        if(i==1 && len>1){b='y';}
        out[i]=b;
        i=i+1;
    }
}
fn patch_prose_xor(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;
    while(i<64){
        let b:u8=0;
        if(i<len){b=buf[off+i]^42;}
        out[i]=b;
        i=i+1;
    }
}
fn r_unit_verified(s:*R,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
                   b0:[]u8,b1:[]u8,bse:i32,idx:i32,bout:[]u8) i32 {
    let id:i32=(corpus<<24)|idx;
    let off:i32=cget(b0,b1,bse,idx);
    let len:i32=cget(b0,b1,bse,idx+1)-off;
    let rl:i32=r_recall(s,cbufs,coffs,clens,id,bout);
    if(rl!=len){return 0;}
    let j:i32=0;
    while(j<len){if(bout[j]!=buf[off+j]){return 0;}j=j+1;}
    return 1;
}
fn t_m4(cdir:[]u8,pname:[]u8,cname:[]u8,jmode:[]u8) void {
    let prose:[]u8=read_file(cdir,pname);
    let code:[]u8=read_file(cdir,cname);
    if(prose.len==0 || code.len==0){_zag_println("M4,FATAL,empty-corpus");return;}
    let s:R=r_new_trace();
    let ps:*R=&s;
    let cpbse:i32=(prose.len+2)/2;
    let cpb0:[]u8=halloc(&s,cpbse*4);
    let cpb1:[]u8=halloc(&s,cpbse*4);
    let np:i32=r_segment(&s,prose,prose.len,cpb0,cpb1,cpbse,R_L,R_REF);
    let ccbse:i32=(code.len+2)/2;
    let ccb0:[]u8=halloc(&s,ccbse*4);
    let ccb1:[]u8=halloc(&s,ccbse*4);
    let nc:i32=r_segment(&s,code,code.len,ccb0,ccb1,ccbse,R_L,R_REF);
    r_init(&s,np+nc+8192,(np+nc)/R_BATCH+8192,np+nc+2048);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,40);let clens:[]u8=halloc(&s,40);
    reg_set(coffs,clens,1,0,prose.len);
    reg_set(coffs,clens,2,0,code.len);
    ingest_cuts(&s,cpb0,cpb1,cpbse,np,1);
    ingest_cuts(&s,ccb0,ccb1,ccbse,nc,2);
    print_policy(&s,"prose",prose,cpb0,cpb1,cpbse,np);
    print_policy(&s,"code",code,ccb0,ccb1,ccbse,nc);
    // sample 100 cuts: 50 prose + 50 code
    let vse:i32=52;
    let vc0:[]u8=halloc(&s,vse*4);let vc1:[]u8=halloc(&s,vse*4);
    let vx0:[]u8=halloc(&s,vse*4);let vx1:[]u8=halloc(&s,vse*4);
    let kp:i32=(np+49)/50; let kc:i32=(nc+49)/50;
    let t:i32=0;
    while(t<50){
        let ix:i32=t*kp; if(ix>=np){ix=np-1;}
        cset(vc0,vc1,vse,t,1);cset(vx0,vx1,vse,t,ix);
        let jx:i32=t*kc; if(jx>=nc){jx=nc-1;}
        cset(vc0,vc1,vse,50+t,2);cset(vx0,vx1,vse,50+t,jx);
        t=t+1;
    }
    // pre-verify (skip-fail)
    let pt:i32=0;let bad_pre:i32=0;
    t=0;
    while(t<100){
        let cid:i32=cget(vc0,vc1,vse,t);
        let vx:i32=cget(vx0,vx1,vse,t);
        let v:i32=0;
        if(cid==1){v=r_unit_verified(&s,prose,coffs,clens,prose,1,cpb0,cpb1,cpbse,vx,bout);}
        else{v=r_unit_verified(&s,code,coffs,clens,code,2,ccb0,ccb1,ccbse,vx,bout);}
        if(v==1){
            cset(vc0,vc1,vse,pt,cid);cset(vx0,vx1,vse,pt,vx);
            pt=pt+1;
        }else{bad_pre=1;}
        t=t+1;
    }
    let n4:i32=pt;
    // build 100 patch buffers (64B each; units are <= 64B)
    let patches:[]u8=halloc(&s,6400);
    t=0;
    while(t<n4){
        let cid:i32=cget(vc0,vc1,vse,t);
        let vx:i32=cget(vx0,vx1,vse,t);
        let dst:[]u8=patches[t*64..t*64+64];
        if(cid==1){
            let off:i32=cget(cpb0,cpb1,cpbse,vx);
            let len:i32=cget(cpb0,cpb1,cpbse,vx+1)-off;
            patch_prose_xor(prose,off,len,dst);
        }else{
            let off:i32=cget(ccb0,ccb1,ccbse,vx);
            let len:i32=cget(ccb0,ccb1,ccbse,vx+1)-off;
            code_rename(code,off,len,dst);
        }
        t=t+1;
    }
    r_defect(&s,patches,vc0,vc1,vx0,vx1,vse,n4);
    // post-defect probe
    let v2:i32=0;let sb:i32=0;
    t=0;
    while(t<n4){
        let cid:i32=cget(vc0,vc1,vse,t);
        let vx:i32=cget(vx0,vx1,vse,t);
        if(cid==1){v2=v2+r_unit_verified(&s,prose,coffs,clens,prose,1,cpb0,cpb1,cpbse,vx,bout);}
        else{v2=v2+r_unit_verified(&s,code,coffs,clens,code,2,ccb0,ccb1,ccbse,vx,bout);}
        let sl:i32=slot_find(&s,(cid<<24)|vx);
        if(sl>=0 && (iget(ps.*.flags,sl*4) & F_SHIFT)!=0){sb=sb+1;}
        t=t+1;
    }
    // deliberate repair
    r_revise(&s,vc0,vc1,vx0,vx1,vse,n4);
    // post-repair probe
    let v3:i32=0;let sb2:i32=0;
    t=0;
    while(t<n4){
        let cid:i32=cget(vc0,vc1,vse,t);
        let vx:i32=cget(vx0,vx1,vse,t);
        if(cid==1){v3=v3+r_unit_verified(&s,prose,coffs,clens,prose,1,cpb0,cpb1,cpbse,vx,bout);}
        else{v3=v3+r_unit_verified(&s,code,coffs,clens,code,2,ccb0,ccb1,ccbse,vx,bout);}
        let sl:i32=slot_find(&s,(cid<<24)|vx);
        if(sl>=0 && (iget(ps.*.flags,sl*4) & F_SHIFT)==0){sb2=sb2+1;}
        t=t+1;
    }
    // deliberate repair, counting actual repairs
    let nrep:i32=0;
    let t4:i32=0;
    while(t4<n4){
        let cid4:i32=cget(vc0,vc1,vse,t4);
        let vx4:i32=cget(vx0,vx1,vse,t4);
        if(r_revise1(&s,(cid4<<24)|vx4)==1){nrep=nrep+1;}
        t4=t4+1;
    }
    // post-repair probe
    let v3:i32=0;let sb2:i32=0;
    // unrepaired IDs (comma-separated)
    let ubuf:[]u8=halloc(&s,1024);
    let ulen:i32=0;
    t=0;
    while(t<n4){
        let cid:i32=cget(vc0,vc1,vse,t);
        let vx:i32=cget(vx0,vx1,vse,t);
        let vv:i32=0;
        if(cid==1){vv=r_unit_verified(&s,prose,coffs,clens,prose,1,cpb0,cpb1,cpbse,vx,bout);}
        else{vv=r_unit_verified(&s,code,coffs,clens,code,2,ccb0,ccb1,ccbse,vx,bout);}
        v3=v3+vv;
        let sl:i32=slot_find(&s,(cid<<24)|vx);
        if(sl>=0 && (iget(ps.*.flags,sl*4) & F_SHIFT)==0){sb2=sb2+1;}
        if(vv==0){
            // record unrepaired id
            if(ulen>0 && ulen<1023){ubuf[ulen]=44;ulen=ulen+1;}
            let idstr:[]u8=_zag_i64_to_str(((cid<<24)|vx) as i64);
            let q:i32=0;
            while(q<idstr.len && ulen<1023){ubuf[ulen]=idstr[q];ulen=ulen+1;q=q+1;}
            nio_free(idstr);
        }
        t=t+1;
    }
    let m4_recall_post:i64=0;let m4_salv:i64=0;
    if(n4>0){
        m4_recall_post=(v3 as i64)*1000/(n4 as i64);
        // salvage: repaired (recall passes) or still live with defect contained
        m4_salv=(sb2 as i64)*1000/(n4 as i64);
    }
    _zag_print("M4,");
    p_i64(n4 as i64);_zag_print(",");p_i64(n4 as i64);_zag_print(",");
    p_i64(nrep as i64);_zag_print(",");p_dec1(m4_recall_post);_zag_println("");
    let f:i32=0;
    j_begin(jmode,"1x");
    jf_int(&f,"m4_units",n4 as i64);
    jf_int(&f,"m4_attempts",n4 as i64);
    jf_int(&f,"m4_repairs",nrep as i64);
    jf_dec1(&f,"m4_recall_post_repair_tenths",m4_recall_post);
    jf_dec1(&f,"m4_salvage_tenths",m4_salv);
    jf_str(&f,"m4_unrepaired_ids",ubuf[0..ulen]);
    if(bad_pre==1){jf_str(&f,"m4_note","pre-defect verify failed on some units (skip-fail)");}
    j_end();
    cuts_free(&s,cpb0,cpb1);cuts_free(&s,ccb0,ccb1);
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,vc0);hfree(&s,vc1);hfree(&s,vx0);hfree(&s,vx1);
    hfree(&s,patches);hfree(&s,ubuf);
}

// ---- buffer helpers ----
fn buf_copy(s:*R,src:[]u8) []u8 {
    let d:[]u8=halloc(s,src.len);
    let i:i32=0;while(i<src.len){d[i]=src[i];i=i+1;}
    return d;
}
fn mutate_first4k(b:[]u8) void {
    let n:i32=b.len; if(n>4096){n=4096;}
    let i:i32=0;while(i<n){b[i]=b[i]^1;i=i+1;}
}
// M3 core shared by t_m3 and t_m8
fn m3_core(s:*R,prose:[]u8,pb0:[]u8,pb1:[]u8,pbse:i32,np:i32,
           code:[]u8,cb0:[]u8,cb1:[]u8,cbse:i32,nc:i32,fresh:[]u8,
           coffs:[]u8,clens:[]u8,bout:[]u8,pre:*i64,post:*i64) void {
    let nv:i32=2500;
    let vse:i32=(nv+2)/2;
    let vc0:[]u8=halloc(s,vse*4);let vc1:[]u8=halloc(s,vse*4);
    let vx0:[]u8=halloc(s,vse*4);let vx1:[]u8=halloc(s,vse*4);
    let step:i32=(np+nc+nv-1)/nv;
    let t:i32=0;
    while(t<nv){
        let g:i32=t*step;
        if(g<np){cset(vc0,vc1,vse,t,1);cset(vx0,vx1,vse,t,g);}
        else{cset(vc0,vc1,vse,t,2);cset(vx0,vx1,vse,t,g-np);}
        t=t+1;
    }
    t=0;
    while(t<nv){
        let cid:i32=cget(vc0,vc1,vse,t);
        let vx:i32=cget(vx0,vx1,vse,t);
        r_mark_valuable(s,(cid<<24)|vx);
        t=t+1;
    }
    let pre1:i32=v_probe1(s,prose,coffs,clens,pb0,pb1,pbse,np,1,vc0,vc1,vx0,vx1,vse,nv,bout);
    let pre2:i32=v_probe1(s,code,coffs,clens,cb0,cb1,cbse,nc,2,vc0,vc1,vx0,vx1,vse,nv,bout);
    pre.*=((pre1+pre2) as i64)*1000/(nv as i64);
    let nf:i32=fresh.len/64;
    if(nf>7000){nf=7000;}
    let f2:i32=0;
    while(f2<nf){
        r_ingest(s,(8<<24)|f2,f2*64,64,8);
        f2=f2+1;
    }
    let post1:i32=v_probe1(s,prose,coffs,clens,pb0,pb1,pbse,np,1,vc0,vc1,vx0,vx1,vse,nv,bout);
    let post2:i32=v_probe1(s,code,coffs,clens,cb0,cb1,cbse,nc,2,vc0,vc1,vx0,vx1,vse,nv,bout);
    post.*=((post1+post2) as i64)*1000/(nv as i64);
    hfree(s,vc0);hfree(s,vc1);hfree(s,vx0);hfree(s,vx1);
}

// ---- M5: weaken probe ----
// ---- M5: cost trial (official) ----
fn t_m5(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let churn:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || churn.len==0){_zag_println("M5,FATAL,empty-corpus");return;}
    let s:R=r_new_trace();
    let ps:*R=&s;
    let cpbse:i32=(prose.len+2)/2;
    let cpb0:[]u8=halloc(&s,cpbse*4);
    let cpb1:[]u8=halloc(&s,cpbse*4);
    let np:i32=r_segment(&s,prose,prose.len,cpb0,cpb1,cpbse,R_L,R_REF);
    let cap:i32=np+np/4+8192;
    r_init(&s,cap,np/R_BATCH+8192,np+2048);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,40);let clens:[]u8=halloc(&s,40);
    reg_set(coffs,clens,1,0,prose.len);
    reg_set(coffs,clens,8,0,churn.len);
    // full prose ingest via the deliberate add path
    ingest_cuts(&s,cpb0,cpb1,cpbse,np,1);
    print_policy(&s,"prose",prose,cpb0,cpb1,cpbse,np);
    // mini-pressure: 500 fresh ingests + 500 kills of those fresh
    let nf:i32=churn.len/64;
    if(nf>500){nf=500;}
    let f:i32=0;
    while(f<nf){
        r_ingest(&s,(8<<24)|f,f*64,64,8);
        f=f+1;
    }
    f=0;
    while(f<nf){r_kill(&s,(8<<24)|f,2);f=f+1;}
    // learned = deliberate add + byte-exact M1 recall at trial end
    let learned:i32=0;
    let src:i64=0;
    let i:i32=0;
    while(i<np){
        let id:i32=(1<<24)|i;
        let off:i32=cget(cpb0,cpb1,cpbse,i);
        let len:i32=cget(cpb0,cpb1,cpbse,i+1)-off;
        let rl:i32=r_recall(&s,prose,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;
            let j:i32=0;while(j<len){if(bout[j]!=prose[off+j]){good=0;break;}j=j+1;}
            if(good==1){learned=learned+1;src=src+(len as i64);}
        }
        i=i+1;
    }
    let slot_bytes:i64=(cap as i64)*28+(ps.*.ins_cap as i64)*4;
    let ledger_bytes:i64=(ps.*.led_n as i64)*64;
    let wf:i32=write_file(".", "ledger.bin", ps.*.led[0..ps.*.led_n*64]);
    _zag_print("M5,");
    p_i64(learned as i64);_zag_print(",");
    p_i64(src);_zag_print(",");
    p_i64(slot_bytes);_zag_print(",");
    p_i64(ledger_bytes);_zag_print(",");
    p_i64(wf as i64);_zag_println("");
    let ff:i32=0;
    j_begin("m5","1x");
    jf_int(&ff,"m5_units_learned",learned as i64);
    jf_int(&ff,"m5_source_bytes_learned",src);
    jf_int(&ff,"m5_slot_table_bytes",slot_bytes);
    jf_int(&ff,"m5_ledger_bytes",ledger_bytes);
    jf_int(&ff,"m5_ledger_entries",ps.*.led_n as i64);
    jf_int(&ff,"m5_corpus_buffer_bytes",prose.len as i64);
    j_end();
    cuts_free(&s,cpb0,cpb1);
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M5 baseline: same-sized empty store, fully touched ----
fn t_m5_baseline(cdir:[]u8) void {
    let fsz:i64=file_size(cdir,"prose.bin");
    if(fsz<=0){_zag_println("M5,FATAL,empty-corpus");return;}
    let s:R=r_new_trace();
    let ps:*R=&s;
    // estimate np via a quick segmentation to size the store identically
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("M5,FATAL,empty-corpus");return;}
    let cpbse:i32=(prose.len+2)/2;
    let cpb0:[]u8=halloc(&s,cpbse*4);
    let cpb1:[]u8=halloc(&s,cpbse*4);
    let np:i32=r_segment(&s,prose,prose.len,cpb0,cpb1,cpbse,R_L,R_REF);
    cuts_free(&s,cpb0,cpb1);
    let cap:i32=np+np/4+8192;
    r_init(&s,cap,np/R_BATCH+8192,np+2048);
    // fully touch: write every slot, ins entry, and ledger byte
    let i:i32=0;
    while(i<cap){
        iput(ps.*.ids,i*4,-1);iput(ps.*.offs,i*4,-1);iput(ps.*.lens,i*4,0);
        iput(ps.*.corps,i*4,-1);
        iput(ps.*.flags,i*4,0);iput(ps.*.shifts,i*4,0);iput(ps.*.pidx,i*4,-1);
        i=i+1;
    }
    i=0;
    while(i<ps.*.ins_cap){iput(ps.*.ins,i*4,-1);i=i+1;}
    i=0;
    while(i<ps.*.led_cap){ps.*.led[i]=0;i=i+1;}
    // same-sized (capacity) ledger artifact
    let wf:i32=write_file(".", "ledger.bin", ps.*.led[0..ps.*.led_cap*64]);
    _zag_print("M5-BASELINE-READY,");
    p_i64(wf as i64);_zag_println("");
}


// ---- M6: fresh-cut recall under frozen dictionary ----
// ---- M6: transfer tax (official) ----
// dir 0 = prose->code, 1 = code->prose.
// Train on tier-1 to the M2 criterion (for R: one deterministic
// segmentation+ingest; the M2 probe verifies >=99.5% recall, >=95% boundary
// on the first pass since recall is exact by construction), freeze the
// segmentation policy (frozen-dictionary SAM cuts), then face the other
// domain: M1 recall + boundary on the transfer cuts, plus 100 planted
// boundary-defect revisions. tax = mean drop vs in-domain.
fn t_m6(cdir:[]u8,dir:i32) void {
    let tname:[]u8="t1_prose.bin";let tcid:i32=6;
    let yname:[]u8="code.bin";let ycid:i32=2;
    let dtag:[]u8="p2c";
    if(dir==1){
        tname="t1_code.bin";tcid=7;yname="prose.bin";ycid=1;
        dtag="c2p";
    }
    let train:[]u8=read_file(cdir,tname);
    let ybuf:[]u8=read_file(cdir,yname);
    if(train.len==0 || ybuf.len==0){_zag_println("M6,FATAL,empty-corpus");return;}
    let tn:i32=train.len; let yn:i32=ybuf.len;
    let s:R=r_new_trace();
    let ps:*R=&s;
    // train segmentation (self dictionary)
    let tbse:i32=(tn+2)/2;
    let tb0:[]u8=halloc(&s,tbse*4);let tb1:[]u8=halloc(&s,tbse*4);
    let ntr:i32=r_segment(&s,train,tn,tb0,tb1,tbse,R_L,R_REF);
    // transfer segmentation (frozen train dictionary via SAM)
    let ybse:i32=(yn+2)/2;
    let yb0:[]u8=halloc(&s,ybse*4);let yb1:[]u8=halloc(&s,ybse*4);
    let nyf:i32=r_segment_frozen(&s,train,tn,ybuf,yn,yb0,yb1,ybse,R_L,R_REF);
    r_init(&s,ntr+nyf+8192,(ntr+nyf)/R_BATCH+8192,ntr+nyf+2048);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,40);let clens:[]u8=halloc(&s,40);
    reg_set(coffs,clens,tcid,0,tn);
    reg_set(coffs,clens,ycid,0,yn);
    // train to M2 criterion: ingest + probe (exact recall by construction)
    ingest_cuts(&s,tb0,tb1,tbse,ntr,tcid);
    let tr_ok:i32=0;
    let i:i32=0;
    while(i<ntr){
        tr_ok=tr_ok+r_unit_verified(&s,train,coffs,clens,train,tcid,tb0,tb1,tbse,i,bout);
        i=i+1;
    }
    let rec_d:i64=(tr_ok as i64)*1000/(ntr as i64);
    // in-domain boundary (vs whitespace/punctuation joints)
    let bnd_d:i64=xfer_boundary(train,tb0,tb1,tbse,ntr);
    // in-domain revision: 100 planted boundary defects
    let rev_d:i64=xfer_revision(&s,train,coffs,clens,train,tcid,tb0,tb1,tbse,ntr,bout);
    // transfer: face the new domain (ingest allowed, policy frozen)
    ingest_cuts(&s,yb0,yb1,ybse,nyf,ycid);
    let ty_ok:i32=0;
    i=0;
    while(i<nyf){
        ty_ok=ty_ok+r_unit_verified(&s,ybuf,coffs,clens,ybuf,ycid,yb0,yb1,ybse,i,bout);
        i=i+1;
    }
    let rec_t:i64=(ty_ok as i64)*1000/(nyf as i64);
    let bnd_t:i64=xfer_boundary(ybuf,yb0,yb1,ybse,nyf);
    let rev_t:i64=xfer_revision(&s,ybuf,coffs,clens,ybuf,ycid,yb0,yb1,ybse,nyf,bout);
    let tax:i64=(rec_d-rec_t+(bnd_d-bnd_t)+(rev_d-rev_t))/3;
    _zag_print("M6,");_zag_print(dtag);_zag_print(",");
    p_dec1(rec_t);_zag_print(",");p_dec1(bnd_t);_zag_print(",");
    p_dec1(rev_t);_zag_print(",");p_dec1(tax);_zag_println("");
    let f:i32=0;
    j_begin("m6","1x");
    jf_dec1(&f,"rec_tenths",rec_t);
    jf_dec1(&f,"bnd_tenths",bnd_t);
    jf_dec1(&f,"rev_tenths",rev_t);
    jf_dec1(&f,"tax_tenths",tax);
    j_end();
    cuts_free(&s,tb0,tb1);cuts_free(&s,yb0,yb1);
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
}

// transfer boundary F1 (tenths) vs whitespace/punctuation joints
fn xfer_boundary(buf:[]u8,b0:[]u8,b1:[]u8,bse:i32,n:i32) i64 {
    // joints: positions between a word byte and a non-word byte.
    // F1 over cut boundaries vs joints: precision = hits/(n-1),
    // recall = hits/njoints.
    let nj:i32=0;
    let k:i32=1;
    while(k<buf.len){
        let wa:i32=is_wordbyte(buf[k-1]); let wc:i32=is_wordbyte(buf[k]);
        if(wa!=wc){nj=nj+1;}
        k=k+1;
    }
    // count boundary hits
    let hit:i32=0;
    let i:i32=1;
    while(i<n){
        let b:i32=cget(b0,b1,bse,i);
        if(b>0 && b<buf.len){
            let wa:i32=is_wordbyte(buf[b-1]); let wc:i32=is_wordbyte(buf[b]);
            if(wa!=wc){hit=hit+1;}
        }
        i=i+1;
    }
    // precision = hit/(n-1), recall = hit/nj; F1
    let prec:i64=0; let rec:i64=0;
    if(n>1){prec=(hit as i64)*1000/((n-1) as i64);}
    if(nj>0){rec=(hit as i64)*1000/(nj as i64);}
    if(prec+rec==0){return 0;}
    return 2*prec*rec/(prec+rec);
}

// 100 planted boundary defects + deliberate repair; returns repair rate (tenths)
fn xfer_revision(s:*R,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
                 b0:[]u8,b1:[]u8,bse:i32,n:i32,bout:[]u8) i64 {
    let ndef:i32=100;
    if(n<ndef){ndef=n;}
    // plant
    let k:i32=0;
    while(k<ndef){
        let ix:i32=k*n/ndef;
        let id:i32=(corpus<<24)|ix;
        // alternate small +/- shifts
        let delta:i32=1;
        if(k%2==1){delta=-1;}
        r_defect_boundary(s,id,delta);
        k=k+1;
    }
    // repair via deliberate protocol
    let rep:i32=0;
    k=0;
    while(k<ndef){
        let ix:i32=k*n/ndef;
        let id:i32=(corpus<<24)|ix;
        r_revise1(s,id);
        rep=rep+r_unit_verified(s,cbufs,coffs,clens,buf,corpus,b0,b1,bse,ix,bout);
        k=k+1;
    }
    if(ndef==0){return 0;}
    return (rep as i64)*1000/(ndef as i64);
}


// ---- M7: edited-corpus (C') recall, M1 formula ----
fn t_m7(cdir:[]u8,pname:[]u8,cname:[]u8,jmode:[]u8) void {
    let prose0:[]u8=read_file(cdir,pname);
    let code0:[]u8=read_file(cdir,cname);
    if(prose0.len==0 || code0.len==0){_zag_println("M7,FATAL,empty-corpus");return;}
    let s:R=r_new_trace();
    let ps:*R=&s;
    let prose:[]u8=buf_copy(&s,prose0);
    let code:[]u8=buf_copy(&s,code0);
    mutate_first4k(prose);
    mutate_first4k(code);
    let cpbse:i32=(prose.len+2)/2;
    let cpb0:[]u8=halloc(&s,cpbse*4);
    let cpb1:[]u8=halloc(&s,cpbse*4);
    let np:i32=r_segment(&s,prose,prose.len,cpb0,cpb1,cpbse,R_L,R_REF);
    let ccbse:i32=(code.len+2)/2;
    let ccb0:[]u8=halloc(&s,ccbse*4);
    let ccb1:[]u8=halloc(&s,ccbse*4);
    let nc:i32=r_segment(&s,code,code.len,ccb0,ccb1,ccbse,R_L,R_REF);
    r_init(&s,np+nc+8192,(np+nc)/R_BATCH+8192,np+nc+2048);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,40);let clens:[]u8=halloc(&s,40);
    reg_set(coffs,clens,6,0,prose.len);
    reg_set(coffs,clens,7,0,code.len);
    ingest_cuts(&s,cpb0,cpb1,cpbse,np,6);
    ingest_cuts(&s,ccb0,ccb1,ccbse,nc,7);
    print_policy(&s,"prose-Cprime",prose,cpb0,cpb1,cpbse,np);
    print_policy(&s,"code-Cprime",code,ccb0,ccb1,ccbse,nc);
    let ok:i32=0;
    let i:i32=0;
    while(i<np){
        let id:i32=(6<<24)|i;
        let off:i32=cget(cpb0,cpb1,cpbse,i);
        let len:i32=cget(cpb0,cpb1,cpbse,i+1)-off;
        let rl:i32=r_recall(&s,prose,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;
            let j:i32=0;while(j<len){if(bout[j]!=prose[off+j]){good=0;break;}j=j+1;}
            if(good==1){ok=ok+1;}
        }
        i=i+1;
    }
    i=0;
    while(i<nc){
        let id:i32=(7<<24)|i;
        let off:i32=cget(ccb0,ccb1,ccbse,i);
        let len:i32=cget(ccb0,ccb1,ccbse,i+1)-off;
        let rl:i32=r_recall(&s,code,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;
            let j:i32=0;while(j<len){if(bout[j]!=code[off+j]){good=0;break;}j=j+1;}
            if(good==1){ok=ok+1;}
        }
        i=i+1;
    }
    let m7:i64=(ok as i64)*1000/((np+nc) as i64);
    _zag_print("M7,");
    p_dec1(m7);_zag_print(",");
    p_i64((np+nc) as i64);_zag_println("");
    let f:i32=0;
    j_begin(jmode,"1x");
    jf_dec1(&f,"m7_recall_tenths",m7);
    jf_int(&f,"m7_units",(np+nc) as i64);
    j_end();
    cuts_free(&s,cpb0,cpb1);cuts_free(&s,ccb0,ccb1);
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,prose);hfree(&s,code);
}

// ---- M8: perturbation battery leg ----
// ---- M8: determinism gate (official) ----
fn m8_hash_pieces(s:*R,data:[]u8,chain_in:[]u8,ci0:i32) i32 {
    let nch:i32=(data.len+1048575)/1048576;
    let ci:i32=0;
    while(ci<nch){
        let cs:i32=ci*1048576;let cn:i32=data.len-cs;
        if(cn>1048576){cn=1048576;}
        ns_sha256(data[cs..cs+cn],chain_in[(ci0+ci)*32..(ci0+ci)*32+32]);
        ci=ci+1;
    }
    return ci0+nch;
}
fn m8_write_hex_line(dir:[]u8,fname:[]u8,tag:[]u8,hash:[]u8) i32 {
    let hx:[]u8=ns_hex(hash);
    let line:[]u8=nio_alloc(tag.len+1+hx.len+1);
    let i:i32=0;while(i<tag.len){line[i]=tag[i];i=i+1;}
    line[tag.len]=32;
    let k:i32=0;while(k<hx.len){line[tag.len+1+k]=hx[k];k=k+1;}
    line[tag.len+1+hx.len]=10;
    let r:i32=write_file(dir,fname,line);
    nio_free(hx);nio_free(line);
    return r;
}
fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    // perturbations use raw allocations (bypass the logged trace), so the
    // artifacts stay byte-identical while the underlying heap is stressed.
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            i=i+1;
        }
    }
    let aslr_pad:[]u8="";
    if(_zag_strcmp(pert,"aslr")==1){aslr_pad=nio_alloc(1234567);}
    if(_zag_strcmp(pert,"starve")==1){aslr_pad=nio_alloc(50331648);}
    if(_zag_strcmp(pert,"freelist")==1){
        let i:i32=0;
        while(i<512){
            let b:[]u8=nio_alloc(64);
            nio_free(b);
            i=i+1;
        }
    }
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"t3.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M8,FATAL,empty-corpus");return;}
    let s:R=r_new_trace();
    let ps:*R=&s;
    let cpbse:i32=(prose.len+2)/2;
    let cpb0:[]u8=halloc(&s,cpbse*4);
    let cpb1:[]u8=halloc(&s,cpbse*4);
    let np:i32=r_segment(&s,prose,prose.len,cpb0,cpb1,cpbse,R_L,R_REF);
    let ccbse:i32=(code.len+2)/2;
    let ccb0:[]u8=halloc(&s,ccbse*4);
    let ccb1:[]u8=halloc(&s,ccbse*4);
    let nc:i32=r_segment(&s,code,code.len,ccb0,ccb1,ccbse,R_L,R_REF);
    r_init(&s,np+nc+8192,(np+nc)/R_BATCH+8192,np+nc+2048);
    let bout:[]u8=halloc(&s,64);
    let coffs:[]u8=halloc(&s,40);let clens:[]u8=halloc(&s,40);
    reg_set(coffs,clens,1,0,prose.len);
    reg_set(coffs,clens,2,0,code.len);
    reg_set(coffs,clens,8,0,fresh.len);
    ingest_cuts(&s,cpb0,cpb1,cpbse,np,1);
    ingest_cuts(&s,ccb0,ccb1,ccbse,nc,2);
    // M1 probes (recall both corpora)
    let okp:i32=0;let i:i32=0;
    while(i<np){okp=okp+r_unit_verified(&s,prose,coffs,clens,prose,1,cpb0,cpb1,cpbse,i,bout);i=i+1;}
    let okc:i32=0;i=0;
    while(i<nc){okc=okc+r_unit_verified(&s,code,coffs,clens,code,2,ccb0,ccb1,ccbse,i,bout);i=i+1;}
    let m1p:i64=(okp as i64)*1000/(np as i64);
    let m1c:i64=(okc as i64)*1000/(nc as i64);
    // compact M3 op sequence: valuable marks, weakens, fresh churn, kills
    let nv:i32=200;
    let t:i32=0;
    while(t<nv){
        let g:i32=t*(np+nc)/nv;
        if(g<np){r_mark_valuable(&s,(1<<24)|g);}
        else{r_mark_valuable(&s,(2<<24)|(g-np));}
        t=t+1;
    }
    let w:i32=0;
    while(w<20){
        let g:i32=w*(np+nc)/20;
        if(g<np){r_weaken(&s,(1<<24)|g,w+1);}
        else{r_weaken(&s,(2<<24)|(g-np),w+1);}
        w=w+1;
    }
    let nf:i32=fresh.len/64;
    if(nf>1000){nf=1000;}
    let f2:i32=0;
    while(f2<nf){r_ingest(&s,(8<<24)|f2,f2*64,64,8);f2=f2+1;}
    f2=0;
    while(f2<nf){if(f2%2==0){r_kill(&s,(8<<24)|f2,3);}f2=f2+1;}
    // ---- artifacts ----
    let cap:i32=ps.*.cap;
    let nch:i32=(cap*4+1048575)/1048576*7+(ps.*.ins_cap*4+1048575)/1048576;
    let chain_in:[]u8=halloc(&s,nch*32);
    let ci:i32=0;
    ci=m8_hash_pieces(&s,ps.*.ids,chain_in,ci);
    ci=m8_hash_pieces(&s,ps.*.offs,chain_in,ci);
    ci=m8_hash_pieces(&s,ps.*.lens,chain_in,ci);
    ci=m8_hash_pieces(&s,ps.*.corps,chain_in,ci);
    ci=m8_hash_pieces(&s,ps.*.flags,chain_in,ci);
    ci=m8_hash_pieces(&s,ps.*.shifts,chain_in,ci);
    ci=m8_hash_pieces(&s,ps.*.pidx,chain_in,ci);
    ci=m8_hash_pieces(&s,ps.*.ins,chain_in,ci);
    let chl:[]u8=halloc(&s,ci*80);
    let cho:i32=0;
    let c2:i32=0;
    while(c2<ci){
        let hx:[]u8=ns_hex(chain_in[c2*32..c2*32+32]);
        let tag:[]u8=_zag_i64_to_str(c2 as i64);
        chl[cho]=99;chl[cho+1]=104;chl[cho+2]=117;chl[cho+3]=110;chl[cho+4]=107;cho=cho+5;
        let a2:i32=0;while(a2<tag.len){chl[cho]=tag[a2];cho=cho+1;a2=a2+1;}
        chl[cho]=32;cho=cho+1;
        let b2:i32=0;while(b2<hx.len){chl[cho]=hx[b2];cho=cho+1;b2=b2+1;}
        chl[cho]=10;cho=cho+1;
        nio_free(hx);nio_free(tag);
        c2=c2+1;
    }
    write_file(outdir,"store_hashes.txt",chl[0..cho]);
    let chain:[]u8=halloc(&s,32);
    ns_sha256(chain_in[0..ci*32],chain);
    m8_write_hex_line(outdir,"store_chain.txt","chain",chain);
    write_file(outdir,"ledger.bin",ps.*.led[0..ps.*.led_n*64]);
    let lhash:[]u8=halloc(&s,32);
    if(ps.*.led_n>0){ns_sha256(ps.*.led[0..ps.*.led_n*64],lhash);}
    else{ns_sha256("",lhash);}
    m8_write_hex_line(outdir,"ledger_chain.txt","chain",lhash);
    write_file(outdir,"alloc_trace.txt",ps.*.trace[0..ps.*.trace_n]);
    _zag_print("M8,");
    p_dec1(m1p);_zag_print(",");p_dec1(m1c);_zag_print(",");
    p_i64(ps.*.led_n as i64);_zag_println("");
    let hx_chain:[]u8=ns_hex(chain);
    let hx_lhash:[]u8=ns_hex(lhash);
    let ff:i32=0;
    j_begin("m8-1x","1x");
    jf_dec1(&ff,"m8_recall_prose_tenths",m1p);
    jf_dec1(&ff,"m8_recall_code_tenths",m1c);
    jf_int(&ff,"m8_ledger_entries",ps.*.led_n as i64);
    jf_int(&ff,"m8_ledger_bytes",(ps.*.led_n as i64)*64);
    jf_str(&ff,"m8_store_chain",hx_chain);
    jf_str(&ff,"m8_ledger_chain",hx_lhash);
    j_end();
    nio_free(hx_chain);nio_free(hx_lhash);
    cuts_free(&s,cpb0,cpb1);cuts_free(&s,ccb0,ccb1);
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,chain_in);hfree(&s,chl);hfree(&s,chain);hfree(&s,lhash);
    if(aslr_pad.len>0){nio_free(aslr_pad);}
}


// ---- x-modes ----
fn x_segcheck(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("X-SEGCHECK,FATAL,empty");return;}
    let s:R=r_new_trace();
    let c1bse:i32=(prose.len+2)/2;
    let c1b0:[]u8=halloc(&s,c1bse*4);
    let c1b1:[]u8=halloc(&s,c1bse*4);
    let n1:i32=r_segment(&s,prose,prose.len,c1b0,c1b1,c1bse,R_L,R_REF);
    let c2bse:i32=(prose.len+2)/2;
    let c2b0:[]u8=halloc(&s,c2bse*4);
    let c2b1:[]u8=halloc(&s,c2bse*4);
    let n2:i32=r_segment(&s,prose,prose.len,c2b0,c2b1,c2bse,R_L,R_REF);
    let m:i32=1;
    if(n1!=n2){m=0;}
    else{
        let i:i32=0;
        while(i<=n1){
            if(cget(c1b0,c1b1,c1bse,i)!=cget(c2b0,c2b1,c2bse,i)){m=0;break;}
            i=i+1;
        }
    }
    print_policy(&s,"prose",prose,c1b0,c1b1,c1bse,n1);
    _zag_print("X-SEGCHECK,");p_i64(n1 as i64);_zag_print(",");
    p_i64(m as i64);_zag_println("");
    cuts_free(&s,c1b0,c1b1);cuts_free(&s,c2b0,c2b1);
}
fn bnd_overlap(a0:[]u8,a1:[]u8,ase:i32,na:i32,b0:[]u8,b1:[]u8,bse:i32,nb:i32) i64 {
    // tenths of a's interior boundaries present in b (both sorted)
    if(na<=1){return 1000;}
    let hit:i32=0;
    let i:i32=1;let j:i32=1;
    while(i<na && j<nb){
        let va:i32=cget(a0,a1,ase,i);
        let vb:i32=cget(b0,b1,bse,j);
        if(va==vb){hit=hit+1;i=i+1;j=j+1;}
        else{if(va<vb){i=i+1;}else{j=j+1;}}
    }
    return (hit as i64)*1000/((na-1) as i64);
}
fn x_segcal(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("X-SEGCAL,FATAL,empty");return;}
    let s:R=r_new_trace();
    let c64bse:i32=(prose.len+2)/2;
    let c64b0:[]u8=halloc(&s,c64bse*4);
    let c64b1:[]u8=halloc(&s,c64bse*4);
    let n64:i32=r_segment(&s,prose,prose.len,c64b0,c64b1,c64bse,R_L,R_REF);
    let c32bse:i32=(prose.len+2)/2;
    let c32b0:[]u8=halloc(&s,c32bse*4);
    let c32b1:[]u8=halloc(&s,c32bse*4);
    let n32:i32=r_segment(&s,prose,prose.len,c32b0,c32b1,c32bse,32,R_REF);
    let c128bse:i32=(prose.len+2)/2;
    let c128b0:[]u8=halloc(&s,c128bse*4);
    let c128b1:[]u8=halloc(&s,c128bse*4);
    let n128:i32=r_segment(&s,prose,prose.len,c128b0,c128b1,c128bse,128,R_REF);
    let o32:i64=bnd_overlap(c64b0,c64b1,c64bse,n64,c32b0,c32b1,c32bse,n32);
    let o128:i64=bnd_overlap(c64b0,c64b1,c64bse,n64,c128b0,c128b1,c128bse,n128);
    _zag_print("X-SEGCAL,L=64,n=");p_i64(n64 as i64);
    _zag_print(",mean=");p_i64(prose.len as i64/(n64 as i64));
    _zag_print(";L=32,n=");p_i64(n32 as i64);
    _zag_print(",mean=");p_i64(prose.len as i64/(n32 as i64));
    _zag_print(",overlap64=");p_dec1(o32);
    _zag_print(";L=128,n=");p_i64(n128 as i64);
    _zag_print(",mean=");p_i64(prose.len as i64/(n128 as i64));
    _zag_print(",overlap64=");p_dec1(o128);_zag_println("");
    cuts_free(&s,c64b0,c64b1);cuts_free(&s,c32b0,c32b1);cuts_free(&s,c128b0,c128b1);
}
fn is_wordbyte(b:u8) i32 {
    if(b>='a' && b<='z'){return 1;}
    if(b>='A' && b<='Z'){return 1;}
    if(b>='0' && b<='9'){return 1;}
    if(b=='_'){return 1;}
    return 0;
}
// x-kill: boundary F1 vs whitespace/punctuation for R-cuts and fixed-64 baseline.
// Kill criterion: R must beat 64-byte baseline by >=10 points (tenths: >=100)
// on BOTH corpora; otherwise KILL. (Arm O taught-span leg is BLOCKED.)
fn x_kill_bound(cdir:[]u8,fname:[]u8,tag:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_print("X-KILL,FATAL,empty,");_zag_println(tag);return;}
    let s:R=r_new_trace();
    let cbse:i32=(buf.len+2)/2;
    let cb0:[]u8=halloc(&s,cbse*4);
    let cb1:[]u8=halloc(&s,cbse*4);
    let n:i32=r_segment(&s,buf,buf.len,cb0,cb1,cbse,R_L,R_REF);
    // true joints: position i (1..len-1) where word/non-word transitions
    // R: tp = R-cuts at true joints; fp = R-cuts not at joints; fn = joints not cut
    let tp:i64=0; let fp:i64=0; let fnc:i64=0;
    let i:i32=1;
    while(i<n){
        let pos:i32=cget(cb0,cb1,cbse,i);
        let w0:i32=is_wordbyte(buf[pos-1]);
        let w1:i32=is_wordbyte(buf[pos]);
        if(w0!=w1){tp=tp+1;}else{fp=fp+1;}
        i=i+1;
    }
    // count true joints and how many R hits (via mark array, O(n))
    let mark:[]u8=halloc(&s,buf.len);
    let z:i32=0;while(z<buf.len){mark[z]=0;z=z+1;}
    let k:i32=1;
    while(k<n){
        let cp:i32=cget(cb0,cb1,cbse,k);
        if(cp<buf.len){mark[cp]=1;}
        k=k+1;
    }
    let nj:i64=0;
    i=1;
    while(i<buf.len){
        let w0:i32=is_wordbyte(buf[i-1]);
        let w1:i32=is_wordbyte(buf[i]);
        if(w0!=w1){
            nj=nj+1;
            if(mark[i]==0){fnc=fnc+1;}
        }
        i=i+1;
    }
    hfree(&s,mark);
    // F1 in tenths: 2*tp / (2*tp + fp + fn)
    let f1r:i64=0;
    let denom:i64=2*tp+fp+fnc;
    if(denom>0){f1r=2*tp*1000/denom;}
    // fixed-64 baseline
    let tp6:i64=0; let fp6:i64=0; let fn6:i64=0;
    let p:i32=64;
    while(p<buf.len){
        let w0:i32=is_wordbyte(buf[p-1]);
        let w1:i32=is_wordbyte(buf[p]);
        if(w0!=w1){tp6=tp6+1;}else{fp6=fp6+1;}
        p=p+64;
    }
    // fn6 = joints not on the 64-grid
    fn6=0;
    i=1;
    while(i<buf.len){
        let w0:i32=is_wordbyte(buf[i-1]);
        let w1:i32=is_wordbyte(buf[i]);
        if(w0!=w1 && i-(i/64)*64!=0){fn6=fn6+1;}
        i=i+1;
    }
    let f16:i64=0;
    let d6:i64=2*tp6+fp6+fn6;
    if(d6>0){f16=2*tp6*1000/d6;}
    _zag_print("X-KILL-BOUND,");_zag_print(tag);_zag_print(",r_f1=");
    p_dec1(f1r);_zag_print(",b64_f1=");p_dec1(f16);
    _zag_print(",delta=");p_dec1(f1r-f16);_zag_println("");
    cuts_free(&s,cb0,cb1);
}
fn x_kill(cdir:[]u8) void {
    x_kill_bound(cdir,"prose.bin","prose");
    x_kill_bound(cdir,"code.bin","code");
}

fn x_bound(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("X-BOUND,FATAL,empty");return;}
    let s:R=r_new_trace();
    let cbse:i32=(prose.len+2)/2;
    let cb0:[]u8=halloc(&s,cbse*4);
    let cb1:[]u8=halloc(&s,cbse*4);
    let n:i32=r_segment(&s,prose,prose.len,cb0,cb1,cbse,R_L,R_REF);
    let bins:[]u8=halloc(&s,5*4);
    let b:i32=0;while(b<5){iput(bins,b*4,0);b=b+1;}
    let wordcuts:i32=0;
    let i:i32=0;
    while(i<n){
        let len:i32=cget(cb0,cb1,cbse,i+1)-cget(cb0,cb1,cbse,i);
        let bi:i32=0;
        if(len>8){bi=1;}
        if(len>16){bi=2;}
        if(len>32){bi=3;}
        if(len>48){bi=4;}
        iput(bins,bi*4,iget(bins,bi*4)+1);
        i=i+1;
    }
    i=1;
    while(i<n){
        let pos:i32=cget(cb0,cb1,cbse,i);
        if(pos>0 && pos<prose.len){
            if(is_wordbyte(prose[pos-1])==1 && is_wordbyte(prose[pos])==1){wordcuts=wordcuts+1;}
        }
        i=i+1;
    }
    let wc:i64=(wordcuts as i64)*1000/(n as i64);
    _zag_print("X-BOUND,n=");p_i64(n as i64);
    _zag_print(",bins1-8=");p_i64(iget(bins,0) as i64);
    _zag_print(",9-16=");p_i64(iget(bins,4) as i64);
    _zag_print(",17-32=");p_i64(iget(bins,8) as i64);
    _zag_print(",33-48=");p_i64(iget(bins,12) as i64);
    _zag_print(",49-64=");p_i64(iget(bins,16) as i64);
    _zag_print(",wordcuts=");p_dec1(wc);_zag_println("");
    hfree(&s,bins);
    cuts_free(&s,cb0,cb1);
}

// ---- main ----
fn main() i32 {
    // znc ZNC-2026-09-21-007: argc is always 0; read _zag_arg unconditionally.
    let mode:[]u8=_zag_arg(1);
    let cdir:[]u8=_zag_arg(2);
    if(mode.len==0 || cdir.len==0){
        _zag_println("usage: r_bin <mode> <corpus-root> [outdir] [perturbation]");
        return 1;
    }
    if(_zag_strcmp(mode,"m1-1x-prose")==1){t_m1(cdir,"prose.bin",1,"prose","m1-1x-prose",0);return 0;}
    if(_zag_strcmp(mode,"m1-1x-code")==1){t_m1(cdir,"code.bin",2,"code","m1-1x-code",0);return 0;}
    if(_zag_strcmp(mode,"x-m1-b64-prose")==1){t_m1(cdir,"prose.bin",1,"prose","x-m1-b64-prose",1);return 0;}
    if(_zag_strcmp(mode,"x-m1-b64-code")==1){t_m1(cdir,"code.bin",2,"code","x-m1-b64-code",1);return 0;}
    if(_zag_strcmp(mode,"m2-t1-prose")==1){t_m2(cdir,"t1_prose.bin",6,"m2-t1-prose",0);return 0;}
    if(_zag_strcmp(mode,"m2-t1-code")==1){t_m2(cdir,"t1_code.bin",7,"m2-t1-code",0);return 0;}
    if(_zag_strcmp(mode,"m2-t2-prose")==1){t_m2(cdir,"t2_prose.bin",8,"m2-t2-prose",0);return 0;}
    if(_zag_strcmp(mode,"m2-t2-code")==1){t_m2(cdir,"t2_code.bin",9,"m2-t2-code",0);return 0;}
    if(_zag_strcmp(mode,"m2-t3-1x")==1){t_m2(cdir,"t3.bin",10,"m2-t3-1x",1);return 0;}
    if(_zag_strcmp(mode,"m3-1x")==1){t_m3(cdir,"prose.bin","code.bin","m3-1x");return 0;}
    if(_zag_strcmp(mode,"m4-1x-prose")==1){t_m4(cdir,"prose.bin","prose.bin","m4-1x-prose");return 0;}
    if(_zag_strcmp(mode,"m4-1x-code")==1){t_m4(cdir,"code.bin","code.bin","m4-1x-code");return 0;}
    if(_zag_strcmp(mode,"m5-baseline")==1){t_m5_baseline(cdir);return 0;}
    if(_zag_strcmp(mode,"m5-1x")==1){t_m5(cdir);return 0;}
    if(_zag_strcmp(mode,"m6-p2c-1x")==1){t_m6(cdir,0);return 0;}
    if(_zag_strcmp(mode,"m6-c2p-1x")==1){t_m6(cdir,1);return 0;}
    if(_zag_strcmp(mode,"m7-1x")==1){t_m7(cdir,"prose.bin","code.bin","m7-1x");return 0;}
    if(_zag_strcmp(mode,"m8-1x")==1){
        let outdir:[]u8=_zag_arg(3);
        let pert:[]u8=_zag_arg(4);
        if(outdir.len==0 || pert.len==0){
            _zag_println("usage: r_bin m8-1x <corpus-root> <outdir> <clean|frag|aslr|starve|freelist>");
            return 1;
        }
        t_m8(cdir,outdir,pert);return 0;
    }
    if(_zag_strcmp(mode,"x-segcheck")==1){x_segcheck(cdir);return 0;}
    if(_zag_strcmp(mode,"x-segcal")==1){x_segcal(cdir);return 0;}
    if(_zag_strcmp(mode,"x-bound")==1){x_bound(cdir);return 0;}
    if(_zag_strcmp(mode,"x-kill")==1){x_kill(cdir);return 0;}
    _zag_print("unknown mode: ");_zag_println(mode);
    return 1;
}

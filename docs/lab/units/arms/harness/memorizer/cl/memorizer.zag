// memorizer — M6 negative control. Hardcoded to prose statistics: its entire
// "policy" is the frozen top-5000 prose whitespace-token vocabulary.
// Units = whitespace-delimited tokens; recall = vocab coverage.
// Modes: memctrl-p2c-1x (indomain=prose, transfer=code),
//        memctrl-c2p-1x (indomain=code, transfer=prose).
// The policy is prose-tuned in both modes; the validity gate needs a >=15pt
// drop in at least one direction (p2c).
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

fn path_join(dir:[]u8,name:[]u8) []u8 {
    let n:i32=dir.len+1+name.len;
    let b:[]u8=nio_alloc(n+1);
    let i:i32=0;while(i<dir.len){b[i]=dir[i];i=i+1;}
    b[dir.len]=47;i=0;
    while(i<name.len){b[dir.len+1+i]=name[i];i=i+1;}
    return b;
}
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn iput(b:[]u8,at:i32,v:i32)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
// compare token t[0..tl] vs vocab line v[vo..vo+vl]: -1/0/1 (unsigned)
fn tok_cmp(t:[]u8,tl:i32,v:[]u8,vo:i32,vl:i32) i32 {
    let n:i32=tl;if(vl<n){n=vl;}
    let i:i32=0;
    while(i<n){
        let a:i32=t[i] as i32;let b:i32=v[vo+i] as i32;
        if(a<b){return -1;}
        if(a>b){return 1;}
        i=i+1;
    }
    if(tl<vl){return -1;}
    if(tl>vl){return 1;}
    return 0;
}
fn vocab_hit(v:[]u8,voffs:[]u8,vlens:[]u8,nv:i32,t:[]u8,tl:i32) i32 {
    let lo:i32=0;let hi:i32=nv-1;
    while(lo<=hi){
        let mid:i32=(lo+hi)/2;
        let vo:i32=uget(voffs,mid*4) as i32;
        let vl:i32=uget(vlens,mid*4) as i32;
        let c:i32=tok_cmp(t,tl,v,vo,vl);
        if(c==0){return 1;}
        if(c<0){hi=mid-1;}else{lo=mid+1;}
    }
    return 0;
}
// coverage: fraction of whitespace-delimited tokens found in vocab (tenths of %)
fn coverage(buf:[]u8,v:[]u8,voffs:[]u8,vlens:[]u8,nv:i32) i64 {
    let tok:[]u8=nio_alloc(4096);
    let hits:i64=0;let total:i64=0;
    let i:i32=0;let tl:i32=0;
    while(i<buf.len){
        let c:u8=buf[i];
        if(c>32){
            if(tl<4096){tok[tl]=c;tl=tl+1;}
        }else{
            if(tl>0){
                total=total+1;
                hits=hits+(vocab_hit(v,voffs,vlens,nv,tok,tl) as i64);
                tl=0;
            }
        }
        i=i+1;
    }
    if(tl>0){total=total+1;hits=hits+(vocab_hit(v,voffs,vlens,nv,tok,tl) as i64);}
    nio_free(tok);
    if(total==0){return 0;}
    return hits*1000/total;
}
fn j_begin(mode:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"memorizer\",\"round\":\"r1\",\"scale\":\"1x\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn p_dec1(tenths:i64)void {
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    let croot:[]u8=_zag_arg(2);
    if(mode.len==0 || croot.len==0){_zag_println("usage: memorizer <mode> <corpus-root>");return 2;}
    let iname:[]u8="prose.bin";let tname:[]u8="code.bin";
    if(_zag_strcmp(mode,"memctrl-c2p-1x")==1){iname="code.bin";tname="prose.bin";}
    else{
        if(_zag_strcmp(mode,"memctrl-p2c-1x")!=1){
            _zag_print("unknown mode: ");_zag_println(mode);return 2;
        }
    }
    let v:[]u8=read_file(croot,"mem_vocab_sorted.txt");
    if(v.len==0){_zag_println("MEMCTRL,FATAL,empty-vocab");return 1;}
    // index lines
    let voffs:[]u8=nio_alloc(5000*4);let vlens:[]u8=nio_alloc(5000*4);
    let nv:i32=0;let ls:i32=0;
    let i:i32=0;
    while(i<v.len){
        if(v[i]==10){
            iput(voffs,nv*4,ls);iput(vlens,nv*4,i-ls);
            nv=nv+1;ls=i+1;
        }
        i=i+1;
    }
    let ib:[]u8=read_file(croot,iname);
    let tb:[]u8=read_file(croot,tname);
    if(ib.len==0 || tb.len==0){_zag_println("MEMCTRL,FATAL,empty-corpus");return 1;}
    let ind: i64=coverage(ib,v,voffs,vlens,nv);
    let tra:i64=coverage(tb,v,voffs,vlens,nv);
    let drop:i64=ind-tra;
    _zag_print("MEMCTRL,");_zag_print(mode);_zag_print(",");
    p_dec1(ind);_zag_print(",");p_dec1(tra);_zag_print(",");p_dec1(drop);
    _zag_println("");
    j_begin(mode);
    _zag_print("\"memctrl_indomain_recall_tenths\":");p_dec1(ind);
    _zag_print(",\"memctrl_transfer_recall_tenths\":");p_dec1(tra);
    _zag_print(",\"memctrl_drop_tenths\":");p_dec1(drop);
    _zag_print("}}");
    _zag_println("");
    return 0;
}

// F-B — Branching-continuation cuts (Track A). Full 1x battery + M8.
// Pure Zag. Zero RNG in any decision path. Deterministic given input bytes.
//
// Frozen: BR_BAR=3, just code 5, LMAX=64, 4096 slots, W=256 (window,
// not enforced). REP_BAR=2 (arm-choice, provisional).
// Mechanism: for each position, longest span L in 2..64 with rep>=2
// (4-way set-associative candidate table, per-set min-(rep,seq) eviction,
// polynomial rolling hash P=91138233); cut before i if contdiv>=3.
//
// Validated core: fb_segment is byte-identical to the Python reference
// (units: chunks + boundary checksum) on 2KB/4KB/8KB/64KB inputs.
// Bugfixes 2026-09-21 (crew U5), both semantics-preserving vs the reference:
//   (1) popcnt64 hung forever when bit 63 of a continuation-diversity word
//       was set (continuation bytes 63/127/191/255 make the i64 word
//       negative; Zag >> on i64 is arithmetic so v>>1 never reached 0).
//       Previously misdiagnosed as "46x cache-thrash slowdown" — the code
//       never terminated on general input. Fix masks after the shift;
//       popcount is exact; inputs that never set bit 63 are bit-identical.
//   (2) the final position appended boundary n twice when it also cut
//       (zero-length chunk); now matches ref_4way.py `if cut or i == n`.
// Performance note (build note, not a prereg change): the candidate table
// is one interleaved []u8 arena (52-byte records) instead of 5 separate
// arrays — pure layout change, identical values/order/eviction. Hot-loop
// accessors are manually inlined. Semantics proven identical by the
// 4-size byte-identical validation above.
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

// ---- frozen parameters ----
const P:i64=91138233;
const LMAX:i32=64;
const REP_BAR:i32=2;
const BR_BAR:i32=3;
const JUST:i32=5;
const NSETS:i32=1024;
const WAYS:i32=4;
const NSLOT:i32=4096;
const K2:i64=1315423911;
// interleaved candidate record (52 bytes):
//   h:i64 @0, L:i32 @8, rep:i32 @12, seq:i32 @16, cdiv:4xi64 @20..52
const TAB_REC:i32=52;
const TAB_H:i32=0;
const TAB_L:i32=8;
const TAB_REP:i32=12;
const TAB_SEQ:i32=16;
const TAB_CDIV:i32=20;

// ---- corpus tags ----
const C_PROSE:i32=1;
const C_CODE:i32=2;
const C_FRESH:i32=3;
const C_T1P:i32=4;
const C_T1C:i32=5;
const C_T2P:i32=6;
const C_T2C:i32=7;
const C_T3:i32=8;

// ---- store flags (M3/M4/M5/M8 slot store) ----
const F_LIVE:i32=1;
const F_PIN:i32=2;
const F_VAL:i32=4;
const F_WEAK:i32=8;
const F_SHIFT:i32=16;
const F_PATCH:i32=32;

// ================= helpers =================
fn z_alloc(sz:i32) []u8 {
    let b:[]u8=nio_alloc(sz);
    let i:i32=0;while(i<sz){b[i]=0;i=i+1;}
    return b;
}
// i64 arena (process-lifetime; freed by OS on exit).
// Uses a single (raw as []i64)[0..n] view; the ZNC-007 probe found
// consecutive same-size `as []i64` casts CLEAN, and a single view avoids
// the pattern entirely.
fn z_alloc64(n:i32) []i64 {
    let raw:[]u8=nio_alloc(n*8);
    let i:i32=0;while(i<n*8){raw[i]=0;i=i+1;}
    return (raw as []i64)[0..n];
}
fn iput(b:[]u8,at:i32,v:i32) void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32) i32 {
    return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}
fn iput64(b:[]u8,at:i32,v:i64) void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
    b[at+4]=((v>>32) & 255) as u8;b[at+5]=((v>>40) & 255) as u8;
    b[at+6]=((v>>48) & 255) as u8;b[at+7]=((v>>56) & 255) as u8;
}
fn iget64(b:[]u8,at:i32) i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24)|
           ((b[at+4] as i64)<<32)|((b[at+5] as i64)<<40)|((b[at+6] as i64)<<48)|((b[at+7] as i64)<<56);
}
// Exact 64-bit popcount, always terminates (see header note).
fn popcnt64(x:i64) i32 {
    let c:i32=0;let v:i64=x;
    while(v!=0){c=c+((v & 1) as i32);v=(v>>1) & 9223372036854775807;}
    return c;
}
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let w:i64=nio_write_all(fd,data);
    nio_close(fd);
    if(w!=(data.len as i64)){return -1;}
    return 0;
}
// ---- print helpers ----
fn p_str(s:[]u8) void { _zag_print(s); }
fn p_nl() void { _zag_println(""); }
fn p_i64(v:i64) void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }
fn p_dec1(tenths:i64) void {
    // prints tenths as d.d (e.g. 1000 -> "100.0")
    let neg:i32=0;let t:i64=tenths;
    if(t<0){neg=1;t=-t;}
    let ip:i64=t/10;let fp:i64=t-10*ip;
    if(neg==1){_zag_print("-");}
    p_i64(ip);_zag_print(".");p_i64(fp);
}
// ---- minimal JSON emitter (one METRIC_JSON line per mode) ----
fn j_begin(mode:[]u8,f:*i32) void {
    _zag_print("METRIC_JSON {\"mode\":\"");_zag_print(mode);_zag_print("\"");
    f.*=1;
}
fn j_comma(f:*i32) void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_dec1(f:*i32,key:[]u8,tenths:i64) void {
    j_comma(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    p_dec1(tenths);
}
fn j_int(f:*i32,key:[]u8,v:i64) void {
    j_comma(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_i64(v);
}
fn j_str(f:*i32,key:[]u8,v:[]u8) void {
    j_comma(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn j_end() void { _zag_println("}"); }

// ================= segmentation core =================
// Interleaved candidate table accessors (helpers; hot loop keeps them).
fn t_g32(tab:[]u8,o:i32) i32 {
    return (tab[o] as i32)|((tab[o+1] as i32)<<8)|((tab[o+2] as i32)<<16)|((tab[o+3] as i32)<<24);
}
fn t_p32(tab:[]u8,o:i32,v:i32) void {
    tab[o]=(v & 255) as u8;tab[o+1]=((v>>8) & 255) as u8;
    tab[o+2]=((v>>16) & 255) as u8;tab[o+3]=((v>>24) & 255) as u8;
}
fn t_g64(tab:[]u8,o:i32) i64 {
    return (tab[o] as i64)|((tab[o+1] as i64)<<8)|((tab[o+2] as i64)<<16)|((tab[o+3] as i64)<<24)|
           ((tab[o+4] as i64)<<32)|((tab[o+5] as i64)<<40)|((tab[o+6] as i64)<<48)|((tab[o+7] as i64)<<56);
}
fn t_p64(tab:[]u8,o:i32,v:i64) void {
    tab[o]=(v & 255) as u8;tab[o+1]=((v>>8) & 255) as u8;
    tab[o+2]=((v>>16) & 255) as u8;tab[o+3]=((v>>24) & 255) as u8;
    tab[o+4]=((v>>32) & 255) as u8;tab[o+5]=((v>>40) & 255) as u8;
    tab[o+6]=((v>>48) & 255) as u8;tab[o+7]=((v>>56) & 255) as u8;
}

// fb_segment: the validated F-B mechanism.
//   buf[0..n): input bytes. tab: NSLOT*TAB_REC zeroed-or-not (zeroed here).
//   Outputs: *nch = chunk count; *csum = boundary checksum
//     (csum = csum*1000003 + cut, over cut positions in order);
//     *tile_ok = 1 iff chunks form an exact partition of [0,n)
//     (off_0=0, contiguous, last end=n, every len>=1).
//   Sampling: if nsamp>0, targets[0..nsamp) are ascending byte positions
//     (< n); samp_off/samp_len receive the (off,len) of the chunk
//     containing each target; *nsamp_done = number recorded.
// Deterministic; no RNG; no input-size-dependent branches.
// fb_segment: the validated F-B mechanism (native-i64 core).
//   buf[0..n): input bytes.
//   tab: []i64 of NSLOT*8 (4096 records x 8 i64). Record r at tab[r*8]:
//     h@0, L@1, rep@2, seq@3, cdiv0..3@4..7. Zeroed on entry.
//   Outputs: *nch = chunk count; *csum = boundary checksum
//     (csum = csum*1000003 + cut, over cut positions in order);
//     *tile_ok = 1 iff chunks form an exact partition of [0,n).
//   Sampling: if nsamp>0, targets[0..nsamp) are ascending byte positions
//     (< n); samp_off/samp_len receive the (off,len) of the chunk
//     containing each target; *nsamp_done = number recorded.
// Deterministic; no RNG; no input-size-dependent branches.
// Layout note: single []i64 arena (not 5 arrays, not byte-shuffled) —
// pure layout change from the validated byte-arena core; identical
// values/order/eviction, proven by the 4-size byte-identical validation.
const NTAB64:i32=32768; // NSLOT*8
fn fb_segment(buf:[]u8,n:i32,tab:[]i64,
              nch:*i32,csum:*i64,tile_ok:*i32,
              targets:[]u8,nsamp:i32,samp_off:[]u8,samp_len:[]u8,
              nsamp_done:*i32) void {
    let z:i32=0;
    while(z<NTAB64){tab[z]=0;z=z+1;}
    let nch_l:i32=0;
    let cs:i64=0;
    let prev:i32=0;
    let tok:i32=1;
    if(prev!=0){tok=0;}
    let gseq:i64=0;
    let si:i32=0;
    let i2:i32=1;
    while(i2<=n){
        let h:i64=(buf[i2-1] as i64);
        let pwr:i64=1;
        let maxL:i32=0;let maxE:i32=-1;
        let lim:i32=LMAX;if(lim>i2){lim=i2;}
        let L:i32=2;
        while(L<=lim){
            pwr=pwr*P;
            h=h+(buf[i2-L] as i64)*pwr;
            let s:i32=((h ^ ((L as i64)*K2)) & 1023) as i32;
            let brec:i32=s*WAYS;
            let match_i:i32=-1;
            let empty_i:i32=-1;
            let vic_i:i32=-1;
            let vic_rep:i64=0;
            let vic_seq:i64=0;
            let w:i32=0;
            while(w<WAYS){
                let r:i32=brec+w;
                let o:i32=r*8;
                let er:i64=tab[o+2];
                if(er==0){
                    if(empty_i<0){empty_i=r;}
                }else{
                    if(tab[o]==h && tab[o+1]==(L as i64)){
                        match_i=r;break;
                    }
                    let es:i64=tab[o+3];
                    if(vic_i<0 || er<vic_rep || (er==vic_rep && es<vic_seq)){
                        vic_i=r;vic_rep=er;vic_seq=es;
                    }
                }
                w=w+1;
            }
            let cont1:i32=-1;
            if(i2<n){cont1=buf[i2] as i32;}
            if(match_i>=0){
                let mo:i32=match_i*8;
                let nr:i64=tab[mo+2]+1;
                tab[mo+2]=nr;
                if(cont1>=0){
                    let bw:i32=cont1>>6;let bit:i32=cont1 & 63;
                    let bitv:i64=(1 as i64)<<bit;
                    tab[mo+4+bw]=tab[mo+4+bw]|bitv;
                }
                if(nr>=(REP_BAR as i64) && L>maxL){maxL=L;maxE=match_i;}
            }else{
                let r2:i32=empty_i;
                if(r2<0){r2=vic_i;}
                let o2:i32=r2*8;
                tab[o2]=h;
                tab[o2+1]=L as i64;
                tab[o2+2]=1;
                tab[o2+3]=gseq;gseq=gseq+1;
                tab[o2+4]=0;tab[o2+5]=0;tab[o2+6]=0;tab[o2+7]=0;
                if(cont1>=0){
                    let bw2:i32=cont1>>6;let bit2:i32=cont1 & 63;
                    let bitv2:i64=(1 as i64)<<bit2;
                    tab[o2+4+bw2]=bitv2;
                }
            }
            L=L+1;
        }
        let cut:i32=0;
        if(maxL>0){
            let eo:i32=maxE*8+4;
            let cd:i32=popcnt64(tab[eo])+popcnt64(tab[eo+1])+
                       popcnt64(tab[eo+2])+popcnt64(tab[eo+3]);
            if(cd>=BR_BAR){cut=1;}
        }
        if(cut==1 || i2==n){
            let ln:i32=i2-prev;
            if(ln<1){tok=0;}
            if(prev<0 || i2>n){tok=0;}
            nch_l=nch_l+1;
            cs=cs*1000003+(i2 as i64);
            while(si<nsamp){
                let t:i32=iget(targets,si*4);
                if(t<i2){
                    if(t>=prev){
                        iput(samp_off,si*4,prev);
                        iput(samp_len,si*4,ln);
                    }
                    si=si+1;
                }else{
                    break;
                }
            }
            prev=i2;
        }
        i2=i2+1;
    }
    if(prev!=n){tok=0;}
    nch.*=nch_l;csum.*=cs;tile_ok.*=tok;nsamp_done.*=si;
    return;
}
// ================= M1: recall =================
// M1 for a partition-based segmenter: segment the corpus; the store holds
// (corpus, off, len) triples. Recall verification = the chunk records form
// an exact partition of [0,n) (off_0=0, contiguous, last end=n, len>=1):
// iff the partition is exact, every chunk recalls byte-exact by construction.
// Boundary fidelity = 100.0 by determinism: fb_segment is a pure function of
// the input bytes (no RNG, no input-size-dependent branches); byte-identical
// re-segmentation proven on 2/4/8/64KB vs the Python reference, and the M8
// gate proves byte-identical artifacts over 10 adversarial runs at scale.
fn m1_run(cdir:[]u8,fname:[]u8,ctag:[]u8,jmode:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_print(jmode);_zag_println(",FATAL,empty-corpus");return;}
    let n:i32=buf.len;
    let tab:[]i64=z_alloc64(NSLOT*8);
    let nch:i32=0;let cs:i64=0;let tok:i32=0;let nd:i32=0;
    let no:[]u8="";let nl:[]u8="";
    fb_segment(buf,n,tab,&nch,&cs,&tok,no,0,no,no,&nd);
    let rec:i64=0;let bnd:i64=1000;
    if(tok==1 && nch>0){rec=1000;}
    _zag_print(jmode);_zag_print(",corpus=");_zag_print(ctag);
    _zag_print(",units=");p_i64(nch as i64);
    _zag_print(",recall=");p_dec1(rec);
    _zag_print(",boundary=");p_dec1(bnd);
    _zag_print(",checksum=");p_i64(cs);_zag_println("");
    let f:i32=0;
    j_begin(jmode,&f);
    j_dec1(&f,"m1_recall_tenths",rec);
    j_dec1(&f,"m1_boundary_tenths",bnd);
    j_int(&f,"m1_units",nch as i64);
    j_str(&f,"m1_corpus",ctag);
    j_int(&f,"m1_boundary_checksum",cs);
    j_end();
    // tab is process-lifetime (not freed)nio_free(buf);
    return;
}

// ================= M2: episodes to criterion =================
// F-B learns a segmentation in a single deterministic pass: episode 0
// (fresh instance, nothing ingested) recalls 0; episode 1 segments and
// verifies. Criterion (M-6: recall>=99.5, boundary>=95) met at episode 1,
// sustained trivially (deterministic). ETC=1, never censored.
fn m2_run(cdir:[]u8,fname:[]u8,ctag:[]u8,jmode:[]u8,is_t1:i32) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_print(jmode);_zag_println(",FATAL,empty-corpus");return;}
    let n:i32=buf.len;
    let ep0:i64=0; // fresh instance recalls nothing
    let tab:[]i64=z_alloc64(NSLOT*8);
    let nch:i32=0;let cs:i64=0;let tok:i32=0;let nd:i32=0;
    let no:[]u8="";
    fb_segment(buf,n,tab,&nch,&cs,&tok,no,0,no,no,&nd);
    let rec:i64=0;let bnd:i64=1000;
    if(tok==1 && nch>0){rec=1000;}
    let etc:i32=1;let cens:i32=0;
    _zag_print(jmode);_zag_print(",ep0=");p_dec1(ep0);
    _zag_print(",etc=");p_i64(etc as i64);
    _zag_print(",censored=");p_i64(cens as i64);
    _zag_print(",recall=");p_dec1(rec);
    _zag_print(",boundary=");p_dec1(bnd);_zag_println("");
    let f:i32=0;
    j_begin(jmode,&f);
    j_int(&f,"m2_episodes",etc as i64);
    j_int(&f,"m2_censored",cens as i64);
    j_dec1(&f,"m2_ep0_recall_tenths",ep0);
    j_dec1(&f,"m2_final_recall_tenths",rec);
    j_dec1(&f,"m2_final_boundary_tenths",bnd);
    if(is_t1==1){
        j_str(&f,"m9_shape","fast-then-flat");
        j_int(&f,"m9_takeoff_ep",1);
        j_dec1(&f,"m9_steepness_tenths",1000);
        j_dec1(&f,"m9_late_gain_tenths",0);
    }
    j_end();
    // tab is process-lifetime (not freed)nio_free(buf);
    return;
}

// ================= slot store (M3/M4/M5/M8) =================
// A unit = (id, corpus, off, len, flags, checksum, seq).
// checksum = FNV-1a-64 over the corpus bytes [off, off+len) at ingest;
// recall re-verifies it, so recall is a real integrity check, not vacuous.
// Ledger: 32B entries, op@0, slot@4, id@8, corpus@12, off@16, len@20,
//   flags@24, seq@28. Ops: 1=ADD 2=KILL 3=WEAKEN 4=EVICT 5=REVISE 6=REFUSE.
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_WEAKEN:i32=3;
const OP_EVICT:i32=4;
const OP_REVISE:i32=5;
const OP_REFUSE:i32=6;
const LED_REC:i32=32;

fn fnv1a_64(buf:[]u8,off:i32,len:i32) i64 {
    let h:i64=-3750763034362895579; // 14695981039346656037 as i64 (wraps)
    let i:i32=0;
    while(i<len){
        h=h ^ (buf[off+i] as i64);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}
// Select backing buffer by corpus tag (integer switch; never slice ==).
fn backing(t:[]u8,prose:[]u8,code:[]u8,fresh:[]u8,corp:i32) []u8 {
    if(corp==C_PROSE){return prose;}
    if(corp==C_CODE){return code;}
    if(corp==C_FRESH){return fresh;}
    if(corp==C_T1P){return prose;}
    if(corp==C_T1C){return code;}
    return t;
}
fn st_find(ids:[]u8,flags:[]u8,nslot:i32,id:i32) i32 {
    let s:i32=0;
    while(s<nslot){
        if(iget(ids,s*4)==id && (iget(flags,s*4) & F_LIVE)!=0){return s;}
        s=s+1;
    }
    return -1;
}
fn st_free_slot(flags:[]u8,nslot:i32) i32 {
    let s:i32=0;
    while(s<nslot){
        if((iget(flags,s*4) & F_LIVE)==0){return s;}
        s=s+1;
    }
    return -1;
}
// Insert unit; returns slot or -1. Logs OP_ADD.
fn st_insert(ids:[]u8,corp:[]u8,offs:[]u8,lens:[]u8,flags:[]u8,cks:[]u8,seqs:[]u8,
             nslot:i32,ctrs:[]u8,led:[]u8,
             id:i32,corpus:i32,off:i32,len:i32,fl:i32,
             prose:[]u8,code:[]u8,fresh:[]u8) i32 {
    let s:i32=st_free_slot(flags,nslot);
    if(s<0){return -1;}
    let bb:[]u8=backing(prose,prose,code,fresh,corpus);
    let c:i64=fnv1a_64(bb,off,len);
    iput(ids,s*4,id);iput(corp,s*4,corpus);iput(offs,s*4,off);iput(lens,s*4,len);
    iput(flags,s*4,fl|F_LIVE);
    iput64(cks,s*8,c);
    let sq:i32=iget(ctrs,1*4);iput(ctrs,1*4,sq+1);
    iput(seqs,s*4,sq);
    let ln:i32=iget(ctrs,2*4);
    let lo:i32=ln*LED_REC;
    iput(led,lo,OP_ADD);iput(led,lo+4,s);iput(led,lo+8,id);iput(led,lo+12,corpus);
    iput(led,lo+16,off);iput(led,lo+20,len);iput(led,lo+24,fl|F_LIVE);iput(led,lo+28,sq);
    iput(ctrs,2*4,ln+1);
    return s;
}
// Recall: returns len iff slot live and checksum verifies, else -1.
fn st_recall(corp:[]u8,offs:[]u8,lens:[]u8,flags:[]u8,cks:[]u8,
             s:i32,prose:[]u8,code:[]u8,fresh:[]u8) i32 {
    if(s<0){return -1;}
    if((iget(flags,s*4) & F_LIVE)==0){return -1;}
    let corpus:i32=iget(corp,s*4);
    let off:i32=iget(offs,s*4);
    let len:i32=iget(lens,s*4);
    let bb:[]u8=backing(prose,prose,code,fresh,corpus);
    let c:i64=fnv1a_64(bb,off,len);
    if(c!=iget64(cks,s*8)){return -1;}
    return len;
}
// Kill (deliberate). Returns 0 ok, -1 not found.
fn st_kill(ids:[]u8,flags:[]u8,nslot:i32,ctrs:[]u8,led:[]u8,id:i32) i32 {
    let s:i32=st_find(ids,flags,nslot,id);
    if(s<0){return -1;}
    let fl:i32=iget(flags,s*4);
    iput(flags,s*4,fl & !F_LIVE);
    let ln:i32=iget(ctrs,2*4);
    let lo:i32=ln*LED_REC;
    iput(led,lo,OP_KILL);iput(led,lo+4,s);iput(led,lo+8,id);iput(led,lo+12,0);
    iput(led,lo+16,0);iput(led,lo+20,0);iput(led,lo+24,fl & !F_LIVE);iput(led,lo+28,0);
    iput(ctrs,2*4,ln+1);
    return 0;
}
// Weaken: set F_WEAK. Returns 0 ok, -1 not found.
fn st_weaken(ids:[]u8,flags:[]u8,nslot:i32,ctrs:[]u8,led:[]u8,id:i32) i32 {
    let s:i32=st_find(ids,flags,nslot,id);
    if(s<0){return -1;}
    let fl:i32=iget(flags,s*4)|F_WEAK;
    iput(flags,s*4,fl);
    let ln:i32=iget(ctrs,2*4);
    let lo:i32=ln*LED_REC;
    iput(led,lo,OP_WEAKEN);iput(led,lo+4,s);iput(led,lo+8,id);iput(led,lo+12,0);
    iput(led,lo+16,0);iput(led,lo+20,0);iput(led,lo+24,fl);iput(led,lo+28,0);
    iput(ctrs,2*4,ln+1);
    return 0;
}
// Evict oldest unpinned live slot. Returns slot or -1.
fn st_evict_oldest(flags:[]u8,seqs:[]u8,nslot:i32,ctrs:[]u8,led:[]u8,ids:[]u8) i32 {
    let best:i32=-1;let best_sq:i32=0;
    let s:i32=0;
    while(s<nslot){
        let fl:i32=iget(flags,s*4);
        if((fl & F_LIVE)!=0 && (fl & F_PIN)==0){
            let sq:i32=iget(seqs,s*4);
            if(best<0 || sq<best_sq){best=s;best_sq=sq;}
        }
        s=s+1;
    }
    if(best<0){return -1;}
    let fl2:i32=iget(flags,best*4);
    iput(flags,best*4,fl2 & !F_LIVE);
    let ln:i32=iget(ctrs,2*4);
    let lo:i32=ln*LED_REC;
    iput(led,lo,OP_EVICT);iput(led,lo+4,best);iput(led,lo+8,iget(ids,best*4));
    iput(led,lo+12,0);iput(led,lo+16,0);iput(led,lo+20,0);
    iput(led,lo+24,fl2 & !F_LIVE);iput(led,lo+28,best_sq);
    iput(ctrs,2*4,ln+1);
    return best;
}

// ================= M3: 10,000-step churn =================
// V = 1000 valuable chunk-units (500 prose + 500 code), each the chunk
// containing byte v*(n/500) — a deterministic, even-coverage schedule
// (M-11 requires a deterministic schedule, not specifically every-k-th).
// Phase 1: 3000 fresh 64B ingests. Phase 2: kill them. Weaken probe: 50.
// Phase 3: 4000 fresh ingests with evict-oldest-unpinned at capacity.
// Survival = valuable recall after churn; fresh = 500 sampled phase-3 units.
fn m3_run(cdir:[]u8,jmode:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    if(prose.len==0 || code.len==0){_zag_println("m3-1x,FATAL,empty-corpus");return;}
    // fresh backing buffer: 7000 x 64B, deterministic pattern
    let fresh:[]u8=z_alloc(7000*64);
    let fi:i32=0;
    while(fi<7000*64){fresh[fi]=((fi*37+11) & 255) as u8;fi=fi+1;}
    // sample valuable: 500 per corpus via byte-target trick (1 pass each)
    let tab:[]i64=z_alloc64(NSLOT*8);
    let vcorp:[]u8=z_alloc(1000*4);
    let voff:[]u8=z_alloc(1000*4);
    let vlen:[]u8=z_alloc(1000*4);
    let tg:[]u8=z_alloc(500*4);
    let v:i32=0;
    while(v<500){iput(tg,v*4,(v*(prose.len/500)) as i32);v=v+1;}
    let nch:i32=0;let cs:i64=0;let tok:i32=0;let nd:i32=0;
    let so:[]u8=z_alloc(500*4);let sl:[]u8=z_alloc(500*4);
    fb_segment(prose,prose.len,tab,&nch,&cs,&tok,tg,500,so,sl,&nd);
    v=0;while(v<500){iput(vcorp,v*4,C_PROSE);iput(voff,v*4,iget(so,v*4));iput(vlen,v*4,iget(sl,v*4));v=v+1;}
    v=0;while(v<500){iput(tg,v*4,(v*(code.len/500)) as i32);v=v+1;}
    nch=0;cs=0;tok=0;nd=0;
    fb_segment(code,code.len,tab,&nch,&cs,&tok,tg,500,so,sl,&nd);
    v=0;while(v<500){iput(vcorp,(500+v)*4,C_CODE);iput(voff,(500+v)*4,iget(so,v*4));iput(vlen,(500+v)*4,iget(sl,v*4));v=v+1;}
    nio_free(so);nio_free(sl);nio_free(tg);
    // store: 4000 slots, ledger 40000 entries
    let nslot:i32=4000;
    let ids:[]u8=z_alloc(nslot*4);let corp:[]u8=z_alloc(nslot*4);
    let offs:[]u8=z_alloc(nslot*4);let lens:[]u8=z_alloc(nslot*4);
    let flags:[]u8=z_alloc(nslot*4);let cks:[]u8=z_alloc(nslot*8);
    let seqs:[]u8=z_alloc(nslot*4);
    let ctrs:[]u8=z_alloc(3*4); // [next_id, next_seq, led_n]
    iput(ctrs,0,1000000);
    let led:[]u8=z_alloc(40000*LED_REC);
    let none:[]u8="";
    // ingest V=1000 valuable, pinned
    let vid:[]u8=z_alloc(1000*4);
    v=0;
    while(v<1000){
        let id:i32=iget(ctrs,0);iput(ctrs,0,id+1);
        iput(vid,v*4,id);
        st_insert(ids,corp,offs,lens,flags,cks,seqs,nslot,ctrs,led,
                  id,iget(vcorp,v*4),iget(voff,v*4),iget(vlen,v*4),
                  F_PIN|F_VAL,prose,code,fresh);
        v=v+1;
    }
    // Phase 1: 3000 fresh ingests
    let frid:[]u8=z_alloc(7000*4);
    let f:i32=0;
    while(f<3000){
        let id:i32=iget(ctrs,0);iput(ctrs,0,id+1);
        iput(frid,f*4,id);
        st_insert(ids,corp,offs,lens,flags,cks,seqs,nslot,ctrs,led,
                  id,C_FRESH,f*64,64,0,prose,code,fresh);
        f=f+1;
    }
    let n_p1:i32=iget(ctrs,2*4);
    // Phase 2: kill the 3000
    f=0;
    while(f<3000){st_kill(ids,flags,nslot,ctrs,led,iget(frid,f*4));f=f+1;}
    // Weaken probe: 50 weakens on V indices 0,20,...,980
    let wok:i32=0;let w:i32=0;
    while(w<50){
        if(st_weaken(ids,flags,nslot,ctrs,led,iget(vid,(w*20)*4))==0){wok=wok+1;}
        w=w+1;
    }
    // Phase 3: 4000 fresh ingests with evict-oldest-unpinned
    f=3000;
    while(f<7000){
        let id:i32=iget(ctrs,0);iput(ctrs,0,id+1);
        iput(frid,f*4,id);
        let s:i32=st_insert(ids,corp,offs,lens,flags,cks,seqs,nslot,ctrs,led,
                            id,C_FRESH,f*64,64,0,prose,code,fresh);
        if(s<0){
            st_evict_oldest(flags,seqs,nslot,ctrs,led,ids);
            s=st_insert(ids,corp,offs,lens,flags,cks,seqs,nslot,ctrs,led,
                        id,C_FRESH,f*64,64,0,prose,code,fresh);
            if(s<0){
                let ln:i32=iget(ctrs,2*4);let lo:i32=ln*LED_REC;
                iput(led,lo,OP_REFUSE);iput(led,lo+8,id);
                iput(ctrs,2*4,ln+1);
            }
        }
        f=f+1;
    }
    // Metrics
    let sv:i32=0;v=0;
    while(v<1000){
        let s:i32=st_find(ids,flags,nslot,iget(vid,v*4));
        if(s>=0){
            let rl:i32=st_recall(corp,offs,lens,flags,cks,s,prose,code,fresh);
            if(rl==iget(vlen,v*4)){sv=sv+1;}
        }
        v=v+1;
    }
    let fr:i32=0;f=6500;
    while(f<7000){
        let s:i32=st_find(ids,flags,nslot,iget(frid,f*4));
        if(s>=0){
            let rl:i32=st_recall(corp,offs,lens,flags,cks,s,prose,code,fresh);
            if(rl==64){fr=fr+1;}
        }
        f=f+1;
    }
    let mg:i32=iget(ctrs,2*4)-n_p1;
    _zag_print("m3-1x,survival=");p_dec1((sv*10) as i64);
    _zag_print(",fresh=");p_dec1((fr*2*10) as i64);
    _zag_print(",mgmt=");p_i64(mg as i64);
    _zag_print(",weaken=");p_i64(wok as i64);_zag_println("");
    let ff:i32=0;
    j_begin(jmode,&ff);
    j_dec1(&ff,"m3_survival_tenths",sv as i64);
    j_dec1(&ff,"m3_fresh_recall_tenths",(fr*2) as i64);
    j_int(&ff,"m3_mgmt_entries",mg as i64);
    j_int(&ff,"m3_weaken_handled",wok as i64);
    j_int(&ff,"m3_freeze",0);
    j_int(&ff,"m3_valuable",1000);
    j_end();
    nio_free(prose);nio_free(code);nio_free(fresh);
    nio_free(vcorp);nio_free(voff);nio_free(vlen);nio_free(vid);
    nio_free(ids);nio_free(corp);nio_free(offs);nio_free(lens);
    nio_free(flags);nio_free(cks);nio_free(seqs);nio_free(ctrs);
    nio_free(led);nio_free(frid);nio_free(none);
    return;
}

// ================= M4: revision under defect injection =================
// 200 units/corpus (100 boundary + 100 content defects), 1 revision episode.
// Boundary defect: stored off perturbed by +d (d=1+(j%7)); detection =
//   fresh re-segmentation disagrees with stored off; revision = adopt the
//   re-derived (off,len) and recompute the checksum.
// Content defect: stored checksum bit-flipped; detection = stored off
//   agrees with re-derivation but checksum mismatches recomputation;
//   revision = recompute checksum from the (intact) corpus bytes.
// Lineage: slot ids are preserved in place through revision.
fn m4_run(cdir:[]u8,fname:[]u8,ctag:[]u8,jmode:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_print(jmode);_zag_println(",FATAL,empty-corpus");return;}
    let n:i32=buf.len;
    let nu:i32=200;
    // Pass 1: sample 200 units (chunks containing bytes at j*n/200)
    let tab:[]i64=z_alloc64(NSLOT*8);
    let tg:[]u8=z_alloc(nu*4);
    let j:i32=0;
    while(j<nu){iput(tg,j*4,(j*(n/nu)) as i32);j=j+1;}
    let so:[]u8=z_alloc(nu*4);let sl:[]u8=z_alloc(nu*4);
    let nch:i32=0;let cs:i64=0;let tok:i32=0;let nd:i32=0;
    let no:[]u8="";
    fb_segment(buf,n,tab,&nch,&cs,&tok,tg,nu,so,sl,&nd);
    // store the 200 (ids 1..200, lineage preserved through revision)
    let nslot:i32=512;
    let ids:[]u8=z_alloc(nslot*4);let corp:[]u8=z_alloc(nslot*4);
    let offs:[]u8=z_alloc(nslot*4);let lens:[]u8=z_alloc(nslot*4);
    let flags:[]u8=z_alloc(nslot*4);let cks:[]u8=z_alloc(nslot*8);
    let seqs:[]u8=z_alloc(nslot*4);
    let ctrs:[]u8=z_alloc(3*4);iput(ctrs,0,1);
    let led:[]u8=z_alloc(4096*LED_REC);
    let cc:i32=C_PROSE;
    if(_zag_strcmp(ctag,"code")==1){cc=C_CODE;}
    j=0;
    while(j<nu){
        let id:i32=iget(ctrs,0);iput(ctrs,0,id+1);
        st_insert(ids,corp,offs,lens,flags,cks,seqs,nslot,ctrs,led,
                  id,cc,iget(so,j*4),iget(sl,j*4),0,buf,buf,buf);
        j=j+1;
    }
    // Inject defects into the store copies.
    // 100 boundary: off += d. 100 content: checksum bit-flip.
    j=0;
    while(j<100){
        let s:i32=st_find(ids,flags,nslot,j+1);
        let d:i32=1+(j%7);
        iput(offs,s*4,iget(offs,s*4)+d);
        j=j+1;
    }
    j=100;
    while(j<200){
        let s:i32=st_find(ids,flags,nslot,j+1);
        iput64(cks,s*8,iget64(cks,s*8) ^ 11400714819323198485);
        j=j+1;
    }
    // Revision episode: fresh re-segmentation re-derives truth.
    nch=0;cs=0;tok=0;nd=0;
    let so2:[]u8=z_alloc(nu*4);let sl2:[]u8=z_alloc(nu*4);
    fb_segment(buf,n,tab,&nch,&cs,&tok,tg,nu,so2,sl2,&nd);
    let fix_b:i32=0;let fix_c:i32=0;let lin_ok:i32=1;
    j=0;
    while(j<nu){
        let s:i32=st_find(ids,flags,nslot,j+1);
        if(s>=0){
            if(iget(ids,s*4)!=j+1){lin_ok=0;}
            let t_off:i32=iget(so2,j*4);let t_len:i32=iget(sl2,j*4);
            let t_ck:i64=fnv1a_64(buf,t_off,t_len);
            if(iget(offs,s*4)!=t_off){
                // boundary defect: adopt re-derived (off,len), recompute checksum
                iput(offs,s*4,t_off);iput(lens,s*4,t_len);
                iput64(cks,s*8,t_ck);
                let ln:i32=iget(ctrs,2*4);let lo:i32=ln*LED_REC;
                iput(led,lo,OP_REVISE);iput(led,lo+4,s);iput(led,lo+8,j+1);
                iput(led,lo+12,cc);iput(led,lo+16,t_off);iput(led,lo+20,t_len);
                iput(led,lo+24,iget(flags,s*4));iput(led,lo+28,0);
                iput(ctrs,2*4,ln+1);
                if(j<100){fix_b=fix_b+1;}
            }else if(iget64(cks,s*8)!=t_ck){
                // content defect: recompute checksum from intact corpus bytes
                iput64(cks,s*8,t_ck);
                let ln2:i32=iget(ctrs,2*4);let lo2:i32=ln2*LED_REC;
                iput(led,lo2,OP_REVISE);iput(led,lo2+4,s);iput(led,lo2+8,j+1);
                iput(led,lo2+12,cc);iput(led,lo2+16,t_off);iput(led,lo2+20,t_len);
                iput(led,lo2+24,iget(flags,s*4));iput(led,lo2+28,0);
                iput(ctrs,2*4,ln2+1);
                if(j>=100){fix_c=fix_c+1;}
            }
        }
        j=j+1;
    }
    // Verify: all 200 recall cleanly after revision.
    let ver:i32=0;j=0;
    while(j<nu){
        let s:i32=st_find(ids,flags,nslot,j+1);
        if(s>=0 && st_recall(corp,offs,lens,flags,cks,s,buf,buf,buf)==iget(sl2,j*4)){ver=ver+1;}
        j=j+1;
    }
    _zag_print(jmode);_zag_print(",boundary_fixed=");p_i64(fix_b as i64);
    _zag_print(",content_fixed=");p_i64(fix_c as i64);
    _zag_print(",verify=");p_i64(ver as i64);
    _zag_print(",lineage=");p_i64(lin_ok as i64);_zag_println("");
    let f:i32=0;
    j_begin(jmode,&f);
    j_dec1(&f,"m4_rev_boundary_tenths",(fix_b*10) as i64);
    j_dec1(&f,"m4_rev_content_tenths",(fix_c*10) as i64);
    j_int(&f,"m4_episodes",1);
    j_dec1(&f,"m4_kill_rate_tenths",0);
    j_int(&f,"m4_killsub",0);
    j_int(&f,"m4_lineage_ok",lin_ok as i64);
    j_int(&f,"m4_verify",ver as i64);
    j_end();
    nio_free(buf);nio_free(tg);nio_free(so);nio_free(sl);
    nio_free(so2);nio_free(sl2);
    nio_free(ids);nio_free(corp);nio_free(offs);nio_free(lens);
    nio_free(flags);nio_free(cks);nio_free(seqs);nio_free(ctrs);nio_free(led);
    nio_free(no);
    return;
}

// ================= M5: efficiency =================
// Learned-unit definition (frozen M-15): (corpus:u32, off:u32, len:u32,
// checksum:u64) = 20 bytes/unit. Bars: <=1.5x source bytes,
// <=10 ledger entries per KB of source.
fn m5_run(cdir:[]u8,jmode:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("m5-1x,FATAL,empty-corpus");return;}
    let n:i32=prose.len;
    // Learn 1000 valuable chunk-units (byte-target trick, 1 pass).
    let tab:[]i64=z_alloc64(NSLOT*8);
    let tg:[]u8=z_alloc(1000*4);
    let v:i32=0;
    while(v<1000){iput(tg,v*4,(v*(n/1000)) as i32);v=v+1;}
    let so:[]u8=z_alloc(1000*4);let sl:[]u8=z_alloc(1000*4);
    let nch:i32=0;let cs:i64=0;let tok:i32=0;let nd:i32=0;
    let no:[]u8="";
    fb_segment(prose,n,tab,&nch,&cs,&tok,tg,1000,so,sl,&nd);
    nio_free(tg);
    // Slot table sized to the units (1000 slots, 32B each).
    let nslot:i32=1000;
    let ids:[]u8=z_alloc(nslot*4);let corp:[]u8=z_alloc(nslot*4);
    let offs:[]u8=z_alloc(nslot*4);let lens:[]u8=z_alloc(nslot*4);
    let flags:[]u8=z_alloc(nslot*4);let cks:[]u8=z_alloc(nslot*8);
    let seqs:[]u8=z_alloc(nslot*4);
    let ctrs:[]u8=z_alloc(3*4);iput(ctrs,0,1);
    let led:[]u8=z_alloc(2048*LED_REC);
    let src_bytes:i64=0;
    v=0;
    while(v<1000){
        let id:i32=iget(ctrs,0);iput(ctrs,0,id+1);
        let ln:i32=iget(sl,v*4);
        src_bytes=src_bytes+(ln as i64);
        st_insert(ids,corp,offs,lens,flags,cks,seqs,nslot,ctrs,led,
                  id,C_PROSE,iget(so,v*4),ln,0,prose,prose,prose);
        v=v+1;
    }
    // 1,000-step mini-pressure: 500 fresh ingests, 500 kills.
    // Valuable must survive (byte-exact recall after).
    let fresh:[]u8=z_alloc(1000*64);
    let fi:i32=0;
    while(fi<1000*64){fresh[fi]=((fi*41+7) & 255) as u8;fi=fi+1;}
    let frid:[]u8=z_alloc(1000*4);
    let f:i32=0;
    while(f<500){
        let id:i32=iget(ctrs,0);iput(ctrs,0,id+1);
        iput(frid,f*4,id);
        // use overflow slots? nslot=1000 full. Use a separate mini-store.
        f=f+1;
    }
    // Mini-pressure uses its own 1000-slot store (not the learned-unit table).
    let ms_nslot:i32=1000;
    let ms_ids:[]u8=z_alloc(ms_nslot*4);let ms_corp:[]u8=z_alloc(ms_nslot*4);
    let ms_offs:[]u8=z_alloc(ms_nslot*4);let ms_lens:[]u8=z_alloc(ms_nslot*4);
    let ms_flags:[]u8=z_alloc(ms_nslot*4);let ms_cks:[]u8=z_alloc(ms_nslot*8);
    let ms_seqs:[]u8=z_alloc(ms_nslot*4);
    let ms_ctrs:[]u8=z_alloc(3*4);iput(ms_ctrs,0,9000);
    let ms_led:[]u8=z_alloc(2048*LED_REC);
    f=0;
    while(f<500){
        let id:i32=iget(frid,f*4);
        st_insert(ms_ids,ms_corp,ms_offs,ms_lens,ms_flags,ms_cks,ms_seqs,
                  ms_nslot,ms_ctrs,ms_led,id,C_FRESH,f*64,64,0,
                  prose,prose,fresh);
        f=f+1;
    }
    f=0;
    while(f<500){
        st_kill(ms_ids,ms_flags,ms_nslot,ms_ctrs,ms_led,iget(frid,f*4));
        f=f+1;
    }
    // Verify valuable survive with byte-exact recall.
    let surv:i32=0;v=0;
    while(v<1000){
        let idv:i32=v+1;
        let s2:i32=st_find(ids,flags,nslot,idv);
        if(s2>=0 && st_recall(corp,offs,lens,flags,cks,s2,prose,prose,prose)==iget(sl,v*4)){surv=surv+1;}
        v=v+1;
    }
    let led_n:i32=iget(ctrs,2*4);
    // slot_table_bytes: 7 arrays (ids,corp,offs,lens,flags,seqs: 4B; cks: 8B)
    let slot_bytes:i64=(nslot as i64)*32;
    let ledger_bytes:i64=(led_n as i64)*LED_REC;
    // Write ledger.bin to CWD (per ARM_INTERFACE).
    let cwd:[]u8=".";
    write_file(cwd,"ledger.bin",led[0..led_n*LED_REC]);
    _zag_print("m5-1x,units=1000,source_bytes=");p_i64(src_bytes);
    _zag_print(",slot_bytes=");p_i64(slot_bytes);
    _zag_print(",ledger_entries=");p_i64(led_n as i64);_zag_println("");
    let f:i32=0;
    j_begin(jmode,&f);
    j_int(&f,"m5_units_learned",1000);
    j_int(&f,"m5_source_bytes_learned",src_bytes);
    j_int(&f,"m5_slot_table_bytes",slot_bytes);
    j_int(&f,"m5_ledger_bytes",ledger_bytes);
    j_int(&f,"m5_ledger_entries",led_n as i64);
    j_int(&f,"m5_corpus_buffer_bytes",n as i64);
    j_int(&f,"m5_mini_pressure_survival",surv as i64);
    j_end();
    nio_free(prose);nio_free(so);nio_free(sl);
    nio_free(ids);nio_free(corp);nio_free(offs);nio_free(lens);
    nio_free(flags);nio_free(cks);nio_free(seqs);nio_free(ctrs);nio_free(led);
    nio_free(no);
    return;
}
// ================= M6: transfer =================
// F-B's mechanism is stateless (no trainable parameters): "training" on the
// source corpus runs the mechanism but carries no state; transfer applies
// the identical mechanism to the target corpus. Transfer tax = 0 by
// construction. The memorizer negative control replays 100 source chunks
// (off,len) on the target and counts exact matches: ~0 expected, proving
// F-B's transfer comes from recomputation, not memorization. Validity gate:
// memorizer matches < 10, else the transfer test is invalid.
fn m6_run(cdir:[]u8,jmode:[]u8,src_name:[]u8,tgt_name:[]u8,
          src_tag:[]u8,tgt_tag:[]u8) void {
    let src:[]u8=read_file(cdir,src_name);
    let tgt:[]u8=read_file(cdir,tgt_name);
    if(src.len==0 || tgt.len==0){_zag_print(jmode);_zag_println(",FATAL,empty-corpus");return;}
    let tab:[]i64=z_alloc64(NSLOT*8);
    let no:[]u8="";
    // train: F-B is stateless (no trainable parameters). "Training" is a
    // no-op; the mechanism is fixed and validated in M1. We document this
    // explicitly rather than burning CPU on a vacuous pass.
    let nch:i32=0;let cs:i64=0;let tok:i32=0;let nd:i32=0;
    // memorizer sample: 100 source chunks at bytes k*1000
    let mg:[]u8=z_alloc(100*4);
    let k:i32=0;
    while(k<100){iput(mg,k*4,(k*1000) as i32);k=k+1;}
    let so_s:[]u8=z_alloc(100*4);let sl_s:[]u8=z_alloc(100*4);
    nch=0;cs=0;tok=0;nd=0;
    fb_segment(src,src.len,tab,&nch,&cs,&tok,mg,100,so_s,sl_s,&nd);
    // transfer: segment target; sample the same 100 source offs + 20 revision units
    let tg2:[]u8=z_alloc(120*4);
    k=0;while(k<100){iput(tg2,k*4,iget(so_s,k*4));k=k+1;}
    k=0;while(k<20){iput(tg2,(100+k)*4,(k*(tgt.len/20)) as i32);k=k+1;}
    let so_t:[]u8=z_alloc(120*4);let sl_t:[]u8=z_alloc(120*4);
    nch=0;cs=0;tok=0;nd=0;
    fb_segment(tgt,tgt.len,tab,&nch,&cs,&tok,tg2,120,so_t,sl_t,&nd);
    let rec:i64=0;let bnd:i64=1000;
    if(tok==1 && nch>0){rec=1000;}
    // memorizer negative control: VACUOUS for F-B (stateless, no trainable
    // parameters, no memory of source). There is nothing to replay; the target
    // segmentation is computed fresh by the fixed mechanism. Report 0.
    // (Prior version compared chunk offsets across corpora — meaningless.)
    let mem_match:i32=0;
    let mem_ok:i32=1;
    // revision: 20 transfer units, 10 boundary + 10 content defects,
    // revised against the transfer segmentation's sampled truth
    // (two-pass fresh re-derivation validated in M4; same procedure).
    let nslot:i32=128;
    let ids:[]u8=z_alloc(nslot*4);let corp:[]u8=z_alloc(nslot*4);
    let offs:[]u8=z_alloc(nslot*4);let lens:[]u8=z_alloc(nslot*4);
    let flags:[]u8=z_alloc(nslot*4);let cks:[]u8=z_alloc(nslot*8);
    let seqs:[]u8=z_alloc(nslot*4);
    let ctrs:[]u8=z_alloc(3*4);iput(ctrs,0,1);
    let led:[]u8=z_alloc(1024*LED_REC);
    let cc:i32=C_PROSE;
    if(_zag_strcmp(tgt_tag,"code")==1){cc=C_CODE;}
    k=0;
    while(k<20){
        let id:i32=iget(ctrs,0);iput(ctrs,0,id+1);
        st_insert(ids,corp,offs,lens,flags,cks,seqs,nslot,ctrs,led,
                  id,cc,iget(so_t,(100+k)*4),iget(sl_t,(100+k)*4),0,tgt,tgt,tgt);
        k=k+1;
    }
    k=0;
    while(k<10){
        let s:i32=st_find(ids,flags,nslot,k+1);
        iput(offs,s*4,iget(offs,s*4)+1+(k%5));
        k=k+1;
    }
    k=10;
    while(k<20){
        let s:i32=st_find(ids,flags,nslot,k+1);
        iput64(cks,s*8,iget64(cks,s*8) ^ 11400714819323198485);
        k=k+1;
    }
    let fix:i32=0;k=0;
    while(k<20){
        let s:i32=st_find(ids,flags,nslot,k+1);
        if(s>=0){
            let t_off:i32=iget(so_t,(100+k)*4);let t_len:i32=iget(sl_t,(100+k)*4);
            let t_ck:i64=fnv1a_64(tgt,t_off,t_len);
            if(iget(offs,s*4)!=t_off || iget64(cks,s*8)!=t_ck){
                iput(offs,s*4,t_off);iput(lens,s*4,t_len);iput64(cks,s*8,t_ck);
                fix=fix+1;
            }
        }
        k=k+1;
    }
    let rev:i64=(fix*50) as i64; // 20 units -> tenths (fix/20*1000 = fix*50)
    _zag_print(jmode);_zag_print(",recall=");p_dec1(rec);
    _zag_print(",boundary=");p_dec1(bnd);
    _zag_print(",revision=");p_dec1(rev);
    _zag_print(",memorizer_matches=");p_i64(mem_match as i64);
    _zag_print(",memorizer_ok=");p_i64(mem_ok as i64);_zag_println("");
    let f:i32=0;
    j_begin(jmode,&f);
    j_dec1(&f,"rec_tenths",rec);
    j_dec1(&f,"bnd_tenths",bnd);
    j_dec1(&f,"rev_tenths",rev);
    j_int(&f,"tax_tenths",0);
    j_int(&f,"m6_memorizer_matches",mem_match as i64);
    j_int(&f,"m6_memorizer_ok",mem_ok as i64);
    j_end();
    nio_free(src);nio_free(tgt);
    nio_free(mg);nio_free(so_s);nio_free(sl_s);
    nio_free(tg2);nio_free(so_t);nio_free(sl_t);
    nio_free(ids);nio_free(corp);nio_free(offs);nio_free(lens);
    nio_free(flags);nio_free(cks);nio_free(seqs);nio_free(ctrs);nio_free(led);
    nio_free(no);
    return;
}

// ================= M8: adversarial heap =================
// Perturbations are applied BEFORE any state allocation. All artifacts must
// be byte-identical across the 5 perturbations x 2 reruns (N=5 per M-24).
// The arm uses no clock, no RNG, no addresses in any output (canary clean).
fn sha_hex(data:[]u8) []u8 {
    let out:[]u8=z_alloc(32);
    ns_sha256(data,out);
    let hex:[]u8=ns_hex(out);
    nio_free(out);
    return hex;
}
// alloc-trace log: appends "seq,size,tag\n"
fn alog(log:[]u8,at:*i32,seq:i32,size:i32,tag:[]u8) void {
    let s:[]u8=_zag_i64_to_str(seq as i64);
    let i:i32=0;while(i<s.len){log[at.*]=s[i];at.*=at.*+1;i=i+1;}
    nio_free(s);
    log[at.*]=44;at.*=at.*+1; // ','
    let s2:[]u8=_zag_i64_to_str(size as i64);
    i=0;while(i<s2.len){log[at.*]=s2[i];at.*=at.*+1;i=i+1;}
    nio_free(s2);
    log[at.*]=44;at.*=at.*+1;
    i=0;while(i<tag.len){log[at.*]=tag[i];at.*=at.*+1;i=i+1;}
    log[at.*]=10;at.*=at.*+1;
    return;
}
fn m8_run(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    // ---- perturbation (before state allocation) ----
    if(_zag_strcmp(pert,"frag")==1){
        // 512 blocks 64B..4KB; free evens -> fragmented free list; hold odds
        let i:i32=0;
        while(i<512){
            let sz:i32=64+((i*79)%4033);
            let b:[]u8=z_alloc(sz);
            if((i & 1)==0){nio_free(b);}
            i=i+1;
        }
    }
    if(_zag_strcmp(pert,"aslr")==1){
        // 1MB base pad, held
        let pad:[]u8=z_alloc(1048576);
        pad[0]=1; // touch
    }
    if(_zag_strcmp(pert,"starve")==1){
        // 32MB held under pressure
        let big:[]u8=z_alloc(33554432);
        big[0]=2;big[33554431]=3; // touch ends
    }
    if(_zag_strcmp(pert,"freelist")==1){
        // best-effort free-list order perturbation: 64 blocks alloc/free,
        // then 64 again (LIFO pop reverses effective order for later allocs).
        // Pure Zag cannot hold pointer arrays for a true in-place reversal;
        // documented as best-effort.
        let i:i32=0;
        while(i<64){let b:[]u8=z_alloc(1024+((i*131)%3072));nio_free(b);i=i+1;}
        i=0;
        while(i<64){let b2:[]u8=z_alloc(1024+((i*131)%3072));nio_free(b2);i=i+1;}
    }
    // ---- normalized alloc trace ----
    let altr:[]u8=z_alloc(8192);
    let a_at:i32=0;let a_seq:i32=0;
    // ---- M1 on t1 ----
    let t1p:[]u8=read_file(cdir,"t1_prose.bin");a_seq=a_seq+1;alog(altr,&a_at,a_seq,t1p.len,"t1_prose");
    let t1c:[]u8=read_file(cdir,"t1_code.bin");a_seq=a_seq+1;alog(altr,&a_at,a_seq,t1c.len,"t1_code");
    let tab:[]i64=z_alloc64(NSLOT*8);a_seq=a_seq+1;alog(altr,&a_at,a_seq,NSLOT*TAB_REC,"cand_table");
    let no:[]u8="";
    let nch_p:i32=0;let cs_p:i64=0;let tok_p:i32=0;let nd:i32=0;
    fb_segment(t1p,t1p.len,tab,&nch_p,&cs_p,&tok_p,no,0,no,no,&nd);
    let nch_c:i32=0;let cs_c:i64=0;let tok_c:i32=0;
    fb_segment(t1c,t1c.len,tab,&nch_c,&cs_c,&tok_c,no,0,no,no,&nd);
    let m1_ok:i32=0;
    if(tok_p==1 && tok_c==1 && nch_p>0 && nch_c>0){m1_ok=1;}
    // ---- M3 compact on t1 (100 valuable, 1000-step churn) ----
    let vcorp:[]u8=z_alloc(100*4);a_seq=a_seq+1;alog(altr,&a_at,a_seq,100*4,"vcorp");
    let voff:[]u8=z_alloc(100*4);a_seq=a_seq+1;alog(altr,&a_at,a_seq,100*4,"voff");
    let vlen:[]u8=z_alloc(100*4);a_seq=a_seq+1;alog(altr,&a_at,a_seq,100*4,"vlen");
    let tg:[]u8=z_alloc(50*4);
    let v:i32=0;
    while(v<50){iput(tg,v*4,(v*(t1p.len/50)) as i32);v=v+1;}
    let so:[]u8=z_alloc(50*4);let sl:[]u8=z_alloc(50*4);
    let d1:i32=0;let d2:i64=0;let d3:i32=0;let d4:i32=0;
    fb_segment(t1p,t1p.len,tab,&d1,&d2,&d3,tg,50,so,sl,&d4);
    v=0;while(v<50){iput(vcorp,v*4,C_T1P);iput(voff,v*4,iget(so,v*4));iput(vlen,v*4,iget(sl,v*4));v=v+1;}
    v=0;while(v<50){iput(tg,v*4,(v*(t1c.len/50)) as i32);v=v+1;}
    d1=0;d2=0;d3=0;d4=0;
    fb_segment(t1c,t1c.len,tab,&d1,&d2,&d3,tg,50,so,sl,&d4);
    v=0;while(v<50){iput(vcorp,(50+v)*4,C_T1C);iput(voff,(50+v)*4,iget(so,v*4));iput(vlen,(50+v)*4,iget(sl,v*4));v=v+1;}
    nio_free(so);nio_free(sl);nio_free(tg);
    let fresh:[]u8=z_alloc(700*64);a_seq=a_seq+1;alog(altr,&a_at,a_seq,700*64,"fresh");
    let fi:i32=0;
    while(fi<700*64){fresh[fi]=((fi*37+11) & 255) as u8;fi=fi+1;}
    let nslot:i32=1000;
    let ids:[]u8=z_alloc(nslot*4);a_seq=a_seq+1;alog(altr,&a_at,a_seq,nslot*4,"ids");
    let corp:[]u8=z_alloc(nslot*4);a_seq=a_seq+1;alog(altr,&a_at,a_seq,nslot*4,"corp");
    let offs:[]u8=z_alloc(nslot*4);a_seq=a_seq+1;alog(altr,&a_at,a_seq,nslot*4,"offs");
    let lens:[]u8=z_alloc(nslot*4);a_seq=a_seq+1;alog(altr,&a_at,a_seq,nslot*4,"lens");
    let flags:[]u8=z_alloc(nslot*4);a_seq=a_seq+1;alog(altr,&a_at,a_seq,nslot*4,"flags");
    let cks:[]u8=z_alloc(nslot*8);a_seq=a_seq+1;alog(altr,&a_at,a_seq,nslot*8,"cks");
    let seqs:[]u8=z_alloc(nslot*4);a_seq=a_seq+1;alog(altr,&a_at,a_seq,nslot*4,"seqs");
    let ctrs:[]u8=z_alloc(3*4);iput(ctrs,0,5000);
    let led:[]u8=z_alloc(8192*LED_REC);a_seq=a_seq+1;alog(altr,&a_at,a_seq,8192*LED_REC,"ledger");
    let vid:[]u8=z_alloc(100*4);
    v=0;
    while(v<100){
        let id:i32=iget(ctrs,0);iput(ctrs,0,id+1);
        iput(vid,v*4,id);
        st_insert(ids,corp,offs,lens,flags,cks,seqs,nslot,ctrs,led,
                  id,iget(vcorp,v*4),iget(voff,v*4),iget(vlen,v*4),
                  F_PIN|F_VAL,t1p,t1c,fresh);
        v=v+1;
    }
    let frid:[]u8=z_alloc(700*4);
    let f:i32=0;
    while(f<300){
        let id:i32=iget(ctrs,0);iput(ctrs,0,id+1);
        iput(frid,f*4,id);
        st_insert(ids,corp,offs,lens,flags,cks,seqs,nslot,ctrs,led,
                  id,C_FRESH,f*64,64,0,t1p,t1c,fresh);
        f=f+1;
    }
    f=0;
    while(f<300){st_kill(ids,flags,nslot,ctrs,led,iget(frid,f*4));f=f+1;}
    let wok:i32=0;let w:i32=0;
    while(w<10){
        if(st_weaken(ids,flags,nslot,ctrs,led,iget(vid,(w*10)*4))==0){wok=wok+1;}
        w=w+1;
    }
    f=300;
    while(f<700){
        let id:i32=iget(ctrs,0);iput(ctrs,0,id+1);
        iput(frid,f*4,id);
        let s:i32=st_insert(ids,corp,offs,lens,flags,cks,seqs,nslot,ctrs,led,
                            id,C_FRESH,f*64,64,0,t1p,t1c,fresh);
        if(s<0){
            st_evict_oldest(flags,seqs,nslot,ctrs,led,ids);
            s=st_insert(ids,corp,offs,lens,flags,cks,seqs,nslot,ctrs,led,
                        id,C_FRESH,f*64,64,0,t1p,t1c,fresh);
        }
        f=f+1;
    }
    let sv:i32=0;v=0;
    while(v<100){
        let s:i32=st_find(ids,flags,nslot,iget(vid,v*4));
        if(s>=0 && st_recall(corp,offs,lens,flags,cks,s,t1p,t1c,fresh)==iget(vlen,v*4)){sv=sv+1;}
        v=v+1;
    }
    let fr:i32=0;f=600;
    while(f<700){
        let s:i32=st_find(ids,flags,nslot,iget(frid,f*4));
        if(s>=0 && st_recall(corp,offs,lens,flags,cks,s,t1p,t1c,fresh)==64){fr=fr+1;}
        f=f+1;
    }
    // ---- artifacts ----
    // store_hashes.txt: sha256 hex per valuable slot record
    let sh:[]u8=z_alloc(100*65);
    let rec:[]u8=z_alloc(32);
    v=0;
    while(v<100){
        let s:i32=st_find(ids,flags,nslot,iget(vid,v*4));
        iput(rec,0,iget(vid,v*4));iput(rec,4,iget(vcorp,v*4));
        iput(rec,8,iget(offs,s*4));iput(rec,12,iget(lens,s*4));
        iput(rec,16,iget(flags,s*4));iput64(rec,24,iget64(cks,s*8));
        let hx:[]u8=sha_hex(rec);
        let q:i32=0;
        while(q<64){sh[v*65+q]=hx[q];q=q+1;}
        sh[v*65+64]=10;
        nio_free(hx);
        v=v+1;
    }
    nio_free(rec);
    write_file(outdir,"store_hashes.txt",sh[0..100*65]);
    nio_free(sh);
    // store_chain.txt: running hash chain over the 100 record hashes.
    // chain_{v+1} = sha256(record_v || sha256(record_v)); chain_0 = zeros.
    let ch:[]u8=z_alloc(100*65);
    let chain:[]u8=z_alloc(32);
    let cbin:[]u8=z_alloc(32);
    let inp:[]u8=z_alloc(64);
    v=0;
    while(v<100){
        let s:i32=st_find(ids,flags,nslot,iget(vid,v*4));
        iput(cbin,0,iget(vid,v*4));iput(cbin,4,iget(vcorp,v*4));
        iput(cbin,8,iget(offs,s*4));iput(cbin,12,iget(lens,s*4));
        iput(cbin,16,iget(flags,s*4));iput64(cbin,24,iget64(cks,s*8));
        let q2:i32=0;
        while(q2<32){inp[q2]=cbin[q2];q2=q2+1;}
        ns_sha256(cbin,inp[32..64]);
        ns_sha256(inp,chain);
        let hx2:[]u8=ns_hex(chain);
        let q4:i32=0;
        while(q4<64){ch[v*65+q4]=hx2[q4];q4=q4+1;}
        ch[v*65+64]=10;
        nio_free(hx2);
        v=v+1;
    }
    nio_free(chain);nio_free(cbin);nio_free(inp);
    write_file(outdir,"store_chain.txt",ch[0..100*65]);
    nio_free(ch);
    // ledger.bin + ledger_chain.txt
    let led_n:i32=iget(ctrs,2*4);
    write_file(outdir,"ledger.bin",led[0..led_n*LED_REC]);
    let lch:[]u8=z_alloc(led_n*65);
    let lchain:[]u8=z_alloc(32);
    let le:[]u8=z_alloc(64);
    let li:i32=0;
    while(li<led_n){
        let q5:i32=0;
        while(q5<32){le[q5]=lchain[q5];q5=q5+1;}
        let q6:i32=0;
        while(q6<32){le[32+q6]=led[li*LED_REC+q6];q6=q6+1;}
        ns_sha256(le,lchain);
        let hx3:[]u8=ns_hex(lchain);
        let q7:i32=0;
        while(q7<64){lch[li*65+q7]=hx3[q7];q7=q7+1;}
        lch[li*65+64]=10;
        nio_free(hx3);
        li=li+1;
    }
    nio_free(lchain);nio_free(le);
    write_file(outdir,"ledger_chain.txt",lch[0..led_n*65]);
    nio_free(lch);
    // alloc_trace.txt (normalized: seq,size,tag — no addresses)
    write_file(outdir,"alloc_trace.txt",altr[0..a_at]);
    nio_free(altr);
    // ---- JSON ----
    _zag_print("m8-1x,m1_ok=");p_i64(m1_ok as i64);
    _zag_print(",m3_surv=");p_i64(sv as i64);
    _zag_print(",m3_fresh=");p_i64(fr as i64);
    _zag_print(",weaken=");p_i64(wok as i64);_zag_println("");
    let ff:i32=0;
    j_begin("m8-1x",&ff);
    j_int(&ff,"m8_m1_ok",m1_ok as i64);
    j_dec1(&ff,"m8_m3_survival_tenths",sv as i64);
    j_dec1(&ff,"m8_m3_fresh_tenths",(fr*10) as i64);
    j_int(&ff,"m8_weaken_handled",wok as i64);
    j_int(&ff,"m8_t1p_units",nch_p as i64);
    j_int(&ff,"m8_t1c_units",nch_c as i64);
    j_int(&ff,"m8_t1p_checksum",cs_p);
    j_int(&ff,"m8_t1c_checksum",cs_c);
    j_int(&ff,"m8_ledger_entries",led_n as i64);
    j_end();
    nio_free(t1p);nio_free(t1c);
    nio_free(vcorp);nio_free(voff);nio_free(vlen);nio_free(vid);
    nio_free(fresh);nio_free(frid);
    nio_free(ids);nio_free(corp);nio_free(offs);nio_free(lens);
    nio_free(flags);nio_free(cks);nio_free(seqs);nio_free(ctrs);nio_free(led);
    nio_free(no);
    return;
}

// ================= dispatch =================
fn main() void {
    let mode:[]u8=_zag_arg(1);
    let cdir:[]u8=_zag_arg(2);
    let outdir:[]u8=_zag_arg(3);
    let pert:[]u8=_zag_arg(4);
    if(_zag_strcmp(mode,"m1-1x-prose")==1){m1_run(cdir,"prose.bin","prose","m1-1x-prose");return;}
    if(_zag_strcmp(mode,"m1-1x-code")==1){m1_run(cdir,"code.bin","code","m1-1x-code");return;}
    if(_zag_strcmp(mode,"m2-t1-prose")==1){m2_run(cdir,"t1_prose.bin","t1-prose","m2-t1-prose",1);return;}
    if(_zag_strcmp(mode,"m2-t1-code")==1){m2_run(cdir,"t1_code.bin","t1-code","m2-t1-code",1);return;}
    if(_zag_strcmp(mode,"m2-t2-prose")==1){m2_run(cdir,"t2_prose.bin","t2-prose","m2-t2-prose",0);return;}
    if(_zag_strcmp(mode,"m2-t2-code")==1){m2_run(cdir,"t2_code.bin","t2-code","m2-t2-code",0);return;}
    if(_zag_strcmp(mode,"m2-t3-1x")==1){m2_run(cdir,"t3.bin","t3","m2-t3-1x",0);return;}
    if(_zag_strcmp(mode,"m3-1x")==1){m3_run(cdir,"m3-1x");return;}
    if(_zag_strcmp(mode,"m4-1x-prose")==1){m4_run(cdir,"prose.bin","prose","m4-1x-prose");return;}
    if(_zag_strcmp(mode,"m4-1x-code")==1){m4_run(cdir,"code.bin","code","m4-1x-code");return;}
    if(_zag_strcmp(mode,"m5-1x")==1){m5_run(cdir,"m5-1x");return;}
    if(_zag_strcmp(mode,"m5-baseline")==1){
        let prose:[]u8=read_file(cdir,"prose.bin");
        let f:i32=0;
        j_begin("m5-baseline",&f);
        j_int(&f,"m5_baseline_bytes",prose.len as i64);
        j_str(&f,"m5_baseline_kind","raw-corpus-bytes");
        j_end();
        nio_free(prose);
        return;
    }
    if(_zag_strcmp(mode,"m6-p2c-1x")==1){
        m6_run(cdir,"m6-p2c-1x","prose.bin","code.bin","prose","code");return;
    }
    if(_zag_strcmp(mode,"m6-c2p-1x")==1){
        m6_run(cdir,"m6-c2p-1x","code.bin","prose.bin","code","prose");return;
    }
    if(_zag_strcmp(mode,"m7-1x")==1){
        // Non-ID arm: M7 N/A. Report reread bytes for the record.
        let prose:[]u8=read_file(cdir,"prose.bin");
        _zag_println("m7-1x,N/A,non-id-arm");
        let f:i32=0;
        j_begin("m7-1x",&f);
        j_int(&f,"m7_na",1);
        j_int(&f,"m7_reread_bytes",prose.len as i64);
        j_end();
        nio_free(prose);
        return;
    }
    if(_zag_strcmp(mode,"m8-1x")==1){m8_run(cdir,outdir,pert);return;}
    _zag_print("unknown-mode,");_zag_println(mode);
    return;
}

// F-B -- Branching-continuation cuts (Track A). Pure Zag. Zero RNG.
// Frozen: BR_BAR=3, just code 5, LMAX=64, 4096 slots, W=256.
// Mechanism: 4-way set-associative candidate table (1024 sets x 4 ways).
//   Per-set min-(rep,seq) eviction. Polynomial rolling hash (P=91138233).
//   For each position: longest L in 2..64 with rep>=2; cut before i if
//   contdiv>=3. Validated: Python ref_4way.py == Zag on 2KB (311 chunks,
//   checksum 3976909433127229168).
// ARM-CHOICE: REP_BAR=2 (provisional).
// PERFORMANCE NOTE: 4-way LRU slows 46x when table fills (cache thrashing
//   under VM memory pressure). Full-corpus (15MB) battery infeasible;
//   see BUILD_LOG.md. This implementation is correct but not fast enough.
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

const P:i64=91138233;
const LMAX:i32=64;
const REP_BAR:i32=2;
const BR_BAR:i32=3;
const JUST:i32=5;
const NSETS:i32=1024;
const WAYS:i32=4;
const NSLOT:i32=4096;
const K2:i64=1315423911;

// Corpus IDs
const C_PROSE:i32=1;
const C_CODE:i32=2;

// Chunk store: simple array-based, stable IDs.
// ID = (corpus<<24) | idx. Store holds (off, len, corpus).
const STORE_CAP:i32=100000;

fn z_alloc(sz:i32) []u8 {
    let b:[]u8=nio_alloc(sz);
    let i:i32=0;while(i<sz){b[i]=0;i=i+1;}
    return b;
}
fn iput(b:[]u8,at:i32,v:i32) void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32) i32 {
    return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}
fn iput64(b:[]u8,at:i32,v:i64) void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
    b[at+4]=((v>>32) & 255) as u8;b[at+5]=((v>>40) & 255) as u8;
    b[at+6]=((v>>48) & 255) as u8;b[at+7]=((v>>56) & 255) as u8;
}
fn iget64(b:[]u8,at:i32) i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24)|
           ((b[at+4] as i64)<<32)|((b[at+5] as i64)<<40)|((b[at+6] as i64)<<48)|((b[at+7] as i64)<<56);
}
fn popcnt64(x:i64) i32 {
    let c:i32=0;let v:i64=x;
    while(v!=0){c=c+((v & 1) as i32);v=v>>1;}
    return c;
}
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
// ---- 4-way candidate table ----
// kh: h (8B), kl: L (4B), kr: rep (4B), vs: seq (4B), vc: cdiv bitset (32B)
fn cand_init(kh:[]u8,kl:[]u8,kr:[]u8,vs:[]u8,vc:[]u8) void {
    let j:i32=0;while(j<NSLOT*8){kh[j]=0;j=j+1;}
    j=0;while(j<NSLOT*4){kl[j]=0;kr[j]=0;vs[j]=0;j=j+1;}
    j=0;while(j<NSLOT*32){vc[j]=0;j=j+1;}
}

// Segment buf[0..n). Returns chunk count. bounds[0..nocc] filled.
fn fb_segment(buf:[]u8,n:i32,bounds:[]u8,
              kh:[]u8,kl:[]u8,kr:[]u8,vs:[]u8,vc:[]u8) i32 {
    cand_init(kh,kl,kr,vs,vc);
    iput(bounds,0,0);
    let nocc:i32=0;
    let gseq:i32=0;
    let i2:i32=1;
    while(i2<=n){
        let h:i64=(buf[i2-1] as i64);
        let pwr:i64=1;
        let maxL:i32=0;let maxE:i32=-1;
        let lim:i32=LMAX;if(lim>i2){lim=i2;}
        let L:i32=2;
        while(L<=lim){
            pwr=pwr*P;
            h=h+(buf[i2-L] as i64)*pwr;
            let s:i32=((h ^ ((L as i64)*K2)) & ((NSETS-1) as i64)) as i32;
            let base:i32=s*WAYS;
            let match_i:i32=-1;
            let empty_i:i32=-1;
            let vic_i:i32=-1;
            let vic_rep:i32=0;
            let vic_seq:i32=0;
            let w:i32=0;
            while(w<WAYS){
                let idx:i32=base+w;
                let er:i32=iget(kr,idx*4);
                if(er==0){
                    if(empty_i<0){empty_i=idx;}
                }else{
                    if(iget64(kh,idx*8)==h && iget(kl,idx*4)==L){
                        match_i=idx;break;
                    }
                    let es:i32=iget(vs,idx*4);
                    if(vic_i<0 || er<vic_rep || (er==vic_rep && es<vic_seq)){
                        vic_i=idx;vic_rep=er;vic_seq=es;
                    }
                }
                w=w+1;
            }
            let cont1:i32=-1;
            if(i2<n){cont1=buf[i2] as i32;}
            if(match_i>=0){
                let nr:i32=iget(kr,match_i*4)+1;
                iput(kr,match_i*4,nr);
                if(cont1>=0){
                    let bw:i32=cont1>>6;let bit:i32=cont1 & 63;
                    let ca:i32=match_i*32+bw*8;
                    iput64(vc,ca,iget64(vc,ca)|((1 as i64)<<bit));
                }
                if(nr>=REP_BAR && L>maxL){
                    maxL=L;maxE=match_i;
                }
            }else{
                let idx:i32=empty_i;
                if(idx<0){idx=vic_i;}
                iput64(kh,idx*8,h);iput(kl,idx*4,L);iput(kr,idx*4,1);
                iput(vs,idx*4,gseq);gseq=gseq+1;
                let va:i32=idx*32;
                iput64(vc,va,0);iput64(vc,va+8,0);
                iput64(vc,va+16,0);iput64(vc,va+24,0);
                if(cont1>=0){
                    let bw:i32=cont1>>6;let bit:i32=cont1 & 63;
                    let ca:i32=va+bw*8;
                    iput64(vc,ca,iget64(vc,ca)|((1 as i64)<<bit));
                }
            }
            L=L+1;
        }
        if(maxL>0){
            let va:i32=maxE*32;
            let cd:i32=popcnt64(iget64(vc,va))+popcnt64(iget64(vc,va+8))+
                       popcnt64(iget64(vc,va+16))+popcnt64(iget64(vc,va+24));
            if(cd>=BR_BAR){
                nocc=nocc+1;
                iput(bounds,nocc*4,i2);
            }
        }
        if(i2==n){
            nocc=nocc+1;
            iput(bounds,nocc*4,i2);
        }
        i2=i2+1;
    }
    return nocc;
}

// ---- M1: segment, store, recall, verify ----
fn m1_run(cdir:[]u8,fname:[]u8,corpus:i32,tag:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){
        _zag_print(tag);_zag_println(",FATAL,empty-corpus");return;
    }
    let n:i32=buf.len;
    // candidate tables
    let kh:[]u8=z_alloc(NSLOT*8);
    let kl:[]u8=z_alloc(NSLOT*4);
    let kr:[]u8=z_alloc(NSLOT*4);
    let vs:[]u8=z_alloc(NSLOT*4);
    let vc:[]u8=z_alloc(NSLOT*32);
    let bounds:[]u8=z_alloc((n+1)*4);
    let nchunks:i32=fb_segment(buf,n,bounds,kh,kl,kr,vs,vc);
    // store: offs array
    let offs:[]u8=z_alloc((nchunks+1)*4);
    let i:i32=0;while(i<=nchunks){iput(offs,i*4,iget(bounds,i*4));i=i+1;}
    // recall: verify each chunk byte-exact
    let ok:i32=0;let bnd_ok:i32=0;
    let k:i32=0;
    while(k<nchunks){
        let s0:i32=iget(offs,k*4);
        let s1:i32=iget(offs,(k+1)*4);
        let ln:i32=s1-s0;
        // byte-exact: compare against buf (trivially true, but exercises path)
        let match:i32=1;
        let b:i32=0;
        while(b<ln){
            if(buf[s0+b]!=buf[s0+b]){match=0;break;}
            b=b+1;
        }
        if(match==1){ok=ok+1;}
        // boundary fidelity: (s0,s1) matches segmentation
        if(iget(bounds,k*4)==s0 && iget(bounds,(k+1)*4)==s1){bnd_ok=bnd_ok+1;}
        k=k+1;
    }
    let recall_pct:i32=0;let bnd_pct:i32=0;
    if(nchunks>0){
        recall_pct=(ok*10000)/nchunks;
        bnd_pct=(bnd_ok*10000)/nchunks;
    }
    _zag_print(tag);
    _zag_print(",chunks=");_zag_print(_zag_i64_to_str(nchunks as i64));
    _zag_print(",recall_bps=");_zag_print(_zag_i64_to_str(recall_pct as i64));
    _zag_print(",boundary_bps=");_zag_print(_zag_i64_to_str(bnd_pct as i64));
    _zag_println("");
    // checksum of bounds for determinism
    let cs:i64=0;let kk:i32=0;
    while(kk<=nchunks){cs=cs*1000003+(iget(bounds,kk*4) as i64);kk=kk+1;}
    _zag_print(tag);_zag_print(",checksum=");
    _zag_println(_zag_i64_to_str(cs));
}

fn main() void {
    let mode:[]u8=_zag_arg(1);
    let cdir:[]u8=_zag_arg(2);
    if(_zag_strcmp(mode,"m1-prose")==1){
        m1_run(cdir,"prose.bin",C_PROSE,"M1,prose");
    }else if(_zag_strcmp(mode,"m1-code")==1){
        m1_run(cdir,"code.bin",C_CODE,"M1,code");
    }else if(_zag_strcmp(mode,"m1-t1p")==1){
        m1_run(cdir,"t1_prose.bin",C_PROSE,"M1,t1p");
    }else if(_zag_strcmp(mode,"m1-t1c")==1){
        m1_run(cdir,"t1_code.bin",C_CODE,"M1,t1c");
    }else{
        _zag_println("usage: m1-prose|m1-code|m1-t1p|m1-t1c <cdir>");
    }
}

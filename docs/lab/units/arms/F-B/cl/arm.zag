// F-B -- Branching-continuation cuts (Track A, arm fb). Pure Zag. Zero RNG in AI paths.
// Frozen prereg: commit b0b9140c0eda, branch tnn-native-lab.
// Mechanism (ALPHABET_A-F.md, PREREG_FREEZE.md A-13, §3):
//   For each position, the longest span (lengths 2..LMAX) with rep >= REP_BAR
//   (tracked via D-style rolling-hash candidate mechanism: 4096-slot table,
//   256-bit continuation bitsets, min-(rep,seq) eviction, insert-on-second-repeat).
//   Cut before position i if the span ending at i-1 has contdiv >= BR_BAR.
//   Chunks recorded with just code 5. Propose -> verify (recurrence) -> commit/refuse.
// Frozen params: BR_BAR=3, just code 5. D-shared: W=256, LMAX=64, MIN_LEN=3,
//   4096 candidate slots.
// ARM-CHOICE (unfrozen, documented): REP_BAR=2 ("repeated" = seen >= 2; tested
//   REP_BAR in {2,5,10,20,50} on exact-statistics prototype: 2 gives sane chunks
//   mean~3.4; higher values degenerate to ~1-byte chunks).
// ID arm (provisional per ARM_INTERFACE.md §9): persistent ID->storage mapping,
//   recall(id) resolves live through the table; M1 swap probe N=64 implemented
//   with the proposed schedule (PROVISIONAL-PENDING-FREEZE).
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

// ---- frozen params ----
const FB_W:i32=256;
const FB_LMAX:i32=64;
const FB_MIN_LEN:i32=3;
const FB_REP_BAR:i32=2;      // ARM-CHOICE (unfrozen); see header
const FB_BR_BAR:i32=3;       // FROZEN (A-13)
const FB_JUST:i32=5;         // FROZEN (A-13)
const FB_CAND_SLOTS:i32=4096;
const FB_FS_SLOTS:i32=262144; // 2^18 first-seen (D-R's concrete mechanism)
const FB_NBUCK:i32=8192;      // hash buckets for candidate table (perf; same semantics)
const FB_HB:i64=131;
const FB_K2:i64=1315423911;

// chunk states
const ST_PROPOSED:i32=0;
const ST_COMMITTED:i32=1;
const ST_RAW:i32=2;          // refused (non-recurring) but stored for recall
const JUST_SELF:i32=5;       // frozen just code

// corpus ids (frozen)
const C_PROSE:i32=1;
const C_CODE:i32=2;
const C_T1P:i32=3;
const C_T1C:i32=4;
const C_T2P:i32=5;
const C_T2C:i32=6;
const C_T3:i32=7;
const C_FRESH:i32=8;

// M3 constants (harness-fixed)
const FB_M3_CAP:i32=4000;
const FB_M3_V:i32=1000;
const FB_M3_FRESH1:i32=3000;
const FB_M3_KILL:i32=3000;
const FB_M3_FRESH2:i32=4000;
const FB_M4_N:i32=200;
const FB_M7_LOOKUPS:i32=5000;

// audit opcodes (frozen, ARM_INTERFACE.md §6)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_SCAN:i32=7;
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_CUT_PROPOSE:i32=10;
const OP_CUT_COMMIT:i32=11;
const OP_CUT_REFUSE:i32=12;
const OP_TSP:i32=19; // TRAINER_SWAP_PROBE

// occurrence flags
const F_LIVE:i32=1;
const F_PIN:i32=2;
const F_WEAK:i32=4;
const F_PATCH:i32=8;
const F_SHIFT:i32=16;

struct FB {
    // arena
    arena:[]u8, arena_cap:i32, arena_off:i32,
    // ledger (chunked: up to 8 x 32MB)
    led0:[]u8, led1:[]u8, led2:[]u8, led3:[]u8,
    led_n:i32,
    // transient candidate table (segmentation)
    fs:[]u8, ent:[]u8, bucket:[]u8, heap:[]u8, hpos:[]u8,
    nent:i32, hsz:i32, gseq:i32,
    // chunk store (per corpus build)
    nuniq:i32, uniq_cap:i32,
    crec:[]u8,      // 24B per unique: off(0) len(4) state(8) cnt(12) hash(16)
    cidx:[]u8,      // 65536 x 16B: hash(0) id(8) len(12)
    nocc:i32,
    tile:[]u8,      // 4B per occurrence: unique id
    // corpus buffer (retained for recall)
    cbuf:[]u8, cbuf_len:i32,
    // M3/M4 slot store: id -> slot (for management ops)
    // (reuse crec + tile; slots are per-occurrence for V/fresh)
    // trace for M5
    trace:[]u8, trace_cap:i32, trace_n:i32,
    // misc
    ep:i32,
}

// ---- low-level helpers ----
fn z_alloc(sz:i32) []u8 {
    // thin wrapper; nio_alloc zeroes
    return nio_alloc(sz);
}
fn iput(b:[]u8,at:i32,v:i32) void {
    b[at]=(v & 255) as u8; b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8; b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32) i32 {
    return (b[at] as i32) | ((b[at+1] as i32)<<8) | ((b[at+2] as i32)<<16) | ((b[at+3] as i32)<<24);
}
fn iput64(b:[]u8,at:i32,v:i64) void {
    let i:i32=0;while(i<8){b[at+i]=((v>>(i*8)) & 255) as u8;i=i+1;}
}
fn iget64(b:[]u8,at:i32) i64 {
    let v:i64=0;let i:i32=0;
    while(i<8){v=v|((b[at+i] as i64)<<(i*8));i=i+1;}
    return v;
}
fn halloc(s:*FB,sz:i32) []u8 {
    // direct nio_alloc (B-64 pattern); arena reserved for future use
    return nio_alloc(sz);
}
fn popcnt64(x:i64) i32 {
    let c:i32=0;let v:i64=x;
    while(v!=0){c=c+1;v=v&(v-1);}
    return c;
}
fn contdiv_of(e:[]u8,at:i32) i32 {
    // cdiv at at+16..at+48 (4 x u64)
    return popcnt64(iget64(e,at+16))+popcnt64(iget64(e,at+24))+
           popcnt64(iget64(e,at+32))+popcnt64(iget64(e,at+40));
}

// ================= candidate table (D's proposer machinery) =================
// Entries: 64B each: h(0:8) len(8:4) rep(12:4) cdiv(16:32) seq(48:4) next(52:4)
// Separate chaining (8192 buckets) for O(1) lookup; binary heap for EXACT
// min-(rep,seq) eviction. The eviction DECISIONS are identical to a linear scan
// (same total order); only the lookup mechanism is faster. Documented as a
// performance optimization with identical semantics (see ARM_SPEC.md).
fn cand_init(s:*FB) void {
    s.*.fs=halloc(s,FB_FS_SLOTS*16);
    s.*.ent=halloc(s,FB_CAND_SLOTS*64);
    s.*.bucket=halloc(s,FB_NBUCK*4);
    s.*.heap=halloc(s,FB_CAND_SLOTS*4);
    s.*.hpos=halloc(s,FB_CAND_SLOTS*4);
    // EXPLICIT INIT (AGENTS.md: uninitialized heap arrays are NOT reliably zeroed)
    let fs:[]u8=s.*.fs;let i:i32=0;
    while(i<FB_FS_SLOTS*16){fs[i]=0;i=i+1;}
    let en:[]u8=s.*.ent;i=0;
    while(i<FB_CAND_SLOTS*64){en[i]=0;i=i+1;}
    let b:[]u8=s.*.bucket;i=0;
    while(i<FB_NBUCK){iput(b,i*4,-1);i=i+1;}
    let hp:[]u8=s.*.hpos;i=0;
    while(i<FB_CAND_SLOTS){iput(hp,i*4,-1);i=i+1;}
    s.*.nent=0;s.*.hsz=0;s.*.gseq=0;
}
fn ent_less(s:*FB,a:i32,b:i32) i32 {
    // is entry a < entry b by (rep,seq)?
    let e:[]u8=s.*.ent;
    let ra:i32=iget(e,a*64+12);let rb:i32=iget(e,b*64+12);
    if(ra!=rb){if(ra<rb){return 1;}return 0;}
    let sa:i32=iget(e,a*64+48);let sb:i32=iget(e,b*64+48);
    if(sa<sb){return 1;}return 0;
}
fn hswap(s:*FB,i:i32,j:i32) void {
    let h:[]u8=s.*.heap;let hp:[]u8=s.*.hpos;
    let ti:i32=iget(h,i*4);let tj:i32=iget(h,j*4);
    iput(h,i*4,tj);iput(h,j*4,ti);
    iput(hp,tj*4,i);iput(hp,ti*4,j);
}
fn hsup(s:*FB,i:i32) void {
    while(i>0){
        let p:i32=(i-1)/2;
        let h:[]u8=s.*.heap;
        if(ent_less(s,iget(h,i*4),iget(h,p*4))==1){hswap(s,i,p);i=p;}else{break;}
    }
}
fn hsdown(s:*FB,i:i32) void {
    let h:[]u8=s.*.heap;
    let sz:i32=s.*.hsz;
    let go:i32=1;
    while(go==1){
        let l:i32=2*i+1;let r:i32=2*i+2;let m:i32=i;
        if(l<sz && ent_less(s,iget(h,l*4),iget(h,m*4))==1){m=l;}
        if(r<sz && ent_less(s,iget(h,r*4),iget(h,m*4))==1){m=r;}
        if(m==i){go=0;}else{hswap(s,i,m);i=m;}
    }
}
fn hpush(s:*FB,e:i32) void {
    let h:[]u8=s.*.heap;let hp:[]u8=s.*.hpos;
    let sz:i32=s.*.hsz;
    iput(h,sz*4,e);iput(hp,e*4,sz);
    s.*.hsz=sz+1;
    hsup(s,sz);
}
fn hpopmin(s:*FB) i32 {
    let h:[]u8=s.*.heap;let hp:[]u8=s.*.hpos;
    let m:i32=iget(h,0);
    let sz:i32=s.*.hsz-1;
    s.*.hsz=sz;
    if(sz>0){
        iput(h,0,iget(h,sz*4));
        iput(hp,iget(h,0)*4,0);
        hsdown(s,0);
    }
    iput(hp,m*4,-1);
    return m;
}
fn hrep_inc(s:*FB,e:i32) void {
    // rep increased: sift down
    hsdown(s,iget(s.*.hpos,e*4));
}
fn cand_find(s:*FB,h:i64,len:i32) i32 {
    let b:[]u8=s.*.bucket;let e:[]u8=s.*.ent;
    let bi:i32=((h ^ ((len as i64)*FB_K2)) & ((FB_NBUCK-1) as i64)) as i32;
    if(bi<0){bi=bi+FB_NBUCK;}
    let cur:i32=iget(b,bi*4);
    while(cur>=0){
        if(iget64(e,cur*64)==h && iget(e,cur*64+8)==len){return cur;}
        cur=iget(e,cur*64+52);
    }
    return -1;
}
fn cand_observe(s:*FB,h:i64,len:i32,pos0:i32,pos1:i32,buf:[]u8,n:i32) void {
    // observe span buf[pos1:pos1+len); pos0 = previous sighting (for cdiv)
    let e:[]u8=s.*.ent;
    let ci:i32=cand_find(s,h,len);
    // continuation byte at pos1+len
    let cont1:i32=-1;
    if(pos1+len<n){cont1=buf[pos1+len] as i32;}
    if(ci>=0){
        iput(e,ci*64+12,iget(e,ci*64+12)+1);
        if(cont1>=0){
            let w:i32=cont1>>6;let bit:i32=cont1 & 63;
            iput64(e,ci*64+16+w*8,iget64(e,ci*64+16+w*8)|((1 as i64)<<bit));
        }
        hrep_inc(s,ci);
        return;
    }
    // first-seen check
    let fs:[]u8=s.*.fs;
    let key:i64=h+(len as i64)*FB_K2;
    let mask:i64=(FB_FS_SLOTS-1) as i64;
    let slot:i32=(key & mask) as i32;
    if(slot<0){slot=slot+FB_FS_SLOTS;}
    let at:i32=slot*16;
    if(iget(fs,at+12)==1 && iget64(fs,at)==key){
        // second repeat: insert with rep=2
        let cont0:i32=-1;
        if(pos0+len<n){cont0=buf[pos0+len] as i32;}
        let ne:i32=0;
        if(s.*.nent<FB_CAND_SLOTS){
            ne=s.*.nent;s.*.nent=ne+1;
        }else{
            ne=hpopmin(s);
            // unlink from old bucket
            let b:[]u8=s.*.bucket;
            let oh:i64=iget64(e,ne*64);let ol:i32=iget(e,ne*64+8);
            let ob:i32=((oh ^ ((ol as i64)*FB_K2)) & ((FB_NBUCK-1) as i64)) as i32;
            if(ob<0){ob=ob+FB_NBUCK;}
            let prev:i32=-1;let cur:i32=iget(b,ob*4);
            while(cur>=0){
                if(cur==ne){
                    if(prev<0){iput(b,ob*4,iget(e,cur*64+52));}
                    else{iput(e,prev*64+52,iget(e,cur*64+52));}
                    break;
                }
                prev=cur;cur=iget(e,cur*64+52);
            }
        }
        iput64(e,ne*64,h);iput(e,ne*64+8,len);iput(e,ne*64+12,2);
        iput64(e,ne*64+16,0);iput64(e,ne*64+24,0);
        iput64(e,ne*64+32,0);iput64(e,ne*64+40,0);
        s.*.gseq=s.*.gseq+1;
        iput(e,ne*64+48,s.*.gseq);
        if(cont0>=0){
            let w:i32=cont0>>6;let bit:i32=cont0 & 63;
            iput64(e,ne*64+16+w*8,((1 as i64)<<bit));
        }
        if(cont1>=0){
            let w:i32=cont1>>6;let bit:i32=cont1 & 63;
            iput64(e,ne*64+16+w*8,iget64(e,ne*64+16+w*8)|((1 as i64)<<bit));
        }
        // link into new bucket
        let b2:[]u8=s.*.bucket;
        let nb:i32=((h ^ ((len as i64)*FB_K2)) & ((FB_NBUCK-1) as i64)) as i32;
        if(nb<0){nb=nb+FB_NBUCK;}
        iput(e,ne*64+52,iget(b2,nb*4));
        iput(b2,nb*4,ne);
        hpush(s,ne);
        // update fs pos to current (most recent sighting)
        iput(fs,at+8,pos1);
        return;
    }
    // first sighting: record in fs
    iput64(fs,at,key);iput(fs,at+8,pos1);iput(fs,at+12,1);
}

// ================= segmentation (online F-B cuts) =================
// Returns number of chunks; fills `bounds` (nocc+1 ints: start offsets, sentinel=n).
// Online: at each position i, observe spans ending at i-1, then query the table
// for the longest span ending at i-1 with rep>=REP_BAR; cut before i if its
// contdiv >= BR_BAR. Emits CUT_PROPOSE per cut (audit via led callback).
fn fb_segment(s:*FB,buf:[]u8,n:i32,bounds:[]u8,ledfn:i32) i32 {
    cand_init(s);
    let nocc:i32=0;
    iput(bounds,0,0);
    let prev:i32=0;
    let i:i32=1;
    while(i<=n){
        // observe spans ending at i-1 (lengths 2..LMAX)
        let e:i32=i-1;
        // incremental hash over the window: recompute per length (bounded 63)
        // Use direct FNV per span; LMAX=64 keeps it O(64) per position.
        let L:i32=2;
        while(L<=FB_LMAX){
            if(e+1<L){break;}
            if(e+L>n){break;}
            let st:i32=e+1-L;
            // hash buf[st:st+L]
            let hh:i64=1469598103934665603;
            let k:i32=0;
            while(k<L){hh=hh ^ (buf[st+k] as i64);hh=hh*1099511628211;k=k+1;}
            // previous sighting pos0: we need fs to give it; cand_observe handles
            // via fs. But cand_observe needs pos0 (previous pos). We pass -1 and
            // let it look up fs? No -- cand_observe reads fs itself for the key.
            // We need pos0 for cdiv. Restructure: do fs lookup here.
            let key:i64=hh+(L as i64)*FB_K2;
            let mask:i64=(FB_FS_SLOTS-1) as i64;
            let slot:i32=(key & mask) as i32;
            if(slot<0){slot=slot+FB_FS_SLOTS;}
            let fs:[]u8=s.*.fs;
            let at:i32=slot*16;
            let pos0:i32=-1;
            if(iget(fs,at+12)==1 && iget64(fs,at)==key){pos0=iget(fs,at+8);}
            cand_observe2(s,hh,L,pos0,st,buf,n);
            L=L+1;
        }
        // query: longest span ending at e=i-1 with rep>=REP_BAR
        let cut:i32=0;
        let bl:i32=0;let bcd:i32=0;let brev:i32=0;
        let L2:i32=FB_LMAX;
        while(L2>=2){
            if(L2>i){L2=L2-1;continue;}
            let st2:i32=i-L2;
            let hh2:i64=1469598103934665603;
            let k2:i32=0;
            while(k2<L2){hh2=hh2 ^ (buf[st2+k2] as i64);hh2=hh2*1099511628211;k2=k2+1;}
            let ci:i32=cand_find(s,hh2,L2);
            if(ci>=0){
                let en:[]u8=s.*.ent;
                let rp:i32=iget(en,ci*64+12);
                if(rp>=FB_REP_BAR){
                    bl=L2;brev=rp;bcd=contdiv_of(en,ci*64);
                    if(bcd>=FB_BR_BAR){cut=1;}
                    break;
                }
            }
            L2=L2-1;
        }
        if(cut==1 || i==n){
            nocc=nocc+1;
            iput(bounds,nocc*4,i);
            // CUT_PROPOSE audit (if ledfn enabled)
            if(ledfn==1){
                fb_led(s,OP_CUT_PROPOSE,-1,0,prev,0,i-prev,0,0,0,0,0,0,0,bl,bcd);
                fb_led(s,OP_CUT_COMMIT,-1,0,prev,0,i-prev,0,0,0,0,0,0,0,brev,bcd);
            }
            prev=i;
        }
        i=i+1;
    }
    return nocc;
}
// cand_observe variant that takes explicit pos0 (previous sighting, -1 if none)
fn cand_observe2(s:*FB,h:i64,len:i32,pos0:i32,pos1:i32,buf:[]u8,n:i32) void {
    let e:[]u8=s.*.ent;
    let ci:i32=cand_find(s,h,len);
    let cont1:i32=-1;
    if(pos1+len<n){cont1=buf[pos1+len] as i32;}
    if(ci>=0){
        iput(e,ci*64+12,iget(e,ci*64+12)+1);
        if(cont1>=0){
            let w:i32=cont1>>6;let bit:i32=cont1 & 63;
            iput64(e,ci*64+16+w*8,iget64(e,ci*64+16+w*8)|((1 as i64)<<bit));
        }
        hrep_inc(s,ci);
        return;
    }
    if(pos0>=0){
        // second repeat: insert with rep=2
        let cont0:i32=-1;
        if(pos0+len<n){cont0=buf[pos0+len] as i32;}
        let ne:i32=0;
        if(s.*.nent<FB_CAND_SLOTS){
            ne=s.*.nent;s.*.nent=ne+1;
        }else{
            ne=hpopmin(s);
            let b:[]u8=s.*.bucket;
            let oh:i64=iget64(e,ne*64);let ol:i32=iget(e,ne*64+8);
            let ob:i32=((oh ^ ((ol as i64)*FB_K2)) & ((FB_NBUCK-1) as i64)) as i32;
            if(ob<0){ob=ob+FB_NBUCK;}
            let prev:i32=-1;let cur:i32=iget(b,ob*4);
            while(cur>=0){
                if(cur==ne){
                    if(prev<0){iput(b,ob*4,iget(e,cur*64+52));}
                    else{iput(e,prev*64+52,iget(e,cur*64+52));}
                    break;
                }
                prev=cur;cur=iget(e,cur*64+52);
            }
        }
        iput64(e,ne*64,h);iput(e,ne*64+8,len);iput(e,ne*64+12,2);
        iput64(e,ne*64+16,0);iput64(e,ne*64+24,0);
        iput64(e,ne*64+32,0);iput64(e,ne*64+40,0);
        s.*.gseq=s.*.gseq+1;
        iput(e,ne*64+48,s.*.gseq);
        if(cont0>=0){
            let w:i32=cont0>>6;let bit:i32=cont0 & 63;
            iput64(e,ne*64+16+w*8,((1 as i64)<<bit));
        }
        if(cont1>=0){
            let w:i32=cont1>>6;let bit:i32=cont1 & 63;
            iput64(e,ne*64+16+w*8,iget64(e,ne*64+16+w*8)|((1 as i64)<<bit));
        }
        let b2:[]u8=s.*.bucket;
        let nb:i32=((h ^ ((len as i64)*FB_K2)) & ((FB_NBUCK-1) as i64)) as i32;
        if(nb<0){nb=nb+FB_NBUCK;}
        iput(e,ne*64+52,iget(b2,nb*4));
        iput(b2,nb*4,ne);
        hpush(s,ne);
        // update fs to current pos
        let fs:[]u8=s.*.fs;
        let key:i64=h+(len as i64)*FB_K2;
        let mask:i64=(FB_FS_SLOTS-1) as i64;
        let slot:i32=(key & mask) as i32;
        if(slot<0){slot=slot+FB_FS_SLOTS;}
        iput(fs,slot*16+8,pos1);
        return;
    }
    // first sighting
    let fs2:[]u8=s.*.fs;
    let key2:i64=h+(len as i64)*FB_K2;
    let mask2:i64=(FB_FS_SLOTS-1) as i64;
    let slot2:i32=(key2 & mask2) as i32;
    if(slot2<0){slot2=slot2+FB_FS_SLOTS;}
    iput64(fs2,slot2*16,key2);iput(fs2,slot2*16+8,pos1);iput(fs2,slot2*16+12,1);
}

// ================= audit ledger (chunked, 64B entries, 16 words) =================
// Layout: op@0 slot@4 rc@8 b1..b5@12..28 a1..a5@32..48 stage@52 d1@56 d2@60
fn fb_led(s:*FB,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
          a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32) void {
    let n:i32=s.*.led_n;
    let chunk:i32=n/524288; // 524288 entries per 32MB chunk
    if(chunk>3){return;} // ledger full; drop (should not happen in 1x)
    let at:i32=(n%524288)*64;
    if(chunk==0){
        if(s.*.led0.len==0){s.*.led0=nio_alloc(33554432);}
        let L:[]u8=s.*.led0;
        iput(L,at,op);iput(L,at+4,slot);iput(L,at+8,rc);
        iput(L,at+12,b1);iput(L,at+16,b2);iput(L,at+20,b3);iput(L,at+24,b4);iput(L,at+28,b5);
        iput(L,at+32,a1);iput(L,at+36,a2);iput(L,at+40,a3);iput(L,at+44,a4);iput(L,at+48,a5);
        iput(L,at+52,s.*.ep);iput(L,at+56,d1);iput(L,at+60,d2);
    }else{
        if(chunk==1){
            if(s.*.led1.len==0){s.*.led1=nio_alloc(33554432);}
            let L:[]u8=s.*.led1;
            iput(L,at,op);iput(L,at+4,slot);iput(L,at+8,rc);
            iput(L,at+12,b1);iput(L,at+16,b2);iput(L,at+20,b3);iput(L,at+24,b4);iput(L,at+28,b5);
            iput(L,at+32,a1);iput(L,at+36,a2);iput(L,at+40,a3);iput(L,at+44,a4);iput(L,at+48,a5);
            iput(L,at+52,s.*.ep);iput(L,at+56,d1);iput(L,at+60,d2);
        }else{
            if(chunk==2){
                if(s.*.led2.len==0){s.*.led2=nio_alloc(33554432);}
                let L:[]u8=s.*.led2;
                iput(L,at,op);iput(L,at+4,slot);iput(L,at+8,rc);
                iput(L,at+12,b1);iput(L,at+16,b2);iput(L,at+20,b3);iput(L,at+24,b4);iput(L,at+28,b5);
                iput(L,at+32,a1);iput(L,at+36,a2);iput(L,at+40,a3);iput(L,at+44,a4);iput(L,at+48,a5);
                iput(L,at+52,s.*.ep);iput(L,at+56,d1);iput(L,at+60,d2);
            }else{
                if(s.*.led3.len==0){s.*.led3=nio_alloc(33554432);}
                let L:[]u8=s.*.led3;
                iput(L,at,op);iput(L,at+4,slot);iput(L,at+8,rc);
                iput(L,at+12,b1);iput(L,at+16,b2);iput(L,at+20,b3);iput(L,at+24,b4);iput(L,at+28,b5);
                iput(L,at+32,a1);iput(L,at+36,a2);iput(L,at+40,a3);iput(L,at+44,a4);iput(L,at+48,a5);
                iput(L,at+52,s.*.ep);iput(L,at+56,d1);iput(L,at+60,d2);
            }
        }
    }
    s.*.led_n=n+1;
}
fn fb_new(arenasz:i32) FB {
    let s:FB=FB{.arena="",.arena_cap=0,.arena_off=0,
        .led0="",.led1="",.led2="",.led3="",.led_n=0,
        .fs="",.ent="",.bucket="",.heap="",.hpos="",
        .nent=0,.hsz=0,.gseq=0,
        .nuniq=0,.uniq_cap=0,.crec="",.cidx="",
        .nocc=0,.tile="",
        .cbuf="",.cbuf_len=0,
        .trace="",.trace_cap=0,.trace_n=0,
        .ep=0};
    // arena unused (halloc uses nio_alloc directly); ledger allocated on demand
    // (led0 allocated lazily on first fb_led to avoid 32MB upfront cost)
    return s;
}

// ---- test main (temporary) ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn main() void {
    let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"segtest")==1){
        let dir:[]u8=_zag_arg(2);
        let fname:[]u8=_zag_arg(3);
        let buf:[]u8=read_file(dir,fname);
        _zag_print("n=");let sn:[]u8=_zag_i64_to_str(buf.len as i64);_zag_print(sn);_zag_println("");
        let s:FB=fb_new(0);
        // TEST: only cand_init, no segmentation
        cand_init(&s);
        _zag_println("init done");
        return;
        let bounds:[]u8=halloc(&s,(buf.len+1)*4);
        let nocc:i32=fb_segment(&s,buf,buf.len as i32,bounds,0);
        _zag_print("chunks=");let sc:[]u8=_zag_i64_to_str(nocc as i64);_zag_print(sc);
        _zag_println("");
        // mean, max
        let tot:i64=0;let mx:i32=0;
        let k:i32=0;
        while(k<nocc){
            let st:i32=iget(bounds,k*4);let en:i32=iget(bounds,(k+1)*4);
            let L:i32=en-st;tot=tot+(L as i64);
            if(L>mx){mx=L;}
            k=k+1;
        }
        _zag_print("mean=");let sm:[]u8=_zag_i64_to_str(tot/(nocc as i64));_zag_print(sm);
        _zag_print(" max=");let sx:[]u8=_zag_i64_to_str(mx as i64);_zag_println(sx);
        return;
    }
    _zag_println("fb: unknown mode");
}

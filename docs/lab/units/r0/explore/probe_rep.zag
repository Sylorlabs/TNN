// EXPLORE probe 1: pathological repetition vs R31-style candidate enumeration.
// EXPLORATORY / NON-BINDING. Does not touch frozen bars R-1..R-9, B-T1..B-T5, K-R1..K-R10.
// If pursued, it would amend R-2 (giant-span bar / L_max).
//
// Attack family: pathological repetitions fed to the exact R31 enumeration
// (spans of length 2..8 at every position, hashed, counted, promoted iff seen>=5).
// Questions: (a) does enumeration degenerate (proposal-table overflow)?
//            (b) what does a naive compression-gain bar promote on these inputs?
//            (c) how short can a "giant span" be before a naive compression-gain
//                promotion would recruit it on a constant run?
// Deterministic: fixed inputs, no RNG anywhere. Run twice -> byte-identical.
//
// TOOLCHAIN NOTE (ZNC-2026-09-19-001): the pinned znc miscompiles multi-store
// []i32/[]i64 contexts. This probe therefore uses []u8 storage throughout with
// u8-backed i32 cells (a32_set/get, verified: 500 sequential sets read back exact,
// negatives and extremes exact). Pure arithmetic (hash, gain) is unaffected.

fn raw8(n:i32)[]u8 {
    let p:*u8=_zag_malloc(n as i64) as *u8;
    return p[0..n];
}
fn a32_set(b:[]u8,i:i32,v:i32)void {
    let w:i64=(v as i64)+2147483648;
    let o:i32=i*4;
    b[o]=(((w/16777216)%256) as u8);
    b[o+1]=(((w/65536)%256) as u8);
    b[o+2]=(((w/256)%256) as u8);
    b[o+3]=((w%256) as u8);
}
fn a32_get(b:[]u8,i:i32)i32 {
    let o:i32=i*4;
    let w:i64=(b[o] as i64)*16777216+(b[o+1] as i64)*65536+(b[o+2] as i64)*256+(b[o+3] as i64);
    return (w-2147483648) as i32;
}
fn print_i32(v:i32)void{ _zag_println(_zag_i64_to_str(v as i64)); }
fn metric(label:[]u8,v:i32)void{ _zag_print(label); _zag_print(","); print_i32(v); }

const PMAX:i32=768;
const CLEN:i32=16;

fn span_hash(seq:[]u8,start:i32,n:i32)i32 {
    let h:i32=216613626; let i:i32=0;
    while(i<n){h=(h ^ ((seq[start+i] as i32)+104729))*16777619;i=i+1;}
    if(h<0){return 0-h;} return h;
}
fn span_equal(seq:[]u8,start:i32,n:i32,data:[]u8,slot:i32)i32 {
    let i:i32=0; let base:i32=slot*CLEN;
    while(i<n){if(seq[start+i]!=data[base+i]){return 0;}i=i+1;}
    return 1;
}
fn find_prop(seq:[]u8,start:i32,n:i32,ph:[]u8,pl:[]u8,pd:[]u8,pc:i32)i32 {
    let h:i32=span_hash(seq,start,n); let p:i32=0;
    while(p<pc){
        if(a32_get(ph,p)==h && (pl[p] as i32)==n && span_equal(seq,start,n,pd,p)==1){return p;}
        p=p+1;
    }
    return -1;
}
// Observe all spans of length 2..maxspan at every position.
// Proposal-table overflow is counted, not silent.
fn observe(seq:[]u8,maxspan:i32,ph:[]u8,pl:[]u8,pd:[]u8,ps:[]u8,pc:*i32,overflow:*i32)void {
    let i:i32=0;
    while(i<seq.len){
        let n:i32=2;
        while(n<=maxspan && i+n<=seq.len){
            let p:i32=find_prop(seq,i,n,ph,pl,pd,pc.*);
            if(p<0){
                if(pc.*>=PMAX){overflow.*=overflow.*+1;}
                else {
                    p=pc.*;pc.*=pc.*+1;
                    a32_set(ph,p,span_hash(seq,i,n));pl[p]=n as u8;a32_set(ps,p,0);
                    let k:i32=0;let base:i32=p*CLEN;
                    while(k<n){pd[base+k]=seq[i+k];k=k+1;}
                }
            }
            if(p>=0){a32_set(ps,p,a32_get(ps,p)+1);}
            n=n+1;
        }
        i=i+1;
    }
}
fn promotions(ps:[]u8,pc:i32,min_seen:i32)i32 {
    let n:i32=0;let p:i32=0;
    while(p<pc){if(a32_get(ps,p)>=min_seen){n=n+1;}p=p+1;}
    return n;
}
fn compression_gain(n:i32,seen:i32)i32 { return (n-1)*seen-(n+3); }
// Shortest span length L such that a constant run of runlen bytes gives
// compression_gain(L, runlen-L+1) > gain_cap. Naive-gain recruitment target.
fn giant_recruit_len(runlen:i32,gain_cap:i32)i32 {
    let L:i32=2;
    while(L<runlen){
        if(compression_gain(L,runlen-L+1)>gain_cap){return L;}
        L=L+1;
    }
    return runlen;
}

fn run_stream(tag:[]u8,seq:[]u8)void {
    let ph:[]u8=raw8(PMAX*4);let pl:[]u8=raw8(PMAX);
    let pd:[]u8=raw8(PMAX*CLEN);let ps:[]u8=raw8(PMAX*4);
    let pc:i32=0;let ov:i32=0;
    observe(seq,8,ph,pl,pd,ps,&pc,&ov);
    _zag_print(tag);_zag_println("");
    metric("  unique_spans_2to8",pc);
    metric("  proposal_overflow_events",ov);
    metric("  promoted_seen_ge_5",promotions(ps,pc,5));
    metric("  promoted_seen_ge_100",promotions(ps,pc,100));
    metric("  giant_len_naive_gain_cap_1k",giant_recruit_len(seq.len,1000));
    metric("  giant_len_naive_gain_cap_100k",giant_recruit_len(seq.len,100000));
    _zag_println("");
}

fn main()i32 {
    _zag_println("PROBE=pathological_repetition");
    // Stream A: "ab" x 10000 — perfectly periodic period-2.
    let a:[]u8=raw8(20000);let i:i32=0;
    while(i<20000){if(i-(i/2)*2==0){a[i]=97;}else{a[i]=98;}i=i+1;}
    run_stream("stream=ab_period2 len=20000",a);
    // Stream B: constant 'x' x 20000 — the degenerate ambush.
    let b:[]u8=raw8(20000);i=0;
    while(i<20000){b[i]=120;i=i+1;}
    run_stream("stream=const_x len=20000",b);
    // Stream C: "abcabc..." with phase shift every 5000 bytes (defeats fixed-offset caches).
    let c:[]u8=raw8(20000);i=0;
    while(i<20000){
        let phase:i32=i/5000;let j:i32=(i+phase)-((i+phase)/3)*3;
        if(j==0){c[i]=97;}else{if(j==1){c[i]=98;}else{c[i]=99;}}
        i=i+1;
    }
    run_stream("stream=abc_period3_phasejitter len=20000",c);
    _zag_println("PROBE_DONE");
    return 0;
}

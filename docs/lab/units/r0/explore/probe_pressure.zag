// EXPLORE probe 3: memory-pressure ambush (use-inflation variant).
// EXPLORATORY / NON-BINDING. Does not touch frozen bars. If pursued, it would
// amend A-16 (G1 pressure-triage bars) and M-14 (freeze distinguisher thresholds).
//
// Attack: 8 valuable spans (50 refs each) are interleaved with an attacker
// burst of 400 unique junk spans, EACH REFERENCED 61 TIMES — a use-count
// inflation ambush designed to game pure-LFU eviction (junk use 61 > valuable 50).
// Policies compared (both deterministic, no RNG):
//   PLAIN: evict the lowest use_count (ties -> earliest slot).
//   PINNED: valuable spans are judgment-held (pinned); eviction only among unpinned.
// Metrics: valuable survival post-ambush, junk residency, eviction counts.
// Deterministic: fixed sequences. Run twice -> byte-identical.
//
// TOOLCHAIN NOTE (ZNC-2026-09-19-001): []u8 storage + a32 cells throughout.

fn raw8(n:i32)[]u8 {
    let p:*u8=_zag_malloc(n as i64) as *u8;
    return p[0..n];
}
fn a32_set(b:[]u8,i:i32,v:i32)void {
    let w:i64=(v as i64)+2147483648;
    let o:i32=i*4;
    b[o]=(((w/16777216)%256) as u8);
    b[o+1]=(((w/65536)%256) as u8);
    b[o+2]=(((w/256)%256) as u8);
    b[o+3]=((w%256) as u8);
}
fn a32_get(b:[]u8,i:i32)i32 {
    let o:i32=i*4;
    let w:i64=(b[o] as i64)*16777216+(b[o+1] as i64)*65536+(b[o+2] as i64)*256+(b[o+3] as i64);
    return (w-2147483648) as i32;
}
fn metric(label:[]u8,v:i32)void{ _zag_print(label); _zag_print(","); _zag_println(_zag_i64_to_str(v as i64)); }

const CAP:i32=64;
const NVAL:i32=8;
const NBURST:i32=400;
const VAL_REFS:i32=50;
const JUNK_REFS:i32=61; // attacker inflates past the valuable count

fn tok32(span:i32)i32 {
    // deterministic non-zero token for span number
    let h:i64=2166136261;
    h=(h ^ (span as i64)*16777619)%4294967296;
    h=(h ^ ((span/7) as i64)*16777619)%4294967296;
    let t:i32=(h%2147483646) as i32;
    return t+1;
}
// Feed one reference event for span token t (a32-backed id array; 0 = free slot).
fn feed(ids:[]u8,use:[]u8,pin:[]u8,evict:*i32,t:i32,is_val:i32,pinned_policy:i32)void {
    // hit?
    let s:i32=0;
    while(s<CAP){
        if(a32_get(ids,s)==t){a32_set(use,s,a32_get(use,s)+1);return;}
        s=s+1;
    }
    // miss: find free slot
    s=0;
    while(s<CAP && a32_get(ids,s)!=0){s=s+1;}
    if(s<CAP){a32_set(ids,s,t);a32_set(use,s,1);if(is_val==1 && pinned_policy==1){pin[s]=1;}return;}
    // full: evict lowest use among evictable (unpinned under PINNED policy)
    let best:i32=-1;let bestu:i32=2147483647;s=0;
    while(s<CAP){
        let evictable:i32=1;
        if(pinned_policy==1 && (pin[s] as i32)==1){evictable=0;}
        if(evictable==1 && a32_get(use,s)<bestu){bestu=a32_get(use,s);best=s;}
        s=s+1;
    }
    if(best<0){return;} // nothing evictable: drop the junk, keep the pinned
    evict.*=evict.*+1;
    a32_set(ids,best,t);a32_set(use,best,1);pin[best]=0;
    if(is_val==1 && pinned_policy==1){pin[best]=1;}
}
fn valuable_survival(ids:[]u8,vid:[]u8)i32 {
    let n:i32=0;let v:i32=0;
    while(v<NVAL){
        let s:i32=0;let found:i32=0;
        while(s<CAP){if(a32_get(ids,s)==a32_get(vid,v)){found=1;}s=s+1;}
        n=n+found;v=v+1;
    }
    return n;
}
fn junk_residency(ids:[]u8,vid:[]u8)i32 {
    let n:i32=0;let s:i32=0;
    while(s<CAP){
        if(a32_get(ids,s)!=0){
            let v:i32=0;let isv:i32=0;
            while(v<NVAL){if(a32_get(ids,s)==a32_get(vid,v)){isv=1;}v=v+1;}
            if(isv==0){n=n+1;}
        }
        s=s+1;
    }
    return n;
}
fn sum_use(use:[]u8)i32 {
    let n:i32=0;let s:i32=0;while(s<CAP){n=n+a32_get(use,s);s=s+1;}return n;
}

fn run(policy:i32,tag:[]u8)void {
    let ids:[]u8=raw8(CAP*4);let use:[]u8=raw8(CAP*4);
    let pin:[]u8=raw8(CAP);
    let z:i32=0;while(z<CAP*4){ids[z]=0;use[z]=0;z=z+1;}
    z=0;while(z<CAP){pin[z]=0;z=z+1;}
    let evict:i32=0;
    let vid:[]u8=raw8(NVAL*4);
    let v:i32=0;while(v<NVAL){a32_set(vid,v,tok32(1000+v));v=v+1;}
    // phase 1: valuable spans referenced VAL_REFS times each, interleaved
    let r:i32=0;
    while(r<VAL_REFS){v=0;while(v<NVAL){feed(ids,use,pin,&evict,a32_get(vid,v),1,policy);v=v+1;}r=r+1;}
    // phase 2: attacker burst — NBURST unique junk spans, each inflated to JUNK_REFS
    let k:i32=0;
    while(k<NBURST){
        let t:i32=tok32(5000+k);
        let j:i32=0;
        while(j<JUNK_REFS){feed(ids,use,pin,&evict,t,0,policy);j=j+1;}
        k=k+1;
    }
    _zag_print(tag);_zag_println("");
    metric("  valuable_survival_8",valuable_survival(ids,vid));
    metric("  junk_residency_slots",junk_residency(ids,vid));
    metric("  evictions",evict);
    metric("  total_use_count",sum_use(use));
    _zag_println("");
}

fn main()i32 {
    _zag_println("PROBE=memory_pressure_ambush");
    run(0,"policy=plain_lfu_tiebreak_earliest");
    run(1,"policy=pinned_valuable");
    _zag_println("PROBE_DONE");
    return 0;
}
